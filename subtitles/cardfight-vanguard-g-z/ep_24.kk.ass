Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:04:25.00,0:04:27.34,Default,,0,0,0,,Ах~ Ах~ Хмм...
Dialogue: 0,0:04:27.34,0:04:29.85,Default,,0,0,0,,Бүгін күн жақсы...
Dialogue: 0,0:04:29.85,0:04:33.17,Default,,0,0,0,,Жарайды, әртүрлі себептермен үзіліп қалды➡
Dialogue: 0,0:04:33.17,0:04:35.69,Default,,0,0,0,,Промоутер қауымдастығы жауынгерлерінің квесті➡
Dialogue: 0,0:04:35.69,0:04:39.65,Default,,0,0,0,,Біз осы көктемді қайта ашуға көшеміз.
Dialogue: 0,0:04:39.65,0:04:41.87,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:04:41.87,0:04:44.34,Default,,0,0,0,,Бүгін сынақ нұсқасы ретінде...
Dialogue: 0,0:04:44.34,0:04:48.52,Default,,0,0,0,,Біз арнайы алдын ала квест өткіземіз!
Dialogue: 0,0:04:48.52,0:04:51.51,Default,,0,0,0,,Олай болса, бәріміз бізге қосылыңыздар.
Dialogue: 0,0:04:51.51,0:04:55.16,Default,,0,0,0,,Тұр... Авангард!
Dialogue: 0,0:04:55.16,0:05:03.35,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:05:03.35,0:05:07.33,Default,,0,0,0,,Бүгінгі өтетін орын Drane филиалында болады➡
Dialogue: 0,0:05:07.33,0:05:09.76,Default,,0,0,0,,Көптеген квесттер орындалып жатыр.
Dialogue: 0,0:05:09.76,0:05:15.20,Default,,0,0,0,,Қай топ ұпай жинап жеңеді?
Dialogue: 0,0:05:15.20,0:05:18.35,Default,,0,0,0,,Барлығыңыз, оны асыға күтіңіздер! Эй!
Dialogue: 0,0:05:18.35,0:05:22.71,Default,,0,0,0,,Хмм, бұл квест.
Dialogue: 0,0:05:22.71,0:05:25.73,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:05:25.73,0:05:29.50,Default,,0,0,0,,Достаса да болады. Сонымен...
Dialogue: 0,0:05:29.50,0:05:36.40,Default,,0,0,0,,Харуми орта мектебінің авангард әуесқойлары командасы бүгін ғана құрылады.
Dialogue: 0,0:05:36.40,0:05:38.67,Default,,0,0,0,,Ей, бұл атау шын болу үшін тым жақсы.
Dialogue: 0,0:05:38.67,0:05:41.36,Default,,0,0,0,,Куроно мырза, Касума мырза
Dialogue: 0,0:05:41.36,0:05:43.36,Default,,0,0,0,,Біз командамыз...
Dialogue: 0,0:05:43.36,0:05:45.50,Default,,0,0,0,,ﾌｧｲﾅﾙｼﾞｬｽﾃｨｽ
Dialogue: 0,0:05:45.50,0:05:47.67,Default,,0,0,0,,Балалар сендер де келдіңдер ме?
Dialogue: 0,0:05:47.67,0:05:50.35,Default,,0,0,0,,Хироки-кун...
Dialogue: 0,0:05:50.35,0:05:53.72,Default,,0,0,0,,Сіз оны тас, қағаз, қайшымен шештіңіз, солай ма?
Dialogue: 0,0:05:53.72,0:05:56.76,Default,,0,0,0,,Жоқ, мен әлі де сенімді емеспін!
Dialogue: 0,0:05:56.76,0:06:00.68,Default,,0,0,0,,Жоқ, сіз жеңілдіңіз. Сіз оны дұрыс қабылдауыңыз керек.
Dialogue: 0,0:06:00.68,0:06:05.53,Default,,0,0,0,,Бұл балалар командасының саяхаты сияқты.
Dialogue: 0,0:06:05.53,0:06:09.84,Default,,0,0,0,,Осылай десең, аяғыңнан сыпырылып кетесің.
Dialogue: 0,0:06:09.84,0:06:12.02,Default,,0,0,0,,Бұл ойын!
Dialogue: 0,0:06:12.02,0:06:15.18,Default,,0,0,0,,Иә! Жауап: А. Бірігіңіз!
Dialogue: 0,0:06:15.18,0:06:17.35,Default,,0,0,0,,[Майк] Дұрыс! (қуаныш)
Dialogue: 0,0:06:17.35,0:06:21.83,Default,,0,0,0,,Түймені басу сізге жауапты! Тыңдамаңыз!
Dialogue: 0,0:06:21.83,0:06:24.25,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:06:24.25,0:06:27.17,Default,,0,0,0,,[Майк] Жарайды, келесі сұрақ. Иә!
Dialogue: 0,0:06:27.17,0:06:30.53,Default,,0,0,0,,Иә...｡ Иә.
Dialogue: 0,0:06:30.53,0:06:35.06,Default,,0,0,0,,Мен бұлай сезінгеніме біраз болды. (Хаяо) Бұл рас.
Dialogue: 0,0:06:35.06,0:06:38.68,Default,,0,0,0,,А, үшінші адам жақында келуі керек.
Dialogue: 0,0:06:38.68,0:06:42.35,Default,,0,0,0,,Не? ≪Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:06:42.35,0:06:45.69,Default,,0,0,0,,Бүгінгі ынтымақтастық үшін рахмет.
Dialogue: 0,0:06:45.69,0:06:48.34,Default,,0,0,0,,Ивакура!?
Dialogue: 0,0:06:48.34,0:06:52.85,Default,,0,0,0,,Болашақ жауынгерлер мен кәсіби маман болуды мақсат ететін жекпе-жек
Dialogue: 0,0:06:52.85,0:06:56.33,Default,,0,0,0,,Барлығы, бүгінге асыққан екі адамға➡
Dialogue: 0,0:06:56.33,0:06:59.67,Default,,0,0,0,,Неліктен қолданып көрмеске?
Dialogue: 0,0:06:59.67,0:07:02.82,Default,,0,0,0,,Бұл ұрыс! (Рин) Бұл ұрыс!
Dialogue: 0,0:07:02.82,0:07:06.53,Default,,0,0,0,,Токохаға ма? Хашима-сан
Dialogue: 0,0:07:06.53,0:07:11.18,Default,,0,0,0,,Промоушн қауымдастығының Idol Fighters шабуылына ұшырайық па?
Dialogue: 0,0:07:11.18,0:07:15.67,Default,,0,0,0,,Хаха! Idol Fighter деген кім?
Dialogue: 0,0:07:15.67,0:07:18.69,Default,,0,0,0,,А, аа!
Dialogue: 0,0:07:18.69,0:07:20.86,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:07:20.86,0:07:23.85,Default,,0,0,0,,Ол өте өсті... жоқ ➡
Dialogue: 0,0:07:23.85,0:07:28.83,Default,,0,0,0,,Кішірейіп қалдың ба... Иә.
Dialogue: 0,0:07:28.83,0:07:31.67,Default,,0,0,0,,Қорқынышты! Мылтық
Dialogue: 0,0:07:31.67,0:07:34.19,Default,,0,0,0,,Иә! (Льюздің күлкісі)
Dialogue: 0,0:07:34.19,0:07:38.34,Default,,0,0,0,,Касуманың кішкентай кезін есіме түсіреді.
Dialogue: 0,0:07:38.34,0:07:40.34,Default,,0,0,0,,ｶﾞｰﾝ…
Dialogue: 0,0:07:42.53,0:07:44.73,Default,,0,0,0,,Zapage көмегімен шабуыл
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Ой~!
Dialogue: 0,0:07:50.00,0:07:53.34,Default,,0,0,0,,ｼﾞ･ｴﾝﾄﾞ ｻﾞ･ｸﾞﾚｰﾄ ｻﾞｸﾛｽ➡
Dialogue: 0,0:07:53.34,0:07:55.68,Default,,0,0,0,,ｼﾞｴｰｽ ｻﾞﾚｼﾞｪﾝﾄﾞ！
Dialogue: 0,0:07:55.68,0:07:58.18,Default,,0,0,0,,Мен енді мұны істей алмаймын, мен енді мұны істей алмаймын ...
Dialogue: 0,0:07:58.18,0:08:00.52,Default,,0,0,0,,Хаяо-сенпай!
Dialogue: 0,0:08:00.52,0:08:04.89,Default,,0,0,0,,Тошики Кай мырза Коджи Ибуки мырза
Dialogue: 0,0:08:04.89,0:08:09.17,Default,,0,0,0,,Осы күні мен Хаяо мырзадан нұсқаулық алдым.
Dialogue: 0,0:08:09.17,0:08:13.36,Default,,0,0,0,,Енді шайқас!
Dialogue: 0,0:08:13.36,0:08:18.02,Default,,0,0,0,,Жалындаған қылыш, жарқыраған фрак, қадамды ұрпақ!
Dialogue: 0,0:08:18.02,0:08:21.37,Default,,0,0,0,,Бүгін тек Ибукикун емес, Кайкун да осында.
Dialogue: 0,0:08:21.37,0:08:24.17,Default,,0,0,0,,Маған байсалды болуға рұқсат етіңіз!
Dialogue: 0,0:08:24.17,0:08:26.99,Default,,0,0,0,,Иә, иә, жұмыс, жұмыс.
Dialogue: 0,0:08:26.99,0:08:29.53,Default,,0,0,0,,Мен~ Филиал бастығы!
Dialogue: 0,0:08:29.53,0:08:31.66,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:31.66,0:08:34.35,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:08:34.35,0:08:39.22,Default,,0,0,0,,Мен мүлдем ұпай жинай алмаймын. Сіз қалай ойлайсыз? Тоқайрин-күн
Dialogue: 0,0:08:39.22,0:08:41.34,Default,,0,0,0,,Сіздің бірінші квестіңіз қандай болды?
Dialogue: 0,0:08:41.34,0:08:44.29,Default,,0,0,0,,Хмм, шынымды айтсам, мен түсінбеймін.
Dialogue: 0,0:08:44.29,0:08:47.18,Default,,0,0,0,,Фестиваль сияқты...
Dialogue: 0,0:08:47.18,0:08:50.33,Default,,0,0,0,,Сонымен, балалар, сіз үнемі осындай нәрселермен айналысатынсыз ба?
Dialogue: 0,0:08:50.33,0:08:53.35,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:08:53.35,0:08:56.00,Default,,0,0,0,,Мұндай сөздерді айтпа!
Dialogue: 0,0:08:56.00,0:08:58.17,Default,,0,0,0,,Тіпті алғаш рет келгендер үшін ➡
Dialogue: 0,0:08:58.17,0:09:00.84,Default,,0,0,0,,Мақсат - адамдарды Vanguard-пен таныстыру...
Dialogue: 0,0:09:00.84,0:09:03.86,Default,,0,0,0,,Хмм, бұл керемет емес пе? Жоқ!
Dialogue: 0,0:09:03.86,0:09:08.77,Default,,0,0,0,,Бұл сіз қайтарғыңыз келетін әлем, солай ма?
Dialogue: 0,0:09:08.77,0:09:26.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:26.35,0:09:30.34,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:09:30.34,0:09:35.26,Default,,0,0,0,,Егер бұл орын алса, мен барлық тапсырмаларды жеңемін!
Dialogue: 0,0:09:35.26,0:09:37.46,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:09:39.68,0:09:45.32,Default,,0,0,0,,Өте қызық болды! Квест толығымен жұмыс істегеннен кейін ➡
Dialogue: 0,0:09:45.32,0:09:47.67,Default,,0,0,0,,Барлығы бақытты болады! (Мамору) Иә
Dialogue: 0,0:09:47.67,0:09:50.34,Default,,0,0,0,,Мен жауап сезіндім. Ах.
Dialogue: 0,0:09:50.34,0:09:54.23,Default,,0,0,0,,-дағы ұпайларды санауды аяқтадыңыз ба? Кім жеңеді?
Dialogue: 0,0:09:54.23,0:09:57.35,Default,,0,0,0,,Әй, филиал меңгерушісі істемеді ме?
Dialogue: 0,0:09:57.35,0:10:00.18,Default,,0,0,0,,ше? Жоқ, жоқ, Мамору жасайды➡
Dialogue: 0,0:10:00.18,0:10:02.67,Default,,0,0,0,,Мен осылай дедім. (Мамору) О, жоқ, бұл мен➡
Dialogue: 0,0:10:02.67,0:10:05.06,Default,,0,0,0,,Қайта реттеу кезінде ұпай саны ➡ болады
Dialogue: 0,0:10:05.06,0:10:07.66,Default,,0,0,0,,Мен үшін жасаймын деп айтпадың ба?
Dialogue: 0,0:10:07.66,0:10:10.85,Default,,0,0,0,,А, солай ма? Бұл қашан болды?
Dialogue: 0,0:10:10.85,0:10:13.35,Default,,0,0,0,,Кешегі жиналыс. Ха...
Dialogue: 0,0:10:13.35,0:10:15.37,Default,,0,0,0,,оларды пайдаланбас бұрын бір-біріңмен мұқият кеңесіңдер.
Dialogue: 0,0:10:15.37,0:10:18.67,Default,,0,0,0,,Оны ешкім санамаған сияқты.
Dialogue: 0,0:10:18.67,0:10:23.37,Default,,0,0,0,,Е! (Вангаро) Кешіріңіз, бірақ~
Dialogue: 0,0:10:36.74,0:10:40.68,Default,,0,0,0,,Промоушн қауымдастығындағы баршаңызға күнделікті қажырлы еңбектеріңіз үшін рахмет➡
Dialogue: 0,0:10:40.68,0:10:43.03,Default,,0,0,0,,Мен шынымен ризамын.
Dialogue: 0,0:10:43.03,0:10:47.05,Default,,0,0,0,,Сондай-ақ, алдыңғы оқиғаға қатысқандардың барлығына➡
Dialogue: 0,0:10:47.05,0:10:50.37,Default,,0,0,0,,Бүгінгі күнді көңіліңізден шыққанша өткізгім келеді.
Dialogue: 0,0:10:50.37,0:10:53.54,Default,,0,0,0,,Содан кейін, Vanguard және ➡ әрі қарай таралуы
Dialogue: 0,0:10:53.54,0:10:56.19,Default,,0,0,0,,Әрі қарай даму үшін құттықтаймыз
Dialogue: 0,0:10:56.19,0:10:58.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:01.33,0:11:04.52,Default,,0,0,0,,Ананас ферменттері етті жұмсартады
Dialogue: 0,0:11:04.52,0:11:06.68,Default,,0,0,0,,Уау, Кайкун күткендей!
Dialogue: 0,0:11:06.68,0:11:09.02,Default,,0,0,0,,Әдеттегідей жалаң аяқ мамансың.
Dialogue: 0,0:11:09.02,0:11:12.06,Default,,0,0,0,,Біз осында жай ғана күн көре алмаймыз ба?
Dialogue: 0,0:11:12.06,0:11:14.59,Default,,0,0,0,,Иә, Лен мырза.
Dialogue: 0,0:11:14.59,0:11:17.34,Default,,0,0,0,,Барлық сүйектер мен қабықтар алынып тасталды.
Dialogue: 0,0:11:17.34,0:11:19.68,Default,,0,0,0,,Рахмет, Асака. (Тетсу) Бұл туралы➡
Dialogue: 0,0:11:19.68,0:11:22.50,Default,,0,0,0,,Мен мұны өзім жасауға рұқсат етіңіз. (2 адам) Ммм.
Dialogue: 0,0:11:22.50,0:11:24.67,Default,,0,0,0,,Ку~ Уми
Dialogue: 0,0:11:24.67,0:11:28.86,Default,,0,0,0,,Бірақ бұл өте жақсы жер емес пе?
Dialogue: 0,0:11:28.86,0:11:32.34,Default,,0,0,0,,Ибукидегі мен мұндай жерлерді жиі көремін...
Dialogue: 0,0:11:32.34,0:11:34.35,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.35,0:11:39.65,Default,,0,0,0,,Му~ Гокун. Қатты.
Dialogue: 0,0:11:42.00,0:11:44.00,Default,,0,0,0,,Не болды? Хайм
Dialogue: 0,0:11:44.00,0:11:46.01,Default,,0,0,0,,Мен етті артық пісірдім деп ойлаймын.
Dialogue: 0,0:11:46.01,0:11:49.41,Default,,0,0,0,,Бүгін... бәріміз сергітеміз!
Dialogue: 0,0:11:49.41,0:11:51.66,Default,,0,0,0,,Жоғары және төмен Еш ойланбаңыз!
Dialogue: 0,0:11:51.66,0:11:55.83,Default,,0,0,0,,Бұл Жапонияның сынығы!
Dialogue: 0,0:11:55.83,0:11:58.52,Default,,0,0,0,,Иә. Breaker?
Dialogue: 0,0:11:58.52,0:12:03.17,Default,,0,0,0,,Бірақ сөндіргіш неге өшіп қалды...
Dialogue: 0,0:12:03.17,0:12:06.34,Default,,0,0,0,,Ол жоқ!
Dialogue: 0,0:12:06.34,0:12:08.36,Default,,0,0,0,,Бас Ибуки?
Dialogue: 0,0:12:08.36,0:12:11.87,Default,,0,0,0,,Ибуки-кун, лауазымына байланысты оны шешіп тастауға мүмкіндік жоқ...
Dialogue: 0,0:12:11.87,0:12:13.85,Default,,0,0,0,,Бұл Жапонияның тігінен бөлінген қоғамы➡
Dialogue: 0,0:12:13.85,0:12:15.85,Default,,0,0,0,,Қараңғы аймақ! мм...
Dialogue: 0,0:12:15.85,0:12:19.82,Default,,0,0,0,,Күнделікті тынымсыз еңбек ететін бөлім меңгерушісіне сергіту сәті керек!
Dialogue: 0,0:12:19.82,0:12:23.86,Default,,0,0,0,,Бұл Ниппонның сынғышы! Олай болса!
Dialogue: 0,0:12:23.86,0:12:25.90,Default,,0,0,0,,Иә, Ибуки-кун➡
Dialogue: 0,0:12:25.90,0:12:29.45,Default,,0,0,0,,Мен өзімді кейінге қалдырмаймын.
Dialogue: 0,0:12:29.45,0:12:34.54,Default,,0,0,0,,Мурейкодан орын алғаным рас...
Dialogue: 0,0:12:34.54,0:12:37.32,Default,,0,0,0,,Хайм Мен мұны қайта-қайта қайталадым➡
Dialogue: 0,0:12:37.32,0:12:39.34,Default,,0,0,0,,Бөлгіш дегеніміз не?
Dialogue: 0,0:12:39.34,0:12:42.33,Default,,0,0,0,,Киімімізді шешетін жеріміз➡
Dialogue: 0,0:12:42.33,0:12:44.85,Default,,0,0,0,,Керемет жаңарту операциясы!
Dialogue: 0,0:12:44.85,0:12:47.79,Default,,0,0,0,,Бұл қызық оқиға.
Dialogue: 0,0:12:47.79,0:12:49.99,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:51.84,0:12:55.51,Default,,0,0,0,,Мен тағы да әкелемін. (Мамору) Иә, иә.
Dialogue: 0,0:12:55.51,0:12:59.68,Default,,0,0,0,,Қалғанын бітіремін, сондықтан Ибуки-кун, демалыңыз.
Dialogue: 0,0:12:59.68,0:13:02.83,Default,,0,0,0,,Анжо? Кюн
Dialogue: 0,0:13:02.83,0:13:04.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:04.85,0:13:07.86,Default,,0,0,0,,Мен сізге арнайы парақ дайындадым.
Dialogue: 0,0:13:07.86,0:13:09.96,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:13:11.99,0:13:14.51,Default,,0,0,0,,Ммм... мм.
Dialogue: 0,0:13:14.51,0:13:16.51,Default,,0,0,0,,Мен оны саған құйып беремін.
Dialogue: 0,0:13:16.51,0:13:21.50,Default,,0,0,0,,Директор ~ Жақсы жұмыс, Саманта!
Dialogue: 0,0:13:21.50,0:13:25.51,Default,,0,0,0,,Сіз бұл асыл мейрамның ешқайсысын жеген жоқсыз, солай ма?
Dialogue: 0,0:13:25.51,0:13:27.51,Default,,0,0,0,,Ааа... жоқ➡
Dialogue: 0,0:13:27.51,0:13:30.18,Default,,0,0,0,,Бірақ мұны жеу керек.
Dialogue: 0,0:13:30.18,0:13:34.58,Default,,0,0,0,,Иә, бастық~ Ах~
Dialogue: 0,0:13:34.58,0:13:37.50,Default,,0,0,0,,Оны өзіңіз жеуге болады. Мен саған құйып беремін.
Dialogue: 0,0:13:37.50,0:13:43.01,Default,,0,0,0,,Хехе... Ибуки-сан, сенің иығың қатып тұрған жоқ па?
Dialogue: 0,0:13:43.01,0:13:45.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:45.01,0:13:48.50,Default,,0,0,0,,Сіз не істеп жатырсыз? Мен жаман ойларды сезіндім
Dialogue: 0,0:13:48.50,0:13:51.03,Default,,0,0,0,,Хэхехе... Массаж болса➡
Dialogue: 0,0:13:51.03,0:13:54.05,Default,,0,0,0,,Біздің соңғы технологиямызды қолданып көріңіз!
Dialogue: 0,0:13:54.05,0:13:57.84,Default,,0,0,0,,Вакамизудың тамаша технологиясын қараңыз!
Dialogue: 0,0:13:57.84,0:14:00.17,Default,,0,0,0,,Потитто!
Dialogue: 0,0:14:00.17,0:14:03.17,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:14:09.18,0:14:12.00,Default,,0,0,0,,О, жоқ... Саған құйып берейін.
Dialogue: 0,0:14:12.00,0:14:15.90,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:19.19,0:14:24.87,Default,,0,0,0,,♪♪ "Барыңыз және төбелесіңіз! Вангаро кеттік! Вангаро"
Dialogue: 0,0:14:24.87,0:14:27.74,Default,,0,0,0,,Ей, сен де ән айт!
Dialogue: 0,0:14:27.74,0:14:29.74,Default,,0,0,0,,Мен неге ән айтуым керек!
Dialogue: 0,0:14:29.74,0:14:31.77,Default,,0,0,0,,Мен саған құйып беремін. Ах...
Dialogue: 0,0:14:31.77,0:14:34.01,Default,,0,0,0,,Ибукиді жаншып, не істеуді жоспарлап отырсыз?
Dialogue: 0,0:14:34.01,0:14:38.00,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,ﾃﾍﾍﾟﾛ
Dialogue: 0,0:14:40.00,0:14:42.02,Default,,0,0,0,,Көрші жақтағы қоршауда қоршау салынды.
Dialogue: 0,0:14:42.02,0:14:45.69,Default,,0,0,0,,Айтсаң, қасында қоршау бар...
Dialogue: 0,0:14:45.69,0:14:50.56,Default,,0,0,0,,Жоқ, күте тұр, бұл менмін... Әй, эй, көкек көкек
Dialogue: 0,0:14:50.56,0:14:52.96,Default,,0,0,0,,Әй, керемет!
Dialogue: 0,0:14:56.85,0:14:59.85,Default,,0,0,0,,Менен не қалайсың?
Dialogue: 0,0:14:59.85,0:15:02.35,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:04.36,0:15:08.51,Default,,0,0,0,,Егер бұл орын алса, толық іш биін орындаңыз және 10 000 рет атқа мініңіз!
Dialogue: 0,0:15:08.51,0:15:10.84,Default,,0,0,0,,Бекер өлме!
Dialogue: 0,0:15:10.84,0:15:13.00,Default,,0,0,0,,Әрі қарай не істеуім керек?
Dialogue: 0,0:15:13.00,0:15:16.18,Default,,0,0,0,,Дегенмен, ыңғайлы қолдануға болатын нәрселер бар...
Dialogue: 0,0:15:16.18,0:15:18.19,Default,,0,0,0,,О
Dialogue: 0,0:15:18.19,0:15:20.39,Default,,0,0,0,,Мына доппен ойна
Dialogue: 0,0:15:23.84,0:15:27.85,Default,,0,0,0,,Бұл ауа кедергісін елемейтін Вакасуидің тамаша добы!
Dialogue: 0,0:15:27.85,0:15:29.85,Default,,0,0,0,,Эх!
Dialogue: 0,0:15:34.50,0:15:36.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:36.50,0:15:41.01,Default,,0,0,0,,Балалар, қазірден бастап не істегілерің келді?
Dialogue: 0,0:15:41.01,0:15:43.41,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:15:43.41,0:15:47.01,Default,,0,0,0,,Мынау... біз сол...
Dialogue: 0,0:15:47.01,0:15:49.01,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:15:51.02,0:15:54.57,Default,,0,0,0,,Өтінемін, ашуланба, Ибукки.
Dialogue: 0,0:15:54.57,0:15:56.59,Default,,0,0,0,,Олар сенің көңіл көтеруіңді қалайды➡
Dialogue: 0,0:15:56.59,0:15:59.36,Default,,0,0,0,,Мен мұны жасадым.
Dialogue: 0,0:15:59.36,0:16:03.85,Default,,0,0,0,,Дұрыс, Ибуки-кун әрқашан қолынан келгеннің бәрін жасайды.
Dialogue: 0,0:16:03.85,0:16:07.35,Default,,0,0,0,,Сондықтан біз де ілесеміз.
Dialogue: 0,0:16:09.37,0:16:13.37,Default,,0,0,0,,Ара-тұра жеңілдеп, демалуға болмайды ма?
Dialogue: 0,0:16:17.18,0:16:20.85,Default,,0,0,0,,Барлығы үшін көп уайымдамаңыз.
Dialogue: 0,0:16:20.85,0:16:23.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:23.52,0:16:26.35,Default,,0,0,0,,Енді десертті ішейік.
Dialogue: 0,0:16:26.35,0:16:30.01,Default,,0,0,0,,Одан кейін көптен күткен жекпе-жек турнирі!
Dialogue: 0,0:16:30.01,0:16:32.94,Default,,0,0,0,,Ибуки мырза
Dialogue: 0,0:16:32.94,0:16:36.68,Default,,0,0,0,,Біздің кесірімізден, біз сізге көбірек қиындық тудырдық...
Dialogue: 0,0:16:36.68,0:16:39.52,Default,,0,0,0,,Кешіріңіз. Тым алданып қалдым.
Dialogue: 0,0:16:39.52,0:16:41.92,Default,,0,0,0,,Кешіріңіз, бастық.
Dialogue: 0,0:16:48.51,0:16:50.53,Default,,0,0,0,,ﾊﾊﾊ
Dialogue: 0,0:16:50.53,0:16:53.38,Default,,0,0,0,,Бұл қарыз күрес арқылы өтеледі.
Dialogue: 0,0:16:53.38,0:16:57.38,Default,,0,0,0,,Бұл сіз қалағандай дөрекі. Жақсы емес пе?
Dialogue: 0,0:17:03.69,0:17:05.99,Default,,0,0,0,,Жарайды, мен айттым.
Dialogue: 0,0:17:08.08,0:17:10.63,Default,,0,0,0,,Біз сізге қызмет етуге қуанышты боламыз.
Dialogue: 0,0:17:10.63,0:17:15.19,Default,,0,0,0,,Жүрекке Китар!
Dialogue: 0,0:17:15.19,0:17:33.44,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:33.44,0:17:35.94,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:40.04,0:17:43.70,Default,,0,0,0,,Бұл промоушн қауымдастығының пайдасына арналған тарап. (Канзаки) Үйге қайт!
Dialogue: 0,0:17:43.70,0:17:47.50,Default,,0,0,0,,Қаласаңыз, бізге қосылыңыз.
Dialogue: 0,0:17:50.19,0:17:53.39,Default,,0,0,0,,Үйге қайт!
Dialogue: 0,0:19:39.36,0:19:43.73,Default,,0,0,0,,Курононың ғарышкер болғысы келетініне таң қалдым.
Dialogue: 0,0:19:43.73,0:19:47.35,Default,,0,0,0,,Бірақ бұл қиын емес пе? ғарышкер болу
Dialogue: 0,0:19:47.35,0:19:49.84,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:19:49.84,0:19:51.91,Default,,0,0,0,,Жоғары сынып оқушысы Куроно➡ жағдайында
Dialogue: 0,0:19:51.91,0:19:54.43,Default,,0,0,0,,Алдымен жаратылыстану университетіне барыңыз➡
Dialogue: 0,0:19:54.43,0:19:56.95,Default,,0,0,0,,Жоғары оқу орнына түсу өте маңызды.
Dialogue: 0,0:19:56.95,0:19:59.18,Default,,0,0,0,,Амансың ба, ол?
Dialogue: 0,0:19:59.18,0:20:02.17,Default,,0,0,0,,Бұл мүлдем дұрыс емес сияқты.
Dialogue: 0,0:20:02.17,0:20:05.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:05.19,0:20:07.67,Default,,0,0,0,,Хмм... (Касума) Біріншіден, мен сізге бұл мәселені ертерек үйреткенмін➡
Dialogue: 0,0:20:07.67,0:20:10.68,Default,,0,0,0,,Косинустар заңын пайдаланып, содан кейін синустар заңын...
Dialogue: 0,0:20:10.68,0:20:12.70,Default,,0,0,0,,ｶｽﾞﾏ
Dialogue: 0,0:20:12.70,0:20:15.85,Default,,0,0,0,,Сәл түсіндіріп беріңізші.
Dialogue: 0,0:20:15.85,0:20:19.35,Default,,0,0,0,,Айтсаң да, бұдан былай...
Dialogue: 0,0:20:19.35,0:20:21.37,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:20:21.37,0:20:23.87,Default,,0,0,0,,Мұның мағынасы осы!
Dialogue: 0,0:20:27.01,0:20:29.01,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:29.01,0:20:31.01,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:20:31.01,0:20:33.53,Default,,0,0,0,,Таййо керемет!
Dialogue: 0,0:20:33.53,0:20:36.85,Default,,0,0,0,,Мүмкін Таййо ғарышкер болуды мақсат еткен шығар.
Dialogue: 0,0:20:36.85,0:20:40.86,Default,,0,0,0,,Мен бұл ықтималдықтың жоғары екеніне сенімдімін.
Dialogue: 0,0:20:40.86,0:20:42.86,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:20:45.01,0:20:48.87,Default,,0,0,0,,ﾊ～ｲ ｸﾛﾉ
Dialogue: 0,0:20:48.87,0:20:51.18,Default,,0,0,0,,ﾊ ﾊ～ｲ… ﾄｺﾊ
Dialogue: 0,0:20:51.18,0:20:53.85,Default,,0,0,0,,Бұл Парижден келген ағылшын тілінде сөйлесу сабағы ма?
Dialogue: 0,0:20:53.85,0:20:57.01,Default,,0,0,0,,Токоха да Курононың арманын қолдағысы келеді.
Dialogue: 0,0:20:57.01,0:21:00.51,Default,,0,0,0,,ｸﾛﾉ ﾎﾜｯﾄ ｲｽﾞ ﾕｱ ﾄﾞﾘｰﾑ？
Dialogue: 0,0:21:00.51,0:21:03.91,Default,,0,0,0,,ﾊｳ ﾄﾞｩｰ ﾕｰ ﾌﾟﾗﾝ ﾄｩｰ ｱﾁｰﾌﾞ ﾃﾞｨｽ ﾄﾞﾘｰﾑ？
Dialogue: 0,0:21:03.91,0:21:08.70,Default,,0,0,0,,Не, у... не дедің?
Dialogue: 0,0:21:08.70,0:21:11.37,Default,,0,0,0,,ﾄﾞﾝﾄ ｽﾋﾟｰｸ ｲﾝ ｼﾞｬﾊﾟﾆｰｽﾞ
Dialogue: 0,0:21:11.37,0:21:13.36,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:13.36,0:21:15.36,Default,,0,0,0,,ﾌﾟﾘｰｽﾞ ﾃﾙ ﾐｰ ｸﾛﾉ
Dialogue: 0,0:21:18.76,0:21:21.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.52,0:21:24.33,Default,,0,0,0,,Қарындашты айналдыру? Неге қазір?
Dialogue: 0,0:21:24.33,0:21:26.39,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:21:26.39,0:21:28.51,Default,,0,0,0,,ｸﾞｯｼﾞｮﾌﾞ
Dialogue: 0,0:21:28.51,0:21:30.67,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:21:30.67,0:21:33.18,Default,,0,0,0,,Өйткені Синдо-кун практикалық адам➡
Dialogue: 0,0:21:33.18,0:21:36.35,Default,,0,0,0,,Мүмкін, шетелдік қызды алу тезірек болар еді
Dialogue: 0,0:21:36.35,0:21:39.02,Default,,0,0,0,,Ол қандай қыз?
Dialogue: 0,0:21:39.02,0:21:41.02,Default,,0,0,0,,ﾊ ﾊｲﾒ？
Dialogue: 0,0:21:41.02,0:21:43.19,Default,,0,0,0,,Ағылшын Орыс Қытай
Dialogue: 0,0:21:43.19,0:21:46.54,Default,,0,0,0,,Қай тілде, қай елден екеніңіз маңызды емес.
Dialogue: 0,0:21:46.54,0:21:48.58,Default,,0,0,0,,Қаласаңыз, маған кез келген уақытта айтыңыз.
Dialogue: 0,0:21:48.58,0:21:50.61,Default,,0,0,0,,ｱﾃﾞｨｵｽ
Dialogue: 0,0:21:50.61,0:21:53.03,Default,,0,0,0,,Біз Еуро лигасының ортасында болуымыз керек болса да...
Dialogue: 0,0:21:53.03,0:21:55.03,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:55.03,0:21:57.53,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Егер сіз қамқорлық жасасаңыз, сіз жоғалтасыз!
Dialogue: 0,0:22:00.19,0:22:03.86,Default,,0,0,0,,Бұл мен ойлағаннан да қиын.
Dialogue: 0,0:22:03.86,0:22:10.01,Default,,0,0,0,,Бұл жігіттің мамандық таңдауын естіген қызметкерлер бөлмесі күлкіге қарық болды.
Dialogue: 0,0:22:10.01,0:22:12.02,Default,,0,0,0,,Кішкене дәретхана
Dialogue: 0,0:22:12.02,0:22:15.02,Default,,0,0,0,,Сіз ванна бөлмесінің терезесінен қашуды ойламайсыз, солай ма?
Dialogue: 0,0:22:15.02,0:22:17.92,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:22:19.86,0:22:23.04,Default,,0,0,0,,Ойлану... Эй.
Dialogue: 0,0:22:23.04,0:22:26.91,Default,,0,0,0,,Дәретхана дұрыс па? Мен енді барғым келмейді
Dialogue: 0,0:22:26.91,0:22:30.41,Default,,0,0,0,,Хе-хе... үзіліс жасайық.
Dialogue: 0,0:22:32.35,0:22:35.72,Default,,0,0,0,,Пазл? Бәрі таза ақ
Dialogue: 0,0:22:35.72,0:22:40.34,Default,,0,0,0,,Бұл ғарышкерді іріктеу сынағында нақты қолданылған.
Dialogue: 0,0:22:40.34,0:22:42.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:42.51,0:22:44.83,Default,,0,0,0,,Жылдамдықты жақсы өзгерту емес пе?
Dialogue: 0,0:22:44.83,0:22:46.85,Default,,0,0,0,,《Кілттер: Жындар...》
Dialogue: 0,0:22:46.85,0:22:48.89,Default,,0,0,0,,《Касума: Жоқ, бұл шайтан》
Dialogue: 0,0:22:48.89,0:22:53.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:53.01,0:22:59.85,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:22:59.85,0:23:02.67,Default,,0,0,0,,Куроно мырза! (Касума) Куроно!
Dialogue: 0,0:23:02.67,0:23:04.70,Default,,0,0,0,,Әй, менің көзім осында!
Dialogue: 0,0:23:04.70,0:23:06.70,Default,,0,0,0,,Біреу маған жасанды тыныс берші! (Кай) О, құдай!
Dialogue: 0,0:23:14.34,0:23:17.50,Default,,0,0,0,,Сіз ғарыш бизнесіне кірістім деп ойлаған кезде➡
Dialogue: 0,0:23:17.50,0:23:21.00,Default,,0,0,0,,Көзді ашып-жұмғанша ғарыш кемесі ұшырылды.
Dialogue: 0,0:23:21.00,0:23:24.35,Default,,0,0,0,,Сіз үлкен мәселесіз.
Dialogue: 0,0:23:24.35,0:23:27.34,Default,,0,0,0,,Бұл менің ғана күшім емес
Dialogue: 0,0:23:27.34,0:23:32.25,Default,,0,0,0,,Техникалық жағынан Кристің геотехнологиясы, ал қаржылық жағынан...
Dialogue: 0,0:23:32.25,0:23:34.87,Default,,0,0,0,,Мен де демеушілердің бірімін.
Dialogue: 0,0:23:34.87,0:23:38.34,Default,,0,0,0,,Жеңімпаз жүлдені алуға болады.
Dialogue: 0,0:23:38.34,0:23:42.51,Default,,0,0,0,,Токоха-чан Мен сені көрмегелі біраз болды. Әрқашан.
Dialogue: 0,0:23:42.51,0:23:44.51,Default,,0,0,0,,Биылғы маусым да жақсы өтуде.
Dialogue: 0,0:23:44.51,0:23:47.68,Default,,0,0,0,,Нихи! Токохадан басқа➡
Dialogue: 0,0:23:47.68,0:23:50.36,Default,,0,0,0,,Химея Хашима-сенпай Кай-сан➡
Dialogue: 0,0:23:50.36,0:23:53.33,Default,,0,0,0,,Көптеген адамдар көмектесуде.
Dialogue: 0,0:23:53.33,0:23:55.35,Default,,0,0,0,,Жоқ, ол жігіт шынымен➡
Dialogue: 0,0:23:55.35,0:23:58.52,Default,,0,0,0,,Мен ғарышкер болғым келеді. Эй.
Dialogue: 0,0:23:58.52,0:24:03.44,Default,,0,0,0,,Сіз көңіл көтермейсіз бе? Шионның көмегімен ұшқыш болуға мәжбүр болды
Dialogue: 0,0:24:03.44,0:24:05.93,Default,,0,0,0,,Сіз нашар тыңдаушысыз.
Dialogue: 0,0:24:05.93,0:24:09.68,Default,,0,0,0,,Менің халықаралық сертификатым бар.
Dialogue: 0,0:24:09.68,0:24:13.17,Default,,0,0,0,,Міне, біз оларға өте жақсы қамқорлық жасадық.
Dialogue: 0,0:24:13.17,0:24:18.16,Default,,0,0,0,,Бірақ Chrono шынымен жақсы жұмыс жасады.
Dialogue: 0,0:24:18.16,0:24:20.16,Default,,0,0,0,,Мен әлі де сене алар емеспін.
Dialogue: 0,0:24:20.16,0:24:23.35,Default,,0,0,0,,Куроногана оқу сабағында өзінің даналығын көрсетті
Dialogue: 0,0:24:23.35,0:24:26.73,Default,,0,0,0,,Біз қашан сөйлесеміз?
Dialogue: 0,0:24:26.73,0:24:29.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:24:31.67,0:24:34.37,Default,,0,0,0,,Дайынсың ба? Хроно
Dialogue: 0,0:24:37.03,0:24:39.06,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:24:39.06,0:24:41.10,Default,,0,0,0,,Крис, бәріңе!
Dialogue: 0,0:24:41.10,0:24:43.10,Default,,0,0,0,,ұшырудан 10 минут бұрын
Dialogue: 0,0:24:45.19,0:24:47.99,Default,,0,0,0,,《Сіз біздің өкілсіз➡
Dialogue: 0,0:24:47.99,0:24:50.69,Default,,0,0,0,,Жүрегіңді биік ұста, Куроно! 》
Dialogue: 0,0:24:50.69,0:24:55.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:55.08,0:24:57.08,Default,,0,0,0,,Қозғалтқыштың негізгі тұтануы!
Dialogue: 0,0:24:59.18,0:25:01.18,Default,,0,0,0,,ﾅｲﾝ ｴｲﾄ…
Dialogue: 0,0:25:01.18,0:25:03.35,Default,,0,0,0,,《Кеттік, Доран
Dialogue: 0,0:25:03.35,0:25:06.86,Default,,0,0,0,,Әркім... және менің өз күшім》
Dialogue: 0,0:25:06.86,0:25:09.79,Default,,0,0,0,,ﾂｰ ﾜﾝ
Dialogue: 0,0:25:09.79,0:25:11.85,Default,,0,0,0,,ﾘﾌﾄｵﾌ！
Dialogue: 0,0:25:11.85,0:25:26.03,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:26.03,0:25:28.55,Default,,0,0,0,,Сонда сен қорқынышты тү көріпсің ғой.
Dialogue: 0,0:25:28.55,0:25:40.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:48.33,0:25:50.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:50.50,0:25:52.50,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:25:52.50,0:25:54.49,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:25:54.49,0:25:57.69,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:25:57.69,0:26:01.85,Default,,0,0,0,,Мен оның кенет құлап қалғанына таң қалдым.
Dialogue: 0,0:26:01.85,0:26:05.70,Default,,0,0,0,,Бұл арман болды ма?
Dialogue: 0,0:26:05.70,0:26:08.00,Default,,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:26:10.35,0:26:13.86,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Әлі көп жол бар.
Dialogue: 0,0:26:13.86,0:26:17.68,Default,,0,0,0,,Жалқаулыққа уақыт жоқ, айдаһар күтіп тұр.
Dialogue: 0,0:26:17.68,0:26:20.68,Default,,0,0,0,,Баршаңыз қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:26:20.68,0:26:28.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:33.37,0:30:35.34,Default,,0,0,0,,Көптеген жаңа кездесулер болады➡
Dialogue: 0,0:30:35.34,0:30:37.35,Default,,0,0,0,,Көктем мезгілі
Dialogue: 0,0:30:37.35,0:30:41.02,Default,,0,0,0,,Tokyo аниме телевидениесінде жаңа бағдарламалар бірінен соң бірі шығып жатыр!
Dialogue: 0,0:30:41.02,0:30:44.72,Default,,0,0,0,,Жаңа аниме туралы айтпағанның өзінде...
Dialogue: 0,0:30:51.03,0:30:53.53,Default,,0,0,0,,Әрі қарай→
Dialogue: 0,0:30:56.86,0:30:59.46,Default,,0,0,0,,Мен барлығын көргім келеді →
Dialogue: 0,0:31:00.96,0:31:06.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory