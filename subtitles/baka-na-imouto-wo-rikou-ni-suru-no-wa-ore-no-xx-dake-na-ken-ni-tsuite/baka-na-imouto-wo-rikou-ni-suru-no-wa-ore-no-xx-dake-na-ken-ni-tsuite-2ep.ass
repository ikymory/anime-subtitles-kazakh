Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:05.82,Default_jp,,0,0,0,,Егер дұрыс ұстай алсаң, ағам саған одан да жағымды нәрсе жасайды.
Dialogue: 0,0:00:06.11,0:00:06.61,Default_jp,,0,0,0,,Шынымен бе?
Dialogue: 0,0:00:07.15,0:00:09.50,Default_jp,,0,0,0,,Түсіндім, Басака, шыдаймын.
Dialogue: 0,0:00:10.66,0:00:13.14,Default_jp,,0,0,0,,Мен Басакамен жыныстық қатынасқа түскім келеді.
Dialogue: 0,0:00:14.28,0:00:20.62,Default_jp,,0,0,0,,Шәует ішу сізді ақылды етпейді. Бұл өтірік, бірақ мен оны бір күні түзетуім керек.
Dialogue: 0,0:00:41.60,0:00:44.59,Default_jp,,0,0,0,,Тосапы көп дәмді сорпа
Dialogue: 0,0:00:45.17,0:00:48.08,Default_jp,,0,0,0,,Мен үйде болсам, анам маған ашуланар еді.
Dialogue: 0,0:00:49.18,0:00:50.36,Default_jp,,0,0,0,,Сосын дүкенге барайық
Dialogue: 0,0:00:50.82,0:00:52.76,Default_jp,,0,0,0,,Мен саған көп тосап пен сүт сатып аламын.
Dialogue: 0,0:00:53.13,0:00:56.05,Default_jp,,0,0,0,,Иә, мен сені жақсы көремін аға.
Dialogue: 0,0:00:56.51,0:00:58.96,Default_jp,,0,0,0,,Шоппинг
Dialogue: 0,0:00:59.37,0:01:00.97,Default_jp,,0,0,0,,Тосап пен сүт көп
Dialogue: 0,0:01:02.23,0:01:03.62,Default_jp,,0,0,0,,Әй, бауырым
Dialogue: 0,0:01:04.20,0:01:09.18,Default_jp,,0,0,0,,Басака Сабыр еттім, сондықтан
Dialogue: 0,0:01:09.61,0:01:12.66,Default_jp,,0,0,0,,Басака, сенің мысығың дірілдеп тұр.
Dialogue: 0,0:01:13.54,0:01:16.02,Default_jp,,0,0,0,,Мен ағамның өзін жақсы сезінгенін қалаймын.
Dialogue: 0,0:01:16.44,0:01:19.56,Default_jp,,0,0,0,,Кешіріңіз, аға, мен шегім жетті.
Dialogue: 0,0:01:21.72,0:01:24.13,Default_jp,,0,0,0,,Бұл... мен де мұнда бірінші рет келіп тұрмын.
Dialogue: 0,0:01:25.01,0:01:27.28,Default_jp,,0,0,0,,Мен сенің көңіліңді көтеруге тырысамын.
Dialogue: 0,0:01:28.49,0:01:31.05,Default_jp,,0,0,0,,Тіпті менің ағам да бірінші рет.
Dialogue: 0,0:01:31.62,0:01:33.60,Default_jp,,0,0,0,,Жарайды, бұл Басакамен бірдей.
Dialogue: 0,0:01:35.09,0:01:36.35,Default_jp,,0,0,0,,О... ағайын
Dialogue: 0,0:01:37.35,0:01:39.68,Default_jp,,0,0,0,,Сіз киска жалайсыз ба?
Dialogue: 0,0:01:41.62,0:01:42.42,Default_jp,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:42.98,0:01:45.65,Default_jp,,0,0,0,,Басака сенің сиқырыңды жалап тұрғандай етіп көрсет.
Dialogue: 0,0:01:50.33,0:01:53.12,Default_jp,,0,0,0,,Бұл жақсы сезінуі мүмкін
Dialogue: 0,0:01:53.79,0:01:54.71,Default_jp,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:01:59.12,0:02:02.79,Default_jp,,0,0,0,,Енді менің сүйкімді кишкамды жалап.
Dialogue: 0,0:02:05.24,0:02:07.02,Default_jp,,0,0,0,,Жалауды қамтиды
Dialogue: 0,0:02:08.39,0:02:10.64,Default_jp,,0,0,0,,Сенің мысығың біртүрлі екен.
Dialogue: 0,0:02:11.00,0:02:14.83,Default_jp,,0,0,0,,Ағамның тілі аузымда, сондықтан қобалжыдым.
Dialogue: 0,0:02:16.41,0:02:18.57,Default_jp,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:02:18.99,0:02:21.45,Default_jp,,0,0,0,,Писка жақсы, жақсы.
Dialogue: 0,0:02:22.71,0:02:26.03,Default_jp,,0,0,0,,Үлкен аға Басака, бірдеңе дұрыс емес.
Dialogue: 0,0:02:26.78,0:02:28.58,Default_jp,,0,0,0,,Біртүрлі? Сіз конча аласыз ба?
Dialogue: 0,0:02:29.94,0:02:33.06,Default_jp,,0,0,0,,Қайда? Мен дүкенге барамын
Dialogue: 0,0:02:33.72,0:02:35.33,Default_jp,,0,0,0,,Жарайды, демалыңыз.
Dialogue: 0,0:02:37.88,0:02:41.60,Default_jp,,0,0,0,,Они... Онии-чан Онии-чан
Dialogue: 0,0:02:42.14,0:02:43.67,Default_jp,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:02:44.83,0:02:47.57,Default_jp,,0,0,0,,Бірдеңе... бірдеңе келе жатыр.
Dialogue: 0,0:03:03.34,0:03:05.64,Default_jp,,0,0,0,,Бауырым, бұл не?
Dialogue: 0,0:03:07.18,0:03:08.78,Default_jp,,0,0,0,,Сіз қазір камминг жасап жатырсыз деңіз
Dialogue: 0,0:03:09.31,0:03:11.67,Default_jp,,0,0,0,,Бұл өзімді әлдеқайда жақсы сезінетінімді білдіреді.
Dialogue: 0,0:03:12.11,0:03:15.24,Default_jp,,0,0,0,,Сіз шәует еттіңіз бе? Мен шынымен түсінбеймін
Dialogue: 0,0:03:15.36,0:03:18.14,Default_jp,,0,0,0,,Қаншалықты көп шәует жасасаңыз, соғұрлым өзіңізді жақсы сезінесіз.
Dialogue: 0,0:03:18.32,0:03:21.10,Default_jp,,0,0,0,,Басака Маған ұнайтын нәрсе ұнайды
Dialogue: 0,0:03:21.87,0:03:26.76,Default_jp,,0,0,0,,Сосын мен одан да көп сперме жасап, өзімді жақсы сезінгім келеді.
Dialogue: 0,0:03:29.13,0:03:33.16,Default_jp,,0,0,0,,Шын мәнінде, жақсы сезінудің жолы бар.
Dialogue: 0,0:03:39.16,0:03:41.67,Default_jp,,0,0,0,,Баса, аға, мен не істеймін?
Dialogue: 0,0:03:41.90,0:03:44.47,Default_jp,,0,0,0,,Бұл аздап қиын, сондықтан шыдамды болыңыз.
Dialogue: 0,0:03:44.64,0:03:45.31,Default_jp,,0,0,0,,Шыдамдылық?
Dialogue: 0,0:03:45.74,0:03:46.16,Default_jp,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:03:49.42,0:03:52.62,Default_jp,,0,0,0,,бұл куәлік ешқашан берілмейді.
Dialogue: 0,0:03:52.62,0:03:55.87,Default_jp,,0,0,0,,Кешіріңіз...Кешіріңіз, бірақ басында ғана ауырады.
Dialogue: 0,0:03:59.93,0:04:01.53,Default_jp,,0,0,0,,Үлкен аға
Dialogue: 0,0:04:07.02,0:04:07.90,Default_jp,,0,0,0,,Енгізілді
Dialogue: 0,0:04:08.54,0:04:12.61,Default_jp,,0,0,0,,Жақсы, мен біртүрлі адамға алданып қала ма деп уайымдадым.
Dialogue: 0,0:04:13.22,0:04:15.14,Default_jp,,0,0,0,,Басака сөзсіз пәк болған.
Dialogue: 0,0:04:16.34,0:04:17.89,Default_jp,,0,0,0,,Ауырсынудың соңы?
Dialogue: 0,0:04:18.29,0:04:21.60,Default_jp,,0,0,0,,Аа, Басаның іші сондай жақсы.
Dialogue: 0,0:04:21.83,0:04:24.71,Default_jp,,0,0,0,,Шынымен бе? Басака да өзін жақсы сезіне ала ма?
Dialogue: 0,0:04:24.71,0:04:25.38,Default_jp,,0,0,0,,Әрине
Dialogue: 0,0:04:26.17,0:04:27.01,Default_jp,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:04:30.25,0:04:32.26,Default_jp,,0,0,0,,Сүт бездері жақсы сезінеді
Dialogue: 0,0:04:32.77,0:04:34.96,Default_jp,,0,0,0,,Бірақ менің мығым ауырады
Dialogue: 0,0:04:35.66,0:04:38.04,Default_jp,,0,0,0,,Мен жыныс мүшесін салғанды ұнатпаймын.
Dialogue: 0,0:04:38.04,0:04:39.10,Default_jp,,0,0,0,,Тек басында
Dialogue: 0,0:04:39.57,0:04:43.46,Default_jp,,0,0,0,,Бұл жыныстық қатынасқа түсудің ең жақсы тәсілі.
Dialogue: 0,0:04:43.50,0:04:45.27,Default_jp,,0,0,0,,Жыныстық қатынас?
Dialogue: 0,0:04:45.84,0:04:49.29,Default_jp,,0,0,0,,Ағам жыныстық қатынасқа түскенде көп сүт береді.
Dialogue: 0,0:04:50.29,0:04:51.12,Default_jp,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:04:51.76,0:04:55.13,Default_jp,,0,0,0,,Мен Басака сүтін ішкім келеді, сондықтан жыныстық қатынасқа түсемін.
Dialogue: 0,0:04:55.43,0:04:56.72,Default_jp,,0,0,0,,Жарайды, тамаша.
Dialogue: 0,0:04:58.81,0:05:01.69,Default_jp,,0,0,0,,Ағамның жыныс мүшесі қозғалады.
Dialogue: 0,0:05:01.94,0:05:03.44,Default_jp,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:05:03.45,0:05:07.04,Default_jp,,0,0,0,,Өзіңізді жақсы сезіну үшін жыныс мүшесіңізді кистіңіздің ішіне ысқылаңыз.
Dialogue: 0,0:05:07.73,0:05:08.98,Default_jp,,0,0,0,,Бұл жыныстық қатынас
Dialogue: 0,0:05:09.39,0:05:10.68,Default_jp,,0,0,0,,Бұл жыныстық қатынас
Dialogue: 0,0:05:11.08,0:05:13.00,Default_jp,,0,0,0,,Менің мысығым ауырады
Dialogue: 0,0:05:15.12,0:05:17.84,Default_jp,,0,0,0,,Ол бұрын қатты ауырды.
Dialogue: 0,0:05:17.88,0:05:21.95,Default_jp,,0,0,0,,Өйткені сенің ағаң Ашоканың мысығында өзін жақсы сезінеді.
Dialogue: 0,0:05:22.58,0:05:24.18,Default_jp,,0,0,0,,Басака қуанады.
Dialogue: 0,0:05:24.42,0:05:28.89,Default_jp,,0,0,0,,Сондықтан жыныс мүшесін көбірек жылжытыңыз, сонда ол жақсы сезінеді.
Dialogue: 0,0:05:29.13,0:05:33.60,Default_jp,,0,0,0,,Басақа, аға, олай десең, енді шыдай алмаймын.
Dialogue: 0,0:05:36.45,0:05:37.75,Default_jp,,0,0,0,,Үлкен аға
Dialogue: 0,0:05:42.52,0:05:44.79,Default_jp,,0,0,0,,Ғажайып секс керемет
Dialogue: 0,0:05:47.72,0:05:51.30,Default_jp,,0,0,0,,Ауыруы басыла бастады...
Dialogue: 0,0:05:54.63,0:05:56.70,Default_jp,,0,0,0,,Басака өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:05:57.19,0:05:58.93,Default_jp,,0,0,0,,Жыныстық қатынас жақсы сезінеді ме?
Dialogue: 0,0:05:59.27,0:06:02.49,Default_jp,,0,0,0,,Бұл қытырлақ және үлпілдек шығар.
Dialogue: 0,0:06:02.89,0:06:06.02,Default_jp,,0,0,0,,Бұл да жақсы ма, ағайын? Басакамен сәйкестік пе?
Dialogue: 0,0:06:06.35,0:06:07.62,Default_jp,,0,0,0,,Аа, бұл жақсы сезінеді
Dialogue: 0,0:06:07.88,0:06:10.04,Default_jp,,0,0,0,,Өзімізді жақсы сезінейік
Dialogue: 0,0:06:13.33,0:06:14.36,Default_jp,,0,0,0,,Басака Басака
Dialogue: 0,0:06:14.82,0:06:17.20,Default_jp,,0,0,0,,Үлкен аға Үлкен аға
Dialogue: 0,0:06:20.99,0:06:24.05,Default_jp,,0,0,0,,Үлкен аға, тағы келеді.
Dialogue: 0,0:06:24.92,0:06:27.53,Default_jp,,0,0,0,,Басака салқын, Басака салқын
Dialogue: 0,0:06:28.18,0:06:31.91,Default_jp,,0,0,0,,Басака Ику Ику Ику жыныстық қатынастан
Dialogue: 0,0:06:31.95,0:06:34.77,Default_jp,,0,0,0,,Ику Ику Ику
Dialogue: 0,0:06:40.12,0:06:41.66,Default_jp,,0,0,0,,Басака оргазмы
Dialogue: 0,0:06:43.06,0:06:45.50,Default_jp,,0,0,0,,Ыстық киска
Dialogue: 0,0:06:48.70,0:06:54.98,Default_jp,,0,0,0,,Үлкен аға, Ашиканың мысығында көп нәрсе бар.
Dialogue: 0,0:06:56.42,0:06:57.84,Default_jp,,0,0,0,,Өйткені бұл өте жақсы сезінді
Dialogue: 0,0:06:58.58,0:07:00.51,Default_jp,,0,0,0,,Көп сүт шықты.
Dialogue: 0,0:07:03.52,0:07:08.02,Default_jp,,0,0,0,,Таңғажайып, Ашиканың кискасына көп кірді.
Dialogue: 0,0:07:08.40,0:07:10.65,Default_jp,,0,0,0,,Басака да өзін жақсы сезінді.
Dialogue: 0,0:07:11.19,0:07:13.51,Default_jp,,0,0,0,,Тағы да жыныстық қатынасқа түсейік, ағайын.
Dialogue: 0,0:07:17.42,0:07:22.46,Default_jp,,0,0,0,,Ақымақ ағамды ақылды ететін мен ғана екенмін
Dialogue: 0,0:07:30.59,0:07:31.86,Default_jp,,0,0,0,,Есептер – азап
Dialogue: 0,0:07:34.50,0:07:35.62,Default_jp,,0,0,0,,Мен Басакамен ойнағым келеді
Dialogue: 0,0:07:36.61,0:07:39.39,Default_jp,,0,0,0,,Ағаңның университетте оқи алатыны ғажап.
Dialogue: 0,0:07:40.57,0:07:43.59,Default_jp,,0,0,0,,Мен сізді шақырған кезде қаншалықты аянышты екенімді көрсете алмаймын.
Dialogue: 0,0:07:43.80,0:07:45.82,Default_jp,,0,0,0,,Үлкен аға
Dialogue: 0,0:07:47.09,0:07:48.05,Default_jp,,0,0,0,,Сен білесің, білесің.
Dialogue: 0,0:07:48.38,0:07:51.03,Default_jp,,0,0,0,,Мен Басака туралы таңғаларлық нәрсе таптым.
Dialogue: 0,0:07:55.10,0:07:56.86,Default_jp,,0,0,0,,Не...не істеп жатырсың, Басака?
Dialogue: 0,0:07:57.28,0:08:00.63,Default_jp,,0,0,0,,Күлкілі, себебі түймені басқан кезде ол ызылдайды.
Dialogue: 0,0:08:00.98,0:08:03.14,Default_jp,,0,0,0,,Мен оны кискаға салып көрдім.
Dialogue: 0,0:08:04.05,0:08:07.56,Default_jp,,0,0,0,,Ол ешкім жоқ жерде болуы керек. Бұл мастурбация емес пе?
Dialogue: 0,0:08:07.84,0:08:08.57,Default_jp,,0,0,0,,Мастурбация?
Dialogue: 0,0:08:08.95,0:08:13.05,Default_jp,,0,0,0,,Бірақ, мен Басаканың емшегін де, мысығын да ұстаған жоқпын.
Dialogue: 0,0:08:13.19,0:08:16.26,Default_jp,,0,0,0,,Жоқ, жоқ, егер адамдар сізді көрсе, сізге шабуыл жасалады.
Dialogue: 0,0:08:17.06,0:08:20.85,Default_jp,,0,0,0,,Маған ұнамайды, бірақ бұл өте жақсы, мен тоқтағым келмейді
Dialogue: 0,0:08:21.90,0:08:26.26,Default_jp,,0,0,0,,Менің ағам сізге шабуыл жасамайды, сондықтан оны бүгінгідей қалдыра аласыз.
Dialogue: 0,0:08:26.68,0:08:29.51,Default_jp,,0,0,0,,Шынымен бе? Мастурбация жасай аламын ба?
Dialogue: 0,0:08:31.93,0:08:34.26,Default_jp,,0,0,0,,Жақсы, жақсы сезінеді
Dialogue: 0,0:08:36.03,0:08:38.93,Default_jp,,0,0,0,,Маған әдемі емізік ұнайды
Dialogue: 0,0:08:41.99,0:08:45.32,Default_jp,,0,0,0,,Ей, аға, біз де мастурбация жасайық.
Dialogue: 0,0:08:46.06,0:08:48.26,Default_jp,,0,0,0,,Басака жақсы көрінеді
Dialogue: 0,0:08:48.54,0:08:50.58,Default_jp,,0,0,0,,Басака сәйкес келетін киімдерді ұнатады.
Dialogue: 0,0:08:51.93,0:08:54.68,Default_jp,,0,0,0,,Менің жыныс мүшесім үлкен болып барады.
Dialogue: 0,0:08:55.81,0:08:58.92,Default_jp,,0,0,0,,Менің ағамның мастурбациясы Басакадікінен бөлек.
Dialogue: 0,0:08:59.16,0:09:01.07,Default_jp,,0,0,0,,Сіздің ағаңыз да өзін жақсы сезіне ме?
Dialogue: 0,0:09:01.28,0:09:04.38,Default_jp,,0,0,0,,Аа, Басақаның тентектігі ең жақсы
Dialogue: 0,0:09:04.80,0:09:06.71,Default_jp,,0,0,0,,Мен сенің мұны одан да қарқынды түрде орындағаныңды көргім келеді.
Dialogue: 0,0:09:06.87,0:09:07.98,Default_jp,,0,0,0,,Зорлықпен?
Dialogue: 0,0:09:08.33,0:09:09.84,Default_jp,,0,0,0,,Бүкіл кеудеге массаж жасаңыз
Dialogue: 0,0:09:10.17,0:09:12.57,Default_jp,,0,0,0,,Сонымен қатар контроллерді мықтап ұстаңыз.
Dialogue: 0,0:09:13.87,0:09:15.34,Default_jp,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:09:16.67,0:09:18.49,Default_jp,,0,0,0,,Өзін бұрынғыдан жақсырақ сезінеді
Dialogue: 0,0:09:22.97,0:09:24.91,Default_jp,,0,0,0,,Жарайды, Басака, бұзық екен.
Dialogue: 0,0:09:25.64,0:09:27.31,Default_jp,,0,0,0,,Үлкен ағасы Ашика
Dialogue: 0,0:09:28.39,0:09:30.92,Default_jp,,0,0,0,,Басука Ику Ику
Dialogue: 0,0:09:32.84,0:09:33.97,Default_jp,,0,0,0,,Мен де келемін
Dialogue: 0,0:09:38.67,0:09:40.62,Default_jp,,0,0,0,,Сүт ыстық
Dialogue: 0,0:09:43.54,0:09:45.93,Default_jp,,0,0,0,,Басака аузыңды ашып, тіліңді айт
Dialogue: 0,0:09:46.94,0:09:49.12,Default_jp,,0,0,0,,Сүт көбірек
Dialogue: 0,0:09:54.67,0:09:56.03,Default_jp,,0,0,0,,Бұл көп қажет болды.
Dialogue: 0,0:09:56.64,0:09:59.25,Default_jp,,0,0,0,,Мен сені келесі жолы дұрыстап ішемін.
Dialogue: 0,0:10:01.22,0:10:03.59,Default_jp,,0,0,0,,Ас үшін рахмет.
Dialogue: 0,0:10:13.76,0:10:15.47,Default_jp,,0,0,0,,Терге жабысқан
Dialogue: 0,0:10:15.91,0:10:17.64,Default_jp,,0,0,0,,Бауырым, киіміңді шешуге бола ма?
Dialogue: 0,0:10:17.64,0:10:18.73,Default_jp,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:10:19.01,0:10:21.94,Default_jp,,0,0,0,,Сыртта жалаңаш болсаңыз, бейтаныс адамдар сізге шабуыл жасайды.
Dialogue: 0,0:10:22.42,0:10:24.79,Default_jp,,0,0,0,,Оның үстіне ағам да қамауға алынады.
Dialogue: 0,0:10:25.12,0:10:26.91,Default_jp,,0,0,0,,Мен ұсталамын
Dialogue: 0,0:10:27.23,0:10:29.83,Default_jp,,0,0,0,,Маған ұнамайды, шыдаймын
Dialogue: 0,0:10:30.27,0:10:34.75,Default_jp,,0,0,0,,Мен жақсы қыз боламын, сондықтан сенің ешқайда кеткеніңді қаламаймын.
Dialogue: 0,0:10:35.27,0:10:38.02,Default_jp,,0,0,0,,Басакамен мәңгі бірге болыңыз
Dialogue: 0,0:10:38.36,0:10:41.10,Default_jp,,0,0,0,,Басақ жақсы қыз болса, ешқайда кетпейді.
Dialogue: 0,0:10:44.55,0:10:45.45,Default_jp,,0,0,0,,Сыртта ма, іште ме? Жоғары ма, төмен бе?
Dialogue: 0,0:10:45.74,0:10:48.10,Default_jp,,0,0,0,,Үлкен аға балмұздақ
Dialogue: 0,0:10:51.78,0:10:53.71,Default_jp,,0,0,0,,Суық және дәмді
Dialogue: 0,0:11:02.52,0:11:03.89,Default_jp,,0,0,0,,Мен біраз уақыт ваннаға барамын.
Dialogue: 0,0:11:04.40,0:11:06.70,Default_jp,,0,0,0,,Басака, ана жақтағы орындықта күт.
Dialogue: 0,0:11:07.00,0:11:08.12,Default_jp,,0,0,0,,Иә
Dialogue: 0,0:11:09.00,0:11:13.58,Default_jp,,0,0,0,,Ақымақ апамды ақылды ететін мен ғана екенмін
Dialogue: 0,0:11:20.97,0:11:21.42,Default_jp,,0,0,0,,Баска
Dialogue: 0,0:11:25.81,0:11:27.95,Default_jp,,0,0,0,,Қош келдің, ағайын.
Dialogue: 0,0:11:28.02,0:11:29.38,Default_jp,,0,0,0,,Не...не істеп жатырсың?
Dialogue: 0,0:11:29.86,0:11:34.46,Default_jp,,0,0,0,,Басака қатты қызып кетті, балмұздақ пищасына салсам суытып жібереді деп ойладым.
Dialogue: 0,0:11:35.25,0:11:39.21,Default_jp,,0,0,0,,Бірақ менің кишігім салқын болса да, денем әлі де ыстық.
Dialogue: 0,0:11:41.84,0:11:42.59,Default_jp,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:44.10,0:11:46.38,Default_jp,,0,0,0,,Менің ойымша, егер мен оны толығымен енгізсем, жақсы болар еді.
Dialogue: 0,0:11:48.38,0:11:50.33,Default_jp,,0,0,0,,Салқын киска
Dialogue: 0,0:11:51.06,0:11:53.61,Default_jp,,0,0,0,,Бірақ бұл жақсы сезінеді
Dialogue: 0,0:11:54.49,0:11:56.81,Default_jp,,0,0,0,,Денем қызып барады.
Dialogue: 0,0:11:58.43,0:12:00.56,Default_jp,,0,0,0,,Екінші жағынан, қызып алайық.
Dialogue: 0,0:12:01.29,0:12:03.50,Default_jp,,0,0,0,,Ыстық болса, ыстық болады
Dialogue: 0,0:12:05.27,0:12:06.56,Default_jp,,0,0,0,,Жыныс мүшесі
Dialogue: 0,0:12:07.10,0:12:10.18,Default_jp,,0,0,0,,Бірақ ыстық, сондықтан балмұздақты алғым келмейді.
Dialogue: 0,0:12:11.49,0:12:12.14,Default_jp,,0,0,0,,Егер
Dialogue: 0,0:12:13.79,0:12:15.79,Default_jp,,0,0,0,,Не болды?
Dialogue: 0,0:12:16.58,0:12:18.12,Default_jp,,0,0,0,,Басаканың бөксесі
Dialogue: 0,0:12:23.26,0:12:26.66,Default_jp,,0,0,0,,Жоқ, мен ол жерге кіре алмаймын, мүмкін емес.
Dialogue: 0,0:12:28.16,0:12:30.33,Default_jp,,0,0,0,,Бөксені жайыңыз
Dialogue: 0,0:12:32.78,0:12:33.62,Default_jp,,0,0,0,,Қараңдар, мен кірдім.
Dialogue: 0,0:12:34.16,0:12:36.05,Default_jp,,0,0,0,,Бөксесімен де жыныстық қатынасқа түсуге болады.
Dialogue: 0,0:12:36.45,0:12:38.06,Default_jp,,0,0,0,,Бұл шынымен де сонда.
Dialogue: 0,0:12:38.48,0:12:41.56,Default_jp,,0,0,0,,Есік болса да, мысқалдай.
Dialogue: 0,0:12:43.55,0:12:47.20,Default_jp,,0,0,0,,Бұл ауырған болуы керек, сондықтан мен сізді жақсы сезінуге мүмкіндік беремін.
Dialogue: 0,0:12:52.40,0:12:53.45,Default_jp,,0,0,0,,Қаншалықты эротикалық
Dialogue: 0,0:12:53.98,0:12:56.26,Default_jp,,0,0,0,,Жыныс мүшесі Басаканың бөксесіне кіріп-шығады
Dialogue: 0,0:12:58.59,0:13:02.30,Default_jp,,0,0,0,,Ұят болды, бөксесіме қарама.
Dialogue: 0,0:13:03.44,0:13:06.78,Default_jp,,0,0,0,,Менің бөксесі ыстық, бірақ менің мығым суық.
Dialogue: 0,0:13:07.26,0:13:12.90,Default_jp,,0,0,0,,Ыстық-суық, түсінбеймін, бірақ жақсы сезіледі
Dialogue: 0,0:13:13.81,0:13:15.90,Default_jp,,0,0,0,,Балмұздақ еріп жатыр, ал сіздің писькиіңіз дәмді көрінеді.
Dialogue: 0,0:13:16.62,0:13:18.29,Default_jp,,0,0,0,,Мен сенің ағаңды жалай аламын ба?
Dialogue: 0,0:13:18.65,0:13:20.03,Default_jp,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:13:20.42,0:13:22.19,Default_jp,,0,0,0,,Менің бөксем қазір жақсы.
Dialogue: 0,0:13:22.77,0:13:25.18,Default_jp,,0,0,0,,Өзіңізді жақсы сезінуді тоқтатпаңыз
Dialogue: 0,0:13:26.28,0:13:29.37,Default_jp,,0,0,0,,Жалынсаң тоқтамасқа амал жоқ.
Dialogue: 0,0:13:30.69,0:13:32.67,Default_jp,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:13:36.83,0:13:38.19,Default_jp,,0,0,0,,Анальды қатайту
Dialogue: 0,0:13:39.36,0:13:41.06,Default_jp,,0,0,0,,Басака да...қазірдің өзінде
Dialogue: 0,0:13:41.21,0:13:45.56,Default_jp,,0,0,0,,Жоқ, аға, мен әлі де камминг жасаймын.
Dialogue: 0,0:13:45.93,0:13:47.47,Default_jp,,0,0,0,,Міне осылай.
Dialogue: 0,0:13:48.97,0:13:50.43,Default_jp,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:13:51.02,0:13:52.07,Default_jp,,0,0,0,,Мен сықылдым
Dialogue: 0,0:13:53.29,0:13:55.60,Default_jp,,0,0,0,,Үлкен аға Үлкен аға
Dialogue: 0,0:13:56.58,0:13:58.86,Default_jp,,0,0,0,,Қарашы, Басақа, мен де тамсанып жатырмын.
Dialogue: 0,0:14:00.29,0:14:01.84,Default_jp,,0,0,0,,Басака Ику Ику
Dialogue: 0,0:14:02.54,0:14:04.45,Default_jp,,0,0,0,,Ику Ику
Dialogue: 0,0:14:08.66,0:14:11.84,Default_jp,,0,0,0,,Пискадан айырмашылығы.
Dialogue: 0,0:14:13.62,0:14:18.31,Default_jp,,0,0,0,,Үлкен ағаның сүті менің құлынымда.
Dialogue: 0,0:14:19.77,0:14:21.83,Default_jp,,0,0,0,,Ыстық жопа
Dialogue: 0,0:14:22.13,0:14:23.78,Default_jp,,0,0,0,,Сүтті дұрыс ішпесеңіз
Dialogue: 0,0:14:24.48,0:14:26.26,Default_jp,,0,0,0,,Сіз ақылды бола алмайсыз.
Dialogue: 0,0:14:37.36,0:14:39.90,Default_jp,,0,0,0,,Үлкен аға керемет
Dialogue: 0,0:14:40.05,0:14:43.83,Default_jp,,0,0,0,,Сіздің мысықтан басқа жыныс мүшесін салатын орындар бар.
Dialogue: 0,0:14:44.08,0:14:49.56,Default_jp,,0,0,0,,Басака сүтті көп ішіп, ағасындай ақылды болу керек.
Dialogue: 0,0:14:54.70,0:14:57.88,Default_jp,,0,0,0,,Мен сиырдың сүтін де, ағамның сүтін де жақсы көремін.
Dialogue: 0,0:14:58.85,0:15:03.13,Default_jp,,0,0,0,,Ағаның сүтін күнде ішсең, ақылды боласың.
Dialogue: 0,0:15:03.84,0:15:07.32,Default_jp,,0,0,0,,Содан Басака ағасымен бір университетке түседі.
Dialogue: 0,0:15:08.02,0:15:10.22,Default_jp,,0,0,0,,Жоқ, бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:15:11.19,0:15:13.66,Default_jp,,0,0,0,,Үлкен аға, сүтті толтыру
Dialogue: 0,0:15:14.27,0:15:15.08,Default_jp,,0,0,0,,Қайсысы... қайсысы?
Dialogue: 0,0:15:16.81,0:15:18.50,Default_jp,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 1,0:00:01.71,0:00:05.82,Default,,0,0,0,,Сізге ыңғайлы болу үшін.
Dialogue: 1,0:00:06.11,0:00:06.61,Default,,0,0,0,,Шынайы оқиға
Dialogue: 1,0:00:07.15,0:00:09.50,Default,,0,0,0,,Рио Чидо Басукай Нинджу
Dialogue: 1,0:00:10.66,0:00:13.14,Default,,0,0,0,,Мен бұл туралы табиғи түрде ойладым және оны жақсы көрдім.
Dialogue: 1,0:00:14.28,0:00:20.62,Default,,0,0,0,,Бұл жақсы келісімге қол жеткізудің ең жылдам жолы.
Dialogue: 1,0:00:21.00,0:00:34.98,staff,,0,0,0,,II ： ：Fi ：
Dialogue: 1,0:00:21.00,0:00:34.98,Default,,0,0,0,,Әпкем мен әпкем туралы білгенде осылай болды.
Dialogue: 1,0:00:22.93,0:00:34.98,Default,,0,0,0,,Хиноя Хиноя ең бақытты!! Мицуи Басуяның тұмсық соратын тәжірибе басылымы
Dialogue: 1,0:00:41.60,0:00:44.59,Default,,0,0,0,,Сәттілік
Dialogue: 1,0:00:45.17,0:00:48.08,Default,,0,0,0,,Ауылдағы мейрамханаға қарапайым адам баратын мейрамхана.
Dialogue: 1,0:00:49.18,0:00:50.36,Default,,0,0,0,,...
Dialogue: 1,0:00:50.82,0:00:52.76,Default,,0,0,0,,Жапондық сиыр етін қалай сатып алуға болады
Dialogue: 1,0:00:53.13,0:00:56.05,Default,,0,0,0,,Сәттілік
Dialogue: 1,0:00:56.51,0:00:58.96,Default,,0,0,0,,Шығыс Батысты сатып алыңыз Шығыс Батысты сатып алыңыз
Dialogue: 1,0:00:59.37,0:01:00.97,Default,,0,0,0,,Әртүрлі жемістер мен көкөністерді сатып алу
Dialogue: 1,0:01:02.23,0:01:03.62,Default,,0,0,0,,Нагай Геге
Dialogue: 1,0:01:04.20,0:01:09.18,Default,,0,0,0,,Мұның себебі
Dialogue: 1,0:01:09.61,0:01:12.66,Default,,0,0,0,,Гүлдің кішкентай тесігі қышиды, қышиды.
Dialogue: 1,0:01:13.54,0:01:16.02,Default,,0,0,0,,Дүкенге келгенде
Dialogue: 1,0:01:16.44,0:01:19.56,Default,,0,0,0,,...
Dialogue: 1,0:01:21.72,0:01:24.13,Default,,0,0,0,,Байланыс… байланысқа қатысты мәселе Мен де біріншімін
Dialogue: 1,0:01:25.01,0:01:27.28,Default,,0,0,0,,Менің сізбен белгілі бір келісімім бар.
Dialogue: 1,0:01:28.49,0:01:31.05,Default,,0,0,0,,Негізгі жағдайлар
Dialogue: 1,0:01:31.62,0:01:33.60,Default,,0,0,0,,Нава Башуа Ичисанрё
Dialogue: 1,0:01:35.09,0:01:36.35,Default,,0,0,0,,Барыңыз… Барыңыз
Dialogue: 1,0:01:37.35,0:01:39.68,Default,,0,0,0,,Қажетті шағын тесік
Dialogue: 1,0:01:41.62,0:01:42.42,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 1,0:01:42.98,0:01:45.65,Default,,0,0,0,,Ұл баланың бейнесі
Dialogue: 1,0:01:50.33,0:01:53.12,Default,,0,0,0,,Насака Йошизо суреті шығарылды
Dialogue: 1,0:01:53.79,0:01:54.71,Default,,0,0,0,,Бұл баратын жер
Dialogue: 1,0:01:59.12,0:02:02.79,Default,,0,0,0,,Қазіргі уақытта мен қайдамын
Dialogue: 1,0:02:05.24,0:02:07.02,Default,,0,0,0,,Тіл ұзартылған
Dialogue: 1,0:02:08.39,0:02:10.64,Default,,0,0,0,,Коанаридің беті елес
Dialogue: 1,0:02:11.00,0:02:14.83,Default,,0,0,0,,Толқу мен толқу сезімі
Dialogue: 1,0:02:16.41,0:02:18.57,Default,,0,0,0,,Бағалау және киім кию
Dialogue: 1,0:02:18.99,0:02:21.45,Default,,0,0,0,,Кішкентай саңылау косифуку кошифуку
Dialogue: 1,0:02:22.71,0:02:26.03,Default,,0,0,0,,Шатқал
Dialogue: 1,0:02:26.78,0:02:28.58,Default,,0,0,0,,Жұмбақ? Кету керек
Dialogue: 1,0:02:29.94,0:02:33.06,Default,,0,0,0,,Шығыс пен Батыс Батыстан шығу
Dialogue: 1,0:02:33.72,0:02:35.33,Default,,0,0,0,,...
Dialogue: 1,0:02:37.88,0:02:41.60,Default,,0,0,0,,Бару... Бару, бару
Dialogue: 1,0:02:42.14,0:02:43.67,Default,,0,0,0,,Қажет емес Міндетті емес
Dialogue: 1,0:02:44.83,0:02:47.57,Default,,0,0,0,,Сезім...Мен Шығыс пен Батысқа келгенімді сеземін.
Dialogue: 1,0:03:03.34,0:03:05.64,Default,,0,0,0,,Бұл оқиға
Dialogue: 1,0:03:07.18,0:03:08.78,Default,,0,0,0,,Дарынды адам «кетеді»
Dialogue: 1,0:03:09.31,0:03:11.67,Default,,0,0,0,,Бұл төтенше жағдай қызметкері болу сезімі.
Dialogue: 1,0:03:12.11,0:03:15.24,Default,,0,0,0,,...
Dialogue: 1,0:03:15.36,0:03:18.14,Default,,0,0,0,,Кеткеннен кейін
Dialogue: 1,0:03:18.32,0:03:21.10,Default,,0,0,0,,Ләззат сезімі
Dialogue: 1,0:03:21.87,0:03:26.76,Default,,0,0,0,,Наба Хуа Канаме Сайтакё Ринджи Сарака Шуфуку
Dialogue: 1,0:03:29.13,0:03:33.16,Default,,0,0,0,,Бұл әрі қарай қолданудың жолы.
Dialogue: 1,0:03:39.16,0:03:41.67,Default,,0,0,0,,...
Dialogue: 1,0:03:41.90,0:03:44.47,Default,,0,0,0,,...
Dialogue: 1,0:03:44.64,0:03:45.31,Default,,0,0,0,,Синджу?
Dialogue: 1,0:03:45.74,0:03:46.16,Default,,0,0,0,,Мен өмірден өттім.
Dialogue: 1,0:03:49.42,0:03:52.62,Default,,0,0,0,,Гоге және т.б.
Dialogue: 1,0:03:52.62,0:03:55.87,Default,,0,0,0,,Құшақта... Құшақтап ал, бірақ бұл кездесудің басындағы ауыр сезім ғана.
Dialogue: 1,0:03:59.93,0:04:01.53,Default,,0,0,0,,Гор
Dialogue: 1,0:04:07.02,0:04:07.90,Default,,0,0,0,,Қайтыс болды
Dialogue: 1,0:04:08.54,0:04:12.61,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 1,0:04:13.22,0:04:15.14,Default,,0,0,0,,Бастапқы шығу тегі – әйел
Dialogue: 1,0:04:16.34,0:04:17.89,Default,,0,0,0,,Ауырсыну аяқталады.
Dialogue: 1,0:04:18.29,0:04:21.60,Default,,0,0,0,,...
Dialogue: 1,0:04:21.83,0:04:24.71,Default,,0,0,0,,Шындық, Басуяның тәжірибесі келді.
Dialogue: 1,0:04:24.71,0:04:25.38,Default,,0,0,0,,Әрине
Dialogue: 1,0:04:26.17,0:04:27.01,Default,,0,0,0,,бірақ істерді тым күрделендіру жүректе қорқыныш тудырады, ал Миста бұны жақсы нәрсе деп санамайды
Dialogue: 1,0:04:30.25,0:04:32.26,Default,,0,0,0,,Кеудеге арналған киім
Dialogue: 1,0:04:32.77,0:04:34.96,Default,,0,0,0,,Дегенмен, бұл кішкентай тесік.
Dialogue: 1,0:04:35.66,0:04:38.04,Default,,0,0,0,,Кішкентай балаларға қажет емес
Dialogue: 1,0:04:38.04,0:04:39.10,Default,,0,0,0,,Ашылу салтанаты
Dialogue: 1,0:04:39.57,0:04:43.46,Default,,0,0,0,,Бейнеге бағынудың ең жақсы жолы – оны сүю.
Dialogue: 1,0:04:43.50,0:04:45.27,Default,,0,0,0,,Махаббат?
Dialogue: 1,0:04:45.84,0:04:49.29,Default,,0,0,0,,...
Dialogue: 1,0:04:50.29,0:04:51.12,Default,,0,0,0,,Башуакай қосымшасы
Dialogue: 1,0:04:51.76,0:04:55.13,Default,,0,0,0,,Махаббаттың арқасында
Dialogue: 1,0:04:55.43,0:04:56.72,Default,,0,0,0,,Тыңдалмаған
Dialogue: 1,0:04:58.81,0:05:01.69,Default,,0,0,0,,Гор әтешінің болуы
Dialogue: 1,0:05:01.94,0:05:03.44,Default,,0,0,0,,Қайдасың?
Dialogue: 1,0:05:03.45,0:05:07.04,Default,,0,0,0,,Ет таяқшасы үйкеліс шағын тесік ауылы
Dialogue: 1,0:05:07.73,0:05:08.98,Default,,0,0,0,,Бұл махаббат
Dialogue: 1,0:05:09.39,0:05:10.68,Default,,0,0,0,,Бұл махаббат
Dialogue: 1,0:05:11.08,0:05:13.00,Default,,0,0,0,,Шағын тесік жақсы қабылдау
Dialogue: 1,0:05:15.12,0:05:17.84,Default,,0,0,0,,Абсолютті талантты және көпшіліктің көңілінен шыққан
Dialogue: 1,0:05:17.88,0:05:21.95,Default,,0,0,0,,Дегенмен, ауылда кішкене шұңқыр бар.
Dialogue: 1,0:05:22.58,0:05:24.18,Default,,0,0,0,,Өзін жақсы сезіну және ашық ой
Dialogue: 1,0:05:24.42,0:05:28.89,Default,,0,0,0,,Осыған байланысты аздаған қосымша қозғалыс бар.
Dialogue: 1,0:05:29.13,0:05:33.60,Default,,0,0,0,,...
Dialogue: 1,0:05:36.45,0:05:37.75,Default,,0,0,0,,Гор
Dialogue: 1,0:05:42.52,0:05:44.79,Default,,0,0,0,,...
Dialogue: 1,0:05:47.72,0:05:51.30,Default,,0,0,0,,Бастаудың жақсы бейнесі...
Dialogue: 1,0:05:54.63,0:05:56.70,Default,,0,0,0,,Гүлді бастау сезімі келді.
Dialogue: 1,0:05:57.19,0:05:58.93,Default,,0,0,0,,...
Dialogue: 1,0:05:59.27,0:06:02.49,Default,,0,0,0,,Әртүрлі сусындардың жақсы бейнесі.
Dialogue: 1,0:06:02.89,0:06:06.02,Default,,0,0,0,,...
Dialogue: 1,0:06:06.35,0:06:07.62,Default,,0,0,0,,...
Dialogue: 1,0:06:07.88,0:06:10.04,Default,,0,0,0,,Қайтадан шығарылған киімдердің бір бөлігі
Dialogue: 1,0:06:13.33,0:06:14.36,Default,,0,0,0,,Башуа Башуа
Dialogue: 1,0:06:14.82,0:06:17.20,Default,,0,0,0,,Шатқал шатқалы
Dialogue: 1,0:06:20.99,0:06:24.05,Default,,0,0,0,,Мен өз сезімдеріме сене алмаймын.
Dialogue: 1,0:06:24.92,0:06:27.53,Default,,0,0,0,,Отбасынан шыққаннан кейін
Dialogue: 1,0:06:28.18,0:06:31.91,Default,,0,0,0,,...
Dialogue: 1,0:06:31.95,0:06:34.77,Default,,0,0,0,,кету кету кету кету
Dialogue: 1,0:06:40.12,0:06:41.66,Default,,0,0,0,,Банхуа кетті
Dialogue: 1,0:06:43.06,0:06:45.50,Default,,0,0,0,,Коана Йошито
Dialogue: 1,0:06:48.70,0:06:54.98,Default,,0,0,0,,Зайбана шатқалы
Dialogue: 1,0:06:56.42,0:06:57.84,Default,,0,0,0,,Үкіметке арналған
Dialogue: 1,0:06:58.58,0:07:00.51,Default,,0,0,0,,Осыдан кейін
Dialogue: 1,0:07:03.52,0:07:08.02,Default,,0,0,0,,Жақсы немесе нашар зақым
Dialogue: 1,0:07:08.40,0:07:10.65,Default,,0,0,0,,Басуяның үлкен күш сезімі
Dialogue: 1,0:07:11.19,0:07:13.51,Default,,0,0,0,,Осыдан кейін мен сені тағы да жақсы көремін.
Dialogue: 1,0:07:17.42,0:07:22.46,Default,,0,0,0,,Түсіндіру үшін жағдай осылай
Dialogue: 1,0:07:30.59,0:07:31.86,Default,,0,0,0,,Фотосурет туралы есеп
Dialogue: 1,0:07:34.50,0:07:35.62,Default,,0,0,0,,Хосова Башуа ойыны
Dialogue: 1,0:07:36.61,0:07:39.39,Default,,0,0,0,,Токио университетінің білімі
Dialogue: 1,0:07:40.57,0:07:43.59,Default,,0,0,0,,Мені көре алмаған қарияны көргенде мен оған айқайладым.
Dialogue: 1,0:07:43.80,0:07:45.82,Default,,0,0,0,,Гор
Dialogue: 1,0:07:47.09,0:07:48.05,Default,,0,0,0,,Хабарландыру
Dialogue: 1,0:07:48.38,0:07:51.03,Default,,0,0,0,,Банан салынған үлкен сурет
Dialogue: 1,0:07:55.10,0:07:56.86,Default,,0,0,0,,Сіз... осындасыз.
Dialogue: 1,0:07:57.28,0:08:00.63,Default,,0,0,0,,Шара жасалып, шешім қабылданды.
Dialogue: 1,0:08:00.98,0:08:03.14,Default,,0,0,0,,Штанганың кішкене тесігінде
Dialogue: 1,0:08:04.05,0:08:07.56,Default,,0,0,0,,Адамдардың мастурбация жасауы мүмкін емес.
Dialogue: 1,0:08:07.84,0:08:08.57,Default,,0,0,0,,Мастурбация?
Dialogue: 1,0:08:08.95,0:08:13.05,Default,,0,0,0,,Дегенмен, бұл кішкентай тесік.
Dialogue: 1,0:08:13.19,0:08:16.26,Default,,0,0,0,,Тәртіпсіздік, басқа адаммен сөйлесуді бұзу
Dialogue: 1,0:08:17.06,0:08:20.85,Default,,0,0,0,,Міндетті емес, бірақ бұл жақсы идея.
Dialogue: 1,0:08:21.90,0:08:26.26,Default,,0,0,0,,Сенің жұмаққа баруың мүмкін емес.
Dialogue: 1,0:08:26.68,0:08:29.51,Default,,0,0,0,,Нағыз мастурбация
Dialogue: 1,0:08:31.93,0:08:34.26,Default,,0,0,0,,Жақсы таяқ, жақсы киім
Dialogue: 1,0:08:36.03,0:08:38.93,Default,,0,0,0,,Жақсы таяқ сүт басы жақсы қуаныш
Dialogue: 1,0:08:41.99,0:08:45.32,Default,,0,0,0,,Мастурбацияға келу
Dialogue: 1,0:08:46.06,0:08:48.26,Default,,0,0,0,,Башуайо Кагогева Га Ичито
Dialogue: 1,0:08:48.54,0:08:50.58,Default,,0,0,0,,Шындық – бақыт
Dialogue: 1,0:08:51.93,0:08:54.68,Default,,0,0,0,,Кіші және үлкен өзгерістер
Dialogue: 1,0:08:55.81,0:08:58.92,Default,,0,0,0,,Түпнұсқа түрінде мастурбация
Dialogue: 1,0:08:59.16,0:09:01.07,Default,,0,0,0,,Тамаша киімдер
Dialogue: 1,0:09:01.28,0:09:04.38,Default,,0,0,0,,Иә
Dialogue: 1,0:09:04.80,0:09:06.71,Default,,0,0,0,,Менің ойларым одан да қатты.
Dialogue: 1,0:09:06.87,0:09:07.98,Default,,0,0,0,,Қарқынды?
Dialogue: 1,0:09:08.33,0:09:09.84,Default,,0,0,0,,Сүт безі массажының шығу тегі
Dialogue: 1,0:09:10.17,0:09:12.57,Default,,0,0,0,,...
Dialogue: 1,0:09:13.87,0:09:15.34,Default,,0,0,0,,Жақсы ынталандыру
Dialogue: 1,0:09:16.67,0:09:18.49,Default,,0,0,0,,Хиба Сайшо Шофуку аяқталды
Dialogue: 1,0:09:22.97,0:09:24.91,Default,,0,0,0,,H
Dialogue: 1,0:09:25.64,0:09:27.31,Default,,0,0,0,,...
Dialogue: 1,0:09:28.39,0:09:30.92,Default,,0,0,0,,Башуа кетуге мәжбүр болды
Dialogue: 1,0:09:32.84,0:09:33.97,Default,,0,0,0,,Гая Канаме түсірілімі аяқталды
Dialogue: 1,0:09:38.67,0:09:40.62,Default,,0,0,0,,Ушисай Кобо
Dialogue: 1,0:09:43.54,0:09:45.93,Default,,0,0,0,,Бахуа тұмсығы тіл үшін ашылады
Dialogue: 1,0:09:46.94,0:09:49.12,Default,,0,0,0,,...
Dialogue: 1,0:09:54.67,0:09:56.03,Default,,0,0,0,,Меншік иесінің мәртебесі
Dialogue: 1,0:09:56.64,0:09:59.25,Default,,0,0,0,,Төменде қайта оқыңыз.
Dialogue: 1,0:10:01.22,0:10:03.59,Default,,0,0,0,,Салық шарттары
Dialogue: 1,0:10:13.76,0:10:15.47,Default,,0,0,0,,Терлеген киім капитал бар
Dialogue: 1,0:10:15.91,0:10:17.64,Default,,0,0,0,,...
Dialogue: 1,0:10:17.64,0:10:18.73,Default,,0,0,0,,Тәртіпсіздік
Dialogue: 1,0:10:19.01,0:10:21.94,Default,,0,0,0,,Шетелдегі қатысушылардың көтерілісі
Dialogue: 1,0:10:22.42,0:10:24.79,Default,,0,0,0,,Дегенмен
Dialogue: 1,0:10:25.12,0:10:26.91,Default,,0,0,0,,Қарсыласу
Dialogue: 1,0:10:27.23,0:10:29.83,Default,,0,0,0,,Қажет емес
Dialogue: 1,0:10:30.27,0:10:34.75,Default,,0,0,0,,...
Dialogue: 1,0:10:35.27,0:10:38.02,Default,,0,0,0,,Ичикодағы Ичизокува Башуа
Dialogue: 1,0:10:38.36,0:10:41.10,Default,,0,0,0,,Ертегіні оқу керек.
Dialogue: 1,0:10:44.55,0:10:45.45,Default,,0,0,0,,Бар мұз
Dialogue: 1,0:10:45.74,0:10:48.10,Default,,0,0,0,,...
Dialogue: 1,0:10:51.78,0:10:53.71,Default,,0,0,0,,Балмұздақтың дәмі
Dialogue: 1,0:11:02.52,0:11:03.89,Default,,0,0,0,,Мен кеттім
Dialogue: 1,0:11:04.40,0:11:06.70,Default,,0,0,0,,Башуа Сен менің үстімдегі орындықты қалдырдың.
Dialogue: 1,0:11:07.00,0:11:08.12,Default,,0,0,0,,Қазірге дейін
Dialogue: 1,0:11:09.00,0:11:13.58,Default,,0,0,0,,Әпкем өз ойын өзгерткенде солай болды.
Dialogue: 1,0:11:20.97,0:11:21.42,Default,,0,0,0,,Банхуа
Dialogue: 1,0:11:25.81,0:11:27.95,Default,,0,0,0,,Гоге Гай Гай Кай
Dialogue: 1,0:11:28.02,0:11:29.38,Default,,0,0,0,,Сіз... осындасыз
Dialogue: 1,0:11:29.86,0:11:34.46,Default,,0,0,0,,Жылу сезімі мен бардың қызуы, мұздың шығуы және кішкентай тесіктегі жылу сезімі.
Dialogue: 1,0:11:35.25,0:11:39.21,Default,,0,0,0,,Дегенмен, тесік салқын, денесі жылы.
Dialogue: 1,0:11:41.84,0:11:42.59,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 1,0:11:44.10,0:11:46.38,Default,,0,0,0,,Бір ұпайлық қалпына келтіруге қол жеткізу
Dialogue: 1,0:11:48.38,0:11:50.33,Default,,0,0,0,,Кішкене тесік салқын
Dialogue: 1,0:11:51.06,0:11:53.61,Default,,0,0,0,,Алайда бұл қабылданбайды.
Dialogue: 1,0:11:54.49,0:11:56.81,Default,,0,0,0,,...
Dialogue: 1,0:11:58.43,0:12:00.56,Default,,0,0,0,,Қажетсіз қыздыру нүктесі
Dialogue: 1,0:12:01.29,0:12:03.50,Default,,0,0,0,,Ыстық уақыттан ыстық шығыс пен батысқа дейін
Dialogue: 1,0:12:05.27,0:12:06.56,Default,,0,0,0,,...
Dialogue: 1,0:12:07.10,0:12:10.18,Default,,0,0,0,,Бірақ жылудың қажеті жоқ.
Dialogue: 1,0:12:11.49,0:12:12.14,Default,,0,0,0,,Нана
Dialogue: 1,0:12:13.79,0:12:15.79,Default,,0,0,0,,...
Dialogue: 1,0:12:16.58,0:12:18.12,Default,,0,0,0,,Нари - барға кіретін есік
Dialogue: 1,0:12:23.26,0:12:26.66,Default,,0,0,0,,Нари қажетсіз, мүмкін емес, мүмкін емес
Dialogue: 1,0:12:28.16,0:12:30.33,Default,,0,0,0,,Анальды қақпа қажет
Dialogue: 1,0:12:32.78,0:12:33.62,Default,,0,0,0,,Өткенге көз саласың
Dialogue: 1,0:12:34.16,0:12:36.05,Default,,0,0,0,,Анальды қақпа да мүмкін.
Dialogue: 1,0:12:36.45,0:12:38.06,Default,,0,0,0,,Нағыз прогресс
Dialogue: 1,0:12:38.48,0:12:41.56,Default,,0,0,0,,Минминг – сақиналы қақпа.
Dialogue: 1,0:12:43.55,0:12:47.20,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 1,0:12:52.40,0:12:53.45,Default,,0,0,0,,Нағыз нәпсі
Dialogue: 1,0:12:53.98,0:12:56.26,Default,,0,0,0,,Шағын жинақты мектептің кіреберіс қақпасының барысы
Dialogue: 1,0:12:58.59,0:13:02.30,Default,,0,0,0,,Анусқа қараудың қажеті жоқ
Dialogue: 1,0:13:03.44,0:13:06.78,Default,,0,0,0,,Анальды қақпа ыстық, бірақ кішкентай тесік жақсы.
Dialogue: 1,0:13:07.26,0:13:12.90,Default,,0,0,0,,Бұл да ыстық және салқын, бірақ бұл жақсы идея.
Dialogue: 1,0:13:13.81,0:13:15.90,Default,,0,0,0,,Кішкентай шұңқырды көру өте дәмді.
Dialogue: 1,0:13:16.62,0:13:18.29,Default,,0,0,0,,...
Dialogue: 1,0:13:18.65,0:13:20.03,Default,,0,0,0,,Міндетті емес
Dialogue: 1,0:13:20.42,0:13:22.19,Default,,0,0,0,,Ағымдағы жағдай - кіреберіс қақпасы қызметі.
Dialogue: 1,0:13:22.77,0:13:25.18,Default,,0,0,0,,Берудің қажеті жоқ
Dialogue: 1,0:13:26.28,0:13:29.37,Default,,0,0,0,,Осы жерден тоқтағыңыз келсе
Dialogue: 1,0:13:30.69,0:13:32.67,Default,,0,0,0,,Енді тек оны жеңу жолын табу ғана қалды.
Dialogue: 1,0:13:36.83,0:13:38.19,Default,,0,0,0,,Анальды ашу
Dialogue: 1,0:13:39.36,0:13:41.06,Default,,0,0,0,,Баса I...Мен ештеңе істеген жоқпын
Dialogue: 1,0:13:41.21,0:13:45.56,Default,,0,0,0,,Қажет емес
Dialogue: 1,0:13:45.93,0:13:47.47,Default,,0,0,0,,Нашу каори
Dialogue: 1,0:13:48.97,0:13:50.43,Default,,0,0,0,,Жақсы таяқ
Dialogue: 1,0:13:51.02,0:13:52.07,Default,,0,0,0,,Кету керек
Dialogue: 1,0:13:53.29,0:13:55.60,Default,,0,0,0,,Шатқал шатқалы
Dialogue: 1,0:13:56.58,0:13:58.86,Default,,0,0,0,,...
Dialogue: 1,0:14:00.29,0:14:01.84,Default,,0,0,0,,Бахуа кетуі керек
Dialogue: 1,0:14:02.54,0:14:04.45,Default,,0,0,0,,кетуге кетіңіз
Dialogue: 1,0:14:08.66,0:14:11.84,Default,,0,0,0,,Вакоана Фуичито
Dialogue: 1,0:14:13.62,0:14:18.31,Default,,0,0,0,,Сиырлар анустың кіреберісіне келгенде.
Dialogue: 1,0:14:19.77,0:14:21.83,Default,,0,0,0,,Анальды қақпа жақсы жылу
Dialogue: 1,0:14:22.13,0:14:23.78,Default,,0,0,0,,Жиренішті ақымақ әңгіме
Dialogue: 1,0:14:24.48,0:14:26.26,Default,,0,0,0,,Бұл жақсы идея емес.
Dialogue: 1,0:14:37.36,0:14:39.90,Default,,0,0,0,,Сәттілік
Dialogue: 1,0:14:40.05,0:14:43.83,Default,,0,0,0,,Бастапқы орын кішкентай тесіктен жойылды.
Dialogue: 1,0:14:44.08,0:14:49.56,Default,,0,0,0,,Басұя бейнесі, бата аты, сиыр аты
Dialogue: 1,0:14:54.70,0:14:57.88,Default,,0,0,0,,Сиырдың аты - сиырдың аты.
Dialogue: 1,0:14:58.85,0:15:03.13,Default,,0,0,0,,Аспан қаласы көңіл көтерген сайын Сиыр әңгімесі аталады.
Dialogue: 1,0:15:03.84,0:15:07.32,Default,,0,0,0,,Сол университеттің университеті
Dialogue: 1,0:15:08.02,0:15:10.22,Default,,0,0,0,,Бұлай істеу мүмкін емес
Dialogue: 1,0:15:11.19,0:15:13.66,Default,,0,0,0,,...
Dialogue: 1,0:15:14.27,0:15:15.08,Default,,0,0,0,,Сіз... сіз маңызды типсіз
Dialogue: 1,0:15:16.81,0:15:18.50,Default,,0,0,0,,Ақпаратты сұрау
