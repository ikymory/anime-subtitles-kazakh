Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:29.32,0:00:31.11,Default,,0,0,0,,Voyager 5 жоғалып кетті ме?
Dialogue: 0,0:00:31.23,0:00:31.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:32.03,0:00:35.49,Default,,0,0,0,,Дұрыс, жұмбақ аспан денесінің тартылыс күшімен ұсталды.
Dialogue: 0,0:00:35.61,0:00:36.95,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:00:37.07,0:00:39.03,Default,,0,0,0,,Ол сол қашықтықта ұсталды ма?
Dialogue: 0,0:00:39.16,0:00:41.87,Default,,0,0,0,,Массасы сонша...
Dialogue: 0,0:00:42.33,0:00:47.04,Default,,0,0,0,,Мәселе сол аспан денесінің Жерге қарай бет алуында.
Dialogue: 0,0:00:48.04,0:00:51.84,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Жер міндетті түрде...
Dialogue: 0,0:00:52.30,0:00:53.38,Default,,0,0,0,,(Ғалымдардың шағымдары)
Dialogue: 0,0:00:53.51,0:00:55.47,Default,,0,0,0,,Бұл жердің соңы ма?
Dialogue: 0,0:00:55.76,0:00:57.84,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:00:58.72,0:01:02.06,Default,,0,0,0,,Вояжер таратқан соңғы бейне талданды.
Dialogue: 0,0:01:02.18,0:01:02.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:03.06,0:01:05.02,Default,,0,0,0,,Ол жерге жетуі мүмкін.
Dialogue: 0,0:01:05.35,0:01:06.94,Default,,0,0,0,,Мияко! (Мияко) Иә.
Dialogue: 0,0:01:08.31,0:01:09.23,Default,,0,0,0,,Расталған
Dialogue: 0,0:01:09.36,0:01:10.90,Default,,0,0,0,,Монитор... Мониторларды ауыстыру.
Dialogue: 0,0:01:11.02,0:01:12.19,Default,,0,0,0,,Бейне ашық
Dialogue: 0,0:01:12.32,0:01:15.78,Default,,0,0,0,,(Ғалымдардың шуы)
Dialogue: 0,0:01:15.90,0:01:16.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:17.45,0:01:19.78,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:53.15,0:01:55.15,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:01:55.28,0:01:56.40,Default,,0,0,0,,Ноби-кун!
Dialogue: 0,0:01:57.03,0:01:59.07,Default,,0,0,0,,Аа... мүлде.
Dialogue: 0,0:01:59.57,0:01:59.82,Default,,0,0,0,,Яй Нобита
Dialogue: 0,0:01:59.82,0:02:01.37,Default,,0,0,0,,Яй Нобита
Dialogue: 0,0:01:59.82,0:02:01.37,Default,,0,0,0,,Түсінгенше неше рет айту керек?
Dialogue: 0,0:02:01.37,0:02:02.53,Default,,0,0,0,,Түсінгенше неше рет айту керек?
Dialogue: 0,0:02:03.03,0:02:06.50,Default,,0,0,0,,Сіз әрқашан осындай балл алғаныңызға ұялмайсыз ба?
Dialogue: 0,0:02:06.91,0:02:08.12,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:02:08.25,0:02:11.75,Default,,0,0,0,,Сіз оқудың қаншалықты маңызды екенін білмейсіз.
Dialogue: 0,0:02:12.04,0:02:12.84,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:02:12.84,0:02:13.88,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:02:12.84,0:02:13.88,Default,,0,0,0,,Арифметика дегеніміз не?
Dialogue: 0,0:02:13.88,0:02:14.71,Default,,0,0,0,,Арифметика дегеніміз не?
Dialogue: 0,0:02:14.84,0:02:15.76,Default,,0,0,0,,Қарапайым қосу және азайту амалдарын орындай алсаңыз...
Dialogue: 0,0:02:15.76,0:02:17.63,Default,,0,0,0,,Қарапайым қосу және азайту амалдарын орындай алсаңыз...
Dialogue: 0,0:02:15.76,0:02:17.63,Default,,0,0,0,,Мұнда кел, тезірек!
Dialogue: 0,0:02:17.76,0:02:19.09,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:02:17.76,0:02:19.09,Default,,0,0,0,,Тірі қалуға болатынын айтатындар бар...
Dialogue: 0,0:02:19.09,0:02:19.68,Default,,0,0,0,,Тірі қалуға болатынын айтатындар бар...
Dialogue: 0,0:02:19.80,0:02:21.26,Default,,0,0,0,,Бұл дұрыс емес, иә? Түсінесің бе, Нобикун?
Dialogue: 0,0:02:21.26,0:02:23.56,Default,,0,0,0,,Бұл дұрыс емес, иә? Түсінесің бе, Нобикун?
Dialogue: 0,0:02:21.26,0:02:23.56,Default,,0,0,0,,････
Dialogue: 0,0:02:24.06,0:02:26.56,Default,,0,0,0,,Күрделі есептерді шығару дегеніміз...
Dialogue: 0,0:02:26.89,0:02:28.81,Default,,0,0,0,,Өз алдына мақсат емес
Dialogue: 0,0:02:29.19,0:02:30.94,Default,,0,0,0,,Қазір емес, мен бірден барамын.
Dialogue: 0,0:02:30.94,0:02:32.19,Default,,0,0,0,,Қазір емес, мен бірден барамын.
Dialogue: 0,0:02:30.94,0:02:32.19,Default,,0,0,0,,Оны шешу арқылы—
Dialogue: 0,0:02:32.19,0:02:32.31,Default,,0,0,0,,Оны шешу арқылы—
Dialogue: 0,0:02:32.31,0:02:33.11,Default,,0,0,0,,Оны шешу арқылы—
Dialogue: 0,0:02:32.31,0:02:33.11,Default,,0,0,0,,Мен көшіп қойғанмын, сондықтан қазір істей алмаймын!
Dialogue: 0,0:02:33.11,0:02:33.23,Default,,0,0,0,,Мен көшіп кеттім, сондықтан қазір істей алмаймын!
Dialogue: 0,0:02:33.23,0:02:36.15,Default,,0,0,0,,Мен көшіп қойғанмын, сондықтан қазір істей алмаймын!
Dialogue: 0,0:02:33.23,0:02:36.15,Default,,0,0,0,,Сіз заттар туралы ойлауды үйренесіз.
Dialogue: 0,0:02:36.28,0:02:36.44,Default,,0,0,0,,Мен тез барамын, сондықтан бірінші бар!
Dialogue: 0,0:02:36.44,0:02:39.70,Default,,0,0,0,,Мен тез барамын, ендеше жүр!
Dialogue: 0,0:02:36.44,0:02:39.70,Default,,0,0,0,,Сондықтан сізге қазір жетіспейтін нәрсе...
Dialogue: 0,0:02:39.82,0:02:41.16,Default,,0,0,0,,Менің енді қолымнан келмейді... (Мұғалім) Ноби-кун!
Dialogue: 0,0:02:41.28,0:02:42.53,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:02:45.83,0:02:48.58,Default,,0,0,0,,Жарайды, жарайды! Уау...
Dialogue: 0,0:02:48.91,0:02:49.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:49.91,0:02:51.54,Default,,0,0,0,,Иә! (Бала) Соқ!
Dialogue: 0,0:02:51.67,0:02:52.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:52.67,0:02:54.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:55.34,0:02:56.17,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:02:56.30,0:02:57.84,Default,,0,0,0,,Әй, бейбақ!
Dialogue: 0,0:02:57.96,0:02:58.92,Default,,0,0,0,,Аа, ача~
Dialogue: 0,0:02:59.13,0:03:00.13,Default,,0,0,0,,Нобита!
Dialogue: 0,0:03:01.80,0:03:05.35,Default,,0,0,0,,Кеше көп айтсам да, сіз оны түк түсіндірмедіңіз!
Dialogue: 0,0:03:05.97,0:03:07.22,Default,,0,0,0,,Ал сізге адалдық танытып, қылыштарын қынабына салған рыцарьларға—
Dialogue: 0,0:03:07.35,0:03:08.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:08.35,0:03:11.64,Default,,0,0,0,,үшінн тазаламайынша кешкі асқа болмайды!
Dialogue: 0,0:03:25.33,0:03:28.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:29.62,0:03:33.42,Default,,0,0,0,,А... иә...
Dialogue: 0,0:03:36.50,0:03:37.75,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:03:40.34,0:03:43.09,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:03:43.93,0:03:45.68,Default,,0,0,0,,Хмф!
Dialogue: 0,0:03:46.10,0:03:48.47,Default,,0,0,0,,Уф! Хмф!
Dialogue: 0,0:03:48.68,0:03:50.64,Default,,0,0,0,,Хмм, аа, аа!
Dialogue: 0,0:03:59.65,0:04:02.28,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:04:02.40,0:04:08.41,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:04.09,0:05:10.10,Default,,0,0,0,,〜♪
Dialogue: 0,0:05:11.56,0:05:14.02,Default,,0,0,0,,Иә, біз қазір деректерді тексеріп жатырмыз.
Dialogue: 0,0:05:14.14,0:05:16.77,Default,,0,0,0,,Сол аспан денесінің жолы қандай?
Dialogue: 0,0:05:16.89,0:05:20.02,Default,,0,0,0,,Жерге әсер ету қаупі бар емес пе?
Dialogue: 0,0:05:21.15,0:05:22.82,Default,,0,0,0,,Мен сіздің алаңдаушылығыңызды түсінемін.
Dialogue: 0,0:05:22.94,0:05:25.95,Default,,0,0,0,,Дегенмен, біз қазір деректерді жинап жатырмыз.
Dialogue: 0,0:05:26.07,0:05:30.33,Default,,0,0,0,,Болашақ жағдайға қарап, байсалдылықпен бағалау керек деп ойлаймын.
Dialogue: 0,0:05:30.45,0:05:33.45,Default,,0,0,0,,Иә? Нобита-кун
Dialogue: 0,0:05:34.25,0:05:35.83,Default,,0,0,0,,Сіз тазалауды аяқтадыңыз ба?
Dialogue: 0,0:05:36.08,0:05:38.50,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:05:38.62,0:05:39.96,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:05:40.08,0:05:41.04,Default,,0,0,0,,Гувах, ауырып тұр.
Dialogue: 0,0:05:41.17,0:05:44.26,Default,,0,0,0,,Жоқ, жоқ, не, не, не болды...
Dialogue: 0,0:05:44.42,0:05:46.38,Default,,0,0,0,,Алдымен, тынышталыңыз!
Dialogue: 0,0:05:46.80,0:05:49.47,Default,,0,0,0,,Сиқырлы қыз Мами
Dialogue: 0,0:05:49.80,0:05:50.60,Default,,0,0,0,,Уау
Dialogue: 0,0:05:50.80,0:05:53.01,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:05:53.14,0:05:54.97,Default,,0,0,0,,Бұл Мами-чан~
Dialogue: 0,0:05:55.18,0:05:58.31,Default,,0,0,0,,Мами Мами Лурумпа Куруринпа!
Dialogue: 0,0:05:58.44,0:06:00.94,Default,,0,0,0,,Бөлмеңізді таза ұстаңыз!
Dialogue: 0,0:06:02.90,0:06:05.32,Default,,0,0,0,,О~ Хэхе...
Dialogue: 0,0:06:05.44,0:06:06.57,Default,,0,0,0,,Ықылық... аа...
Dialogue: 0,0:06:06.69,0:06:09.32,Default,,0,0,0,,Үй тапсырмасын да орындап көр, па!
Dialogue: 0,0:06:11.95,0:06:12.41,Default,,0,0,0,,Аха… нху…
Dialogue: 0,0:06:12.41,0:06:14.29,Default,,0,0,0,,Аха… Нху…
Dialogue: 0,0:06:12.41,0:06:14.29,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:06:14.49,0:06:17.12,Default,,0,0,0,,Жүр, ойынға барайық!
Dialogue: 0,0:06:18.58,0:06:20.58,Default,,0,0,0,,Бат-кун, бүгін де өтінемін.
Dialogue: 0,0:06:20.71,0:06:24.34,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:06:24.92,0:06:26.42,Default,,0,0,0,,Тонпоко!
Dialogue: 0,0:06:27.51,0:06:29.38,Default,,0,0,0,,Уау
Dialogue: 0,0:06:30.68,0:06:32.85,Default,,0,0,0,,Аха, кеттік!
Dialogue: 0,0:06:32.97,0:06:33.89,Default,,0,0,0,,(Тонпоконың айқайы)
Dialogue: 0,0:06:34.22,0:06:36.77,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:36.89,0:06:38.98,Default,,0,0,0,,Дораемон, иә?
Dialogue: 0,0:06:39.10,0:06:40.10,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:06:40.94,0:06:43.06,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:06:43.40,0:06:44.65,Default,,0,0,0,,Уф
Dialogue: 0,0:06:46.44,0:06:49.82,Default,,0,0,0,,Бұл сиқыр. Сізге тек сиқыр қажет!
Dialogue: 0,0:06:49.99,0:06:51.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.20,0:06:58.16,Default,,0,0,0,,Сиқыр жоқ
Dialogue: 0,0:06:58.66,0:06:59.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:00.00,0:07:03.21,Default,,0,0,0,,Ертеде жұмбақ оқиғаларды сиқыр деп атаған.
Dialogue: 0,0:07:03.33,0:07:06.80,Default,,0,0,0,,Мұның барлығын қазіргі ғылым түсіндіреді.
Dialogue: 0,0:07:06.92,0:07:09.42,Default,,0,0,0,,Сиқырлық – ырымшылдық
Dialogue: 0,0:07:09.55,0:07:11.18,Default,,0,0,0,,Бастапқы орынға оралыңыз!
Dialogue: 0,0:07:13.72,0:07:16.35,Default,,0,0,0,,Аха (Нобита) О~
Dialogue: 0,0:07:17.14,0:07:17.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.14,0:07:23.31,Default,,0,0,0,,Ырымдар сөнді, бұл ғылым әлемі.
Dialogue: 0,0:07:23.44,0:07:28.19,Default,,0,0,0,,Тексер, ғылымның орнына сиқыр дамығанын қалаймын.
Dialogue: 0,0:07:28.32,0:07:32.24,Default,,0,0,0,,Мен сиқырды қолдансам ыңғайлырақ болатынына сенімдімін.
Dialogue: 0,0:07:32.78,0:07:37.20,Default,,0,0,0,,Бір заклинание арқылы кез келген нәрсені жасауға болады. Эй, эй, эй.
Dialogue: 0,0:07:41.21,0:07:43.08,Default,,0,0,0,,Бірнеше ауыр естеліктер қайтадан оралды, иә?
Dialogue: 0,0:07:43.21,0:07:45.08,Default,,0,0,0,,А... жер сілкінісі ме?
Dialogue: 0,0:07:45.54,0:07:47.55,Default,,0,0,0,,Олай емес сияқты—
Dialogue: 0,0:07:48.21,0:07:50.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:51.13,0:07:53.51,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:07:55.64,0:07:58.64,Default,,0,0,0,,Ә? Ә?!
Dialogue: 0,0:07:59.18,0:08:00.89,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:08:02.27,0:08:04.27,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:08:05.90,0:08:08.94,Default,,0,0,0,,Жоқ... не? Бұл мен... бұл менмін
Dialogue: 0,0:08:09.11,0:08:10.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.82,0:08:12.40,Default,,0,0,0,,Аспаннан...
Dialogue: 0,0:08:14.95,0:08:16.32,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:08:16.78,0:08:19.79,Default,,0,0,0,,Ноби-чан? Сен не істеп жатырсың?
Dialogue: 0,0:08:19.99,0:08:22.25,Default,,0,0,0,,Уау (Нобита) Мама келе жатыр!
Dialogue: 0,0:08:22.87,0:08:25.21,Default,,0,0,0,,Менің ойымша, сіз бірдеңені сындырдыңыз.
Dialogue: 0,0:08:25.50,0:08:28.42,Default,,0,0,0,,Сынған! Бөлменің ішінде...
Dialogue: 0,0:08:28.84,0:08:31.30,Default,,0,0,0,,Сен не істедің?
Dialogue: 0,0:08:31.42,0:08:35.13,Default,,0,0,0,,Әй, мен оны тазалау үшін қиындық көрдім!
Dialogue: 0,0:08:37.35,0:08:38.80,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:08:39.10,0:08:39.97,Default,,0,0,0,,О...
Dialogue: 0,0:08:45.73,0:08:49.32,Default,,0,0,0,,Енді таза.
Dialogue: 0,0:08:49.48,0:08:50.11,Default,,0,0,0,,​​О?
Dialogue: 0,0:08:50.23,0:08:51.82,Default,,0,0,0,,(Дораэмонның күшті дауысы)
Dialogue: 0,0:08:51.94,0:08:54.49,Default,,0,0,0,,Иә? Эххехе~
Dialogue: 0,0:08:55.28,0:08:57.11,Default,,0,0,0,,Эхехе аа...
Dialogue: 0,0:08:57.24,0:08:58.28,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:08:58.41,0:09:00.20,Default,,0,0,0,,Эхехе (барлығы) Ах?
Dialogue: 0,0:09:00.87,0:09:03.58,Default,,0,0,0,,Қиын, Такеши мырза мен оның достары бос жерде...
Dialogue: 0,0:09:03.70,0:09:05.16,Default,,0,0,0,,Сіз Нобита-санды қорлайсыз!
Dialogue: 0,0:09:05.54,0:09:06.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.46,0:09:08.92,Default,,0,0,0,,Иә, мен? иә? иә? иә?
Dialogue: 0,0:09:09.21,0:09:11.05,Default,,0,0,0,,Конняро... (Сунео) Ахаха...
Dialogue: 0,0:09:11.17,0:09:13.46,Default,,0,0,0,,Аға, біздің жеңіліп қалғанымызға сен кінәлісің.
Dialogue: 0,0:09:13.59,0:09:14.84,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:09:14.97,0:09:16.76,Default,,0,0,0,,Бұл менің тас мүсінім.
Dialogue: 0,0:09:16.88,0:09:17.68,Default,,0,0,0,,Канчо Канчо
Dialogue: 0,0:09:17.80,0:09:19.64,Default,,0,0,0,,Нобита (Сунео) иә?
Dialogue: 0,0:09:19.76,0:09:22.64,Default,,0,0,0,,Эй, Нобита, бұл не деген ақымақ мүсін?
Dialogue: 0,0:09:22.77,0:09:25.64,Default,,0,0,0,,Мен мұндай жерде мұндай нәрсені қалдырғым келмейді.
Dialogue: 0,0:09:25.77,0:09:28.27,Default,,0,0,0,,Ахаха Нанчитте (Сунео) дәмді Джиан
Dialogue: 0,0:09:28.40,0:09:30.36,Default,,0,0,0,,Ол тас болып құлады...
Dialogue: 0,0:09:33.53,0:09:36.86,Default,,0,0,0,,Үйге апарсаң, қоқыс көп деп ашуланасың.
Dialogue: 0,0:09:36.99,0:09:40.03,Default,,0,0,0,,Қоқыс деген не? Бұл менің тас мүсінім.
Dialogue: 0,0:09:40.16,0:09:43.70,Default,,0,0,0,,Кім бұндай әрекет жасады?
Dialogue: 0,0:09:44.50,0:09:46.00,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:09:46.12,0:09:46.83,Default,,0,0,0,,Я...
Dialogue: 0,0:09:46.96,0:09:49.08,Default,,0,0,0,,Өте жақсы орындалған
Dialogue: 0,0:09:49.21,0:09:51.00,Default,,0,0,0,,Тірі сияқты
Dialogue: 0,0:09:53.55,0:09:58.47,Default,,0,0,0,,Қорқынышты бірдеңені көргенде, тоңып қалғандай болдым...
Dialogue: 0,0:09:59.05,0:10:03.06,Default,,0,0,0,,Сиқырдың әсерінен тасқа айналған біз шығармыз...
Dialogue: 0,0:10:03.18,0:10:04.47,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:10:04.60,0:10:07.39,Default,,0,0,0,,Сонда біз мұнда неміз?
Dialogue: 0,0:10:07.52,0:10:08.69,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:10:08.81,0:10:11.40,Default,,0,0,0,,Мен саған сиқыр жоқ дедім.
Dialogue: 0,0:10:11.52,0:10:12.27,Default,,0,0,0,,Бірақ, бәрібір, аспаннан түсу біртүрлі.
Dialogue: 0,0:10:12.27,0:10:14.90,Default,,0,0,0,,Бірақ, аспаннан құлау біртүрлі, біртүрлі.
Dialogue: 0,0:10:12.27,0:10:14.90,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:10:15.19,0:10:17.61,Default,,0,0,0,,(Тас мүсіннің айқайы)
Dialogue: 0,0:10:20.95,0:10:23.45,Default,,0,0,0,,Уау... Дораемон!
Dialogue: 0,0:10:23.58,0:10:24.79,Default,,0,0,0,,Асығыңыз, асығыңыз! не!
Dialogue: 0,0:10:24.91,0:10:27.00,Default,,0,0,0,,Мүсін терлеп кетті! ?
Dialogue: 0,0:10:27.41,0:10:28.12,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,0:10:29.92,0:10:32.34,Default,,0,0,0,,Хмм... мм? мм... аа
Dialogue: 0,0:10:33.04,0:10:37.05,Default,,0,0,0,,Ойлап қарасам, бұрын теледидардан тайфунның жақындап қалғанын естідім...
Dialogue: 0,0:10:37.30,0:10:40.05,Default,,0,0,0,,Тер емес, жаңбыр жауды.
Dialogue: 0,0:10:40.18,0:10:41.97,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:10:42.80,0:10:44.76,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,0:10:48.23,0:10:49.10,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:49.23,0:10:50.98,Default,,0,0,0,,Сіз суық тиіп қаласыз. Басыңды сүрт.
Dialogue: 0,0:10:51.10,0:10:52.06,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:10:52.36,0:10:55.02,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:03.62,0:11:07.70,Default,,0,0,0,,Бұл мен анық еститін біртүрлі дауыс сияқты болды.
Dialogue: 0,0:11:07.83,0:11:09.87,Default,,0,0,0,,Әкем ұйықтап жатқанда осыны айтады емес пе?
Dialogue: 0,0:11:10.00,0:11:11.25,Default,,0,0,0,,Ал егер…
Dialogue: 0,0:11:11.37,0:11:13.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:13.75,0:11:16.09,Default,,0,0,0,,Ууу... һи
Dialogue: 0,0:11:19.67,0:11:24.72,Default,,0,0,0,,Не? Артқы есік ашық болды.
Dialogue: 0,0:11:24.85,0:11:27.43,Default,,0,0,0,,Иә, иә, не?
Dialogue: 0,0:11:27.56,0:11:30.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:31.19,0:11:33.23,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:11:33.77,0:11:36.65,Default,,0,0,0,,Бұл кім? Біреу бар ма...
Dialogue: 0,0:11:38.94,0:11:42.95,Default,,0,0,0,,(Нобитаның үрейлі дауысы)
Dialogue: 0,0:11:44.07,0:11:46.16,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:46.41,0:11:48.66,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:11:49.04,0:11:50.75,Default,,0,0,0,,(Анам мен әкемнің айқайы)
Dialogue: 0,0:11:50.87,0:11:53.17,Default,,0,0,0,,Не? не? не? Не?
Dialogue: 0,0:11:53.79,0:11:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.09,0:11:57.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.42,0:12:00.80,Default,,0,0,0,,Ал, Ноби-чан, түннің бұл сағатында не істеп жүрсің?
Dialogue: 0,0:12:00.92,0:12:02.63,Default,,0,0,0,,Мама Мама
Dialogue: 0,0:12:02.80,0:12:04.09,Default,,0,0,0,,Мұнда
Dialogue: 0,0:12:07.18,0:12:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.85,0:12:10.43,Default,,0,0,0,,Не? бұл қоқыс
Dialogue: 0,0:12:10.56,0:12:11.85,Default,,0,0,0,,Ол рұқсатсыз кірді.
Dialogue: 0,0:12:11.98,0:12:13.69,Default,,0,0,0,,Ол бақшада қалды.
Dialogue: 0,0:12:13.94,0:12:17.57,Default,,0,0,0,,Анау ақымақ тас өздігінен қозғала алмайды.
Dialogue: 0,0:12:17.69,0:12:19.48,Default,,0,0,0,,Түн ортасында осылай еркелік ойнау
Dialogue: 0,0:12:19.90,0:12:23.32,Default,,0,0,0,,Ерте тазалаңыз Ерте жатыңыз
Dialogue: 0,0:12:24.24,0:12:26.87,Default,,0,0,0,,Хм... Мен саған оны тазала деп айттым.
Dialogue: 0,0:12:28.16,0:12:29.83,Default,,0,0,0,,Сыртта қатты жаңбыр жауып тұр.
Dialogue: 0,0:12:30.37,0:12:33.91,Default,,0,0,0,,Әзірше осында қоюдан басқа амалым жоқ.
Dialogue: 0,0:12:34.04,0:12:37.13,Default,,0,0,0,,Эй, бұл бұрынғыдан басқа пішін...
Dialogue: 0,0:12:37.25,0:12:38.04,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,0:12:38.17,0:12:39.21,Default,,0,0,0,,Ерте ұйықта (Нобита/Дораэмон) Ахх...
Dialogue: 0,0:12:39.34,0:12:41.63,Default,,0,0,0,,Иә хмм… иә иә…
Dialogue: 0,0:12:42.01,0:12:43.05,Default,,0,0,0,,Хмм, бұл ауыр...
Dialogue: 0,0:12:44.18,0:12:45.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:50.68,0:12:51.97,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:12:52.31,0:12:53.52,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:12:53.64,0:12:55.81,Default,,0,0,0,,Бұл мүсін біртүрлі екен.
Dialogue: 0,0:12:55.94,0:12:58.40,Default,,0,0,0,,Бұл біртүрлі, бірақ мен оны ертең қараймын.
Dialogue: 0,0:12:58.52,0:13:00.19,Default,,0,0,0,,Мен қазірдің өзінде ұйықтап жатырмын
Dialogue: 0,0:13:00.32,0:13:03.11,Default,,0,0,0,,Мен уайымдап, ұйықтай алмаймын.
Dialogue: 0,0:13:03.24,0:13:06.95,Default,,0,0,0,,Егер мен қызық нәрсе туралы ойласам, ұйықтай аламын.
Dialogue: 0,0:13:07.16,0:13:10.20,Default,,0,0,0,,Ха...қызық...
Dialogue: 0,0:13:10.33,0:13:14.37,Default,,0,0,0,,Әй, егер мен сиқырды қолдансам...
Dialogue: 0,0:13:16.29,0:13:17.92,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:13:18.17,0:13:19.79,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:13:19.92,0:13:23.96,Default,,0,0,0,,Мен сиқырды кішкене тапқырлықпен шынымен қолдана алатындай сезінемін.
Dialogue: 0,0:13:24.09,0:13:27.80,Default,,0,0,0,,Сен бас тартатын адамсың. Ешқандай сиқыр жоқ!
Dialogue: 0,0:13:27.93,0:13:29.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.93,0:13:32.31,Default,,0,0,0,,Хмм... Бұл рас.
Dialogue: 0,0:13:32.43,0:13:35.73,Default,,0,0,0,,Менде дәл қазір тамаша идея болғалы тұр.
Dialogue: 0,0:13:35.85,0:13:37.60,Default,,0,0,0,,Мен бас тарттым.
Dialogue: 0,0:13:37.85,0:13:41.23,Default,,0,0,0,,Әй, бұл не екен, шыдамым таусылып барады.
Dialogue: 0,0:13:42.07,0:13:45.78,Default,,0,0,0,,Иә, түсіндім. Қайталануына жол берме.
Dialogue: 0,0:13:46.20,0:13:47.49,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:13:49.32,0:13:51.03,Default,,0,0,0,,Ауырды... (Нобита) Не? не болды?
Dialogue: 0,0:13:51.16,0:13:53.24,Default,,0,0,0,,Менің ішім кенеттен...
Dialogue: 0,0:13:53.37,0:13:54.16,Default,,0,0,0,,Асқазан?
Dialogue: 0,0:13:54.45,0:13:55.62,Default,,0,0,0,,Уа (асқазанның түсіп кеткен дыбысы)
Dialogue: 0,0:13:55.75,0:13:59.54,Default,,0,0,0,,Мен... Төтенше жағдай орын алды... Ой...
Dialogue: 0,0:13:59.67,0:14:02.42,Default,,0,0,0,,22 ғасырға оралыңыз.
Dialogue: 0,0:14:02.88,0:14:05.59,Default,,0,0,0,,Амансың ба? Жарайды... менде жақсы...
Dialogue: 0,0:14:05.76,0:14:08.05,Default,,0,0,0,,Уф, мен бірден қайтамын...
Dialogue: 0,0:14:08.18,0:14:09.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.43,0:14:13.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.18,0:14:15.81,Default,,0,0,0,,Әй, бұрынғы тас мүсін...
Dialogue: 0,0:14:15.93,0:14:17.23,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:14:17.35,0:14:21.27,Default,,0,0,0,,Мен күндіз 30 дораяки күтпедім...
Dialogue: 0,0:14:23.98,0:14:24.94,Default,,0,0,0,,Уау
Dialogue: 0,0:14:25.11,0:14:26.44,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:14:26.57,0:14:27.86,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:14:27.99,0:14:29.24,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:14:29.36,0:14:32.87,Default,,0,0,0,,Менің асқазаным... менің асқазаным... менің асқазаным...
Dialogue: 0,0:14:32.99,0:14:34.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:35.83,0:14:37.33,Default,,0,0,0,,Бұл ауырмайды
Dialogue: 0,0:14:37.50,0:14:39.08,Default,,0,0,0,,Зуко
Dialogue: 0,0:14:40.42,0:14:44.04,Default,,0,0,0,,А... Амансың ба?
Dialogue: 0,0:14:44.17,0:14:45.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.26,0:14:48.88,Default,,0,0,0,,Бүгін біртүрлі нәрселерге толы.
Dialogue: 0,0:14:48.97,0:14:51.30,Default,,0,0,0,,Әй, жіберші, жіберші!
Dialogue: 0,0:14:51.43,0:14:54.76,Default,,0,0,0,,Дәл осылай болады, өйткені сіз жүйелі түрде тексеріс жүргізбесеңіз!
Dialogue: 0,0:14:54.89,0:14:57.22,Default,,0,0,0,,Тыныш кіріңіз!
Dialogue: 0,0:14:57.35,0:14:58.52,Default,,0,0,0,,Мен ауруханаларды жек көремін!
Dialogue: 0,0:15:00.14,0:15:02.73,Default,,0,0,0,,Жастық, қалқыма
Dialogue: 0,0:15:05.90,0:15:07.69,Default,,0,0,0,,Уф, егер сіз оны салсаңыз ...
Dialogue: 0,0:15:07.82,0:15:09.74,Default,,0,0,0,,Үйге баратын болсаңыз...
Dialogue: 0,0:15:10.70,0:15:11.82,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:11.95,0:15:16.49,Default,,0,0,0,,Егер мен сиқырды қолдансам, ше...
Dialogue: 0,0:15:16.66,0:15:18.95,Default,,0,0,0,,Иә? Ал егер?
Dialogue: 0,0:15:19.08,0:15:20.66,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:15:21.67,0:15:23.13,Default,,0,0,0,,Бітіру кеші жақындап қалды ғой?
Dialogue: 0,0:15:23.25,0:15:25.09,Default,,0,0,0,,Сәлем! Күте тұрыңыз!
Dialogue: 0,0:15:25.50,0:15:27.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:27.13,0:15:29.34,Default,,0,0,0,,Оряря... Әй, аға!
Dialogue: 0,0:15:29.97,0:15:32.72,Default,,0,0,0,,Мүлдем! қазірдің өзінде!
Dialogue: 0,0:15:32.84,0:15:35.14,Default,,0,0,0,,Ол енді ауырмайды, бұл бәрі жақсы дегенді білдірмейді.
Dialogue: 0,0:15:35.14,0:15:35.97,Default,,0,0,0,,Ол енді ауырмайды, бұл бәрі жақсы дегенді білдірмейді.
Dialogue: 0,0:15:35.14,0:15:35.97,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:15:35.97,0:15:36.10,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:15:36.10,0:15:37.68,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:15:36.10,0:15:37.68,Default,,0,0,0,,Біз Дораэмонның ауруханаларды ұнатпайтыны туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:15:37.68,0:15:38.14,Default,,0,0,0,,Біз Дораэмонның ауруханаларды ұнатпайтындығы туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:15:38.14,0:15:39.85,Default,,0,0,0,,Біз Дораэмонның ауруханаларды ұнатпайтындығы туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:15:38.14,0:15:39.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:40.94,0:15:41.60,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:15:41.73,0:15:43.69,Default,,0,0,0,,Уау~ Ой!
Dialogue: 0,0:15:43.81,0:15:46.40,Default,,0,0,0,,Дораемон! Асқазаныңыз қалай? Сенімен бәрі жақсы ма?
Dialogue: 0,0:15:46.52,0:15:48.94,Default,,0,0,0,,Иә? О, жоқ хехехе...
Dialogue: 0,0:15:49.07,0:15:53.16,Default,,0,0,0,,Аа, ештеңе болған жоқ, мен көп жедім. Ахаха.
Dialogue: 0,0:15:53.28,0:15:55.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:56.70,0:16:01.50,Default,,0,0,0,,Дұрыс, мен сіз жоғарыда айтқан идеяны ойлап таптым!
Dialogue: 0,0:16:01.62,0:16:02.92,Default,,0,0,0,,Не?
Dialogue: 0,0:16:03.79,0:16:05.50,Default,,0,0,0,,Моши қорабы
Dialogue: 0,0:16:05.63,0:16:07.96,Default,,0,0,0,,Телефон соқсаң, қиял әлемі...
Dialogue: 0,0:16:08.09,0:16:09.88,Default,,0,0,0,,Шынайы болу
Dialogue: 0,0:16:10.21,0:16:14.18,Default,,0,0,0,,Әй, бұл қол сонда болды.
Dialogue: 0,0:16:14.80,0:16:19.39,Default,,0,0,0,,Ей, сәл ғана сиқырлы әлемге айналдырайық.
Dialogue: 0,0:16:19.52,0:16:22.35,Default,,0,0,0,,Хмм, қызықты естіледі.
Dialogue: 0,0:16:22.48,0:16:27.31,Default,,0,0,0,,Нобита-кун, сен тек осындай кезде миыңды пайдаланасың.
Dialogue: 0,0:16:27.44,0:16:30.36,Default,,0,0,0,,Моши қорабы!
Dialogue: 0,0:16:31.40,0:16:32.32,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:16:32.44,0:16:34.36,Default,,0,0,0,,Сиқырдан ләззат алғаннан кейін, бірден оған қайта оралыңыз.
Dialogue: 0,0:16:34.49,0:16:36.74,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:16:45.58,0:16:46.42,Default,,0,0,0,,Ал егер—
Dialogue: 0,0:16:48.63,0:16:50.05,Default,,0,0,0,,Сиқыр әлеміне
Dialogue: 0,0:16:54.05,0:16:55.47,Default,,0,0,0,,Егер
Dialogue: 0,0:16:59.43,0:17:03.43,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:17:05.77,0:17:07.73,Default,,0,0,0,,Енді сиқырды қолдануға болады.
Dialogue: 0,0:17:07.86,0:17:08.65,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:17:08.77,0:17:11.32,Default,,0,0,0,,Ғұн Ұшатын жастық, секіру
Dialogue: 0,0:17:11.44,0:17:13.36,Default,,0,0,0,,Мами Мами Лурумпа Куруринпа!
Dialogue: 0,0:17:13.49,0:17:16.49,Default,,0,0,0,,Дораяки, кел, Куруринпа!
Dialogue: 0,0:17:17.66,0:17:19.12,Default,,0,0,0,,А…?
Dialogue: 0,0:17:19.32,0:17:21.12,Default,,0,0,0,,Мүмкін заклинание басқаша шығар?
Dialogue: 0,0:17:21.24,0:17:23.20,Default,,0,0,0,,Нобиноби Лурунпа Куруринпа!
Dialogue: 0,0:17:23.33,0:17:26.58,Default,,0,0,0,,Абракадабра Кел, дораяки!
Dialogue: 0,0:17:27.12,0:17:27.37,Default,,0,0,0,,Забутон ұшады! Забутон ұшады!
Dialogue: 0,0:17:27.37,0:17:29.42,Default,,0,0,0,,Забутон ұшады! Забутон ұшады!
Dialogue: 0,0:17:27.37,0:17:29.42,Default,,0,0,0,,Құдай, маған дораяки бер!
Dialogue: 0,0:17:29.54,0:17:29.63,Default,,0,0,0,,Жастықшаны ұшыр! Жастықты ұшыр!
Dialogue: 0,0:17:29.63,0:17:32.30,Default,,0,0,0,,Жастықшаны ұшыр! Жастықты ұшыр!
Dialogue: 0,0:17:29.63,0:17:32.30,Default,,0,0,0,,Дораяки Камухия Камухия!
Dialogue: 0,0:17:32.42,0:17:33.88,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:34.01,0:17:36.88,Default,,0,0,0,,Бір қызығы, менің орнымнан қозғалмайды.
Dialogue: 0,0:17:37.01,0:17:39.76,Default,,0,0,0,,Құралдарыңыз әрқашан жарамсыз.
Dialogue: 0,0:17:39.89,0:17:42.68,Default,,0,0,0,,Сіз ең бірінші сиқыр жоқ дедіңіз.
Dialogue: 0,0:17:42.81,0:17:45.98,Default,,0,0,0,,(төбелес дауыстары)
Dialogue: 0,0:17:46.10,0:17:47.77,Default,,0,0,0,,Ракон ит бол! Жауын құртына айнал!
Dialogue: 0,0:17:47.90,0:17:49.98,Default,,0,0,0,,Шынжыр табанды бол! Оркестр бол!
Dialogue: 0,0:17:50.11,0:17:52.27,Default,,0,0,0,,Шошқа бол! Дафния бол!
Dialogue: 0,0:17:52.40,0:17:54.82,Default,,0,0,0,,Тас бол!
Dialogue: 0,0:17:59.78,0:18:01.28,Default,,0,0,0,,(Екі адам күрсінді)
Dialogue: 0,0:18:01.41,0:18:03.91,Default,,0,0,0,,Бұл күлкілі. Мен қазір ұйықтаймын.
Dialogue: 0,0:18:07.46,0:18:10.54,Default,,0,0,0,,Бүгін біртүрлі нәрселерге толы.
Dialogue: 0,0:18:30.15,0:18:32.15,Default,,0,0,0,,Құрметті демаон
Dialogue: 0,0:18:34.36,0:18:37.28,Default,,0,0,0,,Сіз кімсіз? сол адамдар
Dialogue: 0,0:18:37.40,0:18:40.20,Default,,0,0,0,,Осы жын патшаны жеңу үшін мына жігіттер—
Dialogue: 0,0:18:40.32,0:18:43.45,Default,,0,0,0,,Жындар әлеміне келген адамдар
Dialogue: 0,0:18:43.83,0:18:46.16,Default,,0,0,0,,Әлгі ренжітетін жерлестер.
Dialogue: 0,0:18:46.29,0:18:48.37,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:48.50,0:18:52.71,Default,,0,0,0,,Медуза, мен саған күшіңді көрсетейін.
Dialogue: 0,0:18:52.84,0:18:54.38,Default,,0,0,0,,Хаха
Dialogue: 0,0:19:11.65,0:19:14.61,Default,,0,0,0,,Жаңбыр басылған сияқты.
Dialogue: 0,0:19:14.73,0:19:17.73,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:19:22.28,0:19:23.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:25.83,0:19:28.75,Default,,0,0,0,,Уф, аздап... Додо...
Dialogue: 0,0:19:28.87,0:19:31.46,Default,,0,0,0,,Ноно... Нобита... Нобита-кун... Ахатата...
Dialogue: 0,0:19:31.75,0:19:35.38,Default,,0,0,0,,Нобита-кун, оян, тұр, тез, тез...
Dialogue: 0,0:19:35.50,0:19:37.71,Default,,0,0,0,,Хмм... бұл не...
Dialogue: 0,0:19:37.84,0:19:41.22,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:19:41.38,0:19:43.14,Default,,0,0,0,,Масато
Dialogue: 0,0:19:43.47,0:19:46.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:49.14,0:19:50.64,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:19:52.98,0:19:54.15,Default,,0,0,0,,Ахаха (Ер) Уау!
Dialogue: 0,0:19:54.27,0:19:55.61,Default,,0,0,0,,Оу!
Dialogue: 0,0:19:55.77,0:19:57.27,Default,,0,0,0,,Кет!
Dialogue: 0,0:20:00.82,0:20:01.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:04.20,0:20:05.70,Default,,0,0,0,,Ахаха
Dialogue: 0,0:20:06.62,0:20:08.83,Default,,0,0,0,,Бұл сиқырлы әлем!
Dialogue: 0,0:20:11.62,0:20:13.87,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:14.17,0:20:15.79,Default,,0,0,0,,Уау~
Dialogue: 0,0:20:16.17,0:20:17.46,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:20:17.71,0:20:20.17,Default,,0,0,0,,Тез тамақтан, кешігіп қаласың.
Dialogue: 0,0:20:21.67,0:20:23.18,Default,,0,0,0,,Мен кешігуге болмайды
Dialogue: 0,0:20:23.30,0:20:26.01,Default,,0,0,0,,Ұшатын кілемге секіру
Dialogue: 0,0:20:26.14,0:20:28.06,Default,,0,0,0,,Не, сен жартылай ұйықтап жатырсың ба?
Dialogue: 0,0:20:28.18,0:20:30.47,Default,,0,0,0,,Бізде ұшатын кілем жоқ, солай ма?
Dialogue: 0,0:20:30.60,0:20:32.14,Default,,0,0,0,,Иә? (Нобита) Не? Жоқ?
Dialogue: 0,0:20:32.39,0:20:34.56,Default,,0,0,0,,Маған онша қымбат нәрсе керек емес.
Dialogue: 0,0:20:34.69,0:20:37.94,Default,,0,0,0,,Мен Нобита жақын арада сыпырғыш мінеді деп үміттенемін.
Dialogue: 0,0:20:38.69,0:20:42.03,Default,,0,0,0,,Ноби-кун, сен осындай нәрсені істей алмайсың ба?
Dialogue: 0,0:20:42.49,0:20:45.78,Default,,0,0,0,,Заттың көтерілуі магияның негізі емес пе?
Dialogue: 0,0:20:45.91,0:20:49.20,Default,,0,0,0,,Келіңіздер, көріңіздер.
Dialogue: 0,0:20:49.33,0:20:53.58,Default,,0,0,0,,Көңіліңді тыныштандырып, Чинкарахой әнін айт
Dialogue: 0,0:20:53.71,0:20:55.00,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:20:56.79,0:20:57.63,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:20:57.75,0:21:00.25,Default,,0,0,0,,Чинкарахой! Чинкарахой! Чинкарахой!
Dialogue: 0,0:21:00.38,0:21:01.63,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:21:01.76,0:21:03.42,Default,,0,0,0,,Мұғалім, мен орындаймын.
Dialogue: 0,0:21:03.55,0:21:04.42,Default,,0,0,0,,Иә
Dialogue: 0,0:21:04.84,0:21:06.05,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:06.18,0:21:08.64,Default,,0,0,0,,Чинкара... Хуй!
Dialogue: 0,0:21:08.80,0:21:11.93,Default,,0,0,0,,Уа, у-у-у... (Балалардың күлкісі)
Dialogue: 0,0:21:12.06,0:21:14.18,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:21:14.35,0:21:15.60,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:21:15.85,0:21:17.06,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:21:18.61,0:21:21.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:21.28,0:21:21.94,Default,,0,0,0,,Жұмысқа бара жатқан кеңсе қызметкерлерінің «жасырын фотосуретін» түсіріп жүрмін.
Dialogue: 0,0:21:22.48,0:21:23.40,Default,,0,0,0,,Жұмысқа бара жатқан кеңсе қызметкерлерінің «жасырын фотосуретін» түсіріп жүрмін.
Dialogue: 0,0:21:23.53,0:21:24.36,Default,,0,0,0,,Жұмысқа бара жатқан кеңсе қызметкерлерінің «жасырын фотосуретін» түсіріп жүрмін.
Dialogue: 0,0:21:24.78,0:21:26.57,Default,,0,0,0,,Хой! Уф...
Dialogue: 0,0:21:26.99,0:21:28.03,Default,,0,0,0,,Жұмысқа бара жатқан кеңсе қызметкерлерінің «жасырын фотосуретін» түсіріп жүрмін.
Dialogue: 0,0:21:28.53,0:21:29.99,Default,,0,0,0,,Хой! (Бала) А...
Dialogue: 0,0:21:30.28,0:21:33.00,Default,,0,0,0,,Нобита Ұша алмайтын адамға пайда жоқ!
Dialogue: 0,0:21:33.12,0:21:33.95,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:21:35.41,0:21:38.75,Default,,0,0,0,,Хиро-чан, тезірек, Мик-кун, күт!
Dialogue: 0,0:21:38.88,0:21:39.88,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:40.00,0:21:41.38,Default,,0,0,0,,Нобита!
Dialogue: 0,0:21:41.71,0:21:45.67,Default,,0,0,0,,Әңгімені мұғалімнің аузынан естігенде бетім отқа оранғандай болды.
Dialogue: 0,0:21:45.80,0:21:48.80,Default,,0,0,0,,Объектіні көтеру - бұл негіз, солай ма?
Dialogue: 0,0:21:48.93,0:21:52.39,Default,,0,0,0,,Сиқырды онша қолдана алмайтын сияқты, ол қай мектепке барады...
Dialogue: 0,0:21:53.39,0:21:54.73,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:21:54.85,0:21:58.31,Default,,0,0,0,,Ой... Мия!
Dialogue: 0,0:21:58.60,0:22:01.73,Default,,0,0,0,,Әй, бұл бастапқы дүниеден еш айырмашылығы жоқ!
Dialogue: 0,0:22:01.86,0:22:03.73,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:22:03.86,0:22:05.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:05.82,0:22:08.99,Default,,0,0,0,,Сәлем, сиқыр оқумен бірдей.
Dialogue: 0,0:22:09.11,0:22:12.78,Default,,0,0,0,,Бір күш жұмсамайынша қолыңнан келмейтін сияқты.
Dialogue: 0,0:22:12.91,0:22:14.95,Default,,0,0,0,,Сиқырды пайдалана алмау себебіміз...
Dialogue: 0,0:22:15.45,0:22:18.46,Default,,0,0,0,,Себебі мен оны ешқашан үйренбегенмін.
Dialogue: 0,0:22:19.75,0:22:23.30,Default,,0,0,0,,Әй, бастапқы әлемге оралайық.
Dialogue: 0,0:22:23.42,0:22:24.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:28.09,0:22:31.39,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:22:32.30,0:22:34.60,Default,,0,0,0,,Эй, Нобита, барайық Хокинг.
Dialogue: 0,0:22:34.72,0:22:35.60,Default,,0,0,0,,Кеттік
Dialogue: 0,0:22:35.72,0:22:37.93,Default,,0,0,0,,Ах... (Нобита) Хокинг?
Dialogue: 0,0:22:38.06,0:22:40.81,Default,,0,0,0,,Менің ойымша, бұл велоспорттың сыпырғыш нұсқасы.
Dialogue: 0,0:22:41.15,0:22:45.36,Default,,0,0,0,,Әкем маған Германияда жасалған соңғы үлгіні сатып алды.
Dialogue: 0,0:22:45.48,0:22:48.70,Default,,0,0,0,,Бұл қалай? Сырты әдемі ғана емес,...
Dialogue: 0,0:22:48.82,0:22:51.16,Default,,0,0,0,,Бұл жабысқақ текстура
Dialogue: 0,0:22:51.28,0:22:54.16,Default,,0,0,0,,Төмен итергіш ершікті иілудің алдын алу үшін
Dialogue: 0,0:22:54.28,0:22:58.04,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен сені бір-ақ рет апара аламын.
Dialogue: 0,0:22:58.21,0:22:59.92,Default,,0,0,0,,Жоқ, Суне Чан
Dialogue: 0,0:23:00.04,0:23:02.58,Default,,0,0,0,,Ноби-чан сыпырғыш міне алмайды, хохо
Dialogue: 0,0:23:02.71,0:23:04.92,Default,,0,0,0,,О, ханым, дұрыс.
Dialogue: 0,0:23:05.05,0:23:07.17,Default,,0,0,0,,Мен сізді шақыру арқылы қателік жасадым.
Dialogue: 0,0:23:07.30,0:23:09.30,Default,,0,0,0,,Әй, жүр, кеттік.
Dialogue: 0,0:23:09.42,0:23:10.47,Default,,0,0,0,,(Эндевурдың дем алған дыбысы)
Dialogue: 0,0:23:10.84,0:23:13.80,Default,,0,0,0,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:23:13.97,0:23:15.85,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:23:15.97,0:23:20.77,Default,,0,0,0,,Дәл осы екеуінің істегені кез келген әлемде бірдей.
Dialogue: 0,0:23:20.89,0:23:23.86,Default,,0,0,0,,Енді, бастапқы әлемімізге оралайық.
Dialogue: 0,0:23:23.98,0:23:25.44,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:23:26.11,0:23:27.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:28.90,0:23:31.66,Default,,0,0,0,,Біз оны сиқырлы әлемге айналдырдық.
Dialogue: 0,0:23:31.78,0:23:35.33,Default,,0,0,0,,Кем дегенде бір қарапайым сиқыр жақсы.
Dialogue: 0,0:23:35.45,0:23:38.04,Default,,0,0,0,,Мен оны пайдалана алғым келеді.
Dialogue: 0,0:23:38.95,0:23:42.50,Default,,0,0,0,,Иә, Нобитаның ептілігі бар.
Dialogue: 0,0:23:44.79,0:23:46.09,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:23:46.21,0:23:48.96,Default,,0,0,0,,Жоқ, жоқ, жоқ, онша күш қолданба.
Dialogue: 0,0:23:49.09,0:23:50.97,Default,,0,0,0,,Тағы біраз тынышталыңыз
Dialogue: 0,0:23:51.17,0:23:52.68,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:23:53.84,0:23:56.72,Default,,0,0,0,,Берілме Енді, шаң көтерілді
Dialogue: 0,0:23:56.85,0:23:57.89,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:23:58.01,0:24:00.27,Default,,0,0,0,,Ой, мен әзілдеп тұрмын.
Dialogue: 0,0:24:00.39,0:24:01.64,Default,,0,0,0,,Дора-чан хехехе...
Dialogue: 0,0:24:02.02,0:24:04.35,Default,,0,0,0,,Боқ... Чинкарахой!
Dialogue: 0,0:24:05.19,0:24:07.82,Default,,0,0,0,,Чинкарахой! Чинкара хой!
Dialogue: 0,0:24:08.65,0:24:10.28,Default,,0,0,0,,Ол қозғалмайды.
Dialogue: 0,0:24:10.40,0:24:13.66,Default,,0,0,0,,Асықпа, ойыңды көбірек босату керек.
Dialogue: 0,0:24:13.78,0:24:16.37,Default,,0,0,0,,Терең тыныс алыңыз
Dialogue: 0,0:24:16.49,0:24:20.54,Default,,0,0,0,,Ал тек қуыршақты жүзу туралы ойланыңыз
Dialogue: 0,0:24:20.66,0:24:23.46,Default,,0,0,0,,Қалқымалы қалқымалы чинкарахой!
Dialogue: 0,0:24:24.96,0:24:27.17,Default,,0,0,0,,Тағы бір рет... Ахх
Dialogue: 0,0:24:27.46,0:24:29.38,Default,,0,0,0,,Ах (Нобита) Егер ол қалқып кетсе, хой!
Dialogue: 0,0:24:31.72,0:24:32.38,Default,,0,0,0,,Ах
Dialogue: 0,0:24:33.55,0:24:34.38,Default,,0,0,0,,Аххх (Нобита) Көрдің бе?
Dialogue: 0,0:24:34.51,0:24:37.30,Default,,0,0,0,,Юбка сәл қозғалды! Бұл солай
Dialogue: 0,0:24:37.43,0:24:39.10,Default,,0,0,0,,Егер ол жарық болса, сіз жасай аласыз.
Dialogue: 0,0:24:39.22,0:24:40.27,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:24:40.60,0:24:42.56,Default,,0,0,0,,Чинкара... Хуй!
Dialogue: 0,0:24:46.02,0:24:47.65,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:24:48.82,0:24:50.07,Default,,0,0,0,,Уау! Кя!
Dialogue: 0,0:24:50.19,0:24:54.45,Default,,0,0,0,,Чинкарахой! Чинкарахой! Егер сіз чинкарахой сияқты сезінсеңіз, онда хой!
Dialogue: 0,0:24:55.07,0:24:56.57,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:24:56.70,0:24:58.95,Default,,0,0,0,,Ооо ха ха...
Dialogue: 0,0:24:59.08,0:25:01.54,Default,,0,0,0,,Ой, кешіріңіз, мен жай ғана көңілімнен шығып кеттім.
Dialogue: 0,0:25:01.66,0:25:02.91,Default,,0,0,0,,Хмф, мен білмеймін!
Dialogue: 0,0:25:03.08,0:25:06.04,Default,,0,0,0,,Кешіріңіз. Кешірсеңіз...
Dialogue: 0,0:25:06.17,0:25:08.34,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:25:08.67,0:25:10.67,Default,,0,0,0,,Бұл не? Бұл...
Dialogue: 0,0:25:10.80,0:25:11.63,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:15.80,0:25:17.80,Default,,0,0,0,,Аққан жұлдыз?
Dialogue: 0,0:25:17.97,0:25:20.56,Default,,0,0,0,,Аққан қара жұлдыз...
Dialogue: 0,0:25:20.68,0:25:23.52,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:25:31.07,0:25:32.28,Default,,0,0,0,,Gimgim
Dialogue: 0,0:25:34.95,0:25:37.24,Default,,0,0,0,,Әй, ол жоғалды.
Dialogue: 0,0:25:37.45,0:25:38.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:41.24,0:25:43.75,Default,,0,0,0,,Жоқ болды
Dialogue: 0,0:25:43.87,0:25:45.96,Default,,0,0,0,,Кеттік (Нобита) А...
Dialogue: 0,0:25:47.25,0:25:48.92,Default,,0,0,0,,Иә (Нобита) А...
Dialogue: 0,0:25:49.13,0:25:50.38,Default,,0,0,0,,Ұш!
Dialogue: 0,0:25:52.21,0:25:54.46,Default,,0,0,0,,Тоттотто...
Dialogue: 0,0:25:54.63,0:25:55.92,Default,,0,0,0,,Ұш! Апыр-ай!
Dialogue: 0,0:25:56.05,0:25:57.43,Default,,0,0,0,,Уау~ (Нобитаның айқайы)
Dialogue: 0,0:25:57.55,0:26:00.01,Default,,0,0,0,,Уау, аа, у...
Dialogue: 0,0:26:00.93,0:26:02.14,Default,,0,0,0,,Уфуфу... (Нобита) Уау~
Dialogue: 0,0:26:02.26,0:26:04.14,Default,,0,0,0,,Ха ха хи хи
Dialogue: 0,0:26:04.27,0:26:06.10,Default,,0,0,0,,Фуфу (Нобита) Бақытты...
Dialogue: 0,0:26:06.77,0:26:08.19,Default,,0,0,0,,Мұның бәрі тепе-теңдік туралы.
Dialogue: 0,0:26:08.31,0:26:10.56,Default,,0,0,0,,Иә Иә Баланс балансы
Dialogue: 0,0:26:11.23,0:26:13.53,Default,,0,0,0,,Дора-чанның сиқыры біртүрлі.
Dialogue: 0,0:26:13.65,0:26:15.36,Default,,0,0,0,,Бұл сиқыр емес
Dialogue: 0,0:26:15.49,0:26:18.66,Default,,0,0,0,,Бұл ғылымның күшімен тым кішкентай жасалған әуе винті ұшақ.
Dialogue: 0,0:26:18.78,0:26:21.28,Default,,0,0,0,,Хахаха жәй әзіл
Dialogue: 0,0:26:21.41,0:26:25.00,Default,,0,0,0,,Ғылым бұл сиқырлы өркениет әлемінде жай ғана ырым.
Dialogue: 0,0:26:25.12,0:26:27.21,Default,,0,0,0,,Уфуфу (Дораэмон/Нобита) Иә?
Dialogue: 0,0:26:29.42,0:26:30.58,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:26:31.38,0:26:33.21,Default,,0,0,0,,Уау, тоз-тоз болып қалды.
Dialogue: 0,0:26:33.34,0:26:34.75,Default,,0,0,0,,Эй, Джан, ах
Dialogue: 0,0:26:34.88,0:26:37.09,Default,,0,0,0,,Айналаның бәрі құрғап барады.
Dialogue: 0,0:26:37.55,0:26:39.18,Default,,0,0,0,,Мен оның осылай кеткеніне сене алар емеспін...
Dialogue: 0,0:26:39.30,0:26:42.26,Default,,0,0,0,,Бұл жарқыраған жұлдыз, әрине, қалыпты емес.
Dialogue: 0,0:26:42.39,0:26:46.18,Default,,0,0,0,,Иә, бірақ мен метеорит немесе ештеңе таба алмаймын.
Dialogue: 0,0:26:46.31,0:26:49.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:49.98,0:26:50.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:51.44,0:26:52.27,Default,,0,0,0,,Не?
Dialogue: 0,0:26:52.40,0:26:54.52,Default,,0,0,0,,Бірдеңе қозғалды (Сунео) А~?
Dialogue: 0,0:26:54.65,0:26:56.48,Default,,0,0,0,,Міне, сіз! Ха!
Dialogue: 0,0:26:56.61,0:26:58.11,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:26:58.19,0:26:59.95,Default,,0,0,0,,Мугитсу гимут гимут
Dialogue: 0,0:27:00.07,0:27:01.03,Default,,0,0,0,,Бұл бөтен адам!
Dialogue: 0,0:27:01.16,0:27:03.28,Default,,0,0,0,,Не, сен маймыл емессің бе?
Dialogue: 0,0:27:03.41,0:27:05.45,Default,,0,0,0,,Ұстаңыз! Бұл қысқыш шабуыл!
Dialogue: 0,0:27:05.66,0:27:07.62,Default,,0,0,0,,Керемет!
Dialogue: 0,0:27:08.04,0:27:10.50,Default,,0,0,0,,Қорқынышты не? Бұл...
Dialogue: 0,0:27:10.62,0:27:13.34,Default,,0,0,0,,Бұл ағып жатқан жұлдыздың кесірінен бе?
Dialogue: 0,0:27:13.79,0:27:16.38,Default,,0,0,0,,Бұл жай ғана аққан жұлдыз емес.
Dialogue: 0,0:27:16.50,0:27:17.80,Default,,0,0,0,,Уау
Dialogue: 0,0:27:20.68,0:27:22.43,Default,,0,0,0,,Пирамидаларды күзетіп келе жатқан Сфинкс—
Dialogue: 0,0:27:22.55,0:27:24.55,Default,,0,0,0,,(Сунео мен Джанның айқайы)
Dialogue: 0,0:27:27.56,0:27:28.22,Default,,0,0,0,,Gi…
Dialogue: 0,0:27:28.81,0:27:30.14,Default,,0,0,0,,Ех (Нобита) Не?
Dialogue: 0,0:27:30.27,0:27:31.23,Default,,0,0,0,,Маймыл?
Dialogue: 0,0:27:31.85,0:27:33.02,Default,,0,0,0,,(Сунео мен Джанның айқайы)
Dialogue: 0,0:27:33.15,0:27:33.90,Default,,0,0,0,,Мына екеуі!
Dialogue: 0,0:27:34.36,0:27:35.36,Default,,0,0,0,,(Гимнің айқайы)
Dialogue: 0,0:27:35.44,0:27:36.40,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:27:36.52,0:27:37.32,Default,,0,0,0,,Уау
Dialogue: 0,0:27:37.53,0:27:39.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:39.24,0:27:40.78,Default,,0,0,0,,Ха-х... хмм
Dialogue: 0,0:27:46.16,0:27:47.12,Default,,0,0,0,,Джан Сунео!
Dialogue: 0,0:27:49.45,0:27:51.08,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:27:55.29,0:27:56.54,Default,,0,0,0,,Жарайды... Мен уақытында үлгермеймін!
Dialogue: 0,0:27:57.13,0:27:58.00,Default,,0,0,0,,Га
Dialogue: 0,0:28:00.17,0:28:01.93,Default,,0,0,0,,Уау! (Мияко) Иә?
Dialogue: 0,0:28:02.88,0:28:04.30,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:28:08.22,0:28:11.23,Default,,0,0,0,,Уф... ауырады...
Dialogue: 0,0:28:11.35,0:28:13.77,Default,,0,0,0,,Нобита-сан, жақсысың ба?
Dialogue: 0,0:28:13.90,0:28:17.82,Default,,0,0,0,,(Сунеоның ыңырануы)
Dialogue: 0,0:28:17.94,0:28:21.44,Default,,0,0,0,,Ауыр көшіңіз! иә…
Dialogue: 0,0:28:21.57,0:28:23.49,Default,,0,0,0,,Қатты ауырды...
Dialogue: 0,0:28:23.61,0:28:26.07,Default,,0,0,0,,Бұл қорқынышты, ол құлап қалады.
Dialogue: 0,0:28:26.20,0:28:29.24,Default,,0,0,0,,Ау, ау, ау…
Dialogue: 0,0:28:29.37,0:28:32.50,Default,,0,0,0,,Аа... Жарайсыңдар ма?
Dialogue: 0,0:28:35.08,0:28:36.13,Default,,0,0,0,,Иә
Dialogue: 0,0:28:37.50,0:28:41.42,Default,,0,0,0,,Соңында сен құладың. Эй, сен тұра аласың ба?
Dialogue: 0,0:28:41.59,0:28:44.47,Default,,0,0,0,,А... а...
Dialogue: 0,0:28:45.76,0:28:48.22,Default,,0,0,0,,Хмм, жарайды...
Dialogue: 0,0:28:48.35,0:28:51.43,Default,,0,0,0,,Осы екеуіне көмектескеніңіз үшін рахмет.
Dialogue: 0,0:28:51.56,0:28:54.23,Default,,0,0,0,,Иә? Не, балалар, келдіңдер ме?
Dialogue: 0,0:28:54.35,0:28:55.40,Default,,0,0,0,,Иә
Dialogue: 0,0:28:55.60,0:28:58.06,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:28:58.19,0:29:01.07,Default,,0,0,0,,Жарайды. Жақсысыңдар ма?
Dialogue: 0,0:29:01.19,0:29:02.11,Default,,0,0,0,,Иә
Dialogue: 0,0:29:02.24,0:29:05.11,Default,,0,0,0,,Кілемдегі маневр керемет болды.
Dialogue: 0,0:29:05.24,0:29:05.99,Default,,0,0,0,,Рахмет
Dialogue: 0,0:29:06.74,0:29:11.04,Default,,0,0,0,,Бұл сияқты көрінсе де, сізде кілеммен жұмыс істеуге арналған А класындағы лицензияңыз бар.
Dialogue: 0,0:29:11.16,0:29:12.70,Default,,0,0,0,,Ғажайып (Мияко) Уухоу
Dialogue: 0,0:29:12.83,0:29:14.21,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:29:15.83,0:29:16.96,Default,,0,0,0,,Уау
Dialogue: 0,0:29:17.96,0:29:18.67,Default,,0,0,0,,Ах
Dialogue: 0,0:29:18.75,0:29:20.00,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:29:20.13,0:29:21.71,Default,,0,0,0,,Бұл жер сілкінісі. Апыр-ай.
Dialogue: 0,0:29:21.84,0:29:24.51,Default,,0,0,0,,Ал... тағы да осындай үлкен нәрсе ме?
Dialogue: 0,0:29:24.63,0:29:25.59,Default,,0,0,0,,А... тағы да?
Dialogue: 0,0:29:25.72,0:29:27.26,Default,,0,0,0,,Кеше және алдыңғы күн
Dialogue: 0,0:29:27.39,0:29:29.05,Default,,0,0,0,,Соңғы уақытта, барлық уақытта.
Dialogue: 0,0:29:29.18,0:29:30.72,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:29:30.85,0:29:32.64,Default,,0,0,0,,Дүниенің ақыры келе жатыр
Dialogue: 0,0:29:32.77,0:29:33.85,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:29:34.35,0:29:36.64,Default,,0,0,0,,Мен үшін де жаман, хаха
Dialogue: 0,0:29:36.77,0:29:39.02,Default,,0,0,0,,А? (Нобита) тоқтады
Dialogue: 0,0:29:39.23,0:29:41.90,Default,,0,0,0,,Осы жерден тез кетейік (Нобита мен оның достары) Иә?
Dialogue: 0,0:29:42.07,0:29:44.07,Default,,0,0,0,,Бұл жер күдікті белгілерге толы.
Dialogue: 0,0:29:44.90,0:29:49.45,Default,,0,0,0,,Бұл орманның қурап қалуының себебі ол қандай да бір күшті сиқырлы күштің әсерінен болды.
Dialogue: 0,0:29:49.82,0:29:52.70,Default,,0,0,0,,Мұндай орманда тым ұзақ тұру қауіпті.
Dialogue: 0,0:30:01.21,0:30:03.21,Default,,0,0,0,,Әй, менің немісім!
Dialogue: 0,0:30:03.34,0:30:05.67,Default,,0,0,0,,Уау, менде де жоқ!
Dialogue: 0,0:30:05.80,0:30:07.05,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:30:07.18,0:30:09.84,Default,,0,0,0,,Жарайсыңдар, бәрің менің кілеміме мініңдер.
Dialogue: 0,0:30:09.97,0:30:11.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:13.35,0:30:15.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:15.60,0:30:17.52,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:30:17.64,0:30:22.07,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,0:30:42.29,0:30:45.67,Default,,0,0,0,,(айқай)
Dialogue: 0,0:30:55.72,0:30:59.31,Default,,0,0,0,,Тоқта, жарайды, сен менің тұтынушымсың.
Dialogue: 0,0:31:02.36,0:31:05.19,Default,,0,0,0,,Уау, керемет қауіпсіздік
Dialogue: 0,0:31:05.32,0:31:07.28,Default,,0,0,0,,Бұл құбыжықтарға қарсы дайындық.
Dialogue: 0,0:31:07.40,0:31:08.15,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:31:08.65,0:31:12.78,Default,,0,0,0,,Иә, соңғы кездері жер сілкінісі мен ауа райының ауытқулары жиілеп барады.
Dialogue: 0,0:31:12.91,0:31:15.70,Default,,0,0,0,,Мақай жұлдызы жақындағандықтан.
Dialogue: 0,0:31:15.83,0:31:17.33,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:31:18.87,0:31:20.92,Default,,0,0,0,,Мақай жұлдызы?
Dialogue: 0,0:31:26.63,0:31:28.38,Default,,0,0,0,,Жарайды... бұл тас қараңғы.
Dialogue: 0,0:31:28.51,0:31:30.55,Default,,0,0,0,,Әке, бұл менмін.
Dialogue: 0,0:31:30.68,0:31:33.51,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:31:35.10,0:31:37.06,Default,,0,0,0,,үшінңызға қош келдіңіздер
Dialogue: 0,0:31:37.18,0:31:39.35,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:31:39.48,0:31:43.23,Default,,0,0,0,,Құбыжықпен кездесіп, жарақаттың осы деңгейінен қалай құтылуға болады?
Dialogue: 0,0:31:43.35,0:31:45.44,Default,,0,0,0,,Балалар сендер бақыттысыңдар
Dialogue: 0,0:31:45.57,0:31:47.98,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:31:49.69,0:31:52.82,Default,,0,0,0,,Жараны емдейміз
Dialogue: 0,0:31:52.95,0:31:54.91,Default,,0,0,0,,Артқы бөлмеге өтіңіз.
Dialogue: 0,0:31:55.03,0:31:56.66,Default,,0,0,0,,А, сен...
Dialogue: 0,0:31:57.70,0:31:59.25,Default,,0,0,0,,Пастор Толық ай!
Dialogue: 0,0:31:59.37,0:32:01.83,Default,,0,0,0,,Мен толық аймын.
Dialogue: 0,0:32:02.33,0:32:03.79,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:32:03.83,0:32:04.00,Default,,0,0,0,,Эй, пастор Мангецу деген кім?
Dialogue: 0,0:32:04.00,0:32:05.63,Default,,0,0,0,,Эй, пастор Мангецу деген кім?
Dialogue: 0,0:32:04.00,0:32:05.63,Default,,0,0,0,,Нағыз құрметті толық ай
Dialogue: 0,0:32:05.63,0:32:05.75,Default,,0,0,0,,Эй, пастор Мангецу деген кім?
Dialogue: 0,0:32:05.75,0:32:06.54,Default,,0,0,0,,Эй, пастор Мангецу деген кім?
Dialogue: 0,0:32:05.75,0:32:06.54,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:32:06.54,0:32:06.67,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:32:06.67,0:32:07.00,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:32:06.67,0:32:07.00,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,0:32:07.00,0:32:07.13,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,0:32:07.13,0:32:08.88,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,0:32:07.13,0:32:08.88,Default,,0,0,0,,Мияконың әкесі құрметті Мангецу болды...
Dialogue: 0,0:32:08.88,0:32:09.01,Default,,0,0,0,,Мияконың әкесі құрметті Мангецу болды...
Dialogue: 0,0:32:09.01,0:32:11.01,Default,,0,0,0,,Мияконың әкесі құрметті Мангецу болды...
Dialogue: 0,0:32:09.01,0:32:11.01,Default,,0,0,0,,Атақты сиқырлы зерттеуші.
Dialogue: 0,0:32:11.01,0:32:11.93,Default,,0,0,0,,Атақты сиқырлы зерттеуші.
Dialogue: 0,0:32:12.05,0:32:14.09,Default,,0,0,0,,Ол кейде теледидарға шығады.
Dialogue: 0,0:32:14.22,0:32:17.06,Default,,0,0,0,,А-а, түсіндім, есіме түсті.
Dialogue: 0,0:32:17.18,0:32:19.31,Default,,0,0,0,,Нобита-кун қазірдің өзінде ұмытшақ.
Dialogue: 0,0:32:19.77,0:32:23.27,Default,,0,0,0,,Реверенд Мангецу Сіз бұл құбыжық деп айттыңыз...
Dialogue: 0,0:32:23.39,0:32:25.02,Default,,0,0,0,,Сол аққан қара жұлдыз да...
Dialogue: 0,0:32:25.15,0:32:28.32,Default,,0,0,0,,Оның Мақай жұлдызына қатысы бар ма?
Dialogue: 0,0:32:28.44,0:32:30.07,Default,,0,0,0,,(Толық ай күрсіну)
Dialogue: 0,0:32:31.19,0:32:36.53,Default,,0,0,0,,Бұл жер бетінде қорқынышты нәрсе болады.
Dialogue: 0,0:32:38.70,0:32:40.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:32:41.16,0:32:45.08,Default,,0,0,0,,Балалар, сендер шайтанның бар екеніне сенесіңдер ме?
Dialogue: 0,0:32:45.21,0:32:49.92,Default,,0,0,0,,Ол бұрын болған, бірақ адам эволюциясына байланысты жойылып кеткен.
Dialogue: 0,0:32:50.05,0:32:52.01,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:32:52.22,0:32:53.80,Default,,0,0,0,,Олар осылай дейді.
Dialogue: 0,0:32:54.38,0:32:57.47,Default,,0,0,0,,Бірақ мен ескі құжатты шешіп алдым —
Dialogue: 0,0:32:57.60,0:33:00.56,Default,,0,0,0,,Мен қорқынышты шындықты білдім.
Dialogue: 0,0:33:01.52,0:33:04.35,Default,,0,0,0,,Соған сәйкес біз адамдар...
Dialogue: 0,0:33:04.48,0:33:07.31,Default,,0,0,0,,Ол бастапқыда шайтаннан сиқырды алды —
Dialogue: 0,0:33:07.44,0:33:11.23,Default,,0,0,0,,Ол қазіргі сиқырлы өркениеттің негізін салған деседі.
Dialogue: 0,0:33:11.40,0:33:15.70,Default,,0,0,0,,Ал ол жындар жердегі жаратылыс емес...
Dialogue: 0,0:33:15.82,0:33:20.99,Default,,0,0,0,,Мақай жұлдызы деп аталатын аспан денесінен шыққан деседі.
Dialogue: 0,0:33:22.37,0:33:23.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:23.29,0:33:27.08,Default,,0,0,0,,Сонда... сонда шайтан бөтен адам ма?
Dialogue: 0,0:33:28.29,0:33:30.13,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:33:30.25,0:33:35.17,Default,,0,0,0,,Дегенмен, Мақай жұлдызы тарихта Жерге талай рет жақындаған.
Dialogue: 0,0:33:35.34,0:33:39.55,Default,,0,0,0,,Динозаврлардың жойылуы, Нұх топан суы туралы аңыз, т.б.
Dialogue: 0,0:33:39.93,0:33:44.81,Default,,0,0,0,,Жердегі тіршіліктің жойылу қаупін төндіретін жұмбақ табиғи апат.
Dialogue: 0,0:33:44.93,0:33:47.94,Default,,0,0,0,,Олардың барлығы Мақай жұлдызының жақындауынан туындаған.
Dialogue: 0,0:33:48.06,0:33:50.48,Default,,0,0,0,,Бұл әкелген нәрсе болды.
Dialogue: 0,0:33:50.98,0:33:56.03,Default,,0,0,0,,Енді сол жын әлем жұлдызы Жерге қайтадан жақындап келеді.
Dialogue: 0,0:33:56.32,0:33:58.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:58.49,0:34:00.87,Default,,0,0,0,,Бірақ мен сізді қатты ескертсем де,
Dialogue: 0,0:34:00.99,0:34:03.79,Default,,0,0,0,,Мақай жұлдызының немесе жындардың бар екеніне ешкім сенгісі келмейді.
Dialogue: 0,0:34:04.79,0:34:07.25,Default,,0,0,0,,Бірақ бұл факт
Dialogue: 0,0:34:07.37,0:34:09.58,Default,,0,0,0,,Мақай жұлдызы, ақырзаман...
Dialogue: 0,0:34:09.71,0:34:13.00,Default,,0,0,0,,Сіз оны көретін нүктеге жеткенде, қазірдің өзінде кеш.
Dialogue: 0,0:34:13.13,0:34:14.76,Default,,0,0,0,,(Нобитаның тыныс алу дыбысы)
Dialogue: 0,0:34:16.88,0:34:19.01,Default,,0,0,0,,Бірақ анам маған сенді.
Dialogue: 0,0:34:19.68,0:34:21.22,Default,,0,0,0,,Миёко
Dialogue: 0,0:34:21.39,0:34:24.02,Default,,0,0,0,,Ана туралы енді жоқ...
Dialogue: 0,0:34:24.14,0:34:24.97,Default,,0,0,0,,Бірақ анам...
Dialogue: 0,0:34:25.10,0:34:27.23,Default,,0,0,0,,Тіпті біреуді құтқару үшін болса да—
Dialogue: 0,0:34:27.35,0:34:30.35,Default,,0,0,0,,Шайтанның күшін қарызға алу жараспайды!
Dialogue: 0,0:34:31.23,0:34:32.94,Default,,0,0,0,,Уау (толық ай) ааа...
Dialogue: 0,0:34:33.07,0:34:34.57,Default,,0,0,0,,Кешіріңіз, жай...
Dialogue: 0,0:34:34.69,0:34:38.32,Default,,0,0,0,,Амансың ба? Кешіріңіз (Сунео) Иә.
Dialogue: 0,0:34:38.86,0:34:39.99,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:34:40.53,0:34:43.41,Default,,0,0,0,,Жарайды, мен оны қайта саламын.
Dialogue: 0,0:34:43.53,0:34:46.00,Default,,0,0,0,,Кешіріңіз Миёко
Dialogue: 0,0:34:46.87,0:34:48.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:34:53.00,0:34:56.67,Default,,0,0,0,,Бұл Мияконың анасы...
Dialogue: 0,0:34:56.80,0:34:57.88,Default,,0,0,0,,Иә...
Dialogue: 0,0:34:59.38,0:35:01.72,Default,,0,0,0,,Сол баланың анасы...
Dialogue: 0,0:35:03.47,0:35:07.35,Default,,0,0,0,,(Мияконың ауыр тыныс алуы)
Dialogue: 0,0:35:07.48,0:35:08.73,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:35:08.85,0:35:12.36,Default,,0,0,0,,Қазіргі сиқырмен балаңыздың өмірін сақтап қалу мүмкін емес...
Dialogue: 0,0:35:12.48,0:35:14.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:35:14.40,0:35:16.82,Default,,0,0,0,,Өтірік өтірік
Dialogue: 0,0:35:16.94,0:35:18.19,Default,,0,0,0,,Мияко...
Dialogue: 0,0:35:18.32,0:35:20.40,Default,,0,0,0,,(Мияконың анасының жылағаны)
Dialogue: 0,0:35:29.00,0:35:31.50,Default,,0,0,0,,Эй, сен не оқып жатырсың?
Dialogue: 0,0:35:31.62,0:35:35.92,Default,,0,0,0,,Мен одан сайын күшті сиқыр алмасам...
Dialogue: 0,0:35:36.05,0:35:37.09,Default,,0,0,0,,Мияко...
Dialogue: 0,0:35:37.92,0:35:40.51,Default,,0,0,0,,Шайтанмен мәміле жасау, т.б.
Dialogue: 0,0:35:40.88,0:35:43.93,Default,,0,0,0,,Бұл басқа адамдардың өмірін құрбан ету туралы ғана емес.
Dialogue: 0,0:35:44.05,0:35:46.81,Default,,0,0,0,,Оның не әкелетінін білмейсіз.
Dialogue: 0,0:35:53.10,0:35:56.52,Default,,0,0,0,,Ол шайтанмен мәміле жасады
Dialogue: 0,0:35:56.98,0:35:59.82,Default,,0,0,0,,Өз өміріңді құрбан ет
Dialogue: 0,0:35:59.94,0:36:02.78,Default,,0,0,0,,Жоқ! Тоқта!
Dialogue: 0,0:36:06.53,0:36:07.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:36:11.62,0:36:13.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:16.54,0:36:19.76,Default,,0,0,0,,Мақай жұлдызын шақыратын да осы шығар.
Dialogue: 0,0:36:19.88,0:36:22.55,Default,,0,0,0,,Бұл триггер болуы керек.
Dialogue: 0,0:36:22.76,0:36:25.47,Default,,0,0,0,,Ібіліс шынымен де жерде ме?
Dialogue: 0,0:36:25.80,0:36:28.81,Default,,0,0,0,,Шайтаннан құтылудың жолы бар емес пе?
Dialogue: 0,0:36:28.93,0:36:30.43,Default,,0,0,0,,Бұл болмайды...
Dialogue: 0,0:36:31.98,0:36:32.89,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:36:33.02,0:36:35.56,Default,,0,0,0,,Ах... (Нобита және т.б.) Уау...
Dialogue: 0,0:36:36.81,0:36:40.69,Default,,0,0,0,,5000 жыл бұрын Нарниадес есімді адам...
Dialogue: 0,0:36:40.82,0:36:44.91,Default,,0,0,0,,Жын-шайтандардың билігін мөрлеген деген аңыз бар.
Dialogue: 0,0:36:45.03,0:36:47.41,Default,,0,0,0,,Әдістемені сипаттайтын жын дүние тарихы...
Dialogue: 0,0:36:47.53,0:36:50.12,Default,,0,0,0,,Жердің белгілі бір жерінде жасырылған...
Dialogue: 0,0:36:50.24,0:36:52.50,Default,,0,0,0,,Бұл көне құжатта жазылған.
Dialogue: 0,0:36:52.75,0:36:55.46,Default,,0,0,0,,Олай болса, сізде сол жын дүниелік тарих болғанша...
Dialogue: 0,0:36:55.58,0:36:57.79,Default,,0,0,0,,Сіз шайтаннан қорықпайсыз, солай ма?
Dialogue: 0,0:36:57.92,0:37:00.76,Default,,0,0,0,,Дегенмен, бұл да өте ескі құжат.
Dialogue: 0,0:37:00.88,0:37:03.67,Default,,0,0,0,,Мен жасырынған жерді аша алмаймын.
Dialogue: 0,0:37:04.01,0:37:05.22,Default,,0,0,0,,Дешифрлеу?
Dialogue: 0,0:37:05.34,0:37:06.76,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:37:06.89,0:37:09.68,Default,,0,0,0,,Ха... бұл шынымен де конняку!
Dialogue: 0,0:37:10.31,0:37:13.52,Default,,0,0,0,,Пастор Мангецу, мынаны қолданып көріңіз.
Dialogue: 0,0:37:13.64,0:37:16.31,Default,,0,0,0,,Коньяк? Жарайды, жарайды
Dialogue: 0,0:37:16.44,0:37:19.57,Default,,0,0,0,,Ахх
Dialogue: 0,0:37:19.69,0:37:21.57,Default,,0,0,0,,Ха иә иә иә
Dialogue: 0,0:37:21.69,0:37:23.65,Default,,0,0,0,,Иә? Бұл... бұл...
Dialogue: 0,0:37:24.11,0:37:27.62,Default,,0,0,0,,Уау...оқыдым.Көрдім.
Dialogue: 0,0:37:27.74,0:37:30.12,Default,,0,0,0,,Балалар, сендер таңғажайып сиқыр қолданасыңдар.
Dialogue: 0,0:37:30.33,0:37:31.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:32.29,0:37:34.75,Default,,0,0,0,,Мен мұндай жұмбақ сиқырды бірінші рет көріп тұрмын.
Dialogue: 0,0:37:34.87,0:37:35.50,Default,,0,0,0,,Иә
Dialogue: 0,0:37:35.62,0:37:37.75,Default,,0,0,0,,Хамф, Хун?
Dialogue: 0,0:37:37.88,0:37:41.25,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:37:41.50,0:37:43.59,Default,,0,0,0,,Енді шайтан келсе де, өзіңді еркін сезінесің.
Dialogue: 0,0:37:43.71,0:37:44.38,Default,,0,0,0,,Иә
Dialogue: 0,0:37:44.51,0:37:47.22,Default,,0,0,0,,(Нобита мен Дорэмонның күлкісі)
Dialogue: 0,0:37:48.26,0:37:50.81,Default,,0,0,0,,Қазір! Мен үйдемін
Dialogue: 0,0:37:51.43,0:37:54.23,Default,,0,0,0,,Ха, тез арада бастапқы әлемімізге ораламыз ба?
Dialogue: 0,0:37:54.35,0:37:57.81,Default,,0,0,0,,Иә, мен кілемге мініп, сиқырды қолдана білдім.
Dialogue: 0,0:37:58.48,0:38:00.73,Default,,0,0,0,,Сіз юбка тігу дейсіз бе?
Dialogue: 0,0:38:00.86,0:38:03.94,Default,,0,0,0,,Объектінің қалқымалы техникасы! Қазірдің өзінде...
Dialogue: 0,0:38:04.78,0:38:06.32,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:38:06.95,0:38:10.70,Default,,0,0,0,,Ана... Ана, мына жердегі қорап ше?
Dialogue: 0,0:38:10.83,0:38:13.04,Default,,0,0,0,,Бұл үлкен қорап?
Dialogue: 0,0:38:13.16,0:38:16.16,Default,,0,0,0,,Не істерімді ойладым, себебі бұл мені мазалады.
Dialogue: 0,0:38:16.29,0:38:17.42,Default,,0,0,0,,Сонда жай ғана—
Dialogue: 0,0:38:17.54,0:38:20.13,Default,,0,0,0,,Қоқыс жинайтын үлкен кілем өтіп бара жатты...
Dialogue: 0,0:38:20.25,0:38:21.42,Default,,0,0,0,,(Ватару) Спортшыларды жеңіл санамаңдар! Біз бірге жаттығуға міндетті түрде уақыт табамыз.
Dialogue: 0,0:38:21.71,0:38:24.38,Default,,0,0,0,,Бұл... қиын! (Нобита) Уау!
Dialogue: 0,0:38:28.97,0:38:30.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:38:39.94,0:38:42.77,Default,,0,0,0,,(Екі адам күрсінді)
Dialogue: 0,0:38:43.52,0:38:45.61,Default,,0,0,0,,Егер қорап болмаса ше?
Dialogue: 0,0:38:45.74,0:38:48.24,Default,,0,0,0,,Мен енді бұрынғы әлеміме орала алмаймын.
Dialogue: 0,0:38:48.57,0:38:51.74,Default,,0,0,0,,Осы жауапсыздыққа қатысты бірдеңе жасаңыз.
Dialogue: 0,0:38:51.87,0:38:55.12,Default,,0,0,0,,Бұл сіз жасаған әлем. Жауапкершілікті өз мойнына алу керек.
Dialogue: 0,0:38:55.24,0:38:57.75,Default,,0,0,0,,Құралдарды тастап кеткеніме менің кінәм болды.
Dialogue: 0,0:38:57.87,0:39:00.71,Default,,0,0,0,,Мен бәрін тастап кетсем де
Dialogue: 0,0:39:00.83,0:39:03.54,Default,,0,0,0,,Мен қорапты ойлап тапқаныма мен кінәлімін.
Dialogue: 0,0:39:03.67,0:39:05.50,Default,,0,0,0,,Мен бұл жақсы идея деп айттым.
Dialogue: 0,0:39:05.63,0:39:09.55,Default,,0,0,0,,Жоқ, өйткені сіз...
Dialogue: 0,0:39:16.89,0:39:18.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:19.69,0:39:21.52,Default,,0,0,0,,Кешегіден үлкенірек.
Dialogue: 0,0:39:21.65,0:39:25.44,Default,,0,0,0,,Жұлдыздың сәулесін жұтып, Мақай жұлдызы жақындап келеді.
Dialogue: 0,0:39:25.57,0:39:27.07,Default,,0,0,0,,Эй Мияко (Мияко) Ха
Dialogue: 0,0:39:27.19,0:39:28.36,Default,,0,0,0,,(Толық айдың қатты тынысы)
Dialogue: 0,0:39:28.49,0:39:29.61,Default,,0,0,0,,Сәлем Мияко
Dialogue: 0,0:39:29.74,0:39:30.78,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:39:30.91,0:39:34.70,Default,,0,0,0,,Мен мұны ақыры түсіндім. Енді сіз Makai Ryokujo-ны ала аласыз.
Dialogue: 0,0:39:34.83,0:39:37.16,Default,,0,0,0,,Ғажайып (толық ай) Мынаны қара!
Dialogue: 0,0:39:37.29,0:39:38.75,Default,,0,0,0,,Ха... а...
Dialogue: 0,0:39:38.87,0:39:41.00,Default,,0,0,0,,Не?
Dialogue: 0,0:39:41.17,0:39:42.58,Default,,0,0,0,,Юки...
Dialogue: 0,0:39:52.18,0:39:54.80,Default,,0,0,0,,Не, тағы ұрысып қалдың ба?
Dialogue: 0,0:39:54.93,0:39:58.02,Default,,0,0,0,,Ей, тағы бір тайфун келе жатыр.
Dialogue: 0,0:39:58.14,0:39:59.39,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:39:59.73,0:40:04.27,Default,,0,0,0,,Барлық жерде су тасқыны мен суық толқындар шынымен не болып жатыр?
Dialogue: 0,0:40:04.40,0:40:05.36,Default,,0,0,0,,Хмф!
Dialogue: 0,0:40:07.27,0:40:08.78,Default,,0,0,0,,Ха (толық ай) о
Dialogue: 0,0:40:10.32,0:40:11.36,Default,,0,0,0,,(Көрермен С) Отбасында осындай қарт адамның болуы – нағыз қорқынышты түс қой.
Dialogue: 0,0:40:13.99,0:40:14.95,Default,,0,0,0,,Ах (Мияко) Ха.
Dialogue: 0,0:40:19.87,0:40:21.79,Default,,0,0,0,,Ха (Мияко) Ах...
Dialogue: 0,0:40:28.92,0:40:30.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:33.63,0:40:34.97,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:40:35.14,0:40:37.35,Default,,0,0,0,,Бұл... бұл... (Мияко) Не?
Dialogue: 0,0:40:47.44,0:40:48.36,Default,,0,0,0,,(Меджузаның айқайы)
Dialogue: 0,0:40:49.40,0:40:50.61,Default,,0,0,0,,Ах (Мияко) Ах!
Dialogue: 0,0:40:50.73,0:40:53.32,Default,,0,0,0,,Ми... Мияко Ах!
Dialogue: 0,0:40:56.66,0:40:57.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:57.83,0:40:58.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:40:59.12,0:41:01.62,Default,,0,0,0,,Әй, Те... Үстелдің астына түс!
Dialogue: 0,0:41:01.75,0:41:02.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:04.00,0:41:05.33,Default,,0,0,0,,Нобита!
Dialogue: 0,0:41:05.92,0:41:07.38,Default,,0,0,0,,Kya...
Dialogue: 0,0:41:07.63,0:41:09.30,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:41:09.42,0:41:11.30,Default,,0,0,0,,...
Dialogue: 0,0:41:12.72,0:41:16.72,Default,,0,0,0,,(төбелес дауыстары)
Dialogue: 0,0:41:24.39,0:41:27.73,Default,,0,0,0,,А, бұл үлкен болды.
Dialogue: 0,0:41:28.27,0:41:31.07,Default,,0,0,0,,А... Жер сілкінісінің ошағы жақын екеніне сенімдімін.
Dialogue: 0,0:41:32.03,0:41:33.19,Default,,0,0,0,,Жолдан кет, жолдан кет
Dialogue: 0,0:41:33.32,0:41:35.11,Default,,0,0,0,,Бұл жұмыс істемейді...
Dialogue: 0,0:41:35.24,0:41:36.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:36.20,0:41:39.74,Default,,0,0,0,,Сіз не істеп жатырсыз? Теледидарды қалай қосуды ұмытып қалдыңыз ба?
Dialogue: 0,0:41:39.87,0:41:42.20,Default,,0,0,0,,Коммутаторды түртіп, телекинез жіберіңіз, солай ма?
Dialogue: 0,0:41:42.33,0:41:43.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:43.45,0:41:46.75,Default,,0,0,0,,Супер тайфун әлі де өз күшін сақтайды.
Dialogue: 0,0:41:46.96,0:41:48.75,Default,,0,0,0,,Солтүстікке қарай жалғастыру
Dialogue: 0,0:41:48.88,0:41:51.38,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:41:51.50,0:41:54.55,Default,,0,0,0,,Жаңа ғана болған жер сілкінісі туралы толық ақпарат.
Dialogue: 0,0:41:54.67,0:41:56.93,Default,,0,0,0,,Жер сілкінісінің ошағы Жуқай орманының солтүстік-батыс бөлігінде.
Dialogue: 0,0:41:57.43,0:41:59.89,Default,,0,0,0,,Жер сілкінісінің тереңдігі өте таяз...
Dialogue: 0,0:42:00.01,0:42:02.31,Default,,0,0,0,,Бұл жақын болды.
Dialogue: 0,0:42:02.43,0:42:03.85,Default,,0,0,0,,Ағаштар орманы...
Dialogue: 0,0:42:03.97,0:42:06.19,Default,,0,0,0,,Мияко шіркеуінің жанында.
Dialogue: 0,0:42:06.31,0:42:08.31,Default,,0,0,0,,Ах... Хмф!
Dialogue: 0,0:42:11.69,0:42:14.32,Default,,0,0,0,,Алдымен барыңыз! О, мынау
Dialogue: 0,0:42:15.82,0:42:17.28,Default,,0,0,0,,Алға! (Нобита) Ах!
Dialogue: 0,0:42:18.11,0:42:21.28,Default,,0,0,0,,Ей, бәрі мен туралы!
Dialogue: 0,0:42:21.41,0:42:23.45,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:42:23.58,0:42:24.58,Default,,0,0,0,,Айдаһар…
Dialogue: 0,0:42:27.58,0:42:29.71,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:42:29.83,0:42:31.88,Default,,0,0,0,,Haunt! Жүрексіз адам!
Dialogue: 0,0:42:32.00,0:42:34.38,Default,,0,0,0,,Артымда қанша қалдырсам да...
Dialogue: 0,0:42:34.51,0:42:38.01,Default,,0,0,0,,Қысқа аяқтар! Понкотсу ракон ит!
Dialogue: 0,0:42:38.63,0:42:39.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:39.68,0:42:42.56,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:42:44.14,0:42:45.81,Default,,0,0,0,,Дораемон...
Dialogue: 0,0:42:53.77,0:42:55.32,Default,,0,0,0,,Ум...
Dialogue: 0,0:42:56.69,0:42:58.28,Default,,0,0,0,,Не?
Dialogue: 0,0:43:00.49,0:43:02.16,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:43:03.12,0:43:07.08,Default,,0,0,0,,А, сіз жай ғана татуласа аласыз.
Dialogue: 0,0:43:10.92,0:43:11.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:12.08,0:43:14.38,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:43:18.76,0:43:20.30,Default,,0,0,0,,...
Dialogue: 0,0:43:20.43,0:43:22.18,Default,,0,0,0,,иә... хе хе
Dialogue: 0,0:43:22.30,0:43:24.39,Default,,0,0,0,,Дораемон! Нобита-кун!
Dialogue: 0,0:43:24.51,0:43:25.85,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:43:26.64,0:43:28.60,Default,,0,0,0,,Төбелесудің қажеті жоқ.
Dialogue: 0,0:43:28.73,0:43:30.35,Default,,0,0,0,,Екі адам күш біріктірсе...
Dialogue: 0,0:43:30.48,0:43:34.15,Default,,0,0,0,,Мен өзімнің бастапқы әлеміме оралудың жолын табатыныма сенімдімін.
Dialogue: 0,0:43:34.27,0:43:35.44,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:43:35.57,0:43:38.19,Default,,0,0,0,,Жүр, асығайық. Мен Мияко-сан үшін алаңдаймын.
Dialogue: 0,0:43:38.32,0:43:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:43:39.15,0:43:40.86,Default,,0,0,0,,Бұл! (Нобита) Хахаха...
Dialogue: 0,0:43:50.66,0:43:53.25,Default,,0,0,0,,Do... Дораэмон Бұл не...
Dialogue: 0,0:43:53.38,0:43:58.26,Default,,0,0,0,,Иә, бұл... ақымақ...
Dialogue: 0,0:43:58.96,0:44:01.63,Default,,0,0,0,,Шіркеу жоқ!
Dialogue: 0,0:44:02.89,0:44:05.39,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,0:44:06.60,0:44:10.52,Default,,0,0,0,,Пастор Толық ай!
Dialogue: 0,0:44:11.77,0:44:14.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:44:15.06,0:44:18.69,Default,,0,0,0,,Миякоға және басқаларға не болды?
Dialogue: 0,0:44:19.90,0:44:23.11,Default,,0,0,0,,Чу Чу Чу
Dialogue: 0,0:44:23.70,0:44:25.24,Default,,0,0,0,,Иә? Дора ла ла...
Dialogue: 0,0:44:25.37,0:44:27.45,Default,,0,0,0,,Тінтуір!
Dialogue: 0,0:44:27.58,0:44:29.04,Default,,0,0,0,,Ух чу!
Dialogue: 0,0:44:29.16,0:44:30.16,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:44:30.16,0:44:31.50,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:44:30.16,0:44:31.50,Default,,0,0,0,,Дораемон! аздап!
Dialogue: 0,0:44:31.58,0:44:32.75,Default,,0,0,0,,Егеуқұйрық Жоқ!
Dialogue: 0,0:44:33.00,0:44:33.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:33.79,0:44:37.04,Default,,0,0,0,,Ахх
Dialogue: 0,0:44:37.17,0:44:39.17,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:44:40.17,0:44:43.22,Default,,0,0,0,,До... дора... дора... уф
Dialogue: 0,0:44:43.43,0:44:45.68,Default,,0,0,0,,Бұл айдаһар!
Dialogue: 0,0:44:45.80,0:44:46.89,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:44:47.01,0:44:50.93,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:44:51.23,0:44:54.10,Default,,0,0,0,,Сіз де кішкентай қыздардың қатарындасыз ба?
Dialogue: 0,0:44:54.23,0:44:55.06,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:44:55.44,0:44:56.69,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:44:57.52,0:44:58.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:01.24,0:45:01.94,Default,,0,0,0,,А, аа!
Dialogue: 0,0:45:02.57,0:45:04.66,Default,,0,0,0,,Болды, қызым!
Dialogue: 0,0:45:05.86,0:45:07.49,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,0:45:07.83,0:45:10.70,Default,,0,0,0,,Чу Чу Чу Чу Чу Чу?
Dialogue: 0,0:45:13.41,0:45:14.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:14.75,0:45:15.50,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,0:45:15.62,0:45:16.75,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,0:45:17.63,0:45:19.29,Default,,0,0,0,,Ха ха!
Dialogue: 0,0:45:19.50,0:45:20.80,Default,,0,0,0,,Иә! (Екі жұлдыз) Бұл!
Dialogue: 0,0:45:21.92,0:45:22.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:45:23.47,0:45:25.09,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:45:26.39,0:45:28.01,Default,,0,0,0,,Гах! Уау...
Dialogue: 0,0:45:30.72,0:45:32.93,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:45:35.35,0:45:36.56,Default,,0,0,0,,Әй!
Dialogue: 0,0:45:38.19,0:45:38.98,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,0:45:39.11,0:45:39.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:40.32,0:45:41.32,Default,,0,0,0,,Әй, Мияко-сан!
Dialogue: 0,0:45:41.57,0:45:42.94,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:45:43.07,0:45:44.99,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:45:45.99,0:45:46.78,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,0:45:48.37,0:45:49.91,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:45:50.74,0:45:52.54,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,0:45:52.66,0:45:56.54,Default,,0,0,0,,Уф уаа
Dialogue: 0,0:45:59.38,0:46:00.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:01.67,0:46:03.05,Default,,0,0,0,,Мугитсугицу
Dialogue: 0,0:46:07.47,0:46:10.80,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:46:11.35,0:46:13.77,Default,,0,0,0,,Н... Мен қорқынышты жағдайда болдым.
Dialogue: 0,0:46:13.89,0:46:17.02,Default,,0,0,0,,үшінңызды қатыстырғаным үшін кешірім сұраймын.
Dialogue: 0,0:46:17.14,0:46:18.35,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:46:18.85,0:46:21.77,Default,,0,0,0,,Мияко-сан, пастор Мангецу ше?
Dialogue: 0,0:46:22.86,0:46:26.11,Default,,0,0,0,,Жындар бүкіл шіркеуді басқа өлшемге алып кетті.
Dialogue: 0,0:46:26.24,0:46:27.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:27.99,0:46:30.53,Default,,0,0,0,,Мен ғана құтылдым...
Dialogue: 0,0:46:30.66,0:46:33.74,Default,,0,0,0,,Бұрынғы жын мені тауып алып, қуып келе жатты.
Dialogue: 0,0:46:34.33,0:46:37.04,Default,,0,0,0,,Бірақ бұл ежелгі құжат қауіпсіз болды.
Dialogue: 0,0:46:37.75,0:46:39.54,Default,,0,0,0,,Егер сіз жын дүние тарихын іздесеңіз...
Dialogue: 0,0:46:39.67,0:46:42.67,Default,,0,0,0,,Мен жындардың күшін қалай жою керектігін білемін.
Dialogue: 0,0:46:42.79,0:46:44.88,Default,,0,0,0,,Оны өзіңізбен бірге алып, Мақай жұлдызына мінсеңіз...
Dialogue: 0,0:46:45.01,0:46:46.47,Default,,0,0,0,,Мақай жұлдызына?
Dialogue: 0,0:46:46.97,0:46:51.51,Default,,0,0,0,,Ұлы жын патша Демаонды жеңіп алмасақ, олар міндетті түрде жерге келеді.
Dialogue: 0,0:46:51.64,0:46:53.93,Default,,0,0,0,,Сондай-ақ, әкеме көмектесу...
Dialogue: 0,0:46:54.68,0:46:55.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:56.18,0:46:58.73,Default,,0,0,0,,Өтінемін, екеумізге де күш-қуатыңызды беріңіздерші.
Dialogue: 0,0:46:58.85,0:47:00.06,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:47:00.19,0:47:04.27,Default,,0,0,0,,Жоқ, кенеттен осындай сұмдық сөз айтсаң да...
Dialogue: 0,0:47:04.40,0:47:06.40,Default,,0,0,0,,Мақай жұлдызына бару...
Dialogue: 0,0:47:06.57,0:47:09.15,Default,,0,0,0,,Жоқ, мен бармаймын деп айтқан жоқпын.
Dialogue: 0,0:47:09.28,0:47:10.32,Default,,0,0,0,,Әлі де... иә иә
Dialogue: 0,0:47:10.45,0:47:14.74,Default,,0,0,0,,Мен үш адаммен не істей аламыз деп ойлаймын...
Dialogue: 0,0:47:14.87,0:47:17.58,Default,,0,0,0,,Алдымен полицияға хабарласып көріңіз.
Dialogue: 0,0:47:17.83,0:47:19.33,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:47:19.83,0:47:22.83,Default,,0,0,0,,Сізді одан әрі араластыру қорқынышты болар еді.
Dialogue: 0,0:47:22.96,0:47:23.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:23.92,0:47:26.30,Default,,0,0,0,,Бұл менің проблемам.
Dialogue: 0,0:47:26.42,0:47:27.59,Default,,0,0,0,,Мияко-сан...
Dialogue: 0,0:47:28.09,0:47:30.26,Default,,0,0,0,,(Мияконың ысқырығы)
Dialogue: 0,0:47:32.80,0:47:34.10,Default,,0,0,0,,Ах (Мияко) Қош бол
Dialogue: 0,0:47:34.22,0:47:34.97,Default,,0,0,0,,Мияко…
Dialogue: 0,0:47:37.68,0:47:39.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:01.00,0:48:04.63,Default,,0,0,0,,Олай болса, Мияко-сан, сен Макай Рекиджо алуға жалғыз бардың ба?
Dialogue: 0,0:48:05.13,0:48:07.84,Default,,0,0,0,,Мүмкін білмеймін.
Dialogue: 0,0:48:08.17,0:48:09.92,Default,,0,0,0,,Нобита!
Dialogue: 0,0:48:10.05,0:48:14.09,Default,,0,0,0,,Бірақ... Мақай жұлдызына бару ысырап болар еді.
Dialogue: 0,0:48:14.22,0:48:16.18,Default,,0,0,0,,Бізде қарапайым нысанды көтеру техникасы бар және...
Dialogue: 0,0:48:16.31,0:48:18.31,Default,,0,0,0,,Сіз тек сыпырғышқа мінсеңіз болғаны.
Dialogue: 0,0:48:18.93,0:48:20.52,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:48:20.64,0:48:22.52,Default,,0,0,0,,Бұл тек кедергі болады.
Dialogue: 0,0:48:23.06,0:48:26.48,Default,,0,0,0,,Бірақ Мияко-сан жалғыз...
Dialogue: 0,0:48:26.61,0:48:28.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:28.57,0:48:31.82,Default,,0,0,0,,Әй, бәрі, түстен кейінгі сабақтар тоқтатылды.
Dialogue: 0,0:48:31.95,0:48:34.16,Default,,0,0,0,,Тайфун күшеймес бұрын —
Dialogue: 0,0:48:34.28,0:48:36.74,Default,,0,0,0,,Үйге тез қайт.
Dialogue: 0,0:48:37.16,0:48:38.49,Default,,0,0,0,,Мен... Мен асығуым керек.
Dialogue: 0,0:48:38.62,0:48:42.96,Default,,0,0,0,,А, күте тұр, Сунео-сан, Таке-сан!
Dialogue: 0,0:48:53.26,0:48:54.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:54.72,0:48:56.51,Default,,0,0,0,,Уф уау
Dialogue: 0,0:48:58.14,0:48:59.97,Default,,0,0,0,,«Батырларды өлтірушіні» жеңгені үшін атағы шыққан сол жігіт—
Dialogue: 0,0:49:03.02,0:49:04.60,Default,,0,0,0,,Миёко-сан
Dialogue: 0,0:49:05.15,0:49:06.69,Default,,0,0,0,,Бұл ғана емес
Dialogue: 0,0:49:06.81,0:49:09.94,Default,,0,0,0,,Дүние жүзінде дауылдар мен циклондар болып жатыр.
Dialogue: 0,0:49:10.28,0:49:12.11,Default,,0,0,0,,Зақым өсуде
Dialogue: 0,0:49:12.24,0:49:13.90,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:49:16.28,0:49:20.33,Default,,0,0,0,,Нобита, жақсы болдыңыз ба? (Нобита) Иә, әйтеуір.
Dialogue: 0,0:49:20.79,0:49:22.37,Default,,0,0,0,,Осы қарқынмен жаһандық масштабта —
Dialogue: 0,0:49:22.50,0:49:24.79,Default,,0,0,0,,Жан түршігерлік апат күтілуде
Dialogue: 0,0:49:24.92,0:49:27.58,Default,,0,0,0,,Жапонияда да арнайы жұмыс тобы құрылды...
Dialogue: 0,0:49:28.13,0:49:30.88,Default,,0,0,0,,Әкем де жақында үйге келеді деп үміттенемін.
Dialogue: 0,0:49:31.00,0:49:32.05,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:49:33.63,0:49:34.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:34.72,0:49:37.39,Default,,0,0,0,,Уау! Эй!
Dialogue: 0,0:49:37.55,0:49:39.81,Default,,0,0,0,,А, мен өлемін деп ойладым...
Dialogue: 0,0:49:39.93,0:49:42.35,Default,,0,0,0,,Бұл... бұл дүниенің ақыры келеді.
Dialogue: 0,0:49:42.47,0:49:45.69,Default,,0,0,0,,Дұрыс, ақырзаман...
Dialogue: 0,0:49:45.81,0:49:48.31,Default,,0,0,0,,Мақай жұлдызы жақындап қалды.
Dialogue: 0,0:49:48.44,0:49:49.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:54.40,0:49:55.40,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:49:55.95,0:49:57.32,Default,,0,0,0,,Қош келдіңіз (есік жабылған дыбыс)
Dialogue: 0,0:49:57.57,0:49:58.95,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:49:59.07,0:50:01.20,Default,,0,0,0,,Таңғажайып нәрсе болды.
Dialogue: 0,0:50:01.33,0:50:02.29,Default,,0,0,0,,Иә
Dialogue: 0,0:50:02.62,0:50:02.83,Default,,0,0,0,,Мақай жұлдызы қаншалықты жақын?
Dialogue: 0,0:50:02.83,0:50:05.50,Default,,0,0,0,,Мақай жұлдызы қаншалықты жақын?
Dialogue: 0,0:50:02.83,0:50:05.50,Default,,0,0,0,,Чу Чу…
Dialogue: 0,0:50:06.00,0:50:08.33,Default,,0,0,0,,Чу Чу!
Dialogue: 0,0:50:08.79,0:50:11.75,Default,,0,0,0,,Ірі жер сілкінісі Үлкен тайфун
Dialogue: 0,0:50:11.88,0:50:14.42,Default,,0,0,0,,және ақырзаман
Dialogue: 0,0:50:14.55,0:50:15.55,Default,,0,0,0,,Иә...
Dialogue: 0,0:50:15.67,0:50:18.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:18.51,0:50:20.18,Default,,0,0,0,,... Нобита Nobi жедел жеткізу.
Dialogue: 0,0:50:20.30,0:50:22.47,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:50:25.10,0:50:26.60,Default,,0,0,0,,Сіз...
Dialogue: 0,0:50:26.77,0:50:28.98,Default,,0,0,0,,Чу Чу Чу Чу!
Dialogue: 0,0:50:29.10,0:50:31.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:32.07,0:50:33.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:33.48,0:50:36.28,Default,,0,0,0,,Чу Чу Чу Чу!
Dialogue: 0,0:50:36.45,0:50:39.03,Default,,0,0,0,,Уау! Апыр-ай! Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:50:41.16,0:50:43.03,Default,,0,0,0,,Иә? (Дораэмонның қорқынышты дауысы)
Dialogue: 0,0:50:43.20,0:50:46.87,Default,,0,0,0,,Хэхехе! Жындар бұршақтардың сыртында! Жын шықты!
Dialogue: 0,0:50:47.25,0:50:48.00,Default,,0,0,0,,Чуу!
Dialogue: 0,0:50:49.00,0:50:51.08,Default,,0,0,0,,Чу... Чу!
Dialogue: 0,0:50:52.04,0:50:53.75,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:50:53.88,0:50:55.13,Default,,0,0,0,,Басқа тышқан?
Dialogue: 0,0:50:55.26,0:50:57.88,Default,,0,0,0,,Қарғыс айту керек
Dialogue: 0,0:51:00.30,0:51:02.97,Default,,0,0,0,,А, бұл Реверенд Мангецудың ескі құжаты.
Dialogue: 0,0:51:03.10,0:51:04.77,Default,,0,0,0,,Миякодан?
Dialogue: 0,0:51:04.89,0:51:06.39,Default,,0,0,0,,Хат...
Dialogue: 0,0:51:07.02,0:51:08.85,Default,,0,0,0,,``Егер маған бірдеңе болса...''
Dialogue: 0,0:51:08.98,0:51:10.94,Default,,0,0,0,,〝Мұны пайдаланыңыз.〞
Dialogue: 0,0:51:11.06,0:51:13.36,Default,,0,0,0,,〝Сізді соңына дейін мазалағаным үшін кешіріңіз.〞
Dialogue: 0,0:51:13.86,0:51:15.07,Default,,0,0,0,,«Мияко»
Dialogue: 0,0:51:15.23,0:51:19.91,Default,,0,0,0,,Мақай Рюкеңді іздеп жалғыз бардым.
Dialogue: 0,0:51:21.03,0:51:22.49,Default,,0,0,0,,Мияко-сан...
Dialogue: 0,0:51:23.07,0:51:24.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:24.95,0:51:25.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:51:26.37,0:51:29.41,Default,,0,0,0,,Дораемон, біз де кеттік
Dialogue: 0,0:51:29.71,0:51:30.83,Default,,0,0,0,,Иә
Dialogue: 0,0:51:31.29,0:51:32.92,Default,,0,0,0,,Біз де барамыз.
Dialogue: 0,0:51:34.00,0:51:35.17,Default,,0,0,0,,Джиан? Сунео!
Dialogue: 0,0:51:36.42,0:51:39.47,Default,,0,0,0,,Хахаха, мен шештім.
Dialogue: 0,0:51:39.59,0:51:42.18,Default,,0,0,0,,Менің барғым келмейді, бірақ...
Dialogue: 0,0:51:42.30,0:51:45.14,Default,,0,0,0,,Мақай жұлдызының келуін күтудің орнына —
Dialogue: 0,0:51:45.26,0:51:47.02,Default,,0,0,0,,Осы жерден бастайық...
Dialogue: 0,0:51:47.14,0:51:50.06,Default,,0,0,0,,Сунео, ол еркек хахаха...
Dialogue: 0,0:51:50.19,0:51:51.98,Default,,0,0,0,,Оны артта қалдырмаңыз!
Dialogue: 0,0:51:52.56,0:51:54.06,Default,,0,0,0,,Шизука-чан! Ахх
Dialogue: 0,0:51:54.40,0:51:56.40,Default,,0,0,0,,А, мені ұста!
Dialogue: 0,0:51:56.53,0:51:58.03,Default,,0,0,0,,Арх, аа... аа!
Dialogue: 0,0:51:58.15,0:51:59.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:59.69,0:52:00.53,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:52:00.65,0:52:01.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:01.74,0:52:04.37,Default,,0,0,0,,Бұл жай ғана кедергі болуы мүмкін, бірақ...
Dialogue: 0,0:52:04.49,0:52:08.04,Default,,0,0,0,,Мен бір орында отыра алмаймын ғой!
Dialogue: 0,0:52:08.33,0:52:09.20,Default,,0,0,0,,Ах
Dialogue: 0,0:52:09.33,0:52:10.66,Default,,0,0,0,,Иә
Dialogue: 0,0:52:10.79,0:52:13.54,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:52:14.50,0:52:18.51,Default,,0,0,0,,Жарайды, егер сіз мұны шешсеңіз, сиқырлы қалпақты пайдаланыңыз!
Dialogue: 0,0:52:18.63,0:52:21.55,Default,,0,0,0,,Керемет! Кез келген сиқырды қолдануға болатын қалпақ?
Dialogue: 0,0:52:21.68,0:52:23.76,Default,,0,0,0,,Жоқ, жай ғана безендіру.
Dialogue: 0,0:52:23.89,0:52:24.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:25.01,0:52:26.93,Default,,0,0,0,,Ал, бұл көңіл-күй мәселесі.
Dialogue: 0,0:52:28.14,0:52:29.68,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:52:30.06,0:52:33.10,Default,,0,0,0,,Мен кенеттен Мияконың кілеміне секіріп, оны таң қалдырамын.
Dialogue: 0,0:52:33.23,0:52:35.90,Default,,0,0,0,,(4 адам қолдайды)
Dialogue: 0,0:52:36.02,0:52:38.36,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:52:39.03,0:52:40.99,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:52:41.11,0:52:41.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:52:45.62,0:52:46.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:48.95,0:52:49.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:50.04,0:52:52.08,Default,,0,0,0,,Арғх, арғх, хун!
Dialogue: 0,0:52:52.21,0:52:55.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:58.38,0:53:00.09,Default,,0,0,0,,үшін келді ме?
Dialogue: 0,0:53:00.21,0:53:02.72,Default,,0,0,0,,Ол келмеді!
Dialogue: 0,0:53:02.97,0:53:05.43,Default,,0,0,0,,Уф, жібер, жібер... (Нобита) Мүмкін емес, мүмкін емес, мүмкін емес...
Dialogue: 0,0:53:05.55,0:53:07.26,Default,,0,0,0,,Ах, Сунео, ашуланба...
Dialogue: 0,0:53:07.39,0:53:08.31,Default,,0,0,0,,Ой, не...
Dialogue: 0,0:53:08.43,0:53:11.02,Default,,0,0,0,,Ммм!
Dialogue: 0,0:53:12.18,0:53:14.35,Default,,0,0,0,,Үңгірді тапқанша ұстаңыз
Dialogue: 0,0:53:14.48,0:53:15.69,Default,,0,0,0,,Үңгір?
Dialogue: 0,0:53:15.81,0:53:17.56,Default,,0,0,0,,Жындар әлемі курсы солардың қатарында.
Dialogue: 0,0:53:17.69,0:53:20.48,Default,,0,0,0,,Жындардың кіруіне жол бермеу үшін тосқауыл орнатылған.
Dialogue: 0,0:53:21.23,0:53:24.99,Default,,0,0,0,,Бұл жақын жерде, бірақ қар көп, сондықтан қай жерде екенін білмеймін...
Dialogue: 0,0:53:26.45,0:53:27.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:53:29.58,0:53:32.75,Default,,0,0,0,,Уф... Хирари плащы! Әуе зеңбірегі!
Dialogue: 0,0:53:33.29,0:53:34.87,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:53:35.17,0:53:35.96,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:53:36.08,0:53:36.75,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:53:37.46,0:53:38.71,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:53:39.88,0:53:40.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:41.42,0:53:42.84,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:53:48.30,0:53:48.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:57.31,0:53:59.73,Default,,0,0,0,,(айқай)
Dialogue: 0,0:54:00.57,0:54:01.23,Default,,0,0,0,,Міне!
Dialogue: 0,0:54:03.03,0:54:05.24,Default,,0,0,0,,Мына үңгірге қараңдар!
Dialogue: 0,0:54:05.74,0:54:06.49,Default,,0,0,0,,(Тілді екі жұлдызды басу)
Dialogue: 0,0:54:07.16,0:54:10.45,Default,,0,0,0,,Мен шабуылды тоқтатып жатқанда, маған жындар әлеміне экскурсия беріңіз.
Dialogue: 0,0:54:10.58,0:54:11.83,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:54:11.95,0:54:14.00,Default,,0,0,0,,Сіз мұны жалғыз жасай алмайсыз. Мен де саған көмектесемін.
Dialogue: 0,0:54:14.29,0:54:15.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:54:17.29,0:54:19.21,Default,,0,0,0,,Шизука-чан, мені ұста!
Dialogue: 0,0:54:19.33,0:54:20.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:54:22.59,0:54:23.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:27.59,0:54:28.76,Default,,0,0,0,,Дораа!
Dialogue: 0,0:54:28.89,0:54:30.01,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:54:30.76,0:54:32.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:37.56,0:54:38.69,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:55:02.17,0:55:04.25,Default,,0,0,0,,Уау... (Сунео) А...
Dialogue: 0,0:55:06.76,0:55:07.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:15.89,0:55:19.44,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:55:19.98,0:55:21.94,Default,,0,0,0,,Хмм, Чинкарахой!
Dialogue: 0,0:55:22.23,0:55:25.94,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:55:26.15,0:55:27.74,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,0:55:27.94,0:55:31.70,Default,,0,0,0,,Хмф, бұл... бұл ауыр...
Dialogue: 0,0:55:31.87,0:55:35.74,Default,,0,0,0,,Жарайды, Чинкара... Хуэй!
Dialogue: 0,0:55:37.04,0:55:39.75,Default,,0,0,0,,Әй, Нобита-сан! (Нобита және басқалар) Уау!
Dialogue: 0,0:55:39.87,0:55:41.25,Default,,0,0,0,,Керемет! Керемет емес!
Dialogue: 0,0:55:41.54,0:55:43.13,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:55:45.13,0:55:46.25,Default,,0,0,0,,Уау...
Dialogue: 0,0:55:47.67,0:55:49.26,Default,,0,0,0,,Зуко
Dialogue: 0,0:55:49.92,0:55:51.68,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:55:51.80,0:55:54.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:55.39,0:55:58.14,Default,,0,0,0,,Иә? А... не болды?
Dialogue: 0,0:56:02.06,0:56:04.15,Default,,0,0,0,,Сіз бас тарттыңыз ба?
Dialogue: 0,0:56:05.86,0:56:07.65,Default,,0,0,0,,Айтуынша, сол шайқас нағыз қанды қырғын болған екен.
Dialogue: 0,0:56:15.45,0:56:16.91,Default,,0,0,0,,үшінна!
Dialogue: 0,0:56:17.16,0:56:19.87,Default,,0,0,0,,Дораемон! Жақсы болды.
Dialogue: 0,0:56:20.29,0:56:21.62,Default,,0,0,0,,Жындар туралы не деуге болады?
Dialogue: 0,0:56:21.75,0:56:24.25,Default,,0,0,0,,Ол кенет жоғалып кетті
Dialogue: 0,0:56:24.38,0:56:26.54,Default,,0,0,0,,Жын дүниесінен қорқып қашып кеткеніңізге сенімдімін.
Dialogue: 0,0:56:26.67,0:56:27.67,Default,,0,0,0,,Хаха
Dialogue: 0,0:56:27.80,0:56:29.59,Default,,0,0,0,,Жындар әлемі ше?
Dialogue: 0,0:56:29.71,0:56:31.38,Default,,0,0,0,,Хехехе
Dialogue: 0,0:56:31.51,0:56:33.47,Default,,0,0,0,,Хмм, уау...
Dialogue: 0,0:56:35.51,0:56:38.18,Default,,0,0,0,,Жақсы, мен түсіндім.
Dialogue: 0,0:56:38.52,0:56:40.68,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:56:43.10,0:56:44.52,Default,,0,0,0,,Хехе...
Dialogue: 0,0:56:45.61,0:56:48.19,Default,,0,0,0,,Мен жындар әлемі курсын алғаныма сенімдімін.
Dialogue: 0,0:56:48.82,0:56:50.94,Default,,0,0,0,,Ми... Мияко-сан?
Dialogue: 0,0:56:51.24,0:56:53.99,Default,,0,0,0,,Біз бұл заттардан құтылуымыз керек.
Dialogue: 0,0:56:54.16,0:56:56.49,Default,,0,0,0,,Бұл бізге қиындық туғызады.
Dialogue: 0,0:56:56.91,0:56:59.29,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:56:59.41,0:57:01.58,Default,,0,0,0,,Бұл Мияко-сан емес, солай ма?
Dialogue: 0,0:57:01.70,0:57:04.62,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:57:04.75,0:57:07.29,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:57:07.42,0:57:09.92,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:57:10.05,0:57:13.22,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:57:13.72,0:57:15.51,Default,,0,0,0,,А... жындар! ?
Dialogue: 0,0:57:15.64,0:57:19.72,Default,,0,0,0,,Себебі... Маған жындар шабуыл жасады...
Dialogue: 0,0:57:20.43,0:57:24.14,Default,,0,0,0,,Хехе... ақымақ адамдар.
Dialogue: 0,0:57:24.69,0:57:26.77,Default,,0,0,0,,Бұл пьеса болды!
Dialogue: 0,0:57:26.94,0:57:31.61,Default,,0,0,0,,Түсіндім, жындар үңгірдегі бөгетке кіре алмайды...
Dialogue: 0,0:57:31.73,0:57:34.20,Default,,0,0,0,,Сонымен... сондықтан олар бізді пайдаланды...
Dialogue: 0,0:57:34.32,0:57:36.99,Default,,0,0,0,,Қарғыс атсын, Мияко-санды не істедің?
Dialogue: 0,0:57:37.12,0:57:39.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:39.49,0:57:42.87,Default,,0,0,0,,Өліп бара жатқандар білудің қажеті жоқ!
Dialogue: 0,0:57:43.08,0:57:44.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:46.96,0:57:50.38,Default,,0,0,0,,Хахаха... Хахаха...
Dialogue: 0,0:57:50.80,0:57:52.71,Default,,0,0,0,,Аһ!
Dialogue: 0,0:57:52.84,0:57:53.84,Default,,0,0,0,,Жоқ... (үшін) Уау!
Dialogue: 0,0:57:56.51,0:58:00.18,Default,,0,0,0,,(Медюсаның күлкісі)
Dialogue: 0,0:58:00.31,0:58:01.35,Default,,0,0,0,,Муги!
Dialogue: 0,0:58:22.54,0:58:24.33,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:58:24.45,0:58:27.67,Default,,0,0,0,,O… Барлық маусымдық белгі…
Dialogue: 0,0:58:27.83,0:58:28.92,Default,,0,0,0,,Жаз…
Dialogue: 0,0:58:31.29,0:58:34.09,Default,,0,0,0,,Эйхой нуу...
Dialogue: 0,0:58:34.67,0:58:36.09,Default,,0,0,0,,Барлық маусымдық белгі
Dialogue: 0,0:58:36.42,0:58:37.80,Default,,0,0,0,,Жаз (4 адам) Ух...
Dialogue: 0,0:58:37.93,0:58:40.09,Default,,0,0,0,,Уф! Ауыр...
Dialogue: 0,0:58:40.76,0:58:43.60,Default,,0,0,0,,(Нобита мен оның достарының әбігері)
Dialogue: 0,0:58:43.85,0:58:46.60,Default,,0,0,0,,Қарғыс атсын, шайтан мені алдады.
Dialogue: 0,0:58:47.06,0:58:50.27,Default,,0,0,0,,күрсініп... Макай Рёкуджоны алып кетті.
Dialogue: 0,0:58:50.40,0:58:53.15,Default,,0,0,0,,Ібіліс Мияко кейпінде.
Dialogue: 0,0:58:53.27,0:58:58.40,Default,,0,0,0,,Әй, сіз жаңа ғана алдыңыз.
Dialogue: 0,0:58:59.07,0:58:59.82,Default,,0,0,0,,Хен
Dialogue: 0,0:59:00.07,0:59:00.99,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:59:01.12,0:59:04.70,Default,,0,0,0,,Міне, біреуі мұнда, бірі мұнда.
Dialogue: 0,0:59:04.83,0:59:06.33,Default,,0,0,0,,Сонда екеуі болды ма?
Dialogue: 0,0:59:06.45,0:59:07.75,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:59:07.87,0:59:09.00,Default,,0,0,0,,Не?
Dialogue: 0,0:59:09.12,0:59:11.71,Default,,0,0,0,,Сонда сіз оның жартысын алдыңыз ба?
Dialogue: 0,0:59:11.83,0:59:13.38,Default,,0,0,0,,Бірақ... иә?
Dialogue: 0,0:59:14.50,0:59:16.76,Default,,0,0,0,,Жартысын ала алсаң да...
Dialogue: 0,0:59:16.88,0:59:19.13,Default,,0,0,0,,Мен Миякоға не болды деп ойлаймын...
Dialogue: 0,0:59:16.88,0:59:19.13,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:59:19.26,0:59:20.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:20.13,0:59:21.47,Default,,0,0,0,,Чу Чу (терезені қағып)
Dialogue: 0,0:59:21.59,0:59:23.89,Default,,0,0,0,,Угггххх...
Dialogue: 0,0:59:24.14,0:59:25.43,Default,,0,0,0,,Чу Чу! (Сунео) Не?
Dialogue: 0,0:59:25.56,0:59:26.64,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:59:26.85,0:59:29.14,Default,,0,0,0,,Біраз... (Нобита) А? Тағы да егеуқұйрық?
Dialogue: 0,0:59:30.19,0:59:32.40,Default,,0,0,0,,Бұл біртүрлі. Кешеден бері жүріп жатыр.
Dialogue: 0,0:59:32.52,0:59:34.19,Default,,0,0,0,,Бұл тышқанның қарғысы!
Dialogue: 0,0:59:34.32,0:59:35.65,Default,,0,0,0,,Біртүрлі егеуқұйрық
Dialogue: 0,0:59:35.90,0:59:37.32,Default,,0,0,0,,Мен жағалымын.
Dialogue: 0,0:59:35.90,0:59:37.32,Default,,0,0,0,,Чу Чу Чу…
Dialogue: 0,0:59:37.32,0:59:37.44,Default,,0,0,0,,Чу Чу Чу…
Dialogue: 0,0:59:37.44,0:59:38.82,Default,,0,0,0,,Чу Чу Чу…
Dialogue: 0,0:59:37.44,0:59:38.82,Default,,0,0,0,,Біреудің үй жануары ма деп ойлаймын.
Dialogue: 0,0:59:38.95,0:59:40.36,Default,,0,0,0,,Мүлдем, мүлде, мүмкін емес, мүмкін емес
Dialogue: 0,0:59:40.49,0:59:43.37,Default,,0,0,0,,Жарайды, тезірек бірдеңе істе!
Dialogue: 0,0:59:44.37,0:59:45.41,Default,,0,0,0,,Уау...
Dialogue: 0,0:59:45.70,0:59:47.41,Default,,0,0,0,,(егеуқұйрықтың айқайы)
Dialogue: 0,0:59:50.21,0:59:51.92,Default,,0,0,0,,Ух...чу!
Dialogue: 0,0:59:52.29,0:59:53.42,Default,,0,0,0,,Чу?
Dialogue: 0,0:59:55.17,0:59:56.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:58.05,1:00:00.38,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:00:00.51,1:00:01.88,Default,,0,0,0,,А... жарайды ма?
Dialogue: 0,1:00:11.23,1:00:12.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:13.52,1:00:15.36,Default,,0,0,0,,Ми... Мияко! ?
Dialogue: 0,1:00:15.77,1:00:17.86,Default,,0,0,0,,А... (4 адам) Мияко-сан!
Dialogue: 0,1:00:18.19,1:00:20.49,Default,,0,0,0,,Ал...
Dialogue: 0,1:00:21.61,1:00:23.11,Default,,0,0,0,,Неліктен егеуқұйрық?
Dialogue: 0,1:00:23.24,1:00:25.37,Default,,0,0,0,,Шіркеуге шайтан шабуыл жасады.
Dialogue: 0,1:00:26.03,1:00:29.50,Default,,0,0,0,,Әкем мені қашып құтылуға мүмкіндік берді.
Dialogue: 0,1:00:30.04,1:00:33.88,Default,,0,0,0,,Ақыры шайтан мені тауып, түрімді өзгертті.
Dialogue: 0,1:00:34.63,1:00:37.80,Default,,0,0,0,,Әкемді жын әлем жұлдызы алып кетті
Dialogue: 0,1:00:38.00,1:00:40.84,Default,,0,0,0,,Мен... Мен ештеңе істей алмадым.
Dialogue: 0,1:00:41.17,1:00:43.84,Default,,0,0,0,,Ах... (Мияко жылайды)
Dialogue: 0,1:00:44.18,1:00:47.10,Default,,0,0,0,,Хмм... мм
Dialogue: 0,1:00:47.22,1:00:50.06,Default,,0,0,0,,Иә, иә!
Dialogue: 0,1:00:50.98,1:00:55.02,Default,,0,0,0,,Мияко-сан, жылама, пастор Мангецуға көмектесейік.
Dialogue: 0,1:00:55.15,1:00:55.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:56.06,1:00:58.82,Default,,0,0,0,,Мақай жұлдызына бірге барамыз.
Dialogue: 0,1:00:58.94,1:01:00.07,Default,,0,0,0,,Жындар жарысы...
Dialogue: 0,1:01:00.19,1:01:03.11,Default,,0,0,0,,Біз сені ұшырып жібереміз, хаха.
Dialogue: 0,1:01:04.03,1:01:07.12,Default,,0,0,0,,Шынымен бе? Менімен барасың ба?
Dialogue: 0,1:01:07.24,1:01:08.41,Default,,0,0,0,,Иә
Dialogue: 0,1:01:08.74,1:01:11.70,Default,,0,0,0,,Аа, дұрыс, мен де Макай Рёкухо алдым.
Dialogue: 0,1:01:11.83,1:01:14.17,Default,,0,0,0,,Не? (Сунео) Оның жартысы ғана.
Dialogue: 0,1:01:14.29,1:01:15.38,Default,,0,0,0,,О, керемет!
Dialogue: 0,1:01:15.75,1:01:20.13,Default,,0,0,0,,Біз бәріміз жерді жындардан қорғауды шештік.
Dialogue: 0,1:01:20.25,1:01:22.92,Default,,0,0,0,,Мен Пастор Мангецуды да міндетті түрде құтқарамын.
Dialogue: 0,1:01:23.05,1:01:24.13,Default,,0,0,0,,Иә
Dialogue: 0,1:01:24.68,1:01:28.35,Default,,0,0,0,,үшінңызға рахмет Рахмет
Dialogue: 0,1:01:28.47,1:01:29.14,Default,,0,0,0,,Иә
Dialogue: 0,1:01:31.85,1:01:33.31,Default,,0,0,0,,Ах (Мияко) Чу
Dialogue: 0,1:01:33.52,1:01:37.65,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,1:01:38.69,1:01:41.78,Default,,0,0,0,,Дораемон Дораемон оян!
Dialogue: 0,1:01:41.90,1:01:43.78,Default,,0,0,0,,Ммм... (Нобита) Эй, эй!
Dialogue: 0,1:01:43.90,1:01:45.28,Default,,0,0,0,,Тінтуір!
Dialogue: 0,1:01:45.99,1:01:49.83,Default,,0,0,0,,Жарайды, қазір бәріміз сиқырлаймыз.
Dialogue: 0,1:01:50.41,1:01:50.62,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,1:01:50.62,1:01:52.41,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,1:01:50.62,1:01:52.41,Default,,0,0,0,,Трансформация сиқырын бұзу мүмкін болмаса да—
Dialogue: 0,1:01:52.54,1:01:52.83,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан келген басқа сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:52.83,1:01:54.46,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан келген басқа да сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:52.83,1:01:54.46,Default,,0,0,0,,Жоқ, сіз мұны істей алмайсыз.
Dialogue: 0,1:01:54.46,1:01:54.58,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан басқа бір сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:54.58,1:01:56.58,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан басқа бір сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:54.58,1:01:56.58,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,1:01:56.58,1:01:56.71,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан келген басқа сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:56.71,1:01:57.17,Default,,0,0,0,,Мен сырт келбетімді сәл өзгерту үшін жоғарыдан келген басқа сиқырды қолдана аламын деп ойладым.
Dialogue: 0,1:01:56.71,1:01:57.17,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:01:57.17,1:01:57.67,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:01:57.67,1:01:58.88,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:01:57.67,1:01:58.88,Default,,0,0,0,,А-а... Мен үйге бара жатырмын.
Dialogue: 0,1:01:58.88,1:02:01.09,Default,,0,0,0,,А-а... Мен үйге бара жатырмын.
Dialogue: 0,1:02:01.21,1:02:04.17,Default,,0,0,0,,Жарайды, бірте-бірте жақсарып келеді.
Dialogue: 0,1:02:04.30,1:02:05.97,Default,,0,0,0,,Сен бәрібір егеуқұйрық сияқтысың!
Dialogue: 0,1:02:06.09,1:02:08.93,Default,,0,0,0,,Олай етпегендер де болды.
Dialogue: 0,1:02:09.05,1:02:11.64,Default,,0,0,0,,Орындалды! Хаха мен жасадым
Dialogue: 0,1:02:12.06,1:02:13.98,Default,,0,0,0,,Хехе…
Dialogue: 0,1:02:14.10,1:02:15.94,Default,,0,0,0,,Я~
Dialogue: 0,1:02:16.94,1:02:18.15,Default,,0,0,0,,Мияу?
Dialogue: 0,1:02:18.31,1:02:19.81,Default,,0,0,0,,Уау...
Dialogue: 0,1:02:19.94,1:02:21.65,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,1:02:22.02,1:02:24.57,Default,,0,0,0,,Мияу мияу?
Dialogue: 0,1:02:24.86,1:02:26.36,Default,,0,0,0,,Мияу Мияу
Dialogue: 0,1:02:26.57,1:02:28.32,Default,,0,0,0,,Ахан Жоқ...
Dialogue: 0,1:02:28.45,1:02:29.32,Default,,0,0,0,,Мияу мияу
Dialogue: 0,1:02:29.45,1:02:33.20,Default,,0,0,0,,А, енді жоқ... Гуфф
Dialogue: 0,1:02:33.33,1:02:37.00,Default,,0,0,0,,Жарайды, тезірек маған конняку алып кел.
Dialogue: 0,1:02:37.12,1:02:38.88,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,1:02:39.25,1:02:40.04,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:02:40.54,1:02:42.38,Default,,0,0,0,,Сонымен, бәрің, дайынсыңдар ма?
Dialogue: 0,1:02:42.50,1:02:43.76,Default,,0,0,0,,О!
Dialogue: 0,1:02:43.88,1:02:45.34,Default,,0,0,0,,Енді Мақай жұлдызына
Dialogue: 0,1:02:51.10,1:02:53.68,Default,,0,0,0,,Кету! (Нобита және басқалар) О!
Dialogue: 0,1:02:54.31,1:02:55.18,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:03:04.32,1:03:05.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:05.19,1:03:08.53,Default,,0,0,0,,Өйткені, ай сәулесі түскенде сиқырды бұзуға болады.
Dialogue: 0,1:03:08.65,1:03:09.41,Default,,0,0,0,,Иә
Dialogue: 0,1:03:14.20,1:03:16.33,Default,,0,0,0,,Бұлт жұтқан
Dialogue: 0,1:03:21.50,1:03:24.67,Default,,0,0,0,,Біз Мақай жұлдызының жақындауын тоқтатуымыз керек.
Dialogue: 0,1:03:29.76,1:03:30.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:32.22,1:03:34.26,Default,,0,0,0,,А, мен қайтып келдім. Ахах.
Dialogue: 0,1:03:34.39,1:03:37.23,Default,,0,0,0,,Шайтанды жеңсең, сиқыр бұзылады.
Dialogue: 0,1:03:37.35,1:03:41.60,Default,,0,0,0,,Неліктен ай сәулесі түскенде шайтанның сиқыры бұзылады?
Dialogue: 0,1:03:41.73,1:03:44.73,Default,,0,0,0,,Ай сәулесінің шайтанның сиқырын өшіретін күші бар.
Dialogue: 0,1:03:44.86,1:03:45.90,Default,,0,0,0,,Иә
Dialogue: 0,1:03:46.90,1:03:49.61,Default,,0,0,0,,Ай әрқашан жерді айналады, солай ма?
Dialogue: 0,1:03:49.74,1:03:50.40,Default,,0,0,0,,Иә
Dialogue: 0,1:03:50.53,1:03:52.57,Default,,0,0,0,,Мақай шежіресін жазған Нарниад...
Dialogue: 0,1:03:52.70,1:03:56.20,Default,,0,0,0,,Олар жерді қорғау үшін ай сәулесіне қуат берді.
Dialogue: 0,1:03:56.33,1:03:57.62,Default,,0,0,0,,Әй, дұрыс!
Dialogue: 0,1:03:57.75,1:03:58.41,Default,,0,0,0,,Әй?
Dialogue: 0,1:03:58.54,1:04:00.12,Default,,0,0,0,,Ай сәулесі!
Dialogue: 0,1:04:00.25,1:04:02.92,Default,,0,0,0,,Өйткені бұл жарық ай сәулесімен бірдей...
Dialogue: 0,1:04:03.04,1:04:06.25,Default,,0,0,0,,Жындармен күрескенде мұның болғаны жақсы.
Dialogue: 0,1:04:06.38,1:04:10.09,Default,,0,0,0,,Бұл шын мәнінде қасқырға айналу үшін жарық.
Dialogue: 0,1:04:10.22,1:04:11.72,Default,,0,0,0,,Қасқырға айналып бара жатырсың ба?
Dialogue: 0,1:04:11.84,1:04:14.01,Default,,0,0,0,,Бұл егеуқұйрық болғаннан жақсы.
Dialogue: 0,1:04:14.14,1:04:14.97,Default,,0,0,0,,(Сунео мен оның достарының күлкісі)
Dialogue: 0,1:04:15.10,1:04:18.35,Default,,0,0,0,,Дора-чан шынымен де жұмбақ сиқырды қолданады, солай ма?
Dialogue: 0,1:04:18.47,1:04:20.94,Default,,0,0,0,,Олай емес.
Dialogue: 0,1:04:21.06,1:04:24.69,Default,,0,0,0,,Расында, бұл ғылымның күшін пайдаланып, болашақтың құралы...
Dialogue: 0,1:04:24.81,1:04:28.48,Default,,0,0,0,,Нобита-кун! Сіз ғылым туралы ырымдарға сенесіз бе?
Dialogue: 0,1:04:28.61,1:04:30.65,Default,,0,0,0,,Жоқ, қазірдің өзінде ахах...
Dialogue: 0,1:04:30.78,1:04:32.49,Default,,0,0,0,,Сәлем? (Нобита) А...
Dialogue: 0,1:04:33.16,1:04:36.78,Default,,0,0,0,,Жүр, қазір жылдамдықты арттырайық, ендеше ішке кір.
Dialogue: 0,1:04:36.91,1:04:38.37,Default,,0,0,0,,Орта?
Dialogue: 0,1:04:39.25,1:04:40.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:41.00,1:04:43.46,Default,,0,0,0,,Кіреберіс тар, бірақ іші кең.
Dialogue: 0,1:04:43.83,1:04:45.00,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,1:04:45.13,1:04:46.88,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,1:04:47.00,1:04:48.84,Default,,0,0,0,,Не болды?
Dialogue: 0,1:04:49.17,1:04:51.92,Default,,0,0,0,,Бұл кеңістік болса да, ауа бар.
Dialogue: 0,1:04:52.05,1:04:53.84,Default,,0,0,0,,Сіз мұны дәл қазір түсіндіңіз бе?
Dialogue: 0,1:04:54.47,1:04:56.26,Default,,0,0,0,,Сәлеметсіз бе, сиқырлы әлемнің ғаламы...
Dialogue: 0,1:04:56.39,1:04:59.56,Default,,0,0,0,,Бұл біздің ғаламнан мүлдем басқаша көрінеді.
Dialogue: 0,1:04:59.68,1:05:01.14,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:05:01.27,1:05:03.06,Default,,0,0,0,,Иә, хехе
Dialogue: 0,1:05:03.19,1:05:05.19,Default,,0,0,0,,Қалай!
Dialogue: 0,1:05:05.31,1:05:07.44,Default,,0,0,0,,Уау хахаха...
Dialogue: 0,1:05:07.57,1:05:09.78,Default,,0,0,0,,Керемет!
Dialogue: 0,1:05:09.90,1:05:12.65,Default,,0,0,0,,Керемет! (Нобита) Әй...
Dialogue: 0,1:05:12.78,1:05:14.91,Default,,0,0,0,,Бұл кілемнің ішінде ме?
Dialogue: 0,1:05:15.03,1:05:17.20,Default,,0,0,0,,Уау, о...
Dialogue: 0,1:05:18.03,1:05:20.95,Default,,0,0,0,,Осы жерден төмен түссеңіз, жеке бөлме де бар.
Dialogue: 0,1:05:21.41,1:05:24.37,Default,,0,0,0,,Мақай жұлдызына жету үшін біраз уақыт кетеді, жақсылап демалыңыз.
Dialogue: 0,1:05:24.79,1:05:26.71,Default,,0,0,0,,Мүмкін душ бар шығар?
Dialogue: 0,1:05:26.83,1:05:29.00,Default,,0,0,0,,Әрине Аха, мен бақыттымын!
Dialogue: 0,1:05:29.13,1:05:30.30,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:05:30.42,1:05:31.51,Default,,0,0,0,,Джиджи Джижи!
Dialogue: 0,1:05:32.21,1:05:33.72,Default,,0,0,0,,(Медюсаның айқайы)
Dialogue: 0,1:05:33.84,1:05:35.76,Default,,0,0,0,,Хаха...
Dialogue: 0,1:05:35.89,1:05:39.35,Default,,0,0,0,,Олар екінші жартысын алды, солай ма?
Dialogue: 0,1:05:39.47,1:05:43.31,Default,,0,0,0,,Бірақ... олар қазір мұздың астында...
Dialogue: 0,1:05:43.52,1:05:45.39,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:05:45.81,1:05:48.73,Default,,0,0,0,,Олар осы жын әлеміне қарай бет алды.
Dialogue: 0,1:05:49.48,1:05:51.69,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,1:05:52.07,1:05:55.91,Default,,0,0,0,,Әдетте сіздің өміріңіз өлі еді, бірақ...
Dialogue: 0,1:05:56.41,1:06:02.37,Default,,0,0,0,,Мақай маршрутының ең маңызды бөлігі осы жартыжылдықта жазылған.
Dialogue: 0,1:06:02.87,1:06:05.92,Default,,0,0,0,,Сен менің өмірімді сақтап қалдың, Медуза.
Dialogue: 0,1:06:06.04,1:06:07.92,Default,,0,0,0,,Ха ха ха
Dialogue: 0,1:06:08.04,1:06:09.54,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,1:06:10.96,1:06:13.30,Default,,0,0,0,,Сіз сенімдісіз бе? Демаон мырза
Dialogue: 0,1:06:13.42,1:06:16.22,Default,,0,0,0,,Медузаны тірі қалдыр
Dialogue: 0,1:06:16.34,1:06:19.22,Default,,0,0,0,,Оның әлі жұмысы бар.
Dialogue: 0,1:06:20.14,1:06:23.77,Default,,0,0,0,,Нарнияның өлімі айдың сиқырын бұзудың жолы бар.
Dialogue: 0,1:06:23.89,1:06:25.64,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,1:06:26.02,1:06:28.60,Default,,0,0,0,,Соңында...
Dialogue: 0,1:06:28.98,1:06:31.32,Default,,0,0,0,,Келесі толық ай түні —
Dialogue: 0,1:06:31.44,1:06:35.70,Default,,0,0,0,,Сонда ғана ол жұлдыз біздікі болады.
Dialogue: 0,1:06:35.82,1:06:39.82,Default,,0,0,0,,Хухаха... хахахаха...
Dialogue: 0,1:06:43.54,1:06:46.08,Default,,0,0,0,,Кілемнің ішінде душ қабылдау мүмкіндігі —
Dialogue: 0,1:06:46.21,1:06:47.37,Default,,0,0,0,,Бұл керемет
Dialogue: 0,1:06:47.50,1:06:51.17,Default,,0,0,0,,Уфуфу Шизука-чан шомылуды жақсы көреді, солай емес пе?
Dialogue: 0,1:06:51.29,1:06:54.46,Default,,0,0,0,,Мен оны жақсы көретінім сонша, күні бойы ішінде отырсам да жалықпаймын.
Dialogue: 0,1:06:54.84,1:06:56.26,Default,,0,0,0,,Бұл оны дымқыл етеді.
Dialogue: 0,1:06:56.38,1:06:59.39,Default,,0,0,0,,Ах (екі адам күледі)
Dialogue: 0,1:06:59.51,1:07:03.68,Default,,0,0,0,,Мен де кішкентай кезімде шашым осындай ұзын болатын.
Dialogue: 0,1:07:03.81,1:07:04.68,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:07:05.27,1:07:06.52,Default,,0,0,0,,Оны неге кесіп тастадың?
Dialogue: 0,1:07:06.64,1:07:07.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:07.77,1:07:09.44,Default,,0,0,0,,А... иә
Dialogue: 0,1:07:10.19,1:07:12.65,Default,,0,0,0,,Менің ойымша, бұл қысқарақ көрінеді...
Dialogue: 0,1:07:12.77,1:07:13.94,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:07:14.28,1:07:18.70,Default,,0,0,0,,Бірақ менің ойымша, Мияко ұзақ уақыт бойы сүйкімді болды.
Dialogue: 0,1:07:18.82,1:07:20.41,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,1:07:20.66,1:07:23.66,Default,,0,0,0,,Менде одан қысқа болған емес.
Dialogue: 0,1:07:23.78,1:07:27.71,Default,,0,0,0,,Кейде ең ұзақ уақытта сәл ұзағырақ болды...
Dialogue: 0,1:07:28.66,1:07:30.83,Default,,0,0,0,,Мия-чанның шашы бұйра.
Dialogue: 0,1:07:30.96,1:07:32.54,Default,,0,0,0,,Сіз кімге ұқсайсыз?
Dialogue: 0,1:07:32.67,1:07:35.05,Default,,0,0,0,,Бұл ана. Эхехе (Мияконың анасы) А?
Dialogue: 0,1:07:36.05,1:07:37.09,Default,,0,0,0,,Иә орындалды
Dialogue: 0,1:07:37.21,1:07:39.38,Default,,0,0,0,,Аха Ахаха Ухуху
Dialogue: 0,1:07:39.51,1:07:41.64,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:07:41.76,1:07:44.72,Default,,0,0,0,,Ахаха ахаха... (Мияконың анасы) О, міне...
Dialogue: 0,1:07:44.85,1:07:46.85,Default,,0,0,0,,Әке, қарашы!
Dialogue: 0,1:07:46.97,1:07:48.77,Default,,0,0,0,,О, бұл сүйкімді
Dialogue: 0,1:07:48.89,1:07:51.02,Default,,0,0,0,,Оны саған анаң берді ме?
Dialogue: 0,1:07:51.15,1:07:54.40,Default,,0,0,0,,Иә, дұрыс. Сүйкімді емес пе?
Dialogue: 0,1:08:00.11,1:08:01.95,Default,,0,0,0,,Мияко-сан...
Dialogue: 0,1:08:03.74,1:08:05.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:11.75,1:08:13.96,Default,,0,0,0,,Бізге ілесіп жүруді қойып, тезірек кетші!
Dialogue: 0,1:08:15.21,1:08:16.17,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:17.59,1:08:19.26,Default,,0,0,0,,Миёко-сан (Мияко) Ха
Dialogue: 0,1:08:22.13,1:08:24.64,Default,,0,0,0,,О, Нобита-сан, не болды?
Dialogue: 0,1:08:24.76,1:08:27.47,Default,,0,0,0,,Білесіз бе, Дораемон - бұл тамақ.
Dialogue: 0,1:08:27.60,1:08:28.35,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:08:28.93,1:08:32.60,Default,,0,0,0,,Бұл керемет. Бұл дәмді үстел ілгіші.
Dialogue: 0,1:08:32.73,1:08:36.32,Default,,0,0,0,,Маған не жегіңіз келетінін айтыңыз, олар сізге қалағаныңызды береді.
Dialogue: 0,1:08:36.52,1:08:40.44,Default,,0,0,0,,Уау, мен өте қуаныштымын. Мен қатты аштым.
Dialogue: 0,1:08:40.57,1:08:42.03,Default,,0,0,0,,Тіке асханаға барыңыз
Dialogue: 0,1:08:42.82,1:08:46.83,Default,,0,0,0,,(Мияконың гуілдеуі)
Dialogue: 0,1:08:50.70,1:08:52.08,Default,,0,0,0,,Миёко-сан
Dialogue: 0,1:08:52.71,1:08:53.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:55.67,1:08:59.09,Default,,0,0,0,,А, көрдің бе, мен бар күшімді саламын.
Dialogue: 0,1:09:00.05,1:09:01.67,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе—
Dialogue: 0,1:09:01.80,1:09:04.55,Default,,0,0,0,,Мен Мияконың әкесіне міндетті түрде көмектесемін.
Dialogue: 0,1:09:05.09,1:09:09.27,Default,,0,0,0,,Мен уәде беремін, сондықтан көңіл-күйіңізді көтеріңіз.
Dialogue: 0,1:09:10.68,1:09:12.35,Default,,0,0,0,,Нобита-сан…
Dialogue: 0,1:09:12.48,1:09:14.69,Default,,0,0,0,,Хехехехе... (Мияко) Хэхехе
Dialogue: 0,1:09:14.81,1:09:15.73,Default,,0,0,0,,Хехе
Dialogue: 0,1:09:16.19,1:09:18.90,Default,,0,0,0,,Рахмет (Нобита) Жоқ...
Dialogue: 0,1:09:19.02,1:09:20.36,Default,,0,0,0,,Мен өзімді жақсы сезінемін!
Dialogue: 0,1:09:20.48,1:09:21.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:23.99,1:09:26.91,Default,,0,0,0,,Эхехе хаха ахаха...
Dialogue: 0,1:09:40.00,1:09:42.05,Default,,0,0,0,,Міне, осында.
Dialogue: 0,1:09:42.17,1:09:44.72,Default,,0,0,0,,Бұл Мақай жұлдызы ма?
Dialogue: 0,1:09:46.01,1:09:48.14,Default,,0,0,0,,Бұл жұлдыздың жақындауын тоқтату үшін —
Dialogue: 0,1:09:48.26,1:09:52.18,Default,,0,0,0,,Бізде жындардың патшасы, Ұлы Жын патшасы Демаонды жеңуден басқа амалымыз жоқ.
Dialogue: 0,1:09:52.93,1:09:56.85,Default,,0,0,0,,Мақай жұлдызын қаптаған қара жалынның бір ғана кіреберісі бар.
Dialogue: 0,1:09:57.02,1:09:59.65,Default,,0,0,0,,Оңтүстік полюсте жалын бар сияқты.
Dialogue: 0,1:09:59.98,1:10:02.94,Default,,0,0,0,,Алайда, егер сіз 10 секунд ішінде өтпесеңіз—
Dialogue: 0,1:10:03.07,1:10:05.11,Default,,0,0,0,,Бәрі де күйіп кетеді
Dialogue: 0,1:10:05.24,1:10:08.07,Default,,0,0,0,,Иә? Бар болғаны 10 секунд?
Dialogue: 0,1:10:08.49,1:10:11.12,Default,,0,0,0,,Бар жылдамдықпен асықсам да уақытында жетемін бе деп ойлаймын...
Dialogue: 0,1:10:11.24,1:10:13.91,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:14.41,1:10:15.58,Default,,0,0,0,,О? Ах...
Dialogue: 0,1:10:16.67,1:10:20.04,Default,,0,0,0,,Бұл отты сызат.
Dialogue: 0,1:10:20.17,1:10:23.55,Default,,0,0,0,,Біз гравитациялық өріске кіріп жатырмыз. үшінңыз, әсерге дайындалыңыз.
Dialogue: 0,1:10:23.67,1:10:24.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:24.72,1:10:27.84,Default,,0,0,0,,Уау... Уа... А!
Dialogue: 0,1:10:29.26,1:10:30.26,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:10:43.73,1:10:46.57,Default,,0,0,0,,Ыстық ыстық...
Dialogue: 0,1:10:46.70,1:10:49.32,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:10:57.79,1:10:59.46,Default,,0,0,0,,Кішкене ғана, бар күшіңді сал
Dialogue: 0,1:11:01.09,1:11:03.13,Default,,0,0,0,,Жоқ, оған тұрарлық емес!
Dialogue: 0,1:11:03.63,1:11:05.01,Default,,0,0,0,,Қашу!
Dialogue: 0,1:11:05.13,1:11:06.05,Default,,0,0,0,,Ол өртеніп кетеді!
Dialogue: 0,1:11:06.17,1:11:08.38,Default,,0,0,0,,Уау, болды... Нобита-кун!
Dialogue: 0,1:11:08.51,1:11:09.93,Default,,0,0,0,,О, ачача...
Dialogue: 0,1:11:10.05,1:11:11.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:17.06,1:11:19.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:20.27,1:11:22.82,Default,,0,0,0,,Тез тығыл, шайтандар келеді.
Dialogue: 0,1:11:22.94,1:11:25.73,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,1:11:26.94,1:11:28.32,Default,,0,0,0,,Ауырды!
Dialogue: 0,1:11:28.45,1:11:29.86,Default,,0,0,0,,А? Йотто
Dialogue: 0,1:11:33.45,1:11:34.58,Default,,0,0,0,,Эй, осында.
Dialogue: 0,1:11:34.70,1:11:35.54,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,1:11:36.62,1:11:37.58,Default,,0,0,0,,суық суық
Dialogue: 0,1:11:37.71,1:11:40.67,Default,,0,0,0,,Дораемон, маған маусымдық белгіңізді көрсетіңіз.
Dialogue: 0,1:11:40.79,1:11:43.96,Default,,0,0,0,,Мұз ерісе, орнымыз ашылады.
Dialogue: 0,1:11:44.63,1:11:46.67,Default,,0,0,0,,А... иә?
Dialogue: 0,1:11:47.26,1:11:51.47,Default,,0,0,0,,Ол толығымен өртенген, бірақ Жерден екені анық.
Dialogue: 0,1:11:51.59,1:11:54.47,Default,,0,0,0,,Жын-шайтан әлеміне мініп, дұшпан
Dialogue: 0,1:11:54.60,1:11:57.14,Default,,0,0,0,,Борттағы адамдар да күйіп кеткен болуы мүмкін.
Dialogue: 0,1:11:57.27,1:11:58.39,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:11:59.14,1:12:01.85,Default,,0,0,0,,Немесе олар ауада қашып кеткен шығар.
Dialogue: 0,1:12:01.98,1:12:03.98,Default,,0,0,0,,Дереу Демаон-самаға хабарлаңыз.
Dialogue: 0,1:12:04.11,1:12:04.77,Default,,0,0,0,,Хаха
Dialogue: 0,1:12:28.17,1:12:31.09,Default,,0,0,0,,Уф... тыңшылық спутник бізді жақсы бақылап жатыр~
Dialogue: 0,1:12:32.18,1:12:34.60,Default,,0,0,0,,Сіз Ұлы Жын патшасының сарайына жетесіз.
Dialogue: 0,1:12:34.72,1:12:37.81,Default,,0,0,0,,Жарайды, мен сенің соңынан еремін.
Dialogue: 0,1:12:43.23,1:12:46.02,Default,,0,0,0,,Немесе… шаш қазірдің өзінде ең нашар.
Dialogue: 0,1:12:46.15,1:12:48.73,Default,,0,0,0,,Аяқ-қолымдағы сезімді жоғалттым.
Dialogue: 0,1:12:48.86,1:12:52.28,Default,,0,0,0,,Уф, мені бірдеңе мазалайды...
Dialogue: 0,1:12:52.40,1:12:54.95,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,1:12:55.07,1:12:58.74,Default,,0,0,0,,Дәл солай жүрегің мұздап, өлесің! Уф...
Dialogue: 0,1:12:59.29,1:13:01.21,Default,,0,0,0,,А... енді жоқ...
Dialogue: 0,1:13:01.54,1:13:02.50,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:13:02.62,1:13:03.67,Default,,0,0,0,,Сунео!
Dialogue: 0,1:13:03.79,1:13:05.17,Default,,0,0,0,,Ұйқысы бар... Джан!
Dialogue: 0,1:13:08.17,1:13:10.96,Default,,0,0,0,,Нобита-кун, ұйықтамау керек!
Dialogue: 0,1:13:10.96,1:13:11.17,Default,,0,0,0,,Уф, Нобита-кун, ұйықтамау керек!
Dialogue: 0,1:13:10.96,1:13:11.17,Default,,0,0,0,,Мықты бол, ұйықтама
Dialogue: 0,1:13:11.17,1:13:11.30,Default,,0,0,0,,Мықты бол, ұйықтама.
Dialogue: 0,1:13:11.30,1:13:13.05,Default,,0,0,0,,Мықты бол, ұйықтама
Dialogue: 0,1:13:11.30,1:13:13.05,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:13:13.05,1:13:13.18,Default,,0,0,0,,Мықты бол, ұйықтама
Dialogue: 0,1:13:13.18,1:13:14.55,Default,,0,0,0,,Мықты бол, ұйықтама
Dialogue: 0,1:13:13.18,1:13:14.55,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,1:13:14.55,1:13:14.84,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,1:13:14.97,1:13:15.09,Default,,0,0,0,,Сен ұйықтай алмайсың дейді!
Dialogue: 0,1:13:15.09,1:13:16.55,Default,,0,0,0,,Сен ұйықтай алмайсың дейді!
Dialogue: 0,1:13:15.09,1:13:16.55,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:13:16.72,1:13:19.18,Default,,0,0,0,,А, өте жылы...
Dialogue: 0,1:13:19.31,1:13:22.02,Default,,0,0,0,,Нобита-кун, оян!
Dialogue: 0,1:13:24.14,1:13:25.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:25.94,1:13:28.77,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,1:13:29.15,1:13:30.65,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:13:30.78,1:13:34.78,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:13:36.28,1:13:38.37,Default,,0,0,0,,Керемет... Иә?
Dialogue: 0,1:13:39.70,1:13:44.00,Default,,0,0,0,,Аздап жаққанда ғана жылы болады.
Dialogue: 0,1:13:45.04,1:13:46.71,Default,,0,0,0,,Сізде бұл қол болды ма?
Dialogue: 0,1:13:46.83,1:13:49.04,Default,,0,0,0,,Мм... күте тұрыңыз.
Dialogue: 0,1:13:49.17,1:13:52.92,Default,,0,0,0,,Суық болған сайын жылы болатын сиқырлы крем
Dialogue: 0,1:13:53.38,1:13:55.63,Default,,0,0,0,,Abekobe кремі!
Dialogue: 0,1:13:56.18,1:13:57.89,Default,,0,0,0,,үшінң, тез бояңдар!
Dialogue: 0,1:13:58.01,1:13:59.64,Default,,0,0,0,,Оян, Нобита-кун!
Dialogue: 0,1:14:00.01,1:14:03.06,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,1:14:03.31,1:14:04.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:04.60,1:14:07.02,Default,,0,0,0,,Ғажайып, бүкіл денем жылы.
Dialogue: 0,1:14:08.11,1:14:10.19,Default,,0,0,0,,Иә? Бұл арман емес еді
Dialogue: 0,1:14:10.36,1:14:11.65,Default,,0,0,0,,Ауырды...
Dialogue: 0,1:14:11.78,1:14:14.11,Default,,0,0,0,,Аздап қысқарту керек.
Dialogue: 0,1:14:14.24,1:14:15.28,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,1:14:15.40,1:14:16.99,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,1:14:17.91,1:14:20.12,Default,,0,0,0,,Жоқ, өте ыстық.
Dialogue: 0,1:14:20.24,1:14:22.95,Default,,0,0,0,,Бұл тым көп. Оны аздап алып тастаңыз.
Dialogue: 0,1:14:25.21,1:14:27.79,Default,,0,0,0,,Қараңдаршы, біз Оңтүстік полюсті басып өтеміз.
Dialogue: 0,1:14:45.39,1:14:49.06,Default,,0,0,0,,Абайлаңыз, бұл жын-перілер мекендейтін құрлық!
Dialogue: 0,1:15:04.54,1:15:06.41,Default,,0,0,0,,Уау
Dialogue: 0,1:15:06.83,1:15:08.46,Default,,0,0,0,,Баспропеллер батареясы!
Dialogue: 0,1:15:08.58,1:15:10.88,Default,,0,0,0,,Уау, менікі де!
Dialogue: 0,1:15:11.04,1:15:13.38,Default,,0,0,0,,Уау, мұнда да! Асығыңыз!
Dialogue: 0,1:15:14.21,1:15:18.22,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,1:15:19.43,1:15:20.34,Default,,0,0,0,,Келді...
Dialogue: 0,1:15:21.85,1:15:23.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:39.24,1:15:41.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:41.28,1:15:43.28,Default,,0,0,0,,Бұл Демаон сарайы ма?
Dialogue: 0,1:15:43.87,1:15:45.79,Default,,0,0,0,,Папаның да сонда болатынына сенімдімін...
Dialogue: 0,1:15:45.91,1:15:49.33,Default,,0,0,0,,Қалай жақындау керек? Айналада құбыжықтар көп.
Dialogue: 0,1:15:49.46,1:15:50.71,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:15:51.58,1:15:53.17,Default,,0,0,0,,Моль қолғаптары!
Dialogue: 0,1:15:53.50,1:15:55.13,Default,,0,0,0,,Уау, о...
Dialogue: 0,1:15:55.46,1:15:57.59,Default,,0,0,0,,Уау...
Dialogue: 0,1:15:58.22,1:15:59.76,Default,,0,0,0,,Жарайды, маған ер!
Dialogue: 0,1:15:59.88,1:16:01.55,Default,,0,0,0,,Оу!
Dialogue: 0,1:16:07.60,1:16:10.02,Default,,0,0,0,,1,5 градус солға түзетіңіз ОК
Dialogue: 0,1:16:16.86,1:16:19.74,Default,,0,0,0,,Табылмады (3 жұлдыз) Оны табу үшін бар күшіңізді салыңыз.
Dialogue: 0,1:16:19.95,1:16:21.03,Default,,0,0,0,,Хаха
Dialogue: 0,1:16:22.91,1:16:25.16,Default,,0,0,0,,Толық жылдамдық!
Dialogue: 0,1:16:25.62,1:16:27.04,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:27.16,1:16:28.70,Default,,0,0,0,,О! (үшін) Ах!
Dialogue: 0,1:16:29.58,1:16:32.12,Default,,0,0,0,,Ой-оу уау
Dialogue: 0,1:16:32.50,1:16:36.80,Default,,0,0,0,,3 градус оңға, ах, 2 градус жоғары, ах, 2 градус солға.
Dialogue: 0,1:16:36.92,1:16:38.09,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,1:16:38.46,1:16:39.76,Default,,0,0,0,,Ммм... (5 адам) Уау!
Dialogue: 0,1:16:39.88,1:16:40.80,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:40.92,1:16:42.51,Default,,0,0,0,,Қазірдің өзінде! Тынш!
Dialogue: 0,1:16:42.63,1:16:44.09,Default,,0,0,0,,Бұл төменде берілген.
Dialogue: 0,1:16:44.22,1:16:45.05,Default,,0,0,0,,Әй?
Dialogue: 0,1:17:08.83,1:17:11.66,Default,,0,0,0,,Жер тұрғындары әлі табылған жоқ
Dialogue: 0,1:17:11.79,1:17:15.25,Default,,0,0,0,,Кілеммен бірге жанып кеткен шығар.
Dialogue: 0,1:17:15.38,1:17:16.79,Default,,0,0,0,,Хехе...
Dialogue: 0,1:17:17.46,1:17:20.38,Default,,0,0,0,,Әлгі жігіттерде аздап сүйек бар.
Dialogue: 0,1:17:20.59,1:17:21.67,Default,,0,0,0,,Ахх...
Dialogue: 0,1:17:21.97,1:17:22.63,Default,,0,0,0,,Хмф!
Dialogue: 0,1:17:23.13,1:17:26.09,Default,,0,0,0,,Уваа
Dialogue: 0,1:17:28.76,1:17:32.52,Default,,0,0,0,,А, у, ко... Бұл не?
Dialogue: 0,1:17:33.02,1:17:35.56,Default,,0,0,0,,Балаңыздың айласын қолданыңыз
Dialogue: 0,1:17:35.69,1:17:37.56,Default,,0,0,0,,Хехе...
Dialogue: 0,1:17:42.49,1:17:44.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:44.32,1:17:47.20,Default,,0,0,0,,Бұл Ұлы Жын патшасы Демаон.
Dialogue: 0,1:17:47.32,1:17:48.49,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:48.62,1:17:49.74,Default,,0,0,0,,(Нобитаның жұтыну дыбысы)
Dialogue: 0,1:17:51.45,1:17:54.67,Default,,0,0,0,,Ұлы жын патша Демаонды жеңудің бір ғана жолы бар.
Dialogue: 0,1:17:54.79,1:17:57.71,Default,,0,0,0,,Осы күміс жебені жүрекке айдау
Dialogue: 0,1:17:58.75,1:18:00.67,Default,,0,0,0,,Олардың әрқайсысында екі бөтелке бар.
Dialogue: 0,1:18:01.38,1:18:03.55,Default,,0,0,0,,А... Аа!
Dialogue: 0,1:18:03.67,1:18:05.63,Default,,0,0,0,,Иә! (2 адам) Иә?
Dialogue: 0,1:18:06.39,1:18:09.60,Default,,0,0,0,,Сонымен қатар ай шамдарын таратайық. Және...
Dialogue: 0,1:18:09.89,1:18:13.56,Default,,0,0,0,,Мортен Жұлдыз! Ұзақ мерзімді және қауіпсіз нұсқасы!
Dialogue: 0,1:18:14.27,1:18:18.31,Default,,0,0,0,,Бұны киген адамның сыртқы түрі басқа адамның соқыр жеріне түседі.
Dialogue: 0,1:18:18.44,1:18:19.44,Default,,0,0,0,,Соқыр нүкте?
Dialogue: 0,1:18:19.56,1:18:23.28,Default,,0,0,0,,Оның мәні басқаларға көрінбейтін болып қалады.
Dialogue: 0,1:18:23.40,1:18:24.82,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:18:24.95,1:18:25.90,Default,,0,0,0,,О~
Dialogue: 0,1:18:26.03,1:18:27.91,Default,,0,0,0,,Уау, ғажап, мені көре аласың ба?
Dialogue: 0,1:18:28.03,1:18:30.74,Default,,0,0,0,,Иә? үшін сонда, солай ма?
Dialogue: 0,1:18:30.87,1:18:33.25,Default,,0,0,0,,Әй, тентек! (Нобита) Уау...
Dialogue: 0,1:18:41.92,1:18:46.76,Default,,0,0,0,,Сақ болыңыз, күдікті ештеңені жіберіп алмаңыз, тіпті бір жәндік болса да.
Dialogue: 0,1:18:48.59,1:18:51.01,Default,,0,0,0,,Уф, жақсы соққы...
Dialogue: 0,1:18:51.14,1:18:52.68,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,1:18:52.97,1:18:56.39,Default,,0,0,0,,Не? Уау...
Dialogue: 0,1:18:56.52,1:18:58.27,Default,,0,0,0,,таудың тереңінде демалыс үйін сатып алу туралы оқиға ше?
Dialogue: 0,1:18:58.40,1:18:59.48,Default,,0,0,0,,Я...
Dialogue: 0,1:18:59.60,1:19:02.19,Default,,0,0,0,,Жарайды, қазір уақыт.
Dialogue: 0,1:19:02.32,1:19:04.74,Default,,0,0,0,,Уф, иә...
Dialogue: 0,1:19:06.49,1:19:08.74,Default,,0,0,0,,Уау, өте кең.
Dialogue: 0,1:19:08.86,1:19:11.07,Default,,0,0,0,,Әйтеуір, Пастор Мангецуды іздейік.
Dialogue: 0,1:19:11.20,1:19:13.49,Default,,0,0,0,,Бірақ бұл қайда?
Dialogue: 0,1:19:13.62,1:19:14.83,Default,,0,0,0,,Уф, күте тұрыңыз!
Dialogue: 0,1:19:14.95,1:19:17.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:17.41,1:19:18.92,Default,,0,0,0,,Иә? Жақсы!
Dialogue: 0,1:19:19.04,1:19:20.79,Default,,0,0,0,,А? а? Тынш!
Dialogue: 0,1:19:21.08,1:19:23.00,Default,,0,0,0,,А? а?
Dialogue: 0,1:19:25.34,1:19:29.26,Default,,0,0,0,,Мен жоғары-төмен жүруден шаршадым.
Dialogue: 0,1:19:29.63,1:19:31.47,Default,,0,0,0,,Пастор Толық ай!
Dialogue: 0,1:19:31.60,1:19:34.06,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,1:19:34.18,1:19:36.22,Default,,0,0,0,,Қайда? (Бір жұлдыз) Иә?
Dialogue: 0,1:19:36.35,1:19:37.31,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:19:37.43,1:19:38.44,Default,,0,0,0,,Осының үстінде...
Dialogue: 0,1:19:38.56,1:19:41.19,Default,,0,0,0,,Рахмет
Dialogue: 0,1:19:42.52,1:19:44.02,Default,,0,0,0,,Сәлем
Dialogue: 0,1:19:44.15,1:19:45.36,Default,,0,0,0,,ше? иә?
Dialogue: 0,1:19:47.74,1:19:50.32,Default,,0,0,0,,Ugg...
Dialogue: 0,1:19:51.57,1:19:53.83,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,1:19:55.04,1:19:56.29,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,1:19:58.62,1:20:01.42,Default,,0,0,0,,Әй, ол адамдарды ұстауға тым кең емес пе?
Dialogue: 0,1:20:01.54,1:20:03.13,Default,,0,0,0,,Ух мм
Dialogue: 0,1:20:03.25,1:20:03.71,Default,,0,0,0,,Сіз Жерлік ретінде осы уақытқа дейін келдіңіз.
Dialogue: 0,1:20:03.71,1:20:06.46,Default,,0,0,0,,Сіз Жерлік сияқты осы уақытқа дейін келдіңіз.
Dialogue: 0,1:20:03.71,1:20:06.46,Default,,0,0,0,,Ууу...
Dialogue: 0,1:20:06.59,1:20:09.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:10.09,1:20:12.43,Default,,0,0,0,,Ахх (Дораэмонның айқайы)
Dialogue: 0,1:20:15.68,1:20:16.85,Default,,0,0,0,,Уау, міне!
Dialogue: 0,1:20:17.31,1:20:19.23,Default,,0,0,0,,Пастор Толық Ай емес!
Dialogue: 0,1:20:19.35,1:20:21.77,Default,,0,0,0,,Неліктен оны көрмейсіз?
Dialogue: 0,1:20:21.90,1:20:25.32,Default,,0,0,0,,Хехехе... Кішкентай амалдар жұмыс істемейді.
Dialogue: 0,1:20:25.69,1:20:27.78,Default,,0,0,0,,үшін өзіңізге байланысты.
Dialogue: 0,1:20:27.90,1:20:29.61,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:20:30.57,1:20:31.91,Default,,0,0,0,,Ұлы жын патша Демаон
Dialogue: 0,1:20:32.03,1:20:34.78,Default,,0,0,0,,Жерді басып алудан бас тартыңыз және кері бұрылыңыз!
Dialogue: 0,1:20:35.33,1:20:38.20,Default,,0,0,0,,Хмм, мен мұны істей алмаймын.
Dialogue: 0,1:20:38.41,1:20:44.17,Default,,0,0,0,,Жер - біз жындар мыңдаған жылдар бойы нысанаға алған олжа.
Dialogue: 0,1:20:44.29,1:20:47.25,Default,,0,0,0,,Бұл жұлдыз тым әдемі, бас тартуға болмайды.
Dialogue: 0,1:20:47.46,1:20:49.46,Default,,0,0,0,,Олай болса, дайындал!
Dialogue: 0,1:20:49.71,1:20:52.72,Default,,0,0,0,,Хехе... хехе...
Dialogue: 0,1:20:53.64,1:20:57.64,Default,,0,0,0,,(Демаонның күлкісі)
Dialogue: 0,1:21:01.69,1:21:03.65,Default,,0,0,0,,Демаон күшейді!
Dialogue: 0,1:21:05.11,1:21:06.90,Default,,0,0,0,,Көбею тек елес!
Dialogue: 0,1:21:07.15,1:21:08.65,Default,,0,0,0,,Уау
Dialogue: 0,1:21:09.19,1:21:11.19,Default,,0,0,0,,Жоқ... (Сунео) Бұл сен бе?
Dialogue: 0,1:21:11.32,1:21:12.70,Default,,0,0,0,,Уф... Бұл жігіт!
Dialogue: 0,1:21:12.78,1:21:14.87,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:21:15.37,1:21:16.45,Default,,0,0,0,,Сәлем! О, жоқ!
Dialogue: 0,1:21:16.53,1:21:17.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:21:17.91,1:21:18.95,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:21:19.08,1:21:21.00,Default,,0,0,0,,Қайсысы нақты?
Dialogue: 0,1:21:21.12,1:21:23.58,Default,,0,0,0,,Балалар, сендердің күштерің соншама?
Dialogue: 0,1:21:23.83,1:21:27.54,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:21:27.92,1:21:31.67,Default,,0,0,0,,Олай болса осы жерден кетейік.
Dialogue: 0,1:21:32.09,1:21:34.97,Default,,0,0,0,,Әй... Анашым...
Dialogue: 0,1:21:35.43,1:21:38.35,Default,,0,0,0,,Ах ха... Түсіндім!
Dialogue: 0,1:21:38.76,1:21:40.64,Default,,0,0,0,,Иә...
Dialogue: 0,1:21:40.81,1:21:42.10,Default,,0,0,0,,Міне!
Dialogue: 0,1:21:42.23,1:21:46.27,Default,,0,0,0,,(Дынның ыңырсыуы)
Dialogue: 0,1:21:47.11,1:21:51.11,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:21:53.32,1:21:55.03,Default,,0,0,0,,О... Иә!
Dialogue: 0,1:21:55.16,1:21:59.16,Default,,0,0,0,,Бұл не жарық... уф...
Dialogue: 0,1:21:59.53,1:22:00.62,Default,,0,0,0,,Қазір!
Dialogue: 0,1:22:01.58,1:22:02.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:22:04.87,1:22:08.08,Default,,0,0,0,,Гуаа!
Dialogue: 0,1:22:08.46,1:22:10.71,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:12.38,1:22:13.05,Default,,0,0,0,,​​О?
Dialogue: 0,1:22:14.09,1:22:16.09,Default,,0,0,0,,Хехе... хахаха...
Dialogue: 0,1:22:16.22,1:22:18.76,Default,,0,0,0,,Ахаха…
Dialogue: 0,1:22:19.30,1:22:20.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:21.26,1:22:23.10,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,1:22:25.56,1:22:27.94,Default,,0,0,0,,Ах... (Мияко) Сен сондай ақымақсың...
Dialogue: 0,1:22:28.06,1:22:29.86,Default,,0,0,0,,Мен дартты ұрсам да...
Dialogue: 0,1:22:30.11,1:22:32.32,Default,,0,0,0,,Ха... хмм...
Dialogue: 0,1:22:32.78,1:22:34.53,Default,,0,0,0,,Иә! (Нобита) Мияко-сан!
Dialogue: 0,1:22:34.69,1:22:36.49,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,1:22:36.66,1:22:37.36,Default,,0,0,0,,Даа!
Dialogue: 0,1:22:39.37,1:22:40.20,Default,,0,0,0,,Хмф! (Мияко) Ах
Dialogue: 0,1:22:40.74,1:22:41.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:42.04,1:22:44.54,Default,,0,0,0,,Қателер!
Dialogue: 0,1:22:44.75,1:22:46.04,Default,,0,0,0,,Мені жебе таңдағанына қарамастан, ол маған тимей, қайта қайтты.
Dialogue: 0,1:22:47.54,1:22:50.54,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:23:01.18,1:23:03.52,Default,,0,0,0,,Осы жолы оларды ұстаңыз.
Dialogue: 0,1:23:03.64,1:23:06.35,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,1:23:07.06,1:23:10.77,Default,,0,0,0,,Абайлаңыз, олар қайтадан жоғалады.
Dialogue: 0,1:23:10.90,1:23:13.78,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:23:15.32,1:23:19.53,Default,,0,0,0,,Нобита-кун Нобита-кун!
Dialogue: 0,1:23:19.86,1:23:22.24,Default,,0,0,0,,Хмм... Нобита-кун!
Dialogue: 0,1:23:22.37,1:23:23.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:24.24,1:23:26.33,Default,,0,0,0,,Тез тығыл! Олар келе жатыр!
Dialogue: 0,1:23:26.45,1:23:27.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:28.29,1:23:30.13,Default,,0,0,0,,Уау, міне!
Dialogue: 0,1:23:30.29,1:23:31.96,Default,,0,0,0,,Уау, аа, аа!
Dialogue: 0,1:23:32.09,1:23:33.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:23:33.25,1:23:34.46,Default,,0,0,0,,Ауырды...
Dialogue: 0,1:23:34.59,1:23:38.34,Default,,0,0,0,,үшінмыз қашып, стратегиямызды қайта құрайық.
Dialogue: 0,1:23:38.47,1:23:41.51,Default,,0,0,0,,Сіз құлыпқа қарама-қарсы бағытта орманды көре аласыз ба?
Dialogue: 0,1:23:41.64,1:23:43.35,Default,,0,0,0,,А...
Dialogue: 0,1:23:43.68,1:23:44.72,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:44.85,1:23:48.35,Default,,0,0,0,,Мортен жұлдызын қосқаннан кейін сол орманға қарай мүмкіндігінше жылдам жүгіріңіз.
Dialogue: 0,1:23:48.48,1:23:49.27,Default,,0,0,0,,Иә!
Dialogue: 0,1:23:49.39,1:23:51.02,Default,,0,0,0,,Орманның кіре берісінде кездесейік
Dialogue: 0,1:23:51.40,1:23:52.77,Default,,0,0,0,,Түсіндім... түсіндім.
Dialogue: 0,1:23:52.90,1:23:56.11,Default,,0,0,0,,Нобита-кун, тез Мортен жұлдызын қосыңыз.
Dialogue: 0,1:23:57.78,1:24:00.53,Default,,0,0,0,,Жүр, жүгір! Толық жылдамдық!
Dialogue: 0,1:24:01.57,1:24:03.41,Default,,0,0,0,,(Каори) ♪ Дан, дан-тан, дан, дан, та-тан-тан—
Dialogue: 0,1:24:07.25,1:24:09.37,Default,,0,0,0,,(Нобитаның ауыр тыныс алуы)
Dialogue: 0,1:24:11.54,1:24:13.50,Default,,0,0,0,,Хаха...
Dialogue: 0,1:24:17.01,1:24:19.42,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,1:24:20.22,1:24:21.47,Default,,0,0,0,,Онда!
Dialogue: 0,1:24:22.39,1:24:24.43,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,1:24:24.55,1:24:25.72,Default,,0,0,0,,Жа… Джан?
Dialogue: 0,1:24:25.85,1:24:26.81,Default,,0,0,0,,(Сунеоның айқайы)
Dialogue: 0,1:24:26.93,1:24:28.39,Default,,0,0,0,,Сунео! Ха…
Dialogue: 0,1:24:30.60,1:24:32.02,Default,,0,0,0,,Хааа!
Dialogue: 0,1:24:32.15,1:24:33.98,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:24:34.11,1:24:37.03,Default,,0,0,0,,Неліктен? Мен оны көре алмауым керек еді... Ах!
Dialogue: 0,1:24:40.53,1:24:43.16,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,1:24:43.66,1:24:44.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:45.62,1:24:48.50,Default,,0,0,0,,Уф, ауырып тұр...
Dialogue: 0,1:24:48.62,1:24:50.87,Default,,0,0,0,,А, Мо... Жұлдыз Мортен!
Dialogue: 0,1:24:51.21,1:24:53.67,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:24:53.79,1:24:54.75,Default,,0,0,0,,Ой…
Dialogue: 0,1:24:54.88,1:24:57.09,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,1:25:01.72,1:25:03.34,Default,,0,0,0,,Ми... Мияко-сан (Мияко) Тынш!
Dialogue: 0,1:25:04.26,1:25:05.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:07.18,1:25:08.68,Default,,0,0,0,,Мен жақын жердемін.
Dialogue: 0,1:25:08.81,1:25:10.18,Default,,0,0,0,,Немесе... қоршалған.
Dialogue: 0,1:25:10.68,1:25:12.06,Default,,0,0,0,,Енді жоқ
Dialogue: 0,1:25:12.19,1:25:13.90,Default,,0,0,0,,Нобита-сан, мынаны пайдалан
Dialogue: 0,1:25:14.02,1:25:14.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:15.61,1:25:19.15,Default,,0,0,0,,Мен жындарды тартамын, сондықтан мүмкіндікті пайдаланып қашыңыз.
Dialogue: 0,1:25:19.28,1:25:20.74,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,1:25:20.86,1:25:24.86,Default,,0,0,0,,Қанша істесем де қашып, қызды тастап кете алмаймын.
Dialogue: 0,1:25:25.78,1:25:28.58,Default,,0,0,0,,Сіз сиқырды қолдана аласыз ба? Сіз шайтанмен күресе аласыз ба?
Dialogue: 0,1:25:29.29,1:25:33.37,Default,,0,0,0,,Екеуі де қолға түссе, Жерді кім қорғайды?
Dialogue: 0,1:25:34.50,1:25:35.88,Default,,0,0,0,,Мияко-сан...
Dialogue: 0,1:25:41.34,1:25:45.39,Default,,0,0,0,,Кешіріңіз, қазір қашыңыз.
Dialogue: 0,1:25:46.85,1:25:50.64,Default,,0,0,0,,Мен, өйткені барлығы менімен бірге болды.
Dialogue: 0,1:25:51.06,1:25:55.40,Default,,0,0,0,,Мен жалғыз емес едім, сондықтан мен ештеңеден қорықпадым.
Dialogue: 0,1:25:55.69,1:25:56.69,Default,,0,0,0,,(Нобита жұтып жатқан дыбыс)
Dialogue: 0,1:25:57.90,1:26:01.40,Default,,0,0,0,,Нобита-сан маған көңіл көтеруді айтты...
Dialogue: 0,1:26:03.40,1:26:06.16,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,1:26:08.74,1:26:11.83,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,1:26:14.04,1:26:15.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:16.79,1:26:17.88,Default,,0,0,0,,Әй!
Dialogue: 0,1:26:19.42,1:26:22.13,Default,,0,0,0,,(Екі жұлдыздың айқайы)
Dialogue: 0,1:26:26.51,1:26:30.51,Default,,0,0,0,,(Нобитаның ауыр тыныс алуы)
Dialogue: 0,1:26:34.60,1:26:39.40,Default,,0,0,0,,Мен міндетті түрде... Мен сізге көмектесу үшін міндетті түрде қайтамын.
Dialogue: 0,1:26:39.52,1:26:41.15,Default,,0,0,0,,Мияко-сан!
Dialogue: 0,1:26:50.58,1:26:53.54,Default,,0,0,0,,Ай ашық қызыл
Dialogue: 0,1:26:54.08,1:26:55.04,Default,,0,0,0,,Иә
Dialogue: 0,1:26:55.50,1:26:57.75,Default,,0,0,0,,Қан сияқты қызыл.
Dialogue: 0,1:26:58.33,1:26:59.46,Default,,0,0,0,,Иә
Dialogue: 0,1:26:59.67,1:27:02.67,Default,,0,0,0,,Ешкім келмейді
Dialogue: 0,1:27:03.50,1:27:04.55,Default,,0,0,0,,Иә
Dialogue: 0,1:27:06.76,1:27:10.30,Default,,0,0,0,,үшін қамауға алынды.
Dialogue: 0,1:27:11.43,1:27:14.68,Default,,0,0,0,,(Нобитаның жылағаны)
Dialogue: 0,1:27:15.56,1:27:20.23,Default,,0,0,0,,Неге... неге күміс жебелер істемеді?
Dialogue: 0,1:27:20.36,1:27:23.23,Default,,0,0,0,,Егер жындар әлемінің тағы жартысы болса,—
Dialogue: 0,1:27:23.36,1:27:26.15,Default,,0,0,0,,Мүмкін сіз де түсінген боларсыз.
Dialogue: 0,1:27:26.90,1:27:28.45,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,1:27:28.57,1:27:31.32,Default,,0,0,0,,Өйткені мен сиқырлы әлем жасадым
Dialogue: 0,1:27:31.45,1:27:34.16,Default,,0,0,0,,Ей, мен дүниенің осындай екеніне сене алар емеспін...
Dialogue: 0,1:27:34.49,1:27:38.12,Default,,0,0,0,,Жылама, сен мынаны айттың...
Dialogue: 0,1:27:38.25,1:27:39.96,Default,,0,0,0,,Қайтып алу...
Dialogue: 0,1:27:40.08,1:27:43.59,Default,,0,0,0,,А-а-а... Мен оны қайтарып алғым келеді...
Dialogue: 0,1:27:43.84,1:27:45.42,Default,,0,0,0,,Бұл орын алуы мүмкін!
Dialogue: 0,1:27:45.55,1:27:48.55,Default,,0,0,0,,Неліктен? Енді қорап жоқ болса ше?
Dialogue: 0,1:27:48.68,1:27:50.30,Default,,0,0,0,,Уақыт машинасын қолданыңыз
Dialogue: 0,1:27:50.43,1:27:51.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:51.22,1:27:53.35,Default,,0,0,0,,Уақыт машинасымен сол күнге оралыңыз—
Dialogue: 0,1:27:53.85,1:27:57.73,Default,,0,0,0,,Бұрын бізге Мошимо қорабын пайдалануға рұқсат етпеңіз.
Dialogue: 0,1:27:57.98,1:27:59.60,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:27:59.73,1:28:03.06,Default,,0,0,0,,Жарайды, торийоза сөмке!
Dialogue: 0,1:28:03.19,1:28:05.69,Default,,0,0,0,,Нобитаның жердегі бөлмесінен...
Dialogue: 0,1:28:05.82,1:28:08.70,Default,,0,0,0,,Менің үстелім! Хехехе
Dialogue: 0,1:28:09.82,1:28:12.74,Default,,0,0,0,,Мен қалған екі адамды таптым.
Dialogue: 0,1:28:13.70,1:28:17.41,Default,,0,0,0,,Меджусаны қуып, оларды жойыңыз!
Dialogue: 0,1:28:17.70,1:28:20.21,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,1:28:25.84,1:28:29.51,Default,,0,0,0,,Өткенге Шынайы әлемге
Dialogue: 0,1:28:37.52,1:28:39.89,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:28:40.10,1:28:41.64,Default,,0,0,0,,Сәлем! (Нобита) Не?
Dialogue: 0,1:28:41.77,1:28:43.60,Default,,0,0,0,,Ах... артта.
Dialogue: 0,1:28:44.44,1:28:46.44,Default,,0,0,0,,Бірдеңе бар...
Dialogue: 0,1:28:46.57,1:28:49.94,Default,,0,0,0,,Дәл солай... уақыт ағымында...
Dialogue: 0,1:28:50.65,1:28:53.07,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,1:28:54.37,1:28:56.99,Default,,0,0,0,,Уау... (Меджуза) Ах!
Dialogue: 0,1:28:57.20,1:29:00.41,Default,,0,0,0,,Уау! Олар мені қуып келеді!
Dialogue: 0,1:29:00.54,1:29:01.96,Default,,0,0,0,,Баспропеллер!
Dialogue: 0,1:29:02.17,1:29:02.96,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,1:29:03.08,1:29:05.42,Default,,0,0,0,,Батарея біткен...
Dialogue: 0,1:29:07.38,1:29:09.42,Default,,0,0,0,,Хмм...
Dialogue: 0,1:29:09.96,1:29:12.22,Default,,0,0,0,,Мен неге байқамадым?
Dialogue: 0,1:29:12.34,1:29:14.72,Default,,0,0,0,,Менде сиқыр болғанын қалаймын.
Dialogue: 0,1:29:14.84,1:29:16.68,Default,,0,0,0,,Мм... (Нобита) Хокинг!
Dialogue: 0,1:29:16.80,1:29:18.14,Default,,0,0,0,,Ұша алмасаң да!
Dialogue: 0,1:29:18.26,1:29:19.64,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,1:29:19.77,1:29:21.10,Default,,0,0,0,,Ах... (Нобита) Қазірдің өзінде!
Dialogue: 0,1:29:21.23,1:29:24.35,Default,,0,0,0,,Ал... Ұш! Ұш!
Dialogue: 0,1:29:24.48,1:29:26.02,Default,,0,0,0,,Дио…
Dialogue: 0,1:29:26.15,1:29:29.78,Default,,0,0,0,,Жақсы аа...
Dialogue: 0,1:29:29.94,1:29:32.49,Default,,0,0,0,,Ха! Ха! Апыр-ай!
Dialogue: 0,1:29:32.99,1:29:34.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:36.03,1:29:37.62,Default,,0,0,0,,Хаха...
Dialogue: 0,1:29:44.62,1:29:45.63,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:29:46.79,1:29:48.54,Default,,0,0,0,,Аспаннан...
Dialogue: 0,1:29:49.05,1:29:50.76,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:29:51.42,1:29:52.92,Default,,0,0,0,,Бұл ақымақ мүсін қандай?
Dialogue: 0,1:29:53.05,1:29:55.93,Default,,0,0,0,,Бұндай нәрсені мұндай жерге қалдырмаңыз.
Dialogue: 0,1:29:56.05,1:29:59.68,Default,,0,0,0,,Ахаха Не деген (Сунео) Уау, дәмді Джиан
Dialogue: 0,1:30:07.56,1:30:08.86,Default,,0,0,0,,Уф
Dialogue: 0,1:30:08.98,1:30:10.40,Default,,0,0,0,,Уау (Нобита) Мен қозғала аламын.
Dialogue: 0,1:30:10.53,1:30:13.49,Default,,0,0,0,,Жаман Моши жәшігі жақында пайдаланылады
Dialogue: 0,1:30:13.61,1:30:16.61,Default,,0,0,0,,Ой, мен мұны тез тоқтатуым керек.
Dialogue: 0,1:30:16.74,1:30:18.87,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,1:30:19.08,1:30:21.87,Default,,0,0,0,,Ха, құрсаудан өт! бұл!
Dialogue: 0,1:30:21.99,1:30:24.08,Default,,0,0,0,,Тез, тез! (Нобита) Уау
Dialogue: 0,1:30:24.33,1:30:27.04,Default,,0,0,0,,Йотто (Нобита) Ууу...
Dialogue: 0,1:30:27.54,1:30:29.59,Default,,0,0,0,,Уау (Нобита) Уау!
Dialogue: 0,1:30:29.71,1:30:31.00,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,1:30:33.46,1:30:35.42,Default,,0,0,0,,Ай...
Dialogue: 0,1:30:35.97,1:30:37.09,Default,,0,0,0,,А... а... а...
Dialogue: 0,1:30:37.22,1:30:39.10,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,1:30:39.22,1:30:41.22,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:30:45.52,1:30:46.81,Default,,0,0,0,,Не? бұл қоқыс
Dialogue: 0,1:30:46.94,1:30:48.23,Default,,0,0,0,,Ол рұқсатсыз кірді.
Dialogue: 0,1:30:48.35,1:30:50.02,Default,,0,0,0,,Ол бақшада қалды.
Dialogue: 0,1:30:50.23,1:30:53.11,Default,,0,0,0,,Тастар өздігінен қозғала алмайды, солай ма?
Dialogue: 0,1:30:53.23,1:30:54.94,Default,,0,0,0,,Тез тазалаңыз
Dialogue: 0,1:30:56.74,1:30:59.07,Default,,0,0,0,,Хмм...
Dialogue: 0,1:31:12.67,1:31:14.71,Default,,0,0,0,,Уф Дораемон
Dialogue: 0,1:31:14.84,1:31:18.63,Default,,0,0,0,,Хм, мен не істеуім керек? Хмм.
Dialogue: 0,1:31:18.76,1:31:20.60,Default,,0,0,0,,Хм, бұл не?
Dialogue: 0,1:31:20.97,1:31:23.01,Default,,0,0,0,,Ай сәулесі!
Dialogue: 0,1:31:23.72,1:31:25.89,Default,,0,0,0,,Мынау... Бұл менде болса ғой!
Dialogue: 0,1:31:26.02,1:31:28.77,Default,,0,0,0,,Хммм... (Нобита) Дораемон, қолыңнан келгеннің бәрін істе
Dialogue: 0,1:31:28.90,1:31:29.56,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:31:42.07,1:31:43.33,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,1:31:45.20,1:31:47.96,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,1:31:48.83,1:31:50.37,Default,,0,0,0,,Ол Арнайы сыныпқа тең Қарғыс рухына айналуы күтіледі.
Dialogue: 0,1:31:50.79,1:31:52.08,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:52.21,1:31:54.75,Default,,0,0,0,,Жүр, сыртқа тез хабарлауың керек.
Dialogue: 0,1:31:54.88,1:31:57.05,Default,,0,0,0,,Иә, бірақ қалай?
Dialogue: 0,1:31:57.59,1:32:01.18,Default,,0,0,0,,Қалай болғанда да, бәрін айналдырып, жабайы болыңыз.
Dialogue: 0,1:32:01.30,1:32:02.26,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:32:02.39,1:32:03.51,Default,,0,0,0,,Бұл! бұл!
Dialogue: 0,1:32:04.14,1:32:05.43,Default,,0,0,0,,Иә! Эй!
Dialogue: 0,1:32:05.81,1:32:07.39,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:32:11.35,1:32:12.23,Default,,0,0,0,,Гвааа...
Dialogue: 0,1:32:12.36,1:32:14.32,Default,,0,0,0,,Ауырды... (Нобита) Не? не болды?
Dialogue: 0,1:32:14.44,1:32:16.69,Default,,0,0,0,,Менің ішім кенеттен...
Dialogue: 0,1:32:17.40,1:32:19.15,Default,,0,0,0,,Абайлаңыз! Сақ болыңыз!
Dialogue: 0,1:32:19.49,1:32:21.16,Default,,0,0,0,,Үлкен… күшті…
Dialogue: 0,1:32:21.28,1:32:24.62,Default,,0,0,0,,Уф, мен бірден қайтамын...
Dialogue: 0,1:32:25.45,1:32:28.41,Default,,0,0,0,,Тез түсініңіз хаха...
Dialogue: 0,1:32:28.54,1:32:30.75,Default,,0,0,0,,Ах, ай сәулесінің әсері...
Dialogue: 0,1:32:30.87,1:32:32.83,Default,,0,0,0,,Иә? (2 адам) Ахххх...
Dialogue: 0,1:32:33.38,1:32:37.51,Default,,0,0,0,,Дораэмон... Нобита... Сен...
Dialogue: 0,1:32:42.01,1:32:47.01,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,1:32:58.82,1:33:00.99,Default,,0,0,0,,Папа (Толық ай) Мияко
Dialogue: 0,1:33:01.28,1:33:04.03,Default,,0,0,0,,Сиқырдың бұзылғанына қуаныштымын.
Dialogue: 0,1:33:04.45,1:33:08.16,Default,,0,0,0,,Бірақ біздің сиқырымыз да осы қамалдың ішінде мөрленген сияқты.
Dialogue: 0,1:33:08.29,1:33:10.71,Default,,0,0,0,,Сонда құтылудың жолы жоқ па?
Dialogue: 0,1:33:11.08,1:33:13.58,Default,,0,0,0,,Бірақ мен Нобита-сан мен Дора-чанға сенімдімін...
Dialogue: 0,1:33:13.71,1:33:15.17,Default,,0,0,0,,Фуфуфуфуфу… (Мияко) Хаха
Dialogue: 0,1:33:15.54,1:33:18.84,Default,,0,0,0,,Оларды Медузаның сиқыры тасқа айналдырды.
Dialogue: 0,1:33:18.96,1:33:19.63,Default,,0,0,0,,Не!
Dialogue: 0,1:33:20.17,1:33:23.09,Default,,0,0,0,,Енді жер біздікі.
Dialogue: 0,1:33:23.22,1:33:26.64,Default,,0,0,0,,Өйткені Медуза-сама айдың сиқырлы күшін өшіруге барды.
Dialogue: 0,1:33:26.76,1:33:28.10,Default,,0,0,0,,Бұл...
Dialogue: 0,1:33:28.72,1:33:33.19,Default,,0,0,0,,Қорғансыз Жерді иемдену оңай болар еді.
Dialogue: 0,1:33:33.60,1:33:36.77,Default,,0,0,0,,Ертең Мақай жұлдызы ақыры Жермен жанасады.
Dialogue: 0,1:33:36.90,1:33:38.19,Default,,0,0,0,,Солай... (Сунео) Иә?
Dialogue: 0,1:33:38.32,1:33:39.73,Default,,0,0,0,,Бұл қазірдің өзінде жақын ...
Dialogue: 0,1:33:39.86,1:33:41.49,Default,,0,0,0,,(Үш жұлдызды және екі жұлдызды күлкі)
Dialogue: 0,1:33:41.94,1:33:44.41,Default,,0,0,0,,Мен сендерді мерекеге дейін дайындаймын.
Dialogue: 0,1:33:44.53,1:33:46.24,Default,,0,0,0,,Оны асыға күтіңіз
Dialogue: 0,1:33:46.74,1:33:49.45,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,1:33:51.66,1:33:54.54,Default,,0,0,0,,Нобита-сан Дора-чан
Dialogue: 0,1:33:59.00,1:34:01.59,Default,,0,0,0,,Уау... а?
Dialogue: 0,1:34:01.71,1:34:02.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:06.30,1:34:07.60,Default,,0,0,0,,Байқадыңыз ба?
Dialogue: 0,1:34:07.97,1:34:08.97,Default,,0,0,0,,Дорами! (Нобита) Дорами-чан!
Dialogue: 0,1:34:09.10,1:34:10.60,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,1:34:10.72,1:34:12.35,Default,,0,0,0,,деді Севаши мырза
Dialogue: 0,1:34:12.48,1:34:14.44,Default,,0,0,0,,Ініңіздің ішінің ауыру себебі неде?
Dialogue: 0,1:34:14.56,1:34:17.23,Default,,0,0,0,,Ол төртінші өлшемді қалтада болуы мүмкін.
Dialogue: 0,1:34:17.36,1:34:20.36,Default,,0,0,0,,Мен қосалқы қалтаның ішіне қарадым...\NМен
Dialogue: 0,1:34:20.48,1:34:22.36,Default,,0,0,0,,-ге қарадым
Dialogue: 0,1:34:22.49,1:34:25.74,Default,,0,0,0,,Олар тасқа айналған екі адамды тапты.
Dialogue: 0,1:34:25.86,1:34:26.07,Default,,0,0,0,,Дорами! (Нобита) Дорами-чан!
Dialogue: 0,1:34:26.07,1:34:28.78,Default,,0,0,0,,Дорами! (Нобита) Дорами-чан!
Dialogue: 0,1:34:26.07,1:34:28.78,Default,,0,0,0,,Ия, тоқтатыңызшы.
Dialogue: 0,1:34:28.91,1:34:31.12,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:34:31.24,1:34:32.29,Default,,0,0,0,,А?
Dialogue: 0,1:34:32.62,1:34:34.75,Default,,0,0,0,,Міне... бұл үлкен мәселе!
Dialogue: 0,1:34:35.04,1:34:37.88,Default,,0,0,0,,Мм, білесіз бе, шын мәнінде, көп нәрсе болып жатыр.
Dialogue: 0,1:34:38.00,1:34:39.88,Default,,0,0,0,,Міне, солай.
Dialogue: 0,1:34:40.00,1:34:42.96,Default,,0,0,0,,Бұл болды.
Dialogue: 0,1:34:43.46,1:34:47.01,Default,,0,0,0,,Сонда қорап болса, шешілетін еді.
Dialogue: 0,1:34:47.13,1:34:48.05,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:48.18,1:34:50.26,Default,,0,0,0,,Сізде болуы керек нәрсе - қарындасыңыз
Dialogue: 0,1:34:50.39,1:34:52.77,Default,,0,0,0,,Енді сіз өзіңіздің бастапқы әлеміңізге орала аласыз.
Dialogue: 0,1:34:52.89,1:34:56.44,Default,,0,0,0,,Аман болсын! Рахмет сізге Дорами...
Dialogue: 0,1:35:03.57,1:35:05.07,Default,,0,0,0,,Хмм, күте тұрыңыз.
Dialogue: 0,1:35:05.74,1:35:06.53,Default,,0,0,0,,Уау
Dialogue: 0,1:35:06.95,1:35:09.12,Default,,0,0,0,,Эй... Мен сенен бірдеңе сұрайын деп едім.
Dialogue: 0,1:35:09.24,1:35:12.79,Default,,0,0,0,,Егер біз одан бас тартсақ, біз бастапқы әлемімізге орала аламыз, бірақ...
Dialogue: 0,1:35:12.91,1:35:14.12,Default,,0,0,0,,Сиқыр әлемі –
Dialogue: 0,1:35:14.50,1:35:16.87,Default,,0,0,0,,Ол жерде барлығы не болады?
Dialogue: 0,1:35:17.00,1:35:20.75,Default,,0,0,0,,Сонымен... дұрыс. Хмм...
Dialogue: 0,1:35:20.88,1:35:23.71,Default,,0,0,0,,Басқаша айтқанда, параллель әлемге айналады.
Dialogue: 0,1:35:24.51,1:35:25.84,Default,,0,0,0,,Пара… не?
Dialogue: 0,1:35:25.97,1:35:28.97,Default,,0,0,0,,Басқаша айтқанда, ана жақта, ана жақта—
Dialogue: 0,1:35:29.09,1:35:31.68,Default,,0,0,0,,Бізге қатысы жоқ дүние ретінде...
Dialogue: 0,1:35:32.05,1:35:36.27,Default,,0,0,0,,Қалай болса да, ол жалғасады...
Dialogue: 0,1:35:36.39,1:35:37.89,Default,,0,0,0,,Бұл...
Dialogue: 0,1:35:38.27,1:35:40.02,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,1:35:40.60,1:35:45.28,Default,,0,0,0,,Бұл жағдайда Мияко-сан және басқалары біздің көмегімізсіз қалады...
Dialogue: 0,1:35:45.78,1:35:47.53,Default,,0,0,0,,Жындарға...
Dialogue: 0,1:35:47.65,1:35:49.49,Default,,0,0,0,,Иә...
Dialogue: 0,1:36:01.83,1:36:03.79,Default,,0,0,0,,Дораемонға қайтайық
Dialogue: 0,1:36:04.17,1:36:05.75,Default,,0,0,0,,Иә
Dialogue: 0,1:36:06.71,1:36:10.09,Default,,0,0,0,,Мен ұмытып кете жаздадым
Dialogue: 0,1:36:10.76,1:36:12.39,Default,,0,0,0,,(Дон) Дегенмен, сыртта бәрі де соншалықты алып, иә?
Dialogue: 0,1:36:12.51,1:36:15.68,Default,,0,0,0,,Ол Мияконың әкесіне міндетті түрде көмектесетінін айтты.
Dialogue: 0,1:36:16.68,1:36:18.27,Default,,0,0,0,,Мен ант бердім
Dialogue: 0,1:36:18.43,1:36:19.85,Default,,0,0,0,,Мияко-сан...
Dialogue: 0,1:36:21.10,1:36:23.65,Default,,0,0,0,,Мен міндетті түрде көмектесуге қайтамын!
Dialogue: 0,1:36:24.90,1:36:26.61,Default,,0,0,0,,Иә, қайтайық
Dialogue: 0,1:36:27.23,1:36:29.20,Default,,0,0,0,,Мәселені шешу үшін!
Dialogue: 0,1:36:36.45,1:36:38.54,Default,,0,0,0,,Оны жегің келсе, бұл Джиан!
Dialogue: 0,1:36:38.66,1:36:41.00,Default,,0,0,0,,Мен жай ғана сүйектен терімін, дәмін татпаймын!
Dialogue: 0,1:36:41.12,1:36:44.46,Default,,0,0,0,,Сунео, ақымақ болма, мен семізмін!
Dialogue: 0,1:36:44.92,1:36:47.51,Default,,0,0,0,,Хехе, мен майлы тамақты жақсы көремін.
Dialogue: 0,1:36:47.63,1:36:49.38,Default,,0,0,0,,Уф... Уау
Dialogue: 0,1:36:49.51,1:36:51.43,Default,,0,0,0,,Ей, мына жігітті қуырып жіберейік.
Dialogue: 0,1:36:51.97,1:36:54.26,Default,,0,0,0,,Жоқ, мен оны буға қуырамын.
Dialogue: 0,1:36:54.39,1:36:56.72,Default,,0,0,0,,Мен 2 жұлдызмын.
Dialogue: 0,1:36:56.85,1:36:58.64,Default,,0,0,0,,Қуырылған тауық еті
Dialogue: 0,1:36:58.77,1:37:00.89,Default,,0,0,0,,Оны тұзбен қайнатыңыз (екі жұлдыз)?
Dialogue: 0,1:37:01.39,1:37:03.44,Default,,0,0,0,,Мен оған 3 жұлдыз беремін.
Dialogue: 0,1:37:03.56,1:37:06.07,Default,,0,0,0,,А, оны тұзбен қайнатыңыз.
Dialogue: 0,1:37:06.52,1:37:07.36,Default,,0,0,0,,Ах
Dialogue: 0,1:37:07.94,1:37:09.36,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:37:09.49,1:37:13.07,Default,,0,0,0,,Бұл қиын. Үлкен көк иті бізге шабуыл жасады.
Dialogue: 0,1:37:13.45,1:37:15.16,Default,,0,0,0,,Көк ракон ит?
Dialogue: 0,1:37:15.28,1:37:17.16,Default,,0,0,0,,Бұл Дора Чан
Dialogue: 0,1:37:18.66,1:37:20.96,Default,,0,0,0,,(Шайтанның шуы)
Dialogue: 0,1:37:29.63,1:37:30.88,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,1:37:31.80,1:37:33.09,Default,,0,0,0,,Нобита (Сидзука/Мияко) Нобита-сан
Dialogue: 0,1:37:33.51,1:37:35.47,Default,,0,0,0,,А, Нобита-сан
Dialogue: 0,1:37:36.80,1:37:38.43,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,1:37:38.56,1:37:40.93,Default,,0,0,0,,Мен енот ит емеспін!
Dialogue: 0,1:37:41.06,1:37:42.73,Default,,0,0,0,,Дораэмон (Шидзука/Мияко) Дора-чан
Dialogue: 0,1:37:42.85,1:37:45.69,Default,,0,0,0,,Ия, Мияко-сан, қалыпты жағдайға оралдың ба?
Dialogue: 0,1:37:45.81,1:37:47.94,Default,,0,0,0,,Иә, кешіріңіз...
Dialogue: 0,1:37:48.36,1:37:49.69,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,1:37:49.82,1:37:52.15,Default,,0,0,0,,Дорами жындарды тартып жатқанда...
Dialogue: 0,1:37:52.28,1:37:53.32,Default,,0,0,0,,Хмм...
Dialogue: 0,1:37:53.90,1:37:55.20,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,1:37:55.32,1:37:56.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:56.37,1:37:58.12,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,1:37:58.91,1:38:03.08,Default,,0,0,0,,1 жұлдыз, 2 жұлдыз, 3 жұлдыз, 4 жұлдыз, 5 жұлдыз...! ?
Dialogue: 0,1:38:03.37,1:38:07.00,Default,,0,0,0,,Уау... кешіріңіз!
Dialogue: 0,1:38:07.13,1:38:08.54,Default,,0,0,0,,Не?
Dialogue: 0,1:38:13.22,1:38:15.30,Default,,0,0,0,,Кілем жанып тұруы керек еді.
Dialogue: 0,1:38:15.43,1:38:16.22,Default,,0,0,0,,Хаха...
Dialogue: 0,1:38:16.64,1:38:19.68,Default,,0,0,0,,Жақсы кадр, бұл менің сиқырым, хехе
Dialogue: 0,1:38:22.43,1:38:24.60,Default,,0,0,0,,А, қазірдің өзінде.
Dialogue: 0,1:38:28.31,1:38:29.52,Default,,0,0,0,,Дорами!
Dialogue: 0,1:38:30.07,1:38:31.36,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:38:32.94,1:38:34.95,Default,,0,0,0,,Дора-чан, біз айға осылай бара жатырмыз.
Dialogue: 0,1:38:35.95,1:38:38.53,Default,,0,0,0,,Медуза ай сәулесін өшіруге тырысады
Dialogue: 0,1:38:38.66,1:38:39.91,Default,,0,0,0,,Не?
Dialogue: 0,1:38:40.95,1:38:43.37,Default,,0,0,0,,Жарайды, бәрің ішке кіріңдер.
Dialogue: 0,1:38:44.00,1:38:47.79,Default,,0,0,0,,Уайымдамаңыз, кілемнің бәріне крем жағып қойдым.
Dialogue: 0,1:38:49.25,1:38:50.71,Default,,0,0,0,,Хмм...
Dialogue: 0,1:38:52.09,1:38:53.34,Default,,0,0,0,,Ай…
Dialogue: 0,1:38:54.21,1:38:56.51,Default,,0,0,0,,Олар айға бет алды
Dialogue: 0,1:38:56.63,1:38:59.85,Default,,0,0,0,,Медуза... Менің ойымша, бұл Медуза келген уақыт шамасында болды.
Dialogue: 0,1:39:00.47,1:39:04.77,Default,,0,0,0,,Жерлестер, мені мазалайды ма?
Dialogue: 0,1:39:05.89,1:39:08.52,Default,,0,0,0,,үшінңыз, жалғастырыңыз!
Dialogue: 0,1:39:08.65,1:39:10.73,Default,,0,0,0,,Оу!
Dialogue: 0,1:39:19.99,1:39:24.37,Default,,0,0,0,,Ха, у, а...
Dialogue: 0,1:39:24.91,1:39:26.54,Default,,0,0,0,,Мұнда...
Dialogue: 0,1:39:27.50,1:39:30.13,Default,,0,0,0,,Аа, уф...
Dialogue: 0,1:39:30.25,1:39:32.25,Default,,0,0,0,,Айдың арғы жағында болса да—
Dialogue: 0,1:39:33.21,1:39:36.72,Default,,0,0,0,,Жарықтың сиқырлы күші қаншама...
Dialogue: 0,1:39:37.26,1:39:39.55,Default,,0,0,0,,Нарниадалар ұзақ уақыт бойы
Dialogue: 0,1:39:39.68,1:39:43.14,Default,,0,0,0,,Сіздің сиқырлы күшіңіз жындардың азап шегуіне себеп болды.
Dialogue: 0,1:39:43.26,1:39:45.47,Default,,0,0,0,,Енді оны өшіретін уақыт келді!
Dialogue: 0,1:39:45.60,1:39:46.93,Default,,0,0,0,,Күте тұрыңыз! (Меджуза) А?
Dialogue: 0,1:39:47.35,1:39:48.64,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:39:48.98,1:39:51.11,Default,,0,0,0,,Әй, кеш болып қалды
Dialogue: 0,1:39:51.23,1:39:54.61,Default,,0,0,0,,Жер жын нәсіліне жатады... Иә?
Dialogue: 0,1:39:54.90,1:39:56.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:39:58.03,1:40:01.57,Default,,0,0,0,,Міне, бастаймыз! Ал, қабыл ал!
Dialogue: 0,1:40:02.03,1:40:02.99,Default,,0,0,0,,(Көрермен С) Отбасында осындай қарт адамның болуы – нағыз қорқынышты түс қой.
Dialogue: 0,1:40:03.45,1:40:05.45,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,1:40:05.58,1:40:06.95,Default,,0,0,0,,Уф... Муджиги
Dialogue: 0,1:40:07.08,1:40:11.08,Default,,0,0,0,,Әй, уау, ә!
Dialogue: 0,1:40:11.21,1:40:12.54,Default,,0,0,0,,Мугимуги…
Dialogue: 0,1:40:12.84,1:40:14.29,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:14.50,1:40:15.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:15.59,1:40:16.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:40:21.30,1:40:23.64,Default,,0,0,0,,Уф уф
Dialogue: 0,1:40:23.76,1:40:25.89,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:28.52,1:40:31.52,Default,,0,0,0,,(Гимнің айқайы)
Dialogue: 0,1:40:44.41,1:40:48.25,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,1:40:48.79,1:40:51.54,Default,,0,0,0,,Ки… Кишибе Рохан. Кирадан басқа да бір адамның күші бар екен.
Dialogue: 0,1:40:53.83,1:40:55.50,Default,,0,0,0,,Жоқ... не? (Сунео) А...
Dialogue: 0,1:40:55.63,1:40:57.92,Default,,0,0,0,,Әйтеуір, бұл...
Dialogue: 0,1:40:58.26,1:41:00.38,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,1:41:01.30,1:41:03.84,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:41:05.14,1:41:05.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:06.10,1:41:09.77,Default,,0,0,0,,А, аа, у...
Dialogue: 0,1:41:09.93,1:41:11.10,Default,,0,0,0,,Ха!
Dialogue: 0,1:41:12.31,1:41:13.90,Default,,0,0,0,,Уф...
Dialogue: 0,1:41:14.02,1:41:16.44,Default,,0,0,0,,Ми... Мияко
Dialogue: 0,1:41:18.11,1:41:19.82,Default,,0,0,0,,Ана... Ана?
Dialogue: 0,1:41:20.69,1:41:23.32,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,1:41:23.45,1:41:24.82,Default,,0,0,0,,Неге...
Dialogue: 0,1:41:24.95,1:41:26.49,Default,,0,0,0,,Сол кезде —
Dialogue: 0,1:41:26.74,1:41:29.50,Default,,0,0,0,,Шайтанмен келісім жасасқанда
Dialogue: 0,1:41:29.91,1:41:34.12,Default,,0,0,0,,Менің жанымды шайтан басып алды
Dialogue: 0,1:41:35.46,1:41:39.59,Default,,0,0,0,,Содан бері мен Демаонның астындағы шайтан болдым...
Dialogue: 0,1:41:40.38,1:41:42.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:41:42.17,1:41:45.97,Default,,0,0,0,,Бұл... Сенің мұндай нәрсе жасайтыныңа сене алар емеспін.
Dialogue: 0,1:41:48.01,1:41:52.64,Default,,0,0,0,,Бірақ мен сізге көмектескім келді...\NТек
Dialogue: 0,1:41:52.77,1:41:54.14,Default,,0,0,0,,...
Dialogue: 0,1:41:57.90,1:41:59.73,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,1:42:00.44,1:42:03.82,Default,,0,0,0,,үшін Айдың сиқыры бұзылды.
Dialogue: 0,1:42:03.95,1:42:06.70,Default,,0,0,0,,Біздің жолымызға түскен ешкімді тірі қалдырма!
Dialogue: 0,1:42:06.82,1:42:08.66,Default,,0,0,0,,Оу!
Dialogue: 0,1:42:08.78,1:42:10.95,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,1:42:12.25,1:42:13.96,Default,,0,0,0,,Мақай жұлдызында...
Dialogue: 0,1:42:15.21,1:42:19.29,Default,,0,0,0,,Мақай жұлдызында жүзген қызыл ай
Dialogue: 0,1:42:19.42,1:42:22.13,Default,,0,0,0,,Ай? Ай деген не?
Dialogue: 0,1:42:22.26,1:42:25.01,Default,,0,0,0,,Ах... (Мияко) Әй, анашым!
Dialogue: 0,1:42:25.55,1:42:27.05,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,1:42:27.68,1:42:30.60,Default,,0,0,0,,Демаонның... жүрегі...
Dialogue: 0,1:42:30.72,1:42:32.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:32.64,1:42:36.48,Default,,0,0,0,,Әй, мама, жоқ, барма.
Dialogue: 0,1:42:37.44,1:42:38.94,Default,,0,0,0,,Миёко
Dialogue: 0,1:42:39.73,1:42:42.44,Default,,0,0,0,,Тірі болсаң...
Dialogue: 0,1:42:42.82,1:42:45.65,Default,,0,0,0,,Басқа ештеңе...
Dialogue: 0,1:42:56.67,1:42:59.79,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:43:04.59,1:43:05.76,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,1:43:06.09,1:43:09.47,Default,,0,0,0,,Жер енді біздікі!
Dialogue: 0,1:43:13.77,1:43:15.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:43:28.61,1:43:32.53,Default,,0,0,0,,Мияко-сан Мияко-сан...
Dialogue: 0,1:43:42.42,1:43:45.46,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:43:46.34,1:43:48.84,Default,,0,0,0,,Әй!
Dialogue: 0,1:43:50.80,1:43:53.35,Default,,0,0,0,,Жұлдыз, Иказучи бол!
Dialogue: 0,1:43:53.47,1:43:55.43,Default,,0,0,0,,Адамдарды талқандаңыз!
Dialogue: 0,1:43:55.56,1:43:56.85,Default,,0,0,0,,(Жұлдыздың күркіреуі)
Dialogue: 0,1:43:57.31,1:43:58.52,Default,,0,0,0,,Уау
Dialogue: 0,1:44:03.15,1:44:05.48,Default,,0,0,0,,Уау!
Dialogue: 0,1:44:05.61,1:44:07.86,Default,,0,0,0,,Болмау! (үшін) Уау!
Dialogue: 0,1:44:11.78,1:44:14.79,Default,,0,0,0,,Олар қайда бара жатыр?
Dialogue: 0,1:44:14.91,1:44:16.29,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,1:44:16.70,1:44:18.96,Default,,0,0,0,,Оларды жіберме!
Dialogue: 0,1:44:19.08,1:44:20.75,Default,,0,0,0,,Бұл Демаон...
Dialogue: 0,1:44:23.75,1:44:26.42,Default,,0,0,0,,Эй, Цукихико-сан.
Dialogue: 0,1:44:26.55,1:44:27.21,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,1:44:27.59,1:44:29.34,Default,,0,0,0,,(Жұлдыздардың ыңылдауы)
Dialogue: 0,1:44:30.22,1:44:31.80,Default,,0,0,0,,Иә!
Dialogue: 0,1:44:31.93,1:44:34.43,Default,,0,0,0,,Уф!
Dialogue: 0,1:44:35.35,1:44:36.68,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:44:37.06,1:44:38.14,Default,,0,0,0,,Анашым!
Dialogue: 0,1:44:38.93,1:44:40.39,Default,,0,0,0,,Даа!
Dialogue: 0,1:44:40.77,1:44:41.65,Default,,0,0,0,,Оны алыс ұстаңыз!
Dialogue: 0,1:44:42.27,1:44:43.86,Default,,0,0,0,,Осы жылдамдықпен бізді қоршап алады!
Dialogue: 0,1:44:44.02,1:44:46.32,Default,,0,0,0,,Жоқ! Тым көп!
Dialogue: 0,1:44:46.65,1:44:48.28,Default,,0,0,0,,Оны сындырыңыз!
Dialogue: 0,1:44:48.86,1:44:49.74,Default,,0,0,0,,Иә!
Dialogue: 0,1:44:49.86,1:44:53.24,Default,,0,0,0,,Барлық жерде есіктер!
Dialogue: 0,1:44:58.33,1:44:59.33,Default,,0,0,0,,Не!
Dialogue: 0,1:44:59.87,1:45:01.54,Default,,0,0,0,,Асығыңыз! Күміс дарттар!
Dialogue: 0,1:45:01.75,1:45:03.71,Default,,0,0,0,,Тоқта! Тоқта!
Dialogue: 0,1:45:03.83,1:45:06.71,Default,,0,0,0,,Иә, менікі соңғысы ма?
Dialogue: 0,1:45:07.25,1:45:08.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:45:08.21,1:45:11.43,Default,,0,0,0,,Ешбір жарыс осындай үлкен мақсатты жіберіп ала ма?
Dialogue: 0,1:45:11.84,1:45:14.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:45:14.14,1:45:15.80,Default,,0,0,0,,Нобита-кун! Нобита!
Dialogue: 0,1:45:15.93,1:45:18.31,Default,,0,0,0,,Сәлем! Үлкен жарық!
Dialogue: 0,1:45:21.69,1:45:23.94,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:45:26.15,1:45:27.94,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,1:45:28.65,1:45:32.65,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,1:45:54.26,1:45:56.60,Default,,0,0,0,,Уф...
Dialogue: 0,1:45:56.89,1:45:58.89,Default,,0,0,0,,Уау...
Dialogue: 0,1:46:25.67,1:46:26.67,Default,,0,0,0,,Ах
Dialogue: 0,1:46:26.79,1:46:28.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:28.75,1:46:29.84,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:29.96,1:46:31.30,Default,,0,0,0,,Ах (Нобита және басқалар) Ах!
Dialogue: 0,1:46:46.35,1:46:52.36,Default,,0,0,0,,♪〜
Dialogue: 0,1:50:15.06,1:50:21.07,Default,,0,0,0,,〜♪
Dialogue: 0,1:50:25.57,1:50:26.53,Default,,0,0,0,,Эй
Dialogue: 0,1:50:26.74,1:50:27.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:28.78,1:50:30.04,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,1:50:30.79,1:50:33.58,Default,,0,0,0,,Ах... мен...
Dialogue: 0,1:50:33.75,1:50:37.58,Default,,0,0,0,,Мүмкін мен шашымды қайтадан өсіріп көруім керек шығар.
Dialogue: 0,1:50:37.71,1:50:38.38,Default,,0,0,0,,Иә
Dialogue: 0,1:50:38.79,1:50:39.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:50:42.59,1:50:45.88,Default,,0,0,0,,Хехе, бұл сізге сәйкес келетініне сенімдімін.
Dialogue: 0,1:50:46.01,1:50:46.84,Default,,0,0,0,,Уау
Dialogue: 0,1:50:47.51,1:50:48.43,Default,,0,0,0,,Ах
Dialogue: 0,1:50:49.39,1:50:50.60,Default,,0,0,0,,Ах...
Dialogue: 0,1:50:53.31,1:50:54.43,Default,,0,0,0,,Уау
Dialogue: 0,1:50:56.94,1:51:00.94,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,1:51:02.94,1:51:04.94,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,1:51:06.28,1:51:07.74,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,1:51:07.86,1:51:08.74,Default,,0,0,0,,Тез кел!
Dialogue: 0,1:51:08.87,1:51:11.24,Default,,0,0,0,,Күте тұрыңыз, мен біріншімін!
Dialogue: 0,1:51:11.62,1:51:13.24,Default,,0,0,0,,Көрші қаладан келген орта мектеп оқушылары бар.
Dialogue: 0,1:51:13.37,1:51:15.08,Default,,0,0,0,,Сен менің орныма ұрыс таңдауға келдің, бірақ...
Dialogue: 0,1:51:15.21,1:51:17.75,Default,,0,0,0,,30 адам дірілдеп жатыр хаха
Dialogue: 0,1:51:17.87,1:51:19.92,Default,,0,0,0,,Ештеңе болмаған сияқты.
Dialogue: 0,1:51:21.04,1:51:24.76,Default,,0,0,0,,Менің ойымша, бұл арман болды
Dialogue: 0,1:51:25.88,1:51:28.13,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,1:51:28.51,1:51:29.39,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:51:29.51,1:51:31.89,Default,,0,0,0,,Дора-чан, мені де кіргіз.
Dialogue: 0,1:51:32.01,1:51:33.47,Default,,0,0,0,,Тез кел...
Dialogue: 0,1:51:35.60,1:51:37.31,Default,,0,0,0,,Чинкарахой!
Dialogue: 0,1:51:38.10,1:51:38.94,Default,,0,0,0,,О...
Dialogue: 0,1:51:39.06,1:51:40.27,Default,,0,0,0,,Ах! (3 адам) Уау!
Dialogue: 0,1:51:40.69,1:51:42.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:51:42.82,1:51:44.15,Default,,0,0,0,,Хаха
Dialogue: 0,1:51:44.28,1:51:45.69,Default,,0,0,0,,Хехе
Dialogue: 0,1:51:46.82,1:51:47.49,Default,,0,0,0,,Хаха
Dialogue: 0,1:51:47.90,1:51:48.78,Default,,0,0,0,,үшінна!
Dialogue: 0,1:51:48.91,1:51:50.41,Default,,0,0,0,,О, Нобита О
Dialogue: 0,1:51:50.53,1:51:51.20,Default,,0,0,0,,Сіз кешіктіңіз.
Dialogue: 0,1:51:51.32,1:51:52.95,Default,,0,0,0,,Егер мен ертерек келсем, жақсы нәрсе көрер едім.
Dialogue: 0,1:51:53.08,1:51:54.24,Default,,0,0,0,,Сунео мырза!
Dialogue: 0,1:51:54.37,1:51:55.83,Default,,0,0,0,,Хехе, мен көрдім.
Dialogue: 0,1:51:55.95,1:51:58.96,Default,,0,0,0,,Нобитаның жынысы қазірдің өзінде...
Dialogue: 0,1:51:59.62,1:52:02.42,Default,,0,0,0,,Бұл жел шығар.
Dialogue: 0,1:52:03.92,1:52:09.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
