Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.11,0:00:20.08,Default,,0,0,0,,Өйткені мен... сені сүйемін.
Dialogue: 0,0:00:20.08,0:00:22.12,Default,,0,0,0,,Кім не айтса да →
Dialogue: 0,0:00:22.12,0:00:26.09,Default,,0,0,0,,Өйткені сен маған ұнайсың!
Dialogue: 0,0:00:26.09,0:00:28.12,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:28.12,0:00:30.09,Default,,0,0,0,,Иә, кес!
Dialogue: 0,0:00:30.09,0:00:32.09,Default,,0,0,0,,Бұрылуды алдын ала қарау.
Dialogue: 0,0:00:33.20,0:00:35.13,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:35.13,0:00:39.17,Default,,0,0,0,,Иә, жарайды. Менің ойымша, бұл бүгінгі күн.
Dialogue: 0,0:00:39.17,0:00:41.10,Default,,0,0,0,,Иә Жарайды.
Dialogue: 0,0:00:41.10,0:00:44.11,Default,,0,0,0,,Осымен бүгінгі түсірілім кестесі аяқталады.
Dialogue: 0,0:00:44.11,0:00:47.11,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:00:47.11,0:00:50.11,Default,,0,0,0,,Еңбегіңіз үшін рахмет. (үшін) Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:00:51.11,0:00:54.12,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Юу Қалай болды?
Dialogue: 0,0:00:54.12,0:00:57.12,Default,,0,0,0,,Мен оны бірте-бірте түсіне бастадым... Шамасы?
Dialogue: 0,0:00:57.12,0:01:00.12,Default,,0,0,0,,Иә. Осыдан кейін сұхбат беріңізші.
Dialogue: 0,0:01:00.12,0:01:02.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:03.13,0:01:17.11,Default,,0,0,0,,♬～
Dialogue: 0,0:02:33.08,0:02:35.08,Default,,0,0,0,,Олай болса, алдымен →
Dialogue: 0,0:02:35.08,0:02:39.09,Default,,0,0,0,,Осы шоуға қашан қатысуды шешкеніңіз туралы айтып беріңізші.
Dialogue: 0,0:02:39.09,0:02:41.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:41.09,0:02:45.19,Default,,0,0,0,,Мен өте қобалжыдым, өйткені бұл менің бірінші басты рөлім еді.
Dialogue: 0,0:02:45.19,0:02:49.10,Default,,0,0,0,,Мен әдетте өте сабырлымын→
Dialogue: 0,0:02:49.10,0:02:52.10,Default,,0,0,0,,«Бұл рас па!» Мен айқайладым.
Dialogue: 0,0:02:52.10,0:02:55.14,Default,,0,0,0,,Шынымен! Неге ондай жерде жүрсің?
Dialogue: 0,0:02:55.14,0:02:59.07,Default,,0,0,0,,Бұл... жақсы күн емес! Шығу!
Dialogue: 0,0:02:59.07,0:03:01.08,Default,,0,0,0,,Бұл рөл қандай→
Dialogue: 0,0:03:01.08,0:03:03.05,Default,,0,0,0,,Менімен ұқсастықтар бар, дәлірек айтсақ →
Dialogue: 0,0:03:03.05,0:03:08.08,Default,,0,0,0,,Мен өз ойымды дауыстап айтуға ұялатын сияқтымын.
Dialogue: 0,0:03:08.08,0:03:12.05,Default,,0,0,0,,Өлтір! Мен оны міндетті түрде өлтіремін!
Dialogue: 0,0:03:13.16,0:03:15.19,Default,,0,0,0,,Менің ойымша, сіз мұны қазір жасай аласыз!
Dialogue: 0,0:03:15.19,0:03:17.09,Default,,0,0,0,,Себебі мен ебедейсіз→
Dialogue: 0,0:03:17.09,0:03:20.13,Default,,0,0,0,,Мен жиі қателесіп, айғайлаймын.
Dialogue: 0,0:03:20.13,0:03:24.07,Default,,0,0,0,,Бүгін де мен костюмімнің алдыңғы және артқы жағын қателесіп алдым...
Dialogue: 0,0:03:24.07,0:03:27.07,Default,,0,0,0,,Сіз оны А деп айттыңыз, Зейн! Сен не істеп жатырсың!
Dialogue: 0,0:03:27.07,0:03:29.04,Default,,0,0,0,,Сондықтан оны Заннен деп атайды!
Dialogue: 0,0:03:30.07,0:03:34.08,Default,,0,0,0,,Мен ойлап тапқан идея осылай болды...
Dialogue: 0,0:03:34.08,0:03:36.04,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:37.08,0:03:40.08,Default,,0,0,0,,Лиганың финалдық матчы Шақыру→
Dialogue: 0,0:03:40.08,0:03:44.05,Default,,0,0,0,,FOX ONE командасы 1 жеңіске жетті!
Dialogue: 0,0:03:47.06,0:03:49.06,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:03:49.06,0:03:52.06,Default,,0,0,0,,Сәттілік! Жақсы!
Dialogue: 0,0:03:52.06,0:03:55.06,Default,,0,0,0,,Кәсіпқой лигаға қосылу шындыққа айналуда!
Dialogue: 0,0:03:55.06,0:03:57.07,Default,,0,0,0,,Сөйтсе де, бұл әлі ерте кезең.
Dialogue: 0,0:03:57.07,0:04:01.07,Default,,0,0,0,,Барлық 12 команда 11 айналымдық ойын ойнады→
Dialogue: 0,0:04:01.07,0:04:04.07,Default,,0,0,0,,Егер сіз үздік 6-ға кіре алмасаңыз, ұтыласыз.
Dialogue: 0,0:04:04.07,0:04:08.11,Default,,0,0,0,,Ал, біз оны бір-бірден алуымыз керек.
Dialogue: 0,0:04:08.11,0:04:11.08,Default,,0,0,0,,Асығып, қателесудің пайдасы жоқ.
Dialogue: 0,0:04:11.08,0:04:13.05,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:13.05,0:04:16.05,Default,,0,0,0,,Анашым! (Сута) А, Токиноя мырза.
Dialogue: 0,0:04:16.05,0:04:20.09,Default,,0,0,0,,Менің Шун маған қарыздар.
Dialogue: 0,0:04:20.09,0:04:25.06,Default,,0,0,0,,Жоқ, жоқ, жоқ…. Көмегің үшін Шун-кунға рахмет.
Dialogue: 0,0:04:25.06,0:04:28.06,Default,,0,0,0,,Матч басталмас бұрын сізді алаңдататын болсам, ыңғайсыздық тудырады деп ойлаймын →
Dialogue: 0,0:04:28.06,0:04:32.07,Default,,0,0,0,,Мен барлығыңызға ризашылығымды білдіру үшін келдім.
Dialogue: 0,0:04:32.07,0:04:35.07,Default,,0,0,0,,Бұл жолы Mio үшін →
Dialogue: 0,0:04:35.07,0:04:39.07,Default,,0,0,0,,Жомарт көмегіңіз үшін көп рахмет.
Dialogue: 0,0:04:39.07,0:04:41.08,Default,,0,0,0,,Жоқ, жоқ, солай...
Dialogue: 0,0:04:41.08,0:04:45.05,Default,,0,0,0,,Шун-кун бізге көмектесіп жатыр.
Dialogue: 0,0:04:45.05,0:04:47.08,Default,,0,0,0,,Бүгін де жақсы өнер көрсеттім.
Dialogue: 0,0:04:47.08,0:04:51.09,Default,,0,0,0,,Өйткені бұл шындық. Бұл жөнінде уайымдамаңыз.
Dialogue: 0,0:04:51.09,0:04:55.16,Default,,0,0,0,,Ах! Сондықтан бұл ақшаны өзіңізге қалдырыңыз.
Dialogue: 0,0:04:55.16,0:04:58.16,Default,,0,0,0,,Қайын ене! Мені қайын енем деп атама.
Dialogue: 0,0:04:59.06,0:05:02.06,Default,,0,0,0,,Мио-чанға көмектесіңізші.
Dialogue: 0,0:05:02.06,0:05:04.07,Default,,0,0,0,,Жақын арада жақсы болады деп үміттенемін.
Dialogue: 0,0:05:04.07,0:05:08.07,Default,,0,0,0,,Иә. Мио әлі сезімін реттеген жоқ →
Dialogue: 0,0:05:08.07,0:05:10.11,Default,,0,0,0,,Сіз бірден ауруханаға жатпасаңыз да →
Dialogue: 0,0:05:10.11,0:05:13.07,Default,,0,0,0,,Біз сіздің сезімдеріңізге шын жүректен ризамыз.
Dialogue: 0,0:05:13.07,0:05:16.18,Default,,0,0,0,,Біз сізді орындалу барысы туралы хабардар етіп отырамыз →
Dialogue: 0,0:05:16.18,0:05:19.08,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:05:19.08,0:05:24.09,Default,,0,0,0,,Мейірімділігіңіз үшін рахмет. Өтінемін, өзіңізді күтіңіз.
Dialogue: 0,0:05:24.09,0:05:27.09,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:05:27.09,0:05:30.09,Default,,0,0,0,,Шун, сәл сөйлесе аламыз ба?
Dialogue: 0,0:05:30.09,0:05:32.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.06,0:05:37.07,Default,,0,0,0,,Мионың аяғы жазылды ма?
Dialogue: 0,0:05:37.07,0:05:41.07,Default,,0,0,0,,Тест тапсыруға барғанымда ауруханаға жатқызу туралы сұрадым.
Dialogue: 0,0:05:41.07,0:05:45.07,Default,,0,0,0,,Сонда бұл жүректің ісі деп ойладым.
Dialogue: 0,0:05:46.07,0:05:49.08,Default,,0,0,0,,Сізде диссоциативті қозғалыс бұзылысы болуы мүмкін.
Dialogue: 0,0:05:49.08,0:05:51.08,Default,,0,0,0,,Диссоциативті…?
Dialogue: 0,0:05:51.08,0:05:55.05,Default,,0,0,0,,Жүрістің психогендік бұзылуы. Бұл психикалық ауру.
Dialogue: 0,0:05:57.09,0:06:00.09,Default,,0,0,0,,Бұл қиын оқиға→
Dialogue: 0,0:06:00.09,0:06:03.09,Default,,0,0,0,,Жауап бірден келмейтін сияқты.→
Dialogue: 0,0:06:03.09,0:06:08.06,Default,,0,0,0,,Егер бұл психикалық мәселе болса, ол шешілмейінше, жаяу жүру жаттығулары алға жылжымайды.
Dialogue: 0,0:06:09.06,0:06:12.07,Default,,0,0,0,,Кенеттен осылай сөйлегенім үшін кешіріңіз.
Dialogue: 0,0:06:12.07,0:06:14.07,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:06:14.07,0:06:18.07,Default,,0,0,0,,Психикалық терапия және дене шынықтыру →
Dialogue: 0,0:06:18.07,0:06:20.14,Default,,0,0,0,,Егер сіз екеуінде де жақсы болсаңыз→
Dialogue: 0,0:06:20.14,0:06:24.08,Default,,0,0,0,,Мен жоғарыда аталған оңалту мекемесімен таныстыру хатын алдым.
Dialogue: 0,0:06:24.08,0:06:27.15,Default,,0,0,0,,Сіз Мионы ауруханаға жатқызасыз ба?
Dialogue: 0,0:06:27.15,0:06:32.19,Default,,0,0,0,,Егер бұл рас болса, өзімді мәжбүрлеуге тура келсе де, мен сені өзіммен бірге алып кеткім келеді.→
Dialogue: 0,0:06:32.19,0:06:35.06,Default,,0,0,0,,Жүрек мәселесі болса →
Dialogue: 0,0:06:35.06,0:06:38.06,Default,,0,0,0,,Адамның көңілі толғаннан кейін ғана...
Dialogue: 0,0:06:49.14,0:06:57.28,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:06:57.28,0:07:00.08,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:07:00.08,0:07:04.09,Default,,0,0,0,,А... Менеджер шақырды.
Dialogue: 0,0:07:04.09,0:07:07.19,Default,,0,0,0,,Сіз қазір фильм түсіріп жатырсыз ба?
Dialogue: 0,0:07:07.19,0:07:09.09,Default,,0,0,0,,Иә. Мен бүгін үйге ерте барамын.
Dialogue: 0,0:07:09.09,0:07:12.16,Default,,0,0,0,,Бос емеспін.
Dialogue: 0,0:07:12.16,0:07:15.06,Default,,0,0,0,,Жоқ, мүлде емес. Олай болса, жүре бер.
Dialogue: 0,0:07:15.06,0:07:17.07,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:07:18.10,0:07:21.07,Default,,0,0,0,,Сонда кездескенше! Тағы да.
Dialogue: 0,0:07:26.11,0:07:28.11,Default,,0,0,0,,Юу Бұл.
Dialogue: 0,0:07:28.11,0:07:30.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.08,0:07:34.08,Default,,0,0,0,,Мен жанкүйерлерден олардың бір-біріне ұқсайтынын айтты.
Dialogue: 0,0:07:34.08,0:07:36.08,Default,,0,0,0,,Сонымен... Бұл ұқсас па?
Dialogue: 0,0:07:36.08,0:07:39.09,Default,,0,0,0,,Мен сіздің жүзіңізді көрмейінше түсінбеймін...
Dialogue: 0,0:07:39.09,0:07:43.16,Default,,0,0,0,,Сен мені алдай аламын деп ойлайсың ба?
Dialogue: 0,0:07:43.16,0:07:47.10,Default,,0,0,0,,Мен бұл біртүрлі болды деп ойладым. Түсірілім кестесі!
Dialogue: 0,0:07:47.10,0:07:52.07,Default,,0,0,0,,Жұмыс күндері сабақтан қалсаңыз да келе аласыз, бірақ сенбі және жексенбі күндері мектептегі іс-шараларды жасай алмайсыз.
Dialogue: 0,0:07:53.10,0:07:56.07,Default,,0,0,0,,Мен тексеріп, сенбі және жексенбі күндері жабық екенін анықтадым →
Dialogue: 0,0:07:56.07,0:07:59.07,Default,,0,0,0,,Мұның бәрі осы ойыншының ойыны күні болды.
Dialogue: 0,0:08:00.08,0:08:03.14,Default,,0,0,0,,Үнсіз кабинетте →
Dialogue: 0,0:08:03.14,0:08:06.08,Default,,0,0,0,,Басқа жерде жұмысқа орналасу→
Dialogue: 0,0:08:06.08,0:08:09.05,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:08:09.05,0:08:11.09,Default,,0,0,0,,Бұл жұмыс емес!
Dialogue: 0,0:08:11.09,0:08:15.09,Default,,0,0,0,,Мен Ю есімін пайдаланбадым және одан ақша да алған жоқпын.
Dialogue: 0,0:08:15.09,0:08:18.19,Default,,0,0,0,,Сіз бұл ақталу деп ойлайсыз! ?
Dialogue: 0,0:08:18.19,0:08:20.06,Default,,0,0,0,,Ол бет-бейнесін көрсетіп БАҚ-қа шығып жатыр!
Dialogue: 0,0:08:20.06,0:08:22.06,Default,,0,0,0,,Мен бетімді жасырамын.
Dialogue: 0,0:08:22.06,0:08:24.07,Default,,0,0,0,,Менің айтып отырғаным бұл емес!
Dialogue: 0,0:08:24.07,0:08:27.07,Default,,0,0,0,,Сіз ұсталсаңыз не болады деп ойлайсыз?
Dialogue: 0,0:08:27.07,0:08:31.07,Default,,0,0,0,,Юудың бейнесі жойылса, ол рөлден шығарылуы мүмкін→
Dialogue: 0,0:08:31.07,0:08:34.08,Default,,0,0,0,,Егер сіз мұны жақсы білмесеңіз, сізге айыппұл салынуы мүмкін!
Dialogue: 0,0:08:36.08,0:08:40.08,Default,,0,0,0,,Қандай жағдай болмасын, шығуды доғар!
Dialogue: 0,0:08:40.08,0:08:43.08,Default,,0,0,0,,Болды... Мен кетсем, команда...
Dialogue: 0,0:08:43.08,0:08:45.05,Default,,0,0,0,,Қазір ең маңызды уақыт...
Dialogue: 0,0:08:45.05,0:08:47.09,Default,,0,0,0,,Сізге де солай емес пе?
Dialogue: 0,0:08:47.09,0:08:49.09,Default,,0,0,0,,Бұл менің бірінші басты рөлім!
Dialogue: 0,0:08:49.09,0:08:53.06,Default,,0,0,0,,Бірақ біз бұл жерде ұтыла алмаймыз.
Dialogue: 0,0:08:53.06,0:08:56.06,Default,,0,0,0,,Ойындар соншалықты маңызды ма?
Dialogue: 0,0:08:56.06,0:08:59.03,Default,,0,0,0,,Бұл маңызды. Бұл маңызды!
Dialogue: 0,0:09:00.07,0:09:04.07,Default,,0,0,0,,Қиын кезде қол ұшын берген адам.
Dialogue: 0,0:09:04.07,0:09:08.08,Default,,0,0,0,,Бұл жолы мен көмектесуім керек...
Dialogue: 0,0:09:09.04,0:09:13.05,Default,,0,0,0,,Олай болса, неге менімен ақылдаспадың?
Dialogue: 0,0:09:15.08,0:09:18.05,Default,,0,0,0,,Сізді қорлағанда→
Dialogue: 0,0:09:18.05,0:09:21.09,Default,,0,0,0,,Мен де қолымнан келгенше көмектесуге тырыстым →
Dialogue: 0,0:09:21.09,0:09:23.06,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:09:24.09,0:09:28.06,Default,,0,0,0,,Иә…. Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:09:29.06,0:09:34.07,Default,,0,0,0,,Маған сенсеңіз жақсы болар еді...
Dialogue: 0,0:09:34.07,0:09:36.07,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:09:36.07,0:09:43.04,Default,,0,0,0,,♬～
Dialogue: 0,0:09:43.04,0:09:45.05,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:09:47.08,0:09:49.25,Default,,0,0,0,,Мен үйдемін...
Dialogue: 0,0:09:49.25,0:09:54.16,Default,,0,0,0,,⚟ (душ дыбысы)
Dialogue: 0,0:09:54.16,0:10:14.18,Default,,0,0,0,,♬～
Dialogue: 0,0:10:14.18,0:10:16.08,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:10:16.08,0:10:19.25,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:10:19.25,0:10:22.05,Default,,0,0,0,,⚟ (қабырғаны түрту дыбысы)
Dialogue: 0,0:10:22.05,0:10:25.15,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:10:25.15,0:10:27.12,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:35.06,0:10:45.07,Default,,0,0,0,,♬～
Dialogue: 0,0:10:45.07,0:10:47.04,Default,,0,0,0,,Кем дегенде….
Dialogue: 0,0:10:54.02,0:10:58.02,Default,,0,0,0,,《Түптеп келгенде, мен бола алатын жалғыз жер осы...》
Dialogue: 0,0:10:58.02,0:10:59.99,Default,,0,0,0,,А…?
Dialogue: 0,0:11:03.02,0:11:04.99,Default,,0,0,0,,Бакурецу мырза.
Dialogue: 0,0:11:06.09,0:11:11.07,Default,,0,0,0,,Мен ояумын, бірақ кейбір мәселелер болуы мүмкін.
Dialogue: 0,0:11:14.07,0:11:18.04,Default,,0,0,0,,Мен саған әпкем жүре алмайды деп бұрын айттым ба?
Dialogue: 0,0:11:18.04,0:11:21.18,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:11:21.18,0:11:23.01,Default,,0,0,0,,Себебі мен ауыстыруды сұрадым →
Dialogue: 0,0:11:23.01,0:11:26.15,Default,,0,0,0,,Мен жол-көлік оқиғасына түстім...
Dialogue: 0,0:11:26.15,0:11:28.02,Default,,0,0,0,,Жазатайым оқиғалар ғана емес→
Dialogue: 0,0:11:28.02,0:11:30.02,Default,,0,0,0,,Мәңгі емделмейді→
Dialogue: 0,0:11:30.02,0:11:32.02,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:11:34.02,0:11:35.99,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:11:35.99,0:11:41.00,Default,,0,0,0,,Білмеймін, бірақ бәріне менің кінәм болды.
Dialogue: 0,0:11:42.03,0:11:46.03,Default,,0,0,0,,үшін үшін...
Dialogue: 0,0:11:46.03,0:11:49.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:11:54.01,0:11:59.01,Default,,0,0,0,,Шун барын салып жатыр. Бұл жерде ештеңе жоқ ...
Dialogue: 0,0:12:00.05,0:12:05.05,Default,,0,0,0,,Ұйқыдағы үкі ROX маған айтып берді. Бұл мен үшін.
Dialogue: 0,0:12:06.02,0:12:12.03,Default,,0,0,0,,«Дәрігерлер де солай айтады...сондықтан бұл рас».
Dialogue: 0,0:12:12.99,0:12:17.00,Default,,0,0,0,,Мен Мионың оңалтуды неге жек көретінін түсіндім деп ойлаймын.
Dialogue: 0,0:12:17.00,0:12:23.04,Default,,0,0,0,,Мионы емдеу үшін Мионы тастау керек...
Dialogue: 0,0:12:23.04,0:12:25.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:26.07,0:12:32.08,Default,,0,0,0,,«Сен ақымақсың... Мен шынымен де ақымақпын...».
Dialogue: 0,0:12:33.01,0:12:35.02,Default,,0,0,0,,Идиот...
Dialogue: 0,0:12:35.02,0:12:39.12,Default,,0,0,0,,Менің жылағанымды естісең ғой...
Dialogue: 0,0:12:39.12,0:12:41.09,Default,,0,0,0,,Неліктен...?
Dialogue: 0,0:12:44.99,0:12:47.03,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:47.03,0:12:52.03,Default,,0,0,0,,О, Шун, мен бүгін дүкеннен тікелей мектепке барамын.
Dialogue: 0,0:12:52.03,0:12:57.01,Default,,0,0,0,,Маған тез арада айтпағандықтан, мен кешкі ас әзірледім.
Dialogue: 0,0:12:57.01,0:13:02.01,Default,,0,0,0,,Мен матчқа дайындалып жатырмын, сондықтан біраз уақыт үйге бара алмай қалуым мүмкін.
Dialogue: 0,0:13:02.01,0:13:05.01,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:13:05.01,0:13:08.02,Default,,0,0,0,,Тағы да құлауға мәжбүрлемеуге тырысыңыз.
Dialogue: 0,0:13:13.02,0:13:17.13,Default,,0,0,0,,Не? Біз жексенбі күні түсіреміз...
Dialogue: 0,0:13:17.13,0:13:19.09,Default,,0,0,0,,Бұл күні ойын бар...
Dialogue: 0,0:13:21.00,0:13:26.03,Default,,0,0,0,,Фотосурет дегеніміз не? Фильмнің хош иісті тақтайшасы бос болса да.
Dialogue: 0,0:13:26.03,0:13:28.04,Default,,0,0,0,,Қараңыз.
Dialogue: 0,0:13:28.04,0:13:30.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:30.04,0:13:34.04,Default,,0,0,0,,Мен коммерциялық жұмысқа орналастым. майор.
Dialogue: 0,0:13:34.04,0:13:37.01,Default,,0,0,0,,Кестені тексермей...
Dialogue: 0,0:13:37.01,0:13:39.01,Default,,0,0,0,,Сәйкестік жоқ, сондықтан бос, солай ма?
Dialogue: 0,0:13:39.01,0:13:41.02,Default,,0,0,0,,Сакагами мырза! ?
Dialogue: 0,0:13:41.02,0:13:46.02,Default,,0,0,0,,Юу, бұл сен үшін ең маңызды уақыт.
Dialogue: 0,0:13:46.02,0:13:49.02,Default,,0,0,0,,Дүние жүзіндегі жұмыс орындарының саны бекітілген.
Dialogue: 0,0:13:49.02,0:13:51.03,Default,,0,0,0,,Ол орындыққа кім отыра алады?
Dialogue: 0,0:13:51.03,0:13:52.99,Default,,0,0,0,,Бұл музыкалық орындықтар ойыны.
Dialogue: 0,0:13:54.03,0:13:57.00,Default,,0,0,0,,Көптеген адамдар тіпті ойынға қатыса алмайды.
Dialogue: 0,0:14:00.03,0:14:02.04,Default,,0,0,0,,Костюм бар, оны жай қалдырыңыз.
Dialogue: 0,0:14:02.04,0:14:05.01,Default,,0,0,0,,Біз сондай-ақ клиенттер үшін үлгілерді аламыз.
Dialogue: 0,0:14:11.05,0:14:13.05,Default,,0,0,0,,А…?
Dialogue: 0,0:14:13.05,0:14:16.05,Default,,0,0,0,,"Кешіріңіз, орын ауыстырылды, сондықтан уақытында жете алмадық."
Dialogue: 0,0:14:16.05,0:14:19.05,Default,,0,0,0,,Юу бүгін жаттығуға келе алмайтын сияқты.
Dialogue: 0,0:14:19.05,0:14:21.06,Default,,0,0,0,,Не, сен түсірілімнен енді келе жатырсың ба?
Dialogue: 0,0:14:21.06,0:14:23.02,Default,,0,0,0,,Жарайды. Жарайды.
Dialogue: 0,0:14:23.02,0:14:25.03,Default,,0,0,0,,Жұмыс Себебі бұл маңызды. (Хабарландыру дыбысы)
Dialogue: 0,0:14:25.03,0:14:27.03,Default,,0,0,0,,«Сіз смартфонда ойнай аласыз»
Dialogue: 0,0:14:27.03,0:14:32.03,Default,,0,0,0,,Смартфоннан...? Олай болса бүгін картаны жаттықтырамыз ба?
Dialogue: 0,0:14:32.03,0:14:34.04,Default,,0,0,0,,Ю онлайн қатысуы керек.
Dialogue: 0,0:14:34.04,0:14:37.04,Default,,0,0,0,,Теңшелетін сәйкестікті жасайық. (Акацуки, Нозоми, Шун) Иә.
Dialogue: 0,0:14:37.04,0:14:43.04,Default,,0,0,0,,♬～
Dialogue: 0,0:14:43.04,0:14:46.05,Default,,0,0,0,,Бұл шынымен де қызықты ма?
Dialogue: 0,0:14:46.05,0:14:52.05,Default,,0,0,0,,♬～
Dialogue: 0,0:14:52.05,0:14:54.06,Default,,0,0,0,,Мұнда шың...→
Dialogue: 0,0:14:54.06,0:14:56.02,Default,,0,0,0,,Қараңғылықтың олжасы!
Dialogue: 0,0:14:56.02,0:14:59.03,Default,,0,0,0,,Мұны іс жүзінде айтудан жалықпайсың ба?
Dialogue: 0,0:14:59.03,0:15:01.03,Default,,0,0,0,,Бұл менің жеке тұлғам!
Dialogue: 0,0:15:01.03,0:15:05.03,Default,,0,0,0,,Не болды? Шун-чан. Әйтеуір қараңғы.
Dialogue: 0,0:15:05.03,0:15:08.04,Default,,0,0,0,,Не? Дегенмен мен әрқашан осылаймын.
Dialogue: 0,0:15:08.04,0:15:11.04,Default,,0,0,0,,Өйткені олай емес.
Dialogue: 0,0:15:11.04,0:15:14.04,Default,,0,0,0,,Мен әрқашан көңілді емеспін, бірақ қараңғы емес.
Dialogue: 0,0:15:14.04,0:15:16.04,Default,,0,0,0,,«Не болды?»
Dialogue: 0,0:15:16.04,0:15:19.05,Default,,0,0,0,,«Мен аздап шаршадым».
Dialogue: 0,0:15:19.05,0:15:22.02,Default,,0,0,0,,"Ей, тоқта! Сен тағы құлайсың".
Dialogue: 0,0:15:22.02,0:15:24.05,Default,,0,0,0,,«Мен білемін».
Dialogue: 0,0:15:24.05,0:15:27.05,Default,,0,0,0,,《Мио-чан үшін уайымдап тұрмын...》
Dialogue: 0,0:15:27.05,0:15:30.02,Default,,0,0,0,,«Шун Донмай»
Dialogue: 0,0:15:30.02,0:15:33.26,Default,,0,0,0,,Қараңдаршы, мен Ю-чан үшін тағы уайымдап отырмын.
Dialogue: 0,0:15:33.26,0:15:36.26,Default,,0,0,0,,Хахаха... Рахмет Юу.
Dialogue: 0,0:15:38.10,0:15:40.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:42.04,0:15:44.04,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:15:49.04,0:15:54.02,Default,,0,0,0,,《Не істеуім керек... Матчқа бара алмаймын деп айта алмаймын...》
Dialogue: 0,0:15:57.12,0:16:00.09,Default,,0,0,0,,⚞ (велосипедтің жүгіру дыбысы)
Dialogue: 0,0:16:02.02,0:16:04.03,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:16:04.03,0:16:05.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:10.10,0:16:13.07,Default,,0,0,0,,⚞ (аяқ дыбысы)
Dialogue: 0,0:16:16.04,0:16:18.01,Default,,0,0,0,,Жеткізу орындалды.
Dialogue: 0,0:16:19.17,0:16:23.14,Default,,0,0,0,,⚞ (Сатоми) Сәлеметсіз бе, тынымсыз еңбегіңіз үшін рахмет. ⚞(Жеткізуші) Кешіріңіз.
Dialogue: 0,0:16:24.05,0:16:26.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:28.02,0:16:30.02,Default,,0,0,0,,Иә. (камера ысырмасының дыбысы)
Dialogue: 0,0:16:31.02,0:16:33.09,Default,,0,0,0,,Иә, бұрыл, маған бер!
Dialogue: 0,0:16:33.09,0:16:35.02,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:16:35.02,0:16:38.03,Default,,0,0,0,,Келесі Қолдарыңызды бүгіңіз. Иә иә...
Dialogue: 0,0:16:38.03,0:16:39.99,Default,,0,0,0,,Қолдарыңызды артқа айналдырыңыз.
Dialogue: 0,0:16:39.99,0:16:43.00,Default,,0,0,0,,А, иә, иә, иә…. Иегіңізді сәл төмен түсіріңіз.
Dialogue: 0,0:16:43.00,0:16:46.03,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:16:46.03,0:16:48.04,Default,,0,0,0,,Жақсы! Сондай сүйкімді.
Dialogue: 0,0:16:48.04,0:16:50.00,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:50.00,0:16:52.01,Default,,0,0,0,,Олай болса, келесісін қолданып көрейік.
Dialogue: 0,0:16:52.01,0:16:54.08,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:54.08,0:16:57.01,Default,,0,0,0,,Түсірілім күні сұхбат болады деп жаңа естідім.
Dialogue: 0,0:16:57.01,0:16:59.18,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:59.18,0:17:03.18,Default,,0,0,0,,Маған бір агенттік журналға сурет салу туралы өтініш білдірді.
Dialogue: 0,0:17:04.12,0:17:06.09,Default,,0,0,0,,Жарайды, мен реттеймін.
Dialogue: 0,0:17:07.02,0:17:11.99,Default,,0,0,0,,О! Ю-чан формада!
Dialogue: 0,0:17:11.99,0:17:13.10,Default,,0,0,0,,Уау, бұл сүйкімді!
Dialogue: 0,0:17:13.10,0:17:17.00,Default,,0,0,0,,Белсенді қызметке сәйкес келмейді.
Dialogue: 0,0:17:17.00,0:17:21.00,Default,,0,0,0,,Эмико Кәсіпқойлармен бәсекелесу – абайсызда!
Dialogue: 0,0:17:23.04,0:17:25.01,Default,,0,0,0,,«Еңбегіңіз үшін рахмет».
Dialogue: 0,0:17:25.01,0:17:27.01,Default,,0,0,0,,«Жұмыстарыңызға сәттілік.»
Dialogue: 0,0:17:27.01,0:17:30.01,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:17:30.01,0:17:38.02,Default,,0,0,0,,♬～
Dialogue: 0,0:17:38.02,0:17:41.99,Default,,0,0,0,,《Шун, саған Юу ұнай ма деп ойлаймын...》
Dialogue: 0,0:17:44.03,0:17:46.99,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:17:46.99,0:18:06.01,Default,,0,0,0,,♬～
Dialogue: 0,0:18:06.01,0:18:26.00,Default,,0,0,0,,♬～
Dialogue: 0,0:18:38.01,0:18:42.02,Default,,0,0,0,,Ертең? Ақырында айта алмадым...
Dialogue: 0,0:18:43.05,0:18:46.05,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:18:46.05,0:18:49.02,Default,,0,0,0,,Неге! неге!
Dialogue: 0,0:18:49.02,0:18:53.03,Default,,0,0,0,,Менің таңдауым жоқ!
Dialogue: 0,0:18:53.03,0:18:56.06,Default,,0,0,0,,Мен актер ретінде жалғастырған жұмысым →
Dialogue: 0,0:18:56.06,0:18:59.03,Default,,0,0,0,,Мен ең маңызды адамды кездестірдім...
Dialogue: 0,0:19:00.03,0:19:03.04,Default,,0,0,0,,Екеуміздің де саған опасыздық жасай алмаймыз!
Dialogue: 0,0:19:03.04,0:19:08.04,Default,,0,0,0,,Бірақ... неге...?
Dialogue: 0,0:19:08.04,0:19:12.01,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:15.05,0:19:17.05,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:19:18.05,0:19:20.09,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:19:20.09,0:19:22.02,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:22.02,0:19:25.03,Default,,0,0,0,,Неліктен мұндай уақытта...?
Dialogue: 0,0:19:28.10,0:19:32.03,Default,,0,0,0,,(Ұялы телефон дабылы)
Dialogue: 0,0:19:32.03,0:19:37.04,Default,,0,0,0,,(Ұялы телефон дабылы)
Dialogue: 0,0:19:37.04,0:19:39.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:39.04,0:19:42.01,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:19:42.01,0:19:49.02,Default,,0,0,0,,(Ұялы телефон дабылы)
Dialogue: 0,0:19:50.05,0:19:52.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:53.05,0:19:55.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:01.03,0:20:07.03,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:20:09.04,0:20:11.04,Default,,0,0,0,,Жаңбыр….
Dialogue: 0,0:20:12.04,0:20:14.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:17.01,0:20:19.01,Default,,0,0,0,,Түсірілім тоқтатылды!
Dialogue: 0,0:20:21.02,0:20:23.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:27.05,0:20:29.02,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:20:31.03,0:20:33.03,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:20:33.03,0:20:37.03,Default,,0,0,0,,Финалдық лига матчы 5-шақыру ойыны.
Dialogue: 0,0:20:37.03,0:20:41.04,Default,,0,0,0,,Біз қатты қабықты шаянмен жарысамыз →
Dialogue: 0,0:20:41.04,0:20:43.04,Default,,0,0,0,,Ｔｅａｍ ＦＯＸ ＯＮＥ！
Dialogue: 0,0:20:43.04,0:20:47.04,Default,,0,0,0,,Бұл матчта кім жеңеді?
Dialogue: 0,0:20:47.04,0:20:50.01,Default,,0,0,0,,А жоспары жоспарланғандай.
Dialogue: 0,0:20:50.01,0:20:53.05,Default,,0,0,0,,Ол жігіттер жалап жатқандарға шабуыл жасайды→
Dialogue: 0,0:20:53.05,0:20:55.05,Default,,0,0,0,,Өйткені сіздің қорғанысыңыз әлсіз болады.
Dialogue: 0,0:20:55.05,0:20:57.02,Default,,0,0,0,,ＣＯＰＹ！
Dialogue: 0,0:20:58.05,0:21:00.02,Default,,0,0,0,,《Мен күйзелдім》
Dialogue: 0,0:21:00.02,0:21:02.02,Default,,0,0,0,,《Мен сені қолымнан келгенше ұрамын! 》
Dialogue: 0,0:21:05.03,0:21:06.99,Default,,0,0,0,,Шун.
Dialogue: 0,0:21:09.00,0:21:11.00,Default,,0,0,0,,Ештеңені ойламаңыз. иә?
Dialogue: 0,0:21:12.03,0:21:14.00,Default,,0,0,0,,Өлгенде бірге боламыз.
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:21:31.09,0:21:45.07,Default,,0,0,0,,♬～
