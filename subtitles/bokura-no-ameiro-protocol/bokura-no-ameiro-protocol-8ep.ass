Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.11,0:00:15.11,Default,,0,0,0,,«(мылтық)»
Dialogue: 0,0:00:15.11,0:00:17.11,Default,,0,0,0,,Жойылды! Қабырғаның ар жағындағы жау!
Dialogue: 0,0:00:17.11,0:00:19.11,Default,,0,0,0,,Иә! ? Қайда?
Dialogue: 0,0:00:19.11,0:00:22.12,Default,,0,0,0,,A бос! Өшіргіш бірден орнатылды!
Dialogue: 0,0:00:22.12,0:00:24.12,Default,,0,0,0,,А-ға келіңіз.
Dialogue: 0,0:00:28.12,0:00:30.09,Default,,0,0,0,,«(мылтық)»
Dialogue: 0,0:00:30.09,0:00:32.16,Default,,0,0,0,,Тасымалдаушы төмен A!
Dialogue: 0,0:00:32.16,0:00:34.13,Default,,0,0,0,,Мен жеңілдім! Біреу алып кетсін!
Dialogue: 0,0:00:34.13,0:00:36.10,Default,,0,0,0,,Жоқ. Менің енді уақытым жоқ!
Dialogue: 0,0:00:36.10,0:00:38.13,Default,,0,0,0,,Қауіпті өзіңізге жүктеңіз!
Dialogue: 0,0:00:38.13,0:00:41.10,Default,,0,0,0,,Кеттік! (Yuu) Көшбасшы болыңыз. Келесі!
Dialogue: 0,0:00:41.10,0:00:43.11,Default,,0,0,0,,«(Мылтық)» (Юу) Мен жеңілдім!
Dialogue: 0,0:00:44.11,0:00:46.11,Default,,0,0,0,,Өшіргіш!
Dialogue: 0,0:00:46.11,0:00:48.11,Default,,0,0,0,,Уау! уақытында болуы мүмкін емес!
Dialogue: 0,0:00:49.11,0:00:51.11,Default,,0,0,0,,(тоқтату сигналы)
Dialogue: 0,0:00:51.11,0:00:53.12,Default,,0,0,0,,Міне, уақыт бітті!
Dialogue: 0,0:00:53.12,0:00:55.12,Default,,0,0,0,,ҰШҚАН МАНТА үшін жеңіс!
Dialogue: 0,0:00:55.12,0:00:59.12,Default,,0,0,0,,FOX ONE командасы ширек финалда жеңілді!
Dialogue: 0,0:00:59.12,0:01:02.19,Default,,0,0,0,,Қақпа...!
Dialogue: 0,0:01:02.19,0:01:04.13,Default,,0,0,0,,...
Dialogue: 0,0:01:04.13,0:01:06.09,Default,,0,0,0,,Ｃｈａｌｌｅｎｇｅｒｓ Ｓｔａｇｅ １→
Dialogue: 0,0:01:06.09,0:01:08.10,Default,,0,0,0,,Үздік 8 топ анықталды!
Dialogue: 0,0:01:09.10,0:01:12.23,Default,,0,0,0,,FOX ONE жоғалды.
Dialogue: 0,0:01:12.23,0:01:14.10,Default,,0,0,0,,Жақсы жол Мен осылай айтып едім.
Dialogue: 0,0:01:14.10,0:01:17.24,Default,,0,0,0,,...Е, осылай ұтыласың.
Dialogue: 0,0:01:17.24,0:01:19.11,Default,,0,0,0,,Иә? Сейши стилі→
Dialogue: 0,0:01:19.11,0:01:22.21,Default,,0,0,0,,FON ONE жеңілгенін көргіңіз келмей ме?
Dialogue: 0,0:01:22.21,0:01:26.11,Default,,0,0,0,,Осындай аянышты түрде жеңілгеніме одан бетер ашуланады!
Dialogue: 0,0:01:26.11,0:01:28.15,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:01:28.15,0:01:31.12,Default,,0,0,0,,Менің сүйікті адамымды жұмыстан шығарып, осы денеде жұмыс істеңіз ...
Dialogue: 0,0:01:32.25,0:01:36.22,Default,,0,0,0,,FOX ONE Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:01:37.16,0:01:51.17,Default,,0,0,0,,♬～
Dialogue: 0,0:03:07.08,0:03:09.05,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:03:09.05,0:03:13.06,Default,,0,0,0,,Про-Лиганың іріктеу матчы Бірінші турнир: 15 орын...
Dialogue: 0,0:03:14.09,0:03:16.09,Default,,0,0,0,,Жиналған ұпайлар нөлге тең бе?
Dialogue: 0,0:03:16.09,0:03:19.23,Default,,0,0,0,,Бұлай болса, мен финалға өте алмаймын...
Dialogue: 0,0:03:19.23,0:03:23.10,Default,,0,0,0,,Ең жақсы 12 команда финалға шақырылады.
Dialogue: 0,0:03:23.10,0:03:25.07,Default,,0,0,0,,Егер сіз 15-ші орында болсаңыз, сіз ауқымнан тыссыз.
Dialogue: 0,0:03:25.07,0:03:29.20,Default,,0,0,0,,Не, тағы екі Челленджер кезеңі бар!
Dialogue: 0,0:03:29.20,0:03:32.07,Default,,0,0,0,,Жеңіске жетсеңіз 200 ұпай аласыз→
Dialogue: 0,0:03:32.07,0:03:34.21,Default,,0,0,0,,Екі рет де жеңсең, оңай жеңіс болады!
Dialogue: 0,0:03:34.21,0:03:36.08,Default,,0,0,0,,Оңай айтпа.
Dialogue: 0,0:03:36.08,0:03:39.08,Default,,0,0,0,,Бір рет жеңу қиын болса да...
Dialogue: 0,0:03:40.08,0:03:42.05,Default,,0,0,0,,Көңіл-күйімізді көтерейік!
Dialogue: 0,0:03:42.05,0:03:45.05,Default,,0,0,0,,Мио-чанды ауруханаға жатқызғыңыз келеді, солай ма?
Dialogue: 0,0:03:46.09,0:03:50.06,Default,,0,0,0,,Әрине кәсіпқой лигаға қосылып, ақшалай сыйлық алғым келеді →
Dialogue: 0,0:03:50.06,0:03:52.06,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:03:53.10,0:03:55.10,Default,,0,0,0,,Рухпен жеңе алсаң, қиналмайсың.
Dialogue: 0,0:03:55.10,0:03:58.07,Default,,0,0,0,,Не! ? Тіпті жаудың да оқ жаудыруы.
Dialogue: 0,0:03:58.07,0:04:00.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:00.07,0:04:04.07,Default,,0,0,0,,Мен де Миочанның жүре алатынын қалаймын.
Dialogue: 0,0:04:04.07,0:04:07.08,Default,,0,0,0,,Бірақ тек ойлану арқылы жеңіске жету мүмкін емес.
Dialogue: 0,0:04:07.08,0:04:11.08,Default,,0,0,0,,Сондықтан біз қалай дұрыс жеңіске жетеміз деп ойлануымыз керек.
Dialogue: 0,0:04:11.08,0:04:14.05,Default,,0,0,0,,Иә. Рахмет Юу.
Dialogue: 0,0:04:15.08,0:04:18.05,Default,,0,0,0,,Бөлек. Өйткені, әрине...
Dialogue: 0,0:04:31.10,0:04:33.10,Default,,0,0,0,,《болды》
Dialogue: 0,0:04:33.10,0:04:35.17,Default,,0,0,0,,Бүгін үйге бармайсың ба?
Dialogue: 0,0:04:35.17,0:04:38.07,Default,,0,0,0,,Иә? Нозоми әпкесі.
Dialogue: 0,0:04:38.07,0:04:42.08,Default,,0,0,0,,Өзіңді қатты итерсең, қайтадан құлайсың. Кешкі ас іштің бе?
Dialogue: 0,0:04:42.08,0:04:45.15,Default,,0,0,0,,Иә. Мен оны түсіндім. иә?
Dialogue: 0,0:04:45.15,0:04:47.08,Default,,0,0,0,,Карри? Тек Лу! ?
Dialogue: 0,0:04:47.08,0:04:50.09,Default,,0,0,0,,Зейінді шоғырландыру қажет болғанда жақсы.
Dialogue: 0,0:04:51.09,0:04:54.09,Default,,0,0,0,,Уф…. Маған қарсы емес →
Dialogue: 0,0:04:54.09,0:04:57.06,Default,,0,0,0,,Тамақтану кезінде дұрыс тамақтануды қадағалаңыз. Иә.
Dialogue: 0,0:05:01.10,0:05:03.10,Default,,0,0,0,,Мм... қалай айтайын...→
Dialogue: 0,0:05:03.10,0:05:05.17,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:05:05.17,0:05:07.17,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:05:08.07,0:05:10.17,Default,,0,0,0,,Топты қараңыз→
Dialogue: 0,0:05:10.17,0:05:13.07,Default,,0,0,0,,Менімен жақсы араласпайтын адамдар бар, сондықтан мен ойланамын.
Dialogue: 0,0:05:13.07,0:05:16.11,Default,,0,0,0,,Ах! Маған ол кісі аздап ұнауы мүмкін.
Dialogue: 0,0:05:16.11,0:05:18.11,Default,,0,0,0,,Иә! ? Ашық болса да →
Dialogue: 0,0:05:18.11,0:05:21.12,Default,,0,0,0,,Мио туралы: Назар аударғаныңыз үшін рахмет...
Dialogue: 0,0:05:21.12,0:05:23.08,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:05:23.08,0:05:26.09,Default,,0,0,0,,Ол кейде қатал, бірақ ол негізінен жақсы адам.
Dialogue: 0,0:05:26.09,0:05:28.09,Default,,0,0,0,,Мен сөйлесу арқылы айта аламын.
Dialogue: 0,0:05:28.09,0:05:30.19,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:30.19,0:05:33.09,Default,,0,0,0,,Сіз қызық адамсыз, Данеко-сан.
Dialogue: 0,0:05:33.09,0:05:35.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:35.13,0:05:37.10,Default,,0,0,0,,Шын аты және ойыншының аты →
Dialogue: 0,0:05:37.10,0:05:40.10,Default,,0,0,0,,Қайсысына хабарласарымды білмей абдырап қаламын.
Dialogue: 0,0:05:41.07,0:05:43.10,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:05:43.10,0:05:46.07,Default,,0,0,0,,Ю да.
Dialogue: 0,0:05:46.07,0:05:51.08,Default,,0,0,0,,Оның да командаға көмектескеніне өте ризамын.
Dialogue: 0,0:05:51.08,0:05:54.08,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:05:54.08,0:05:57.05,Default,,0,0,0,,Матчтарда да жақсы жерлерде қолдау көрсетеді→
Dialogue: 0,0:05:57.05,0:06:01.09,Default,,0,0,0,,Бір-бірімізбен жақсы араласатын сияқтымыз, дәлірек айтсақ, мен сізге бір нәрсені қалдыратын сияқтымын.
Dialogue: 0,0:06:01.09,0:06:03.09,Default,,0,0,0,,Нозоми-не сияқты.
Dialogue: 0,0:06:03.09,0:06:05.06,Default,,0,0,0,,Иә? мен! ?
Dialogue: 0,0:06:05.06,0:06:08.06,Default,,0,0,0,,Иә. Ол мен өзімді еркін сезінетін адам сияқты.
Dialogue: 0,0:06:09.10,0:06:11.07,Default,,0,0,0,,《Бұл нені білдіреді? 》
Dialogue: 0,0:06:11.07,0:06:14.07,Default,,0,0,0,,《Сізге ұнады дейсіз бе? Мен? 》
Dialogue: 0,0:06:14.07,0:06:16.07,Default,,0,0,0,,《Юу емес пе? 》
Dialogue: 0,0:06:16.07,0:06:19.07,Default,,0,0,0,,《Иә! ? 》 (Хабарландыру дыбысы)
Dialogue: 0,0:06:19.07,0:06:22.04,Default,,0,0,0,,А, міне, осында. иә? ДДСҰ?
Dialogue: 0,0:06:23.08,0:06:26.05,Default,,0,0,0,,Йо Бакурецу-кун.
Dialogue: 0,0:06:27.08,0:06:29.05,Default,,0,0,0,,《Еңбегіңіз үшін рахмет》
Dialogue: 0,0:06:30.09,0:06:33.05,Default,,0,0,0,,"15-орынға нөл ұпай. Мүлде жоқ."
Dialogue: 0,0:06:33.05,0:06:35.06,Default,,0,0,0,,《Келесі жолы барымызды салайық》
Dialogue: 0,0:06:36.12,0:06:38.06,Default,,0,0,0,,«Рахмет»
Dialogue: 0,0:06:38.06,0:06:42.06,Default,,0,0,0,,《Шун мені ұната ма? 》
Dialogue: 0,0:06:45.07,0:06:47.07,Default,,0,0,0,,«Иә, сен маған ұнайсың».
Dialogue: 0,0:06:47.07,0:06:50.07,Default,,0,0,0,,Мм! Мен де!
Dialogue: 0,0:06:51.21,0:06:53.07,Default,,0,0,0,,«Мен де»?
Dialogue: 0,0:06:53.07,0:06:55.08,Default,,0,0,0,,Жоқ! Ум...!
Dialogue: 0,0:06:55.08,0:06:57.08,Default,,0,0,0,,Мен де, мен де, мен де….
Dialogue: 0,0:06:57.08,0:07:00.08,Default,,0,0,0,,«Мен ағып кеткен ойын жүлдесі →
Dialogue: 0,0:07:00.08,0:07:02.05,Default,,0,0,0,,Мен көп нәрсені алғандықтан қиыншылыққа тап болдым».
Dialogue: 0,0:07:03.05,0:07:05.09,Default,,0,0,0,,«Мен шынымен түсінбеймін, бірақ бұл қиын».
Dialogue: 0,0:07:05.09,0:07:08.06,Default,,0,0,0,,《Аа... мен оны жеңіп шықтым》
Dialogue: 0,0:07:08.06,0:07:11.09,Default,,0,0,0,,«Мен енді біреумен таныспын».
Dialogue: 0,0:07:11.09,0:07:13.06,Default,,0,0,0,,«Бір сәтке шық».
Dialogue: 0,0:07:13.06,0:07:15.10,Default,,0,0,0,,«Мм... Бакурецу-кун?»
Dialogue: 0,0:07:15.10,0:07:17.07,Default,,0,0,0,,«I 656»
Dialogue: 0,0:07:17.07,0:07:20.07,Default,,0,0,0,,Не? Нозоми менімен біргесің бе?
Dialogue: 0,0:07:20.07,0:07:24.07,Default,,0,0,0,,«Біраз уақыт өтті. Біз бірінші рет сөйлесіп тұрмыз».
Dialogue: 0,0:07:26.07,0:07:29.08,Default,,0,0,0,,Үш жылдан астам уақыт өтті емес пе?
Dialogue: 0,0:07:29.08,0:07:31.05,Default,,0,0,0,,Бейне қоңырау шала алмаймын ба?
Dialogue: 0,0:07:34.15,0:07:36.05,Default,,0,0,0,,Олай болса, көмектесу мүмкін емес.
Dialogue: 0,0:07:36.05,0:07:40.06,Default,,0,0,0,,Қазір, өткеннің бәрі кәсіби маман болу үшін аянбай еңбек етуде.
Dialogue: 0,0:07:40.06,0:07:43.06,Default,,0,0,0,,Бакурецу-кун, сенімен мұны істегенімді қалаймын.
Dialogue: 0,0:07:46.06,0:07:48.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:48.06,0:07:51.07,Default,,0,0,0,,Сіз Антарктидадасыз ба? иә? Шынымен бе?
Dialogue: 0,0:07:52.07,0:07:55.07,Default,,0,0,0,,«Ол ақ аюлармен дос. Сондай-ақ пингвиндер де».
Dialogue: 0,0:07:55.07,0:07:58.07,Default,,0,0,0,,«Бұл хайуанаттар бағы емес пе?»
Dialogue: 0,0:07:58.07,0:08:01.14,Default,,0,0,0,,«Әйтеуір, алыста жүрген сияқтысың...»
Dialogue: 0,0:08:01.14,0:08:03.08,Default,,0,0,0,,"Жоқ! Мен карриді төгіп алдым."
Dialogue: 0,0:08:03.08,0:08:05.08,Default,,0,0,0,,«Сіз не істеп жатырсыз?»
Dialogue: 0,0:08:05.08,0:08:07.08,Default,,0,0,0,,"Шешіңіз! Мен жуамын". Ха! ?
Dialogue: 0,0:08:07.08,0:08:09.15,Default,,0,0,0,,«Жарайды, оны өшіріп таста...»
Dialogue: 0,0:08:09.15,0:08:12.15,Default,,0,0,0,,"Жоқ! Ол құламайды. Жүр, тезірек!"
Dialogue: 0,0:08:12.15,0:08:16.06,Default,,0,0,0,,"Уау! Кешіріңіз, Бакурецу-кун. Кішкене қиыншылық."
Dialogue: 0,0:08:16.06,0:08:18.06,Default,,0,0,0,,«Сен шынымен ебедейсің!»
Dialogue: 0,0:08:19.06,0:08:21.06,Default,,0,0,0,,Бірақ Бакурецу-кунмен→
Dialogue: 0,0:08:21.06,0:08:24.07,Default,,0,0,0,,Осылай қайта қосыла алғанымызға қуаныштымын.
Dialogue: 0,0:08:24.07,0:08:26.07,Default,,0,0,0,,Иә! Қайтадан бәріміз бірге ойнайық!
Dialogue: 0,0:08:29.07,0:08:32.04,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:08:37.18,0:08:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.08,0:08:41.08,Default,,0,0,0,,Қандай да бір қиындық бар ма?
Dialogue: 0,0:08:41.08,0:08:43.05,Default,,0,0,0,,Бакурецу-кун, сен мені естисің бе?
Dialogue: 0,0:08:45.09,0:08:47.06,Default,,0,0,0,,Ол сынған сияқты.
Dialogue: 0,0:08:48.06,0:08:52.23,Default,,0,0,0,,О, қазірдің өзінде! Мен сені соңғы рет көрмегелі көп уақыт өтті.
Dialogue: 0,0:08:52.23,0:08:54.10,Default,,0,0,0,,Біз қайтадан қосыламыз.
Dialogue: 0,0:08:54.10,0:08:56.10,Default,,0,0,0,,Қане бәріміз бірге ойнайық.
Dialogue: 0,0:08:56.10,0:08:58.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:04.07,0:09:08.04,Default,,0,0,0,,Екеуміз ғана болғанымызға қарамастан...
Dialogue: 0,0:09:10.08,0:09:14.08,Default,,0,0,0,,Мм...! !
Dialogue: 0,0:09:17.12,0:09:20.12,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:09:21.09,0:09:24.06,Default,,0,0,0,,Кіруге мүмкіндік жоқ па?
Dialogue: 0,0:09:27.06,0:09:29.06,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:09:29.06,0:09:31.07,Default,,0,0,0,,Сіздің анаңыз жұмыс істей ме?
Dialogue: 0,0:09:32.07,0:09:35.07,Default,,0,0,0,,Бұл ерте ауысу. Тамақ дайын.
Dialogue: 0,0:09:36.10,0:09:38.11,Default,,0,0,0,,Сіздің бетіңіз ше?
Dialogue: 0,0:09:38.11,0:09:40.08,Default,,0,0,0,,Жуылған.
Dialogue: 0,0:09:40.08,0:09:42.08,Default,,0,0,0,,Біз тамақ ішеміз бе?
Dialogue: 0,0:09:42.08,0:09:44.08,Default,,0,0,0,,Иә! иә.
Dialogue: 0,0:09:45.11,0:09:47.08,Default,,0,0,0,,Сейно….
Dialogue: 0,0:09:47.08,0:09:49.12,Default,,0,0,0,,Ауыр емес пе?
Dialogue: 0,0:09:49.12,0:09:51.09,Default,,0,0,0,,Ол жеңілірек болды.
Dialogue: 0,0:09:51.09,0:09:53.09,Default,,0,0,0,,Өтірік. Мен салмақ қосып алсам да.
Dialogue: 0,0:09:53.09,0:09:58.06,Default,,0,0,0,,Сонымен, сіз бұлшық ет жинадыңыз деп ойлаймын. Дүкенде көп заттарды алып жүремін.
Dialogue: 0,0:09:58.06,0:10:00.06,Default,,0,0,0,,Ах. не?
Dialogue: 0,0:10:01.10,0:10:03.10,Default,,0,0,0,,Иістер.
Dialogue: 0,0:10:03.10,0:10:05.17,Default,,0,0,0,,Не? Бұл дұрыс емес, солай ма?
Dialogue: 0,0:10:05.17,0:10:08.17,Default,,0,0,0,,Иістер. Иісі менің жуғыш затыма ұқсамайды.
Dialogue: 0,0:10:08.17,0:10:12.07,Default,,0,0,0,,Аа... Кеше көйлегімнің үстіне карри төктім →
Dialogue: 0,0:10:12.07,0:10:14.08,Default,,0,0,0,,Нозоми-не оны мен үшін жуды.
Dialogue: 0,0:10:16.08,0:10:18.21,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:18.21,0:10:20.08,Default,,0,0,0,,Ол құлап жатқан жоқ. иә?
Dialogue: 0,0:10:20.08,0:10:22.08,Default,,0,0,0,,Ол шықпайды. Бұл кір.
Dialogue: 0,0:10:22.08,0:10:25.09,Default,,0,0,0,,Жоқ, құлап жатыр...
Dialogue: 0,0:10:25.09,0:10:28.26,Default,,0,0,0,,Мен оны қайтадан жуамын, сондықтан басқа киім киіңіз.
Dialogue: 0,0:10:28.26,0:10:30.09,Default,,0,0,0,,Жарайды. Мен білмеймін.
Dialogue: 0,0:10:30.09,0:10:33.06,Default,,0,0,0,,Түсіндім! Жарайды, киіміңді ауыстыр!
Dialogue: 0,0:10:34.10,0:10:36.06,Default,,0,0,0,,Ах... ах.
Dialogue: 0,0:10:37.10,0:10:39.10,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:10:39.10,0:10:43.07,Default,,0,0,0,,Хмм... Мен көбірек жаттығу керек сияқты.
Dialogue: 0,0:10:43.07,0:10:46.07,Default,,0,0,0,,Олай емес, ағамның физикалық жағдайы.
Dialogue: 0,0:10:46.07,0:10:51.11,Default,,0,0,0,,Не? О, жарайды. Мен жақсымын, мен жақсымын.
Dialogue: 0,0:10:51.11,0:10:53.08,Default,,0,0,0,,Сіз кәсіпқой болғыңыз келе ме?
Dialogue: 0,0:10:53.08,0:10:55.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:55.08,0:10:58.05,Default,,0,0,0,,Сіз шынымен киберспорттың кәсіби ойыншысы болғыңыз келе ме?
Dialogue: 0,0:10:58.05,0:11:02.06,Default,,0,0,0,,Ах. Сосын мен Мионың ауруханаға жатқызылуына көп ақша таптым...
Dialogue: 0,0:11:02.06,0:11:04.06,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:11:04.06,0:11:07.06,Default,,0,0,0,,Маған қарамастан кәсіпқой болғыңыз келе ме?
Dialogue: 0,0:11:08.13,0:11:10.13,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:11:12.07,0:11:14.14,Default,,0,0,0,,Мен жеңіліп қалсам ғой.
Dialogue: 0,0:11:14.14,0:11:16.07,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:11:16.07,0:11:18.07,Default,,0,0,0,,Мен жеңіліп, профессионал бола алмасам ше→
Dialogue: 0,0:11:18.07,0:11:20.07,Default,,0,0,0,,Мен де ауруханаға жатудың қажеті жоқ→
Dialogue: 0,0:11:20.07,0:11:23.08,Default,,0,0,0,,Сіздің ағаңыз үйге жиі келеді.
Dialogue: 0,0:11:23.08,0:11:25.05,Default,,0,0,0,,Мио….
Dialogue: 0,0:11:27.08,0:11:29.08,Default,,0,0,0,,Жоғалтпа.
Dialogue: 0,0:11:31.09,0:11:33.05,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:11:34.12,0:11:37.06,Default,,0,0,0,,Ах! Қат! Мен тағы да жеңілемін!
Dialogue: 0,0:11:37.06,0:11:39.23,Default,,0,0,0,,Уау! Неге...
Dialogue: 0,0:11:39.23,0:11:41.06,Default,,0,0,0,,Бүгінгі тәжірибе серіктесі→
Dialogue: 0,0:11:41.06,0:11:44.07,Default,,0,0,0,,Менің ойымша, бұл команда соншалықты күшті емес еді...
Dialogue: 0,0:11:45.07,0:11:49.17,Default,,0,0,0,,Жеңіске жете алмасаңыз, кәсіби лигаға қосыла алмайсыз.
Dialogue: 0,0:11:49.17,0:11:53.11,Default,,0,0,0,,Жоқ, мен қиындыққа тап болдым! Мен дүкеннің қарызын өтей алмаймын!
Dialogue: 0,0:11:53.11,0:11:55.08,Default,,0,0,0,,...Ахокуса!
Dialogue: 0,0:11:58.08,0:12:00.08,Default,,0,0,0,,Бұлай жеңу мүмкін емес.
Dialogue: 0,0:12:00.08,0:12:02.05,Default,,0,0,0,,Тоқта, Хошиширю.
Dialogue: 0,0:12:03.08,0:12:05.05,Default,,0,0,0,,Мұны естігенде кәсіпқойлар таң қалады.
Dialogue: 0,0:12:05.05,0:12:08.06,Default,,0,0,0,,Бұл топты тарату керек! еріту!
Dialogue: 0,0:12:10.29,0:12:12.16,Default,,0,0,0,,Таку…. Мен ойынды қарап отырдым →
Dialogue: 0,0:12:12.16,0:12:15.06,Default,,0,0,0,,Мен күткеннен де бейберекет болғанына таң қалдым.
Dialogue: 0,0:12:15.06,0:12:18.07,Default,,0,0,0,,А...? А, тұтынушы?
Dialogue: 0,0:12:18.07,0:12:20.03,Default,,0,0,0,,Қалғандары бар ма? (Юу) О, жоқ...
Dialogue: 0,0:12:21.07,0:12:24.07,Default,,0,0,0,,Кешіріңіз. Біз бүгін жабықпыз.
Dialogue: 0,0:12:24.07,0:12:27.08,Default,,0,0,0,,Жоқ, киберспорт кафесі сағат 7-де жабылатыны қызық!
Dialogue: 0,0:12:27.08,0:12:29.08,Default,,0,0,0,,Сіздің бизнеспен айналысуға ниетіңіз бар ма?
Dialogue: 0,0:12:29.08,0:12:33.05,Default,,0,0,0,,Міне, бұл аудан ауылдық жерде.
Dialogue: 0,0:12:33.05,0:12:37.09,Default,,0,0,0,,Ерте ашылатын дүкендер сағат 4-тер шамасында жабылады, солай ма?
Dialogue: 0,0:12:37.09,0:12:40.09,Default,,0,0,0,,Ондай жерде киберспорт кафесін жүргізбеңіз!
Dialogue: 0,0:12:40.09,0:12:42.16,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:12:42.16,0:12:45.09,Default,,0,0,0,,Иә! ? Сен әкеңнің жағында емессің бе?
Dialogue: 0,0:12:45.09,0:12:48.10,Default,,0,0,0,,Әкең – бар жамандықтың тамыры.
Dialogue: 0,0:12:48.10,0:12:51.10,Default,,0,0,0,,Дүкен берекелі болса, қарыз болмас еді.
Dialogue: 0,0:12:51.10,0:12:53.10,Default,,0,0,0,,Не? сол.
Dialogue: 0,0:12:53.10,0:12:56.07,Default,,0,0,0,,Бұл жалғастыру үшін ақшаны қарызға алатындай команда емес.
Dialogue: 0,0:12:56.07,0:12:58.11,Default,,0,0,0,,Бұл емес →
Dialogue: 0,0:12:58.11,0:13:02.11,Default,,0,0,0,,Бұл қарыздарды өтеу үшін жұмысын жалғастыратын команда.
Dialogue: 0,0:13:02.11,0:13:04.08,Default,,0,0,0,,Не! ? Мен бұған сене алмадым...
Dialogue: 0,0:13:04.08,0:13:08.08,Default,,0,0,0,,Сонда мүшелер қарызға байланысты ауыстырылды ма?
Dialogue: 0,0:13:08.08,0:13:10.08,Default,,0,0,0,,Осыны айтпай кете алмаймын.
Dialogue: 0,0:13:10.08,0:13:13.12,Default,,0,0,0,,Менің айтарым осы ғана.
Dialogue: 0,0:13:13.12,0:13:17.09,Default,,0,0,0,,Сіз менің таңдаулыларымды қарызбен қуып, әуесқойларды кіргізіп жатырсыз ба?
Dialogue: 0,0:13:17.09,0:13:19.09,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:13:19.09,0:13:21.06,Default,,0,0,0,,(Ер адам) Гваааах! (Әйел) Ааах!
Dialogue: 0,0:13:21.06,0:13:24.10,Default,,0,0,0,,Тіпті алдыңғы мүшелер де ұтып кете алмады, солай ма?
Dialogue: 0,0:13:24.10,0:13:27.07,Default,,0,0,0,,Чемпионаттың жартылай финалына шықтық →
Dialogue: 0,0:13:27.07,0:13:30.07,Default,,0,0,0,,Біз тіпті жергілікті турнирде де жеңіске жеттік!
Dialogue: 0,0:13:30.07,0:13:32.11,Default,,0,0,0,,Бұл жаман емес!
Dialogue: 0,0:13:32.11,0:13:34.11,Default,,0,0,0,,Өте өкінішті! Алдыңғы FOX ONE командасы →
Dialogue: 0,0:13:34.11,0:13:37.08,Default,,0,0,0,,Бұл әлдеқайда жақсы команда болды!
Dialogue: 0,0:13:37.08,0:13:39.08,Default,,0,0,0,,Ойын ішіндегі жетекші →
Dialogue: 0,0:13:39.08,0:13:41.08,Default,,0,0,0,,ДЖОНАТАН, ащы сымбатты жігіт!
Dialogue: 0,0:13:41.08,0:13:45.09,Default,,0,0,0,,Жынданып қалса салқын жігіттердің ШОУ-5!
Dialogue: 0,0:13:45.09,0:13:48.09,Default,,0,0,0,,ГУНТаның сүйкімді бала күлкісі бар!
Dialogue: 0,0:13:48.09,0:13:52.09,Default,,0,0,0,,Азғыруды және шабуыл жасауды жек көретін ханшайымға ұқсайтын бала, Тастанды Бем!
Dialogue: 0,0:13:52.09,0:13:54.10,Default,,0,0,0,,Және ең →
Dialogue: 0,0:13:54.10,0:13:56.06,Default,,0,0,0,,Менің сүйікті Юрукки!
Dialogue: 0,0:13:57.07,0:13:59.10,Default,,0,0,0,,Әрі қарай өседі→
Dialogue: 0,0:13:59.10,0:14:02.10,Default,,0,0,0,,Бұл бірегей тұлғаларға толы тамаша команда болды!
Dialogue: 0,0:14:02.10,0:14:04.07,Default,,0,0,0,,Егер сіз жеке адам болсаңыз →
Dialogue: 0,0:14:04.07,0:14:06.21,Default,,0,0,0,,Біз де жеңілмейміз! (Барлығы) иә?
Dialogue: 0,0:14:06.21,0:14:10.08,Default,,0,0,0,,Бір қарағанда, ол парасатты адам сияқты көрінуі мүмкін, бірақ ол өте улы →
Dialogue: 0,0:14:10.08,0:14:13.08,Default,,0,0,0,,Киберспорт әлеміндегі африкалық улы бақа→
Dialogue: 0,0:14:13.08,0:14:15.08,Default,,0,0,0,,656! Ха! ?
Dialogue: 0,0:14:15.08,0:14:20.09,Default,,0,0,0,,Үндемегенде сүйкімді, ал аузын ашса дөрекі және дөрекі →
Dialogue: 0,0:14:20.09,0:14:24.09,Default,,0,0,0,,Қоқыс бөлмеде тұратын киберспорт әлеміндегі бақытсыз қыз→
Dialogue: 0,0:14:24.09,0:14:26.09,Default,,0,0,0,,Фантом ниндзя! Ха! ?
Dialogue: 0,0:14:26.09,0:14:32.07,Default,,0,0,0,,Мен айтпаймын, анық. Акиба стилі бар әмбебап дүкен!
Dialogue: 0,0:14:32.07,0:14:34.30,Default,,0,0,0,,Киберспорт әлеміндегі ең қатал адам →
Dialogue: 0,0:14:34.30,0:14:36.07,Default,,0,0,0,,Данеко! иә?
Dialogue: 0,0:14:36.07,0:14:40.07,Default,,0,0,0,,Сюннің даралығы тым аз!
Dialogue: 0,0:14:40.07,0:14:42.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.08,0:14:45.15,Default,,0,0,0,,Ал топ жұлдызы. Болашақ чемпион!
Dialogue: 0,0:14:45.15,0:14:49.08,Default,,0,0,0,,Құдіретті ойыншы Зейн!
Dialogue: 0,0:14:49.08,0:14:51.09,Default,,0,0,0,,Бірегей тұлғаларға толы тамаша ұжым...!
Dialogue: 0,0:14:51.09,0:14:53.05,Default,,0,0,0,,тармақ….
Dialogue: 0,0:14:53.05,0:14:55.06,Default,,0,0,0,,Удың болуы нені білдіреді?
Dialogue: 0,0:14:55.06,0:14:58.09,Default,,0,0,0,,Бақытсыз қыз кім?
Dialogue: 0,0:14:58.09,0:15:01.06,Default,,0,0,0,,Сіз ренжідіңіз бе? Сіз мені жай ғана ренжіттіңіз бе?
Dialogue: 0,0:15:01.06,0:15:05.07,Default,,0,0,0,,Ең нашар... Менің ұсынысымды тастаңыз →
Dialogue: 0,0:15:05.07,0:15:07.03,Default,,0,0,0,,Осы ақымақтардың бәрін жинадың ба?
Dialogue: 0,0:15:08.07,0:15:10.07,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:10.07,0:15:12.07,Default,,0,0,0,,Біз бұл жағынан нашармыз ба?
Dialogue: 0,0:15:12.07,0:15:15.08,Default,,0,0,0,,Сіз мұны жақсы емессіз. Сіз қай салада нашарсыз?
Dialogue: 0,0:15:15.08,0:15:18.08,Default,,0,0,0,,Эй Шун! Не, сен менімен дұрыс қарым-қатынас жасайсың ба?
Dialogue: 0,0:15:18.08,0:15:20.08,Default,,0,0,0,,Мүмкін болса→
Dialogue: 0,0:15:20.08,0:15:22.08,Default,,0,0,0,,Мен сізден сұрау керек деп ойладым.
Dialogue: 0,0:15:22.08,0:15:24.09,Default,,0,0,0,,Мен жай ғана тұрып қалдым.
Dialogue: 0,0:15:24.09,0:15:26.05,Default,,0,0,0,,Жарайды. Мен саған айтамын.
Dialogue: 0,0:15:26.05,0:15:29.06,Default,,0,0,0,,Сіз әуесқой үшін өте жақсысыз→
Dialogue: 0,0:15:29.06,0:15:32.13,Default,,0,0,0,,Кәсіби маман ретінде бұл нөлге жуық.
Dialogue: 0,0:15:32.13,0:15:34.06,Default,,0,0,0,,«Нөл» нені білдіреді?
Dialogue: 0,0:15:34.06,0:15:37.27,Default,,0,0,0,,Қара жұмыс нөлдік.
Dialogue: 0,0:15:37.27,0:15:39.07,Default,,0,0,0,,«Қара жұмыс»?
Dialogue: 0,0:15:39.07,0:15:42.17,Default,,0,0,0,,Барлығы → ойындарын жаттығады
Dialogue: 0,0:15:42.17,0:15:44.07,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:15:44.07,0:15:46.07,Default,,0,0,0,,Бірақ кәсіпқойлар мұнымен ғана жеңе алмайды.
Dialogue: 0,0:15:46.07,0:15:50.08,Default,,0,0,0,,Егер сіз ауыр жұмыс жасамасаңыз, ойында артықшылыққа қол жеткізе алмайсыз.
Dialogue: 0,0:15:50.08,0:15:53.08,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбедім...
Dialogue: 0,0:15:53.08,0:15:56.05,Default,,0,0,0,,Маған қайталауды көрсетіңіз.
Dialogue: 0,0:15:57.19,0:15:59.09,Default,,0,0,0,,«Қабырға артындағы жау!» (тінтуірді басқан дыбыс)
Dialogue: 0,0:15:59.09,0:16:02.22,Default,,0,0,0,,Бұл не? қабырға.
Dialogue: 0,0:16:02.22,0:16:04.09,Default,,0,0,0,,Бұл не? қабырға….
Dialogue: 0,0:16:04.09,0:16:07.20,Default,,0,0,0,,«Қабырғаның артында жау бар» десең→
Dialogue: 0,0:16:07.20,0:16:10.06,Default,,0,0,0,,Сіз неден қорқасыз? Ха!
Dialogue: 0,0:16:10.06,0:16:13.07,Default,,0,0,0,,Мен барлық нысандарды атадым.
Dialogue: 0,0:16:13.07,0:16:15.07,Default,,0,0,0,,Қабырғалар ғана емес. Профессионалды команда →
Dialogue: 0,0:16:15.07,0:16:18.07,Default,,0,0,0,,Барлық маңызды объектілерді атаңыз →
Dialogue: 0,0:16:18.07,0:16:20.07,Default,,0,0,0,,Атаулар біртұтас.
Dialogue: 0,0:16:20.07,0:16:22.08,Default,,0,0,0,,О...
Dialogue: 0,0:16:22.08,0:16:25.08,Default,,0,0,0,,Әйтеуір, хабарласа алмаймыз.
Dialogue: 0,0:16:25.08,0:16:28.05,Default,,0,0,0,,Кім кімге нұсқау беріп жатқанын білмеймін.
Dialogue: 0,0:16:29.08,0:16:33.09,Default,,0,0,0,,Одан басқа мен жау командасын мүлде талдай алмаймын.
Dialogue: 0,0:16:33.09,0:16:37.06,Default,,0,0,0,,Олай жасасаңыз, болашақты болжай алмайсыз, сондықтан сіз артта қалып, жеңістен құр қаласыз.
Dialogue: 0,0:16:38.09,0:16:40.09,Default,,0,0,0,,Мен оны біраз уақыттан бері оқып жүрмін!
Dialogue: 0,0:16:40.09,0:16:43.06,Default,,0,0,0,,Қарсыласыңыздың қимылын бірден болжау табиғи нәрсе.
Dialogue: 0,0:16:43.06,0:16:45.17,Default,,0,0,0,,Бұл микроскопиялық көрсеткіш.
Dialogue: 0,0:16:45.17,0:16:48.14,Default,,0,0,0,,Мен макростарды мүлдем оқи алмаймын.
Dialogue: 0,0:16:48.14,0:16:50.10,Default,,0,0,0,,«Микро» және «макро»?
Dialogue: 0,0:16:50.10,0:16:53.17,Default,,0,0,0,,«Қысқа уақыт» және «ұзақ уақыт».
Dialogue: 0,0:16:53.17,0:16:57.11,Default,,0,0,0,,Микроскопиялық суретті нөлдік нүктеден бірнеше секунд бұрын оқитын ұрыс тактикасы.
Dialogue: 0,0:16:57.11,0:17:01.08,Default,,0,0,0,,Макростарды оқу және ондаған секунд алға жылжыту стратегиясы.
Dialogue: 0,0:17:01.08,0:17:04.09,Default,,0,0,0,,Екеуімен бірге алға қара.
Dialogue: 0,0:17:05.09,0:17:07.09,Default,,0,0,0,,Мен оны түсінбеймін!
Dialogue: 0,0:17:07.09,0:17:10.09,Default,,0,0,0,,Мен де жауды белгілі бір дәрежеде зерттеймін →
Dialogue: 0,0:17:10.09,0:17:12.09,Default,,0,0,0,,Мен оны нақты шайқаста тиімді пайдалануды жоспарлап отырмын!
Dialogue: 0,0:17:12.09,0:17:16.10,Default,,0,0,0,,Бұл туралы қатты сөйлегені өте өкінішті!
Dialogue: 0,0:17:16.10,0:17:18.07,Default,,0,0,0,,Олай болса маған қайталауыңызды көрсетіңіз.
Dialogue: 0,0:17:22.10,0:17:24.07,Default,,0,0,0,,«(мылтық)»
Dialogue: 0,0:17:27.11,0:17:29.08,Default,,0,0,0,,«(мылтық)»
Dialogue: 0,0:17:30.11,0:17:33.18,Default,,0,0,0,,Әр жолы, секіру шыңында екі рет секіргеннен кейін →
Dialogue: 0,0:17:33.18,0:17:35.08,Default,,0,0,0,,Сыртқа шыққанда оққа ұшты...
Dialogue: 0,0:17:35.08,0:17:37.08,Default,,0,0,0,,Бұл сенің әдетің.
Dialogue: 0,0:17:37.08,0:17:40.09,Default,,0,0,0,,Ха! Қарсыластың екі рет секірген дыбысын естігенде →
Dialogue: 0,0:17:40.09,0:17:42.09,Default,,0,0,0,,Мен сенің келетініңді білдім.
Dialogue: 0,0:17:42.09,0:17:45.09,Default,,0,0,0,,Гарн! Басқа адамды оқымас бұрын→
Dialogue: 0,0:17:45.09,0:17:48.16,Default,,0,0,0,,Мен өзімді оқуға жол бермеу үшін ешқандай шара қолданбадым!
Dialogue: 0,0:17:48.16,0:17:51.10,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:17:51.10,0:17:54.17,Default,,0,0,0,,FOX ONE командасы жаңа және белгісіз мүшелерден құралды.→
Dialogue: 0,0:17:54.17,0:17:58.07,Default,,0,0,0,,Әр сәйкестікте деректер жинақталды.
Dialogue: 0,0:17:58.07,0:18:01.11,Default,,0,0,0,,Осылайша қарсыласқа жеңілу оңай болды.
Dialogue: 0,0:18:01.11,0:18:04.08,Default,,0,0,0,,Анатея картасында сіз тек A→-ге шабуыл жасайсыз
Dialogue: 0,0:18:04.08,0:18:06.08,Default,,0,0,0,,Саранан картасы→
Dialogue: 0,0:18:06.08,0:18:08.15,Default,,0,0,0,,4 адам В-ға шабуыл жасап, А→ орнында тек 1 адамды қалдырады
Dialogue: 0,0:18:08.15,0:18:10.08,Default,,0,0,0,,Тренд айқын.
Dialogue: 0,0:18:10.08,0:18:13.15,Default,,0,0,0,,Кәсіби маманды бұлай жеңу мүмкін емес!
Dialogue: 0,0:18:13.15,0:18:16.09,Default,,0,0,0,,Иә! Жалдау! Сіз менің жаттықтырушы болып тағайындалдыңыз!
Dialogue: 0,0:18:16.09,0:18:18.09,Default,,0,0,0,,Әке! ?
Dialogue: 0,0:18:18.09,0:18:21.16,Default,,0,0,0,,Тағы да? Оны алмасаң, кімді аласың?
Dialogue: 0,0:18:21.16,0:18:23.10,Default,,0,0,0,,Жазбаша келісім-шарт.
Dialogue: 0,0:18:23.10,0:18:26.10,Default,,0,0,0,,Бұлай етпе, ақымақ! иә! ?
Dialogue: 0,0:18:27.10,0:18:30.10,Default,,0,0,0,,Мен FOX ONE-ді жойғым келеді.
Dialogue: 0,0:18:30.10,0:18:33.07,Default,,0,0,0,,Оны сындырмаңыз! Мен көп жұмыс істеймін!
Dialogue: 0,0:18:33.07,0:18:36.08,Default,,0,0,0,,Неге сен бізге сонша араласып тұрсың?
Dialogue: 0,0:18:36.08,0:18:39.08,Default,,0,0,0,,Ұсынған адам → командасын орындаған дұрыс
Dialogue: 0,0:18:39.08,0:18:41.08,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:18:41.08,0:18:44.15,Default,,0,0,0,,Мен сенің қайда кеткеніңді білмеймін...
Dialogue: 0,0:18:44.15,0:18:48.12,Default,,0,0,0,,Тарату және SNS барлығы тоқтатылды және ешқандай ақпарат жоқ!
Dialogue: 0,0:18:48.12,0:18:52.09,Default,,0,0,0,,Шыдамды тастап, есеңгіреп өлсем, сен кінәлісің!
Dialogue: 0,0:18:52.09,0:18:54.13,Default,,0,0,0,,Ах~ Юрукки-кун.
Dialogue: 0,0:18:54.13,0:18:56.10,Default,,0,0,0,,Ол зейнетке шықты, солай ма?
Dialogue: 0,0:18:56.10,0:18:59.07,Default,,0,0,0,,Не...! ? Зейнеткерлікке шығу! ?
Dialogue: 0,0:19:00.10,0:19:03.10,Default,,0,0,0,,Кәсіби маман ретінде жалғастыру қиын екеніне сенімдімін →
Dialogue: 0,0:19:03.10,0:19:06.07,Default,,0,0,0,,Бас тартыңыз және жақсырақ жұмысқа орналасыңыз →
Dialogue: 0,0:19:06.07,0:19:08.11,Default,,0,0,0,,Мұны саған әйелің айтқан шығар.
Dialogue: 0,0:19:08.11,0:19:11.08,Default,,0,0,0,,Ханым! ? Юрукки үйленді! ?
Dialogue: 0,0:19:11.08,0:19:15.05,Default,,0,0,0,,Менің де балаларым бар. Мен оны кейде дүкенге апаратынмын.
Dialogue: 0,0:19:16.08,0:19:18.09,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:19:18.09,0:19:20.09,Default,,0,0,0,,Бұл көп жағынан қайғылы.
Dialogue: 0,0:19:20.09,0:19:23.09,Default,,0,0,0,,Мен түсіндім. Бұл ойын-сауық индустриясында да солай, өйткені ол жақсы сатылмайды.
Dialogue: 0,0:19:23.09,0:19:25.06,Default,,0,0,0,,Менің арманым жоқ Әй!
Dialogue: 0,0:19:26.06,0:19:28.06,Default,,0,0,0,,Не болды? Сейши стилі.
Dialogue: 0,0:19:28.06,0:19:30.13,Default,,0,0,0,,Оның әйелі мен балалары болды...
Dialogue: 0,0:19:30.13,0:19:33.07,Default,,0,0,0,,Мен көп ақшаны ағынға лақтырдым!
Dialogue: 0,0:19:33.07,0:19:36.04,Default,,0,0,0,,Бұл сіздің балаңыздың жеңіл тамақтарының ақшасы.
Dialogue: 0,0:19:37.07,0:19:41.08,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:19:41.08,0:19:44.08,Default,,0,0,0,,Иә! Мен А-ға келдім.
Dialogue: 0,0:19:45.08,0:19:47.08,Default,,0,0,0,,SHINING PANDA → деректеріне негізделген
Dialogue: 0,0:19:47.08,0:19:50.05,Default,,0,0,0,,Бұл картада А!
Dialogue: 0,0:19:51.09,0:19:54.09,Default,,0,0,0,,Ұзыннан атылған ату әрқашан төбенің оң жағында жасырылады!
Dialogue: 0,0:19:54.09,0:19:56.06,Default,,0,0,0,,«(мылтық)» Хит!
Dialogue: 0,0:19:56.06,0:19:58.06,Default,,0,0,0,,Екі рет шыңға секіріңіз!
Dialogue: 0,0:20:00.09,0:20:03.06,Default,,0,0,0,,“(Жарылыс дыбысы)” (MC) A-мен төмендеңіз!
Dialogue: 0,0:20:03.06,0:20:05.20,Default,,0,0,0,,Бұл қараңғы тұзақ!
Dialogue: 0,0:20:05.20,0:20:07.13,Default,,0,0,0,,Мен Өшіргішті қадағалаймын!
Dialogue: 0,0:20:07.13,0:20:09.07,Default,,0,0,0,,Мен Данеконы күзетемін!
Dialogue: 0,0:20:09.07,0:20:11.07,Default,,0,0,0,,Фантом тұрып қалды, өтінемін!
Dialogue: 0,0:20:11.07,0:20:13.07,Default,,0,0,0,,Қолдау көрсетуге барыңыз!
Dialogue: 0,0:20:13.07,0:20:16.08,Default,,0,0,0,,КӨШІРУ! «(Мылтық дыбысы)»
Dialogue: 0,0:20:17.08,0:20:19.15,Default,,0,0,0,,«(мылтық)» Хит!
Dialogue: 0,0:20:19.15,0:20:21.08,Default,,0,0,0,,Екі А-шорт соңғысы.
Dialogue: 0,0:20:21.08,0:20:23.08,Default,,0,0,0,,Мен келе жатырмын! Мен де барамын!
Dialogue: 0,0:20:23.08,0:20:25.15,Default,,0,0,0,,Артымнан бұрыл!
Dialogue: 0,0:20:25.15,0:20:27.12,Default,,0,0,0,,Қат! КӨШІРУ!
Dialogue: 0,0:20:28.09,0:20:33.06,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:20:34.10,0:20:36.06,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:20:38.07,0:20:40.13,Default,,0,0,0,,Уау! (Метеор) Мияу!
Dialogue: 0,0:20:40.13,0:20:42.07,Default,,0,0,0,,FOX ONE командасы жеңеді!
Dialogue: 0,0:20:42.07,0:20:44.14,Default,,0,0,0,,Ｃｈａｌｌｅｎｇｅｒｓ Ｓｔａｇｅ ２→
Dialogue: 0,0:20:44.14,0:20:47.07,Default,,0,0,0,,Жартылай финалға өтіңіз!
Dialogue: 0,0:20:47.07,0:20:51.05,Default,,0,0,0,,Жарайсыңдар! Үздік 8! Мен бара аламын! Сіз әлі де бара аласыз!
Dialogue: 0,0:20:51.05,0:20:53.08,Default,,0,0,0,,Сіз мұны істедіңіз! (Юу) Иә!
Dialogue: 0,0:20:53.08,0:20:55.08,Default,,0,0,0,,Бұл арнайы дайындықтың нәтижесі!
Dialogue: 0,0:20:55.08,0:20:57.08,Default,,0,0,0,,Жау деректерін талдау ғана емес →
Dialogue: 0,0:20:57.08,0:21:00.09,Default,,0,0,0,,Өзіңізді объективті түрде талдаңыз →
Dialogue: 0,0:21:00.09,0:21:03.06,Default,,0,0,0,,Өзіңізбен күресу кезінде стратегиялар туралы ойланыңыз.
Dialogue: 0,0:21:03.06,0:21:07.06,Default,,0,0,0,,Сол жерден әлсіз жақтарды жою үшін кері жұмыс жасаңыз.
Dialogue: 0,0:21:07.06,0:21:11.07,Default,,0,0,0,,Бұл ауыр жұмыс болды, бірақ мен оны жинаған кезде түсіндім.
Dialogue: 0,0:21:11.07,0:21:14.07,Default,,0,0,0,,Бәрі де сол кісілердің арқасы.
Dialogue: 0,0:21:14.07,0:21:16.07,Default,,0,0,0,,〈Қазір→
Dialogue: 0,0:21:16.07,0:21:19.07,Default,,0,0,0,,FOX ONE-ге екі бейтаныс адам кіріп кетті→
Dialogue: 0,0:21:19.07,0:21:22.14,Default,,0,0,0,,Сонда қайда бардың?〉
Dialogue: 0,0:21:22.14,0:21:25.15,Default,,0,0,0,,Сонымен! Бұл дұрыс емес!
Dialogue: 0,0:21:25.15,0:21:27.08,Default,,0,0,0,,Карта нұсқасы өзгерді!
Dialogue: 0,0:21:27.08,0:21:30.08,Default,,0,0,0,,Оқ дәл сол қабырғадан өтіп кетті!
Dialogue: 0,0:21:30.08,0:21:32.05,Default,,0,0,0,,Ху~ Дұрыс.
Dialogue: 0,0:21:33.09,0:21:36.06,Default,,0,0,0,,〈Шынында мен әлі дүкендемін〉
Dialogue: 0,0:21:37.09,0:21:42.10,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.09,0:23:23.10,Default,,0,0,0,,Қараңызшы... ол дұрыс түсті.
Dialogue: 0,0:23:24.60,0:23:30.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
