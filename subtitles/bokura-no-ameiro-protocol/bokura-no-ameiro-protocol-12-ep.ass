Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.08,0:00:16.08,Default,,0,0,0,,Ах~ Мен қобалжыдым.
Dialogue: 0,0:00:16.08,0:00:18.15,Default,,0,0,0,,Сабыр ет, сен директорсың.
Dialogue: 0,0:00:18.15,0:00:21.08,Default,,0,0,0,,Үлкендер мықты болуы керек.
Dialogue: 0,0:00:21.08,0:00:23.09,Default,,0,0,0,,Соны айтсаң да...
Dialogue: 0,0:00:24.12,0:00:27.09,Default,,0,0,0,,Егер сіз осы матчта жеңіске жетсеңіз, сіз профессионал → боласыз
Dialogue: 0,0:00:27.09,0:00:29.12,Default,,0,0,0,,Жеңілсең бітті.
Dialogue: 0,0:00:29.12,0:00:31.09,Default,,0,0,0,,Ал екінші адам – анау ҰЙҚЫҚТАҒАН Үкі.
Dialogue: 0,0:00:31.09,0:00:33.20,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:00:33.20,0:00:35.10,Default,,0,0,0,,Ол мен бір рет жеңген адаммын!
Dialogue: 0,0:00:35.10,0:00:37.13,Default,,0,0,0,,Мен не болса да жеңемін!
Dialogue: 0,0:00:37.13,0:00:39.10,Default,,0,0,0,,Сондай-ақ Мио Чан үшін!
Dialogue: 0,0:00:39.10,0:00:41.10,Default,,0,0,0,,Дұрыс па? Қаш!
Dialogue: 0,0:00:41.10,0:00:43.11,Default,,0,0,0,,Ах. Міндетті түрде жеңіңіз.
Dialogue: 0,0:00:43.11,0:00:47.11,Default,,0,0,0,,Жеңіп ал, Миоға қайтадан жүруге рұқсат ет.
Dialogue: 0,0:00:47.11,0:00:49.11,Default,,0,0,0,,Иә... мүлде!
Dialogue: 0,0:00:51.08,0:00:53.08,Default,,0,0,0,,Иә. Қайсысы?
Dialogue: 0,0:00:56.12,0:00:58.25,Default,,0,0,0,,Сакагами мырза! ?
Dialogue: 0,0:00:58.25,0:01:00.16,Default,,0,0,0,,Кім? (Юу) Менің менеджерім.
Dialogue: 0,0:01:00.16,0:01:02.09,Default,,0,0,0,,О, сәлем!
Dialogue: 0,0:01:02.09,0:01:04.09,Default,,0,0,0,,Юу-сан, маған әрқашан қамқор болғаныңыз үшін рахмет...
Dialogue: 0,0:01:05.09,0:01:07.10,Default,,0,0,0,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:01:07.10,0:01:09.10,Default,,0,0,0,,Мен саған матчқа барма дедім!
Dialogue: 0,0:01:09.10,0:01:12.10,Default,,0,0,0,,Бірақ нәтиже бүгін белгілі болады!
Dialogue: 0,0:01:12.10,0:01:14.10,Default,,0,0,0,,Сіз ұсталып қалсаңыз не істейсіз?
Dialogue: 0,0:01:14.10,0:01:17.07,Default,,0,0,0,,Бұл ең маңызды матч! Өйткені бұл маңызды емес!
Dialogue: 0,0:01:17.07,0:01:19.07,Default,,0,0,0,,Мен үйге бара жатырмын! (Юу) Ах...
Dialogue: 0,0:01:20.08,0:01:22.08,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:01:22.08,0:01:24.08,Default,,0,0,0,,Алыста. Дүрлікпеңіз!
Dialogue: 0,0:01:24.08,0:01:26.08,Default,,0,0,0,,Юу Сен оны жек көресің, солай емес пе?
Dialogue: 0,0:01:26.08,0:01:28.22,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:01:28.22,0:01:30.12,Default,,0,0,0,,Бұл да жұмыс!
Dialogue: 0,0:01:30.12,0:01:33.09,Default,,0,0,0,,Оны ойынға араластырмаңыз. Мен ешқашан кетпеймін!
Dialogue: 0,0:01:36.09,0:01:38.06,Default,,0,0,0,,Бұл соңғы рет болады!
Dialogue: 0,0:01:40.10,0:01:44.07,Default,,0,0,0,,Бұл соңғы рет болады... сондықтан өтінемін!
Dialogue: 0,0:01:45.10,0:01:47.10,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:01:47.10,0:01:53.21,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.21,0:01:55.08,Default,,0,0,0,,Сакагами мырза….
Dialogue: 0,0:01:55.08,0:01:58.08,Default,,0,0,0,,Бұл сөздерді ұмытпа.
Dialogue: 0,0:02:02.12,0:02:04.09,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:02:04.09,0:02:06.09,Default,,0,0,0,,Рахмет…. Уф.
Dialogue: 0,0:02:08.26,0:02:11.09,Default,,0,0,0,,Кешіріңіз... барлығына.
Dialogue: 0,0:02:11.09,0:02:13.20,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:02:13.20,0:02:15.10,Default,,0,0,0,,Жоқ, рахмет.
Dialogue: 0,0:02:15.10,0:02:18.07,Default,,0,0,0,,Осы уақытқа дейін маған немқұрайлы қарадың.
Dialogue: 0,0:02:20.10,0:02:23.74,Default,,0,0,0,,Қарсы емес. Осы уақытқа дейін →
Dialogue: 0,0:02:23.74,0:02:25.07,Default,,0,0,0,,Мұның бәрі Ю-чанның арқасында.
Dialogue: 0,0:02:25.07,0:02:29.08,Default,,0,0,0,,Дұрыс. Егер біз бәрібір жеңілетін болсақ, бұл соңғы рет болады!
Dialogue: 0,0:02:29.08,0:02:31.08,Default,,0,0,0,,Жақсы. (Юу) Иә?
Dialogue: 0,0:02:31.08,0:02:33.25,Default,,0,0,0,,Менеджер→
Dialogue: 0,0:02:33.25,0:02:36.22,Default,,0,0,0,,Ең болмағанда сен мені осы матч үшін кешірдің, солай ма?
Dialogue: 0,0:02:38.35,0:02:41.09,Default,,0,0,0,,О! Алдымен ойынға назар аударыңыз!
Dialogue: 0,0:02:41.09,0:02:43.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:43.09,0:02:45.09,Default,,0,0,0,,Бұл матчты жеңіңіз!
Dialogue: 0,0:02:45.09,0:02:47.06,Default,,0,0,0,,Мен міндетті түрде Про-Лигаға өтемін!
Dialogue: 0,0:02:55.07,0:02:58.17,Default,,0,0,0,,Жеңілсем, үйден кетемін.
Dialogue: 0,0:02:58.17,0:03:00.14,Default,,0,0,0,,Мен Миомен енді ешқашан кездеспеймін.
Dialogue: 0,0:03:01.08,0:03:04.08,Default,,0,0,0,,Жеңіске жетсек, Мио ауруханаға түседі!
Dialogue: 0,0:03:04.08,0:03:07.08,Default,,0,0,0,,Сондықтан оңалтуға назар аударыңыз.
Dialogue: 0,0:03:08.05,0:03:10.05,Default,,0,0,0,,Сәттілік Шун!
Dialogue: 0,0:03:13.09,0:03:17.06,Default,,0,0,0,,Келесі карта - FOX ONE командасы Ұйқыдағы үкіге қарсы.
Dialogue: 0,0:03:17.06,0:03:19.09,Default,,0,0,0,,FOX ONE командасы→
Dialogue: 0,0:03:19.09,0:03:22.06,Default,,0,0,0,,Бұл лигаға кіру үшін соңғы ойын!
Dialogue: 0,0:03:22.06,0:03:26.07,Default,,0,0,0,,Жеңіске жетсең, лигаға қосыласың; ұтсаңыз, сіз жойыласыз →
Dialogue: 0,0:03:26.07,0:03:28.07,Default,,0,0,0,,Бұл қиын шайқас.
Dialogue: 0,0:03:28.07,0:03:31.07,Default,,0,0,0,,Алдыңғы екі ойынның екеуі де Ұйқыдағы үкі үшін жеңіс болды.
Dialogue: 0,0:03:31.07,0:03:35.08,Default,,0,0,0,,FOX ONE командасы Бұл жерде соққы болады ма?
Dialogue: 0,0:03:36.08,0:03:39.08,Default,,0,0,0,,Енді шабуылдаушы - ҰЙЫҚТАҒАН Үкі.
Dialogue: 0,0:03:39.08,0:03:42.05,Default,,0,0,0,,FOX ONE командасы қорғанысқа шықты.
Dialogue: 0,0:03:43.09,0:03:46.05,Default,,0,0,0,,А-ның жаулары көп! Мазалаңыз!
Dialogue: 0,0:03:49.09,0:03:51.06,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:03:51.06,0:03:53.06,Default,,0,0,0,,Фугия! Данеко, тезірек!
Dialogue: 0,0:03:57.10,0:03:59.07,Default,,0,0,0,,"(Мылтық)" Тартқыш жеңілді!
Dialogue: 0,0:03:59.07,0:04:02.07,Default,,0,0,0,,«(мылтық)» Уа! Ахх...
Dialogue: 0,0:04:02.07,0:04:06.04,Default,,0,0,0,,Ұзын және ауыр бөшке. Фантомдар айналысады.
Dialogue: 0,0:04:06.04,0:04:08.08,Default,,0,0,0,,Мен жақынмын! Пинсер!
Dialogue: 0,0:04:08.08,0:04:10.05,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:04:10.05,0:04:12.05,Default,,0,0,0,,Жеңілді!
Dialogue: 0,0:04:12.05,0:04:15.05,Default,,0,0,0,,«(мылтық)» Ах! Қысқа тоқтатудан түсірілді!
Dialogue: 0,0:04:18.05,0:04:20.06,Default,,0,0,0,,«(мылтық)» (Юу) 1 өлтіру!
Dialogue: 0,0:04:22.06,0:04:25.06,Default,,0,0,0,,«(Мылтық)» (Юу) А, мен соққыға жығылдым!
Dialogue: 0,0:04:25.06,0:04:27.06,Default,,0,0,0,,FOX ONE соңғысы!
Dialogue: 0,0:04:27.06,0:04:29.03,Default,,0,0,0,,Мен жалғызбын...
Dialogue: 0,0:04:33.07,0:04:35.07,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:04:35.07,0:04:37.07,Default,,0,0,0,,ДЖОНАТАНды жеңді! Тағы бір фото!
Dialogue: 0,0:04:37.07,0:04:39.04,Default,,0,0,0,,«(мылтық)» Ах....
Dialogue: 0,0:04:40.04,0:04:42.08,Default,,0,0,0,,«Муфта»
Dialogue: 0,0:04:42.08,0:04:45.05,Default,,0,0,0,,үшін тағы да жем-қосқыш стратегиясы ма?
Dialogue: 0,0:04:45.05,0:04:49.05,Default,,0,0,0,,Солай... Алдыңғы екі шайқаста мен әдеттегідей шайқастым.
Dialogue: 0,0:04:53.19,0:04:57.06,Default,,0,0,0,,Сәлем ДЖОНАТАН. (ЖОНАТАН) Иә?
Dialogue: 0,0:04:57.06,0:05:00.06,Default,,0,0,0,,Келесі матч, мені және IGL-ді ауыстыра аласыз ба?
Dialogue: 0,0:05:00.06,0:05:02.06,Default,,0,0,0,,Не?
Dialogue: 0,0:05:02.06,0:05:04.07,Default,,0,0,0,,Сіз бізге тағы да жем алмақшысыз ба?
Dialogue: 0,0:05:04.07,0:05:06.07,Default,,0,0,0,,Мен сенің фольгаң емеспін!
Dialogue: 0,0:05:06.07,0:05:09.04,Default,,0,0,0,,Бірақ сіз соңғы рет сеттерде жеңдіңіз.
Dialogue: 0,0:05:09.04,0:05:11.07,Default,,0,0,0,,Жеңіске жету жеткіліксіз!
Dialogue: 0,0:05:11.07,0:05:13.04,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:05:13.04,0:05:16.14,Default,,0,0,0,,Сондықтан біз тіпті ас қорыту ойынын да қызықты етуіміз керек.
Dialogue: 0,0:05:16.14,0:05:18.08,Default,,0,0,0,,Сәлем? жаттықтырушы.
Dialogue: 0,0:05:18.08,0:05:21.32,Default,,0,0,0,,ROX-тың чемпионаттағы бір адамдық ойыны →
Dialogue: 0,0:05:21.32,0:05:24.05,Default,,0,0,0,,Басшылық пен демеушілер тарапынан жоғары бағаға ие болды.
Dialogue: 0,0:05:24.05,0:05:26.25,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:05:26.25,0:05:28.06,Default,,0,0,0,,Сіз ондай нәрсені жасай алмайсыз!
Dialogue: 0,0:05:28.06,0:05:31.06,Default,,0,0,0,,Иә, менің командам мұны істей алады.
Dialogue: 0,0:05:32.06,0:05:35.06,Default,,0,0,0,,Өйткені біз бірінші сынып емеспіз бе?
Dialogue: 0,0:05:35.06,0:05:38.03,Default,,0,0,0,,Матчтың орындалуына келетін болсақ, бұл оңай жеңіс, солай емес пе?
Dialogue: 0,0:05:42.04,0:05:44.04,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:47.08,0:05:49.08,Default,,0,0,0,,Олар бірдей қозғалыспен аяқталды ма?
Dialogue: 0,0:05:49.08,0:05:51.08,Default,,0,0,0,,Не істеу керек? Сейши стилі.
Dialogue: 0,0:05:51.08,0:05:54.08,Default,,0,0,0,,Жарайды. Мен қарсы шараларды ойладым.
Dialogue: 0,0:05:54.08,0:05:57.05,Default,,0,0,0,,үшінңыз, В жоспарына өтіңіздер!
Dialogue: 0,0:05:57.05,0:05:59.05,Default,,0,0,0,,ＣＯＰＹ！
Dialogue: 0,0:05:59.05,0:06:01.06,Default,,0,0,0,,Жалғыз әрекет етпеу→
Dialogue: 0,0:06:01.06,0:06:03.06,Default,,0,0,0,,Екі адамдық камера Қорғанысқа арналған үш адамдық камера.
Dialogue: 0,0:06:03.06,0:06:06.06,Default,,0,0,0,,Алаяқты қолданып, оны қақпақпен өлтіруге келсең→
Dialogue: 0,0:06:06.06,0:06:08.06,Default,,0,0,0,,Бұл қақпақты жеңу үшін →
Dialogue: 0,0:06:08.06,0:06:11.07,Default,,0,0,0,,Сонымен, мұқабаның қақпағы бар болса, бәрі жақсы!
Dialogue: 0,0:06:11.07,0:06:13.03,Default,,0,0,0,,Сіз не туралы айтып тұрғаныңызды білесіз бе?
Dialogue: 0,0:06:13.03,0:06:15.10,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:06:15.10,0:06:17.07,Default,,0,0,0,,«(Мылтық дыбысы)» Өлтірілді!
Dialogue: 0,0:06:17.07,0:06:19.04,Default,,0,0,0,,«(мылтық)» Ах!
Dialogue: 0,0:06:19.04,0:06:21.04,Default,,0,0,0,,Онда! «(мылтық)»
Dialogue: 0,0:06:21.04,0:06:23.08,Default,,0,0,0,,Жарайсыңдар! Сәтті кавер!
Dialogue: 0,0:06:23.08,0:06:25.08,Default,,0,0,0,,«(мылтық)» Ах...!
Dialogue: 0,0:06:25.08,0:06:27.05,Default,,0,0,0,,Не~! ? Қақпақты қақпақпен ұрсам да →
Dialogue: 0,0:06:27.05,0:06:29.05,Default,,0,0,0,,Мұқабаның мұқабасы болды!
Dialogue: 0,0:06:29.05,0:06:32.02,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін!
Dialogue: 0,0:06:33.05,0:06:35.09,Default,,0,0,0,,«(Мылтық ату)» (Метеор) Уау!
Dialogue: 0,0:06:35.09,0:06:37.09,Default,,0,0,0,,Маған артымнан шабуыл жасалды!
Dialogue: 0,0:06:37.09,0:06:40.06,Default,,0,0,0,,Мен қатып, қозғалғандықтан, мен қалдырған бос жерді нысанаға алдым!
Dialogue: 0,0:06:40.06,0:06:43.06,Default,,0,0,0,,Қарғыс атсын... бұл! «(Мылтық дыбысы)»
Dialogue: 0,0:06:44.07,0:06:47.07,Default,,0,0,0,,«(Мылтық дыбысы)» (Юу) Ах!
Dialogue: 0,0:06:47.07,0:06:51.07,Default,,0,0,0,,Әлсіз дегенді басынан оқыдым дейсің бе? ?
Dialogue: 0,0:06:51.07,0:06:53.14,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:06:53.14,0:06:55.14,Default,,0,0,0,,«(мылтық)» Ах....
Dialogue: 0,0:06:57.08,0:06:59.08,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:07:00.08,0:07:02.05,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:04.09,0:07:08.12,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:07:08.12,0:07:10.09,Default,,0,0,0,,«Муфта»
Dialogue: 0,0:07:12.23,0:07:14.23,Default,,0,0,0,,«(мылтық)»
Dialogue: 0,0:07:16.10,0:07:18.07,Default,,0,0,0,,«Муфта»
Dialogue: 0,0:07:19.10,0:07:21.10,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:07:25.11,0:07:29.11,Default,,0,0,0,,Мұндағы интервал. Стратегия уақыты келді.
Dialogue: 0,0:07:29.11,0:07:32.18,Default,,0,0,0,,ҰЙЫҚТАҒАН Үкі Тікелей 5 айналымға дейін.
Dialogue: 0,0:07:32.18,0:07:35.18,Default,,0,0,0,,«FOX ONE мен осы жерден ауысқым келеді».
Dialogue: 0,0:07:35.18,0:07:37.19,Default,,0,0,0,,Шун….
Dialogue: 0,0:07:40.09,0:07:43.12,Default,,0,0,0,,Жақсы ойын.
Dialogue: 0,0:07:43.12,0:07:46.09,Default,,0,0,0,,ROX Сіз оны осылай тік ұстай аласыз ба?
Dialogue: 0,0:07:46.09,0:07:48.10,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:07:50.10,0:07:52.20,Default,,0,0,0,,《Сені аяймын→
Dialogue: 0,0:07:52.20,0:07:54.10,Default,,0,0,0,,Егер бұл сізді бас тартуға мәжбүр етсе...》
Dialogue: 0,0:07:54.10,0:07:57.27,Default,,0,0,0,,Қат! Неліктен бәрі опасыздық жасады?
Dialogue: 0,0:07:57.27,0:08:00.11,Default,,0,0,0,,Жоқ... Мен оны мүлдем қайтара алмаймын.
Dialogue: 0,0:08:00.11,0:08:03.11,Default,,0,0,0,,Сіз нені айтасыз? Одақтас атылған сайын →
Dialogue: 0,0:08:03.11,0:08:05.11,Default,,0,0,0,,Сіз бізді ұратындай жақынсыз ба?
Dialogue: 0,0:08:05.11,0:08:07.32,Default,,0,0,0,,Уақыт өте келе қозғала алмайсыз!
Dialogue: 0,0:08:07.32,0:08:11.29,Default,,0,0,0,,Демек, біздің барлық қозғалыстарымыз оқылады деген сөз...
Dialogue: 0,0:08:12.25,0:08:14.09,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:08:14.09,0:08:16.09,Default,,0,0,0,,Болашақты көресің дейді.
Dialogue: 0,0:08:16.09,0:08:19.13,Default,,0,0,0,,《Мен Муцуо-кунды жеңе алмайтын шығармын...? 》
Dialogue: 0,0:08:19.13,0:08:21.10,Default,,0,0,0,,Егер сіз жүруді талап етсеңіз →
Dialogue: 0,0:08:21.10,0:08:23.10,Default,,0,0,0,,Маған жеңгеніңді көрсет!
Dialogue: 0,0:08:23.10,0:08:25.07,Default,,0,0,0,,Егер қолыңнан келмесе, қажетсіз ештеңе жасама!
Dialogue: 0,0:08:27.10,0:08:29.10,Default,,0,0,0,,《Үлкен аға...》
Dialogue: 0,0:08:29.10,0:08:31.11,Default,,0,0,0,,Егер мен жеңілсем, Мионы тастап кетемін.
Dialogue: 0,0:08:34.11,0:08:37.11,Default,,0,0,0,,《Осы қарқынмен... мен жеңе алмаймын》
Dialogue: 0,0:08:39.08,0:08:41.08,Default,,0,0,0,,《Солай ма...》
Dialogue: 0,0:08:42.08,0:08:45.12,Default,,0,0,0,,《Егер мен жеңілсем...》
Dialogue: 0,0:08:45.12,0:08:49.09,Default,,0,0,0,,《Егер мен осылай ұтпасам...》
Dialogue: 0,0:08:49.09,0:08:52.09,Default,,0,0,0,,《Бұл менің кінәм болса да...》
Dialogue: 0,0:08:52.09,0:08:55.10,Default,,0,0,0,,《Бұл менің кінәм болса да...》
Dialogue: 0,0:08:55.10,0:08:57.10,Default,,0,0,0,,《Қадірлегім келсе де...》
Dialogue: 0,0:08:57.10,0:09:00.10,Default,,0,0,0,,《Мен сенімен болғым келеді...》
Dialogue: 0,0:09:00.10,0:09:02.10,Default,,0,0,0,,《Мио деген не…》
Dialogue: 0,0:09:02.10,0:09:04.11,Default,,0,0,0,,《Сенің ағаң қандай...》
Dialogue: 0,0:09:04.11,0:09:07.08,Default,,0,0,0,,《Мен сені енді көре алмаймын! 》
Dialogue: 0,0:09:08.18,0:09:10.11,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:09:10.11,0:09:13.11,Default,,0,0,0,,Жеңіс...
Dialogue: 0,0:09:13.11,0:09:16.08,Default,,0,0,0,,Үлкен аға... жең!
Dialogue: 0,0:09:16.08,0:09:18.09,Default,,0,0,0,,Ах...!
Dialogue: 0,0:09:18.09,0:09:22.09,Default,,0,0,0,,А... Менің қолымнан келмейді деп ойлаймын...
Dialogue: 0,0:09:22.09,0:09:25.09,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:09:25.09,0:09:30.10,Default,,0,0,0,,Аа, Токиноя мырза. Жоқ, мен қазір қиын сәтте тұрмын...
Dialogue: 0,0:09:30.10,0:09:33.07,Default,,0,0,0,,Е... Е!
Dialogue: 0,0:09:34.10,0:09:36.10,Default,,0,0,0,,Шун-кун! Бұл қиын!
Dialogue: 0,0:09:36.10,0:09:38.11,Default,,0,0,0,,Анам қоңырау шалды!
Dialogue: 0,0:09:38.11,0:09:40.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:40.11,0:09:46.11,Default,,0,0,0,,♬～
Dialogue: 0,0:09:46.11,0:09:48.08,Default,,0,0,0,,Мио!
Dialogue: 0,0:09:50.12,0:09:52.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:55.12,0:09:57.09,Default,,0,0,0,,Мио-чан!
Dialogue: 0,0:09:59.13,0:10:02.10,Default,,0,0,0,,Сәттілік Мио! Әдемі шие гүлдері!
Dialogue: 0,0:10:06.10,0:10:09.14,Default,,0,0,0,,Мен жүрдім... Мио-чан жүрді!
Dialogue: 0,0:10:09.14,0:10:11.14,Default,,0,0,0,,«Ах...» (Сатоми) «Мио!»
Dialogue: 0,0:10:11.14,0:10:13.14,Default,,0,0,0,,"Жақсысың ба? Мио."
Dialogue: 0,0:10:13.14,0:10:15.11,Default,,0,0,0,,Әдемі шие гүлдері!
Dialogue: 0,0:10:15.11,0:10:20.12,Default,,0,0,0,,«Қолымнан келгенше тырысамын... Болмасам... мен сені кешірмеймін».
Dialogue: 0,0:10:21.18,0:10:25.12,Default,,0,0,0,,«Егер сен жеңмесең, мен сені кешірмеймін...»
Dialogue: 0,0:10:25.12,0:10:29.12,Default,,0,0,0,,"Егер жеңе алмасам немесе сені қайта көре алмасам, өзімді кешірмеймін!"
Dialogue: 0,0:10:30.13,0:10:32.13,Default,,0,0,0,,Мио Сіз...
Dialogue: 0,0:10:32.13,0:10:36.10,Default,,0,0,0,,«Мен ешқашан... мен сені ешқашан кешірмеймін!»
Dialogue: 0,0:10:37.17,0:10:39.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.13,0:10:42.10,Default,,0,0,0,,Сөзсіз жеңіңіз. Мен саған жеңісті көрсетемін!
Dialogue: 0,0:10:42.10,0:10:45.11,Default,,0,0,0,,Жеңіп, үйге қайт!
Dialogue: 0,0:10:45.11,0:10:47.14,Default,,0,0,0,,«Иә!»
Dialogue: 0,0:10:47.14,0:10:49.11,Default,,0,0,0,,«Қой, қолыңнан келгеннің бәрін істе!»
Dialogue: 0,0:10:49.11,0:10:51.11,Default,,0,0,0,,Анашым, маған әдемі шие гүлдерін беріңізші.
Dialogue: 0,0:10:53.25,0:10:56.12,Default,,0,0,0,,Уф... Болайық, Шун!
Dialogue: 0,0:10:56.12,0:10:58.19,Default,,0,0,0,,Себебі Мио-чан мұны істеді→
Dialogue: 0,0:10:58.19,0:11:00.09,Default,,0,0,0,,Біз жасамасақ, сен не істейсің?
Dialogue: 0,0:11:00.09,0:11:02.09,Default,,0,0,0,,Енді жылайтын кез келді.
Dialogue: 0,0:11:02.09,0:11:04.09,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:11:04.09,0:11:07.10,Default,,0,0,0,,Мен қатты қиналдым!
Dialogue: 0,0:11:08.13,0:11:10.10,Default,,0,0,0,,Шешім қабылданды.
Dialogue: 0,0:11:11.10,0:11:13.10,Default,,0,0,0,,Мен де шештім!
Dialogue: 0,0:11:13.10,0:11:15.07,Default,,0,0,0,,«Шешімді» дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:16.17,0:11:18.14,Default,,0,0,0,,Бұл сәйкестік….
Dialogue: 0,0:11:20.11,0:11:22.08,Default,,0,0,0,,Мен өзім сияқты күресемін!
Dialogue: 0,0:11:24.11,0:11:26.08,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:11:26.08,0:11:28.08,Default,,0,0,0,,Иә? Ол адам...
Dialogue: 0,0:11:28.08,0:11:30.08,Default,,0,0,0,,Ол Юү актрисасына ұқсамайды ма?
Dialogue: 0,0:11:30.08,0:11:32.09,Default,,0,0,0,,Шынайы ма? Өзі?
Dialogue: 0,0:11:32.09,0:11:35.09,Default,,0,0,0,,Әй, бірақ сурет теледидардағыдан мүлде бөлек, солай емес пе?
Dialogue: 0,0:11:35.09,0:11:37.09,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:11:39.09,0:11:41.10,Default,,0,0,0,,《Ю-сан…》
Dialogue: 0,0:11:45.10,0:11:47.10,Default,,0,0,0,,Амансың ба? Юу.
Dialogue: 0,0:11:47.10,0:11:49.10,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:11:49.10,0:11:54.11,Default,,0,0,0,,Бірақ... Мен қауіпсіз аймақта жалғыз бола алмаймын.
Dialogue: 0,0:11:54.11,0:11:56.08,Default,,0,0,0,,Мен бәрін лақтырып жіберемін!
Dialogue: 0,0:11:57.08,0:11:59.15,Default,,0,0,0,,Юу….
Dialogue: 0,0:11:59.15,0:12:02.15,Default,,0,0,0,,Қызық! Бұл кері су формациясы ма?
Dialogue: 0,0:12:02.15,0:12:04.09,Default,,0,0,0,,Енді шабуыл мен қорғанысты ауыстыратын кез келді.
Dialogue: 0,0:12:04.09,0:12:08.09,Default,,0,0,0,,Ойын FOX ONE командасының шабуылымен қайта басталады!
Dialogue: 0,0:12:08.09,0:12:10.09,Default,,0,0,0,,Сонымен стратегия қандай?
Dialogue: 0,0:12:10.09,0:12:12.09,Default,,0,0,0,,Жоқ! Мен шешкен жоқпын!
Dialogue: 0,0:12:12.09,0:12:14.16,Default,,0,0,0,,Иә! ? Бұл не!
Dialogue: 0,0:12:14.16,0:12:16.10,Default,,0,0,0,,Жақсы! Басыңыз! Жабыңыз!
Dialogue: 0,0:12:16.10,0:12:18.10,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:12:19.17,0:12:21.10,Default,,0,0,0,,үшін жақсы болады, иә?
Dialogue: 0,0:12:21.10,0:12:24.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:25.17,0:12:27.11,Default,,0,0,0,,"(мылтық)"
Dialogue: 0,0:12:27.11,0:12:29.11,Default,,0,0,0,,Мен және Шун Чан тоқтаймыз!
Dialogue: 0,0:12:29.11,0:12:31.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:12:31.11,0:12:33.08,Default,,0,0,0,,Бір ғана жау! Мен бара аламын!
Dialogue: 0,0:12:33.08,0:12:35.12,Default,,0,0,0,,Қараңғы дауыл!
Dialogue: 0,0:12:35.12,0:12:45.09,Default,,0,0,0,,♬～
Dialogue: 0,0:12:45.09,0:12:49.10,Default,,0,0,0,,Өшіргіш орнату! Мен 45 секундқа шыдай аламын!
Dialogue: 0,0:12:49.10,0:12:51.10,Default,,0,0,0,,Қорғаныс бөгеті қалыптасуына ауысу.
Dialogue: 0,0:12:51.10,0:12:53.10,Default,,0,0,0,,А сілтемесінде көптеген жаулар!
Dialogue: 0,0:12:53.10,0:12:55.10,Default,,0,0,0,,О, жоқ... бұзылған!
Dialogue: 0,0:12:55.10,0:12:57.11,Default,,0,0,0,,«(Мылтық дыбысы)» Қазір! Артынан айналып өт!
Dialogue: 0,0:12:57.11,0:13:00.11,Default,,0,0,0,,КӨШІРУ! «(мылтық)»
Dialogue: 0,0:13:00.11,0:13:02.11,Default,,0,0,0,,Сәлем! Жақсы қоңырау!
Dialogue: 0,0:13:02.11,0:13:05.11,Default,,0,0,0,,Акацуки! Бұл қысқыш шабуыл!
Dialogue: 0,0:13:05.11,0:13:07.08,Default,,0,0,0,,Сәлем! Мені шын атым деп атама!
Dialogue: 0,0:13:11.09,0:13:13.09,Default,,0,0,0,,Шабуылшы жеңеді!
Dialogue: 0,0:13:14.09,0:13:16.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:16.09,0:13:20.16,Default,,0,0,0,,Жарайсыңдар! Қарғыс атқыр... мойнымдағы тері жалғанған.
Dialogue: 0,0:13:20.16,0:13:23.10,Default,,0,0,0,,Тікелей жеңістер жойылды.
Dialogue: 0,0:13:23.10,0:13:27.17,Default,,0,0,0,,Жаудың әрекет ету принципі өзгерген сияқты.
Dialogue: 0,0:13:27.17,0:13:29.17,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:13:31.11,0:13:33.11,Default,,0,0,0,,«(Мылтық дыбысы)» Мұқаба!
Dialogue: 0,0:13:33.11,0:13:36.11,Default,,0,0,0,,Мен де барамын! (Рюсей) Мен D жоспарымен барамын!
Dialogue: 0,0:13:36.11,0:13:38.11,Default,,0,0,0,,ＣＯＰＹ！
Dialogue: 0,0:13:38.11,0:13:40.11,Default,,0,0,0,,Тарту!
Dialogue: 0,0:13:40.11,0:13:43.12,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:13:43.12,0:13:45.09,Default,,0,0,0,,Шабуылшы жеңеді!
Dialogue: 0,0:13:45.09,0:13:48.09,Default,,0,0,0,,Жарайсыңдар! 2-ші ұпай! Сіз әлі де бара аласыз!
Dialogue: 0,0:13:49.19,0:13:52.16,Default,,0,0,0,,《Мен бұрын көре алмаған болашақты көремін! 》
Dialogue: 0,0:13:53.13,0:13:57.10,Default,,0,0,0,,《Онда тығылып жатсаңыз... осы жерден келе жатыр! 》
Dialogue: 0,0:13:57.10,0:14:00.10,Default,,0,0,0,,《Ал ROX осында...→
Dialogue: 0,0:14:00.10,0:14:02.10,Default,,0,0,0,,Міне! 》
Dialogue: 0,0:14:02.10,0:14:04.11,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:14:04.11,0:14:06.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:14:07.11,0:14:09.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:14:09.11,0:14:12.11,Default,,0,0,0,,Жақсы! Көңілді болып барады!
Dialogue: 0,0:14:12.11,0:14:14.15,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:14:14.15,0:14:16.15,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:14:17.12,0:14:20.12,Default,,0,0,0,,Хехехе... хахахаха...!
Dialogue: 0,0:14:20.12,0:14:22.09,Default,,0,0,0,,Атқанда несіне күлесің?
Dialogue: 0,0:14:22.09,0:14:26.09,Default,,0,0,0,,Мен көріп тұрмын... Ол көреді!
Dialogue: 0,0:14:26.09,0:14:30.10,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:14:30.10,0:14:32.17,Default,,0,0,0,,Шабуылшы жеңеді!
Dialogue: 0,0:14:32.17,0:14:36.17,Default,,0,0,0,,FOX ONE командасы үстелдерді айналдырады! Керемет қуып жетіңіз!
Dialogue: 0,0:14:38.11,0:14:41.11,Default,,0,0,0,,«(Мылтық дыбысы)» Жарайды, мен өлтірдім!
Dialogue: 0,0:14:41.11,0:14:44.11,Default,,0,0,0,,Ах! Longshot шығарылды!
Dialogue: 0,0:14:45.11,0:14:48.12,Default,,0,0,0,,Өшіргішті жою. Жауды ұстаңыз!
Dialogue: 0,0:14:49.12,0:14:52.12,Default,,0,0,0,,Оларды жою жылдамырақ.
Dialogue: 0,0:14:52.12,0:14:55.22,Default,,0,0,0,,ROX-тың қос өлтіруі! Ұйқыдағы үкі де қайтады!
Dialogue: 0,0:14:55.22,0:14:59.19,Default,,0,0,0,,Енді ұпайлар 6-6 сәйкестік ұпайлары!
Dialogue: 0,0:15:00.13,0:15:03.16,Default,,0,0,0,,Бұл соңғы раунд па?
Dialogue: 0,0:15:03.16,0:15:06.10,Default,,0,0,0,,Иә, бұл мәселені шешеді.
Dialogue: 0,0:15:06.10,0:15:08.10,Default,,0,0,0,,《Міндетті түрде жең! 》
Dialogue: 0,0:15:08.10,0:15:10.10,Default,,0,0,0,,Менің қарным ашылып жатыр!
Dialogue: 0,0:15:10.10,0:15:19.31,Default,,0,0,0,,♬～
Dialogue: 0,0:15:19.31,0:15:21.32,Default,,0,0,0,,Отты ашыңыз!
Dialogue: 0,0:15:22.12,0:15:24.09,Default,,0,0,0,,В-ға асығыңыз!
Dialogue: 0,0:15:25.12,0:15:27.12,Default,,0,0,0,,...Бетін бүркеген бұрыс.
Dialogue: 0,0:15:27.12,0:15:29.19,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:15:29.19,0:15:32.16,Default,,0,0,0,,...Шын мәнінде негізгі күш болып көрінгенімен!
Dialogue: 0,0:15:33.13,0:15:35.13,Default,,0,0,0,,Бір ғана адам бар! Мен В-мен жеңдім!
Dialogue: 0,0:15:35.13,0:15:37.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:38.10,0:15:40.13,Default,,0,0,0,,Зарядтау! Апыр-ай!
Dialogue: 0,0:15:40.13,0:15:43.10,Default,,0,0,0,,Жау келді! Асықшы!
Dialogue: 0,0:15:43.10,0:15:45.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:15:45.11,0:15:47.14,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:15:47.14,0:15:50.14,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:15:50.14,0:15:52.11,Default,,0,0,0,,Қат! X жоспары! иә?
Dialogue: 0,0:15:52.11,0:15:55.12,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:15:57.08,0:15:59.25,Default,,0,0,0,,"(Жарылыс дыбысы)" (Юу) Заряд!
Dialogue: 0,0:15:59.25,0:16:01.26,Default,,0,0,0,,Жалғасы бар!
Dialogue: 0,0:16:03.09,0:16:05.09,Default,,0,0,0,,Көрінбейді. ауыстырыңыз!
Dialogue: 0,0:16:07.13,0:16:09.10,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:10.10,0:16:12.17,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:12.17,0:16:14.20,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:16:14.20,0:16:16.20,Default,,0,0,0,,Түсінікті! жақсы!
Dialogue: 0,0:16:17.10,0:16:19.21,Default,,0,0,0,,Өшіргіш орнатылған!
Dialogue: 0,0:16:19.21,0:16:21.08,Default,,0,0,0,,45 секунд Қорғаңыз!
Dialogue: 0,0:16:21.08,0:16:23.11,Default,,0,0,0,,ＣＯＰＹ！
Dialogue: 0,0:16:23.11,0:16:27.08,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:28.08,0:16:31.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:31.09,0:16:33.12,Default,,0,0,0,,Қияметсіз...!
Dialogue: 0,0:16:33.12,0:16:35.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:36.09,0:16:39.23,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:39.23,0:16:41.10,Default,,0,0,0,,Мен қараңғылыққа қайтамын.
Dialogue: 0,0:16:41.10,0:16:44.23,Default,,0,0,0,,《Қайда? Бұл қайда! 》
Dialogue: 0,0:16:44.23,0:16:50.10,Default,,0,0,0,,♬～
Dialogue: 0,0:16:50.10,0:16:53.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:53.11,0:16:55.08,Default,,0,0,0,,《Басы жойылды...》
Dialogue: 0,0:16:56.11,0:16:58.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:16:58.11,0:17:00.08,Default,,0,0,0,,«(Әуе ату дыбысы)» Ах....
Dialogue: 0,0:17:00.08,0:17:02.05,Default,,0,0,0,,Оқ бітті...!
Dialogue: 0,0:17:03.12,0:17:07.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:17:07.09,0:17:20.10,Default,,0,0,0,,♬～
Dialogue: 0,0:17:21.10,0:17:23.07,Default,,0,0,0,,Хмф….
Dialogue: 0,0:17:26.11,0:17:28.11,Default,,0,0,0,,Өлгенде бірге боламыз!
Dialogue: 0,0:17:28.11,0:17:32.08,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:17:34.08,0:17:36.08,Default,,0,0,0,,«(Дыбыс жүктелуде)»
Dialogue: 0,0:17:36.08,0:17:39.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:17:39.09,0:17:41.09,Default,,0,0,0,,Ах! (Юу) Міне!
Dialogue: 0,0:17:42.09,0:17:44.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:17:45.09,0:17:47.09,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:17:51.10,0:17:53.17,Default,,0,0,0,,Сен оны білесің бе, Аводөл? (Аводөл) Ах… өте
Dialogue: 0,0:17:53.17,0:18:06.08,Default,,0,0,0,,♬～
Dialogue: 0,0:18:06.08,0:18:14.12,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:18:14.12,0:18:34.11,Default,,0,0,0,,♬～
Dialogue: 0,0:18:34.11,0:18:38.11,Default,,0,0,0,,«(Мылтық дыбысы)»
Dialogue: 0,0:18:38.11,0:18:46.12,Default,,0,0,0,,♬～
Dialogue: 0,0:18:46.12,0:18:48.12,Default,,0,0,0,,"(мылтық)"
Dialogue: 0,0:18:48.12,0:18:56.10,Default,,0,0,0,,♬～
Dialogue: 0,0:18:56.10,0:18:58.07,Default,,0,0,0,,«(Шылау дыбысы)»
Dialogue: 0,0:19:03.10,0:19:08.11,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:19:08.11,0:19:12.08,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:19:12.08,0:19:17.08,Default,,0,0,0,,Осымен 6-орын бекітілді! Лигаға қосылуды шешті!
Dialogue: 0,0:19:17.08,0:19:19.09,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:19:19.09,0:19:21.09,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:24.09,0:19:28.10,Default,,0,0,0,,Иә! Біз мұны істедік, Шун!
Dialogue: 0,0:19:28.10,0:19:32.17,Default,,0,0,0,,А... А... Мен шаршадым.
Dialogue: 0,0:19:32.17,0:19:35.14,Default,,0,0,0,,Иә, бұл ұзақ және қиын шайқас болды.
Dialogue: 0,0:19:35.14,0:19:37.10,Default,,0,0,0,,№.
Dialogue: 0,0:19:37.10,0:19:42.08,Default,,0,0,0,,Менің ойымша... бұл мен үшін ең қызық болды.
Dialogue: 0,0:19:44.15,0:19:47.11,Default,,0,0,0,,Иә. мен де.
Dialogue: 0,0:19:47.11,0:19:49.08,Default,,0,0,0,,Шун-кун.
Dialogue: 0,0:19:54.12,0:19:57.09,Default,,0,0,0,,Бүгінгі матчқа жақсы.
Dialogue: 0,0:19:58.13,0:20:00.23,Default,,0,0,0,,Мен мұны істейсің деп ойладым.
Dialogue: 0,0:20:00.23,0:20:02.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:02.13,0:20:05.27,Default,,0,0,0,,Мен күшейген сенімен күресуді жалғастыра аламын.
Dialogue: 0,0:20:05.27,0:20:07.27,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,0:20:08.17,0:20:12.17,Default,,0,0,0,,Сонда кездескенше. Келесісін асыға күтемін.
Dialogue: 0,0:20:13.11,0:20:17.11,Default,,0,0,0,,《Менің әлеміме қош келдіңіз》
Dialogue: 0,0:20:21.18,0:20:23.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:23.12,0:20:26.09,Default,,0,0,0,,Фантом Ниндзяның шынайы тұлғасы Біз шыңға жеттік.
Dialogue: 0,0:20:26.09,0:20:29.12,Default,,0,0,0,,Юудың жанкүйерлері де шу шығарып жатыр.
Dialogue: 0,0:20:29.12,0:20:31.13,Default,,0,0,0,,Иә….
Dialogue: 0,0:20:31.13,0:20:33.13,Default,,0,0,0,,Сіз керемет нәрсе жасадыңыз.
Dialogue: 0,0:20:33.13,0:20:35.20,Default,,0,0,0,,Сакагами мырза.
Dialogue: 0,0:20:35.20,0:20:39.10,Default,,0,0,0,,Кейбір жанкүйерлер бүгін болған оқиғаға байланысты кетіп қалды.
Dialogue: 0,0:20:39.10,0:20:43.14,Default,,0,0,0,,Әртүрлі байланысты тараптарда «Phantom Ninja» құпия түрде біз тарапымыздан құрылған деп айтылады→
Dialogue: 0,0:20:43.14,0:20:46.11,Default,,0,0,0,,Мен оны жоба деп алдадым, бірақ...
Dialogue: 0,0:20:46.11,0:20:50.24,Default,,0,0,0,,Бір нәрсені түсіндіру қаншалықты қиын екенін білесіз бе?
Dialogue: 0,0:20:50.24,0:20:52.25,Default,,0,0,0,,Мен шынымен кешірім сұраймын...
Dialogue: 0,0:20:53.11,0:20:57.08,Default,,0,0,0,,Олай болса, мен сендермен болашақ туралы сөйлескім келеді.
Dialogue: 0,0:20:59.12,0:21:02.09,Default,,0,0,0,,Неліктен оны Phantom Ninja басқару кеңсесінде қалдырмасқа?
Dialogue: 0,0:21:02.09,0:21:04.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.19,0:21:07.13,Default,,0,0,0,,Оң пікірлер көп болды.
Dialogue: 0,0:21:07.13,0:21:11.10,Default,,0,0,0,,Өзіміз қолға алсақ жақсы сатылады деп ойлаймын.
Dialogue: 0,0:21:11.10,0:21:14.10,Default,,0,0,0,,Сондай-ақ, FOX ONE командасының басшылығы→
Dialogue: 0,0:21:14.10,0:21:16.10,Default,,0,0,0,,Менімен үйде болғың келе ме?
Dialogue: 0,0:21:16.10,0:21:18.07,Default,,0,0,0,,Не?!
Dialogue: 0,0:21:29.15,0:21:31.15,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,0:21:32.09,0:21:34.09,Default,,0,0,0,,Иә, мен үйдемін.
Dialogue: 0,0:21:34.09,0:21:44.10,Default,,0,0,0,,♬～
Dialogue: 0,0:21:45.60,0:21:51.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
