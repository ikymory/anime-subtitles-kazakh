Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:21.22,0:00:22.43,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:00:23.35,0:00:25.90,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:00:27.02,0:00:28.65,Default,,0,0,0,,Айыпталушы!
Dialogue: 0,0:00:30.07,0:00:33.19,Default,,0,0,0,,Өздеріңіз білетіндей, бұл қарғыс
Dialogue: 0,0:00:33.28,0:00:38.28,Default,,0,0,0,,Ежелгі және күшті зұлым рухтың күшімен жүзеге асырылатын мәжбүрлі қарғыс.
Dialogue: 0,0:00:38.91,0:00:39.74,Default,,0,0,0,,Бұл жағдайда -
Dialogue: 0,0:00:39.83,0:00:42.75,Default,,0,0,0,,Сіз Дарк Шнайдерді жеңе алмадыңыз.
Dialogue: 0,0:00:42.83,0:00:45.50,Default,,0,0,0,,Жауға тағы берілмек болғанымда
Dialogue: 0,0:00:45.58,0:00:49.75,Default,,0,0,0,,Бұл көк тырнақтар күлгін, содан кейін қызылға айналады.
Dialogue: 0,0:00:49.84,0:00:50.55,Default,,0,0,0,,Және…
Dialogue: 0,0:00:50.63,0:00:53.26,Default,,0,0,0,,Мен білемін, тез орында.
Dialogue: 0,0:00:53.92,0:00:57.34,Default,,0,0,0,,Жарайды, оң жақ сұқ саусақ...
Dialogue: 0,0:01:01.35,0:01:03.85,Default,,0,0,0,,...
Dialogue: 0,0:01:04.35,0:01:07.31,Default,,0,0,0,,Жарқанаттың қанатынан, Түн патшасы жындар
Dialogue: 0,0:01:08.31,0:01:11.94,Default,,0,0,0,,Менің тырнақтарымда тұрып, келісім-шарттың күші бол!
Dialogue: 0,0:01:12.57,0:01:13.90,Default,,0,0,0,,Айыпталушы!
Dialogue: 0,0:01:21.95,0:01:24.08,Default,,0,0,0,,Рәсім аяқталды
Dialogue: 0,0:01:24.16,0:01:26.58,Default,,0,0,0,,Армандауды ұмытпаңыз...
Dialogue: 0,0:01:27.17,0:01:29.83,Default,,0,0,0,,Алайда мен сол көк тырнақтарды көрген сайын,
Dialogue: 0,0:01:29.92,0:01:31.71,Default,,0,0,0,,Естеріңізде болса...
Dialogue: 0,0:01:31.80,0:01:35.55,Default,,0,0,0,,Я, мен Дирк Шнайдер мен Галаны бәрібір өлтіремін.
Dialogue: 0,0:01:35.63,0:01:38.26,Default,,0,0,0,,Мұндай нәрсе бар ма, жоқ па, бәрі бірдей.
Dialogue: 0,0:01:38.34,0:01:40.35,Default,,0,0,0,,Бұл өте...
Dialogue: 0,0:01:40.43,0:01:44.64,Default,,0,0,0,,Ол құрбақа немесе басқа нәрсеге айналу үшін тым әдемі!
Dialogue: 0,0:01:45.18,0:01:48.35,Default,,0,0,0,,Сөйлесіп біттіңіз бе? Ұрысқа барайық!
Dialogue: 0,0:01:51.48,0:01:53.19,Default,,0,0,0,,♪～
Dialogue: 0,0:03:18.86,0:03:20.86,Default,,0,0,0,,～♪
Dialogue: 0,0:03:21.99,0:03:24.78,Default,,0,0,0,,Бұл тым көп емес пе, Абигейл?
Dialogue: 0,0:03:24.87,0:03:28.66,Default,,0,0,0,,Сіз шынымен Ней бізді сатады деп ойлайсыз ба?
Dialogue: 0,0:03:28.75,0:03:30.29,Default,,0,0,0,,Сол жарты эльф
Dialogue: 0,0:03:30.37,0:03:34.29,Default,,0,0,0,,Мен Дирк Шнайдерді әке ретінде жақсы көремін.
Dialogue: 0,0:03:34.38,0:03:36.21,Default,,0,0,0,,Оның үстіне 100 жылдан астам
Dialogue: 0,0:03:36.29,0:03:38.55,Default,,0,0,0,,Мен Дирк Шнайдермен бірге тұрдым.
Dialogue: 0,0:03:38.63,0:03:42.88,Default,,0,0,0,,Біздің бәрімізден ол оған ең жақын адам.
Dialogue: 0,0:03:42.97,0:03:43.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:43.97,0:03:45.35,Default,,0,0,0,,Қал
Dialogue: 0,0:03:45.43,0:03:47.97,Default,,0,0,0,,Сіз Дирк Шнайдердің қазіргі қозғалыстарынан хабардарсыз ба?
Dialogue: 0,0:03:48.06,0:03:49.35,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:50.23,0:03:51.81,Default,,0,0,0,,​​Мен түсінбеймін.
Dialogue: 0,0:03:53.31,0:03:55.73,Default,,0,0,0,,Мен білетін Дирк Шнайдер
Dialogue: 0,0:03:55.81,0:03:57.82,Default,,0,0,0,,Барлық жауларды өлтіріңіз
Dialogue: 0,0:03:57.90,0:03:58.94,Default,,0,0,0,,Егер сіз жеңілген болсаңыз
Dialogue: 0,0:03:59.03,0:04:02.11,Default,,0,0,0,,Ол тіпті өзінің қарамағындағыларға да аяушылық көрсетпейтін мейірімсіз жын еді.
Dialogue: 0,0:04:03.03,0:04:04.61,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:04.70,0:04:09.99,Default,,0,0,0,,Енді олар Гала мен Кидошуды өлтірудің орнына оларды жайғастырып, одақтас етеді.
Dialogue: 0,0:04:10.08,0:04:11.54,Default,,0,0,0,,Иә
Dialogue: 0,0:04:11.62,0:04:15.96,Default,,0,0,0,,Осы 15 жылдық үзілісте адамдар өзгеріп кеткендей.
Dialogue: 0,0:04:16.67,0:04:20.80,Default,,0,0,0,,Менің досым болған, мен сүйетін ұстаз...
Dialogue: 0,0:04:21.67,0:04:26.01,Default,,0,0,0,,Соңғы 15 жылда соншалықты өзгеруіңізге не себеп болды?
Dialogue: 0,0:04:26.09,0:04:29.97,Default,,0,0,0,,Бір нәрсе анық, Қардың.
Dialogue: 0,0:04:31.60,0:04:33.85,Default,,0,0,0,,Бұл Дирк Шнайдер қазір
Dialogue: 0,0:04:33.94,0:04:38.06,Default,,0,0,0,,Біздің мұраттарымыздың жолында тұрған ең үлкен жау.
Dialogue: 0,0:04:39.69,0:04:41.53,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:04:41.61,0:04:43.99,Default,,0,0,0,,Бұл адам қауіпті.
Dialogue: 0,0:04:44.65,0:04:48.87,Default,,0,0,0,,Мен ол кісіні не болса да өлтіруім керек!
Dialogue: 0,0:04:48.95,0:04:52.25,Default,,0,0,0,,Сібір жарасын жою Құдайы жүзеге асырды
Dialogue: 0,0:04:52.83,0:04:55.21,Default,,0,0,0,,Біздің түпкі идеалды қоғамымыз
Dialogue: 0,0:04:55.29,0:04:57.38,Default,,0,0,0,,Сиқырлы күш басқарады-
Dialogue: 0,0:04:57.46,0:05:01.59,Default,,0,0,0,,Соғыссыз, кемсітушіліксіз және кедейліксіз кемел патшалық
Dialogue: 0,0:05:01.67,0:05:04.55,Default,,0,0,0,,Сиқырлы патшалық үшін!
Dialogue: 0,0:05:05.34,0:05:07.47,Default,,0,0,0,,Қараңыз, Кал.
Dialogue: 0,0:05:07.55,0:05:10.56,Default,,0,0,0,,Бірінші кезеңде Сібір жарасының жандануы болып табылады
Dialogue: 0,0:05:10.64,0:05:13.14,Default,,0,0,0,,Біз максимумға жеттік
Dialogue: 0,0:05:13.64,0:05:19.73,Default,,0,0,0,,Біз екінші, үшінші және төртінші пломбаларды мүмкіндігінше тезірек ашуымыз керек.
Dialogue: 0,0:05:19.81,0:05:21.11,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:21.19,0:05:24.69,Default,,0,0,0,,Менің бірінші әскеріммен, көтерілісшілер әскерінің негізгі күші
Dialogue: 0,0:05:24.78,0:05:27.36,Default,,0,0,0,,Екінші армияңызды орналастыруға асығыңыз.
Dialogue: 0,0:05:27.95,0:05:29.20,Default,,0,0,0,,Ней Дирк Шнайдерді алады
Dialogue: 0,0:05:29.28,0:05:30.62,Default,,0,0,0,,Ұстап тұрғанда
Dialogue: 0,0:05:30.70,0:05:34.62,Default,,0,0,0,,Қалған екі патша отбасының мөрлерін басып алыңыз.
Dialogue: 0,0:05:36.46,0:05:37.42,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:05:37.50,0:05:40.21,Default,,0,0,0,,Дирк Шнайдер және Эшет Ней
Dialogue: 0,0:05:40.29,0:05:42.38,Default,,0,0,0,,Қызықты карта
Dialogue: 0,0:05:42.46,0:05:46.05,Default,,0,0,0,,Қандай жағдай болса да, бұл біздің шығынымыз емес.
Dialogue: 0,0:05:46.13,0:05:48.89,Default,,0,0,0,,Калус, сен басынан бастапсың.
Dialogue: 0,0:05:48.97,0:05:51.76,Default,,0,0,0,,Өздеріңіз білетіндей, Ней жұмыс істейді.
Dialogue: 0,0:05:51.85,0:05:56.02,Default,,0,0,0,,Айыпталушыны босату үшін арнайы катализатор қажет.
Dialogue: 0,0:05:56.52,0:06:00.77,Default,,0,0,0,,Қарғыс атқан адамның балғын жүрегі.
Dialogue: 0,0:06:06.90,0:06:08.40,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:06:08.99,0:06:12.37,Default,,0,0,0,,Сонымен, бұл жағдайда Күл Ней
Dialogue: 0,0:06:12.45,0:06:13.99,Default,,0,0,0,,Қарғысты бұзу
Dialogue: 0,0:06:14.08,0:06:16.62,Default,,0,0,0,,Дирк Шнайдердің жүрегі тірі қан тамшылайды
Dialogue: 0,0:06:16.70,0:06:19.33,Default,,0,0,0,,Бұл оны сүйреп шығаруымыз керек дегенді білдіреді.
Dialogue: 0,0:06:19.83,0:06:21.29,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:06:21.38,0:06:23.63,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:06:23.71,0:06:29.26,Default,,0,0,0,,Ней бізге опасыздық жасаса да, қарғыс одан құтылады.
Dialogue: 0,0:06:29.93,0:06:33.05,Default,,0,0,0,,Сондай-ақ, Дирк Шнайдер Нейге көмектесуге тырысса да,
Dialogue: 0,0:06:33.14,0:06:36.47,Default,,0,0,0,,Ол үшін өлуі керек
Dialogue: 0,0:06:36.56,0:06:41.98,Default,,0,0,0,,Оның үстіне сиқырлы күші бірдей екі адам бетпе-бет соқтығысса...
Dialogue: 0,0:06:42.06,0:06:45.90,Default,,0,0,0,,Екінің бірі, жоқ, екеуі де.
Dialogue: 0,0:06:45.98,0:06:50.32,Default,,0,0,0,,Бұл жерден із-түзсіз жоғалып кетуі мүмкін.
Dialogue: 0,0:06:50.99,0:06:54.70,Default,,0,0,0,,Қалай болғанда да, бұл біздің пайдамызға.
Dialogue: 0,0:06:54.78,0:06:57.62,Default,,0,0,0,,Хахахаха хахахаха!
Dialogue: 0,0:06:57.70,0:07:02.33,Default,,0,0,0,,Бұл өте жаман ставка, Эшет Ней.
Dialogue: 0,0:07:07.55,0:07:10.88,Default,,0,0,0,,Йоко-доно! Вагон дайын
Dialogue: 0,0:07:10.97,0:07:13.68,Default,,0,0,0,,Рахмет! Бір минут күтіңіз
Dialogue: 0,0:07:18.89,0:07:20.73,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:07:22.35,0:07:24.02,Default,,0,0,0,,Қарашы, қыз...
Dialogue: 0,0:07:24.11,0:07:26.02,Default,,0,0,0,,Бұл бетті жасамаңыз.
Dialogue: 0,0:07:26.11,0:07:27.73,Default,,0,0,0,,Сүйкімді жүзің бұзылды.
Dialogue: 0,0:07:27.82,0:07:28.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:28.40,0:07:32.78,Default,,0,0,0,,Осы жерден Кант храмына ат арбамен жетуге жарты күннен аз уақыт кетеді.
Dialogue: 0,0:07:33.36,0:07:36.74,Default,,0,0,0,,Соғыс алаңы болып табылатын Металликанаға жақын.
Dialogue: 0,0:07:36.83,0:07:38.45,Default,,0,0,0,,Он жыл. Мен он жыл күттім.
Dialogue: 0,0:07:39.95,0:07:41.33,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:07:42.08,0:07:43.67,Default,,0,0,0,,Абайлаңыз Шон Хари
Dialogue: 0,0:07:44.17,0:07:47.42,Default,,0,0,0,,Оны ғибадатханада емдесең, Кай тез сауығып кетеді.
Dialogue: 0,0:07:47.50,0:07:48.63,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:07:49.51,0:07:52.47,Default,,0,0,0,,Рахмет сізге Tear Note Yoko
Dialogue: 0,0:07:53.30,0:07:56.68,Default,,0,0,0,,Сол Дай Амонды менсінбеген сенсің.
Dialogue: 0,0:07:56.76,0:07:58.85,Default,,0,0,0,,Мен артық ештеңе айтпаймын
Dialogue: 0,0:07:58.93,0:08:02.98,Default,,0,0,0,,Аспандағы төрт патшаның ішінде тіпті найзағай императоры деп те аталатын лорд Ней,
Dialogue: 0,0:08:03.06,0:08:06.27,Default,,0,0,0,,Сізге ең жақын күшке ие болу
Dialogue: 0,0:08:06.36,0:08:07.32,Default,,0,0,0,,Есте сақта...
Dialogue: 0,0:08:07.40,0:08:11.53,Default,,0,0,0,,А, түсіндім, тезірек кет.
Dialogue: 0,0:08:12.78,0:08:14.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:17.33,0:08:19.66,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:08:19.74,0:08:21.50,Default,,0,0,0,,Ней мырзаны өтінемін
Dialogue: 0,0:08:24.29,0:08:26.67,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:08:30.46,0:08:33.38,Default,,0,0,0,,Білесіз бе, мен шынымен де білдім.
Dialogue: 0,0:08:34.05,0:08:36.84,Default,,0,0,0,,Менің сезімім оған жетпейді...
Dialogue: 0,0:08:37.80,0:08:42.23,Default,,0,0,0,,Өйткені ол мені ешқашан атыммен атамаған.
Dialogue: 0,0:08:42.85,0:08:46.48,Default,,0,0,0,,Мұны салқын айта алмайсың, солай ма? Бұл тым көп емес пе?
Dialogue: 0,0:08:47.40,0:08:49.11,Default,,0,0,0,,Қандай керемет адам.
Dialogue: 0,0:08:51.48,0:08:54.40,Default,,0,0,0,,Бірақ мені де ұмытпа
Dialogue: 0,0:08:55.15,0:08:56.74,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:08:58.28,0:08:59.70,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:09:04.21,0:09:05.71,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:09:06.21,0:09:08.63,Default,,0,0,0,,Ол өте сүйкімді еді, солай емес пе?
Dialogue: 0,0:09:08.71,0:09:10.00,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:10.09,0:09:12.92,Default,,0,0,0,,Люс... жоқ, Дирк Шнайдер
Dialogue: 0,0:09:13.01,0:09:14.72,Default,,0,0,0,,Дос ретінде мен сізге кеңес бергім келеді.
Dialogue: 0,0:09:16.01,0:09:19.47,Default,,0,0,0,,Қыз, қызды жылататын намыссыз еркек жарамас!
Dialogue: 0,0:09:19.55,0:09:21.76,Default,,0,0,0,,Бала мангасының басты кейіпкері ретінде!
Dialogue: 0,0:09:21.85,0:09:24.31,Default,,0,0,0,,Иә? Йоко-сан, ашуландың ба?
Dialogue: 0,0:09:25.06,0:09:26.52,Default,,0,0,0,,Кішкене қызғаншақ болдыңыз ба?
Dialogue: 0,0:09:26.60,0:09:27.52,Default,,0,0,0,,Фуга!
Dialogue: 0,0:09:27.60,0:09:31.61,Default,,0,0,0,,Енді Metallicana-ға барайық!
Dialogue: 0,0:09:33.03,0:09:35.90,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:35.99,0:09:37.86,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:09:41.37,0:09:43.20,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:09:43.29,0:09:44.37,Default,,0,0,0,,Гала-Виверн...
Dialogue: 0,0:09:44.95,0:09:46.75,Default,,0,0,0,,(Иида) Мен осы уақыт бойы толық жүктемеде жүрмін!
Dialogue: 0,0:09:47.37,0:09:49.50,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:50.00,0:09:51.67,Default,,0,0,0,,Гала-саманы жалғастырыңыз!
Dialogue: 0,0:09:51.75,0:09:53.21,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:09:53.71,0:09:55.76,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:09:56.30,0:09:59.34,Default,,0,0,0,,Олар қанша гоблин тобын құраса да...
Dialogue: 0,0:09:59.43,0:10:00.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:00.14,0:10:01.18,Default,,0,0,0,,Ой!
Dialogue: 0,0:10:01.97,0:10:02.81,Default,,0,0,0,,Найзағай соғу!
Dialogue: 0,0:10:04.56,0:10:06.39,Default,,0,0,0,,Ах, бұл грифон!
Dialogue: 0,0:10:06.48,0:10:07.94,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:09.19,0:10:09.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:10.35,0:10:11.90,Default,,0,0,0,,Хааах!
Dialogue: 0,0:10:13.61,0:10:14.53,Default,,0,0,0,,О!
Dialogue: 0,0:10:14.61,0:10:15.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:18.65,0:10:21.95,Default,,0,0,0,,Сіз осындасыз, Эшет Ней!
Dialogue: 0,0:10:22.03,0:10:24.29,Default,,0,0,0,,Гала! Менің бір сұрағым бар
Dialogue: 0,0:10:24.83,0:10:26.75,Default,,0,0,0,,Аспандағы Төрт Патшаға неге опасыздық жасадың?
Dialogue: 0,0:10:26.83,0:10:29.08,Default,,0,0,0,,Хехе, шешілді.
Dialogue: 0,0:10:29.71,0:10:31.92,Default,,0,0,0,,Дирк Шнайдердің істегені жақсырақ
Dialogue: 0,0:10:32.00,0:10:34.59,Default,,0,0,0,,Себебі бұл қызықты көрінеді! Хехе
Dialogue: 0,0:10:34.67,0:10:36.55,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:10:36.63,0:10:38.13,Default,,0,0,0,,Кесу!
Dialogue: 0,0:10:41.97,0:10:43.85,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:10:43.93,0:10:45.81,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:10:45.89,0:10:48.56,Default,,0,0,0,,Сіз Ниндзя шебері атағын иеленгенсіз
Dialogue: 0,0:10:48.64,0:10:51.98,Default,,0,0,0,,Бұрынғы дос болса да, бүлікші әскердің басты жауы.
Dialogue: 0,0:10:52.06,0:10:54.69,Default,,0,0,0,,Дирк Шнайдер оңай орналастырды
Dialogue: 0,0:10:54.77,0:10:57.28,Default,,0,0,0,,Мен оның жанкүйерлерінің бірі боламын деп ешқашан ойламаппын!
Dialogue: 0,0:10:57.82,0:11:01.24,Default,,0,0,0,,Хехехе... Каль сияқты сөздерді айтпа!
Dialogue: 0,0:11:01.32,0:11:03.49,Default,,0,0,0,,Сіз шынымен де солсыз
Dialogue: 0,0:11:03.57,0:11:06.08,Default,,0,0,0,,Сіз Дирк Шнайдерге келген жоқсыз ба?
Dialogue: 0,0:11:06.16,0:11:07.41,Default,,0,0,0,,Эшет Ней!
Dialogue: 0,0:11:07.50,0:11:08.50,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:11:09.62,0:11:11.33,Default,,0,0,0,,Найзағай қылыш!
Dialogue: 0,0:11:11.42,0:11:13.42,Default,,0,0,0,,Сол қылыш...
Dialogue: 0,0:11:14.63,0:11:16.38,Default,,0,0,0,,Мурасаме жүзі!
Dialogue: 0,0:11:16.88,0:11:18.55,Default,,0,0,0,,Ақымақ адамдар—
Dialogue: 0,0:11:19.05,0:11:19.67,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:19.76,0:11:21.72,Default,,0,0,0,,Уф! Ку…
Dialogue: 0,0:11:22.84,0:11:24.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:27.35,0:11:28.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:28.77,0:11:31.77,Default,,0,0,0,,Мен бұл найзағай құдай семсерінің соққысына сәтті төтеп бердім.
Dialogue: 0,0:11:31.85,0:11:34.19,Default,,0,0,0,,Сиқырлы қылыш күткендей, Мурасаме Жүзі
Dialogue: 0,0:11:34.27,0:11:37.65,Default,,0,0,0,,Эй, сенде бір қызық бар.
Dialogue: 0,0:11:38.23,0:11:40.82,Default,,0,0,0,,Бірінші рет өз көзіммен көріп тұрмын.
Dialogue: 0,0:11:40.90,0:11:44.37,Default,,0,0,0,,Қараңдаршы! Күн күркіреген семсер
Dialogue: 0,0:11:44.45,0:11:47.28,Default,,0,0,0,,Ол қылыш аңызға айналған сиқырлы қылыш...
Dialogue: 0,0:11:47.37,0:11:49.20,Default,,0,0,0,,Райджин қылышы?
Dialogue: 0,0:11:49.83,0:11:52.96,Default,,0,0,0,,Ол соншалықты керемет, оны сол жалындаған қылышпен салыстыруға болады ...
Dialogue: 0,0:11:53.04,0:11:57.71,Default,,0,0,0,,Қолдаушының қабілетіне қарай тауларды жарып өте алатын сиқырлы қылыш!
Dialogue: 0,0:11:58.38,0:12:01.67,Default,,0,0,0,,Найзағай құдайының семсері аңыздардың ішінде аңыз болған.
Dialogue: 0,0:12:01.76,0:12:04.26,Default,,0,0,0,,Оның нағыз қылыш екеніне таң қалдым.
Dialogue: 0,0:12:04.76,0:12:06.35,Default,,0,0,0,,Мурасаме болмаса
Dialogue: 0,0:12:06.43,0:12:09.14,Default,,0,0,0,,Мен алған әрбір қылыш мені екіге жарып жібере жаздады.
Dialogue: 0,0:12:09.22,0:12:12.77,Default,,0,0,0,,Бірақ тауды шауып тастауға тұрарлық емес.
Dialogue: 0,0:12:14.23,0:12:16.73,Default,,0,0,0,,Тосын сыйлар алда!
Dialogue: 0,0:12:17.23,0:12:18.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:21.11,0:12:22.24,Default,,0,0,0,,Құнай!
Dialogue: 0,0:12:22.82,0:12:23.49,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:24.32,0:12:25.53,Default,,0,0,0,,Осы деңгейде!
Dialogue: 0,0:12:25.61,0:12:28.53,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:12:29.95,0:12:30.58,Default,,0,0,0,,Қу!
Dialogue: 0,0:12:30.66,0:12:31.70,Default,,0,0,0,,Бұл қажет болды
Dialogue: 0,0:12:32.58,0:12:33.96,Default,,0,0,0,,Не?
Dialogue: 0,0:12:35.58,0:12:36.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:36.67,0:12:38.09,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:12:38.17,0:12:39.71,Default,,0,0,0,,О, осында!
Dialogue: 0,0:12:39.80,0:12:41.13,Default,,0,0,0,,Гала-саманың өлімші қылышы!
Dialogue: 0,0:12:42.13,0:12:43.84,Default,,0,0,0,,Жын қылыш!
Dialogue: 0,0:12:48.60,0:12:50.85,Default,,0,0,0,,Иә! Ол екіде!
Dialogue: 0,0:12:50.93,0:12:53.81,Default,,0,0,0,,Грифондар мен уиверндердің қозғалыстары да ескерілген.
Dialogue: 0,0:12:53.89,0:12:55.23,Default,,0,0,0,,Гала-самадан күткендей!
Dialogue: 0,0:12:56.23,0:12:59.52,Default,,0,0,0,,Тым нәзік, бірақ жауап...
Dialogue: 0,0:13:01.19,0:13:03.11,Default,,0,0,0,,Не? Иллюзия…
Dialogue: 0,0:13:03.19,0:13:03.78,Default,,0,0,0,,Не!
Dialogue: 0,0:13:06.74,0:13:08.03,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:08.12,0:13:11.41,Default,,0,0,0,,Мен сені Hauriken Style Kenpo құпия техникасымен жерлеймін!
Dialogue: 0,0:13:11.49,0:13:12.33,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:13:12.41,0:13:14.29,Default,,0,0,0,,Ғү!
Dialogue: 0,0:13:14.79,0:13:16.46,Default,,0,0,0,,Айдаһардың соққысы Ракшасаның қиғаш соққысы!
Dialogue: 0,0:13:16.54,0:13:18.50,Default,,0,0,0,,Ғү!
Dialogue: 0,0:13:22.84,0:13:23.92,Default,,0,0,0,,Гала-сама!
Dialogue: 0,0:13:28.22,0:13:32.35,Default,,0,0,0,,Гала-сама! Гала-сама!
Dialogue: 0,0:13:37.98,0:13:39.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:39.65,0:13:41.23,Default,,0,0,0,,Көпір – қылыш...
Dialogue: 0,0:13:41.73,0:13:44.86,Default,,0,0,0,,Мен... сене алар емеспін. Бұл арман ба?
Dialogue: 0,0:13:44.94,0:13:46.45,Default,,0,0,0,,О, Гала-сама
Dialogue: 0,0:13:47.15,0:13:50.12,Default,,0,0,0,,Хэхе... Бұл керемет.
Dialogue: 0,0:13:50.20,0:13:53.04,Default,,0,0,0,,Қандай зор күш!
Dialogue: 0,0:13:53.54,0:13:57.96,Default,,0,0,0,,Найзағай құдайының қылышы бар болғанша, найзағай императоры Эшет Ней жеңілмейді!
Dialogue: 0,0:13:58.50,0:14:01.42,Default,,0,0,0,,Дирк Шнайдер де қорықпайды.
Dialogue: 0,0:14:01.50,0:14:02.88,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:14:02.96,0:14:05.30,Default,,0,0,0,,Хахахаха! Керемет!
Dialogue: 0,0:14:05.38,0:14:09.59,Default,,0,0,0,,Сіздің сиқырлы күшіңізге жауап ретінде найзағай құдайы семсерінің жойғыш күші артты ма?
Dialogue: 0,0:14:09.68,0:14:12.30,Default,,0,0,0,,Не?
Dialogue: 0,0:14:12.39,0:14:15.47,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:14:15.56,0:14:18.81,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:14:18.89,0:14:20.52,Default,,0,0,0,,О, Гала-сама!
Dialogue: 0,0:14:20.60,0:14:21.81,Default,,0,0,0,,Ол тірі!
Dialogue: 0,0:14:21.90,0:14:23.27,Default,,0,0,0,,Және...
Dialogue: 0,0:14:23.36,0:14:25.15,Default,,0,0,0,,Көптеген мерекелік кештер!
Dialogue: 0,0:14:25.23,0:14:26.74,Default,,0,0,0,,Қайсысы нақты?
Dialogue: 0,0:14:26.82,0:14:29.20,Default,,0,0,0,,Бұл не деген...
Dialogue: 0,0:14:29.28,0:14:32.16,Default,,0,0,0,,Ниндзя әдістері: Жеті дене техникасы!
Dialogue: 0,0:14:32.91,0:14:34.12,Default,,0,0,0,,Аспаз аспаз Аспаз…
Dialogue: 0,0:14:34.20,0:14:38.04,Default,,0,0,0,,Кесілгендей көрінгені менің клондарымның бірі еді.
Dialogue: 0,0:14:38.12,0:14:39.75,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:14:39.83,0:14:41.46,Default,,0,0,0,,Мәселе мынада!
Dialogue: 0,0:14:41.54,0:14:45.13,Default,,0,0,0,,Нағыз мен – осы жеті адамның ішінде.
Dialogue: 0,0:14:45.21,0:14:48.84,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:14:48.92,0:14:51.80,Default,,0,0,0,,Менің күмәнді техникам...
Dialogue: 0,0:14:53.22,0:14:56.89,Default,,0,0,0,,Сіз бір кездері Дирк Шнайдердің сүйіктісі болдыңыз.
Dialogue: 0,0:14:56.97,0:15:00.14,Default,,0,0,0,,Ақырында оған қарай еңкейетінімді білдім.
Dialogue: 0,0:15:00.23,0:15:02.98,Default,,0,0,0,,Сол мейірімсіздік... басқа адам сияқты
Dialogue: 0,0:15:05.19,0:15:07.40,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:15:07.48,0:15:09.61,Default,,0,0,0,,Олар бір-бірін шындап өлтіретін сияқты...
Dialogue: 0,0:15:11.28,0:15:12.62,Default,,0,0,0,,Бұл орындалатын сияқты!
Dialogue: 0,0:15:12.70,0:15:14.16,Default,,0,0,0,,Лорд Гагара!
Dialogue: 0,0:15:14.24,0:15:15.49,Default,,0,0,0,,Мен сауытымды лақтырып жібердім!
Dialogue: 0,0:15:16.16,0:15:17.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:17.41,0:15:20.96,Default,,0,0,0,,Менің семсерімнің алдында сауытыңыздың дәрменсіз екенін түсіндіңіз бе?
Dialogue: 0,0:15:21.50,0:15:25.42,Default,,0,0,0,,Бірақ қалай болғанда да, келесі соққы сізді тозаққа жібереді.
Dialogue: 0,0:15:25.50,0:15:26.38,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:15:26.46,0:15:29.72,Default,,0,0,0,,Аспандағы төрт патшаның ең жақсы қылышшысы, Эш Ней
Dialogue: 0,0:15:29.80,0:15:32.05,Default,,0,0,0,,Мен өз жұмбағыммен жауап беремін!
Dialogue: 0,0:15:32.13,0:15:34.30,Default,,0,0,0,,Ниндзя қылышын қабылдай аласыз ба?
Dialogue: 0,0:15:34.39,0:15:35.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:35.22,0:15:37.60,Default,,0,0,0,,Бұл қандай ұстаным?
Dialogue: 0,0:15:37.68,0:15:39.14,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:15:39.22,0:15:41.81,Default,,0,0,0,,Бұл ұстаным Гала-саманың ең үлкен құпия қылышы!
Dialogue: 0,0:15:46.40,0:15:48.53,Default,,0,0,0,,Мұрасаме!
Dialogue: 0,0:15:48.61,0:15:51.40,Default,,0,0,0,,Нағыз жын семсер!
Dialogue: 0,0:15:54.57,0:15:56.45,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:15:56.99,0:15:58.62,Default,,0,0,0,,Соникалық бум
Dialogue: 0,0:15:58.70,0:16:01.62,Default,,0,0,0,,Гала-саманың қылышының ұшы дыбыс жылдамдығынан асып түсті!
Dialogue: 0,0:16:02.41,0:16:04.79,Default,,0,0,0,,Дарк Шнайдер алған нағыз жын қылыш болды
Dialogue: 0,0:16:04.88,0:16:07.59,Default,,0,0,0,,Бұл Гала-саманың бір қолы болған кезде...
Dialogue: 0,0:16:07.67,0:16:10.05,Default,,0,0,0,,Бұл нағыз жын семсер мінсіз!
Dialogue: 0,0:16:10.13,0:16:14.01,Default,,0,0,0,,Сонымен қатар, 7 клоннан тұратын кең ауқымды шабуыл!
Dialogue: 0,0:16:14.09,0:16:17.81,Default,,0,0,0,,Бұл құпия қылышты алғаннан кейін ешкімнің аман қалуы мүмкін емес!
Dialogue: 0,0:16:17.89,0:16:19.52,Default,,0,0,0,,Бұл найзағай императорының соңы!
Dialogue: 0,0:16:21.35,0:16:23.23,Default,,0,0,0,,Жеті адамдық дененің техникасы
Dialogue: 0,0:16:23.77,0:16:26.31,Default,,0,0,0,,Үзіліссіз ультра жоғары жылдамдықты қозғалысқа байланысты.
Dialogue: 0,0:16:26.40,0:16:27.94,Default,,0,0,0,,Кейінгі кескін клонымен...
Dialogue: 0,0:16:28.02,0:16:29.73,Default,,0,0,0,,Бір нысан бар
Dialogue: 0,0:16:30.28,0:16:32.28,Default,,0,0,0,,Ниндзя шебері қанша болса да
Dialogue: 0,0:16:32.36,0:16:35.66,Default,,0,0,0,,Шынайы жынның алты қылышын бір уақытта ату мүмкін емес.
Dialogue: 0,0:16:35.74,0:16:38.91,Default,,0,0,0,,Бір ғана нағыз жын қылыш бар!
Dialogue: 0,0:16:38.99,0:16:40.12,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:16:40.70,0:16:41.95,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:16:42.04,0:16:42.83,Default,,0,0,0,,Не?
Dialogue: 0,0:16:42.91,0:16:45.58,Default,,0,0,0,,Нағыз жын семсерден бас тарт!
Dialogue: 0,0:16:45.67,0:16:48.54,Default,,0,0,0,,Енді, Гала-саманың нағыз жын семсері...
Dialogue: 0,0:16:48.63,0:16:50.13,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:16:50.21,0:16:53.26,Default,,0,0,0,,Жақын қашықтықтан тамаша дыбыстық шабуыл...
Dialogue: 0,0:16:53.34,0:16:57.47,Default,,0,0,0,,Сонымен қатар, алты клон бір уақытта шығарылған қылыштарды көре алды...
Dialogue: 0,0:16:57.55,0:16:59.35,Default,,0,0,0,,Бұл сайыс болды, Гала.
Dialogue: 0,0:16:59.43,0:17:00.51,Default,,0,0,0,,Нұсқаулық қазір!
Dialogue: 0,0:17:01.64,0:17:03.27,Default,,0,0,0,,Не?
Dialogue: 0,0:17:03.35,0:17:05.85,Default,,0,0,0,,Найзағай Құдайының семсерінде сызат бар ма?
Dialogue: 0,0:17:07.23,0:17:10.19,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:17:12.74,0:17:13.78,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:14.28,0:17:17.20,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:17:24.29,0:17:25.25,Default,,0,0,0,,О
Dialogue: 0,0:17:25.33,0:17:28.33,Default,,0,0,0,,Қараңдар! Найзағай Императорының найзағай құдайының қылышы сынды.
Dialogue: 0,0:17:29.75,0:17:32.80,Default,,0,0,0,,Найзағай құдайының семсері сынуы мүмкін...
Dialogue: 0,0:17:33.26,0:17:36.68,Default,,0,0,0,,Нағыз жын семсер... Қорқынышты сиқырлы қылыш!
Dialogue: 0,0:17:36.76,0:17:39.01,Default,,0,0,0,,О, жасай бер!
Dialogue: 0,0:17:39.89,0:17:41.76,Default,,0,0,0,,Бұл менің жеңісім, Ней.
Dialogue: 0,0:17:41.85,0:17:43.93,Default,,0,0,0,,Қылышым сынса, мен енді күресе алмаймын.
Dialogue: 0,0:17:44.02,0:17:45.77,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:17:45.85,0:17:47.52,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:17:47.60,0:17:50.69,Default,,0,0,0,,Ол Дирк Шнайдер үшін де маңызды әйел.
Dialogue: 0,0:17:50.77,0:17:52.27,Default,,0,0,0,,Мен сені өлтірмеймін
Dialogue: 0,0:17:52.36,0:17:54.57,Default,,0,0,0,,Гахахахахаха...
Dialogue: 0,0:17:54.65,0:17:55.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:55.82,0:17:58.28,Default,,0,0,0,,Гала-сама және 2000 адамдық ниндзялар әскері
Dialogue: 0,0:17:58.36,0:18:01.62,Default,,0,0,0,,Біз төрт аспан патшасының 20 000 үшінші армиясын жеңдік!
Dialogue: 0,0:18:01.70,0:18:06.04,Default,,0,0,0,,Ах~ Ней-саманың Галаға жеңілгеніне сене алар емеспін...
Dialogue: 0,0:18:06.12,0:18:08.08,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:08.17,0:18:09.08,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:18:15.71,0:18:17.72,Default,,0,0,0,,Охохо~ Иә!
Dialogue: 0,0:18:17.80,0:18:19.68,Default,,0,0,0,,Біз мұны жасадық, Шейла ханшайым!
Dialogue: 0,0:18:19.76,0:18:23.14,Default,,0,0,0,,Ниндзя шебері Гала жауға тойтарыс берді!
Dialogue: 0,0:18:23.22,0:18:25.97,Default,,0,0,0,,Аа, жақсы.
Dialogue: 0,0:18:26.06,0:18:29.52,Default,,0,0,0,,Менің Металликанам құтқарылды, Бас діни қызметкер.
Dialogue: 0,0:18:29.60,0:18:31.61,Default,,0,0,0,,Иә, әзірге
Dialogue: 0,0:18:31.69,0:18:35.53,Default,,0,0,0,,Жою Құдайын мөрлеген екінші мөр де қорғалған.
Dialogue: 0,0:18:37.40,0:18:39.61,Default,,0,0,0,,Рахмет Гала
Dialogue: 0,0:18:40.61,0:18:42.37,Default,,0,0,0,,Сонда да әлгі адам
Dialogue: 0,0:18:42.45,0:18:46.20,Default,,0,0,0,,Жел кенет біздің жаққа қалай бұрылды...
Dialogue: 0,0:18:46.29,0:18:48.46,Default,,0,0,0,,Сіз қалай ойлайсыз, Гео мырза?
Dialogue: 0,0:18:48.54,0:18:49.29,Default,,0,0,0,,Қазір...
Dialogue: 0,0:18:49.37,0:18:53.46,Default,,0,0,0,,Ей, бұлар өз қатарларын ыдырату үшін бірдеңе жасады.
Dialogue: 0,0:18:53.54,0:18:56.30,Default,,0,0,0,,Ол ақша алғысы келгендіктен аударылған болуы керек.
Dialogue: 0,0:18:56.38,0:19:00.68,Default,,0,0,0,,Таяз адамдар, уахахаха!
Dialogue: 0,0:19:00.76,0:19:01.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:02.39,0:19:05.97,Default,,0,0,0,,Бұл бір...
Dialogue: 0,0:19:07.72,0:19:09.64,Default,,0,0,0,,Гала сізге...
Dialogue: 0,0:19:09.73,0:19:12.02,Default,,0,0,0,,Осындай құдіретті қылыш ұстағанда
Dialogue: 0,0:19:12.10,0:19:15.98,Default,,0,0,0,,Корольдік адамдарға құйрығын бұлғап тұрған Дирк Шнайдер сияқты.
Dialogue: 0,0:19:16.07,0:19:19.78,Default,,0,0,0,,Біздің утопияның жүзеге асуына кедергі келтіруге тырысу...
Dialogue: 0,0:19:21.49,0:19:22.78,Default,,0,0,0,,Өкінішті жігіт!
Dialogue: 0,0:19:22.87,0:19:25.66,Default,,0,0,0,,Хмф... Эшет Ней!
Dialogue: 0,0:19:25.74,0:19:29.37,Default,,0,0,0,,Мен үшін Каль мен оның достары жасаған утопия...
Dialogue: 0,0:19:29.45,0:19:31.08,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:19:31.17,0:19:31.83,Default,,0,0,0,,На
Dialogue: 0,0:19:31.92,0:19:35.96,Default,,0,0,0,,Қызық болғанша, маған бәрібір!
Dialogue: 0,0:19:36.04,0:19:38.34,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:19:39.01,0:19:41.26,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:19:41.34,0:19:42.76,Default,,0,0,0,,Байлау!
Dialogue: 0,0:19:43.64,0:19:46.26,Default,,0,0,0,,Не? Ней, әлі де ұрысқың келе ме?
Dialogue: 0,0:19:46.35,0:19:47.01,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:19:47.10,0:19:49.22,Default,,0,0,0,,О! А, бұл не?
Dialogue: 0,0:19:49.81,0:19:51.19,Default,,0,0,0,,Сиқырлы ракета?
Dialogue: 0,0:19:51.27,0:19:52.60,Default,,0,0,0,,Әнұран!
Dialogue: 0,0:19:54.35,0:19:55.98,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:19:56.06,0:19:59.23,Default,,0,0,0,,Мен сені мұндай нәрсемен жеңе алмаймын!
Dialogue: 0,0:20:01.95,0:20:03.66,Default,,0,0,0,,Кеттік, Гала!
Dialogue: 0,0:20:03.74,0:20:07.12,Default,,0,0,0,,Тоқта! Сынған қылышпен не істейсің?
Dialogue: 0,0:20:07.20,0:20:08.33,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:20:08.41,0:20:11.54,Default,,0,0,0,,Ааа!
Dialogue: 0,0:20:11.62,0:20:13.62,Default,,0,0,0,,О! Бұл не?
Dialogue: 0,0:20:13.71,0:20:15.33,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:20:15.42,0:20:19.13,Default,,0,0,0,,Найзағай құдайының қылышы дегеніміз не? Бұл болат жүзбен кесетін қылыш емес!
Dialogue: 0,0:20:20.01,0:20:23.05,Default,,0,0,0,,Тауларды жарып өте алатын сыры осы!
Dialogue: 0,0:20:23.13,0:20:23.93,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:20:26.05,0:20:27.14,Default,,0,0,0,,Құпия техника!
Dialogue: 0,0:20:27.22,0:20:31.18,Default,,0,0,0,,Жоғарғы Патша қылышының найзағай соғуы таңқаларлық тырнақ соққысы!
Dialogue: 0,0:20:31.27,0:20:32.81,Default,,0,0,0,,Ахх!
Dialogue: 0,0:20:36.36,0:20:37.44,Default,,0,0,0,,Не?
Dialogue: 0,0:20:42.65,0:20:44.40,Default,,0,0,0,,Гала ханым!
Dialogue: 0,0:20:44.49,0:20:46.11,Default,,0,0,0,,О!
Dialogue: 0,0:20:46.78,0:20:48.03,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:20:48.12,0:20:51.54,Default,,0,0,0,,Найзағай семсері Мурасамеден өтеді...
Dialogue: 0,0:20:52.29,0:20:53.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:54.83,0:20:56.29,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:20:56.38,0:21:01.80,Default,,0,0,0,,Найзағай тауларды жарып өте алатын найзағай семсерінің жүзі.
Dialogue: 0,0:21:03.51,0:21:07.39,Default,,0,0,0,,Мұны кәдімгі қылышпен ұру мүмкін емес.
Dialogue: 0,0:21:08.43,0:21:11.35,Default,,0,0,0,,Күте тұрыңыз, мен сізге қазір жеңілдетемін.
Dialogue: 0,0:21:11.93,0:21:15.56,Default,,0,0,0,,Мына жігіт қызықсыз болып шықты.
Dialogue: 0,0:21:15.64,0:21:17.31,Default,,0,0,0,,Гала-сама~!
Dialogue: 0,0:21:17.40,0:21:18.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:20.11,0:21:22.99,Default,,0,0,0,,Келесі кезекте сіз үшін сол жігіт.
Dialogue: 0,0:21:24.11,0:21:26.70,Default,,0,0,0,,Сіз алмайсыз ба?
Dialogue: 0,0:21:26.78,0:21:28.12,Default,,0,0,0,,Мұны жасауға болады!
Dialogue: 0,0:21:28.20,0:21:30.62,Default,,0,0,0,,идеалды қоғамды жүзеге асыру үшін...
Dialogue: 0,0:21:31.12,0:21:33.04,Default,,0,0,0,,Сиқырлы патшалық үшін!
Dialogue: 0,0:21:36.46,0:21:39.21,Default,,0,0,0,,Маған көмектесіңізші... өтінемін!
Dialogue: 0,0:21:39.29,0:21:41.42,Default,,0,0,0,,Гала өл!
Dialogue: 0,0:21:42.00,0:21:43.51,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:21:45.51,0:21:46.51,Default,,0,0,0,,Хмм... жоқ...
Dialogue: 0,0:21:50.18,0:21:51.05,Default,,0,0,0,,Гува!
Dialogue: 0,0:21:52.51,0:21:54.35,Default,,0,0,0,,Қарғыс атсын! Не?
Dialogue: 0,0:21:54.43,0:21:56.81,Default,,0,0,0,,А, бұл қауіпті~
Dialogue: 0,0:21:56.89,0:21:58.81,Default,,0,0,0,,Қуырылып кете жаздадым.
Dialogue: 0,0:21:58.90,0:22:00.73,Default,,0,0,0,,Ха! Ұлы діни қызметкер!
Dialogue: 0,0:22:00.81,0:22:04.48,Default,,0,0,0,,А, бар! Қарсы жағадағы тас мүсінде...
Dialogue: 0,0:22:04.57,0:22:06.95,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:22:07.03,0:22:08.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:08.24,0:22:09.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:09.36,0:22:10.99,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:22:18.00,0:22:19.33,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:22:23.17,0:22:24.50,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.54,0:23:46.55,Default,,0,0,0,,～♪
