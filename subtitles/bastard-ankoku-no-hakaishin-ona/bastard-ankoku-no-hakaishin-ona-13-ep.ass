Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:16.85,0:00:17.89,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:00:17.97,0:00:20.64,Default,,0,0,0,,Өлме, Рокуденаши!
Dialogue: 0,0:00:22.93,0:00:24.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:27.98,0:00:30.19,Default,,0,0,0,,Доггон!
Dialogue: 0,0:00:30.78,0:00:35.53,Default,,0,0,0,,Ең әдемі бас кейіпкер Дирк Шнайдер!
Dialogue: 0,0:00:35.61,0:00:39.16,Default,,0,0,0,,Болат Өлмейтін Ұлы жанартау Үлкен атқылауды дауыл деп атайды
Dialogue: 0,0:00:39.24,0:00:42.50,Default,,0,0,0,,Енді жанданды!
Dialogue: 0,0:00:43.00,0:00:44.33,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:00:44.41,0:00:45.46,Default,,0,0,0,,Агия Агия!
Dialogue: 0,0:00:45.96,0:00:47.21,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:00:47.29,0:00:49.42,Default,,0,0,0,,О! Мен сене алар емеспін
Dialogue: 0,0:00:49.50,0:00:52.63,Default,,0,0,0,,Мен оның сиқырлы шабуылдан кейін тұрғанына сене алмадым!
Dialogue: 0,0:00:52.71,0:00:54.51,Default,,0,0,0,,Темера!
Dialogue: 0,0:00:54.59,0:00:57.84,Default,,0,0,0,,Мынау болмашы нәрсеге шу көтерме!
Dialogue: 0,0:00:57.93,0:01:00.64,Default,,0,0,0,,Олар мүлде ұсқынсыз адамдар.
Dialogue: 0,0:01:01.14,0:01:01.89,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:01:01.97,0:01:05.35,Default,,0,0,0,,Бейшара және қауқарсыз бұқара
Dialogue: 0,0:01:05.44,0:01:06.98,Default,,0,0,0,,Құдай таңдаған -
Dialogue: 0,0:01:07.06,0:01:10.65,Default,,0,0,0,,Керемет сұлулығы бар бұл батыр!
Dialogue: 0,0:01:10.73,0:01:14.07,Default,,0,0,0,,Адам Таразы Дирк Шнайдерден өзгеше!
Dialogue: 0,0:01:14.15,0:01:14.94,Default,,0,0,0,,Таразы!
Dialogue: 0,0:01:15.03,0:01:17.49,Default,,0,0,0,,Вахахаха~!
Dialogue: 0,0:01:17.57,0:01:18.91,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:01:19.57,0:01:20.83,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:01:21.95,0:01:26.50,Default,,0,0,0,,Әлгі ақымақ күшті болуы мүмкін, бірақ ол көп зиян келтіреді.
Dialogue: 0,0:01:27.08,0:01:30.09,Default,,0,0,0,,Өйткені Экс-Зодус ақылсыз.
Dialogue: 0,0:01:30.84,0:01:32.09,Default,,0,0,0,,Иә
Dialogue: 0,0:01:32.17,0:01:35.22,Default,,0,0,0,,Керемет өлместік, Дирк Шнайдер
Dialogue: 0,0:01:35.30,0:01:37.22,Default,,0,0,0,,Бару~
Dialogue: 0,0:01:37.30,0:01:39.30,Default,,0,0,0,,Бірақ қазір бітті
Dialogue: 0,0:01:39.39,0:01:42.93,Default,,0,0,0,,Олай болсаң, күресуге күшің қалмайды.
Dialogue: 0,0:01:43.01,0:01:44.60,Default,,0,0,0,,Мен сені қазір өлтіремін.
Dialogue: 0,0:01:44.68,0:01:48.69,Default,,0,0,0,,Біз мақсат етіп отырған түпкі идеалды қоғамды жүзеге асыру үшін!
Dialogue: 0,0:01:48.77,0:01:50.23,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:01:50.31,0:01:51.98,Default,,0,0,0,,Сіз мені өлтіре алмайсыз
Dialogue: 0,0:01:52.07,0:01:54.36,Default,,0,0,0,,Не?
Dialogue: 0,0:01:54.44,0:01:58.78,Default,,0,0,0,,Мен сені өлтіре алмасам, саған дәлелдеймін!
Dialogue: 0,0:01:59.28,0:02:00.03,Default,,0,0,0,,Күл!
Dialogue: 0,0:02:00.12,0:02:00.99,Default,,0,0,0,,Не!
Dialogue: 0,0:02:06.00,0:02:07.21,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:02:08.50,0:02:10.21,Default,,0,0,0,,♪～
Dialogue: 0,0:03:35.92,0:03:37.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:46.80,0:03:48.10,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:03:48.97,0:03:49.72,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:03:50.89,0:03:51.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:52.39,0:03:54.40,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:54.48,0:03:57.07,Default,,0,0,0,,Әйелді көрген адамда болатын махаббат
Dialogue: 0,0:03:57.15,0:03:58.78,Default,,0,0,0,,Мен мұны қаламаймын!
Dialogue: 0,0:03:58.86,0:03:59.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:59.78,0:04:01.53,Default,,0,0,0,,Екінші қызу!
Dialogue: 0,0:04:02.24,0:04:03.61,Default,,0,0,0,,Мен бұйырамын
Dialogue: 0,0:04:03.70,0:04:06.70,Default,,0,0,0,,Қараңғы аспаннан кел, найзағайдың рухы!
Dialogue: 0,0:04:06.78,0:04:08.03,Default,,0,0,0,,Гильбалд!
Dialogue: 0,0:04:14.79,0:04:15.63,Default,,0,0,0,,О!
Dialogue: 0,0:04:15.71,0:04:16.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:16.88,0:04:18.09,Default,,0,0,0,,Рухты шақыру!
Dialogue: 0,0:04:18.67,0:04:19.63,Default,,0,0,0,,Нейдің жігіті
Dialogue: 0,0:04:19.71,0:04:22.22,Default,,0,0,0,,Жел рухтар әлемінен найзағай рухы шақырылды.
Dialogue: 0,0:04:22.30,0:04:23.09,Default,,0,0,0,,Агия!
Dialogue: 0,0:04:23.17,0:04:25.34,Default,,0,0,0,,Дегенмен, рухтарды шақыру – екі жүзді қылыш.
Dialogue: 0,0:04:25.97,0:04:28.64,Default,,0,0,0,,Бір рет зейінді жоғалтып, бақылауды жоғалтасыз
Dialogue: 0,0:04:28.72,0:04:31.81,Default,,0,0,0,,Рух оны шақырған құюшыға шабуыл жасайды.
Dialogue: 0,0:04:31.89,0:04:35.52,Default,,0,0,0,,Цк, найзағай рухы дегеніміз не? Ол сирек кездесетін нәрселерді шақырады.
Dialogue: 0,0:04:35.60,0:04:36.77,Default,,0,0,0,,Вацу Куо!
Dialogue: 0,0:04:36.85,0:04:38.19,Default,,0,0,0,,Рэй Вен!
Dialogue: 0,0:04:38.27,0:04:39.36,Default,,0,0,0,,О!
Dialogue: 0,0:04:39.44,0:04:41.36,Default,,0,0,0,,Бұл ұтқырлығы жоғары ұшу сиқыры!
Dialogue: 0,0:04:41.86,0:04:43.24,Default,,0,0,0,,Әй, Тааб Күн!
Dialogue: 0,0:04:43.32,0:04:46.99,Default,,0,0,0,,Өлмейтін жану, менің нұсқауымды орында!
Dialogue: 0,0:04:47.07,0:04:48.53,Default,,0,0,0,,Да Фора!
Dialogue: 0,0:04:48.62,0:04:50.99,Default,,0,0,0,,О! Дирк Шнайдер де
Dialogue: 0,0:04:51.08,0:04:52.79,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:04:52.87,0:04:56.33,Default,,0,0,0,,Мен көремін. Найзағай рухтарымен бәсекелесе алатын рухтарға келетін болсақ.
Dialogue: 0,0:04:56.42,0:04:58.08,Default,,0,0,0,,Бұл жалғыз нұсқа...
Dialogue: 0,0:04:58.17,0:05:02.09,Default,,0,0,0,,Солай болса да, әдетте бір ғана рухты шақыруға болады.
Dialogue: 0,0:05:02.17,0:05:04.22,Default,,0,0,0,,Мұндай бақылауға ие болу үшін...
Dialogue: 0,0:05:04.92,0:05:07.80,Default,,0,0,0,,Екеуіңіз де қарапайым рульдер емессіздер!
Dialogue: 0,0:05:08.34,0:05:11.47,Default,,0,0,0,,Жүр! Найзағай рухтары
Dialogue: 0,0:05:19.36,0:05:21.07,Default,,0,0,0,,Тоқта, Эше!
Dialogue: 0,0:05:21.15,0:05:23.15,Default,,0,0,0,,Жалқау болмаңыз!
Dialogue: 0,0:05:23.23,0:05:24.53,Default,,0,0,0,,Шулы!
Dialogue: 0,0:05:24.61,0:05:26.82,Default,,0,0,0,,Мені таныс лақап атпен атама!
Dialogue: 0,0:05:26.90,0:05:27.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:27.91,0:05:29.53,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:05:30.20,0:05:31.45,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:05:31.53,0:05:33.95,Default,,0,0,0,,Бұл идеалды қоғам дегеніміз не?
Dialogue: 0,0:05:34.04,0:05:35.37,Default,,0,0,0,,Катари!
Dialogue: 0,0:05:35.46,0:05:37.58,Default,,0,0,0,,Мынау түзу Каль түсінеді.
Dialogue: 0,0:05:37.67,0:05:41.29,Default,,0,0,0,,Дүниені бағындыру үшін неге мұндай атақ қажет?
Dialogue: 0,0:05:41.38,0:05:42.46,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:05:42.55,0:05:45.17,Default,,0,0,0,,Сізбен тек лас гарем құру үшін.
Dialogue: 0,0:05:45.26,0:05:46.05,Default,,0,0,0,,Мұны бірге жасамаңыз!
Dialogue: 0,0:05:46.13,0:05:47.63,Default,,0,0,0,,Уф... ақымақ!
Dialogue: 0,0:05:47.72,0:05:50.47,Default,,0,0,0,,Сиқыр басқаратын түпкілікті идеалды қоғам
Dialogue: 0,0:05:50.55,0:05:51.72,Default,,0,0,0,,Сиқырлы Патшалық!
Dialogue: 0,0:05:51.80,0:05:54.72,Default,,0,0,0,,Кемсітусіз, жоқшылықсыз және соғыссыз әлем!
Dialogue: 0,0:05:54.81,0:05:58.81,Default,,0,0,0,,Сол ұлтты құру арманы өміріңді қатерге тігуге тұрарлық!
Dialogue: 0,0:05:58.90,0:06:00.48,Default,,0,0,0,,Өтірік айтпа!
Dialogue: 0,0:06:00.56,0:06:04.57,Default,,0,0,0,,Ұрыс пен өшпенділік - адам табиғатының ішінде жасырылған аспектілері.
Dialogue: 0,0:06:04.65,0:06:06.65,Default,,0,0,0,,Мәңгілік бейбітшілік дегеніміз не?
Dialogue: 0,0:06:06.74,0:06:09.61,Default,,0,0,0,,Бұл жер бетінде жаратылуы мүмкін бе?
Dialogue: 0,0:06:09.70,0:06:14.87,Default,,0,0,0,,Мен сен сияқты бейбақ менің сезімімді білгенін қаламаймын!
Dialogue: 0,0:06:15.91,0:06:19.04,Default,,0,0,0,,Мен сияқты жартылай пері соғыстан туған
Dialogue: 0,0:06:19.12,0:06:21.88,Default,,0,0,0,,Адамдар да, эльфтер де дос ретінде танымайды.
Dialogue: 0,0:06:22.38,0:06:24.80,Default,,0,0,0,,Сіз қанша ойды бастан өткердіңіз?
Dialogue: 0,0:06:24.88,0:06:26.55,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:06:26.63,0:06:27.84,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:27.92,0:06:32.39,Default,,0,0,0,,Айыптау, менсінбеу, ашық жек көру, кемсіту...
Dialogue: 0,0:06:32.47,0:06:37.39,Default,,0,0,0,,Бала кезімнен менің денемде тыртық қалмаған.
Dialogue: 0,0:06:38.18,0:06:39.60,Default,,0,0,0,,Және сол күні-
Dialogue: 0,0:06:39.69,0:06:42.73,Default,,0,0,0,,Орман эльфтерімен тайпааралық соғыс басталған күні...
Dialogue: 0,0:06:43.23,0:06:45.48,Default,,0,0,0,,Жартылай пері екеніңді білсең де
Dialogue: 0,0:06:45.57,0:06:48.95,Default,,0,0,0,,Сонда да мені қамтамасыз еткен қара пері тайпасынан.
Dialogue: 0,0:06:49.03,0:06:50.82,Default,,0,0,0,,Мені тастап кетті
Dialogue: 0,0:06:51.74,0:06:56.04,Default,,0,0,0,,Мен не болып жатқанын білмей, көп күн өртенген алқаптарды араладым.
Dialogue: 0,0:06:56.58,0:07:01.25,Default,,0,0,0,,Бірақ менің тайпам майдан даласын әлдеқашан тастап кеткен.
Dialogue: 0,0:07:03.33,0:07:03.96,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.63,0:07:06.84,Default,,0,0,0,,Бұл Досамағидың қиыншылықтарынан құтылу еді.
Dialogue: 0,0:07:08.01,0:07:09.34,Default,,0,0,0,,Күл!
Dialogue: 0,0:07:09.42,0:07:13.34,Default,,0,0,0,,Сол күнгі аштық пен тоңу туралы естеліктер маған үйретті!
Dialogue: 0,0:07:13.43,0:07:16.39,Default,,0,0,0,,Жартылай эльфтерге қауіпсіз баспана қажет!
Dialogue: 0,0:07:21.10,0:07:25.19,Default,,0,0,0,,Менің идеалдарға бәс тігуімнің барлық себебі осы!
Dialogue: 0,0:07:25.27,0:07:25.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:26.36,0:07:29.78,Default,,0,0,0,,Дарш, сен өлдің!
Dialogue: 0,0:07:29.86,0:07:31.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:33.03,0:07:33.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:34.45,0:07:37.37,Default,,0,0,0,,Эше ұмыттың ба?
Dialogue: 0,0:07:38.79,0:07:39.95,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:07:40.04,0:07:44.04,Default,,0,0,0,,Ол кездейсоқ өтіп бара жатып, халатымның етегінен ұстап алды...
Dialogue: 0,0:07:45.75,0:07:47.92,Default,,0,0,0,,Келесі 100 жыл-
Dialogue: 0,0:07:48.96,0:07:51.80,Default,,0,0,0,,Сіздің қауіпсіз баспанаңыз мен болдым, солай ма?
Dialogue: 0,0:07:54.97,0:07:57.18,Default,,0,0,0,,Эшетті еске түсіріңіз
Dialogue: 0,0:07:57.81,0:08:00.93,Default,,0,0,0,,Ата-ана мен бала болып өмір сүрген күндер туралы...
Dialogue: 0,0:08:02.69,0:08:03.77,Default,,0,0,0,,Дарш…
Dialogue: 0,0:08:04.73,0:08:09.86,Default,,0,0,0,,Соңғы 15 жылда мен бір күнді де ұмытқан емеспін.
Dialogue: 0,0:08:11.03,0:08:15.28,Default,,0,0,0,,Өйткені сол 100 жыл мен үшін жалғыз уақыт...
Dialogue: 0,0:08:16.45,0:08:18.78,Default,,0,0,0,,Өйткені бұл жұмақ туралы естелік
Dialogue: 0,0:08:21.12,0:08:23.37,Default,,0,0,0,,Сіз жай ғана мас болсаңыз да...
Dialogue: 0,0:08:27.92,0:08:29.88,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:08:31.46,0:08:32.42,Default,,0,0,0,,Дарш…
Dialogue: 0,0:08:32.51,0:08:33.63,Default,,0,0,0,,Эше…
Dialogue: 0,0:08:34.38,0:08:35.13,Default,,0,0,0,,Ах
Dialogue: 0,0:08:35.22,0:08:37.85,Default,,0,0,0,,Дарш Дарш…
Dialogue: 0,0:08:38.35,0:08:42.48,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:08:43.27,0:08:44.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:45.27,0:08:46.81,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:08:46.90,0:08:48.73,Default,,0,0,0,,Арх... аа!
Dialogue: 0,0:08:51.11,0:08:52.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:53.24,0:08:54.11,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:08:54.20,0:08:54.82,Default,,0,0,0,,Эше…
Dialogue: 0,0:08:55.32,0:08:57.24,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:08:57.32,0:08:58.99,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:08:59.08,0:09:01.74,Default,,0,0,0,,Жоқ! Ахх!
Dialogue: 0,0:09:03.50,0:09:04.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:04.21,0:09:05.29,Default,,0,0,0,,О!
Dialogue: 0,0:09:06.75,0:09:09.25,Default,,0,0,0,,Ух... Эше...
Dialogue: 0,0:09:09.34,0:09:11.84,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:09:11.92,0:09:14.34,Default,,0,0,0,,Мен ойлағандай болды!
Dialogue: 0,0:09:14.42,0:09:15.97,Default,,0,0,0,,Қараңызшы, Кал.
Dialogue: 0,0:09:16.05,0:09:19.64,Default,,0,0,0,,Күл Нейдің тырнақ түсі күлгін түске өзгерді.
Dialogue: 0,0:09:20.43,0:09:21.85,Default,,0,0,0,,Жартылай эльф
Dialogue: 0,0:09:21.93,0:09:25.98,Default,,0,0,0,,Оны Дирк Шнайдерге тамсанатын жүрек жаулап алған сияқты.
Dialogue: 0,0:09:27.06,0:09:31.32,Default,,0,0,0,,Ал, енді ең маңыздысы!
Dialogue: 0,0:09:31.40,0:09:34.90,Default,,0,0,0,,Нейдің жүрегі Дирк Шнайдерге көбірек ашылады
Dialogue: 0,0:09:34.99,0:09:37.20,Default,,0,0,0,,Айыпталушы салған шегелер
Dialogue: 0,0:09:37.28,0:09:38.99,Default,,0,0,0,,Оны қатайтыңыз
Dialogue: 0,0:09:39.07,0:09:43.24,Default,,0,0,0,,Сол тырнақтар жұмбақ қызыл түске боялған кезде
Dialogue: 0,0:09:43.33,0:09:47.83,Default,,0,0,0,,Яғни, Ней біздің Төрт Көктегі Патшаға толығымен опасыздық жасағанда.
Dialogue: 0,0:09:48.46,0:09:51.46,Default,,0,0,0,,Күл Нейдің денесі жарылып кетті!
Dialogue: 0,0:09:52.13,0:09:53.30,Default,,0,0,0,,Және-
Dialogue: 0,0:09:53.38,0:09:57.97,Default,,0,0,0,,Мұңды, ұсқынсыз бақа ғана қалды.
Dialogue: 0,0:10:00.01,0:10:01.80,Default,,0,0,0,,Мен оны көре алмайтындықтан ба?
Dialogue: 0,0:10:01.89,0:10:03.35,Default,,0,0,0,,Қараудың қажеті жоқ
Dialogue: 0,0:10:04.02,0:10:05.52,Default,,0,0,0,,Ней өлсе
Dialogue: 0,0:10:05.60,0:10:09.31,Default,,0,0,0,,Дарк Шнайдерді менімен де, сенімен де жең.
Dialogue: 0,0:10:09.40,0:10:10.81,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:10:12.48,0:10:14.98,Default,,0,0,0,,Бірінші армияның қолбасшылығына қайта ораламын.
Dialogue: 0,0:10:17.70,0:10:18.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:20.62,0:10:24.62,Default,,0,0,0,,Қатты ауыратын сияқты Кукуку!
Dialogue: 0,0:10:24.70,0:10:29.37,Default,,0,0,0,,Күл Ней, ол азаптан құтылудың бір ғана жолы бар.
Dialogue: 0,0:10:29.46,0:10:31.71,Default,,0,0,0,,Дирк Шнайдерді өлтіріңіз
Dialogue: 0,0:10:31.79,0:10:34.25,Default,,0,0,0,,Оның жүрегін ойып алыңыз!
Dialogue: 0,0:10:34.34,0:10:36.17,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз
Dialogue: 0,0:10:36.26,0:10:39.43,Default,,0,0,0,,Айыпталушының қарғысы бұзылмайды.
Dialogue: 0,0:10:39.51,0:10:41.05,Default,,0,0,0,,Жартылай эльф!
Dialogue: 0,0:10:41.14,0:10:42.68,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:42.76,0:10:46.47,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:10:46.56,0:10:47.93,Default,,0,0,0,,Не болды, Эше?
Dialogue: 0,0:10:48.02,0:10:49.44,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:10:50.06,0:10:51.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:52.27,0:10:55.23,Default,,0,0,0,,Мен сенің қолыңа түсіп кете жаздадым!
Dialogue: 0,0:10:55.78,0:10:56.78,Default,,0,0,0,,Не!
Dialogue: 0,0:10:56.86,0:10:59.61,Default,,0,0,0,,Мен жүздеген әйелдерді осылай әкелдім.
Dialogue: 0,0:10:59.70,0:11:02.87,Default,,0,0,0,,Оны өз амбициясының құралы ретінде пайдаланған болуы керек!
Dialogue: 0,0:11:03.62,0:11:04.45,Default,,0,0,0,,Құт
Dialogue: 0,0:11:08.87,0:11:10.83,Default,,0,0,0,,Саламандрлардың қимылдары ретсіз.
Dialogue: 0,0:11:11.54,0:11:14.92,Default,,0,0,0,,Дарк Шнайдердің психикалық шоғырлануы әлсірей ме?
Dialogue: 0,0:11:15.00,0:11:16.21,Default,,0,0,0,,Иә! Ку!
Dialogue: 0,0:11:16.30,0:11:17.76,Default,,0,0,0,,Шек!
Dialogue: 0,0:11:17.84,0:11:20.17,Default,,0,0,0,,Егер ол одан да көп зиян келтірсе...
Dialogue: 0,0:11:20.26,0:11:23.01,Default,,0,0,0,,Енді мәңгі ұйықта!
Dialogue: 0,0:11:23.09,0:11:25.47,Default,,0,0,0,,Гару түрмесі Райха!
Dialogue: 0,0:11:26.81,0:11:28.14,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:11:28.22,0:11:29.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:29.56,0:11:32.14,Default,,0,0,0,,Мен өлемін, шын!
Dialogue: 0,0:11:33.48,0:11:34.44,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:35.23,0:11:37.48,Default,,0,0,0,,Люс!
Dialogue: 0,0:11:43.82,0:11:47.37,Default,,0,0,0,,Сен енді менің қызым емессің!
Dialogue: 0,0:11:54.50,0:11:58.92,Default,,0,0,0,,Мен мұны ұрыс-керіс болған сайын айтатынмын.
Dialogue: 0,0:12:00.13,0:12:02.26,Default,,0,0,0,,Кешіріңіз Дарш
Dialogue: 0,0:12:02.34,0:12:05.55,Default,,0,0,0,,Мені жаман болдым деп жек көрме.
Dialogue: 0,0:12:06.10,0:12:08.76,Default,,0,0,0,,Жарайды, жарайды, енді жылама.
Dialogue: 0,0:12:08.85,0:12:10.06,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:12:10.56,0:12:11.85,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:11.93,0:12:13.02,Default,,0,0,0,,О
Dialogue: 0,0:12:15.73,0:12:20.40,Default,,0,0,0,,«Сен менің қызым емессің» және «Мен сені сүйемін» деген сөз тіркестері өлтірілді.
Dialogue: 0,0:12:21.11,0:12:24.86,Default,,0,0,0,,Әр жекпе-жек әрқашан шешілді.
Dialogue: 0,0:12:25.82,0:12:26.82,Default,,0,0,0,,Уф
Dialogue: 0,0:12:27.83,0:12:28.91,Default,,0,0,0,,Дарш…
Dialogue: 0,0:12:28.99,0:12:33.75,Default,,0,0,0,,Сіз маскүнем өсірген сирек жарты пері қызысыз.
Dialogue: 0,0:12:34.87,0:12:37.63,Default,,0,0,0,,Бірақ... бірақ мен үшін
Dialogue: 0,0:12:37.71,0:12:41.26,Default,,0,0,0,,Сіз қаншалықты маңызды болғаныңызды білесіз бе?
Dialogue: 0,0:12:42.55,0:12:45.80,Default,,0,0,0,,Бір кездері осы Эшет Неймен байланысын үзгендерге.
Dialogue: 0,0:12:45.89,0:12:47.72,Default,,0,0,0,,Берілуге ​​болмайды!
Dialogue: 0,0:12:47.80,0:12:50.51,Default,,0,0,0,,Мен барлық жеңілгендерді өлтіремін.
Dialogue: 0,0:12:50.60,0:12:52.56,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:12:52.64,0:12:56.90,Default,,0,0,0,,Бұл тек әкелер мен ғашықтар туралы емес.
Dialogue: 0,0:12:57.94,0:13:01.03,Default,,0,0,0,,Мен ұстай алатын жалғыз нәрсе сен едің.
Dialogue: 0,0:13:02.53,0:13:05.95,Default,,0,0,0,,Сіз мен жақсы көретін барлық нәрсе болдыңыз!
Dialogue: 0,0:13:07.16,0:13:08.32,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:13:08.41,0:13:09.78,Default,,0,0,0,,Енді тұруға болмайды
Dialogue: 0,0:13:12.95,0:13:14.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:15.54,0:13:16.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:17.92,0:13:20.67,Default,,0,0,0,,Сен неге тұрсың!
Dialogue: 0,0:13:21.80,0:13:24.26,Default,,0,0,0,,Неге, Дарш!
Dialogue: 0,0:13:30.97,0:13:32.01,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:13:32.10,0:13:35.94,Default,,0,0,0,,Мен қазірден бері ол адамнан ешқандай зұлым рухтарды сезген жоқпын.
Dialogue: 0,0:13:36.64,0:13:39.56,Default,,0,0,0,,Бұл... Мынау...
Dialogue: 0,0:13:40.98,0:13:42.61,Default,,0,0,0,,Бұл жылап тұрған бала.
Dialogue: 0,0:13:42.69,0:13:44.11,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:47.40,0:13:49.03,Default,,0,0,0,,Не?
Dialogue: 0,0:13:49.11,0:13:51.41,Default,,0,0,0,,Не? Сіз бақылаудан шығып жатырсыз ба?
Dialogue: 0,0:13:51.49,0:13:54.91,Default,,0,0,0,,Нейдің найзағай рухтары бақылауды жоғалтты!
Dialogue: 0,0:13:57.62,0:13:58.54,Default,,0,0,0,,Ха! (Ларс) Агия!
Dialogue: 0,0:14:00.13,0:14:01.04,Default,,0,0,0,,Кішкентай қыз!
Dialogue: 0,0:14:01.13,0:14:02.63,Default,,0,0,0,,Йо Йоко!
Dialogue: 0,0:14:03.13,0:14:03.88,Default,,0,0,0,,Е...
Dialogue: 0,0:14:06.76,0:14:10.14,Default,,0,0,0,,Йоко!
Dialogue: 0,0:14:15.02,0:14:16.85,Default,,0,0,0,,Йо… Йоко-сан
Dialogue: 0,0:14:18.23,0:14:19.56,Default,,0,0,0,,Йоко…
Dialogue: 0,0:14:23.65,0:14:24.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:24.86,0:14:26.57,Default,,0,0,0,,О, жақсы!
Dialogue: 0,0:14:26.65,0:14:28.11,Default,,0,0,0,,Жақсысың ба, қызым?
Dialogue: 0,0:14:28.20,0:14:31.07,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:14:31.16,0:14:33.49,Default,,0,0,0,,Мен қалжыңдап тұрған жоқпын.
Dialogue: 0,0:14:33.58,0:14:35.45,Default,,0,0,0,,Гүл болса, бәрібір бүршік!
Dialogue: 0,0:14:35.54,0:14:37.08,Default,,0,0,0,,Агия агья!
Dialogue: 0,0:14:37.16,0:14:38.04,Default,,0,0,0,,Агия агья!
Dialogue: 0,0:14:38.12,0:14:39.42,Default,,0,0,0,,Құрметті Шейла!
Dialogue: 0,0:14:39.50,0:14:41.04,Default,,0,0,0,,Құрметті Шейла!
Dialogue: 0,0:14:41.13,0:14:42.25,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:14:43.04,0:14:44.38,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:44.46,0:14:46.51,Default,,0,0,0,,Мен жай ғана ес-түссіз жатырмын.
Dialogue: 0,0:14:47.34,0:14:48.51,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:14:48.59,0:14:49.80,Default,,0,0,0,,Найзағай рухтары
Dialogue: 0,0:14:49.88,0:14:52.14,Default,,0,0,0,,Біз Дарк Шнайдер мен Нейге шабуыл жасаймыз!
Dialogue: 0,0:14:57.89,0:14:58.93,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:00.81,0:15:02.40,Default,,0,0,0,,Жоқ, алмаймын.
Dialogue: 0,0:15:06.11,0:15:07.69,Default,,0,0,0,,Маған...
Dialogue: 0,0:15:12.45,0:15:15.08,Default,,0,0,0,,Перде Дирк Шнайдер
Dialogue: 0,0:15:15.66,0:15:17.95,Default,,0,0,0,,Келесі заклинание оны аяқтайды.
Dialogue: 0,0:15:18.04,0:15:22.71,Default,,0,0,0,,Сол денеңмен тағы бір соққы бере аласың ба деп ойлаймын.
Dialogue: 0,0:15:23.21,0:15:25.92,Default,,0,0,0,,Бар күшіңізді жұмсаңыз
Dialogue: 0,0:15:26.00,0:15:30.05,Default,,0,0,0,,Мені жеңе алмасаң, әйелің осы жолы өледі!
Dialogue: 0,0:15:30.13,0:15:30.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:31.93,0:15:33.05,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:15:33.55,0:15:35.43,Default,,0,0,0,,Найзағай рухы жас ханымға шабуыл жасағанда,
Dialogue: 0,0:15:35.51,0:15:38.22,Default,,0,0,0,,Ол Нейдің бақылауынан шығып кетуі керек еді.
Dialogue: 0,0:15:38.72,0:15:40.94,Default,,0,0,0,,Нейдің жігіті...
Dialogue: 0,0:15:42.19,0:15:43.81,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:15:43.90,0:15:46.48,Default,,0,0,0,,Бұл адамда бірдеңе дұрыс емес.
Dialogue: 0,0:15:46.57,0:15:48.53,Default,,0,0,0,,Менің басқа амалым жоқ
Dialogue: 0,0:15:48.61,0:15:51.65,Default,,0,0,0,,Менің ойымша, ол Люсты өлтірмекші емес.
Dialogue: 0,0:15:53.20,0:15:55.41,Default,,0,0,0,,Күл болсаң да
Dialogue: 0,0:15:56.12,0:15:58.91,Default,,0,0,0,,Мен ол әйелге тиіскен адамды кешірмеймін!
Dialogue: 0,0:15:58.99,0:16:02.58,Default,,0,0,0,,Жарысайық!
Dialogue: 0,0:16:02.67,0:16:03.92,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.17,0:16:07.04,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:16:07.13,0:16:10.92,Default,,0,0,0,,Жүр, тезірек, Күл Ней.
Dialogue: 0,0:16:11.01,0:16:14.39,Default,,0,0,0,,Тырнақтарың қып-қызыл боп кетсе, құрдымға кетесің.
Dialogue: 0,0:16:14.47,0:16:17.39,Default,,0,0,0,,Дарк Шнайдердің жүрегін ойып алыңыз
Dialogue: 0,0:16:17.47,0:16:19.85,Default,,0,0,0,,Сол қан қарғысты бұзады.
Dialogue: 0,0:16:20.52,0:16:23.35,Default,,0,0,0,,Сіздің аман қалуыңыз үшін!
Dialogue: 0,0:16:24.65,0:16:28.36,Default,,0,0,0,,(Кішкентай Нейдің күлкісі)
Dialogue: 0,0:16:29.23,0:16:31.24,Default,,0,0,0,,Кеттік, Қараңғы Шнайдер!
Dialogue: 0,0:16:31.32,0:16:35.36,Default,,0,0,0,,Осы өте жойқын заклинание арқылы мен сенің өлуіңді тоқтатамын.
Dialogue: 0,0:16:35.45,0:16:37.07,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:16:37.16,0:16:40.83,Default,,0,0,0,,Мен ең үлкен және ең күшті сиқырмен жауап беремін!
Dialogue: 0,0:16:44.87,0:16:48.00,Default,,0,0,0,,О! Ол қазірдің өзінде басталды
Dialogue: 0,0:16:48.09,0:16:50.05,Default,,0,0,0,,Уақыт өте ме?
Dialogue: 0,0:16:50.13,0:16:53.72,Default,,0,0,0,,Екеуі қандай сиқырлы күш шығарады?
Dialogue: 0,0:16:53.80,0:16:56.72,Default,,0,0,0,,Осы қарқынмен өзара шайқас болмай қоймайды!
Dialogue: 0,0:16:56.80,0:16:58.35,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:16:58.43,0:17:01.31,Default,,0,0,0,,Көріністе пайда болған Дирк Шнайдердің фигурасы болды
Dialogue: 0,0:17:01.39,0:17:04.39,Default,,0,0,0,,Жүрегі айуандықпен ойылған мәйіт!
Dialogue: 0,0:17:04.89,0:17:08.52,Default,,0,0,0,,Бұл матчтың нәтижесі анық.
Dialogue: 0,0:17:11.03,0:17:12.65,Default,,0,0,0,,Дауыл өтеді
Dialogue: 0,0:17:15.95,0:17:17.95,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:17:18.03,0:17:20.91,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:17:21.66,0:17:24.79,Default,,0,0,0,,Келіңіздер! Сиқырға екі адам кіреді.
Dialogue: 0,0:17:24.87,0:17:29.92,Default,,0,0,0,,Кайзард Альзадо Ки Сук Ханс Гросс Жібек
Dialogue: 0,0:17:30.00,0:17:33.26,Default,,0,0,0,,Не? Екеуі бірдей сиқырды қолданады
Dialogue: 0,0:17:33.84,0:17:35.67,Default,,0,0,0,,Және бұл заклинание
Dialogue: 0,0:17:35.76,0:17:38.80,Default,,0,0,0,,Дирк Шнайдердің өзі әлі аяқталмаған...
Dialogue: 0,0:17:38.89,0:17:40.68,Default,,0,0,0,,Күлге айнал!
Dialogue: 0,0:17:40.76,0:17:45.39,Default,,0,0,0,,Жер асты әлемінің данышпаны Жеті кілтті ұстап, тозақтың қақпасын аш!
Dialogue: 0,0:17:45.48,0:17:46.48,Default,,0,0,0,,О!
Dialogue: 0,0:17:46.56,0:17:50.15,Default,,0,0,0,,Ақымақ... Ней аяқтады ма?
Dialogue: 0,0:17:50.23,0:17:53.61,Default,,0,0,0,,Бұл өте жойқын заклинание!
Dialogue: 0,0:17:53.69,0:17:57.40,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:18:02.95,0:18:06.00,Default,,0,0,0,,Қош бол Дирк Шнайдер
Dialogue: 0,0:18:07.21,0:18:08.54,Default,,0,0,0,,Осы жолы…
Dialogue: 0,0:18:11.92,0:18:13.17,Default,,0,0,0,,О!
Dialogue: 0,0:18:13.25,0:18:14.55,Default,,0,0,0,,Люс Руше!
Dialogue: 0,0:18:15.63,0:18:17.67,Default,,0,0,0,,Әй, олар бір-бірін итеріп жатыр!
Dialogue: 0,0:18:17.76,0:18:19.89,Default,,0,0,0,,Біз тағы да біркелкі сәйкестік пе?
Dialogue: 0,0:18:19.97,0:18:22.10,Default,,0,0,0,,Жоқ! Қараңдар, балалар!
Dialogue: 0,0:18:22.18,0:18:22.89,Default,,0,0,0,,О!
Dialogue: 0,0:18:23.56,0:18:25.43,Default,,0,0,0,,Нейдің артында сызат бар!
Dialogue: 0,0:18:25.52,0:18:27.39,Default,,0,0,0,,Неи итеріп жатыр!
Dialogue: 0,0:18:27.48,0:18:31.23,Default,,0,0,0,,Қараңғы Шнайдердің сиқырлары сәл күштірек.
Dialogue: 0,0:18:31.31,0:18:34.40,Default,,0,0,0,,Harlo Een - бұл ұзақ уақытқа созылатын заклинание емес.
Dialogue: 0,0:18:34.48,0:18:36.36,Default,,0,0,0,,Бар болғаны бірнеше ондаған секунд қалды!
Dialogue: 0,0:18:36.44,0:18:39.20,Default,,0,0,0,,Екі адамның арасында орасан зор итеруші күш пайда болды.
Dialogue: 0,0:18:39.28,0:18:41.28,Default,,0,0,0,,Ней жоғалады!
Dialogue: 0,0:18:41.37,0:18:42.20,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:18:45.49,0:18:46.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:46.62,0:18:49.00,Default,,0,0,0,,(Нейдің мазасыз дауысы)
Dialogue: 0,0:18:49.75,0:18:55.59,Default,,0,0,0,,Хаха... Осыны тез бітірейік...
Dialogue: 0,0:18:56.34,0:19:00.63,Default,,0,0,0,,Қарғыс менің түрімді өзгертпес бұрын...
Dialogue: 0,0:19:03.01,0:19:04.22,Default,,0,0,0,,Дарш…
Dialogue: 0,0:19:05.47,0:19:08.89,Default,,0,0,0,,Жоқ, өйткені мен жылап жатырмын.
Dialogue: 0,0:19:09.48,0:19:12.73,Default,,0,0,0,,Барға жақын, тағы бірнешеу!
Dialogue: 0,0:19:12.81,0:19:15.44,Default,,0,0,0,,Әлгі адам жылап тұр!
Dialogue: 0,0:19:15.52,0:19:19.07,Default,,0,0,0,,Ата-аналар мен балалар бір-бірін уақытша болса да өлтіретін.
Dialogue: 0,0:19:19.15,0:19:21.45,Default,,0,0,0,,Сіз мұны істей алмайсыз!
Dialogue: 0,0:19:21.53,0:19:23.91,Default,,0,0,0,,Тоқта! өтінемін!
Dialogue: 0,0:19:23.99,0:19:25.66,Default,,0,0,0,,Тоқта, Гара!
Dialogue: 0,0:19:25.74,0:19:26.95,Default,,0,0,0,,Не?
Dialogue: 0,0:19:27.04,0:19:29.41,Default,,0,0,0,,Енді олай істей алмайсың, қыз!
Dialogue: 0,0:19:29.50,0:19:32.67,Default,,0,0,0,,Операция кезіндегі екі адам дерлік транс күйінде.
Dialogue: 0,0:19:32.75,0:19:34.50,Default,,0,0,0,,Мен сізді естімеймін!
Dialogue: 0,0:19:34.59,0:19:37.88,Default,,0,0,0,,Сонымен қатар, сиқыршы шығарған заклинаниенің сиқырлы күші
Dialogue: 0,0:19:37.96,0:19:39.92,Default,,0,0,0,,Сіз ешқашан қайтып орала алмайсыз!
Dialogue: 0,0:19:40.01,0:19:41.13,Default,,0,0,0,,Ой!
Dialogue: 0,0:19:41.22,0:19:42.97,Default,,0,0,0,,Бір рет атылған
Dialogue: 0,0:19:43.05,0:19:44.97,Default,,0,0,0,,Сіз енді қайтара алмайсыз!
Dialogue: 0,0:19:45.55,0:19:46.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:47.64,0:19:48.64,Default,,0,0,0,,Люс!
Dialogue: 0,0:19:49.60,0:19:50.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:50.43,0:19:52.23,Default,,0,0,0,,Сіз шегіңізге жеттіңіз бе?
Dialogue: 0,0:19:52.31,0:19:54.56,Default,,0,0,0,,Қараңызшы, бұл найзағай императорының соңы.
Dialogue: 0,0:19:54.65,0:19:57.48,Default,,0,0,0,,А... а... а!
Dialogue: 0,0:19:57.57,0:19:59.90,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:20:01.36,0:20:02.86,Default,,0,0,0,,Мен өлсем
Dialogue: 0,0:20:03.66,0:20:06.74,Default,,0,0,0,,Мені тағы бір рет ұстағаныңды қалаймын
Dialogue: 0,0:20:07.24,0:20:07.99,Default,,0,0,0,,Дарш!
Dialogue: 0,0:20:10.16,0:20:11.37,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:20:11.87,0:20:13.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:13.33,0:20:14.83,Default,,0,0,0,,Енді менде біреу бар...
Dialogue: 0,0:20:16.79,0:20:19.00,Default,,0,0,0,,Не?
Dialogue: 0,0:20:19.09,0:20:20.63,Default,,0,0,0,,О, сен...
Dialogue: 0,0:20:21.34,0:20:23.05,Default,,0,0,0,,Люс Ренрен?
Dialogue: 0,0:20:23.13,0:20:24.72,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:20:25.34,0:20:27.80,Default,,0,0,0,,Себебі Күліңіз сізді жақсы көреді
Dialogue: 0,0:20:28.81,0:20:32.98,Default,,0,0,0,,Өлімнен де терең қасірет тұңғиығына қамалғаныңды көрмейсің бе?
Dialogue: 0,0:20:33.69,0:20:35.02,Default,,0,0,0,,Көзіңді аш
Dialogue: 0,0:20:35.10,0:20:38.32,Default,,0,0,0,,Ал сүйікті қызыңа жақсылап қара.
Dialogue: 0,0:20:38.40,0:20:41.03,Default,,0,0,0,,Не?
Dialogue: 0,0:20:42.78,0:20:44.78,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:20:44.86,0:20:45.49,Default,,0,0,0,,Уф
Dialogue: 0,0:20:46.03,0:20:48.53,Default,,0,0,0,,Ух… ку… ку…
Dialogue: 0,0:20:48.62,0:20:50.16,Default,,0,0,0,,Айыпталушы!
Dialogue: 0,0:20:50.74,0:20:53.87,Default,,0,0,0,,Ней өлімнен де қатты ауырды.
Dialogue: 0,0:20:53.96,0:20:55.75,Default,,0,0,0,,Қарғыспен өлім емес
Dialogue: 0,0:20:55.83,0:20:58.92,Default,,0,0,0,,Сүйіктіңнің қолынан өлуді таңдадым.
Dialogue: 0,0:20:59.00,0:21:01.00,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:21:01.09,0:21:03.80,Default,,0,0,0,,Абигейлдің бейбақ!
Dialogue: 0,0:21:04.34,0:21:06.64,Default,,0,0,0,,Дарш мен сені жақсы көремін
Dialogue: 0,0:21:07.72,0:21:08.51,Default,,0,0,0,,Осы жолы…
Dialogue: 0,0:21:09.93,0:21:11.47,Default,,0,0,0,,Осы жолы…
Dialogue: 0,0:21:13.68,0:21:15.14,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:21:17.35,0:21:19.23,Default,,0,0,0,,♪～
Dialogue: 0,0:21:20.19,0:21:23.19,Default,,0,0,0,,мыңжапырақ!
Dialogue: 0,0:21:23.28,0:21:29.74,Default,,0,0,0,,Менің сүйкімді қызыма не істедің?
Dialogue: 0,0:22:48.65,0:22:51.66,Default,,0,0,0,,Харло Ен жоғалып кетті
Dialogue: 0,0:22:52.16,0:22:54.12,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:22:54.91,0:22:55.83,Default,,0,0,0,,Люс...
Dialogue: 0,0:22:57.16,0:22:59.58,Default,,0,0,0,,Көремін, телепортация сиқыры...
Dialogue: 0,0:23:00.50,0:23:03.17,Default,,0,0,0,,Харло Енді басқа жерге тасымалдады.
Dialogue: 0,0:23:08.72,0:23:12.80,Default,,0,0,0,,Ой, неге?
Dialogue: 0,0:23:13.60,0:23:14.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:16.26,0:23:17.72,Default,,0,0,0,,Дарш…
Dialogue: 0,0:23:19.73,0:23:21.90,Default,,0,0,0,,Ауырды ма, Эше?
Dialogue: 0,0:23:23.48,0:23:25.90,Default,,0,0,0,,Мен сені қазір босатамын.
Dialogue: 0,0:23:30.49,0:23:31.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:33.45,0:23:36.83,Default,,0,0,0,,Ой... уф... ой...
Dialogue: 0,0:23:37.66,0:23:41.71,Default,,0,0,0,,Ооооооо!
Dialogue: 0,0:23:41.79,0:23:47.50,Default,,0,0,0,,Охххх!
Dialogue: 0,0:23:49.00,0:23:55.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
