Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:18.18,0:00:23.77,Default,,0,0,0,,(Үру)
Dialogue: 0,0:00:23.85,0:00:25.65,Default,,0,0,0,,Нууууу!
Dialogue: 0,0:00:26.40,0:00:27.77,Default,,0,0,0,,бұл... Руш
Dialogue: 0,0:00:29.15,0:00:29.73,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:00:29.82,0:00:31.61,Default,,0,0,0,,Бұл не дүние?
Dialogue: 0,0:00:31.69,0:00:35.16,Default,,0,0,0,,Ол сізді қалағаныңызды жасауға мәжбүрлеу үшін емес!
Dialogue: 0,0:00:35.24,0:00:38.28,Default,,0,0,0,,Бұл кең әдемі әлем
Dialogue: 0,0:00:38.37,0:00:40.74,Default,,0,0,0,,Бұл ешкім үшін емес!
Dialogue: 0,0:00:41.70,0:00:45.83,Default,,0,0,0,,Мен үшін ғана бар дүние.
Dialogue: 0,0:00:46.33,0:00:50.75,Default,,0,0,0,,Мен, иесі, онымен не істеу керектігін шешемін!
Dialogue: 0,0:00:53.59,0:00:55.88,Default,,0,0,0,,Кайзард Альзадо
Dialogue: 0,0:00:55.97,0:00:59.26,Default,,0,0,0,,Ки Сук Ханс Гросс Жібек!
Dialogue: 0,0:00:59.35,0:01:00.97,Default,,0,0,0,,Күлге айнал!
Dialogue: 0,0:01:01.06,0:01:02.85,Default,,0,0,0,,Жер асты әлемінің данышпаны
Dialogue: 0,0:01:02.93,0:01:04.89,Default,,0,0,0,,Жеті кілт бар
Dialogue: 0,0:01:04.98,0:01:06.85,Default,,0,0,0,,Тозақтың қақпасын аш!
Dialogue: 0,0:01:10.40,0:01:13.82,Default,,0,0,0,,Не? Ах, бұл сиқыр ...
Dialogue: 0,0:01:13.90,0:01:16.95,Default,,0,0,0,,Жоқ! Dark Schneider Ең үлкен және ең күшті...
Dialogue: 0,0:01:17.03,0:01:17.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:17.99,0:01:19.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:19.41,0:01:20.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:21.03,0:01:21.95,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:01:22.04,0:01:24.37,Default,,0,0,0,,Сіз жынданып кеттіңіз бе, Дирк Шнайдер?
Dialogue: 0,0:01:24.45,0:01:25.46,Default,,0,0,0,,Шу!
Dialogue: 0,0:01:25.54,0:01:27.62,Default,,0,0,0,,Сіз шыққан шымылдық емес!
Dialogue: 0,0:01:27.71,0:01:31.13,Default,,0,0,0,,Мына тозығы жеткен сарайды ұшырып жіберейік!
Dialogue: 0,0:01:31.21,0:01:35.26,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:01:38.47,0:01:40.18,Default,,0,0,0,,♪～
Dialogue: 0,0:03:05.97,0:03:07.97,Default,,0,0,0,,～♪
Dialogue: 0,0:03:13.02,0:03:14.15,Default,,0,0,0,,Угги…
Dialogue: 0,0:03:15.69,0:03:17.32,Default,,0,0,0,,Уууу!
Dialogue: 0,0:03:20.07,0:03:21.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:24.99,0:03:25.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:25.95,0:03:27.83,Default,,0,0,0,,Нууууу!
Dialogue: 0,0:03:28.37,0:03:31.12,Default,,0,0,0,,Харло Еннің күші маған жеткен жоқ.
Dialogue: 0,0:03:31.21,0:03:32.79,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:03:33.37,0:03:36.67,Default,,0,0,0,,Линчтің жын поштасы жын қылышын және Нейдің Райотын пайдаланады.
Dialogue: 0,0:03:36.75,0:03:38.71,Default,,0,0,0,,Мен оны шетте қайта соққандағыдай.
Dialogue: 0,0:03:39.46,0:03:41.09,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:03:41.17,0:03:42.55,Default,,0,0,0,,Не!
Dialogue: 0,0:03:45.05,0:03:46.18,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:03:46.68,0:03:50.14,Default,,0,0,0,,Қараңғы Шнайдердің ең үлкен және ең күшті заклинациясы болса да,
Dialogue: 0,0:03:50.23,0:03:52.98,Default,,0,0,0,,Мен Омеганың сиқырлы тосқауылынан өте алмаймын...
Dialogue: 0,0:03:54.98,0:03:56.61,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:03:56.69,0:03:58.11,Default,,0,0,0,,Ах~ Тынш! Қамал!
Dialogue: 0,0:03:58.19,0:03:59.23,Default,,0,0,0,,Біздің сарай...
Dialogue: 0,0:03:59.32,0:04:00.44,Default,,0,0,0,,Hiii~
Dialogue: 0,0:04:00.53,0:04:01.57,Default,,0,0,0,,Мен сені бұрын-соңды көрген емеспін.
Dialogue: 0,0:04:01.65,0:04:03.86,Default,,0,0,0,,Барлық мүшелер, қамалдан қашыңыз!
Dialogue: 0,0:04:06.87,0:04:09.66,Default,,0,0,0,,Соншалықты абай болма!
Dialogue: 0,0:04:10.16,0:04:12.91,Default,,0,0,0,,Харло Ен толығымен тойтарыс берді!
Dialogue: 0,0:04:13.96,0:04:14.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:14.92,0:04:16.00,Default,,0,0,0,,Кя! Ууууу!
Dialogue: 0,0:04:16.08,0:04:17.46,Default,,0,0,0,,Агия Гя
Dialogue: 0,0:04:17.54,0:04:18.92,Default,,0,0,0,,Люс! (Ларс) Агия!
Dialogue: 0,0:04:21.67,0:04:24.05,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:04:24.13,0:04:25.51,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:04:25.59,0:04:28.97,Default,,0,0,0,,Кукукукукуку… Керемет!
Dialogue: 0,0:04:29.06,0:04:32.35,Default,,0,0,0,,Тіпті Харло Ен де шыдай алмайды!
Dialogue: 0,0:04:32.85,0:04:35.31,Default,,0,0,0,,Бұл біріктірілген сиқыршы патшаның сауытының денесі
Dialogue: 0,0:04:35.40,0:04:40.02,Default,,0,0,0,,Бұл сізде абсолютті сиқырлы класс қорғаныс өрісі бар дегенді білдіреді.
Dialogue: 0,0:04:40.53,0:04:41.82,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:04:41.90,0:04:43.70,Default,,0,0,0,,Абсолютті сиқырлы қорғаныс
Dialogue: 0,0:04:43.78,0:04:48.16,Default,,0,0,0,,Тіпті Жоюшы Құдайдан келетін қараңғылық күші де бітеліп қалады.
Dialogue: 0,0:04:48.24,0:04:51.20,Default,,0,0,0,,Шексіз сиқырлы күшті сырттан сіңірсе де,
Dialogue: 0,0:04:51.29,0:04:53.58,Default,,0,0,0,,Жаудың заклинаниелері қабылданбайды!
Dialogue: 0,0:04:53.66,0:04:56.04,Default,,0,0,0,,Нухахахаха...
Dialogue: 0,0:04:56.58,0:04:58.17,Default,,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:04:58.25,0:05:01.21,Default,,0,0,0,,Сіз бұл Абигейлді ренжіте алмайсыз!
Dialogue: 0,0:05:01.96,0:05:03.46,Default,,0,0,0,,Жеңілмейтін!
Dialogue: 0,0:05:04.01,0:05:05.43,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:05:05.51,0:05:06.22,Default,,0,0,0,,Мм!
Dialogue: 0,0:05:06.30,0:05:07.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:07.09,0:05:07.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:09.93,0:05:12.35,Default,,0,0,0,,Абсолютті сиқырлы қорғаныс емес
Dialogue: 0,0:05:12.85,0:05:14.52,Default,,0,0,0,,Қандай өріс болса да
Dialogue: 0,0:05:14.60,0:05:17.69,Default,,0,0,0,,Егер қорғаныс күшінен асатын күш қосылса
Dialogue: 0,0:05:17.77,0:05:19.40,Default,,0,0,0,,Ол міндетті түрде құлайды!
Dialogue: 0,0:05:19.90,0:05:21.48,Default,,0,0,0,,Ауыз кішіреймейді
Dialogue: 0,0:05:21.57,0:05:25.28,Default,,0,0,0,,Алдымен Эшет Нейдің осы заклинаниясын өзіңізге қолданыңыз!
Dialogue: 0,0:05:26.40,0:05:28.49,Default,,0,0,0,,Кайзард Альзадо
Dialogue: 0,0:05:28.57,0:05:30.03,Default,,0,0,0,,･･･
Dialogue: 0,0:05:30.87,0:05:32.04,Default,,0,0,0,,Жалпы жібек!
Dialogue: 0,0:05:32.54,0:05:33.66,Default,,0,0,0,,Не?
Dialogue: 0,0:05:33.75,0:05:34.87,Default,,0,0,0,,Заклинание...
Dialogue: 0,0:05:34.95,0:05:37.33,Default,,0,0,0,,Шындықты сақтаңыз! Мүмкін емес!
Dialogue: 0,0:05:37.42,0:05:39.54,Default,,0,0,0,,Ней де Харлоин ме?
Dialogue: 0,0:05:40.13,0:05:41.59,Default,,0,0,0,,Күлге айнал!
Dialogue: 0,0:05:41.67,0:05:42.88,Default,,0,0,0,,Жер асты әлемінің данышпаны
Dialogue: 0,0:05:42.96,0:05:44.51,Default,,0,0,0,,Жеті кілт бар
Dialogue: 0,0:05:44.59,0:05:46.51,Default,,0,0,0,,Тозақ есігін аш!
Dialogue: 0,0:05:47.09,0:05:48.93,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:05:49.01,0:05:50.72,Default,,0,0,0,,Бұл алдау!
Dialogue: 0,0:05:52.01,0:05:54.72,Default,,0,0,0,,Жеп ал, Абигейл!
Dialogue: 0,0:05:56.18,0:06:01.77,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:06:02.40,0:06:06.11,Default,,0,0,0,,Хогиееееее!
Dialogue: 0,0:06:06.65,0:06:07.57,Default,,0,0,0,,О!
Dialogue: 0,0:06:07.65,0:06:11.16,Default,,0,0,0,,Мен Харло Енмен қос шабуыл жасаймын деп ешқашан ойламадым!
Dialogue: 0,0:06:12.08,0:06:16.12,Default,,0,0,0,,Екі Гарлоуиннің синергетикалық әсерінен пайда болатын жылу энергиясы
Dialogue: 0,0:06:16.20,0:06:19.37,Default,,0,0,0,,Благоза ошағы тыйым салынған сиқырдан шамамен 1,5 есе көп
Dialogue: 0,0:06:20.46,0:06:21.54,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:06:21.63,0:06:23.67,Default,,0,0,0,,Егер бұл сізді өлтірмесе
Dialogue: 0,0:06:23.75,0:06:28.59,Default,,0,0,0,,Өте сиқырлы пішіндерге айналған сиқырлы құрылғылардың үш түрін жою
Dialogue: 0,0:06:28.67,0:06:30.84,Default,,0,0,0,,іс жүзінде мүмкін емес
Dialogue: 0,0:06:31.80,0:06:32.47,Default,,0,0,0,,Жоқ-
Dialogue: 0,0:06:33.10,0:06:35.93,Default,,0,0,0,,Мен оны міндетті түрде түсіремін!
Dialogue: 0,0:06:36.52,0:06:39.10,Default,,0,0,0,,Дарш екеуміздің сиқырымен!
Dialogue: 0,0:06:42.44,0:06:44.90,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:06:44.98,0:06:47.65,Default,,0,0,0,,О, Дирк Шнайдер!
Dialogue: 0,0:06:48.36,0:06:49.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:49.57,0:06:50.86,Default,,0,0,0,,Агия агья!
Dialogue: 0,0:06:50.95,0:06:52.20,Default,,0,0,0,,Люс!
Dialogue: 0,0:06:53.12,0:06:54.49,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:06:54.58,0:06:56.45,Default,,0,0,0,,Ахх!
Dialogue: 0,0:06:56.54,0:07:00.21,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:07:16.76,0:07:18.35,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:07:18.43,0:07:19.48,Default,,0,0,0,,Қу!
Dialogue: 0,0:07:20.14,0:07:20.81,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:07:23.86,0:07:25.73,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:07:27.78,0:07:29.15,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:07:35.66,0:07:36.49,Default,,0,0,0,,О!
Dialogue: 0,0:07:36.99,0:07:38.20,Default,,0,0,0,,Маю-сан менің жейдемнің үстінде жатыр…
Dialogue: 0,0:07:38.87,0:07:40.12,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:07:40.20,0:07:42.79,Default,,0,0,0,,Иә! Біз құтқарылдық!
Dialogue: 0,0:07:42.87,0:07:45.75,Default,,0,0,0,,Ура!
Dialogue: 0,0:07:45.84,0:07:47.30,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:07:47.38,0:07:49.46,Default,,0,0,0,,Лорд Дирк Шнайдер жеңді!
Dialogue: 0,0:07:49.55,0:07:50.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:50.67,0:07:54.01,Default,,0,0,0,,Иә! Мен оны істедім! Хаха...
Dialogue: 0,0:07:54.09,0:07:56.39,Default,,0,0,0,,Аспаз аспаз Аспаз…
Dialogue: 0,0:07:56.89,0:07:57.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:57.64,0:07:58.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.93,0:08:01.89,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:08:01.98,0:08:05.81,Default,,0,0,0,,Бұл қуат деңгейі жақсылыққа арналған.
Dialogue: 0,0:08:06.44,0:08:10.82,Default,,0,0,0,,Ұлы зұлымдық алдында, сен, балалар, миджеттен артық емессіңдер!
Dialogue: 0,0:08:13.82,0:08:15.20,Default,,0,0,0,,Уау! Ка...
Dialogue: 0,0:08:19.24,0:08:23.12,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:08:26.67,0:08:28.59,Default,,0,0,0,,Сол миджалар
Dialogue: 0,0:08:28.67,0:08:33.05,Default,,0,0,0,,Құдайдың қайта тірілуіне жол бермеуге тырысу - күлкілі.
Dialogue: 0,0:08:35.13,0:08:36.05,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:36.55,0:08:38.10,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:08:38.60,0:08:41.56,Default,,0,0,0,,Мен оның бұл супер сиқырлы шабуылға төтеп бере алатынына сене алмаймын!
Dialogue: 0,0:08:42.14,0:08:45.39,Default,,0,0,0,,Оның бүкіл денесі сиқырға қарсы «қарғыс белгісін емдеумен» өңделген.
Dialogue: 0,0:08:45.90,0:08:48.31,Default,,0,0,0,,Қылыш та, сиқыр да тіл табыса алмайды.
Dialogue: 0,0:08:49.11,0:08:51.28,Default,,0,0,0,,Демон Дирк Шнайдер
Dialogue: 0,0:08:51.36,0:08:54.15,Default,,0,0,0,,Қанша істесең де, енді қозғала алмайсың.
Dialogue: 0,0:08:54.24,0:08:57.32,Default,,0,0,0,,Бұл жай ғана жақсы нәрсе!
Dialogue: 0,0:08:57.41,0:09:00.41,Default,,0,0,0,,Махаббаттан адасу ақымақтық болар.
Dialogue: 0,0:09:00.49,0:09:03.58,Default,,0,0,0,,Сіздің өміріңіз бен аңыз
Dialogue: 0,0:09:03.66,0:09:05.37,Default,,0,0,0,,Бүгін аяқталды!
Dialogue: 0,0:09:09.13,0:09:12.51,Default,,0,0,0,,Бұл бос және қорқыныш күні ...
Dialogue: 0,0:09:12.59,0:09:13.97,Default,,0,0,0,,Өлім және жойылу -
Dialogue: 0,0:09:14.05,0:09:17.72,Default,,0,0,0,,Бұл жаңа тозақтың туған күні!
Dialogue: 0,0:09:18.89,0:09:21.72,Default,,0,0,0,,Дахахахаха...
Dialogue: 0,0:09:21.81,0:09:24.02,Default,,0,0,0,,Ухахахаха!
Dialogue: 0,0:09:24.10,0:09:26.35,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:26.44,0:09:28.98,Default,,0,0,0,,Ах~ менің енді қолымнан келмейді
Dialogue: 0,0:09:29.56,0:09:32.69,Default,,0,0,0,,Бұл аяқталды! Барлығы...
Dialogue: 0,0:09:32.78,0:09:34.36,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:34.44,0:09:35.65,Default,,0,0,0,,Ух... Дарш!
Dialogue: 0,0:09:35.74,0:09:36.90,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:09:36.99,0:09:38.61,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:09:38.70,0:09:41.12,Default,,0,0,0,,Ух... ку...
Dialogue: 0,0:09:42.16,0:09:44.62,Default,,0,0,0,,Демон Дирк Шнайдер
Dialogue: 0,0:09:44.70,0:09:48.71,Default,,0,0,0,,Сіз жаңа тозаққа жазылдыңыз.
Dialogue: 0,0:09:49.33,0:09:51.04,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:09:51.13,0:09:53.71,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:09:56.88,0:09:58.93,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:09:59.89,0:10:01.80,Default,,0,0,0,,Бүгін кім өледі?
Dialogue: 0,0:10:02.47,0:10:03.89,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:04.52,0:10:05.35,Default,,0,0,0,,Люс!
Dialogue: 0,0:10:05.85,0:10:07.31,Default,,0,0,0,,Кукукукукуку
Dialogue: 0,0:10:07.39,0:10:11.02,Default,,0,0,0,,Қыңырлығыңнан әлі де айырылдың ба?
Dialogue: 0,0:10:11.11,0:10:11.73,Default,,0,0,0,,Уф
Dialogue: 0,0:10:11.81,0:10:12.77,Default,,0,0,0,,Қу!
Dialogue: 0,0:10:12.86,0:10:13.73,Default,,0,0,0,,Дарш!
Dialogue: 0,0:10:14.28,0:10:16.44,Default,,0,0,0,,Дарш Дарш!
Dialogue: 0,0:10:17.03,0:10:20.70,Default,,0,0,0,,Дарш өлсе, мен енді өмір сүре алмаймын.
Dialogue: 0,0:10:20.78,0:10:23.58,Default,,0,0,0,,Ол қазірдің өзінде...
Dialogue: 0,0:10:25.37,0:10:28.00,Default,,0,0,0,,Бірге шығайық, Дирк Шнайдер!
Dialogue: 0,0:10:28.08,0:10:29.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:29.08,0:10:29.71,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:10:32.50,0:10:33.79,Default,,0,0,0,,Екеуің күтіңдер!
Dialogue: 0,0:10:33.88,0:10:34.96,Default,,0,0,0,,Барма!
Dialogue: 0,0:10:35.05,0:10:37.13,Default,,0,0,0,,Жарайды, мен өлмеймін.
Dialogue: 0,0:10:37.63,0:10:39.88,Default,,0,0,0,,Руш пен Дирк Шнайдер де!
Dialogue: 0,0:10:39.97,0:10:41.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:41.18,0:10:42.55,Default,,0,0,0,,Жас ханым?
Dialogue: 0,0:10:43.18,0:10:44.89,Default,,0,0,0,,Өйткені мен ешқашан өлмеймін!
Dialogue: 0,0:10:45.47,0:10:48.27,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:10:48.35,0:10:51.35,Default,,0,0,0,,Енді мен сізге соңғы нүктені беремін!
Dialogue: 0,0:10:51.44,0:10:55.02,Default,,0,0,0,,Біріктірілген сиқырлы патша Омега Абигейл I-
Dialogue: 0,0:10:55.11,0:10:57.99,Default,,0,0,0,,Ең үлкен және ең күшті соңғы қару
Dialogue: 0,0:10:58.07,0:10:59.95,Default,,0,0,0,,Абигейл Колледер
Dialogue: 0,0:11:00.03,0:11:03.16,Default,,0,0,0,,Голем сияқты, күлге айналдырайық.
Dialogue: 0,0:11:03.87,0:11:05.83,Default,,0,0,0,,Мен сенен құтылған соң
Dialogue: 0,0:11:05.91,0:11:09.71,Default,,0,0,0,,Сенің асыл қызың, досың, әйелің
Dialogue: 0,0:11:10.21,0:11:15.13,Default,,0,0,0,,Мен бәріңді тозаққа жіберемін, тыныш өліңдер!
Dialogue: 0,0:11:15.21,0:11:16.63,Default,,0,0,0,,Дарш!
Dialogue: 0,0:11:16.71,0:11:18.17,Default,,0,0,0,,Дарш! Ах...
Dialogue: 0,0:11:18.67,0:11:19.55,Default,,0,0,0,,Гала!
Dialogue: 0,0:11:20.13,0:11:21.63,Default,,0,0,0,,Қылыш жұмыс істемейді
Dialogue: 0,0:11:22.13,0:11:26.01,Default,,0,0,0,,Тіпті екі адам бір уақытта шабуылдың максималды сиқырымен Haro Een шабуылдаса да
Dialogue: 0,0:11:26.10,0:11:28.39,Default,,0,0,0,,Бірде-бір сызат жоқ
Dialogue: 0,0:11:29.60,0:11:31.35,Default,,0,0,0,,Жас келіншек иә дейді.
Dialogue: 0,0:11:31.44,0:11:32.73,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:32.81,0:11:35.23,Default,,0,0,0,,Енді ештеңе істей алмаймыз.
Dialogue: 0,0:11:36.36,0:11:37.48,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:11:37.57,0:11:39.94,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:11:40.03,0:11:42.57,Default,,0,0,0,,Дирк Шнайдер және Абигейл
Dialogue: 0,0:11:42.66,0:11:45.49,Default,,0,0,0,,Бұл екеуінің арасындағы қараңғылық күші тым күшті.
Dialogue: 0,0:11:45.99,0:11:48.66,Default,,0,0,0,,Шейла ханшайымның ішкі мөріне араласу.
Dialogue: 0,0:11:50.50,0:11:51.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:51.75,0:11:54.17,Default,,0,0,0,,Осы жылдамдықпен пломба бұзылады.
Dialogue: 0,0:11:55.17,0:11:56.75,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:56.84,0:11:58.46,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:11:59.96,0:12:01.42,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:12:02.97,0:12:06.30,Default,,0,0,0,,Өтінемін, өтінемін, өлме.
Dialogue: 0,0:12:07.64,0:12:10.64,Default,,0,0,0,,Қазір әлемді жойылудан не құтқара алады?
Dialogue: 0,0:12:11.39,0:12:12.81,Default,,0,0,0,,Сен жалғызсың
Dialogue: 0,0:12:26.28,0:12:27.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:27.24,0:12:28.87,Default,,0,0,0,,Тұр!
Dialogue: 0,0:12:29.49,0:12:31.29,Default,,0,0,0,,Тұр!
Dialogue: 0,0:12:32.29,0:12:38.21,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:12:38.79,0:12:39.71,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:41.05,0:12:42.42,Default,,0,0,0,,Неге, Дарш?
Dialogue: 0,0:12:43.17,0:12:46.14,Default,,0,0,0,,Неліктен біз күресу үшін соншалықты ұзаққа баруымыз керек?
Dialogue: 0,0:12:47.09,0:12:48.72,Default,,0,0,0,,Адамдар үшін...
Dialogue: 0,0:12:49.81,0:12:51.22,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:12:52.35,0:12:54.77,Default,,0,0,0,,Бейбітшілік және идеалды қоғам
Dialogue: 0,0:12:54.85,0:12:56.15,Default,,0,0,0,,Өйткені маған ештеңе керек емес...
Dialogue: 0,0:12:57.61,0:12:59.73,Default,,0,0,0,,Қашайық, екеуміз ғана.
Dialogue: 0,0:13:02.90,0:13:05.65,Default,,0,0,0,,Бір жерге қашып, екеуміз ғана өмір сүрейік.
Dialogue: 0,0:13:06.32,0:13:07.62,Default,,0,0,0,,Ескі күндер сияқты...
Dialogue: 0,0:13:10.12,0:13:11.54,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:13:12.79,0:13:13.79,Default,,0,0,0,,Дарш!
Dialogue: 0,0:13:19.84,0:13:21.09,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,0:13:21.17,0:13:24.72,Default,,0,0,0,,Қара бұлттар Металликана сарайының үстінде ғана таралып жатыр.
Dialogue: 0,0:13:25.30,0:13:29.55,Default,,0,0,0,,Бұл қамалда қараңғы күштің орасан зор мөлшері шоғырланған ба?
Dialogue: 0,0:13:30.05,0:13:30.89,Default,,0,0,0,,Осындай күйде тежеліп тұру аса жағымды емес
Dialogue: 0,0:13:30.97,0:13:31.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:33.02,0:13:34.60,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:13:34.68,0:13:35.94,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:13:36.44,0:13:38.56,Default,,0,0,0,,Содан мен тұрғанда,
Dialogue: 0,0:13:39.06,0:13:42.40,Default,,0,0,0,,Сізге жасайтын ештеңе қалмады.
Dialogue: 0,0:13:43.11,0:13:45.28,Default,,0,0,0,,Қанша үлкен жын болсаң да,
Dialogue: 0,0:13:45.36,0:13:48.11,Default,,0,0,0,,Оның бастапқы қасиеті – қараңғылық
Dialogue: 0,0:13:48.20,0:13:49.91,Default,,0,0,0,,Яғни, зұлымдық!
Dialogue: 0,0:13:50.41,0:13:51.78,Default,,0,0,0,,Жамандықтан аулақ
Dialogue: 0,0:13:51.87,0:13:54.58,Default,,0,0,0,,Сібірдің күшін алсам да
Dialogue: 0,0:13:54.66,0:14:00.04,Default,,0,0,0,,Мені, қараңғылықтың жиналатын күшін жеңе алмайсың.
Dialogue: 0,0:14:00.13,0:14:01.25,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:14:01.34,0:14:04.38,Default,,0,0,0,,Сүйіспеншілікпен ұсталып, шектеледі.
Dialogue: 0,0:14:04.46,0:14:08.26,Default,,0,0,0,,Тіпті нәзік, әлсіз және ыңғайсыз барлықтарыңыз біріктірілсе де,
Dialogue: 0,0:14:08.34,0:14:11.26,Default,,0,0,0,,Енді шексіз абсолютті зұлымдық-
Dialogue: 0,0:14:11.35,0:14:14.68,Default,,0,0,0,,Мен Қиратушы Құдайдың, Сібір жарасының бөлігімін.
Dialogue: 0,0:14:14.77,0:14:17.02,Default,,0,0,0,,Жеңіске жету мүмкін емес!
Dialogue: 0,0:14:17.10,0:14:19.73,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:14:19.81,0:14:20.69,Default,,0,0,0,,Не!
Dialogue: 0,0:14:20.77,0:14:23.40,Default,,0,0,0,,Не? Ха, жою Құдайы ...
Dialogue: 0,0:14:23.48,0:14:24.86,Default,,0,0,0,,Some?
Dialogue: 0,0:14:28.28,0:14:29.53,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:14:29.61,0:14:33.24,Default,,0,0,0,,Сол ақымақ және ұнамсыз махаббат пен жақсылық
Dialogue: 0,0:14:33.33,0:14:36.95,Default,,0,0,0,,Енді мен сенімен бірге өлемін!
Dialogue: 0,0:14:37.04,0:14:38.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:38.66,0:14:40.04,Default,,0,0,0,,Дарш!
Dialogue: 0,0:14:40.12,0:14:43.84,Default,,0,0,0,,Уф, менің Даршымды өлтірме!
Dialogue: 0,0:14:43.92,0:14:46.01,Default,,0,0,0,,Люс!
Dialogue: 0,0:14:46.09,0:14:48.22,Default,,0,0,0,,Жақсы болмайсың ба!
Dialogue: 0,0:14:48.30,0:14:51.39,Default,,0,0,0,,Мен екі адамның қамын ойлаудың қажеті жоқ!
Dialogue: 0,0:14:51.47,0:14:55.22,Default,,0,0,0,,Жеңсем саған бәрін беремін, тіпті қыздығымды да беремін.
Dialogue: 0,0:14:55.72,0:14:57.85,Default,,0,0,0,,Сондықтан -
Dialogue: 0,0:14:57.93,0:15:00.81,Default,,0,0,0,,Егер жеңілсең, мен қабылдамаймын!
Dialogue: 0,0:15:12.70,0:15:14.07,Default,,0,0,0,,Не?
Dialogue: 0,0:15:14.99,0:15:17.08,Default,,0,0,0,,Fukkaku haha…
Dialogue: 0,0:15:17.16,0:15:20.00,Default,,0,0,0,,Жақсылыққа не болды? Жамандық деген не?
Dialogue: 0,0:15:20.96,0:15:21.71,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:15:21.79,0:15:25.75,Default,,0,0,0,,Бұл мен үшін тіпті түкке тұрғысыз!
Dialogue: 0,0:15:26.34,0:15:27.50,Default,,0,0,0,,Не?
Dialogue: 0,0:15:27.59,0:15:29.47,Default,,0,0,0,,Жүр, сен!
Dialogue: 0,0:15:29.55,0:15:31.51,Default,,0,0,0,,Listen, Abigail.
Dialogue: 0,0:15:31.59,0:15:34.43,Default,,0,0,0,,Негізінде, бұл Dark Schneider-sama
Dialogue: 0,0:15:34.51,0:15:36.89,Default,,0,0,0,,Өзіңізді жақсы сезінбесеңіз де.
Dialogue: 0,0:15:36.97,0:15:39.85,Default,,0,0,0,,Маған ары қарай не болатыны бәрібір!
Dialogue: 0,0:15:39.93,0:15:41.81,Default,,0,0,0,,Жақсылық па, жамандық па?
Dialogue: 0,0:15:41.89,0:15:45.40,Default,,0,0,0,,Мұндай уәденің ер адамның төбелесуіне қатысы бар ма?
Dialogue: 0,0:15:45.48,0:15:46.82,Default,,0,0,0,,Here…
Dialogue: 0,0:15:46.90,0:15:48.44,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:15:48.53,0:15:52.07,Default,,0,0,0,,Өлуің керек!
Dialogue: 0,0:15:52.61,0:15:55.45,Default,,0,0,0,,...
Dialogue: 0,0:15:55.53,0:15:58.91,Default,,0,0,0,,Қан келісімі бойынша Абаддон жерінен келіңіздер.
Dialogue: 0,0:15:58.99,0:16:00.12,Default,,0,0,0,,That spell...
Dialogue: 0,0:16:00.20,0:16:01.21,Default,,0,0,0,,Дарш!
Dialogue: 0,0:16:01.29,0:16:04.08,Default,,0,0,0,,Тоқта, Қараңғы Шнайдер! Magic doesn't work
Dialogue: 0,0:16:04.67,0:16:08.92,Default,,0,0,0,,Жаһаннам оты, жалынға оранып, бәрін жалмады.
Dialogue: 0,0:16:09.00,0:16:10.26,Default,,0,0,0,,Вахаха!
Dialogue: 0,0:16:10.34,0:16:11.97,Default,,0,0,0,,You bastard!
Dialogue: 0,0:16:12.05,0:16:13.63,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:16:13.72,0:16:16.47,Default,,0,0,0,,Abigail Colleder!
Dialogue: 0,0:16:16.55,0:16:18.72,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:16:18.81,0:16:20.18,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:16:22.23,0:16:24.14,Default,,0,0,0,,Экс-Зордус!
Dialogue: 0,0:16:24.85,0:16:26.02,Default,,0,0,0,,Ухаха!
Dialogue: 0,0:16:26.11,0:16:27.48,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:16:27.56,0:16:30.86,Default,,0,0,0,,Омеганың сауыты сиқырды толығымен бөгейді.
Dialogue: 0,0:16:30.94,0:16:32.28,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:16:35.82,0:16:39.45,Default,,0,0,0,,Шынында да, сауыт бөлігі тамаша, Абигейл!
Dialogue: 0,0:16:39.54,0:16:40.62,Default,,0,0,0,,Бірақ сәлем
Dialogue: 0,0:16:40.70,0:16:44.37,Default,,0,0,0,,Одан басқа, өте нәзік көрінеді, солай ма?
Dialogue: 0,0:16:44.46,0:16:45.71,Default,,0,0,0,,Не?
Dialogue: 0,0:16:48.67,0:16:50.05,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:16:50.13,0:16:53.01,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:16:53.09,0:16:55.34,Default,,0,0,0,,Ақылсыз!
Dialogue: 0,0:16:55.43,0:16:59.39,Default,,0,0,0,,Сен ессіз баласың!
Dialogue: 0,0:16:59.47,0:17:02.64,Default,,0,0,0,,Жақсылық пен жамандық...
Dialogue: 0,0:17:02.73,0:17:07.06,Default,,0,0,0,,Қанша!
Dialogue: 0,0:17:11.98,0:17:12.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.49,0:17:17.99,Default,,0,0,0,,Нуаааааааааааа!
Dialogue: 0,0:17:18.07,0:17:20.20,Default,,0,0,0,,Қарғыс атсын, сен жындысың.
Dialogue: 0,0:17:20.28,0:17:24.37,Default,,0,0,0,,Омеганың энергия шығаратын шырышты қабаты «қарғыс қыртысын емдеумен» өңделмеген жалғыз.
Dialogue: 0,0:17:24.46,0:17:28.08,Default,,0,0,0,,Мен оның Colledar ұшырылған сәтін көздеп, асығыс келеді деп күтпедім!
Dialogue: 0,0:17:30.42,0:17:33.01,Default,,0,0,0,,Бұл шектен шыққан.
Dialogue: 0,0:17:39.55,0:17:40.51,Default,,0,0,0,,Дарш!
Dialogue: 0,0:17:40.60,0:17:42.18,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:17:42.26,0:17:43.43,Default,,0,0,0,,Иә
Dialogue: 0,0:17:45.98,0:17:47.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:57.15,0:17:58.24,Default,,0,0,0,,О!
Dialogue: 0,0:17:58.32,0:17:59.70,Default,,0,0,0,,Агия
Dialogue: 0,0:18:00.45,0:18:01.28,Default,,0,0,0,,Міне
Dialogue: 0,0:18:01.87,0:18:04.54,Default,,0,0,0,,Сиқырлы күш қайтып келеді
Dialogue: 0,0:18:08.42,0:18:11.00,Default,,0,0,0,,Мөр сақталды
Dialogue: 0,0:18:16.72,0:18:17.55,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:18.22,0:18:19.05,Default,,0,0,0,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:18:19.64,0:18:20.93,Default,,0,0,0,,Бұл жолы шынымен...
Dialogue: 0,0:18:21.01,0:18:23.01,Default,,0,0,0,,О, әлем құтқарылды!
Dialogue: 0,0:18:23.51,0:18:25.89,Default,,0,0,0,,Металликана аман болсын!
Dialogue: 0,0:18:25.97,0:18:28.85,Default,,0,0,0,,Metallicana!
Dialogue: 0,0:18:28.94,0:18:31.06,Default,,0,0,0,,Metallicana Metallicana...
Dialogue: 0,0:18:31.15,0:18:32.77,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:18:32.86,0:18:33.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.65,0:18:42.20,Default,,0,0,0,,Дирк... Дирк Шнайдер бұл...
Dialogue: 0,0:18:53.25,0:18:54.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:54.59,0:18:55.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:58.26,0:19:00.26,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:19:00.34,0:19:03.10,Default,,0,0,0,,Дарш! Дарш!
Dialogue: 0,0:19:03.18,0:19:05.14,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:19:06.01,0:19:07.06,Default,,0,0,0,,Бірақ біреу—
Dialogue: 0,0:19:07.14,0:19:10.02,Default,,0,0,0,,...
Dialogue: 0,0:19:10.10,0:19:13.40,Default,,0,0,0,,Мені тастама!
Dialogue: 0,0:19:13.48,0:19:15.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:15.57,0:19:18.44,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:19:19.70,0:19:20.82,Default,,0,0,0,,Люс...
Dialogue: 0,0:19:21.95,0:19:23.87,Default,,0,0,0,,...
Dialogue: 0,0:19:24.45,0:19:26.70,Default,,0,0,0,,Ежелгі Ұлы Сиқыршы
Dialogue: 0,0:19:28.91,0:19:33.08,Default,,0,0,0,,Қылмыскер, өзімшіл, үстемшіл, қатыгез
Dialogue: 0,0:19:33.79,0:19:35.71,Default,,0,0,0,,Мен тек өзімді ойлаймын
Dialogue: 0,0:19:36.63,0:19:38.26,Default,,0,0,0,,Әйелдерге қатысты принципсіз
Dialogue: 0,0:19:38.96,0:19:42.43,Default,,0,0,0,,Қанша сұрасам да, олар өз ойынан айнымайды...
Dialogue: 0,0:19:43.68,0:19:44.85,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:46.81,0:19:47.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:52.73,0:19:53.60,Default,,0,0,0,,Люс...
Dialogue: 0,0:19:55.86,0:19:57.19,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:20:05.57,0:20:08.66,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:08.74,0:20:14.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:14.71,0:20:15.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:15.67,0:20:16.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:24.05,0:20:25.18,Default,,0,0,0,,Дарш
Dialogue: 0,0:20:26.14,0:20:28.89,Default,,0,0,0,,Дарш! Дирк Шнайдер!
Dialogue: 0,0:20:28.97,0:20:31.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:35.60,0:20:36.73,Default,,0,0,0,,Құдай…
Dialogue: 0,0:20:37.23,0:20:41.57,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:42.19,0:20:42.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.90,0:20:45.32,Default,,0,0,0,,Эй, сен жылап тұрсың ба?
Dialogue: 0,0:20:45.41,0:20:46.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.99,0:20:48.95,Default,,0,0,0,,Бүгін бүгін.
Dialogue: 0,0:20:49.45,0:20:53.00,Default,,0,0,0,,Бүгін менің Йоко-санды жеңу мүмкіндігім...
Dialogue: 0,0:20:53.08,0:20:54.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:54.21,0:20:56.17,Default,,0,0,0,,Йоко саған өзінің пәктігін береді.
Dialogue: 0,0:20:56.25,0:20:57.17,Default,,0,0,0,,Сіз маған...
Dialogue: 0,0:20:57.25,0:20:57.96,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:59.04,0:21:00.75,Default,,0,0,0,,Ондай нәрсе жоқ!
Dialogue: 0,0:21:02.26,0:21:06.09,Default,,0,0,0,,Менің үлкен магнум ішіме дейін бүгіліп қалды...
Dialogue: 0,0:21:06.18,0:21:08.97,Default,,0,0,0,,Уф... өте өкінішті!
Dialogue: 0,0:21:09.05,0:21:10.10,Default,,0,0,0,,Ашық!
Dialogue: 0,0:21:10.18,0:21:11.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:11.14,0:21:12.06,Default,,0,0,0,,Агия
Dialogue: 0,0:21:12.14,0:21:14.43,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:21:14.52,0:21:17.31,Default,,0,0,0,,Мен Абигейлмен бірге өлуім керек еді!
Dialogue: 0,0:21:17.40,0:21:18.61,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:21:18.69,0:21:20.44,Default,,0,0,0,,Уау, кешіріңіз!
Dialogue: 0,0:21:20.52,0:21:22.48,Default,,0,0,0,,Мүлдем! Неге сен?
Dialogue: 0,0:21:22.57,0:21:25.07,Default,,0,0,0,,Тоқта! Даршты қорламаңыз
Dialogue: 0,0:21:26.57,0:21:28.82,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:21:28.91,0:21:30.03,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:21:30.12,0:21:31.08,Default,,0,0,0,,Дарш!
Dialogue: 0,0:21:31.16,0:21:32.45,Default,,0,0,0,,Ескі жігіт болса
Dialogue: 0,0:21:32.54,0:21:35.75,Default,,0,0,0,,Мен мұндай нәрсеге айналатын шайқасқа ешқашан қатыспаймын.
Dialogue: 0,0:21:36.29,0:21:37.54,Default,,0,0,0,,Мен өлім алдында тұрмын.
Dialogue: 0,0:21:37.62,0:21:39.21,Default,,0,0,0,,Бірақ бұл жігіт дәл қазір...
Dialogue: 0,0:21:40.25,0:21:44.63,Default,,0,0,0,,Қысқасы, дәл қазір бұл жігіт туралы кім көбірек біледі?
Dialogue: 0,0:21:45.13,0:21:48.97,Default,,0,0,0,,Сіз бұл мен немесе Ней емес, жас ханым дейсіз бе?
Dialogue: 0,0:21:51.64,0:21:54.02,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:54.10,0:21:55.52,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:21:55.60,0:21:56.89,Default,,0,0,0,,Хмм…
Dialogue: 0,0:22:02.86,0:22:03.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:04.44,0:22:06.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:08.32,0:22:08.99,Default,,0,0,0,,Не!
Dialogue: 0,0:22:13.04,0:22:14.91,Default,,0,0,0,,Жоқ! Теме...
Dialogue: 0,0:22:16.87,0:22:18.54,Default,,0,0,0,,Абигейл!
Dialogue: 0,0:22:23.25,0:22:24.59,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.63,0:23:46.63,Default,,0,0,0,,～♪
Dialogue: 0,0:23:48.13,0:23:54.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
