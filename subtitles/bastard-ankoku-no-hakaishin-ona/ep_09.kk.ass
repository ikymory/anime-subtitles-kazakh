Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:13.09,0:00:14.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:14.68,0:00:18.51,Default,,0,0,0,,Ахахахха ұят болды
Dialogue: 0,0:00:18.60,0:00:21.64,Default,,0,0,0,,Қазіргі күйінде Дирк Шнайдер т.б.
Dialogue: 0,0:00:21.73,0:00:26.60,Default,,0,0,0,,Сіз нәрестенің қолын бұрап өлтіре аласыз.
Dialogue: 0,0:00:26.69,0:00:30.36,Default,,0,0,0,,Балалар, бәрібір құтқарылмайсыңдар!
Dialogue: 0,0:00:30.44,0:00:31.69,Default,,0,0,0,,Уф (көрініс) Кай!
Dialogue: 0,0:00:31.78,0:00:33.82,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:00:33.90,0:00:39.12,Default,,0,0,0,,Егер мен Дарк Шнайдерді өлтірсем, менде енді қорқатын ештеңе жоқ!
Dialogue: 0,0:00:39.20,0:00:41.62,Default,,0,0,0,,Кал мен Нейдің қанының дәмі қандай?
Dialogue: 0,0:00:41.70,0:00:44.46,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:00:44.54,0:00:46.37,Default,,0,0,0,,Кай! Кай!
Dialogue: 0,0:00:46.92,0:00:48.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:51.09,0:00:53.80,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:00:55.34,0:00:57.43,Default,,0,0,0,,бұл... Люс-кун!
Dialogue: 0,0:00:57.93,0:00:59.55,Default,,0,0,0,,Не?
Dialogue: 0,0:01:01.10,0:01:02.06,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:01:02.56,0:01:05.60,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:01:05.69,0:01:08.98,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:01:09.52,0:01:11.23,Default,,0,0,0,,♪～
Dialogue: 0,0:02:36.94,0:02:38.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:39.45,0:02:41.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:02:51.04,0:02:52.17,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:02:52.25,0:02:56.17,Default,,0,0,0,,Мен қауесетті естідім, бірақ жоғары білікті ниндзя армиясы күткендей.
Dialogue: 0,0:02:56.25,0:03:00.18,Default,,0,0,0,,Осыншама гоблин солдаттарының алдында бір қадам да артқа шегінбейді деп ойлау үшін...
Dialogue: 0,0:03:00.26,0:03:04.26,Default,,0,0,0,,Хмм... Бірақ таң қалдыратыны...
Dialogue: 0,0:03:05.01,0:03:07.39,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,0:03:08.14,0:03:11.64,Default,,0,0,0,,Сәлем, балалар! Бір сәт алыста тұрыңыз
Dialogue: 0,0:03:14.15,0:03:15.90,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:03:19.90,0:03:23.11,Default,,0,0,0,,Оларды біріктіріңіз Ниндзя Мастер Гала
Dialogue: 0,0:03:23.87,0:03:27.16,Default,,0,0,0,,Хехе, мен өзімді қатты сергіп қалдым.
Dialogue: 0,0:03:28.62,0:03:30.08,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:30.79,0:03:34.38,Default,,0,0,0,,Міндеттен тыс әрекет етудің қажеті жоқ...
Dialogue: 0,0:03:34.88,0:03:36.67,Default,,0,0,0,,Ол бейбаққа не істедің?
Dialogue: 0,0:03:37.88,0:03:40.30,Default,,0,0,0,,А... а...
Dialogue: 0,0:03:40.38,0:03:42.63,Default,,0,0,0,,Ааааааааааааааааааааа!
Dialogue: 0,0:03:42.72,0:03:44.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:44.47,0:03:47.06,Default,,0,0,0,,Уау, шығар!
Dialogue: 0,0:03:47.14,0:03:49.52,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:03:50.89,0:03:52.52,Default,,0,0,0,,Ух... (көрініс) Ой...
Dialogue: 0,0:03:52.60,0:03:54.60,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:03:54.69,0:03:58.86,Default,,0,0,0,,Цк... Бала есінен танып қалды ма?
Dialogue: 0,0:03:58.94,0:04:00.69,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:04:00.78,0:04:01.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.95,0:04:04.95,Default,,0,0,0,,Йоко-сан, мен қорқамын! Мен қорқып тұрмын!
Dialogue: 0,0:04:05.03,0:04:07.49,Default,,0,0,0,,Қарғыс атсын! Мені шығарыңыз!
Dialogue: 0,0:04:07.58,0:04:09.41,Default,,0,0,0,,Ол мені өлтіреді!
Dialogue: 0,0:04:09.49,0:04:12.83,Default,,0,0,0,,Бұл қорқынышты, Йоко-сан! Йоко-сан!
Dialogue: 0,0:04:12.91,0:04:14.79,Default,,0,0,0,,Мен доңғалақ жарып алайын деп жатырмын (Йоко) Жоқ, жоқ.
Dialogue: 0,0:04:14.87,0:04:18.34,Default,,0,0,0,,Бұл... Люс, сен ояусың.
Dialogue: 0,0:04:18.42,0:04:19.55,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:04:19.63,0:04:22.72,Default,,0,0,0,,Олай болса, екі адам бір уақытта...
Dialogue: 0,0:04:23.55,0:04:25.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:25.89,0:04:27.43,Default,,0,0,0,,Йоко-сан!
Dialogue: 0,0:04:28.01,0:04:29.93,Default,,0,0,0,,О... жоқ!
Dialogue: 0,0:04:30.01,0:04:32.39,Default,,0,0,0,,Люсе-кунның еркі мен мөрі тиімдірек.
Dialogue: 0,0:04:32.48,0:04:34.89,Default,,0,0,0,,Ол Дарк Шнайдерден күшті.
Dialogue: 0,0:04:34.98,0:04:39.32,Default,,0,0,0,,Ха... хаха! Бұл қорқытады
Dialogue: 0,0:04:39.40,0:04:43.40,Default,,0,0,0,,Бірақ қазір шықсаң да, бәрі кеш!
Dialogue: 0,0:04:44.20,0:04:44.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:44.82,0:04:47.20,Default,,0,0,0,,Шин Харидің қанын сорсаң
Dialogue: 0,0:04:47.28,0:04:49.87,Default,,0,0,0,,Менің күшім одан әрі еселенеді!
Dialogue: 0,0:04:49.95,0:04:50.62,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:50.70,0:04:54.33,Default,,0,0,0,,Дирк Шнайдер сияқты қорқатын ештеңе жоқ!
Dialogue: 0,0:04:54.41,0:04:55.67,Default,,0,0,0,,Ха! Жоқ!
Dialogue: 0,0:04:55.75,0:04:57.38,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:04:57.46,0:04:58.92,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:59.79,0:05:00.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:00.88,0:05:02.88,Default,,0,0,0,,Қарғыс атсын, шайтан!
Dialogue: 0,0:05:02.96,0:05:05.84,Default,,0,0,0,,Егер сіз бұл адаммен аралассаңыз, мен құптамаймын!
Dialogue: 0,0:05:05.93,0:05:07.05,Default,,0,0,0,,Е...
Dialogue: 0,0:05:07.14,0:05:12.31,Default,,0,0,0,,Гугугу~ Сен брат~!
Dialogue: 0,0:05:12.39,0:05:16.52,Default,,0,0,0,,Жаңа ғана асыл мырзаның бетінен теуіп алдың!
Dialogue: 0,0:05:16.60,0:05:17.69,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:05:17.77,0:05:20.82,Default,,0,0,0,,Эй, шық!
Dialogue: 0,0:05:20.90,0:05:22.73,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:24.49,0:05:25.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:27.16,0:05:31.28,Default,,0,0,0,,Бізге қазір сіздің көмегіңіз керек!
Dialogue: 0,0:05:31.37,0:05:32.54,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:05:33.62,0:05:36.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:36.16,0:05:39.88,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:05:41.92,0:05:46.30,Default,,0,0,0,,Шыу!
Dialogue: 0,0:05:46.38,0:05:47.26,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:05:47.34,0:05:49.97,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:50.05,0:05:52.72,Default,,0,0,0,,Ей, сен сондай ақымақсың!
Dialogue: 0,0:05:52.81,0:05:54.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:55.73,0:05:56.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:00.15,0:06:02.27,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:06:02.36,0:06:04.23,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:06:04.32,0:06:07.49,Default,,0,0,0,,Сонда сіз мөрді өз бетіңізше сындырдыңыз ба?
Dialogue: 0,0:06:07.57,0:06:10.11,Default,,0,0,0,,Да... Дирк Шнайдер?
Dialogue: 0,0:06:10.20,0:06:11.87,Default,,0,0,0,,Люс...
Dialogue: 0,0:06:11.95,0:06:13.58,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:06:13.66,0:06:15.66,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:06:15.75,0:06:18.00,Default,,0,0,0,,Ежелгі Ұлы Сиқыршы
Dialogue: 0,0:06:18.08,0:06:21.79,Default,,0,0,0,,Қараңғылықтың шегінде орналасқан, өлім мен жойылуды басқарады.
Dialogue: 0,0:06:21.88,0:06:23.80,Default,,0,0,0,,Оның сиқырлы күші шексіз!
Dialogue: 0,0:06:23.88,0:06:27.63,Default,,0,0,0,,Әй, анау себеттегі бала бірден...
Dialogue: 0,0:06:27.72,0:06:31.09,Default,,0,0,0,,Міне... бұл тіпті аңызға айналған шайтан.
Dialogue: 0,0:06:31.18,0:06:32.60,Default,,0,0,0,,Дирк Шнайдер!
Dialogue: 0,0:06:32.68,0:06:34.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:36.02,0:06:38.68,Default,,0,0,0,,Күрсін... Не деген сұмдық айла!
Dialogue: 0,0:06:38.77,0:06:42.94,Default,,0,0,0,,Әй, мен ешкімнің мұндай жауыз көрінгенін көрген емеспін! Эй!
Dialogue: 0,0:06:43.02,0:06:46.78,Default,,0,0,0,,Ондай жігіттің мінезі сұмдық бұзылған болуы керек!
Dialogue: 0,0:06:46.86,0:06:48.15,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:06:48.24,0:06:50.74,Default,,0,0,0,,Менің сүйкімді қыздарыма
Dialogue: 0,0:06:50.82,0:06:52.41,Default,,0,0,0,,Жаңа ғана қолыңызды қойдыңыз ба?
Dialogue: 0,0:06:52.49,0:06:55.37,Default,,0,0,0,,Йоко-санды тепкілейді деп ойлау...
Dialogue: 0,0:06:55.45,0:06:57.37,Default,,0,0,0,,Бұл әйел кім?
Dialogue: 0,0:06:57.45,0:07:00.87,Default,,0,0,0,,Ол болашақта менің баламды дүниеге әкелетін маңызды әйел!
Dialogue: 0,0:07:00.96,0:07:02.21,Default,,0,0,0,,Е...
Dialogue: 0,0:07:04.46,0:07:06.21,Default,,0,0,0,,Бакаяру
Dialogue: 0,0:07:06.30,0:07:10.43,Default,,0,0,0,,Мен сені жақсы ести алмадым Енді... Енді ше?
Dialogue: 0,0:07:10.51,0:07:11.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:11.59,0:07:14.51,Default,,0,0,0,,Ах! Кай!
Dialogue: 0,0:07:15.05,0:07:17.14,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:07:17.22,0:07:19.35,Default,,0,0,0,,Мен сені ұрып-соғамын!
Dialogue: 0,0:07:19.43,0:07:24.65,Default,,0,0,0,,Сиу есікті күту...
Dialogue: 0,0:07:24.73,0:07:27.28,Default,,0,0,0,,О! Бұл сиқыр ...
Dialogue: 0,0:07:27.36,0:07:30.28,Default,,0,0,0,,Өл, Сәру-суке!
Dialogue: 0,0:07:30.36,0:07:31.45,Default,,0,0,0,,Тәртіпсіздік!
Dialogue: 0,0:07:31.53,0:07:33.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:33.49,0:07:35.24,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:07:35.32,0:07:38.12,Default,,0,0,0,,Бұл сиқыр Балволттың жетілдірілген сиқыры!
Dialogue: 0,0:07:38.20,0:07:41.66,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:07:41.75,0:07:45.42,Default,,0,0,0,,Найзағай сиқыры салқындатуға ұқсас.
Dialogue: 0,0:07:45.50,0:07:49.30,Default,,0,0,0,,Сиқырға күшті қарсылық. Вампирлерде де жұмыс істейтін бірнеше заклинание.
Dialogue: 0,0:07:50.05,0:07:52.18,Default,,0,0,0,,Қорытынды болмаса да, бұл...
Dialogue: 0,0:07:52.76,0:07:54.51,Default,,0,0,0,,Ах! Граф...
Dialogue: 0,0:07:54.59,0:07:56.72,Default,,0,0,0,,Эрл!
Dialogue: 0,0:07:56.80,0:07:59.93,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:08:00.02,0:08:02.69,Default,,0,0,0,,Бұл Қараңғы Шнайдердің сиқыры ма?
Dialogue: 0,0:08:03.27,0:08:05.69,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:08:05.77,0:08:11.28,Default,,0,0,0,,Аты аңызға айналған жын деп санауға болатын адам осыншама күшке ие болады деп ешқашан ойламаппын!
Dialogue: 0,0:08:11.36,0:08:12.99,Default,,0,0,0,,Бұл мені таң қалдырды
Dialogue: 0,0:08:13.07,0:08:15.41,Default,,0,0,0,,Гехахаха!
Dialogue: 0,0:08:15.49,0:08:17.62,Default,,0,0,0,,Ах! Сол сияқты...
Dialogue: 0,0:08:17.70,0:08:18.70,Default,,0,0,0,,Хун
Dialogue: 0,0:08:18.78,0:08:19.95,Default,,0,0,0,,(Джотаро Куджо) Түс! (Абдул) Ау!
Dialogue: 0,0:08:20.04,0:08:22.96,Default,,0,0,0,,Сіз жеңе аласыз~ Осы арқылы
Dialogue: 0,0:08:23.04,0:08:25.88,Default,,0,0,0,,Дұрыс па, Джодо?
Dialogue: 0,0:08:25.96,0:08:26.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:27.00,0:08:28.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:28.84,0:08:31.01,Default,,0,0,0,,Сіз крестті де қабылдамайтын құбыжықсыз.
Dialogue: 0,0:08:31.09,0:08:33.13,Default,,0,0,0,,Сиқыр жұмыс істемейді!
Dialogue: 0,0:08:33.22,0:08:38.10,Default,,0,0,0,,Бірақ оның өлмейтін денесіне қылыш мүлде зиян тигізбейді...
Dialogue: 0,0:08:38.18,0:08:41.18,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:08:41.77,0:08:45.44,Default,,0,0,0,,Аспаз аспаз... Маған ұнамайды.
Dialogue: 0,0:08:45.52,0:08:48.27,Default,,0,0,0,,Адамға төмен қарау көзқарасы
Dialogue: 0,0:08:48.36,0:08:52.53,Default,,0,0,0,,Бұл көздер сізді жеңіске жетем деп ойлайды.
Dialogue: 0,0:08:52.61,0:08:57.28,Default,,0,0,0,,Сіз өзіңізді әлемдегі ең күштімін деп ойлайсыз ба?
Dialogue: 0,0:08:57.37,0:09:02.25,Default,,0,0,0,,Аа, дұрыс, мен бұл дүниедегі ең күштімін.
Dialogue: 0,0:09:02.33,0:09:04.41,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:09:04.50,0:09:07.21,Default,,0,0,0,,Сол қорқынышсыз мінез!
Dialogue: 0,0:09:07.29,0:09:09.17,Default,,0,0,0,,Бұл мен сияқты
Dialogue: 0,0:09:09.25,0:09:12.46,Default,,0,0,0,,Тек асылға лайық.
Dialogue: 0,0:09:12.55,0:09:15.05,Default,,0,0,0,,Қорқыныш дегеніміз не?
Dialogue: 0,0:09:15.13,0:09:19.43,Default,,0,0,0,,Менің ойымша, бұл туралы бір рет ойлану керек.
Dialogue: 0,0:09:19.51,0:09:21.39,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:09:21.47,0:09:24.23,Default,,0,0,0,,Тоқта, маймыл, мағынасыз!
Dialogue: 0,0:09:24.31,0:09:25.35,Default,,0,0,0,,Укякья!
Dialogue: 0,0:09:25.43,0:09:28.56,Default,,0,0,0,,Нағыз бабаның сиқырлы күшіне қара!
Dialogue: 0,0:09:29.65,0:09:33.11,Default,,0,0,0,,О, шықты! Дай-саманың өлімге әкелетін құпия техникасы!
Dialogue: 0,0:09:33.19,0:09:35.11,Default,,0,0,0,,Ассер Шин!
Dialogue: 0,0:09:35.99,0:09:37.28,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:42.29,0:09:43.91,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:44.00,0:09:48.00,Default,,0,0,0,,Ваховахо... Мен мұны жасадым Джодо!
Dialogue: 0,0:09:48.08,0:09:52.34,Default,,0,0,0,,Демон Дирк Шнайдер өз қолыммен!
Dialogue: 0,0:09:52.42,0:09:54.80,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:54.88,0:09:56.26,Default,,0,0,0,,Бұл жаңа топ па әлде бірдеңе ме?
Dialogue: 0,0:09:57.38,0:09:58.22,Default,,0,0,0,,Люс...
Dialogue: 0,0:09:58.30,0:10:01.80,Default,,0,0,0,,Граф күткендей, қандай керемет кері қайтару!
Dialogue: 0,0:10:01.89,0:10:05.60,Default,,0,0,0,,Қандай керемет, қандай керемет, Граф!
Dialogue: 0,0:10:05.68,0:10:08.69,Default,,0,0,0,,Біз де графқа пайдалы болуымыз керек!
Dialogue: 0,0:10:08.77,0:10:10.77,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:10:10.86,0:10:15.86,Default,,0,0,0,,Түсінемін, балалар, менің күшіме қызығасыңдар.
Dialogue: 0,0:10:15.94,0:10:17.40,Default,,0,0,0,,Мазасыз болмаңыз
Dialogue: 0,0:10:17.49,0:10:19.36,Default,,0,0,0,,Анау анау-мынау бәйбішелер
Dialogue: 0,0:10:19.45,0:10:23.03,Default,,0,0,0,,Тез мені тыйып, бітірейік!
Dialogue: 0,0:10:23.12,0:10:25.41,Default,,0,0,0,,Хаха! Сіз айтқандай
Dialogue: 0,0:10:26.41,0:10:29.29,Default,,0,0,0,,Хэ-хэ-хэ, тыныш жүр~
Dialogue: 0,0:10:29.37,0:10:33.75,Default,,0,0,0,,Бұл жолы мен сенің қаныңды графқа құрбандық ретінде сорғызамын.
Dialogue: 0,0:10:35.76,0:10:37.59,Default,,0,0,0,,Сиқырлы жұмбақ техникасы!
Dialogue: 0,0:10:38.22,0:10:40.09,Default,,0,0,0,,Рао қызыл биі!
Dialogue: 0,0:10:40.18,0:10:42.26,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:43.39,0:10:45.26,Default,,0,0,0,,(Полиция қызметкері) Бізді сатқанымен, олар біздің одақтастарымызға айналды деген сөз емес
Dialogue: 0,0:10:45.35,0:10:49.60,Default,,0,0,0,,Балалар, енді не істей аласыңдар?
Dialogue: 0,0:10:49.69,0:10:51.19,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:10:51.27,0:10:53.56,Default,,0,0,0,,Мен саған Кайға тиісуге рұқсат бермеймін!
Dialogue: 0,0:10:53.65,0:10:57.19,Default,,0,0,0,,Ха! Менің сенімді Дирк Шнайдер
Dialogue: 0,0:10:57.28,0:10:58.74,Default,,0,0,0,,Дәл осылай
Dialogue: 0,0:10:58.82,0:11:00.74,Default,,0,0,0,,Бұл жай ғана ет!
Dialogue: 0,0:11:00.82,0:11:02.28,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:02.37,0:11:04.74,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:11:04.83,0:11:06.95,Default,,0,0,0,,Духахаха!
Dialogue: 0,0:11:07.04,0:11:09.91,Default,,0,0,0,,Духахаха!
Dialogue: 0,0:11:10.00,0:11:12.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:12.38,0:11:14.04,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:11:14.13,0:11:15.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:15.21,0:11:16.42,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:11:16.50,0:11:20.22,Default,,0,0,0,,Бұл өте ақымақ! Бұл, әрине, жақсы жауап ...
Dialogue: 0,0:11:20.30,0:11:22.89,Default,,0,0,0,,Сәлем Сәлем Қорқынышты...
Dialogue: 0,0:11:23.43,0:11:27.18,Default,,0,0,0,,Га, Граф-сама~
Dialogue: 0,0:11:27.26,0:11:29.68,Default,,0,0,0,,Джодо?
Dialogue: 0,0:11:29.77,0:11:33.52,Default,,0,0,0,,Ахахха! Сегізаяқ па?
Dialogue: 0,0:11:33.60,0:11:37.07,Default,,0,0,0,,Менің мотор орталығым бұрын электр тогының соғуынан уақытша зақымдалған болса да.
Dialogue: 0,0:11:37.15,0:11:38.69,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:11:38.78,0:11:41.40,Default,,0,0,0,,Осы сәтте сиқырлы күшті дұрыс бағытта жіберу мүмкін емес.
Dialogue: 0,0:11:41.49,0:11:42.66,Default,,0,0,0,,Менің қолымнан келмейді!
Dialogue: 0,0:11:42.74,0:11:44.32,Default,,0,0,0,,Нунуну...
Dialogue: 0,0:11:44.41,0:11:48.12,Default,,0,0,0,,Сіз мырзаны мазақ етесіз!
Dialogue: 0,0:11:48.20,0:11:50.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:50.33,0:11:53.62,Default,,0,0,0,,Ухаха... Не болды, граф? Жер шығып жатыр!
Dialogue: 0,0:11:53.71,0:11:56.54,Default,,0,0,0,,Сіз дөрекі адамсыз ба? сурет?
Dialogue: 0,0:11:56.63,0:12:00.55,Default,,0,0,0,,Менің бағыт-бағдарымды сезінуім аздап ауытқиды, сонда ше?
Dialogue: 0,0:12:00.63,0:12:03.13,Default,,0,0,0,,Ақымақ! Бұл туралы ше?
Dialogue: 0,0:12:03.22,0:12:05.26,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:12:05.34,0:12:09.22,Default,,0,0,0,,Дай Амон! Үлкен слалом өлтірушілер сахнасы!
Dialogue: 0,0:12:10.47,0:12:11.73,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:12:11.81,0:12:14.44,Default,,0,0,0,,Эрл! Тоқта... тоқта... аа!
Dialogue: 0,0:12:14.94,0:12:16.40,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:12:16.48,0:12:21.15,Default,,0,0,0,,Менің жан-жақты таралатын сиқырлы күшімнен құтыла аласың ба?
Dialogue: 0,0:12:21.24,0:12:22.49,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:12:22.57,0:12:26.95,Default,,0,0,0,,Адам күресіндегі жалғыз тұрақты заң
Dialogue: 0,0:12:27.03,0:12:30.91,Default,,0,0,0,,Бұл... мачо адам мүлдем
Dialogue: 0,0:12:31.00,0:12:34.83,Default,,0,0,0,,Әйелдермен жақсы араласатын, ақылды, ақылды және әдемі кейіпкер.
Dialogue: 0,0:12:34.92,0:12:36.92,Default,,0,0,0,,Бұл сіздің жеңе алмайтыныңызды білдіреді!
Dialogue: 0,0:12:37.00,0:12:41.76,Default,,0,0,0,,Сіздің өліміңіз осы бетпен келген кезде шешілді.
Dialogue: 0,0:12:41.84,0:12:43.72,Default,,0,0,0,,Гах! ауызыңды жап!
Dialogue: 0,0:12:43.80,0:12:46.89,Default,,0,0,0,,Мен әдемімін!
Dialogue: 0,0:12:50.18,0:12:50.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:51.72,0:12:52.39,Default,,0,0,0,,Не?
Dialogue: 0,0:12:55.60,0:12:56.90,Default,,0,0,0,,Мен оны қайтарамын
Dialogue: 0,0:12:56.98,0:12:58.81,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:12:58.90,0:13:01.40,Default,,0,0,0,,Менің сиқырлы күшімді алу деген нені білдіреді?
Dialogue: 0,0:13:01.48,0:13:04.11,Default,,0,0,0,,Бабаба... сен құбыжық!
Dialogue: 0,0:13:04.20,0:13:05.45,Default,,0,0,0,,Құбыжық –
Dialogue: 0,0:13:07.11,0:13:08.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:09.33,0:13:10.62,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,0:13:11.66,0:13:12.83,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:12.91,0:13:15.16,Default,,0,0,0,,Хахаха... Ақымақ!
Dialogue: 0,0:13:15.25,0:13:17.58,Default,,0,0,0,,Сіз қайда көздеп отырсыз?
Dialogue: 0,0:13:17.67,0:13:18.54,Default,,0,0,0,,О!
Dialogue: 0,0:13:18.63,0:13:19.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:19.67,0:13:20.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:20.75,0:13:25.05,Default,,0,0,0,,Ахх!
Dialogue: 0,0:13:30.51,0:13:32.01,Default,,0,0,0,,Ақымақ жігіт...
Dialogue: 0,0:13:32.72,0:13:35.35,Default,,0,0,0,,Маған қорқыныш сыйлай алатын адам
Dialogue: 0,0:13:35.43,0:13:38.19,Default,,0,0,0,,Артында немесе алдында бір ғана адам бар.
Dialogue: 0,0:13:42.86,0:13:43.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:53.08,0:13:55.96,Default,,0,0,0,,бұл... күлге айналуда...
Dialogue: 0,0:14:03.84,0:14:06.09,Default,,0,0,0,,Ах... Ах... Хаку...
Dialogue: 0,0:14:06.17,0:14:08.72,Default,,0,0,0,,Граф күлге айналды!
Dialogue: 0,0:14:11.05,0:14:12.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:12.47,0:14:15.02,Default,,0,0,0,,Дай Амон... Мен вампирді жеңдім.
Dialogue: 0,0:14:15.10,0:14:16.10,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:14:16.81,0:14:18.94,Default,,0,0,0,,Жоқ, әлі жоқ. Мынаны қара.
Dialogue: 0,0:14:19.02,0:14:19.73,Default,,0,0,0,,Агия
Dialogue: 0,0:14:19.81,0:14:21.81,Default,,0,0,0,,Аға, неге әрдайым кешірім сұрайсың?
Dialogue: 0,0:14:22.69,0:14:24.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:24.11,0:14:25.78,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:14:25.86,0:14:29.86,Default,,0,0,0,,Вампирдің денесі өлместікке өте жақын.
Dialogue: 0,0:14:29.95,0:14:32.74,Default,,0,0,0,,Дирк Шнайдерді ұмытпаңыз!
Dialogue: 0,0:14:32.83,0:14:35.54,Default,,0,0,0,,Мұқаба! Граф өмірге келді ме?
Dialogue: 0,0:14:35.62,0:14:37.00,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:37.08,0:14:39.62,Default,,0,0,0,,Аа, бұл Алып жарғанат.
Dialogue: 0,0:14:39.71,0:14:41.29,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:14:41.38,0:14:45.05,Default,,0,0,0,,Мен асылмын! Мен жеңушімін!
Dialogue: 0,0:14:45.13,0:14:47.72,Default,,0,0,0,,Мен билеушімін!
Dialogue: 0,0:14:47.80,0:14:50.51,Default,,0,0,0,,Менің атым граф Дай Амон!
Dialogue: 0,0:14:50.59,0:14:52.60,Default,,0,0,0,,Нохохохохо…
Dialogue: 0,0:14:53.80,0:14:55.10,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:14:55.18,0:14:58.06,Default,,0,0,0,,Менің қайда екенімді білмейсің ғой?
Dialogue: 0,0:14:58.14,0:15:00.35,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:15:00.44,0:15:02.19,Default,,0,0,0,,Қайдасың, граф?
Dialogue: 0,0:15:02.27,0:15:04.32,Default,,0,0,0,,А, өтінемін, өзіңді көрсет!
Dialogue: 0,0:15:04.40,0:15:05.69,Default,,0,0,0,,Менде ештеңе жоқ!
Dialogue: 0,0:15:05.77,0:15:08.57,Default,,0,0,0,,Дай-саманың дауысы жер бетінде қайдан шығады?
Dialogue: 0,0:15:08.65,0:15:11.61,Default,,0,0,0,,Яғни, қарапайым есептеу бойынша да ол тек екі минуттан кейін ғана пайда болуы тиіс еді.
Dialogue: 0,0:15:11.70,0:15:15.91,Default,,0,0,0,,Уау! Сіз қайдан білдіңіз?
Dialogue: 0,0:15:15.99,0:15:20.62,Default,,0,0,0,,Мен мұндай оғаш жарғанатты бұрын-соңды көрген емеспін, солай ма?
Dialogue: 0,0:15:21.62,0:15:22.92,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:15:23.00,0:15:25.42,Default,,0,0,0,,Не істеу керек? Уф
Dialogue: 0,0:15:25.50,0:15:29.55,Default,,0,0,0,,Вампирлер күн сәулесінің әсерінен күлге айналады.
Dialogue: 0,0:15:29.63,0:15:33.89,Default,,0,0,0,,Бірақ күлден рух жарқанат тәрізді көрінеді.
Dialogue: 0,0:15:33.97,0:15:37.60,Default,,0,0,0,,Өз табытына қайта ұшқан жарқанат жердің рухтарын сорып алды.
Dialogue: 0,0:15:37.68,0:15:41.98,Default,,0,0,0,,Шамамен 2 күнде толық вампирге айналады
Dialogue: 0,0:15:42.06,0:15:43.31,Default,,0,0,0,,Бұл
Dialogue: 0,0:15:43.40,0:15:44.27,Default,,0,0,0,,Уф
Dialogue: 0,0:15:44.77,0:15:48.23,Default,,0,0,0,,Арх! Мені өлтіресің бе? өлтіру?
Dialogue: 0,0:15:48.32,0:15:50.28,Default,,0,0,0,,Мені өлтіресіз бе?
Dialogue: 0,0:15:50.36,0:15:54.24,Default,,0,0,0,,Хехехехе мен сенің қабығыңмен сиқырлаймын.
Dialogue: 0,0:15:54.32,0:15:57.99,Default,,0,0,0,,Катализатор сіздің денеңіздің бір бөлігі ғана.
Dialogue: 0,0:15:58.08,0:16:01.04,Default,,0,0,0,,Сіз вампир болсаңыз да, оны міндетті түрде аласыз.
Dialogue: 0,0:16:01.12,0:16:03.17,Default,,0,0,0,,Сәлем! Эй, эй
Dialogue: 0,0:16:03.25,0:16:07.21,Default,,0,0,0,,Бұл жігіт баяғыда меннен жеңілген жау.
Dialogue: 0,0:16:07.29,0:16:10.63,Default,,0,0,0,,Ол абсолютті мойынсұнуға мәжбүрлеу үшін жиі қолданылған.
Dialogue: 0,0:16:10.71,0:16:14.09,Default,,0,0,0,,Бұл өте зұлым ежелгі қарғыс.
Dialogue: 0,0:16:14.18,0:16:15.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:15.39,0:16:18.56,Default,,0,0,0,,Тоқта, тоқта, мұны істе!
Dialogue: 0,0:16:18.64,0:16:22.39,Default,,0,0,0,,Дай Амон, сен өлтіруге тым жақсысың.
Dialogue: 0,0:16:22.48,0:16:27.48,Default,,0,0,0,,Ол зұлым, қатал, мақтаншақ, қатыгез және көңілді.
Dialogue: 0,0:16:27.56,0:16:29.53,Default,,0,0,0,,Өз өміріңізді немесе өліміңізді таңдаңыз.
Dialogue: 0,0:16:29.61,0:16:31.44,Default,,0,0,0,,Мен саған мүмкіндік беремін
Dialogue: 0,0:16:31.53,0:16:34.74,Default,,0,0,0,,...
Dialogue: 0,0:16:34.82,0:16:37.49,Default,,0,0,0,,Жарқанаттың қанатынан кел, Түн патшасы жындар
Dialogue: 0,0:16:37.57,0:16:41.50,Default,,0,0,0,,Менің тырнақтарымда тұрып, келісім-шарттың күші бол.
Dialogue: 0,0:16:43.21,0:16:44.87,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:16:44.96,0:16:48.34,Default,,0,0,0,,Бұл көк тырнақтар сиқырмен бірге сіздің денеңізге кіреді.
Dialogue: 0,0:16:48.42,0:16:50.59,Default,,0,0,0,,Өзіңіздің бір бөлігіңіз болыңыз
Dialogue: 0,0:16:50.67,0:16:53.63,Default,,0,0,0,,Маған бағынудан бас тартқанда
Dialogue: 0,0:16:53.72,0:16:56.34,Default,,0,0,0,,Мен бұл тырнақты тағы кеспек болғанымда
Dialogue: 0,0:16:56.43,0:17:00.06,Default,,0,0,0,,Бұл түс көктен күлгінге қызылға өзгереді.
Dialogue: 0,0:17:00.14,0:17:04.02,Default,,0,0,0,,Бұл тырнақтар қою қызылға айналғанда, бұл сіздің соңғы болады!
Dialogue: 0,0:17:04.10,0:17:06.56,Default,,0,0,0,,Бес денені бөлшектеп тастады.
Dialogue: 0,0:17:06.65,0:17:11.03,Default,,0,0,0,,Ешқашан қайта қалпына келмейтіндей етіп басқа жаратылысқа айналдырылды
Dialogue: 0,0:17:11.11,0:17:11.82,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:11.90,0:17:15.61,Default,,0,0,0,,Ақыл-парасаты жоқ дәрменсіз бақа бол!
Dialogue: 0,0:17:15.70,0:17:16.86,Default,,0,0,0,,Құдай-ай! «Енді бұдан әрі бәрі дәл болжағандай қалай болатынына таңғаламын!»
Dialogue: 0,0:17:16.95,0:17:19.45,Default,,0,0,0,,Кя! Жоқ, тоқтат!
Dialogue: 0,0:17:19.53,0:17:21.33,Default,,0,0,0,,Адамдарға мейірімділік танытса!
Dialogue: 0,0:17:21.41,0:17:24.54,Default,,0,0,0,,Эй, олай істеме!
Dialogue: 0,0:17:24.62,0:17:26.17,Default,,0,0,0,,Айыпталушы!
Dialogue: 0,0:17:26.25,0:17:27.12,Default,,0,0,0,,Гекко
Dialogue: 0,0:17:27.67,0:17:31.25,Default,,0,0,0,,Хагия~!
Dialogue: 0,0:17:31.34,0:17:33.34,Default,,0,0,0,,Ммм, жиіркенішті...
Dialogue: 0,0:17:33.42,0:17:34.55,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:17:34.63,0:17:36.72,Default,,0,0,0,,Анашым! Анашым!
Dialogue: 0,0:17:36.80,0:17:38.43,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:17:38.51,0:17:40.68,Default,,0,0,0,,Жақсы~ Бұл жоғары дауыс!
Dialogue: 0,0:17:40.76,0:17:42.01,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:17:42.10,0:17:44.77,Default,,0,0,0,,Жүр, қаттырақ жыла! а?
Dialogue: 0,0:17:44.85,0:17:47.60,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:17:47.69,0:17:49.44,Default,,0,0,0,,Вахаха…
Dialogue: 0,0:17:49.52,0:17:51.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:51.65,0:17:53.57,Default,,0,0,0,,Қорқынышты, қорқынышты!
Dialogue: 0,0:17:53.65,0:17:55.82,Default,,0,0,0,,Бұл адам шынымен қорқынышты!
Dialogue: 0,0:17:55.90,0:17:57.15,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:17:57.24,0:18:00.66,Default,,0,0,0,,Егер сіз мені аздап болса да қорғап қалсаңыз...
Dialogue: 0,0:18:00.74,0:18:02.70,Default,,0,0,0,,Бұл бақа!
Dialogue: 0,0:18:03.20,0:18:06.29,Default,,0,0,0,,Әй, шайтан! Қандай қатыгез адам!
Dialogue: 0,0:18:06.37,0:18:09.08,Default,,0,0,0,,Қаш! Сіз өлтіресіз!
Dialogue: 0,0:18:09.17,0:18:11.09,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:18:12.17,0:18:13.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:13.55,0:18:15.84,Default,,0,0,0,,Бұл көп күш жұмсады.
Dialogue: 0,0:18:15.92,0:18:18.26,Default,,0,0,0,,Бұл әзірге шешілді.
Dialogue: 0,0:18:21.26,0:18:23.72,Default,,0,0,0,,Да Дирк Шнайдер!
Dialogue: 0,0:18:23.81,0:18:24.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:25.77,0:18:28.85,Default,,0,0,0,,Кай Кай... Кай...
Dialogue: 0,0:18:28.94,0:18:33.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:35.73,0:18:38.65,Default,,0,0,0,,Ах, бұл жақсы.
Dialogue: 0,0:18:38.74,0:18:43.08,Default,,0,0,0,,Егер сіз оны ертең ғибадатханада емдесеңіз, ол вампирге айналмайды.
Dialogue: 0,0:18:43.16,0:18:46.83,Default,,0,0,0,,Күлге жақын болғандықтан, оның төзімділігі зор.
Dialogue: 0,0:18:46.91,0:18:49.21,Default,,0,0,0,,Сізге жақсы...
Dialogue: 0,0:18:51.00,0:18:54.00,Default,,0,0,0,,Йоко-сан, мен саған қай жерден тепкеніңді көрсетейін.
Dialogue: 0,0:18:54.09,0:18:56.46,Default,,0,0,0,,Не? Жарайды
Dialogue: 0,0:18:56.55,0:18:58.51,Default,,0,0,0,,Қансырап жатқандықтан, солай емес пе?
Dialogue: 0,0:18:58.59,0:18:59.97,Default,,0,0,0,,А... А?
Dialogue: 0,0:19:00.76,0:19:02.01,Default,,0,0,0,,Ой! Апыр-ай!
Dialogue: 0,0:19:02.09,0:19:03.89,Default,,0,0,0,,Ах... міне!
Dialogue: 0,0:19:03.97,0:19:06.68,Default,,0,0,0,,Жоқ, тоқтат! Ах...
Dialogue: 0,0:19:06.77,0:19:09.23,Default,,0,0,0,,Қараңдар! Егер сіз оны жылжытсаңыз, ол бұралып қалады ...
Dialogue: 0,0:19:09.31,0:19:11.10,Default,,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:19:11.19,0:19:13.31,Default,,0,0,0,,Өтінемін! Ия тоқта...
Dialogue: 0,0:19:13.40,0:19:15.02,Default,,0,0,0,,Е...
Dialogue: 0,0:19:15.11,0:19:17.07,Default,,0,0,0,,Ааа! (Дирк Шнайдер) Онда...
Dialogue: 0,0:19:17.15,0:19:18.49,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:19:18.99,0:19:21.70,Default,,0,0,0,,Мм... ол адам кім?
Dialogue: 0,0:19:21.78,0:19:24.62,Default,,0,0,0,,Иә? Бұл Йоко ма?
Dialogue: 0,0:19:25.12,0:19:26.87,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:26.95,0:19:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.16,0:19:31.67,Default,,0,0,0,,Йоко-сан болашақта менің баламды дүниеге әкелетін әйел!
Dialogue: 0,0:19:31.75,0:19:33.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:35.13,0:19:36.50,Default,,0,0,0,,Мені қате түсінбеңіз!
Dialogue: 0,0:19:36.59,0:19:38.59,Default,,0,0,0,,Бұл жігіт мен үшін ештеңе емес!
Dialogue: 0,0:19:39.13,0:19:40.47,Default,,0,0,0,,Жай ғана дос
Dialogue: 0,0:19:40.55,0:19:43.43,Default,,0,0,0,,Е... неге! Солай ма?
Dialogue: 0,0:19:43.51,0:19:45.01,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:19:45.10,0:19:47.39,Default,,0,0,0,,Тым шулы болмаңыз! Бұл дұрыс!
Dialogue: 0,0:19:47.47,0:19:49.43,Default,,0,0,0,,Әңгіме саған келгенде болмаса, Люс!
Dialogue: 0,0:19:49.52,0:19:51.48,Default,,0,0,0,,Неге?
Dialogue: 0,0:19:51.56,0:19:53.94,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,0:19:54.02,0:19:57.44,Default,,0,0,0,,Сол түні мені кім сүйкімді деп атады?
Dialogue: 0,0:19:57.52,0:20:00.03,Default,,0,0,0,,Мені төсекте ұстауға не себеп болды?
Dialogue: 0,0:20:00.11,0:20:01.99,Default,,0,0,0,,Ха! (Көрініс) Бұл жай ғана көңіл көтеру үшін болды ма?
Dialogue: 0,0:20:02.07,0:20:05.20,Default,,0,0,0,,Неліктен? Оны орнатқан сол ғой, солай ма?
Dialogue: 0,0:20:05.28,0:20:07.58,Default,,0,0,0,,Келген адамға бас тартпаймын деген ұстанымым бар.
Dialogue: 0,0:20:07.66,0:20:10.16,Default,,0,0,0,,Ақыр аяғына дейін жеткен жоқпын.
Dialogue: 0,0:20:10.25,0:20:11.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:20:12.04,0:20:13.17,Default,,0,0,0,,(шапалақ дыбысы)
Dialogue: 0,0:20:13.71,0:20:18.50,Default,,0,0,0,,Осы уақытқа дейін не істеп жүргеніңді білмеймін, бірақ оны салқын айта алмайсың.
Dialogue: 0,0:20:18.59,0:20:19.76,Default,,0,0,0,,Көп емес!
Dialogue: 0,0:20:21.09,0:20:23.09,Default,,0,0,0,,Уф, ауырып тұр
Dialogue: 0,0:20:27.10,0:20:28.39,Default,,0,0,0,,Жын семсер!
Dialogue: 0,0:20:28.93,0:20:31.06,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:31.14,0:20:34.56,Default,,0,0,0,,Вахахаха... Әй, қой!
Dialogue: 0,0:20:34.65,0:20:37.02,Default,,0,0,0,,Бұл Гала-сама сізді кесіп тастайды!
Dialogue: 0,0:20:37.11,0:20:39.69,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:42.49,0:20:43.82,Default,,0,0,0,,Бар!
Dialogue: 0,0:20:43.90,0:20:48.53,Default,,0,0,0,,Ең жоғары шабуыл күшімен мақтана алатын көтерілісшілер тобының элитасы бірге соғысып жатыр.
Dialogue: 0,0:20:48.62,0:20:50.33,Default,,0,0,0,,Мен тісімде тұрған сияқтымын!
Dialogue: 0,0:20:50.41,0:20:51.66,Default,,0,0,0,,Камо-сан, әлі тірісің бе?
Dialogue: 0,0:20:51.75,0:20:53.33,Default,,0,0,0,,Ей, жасырма!
Dialogue: 0,0:20:53.41,0:20:54.67,Default,,0,0,0,,(Медбике) Каори-чан, дайынсың ба?
Dialogue: 0,0:20:54.75,0:20:56.96,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:21:00.92,0:21:02.84,Default,,0,0,0,,Мен бейбақпын...
Dialogue: 0,0:21:02.92,0:21:05.30,Default,,0,0,0,,Қандай арсыздық!
Dialogue: 0,0:21:05.38,0:21:07.47,Default,,0,0,0,,Өйткені ол алаңсыз адам.
Dialogue: 0,0:21:07.55,0:21:09.68,Default,,0,0,0,,Мен оны бәрібір реттеймін.
Dialogue: 0,0:21:10.18,0:21:12.39,Default,,0,0,0,,Барлық Кидо Санниншу
Dialogue: 0,0:21:12.47,0:21:14.85,Default,,0,0,0,,Мен оны Дирк Шнайдер бұзғанын естідім.
Dialogue: 0,0:21:14.94,0:21:16.27,Default,,0,0,0,,Күл Ней
Dialogue: 0,0:21:16.35,0:21:18.61,Default,,0,0,0,,Және олардың үшеуі де.
Dialogue: 0,0:21:18.69,0:21:22.48,Default,,0,0,0,,Қараңғы Шнайдердің қанатының астына қалай сыйды...
Dialogue: 0,0:21:22.57,0:21:26.28,Default,,0,0,0,,Енді сатқындар болмайды деп үміттенемін...
Dialogue: 0,0:21:26.36,0:21:28.57,Default,,0,0,0,,Сіз нені айтып тұрсыз, Абигейл?
Dialogue: 0,0:21:28.66,0:21:30.66,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:21:30.74,0:21:33.62,Default,,0,0,0,,Сатқындар көп болса
Dialogue: 0,0:21:33.70,0:21:35.79,Default,,0,0,0,,Дирк Шнайдер көтерген
Dialogue: 0,0:21:35.87,0:21:40.38,Default,,0,0,0,,Менің ойымша, сен ең қауіптісісің.
Dialogue: 0,0:21:40.46,0:21:41.63,Default,,0,0,0,,Мені ақымақ деп айт!
Dialogue: 0,0:21:41.71,0:21:43.96,Default,,0,0,0,,Сіз маған күмәнданасыз ба?
Dialogue: 0,0:21:44.05,0:21:46.76,Default,,0,0,0,,Егер сіз көктегі Төрт Патшаның бірі болсаңыз да, арманы бірдей.
Dialogue: 0,0:21:46.84,0:21:47.88,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:21:47.97,0:21:49.22,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:49.80,0:21:52.22,Default,,0,0,0,,Енді міне, жарқанаттың қанаттары.
Dialogue: 0,0:21:52.76,0:21:54.77,Default,,0,0,0,,Ха! Бұл айыпталушы сиқыры ма?
Dialogue: 0,0:21:57.48,0:22:00.23,Default,,0,0,0,,Хехехехе... Эшет Ней!
Dialogue: 0,0:22:00.31,0:22:01.98,Default,,0,0,0,,Сіздің ұмтылыстарыңыз-
Dialogue: 0,0:22:02.07,0:22:04.90,Default,,0,0,0,,Осы Айыпталушымен оны дәлелдеуге батылым жетеді.
Dialogue: 0,0:22:04.99,0:22:06.90,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:22:06.99,0:22:09.16,Default,,0,0,0,,Қарғыс атсын... Жарайды!
Dialogue: 0,0:22:09.24,0:22:11.87,Default,,0,0,0,,Мен Дирк Шнайдердің асырап алған қызы емес екенімді білемін.
Dialogue: 0,0:22:11.95,0:22:13.29,Default,,0,0,0,,Дәлелдеңіз!
Dialogue: 0,0:22:13.87,0:22:15.25,Default,,0,0,0,,Иә
Dialogue: 0,0:22:23.17,0:22:24.50,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.54,0:23:46.55,Default,,0,0,0,,～♪
