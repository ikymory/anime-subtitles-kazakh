Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.92,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:14.97,0:00:17.60,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:17.68,0:00:21.02,Default,,0,0,0,,Ах! Дарш…
Dialogue: 0,0:00:22.06,0:00:24.14,Default,,0,0,0,,Ауырды ма, Эше?
Dialogue: 0,0:00:25.44,0:00:27.40,Default,,0,0,0,,Мен сені қазір босатамын.
Dialogue: 0,0:00:30.53,0:00:34.24,Default,,0,0,0,,Бля!
Dialogue: 0,0:00:34.82,0:00:38.41,Default,,0,0,0,,Ооо!
Dialogue: 0,0:00:39.49,0:00:41.49,Default,,0,0,0,,(Рей) Уу-хуу! (Эмма) Уау!
Dialogue: 0,0:00:47.50,0:00:49.21,Default,,0,0,0,,♪～
Dialogue: 0,0:02:14.92,0:02:16.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:25.60,0:02:27.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:28.69,0:02:31.60,Default,,0,0,0,,(ыңылдау)
Dialogue: 0,0:02:31.69,0:02:34.27,Default,,0,0,0,,О! Бұл не?
Dialogue: 0,0:02:34.36,0:02:36.44,Default,,0,0,0,,Ежелгі зұлым рухтар...
Dialogue: 0,0:02:36.53,0:02:37.82,Default,,0,0,0,,Күл Ней
Dialogue: 0,0:02:37.90,0:02:41.87,Default,,0,0,0,,Ол біреудің күшті қарғысымен байланысты болды ма?
Dialogue: 0,0:02:41.95,0:02:44.49,Default,,0,0,0,,Олай болса, Дирк Шнайдер...
Dialogue: 0,0:02:45.16,0:02:49.33,Default,,0,0,0,,Нейдің қарғысын сындыру үшін мен жүрегімді бердім.
Dialogue: 0,0:02:49.83,0:02:52.25,Default,,0,0,0,,Қарғыс атсын, ақымақ
Dialogue: 0,0:02:52.75,0:02:54.46,Default,,0,0,0,,Мына жігіт ше...
Dialogue: 0,0:02:54.54,0:02:57.34,Default,,0,0,0,,Әділдік батыры болмасам да
Dialogue: 0,0:03:00.93,0:03:02.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:03.39,0:03:04.22,Default,,0,0,0,,Дарш
Dialogue: 0,0:03:07.27,0:03:08.56,Default,,0,0,0,,Дарш…
Dialogue: 0,0:03:14.94,0:03:15.82,Default,,0,0,0,,Дарш!
Dialogue: 0,0:03:25.95,0:03:27.33,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:27.41,0:03:31.12,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,0:03:39.55,0:03:44.05,Default,,0,0,0,,Соңында болжау бейнесіндегідей болып шықты.
Dialogue: 0,0:03:49.60,0:03:51.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.31,0:03:54.56,Default,,0,0,0,,Лу... а
Dialogue: 0,0:03:55.40,0:03:56.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:56.11,0:03:57.19,Default,,0,0,0,,Агия агья!
Dialogue: 0,0:03:57.27,0:03:58.32,Default,,0,0,0,,Неге...
Dialogue: 0,0:03:59.44,0:04:01.57,Default,,0,0,0,,Неге осындай болды…
Dialogue: 0,0:04:03.03,0:04:04.99,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:04:05.07,0:04:06.24,Default,,0,0,0,,Мистер Люс...
Dialogue: 0,0:04:33.73,0:04:34.89,Default,,0,0,0,,Сен оны жеңдің бе?
Dialogue: 0,0:04:34.98,0:04:37.77,Default,,0,0,0,,Рақымсыз, мейірімсіз, айлакер, қатыгез
Dialogue: 0,0:04:37.86,0:04:41.07,Default,,0,0,0,,Қалағанына мықтының атын берген жын.
Dialogue: 0,0:04:41.15,0:04:45.91,Default,,0,0,0,,Бұл «жеңілмейтін аңыз» үшін біршама күтпеген аяқталу болды.
Dialogue: 0,0:04:45.99,0:04:47.87,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:04:47.95,0:04:51.54,Default,,0,0,0,,Махаббаттан адасып, үлкен суретті көрмей қалу нені білдіреді?
Dialogue: 0,0:04:51.62,0:04:53.20,Default,,0,0,0,,Бұл ойнақы өзгеріс сияқты.
Dialogue: 0,0:04:54.46,0:04:58.79,Default,,0,0,0,,Енді менде қорқатын ештеңе жоқ.
Dialogue: 0,0:04:58.88,0:05:01.38,Default,,0,0,0,,Нухахахаха!
Dialogue: 0,0:05:02.09,0:05:04.17,Default,,0,0,0,,Ұйықта, Дирк Шнайдер!
Dialogue: 0,0:05:04.26,0:05:05.76,Default,,0,0,0,,Мәңгі!
Dialogue: 0,0:05:05.84,0:05:09.68,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:05:10.51,0:05:12.43,Default,,0,0,0,,Уф, суық!
Dialogue: 0,0:05:12.52,0:05:14.48,Default,,0,0,0,,Мен Калус
Dialogue: 0,0:05:14.56,0:05:16.44,Default,,0,0,0,,Тіпті ескі текті төрт патша отбасының арасында
Dialogue: 0,0:05:16.52,0:05:18.60,Default,,0,0,0,,Яһуда патшалығынан кейінгі екінші әскери күшке ие
Dialogue: 0,0:05:18.69,0:05:22.03,Default,,0,0,0,,Менің Wytos Neiki-ді осы уақытқа дейін бұрышта ұстау үшін ...
Dialogue: 0,0:05:22.11,0:05:25.15,Default,,0,0,0,,Сәлем! Біздің әскер не істеп жатыр?
Dialogue: 0,0:05:25.24,0:05:27.78,Default,,0,0,0,,Әй, сөзіңізге рахмет, Қабадір ханзада.
Dialogue: 0,0:05:27.86,0:05:31.83,Default,,0,0,0,,Уау, біздің әскер бар күшімен жаумен шайқасып жатыр.
Dialogue: 0,0:05:31.91,0:05:34.95,Default,,0,0,0,,Тынш, бірақ бұл әдеттен тыс қарлы боранда
Dialogue: 0,0:05:35.04,0:05:37.17,Default,,0,0,0,,Қажетті стратегияны пайдалану мүмкін емес
Dialogue: 0,0:05:37.25,0:05:40.34,Default,,0,0,0,,Қазіргі уақытта 100 сиқыршыдан тұратын сиқырлы корпус бар.
Dialogue: 0,0:05:40.42,0:05:44.09,Default,,0,0,0,,Біз Калдың қатып қалу сиқырын жою үшін бар күшімізді саламыз.
Dialogue: 0,0:05:44.17,0:05:46.84,Default,,0,0,0,,Тіпті 100 адам бірігіп жұмыс істесе де
Dialogue: 0,0:05:46.92,0:05:49.30,Default,,0,0,0,,Қалға ешкім тең келе алмайды!
Dialogue: 0,0:05:49.39,0:05:53.31,Default,,0,0,0,,Фальскова Өлтір, қара бидайға мін
Dialogue: 0,0:05:53.39,0:05:55.89,Default,,0,0,0,,...
Dialogue: 0,0:05:55.98,0:05:59.02,Default,,0,0,0,,Қатқан жер, мұздықтар, қаһар!
Dialogue: 0,0:05:59.65,0:06:00.86,Default,,0,0,0,,...
Dialogue: 0,0:06:05.57,0:06:07.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:11.24,0:06:13.24,Default,,0,0,0,,Каль күткендей!
Dialogue: 0,0:06:13.33,0:06:17.04,Default,,0,0,0,,Бұл жойылу Құдайын қайта тірілту үшін қажет төрт мөрдің бірі.
Dialogue: 0,0:06:17.12,0:06:19.29,Default,,0,0,0,,Екіге дейін біздің қолымызда!
Dialogue: 0,0:06:19.37,0:06:21.33,Default,,0,0,0,,Қабадыр ханзада
Dialogue: 0,0:06:21.42,0:06:24.42,Default,,0,0,0,,Сіз әдемі ақ мұздықтың ішінде ұйықтай аласыз.
Dialogue: 0,0:06:24.50,0:06:26.76,Default,,0,0,0,,Сіз твит жазып жатырсыз
Dialogue: 0,0:06:26.84,0:06:30.51,Default,,0,0,0,,Абигейлдің толассыз көбейіп келе жатқан сыбайлас жемқорлық армиясына ұшырады.
Dialogue: 0,0:06:30.59,0:06:31.89,Default,,0,0,0,,Ол шіріп кетеді!
Dialogue: 0,0:06:31.97,0:06:34.68,Default,,0,0,0,,А-Иан-Мейде патшалығының қасіретін қарастыру.
Dialogue: 0,0:06:34.76,0:06:36.89,Default,,0,0,0,,Халық та, әскер де
Dialogue: 0,0:06:36.97,0:06:40.10,Default,,0,0,0,,Біреу бірдеңе істеуін өтінемін
Dialogue: 0,0:06:40.19,0:06:43.19,Default,,0,0,0,,Өлмегендердің әскері!
Dialogue: 0,0:06:43.27,0:06:44.07,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:06:44.15,0:06:46.28,Default,,0,0,0,,(ыңылдау)
Dialogue: 0,0:06:46.98,0:06:48.53,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:06:48.61,0:06:53.24,Default,,0,0,0,,Менің «жемқорлық армиясы» мен ештеңе жасамай-ақ жау елдерін жаулап алады.
Dialogue: 0,0:06:53.32,0:06:58.20,Default,,0,0,0,,Жаңа мәйіттермен ол одан да үлкен армияға айналады.
Dialogue: 0,0:06:58.29,0:06:58.96,Default,,0,0,0,,(ыңылдау)
Dialogue: 0,0:06:59.04,0:07:00.58,Default,,0,0,0,,Уау, біреу!
Dialogue: 0,0:07:00.67,0:07:01.50,Default,,0,0,0,,Патша!
Dialogue: 0,0:07:02.00,0:07:03.21,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:07:03.29,0:07:05.63,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:07:05.71,0:07:07.17,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:07:07.26,0:07:09.01,Default,,0,0,0,,Енді «мөрді» ұрлаңыз!
Dialogue: 0,0:07:09.51,0:07:13.47,Default,,0,0,0,,Яһуда! Уайт Нейги! A-Ian-Made!
Dialogue: 0,0:07:13.68,0:07:16.72,Default,,0,0,0,,Бұл жойылу құдайы Антрасакстың мөрі.
Dialogue: 0,0:07:16.81,0:07:20.52,Default,,0,0,0,,Мета-Ликанадан басқаның бәрі осында!
Dialogue: 0,0:07:21.19,0:07:22.90,Default,,0,0,0,,Жақында ол қайта тіріледі!
Dialogue: 0,0:07:22.98,0:07:28.11,Default,,0,0,0,,Біздің Жоюшы Құдайымыз Сібір жарасы жер бетінде тозақ жасайды!
Dialogue: 0,0:07:28.19,0:07:32.78,Default,,0,0,0,,Өлмеген, Металликанаға қарай жүр!
Dialogue: 0,0:07:32.86,0:07:34.87,Default,,0,0,0,,Шнайдер өлді!
Dialogue: 0,0:07:34.95,0:07:38.62,Default,,0,0,0,,Енді ешқандай кедергі жоқ.
Dialogue: 0,0:07:38.70,0:07:41.83,Default,,0,0,0,,У-у-хо-хо-хо!
Dialogue: 0,0:07:43.25,0:07:45.25,Default,,0,0,0,,Менің іш бұлшықеттерім жыртылып кеткен.
Dialogue: 0,0:07:47.96,0:07:49.17,Default,,0,0,0,,Эшет Нейге не болды?
Dialogue: 0,0:07:49.67,0:07:52.43,Default,,0,0,0,,дегеніміз... Содан бері 3 күн өтті.
Dialogue: 0,0:07:52.51,0:07:55.43,Default,,0,0,0,,Денені тастап кетуден бас тартты.
Dialogue: 0,0:07:55.51,0:07:59.93,Default,,0,0,0,,Қатты шаршағандықтан, қазір бөлек бөлмеде терең ұйқыда жатырмын.
Dialogue: 0,0:08:00.77,0:08:01.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:01.93,0:08:03.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:04.69,0:08:07.15,Default,,0,0,0,,Вайтос Нейки және А-Иан-Мейде
Dialogue: 0,0:08:07.23,0:08:09.61,Default,,0,0,0,,Қал мен Абигейлдің керемет сиқырлы күші алдында
Dialogue: 0,0:08:09.69,0:08:12.07,Default,,0,0,0,,Мен қамалдың құлағаны туралы хабар алдым.
Dialogue: 0,0:08:12.70,0:08:15.16,Default,,0,0,0,,Жақында біздің елге келеді.
Dialogue: 0,0:08:15.24,0:08:18.37,Default,,0,0,0,,Ал, бас діни қызметкер, әрі қарай жүрейік...
Dialogue: 0,0:08:19.16,0:08:23.83,Default,,0,0,0,,Хм, тек осы құлаған қамал мен аздаған әскер қалды.
Dialogue: 0,0:08:23.92,0:08:27.54,Default,,0,0,0,,Бүкіл әлемнің тағдыры үшін күресуге тура келді.
Dialogue: 0,0:08:29.96,0:08:30.96,Default,,0,0,0,,Люс...
Dialogue: 0,0:08:31.88,0:08:35.43,Default,,0,0,0,,Ақырында олар маған 500 иенді қайтармады.
Dialogue: 0,0:08:36.72,0:08:37.76,Default,,0,0,0,,№.
Dialogue: 0,0:08:47.61,0:08:49.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:52.24,0:08:55.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:08.71,0:09:10.25,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:09:10.88,0:09:14.97,Default,,0,0,0,,Мен соңғы 15 жыл бойы мұрагерді іздедім.
Dialogue: 0,0:09:15.68,0:09:19.76,Default,,0,0,0,,Адамзатты бұрын-соңды болмаған дағдарыстан құтқаратын аты аңызға айналған айдаһар жауынгері.
Dialogue: 0,0:09:19.85,0:09:22.10,Default,,0,0,0,,Айдаһар жауынгерінің мұрагері
Dialogue: 0,0:09:22.85,0:09:26.06,Default,,0,0,0,,Айдаһардың қабілеттеріне ие және шексіз сиқырлы күшке ие.
Dialogue: 0,0:09:26.14,0:09:29.56,Default,,0,0,0,,Абсолютті зұлымдыққа қарсы тұра алатын жалғыз жауынгер!
Dialogue: 0,0:09:30.11,0:09:34.11,Default,,0,0,0,,Оны мұрагер ету үшін ең қолайлы адам...
Dialogue: 0,0:09:34.19,0:09:37.86,Default,,0,0,0,,15 жыл бұрын Қараңғылық патшасы Айдаһар жауынгерімен шайқасты.
Dialogue: 0,0:09:37.95,0:09:39.99,Default,,0,0,0,,Бұл Дирк Шнайдер еді!
Dialogue: 0,0:09:40.07,0:09:43.20,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:09:44.79,0:09:45.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:45.91,0:09:47.79,Default,,0,0,0,,Агия! не?
Dialogue: 0,0:09:48.71,0:09:51.67,Default,,0,0,0,,Қараңғы Шнайдердің денесі өзгереді
Dialogue: 0,0:09:54.01,0:09:56.88,Default,,0,0,0,,Эй, бұл Люс Ренрен!
Dialogue: 0,0:09:59.18,0:10:00.60,Default,,0,0,0,,Дегенмен, бетіңіз көрсетілгеніне қарамастан, осындай бағдарламаға шығу үлкен батылдықты талап етеді деп ойлаймын.
Dialogue: 0,0:10:01.10,0:10:04.85,Default,,0,0,0,,Ескі дүниенің сиқырымен жасалған соңғы тіршілік формасы
Dialogue: 0,0:10:04.93,0:10:08.52,Default,,0,0,0,,Жоюшы Құдайдың қайта тірілу уақыты келді, Антрасакс!
Dialogue: 0,0:10:08.60,0:10:12.32,Default,,0,0,0,,Сонда да қандай сұмдық көрініс.
Dialogue: 0,0:10:12.40,0:10:15.94,Default,,0,0,0,,Әлі де өсуде және метаморфозаны жалғастыруда
Dialogue: 0,0:10:16.03,0:10:20.78,Default,,0,0,0,,Мұндай құбыжықты шынымен басқаруға бола ма?
Dialogue: 0,0:10:20.87,0:10:24.29,Default,,0,0,0,,Уайымдама, Кал'т.
Dialogue: 0,0:10:24.37,0:10:26.54,Default,,0,0,0,,Күшті деструктивті инстинкттен басқа
Dialogue: 0,0:10:26.62,0:10:29.37,Default,,0,0,0,,Тек гоблин сияқты ақылды
Dialogue: 0,0:10:29.46,0:10:33.67,Default,,0,0,0,,Бізде оны басқаруға мүмкіндік бар.
Dialogue: 0,0:10:34.59,0:10:37.72,Default,,0,0,0,,Енді екі мөрді осы жерге қойыңыз.
Dialogue: 0,0:10:38.63,0:10:40.64,Default,,0,0,0,,«Ол»?
Dialogue: 0,0:10:42.97,0:10:46.31,Default,,0,0,0,,Шейла, Яһуда сарайында, бұрынғыдан да көп.
Dialogue: 0,0:10:46.39,0:10:48.14,Default,,0,0,0,,Қара бұлттар ілулі тұр
Dialogue: 0,0:10:49.94,0:10:53.36,Default,,0,0,0,,Жою Құдайының мөрі бұзылғалы жатыр.
Dialogue: 0,0:10:53.44,0:10:54.77,Default,,0,0,0,,Ах
Dialogue: 0,0:10:54.86,0:10:57.57,Default,,0,0,0,,Біртүрлі зұлым Құдай Сібір жарасы
Dialogue: 0,0:10:57.65,0:11:00.15,Default,,0,0,0,,Ол зат қайта тірілсе, адамзат жойылады.
Dialogue: 0,0:11:01.20,0:11:05.58,Default,,0,0,0,,Осыдан бірнеше ғасыр бұрын ескі дүние өзінің гүлденуінің шыңында болды.
Dialogue: 0,0:11:05.66,0:11:09.83,Default,,0,0,0,,Өз қолымен жаратқан зұлым құдайдың құртқанындай болды.
Dialogue: 0,0:11:10.33,0:11:13.21,Default,,0,0,0,,Қазіргі әлемде өмір сүретін адамдар
Dialogue: 0,0:11:13.29,0:11:15.88,Default,,0,0,0,,Кең тараған деми-адамдар мен құбыжықтар
Dialogue: 0,0:11:15.96,0:11:19.34,Default,,0,0,0,,Сонымен қатар, табиғат күштерінен қауіп төнсе де,
Dialogue: 0,0:11:19.42,0:11:22.59,Default,,0,0,0,,Біз оларды сеніммен, бірлікпен жеңдік.
Dialogue: 0,0:11:22.68,0:11:25.35,Default,,0,0,0,,Бұл жарықты сөндірмеу керек
Dialogue: 0,0:11:25.43,0:11:27.89,Default,,0,0,0,,Соңғы пломба қалды
Dialogue: 0,0:11:27.97,0:11:30.81,Default,,0,0,0,,Сіз оны ешқашан оларға бермеуіңіз керек.
Dialogue: 0,0:11:31.64,0:11:36.02,Default,,0,0,0,,Шейла, мен сенің мөріміздің сырын білгеніңді қалаймын.
Dialogue: 0,0:11:36.11,0:11:38.03,Default,,0,0,0,,Менің ойымша, сізге айтатын уақыт келді.
Dialogue: 0,0:11:38.11,0:11:40.57,Default,,0,0,0,,А... құпия ма?
Dialogue: 0,0:11:42.61,0:11:45.45,Default,,0,0,0,,Менің ойымша, бұл өте жақын.
Dialogue: 0,0:11:45.53,0:11:47.12,Default,,0,0,0,,Өте көп сан.
Dialogue: 0,0:11:47.62,0:11:48.70,Default,,0,0,0,,Гала-сама
Dialogue: 0,0:11:48.79,0:11:50.29,Default,,0,0,0,,Мені итермеңіз
Dialogue: 0,0:11:50.37,0:11:52.54,Default,,0,0,0,,Шыққанның бәрі сүйек пен мәйіт болса
Dialogue: 0,0:11:52.62,0:11:55.33,Default,,0,0,0,,Ниндзя әскерімен жақсы төтеп бере аласыз.
Dialogue: 0,0:11:55.42,0:11:57.38,Default,,0,0,0,,Бұл бәрі болмаса ше?
Dialogue: 0,0:11:57.46,0:12:00.01,Default,,0,0,0,,Эй, солай деп ойлаймын.
Dialogue: 0,0:12:00.09,0:12:00.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:03.13,0:12:04.64,Default,,0,0,0,,Кем дегенде Ней мырза
Dialogue: 0,0:12:04.72,0:12:05.43,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:12:06.43,0:12:11.35,Default,,0,0,0,,Оны өсірген және Нейдің сүйікті ғашығы болған адам.
Dialogue: 0,0:12:11.43,0:12:15.27,Default,,0,0,0,,Өзімді құтқару үшін көз алдымда жүрегімді ойып алдым.
Dialogue: 0,0:12:15.35,0:12:18.86,Default,,0,0,0,,Бұл мүмкін емес. Ол өлуге дайын болуы мүмкін.
Dialogue: 0,0:12:18.94,0:12:20.99,Default,,0,0,0,,Менің әлі өлетін ойым жоқ.
Dialogue: 0,0:12:22.11,0:12:23.99,Default,,0,0,0,,Иә? Ней!
Dialogue: 0,0:12:24.07,0:12:26.32,Default,,0,0,0,,Жақын адам құтқарған өмір
Dialogue: 0,0:12:26.87,0:12:29.83,Default,,0,0,0,,Күресіңіз, күресіңіз және аман қалыңыз
Dialogue: 0,0:12:30.33,0:12:32.33,Default,,0,0,0,,Кек алғанша!
Dialogue: 0,0:12:38.09,0:12:41.80,Default,,0,0,0,,Бұл мөр басылған жою құдайының орталығы ма?
Dialogue: 0,0:12:41.88,0:12:46.76,Default,,0,0,0,,Қал Бұл оның миының терминалы ғана.
Dialogue: 0,0:12:46.84,0:12:48.89,Default,,0,0,0,,Бірінші пломба ашылды.
Dialogue: 0,0:12:48.97,0:12:52.31,Default,,0,0,0,,Зат алмасу функциясының 30% қалпына келтірілді
Dialogue: 0,0:12:52.39,0:12:57.52,Default,,0,0,0,,Жаңадан түсірілген екінші және үшінші пломбаларды осында ендіріп алсаңыз.
Dialogue: 0,0:12:57.61,0:13:02.53,Default,,0,0,0,,Ағзаның қозғалыс және рефлекторлық функцияларының көпшілігі қалпына келеді.
Dialogue: 0,0:13:02.61,0:13:05.65,Default,,0,0,0,,Үш мөрмен, көпшілігі...
Dialogue: 0,0:13:05.74,0:13:10.41,Default,,0,0,0,,Басқаша айтқанда, төртінші мөр – зұлым құдайдың ойлары мен үкімдерін басқаратын бөлік.
Dialogue: 0,0:13:10.49,0:13:12.75,Default,,0,0,0,,Ми жарты шарларына қолданылады ма?
Dialogue: 0,0:13:12.83,0:13:14.50,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:14.58,0:13:16.33,Default,,0,0,0,,Калс күткендей
Dialogue: 0,0:13:16.42,0:13:21.25,Default,,0,0,0,,Біз сол ми жарты шарында терминалды таптық.
Dialogue: 0,0:13:21.34,0:13:23.96,Default,,0,0,0,,Қалғандары менің Metallicanaдағы бағыныштым.
Dialogue: 0,0:13:24.05,0:13:26.97,Default,,0,0,0,,Сізге тек соңғы мөрді ұрлау жеткілікті.
Dialogue: 0,0:13:27.47,0:13:31.18,Default,,0,0,0,,Енді қайта тірілу рәсімін бастайық.
Dialogue: 0,0:13:31.26,0:13:33.85,Default,,0,0,0,,Нухахахаха!
Dialogue: 0,0:13:37.23,0:13:39.61,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:46.36,0:13:49.16,Default,,0,0,0,,Эй, эй, Megadeth сияқты нәрсені қолданыңыз.
Dialogue: 0,0:13:49.24,0:13:50.28,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:13:50.37,0:13:53.08,Default,,0,0,0,,Бұл заклинание найзағай құдайының семсерінің көмегінсіз орындалмас еді.
Dialogue: 0,0:13:53.16,0:13:55.16,Default,,0,0,0,,Жалғыз өз күшіммен істей алмаймын.
Dialogue: 0,0:13:55.25,0:13:57.71,Default,,0,0,0,,Олай болса, Харло Янды жеңейік.
Dialogue: 0,0:13:57.79,0:13:59.67,Default,,0,0,0,,Айдың орны өзгерді
Dialogue: 0,0:13:59.75,0:14:02.00,Default,,0,0,0,,Мен келесі жаңа айға дейін күте алмаймын.
Dialogue: 0,0:14:02.09,0:14:05.17,Default,,0,0,0,,Қорықсаңыз, басыңызға футон киіп ұйықтаңыз.
Dialogue: 0,0:14:05.26,0:14:06.97,Default,,0,0,0,,Мен сені жұдырықтаймын, бейбақ.
Dialogue: 0,0:14:07.76,0:14:08.80,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:14:08.88,0:14:11.68,Default,,0,0,0,,Өлген адамдар тобымен араласқан керемет адамдар бар.
Dialogue: 0,0:14:11.76,0:14:14.72,Default,,0,0,0,,Сенің көзің жақсы, жарты пері.
Dialogue: 0,0:14:14.81,0:14:17.10,Default,,0,0,0,,Ол күмәнсіз...
Dialogue: 0,0:14:18.98,0:14:20.77,Default,,0,0,0,,Сыбайлас жемқорлық легионының соғыс шебері
Dialogue: 0,0:14:21.69,0:14:22.65,Default,,0,0,0,,Линч!
Dialogue: 0,0:14:23.11,0:14:24.65,Default,,0,0,0,,Не— не?!
Dialogue: 0,0:14:24.73,0:14:26.49,Default,,0,0,0,,Линчинг? Бұл линчинг пе?
Dialogue: 0,0:14:26.99,0:14:28.03,Default,,0,0,0,,Линчинг…
Dialogue: 0,0:14:28.11,0:14:32.20,Default,,0,0,0,,Дай-Амон сияқты өлместікке жақын жауынгер.
Dialogue: 0,0:14:32.28,0:14:36.41,Default,,0,0,0,,Оның үстіне оның жын поштасы кез келген қылыштан да қиын.
Dialogue: 0,0:14:36.50,0:14:40.67,Default,,0,0,0,,Ол барлық сиқырларды қайтаратын сиқырлы сауыт деп те айтылады.
Dialogue: 0,0:14:40.75,0:14:43.75,Default,,0,0,0,,Қалыңызшы... Мен ауырып тұрмын.
Dialogue: 0,0:14:43.84,0:14:44.88,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:14:45.75,0:14:50.34,Default,,0,0,0,,Итбалықтың мәні ешқашан физикалық емес.
Dialogue: 0,0:14:50.84,0:14:54.68,Default,,0,0,0,,Сондай-ақ пломбаның тұрақты сыртқы түрі болмайды.
Dialogue: 0,0:14:55.18,0:14:59.64,Default,,0,0,0,,Төрт мөр төрт патша отбасына байланысты әртүрлі заттарда болады.
Dialogue: 0,0:15:00.14,0:15:01.35,Default,,0,0,0,,Құрамында?
Dialogue: 0,0:15:01.44,0:15:02.52,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:15:02.61,0:15:04.19,Default,,0,0,0,,Яғни мөр дегеніміз не?
Dialogue: 0,0:15:04.27,0:15:07.86,Default,,0,0,0,,Бұл белгісіз нысанда тұратын рухани болмыс.
Dialogue: 0,0:15:08.36,0:15:09.99,Default,,0,0,0,,Және Шейла
Dialogue: 0,0:15:11.45,0:15:13.28,Default,,0,0,0,,Соңғы мөр
Dialogue: 0,0:15:13.37,0:15:17.12,Default,,0,0,0,,Ол сіздің таныс заттарыңызда жасырылған.
Dialogue: 0,0:15:17.20,0:15:18.58,Default,,0,0,0,,Менікі ме?
Dialogue: 0,0:15:20.62,0:15:23.08,Default,,0,0,0,,･･
Dialogue: 0,0:15:23.17,0:15:25.00,Default,,0,0,0,,･･
Dialogue: 0,0:15:25.09,0:15:30.93,Default,,0,0,0,,･･･ ･･
Dialogue: 0,0:15:31.01,0:15:34.39,Default,,0,0,0,,Дурскизммизу Равзка Панизо
Dialogue: 0,0:15:34.47,0:15:38.56,Default,,0,0,0,,Канисо Лаканисо Катено Макатено!
Dialogue: 0,0:15:38.64,0:15:40.02,Default,,0,0,0,,Хмм! (Министрлер) О!
Dialogue: 0,0:15:40.10,0:15:41.85,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:15:41.94,0:15:45.52,Default,,0,0,0,,Енді оны жабу уақыты келді!
Dialogue: 0,0:15:47.82,0:15:49.36,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:15:49.44,0:15:52.15,Default,,0,0,0,,Осы екі пломба сынған
Dialogue: 0,0:15:52.24,0:15:55.78,Default,,0,0,0,,Антрасакстың денесінде күрт өзгерістер болуы керек!
Dialogue: 0,0:15:56.99,0:15:57.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:58.91,0:16:01.96,Default,,0,0,0,,Мынау... Бұл не болып жатыр?
Dialogue: 0,0:16:02.04,0:16:04.58,Default,,0,0,0,,Люс Ренрен қазір...
Dialogue: 0,0:16:04.67,0:16:07.63,Default,,0,0,0,,Енді Дирк Шнайдер түрінде!
Dialogue: 0,0:16:07.71,0:16:09.42,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:16:09.51,0:16:13.05,Default,,0,0,0,,Енді менің дауысыма жауап берші, қара құрт құдай!
Dialogue: 0,0:16:13.13,0:16:14.64,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:16:14.72,0:16:16.14,Default,,0,0,0,,Жоюшы Құдай!
Dialogue: 0,0:16:16.22,0:16:18.10,Default,,0,0,0,,Антрасакстың көзі...
Dialogue: 0,0:16:19.10,0:16:21.10,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:16:26.11,0:16:29.44,Default,,0,0,0,,Агия Агия Дарк Шнайдер!
Dialogue: 0,0:16:32.61,0:16:34.74,Default,,0,0,0,,Уф! Эй, бұл не?
Dialogue: 0,0:16:34.82,0:16:37.32,Default,,0,0,0,,Эй, эй! Бұл не?
Dialogue: 0,0:16:37.41,0:16:38.24,Default,,0,0,0,,Не?
Dialogue: 0,0:16:38.33,0:16:39.20,Default,,0,0,0,,Сол жарық...
Dialogue: 0,0:16:39.28,0:16:42.66,Default,,0,0,0,,Бұл Дирк Шнайдер сақталған мәйітхана ма?
Dialogue: 0,0:16:42.75,0:16:44.92,Default,,0,0,0,,Қараңдар! часовняның астынан
Dialogue: 0,0:16:45.00,0:16:46.29,Default,,0,0,0,,Қандай жарық?
Dialogue: 0,0:16:46.38,0:16:47.88,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:16:47.96,0:16:49.42,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:16:50.55,0:16:52.26,Default,,0,0,0,,Яһуда сарайының бағыты!
Dialogue: 0,0:16:52.76,0:16:54.93,Default,,0,0,0,,Нұх, бұл аспан дауылды
Dialogue: 0,0:16:55.01,0:16:57.47,Default,,0,0,0,,Қалған екі пломба сынған!
Dialogue: 0,0:16:59.43,0:17:02.77,Default,,0,0,0,,Мына жарық... мынау!
Dialogue: 0,0:17:04.06,0:17:07.94,Default,,0,0,0,,Тек зомбилер мен қаңқалар, біз бірге жиналдық.
Dialogue: 0,0:17:08.02,0:17:10.61,Default,,0,0,0,,Шынында да өлілер әскері.
Dialogue: 0,0:17:11.11,0:17:13.36,Default,,0,0,0,,Егер сіз капитан Линчті жеңсеңіз
Dialogue: 0,0:17:13.44,0:17:18.37,Default,,0,0,0,,Қалғанын ниндзя әскерімен және бас діни қызметкердің заклинанияларымен басқаруға болады.
Dialogue: 0,0:17:18.45,0:17:21.24,Default,,0,0,0,,Бас діни қызметкердің өлгендерге қарсы сиқырлары
Dialogue: 0,0:17:21.33,0:17:23.83,Default,,0,0,0,,Мен Абигейлдің сиқырын жеңе алсам ғой
Dialogue: 0,0:17:24.37,0:17:26.21,Default,,0,0,0,,Олар жай мәйітке айналады
Dialogue: 0,0:17:26.29,0:17:28.63,Default,,0,0,0,,Сіз тыныш ұйықтайсыз.
Dialogue: 0,0:17:28.71,0:17:32.21,Default,,0,0,0,,Бірақ Антрасакстың одан әрі белсенділенуімен
Dialogue: 0,0:17:32.30,0:17:34.59,Default,,0,0,0,,Қараңғылықтың күші артып келеді
Dialogue: 0,0:17:34.67,0:17:36.68,Default,,0,0,0,,Қараңғы діни қызметкер Абигейл
Dialogue: 0,0:17:36.76,0:17:40.39,Default,,0,0,0,,Ол әскерге айтарлықтай бақылау жасауы керек.
Dialogue: 0,0:17:40.89,0:17:43.39,Default,,0,0,0,,Мен оған сене алмаймын.
Dialogue: 0,0:17:43.47,0:17:46.14,Default,,0,0,0,,Аа, маған ұнамайды.
Dialogue: 0,0:17:49.65,0:17:52.15,Default,,0,0,0,,Сәлем! Барайық!
Dialogue: 0,0:17:53.23,0:17:55.82,Default,,0,0,0,,Мен осылай ойладым.
Dialogue: 0,0:17:55.90,0:17:57.03,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:17:57.11,0:18:00.37,Default,,0,0,0,,Бірақ менің түйсігім соншалықты дәл!
Dialogue: 0,0:18:03.24,0:18:04.29,Default,,0,0,0,,Люс!
Dialogue: 0,0:18:09.17,0:18:10.25,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:12.25,0:18:15.09,Default,,0,0,0,,Әй, бұл не?
Dialogue: 0,0:18:17.59,0:18:20.05,Default,,0,0,0,,Қараңдар! Менің жүрегім...
Dialogue: 0,0:18:20.55,0:18:21.93,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:18:22.01,0:18:23.72,Default,,0,0,0,,Сен мені тірілтейін деп жатырсың ба?
Dialogue: 0,0:18:24.43,0:18:26.73,Default,,0,0,0,,Енді ойнайық!
Dialogue: 0,0:18:28.60,0:18:33.23,Default,,0,0,0,,Уф... Бұл неткен зұлым рух!
Dialogue: 0,0:18:33.32,0:18:35.53,Default,,0,0,0,,Қараңғылықтан шыққан зұлым күш
Dialogue: 0,0:18:35.61,0:18:38.86,Default,,0,0,0,,Олар Дирк Шнайдердің айналасына жиналып жатыр!
Dialogue: 0,0:18:39.49,0:18:42.28,Default,,0,0,0,,Бұл сияқты
Dialogue: 0,0:18:42.37,0:18:45.62,Default,,0,0,0,,Бұл зұлым құдайдың қайта тірілуіне жауап беретін сияқты емес пе?
Dialogue: 0,0:18:49.71,0:18:50.87,Default,,0,0,0,,Маджин қылыш!
Dialogue: 0,0:18:52.79,0:18:53.88,Default,,0,0,0,,Жалған!
Dialogue: 0,0:18:56.38,0:18:57.76,Default,,0,0,0,,Не?
Dialogue: 0,0:18:57.84,0:19:01.93,Default,,0,0,0,,Бұл жын поштасы болса да, мен жын семсерінен бірде-бір сызат ала алмайтыныма сене алмаймын...
Dialogue: 0,0:19:02.01,0:19:02.76,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:19:02.85,0:19:05.14,Default,,0,0,0,,Сіз найзағайдың барлық соққыларын тойтардыңыз ба?
Dialogue: 0,0:19:05.22,0:19:06.35,Default,,0,0,0,,Уф
Dialogue: 0,0:19:06.43,0:19:10.52,Default,,0,0,0,,Ниндзя шебері Гала найзағай императоры Эш Ней
Dialogue: 0,0:19:11.02,0:19:14.40,Default,,0,0,0,,Балалар енді мені жеңе алмайсыңдар.
Dialogue: 0,0:19:14.48,0:19:15.23,Default,,0,0,0,,Қу!
Dialogue: 0,0:19:15.32,0:19:18.03,Default,,0,0,0,,Сатқындар өледі!
Dialogue: 0,0:19:18.11,0:19:20.95,Default,,0,0,0,,Риккайгого жойылды!
Dialogue: 0,0:19:23.37,0:19:24.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:24.28,0:19:25.24,Default,,0,0,0,,Не?
Dialogue: 0,0:19:27.29,0:19:28.12,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:28.20,0:19:29.50,Default,,0,0,0,,Гала!
Dialogue: 0,0:19:30.46,0:19:31.79,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:31.87,0:19:34.13,Default,,0,0,0,,Кез келген адамды кесуге болады.
Dialogue: 0,0:19:34.21,0:19:36.50,Default,,0,0,0,,Өйткені жақсы әйел бұзылады
Dialogue: 0,0:19:37.13,0:19:38.21,Default,,0,0,0,,Гала...
Dialogue: 0,0:19:39.97,0:19:42.30,Default,,0,0,0,,Ха! Ақымақ...
Dialogue: 0,0:19:42.38,0:19:44.43,Default,,0,0,0,,Риккайгого жеңілсе...
Dialogue: 0,0:19:44.93,0:19:46.93,Default,,0,0,0,,Мен жын поштасын киіп жүрсем де.
Dialogue: 0,0:19:47.01,0:19:49.18,Default,,0,0,0,,Осындай күшке ие болу үшін!
Dialogue: 0,0:19:49.27,0:19:51.81,Default,,0,0,0,,Аа, айтайын.
Dialogue: 0,0:19:51.89,0:19:54.02,Default,,0,0,0,,Зұлым құдайдың іске қосылуымен
Dialogue: 0,0:19:54.10,0:19:56.90,Default,,0,0,0,,Зұлымдықтың күшеюімен
Dialogue: 0,0:19:56.98,0:20:01.20,Default,,0,0,0,,Қараңғыда туғандардың күші де еселенеді.
Dialogue: 0,0:20:01.82,0:20:05.66,Default,,0,0,0,,Мен және Абигейл сияқты бол!
Dialogue: 0,0:20:06.62,0:20:09.62,Default,,0,0,0,,Қараңғыда... Қараңғыда туылған ба?
Dialogue: 0,0:20:13.08,0:20:14.58,Default,,0,0,0,,О! Қараңдар!
Dialogue: 0,0:20:14.67,0:20:17.34,Default,,0,0,0,,Жүрек қалпына келтірілді!
Dialogue: 0,0:20:17.84,0:20:21.30,Default,,0,0,0,,Dark Schneider қайта тіріле ме?
Dialogue: 0,0:20:22.38,0:20:25.30,Default,,0,0,0,,Жоқ, менің жүрегім әлі соққан жоқ.
Dialogue: 0,0:20:25.39,0:20:26.64,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:20:26.72,0:20:29.18,Default,,0,0,0,,Неге... неге оянбайсың?
Dialogue: 0,0:20:29.85,0:20:34.39,Default,,0,0,0,,Иә, бұл күшті жындық қуатқа жақындау қауіпті.
Dialogue: 0,0:20:34.48,0:20:37.40,Default,,0,0,0,,Сенің жүрегіңді елжірететін қолың жоқ па?
Dialogue: 0,0:20:37.94,0:20:38.69,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:20:38.77,0:20:40.40,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:20:40.48,0:20:43.99,Default,,0,0,0,,Өлесіңдер балалар!
Dialogue: 0,0:20:46.87,0:20:49.28,Default,,0,0,0,,Сәлем Люс! Оян!
Dialogue: 0,0:20:49.91,0:20:51.79,Default,,0,0,0,,Оянбайсың ба, жігітім?
Dialogue: 0,0:20:51.87,0:20:53.75,Default,,0,0,0,,Асықпасаң, кешігесің!
Dialogue: 0,0:20:53.83,0:20:56.21,Default,,0,0,0,,Гала да, Ней-сан да жараланған!
Dialogue: 0,0:20:56.29,0:20:57.29,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:00.00,0:21:04.84,Default,,0,0,0,,Оянбасаң, үрлеймін!
Dialogue: 0,0:21:06.13,0:21:08.55,Default,,0,0,0,,Уау, кешіріңіз!
Dialogue: 0,0:21:08.64,0:21:09.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:09.43,0:21:10.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:10.26,0:21:10.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:10.93,0:21:12.56,Default,,0,0,0,,Нуа~?
Dialogue: 0,0:21:12.64,0:21:15.77,Default,,0,0,0,,Жоқ! Эй мына құбыжық
Dialogue: 0,0:21:15.85,0:21:18.86,Default,,0,0,0,,Бұл қандай қорқынышты аура?
Dialogue: 0,0:21:19.94,0:21:21.86,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:21.94,0:21:23.07,Default,,0,0,0,,ақымақ
Dialogue: 0,0:21:23.15,0:21:26.70,Default,,0,0,0,,15 жыл бұрын Дирк Шнайдер өзінің өліміне дайындалды.
Dialogue: 0,0:21:26.78,0:21:29.78,Default,,0,0,0,,Олар алдын ала қайта тірілу рәсімін жасаған болуы керек!
Dialogue: 0,0:21:29.87,0:21:33.79,Default,,0,0,0,,Ал, жүректі толық өлім күйінен қалпына келтір.
Dialogue: 0,0:21:33.87,0:21:35.91,Default,,0,0,0,,Мен оның өзін тірілткеніне сене алар емеспін!
Dialogue: 0,0:21:41.96,0:21:45.17,Default,,0,0,0,,Егер бұл арман болмаса
Dialogue: 0,0:21:45.67,0:21:49.68,Default,,0,0,0,,Дирк Шнайдердің қазіргі қабілеттері 15 жыл бұрынғыдан өте алыс!
Dialogue: 0,0:21:50.93,0:21:53.43,Default,,0,0,0,,Ле… Луш
Dialogue: 0,0:21:53.52,0:21:57.31,Default,,0,0,0,,Бұл біздің қиялымыздан әлдеқайда асып түседі!
Dialogue: 0,0:21:59.10,0:22:00.65,Default,,0,0,0,,Қайырлы таң Йоко-сан
Dialogue: 0,0:22:00.73,0:22:02.27,Default,,0,0,0,,Я~
Dialogue: 0,0:22:03.36,0:22:05.36,Default,,0,0,0,,Мен бүгін сабаққа келмеймін!
Dialogue: 0,0:22:05.44,0:22:08.11,Default,,0,0,0,,Сонымен... сен мектепке бардың, Люси!
Dialogue: 0,0:22:09.82,0:22:13.24,Default,,0,0,0,,Шынымен, шынымен...
Dialogue: 0,0:22:14.20,0:22:15.45,Default,,0,0,0,,Сіз
Dialogue: 0,0:22:19.00,0:22:20.42,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:22:23.17,0:22:24.50,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.54,0:23:46.55,Default,,0,0,0,,～♪
