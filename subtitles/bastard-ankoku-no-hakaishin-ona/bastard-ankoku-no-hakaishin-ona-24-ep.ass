Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:13.09,0:00:15.89,Default,,0,0,0,,Тыңдаңыз, бәрібір...
Dialogue: 0,0:00:15.97,0:00:18.22,Default,,0,0,0,,Жарайды онда
Dialogue: 0,0:00:18.30,0:00:20.56,Default,,0,0,0,,Мен сені не болса да өлтіремін!
Dialogue: 0,0:00:20.64,0:00:22.18,Default,,0,0,0,,Қайта тірілсем де сені өлтіремін!
Dialogue: 0,0:00:22.27,0:00:22.89,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:22.98,0:00:24.52,Default,,0,0,0,,Өткен өмірде де өлтір!
Dialogue: 0,0:00:24.60,0:00:26.23,Default,,0,0,0,,Қайта тусам да сені өлтіремін!
Dialogue: 0,0:00:26.31,0:00:28.73,Default,,0,0,0,,Мен сенің өміріңді сұрауға да рұқсат етпеймін.
Dialogue: 0,0:00:28.82,0:00:33.03,Default,,0,0,0,,Өлтір, өлтір, өлтір!
Dialogue: 0,0:00:34.03,0:00:36.57,Default,,0,0,0,,Сен мені өлтіресің бе?
Dialogue: 0,0:00:36.66,0:00:38.20,Default,,0,0,0,,О, мені өлтір!
Dialogue: 0,0:00:38.28,0:00:39.33,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:00:39.41,0:00:41.29,Default,,0,0,0,,Не болса да
Dialogue: 0,0:00:41.79,0:00:44.33,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:00:44.41,0:00:46.75,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:00:46.83,0:00:51.63,Default,,0,0,0,,Осындай денеңізбен және сиқырлы күшіңіз таусылса,
Dialogue: 0,0:00:51.71,0:00:54.55,Default,,0,0,0,,Мені қалай өлтіресің?
Dialogue: 0,0:00:54.63,0:00:56.30,Default,,0,0,0,,Мені қызықтырады
Dialogue: 0,0:00:56.38,0:00:58.93,Default,,0,0,0,,Мен сізден өтінемін, мені барлық жағдайда үйретіңіз.
Dialogue: 0,0:00:59.01,0:01:01.56,Default,,0,0,0,,Тоқта, Қараңғы Шнайдер!
Dialogue: 0,0:01:01.64,0:01:02.56,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:01:02.64,0:01:04.85,Default,,0,0,0,,Ол дене мұны істей алмайды.
Dialogue: 0,0:01:05.52,0:01:08.69,Default,,0,0,0,,Ей, мен бұл жолы шынымен өлемін.
Dialogue: 0,0:01:08.77,0:01:10.44,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:01:10.52,0:01:11.61,Default,,0,0,0,,Мавару үшін!
Dialogue: 0,0:01:12.57,0:01:15.20,Default,,0,0,0,,Абигейлді қатайт!
Dialogue: 0,0:01:15.28,0:01:16.40,Default,,0,0,0,,Ұр, Люс!
Dialogue: 0,0:01:17.53,0:01:20.99,Default,,0,0,0,,Сіз күткендей, Йоко-сан, сондықтан...
Dialogue: 0,0:01:24.45,0:01:27.21,Default,,0,0,0,,Бұл болуы керек!
Dialogue: 0,0:01:27.29,0:01:30.67,Default,,0,0,0,,Хо, жалынның рухтары жиналды...
Dialogue: 0,0:01:30.75,0:01:33.09,Default,,0,0,0,,Бұл өте ақымақ...
Dialogue: 0,0:01:33.17,0:01:34.17,Default,,0,0,0,,Иса!
Dialogue: 0,0:01:34.84,0:01:38.84,Default,,0,0,0,,Тәңірге арқа сүйеме, әйтеуір, құдайға сенбе!
Dialogue: 0,0:01:38.93,0:01:40.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:40.10,0:01:42.22,Default,,0,0,0,,Әй, мен сені қалай өлтіремін?
Dialogue: 0,0:01:42.31,0:01:43.64,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:01:43.72,0:01:45.43,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:01:45.52,0:01:47.39,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:01:47.48,0:01:49.65,Default,,0,0,0,,Міне осылай!
Dialogue: 0,0:01:50.48,0:01:52.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:52.86,0:01:55.53,Default,,0,0,0,,Сиқырлы күш-қуатыңды тауысу керек еді саған.
Dialogue: 0,0:01:55.61,0:01:58.03,Default,,0,0,0,,Неліктен ол сонша күшке ие ...
Dialogue: 0,0:01:58.11,0:02:00.07,Default,,0,0,0,,Ха! Амал жоқ...
Dialogue: 0,0:02:00.57,0:02:03.16,Default,,0,0,0,,Жоюшы Құдайдың әсері...
Dialogue: 0,0:02:04.08,0:02:06.75,Default,,0,0,0,,(үру)
Dialogue: 0,0:02:07.50,0:02:10.13,Default,,0,0,0,,Сібір жарасы үреді
Dialogue: 0,0:02:10.21,0:02:13.71,Default,,0,0,0,,Сен не деп айқайлап тұрсың?
Dialogue: 0,0:02:14.92,0:02:18.05,Default,,0,0,0,,Айқай емес пе? Резонанс?
Dialogue: 0,0:02:18.72,0:02:23.97,Default,,0,0,0,,Жою құдайы... бір нәрсемен резонанс жасай ма?
Dialogue: 0,0:02:25.47,0:02:27.18,Default,,0,0,0,,♪～
Dialogue: 0,0:03:52.94,0:03:54.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:56.56,0:03:58.98,Default,,0,0,0,,Найзағай императоры Күл Нейге лақтырылды.
Dialogue: 0,0:03:59.07,0:04:00.40,Default,,0,0,0,,Қарғысты бұзу
Dialogue: 0,0:04:00.49,0:04:04.11,Default,,0,0,0,,Жүрегіңді жұлып алып өлдің.
Dialogue: 0,0:04:04.70,0:04:05.57,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:04:05.66,0:04:10.25,Default,,0,0,0,,Қалай қайта тірілуге ​​болады?
Dialogue: 0,0:04:10.75,0:04:11.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:11.45,0:04:16.88,Default,,0,0,0,,Активтендірілген Жою құдайының зұлым толқындарының әсері Антрасакс
Dialogue: 0,0:04:16.96,0:04:19.21,Default,,0,0,0,,Мен оны алғандықтан ғана.
Dialogue: 0,0:04:19.92,0:04:21.05,Default,,0,0,0,,Сібір жарасы – бұл
Dialogue: 0,0:04:21.13,0:04:24.68,Default,,0,0,0,,«Қараңғылыққа» жақын адамдарға күшті әсер ету
Dialogue: 0,0:04:24.76,0:04:28.72,Default,,0,0,0,,Ал одан көп зардап шеккендер
Dialogue: 0,0:04:28.81,0:04:33.35,Default,,0,0,0,,Бір кездері ең қараңғы аймақта болған және жын атанған адам.
Dialogue: 0,0:04:33.43,0:04:36.85,Default,,0,0,0,,Дирк Шнайдер Бұл сізсіз!
Dialogue: 0,0:04:38.56,0:04:41.19,Default,,0,0,0,,Жоюшы Құдайдың мөрін қаншалықты бұзсаңыз, соғұрлым көп
Dialogue: 0,0:04:41.28,0:04:43.82,Default,,0,0,0,,Сіз күш-қуатпен өсесіз
Dialogue: 0,0:04:43.90,0:04:46.41,Default,,0,0,0,,Металликана патшалығының ханшайымы
Dialogue: 0,0:04:46.49,0:04:50.91,Default,,0,0,0,,Шейла Тоэл Металликананың соңғы мөрі бұзылған кезде
Dialogue: 0,0:04:50.99,0:04:55.42,Default,,0,0,0,,Сіз қанша қуат ала аласыз?
Dialogue: 0,0:04:57.00,0:04:59.25,Default,,0,0,0,,Егер мен 15 жыл бұрын болсам
Dialogue: 0,0:04:59.34,0:05:03.30,Default,,0,0,0,,Бақылауларыңыз ұнады деп үміттенемін.
Dialogue: 0,0:05:03.38,0:05:06.51,Default,,0,0,0,,Бірақ қазір жағдай басқаша.
Dialogue: 0,0:05:07.05,0:05:09.55,Default,,0,0,0,,Мажин Дирк Шнайдермен
Dialogue: 0,0:05:09.64,0:05:11.47,Default,,0,0,0,,Оның соңынан ерген төрт аспан патшасы
Dialogue: 0,0:05:11.56,0:05:13.39,Default,,0,0,0,,Қарым-қатынас бұзылған.
Dialogue: 0,0:05:13.47,0:05:17.98,Default,,0,0,0,,Енді сен біздің көтерілісші әскердің жауысың.
Dialogue: 0,0:05:18.06,0:05:19.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:19.69,0:05:20.57,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.65,0:05:24.36,Default,,0,0,0,,Бастапқы себеп 15 жыл бұрынғы Голем соғысы болды.
Dialogue: 0,0:05:24.44,0:05:27.70,Default,,0,0,0,,Бес батыр және ханзада Раның Ур Металликанасы
Dialogue: 0,0:05:27.78,0:05:29.24,Default,,0,0,0,,Сен мені дұрыс емес жерден пышақтап алдың
Dialogue: 0,0:05:29.32,0:05:32.58,Default,,0,0,0,,Өлім алдында, реинкарнацияның құпия өнерін орындау кезінде
Dialogue: 0,0:05:32.66,0:05:36.50,Default,,0,0,0,,Гео жазба сұрыптауы бойынша бес кейіпкердің бірі
Dialogue: 0,0:05:36.58,0:05:38.33,Default,,0,0,0,,Сіздің жаныңыз
Dialogue: 0,0:05:38.42,0:05:42.55,Default,,0,0,0,,Өйткені ол Люс Ренрен есімді баланың ішіне мөрленген.
Dialogue: 0,0:05:44.13,0:05:47.97,Default,,0,0,0,,Мөр бұзылып, тірілдің.
Dialogue: 0,0:05:48.05,0:05:51.72,Default,,0,0,0,,Сіз енді 15 жыл бұрынғы адам емессіз.
Dialogue: 0,0:05:51.80,0:05:52.81,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.89,0:05:56.23,Default,,0,0,0,,Сізге Люс Ренрен зұлымдықтың бейнесі болды.
Dialogue: 0,0:05:56.31,0:05:57.89,Default,,0,0,0,,Адамның жүрегі
Dialogue: 0,0:05:57.98,0:06:01.36,Default,,0,0,0,,Өйткені мен махаббатты отырғыздым!
Dialogue: 0,0:06:01.44,0:06:04.57,Default,,0,0,0,,Әй, неткен тағдыр...
Dialogue: 0,0:06:04.65,0:06:05.90,Default,,0,0,0,,Айтпа! Жолдан кет!
Dialogue: 0,0:06:05.99,0:06:08.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:09.61,0:06:13.37,Default,,0,0,0,,Бұл ұзақ әңгіме, баклажан!
Dialogue: 0,0:06:13.45,0:06:17.83,Default,,0,0,0,,Жарайсың, мына қатыгез, жеңілмейтін сұлу адам.
Dialogue: 0,0:06:17.91,0:06:21.13,Default,,0,0,0,,Олар мені біржақты өлтірсе жақсы болар еді!
Dialogue: 0,0:06:21.21,0:06:23.09,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:06:23.17,0:06:24.30,Default,,0,0,0,,Осы жерден...
Dialogue: 0,0:06:24.38,0:06:29.13,Default,,0,0,0,,Бұл менің ең нашар шоу уақытым, мен үшін және тек мен үшін!
Dialogue: 0,0:06:29.22,0:06:32.64,Default,,0,0,0,,Адамдар жағымды сөйлескенде...
Dialogue: 0,0:06:32.72,0:06:35.01,Default,,0,0,0,,Кенет, Гупан деген не?
Dialogue: 0,0:06:35.10,0:06:36.39,Default,,0,0,0,,(Саяма мен басқалардың күлкісі)
Dialogue: 0,0:06:36.47,0:06:37.39,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:06:37.48,0:06:38.64,Default,,0,0,0,,(Саяма мен басқалардың күлкісі)
Dialogue: 0,0:06:38.73,0:06:40.69,Default,,0,0,0,,Сен сондай қатыгезсің...
Dialogue: 0,0:06:40.77,0:06:43.02,Default,,0,0,0,,Мен саған сөйлеспе деп айтқан шығармын!
Dialogue: 0,0:06:43.11,0:06:43.82,Default,,0,0,0,,Не!
Dialogue: 0,0:06:45.27,0:06:46.36,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:50.32,0:06:51.11,Default,,0,0,0,,Дарш!
Dialogue: 0,0:06:51.20,0:06:51.86,Default,,0,0,0,,Люс!
Dialogue: 0,0:06:53.78,0:06:54.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:55.83,0:06:56.70,Default,,0,0,0,,Қу!
Dialogue: 0,0:06:56.79,0:06:57.66,Default,,0,0,0,,Уф
Dialogue: 0,0:06:57.75,0:07:00.04,Default,,0,0,0,,О, сен істедің!
Dialogue: 0,0:07:00.12,0:07:04.50,Default,,0,0,0,,Қатты сөйлеп тұрсаң да, тым жылдамсың!
Dialogue: 0,0:07:04.59,0:07:07.42,Default,,0,0,0,,Да Дирк Шнайдер
Dialogue: 0,0:07:10.72,0:07:11.63,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:07:12.97,0:07:13.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.30,0:07:15.89,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:07:16.60,0:07:17.35,Default,,0,0,0,,Не?
Dialogue: 0,0:07:18.31,0:07:19.56,Default,,0,0,0,,Сіз сөйледіңіз.
Dialogue: 0,0:07:19.64,0:07:20.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:20.85,0:07:23.65,Default,,0,0,0,,Сіз өте көп сөйледіңіз!
Dialogue: 0,0:07:23.73,0:07:27.11,Default,,0,0,0,,Маған қызметші ретінде қарсы шығасың деп ойлау...
Dialogue: 0,0:07:27.19,0:07:28.73,Default,,0,0,0,,Енді мейірімділік жоқ!
Dialogue: 0,0:07:28.82,0:07:30.86,Default,,0,0,0,,Менің олай істеуге ниетім жоқ.
Dialogue: 0,0:07:30.95,0:07:33.07,Default,,0,0,0,,Кайзард Альзадо
Dialogue: 0,0:07:33.16,0:07:36.45,Default,,0,0,0,,Ки Сук Ханс Жалпы жібек
Dialogue: 0,0:07:36.53,0:07:38.12,Default,,0,0,0,,Бұл заклинание...
Dialogue: 0,0:07:38.20,0:07:39.20,Default,,0,0,0,,Сіз ата аласыз ба?
Dialogue: 0,0:07:39.29,0:07:41.37,Default,,0,0,0,,Жоқ, атуға рұқсат бермеймін!
Dialogue: 0,0:07:42.58,0:07:43.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:43.83,0:07:46.75,Default,,0,0,0,,Мен қожайыныма кедергі жасамаймын, некроманшы!
Dialogue: 0,0:07:46.84,0:07:47.71,Default,,0,0,0,,Ifrit?
Dialogue: 0,0:07:48.96,0:07:50.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:54.18,0:07:54.76,Default,,0,0,0,,Қазір!
Dialogue: 0,0:07:55.60,0:07:58.18,Default,,0,0,0,,Күлге айнал, Жер асты данышпан
Dialogue: 0,0:07:58.26,0:08:01.48,Default,,0,0,0,,Жеті кілтті алып, тозақтың қақпасын аш!
Dialogue: 0,0:08:01.56,0:08:03.94,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:08:06.69,0:08:10.57,Default,,0,0,0,,Бұл Харлоиннің Нейге атуынан да күшті.
Dialogue: 0,0:08:11.44,0:08:13.70,Default,,0,0,0,,О, Дарш...
Dialogue: 0,0:08:13.78,0:08:16.70,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:08:17.70,0:08:20.66,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:08:20.75,0:08:22.41,Default,,0,0,0,,Өлім рыцарларының саны артты!
Dialogue: 0,0:08:23.71,0:08:27.17,Default,,0,0,0,,Құрама комбинация!
Dialogue: 0,0:08:27.71,0:08:31.30,Default,,0,0,0,,Хэхехе хахаха...
Dialogue: 0,0:08:31.38,0:08:35.18,Default,,0,0,0,,Оның шабуыл күші Харло Енге қарағанда көбірек.
Dialogue: 0,0:08:35.26,0:08:39.76,Default,,0,0,0,,Мұндағы регенерация күші сәл жоғарырақ сияқты.
Dialogue: 0,0:08:39.85,0:08:42.52,Default,,0,0,0,,...
Dialogue: 0,0:08:42.60,0:08:43.94,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:44.02,0:08:46.48,Default,,0,0,0,,Харлоиннің сәулеленуі жақын арада аяқталады.
Dialogue: 0,0:08:46.56,0:08:47.61,Default,,0,0,0,,Міне, сіз...
Dialogue: 0,0:08:47.69,0:08:51.28,Default,,0,0,0,,Қан келісімі бойынша Абаддон жерінен келіңіздер.
Dialogue: 0,0:08:51.36,0:08:52.86,Default,,0,0,0,,Жаһаннам оты
Dialogue: 0,0:08:52.94,0:08:57.03,Default,,0,0,0,,Жарылғыш жалынға айналып, бәрін өртеп жібер!
Dialogue: 0,0:08:57.11,0:08:58.70,Default,,0,0,0,,Экс-Зордус!
Dialogue: 0,0:08:58.78,0:09:00.20,Default,,0,0,0,,Не?
Dialogue: 0,0:09:00.28,0:09:02.37,Default,,0,0,0,,Харло Енді босату кезінде...
Dialogue: 0,0:09:02.45,0:09:04.58,Default,,0,0,0,,Экс-Зодусты жырлауға қалай батылы бардың!
Dialogue: 0,0:09:04.66,0:09:06.96,Default,,0,0,0,,Бар, Люс!
Dialogue: 0,0:09:08.50,0:09:11.88,Default,,0,0,0,,Бұл үлкен нәрсе жолында!
Dialogue: 0,0:09:11.96,0:09:15.30,Default,,0,0,0,,Жоқ! Не?
Dialogue: 0,0:09:15.38,0:09:16.68,Default,,0,0,0,,♪～
Dialogue: 0,0:09:33.07,0:09:34.19,Default,,0,0,0,,О...
Dialogue: 0,0:09:35.53,0:09:37.53,Default,,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:09:38.03,0:09:39.49,Default,,0,0,0,,Келме!
Dialogue: 0,0:09:39.57,0:09:41.41,Default,,0,0,0,,Да Фора!
Dialogue: 0,0:09:43.79,0:09:45.16,Default,,0,0,0,,Оны неге алдың?
Dialogue: 0,0:09:45.25,0:09:47.58,Default,,0,0,0,,Не болды? Бәрі осы ма?
Dialogue: 0,0:09:47.67,0:09:49.08,Default,,0,0,0,,Ха! Келме!
Dialogue: 0,0:09:52.13,0:09:54.26,Default,,0,0,0,,Келме!
Dialogue: 0,0:09:55.88,0:09:58.43,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:09:58.51,0:09:59.39,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:09:59.47,0:10:01.85,Default,,0,0,0,,Мен саған сөйлеспе деп айтқан шығармын!
Dialogue: 0,0:10:01.93,0:10:05.31,Default,,0,0,0,,Татататата!
Dialogue: 0,0:10:05.39,0:10:06.35,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:06.43,0:10:08.06,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:10:08.14,0:10:09.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:10.19,0:10:10.90,Default,,0,0,0,,Дарш!
Dialogue: 0,0:10:11.48,0:10:13.36,Default,,0,0,0,,Аңызға айналған шебер
Dialogue: 0,0:10:13.44,0:10:15.40,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:10:15.48,0:10:16.94,Default,,0,0,0,,Жаса, Дирк Шнайдер!
Dialogue: 0,0:10:17.03,0:10:20.03,Default,,0,0,0,,Абигейлге соңғы соққыны беріңіз!
Dialogue: 0,0:10:20.11,0:10:22.91,Default,,0,0,0,,Tatatatatatatatata!
Dialogue: 0,0:10:22.99,0:10:25.79,Default,,0,0,0,,Тәтті... Тәтті екен.
Dialogue: 0,0:10:25.87,0:10:28.96,Default,,0,0,0,,Сіз мұны бірден сиқырмен аяқтауыңыз керек.
Dialogue: 0,0:10:29.04,0:10:31.71,Default,,0,0,0,,Хехе... қалағаныңызша ұрыңыз.
Dialogue: 0,0:10:31.79,0:10:35.17,Default,,0,0,0,,Омегадан қашқан кезде өзімен бірге алып келген Шайтан сақинасы.
Dialogue: 0,0:10:35.25,0:10:38.80,Default,,0,0,0,,Жою құдайының ұлпа жасушаларынан жіберілетін энергия
Dialogue: 0,0:10:38.88,0:10:40.93,Default,,0,0,0,,Жақында толтырылады
Dialogue: 0,0:10:41.01,0:10:43.30,Default,,0,0,0,,Бұл уақыт сіздің соңғы уақытыңыз болады
Dialogue: 0,0:10:43.39,0:10:46.64,Default,,0,0,0,,Козыр - бұл соңына дейін сақтау керек нәрсе.
Dialogue: 0,0:10:46.72,0:10:50.60,Default,,0,0,0,,Жоғары ауырлық құйынына қайтадан жұтылады.
Dialogue: 0,0:10:50.69,0:10:52.27,Default,,0,0,0,,Неге соншалықты алысқа бару керек…
Dialogue: 0,0:10:52.36,0:10:53.27,Default,,0,0,0,,Уф
Dialogue: 0,0:10:55.15,0:10:55.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:56.07,0:10:57.15,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:10:57.23,0:10:59.20,Default,,0,0,0,,Энергияны зарядтау
Dialogue: 0,0:11:00.45,0:11:02.11,Default,,0,0,0,,120％
Dialogue: 0,0:11:02.20,0:11:04.03,Default,,0,0,0,,Гилан-Ира!
Dialogue: 0,0:11:04.12,0:11:04.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:05.24,0:11:07.20,Default,,0,0,0,,Артқа шегініңдер!
Dialogue: 0,0:11:07.29,0:11:09.08,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:09.16,0:11:13.79,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:11:17.42,0:11:19.01,Default,,0,0,0,,Мен мұндай нәрселерге әрдайым шебер болдым, көріп тұрсың ғой.
Dialogue: 0,0:11:19.09,0:11:21.84,Default,,0,0,0,,Мен сені міндетті түрде өлтіремін!
Dialogue: 0,0:11:21.93,0:11:23.93,Default,,0,0,0,,～♪
Dialogue: 0,0:11:27.56,0:11:29.60,Default,,0,0,0,,О~
Dialogue: 0,0:11:29.68,0:11:31.94,Default,,0,0,0,,Мен Абигейлді жеңдім!
Dialogue: 0,0:11:32.02,0:11:34.77,Default,,0,0,0,,Дирк Шнайдерден күткендей
Dialogue: 0,0:11:34.86,0:11:37.73,Default,,0,0,0,,Жасадық, жеңдік.
Dialogue: 0,0:11:37.82,0:11:40.32,Default,,0,0,0,,Мен сендім.
Dialogue: 0,0:11:40.40,0:11:41.24,Default,,0,0,0,,Король
Dialogue: 0,0:11:41.32,0:11:42.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:42.49,0:11:44.41,Default,,0,0,0,,Енді Шейла...
Dialogue: 0,0:11:44.49,0:11:46.78,Default,,0,0,0,,Жою құдайының мөрі қорғалды.
Dialogue: 0,0:11:46.87,0:11:51.96,Default,,0,0,0,,Ах, рахмет, Дирк Шнайдер.
Dialogue: 0,0:11:53.00,0:11:53.96,Default,,0,0,0,,Уф
Dialogue: 0,0:12:00.21,0:12:02.51,Default,,0,0,0,,О, Дирк Шнайдер!
Dialogue: 0,0:12:02.59,0:12:03.72,Default,,0,0,0,,Сиқырлы күш...
Dialogue: 0,0:12:03.80,0:12:04.93,Default,,0,0,0,,Люс!
Dialogue: 0,0:12:05.01,0:12:06.97,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:12:07.05,0:12:10.60,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:10.68,0:12:12.73,Default,,0,0,0,,Люс Жақсысың ба?
Dialogue: 0,0:12:12.81,0:12:15.19,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:12:15.27,0:12:16.81,Default,,0,0,0,,Люс!
Dialogue: 0,0:12:18.23,0:12:19.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:19.57,0:12:20.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:20.40,0:12:22.49,Default,,0,0,0,,Йо Йоко-сан...
Dialogue: 0,0:12:22.99,0:12:24.03,Default,,0,0,0,,Руше
Dialogue: 0,0:12:25.16,0:12:27.12,Default,,0,0,0,,Соңында -
Dialogue: 0,0:12:27.20,0:12:29.58,Default,,0,0,0,,Осыны айтайын.
Dialogue: 0,0:12:29.66,0:12:31.95,Default,,0,0,0,,Соңғы рет деп айтпа!
Dialogue: 0,0:12:33.04,0:12:33.83,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:12:34.33,0:12:35.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:41.88,0:12:46.84,Default,,0,0,0,,О, мен де, Люс Ренрен де.
Dialogue: 0,0:12:46.93,0:12:48.76,Default,,0,0,0,,Yoko деңгейіндегі жазба
Dialogue: 0,0:12:48.85,0:12:52.22,Default,,0,0,0,,Сені мәңгі сүйемін...
Dialogue: 0,0:12:58.23,0:13:00.61,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:00.69,0:13:02.15,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:13:02.23,0:13:05.53,Default,,0,0,0,,Өтінемін, көзіңді ашшы, Люс!
Dialogue: 0,0:13:05.61,0:13:06.86,Default,,0,0,0,,Люс!
Dialogue: 0,0:13:07.36,0:13:09.33,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:13:09.41,0:13:11.79,Default,,0,0,0,,Жоқ! Жоқ, Дарш!
Dialogue: 0,0:13:11.87,0:13:13.41,Default,,0,0,0,,Дарш!
Dialogue: 0,0:13:13.50,0:13:15.87,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:13:17.00,0:13:18.67,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:13:19.21,0:13:21.88,Default,,0,0,0,,Люс! Люс!
Dialogue: 0,0:13:22.42,0:13:25.01,Default,,0,0,0,,Сенің бұлай өлуің мүмкін емес.
Dialogue: 0,0:13:25.09,0:13:28.72,Default,,0,0,0,,Өтінемін! Өтінемін, көзіңді аш!
Dialogue: 0,0:13:28.80,0:13:31.51,Default,,0,0,0,,Сәлем Люс...
Dialogue: 0,0:13:33.60,0:13:34.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.48,0:13:43.36,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:13:44.11,0:13:46.45,Default,,0,0,0,,Нана...
Dialogue: 0,0:13:47.86,0:13:49.24,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:49.32,0:13:51.45,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:13:51.53,0:13:53.24,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:53.33,0:13:55.58,Default,,0,0,0,,Азғантай сыйлық болса жақсы болар еді.
Dialogue: 0,0:13:56.21,0:13:57.75,Default,,0,0,0,,Уақыт пен орын туралы ойланыңыз!
Dialogue: 0,0:13:57.83,0:13:59.46,Default,,0,0,0,,Ойланып қарасаңыз, мұны істеу дұрыс па?
Dialogue: 0,0:13:59.54,0:14:01.71,Default,,0,0,0,,Жоқ, жоқ! Егер ол жұмыс істемесе, онда жоқ!
Dialogue: 0,0:14:01.79,0:14:04.26,Default,,0,0,0,,Ку... Сен маған қыздығыңды беремін дедің ғой?
Dialogue: 0,0:14:04.34,0:14:05.01,Default,,0,0,0,,Мен олай айтқан жоқпын!
Dialogue: 0,0:14:05.09,0:14:07.51,Default,,0,0,0,,Айттың, естідің!
Dialogue: 0,0:14:07.59,0:14:09.30,Default,,0,0,0,,Айтпасам, айтпадым!
Dialogue: 0,0:14:09.39,0:14:10.93,Default,,0,0,0,,I-
Dialogue: 0,0:14:11.01,0:14:12.76,Default,,0,0,0,,Really, absolutely!
Dialogue: 0,0:14:12.85,0:14:15.18,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:16.89,0:14:18.60,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:18.69,0:14:21.69,Default,,0,0,0,,Ку…хехехе
Dialogue: 0,0:14:22.90,0:14:25.65,Default,,0,0,0,,Бұзық, ақымақ, қатыгез
Dialogue: 0,0:14:25.73,0:14:29.11,Default,,0,0,0,,Рокуденаши жеңілмейді...
Dialogue: 0,0:14:30.45,0:14:31.82,Default,,0,0,0,,Жеңілмейтін...
Dialogue: 0,0:14:32.66,0:14:34.66,Default,,0,0,0,,Бұл шебер.
Dialogue: 0,0:14:34.74,0:14:35.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:35.62,0:14:36.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:39.29,0:14:41.63,Default,,0,0,0,,Әй, Абигейл...
Dialogue: 0,0:14:42.75,0:14:44.75,Default,,0,0,0,,Эй, әлі жоқ...
Dialogue: 0,0:14:44.84,0:14:47.26,Default,,0,0,0,,Аңызға айналған жыннан күткендей
Dialogue: 0,0:14:47.34,0:14:51.64,Default,,0,0,0,,Дегенмен, сізге сиқырлы Пауэр жетіспейтін сияқты.
Dialogue: 0,0:14:51.72,0:14:54.60,Default,,0,0,0,,Қат! Сен қыңыр бейбақсың.
Dialogue: 0,0:14:55.35,0:14:56.31,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:56.39,0:14:59.56,Default,,0,0,0,,Менің енді қарсы тұруға күшім жетпейді.
Dialogue: 0,0:14:59.64,0:15:01.02,Default,,0,0,0,,Қу!
Dialogue: 0,0:15:02.31,0:15:04.02,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:15:04.52,0:15:07.15,Default,,0,0,0,,Жарайсың, жас ханым.
Dialogue: 0,0:15:07.23,0:15:11.16,Default,,0,0,0,,Содан кейін Дарк Шнайдермен бірге шіріп кетіңіз.
Dialogue: 0,0:15:11.24,0:15:12.74,Default,,0,0,0,,Йоко-сан!
Dialogue: 0,0:15:16.08,0:15:18.12,Default,,0,0,0,,Бұл тірек құлап қалады!
Dialogue: 0,0:15:19.20,0:15:19.79,Default,,0,0,0,,Қу!
Dialogue: 0,0:15:19.87,0:15:21.96,Default,,0,0,0,,Йоко-сан, кел!
Dialogue: 0,0:15:22.04,0:15:22.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:23.42,0:15:24.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:24.84,0:15:26.21,Default,,0,0,0,,Йоко-сан!
Dialogue: 0,0:15:26.30,0:15:27.38,Default,,0,0,0,,Кішкентай қыз!
Dialogue: 0,0:15:27.46,0:15:29.51,Default,,0,0,0,,Люс...
Dialogue: 0,0:15:29.59,0:15:31.47,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:15:31.55,0:15:32.72,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:34.72,0:15:35.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:37.77,0:15:38.93,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:15:39.02,0:15:40.52,Default,,0,0,0,,Сіз туралы...
Dialogue: 0,0:15:40.60,0:15:42.85,Default,,0,0,0,,Не?
Dialogue: 0,0:15:42.94,0:15:44.44,Default,,0,0,0,,Йоко-сан!
Dialogue: 0,0:15:44.52,0:15:47.40,Default,,0,0,0,,Йоко!
Dialogue: 0,0:15:48.15,0:15:51.78,Default,,0,0,0,,Мен... сен туралы...
Dialogue: 0,0:15:54.03,0:15:56.41,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:15:56.49,0:15:57.62,Default,,0,0,0,,Иә...!
Dialogue: 0,0:16:00.66,0:16:02.71,Default,,0,0,0,,Ахх~
Dialogue: 0,0:16:02.79,0:16:03.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:03.83,0:16:06.21,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:16:07.00,0:16:12.09,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:21.56,0:16:25.81,Default,,0,0,0,,Күндіз болса да, неге түн сияқты қараңғы?
Dialogue: 0,0:16:25.90,0:16:27.56,Default,,0,0,0,,Қараңыз! Король сарайы...
Dialogue: 0,0:16:27.65,0:16:29.36,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:16:29.94,0:16:33.32,Default,,0,0,0,,Сәлем! Бұл дүниенің соңы
Dialogue: 0,0:16:33.40,0:16:36.32,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:16:40.08,0:16:41.95,Default,,0,0,0,,О!
Dialogue: 0,0:16:44.16,0:16:46.21,Default,,0,0,0,,Йо Йоко…
Dialogue: 0,0:16:46.88,0:16:49.75,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:16:49.84,0:16:51.46,Default,,0,0,0,,Nu...
Dialogue: 0,0:16:53.63,0:16:56.89,Default,,0,0,0,,Ха! Да Дирк Шнайдер
Dialogue: 0,0:16:59.72,0:17:00.81,Default,,0,0,0,,Дарш!
Dialogue: 0,0:17:06.31,0:17:07.44,Default,,0,0,0,,Дарш!
Dialogue: 0,0:17:09.40,0:17:10.52,Default,,0,0,0,,Дарш…
Dialogue: 0,0:17:12.78,0:17:14.28,Default,,0,0,0,,Қараңғы Шнайдер! Ней!
Dialogue: 0,0:17:14.36,0:17:14.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:18.45,0:17:19.32,Default,,0,0,0,,Гала...
Dialogue: 0,0:17:19.91,0:17:20.74,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:17:26.33,0:17:29.21,Default,,0,0,0,,Агия агья! Аги
Dialogue: 0,0:17:29.29,0:17:30.13,Default,,0,0,0,,Нуо!
Dialogue: 0,0:17:30.21,0:17:31.92,Default,,0,0,0,,О~
Dialogue: 0,0:17:32.00,0:17:34.38,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:17:34.47,0:17:35.38,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:38.34,0:17:41.31,Default,,0,0,0,,Әй, жоғалып барады
Dialogue: 0,0:17:41.39,0:17:44.31,Default,,0,0,0,,everything everything
Dialogue: 0,0:17:56.20,0:17:58.49,Default,,0,0,0,,Хмм... Йоко-сан
Dialogue: 0,0:18:01.20,0:18:02.79,Default,,0,0,0,,♪～
Dialogue: 0,0:18:02.87,0:18:04.79,Default,,0,0,0,,Сіз шынымен Люссіз бе?
Dialogue: 0,0:18:05.33,0:18:07.33,Default,,0,0,0,,Сіз маған бағынбауға тырысасыз ба?
Dialogue: 0,0:18:07.41,0:18:08.92,Default,,0,0,0,,Айтатын нәрсе...
Dialogue: 0,0:18:09.00,0:18:11.25,Default,,0,0,0,,Өйткені, сен Люс-кунсың.
Dialogue: 0,0:18:11.34,0:18:13.30,Default,,0,0,0,,Маған Люс-кунымды қайтарып бер.
Dialogue: 0,0:18:13.38,0:18:14.13,Default,,0,0,0,,Өйткені Йоко-сан
Dialogue: 0,0:18:14.21,0:18:15.71,Default,,0,0,0,,Мен де жалмауызмын.
Dialogue: 0,0:18:15.80,0:18:18.38,Default,,0,0,0,,Люс Мен үшін уайымдама, тек күрес!
Dialogue: 0,0:18:18.47,0:18:19.59,Default,,0,0,0,,Мен туралы...
Dialogue: 0,0:18:19.68,0:18:21.68,Default,,0,0,0,,Мен де сені жақсы көремін...
Dialogue: 0,0:18:41.41,0:18:42.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:43.66,0:18:44.91,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:18:46.04,0:18:47.33,Default,,0,0,0,,Люс...
Dialogue: 0,0:19:35.42,0:19:39.30,Default,,0,0,0,,Металликананың патша сарайы жоғалып кетті ме?
Dialogue: 0,0:19:39.88,0:19:40.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:41.72,0:19:44.68,Default,,0,0,0,,Бұл жағдайда ешкім өмір сүре алмайды.
Dialogue: 0,0:19:46.22,0:19:49.85,Default,,0,0,0,,Абигейл қайтыс болғаннан кейін күшті рухани қорғаныс жоғалып кетті.
Dialogue: 0,0:19:49.93,0:19:54.98,Default,,0,0,0,,Хаостың күші сол жерде өтетін жолға шықты.
Dialogue: 0,0:19:55.48,0:20:00.99,Default,,0,0,0,,Енді біз, Бірінші Армия, жалғыз қара көтерілісшілер әскері қалды.
Dialogue: 0,0:20:01.49,0:20:05.07,Default,,0,0,0,,Бұл оның іс жүзінде құлағанын білдіреді.
Dialogue: 0,0:20:05.62,0:20:06.49,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.58,0:20:11.33,Default,,0,0,0,,Алайда, Каль-сама үшін әскердің аман қалуы болмашы мәселеден басқа ештеңе емес.
Dialogue: 0,0:20:12.21,0:20:16.42,Default,,0,0,0,,Бұл адамның қарап тұрғаны алыс және кең.
Dialogue: 0,0:20:17.46,0:20:19.76,Default,,0,0,0,,Сіз қайтадан ұйықтап қалдыңыз ба?
Dialogue: 0,0:20:23.22,0:20:26.72,Default,,0,0,0,,Ескі дүниенің қараңғылығынан туған жойқын Құдай
Dialogue: 0,0:20:27.85,0:20:30.10,Default,,0,0,0,,Армандау – ессіздік
Dialogue: 0,0:20:30.18,0:20:32.10,Default,,0,0,0,,Әлде өлім бе?
Dialogue: 0,0:22:39.81,0:22:42.86,Default,,0,0,0,,Металликана құлыпының жоғалуы
Dialogue: 0,0:22:43.61,0:22:47.07,Default,,0,0,0,,Ол — жойылу Құдайының мөрі.
Dialogue: 0,0:22:47.15,0:22:50.61,Default,,0,0,0,,Металликана ханшайымы Шейла Тоэльдің тағдыры қандай?
Dialogue: 0,0:22:51.41,0:22:53.41,Default,,0,0,0,,Металликана сарайында болғандар
Dialogue: 0,0:22:53.49,0:22:55.79,Default,,0,0,0,,Барлық мәліметтер олардың қайда екені белгісіз.
Dialogue: 0,0:22:55.87,0:22:56.79,Default,,0,0,0,,Хмм
Dialogue: 0,0:22:57.33,0:23:00.42,Default,,0,0,0,,Пломбаны қорғалған деп санау керек пе?
Dialogue: 0,0:23:00.50,0:23:01.50,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:23:02.96,0:23:04.13,Default,,0,0,0,,Біз сонда барамыз.
Dialogue: 0,0:23:04.21,0:23:05.00,Default,,0,0,0,,Не?
Dialogue: 0,0:23:05.09,0:23:06.46,Default,,0,0,0,,Зиянкес
Dialogue: 0,0:23:09.80,0:23:11.64,Default,,0,0,0,,Түннің бір уағында бұл қандай қаскүнем?
Dialogue: 0,0:23:12.30,0:23:14.93,Default,,0,0,0,,Жасырын ауыл болып табылатын самурайлар резиденциясының орнын неліктен білесіңдер?
Dialogue: 0,0:23:15.01,0:23:16.14,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:23:16.22,0:23:17.52,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:23:18.10,0:23:20.98,Default,,0,0,0,,Мүмкін ол көтерілісшілер әскерінің барлаушысы шығар?
Dialogue: 0,0:23:29.57,0:23:30.28,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:34.24,0:23:35.58,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:23:36.08,0:23:36.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:36.95,0:23:37.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:39.33,0:23:41.29,Default,,0,0,0,,Сіз самурайсыз ба?
Dialogue: 0,0:23:41.37,0:23:44.42,Default,,0,0,0,,Мына баланы маған беріңізші...
Dialogue: 0,0:23:44.50,0:23:47.42,Default,,0,0,0,,Люсқа көмектес!
Dialogue: 0,0:23:47.50,0:23:50.97,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:23:52.47,0:23:58.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
