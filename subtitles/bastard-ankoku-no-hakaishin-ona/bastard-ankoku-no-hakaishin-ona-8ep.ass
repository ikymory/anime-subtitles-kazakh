Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:09.96,Default,,0,0,0,,NETFLIX аниме сериясы
Dialogue: 0,0:00:13.51,0:00:15.14,Default,,0,0,0,,Йоко-сан
Dialogue: 0,0:00:15.76,0:00:18.10,Default,,0,0,0,,Эй, сен қайдасың?
Dialogue: 0,0:00:18.60,0:00:19.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:21.31,0:00:22.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:27.98,0:00:29.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:32.57,0:00:35.32,Default,,0,0,0,,Ах! Йоконың бөксесі
Dialogue: 0,0:00:35.41,0:00:36.82,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:00:36.91,0:00:38.45,Default,,0,0,0,,Хун
Dialogue: 0,0:00:38.53,0:00:40.99,Default,,0,0,0,,Яй Йоко-сан
Dialogue: 0,0:00:41.54,0:00:43.83,Default,,0,0,0,,Сіз...сіз...
Dialogue: 0,0:00:45.21,0:00:47.92,Default,,0,0,0,,Люс-кун!
Dialogue: 0,0:00:48.54,0:00:49.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:59.93,0:01:01.14,Default,,0,0,0,,Люс-кун!
Dialogue: 0,0:01:01.22,0:01:04.77,Default,,0,0,0,,Сен...сен...неге...
Dialogue: 0,0:01:05.89,0:01:07.02,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:01:07.10,0:01:08.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:08.44,0:01:10.65,Default,,0,0,0,,Ниндзя Фортынан қайтар жолда
Dialogue: 0,0:01:10.73,0:01:12.57,Default,,0,0,0,,Өйткені ол кенет жоғалып кетеді
Dialogue: 0,0:01:12.65,0:01:14.49,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:01:14.57,0:01:16.24,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:01:16.32,0:01:17.45,Default,,0,0,0,,Ммм
Dialogue: 0,0:01:18.28,0:01:19.66,Default,,0,0,0,,Йоко-доно!
Dialogue: 0,0:01:19.74,0:01:23.50,Default,,0,0,0,,Қазір не болып жатыр? Не болып жатыр?
Dialogue: 0,0:01:23.58,0:01:24.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:25.37,0:01:28.88,Default,,0,0,0,,К...кяаа
Dialogue: 0,0:01:33.88,0:01:34.55,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:01:34.63,0:01:37.38,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:01:37.47,0:01:40.10,Default,,0,0,0,,Менің дөрекілігімді кешіріңіз, ханым.
Dialogue: 0,0:01:40.18,0:01:42.76,Default,,0,0,0,,Мен айқай естідім және кенеттен
Dialogue: 0,0:01:42.85,0:01:46.02,Default,,0,0,0,,Сен мені қорғап тұрсың.
Dialogue: 0,0:01:46.10,0:01:47.98,Default,,0,0,0,,Менің басқа амалым жоқ...
Dialogue: 0,0:01:48.06,0:01:50.31,Default,,0,0,0,,Оны Люс-кун да көрді.
Dialogue: 0,0:01:50.40,0:01:51.94,Default,,0,0,0,,Могу Могу
Dialogue: 0,0:01:52.02,0:01:54.86,Default,,0,0,0,,Сонда да неге жер бетінде...
Dialogue: 0,0:01:54.94,0:01:55.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:55.78,0:02:00.37,Default,,0,0,0,,Ал... Менің тапсырмам орындалды деп ойлаймын.
Dialogue: 0,0:02:01.20,0:02:04.37,Default,,0,0,0,,Қымбатты Йоко, сенен сұрайтыным бар...
Dialogue: 0,0:02:05.08,0:02:08.16,Default,,0,0,0,,Бұл бала шынымен... бұл...
Dialogue: 0,0:02:08.25,0:02:10.71,Default,,0,0,0,,Иә, бұл біздің Люс.
Dialogue: 0,0:02:11.46,0:02:12.96,Default,,0,0,0,,Осындай бала...
Dialogue: 0,0:02:13.04,0:02:16.63,Default,,0,0,0,,Аңызға айналған демон Дарк Шнайдердің шынайы тұлғасы қандай?
Dialogue: 0,0:02:16.71,0:02:18.68,Default,,0,0,0,,Иә? Сол кішкентай айдаһар...
Dialogue: 0,0:02:18.76,0:02:20.59,Default,,0,0,0,,Хмм (Ларс) Агия Агия!
Dialogue: 0,0:02:20.68,0:02:24.60,Default,,0,0,0,,О! Сіз менің үйімде мерекелік кеште болған Ларс емес екеніңізге сенімдімін.
Dialogue: 0,0:02:24.68,0:02:25.85,Default,,0,0,0,,Агия!
Dialogue: 0,0:02:26.35,0:02:28.39,Default,,0,0,0,,Ниндзя шебері Гала!
Dialogue: 0,0:02:29.14,0:02:31.06,Default,,0,0,0,,Істер жақсы жүріп жатыр
Dialogue: 0,0:02:31.15,0:02:32.86,Default,,0,0,0,,Бұл қандай да бір тұзақ болуы мүмкін.
Dialogue: 0,0:02:33.36,0:02:34.73,Default,,0,0,0,,Мені қате түсінбеңіз
Dialogue: 0,0:02:34.82,0:02:37.53,Default,,0,0,0,,Гала азғын, бірақ ол жаман емес.
Dialogue: 0,0:02:38.03,0:02:41.07,Default,,0,0,0,,Мен бұл баланың бойынан ешқандай жамандықты сезінбеймін.
Dialogue: 0,0:02:41.16,0:02:43.95,Default,,0,0,0,,Менің интуициям өте дәл.
Dialogue: 0,0:02:44.03,0:02:45.54,Default,,0,0,0,,Оған сеніңіз
Dialogue: 0,0:02:46.08,0:02:48.41,Default,,0,0,0,,Егер Йоко-доно солай айтса...
Dialogue: 0,0:02:48.50,0:02:49.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:49.83,0:02:52.00,Default,,0,0,0,,Қалай болғанда да, Ларс деген не...
Dialogue: 0,0:02:52.83,0:02:56.96,Default,,0,0,0,,Менің Металликана ханзадасы Шейла ханшайымның ағасымен бірдей...
Dialogue: 0,0:02:57.05,0:02:58.59,Default,,0,0,0,,Бұл ирониялық...
Dialogue: 0,0:02:59.09,0:03:00.93,Default,,0,0,0,,Осыдан 15 жыл бұрынғы соғыста
Dialogue: 0,0:03:01.01,0:03:04.64,Default,,0,0,0,,Дарк Шнайдерді жеңу үшін тыйым салынған құпия әдіс қолданылды.
Dialogue: 0,0:03:04.72,0:03:07.14,Default,,0,0,0,,Ханзада Раның Ур Металликанасы
Dialogue: 0,0:03:07.72,0:03:11.39,Default,,0,0,0,,Ол пайғамбарлық кітабында аты аңызға айналған айдаһар жауынгеріне айналды.
Dialogue: 0,0:03:11.48,0:03:14.06,Default,,0,0,0,,Төрт кейіпкермен, соның ішінде Геодоно
Dialogue: 0,0:03:14.15,0:03:18.28,Default,,0,0,0,,Ол осы континенттегі төрт патшалықты құтқарған супер қаһарман.
Dialogue: 0,0:03:18.36,0:03:21.45,Default,,0,0,0,,Оның Дирк Шнайдермен пышақтасып кеткені айтылады.
Dialogue: 0,0:03:21.95,0:03:24.24,Default,,0,0,0,,Оның өмірі мен өлімі әлі белгісіз...
Dialogue: 0,0:03:24.32,0:03:25.58,Default,,0,0,0,,Бұл батырлық ертегі.
Dialogue: 0,0:03:25.66,0:03:27.49,Default,,0,0,0,,Күтпеген жерден әлгі кішкентай айдаһар
Dialogue: 0,0:03:27.58,0:03:30.04,Default,,0,0,0,,Бұл ханзада Ларстың реинкарнациясы болуы мүмкін.
Dialogue: 0,0:03:30.12,0:03:31.62,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:03:31.71,0:03:33.04,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:34.46,0:03:36.04,Default,,0,0,0,,Лорд Эрл...
Dialogue: 0,0:03:36.13,0:03:40.34,Default,,0,0,0,,Біз қалаған ауыл қыздарын сатып алдық.
Dialogue: 0,0:03:40.42,0:03:42.51,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:03:42.59,0:03:47.47,Default,,0,0,0,,Жоғарыда айтқанымдай, олардың бәрі менің қыздарым, солай ма?
Dialogue: 0,0:03:47.56,0:03:49.43,Default,,0,0,0,,Джодо?
Dialogue: 0,0:03:49.52,0:03:50.73,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:03:50.81,0:03:53.65,Default,,0,0,0,,Уәде етілгендей, қараңызшы.
Dialogue: 0,0:03:53.73,0:03:55.90,Default,,0,0,0,,Граф Дай Амон
Dialogue: 0,0:04:00.07,0:04:01.15,Default,,0,0,0,,Қылмыс деңгейінің төмендегені туралы сол мәлімдеме...
Dialogue: 0,0:04:01.24,0:04:02.95,Default,,0,0,0,,...
Dialogue: 0,0:04:03.03,0:04:04.99,Default,,0,0,0,,Саған қалай ұнады, граф?
Dialogue: 0,0:04:05.07,0:04:07.66,Default,,0,0,0,,Осы Джодоның адалдығы
Dialogue: 0,0:04:07.74,0:04:09.58,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:04:09.66,0:04:14.46,Default,,0,0,0,,Пу... тіпті екі Киду Санниншу.
Dialogue: 0,0:04:14.54,0:04:18.42,Default,,0,0,0,,Оны Дирк Шнайдер жыртып алған.
Dialogue: 0,0:04:18.50,0:04:22.97,Default,,0,0,0,,Бірақ бұл Дай Амон басқа.
Dialogue: 0,0:04:23.63,0:04:25.97,Default,,0,0,0,,Өлмейтін дене және
Dialogue: 0,0:04:26.05,0:04:30.39,Default,,0,0,0,,Мен мәңгілік өмірге ие болдым!
Dialogue: 0,0:04:30.47,0:04:33.39,Default,,0,0,0,,Енді тіпті Лорд Неймен салыстыруға болады.
Dialogue: 0,0:04:33.98,0:04:37.40,Default,,0,0,0,,Менің сиқырлы күшімді одан сайын күшейту
Dialogue: 0,0:04:37.48,0:04:41.94,Default,,0,0,0,,Бізге жас қыздарымыздың қаны керек.
Dialogue: 0,0:04:42.03,0:04:45.28,Default,,0,0,0,,Түсіндің бе, Джодо?
Dialogue: 0,0:04:45.36,0:04:47.12,Default,,0,0,0,,Хаха! Бұл қазірдің өзінде...
Dialogue: 0,0:04:47.20,0:04:48.83,Default,,0,0,0,,Сонда!
Dialogue: 0,0:04:50.54,0:04:55.21,Default,,0,0,0,,Неліктен бұл қыз сенің биологиялық қызың емес?
Dialogue: 0,0:04:55.29,0:04:58.08,Default,,0,0,0,,Иә, бұл өтірік! Сондай ақымақ!
Dialogue: 0,0:04:58.17,0:05:01.55,Default,,0,0,0,,Жоқ, Джодо.
Dialogue: 0,0:05:01.63,0:05:05.88,Default,,0,0,0,,Уәдесінде тұрмағандарды құртамын.
Dialogue: 0,0:05:05.97,0:05:09.01,Default,,0,0,0,,Бұл өте кешірілмейтін сияқты.
Dialogue: 0,0:05:09.10,0:05:11.18,Default,,0,0,0,,Ахх! Міне бітті!
Dialogue: 0,0:05:11.26,0:05:12.27,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:05:12.35,0:05:14.23,Default,,0,0,0,,Бұл қандай да бір қателік...
Dialogue: 0,0:05:14.31,0:05:18.19,Default,,0,0,0,,Мен сенің қаныңды сорамын!
Dialogue: 0,0:05:24.65,0:05:27.28,Default,,0,0,0,,А, бұл жаман болды...
Dialogue: 0,0:05:27.95,0:05:29.53,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:29.62,0:05:33.20,Default,,0,0,0,,Шикі қызын аулауға шыққан басқалардың жетістіктері қандай болды?
Dialogue: 0,0:05:33.29,0:05:35.04,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:35.12,0:05:37.83,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,0:05:37.92,0:05:40.34,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:05:41.00,0:05:43.55,Default,,0,0,0,,Хэ-хэ-хэ, үлкен аулау.
Dialogue: 0,0:05:43.63,0:05:44.51,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:45.42,0:05:48.51,Default,,0,0,0,,Әр адам міндетті түрде қыздың иісін сезеді.
Dialogue: 0,0:05:49.93,0:05:53.51,Default,,0,0,0,,Бұл әлі де жақсы ай.
Dialogue: 0,0:05:53.60,0:05:55.48,Default,,0,0,0,,Менің қаным қайнап жатыр~
Dialogue: 0,0:05:58.64,0:06:01.15,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:01.23,0:06:03.02,Default,,0,0,0,,Кяаа! тістер!
Dialogue: 0,0:06:03.11,0:06:04.15,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:04.23,0:06:06.11,Default,,0,0,0,,Ай!
Dialogue: 0,0:06:10.16,0:06:13.87,Default,,0,0,0,,Қарашы, енді келмесең, суық тиіп қаласың.
Dialogue: 0,0:06:13.95,0:06:15.45,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:06:15.54,0:06:16.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:17.12,0:06:17.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:18.33,0:06:21.33,Default,,0,0,0,,Бұл не зұлымдық бар ...
Dialogue: 0,0:06:22.21,0:06:24.09,Default,,0,0,0,,үшінң ояныңдар!
Dialogue: 0,0:06:24.17,0:06:27.05,Default,,0,0,0,,(Алау)
Dialogue: 0,0:06:27.13,0:06:28.84,Default,,0,0,0,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:06:31.01,0:06:33.01,Default,,0,0,0,,Таптым!
Dialogue: 0,0:06:33.10,0:06:35.39,Default,,0,0,0,,Кя! Бұл не?
Dialogue: 0,0:06:35.47,0:06:37.35,Default,,0,0,0,,Ей, қасқыр!
Dialogue: 0,0:06:37.43,0:06:39.56,Default,,0,0,0,,Бұл қыздың иісі!
Dialogue: 0,0:06:39.64,0:06:41.77,Default,,0,0,0,,Бұл жігіт қарсылықсыз~
Dialogue: 0,0:06:41.85,0:06:43.23,Default,,0,0,0,,Бұл жоғары сапалы доп.
Dialogue: 0,0:06:43.31,0:06:45.02,Default,,0,0,0,,Жоқ! Йоко-дононы қорғаңыз!
Dialogue: 0,0:06:45.11,0:06:47.44,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,0:06:47.53,0:06:49.53,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:06:50.49,0:06:53.74,Default,,0,0,0,,Хехехе, графқа тым жақсы.
Dialogue: 0,0:06:53.83,0:06:55.66,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,0:06:55.74,0:06:56.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:56.41,0:06:57.62,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:06:57.70,0:06:59.46,Default,,0,0,0,,(жалау дыбысы)
Dialogue: 0,0:06:59.54,0:07:00.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:00.92,0:07:01.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.62,0:07:02.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:02.88,0:07:04.71,Default,,0,0,0,,Таза қолмен Йокоға
Dialogue: 0,0:07:04.79,0:07:06.59,Default,,0,0,0,,Маған тиісуге тырыспа!
Dialogue: 0,0:07:06.67,0:07:09.51,Default,,0,0,0,,Мына бала қандай?
Dialogue: 0,0:07:10.09,0:07:12.51,Default,,0,0,0,,Маған кішкене болса да тиіп кетсең, мен сені өлтіремін.
Dialogue: 0,0:07:12.59,0:07:14.47,Default,,0,0,0,,Лорд Ван!
Dialogue: 0,0:07:14.55,0:07:17.18,Default,,0,0,0,,Жоқ, бұл сенің дауысың емес, Люс.
Dialogue: 0,0:07:17.27,0:07:19.14,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:07:19.23,0:07:21.48,Default,,0,0,0,,Мына бала қорқып жынды болды ма?
Dialogue: 0,0:07:21.56,0:07:24.15,Default,,0,0,0,,Мен сені талқандаймын
Dialogue: 0,0:07:24.23,0:07:27.11,Default,,0,0,0,,Бұл ит ит...
Dialogue: 0,0:07:27.19,0:07:28.07,Default,,0,0,0,,Не?
Dialogue: 0,0:07:28.15,0:07:31.82,Default,,0,0,0,,Иттей жүзіңді маған қаратпа!
Dialogue: 0,0:07:34.82,0:07:36.20,Default,,0,0,0,,Бұл жын...
Dialogue: 0,0:07:36.28,0:07:39.58,Default,,0,0,0,,Бұл бала жай адам емес.
Dialogue: 0,0:07:40.50,0:07:41.79,Default,,0,0,0,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:07:41.87,0:07:44.17,Default,,0,0,0,,Мені Гала ұрлап кеткен түні...
Dialogue: 0,0:07:45.38,0:07:47.38,Default,,0,0,0,,Басқа адам сияқты
Dialogue: 0,0:07:48.25,0:07:49.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.26,0:07:53.05,Default,,0,0,0,,Эй, сен сиқыршысың ба?
Dialogue: 0,0:07:53.13,0:07:54.43,Default,,0,0,0,,Баркер...
Dialogue: 0,0:07:54.51,0:07:57.93,Default,,0,0,0,,Қауіпті адамдай азу тістеріңді жалаңаштаңдар.
Dialogue: 0,0:07:58.01,0:07:59.77,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:07:59.85,0:08:02.23,Default,,0,0,0,,Қазір мен саған сиыр етінен ет жасаймын.
Dialogue: 0,0:08:02.31,0:08:04.69,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:08:04.77,0:08:06.23,Default,,0,0,0,,Бұл бала
Dialogue: 0,0:08:06.31,0:08:08.77,Default,,0,0,0,,Өлме!
Dialogue: 0,0:08:10.32,0:08:12.07,Default,,0,0,0,,...
Dialogue: 0,0:08:12.15,0:08:13.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:13.28,0:08:14.28,Default,,0,0,0,,Ахха~
Dialogue: 0,0:08:14.36,0:08:16.28,Default,,0,0,0,,Баака Қағба!
Dialogue: 0,0:08:16.78,0:08:18.41,Default,,0,0,0,,Қандай сиқыршы?
Dialogue: 0,0:08:18.49,0:08:22.21,Default,,0,0,0,,Бір сәт сиқырламасаңыз, онда қорқынышты ештеңе жоқ.
Dialogue: 0,0:08:22.29,0:08:25.54,Default,,0,0,0,,Не керек, мен адам болған кезімде жекпе-жек өнерпаз едім!
Dialogue: 0,0:08:25.63,0:08:28.04,Default,,0,0,0,,Аң адамға айналғандағы жылдамдық
Dialogue: 0,0:08:28.13,0:08:31.09,Default,,0,0,0,,Әлсіз сиқыршыларға ермеңіз!
Dialogue: 0,0:08:31.17,0:08:31.96,Default,,0,0,0,,Гуа!
Dialogue: 0,0:08:32.51,0:08:33.67,Default,,0,0,0,,Гаки!
Dialogue: 0,0:08:33.76,0:08:37.14,Default,,0,0,0,,Мына сұлу мені ит дейсің~
Dialogue: 0,0:08:37.22,0:08:38.35,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:08:38.43,0:08:39.43,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:08:39.51,0:08:42.98,Default,,0,0,0,,Сіздің санаңыз Дирк Шнайдер болса да, сіздің денеңіз бәрібір Люс-кун.
Dialogue: 0,0:08:43.06,0:08:44.23,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:08:44.73,0:08:47.10,Default,,0,0,0,,Бұл да жеткілікті!
Dialogue: 0,0:08:47.94,0:08:49.40,Default,,0,0,0,,Бугаах!
Dialogue: 0,0:08:49.90,0:08:51.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:53.15,0:08:55.28,Default,,0,0,0,,Мишитаның жеңілген кейіпкері
Dialogue: 0,0:08:55.36,0:08:57.66,Default,,0,0,0,,Ол бірнеше рет қатарынан кесілгеннен кейін жабайы болды.
Dialogue: 0,0:08:57.74,0:09:00.74,Default,,0,0,0,,Көрермендер абдырап қалады!
Dialogue: 0,0:09:00.83,0:09:03.29,Default,,0,0,0,,Келіңіздер, кешіріңіздер!
Dialogue: 0,0:09:03.37,0:09:07.00,Default,,0,0,0,,Бұл бала шын мәнінде Дирк Шнайдер.
Dialogue: 0,0:09:07.08,0:09:09.46,Default,,0,0,0,,Бірақ не болып жатыр?
Dialogue: 0,0:09:09.54,0:09:12.55,Default,,0,0,0,,Уау, неткен ақымақ күш.
Dialogue: 0,0:09:13.05,0:09:14.97,Default,,0,0,0,,Эй, сен шынымен сиқыршысың ба?
Dialogue: 0,0:09:15.05,0:09:18.14,Default,,0,0,0,,Хмм, не көргің келеді? Сиқыр?
Dialogue: 0,0:09:18.22,0:09:19.89,Default,,0,0,0,,Ха! А... жоқ...
Dialogue: 0,0:09:19.97,0:09:22.18,Default,,0,0,0,,Ккк солай!
Dialogue: 0,0:09:22.27,0:09:24.31,Default,,0,0,0,,Олай болса, саған ерекше бір нәрсе көрсетейік!
Dialogue: 0,0:09:24.39,0:09:25.85,Default,,0,0,0,,А...иә...күте тұрыңыз...
Dialogue: 0,0:09:25.94,0:09:27.60,Default,,0,0,0,,Зазард Зазард
Dialogue: 0,0:09:27.69,0:09:28.69,Default,,0,0,0,,Скронор Роносук
Dialogue: 0,0:09:28.77,0:09:30.57,Default,,0,0,0,,Ах! Сол сиқыр...
Dialogue: 0,0:09:30.65,0:09:31.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:31.36,0:09:34.86,Default,,0,0,0,,Қап-қара түнектің қойнауында жанып тұрған тозақ оты.
Dialogue: 0,0:09:34.94,0:09:36.82,Default,,0,0,0,,Мен сенен күтпедім...!
Dialogue: 0,0:09:36.90,0:09:38.07,Default,,0,0,0,,Уф... бұл өтірік!
Dialogue: 0,0:09:38.16,0:09:41.66,Default,,0,0,0,,Менің семсерім болып, жауды жой!
Dialogue: 0,0:09:42.33,0:09:42.99,Default,,0,0,0,,Бенон!
Dialogue: 0,0:09:43.08,0:09:44.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:45.04,0:09:46.75,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:46.83,0:09:49.58,Default,,0,0,0,,Әлі тірі! Хахахаха!
Dialogue: 0,0:09:49.67,0:09:51.71,Default,,0,0,0,,Керемет қасқыр!
Dialogue: 0,0:09:51.79,0:09:55.05,Default,,0,0,0,,Уау, бұл өмірлік күш! Өте керемет!
Dialogue: 0,0:09:55.13,0:09:56.42,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:09:56.51,0:09:58.68,Default,,0,0,0,,Бұл сиқырдың күші ме?
Dialogue: 0,0:09:58.76,0:10:01.10,Default,,0,0,0,,Ауырды, ауырады, ауырады!
Dialogue: 0,0:10:01.18,0:10:02.14,Default,,0,0,0,,Сонша шуламаңыз!
Dialogue: 0,0:10:02.22,0:10:06.73,Default,,0,0,0,,Кукк   Жүр, сені қалай өлтіремін?
Dialogue: 0,0:10:06.81,0:10:09.90,Default,,0,0,0,,Сәлем~ Тоқта, тоқта, айқайлама!
Dialogue: 0,0:10:09.98,0:10:13.65,Default,,0,0,0,,Мені өлтірме, граф!
Dialogue: 0,0:10:13.73,0:10:16.82,Default,,0,0,0,,Эй, бұл графтың иті ғой...
Dialogue: 0,0:10:17.36,0:10:18.90,Default,,0,0,0,,Қыздарды аулау және жинау
Dialogue: 0,0:10:18.99,0:10:23.66,Default,,0,0,0,,Қасқырларды қанатының астына алатын графтың түрі емес пе?
Dialogue: 0,0:10:23.74,0:10:25.08,Default,,0,0,0,,Вампир, солай ма?
Dialogue: 0,0:10:25.16,0:10:25.79,Default,,0,0,0,,Уф
Dialogue: 0,0:10:25.87,0:10:27.54,Default,,0,0,0,,Вампир?
Dialogue: 0,0:10:27.62,0:10:29.92,Default,,0,0,0,,Сәлем, мен бірдеңеге кептеліп тұрмын.
Dialogue: 0,0:10:30.00,0:10:31.33,Default,,0,0,0,,Вампир дегеніміз не?
Dialogue: 0,0:10:31.42,0:10:34.34,Default,,0,0,0,,Бұл өлмегендер арасындағы ең жоғары дәрежелі құбыжық.
Dialogue: 0,0:10:34.42,0:10:37.01,Default,,0,0,0,,Кай-Херн есімді әйел граф дейді
Dialogue: 0,0:10:37.55,0:10:38.63,Default,,0,0,0,,Өз еркімен
Dialogue: 0,0:10:38.72,0:10:41.05,Default,,0,0,0,,Сіз вампирге айналдым демейсіз бе?
Dialogue: 0,0:10:41.14,0:10:43.47,Default,,0,0,0,,Демек, бұл Нағыз Баба, солай ма?
Dialogue: 0,0:10:43.55,0:10:48.52,Default,,0,0,0,,Неліктен сонша сиқырлы күшке ие адам Аркастың бағыныштысы болып табылады?
Dialogue: 0,0:10:48.60,0:10:49.44,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:50.02,0:10:52.90,Default,,0,0,0,,Кай Хан? Күл?
Dialogue: 0,0:10:54.65,0:10:56.07,Default,,0,0,0,,Граф бұл-
Dialogue: 0,0:10:56.15,0:11:00.32,Default,,0,0,0,,Сиқырлы күшін одан әрі арттыру үшін Эшет пен Кальдің орнына ұмтылу
Dialogue: 0,0:11:00.40,0:11:03.74,Default,,0,0,0,,Бізге жоғары сапалы қанның көп мөлшері қажет.
Dialogue: 0,0:11:03.82,0:11:05.12,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:11:05.20,0:11:05.91,Default,,0,0,0,,Уггугу!
Dialogue: 0,0:11:05.99,0:11:09.12,Default,,0,0,0,,Айтпасаң мен сені өлтіремін.
Dialogue: 0,0:11:09.21,0:11:10.58,Default,,0,0,0,,Мен... айтамын!
Dialogue: 0,0:11:10.67,0:11:13.38,Default,,0,0,0,,Мені өлтірме, жарай ма? Не! Не!
Dialogue: 0,0:11:13.92,0:11:16.88,Default,,0,0,0,,А, мен уәдемді орындаймын.
Dialogue: 0,0:11:17.38,0:11:18.34,Default,,0,0,0,,Тез айт
Dialogue: 0,0:11:18.42,0:11:20.30,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:20.80,0:11:24.05,Default,,0,0,0,,Міне...дәл солай. Гуаа!
Dialogue: 0,0:11:24.14,0:11:25.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:26.85,0:11:31.10,Default,,0,0,0,,Вампир... бұл қиын болады.
Dialogue: 0,0:11:31.19,0:11:32.35,Default,,0,0,0,,Сәлем Люс!
Dialogue: 0,0:11:32.44,0:11:33.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:33.81,0:11:36.32,Default,,0,0,0,,Қанша жау болсаң да, дәл қазір жетпейді!
Dialogue: 0,0:11:36.40,0:11:36.98,Default,,0,0,0,,Және...
Dialogue: 0,0:11:37.07,0:11:38.90,Default,,0,0,0,,Сіз өте шулысыз...
Dialogue: 0,0:11:38.98,0:11:41.57,Default,,0,0,0,,Танысқанымызға көп болды, бірақ тағы да уағыз айтасың!
Dialogue: 0,0:11:41.65,0:11:42.41,Default,,0,0,0,,Және... (Дирк Шнайдер)
Dialogue: 0,0:11:42.49,0:11:45.57,Default,,0,0,0,,Неліктен Ниндзя Фортынан қайтар жолда жоғалып кеттіңіз?
Dialogue: 0,0:11:45.66,0:11:47.79,Default,,0,0,0,,Осы уақытқа дейін не істедіңіз?
Dialogue: 0,0:11:47.87,0:11:50.45,Default,,0,0,0,,Неліктен өз пішініңді өзгерттің, Люс?
Dialogue: 0,0:11:50.54,0:11:52.29,Default,,0,0,0,,Түсіндірмесеңіз, біз ешқашан тіл табыса алмаймыз!
Dialogue: 0,0:11:52.87,0:11:54.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:54.33,0:11:55.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:58.13,0:11:59.51,Default,,0,0,0,,Мистер Люс...
Dialogue: 0,0:11:59.59,0:12:01.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:01.84,0:12:04.47,Default,,0,0,0,,Кай Хан мен Күл туралы ше?
Dialogue: 0,0:12:04.55,0:12:05.80,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:12:05.89,0:12:06.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:07.05,0:12:08.68,Default,,0,0,0,,Айтпасаң, сұмдық!
Dialogue: 0,0:12:08.76,0:12:10.68,Default,,0,0,0,,Мен сенімен енді ұйықтай да алмаймын!
Dialogue: 0,0:12:10.77,0:12:12.02,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:12:12.64,0:12:13.31,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:12:13.39,0:12:16.11,Default,,0,0,0,,Люс адал және жақсы бала болса да
Dialogue: 0,0:12:16.19,0:12:19.53,Default,,0,0,0,,Неліктен пломба сынған кезде бұл орын алады?
Dialogue: 0,0:12:20.32,0:12:22.28,Default,,0,0,0,,Дирк Шнайдер де солай
Dialogue: 0,0:12:22.78,0:12:24.99,Default,,0,0,0,,Толық қайта тірілмеген...
Dialogue: 0,0:12:26.49,0:12:30.45,Default,,0,0,0,,Люс есімді баланың ішінде мөрленген...
Dialogue: 0,0:12:30.54,0:12:33.79,Default,,0,0,0,,Яғни
Dialogue: 0,0:12:33.87,0:12:38.17,Default,,0,0,0,,Ккккк мынау қызық екен
Dialogue: 0,0:12:41.46,0:12:42.92,Default,,0,0,0,,Бір рет-
Dialogue: 0,0:12:43.01,0:12:48.30,Default,,0,0,0,,Қараңғылықтың үлкен армиясының басында билік еткен аңызға айналған жын.
Dialogue: 0,0:12:48.39,0:12:50.72,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:12:51.56,0:12:55.52,Default,,0,0,0,,15 жыл бұрын Төрт аға шәкіртке еріңіз
Dialogue: 0,0:12:55.60,0:13:00.90,Default,,0,0,0,,Төрт жыл бойы төрт патшалыққа қарсы күрескен жеңілмейтін сиқыршы.
Dialogue: 0,0:13:01.48,0:13:03.40,Default,,0,0,0,,Қорқыныш сиқырын қолданыңыз
Dialogue: 0,0:13:03.49,0:13:07.07,Default,,0,0,0,,Оның құдіреті тіпті ауа райын да өзгерткен дейді.
Dialogue: 0,0:13:07.74,0:13:09.66,Default,,0,0,0,,Сиқыршы болған кезде
Dialogue: 0,0:13:09.74,0:13:13.29,Default,,0,0,0,,Сіздің денеңіз қаншалықты күшті, жауынгерлікімен бәсекелеседі?
Dialogue: 0,0:13:13.37,0:13:16.42,Default,,0,0,0,,Сіз қайта дүниеге келген сайын және сиқырлы күшіңізді арттырасыз
Dialogue: 0,0:13:16.50,0:13:19.75,Default,,0,0,0,,Бұл ескі денеңді тастаудың нәтижесі ме?
Dialogue: 0,0:13:21.67,0:13:23.34,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:13:23.42,0:13:27.22,Default,,0,0,0,,Мен саған тең келер емеспін.
Dialogue: 0,0:13:27.30,0:13:28.14,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:28.22,0:13:33.47,Default,,0,0,0,,Дирк Шнайдердің қайта тірілуі әлі аяқталған жоқ деп есептейміз.
Dialogue: 0,0:13:33.56,0:13:36.48,Default,,0,0,0,,Менің де жеңіске жету мүмкіндігім бар!
Dialogue: 0,0:13:36.56,0:13:38.69,Default,,0,0,0,,Дұрыс, Джодо!
Dialogue: 0,0:13:38.77,0:13:40.98,Default,,0,0,0,,Хэхе~ Ал, енді...
Dialogue: 0,0:13:42.44,0:13:43.90,Default,,0,0,0,,Өте!
Dialogue: 0,0:13:43.98,0:13:47.95,Default,,0,0,0,,Ең керемет! Ең ақылды!
Dialogue: 0,0:13:48.03,0:13:50.20,Default,,0,0,0,,Бұл әдемі!
Dialogue: 0,0:13:50.28,0:13:51.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:52.54,0:13:55.08,Default,,0,0,0,,Жер бетіндегі ең күшті граф!
Dialogue: 0,0:13:55.16,0:13:57.37,Default,,0,0,0,,Кидо триосының бірі!
Dialogue: 0,0:13:57.46,0:14:01.46,Default,,0,0,0,,Бұл менмін, Дай Амон!
Dialogue: 0,0:14:01.54,0:14:04.55,Default,,0,0,0,,Дұрыс, Джодо!
Dialogue: 0,0:14:04.63,0:14:05.97,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:14:06.05,0:14:07.93,Default,,0,0,0,,Әй, бұл не болды?
Dialogue: 0,0:14:08.01,0:14:08.68,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:14:08.76,0:14:11.68,Default,,0,0,0,,Енді жоқ! Бұл не?
Dialogue: 0,0:14:11.76,0:14:12.72,Default,,0,0,0,,Нашар
Dialogue: 0,0:14:12.81,0:14:14.18,Default,,0,0,0,,Ағымдағы соққыға байланысты Люс Ренрен
Dialogue: 0,0:14:14.27,0:14:15.52,Default,,0,0,0,,Мен ояндым!
Dialogue: 0,0:14:15.60,0:14:16.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:17.06,0:14:18.98,Default,,0,0,0,,Ой! Эй, сәл күте тұрыңыз!
Dialogue: 0,0:14:19.06,0:14:21.11,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:14:23.52,0:14:26.07,Default,,0,0,0,,А... иә?
Dialogue: 0,0:14:27.24,0:14:28.57,Default,,0,0,0,,Ах! елес
Dialogue: 0,0:14:29.11,0:14:30.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:30.82,0:14:34.20,Default,,0,0,0,,Бұл формада Дирк Шнайдер бола білу
Dialogue: 0,0:14:34.29,0:14:38.41,Default,,0,0,0,,Бала ұйықтап жатқанда ғана, солай ма?
Dialogue: 0,0:14:38.91,0:14:40.37,Default,,0,0,0,,Мені тартып ал!
Dialogue: 0,0:14:40.46,0:14:42.00,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:14:42.08,0:14:45.09,Default,,0,0,0,,Уау! Йоко-сан!
Dialogue: 0,0:14:47.17,0:14:48.80,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:14:48.88,0:14:50.01,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:50.09,0:14:53.14,Default,,0,0,0,,Маңызды болған кезде сен маған сене алмайсың!
Dialogue: 0,0:14:53.22,0:14:54.89,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:14:55.60,0:14:56.89,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:56.97,0:15:02.48,Default,,0,0,0,,Олар аңызға айналған сиқыршыны оңай түсіріп қана қойған жоқ...
Dialogue: 0,0:15:02.56,0:15:07.61,Default,,0,0,0,,Үш әдемі пәк қызды алу үшін...
Dialogue: 0,0:15:08.28,0:15:09.82,Default,,0,0,0,,Хмм...үш адам?
Dialogue: 0,0:15:09.90,0:15:11.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.16,0:15:13.45,Default,,0,0,0,,Осы Дай Амон үшін
Dialogue: 0,0:15:13.53,0:15:17.66,Default,,0,0,0,,Бұл есте қаларлық және тамаша түн болды.
Dialogue: 0,0:15:17.75,0:15:19.62,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:15:19.71,0:15:22.96,Default,,0,0,0,,Дұрыс па, Джодо?
Dialogue: 0,0:15:23.04,0:15:24.96,Default,,0,0,0,,Хехе... Жарайды, болды.
Dialogue: 0,0:15:25.04,0:15:27.05,Default,,0,0,0,,А...мына екеуі!
Dialogue: 0,0:15:27.13,0:15:29.17,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:15:29.26,0:15:31.18,Default,,0,0,0,,Сатқындар!
Dialogue: 0,0:15:31.93,0:15:34.64,Default,,0,0,0,,Менің сарайыма қош келдіңіз...
Dialogue: 0,0:15:34.72,0:15:37.14,Default,,0,0,0,,Кидо триосы жолдастар
Dialogue: 0,0:15:37.22,0:15:40.31,Default,,0,0,0,,Шон Хари Кай Хан
Dialogue: 0,0:15:40.39,0:15:45.40,Default,,0,0,0,,Жоқ... егер мен шайқаста жеңіліп, әдемі өлсем, бәрібір.
Dialogue: 0,0:15:45.48,0:15:50.53,Default,,0,0,0,,Жандарынан қорқып, жауларына құйрығын бұлғаған сатқындар
Dialogue: 0,0:15:50.61,0:15:53.78,Default,,0,0,0,,Біз енді өзімізді жолдас деп айта алмаймыз.
Dialogue: 0,0:15:53.86,0:15:56.12,Default,,0,0,0,,Хэхе... Эрл
Dialogue: 0,0:15:56.20,0:15:59.12,Default,,0,0,0,,Бұл екі адамды қолға түсіру үлкен күрес болды.
Dialogue: 0,0:15:59.20,0:16:00.58,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:00.66,0:16:05.08,Default,,0,0,0,,Жарайсың, Джодо!
Dialogue: 0,0:16:05.96,0:16:09.38,Default,,0,0,0,,Екеуің де әдемі болып кеттіңдер.
Dialogue: 0,0:16:09.46,0:16:12.88,Default,,0,0,0,,Осыдан бірнеше жыл бұрын мен сүттей ақ қыз едім...
Dialogue: 0,0:16:12.97,0:16:16.22,Default,,0,0,0,,Уф, сен құбыжық болып кеттің.
Dialogue: 0,0:16:16.30,0:16:19.10,Default,,0,0,0,,Осыдан бірнеше жыл бұрын мен әдепті адам едім...
Dialogue: 0,0:16:19.64,0:16:24.31,Default,,0,0,0,,Хахахаха, әлі аузың жаман...
Dialogue: 0,0:16:25.19,0:16:26.48,Default,,0,0,0,,Жақында ішке қайта оралуды ойлап едім,
Dialogue: 0,0:16:26.56,0:16:30.82,Default,,0,0,0,,Сатқынды өлтірейін бе?
Dialogue: 0,0:16:30.90,0:16:32.40,Default,,0,0,0,,Үніңді жап, құбыжық!
Dialogue: 0,0:16:32.49,0:16:35.99,Default,,0,0,0,,Нағыз сатқын сенсің!
Dialogue: 0,0:16:36.07,0:16:37.37,Default,,0,0,0,,Не?
Dialogue: 0,0:16:37.45,0:16:38.91,Default,,0,0,0,,Сіздің қызметшілеріңіз сияқты
Dialogue: 0,0:16:38.99,0:16:41.12,Default,,0,0,0,,Сіз бізді оңай ұстады деп ойладыңыз ба?
Dialogue: 0,0:16:41.20,0:16:42.41,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:42.50,0:16:45.87,Default,,0,0,0,,Мен тұтқынға түскендей кейіп танытып, мені осында әкелуді талап еттім.
Dialogue: 0,0:16:45.96,0:16:47.71,Default,,0,0,0,,Уууу!
Dialogue: 0,0:16:47.79,0:16:49.17,Default,,0,0,0,,Джодо!
Dialogue: 0,0:16:49.25,0:16:49.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:49.96,0:16:53.05,Default,,0,0,0,,Сіз қайтадан сәтсіздікке ұшырадыңыз~
Dialogue: 0,0:16:53.13,0:16:55.88,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:55.97,0:16:58.26,Default,,0,0,0,,Мені кешіріңіз, граф.
Dialogue: 0,0:16:58.35,0:17:00.26,Default,,0,0,0,,Егер мені бұдан былай сорсаң...
Dialogue: 0,0:17:00.35,0:17:03.98,Default,,0,0,0,,Соо... Темекі шекпеңіз Темекі шекпеңіз!
Dialogue: 0,0:17:04.06,0:17:04.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:06.10,0:17:08.52,Default,,0,0,0,,Ууугя~!
Dialogue: 0,0:17:08.61,0:17:11.48,Default,,0,0,0,,Эй, маған көмектес!
Dialogue: 0,0:17:11.57,0:17:15.95,Default,,0,0,0,,Уау~ Шықыр... Вампир!
Dialogue: 0,0:17:17.74,0:17:20.62,Default,,0,0,0,,Фуфуфу~Қан~
Dialogue: 0,0:17:20.70,0:17:24.58,Default,,0,0,0,,Сіздің жоғары қаныңызбен
Dialogue: 0,0:17:24.66,0:17:28.54,Default,,0,0,0,,Менің сиқырлы күшім одан сайын күшейе түседі~
Dialogue: 0,0:17:28.63,0:17:32.46,Default,,0,0,0,,Ней-сама мен Кал-самадан да жақсы!
Dialogue: 0,0:17:32.55,0:17:35.47,Default,,0,0,0,,Құбыжық, мен сені сормаймын!
Dialogue: 0,0:17:35.55,0:17:37.05,Default,,0,0,0,,Кеттік, Дай Амон!
Dialogue: 0,0:17:37.13,0:17:40.76,Default,,0,0,0,,Қарғыс атқан сиқырлы мистикалық техника Рашо қызыл ыстық шеңбер биі!
Dialogue: 0,0:17:41.60,0:17:45.73,Default,,0,0,0,,Хауракен стилі Кенпо құпия техникасы Рюгеки Ракшаса Зан!
Dialogue: 0,0:17:49.52,0:17:50.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:50.81,0:17:52.40,Default,,0,0,0,,Таңба мен қылыштың бір мезгілде шабуылы
Dialogue: 0,0:17:52.48,0:17:54.99,Default,,0,0,0,,Тіпті қарапайым вампир де...
Dialogue: 0,0:17:55.65,0:17:57.74,Default,,0,0,0,,Ах... бұл!
Dialogue: 0,0:18:00.16,0:18:02.83,Default,,0,0,0,,Кесу таңғажайып жылдамдықпен жабылуда!
Dialogue: 0,0:18:02.91,0:18:03.91,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:18:03.99,0:18:05.08,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:05.16,0:18:08.71,Default,,0,0,0,,Сол отта мен бірде-бір күйік көрмедім.
Dialogue: 0,0:18:08.79,0:18:12.88,Default,,0,0,0,,Хахахаха... Надандық - күнә!
Dialogue: 0,0:18:12.96,0:18:14.96,Default,,0,0,0,,Вампирдің денесі
Dialogue: 0,0:18:15.05,0:18:19.09,Default,,0,0,0,,Өлмейтіндікке өте жақын екеніңді білмейсің бе?
Dialogue: 0,0:18:19.18,0:18:22.55,Default,,0,0,0,,Жүр, тыныш бол!
Dialogue: 0,0:18:22.64,0:18:25.14,Default,,0,0,0,,Мен сенің қаныңды сорамын.
Dialogue: 0,0:18:25.22,0:18:26.02,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:18:26.10,0:18:29.23,Default,,0,0,0,,Маған бұл классикалық әдіс ұнамады...
Dialogue: 0,0:18:29.31,0:18:30.35,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:18:30.44,0:18:32.82,Default,,0,0,0,,Сәлем, Дай Амон! мынаны қараңыз
Dialogue: 0,0:18:34.23,0:18:35.94,Default,,0,0,0,,Хааа~
Dialogue: 0,0:18:36.03,0:18:38.57,Default,,0,0,0,,Бұл сарымсақ және крест!
Dialogue: 0,0:18:38.65,0:18:40.82,Default,,0,0,0,,Вампирдің ~!
Dialogue: 0,0:18:40.91,0:18:42.99,Default,,0,0,0,,Қорқатын нәрсе емес!
Dialogue: 0,0:18:43.08,0:18:45.66,Default,,0,0,0,,Әлемдегі ең жақсысы!
Dialogue: 0,0:18:45.74,0:18:46.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:46.62,0:18:49.25,Default,,0,0,0,,Жұмыс істемейді, жұмыс істемейді, жұмыс істемейді!
Dialogue: 0,0:18:49.33,0:18:52.00,Default,,0,0,0,,Мұндай нәрсе жұмыс істемейді.
Dialogue: 0,0:18:52.08,0:18:53.96,Default,,0,0,0,,Не! Сондай ақымақ!
Dialogue: 0,0:18:54.04,0:18:56.46,Default,,0,0,0,,Люс-кун, бірдеңе істе!
Dialogue: 0,0:18:56.55,0:18:57.92,Default,,0,0,0,,Бұл адам өлтіріледі.
Dialogue: 0,0:18:58.01,0:18:59.63,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:18:59.72,0:19:01.76,Default,,0,0,0,,Кии, хахаха
Dialogue: 0,0:19:01.84,0:19:03.68,Default,,0,0,0,,Ахх! (Көрініс) Кай!
Dialogue: 0,0:19:03.76,0:19:04.76,Default,,0,0,0,,(ауырсыну дауысы)
Dialogue: 0,0:19:04.85,0:19:09.52,Default,,0,0,0,,Мына қан, мына дәм дәмді!
Dialogue: 0,0:19:09.60,0:19:12.52,Default,,0,0,0,,Бұл тістің құрылымы, тілдің құрылымы!
Dialogue: 0,0:19:12.60,0:19:18.94,Default,,0,0,0,,Тамаша хош иісі бар, ауызда еритін тәтті!
Dialogue: 0,0:19:19.03,0:19:24.16,Default,,0,0,0,,Кидошудан күткендей, сізде керемет қан бар~
Dialogue: 0,0:19:24.24,0:19:25.62,Default,,0,0,0,,Ахх!
Dialogue: 0,0:19:25.70,0:19:27.24,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:27.33,0:19:28.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:28.37,0:19:31.46,Default,,0,0,0,,Мен сені тым ерте тартамын.
Dialogue: 0,0:19:31.54,0:19:34.00,Default,,0,0,0,,Тыныш күтіңіз!
Dialogue: 0,0:19:34.08,0:19:36.00,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:36.09,0:19:38.80,Default,,0,0,0,,Ең жақсы қаныңызбен
Dialogue: 0,0:19:38.88,0:19:43.97,Default,,0,0,0,,Мен Ней-самадан да, Кал-самадан да асып түсемін.
Dialogue: 0,0:19:45.60,0:19:49.47,Default,,0,0,0,,Дай Амон, сіз лорд Нейге опасыздық жасауды жоспарлап отырсыз.
Dialogue: 0,0:19:49.56,0:19:51.48,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:51.56,0:19:56.86,Default,,0,0,0,,Ең күшті және жақсы билеуші ​​болады.
Dialogue: 0,0:19:56.94,0:19:59.44,Default,,0,0,0,,Бұл сөзсіз
Dialogue: 0,0:19:59.53,0:20:03.07,Default,,0,0,0,,Кім әлсіз, кім күшті
Dialogue: 0,0:20:03.16,0:20:06.95,Default,,0,0,0,,Сіз оны басқара алмайсыз.
Dialogue: 0,0:20:07.03,0:20:10.91,Default,,0,0,0,,Ней-сама мен Кал-сама ерекшелік емес...
Dialogue: 0,0:20:11.00,0:20:12.87,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:20:12.96,0:20:16.42,Default,,0,0,0,,Қарғыс атсын... Бұл өте қызық алдау, бірақ...
Dialogue: 0,0:20:16.50,0:20:18.50,Default,,0,0,0,,Сонымен, ол жұмыс істей ме?
Dialogue: 0,0:20:18.59,0:20:20.59,Default,,0,0,0,,адасу?
Dialogue: 0,0:20:20.67,0:20:23.05,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:20:24.47,0:20:26.64,Default,,0,0,0,,Сиқырлы күшіңді аздап арттырсаң да
Dialogue: 0,0:20:26.72,0:20:29.89,Default,,0,0,0,,ді Dark Schneider міндетті түрде жеңеді!
Dialogue: 0,0:20:29.97,0:20:31.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:31.23,0:20:32.89,Default,,0,0,0,,Дирк Шнайдер Ней мырза және басқалар туралы айтты.
Dialogue: 0,0:20:32.98,0:20:34.77,Default,,0,0,0,,Туысымын деді.
Dialogue: 0,0:20:34.85,0:20:37.27,Default,,0,0,0,,Отбасыңыздың теріс басқаруын жойыңыз!
Dialogue: 0,0:20:37.36,0:20:40.32,Default,,0,0,0,,Ол сенен міндетті түрде құтылады.
Dialogue: 0,0:20:40.40,0:20:42.44,Default,,0,0,0,,Ней-сама және басқалар үшін!
Dialogue: 0,0:20:42.99,0:20:46.24,Default,,0,0,0,,Аа... Осындай уақытта осында болсаң ғой...
Dialogue: 0,0:20:46.32,0:20:49.58,Default,,0,0,0,,Сіз нені айтасыз? Бұл адамдар кімдер...
Dialogue: 0,0:20:49.66,0:20:53.37,Default,,0,0,0,,Хехехе ха~хахахаха!
Dialogue: 0,0:20:53.46,0:20:55.21,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:55.29,0:20:59.04,Default,,0,0,0,,Міне, сіздің өтінішіңіз!
Dialogue: 0,0:20:59.54,0:21:03.01,Default,,0,0,0,,Ол себетте ілулі тұр!
Dialogue: 0,0:21:03.09,0:21:04.97,Default,,0,0,0,,Ақымақ! Сіз адасып қалдыңыз ба? Өл...
Dialogue: 0,0:21:05.05,0:21:06.47,Default,,0,0,0,,Уф! Қарғыс атқыр...
Dialogue: 0,0:21:06.55,0:21:10.93,Default,,0,0,0,,Надандық! Надандық, надандық, надандық! Надандық – күнә!
Dialogue: 0,0:21:11.01,0:21:13.52,Default,,0,0,0,,Дирк Шнайдердің қайта тірілуі
Dialogue: 0,0:21:13.60,0:21:16.27,Default,,0,0,0,,Әлі де сол баланың мөрі басылған...
Dialogue: 0,0:21:16.35,0:21:19.69,Default,,0,0,0,,Оның толық емес екенін білмейсің бе?
Dialogue: 0,0:21:19.77,0:21:20.65,Default,,0,0,0,,Не?
Dialogue: 0,0:21:20.73,0:21:23.36,Default,,0,0,0,,Бұл өте ақымақ...
Dialogue: 0,0:21:23.44,0:21:25.11,Default,,0,0,0,,Белгісіз себеппен, тіпті бір-біріңіздің шынайы кім екеніңізді білмесеңіз де—
Dialogue: 0,0:21:25.20,0:21:27.32,Default,,0,0,0,,Люси оянғанда
Dialogue: 0,0:21:27.41,0:21:30.12,Default,,0,0,0,,Dark Schneider құқық мөрленген.
Dialogue: 0,0:21:30.20,0:21:35.50,Default,,0,0,0,,Сиқыр мен қыздың сүйісі болмаса, мөр ешқашан бұзылмайды...
Dialogue: 0,0:21:36.79,0:21:40.09,Default,,0,0,0,,Солай болды ма? Бұл мағынасы бар!
Dialogue: 0,0:21:40.96,0:21:42.46,Default,,0,0,0,,Сол шайқастан кейін
Dialogue: 0,0:21:42.55,0:21:45.84,Default,,0,0,0,,Geo Note Sort, Дарк Шнайдердің қайта тірілуін алдын ала білген,
Dialogue: 0,0:21:45.92,0:21:49.30,Default,,0,0,0,,Люс Ренрен ретінде реинкарнацияланған Дарк Шнайдерді табыңыз.
Dialogue: 0,0:21:49.39,0:21:53.35,Default,,0,0,0,,Қабілет пен тұлға нәрестенің бойына мөрленді.
Dialogue: 0,0:21:53.43,0:21:54.98,Default,,0,0,0,,Нәтиже
Dialogue: 0,0:21:55.06,0:21:58.06,Default,,0,0,0,,Қараңғы Шнайдер ретінде қайта тірілу керек болған нәресте
Dialogue: 0,0:21:58.15,0:22:01.32,Default,,0,0,0,,Мен түпнұсқа Люс Ренрен болып өстім...
Dialogue: 0,0:22:01.40,0:22:04.15,Default,,0,0,0,,Бұл қиял қателеспесе
Dialogue: 0,0:22:04.23,0:22:08.53,Default,,0,0,0,,Бір жан мен тәнге қосылуы тиіс екі тұлға
Dialogue: 0,0:22:08.61,0:22:10.95,Default,,0,0,0,,Олар бөлек өмір сүреді...!
Dialogue: 0,0:22:11.03,0:22:14.70,Default,,0,0,0,,Тынш... бірақ бұл...
Dialogue: 0,0:22:14.79,0:22:19.88,Default,,0,0,0,,Хяахахаха!
Dialogue: 0,0:22:23.17,0:22:24.50,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.54,0:23:46.55,Default,,0,0,0,,～♪
