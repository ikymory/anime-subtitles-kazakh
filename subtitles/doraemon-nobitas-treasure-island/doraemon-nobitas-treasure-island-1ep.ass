Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.89,0:00:32.90,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:00:32.90,0:00:36.87,Default,,0000,0000,0000,,(шағала дыбысы)
Dialogue: 0,0:00:38.91,0:00:41.91,Default,,0000,0000,0000,,О.
Dialogue: 0,0:00:38.91,0:00:41.91,Default,,0000,0000,0000,,1 сағат бағыты аралдың көлеңкесі табылды!
Dialogue: 0,0:00:41.91,0:00:43.91,Default,,0000,0000,0000,,Сіз оны таптыңыз!
Dialogue: 0,0:00:43.91,0:00:45.91,Default,,0000,0000,0000,,Күмән жоқ.
Dialogue: 0,0:00:45.91,0:00:48.92,Default,,0000,0000,0000,,Аа, бұл аңыз...
Dialogue: 0,0:00:48.92,0:00:50.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:00:50.92,0:00:52.89,Default,,0000,0000,0000,,Treasure Island!
Dialogue: 0,0:00:54.92,0:00:56.89,Default,,0000,0000,0000,,(Сидзука/Сунеоның айқайы)
Dialogue: 0,0:00:54.92,0:00:56.89,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:00:59.93,0:01:01.93,Default,,0000,0000,0000,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:01:01.93,0:01:03.93,Default,,0000,0000,0000,,Эй~!
Dialogue: 0,0:01:03.93,0:01:06.93,Default,,0000,0000,0000,,Какакака... Қарақшы!
Dialogue: 0,0:01:06.93,0:01:09.94,Default,,0000,0000,0000,,Қош бол
Dialogue: 0,0:01:06.93,0:01:09.94,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:01:09.94,0:01:11.87,Default,,0000,0000,0000,,Менің атым Джон Силвер.
Dialogue: 0,0:01:11.87,0:01:15.88,Default,,0000,0000,0000,,(Күміс)
Dialogue: 0,0:01:11.87,0:01:15.88,Default,,0000,0000,0000,,Өкінішке орай, біз қазынаны аламыз.
Dialogue: 0,0:01:15.88,0:01:17.88,Default,,0000,0000,0000,,Қабылдауды қабылдау
Dialogue: 0,0:01:17.88,0:01:19.88,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:01:17.88,0:01:19.88,Default,,0000,0000,0000,,Татата... Көмектесіңіздер!
Dialogue: 0,0:01:19.88,0:01:21.88,Default,,0000,0000,0000,,⚟ (оқ ату)
Dialogue: 0,0:01:19.88,0:01:21.88,Default,,0000,0000,0000,,⚟(Пират) Уау!
Dialogue: 0,0:01:21.88,0:01:23.88,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:01:21.88,0:01:23.88,Default,,0000,0000,0000,,⚟ (оқ ату)
Dialogue: 0,0:01:23.88,0:01:25.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:23.88,0:01:25.89,Default,,0000,0000,0000,,Бұл кім? ?
Dialogue: 0,0:01:25.89,0:01:27.89,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,0:01:25.89,0:01:27.89,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,0:01:27.89,0:01:29.89,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,0:01:27.89,0:01:29.89,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,0:01:29.89,0:01:31.89,Default,,0000,0000,0000,,Капитан! ?
Dialogue: 0,0:01:31.89,0:01:33.89,Default,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:01:31.89,0:01:33.89,Default,,0000,0000,0000,,Әдемі теңізді қорлау➡
Dialogue: 0,0:01:33.89,0:01:36.90,Default,,0000,0000,0000,,Мен сендерге лас қарақшыларды айтамын.
Dialogue: 0,0:01:36.90,0:01:42.90,Default,,0000,0000,0000,,Иә, мен
Dialogue: 0,0:01:36.90,0:01:42.90,Default,,0000,0000,0000,,Осы Испаниола капитаны
Dialogue: 0,0:01:42.90,0:01:44.90,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:44.90,0:01:47.87,Default,,0000,0000,0000,,(Қарақшылар айқайлайды)
Dialogue: 0,0:01:49.91,0:01:51.91,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:01:51.91,0:01:54.91,Default,,0000,0000,0000,,Капитан Нобби...Тах! ?
Dialogue: 0,0:01:54.91,0:01:57.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:54.91,0:01:57.92,Default,,0000,0000,0000,,Нобита-кун...
Dialogue: 0,0:01:57.92,0:02:00.92,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:01:57.92,0:02:00.92,Default,,0000,0000,0000,,Ауырды... Иә?
Dialogue: 0,0:02:00.92,0:02:03.92,Default,,0000,0000,0000,,Хмф! Бұл әзіл!
Dialogue: 0,0:02:03.92,0:02:05.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:03.92,0:02:05.93,Default,,0000,0000,0000,,Новита ➡
Dialogue: 0,0:02:05.93,0:02:07.93,Default,,0000,0000,0000,,Мен сенорита екенін білмеймін.
Dialogue: 0,0:02:05.93,0:02:07.93,Default,,0000,0000,0000,,Тіпті Новита!
Dialogue: 0,0:02:07.93,0:02:10.86,Default,,0000,0000,0000,,Мен сені жұлып аламын
Dialogue: 0,0:02:07.93,0:02:10.86,Default,,0000,0000,0000,,Мен оны акулаларға тамақтандырамын!
Dialogue: 0,0:02:10.86,0:02:13.87,Default,,0000,0000,0000,,Уау... Уау...
Dialogue: 0,0:02:13.87,0:02:16.87,Default,,0000,0000,0000,,Уау, о...
Dialogue: 0,0:02:13.87,0:02:16.87,Default,,0000,0000,0000,,О...
Dialogue: 0,0:02:16.87,0:02:19.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:19.87,0:02:22.88,Default,,0000,0000,0000,,Ха... бітті!
Dialogue: 0,0:02:22.88,0:02:25.88,Default,,0000,0000,0000,,Уау! Эй...эй!
Dialogue: 0,0:02:25.88,0:02:27.85,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:02:25.88,0:02:27.85,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:02:30.88,0:02:33.89,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:33.89,0:02:35.86,Default,,0000,0000,0000,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:02:38.89,0:02:40.86,Default,,0000,0000,0000,,О
Dialogue: 0,0:02:42.90,0:02:46.90,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:02:42.90,0:02:46.90,Default,,0000,0000,0000,,Ойлан, Күміс
Dialogue: 0,0:02:46.90,0:02:48.90,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:02:48.90,0:02:50.90,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:02:50.90,0:02:53.91,Default,,0000,0000,0000,,Гу… Керемет…
Dialogue: 0,0:02:53.91,0:02:55.88,Default,,0000,0000,0000,,(Теңізге құлау дыбысы)
Dialogue: 0,0:02:57.91,0:03:00.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:57.91,0:03:00.88,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:03:03.92,0:03:06.92,Default,,0000,0000,0000,,Міне, осы жерде.
Dialogue: 0,0:03:06.92,0:03:10.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:10.86,0:03:12.83,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:03:14.86,0:03:19.83,Default,,0000,0000,0000,,Керемет! Ол миллиардер!
Dialogue: 0,0:03:14.86,0:03:19.83,Default,,0000,0000,0000,,Уау~ Мен оны таптым!
Dialogue: 0,0:03:21.87,0:03:23.87,Default,,0000,0000,0000,,Мен сенің аузыңды жауып, қабылдауыңды қалаймын.
Dialogue: 0,0:03:23.87,0:03:25.87,Default,,0000,0000,0000,,Нобита-сан керемет!
Dialogue: 0,0:03:25.87,0:03:27.87,Default,,0000,0000,0000,,Эхехе Эхехе
Dialogue: 0,0:03:25.87,0:03:27.87,Default,,0000,0000,0000,,Біз жеңілдік.
Dialogue: 0,0:03:27.87,0:03:29.88,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:03:27.87,0:03:29.88,Default,,0000,0000,0000,,Жер сілкінісі! ?
Dialogue: 0,0:03:29.88,0:03:32.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:32.88,0:03:34.88,Default,,0000,0000,0000,,(Құбыжықтың айқайы)
Dialogue: 0,0:03:34.88,0:03:38.89,Default,,0000,0000,0000,,Гах! Түсіндің бе!
Dialogue: 0,0:03:38.89,0:03:40.89,Default,,0000,0000,0000,,Нобита
Dialogue: 0,0:03:38.89,0:03:40.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:40.89,0:03:43.89,Default,,0000,0000,0000,,Мұны кім жасады?
Dialogue: 0,0:03:40.89,0:03:43.89,Default,,0000,0000,0000,,Ауырды, ауырады, ауырады...
Dialogue: 0,0:03:43.89,0:03:46.89,Default,,0000,0000,0000,,Сәл дірілдеп қалса да.
Dialogue: 0,0:03:43.89,0:03:46.89,Default,,0000,0000,0000,,Менің көңілім қалды
Dialogue: 0,0:03:46.89,0:03:51.90,Default,,0000,0000,0000,,Бірақ қазіргі жер сілкінісі
Dialogue: 0,0:03:46.89,0:03:51.90,Default,,0000,0000,0000,,Ол сәл үлкен болды.
Dialogue: 0,0:03:51.90,0:03:54.90,Default,,0000,0000,0000,,Тым көп
Dialogue: 0,0:03:51.90,0:03:54.90,Default,,0000,0000,0000,,және жақсы
Dialogue: 0,0:03:51.90,0:03:54.90,Default,,0000,0000,0000,,Осылайша басты кейіпкер, ұл бала,➡
Dialogue: 0,0:03:54.90,0:03:58.91,Default,,0000,0000,0000,,Қарақшы Джон Сильверді жеңіңіз
Dialogue: 0,0:03:54.90,0:03:58.91,Default,,0000,0000,0000,,Қазына алу➡
Dialogue: 0,0:03:58.91,0:04:02.91,Default,,0000,0000,0000,,Бұл роман
Dialogue: 0,0:03:58.91,0:04:02.91,Default,,0000,0000,0000,,Такараджима
Dialogue: 0,0:03:58.91,0:04:02.91,Default,,0000,0000,0000,,Бұл «Такарадзиманың» конспектісі➡
Dialogue: 0,0:04:02.91,0:04:04.91,Default,,0000,0000,0000,,Мен бұл кітапты қазір тақырып ретінде пайдаланып жатырмын➡
Dialogue: 0,0:04:04.91,0:04:08.92,Default,,0000,0000,0000,,Қарақшылар қазіргі заманда пайда болады
Dialogue: 0,0:04:04.91,0:04:08.92,Default,,0000,0000,0000,,Мен роман жазып жатырмын.
Dialogue: 0,0:04:08.92,0:04:10.85,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:04:08.92,0:04:10.85,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:04:10.85,0:04:12.85,Default,,0000,0000,0000,,Мүмкін болса оқып берейін!
Dialogue: 0,0:04:10.85,0:04:12.85,Default,,0000,0000,0000,,Ахаха
Dialogue: 0,0:04:12.85,0:04:15.86,Default,,0000,0000,0000,,Бұл аздап ұят, бірақ...
Dialogue: 0,0:04:12.85,0:04:15.86,Default,,0000,0000,0000,,Маған да көрінуге рұқсат етіңіз.
Dialogue: 0,0:04:15.86,0:04:20.86,Default,,0000,0000,0000,,Роман емес
Dialogue: 0,0:04:15.86,0:04:20.86,Default,,0000,0000,0000,,Нағыз қазына аралына да барайық!
Dialogue: 0,0:04:20.86,0:04:22.86,Default,,0000,0000,0000,,Шексіз көк теңіз
Dialogue: 0,0:04:20.86,0:04:22.86,Default,,0000,0000,0000,,Көкжиектен тыс➡
Dialogue: 0,0:04:22.86,0:04:25.87,Default,,0000,0000,0000,,Көп ұзамай, қаңырап бос қалған шағын арал!
Dialogue: 0,0:04:25.87,0:04:31.87,Default,,0000,0000,0000,,Қарақшыларды жеңу
Dialogue: 0,0:04:25.87,0:04:31.87,Default,,0000,0000,0000,,Қазына іздеудегі тамаша шытырман оқиға!
Dialogue: 0,0:04:31.87,0:04:34.87,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:04:31.87,0:04:34.87,Default,,0000,0000,0000,,Шизука-чан да барады, солай ма?
Dialogue: 0,0:04:34.87,0:04:36.88,Default,,0000,0000,0000,,Нобита-сан…
Dialogue: 0,0:04:36.88,0:04:38.88,Default,,0000,0000,0000,,Өкінішке орай, қарақшылар қазынаны ұрлап кетті➡
Dialogue: 0,0:04:38.88,0:04:41.88,Default,,0000,0000,0000,,Аралдың шығанақтары мен үңгірлерінде
Dialogue: 0,0:04:38.88,0:04:41.88,Default,,0000,0000,0000,,Жасырын ➡ дегенді білдіреді
Dialogue: 0,0:04:41.88,0:04:44.88,Default,,0000,0000,0000,,Көбінесе кейінгі дәуірлерде жазылған
Dialogue: 0,0:04:41.88,0:04:44.88,Default,,0000,0000,0000,,Бұл миф
Dialogue: 0,0:04:44.88,0:04:46.89,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:04:46.89,0:04:48.89,Default,,0000,0000,0000,,Нёбичан
Dialogue: 0,0:04:48.89,0:04:51.89,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:04:48.89,0:04:51.89,Default,,0000,0000,0000,,Сіз шынымен солай деп ойладыңыз ба?
Dialogue: 0,0:04:51.89,0:04:53.89,Default,,0000,0000,0000,,«Қазына аралына да барайық!».
Dialogue: 0,0:04:53.89,0:04:55.90,Default,,0000,0000,0000,,Пуф!
Dialogue: 0,0:04:53.89,0:04:55.90,Default,,0000,0000,0000,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:04:55.90,0:04:58.90,Default,,0000,0000,0000,,Тіпті Нобита-сан
Dialogue: 0,0:04:55.90,0:04:58.90,Default,,0000,0000,0000,,Мен қалжыңдадым.
Dialogue: 0,0:04:58.90,0:05:00.90,Default,,0000,0000,0000,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:05:00.90,0:05:06.91,Default,,0000,0000,0000,,Мен... Мен сенімдімін
Dialogue: 0,0:05:00.90,0:05:06.91,Default,,0000,0000,0000,,Қазына аралын табыңыз!
Dialogue: 0,0:05:06.91,0:05:11.88,Default,,0000,0000,0000,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:05:06.91,0:05:11.88,Default,,0000,0000,0000,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:05:13.85,0:05:15.85,Default,,0000,0000,0000,,
Dialogue: 0,0:05:13.85,0:05:15.85,Default,,0000,0000,0000,,Егер мен оны таба алмасам ше?
Dialogue: 0,0:05:15.85,0:05:20.85,Default,,0000,0000,0000,,... мұрыннан.
Dialogue: 0,0:05:15.85,0:05:20.85,Default,,0000,0000,0000,,Мен карбонара жеймін!
Dialogue: 0,0:05:20.85,0:05:24.86,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:05:20.85,0:05:24.86,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:05:24.86,0:05:26.83,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:05:29.86,0:05:31.86,Default,,0000,0000,0000,,Дораемон Дораемон!
Dialogue: 0,0:05:31.86,0:05:33.87,Default,,0000,0000,0000,,Дораемон! Дора... Эмон!
Dialogue: 0,0:05:31.86,0:05:33.87,Default,,0000,0000,0000,,(Мысықтың мияулауы)
Dialogue: 0,0:05:33.87,0:05:35.87,Default,,0000,0000,0000,,(ит үреді)
Dialogue: 0,0:05:33.87,0:05:35.87,Default,,0000,0000,0000,,Уау! Уф...
Dialogue: 0,0:05:35.87,0:05:38.87,Default,,0000,0000,0000,,(ит үреді)
Dialogue: 0,0:05:35.87,0:05:38.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:38.87,0:05:40.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:38.87,0:05:40.87,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:05:40.87,0:05:44.88,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:05:44.88,0:05:58.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:58.89,0:06:01.89,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:05:58.89,0:06:01.89,Default,,0000,0000,0000,,Әрқашан әрқашан...
Dialogue: 0,0:06:01.89,0:06:03.90,Default,,0000,0000,0000,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:06:03.90,0:06:05.90,Default,,0000,0000,0000,,Интернетті пайдалансаңыз➡
Dialogue: 0,0:06:05.90,0:06:08.90,Default,,0000,0000,0000,,Бүкіл әлем бойынша
Dialogue: 0,0:06:05.90,0:06:08.90,Default,,0000,0000,0000,,Бұл дәуірде көруге болады➡
Dialogue: 0,0:06:08.90,0:06:12.84,Default,,0000,0000,0000,,Қандай асыл арал
Dialogue: 0,0:06:08.90,0:06:12.84,Default,,0000,0000,0000,,Сіз шынымен бар деп ойлайсыз ба?
Dialogue: 0,0:06:12.84,0:06:15.84,Default,,0000,0000,0000,,Сіз де аздап шынайырақ болуыңыз керек...
Dialogue: 0,0:06:15.84,0:06:18.85,Default,,0000,0000,0000,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:06:18.85,0:06:21.85,Default,,0000,0000,0000,,Жаттығу
Dialogue: 0,0:06:18.85,0:06:21.85,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:21.85,0:06:23.85,Default,,0000,0000,0000,,Мұрын арқылы карбонара жеу...
Dialogue: 0,0:06:23.85,0:06:25.85,Default,,0000,0000,0000,,Жоқ... Нобита-кун! ?
Dialogue: 0,0:06:25.85,0:06:28.86,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:06:25.85,0:06:28.86,Default,,0000,0000,0000,,Дораэмон уайымдама
Dialogue: 0,0:06:28.86,0:06:31.86,Default,,0000,0000,0000,,Мен бәрін жеймін!
Dialogue: 0,0:06:31.86,0:06:34.86,Default,,0000,0000,0000,,Тіпті Doraemon болмаса да!
Dialogue: 0,0:06:31.86,0:06:34.86,Default,,0000,0000,0000,,А, күте тұр, Нобита-кун!
Dialogue: 0,0:06:34.86,0:06:37.83,Default,,0000,0000,0000,,Мұны сізге жасаңыз
Dialogue: 0,0:06:34.86,0:06:37.83,Default,,0000,0000,0000,,Сен маған мұны істеуге рұқсат бересің бе?
Dialogue: 0,0:06:40.87,0:06:43.87,Default,,0000,0000,0000,,Қазына іздеу картасы!
Dialogue: 0,0:06:43.87,0:06:47.87,Default,,0000,0000,0000,,Ең жақсы сәйкестік дегеніміз не?
Dialogue: 0,0:06:43.87,0:06:47.87,Default,,0000,0000,0000,,Міне, сенде, Дорэмон-кун.
Dialogue: 0,0:06:47.87,0:06:49.88,Default,,0000,0000,0000,,Иә? Мүмкін бұрынғыдан...
Dialogue: 0,0:06:49.88,0:06:53.88,Default,,0000,0000,0000,,Ал, егжей-тегжейлерді кейінге қалдырамын.
Dialogue: 0,0:06:49.88,0:06:53.88,Default,,0000,0000,0000,,Түсіндіру Түсіндіру
Dialogue: 0,0:06:53.88,0:06:56.88,Default,,0000,0000,0000,,Бұл әлемнің бір жерінде
Dialogue: 0,0:06:53.88,0:06:56.88,Default,,0000,0000,0000,,Бар болуы мүмкін➡
Dialogue: 0,0:06:56.88,0:06:59.89,Default,,0000,0000,0000,,Treasure Island табуға болады
Dialogue: 0,0:06:56.88,0:06:59.89,Default,,0000,0000,0000,,Бұл карта
Dialogue: 0,0:06:59.89,0:07:04.89,Default,,0000,0000,0000,,Осылайша сіз еркін қозғала аласыз
Dialogue: 0,0:06:59.89,0:07:04.89,Default,,0000,0000,0000,,Үлкейтуге де болады
Dialogue: 0,0:07:04.89,0:07:06.89,Default,,0000,0000,0000,,Қалай іздеуге болады?
Dialogue: 0,0:07:06.89,0:07:08.90,Default,,0000,0000,0000,,Осы инемен іздеңіз
Dialogue: 0,0:07:08.90,0:07:10.83,Default,,0000,0000,0000,,Хмф, түсіндім!
Dialogue: 0,0:07:10.83,0:07:15.84,Default,,0000,0000,0000,,Дегенмен, бұл Такараджима шығар.
Dialogue: 0,0:07:10.83,0:07:15.84,Default,,0000,0000,0000,,Мен оны енді таба алмаймын деп ойлаймын.
Dialogue: 0,0:07:15.84,0:07:18.84,Default,,0000,0000,0000,,Егер ине тіпті 1мм-ге ауысса
Dialogue: 0,0:07:15.84,0:07:18.84,Default,,0000,0000,0000,,Өйткені ол реакция жасамайды
Dialogue: 0,0:07:18.84,0:07:20.81,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:07:25.85,0:07:28.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:25.85,0:07:28.85,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:07:28.85,0:07:31.82,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:07:28.85,0:07:31.82,Default,,0000,0000,0000,,А, мүмкін емес...
Dialogue: 0,0:07:36.86,0:07:38.86,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:07:38.86,0:07:42.86,Default,,0000,0000,0000,,Бірақ Тынық мұхитының ортасында осылай
Dialogue: 0,0:07:38.86,0:07:42.86,Default,,0000,0000,0000,,Арал деген ұғым болған жоқ.
Dialogue: 0,0:07:42.86,0:07:44.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:42.86,0:07:44.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:47.87,0:07:49.87,Default,,0000,0000,0000,,[ТД] (Диктор) Бұл түстен кейінгі жаңалықтар.
Dialogue: 0,0:07:49.87,0:07:53.87,Default,,0000,0000,0000,,Жапонияның оңтүстігінде Тынық мұхитында
Dialogue: 0,0:07:49.87,0:07:53.87,Default,,0000,0000,0000,,Жаңа арал туылуда ➡
Dialogue: 0,0:07:53.87,0:07:55.88,Default,,0000,0000,0000,,ашылды
Dialogue: 0,0:07:55.88,0:07:59.88,Default,,0000,0000,0000,,Иә~ Жаңа арал?
Dialogue: 0,0:07:55.88,0:07:59.88,Default,,0000,0000,0000,,Кейде сирек кездеседі.
Dialogue: 0,0:07:59.88,0:08:02.88,Default,,0000,0000,0000,,[ТД] (диктор)
Dialogue: 0,0:07:59.88,0:08:02.88,Default,,0000,0000,0000,,Мамандар жер асты магмасының белсенділігі деп есептейді
Dialogue: 0,0:08:02.88,0:08:04.88,Default,,0000,0000,0000,,Барған сайын белсенді
Dialogue: 0,0:08:02.88,0:08:04.88,Default,,0000,0000,0000,,Мүмкін әсерге байланысты➡
Dialogue: 0,0:08:04.88,0:08:07.89,Default,,0000,0000,0000,,Біз алдағы уақытта тергеуді жалғастыруды жоспарлап отырмыз.
Dialogue: 0,0:08:07.89,0:08:12.86,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:08:07.89,0:08:12.86,Default,,0000,0000,0000,,Бұл жаңадан құрылған қазына аралы ма?
Dialogue: 0,0:08:16.83,0:08:18.80,Default,,0000,0000,0000,,Әй...
Dialogue: 0,0:08:20.83,0:08:22.84,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:22.84,0:08:24.84,Default,,0000,0000,0000,,Бұл ешкім білмейтін қазына аралы!
Dialogue: 0,0:08:24.84,0:08:27.84,Default,,0000,0000,0000,,Қазір кеттік!
Dialogue: 0,0:08:24.84,0:08:27.84,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:27.84,0:08:31.84,Default,,0000,0000,0000,,Жақсы, Такараджима, иә?
Dialogue: 0,0:08:27.84,0:08:31.84,Default,,0000,0000,0000,,Менің әкем де кішкентай кезінде...
Dialogue: 0,0:08:31.84,0:08:34.85,Default,,0000,0000,0000,,Тағы да Treasure Island
Dialogue: 0,0:08:31.84,0:08:34.85,Default,,0000,0000,0000,,Түсінде осындай нәрсені айт!
Dialogue: 0,0:08:34.85,0:08:37.85,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:34.85,0:08:37.85,Default,,0000,0000,0000,,Жазғы демалыстағы үй тапсырмасына не болды?
Dialogue: 0,0:08:37.85,0:08:40.85,Default,,0000,0000,0000,,Әкемнен де
Dialogue: 0,0:08:37.85,0:08:40.85,Default,,0000,0000,0000,,Бірдеңе айтыңызшы!
Dialogue: 0,0:08:40.85,0:08:43.86,Default,,0000,0000,0000,,
Dialogue: 0,0:08:43.86,0:08:45.86,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:08:45.86,0:08:48.86,Default,,0000,0000,0000,,Әкем түсінеді, солай ма?
Dialogue: 0,0:08:48.86,0:08:50.86,Default,,0000,0000,0000,,О
Dialogue: 0,0:08:48.86,0:08:50.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:50.86,0:08:55.84,Default,,0000,0000,0000,,Уф... Аа, жарайды, бұл солай.
Dialogue: 0,0:08:50.86,0:08:55.84,Default,,0000,0000,0000,,Үй тапсырмасын орындап болған соң, Нобита.
Dialogue: 0,0:08:58.87,0:09:00.87,Default,,0000,0000,0000,,Әкемнің ақымақ!
Dialogue: 0,0:08:58.87,0:09:00.87,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:09:00.87,0:09:03.88,Default,,0000,0000,0000,,Не деген ақымақтық! Әке
Dialogue: 0,0:09:00.87,0:09:03.88,Default,,0000,0000,0000,,Нобитаны ойлау!
Dialogue: 0,0:09:03.88,0:09:05.88,Default,,0000,0000,0000,,Жетеді!
Dialogue: 0,0:09:03.88,0:09:05.88,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,0:09:05.88,0:09:07.85,Default,,0000,0000,0000,,Әй, Нобита-кун!
Dialogue: 0,0:09:09.88,0:09:11.82,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:09:11.82,0:09:15.82,Default,,0000,0000,0000,,Бұлай айтудың не керегі бар!
Dialogue: 0,0:09:11.82,0:09:15.82,Default,,0000,0000,0000,,Ешқандай тағамдар жоқ!
Dialogue: 0,0:09:15.82,0:09:17.82,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:17.82,0:09:19.83,Default,,0000,0000,0000,,Нобита...
Dialogue: 0,0:09:19.83,0:09:22.83,Default,,0000,0000,0000,,[ТД] (диктор)
Dialogue: 0,0:09:19.83,0:09:22.83,Default,,0000,0000,0000,,Келесі әлемнің әртүрлі бөліктерінде жалғасуда ➡
Dialogue: 0,0:09:22.83,0:09:24.83,Default,,0000,0000,0000,,Аномальды ауа райы туралы жаңалықтар
Dialogue: 0,0:09:24.83,0:09:27.83,Default,,0000,0000,0000,,
Dialogue: 0,0:09:24.83,0:09:27.83,Default,,0000,0000,0000,,Мен газбен жақсы көрмеймін.
Dialogue: 0,0:09:27.83,0:09:30.84,Default,,0000,0000,0000,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:09:27.83,0:09:30.84,Default,,0000,0000,0000,,Жанартаулық газ болуы мүмкін
Dialogue: 0,0:09:30.84,0:09:32.84,Default,,0000,0000,0000,,О
Dialogue: 0,0:09:32.84,0:09:34.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:36.84,0:09:38.84,Default,,0000,0000,0000,,Цк, сіз оны әлі таптыңыз ба?
Dialogue: 0,0:09:38.84,0:09:40.85,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:09:38.84,0:09:40.85,Default,,0000,0000,0000,,Бұл сіз баяулағаныңыз үшін!
Dialogue: 0,0:09:40.85,0:09:43.85,Default,,0000,0000,0000,,Енді бәрі жақсы
Dialogue: 0,0:09:40.85,0:09:43.85,Default,,0000,0000,0000,,Мен мұны тез орындаймын.
Dialogue: 0,0:09:43.85,0:09:47.85,Default,,0000,0000,0000,,Сәлем… адамдар! ?
Dialogue: 0,0:09:43.85,0:09:47.85,Default,,0000,0000,0000,,Біз жеңілдік.
Dialogue: 0,0:09:47.85,0:09:49.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:47.85,0:09:49.86,Default,,0000,0000,0000,,Не! Атқылау! ?
Dialogue: 0,0:09:49.86,0:09:52.83,Default,,0000,0000,0000,,Жаман, қайтайық!
Dialogue: 0,0:09:49.86,0:09:52.83,Default,,0000,0000,0000,,Бұл – Спидвагон қорының тікұшағы. Қонуға орын іздеп жүр.
Dialogue: 0,0:09:55.86,0:09:58.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:55.86,0:09:58.86,Default,,0000,0000,0000,,Енді жоқ!
Dialogue: 0,0:09:58.86,0:10:00.83,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:10:08.87,0:10:11.88,Default,,0000,0000,0000,,Нобита-кун!
Dialogue: 0,0:10:11.88,0:10:14.88,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:10:11.88,0:10:14.88,Default,,0000,0000,0000,,Мен қазына аралын табамын
Dialogue: 0,0:10:14.88,0:10:17.88,Default,,0000,0000,0000,,Соны айтсаң да...
Dialogue: 0,0:10:17.88,0:10:20.89,Default,,0000,0000,0000,,Мен шештім
Dialogue: 0,0:10:17.88,0:10:20.89,Default,,0000,0000,0000,,Бір адам болса да, жүр!
Dialogue: 0,0:10:20.89,0:10:25.89,Default,,0000,0000,0000,,Алтын және күміс қазыналарды өз күшіңізбен алыңыз
Dialogue: 0,0:10:20.89,0:10:25.89,Default,,0000,0000,0000,,Мен саған қараймын!
Dialogue: 0,0:10:25.89,0:10:27.89,Default,,0000,0000,0000,,Хмм, тамаша!
Dialogue: 0,0:10:25.89,0:10:27.89,Default,,0000,0000,0000,,Ой
Dialogue: 0,0:10:27.89,0:10:30.90,Default,,0000,0000,0000,,Түсінемін, саған да ұнайды.
Dialogue: 0,0:10:27.89,0:10:30.90,Default,,0000,0000,0000,,Өз бетіңізше тұрып, жақсы ересек адам болыңыз...
Dialogue: 0,0:10:30.90,0:10:33.90,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:10:30.90,0:10:33.90,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:10:33.90,0:10:36.90,Default,,0000,0000,0000,,Қазірдің өзінде! Білсем де~
Dialogue: 0,0:10:33.90,0:10:36.90,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:10:36.90,0:10:39.91,Default,,0000,0000,0000,,Енді «тіпті бір адам»
Dialogue: 0,0:10:36.90,0:10:39.91,Default,,0000,0000,0000,,Мен жай ғана айттым!
Dialogue: 0,0:10:39.91,0:10:43.91,Default,,0000,0000,0000,,Мен осылай жалғызбын
Dialogue: 0,0:10:39.91,0:10:43.91,Default,,0000,0000,0000,,Мұны істеу мүмкін емес.
Dialogue: 0,0:10:43.91,0:10:46.91,Default,,0000,0000,0000,,А... онда барлық жерде есік!
Dialogue: 0,0:10:46.91,0:10:49.92,Default,,0000,0000,0000,,Сәл тым ыңғайлы
Dialogue: 0,0:10:46.91,0:10:49.92,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:10:49.92,0:10:52.92,Default,,0000,0000,0000,,Олай болса, Takecopter!
Dialogue: 0,0:10:49.92,0:10:52.92,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:10:52.92,0:10:56.92,Default,,0000,0000,0000,,Шытырман оқиғалы сезім бар нәрсе
Dialogue: 0,0:10:52.92,0:10:56.92,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,0:10:56.92,0:10:59.93,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:10:59.93,0:11:03.93,Default,,0000,0000,0000,,Құмыраны ұрайық!
Dialogue: 0,0:10:59.93,0:11:03.93,Default,,0000,0000,0000,,(Ұлдардың айқайы)
Dialogue: 0,0:11:03.93,0:11:06.93,Default,,0000,0000,0000,,Сіз осындай жерге келгенде не істейсіз?
Dialogue: 0,0:11:03.93,0:11:06.93,Default,,0000,0000,0000,,Ой және...
Dialogue: 0,0:11:06.93,0:11:10.87,Default,,0000,0000,0000,,Treasure Island туралы айтатын болсақ, бұл кеме, солай ма?
Dialogue: 0,0:11:06.93,0:11:10.87,Default,,0000,0000,0000,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:11:10.87,0:11:13.87,Default,,0000,0000,0000,,Желкенді қайықты құрастыру!
Dialogue: 0,0:11:13.87,0:11:18.88,Default,,0000,0000,0000,,Мен мұны өзім құрастырдым.
Dialogue: 0,0:11:13.87,0:11:18.88,Default,,0000,0000,0000,,Бұл қазына іздеуші қайық.
Dialogue: 0,0:11:18.88,0:11:22.85,Default,,0000,0000,0000,,Жақсы! Мынау мынау!
Dialogue: 0,0:11:25.89,0:11:28.89,Default,,0000,0000,0000,,Уау! Бұл керемет!
Dialogue: 0,0:11:28.89,0:11:30.89,Default,,0000,0000,0000,,Сондай-ақ тістеуіштер бар
Dialogue: 0,0:11:30.89,0:11:32.89,Default,,0000,0000,0000,,(Кёко) Ой... мен соңғы хиттердің ешқайсысын білмеймін!
Dialogue: 0,0:11:30.89,0:11:32.89,Default,,0000,0000,0000,,Жарайды, жарайды!
Dialogue: 0,0:11:32.89,0:11:36.90,Default,,0000,0000,0000,,Мынау...
Dialogue: 0,0:11:32.89,0:11:36.90,Default,,0000,0000,0000,,(Мастаны бұзу дыбысы)
Dialogue: 0,0:11:36.90,0:11:38.90,Default,,0000,0000,0000,,А, діңгек сынды.
Dialogue: 0,0:11:36.90,0:11:38.90,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:38.90,0:11:41.87,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:11:38.90,0:11:41.87,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Сен сондай жамансың!
Dialogue: 0,0:11:43.90,0:11:45.91,Default,,0000,0000,0000,,Орындалды!
Dialogue: 0,0:11:43.90,0:11:45.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:45.91,0:11:47.87,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:11:45.91,0:11:47.87,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:11:49.91,0:11:52.91,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:11:52.91,0:11:54.91,Default,,0000,0000,0000,,Хмм, бұл жақсы!
Dialogue: 0,0:11:54.91,0:11:58.92,Default,,0000,0000,0000,,Содан кейін оны үлкен жарықпен үлкейтіңіз...
Dialogue: 0,0:11:54.91,0:11:58.92,Default,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:11:58.92,0:12:00.92,Default,,0000,0000,0000,,Сәл күте тұрыңыз...
Dialogue: 0,0:11:58.92,0:12:00.92,Default,,0000,0000,0000,,Кішкене ғана
Dialogue: 0,0:12:00.92,0:12:03.92,Default,,0000,0000,0000,,Өйткені, Шизука-чан да
Dialogue: 0,0:12:00.92,0:12:03.92,Default,,0000,0000,0000,,Мені шақырыңыз!
Dialogue: 0,0:12:03.92,0:12:05.93,Default,,0000,0000,0000,,Тіпті бір адам бару керек.
Dialogue: 0,0:12:03.92,0:12:05.93,Default,,0000,0000,0000,,Болмады ма?
Dialogue: 0,0:12:05.93,0:12:08.93,Default,,0000,0000,0000,,⚟Кя!
Dialogue: 0,0:12:05.93,0:12:08.93,Default,,0000,0000,0000,,Нобитаның жынысы!
Dialogue: 0,0:12:08.93,0:12:10.86,Default,,0000,0000,0000,,Уф! Ауырады...
Dialogue: 0,0:12:10.86,0:12:14.87,Default,,0000,0000,0000,,А... Дайынсың ба?
Dialogue: 0,0:12:14.87,0:12:18.87,Default,,0000,0000,0000,,Күте тұрыңыз~
Dialogue: 0,0:12:14.87,0:12:18.87,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,0:12:18.87,0:12:21.87,Default,,0000,0000,0000,,Үлкен жарық!
Dialogue: 0,0:12:21.87,0:12:32.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:32.89,0:12:34.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:36.89,0:12:38.86,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:12:40.89,0:12:43.90,Default,,0000,0000,0000,,Бұл Нобитаның кемесі ме?
Dialogue: 0,0:12:40.89,0:12:43.90,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:43.90,0:12:45.90,Default,,0000,0000,0000,,Керемет! Бұл таңғажайып Нобита-сан
Dialogue: 0,0:12:45.90,0:12:50.90,Default,,0000,0000,0000,,Міне, діңгек сынды.
Dialogue: 0,0:12:45.90,0:12:50.90,Default,,0000,0000,0000,,Кейбір тесіктер бар...
Dialogue: 0,0:12:50.90,0:12:54.91,Default,,0000,0000,0000,,Нобита Аура!
Dialogue: 0,0:12:50.90,0:12:54.91,Default,,0000,0000,0000,,Новита Аура?
Dialogue: 0,0:12:54.91,0:12:58.91,Default,,0000,0000,0000,,Мен оны Такарадзима стилінде жасадым.
Dialogue: 0,0:12:54.91,0:12:58.91,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:12:58.91,0:13:01.91,Default,,0000,0000,0000,,Novita Aura ұшыру!
Dialogue: 0,0:13:01.91,0:13:12.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:12.86,0:13:15.86,Default,,0000,0000,0000,,Рульді басқару қалай? Нобита-кун
Dialogue: 0,0:13:15.86,0:13:17.86,Default,,0000,0000,0000,,Маған қалдырыңыз
Dialogue: 0,0:13:17.86,0:13:20.87,Default,,0000,0000,0000,,Бұл желкенді кеме болса да
Dialogue: 0,0:13:17.86,0:13:20.87,Default,,0000,0000,0000,,Оның автоматты навигация функциясы бар.
Dialogue: 0,0:13:20.87,0:13:23.87,Default,,0000,0000,0000,,Жарайды, жарайды!
Dialogue: 0,0:13:20.87,0:13:23.87,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:13:23.87,0:13:25.87,Default,,0000,0000,0000,,Сіз біраз уақыттан бері не істеп жүрсіз?
Dialogue: 0,0:13:25.87,0:13:27.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:27.87,0:13:29.88,Default,,0000,0000,0000,,Иә! Апыр-ай!
Dialogue: 0,0:13:27.87,0:13:29.88,Default,,0000,0000,0000,,(ит үреді)
Dialogue: 0,0:13:29.88,0:13:32.88,Default,,0000,0000,0000,,Уау мама, қайық, қайық!
Dialogue: 0,0:13:29.88,0:13:32.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:32.88,0:13:34.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:34.88,0:13:37.85,Default,,0000,0000,0000,,Соққы... соқтығыс! Дораемон!
Dialogue: 0,0:13:39.89,0:13:41.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:45.89,0:13:47.89,Default,,0000,0000,0000,,(үйрек дыбысы)
Dialogue: 0,0:13:45.89,0:13:47.89,Default,,0000,0000,0000,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:13:47.89,0:13:49.90,Default,,0000,0000,0000,,Нобита-кун, ана мен әкеге➡
Dialogue: 0,0:13:49.90,0:13:53.90,Default,,0000,0000,0000,,Шизука-чанмен жағажайда кемпингке бару
Dialogue: 0,0:13:49.90,0:13:53.90,Default,,0000,0000,0000,,Өйткені ол ➡ ретінде орнатылған
Dialogue: 0,0:13:53.90,0:13:58.90,Default,,0000,0000,0000,,Көп көзге түспеңіз
Dialogue: 0,0:13:53.90,0:13:58.90,Default,,0000,0000,0000,,Сізге көп уайымдаудың қажеті жоқ
Dialogue: 0,0:13:58.90,0:14:00.87,Default,,0000,0000,0000,,Менің үйден қашуға ниетім бар.
Dialogue: 0,0:14:06.91,0:14:10.85,Default,,0000,0000,0000,,Дораемон Мен теңізді көремін!
Dialogue: 0,0:14:10.85,0:14:12.85,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:14:10.85,0:14:12.85,Default,,0000,0000,0000,,⚟♪ (Караоке энка)
Dialogue: 0,0:14:12.85,0:14:15.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:12.85,0:14:15.86,Default,,0000,0000,0000,,⚟♪ (Караоке энка)
Dialogue: 0,0:14:15.86,0:14:20.86,Default,,0000,0000,0000,,Сәлем, балалар
Dialogue: 0,0:14:15.86,0:14:20.86,Default,,0000,0000,0000,,Маған көлік беріңіз!
Dialogue: 0,0:14:20.86,0:14:26.87,Default,,0000,0000,0000,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:14:20.86,0:14:26.87,Default,,0000,0000,0000,,Сезім, сезім...
Dialogue: 0,0:14:26.87,0:14:28.87,Default,,0000,0000,0000,,Киім киетін капитан қалпақ!
Dialogue: 0,0:14:28.87,0:14:31.84,Default,,0000,0000,0000,,Мына қалпақты кигенде...хехе
Dialogue: 0,0:14:35.88,0:14:37.88,Default,,0000,0000,0000,,Ахам! Хехе
Dialogue: 0,0:14:37.88,0:14:39.88,Default,,0000,0000,0000,,Дораэмон...
Dialogue: 0,0:14:39.88,0:14:42.88,Default,,0000,0000,0000,,Нобита да
Dialogue: 0,0:14:39.88,0:14:42.88,Default,,0000,0000,0000,,Не, Шизука-чан!
Dialogue: 0,0:14:42.88,0:14:45.88,Default,,0000,0000,0000,,Айналаңызға қараңыз
Dialogue: 0,0:14:42.88,0:14:45.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:45.88,0:14:47.89,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:47.89,0:14:51.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:51.89,0:14:56.86,Default,,0000,0000,0000,,Аудан Кариб теңізіне айналды!
Dialogue: 0,0:14:59.90,0:15:04.90,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:14:59.90,0:15:04.90,Default,,0000,0000,0000,,Сынақ ретінде мен бас киімімді шешіп алдым...
Dialogue: 0,0:15:04.90,0:15:06.91,Default,,0000,0000,0000,,♪ (Караоке энка)
Dialogue: 0,0:15:06.91,0:15:08.91,Default,,0000,0000,0000,,Оны киген кезде...
Dialogue: 0,0:15:08.91,0:15:10.84,Default,,0000,0000,0000,,Уау, бұл керемет!
Dialogue: 0,0:15:10.84,0:15:13.85,Default,,0000,0000,0000,,Бір қайықтағы адамдар
Dialogue: 0,0:15:10.84,0:15:13.85,Default,,0000,0000,0000,,Ол барлығы үшін жұмыс істейді.
Dialogue: 0,0:15:13.85,0:15:16.85,Default,,0000,0000,0000,,Дүние жүзіндегі адамдармен сөйлесуге болады➡
Dialogue: 0,0:15:16.85,0:15:22.86,Default,,0000,0000,0000,,Осы костюмді бекітетін спреймен
Dialogue: 0,0:15:16.85,0:15:22.86,Default,,0000,0000,0000,,Костюміңізді сол күйінде қалдыра аласыз.
Dialogue: 0,0:15:22.86,0:15:26.86,Default,,0000,0000,0000,,Әдемі!
Dialogue: 0,0:15:22.86,0:15:26.86,Default,,0000,0000,0000,,Кариб теңізінде жүргендей әсер қалдырады
Dialogue: 0,0:15:26.86,0:15:29.86,Default,,0000,0000,0000,,Капитандық қалпақ киген адам
Dialogue: 0,0:15:26.86,0:15:29.86,Default,,0000,0000,0000,,Капитан бол
Dialogue: 0,0:15:29.86,0:15:31.86,Default,,0000,0000,0000,,Капитанның бұйрығы...
Dialogue: 0,0:15:31.86,0:15:33.87,Default,,0000,0000,0000,,Мүлдем!
Dialogue: 0,0:15:33.87,0:15:35.87,Default,,0000,0000,0000,,Иә? Ия мұз!
Dialogue: 0,0:15:35.87,0:15:37.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:35.87,0:15:37.87,Default,,0000,0000,0000,,Осылай➡
Dialogue: 0,0:15:37.87,0:15:40.84,Default,,0000,0000,0000,,Көзі тоғысқан адам
Dialogue: 0,0:15:37.87,0:15:40.84,Default,,0000,0000,0000,,Мен енді капитанға қарсы шыға алмаймын
Dialogue: 0,0:15:43.88,0:15:47.88,Default,,0000,0000,0000,,Біз біріншіміз
Dialogue: 0,0:15:43.88,0:15:47.88,Default,,0000,0000,0000,,Жаңадан құрылған аралға қону!
Dialogue: 0,0:15:47.88,0:15:49.88,Default,,0000,0000,0000,,Сәлем Джан
Dialogue: 0,0:15:47.88,0:15:49.88,Default,,0000,0000,0000,,Әкемнің крейсерінде➡
Dialogue: 0,0:15:49.88,0:15:53.89,Default,,0000,0000,0000,,Әдемі жүрейік
Dialogue: 0,0:15:49.88,0:15:53.89,Default,,0000,0000,0000,,Бұл еркектік емес.
Dialogue: 0,0:15:53.89,0:15:56.89,Default,,0000,0000,0000,,А... еркектік деген не?
Dialogue: 0,0:15:56.89,0:16:00.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:56.89,0:16:00.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:00.89,0:16:03.90,Default,,0000,0000,0000,,Әй, қарақшылар!
Dialogue: 0,0:16:00.89,0:16:03.90,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,0:16:03.90,0:16:06.90,Default,,0000,0000,0000,,Алдымен!
Dialogue: 0,0:16:03.90,0:16:06.90,Default,,0000,0000,0000,,Эй, күте тұрыңыз!
Dialogue: 0,0:16:06.90,0:16:08.90,Default,,0000,0000,0000,,Өртенген Сунео!
Dialogue: 0,0:16:06.90,0:16:08.90,Default,,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,0:16:08.90,0:16:11.84,Default,,0000,0000,0000,,Қуып жетсем
Dialogue: 0,0:16:08.90,0:16:11.84,Default,,0000,0000,0000,,Қуып кетіңіз!
Dialogue: 0,0:16:11.84,0:16:13.84,Default,,0000,0000,0000,,Тез еліп кетесің.
Dialogue: 0,0:16:13.84,0:16:16.81,Default,,0000,0000,0000,,Novita Aura Толық жылдамдық алға!
Dialogue: 0,0:16:19.85,0:16:22.82,Default,,0000,0000,0000,,Хахахаха... Иә? О!
Dialogue: 0,0:16:26.85,0:16:28.85,Default,,0000,0000,0000,,А... А?
Dialogue: 0,0:16:28.85,0:16:30.86,Default,,0000,0000,0000,,Йотто!
Dialogue: 0,0:16:28.85,0:16:30.86,Default,,0000,0000,0000,,Сәтті теңіз!
Dialogue: 0,0:16:30.86,0:16:32.86,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:16:30.86,0:16:32.86,Default,,0000,0000,0000,,Хахахаха…
Dialogue: 0,0:16:32.86,0:16:34.86,Default,,0000,0000,0000,,Жарайды, қабылдап алайық!
Dialogue: 0,0:16:32.86,0:16:34.86,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:16:34.86,0:16:37.86,Default,,0000,0000,0000,,Додододо... Дораемон!
Dialogue: 0,0:16:34.86,0:16:37.86,Default,,0000,0000,0000,,Сәлем Нобита!
Dialogue: 0,0:16:37.86,0:16:40.87,Default,,0000,0000,0000,,Маған кемені ақырын беріңіз!
Dialogue: 0,0:16:37.86,0:16:40.87,Default,,0000,0000,0000,,Ой, жоқ…
Dialogue: 0,0:16:40.87,0:16:42.87,Default,,0000,0000,0000,,Капитанның бұйрықтары абсолютті!
Dialogue: 0,0:16:42.87,0:16:45.87,Default,,0000,0000,0000,,Уау! Кукукукуку…
Dialogue: 0,0:16:42.87,0:16:45.87,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:16:45.87,0:16:48.87,Default,,0000,0000,0000,,Хиен
Dialogue: 0,0:16:45.87,0:16:48.87,Default,,0000,0000,0000,,Сендікі менікі!
Dialogue: 0,0:16:48.87,0:16:51.88,Default,,0000,0000,0000,,Джан!
Dialogue: 0,0:16:48.87,0:16:51.88,Default,,0000,0000,0000,,Мендікі менікі!
Dialogue: 0,0:16:51.88,0:16:54.88,Default,,0000,0000,0000,,Хи-хи, капитанның бұйрықтары абсолютті!
Dialogue: 0,0:16:54.88,0:16:57.88,Default,,0000,0000,0000,,Көзге арналған мұз…
Dialogue: 0,0:16:54.88,0:16:57.88,Default,,0000,0000,0000,,(Джан Сунеоның күлкісі)
Dialogue: 0,0:16:57.88,0:17:03.89,Default,,0000,0000,0000,,Нобита-сан
Dialogue: 0,0:16:57.88,0:17:03.89,Default,,0000,0000,0000,,Соңында әрқашан осылай аяқталады, солай ма?
Dialogue: 0,0:17:03.89,0:17:05.89,Default,,0000,0000,0000,,Не! Treasure Island! ?
Dialogue: 0,0:17:05.89,0:17:08.89,Default,,0000,0000,0000,,Жаңадан құрылған арал туралы не деуге болады?
Dialogue: 0,0:17:05.89,0:17:08.89,Default,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:17:08.89,0:17:12.83,Default,,0000,0000,0000,,Өйткені бұл қазына іздеу картасын көрсетеді
Dialogue: 0,0:17:08.89,0:17:12.83,Default,,0000,0000,0000,,Күмән жоқ
Dialogue: 0,0:17:12.83,0:17:15.83,Default,,0000,0000,0000,,Өтірік!
Dialogue: 0,0:17:12.83,0:17:15.83,Default,,0000,0000,0000,,Сенгісіз
Dialogue: 0,0:17:15.83,0:17:18.80,Default,,0000,0000,0000,,Барлығымыз қазынаны алайық
Dialogue: 0,0:17:15.83,0:17:18.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:20.84,0:17:24.84,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:17:20.84,0:17:24.84,Default,,0000,0000,0000,,Осы көкжиектен тыс➡
Dialogue: 0,0:17:24.84,0:17:26.85,Default,,0000,0000,0000,,Қазынаны табыңыз!
Dialogue: 0,0:17:26.85,0:17:29.85,Default,,0000,0000,0000,,Керемет зергерлік бұйымдар
Dialogue: 0,0:17:26.85,0:17:29.85,Default,,0000,0000,0000,,Менің ойымша, олар өте көп.
Dialogue: 0,0:17:29.85,0:17:33.85,Default,,0000,0000,0000,,Алтын мен күміс қазына!
Dialogue: 0,0:17:29.85,0:17:33.85,Default,,0000,0000,0000,,Ол өте бай!
Dialogue: 0,0:17:33.85,0:17:36.86,Default,,0000,0000,0000,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:17:33.85,0:17:36.86,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:36.86,0:17:38.86,Default,,0000,0000,0000,,Маған қалдыр!
Dialogue: 0,0:17:36.86,0:17:38.86,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:17:38.86,0:17:41.86,Default,,0000,0000,0000,,Оңтүстік-оңтүстік-шығыс бағыты!
Dialogue: 0,0:17:38.86,0:17:41.86,Default,,0000,0000,0000,,Жақсы жел соғады!
Dialogue: 0,0:17:41.86,0:17:45.86,Default,,0000,0000,0000,,Treasure Island-ға кету!
Dialogue: 0,0:17:45.86,0:17:47.83,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:54.87,0:17:56.84,Default,,0000,0000,0000,,Уау! Ахахха
Dialogue: 0,0:18:03.88,0:18:06.89,Default,,0000,0000,0000,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:18:03.88,0:18:06.89,Default,,0000,0000,0000,,Долер!
Dialogue: 0,0:18:06.89,0:18:08.89,Default,,0000,0000,0000,,Дора Дора Дора...
Dialogue: 0,0:18:08.89,0:18:10.86,Default,,0000,0000,0000,,Йотто!
Dialogue: 0,0:18:14.83,0:18:16.83,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:18:14.83,0:18:16.83,Default,,0000,0000,0000,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:18:16.83,0:18:18.83,Default,,0000,0000,0000,,Тоуу!
Dialogue: 0,0:18:18.83,0:18:20.83,Default,,0000,0000,0000,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:18:20.83,0:18:22.84,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:18:22.84,0:18:24.84,Default,,0000,0000,0000,,(Барлығы қолдайды)
Dialogue: 0,0:18:24.84,0:18:28.84,Default,,0000,0000,0000,,және моторлы қайықтан жылдам жүре алса, басқа ештеңе маңызды емес.
Dialogue: 0,0:18:28.84,0:18:30.84,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:18:30.84,0:18:32.85,Default,,0000,0000,0000,,Ахаха... Уау!
Dialogue: 0,0:18:32.85,0:18:34.81,Default,,0000,0000,0000,,(Джан Сунеоның күлкісі)
Dialogue: 0,0:18:41.85,0:18:43.86,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:41.85,0:18:43.86,Default,,0000,0000,0000,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:18:43.86,0:18:45.86,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:18:43.86,0:18:45.86,Default,,0000,0000,0000,,Хи хи
Dialogue: 0,0:18:45.86,0:18:47.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:45.86,0:18:47.86,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:18:47.86,0:19:02.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:02.88,0:19:05.88,Default,,0000,0000,0000,,Флуоресцентті бағытталған медузаның түрлері!
Dialogue: 0,0:19:05.88,0:19:09.85,Default,,0000,0000,0000,,Медузаның түрі?
Dialogue: 0,0:19:05.88,0:19:09.85,Default,,0000,0000,0000,,Ал, қараңызшы.
Dialogue: 0,0:19:11.82,0:19:13.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:13.82,0:19:17.82,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:13.82,0:19:17.82,Default,,0000,0000,0000,,Бұл медуза, егер сіз тағайындалған орынды көрсетсеңіз, қайтып оралады➡
Dialogue: 0,0:19:17.82,0:19:21.83,Default,,0000,0000,0000,,Флуоресцентті жарықпен жарқырап, межелі жерге жол салыңыз
Dialogue: 0,0:19:17.82,0:19:21.83,Default,,0000,0000,0000,,Олар мұны сізге жасайды.
Dialogue: 0,0:19:21.83,0:19:25.83,Default,,0000,0000,0000,,Мен барлығының үйіне кемпингке барғанда
Dialogue: 0,0:19:21.83,0:19:25.83,Default,,0000,0000,0000,,Себебі мен сізге хабарластым➡
Dialogue: 0,0:19:25.83,0:19:27.83,Default,,0000,0000,0000,,Бүгін жақсы ұйықтаңыз
Dialogue: 0,0:19:25.83,0:19:27.83,Default,,0000,0000,0000,,Ертеңгі күнге дайындалайық
Dialogue: 0,0:19:27.83,0:19:29.84,Default,,0000,0000,0000,,(Нобита, Джан, Сунео)
Dialogue: 0,0:19:27.83,0:19:29.84,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:19:29.84,0:19:32.84,Default,,0000,0000,0000,,Шизука-чан да
Dialogue: 0,0:19:29.84,0:19:32.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:32.84,0:19:34.81,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:19:36.84,0:19:38.84,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,0:19:36.84,0:19:38.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:38.84,0:19:41.85,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:19:38.84,0:19:41.85,Default,,0000,0000,0000,,Хех сүйкімді
Dialogue: 0,0:19:41.85,0:19:43.85,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,0:19:41.85,0:19:43.85,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,0:19:43.85,0:19:45.85,Default,,0000,0000,0000,,О...
Dialogue: 0,0:19:43.85,0:19:45.85,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,0:19:45.85,0:19:47.85,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:19:45.85,0:19:47.85,Default,,0000,0000,0000,,Сіз теңізден қорқасыз ба?
Dialogue: 0,0:19:47.85,0:19:51.86,Default,,0000,0000,0000,,(медузаның дыбысы)
Dialogue: 0,0:19:47.85,0:19:51.86,Default,,0000,0000,0000,,Хехе, мен көмектесе алмаймын.
Dialogue: 0,0:19:51.86,0:19:55.86,Default,,0000,0000,0000,,Бұл біршама тар
Dialogue: 0,0:19:55.86,0:19:58.83,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,0:19:55.86,0:19:58.83,Default,,0000,0000,0000,,Хехехехехе
Dialogue: 0,0:20:00.87,0:20:06.84,Default,,0000,0000,0000,,(Барлығы қорылдады)
Dialogue: 0,0:20:11.88,0:20:13.85,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:20:16.88,0:20:18.88,Default,,0000,0000,0000,,Хмм... Иә?
Dialogue: 0,0:20:18.88,0:20:20.89,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:20.89,0:20:22.89,Default,,0000,0000,0000,,Бәріңе сәлем!
Dialogue: 0,0:20:22.89,0:20:24.89,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:20:24.89,0:20:27.89,Default,,0000,0000,0000,,Мен теледидардан көрген арал!
Dialogue: 0,0:20:27.89,0:20:29.90,Default,,0000,0000,0000,,Бұл шынымен болды ма?
Dialogue: 0,0:20:29.90,0:20:32.90,Default,,0000,0000,0000,,Алтын-күміс қазына!
Dialogue: 0,0:20:29.90,0:20:32.90,Default,,0000,0000,0000,,Тезірек бортқа мінейік!
Dialogue: 0,0:20:32.90,0:20:35.90,Default,,0000,0000,0000,,Жарайды, кемені аралға жақындатайық!
Dialogue: 0,0:20:35.90,0:20:38.90,Default,,0000,0000,0000,,Додо! До-ду-ду!
Dialogue: 0,0:20:35.90,0:20:38.90,Default,,0000,0000,0000,,Itatata... Не?
Dialogue: 0,0:20:38.90,0:20:41.87,Default,,0000,0000,0000,,Эй, бұл не?
Dialogue: 0,0:20:38.90,0:20:41.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:43.91,0:20:54.92,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:54.92,0:20:57.92,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:20:54.92,0:20:57.92,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:20:57.92,0:20:59.93,Default,,0000,0000,0000,,Пират?
Dialogue: 0,0:20:57.92,0:20:59.93,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:20:59.93,0:21:03.90,Default,,0000,0000,0000,,Капитан қалпағында
Dialogue: 0,0:20:59.93,0:21:03.90,Default,,0000,0000,0000,,Дәл осылай көрінеді.
Dialogue: 0,0:21:08.93,0:21:10.87,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:21:10.87,0:21:12.84,Default,,0000,0000,0000,,(Ерлердің күлкісі)
Dialogue: 0,0:21:14.87,0:21:16.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:14.87,0:21:16.88,Default,,0000,0000,0000,,Бұл қандай балалар?
Dialogue: 0,0:21:16.88,0:21:18.84,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:21:21.88,0:21:25.88,Default,,0000,0000,0000,,Не болып жатыр! ?
Dialogue: 0,0:21:21.88,0:21:25.88,Default,,0000,0000,0000,,Додо додо... Дораемон!
Dialogue: 0,0:21:25.88,0:21:29.89,Default,,0000,0000,0000,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:21:25.88,0:21:29.89,Default,,0000,0000,0000,,Капитан шляпасының иллюзиясы
Dialogue: 0,0:21:29.89,0:21:31.89,Default,,0000,0000,0000,,Не? Иә?
Dialogue: 0,0:21:31.89,0:21:36.90,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:21:31.89,0:21:36.90,Default,,0000,0000,0000,,Тек батыл болып, шығыңыз➡
Dialogue: 0,0:21:36.90,0:21:39.90,Default,,0000,0000,0000,,Гаки, Тануки және Бал
Dialogue: 0,0:21:36.90,0:21:39.90,Default,,0000,0000,0000,,Маңызды емес
Dialogue: 0,0:21:39.90,0:21:42.90,Default,,0000,0000,0000,,Мен оны әлі таба алмаймын.
Dialogue: 0,0:21:39.90,0:21:42.90,Default,,0000,0000,0000,,Мен бара алмаймын.
Dialogue: 0,0:21:42.90,0:21:44.90,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:21:44.90,0:21:46.87,Default,,0000,0000,0000,,Бұл шын!
Dialogue: 0,0:21:48.91,0:21:52.91,Default,,0000,0000,0000,,Сондықтан мен айттым!
Dialogue: 0,0:21:48.91,0:21:52.91,Default,,0000,0000,0000,,Балалар сендер кімсіңдер! ?
Dialogue: 0,0:21:52.91,0:21:55.91,Default,,0000,0000,0000,,Біз? Біз...
Dialogue: 0,0:21:55.91,0:21:58.92,Default,,0000,0000,0000,,Әлемдегі ең ұлы қарақшы!
Dialogue: 0,0:21:58.92,0:22:00.92,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,0:21:58.92,0:22:00.92,Default,,0000,0000,0000,,(Танжиро) Барлығы жақсы болады. Бұл адам ешкімді өлтірген жоқ.
Dialogue: 0,0:22:00.92,0:22:03.92,Default,,0000,0000,0000,,Капитан маған қарақшы екенін айтты.
Dialogue: 0,0:22:00.92,0:22:03.92,Default,,0000,0000,0000,,Сен маған айтпа деп айттың ғой!
Dialogue: 0,0:22:03.92,0:22:07.93,Default,,0000,0000,0000,,О, жоқ болып кетті.
Dialogue: 0,0:22:03.92,0:22:07.93,Default,,0000,0000,0000,,Кешіріңіз, Виви Чан
Dialogue: 0,0:22:07.93,0:22:11.86,Default,,0000,0000,0000,,Бір, екі, үш.
Dialogue: 0,0:22:07.93,0:22:11.86,Default,,0000,0000,0000,,Біз сізге қандай бизнес үшін қажет?
Dialogue: 0,0:22:11.86,0:22:14.87,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:22:14.87,0:22:18.87,Default,,0000,0000,0000,,Аздап салқын теңіз түбінде➡
Dialogue: 0,0:22:18.87,0:22:20.87,Default,,0000,0000,0000,,Тек батып кетсін
Dialogue: 0,0:22:20.87,0:22:22.87,Default,,0000,0000,0000,,(Қарақшылардың күлкісі)
Dialogue: 0,0:22:22.87,0:22:24.88,Default,,0000,0000,0000,,Иә, мен саған мынаны беремін.
Dialogue: 0,0:22:24.88,0:22:26.88,Default,,0000,0000,0000,,Не? Ах, рахмет
Dialogue: 0,0:22:26.88,0:22:29.88,Default,,0000,0000,0000,,А, мен саған беремін.
Dialogue: 0,0:22:26.88,0:22:29.88,Default,,0000,0000,0000,,Иә? Бұл жақсы ма?
Dialogue: 0,0:22:29.88,0:22:32.88,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:22:29.88,0:22:32.88,Default,,0000,0000,0000,,(Гаганың айқайы)
Dialogue: 0,0:22:32.88,0:22:36.89,Default,,0000,0000,0000,,Мен қорықтым... Уф...
Dialogue: 0,0:22:36.89,0:22:38.89,Default,,0000,0000,0000,,(Ақын Монджироның жөтелі)
Dialogue: 0,0:22:38.89,0:22:41.89,Default,,0000,0000,0000,,Цк, сен блеф айтып тұрсың ба?
Dialogue: 0,0:22:38.89,0:22:41.89,Default,,0000,0000,0000,,Мына жігіттерді ұстаңыз!
Dialogue: 0,0:22:41.89,0:22:43.90,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:22:41.89,0:22:43.90,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:22:43.90,0:22:46.90,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,0:22:46.90,0:22:48.90,Default,,0000,0000,0000,,Реми мұнда әрдайым мен үшін терезені ашады, білесің бе.
Dialogue: 0,0:22:48.90,0:22:50.90,Default,,0000,0000,0000,,Уау~ Маған көмектесші~!
Dialogue: 0,0:22:50.90,0:22:52.90,Default,,0000,0000,0000,,Уф... Уф!
Dialogue: 0,0:22:52.90,0:22:55.91,Default,,0000,0000,0000,,Нобита-кун атақты семсер Денкомару!
Dialogue: 0,0:22:55.91,0:22:58.91,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:22:55.91,0:22:58.91,Default,,0000,0000,0000,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:22:58.91,0:23:02.91,Default,,0000,0000,0000,,Уау! Уау уау...
Dialogue: 0,0:23:02.91,0:23:04.92,Default,,0000,0000,0000,,Қарғыс атсын! Уф...
Dialogue: 0,0:23:04.92,0:23:07.92,Default,,0000,0000,0000,,Нуо~! Мінеки біз!
Dialogue: 0,0:23:07.92,0:23:10.86,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:23:07.92,0:23:10.86,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:23:10.86,0:23:12.86,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:23:10.86,0:23:12.86,Default,,0000,0000,0000,,Неге?! Неге?!
Dialogue: 0,0:23:12.86,0:23:15.86,Default,,0000,0000,0000,,Абай бол, ДжоДжо!
Dialogue: 0,0:23:12.86,0:23:15.86,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:23:15.86,0:23:17.86,Default,,0000,0000,0000,,Оппекепепо пудингі пудингі
Dialogue: 0,0:23:15.86,0:23:17.86,Default,,0000,0000,0000,,Эй, сәлем
Dialogue: 0,0:23:17.86,0:23:19.87,Default,,0000,0000,0000,,Монён жалап
Dialogue: 0,0:23:17.86,0:23:19.87,Default,,0000,0000,0000,,Пурин Пурин Пурин Пурин
Dialogue: 0,0:23:19.87,0:23:21.87,Default,,0000,0000,0000,,Моньон
Dialogue: 0,0:23:19.87,0:23:21.87,Default,,0000,0000,0000,,Пурин Пурин…
Dialogue: 0,0:23:21.87,0:23:25.87,Default,,0000,0000,0000,,Бұл бомба емес, ақымақ оқ.
Dialogue: 0,0:23:21.87,0:23:25.87,Default,,0000,0000,0000,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:23:25.87,0:23:28.87,Default,,0000,0000,0000,,Бұл не деген жігіттер!
Dialogue: 0,0:23:25.87,0:23:28.87,Default,,0000,0000,0000,,Мен біртүрлі құралдарды қолданамын.
Dialogue: 0,0:23:28.87,0:23:32.88,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:23:28.87,0:23:32.88,Default,,0000,0000,0000,,Мұны жасама!
Dialogue: 0,0:23:32.88,0:23:36.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:32.88,0:23:36.85,Default,,0000,0000,0000,,Әуе зеңбіректерінің бумы!
Dialogue: 0,0:23:41.89,0:23:45.89,Default,,0000,0000,0000,,Ку... Ауаны кесіп тастады!
Dialogue: 0,0:23:41.89,0:23:45.89,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,0:23:45.89,0:23:47.89,Default,,0000,0000,0000,,Конняро!
Dialogue: 0,0:23:47.89,0:23:49.90,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:23:49.90,0:23:51.90,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:23:51.90,0:23:53.90,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:23:53.90,0:23:55.90,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:23:55.90,0:23:57.90,Default,,0000,0000,0000,,Көмектесіңіз!
Dialogue: 0,0:23:57.90,0:24:00.87,Default,,0000,0000,0000,,Шытырман оқиғаны ойнау
Dialogue: 0,0:23:57.90,0:24:00.87,Default,,0000,0000,0000,,Енді бітті
Dialogue: 0,0:24:28.87,0:24:30.87,Default,,0000,0000,0000,,Ой... а...
Dialogue: 0,0:24:30.87,0:24:32.87,Default,,0000,0000,0000,,⚟ (соққы дыбысы)
Dialogue: 0,0:24:30.87,0:24:32.87,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:24:32.87,0:24:52.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:52.89,0:24:58.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:58.90,0:25:02.90,Default,,0000,0000,0000,,Ахх... арал батып бара жатыр!
Dialogue: 0,0:24:58.90,0:25:02.90,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:25:02.90,0:25:06.91,Default,,0000,0000,0000,,Барлығыңыз, мықтап ұстаңыздар!
Dialogue: 0,0:25:02.90,0:25:06.91,Default,,0000,0000,0000,,Сізді лақтырып жібереді!
Dialogue: 0,0:25:06.91,0:25:09.91,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:25:09.91,0:25:11.84,Default,,0000,0000,0000,,Эй, сен кетіп қалдың ба?
Dialogue: 0,0:25:11.84,0:25:16.82,Default,,0000,0000,0000,,Не болып жатыр!
Dialogue: 0,0:25:11.84,0:25:16.82,Default,,0000,0000,0000,,Цк, менің кемеге қайтудан басқа амалым жоқ!
Dialogue: 0,0:25:25.86,0:25:27.86,Default,,0000,0000,0000,,Ха...ха!
Dialogue: 0,0:25:27.86,0:25:33.87,Default,,0000,0000,0000,,Сара! Сара емес пе?
Dialogue: 0,0:25:27.86,0:25:33.87,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:25:33.87,0:25:35.87,Default,,0000,0000,0000,,Мен оны жек көремін! Жіберу!
Dialogue: 0,0:25:35.87,0:25:38.87,Default,,0000,0000,0000,,Иә? Сен не айтып тұрсың?
Dialogue: 0,0:25:35.87,0:25:38.87,Default,,0000,0000,0000,,⚟Виви-чан, асығыңыз!
Dialogue: 0,0:25:38.87,0:25:42.87,Default,,0000,0000,0000,,Hiii...
Dialogue: 0,0:25:38.87,0:25:42.87,Default,,0000,0000,0000,,⚟Маған көмектес, Нобита-сан!
Dialogue: 0,0:25:42.87,0:25:44.88,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:25:42.87,0:25:44.88,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:25:44.88,0:25:47.88,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,0:25:44.88,0:25:47.88,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,0:25:47.88,0:25:50.88,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:25:47.88,0:25:50.88,Default,,0000,0000,0000,,Нобита-кун! Ха!
Dialogue: 0,0:25:50.88,0:25:52.85,Default,,0000,0000,0000,,Tto!
Dialogue: 0,0:26:00.89,0:26:03.90,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,0:26:00.89,0:26:03.90,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,0:26:03.90,0:26:06.90,Default,,0000,0000,0000,,Олар неліктен?
Dialogue: 0,0:26:03.90,0:26:06.90,Default,,0000,0000,0000,,Менің артымнан жүр
Dialogue: 0,0:26:06.90,0:26:08.87,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,0:26:06.90,0:26:08.87,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,0:26:12.84,0:26:14.84,Default,,0000,0000,0000,,Жаман!
Dialogue: 0,0:26:12.84,0:26:14.84,Default,,0000,0000,0000,,Теңізге сүңгіңіз!
Dialogue: 0,0:26:14.84,0:26:17.84,Default,,0000,0000,0000,,Бірдеңе жетіспейді ме? Бірдеңе жетіспейді ме?
Dialogue: 0,0:26:14.84,0:26:17.84,Default,,0000,0000,0000,,Бірдеңе жетіспейді ме? Бірдеңе жетіспейді ме...
Dialogue: 0,0:26:17.84,0:26:19.84,Default,,0000,0000,0000,,Уау~ Дораемон, асығыңыз!
Dialogue: 0,0:26:19.84,0:26:22.81,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:26:19.84,0:26:22.81,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:26:24.85,0:26:26.82,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,0:26:29.85,0:26:31.82,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:26:35.86,0:26:39.86,Default,,0000,0000,0000,,Нобита-кун! Бірдеңе бар ма?
Dialogue: 0,0:26:35.86,0:26:39.86,Default,,0000,0000,0000,,Бірдеңе жетіспейді ме? Бірдеңе жетіспейді ме...
Dialogue: 0,0:26:39.86,0:26:42.87,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:26:42.87,0:26:47.87,Default,,0000,0000,0000,,Уф! Уф...
Dialogue: 0,0:26:47.87,0:26:53.85,Default,,0000,0000,0000,,(күрескен дауыс)
Dialogue: 0,0:26:58.88,0:27:01.89,Default,,0000,0000,0000,,《Сидзука-чан…》
Dialogue: 0,0:27:01.89,0:27:05.86,Default,,0000,0000,0000,,Пуха! Нобита-кун!
Dialogue: 0,0:27:01.89,0:27:05.86,Default,,0000,0000,0000,,Нобита... Иә?
Dialogue: 0,0:27:07.89,0:27:09.86,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:27:20.84,0:27:23.84,Default,,0000,0000,0000,,Нобита-кун, мықты бол!
Dialogue: 0,0:27:23.84,0:27:25.84,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:27:23.84,0:27:25.84,Default,,0000,0000,0000,,Дораемон
Dialogue: 0,0:27:25.84,0:27:28.85,Default,,0000,0000,0000,,Жақсы, байқадың ба?
Dialogue: 0,0:27:28.85,0:27:31.85,Default,,0000,0000,0000,,Шизука-чан! ?
Dialogue: 0,0:27:28.85,0:27:31.85,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:27:31.85,0:27:33.85,Default,,0000,0000,0000,,Сонымен... бұл...
Dialogue: 0,0:27:33.85,0:27:35.85,Default,,0000,0000,0000,,⚟
Dialogue: 0,0:27:33.85,0:27:35.85,Default,,0000,0000,0000,,Ауырды! Маған көбірек мейірімділік танытыңыз!
Dialogue: 0,0:27:35.85,0:27:39.86,Default,,0000,0000,0000,,Мақтаншақ болма!
Dialogue: 0,0:27:35.85,0:27:39.86,Default,,0000,0000,0000,,Сіз де солардың бірісіз бе?
Dialogue: 0,0:27:39.86,0:27:41.86,Default,,0000,0000,0000,,
Dialogue: 0,0:27:39.86,0:27:41.86,Default,,0000,0000,0000,,Сіз ауыртты дедіңіз! горилла!
Dialogue: 0,0:27:41.86,0:27:45.86,Default,,0000,0000,0000,,Мына бала ше?
Dialogue: 0,0:27:41.86,0:27:45.86,Default,,0000,0000,0000,,Мен Нобитаны құтқарған кезде➡
Dialogue: 0,0:27:45.86,0:27:47.87,Default,,0000,0000,0000,,Жақын жерде не қалқып тұрды?
Dialogue: 0,0:27:45.86,0:27:47.87,Default,,0000,0000,0000,,Аа, дәл осы.
Dialogue: 0,0:27:47.87,0:27:49.87,Default,,0000,0000,0000,,Сонда бұрынғы жігіттер ше?
Dialogue: 0,0:27:49.87,0:27:53.87,Default,,0000,0000,0000,,Айт! Сен кімсің?
Dialogue: 0,0:27:49.87,0:27:53.87,Default,,0000,0000,0000,,Олар қайда қашып кетті?
Dialogue: 0,0:27:53.87,0:27:55.87,Default,,0000,0000,0000,,Хмф! Мен білмеймін
Dialogue: 0,0:27:55.87,0:27:58.88,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:27:55.87,0:27:58.88,Default,,0000,0000,0000,,Білмейтін жол жоқ!
Dialogue: 0,0:27:58.88,0:28:00.88,Default,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:27:58.88,0:28:00.88,Default,,0000,0000,0000,,Tsk
Dialogue: 0,0:28:00.88,0:28:05.88,Default,,0000,0000,0000,,Мм... менің атым Нобита
Dialogue: 0,0:28:00.88,0:28:05.88,Default,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:28:05.88,0:28:07.89,Default,,0000,0000,0000,,Отар
Dialogue: 0,0:28:07.89,0:28:10.82,Default,,0000,0000,0000,,Отар Менің сенен бір жақсылығым бар.
Dialogue: 0,0:28:10.82,0:28:13.83,Default,,0000,0000,0000,,Біздің достар
Dialogue: 0,0:28:10.82,0:28:13.83,Default,,0000,0000,0000,,Мені бұрынғы жігіттер ұрлап әкетті.
Dialogue: 0,0:28:13.83,0:28:17.83,Default,,0000,0000,0000,,Олар қайда кетті?
Dialogue: 0,0:28:13.83,0:28:17.83,Default,,0000,0000,0000,,Маған айтқаныңызды қалаймын!
Dialogue: 0,0:28:17.83,0:28:19.83,Default,,0000,0000,0000,,Жер бетіндегі бұл арал қандай?
Dialogue: 0,0:28:19.83,0:28:21.83,Default,,0000,0000,0000,,Қарғыс атқыр...
Dialogue: 0,0:28:19.83,0:28:21.83,Default,,0000,0000,0000,,⚟ (сықырлау)
Dialogue: 0,0:28:21.83,0:28:24.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:28:24.84,0:28:26.84,Default,,0000,0000,0000,,⚟ (сықырлау)
Dialogue: 0,0:28:24.84,0:28:26.84,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:28:26.84,0:28:29.84,Default,,0000,0000,0000,,⚟ (сықырлау)
Dialogue: 0,0:28:29.84,0:28:31.84,Default,,0000,0000,0000,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:28:29.84,0:28:31.84,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:28:31.84,0:28:33.85,Default,,0000,0000,0000,,Жүзім!
Dialogue: 0,0:28:31.84,0:28:33.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:28:33.85,0:28:36.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:28:36.85,0:28:38.85,Default,,0000,0000,0000,,Дораемон Бұл тотықұс...
Dialogue: 0,0:28:38.85,0:28:42.85,Default,,0000,0000,0000,,Иә, бұл робот.
Dialogue: 0,0:28:38.85,0:28:42.85,Default,,0000,0000,0000,,Бұл да өте жетілдірілген.
Dialogue: 0,0:28:42.85,0:28:44.86,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:28:42.85,0:28:44.86,Default,,0000,0000,0000,,1000 адамы бар кемеде➡
Dialogue: 0,0:28:44.86,0:28:49.86,Default,,0000,0000,0000,,Егер бортқа 999 адам шықса
Dialogue: 0,0:28:44.86,0:28:49.86,Default,,0000,0000,0000,,Неліктен батып кеткен жұмбақ?
Dialogue: 0,0:28:49.86,0:28:51.86,Default,,0000,0000,0000,,Иә? не? Жұмбақ?
Dialogue: 0,0:28:51.86,0:28:54.87,Default,,0000,0000,0000,,Бұл жігіттің аты Викторина
Dialogue: 0,0:28:54.87,0:28:59.87,Default,,0000,0000,0000,,Тотықұс тәрізді бала күтуші робот
Dialogue: 0,0:28:54.87,0:28:59.87,Default,,0000,0000,0000,,Викторина арқылы не айтқыңыз келетінін айтыңыз
Dialogue: 0,0:28:59.87,0:29:01.87,Default,,0000,0000,0000,,Енді викторинаны орындайық.
Dialogue: 0,0:28:59.87,0:29:01.87,Default,,0000,0000,0000,,Бір-бірден шешу керек➡
Dialogue: 0,0:29:01.87,0:29:03.88,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:29:01.87,0:29:03.88,Default,,0000,0000,0000,,Сіз білмеймін дейсіз бе?
Dialogue: 0,0:29:03.88,0:29:06.88,Default,,0000,0000,0000,,О
Dialogue: 0,0:29:03.88,0:29:06.88,Default,,0000,0000,0000,,1000 орындық?
Dialogue: 0,0:29:06.88,0:29:10.82,Default,,0000,0000,0000,,Бортта небәрі 999 адам болса да...
Dialogue: 0,0:29:10.82,0:29:13.79,Default,,0000,0000,0000,,Ол батып кете ме?
Dialogue: 0,0:29:10.82,0:29:13.79,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:29:17.82,0:29:19.82,Default,,0000,0000,0000,,Түсіндім! Өйткені кеме сынған...
Dialogue: 0,0:29:19.82,0:29:21.83,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:29:21.83,0:29:24.83,Default,,0000,0000,0000,,Буу! Жоқ, жоқ!
Dialogue: 0,0:29:21.83,0:29:24.83,Default,,0000,0000,0000,,Ау, ауырып тұр...
Dialogue: 0,0:29:24.83,0:29:26.83,Default,,0000,0000,0000,,Хмф! Жоқ, жоқ, жоқ па?
Dialogue: 0,0:29:26.83,0:29:29.83,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ~
Dialogue: 0,0:29:26.83,0:29:29.83,Default,,0000,0000,0000,,Бұл пайдасыз емес!
Dialogue: 0,0:29:29.83,0:29:31.84,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:29:29.83,0:29:31.84,Default,,0000,0000,0000,,Бұл пайдасыз емес!
Dialogue: 0,0:29:31.84,0:29:33.84,Default,,0000,0000,0000,,Куу~! Еліктеу...
Dialogue: 0,0:29:33.84,0:29:35.84,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:29:33.84,0:29:35.84,Default,,0000,0000,0000,,Мені көшірме!
Dialogue: 0,0:29:35.84,0:29:39.84,Default,,0000,0000,0000,,Мені көшірме!
Dialogue: 0,0:29:35.84,0:29:39.84,Default,,0000,0000,0000,,Уау! Бұл жігіт!
Dialogue: 0,0:29:39.84,0:29:43.85,Default,,0000,0000,0000,,Эй, күт!
Dialogue: 0,0:29:39.84,0:29:43.85,Default,,0000,0000,0000,,Қашпа!
Dialogue: 0,0:29:43.85,0:29:45.85,Default,,0000,0000,0000,,Мені ұстаңыз!
Dialogue: 0,0:29:43.85,0:29:45.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:29:45.85,0:29:48.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:29:45.85,0:29:48.85,Default,,0000,0000,0000,,Ұстадым!
Dialogue: 0,0:29:48.85,0:29:51.86,Default,,0000,0000,0000,,Оны сол жерде қалдырыңыз
Dialogue: 0,0:29:48.85,0:29:51.86,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:29:51.86,0:29:53.86,Default,,0000,0000,0000,,Мысалы, осы жағдайда—
Dialogue: 0,0:29:51.86,0:29:53.86,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:29:53.86,0:29:55.86,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:29:55.86,0:29:59.86,Default,,0000,0000,0000,,Жарайды, жауап суасты қайықтары!
Dialogue: 0,0:29:55.86,0:29:59.86,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:29:59.86,0:30:02.87,Default,,0000,0000,0000,,Пинг теннисі Пинг теннисі үстел теннисі!
Dialogue: 0,0:29:59.86,0:30:02.87,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:30:02.87,0:30:06.87,Default,,0000,0000,0000,,Пон Поко Танукидің үлкен жауабы!
Dialogue: 0,0:30:02.87,0:30:06.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:30:06.87,0:30:08.87,Default,,0000,0000,0000,,Мен ракон емеспін!
Dialogue: 0,0:30:06.87,0:30:08.87,Default,,0000,0000,0000,,Бұл енот ит емес!
Dialogue: 0,0:30:08.87,0:30:11.88,Default,,0000,0000,0000,,Бұл енот ит.
Dialogue: 0,0:30:08.87,0:30:11.88,Default,,0000,0000,0000,,Мысық~!
Dialogue: 0,0:30:11.88,0:30:14.88,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,0:30:11.88,0:30:14.88,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,0:30:14.88,0:30:17.88,Default,,0000,0000,0000,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:30:14.88,0:30:17.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:30:17.88,0:30:20.89,Default,,0000,0000,0000,,Сол арал
Dialogue: 0,0:30:17.88,0:30:20.89,Default,,0000,0000,0000,,Қарақшылық кеме камуфляжы
Dialogue: 0,0:30:20.89,0:30:22.89,Default,,0000,0000,0000,,Кемеден суасты қайыққа айналу➡
Dialogue: 0,0:30:22.89,0:30:25.89,Default,,0000,0000,0000,,Мен қазір теңіз астында сүңгіп жатырмын.
Dialogue: 0,0:30:25.89,0:30:28.89,Default,,0000,0000,0000,,Сонда Шидзука-чан қайда?
Dialogue: 0,0:30:28.89,0:30:31.90,Default,,0000,0000,0000,,Маған айта аласыз.
Dialogue: 0,0:30:28.89,0:30:31.90,Default,,0000,0000,0000,,Бірақ бұған дейін➡
Dialogue: 0,0:30:31.90,0:30:34.87,Default,,0000,0000,0000,,Мына жіпті шеше аласыз ба?
Dialogue: 0,0:30:43.91,0:30:46.91,Default,,0000,0000,0000,,Олар кеңістік-уақыт қарақшылары.
Dialogue: 0,0:30:46.91,0:30:49.91,Default,,0000,0000,0000,,Ғарыштық уақыт қарақшысы?
Dialogue: 0,0:30:49.91,0:30:52.92,Default,,0000,0000,0000,,(фортепиано дыбысы)
Dialogue: 0,0:30:49.91,0:30:52.92,Default,,0000,0000,0000,,О
Dialogue: 0,0:30:52.92,0:30:56.92,Default,,0000,0000,0000,,Өз қалауы бойынша пішінін өзгертеді.
Dialogue: 0,0:30:52.92,0:30:56.92,Default,,0000,0000,0000,,Үлкен қарақшылар кемесін жасаңыз➡
Dialogue: 0,0:30:56.92,0:31:00.93,Default,,0000,0000,0000,,Өткен қазіргі болашақ
Dialogue: 0,0:30:56.92,0:31:00.93,Default,,0000,0000,0000,,Алды-артқа өту➡
Dialogue: 0,0:31:00.93,0:31:04.93,Default,,0000,0000,0000,,Мұхит түбінде жатқан дүние жүзінің қазыналары...
Dialogue: 0,0:31:00.93,0:31:04.93,Default,,0000,0000,0000,,(фортепиано дыбысы)
Dialogue: 0,0:31:04.93,0:31:06.93,Default,,0000,0000,0000,,(Пернетақтаны басқан дыбыс)
Dialogue: 0,0:31:06.93,0:31:08.93,Default,,0000,0000,0000,,Жинау!
Dialogue: 0,0:31:08.93,0:31:18.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:31:18.88,0:31:21.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:31:29.89,0:31:31.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:31:33.89,0:31:35.89,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:31:35.89,0:31:45.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:31:45.90,0:31:49.91,Default,,0000,0000,0000,,Эй, бұл қыз шынымен Сара ма?
Dialogue: 0,0:31:49.91,0:31:52.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:31:49.91,0:31:52.91,Default,,0000,0000,0000,,Қалай қарасаң да Сара ғой.
Dialogue: 0,0:31:52.91,0:31:55.91,Default,,0000,0000,0000,,Иә? Сара-чан
Dialogue: 0,0:31:52.91,0:31:55.91,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:31:55.91,0:31:58.92,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:31:55.91,0:31:58.92,Default,,0000,0000,0000,,Өйткені шаштың түсі әртүрлі.
Dialogue: 0,0:31:58.92,0:32:01.92,Default,,0000,0000,0000,,Бұл өзгерту.
Dialogue: 0,0:32:01.92,0:32:05.92,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:32:01.92,0:32:05.92,Default,,0000,0000,0000,,Әйелдің жүрегі қандай?
Dialogue: 0,0:32:05.92,0:32:09.93,Default,,0000,0000,0000,,Иә? Әйелдің жүрегі сенің аузыңнан шығады
Dialogue: 0,0:32:05.92,0:32:09.93,Default,,0000,0000,0000,,Сөздер шығады деп ойламаппын!
Dialogue: 0,0:32:09.93,0:32:12.86,Default,,0000,0000,0000,,Айнадағы мына жүзге қарап, айт!
Dialogue: 0,0:32:12.86,0:32:15.87,Default,,0000,0000,0000,,Бұл жебе аса бағалы — олардың тек біреуі ғана бар.
Dialogue: 0,0:32:15.87,0:32:25.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:32:25.88,0:32:27.85,Default,,0000,0000,0000,,Хокс та керемет болды.
Dialogue: 0,0:32:29.88,0:32:34.89,Default,,0000,0000,0000,,Мен сол қарақшы кемеде болдым
Dialogue: 0,0:32:29.88,0:32:34.89,Default,,0000,0000,0000,,Мен механик болып жұмыс істедім.
Dialogue: 0,0:32:34.89,0:32:38.89,Default,,0000,0000,0000,,Бірақ ол қашып кетті.
Dialogue: 0,0:32:34.89,0:32:38.89,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:32:38.89,0:32:41.89,Default,,0000,0000,0000,,Қарғыс атқыр...
Dialogue: 0,0:32:41.89,0:32:44.90,Default,,0000,0000,0000,,Мен одан шаршадым
Dialogue: 0,0:32:41.89,0:32:44.90,Default,,0000,0000,0000,,Ол маған көмектесуге қалай батылы барды!
Dialogue: 0,0:32:44.90,0:32:46.90,Default,,0000,0000,0000,,Бұл жігіт пе?
Dialogue: 0,0:32:46.90,0:32:50.90,Default,,0000,0000,0000,,О
Dialogue: 0,0:32:46.90,0:32:50.90,Default,,0000,0000,0000,,Сол қарақшылық кеменің капитаны➡
Dialogue: 0,0:32:50.90,0:32:52.90,Default,,0000,0000,0000,,Күміс!
Dialogue: 0,0:32:52.90,0:32:54.91,Default,,0000,0000,0000,,Күміс?
Dialogue: 0,0:32:54.91,0:32:57.91,Default,,0000,0000,0000,,Романмен бірдей
Dialogue: 0,0:32:57.91,0:32:59.91,Default,,0000,0000,0000,,Ал, Лабраба,
Dialogue: 0,0:32:57.91,0:32:59.91,Default,,0000,0000,0000,,Жүр, асығыңыз!
Dialogue: 0,0:32:59.91,0:33:01.91,Default,,0000,0000,0000,,Ой, ой, екеуің шынымен тамаша жұп екенсіңдер.
Dialogue: 0,0:32:59.91,0:33:01.91,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:33:01.91,0:33:03.92,Default,,0000,0000,0000,,Ал, Лабраба,
Dialogue: 0,0:33:01.91,0:33:03.92,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:33:03.92,0:33:05.92,Default,,0000,0000,0000,,Рұқсатсыз кету
Dialogue: 0,0:33:03.92,0:33:05.92,Default,,0000,0000,0000,,Меніңше, бұл матч…
Dialogue: 0,0:33:05.92,0:33:10.89,Default,,0000,0000,0000,,Егер олар бортқа шықса
Dialogue: 0,0:33:05.92,0:33:10.89,Default,,0000,0000,0000,,Мазасыз деп ойладым... иә?
Dialogue: 0,0:33:18.86,0:33:23.87,Default,,0000,0000,0000,,Гррр…
Dialogue: 0,0:33:18.86,0:33:23.87,Default,,0000,0000,0000,,Өзгертілген жоспарлар
Dialogue: 0,0:33:23.87,0:33:26.87,Default,,0000,0000,0000,,Келесі орынға өтіңіз
Dialogue: 0,0:33:26.87,0:33:28.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:33:34.88,0:33:38.88,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:33:34.88,0:33:38.88,Default,,0000,0000,0000,,Неліктен қарақшылар қазына іздейді?
Dialogue: 0,0:33:38.88,0:33:40.89,Default,,0000,0000,0000,,Мен жасырынуым керек пе?
Dialogue: 0,0:33:40.89,0:33:44.89,Default,,0000,0000,0000,,Аузыңды жап!
Dialogue: 0,0:33:40.89,0:33:44.89,Default,,0000,0000,0000,,Иә? Әй
Dialogue: 0,0:33:44.89,0:33:49.86,Default,,0000,0000,0000,,Яғни, осы адамдарға зиян келтіру...
Dialogue: 0,0:33:44.89,0:33:49.86,Default,,0000,0000,0000,,Көрген сайын омыртқам қалтырап кетеді.
Dialogue: 0,0:33:51.90,0:33:55.90,Default,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:33:51.90,0:33:55.90,Default,,0000,0000,0000,,Бұл жабайы жылан болды.
Dialogue: 0,0:33:55.90,0:33:58.90,Default,,0000,0000,0000,,Сара
Dialogue: 0,0:33:55.90,0:33:58.90,Default,,0000,0000,0000,,Бүгін не болды?
Dialogue: 0,0:33:58.90,0:34:01.91,Default,,0000,0000,0000,,Мен бөлмемнің қайда екенін білмеймін.
Dialogue: 0,0:33:58.90,0:34:01.91,Default,,0000,0000,0000,,Сіз қалай адасып кете аласыз?
Dialogue: 0,0:34:01.91,0:34:03.91,Default,,0000,0000,0000,,Эмма! Рэй!
Dialogue: 0,0:34:03.91,0:34:05.91,Default,,0000,0000,0000,,Бұл әлі де күдікті
Dialogue: 0,0:34:05.91,0:34:07.91,Default,,0000,0000,0000,,Сара шаршады.
Dialogue: 0,0:34:07.91,0:34:10.85,Default,,0000,0000,0000,,Шынымен де солайсың
Dialogue: 0,0:34:07.91,0:34:10.85,Default,,0000,0000,0000,,Мен әйелдердің жүрегін түсінбеймін.
Dialogue: 0,0:34:10.85,0:34:13.85,Default,,0000,0000,0000,,Ендеше айнаға қара!
Dialogue: 0,0:34:10.85,0:34:13.85,Default,,0000,0000,0000,,Шулы
Dialogue: 0,0:34:13.85,0:34:16.85,Default,,0000,0000,0000,,Көріскенше, Сара Чан
Dialogue: 0,0:34:13.85,0:34:16.85,Default,,0000,0000,0000,,Мен барлығын тыңшылап жүрмін, бірақ Хинацуру туралы ешқандай жаңалық жоқ.
Dialogue: 0,0:34:16.85,0:34:18.86,Default,,0000,0000,0000,,⚟ (Ақын) Әй! Күте тұрыңыз, қызанақ
Dialogue: 0,0:34:18.86,0:34:21.86,Default,,0000,0000,0000,,⚟Иә иә
Dialogue: 0,0:34:18.86,0:34:21.86,Default,,0000,0000,0000,,Келесі жолы мен сені нөлден бастап үйретемін.
Dialogue: 0,0:34:21.86,0:34:23.83,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:34:29.87,0:34:31.84,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:34:34.87,0:34:36.87,Default,,0000,0000,0000,,(Сидзуканың айқайы)
Dialogue: 0,0:34:36.87,0:34:40.88,Default,,0000,0000,0000,,⚟(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:34:36.87,0:34:40.88,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:34:40.88,0:34:43.88,Default,,0000,0000,0000,,Иә! Сен кімсің?
Dialogue: 0,0:34:43.88,0:34:46.88,Default,,0000,0000,0000,,Ах... бұл мен...
Dialogue: 0,0:34:46.88,0:34:50.89,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:34:46.88,0:34:50.89,Default,,0000,0000,0000,,Не, сен...
Dialogue: 0,0:34:50.89,0:34:53.89,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:34:53.89,0:34:55.89,Default,,0000,0000,0000,,⚟Сара, қайтып келдің бе?
Dialogue: 0,0:34:55.89,0:34:57.90,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:34:55.89,0:34:57.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:34:57.90,0:34:59.86,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:35:01.90,0:35:05.90,Default,,0000,0000,0000,,Сол капитан Күміске ешкім жоқ.
Dialogue: 0,0:35:01.90,0:35:05.90,Default,,0000,0000,0000,,Қарсы тұра алмаймын
Dialogue: 0,0:35:05.90,0:35:08.91,Default,,0000,0000,0000,,Әпкем аман болса екен.
Dialogue: 0,0:35:08.91,0:35:11.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:35:08.91,0:35:11.84,Default,,0000,0000,0000,,Сенің қарындасың бар ма?
Dialogue: 0,0:35:11.84,0:35:14.85,Default,,0000,0000,0000,,Викторина
Dialogue: 0,0:35:11.84,0:35:14.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:35:14.85,0:35:16.81,Default,,0000,0000,0000,,Уау?
Dialogue: 0,0:35:19.85,0:35:21.85,Default,,0000,0000,0000,,А, бұл!
Dialogue: 0,0:35:21.85,0:35:24.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:35:21.85,0:35:24.86,Default,,0000,0000,0000,,Дәл Шизука-чан сияқты!
Dialogue: 0,0:35:24.86,0:35:26.86,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:35:26.86,0:35:28.86,Default,,0000,0000,0000,,Түсіндім, Шизука-чан
Dialogue: 0,0:35:26.86,0:35:28.86,Default,,0000,0000,0000,,Мына қыздан қателестім➡
Dialogue: 0,0:35:28.86,0:35:30.86,Default,,0000,0000,0000,,Оны алып кетті.
Dialogue: 0,0:35:30.86,0:35:33.87,Default,,0000,0000,0000,,Шынайы болмысым ашылса
Dialogue: 0,0:35:30.86,0:35:33.87,Default,,0000,0000,0000,,Бұл үлкен мәміле болады
Dialogue: 0,0:35:33.87,0:35:35.87,Default,,0000,0000,0000,,Біз сізді тез арада құтқаруымыз керек!
Dialogue: 0,0:35:35.87,0:35:37.87,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:35:35.87,0:35:37.87,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:35:37.87,0:35:39.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:35:39.87,0:35:42.87,Default,,0000,0000,0000,,Қарақшылар кемесі алыста
Dialogue: 0,0:35:39.87,0:35:42.87,Default,,0000,0000,0000,,кетті
Dialogue: 0,0:35:42.87,0:35:44.88,Default,,0000,0000,0000,,Мен қайда екенімді де білмеймін
Dialogue: 0,0:35:44.88,0:35:46.88,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:35:46.88,0:35:49.88,Default,,0000,0000,0000,,Ақымақ болма!
Dialogue: 0,0:35:46.88,0:35:49.88,Default,,0000,0000,0000,,Бірдеңе істе!
Dialogue: 0,0:35:49.88,0:35:51.88,Default,,0000,0000,0000,,Ой! ? Хмм!
Dialogue: 0,0:35:51.88,0:35:56.89,Default,,0000,0000,0000,,Тіпті шындыққа жанаспайтын нәрсені айтсаң да
Dialogue: 0,0:35:51.88,0:35:56.89,Default,,0000,0000,0000,,Маған көмектес! Маған үйлен!
Dialogue: 0,0:35:56.89,0:35:59.89,Default,,0000,0000,0000,,Не~!
Dialogue: 0,0:35:56.89,0:35:59.89,Default,,0000,0000,0000,,Екеуің, тоқтаңдар!
Dialogue: 0,0:35:59.89,0:36:01.89,Default,,0000,0000,0000,,О мм...
Dialogue: 0,0:35:59.89,0:36:01.89,Default,,0000,0000,0000,,Нобита, сөйлеме!
Dialogue: 0,0:36:01.89,0:36:03.90,Default,,0000,0000,0000,,Қалай білуге болады
Dialogue: 0,0:36:01.89,0:36:03.90,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:36:03.90,0:36:05.90,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:36:03.90,0:36:05.90,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:36:05.90,0:36:07.90,Default,,0000,0000,0000,,Қыздырса да созылмайтын ірімшік
Dialogue: 0,0:36:05.90,0:36:07.90,Default,,0000,0000,0000,,Жұмбақ неде?
Dialogue: 0,0:36:07.90,0:36:11.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:36:07.90,0:36:11.84,Default,,0000,0000,0000,,Не, тағы бір сұрақ ма?
Dialogue: 0,0:36:11.84,0:36:14.84,Default,,0000,0000,0000,,Мен оны жылыта аламын ба?
Dialogue: 0,0:36:11.84,0:36:14.84,Default,,0000,0000,0000,,Ол созылмай ма?
Dialogue: 0,0:36:14.84,0:36:17.84,Default,,0000,0000,0000,,Сыр? Хмм...
Dialogue: 0,0:36:17.84,0:36:20.85,Default,,0000,0000,0000,,Осы қиын уақытта~
Dialogue: 0,0:36:20.85,0:36:22.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:36:20.85,0:36:22.85,Default,,0000,0000,0000,,Сәлем Гага!
Dialogue: 0,0:36:22.85,0:36:25.85,Default,,0000,0000,0000,,Киімді ауыстыру!
Dialogue: 0,0:36:22.85,0:36:25.85,Default,,0000,0000,0000,,Ах! Кешіріңіз... кешіріңіз
Dialogue: 0,0:36:25.85,0:36:27.85,Default,,0000,0000,0000,,Бұл не үшін?
Dialogue: 0,0:36:27.85,0:36:30.86,Default,,0000,0000,0000,,Қазір екі Сара бар емес пе?
Dialogue: 0,0:36:30.86,0:36:34.86,Default,,0000,0000,0000,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:36:30.86,0:36:34.86,Default,,0000,0000,0000,,О, мен сенімдімін.
Dialogue: 0,0:36:34.86,0:36:36.86,Default,,0000,0000,0000,,А, айна ма?
Dialogue: 0,0:36:36.86,0:36:38.86,Default,,0000,0000,0000,,⚟Сіз асығыңыз!
Dialogue: 0,0:36:36.86,0:36:38.86,Default,,0000,0000,0000,,Ой, барма.
Dialogue: 0,0:36:38.86,0:36:42.87,Default,,0000,0000,0000,,Сара, кешіріңіз.
Dialogue: 0,0:36:38.86,0:36:42.87,Default,,0000,0000,0000,,Кәдімгі наныңызбен бөлісе аласыз ба?
Dialogue: 0,0:36:42.87,0:36:47.87,Default,,0000,0000,0000,,Гага-сан, әрқашан.
Dialogue: 0,0:36:42.87,0:36:47.87,Default,,0000,0000,0000,,Мен оны бірден жеймін.
Dialogue: 0,0:36:47.87,0:36:50.88,Default,,0000,0000,0000,,Бұл менікі.
Dialogue: 0,0:36:50.88,0:36:52.88,Default,,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,0:36:50.88,0:36:52.88,Default,,0000,0000,0000,,Рақмет.
Dialogue: 0,0:36:52.88,0:36:55.88,Default,,0000,0000,0000,,Бұл мен емес, Виви-чан.
Dialogue: 0,0:36:52.88,0:36:55.88,Default,,0000,0000,0000,,Бұл сіздің сүйікті.
Dialogue: 0,0:36:55.88,0:36:57.88,Default,,0000,0000,0000,,Әрқашан
Dialogue: 0,0:36:55.88,0:36:57.88,Default,,0000,0000,0000,,Мен оны жұтқандай жеймін.
Dialogue: 0,0:36:57.88,0:36:59.88,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:36:57.88,0:36:59.88,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,0:36:59.88,0:37:01.89,Default,,0000,0000,0000,,Ик!
Dialogue: 0,0:37:01.89,0:37:03.89,Default,,0000,0000,0000,,Әдеттегідей рахмет
Dialogue: 0,0:37:03.89,0:37:06.89,Default,,0000,0000,0000,,Ренжіген кезде
Dialogue: 0,0:37:03.89,0:37:06.89,Default,,0000,0000,0000,,Сіз жасаған нан ең жақсы.
Dialogue: 0,0:37:06.89,0:37:10.86,Default,,0000,0000,0000,,Рахмет, көріскенше
Dialogue: 0,0:37:06.89,0:37:10.86,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:37:12.83,0:37:14.80,Default,,0000,0000,0000,,Қазір бәрі жақсы.
Dialogue: 0,0:37:16.83,0:37:19.84,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:37:19.84,0:37:21.84,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:37:21.84,0:37:25.84,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:37:21.84,0:37:25.84,Default,,0000,0000,0000,,Созылмайтын ірімшік Созылмайтын ірімшік?
Dialogue: 0,0:37:25.84,0:37:28.85,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:37:25.84,0:37:28.85,Default,,0000,0000,0000,,Қатты ірімшік?
Dialogue: 0,0:37:28.85,0:37:30.85,Default,,0000,0000,0000,,Ауырсын!
Dialogue: 0,0:37:30.85,0:37:32.85,Default,,0000,0000,0000,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:37:30.85,0:37:32.85,Default,,0000,0000,0000,,Уф... Ах!
Dialogue: 0,0:37:32.85,0:37:34.85,Default,,0000,0000,0000,,Мен әлі ештеңе айтқан жоқпын!
Dialogue: 0,0:37:32.85,0:37:34.85,Default,,0000,0000,0000,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:37:34.85,0:37:38.86,Default,,0000,0000,0000,,Сөзіңді созба!
Dialogue: 0,0:37:38.86,0:37:41.86,Default,,0000,0000,0000,,Бұлай емес... былай
Dialogue: 0,0:37:41.86,0:37:43.86,Default,,0000,0000,0000,,Жауабы карта!
Dialogue: 0,0:37:43.86,0:37:46.86,Default,,0000,0000,0000,,Пинг-понг!
Dialogue: 0,0:37:43.86,0:37:46.86,Default,,0000,0000,0000,,Менің айтайын дегенім осы еді!
Dialogue: 0,0:37:46.86,0:37:49.87,Default,,0000,0000,0000,,Мен бұл жай ғана тас бас деп ойладым.
Dialogue: 0,0:37:46.86,0:37:49.87,Default,,0000,0000,0000,,Күтілгендей!
Dialogue: 0,0:37:49.87,0:37:51.87,Default,,0000,0000,0000,,Тас басы артық
Dialogue: 0,0:37:51.87,0:37:53.87,Default,,0000,0000,0000,,Бірақ бұл карта қандай?
Dialogue: 0,0:37:53.87,0:37:58.88,Default,,0000,0000,0000,,Бұл карта емес
Dialogue: 0,0:37:53.87,0:37:58.88,Default,,0000,0000,0000,,Өйткені қарақшылық кеме – қазына аралы➡
Dialogue: 0,0:37:58.88,0:38:02.88,Default,,0000,0000,0000,,Осы қазына іздеу картасымен
Dialogue: 0,0:37:58.88,0:38:02.88,Default,,0000,0000,0000,,Сіз өз орныңызды таба аласыз
Dialogue: 0,0:38:02.88,0:38:05.88,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:38:05.88,0:38:08.89,Default,,0000,0000,0000,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:38:05.88,0:38:08.89,Default,,0000,0000,0000,,Біз экватордан өттік!
Dialogue: 0,0:38:08.89,0:38:12.82,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:38:08.89,0:38:12.82,Default,,0000,0000,0000,,Отар, ынтымақтастықта болыңыз.
Dialogue: 0,0:38:12.82,0:38:14.83,Default,,0000,0000,0000,,Біз Шизука-чанға көмектескіміз келеді
Dialogue: 0,0:38:14.83,0:38:17.83,Default,,0000,0000,0000,,Сіз Сара апаңызға көмектескіңіз келеді.
Dialogue: 0,0:38:17.83,0:38:20.83,Default,,0000,0000,0000,,Бірге жұмыс жасасақ, қолымыздан бәрі келеді!
Dialogue: 0,0:38:20.83,0:38:22.83,Default,,0000,0000,0000,,Балалар өз күштерін біріктіргенде➡
Dialogue: 0,0:38:22.83,0:38:25.84,Default,,0000,0000,0000,,Сол қарақшыларға
Dialogue: 0,0:38:22.83,0:38:25.84,Default,,0000,0000,0000,,Менің жеңуім мүмкін емес.
Dialogue: 0,0:38:25.84,0:38:27.84,Default,,0000,0000,0000,,Хе-хе-хе…
Dialogue: 0,0:38:27.84,0:38:30.84,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:38:27.84,0:38:30.84,Default,,0000,0000,0000,,22 ғасырдың супер роботы➡
Dialogue: 0,0:38:30.84,0:38:32.84,Default,,0000,0000,0000,,Себебі Дораемон осында!
Dialogue: 0,0:38:32.84,0:38:34.85,Default,,0000,0000,0000,,Жоқ, онша емес.
Dialogue: 0,0:38:34.85,0:38:38.85,Default,,0000,0000,0000,,Асықсаң түкке тұрғысыз нәрсе көп.
Dialogue: 0,0:38:34.85,0:38:38.85,Default,,0000,0000,0000,,Мен оны саған беремін.
Dialogue: 0,0:38:38.85,0:38:41.85,Default,,0000,0000,0000,,Тышқанды ұнатпаймын, қыңырмын.
Dialogue: 0,0:38:41.85,0:38:43.85,Default,,0000,0000,0000,,Пон Поко ракон түріндегі робот
Dialogue: 0,0:38:43.85,0:38:46.86,Default,,0000,0000,0000,,Ракон емес!
Dialogue: 0,0:38:43.85,0:38:46.86,Default,,0000,0000,0000,,Ракон емес!
Dialogue: 0,0:38:46.86,0:38:48.86,Default,,0000,0000,0000,,Мысалы, осы жағдайда—
Dialogue: 0,0:38:46.86,0:38:48.86,Default,,0000,0000,0000,,Мысалы, осы жағдайда—
Dialogue: 0,0:38:48.86,0:38:50.86,Default,,0000,0000,0000,,(Сунео, Джиан және Нобитаның күлкісі)
Dialogue: 0,0:38:50.86,0:38:52.86,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:38:52.86,0:38:55.87,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:38:55.87,0:38:59.87,Default,,0000,0000,0000,,Менің таңдауым жоқ
Dialogue: 0,0:38:55.87,0:38:59.87,Default,,0000,0000,0000,,Рахмет сізге Флок!
Dialogue: 0,0:38:59.87,0:39:02.87,Default,,0000,0000,0000,,Жарайды, егер сіз мұны шешсеңіз.
Dialogue: 0,0:38:59.87,0:39:02.87,Default,,0000,0000,0000,,Қазір кез келген жерде орындаңыз...
Dialogue: 0,0:39:02.87,0:39:04.88,Default,,0000,0000,0000,,Жоқ, жоқ!
Dialogue: 0,0:39:04.88,0:39:06.88,Default,,0000,0000,0000,,Енді қарақшылар кемесі
Dialogue: 0,0:39:04.88,0:39:06.88,Default,,0000,0000,0000,,Өйткені ол керемет жылдамдықпен қозғалады➡
Dialogue: 0,0:39:06.88,0:39:10.82,Default,,0000,0000,0000,,Пайдалану мүмкін емес
Dialogue: 0,0:39:06.88,0:39:10.82,Default,,0000,0000,0000,,Не істеуім керек...
Dialogue: 0,0:39:10.82,0:39:13.82,Default,,0000,0000,0000,,Осы карта сізде болса
Dialogue: 0,0:39:10.82,0:39:13.82,Default,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:39:13.82,0:39:15.82,Default,,0000,0000,0000,,Қайықпен қуамыз!
Dialogue: 0,0:39:15.82,0:39:17.79,Default,,0000,0000,0000,,(Нобита, Джан, Сунео)
Dialogue: 0,0:39:15.82,0:39:17.79,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:39:20.83,0:39:22.83,Default,,0000,0000,0000,,Мен Шизукамын
Dialogue: 0,0:39:22.83,0:39:25.83,Default,,0000,0000,0000,,Бұрынғы көмегіңіз үшін рахмет.
Dialogue: 0,0:39:25.83,0:39:28.83,Default,,0000,0000,0000,,Мен Сарамын
Dialogue: 0,0:39:25.83,0:39:28.83,Default,,0000,0000,0000,,О, отыра бер.
Dialogue: 0,0:39:28.83,0:39:30.84,Default,,0000,0000,0000,,Бірақ мен таң қалдым.
Dialogue: 0,0:39:30.84,0:39:33.84,Default,,0000,0000,0000,,Маған ұқсас адамдар
Dialogue: 0,0:39:30.84,0:39:33.84,Default,,0000,0000,0000,,Сіз шынымен де сондасыз ба?
Dialogue: 0,0:39:33.84,0:39:36.84,Default,,0000,0000,0000,,Сол адамдар, мен туралы.
Dialogue: 0,0:39:33.84,0:39:36.84,Default,,0000,0000,0000,,Ол мені Сара деп атады.
Dialogue: 0,0:39:36.84,0:39:39.84,Default,,0000,0000,0000,,Мен жағдайды түсіндім.
Dialogue: 0,0:39:39.84,0:39:43.85,Default,,0000,0000,0000,,Қарақшылар
Dialogue: 0,0:39:39.84,0:39:43.85,Default,,0000,0000,0000,,Неліктен бұл соншалықты жалаңаш?
Dialogue: 0,0:39:43.85,0:39:47.85,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:39:43.85,0:39:47.85,Default,,0000,0000,0000,,Сіз ше...
Dialogue: 0,0:39:47.85,0:39:51.86,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:39:47.85,0:39:51.86,Default,,0000,0000,0000,,Бұл кемеде күрделі жағдайлар бар.
Dialogue: 0,0:39:51.86,0:39:56.86,Default,,0000,0000,0000,,Бірақ бәрібір, мен жауаптымын.
Dialogue: 0,0:39:51.86,0:39:56.86,Default,,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:39:56.86,0:39:58.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:39:56.86,0:39:58.86,Default,,0000,0000,0000,,Йошитто
Dialogue: 0,0:39:58.86,0:40:00.87,Default,,0000,0000,0000,,Себебі сен маған ұқсайсың➡
Dialogue: 0,0:40:00.87,0:40:02.87,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:40:00.87,0:40:02.87,Default,,0000,0000,0000,,Оны осында әкелді.
Dialogue: 0,0:40:02.87,0:40:04.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:40:02.87,0:40:04.84,Default,,0000,0000,0000,,А...
Dialogue: 0,0:40:07.87,0:40:09.87,Default,,0000,0000,0000,,Әй, саған француз тосттары ұнамай ма?
Dialogue: 0,0:40:09.87,0:40:11.88,Default,,0000,0000,0000,,Хмм... Бірақ...
Dialogue: 0,0:40:11.88,0:40:14.85,Default,,0000,0000,0000,,Егер сен қаламасаң, мен аламын
Dialogue: 0,0:40:11.88,0:40:14.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:40:16.88,0:40:19.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:40:16.88,0:40:19.88,Default,,0000,0000,0000,,(Сидзуканың ішінің шуылдаған дыбысы)
Dialogue: 0,0:40:19.88,0:40:21.89,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:40:21.89,0:40:24.86,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:40:21.89,0:40:24.86,Default,,0000,0000,0000,,Уау... қалай күлесің!
Dialogue: 0,0:40:26.89,0:40:30.90,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:40:26.89,0:40:30.90,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,0:40:30.90,0:40:34.90,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,0:40:34.90,0:40:38.90,Default,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:40:34.90,0:40:38.90,Default,,0000,0000,0000,,Ұстамаңыз, мүмкіндігінше көп жеңіз
Dialogue: 0,0:40:38.90,0:40:40.91,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:40:40.91,0:40:42.91,Default,,0000,0000,0000,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:40:40.91,0:40:42.91,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:40:42.91,0:40:44.91,Default,,0000,0000,0000,,Мен де сол нан пісірдім.
Dialogue: 0,0:40:44.91,0:40:47.91,Default,,0000,0000,0000,,Мен қазір осы кемедегі асханада жұмыс істеймін.
Dialogue: 0,0:40:47.91,0:40:52.92,Default,,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,0:40:47.91,0:40:52.92,Default,,0000,0000,0000,,Енді не істеуім керек...
Dialogue: 0,0:40:52.92,0:40:55.92,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:40:52.92,0:40:55.92,Default,,0000,0000,0000,,Мүмкіндік міндетті түрде келеді
Dialogue: 0,0:40:55.92,0:40:58.92,Default,,0000,0000,0000,,Менің де үлкен ағам бар.
Dialogue: 0,0:40:55.92,0:40:58.92,Default,,0000,0000,0000,,Мен оны табуым керек.
Dialogue: 0,0:40:58.92,0:41:01.93,Default,,0000,0000,0000,,Үлкен аға?
Dialogue: 0,0:40:58.92,0:41:01.93,Default,,0000,0000,0000,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:41:01.93,0:41:04.93,Default,,0000,0000,0000,,Менің ағам
Dialogue: 0,0:41:01.93,0:41:04.93,Default,,0000,0000,0000,,Мен әкеммен ұрысып қалдым➡
Dialogue: 0,0:41:04.93,0:41:07.93,Default,,0000,0000,0000,,Мен бұл кемеден секірдім.
Dialogue: 0,0:41:04.93,0:41:07.93,Default,,0000,0000,0000,,Мен көремін...
Dialogue: 0,0:41:07.93,0:41:11.87,Default,,0000,0000,0000,,Мен қайда екенімді білмеймін
Dialogue: 0,0:41:11.87,0:41:13.87,Default,,0000,0000,0000,,Бірақ мен сенің қайтып келетініңе сенімдімін.
Dialogue: 0,0:41:13.87,0:41:17.88,Default,,0000,0000,0000,,Шизуканың достары да
Dialogue: 0,0:41:13.87,0:41:17.88,Default,,0000,0000,0000,,Оның сізге көмектесетініне сенімдімін.
Dialogue: 0,0:41:17.88,0:41:20.88,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:41:20.88,0:41:32.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:41:32.89,0:41:34.86,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:41:32.89,0:41:34.86,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:41:36.89,0:41:38.90,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:41:38.90,0:41:40.87,Default,,0000,0000,0000,,Медуза-чан
Dialogue: 0,0:41:49.91,0:41:52.91,Default,,0000,0000,0000,,Додо
Dialogue: 0,0:41:52.91,0:41:54.91,Default,,0000,0000,0000,,Додорарадо
Dialogue: 0,0:41:54.91,0:41:56.91,Default,,0000,0000,0000,,Додораладу!
Dialogue: 0,0:41:56.91,0:41:59.92,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:41:56.91,0:41:59.92,Default,,0000,0000,0000,,Қазір демалуға болады.
Dialogue: 0,0:41:59.92,0:42:01.89,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:42:04.92,0:42:10.86,Default,,0000,0000,0000,,Курстың ауытқуы жоқ
Dialogue: 0,0:42:04.92,0:42:10.86,Default,,0000,0000,0000,,Айналамыздағы төмен қысымды шығысқа қарай ұстайық.
Dialogue: 0,0:42:10.86,0:42:12.86,Default,,0000,0000,0000,,Уф... теңіз ауруы~
Dialogue: 0,0:42:12.86,0:42:15.87,Default,,0000,0000,0000,,Енді жоқ!
Dialogue: 0,0:42:12.86,0:42:15.87,Default,,0000,0000,0000,,Ахе~
Dialogue: 0,0:42:15.87,0:42:18.87,Default,,0000,0000,0000,,⚟ (Джан Сунеоның құсуы)
Dialogue: 0,0:42:18.87,0:42:22.87,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:42:22.87,0:42:26.84,Default,,0000,0000,0000,,Шизука-чан
Dialogue: 0,0:42:22.87,0:42:26.84,Default,,0000,0000,0000,,Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,0:42:30.88,0:42:33.88,Default,,0000,0000,0000,,(Қарақшылардың күлкісі)
Dialogue: 0,0:42:33.88,0:42:35.89,Default,,0000,0000,0000,,Мен сізге кедергі келтіремін, қария.
Dialogue: 0,0:42:33.88,0:42:35.89,Default,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:42:35.89,0:42:37.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:42:35.89,0:42:37.89,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:42:37.89,0:42:39.89,Default,,0000,0000,0000,,Сіз осылай істеп жатырсыз.
Dialogue: 0,0:42:39.89,0:42:42.89,Default,,0000,0000,0000,,Сіз әлі тамақ әзірледіңіз бе?
Dialogue: 0,0:42:39.89,0:42:42.89,Default,,0000,0000,0000,,Сыра қосылды!
Dialogue: 0,0:42:42.89,0:42:44.90,Default,,0000,0000,0000,,Бұл Грог емес, Рам.
Dialogue: 0,0:42:42.89,0:42:44.90,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:42:44.90,0:42:47.90,Default,,0000,0000,0000,,Мырза
Dialogue: 0,0:42:44.90,0:42:47.90,Default,,0000,0000,0000,,Сіздің пісіруіңіз ең жақсы➡
Dialogue: 0,0:42:47.90,0:42:50.90,Default,,0000,0000,0000,,О
Dialogue: 0,0:42:47.90,0:42:50.90,Default,,0000,0000,0000,,Мен ет жей алмаймын.
Dialogue: 0,0:42:50.90,0:42:53.90,Default,,0000,0000,0000,,Эй, күте тұрыңыз.
Dialogue: 0,0:42:50.90,0:42:53.90,Default,,0000,0000,0000,,Тағы бір кесе Тағы бір кесе
Dialogue: 0,0:42:53.90,0:42:56.91,Default,,0000,0000,0000,,6 қосымша арнайы түскі ас
Dialogue: 0,0:42:53.90,0:42:56.91,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:42:56.91,0:42:59.91,Default,,0000,0000,0000,,Мария, менен де сұраңызшы.
Dialogue: 0,0:42:56.91,0:42:59.91,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:42:59.91,0:43:02.91,Default,,0000,0000,0000,,Гонза асханасының көмегі!
Dialogue: 0,0:42:59.91,0:43:02.91,Default,,0000,0000,0000,,Уф Усу
Dialogue: 0,0:43:02.91,0:43:05.92,Default,,0000,0000,0000,,⚟Сара Багет қосылды
Dialogue: 0,0:43:02.91,0:43:05.92,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:43:05.92,0:43:07.92,Default,,0000,0000,0000,,⚟ (қоңырау дыбысы)
Dialogue: 0,0:43:07.92,0:43:10.85,Default,,0000,0000,0000,,Шизука өтінемін
Dialogue: 0,0:43:07.92,0:43:10.85,Default,,0000,0000,0000,,Бұл пеш шынымен ыстық➡
Dialogue: 0,0:43:10.85,0:43:12.82,Default,,0000,0000,0000,,Жоқ… әлі де бір жол бар.
Dialogue: 0,0:43:10.85,0:43:12.82,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:43:20.86,0:43:22.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:43:22.87,0:43:25.87,Default,,0000,0000,0000,,Иә, жақсы пісірілген.
Dialogue: 0,0:43:25.87,0:43:28.87,Default,,0000,0000,0000,,Мм... шынымен
Dialogue: 0,0:43:25.87,0:43:28.87,Default,,0000,0000,0000,,Мен осында тұра аламын ба?
Dialogue: 0,0:43:28.87,0:43:30.87,Default,,0000,0000,0000,,Иә, бәрібір.
Dialogue: 0,0:43:30.87,0:43:32.88,Default,,0000,0000,0000,,Марияға дұрыстап
Dialogue: 0,0:43:30.87,0:43:32.88,Default,,0000,0000,0000,,Мен сізге мән-жайды айттым.
Dialogue: 0,0:43:32.88,0:43:34.88,Default,,0000,0000,0000,,Жақсы қарқын, Сара.
Dialogue: 0,0:43:34.88,0:43:37.88,Default,,0000,0000,0000,,Өйткені менің тамаша көмекшім бар
Dialogue: 0,0:43:37.88,0:43:40.88,Default,,0000,0000,0000,,Мен құтқарылдым, Шизука.
Dialogue: 0,0:43:37.88,0:43:40.88,Default,,0000,0000,0000,,Әйтеуір, бізде жұмыс күші жетпейді➡
Dialogue: 0,0:43:40.88,0:43:43.89,Default,,0000,0000,0000,,Өйткені қиын болды
Dialogue: 0,0:43:40.88,0:43:43.89,Default,,0000,0000,0000,,Ер адамдар да пайдалана алмайды!
Dialogue: 0,0:43:43.89,0:43:45.89,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:43:43.89,0:43:45.89,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:43:45.89,0:43:49.89,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:43:45.89,0:43:49.89,Default,,0000,0000,0000,,Мен де бұл жерде өте қызық.
Dialogue: 0,0:43:49.89,0:43:54.90,Default,,0000,0000,0000,,Бұл Мария-тей басқа жерден қауіпсіз.
Dialogue: 0,0:43:49.89,0:43:54.90,Default,,0000,0000,0000,,Өйткені бұл экстерриториалдылық
Dialogue: 0,0:43:54.90,0:43:57.90,Default,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:43:54.90,0:43:57.90,Default,,0000,0000,0000,,Ер адамдар да сыр сақтасын➡
Dialogue: 0,0:43:57.90,0:43:59.90,Default,,0000,0000,0000,,Бұл анық айтылған
Dialogue: 0,0:43:59.90,0:44:01.91,Default,,0000,0000,0000,,Оның орнына
Dialogue: 0,0:43:59.90,0:44:01.91,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:44:01.91,0:44:04.91,Default,,0000,0000,0000,,Мен сені еңбектендіремін.
Dialogue: 0,0:44:01.91,0:44:04.91,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:44:04.91,0:44:06.88,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:44:09.91,0:44:12.85,Default,,0000,0000,0000,,Үш француз тосты
Dialogue: 0,0:44:09.91,0:44:12.85,Default,,0000,0000,0000,,Мұнда да екі!
Dialogue: 0,0:44:12.85,0:44:14.85,Default,,0000,0000,0000,,Мұны да сұраңыз!
Dialogue: 0,0:44:12.85,0:44:14.85,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:44:14.85,0:44:16.85,Default,,0000,0000,0000,,Сара
Dialogue: 0,0:44:14.85,0:44:16.85,Default,,0000,0000,0000,,Иә, қазір!
Dialogue: 0,0:44:16.85,0:44:18.86,Default,,0000,0000,0000,,Француз тосты өте танымал
Dialogue: 0,0:44:18.86,0:44:20.86,Default,,0000,0000,0000,,Бұл жерде маңдайша мәзірі.
Dialogue: 0,0:44:20.86,0:44:24.86,Default,,0000,0000,0000,,Бұл француз тосты
Dialogue: 0,0:44:20.86,0:44:24.86,Default,,0000,0000,0000,,Мұны маған анам үйретті.
Dialogue: 0,0:44:24.86,0:44:26.86,Default,,0000,0000,0000,,Өте дәмді нәрсе
Dialogue: 0,0:44:26.86,0:44:28.87,Default,,0000,0000,0000,,Сенің анаң қазір қайда?
Dialogue: 0,0:44:28.87,0:44:32.87,Default,,0000,0000,0000,,Менің анам
Dialogue: 0,0:44:28.87,0:44:32.87,Default,,0000,0000,0000,,Бес жыл бұрын аурудан қайтыс болды.
Dialogue: 0,0:44:32.87,0:44:35.87,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:44:35.87,0:44:37.88,Default,,0000,0000,0000,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:44:37.88,0:44:40.88,Default,,0000,0000,0000,,Эй… Өзіңді қолыңнан келсін!!
Dialogue: 0,0:44:37.88,0:44:40.88,Default,,0000,0000,0000,,Ол өте атақты ғалым болған.
Dialogue: 0,0:44:40.88,0:44:43.88,Default,,0000,0000,0000,,Жұмыс қарбалас болды, бірақ
Dialogue: 0,0:44:40.88,0:44:43.88,Default,,0000,0000,0000,,Үйге келгенде➡
Dialogue: 0,0:44:43.88,0:44:46.88,Default,,0000,0000,0000,,Бұл француз тосты
Dialogue: 0,0:44:43.88,0:44:46.88,Default,,0000,0000,0000,,Оны мен үшін жасады
Dialogue: 0,0:44:46.88,0:44:49.89,Default,,0000,0000,0000,,Сіздің ағаңыз
Dialogue: 0,0:44:46.88,0:44:49.89,Default,,0000,0000,0000,,Неліктен кемені тастап кеттің?
Dialogue: 0,0:44:49.89,0:44:53.89,Default,,0000,0000,0000,,Менің ағам әрқашан болды
Dialogue: 0,0:44:49.89,0:44:53.89,Default,,0000,0000,0000,,Мен әкеммен жақсы араласпадым.
Dialogue: 0,0:44:53.89,0:44:56.89,Default,,0000,0000,0000,,Бір күні мен бұл жерден міндетті түрде кетемін
Dialogue: 0,0:44:53.89,0:44:56.89,Default,,0000,0000,0000,,Мен істі соңына дейін жеткізетін адаммын!
Dialogue: 0,0:44:56.89,0:44:58.90,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:44:58.90,0:45:02.90,Default,,0000,0000,0000,,қыңырлықпен
Dialogue: 0,0:44:58.90,0:45:02.90,Default,,0000,0000,0000,,Көп сөйлеме
Dialogue: 0,0:45:02.90,0:45:05.90,Default,,0000,0000,0000,,Неліктен ұлдар әрқашан
Dialogue: 0,0:45:02.90,0:45:05.90,Default,,0000,0000,0000,,Сіз мағынасыз болуға тырысасыз ба?
Dialogue: 0,0:45:05.90,0:45:08.91,Default,,0000,0000,0000,,Менің жинақтағы ақшамнан тек 285 йен ғана қалды!
Dialogue: 0,0:45:05.90,0:45:08.91,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:45:08.91,0:45:11.84,Default,,0000,0000,0000,,Мұрын арқылы карбонара жеу
Dialogue: 0,0:45:08.91,0:45:11.84,Default,,0000,0000,0000,,Сіз бірдеңе айтасыз ба?
Dialogue: 0,0:45:11.84,0:45:14.85,Default,,0000,0000,0000,,Біртүрлі емес пе?
Dialogue: 0,0:45:11.84,0:45:14.85,Default,,0000,0000,0000,,Ахахаха!
Dialogue: 0,0:45:14.85,0:45:16.85,Default,,0000,0000,0000,,Бұл адамның несі қызық
Dialogue: 0,0:45:16.85,0:45:18.85,Default,,0000,0000,0000,,Хехе... Иә.
Dialogue: 0,0:45:18.85,0:45:20.85,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,0:45:20.85,0:45:23.85,Default,,0000,0000,0000,,⚟ (Сара Шизуканың күлкісі)
Dialogue: 0,0:45:23.85,0:45:25.86,Default,,0000,0000,0000,,Бұл жәндік емес.
Dialogue: 0,0:45:25.86,0:45:30.83,Default,,0000,0000,0000,,Иә, жұмыстан кейін.
Dialogue: 0,0:45:25.86,0:45:30.83,Default,,0000,0000,0000,,Мен саған жақсы жер көрсетемін
Dialogue: 0,0:45:35.87,0:45:37.87,Default,,0000,0000,0000,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:45:35.87,0:45:37.87,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:45:37.87,0:45:39.87,Default,,0000,0000,0000,,Шизука дәмді!
Dialogue: 0,0:45:37.87,0:45:39.87,Default,,0000,0000,0000,,«Ол менің кім екенімді де білмейді»
Dialogue: 0,0:45:39.87,0:45:42.87,Default,,0000,0000,0000,,Ұшайық!
Dialogue: 0,0:45:39.87,0:45:42.87,Default,,0000,0000,0000,,Иә? Апыр-ай!
Dialogue: 0,0:45:42.87,0:45:57.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:57.89,0:45:59.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:45:59.89,0:46:15.84,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:46:15.84,0:46:17.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:46:20.84,0:46:22.85,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:46:20.84,0:46:22.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:22.85,0:46:24.82,Default,,0000,0000,0000,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:46:22.85,0:46:24.82,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:46:26.85,0:46:30.85,Default,,0000,0000,0000,,Сәлем Сара
Dialogue: 0,0:46:26.85,0:46:30.85,Default,,0000,0000,0000,,Бұл шынымен қарақшылар кемесі ме?
Dialogue: 0,0:46:30.85,0:46:32.86,Default,,0000,0000,0000,,Ал біз болсақ, жай ғана
Dialogue: 0,0:46:32.86,0:46:37.86,Default,,0000,0000,0000,,Бастапқыда басқа мақсат үшін жасалған кеме.
Dialogue: 0,0:46:32.86,0:46:37.86,Default,,0000,0000,0000,,Ол өзгертілген сияқты
Dialogue: 0,0:46:37.86,0:46:39.83,Default,,0000,0000,0000,,Одан гөрі, міне!
Dialogue: 0,0:46:42.87,0:46:46.84,Default,,0000,0000,0000,,Сара!
Dialogue: 0,0:46:42.87,0:46:46.84,Default,,0000,0000,0000,,Уайымдама, мен қозғалмаймын.
Dialogue: 0,0:46:48.87,0:46:50.87,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:46:48.87,0:46:50.87,Default,,0000,0000,0000,,Гендердің сақталуы➡
Dialogue: 0,0:46:50.87,0:46:53.88,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:46:50.87,0:46:53.88,Default,,0000,0000,0000,,деді ағам
Dialogue: 0,0:46:53.88,0:46:56.88,Default,,0000,0000,0000,,Маған көрсеткіңіз келгені осы емес пе?
Dialogue: 0,0:46:56.88,0:46:59.88,Default,,0000,0000,0000,,Мен мұнда кіре алмаймын➡
Dialogue: 0,0:46:59.88,0:47:01.89,Default,,0000,0000,0000,,Менің ағам
Dialogue: 0,0:46:59.88,0:47:01.89,Default,,0000,0000,0000,,Мен құлыпты сындырдым
Dialogue: 0,0:47:01.89,0:47:04.86,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:47:10.83,0:47:12.80,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:47:21.84,0:47:23.81,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:47:38.86,0:47:40.82,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:47:45.86,0:47:47.86,Default,,0000,0000,0000,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:47:47.86,0:47:52.87,Default,,0000,0000,0000,,Мұхит түбінде мыңдаған жылдар бар.
Dialogue: 0,0:47:47.86,0:47:52.87,Default,,0000,0000,0000,,Бірдеңені жоғалттыңыз ба?
Dialogue: 0,0:47:52.87,0:47:54.87,Default,,0000,0000,0000,,Мұның бәрі?
Dialogue: 0,0:47:54.87,0:47:58.88,Default,,0000,0000,0000,,Иә! әртүрлі дәуірлер
Dialogue: 0,0:47:54.87,0:47:58.88,Default,,0000,0000,0000,,Теңіз түбінен жиналған заттар
Dialogue: 0,0:47:58.88,0:48:01.88,Default,,0000,0000,0000,,Уау, бұл Treasure Island сияқты!
Dialogue: 0,0:48:01.88,0:48:04.88,Default,,0000,0000,0000,,Бірақ мен көп жинадым
Dialogue: 0,0:48:01.88,0:48:04.88,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:48:04.88,0:48:08.89,Default,,0000,0000,0000,,Өйткені ол бір күні пайдалы болады
Dialogue: 0,0:48:04.88,0:48:08.89,Default,,0000,0000,0000,,деді әкем
Dialogue: 0,0:48:08.89,0:48:12.82,Default,,0000,0000,0000,,Әй, Сараның әкесі
Dialogue: 0,0:48:08.89,0:48:12.82,Default,,0000,0000,0000,,Сіз қайдасыз?
Dialogue: 0,0:48:12.82,0:48:14.83,Default,,0000,0000,0000,,Сіз бұл кемедесіз, солай ма?
Dialogue: 0,0:48:14.83,0:48:19.83,Default,,0000,0000,0000,,Иә, мен жоғарыда жұмыс істеймін.
Dialogue: 0,0:48:14.83,0:48:19.83,Default,,0000,0000,0000,,Түсінікті! Рақмет!
Dialogue: 0,0:48:19.83,0:48:23.83,Default,,0000,0000,0000,,Бір-бірімізді көптен бері көрмеген шығармыз.
Dialogue: 0,0:48:19.83,0:48:23.83,Default,,0000,0000,0000,,Сіз өзіңізді жалғыз сезінбейсіз бе?
Dialogue: 0,0:48:23.83,0:48:27.84,Default,,0000,0000,0000,,Қазір үйреніп қалдым
Dialogue: 0,0:48:23.83,0:48:27.84,Default,,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:48:27.84,0:48:29.84,Default,,0000,0000,0000,,Әкең не істейді➡
Dialogue: 0,0:48:29.84,0:48:33.84,Default,,0000,0000,0000,,Бұл жақсы нәрсе ме, әлде жаман нәрсе ме?
Dialogue: 0,0:48:29.84,0:48:33.84,Default,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:48:33.84,0:48:37.85,Default,,0000,0000,0000,,Себеп бар екеніне сенімдімін.
Dialogue: 0,0:48:37.85,0:48:40.85,Default,,0000,0000,0000,,Бірақ ағам мені кешіре алмады.
Dialogue: 0,0:48:40.85,0:48:45.82,Default,,0000,0000,0000,,Мен бүкіл отбасымен біргемін
Dialogue: 0,0:48:40.85,0:48:45.82,Default,,0000,0000,0000,,Мен жай ғана үйлесімді өмір сүргім келеді.
Dialogue: 0,0:48:50.86,0:48:53.86,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:48:50.86,0:48:53.86,Default,,0000,0000,0000,,Киттер, дельфиндер және теңіз арыстандары➡
Dialogue: 0,0:48:53.86,0:48:56.87,Default,,0000,0000,0000,,Барлығын бірден қалай қабылдауға болады
Dialogue: 0,0:48:53.86,0:48:56.87,Default,,0000,0000,0000,,Жұмбақ неде?
Dialogue: 0,0:48:56.87,0:48:59.87,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:48:56.87,0:48:59.87,Default,,0000,0000,0000,,Барлығын бірден қалай қабылдауға болады...
Dialogue: 0,0:48:59.87,0:49:01.87,Default,,0000,0000,0000,,Маржа маржа
Dialogue: 0,0:48:59.87,0:49:01.87,Default,,0000,0000,0000,,Doraemon үшін ең жақсысын жасаңыз! Алыңыз!
Dialogue: 0,0:49:01.87,0:49:04.88,Default,,0000,0000,0000,,Түсіндім, суретке түсір!
Dialogue: 0,0:49:01.87,0:49:04.88,Default,,0000,0000,0000,,Пинг Донг!
Dialogue: 0,0:49:04.88,0:49:06.88,Default,,0000,0000,0000,,(Нобита, Сунео, Джиан)
Dialogue: 0,0:49:04.88,0:49:06.88,Default,,0000,0000,0000,,Жарайды, мен жасадым! Күткендей!
Dialogue: 0,0:49:06.88,0:49:11.82,Default,,0000,0000,0000,,3, 4 және 5 жастағы балалар
Dialogue: 0,0:49:06.88,0:49:11.82,Default,,0000,0000,0000,,Бірден айқайласақ неше жаста болар едік?
Dialogue: 0,0:49:11.82,0:49:14.82,Default,,0000,0000,0000,,Хмм...шулы!
Dialogue: 0,0:49:11.82,0:49:14.82,Default,,0000,0000,0000,,Пинг Донг!
Dialogue: 0,0:49:14.82,0:49:16.82,Default,,0000,0000,0000,,Викторина Жоғалтпа
Dialogue: 0,0:49:14.82,0:49:16.82,Default,,0000,0000,0000,,Иә, данышпан!
Dialogue: 0,0:49:16.82,0:49:19.82,Default,,0000,0000,0000,,Чицут және робот Қандай жұмбақ?
Dialogue: 0,0:49:19.82,0:49:21.83,Default,,0000,0000,0000,,Чицут және робот?
Dialogue: 0,0:49:21.83,0:49:24.83,Default,,0000,0000,0000,,Чицутето?
Dialogue: 0,0:49:21.83,0:49:24.83,Default,,0000,0000,0000,,Тачицут?
Dialogue: 0,0:49:24.83,0:49:28.83,Default,,0000,0000,0000,,Тачицутпен «та» жоқ.
Dialogue: 0,0:49:24.83,0:49:28.83,Default,,0000,0000,0000,,“ta” жоқ…
Dialogue: 0,0:49:28.83,0:49:31.84,Default,,0000,0000,0000,,Ракон робот!
Dialogue: 0,0:49:28.83,0:49:31.84,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,0:49:31.84,0:49:33.84,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:49:31.84,0:49:33.84,Default,,0000,0000,0000,,...Мен енот емеспін!
Dialogue: 0,0:49:33.84,0:49:37.84,Default,,0000,0000,0000,,Бұл енот ит емес!
Dialogue: 0,0:49:33.84,0:49:37.84,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:49:37.84,0:49:39.84,Default,,0000,0000,0000,,Викторина
Dialogue: 0,0:49:37.84,0:49:39.84,Default,,0000,0000,0000,,Тотықұс тәрізді бала күтуші робот
Dialogue: 0,0:49:39.84,0:49:42.85,Default,,0000,0000,0000,,Сіз ракон тәрізді бала күтуші роботсыз ба?
Dialogue: 0,0:49:42.85,0:49:44.85,Default,,0000,0000,0000,,Дораемон мысық тәрізді.
Dialogue: 0,0:49:44.85,0:49:49.85,Default,,0000,0000,0000,,Қайда барсаң да, теңіз теңіз теңіз
Dialogue: 0,0:49:44.85,0:49:49.85,Default,,0000,0000,0000,,Кейде тіпті тауда...
Dialogue: 0,0:49:49.85,0:49:52.86,Default,,0000,0000,0000,,⚟ (күн күркіреуі)
Dialogue: 0,0:49:49.85,0:49:52.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:52.86,0:49:54.86,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:49:54.86,0:49:57.86,Default,,0000,0000,0000,,Дододо... Дораемон!
Dialogue: 0,0:49:57.86,0:50:00.86,Default,,0000,0000,0000,,(Найзағайдың гүрсілі)
Dialogue: 0,0:50:00.86,0:50:04.87,Default,,0000,0000,0000,,Нашар! Күтілгеннен төмен қысым
Dialogue: 0,0:50:00.86,0:50:04.87,Default,,0000,0000,0000,,Ол шығысқа қарай шықты.
Dialogue: 0,0:50:04.87,0:50:07.87,Default,,0000,0000,0000,,Толық жылдамдықпен қашыңыз!
Dialogue: 0,0:50:04.87,0:50:07.87,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:50:07.87,0:50:11.88,Default,,0000,0000,0000,,⚟(Соқтығыс дыбысы)
Dialogue: 0,0:50:07.87,0:50:11.88,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:50:11.88,0:50:13.88,Default,,0000,0000,0000,,Бұл риф.
Dialogue: 0,0:50:11.88,0:50:13.88,Default,,0000,0000,0000,,Мен кеменің түбін қырдым!
Dialogue: 0,0:50:13.88,0:50:15.85,Default,,0000,0000,0000,,⚟(Соқтығыс дыбысы)
Dialogue: 0,0:50:13.88,0:50:15.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:50:20.88,0:50:22.89,Default,,0000,0000,0000,,Дораемон суы!
Dialogue: 0,0:50:22.89,0:50:24.89,Default,,0000,0000,0000,,Жетті, Конни
Dialogue: 0,0:50:22.89,0:50:24.89,Default,,0000,0000,0000,,Сіз батып бара жатырсыз!
Dialogue: 0,0:50:24.89,0:50:27.89,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:50:24.89,0:50:27.89,Default,,0000,0000,0000,,Су қолғаптары және төрт өлшемді қоқыс жәшігі!
Dialogue: 0,0:50:27.89,0:50:30.89,Default,,0000,0000,0000,,Доллар
Dialogue: 0,0:50:27.89,0:50:30.89,Default,,0000,0000,0000,,Барлық мүшелер, суды төгіп тастаңдар!
Dialogue: 0,0:50:30.89,0:50:34.87,Default,,0000,0000,0000,,Дора Дора Дора...
Dialogue: 0,0:50:36.90,0:50:39.90,Default,,0000,0000,0000,,Ыстық!
Dialogue: 0,0:50:36.90,0:50:39.90,Default,,0000,0000,0000,,Йотто!
Dialogue: 0,0:50:39.90,0:50:42.91,Default,,0000,0000,0000,,《Қорқпа. Дем ал.》
Dialogue: 0,0:50:39.90,0:50:42.91,Default,,0000,0000,0000,,Бұл қарқынмен біз оны уақытында орындамаймыз.
Dialogue: 0,0:50:42.91,0:50:44.91,Default,,0000,0000,0000,,Шелектен де жақсы, солай ма?
Dialogue: 0,0:50:44.91,0:50:47.91,Default,,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:50:44.91,0:50:47.91,Default,,0000,0000,0000,,Бізді ұстады!
Dialogue: 0,0:50:47.91,0:50:50.91,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:50:50.91,0:50:52.92,Default,,0000,0000,0000,,Ха! Бұл құс!
Dialogue: 0,0:50:52.92,0:50:54.92,Default,,0000,0000,0000,,Осындай уақытта не айтып тұрсың?
Dialogue: 0,0:50:54.92,0:50:59.92,Default,,0000,0000,0000,,Қараймын, құстар бар.
Dialogue: 0,0:50:54.92,0:50:59.92,Default,,0000,0000,0000,,Бұл жақын жерде арал бар дегенді білдіреді!
Dialogue: 0,0:50:59.92,0:51:01.89,Default,,0000,0000,0000,,Ио... Уф...
Dialogue: 0,0:51:03.93,0:51:07.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:51:03.93,0:51:07.93,Default,,0000,0000,0000,,8 сағат бағыты аралдың көлеңкесі табылды!
Dialogue: 0,0:51:07.93,0:51:11.87,Default,,0000,0000,0000,,Көптеген айлалар!
Dialogue: 0,0:51:07.93,0:51:11.87,Default,,0000,0000,0000,,Барлық мүшелер, сол аралды мақсат етейік!
Dialogue: 0,0:51:11.87,0:51:13.87,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:51:13.87,0:51:16.87,Default,,0000,0000,0000,,Автоматтандырылған навигация жүйесі зақымдалған
Dialogue: 0,0:51:16.87,0:51:19.88,Default,,0000,0000,0000,,Төтенше жағдайға байланысты
Dialogue: 0,0:51:16.87,0:51:19.88,Default,,0000,0000,0000,,Қолмен жұмыс істеуге ауысыңыз!
Dialogue: 0,0:51:19.88,0:51:22.88,Default,,0000,0000,0000,,Барлығы арқанды тартады
Dialogue: 0,0:51:19.88,0:51:22.88,Default,,0000,0000,0000,,Желкендерді бұрыңыз!
Dialogue: 0,0:51:22.88,0:51:24.88,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:51:22.88,0:51:24.88,Default,,0000,0000,0000,,Сіз айттыңыз➡
Dialogue: 0,0:51:24.88,0:51:27.88,Default,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:51:24.88,0:51:27.88,Default,,0000,0000,0000,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:51:27.88,0:51:30.89,Default,,0000,0000,0000,,Түсіндіруге уақытым жоқ.
Dialogue: 0,0:51:27.88,0:51:30.89,Default,,0000,0000,0000,,Оны денеңізбен есте сақтаңыз!
Dialogue: 0,0:51:30.89,0:51:34.89,Default,,0000,0000,0000,,Желге мұқият қара
Dialogue: 0,0:51:30.89,0:51:34.89,Default,,0000,0000,0000,,Желкендеріңізге жел салыңыз!
Dialogue: 0,0:51:34.89,0:51:39.90,Default,,0000,0000,0000,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:51:39.90,0:51:41.90,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:51:39.90,0:51:41.90,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:51:41.90,0:51:44.90,Default,,0000,0000,0000,,Джан!
Dialogue: 0,0:51:41.90,0:51:44.90,Default,,0000,0000,0000,,Керісінше емес пе?
Dialogue: 0,0:51:44.90,0:51:47.90,Default,,0000,0000,0000,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:51:44.90,0:51:47.90,Default,,0000,0000,0000,,Біз қуып жеттік!
Dialogue: 0,0:51:47.90,0:51:50.91,Default,,0000,0000,0000,,Жел тым қатты
Dialogue: 0,0:51:47.90,0:51:50.91,Default,,0000,0000,0000,,Негізгі желкенді бүктеңіз!
Dialogue: 0,0:51:50.91,0:51:53.91,Default,,0000,0000,0000,,Мынау ма?
Dialogue: 0,0:51:50.91,0:51:53.91,Default,,0000,0000,0000,,Жоқ, менің ойымша, жоқ.
Dialogue: 0,0:51:53.91,0:51:56.91,Default,,0000,0000,0000,,Күтпе!
Dialogue: 0,0:51:53.91,0:51:56.91,Default,,0000,0000,0000,,мачта сынып қалады!
Dialogue: 0,0:51:56.91,0:51:58.92,Default,,0000,0000,0000,,Желкені солға көбірек бұрыңыз!
Dialogue: 0,0:51:58.92,0:52:02.92,Default,,0000,0000,0000,,Бастық болып, бұйрық берме!
Dialogue: 0,0:51:58.92,0:52:02.92,Default,,0000,0000,0000,,Мен мұны біраз уақыттан бері істеп жүрмін!
Dialogue: 0,0:52:02.92,0:52:04.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:52:02.92,0:52:04.92,Default,,0000,0000,0000,,Уау! Уф...
Dialogue: 0,0:52:04.92,0:52:06.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:52:04.92,0:52:06.92,Default,,0000,0000,0000,,Отар!
Dialogue: 0,0:52:06.92,0:52:09.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:52:09.93,0:52:12.86,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,0:52:12.86,0:52:15.87,Default,,0000,0000,0000,,Балалар, мотивацияларың бар ма?
Dialogue: 0,0:52:12.86,0:52:15.87,Default,,0000,0000,0000,,Дұрыс істе!
Dialogue: 0,0:52:15.87,0:52:19.87,Default,,0000,0000,0000,,Не? Сіз мұны дұрыс жасауыңыз керек!
Dialogue: 0,0:52:15.87,0:52:19.87,Default,,0000,0000,0000,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:52:19.87,0:52:21.87,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:52:19.87,0:52:21.87,Default,,0000,0000,0000,,Менің аяғымды тартып жатырсың!
Dialogue: 0,0:52:21.87,0:52:23.87,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:52:23.87,0:52:26.88,Default,,0000,0000,0000,,Осындай кездерде
Dialogue: 0,0:52:23.87,0:52:26.88,Default,,0000,0000,0000,,Ұрысқан жақсы!
Dialogue: 0,0:52:26.88,0:52:31.88,Default,,0000,0000,0000,,Бәріміз бірге дем алайық!
Dialogue: 0,0:52:31.88,0:52:36.89,Default,,0000,0000,0000,,Нобита
Dialogue: 0,0:52:31.88,0:52:36.89,Default,,0000,0000,0000,,Ынтымақтастық жасасақ, бірдеңе болады!
Dialogue: 0,0:52:36.89,0:52:38.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:52:38.89,0:52:41.89,Default,,0000,0000,0000,,Нобита сондай тәкаппар!
Dialogue: 0,0:52:38.89,0:52:41.89,Default,,0000,0000,0000,,Джан
Dialogue: 0,0:52:41.89,0:52:44.90,Default,,0000,0000,0000,,Шынымен де рас
Dialogue: 0,0:52:41.89,0:52:44.90,Default,,0000,0000,0000,,Сунео!
Dialogue: 0,0:52:44.90,0:52:46.90,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:52:46.90,0:52:48.87,Default,,0000,0000,0000,,Жарайды, жасап көрейік!
Dialogue: 0,0:52:50.90,0:52:52.90,Default,,0000,0000,0000,,Сіз дайынсыз ба?
Dialogue: 0,0:52:52.90,0:52:54.91,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:52:52.90,0:52:54.91,Default,,0000,0000,0000,,О
Dialogue: 0,0:52:54.91,0:52:56.91,Default,,0000,0000,0000,,Кез келген уақытта!
Dialogue: 0,0:52:56.91,0:52:59.91,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:52:59.91,0:53:08.92,Default,,0000,0000,0000,,ОЖ ОЖ
Dialogue: 0,0:52:59.91,0:53:08.92,Default,,0000,0000,0000,,ОЖ ОЖ ОЖ
Dialogue: 0,0:53:08.92,0:53:11.86,Default,,0000,0000,0000,,Жақсы, солай!
Dialogue: 0,0:53:08.92,0:53:11.86,Default,,0000,0000,0000,,Әрі қарай, желкендерді бұрыңыз!
Dialogue: 0,0:53:11.86,0:53:14.86,Default,,0000,0000,0000,,ОЖ ОЖ
Dialogue: 0,0:53:14.86,0:53:18.86,Default,,0000,0000,0000,,Нобита, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:53:14.86,0:53:18.86,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:53:18.86,0:53:21.87,Default,,0000,0000,0000,,Керемет, желкендер желді ұстады!
Dialogue: 0,0:53:18.86,0:53:21.87,Default,,0000,0000,0000,,Дора!
Dialogue: 0,0:53:21.87,0:53:23.87,Default,,0000,0000,0000,,Бар! Барлығына сәттілік!
Dialogue: 0,0:53:23.87,0:53:25.87,Default,,0000,0000,0000,,Маған қалдыр!
Dialogue: 0,0:53:25.87,0:53:37.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:37.88,0:53:41.89,Default,,0000,0000,0000,,Ха ха ха ха...
Dialogue: 0,0:53:41.89,0:53:44.89,Default,,0000,0000,0000,,Бұл жер~
Dialogue: 0,0:53:44.89,0:53:47.89,Default,,0000,0000,0000,,Ха ха ха өте жақсы сезім!
Dialogue: 0,0:53:47.89,0:53:49.89,Default,,0000,0000,0000,,Баршаңызға жақсы жұмыс
Dialogue: 0,0:53:49.89,0:53:51.90,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:53:51.90,0:53:55.90,Default,,0000,0000,0000,,Ол жыртылған.
Dialogue: 0,0:53:51.90,0:53:55.90,Default,,0000,0000,0000,,Өйткені ол шамамен жиналған.
Dialogue: 0,0:53:55.90,0:53:57.90,Default,,0000,0000,0000,,Не істеуіміз керек, Нобита?
Dialogue: 0,0:53:57.90,0:53:59.90,Default,,0000,0000,0000,,Бұл қозғалмайды!
Dialogue: 0,0:53:59.90,0:54:02.91,Default,,0000,0000,0000,,Барша адамның ішінен… сен бе
Dialogue: 0,0:54:02.91,0:54:05.91,Default,,0000,0000,0000,,Мен оны түзетуге тырысамын.
Dialogue: 0,0:54:02.91,0:54:05.91,Default,,0000,0000,0000,,А, сен мұны істей аласың ба?
Dialogue: 0,0:54:05.91,0:54:09.91,Default,,0000,0000,0000,,Ах, негізгі механика үшін.
Dialogue: 0,0:54:05.91,0:54:09.91,Default,,0000,0000,0000,,Мен оны үйрендім.
Dialogue: 0,0:54:09.91,0:54:12.85,Default,,0000,0000,0000,,Рахмет сізге Флок!
Dialogue: 0,0:54:09.91,0:54:12.85,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:54:12.85,0:54:14.85,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:54:14.85,0:54:17.85,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:54:14.85,0:54:17.85,Default,,0000,0000,0000,,Бүгін осы аралға қосылайық.
Dialogue: 0,0:54:17.85,0:54:21.86,Default,,0000,0000,0000,,Ертең таңертең кеме жөнделген бойда біз жолға шығамыз.
Dialogue: 0,0:54:17.85,0:54:21.86,Default,,0000,0000,0000,,Yahoo!
Dialogue: 0,0:54:21.86,0:54:23.86,Default,,0000,0000,0000,,Сунео
Dialogue: 0,0:54:21.86,0:54:23.86,Default,,0000,0000,0000,,Жүр, тамақ іздейік!
Dialogue: 0,0:54:23.86,0:54:25.86,Default,,0000,0000,0000,,Иә! Зерттеу!
Dialogue: 0,0:54:25.86,0:54:27.83,Default,,0000,0000,0000,,Ой... мен де!
Dialogue: 0,0:54:31.87,0:54:33.84,Default,,0000,0000,0000,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:54:35.87,0:54:38.84,Default,,0000,0000,0000,,Викторина
Dialogue: 0,0:54:35.87,0:54:38.84,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:54:43.88,0:54:45.85,Default,,0000,0000,0000,,Менің ойымша, бұл қандай да бір жолмен жүзеге асады.
Dialogue: 0,0:54:47.88,0:54:49.89,Default,,0000,0000,0000,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:54:49.89,0:54:52.89,Default,,0000,0000,0000,,Дәмді!
Dialogue: 0,0:54:49.89,0:54:52.89,Default,,0000,0000,0000,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:54:52.89,0:54:54.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:54:58.90,0:55:00.90,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:55:00.90,0:55:04.90,Default,,0000,0000,0000,,Пуха! Ең жақсы!
Dialogue: 0,0:55:04.90,0:55:06.90,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:55:06.90,0:55:08.91,Default,,0000,0000,0000,,Ұстадым!
Dialogue: 0,0:55:08.91,0:55:10.84,Default,,0000,0000,0000,,(Джан Сунеоның күлкісі)
Dialogue: 0,0:55:08.91,0:55:10.84,Default,,0000,0000,0000,,Уау! Уф...
Dialogue: 0,0:55:10.84,0:55:12.84,Default,,0000,0000,0000,,Хм
Dialogue: 0,0:55:12.84,0:55:14.81,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:55:16.85,0:55:19.85,Default,,0000,0000,0000,,Неге, мен не істесем де...
Dialogue: 0,0:55:19.85,0:55:33.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:33.86,0:55:38.87,Default,,0000,0000,0000,,Сондай-ақ Шизука-чанға
Dialogue: 0,0:55:33.86,0:55:38.87,Default,,0000,0000,0000,,Мен сізге көрсеткім келді
Dialogue: 0,0:55:38.87,0:55:40.84,Default,,0000,0000,0000,,Ха ха ха ха...
Dialogue: 0,0:55:42.87,0:55:45.88,Default,,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:55:42.87,0:55:45.88,Default,,0000,0000,0000,,Нобитаны және басқаларын табыңыз
Dialogue: 0,0:55:45.88,0:55:49.88,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:55:49.88,0:55:52.88,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:55:49.88,0:55:52.88,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:55:52.88,0:55:54.88,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:55:54.88,0:55:57.89,Default,,0000,0000,0000,,Өтінемін, медуза-чан
Dialogue: 0,0:55:54.88,0:55:57.89,Default,,0000,0000,0000,,Мен сенетін жалғыз адамсың
Dialogue: 0,0:55:57.89,0:56:00.89,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:56:00.89,0:56:04.89,Default,,0000,0000,0000,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:56:00.89,0:56:04.89,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:56:04.89,0:56:09.90,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:56:09.90,0:56:11.84,Default,,0000,0000,0000,,Медуза?
Dialogue: 0,0:56:11.84,0:56:14.80,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,0:56:11.84,0:56:14.80,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:56:17.84,0:56:21.85,Default,,0000,0000,0000,,(оттың үрлеу дыбысы)
Dialogue: 0,0:56:21.85,0:56:27.85,Default,,0000,0000,0000,,Додо
Dialogue: 0,0:56:21.85,0:56:27.85,Default,,0000,0000,0000,,Дора Дора Дора Дора
Dialogue: 0,0:56:27.85,0:56:29.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:56:48.87,0:56:50.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:56:48.87,0:56:50.87,Default,,0000,0000,0000,,Уау, түзетілді!
Dialogue: 0,0:56:50.87,0:56:53.88,Default,,0000,0000,0000,,Беріліс
Dialogue: 0,0:56:50.87,0:56:53.88,Default,,0000,0000,0000,,Сіз оны жоғары жылдамдыққа қоя аласыз ба?
Dialogue: 0,0:56:53.88,0:56:55.88,Default,,0000,0000,0000,,Иә? Жоғары жылдамдық?
Dialogue: 0,0:56:55.88,0:56:57.85,Default,,0000,0000,0000,,Иә, бұл ма?
Dialogue: 0,0:57:00.88,0:57:03.85,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:57:00.88,0:57:03.85,Default,,0000,0000,0000,,Бұл не! Не?
Dialogue: 0,0:57:11.83,0:57:15.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:57:15.83,0:57:17.83,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:57:15.83,0:57:17.83,Default,,0000,0000,0000,,Тезірек барады!
Dialogue: 0,0:57:17.83,0:57:19.84,Default,,0000,0000,0000,,Ғажайып отар!
Dialogue: 0,0:57:19.84,0:57:22.84,Default,,0000,0000,0000,,Жоқ, кеменің өнімділігі
Dialogue: 0,0:57:19.84,0:57:22.84,Default,,0000,0000,0000,,Мен оны шамамен 10 рет көтердім ➡
Dialogue: 0,0:57:22.84,0:57:25.84,Default,,0000,0000,0000,,Әлі қарақшы кемені қуып жете алмады
Dialogue: 0,0:57:22.84,0:57:25.84,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:57:25.84,0:57:29.85,Default,,0000,0000,0000,,Жарайды, егер солай болса...
Dialogue: 0,0:57:25.84,0:57:29.85,Default,,0000,0000,0000,,Дора!
Dialogue: 0,0:57:29.85,0:57:32.85,Default,,0000,0000,0000,,Фуджин фанаты!
Dialogue: 0,0:57:29.85,0:57:32.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,0:57:32.85,0:57:34.85,Default,,0000,0000,0000,,Долер!
Dialogue: 0,0:57:34.85,0:57:36.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:57:36.85,0:57:39.82,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:57:41.86,0:57:45.86,Default,,0000,0000,0000,,Иә, аға, сен кереметсің.
Dialogue: 0,0:57:41.86,0:57:45.86,Default,,0000,0000,0000,,Жақсы! Мен бұған жете аламын!
Dialogue: 0,0:57:45.86,0:57:50.87,Default,,0000,0000,0000,,Жаңа Новита Аура
Dialogue: 0,0:57:45.86,0:57:50.87,Default,,0000,0000,0000,,Қазына аралына дейін толық жылдамдықпен!
Dialogue: 0,0:57:50.87,0:57:53.87,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:57:53.87,0:58:13.82,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:58:13.82,0:58:23.83,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:58:23.83,0:58:26.84,Default,,0000,0000,0000,,⚟Атлант мұхитына кірді
Dialogue: 0,0:58:23.83,0:58:26.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:26.84,0:58:29.84,Default,,0000,0000,0000,,Ертең келсе
Dialogue: 0,0:58:26.84,0:58:29.84,Default,,0000,0000,0000,,Қарақшы кемені қуып жету керек
Dialogue: 0,0:58:29.84,0:58:31.84,Default,,0000,0000,0000,,Отар шынымен таң қалдырады.
Dialogue: 0,0:58:31.84,0:58:34.84,Default,,0000,0000,0000,,Сіз кемені осылай өзгерте алатыныңызға сене алмаймын.
Dialogue: 0,0:58:34.84,0:58:36.85,Default,,0000,0000,0000,,Онымен салыстырғанда мен...
Dialogue: 0,0:58:36.85,0:58:38.85,Default,,0000,0000,0000,,Нобитаның арнайы дағдылары бар ма?
Dialogue: 0,0:58:38.85,0:58:41.85,Default,,0000,0000,0000,,Ұйқы және бесік!
Dialogue: 0,0:58:41.85,0:58:44.85,Default,,0000,0000,0000,,...Сосын Шизука-чан.
Dialogue: 0,0:58:41.85,0:58:44.85,Default,,0000,0000,0000,,Мен сізге көмектесе алмаймын.
Dialogue: 0,0:58:44.85,0:58:46.86,Default,,0000,0000,0000,,Хаха…
Dialogue: 0,0:58:44.85,0:58:46.86,Default,,0000,0000,0000,,Эй, Отар бұл➡
Dialogue: 0,0:58:46.86,0:58:49.86,Default,,0000,0000,0000,,Неліктен қарақшы кеме?
Dialogue: 0,0:58:46.86,0:58:49.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:58:49.86,0:58:54.86,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:58:49.86,0:58:54.86,Default,,0000,0000,0000,,Айтқың келмесе, жақсы.
Dialogue: 0,0:58:54.86,0:58:56.87,Default,,0000,0000,0000,,Бұл бастапқыда ➡ болды
Dialogue: 0,0:58:56.87,0:58:59.87,Default,,0000,0000,0000,,Менің анам ғалым болған.
Dialogue: 0,0:58:56.87,0:58:59.87,Default,,0000,0000,0000,,Бұл жобаланған кеме.
Dialogue: 0,0:58:59.87,0:59:01.84,Default,,0000,0000,0000,,Ана?
Dialogue: 0,0:59:03.87,0:59:05.88,Default,,0000,0000,0000,,(Сара Флоктың күлкісі)
Dialogue: 0,0:59:05.88,0:59:09.88,Default,,0000,0000,0000,,
Dialogue: 0,0:59:05.88,0:59:09.88,Default,,0000,0000,0000,,｟Отар Сара, ол қайда? ｠
Dialogue: 0,0:59:09.88,0:59:12.82,Default,,0000,0000,0000,,｟～｠
Dialogue: 0,0:59:09.88,0:59:12.82,Default,,0000,0000,0000,,｟Hehehe｠
Dialogue: 0,0:59:12.82,0:59:14.82,Default,,0000,0000,0000,,｜Олар мүлде мазасыз балалар｠
Dialogue: 0,0:59:14.82,0:59:18.82,Default,,0000,0000,0000,,Ана мен әкесі
Dialogue: 0,0:59:14.82,0:59:18.82,Default,,0000,0000,0000,,Мұнай мен атом энергиясына балама➡
Dialogue: 0,0:59:18.82,0:59:20.82,Default,,0000,0000,0000,,Жаңа энергия
Dialogue: 0,0:59:18.82,0:59:20.82,Default,,0000,0000,0000,,Мен білуге тырыстым
Dialogue: 0,0:59:20.82,0:59:22.83,Default,,0000,0000,0000,,｟Анашым! ｠
Dialogue: 0,0:59:20.82,0:59:22.83,Default,,0000,0000,0000,,｟Hehehehe｠
Dialogue: 0,0:59:22.83,0:59:25.83,Default,,0000,0000,0000,,｟Ана иә｠
Dialogue: 0,0:59:22.83,0:59:25.83,Default,,0000,0000,0000,,｟О, рахмет｠
Dialogue: 0,0:59:25.83,0:59:27.83,Default,,0000,0000,0000,,｟Эй, бұл не? ｠
Dialogue: 0,0:59:27.83,0:59:31.83,Default,,0000,0000,0000,,｟Уа, бұл өте үлкен.
Dialogue: 0,0:59:27.83,0:59:31.83,Default,,0000,0000,0000,,Теңізде жүзетін бұл не?
Dialogue: 0,0:59:31.83,0:59:33.84,Default,,0000,0000,0000,,｟Е, у...｠
Dialogue: 0,0:59:33.84,0:59:35.84,Default,,0000,0000,0000,,
Dialogue: 0,0:59:33.84,0:59:35.84,Default,,0000,0000,0000,,｟Жарайды, үлкен қалқымалы сақина! ｠
Dialogue: 0,0:59:35.84,0:59:37.84,Default,,0000,0000,0000,,｟Бу Бу｠
Dialogue: 0,0:59:35.84,0:59:37.84,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,0:59:37.84,0:59:39.84,Default,,0000,0000,0000,,｟Hehehe｠
Dialogue: 0,0:59:37.84,0:59:39.84,Default,,0000,0000,0000,,｟Түсінікті! ｠
Dialogue: 0,0:59:39.84,0:59:41.84,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:59:39.84,0:59:41.84,Default,,0000,0000,0000,,｟Ах! ｠
Dialogue: 0,0:59:41.84,0:59:43.85,Default,,0000,0000,0000,,｟Жауап – кеме! ｠
Dialogue: 0,0:59:43.85,0:59:45.85,Default,,0000,0000,0000,,｟Пинг Донг｠
Dialogue: 0,0:59:43.85,0:59:45.85,Default,,0000,0000,0000,,｟Иә! ｠
Dialogue: 0,0:59:45.85,0:59:48.85,Default,,0000,0000,0000,,｟Бірақ бұл жай ғана кеме емес｠
Dialogue: 0,0:59:45.85,0:59:48.85,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,0:59:48.85,0:59:50.85,Default,,0000,0000,0000,,｟Жердің күші
Dialogue: 0,0:59:48.85,0:59:50.85,Default,,0000,0000,0000,,Менімен аздап бөліссеңіз➡
Dialogue: 0,0:59:50.85,0:59:55.86,Default,,0000,0000,0000,,Барлығы бақытты бола алатын кеме｠
Dialogue: 0,0:59:50.85,0:59:55.86,Default,,0000,0000,0000,,｟Тамаша! ｠
Dialogue: 0,0:59:55.86,0:59:59.86,Default,,0000,0000,0000,,(Сара күледі)
Dialogue: 0,0:59:59.86,1:00:01.86,Default,,0000,0000,0000,,｟Орындалды~｠
Dialogue: 0,0:59:59.86,1:00:01.86,Default,,0000,0000,0000,,Иә? ｠
Dialogue: 0,1:00:01.86,1:00:03.87,Default,,0000,0000,0000,,｟Бұл жерде осылай көрінеді
Dialogue: 0,1:00:01.86,1:00:03.87,Default,,0000,0000,0000,,Егер мұны істесеңіз...｠
Dialogue: 0,1:00:03.87,1:00:07.87,Default,,0000,0000,0000,,｟Мм... Иә? ｠
Dialogue: 0,1:00:07.87,1:00:09.87,Default,,0000,0000,0000,,｟Ммм…｠
Dialogue: 0,1:00:09.87,1:00:13.88,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,1:00:13.88,1:00:18.88,Default,,0000,0000,0000,,Бірақ 5 жыл бұрын
Dialogue: 0,1:00:13.88,1:00:18.88,Default,,0000,0000,0000,,Анам ауырып қалды...
Dialogue: 0,1:00:18.88,1:00:21.88,Default,,0000,0000,0000,,｟Ақыр соңында, сіз
Dialogue: 0,1:00:18.88,1:00:21.88,Default,,0000,0000,0000,,Керемет Фиона! ｠
Dialogue: 0,1:00:21.88,1:00:23.89,Default,,0000,0000,0000,,｟Бұл армандардың энергиясы! ｠
Dialogue: 0,1:00:23.89,1:00:25.89,Default,,0000,0000,0000,,｟ Күте тұрыңыз, Джон.
Dialogue: 0,1:00:23.89,1:00:25.89,Default,,0000,0000,0000,,Ол әлі толық емес｠
Dialogue: 0,1:00:25.89,1:00:28.89,Default,,0000,0000,0000,,｟Жердің магнит өрісінің деректері
Dialogue: 0,1:00:25.89,1:00:28.89,Default,,0000,0000,0000,,Болжаудан айырмашылығы｠
Dialogue: 0,1:00:28.89,1:00:30.89,Default,,0000,0000,0000,,｟Ол қателік шегінде емес пе? ｠
Dialogue: 0,1:00:30.89,1:00:32.90,Default,,0000,0000,0000,,｜Бірдеңе болғаннан кейін тым кеш｠
Dialogue: 0,1:00:32.90,1:00:34.90,Default,,0000,0000,0000,,｜Маған әрі қарай зерттеу керек｠
Dialogue: 0,1:00:34.90,1:00:37.90,Default,,0000,0000,0000,,｟Кішкене демалу керек.
Dialogue: 0,1:00:34.90,1:00:37.90,Default,,0000,0000,0000,,Сіз бозғылт көрінесіз｠
Dialogue: 0,1:00:37.90,1:00:39.90,Default,,0000,0000,0000,,｟Сіз не істей аласыз
Dialogue: 0,1:00:37.90,1:00:39.90,Default,,0000,0000,0000,,Мен бәрін істегім келеді｠
Dialogue: 0,1:00:39.90,1:00:41.90,Default,,0000,0000,0000,,｟Балалар үшін де! ｠
Dialogue: 0,1:00:41.90,1:00:43.91,Default,,0000,0000,0000,,｟Аа...｠
Dialogue: 0,1:00:41.90,1:00:43.91,Default,,0000,0000,0000,,｟Ах Фиона｠
Dialogue: 0,1:00:43.91,1:00:45.88,Default,,0000,0000,0000,,｟Фиона! ｠
Dialogue: 0,1:00:49.91,1:00:52.92,Default,,0000,0000,0000,,Менің анам қайтыс болды
Dialogue: 0,1:00:49.91,1:00:52.92,Default,,0000,0000,0000,,Біраз уақыттан кейін бір күн➡
Dialogue: 0,1:00:52.92,1:00:54.92,Default,,0000,0000,0000,,Менің әкем
Dialogue: 0,1:00:52.92,1:00:54.92,Default,,0000,0000,0000,,Ол кенет өзгерді.
Dialogue: 0,1:00:54.92,1:00:57.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:00:57.92,1:01:00.92,Default,,0000,0000,0000,,Жерде не бар?
Dialogue: 0,1:00:57.92,1:01:00.92,Default,,0000,0000,0000,,Сіз оған құмарсыз ба?
Dialogue: 0,1:01:00.92,1:01:04.93,Default,,0000,0000,0000,,Күндіз-түні жабық
Dialogue: 0,1:01:00.92,1:01:04.93,Default,,0000,0000,0000,,Мен зерттеуді бастадым.
Dialogue: 0,1:01:04.93,1:01:07.93,Default,,0000,0000,0000,,Қиындыққа ұшырағандай көрінген әке рөлін сомдау
Dialogue: 0,1:01:04.93,1:01:07.93,Default,,0000,0000,0000,,Кішкене болса да тұрғым келеді➡
Dialogue: 0,1:01:07.93,1:01:10.87,Default,,0000,0000,0000,,Механик
Dialogue: 0,1:01:07.93,1:01:10.87,Default,,0000,0000,0000,,Мен оны өзім зерттедім.
Dialogue: 0,1:01:10.87,1:01:12.87,Default,,0000,0000,0000,,Сонда да әкем➡
Dialogue: 0,1:01:12.87,1:01:16.87,Default,,0000,0000,0000,,Анам жасаған қайық
Dialogue: 0,1:01:12.87,1:01:16.87,Default,,0000,0000,0000,,Оны қарақшылық кемеге немесе басқа нәрсеге өзгертіңіз➡
Dialogue: 0,1:01:16.87,1:01:18.88,Default,,0000,0000,0000,,Мен қазына жинай бастадым!
Dialogue: 0,1:01:16.87,1:01:18.88,Default,,0000,0000,0000,,А...
Dialogue: 0,1:01:18.88,1:01:21.88,Default,,0000,0000,0000,,Фроктың әкесі кім?
Dialogue: 0,1:01:18.88,1:01:21.88,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:01:21.88,1:01:24.88,Default,,0000,0000,0000,,Ха, не бар?
Dialogue: 0,1:01:21.88,1:01:24.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:01:24.88,1:01:26.85,Default,,0000,0000,0000,,Онда!
Dialogue: 0,1:01:30.89,1:01:32.89,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,1:01:30.89,1:01:32.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:01:32.89,1:01:36.89,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,1:01:32.89,1:01:36.89,Default,,0000,0000,0000,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,1:01:36.89,1:01:40.90,Default,,0000,0000,0000,,Шизука-чанда бұл болды.
Dialogue: 0,1:01:36.89,1:01:40.90,Default,,0000,0000,0000,,Флуоресцентті бағытталған медузалар!
Dialogue: 0,1:01:40.90,1:01:42.87,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,1:01:50.91,1:01:52.91,Default,,0000,0000,0000,,《Қарама》
Dialogue: 0,1:01:50.91,1:01:52.91,Default,,0000,0000,0000,,《Әке! 》
Dialogue: 0,1:01:52.91,1:01:55.91,Default,,0000,0000,0000,,《Қарамаңыз! 》
Dialogue: 0,1:01:52.91,1:01:55.91,Default,,0000,0000,0000,,《Джон…》
Dialogue: 0,1:01:55.91,1:01:58.88,Default,,0000,0000,0000,,《Джон》
Dialogue: 0,1:02:25.88,1:02:27.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:02:27.88,1:02:31.88,Default,,0000,0000,0000,,Ха ха ха ха...
Dialogue: 0,1:02:31.88,1:02:33.85,Default,,0000,0000,0000,,Я...
Dialogue: 0,1:02:39.89,1:02:55.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:02:55.91,1:02:57.91,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:02:55.91,1:02:57.91,Default,,0000,0000,0000,,Мария!
Dialogue: 0,1:02:57.91,1:02:59.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:02:59.91,1:03:03.91,Default,,0000,0000,0000,,Ақыры межелі жерге де жеттік
Dialogue: 0,1:03:03.91,1:03:06.92,Default,,0000,0000,0000,,Мүмкіндігінше тезірек...
Dialogue: 0,1:03:06.92,1:03:10.85,Default,,0000,0000,0000,,Нұхтың кемесі жоспарын орындаңыз!
Dialogue: 0,1:03:10.85,1:03:30.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:03:30.87,1:03:33.88,Default,,0000,0000,0000,,Мен жердің болашағын көрдім
Dialogue: 0,1:03:33.88,1:03:35.88,Default,,0000,0000,0000,,Бұл болашақ күйреу болды.
Dialogue: 0,1:03:35.88,1:03:41.88,Default,,0000,0000,0000,,Адамзатты құтқару үшін, жерді таста
Dialogue: 0,1:03:35.88,1:03:41.88,Default,,0000,0000,0000,,Жаңа дүние іздеуден басқа жол жоқ.
Dialogue: 0,1:03:41.88,1:03:44.89,Default,,0000,0000,0000,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,1:03:41.88,1:03:44.89,Default,,0000,0000,0000,,Үлкен энергияны қажет етеді
Dialogue: 0,1:03:44.89,1:03:50.89,Default,,0000,0000,0000,,Болашақта біз қатаң бақылауда боламыз.
Dialogue: 0,1:03:44.89,1:03:50.89,Default,,0000,0000,0000,,Сейтай
Dialogue: 0,1:03:44.89,1:03:50.89,Default,,0000,0000,0000,,Жердің жұлдыз энергиясы ➡
Dialogue: 0,1:03:50.89,1:03:53.90,Default,,0000,0000,0000,,Бұл дәуірде
Dialogue: 0,1:03:50.89,1:03:53.90,Default,,0000,0000,0000,,Өз қалауы бойынша шығаруға болады
Dialogue: 0,1:03:53.90,1:03:58.90,Default,,0000,0000,0000,,Астральды энергияны басып алғаннан кейін
Dialogue: 0,1:03:53.90,1:03:58.90,Default,,0000,0000,0000,,Бұл кеме жаңа жұлдызға бет алды.
Dialogue: 0,1:03:58.90,1:04:00.90,Default,,0000,0000,0000,,Бұл ұзақ сапар болады
Dialogue: 0,1:04:00.90,1:04:03.91,Default,,0000,0000,0000,,Бірақ біздің балаларымыз бен немерелеріміз
Dialogue: 0,1:04:00.90,1:04:03.91,Default,,0000,0000,0000,,Уәде етілген жерде➡
Dialogue: 0,1:04:03.91,1:04:06.91,Default,,0000,0000,0000,,Жаңа елді салады
Dialogue: 0,1:04:03.91,1:04:06.91,Default,,0000,0000,0000,,(тұрғындардың айқайы)
Dialogue: 0,1:04:06.91,1:04:08.91,Default,,0000,0000,0000,,Жинаған бар байлығыммен
Dialogue: 0,1:04:08.91,1:04:11.85,Default,,0000,0000,0000,,Нұхтың кемесі? Жаңа жұлдыз?
Dialogue: 0,1:04:11.85,1:04:13.85,Default,,0000,0000,0000,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,1:04:13.85,1:04:15.85,Default,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,1:04:15.85,1:04:18.86,Default,,0000,0000,0000,,Жерге қазіргі әсері қандай?
Dialogue: 0,1:04:15.85,1:04:18.86,Default,,0000,0000,0000,,Шектеулі
Dialogue: 0,1:04:18.86,1:04:21.86,Default,,0000,0000,0000,,Ха! Әке...
Dialogue: 0,1:04:21.86,1:04:23.86,Default,,0000,0000,0000,,Әке! ?
Dialogue: 0,1:04:21.86,1:04:23.86,Default,,0000,0000,0000,,⚟(Ескерту)
Dialogue: 0,1:04:23.86,1:04:27.86,Default,,0000,0000,0000,,⚟(Ескерту)
Dialogue: 0,1:04:27.86,1:04:29.87,Default,,0000,0000,0000,,Нобита-сан! Дора-чан!
Dialogue: 0,1:04:29.87,1:04:31.83,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:04:38.88,1:04:41.84,Default,,0000,0000,0000,,Күте тұрыңыз, Шизука!
Dialogue: 0,1:04:38.88,1:04:41.84,Default,,0000,0000,0000,,Енді барма!
Dialogue: 0,1:04:45.88,1:04:47.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:04:45.88,1:04:47.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:04:47.88,1:04:49.89,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:04:47.88,1:04:49.89,Default,,0000,0000,0000,,Екі Сара Чан?
Dialogue: 0,1:04:49.89,1:04:52.86,Default,,0000,0000,0000,,Бұл жалған болды!
Dialogue: 0,1:04:58.89,1:05:00.86,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,1:05:05.90,1:05:07.90,Default,,0000,0000,0000,,Мен оны көрдім!
Dialogue: 0,1:05:07.90,1:05:09.91,Default,,0000,0000,0000,,Толық жылдамдық алға!
Dialogue: 0,1:05:07.90,1:05:09.91,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:05:09.91,1:05:12.84,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,1:05:09.91,1:05:12.84,Default,,0000,0000,0000,,Мен саған көмектесемін!
Dialogue: 0,1:05:12.84,1:05:15.81,Default,,0000,0000,0000,,Дора!
Dialogue: 0,1:05:23.85,1:05:25.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:05:25.86,1:05:27.86,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,1:05:27.86,1:05:29.86,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,1:05:29.86,1:05:32.86,Default,,0000,0000,0000,,Нашар! Фунунуну...
Dialogue: 0,1:05:32.86,1:05:38.87,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,1:05:38.87,1:05:41.84,Default,,0000,0000,0000,,Нобита-сан! Дора-чан!
Dialogue: 0,1:05:38.87,1:05:41.84,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:05:43.87,1:05:45.88,Default,,0000,0000,0000,,Тез кетіңіз
Dialogue: 0,1:05:45.88,1:05:49.88,Default,,0000,0000,0000,,Әйтпесе
Dialogue: 0,1:05:45.88,1:05:49.88,Default,,0000,0000,0000,,Жеке қауіпсіздікке кепілдік берілмейді
Dialogue: 0,1:05:49.88,1:05:51.88,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:05:49.88,1:05:51.88,Default,,0000,0000,0000,,Егер сен осы екеуін қорғасаң, мен шабуылға көңіл бөле аламын
Dialogue: 0,1:05:51.88,1:05:54.88,Default,,0000,0000,0000,,Қарақшылық кеменің капитаны! ?
Dialogue: 0,1:05:54.88,1:05:56.89,Default,,0000,0000,0000,,Күміс!
Dialogue: 0,1:05:56.89,1:06:00.89,Default,,0000,0000,0000,,Отар Сіз сондасыз ба?
Dialogue: 0,1:05:56.89,1:06:00.89,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:06:00.89,1:06:02.89,Default,,0000,0000,0000,,Менің ойымша, сіз мұны қазір аяқтадыңыз.
Dialogue: 0,1:06:00.89,1:06:02.89,Default,,0000,0000,0000,,Қайтып кел!
Dialogue: 0,1:06:02.89,1:06:04.89,Default,,0000,0000,0000,,Қарғыс атқыр...
Dialogue: 0,1:06:04.89,1:06:07.86,Default,,0000,0000,0000,,Жоқ! Әке...
Dialogue: 0,1:06:09.90,1:06:14.84,Default,,0000,0000,0000,,Ол мені әлдеқашан ұнатып қалды
Dialogue: 0,1:06:09.90,1:06:14.84,Default,,0000,0000,0000,,Менің әкем емес!
Dialogue: 0,1:06:14.84,1:06:18.84,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,1:06:14.84,1:06:18.84,Default,,0000,0000,0000,,Отардың әкесі күміс
Dialogue: 0,1:06:18.84,1:06:21.84,Default,,0000,0000,0000,,Викторина!
Dialogue: 0,1:06:18.84,1:06:21.84,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:06:21.84,1:06:23.85,Default,,0000,0000,0000,,Сара!
Dialogue: 0,1:06:23.85,1:06:28.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:06:28.85,1:06:31.85,Default,,0000,0000,0000,,Викторина!
Dialogue: 0,1:06:28.85,1:06:31.85,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:06:31.85,1:06:34.86,Default,,0000,0000,0000,,Сара да осында кел!
Dialogue: 0,1:06:34.86,1:06:37.86,Default,,0000,0000,0000,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:06:37.86,1:06:39.83,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:06:41.86,1:06:45.87,Default,,0000,0000,0000,,Әке!
Dialogue: 0,1:06:41.86,1:06:45.87,Default,,0000,0000,0000,,Сара…
Dialogue: 0,1:06:45.87,1:06:47.87,Default,,0000,0000,0000,,Шизука, жүр!
Dialogue: 0,1:06:45.87,1:06:47.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:06:47.87,1:06:49.87,Default,,0000,0000,0000,,Бұл — радио гимнастика.
Dialogue: 0,1:06:47.87,1:06:49.87,Default,,0000,0000,0000,,Ах! Мұнда!
Dialogue: 0,1:06:49.87,1:06:52.88,Default,,0000,0000,0000,,Сіз әлі түсінбейсіз!
Dialogue: 0,1:06:52.88,1:06:54.88,Default,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,1:06:54.88,1:06:58.88,Default,,0000,0000,0000,,Ах... Уау!
Dialogue: 0,1:06:58.88,1:07:00.88,Default,,0000,0000,0000,,Дораемон Кемені су шайып жатыр!
Dialogue: 0,1:07:00.88,1:07:04.89,Default,,0000,0000,0000,,Мынаны қараңыз!
Dialogue: 0,1:07:00.88,1:07:04.89,Default,,0000,0000,0000,,Ух... аа аа аа!
Dialogue: 0,1:07:04.89,1:07:09.89,Default,,0000,0000,0000,,Бұл өтірік! ?
Dialogue: 0,1:07:09.89,1:07:11.83,Default,,0000,0000,0000,,Тағы да! ? Ахх...
Dialogue: 0,1:07:11.83,1:07:15.83,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,1:07:11.83,1:07:15.83,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:07:15.83,1:07:17.83,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,1:07:17.83,1:07:19.84,Default,,0000,0000,0000,,Қатты! Барлығына!
Dialogue: 0,1:07:19.84,1:07:21.84,Default,,0000,0000,0000,,Маған қашып кетуге жол берме!
Dialogue: 0,1:07:19.84,1:07:21.84,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:07:21.84,1:07:23.84,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:07:21.84,1:07:23.84,Default,,0000,0000,0000,,Жоқ! Жіберу!
Dialogue: 0,1:07:23.84,1:07:26.84,Default,,0000,0000,0000,,Жібер!
Dialogue: 0,1:07:26.84,1:07:28.84,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,1:07:28.84,1:07:30.81,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,1:07:28.84,1:07:30.81,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:07:32.85,1:07:34.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:07:37.85,1:07:39.86,Default,,0000,0000,0000,,(Теңізге құлау дыбысы)
Dialogue: 0,1:07:37.85,1:07:39.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:07:39.86,1:07:41.86,Default,,0000,0000,0000,,Сара!
Dialogue: 0,1:07:41.86,1:07:44.86,Default,,0000,0000,0000,,Сара! Сара!
Dialogue: 0,1:07:44.86,1:07:46.83,Default,,0000,0000,0000,,Сара!
Dialogue: 0,1:07:48.86,1:07:53.84,Default,,0000,0000,0000,,Дора-чан Нобита-сан...
Dialogue: 0,1:07:48.86,1:07:53.84,Default,,0000,0000,0000,,Баршаңызға~!
Dialogue: 0,1:07:55.87,1:07:57.84,Default,,0000,0000,0000,,Ха! Қазіргі...
Dialogue: 0,1:07:59.88,1:08:02.85,Default,,0000,0000,0000,,Маған қызды әкеліңіз
Dialogue: 0,1:08:04.88,1:08:06.88,Default,,0000,0000,0000,,Иә? Хмм...
Dialogue: 0,1:08:06.88,1:08:09.89,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,1:08:09.89,1:08:11.82,Default,,0000,0000,0000,,⚟ (сықырлау)
Dialogue: 0,1:08:11.82,1:08:14.82,Default,,0000,0000,0000,,Сегізаяқ емес екенін айтып тұрған көлік
Dialogue: 0,1:08:11.82,1:08:14.82,Default,,0000,0000,0000,,Жұмбақ неде?
Dialogue: 0,1:08:14.82,1:08:18.83,Default,,0000,0000,0000,,Бұл сегізаяқ емес пе?
Dialogue: 0,1:08:18.83,1:08:20.80,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:08:23.83,1:08:26.84,Default,,0000,0000,0000,,Сал!
Dialogue: 0,1:08:26.84,1:08:30.84,Default,,0000,0000,0000,,Ха...кальмар емес.
Dialogue: 0,1:08:26.84,1:08:30.84,Default,,0000,0000,0000,,Бұл құтқару салы болды.
Dialogue: 0,1:08:30.84,1:08:32.84,Default,,0000,0000,0000,,(Норияки Какёин) Мистер Джоэстар? (Жан) Эй, не болды?
Dialogue: 0,1:08:30.84,1:08:32.84,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:08:32.84,1:08:34.84,Default,,0000,0000,0000,,Джан! Сунео!
Dialogue: 0,1:08:34.84,1:08:36.85,Default,,0000,0000,0000,,О, отар ше?
Dialogue: 0,1:08:36.85,1:08:38.81,Default,,0000,0000,0000,,⚟Сәлем!
Dialogue: 0,1:08:36.85,1:08:38.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:08:42.85,1:08:45.86,Default,,0000,0000,0000,,Сонымен Шизука-чан
Dialogue: 0,1:08:42.85,1:08:45.86,Default,,0000,0000,0000,,Сіз қауіпсізсіз бе?
Dialogue: 0,1:08:45.86,1:08:47.86,Default,,0000,0000,0000,,Иә, кешіріңіз.
Dialogue: 0,1:08:47.86,1:08:50.86,Default,,0000,0000,0000,,Бұл жай ғана Шизука болса да
Dialogue: 0,1:08:47.86,1:08:50.86,Default,,0000,0000,0000,,Мен үйге баруға тырыстым, бірақ...
Dialogue: 0,1:08:50.86,1:08:54.86,Default,,0000,0000,0000,,Жоқ, Шизука-чан.
Dialogue: 0,1:08:50.86,1:08:54.86,Default,,0000,0000,0000,,Меніңше, осы дүниеде соғыссыз өмір сүре алмайтын адамдар бар.
Dialogue: 0,1:08:54.86,1:08:58.87,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,1:08:54.86,1:08:58.87,Default,,0000,0000,0000,,Нұхтың кемесі жобасы
Dialogue: 0,1:08:58.87,1:09:02.87,Default,,0000,0000,0000,,Шив боксының жоспары?
Dialogue: 0,1:08:58.87,1:09:02.87,Default,,0000,0000,0000,,Бұл, әрине, әдейі, солай емес пе?
Dialogue: 0,1:09:02.87,1:09:04.87,Default,,0000,0000,0000,,Мен міндетті түрде пираттық кемемін➡
Dialogue: 0,1:09:04.87,1:09:08.88,Default,,0000,0000,0000,,Ол Кариб теңізіне бара жатқанын айтты.
Dialogue: 0,1:09:04.87,1:09:08.88,Default,,0000,0000,0000,,Мен солай ойладым, бірақ қателесіппін.
Dialogue: 0,1:09:08.88,1:09:12.82,Default,,0000,0000,0000,,Қайри
Dialogue: 0,1:09:08.88,1:09:12.82,Default,,0000,0000,0000,,Біз дәл орта Атлант жотасының үстінде тұрмыз.
Dialogue: 0,1:09:08.88,1:09:12.82,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:09:12.82,1:09:15.82,Default,,0000,0000,0000,,Бұл теңіздің түбінде үлкен жанартау бар➡
Dialogue: 0,1:09:15.82,1:09:18.82,Default,,0000,0000,0000,,солтүстіктен оңтүстікке қарай 16 000 км
Dialogue: 0,1:09:15.82,1:09:18.82,Default,,0000,0000,0000,,Мұнара
Dialogue: 0,1:09:18.82,1:09:22.83,Default,,0000,0000,0000,,Тереңнен көтерілген Жер
Dialogue: 0,1:09:18.82,1:09:22.83,Default,,0000,0000,0000,,Үлкен жылу энергиясы➡
Dialogue: 0,1:09:22.83,1:09:25.83,Default,,0000,0000,0000,,Магмаға айналады
Dialogue: 0,1:09:22.83,1:09:25.83,Default,,0000,0000,0000,,Ол атқылап жатқан жер.
Dialogue: 0,1:09:25.83,1:09:30.83,Default,,0000,0000,0000,,Осындай жерде біз жерден энергия аламыз.
Dialogue: 0,1:09:25.83,1:09:30.83,Default,,0000,0000,0000,,Егер сіз сорып қалсаңыз...
Dialogue: 0,1:09:30.83,1:09:32.84,Default,,0000,0000,0000,,Бұл үлкен мәміле болады
Dialogue: 0,1:09:32.84,1:09:35.84,Default,,0000,0000,0000,,Үлкен аға
Dialogue: 0,1:09:32.84,1:09:35.84,Default,,0000,0000,0000,,Біз әкені тоқтатуымыз керек!
Dialogue: 0,1:09:35.84,1:09:38.84,Default,,0000,0000,0000,,Сол жігіт
Dialogue: 0,1:09:35.84,1:09:38.84,Default,,0000,0000,0000,,Менің әкем емес!
Dialogue: 0,1:09:38.84,1:09:41.84,Default,,0000,0000,0000,,Мен өзімді құтқарғым келмейді...
Dialogue: 0,1:09:41.84,1:09:43.85,Default,,0000,0000,0000,,Мен сені кешіре алмаймын!
Dialogue: 0,1:09:43.85,1:09:45.85,Default,,0000,0000,0000,,Себебі бар.
Dialogue: 0,1:09:45.85,1:09:47.85,Default,,0000,0000,0000,,Сөйлессек, мен сенімдімін...
Dialogue: 0,1:09:47.85,1:09:51.85,Default,,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,1:09:47.85,1:09:51.85,Default,,0000,0000,0000,,Әкем мені жек көреді.
Dialogue: 0,1:09:51.85,1:09:53.86,Default,,0000,0000,0000,,Сондықтан мен оны артқа тастадым.
Dialogue: 0,1:09:53.86,1:09:57.86,Default,,0000,0000,0000,,Мен не айтамын?
Dialogue: 0,1:09:53.86,1:09:57.86,Default,,0000,0000,0000,,Сіз мені тыңдайсыз ба?
Dialogue: 0,1:09:57.86,1:09:59.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:09:59.86,1:10:03.87,Default,,0000,0000,0000,,Мен де
Dialogue: 0,1:09:59.86,1:10:03.87,Default,,0000,0000,0000,,Сен мені үнемі ашуландырасың...
Dialogue: 0,1:10:03.87,1:10:06.87,Default,,0000,0000,0000,,｟Әкемнің ақымақ! ｠
Dialogue: 0,1:10:03.87,1:10:06.87,Default,,0000,0000,0000,,｟Не деген ақымақтық! ｠
Dialogue: 0,1:10:06.87,1:10:08.84,Default,,0000,0000,0000,,｟Жетті! ｠
Dialogue: 0,1:10:14.88,1:10:18.88,Default,,0000,0000,0000,,Сонда да әкем мен туралы ойлайды
Dialogue: 0,1:10:14.88,1:10:18.88,Default,,0000,0000,0000,,Ол маған қамқорлық жасайды.
Dialogue: 0,1:10:18.88,1:10:21.88,Default,,0000,0000,0000,,Демек сенің әкең де солай болуы керек!
Dialogue: 0,1:10:21.88,1:10:23.89,Default,,0000,0000,0000,,Ха…
Dialogue: 0,1:10:21.88,1:10:23.89,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:10:23.89,1:10:26.89,Default,,0000,0000,0000,,Киімге қарамастан
Dialogue: 0,1:10:23.89,1:10:26.89,Default,,0000,0000,0000,,О
Dialogue: 0,1:10:26.89,1:10:30.89,Default,,0000,0000,0000,,Сен қалай ыңылдап жүрсің?
Dialogue: 0,1:10:26.89,1:10:30.89,Default,,0000,0000,0000,,Ой!
Dialogue: 0,1:10:26.89,1:10:30.89,Default,,0000,0000,0000,,100 жыл тез өтті.
Dialogue: 0,1:10:30.89,1:10:34.90,Default,,0000,0000,0000,,Үлкен аға
Dialogue: 0,1:10:30.89,1:10:34.90,Default,,0000,0000,0000,,Әкемді бірге сендірейік
Dialogue: 0,1:10:34.90,1:10:37.90,Default,,0000,0000,0000,,Сонымен, біз
Dialogue: 0,1:10:34.90,1:10:37.90,Default,,0000,0000,0000,,Шизука-чанды құтқарыңыз!
Dialogue: 0,1:10:37.90,1:10:39.90,Default,,0000,0000,0000,,…қашып кету…
Dialogue: 0,1:10:39.90,1:10:43.91,Default,,0000,0000,0000,,Жарайды, шешілді!
Dialogue: 0,1:10:39.90,1:10:43.91,Default,,0000,0000,0000,,Барлығымыз Такарадзимаға отырайық!
Dialogue: 0,1:10:43.91,1:10:47.88,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:10:43.91,1:10:47.88,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:10:56.92,1:11:00.92,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:10:56.92,1:11:00.92,Default,,0000,0000,0000,,Барлығың дайынсыңдар ма?
Dialogue: 0,1:11:00.92,1:11:02.93,Default,,0000,0000,0000,,Бұл еркектік.
Dialogue: 0,1:11:02.93,1:11:04.93,Default,,0000,0000,0000,,Сонымен еркектік деген не?
Dialogue: 0,1:11:04.93,1:11:06.93,Default,,0000,0000,0000,,
Dialogue: 0,1:11:04.93,1:11:06.93,Default,,0000,0000,0000,,Үйге барғың келмей ме?
Dialogue: 0,1:11:06.93,1:11:09.93,Default,,0000,0000,0000,,Let it go!
Dialogue: 0,1:11:09.93,1:11:11.87,Default,,0000,0000,0000,,Бұл жолы!
Dialogue: 0,1:11:11.87,1:11:31.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:31.89,1:11:34.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:34.89,1:11:38.89,Default,,0000,0000,0000,,Неге бұлай істеп жатырсың?
Dialogue: 0,1:11:38.89,1:11:42.87,Default,,0000,0000,0000,,Барлығы болашақта өмір сүреді
Dialogue: 0,1:11:38.89,1:11:42.87,Default,,0000,0000,0000,,Балаларға арналған.
Dialogue: 0,1:11:48.90,1:11:50.91,Default,,0000,0000,0000,,Мария
Dialogue: 0,1:11:50.91,1:11:52.88,Default,,0000,0000,0000,,Сара…
Dialogue: 0,1:11:59.92,1:12:01.92,Default,,0000,0000,0000,,Осылай жалғаса берсе, Жерге қауіп төнеді!
Dialogue: 0,1:12:01.92,1:12:03.89,Default,,0000,0000,0000,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,1:12:01.92,1:12:03.89,Default,,0000,0000,0000,,(Сирена қосылады)
Dialogue: 0,1:12:09.93,1:12:13.86,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,1:12:13.86,1:12:15.86,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:12:15.86,1:12:17.87,Default,,0000,0000,0000,,Көбінесе жаман болады➡
Dialogue: 0,1:12:17.87,1:12:19.87,Default,,0000,0000,0000,,Мен сені бұл жерден өткізбеймін.
Dialogue: 0,1:12:19.87,1:12:23.87,Default,,0000,0000,0000,,Балалар! Барлығын бірден жасамаңыз!
Dialogue: 0,1:12:19.87,1:12:23.87,Default,,0000,0000,0000,,(Қарақшылардың айқайы)
Dialogue: 0,1:12:23.87,1:12:26.84,Default,,0000,0000,0000,,Нобита бұрын!
Dialogue: 0,1:12:23.87,1:12:26.84,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:12:28.88,1:12:32.88,Default,,0000,0000,0000,,Уф! Уау... Уау!
Dialogue: 0,1:12:32.88,1:12:34.88,Default,,0000,0000,0000,,Маған қашып кетуіме жол берме!
Dialogue: 0,1:12:34.88,1:12:36.89,Default,,0000,0000,0000,,Бум бум бум
Dialogue: 0,1:12:34.88,1:12:36.89,Default,,0000,0000,0000,,Бум бум бум
Dialogue: 0,1:12:36.89,1:12:38.89,Default,,0000,0000,0000,,Тс!
Dialogue: 0,1:12:36.89,1:12:38.89,Default,,0000,0000,0000,,Бум бум бум
Dialogue: 0,1:12:38.89,1:12:40.89,Default,,0000,0000,0000,,Я... Джан!
Dialogue: 0,1:12:38.89,1:12:40.89,Default,,0000,0000,0000,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:12:40.89,1:12:42.89,Default,,0000,0000,0000,,Шизука-чан қайда?
Dialogue: 0,1:12:42.89,1:12:44.89,Default,,0000,0000,0000,,Қайда? Эх...
Dialogue: 0,1:12:44.89,1:12:47.90,Default,,0000,0000,0000,,Сондай төмен адам
Dialogue: 0,1:12:44.89,1:12:47.90,Default,,0000,0000,0000,,Менің түсінуім мүмкін емес.
Dialogue: 0,1:12:47.90,1:12:50.90,Default,,0000,0000,0000,,Мен мұны білемін, өйткені мен төмен адам емеспін!
Dialogue: 0,1:12:47.90,1:12:50.90,Default,,0000,0000,0000,,Мен капитанмен біргемін!
Dialogue: 0,1:12:50.90,1:12:52.90,Default,,0000,0000,0000,,Ик!
Dialogue: 0,1:12:50.90,1:12:52.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:12:52.90,1:12:55.90,Default,,0000,0000,0000,,Не, сен шын айтасың ба?
Dialogue: 0,1:12:52.90,1:12:55.90,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,1:12:55.90,1:12:57.91,Default,,0000,0000,0000,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:12:57.91,1:12:59.91,Default,,0000,0000,0000,,Сунео
Dialogue: 0,1:12:57.91,1:12:59.91,Default,,0000,0000,0000,,Енді сіздің ерлігіңізді көрсету мүмкіндігіңіз!
Dialogue: 0,1:12:59.91,1:13:02.91,Default,,0000,0000,0000,,Иә? Амал жоқ...
Dialogue: 0,1:13:02.91,1:13:06.88,Default,,0000,0000,0000,,Ah, already!
Dialogue: 0,1:13:02.91,1:13:06.88,Default,,0000,0000,0000,,Егер бұл орын алса, сіз ренжідіңіз!
Dialogue: 0,1:13:08.92,1:13:11.85,Default,,0000,0000,0000,,Дораемон, мұны маған қалдыр.
Dialogue: 0,1:13:08.92,1:13:11.85,Default,,0000,0000,0000,,Тезірек, Шизука-чан!
Dialogue: 0,1:13:11.85,1:13:13.86,Default,,0000,0000,0000,,Не!
Dialogue: 0,1:13:11.85,1:13:13.86,Default,,0000,0000,0000,,Джан Сунео!
Dialogue: 0,1:13:13.86,1:13:16.86,Default,,0000,0000,0000,,Ақымақ болма! Тым қауіпті!
Dialogue: 0,1:13:16.86,1:13:19.86,Default,,0000,0000,0000,,Әкеге айтар бірдеңе
Dialogue: 0,1:13:16.86,1:13:19.86,Default,,0000,0000,0000,,There is, right?
Dialogue: 0,1:13:19.86,1:13:21.86,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:13:21.86,1:13:23.83,Default,,0000,0000,0000,,Мен Шизука-чанды сұрадым!
Dialogue: 0,1:13:27.87,1:13:31.87,Default,,0000,0000,0000,,Жаса, Сунео!
Dialogue: 0,1:13:27.87,1:13:31.87,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:13:31.87,1:13:33.88,Default,,0000,0000,0000,,Хехе... Уау!
Dialogue: 0,1:13:33.88,1:13:36.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:13:36.88,1:13:39.88,Default,,0000,0000,0000,,Иә 1 жануар ~
Dialogue: 0,1:13:39.88,1:13:43.89,Default,,0000,0000,0000,,Оның квиркі өте күшті, бірақ—
Dialogue: 0,1:13:39.88,1:13:43.89,Default,,0000,0000,0000,,Тағы бір оғаш құрал!
Dialogue: 0,1:13:43.89,1:13:45.89,Default,,0000,0000,0000,,Джан! Сунео!
Dialogue: 0,1:13:45.89,1:13:47.89,Default,,0000,0000,0000,,Мұны екеумізге қалдырайық.
Dialogue: 0,1:13:47.89,1:13:49.86,Default,,0000,0000,0000,,Бізге асығу керек!
Dialogue: 0,1:13:51.89,1:13:54.86,Default,,0000,0000,0000,,Кеттік, Дораемон!
Dialogue: 0,1:13:51.89,1:13:54.86,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:14:01.90,1:14:04.87,Default,,0000,0000,0000,,Ал бірінші курс студенттері ше?
Dialogue: 0,1:14:10.85,1:14:12.82,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:14:14.85,1:14:17.85,Default,,0000,0000,0000,,(Барлығы айқайлайды)
Dialogue: 0,1:14:14.85,1:14:17.85,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:14:17.85,1:14:19.82,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:14:29.87,1:14:32.84,Default,,0000,0000,0000,,Уау... аа...
Dialogue: 0,1:14:37.87,1:14:40.88,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:14:37.87,1:14:40.88,Default,,0000,0000,0000,,Жердің энергиясын шығару➡
Dialogue: 0,1:14:40.88,1:14:42.88,Default,,0000,0000,0000,,Эрвин, бұның бәрі сенің операцияңның нәтижесі ме?
Dialogue: 0,1:14:40.88,1:14:42.88,Default,,0000,0000,0000,,Мен ғарышқа ұшамын!
Dialogue: 0,1:14:42.88,1:14:44.85,Default,,0000,0000,0000,,Doraemon That!
Dialogue: 0,1:14:53.89,1:14:55.89,Default,,0000,0000,0000,,Бұл кеме!
Dialogue: 0,1:14:55.89,1:14:57.89,Default,,0000,0000,0000,,Не істеуім керек... Дораемон!
Dialogue: 0,1:14:57.89,1:15:00.90,Default,,0000,0000,0000,,Мен осындай нәрсе болуы мүмкін деп ойладым.
Dialogue: 0,1:14:57.89,1:15:00.90,Default,,0000,0000,0000,,Мен оны өзгерттім!
Dialogue: 0,1:15:00.90,1:15:02.90,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:15:02.90,1:15:04.90,Default,,0000,0000,0000,,Теңіз де тамаша, аспан да тамаша.
Dialogue: 0,1:15:04.90,1:15:07.90,Default,,0000,0000,0000,,Бұл жұмбақ па?
Dialogue: 0,1:15:04.90,1:15:07.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:07.90,1:15:10.84,Default,,0000,0000,0000,,Ұшатын балық!
Dialogue: 0,1:15:07.90,1:15:10.84,Default,,0000,0000,0000,,Иә, ұшатын балықтар ұша алады!
Dialogue: 0,1:15:10.84,1:15:12.84,Default,,0000,0000,0000,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,1:15:10.84,1:15:12.84,Default,,0000,0000,0000,,Хехе
Dialogue: 0,1:15:12.84,1:15:15.84,Default,,0000,0000,0000,,(Батырма басылған дыбысы)
Dialogue: 0,1:15:12.84,1:15:15.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:15.84,1:15:17.81,Default,,0000,0000,0000,,(Батырма басылған дыбысы)
Dialogue: 0,1:15:25.85,1:15:28.86,Default,,0000,0000,0000,,Ой-ай, ау, ау... ау!
Dialogue: 0,1:15:28.86,1:15:31.86,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,1:15:28.86,1:15:31.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:31.86,1:15:35.83,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,1:15:38.87,1:15:41.87,Default,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,1:15:41.87,1:15:43.87,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:15:43.87,1:15:45.87,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:15:43.87,1:15:45.87,Default,,0000,0000,0000,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:15:45.87,1:15:48.84,Default,,0000,0000,0000,,О~. Құдай-ай!
Dialogue: 0,1:15:50.88,1:15:53.88,Default,,0000,0000,0000,,Бұлттағы Дораемон!
Dialogue: 0,1:15:53.88,1:15:55.88,Default,,0000,0000,0000,,I won’t let you go!
Dialogue: 0,1:15:55.88,1:15:57.89,Default,,0000,0000,0000,,Текио жарығы!
Dialogue: 0,1:15:57.89,1:16:00.89,Default,,0000,0000,0000,,Барлығы бірден көтеріледі!
Dialogue: 0,1:16:00.89,1:16:02.86,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:16:09.90,1:16:12.83,Default,,0000,0000,0000,,(Медуза дыбысы)
Dialogue: 0,1:16:09.90,1:16:12.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:16:12.83,1:16:15.84,Default,,0000,0000,0000,,Жарайды, жағаға шығайық!
Dialogue: 0,1:16:15.84,1:16:26.82,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:30.85,1:16:33.86,Default,,0000,0000,0000,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,1:16:30.85,1:16:33.86,Default,,0000,0000,0000,,Менің дәуірімде жоқ материал сияқты.
Dialogue: 0,1:16:33.86,1:16:36.83,Default,,0000,0000,0000,,Викторина
Dialogue: 0,1:16:33.86,1:16:36.83,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:16:40.86,1:16:44.87,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:16:40.86,1:16:44.87,Default,,0000,0000,0000,,Фрок сенімді.
Dialogue: 0,1:16:44.87,1:16:47.87,Default,,0000,0000,0000,,Муки!
Dialogue: 0,1:16:47.87,1:16:51.87,Default,,0000,0000,0000,,Капитан бөлмесі қай жерде?
Dialogue: 0,1:16:47.87,1:16:51.87,Default,,0000,0000,0000,,Біз тіпті білмейміз
Dialogue: 0,1:16:51.87,1:16:56.88,Default,,0000,0000,0000,,Капитан бөлмесіне баратын жолды кім біледі?
Dialogue: 0,1:16:51.87,1:16:56.88,Default,,0000,0000,0000,,Тек менің әкем
Dialogue: 0,1:16:56.88,1:16:59.88,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:16:56.88,1:16:59.88,Default,,0000,0000,0000,,Не істеуім керек...
Dialogue: 0,1:16:59.88,1:17:01.88,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:16:59.88,1:17:01.88,Default,,0000,0000,0000,,Мен оны шығарып аламын, бірақ мен оны сала алмаймын.
Dialogue: 0,1:17:01.88,1:17:03.89,Default,,0000,0000,0000,,Балқиды, бірақ қатпайды
Dialogue: 0,1:17:03.89,1:17:05.89,Default,,0000,0000,0000,,Бұл жұмбақ па?
Dialogue: 0,1:17:05.89,1:17:09.89,Default,,0000,0000,0000,,Оны шығаруға болады, бірақ салуға болмайды ма?
Dialogue: 0,1:17:05.89,1:17:09.89,Default,,0000,0000,0000,,Ол ериді, бірақ қатпайды...
Dialogue: 0,1:17:09.89,1:17:12.83,Default,,0000,0000,0000,,Түсіндім! Жауабы викторина!
Dialogue: 0,1:17:12.83,1:17:14.83,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,1:17:14.83,1:17:18.83,Default,,0000,0000,0000,,Аа, Викторина капитан бөлмесіне бара жатыр.
Dialogue: 0,1:17:14.83,1:17:18.83,Default,,0000,0000,0000,,Сонымен, сіз білесіз!
Dialogue: 0,1:17:18.83,1:17:20.84,Default,,0000,0000,0000,,Иә, викториналар әрқашан ➡ болады
Dialogue: 0,1:17:20.84,1:17:23.84,Default,,0000,0000,0000,,Әкеңмен арамыздағы көпір бол.
Dialogue: 0,1:17:20.84,1:17:23.84,Default,,0000,0000,0000,,Ол мұны мен үшін жасады.
Dialogue: 0,1:17:23.84,1:17:25.84,Default,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,1:17:25.84,1:17:27.84,Default,,0000,0000,0000,,Муки!
Dialogue: 0,1:17:25.84,1:17:27.84,Default,,0000,0000,0000,,Муки!
Dialogue: 0,1:17:27.84,1:17:29.85,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,1:17:27.84,1:17:29.85,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,1:17:29.85,1:17:31.85,Default,,0000,0000,0000,,Мұнда екеніңе сенбеймін
Dialogue: 0,1:17:29.85,1:17:31.85,Default,,0000,0000,0000,,Викторинаға сеніп, жалғастырыңыз!
Dialogue: 0,1:17:31.85,1:17:35.82,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:17:31.85,1:17:35.82,Default,,0000,0000,0000,,төмен және байқалмай ұшыңыз
Dialogue: 0,1:17:37.85,1:17:39.86,Default,,0000,0000,0000,,Викторина Қайсысы?
Dialogue: 0,1:17:37.85,1:17:39.86,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:17:39.86,1:17:41.86,Default,,0000,0000,0000,,Жоғарыдан оқылса да
Dialogue: 0,1:17:39.86,1:17:41.86,Default,,0000,0000,0000,,Төменнен оқысаңыз да➡
Dialogue: 0,1:17:41.86,1:17:43.86,Default,,0000,0000,0000,,Қай бағыт бірдей? Қайсысы жұмбақ?
Dialogue: 0,1:17:41.86,1:17:43.86,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,1:17:43.86,1:17:45.86,Default,,0000,0000,0000,,Оңтүстік... Оңтүстік!
Dialogue: 0,1:17:45.86,1:17:47.83,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,1:17:49.87,1:17:52.87,Default,,0000,0000,0000,,Бұл қайсысы, жоғарғы немесе төменгі? викторина
Dialogue: 0,1:17:49.87,1:17:52.87,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:17:52.87,1:17:54.87,Default,,0000,0000,0000,,Дәм сезу бағыты
Dialogue: 0,1:17:52.87,1:17:54.87,Default,,0000,0000,0000,,Қайсысы жұмбақ?
Dialogue: 0,1:17:54.87,1:17:58.87,Default,,0000,0000,0000,,Дәмді сезіну – бұл...
Dialogue: 0,1:17:54.87,1:17:58.87,Default,,0000,0000,0000,,Мен мүлде түсінбеймін
Dialogue: 0,1:17:58.87,1:18:00.88,Default,,0000,0000,0000,,Тіл! Төмен!
Dialogue: 0,1:17:58.87,1:18:00.88,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,1:18:00.88,1:18:02.84,Default,,0000,0000,0000,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:18:05.88,1:18:08.85,Default,,0000,0000,0000,,《Жоқ, әке! 》
Dialogue: 0,1:18:14.82,1:18:16.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:18:16.83,1:18:18.83,Default,,0000,0000,0000,,Бұл... бұл төртінші!
Dialogue: 0,1:18:18.83,1:18:20.83,Default,,0000,0000,0000,,(Джан Сунеоның айқайы)
Dialogue: 0,1:18:20.83,1:18:22.80,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:18:24.83,1:18:26.80,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,1:18:28.84,1:18:31.84,Default,,0000,0000,0000,,Ах... Уау!
Dialogue: 0,1:18:31.84,1:18:33.84,Default,,0000,0000,0000,,Босап шыққан адам –…
Dialogue: 0,1:18:33.84,1:18:36.85,Default,,0000,0000,0000,,Мен бала болсам да
Dialogue: 0,1:18:33.84,1:18:36.85,Default,,0000,0000,0000,,Сен жақсы жұмыс жасадың.
Dialogue: 0,1:18:36.85,1:18:39.85,Default,,0000,0000,0000,,Жүр, жігеріңді көрсет, балам!
Dialogue: 0,1:18:39.85,1:18:43.85,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,1:18:39.85,1:18:43.85,Default,,0000,0000,0000,,Әпке~!
Dialogue: 0,1:18:43.85,1:18:46.86,Default,,0000,0000,0000,,Иә? Джан
Dialogue: 0,1:18:43.85,1:18:46.86,Default,,0000,0000,0000,,Сенің аяғыңда не бар?
Dialogue: 0,1:18:46.86,1:18:48.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:18:48.86,1:18:51.86,Default,,0000,0000,0000,,Иә? Фуфуфу…
Dialogue: 0,1:18:51.86,1:18:54.86,Default,,0000,0000,0000,,Ол азайып барады.
Dialogue: 0,1:18:51.86,1:18:54.86,Default,,0000,0000,0000,,Сәлем викторинасы
Dialogue: 0,1:18:54.86,1:18:57.87,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:18:54.86,1:18:57.87,Default,,0000,0000,0000,,Капитанның бөлмесі осы жерде, солай ма?
Dialogue: 0,1:18:57.87,1:19:00.87,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:18:57.87,1:19:00.87,Default,,0000,0000,0000,,Бамбук қылышын ұстау - Кендо
Dialogue: 0,1:19:00.87,1:19:02.87,Default,,0000,0000,0000,,Садақ ұстау - Кюдо
Dialogue: 0,1:19:02.87,1:19:04.87,Default,,0000,0000,0000,,Пышақ немесе шанышқыны ұстау
Dialogue: 0,1:19:02.87,1:19:04.87,Default,,0000,0000,0000,,Жұмбақ неде?
Dialogue: 0,1:19:04.87,1:19:06.88,Default,,0000,0000,0000,,Пышақ пен шанышқы?
Dialogue: 0,1:19:06.88,1:19:08.88,Default,,0000,0000,0000,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:19:08.88,1:19:11.81,Default,,0000,0000,0000,,Жауап – буфет!
Dialogue: 0,1:19:08.88,1:19:11.81,Default,,0000,0000,0000,,Мария-тей
Dialogue: 0,1:19:11.81,1:19:13.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:19:13.82,1:19:17.82,Default,,0000,0000,0000,,Аспаз?
Dialogue: 0,1:19:13.82,1:19:17.82,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,1:19:17.82,1:19:20.82,Default,,0000,0000,0000,,Жаман!
Dialogue: 0,1:19:17.82,1:19:20.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:19:20.82,1:19:22.82,Default,,0000,0000,0000,,Хирари плащы!
Dialogue: 0,1:19:22.82,1:19:28.83,Default,,0000,0000,0000,,Пневматикалық зеңбіректің максималды шығуы!
Dialogue: 0,1:19:22.82,1:19:28.83,Default,,0000,0000,0000,,<Алғашқы қадамды жасау>
Dialogue: 0,1:19:28.83,1:19:31.80,Default,,0000,0000,0000,,Жүгіру!
Dialogue: 0,1:19:33.84,1:19:35.84,Default,,0000,0000,0000,,Бум бум!
Dialogue: 0,1:19:35.84,1:19:39.84,Default,,0000,0000,0000,,Ауа жоқ! ? Нобита-кун!
Dialogue: 0,1:19:39.84,1:19:41.81,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:19:43.85,1:19:47.85,Default,,0000,0000,0000,,О, жоқ... жоқ!
Dialogue: 0,1:19:47.85,1:19:49.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:19:49.85,1:19:51.85,Default,,0000,0000,0000,,Сара!
Dialogue: 0,1:19:51.85,1:19:53.86,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:19:53.86,1:19:55.86,Default,,0000,0000,0000,,Мария!
Dialogue: 0,1:19:53.86,1:19:55.86,Default,,0000,0000,0000,,Тезірек дүкенге кіріңіз!
Dialogue: 0,1:19:55.86,1:19:58.86,Default,,0000,0000,0000,,Сара!
Dialogue: 0,1:19:55.86,1:19:58.86,Default,,0000,0000,0000,,Менің дүкенімді бұзатындар➡
Dialogue: 0,1:19:58.86,1:20:01.86,Default,,0000,0000,0000,,Мен аямаймын!
Dialogue: 0,1:20:01.86,1:20:04.87,Default,,0000,0000,0000,,Қылыш қолданамыз ба?
Dialogue: 0,1:20:01.86,1:20:04.87,Default,,0000,0000,0000,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,1:20:04.87,1:20:06.84,Default,,0000,0000,0000,,Тез, мұнда кел!
Dialogue: 0,1:20:04.87,1:20:06.84,Default,,0000,0000,0000,,Бұл!бұл!
Dialogue: 0,1:20:08.87,1:20:11.87,Default,,0000,0000,0000,,Викторина
Dialogue: 0,1:20:08.87,1:20:11.87,Default,,0000,0000,0000,,Бұл жерде шынымен дұрыс па?
Dialogue: 0,1:20:11.87,1:20:13.88,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:20:11.87,1:20:13.88,Default,,0000,0000,0000,,Терезе - бұл терезе➡
Dialogue: 0,1:20:13.88,1:20:15.88,Default,,0000,0000,0000,,Ыстық терезенің артында қандай жұмбақ бар?
Dialogue: 0,1:20:15.88,1:20:17.88,Default,,0000,0000,0000,,Осындай кездерде
Dialogue: 0,1:20:15.88,1:20:17.88,Default,,0000,0000,0000,,Викториналарды қабылдауды тоқтатыңыз...
Dialogue: 0,1:20:17.88,1:20:20.88,Default,,0000,0000,0000,,Бұл жаман.
Dialogue: 0,1:20:17.88,1:20:20.88,Default,,0000,0000,0000,,Ыстық терезе...
Dialogue: 0,1:20:20.88,1:20:22.88,Default,,0000,0000,0000,,Түсіндім! Бұл пеш!
Dialogue: 0,1:20:20.88,1:20:22.88,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,1:20:22.88,1:20:24.85,Default,,0000,0000,0000,,Мұнда!
Dialogue: 0,1:20:28.89,1:20:30.89,Default,,0000,0000,0000,,Мен бір жерде сенімдімін ...
Dialogue: 0,1:20:28.89,1:20:30.89,Default,,0000,0000,0000,,Асығыңыз, асығыңыз!
Dialogue: 0,1:20:30.89,1:20:33.90,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:20:33.90,1:20:35.86,Default,,0000,0000,0000,,Үлкен аға!
Dialogue: 0,1:20:38.90,1:20:40.90,Default,,0000,0000,0000,,Бұл жасырын үзінді.
Dialogue: 0,1:20:40.90,1:20:43.91,Default,,0000,0000,0000,,Біз мұны шештік!
Dialogue: 0,1:20:40.90,1:20:43.91,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:20:43.91,1:20:45.91,Default,,0000,0000,0000,,Мария!
Dialogue: 0,1:20:45.91,1:20:48.91,Default,,0000,0000,0000,,Роботтарға және т.б.
Dialogue: 0,1:20:45.91,1:20:48.91,Default,,0000,0000,0000,,Нағыз қарақшыларды жеңу мүмкін емес.
Dialogue: 0,1:20:48.91,1:20:51.91,Default,,0000,0000,0000,,Шизукаға көмектес!
Dialogue: 0,1:20:51.91,1:20:54.92,Default,,0000,0000,0000,,Рахмет Мария!
Dialogue: 0,1:20:51.91,1:20:54.92,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,1:20:54.92,1:20:57.92,Default,,0000,0000,0000,,Асығыңыз! Ха!
Dialogue: 0,1:20:57.92,1:20:59.92,Default,,0000,0000,0000,,Сунео, мен мұны саған қалдырамын!
Dialogue: 0,1:20:59.92,1:21:03.93,Default,,0000,0000,0000,,Кичи
Dialogue: 0,1:20:59.92,1:21:03.93,Default,,0000,0000,0000,,Бір рет, немере ағам Сунекичимен
Dialogue: 0,1:20:59.92,1:21:03.93,Default,,0000,0000,0000,,Өйткені мен мұны бұрын жасағанмын!
Dialogue: 0,1:21:03.93,1:21:05.89,Default,,0000,0000,0000,,Маған не көрсетпексің?
Dialogue: 0,1:21:08.93,1:21:11.90,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:21:08.93,1:21:11.90,Default,,0000,0000,0000,,Саңырауқұлақтар~!
Dialogue: 0,1:21:13.87,1:21:15.84,Default,,0000,0000,0000,,Сүңгуір қайық! ?
Dialogue: 0,1:21:19.88,1:21:21.84,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,1:21:23.88,1:21:25.85,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:21:27.88,1:21:29.89,Default,,0000,0000,0000,,Мен жеңілдім!
Dialogue: 0,1:21:27.88,1:21:29.89,Default,,0000,0000,0000,,Ал екіншісі ше?
Dialogue: 0,1:21:29.89,1:21:32.89,Default,,0000,0000,0000,,⚟Осылай!
Dialogue: 0,1:21:29.89,1:21:32.89,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,1:21:32.89,1:21:34.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:21:34.89,1:21:38.89,Default,,0000,0000,0000,,Капитанның бұйрықтары абсолютті!
Dialogue: 0,1:21:38.89,1:21:43.90,Default,,0000,0000,0000,,Иә! А… а… а…
Dialogue: 0,1:21:43.90,1:21:47.90,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:21:47.90,1:21:50.91,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:21:47.90,1:21:50.91,Default,,0000,0000,0000,,Анаңа қандай гүл ұнады?
Dialogue: 0,1:21:50.91,1:21:52.91,Default,,0000,0000,0000,,Ақ ғарыш!
Dialogue: 0,1:21:50.91,1:21:52.91,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:21:52.91,1:21:55.88,Default,,0000,0000,0000,,Сенің әкеңнің сүйікті жануары қандай?
Dialogue: 0,1:21:52.91,1:21:55.88,Default,,0000,0000,0000,,«Ақымақ» картасының белгісін арқалаған Рух толқыны қолданушысы.
Dialogue: 0,1:21:57.91,1:21:59.91,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:21:59.91,1:22:03.92,Default,,0000,0000,0000,,Ана мен әке
Dialogue: 0,1:21:59.91,1:22:03.92,Default,,0000,0000,0000,,Сізге қай жер ұнады?
Dialogue: 0,1:22:03.92,1:22:06.92,Default,,0000,0000,0000,,｟Әке! ｠
Dialogue: 0,1:22:03.92,1:22:06.92,Default,,0000,0000,0000,,｟Анашым! ｠
Dialogue: 0,1:22:06.92,1:22:08.92,Default,,0000,0000,0000,,｟Хахахаха｠
Dialogue: 0,1:22:08.92,1:22:10.86,Default,,0000,0000,0000,,｟Ой хехехе
Dialogue: 0,1:22:10.86,1:22:13.86,Default,,0000,0000,0000,,｟Білесің бе, мен...｠
Dialogue: 0,1:22:10.86,1:22:13.86,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,1:22:13.86,1:22:15.86,Default,,0000,0000,0000,,｟Тағамды жақсылап шайнаңыз｠
Dialogue: 0,1:22:15.86,1:22:18.87,Default,,0000,0000,0000,,
Dialogue: 0,1:22:15.86,1:22:18.87,Default,,0000,0000,0000,,｟Өйткені бұл дәмді｠
Dialogue: 0,1:22:18.87,1:22:20.87,Default,,0000,0000,0000,,｟Ааа, төгіліп жатыр｠
Dialogue: 0,1:22:18.87,1:22:20.87,Default,,0000,0000,0000,,｟Hehehe｠
Dialogue: 0,1:22:20.87,1:22:23.84,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,1:22:26.88,1:22:28.88,Default,,0000,0000,0000,,｟Кешіріңіз…｠
Dialogue: 0,1:22:26.88,1:22:28.88,Default,,0000,0000,0000,,｟Осылай➡
Dialogue: 0,1:22:28.88,1:22:31.88,Default,,0000,0000,0000,,Анамдікі
Dialogue: 0,1:22:28.88,1:22:31.88,Default,,0000,0000,0000,,Бұл француз тосты емес! ｠
Dialogue: 0,1:22:31.88,1:22:33.85,Default,,0000,0000,0000,,｟А...｠
Dialogue: 0,1:22:36.89,1:22:38.89,Default,,0000,0000,0000,,Біраз ашық емес пе?
Dialogue: 0,1:22:36.89,1:22:38.89,Default,,0000,0000,0000,,｟Ах! ｠
Dialogue: 0,1:22:38.89,1:22:40.89,Default,,0000,0000,0000,,｟Ах...｠
Dialogue: 0,1:22:40.89,1:22:42.89,Default,,0000,0000,0000,,｟ Отар Сара｠
Dialogue: 0,1:22:42.89,1:22:44.89,Default,,0000,0000,0000,,｟Менің әкем
Dialogue: 0,1:22:42.89,1:22:44.89,Default,,0000,0000,0000,,Ананың зерттеуі➡
Dialogue: 0,1:22:44.89,1:22:47.90,Default,,0000,0000,0000,,Толтырылуы керек｠
Dialogue: 0,1:22:47.90,1:22:50.90,Default,,0000,0000,0000,,｟Бүгіннен бастап бұл жігіт
Dialogue: 0,1:22:47.90,1:22:50.90,Default,,0000,0000,0000,,Дос болу｠
Dialogue: 0,1:22:50.90,1:22:54.90,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:22:54.90,1:22:56.91,Default,,0000,0000,0000,,｟Ах｠
Dialogue: 0,1:22:54.90,1:22:56.91,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:22:56.91,1:22:59.91,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,1:22:59.91,1:23:02.91,Default,,0000,0000,0000,,｟Мен оны шығара аламын, бірақ қоя алмаймын.
Dialogue: 0,1:22:59.91,1:23:02.91,Default,,0000,0000,0000,,Балқиды, бірақ қатпайды｠
Dialogue: 0,1:23:02.91,1:23:04.91,Default,,0000,0000,0000,,｟Бұл не жұмбақ? ｠
Dialogue: 0,1:23:02.91,1:23:04.91,Default,,0000,0000,0000,,｟Эх｠
Dialogue: 0,1:23:04.91,1:23:08.92,Default,,0000,0000,0000,,｟Бұл викторина｠
Dialogue: 0,1:23:04.91,1:23:08.92,Default,,0000,0000,0000,,｟Пинг-понг Пинг-понг｠
Dialogue: 0,1:23:08.92,1:23:10.85,Default,,0000,0000,0000,,｟Уау~｠
Dialogue: 0,1:23:10.85,1:23:13.86,Default,,0000,0000,0000,,｟Мына жігіттің аты кім? Викторина｠
Dialogue: 0,1:23:13.86,1:23:17.83,Default,,0000,0000,0000,,｟Анам ойлап тапқан викторина
Dialogue: 0,1:23:13.86,1:23:17.83,Default,,0000,0000,0000,,Онда көп нәрсе бар｠
Dialogue: 0,1:23:20.86,1:23:24.83,Default,,0000,0000,0000,,Әкем мен шешем сүйген жер
Dialogue: 0,1:23:28.87,1:23:31.87,Default,,0000,0000,0000,,｟ Күте тұрыңыз, әке.
Dialogue: 0,1:23:28.87,1:23:31.87,Default,,0000,0000,0000,,Мына жаққа қара! ｠
Dialogue: 0,1:23:31.87,1:23:34.88,Default,,0000,0000,0000,,｟Папа! ｠
Dialogue: 0,1:23:34.88,1:23:36.85,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:23:40.88,1:23:42.85,Default,,0000,0000,0000,,Міне, осы жерде.
Dialogue: 0,1:23:47.89,1:23:49.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:23:59.90,1:24:02.87,Default,,0000,0000,0000,,А... ә!
Dialogue: 0,1:24:04.91,1:24:07.88,Default,,0000,0000,0000,,Ғажайып алтын және күміс қазына!
Dialogue: 0,1:24:10.85,1:24:14.85,Default,,0000,0000,0000,,Әй...
Dialogue: 0,1:24:14.85,1:24:17.82,Default,,0000,0000,0000,,Бұл нағыз қазына аралы.
Dialogue: 0,1:24:19.85,1:24:22.86,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:24:19.85,1:24:22.86,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:24:22.86,1:24:27.86,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:24:22.86,1:24:27.86,Default,,0000,0000,0000,,Мұнда нағыз қазына жоқ.
Dialogue: 0,1:24:27.86,1:24:29.86,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:24:29.86,1:24:42.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:24:42.88,1:24:44.88,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:24:42.88,1:24:44.88,Default,,0000,0000,0000,,Ана мен әке➡
Dialogue: 0,1:24:44.88,1:24:47.85,Default,,0000,0000,0000,,Сіздің сүйікті жұлдызыңыздың жұмбақтары қандай?
Dialogue: 0,1:24:50.89,1:24:52.85,Default,,0000,0000,0000,,Жер
Dialogue: 0,1:24:54.89,1:24:58.89,Default,,0000,0000,0000,,Сара отары
Dialogue: 0,1:24:54.89,1:24:58.89,Default,,0000,0000,0000,,Нағыз қазынаны тауып алайық!
Dialogue: 0,1:24:58.89,1:25:01.90,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:25:01.90,1:25:03.87,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:25:06.90,1:25:09.87,Default,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,1:25:18.85,1:25:20.85,Default,,0000,0000,0000,,《Мен не істеуім керек?
Dialogue: 0,1:25:18.85,1:25:20.85,Default,,0000,0000,0000,,Мен не істеуім керек? 》
Dialogue: 0,1:25:20.85,1:25:22.85,Default,,0000,0000,0000,,《Не! 》
Dialogue: 0,1:25:20.85,1:25:22.85,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,1:25:22.85,1:25:24.85,Default,,0000,0000,0000,,｟Иә? ｠
Dialogue: 0,1:25:22.85,1:25:24.85,Default,,0000,0000,0000,,(Сараның жылағаны)
Dialogue: 0,1:25:24.85,1:25:36.87,Default,,0000,0000,0000,,(Сараның жылағаны)
Dialogue: 0,1:25:36.87,1:25:38.87,Default,,0000,0000,0000,,｟Джон өтінемін｠
Dialogue: 0,1:25:38.87,1:25:43.84,Default,,0000,0000,0000,,｜Мен балаларымның болашағын сұраймын｠
Dialogue: 0,1:25:46.88,1:25:49.88,Default,,0000,0000,0000,,《Фиона… Фиона…》
Dialogue: 0,1:25:49.88,1:25:52.88,Default,,0000,0000,0000,,《Бұл жалғыз жол...》
Dialogue: 0,1:25:52.88,1:25:56.89,Default,,0000,0000,0000,,《Балалардың болашағы және
Dialogue: 0,1:25:52.88,1:25:56.89,Default,,0000,0000,0000,,Адамзатты құтқарудың жолы жоқ》
Dialogue: 0,1:25:56.89,1:25:59.89,Default,,0000,0000,0000,,《Мұхит түбінен
Dialogue: 0,1:25:56.89,1:25:59.89,Default,,0000,0000,0000,,Жердің энергиясын ұрлау➡
Dialogue: 0,1:25:59.89,1:26:02.86,Default,,0000,0000,0000,,Бұл ғарышқа қашудың жалғыз жолы! 》
Dialogue: 0,1:26:06.90,1:26:08.90,Default,,0000,0000,0000,,⚟ (есіктің ашылған дыбысы)
Dialogue: 0,1:26:06.90,1:26:08.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:26:08.90,1:26:10.83,Default,,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,1:26:10.83,1:26:12.83,Default,,0000,0000,0000,,Сара отары
Dialogue: 0,1:26:12.83,1:26:14.84,Default,,0000,0000,0000,,Әкем
Dialogue: 0,1:26:14.84,1:26:17.84,Default,,0000,0000,0000,,Нобита-сан Дора-чан!
Dialogue: 0,1:26:14.84,1:26:17.84,Default,,0000,0000,0000,,Әй, Шизука-чан!
Dialogue: 0,1:26:17.84,1:26:20.84,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,1:26:17.84,1:26:20.84,Default,,0000,0000,0000,,Шизука-чан!
Dialogue: 0,1:26:20.84,1:26:24.85,Default,,0000,0000,0000,,(Медузаның дыбысы)
Dialogue: 0,1:26:20.84,1:26:24.85,Default,,0000,0000,0000,,Медуза-чан
Dialogue: 0,1:26:24.85,1:26:26.85,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:26:26.85,1:26:30.85,Default,,0000,0000,0000,,Нобита-сан
Dialogue: 0,1:26:26.85,1:26:30.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:26:30.85,1:26:32.82,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,1:26:30.85,1:26:32.82,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,1:26:34.86,1:26:36.86,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,1:26:34.86,1:26:36.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:26:36.86,1:26:38.86,Default,,0000,0000,0000,,Сенде ондай мақсат болса да…
Dialogue: 0,1:26:36.86,1:26:38.86,Default,,0000,0000,0000,,Тоқтатайық!
Dialogue: 0,1:26:38.86,1:26:40.86,Default,,0000,0000,0000,,Әке!
Dialogue: 0,1:26:40.86,1:26:43.87,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:26:40.86,1:26:43.87,Default,,0000,0000,0000,,Неге сонша...
Dialogue: 0,1:26:43.87,1:26:46.87,Default,,0000,0000,0000,,Бұл жер бітті.
Dialogue: 0,1:26:46.87,1:26:49.87,Default,,0000,0000,0000,,Балалардың болашағы
Dialogue: 0,1:26:46.87,1:26:49.87,Default,,0000,0000,0000,,Сақтау керек
Dialogue: 0,1:26:49.87,1:26:52.87,Default,,0000,0000,0000,,Сонымен жер
Dialogue: 0,1:26:49.87,1:26:52.87,Default,,0000,0000,0000,,Сынса жарай ма?
Dialogue: 0,1:26:52.87,1:26:55.88,Default,,0000,0000,0000,,Біз ғана құтқарылуымыз керек пе?
Dialogue: 0,1:26:55.88,1:26:58.88,Default,,0000,0000,0000,,Ах, қандай қиындық.
Dialogue: 0,1:26:55.88,1:26:58.88,Default,,0000,0000,0000,,Сіз бәрін сақтай алмайсыз
Dialogue: 0,1:26:58.88,1:27:02.88,Default,,0000,0000,0000,,Бұл Флок пен Сара
Dialogue: 0,1:26:58.88,1:27:02.88,Default,,0000,0000,0000,,Осыны қалайсыз ба?
Dialogue: 0,1:27:02.88,1:27:05.89,Default,,0000,0000,0000,,Екі адамның сезімі
Dialogue: 0,1:27:02.88,1:27:05.89,Default,,0000,0000,0000,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,1:27:05.89,1:27:07.89,Default,,0000,0000,0000,,Нобита...
Dialogue: 0,1:27:07.89,1:27:10.83,Default,,0000,0000,0000,,Сара әділ
Dialogue: 0,1:27:07.89,1:27:10.83,Default,,0000,0000,0000,,Біз тек отбасы ретінде бірге болғымыз келеді!
Dialogue: 0,1:27:10.83,1:27:13.83,Default,,0000,0000,0000,,Шизука…
Dialogue: 0,1:27:13.83,1:27:16.83,Default,,0000,0000,0000,,Балалар
Dialogue: 0,1:27:13.83,1:27:16.83,Default,,0000,0000,0000,,Мен әлі ештеңе түсінбейтін баламын.
Dialogue: 0,1:27:16.83,1:27:21.84,Default,,0000,0000,0000,,Құрбандықсыз
Dialogue: 0,1:27:16.83,1:27:21.84,Default,,0000,0000,0000,,Қорғайтын ештеңе жоқ!
Dialogue: 0,1:27:21.84,1:27:24.84,Default,,0000,0000,0000,,Біз әлі баламыз
Dialogue: 0,1:27:24.84,1:27:27.84,Default,,0000,0000,0000,,Біз білмейтін нәрселер өте көп.
Dialogue: 0,1:27:27.84,1:27:29.84,Default,,0000,0000,0000,,Бірақ!
Dialogue: 0,1:27:29.84,1:27:31.85,Default,,0000,0000,0000,,Үлкендер ешқашан қателеспей ме?
Dialogue: 0,1:27:31.85,1:27:34.85,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:27:31.85,1:27:34.85,Default,,0000,0000,0000,,Сіз үшін не маңызды➡
Dialogue: 0,1:27:34.85,1:27:38.85,Default,,0000,0000,0000,,Сіз қатты қателесесіз! ?
Dialogue: 0,1:27:38.85,1:27:40.86,Default,,0000,0000,0000,,Уақыт келді
Dialogue: 0,1:27:40.86,1:27:43.86,Default,,0000,0000,0000,,Тоқта, әке!
Dialogue: 0,1:27:40.86,1:27:43.86,Default,,0000,0000,0000,,Бұл көп уақытты алады
Dialogue: 0,1:27:43.86,1:27:45.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:27:43.86,1:27:45.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:27:53.87,1:27:55.87,Default,,0000,0000,0000,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:27:53.87,1:27:55.87,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:27:55.87,1:27:58.84,Default,,0000,0000,0000,,Не болады?
Dialogue: 0,1:27:55.87,1:27:58.84,Default,,0000,0000,0000,,О...
Dialogue: 0,1:28:02.88,1:28:06.88,Default,,0000,0000,0000,,(Барлығы айқайлайды)
Dialogue: 0,1:28:06.88,1:28:18.83,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:18.83,1:28:21.83,Default,,0000,0000,0000,,Нашар! Жер энергиясы
Dialogue: 0,1:28:18.83,1:28:21.83,Default,,0000,0000,0000,,Оны қозғалтқышқа алыңыз➡
Dialogue: 0,1:28:21.83,1:28:25.83,Default,,0000,0000,0000,,Мен ғарышқа ұшамын!
Dialogue: 0,1:28:21.83,1:28:25.83,Default,,0000,0000,0000,,У... Уа, түсінемін...
Dialogue: 0,1:28:25.83,1:28:28.80,Default,,0000,0000,0000,,Егер сіз мұны істесеңіз
Dialogue: 0,1:28:25.83,1:28:28.80,Default,,0000,0000,0000,,Бұл қайтымсыз болады!
Dialogue: 0,1:28:31.84,1:28:33.84,Default,,0000,0000,0000,,Не... не істеуім керек!
Dialogue: 0,1:28:33.84,1:28:36.84,Default,,0000,0000,0000,,Бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,1:28:33.84,1:28:36.84,Default,,0000,0000,0000,,Бірдеңе жетіспейді ме? Бірдеңе жетіспейді ме...
Dialogue: 0,1:28:36.84,1:28:38.85,Default,,0000,0000,0000,,Супер қолғаптар!
Dialogue: 0,1:28:38.85,1:28:40.85,Default,,0000,0000,0000,,(Зұлым) Сен! Маған жақындама! (Минета) Хе-хе. ➡
Dialogue: 0,1:28:40.85,1:28:42.85,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:28:42.85,1:28:44.85,Default,,0000,0000,0000,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,1:28:44.85,1:28:49.86,Default,,0000,0000,0000,,Бұл жерге тиесілі!
Dialogue: 0,1:28:49.86,1:28:52.86,Default,,0000,0000,0000,,Нунунуну...
Dialogue: 0,1:28:52.86,1:28:54.86,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:28:52.86,1:28:54.86,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,1:28:54.86,1:28:57.87,Default,,0000,0000,0000,,Соққыдан кейін не келеді?
Dialogue: 0,1:28:54.86,1:28:57.87,Default,,0000,0000,0000,,Жұмбақ неде?
Dialogue: 0,1:28:57.87,1:28:59.87,Default,,0000,0000,0000,,Осындай уақытта не істеп жатырсың?
Dialogue: 0,1:28:59.87,1:29:04.87,Default,,0000,0000,0000,,Шымшу... Шымшу!
Dialogue: 0,1:29:04.87,1:29:06.87,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:29:06.87,1:29:09.88,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,1:29:06.87,1:29:09.88,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:29:09.88,1:29:14.82,Default,,0000,0000,0000,,Әке.
Dialogue: 0,1:29:09.88,1:29:14.82,Default,,0000,0000,0000,,Тоқтаңыз!
Dialogue: 0,1:29:14.82,1:29:16.82,Default,,0000,0000,0000,,Бұл мүмкін емес
Dialogue: 0,1:29:16.82,1:29:19.82,Default,,0000,0000,0000,,Мен не істеуім керек...
Dialogue: 0,1:29:16.82,1:29:19.82,Default,,0000,0000,0000,,Мен не істеуім керек!
Dialogue: 0,1:29:19.82,1:29:21.82,Default,,0000,0000,0000,,Ах! Үлкен аға➡
Dialogue: 0,1:29:21.82,1:29:23.83,Default,,0000,0000,0000,,Менің анам
Dialogue: 0,1:29:21.82,1:29:23.83,Default,,0000,0000,0000,,Бұл кеме қашан жасалған➡
Dialogue: 0,1:29:23.83,1:29:25.83,Default,,0000,0000,0000,,Мұндай құрылғы болған жоқ.
Dialogue: 0,1:29:25.83,1:29:28.83,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:29:25.83,1:29:28.83,Default,,0000,0000,0000,,Егер ол кейінірек қосылған болса➡
Dialogue: 0,1:29:28.83,1:29:30.83,Default,,0000,0000,0000,,Сіз оны міндетті түрде ажырата білуіңіз керек!
Dialogue: 0,1:29:30.83,1:29:32.83,Default,,0000,0000,0000,,Викторина
Dialogue: 0,1:29:30.83,1:29:32.83,Default,,0000,0000,0000,,Осы бөлмедегі компьютерде➡
Dialogue: 0,1:29:32.83,1:29:34.84,Default,,0000,0000,0000,,Мен оған қол жеткізе аламын ба?
Dialogue: 0,1:29:34.84,1:29:38.84,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:29:38.84,1:29:40.81,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:29:42.84,1:29:46.85,Default,,0000,0000,0000,,Оқиғаны тоқтатыңыз.
Dialogue: 0,1:29:42.84,1:29:46.85,Default,,0000,0000,0000,,Сіз менің бағдарламамды жеңе алмайсыз
Dialogue: 0,1:29:46.85,1:29:48.85,Default,,0000,0000,0000,,Тесік болуы керек.
Dialogue: 0,1:29:48.85,1:29:50.82,Default,,0000,0000,0000,,Үлкен аға!
Dialogue: 0,1:29:48.85,1:29:50.82,Default,,0000,0000,0000,,Отар!
Dialogue: 0,1:29:55.86,1:29:59.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:29:55.86,1:29:59.86,Default,,0000,0000,0000,,Қарғыс атсын... әлі жоқ!
Dialogue: 0,1:29:59.86,1:30:03.87,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,1:30:03.87,1:30:06.87,Default,,0000,0000,0000,,Нашар! Фунунуну...
Dialogue: 0,1:30:06.87,1:30:10.87,Default,,0000,0000,0000,,(күрескен дауыс)
Dialogue: 0,1:30:10.87,1:30:14.88,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:30:14.88,1:30:16.88,Default,,0000,0000,0000,,Бұл көп уақытты алады
Dialogue: 0,1:30:14.88,1:30:16.88,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:30:16.88,1:30:20.88,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:30:20.88,1:30:26.89,Default,,0000,0000,0000,,(күрескен дауыс)
Dialogue: 0,1:30:26.89,1:30:29.89,Default,,0000,0000,0000,,Кешіріңіз... Кешіріңіз Нобита-кун...
Dialogue: 0,1:30:29.89,1:30:31.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:30:41.90,1:30:45.91,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,1:30:45.91,1:30:47.91,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:30:47.91,1:30:50.91,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,1:30:47.91,1:30:50.91,Default,,0000,0000,0000,,Мен не істеуім керек? Мен не істеуім керек...
Dialogue: 0,1:30:50.91,1:30:53.92,Default,,0000,0000,0000,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:30:50.91,1:30:53.92,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:30:53.92,1:30:55.88,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:30:58.92,1:31:00.89,Default,,0000,0000,0000,,Нобита-сан?
Dialogue: 0,1:31:02.92,1:31:06.93,Default,,0000,0000,0000,,Сіз не істемексіз? Нобита!
Dialogue: 0,1:31:02.92,1:31:06.93,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:31:06.93,1:31:08.93,Default,,0000,0000,0000,,Мен көмектесуім керек
Dialogue: 0,1:31:08.93,1:31:10.90,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,1:31:17.87,1:31:20.88,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:31:20.88,1:31:23.88,Default,,0000,0000,0000,,Хмф! Ах!
Dialogue: 0,1:31:23.88,1:31:28.88,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:31:28.88,1:31:30.89,Default,,0000,0000,0000,,Ууууууууууу!
Dialogue: 0,1:31:30.89,1:31:40.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:40.90,1:31:44.90,Default,,0000,0000,0000,,Дораемон...
Dialogue: 0,1:31:44.90,1:31:50.91,Default,,0000,0000,0000,,Дораемон!
Dialogue: 0,1:31:50.91,1:31:53.88,Default,,0000,0000,0000,,Ақымақ... өлесің!
Dialogue: 0,1:31:55.91,1:31:58.91,Default,,0000,0000,0000,,Дораемон Дораемон!
Dialogue: 0,1:31:58.91,1:32:01.92,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:32:01.92,1:32:05.92,Default,,0000,0000,0000,,Ах! Уау!
Dialogue: 0,1:32:05.92,1:32:16.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:32:16.86,1:32:19.87,Default,,0000,0000,0000,,Нобита-сан!
Dialogue: 0,1:32:19.87,1:32:27.88,Default,,0000,0000,0000,,Уф! Уау!
Dialogue: 0,1:32:27.88,1:32:29.88,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:32:29.88,1:32:31.88,Default,,0000,0000,0000,,(Нобита мен Шизуканың айқайы)
Dialogue: 0,1:32:31.88,1:32:33.88,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:32:31.88,1:32:33.88,Default,,0000,0000,0000,,Шизука!
Dialogue: 0,1:32:33.88,1:32:38.89,Default,,0000,0000,0000,,(Нобита мен Шизуканың айқайы)
Dialogue: 0,1:32:38.89,1:32:41.89,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:32:41.89,1:32:43.89,Default,,0000,0000,0000,,Уф...
Dialogue: 0,1:32:43.89,1:32:45.86,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,1:32:47.90,1:32:50.90,Default,,0000,0000,0000,,《Бұл енді жақсы емес...》
Dialogue: 0,1:32:50.90,1:32:53.90,Default,,0000,0000,0000,,Додрала дора!
Dialogue: 0,1:32:53.90,1:32:55.90,Default,,0000,0000,0000,,Долла!
Dialogue: 0,1:32:55.90,1:33:07.92,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:33:07.92,1:33:09.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:33:09.92,1:33:14.86,Default,,0000,0000,0000,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,1:33:14.86,1:33:17.86,Default,,0000,0000,0000,,Нобита Аура!
Dialogue: 0,1:33:17.86,1:33:20.86,Default,,0000,0000,0000,,Дорала!
Dialogue: 0,1:33:17.86,1:33:20.86,Default,,0000,0000,0000,,Джан Сунео!
Dialogue: 0,1:33:20.86,1:33:22.86,Default,,0000,0000,0000,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:33:20.86,1:33:22.86,Default,,0000,0000,0000,,Дора!
Dialogue: 0,1:33:22.86,1:33:24.87,Default,,0000,0000,0000,,Дораемон Дораемон!
Dialogue: 0,1:33:24.87,1:33:27.87,Default,,0000,0000,0000,,Оян, Доремон!
Dialogue: 0,1:33:24.87,1:33:27.87,Default,,0000,0000,0000,,Дора-чан өтінемін!
Dialogue: 0,1:33:27.87,1:33:29.87,Default,,0000,0000,0000,,Ол өлді ме?
Dialogue: 0,1:33:29.87,1:33:31.87,Default,,0000,0000,0000,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,1:33:29.87,1:33:31.87,Default,,0000,0000,0000,,Такеши-сан!
Dialogue: 0,1:33:31.87,1:33:33.87,Default,,0000,0000,0000,,Абебебе…
Dialogue: 0,1:33:31.87,1:33:33.87,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:33:33.87,1:33:35.88,Default,,0000,0000,0000,,Хик! Ықылық!
Dialogue: 0,1:33:35.88,1:33:37.85,Default,,0000,0000,0000,,Не? Бұл қайда?
Dialogue: 0,1:33:41.88,1:33:43.88,Default,,0000,0000,0000,,Дораемон...
Dialogue: 0,1:33:41.88,1:33:43.88,Default,,0000,0000,0000,,Дора-чан!
Dialogue: 0,1:33:43.88,1:33:45.89,Default,,0000,0000,0000,,Ах, Нобита-кун
Dialogue: 0,1:33:45.89,1:33:48.89,Default,,0000,0000,0000,,Күміс ше?
Dialogue: 0,1:33:45.89,1:33:48.89,Default,,0000,0000,0000,,Отар және... Ек!
Dialogue: 0,1:33:48.89,1:33:50.89,Default,,0000,0000,0000,,Сара...Хек! тістері?
Dialogue: 0,1:33:50.89,1:33:53.89,Default,,0000,0000,0000,,Дора-чан
Dialogue: 0,1:33:50.89,1:33:53.89,Default,,0000,0000,0000,,Әлі толық түзетілмеген сияқты.
Dialogue: 0,1:33:53.89,1:33:56.90,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,1:33:56.90,1:33:58.90,Default,,0000,0000,0000,,Хехе
Dialogue: 0,1:33:58.90,1:34:02.90,Default,,0000,0000,0000,,
Dialogue: 0,1:33:58.90,1:34:02.90,Default,,0000,0000,0000,,Дора! Дора! Дора!
Dialogue: 0,1:34:02.90,1:34:06.91,Default,,0000,0000,0000,,Бұл соңы!
Dialogue: 0,1:34:02.90,1:34:06.91,Default,,0000,0000,0000,,Барлығың, алға!
Dialogue: 0,1:34:06.91,1:34:10.85,Default,,0000,0000,0000,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:34:10.85,1:34:12.85,Default,,0000,0000,0000,,Әй!
Dialogue: 0,1:34:12.85,1:34:15.85,Default,,0000,0000,0000,,Нобита! Дораемон!
Dialogue: 0,1:34:12.85,1:34:15.85,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:34:15.85,1:34:19.85,Default,,0000,0000,0000,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,1:34:15.85,1:34:19.85,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:34:19.85,1:34:21.86,Default,,0000,0000,0000,,Ия, мен рұқсат алдым!
Dialogue: 0,1:34:21.86,1:34:23.86,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:34:23.86,1:34:25.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:34:25.86,1:34:35.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:35.87,1:34:37.87,Default,,0000,0000,0000,,Бар!
Dialogue: 0,1:34:37.87,1:34:40.84,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,1:34:37.87,1:34:40.84,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,1:34:42.88,1:34:44.88,Default,,0000,0000,0000,,Жаман!
Dialogue: 0,1:34:44.88,1:34:47.88,Default,,0000,0000,0000,,Бұл жәндік емес.
Dialogue: 0,1:34:44.88,1:34:47.88,Default,,0000,0000,0000,,Өйткені Нобита-кун оны нашар жасайды!
Dialogue: 0,1:34:47.88,1:34:49.85,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,1:34:51.89,1:34:55.89,Default,,0000,0000,0000,,Ум, желім, желім...
Dialogue: 0,1:34:55.89,1:34:57.89,Default,,0000,0000,0000,,Ах! О ла ла ла...
Dialogue: 0,1:34:57.89,1:35:00.90,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,1:35:00.90,1:35:04.87,Default,,0000,0000,0000,,Дорэмон, бірдеңе істе!
Dialogue: 0,1:35:06.90,1:35:09.90,Default,,0000,0000,0000,,Мені итеріп жатыр... Неге! ?
Dialogue: 0,1:35:09.90,1:35:19.85,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:19.85,1:35:22.82,Default,,0000,0000,0000,,Уф... аа!
Dialogue: 0,1:35:26.85,1:35:28.86,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:35:28.86,1:35:30.83,Default,,0000,0000,0000,,Фиона…
Dialogue: 0,1:35:36.86,1:35:39.87,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:35:36.86,1:35:39.87,Default,,0000,0000,0000,,Керемет аға!
Dialogue: 0,1:35:39.87,1:35:41.87,Default,,0000,0000,0000,,Қозғалтқышты таңдаңыз!
Dialogue: 0,1:35:41.87,1:35:44.87,Default,,0000,0000,0000,,Ха! Жақсы емес
Dialogue: 0,1:35:41.87,1:35:44.87,Default,,0000,0000,0000,,Күмбездің түбі кедергі жасайды➡
Dialogue: 0,1:35:44.87,1:35:46.87,Default,,0000,0000,0000,,Қозғалтқышты бөлуге болмайды!
Dialogue: 0,1:35:46.87,1:35:48.88,Default,,0000,0000,0000,,Бас тарт, Отар!
Dialogue: 0,1:35:48.88,1:35:50.88,Default,,0000,0000,0000,,А...эй!
Dialogue: 0,1:35:50.88,1:35:52.88,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:35:52.88,1:35:55.88,Default,,0000,0000,0000,,Аз, аз, аз...
Dialogue: 0,1:35:52.88,1:35:55.88,Default,,0000,0000,0000,,Чочочочо~!
Dialogue: 0,1:35:55.88,1:35:57.89,Default,,0000,0000,0000,,(Барлығы айғайлайды)
Dialogue: 0,1:35:57.89,1:36:02.86,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,1:36:08.90,1:36:10.83,Default,,0000,0000,0000,,Күмбезде жарық бар!
Dialogue: 0,1:36:10.83,1:36:15.80,Default,,0000,0000,0000,,Дораемонның тас басынан күткендей!
Dialogue: 0,1:36:10.83,1:36:15.80,Default,,0000,0000,0000,,Ең күшті құпия құрал!
Dialogue: 0,1:36:19.84,1:36:21.84,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:36:21.84,1:36:24.81,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:37:00.88,1:37:02.88,Default,,0000,0000,0000,,Ақымақ...
Dialogue: 0,1:37:02.88,1:37:04.89,Default,,0000,0000,0000,,Әкем
Dialogue: 0,1:37:04.89,1:37:08.89,Default,,0000,0000,0000,,Неліктен...
Dialogue: 0,1:37:04.89,1:37:08.89,Default,,0000,0000,0000,,Неліктен мұндай ұзаққа бару керек?
Dialogue: 0,1:37:08.89,1:37:12.83,Default,,0000,0000,0000,,Мұны қалай жасауға болады?
Dialogue: 0,1:37:12.83,1:37:16.83,Default,,0000,0000,0000,,Жер энергиясы
Dialogue: 0,1:37:12.83,1:37:16.83,Default,,0000,0000,0000,,Егер олар алып кетсе, мен қиналамын.
Dialogue: 0,1:37:16.83,1:37:20.84,Default,,0000,0000,0000,,Және бұл қайғылы болғандықтан
Dialogue: 0,1:37:20.84,1:37:22.80,Default,,0000,0000,0000,,Олар ата-ана мен бала болса да...
Dialogue: 0,1:37:24.84,1:37:29.84,Default,,0000,0000,0000,,Әкеңмен ұрысуға қалай дәтің бар?
Dialogue: 0,1:37:24.84,1:37:29.84,Default,,0000,0000,0000,,Мен болсам, қайғыр едім!
Dialogue: 0,1:37:29.84,1:37:32.85,Default,,0000,0000,0000,,Ха! Мен болсам...
Dialogue: 0,1:37:32.85,1:37:34.85,Default,,0000,0000,0000,,Әке, тоқтайық!
Dialogue: 0,1:37:34.85,1:37:37.82,Default,,0000,0000,0000,,Сол үйге бірге қайтайық!
Dialogue: 0,1:37:41.86,1:37:44.86,Default,,0000,0000,0000,,｟Сәлем Джон
Dialogue: 0,1:37:41.86,1:37:44.86,Default,,0000,0000,0000,,Осы балаларға➡
Dialogue: 0,1:37:44.86,1:37:49.86,Default,,0000,0000,0000,,Басқаларға бақыт тілеу
Dialogue: 0,1:37:44.86,1:37:49.86,Default,,0000,0000,0000,,Өзгелердің қайғы-қасіретіне қайғыру➡
Dialogue: 0,1:37:49.86,1:37:51.87,Default,,0000,0000,0000,,Мен сенің осындай адам болғаныңды қалаймын｠
Dialogue: 0,1:37:51.87,1:37:54.87,Default,,0000,0000,0000,,｟Солай
Dialogue: 0,1:37:51.87,1:37:54.87,Default,,0000,0000,0000,,Бұл сіздің соңғы сәтіңіз сияқты сөздерді айтпаңыз.
Dialogue: 0,1:37:54.87,1:37:58.87,Default,,0000,0000,0000,,｟Иә, сіз сияқты адамдарға.
Dialogue: 0,1:37:54.87,1:37:58.87,Default,,0000,0000,0000,,Оның қандай болғанын қалайсыз?
Dialogue: 0,1:37:58.87,1:38:02.88,Default,,0000,0000,0000,,｟Мен...
Dialogue: 0,1:37:58.87,1:38:02.88,Default,,0000,0000,0000,,Ол онша жақсы адам емес｠
Dialogue: 0,1:38:02.88,1:38:04.88,Default,,0000,0000,0000,,｜Сенімділікпен｠
Dialogue: 0,1:38:04.88,1:38:08.88,Default,,0000,0000,0000,,｟Себебі
Dialogue: 0,1:38:04.88,1:38:08.88,Default,,0000,0000,0000,,Бұл мен ғашық болған адам｠
Dialogue: 0,1:38:08.88,1:38:11.82,Default,,0000,0000,0000,,｟ Күтіңіз Фиона
Dialogue: 0,1:38:08.88,1:38:11.82,Default,,0000,0000,0000,,Әлі өлме｠
Dialogue: 0,1:38:11.82,1:38:13.82,Default,,0000,0000,0000,,｟Мен жалғызбын
Dialogue: 0,1:38:11.82,1:38:13.82,Default,,0000,0000,0000,,Мен не істеуім керек...｠
Dialogue: 0,1:38:13.82,1:38:16.82,Default,,0000,0000,0000,,｟Жақсы Джон｠
Dialogue: 0,1:38:16.82,1:38:21.83,Default,,0000,0000,0000,,｟Сенің бәрі жақсы болатынына сенімдімін｠
Dialogue: 0,1:38:21.83,1:38:25.83,Default,,0000,0000,0000,,｟Бұл балалар – біздің қазынамыз｠
Dialogue: 0,1:38:25.83,1:38:30.80,Default,,0000,0000,0000,,｟Мен балаларымның болашағын сұраймын｠
Dialogue: 0,1:38:34.84,1:38:37.85,Default,,0000,0000,0000,,Қазына…
Dialogue: 0,1:38:37.85,1:38:39.85,Default,,0000,0000,0000,,Адамдарға бақыт тілеу➡
Dialogue: 0,1:38:39.85,1:38:44.85,Default,,0000,0000,0000,,Адамның азап шегуі
Dialogue: 0,1:38:39.85,1:38:44.85,Default,,0000,0000,0000,,Сіз қайғыра алатын адамсыз ба?
Dialogue: 0,1:38:44.85,1:38:47.86,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,1:38:44.85,1:38:47.86,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:38:47.86,1:38:49.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:38:49.86,1:39:06.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:39:06.87,1:39:09.88,Default,,0000,0000,0000,,Әкем…
Dialogue: 0,1:39:09.88,1:39:13.81,Default,,0000,0000,0000,,Отар
Dialogue: 0,1:39:09.88,1:39:13.81,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:39:13.81,1:39:16.78,Default,,0000,0000,0000,,Сіз қолдарыңызды көтердіңіз.
Dialogue: 0,1:39:18.82,1:39:21.82,Default,,0000,0000,0000,,Дұрыс... бұрын солай емес пе?
Dialogue: 0,1:39:21.82,1:39:25.79,Default,,0000,0000,0000,,Мен... мен...
Dialogue: 0,1:39:28.83,1:39:32.83,Default,,0000,0000,0000,,Өйткені мен әкемнің баласымын!
Dialogue: 0,1:39:32.83,1:39:34.84,Default,,0000,0000,0000,,(Сара Флоктың айқайы)
Dialogue: 0,1:39:34.84,1:39:36.84,Default,,0000,0000,0000,,Мен Иносукэні құтқарамын
Dialogue: 0,1:39:36.84,1:39:39.84,Default,,0000,0000,0000,,Әкем қиналып жатыр.
Dialogue: 0,1:39:36.84,1:39:39.84,Default,,0000,0000,0000,,Мен оны білдім
Dialogue: 0,1:39:39.84,1:39:42.84,Default,,0000,0000,0000,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,1:39:42.84,1:39:47.85,Default,,0000,0000,0000,,Сара отары
Dialogue: 0,1:39:42.84,1:39:47.85,Default,,0000,0000,0000,,(Сара Флоктың айқайы)
Dialogue: 0,1:39:47.85,1:39:49.85,Default,,0000,0000,0000,,Үйге қайтайық
Dialogue: 0,1:39:49.85,1:39:56.86,Default,,0000,0000,0000,,(Сара Флоктың айқайы)
Dialogue: 0,1:39:56.86,1:39:59.86,Default,,0000,0000,0000,,(Екі адам күледі)
Dialogue: 0,1:39:59.86,1:40:19.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:40:19.88,1:40:26.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:40:26.89,1:40:29.89,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:40:26.89,1:40:29.89,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:40:29.89,1:40:33.89,Default,,0000,0000,0000,,Отар Аман болыңыз!
Dialogue: 0,1:40:29.89,1:40:33.89,Default,,0000,0000,0000,,Сара да!
Dialogue: 0,1:40:33.89,1:40:38.90,Default,,0000,0000,0000,,Барлығына да!
Dialogue: 0,1:40:33.89,1:40:38.90,Default,,0000,0000,0000,,Шынымен... Шынымен...
Dialogue: 0,1:40:38.90,1:40:40.90,Default,,0000,0000,0000,,Викторинаны көңілді өткізіңіз!
Dialogue: 0,1:40:40.90,1:40:42.90,Default,,0000,0000,0000,,(викториналық дыбыс)
Dialogue: 0,1:40:42.90,1:40:46.91,Default,,0000,0000,0000,,Қазір өзіңізді қалай сезінесіз?
Dialogue: 0,1:40:42.90,1:40:46.91,Default,,0000,0000,0000,,Сүңгуір қайыққа бірінші мінген адамдар саны
Dialogue: 0,1:40:46.91,1:40:48.91,Default,,0000,0000,0000,,Не? Эх...
Dialogue: 0,1:40:48.91,1:40:51.91,Default,,0000,0000,0000,,Соңында, не?
Dialogue: 0,1:40:48.91,1:40:51.91,Default,,0000,0000,0000,,Мен мүлде түсінбеймін!
Dialogue: 0,1:40:51.91,1:40:54.92,Default,,0000,0000,0000,,Жер
Dialogue: 0,1:40:51.91,1:40:54.92,Default,,0000,0000,0000,,Бұл бірінші викторина емес пе?
Dialogue: 0,1:40:54.92,1:40:59.92,Default,,0000,0000,0000,,Мен 999 адам екеніне сенімдімін
Dialogue: 0,1:40:54.92,1:40:59.92,Default,,0000,0000,0000,,Ол сүңгуір қайықта екенін айтты.
Dialogue: 0,1:40:59.92,1:41:01.92,Default,,0000,0000,0000,,Кезек кезегі…
Dialogue: 0,1:41:01.92,1:41:03.92,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,1:41:03.92,1:41:06.93,Default,,0000,0000,0000,,Жарайды, рахмет!
Dialogue: 0,1:41:03.92,1:41:06.93,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,1:41:06.93,1:41:08.90,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:41:15.87,1:41:19.87,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,1:41:15.87,1:41:19.87,Default,,0000,0000,0000,,Бір күні кездескенше!
Dialogue: 0,1:41:19.87,1:41:22.84,Default,,0000,0000,0000,,Нобита!
Dialogue: 0,1:41:19.87,1:41:22.84,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,1:41:24.88,1:41:26.88,Default,,0000,0000,0000,,Бір күні міндетті түрде кездескенше!
Dialogue: 0,1:41:26.88,1:41:28.88,Default,,0000,0000,0000,,Викторина Рахмет!
Dialogue: 0,1:41:28.88,1:41:30.88,Default,,0000,0000,0000,,Сара, сау бол!
Dialogue: 0,1:41:30.88,1:41:34.89,Default,,0000,0000,0000,,Аман болыңыз!
Dialogue: 0,1:41:30.88,1:41:34.89,Default,,0000,0000,0000,,Барлығын ұмытпа!
Dialogue: 0,1:41:34.89,1:41:37.89,Default,,0000,0000,0000,,Чип! Чип, чип, чип, чип!
Dialogue: 0,1:41:34.89,1:41:37.89,Default,,0000,0000,0000,,Мен болашақты сұрадым!
Dialogue: 0,1:41:37.89,1:41:40.86,Default,,0000,0000,0000,,Сіз мұны отармен жасай аласыз!
Dialogue: 0,1:41:46.90,1:41:48.87,Default,,0000,0000,0000,,Сонда кездескенше!
Dialogue: 0,1:41:51.91,1:41:54.91,Default,,0000,0000,0000,,《Рахмет Нобита》
Dialogue: 0,1:41:54.91,1:41:57.91,Default,,0000,0000,0000,,《Шынымен...》
Dialogue: 0,1:41:57.91,1:41:59.91,Default,,0000,0000,0000,,《Рахмет! 》
Dialogue: 0,1:41:59.91,1:42:19.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:42:19.87,1:42:33.88,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:42:33.88,1:42:37.89,Default,,0000,0000,0000,,⚟Нобита
Dialogue: 0,1:42:33.88,1:42:37.89,Default,,0000,0000,0000,,Жазғы демалыстағы үй тапсырмасын орындадың ба?
Dialogue: 0,1:42:37.89,1:42:39.89,Default,,0000,0000,0000,,Мен қазір істеп жатырмын
Dialogue: 0,1:42:39.89,1:42:41.86,Default,,0000,0000,0000,,⚟
Dialogue: 0,1:42:43.89,1:42:45.89,Default,,0000,0000,0000,,Нобита
Dialogue: 0,1:42:43.89,1:42:45.89,Default,,0000,0000,0000,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:42:45.89,1:42:48.90,Default,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,1:42:45.89,1:42:48.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:42:48.90,1:42:53.90,Default,,0000,0000,0000,,Мен бұл туралы ұзақ уақыт ұмыттым
Dialogue: 0,1:42:48.90,1:42:53.90,Default,,0000,0000,0000,,Әкем де бұл кітапқа баяғыда әуес болған➡
Dialogue: 0,1:42:53.90,1:42:57.91,Default,,0000,0000,0000,,Қазына аралын іздеуге бару
Dialogue: 0,1:42:53.90,1:42:57.91,Default,,0000,0000,0000,,Мен бірде шу шығардым.
Dialogue: 0,1:42:57.91,1:43:01.91,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:43:01.91,1:43:05.91,Default,,0000,0000,0000,,Жоқ, рахмет, әке.
Dialogue: 0,1:43:05.91,1:43:08.88,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,1:43:11.85,1:43:14.86,Default,,0000,0000,0000,,А... иә?
Dialogue: 0,1:43:14.86,1:43:17.86,Default,,0000,0000,0000,,⚟ (Джан Сунео) Нобита~!
Dialogue: 0,1:43:14.86,1:43:17.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:43:17.86,1:43:20.86,Default,,0000,0000,0000,,Бейсбол ойнайық
Dialogue: 0,1:43:17.86,1:43:20.86,Default,,0000,0000,0000,,Иә! Мен бірден барамын...
Dialogue: 0,1:43:20.86,1:43:22.86,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:43:20.86,1:43:22.86,Default,,0000,0000,0000,,Әй, қойшы енді.
Dialogue: 0,1:43:22.86,1:43:26.87,Default,,0000,0000,0000,,Ух... Сәлем~
Dialogue: 0,1:43:22.86,1:43:26.87,Default,,0000,0000,0000,,Міне.
Dialogue: 0,1:43:26.87,1:43:28.87,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:43:26.87,1:43:28.87,Default,,0000,0000,0000,,Күткеніңізге рахмет! Ой кешір
Dialogue: 0,1:43:28.87,1:43:30.87,Default,,0000,0000,0000,,Қате орын алса
Dialogue: 0,1:43:28.87,1:43:30.87,Default,,0000,0000,0000,,Өйткені бұл мұрындағы карбонара!
Dialogue: 0,1:43:30.87,1:43:33.87,Default,,0000,0000,0000,,Эх! ?
Dialogue: 0,1:43:30.87,1:43:33.87,Default,,0000,0000,0000,,Жарайды!
