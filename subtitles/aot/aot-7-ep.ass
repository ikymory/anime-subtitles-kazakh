Dialogue: 0,0:02:55.86,0:02:58.35,OP-JP,,0,0,0,,Ымыртта отты тесіп өт
Dialogue: 0,0:02:59.87,0:03:02.54,OP-Other,,0,0,0,,m 0 0 l 0 0 l 24 -1 b 34 -2 44 -2 54 -1 l 79 0 l 54 1 b 44 2 34 2 24 1 l 0 0 м 34 0 м 0 0
Dialogue: 0,0:02:59.87,0:03:02.54,OP-Other,,0,0,0,,m 0 0 l 0 0 l 24 -1 b 34 -2 44 -2 54 -1 l 79 0 l 54 1 b 44 2 34 2 24 1 l 0 0 м 34 0 м 0 0
Dialogue: 0,0:02:58.35,0:03:02.55,OP-JP,,0,0,0,,Қызыл садақ пен жебе
Dialogue: 0,0:22:36.51,0:22:41.23,ED-JP,,0,0,0,,Ол арман жүректің бар жері
Dialogue: 0,0:22:41.48,0:22:46.69,ED-JP,,0,0,0,,Өмірден де нәзік нәрсе
Dialogue: 0,0:22:47.78,0:22:52.26,ED-JP,,0,0,0,,Оны тастап, қайта-қайта табыңыз
Dialogue: 0,0:22:52.46,0:22:58.45,ED-JP,,0,0,0,,Енді тыныш жат.
Dialogue: 0,0:22:59.09,0:23:04.38,ED-JP,,0,0,0,,Импульстік импульске
Dialogue: 0,0:23:04.76,0:23:09.67,ED-JP,,0,0,0,,Тілек бұзылды
Dialogue: 0,0:23:10.44,0:23:14.87,ED-JP,,0,0,0,,Ұмытқан сайын
Dialogue: 0,0:23:15.02,0:23:20.34,ED-JP,,0,0,0,,Тағы да есімде
Dialogue: 0,0:23:20.58,0:23:26.29,ED-JP-2,,0,0,0,,Бұл әдемі және қатыгез әлемде
Dialogue: 0,0:23:26.60,0:23:29.11,ED-JP-2,,0,0,0,,Әлі тірі
Dialogue: 0,0:23:29.11,0:23:31.96,ED-JP-2,,0,0,0,,Неге екенін сұрап жатырмын
Dialogue: 0,0:23:31.96,0:23:37.49,ED-JP-2,,0,0,0,,А, бізде бұл күшті және әлсіз.
Dialogue: 0,0:23:37.52,0:23:40.64,ED-JP-2,,0,0,0,,Біз нені қорғаймыз?
Dialogue: 0,0:23:41.09,0:23:46.86,ED-JP-2,,0,0,0,,Енді ешқандай себеп болмаса
Dialogue: 0,0:03:24.79,0:03:29.67,Staff,,0,0,0,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:03:24.79,0:03:29.67,Staff,,0,0,0,,Жапон аудиосы: zwx & Tsurou; Аударма: Pulsar & Basugi; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгілерін қою: Feng She; Дәстүрлі қытайша бейімдеу: incot; Кодтау: Ginsou
Dialogue: 0,0:00:03.04,0:00:05.21,JP,,0,0,0,,100 жылдан астам уақыт бұрын
Dialogue: 0,0:00:05.89,0:00:08.49,JP,,0,0,0,,Адамзаттың табиғи жауы пайда болды
Dialogue: 0,0:00:14.07,0:00:15.97,JP,,0,0,0,,Олардың және адамзаттың арасында
Dialogue: 0,0:00:16.32,0:00:18.79,JP,,0,0,0,,Күште үлкен айырмашылық бар.
Dialogue: 0,0:00:19.56,0:00:23.17,JP,,0,0,0,,Бірден адамзат жойылу шегінде болды.
Dialogue: 0,0:00:27.91,0:00:29.52,JP,,0,0,0,,Тірі қалған адамдар
Dialogue: 0,0:00:29.92,0:00:34.11,JP,,0,0,0,,Мария Роуз Синаның үш қабырғасын тұрғызады
Dialogue: 0,0:00:34.41,0:00:37.12,JP,,0,0,0,,Онда жүз жылдық бейбітшілік орнады.
Dialogue: 0,0:00:37.94,0:00:38.98,JP,,0,0,0,,Дегенмен
Dialogue: 0,0:00:40.07,0:00:48.00,JP,,0,0,0,,●
Dialogue: 0,0:00:48.57,0:00:52.14,JP,,0,0,0,,●
Dialogue: 0,0:00:55.10,0:00:57.51,JP,,0,0,0,,●
Dialogue: 0,0:00:58.24,0:01:01.37,JP,,0,0,0,,●
Dialogue: 0,0:01:02.13,0:01:05.91,JP,,0,0,0,,●
Dialogue: 0,0:01:09.67,0:01:16.68,JP,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:01:17.51,0:01:19.78,JP,,0,0,0,,және тағы да Титан шапқыншылығына жол берілді.
Dialogue: 0,0:01:21.96,0:01:24.25,JP,,0,0,0,,Эрен, асық!
Dialogue: 0,0:01:31.55,0:01:35.66,JP,,0,0,0,,Екі сағаттан кейін барлық тұрғындар эвакуацияланды.
Dialogue: 0,0:01:36.98,0:01:39.53,JP,,0,0,0,,Титандар бірде-бір адамды жеп қоймады.
Dialogue: 0,0:01:41.01,0:01:46.00,JP,,0,0,0,,Шабуылға тойтар кезінде міндеттерін орындау барысында қаза тапқан сарбаздарды есептемегенде
Dialogue: 0,0:01:47.07,0:01:51.76,JP,,0,0,0,,Эрен, сен осы жерде болсаң, мен бәрін жасай аламын
Dialogue: 0,0:03:34.90,0:03:36.16,JP,,0,0,0,,Күте тұрыңыз, капитан
Dialogue: 0,0:03:37.00,0:03:38.77,JP,,0,0,0,,Егер Титан шабуыл жасаса
Dialogue: 0,0:03:38.99,0:03:41.97,JP,,0,0,0,,Біз тек әскерге азық-түлік жеткізетіндер ретінде бұл жерді қорғай алмаймыз
Dialogue: 0,0:03:42.76,0:03:45.18,JP,,0,0,0,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:03:45.18,0:03:50.99,JP,,0,0,0,,Жол босатыңыз. Енді мен қосымша күштерді ұйымдастыруды өз мойныма аламын.
Dialogue: 0,0:03:52.46,0:03:54.98,JP,,0,0,0,,Ішкі қақпаның қауіпсіздігінен ішке қарай айтасыз ба?
Dialogue: 0,0:03:56.00,0:04:00.30,JP,,0,0,0,,Не айтпақшысыз? Бұл ережелерге сәйкес.
Dialogue: 0,0:04:00.47,0:04:03.92,JP,,0,0,0,,Белгіленген ережелерді сақтау — сарбаздың борышы.
Dialogue: 0,0:04:04.09,0:04:06.28,JP,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:04:06.28,0:04:07.89,JP,,0,0,0,,Иә, үндеме.
Dialogue: 0,0:04:09.62,0:04:14.47,JP,,0,0,0,,Тағы бір ауыз сөз айтсаң, оны сатқындық деп есептеп, сол жерде жазалаймын.
Dialogue: 0,0:04:28.32,0:04:31.17,JP,,0,0,0,,Уақытша шегінуді білдіретін қоңырауды естіген боларсың.
Dialogue: 0,0:04:31.79,0:04:33.90,JP,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:04:49.27,0:04:53.37,JP,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,0:05:03.83,0:05:04.62,JP,,0,0,0,,Жарайды
Dialogue: 0,0:05:05.31,0:05:08.16,JP,,0,0,0,,Мұның не пайдасы бар?
Dialogue: 0,0:05:17.86,0:05:19.72,JP,,0,0,0,,Эй, Ян, енді не істейміз?
Dialogue: 0,0:05:20.20,0:05:22.07,JP,,0,0,0,,Ештеңе істей алмаймыз.
Dialogue: 0,0:05:22.85,0:05:24.98,JP,,0,0,0,,Ақыры шегіну бұйрығын алдық,
Dialogue: 0,0:05:25.33,0:05:27.26,JP,,0,0,0,,бірақ газ бітті, қабырғаға өре алмаймыз.
Dialogue: 0,0:05:28.24,0:05:30.92,JP,,0,0,0,,Солайша бәріміз өлеміз ғой?
Dialogue: 0,0:05:30.92,0:05:33.04,JP,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:05:33.87,0:05:35.18,JP,,0,0,0,,Ал жабдықтау тобы ше?
Dialogue: 0,0:05:35.95,0:05:38.60,JP,,0,0,0,,Оларға не болды? Барлығы қырылды ма?
Dialogue: 0,0:05:39.11,0:05:41.18,JP,,0,0,0,,Көрінгендей, олар шайқасуға деген ерік-жігерін жоғалтқан.
Dialogue: 0,0:05:42.01,0:05:43.50,JP,,0,0,0,,Дегенмен, мен олардың сезімін түсінемін.
Dialogue: 0,0:05:44.20,0:05:48.20,JP,,0,0,0,,Бірақ бізге арналған жабдықтау миссиясын тастап, штабта өздерін қамап алу тым шектен тыс емес пе?
Dialogue: 0,0:05:49.26,0:05:53.69,JP,,0,0,0,,Міне, мен ойлағандай — Титантар легімен шабуыл жасап жатыр, сондықтан біз қосымша жанармай ала алмаймыз.
Dialogue: 0,0:05:53.87,0:05:57.85,JP,,0,0,0,,Жапон аудиосы: zwx & Tsurou; Аударма: Pulsar & Basugi; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгілерін қою: Feng She; Дәстүрлі қытайша бейімдеу: incot; Кодтау: Ginsou
Dialogue: 0,0:05:58.54,0:06:00.72,JP,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:06:00.98,0:06:02.66,JP,,0,0,0,,және тағы да Титан шапқыншылығына жол берілді.
Dialogue: 0,0:06:03.72,0:06:07.56,JP,,0,0,0,,Эрен, асық!
Dialogue: 0,0:06:07.83,0:06:10.67,JP,,0,0,0,,Екі сағаттан кейін барлық тұрғындар эвакуацияланды.
Dialogue: 0,0:06:11.85,0:06:14.42,JP,,0,0,0,,Титандар бірде-бір адамды жеп қоймады.
Dialogue: 0,0:06:15.69,0:06:19.01,JP,,0,0,0,,Шабуылға тойтар кезінде міндеттерін орындау барысында қаза тапқан сарбаздарды есептемегенде
Dialogue: 0,0:06:19.73,0:06:22.36,JP,,0,0,0,,Эрен, сен осы жерде болсаң, мен бәрін жасай аламын
Dialogue: 0,0:06:23.23,0:06:27.21,JP,,0,0,0,,Күте тұрыңыз, капитан
Dialogue: 0,0:06:28.54,0:06:32.89,JP,,0,0,0,,Егер Титан шабуыл жасаса
Dialogue: 0,0:06:33.82,0:06:38.64,JP,,0,0,0,,Біз тек әскерге азық-түлік жеткізетіндер ретінде бұл жерді қорғай алмаймыз
Dialogue: 0,0:06:39.71,0:06:42.33,JP,,0,0,0,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:06:45.10,0:06:46.09,JP,,0,0,0,,Жол босатыңыз. Енді мен қосымша күштерді ұйымдастыруды өз мойныма аламын.
