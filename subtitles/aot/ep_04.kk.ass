Dialogue: 0,0:22:39.50,0:22:44.22,ED-JP,,0000,0000,0000,,Ол арман жүректің бар жері
Dialogue: 0,0:22:44.47,0:22:49.68,ED-JP,,0000,0000,0000,,Өмірден де нәзік нәрсе
Dialogue: 0,0:22:50.77,0:22:55.25,ED-JP,,0000,0000,0000,,Оны тастап, қайта-қайта табыңыз
Dialogue: 0,0:22:55.45,0:23:01.44,ED-JP,,0000,0000,0000,,Енді тыныш жат.
Dialogue: 0,0:23:02.08,0:23:07.37,ED-JP,,0000,0000,0000,,Импульстік импульске
Dialogue: 0,0:23:07.75,0:23:12.66,ED-JP,,0000,0000,0000,,Тілек бұзылды
Dialogue: 0,0:23:13.43,0:23:17.86,ED-JP,,0000,0000,0000,,Ұмытқан сайын
Dialogue: 0,0:23:18.01,0:23:23.33,ED-JP,,0000,0000,0000,,Тағы да есімде
Dialogue: 0,0:23:23.57,0:23:29.28,ED-JP-2,,0000,0000,0000,,Бұл әдемі және қатыгез әлемде
Dialogue: 0,0:23:29.59,0:23:32.10,ED-JP-2,,0000,0000,0000,,Әлі тірі
Dialogue: 0,0:23:32.10,0:23:34.95,ED-JP-2,,0000,0000,0000,,Неге екенін сұрап жатырмын
Dialogue: 0,0:23:34.95,0:23:40.48,ED-JP-2,,0000,0000,0000,,А, бізде бұл күшті және әлсіз.
Dialogue: 0,0:23:40.51,0:23:43.63,ED-JP-2,,0000,0000,0000,,Біз нені қорғаймыз?
Dialogue: 0,0:23:44.08,0:23:49.85,ED-JP-2,,0000,0000,0000,,Енді ешқандай себеп болмаса
