Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.18,0:00:17.93,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:18.01,0:00:20.27,Default,,0,0,0,,‎(Нацуки) А, Мику мұнда!
Dialogue: 0,0:00:20.35,0:00:21.68,Default,,0,0,0,,‎Қайырлы таң~
Dialogue: 0,0:00:21.77,0:00:23.64,Default,,0,0,0,,Әй, қалай болды?
Dialogue: 0,0:00:23.73,0:00:26.98,Default,,0,0,0,,‎Хмм? Жарайды, себебі бұл жай ғана қызба еді.
Dialogue: 0,0:00:27.06,0:00:28.44,Default,,0,0,0,,‎Жоқ~
Dialogue: 0,0:00:28.52,0:00:30.19,Default,,0,0,0,,‎Асаги‎Сен туралы!
Dialogue: 0,0:00:30.28,0:00:31.28,Default,,0,0,0,,‎(Юкия/Мику) Уф
Dialogue: 0,0:00:31.36,0:00:34.32,Default,,0,0,0,,Күткендей, сіз шекарадан өткен жоқсыз ба?
Dialogue: 0,0:00:34.40,0:00:36.16,Default,,0,0,0,,Маған мүмкіндігінше айтыңыз.
Dialogue: 0,0:00:36.24,0:00:37.87,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:00:37.95,0:00:39.83,Default,,0,0,0,,Менің қызуым көтерілді.
Dialogue: 0,0:00:39.91,0:00:42.91,Default,,0,0,0,,‎Асаги-кун Мику аман қалды...
Dialogue: 0,0:00:44.50,0:00:45.71,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:00:45.79,0:00:48.42,Default,,0,0,0,,‎Е... Асаги-кун?
Dialogue: 0,0:00:49.92,0:00:52.26,Default,,0,0,0,,Бұл өте жылдам болды.
Dialogue: 0,0:00:52.34,0:00:54.55,Default,,0,0,0,,‎Асаги-кун жүгіре алды!
Dialogue: 0,0:00:54.63,0:00:55.55,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:00:55.63,0:00:57.22,Default,,0,0,0,,‎(Янаги) Шынайы ма?
Dialogue: 0,0:00:58.51,0:01:00.26,Default,,0,0,0,,‎Ол неге сонша жылдам?
Dialogue: 0,0:01:00.35,0:01:02.39,Default,,0,0,0,,Сәлем? Мику~
Dialogue: 0,0:01:02.47,0:01:04.31,Default,,0,0,0,,Иә? Мен білмеймін!
Dialogue: 0,0:01:04.39,0:01:07.73,Default,,0,0,0,,‎(Юкия) Ахх, бұл тым байқалды.
Dialogue: 0,0:01:07.81,0:01:10.15,Default,,0,0,0,,Маған керек емес еді...
Dialogue: 0,0:01:10.23,0:01:12.28,Default,,0,0,0,,(Маэда) Бұл жігіттер ақыры кездесе ме?
Dialogue: 0,0:01:12.36,0:01:13.82,Default,,0,0,0,,(Мизусима) Жоқ, мен олай ойламаймын.
Dialogue: 0,0:01:13.90,0:01:15.90,Default,,0,0,0,,(Маэда) Жоқ, өйткені олар бала күнгі достар сияқты.
Dialogue: 0,0:01:15.99,0:01:18.66,Default,,0,0,0,,Сакура-сан, мен Асанеги-кунмен жиі сөйлесемін.
Dialogue: 0,0:01:18.74,0:01:22.41,Default,,0,0,0,,‎(Йокоматсу) Маңызды емес пе? Сакура-сан барлығымен оңай сөйлеседі.
Dialogue: 0,0:01:22.49,0:01:26.37,Default,,0,0,0,,‎(Иишиба) Цукаса Соңғы уақытта, Сакура мырза, сізде менімен ортақ бір нәрсе бар деп ойлаймын!
Dialogue: 0,0:01:26.46,0:01:29.88,Default,,0,0,0,,Өткен күні мен ойындар туралы айтқанымда, ол күліп жіберді.
Dialogue: 0,0:01:29.96,0:01:30.96,Default,,0,0,0,,‎(Йокоматсу) Сакура-сан өте мейірімді.
Dialogue: 0,0:01:30.96,0:01:31.84,Default,,0,0,0,,‎(Йокоматсу) Сакура-сан өте мейірімді.
Dialogue: 0,0:01:30.96,0:01:31.84,Default,,0,0,0,,(Микудың күлуі)
Dialogue: 0,0:01:31.84,0:01:31.92,Default,,0,0,0,,(Микудың күлуі)
Dialogue: 0,0:01:31.92,0:01:33.88,Default,,0,0,0,,(Микудың күлуі)
Dialogue: 0,0:01:31.92,0:01:33.88,Default,,0,0,0,,‎Өзің сияқты адамдармен жақсы дос бол.
Dialogue: 0,0:01:33.88,0:01:33.96,Default,,0,0,0,,(Микудың күлуі)
Dialogue: 0,0:01:33.96,0:01:35.01,Default,,0,0,0,,(Микудың күлуі)
Dialogue: 0,0:01:33.96,0:01:35.01,Default,,0,0,0,,‎(Иишиба) Бұл нені білдіреді? Эй!
Dialogue: 0,0:01:35.01,0:01:35.84,Default,,0,0,0,,‎(Иишиба) Бұл нені білдіреді? Эй!
Dialogue: 0,0:01:35.92,0:01:36.97,Default,,0,0,0,,‎(Юкия) Ммм...
Dialogue: 0,0:01:37.05,0:01:39.68,Default,,0,0,0,,(Иишиба) Негитчи сондай көрінеді.
Dialogue: 0,0:01:39.76,0:01:42.97,Default,,0,0,0,,Сакура-санның жігіті болу үшін, ол тым қараңғы.
Dialogue: 0,0:01:43.06,0:01:44.77,Default,,0,0,0,,‎(Мизусима) Marge That!
Dialogue: 0,0:01:45.56,0:01:48.44,Default,,0,0,0,,‎(Юкия) Йокьяны каста бойынша бірден соттайды.
Dialogue: 0,0:01:48.52,0:01:51.98,Default,,0,0,0,,№. Ештеңе болған жоқ, солай ма?
Dialogue: 0,0:01:52.07,0:01:54.53,Default,,0,0,0,,Құшақтау, сүйісу, т.б.
Dialogue: 0,0:01:54.61,0:01:56.49,Default,,0,0,0,,‎Не... Мен олай ойламаймын.
Dialogue: 0,0:01:56.57,0:01:58.07,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:01:58.15,0:02:01.20,Default,,0,0,0,,Маған керек пе? Оны алып кетуі мүмкін
Dialogue: 0,0:02:03.62,0:02:06.70,Default,,0,0,0,,‎Мысалы, мен
Dialogue: 0,0:02:06.79,0:02:07.79,Default,,0,0,0,,Ех!
Dialogue: 0,0:02:09.67,0:02:11.46,Default,,0,0,0,,Фухун
Dialogue: 0,0:02:11.54,0:02:12.54,Default,,0,0,0,,‎Гах...
Dialogue: 0,0:02:13.84,0:02:16.05,Default,,0,0,0,,‎Адал болыңыз~
Dialogue: 0,0:02:18.09,0:02:22.80,Default,,0,0,0,,О, мен бұл туралы енді ойламауға тырыстым.
Dialogue: 0,0:02:22.89,0:02:25.43,Default,,0,0,0,,Бәріміз Юкия туралы сөйлесейік...
Dialogue: 0,0:02:25.52,0:02:27.02,Default,,0,0,0,,есімде
Dialogue: 0,0:02:27.52,0:02:29.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:30.02,0:02:33.98,Default,,0,0,0,,‎Енді жоқ, Юкия жетпейді!
Dialogue: 0,0:02:36.15,0:02:38.15,Default,,0,0,0,,♪～
Dialogue: 0,0:04:01.53,0:04:03.53,Default,,0,0,0,,～♪
Dialogue: 0,0:04:05.57,0:04:07.33,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:04:07.41,0:04:09.83,Default,,0,0,0,,Осы уақытқа дейін сыныпта қашықтық болды.
Dialogue: 0,0:04:09.91,0:04:11.58,Default,,0,0,0,,Бұл анық болды
Dialogue: 0,0:04:11.66,0:04:16.25,Default,,0,0,0,,‎Бұл уақыт қазір өте жалғыз.
Dialogue: 0,0:04:16.33,0:04:18.80,Default,,0,0,0,,Мен Юкияға тез жақындағым келеді
Dialogue: 0,0:04:19.55,0:04:24.84,Default,,0,0,0,,‎Егер мен сені сабақтан кейін менімен қайта келуіңді өтінсем, не ойлайсың?
Dialogue: 0,0:04:24.93,0:04:28.26,Default,,0,0,0,,Өз бетімен алысқа бару дұрыс емес деп ойлаймын...
Dialogue: 0,0:04:28.35,0:04:32.27,Default,,0,0,0,,‎Ууууууууууууууууууууууууууууууу...
Dialogue: 0,0:04:32.35,0:04:34.52,Default,,0,0,0,,Мен Юкияға қосылғым келеді!
Dialogue: 0,0:04:36.19,0:04:39.07,Default,,0,0,0,,‎Маған қамқор болғаныңызға рахмет.
Dialogue: 0,0:04:39.15,0:04:42.49,Default,,0,0,0,,Мен торт жасауды ойлап жатырмын...
Dialogue: 0,0:04:42.57,0:04:43.82,Default,,0,0,0,,‎(Нацуки) Торт?
Dialogue: 0,0:04:43.90,0:04:45.03,Default,,0,0,0,,Бұл батыстық нәрсе.
Dialogue: 0,0:04:45.11,0:04:46.53,Default,,0,0,0,,‎Батыс материалдары?
Dialogue: 0,0:04:46.61,0:04:49.28,Default,,0,0,0,,Мен Йокьяны көргенде, ол Юкия сияқты сөздер айтты.
Dialogue: 0,0:04:49.37,0:04:51.12,Default,,0,0,0,,Жапон тәттілері жақсы
Dialogue: 0,0:04:51.20,0:04:54.79,Default,,0,0,0,,Махаббатпен қолдан жасалған, алақандай
Dialogue: 0,0:04:54.87,0:04:58.96,Default,,0,0,0,,‎Аузыңызға салғанда таралатын нәзік және тыныштандыратын тәттілік
Dialogue: 0,0:04:59.04,0:05:02.17,Default,,0,0,0,,Басқаны ойлайтын жүрек деп ойламайсың ба?
Dialogue: 0,0:05:02.26,0:05:06.51,Default,,0,0,0,,‎Е~ Шынымен бе? JK тәттілер жасап, жапон тәттілерін жасап жатыр...
Dialogue: 0,0:05:06.59,0:05:11.10,Default,,0,0,0,,Аа, бірақ мен жыл сайын әжеммен охаги жасайтынмын.
Dialogue: 0,0:05:11.72,0:05:14.64,Default,,0,0,0,,Бірге орап, орау қызық болды.
Dialogue: 0,0:05:14.73,0:05:18.15,Default,,0,0,0,,Дұрыс? Сіз мұны батыстық нәрселерге жасай аласыз ба?
Dialogue: 0,0:05:20.36,0:05:21.19,Default,,0,0,0,,‎(Юкия) А...
Dialogue: 0,0:05:21.27,0:05:24.49,Default,,0,0,0,,Иә, иә, жақсы! Бұл жақсы!
Dialogue: 0,0:05:24.57,0:05:25.49,Default,,0,0,0,,Және...
Dialogue: 0,0:05:25.57,0:05:29.32,Default,,0,0,0,,(Юкия) Дайфуку балмұздағын алсаңыз, Вакана міндетті түрде біреуін алады.
Dialogue: 0,0:05:29.41,0:05:31.62,Default,,0,0,0,,Менің арманым екеуін жеу.
Dialogue: 0,0:05:32.45,0:05:35.12,Default,,0,0,0,,‎Наччан ‎Сіз дайфуку жасауды білесіз бе?
Dialogue: 0,0:05:35.20,0:05:38.62,Default,,0,0,0,,‎(Нацуки) Әрине! Себебі сен менің үлкен әпкемсің.
Dialogue: 0,0:05:44.59,0:05:46.76,Default,,0,0,0,,Иә, бум!
Dialogue: 0,0:05:47.26,0:05:48.93,Default,,0,0,0,,‎(Юкия) Не? Бұл
Dialogue: 0,0:05:49.01,0:05:50.39,Default,,0,0,0,,‎Жапон тәттілеріне арналған ингредиенттер!
Dialogue: 0,0:05:50.47,0:05:53.81,Default,,0,0,0,,Өткен күні маған қамқорлық жасағаныңызға рахмет.
Dialogue: 0,0:05:53.89,0:05:57.52,Default,,0,0,0,,‎Міне, мочи жаңадан жасалғанда дәмді болады.
Dialogue: 0,0:05:57.60,0:06:00.56,Default,,0,0,0,,Мен бәрібір Юкияның үйіне жетуім керек деп ойладым.
Dialogue: 0,0:06:02.23,0:06:04.53,Default,,0,0,0,,‎Жоқ, рахмет немесе бір нәрсе...
Dialogue: 0,0:06:05.23,0:06:08.99,Default,,0,0,0,,Ал... Жарайды, егер маған жасатқың келсе.
Dialogue: 0,0:06:09.07,0:06:11.07,Default,,0,0,0,,Сіз оны жеуге болады.
Dialogue: 0,0:06:11.16,0:06:13.87,Default,,0,0,0,,Сіз мұны бірге жасауымыз керек дейсіз бе?
Dialogue: 0,0:06:14.99,0:06:16.41,Default,,0,0,0,,‎Эй, қарашы, балмұздақ!
Dialogue: 0,0:06:16.50,0:06:21.13,Default,,0,0,0,,Мен балмұздақ пен қызыл бұршақ пастасын дайындаймын! Сіз оны асыға күтесіз бе?
Dialogue: 0,0:06:21.21,0:06:25.80,Default,,0,0,0,,(Юкия) Бұл жігіт жігерлі, қуанышты дауыспен сөйлеп тұрды.
Dialogue: 0,0:06:26.38,0:06:28.55,Default,,0,0,0,,‎Накчан осылай ұсынды⸺
Dialogue: 0,0:06:28.63,0:06:30.13,Default,,0,0,0,,Бұл рецепт туралы бейне.
Dialogue: 0,0:06:30.22,0:06:31.09,Default,,0,0,0,,‎(Юкия) Иә?
Dialogue: 0,0:06:31.18,0:06:32.60,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:06:32.68,0:06:34.81,Default,,0,0,0,,А...
Dialogue: 0,0:06:35.39,0:06:37.56,Default,,0,0,0,,‎(Юкия) Эй... Эй...
Dialogue: 0,0:06:38.39,0:06:40.27,Default,,0,0,0,,‎-(Юкия) Эй, Мику ‎-Ех!
Dialogue: 0,0:06:40.35,0:06:43.06,Default,,0,0,0,,Мен саған осы жерде тоқтауыңды айттым.
Dialogue: 0,0:06:43.15,0:06:45.15,Default,,0,0,0,,Иә? Ааа...
Dialogue: 0,0:06:45.23,0:06:47.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:49.40,0:06:51.20,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:07:10.51,0:07:14.01,Default,,0,0,0,,‎(Юкия) Қызғылт және ашық жасыл?
Dialogue: 0,0:07:14.10,0:07:15.97,Default,,0,0,0,,Әдемі.
Dialogue: 0,0:07:16.06,0:07:19.81,Default,,0,0,0,,‎Хмм... Сенің ақ шарыңа ұқсайды, солай емес пе?
Dialogue: 0,0:07:19.89,0:07:22.40,Default,,0,0,0,,Иә? Юкияныкі тым үлкен
Dialogue: 0,0:07:22.48,0:07:23.35,Default,,0,0,0,,‎Тамақтану қиын емес пе?
Dialogue: 0,0:07:23.44,0:07:25.31,Default,,0,0,0,,Иә? Ондай нәрсе жоқ
Dialogue: 0,0:07:26.73,0:07:28.61,Default,,0,0,0,,‎-(Юкия) Қарашы ‎-Аа...
Dialogue: 0,0:07:32.03,0:07:36.28,Default,,0,0,0,,‎(жүрек соғысы)
Dialogue: 0,0:07:40.71,0:07:42.08,Default,,0,0,0,,А...
Dialogue: 0,0:07:43.62,0:07:44.79,Default,,0,0,0,,‎…
Dialogue: 0,0:07:44.88,0:07:47.84,Default,,0,0,0,,Бұл тым үлкен! Тіпті мен үшін 3 тістеу керек.
Dialogue: 0,0:07:47.92,0:07:50.67,Default,,0,0,0,,‎Сосо... Түсінемін. Бұл сәл үлкен.
Dialogue: 0,0:07:50.76,0:07:55.09,Default,,0,0,0,,Е, күте тұрыңыз! Мүмкін емес, мүмкін емес, мүмкін емес! Неліктен?
Dialogue: 0,0:07:55.85,0:08:00.39,Default,,0,0,0,,Қолды ұстау немесе оларға жабысу, тіпті бұл бұрын болған болса да.
Dialogue: 0,0:08:01.43,0:08:04.85,Default,,0,0,0,,‎Мен күткендей біртүрлімін.
Dialogue: 0,0:08:07.90,0:08:11.40,Default,,0,0,0,,‎Ой... Тыныш, сабыр.
Dialogue: 0,0:08:13.15,0:08:14.24,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:08:28.46,0:08:30.13,Default,,0,0,0,,‎Юкия Юкия!
Dialogue: 0,0:08:30.21,0:08:31.30,Default,,0,0,0,,‎(Юкия) Иә?
Dialogue: 0,0:08:31.88,0:08:35.01,Default,,0,0,0,,Осыған қарап, сіз бірдеңе ойлайсыз ба?
Dialogue: 0,0:08:35.09,0:08:36.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.22,0:08:37.35,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:08:37.43,0:08:39.47,Default,,0,0,0,,О, болмайды...
Dialogue: 0,0:08:40.35,0:08:43.52,Default,,0,0,0,,‎Шие гүлінің түсі және ашық пияз түсі!
Dialogue: 0,0:08:43.60,0:08:47.73,Default,,0,0,0,,‎Біздің бірге тұрып қалғанымызды көріп, шошып кеттің.
Dialogue: 0,0:08:49.86,0:08:52.61,Default,,0,0,0,,Оны өзіңіз тіркедіңіз бе?
Dialogue: 0,0:08:52.69,0:08:54.61,Default,,0,0,0,,Ех! Ах...
Dialogue: 0,0:08:54.70,0:08:56.11,Default,,0,0,0,,Сіз таң қалдыңыз!
Dialogue: 0,0:08:56.20,0:08:57.24,Default,,0,0,0,,Сіз мені қатты итеріп жатырсыз ба?
Dialogue: 0,0:08:58.45,0:09:03.37,Default,,0,0,0,,Сонда шие гүлінің түсі Мику дегенді білдіреді, солай ма?
Dialogue: 0,0:09:04.16,0:09:08.33,Default,,0,0,0,,Бұл микудың дәмі қандай?
Dialogue: 0,0:09:08.42,0:09:09.46,Default,,0,0,0,,Е...
Dialogue: 0,0:09:12.80,0:09:14.01,Default,,0,0,0,,‎ (жұтыну дыбысы)
Dialogue: 0,0:09:15.47,0:09:17.22,Default,,0,0,0,,А...
Dialogue: 0,0:09:17.80,0:09:19.72,Default,,0,0,0,,Иә? ше?
Dialogue: 0,0:09:19.80,0:09:23.02,Default,,0,0,0,,‎Сізді жеп қойды деп ойлағанда, таң қалдыңыз ба?
Dialogue: 0,0:09:23.10,0:09:25.27,Default,,0,0,0,,‎Ммммм...
Dialogue: 0,0:09:25.35,0:09:27.31,Default,,0,0,0,,‎(Юкия) О, өте дәмді
Dialogue: 0,0:09:27.40,0:09:30.52,Default,,0,0,0,,‎Хмм... Бұл жақсы идея!
Dialogue: 0,0:09:30.61,0:09:32.23,Default,,0,0,0,,Мен қолымды жуайын!
Dialogue: 0,0:09:45.08,0:09:48.42,Default,,0,0,0,,(Юкия) Микудың жылуы әлі де бар сияқты.
Dialogue: 0,0:09:51.46,0:09:56.72,Default,,0,0,0,,Микудың ерні жұмсақ болғанына сенімдімін.
Dialogue: 0,0:10:02.51,0:10:05.02,Default,,0,0,0,,Юкия сондай...
Dialogue: 0,0:10:05.10,0:10:09.90,Default,,0,0,0,,Дауысы да, қолы да, келбеті де, бәрі жүрегімді елжіретеді.
Dialogue: 0,0:10:09.98,0:10:15.03,Default,,0,0,0,,‎Мен Юкияны қатты жақсы көремін, қызық, менің сезімімде қате бар ма?
Dialogue: 0,0:10:17.70,0:10:18.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.24,0:10:23.41,Default,,0,0,0,,‎(Юкия) Хами Хами Хами…
Dialogue: 0,0:10:31.00,0:10:32.17,Default,,0,0,0,,‎Кисшо!
Dialogue: 0,0:10:33.34,0:10:34.46,Default,,0,0,0,,‎(Вакана) Мен үйдемін
Dialogue: 0,0:10:34.55,0:10:38.09,Default,,0,0,0,,‎(Юкия) Не? Не? Мен жай ғана Дайфуку жедім бе?
Dialogue: 0,0:10:38.17,0:10:39.68,Default,,0,0,0,,Сіз оны өте нашар жейсіз!
Dialogue: 0,0:10:39.76,0:10:42.18,Default,,0,0,0,,‎(Вакана) Хааа
Dialogue: 0,0:10:42.26,0:10:45.47,Default,,0,0,0,,Екеуі қайтадан сырласады.
Dialogue: 0,0:10:45.56,0:10:48.64,Default,,0,0,0,,‎Уф, мен де бүгін ішім ауыратын сияқты.
Dialogue: 0,0:10:48.73,0:10:50.90,Default,,0,0,0,,‎Тәске басар ретінде тұздалған балдырларды жейміз
Dialogue: 0,0:10:59.61,0:11:00.86,Default,,0,0,0,,‎(Kazane) Өте ұятсыз!
Dialogue: 0,0:11:00.95,0:11:04.12,Default,,0,0,0,,‎Сен... Сенпай! Даусыңыз қатты
Dialogue: 0,0:11:04.20,0:11:05.49,Default,,0,0,0,,‎(Kazane) Бұл... Өйткені...
Dialogue: 0,0:11:05.58,0:11:08.66,Default,,0,0,0,,Мен Покит ойыны осылай болады деп ойламаппын...
Dialogue: 0,0:11:08.75,0:11:11.87,Default,,0,0,0,,‎Сонымен қатар... толығырақ айтып беріңізші.
Dialogue: 0,0:11:11.96,0:11:15.09,Default,,0,0,0,,Иә? Толық мәлімет сұрасаңыз да...
Dialogue: 0,0:11:15.17,0:11:17.42,Default,,0,0,0,,‎(Kazane) Сіз мұны қанша рет жасадыңыз?
Dialogue: 0,0:11:17.51,0:11:19.42,Default,,0,0,0,,‎Ой... есімде жоқ.
Dialogue: 0,0:11:19.51,0:11:22.72,Default,,0,0,0,,‎(Қазене) Есіңде қалмайтындай көп істедің бе? Тым тентек емес пе?
Dialogue: 0,0:11:25.93,0:11:28.52,Default,,0,0,0,,‎Мұны нақты қалай жасадыңыз?
Dialogue: 0,0:11:28.60,0:11:30.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:30.69,0:11:36.02,Default,,0,0,0,,Ал... басында екеуміз де қорқатын шығармыз.
Dialogue: 0,0:11:38.69,0:11:41.61,Default,,0,0,0,,Бұл сияқты болды...
Dialogue: 0,0:11:42.20,0:11:45.87,Default,,0,0,0,,Біртіндеп Юкияның қолы иығыма келді.
Dialogue: 0,0:11:45.95,0:11:48.58,Default,,0,0,0,,‎Күш күшейе түседі...
Dialogue: 0,0:11:49.16,0:11:50.96,Default,,0,0,0,,‎Ааа~
Dialogue: 0,0:11:51.04,0:11:53.83,Default,,0,0,0,,Бұл жеткілікті ме? Өйткені мен қызбын!
Dialogue: 0,0:11:53.92,0:11:58.17,Default,,0,0,0,,Да, жоқ! Мұндай нәрсені тек Сакура-санға сұрауға болады.
Dialogue: 0,0:12:00.55,0:12:01.76,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:12:02.97,0:12:05.30,Default,,0,0,0,,Сіз оны шынымен қолданып көргенде қалай болдыңыз?
Dialogue: 0,0:12:06.51,0:12:07.97,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:12:09.31,0:12:12.52,Default,,0,0,0,,Мүмкін аздап қауіпті шығар? деп ойладым
Dialogue: 0,0:12:12.60,0:12:13.64,Default,,0,0,0,,‎(Kazane) Қауіпті ме?
Dialogue: 0,0:12:13.73,0:12:18.19,Default,,0,0,0,,Мен басымнан аяғыма дейін жансызданамын.
Dialogue: 0,0:12:19.28,0:12:21.36,Default,,0,0,0,,Менің басым ағады
Dialogue: 0,0:12:21.44,0:12:24.57,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:12:25.11,0:12:28.62,Default,,0,0,0,,Мен ақымақ болып бара жатқандай сезінемін.
Dialogue: 0,0:12:28.70,0:12:30.91,Default,,0,0,0,,‎(Kazane) Ах! күтіңіз күтіңіз
Dialogue: 0,0:12:31.00,0:12:33.29,Default,,0,0,0,,‎Мазохистік Бұл әдепсіз болып шықты, солай ма?
Dialogue: 0,0:12:33.37,0:12:35.42,Default,,0,0,0,,Бұл болмайды!
Dialogue: 0,0:12:36.96,0:12:38.96,Default,,0,0,0,,‎(Kazene) Otome... солай ма?
Dialogue: 0,0:12:39.04,0:12:41.34,Default,,0,0,0,,‎Қыз... Сондықтан
Dialogue: 0,0:12:44.43,0:12:50.01,Default,,0,0,0,,‎Юкия, сен мені сүйдің. Көңіліңіз қалды ма деп ойлаймын.
Dialogue: 0,0:12:50.10,0:12:51.81,Default,,0,0,0,,‎(Қазене) Е, неге?
Dialogue: 0,0:12:51.89,0:12:56.98,Default,,0,0,0,,‎Жоқ... Мен оны алдайтын әйел сияқты сезінемін.
Dialogue: 0,0:12:57.90,0:12:59.73,Default,,0,0,0,,Поцелудің жыпылықтауы
Dialogue: 0,0:12:59.82,0:13:03.24,Default,,0,0,0,,‎Жігіттің арам пиғылын пайдалану - жиіркенішті
Dialogue: 0,0:13:04.32,0:13:07.87,Default,,0,0,0,,Мен мақұлдау тілегіме берілдім және бұл өте лас.
Dialogue: 0,0:13:07.95,0:13:11.91,Default,,0,0,0,,‎Мен шынымен қыз болуды аяқтадым.
Dialogue: 0,0:13:17.88,0:13:19.71,Default,,0,0,0,,‎Мені сүйгеніңізге қуаныштымын
Dialogue: 0,0:13:21.42,0:13:24.01,Default,,0,0,0,,Адамдар мен туралы ойлайтын қыз болғым келеді
Dialogue: 0,0:13:24.51,0:13:26.93,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:13:27.01,0:13:28.55,Default,,0,0,0,,А...
Dialogue: 0,0:13:30.01,0:13:33.85,Default,,0,0,0,,‎Көп нәрсе болды, бірақ соның арқасында біз жақындай түстік.
Dialogue: 0,0:13:33.93,0:13:36.64,Default,,0,0,0,,Мен оны одан да сүйкімді ету керек деп ойладым.
Dialogue: 0,0:13:36.73,0:13:40.06,Default,,0,0,0,,Егер сіз тағы да осындай нәрсені көрсеңіз, маған хабарлаңыз.
Dialogue: 0,0:13:43.36,0:13:45.74,Default,,0,0,0,,‎(Kazane) Бұл керемет, Сакура-сан.
Dialogue: 0,0:13:46.36,0:13:48.82,Default,,0,0,0,,‎Мен ұнататын адамды сүйсем де
Dialogue: 0,0:13:48.91,0:13:52.83,Default,,0,0,0,,Көңіл көтерудің орнына, басқа адамның сезімі туралы ойланыңыз
Dialogue: 0,0:13:53.41,0:13:56.25,Default,,0,0,0,,Бұл сізді қатты мазалағанына сенімдімін.
Dialogue: 0,0:13:56.87,0:13:59.00,Default,,0,0,0,,Бірақ сен менің артымнан ердің.
Dialogue: 0,0:13:59.08,0:14:01.79,Default,,0,0,0,,Жасым үлкен болса да
Dialogue: 0,0:14:02.75,0:14:04.00,Default,,0,0,0,,Және...
Dialogue: 0,0:14:04.09,0:14:08.80,Default,,0,0,0,,‎Мен оны сүйгенде сені бақытты сезінетін қыз болғым келеді.
Dialogue: 0,0:14:11.43,0:14:14.60,Default,,0,0,0,,‎(Kazane) Қызық, мен бір бола аламын ба?
Dialogue: 0,0:14:16.06,0:14:18.10,Default,,0,0,0,,‎(Студент қыз) Мику, шаршады
Dialogue: 0,0:14:18.19,0:14:20.06,Default,,0,0,0,,Маған дайындалуға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:14:20.15,0:14:21.98,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:14:22.06,0:14:23.40,Default,,0,0,0,,‎(Студент қыз) Иә, бар
Dialogue: 0,0:14:23.48,0:14:24.98,Default,,0,0,0,,‎-Uh ‎-(Kazane) Ах...
Dialogue: 0,0:14:25.07,0:14:26.28,Default,,0,0,0,,Төраға, өтінемін
Dialogue: 0,0:14:26.36,0:14:28.53,Default,,0,0,0,,‎(Қазане) Ах... Рахмет.
Dialogue: 0,0:14:30.57,0:14:33.83,Default,,0,0,0,,‎-(Студент қыз) Бұл Покит кемпір ‎-(Студент қыз) Ахаха, бұл не?
Dialogue: 0,0:14:33.91,0:14:34.95,Default,,0,0,0,,‎(Ер студент) Маған беріңіз~
Dialogue: 0,0:14:35.04,0:14:36.29,Default,,0,0,0,,‎(жүргізуші) жел дыбысы!
Dialogue: 0,0:14:37.00,0:14:39.75,Default,,0,0,0,,Егер бірдеңе қалса, неге менімен сөйлеспейсің?
Dialogue: 0,0:14:39.83,0:14:41.67,Default,,0,0,0,,Мен білмей үйге бармақ болдым.
Dialogue: 0,0:14:41.75,0:14:44.71,Default,,0,0,0,,‎Себебі сіз толық емес жұмыс күнімен айналысасыз.
Dialogue: 0,0:14:44.80,0:14:46.26,Default,,0,0,0,,‎Артық жұмыс жақсы емес
Dialogue: 0,0:14:46.34,0:14:50.59,Default,,0,0,0,,‎(көлік жүргізу) шамадан тыс жұмыс істей ме? Менің физикалық күшім жақсы.
Dialogue: 0,0:14:50.68,0:14:52.01,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:14:52.09,0:14:53.93,Default,,0,0,0,,Студенттер кеңесіндегі әрбір адам ауыртпалық болып қалмауы үшін.
Dialogue: 0,0:14:54.01,0:14:55.60,Default,,0,0,0,,Сіз мені шынымен бақылап отырсыз.
Dialogue: 0,0:14:55.68,0:14:59.02,Default,,0,0,0,,‎Мұны өз бетіңізше тым байсалды қабылдамаңыз.
Dialogue: 0,0:14:59.64,0:15:00.81,Default,,0,0,0,,‎(Kazane) Ммм...
Dialogue: 0,0:15:06.44,0:15:07.36,Default,,0,0,0,,Қозғалыс тогы
Dialogue: 0,0:15:09.82,0:15:10.90,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:15:20.58,0:15:22.71,Default,,0,0,0,,‎(Kazane) Kyaa Мен айттым, айттым
Dialogue: 0,0:15:22.79,0:15:25.34,Default,,0,0,0,,Мен айттым! Мен айттым! Мен айттым!
Dialogue: 0,0:15:25.42,0:15:28.13,Default,,0,0,0,,‎Аа... Уф
Dialogue: 0,0:15:29.09,0:15:33.09,Default,,0,0,0,,Әже... Әже қайта қоңырау шалып жатыр...
Dialogue: 0,0:15:33.18,0:15:35.22,Default,,0,0,0,,‎(Kazane) Сакура-сан? Сакура-сан!
Dialogue: 0,0:15:35.30,0:15:40.39,Default,,0,0,0,,‎Әже әже...
Dialogue: 0,0:15:40.48,0:15:44.73,Default,,0,0,0,,(Әңгімелеу) Мен тағы да жарық шамдарын көрдім, ол Мику Сакура болды.
Dialogue: 0,0:15:46.73,0:15:49.03,Default,,0,0,0,,Түсіндім, Юкия. Сіз спорт мерекесіне не қатысасыз?
Dialogue: 0,0:15:49.11,0:15:52.11,Default,,0,0,0,,‎(Юкия) Иә? А... Мен әлі шешкен жоқпын.
Dialogue: 0,0:15:52.20,0:15:54.16,Default,,0,0,0,,Ақанмен және басқалармен тірек тауарларын жасайық
Dialogue: 0,0:15:54.24,0:15:56.53,Default,,0,0,0,,Біз сөйлесіп жатырмыз, бірақ Юкия бізге қосылса ше?
Dialogue: 0,0:15:56.62,0:15:58.87,Default,,0,0,0,,(Юкия) А? Сіз оны ұнатпаймын деп шештіңіз.
Dialogue: 0,0:15:58.95,0:16:01.41,Default,,0,0,0,,Мен қалай араласарымды білмеймін. Бұл қызықсыз.
Dialogue: 0,0:16:01.50,0:16:03.83,Default,,0,0,0,,Иә? Жарайды ма?
Dialogue: 0,0:16:03.92,0:16:07.34,Default,,0,0,0,,Мен тек Юкия үшін бірдеңе жасауды ойладым.
Dialogue: 0,0:16:07.42,0:16:08.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:10.67,0:16:13.34,Default,,0,0,0,,Юкия Юкия!
Dialogue: 0,0:16:13.43,0:16:14.59,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:16:14.68,0:16:18.81,Default,,0,0,0,,‎Хмф, таң қалдыңыз ба?
Dialogue: 0,0:16:18.89,0:16:21.52,Default,,0,0,0,,Сен ақымақсың ба? Сіз айналаңыздағылардың көздеріне алаңдайсыз, солай емес пе?
Dialogue: 0,0:16:21.60,0:16:23.23,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:23.31,0:16:24.73,Default,,0,0,0,,‎(Юкия) Жақсы емес пе?
Dialogue: 0,0:16:24.81,0:16:29.07,Default,,0,0,0,,‎(Хинако) О, мен қатты ашуландым!
Dialogue: 0,0:16:29.15,0:16:32.11,Default,,0,0,0,,Осы жерден қарасақ, бір-бірімізге әбден ғашық болсақ та.
Dialogue: 0,0:16:32.19,0:16:34.11,Default,,0,0,0,,Мен соншалықты уайымдағаныма сене алар емеспін
Dialogue: 0,0:16:34.20,0:16:36.53,Default,,0,0,0,,Сіз тезірек мойындауыңыз керек еді...
Dialogue: 0,0:16:36.62,0:16:39.37,Default,,0,0,0,,‎(Каюру) Хмм, бірақ.
Dialogue: 0,0:16:39.45,0:16:42.91,Default,,0,0,0,,‎Олардың бұлай қалмауы оларға тән.
Dialogue: 0,0:16:43.00,0:16:44.08,Default,,0,0,0,,‎Фу…
Dialogue: 0,0:16:44.16,0:16:45.54,Default,,0,0,0,,Екі адам үшін ойлан
Dialogue: 0,0:16:45.62,0:16:48.59,Default,,0,0,0,,Адасып, әрі қарай жүруге болмайды ма?
Dialogue: 0,0:16:48.67,0:16:51.71,Default,,0,0,0,,Бұл олардың жастық шағы.
Dialogue: 0,0:16:51.80,0:16:54.05,Default,,0,0,0,,‎(Хинако) Мұндай жастық туралы айту керек.
Dialogue: 0,0:16:54.13,0:16:56.01,Default,,0,0,0,,‎Ағадай~
Dialogue: 0,0:16:56.09,0:16:57.09,Default,,0,0,0,,‎(Каяру) Иә!
Dialogue: 0,0:16:57.18,0:17:00.81,Default,,0,0,0,,Бірақ иә... солай ма?
Dialogue: 0,0:17:08.65,0:17:12.86,Default,,0,0,0,,‎Уау, бірақ мен қатты ашуландым!
Dialogue: 0,0:17:33.34,0:17:36.01,Default,,0,0,0,,‎(Юкия) Мику мен сені жақсы көремін
Dialogue: 0,0:17:37.93,0:17:40.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.14,0:17:45.89,Default,,0,0,0,,Егер сіз мұны оңай айта алсаңыз, сізге күресудің қажеті жоқ еді.
Dialogue: 0,0:17:49.27,0:17:53.44,Default,,0,0,0,,Өйткені Мику мен үшін таптырмас адам.
Dialogue: 0,0:17:54.28,0:17:57.61,Default,,0,0,0,,‎Сондықтан мен сүйкімді Микудан жеңілдім
Dialogue: 0,0:17:57.70,0:17:59.99,Default,,0,0,0,,‎Мен ойынды жақсы көрсем де, мен жеңілемін
Dialogue: 0,0:18:00.74,0:18:03.33,Default,,0,0,0,,‎Біз кездесіп қалсақ та
Dialogue: 0,0:18:04.75,0:18:10.08,Default,,0,0,0,,Қазір жақсы болса да, ол бір күні теңгерімсіз болып, нашар болуы мүмкін.
Dialogue: 0,0:18:11.25,0:18:15.42,Default,,0,0,0,,‎Алдағы спорт фестивалі және жазғы демалыс
Dialogue: 0,0:18:24.39,0:18:28.89,Default,,0,0,0,,Мен сенің жүрегіңді елжірететін адам боламын.
Dialogue: 0,0:18:31.23,0:18:33.77,Default,,0,0,0,,‎(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:18:45.79,0:18:49.58,Default,,0,0,0,,Әжеге ұсынатын гүлдер жасайық!
Dialogue: 0,0:18:50.17,0:18:51.08,Default,,0,0,0,,Анықтама
Dialogue: 0,0:18:51.17,0:18:53.54,Default,,0,0,0,,(Юкия) Жоқ, жақсы, бірақ...
Dialogue: 0,0:18:53.63,0:18:55.84,Default,,0,0,0,,Әже де бақытты болады.
Dialogue: 0,0:18:55.92,0:18:58.97,Default,,0,0,0,,(Юкия) Екеуміз бұрыннан менің үйімде заттарды жинайтынбыз.
Dialogue: 0,0:18:59.05,0:19:01.64,Default,,0,0,0,,Иә, айтпақшы, бұл ай гортензия.
Dialogue: 0,0:19:02.39,0:19:03.72,Default,,0,0,0,,Гортензия
Dialogue: 0,0:19:03.80,0:19:05.43,Default,,0,0,0,,Ұлу мен жиын сүйкімді емес пе?
Dialogue: 0,0:19:05.51,0:19:07.52,Default,,0,0,0,,‎(Юкия) Гортензия улы.
Dialogue: 0,0:19:07.60,0:19:09.89,Default,,0,0,0,,Ұлулар онша көп емес сияқты.
Dialogue: 0,0:19:18.36,0:19:21.24,Default,,0,0,0,,‎Ах~ ‎Сен тағы да ренжітетін бірдеңе айтып тұрсың.
Dialogue: 0,0:19:21.32,0:19:23.99,Default,,0,0,0,,‎Жарайды, себебі ол сүйкімді.
Dialogue: 0,0:19:24.07,0:19:26.62,Default,,0,0,0,,‎Ааа, бейшара адамдық эго
Dialogue: 0,0:19:26.70,0:19:28.20,Default,,0,0,0,,‎Бұл улы емес!
Dialogue: 0,0:19:33.29,0:19:38.01,Default,,0,0,0,,‎(Мику ызылдайды)
Dialogue: 0,0:19:43.93,0:19:49.02,Default,,0,0,0,,‎
Dialogue: 0,0:19:49.10,0:19:51.69,Default,,0,0,0,,‎(Мұғалім: Баяндамашы) ‎Мектептен кететін уақыт келді.
Dialogue: 0,0:19:51.77,0:19:53.48,Default,,0,0,0,,Кампуста қалған студенттер
Dialogue: 0,0:19:53.56,0:19:57.15,Default,,0,0,0,,‎Әрекеттерді тоқтату ‎Мектептен шығуға дайындалыңыз
Dialogue: 0,0:19:57.23,0:19:58.98,Default,,0,0,0,,‎-Аа-(Юкия) Иә?
Dialogue: 0,0:19:59.07,0:20:01.32,Default,,0,0,0,,‎Ой, бұл ұзақ болды ма?
Dialogue: 0,0:20:01.40,0:20:03.41,Default,,0,0,0,,Бұл өте тез өтті.
Dialogue: 0,0:20:03.49,0:20:04.66,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:20:09.54,0:20:12.21,Default,,0,0,0,,‎Маған гортензия өте ұнайды.
Dialogue: 0,0:20:12.29,0:20:14.67,Default,,0,0,0,,‎(Юкия) Солай ма? Неліктен?
Dialogue: 0,0:20:14.75,0:20:18.13,Default,,0,0,0,,Ең жақсы көрінеді ‎Әдемі және әдемі
Dialogue: 0,0:20:25.68,0:20:29.77,Default,,0,0,0,,Түріне байланысты болғанымен, гүлдердің тілі де тамаша.
Dialogue: 0,0:20:29.85,0:20:31.18,Default,,0,0,0,,‎«Отбасы кездесуі»
Dialogue: 0,0:20:31.27,0:20:32.68,Default,,0,0,0,,‎(Юкия) Ах...
Dialogue: 0,0:20:32.77,0:20:34.90,Default,,0,0,0,,‎Бұл әже үшін өте қолайлы.
Dialogue: 0,0:20:37.15,0:20:38.77,Default,,0,0,0,,‎(Юкия) Ммм.
Dialogue: 0,0:20:38.86,0:20:41.74,Default,,0,0,0,,Иә, иә, түсінемін.
Dialogue: 0,0:20:41.82,0:20:42.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.74,0:20:44.32,Default,,0,0,0,,Басқаша айтқанда, менімен
Dialogue: 0,0:20:44.40,0:20:47.70,Default,,0,0,0,,«Мен отбасы болғым келеді» деген хабар болды ма?
Dialogue: 0,0:20:47.78,0:20:50.91,Default,,0,0,0,,Иә? А... Сен ақымақсың ба? Алып кетпеңіз!
Dialogue: 0,0:20:51.75,0:20:52.58,Default,,0,0,0,,‎(Юкия) Ал...
Dialogue: 0,0:20:54.87,0:20:59.59,Default,,0,0,0,,‎Менің ойымша, біз сенімен бір отбасы болғанымыз дұрыс болар еді.
Dialogue: 0,0:21:03.22,0:21:04.42,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:21:07.84,0:21:09.47,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:21:10.10,0:21:11.89,Default,,0,0,0,,А...
Dialogue: 0,0:21:12.56,0:21:14.81,Default,,0,0,0,,‎Ух... гуну...
Dialogue: 0,0:21:14.89,0:21:18.94,Default,,0,0,0,,‎Ал, біз отбасы болғанға дейін
Dialogue: 0,0:21:19.02,0:21:21.86,Default,,0,0,0,,Менің айтарым бар. Сіз білесіз.
Dialogue: 0,0:21:24.19,0:21:26.82,Default,,0,0,0,,‎Мен сені сүйемін, маған тұрмысқа шықшы!
Dialogue: 0,0:21:27.49,0:21:30.99,Default,,0,0,0,,Менің әкеме «Маған Мику-сан беріңізші»
Dialogue: 0,0:21:31.08,0:21:32.95,Default,,0,0,0,,‎(Юкия) Арх!
Dialogue: 0,0:21:33.04,0:21:35.12,Default,,0,0,0,,‎Күшік... Ахахаха!
Dialogue: 0,0:21:35.21,0:21:37.04,Default,,0,0,0,,‎Не, шын айтасың ба?
Dialogue: 0,0:21:37.12,0:21:38.88,Default,,0,0,0,,‎Сен мұны білесің бе? Сіз
Dialogue: 0,0:21:38.96,0:21:42.34,Default,,0,0,0,,(Юкия) Жоқ, бұл дұрыс емес! Тығыз...
Dialogue: 0,0:21:42.84,0:21:44.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:44.13,0:21:48.89,Default,,0,0,0,,Ал, біз осындай мәселелерді шешуіміз керек.
Dialogue: 0,0:21:49.93,0:21:51.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:55.73,0:21:56.81,Default,,0,0,0,,‎(Юкия) Мику
Dialogue: 0,0:22:09.20,0:22:10.74,Default,,0,0,0,,Мен де...
Dialogue: 0,0:22:13.16,0:22:15.54,Default,,0,0,0,,‎Мен сені жақсы көремін, Юкия!
Dialogue: 0,0:22:16.08,0:22:17.91,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.00,0:23:46.00,Default,,0,0,0,,～♪
