Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.13,0:00:09.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:32.50,0:01:34.51,Default,,0,0,0,,～♪
Dialogue: 0,0:01:48.98,0:01:52.27,Default,,0,0,0,,‎Ол бұзылды, сондықтан әрекетті қайталаңыз
Dialogue: 0,0:01:53.23,0:01:54.65,Default,,0,0,0,,‎(‎Юкия‎) Ах...
Dialogue: 0,0:01:55.74,0:01:58.20,Default,,0,0,0,,‎Жалғастыруды қалайсыз ба?
Dialogue: 0,0:02:00.62,0:02:02.20,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:02:02.28,0:02:03.62,Default,,0,0,0,,‎ (Жұтыну дыбысы)
Dialogue: 0,0:02:09.83,0:02:12.29,Default,,0,0,0,,(Юкия) Мику ештеңе ойламай ма?
Dialogue: 0,0:02:13.42,0:02:18.63,Default,,0,0,0,,‎Енді ойлап қарасам, ол қозғалғандай, Мику жағынан үзіліп кеткендей...
Dialogue: 0,0:02:19.47,0:02:24.89,Default,,0,0,0,,Жоқ, одан кейінгі реакцияға қарағанда, Мику да қатты таң қалды.
Dialogue: 0,0:02:25.68,0:02:28.31,Default,,0,0,0,,Сен мені сүйгің келмеген шығар.
Dialogue: 0,0:02:29.14,0:02:32.98,Default,,0,0,0,,Шынымен бе? Сонда неге жалғастыра бересің?
Dialogue: 0,0:02:33.57,0:02:38.07,Default,,0,0,0,,‎Мен жеңіліске төзе алмайтындықтан, бұл артқа кете алмайтынымды білдіре ме?
Dialogue: 0,0:02:40.28,0:02:44.37,Default,,0,0,0,,‎Күтілгендей, Мику бүгін біртүрлі әрекет етеді.
Dialogue: 0,0:02:46.12,0:02:47.75,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:03:29.95,0:03:31.04,Default,,0,0,0,,‎(тамақтану дыбысы)
Dialogue: 0,0:03:49.14,0:03:50.64,Default,,0,0,0,,А...
Dialogue: 0,0:03:51.52,0:03:53.44,Default,,0,0,0,,‎(Юкия) Ах...
Dialogue: 0,0:04:19.96,0:04:21.21,Default,,0,0,0,,‎(2 адам) Әй...
Dialogue: 0,0:04:27.64,0:04:33.31,Default,,0,0,0,,‎(тамақтану дыбысы)
Dialogue: 0,0:04:35.69,0:04:36.69,Default,,0,0,0,,‎(тамақтану дыбысы)
Dialogue: 0,0:04:49.20,0:04:53.66,Default,,0,0,0,,‎(тамақтану дыбысы)
Dialogue: 0,0:05:01.63,0:05:07.97,Default,,0,0,0,,‎(тамақтану дыбысы)
Dialogue: 0,0:05:21.69,0:05:22.82,Default,,0,0,0,,‎(Юкия) Ха...
Dialogue: 0,0:05:44.84,0:05:46.13,Default,,0,0,0,,‎(2 адам) Әй...
Dialogue: 0,0:05:47.13,0:05:52.14,Default,,0,0,0,,‎(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:06:04.44,0:06:06.03,Default,,0,0,0,,‎Мм...
Dialogue: 0,0:06:06.11,0:06:07.45,Default,,0,0,0,,‎(Юкия) Ах...
Dialogue: 0,0:06:10.70,0:06:12.20,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:06:39.81,0:06:41.23,Default,,0,0,0,,‎(Юкия) Өзгерту
Dialogue: 0,0:06:42.94,0:06:44.15,Default,,0,0,0,,Бірдеңе
Dialogue: 0,0:06:45.19,0:06:48.65,Default,,0,0,0,,Мен бұған сенімді болдым
Dialogue: 0,0:06:58.96,0:07:00.37,Default,,0,0,0,,‎(Юкия) жасады...
Dialogue: 0,0:07:00.46,0:07:05.55,Default,,0,0,0,,Микуто ақыры сүйді
Dialogue: 0,0:07:06.67,0:07:12.51,Default,,0,0,0,,‎Бұл маған шынымен ұнайтынын білдіреді, солай ма?
Dialogue: 0,0:07:15.51,0:07:16.64,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:18.02,0:07:21.64,Default,,0,0,0,,Бұл әдеттегіден ерекше болды.
Dialogue: 0,0:07:22.23,0:07:25.52,Default,,0,0,0,,‎Бұл мен жақсы көретін ойын болса да
Dialogue: 0,0:07:25.61,0:07:27.90,Default,,0,0,0,,Мен мұндай нәрсені жасайтын адам емеспін.
Dialogue: 0,0:07:38.54,0:07:40.00,Default,,0,0,0,,Әже
Dialogue: 0,0:07:40.62,0:07:44.96,Default,,0,0,0,,Мен Юкияны бірінші рет сүйдім
Dialogue: 0,0:07:46.34,0:07:49.09,Default,,0,0,0,,Алғашында ерніме қатты тиді.
Dialogue: 0,0:07:49.17,0:07:50.84,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:07:50.92,0:07:53.76,Default,,0,0,0,,Батылдық танытып, қайталаңыз...
Dialogue: 0,0:07:54.30,0:07:58.35,Default,,0,0,0,,Сосын Юкия да мені сүйді.
Dialogue: 0,0:07:59.85,0:08:03.48,Default,,0,0,0,,‎Бұл бет әрине қызықты болды, солай емес пе?
Dialogue: 0,0:08:03.56,0:08:05.56,Default,,0,0,0,,‎Сен маған ғашық болғың келмей ме?
Dialogue: 0,0:08:06.11,0:08:09.40,Default,,0,0,0,,Сіз бұл туралы білгеніңізге сенімдімін.
Dialogue: 0,0:08:21.25,0:08:24.87,Default,,0,0,0,,Юкия мұны істемесе де.
Dialogue: 0,0:08:26.29,0:08:30.46,Default,,0,0,0,,Мен сүйдім...
Dialogue: 0,0:08:31.80,0:08:34.30,Default,,0,0,0,,Мен оны сол кезде білсем де
Dialogue: 0,0:08:36.43,0:08:39.31,Default,,0,0,0,,Ақанның өзіне бұлай айтқан жоқпын.
Dialogue: 0,0:08:39.85,0:08:40.68,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:42.06,0:08:42.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:43.56,0:08:46.19,Default,,0,0,0,,‎(Куромику) ‎Сен неге мені көрсетпейсің?
Dialogue: 0,0:08:48.40,0:08:50.19,Default,,0,0,0,,‎-(Қара Мику) Мен қалаймын ‎-(Ақ Мику) Жоқ
Dialogue: 0,0:08:51.48,0:08:53.99,Default,,0,0,0,,‎-(Қара Мику) Мен қалаймын ‎-(Ақ Мику) Мүлдем жоқ
Dialogue: 0,0:08:54.07,0:08:55.82,Default,,0,0,0,,‎(Kuromiku) Қазір
Dialogue: 0,0:08:58.37,0:08:59.66,Default,,0,0,0,,‎Ең нашар…
Dialogue: 0,0:09:00.87,0:09:05.12,Default,,0,0,0,,Неліктен мен соншалықты кесірім жоқпын?
Dialogue: 0,0:09:13.30,0:09:15.34,Default,,0,0,0,,(Оқушы қыз) үшінмыз доджбол ойнайық
Dialogue: 0,0:09:15.42,0:09:17.68,Default,,0,0,0,,‎-(Студент қыз) Жасай бер! -(Оқушы қыз) Жаса, істе!
Dialogue: 0,0:09:17.76,0:09:19.30,Default,,0,0,0,,‎(Студент қыз) Сакура-сан ше?
Dialogue: 0,0:09:19.39,0:09:22.43,Default,,0,0,0,,Иә? мм... мм
Dialogue: 0,0:09:23.02,0:09:25.94,Default,,0,0,0,,Мен бақыттымын, бірақ доджболда нашармын.
Dialogue: 0,0:09:26.02,0:09:29.44,Default,,0,0,0,,Мен кірсем де, оны жалықтырамын.
Dialogue: 0,0:09:29.52,0:09:32.69,Default,,0,0,0,,‎Мен... мен жақсымын.
Dialogue: 0,0:09:33.73,0:09:37.24,Default,,0,0,0,,‎Аа... түсіндім. Кешіріңіз.
Dialogue: 0,0:09:37.32,0:09:38.66,Default,,0,0,0,,Жүрейік?
Dialogue: 0,0:09:38.74,0:09:42.54,Default,,0,0,0,,(Студент қыз) Сакура-сан, сен ешқашан келмейсің, солай емес пе?
Dialogue: 0,0:09:46.29,0:09:48.12,Default,,0,0,0,,‎(Юкия) Ах, Сакура
Dialogue: 0,0:09:48.79,0:09:50.38,Default,,0,0,0,,‎Асаги-кун
Dialogue: 0,0:09:51.88,0:09:53.13,Default,,0,0,0,,‎-(Юкия) Хмм ‎-Иә?
Dialogue: 0,0:09:53.21,0:09:55.84,Default,,0,0,0,,Кешіріңіз, рахмет
Dialogue: 0,0:09:55.92,0:09:58.09,Default,,0,0,0,,‎(2 адам) Жақсы ату
Dialogue: 0,0:09:59.30,0:10:00.80,Default,,0,0,0,,‎(Студент қыз) Сакура-сан
Dialogue: 0,0:10:01.68,0:10:04.31,Default,,0,0,0,,Шелек туралы Оны өзіңіз алып жүргеніңіз дұрыс.
Dialogue: 0,0:10:04.39,0:10:06.14,Default,,0,0,0,,‎(Студент қыз) ‎Әркімде бұл бар.
Dialogue: 0,0:10:06.23,0:10:09.02,Default,,0,0,0,,‎Ой... Кешіріңіз.
Dialogue: 0,0:10:14.23,0:10:17.57,Default,,0,0,0,,‎(Мику жылайды)
Dialogue: 0,0:10:21.82,0:10:22.66,Default,,0,0,0,,(Микудың әжесі) Жылама, Мику-чан
Dialogue: 0,0:10:22.66,0:10:24.49,Default,,0,0,0,,(Микудың әжесі) Жылама, Мику-чан
Dialogue: 0,0:10:22.66,0:10:24.49,Default,,0,0,0,,(Мику жылайды)
Dialogue: 0,0:10:24.49,0:10:26.95,Default,,0,0,0,,(Мику жылайды)
Dialogue: 0,0:10:27.04,0:10:31.63,Default,,0,0,0,,Күлімсіресең, Аспанға жан тыныштығын берем.
Dialogue: 0,0:10:31.71,0:10:34.21,Default,,0,0,0,,‎Онда сен үнемі жылайсың.
Dialogue: 0,0:10:34.30,0:10:37.80,Default,,0,0,0,,Мен уайымдап, осында қалдым.
Dialogue: 0,0:10:38.42,0:10:42.14,Default,,0,0,0,,Әжем кеткенде, мен...
Dialogue: 0,0:10:42.22,0:10:46.89,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:10:51.65,0:10:54.44,Default,,0,0,0,,Мен әжемді тағы да ұятқа қалдырамын.
Dialogue: 0,0:10:57.11,0:10:58.94,Default,,0,0,0,,(Ер оқушы) Асаги қыз алып келді.
Dialogue: 0,0:10:59.03,0:11:01.32,Default,,0,0,0,,(Юкия) Жақсы, біз доспыз.
Dialogue: 0,0:11:01.41,0:11:03.45,Default,,0,0,0,,‎Жарайды, Мицухаши және басқалары.
Dialogue: 0,0:11:03.53,0:11:05.20,Default,,0,0,0,,(Ер оқушы) Бұл балалар ойын ойнап отырды.
Dialogue: 0,0:11:05.28,0:11:07.16,Default,,0,0,0,,Ол маған рұқсатсыз келді.
Dialogue: 0,0:11:08.70,0:11:12.21,Default,,0,0,0,,Асаги-кун, жақсы. Менде ойын жоқ.
Dialogue: 0,0:11:12.29,0:11:13.17,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:14.88,0:11:16.09,Default,,0,0,0,,А...
Dialogue: 0,0:11:17.13,0:11:18.84,Default,,0,0,0,,(Ер оқушы) Жарайды, олар өте көп.
Dialogue: 0,0:11:18.92,0:11:20.09,Default,,0,0,0,,‎Тегті ойнағыңыз келе ме?
Dialogue: 0,0:11:20.17,0:11:21.43,Default,,0,0,0,,‎(Ер студент) О, жақсы.
Dialogue: 0,0:11:21.51,0:11:24.85,Default,,0,0,0,,‎Олай болса сен жынсың. Сен кейін келдің.
Dialogue: 0,0:11:24.93,0:11:28.10,Default,,0,0,0,,‎Онда мен де істеймін. Мен кейінірек келдім.
Dialogue: 0,0:11:28.18,0:11:30.89,Default,,0,0,0,,‎(Ер студент) Иә? Екі адамды алатыны алдау емес пе?
Dialogue: 0,0:11:30.98,0:11:32.69,Default,,0,0,0,,‎О, шу!
Dialogue: 0,0:11:32.77,0:11:33.94,Default,,0,0,0,,У.А. орта мектебі, 1-курс А және Б сыныптары—
Dialogue: 0,0:11:34.02,0:11:34.94,Default,,0,0,0,,１ ２ ３ ４ ５…
Dialogue: 0,0:11:34.94,0:11:38.28,Default,,0,0,0,,１ ２ ３ ４ ５…
Dialogue: 0,0:11:34.94,0:11:38.28,Default,,0,0,0,,‎-(Студент қыз) Шынымен! -(Ер оқушы) Ахаха...
Dialogue: 0,0:11:38.28,0:11:38.36,Default,,0,0,0,,１ ２ ３ ４ ５…
Dialogue: 0,0:11:38.36,0:11:40.07,Default,,0,0,0,,１ ２ ３ ４ ５…
Dialogue: 0,0:11:38.36,0:11:40.07,Default,,0,0,0,,‎О, бұл қауіпті, қаш!
Dialogue: 0,0:11:40.15,0:11:42.15,Default,,0,0,0,,‎Сакура Мен қысқышпен шабуыл жасаймын!
Dialogue: 0,0:11:42.24,0:11:44.03,Default,,0,0,0,,Ух... иә!
Dialogue: 0,0:11:45.24,0:11:46.99,Default,,0,0,0,,- (Юкия) Айналайын! -Иә!
Dialogue: 0,0:11:47.08,0:11:49.50,Default,,0,0,0,,‎-(Юкия) Хэхе ‎-(Ер студент) Ахахаха
Dialogue: 0,0:11:49.58,0:11:52.29,Default,,0,0,0,,‎-Жақсысың ба? -(Юкия) Хаха, менің қолымнан келеді!
Dialogue: 0,0:11:53.00,0:11:55.04,Default,,0,0,0,,‎-(Ер студент) Сіз кешіктіңіз! -(Юкия) Күте тұрыңыз...
Dialogue: 0,0:11:55.13,0:11:57.00,Default,,0,0,0,,‎(үшін қолдайды)
Dialogue: 0,0:11:57.09,0:11:59.71,Default,,0,0,0,,‎(Юкия)... Мен мүлдем ұсталмаймын.
Dialogue: 0,0:11:59.80,0:12:03.01,Default,,0,0,0,,(Ер оқушы) Айтайын дегенім, екеуі де тым баяу.
Dialogue: 0,0:12:03.09,0:12:05.80,Default,,0,0,0,,(Оқушы қыз) Мен оны аяй бастадым деп ойлаймын.
Dialogue: 0,0:12:05.89,0:12:10.60,Default,,0,0,0,,‎Ха ха ха…
Dialogue: 0,0:12:10.68,0:12:13.44,Default,,0,0,0,,үшін жылдам.
Dialogue: 0,0:12:13.52,0:12:15.06,Default,,0,0,0,,(Студенттер) Иә?
Dialogue: 0,0:12:15.15,0:12:18.27,Default,,0,0,0,,‎Неге күлесің? Бұл біртүрлі
Dialogue: 0,0:12:20.19,0:12:25.07,Default,,0,0,0,,Өйткені барлығымен ойнау қызық.
Dialogue: 0,0:12:25.16,0:12:26.66,Default,,0,0,0,,‎(Студенттер) Ах...
Dialogue: 0,0:12:31.20,0:12:33.62,Default,,0,0,0,,‎(Студент қыз) Сакура-сан ‎Сен де ертең менімен ойнағың келе ме?
Dialogue: 0,0:12:33.71,0:12:37.25,Default,,0,0,0,,‎Е... Бірақ бұл ыңғайсыздық емес пе?
Dialogue: 0,0:12:37.33,0:12:41.05,Default,,0,0,0,,‎Е~ Неге? Жарайды
Dialogue: 0,0:12:41.13,0:12:42.30,Default,,0,0,0,,‎Ей, ойнайық
Dialogue: 0,0:12:44.55,0:12:45.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:45.55,0:12:48.47,Default,,0,0,0,,‎-(Студент қыз) Кездескенше ‎-(Студент қыз) Сау болыңыз
Dialogue: 0,0:12:48.55,0:12:51.14,Default,,0,0,0,,Мен достар тапқаныма қуаныштымын.
Dialogue: 0,0:12:51.22,0:12:53.35,Default,,0,0,0,,‎Ух... Иә, рахмет
Dialogue: 0,0:12:54.52,0:12:56.56,Default,,0,0,0,,(Юкия) Мен әрқашан солай ойлайтынмын.
Dialogue: 0,0:12:57.23,0:13:00.94,Default,,0,0,0,,Сіз күлгенде сүйкімді болып көрінесіз
Dialogue: 0,0:13:01.78,0:13:03.57,Default,,0,0,0,,А...
Dialogue: 0,0:13:05.32,0:13:07.87,Default,,0,0,0,,Мен сізден көбірек айтқым келеді
Dialogue: 0,0:13:08.70,0:13:09.99,Default,,0,0,0,,Өзгеруі керек
Dialogue: 0,0:13:11.12,0:13:14.62,Default,,0,0,0,,Мәңгілік Асаги-кунның қасында болу.
Dialogue: 0,0:13:19.13,0:13:20.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:21.34,0:13:24.42,Default,,0,0,0,,‎Ол қазір мүлде сүйкімді емес.
Dialogue: 0,0:13:25.80,0:13:29.76,Default,,0,0,0,,‎Сен мақұлдауға ықыласыңды беріп, мені сүйіп шақырдың
Dialogue: 0,0:13:29.85,0:13:31.60,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:13:32.31,0:13:34.06,Default,,0,0,0,,Бұл ең нашар болса да
Dialogue: 0,0:13:36.73,0:13:38.19,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:13:40.69,0:13:42.73,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:13:46.90,0:13:48.45,Default,,0,0,0,,Сүйкімді емес
Dialogue: 0,0:13:50.83,0:13:53.08,Default,,0,0,0,,‎Сүйкімді емес Сүйкімді емес
Dialogue: 0,0:13:56.08,0:13:58.71,Default,,0,0,0,,‎Бұл шынымен сүйкімді емес!
Dialogue: 0,0:14:03.55,0:14:06.80,Default,,0,0,0,,‎Мен өзімнің соншалықты сүйкімді екеніме сене алар емеспін
Dialogue: 0,0:14:06.88,0:14:10.34,Default,,0,0,0,,‎Сен маған ештеңе айта алмайсың. Бұл табиғи...
Dialogue: 0,0:14:15.85,0:14:19.52,Default,,0,0,0,,Мен Юкияның мәңгі қасымда болғанын қалаймын.
Dialogue: 0,0:14:19.60,0:14:23.02,Default,,0,0,0,,Мен сүйкімді болуым керек...
Dialogue: 0,0:14:34.37,0:14:36.04,Default,,0,0,0,,‎Сен күлгенде сүйкімді көрінесің
Dialogue: 0,0:14:45.50,0:14:47.26,Default,,0,0,0,,‎(Есіктің ашылу/жабылу дыбысы) ‎(Есік қоңырауының дыбысы)
Dialogue: 0,0:14:48.59,0:14:50.09,Default,,0,0,0,,‎(Хинако) Юкки!
Dialogue: 0,0:14:51.01,0:14:52.26,Default,,0,0,0,,‎Usu...
Dialogue: 0,0:14:52.85,0:14:54.14,Default,,0,0,0,,‎(Хинако) Иә?
Dialogue: 0,0:14:55.64,0:14:58.93,Default,,0,0,0,,‎Мм... жабылатын уақыт болды ғой, солай емес пе?
Dialogue: 0,0:14:59.02,0:15:00.23,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:15:00.31,0:15:03.61,Default,,0,0,0,,‎(Каору) Жарайды. Хинако-кунның шағымдарын тыңдаңыз.
Dialogue: 0,0:15:03.69,0:15:07.28,Default,,0,0,0,,Иә, бұл торт менікі.
Dialogue: 0,0:15:07.36,0:15:09.24,Default,,0,0,0,,‎(Юкия) Рахмет
Dialogue: 0,0:15:12.78,0:15:14.87,Default,,0,0,0,,‎Эй, Юкки, мені тыңда.
Dialogue: 0,0:15:14.95,0:15:17.29,Default,,0,0,0,,Мен кеше тағы да тыңдаудан өте алмадым.
Dialogue: 0,0:15:17.37,0:15:20.29,Default,,0,0,0,,‎(Юкия) А... кеше айттыңыз ба, сіз веб-анименің актерысыз ба?
Dialogue: 0,0:15:20.37,0:15:24.34,Default,,0,0,0,,‎(Хинако) Иә! Бұл үлкен мүмкіндік болды, сондықтан мен көп жаттықтым.
Dialogue: 0,0:15:24.42,0:15:27.00,Default,,0,0,0,,‎Аа... қиын, солай емес пе?
Dialogue: 0,0:15:27.09,0:15:30.22,Default,,0,0,0,,Маған Хинаконың ешбір жақтылықсыз дауысы ұнайды.
Dialogue: 0,0:15:30.30,0:15:33.26,Default,,0,0,0,,‎Рахмет, Юкки.
Dialogue: 0,0:15:33.34,0:15:35.10,Default,,0,0,0,,Сіз менімен ойнай аласыз ба?
Dialogue: 0,0:15:35.18,0:15:37.72,Default,,0,0,0,,Олай болса, мен саған басқа түсті Пети Мон берейін бе?
Dialogue: 0,0:15:37.81,0:15:38.64,Default,,0,0,0,,Бұл өте сирек.
Dialogue: 0,0:15:38.72,0:15:41.31,Default,,0,0,0,,‎Уау, бұл маған керек емес.
Dialogue: 0,0:15:54.28,0:15:58.20,Default,,0,0,0,,(Юкия) Мм... Мен де біраз уайымдап тұрмын.
Dialogue: 0,0:15:59.04,0:16:00.00,Default,,0,0,0,,‎
Dialogue: 0,0:16:00.08,0:16:01.41,Default,,0,0,0,,‎(Каяру) Иә? ше?
Dialogue: 0,0:16:02.54,0:16:06.34,Default,,0,0,0,,(Юкия) Микуно, мен сенің не ойлап тұрғаныңды түсінбеймін.
Dialogue: 0,0:16:06.42,0:16:08.05,Default,,0,0,0,,Бұл…
Dialogue: 0,0:16:08.75,0:16:11.92,Default,,0,0,0,,‎Сіз кенеттен өзіне тән емес нәрсе жасадыңыз.
Dialogue: 0,0:16:12.59,0:16:15.89,Default,,0,0,0,,Сіз өте байсалды көріндіңіз.
Dialogue: 0,0:16:16.55,0:16:19.14,Default,,0,0,0,,Менің де жаман жақтарым болды.
Dialogue: 0,0:16:19.22,0:16:23.89,Default,,0,0,0,,Бірақ соған қарамастан, біздің істеп жатқан ісіміз сәйкес келмейді...
Dialogue: 0,0:16:24.73,0:16:29.40,Default,,0,0,0,,Бұл сүйісу әдейі емес пе еді?
Dialogue: 0,0:16:30.15,0:16:33.61,Default,,0,0,0,,Негізі, мен сенің бұлай істегеніңді қаламадым...
Dialogue: 0,0:16:33.70,0:16:35.16,Default,,0,0,0,,Оның тоқтағанын қаламайсыз ба?
Dialogue: 0,0:16:35.99,0:16:39.99,Default,,0,0,0,,Бірақ егер сіз Микуниге осындай әрекет жасасаңыз, оны тоқтата алмайсыз.
Dialogue: 0,0:16:42.00,0:16:45.33,Default,,0,0,0,,Жоқ, Мику бірдеңе дұрыс емес екенін білді.
Dialogue: 0,0:16:46.21,0:16:48.25,Default,,0,0,0,,‎Мен кінәлімін сыпырылып кеткеніме
Dialogue: 0,0:16:49.04,0:16:52.92,Default,,0,0,0,,‎Тек сылтаулар, салқын емес
Dialogue: 0,0:16:55.22,0:16:57.59,Default,,0,0,0,,Мен не істеуім керек еді?
Dialogue: 0,0:16:57.68,0:17:01.60,Default,,0,0,0,,‎Мику әлі не іздейді?
Dialogue: 0,0:17:01.68,0:17:03.52,Default,,0,0,0,,‎Қандай жауап дұрыс?
Dialogue: 0,0:17:04.06,0:17:06.73,Default,,0,0,0,,Мен көп нәрсе туралы ойлаймын.
Dialogue: 0,0:17:11.90,0:17:14.19,Default,,0,0,0,,‎(Каюру) Дұрыс жауап қайсы?
Dialogue: 0,0:17:14.78,0:17:17.49,Default,,0,0,0,,Сіз не істегіңіз келеді деп ойлайсыз?
Dialogue: 0,0:17:18.07,0:17:21.95,Default,,0,0,0,,Мен Микудың әңгімесін тыңдағым келеді
Dialogue: 0,0:17:24.16,0:17:25.71,Default,,0,0,0,,‎(Каюру) Жасөспірімдік шақ
Dialogue: 0,0:17:25.79,0:17:30.17,Default,,0,0,0,,‎Әсіресе, қыздарда бір-бірінің үстінде орналасқан бірнеше эмоциялар бар.
Dialogue: 0,0:17:30.79,0:17:32.92,Default,,0,0,0,,Сол миль-фелье сияқты
Dialogue: 0,0:17:33.84,0:17:38.39,Default,,0,0,0,,Оның өзі де пайда болған эмоцияны жақсы жеткізе алмайды.
Dialogue: 0,0:17:38.47,0:17:40.97,Default,,0,0,0,,‎Кейде бәрін ұстай алмай, жаншып қаламын.
Dialogue: 0,0:17:41.05,0:17:44.85,Default,,0,0,0,,‎Осылайша ақырын тығылыңыз.
Dialogue: 0,0:17:44.93,0:17:47.06,Default,,0,0,0,,‎Мен сезімімді реттегенше.
Dialogue: 0,0:17:57.53,0:17:59.82,Default,,0,0,0,,‎(Хинако) Қараңызшы, балмұздақ еріп жатыр.
Dialogue: 0,0:17:59.91,0:18:01.45,Default,,0,0,0,,‎(Юкия) А... иә.
Dialogue: 0,0:18:01.53,0:18:02.95,Default,,0,0,0,,‎Итадакимасу
Dialogue: 0,0:18:09.50,0:18:10.79,Default,,0,0,0,,‎(Вакана) Брат!
Dialogue: 0,0:18:10.88,0:18:13.55,Default,,0,0,0,,Менің спортзалға арналған киімім қайда?
Dialogue: 0,0:18:13.63,0:18:15.84,Default,,0,0,0,,(Юкия) Кірді шығарған жоқсың ғой?
Dialogue: 0,0:18:15.92,0:18:17.47,Default,,0,0,0,,Мен оны кептіргішке қойдым.
Dialogue: 0,0:18:17.55,0:18:18.68,Default,,0,0,0,,Мен қазір кетемін!
Dialogue: 0,0:18:19.72,0:18:20.64,Default,,0,0,0,,‎(Вакана) Иә, әлі барасың ба?
Dialogue: 0,0:18:20.64,0:18:21.68,Default,,0,0,0,,‎(Вакана) Иә, әлі барасың ба?
Dialogue: 0,0:18:20.64,0:18:21.68,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:21.68,0:18:23.26,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:28.14,0:18:29.23,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:30.81,0:18:33.27,Default,,0,0,0,,‎
Dialogue: 0,0:18:37.40,0:18:39.99,Default,,0,0,0,,‎
Dialogue: 0,0:18:41.16,0:18:44.20,Default,,0,0,0,,‎(Юкия) Сен сонда бардың ба?
Dialogue: 0,0:18:44.28,0:18:48.29,Default,,0,0,0,,(Ұялы телефон қоңырау үні)
Dialogue: 0,0:18:56.55,0:18:57.55,Default,,0,0,0,,‎(Түрту дыбысы)
Dialogue: 0,0:18:58.30,0:18:59.47,Default,,0,0,0,,‎(Юкияның күрсінуі)
Dialogue: 0,0:19:01.34,0:19:05.35,Default,,0,0,0,,‎
Dialogue: 0,0:19:13.77,0:19:15.32,Default,,0,0,0,,‎(Юкия) Мику?
Dialogue: 0,0:19:45.26,0:19:46.56,Default,,0,0,0,,‎(Юкия) Ммм...
Dialogue: 0,0:19:48.60,0:19:50.77,Default,,0,0,0,,‎Аа... бұл
Dialogue: 0,0:19:50.85,0:19:53.31,Default,,0,0,0,,‎(Нацуки) Иә? Ах, э...
Dialogue: 0,0:19:53.40,0:19:55.61,Default,,0,0,0,,Иә! Асаги-кун? Не болды?
Dialogue: 0,0:19:55.69,0:19:57.73,Default,,0,0,0,,‎Менімен сөйлесетін адам сирек!
Dialogue: 0,0:19:57.82,0:20:00.49,Default,,0,0,0,,‎(Юкия) ‎Аа, уһ, иә, у...
Dialogue: 0,0:20:02.45,0:20:06.20,Default,,0,0,0,,‎Мику, сен бүгін не болғанын білесің бе...
Dialogue: 0,0:20:06.78,0:20:10.00,Default,,0,0,0,,Иә? Мику: қызуым көтеріліп тұр, мен демалайын.
Dialogue: 0,0:20:10.08,0:20:11.50,Default,,0,0,0,,Бүгін таңертең маған қоңырау келді...
Dialogue: 0,0:20:11.58,0:20:15.54,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:20:15.63,0:20:17.92,Default,,0,0,0,,Асаги-кун, естімедің бе?
Dialogue: 0,0:20:18.00,0:20:19.80,Default,,0,0,0,,Иә
Dialogue: 0,0:20:19.88,0:20:23.72,Default,,0,0,0,,Қоңырау шалсам да жауап болмады...
Dialogue: 0,0:20:23.80,0:20:25.55,Default,,0,0,0,,А...
Dialogue: 0,0:20:25.64,0:20:28.93,Default,,0,0,0,,Асаги-кунның телефон қоңырауларына жауап бермей жатқаныңызға сене алар емеспін.
Dialogue: 0,0:20:29.01,0:20:30.31,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:20:30.97,0:20:32.89,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:20:32.98,0:20:35.69,Default,,0,0,0,,Микуни, бірдеңе болды ма?
Dialogue: 0,0:20:35.77,0:20:38.57,Default,,0,0,0,,‎(Юкия) А... жоқ, мүмкін олай емес шығар.
Dialogue: 0,0:20:38.65,0:20:40.15,Default,,0,0,0,,‎(Түрту дыбысы)
Dialogue: 0,0:20:40.23,0:20:44.07,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:20:44.15,0:20:46.57,Default,,0,0,0,,Накчан? Не болды...
Dialogue: 0,0:20:46.66,0:20:48.58,Default,,0,0,0,,‎Мими… Мику! Амансың ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:48.66,0:20:51.12,Default,,0,0,0,,‎Жедел жәрдем шақыру керек пе? Қоңырау шалайық! Мен сізге қоңырау шаламын!
Dialogue: 0,0:20:51.20,0:20:54.87,Default,,0,0,0,,Иә? Күте тұрыңыз... Не? ше?
Dialogue: 0,0:20:54.96,0:20:56.63,Default,,0,0,0,,‎Жарайды, жарайды
Dialogue: 0,0:20:56.71,0:21:01.71,Default,,0,0,0,,Менің қызуым аздап тұр, ертең сабаққа бара аламын деп ойлаймын.
Dialogue: 0,0:21:01.80,0:21:06.26,Default,,0,0,0,,‎(Нацуки) Түсінемін. Бұл жақсы.
Dialogue: 0,0:21:06.34,0:21:07.76,Default,,0,0,0,,‎Асаги Кимигаса
Dialogue: 0,0:21:07.84,0:21:11.39,Default,,0,0,0,,‎Сен Мику үшін қатты уайымдағаның сонша, сен менімен сөйлесе бастадың.
Dialogue: 0,0:21:11.47,0:21:12.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:12.39,0:21:13.60,Default,,0,0,0,,‎(Нацуки) Мына Асаги-кун!
Dialogue: 0,0:21:13.68,0:21:16.65,Default,,0,0,0,,А... Иә, түсіндім.
Dialogue: 0,0:21:16.73,0:21:19.56,Default,,0,0,0,,Кешіріңіз, кешіріңіз, бәрі жақсы деп айтыңыз.
Dialogue: 0,0:21:19.65,0:21:22.07,Default,,0,0,0,,‎Иә, түсінемін, абайлаңыз.
Dialogue: 0,0:21:22.15,0:21:22.99,Default,,0,0,0,,‎(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:21:23.07,0:21:26.07,Default,,0,0,0,,‎Асаги-кун Мику аман қалды...
Dialogue: 0,0:21:27.66,0:21:28.87,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:21:28.95,0:21:31.49,Default,,0,0,0,,‎Е... Асаги-кун?
Dialogue: 0,0:21:38.75,0:21:42.00,Default,,0,0,0,,‎(Юкия) Ол, не болды?
Dialogue: 0,0:21:43.46,0:21:44.84,Default,,0,0,0,,Сол дауыс
Dialogue: 0,0:21:46.43,0:21:48.72,Default,,0,0,0,,‎Бұл мен көп жылағаннан кейін естіген дауыс еді.
Dialogue: 0,0:21:50.85,0:21:53.22,Default,,0,0,0,,Мен ол жігітпін
Dialogue: 0,0:21:55.93,0:21:57.52,Default,,0,0,0,,Мен сені жылаттым
Dialogue: 0,0:22:00.98,0:22:02.82,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:30.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.41,0:23:36.95,Default,,0,0,0,,‎(Вакана) Менің ағам жүгіре бастады!
Dialogue: 0,0:23:37.04,0:23:39.45,Default,,0,0,0,,Келесі жолы «Мен жақсы көретін ойынды аяқтағым келеді»
Dialogue: 0,0:23:39.54,0:23:41.33,Default,,0,0,0,,«Балалық шақтағы достары құшақтасады»
Dialogue: 0,0:23:41.42,0:23:44.04,Default,,0,0,0,,‎Жүгір, жүгір, ағайын!
Dialogue: 0,0:23:45.54,0:23:51.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
