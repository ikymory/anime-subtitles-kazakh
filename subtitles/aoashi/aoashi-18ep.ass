Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:04.87,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:05.71,0:00:07.29,Default,,0,0,0,,Осы санаттағы ойыншылар:⸺
Dialogue: 0,0:00:07.38,0:00:10.09,Default,,0,0,0,,Мұны істеу оңай, өйткені ол автоматты түрде жауды қорқытады.
Dialogue: 0,0:00:10.17,0:00:10.92,Default,,0,0,0,,Фуфу
Dialogue: 0,0:00:11.55,0:00:13.09,Default,,0,0,0,,Йошицүнэ-сан (Йошицүнэ) О?
Dialogue: 0,0:00:14.47,0:00:16.39,Default,,0,0,0,,Маған мақсат етпеуін айтпа.
Dialogue: 0,0:00:17.01,0:00:20.06,Default,,0,0,0,,Мен... Сіздің ойыныңызға ғашық болдым.
Dialogue: 0,0:00:20.72,0:00:23.14,Default,,0,0,0,,Менен баспалдақ туралы сұраса да, мен...
Dialogue: 0,0:00:24.81,0:00:28.36,Default,,0,0,0,,Аои Моджао-кун, мен саған арнайы бірдеңе айтайын.
Dialogue: 0,0:00:28.94,0:00:30.86,Default,,0,0,0,,Менің футбол өмірімде бүгінге дейін⸺
Dialogue: 0,0:00:31.07,0:00:34.07,Default,,0,0,0,,Кішкене қызғаншақ бір ғана адам болды.
Dialogue: 0,0:00:34.57,0:00:35.66,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:00:35.91,0:00:37.20,Default,,0,0,0,,Ши...қызғаныш па?
Dialogue: 0,0:00:38.49,0:00:39.16,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:00:40.91,0:00:41.79,Default,,0,0,0,,Дұрыс — оған рахмет.
Dialogue: 0,0:00:43.46,0:00:45.37,Default,,0,0,0,,Курибаяши Тогетоге-кун
Dialogue: 0,0:00:46.12,0:00:48.29,Default,,0,0,0,,Сен оған ұқсайсың, Нарья.
Dialogue: 0,0:00:48.59,0:00:50.67,Default,,0,0,0,,Демек, Ойрадан мүлде бөлек.
Dialogue: 0,0:00:51.05,0:00:52.84,Default,,0,0,0,,Олар ұқсас па? Курибаяшимен бе?
Dialogue: 0,0:00:53.47,0:00:54.42,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:00:55.22,0:00:59.76,Default,,0,0,0,,Соңғы бір айда мен Курибаяши сияқты қатты жаттығып жүрмін...
Dialogue: 0,0:01:00.43,0:01:03.43,Default,,0,0,0,,Жақсы, Китерецу Бұл жақсы.
Dialogue: 0,0:01:04.14,0:01:06.81,Default,,0,0,0,,Мен басқаларға қарағанда гол соға алатыныма сенімдімін⸺
Dialogue: 0,0:01:07.73,0:01:10.19,Default,,0,0,0,,11 адамның біреуі ғана
Dialogue: 0,0:01:10.65,0:01:12.57,Default,,0,0,0,,Бірақ Курибаяши ондай емес.
Dialogue: 0,0:01:12.90,0:01:14.61,Default,,0,0,0,,О, бұл жиіркенішті.
Dialogue: 0,0:01:16.32,0:01:19.07,Default,,0,0,0,,Курибаяшиге ұқсайтын можа адам
Dialogue: 0,0:01:19.62,0:01:23.04,Default,,0,0,0,,Сіз аздап қызғаншақсыз.
Dialogue: 0,0:01:23.41,0:01:24.54,Default,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:01:24.75,0:01:26.08,Default,,0,0,0,,Қызғаныш?
Dialogue: 0,0:01:26.46,0:01:28.67,Default,,0,0,0,,Осылай ойнаған адам мен бе?
Dialogue: 0,0:01:29.13,0:01:33.21,Default,,0,0,0,,Саған ғашық болдым деп айту өте жақсы.
Dialogue: 0,0:01:33.84,0:01:36.67,Default,,0,0,0,,Моджа-кун, кейінірек қол қояйық.
Dialogue: 0,0:01:37.68,0:01:38.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:39.01,0:01:45.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:02.89,0:03:08.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.02,0:03:13.19,Default,,0,0,0,,Мұның да екінші жартысы⸺
Dialogue: 0,0:03:13.27,0:03:14.98,Default,,0,0,0,,Егер сіз Йосицүне үшін доптарды жинасаңыз⸺
Dialogue: 0,0:03:15.06,0:03:16.90,Default,,0,0,0,,Жеңіске жету оңай емес пе?
Dialogue: 0,0:03:17.78,0:03:18.74,Default,,0,0,0,,О… Ах…
Dialogue: 0,0:03:19.03,0:03:22.82,Default,,0,0,0,,Керісінше, Йошицүне бұғатталғанша⸺
Dialogue: 0,0:03:23.36,0:03:26.28,Default,,0,0,0,,Эсперионның ойыны бүгінгі күні жақсы емес.
Dialogue: 0,0:03:26.74,0:03:28.54,Default,,0,0,0,,Қарсылас та Токио лигасының 1-дивизионынан.
Dialogue: 0,0:03:28.87,0:03:31.16,Default,,0,0,0,,Сол оймен түзетеді.
Dialogue: 0,0:03:31.71,0:03:35.29,Default,,0,0,0,,және ұпай жинау үшін оны Йосицүнэге қалдырыңыз⸺
Dialogue: 0,0:03:35.75,0:03:38.55,Default,,0,0,0,,Қазіргі В командасына пайдасы тиетінін білмеймін.
Dialogue: 0,0:03:40.01,0:03:44.59,Default,,0,0,0,,Осындай кезде Йосицүнеден басқа біреумен ұпай жинаудың жолын табу керек...
Dialogue: 0,0:03:45.51,0:03:47.18,Default,,0,0,0,,Бұл командаға арналған
Dialogue: 0,0:03:48.64,0:03:51.06,Default,,0,0,0,,Хмм, иә.
Dialogue: 0,0:03:51.68,0:03:54.06,Default,,0,0,0,,Аа~ (Гүл) А... не болды?
Dialogue: 0,0:03:54.23,0:03:55.65,Default,,0,0,0,,Мен өзімді әлсіз сезіндім
Dialogue: 0,0:03:55.94,0:04:00.07,Default,,0,0,0,,Мен мұндай ғажайып ойыншының В тобымен үйлестіретініне сене алмаймын.
Dialogue: 0,0:04:00.49,0:04:02.90,Default,,0,0,0,,Хехе, мен жақсы нәрсе көрдім.
Dialogue: 0,0:04:03.36,0:04:05.41,Default,,0,0,0,,Көп суретке түсіріп, олар туралы мақала жазыңыз.
Dialogue: 0,0:04:05.91,0:04:07.16,Default,,0,0,0,,Бабун~
Dialogue: 0,0:04:07.49,0:04:09.87,Default,,0,0,0,,Хана-санте шынымен⸺
Dialogue: 0,0:04:10.62,0:04:13.25,Default,,0,0,0,,Сіз футбол туралы ештеңе білмейсіз, солай ма?
Dialogue: 0,0:04:19.17,0:04:21.76,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:04:22.26,0:04:23.30,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:23.51,0:04:25.68,Default,,0,0,0,,Йошицүнэ үшін доптарды жинап жатыр
Dialogue: 0,0:04:26.09,0:04:27.85,Default,,0,0,0,,Қатарынан 5 жоғалтудың алдын алу
Dialogue: 0,0:04:28.14,0:04:30.06,Default,,0,0,0,,Бәрі жақсы, тіпті Йошицүнеден сұраса да.
Dialogue: 0,0:04:30.56,0:04:32.52,Default,,0,0,0,,Сәлем, Бобби Робсон?
Dialogue: 0,0:04:32.68,0:04:34.27,Default,,0,0,0,,Ешқандай тактика, түк те жоқ.
Dialogue: 0,0:04:34.35,0:04:35.35,Default,,0,0,0,,Не! (Такешима) Бәрібір⸺
Dialogue: 0,0:04:36.02,0:04:38.19,Default,,0,0,0,,Біз, қорғаушылар, қорғауды жалғастырамыз.
Dialogue: 0,0:04:38.69,0:04:41.36,Default,,0,0,0,,Бірінші жартыжылдықта айтарлықтай бұзылған көріністер болған жоқ.
Dialogue: 0,0:04:41.82,0:04:44.45,Default,,0,0,0,,Аои да біраз қателіктер жіберді, бірақ оның қимылдары жақсарып келеді.
Dialogue: 0,0:04:44.78,0:04:47.37,Default,,0,0,0,,Ең бастысы, егер осылай ұпай жинамасақ, біз жеңе аламыз.
Dialogue: 0,0:04:47.99,0:04:49.28,Default,,0,0,0,,Нөлдік мөрмен жеңіңіз!
Dialogue: 0,0:04:49.58,0:04:50.91,Default,,0,0,0,,О!
Dialogue: 0,0:04:51.45,0:04:54.33,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:04:54.58,0:04:55.54,Default,,0,0,0,,Ашито
Dialogue: 0,0:04:55.79,0:04:56.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.17,0:04:59.25,Default,,0,0,0,,Мен шабуыл жасаймын.
Dialogue: 0,0:04:59.59,0:05:03.38,Default,,0,0,0,,Йошицүнеге сенім арту арқылы жеңіске жетсеңіз де, болашақта бұл сізге көмектеспейді.
Dialogue: 0,0:05:04.88,0:05:06.34,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:05:06.93,0:05:09.64,Default,,0,0,0,,Йошицүнэге қараңдар, ол қатты толқыды, солай ма?
Dialogue: 0,0:05:16.02,0:05:16.77,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:17.10,0:05:18.77,Default,,0,0,0,,Жүйені өзгерту
Dialogue: 0,0:05:18.98,0:05:22.19,Default,,0,0,0,,Йошицүнемен доптарды жинау қиынға соқты.
Dialogue: 0,0:05:25.53,0:05:28.66,Default,,0,0,0,,Сіз жеткілікті керемет баспалдақпен көтеріліп жатырсыз.
Dialogue: 0,0:05:29.53,0:05:30.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:31.66,0:05:35.20,Default,,0,0,0,,Баспалдақпен көтеріл, Йосицүнэ-сан.
Dialogue: 0,0:05:36.29,0:05:37.42,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:05:37.79,0:05:40.04,Default,,0,0,0,,Yoshitsune арқасында бізде көбірек орын бар...
Dialogue: 0,0:05:40.92,0:05:42.92,Default,,0,0,0,,Енді сіз маған ұпай бере аласыз...
Dialogue: 0,0:05:44.21,0:05:45.51,Default,,0,0,0,,Егер сіз осында шабуыл жасасаңыз...
Dialogue: 0,0:05:46.09,0:05:48.38,Default,,0,0,0,,Мен таңғажайып нәрсені қолға алудың алдында тұрғандай сезінемін.
Dialogue: 0,0:05:48.93,0:05:52.51,Default,,0,0,0,,Фукуда мырза сізді жиі мақтайды.
Dialogue: 0,0:05:53.31,0:05:54.22,Default,,0,0,0,,А
Dialogue: 0,0:05:55.77,0:05:57.73,Default,,0,0,0,,Мен бұрынғы күйіме қайтып бара жатқандай сезінемін.
Dialogue: 0,0:05:58.98,0:05:59.98,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:01.77,0:06:03.94,Default,,0,0,0,,Оң жақта бос орын бар!
Dialogue: 0,0:06:04.44,0:06:07.24,Default,,0,0,0,,Тоғашы, менің ойымша, ол көтерілді.
Dialogue: 0,0:06:08.07,0:06:11.70,Default,,0,0,0,,Бірақ оң жақта әдетте сонша бос орын бар ма?
Dialogue: 0,0:06:13.74,0:06:14.79,Default,,0,0,0,,Исшики мырза!
Dialogue: 0,0:06:16.20,0:06:18.21,Default,,0,0,0,,Бірінші тайм ауыр болды...
Dialogue: 0,0:06:19.08,0:06:20.67,Default,,0,0,0,,Сіз жұлып алуға шыдай аласыз ба?
Dialogue: 0,0:06:21.13,0:06:23.96,Default,,0,0,0,,Тоғашы... Сол жылдамдықпен қуып жете аласыз ба?
Dialogue: 0,0:06:24.75,0:06:25.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:26.34,0:06:29.93,Default,,0,0,0,,Осылай шымшып қала берсек, Такесимада оны тоқтату оңай бола ма?
Dialogue: 0,0:06:30.51,0:06:31.51,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:06:36.77,0:06:37.35,Default,,0,0,0,,Ех… Ах…
Dialogue: 0,0:06:38.94,0:06:40.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:41.19,0:06:41.85,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:06:42.94,0:06:44.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.36,0:06:46.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.03,0:06:49.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.15,0:06:51.45,Default,,0,0,0,,Қазір қорғаушылар бір-бірімен сәйкес келді ме?
Dialogue: 0,0:06:54.62,0:06:56.49,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:06:57.08,0:06:59.00,Default,,0,0,0,,Неліктен біз бір-бірімізбен сөйлесе алмаймыз?
Dialogue: 0,0:06:59.25,0:07:02.33,Default,,0,0,0,,Тек бір-біріңізге қоңырау шалып, ниеттеріңізді білдіріңіз!
Dialogue: 0,0:07:02.75,0:07:04.88,Default,,0,0,0,,Енді сіз мұны әдейі істеген жоқсыз!
Dialogue: 0,0:07:05.09,0:07:07.17,Default,,0,0,0,,Оны бәріміз қорғауымыз керек!
Dialogue: 0,0:07:07.63,0:07:10.63,Default,,0,0,0,,Бүгін ғана, мен не болса да жеңуім керек!
Dialogue: 0,0:07:10.84,0:07:11.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:12.18,0:07:13.59,Default,,0,0,0,,Цукишима (Цукишима) Ах...
Dialogue: 0,0:07:14.22,0:07:15.76,Default,,0,0,0,,Біз жүйені өзгертеміз.
Dialogue: 0,0:07:17.22,0:07:18.18,Default,,0,0,0,,Цк
Dialogue: 0,0:07:18.81,0:07:21.69,Default,,0,0,0,,Тоғаши: Матчтан кейін сөйлесеміз.
Dialogue: 0,0:07:22.44,0:07:26.11,Default,,0,0,0,,Бірақ дәл қазір, Аои айтқандай, мен жеңу үшін бар күшімді саламын.
Dialogue: 0,0:07:27.90,0:07:29.94,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:07:30.03,0:07:32.45,Default,,0,0,0,,Олай емес, қарапайым қателік.
Dialogue: 0,0:07:32.70,0:07:35.99,Default,,0,0,0,,Екінші жартысының басында ағын жағымсыз.
Dialogue: 0,0:07:38.08,0:07:40.04,Default,,0,0,0,,Исшики-сан жақсы емес сияқты.
Dialogue: 0,0:07:41.83,0:07:44.58,Default,,0,0,0,,Эсперионның 9-саны тангкамен алып кетті.
Dialogue: 0,0:07:44.75,0:07:46.38,Default,,0,0,0,,Ауысу уақыты келді ме?
Dialogue: 0,0:07:48.00,0:07:49.01,Default,,0,0,0,,Шимизу
Dialogue: 0,0:07:50.01,0:07:51.47,Default,,0,0,0,,Не? (Нумазу) Тоғашы!
Dialogue: 0,0:07:52.18,0:07:53.34,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:07:54.51,0:07:55.43,Default,,0,0,0,,Aoi
Dialogue: 0,0:07:59.52,0:08:00.43,Default,,0,0,0,,Е...
Dialogue: 0,0:08:14.86,0:08:16.82,Default,,0,0,0,,Тағы бір ұпай жинаңыз және бұл өзгеріс болды!
Dialogue: 0,0:08:17.07,0:08:19.37,Default,,0,0,0,,Йошицуне деген белгіні елемеңіз!
Dialogue: 0,0:08:19.54,0:08:20.45,Default,,0,0,0,,О!
Dialogue: 0,0:08:21.00,0:08:22.79,Default,,0,0,0,,Қорғаныс қатесіне байланысты ұтылған ұпай
Dialogue: 0,0:08:23.16,0:08:25.29,Default,,0,0,0,,Орталық қорғаушының кенет ауысуы
Dialogue: 0,0:08:25.54,0:08:28.00,Default,,0,0,0,,Эсперионның қорғанысы дірілдеп тұр.
Dialogue: 0,0:08:28.21,0:08:31.59,Default,,0,0,0,,Бірден басып, допты ұрлаймыз.
Dialogue: 0,0:08:32.80,0:08:34.13,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,0:08:35.26,0:08:38.05,Default,,0,0,0,,Бұл балалар жүйені өзгертті.
Dialogue: 0,0:08:40.47,0:08:42.52,Default,,0,0,0,,Исшикидің орнына келген Нумазу, is⸺
Dialogue: 0,0:08:43.48,0:08:45.35,Default,,0,0,0,,Артқы ортаңғы күйде болыңыз
Dialogue: 0,0:08:46.10,0:08:48.40,Default,,0,0,0,,Еріктінің тұщы суын қорғаныс сызығына түсіріңіз
Dialogue: 0,0:08:49.32,0:08:51.28,Default,,0,0,0,,Екі қорғаушы да осы сомаға көтерілді...
Dialogue: 0,0:08:52.32,0:08:53.32,Default,,0,0,0,,Жоғары көтеріліңіз
Dialogue: 0,0:08:53.69,0:08:57.11,Default,,0,0,0,,Жарайды, Тоғашы екеуің көтеріліңдер. Бұл Нозоми-санның бұйрығы.
Dialogue: 0,0:08:57.20,0:08:58.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:59.28,0:09:02.25,Default,,0,0,0,,Сіз қорғаушы болғандықтан, мен сізден әлі де қорғанысыңызды қамтамасыз етуіңізді сұраймын.
Dialogue: 0,0:09:02.50,0:09:03.87,Default,,0,0,0,,Содан кейін жоғары көтеріліңіз
Dialogue: 0,0:09:04.83,0:09:07.38,Default,,0,0,0,,Нозоми-саннан сізге хабар.
Dialogue: 0,0:09:08.83,0:09:10.63,Default,,0,0,0,,«Бұл қорғаныс шабуылы болса да⸺»
Dialogue: 0,0:09:10.75,0:09:13.42,Default,,0,0,0,,«Сіздің әрекеттеріңіз 180 градусқа өзгереді деп ойламаймын».
Dialogue: 0,0:09:13.88,0:09:17.18,Default,,0,0,0,,«Білгендеріңізді шабуылда қорғаныста қолданыңыз».
Dialogue: 0,0:09:20.30,0:09:21.56,Default,,0,0,0,,Мен жоғары көтеріле аламын ба...
Dialogue: 0,0:09:27.14,0:09:29.52,Default,,0,0,0,,Олар маған ұпай жинай алатынымды айтты...
Dialogue: 0,0:09:32.28,0:09:33.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:35.74,0:09:37.49,Default,,0,0,0,,Мен жоғары көтеріле алғаныма қуаныштымын.
Dialogue: 0,0:09:37.99,0:09:39.41,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:09:40.16,0:09:42.95,Default,,0,0,0,,Бірақ қажетсіз жоғары көтерілу дұрыс па?
Dialogue: 0,0:09:43.62,0:09:45.08,Default,,0,0,0,,Қорғаныс та бар.
Dialogue: 0,0:09:46.00,0:09:50.13,Default,,0,0,0,,Қорғанысқа қамқорлық жасай отырып, қалай шабуыл жасауға болады?
Dialogue: 0,0:09:51.84,0:09:54.01,Default,,0,0,0,,Мен көтерілгім келеді, бірақ...
Dialogue: 0,0:09:55.05,0:09:58.05,Default,,0,0,0,,Ой! Мен оны қалай құрастыру керектігін білмеймін!
Dialogue: 0,0:09:58.34,0:09:59.68,Default,,0,0,0,,Ашито!
Dialogue: 0,0:09:59.84,0:10:00.76,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:10:01.64,0:10:02.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.47,0:10:05.68,Default,,0,0,0,,Кеттік! Жақын болыңыз және маған еріңіз
Dialogue: 0,0:10:06.39,0:10:09.23,Default,,0,0,0,,Белгілі бір орын қалдыр да, менің артымнан ер!
Dialogue: 0,0:10:09.40,0:10:10.81,Default,,0,0,0,,О... Отомо
Dialogue: 0,0:10:11.48,0:10:12.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:13.40,0:10:14.48,Default,,0,0,0,,Хмм... (Тама No 16) Ах...
Dialogue: 0,0:10:14.86,0:10:15.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:20.70,0:10:21.78,Default,,0,0,0,,Йошицунэ мырза
Dialogue: 0,0:10:23.49,0:10:24.83,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:10:25.49,0:10:26.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:26.75,0:10:27.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:29.12,0:10:31.17,Default,,0,0,0,,Сызбаның дамуы күтілгендей
Dialogue: 0,0:10:32.13,0:10:35.63,Default,,0,0,0,,Исшики жарақатына байланысты уақыт ертерек болды.
Dialogue: 0,0:10:36.55,0:10:39.55,Default,,0,0,0,,Осы уақыт аралығындағы жүйе өзгерістері жоспарланғандай.
Dialogue: 0,0:10:40.30,0:10:44.14,Default,,0,0,0,,Қалғаны ойыншылардың оны қалай түсінетініне байланысты.
Dialogue: 0,0:10:47.35,0:10:49.19,Default,,0,0,0,,Олардың өсуін асыға күтейік
Dialogue: 0,0:10:53.98,0:10:56.69,Default,,0,0,0,,Неге... неге алып кете алмаймын?
Dialogue: 0,0:11:00.45,0:11:02.62,Default,,0,0,0,,Бұл сезім есімде
Dialogue: 0,0:11:03.45,0:11:05.16,Default,,0,0,0,,Сол Сейкёге қарсы шайқас сияқты.
Dialogue: 0,0:11:08.12,0:11:09.37,Default,,0,0,0,,Үшбұрыш
Dialogue: 0,0:11:11.54,0:11:12.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:16.05,0:11:16.92,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:11:17.42,0:11:19.55,Default,,0,0,0,,Сіз не істеп жатырсыз? Оны тез ұрлаңыз!
Dialogue: 0,0:11:19.97,0:11:22.05,Default,,0,0,0,,Жоқ, бұл қабылданбайды.
Dialogue: 0,0:11:22.72,0:11:24.18,Default,,0,0,0,,Бірақ одан айырмашылығы –⸺
Dialogue: 0,0:11:24.55,0:11:27.06,Default,,0,0,0,,Дәл қазір мен Асаридің орнындамын.
Dialogue: 0,0:11:28.52,0:11:31.10,Default,,0,0,0,,Алған білімдерін қорғаныста шабуылда қолданыңыз
Dialogue: 0,0:11:31.85,0:11:32.69,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:32.90,0:11:34.40,Default,,0,0,0,,19 саны жақын
Dialogue: 0,0:11:35.52,0:11:38.32,Default,,0,0,0,,Отомо Ол бүйірден келе жатыр! Қайтарыңыз!
Dialogue: 0,0:11:38.53,0:11:39.57,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:11:40.65,0:11:41.65,Default,,0,0,0,,Йошицүнэ-сан!
Dialogue: 0,0:11:50.29,0:11:53.08,Default,,0,0,0,,Отомо, мен сенімен сөйлесе аламын.
Dialogue: 0,0:11:53.50,0:11:54.63,Default,,0,0,0,,Маған хабарлаңыз
Dialogue: 0,0:11:55.46,0:11:56.50,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:11:57.38,0:12:00.59,Default,,0,0,0,,Өту... Өткіңіз келе ме, Ашито?
Dialogue: 0,0:12:00.84,0:12:01.88,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:12:02.76,0:12:03.80,Default,,0,0,0,,Онда!
Dialogue: 0,0:12:05.14,0:12:06.47,Default,,0,0,0,,Мен артта
Dialogue: 0,0:12:06.80,0:12:08.06,Default,,0,0,0,,Себебі мен сенің артыңдамын⸺
Dialogue: 0,0:12:09.18,0:12:11.43,Default,,0,0,0,,Алдарыңыздағы ойыншы болыңыз
Dialogue: 0,0:12:11.93,0:12:14.10,Default,,0,0,0,,Көрінбейтін аймақтарды жаттықтыру⸺
Dialogue: 0,0:12:14.52,0:12:16.40,Default,,0,0,0,,Нұсқау және ұпай жинау!
Dialogue: 0,0:12:20.03,0:12:22.24,Default,,0,0,0,,Сенің көңілді отырғаныңды көремін⸺
Dialogue: 0,0:12:23.74,0:12:25.03,Default,,0,0,0,,Өте көңілді
Dialogue: 0,0:12:26.82,0:12:27.87,Default,,0,0,0,,Тапсырыс берілді!
Dialogue: 0,0:12:27.95,0:12:28.74,Default,,0,0,0,,Отомо!
Dialogue: 0,0:12:29.20,0:12:30.66,Default,,0,0,0,,Керемет позицияда еркін!
Dialogue: 0,0:12:30.75,0:12:31.50,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:12:31.95,0:12:32.71,Default,,0,0,0,,Соға алады
Dialogue: 0,0:12:33.08,0:12:34.04,Default,,0,0,0,,Соқпа!
Dialogue: 0,0:12:34.42,0:12:35.71,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:12:36.08,0:12:38.38,Default,,0,0,0,,Қауіпті Мен оны көре алмадым
Dialogue: 0,0:12:38.59,0:12:41.71,Default,,0,0,0,,Бірақ сіздің арқаңызда бұл атылған финт сияқты.
Dialogue: 0,0:12:42.47,0:12:44.22,Default,,0,0,0,,Соқ! (Камейама) Бар!
Dialogue: 0,0:12:44.38,0:12:45.72,Default,,0,0,0,,Ах! (Тама қақпашысы) Уф...
Dialogue: 0,0:12:45.89,0:12:47.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:48.10,0:12:49.14,Default,,0,0,0,,Таза~!
Dialogue: 0,0:12:50.35,0:12:51.68,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:12:54.81,0:12:55.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:56.44,0:13:00.73,Default,,0,0,0,,Сен 11 адамның бірі емессің деп біраз қызғанамын.
Dialogue: 0,0:13:01.19,0:13:04.78,Default,,0,0,0,,Футболдағы барлық адам 11 ойыншының бірі емес пе?
Dialogue: 0,0:13:05.24,0:13:08.53,Default,,0,0,0,,Йошицүнэ мырза, мұнымен не айтқыңыз келді?
Dialogue: 0,0:13:12.58,0:13:13.83,Default,,0,0,0,,Тікелей соғуға болады
Dialogue: 0,0:13:15.04,0:13:17.12,Default,,0,0,0,,Секёге соғылған голмен бірдей.
Dialogue: 0,0:13:17.46,0:13:20.79,Default,,0,0,0,,Мен ол кездегіден әлдеқайда алыстап кеттім, бірақ мен оны ұрып аламын.
Dialogue: 0,0:13:23.80,0:13:26.18,Default,,0,0,0,,Ах... Тачибана бос.
Dialogue: 0,0:13:26.76,0:13:27.93,Default,,0,0,0,,Керемет орналасу
Dialogue: 0,0:13:28.47,0:13:30.97,Default,,0,0,0,,Мен күштеп соғудың орнына, Тачибанаға өтіп кеттім...
Dialogue: 0,0:13:31.76,0:13:34.85,Default,,0,0,0,,Жоқ, тікелей емес, оны сәл оңға жылжытыңыз⸺
Dialogue: 0,0:13:35.35,0:13:39.06,Default,,0,0,0,,Адамдар көп жиналатын жерлерден аулақ жүріп, дәл осы жерде соғуға болады...
Dialogue: 0,0:13:39.61,0:13:41.90,Default,,0,0,0,,Сіз сенімді бола алатын үш қозғалыс
Dialogue: 0,0:13:43.53,0:13:45.03,Default,,0,0,0,,Солардың бірі...
Dialogue: 0,0:13:47.99,0:13:48.99,Default,,0,0,0,,Таңдау
Dialogue: 0,0:13:53.04,0:13:54.16,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:13:55.62,0:13:57.04,Default,,0,0,0,,Уф! (Тама қақпашысы) Ух...
Dialogue: 0,0:14:01.63,0:14:04.51,Default,,0,0,0,,Ахх!
Dialogue: 0,0:14:04.63,0:14:08.01,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:08.43,0:14:11.10,Default,,0,0,0,,Толық қорғаушы қорғаушыға көмек көрсетеді
Dialogue: 0,0:14:11.60,0:14:13.31,Default,,0,0,0,,Тіпті кездейсоқ
Dialogue: 0,0:14:15.02,0:14:15.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.81,0:14:18.10,Default,,0,0,0,,Тоғашы~!
Dialogue: 0,0:14:18.19,0:14:20.02,Default,,0,0,0,,Сіз ең жақсысыз!
Dialogue: 0,0:14:20.60,0:14:22.31,Default,,0,0,0,,Доп арттан келе жатса да⸺
Dialogue: 0,0:14:22.40,0:14:26.07,Default,,0,0,0,,Бұл керемет тақырып! Сәлем!
Dialogue: 0,0:14:26.19,0:14:28.95,Default,,0,0,0,,Қорғаушы болса да ұпай жинады!
Dialogue: 0,0:14:29.66,0:14:32.20,Default,,0,0,0,,Ашито да жақсы пас берді.
Dialogue: 0,0:14:33.16,0:14:34.12,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:34.99,0:14:36.00,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:14:37.45,0:14:41.25,Default,,0,0,0,,Тоғашының бойы гол соғуға ең жақын екенін сезіндім.
Dialogue: 0,0:14:42.59,0:14:44.04,Default,,0,0,0,,Ах... Ашито
Dialogue: 0,0:14:44.80,0:14:46.09,Default,,0,0,0,,Жақсы көмек
Dialogue: 0,0:14:47.13,0:14:50.05,Default,,0,0,0,,Неге таң қалдың? Тачибана
Dialogue: 0,0:14:50.55,0:14:51.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.14,0:14:53.72,Default,,0,0,0,,Оффсайд жағдайы.
Dialogue: 0,0:14:54.97,0:14:56.22,Default,,0,0,0,,Сіз қайда болдыңыз
Dialogue: 0,0:14:57.22,0:14:58.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.77,0:15:02.23,Default,,0,0,0,,Тағы да, бұл⸺
Dialogue: 0,0:15:03.27,0:15:04.77,Default,,0,0,0,,Бұл қауіпті атмосфера.
Dialogue: 0,0:15:05.98,0:15:08.90,Default,,0,0,0,,Сіз футбол туралы ештеңе білмейсіз, солай ма?
Dialogue: 0,0:15:10.07,0:15:14.83,Default,,0,0,0,,Уф... Әйтеуір түсінбейтін дүние ғой.
Dialogue: 0,0:15:16.99,0:15:19.58,Default,,0,0,0,,А, сен үйге барасың ба?
Dialogue: 0,0:15:20.46,0:15:23.63,Default,,0,0,0,,Менің саған бірдеңе жасайтыным есіме түсті.
Dialogue: 0,0:15:24.13,0:15:24.92,Default,,0,0,0,,Мими-уэ отырған вагонда әйелді мазалаған бір ер адам құлап қалды.
Dialogue: 0,0:15:25.04,0:15:26.00,Default,,0,0,0,,Фото?
Dialogue: 0,0:15:26.09,0:15:28.55,Default,,0,0,0,,Мен өткен күні жақсы суретке түстім.
Dialogue: 0,0:15:28.63,0:15:30.13,Default,,0,0,0,,Сізді жасырын түсіргенім үшін кешіріңіз.
Dialogue: 0,0:15:30.26,0:15:32.09,Default,,0,0,0,,Мен сізге басшылық бергеніңіз үшін алғыс айтқым келді.
Dialogue: 0,0:15:33.47,0:15:36.35,Default,,0,0,0,,Екі дананы Аойға да беріңіз.
Dialogue: 0,0:15:37.18,0:15:38.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:42.94,0:15:43.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:46.19,0:15:47.98,Default,,0,0,0,,Ол несі?
Dialogue: 0,0:15:49.40,0:15:53.07,Default,,0,0,0,,Оған не түрткі болды? Мен басқа адам сияқты жақсы ойнай бастадым.
Dialogue: 0,0:15:53.99,0:15:55.49,Default,,0,0,0,,Өскен жақсы
Dialogue: 0,0:15:56.03,0:15:57.45,Default,,0,0,0,,Бірақ көшбасшы ретінде⸺
Dialogue: 0,0:15:58.24,0:16:00.87,Default,,0,0,0,,Оған жақындау үшін сіз қаншалықты саналысыз?
Dialogue: 0,0:16:02.87,0:16:04.38,Default,,0,0,0,,Хмм... Үміт пе?
Dialogue: 0,0:16:05.38,0:16:06.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:08.09,0:16:10.80,Default,,0,0,0,,Оны есептеу деуді доғар, Цукишима.
Dialogue: 0,0:16:11.13,0:16:12.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:13.55,0:16:14.55,Default,,0,0,0,,Фукуда
Dialogue: 0,0:16:15.22,0:16:17.72,Default,,0,0,0,,Есеп жасай алмайтындықтан қызық емес пе?
Dialogue: 0,0:16:18.26,0:16:19.26,Default,,0,0,0,,Жастар
Dialogue: 0,0:16:20.22,0:16:21.77,Default,,0,0,0,,Бұл қосымша уақыт!
Dialogue: 0,0:16:21.93,0:16:23.39,Default,,0,0,0,,Өзіңізді қорғаңыз!
Dialogue: 0,0:16:23.52,0:16:25.35,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:16:34.41,0:16:35.91,Default,,0,0,0,,Бар!
Dialogue: 0,0:16:36.16,0:16:37.28,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:37.70,0:16:40.54,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:16:40.87,0:16:43.71,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:16:49.13,0:16:50.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:50.80,0:16:52.34,Default,,0,0,0,,Мен қашып үлгердім!
Dialogue: 0,0:16:52.84,0:16:54.34,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:16:55.51,0:16:56.64,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:57.93,0:16:59.01,Default,,0,0,0,,Менің қарындасым қарсылық көрсетпей өлтірілді
Dialogue: 0,0:17:05.85,0:17:09.73,Default,,0,0,0,,Соңында бұл матчта жақсы ойнай алдым.
Dialogue: 0,0:17:10.48,0:17:12.23,Default,,0,0,0,,Ол тіпті Тоғашыға ассист жасады.
Dialogue: 0,0:17:12.32,0:17:14.70,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:23.45,0:17:25.41,Default,,0,0,0,,Көмек жақсы болғанымен⸺
Dialogue: 0,0:17:25.83,0:17:28.25,Default,,0,0,0,,Осы жерден шабуыл мен қорғаныс арасындағы тепе-теңдік бұзылды.
Dialogue: 0,0:17:29.13,0:17:31.09,Default,,0,0,0,,Шабуылдарға қатыса бастады⸺
Dialogue: 0,0:17:31.34,0:17:34.34,Default,,0,0,0,,Шабуыл мен қорғаныс арасында ауысу көп босқа жүгіруге әкеледі⸺
Dialogue: 0,0:17:35.26,0:17:37.34,Default,,0,0,0,,Мен өз күшіммен физикалық күшімді сарқтым.
Dialogue: 0,0:17:37.93,0:17:38.84,Default,,0,0,0,,Уссу
Dialogue: 0,0:17:39.80,0:17:41.18,Default,,0,0,0,,Сол көмектен⸺
Dialogue: 0,0:17:41.93,0:17:43.93,Default,,0,0,0,,Менің басым тағы айналып кетті...
Dialogue: 0,0:17:44.64,0:17:46.52,Default,,0,0,0,,Сол жерден мен экстаз болдым.
Dialogue: 0,0:17:47.69,0:17:50.27,Default,,0,0,0,,Мен матчты жақсы есімде де сақтамаймын.
Dialogue: 0,0:17:52.61,0:17:55.24,Default,,0,0,0,,Қорғаныс Ашито, сен қолыңнан келгеннің бәрін жасаған сияқтысың.
Dialogue: 0,0:17:56.36,0:17:59.45,Default,,0,0,0,,Коучинг кеңістікті тиімді түрде жойды⸺
Dialogue: 0,0:17:59.57,0:18:00.87,Default,,0,0,0,,Нозоми мені мақтады.
Dialogue: 0,0:18:00.95,0:18:01.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:02.45,0:18:03.91,Default,,0,0,0,,Қорғаныс қиын.
Dialogue: 0,0:18:05.41,0:18:08.25,Default,,0,0,0,,Шабуылдармен салыстырғанда ұйымдастыру ережелері көбірек⸺
Dialogue: 0,0:18:08.71,0:18:11.08,Default,,0,0,0,,Вербализация да өте қажет
Dialogue: 0,0:18:12.38,0:18:14.92,Default,,0,0,0,,Бірақ коучинг нені білдіреді?
Dialogue: 0,0:18:15.17,0:18:17.67,Default,,0,0,0,,Осыны сөзбен жеткізе алдым.
Dialogue: 0,0:18:18.97,0:18:21.89,Default,,0,0,0,,Шабуыл жасағанда да мен сол сәтті пайдаланып, ассистент те жасай алдым.
Dialogue: 0,0:18:22.93,0:18:24.68,Default,,0,0,0,,Жарайсың Ашито
Dialogue: 0,0:18:25.56,0:18:26.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.02,0:18:29.52,Default,,0,0,0,,Фукуда мырза сізді мақтайды.
Dialogue: 0,0:18:29.81,0:18:31.52,Default,,0,0,0,,Көбінесе А
Dialogue: 0,0:18:33.07,0:18:35.23,Default,,0,0,0,,Менен бір нәрсе сұраңыз.
Dialogue: 0,0:18:37.03,0:18:38.32,Default,,0,0,0,,Неге соқпадың?
Dialogue: 0,0:18:38.95,0:18:39.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:43.37,0:18:47.16,Default,,0,0,0,,Қайсысы жақсы немесе нашар екені маңызды емес.
Dialogue: 0,0:18:48.75,0:18:49.75,Default,,0,0,0,,Жай⸺
Dialogue: 0,0:18:50.46,0:18:52.84,Default,,0,0,0,,Жеңіске жетсең де, әлі де көңілсіз көрінесің⸺
Dialogue: 0,0:18:52.92,0:18:53.96,Default,,0,0,0,,Мен қызық болдым.
Dialogue: 0,0:18:54.04,0:18:55.00,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:18:56.17,0:18:58.97,Default,,0,0,0,,Түсіндім, бұл өкініш⸺
Dialogue: 0,0:18:59.09,0:19:02.72,Default,,0,0,0,,90 минут бойы тұрақты ойнай алмағаным ғана емес.
Dialogue: 0,0:19:03.55,0:19:05.35,Default,,0,0,0,,Мен алға оралғым келеді⸺
Dialogue: 0,0:19:05.89,0:19:08.10,Default,,0,0,0,,Сол кезде мен жолды таңдадым.
Dialogue: 0,0:19:08.93,0:19:10.56,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:19:11.10,0:19:12.94,Default,,0,0,0,,Мен тіпті білмеймін
Dialogue: 0,0:19:14.31,0:19:17.36,Default,,0,0,0,,Бірақ қартқа соқпасам жақсы болар еді.
Dialogue: 0,0:19:17.99,0:19:18.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.69,0:19:21.57,Default,,0,0,0,,Себебі сіз мені шабуылшы ретінде дисквалификацияладыңыз.
Dialogue: 0,0:19:21.74,0:19:22.57,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:19:23.70,0:19:25.41,Default,,0,0,0,,Футбол ойнаймын деп уайымдамаңыз
Dialogue: 0,0:19:26.37,0:19:28.08,Default,,0,0,0,,Менің айтқым келгені осы ғана.
Dialogue: 0,0:19:29.00,0:19:31.08,Default,,0,0,0,,Сізді алаңдататын кім?
Dialogue: 0,0:19:31.58,0:19:34.42,Default,,0,0,0,,Келесі қарсылас – Токио Мусашино.
Dialogue: 0,0:19:34.79,0:19:35.92,Default,,0,0,0,,Бейнеде көрсетілген
Dialogue: 0,0:19:36.88,0:19:38.92,Default,,0,0,0,,Бұл ең жақсы команда
Dialogue: 0,0:19:39.42,0:19:41.09,Default,,0,0,0,,Осылай қалсаң жеңе алмайсың.
Dialogue: 0,0:19:41.59,0:19:44.05,Default,,0,0,0,,Мусашино шайқасында жасалған жұмыстың арқасында⸺
Dialogue: 0,0:19:45.93,0:19:47.89,Default,,0,0,0,,А тобына қосылмайтыныңызды анықтаңыз
Dialogue: 0,0:19:48.68,0:19:49.73,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:19:52.14,0:19:54.15,Default,,0,0,0,,А... а...
Dialogue: 0,0:19:54.35,0:19:55.86,Default,,0,0,0,,Ашито!
Dialogue: 0,0:19:56.40,0:20:00.86,Default,,0,0,0,,Біз жеңдік! Көмегіңе рахмет!
Dialogue: 0,0:20:01.15,0:20:03.70,Default,,0,0,0,,Аа, сен қорғаныста бар күшіңді салдың, Аои-кун!
Dialogue: 0,0:20:03.82,0:20:05.28,Default,,0,0,0,,Қамыс адамдар~ Хэхе~
Dialogue: 0,0:20:05.37,0:20:06.74,Default,,0,0,0,,Аои (Ашито)...
Dialogue: 0,0:20:08.37,0:20:10.25,Default,,0,0,0,,Исшики мырза, аяғыңыз қалай?
Dialogue: 0,0:20:11.21,0:20:15.00,Default,,0,0,0,,Менде бәрі жақсы. Оның үстіне команда ақыры жеңіске жетті.
Dialogue: 0,0:20:15.25,0:20:16.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.13,0:20:20.17,Default,,0,0,0,,Хмм... (Ашито) О...
Dialogue: 0,0:20:21.30,0:20:22.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:24.05,0:20:25.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.02,0:20:36.02,Default,,0,0,0,,Ухяу-ке-ко-ке! Ке-ке-ке-ке! Ке-ко-ке-ко!
Dialogue: 0,0:20:37.15,0:20:38.86,Default,,0,0,0,,Ха~хаха~!
Dialogue: 0,0:20:39.02,0:20:40.36,Default,,0,0,0,,Қандай гүл!
Dialogue: 0,0:20:40.44,0:20:43.15,Default,,0,0,0,,Ойын ойнағаныма көп болды, бұл қойылым~
Dialogue: 0,0:20:43.24,0:20:46.16,Default,,0,0,0,,Осындай күнде маған қолдау көрсетіңіз, уақыт өте жақсы емес пе?
Dialogue: 0,0:20:47.07,0:20:48.03,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:20:49.53,0:20:51.12,Default,,0,0,0,,Сіз көп жұмыс істедіңіз, солай емес пе?
Dialogue: 0,0:20:51.37,0:20:54.46,Default,,0,0,0,,Аа, сен келгендіктен ғой.
Dialogue: 0,0:20:54.96,0:20:57.54,Default,,0,0,0,,Жанкүйерлер алдында біртүрлі матч өткізуге болмайды.
Dialogue: 0,0:20:58.50,0:21:00.00,Default,,0,0,0,,Бірақ сіз кешігіп келесіз.
Dialogue: 0,0:21:00.46,0:21:02.30,Default,,0,0,0,,Келесі басынан келеді
Dialogue: 0,0:21:02.84,0:21:04.13,Default,,0,0,0,,Өтінемін, гүлдер
Dialogue: 0,0:21:05.05,0:21:06.39,Default,,0,0,0,,Аои-кун~! (Ашито) Уау...
Dialogue: 0,0:21:06.47,0:21:08.72,Default,,0,0,0,,Мен "Soccer Every" фильміндегі Аои Канекомын
Dialogue: 0,0:21:08.80,0:21:11.22,Default,,0,0,0,,Сізбен бір сәт сөйлесуге рұқсат ете аласыз ба?
Dialogue: 0,0:21:11.68,0:21:13.48,Default,,0,0,0,,Менің айтқым келгені осы⸺
Dialogue: 0,0:21:13.98,0:21:15.89,Default,,0,0,0,,Осыдан кейін менің сұхбатым бар.
Dialogue: 0,0:21:16.06,0:21:17.77,Default,,0,0,0,,Елордалық лигадағы тағы бір матч
Dialogue: 0,0:21:18.06,0:21:19.90,Default,,0,0,0,,Сондықтан алдымен маған визитка беріңіз.
Dialogue: 0,0:21:20.36,0:21:21.86,Default,,0,0,0,,Тағы бір оқиғаны айтып бер
Dialogue: 0,0:21:22.65,0:21:24.49,Default,,0,0,0,,Сәлем тілші
Dialogue: 0,0:21:24.74,0:21:27.86,Default,,0,0,0,,Сіз менімен PR-дан өтпей сөйлесесіз бе?
Dialogue: 0,0:21:28.24,0:21:28.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:28.99,0:21:30.66,Default,,0,0,0,,Елордалық лигадағы тағы бір матч?
Dialogue: 0,0:21:31.87,0:21:34.71,Default,,0,0,0,,А, м, Токио Мусашино жастары
Dialogue: 0,0:21:34.87,0:21:36.04,Default,,0,0,0,,Мусашино жастары!
Dialogue: 0,0:21:36.58,0:21:38.79,Default,,0,0,0,,Ол кенеттен күшейіп кеткені біраз қызу тақырып болды...
Dialogue: 0,0:21:38.88,0:21:40.09,Default,,0,0,0,,Ашито!
Dialogue: 0,0:21:40.63,0:21:42.96,Default,,0,0,0,,Хахахаха... (Ашито) Бұл не? Отомо
Dialogue: 0,0:21:43.51,0:21:45.80,Default,,0,0,0,,Ашито: Бұл қиын. (Ашито) Иә?
Dialogue: 0,0:21:48.34,0:21:49.39,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:50.30,0:21:51.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:54.02,0:21:55.23,Default,,0,0,0,,Келесі сәйкестік⸺
Dialogue: 0,0:21:56.56,0:21:58.73,Default,,0,0,0,,Мені сыртқа шығармауыңызды өтінемін
Dialogue: 0,0:22:01.19,0:22:02.36,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:22:07.45,0:22:11.03,Default,,0,0,0,,Оны ойынға қоспайсыз ба? Тачибана шынымен солай айтты ма?
Dialogue: 0,0:22:11.66,0:22:12.45,Default,,0,0,0,,О
Dialogue: 0,0:22:13.45,0:22:15.62,Default,,0,0,0,,Келесі шайқас оның ескі үйінде болады.
Dialogue: 0,0:22:16.37,0:22:18.04,Default,,0,0,0,,Токио Мусашино шайқасы
Dialogue: 0,0:22:20.17,0:22:22.75,Default,,0,0,0,,Отомо Мусашиноны көруге барайық
Dialogue: 0,0:22:22.92,0:22:23.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:25.59,0:22:26.84,Default,,0,0,0,,Тачибананы да өзіңізбен бірге алыңыз
Dialogue: 0,0:22:29.47,0:22:32.01,Default,,0,0,0,,Олар қандай футбол ойнайды⸺
Dialogue: 0,0:22:32.80,0:22:34.72,Default,,0,0,0,,Өз көзіңізбен қараңыз
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.25,0:24:25.79,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.21,0:24:27.63,Default,,0,0,0,,«Бізде не жоқ»
Dialogue: 0,0:24:29.13,0:24:35.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory