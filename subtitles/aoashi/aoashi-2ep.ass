Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:06.33,Default,,0,0,0,,О...
Dialogue: 0,0:00:09.84,0:00:11.42,Default,,0,0,0,,Бұл Токио қалалық үкіметінің ғимараты ма?
Dialogue: 0,0:00:11.51,0:00:13.80,Default,,0,0,0,,Иә? Бұл жай ғана кеңсе ғимараты
Dialogue: 0,0:00:14.18,0:00:15.80,Default,,0,0,0,,Сонда қайда барғың келеді?
Dialogue: 0,0:00:16.68,0:00:18.93,Default,,0,0,0,,Токио Сити Эсперион Футбол Қалашығы
Dialogue: 0,0:00:19.01,0:00:21.06,Default,,0,0,0,,Хаа (Ашито) Мен футбол ойнауға келдім.
Dialogue: 0,0:00:21.85,0:00:23.94,Default,,0,0,0,,Жастар іріктеуін алу
Dialogue: 0,0:00:25.02,0:00:31.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.94,0:01:54.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:55.11,0:01:57.40,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:02:00.16,0:02:01.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.91,0:02:04.87,Default,,0,0,0,,Мұның бәрі футбол нысаны!?
Dialogue: 0,0:02:12.34,0:02:13.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:14.13,0:02:16.09,Default,,0,0,0,,Сіз мен сияқты тест тапсырушысыз ба?
Dialogue: 0,0:02:17.55,0:02:19.80,Default,,0,0,0,,Әйтеуір, мен сонда баруым керек, ол басталмайды.
Dialogue: 0,0:02:20.84,0:02:22.93,Default,,0,0,0,,Емтихан ақысы...
Dialogue: 0,0:02:23.39,0:02:24.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:24.68,0:02:25.27,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:02:29.44,0:02:31.02,Default,,0,0,0,,Жаңадан шыққан батыр Mt. Lady –
Dialogue: 0,0:02:37.07,0:02:37.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:40.86,0:02:42.78,Default,,0,0,0,,Сіз Эхимеденсіз бе?
Dialogue: 0,0:02:43.07,0:02:43.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.20,0:02:46.62,Default,,0,0,0,,Иә, бірақ неге?
Dialogue: 0,0:02:48.04,0:02:48.91,Default,,0,0,0,,Шаш.
Dialogue: 0,0:02:49.00,0:02:52.21,Default,,0,0,0,,Мен Вальдеррама сияқты біреу келе жатыр деп естідім.
Dialogue: 0,0:02:52.71,0:02:55.71,Default,,0,0,0,,Мен айтпадым, ағам айтты.
Dialogue: 0,0:02:55.96,0:02:57.92,Default,,0,0,0,,Ани~!
Dialogue: 0,0:02:58.17,0:03:01.93,Default,,0,0,0,,Тоқта, сен кімсің, кенет!
Dialogue: 0,0:03:02.05,0:03:02.89,Default,,0,0,0,,Хун
Dialogue: 0,0:03:03.51,0:03:06.22,Default,,0,0,0,,Содан бері, аға, мен сіз туралы ғана айтып келемін.
Dialogue: 0,0:03:08.10,0:03:09.18,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:03:09.52,0:03:10.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:11.56,0:03:13.56,Default,,0,0,0,,Хана-чан, тез, тезірек
Dialogue: 0,0:03:13.73,0:03:15.06,Default,,0,0,0,,Таңдау басталады~
Dialogue: 0,0:03:15.15,0:03:16.77,Default,,0,0,0,,Иә
Dialogue: 0,0:03:17.11,0:03:18.69,Default,,0,0,0,,Хмм (Ашито) Уф...
Dialogue: 0,0:03:20.70,0:03:23.57,Default,,0,0,0,,Менің артымнан жүр. Сіз іріктеуге барасыз, солай ма?
Dialogue: 0,0:03:24.49,0:03:25.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:27.66,0:03:29.50,Default,,0,0,0,,барлығы 86 адам
Dialogue: 0,0:03:29.87,0:03:31.71,Default,,0,0,0,,Олардың ішінде көрнекті ойыншылар⸺
Dialogue: 0,0:03:32.62,0:03:35.42,Default,,0,0,0,,Йокояма Мусашино футбол командасы жасөспірімдер
Dialogue: 0,0:03:35.92,0:03:37.46,Default,,0,0,0,,Соичиро Тачибана
Dialogue: 0,0:03:38.05,0:03:40.84,Default,,0,0,0,,Канто жастар арасындағы футбол турнирінің жеңімпаздары
Dialogue: 0,0:03:42.97,0:03:45.55,Default,,0,0,0,,Беделді Тама Чуо орта мектебінің капитаны
Dialogue: 0,0:03:46.18,0:03:47.47,Default,,0,0,0,,Акинори Канеда
Dialogue: 0,0:03:48.85,0:03:51.31,Default,,0,0,0,,Юдай Хасегава Сейран орта мектебі
Dialogue: 0,0:03:52.60,0:03:55.86,Default,,0,0,0,,Сондай-ақ Ли Ён Шик Сейран орта мектебінен
Dialogue: 0,0:03:56.86,0:03:59.94,Default,,0,0,0,,Ехимеде жеткен жетістіктеріңіз бар ма?
Dialogue: 0,0:04:02.24,0:04:03.15,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:04.95,0:04:07.08,Default,,0,0,0,,Не ойлап отырсың, аға?
Dialogue: 0,0:04:09.54,0:04:11.04,Default,,0,0,0,,Қабылдау сол жерде
Dialogue: 0,0:04:11.37,0:04:14.08,Default,,0,0,0,,Емтихан ақысы: 5000 иен, сонда төлеңіз
Dialogue: 0,0:04:14.37,0:04:17.00,Default,,0,0,0,,Бар күшіңді сал, ынталы бол, кездескенше
Dialogue: 0,0:04:17.42,0:04:18.80,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:19.38,0:04:20.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:21.38,0:04:22.17,Default,,0,0,0,,Көгалдар!
Dialogue: 0,0:04:23.59,0:04:27.05,Default,,0,0,0,,Біз бүгін осындай әдемі көгалда футбол ойнай аламыз ба?
Dialogue: 0,0:04:27.93,0:04:31.10,Default,,0,0,0,,Шун-ниге де көрсет~
Dialogue: 0,0:04:35.06,0:04:36.48,Default,,0,0,0,,Бұл жай ғана бас бапкердің күні.
Dialogue: 0,0:04:37.56,0:04:39.19,Default,,0,0,0,,Баршаңызға белгілі⸺
Dialogue: 0,0:04:39.82,0:04:41.94,Default,,0,0,0,,Токио Сити Эсперион ФК
Dialogue: 0,0:04:42.40,0:04:44.03,Default,,0,0,0,,J1-ге қосылғаннан бері 9 жыл
Dialogue: 0,0:04:44.40,0:04:47.91,Default,,0,0,0,,Лига чемпионаты бір рет, Император кубогы бір рет
Dialogue: 0,0:04:48.57,0:04:51.29,Default,,0,0,0,,Үздік командалар тұрақты нәтижелерге ие
Dialogue: 0,0:04:52.00,0:04:54.46,Default,,0,0,0,,Бұл тәрбиеге байланысты.
Dialogue: 0,0:04:55.54,0:04:56.87,Default,,0,0,0,,Біз Эсперия⸺
Dialogue: 0,0:04:57.00,0:04:59.92,Default,,0,0,0,,Жапонияда оқу үшін ең жоғары баға алды
Dialogue: 0,0:05:00.46,0:05:02.71,Default,,0,0,0,,Бұдан былай директор Фукуда, өтінемін.
Dialogue: 0,0:05:03.26,0:05:06.18,Default,,0,0,0,,Бүгін барлығы жақсы жиналды.
Dialogue: 0,0:05:07.39,0:05:08.22,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:05:10.43,0:05:11.22,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:05:11.81,0:05:15.69,Default,,0,0,0,,Болашақ ұрпақты тәрбиелей алмаған ұжымның болашағы жоқ деп есептеймін.
Dialogue: 0,0:05:16.02,0:05:18.60,Default,,0,0,0,,Бірақ іс жүзінде әлсіз позиция болса⸺
Dialogue: 0,0:05:18.86,0:05:21.36,Default,,0,0,0,,Басқа командалардың ойыншыларын тарту арқылы аяқтау⸺
Dialogue: 0,0:05:21.94,0:05:24.03,Default,,0,0,0,,Бұл кәсіби футбол клубтарының тағдыры.
Dialogue: 0,0:05:25.78,0:05:28.99,Default,,0,0,0,,Бірақ сіз қабылдаған ойыншы сіздің үміттеріңізді ақтамаса ше?
Dialogue: 0,0:05:29.82,0:05:33.54,Default,,0,0,0,,Бірақ бала кезімнен қасымда болған адамдар басқаша.
Dialogue: 0,0:05:33.83,0:05:37.96,Default,,0,0,0,,Біз оның қабілетін, болмысын басқалардан жақсы білеміз.
Dialogue: 0,0:05:38.46,0:05:40.13,Default,,0,0,0,,Артықшылықтары мен кемшіліктері
Dialogue: 0,0:05:41.34,0:05:42.55,Default,,0,0,0,,Сізге де⸺
Dialogue: 0,0:05:42.67,0:05:46.01,Default,,0,0,0,,Сіз клубтың футболының түстерін ұзақ уақыт бойы біле аласыз.
Dialogue: 0,0:05:47.05,0:05:48.97,Default,,0,0,0,,Тәрбиелеу деген осы.
Dialogue: 0,0:05:49.59,0:05:52.18,Default,,0,0,0,,Жапон футболының болашағы дамуда
Dialogue: 0,0:05:53.26,0:05:55.48,Default,,0,0,0,,Бүгінгі емтиханды сәтті тапсыруларыңызға тілектеспін.
Dialogue: 0,0:05:56.35,0:05:57.64,Default,,0,0,0,,Өте алмағандар⸺
Dialogue: 0,0:05:57.85,0:06:00.69,Default,,0,0,0,,Үлкенірек ойыншы болу үшін оны отын ретінде пайдаланыңыз⸺
Dialogue: 0,0:06:01.11,0:06:03.40,Default,,0,0,0,,Көретін көзі жоқ бізге артқа қарашы.
Dialogue: 0,0:06:07.03,0:06:07.65,Default,,0,0,0,,Уши
Dialogue: 0,0:06:08.82,0:06:11.53,Default,,0,0,0,,Бұл қалай, Бензен, сен ойланбастан айттың.
Dialogue: 0,0:06:11.99,0:06:13.99,Default,,0,0,0,,Олай айтпасаң жақсы.
Dialogue: 0,0:06:14.79,0:06:15.79,Default,,0,0,0,,Ябби
Dialogue: 0,0:06:16.29,0:06:18.66,Default,,0,0,0,,J лигасы және жастар туралы⸺
Dialogue: 0,0:06:18.96,0:06:21.04,Default,,0,0,0,,Мен бұл клуб туралы көп білмеймін.
Dialogue: 0,0:06:21.71,0:06:24.25,Default,,0,0,0,,Мен мұнда дәл айтқандай келген сияқтымын...
Dialogue: 0,0:06:24.59,0:06:27.47,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:06:27.55,0:06:31.43,Default,,0,0,0,,Мен енді жүрегімнің дүрсілін тоқтата алмаймын!
Dialogue: 0,0:06:31.64,0:06:35.31,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:06:35.56,0:06:37.39,Default,,0,0,0,,Иә, тағы бір нәрсе.
Dialogue: 0,0:06:38.98,0:06:41.81,Default,,0,0,0,,Жастар іріктеуінде табысты болу деген нені білдіреді?
Dialogue: 0,0:06:42.15,0:06:43.19,Default,,0,0,0,,Бірде-бір
Dialogue: 0,0:06:43.98,0:06:46.57,Default,,0,0,0,,Бұлардың біреуін ешкім ұстай алмау ықтималдығы жоғары.
Dialogue: 0,0:06:46.73,0:06:47.65,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:06:48.86,0:06:51.20,Default,,0,0,0,,Мұны тыңдама, Фукуданың ағасы!
Dialogue: 0,0:06:51.61,0:06:53.91,Default,,0,0,0,,Сөйлесуіңіз неде?
Dialogue: 0,0:06:54.20,0:06:55.45,Default,,0,0,0,,Өйткені!
Dialogue: 0,0:06:56.24,0:06:58.96,Default,,0,0,0,,Кіргісі келетіндер қаншама!
Dialogue: 0,0:06:59.50,0:07:00.79,Default,,0,0,0,,Барлығы⸺
Dialogue: 0,0:07:00.87,0:07:03.21,Default,,0,0,0,,Ешкім ұстамағаны қызық емес пе!
Dialogue: 0,0:07:06.46,0:07:07.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:09.51,0:07:10.84,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:07:11.80,0:07:14.14,Default,,0,0,0,,Я... Директор Фукуда...
Dialogue: 0,0:07:15.10,0:07:18.35,Default,,0,0,0,,А, бұл рас. Саған түсіндіргенім есімде жоқ.
Dialogue: 0,0:07:18.68,0:07:19.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:20.77,0:07:22.69,Default,,0,0,0,,Мен ұмытып қалдым, Ашито.
Dialogue: 0,0:07:22.77,0:07:24.98,Default,,0,0,0,,Ол кезде менің уақытым аз еді.
Dialogue: 0,0:07:25.23,0:07:26.11,Default,,0,0,0,,Кешіріңіз, кешіріңіз (Ашито)...
Dialogue: 0,0:07:26.40,0:07:28.86,Default,,0,0,0,,Са… Сандал…
Dialogue: 0,0:07:29.44,0:07:33.53,Default,,0,0,0,,Бұл... біртүрлі қарт басқаратын команда...
Dialogue: 0,0:07:35.03,0:07:36.91,Default,,0,0,0,,Жастар футбол мектебі емес
Dialogue: 0,0:07:37.62,0:07:39.95,Default,,0,0,0,,Күш қызметін атқара алатындар ғана ие бола алады.
Dialogue: 0,0:07:41.08,0:07:42.00,Default,,0,0,0,,Өткен жылы...
Dialogue: 0,0:07:42.25,0:07:44.63,Default,,0,0,0,,Басқаша айтқанда, сізден бір сынып жоғары...
Dialogue: 0,0:07:45.08,0:07:47.13,Default,,0,0,0,,15 жас туылған
Dialogue: 0,0:07:47.96,0:07:50.05,Default,,0,0,0,,Бөлім 3 барлаушы.
Dialogue: 0,0:07:50.55,0:07:52.22,Default,,0,0,0,,Іріктеуден бір адам өтті
Dialogue: 0,0:07:52.84,0:07:55.51,Default,,0,0,0,,11 адам кіші жастан жоғарылады
Dialogue: 0,0:07:56.35,0:07:59.47,Default,,0,0,0,,Жасөспірімдер… Көтермелеу…
Dialogue: 0,0:07:59.81,0:08:00.85,Default,,0,0,0,,Иә
Dialogue: 0,0:08:01.14,0:08:02.73,Default,,0,0,0,,Әдетте жастар командалары⸺
Dialogue: 0,0:08:02.81,0:08:06.77,Default,,0,0,0,,Топтың жартысынан көбін кіші жастар құрайды.
Dialogue: 0,0:08:07.90,0:08:13.20,Default,,0,0,0,,Өткен жылы біздің кіші жастар тобында 3 курста 25 студент болды.
Dialogue: 0,0:08:14.07,0:08:18.24,Default,,0,0,0,,Осыншама еңбек еткен 14 адамды жоғарылатпадық.
Dialogue: 0,0:08:19.08,0:08:20.45,Default,,0,0,0,,Скаут соңынан
Dialogue: 0,0:08:21.62,0:08:24.92,Default,,0,0,0,,Токиода, негізінен, скаут командасы арқылы келешегі бар ойыншылар бар ма?
Dialogue: 0,0:08:25.04,0:08:26.46,Default,,0,0,0,,Әрқашан тексеру
Dialogue: 0,0:08:27.17,0:08:29.75,Default,,0,0,0,,Олардың ішінен алғыңыз келетін ойыншылар үшін⸺
Dialogue: 0,0:08:29.84,0:08:33.05,Default,,0,0,0,,Олармен тікелей сөйлесіп, қосылуын сұраңыз.
Dialogue: 0,0:08:34.05,0:08:37.26,Default,,0,0,0,,Сонда мен соншалықты алыс емеспін бе?
Dialogue: 0,0:08:38.01,0:08:40.97,Default,,0,0,0,,Сонымен, барлаушылар тобының ақпаратының арқасында біз...
Dialogue: 0,0:08:41.47,0:08:43.94,Default,,0,0,0,,Мен сіз туралы бұрыннан білемін
Dialogue: 0,0:08:44.48,0:08:46.48,Default,,0,0,0,,Мұнда жиналған 86 адам⸺
Dialogue: 0,0:08:46.69,0:08:49.73,Default,,0,0,0,,Бұл біз осы уақытқа дейін қолға түсіргіміз келмейді деп ойламаған жігіттер.
Dialogue: 0,0:08:50.11,0:08:51.23,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:08:51.32,0:08:54.03,Default,,0,0,0,,Олай деме... Директор Фукуда
Dialogue: 0,0:08:54.11,0:08:55.03,Default,,0,0,0,,Фукуда…
Dialogue: 0,0:08:55.70,0:09:00.12,Default,,0,0,0,,Бірақ мұны мұнда келгендердің бәрі біледі.
Dialogue: 0,0:09:00.83,0:09:02.45,Default,,0,0,0,,Өз мүмкіндігіңізге қарай⸺
Dialogue: 0,0:09:03.12,0:09:05.37,Default,,0,0,0,,Менің мүмкіндігім аз.
Dialogue: 0,0:09:05.83,0:09:08.71,Default,,0,0,0,,Дегенмен, Эсперионға қарсы шыққысы келетіндер бар⸺
Dialogue: 0,0:09:09.42,0:09:10.96,Default,,0,0,0,,Қаншама адам келді.
Dialogue: 0,0:09:11.63,0:09:14.17,Default,,0,0,0,,Мұндай жағдайдан кім шыға алады⸺
Dialogue: 0,0:09:14.47,0:09:16.55,Default,,0,0,0,,Шынымен жарқырап тұрған сияқты
Dialogue: 0,0:09:17.22,0:09:19.22,Default,,0,0,0,,Клуб үшін жарық өте қажет деп айтуға болады.
Dialogue: 0,0:09:20.10,0:09:21.18,Default,,0,0,0,,Көтеріліс
Dialogue: 0,0:09:21.51,0:09:23.93,Default,,0,0,0,,Қиындықтан қайта серпілу қабілеті бар спортшылар
Dialogue: 0,0:09:24.10,0:09:25.98,Default,,0,0,0,,Қалағаным сонша, қолым тамағымнан шығады
Dialogue: 0,0:09:27.06,0:09:30.36,Default,,0,0,0,,Жарқыраса, міндетті түрде табамыз
Dialogue: 0,0:09:31.98,0:09:33.03,Default,,0,0,0,,Сәттілік балалар
Dialogue: 0,0:09:33.32,0:09:35.70,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:09:36.45,0:09:37.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:40.24,0:09:43.04,Default,,0,0,0,,Бірінші емтихан Физикалық сынақтан бастайық!
Dialogue: 0,0:09:44.62,0:09:45.66,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:46.79,0:09:48.04,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:09:49.17,0:09:50.38,Default,,0,0,0,,6 секунд 1!
Dialogue: 0,0:09:50.71,0:09:52.34,Default,,0,0,0,,Уа, тезірек!
Dialogue: 0,0:09:52.92,0:09:54.84,Default,,0,0,0,,Эй, мен қалтырап тұрмын.
Dialogue: 0,0:09:55.42,0:09:57.43,Default,,0,0,0,,Эх... ой
Dialogue: 0,0:09:58.30,0:10:00.34,Default,,0,0,0,,Немесе... Мен де солаймын.
Dialogue: 0,0:10:00.85,0:10:05.31,Default,,0,0,0,,Мен қобалжысам, ішім ауырады. Уф...
Dialogue: 0,0:10:05.43,0:10:08.52,Default,,0,0,0,,Менімен бірінші келіп сөйлескен сенсің.
Dialogue: 0,0:10:08.73,0:10:09.77,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:10:10.40,0:10:13.98,Default,,0,0,0,,Мен, Ашито Аои, позиция - данышпан алға.
Dialogue: 0,0:10:15.11,0:10:16.49,Default,,0,0,0,,Эйсаку Отомо
Dialogue: 0,0:10:17.53,0:10:20.99,Default,,0,0,0,,Маған ат маңызды емес! Сен кінәлісің!
Dialogue: 0,0:10:21.20,0:10:22.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:22.16,0:10:23.74,Default,,0,0,0,,Себебі сіз осылай айтасыз⸺
Dialogue: 0,0:10:23.95,0:10:26.25,Default,,0,0,0,,Директор Фукуда осылай деді...
Dialogue: 0,0:10:26.62,0:10:28.54,Default,,0,0,0,,Бұл барлығын есінен танып қалды.
Dialogue: 0,0:10:29.12,0:10:31.54,Default,,0,0,0,,Оған дейін қобалжығандар көп болды.
Dialogue: 0,0:10:32.00,0:10:34.67,Default,,0,0,0,,Мен үшін де оны пайдалану мүмкіндігі болды.
Dialogue: 0,0:10:35.21,0:10:37.13,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:10:37.51,0:10:38.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:39.68,0:10:42.30,Default,,0,0,0,,Басында қыңырлар көп болғаны рас!
Dialogue: 0,0:10:42.72,0:10:44.81,Default,,0,0,0,,Бірақ мен бұған ризамын!
Dialogue: 0,0:10:44.93,0:10:45.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:46.52,0:10:49.56,Default,,0,0,0,,Сіз осы тамаша балалармен футбол ойнай аласыз!
Dialogue: 0,0:10:50.10,0:10:51.48,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:52.73,0:10:54.07,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:10:55.57,0:10:58.86,Default,,0,0,0,,Келесі - 7v7 20 минуттық шағын ойын
Dialogue: 0,0:10:59.24,0:11:01.99,Default,,0,0,0,,Бұл бірінші емтихандағы ең маңызды сынақ.
Dialogue: 0,0:11:02.24,0:11:03.49,Default,,0,0,0,,Барлығына сәттілік!
Dialogue: 0,0:11:04.58,0:11:07.83,Default,,0,0,0,,Командаларды осылай бөлген кім?
Dialogue: 0,0:11:08.62,0:11:10.21,Default,,0,0,0,,Бұл әділ емес.
Dialogue: 0,0:11:11.75,0:11:13.04,Default,,0,0,0,,Әрине, ол заңды бұзып жатыр ғой.
Dialogue: 0,0:11:24.51,0:11:27.47,Default,,0,0,0,,Бауырым, ұпай жинауда алға жылжып жатырсың ба?
Dialogue: 0,0:11:28.02,0:11:29.14,Default,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:11:29.60,0:11:32.27,Default,,0,0,0,,Мен саған далада олай атама дедім.
Dialogue: 0,0:11:32.73,0:11:35.27,Default,,0,0,0,,Кешіріңіз директор Фукуда
Dialogue: 0,0:11:35.48,0:11:36.82,Default,,0,0,0,,Хана-чан, кешіріңіз.
Dialogue: 0,0:11:36.98,0:11:39.32,Default,,0,0,0,,Ыстық күнге осылай жүгіру
Dialogue: 0,0:11:39.78,0:11:42.11,Default,,0,0,0,,Ол қанша режиссер Фукуданың әпкесі болса да...
Dialogue: 0,0:11:42.20,0:11:43.20,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:11:44.87,0:11:47.45,Default,,0,0,0,,Барлық тестілеушілер тынбай еңбек етуде.
Dialogue: 0,0:11:47.99,0:11:49.29,Default,,0,0,0,,Өмірімді қатерге тігу...
Dialogue: 0,0:11:51.16,0:11:54.29,Default,,0,0,0,,Бірақ ол біржақты болды.
Dialogue: 0,0:11:54.83,0:11:56.59,Default,,0,0,0,,Бұл алаңдағы ойын...
Dialogue: 0,0:11:57.25,0:11:57.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:01.17,0:12:02.17,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:12:02.88,0:12:03.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.68,0:12:06.76,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:12:07.97,0:12:10.10,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:12:13.23,0:12:14.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:14.90,0:12:16.94,Default,,0,0,0,,Эй, сен не істеп жатырсың!
Dialogue: 0,0:12:17.23,0:12:19.19,Default,,0,0,0,,Оны жалғыз басып озуға тырыспаңыз!
Dialogue: 0,0:12:19.53,0:12:22.53,Default,,0,0,0,,Доп сенен талай рет ұрланды, Эхиме!
Dialogue: 0,0:12:22.74,0:12:25.78,Default,,0,0,0,,Балалар сендер маған допты мүлде бермейсіңдер!
Dialogue: 0,0:12:26.03,0:12:27.62,Default,,0,0,0,,Мен ұпай алғым келеді!
Dialogue: 0,0:12:27.83,0:12:30.83,Default,,0,0,0,,Асу келмеген соң, жалғыз алып жүруден басқа амалым жоқ!
Dialogue: 0,0:12:31.00,0:12:33.87,Default,,0,0,0,,Саған доп лақтырсам, қайтып келмейсің!
Dialogue: 0,0:12:34.08,0:12:36.25,Default,,0,0,0,,Сіз сондай күшті сөздер айтқан болсаңыз да⸺
Dialogue: 0,0:12:36.33,0:12:38.34,Default,,0,0,0,,Ол жай ғана тік тұрған ойыншы болды ма?
Dialogue: 0,0:12:38.50,0:12:40.25,Default,,0,0,0,,Гунууууу...
Dialogue: 0,0:12:41.05,0:12:41.80,Default,,0,0,0,,Хаа
Dialogue: 0,0:12:43.05,0:12:45.51,Default,,0,0,0,,Мен сенің батылдығың бар екенін білемін.
Dialogue: 0,0:12:46.01,0:12:47.51,Default,,0,0,0,,Бұл тек сенің кінәң емес
Dialogue: 0,0:12:48.30,0:12:50.93,Default,,0,0,0,,Біздің команда тым тәртіпсіз.
Dialogue: 0,0:12:51.52,0:12:53.10,Default,,0,0,0,,Көбірек тынышталайық.
Dialogue: 0,0:12:54.14,0:12:56.56,Default,,0,0,0,,Ақ көкірекшелер тобы
Dialogue: 0,0:12:56.69,0:12:58.19,Default,,0,0,0,,Бұл негізсіз емес.
Dialogue: 0,0:12:58.40,0:12:59.82,Default,,0,0,0,,Екінші тарап өте нашар.
Dialogue: 0,0:13:00.40,0:13:02.78,Default,,0,0,0,,Әсіресе сол Тачибана Соичиро
Dialogue: 0,0:13:06.16,0:13:07.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:07.87,0:13:09.70,Default,,0,0,0,,Бұл таңдау қауесет⸺
Dialogue: 0,0:13:09.78,0:13:11.29,Default,,0,0,0,,Оны алу немесе алмау⸺
Dialogue: 0,0:13:11.37,0:13:14.04,Default,,0,0,0,,Негізгі мақсаты анықтау деп естідім.
Dialogue: 0,0:13:16.17,0:13:18.25,Default,,0,0,0,,Керемет! Мұнда тегін!
Dialogue: 0,0:13:19.08,0:13:20.13,Default,,0,0,0,,Тегін!
Dialogue: 0,0:13:20.25,0:13:21.17,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:13:23.38,0:13:24.97,Default,,0,0,0,,Цк
Dialogue: 0,0:13:25.26,0:13:27.80,Default,,0,0,0,,Донмай Канеда Жақсы көріңіз!
Dialogue: 0,0:13:30.72,0:13:31.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.56,0:13:34.56,Default,,0,0,0,,Аға
Dialogue: 0,0:13:34.77,0:13:37.35,Default,,0,0,0,,Ұжымның мұндай қабілетінің айырмашылығы бар ма?
Dialogue: 0,0:13:37.69,0:13:39.36,Default,,0,0,0,,Иә? Ха
Dialogue: 0,0:13:40.23,0:13:42.02,Default,,0,0,0,,Барлығы қауіп төніп тұрған таңдау
Dialogue: 0,0:13:42.48,0:13:44.49,Default,,0,0,0,,Емтихан алушылардың ортақ сезімдері⸺
Dialogue: 0,0:13:44.94,0:13:47.74,Default,,0,0,0,,Мен тек шағымданғым келеді және ерекшеленгім келеді.
Dialogue: 0,0:13:48.36,0:13:50.32,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:50.99,0:13:53.91,Default,,0,0,0,,Біз асығыс жиналған топпыз, тіпті бір-бірімізді танымаймыз⸺
Dialogue: 0,0:13:54.33,0:13:56.25,Default,,0,0,0,,Өзіңізді ортаға салу қиын.
Dialogue: 0,0:13:56.50,0:13:58.58,Default,,0,0,0,,Сонымен не қажет?
Dialogue: 0,0:13:59.17,0:14:02.67,Default,,0,0,0,,Бұл ыңғайсыз өрісте не істеуім керек?
Dialogue: 0,0:14:03.46,0:14:04.34,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.71,0:14:07.63,Default,,0,0,0,,Мұнда көргіміз келетін нәрсе физикалық немесе техника емес.
Dialogue: 0,0:14:08.38,0:14:11.47,Default,,0,0,0,,«Ойлау күші» - бұл интеллект.
Dialogue: 0,0:14:12.81,0:14:14.97,Default,,0,0,0,,Жоқ, анау Эхиме қызы
Dialogue: 0,0:14:15.52,0:14:17.31,Default,,0,0,0,,Қозғалыс толығымен тоқтады.
Dialogue: 0,0:14:17.52,0:14:20.15,Default,,0,0,0,,Оны осында әкелу үшін неге қиналдың?
Dialogue: 0,0:14:20.73,0:14:21.90,Default,,0,0,0,,Директор Фукуда
Dialogue: 0,0:14:22.52,0:14:23.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:26.78,0:14:29.32,Default,,0,0,0,,Қарғыс атқыр, менде жаман әдет пайда болды.
Dialogue: 0,0:14:30.03,0:14:32.20,Default,,0,0,0,,Ол жай ғана тік тұрған ойыншы болды ма?
Dialogue: 0,0:14:36.00,0:14:38.46,Default,,0,0,0,,Осы уақытқа дейін мен қалағанымды жасай алдым⸺
Dialogue: 0,0:14:38.91,0:14:41.13,Default,,0,0,0,,Мені қолдағаны үшін емес пе?
Dialogue: 0,0:14:41.96,0:14:44.80,Default,,0,0,0,,Мұндай нәрсені ешқашан ұмытпау керек.
Dialogue: 0,0:14:48.47,0:14:50.63,Default,,0,0,0,,Осы уақытқа дейін матчтардан не білдім
Dialogue: 0,0:14:51.14,0:14:54.26,Default,,0,0,0,,Менің командамның барлығының шеберлігі жақсы.
Dialogue: 0,0:14:56.93,0:14:59.06,Default,,0,0,0,,Осы жігіттермен дұрыс⸺
Dialogue: 0,0:14:59.69,0:15:01.35,Default,,0,0,0,,Футбол ойнайық!
Dialogue: 0,0:15:20.50,0:15:21.50,Default,,0,0,0,,О...
Dialogue: 0,0:15:21.75,0:15:23.17,Default,,0,0,0,,Отомо! (Отомо) А...
Dialogue: 0,0:15:27.63,0:15:29.30,Default,,0,0,0,,Әй, мына бала қандай?
Dialogue: 0,0:15:29.63,0:15:30.55,Default,,0,0,0,,Алға болса да⸺
Dialogue: 0,0:15:30.63,0:15:32.80,Default,,0,0,0,,Қорғаушы позициясына дейін дерлік
Dialogue: 0,0:15:33.14,0:15:36.85,Default,,0,0,0,,Сіз әлі де осы кезеңде трибунадан көрінуді талап етесіз бе?
Dialogue: 0,0:15:37.14,0:15:38.81,Default,,0,0,0,,Не істеп жатырсың, Эхиме?
Dialogue: 0,0:15:38.93,0:15:40.77,Default,,0,0,0,,Допты тез қайтарыңыз!
Dialogue: 0,0:15:41.06,0:15:43.48,Default,,0,0,0,,Бұлай өз командаңыздың мақсатына жақындамаңыз!
Dialogue: 0,0:15:43.94,0:15:47.19,Default,,0,0,0,,5 минут қалды! Өкінбеу үшін қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:15:47.40,0:15:49.69,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:15:49.82,0:15:51.65,Default,,0,0,0,,Сабырлы бол, қолыңнан келгенін істе...
Dialogue: 0,0:15:52.11,0:15:53.86,Default,,0,0,0,,Ол бала енді жақсы емес.
Dialogue: 0,0:15:54.41,0:15:56.49,Default,,0,0,0,,Сіз Эхимеден келдіңіз, бірақ...
Dialogue: 0,0:15:57.74,0:15:58.70,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:15:59.37,0:16:01.00,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:16:02.75,0:16:03.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.34,0:16:15.84,Default,,0,0,0,,Өтінемін, өтінемін, тағы бір қадам⸺
Dialogue: 0,0:16:15.93,0:16:17.22,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:16:17.60,0:16:18.56,Default,,0,0,0,,Не?
Dialogue: 0,0:16:19.43,0:16:23.02,Default,,0,0,0,,Неліктен Эхиме жігіті допты сол қалпында мәңгілікке сақтайды...
Dialogue: 0,0:16:23.56,0:16:24.85,Default,,0,0,0,,Сіз бір нәрсеге ұмтыласыз ба?
Dialogue: 0,0:16:25.69,0:16:28.73,Default,,0,0,0,,Әлгі былғары басы әбден өңделген.
Dialogue: 0,0:16:29.07,0:16:31.86,Default,,0,0,0,,Иә, егер сіз оны жапсаңыз, сіз допты ұрлай аласыз.
Dialogue: 0,0:16:32.36,0:16:33.32,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:35.32,0:16:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:37.87,0:16:38.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:40.66,0:16:43.87,Default,,0,0,0,,Ах! Сен не істеп жатырсың! Команданың мақсатына қарай дриблинг...
Dialogue: 0,0:16:44.71,0:16:45.87,Default,,0,0,0,,Канеда, жүгір!
Dialogue: 0,0:16:46.46,0:16:47.29,Default,,0,0,0,,Цк
Dialogue: 0,0:16:48.50,0:16:49.38,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:16:50.38,0:16:51.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:53.38,0:16:54.72,Default,,0,0,0,,Ах... (Күні) Ах...
Dialogue: 0,0:16:56.26,0:16:57.26,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:16:58.76,0:17:00.43,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:00.51,0:17:02.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:02.77,0:17:05.39,Default,,0,0,0,,Жарайсың, жарайсың Канеда!
Dialogue: 0,0:17:05.60,0:17:08.44,Default,,0,0,0,,Бұл менмін! Менің нұсқауларым жақсы болды!
Dialogue: 0,0:17:08.52,0:17:11.32,Default,,0,0,0,,Онсыз мен ұша алмас едім! Эй!
Dialogue: 0,0:17:11.48,0:17:13.69,Default,,0,0,0,,Уау~ Көрдің бе~!
Dialogue: 0,0:17:14.24,0:17:16.41,Default,,0,0,0,,Ұпай соқпаса да жарқырайтын ер!
Dialogue: 0,0:17:16.49,0:17:18.49,Default,,0,0,0,,Мен Ашито Аоимын~!
Dialogue: 0,0:17:18.62,0:17:19.83,Default,,0,0,0,,Мен, мен, мен, мен~!
Dialogue: 0,0:17:20.45,0:17:23.29,Default,,0,0,0,,Жарайды... жай ғана сәтті болды.
Dialogue: 0,0:17:24.04,0:17:25.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:25.66,0:17:27.50,Default,,0,0,0,,Көмек те жақсы сезінеді.
Dialogue: 0,0:17:29.04,0:17:29.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:32.21,0:17:33.17,Default,,0,0,0,,Иә
Dialogue: 0,0:17:34.51,0:17:35.38,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:17:36.43,0:17:39.55,Default,,0,0,0,,Керемет тамаша! Сіз жақсы нәрсе көрдіңіз, Фукуда!
Dialogue: 0,0:17:40.01,0:17:41.81,Default,,0,0,0,,Тамаша уақыт!
Dialogue: 0,0:17:42.35,0:17:45.35,Default,,0,0,0,,Шабуылшы өз қақпасына құлаған кезде⸺
Dialogue: 0,0:17:45.48,0:17:47.10,Default,,0,0,0,,Басқа команда жақындап келеді!
Dialogue: 0,0:17:47.39,0:17:49.02,Default,,0,0,0,,Тіпті Қорғаушы
Dialogue: 0,0:17:49.35,0:17:52.94,Default,,0,0,0,,Осы кезде менің алдымда секундтың бірнеше оннан бір бөлігіне кеңістік пайда болды!
Dialogue: 0,0:17:53.23,0:17:55.32,Default,,0,0,0,,Оны жіберіп алмаңыз, ұзақ жол!
Dialogue: 0,0:17:55.65,0:17:57.95,Default,,0,0,0,,Нақты арна да тамаша болды!
Dialogue: 0,0:17:58.66,0:18:00.03,Default,,0,0,0,,Маған оның ойыны ұнайды⸺
Dialogue: 0,0:18:00.41,0:18:03.99,Default,,0,0,0,,Мен бүкіл алаңның құстың тамаша көрінісін көрдім!
Dialogue: 0,0:18:04.54,0:18:05.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.37,0:18:08.21,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:18:09.58,0:18:12.42,Default,,0,0,0,,Қорытынды емтиханға өту үшін 11 үміткерді таңдаңыз
Dialogue: 0,0:18:18.18,0:18:21.14,Default,,0,0,0,,Сен онша жақсы жей алмайсың, Аой.
Dialogue: 0,0:18:22.14,0:18:24.22,Default,,0,0,0,,Неліктен Отомо көбірек тамақтанбайды?
Dialogue: 0,0:18:24.43,0:18:27.98,Default,,0,0,0,,Мені іріктеу нәтижесі алаңдатады, бірақ бұл бәрі емес.
Dialogue: 0,0:18:28.56,0:18:32.23,Default,,0,0,0,,Мен соңында допқа араласпай қалдым.
Dialogue: 0,0:18:33.40,0:18:36.07,Default,,0,0,0,,Соичиро Тачибана Акинори Канеда
Dialogue: 0,0:18:36.82,0:18:39.20,Default,,0,0,0,,Юдай Хасегава Йонг-сик Ли
Dialogue: 0,0:18:39.82,0:18:41.66,Default,,0,0,0,,Бұл бөлік дұрыс па?
Dialogue: 0,0:18:42.95,0:18:44.99,Default,,0,0,0,,Цукишима Сіздің пікіріңіз қандай?
Dialogue: 0,0:18:45.83,0:18:49.12,Default,,0,0,0,,Эйсаку Отомо! ол шынымен күлкілі болды
Dialogue: 0,0:18:49.41,0:18:50.87,Default,,0,0,0,,Эйсаку Отомо?
Dialogue: 0,0:18:51.17,0:18:53.96,Default,,0,0,0,,Ескертуге тұрарлық ештеңе жоқ деп ойлаймын...
Dialogue: 0,0:18:54.17,0:18:57.26,Default,,0,0,0,,Бұл ойын емес, алаңдағы және алаңнан тыс әрекет.
Dialogue: 0,0:18:57.51,0:18:58.55,Default,,0,0,0,,Барлығы байқады ма?
Dialogue: 0,0:18:58.76,0:19:00.55,Default,,0,0,0,,Әрине (Безен) Мен де.
Dialogue: 0,0:19:00.97,0:19:03.93,Default,,0,0,0,,Таңдауға дейін де, басталғаннан кейін де ол⸺
Dialogue: 0,0:19:04.10,0:19:06.18,Default,,0,0,0,,Мен әртүрлі ойыншылармен сөйлестім.
Dialogue: 0,0:19:06.47,0:19:10.94,Default,,0,0,0,,Тек сіздің нөміріңізге жақын ақ бастары бар ойыншылар үшін.
Dialogue: 0,0:19:11.40,0:19:12.40,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:19:12.65,0:19:15.73,Default,,0,0,0,,Шағын ойында жұптасуы мүмкін болашақ студенттермен⸺
Dialogue: 0,0:19:15.86,0:19:17.65,Default,,0,0,0,,Алдын ала хабарласыңыз⸺
Dialogue: 0,0:19:18.03,0:19:20.86,Default,,0,0,0,,Мен оның мінезін, ойын мәнерін анықтауға тырыстым.
Dialogue: 0,0:19:21.28,0:19:22.91,Default,,0,0,0,,Тым көп ойлау...
Dialogue: 0,0:19:23.16,0:19:26.33,Default,,0,0,0,,Ноннон Бұны айтатын менмін, сондықтан оған күмәнім жоқ.
Dialogue: 0,0:19:26.45,0:19:28.00,Default,,0,0,0,,Ол тапқыр
Dialogue: 0,0:19:28.16,0:19:30.96,Default,,0,0,0,,Сондай-ақ, сіздің команда шағын ойында қолайсыз жағдайда болған кезде⸺
Dialogue: 0,0:19:31.08,0:19:33.46,Default,,0,0,0,,Ол ғана дыбыс шығарды.
Dialogue: 0,0:19:34.38,0:19:36.71,Default,,0,0,0,,Орта ойын бұл жолы әлсіз.
Dialogue: 0,0:19:37.17,0:19:38.21,Default,,0,0,0,,Не қалды...
Dialogue: 0,0:19:38.51,0:19:40.05,Default,,0,0,0,,Енді мәселе...
Dialogue: 0,0:19:40.55,0:19:41.76,Default,,0,0,0,,Ашито Аои
Dialogue: 0,0:19:42.63,0:19:44.97,Default,,0,0,0,,Пікірлері көп бөлінетін бала осы.
Dialogue: 0,0:19:46.93,0:19:47.85,Default,,0,0,0,,О...
Dialogue: 0,0:19:52.69,0:19:54.23,Default,,0,0,0,,Менің атым Дарио Брандо.
Dialogue: 0,0:19:54.69,0:19:57.36,Default,,0,0,0,,көремін. Бұл асханадағы ханым ба?
Dialogue: 0,0:19:57.44,0:19:58.82,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:19:58.94,0:20:01.03,Default,,0,0,0,,Сіз маған ертерек таңдауға көмектестіңіз!
Dialogue: 0,0:20:01.20,0:20:02.86,Default,,0,0,0,,Тек бүгінге арналған ерікті
Dialogue: 0,0:20:03.16,0:20:04.66,Default,,0,0,0,,Әдетте кіші мектеп оқушысы
Dialogue: 0,0:20:05.12,0:20:07.45,Default,,0,0,0,,Оның орнына сіз басқа толтыра алмайсыз.
Dialogue: 0,0:20:07.83,0:20:08.83,Default,,0,0,0,,Иә!?
Dialogue: 0,0:20:09.54,0:20:10.70,Default,,0,0,0,,Әрине!
Dialogue: 0,0:20:10.83,0:20:13.92,Default,,0,0,0,,Қорытынды емтиханға жеткен бойда менде тағы бір матч болады.
Dialogue: 0,0:20:14.21,0:20:15.42,Default,,0,0,0,,Ал сен⸺
Dialogue: 0,0:20:15.54,0:20:18.75,Default,,0,0,0,,Сіз қорытылуы қиын майлы тағамдарды көп жейсіз бе?
Dialogue: 0,0:20:18.84,0:20:19.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:20.84,0:20:21.72,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:20:22.30,0:20:24.76,Default,,0,0,0,,Сен сияқты болашағын ойламайтындар бар⸺
Dialogue: 0,0:20:24.97,0:20:27.97,Default,,0,0,0,,Олардың мұндай әдемі өтуді есептегеніне сене алар емеспін.
Dialogue: 0,0:20:28.72,0:20:30.93,Default,,0,0,0,,Бұл кездейсоқтық па?
Dialogue: 0,0:20:33.48,0:20:36.48,Default,,0,0,0,,Шынымды айтсам, өзім де түсінбеймін.
Dialogue: 0,0:20:37.81,0:20:39.86,Default,,0,0,0,,Осы уақытқа дейін мен толығымен жеңілдім⸺
Dialogue: 0,0:20:40.07,0:20:43.36,Default,,0,0,0,,Мен бірдеңе істеуім керек деп далаға қарадым.
Dialogue: 0,0:20:46.37,0:20:47.28,Default,,0,0,0,,Бұл әдет
Dialogue: 0,0:20:47.87,0:20:50.16,Default,,0,0,0,,Мен далаға қарасам, өзімді тыныш сезінемін.
Dialogue: 0,0:20:50.66,0:20:53.04,Default,,0,0,0,,Одан көп есімде жоқ.
Dialogue: 0,0:20:53.91,0:20:55.92,Default,,0,0,0,,Осыдан кейін сіздің денеңіз қалғанын жасайды...
Dialogue: 0,0:20:56.04,0:20:58.75,Default,,0,0,0,,Түсіндім! Сонда бұл бір болжам болса керек!
Dialogue: 0,0:20:58.88,0:20:59.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:00.21,0:21:01.63,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:21:01.71,0:21:04.68,Default,,0,0,0,,Мен бұл кіші мектеп оқушысы еліктейтін нәрсе емес деп ойладым.
Dialogue: 0,0:21:05.22,0:21:06.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:06.89,0:21:09.55,Default,,0,0,0,,Менің әлемдегі ең сүйікті футболшым⸺
Dialogue: 0,0:21:09.89,0:21:11.81,Default,,0,0,0,,Ол бәрібір бұл туралы ойлағанын айтты.
Dialogue: 0,0:21:12.56,0:21:15.85,Default,,0,0,0,,Жаттығуда, ойындарда, тіпті футбол ойнамағанда⸺
Dialogue: 0,0:21:16.10,0:21:19.31,Default,,0,0,0,,Ойлан... Ойлан және ойла...
Dialogue: 0,0:21:20.19,0:21:21.27,Default,,0,0,0,,Ойлау...
Dialogue: 0,0:21:22.36,0:21:23.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:23.61,0:21:24.61,Default,,0,0,0,,Содан кейін⸺
Dialogue: 0,0:21:24.74,0:21:27.78,Default,,0,0,0,,Ақырында көп нәрсені ойланбастан жасай аласыз.
Dialogue: 0,0:21:28.49,0:21:32.37,Default,,0,0,0,,Сонда ол сіздікі болады...
Dialogue: 0,0:21:33.04,0:21:36.08,Default,,0,0,0,,Бұл ұқсайды, бірақ менің түйсігімнен басқа...
Dialogue: 0,0:21:38.17,0:21:39.08,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:21:39.63,0:21:41.80,Default,,0,0,0,,«Адам – ойлайтын құрақ»
Dialogue: 0,0:21:42.80,0:21:45.34,Default,,0,0,0,,Сәлем, мен Хана Ичиджомын.
Dialogue: 0,0:21:45.72,0:21:48.47,Default,,0,0,0,,Директор Фукуданың балдызы.
Dialogue: 0,0:21:49.34,0:21:50.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:55.68,0:21:57.27,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:21:57.35,0:21:59.86,Default,,0,0,0,,23 жастағы жас арыстан Тацуя Фукуда!
Dialogue: 0,0:22:00.36,0:22:03.07,Default,,0,0,0,,Өз мақсатыңыздан шыққан лазер сәулесі сияқты⸺
Dialogue: 0,0:22:03.19,0:22:05.07,Default,,0,0,0,,Ұзақ беру~!
Dialogue: 0,0:22:05.15,0:22:06.15,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:22:09.66,0:22:10.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:23.71,0:22:25.26,Default,,0,0,0,,Барлық емтихан тапсырушыларға⸺
Dialogue: 0,0:22:25.34,0:22:26.72,Default,,0,0,0,,Біз сізге хабарласамыз.
Dialogue: 0,0:22:27.92,0:22:31.05,Default,,0,0,0,,Қорытынды емтиханнан сәтті өткен үміткерлерді іріктеу аяқталды.
Dialogue: 0,0:22:31.68,0:22:33.64,Default,,0,0,0,,Жерге жиналыңдар.
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:24.21,0:24:25.92,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:26.42,0:24:27.84,Default,,0,0,0,,«Қорытынды емтиханның басталуы»
Dialogue: 0,0:24:29.34,0:24:35.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory