Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.25,0:00:09.92,Default,,0,0,0,,Неліктен Курода мен Асари?
Dialogue: 0,0:00:10.21,0:00:12.47,Default,,0,0,0,,Мен саған ашуымды шығардым ба?
Dialogue: 0,0:00:13.43,0:00:14.88,Default,,0,0,0,,Жауабын табыңыз
Dialogue: 0,0:00:15.64,0:00:18.22,Default,,0,0,0,,Бұл сіздің келесі тапсырмаңыз.
Dialogue: 0,0:00:18.60,0:00:19.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:20.56,0:00:21.43,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:00:21.81,0:00:23.64,Default,,0,0,0,,Мен өзімді сергек сезінемін~
Dialogue: 0,0:00:24.69,0:00:25.90,Default,,0,0,0,,Иә? Сіз
Dialogue: 0,0:00:26.15,0:00:28.65,Default,,0,0,0,,Бүгін күні бойы ұйықтауды жоспарлайсыз ба?
Dialogue: 0,0:00:28.98,0:00:32.07,Default,,0,0,0,,Дүйсенбі Мен аптасына бір рет толық демалыс аламын.
Dialogue: 0,0:00:32.65,0:00:34.90,Default,,0,0,0,,Сіз ойнай алатын болсаңыз, жай ғана ойнаңыз!
Dialogue: 0,0:00:35.95,0:00:38.95,Default,,0,0,0,,Менің басқа баратын жерім жоқ.
Dialogue: 0,0:00:40.04,0:00:46.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.91,0:02:09.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:12.29,0:02:13.34,Default,,0,0,0,,Көктемгі демалыс⸺
Dialogue: 0,0:02:13.71,0:02:15.88,Default,,0,0,0,,Барлығы ата-анасының үйіне қайтып бара жатқан сияқты.
Dialogue: 0,0:02:16.71,0:02:18.09,Default,,0,0,0,,Сізге де біраз демалу керек.
Dialogue: 0,0:02:18.76,0:02:21.34,Default,,0,0,0,,Менде де кір жиналды.
Dialogue: 0,0:02:21.76,0:02:24.56,Default,,0,0,0,,Мен жатақханада киімдерімді жуғанды ​​ыңғайсыз сезінемін.
Dialogue: 0,0:02:24.72,0:02:26.64,Default,,0,0,0,,Жастардың түсу емтиханын тапсыруды жем ретінде қолданамын⸺
Dialogue: 0,0:02:26.72,0:02:28.85,Default,,0,0,0,,Мен туған жерімнен қыздарды алып кетемін!
Dialogue: 0,0:02:29.27,0:02:30.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:30.19,0:02:33.40,Default,,0,0,0,,Біз Токиода тұрамыз, сондықтан баратын үйіміз бар...
Dialogue: 0,0:02:33.94,0:02:34.69,Default,,0,0,0,,Ашито...
Dialogue: 0,0:02:34.77,0:02:38.99,Default,,0,0,0,,Жоқ~ Хахахаха Ахахаха Ахахаха
Dialogue: 0,0:02:39.49,0:02:40.74,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:02:41.03,0:02:43.53,Default,,0,0,0,,Осы мүмкіндікті пайдаланып, барлығының бөлмесіне кіріп кетіңіз⸺
Dialogue: 0,0:02:43.78,0:02:46.24,Default,,0,0,0,,Эротикалық кітаптарды зерттеп, жыныстық бейімділіктеріңізді тексеріңіз
Dialogue: 0,0:02:46.45,0:02:48.16,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:50.25,0:02:52.67,Default,,0,0,0,,Мен Канагава Шонанға барамын
Dialogue: 0,0:02:53.59,0:02:55.84,Default,,0,0,0,,Менің туған қаламда негрлердің жиналысы болып жатыр
Dialogue: 0,0:02:56.05,0:02:57.51,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:02:57.92,0:03:00.93,Default,,0,0,0,,Меніңше, әлі де жергілікті емес адамдар бар.
Dialogue: 0,0:03:01.09,0:03:01.97,Default,,0,0,0,,Мысалы⸺
Dialogue: 0,0:03:02.68,0:03:04.05,Default,,0,0,0,,2 курс Акутсу
Dialogue: 0,0:03:04.51,0:03:06.35,Default,,0,0,0,,Ол өзінің Канто аймағынан емес екенін айтады.
Dialogue: 0,0:03:06.60,0:03:07.64,Default,,0,0,0,,Егер сіз араласқыңыз келсе...
Dialogue: 0,0:03:07.81,0:03:09.98,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:03:10.14,0:03:12.73,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:15.94,0:03:16.86,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:03:18.11,0:03:20.95,Default,,0,0,0,,Мен ата-анамның үйіне қайтып келгенде, мен ұмытып кеткен нәрсені алуым керек.
Dialogue: 0,0:03:21.28,0:03:22.11,Default,,0,0,0,,Жоспар
Dialogue: 0,0:03:23.24,0:03:24.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:24.78,0:03:25.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.88,0:03:37.96,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:03:40.88,0:03:44.72,Default,,0,0,0,,Ойлап қарасаңыз, сол қызыл-ақ соғыстан бері мен⸺
Dialogue: 0,0:03:45.26,0:03:48.39,Default,,0,0,0,,Жоғары көтерілген студенттермен дұрыс сөйлеспеңіз.
Dialogue: 0,0:03:49.06,0:03:51.27,Default,,0,0,0,,Хабарламаны рұқсаттама арқылы ала алмайсыз ба?
Dialogue: 0,0:03:51.73,0:03:54.10,Default,,0,0,0,,Аой! Біздің қозғалыстарымызға мұқият қараңыз!
Dialogue: 0,0:03:55.56,0:03:56.77,Default,,0,0,0,,Мүмкін мен⸺
Dialogue: 0,0:03:58.11,0:04:00.44,Default,,0,0,0,,Олардың не істей алатыны анық⸺
Dialogue: 0,0:04:00.61,0:04:01.78,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:03.82,0:04:08.20,Default,,0,0,0,,Менің ойымша, олар бізді әлі де доспыз деп ойламайды.
Dialogue: 0,0:04:11.87,0:04:14.37,Default,,0,0,0,,Жергілікті жігіттерді шақырсаңыз да...
Dialogue: 0,0:04:15.88,0:04:16.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:18.63,0:04:21.21,Default,,0,0,0,,Әй, шырағым, қоңырау шалғанда не айтып тұрсың?
Dialogue: 0,0:04:27.97,0:04:31.93,Default,,0,0,0,,Мұнда кел, жарты ай болды, мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:04:35.56,0:04:37.11,Default,,0,0,0,,Менің айтарым жоқ.
Dialogue: 0,0:04:39.61,0:04:40.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:41.82,0:04:44.32,Default,,0,0,0,,Иә! Бұл туралы ойламаңыз!
Dialogue: 0,0:04:44.70,0:04:47.07,Default,,0,0,0,,Бүгін тағы бір негізгі дайындық күні!
Dialogue: 0,0:04:47.45,0:04:50.95,Default,,0,0,0,,Өшіп қалса да, бар күшімді салып, соларға беремін!
Dialogue: 0,0:04:51.04,0:04:52.04,Default,,0,0,0,,Ашито
Dialogue: 0,0:04:56.79,0:04:59.71,Default,,0,0,0,,Ашито Ей, мектепке барайық. Мектеп
Dialogue: 0,0:04:59.92,0:05:01.80,Default,,0,0,0,,Орта мектеп Сіз оны көруге әлі барған жоқсыз, солай ма?
Dialogue: 0,0:05:02.09,0:05:05.80,Default,,0,0,0,,Мен сізбен бір орта мектепте оқимын, сондықтан мен сізге айналаңызды көрсетемін. Кәне!
Dialogue: 0,0:05:06.38,0:05:08.93,Default,,0,0,0,,Не ойлап тұрсың, гүл!
Dialogue: 0,0:05:09.72,0:05:11.01,Default,,0,0,0,,Бұл ұлдар жатақханасы!
Dialogue: 0,0:05:11.10,0:05:13.39,Default,,0,0,0,,Мұны қарапайым деп қабылдамаңыз!
Dialogue: 0,0:05:13.81,0:05:16.81,Default,,0,0,0,,Ұялы телефоның жоқ па?
Dialogue: 0,0:05:17.02,0:05:18.81,Default,,0,0,0,,Оның үстіне мен мектепке бармаймын...
Dialogue: 0,0:05:19.19,0:05:20.06,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:20.57,0:05:22.15,Default,,0,0,0,,Енді бәрі...
Dialogue: 0,0:05:22.23,0:05:23.07,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:24.53,0:05:25.45,Default,,0,0,0,,Нихихи
Dialogue: 0,0:05:26.15,0:05:29.70,Default,,0,0,0,,Жоқ, жоқ, сен әтіріңді ұмытып кетіпсің.
Dialogue: 0,0:05:29.87,0:05:31.33,Default,,0,0,0,,Онсыз феромондар...
Dialogue: 0,0:05:31.41,0:05:34.58,Default,,0,0,0,,Жас болсаң, жол ережесін сақтау керек.
Dialogue: 0,0:05:34.91,0:05:36.58,Default,,0,0,0,,Енді итеруге бар күшіңізді салыңыз.
Dialogue: 0,0:05:38.25,0:05:39.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:41.25,0:05:42.63,Default,,0,0,0,,Ештеңе болған жоқ.
Dialogue: 0,0:05:46.09,0:05:47.22,Default,,0,0,0,,Сіз құтқарылдыңыз, солай ма?
Dialogue: 0,0:05:49.22,0:05:50.26,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:05:50.85,0:05:52.31,Default,,0,0,0,,Мұның бәрі менің арқам, солай ма?
Dialogue: 0,0:05:53.51,0:05:54.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:58.90,0:06:00.36,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:06:00.44,0:06:01.81,Default,,0,0,0,,Да~хахаха! (Гүл) Нууу~!
Dialogue: 0,0:06:01.90,0:06:04.57,Default,,0,0,0,,Ахаха уаааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:06:04.73,0:06:06.69,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:06:11.53,0:06:13.45,Default,,0,0,0,,Мен жарақат алсам не істеуім керек?
Dialogue: 0,0:06:13.53,0:06:14.08,Default,,0,0,0,,Жарақат?
Dialogue: 0,0:06:14.95,0:06:15.91,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:06:16.29,0:06:18.08,Default,,0,0,0,,Ұмытпай тұрып маған берме.
Dialogue: 0,0:06:18.83,0:06:19.71,Default,,0,0,0,,Хой
Dialogue: 0,0:06:20.12,0:06:21.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:23.25,0:06:24.67,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:06:24.96,0:06:27.05,Default,,0,0,0,,Бұл мәзір кестесі қандай?
Dialogue: 0,0:06:27.30,0:06:29.34,Default,,0,0,0,,Ал... тағы да!?
Dialogue: 0,0:06:30.01,0:06:34.35,Default,,0,0,0,,Тыңдаңыз, денеңізді зақымдамай құрудың кілті - сіздің диетаңыз.
Dialogue: 0,0:06:34.85,0:06:38.02,Default,,0,0,0,,Бұрынғыдай, бірақ неге бұлай істеп жатырсың...
Dialogue: 0,0:06:38.52,0:06:41.77,Default,,0,0,0,,Қалағанымша жей берші, о...
Dialogue: 0,0:06:43.19,0:06:46.57,Default,,0,0,0,,Бұл жолы келесі алты айға арналған Ахаха~
Dialogue: 0,0:06:47.07,0:06:48.53,Default,,0,0,0,,Енді алғыс айтыңыз.
Dialogue: 0,0:06:48.69,0:06:51.49,Default,,0,0,0,,«Рахмет, Хана Чан».
Dialogue: 0,0:06:51.99,0:06:54.58,Default,,0,0,0,,Мен бұл әйелге қарсымын⸺
Dialogue: 0,0:06:54.91,0:06:58.96,Default,,0,0,0,,Осы күнге дейін менде ешқашан өзгермейтін белгілі бір сезім бар.
Dialogue: 0,0:07:00.50,0:07:02.50,Default,,0,0,0,,Қандай қызық әйел.
Dialogue: 0,0:07:03.84,0:07:05.92,Default,,0,0,0,,Ашито~
Dialogue: 0,0:07:06.09,0:07:09.47,Default,,0,0,0,,Сіз білмей тұрып, сіз және әлгі сүйкімді қыз⸺
Dialogue: 0,0:07:09.55,0:07:11.84,Default,,0,0,0,,Флирт болатын қарым-қатынас...
Dialogue: 0,0:07:15.18,0:07:16.51,Default,,0,0,0,,Сіз қанша уақыт күтесіз?
Dialogue: 0,0:07:17.14,0:07:20.06,Default,,0,0,0,,Бізбен бірге ойнайық (Гүл) Иә? Ха~
Dialogue: 0,0:07:20.14,0:07:21.14,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:07:24.31,0:07:25.19,Default,,0,0,0,,Фуфу
Dialogue: 0,0:07:27.15,0:07:28.86,Default,,0,0,0,,Сіз танымалсыз ба?
Dialogue: 0,0:07:29.78,0:07:31.90,Default,,0,0,0,,Бұл балмұздақ сенікі ме?
Dialogue: 0,0:07:32.53,0:07:34.37,Default,,0,0,0,,Мен әдетте көп тамақтанбаймын.
Dialogue: 0,0:07:34.53,0:07:35.49,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:07:35.78,0:07:36.95,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:37.20,0:07:39.91,Default,,0,0,0,,Спортшылар үшін тамақ өте маңызды!
Dialogue: 0,0:07:40.54,0:07:42.25,Default,,0,0,0,,Зико баяғыда Жапонияға келгенде⸺
Dialogue: 0,0:07:42.33,0:07:44.67,Default,,0,0,0,,Спортшылар ақымақ сияқты тағамдар жейді⸺
Dialogue: 0,0:07:44.75,0:07:47.09,Default,,0,0,0,,Ол кәсіпқой емес деп ашуланды!
Dialogue: 0,0:07:47.38,0:07:48.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:48.92,0:07:52.22,Default,,0,0,0,,Сіз диетолог болуды мақсат етесіз бе?
Dialogue: 0,0:07:53.68,0:07:54.64,Default,,0,0,0,,Мен дәрігермін.
Dialogue: 0,0:07:55.26,0:07:57.31,Default,,0,0,0,,Сонымен қатар спорттық хирург
Dialogue: 0,0:07:57.72,0:08:00.81,Default,,0,0,0,,Сол үшін мен күнде ағылшын тілінен сабақ алып жүрмін⸺
Dialogue: 0,0:08:01.18,0:08:04.23,Default,,0,0,0,,Мен өте бос емеспін~ Өте жақсы~ Мен
Dialogue: 0,0:08:04.56,0:08:05.31,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:08:06.19,0:08:08.57,Default,,0,0,0,,Асари мен Курода неге ашуланды?
Dialogue: 0,0:08:08.94,0:08:10.69,Default,,0,0,0,,Жауабын табыңыз
Dialogue: 0,0:08:11.36,0:08:12.24,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:08:14.70,0:08:16.78,Default,,0,0,0,,Мен енді таң қалмаймын деп ойлаймын.
Dialogue: 0,0:08:17.33,0:08:18.53,Default,,0,0,0,,бай адамға үйленуді армандайтын әйелдердің кәсібі екенін естігенмін.
Dialogue: 0,0:08:19.04,0:08:20.29,Default,,0,0,0,,Мұнда келе жатып маған көп адам айқайлады.
Dialogue: 0,0:08:22.21,0:08:24.33,Default,,0,0,0,,Жоқ, менің басыма кірме
Dialogue: 0,0:08:25.50,0:08:26.63,Default,,0,0,0,,Мен тәжірибе жасағым келеді
Dialogue: 0,0:08:27.63,0:08:29.42,Default,,0,0,0,,Тезірек сауығып кет⸺
Dialogue: 0,0:08:29.67,0:08:32.59,Default,,0,0,0,,Мен командаға сәйкес болуым керек.
Dialogue: 0,0:08:36.93,0:08:39.35,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:08:39.64,0:08:41.56,Default,,0,0,0,,Токио Мейсен орта мектебі
Dialogue: 0,0:08:42.77,0:08:45.35,Default,,0,0,0,,Эсперион осы орта мектеппен байланысты⸺
Dialogue: 0,0:08:45.85,0:08:48.52,Default,,0,0,0,,Жастар командасына қосылған барлық ойыншылар жарамды⸺
Dialogue: 0,0:08:48.65,0:08:51.28,Default,,0,0,0,,Сіз бұл орта мектепке арнайы студент ретінде түсе аласыз.
Dialogue: 0,0:08:52.15,0:08:56.07,Default,,0,0,0,,Оқу ақысы арзан, барлық сыныптар мен мектептегі іс-шаралар⸺
Dialogue: 0,0:08:56.28,0:08:59.03,Default,,0,0,0,,Футболға ауыртпалық түсірмейтін оқу бағдарламасы жасалады.
Dialogue: 0,0:08:59.45,0:09:03.91,Default,,0,0,0,,А, саған рахмет, мен анама қажетсіз жүк артқан жоқпын.
Dialogue: 0,0:09:04.25,0:09:07.00,Default,,0,0,0,,Жарайды, бірақ сен Эхимеденсің.
Dialogue: 0,0:09:07.17,0:09:09.46,Default,,0,0,0,,Бұл басқаларға қарағанда үлкен жүк.
Dialogue: 0,0:09:10.54,0:09:11.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:12.59,0:09:13.97,Default,,0,0,0,,Мен бәрібір жаттығуым керек.
Dialogue: 0,0:09:14.42,0:09:15.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.51,0:09:17.26,Default,,0,0,0,,Мен мектепке баратын жолды білемін.
Dialogue: 0,0:09:17.68,0:09:19.05,Default,,0,0,0,,Рахмет сізге Хана Хонжа
Dialogue: 0,0:09:19.14,0:09:20.10,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:09:22.06,0:09:23.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.77,0:09:26.77,Default,,0,0,0,,Ашитоға демалу қажет болғанда демалыңыз
Dialogue: 0,0:09:27.60,0:09:28.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.06,0:09:32.40,Default,,0,0,0,,Тәжірибеде сапа деген нәрсе бар емес пе?
Dialogue: 0,0:09:33.48,0:09:35.99,Default,,0,0,0,,Бұны абайсызда жасаудың қажеті жоқ.
Dialogue: 0,0:09:37.45,0:09:41.83,Default,,0,0,0,,Мен сені алғаш кездестіргеннен бері ғажайып көздерің болды.
Dialogue: 0,0:09:42.03,0:09:42.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.95,0:09:44.12,Default,,0,0,0,,Мен істеп жатырмын⸺
Dialogue: 0,0:09:45.04,0:09:49.04,Default,,0,0,0,,Екінші жағынан, қорқынышты және қауіпті болатын кездер болады.
Dialogue: 0,0:09:50.29,0:09:53.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен сені әлі кездестірген жоқпын...
Dialogue: 0,0:09:53.46,0:09:55.92,Default,,0,0,0,,Мен оны бір рет Селекция мен Коухаку Сенде көрдім.
Dialogue: 0,0:09:56.84,0:10:01.05,Default,,0,0,0,,Мен де оның апатты екенін жаман сезінемін.
Dialogue: 0,0:10:01.72,0:10:02.85,Default,,0,0,0,,Уайымдаңыз
Dialogue: 0,0:10:05.18,0:10:06.10,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:10:09.31,0:10:10.65,Default,,0,0,0,,Соның ішінде⸺
Dialogue: 0,0:10:10.77,0:10:13.23,Default,,0,0,0,,Өйткені ол маған ұнаған ойыншыға ұқсайды.
Dialogue: 0,0:10:13.82,0:10:14.69,Default,,0,0,0,,Е...
Dialogue: 0,0:10:15.40,0:10:17.07,Default,,0,0,0,,Хмм... білесің...
Dialogue: 0,0:10:18.11,0:10:20.36,Default,,0,0,0,,Сүйікті ойыншы Менің сүйікті ойыншым⸺
Dialogue: 0,0:10:20.45,0:10:22.45,Default,,0,0,0,,Сіз бұлай айтқанда не істеуімді қалайсыз?
Dialogue: 0,0:10:22.53,0:10:23.62,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:10:23.70,0:10:26.95,Default,,0,0,0,,Ахахха Дұрыс...
Dialogue: 0,0:10:27.20,0:10:28.29,Default,,0,0,0,,Сізден кейін!
Dialogue: 0,0:10:28.50,0:10:30.04,Default,,0,0,0,,Мұны істеуді доғарыңыз!
Dialogue: 0,0:10:30.17,0:10:32.54,Default,,0,0,0,,Маған сен сияқты қатал әйел қамқор болады⸺
Dialogue: 0,0:10:32.67,0:10:34.67,Default,,0,0,0,,Қате түсінетін адамдар болады!
Dialogue: 0,0:10:35.05,0:10:37.09,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:10:37.30,0:10:40.01,Default,,0,0,0,,Уайымдама, мен зардап шекпеймін!
Dialogue: 0,0:10:40.38,0:10:43.05,Default,,0,0,0,,Мен өз денемді шынымен түсінемін!
Dialogue: 0,0:10:43.55,0:10:44.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:44.31,0:10:48.14,Default,,0,0,0,,Дұрыс, мен данышпан шабуылшы Ашито Аоимын!
Dialogue: 0,0:10:48.35,0:10:49.35,Default,,0,0,0,,Мен менмін!
Dialogue: 0,0:10:49.77,0:10:52.10,Default,,0,0,0,,Сондықтан біреуге ұқсайды! Гүл!
Dialogue: 0,0:10:52.23,0:10:54.11,Default,,0,0,0,,Бұл сіздің қиялыңыз ғана!
Dialogue: 0,0:10:54.32,0:10:57.07,Default,,0,0,0,,Мен саған айтамын, мен ол жігіт бола алмаймын!
Dialogue: 0,0:10:57.32,0:11:00.49,Default,,0,0,0,,Жоқ... олай айтқан жоқ!
Dialogue: 0,0:11:00.74,0:11:02.82,Default,,0,0,0,,Мен тәжірибе жасағым келді!
Dialogue: 0,0:11:03.28,0:11:04.12,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:04.58,0:11:05.91,Default,,0,0,0,,Бүгін не істей алмайсыз⸺
Dialogue: 0,0:11:05.99,0:11:07.91,Default,,0,0,0,,Мен мұны бүгін жасай алуым керек!
Dialogue: 0,0:11:08.95,0:11:12.46,Default,,0,0,0,,Мен жастықтың әлемін көрдім, соны білемін!
Dialogue: 0,0:11:13.83,0:11:16.55,Default,,0,0,0,,Жастық – 3 жыл. Уақыт шектеулі.
Dialogue: 0,0:11:17.25,0:11:20.13,Default,,0,0,0,,Тәжірибе жасағыңыз келсе, маған рұқсат етіңіз!
Dialogue: 0,0:11:21.18,0:11:23.22,Default,,0,0,0,,Маған қамқор болғаныңызға ризамын⸺
Dialogue: 0,0:11:23.64,0:11:25.81,Default,,0,0,0,,Ойыншылардың сезімін түсінбесеңіз...
Dialogue: 0,0:11:26.47,0:11:27.93,Default,,0,0,0,,Қосымша көмек қажет емес...
Dialogue: 0,0:11:30.23,0:11:31.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.31,0:11:35.44,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:11:37.07,0:11:38.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:38.40,0:11:40.82,Default,,0,0,0,,Әй... Әй, велосипед...
Dialogue: 0,0:11:46.58,0:11:47.54,Default,,0,0,0,,А... (Ашито) А?
Dialogue: 0,0:11:48.37,0:11:49.54,Default,,0,0,0,,Уф! (Ашито) Арх!
Dialogue: 0,0:11:58.88,0:12:01.09,Default,,0,0,0,,Ахх... ахх...
Dialogue: 0,0:12:01.17,0:12:03.68,Default,,0,0,0,,Хехехехехе~
Dialogue: 0,0:12:03.80,0:12:05.18,Default,,0,0,0,,Күтілгендей~
Dialogue: 0,0:12:05.30,0:12:09.85,Default,,0,0,0,,Әйелдер арасында танымал болу мүмкін емес деп ойладым.
Dialogue: 0,0:12:10.52,0:12:11.43,Default,,0,0,0,,Otomo?
Dialogue: 0,0:12:11.56,0:12:16.44,Default,,0,0,0,,Адамдардың сезімін аздап түсінсеңіз екен.
Dialogue: 0,0:12:17.02,0:12:19.40,Default,,0,0,0,,Мен де кеше ойын ойнағанда солай ойладым.
Dialogue: 0,0:12:19.69,0:12:20.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:32.71,0:12:36.67,Default,,0,0,0,,Бүгіннен бастап сіз менің Мейсен орта мектебімнің мүшесі боласыз⸺
Dialogue: 0,0:12:36.83,0:12:38.34,Default,,0,0,0,,Жақсы оқу...
Dialogue: 0,0:12:40.13,0:12:41.17,Default,,0,0,0,,Анри
Dialogue: 0,0:12:41.38,0:12:41.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:42.51,0:12:47.85,Default,,0,0,0,,Сіз әрқашан ақылды болдыңыз, сондықтан мен сізді жоғары мектепте оқимын деп ойладым.
Dialogue: 0,0:12:48.47,0:12:49.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:49.93,0:12:53.35,Default,,0,0,0,,Болашақта мен ұмтылатын мамандығым бойынша⸺
Dialogue: 0,0:12:53.73,0:12:57.15,Default,,0,0,0,,Мен сендермен бір мектеп ғимаратында болғаным дұрыс деп ойладым.
Dialogue: 0,0:12:57.77,0:13:00.36,Default,,0,0,0,,Сен әлі біртүрлісің.
Dialogue: 0,0:13:02.23,0:13:05.36,Default,,0,0,0,,Ой... Эй Юма, қазір не болып жатыр?
Dialogue: 0,0:13:05.49,0:13:07.57,Default,,0,0,0,,О, Отомо.
Dialogue: 0,0:13:08.24,0:13:11.54,Default,,0,0,0,,Бұл қыз Эсперионның бас компаниясының қызы.
Dialogue: 0,0:13:11.74,0:13:13.79,Default,,0,0,0,,Неге сонша таныс сөйлеп тұрсың?
Dialogue: 0,0:13:13.87,0:13:14.66,Default,,0,0,0,,О
Dialogue: 0,0:13:14.83,0:13:19.21,Default,,0,0,0,,Анам көптен бері үй шаруасында жұмыс істейді.
Dialogue: 0,0:13:19.59,0:13:22.63,Default,,0,0,0,,Сондықтан біз бір-бірімізді бала кезімізден білеміз.
Dialogue: 0,0:13:23.42,0:13:26.93,Default,,0,0,0,,Сонымен қатар, сізде керемет көрініс бар.
Dialogue: 0,0:13:27.01,0:13:28.18,Default,,0,0,0,,Бұл сынып
Dialogue: 0,0:13:28.97,0:13:30.30,Default,,0,0,0,,Отомо
Dialogue: 0,0:13:30.68,0:13:33.27,Default,,0,0,0,,Такешима Асари Курода
Dialogue: 0,0:13:33.60,0:13:35.81,Default,,0,0,0,,Тоғашы және...
Dialogue: 0,0:13:40.15,0:13:42.65,Default,,0,0,0,,Мен кеше ойын ойнағанда солай ойладым.
Dialogue: 0,0:13:44.40,0:13:47.36,Default,,0,0,0,,Otomo Сіз нені білдіреді...
Dialogue: 0,0:13:50.99,0:13:52.12,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:13:53.33,0:13:54.75,Default,,0,0,0,,Бір сәт ойланыңыз
Dialogue: 0,0:13:58.37,0:13:59.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:01.84,0:14:03.71,Default,,0,0,0,,Йо Ашито~ (Ашито) Уау
Dialogue: 0,0:14:04.21,0:14:07.84,Default,,0,0,0,,Содан бері 10 күн өтті. Жауабын алдың ба?
Dialogue: 0,0:14:07.93,0:14:09.34,Default,,0,0,0,,Ахаха~?
Dialogue: 0,0:14:09.51,0:14:12.35,Default,,0,0,0,,Ашито Хана, сен мені жылаттың.
Dialogue: 0,0:14:12.64,0:14:15.64,Default,,0,0,0,,Ол тез басталады, бірақ ол тез тасталады.
Dialogue: 0,0:14:15.72,0:14:16.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.98,0:14:18.27,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:14:18.35,0:14:21.77,Default,,0,0,0,,Ичиджо Хана деген қыз бұл сыныпта жоқ.
Dialogue: 0,0:14:22.48,0:14:25.53,Default,,0,0,0,,Өзімнің сүйкімді қыздар туралы сауалнамама сәйкес...
Dialogue: 0,0:14:26.44,0:14:27.99,Default,,0,0,0,,Жоғары ағылшын тілі бөлімі
Dialogue: 0,0:14:28.45,0:14:29.66,Default,,0,0,0,,Себебі мектеп ғимараттары әртүрлі⸺
Dialogue: 0,0:14:29.74,0:14:32.45,Default,,0,0,0,,Мектепте кездесіп қалуымыз мүмкін емес.
Dialogue: 0,0:14:32.70,0:14:35.49,Default,,0,0,0,,Кехихихихи Эхихихихи
Dialogue: 0,0:14:35.70,0:14:40.46,Default,,0,0,0,,Менің зерттеуім бойынша, ұрып-соққан әйелдің уақыты 24 сағат.
Dialogue: 0,0:14:40.54,0:14:43.00,Default,,0,0,0,,10 күн болды кешірім сұрай да алмаймын
Dialogue: 0,0:14:43.13,0:14:44.50,Default,,0,0,0,,Осымен аяқталды
Dialogue: 0,0:14:44.63,0:14:47.51,Default,,0,0,0,,Ашито, аяқтадың~
Dialogue: 0,0:14:48.51,0:14:49.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:50.34,0:14:54.76,Default,,0,0,0,,Ихихи~хехихи Ихихихихи Ихихахахахаха
Dialogue: 0,0:14:55.06,0:14:56.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:57.52,0:14:58.52,Default,,0,0,0,,Хаа~
Dialogue: 0,0:14:58.77,0:15:01.02,Default,,0,0,0,,Сіз көп нәрсеге алаңдайтын сияқтысыз.
Dialogue: 0,0:15:01.19,0:15:03.94,Default,,0,0,0,,Бірақ лига басталғанша кешіктірмеңіз.
Dialogue: 0,0:15:04.02,0:15:04.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:04.94,0:15:08.03,Default,,0,0,0,,В командасының да ресми матчтары бар.
Dialogue: 0,0:15:08.11,0:15:08.78,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:15:08.90,0:15:10.95,Default,,0,0,0,,Жастық шақ жақсы ғой.
Dialogue: 0,0:15:11.03,0:15:14.62,Default,,0,0,0,,Біз элиталық ойыншылардың шағын тобы болғандықтан, матчтарға қатысу мүмкіндігі көп.
Dialogue: 0,0:15:14.91,0:15:17.62,Default,,0,0,0,,Сондай-ақ, тіпті B командалары қатыса алатын лига бар⸺
Dialogue: 0,0:15:17.70,0:15:19.75,Default,,0,0,0,,Сондай-ақ практикалық тәжірибеңізді арттыра аласыз.
Dialogue: 0,0:15:20.75,0:15:22.92,Default,,0,0,0,,Матч Ресми матч…
Dialogue: 0,0:15:25.38,0:15:26.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:28.42,0:15:29.51,Default,,0,0,0,,Хмм! (Отомо) Иә?
Dialogue: 0,0:15:30.13,0:15:31.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:33.09,0:15:35.60,Default,,0,0,0,,Фу Йоши
Dialogue: 0,0:15:39.93,0:15:40.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:41.69,0:15:42.65,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:15:45.02,0:15:47.19,Default,,0,0,0,,Мен түсінбегенімді түсіндім.
Dialogue: 0,0:15:47.73,0:15:48.90,Default,,0,0,0,,Не деп тұрсың өзің?
Dialogue: 0,0:15:49.40,0:15:51.99,Default,,0,0,0,,Мен сенімен сөйлескім келмейді, кет.
Dialogue: 0,0:15:52.40,0:15:54.37,Default,,0,0,0,,Өйткені мен ақымақпын⸺
Dialogue: 0,0:15:54.87,0:15:57.37,Default,,0,0,0,,Маған айтпайынша, мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:15:57.66,0:15:59.87,Default,,0,0,0,,Бірақ неге кенеттен...
Dialogue: 0,0:16:00.50,0:16:04.04,Default,,0,0,0,,Иә, бұл менің кінәм... бірақ жылама.
Dialogue: 0,0:16:04.54,0:16:05.50,Default,,0,0,0,,Жылау?
Dialogue: 0,0:16:06.21,0:16:10.13,Default,,0,0,0,,Сондай-ақ, мен сендермен неге тіл табыса алмайтынымды білмеймін.
Dialogue: 0,0:16:10.76,0:16:13.43,Default,,0,0,0,,Түсінбесеңіз, мен көмектесе алмаймын. Оның орнына⸺
Dialogue: 0,0:16:14.22,0:16:15.55,Default,,0,0,0,,Мен туралы әңгімеле
Dialogue: 0,0:16:18.26,0:16:20.18,Default,,0,0,0,,Бірінші 11 21-ге қарсы
Dialogue: 0,0:16:20.81,0:16:25.02,Default,,0,0,0,,Мен сендерге соңғы ойында ашуланған кездегі ойымды айтайын.
Dialogue: 0,0:16:25.77,0:16:27.48,Default,,0,0,0,,Допты қақпаның алдында ұстау⸺
Dialogue: 0,0:16:27.61,0:16:30.28,Default,,0,0,0,,Допты бүйірге қойып, бірден кері жүгіріс жасаңыз.
Dialogue: 0,0:16:30.94,0:16:33.61,Default,,0,0,0,,Акутсудың артына жасырынып барып, қайтару билетін алыңыз⸺
Dialogue: 0,0:16:34.03,0:16:35.86,Default,,0,0,0,,Ату және ұпай жинау
Dialogue: 0,0:16:37.28,0:16:39.95,Default,,0,0,0,,Менің сол кезде ойлағаным осы еді.
Dialogue: 0,0:16:40.45,0:16:42.79,Default,,0,0,0,,Бірақ басқа адам сол Акутсу болатын.
Dialogue: 0,0:16:43.91,0:16:44.96,Default,,0,0,0,,Егер ол сізден болса⸺
Dialogue: 0,0:16:45.42,0:16:48.79,Default,,0,0,0,,Мен сенен асып түсемін деп армандаған жоқсың ғой, солай ма?
Dialogue: 0,0:16:49.55,0:16:52.76,Default,,0,0,0,,Бұл соншалықты абайсыз болып көрінгендіктен ашуландың емес пе?
Dialogue: 0,0:16:53.67,0:16:57.34,Default,,0,0,0,,Балалар, 10 күн бойы ойланып болғаннан кейін осылай сезінесіздер.
Dialogue: 0,0:16:57.89,0:16:59.56,Default,,0,0,0,,Жауаптың дұрыс па, бұрыс па екенін де білмеймін.
Dialogue: 0,0:17:00.01,0:17:01.85,Default,,0,0,0,,Бірақ мен мұны айта аламын.
Dialogue: 0,0:17:02.56,0:17:06.35,Default,,0,0,0,,Балалар мен сендермен ұпай жинау үшін жұмыс жасаймын!
Dialogue: 0,0:17:07.23,0:17:09.94,Default,,0,0,0,,Мен мұны қалай істеу керектігін ғана ойлаймын.
Dialogue: 0,0:17:10.69,0:17:11.78,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:17:12.23,0:17:14.36,Default,,0,0,0,,Мен бәрін айттым! Сіз жігіттер!?
Dialogue: 0,0:17:17.20,0:17:19.12,Default,,0,0,0,,Күтілгендей, биылғы жыл⸺
Dialogue: 0,0:17:19.53,0:17:22.08,Default,,0,0,0,,Дос болу үшін біраз уақыт қажет болуы мүмкін.
Dialogue: 0,0:17:23.37,0:17:26.00,Default,,0,0,0,,Мінезі күшті адамдар тым көп.
Dialogue: 0,0:17:26.50,0:17:30.54,Default,,0,0,0,,Бейресми атмосферада саналылығы жоғары топ және Аои және басқалар
Dialogue: 0,0:17:31.46,0:17:33.26,Default,,0,0,0,,Жаман жолмен қосылмау
Dialogue: 0,0:17:34.21,0:17:37.72,Default,,0,0,0,,Әсіресе Аои. Бұл шынымен дұрыс нәрсе болды ма?
Dialogue: 0,0:17:38.55,0:17:42.39,Default,,0,0,0,,Фукуда мен сіздің еркіңізді түсінемін, бірақ мен сізге осыны үйретуге тырысамын⸺
Dialogue: 0,0:17:43.10,0:17:45.02,Default,,0,0,0,,Қосымша тікелей кеңес...
Dialogue: 0,0:17:45.10,0:17:46.31,Default,,0,0,0,,Жоқ (Күні)...
Dialogue: 0,0:17:46.69,0:17:49.73,Default,,0,0,0,,Нозоми Сізге ыңғайлы болғаны.
Dialogue: 0,0:17:50.40,0:17:54.11,Default,,0,0,0,,Дұрыс жауапты жылдам айту нұсқаушының салғырттығы.
Dialogue: 0,0:17:54.86,0:17:55.69,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:56.24,0:17:59.07,Default,,0,0,0,,Адамдарды ойландыратын мағыналы.
Dialogue: 0,0:18:00.16,0:18:02.91,Default,,0,0,0,,Аоидың ісі ерекше сезімтал.
Dialogue: 0,0:18:04.29,0:18:07.33,Default,,0,0,0,,Бәрі сіз айтқандай болады деп үміттенемін...
Dialogue: 0,0:18:08.21,0:18:11.67,Default,,0,0,0,,Сіз В тобында болсаңыз, үміт сізге байланысты.
Dialogue: 0,0:18:12.29,0:18:15.42,Default,,0,0,0,,Спортшыны жасау немесе бұзу жаттықтырушыға байланысты.
Dialogue: 0,0:18:15.84,0:18:18.51,Default,,0,0,0,,Жарайды, Ашито бейбақ⸺
Dialogue: 0,0:18:19.26,0:18:21.89,Default,,0,0,0,,Айналмалы жолмен жүрсе де, жауабын әрқашан табасыз.
Dialogue: 0,0:18:24.85,0:18:27.64,Default,,0,0,0,,Түсіндім, бұл футбол әңгімесі.
Dialogue: 0,0:18:28.10,0:18:29.77,Default,,0,0,0,,Мен бортқа отырдым, Аои-кун.
Dialogue: 0,0:18:30.10,0:18:31.15,Default,,0,0,0,,Курода
Dialogue: 0,0:18:31.56,0:18:34.98,Default,,0,0,0,,Өткен аптадағы 11-ге қарсы 21 дұрыс па?
Dialogue: 0,0:18:35.15,0:18:36.74,Default,,0,0,0,,Жылдам, бізді Диоға апар.
Dialogue: 0,0:18:37.40,0:18:40.70,Default,,0,0,0,,Менімен қалай оңай сөйлесе аласыз?
Dialogue: 0,0:18:40.99,0:18:43.83,Default,,0,0,0,,Олай болса кезегің әлі.
Dialogue: 0,0:18:44.20,0:18:45.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.33,0:18:46.25,Default,,0,0,0,,Сол көрініс
Dialogue: 0,0:18:47.41,0:18:50.50,Default,,0,0,0,,Акутсу-сенпаймен бетпе-бет келмей ұпай жинаудың тағы бір жолы⸺
Dialogue: 0,0:18:50.83,0:18:52.54,Default,,0,0,0,,Әрине, сіз бұл туралы ойладыңыз, солай ма?
Dialogue: 0,0:18:53.59,0:18:55.92,Default,,0,0,0,,А... О, әрине!
Dialogue: 0,0:18:56.17,0:18:58.55,Default,,0,0,0,,Мен сөйлей аламын. Мен сөйлесе аламын.
Dialogue: 0,0:18:59.55,0:19:02.34,Default,,0,0,0,,Алдымен бүйірлік өзгерісті қосыңыз
Dialogue: 0,0:19:02.72,0:19:07.22,Default,,0,0,0,,Мен допты Тачибанаға сол жақтан беріп, оны оң жаққа кең тептім.
Dialogue: 0,0:19:08.27,0:19:10.69,Default,,0,0,0,,Осы кезде мен ортаға қарай жүгіремін.
Dialogue: 0,0:19:11.10,0:19:14.36,Default,,0,0,0,,Асариден оң жаққа қабаттасатын крестті алу⸺
Dialogue: 0,0:19:15.23,0:19:17.40,Default,,0,0,0,,Ұпайды мен шешемін!
Dialogue: 0,0:19:19.19,0:19:21.07,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:19:21.41,0:19:23.66,Default,,0,0,0,,Ол кезде оң жағы бос болатын.
Dialogue: 0,0:19:24.28,0:19:25.91,Default,,0,0,0,,Бұл өріс өрісі болмаса да⸺
Dialogue: 0,0:19:25.99,0:19:28.33,Default,,0,0,0,,Футбол туралы осылай айтуға болады!
Dialogue: 0,0:19:29.12,0:19:30.87,Default,,0,0,0,,Екіншісі қарапайым⸺
Dialogue: 0,0:19:31.21,0:19:33.54,Default,,0,0,0,,Оны мақсаттың алдында Роан немесе Тачибана қалдырыңыз⸺
Dialogue: 0,0:19:33.96,0:19:36.63,Default,,0,0,0,,Осыдан кейін оны адам санына қалдырып, мақсатқа асығыңыз⸺
Dialogue: 0,0:19:36.84,0:19:38.76,Default,,0,0,0,,Вача вача, сіз қай жерде шатастырдыңыз⸺
Dialogue: 0,0:19:39.42,0:19:42.89,Default,,0,0,0,,Мақсатқа жақын тұрған маған қарай ұзақ пас беруін сұраңыз.
Dialogue: 0,0:19:43.09,0:19:44.64,Default,,0,0,0,,Ал мен мақсатпын!
Dialogue: 0,0:19:45.30,0:19:46.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:47.22,0:19:48.68,Default,,0,0,0,,Түбірлер менімен бірдей
Dialogue: 0,0:19:48.77,0:19:50.52,Default,,0,0,0,,Өйткені, мен футболды жақсы көремін.
Dialogue: 0,0:19:50.89,0:19:52.52,Default,,0,0,0,,Біз бір-бірімізді түсінеміз, солай ма?
Dialogue: 0,0:19:53.02,0:19:54.77,Default,,0,0,0,,Үшінші ықтималдығы аз⸺
Dialogue: 0,0:19:55.15,0:19:56.90,Default,,0,0,0,,Акутсу маған жақындамас бұрын⸺
Dialogue: 0,0:19:56.98,0:19:59.74,Default,,0,0,0,,Тачибанаға өтіп кеткендей кейіп таныту, бірақ шын мәнінде финтинг
Dialogue: 0,0:19:59.90,0:20:01.36,Default,,0,0,0,,Менің ортаммен тура соғыңыз...
Dialogue: 0,0:20:01.45,0:20:02.78,Default,,0,0,0,,Жетеді (Ашито) А...
Dialogue: 0,0:20:03.03,0:20:03.99,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:05.41,0:20:08.54,Default,,0,0,0,,Неліктен бәрі сіздің ұпай алуыңызға негізделген?
Dialogue: 0,0:20:10.12,0:20:10.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:13.96,0:20:17.46,Default,,0,0,0,,Ең алдымен, ұпай жинауға деген күшті үйір болудан бас тартыңыз.
Dialogue: 0,0:20:17.88,0:20:19.17,Default,,0,0,0,,Бұл оқиға
Dialogue: 0,0:20:20.38,0:20:21.72,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:20:22.01,0:20:24.64,Default,,0,0,0,,Сіздің жағдайыңызда бұл мүлдем басқаша.
Dialogue: 0,0:20:25.18,0:20:27.22,Default,,0,0,0,,Жастық шаққа қалай жетуге болады... (Ашито) Сәл күте тұрыңыз.
Dialogue: 0,0:20:28.39,0:20:29.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:29.43,0:20:32.81,Default,,0,0,0,,Сол кезде сендер ашуландыңдар ма?
Dialogue: 0,0:20:34.69,0:20:37.56,Default,,0,0,0,,Бұл не? Мен шабуылшымын.
Dialogue: 0,0:20:38.44,0:20:40.57,Default,,0,0,0,,Нүктелерге назар аударудың қандай қатесі бар?
Dialogue: 0,0:20:41.15,0:20:42.90,Default,,0,0,0,,Ұпайларға әуестенуден бас тарту керек пе?
Dialogue: 0,0:20:43.03,0:20:45.99,Default,,0,0,0,,Мұндай шабуылшы сол сәттен бастап өледі!
Dialogue: 0,0:20:46.53,0:20:48.99,Default,,0,0,0,,Әлемдегі ең үздік шабуылшы болу⸺
Dialogue: 0,0:20:49.08,0:20:50.08,Default,,0,0,0,,Мен Эсперионға келдім!
Dialogue: 0,0:20:50.91,0:20:52.29,Default,,0,0,0,,Өйткені, бұл сіз⸺
Dialogue: 0,0:20:52.41,0:20:54.79,Default,,0,0,0,,Жастыққа неге қоятындарын білмеймін.
Dialogue: 0,0:20:55.29,0:20:56.88,Default,,0,0,0,,Себебі сіз өттіңіз⸺
Dialogue: 0,0:20:57.17,0:20:59.09,Default,,0,0,0,,Кіші жастан көтеріле алмады⸺
Dialogue: 0,0:20:59.17,0:21:00.75,Default,,0,0,0,,Сыныптастарымды ойласам...
Dialogue: 0,0:21:02.97,0:21:04.93,Default,,0,0,0,,Не айтып тұрсыз?
Dialogue: 0,0:21:05.47,0:21:07.97,Default,,0,0,0,,Otomo Оның сізге еш қатысы жоқ.
Dialogue: 0,0:21:08.43,0:21:12.43,Default,,0,0,0,,Ашито екеуміз Селекциямен күресу үшін өмірімізді қатерге тіктік.
Dialogue: 0,0:21:13.14,0:21:14.31,Default,,0,0,0,,Құлап қалсаң бітті
Dialogue: 0,0:21:15.23,0:21:18.02,Default,,0,0,0,,Мен де сіз сияқты жағдайларды жеңдім және осындамын.
Dialogue: 0,0:21:19.19,0:21:21.57,Default,,0,0,0,,Нәтижелері сізді қызықтырмаса, мен сізді кешіремін.
Dialogue: 0,0:21:21.90,0:21:24.11,Default,,0,0,0,,Ал сол кезең кім үлгере алмады?
Dialogue: 0,0:21:24.70,0:21:26.28,Default,,0,0,0,,Сен түкке тұрғысыз флиртсің!
Dialogue: 0,0:21:26.36,0:21:26.99,Default,,0,0,0,,Бұл қоқыс!?
Dialogue: 0,0:21:27.24,0:21:28.87,Default,,0,0,0,,Кя!
Dialogue: 0,0:21:28.95,0:21:30.99,Default,,0,0,0,,Сенен көңілім қалды!
Dialogue: 0,0:21:31.33,0:21:32.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:32.45,0:21:34.41,Default,,0,0,0,,Жібер, Такешима Курода! (Курода) А...
Dialogue: 0,0:21:35.50,0:21:37.62,Default,,0,0,0,,Асари Отомо дұрыс айтады.
Dialogue: 0,0:21:38.17,0:21:39.42,Default,,0,0,0,,Соңғысы басқа.
Dialogue: 0,0:21:40.50,0:21:41.46,Default,,0,0,0,,Қайта айтпа
Dialogue: 0,0:21:42.92,0:21:43.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:52.97,0:21:57.35,Default,,0,0,0,,Екеуіңіз мен ұпай жинауға ерекше көңіл бөлгенім үшін ашуландыңыз ба?
Dialogue: 0,0:21:58.06,0:22:00.11,Default,,0,0,0,,Сондай ақымақ әңгіме бар ма?
Dialogue: 0,0:22:00.65,0:22:01.57,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:22:01.90,0:22:04.82,Default,,0,0,0,,Біртүрлі сезінуі мүмкін емес.
Dialogue: 0,0:22:05.61,0:22:08.11,Default,,0,0,0,,Сөздердің мағынасын дәл айттыңыз ба?
Dialogue: 0,0:22:08.61,0:22:10.62,Default,,0,0,0,,О... Нозоми-сан
Dialogue: 0,0:22:11.78,0:22:15.87,Default,,0,0,0,,Дәл уақытында, Аой, мен сенімен сөйлестім.
Dialogue: 0,0:22:16.41,0:22:19.12,Default,,0,0,0,,Келесі аптада сіз негізгі құрамда боласыз.
Dialogue: 0,0:22:19.42,0:22:20.25,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:22:20.63,0:22:22.88,Default,,0,0,0,,Алайда, сол матчта⸺
Dialogue: 0,0:22:23.25,0:22:26.01,Default,,0,0,0,,Маған бұрын берілген тапсырманы орындаған пьеса көрсетіңіз.
Dialogue: 0,0:22:26.63,0:22:28.68,Default,,0,0,0,,Өшіре алмасаңыз⸺
Dialogue: 0,0:22:30.01,0:22:33.18,Default,,0,0,0,,Мен сізді келесі үш айда ешбір матчта қолданбаймын.
Dialogue: 0,0:22:33.47,0:22:34.72,Default,,0,0,0,,Өлім ерік-жігерімен шақыру
Dialogue: 0,0:22:36.02,0:22:42.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:59.89,0:24:05.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:23.67,0:24:25.00,Default,,0,0,0,,Келесі жолы «Аоаши»
Dialogue: 0,0:24:25.13,0:24:28.25,Default,,0,0,0,,«Токио Лигасының 1-секциясының Seikyo High School матчы»
Dialogue: 0,0:24:29.75,0:24:35.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory