Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:48.10,0:00:49.46,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:49.46,0:00:50.70,Default,,0,0,0,,Есеп № 006
Dialogue: 0,0:00:50.92,0:00:52.70,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:00:53.38,0:00:55.64,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:00:55.92,0:00:57.44,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:01:01.68,0:01:05.72,Default,,0,0,0,,Бастауыш сынып оқушыларының класс жетекшісі болғаныңызға көп болды ғой, иә?
Dialogue: 0,0:01:06.28,0:01:07.76,Default,,0,0,0,,Биыл қалай?
Dialogue: 0,0:01:08.46,0:01:10.78,Default,,0,0,0,,Олар – еңбек етуге тұрарлық оқушылар тобы.
Dialogue: 0,0:01:12.58,0:01:16.56,Default,,0,0,0,,Естуімше, алғашқы күні-ақ оларға «Тонито» бергенсің.
Dialogue: 0,0:01:19.86,0:01:23.40,Default,,0,0,0,,Бұл беделді Эден мектебі үшін сөзсіз ерекше қадам болды.
Dialogue: 0,0:01:23.56,0:01:26.46,Default,,0,0,0,,Мен білетінім, бұл алғаш рет.
Dialogue: 0,0:01:26.92,0:01:30.34,Default,,0,0,0,,Мен тек әділ үкім шығардым, сол ғана.
Dialogue: 0,0:01:30.82,0:01:35.44,Default,,0,0,0,,Жақсы мінез-құлық мақтауға лайық, ал жаман әрекет лайықты жазаға тартылуы тиіс.
Dialogue: 0,0:01:36.14,0:01:38.82,Default,,0,0,0,,Бұл – білім берудің мәні.
Dialogue: 0,0:01:39.18,0:01:40.66,Default,,0,0,0,,Мен қателескен екенмін.
Dialogue: 0,0:01:44.96,0:01:47.94,Default,,0,0,0,,Эден қақпасынан өткен бірінші сынып оқушылары
Dialogue: 0,0:01:48.36,0:01:50.64,Default,,0,0,0,,күннен-күнге талғампаздықты меңгерген сайын,
Dialogue: 0,0:01:50.64,0:01:53.52,Default,,0,0,0,,дәстүр сақталып, ұрпақтан-ұрпаққа беріледі.
Dialogue: 0,0:01:53.96,0:01:58.82,Default,,0,0,0,,Біздің мектеп осы елдің болашағын талғампаз ету үшін бар.
Dialogue: 0,0:02:18.60,0:02:19.86,Default,,0,0,0,,(Хабаршы) «Ақ камелия сарайында оның сұлулығы мадақталады—»
Dialogue: 0,0:02:20.92,0:02:23.98,Default,,0,0,0,,Бұл Лорд Дамианның үлкен ағасы емес пе?
Dialogue: 0,0:02:25.86,0:02:26.44,Default,,0,0,0,,О
Dialogue: 0,0:02:27.04,0:02:29.10,Default,,0,0,0,,Бұл оның ағасының қабылдау рәсімі ғой, иә?
Dialogue: 0,0:02:29.44,0:02:31.38,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:02:32.36,0:02:33.46,Default,,0,0,0,,болды
Dialogue: 0,0:02:35.42,0:02:36.52,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:02:37.00,0:02:38.00,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:02:38.38,0:02:40.32,Default,,0,0,0,,Бұл – ең құнды ойыншы, иә?
Dialogue: 0,0:02:40.56,0:02:42.26,Default,,0,0,0,,Лорд Дамианның ағасы.
Dialogue: 0,0:02:42.26,0:02:44.70,Default,,0,0,0,,Оған «Стелла» сыйлығын қуана-қуана табыстап жатыр!
Dialogue: 0,0:02:44.70,0:02:45.94,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:02:46.66,0:02:48.08,Default,,0,0,0,,Ал егер бұл Лорд Дэмиан болса,
Dialogue: 0,0:02:48.08,0:02:50.68,Default,,0,0,0,,ол Империялық стипендиат атағын әлдеқайда ертерек алар еді.
Dialogue: 0,0:02:51.00,0:02:53.10,Default,,0,0,0,,Біздің жылғы алғашқы «Стелла» иегері
Dialogue: 0,0:02:53.10,0:02:55.10,Default,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:02:55.30,0:02:56.86,Default,,0,0,0,,Ә-ә, солай болар деп ойлаймын.
Dialogue: 0,0:02:57.16,0:02:59.96,Default,,0,0,0,,Дегенмен, емтихандар әлі алыс.
Dialogue: 0,0:03:00.76,0:03:02.32,Default,,0,0,0,,Жұлдыздар
Dialogue: 0,0:03:03.52,0:03:05.46,Default,,0,0,0,,Өміріңді қатерге тіретін пресс жаттығулары
Dialogue: 0,0:03:05.64,0:03:08.22,Default,,0,0,0,,Медитация жасау
Dialogue: 0,0:03:09.24,0:03:13.30,Default,,0,0,0,,Доджбол шайқасы
Dialogue: 0,0:03:13.62,0:03:16.90,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:03:17.06,0:03:18.04,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:03:18.38,0:03:20.36,Default,,0,0,0,,Бастауыш сынып оқушыларының класс жетекшісі болғаныңызға көп болды ғой, иә?
Dialogue: 0,0:03:20.74,0:03:22.24,Default,,0,0,0,,Биыл қалай?
Dialogue: 0,0:03:46.96,0:03:48.56,Default,,0,0,0,,Олар – еңбек етуге тұрарлық оқушылар тобы.
Dialogue: 0,0:03:48.78,0:03:50.24,Default,,0,0,0,,Естуімше, алғашқы күні-ақ оларға «Тонито» бергенсің.
Dialogue: 0,0:03:50.54,0:03:55.28,Default,,0,0,0,,Бұл беделді Эден мектебі үшін сөзсіз ерекше қадам болды.
Dialogue: 0,0:03:56.68,0:04:01.06,Default,,0,0,0,,Мен білетінім, бұл алғаш рет.
Dialogue: 0,0:04:02.54,0:04:06.24,Default,,0,0,0,,Мен тек әділ үкім шығардым, сол ғана.
Dialogue: 0,0:04:06.24,0:04:07.56,Default,,0,0,0,,Жақсы мінез-құлық мақтауға лайық, ал жаман әрекет лайықты жазаға тартылуы тиіс.
Dialogue: 0,0:04:07.56,0:04:08.35,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:04:08.35,0:04:09.17,Default,,0,0,0,,Бұл – білім берудің мәні.
Dialogue: 0,0:04:09.17,0:04:10.44,Default,,0,0,0,,Мен қателескен екенмін.
Dialogue: 0,0:04:10.44,0:04:11.34,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:04:11.34,0:04:11.96,Default,,0,0,0,,Эден қақпасынан өткен бірінші сынып оқушылары
Dialogue: 0,0:04:11.96,0:04:12.68,Default,,0,0,0,,күннен-күнге талғампаздықты меңгерген сайын,
Dialogue: 0,0:04:12.68,0:04:13.64,Default,,0,0,0,,дәстүр сақталып, ұрпақтан-ұрпаққа беріледі.
Dialogue: 0,0:04:13.64,0:04:16.34,Default,,0,0,0,,Біздің мектеп осы елдің болашағын талғампаз ету үшін бар.
Dialogue: 0,0:04:17.66,0:04:20.46,Default,,0,0,0,,Бұл Лорд Дамианның үлкен ағасы емес пе?
Dialogue: 0,0:04:47.09,0:04:49.88,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:04:52.88,0:04:55.01,Default,,0,0,0,,Ж-жақсы, олай болар деп ойлаймын.
Dialogue: 0,0:04:54.38,0:04:55.01,Default,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:04:55.01,0:04:55.64,Default,,0,0,0,,Ж-жақсы, олай болар деп ойлаймын.
Dialogue: 0,0:04:55.78,0:04:58.58,Default,,0,0,0,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:05:02.32,0:05:06.41,Default,,0,0,0,,Батыс аудан, Парк даңғылы, 128 үй
Dialogue: 0,0:05:06.50,0:05:11.15,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:05:13.91,0:05:18.49,Default,,0,0,0,,Мұнда өте ерекше бір отбасы тұрған Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:05:16.62,0:05:18.66,Default,,0,0,0,,Достардан ғашықтарға, тіпті отбасы мүшелерінен де Осылайша әлем бейбітшілік кейпін сақтайды Шынайы сезімдері мен нағыз болмысын жасырып Осылайша әлем бейбітшілік кейпін сақтайды Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр Шығыста Остания, соғыс жоспарлап жатыр Ал Батыста Весталис, оны тоқтатуға бел буған Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін Ж-жақсы, олай болар деп ойлаймын. Операцияны басқаратын шебер агент: Твайлайт Жүз түрлі бет-әлпет киіп, оның миссиясы отбасы құру Бұл сіздің барлық жүктеріңіз бе? Ж-жақсы, олай болар деп ойлаймын. Э-э, Ллойд мырза, жатын бөлмелерге келсек… Әрине, бөлек. Қонақтар келгенде өзімізді жұп болып көрсетелік. Ж-жақсы, олай болар деп ойлаймын. Аняның үйіне қош келдіңіз Сенімен танысқаныма қуаныштымын, Аня. Сенімен танысқаныма қуаныштымын, Аня. Мұнда өте ерекше бір отбасы тұрған Әкесі: Ллойд Форджер, психиатр Шынайы кімдігі: барлаушы Анасы: Йор Форджер, жергілікті кеңсенің қызметкері Шынайы кімдігі: жалдамалы кісі өлтіруші Кодтық аты: Принцесса Торн Аристократтар академиясына сұхбат Барып, емтиханға дайындалу стратегияңды жаса Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады Шығыс Патшалығының астанасы – Баррингтон Батыс аудан, Парк даңғылы, 128 үй Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:05:25.08,0:05:26.63,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:05:26.69,0:05:31.49,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші Қонақтар келгенде өзімізді жұп болып көрсетелік.
