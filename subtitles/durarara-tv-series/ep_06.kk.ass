Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.54,0:00:06.54,Default,,0,0,0,,♪~
Dialogue: 0,0:01:07.85,0:01:08.77,Default,,0,0,0,,Доллар?
Dialogue: 0,0:01:09.06,0:01:10.77,Default,,0,0,0,,Трусигіңізді көрсетіп, аспанмен ұшу.
Dialogue: 0,0:01:10.94,0:01:12.78,Default,,0,0,0,,Бұл тербелетін періште
Dialogue: 0,0:01:13.07,0:01:14.78,Default,,0,0,0,,Қате соманы алмаңыз.
Dialogue: 0,0:01:14.90,0:01:17.78,Default,,0,0,0,,Оянбасаң, Ағари кенет төмен түседі.
Dialogue: 0,0:01:18.03,0:01:20.83,Default,,0,0,0,,Долларға келетін болсақ, біз де олар туралы көп білмейміз.
Dialogue: 0,0:01:21.20,0:01:22.95,Default,,0,0,0,,Мен саған білгенімнің бәрін айтамын.
Dialogue: 0,0:01:23.16,0:01:24.79,Default,,0,0,0,,Түстер тобына ұқсайды, бірақ...
Dialogue: 0,0:01:24.87,0:01:26.83,Default,,0,0,0,,Мен оның қандай түс екенін де білмеймін.
Dialogue: 0,0:01:27.04,0:01:29.46,Default,,0,0,0,,«Деңгеки бунко» журналының жаңа басылымы шықты.
Dialogue: 0,0:01:29.54,0:01:31.29,Default,,0,0,0,,Түрлі мақсатта 10 шақты кітапты редакцияладым.
Dialogue: 0,0:01:31.63,0:01:32.75,Default,,0,0,0,,Әртүрлі мақсаттар үшін.
Dialogue: 0,0:01:48.48,0:01:54.48,Default,,0,0,0,,~♪
Dialogue: 0,0:02:09.21,0:02:12.17,Default,,0,0,0,,Хехехе, қашып құтыламын деп ойлама!
Dialogue: 0,0:02:13.50,0:02:15.84,Default,,0,0,0,,Оңға бұрылыңыз
Dialogue: 0,0:02:16.05,0:02:17.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:23.93,0:02:25.01,Default,,0,0,0,,Адамның іш қуысы бар
Dialogue: 0,0:02:25.18,0:02:27.64,Default,,0,0,0,,Жоқ, жоқ, жоқ, сіз осындай нәрсені істеп жатырсыз.
Dialogue: 0,0:02:27.73,0:02:30.31,Default,,0,0,0,,Бұл сіз Dollars жүйесіне қосылғаннан бері бірінші рет болып отыр, Кадота мырза.
Dialogue: 0,0:02:30.60,0:02:31.69,Default,,0,0,0,,Тыныш отырыңыз.
Dialogue: 0,0:02:31.81,0:02:34.61,Default,,0,0,0,,Доллар трусиларын көрсетіп, аспанмен ұшады.
Dialogue: 0,0:02:34.69,0:02:38.86,Default,,0,0,0,,Пипирупилпиру Дотачин періште емес
Dialogue: 0,0:02:38.95,0:02:40.32,Default,,0,0,0,,Сондықтан мені бұл атпен атама!
Dialogue: 0,0:02:45.20,0:02:46.83,Default,,0,0,0,,Жақсы! Мен оны сілкіп тастадым
Dialogue: 0,0:02:48.20,0:02:49.54,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:50.37,0:02:51.21,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:02:51.71,0:02:53.13,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:02:57.05,0:02:57.92,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:03:17.53,0:03:19.65,Default,,0,0,0,,Енді бір нәрсе сұрайын.
Dialogue: 0,0:03:19.90,0:03:22.57,Default,,0,0,0,,Сіз басқаратын адам эксперименті туралы әңгіме.
Dialogue: 0,0:03:23.32,0:03:25.20,Default,,0,0,0,,Мен Кёхэй Кадотамын
Dialogue: 0,0:03:25.28,0:03:28.20,Default,,0,0,0,,Мені дотачин деп атағандары ұнамайды.
Dialogue: 0,0:03:28.79,0:03:32.21,Default,,0,0,0,,Бұл сегіз сағат бұрын болды.
Dialogue: 0,0:03:35.13,0:03:39.21,Default,,0,0,0,,Енді менің айтайын дегенім әлемге әйгілі Казутано ісі.
Dialogue: 0,0:03:40.30,0:03:41.05,Default,,0,0,0,,Жоғалған адам -
Dialogue: 0,0:03:41.13,0:03:43.01,Default,,0,0,0,,Ол менің сыныптасым.
Dialogue: 0,0:03:43.18,0:03:45.68,Default,,0,0,0,,Дәлірек айтсам, мен достың досымын, бірақ...
Dialogue: 0,0:03:45.76,0:03:46.72,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:03:46.85,0:03:48.56,Default,,0,0,0,,Мен сені бұрын ешқашан кездестірген емеспін.
Dialogue: 0,0:03:49.02,0:03:52.27,Default,,0,0,0,,Таро Танаканың досы жоғалып кетті ме?
Dialogue: 0,0:03:52.35,0:03:55.23,Default,,0,0,0,,Ойлап қарасам, соңғы кезде адамдар жиі жоғалып кетеді.
Dialogue: 0,0:03:55.31,0:03:58.11,Default,,0,0,0,,Жоғалғандар туралы көптеген қауесеттер бар.
Dialogue: 0,0:03:58.19,0:03:59.78,Default,,0,0,0,,Канра мырза, сіз қауесет маньяксыз.
Dialogue: 0,0:04:00.19,0:04:01.69,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:04:01.99,0:04:05.91,Default,,0,0,0,,Естуімше, жоғалып бара жатқандар ауылдан үйінен қашып кеткен балалар екен.
Dialogue: 0,0:04:05.99,0:04:07.62,Default,,0,0,0,,Заңсыз шетелдіктер
Dialogue: 0,0:04:08.20,0:04:12.04,Default,,0,0,0,,Басқаша айтқанда, бұлар жоғалса да ізін қалдырмайтын адамдар.
Dialogue: 0,0:04:16.96,0:04:18.25,Default,,0,0,0,,Сол адамдар...
Dialogue: 0,0:04:18.46,0:04:22.01,Default,,0,0,0,,Икебукуро мен Шибуяның арасында көп адам жоғалып кеткен сияқты.
Dialogue: 0,0:04:22.13,0:04:25.26,Default,,0,0,0,,Оның үстіне ол бір жоғалып кетсе, енді ешқашан табылмайды.
Dialogue: 0,0:04:25.34,0:04:26.59,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:27.01,0:04:30.27,Default,,0,0,0,,Одан да қорқынышты қауесеттер бар.
Dialogue: 0,0:04:31.98,0:04:33.81,Default,,0,0,0,,Сіз ешқашан таба алмайтын нәрсе...
Dialogue: 0,0:04:33.89,0:04:38.06,Default,,0,0,0,,Өйткені долларлар бір жерде адам денесін өңдеп, жеп жатыр.
Dialogue: 0,0:04:38.36,0:04:39.27,Default,,0,0,0,,Е...!
Dialogue: 0,0:04:44.32,0:04:45.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.15,0:04:46.78,Default,,0,0,0,,Жақсы тот белгісі
Dialogue: 0,0:04:46.86,0:04:50.29,Default,,0,0,0,,Мұнда ақпарат беруші айтқан жеткізуші
Dialogue: 0,0:04:50.62,0:04:53.79,Default,,0,0,0,,Мұнда көптеген заңсыз иммигранттар қоныстанған сияқты.
Dialogue: 0,0:04:54.08,0:04:57.79,Default,,0,0,0,,Жарайды, күріш тұқымын алып, тезірек жеткізіп алайық.
Dialogue: 0,0:05:07.30,0:05:08.76,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:05:10.35,0:05:12.35,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:05:15.44,0:05:16.35,Default,,0,0,0,,Хмф…
Dialogue: 0,0:05:22.36,0:05:24.90,Default,,0,0,0,,Казутано Казутано!
Dialogue: 0,0:05:29.53,0:05:32.99,Default,,0,0,0,,(Казутаноның ән айту дауысы)
Dialogue: 0,0:05:33.08,0:05:34.33,Default,,0,0,0,,Толық құпия түрде орындалатын өлім жазасы
Dialogue: 0,0:05:34.79,0:05:36.08,Default,,0,0,0,,Кя! (Каназава) Қызық!
Dialogue: 0,0:05:38.92,0:05:41.71,Default,,0,0,0,,О, жасөспірім қыздар 20% қымбатырақ.
Dialogue: 0,0:05:41.79,0:05:43.55,Default,,0,0,0,,Жоқ, бүгін берік болайық.
Dialogue: 0,0:05:44.05,0:05:47.05,Default,,0,0,0,,Егер сіз сол қолды көздесеңіз, сіз бұрынғыдай бірдеңе аласыз.
Dialogue: 0,0:05:48.34,0:05:50.39,Default,,0,0,0,,Ку...бассыз ба?
Dialogue: 0,0:05:50.72,0:05:52.89,Default,,0,0,0,,Бүгін осыны сынап көрейік.
Dialogue: 0,0:05:53.47,0:05:55.02,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:05:55.14,0:05:56.27,Default,,0,0,0,,(Казутаноның ән айту дауысы)
Dialogue: 0,0:05:56.39,0:05:59.35,Default,,0,0,0,,Бір жерде ақау жоқ па?
Dialogue: 0,0:05:59.44,0:06:01.02,Default,,0,0,0,,Бұл да адам ғой.
Dialogue: 0,0:06:01.48,0:06:05.74,Default,,0,0,0,,Жарайды, мен орта жастағы адаммын, мен өнімге жеңілдік жасауға дайынмын.
Dialogue: 0,0:06:05.82,0:06:08.11,Default,,0,0,0,,(Казутаноның ән айту дауысы)
Dialogue: 0,0:06:08.24,0:06:09.28,Default,,0,0,0,,Эй
Dialogue: 0,0:06:10.24,0:06:12.33,Default,,0,0,0,,Күріш тұқымы
Dialogue: 0,0:06:19.75,0:06:23.50,Default,,0,0,0,,Мен де сен сияқты жапонмын.
Dialogue: 0,0:06:23.59,0:06:27.72,Default,,0,0,0,,Бірақ адамдар мені шетелдікке ұқсайды деп жиі айтады. Бұл өте өкінішті.
Dialogue: 0,0:06:28.13,0:06:30.26,Default,,0,0,0,,Кейде қорлау болады.
Dialogue: 0,0:06:45.27,0:06:46.98,Default,,0,0,0,,Тамақтың ақысын да төлемейді, солай ма?
Dialogue: 0,0:06:47.11,0:06:49.49,Default,,0,0,0,,«Ұнпоко қайғылы» дегенді қалай түсінесіңдер?
Dialogue: 0,0:06:50.66,0:06:51.70,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:51.78,0:06:55.49,Default,,0,0,0,,Юта сияқты кіші іні типті көмекші ертегі кейіпкерсіз...
Dialogue: 0,0:06:55.79,0:06:58.66,Default,,0,0,0,,Менің ойымша, ол жай ғана шашы фетиші бар супер мазохистік қасқыр.
Dialogue: 0,0:06:58.79,0:07:02.00,Default,,0,0,0,,Ол інісіне көбірек ұқсайды, дәлірек айтсақ, киінген бала.
Dialogue: 0,0:07:02.13,0:07:05.13,Default,,0,0,0,,Маған қарындас типті көмекші ертегі кейіпкер керек.
Dialogue: 0,0:07:05.21,0:07:07.42,Default,,0,0,0,,Аға, әпке болсаң жарайды.
Dialogue: 0,0:07:07.96,0:07:10.55,Default,,0,0,0,,Мен саған тамақ кезінде бұл туралы айтуға рұқсат бермеймін.
Dialogue: 0,0:07:10.80,0:07:13.47,Default,,0,0,0,,Дотачин! Жүр тамақ ішейік
Dialogue: 0,0:07:13.55,0:07:15.72,Default,,0,0,0,,Күріш күріш (Кадота) Оу
Dialogue: 0,0:07:15.81,0:07:20.06,Default,,0,0,0,,Жоқ, жоқ, жоқ, Кадота-сан, сенің шеберлігің әдеттегідей керемет.
Dialogue: 0,0:07:20.14,0:07:21.81,Default,,0,0,0,,Дәретхана менің бөлмемнен үлкен.
Dialogue: 0,0:07:21.98,0:07:24.65,Default,,0,0,0,,Тұжырымдама «тыныш релаксацияны қамтамасыз ету».
Dialogue: 0,0:07:24.73,0:07:27.02,Default,,0,0,0,,Бұл «жоғары сыныпты кабаре клубы» болса керек
Dialogue: 0,0:07:27.36,0:07:28.28,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:28.36,0:07:32.49,Default,,0,0,0,,А, асығыңыз жақсы, өйткені бүгін айына бір рет.
Dialogue: 0,0:07:32.61,0:07:34.49,Default,,0,0,0,,О
Dialogue: 0,0:07:36.03,0:07:36.83,Default,,0,0,0,,Who?
Dialogue: 0,0:07:36.95,0:07:38.33,Default,,0,0,0,,Казутанодан
Dialogue: 0,0:07:38.79,0:07:40.54,Default,,0,0,0,,``Табақ сынды''
Dialogue: 0,0:07:40.66,0:07:42.33,Default,,0,0,0,,Жаңа табақ сатып алыңыз.
Dialogue: 0,0:07:42.42,0:07:43.83,Default,,0,0,0,,Хякуйен Хякуйен
Dialogue: 0,0:07:44.00,0:07:47.88,Default,,0,0,0,,Угяаааааа! Мен жапонмын!
Dialogue: 0,0:07:51.17,0:07:54.39,Default,,0,0,0,,«Мені біреу ұрлап кетті» деген қателік болған шығар
Dialogue: 0,0:07:54.51,0:07:56.30,Default,,0,0,0,,Хахаха, сіз тым көп ойлап отырсыз.
Dialogue: 0,0:07:56.51,0:07:58.43,Default,,0,0,0,,Угяаааааааааа!
Dialogue: 0,0:07:58.51,0:08:00.77,Default,,0,0,0,,Шу болды, тез ұйықтайын.
Dialogue: 0,0:08:00.85,0:08:01.93,Default,,0,0,0,,Сыбырлау
Dialogue: 0,0:08:04.56,0:08:05.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.36,0:08:07.27,Default,,0,0,0,,О...
Dialogue: 0,0:08:08.23,0:08:09.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.90,0:08:13.86,Default,,0,0,0,,Келіңіздер, бұл арзан және материал жаңа.
Dialogue: 0,0:08:13.95,0:08:16.41,Default,,0,0,0,,Сонохара мырза да бұл қауесетті естіді.
Dialogue: 0,0:08:16.53,0:08:17.37,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.45,0:08:20.33,Default,,0,0,0,,Жарайды. Бұл өсектер өтірік.
Dialogue: 0,0:08:20.41,0:08:23.16,Default,,0,0,0,,Дұрыс, Харима мырза жоғалып кетті.
Dialogue: 0,0:08:23.25,0:08:25.29,Default,,0,0,0,,Оның ұрланғаны расталмады...
Dialogue: 0,0:08:25.37,0:08:29.17,Default,,0,0,0,,Харима мырзаны ұрлап әкетуге жол жоқ...
Dialogue: 0,0:08:31.05,0:08:32.55,Default,,0,0,0,,Неліктен нақты өрнек
Dialogue: 0,0:08:33.05,0:08:34.09,Default,,0,0,0,,Қабір…
Dialogue: 0,0:08:34.63,0:08:38.18,Default,,0,0,0,,Сәлем, 3 порция нигири.
Dialogue: 0,0:08:38.51,0:08:41.18,Default,,0,0,0,,Жарайды, менің сушиім балық.
Dialogue: 0,0:08:41.27,0:08:43.27,Default,,0,0,0,,Жарты баға күні адам да емес
Dialogue: 0,0:08:43.39,0:08:43.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:44.44,0:08:45.35,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:08:45.44,0:08:47.52,Default,,0,0,0,,Бұл тақырып жалғасады ма?
Dialogue: 0,0:08:47.61,0:08:50.61,Default,,0,0,0,,Саймон, алдыңғы баннер сынған.
Dialogue: 0,0:08:50.73,0:08:51.73,Default,,0,0,0,,Нобори?
Dialogue: 0,0:08:51.86,0:08:54.99,Default,,0,0,0,,Иә, баннерді жөндеп алайық.
Dialogue: 0,0:08:55.07,0:08:57.11,Default,,0,0,0,,Әй, жөндеп алайық, шынымен.
Dialogue: 0,0:08:57.24,0:09:02.16,Default,,0,0,0,,Бұл бұрыштағы суши мейрамханасы. Бұл жарты баға күні. Бұл балық емес. Бұл адам. Бұл қорқынышты.
Dialogue: 0,0:09:02.25,0:09:06.67,Default,,0,0,0,,Ватакуса мырза, басқа көлік алғыңыз келе ме? Бұл көлік. Бұл көлік. Бұл көлік.
Dialogue: 0,0:09:06.75,0:09:07.54,Default,,0,0,0,,I'll kill you
Dialogue: 0,0:09:07.63,0:09:10.67,Default,,0,0,0,,Итальяндық көліктер қымбат, өйткені олар шетелдік көліктер.
Dialogue: 0,0:09:10.75,0:09:12.76,Default,,0,0,0,,Маған Сетучидегі манты асшаяндарын беріңізші
Dialogue: 0,0:09:12.84,0:09:14.63,Default,,0,0,0,,Сарықұйрық және жолақты скумбрия
Dialogue: 0,0:09:20.43,0:09:21.35,Default,,0,0,0,,Ах
Dialogue: 0,0:09:22.68,0:09:23.56,Default,,0,0,0,,Әбунана
Dialogue: 0,0:09:23.64,0:09:24.77,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:09:25.27,0:09:29.77,Default,,0,0,0,,Қалыпты Бөтелкені толығымен төгіп алғыңыз келе ме? Ал өзіме
Dialogue: 0,0:09:30.23,0:09:33.61,Default,,0,0,0,,Жоқ, мен тым ұйықтап жатырмын.
Dialogue: 0,0:09:34.07,0:09:36.40,Default,,0,0,0,,Ол жеткізілгенше ұйықтамаңыз
Dialogue: 0,0:09:36.65,0:09:40.41,Default,,0,0,0,,Қауіпті, қауіпті, қабақтарым!
Dialogue: 0,0:09:41.08,0:09:41.83,Default,,0,0,0,,Алға қара
Dialogue: 0,0:09:42.62,0:09:44.29,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:09:44.41,0:09:45.29,Default,,0,0,0,,Не?
Dialogue: 0,0:09:45.37,0:09:47.12,Default,,0,0,0,,Бұл адам ұйықтап жатыр.
Dialogue: 0,0:09:47.25,0:09:49.96,Default,,0,0,0,,Сол жерге лақтырсаң, бәрі түзеледі.
Dialogue: 0,0:09:50.29,0:09:51.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:59.59,0:10:02.64,Default,,0,0,0,,Казутано, мен саған суши әкелдім.
Dialogue: 0,0:10:03.10,0:10:06.68,Default,,0,0,0,,Сәлем! Мен орыс сушиінен ескі тәрелке алдым.
Dialogue: 0,0:10:08.35,0:10:10.15,Default,,0,0,0,,Уа, бұл не?
Dialogue: 0,0:10:16.32,0:10:19.82,Default,,0,0,0,,Электрондық пошта бұрын тақтайша сынбаған.
Dialogue: 0,0:10:19.91,0:10:20.70,Default,,0,0,0,,О
Dialogue: 0,0:10:21.66,0:10:23.03,Default,,0,0,0,,Бұл бір тостаған күріш
Dialogue: 0,0:10:23.99,0:10:24.95,Default,,0,0,0,,Дотачин
Dialogue: 0,0:10:25.66,0:10:27.50,Default,,0,0,0,,"Оңай! Канджи түрлендіру"
Dialogue: 0,0:10:28.00,0:10:29.71,Default,,0,0,0,,Казутаноның жігіті...
Dialogue: 0,0:10:30.17,0:10:31.58,Default,,0,0,0,,(тақталардың сынған дыбысы)
Dialogue: 0,0:10:32.75,0:10:36.01,Default,,0,0,0,,Казутаноны адам аңшылары ұрлап әкетті.
Dialogue: 0,0:10:36.76,0:10:38.51,Default,,0,0,0,,Мен енді ешқашан табылмаймын
Dialogue: 0,0:10:40.80,0:10:44.01,Default,,0,0,0,,Мен қазірден бастап Казутаносыз не істеуім керек?
Dialogue: 0,0:10:44.14,0:10:46.85,Default,,0,0,0,,Қолдау үшін не нәрсеге сенуім керек?
Dialogue: 0,0:10:49.19,0:10:51.65,Default,,0,0,0,,Біз бәріміз Ватакуса үшін Казутаномыз...
Dialogue: 0,0:10:51.73,0:10:54.86,Default,,0,0,0,,Мен сіздің қаншалықты маңызды екеніңізді білдім.
Dialogue: 0,0:10:55.27,0:10:57.94,Default,,0,0,0,,Казутаноны ешкім алмастыра алмайды.
Dialogue: 0,0:10:58.15,0:11:01.28,Default,,0,0,0,,Каризаваға, Юмасакиге, маған
Dialogue: 0,0:11:01.49,0:11:03.03,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:11:05.45,0:11:09.37,Default,,0,0,0,,Электрондық хат келген кезде сізді ұрлап кетсе, көп уақыт өткен жоқ.
Dialogue: 0,0:11:09.87,0:11:12.67,Default,,0,0,0,,Казутано оны жеткізгенше оны табыңыз...
Dialogue: 0,0:11:12.75,0:11:14.00,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:11:14.29,0:11:16.00,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:11:17.21,0:11:18.21,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:11:20.42,0:11:22.51,Default,,0,0,0,,Мен олардың көлігін көрдім.
Dialogue: 0,0:11:23.22,0:11:24.10,Default,,0,0,0,,Хашим
Dialogue: 0,0:11:24.22,0:11:25.01,Default,,0,0,0,,Квитар
Dialogue: 0,0:11:25.30,0:11:28.52,Default,,0,0,0,,Ең күшті іні типті көмекші ертегі кейіпкері
Dialogue: 0,0:11:32.90,0:11:34.98,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:11:35.48,0:11:39.07,Default,,0,0,0,,Егер тауып алсаңыз, ішіндегі шетелдікті босатуыңыз керек.
Dialogue: 0,0:11:39.57,0:11:41.40,Default,,0,0,0,,А, олар қашан
Dialogue: 0,0:11:41.49,0:11:44.32,Default,,0,0,0,,Мен тауардың қайда берілетінін білмеймін
Dialogue: 0,0:11:44.41,0:11:46.70,Default,,0,0,0,,Бірақ мен сені тезірек құтқарғым келеді.
Dialogue: 0,0:11:47.12,0:11:50.41,Default,,0,0,0,,Жарайды, бұл қара фургон. Сіз нөмірді білесіз бе?
Dialogue: 0,0:11:50.54,0:11:51.66,Default,,0,0,0,,О, мен айтайын.
Dialogue: 0,0:11:51.75,0:11:53.21,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:11:54.58,0:11:55.42,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:57.38,0:11:58.71,Default,,0,0,0,,Рахмет саған Хашим
Dialogue: 0,0:11:58.80,0:11:59.51,Default,,0,0,0,,Иә
Dialogue: 0,0:11:59.59,0:12:00.97,Default,,0,0,0,,Сіз суши жей аласыз ба?
Dialogue: 0,0:12:01.09,0:12:02.09,Default,,0,0,0,,Иә! (Кадота) Сонда кездескенше.
Dialogue: 0,0:12:02.63,0:12:03.76,Default,,0,0,0,,Бұл васаби ме?
Dialogue: 0,0:12:03.88,0:12:04.76,Default,,0,0,0,,Ішінде.
Dialogue: 0,0:12:04.84,0:12:07.72,Default,,0,0,0,,Жарайды, орысша васаби ащы емес.
Dialogue: 0,0:12:07.81,0:12:09.68,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,0:12:09.77,0:12:10.93,Default,,0,0,0,,Кеттік (Ватагуса).
Dialogue: 0,0:12:15.77,0:12:18.44,Default,,0,0,0,,Қара фургонда бұл сан.
Dialogue: 0,0:12:20.82,0:12:22.24,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:12:26.99,0:12:29.74,Default,,0,0,0,,Орындаушы топ - қандай да бір жосықсыз компанияның қосалқы мердігері.
Dialogue: 0,0:12:30.54,0:12:32.46,Default,,0,0,0,,Ал, түбінің түбі.
Dialogue: 0,0:12:35.29,0:12:37.71,Default,,0,0,0,,Жоғалып кетсе де өз-өзіне көмектесе алмайтын адамдарды ұрламаңыз...
Dialogue: 0,0:12:37.79,0:12:40.00,Default,,0,0,0,,Жоғарырақ топқа тапсырылатын сияқты.
Dialogue: 0,0:12:40.30,0:12:44.63,Default,,0,0,0,,Адамдар көп нәрсеге «материал» ретінде пайдаланылуы мүмкін.
Dialogue: 0,0:12:46.05,0:12:47.80,Default,,0,0,0,,Бұл каннибализм сияқты.
Dialogue: 0,0:12:49.10,0:12:52.52,Default,,0,0,0,,Осы айда қосалқы мердігер жеткізілімдерінің саны аз.
Dialogue: 0,0:12:52.64,0:12:54.77,Default,,0,0,0,,күрсіну. Соңғы кездері мен «материалдарға» сақтықпен қарайтын болдым...
Dialogue: 0,0:12:54.85,0:12:56.52,Default,,0,0,0,,Сақтау жақсы.
Dialogue: 0,0:12:56.65,0:12:59.19,Default,,0,0,0,,Сандарды көбейте алмайтын қосалқы мердігерлерді кесіңіз.
Dialogue: 0,0:12:59.32,0:13:00.65,Default,,0,0,0,,Бірақ... (Нэми) Немесе...
Dialogue: 0,0:13:00.73,0:13:02.44,Default,,0,0,0,,Сіз «материал»сыз ба?
Dialogue: 0,0:13:04.15,0:13:05.32,Default,,0,0,0,,Сіз артқа шегінуге болады.
Dialogue: 0,0:13:15.00,0:13:16.04,Default,,0,0,0,,Сейджи...
Dialogue: 0,0:13:33.97,0:13:35.14,Default,,0,0,0,,Ақымақ Силла
Dialogue: 0,0:13:35.27,0:13:40.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:42.11,0:13:45.65,Default,,0,0,0,,Біз Казутаноны ұрлап кеткен қара фургонды іздедік.
Dialogue: 0,0:13:46.36,0:13:49.03,Default,,0,0,0,,Көмектесемін деген ниетпен
Dialogue: 0,0:13:50.37,0:13:52.54,Default,,0,0,0,,Мен ойыма келгеннің бәрін қолданып көрдім...
Dialogue: 0,0:13:52.62,0:13:55.37,Default,,0,0,0,,Казутаноның қайда екені белгісіз.
Dialogue: 0,0:13:56.46,0:13:58.54,Default,,0,0,0,,Мазасыздық санамнан өтті
Dialogue: 0,0:13:59.04,0:14:01.96,Default,,0,0,0,,Мен Казутаноның ностальгиялық тіркесін енді ешқашан естімеймін.
Dialogue: 0,0:14:02.04,0:14:03.63,Default,,0,0,0,,Мүмкін сіз оны естімейсіз бе?
Dialogue: 0,0:14:03.96,0:14:06.84,Default,,0,0,0,,Бала кезімде жиі еститін ностальгиялық тіркесті.
Dialogue: 0,0:14:07.68,0:14:09.05,Default,,0,0,0,,Өсу...
Dialogue: 0,0:14:09.13,0:14:11.55,Default,,0,0,0,,Мен енді ешқашан естімеймін деп ойлаған сөйлемдер
Dialogue: 0,0:14:11.89,0:14:16.56,Default,,0,0,0,,Сізде билет жоқ па? Менде билет бар.
Dialogue: 0,0:14:16.93,0:14:21.31,Default,,0,0,0,,Иә, Казутано – қазір жойылып бара жатқан адам.
Dialogue: 0,0:14:21.61,0:14:23.86,Default,,0,0,0,,Ватакуса Казутаноға...
Dialogue: 0,0:14:23.94,0:14:27.15,Default,,0,0,0,,Маған өмірдің ең үлкен қуаныштары сеніп тапсырылды.
Dialogue: 0,0:14:30.36,0:14:33.83,Default,,0,0,0,,Ватакуса Рури Санибенің мәңгілік құдайы
Dialogue: 0,0:14:34.45,0:14:37.58,Default,,0,0,0,,Ватакуса өз махаббатын толығымен біржақты түрде ұсынатын құдай.
Dialogue: 0,0:14:38.41,0:14:40.29,Default,,0,0,0,,Казутаноны алу тіпті қиын.
Dialogue: 0,0:14:40.42,0:14:43.13,Default,,0,0,0,,Сіз құдайға ең жақын орынға ие боласыз.
Dialogue: 0,0:14:43.25,0:14:45.09,Default,,0,0,0,,Бұл Ватакусаның сиқыршысы.
Dialogue: 0,0:14:48.72,0:14:52.76,Default,,0,0,0,,Ватакуса үшін біз Казутаноны құтқаруымыз керек...
Dialogue: 0,0:14:52.85,0:14:55.39,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:55.47,0:14:56.64,Default,,0,0,0,,Және кіммен?
Dialogue: 0,0:14:56.77,0:14:57.60,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:57.93,0:14:59.27,Default,,0,0,0,,мен ойладым-
Dialogue: 0,0:14:59.39,0:15:02.94,Default,,0,0,0,,Казутаноның ұялы телефонына осы жерден қоңырау шалуға қалай болады?
Dialogue: 0,0:15:03.02,0:15:06.28,Default,,0,0,0,,Мүмкін біз сол жақтағы жігіттермен келіссөздер жүргізерміз.
Dialogue: 0,0:15:11.95,0:15:15.53,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:15:16.58,0:15:19.66,Default,,0,0,0,,Суши махаббаты Маған майлы тунец ұнайды
Dialogue: 0,0:15:19.79,0:15:20.96,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:15:21.04,0:15:23.63,Default,,0,0,0,,Ах! Бұл дауыс қатты
Dialogue: 0,0:15:23.96,0:15:27.30,Default,,0,0,0,,Дұрыс, мен өтіп бара жатып біреудің ұйықтап жатқанын көрдім...
Dialogue: 0,0:15:27.38,0:15:29.17,Default,,0,0,0,,Менің ұялы телефоным шырылдап жатыр, оның орнына...
Dialogue: 0,0:15:29.30,0:15:31.13,Default,,0,0,0,,Не? Мұнда?
Dialogue: 0,0:15:31.76,0:15:34.76,Default,,0,0,0,,Минамиикебукуро, диагональ бойынша Тайшөкеңнің алдында
Dialogue: 0,0:15:35.30,0:15:36.64,Default,,0,0,0,,Не? Өйткені-
Dialogue: 0,0:15:37.43,0:15:39.81,Default,,0,0,0,,Бүгін ресейлік сушидің қызмет көрсететін күні.
Dialogue: 0,0:15:44.73,0:15:47.48,Default,,0,0,0,,Изая! Икебукуроға келме
Dialogue: 0,0:15:47.61,0:15:50.49,Default,,0,0,0,,Ах, Шизу-чан мені тапты!
Dialogue: 0,0:15:51.24,0:15:54.16,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:15:55.62,0:15:57.87,Default,,0,0,0,,Оян! Эй оян!
Dialogue: 0,0:15:58.91,0:16:00.83,Default,,0,0,0,,Сәлем! Оян!
Dialogue: 0,0:16:01.12,0:16:02.71,Default,,0,0,0,,Оян! Эй
Dialogue: 0,0:16:03.25,0:16:06.71,Default,,0,0,0,,Оны жайына қалдыр да, мәңгілік ұйқыға кет.
Dialogue: 0,0:16:06.84,0:16:09.17,Default,,0,0,0,,Бірақ біз асықпасақ, Казутано асықпайды
Dialogue: 0,0:16:09.25,0:16:13.05,Default,,0,0,0,,Иә, ол жеткізілгеннен кейін өңделеді.
Dialogue: 0,0:16:23.35,0:16:24.90,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:16:25.31,0:16:26.69,Default,,0,0,0,,Мен бұл жігітпен бірге боламын
Dialogue: 0,0:16:26.77,0:16:28.86,Default,,0,0,0,,Казутаноны қайда жеткізетінін айтамын.
Dialogue: 0,0:16:30.48,0:16:32.86,Default,,0,0,0,,Жеткізу уақыты жақындап қалды.
Dialogue: 0,0:16:32.99,0:16:35.45,Default,,0,0,0,,Үстіңіздегі адам келе жатыр, сондықтан мұқият болыңыз.
Dialogue: 0,0:16:35.57,0:16:36.37,Default,,0,0,0,,О
Dialogue: 0,0:16:36.53,0:16:38.66,Default,,0,0,0,,Мен жапонмын.
Dialogue: 0,0:16:38.78,0:16:41.37,Default,,0,0,0,,Балалар, сендер қателіктеріңді түсінесіңдер.
Dialogue: 0,0:16:41.50,0:16:43.00,Default,,0,0,0,,Әлі де талап етесіз бе?
Dialogue: 0,0:16:43.21,0:16:47.17,Default,,0,0,0,,Сонда отбасы тізілімінде ``жапонша'' деп жазылған болуы керек, солай ма?
Dialogue: 0,0:16:47.29,0:16:50.96,Default,,0,0,0,,Мәселе мынада. Әуе шабуылында отбасылық кітапша жойылды.
Dialogue: 0,0:16:51.09,0:16:53.67,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:16:53.80,0:16:54.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.84,0:16:56.84,Default,,0,0,0,,А, мен, мен, мен.
Dialogue: 0,0:16:56.93,0:16:59.43,Default,,0,0,0,,А, Каназава? Сіз ояндыңыз ба?
Dialogue: 0,0:16:59.72,0:17:01.81,Default,,0,0,0,,Вари, мен қазір барамын.
Dialogue: 0,0:17:01.93,0:17:03.93,Default,,0,0,0,,Текаса, жеткізу орны қайда?
Dialogue: 0,0:17:04.39,0:17:06.23,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:06.69,0:17:13.44,Default,,0,0,0,,♪ Біз кереметпіз.
Dialogue: 0,0:17:15.70,0:17:18.16,Default,,0,0,0,,Не... не? Балалар сендер
Dialogue: 0,0:17:18.24,0:17:21.74,Default,,0,0,0,,Біз доллар
Dialogue: 0,0:17:22.08,0:17:23.75,Default,,0,0,0,,Доллар…
Dialogue: 0,0:17:24.25,0:17:26.42,Default,,0,0,0,,Zu! Есіңізде болсын!
Dialogue: 0,0:17:29.17,0:17:31.59,Default,,0,0,0,,Менің ұйқым келді... Ұйқым келді...
Dialogue: 0,0:17:32.25,0:17:33.09,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:33.42,0:17:35.51,Default,,0,0,0,,Біз долларға қалай келдік?
Dialogue: 0,0:17:35.59,0:17:37.30,Default,,0,0,0,,Бұл өте қарапайым болды.
Dialogue: 0,0:17:39.85,0:17:42.31,Default,,0,0,0,,Бастапқыда Ватакуса, Юмасаки және Каризава...
Dialogue: 0,0:17:42.43,0:17:45.10,Default,,0,0,0,,Мен білмей тұрып, олар менің айналама жиналып қалды.
Dialogue: 0,0:17:46.10,0:17:48.73,Default,,0,0,0,,Мен сияқты адамдарда не жақсы?
Dialogue: 0,0:17:48.85,0:17:51.02,Default,,0,0,0,,Олар мүлдем оғаш топ.
Dialogue: 0,0:17:51.86,0:17:54.90,Default,,0,0,0,,Бір күні ұялы телефоныма хат келді.
Dialogue: 0,0:17:55.57,0:17:57.40,Default,,0,0,0,,«Сіз долларға қосылғыңыз келе ме?»
Dialogue: 0,0:17:57.49,0:17:59.49,Default,,0,0,0,,``Ешқандай шектеулер, ережелер жоқ.''
Dialogue: 0,0:17:59.62,0:18:01.95,Default,,0,0,0,,``Өзіңізді доллар деп атаңыз''
Dialogue: 0,0:18:02.12,0:18:03.79,Default,,0,0,0,,Біртүрлі шақыру
Dialogue: 0,0:18:03.95,0:18:07.83,Default,,0,0,0,,Доллар біраз уақыттан бері сәл басқа ұйым екендігі туралы қауесет тарады.
Dialogue: 0,0:18:08.12,0:18:10.58,Default,,0,0,0,,Басында бұл біреудің еркелігі деп ойладым, бірақ...
Dialogue: 0,0:18:10.71,0:18:13.46,Default,,0,0,0,,Егер сіз сот процесіне келіссеңіз, келесі күні...
Dialogue: 0,0:18:13.59,0:18:16.13,Default,,0,0,0,,URL мекенжайы мен құпия сөз сізге жіберілді
Dialogue: 0,0:18:18.09,0:18:19.47,Default,,0,0,0,,Жүйеге кірсеңіз...
Dialogue: 0,0:18:19.97,0:18:22.97,Default,,0,0,0,,Менің тұтқам Dollars веб-сайтында көрсетілді.
Dialogue: 0,0:18:24.31,0:18:27.06,Default,,0,0,0,,Мүшелердің ешқайсысы, соның ішінде мен де...
Dialogue: 0,0:18:27.14,0:18:29.23,Default,,0,0,0,,Көсемді көрген емеспін.
Dialogue: 0,0:18:29.60,0:18:32.36,Default,,0,0,0,,Ұйымда көптеген шағын ұйымдар бар.
Dialogue: 0,0:18:32.65,0:18:35.19,Default,,0,0,0,,Олардың әрқайсысы тік қоғамды құраса да...
Dialogue: 0,0:18:35.32,0:18:37.57,Default,,0,0,0,,Тек жоғарғы бөлігі жоқ
Dialogue: 0,0:18:38.90,0:18:43.08,Default,,0,0,0,,Менде «жоғары» болмаған соң, өзімді біреуден төмен тұрғандай сезінбеймін.
Dialogue: 0,0:18:43.49,0:18:47.58,Default,,0,0,0,,Бірақ бұл оғаш ұйымдық жүйені кім жасады?
Dialogue: 0,0:18:47.66,0:18:50.12,Default,,0,0,0,,Мазаламады десем, өтірік айтқан болар едім
Dialogue: 0,0:18:50.21,0:18:51.50,Default,,0,0,0,,Тек осында -
Dialogue: 0,0:18:51.67,0:18:54.42,Default,,0,0,0,,Негізі ол кісі екен деп күдіктенетіндер бар.
Dialogue: 0,0:18:54.71,0:18:58.76,Default,,0,0,0,,Мені ұрып-соға бастаған дөрекі адам.
Dialogue: 0,0:18:59.59,0:19:01.26,Default,,0,0,0,,Өйткені, Оторо
Dialogue: 0,0:19:05.85,0:19:09.69,Default,,0,0,0,,Менің іздегенім ол бағытта емес.
Dialogue: 0,0:19:12.35,0:19:14.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:15.82,0:19:18.03,Default,,0,0,0,,Кешіріңіз Селти
Dialogue: 0,0:19:18.86,0:19:21.61,Default,,0,0,0,,Ол қаншаға сата алады деп ойлайсың?
Dialogue: 0,0:19:21.70,0:19:23.99,Default,,0,0,0,,Жарайды, бұл сыйлық шығар.
Dialogue: 0,0:19:24.62,0:19:26.70,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:19:34.00,0:19:36.71,Default,,0,0,0,,
Dialogue: 0,0:19:38.59,0:19:39.38,Default,,0,0,0,,Ах
Dialogue: 0,0:19:39.72,0:19:41.22,Default,,0,0,0,,Бұл жоғарыдағы адам ба?
Dialogue: 0,0:19:43.68,0:19:44.89,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:46.93,0:19:47.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.23,0:19:53.23,Default,,0,0,0,,Не?
Dialogue: 0,0:19:54.52,0:19:55.65,Default,,0,0,0,,Казутано!
Dialogue: 0,0:19:56.98,0:19:59.07,Default,,0,0,0,,Казутано! Мен саған қазір көмектесемін
Dialogue: 0,0:19:59.74,0:20:01.24,Default,,0,0,0,,Менің ойымша, бұл оңай бола ма?
Dialogue: 0,0:20:01.36,0:20:02.07,Default,,0,0,0,,Шаракузе
Dialogue: 0,0:20:02.32,0:20:03.91,Default,,0,0,0,,О, ретро сызықтар
Dialogue: 0,0:20:03.99,0:20:05.74,Default,,0,0,0,,Шара дегеніміз не?
Dialogue: 0,0:20:05.95,0:20:07.37,Default,,0,0,0,,
Dialogue: 0,0:20:12.12,0:20:13.12,Default,,0,0,0,,Ах
Dialogue: 0,0:20:13.71,0:20:14.88,Default,,0,0,0,,Ку... Басы жоқ!
Dialogue: 0,0:20:16.08,0:20:18.25,Default,,0,0,0,,Жеңілдік алуға дайындалсам да, мен оны қарт еттім.
Dialogue: 0,0:20:21.26,0:20:23.47,Default,,0,0,0,,Енді жоқ! Мен мұны қайталамаймын!
Dialogue: 0,0:20:23.97,0:20:24.89,Default,,0,0,0,,Не?
Dialogue: 0,0:20:25.68,0:20:26.60,Default,,0,0,0,,Казутано
Dialogue: 0,0:20:27.51,0:20:28.39,Default,,0,0,0,,Дотацино
Dialogue: 0,0:20:28.89,0:20:30.27,Default,,0,0,0,,Ах! қашу
Dialogue: 0,0:20:39.69,0:20:42.74,Default,,0,0,0,,Хехехе, қашып құтыламын деп ойлама!
Dialogue: 0,0:20:44.11,0:20:46.20,Default,,0,0,0,,Оңға бұрылыңыз
Dialogue: 0,0:20:55.67,0:20:56.63,Default,,0,0,0,,(үру)
Dialogue: 0,0:20:57.79,0:20:59.42,Default,,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:21:00.96,0:21:03.88,Default,,0,0,0,,Енді өнімдеріңізді қайда жеткізесіз?
Dialogue: 0,0:21:03.97,0:21:05.80,Default,,0,0,0,,Қазір құсқаныңыз жөн.
Dialogue: 0,0:21:06.18,0:21:08.26,Default,,0,0,0,,Жоқ, жоқ, жоқ, қинамай құсамын.
Dialogue: 0,0:21:08.35,0:21:10.31,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:21:10.43,0:21:12.68,Default,,0,0,0,,Бір кітапты таңдап ал.
Dialogue: 0,0:21:12.81,0:21:15.64,Default,,0,0,0,,Азаптау кітаптың мазмұнына негізделетін болады.
Dialogue: 0,0:21:16.85,0:21:18.77,Default,,0,0,0,,Ей, балалар, не қаласаңдар жақсы...
Dialogue: 0,0:21:18.86,0:21:21.65,Default,,0,0,0,,Бұрынғыдай көлігіңізде бензин қолданбаңыз.
Dialogue: 0,0:21:21.73,0:21:23.32,Default,,0,0,0,,Бензин? (Казутано) Токсано
Dialogue: 0,0:21:23.44,0:21:25.32,Default,,0,0,0,,Таңертеңгілік рәсімімді орындаймын.
Dialogue: 0,0:21:32.66,0:21:35.83,Default,,0,0,0,,Айт! Мен айтамын! Айтуға рұқсат етіңізші
Dialogue: 0,0:21:42.38,0:21:44.38,Default,,0,0,0,,Yagiri Pharmaceutical
Dialogue: 0,0:21:44.67,0:21:46.51,Default,,0,0,0,,Қандай керемет жер.
Dialogue: 0,0:21:46.63,0:21:50.47,Default,,0,0,0,,Бұл шынымен де осында ма? Сіз адамдарға эксперимент жасайсыз ба?
Dialogue: 0,0:21:51.35,0:21:53.52,Default,,0,0,0,,Біз күмәндандық.
Dialogue: 0,0:21:53.81,0:21:56.14,Default,,0,0,0,,Ең болмағанда кестеден...
Dialogue: 0,0:21:56.89,0:22:00.81,Default,,0,0,0,,Бірақ көп нәрсенің екі жағы болады.
Dialogue: 0,0:22:00.90,0:22:03.07,Default,,0,0,0,,Әсіресе осы Икебукуро қаласында...
Dialogue: 0,0:22:03.19,0:22:06.24,Default,,0,0,0,,Сіз тіпті елестете де алмайтын көптеген жасырын құпиялар бар.
Dialogue: 0,0:22:07.70,0:22:09.91,Default,,0,0,0,,Енді бір жерге барып тамақтанайық.
Dialogue: 0,0:22:10.03,0:22:10.95,Default,,0,0,0,,(Танихара) Хахаха, сен тым қатыгезсің.
Dialogue: 0,0:22:11.03,0:22:12.78,Default,,0,0,0,,Асада-куне ресейлік Азия сушиі
Dialogue: 0,0:22:12.87,0:22:14.54,Default,,0,0,0,,Иә, жақсы! Кеттік, кеттік
Dialogue: 0,0:22:14.66,0:22:16.37,Default,,0,0,0,,Жарайды, шешті!
Dialogue: 0,0:22:17.37,0:22:21.13,Default,,0,0,0,,Қалағаныңызша ақша жұмсай аласыз.
Dialogue: 0,0:22:21.21,0:22:23.05,Default,,0,0,0,,Рахмет, әпке
Dialogue: 0,0:22:23.59,0:22:25.55,Default,,0,0,0,,Кездескенше, Сейджи
Dialogue: 0,0:22:29.34,0:22:30.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:22:36.06,0:22:39.44,Default,,0,0,0,,Казутано оқиғасы туралы әлем білетін болады
Dialogue: 0,0:22:39.73,0:22:43.90,Default,,0,0,0,,Міне, бүгін достарым аман-есен оралды.
Dialogue: 0,0:22:44.02,0:22:45.94,Default,,0,0,0,,Біз бақыттымыз
Dialogue: 0,0:22:46.86,0:22:52.87,Default,,0,0,0,,♪~
Dialogue: 0,0:24:06.98,0:24:13.03,Default,,0,0,0,,~♪
Dialogue: 0,0:24:14.53,0:24:20.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory