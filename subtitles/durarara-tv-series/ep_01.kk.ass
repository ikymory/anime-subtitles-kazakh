Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:29.21,0:01:32.02,staff,NTP,0,0,0,,Осы кітапқа арналған Юманью субтитрлерімен жасалған.
Dialogue: 0,0:01:29.21,0:01:32.02,staff,NTP,0,0,0,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:01:31.89,0:01:35.16,Thought,,0,0,0,,Мен оны әлі күнге дейін жұмбақ деп ойлаймын...
Dialogue: 0,0:01:32.11,0:01:33.93,*Default-ja,NTP,0,0,0,,Қазір ойласам да біртүрлі
Dialogue: 0,0:01:35.16,0:01:40.95,Thought,,0,0,0,,...бірақ мен олай емес сияқтымын.
Dialogue: 0,0:01:35.33,0:01:40.89,*Default-ja,NTP,0,0,0,,Бірақ қалай болғанда да мен бұл таңқаларлық емес сияқтымын.
Dialogue: 0,0:01:42.34,0:01:46.87,Thought,,0,0,0,,Қалай болғанда да, бұл менің өмірімді өзгерткен нәрсе болды.
Dialogue: 0,0:01:42.55,0:01:46.77,*Default-ja,NTP,0,0,0,,Қалай болғанда да, бұл менің өмірімді өзгертті.
Dialogue: 0,0:01:47.83,0:01:52.37,Thought,,0,0,0,,Дегенмен, ештеңе өзгермеген сияқты.
Dialogue: 0,0:01:48.13,0:01:51.88,*Default-ja,NTP,0,0,0,,Негізі ештеңе өзгермеген сияқты...
Dialogue: 0,0:01:53.26,0:01:54.96,Thought,,0,0,0,,Бұл өте біртүрлі нәрсе болды,
Dialogue: 0,0:01:53.48,0:01:55.19,*Default-ja,NTP,0,0,0,,Өте, өте біртүрлі
Dialogue: 0,0:01:56.13,0:01:59.64,Thought,,0,0,0,,және сонымен бірге барлығының басынан өткен нәрсе.
Dialogue: 0,0:01:56.48,0:01:59.67,*Default-ja,NTP,0,0,0,,Бірақ менде барлық жерде кездесетін тәжірибе болды.
Dialogue: 0,0:02:01.35,0:02:04.69,Thought,,0,0,0,,Мұның бәрі осы жерде, Икебукурада болды.
Dialogue: 0,0:02:01.63,0:02:04.19,*Default-ja,NTP,0,0,0,,Осы Икебукуро қаласында
Dialogue: 0,0:02:12.72,0:02:15.65,Dialogue,,0,0,0,,Мен-мен-мен-мен өте...рри.
Dialogue: 0,0:02:12.97,0:02:15.23,*Default-ja,NTP,0,0,0,,Кешіріңіз... Кешіріңіз...
Dialogue: 0,0:02:20.46,0:02:22.20,Dialogue,,0,0,0,,Мен үйге қайтқым келеді.
Dialogue: 0,0:02:20.64,0:02:21.56,*Default-ja,NTP,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,0:02:22.19,0:02:23.38,*Default-ja,NTP,0,0,0,,Күлмеңіз
Dialogue: 0,0:02:22.20,0:02:23.70,Thought,,0,0,0,,Өтінемін, күлме.
Dialogue: 0,0:02:23.70,0:02:29.76,Thought,,0,0,0,,Мен бастауыш және орта мектептегі экскурсияларға қатыспадым, сондықтан мен туған жерімнен ешқашан кеткен емеспін.
Dialogue: 0,0:02:23.86,0:02:27.13,*Default-ja,NTP,0,0,0,,Бастауыш және кіші орта мектептерде мектептегі саяхаттарға қатыспаған.
Dialogue: 0,0:02:26.72,0:02:28.21,Secondary,,0,0,0,,Кездескенше!
Dialogue: 0,0:02:27.33,0:02:29.52,*Default-ja,NTP,0,0,0,,Мен туған жерімнен ешқайда кеткен емеспін.
Dialogue: 0,0:02:29.76,0:02:32.79,Thought,,0,0,0,,Қазір, он бес жасымда, мен Токиода алғаш рет болып тұрмын және мен абдырап қалдым.
Dialogue: 0,0:02:29.89,0:02:33.08,*Default-ja,NTP,0,0,0,,15 жасар бала Токиоға алғаш рет келгенін түсінбей қалды.
Dialogue: 0,0:02:30.17,0:02:32.79,Secondary,,0,0,0,,Бұл өте керемет саяхат болды!
Dialogue: 0,0:02:33.30,0:02:36.75,Thought,,0,0,0,,Бұл менмін, Рюгамин Микадо.
Dialogue: 0,0:02:33.53,0:02:36.09,*Default-ja,NTP,0,0,0,,Бұл менмін, Микадо Рюгамин.
Dialogue: 0,0:02:37.75,0:02:43.09,Thought,,0,0,0,,Олай болса, мен неге Тобу теміржолының Тоджо желісінің қақпасының жанында көзімді айналдырып жатырмын?
Dialogue: 0,0:02:38.03,0:02:42.56,*Default-ja,NTP,0,0,0,,Мен неге Tobu Tojo Line билет қақпасының алдында көзімді жұмып тұрмын?
Dialogue: 0,0:02:43.09,0:02:49.19,Thought,,0,0,0,,Себебі мен осы сәуір айынан бастап Шығыс Икебукуродағы Раила академиясына қатысамын.
Dialogue: 0,0:02:43.25,0:02:48.68,*Default-ja,NTP,0,0,0,,Себебі мен осы сәуірден бастап Хигашиикебукуродағы жеке Курира Гакуэнге жазыламын.
Dialogue: 0,0:02:49.19,0:02:54.01,Thought,,0,0,0,,Мектеп соншалықты беделді емес, бірақ әдемі және тамаша жағдайлары бар.
Dialogue: 0,0:02:49.42,0:02:53.83,*Default-ja,NTP,0,0,0,,Ауытқу мәні жоғарғы ортаңғы диапазонда, таза және қондырғылар жақсы жабдықталған.
Dialogue: 0,0:02:54.01,0:02:58.15,Thought,,0,0,0,,Қалай болғанда да, мені мұнда келуге көндіргені – бастауыш сыныптағы ең жақын досымның қалауы болды.
Dialogue: 0,0:02:54.27,0:02:57.92,*Default-ja,NTP,0,0,0,,Ең бастысы, мені бастауыш сыныптағы ең жақын досым шақырды.
Dialogue: 0,0:02:58.15,0:03:03.37,Thought,,0,0,0,,Ата-анам жергілікті мемлекеттік мектепке барғанымды қалады, бірақ мен әрқашан Токиоға барғым келді.
Dialogue: 0,0:02:58.37,0:03:01.56,*Default-ja,NTP,0,0,0,,Менің ата-анам жергілікті мемлекеттік мектепке баруыма қарсылық білдірді.
Dialogue: 0,0:03:01.73,0:03:03.35,*Default-ja,NTP,0,0,0,,Мен де Токионы аңсадым.
Dialogue: 0,0:03:03.37,0:03:05.08,Dialogue,,0,0,0,,Микадо!
Dialogue: 0,0:03:03.56,0:03:04.46,*Default-ja,NTP,0,0,0,,Микадо!
Dialogue: 0,0:03:06.25,0:03:07.12,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:06.53,0:03:07.24,*Default-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:03:08.24,0:03:09.39,Dialogue,,0,0,0,,Кида?
Dialogue: 0,0:03:08.37,0:03:09.34,*Default-ja,NTP,0,0,0,,Кида-кун?
Dialogue: 0,0:03:09.39,0:03:11.02,Dialogue,,0,0,0,,Бұл сұрақ па?
Dialogue: 0,0:03:09.54,0:03:10.74,*Default-ja,NTP,0,0,0,,Сұрау формасы?
Dialogue: 0,0:03:11.02,0:03:12.74,Dialogue,,0,0,0,,Сонда мен қуана жауап беремін.
Dialogue: 0,0:03:11.15,0:03:14.26,*Default-ja,NTP,0,0,0,,Олай болса мен саған жауап беремін. Үш таңдаудан таңдаңыз.
Dialogue: 0,0:03:12.74,0:03:14.66,Dialogue,,0,0,0,,Үш таңдаудың біреуін таңдаңыз.
Dialogue: 0,0:03:14.66,0:03:16.38,Dialogue,,0,0,0,,Бірінші нөмір: Кида Масаоми.
Dialogue: 0,0:03:14.79,0:03:16.62,*Default-ja,NTP,0,0,0,,1 Масаоми Кида
Dialogue: 0,0:03:16.92,0:03:18.76,Dialogue,,0,0,0,,Екінші нөмір: Кида Масаоми.
Dialogue: 0,0:03:17.06,0:03:18.88,*Default-ja,NTP,0,0,0,,2 Масаоми Кида
Dialogue: 0,0:03:18.76,0:03:21.57,Dialogue,,0,0,0,,Үшінші нөмір: Кида Масаоми!
Dialogue: 0,0:03:19.13,0:03:20.85,*Default-ja,NTP,0,0,0,,3 Масаоми Кида!
Dialogue: 0,0:03:21.57,0:03:24.99,Dialogue,,0,0,0,,Мүмкін емес! Бұл шынымен сенсің бе, Кида?
Dialogue: 0,0:03:21.76,0:03:24.37,*Default-ja,NTP,0,0,0,,Уау! Кида-кун! Сіз Кида-кунсыз ба?
Dialogue: 0,0:03:24.62,0:03:28.61,*Default-ja,NTP,0,0,0,,Аа... Мен 3 жыл бойы өткізген шынайы оқиға толық оқиғаға айналды ма?
Dialogue: 0,0:03:24.99,0:03:29.06,Dialogue,,0,0,0,,Сіз менің үш жыл бойы жұмыс істеп келе жатқан әзілге мән бермейсіз бе?
Dialogue: 0,0:03:29.06,0:03:30.77,Dialogue,,0,0,0,,Көптен бері көрмегелі, жігіт!
Dialogue: 0,0:03:29.13,0:03:31.31,*Default-ja,NTP,0,0,0,,Біраз уақыт өтті Эй!
Dialogue: 0,0:03:31.22,0:03:33.69,Dialogue,,0,0,0,,Сен қатты өзгердің, мен бұл сен екеніңді айта алмадым.
Dialogue: 0,0:03:31.51,0:03:33.75,*Default-ja,NTP,0,0,0,,Мен таң қалдым, өйткені ол мүлдем өзгерді.
Dialogue: 0,0:03:33.69,0:03:36.38,Dialogue,,0,0,0,,Шашыңды бояймын деп ойламадым.
Dialogue: 0,0:03:33.84,0:03:36.18,*Default-ja,NTP,0,0,0,,Мен сені шашыңды боядым деп ойламадым.
Dialogue: 0,0:03:36.38,0:03:38.23,Dialogue,,0,0,0,,О, бұл әзіл өте нашар болды.
Dialogue: 0,0:03:36.50,0:03:38.47,*Default-ja,NTP,0,0,0,,Сондай-ақ, бұл тақырып суық.
Dialogue: 0,0:03:38.23,0:03:40.88,Dialogue,,0,0,0,,Міне, төрт жыл болды.
Dialogue: 0,0:03:38.69,0:03:40.58,*Default-ja,NTP,0,0,0,,Тек төрт жыл өтсе~
Dialogue: 0,0:03:40.88,0:03:45.10,Dialogue,,0,0,0,,Қалай болғанда да, сен бастауыш мектептен бері өзгерген жоқсың, Микадо.
Dialogue: 0,0:03:40.91,0:03:45.05,*Default-ja,NTP,0,0,0,,Негізі, Тэйджин бастауыш мектептен бері мүлде өзгерген жоқ!
Dialogue: 0,0:03:45.10,0:03:47.66,Dialogue,,0,0,0,,Менің әзілдерімді жайдан-жай айтпа.
Dialogue: 0,0:03:45.23,0:03:47.42,*Default-ja,NTP,0,0,0,,Дәлірек айтсақ, суық деп кездейсоқ айтпаңыз.
Dialogue: 0,0:03:48.00,0:03:51.67,Thought,,0,0,0,,Иә, бұл менің ең жақын досым Кида Масаоми.
Dialogue: 0,0:03:48.20,0:03:51.54,*Default-ja,NTP,0,0,0,,Иә, бұл менің ең жақын досым Масаоми Кида.
Dialogue: 0,0:03:51.67,0:03:57.77,Thought,,0,0,0,,Мен оны бастауыш сыныптан ауысқаннан бері көрмеппін, бірақ сырт келбетінен басқа, ол аздап өзгерген жоқ.
Dialogue: 0,0:03:51.83,0:03:54.86,*Default-ja,NTP,0,0,0,,Біз бастауыш мектепте оқып жүрген кезімізде ол мектеп ауыстырғанға дейін болған жоқ.
Dialogue: 0,0:03:55.08,0:03:57.48,*Default-ja,NTP,0,0,0,,Сыртқы түрінен басқа ештеңе өзгерген жоқ.
Dialogue: 0,0:03:57.77,0:03:59.27,Dialogue,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:03:57.95,0:03:59.13,*Default-ja,NTP,0,0,0,,(Беатриса) Ол жан-тәнімен ашуландырарлық адам ғой.
Dialogue: 0,0:03:59.27,0:04:01.02,Dialogue,,0,0,0,,Жердің үстіне шығайық.
Dialogue: 0,0:03:59.37,0:04:00.71,*Default-ja,NTP,0,0,0,,Әзірше сыртқа шығайық.
Dialogue: 0,0:04:01.02,0:04:03.60,Dialogue,,0,0,0,,Мен сөзсіз «батысқа бару» көңіл күйіндемін.
Dialogue: 0,0:04:01.05,0:04:03.49,*Default-ja,NTP,0,0,0,,Мен Батысқа барғандай сезінемін!
Dialogue: 0,0:04:03.60,0:04:08.36,Dialogue,,0,0,0,,Мен сізді алдап, батыстағы шығысқа барамын және шынымен де Сейбуға апарамын...
Dialogue: 0,0:04:03.69,0:04:07.80,*Default-ja,NTP,0,0,0,,Батыс шығысы болып көрінетін Сейбу шығысына қарай бет алған күрделі гид...
Dialogue: 0,0:04:06.71,0:04:09.31,Secondary Thought,,0,0,0,,Оның әзілдері онша жақсы емес, бірақ ол тамаша жігіт.
Dialogue: 0,0:04:06.88,0:04:09.56,*Default-ja,NTP,0,0,0,,Оның аузы суық, бірақ ол жақсы жігіт.
Dialogue: 0,0:04:10.18,0:04:16.68,Thought,,0,0,0,,Біз күнде онлайн сөйлесетіндіктен, мен Кидадан онша алыстап тұрғанымды сезбеймін.
Dialogue: 0,0:04:10.41,0:04:13.22,*Default-ja,NTP,0,0,0,,Себебі мен Кидамен күнде сөйлесетінмін.
Dialogue: 0,0:04:13.42,0:04:15.80,*Default-ja,NTP,0,0,0,,Мен уақыт пен қашықтықты ешқашан санамадым.
Dialogue: 0,0:04:16.68,0:04:23.47,Thought,,0,0,0,,Бірақ төрт жылдан кейін қайта қосылғаннан кейін біз әртүрлі қалаларда өскеніміз анық.
Dialogue: 0,0:04:16.85,0:04:19.36,*Default-ja,NTP,0,0,0,,Алайда, біз төрт жылда алғаш рет кездескен кезде,
Dialogue: 0,0:04:19.55,0:04:22.79,*Default-ja,NTP,0,0,0,,Мен алыс жерде тұрғанымды түсіндім.
Dialogue: 0,0:04:23.42,0:04:27.47,*Default-ja,NTP,0,0,0,,А-а, мен бір рет тайып тұрған нәрсені түсіндіргім келіп тұр...
Dialogue: 0,0:04:25.53,0:04:31.26,Thought,,0,0,0,,Дегенмен, ол бұрынғыдай, жаман әзілдерді қосқанда.
Dialogue: 0,0:04:25.96,0:04:30.70,*Default-ja,NTP,0,0,0,,Бірақ іштей ештеңе өзгерген жоқ, оның ішінде гагтың салқындығы да бар.
Dialogue: 0,0:04:28.43,0:04:31.43,*Default-ja,NTP,0,0,0,,Барғыңыз келетін жер бар ма?
Dialogue: 0,0:04:29.28,0:04:31.88,Secondary,,0,0,0,,Сіз барғыңыз келетін нақты жер бар ма?
Dialogue: 0,0:04:31.90,0:04:33.83,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:04:32.07,0:04:35.51,*Default-ja,NTP,0,0,0,,Күн сәулесі 60 т.б.
Dialogue: 0,0:04:33.83,0:04:35.47,Dialogue,,0,0,0,,Sunshine 60 туралы не айтасыз...?
Dialogue: 0,0:04:35.47,0:04:36.94,Dialogue,,0,0,0,,Қазірдің өзінде?
Dialogue: 0,0:04:35.68,0:04:36.89,*Default-ja,NTP,0,0,0,,Бұдан былай?
Dialogue: 0,0:04:36.94,0:04:39.80,Dialogue,,0,0,0,,Ол жаққа барғың келсе, тым болмаса бір қызды ертіп алайық.
Dialogue: 0,0:04:37.09,0:04:40.04,*Default-ja,NTP,0,0,0,,Баратын болсаңыз, ең болмағанда бір қызыңызды өзіңізбен бірге алып жүру керек.
Dialogue: 0,0:04:40.17,0:04:43.05,Dialogue,,0,0,0,,Т-Олай болса, Икебукуро Батыс қақпасы саябағы ше?
Dialogue: 0,0:04:40.30,0:04:43.22,*Default-ja,NTP,0,0,0,,Сосын...сосын Икебукуро Вест Гэйт саябағы?
Dialogue: 0,0:04:43.05,0:04:45.43,Dialogue,,0,0,0,,Оны «Батыс қақпасы саябағы» деп атаңыз.
Dialogue: 0,0:04:43.25,0:04:45.40,*Default-ja,NTP,0,0,0,,Бұл Нишигучи саябағы деп айтыңыз.
Dialogue: 0,0:04:45.43,0:04:49.04,Dialogue,,0,0,0,,Иә? Бірақ оны барлық Икебукюрерлер атамайды ...
Dialogue: 0,0:04:45.73,0:04:48.86,*Default-ja,NTP,0,0,0,,Не? Бірақ мені Икебукуроның бәрі осылай атайды...
Dialogue: 0,0:04:49.04,0:04:51.19,Dialogue,,0,0,0,,Сіз айтып отырған «Икебукюрерлер» дегеніміз не?
Dialogue: 0,0:04:49.09,0:04:51.07,*Default-ja,NTP,0,0,0,,Икебукуро деген кімдер?
Dialogue: 0,0:04:51.19,0:04:53.14,Dialogue,,0,0,0,,Хм? Не, сонда барғың келе ме?
Dialogue: 0,0:04:51.20,0:04:52.87,*Default-ja,NTP,0,0,0,,О, не? менің барғым келеді?
Dialogue: 0,0:04:53.14,0:04:56.14,Dialogue,,0,0,0,,У-у-у-у-күтеміз!
Dialogue: 0,0:04:53.32,0:04:54.67,*Default-ja,NTP,0,0,0,,Не? Жоқ... бірақ...
Dialogue: 0,0:04:55.05,0:04:58.82,*Default-ja,NTP,0,0,0,,А, эй... ей! Ой... тоқтайық.
Dialogue: 0,0:04:57.47,0:04:58.83,Dialogue,,0,0,0,,Бармайық.
Dialogue: 0,0:04:58.83,0:05:00.22,Dialogue,,0,0,0,,Түн болды!
Dialogue: 0,0:04:58.92,0:05:00.09,*Default-ja,NTP,0,0,0,,Түн болды ма?
Dialogue: 0,0:05:00.22,0:05:02.50,Dialogue,,0,0,0,,Бізді банды немесе бірдеңе өлтіреді!
Dialogue: 0,0:05:00.24,0:05:02.41,*Default-ja,NTP,0,0,0,,Бұл түрлі-түсті топ болса да, сіз өлтіресіз.
Dialogue: 0,0:05:02.50,0:05:05.93,Dialogue,,0,0,0,,Осылай жүре берсең, қатты қиналып қаласың.
Dialogue: 0,0:05:02.53,0:05:04.98,*Default-ja,NTP,0,0,0,,Шынымды айтсам, сіз осындай бірдеңе айтсаңыз, мен қиналамын~
Dialogue: 0,0:05:05.93,0:05:08.07,Dialogue,,0,0,0,,Оның үстіне, бар болғаны алты.
Dialogue: 0,0:05:06.04,0:05:07.97,*Default-ja,NTP,0,0,0,,Айтайын дегенім, небәрі 6-да, солай ма?
Dialogue: 0,0:05:08.07,0:05:12.49,Dialogue,,0,0,0,,Аға, сен бұрынғыдай қорқақсың.
Dialogue: 0,0:05:08.24,0:05:11.78,*Default-ja,NTP,0,0,0,,Сонымен... сіз бұрынғыдай қорқақсыз.
Dialogue: 0,0:05:17.04,0:05:19.13,Chat,,0,0,0,,Танака Таро чат бөлмесіне кірді.
Dialogue: 0,0:05:19.37,0:05:21.02,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:05:21.02,0:05:22.17,Chat,,0,0,0,,«Кеш.
Dialogue: 0,0:05:22.17,0:05:23.17,Chat,,0,0,0,,Ах, Сеттон.
Dialogue: 0,0:05:23.17,0:05:27.26,Chat,,0,0,0,,Негізі мен ертеңнен бастап Икебукурада тұрамын.
Dialogue: 0,0:05:27.26,0:05:28.89,Chat,,0,0,0,,Уа, жақсы.
Dialogue: 0,0:05:28.89,0:05:30.97,Chat,,0,0,0,,Сіз менің көршіме көшуіңіз мүмкін.
Dialogue: 0,0:05:30.97,0:05:32.30,Chat,,0,0,0,,Иә, мүмкін.
Dialogue: 0,0:05:32.31,0:05:34.62,Chat,,0,0,0,,Мен әлі де ата-анамның үйінен тіркеліп жатырмын,
Dialogue: 0,0:05:34.62,0:05:38.67,Chat,,0,0,0,,бірақ ертеңнен бастап мен Күн сәулесінің жанындағы пәтерден кіретін боламын.
Dialogue: 0,0:05:39.31,0:05:42.36,Chat,,0,0,0,,Ikebukuro-ға қош келдіңіз.
Dialogue: 0,0:05:42.88,0:05:44.53,Dialogue,,0,0,0,,Керемет...
Dialogue: 0,0:05:42.98,0:05:44.16,*Default-ja,NTP,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:05:45.00,0:05:49.61,Dialogue,,0,0,0,,Мен тек интернеттен және комикстерден көрген бұл дүние ақыры менің алдымда.
Dialogue: 0,0:05:45.17,0:05:49.48,*Default-ja,NTP,0,0,0,,Интернетте немесе мангада ғана көрген дүние көз алдымнан өтіп жатыр...
Dialogue: 0,0:05:50.22,0:05:53.03,Dialogue,,0,0,0,,Бұл Камизакура-мачи Гинзаға қарағанда салқынырақ.
Dialogue: 0,0:05:50.37,0:05:52.45,*Default-ja,NTP,0,0,0,,Камисакурамачи Гинзаға қарағанда ғажайып
Dialogue: 0,0:05:52.56,0:05:56.60,*Default-ja,NTP,0,0,0,,Онда мен сені келесі жолы Шибуяға апарамын.
Dialogue: 0,0:05:53.95,0:05:56.68,Dialogue,,0,0,0,,Олай болса мен сені Шибуяға апарамын.
Dialogue: 0,0:05:56.68,0:06:00.03,Dialogue,,0,0,0,,Немесе, көп адамдар сізді таң қалдырса, мен сізді ат жарысына апара аламын.
Dialogue: 0,0:05:56.79,0:05:59.99,*Default-ja,NTP,0,0,0,,Әй, жұрт сирек болса, мен сені ипподромға апарсам қалай болады?
Dialogue: 0,0:06:01.71,0:06:04.46,Dialogue,,0,0,0,,Жақында бандылардың белсенділігі де төмендеді.
Dialogue: 0,0:06:02.13,0:06:04.17,*Default-ja,NTP,0,0,0,,Соңғы уақытта түрлі-түсті бандалар азайды.
Dialogue: 0,0:06:04.46,0:06:10.22,Dialogue,,0,0,0,,Олар өткен жылы барлық жерде болды, бірақ олар Сайтама жігіттерімен төбелесіп, бір топ адам тұтқындалды.
Dialogue: 0,0:06:04.59,0:06:06.96,*Default-ja,NTP,0,0,0,,Өткен жылы көзге түскен дүниелер көп болды.
Dialogue: 0,0:06:07.15,0:06:10.36,*Default-ja,NTP,0,0,0,,Сайтамамен қақтығыс болып, ондаған адам ұрланған.
Dialogue: 0,0:06:10.64,0:06:19.23,Dialogue,,0,0,0,,Сондай-ақ, полицейлер барлығы бірдей түсті киінген кез келген топты баса бастады.
Dialogue: 0,0:06:10.73,0:06:15.23,*Default-ja,NTP,0,0,0,,Содан бері бір түсті киінген бірнеше адам жиналса.
Dialogue: 0,0:06:15.98,0:06:19.08,*Default-ja,NTP,0,0,0,,Полиция тез ұшып кірді.
Dialogue: 0,0:06:19.25,0:06:21.98,Dialogue,,0,0,0,,Бұл қазір Икебукуроның сейфінде екенін білдіре ме?
Dialogue: 0,0:06:19.40,0:06:21.89,*Default-ja,NTP,0,0,0,,Сонымен, Икебукуро қазір қауіпсіз бе?
Dialogue: 0,0:06:21.98,0:06:28.04,Dialogue,,0,0,0,,Мен тек екінші қолмен естігенмін, сондықтан білмеймін.
Dialogue: 0,0:06:22.02,0:06:25.00,*Default-ja,NTP,0,0,0,,А... жоқ, мен оның жартысын ғана білдім.
Dialogue: 0,0:06:25.12,0:06:27.41,*Default-ja,NTP,0,0,0,,Мен не болғанын нақты білмеймін.
Dialogue: 0,0:06:28.04,0:06:32.12,Dialogue,,0,0,0,,Айналада басқа да қауіпті адамдар бар, сондықтан абай болыңыз.
Dialogue: 0,0:06:28.26,0:06:31.88,*Default-ja,NTP,0,0,0,,Бұл жерде басқа да қауіпті адамдар көп, сондықтан сақ болыңыз.
Dialogue: 0,0:06:32.12,0:06:33.66,Dialogue,,0,0,0,,Мен көремін...
Dialogue: 0,0:06:32.20,0:06:33.31,*Default-ja,NTP,0,0,0,,Дұрыс...
Dialogue: 0,0:06:33.66,0:06:38.21,Dialogue,,0,0,0,,Қалай болғанда да, бұл 60-шы көше, Күн сәулесі көшесі деп те аталады.
Dialogue: 0,0:06:34.08,0:06:38.11,*Default-ja,NTP,0,0,0,,Айтпақшы, бұл 60-қабат көшесі, сонымен қатар Күн сәулесі көшесі де бар.
Dialogue: 0,0:06:38.21,0:06:42.21,Thought,,0,0,0,,Мүмкін ол шынымен де алдымен Күншығыс көшесі деп аталды.
Dialogue: 0,0:06:38.58,0:06:41.89,*Default-ja,NTP,0,0,0,,Менің ойымша, бірінші рет Күн сәулесі көшесі салынды ма?
Dialogue: 0,0:06:43.11,0:06:44.64,*Default-ja,NTP,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:43.17,0:06:45.55,Dialogue,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:50.59,0:06:52.38,*Default-ja,NTP,0,0,0,,Ах, Кида-кун.
Dialogue: 0,0:06:51.13,0:06:52.14,Dialogue,,0,0,0,,Бұл Кида.
Dialogue: 0,0:06:52.14,0:06:54.89,Dialogue,,0,0,0,,Ах, егер бұл Карисава мен Имазаки болмаса.
Dialogue: 0,0:06:52.48,0:06:54.55,*Default-ja,NTP,0,0,0,,Ах, Каризава-сан және Юмасаки-сан.
Dialogue: 0,0:06:54.89,0:06:55.85,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:06:54.99,0:06:55.86,*Default-ja,NTP,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:06:55.85,0:06:57.26,Dialogue,,0,0,0,,Иә, біраз уақыт өтті.
Dialogue: 0,0:06:55.96,0:06:57.32,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, біраз уақыт өтті.
Dialogue: 0,0:06:57.26,0:06:58.45,Dialogue,,0,0,0,,Йо.
Dialogue: 0,0:06:57.35,0:06:58.24,*Default-ja,NTP,0,0,0,,Usu
Dialogue: 0,0:06:58.85,0:07:00.57,Dialogue,,0,0,0,,Қалайсың, Кида?
Dialogue: 0,0:06:59.08,0:07:00.63,*Default-ja,NTP,0,0,0,,Қалайсың? Кида
Dialogue: 0,0:07:00.57,0:07:01.65,Dialogue,,0,0,0,,Көптен бері көрмегелі!
Dialogue: 0,0:07:00.73,0:07:01.77,*Default-ja,NTP,0,0,0,,Гобусата
Dialogue: 0,0:07:01.65,0:07:04.15,Dialogue,,0,0,0,,Жаныңдағы жігіт кім? Дос па?
Dialogue: 0,0:07:02.02,0:07:04.34,*Default-ja,NTP,0,0,0,,Мына бала кім? дос?
Dialogue: 0,0:07:04.15,0:07:09.21,Dialogue,,0,0,0,,Иә, ол бала кезден дос. Ол бүгін ғана осында көшіп келді.
Dialogue: 0,0:07:04.56,0:07:06.85,*Default-ja,NTP,0,0,0,,Әй, бұл менің бала күнгі досым.
Dialogue: 0,0:07:07.16,0:07:09.26,*Default-ja,NTP,0,0,0,,Мен бүгін Икебукураға көштім.
Dialogue: 0,0:07:09.21,0:07:10.65,Dialogue,,0,0,0,,Түсіндім.
Dialogue: 0,0:07:09.39,0:07:10.90,*Default-ja,NTP,0,0,0,,Иә~ Дұрыс.
Dialogue: 0,0:07:10.94,0:07:13.12,Dialogue,,0,0,0,,Оның аты Карисава.
Dialogue: 0,0:07:11.10,0:07:15.03,*Default-ja,NTP,0,0,0,,Бұл адам Каризава мырза, бұл Юмасаки мырза.
Dialogue: 0,0:07:13.12,0:07:15.49,Dialogue,,0,0,0,,Ол Юмасаки,
Dialogue: 0,0:07:16.03,0:07:18.95,Dialogue,,0,0,0,,Ал мұнда Кадота мен Тогуса бар.
Dialogue: 0,0:07:16.22,0:07:18.70,*Default-ja,NTP,0,0,0,,Сол жерде Кадота мырза мен Ватанакуса мырза
Dialogue: 0,0:07:20.31,0:07:24.75,Dialogue,,0,0,0,,Ух, мм...менің атым Рюгамин Микадо.
Dialogue: 0,0:07:21.17,0:07:24.74,*Default-ja,NTP,0,0,0,,А, у... менің атым Рюгамин Микадо.
Dialogue: 0,0:07:28.23,0:07:30.34,Thought,,0,0,0,,Мен болмауы керек нәрсені айттым ба?
Dialogue: 0,0:07:28.43,0:07:30.50,*Default-ja,NTP,0,0,0,,Мен қате айттым ба?
Dialogue: 0,0:07:31.61,0:07:32.96,Dialogue,,0,0,0,,Бұл бүркеншік ат па?
Dialogue: 0,0:07:31.76,0:07:32.86,*Default-ja,NTP,0,0,0,,Қалам аты?
Dialogue: 0,0:07:32.96,0:07:35.87,Dialogue,,0,0,0,,Неліктен орта мектеп оқушысы лақап есімді қолданады?
Dialogue: 0,0:07:33.11,0:07:35.70,*Default-ja,NTP,0,0,0,,Неліктен жоғары сынып оқушылары қалам есімді қолданады?
Dialogue: 0,0:07:35.87,0:07:38.35,Dialogue,,0,0,0,,Әй, ол радиода немесе журналдарда шығар.
Dialogue: 0,0:07:36.03,0:07:38.48,*Default-ja,NTP,0,0,0,,А, радио немесе журнал жіберулер ме?
Dialogue: 0,0:07:38.35,0:07:42.06,Dialogue,,0,0,0,,Жоқ, уф...бұл менің шын атым.
Dialogue: 0,0:07:38.48,0:07:41.25,*Default-ja,NTP,0,0,0,,Жоқ, у... бұл менің шын атым.
Dialogue: 0,0:07:42.06,0:07:44.21,Dialogue,,0,0,0,,Жоқ, бұл сенің атың ба?!
Dialogue: 0,0:07:42.44,0:07:44.10,*Default-ja,NTP,0,0,0,,Өтірікші! Бұл сіздің шын есіміңіз бе?
Dialogue: 0,0:07:44.18,0:07:46.61,*Default-ja,NTP,0,0,0,,Жоқ, бұл керемет! Керемет емес пе!
Dialogue: 0,0:07:44.21,0:07:46.64,Dialogue,,0,0,0,,Керемет! Бұл өте керемет!
Dialogue: 0,0:07:46.64,0:07:48.96,Dialogue,,0,0,0,,Бұл қандай да бір комикстегі кейіпкердің есімі сияқты!
Dialogue: 0,0:07:46.67,0:07:48.92,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, ол манганың басты кейіпкеріне ұқсайды.
Dialogue: 0,0:07:48.96,0:07:52.82,Dialogue,,0,0,0,,Жүр, сен оны ұятқа қалдырдың.
Dialogue: 0,0:07:49.31,0:07:51.62,*Default-ja,NTP,0,0,0,,Бұл өте рас!
Dialogue: 0,0:07:51.29,0:07:54.99,Secondary Thought,,0,0,0,,Мен не істеуім керек? Мен олардың әңгімесіне ілесе алмаймын.
Dialogue: 0,0:07:51.69,0:07:54.24,*Default-ja,NTP,0,0,0,,Мен не істеуім керек... Әңгіменің дамуына ілесе алмаймын.
Dialogue: 0,0:07:54.99,0:07:57.16,Dialogue,,0,0,0,,Сіз дүкеннен қайтып келе жатырсыз ба?
Dialogue: 0,0:07:55.50,0:07:56.85,*Default-ja,NTP,0,0,0,,Дүкеннен үйге бара жатырсыз ба?
Dialogue: 0,0:07:57.16,0:07:58.13,Dialogue,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:57.49,0:07:58.09,*Default-ja,NTP,0,0,0,,Иә!
Dialogue: 0,0:07:58.13,0:08:03.73,Dialogue,,0,0,0,,«Деңгеки» бірнеше жаңа қалта басылымдарын шығарды, сондықтан біз барлығы отыз шақты сатып алдық.
Dialogue: 0,0:07:58.25,0:08:03.70,*Default-ja,NTP,0,0,0,,«Деңгеки бунконың» жаңа саны шықты, сондықтан мен барлығы 30 шақты кітап сатып алдым.
Dialogue: 0,0:08:03.73,0:08:06.70,Dialogue,,0,0,0,,Бір айда сонша кітап шығарады?
Dialogue: 0,0:08:03.87,0:08:07.02,*Default-ja,NTP,0,0,0,,Денгеки Бунко бір айда сонша шыға ма?
Dialogue: 0,0:08:06.70,0:08:08.95,Dialogue,,0,0,0,,Жоқ, әрине жоқ.
Dialogue: 0,0:08:07.22,0:08:08.92,*Default-ja,NTP,0,0,0,,Жоқ, эй, бұл дұрыс емес.
Dialogue: 0,0:08:08.95,0:08:11.51,Dialogue,,0,0,0,,Екеуміз де әр серияның біреуін сатып алдық.
Dialogue: 0,0:08:09.08,0:08:12.92,*Default-ja,NTP,0,0,0,,Бір кітап маған, бірі оған, қалғаны...
Dialogue: 0,0:08:11.51,0:08:15.34,Dialogue,,0,0,0,,Сосын... жарайды, біз әртүрлі себептермен он сатып алдық.
Dialogue: 0,0:08:13.02,0:08:15.47,*Default-ja,NTP,0,0,0,,Жарайды, мен әртүрлі мақсатта 10 шақты кітапты өңдедім.
Dialogue: 0,0:08:15.34,0:08:17.06,Dialogue,,0,0,0,,Әртүрлі, шын мәнінде.
Dialogue: 0,0:08:15.73,0:08:16.96,*Default-ja,NTP,0,0,0,,Әртүрлі мақсаттар үшін!
Dialogue: 0,0:08:17.99,0:08:19.85,Thought,,0,0,0,,Олар «әртүрлі себептер» дегенді білдіреді?
Dialogue: 0,0:08:18.31,0:08:19.65,*Default-ja,NTP,0,0,0,,Әртүрлі қолдану дегеніміз не?
Dialogue: 0,0:08:19.85,0:08:23.64,Thought,,0,0,0,,Олар бірін сақтау, бірін қайта сату, екіншісін оқу және т.б. дегенді білдіреді ме?
Dialogue: 0,0:08:20.15,0:08:23.49,*Default-ja,NTP,0,0,0,,Бұл сақтау, іскерлік пайдалану, бағалау және т.б. үшін ма?
Dialogue: 0,0:08:24.45,0:08:26.19,Dialogue,,0,0,0,,Ал, кеткеніміз жөн.
Dialogue: 0,0:08:24.71,0:08:26.38,*Default-ja,NTP,0,0,0,,Ал, көшетін кез келді.
Dialogue: 0,0:08:27.08,0:08:28.52,Dialogue,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:08:27.19,0:08:28.69,*Default-ja,NTP,0,0,0,,Жақында кездескенше
Dialogue: 0,0:08:28.80,0:08:30.62,Dialogue,,0,0,0,,Жақсы, кездескенше.
Dialogue: 0,0:08:28.95,0:08:30.26,*Default-ja,NTP,0,0,0,,Иә, онда!
Dialogue: 0,0:08:30.57,0:08:32.43,*Default-ja,NTP,0,0,0,,А, содан бастайық...
Dialogue: 0,0:08:30.62,0:08:32.28,Dialogue,,0,0,0,,Біз бұл нәрсені бірінші кезекте қоюымыз керек.
Dialogue: 0,0:08:32.28,0:08:33.71,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:08:32.60,0:08:33.37,*Default-ja,NTP,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:08:33.71,0:08:36.85,Dialogue,,0,0,0,,Эй, оны көлікке соқпа!
Dialogue: 0,0:08:34.02,0:08:36.04,*Default-ja,NTP,0,0,0,,Балалар, көліктерді соқпаңдар!
Dialogue: 0,0:08:36.85,0:08:42.33,Dialogue,,0,0,0,,Олардың бәрі біртүрлі, бірақ сіз оларды білгеннен кейін олар өте жақсы.
Dialogue: 0,0:08:37.03,0:08:38.89,*Default-ja,NTP,0,0,0,,Міне, ол адамдар да өзгерді.
Dialogue: 0,0:08:39.17,0:08:42.02,*Default-ja,NTP,0,0,0,,Сіз олармен жақсы аралассаңыз, олар әдетте жақсы адамдар.
Dialogue: 0,0:08:42.85,0:08:47.21,*Default-ja,NTP,0,0,0,,Эй... Кида-кун, сен де мұндай адамды білесің.
Dialogue: 0,0:08:42.92,0:08:47.29,Dialogue,,0,0,0,,Ммм...сонда сен де сондай адамдармен араласасың ба, Кида?
Dialogue: 0,0:08:47.29,0:08:50.30,Dialogue,,0,0,0,,Мен неше түрлі адамдарды білемін.
Dialogue: 0,0:08:47.61,0:08:50.22,*Default-ja,NTP,0,0,0,,Себебі көп жерде мойынымды шығарып жатырмын.
Dialogue: 0,0:08:50.30,0:08:56.30,Dialogue,,0,0,0,,Сондықтан мен көптеген жақсы дүкендерді білемін, арзан киімдерді қайдан табуға болады...
Dialogue: 0,0:08:50.62,0:08:52.59,*Default-ja,NTP,0,0,0,,Қолданылған арзан киімдерді сақтау орны мен ақпараты...
Dialogue: 0,0:08:52.30,0:08:56.30,Secondary Thought,,0,0,0,,Біз бөлек тұрған төрт жыл ішінде ол қандай тәжірибені бастан өткерді?
Dialogue: 0,0:08:52.59,0:08:56.71,*Default-ja,NTP,0,0,0,,Төрт жылда қанша және нені басынан өткерді?
Dialogue: 0,0:08:56.83,0:09:00.10,Thought,,0,0,0,,Осының бәрі мен туған жерімде қамауда жүргенде.
Dialogue: 0,0:08:57.04,0:08:59.75,*Default-ja,NTP,0,0,0,,Туған жерімде жалғыз қалып, қурап қалған кезім
Dialogue: 0,0:08:59.77,0:09:04.45,*Default-ja,NTP,0,0,0,,Тақырыптардың барлық түрлерімен таныс болсаңыз, әйелдердің көпшілігімен сөйлесе аласыз.
Dialogue: 0,0:09:00.10,0:09:04.54,Dialogue,,0,0,0,,Егер сіз әртүрлі нәрселер туралы жеткілікті білсеңіз, кез келген қызбен дерлік сөйлесе аласыз.
Dialogue: 0,0:09:04.54,0:09:05.81,Thought,,0,0,0,,Қаншалықты өрескел.
Dialogue: 0,0:09:04.75,0:09:05.83,*Default-ja,NTP,0,0,0,,Таза емес
Dialogue: 0,0:09:07.30,0:09:08.73,Dialogue,,0,0,0,,Мен сізге айттым.
Dialogue: 0,0:09:07.57,0:09:08.98,*Default-ja,NTP,0,0,0,,Міне, сіз!
Dialogue: 0,0:09:08.73,0:09:11.48,Dialogue,,0,0,0,,Оның ол екеніне сенімдісің бе?
Dialogue: 0,0:09:09.20,0:09:10.65,*Default-ja,NTP,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:12.06,0:09:16.49,Dialogue,,0,0,0,,Ол сіз маған берген сипаттамаға бастан-аяқ сәйкес келеді.
Dialogue: 0,0:09:12.29,0:09:16.35,*Default-ja,NTP,0,0,0,,Менің басымнан аяғымның ұшына дейін, мен сенімдімін.
Dialogue: 0,0:09:16.93,0:09:18.09,*Default-ja,NTP,0,0,0,,Ху... Раджа
Dialogue: 0,0:09:17.05,0:09:17.77,Dialogue,,0,0,0,,Роджер.
Dialogue: 0,0:09:18.53,0:09:20.10,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:09:18.68,0:09:19.77,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:09:20.10,0:09:20.92,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:09:20.17,0:09:21.18,*Default-ja,NTP,0,0,0,,Whis
Dialogue: 0,0:09:20.92,0:09:23.12,Dialogue,,0,0,0,,жеткілікті мөлшерде салыңыз.
Dialogue: 0,0:09:21.21,0:09:22.77,*Default-ja,NTP,0,0,0,,Сіз дұрыс емес соманы алмайсыз.
Dialogue: 0,0:09:23.12,0:09:26.83,Dialogue,,0,0,0,,Егер ол оянбаса, оның құны әлдеқайда төмен болады.
Dialogue: 0,0:09:23.23,0:09:26.66,*Default-ja,NTP,0,0,0,,Оянбасаңыз, көтерілу күрт төмендейді.
Dialogue: 0,0:09:26.83,0:09:30.63,Dialogue,,0,0,0,,Ол жасөспірім қыз, сондықтан біз әдеттегіден елу пайызға артық аламыз.
Dialogue: 0,0:09:27.01,0:09:30.72,*Default-ja,NTP,0,0,0,,Бұл жақсы емес пе? Егер бұл жасөспірім қыз болса, бұл 50% артық, солай емес пе?
Dialogue: 0,0:09:30.94,0:09:32.91,Dialogue,,0,0,0,,Жиырма пайызға жуық.
Dialogue: 0,0:09:31.05,0:09:32.73,*Default-ja,NTP,0,0,0,,20% 20%
Dialogue: 0,0:09:32.91,0:09:36.20,Dialogue,,0,0,0,,Бізде көптен бері жасөспірім қыз болмаған.
Dialogue: 0,0:09:33.00,0:09:36.48,*Default-ja,NTP,0,0,0,,Мен дәмді нәрсенің дәмін татып көрмегелі көп болды. Жасөспірім қыз
Dialogue: 0,0:09:36.20,0:09:38.64,Dialogue,,0,0,0,,Иә, біз алған ақпараттың арқасында.
Dialogue: 0,0:09:36.55,0:09:38.99,*Default-ja,NTP,0,0,0,,Ах, информатор мырза.
Dialogue: 0,0:09:43.14,0:09:44.52,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:09:43.38,0:09:44.59,*Default-ja,NTP,0,0,0,,Қайырлы кеш~
Dialogue: 0,0:09:44.52,0:09:45.43,Chat,,0,0,0,,Канра!
Dialogue: 0,0:09:44.98,0:09:45.75,*Default-ja,NTP,0,0,0,,Канра-сан!
Dialogue: 0,0:09:45.77,0:09:46.68,*Default-ja,NTP,0,0,0,,Сіз сонда болдыңыз ба!?
Dialogue: 0,0:09:45.77,0:09:46.92,Chat,,0,0,0,,Сіз желідесіз бе?
Dialogue: 0,0:09:46.92,0:09:48.65,Chat,,0,0,0,,Маған қоңырау шалу керек болды.
Dialogue: 0,0:09:46.98,0:09:48.22,*Default-ja,NTP,0,0,0,,Мен жаңа ғана телефонмен сөйлестім.
Dialogue: 0,0:09:48.65,0:09:49.31,Chat,,0,0,0,,Алған заттарымның ақшасын кем дегенде қайтарығым келеді, түсінесің бе.
Dialogue: 0,0:09:48.78,0:09:49.18,*Default-ja,NTP,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:49.24,0:09:52.53,*Default-ja,NTP,0,0,0,,Мен журналды оқыдым. Токиоға келесіз бе?
Dialogue: 0,0:09:49.31,0:09:52.32,Chat,,0,0,0,,Мен журналды оқып бітірдім. Сіз Токиоға келесіз бе?
Dialogue: 0,0:09:52.32,0:09:54.19,Chat,,0,0,0,,Құттықтаймыз.
Dialogue: 0,0:09:52.60,0:09:54.09,*Default-ja,NTP,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:09:54.16,0:09:56.27,*Default-ja,NTP,0,0,0,,Сіз мұны келесі жолы офлайн жиналыста жасайсыз ба?
Dialogue: 0,0:09:54.19,0:09:56.44,Chat,,0,0,0,,Біз кез келген уақытта желіден тыс кездесе аламыз ба?
Dialogue: 0,0:09:56.44,0:09:58.86,Chat,,0,0,0,,Бұл маған жақсы естіледі.
Dialogue: 0,0:09:56.55,0:09:58.77,*Default-ja,NTP,0,0,0,,Оффлайн кездесу жақсы.
Dialogue: 0,0:09:58.86,0:10:00.12,Chat,,0,0,0,,Барлығы.
Dialogue: 0,0:09:59.15,0:10:00.13,*Default-ja,NTP,0,0,0,,Сәлем~
Dialogue: 0,0:10:00.12,0:10:01.85,Chat,,0,0,0,,Офлайн кездесулер туралы айтсақ...
Dialogue: 0,0:10:00.19,0:10:00.69,*Default-ja,NTP,0,0,0,,Ах...
Dialogue: 0,0:10:00.72,0:10:01.66,*Default-ja,NTP,0,0,0,,Офлайн жиналыстар туралы айту
Dialogue: 0,0:10:01.70,0:10:03.60,*Default-ja,NTP,0,0,0,,Өз-өзіне қол жұмсау деген бар емес пе?
Dialogue: 0,0:10:01.85,0:10:03.74,Chat,,0,0,0,,Көптеген адамдар өз-өзіне қол жұмсау үшін желіден тыс кездесіп қалады, солай емес пе?
Dialogue: 0,0:10:03.69,0:10:05.80,*Default-ja,NTP,0,0,0,,Әй, бұл танымал болды, солай емес пе?
Dialogue: 0,0:10:03.74,0:10:05.75,Chat,,0,0,0,,Иә, ол біраз уақыт танымал болды.
Dialogue: 0,0:10:05.75,0:10:08.04,Chat,,0,0,0,,Олар желіде кездесіп, сосын өз-өзіне қол жұмсау туралы келісім жасайды...
Dialogue: 0,0:10:05.89,0:10:07.94,*Default-ja,NTP,0,0,0,,Біз желіде танысып, өзімізге қол жұмсадық...
Dialogue: 0,0:10:08.04,0:10:09.79,Chat,,0,0,0,,Қандай жағымсыз тақырып.
Dialogue: 0,0:10:08.25,0:10:09.85,*Default-ja,NTP,0,0,0,,Бұл жиіркенішті әңгіме, солай емес пе?
Dialogue: 0,0:10:09.79,0:10:13.04,Chat,,0,0,0,,Бірақ мұндай әңгімелер соңғы кездері жаңалық жасамайды, солай ма?
Dialogue: 0,0:10:10.03,0:10:12.95,*Default-ja,NTP,0,0,0,,Бірақ соңғы кездері жаңалықтар көп болмады, солай емес пе?
Dialogue: 0,0:10:13.04,0:10:15.21,Chat,,0,0,0,,Адамдар өзін-өзі өлтіре алмаған шығар...
Dialogue: 0,0:10:13.20,0:10:15.04,*Default-ja,NTP,0,0,0,,Бұл әрекетпен аяқталды ма...
Dialogue: 0,0:10:15.21,0:10:17.01,Chat,,0,0,0,,Немесе әлі де көптеген оқиғалар болуы мүмкін,
Dialogue: 0,0:10:15.34,0:10:17.09,*Default-ja,NTP,0,0,0,,Немесе көп.
Dialogue: 0,0:10:17.01,0:10:20.05,Chat,,0,0,0,,бірақ олардың әлі де болып жатқанын ешкім байқамады.
Dialogue: 0,0:10:17.23,0:10:19.97,*Default-ja,NTP,0,0,0,,Оны ешкім байқамайтын да шығар.
Dialogue: 0,0:10:20.05,0:10:22.60,Chat,,0,0,0,,Мәйіт табылмаған шығар...
Dialogue: 0,0:10:22.60,0:10:23.94,Chat,,0,0,0,,Ух...
Dialogue: 0,0:10:23.94,0:10:25.80,Chat,,0,0,0,,Бұл орынсыз.
Dialogue: 0,0:10:25.80,0:10:28.44,Chat,,0,0,0,,Бұл туралы айтатын болсақ, соңғы уақытта із-түссіз жоғалу фактілері көп тіркелді...
Dialogue: 0,0:10:28.44,0:10:29.10,Chat,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:10:29.10,0:10:30.31,Chat,,0,0,0,,Олар жаңалық жасаған сияқты ма?
Dialogue: 0,0:10:30.31,0:10:31.81,Chat,,0,0,0,,Умм...
Dialogue: 0,0:10:31.81,0:10:34.77,Chat,,0,0,0,,Олардың көпшілігі заңсыз шетелдіктер болған...
Dialogue: 0,0:10:34.77,0:10:36.47,Chat,,0,0,0,,...немесе үйден қашып кеткен балалар...
Dialogue: 0,0:10:37.56,0:10:41.22,Chat,,0,0,0,,Бірақ олардың көпшілігі Икебукуро мен Шибуя арасында кездеседі.
Dialogue: 0,0:10:41.86,0:10:42.82,Dialogue,,0,0,0,,Онда оны киемін!
Dialogue: 0,0:10:42.09,0:10:42.67,*Default-ja,NTP,0,0,0,,Ум...
Dialogue: 0,0:10:43.62,0:10:45.23,Dialogue,,0,0,0,,Иә...?
Dialogue: 0,0:10:43.71,0:10:44.47,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:10:45.23,0:10:46.20,Dialogue,,0,0,0,,Сіз қызғылт қызсыз ба?
Dialogue: 0,0:10:45.40,0:10:46.46,*Default-ja,NTP,0,0,0,,Қып-қызыл мырза?
Dialogue: 0,0:10:46.56,0:10:47.84,Dialogue,,0,0,0,,​​Иә, мен.
Dialogue: 0,0:10:46.68,0:10:47.55,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:10:47.90,0:10:50.22,*Default-ja,NTP,0,0,0,,А, сен Накура-сансың ба?
Dialogue: 0,0:10:48.71,0:10:49.91,Dialogue,,0,0,0,,Сіз Накура мырзасыз ба?
Dialogue: 0,0:10:49.91,0:10:53.28,Dialogue,,0,0,0,,Керемет! I knew it was you.
Dialogue: 0,0:10:50.34,0:10:53.21,*Default-ja,NTP,0,0,0,,Жақсы! Солай ма?
Dialogue: 0,0:10:53.28,0:10:54.58,Dialogue,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:10:53.40,0:10:55.96,*Default-ja,NTP,0,0,0,,Танысқаныма қуаныштымын. Рақмет сізге.
Dialogue: 0,0:10:54.58,0:10:56.88,Dialogue,,0,0,0,,Маған қамқорлық жасаңыз.
Dialogue: 0,0:10:56.88,0:10:58.40,Dialogue,,0,0,0,,Сізбен де танысқаныма қуаныштымын.
Dialogue: 0,0:10:57.10,0:10:58.29,*Default-ja,NTP,0,0,0,,Мен де солай.
Dialogue: 0,0:10:58.40,0:10:59.59,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:10:58.49,0:10:59.86,*Default-ja,NTP,0,0,0,,Олай болса, барамыз ба?
Dialogue: 0,0:11:00.66,0:11:02.22,Dialogue,,0,0,0,,Жарайды...
Dialogue: 0,0:11:00.82,0:11:01.88,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:11:05.72,0:11:07.62,Dialogue,,0,0,0,,Дәл осылай.
Dialogue: 0,0:11:05.91,0:11:09.55,*Default-ja,NTP,0,0,0,,Дәл сол жерде, тағы екі адам келе жатыр.
Dialogue: 0,0:11:07.62,0:11:10.07,Dialogue,,0,0,0,,Онда екі адам болуы керек.
Dialogue: 0,0:11:10.05,0:11:10.97,*Default-ja,NTP,0,0,0,,Күрсін...
Dialogue: 0,0:11:10.07,0:11:10.69,Dialogue,,0,0,0,,Алған заттарымның ақшасын кем дегенде қайтарығым келеді, түсінесің бе.
Dialogue: 0,0:11:13.00,0:11:13.77,Dialogue,,0,0,0,,Міне.
Dialogue: 0,0:11:13.22,0:11:14.13,*Default-ja,NTP,0,0,0,,Осымен.
Dialogue: 0,0:11:22.79,0:11:24.07,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:11:22.94,0:11:23.95,*Default-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:11:25.02,0:11:26.18,Dialogue,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:11:25.18,0:11:26.07,*Default-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:11:26.18,0:11:27.87,Dialogue,,0,0,0,,Біз түсініктіміз бе?
Dialogue: 0,0:11:26.25,0:11:27.42,*Default-ja,NTP,0,0,0,,Айналаңызда бәрі жақсы ма?
Dialogue: 0,0:11:27.87,0:11:30.30,Dialogue,,0,0,0,,Айналада ешкім жоқ.
Dialogue: 0,0:11:27.99,0:11:29.75,*Default-ja,NTP,0,0,0,,Бірде-бір адам қалмады.
Dialogue: 0,0:11:30.30,0:11:33.73,Dialogue,,0,0,0,,Олай болса, сізді алдағаным үшін кешіріңіз!
Dialogue: 0,0:11:30.34,0:11:33.64,*Default-ja,NTP,0,0,0,,Олай болса... Сені алдағаным үшін кешір!
Dialogue: 0,0:11:53.34,0:11:55.94,Dialogue,,0,0,0,,Сіз осындай жерде жалғызсыз ба?
Dialogue: 0,0:11:53.47,0:11:55.79,*Default-ja,NTP,0,0,0,,Мұнда бір ғана адам бар.
Dialogue: 0,0:12:00.02,0:12:02.74,Thought,,0,0,0,,Кида бір үзіліссіз әңгімесін жалғастырды.
Dialogue: 0,0:12:00.47,0:12:02.96,*Default-ja,NTP,0,0,0,,Кида-кун еш ойланбастан сөзін жалғастырды.
Dialogue: 0,0:12:03.19,0:12:05.37,Thought,,0,0,0,,Мен шаршай бастадым.
Dialogue: 0,0:12:03.57,0:12:05.14,*Default-ja,NTP,0,0,0,,Мен аздап шаршадым.
Dialogue: 0,0:12:05.37,0:12:12.91,Thought,,0,0,0,,Жаяу жүріп шаршадым ба, әлде оның әзілдеріне ілесе алмай қалдым ба, білмедім, бәлкім, бұл екеуінен де болса керек.
Dialogue: 0,0:12:05.65,0:12:10.38,*Default-ja,NTP,0,0,0,,Жаяу жүруден шаршадыңыз ба? Сіз Кида-кунның суық тиюін таңдаудан шаршадыңыз ба?
Dialogue: 0,0:12:07.20,0:12:14.17,Secondary,,0,0,0,,Ақыры сені көргеннен кейін қанша сөйлессем де аздық ететіндей болдым.
Dialogue: 0,0:12:10.02,0:12:14.01,*Default-ja,NTP,0,0,0,,Айтуға әлі жетпейді.
Dialogue: 0,0:12:11.03,0:12:12.59,*Default-ja,NTP,0,0,0,,Мүмкін екеуі де болған шығар.
Dialogue: 0,0:12:14.17,0:12:15.97,Dialogue,,0,0,0,,И-Иә, мен де...
Dialogue: 0,0:12:14.75,0:12:16.17,*Default-ja,NTP,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:12:15.97,0:12:21.03,Dialogue,,0,0,0,,Дәл қазір мен ойлаған нәрсенің 5/400-і туралы ғана айтқан сияқтымын!
Dialogue: 0,0:12:16.28,0:12:21.00,*Default-ja,NTP,0,0,0,,Мен әлі де жалпы санның 5/400-і туралы айтып тұрғандай сезінемін.
Dialogue: 0,0:12:21.03,0:12:23.72,Dialogue,,0,0,0,,Оның 4/400 бөлігі Карисава мен оның досына жұмсалды.
Dialogue: 0,0:12:21.30,0:12:24.26,*Default-ja,NTP,0,0,0,,Айтпақшы, 4/400 Каризава мырзаға және т.б.
Dialogue: 0,0:12:23.72,0:12:28.01,Thought,,0,0,0,,Мен оның әзіліне қосылып ойнасам ба, жоқ па деп таласып жатқанымда, бұл менің көз алдымда болды.
Dialogue: 0,0:12:24.31,0:12:26.30,*Default-ja,NTP,0,0,0,,Мен осында отырсам ба, жоқ па деп жүргенде.
Dialogue: 0,0:12:26.75,0:12:28.69,*Default-ja,NTP,0,0,0,,Менің көз алдымда көрінді
Dialogue: 0,0:12:28.01,0:12:31.39,Dialogue,,0,0,0,,Эй, ханым, көптен бері көрмегелі.
Dialogue: 0,0:12:28.77,0:12:31.36,*Default-ja,NTP,0,0,0,,Оне Сан Хисаши~Бури
Dialogue: 0,0:12:31.39,0:12:33.75,Thought,,0,0,0,,Аспаз болып киінген қара жігіт тұтынушыларға қуырғыш таратып жатқан...
Dialogue: 0,0:12:31.54,0:12:33.74,*Default-ja,NTP,0,0,0,,Аспаз болып киініп, тұтынушыларды тарту...
Dialogue: 0,0:12:33.75,0:12:37.48,Thought,,0,0,0,,Жоқ, дәу қара жігіт аспазша киінген...
Dialogue: 0,0:12:33.95,0:12:37.27,*Default-ja,NTP,0,0,0,,Жоқ, аспаз болып киінген қара адам үлкен...
Dialogue: 0,0:12:37.48,0:12:42.02,Thought,,0,0,0,,Жоқ, аспазшы болып киінген бір жігіт парақшаларды таратып жатыр еді, ол кездейсоқ қара түсті...
Dialogue: 0,0:12:37.72,0:12:42.03,*Default-ja,NTP,0,0,0,,Жоқ, тоут аспаздың костюмін киген, бірақ қандай да бір себептермен ол қара...
Dialogue: 0,0:12:42.02,0:12:44.53,Dialogue,,0,0,0,,Көптен бері көрмедім, мырза.
Dialogue: 0,0:12:42.36,0:12:44.27,*Default-ja,NTP,0,0,0,,Ониисан Хисашибури~
Dialogue: 0,0:12:47.35,0:12:50.41,Dialogue,,0,0,0,,Сәлем, Саймон! Бұл мәңгі болды!
Dialogue: 0,0:12:47.78,0:12:50.50,*Default-ja,NTP,0,0,0,,Сәлем Саймон! Біраз уақыт өтті!
Dialogue: 0,0:12:50.41,0:12:52.02,Dialogue,,0,0,0,,Ах, Кида.
Dialogue: 0,0:12:51.17,0:12:52.28,*Default-ja,NTP,0,0,0,,Ммм Кида
Dialogue: 0,0:12:52.02,0:12:52.97,Dialogue,,0,0,0,,Суши жегіңіз келе ме?
Dialogue: 0,0:12:52.37,0:12:54.17,*Default-ja,NTP,0,0,0,,Сіз суши жейсіз бе? Жақсы
Dialogue: 0,0:12:52.97,0:12:54.04,Dialogue,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:54.04,0:12:55.11,Dialogue,,0,0,0,,Мен сізге жеңілдік беремін.
Dialogue: 0,0:12:54.29,0:12:56.70,*Default-ja,NTP,0,0,0,,Арзан және дәмді суши
Dialogue: 0,0:12:55.11,0:12:56.62,Dialogue,,0,0,0,,Суши жақсы.
Dialogue: 0,0:12:56.62,0:12:59.16,Dialogue,,0,0,0,,Кешіріңіз, менде көп ақша жоқ.
Dialogue: 0,0:12:56.90,0:12:59.07,*Default-ja,NTP,0,0,0,,Аа, менде ақша жоқ, сондықтан мен бүгін кешірім сұраймын.
Dialogue: 0,0:12:59.16,0:13:02.34,Dialogue,,0,0,0,,Төлем алған соң осында тамақтанамын, сол кезде маған жеңілдік беріңіз.
Dialogue: 0,0:12:59.45,0:13:01.33,*Default-ja,NTP,0,0,0,,Мен жарты күн жұмыс істеймін, ақша алған кезде тамақтанамын.
Dialogue: 0,0:13:01.52,0:13:03.01,*Default-ja,NTP,0,0,0,,Маған қызмет ет
Dialogue: 0,0:13:02.65,0:13:04.06,Dialogue,,0,0,0,,Жоқ, бұл жақсы емес!
Dialogue: 0,0:13:03.07,0:13:04.34,*Default-ja,NTP,0,0,0,,Жоқ~
Dialogue: 0,0:13:04.06,0:13:07.22,Dialogue,,0,0,0,,Олай етсең, мен Ресейдің балдырлы жазықтарында жоғалып кетемін!
Dialogue: 0,0:13:04.46,0:13:05.48,*Default-ja,NTP,0,0,0,,Содан кейін I
Dialogue: 0,0:13:05.59,0:13:07.75,*Default-ja,NTP,0,0,0,,Орыс топырағына еніп кету ~ё
Dialogue: 0,0:13:07.22,0:13:09.50,Dialogue,,0,0,0,,Құрлықтағы балдырлар, а?
Dialogue: 0,0:13:07.81,0:13:09.39,*Default-ja,NTP,0,0,0,,Жер болса да, балдырлардың қоқысы.
Dialogue: 0,0:13:10.61,0:13:12.12,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:13:11.05,0:13:11.95,*Default-ja,NTP,0,0,0,,Сау болыңыз
Dialogue: 0,0:13:15.19,0:13:18.03,Dialogue,,0,0,0,,Көптен бері көрмедім, мырза.
Dialogue: 0,0:13:15.54,0:13:17.82,*Default-ja,NTP,0,0,0,,Ониисан Хисаши~Бури
Dialogue: 0,0:13:19.28,0:13:20.88,Dialogue,,0,0,0,,Сіз де оны танисыз ба?
Dialogue: 0,0:13:19.70,0:13:20.95,*Default-ja,NTP,0,0,0,,Сіз бұл адамды қазір танисыз ба?
Dialogue: 0,0:13:20.88,0:13:22.88,Dialogue,,0,0,0,,Иә, бұл Саймон.
Dialogue: 0,0:13:21.14,0:13:21.85,*Default-ja,NTP,0,0,0,,О
Dialogue: 0,0:13:21.88,0:13:24.74,*Default-ja,NTP,0,0,0,,Саймон – орыс ұлтынан шыққан қара нәсілді адам.
Dialogue: 0,0:13:22.86,0:13:28.62,Dialogue,,0,0,0,,Ол Африкадан шыққан орыс және ол ресейлікке тиесілі суши орнында жұмыс істейді.
Dialogue: 0,0:13:25.07,0:13:28.25,*Default-ja,NTP,0,0,0,,Мен сол жерде бір орыс жігіті басқаратын суши мейрамханасында турист болып жұмыс істедім.
Dialogue: 0,0:13:28.95,0:13:30.98,Dialogue,,0,0,0,,Кешіріңіз. Оның қандай бөлігі әзіл?
Dialogue: 0,0:13:29.39,0:13:31.40,*Default-ja,NTP,0,0,0,,Кешіріңіз, неден бастау керек?
Dialogue: 0,0:13:30.98,0:13:33.26,Dialogue,,0,0,0,,Жоқ, мен байсалдымын.
Dialogue: 0,0:13:31.52,0:13:33.30,*Default-ja,NTP,0,0,0,,Жоқ, мен байсалдымын.
Dialogue: 0,0:13:33.26,0:13:38.15,Dialogue,,0,0,0,,Оның есімі шынымен Семён, бірақ бәрі ағылшынша «Симон» сияқты айтады.
Dialogue: 0,0:13:33.56,0:13:35.52,*Default-ja,NTP,0,0,0,,Негізі менің атым Самья.
Dialogue: 0,0:13:35.71,0:13:37.77,*Default-ja,NTP,0,0,0,,Мені барлығы ағылшын тілінде Саймон деп атайды.
Dialogue: 0,0:13:37.19,0:13:38.15,Secondary,,0,0,0,,О, эй, мырза...
Dialogue: 0,0:13:38.15,0:13:42.38,Dialogue,,0,0,0,,Мен ол туралы көп білмеймін, бірақ оның ата-анасы осы жерден пана іздеп жүрген сияқты.
Dialogue: 0,0:13:38.37,0:13:42.66,*Default-ja,NTP,0,0,0,,Мен бұл туралы көп білмеймін, бірақ менің ата-анам Америкадан немесе басқа елдерден қоныс аударған.
Dialogue: 0,0:13:42.69,0:13:47.43,Dialogue,,0,0,0,,Енді ресейлік суши-бар ашқаннан кейін, ол тұтынушыларды тарту үшін жұмыс істеп жатыр.
Dialogue: 0,0:13:43.03,0:13:47.89,*Default-ja,NTP,0,0,0,,жылы бір орыс досым суши мейрамханасын ашты, сондықтан ол тұтынушы болды.
Dialogue: 0,0:13:47.93,0:13:50.65,Dialogue,,0,0,0,,Оның жаман жағына түспе, жарай ма?
Dialogue: 0,0:13:48.35,0:13:50.62,*Default-ja,NTP,0,0,0,,Оны өзіңе жау ете алмайсың.
Dialogue: 0,0:13:50.65,0:13:56.11,Dialogue,,0,0,0,,Бірде ол бір қолымен үлкен жігітті көтеріп төбелесті бұзды.
Dialogue: 0,0:13:51.08,0:13:53.07,*Default-ja,NTP,0,0,0,,Соңғы рет ұрысты тоқтатқанда.
Dialogue: 0,0:13:53.19,0:13:56.25,*Default-ja,NTP,0,0,0,,Мен бір қолыммен бірдей өлшемдегі адамды көтеріп тұрдым.
Dialogue: 0,0:13:56.11,0:14:00.62,Dialogue,,0,0,0,,О, тағы бір жігітке жау болмау керек...
Dialogue: 0,0:13:56.64,0:14:00.31,*Default-ja,NTP,0,0,0,,О, айтпақшы, тағы бір адам бар, оған жау болмау керек...
Dialogue: 0,0:14:05.74,0:14:08.21,*Default-ja,NTP,0,0,0,,Не? Бұл не?
Dialogue: 0,0:14:05.97,0:14:08.61,Dialogue,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:14:13.59,0:14:17.05,Dialogue,,0,0,0,,Әй, шайтан туралы айт.
Dialogue: 0,0:14:13.98,0:14:16.81,*Default-ja,NTP,0,0,0,,А... Өсек-аяң болса ғой.
Dialogue: 0,0:14:17.05,0:14:21.43,Dialogue,,0,0,0,,Қалай болғанда да, Хэйвадзима Шизуоға жақындама.
Dialogue: 0,0:14:17.49,0:14:21.18,*Default-ja,NTP,0,0,0,,Қалай болғанда да, Шизуо Хэйвадзимаға жақындама.
Dialogue: 0,0:14:21.43,0:14:25.32,Dialogue,,0,0,0,,Егер сіз өз ісіңізбен айналыссаңыз, сіз оны ешқашан кездестірмейтін шығарсыз.
Dialogue: 0,0:14:21.76,0:14:25.22,*Default-ja,NTP,0,0,0,,Егер мен қалыпты өмір сүретін болсам, сенімен сөйлесе алмас едім.
Dialogue: 0,0:14:25.32,0:14:28.36,Thought,,0,0,0,,W-Ол қандай адам болуы мүмкін?
Dialogue: 0,0:14:25.70,0:14:27.95,*Default-ja,NTP,0,0,0,,Мен... сен қандай адамсың?
Dialogue: 0,0:14:34.27,0:14:36.87,Dialogue,,0,0,0,,Әй, олар әлі жоқ.
Dialogue: 0,0:14:34.80,0:14:38.40,*Default-ja,NTP,0,0,0,,Иә? Ол әлі келген жоқ. Бұл қорқынышты.
Dialogue: 0,0:14:36.87,0:14:38.43,Dialogue,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:14:38.43,0:14:40.54,Dialogue,,0,0,0,,Жоғары жақтағылар бұған қорқынышты.
Dialogue: 0,0:14:38.74,0:14:40.54,*Default-ja,NTP,0,0,0,,Жоғарғы жағы да нашар.
Dialogue: 0,0:14:40.54,0:14:42.98,Dialogue,,0,0,0,,Олар өз әрекетін біріктіру керек.
Dialogue: 0,0:14:40.81,0:14:43.26,*Default-ja,NTP,0,0,0,,Маған мұқият болу керек.
Dialogue: 0,0:14:43.43,0:14:46.10,Dialogue,,0,0,0,,Не болса да. Бізде уақыт бар.
Dialogue: 0,0:14:43.76,0:14:46.44,*Default-ja,NTP,0,0,0,,Жақсы, біз боспыз.
Dialogue: 0,0:14:46.10,0:14:47.36,Dialogue,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:14:46.48,0:14:47.45,*Default-ja,NTP,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:52.28,0:14:55.52,Dialogue,,0,0,0,,Кейде үзіліс жасау керек, иә?
Dialogue: 0,0:14:52.65,0:14:55.73,*Default-ja,NTP,0,0,0,,Мұндай уақыт өте маңызды.
Dialogue: 0,0:14:55.54,0:14:59.79,Dialogue,,0,0,0,,Біз сияқты бейберекет өмір сүріп жатқанда, салқындау үшін біраз уақыт қажет.
Dialogue: 0,0:14:56.03,0:14:59.69,*Default-ja,NTP,0,0,0,,Күнделікті қарбалас тірліктегі ылғалдың өткінші сәті
Dialogue: 0,0:15:04.59,0:15:06.30,Chat,,0,0,0,,Иә, мен оны бүгін көрдім.
Dialogue: 0,0:15:05.07,0:15:08.49,*Default-ja,NTP,0,0,0,,Айтпақшы, мен бүгін көрдім – анау қара велосипед?
Dialogue: 0,0:15:06.72,0:15:08.20,Chat,,0,0,0,,Қара велосипед.
Dialogue: 0,0:15:08.20,0:15:09.67,Chat,,0,0,0,,Қара велосипед?
Dialogue: 0,0:15:08.63,0:15:09.59,*Default-ja,NTP,0,0,0,,Қара велосипед?
Dialogue: 0,0:15:09.73,0:15:11.06,Chat,,0,0,0,,Иә...
Dialogue: 0,0:15:10.13,0:15:11.03,*Default-ja,NTP,0,0,0,,Ах
Dialogue: 0,0:15:11.06,0:15:12.39,Chat,,0,0,0,,Сіз бұл туралы білмейсіз бе?
Dialogue: 0,0:15:11.46,0:15:12.65,*Default-ja,NTP,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:15:12.39,0:15:15.72,Chat,,0,0,0,,Синдзюку мен Икебукуродағылардың бәрі бұл туралы айтып жатыр.
Dialogue: 0,0:15:12.83,0:15:15.87,*Default-ja,NTP,0,0,0,,Жақында Синдзюку мен Икебукурада танымал.
Dialogue: 0,0:15:15.72,0:15:21.56,Chat,,0,0,0,,Бұрын оны қалалық аңыз деп санайтын, бірақ жақында оны көптеген адамдар суретке түсірді...
Dialogue: 0,0:15:16.21,0:15:21.75,*Default-ja,NTP,0,0,0,,Бұл көптен бері қалалық аңыз болған сияқты, бірақ соңғы уақытта оны суретке түсіретіндер көп болды...
Dialogue: 0,0:15:21.56,0:15:23.35,Chat,,0,0,0,,Иә, мен бұл туралы естідім.
Dialogue: 0,0:15:22.02,0:15:23.74,*Default-ja,NTP,0,0,0,,А, мен білемін, білемін.
Dialogue: 0,0:15:23.35,0:15:26.65,Chat,,0,0,0,,Бұл қарапайым байкерлер тобы емес пе?
Dialogue: 0,0:15:23.89,0:15:26.90,*Default-ja,NTP,0,0,0,,Әлде бұл кәдімгі байкерлер тобы деп айту керек пе?
Dialogue: 0,0:15:26.65,0:15:30.40,Chat,,0,0,0,,Бірге жиналып, колоннаға мінетіндер көп болмаса да.
Dialogue: 0,0:15:27.10,0:15:30.45,*Default-ja,NTP,0,0,0,,Аа, топ-топ болып жүгіретін сияқты емес.
Dialogue: 0,0:15:30.40,0:15:34.41,Chat,,0,0,0,,Велосипедте фарсыз жүру ақымақтық.
Dialogue: 0,0:15:30.87,0:15:34.62,*Default-ja,NTP,0,0,0,,Екі дөңгелегің болса да, жарықсыз жүрсең, сен ақымақсың.
Dialogue: 0,0:15:34.41,0:15:36.78,Chat,,0,0,0,,Кем дегенде, егер адам үшін болса ...
Dialogue: 0,0:15:36.78,0:15:38.91,Chat,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,0:15:38.91,0:15:41.87,Chat,,0,0,0,,Мм, шынымды айтсам,
Dialogue: 0,0:15:41.87,0:15:44.47,Chat,,0,0,0,,бұл құбыжық сияқты.
Dialogue: 0,0:15:49.21,0:15:50.51,Dialogue,,0,0,0,,Та-да!
Dialogue: 0,0:15:58.15,0:16:00.48,Dialogue,,0,0,0,,Мм, сіз жоғары тұрғандардың бірісіз бе?
Dialogue: 0,0:15:58.57,0:16:00.92,*Default-ja,NTP,0,0,0,,Мм, бұл сенің үстінде тұрған адам ма?
Dialogue: 0,0:16:02.87,0:16:05.10,Dialogue,,0,0,0,,Олардың бұлай көрінуі мүмкін емес.
Dialogue: 0,0:16:03.36,0:16:05.18,*Default-ja,NTP,0,0,0,,Қалай қарасаң да, айырмашылығы жоқ, солай ма?
Dialogue: 0,0:16:05.10,0:16:07.11,Dialogue,,0,0,0,,Сонда бұл кім?
Dialogue: 0,0:16:05.43,0:16:06.33,*Default-ja,NTP,0,0,0,,Сонда бұл кім?
Dialogue: 0,0:16:09.88,0:16:11.44,Dialogue,,0,0,0,,Сіз өте дөрекісіз, солай емес пе?
Dialogue: 0,0:16:10.29,0:16:11.75,*Default-ja,NTP,0,0,0,,Неге жалап кетпейсің?
Dialogue: 0,0:16:15.62,0:16:19.48,Dialogue,,0,0,0,,Біз бір нәрсенің ортасындамыз...
Dialogue: 0,0:16:16.23,0:16:18.80,*Default-ja,NTP,0,0,0,,Біз бос емеспіз.
Dialogue: 0,0:16:19.48,0:16:23.62,Dialogue,,0,0,0,,Егер араласатын болсаң, бізге жақсылық жасап, өл!
Dialogue: 0,0:16:19.83,0:16:23.69,*Default-ja,NTP,0,0,0,,Менің жолыма түссең, өлесің!?
Dialogue: 0,0:16:32.51,0:16:34.51,Dialogue,,0,0,0,,Капипа
Dialogue: 0,0:16:32.90,0:16:34.55,*Default-ja,NTP,0,0,0,,Ма... шынымен!
Dialogue: 0,0:16:37.39,0:16:38.62,Dialogue,,0,0,0,,Әй!
Dialogue: 0,0:16:37.97,0:16:38.66,*Default-ja,NTP,0,0,0,,Жоқ!
Dialogue: 0,0:16:38.62,0:16:39.89,Dialogue,,0,0,0,,Ол кем дегенде орташа баға алса екен...
Dialogue: 0,0:16:38.87,0:16:40.08,*Default-ja,NTP,0,0,0,,Эй... эй, эй!
Dialogue: 0,0:16:41.89,0:16:44.62,Dialogue,,0,0,0,,Тоқта! Тоқта! Тоқта!
Dialogue: 0,0:16:42.16,0:16:44.23,*Default-ja,NTP,0,0,0,,Тоқта... тоқта! Тоқта!
Dialogue: 0,0:16:48.87,0:16:52.15,Dialogue,,0,0,0,,Міне, мен саған мұны тоқтат деп айттым.
Dialogue: 0,0:16:49.33,0:16:51.71,*Default-ja,NTP,0,0,0,,Сондықтан мен тоқтағым келді.
Dialogue: 0,0:17:11.25,0:17:12.11,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:17:12.11,0:17:12.83,Dialogue,,0,0,0,,Неге?!
Dialogue: 0,0:17:12.34,0:17:13.88,*Default-ja,NTP,0,0,0,,Жоқ! О, жоқ! О, жоқ!
Dialogue: 0,0:17:12.83,0:17:13.63,Dialogue,,0,0,0,,Өте жаман!
Dialogue: 0,0:17:16.51,0:17:18.51,Dialogue,,0,0,0,,W-Бұл не?
Dialogue: 0,0:17:17.03,0:17:18.86,*Default-ja,NTP,0,0,0,,Не... бұл не?
Dialogue: 0,0:17:20.01,0:17:23.01,Dialogue,,0,0,0,,Бұл не сұмдық?!
Dialogue: 0,0:17:20.82,0:17:24.26,*Default-ja,NTP,0,0,0,,Бұл не?!
Dialogue: 0,0:17:26.11,0:17:28.95,Chat,,0,0,0,,«Құбыжық» дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:26.63,0:17:28.64,*Default-ja,NTP,0,0,0,,Құбыжық дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:28.95,0:17:31.63,Chat,,0,0,0,,Дотачин өзінің қара орақшы екенін айтады.
Dialogue: 0,0:17:31.63,0:17:32.68,Chat,,0,0,0,,Дотачин?
Dialogue: 0,0:17:32.68,0:17:33.69,Chat,,0,0,0,,Дотачин деген кім?
Dialogue: 0,0:17:33.69,0:17:36.23,Chat,,0,0,0,,Қалай болғанда да, қара велосипед мінген жігіт туралы...
Dialogue: 0,0:17:36.23,0:17:37.74,Chat,,0,0,0,,Сіз маған Дотачин туралы айтпайсыз ба?
Dialogue: 0,0:17:48.02,0:17:50.88,Dialogue,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:17:48.48,0:17:50.81,*Default-ja,NTP,0,0,0,,Чикишога~!!
Dialogue: 0,0:18:05.95,0:18:09.77,Dialogue,,0,0,0,,Сен қазір жол өлтірдің, боқ.
Dialogue: 0,0:18:06.26,0:18:09.95,*Default-ja,NTP,0,0,0,,Қараңызшы! Сәлем!
Dialogue: 0,0:18:09.77,0:18:10.23,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:18:13.23,0:18:15.28,Chat,,0,0,0,,Оның басы жоқ.
Dialogue: 0,0:18:25.04,0:18:25.95,Chat,,0,0,0,,Оның басы...
Dialogue: 0,0:18:25.95,0:18:28.92,Chat,,0,0,0,,...мүлдем кеткеніне қарамастан, жақсы қозғалатын сияқты.
Dialogue: 0,0:18:41.22,0:18:45.93,Dialogue,,0,0,0,,Н-Эй, сен несің?
Dialogue: 0,0:18:41.88,0:18:45.62,*Default-ja,NTP,0,0,0,,Бұл не? Сіз
Dialogue: 0,0:18:45.93,0:18:50.19,Dialogue,,0,0,0,,Не...Сен не деген сұмсың?!
Dialogue: 0,0:18:47.78,0:18:50.62,*Default-ja,NTP,0,0,0,,Не... бұл не?!
Dialogue: 0,0:19:12.39,0:19:16.30,Dialogue,,0,0,0,,Эй, мен жақындауға болмайтын басқа адамдар бар ма?
Dialogue: 0,0:19:12.91,0:19:16.80,*Default-ja,NTP,0,0,0,,Эй, сен жақындауға болмайтын басқа адамдар бар ма?
Dialogue: 0,0:19:16.30,0:19:24.30,Dialogue,,0,0,0,,Ммм, бандалар немесе якуза айтпай-ақ жүр, бірақ Орихара Изая деген жігіт бар.
Dialogue: 0,0:19:16.90,0:19:21.40,*Default-ja,NTP,0,0,0,,Хмм... Ясан мен банда сияқты екені айтпаса да түсінікті...
Dialogue: 0,0:19:22.17,0:19:24.68,*Default-ja,NTP,0,0,0,,Изая Орихара деген адам бар.
Dialogue: 0,0:19:24.30,0:19:26.10,Dialogue,,0,0,0,,Орихара Изая?
Dialogue: 0,0:19:24.94,0:19:27.68,*Default-ja,NTP,0,0,0,,Орихараизая? Бұл біртүрлі атау
Dialogue: 0,0:19:26.10,0:19:27.33,Dialogue,,0,0,0,,Қандай қызық есім.
Dialogue: 0,0:19:27.33,0:19:29.80,Dialogue,,0,0,0,,Сіз сөйлейтін адамсыз.
Dialogue: 0,0:19:27.77,0:19:29.47,*Default-ja,NTP,0,0,0,,Сіз айтасыз.
Dialogue: 0,0:19:29.80,0:19:32.31,Dialogue,,0,0,0,,Ол өте қауіпті, сондықтан онымен араласпаңыз.
Dialogue: 0,0:19:30.06,0:19:32.77,*Default-ja,NTP,0,0,0,,Бұл жігіт қауіпті, сондықтан онымен араласпа.
Dialogue: 0,0:19:32.79,0:19:37.61,Dialogue,,0,0,0,,Ол Синдзюкуда жүреді, сондықтан сіз оны ешқашан кездестірмейтін шығарсыз.
Dialogue: 0,0:19:33.12,0:19:37.69,*Default-ja,NTP,0,0,0,,Ол жаңа қабылдаушы органда болғандықтан, мен оны бірінші кездестірмейтін шығармын.
Dialogue: 0,0:19:38.36,0:19:42.61,Dialogue,,0,0,0,,О, сіз доллар деп аталатын топқа араласпауыңыз керек.
Dialogue: 0,0:19:38.77,0:19:42.64,*Default-ja,NTP,0,0,0,,О, сен де долларға араласпа.
Dialogue: 0,0:19:42.61,0:19:43.77,Dialogue,,0,0,0,,«Доллар?»
Dialogue: 0,0:19:42.97,0:19:44.06,*Default-ja,NTP,0,0,0,,Доллар?
Dialogue: 0,0:19:43.77,0:19:46.38,Dialogue,,0,0,0,,Иә, «бір доллардан» «долларлар».
Dialogue: 0,0:19:44.13,0:19:46.23,*Default-ja,NTP,0,0,0,,Саяхатшылардың долларлары
Dialogue: 0,0:19:46.38,0:19:48.16,Dialogue,,0,0,0,,«Бір доллар» дегеніміз не?
Dialogue: 0,0:19:46.74,0:19:48.40,*Default-ja,NTP,0,0,0,,Кезбелер дегеніміз не?
Dialogue: 0,0:19:48.54,0:19:52.63,Dialogue,,0,0,0,,Мен олар туралы көп білмеймін.
Dialogue: 0,0:19:49.03,0:19:52.61,*Default-ja,NTP,0,0,0,,Мен де егжей-тегжейлі білмеймін.
Dialogue: 0,0:19:52.63,0:19:57.56,Dialogue,,0,0,0,,Қалай болғанда да, олар өте көп, мен олардың бәрінің мінезі қысқа деп естимін.
Dialogue: 0,0:19:52.92,0:19:57.33,*Default-ja,NTP,0,0,0,,Қалай болғанда да, адамдардың көп болғаны сонша, бұл бір үзік сызықты команда сияқты көрінді.
Dialogue: 0,0:19:57.56,0:20:01.74,Dialogue,,0,0,0,,Олар банды деп есептелді, бірақ оларда ешқандай бандалық түстер жоқ.
Dialogue: 0,0:19:57.84,0:20:01.65,*Default-ja,NTP,0,0,0,,Бұл түсті топ сияқты, бірақ мен оның түсі қандай екенін білмеймін.
Dialogue: 0,0:20:01.74,0:20:08.14,Dialogue,,0,0,0,,Олар жинала алмайды, сондықтан жақында тарайтын шығар.
Dialogue: 0,0:20:02.08,0:20:05.05,*Default-ja,NTP,0,0,0,,Ал, біз қазір жиналыс өткізе алмаймыз.
Dialogue: 0,0:20:05.29,0:20:08.28,*Default-ja,NTP,0,0,0,,Ол жігіттер де мен білмей тұрып тарап кетті.
Dialogue: 0,0:20:08.14,0:20:09.80,Dialogue,,0,0,0,,Мен көремін...
Dialogue: 0,0:20:08.51,0:20:09.67,*Default-ja,NTP,0,0,0,,Бұл дұрыс
Dialogue: 0,0:20:15.94,0:20:18.65,Dialogue,,0,0,0,,Әй, жақсысың ба?
Dialogue: 0,0:20:16.82,0:20:18.95,*Default-ja,NTP,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:20:20.09,0:20:21.65,Dialogue,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:20.59,0:20:22.02,*Default-ja,NTP,0,0,0,,Амансың ба?
Dialogue: 0,0:20:23.32,0:20:25.55,Dialogue,,0,0,0,,Уф, ммм, кешіріңіз!
Dialogue: 0,0:20:23.38,0:20:26.75,*Default-ja,NTP,0,0,0,,Ой, у... кешіріңіз, жақсысыз ба?
Dialogue: 0,0:20:25.55,0:20:27.25,Dialogue,,0,0,0,,Маған көмектес...
Dialogue: 0,0:20:30.61,0:20:31.96,Dialogue,,0,0,0,,Умм...
Dialogue: 0,0:20:31.02,0:20:31.95,*Default-ja,NTP,0,0,0,,Ум...
Dialogue: 0,0:20:34.25,0:20:35.21,Dialogue,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:20:34.54,0:20:38.14,*Default-ja,NTP,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:20:35.21,0:20:37.29,Dialogue,,0,0,0,,Жоқ! Жоқ!
Dialogue: 0,0:20:37.85,0:20:38.38,Dialogue,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:20:38.18,0:20:38.95,*Default-ja,NTP,0,0,0,,Әй, эй!
Dialogue: 0,0:20:39.79,0:20:41.38,Dialogue,,0,0,0,,Оған не болды?
Dialogue: 0,0:20:40.51,0:20:43.29,*Default-ja,NTP,0,0,0,,Бұл не... сыпайылық жоқ па?
Dialogue: 0,0:20:41.38,0:20:43.16,Dialogue,,0,0,0,,Ол тіпті рахметін де айтқан жоқ.
Dialogue: 0,0:20:43.16,0:20:45.61,Dialogue,,0,0,0,,Мен оған не болды деп ойлаймын.
Dialogue: 0,0:20:43.51,0:20:45.69,*Default-ja,NTP,0,0,0,,Не болды? Сол адам
Dialogue: 0,0:20:45.61,0:20:50.35,Dialogue,,0,0,0,,Бұл қалада бәрі болуы мүмкін.
Dialogue: 0,0:20:45.91,0:20:47.08,*Default-ja,NTP,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:20:47.41,0:20:49.84,*Default-ja,NTP,0,0,0,,Бұл қалада бәрі болуы мүмкін.
Dialogue: 0,0:20:50.35,0:20:51.83,Dialogue,,0,0,0,,Сіз бақыттысыз.
Dialogue: 0,0:20:50.76,0:20:51.75,*Default-ja,NTP,0,0,0,,Сізге сәттілік.
Dialogue: 0,0:20:52.31,0:21:00.97,Dialogue,,0,0,0,,Бір күнде сіз Кадота мен оның достары Саймонды, автоматтар лақтыра алатын Шизуоны кездестірдіңіз де, сол сұлу қызды кездестірдіңіз.
Dialogue: 0,0:20:53.09,0:20:56.11,*Default-ja,NTP,0,0,0,,Мен Кадота мен Саймон мырзаны бүгін ғана кездестірдім.
Dialogue: 0,0:20:56.38,0:20:59.49,*Default-ja,NTP,0,0,0,,Сондай-ақ, сіз автомат пен Шидзуо лақтырған адамды көре аласыз.
Dialogue: 0,0:20:59.74,0:21:01.55,*Default-ja,NTP,0,0,0,,Мен сондай сұлу әйелге тап болдым
Dialogue: 0,0:21:01.79,0:21:04.69,Dialogue,,0,0,0,,Сіз мұны сәттілік деп атай аласыз ба білмеймін ...
Dialogue: 0,0:21:02.18,0:21:05.06,*Default-ja,NTP,0,0,0,,Бұл менің бақытты екенімді білдіре ме?
Dialogue: 0,0:21:04.69,0:21:06.02,Dialogue,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:21:05.12,0:21:06.11,*Default-ja,NTP,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:21:06.02,0:21:06.66,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:21:06.32,0:21:07.06,*Default-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:21:06.66,0:21:11.70,Dialogue,,0,0,0,,Сенің осында болғаныңа және екеуміз бір мектепте оқитынымызға қуаныштымын. Мен сенімен қайта араласа аламын.
Dialogue: 0,0:21:07.34,0:21:12.15,*Default-ja,NTP,0,0,0,,Осы қалада сенімен бірге мектепке барсам және сенімен тағы да ойнасам ғой.
Dialogue: 0,0:21:13.74,0:21:15.45,Dialogue,,0,0,0,,Мен де.
Dialogue: 0,0:21:14.14,0:21:15.42,*Default-ja,NTP,0,0,0,,Мен де
Dialogue: 0,0:21:17.71,0:21:20.18,Dialogue,,0,0,0,,Сіз шынымен бақыттысыз!
Dialogue: 0,0:21:18.02,0:21:19.82,*Default-ja,NTP,0,0,0,,Сіз шынымен бақыттысыз!
Dialogue: 0,0:21:20.18,0:21:23.15,Dialogue,,0,0,0,,Сіз нағыз қала аңызына көз салғалы тұрсыз!
Dialogue: 0,0:21:20.45,0:21:23.14,*Default-ja,NTP,0,0,0,,Сонымен қатар, сіз қала аңыздарын көз алдыңызда көресіз!
Dialogue: 0,0:21:23.15,0:21:24.34,Dialogue,,0,0,0,,Бала!
Dialogue: 0,0:21:23.50,0:21:24.45,*Default-ja,NTP,0,0,0,,Кида-кун!
Dialogue: 0,0:21:24.34,0:21:27.84,Chat,,0,0,0,,Не, Танака Таро? Сіз қара велосипедті көрдіңіз бе?
Dialogue: 0,0:21:24.80,0:21:27.93,*Default-ja,NTP,0,0,0,,А, қара мотоцикл көрдіңіз бе? Таро Танака мырза
Dialogue: 0,0:21:27.84,0:21:30.53,Chat,,0,0,0,,Түнгі сағат тоғыздар шамасында болды ма?
Dialogue: 0,0:21:30.53,0:21:32.43,Chat,,0,0,0,,Сен қайдан білдің, Сеттон?
Dialogue: 0,0:21:32.88,0:21:35.60,Chat,,0,0,0,,Мен де сонда болдым, сондықтан...
Dialogue: 0,0:21:35.92,0:21:36.55,Chat,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:21:37.31,0:21:38.98,Dialogue,,0,0,0,,«Қала аңызы» дегенді қалай түсінесіңдер?!
Dialogue: 0,0:21:37.89,0:21:39.68,*Default-ja,NTP,0,0,0,,Қала аңызы дегеніміз не?
Dialogue: 0,0:21:39.47,0:21:40.64,Dialogue,,0,0,0,,Қара велосипед!
Dialogue: 0,0:21:39.82,0:21:42.28,*Default-ja,NTP,0,0,0,,Бұл қара велосипед. Бұл басы жоқ шабандоз!
Dialogue: 0,0:21:40.64,0:21:42.57,Dialogue,,0,0,0,,Мына басы жоқ жігіт осында!
Dialogue: 0,0:21:47.79,0:21:52.52,Thought,,0,0,0,,Сол кезде мен қалтырап тұрғанымды байқадым.
Dialogue: 0,0:21:48.28,0:21:52.33,*Default-ja,NTP,0,0,0,,Сол кезде мен денемнің дірілдеп тұрғанын байқадым.
Dialogue: 0,0:21:54.32,0:21:55.45,Thought,,0,0,0,,Қорыққанымнан емес.
Dialogue: 0,0:21:54.77,0:21:59.28,*Default-ja,NTP,0,0,0,,Қорықпадым, елжіреп қалған шығармын.
Dialogue: 0,0:21:56.34,0:21:59.92,Thought,,0,0,0,,Менің ойымша... бұл менің қозғалғандықтан болды.
Dialogue: 0,0:22:04.24,0:22:06.01,Thought,,0,0,0,,Мен таңғажайып нәрсе көрдім.
Dialogue: 0,0:22:04.68,0:22:06.32,*Default-ja,NTP,0,0,0,,Мен таңғажайып нәрсе көрдім
Dialogue: 0,0:22:06.93,0:22:12.09,Thought,,0,0,0,,Міне, осы қалада мен армандамаған нәрсені бастан өткердім.
Dialogue: 0,0:22:07.32,0:22:12.71,*Default-ja,NTP,0,0,0,,Мен осында, осы қалада басқа еш жерде болмаған оқиға болды.
Dialogue: 0,0:22:13.10,0:22:20.19,Thought,,0,0,0,,Көз алдымнан мен ешқашан қол жеткізе алмайтын нанғысыз шындық жайылып жатқандай болдым.
Dialogue: 0,0:22:13.46,0:22:17.88,*Default-ja,NTP,0,0,0,,Мен осы уақытқа дейін жете алмадым деп ойлаған мүмкін емес шындық
Dialogue: 0,0:22:18.04,0:22:20.31,*Default-ja,NTP,0,0,0,,Көз алдымда жайылып жатқандай болдым.
Dialogue: 0,0:22:21.23,0:22:26.86,Thought,,0,0,0,,Бұл менің басында айтқаныма қайшы келетін шығар, бірақ мен сол жерде осылай сезіндім.
Dialogue: 0,0:22:21.66,0:22:24.00,*Default-ja,NTP,0,0,0,,Бұл менің басында айтқаныма қайшы келетін сияқты.
Dialogue: 0,0:22:24.35,0:22:26.58,*Default-ja,NTP,0,0,0,,Кем дегенде, мен сол кезде осылай ойладым.
Dialogue: 0,0:22:26.88,0:22:32.11,Thought,,0,0,0,,Мен үшін жаңа шындық басталғанын сезіп, қалтырап кеттім.
Dialogue: 0,0:22:27.33,0:22:32.14,*Default-ja,NTP,0,0,0,,Менің жаңа шындығым басталатынын алдын ала сезіп, қалтырап кеттім.
Dialogue: 0,0:22:35.54,0:22:36.83,Chat,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:22:35.98,0:22:37.30,*Default-ja,NTP,0,0,0,,Шынымен!
Dialogue: 0,0:22:36.83,0:22:40.42,Chat,,0,0,0,,Сонда біз білмей бір-бірімізден өтіп бара жатқан шығармыз.
Dialogue: 0,0:22:37.46,0:22:40.48,*Default-ja,NTP,0,0,0,,Сосын білмей өтіп кеткен шығармыз!
Dialogue: 0,0:22:40.42,0:22:42.00,Chat,,0,0,0,,Мүмкін.
Dialogue: 0,0:22:40.90,0:22:41.98,*Default-ja,NTP,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:22:42.00,0:22:43.63,Chat,,0,0,0,,Айтпақшы...
Dialogue: 0,0:22:42.54,0:22:43.54,*Default-ja,NTP,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:22:43.63,0:22:45.76,Chat,,0,0,0,,Дотачин деген кім?
Dialogue: 0,0:22:43.96,0:22:45.85,*Default-ja,NTP,0,0,0,,Дотачин деген кім?
Dialogue: 0,0:24:15.18,0:24:19.72,Dialogue,,0,0,0,,Бір жерде жұмбақ қыз өзі ешқашан білмейтін шындықты көреді.
Dialogue: 0,0:24:15.70,0:24:20.03,*Default-ja,NTP,0,0,0,,Қараңғы жағы бар қыз өзінің беймәлім шындықты көреді
Dialogue: 0,0:24:19.72,0:24:23.30,Dialogue,,0,0,0,,Кез келген адам басқа біреумен кездесіп қалуы мүмкін, бірақ ешкім соқпайтын шындық.
Dialogue: 0,0:24:20.47,0:24:23.04,*Default-ja,NTP,0,0,0,,Әр адам кездесетін, бірақ кездеспейтін шындық
Dialogue: 0,0:24:23.30,0:24:26.49,Dialogue,,0,0,0,,Оның қайтыс болған қызы не көрді?
Dialogue: 0,0:24:23.60,0:24:26.31,*Default-ja,NTP,0,0,0,,Өлуі керек қыздың көргені...
Dialogue: 0,0:24:26.49,0:24:29.52,Dialogue,,0,0,0,,Келесі жолы: Шындық пен өтіріктің арасы.
Dialogue: 0,0:24:31.02,0:24:37.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory