Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.62,0:00:06.63,Default,,0,0,0,,♪~
Dialogue: 0,0:01:00.93,0:01:03.68,Default,,0,0,0,,Аяғым қатып, қозғала алмай қашып кеттім.
Dialogue: 0,0:01:03.85,0:01:06.73,Default,,0,0,0,,Өткен дүниеде алаңсыз қуады.
Dialogue: 0,0:01:06.90,0:01:07.81,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:01:08.35,0:01:09.81,Default,,0,0,0,,Кішкене кескіш...
Dialogue: 0,0:01:10.11,0:01:12.07,Default,,0,0,0,,Сонымен, ура!
Dialogue: 0,0:01:13.28,0:01:13.94,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:01:14.11,0:01:15.90,Default,,0,0,0,,Сіз долларға қосылуды ойлайсыз ба?
Dialogue: 0,0:01:16.07,0:01:16.91,Default,,0,0,0,,Не? Жоқ, мүмкін емес
Dialogue: 0,0:01:17.07,0:01:19.20,Default,,0,0,0,,Масаоми өткен өмірінен қашып құтыла алмайды.
Dialogue: 0,0:01:19.37,0:01:20.83,Default,,0,0,0,,Келіңіздер! (Хорада) Жоқ!
Dialogue: 0,0:01:43.56,0:01:49.56,Default,,0,0,0,,~♪
Dialogue: 0,0:01:53.15,0:01:55.82,Default,,0,0,0,,Дүние ойдан шығарылған деп ұлы тұлға айтқан.
Dialogue: 0,0:01:55.94,0:01:57.15,Default,,0,0,0,,Мен айтқан шығармын.
Dialogue: 0,0:01:57.53,0:02:01.03,Default,,0,0,0,,Сіз айтпасаңыз да, біреу осыған ұқсас нәрсені айтқан болуы керек.
Dialogue: 0,0:02:01.62,0:02:03.41,Default,,0,0,0,,Сәлем, қош келдіңіз
Dialogue: 0,0:02:03.54,0:02:06.04,Default,,0,0,0,,Көптен бері көрмеген.
Dialogue: 0,0:02:06.50,0:02:10.04,Default,,0,0,0,,Бұл арзан. Мен сізге қызмет етемін, президент Кадота.
Dialogue: 0,0:02:10.17,0:02:12.13,Default,,0,0,0,,Президент кім?
Dialogue: 0,0:02:12.38,0:02:14.75,Default,,0,0,0,,Ах, ең арзан нигири, 5 порция
Dialogue: 0,0:02:14.88,0:02:16.01,Default,,0,0,0,,Айо
Dialogue: 0,0:02:17.84,0:02:19.68,Default,,0,0,0,,Сонда біз сізге не үшін керекпіз?
Dialogue: 0,0:02:20.09,0:02:21.80,Default,,0,0,0,,Сары тақия басы
Dialogue: 0,0:02:22.22,0:02:27.14,Default,,0,0,0,,Біз үшін ойдан шығарылған дүние шындық сияқты маңызды ойын алаңы.
Dialogue: 0,0:02:27.48,0:02:29.77,Default,,0,0,0,,Көркем әдебиет пен шындық эквивалентті
Dialogue: 0,0:02:29.89,0:02:32.56,Default,,0,0,0,,Бұл маған шындықты ұнатпайды дегенді білдірмейді.
Dialogue: 0,0:02:33.02,0:02:34.98,Default,,0,0,0,,Мынау сары тақия басы-
Dialogue: 0,0:02:35.11,0:02:38.53,Default,,0,0,0,,Егер сіз доллар мүшелеріне айтатын нәрсеңіз бар екенін айтсаңыз, олар түсінеді.
Dialogue: 0,0:02:39.53,0:02:40.53,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:40.95,0:02:44.16,Default,,0,0,0,,Айтайын, біз де егжей-тегжейлі білмейміз.
Dialogue: 0,0:02:44.33,0:02:47.08,Default,,0,0,0,,Бұл жын-шайтан, тіпті мұндағы адамдарға да шабуыл жасалды.
Dialogue: 0,0:02:48.04,0:02:52.04,Default,,0,0,0,,Кида бұл түсінбеушілікті түсіндіре алса пайдалы болар еді.
Dialogue: 0,0:02:52.42,0:02:53.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:53.54,0:02:55.50,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:02:56.38,0:02:58.80,Default,,0,0,0,,Шай ішу, катехин жақсы.
Dialogue: 0,0:02:59.38,0:03:00.68,Default,,0,0,0,,Хмф (Кадота) хаха
Dialogue: 0,0:03:00.80,0:03:01.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:01.93,0:03:03.72,Default,,0,0,0,,Жарайды, президент Кадота.
Dialogue: 0,0:03:04.18,0:03:07.31,Default,,0,0,0,,Ақылдан кетсе, от та суып кетеді.
Dialogue: 0,0:03:07.43,0:03:08.47,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:03:09.10,0:03:10.23,Default,,0,0,0,,Атчичи!
Dialogue: 0,0:03:10.39,0:03:13.56,Default,,0,0,0,,Сіз жапон тілін шынымен түсінбейсіз деп ойлаймын.
Dialogue: 0,0:03:13.90,0:03:16.82,Default,,0,0,0,,Ыстық суды осылай ұстауға болады.
Dialogue: 0,0:03:16.94,0:03:18.65,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:03:20.82,0:03:24.53,Default,,0,0,0,,Бұл... Кадота-сан және басқалар ғана солай ойлайтын шығар.
Dialogue: 0,0:03:25.12,0:03:25.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:26.16,0:03:27.79,Default,,0,0,0,,Доллардың да көлденең байланыстары бар.
Dialogue: 0,0:03:27.91,0:03:30.00,Default,,0,0,0,,Бұл тік байланыстары жоқ команда емес пе?
Dialogue: 0,0:03:30.41,0:03:32.87,Default,,0,0,0,,Сонымен, сіз білмейсіз ...
Dialogue: 0,0:03:33.00,0:03:35.50,Default,,0,0,0,,Өз бетінше кескіш ретінде әрекет ететін фракция болуы мүмкін.
Dialogue: 0,0:03:36.21,0:03:38.80,Default,,0,0,0,,Басқа мүшелерді өлтірсеңіз, күдік болмайды.
Dialogue: 0,0:03:40.67,0:03:43.51,Default,,0,0,0,,Мен түсінемін, бұл мағынасы бар.
Dialogue: 0,0:03:44.09,0:03:46.18,Default,,0,0,0,,Сонда мотив неде?
Dialogue: 0,0:03:46.93,0:03:50.43,Default,,0,0,0,,Атын сатуды мақсат етпейтін, ақша таппайтын топ...
Dialogue: 0,0:03:50.60,0:03:53.60,Default,,0,0,0,,Сары тақиялы қарақшыларды Слейшер түрінде талқандау.
Dialogue: 0,0:03:53.73,0:03:55.10,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:55.65,0:03:57.73,Default,,0,0,0,,Соны түсінсең, қиналмайсың...
Dialogue: 0,0:03:57.86,0:03:59.40,Default,,0,0,0,,Бұл тіпті жеке кек болуы мүмкін.
Dialogue: 0,0:03:59.73,0:04:01.03,Default,,0,0,0,,Бұл жеке реніш пе?
Dialogue: 0,0:04:01.15,0:04:04.61,Default,,0,0,0,,Сары тақиялы қарақшылардың долларға қатысты қиналғанын бұрын естімеппін, бірақ...
Dialogue: 0,0:04:04.95,0:04:06.99,Default,,0,0,0,,Доллар дегеніміз не... дұрыс?
Dialogue: 0,0:04:09.45,0:04:10.37,Default,,0,0,0,,Көк шаршы
Dialogue: 0,0:04:10.58,0:04:12.41,Default,,0,0,0,,Уф... Кида...
Dialogue: 0,0:04:12.87,0:04:15.46,Default,,0,0,0,,Мен бұл команданың бізге не істегенін ұмытқан жоқпын...
Dialogue: 0,0:04:16.08,0:04:18.46,Default,,0,0,0,,Оқиға әзірге бақылауға алынды.
Dialogue: 0,0:04:18.63,0:04:20.67,Default,,0,0,0,,Бұл өшпенділік жойылды дегенді білдірмейді.
Dialogue: 0,0:04:21.13,0:04:22.47,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:04:23.05,0:04:24.93,Default,,0,0,0,,Маған сол үшін келдің бе...
Dialogue: 0,0:04:25.43,0:04:27.93,Default,,0,0,0,,Эй, Кадота-сан, сен түсінесің, солай ма?
Dialogue: 0,0:04:28.39,0:04:30.14,Default,,0,0,0,,Мен доллардың басын білгім келеді.
Dialogue: 0,0:04:30.97,0:04:34.35,Default,,0,0,0,,Мүмкін болса, долларда сіздің ескі досыңыз бар...
Dialogue: 0,0:04:34.98,0:04:37.23,Default,,0,0,0,,Көк алаңда қанша адам бар... (бір рет қолданылатын таяқшалардың сынған дыбысы)
Dialogue: 0,0:04:38.73,0:04:41.15,Default,,0,0,0,,Жоқ, Кида-кун, жоқ.
Dialogue: 0,0:04:41.32,0:04:43.70,Default,,0,0,0,,Шындық пен адасушылықты араластырыңыз
Dialogue: 0,0:04:43.82,0:04:44.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.86,0:04:47.62,Default,,0,0,0,,Көк алаң болған жоқ
Dialogue: 0,0:04:48.24,0:04:49.66,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:04:50.03,0:04:50.91,Default,,0,0,0,,Уф... Саки!
Dialogue: 0,0:04:51.49,0:04:54.58,Default,,0,0,0,,Сакиді жоқ және әлі ауруханада жатқан адамдар линчке түсірді...
Dialogue: 0,0:04:55.96,0:04:56.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.75,0:04:59.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:59.54,0:05:01.88,Default,,0,0,0,,Иә, сіздің бұрынғы қызыңыз...
Dialogue: 0,0:05:02.01,0:05:03.97,Default,,0,0,0,,Оларды жоқ адамдар өлтірді.
Dialogue: 0,0:05:04.38,0:05:05.55,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:05.84,0:05:08.01,Default,,0,0,0,,Каризава мырза ашуланады.
Dialogue: 0,0:05:08.47,0:05:09.93,Default,,0,0,0,,Сіз ашулысыз.
Dialogue: 0,0:05:10.51,0:05:13.35,Default,,0,0,0,,Оның үстіне Юмачи сенен бұрын ашуланады.
Dialogue: 0,0:05:13.47,0:05:14.48,Default,,0,0,0,,Демек, бұл жұп
Dialogue: 0,0:05:14.89,0:05:17.90,Default,,0,0,0,,Кида-кун өз ісіне ашуланғандай.
Dialogue: 0,0:05:18.23,0:05:20.90,Default,,0,0,0,,Мен Доллар - тайғақ деп күдіктенемін.
Dialogue: 0,0:05:21.02,0:05:22.73,Default,,0,0,0,,Кейбір адамдардың ашулы болуы
Dialogue: 0,0:05:23.36,0:05:24.57,Default,,0,0,0,,Осыны ескере отырып...
Dialogue: 0,0:05:24.69,0:05:26.74,Default,,0,0,0,,Егер сіз оны сыйдыра алмасаңыз, себебі ол біркелкі...
Dialogue: 0,0:05:27.07,0:05:28.66,Default,,0,0,0,,Оны қозғамау керек.
Dialogue: 0,0:05:28.78,0:05:29.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:31.83,0:05:35.33,Default,,0,0,0,,Қарызымыз бар екені рас, бірақ...
Dialogue: 0,0:05:35.75,0:05:38.67,Default,,0,0,0,,Саки-чанды құтқарған Дотачинге
Dialogue: 0,0:05:38.79,0:05:41.75,Default,,0,0,0,,Егер сіз қашып кеткен, өткенді сүйреп шығарғыңыз келсе,
Dialogue: 0,0:05:42.71,0:05:45.51,Default,,0,0,0,,Бұл өткен күн тек адасушылықтың туындысы...
Dialogue: 0,0:05:45.63,0:05:47.43,Default,,0,0,0,,Мен сені басқа әлемге апарайын
Dialogue: 0,0:05:47.55,0:05:49.26,Default,,0,0,0,,Егер шындық пен фантастика тең болса...
Dialogue: 0,0:05:49.76,0:05:52.35,Default,,0,0,0,,Қажетсіз шындықты адасушылыққа айналдырыңыз.
Dialogue: 0,0:05:52.76,0:05:54.52,Default,,0,0,0,,Бұл біздің жолымыз
Dialogue: 0,0:05:55.64,0:05:57.35,Default,,0,0,0,,Бұл дұрыс емес, Каризава мырза.
Dialogue: 0,0:05:57.48,0:05:58.14,Default,,0,0,0,,Иә? Дұрыс емес пе?
Dialogue: 0,0:05:58.69,0:06:01.65,Default,,0,0,0,,Көк алаң деген команда болса...
Dialogue: 0,0:06:01.77,0:06:04.53,Default,,0,0,0,,Сол эпизодта мені бірінші рет линчке түсірді...
Dialogue: 0,0:06:04.65,0:06:06.40,Default,,0,0,0,,Көк алаңнан
Dialogue: 0,0:06:06.94,0:06:08.07,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:06:08.20,0:06:11.32,Default,,0,0,0,,Маған біржақты түрде жауыз ретінде қараса да, мен жай ғана наразылық білдіремін.
Dialogue: 0,0:06:11.78,0:06:13.24,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:06:13.41,0:06:15.45,Default,,0,0,0,,Уау, бұл ұят
Dialogue: 0,0:06:15.58,0:06:18.08,Default,,0,0,0,,Мен қазір қатты ұялып тұрмын.
Dialogue: 0,0:06:18.21,0:06:20.71,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:06:21.33,0:06:24.25,Default,,0,0,0,,Жоқ, жоқ, бұл менің кінәм болды.
Dialogue: 0,0:06:24.59,0:06:27.84,Default,,0,0,0,,Саки Чанмен болған оқиғаға қатты өкінемін.
Dialogue: 0,0:06:28.42,0:06:32.18,Default,,0,0,0,,Жоқ, мен сендерге рахмет айтуым керек...
Dialogue: 0,0:06:32.93,0:06:35.47,Default,,0,0,0,,Кек сақтасаң да, Маған бәрібір.
Dialogue: 0,0:06:35.97,0:06:37.52,Default,,0,0,0,,Кіші мектеп оқушысына -
Dialogue: 0,0:06:38.02,0:06:40.77,Default,,0,0,0,,Біз мұның барлығын жасадық.
Dialogue: 0,0:06:40.94,0:06:43.44,Default,,0,0,0,,Сонымен, Кадота мырза ештеңе істемеді...
Dialogue: 0,0:06:43.77,0:06:45.32,Default,,0,0,0,,Сіз оны өшіруге қанша тырыссаңыз да...
Dialogue: 0,0:06:45.44,0:06:47.78,Default,,0,0,0,,Сіз араласқан нәрседен қашып құтыла алмайсыз.
Dialogue: 0,0:06:48.78,0:06:50.86,Default,,0,0,0,,Осыны айтайын
Dialogue: 0,0:06:51.61,0:06:55.12,Default,,0,0,0,,Мен бастық туралы ештеңе білмеймін, білуге де ниетім жоқ.
Dialogue: 0,0:06:56.12,0:06:57.75,Default,,0,0,0,,Мен мұны тағы бір рет айтамын ...
Dialogue: 0,0:06:57.91,0:07:00.21,Default,,0,0,0,,Slasher және Dollars бір-біріне ешқандай қатысы жоқ.
Dialogue: 0,0:07:00.33,0:07:02.25,Default,,0,0,0,,Сары тақиялы қарақшылармен соғысуға еш себеп жоқ.
Dialogue: 0,0:07:02.83,0:07:04.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:04.29,0:07:06.13,Default,,0,0,0,,Иә? Бір адам болды.
Dialogue: 0,0:07:06.46,0:07:08.46,Default,,0,0,0,,Біреу доллардың басын танимын дейді...
Dialogue: 0,0:07:08.80,0:07:10.55,Default,,0,0,0,,А... сен кімсің?
Dialogue: 0,0:07:10.88,0:07:14.14,Default,,0,0,0,,Күте тұрыңыз, сонда не істейсіз?
Dialogue: 0,0:07:14.72,0:07:17.35,Default,,0,0,0,,Сіз бастықтың атын одан естідіңіз делік...
Dialogue: 0,0:07:17.47,0:07:20.10,Default,,0,0,0,,Нококо, сусын ішіп, сөйлесуді жоспарлап отырсың ба?
Dialogue: 0,0:07:20.94,0:07:23.48,Default,,0,0,0,,Әлде мен оны ұрлау үшін сары тақияларды пайдалануым керек пе?
Dialogue: 0,0:07:24.06,0:07:26.65,Default,,0,0,0,,Мен жай ғана Slasher-ді қуғым келеді.
Dialogue: 0,0:07:27.07,0:07:29.49,Default,,0,0,0,,Дұрыс. Сары тақиялардың ортақ пікірі осы ма?
Dialogue: 0,0:07:29.99,0:07:30.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.20,0:07:34.45,Default,,0,0,0,,Бұрынғыдай қол астыңыздағы адамдарды басқаратын болсаңыз...
Dialogue: 0,0:07:34.57,0:07:36.66,Default,,0,0,0,,Мен де саған сенемін және сенімен қызметтес боламын.
Dialogue: 0,0:07:37.16,0:07:38.37,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:38.49,0:07:41.83,Default,,0,0,0,,Олар сіз болмаған кезде өзгерді.
Dialogue: 0,0:07:42.29,0:07:44.29,Default,,0,0,0,,Байқамадым деп айтпа.
Dialogue: 0,0:07:45.17,0:07:46.25,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:46.67,0:07:50.63,Default,,0,0,0,,Сол жігіттер... Сары тақияларды әлі де досым деп санаймын.
Dialogue: 0,0:07:52.09,0:07:55.09,Default,,0,0,0,,Менің ойымша, сіз шынымен не істеу керектігін білмейсіз.
Dialogue: 0,0:07:55.80,0:07:58.31,Default,,0,0,0,,Бұл негізінен доллардың жұмысы деп есептесек...
Dialogue: 0,0:07:58.43,0:08:01.23,Default,,0,0,0,,Бұл дәл қазір саған еш қатысы жоқ нәрсе емес пе?
Dialogue: 0,0:08:01.48,0:08:05.27,Default,,0,0,0,,Сіз ұйымдар арасындағы қақтығыстарды ұнатпайсыз, сондықтан...
Dialogue: 0,0:08:05.40,0:08:06.06,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:08:06.52,0:08:08.86,Default,,0,0,0,,Бірақ қуылған шындық...
Dialogue: 0,0:08:08.98,0:08:11.40,Default,,0,0,0,,Кейде бұрмаланған күйде қайтады
Dialogue: 0,0:08:11.53,0:08:14.86,Default,,0,0,0,,Бірақ бұл жолы сары тақиялы жолдастар ғана емес.
Dialogue: 0,0:08:15.03,0:08:15.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:15.82,0:08:18.95,Default,,0,0,0,,Оның сары тақияларға да, менің өткеніме де қатысы жоқ.
Dialogue: 0,0:08:19.08,0:08:22.79,Default,,0,0,0,,Мен үшін маңызды біреуге шабуыл жасалды. Мен мұны кешіре алмаймын.
Dialogue: 0,0:08:23.29,0:08:24.33,Default,,0,0,0,,Бұл сіздің...
Dialogue: 0,0:08:24.62,0:08:27.08,Default,,0,0,0,,Иә, бұл мен үшін жеке мәселе.
Dialogue: 0,0:08:28.63,0:08:30.67,Default,,0,0,0,,Сол мәселені шешу үшін сол жігіттер...
Dialogue: 0,0:08:30.92,0:08:33.17,Default,,0,0,0,,Олар сары тақияны сылтау етіп жатыр.
Dialogue: 0,0:08:35.38,0:08:38.22,Default,,0,0,0,,Егер сіз мұны білсеңіз, ештеңе айтпаңыз.
Dialogue: 0,0:08:38.72,0:08:41.39,Default,,0,0,0,,Ал бастықты танитын адаммен...
Dialogue: 0,0:08:41.52,0:08:43.48,Default,,0,0,0,,Мен оны бастықтың шешіміне қалдырамын.
Dialogue: 0,0:08:43.60,0:08:44.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.77,0:08:46.06,Default,,0,0,0,,Алайда
Dialogue: 0,0:08:46.77,0:08:50.94,Default,,0,0,0,,Егер сіз әлі де долларды толық жау ретінде қабылдасаңыз...
Dialogue: 0,0:08:51.73,0:08:53.78,Default,,0,0,0,,Егер қабылдасаңыз... не?
Dialogue: 0,0:08:54.49,0:08:56.28,Default,,0,0,0,,Маған ұсынылатын кез келген жекпе-жекті қабылдаймын.
Dialogue: 0,0:08:56.57,0:08:57.41,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:08:57.53,0:08:59.53,Default,,0,0,0,,Сіз де бұған дайынсыз ба?
Dialogue: 0,0:08:59.95,0:09:02.37,Default,,0,0,0,,Кек жалау болғанша...
Dialogue: 0,0:09:02.70,0:09:05.41,Default,,0,0,0,,Сіздің жасыңыздағы балалар қандай төбелеске жиі түседі?
Dialogue: 0,0:09:05.54,0:09:08.75,Default,,0,0,0,,Тақырыптың өзгеріп жатқанын түсіндіңіз бе?
Dialogue: 0,0:09:10.84,0:09:11.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:12.05,0:09:12.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.76,0:09:14.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.59,0:09:16.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:16.80,0:09:17.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.60,0:09:23.60,Default,,0,0,0,,Басқа тұтынушылар мұндай нәрселерден қорқуы мүмкін, бірақ мұны көпшілік алдында жасаңыз.
Dialogue: 0,0:09:23.72,0:09:24.73,Default,,0,0,0,,Орындалды
Dialogue: 0,0:09:24.85,0:09:27.02,Default,,0,0,0,,Кремльдің бес тұтқасы, президент мырза.
Dialogue: 0,0:09:27.48,0:09:30.36,Default,,0,0,0,,Қарным ашқандықтан төбелес
Dialogue: 0,0:09:30.48,0:09:33.03,Default,,0,0,0,,Суши жесем, қарным тоқ, арманым тоқ.
Dialogue: 0,0:09:33.65,0:09:36.36,Default,,0,0,0,,Адамның асқазанының арман фабрикасы
Dialogue: 0,0:09:36.53,0:09:37.66,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:09:37.99,0:09:38.66,Default,,0,0,0,,Ni
Dialogue: 0,0:09:39.12,0:09:42.24,Default,,0,0,0,,Ах... аа, рахмет, Саймон.
Dialogue: 0,0:09:42.62,0:09:44.41,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:09:45.45,0:09:47.54,Default,,0,0,0,,Бұл қауіпті. Менеджер қауіпті.
Dialogue: 0,0:09:48.12,0:09:51.79,Default,,0,0,0,,Әй, бұл жай ғана кісі өлтіруге оқталу емес пе?
Dialogue: 0,0:09:51.96,0:09:56.30,Default,,0,0,0,,Уау, пышақ терең тесіп кетуі мүмкін, хехе...
Dialogue: 0,0:09:56.84,0:09:57.80,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:09:59.30,0:10:00.47,Default,,0,0,0,,Түн
Dialogue: 0,0:10:01.80,0:10:02.97,Default,,0,0,0,,Кездескенше, Кида
Dialogue: 0,0:10:03.18,0:10:05.85,Default,,0,0,0,,Ешқандай ақылсыз ойлардан бас тартпаңыз.
Dialogue: 0,0:10:06.48,0:10:09.94,Default,,0,0,0,,Дүкен менеджері өте қауіпті.
Dialogue: 0,0:10:10.06,0:10:11.94,Default,,0,0,0,,Егер сіз бір қадамды жіберіп алсаңыз, сіз Будда болар едіңіз.
Dialogue: 0,0:10:12.06,0:10:15.15,Default,,0,0,0,,Кешіріңіз, мен оны сәл жақсы деп ойладым.
Dialogue: 0,0:10:15.28,0:10:16.49,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:16.65,0:10:20.20,Default,,0,0,0,,Аспаздық манганың басты кейіпкері пышақты ойыншық ретінде пайдаланбауға ашуланады.
Dialogue: 0,0:10:20.32,0:10:23.28,Default,,0,0,0,,Мен олардың командос-самбодан жарысып жатқанын елестете аламын.
Dialogue: 0,0:10:23.87,0:10:25.79,Default,,0,0,0,,Осылайша арамызда—
Dialogue: 0,0:10:25.91,0:10:27.71,Default,,0,0,0,,Дүкен меңгерушісі мафияға қарсы күресті.
Dialogue: 0,0:10:27.83,0:10:31.17,Default,,0,0,0,,Ресейдің бұрынғы әскери жекпе-жек нұсқаушысы
Dialogue: 0,0:10:31.29,0:10:34.92,Default,,0,0,0,,Мүмкін ол әлемнен жасырыну үшін уақытша бетперде ретінде суши мейрамханасын басқаратын шығар.
Dialogue: 0,0:10:35.05,0:10:38.72,Default,,0,0,0,,Егер бұлай болса, олар ресейлік суши мейрамханасын аша алмас еді.
Dialogue: 0,0:10:39.76,0:10:41.22,Default,,0,0,0,,Хорада… Хорада…
Dialogue: 0,0:10:41.80,0:10:44.72,Default,,0,0,0,,Бұл не, Кадота-сан, бұл қарғыстың жаңа түрі ме?
Dialogue: 0,0:10:45.06,0:10:48.02,Default,,0,0,0,,Дотачин Хо Радха деп ұранды.
Dialogue: 0,0:10:48.35,0:10:50.02,Default,,0,0,0,,Байланыс түрі немесе шақыру түрі?
Dialogue: 0,0:10:50.14,0:10:52.02,Default,,0,0,0,,Хехе, бұл ток соғу түрі болуы мүмкін.
Dialogue: 0,0:10:52.15,0:10:54.86,Default,,0,0,0,,Ха... Кида мұны бұрын айтты.
Dialogue: 0,0:10:55.40,0:10:57.28,Default,,0,0,0,,Мен мұны бұрын айттым...
Dialogue: 0,0:10:57.40,0:11:00.03,Default,,0,0,0,,Долларды іздесем де, Slasher таба алмадым.
Dialogue: 0,0:11:00.82,0:11:03.91,Default,,0,0,0,,Мен... Жоқ, біз олай ойламаймыз.
Dialogue: 0,0:11:04.37,0:11:05.24,Default,,0,0,0,,Не?
Dialogue: 0,0:11:06.04,0:11:08.62,Default,,0,0,0,,Қара велосипед доллар деген қауесет бар.
Dialogue: 0,0:11:09.04,0:11:11.58,Default,,0,0,0,,Иә? Неліктен қара велосипедтер бар?
Dialogue: 0,0:11:12.29,0:11:15.84,Default,,0,0,0,,Біз жаңа ғана сенбейтін нәрсені көрдік.
Dialogue: 0,0:11:16.63,0:11:17.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:18.01,0:11:20.97,Default,,0,0,0,,Қара велосипед жапон қылыш ұстаған жігітті қашып құтылуға мүмкіндік берді...
Dialogue: 0,0:11:21.09,0:11:22.64,Default,,0,0,0,,Слэшер мен Гуру туралы сөз болғанда...
Dialogue: 0,0:11:22.97,0:11:24.10,Default,,0,0,0,,Және...
Dialogue: 0,0:11:24.22,0:11:27.01,Default,,0,0,0,,Бұрын Хорада есімді жігітті қара велосипед қағып кеткен.
Dialogue: 0,0:11:27.56,0:11:28.93,Default,,0,0,0,,Хорада?
Dialogue: 0,0:11:29.64,0:11:30.48,Default,,0,0,0,,Хорада…
Dialogue: 0,0:11:32.02,0:11:33.98,Default,,0,0,0,,О, солай Хорада Хора
Dialogue: 0,0:11:34.27,0:11:37.11,Default,,0,0,0,,Не болды? Сіз біртүрлі терең ойға батып кеткенсіз.
Dialogue: 0,0:11:37.78,0:11:39.57,Default,,0,0,0,,Бұл үлкен мәселе емес...
Dialogue: 0,0:11:39.69,0:11:43.03,Default,,0,0,0,,Дұрыс. Мүмкін емес.
Dialogue: 0,0:11:43.32,0:11:44.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:44.74,0:11:47.24,Default,,0,0,0,,Жоқ, менің ескі таныстарымның арасында...
Dialogue: 0,0:11:47.41,0:11:50.29,Default,,0,0,0,,Мен осындай есімді біреу бар деп ойладым.
Dialogue: 0,0:11:52.62,0:11:54.96,Default,,0,0,0,,Долларда одақтастары ретінде қара велосипедтері бар фракция бар.
Dialogue: 0,0:11:55.92,0:11:58.17,Default,,0,0,0,,Олар сары тақиялы қарақшыларды нысанаға алса ше?
Dialogue: 0,0:11:58.59,0:11:59.84,Default,,0,0,0,,Бір-бірімен сәйкес келеді
Dialogue: 0,0:12:00.26,0:12:02.76,Default,,0,0,0,,Эй, Юмачи, сенің жаңағы айтқаның біртүрлі, солай емес пе?
Dialogue: 0,0:12:03.05,0:12:04.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:04.64,0:12:07.64,Default,,0,0,0,,Әлгі қара велосипед бұған дейін де шабушыны өлтірген.
Dialogue: 0,0:12:08.18,0:12:09.64,Default,,0,0,0,,Ватакуса мырзаны да көлік қағып кетті...
Dialogue: 0,0:12:09.93,0:12:11.06,Default,,0,0,0,,Иә, иә (Каризава) Соңында, Шизу-чанға...
Dialogue: 0,0:12:11.18,0:12:12.02,Default,,0,0,0,,Ұсақталған
Dialogue: 0,0:12:12.56,0:12:16.27,Default,,0,0,0,,Бірақ бір түнде бір уақытта 50 оқиға болды...
Dialogue: 0,0:12:16.44,0:12:18.11,Default,,0,0,0,,Ах, бірақ олар да...
Dialogue: 0,0:12:18.27,0:12:19.53,Default,,0,0,0,,Қалай болғанда да, Slasher...
Dialogue: 0,0:12:19.65,0:12:21.28,Default,,0,0,0,,Ол енді шықпайды (Масаоми) Иә?
Dialogue: 0,0:12:21.69,0:12:24.78,Default,,0,0,0,,Олар Шизуо Хэйвадзимамен жекпе-жек таңдағандарын айтты.
Dialogue: 0,0:12:25.28,0:12:27.07,Default,,0,0,0,,Мен не болғанын білемін.
Dialogue: 0,0:12:27.20,0:12:28.87,Default,,0,0,0,,Ах... бірақ...
Dialogue: 0,0:12:29.58,0:12:32.87,Default,,0,0,0,,Бұл доллардағы бастықты білетін адамның телефон нөмірі.
Dialogue: 0,0:12:33.37,0:12:34.79,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:12:37.75,0:12:38.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.46,0:12:42.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:42.59,0:12:44.05,Default,,0,0,0,,(Денис орыс)
Dialogue: 0,0:12:44.63,0:12:46.64,Default,,0,0,0,,Тұтынушылар ащы дәмнен қашады
Dialogue: 0,0:12:47.09,0:12:50.26,Default,,0,0,0,,Сонда да тамақтанып, дүкеннен көңілді жүзбен шығыңыз.
Dialogue: 0,0:12:50.39,0:12:52.48,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:12:52.73,0:12:54.77,Default,,0,0,0,,Ұрыс болмайды.
Dialogue: 0,0:12:55.23,0:12:59.94,Default,,0,0,0,,Балалар сендер бақыттысыңдар, сондықтан басқалардың бақытын алмаңдар.
Dialogue: 0,0:13:00.11,0:13:01.86,Default,,0,0,0,,Бөлісу жақсы.
Dialogue: 0,0:13:02.40,0:13:03.69,Default,,0,0,0,,Эй, мен оны жақында білдім.
Dialogue: 0,0:13:04.61,0:13:07.32,Default,,0,0,0,,«Өкінішті адамдар жақсы емес, сом»
Dialogue: 0,0:13:08.07,0:13:10.45,Default,,0,0,0,,«Өкініш басқаларға жақсы емес»
Dialogue: 0,0:13:10.83,0:13:14.33,Default,,0,0,0,,Кида но Бочан сом балық па? Эй эй эй
Dialogue: 0,0:13:14.46,0:13:15.96,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:13:17.04,0:13:17.96,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:13:18.92,0:13:21.96,Default,,0,0,0,,Ештеңенің болмауы өте қызық.
Dialogue: 0,0:13:23.51,0:13:24.26,Default,,0,0,0,,Мен сені ұрсам бола ма?
Dialogue: 0,0:13:24.67,0:13:27.68,Default,,0,0,0,,Бұл жақсы, мен бұл үшін сізге төлеп жатырмын.
Dialogue: 0,0:13:28.47,0:13:31.60,Default,,0,0,0,,Мына Авакусукайға қандай шоколад жібердің?
Dialogue: 0,0:13:32.35,0:13:33.77,Default,,0,0,0,,Бұл тапанша, бірақ не?
Dialogue: 0,0:13:33.89,0:13:35.52,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:13:35.98,0:13:38.85,Default,,0,0,0,,Міне, осыдан жарты жыл бұрын...
Dialogue: 0,0:13:38.98,0:13:42.02,Default,,0,0,0,,Авакусукайдан мылтық ұрлап қашып кеткен біреу болды, солай ма?
Dialogue: 0,0:13:42.61,0:13:45.86,Default,,0,0,0,,Әй, жексұрын Дуллахан қуып келе жатқан.
Dialogue: 0,0:13:46.45,0:13:47.20,Default,,0,0,0,,О
Dialogue: 0,0:13:47.45,0:13:49.91,Default,,0,0,0,,Сол кезде тапаншалардың көпшілігін Селти тауып алған...
Dialogue: 0,0:13:50.03,0:13:51.70,Default,,0,0,0,,Оқиғасыз құтылдым.
Dialogue: 0,0:13:51.87,0:13:56.04,Default,,0,0,0,,Мен әлі таппадым, сондықтан... иә?
Dialogue: 0,0:13:56.21,0:13:58.29,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:59.54,0:14:02.38,Default,,0,0,0,,Әй, мен сені жақында шақырамын деп ойладым.
Dialogue: 0,0:14:02.80,0:14:03.88,Default,,0,0,0,,Блеф?
Dialogue: 0,0:14:04.00,0:14:04.88,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:14:05.59,0:14:07.72,Default,,0,0,0,,Иә, мен сізге бірден хабарласамын.
Dialogue: 0,0:14:08.51,0:14:09.72,Default,,0,0,0,,Өйткені, өткеннен...
Dialogue: 0,0:14:09.89,0:14:11.97,Default,,0,0,0,,Қашып құтыла алмайтын жалғыз өзім (Масаоми) Ха...
Dialogue: 0,0:14:16.06,0:14:18.98,Default,,0,0,0,,Дүние – нышан деп ұлы адам айтқан.
Dialogue: 0,0:14:19.44,0:14:20.81,Default,,0,0,0,,Мен мұны айтқан шығармын...
Dialogue: 0,0:14:20.94,0:14:24.73,Default,,0,0,0,,Сіз айтпасаңыз да, біреу осыған ұқсас нәрсені айтқан болуы керек.
Dialogue: 0,0:14:25.28,0:14:28.53,Default,,0,0,0,,Бұл ностальгиялық көрініс. Бұл сенің ескі жүзің.
Dialogue: 0,0:14:28.99,0:14:32.83,Default,,0,0,0,,Кіші мектеп оқушысы болса да, оның жүзі ересек адамдікі еді.
Dialogue: 0,0:14:33.58,0:14:35.33,Default,,0,0,0,,Сол күндерге көз жүгіртсек――
Dialogue: 0,0:14:35.45,0:14:37.62,Default,,0,0,0,,Мен сені осылай қарсы алуға батылым бардым
Dialogue: 0,0:14:39.21,0:14:39.87,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:40.29,0:14:41.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:41.58,0:14:43.71,Default,,0,0,0,,Мен сенің не естігің келетінін білемін деп ойлаймын.
Dialogue: 0,0:14:44.09,0:14:46.88,Default,,0,0,0,,Мен сізге телефон арқылы жауап бере алар едім.
Dialogue: 0,0:14:47.63,0:14:50.13,Default,,0,0,0,,Бұл соншалықты жеңіл әңгіме болмайтын сияқты еді.
Dialogue: 0,0:14:51.59,0:14:53.39,Default,,0,0,0,,Сіздің досыңызды кесіп тастады ма?
Dialogue: 0,0:14:53.93,0:14:57.39,Default,,0,0,0,,Мен оның есімі Анри Сонохара екеніне сенімдімін бе?
Dialogue: 0,0:14:58.18,0:15:00.64,Default,,0,0,0,,Сары тақиялы балалардан Сізге...
Dialogue: 0,0:15:00.77,0:15:03.27,Default,,0,0,0,,Бұл қыз маңыздырақ көрінеді.
Dialogue: 0,0:15:04.27,0:15:07.74,Default,,0,0,0,,Ертеде манга мен драмадан шабыттанған бала болыпты.
Dialogue: 0,0:15:07.86,0:15:10.28,Default,,0,0,0,,«Сары тақиялар» атты топ құрдым.
Dialogue: 0,0:15:10.78,0:15:15.83,Default,,0,0,0,,Сары тақиялар туы көк түсті басқа топпен қақтығысуда.
Dialogue: 0,0:15:15.95,0:15:17.45,Default,,0,0,0,,Мен қиын жағдайға тап болдым.
Dialogue: 0,0:15:18.12,0:15:19.79,Default,,0,0,0,,Сосын кенет пайда болды...
Dialogue: 0,0:15:19.96,0:15:20.83,Default,,0,0,0,,Гений тактик (Кадота) досым
Dialogue: 0,0:15:20.96,0:15:22.33,Default,,0,0,0,,Неліктен бәрі әдемі қыздар?
Dialogue: 0,0:15:22.63,0:15:24.96,Default,,0,0,0,,Бірақ бұл Жуге Лян емес еді...
Dialogue: 0,0:15:25.13,0:15:26.21,Default,,0,0,0,,Као Цао емес пе?
Dialogue: 0,0:15:26.34,0:15:27.80,Default,,0,0,0,,Ия... (Юмазаки) Бұл арада...
Dialogue: 0,0:15:27.92,0:15:29.47,Default,,0,0,0,,Бір топ бұрышта...
Dialogue: 0,0:15:29.59,0:15:31.84,Default,,0,0,0,,Баланың асыл ханшайымын ұрлап әкетті.
Dialogue: 0,0:15:31.97,0:15:35.80,Default,,0,0,0,,Бала көмектеспек болды, бірақ жолда қорқып кетті...
Dialogue: 0,0:15:36.10,0:15:38.06,Default,,0,0,0,,Сары тақиялар арасындағы тартысқа түсіп қалсаң...
Dialogue: 0,0:15:38.47,0:15:41.77,Default,,0,0,0,,Сізге ұнайтын қыз ауыр жарақат алса ше...
Dialogue: 0,0:15:42.06,0:15:43.65,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:15:43.81,0:15:46.69,Default,,0,0,0,,Бұл, әрине, Сакидің жағдайымен бірдей.
Dialogue: 0,0:15:47.65,0:15:49.86,Default,,0,0,0,,Сіздің ойыңызша солай емес пе?
Dialogue: 0,0:15:50.61,0:15:53.20,Default,,0,0,0,,«Маған Саки ұнаған болуы керек».
Dialogue: 0,0:15:53.70,0:15:57.03,Default,,0,0,0,,«Бірақ мен оған көмектесуге қорықтым».
Dialogue: 0,0:15:57.16,0:15:59.29,Default,,0,0,0,,«Менің махаббатым өтірік пе еді?»
Dialogue: 0,0:15:59.62,0:16:01.96,Default,,0,0,0,,«Ол оның денесін аңдыды ма деп ойлаймын».
Dialogue: 0,0:16:02.33,0:16:04.08,Default,,0,0,0,,«Мен өзімді қалай ойласам, соншамын».
Dialogue: 0,0:16:04.21,0:16:07.88,Default,,0,0,0,,«Мүмкін саған оны ұнатпаған шығарсың?»
Dialogue: 0,0:16:08.25,0:16:10.13,Default,,0,0,0,,Жарайды, поп-пон...
Dialogue: 0,0:16:10.71,0:16:11.67,Default,,0,0,0,,Көп ұзамай бұл...
Dialogue: 0,0:16:11.84,0:16:14.59,Default,,0,0,0,,Осылай болса екен деген тілекке айналды.
Dialogue: 0,0:16:15.14,0:16:17.01,Default,,0,0,0,,Сосын, егер бұл сізге шынымен ұнайтын балаға арналған болса...
Dialogue: 0,0:16:17.14,0:16:19.47,Default,,0,0,0,,Мен өз өмірім үшін күресе білуім керек
Dialogue: 0,0:16:20.27,0:16:23.98,Default,,0,0,0,,Бұл тірек тасы ма? Анри Сонохара бұл...
Dialogue: 0,0:16:24.85,0:16:27.61,Default,,0,0,0,,Егер Изая-сан солай ойласа, жақсы.
Dialogue: 0,0:16:27.73,0:16:28.44,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:16:28.57,0:16:31.07,Default,,0,0,0,,Сонда да мен мұны орындағым келеді.
Dialogue: 0,0:16:31.69,0:16:33.53,Default,,0,0,0,,Слейшерден кек алу?
Dialogue: 0,0:16:33.70,0:16:35.86,Default,,0,0,0,,Әлде доллардың жойылуы ма?
Dialogue: 0,0:16:36.62,0:16:39.08,Default,,0,0,0,,Изая-санның жауабына қарай екеуі де болады.
Dialogue: 0,0:16:39.54,0:16:41.04,Default,,0,0,0,,Жақсы шешім.
Dialogue: 0,0:16:41.50,0:16:44.79,Default,,0,0,0,,Түсіндім, алға ұмтылу үшін.
Dialogue: 0,0:16:45.21,0:16:48.29,Default,,0,0,0,,Сондықтан мен сізге шындықты айтуға дайынмын
Dialogue: 0,0:16:48.42,0:16:50.46,Default,,0,0,0,,Ал шындыққа қатысты ештеңе істей алмаймыз...
Dialogue: 0,0:16:50.59,0:16:52.05,Default,,0,0,0,,Оны үйретейік
Dialogue: 0,0:16:52.63,0:16:56.72,Default,,0,0,0,,Бұл үшеуі бастапқыда әртүрлі тұлғалар, бірақ кейде олар бірдей болады.
Dialogue: 0,0:16:58.55,0:17:00.72,Default,,0,0,0,,Айтпақшы, Микадо-кун қалай?
Dialogue: 0,0:17:00.85,0:17:01.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.89,0:17:05.10,Default,,0,0,0,,Қарашы, сен мені осы көктемде таныстырдың.
Dialogue: 0,0:17:05.56,0:17:08.86,Default,,0,0,0,,Сіздің досыңыз Рюгамин Микадо-кун.
Dialogue: 0,0:17:09.06,0:17:11.90,Default,,0,0,0,,Неліктен Микадо есімі осында кездеседі?
Dialogue: 0,0:17:12.32,0:17:14.15,Default,,0,0,0,,Жарайды, ол да қазіргі жағдайды ойлайды...
Dialogue: 0,0:17:14.28,0:17:17.03,Default,,0,0,0,,Мен сені қатты уайымдап жатырсың деп ойладым.
Dialogue: 0,0:17:17.36,0:17:19.03,Default,,0,0,0,,Оның бұған қатысы жоқ, солай ма?
Dialogue: 0,0:17:19.91,0:17:22.29,Default,,0,0,0,,Мен оған Сары тақиялар туралы айтқан жоқпын.
Dialogue: 0,0:17:22.41,0:17:25.41,Default,,0,0,0,,Әдеттегідей кешігіп қалдым, бірақ мен өте жігерлімін.
Dialogue: 0,0:17:26.08,0:17:28.00,Default,,0,0,0,,Мен әр күнім бақытты өмір сүремін.
Dialogue: 0,0:17:28.75,0:17:29.75,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.88,0:17:33.01,Default,,0,0,0,,Оның осындай бейбіт өмір сүріп жатқанын қызғанасыз ба?
Dialogue: 0,0:17:33.51,0:17:35.47,Default,,0,0,0,,Сондықтан оның оған қатысы жоқ.
Dialogue: 0,0:17:35.59,0:17:36.84,Default,,0,0,0,,Егер ол маңызды болса ше?
Dialogue: 0,0:17:36.97,0:17:38.30,Default,,0,0,0,,А... иә?
Dialogue: 0,0:17:38.76,0:17:40.30,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:17:40.43,0:17:42.26,Default,,0,0,0,,Микадо-кун қалай?
Dialogue: 0,0:17:42.77,0:17:44.68,Default,,0,0,0,,Менің досым қатты қиналып жатыр...
Dialogue: 0,0:17:44.81,0:17:48.60,Default,,0,0,0,,Бұған себепкер болған адам бақытты өмір сүруде.
Dialogue: 0,0:17:48.94,0:17:52.69,Default,,0,0,0,,Сәл күте тұрыңыз, Изая-сан не дейсіз?
Dialogue: 0,0:17:53.23,0:17:54.78,Default,,0,0,0,,Білсеңіз де
Dialogue: 0,0:17:55.07,0:17:57.49,Default,,0,0,0,,Доллардың бастығы - сіздің ең жақын досыңыз.
Dialogue: 0,0:17:57.95,0:17:59.74,Default,,0,0,0,,Рюгамин Микадо-кун
Dialogue: 0,0:18:00.16,0:18:02.12,Default,,0,0,0,,Кімді ең жақын досым деп санайсың?
Dialogue: 0,0:18:02.24,0:18:04.87,Default,,0,0,0,,Мүмкін бұл сен шығарсың (Карисава) Шындық әрқашан қиын.
Dialogue: 0,0:18:05.37,0:18:07.50,Default,,0,0,0,,Мазасыз шындықтан шаршадым
Dialogue: 0,0:18:07.62,0:18:09.63,Default,,0,0,0,,Біз әлемді қайта жасауды шештік.
Dialogue: 0,0:18:09.79,0:18:10.46,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:18:10.58,0:18:13.67,Default,,0,0,0,,Қабырға тұрғызып, маңызды заттарды қоқыс жәшігінен ажырат...
Dialogue: 0,0:18:14.38,0:18:16.80,Default,,0,0,0,,Үйіңізде тек өзіңізге ұнайтын нәрселерді жинаңыз.
Dialogue: 0,0:18:16.92,0:18:18.38,Default,,0,0,0,,Қалғандарының барлығын айдап әкетті
Dialogue: 0,0:18:18.93,0:18:20.89,Default,,0,0,0,,Мен оны сынап көрдім және таңқаларлықтай жақсы болды.
Dialogue: 0,0:18:21.43,0:18:24.64,Default,,0,0,0,,Әлемді тек Мо, Цундере және ұл махаббатпен құруға болады!
Dialogue: 0,0:18:24.81,0:18:25.89,Default,,0,0,0,,Керемет жаңалық!
Dialogue: 0,0:18:26.77,0:18:31.98,Default,,0,0,0,,Бұл фантастика мен шындықты үйлестірудің жалғыз жақсы жолы...
Dialogue: 0,0:18:32.40,0:18:33.65,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:18:33.77,0:18:36.32,Default,,0,0,0,,Сары тақиялар мен долларлар тағы да таласатын сияқты.
Dialogue: 0,0:18:36.44,0:18:37.49,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:18:37.61,0:18:38.65,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:18:38.82,0:18:39.57,Default,,0,0,0,,Бірақ әдеттегідей
Dialogue: 0,0:18:39.70,0:18:40.36,Default,,0,0,0,,Бұл қақтығыс, солай ма?
Dialogue: 0,0:18:40.86,0:18:41.99,Default,,0,0,0,,Енді бұл
Dialogue: 0,0:18:42.16,0:18:44.58,Default,,0,0,0,,Олар сары тақиялы қарақшылардың жасырынған жеріне тікелей шабуыл жасағанға ұқсайды♪
Dialogue: 0,0:18:44.91,0:18:46.08,Default,,0,0,0,,Қаншалықты батыл
Dialogue: 0,0:18:46.33,0:18:47.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:47.16,0:18:48.66,Default,,0,0,0,,Басы жоқ шабандоз
Dialogue: 0,0:18:48.83,0:18:50.50,Default,,0,0,0,,Слейшермен бірігіп кетті.
Dialogue: 0,0:18:50.67,0:18:53.59,Default,,0,0,0,,Олар сары тақиялы қарақшылардың жасырын базасын басып алған көрінеді.
Dialogue: 0,0:18:54.55,0:18:55.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:55.46,0:18:57.84,Default,,0,0,0,,Не болды? Сетон мырза
Dialogue: 0,0:18:58.17,0:18:59.26,Default,,0,0,0,,Тағы да
Dialogue: 0,0:18:59.38,0:19:01.64,Default,,0,0,0,,Тіпті Канра-сан да сене алар емес.
Dialogue: 0,0:19:01.76,0:19:03.39,Default,,0,0,0,,Сондай күлкілі оқиға
Dialogue: 0,0:19:04.39,0:19:06.52,Default,,0,0,0,,Әңгіме не болды, бәрі?
Dialogue: 0,0:19:06.85,0:19:08.73,Default,,0,0,0,,Бұл аниме туралы (lol)
Dialogue: 0,0:19:08.89,0:19:10.69,Default,,0,0,0,,Бұл дұрыс емес, Сетон мырза.
Dialogue: 0,0:19:10.81,0:19:11.94,Default,,0,0,0,,Алдағы арнайы эффектілер фильмі
Dialogue: 0,0:19:12.06,0:19:13.86,Default,,0,0,0,,Бұл мазмұн, Синка мырза.
Dialogue: 0,0:19:14.02,0:19:15.36,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:19:15.61,0:19:16.94,Default,,0,0,0,,Таро Танака~
Dialogue: 0,0:19:17.57,0:19:18.86,Default,,0,0,0,,Ол дәл қазір осында—
Dialogue: 0,0:19:19.03,0:19:21.66,Default,,0,0,0,,Әсіресе биыл продюсер екі рет өзгерді.
Dialogue: 0,0:19:21.78,0:19:24.16,Default,,0,0,0,,Сценаристер толығымен ауыстырылды.
Dialogue: 0,0:19:24.66,0:19:26.20,Default,,0,0,0,,Ал, келесі жолы қарайық.
Dialogue: 0,0:19:26.70,0:19:27.79,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:19:28.20,0:19:29.96,Default,,0,0,0,,Бұл жай ғана қауесет.
Dialogue: 0,0:19:30.08,0:19:30.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:31.21,0:19:34.00,Default,,0,0,0,,Сары тақиялы генерал доллардың басшысы болды
Dialogue: 0,0:19:34.13,0:19:37.05,Default,,0,0,0,,Тікелей бетпе-бет келуді сұрау туралы айтылады.
Dialogue: 0,0:19:37.17,0:19:38.96,Default,,0,0,0,,Е! Шынымен!?
Dialogue: 0,0:19:39.88,0:19:40.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:42.38,0:19:43.55,Default,,0,0,0,,Масаоми
Dialogue: 0,0:19:44.18,0:19:44.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.97,0:19:47.85,Default,,0,0,0,,Менің сыныбыма тоқтамай үйге қайтуға қалай дәтің бар?
Dialogue: 0,0:19:48.10,0:19:49.39,Default,,0,0,0,,Аа, сәл ғана...
Dialogue: 0,0:19:49.73,0:19:51.44,Default,,0,0,0,,Мен де кеше демалыс алдым...
Dialogue: 0,0:19:52.02,0:19:54.19,Default,,0,0,0,,Ах... (Масаоми) Бұл өте жақсы көрінеді.
Dialogue: 0,0:19:54.56,0:19:56.02,Default,,0,0,0,,Сол Кида-кун
Dialogue: 0,0:19:56.48,0:19:57.40,Default,,0,0,0,,О, болды!
Dialogue: 0,0:19:57.57,0:19:58.23,Default,,0,0,0,,Такигучи?
Dialogue: 0,0:19:58.36,0:19:59.65,Default,,0,0,0,,Ха... Рюгамин
Dialogue: 0,0:19:59.86,0:20:01.99,Default,,0,0,0,,Сіз менің доллармын деп ешкімге айттыңыз ба?
Dialogue: 0,0:20:02.11,0:20:03.36,Default,,0,0,0,,Не? (Такигучи) Кида да!
Dialogue: 0,0:20:03.82,0:20:05.28,Default,,0,0,0,,Не?
Dialogue: 0,0:20:05.49,0:20:06.58,Default,,0,0,0,,О, сен білмейсің бе?
Dialogue: 0,0:20:06.70,0:20:08.99,Default,,0,0,0,,Доллар сары тақиялы қарақшылармен соғысуда...
Dialogue: 0,0:20:09.45,0:20:10.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:10.25,0:20:13.83,Default,,0,0,0,,Бүгін бір бейтаныс адам мен туралы сұрап тұрған сияқты.
Dialogue: 0,0:20:14.63,0:20:16.00,Default,,0,0,0,,Аа, мен ешкімге айтқан жоқпын.
Dialogue: 0,0:20:17.96,0:20:18.75,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:20:19.21,0:20:21.01,Default,,0,0,0,,Бұл жақсы. Сонда кездескенше.
Dialogue: 0,0:20:21.13,0:20:21.80,Default,,0,0,0,,А... иә
Dialogue: 0,0:20:21.92,0:20:22.59,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:20:23.63,0:20:24.80,Default,,0,0,0,,Онда мен де осында боламын.
Dialogue: 0,0:20:25.09,0:20:27.35,Default,,0,0,0,,Не? Үйге бірге барайық
Dialogue: 0,0:20:27.47,0:20:29.18,Default,,0,0,0,,Бұл біраз әдепсіз.
Dialogue: 0,0:20:29.31,0:20:32.89,Default,,0,0,0,,Менің қызық жанкүйерлерім мені бос қалдырмайды.
Dialogue: 0,0:20:33.02,0:20:33.73,Default,,0,0,0,,Түсініңіз.
Dialogue: 0,0:20:34.23,0:20:35.23,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:20:36.44,0:20:37.40,Default,,0,0,0,,Масаоми...
Dialogue: 0,0:20:38.61,0:20:40.48,Default,,0,0,0,,Тыңдаңдар, ұрыс-керіске тыйым салынады.
Dialogue: 0,0:20:40.82,0:20:42.11,Default,,0,0,0,,Арандату болса да сабырлы бол.
Dialogue: 0,0:20:42.78,0:20:43.78,Default,,0,0,0,,Бірақ жалпы
Dialogue: 0,0:20:43.90,0:20:46.11,Default,,0,0,0,,Қарсыласыңызға сізді пайдалануына себеп бермеңіз
Dialogue: 0,0:20:46.70,0:20:49.45,Default,,0,0,0,,Егер кескіш доллар болса, дәлелдерді жинаңыз.
Dialogue: 0,0:20:50.29,0:20:52.83,Default,,0,0,0,,Жалпы долларлар туралы
Dialogue: 0,0:20:52.96,0:20:57.00,Default,,0,0,0,,Сіз өзіңіз білетін адамды іздеп жүргеніңізді айттыңыз. Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:20:57.46,0:20:58.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:58.42,0:20:59.50,Default,,0,0,0,,Кешегі оқиғаға қатысты...
Dialogue: 0,0:20:59.63,0:21:02.55,Default,,0,0,0,,Кейбір адамдар үнемі сынға шыдамайды.
Dialogue: 0,0:21:02.76,0:21:04.88,Default,,0,0,0,,Егер олар бақылаудан шығып кетсе...
Dialogue: 0,0:21:06.80,0:21:09.35,Default,,0,0,0,,Бұлай болғанда мен де ренжіп қаламын.
Dialogue: 0,0:21:10.14,0:21:11.60,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:21:11.72,0:21:13.27,Default,,0,0,0,,Корра Күтіңіз!
Dialogue: 0,0:21:14.39,0:21:15.39,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:21:18.73,0:21:19.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:20.27,0:21:21.78,Default,,0,0,0,,Жаса!
Dialogue: 0,0:21:23.24,0:21:23.90,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:24.32,0:21:25.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:25.20,0:21:26.15,Default,,0,0,0,,Ия
Dialogue: 0,0:21:26.28,0:21:27.78,Default,,0,0,0,,Ах... Куку...
Dialogue: 0,0:21:28.07,0:21:29.91,Default,,0,0,0,,Ой... аа... ой...
Dialogue: 0,0:21:30.78,0:21:32.70,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:35.00,0:21:37.29,Default,,0,0,0,,Неліктен бұлай болатынын айтайын.
Dialogue: 0,0:21:37.79,0:21:39.75,Default,,0,0,0,,Өйткені сендерде түс жоқ.
Dialogue: 0,0:21:39.88,0:21:41.92,Default,,0,0,0,,Сіз түссіз болу қауіпсіз деп ойладыңыз.
Dialogue: 0,0:21:42.46,0:21:43.30,Default,,0,0,0,,Бұл тәтті!
Dialogue: 0,0:21:44.97,0:21:48.51,Default,,0,0,0,,Шындығында түсі жоқтарға ешкім көмектеспейді.
Dialogue: 0,0:21:48.89,0:21:50.97,Default,,0,0,0,,Бір-бірімен байланысы жоқ ұйым
Dialogue: 0,0:21:51.10,0:21:52.35,Default,,0,0,0,,Сью
Dialogue: 0,0:21:53.35,0:21:55.23,Default,,0,0,0,,Мен оны фортепиано сабағында үйрендім.
Dialogue: 0,0:21:55.48,0:21:56.56,Default,,0,0,0,,Қандай нәрсе!
Dialogue: 0,0:21:57.85,0:22:01.57,Default,,0,0,0,,Интернетте ғана көңіл көтеруге болады ғой.
Dialogue: 0,0:22:02.69,0:22:06.07,Default,,0,0,0,,Мен сені шындықтан алыстатамын!
Dialogue: 0,0:22:06.90,0:22:09.74,Default,,0,0,0,,Біз... сары тақиялармыз!
Dialogue: 0,0:22:10.91,0:22:15.50,Default,,0,0,0,,Шындық кейде нашар өңделген туынды туындыға айналады.
Dialogue: 0,0:22:17.25,0:22:18.37,Default,,0,0,0,,Масаоми?
Dialogue: 0,0:22:18.83,0:22:20.25,Default,,0,0,0,,Гана Такигучи... (Микадо) Иә?
Dialogue: 0,0:22:21.54,0:22:23.00,Default,,0,0,0,,Сары тақиялы қарақшылар өлтірді
Dialogue: 0,0:22:23.55,0:22:24.84,Default,,0,0,0,,Такигучи-кун...
Dialogue: 0,0:22:25.55,0:22:26.88,Default,,0,0,0,,Мен саған қонаққа барамын.
Dialogue: 0,0:22:31.89,0:22:37.89,Default,,0,0,0,,♪~
Dialogue: 0,0:23:52.80,0:23:58.81,Default,,0,0,0,,~♪
Dialogue: 0,0:24:00.31,0:24:06.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory