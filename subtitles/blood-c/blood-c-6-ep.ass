Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.13,0:01:39.49,成员名显示,NTP,0000,0000,0000,,Жапония: Өлім бала Аои Джунко Аударма: XpDQYSG Мектеп: Дайдай Уақыты: akira Жүйе: Аоки
Dialogue: 0,0:01:41.40,0:01:43.91,日文对话,NTP,0000,0000,0000,,Ей, мен де соған алаңдаймын.
Dialogue: 0,0:01:44.43,0:01:46.55,日文对话,NTP,0000,0000,0000,,Бірақ менің басыма бірдеңе түссе
Dialogue: 0,0:01:47.32,0:01:48.74,日文对话,NTP,0000,0000,0000,,Бұл менмін, солай ма?
Dialogue: 0,0:01:52.68,0:01:53.02,日文对话,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:01:53.88,0:01:54.53,日文对话,NTP,0000,0000,0000,,Нене-сан
Dialogue: 0,0:01:57.64,0:02:00.69,强调,NTP,0000,0000,0000,,6-бөлім «Суықты ауыртады»
Dialogue: 0,0:02:10.46,0:02:12.29,日文对话,NTP,0000,0000,0000,,Өтірік не?
Dialogue: 0,0:02:17.21,0:02:18.86,日文对话,NTP,0000,0000,0000,,А, бұл не?
Dialogue: 0,0:02:26.92,0:02:28.40,日文对话,NTP,0000,0000,0000,,Жоқ! Келме!
Dialogue: 0,0:02:28.41,0:02:29.43,日文对话,NTP,0000,0000,0000,,Нене-сан
Dialogue: 0,0:02:51.75,0:02:53.49,日文对话,NTP,0000,0000,0000,,Жібер, жібер
Dialogue: 0,0:02:54.68,0:02:56.27,日文对话,NTP,0000,0000,0000,,Нене-сан, қашпа
Dialogue: 0,0:03:30.53,0:03:31.45,日文对话,NTP,0000,0000,0000,,Нене-сан мұнда
Dialogue: 0,0:03:43.69,0:03:45.71,日文对话,NTP,0000,0000,0000,,Кешіріңіз, мен оны қарызға алғым келеді.
Dialogue: 0,0:03:58.18,0:03:59.13,日文对话,NTP,0000,0000,0000,,Нене-сан
Dialogue: 0,0:05:30.19,0:05:30.62,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:05:34.94,0:05:36.10,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:05:41.55,0:05:42.37,日文对话,NTP,0000,0000,0000,,Нене-сан...
Dialogue: 0,0:05:43.88,0:05:44.93,日文对话,NTP,0000,0000,0000,,Қазір ұйықта.
Dialogue: 0,0:05:46.01,0:05:47.01,日文对话,NTP,0000,0000,0000,,Алайда
Dialogue: 0,0:05:49.15,0:05:50.08,日文对话,NTP,0000,0000,0000,,Субару-кун?
Dialogue: 0,0:06:05.12,0:06:08.11,日文对话,NTP,0000,0000,0000,,Жарықтың ұшын табасың ба? Сая
Dialogue: 0,0:06:55.02,0:06:58.35,日文对话,NTP,0000,0000,0000,,Өйткені, бұл шынымен де дұрыс болды.
Dialogue: 0,0:07:07.42,0:07:08.04,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:08.60,0:07:09.77,日文对话,NTP,0000,0000,0000,,Қайырлы таң Сайо-чан
Dialogue: 0,0:07:11.38,0:07:12.02,日文对话,NTP,0000,0000,0000,,Бунджин-сан
Dialogue: 0,0:07:13.10,0:07:14.15,日文对话,NTP,0000,0000,0000,,Оны ашуға болмайды.
Dialogue: 0,0:07:20.94,0:07:21.46,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:28.44,0:07:31.26,日文对话,NTP,0000,0000,0000,,Мен Юйошиден өзін жақсы сезінбей ме деп сұрадым.
Dialogue: 0,0:07:35.54,0:07:36.46,日文对话,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:07:38.63,0:07:39.40,日文对话,NTP,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:07:40.62,0:07:41.87,日文对话,NTP,0000,0000,0000,,Ол да қызуы көтерілгенін айтты.
Dialogue: 0,0:07:42.48,0:07:44.01,日文对话,NTP,0000,0000,0000,,Бүгін мектепті өткізіп жіберу керек.
Dialogue: 0,0:07:45.95,0:07:46.45,日文对话,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:07:48.82,0:07:51.64,日文对话,NTP,0000,0000,0000,,Сайо-чан дүкенге келе алмайтын шығар.
Dialogue: 0,0:07:52.14,0:07:53.40,日文对话,NTP,0000,0000,0000,,Ол да тамақ ішуімді өтінді.
Dialogue: 0,0:07:55.25,0:07:59.93,日文对话,NTP,0000,0000,0000,,Мен оны қыздырамын, бірақ мен алдымен кофе ішемін деп ойладым.
Dialogue: 0,0:08:08.05,0:08:08.67,日文对话,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:08:11.99,0:08:13.33,日文对话,NTP,0000,0000,0000,,Ыстық, сондықтан оны баяу қабылдаңыз.
Dialogue: 0,0:08:23.03,0:08:26.60,日文对话,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:08:27.34,0:08:28.74,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл қиындық тудырмайды.
Dialogue: 0,0:08:29.64,0:08:32.36,日文对话,NTP,0000,0000,0000,,Сайо-чан мен үшін ерекше.
Dialogue: 0,0:08:36.77,0:08:38.44,日文对话,NTP,0000,0000,0000,,Өйткені менің балам бәрінен де маңызды.
Dialogue: 0,0:08:39.24,0:08:39.52,日文对话,NTP,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:08:44.23,0:08:45.73,日文对话,NTP,0000,0000,0000,,Мен тамақ дайындаймын.
Dialogue: 0,0:08:47.03,0:08:48.77,日文对话,NTP,0000,0000,0000,,Оған дейін біраз демалу керек.
Dialogue: 0,0:08:59.35,0:09:02.93,日文对话,NTP,0000,0000,0000,,Мүмкін, бұл безгегінен шығар. Мен анық ойлай алмаймын.
Dialogue: 0,0:09:16.54,0:09:20.08,日文对话,NTP,0000,0000,0000,,Ойлануым керек, бірақ ойлай алмаймын.
Dialogue: 0,0:09:22.67,0:09:27.22,日文对话,NTP,0000,0000,0000,,ұйқылы тұманды теңселу
Dialogue: 0,0:09:28.95,0:09:33.49,日文对话,NTP,0000,0000,0000,,Бұндай жағдай бұрын да болған. Бұл арман болды.
Dialogue: 0,0:09:34.71,0:09:37.14,日文对话,NTP,0000,0000,0000,,Жоқ, бұл сөзсіз болды.
Dialogue: 0,0:09:58.68,0:10:03.03,日文对话,NTP,0000,0000,0000,,Олай болса бірге көрейік.
Dialogue: 0,0:10:30.76,0:10:31.26,日文对话,NTP,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:10:35.10,0:10:39.57,日文对话,NTP,0000,0000,0000,,Бірақ мен ол жерді білетін сияқтымын.
Dialogue: 0,0:11:06.98,0:11:08.47,日文对话,NTP,0000,0000,0000,,Мен бүгін демалыс алсам да
Dialogue: 0,0:11:10.61,0:11:11.16,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:12.62,0:11:17.06,日文对话,NTP,0000,0000,0000,,Фумито-санға бүгін таңғы ассыз келетініңізді хабарлаңыз.
Dialogue: 0,0:11:17.74,0:11:18.47,日文对话,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:11:24.32,0:11:27.58,日文对话,NTP,0000,0000,0000,,Багуада ежелгі заттар қайтадан пайда болды ма?
Dialogue: 0,0:11:28.78,0:11:30.06,日文对话,NTP,0000,0000,0000,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:11:35.82,0:11:36.94,日文对话,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:11:37.45,0:11:37.93,日文对话,NTP,0000,0000,0000,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:11:38.58,0:11:39.04,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:12.83,0:12:13.56,日文对话,NTP,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:12:14.99,0:12:16.03,日文对话,NTP,0000,0000,0000,,Токима-сан
Dialogue: 0,0:12:18.24,0:12:19.72,日文对话,NTP,0000,0000,0000,,Сіз кеше үзіліс алдыңыз.
Dialogue: 0,0:12:20.67,0:12:21.72,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:22.36,0:12:23.07,日文对话,NTP,0000,0000,0000,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:12:24.59,0:12:27.09,日文对话,NTP,0000,0000,0000,,Жоқ, сәл ғана.
Dialogue: 0,0:12:34.30,0:12:36.99,日文对话,NTP,0000,0000,0000,,Не болғанын айтшы, Сая.
Dialogue: 0,0:12:40.81,0:12:42.33,日文对话,NTP,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:12:43.14,0:12:45.02,日文对话,NTP,0000,0000,0000,,Қызық, мұғалім жақында келе ме?
Dialogue: 0,0:12:54.29,0:12:55.82,日文对话,NTP,0000,0000,0000,,Қайырлы таң, Чанги мырза
Dialogue: 0,0:12:56.42,0:12:57.43,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:57.91,0:12:59.55,日文对话,NTP,0000,0000,0000,,Келгендеріңізге рахмет.
Dialogue: 0,0:13:09.10,0:13:09.83,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:13:11.48,0:13:13.97,日文对话,NTP,0000,0000,0000,,Саяға дейін келмедің, сондықтан уайымдадың.
Dialogue: 0,0:13:14.76,0:13:15.63,日文对话,NTP,0000,0000,0000,,Тіпті мен бе?
Dialogue: 0,0:13:16.35,0:13:17.81,日文对话,NTP,0000,0000,0000,,Нене Мо
Dialogue: 0,0:13:18.10,0:13:20.43,日文对话,NTP,0000,0000,0000,,Ол кеше түннен бері үйге келмеді.
Dialogue: 0,0:13:20.98,0:13:22.90,日文对话,NTP,0000,0000,0000,,Сіз де демалыңыз.
Dialogue: 0,0:13:27.17,0:13:28.42,日文对话,NTP,0000,0000,0000,,Барлығы орындарына отырады
Dialogue: 0,0:13:35.69,0:13:38.83,日文对话,NTP,0000,0000,0000,,Нене-сан кешеден бері үйге келмеді.
Dialogue: 0,0:13:38.83,0:13:40.60,日文对话,NTP,0000,0000,0000,,Мен бұл туралы кеше айттым.
Dialogue: 0,0:13:41.05,0:13:42.07,日文对话,NTP,0000,0000,0000,,Мен әлі оралуым керек.
Dialogue: 0,0:13:42.89,0:13:45.10,日文对话,NTP,0000,0000,0000,,Отбасына полиция хабарласты.
Dialogue: 0,0:13:45.87,0:13:47.71,日文对话,NTP,0000,0000,0000,,Жақында осы жерде
Dialogue: 0,0:13:47.71,0:13:50.82,日文对话,NTP,0000,0000,0000,,Осындай бірнеше оқиға орын алды.
Dialogue: 0,0:13:51.88,0:13:53.03,日文对话,NTP,0000,0000,0000,,Бұл рас болды.
Dialogue: 0,0:13:54.04,0:13:55.11,日文对话,NTP,0000,0000,0000,,Юка-сан
Dialogue: 0,0:13:56.10,0:13:58.47,日文对话,NTP,0000,0000,0000,,Қандай да бір себептермен мен кенеттен сізбен байланыса алмай қалдым.
Dialogue: 0,0:13:58.93,0:14:01.04,日文对话,NTP,0000,0000,0000,,Қайтып келмейтіндер бар.
Dialogue: 0,0:14:02.38,0:14:04.24,日文对话,NTP,0000,0000,0000,,Наубайхана туралы мен «Джиауведен» естідім
Dialogue: 0,0:14:04.49,0:14:06.21,日文对话,NTP,0000,0000,0000,,Соңында ол әлі табылған жоқ.
Dialogue: 0,0:14:11.94,0:14:12.86,日文对话,NTP,0000,0000,0000,,Сая?
Dialogue: 0,0:14:13.80,0:14:15.51,日文对话,NTP,0000,0000,0000,,Нене-сан
Dialogue: 0,0:14:19.22,0:14:20.81,日文对话,NTP,0000,0000,0000,,Не болды, Чанги мырза?
Dialogue: 0,0:14:22.82,0:14:24.16,日文对话,NTP,0000,0000,0000,,Біраз абдырап қалды
Dialogue: 0,0:14:24.90,0:14:25.99,日文对话,NTP,0000,0000,0000,,Тек бас ба?
Dialogue: 0,0:14:31.09,0:14:34.56,日文对话,NTP,0000,0000,0000,,Мен ауырып қалдым және кеше демалыс алдым, сонда жақсысың ба?
Dialogue: 0,0:14:35.09,0:14:36.18,日文对话,NTP,0000,0000,0000,,Дәл тимеді!
Dialogue: 0,0:14:37.05,0:14:39.70,日文对话,NTP,0000,0000,0000,,Бірақ бүгін де демалыс алған дұрыс болар еді.
Dialogue: 0,0:14:41.28,0:14:43.14,日文对话,NTP,0000,0000,0000,,Полицияның талабы бойынша
Dialogue: 0,0:14:43.49,0:14:45.19,日文对话,NTP,0000,0000,0000,,Бүгін мектеп жабық.
Dialogue: 0,0:14:46.10,0:14:48.29,日文对话,NTP,0000,0000,0000,,Айналма жолдарсыз тура үйге барыңыз
Dialogue: 0,0:14:49.05,0:14:52.19,日文对话,NTP,0000,0000,0000,,Мен саған ертең не болатынын таңертең хабарлаймын.
Dialogue: 0,0:14:52.43,0:14:53.63,日文对话,NTP,0000,0000,0000,,Телефонды алғаныңызға көз жеткізіңіз
Dialogue: 0,0:15:01.41,0:15:02.20,日文对话,NTP,0000,0000,0000,,Чанги мырза
Dialogue: 0,0:15:02.87,0:15:03.72,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:06.37,0:15:07.79,日文对话,NTP,0000,0000,0000,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:15:24.42,0:15:25.17,日文对话,NTP,0000,0000,0000,,Егер сіз оны сақтасаңыз
Dialogue: 0,0:15:25.76,0:15:26.86,日文对话,NTP,0000,0000,0000,,Фели-чан да мүлдем мән бермейтін сияқты.
Dialogue: 0,0:15:27.80,0:15:28.64,日文对话,NTP,0000,0000,0000,,Барлығы
Dialogue: 0,0:15:33.41,0:15:33.99,日文对话,NTP,0000,0000,0000,,Кіммен
Dialogue: 0,0:15:45.44,0:15:46.45,日文对话,NTP,0000,0000,0000,,Мен сені жібермеймін
Dialogue: 0,0:15:54.15,0:15:55.01,日文对话,NTP,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:15:59.21,0:16:00.31,日文对话,NTP,0000,0000,0000,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:16:04.00,0:16:06.19,日文对话,NTP,0000,0000,0000,,Егер сіз не істер едіңіз
Dialogue: 0,0:16:07.98,0:16:09.16,日文对话,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:16:15.62,0:16:16.53,日文对话,NTP,0000,0000,0000,,Сайо-чан
Dialogue: 0,0:16:21.79,0:16:26.76,日文对话,NTP,0000,0000,0000,,Нене-сан Ноно-сан
Dialogue: 0,0:16:27.48,0:16:28.58,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:16:29.64,0:16:30.77,日文对话,NTP,0000,0000,0000,,Сіз қайдан білдіңіз?
Dialogue: 0,0:16:31.67,0:16:32.95,日文对话,NTP,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:16:34.08,0:16:35.23,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:16:35.82,0:16:37.78,日文对话,NTP,0000,0000,0000,,Өйткені біз шынымен ұқсаймыз
Dialogue: 0,0:16:38.46,0:16:40.12,日文对话,NTP,0000,0000,0000,,Егер сіз қазір сияқты қоштасуды өзгертсеңіз
Dialogue: 0,0:16:40.35,0:16:42.75,日文对话,NTP,0000,0000,0000,,Ешкім ажырата алмайды.
Dialogue: 0,0:16:44.42,0:16:46.93,日文对话,NTP,0000,0000,0000,,Бірақ Сайо-чан мұны қалай білді?
Dialogue: 0,0:16:47.78,0:16:49.03,日文对话,NTP,0000,0000,0000,,Nono-san
Dialogue: 0,0:16:49.70,0:16:51.11,日文对话,NTP,0000,0000,0000,,Нене жоғалып кеткен күн
Dialogue: 0,0:16:51.60,0:16:53.61,日文对话,NTP,0000,0000,0000,,Мен Сайо-чанды көретін болдым.
Dialogue: 0,0:16:54.43,0:16:58.09,日文对话,NTP,0000,0000,0000,,Елес оқиға кезінде Сайо-чан құлап, уайымдады.
Dialogue: 0,0:16:58.65,0:16:59.62,日文对话,NTP,0000,0000,0000,,Менің ойымша, сіз келдіңіз
Dialogue: 0,0:17:00.21,0:17:02.60,日文对话,NTP,0000,0000,0000,,Әй, одан кейін не болды?
Dialogue: 0,0:17:03.07,0:17:03.86,日文对话,NTP,0000,0000,0000,,Nono-san
Dialogue: 0,0:17:04.20,0:17:05.47,日文对话,NTP,0000,0000,0000,,Нене, сен неге оралмадың?
Dialogue: 0,0:17:05.99,0:17:07.85,日文对话,NTP,0000,0000,0000,,Нене, қазір қайдасың?
Dialogue: 0,0:17:10.02,0:17:11.45,日文对话,NTP,0000,0000,0000,,Айтшы, Сайо-чан!
Dialogue: 0,0:17:37.90,0:17:39.09,日文对话,NTP,0000,0000,0000,,Сәлем! Сайо-чан!
Dialogue: 0,0:17:47.50,0:17:49.40,日文对话,NTP,0000,0000,0000,,Эй, айтшы, Сайо-чан.
Dialogue: 0,0:17:50.22,0:17:52.55,日文对话,NTP,0000,0000,0000,,Нене қайда болды?
Dialogue: 0,0:17:54.18,0:17:56.34,日文对话,NTP,0000,0000,0000,,мырза....
Dialogue: 0,0:18:02.64,0:18:06.28,日文对话,NTP,0000,0000,0000,,Сұмдық, қорқынышты, Сайо-чан!
Dialogue: 0,0:18:07.55,0:18:08.38,日文对话,NTP,0000,0000,0000,,Nono-san
Dialogue: 0,0:18:09.74,0:18:10.88,日文对话,NTP,0000,0000,0000,,Иә? Не
Dialogue: 0,0:18:10.88,0:18:12.03,日文对话,NTP,0000,0000,0000,,Қызық, не болды?
Dialogue: 0,0:18:22.23,0:18:23.62,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:43.10,0:18:43.98,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:46.01,0:18:47.84,日文对话,NTP,0000,0000,0000,,Одан неге қашып жүрсің?
Dialogue: 0,0:19:37.83,0:19:39.76,日文对话,NTP,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:19:41.24,0:19:43.67,日文对话,NTP,0000,0000,0000,,Не! Ах!
Dialogue: 0,0:21:44.17,0:21:44.86,日文对话,NTP,0000,0000,0000,,Nono-san
Dialogue: 0,0:21:47.29,0:21:47.73,日文对话,NTP,0000,0000,0000,,Nono-san!
Dialogue: 0,0:22:13.86,0:22:16.27,日文对话,NTP,0000,0000,0000,,Саяға назар аударыңыз
Dialogue: 0,0:23:47.72,0:23:51.79,日文对话,NTP,0000,0000,0000,,Менің көз алдымда досымды құтқара алмау өте ауыр болса керек.
Dialogue: 0,0:23:52.24,0:23:52.88,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:23:53.30,0:23:57.09,日文对话,NTP,0000,0000,0000,,Бірақ сіз «ескі заттармен» күресе алатын жалғыз әулие қызсыз.
Dialogue: 0,0:23:57.66,0:23:59.00,日文对话,NTP,0000,0000,0000,,Тек мен
Dialogue: 0,0:23:59.33,0:24:01.69,日文对话,NTP,0000,0000,0000,,Сая Ескі заттарды не істеу керек
Dialogue: 0,0:24:02.38,0:24:04.72,日文对话,NTP,0000,0000,0000,,Мен сені жеңемін, өйткені мен уәде бердім.
Dialogue: 0,0:24:05.22,0:24:06.36,日文对话,NTP,0000,0000,0000,,Кіммен?
Dialogue: 0,0:24:06.45,0:24:06.92,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:24:07.29,0:24:09.76,日文对话,NTP,0000,0000,0000,,Бұл уәдені кім берді?
Dialogue: 0,0:24:10.68,0:24:11.44,日文对话,NTP,0000,0000,0000,,Сен
Dialogue: 0,0:24:12.30,0:24:15.43,日文对话,NTP,0000,0000,0000,,Келесі жолы BLOOD-C «Укарикеру»
Dialogue: 0,0:24:16.93,0:24:22.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory