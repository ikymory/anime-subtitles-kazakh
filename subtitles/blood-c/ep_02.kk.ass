Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,：   ： ： ： ：
Dialogue: 0,0:00:11.81,0:00:14.24,JP_ED,NTP,0000,0000,0000,,Осы түнде қыдырудың түсуі
Dialogue: 0,0:00:14.64,0:00:17.16,JP_ED,NTP,0000,0000,0000,,Мен қанша өмір сүргім келсе, солай адасып қалдым.
Dialogue: 0,0:00:17.42,0:00:22.21,JP_ED,NTP,0000,0000,0000,,Қайтып оралуға болмайтын өткен және сіз білетініңізге күмәнданбайсыз ба
Dialogue: 0,0:00:23.35,0:00:25.66,JP_ED,NTP,0000,0000,0000,,Мен сенетін барлық нәрселер
Dialogue: 0,0:00:25.84,0:00:28.52,JP_ED,NTP,0000,0000,0000,,Шындықты көргім келмейтін қара күндер
Dialogue: 0,0:00:28.71,0:00:33.93,JP_ED,NTP,0000,0000,0000,,Баруға болмайтын жағдайлар қайда барарыңды білмей қалады
Dialogue: 0,0:00:34.06,0:00:36.17,JP_ED,NTP,0000,0000,0000,,Үміттің де жалған екенін білесің бе?
Dialogue: 0,0:00:36.81,0:00:38.92,JP_ED,NTP,0000,0000,0000,,және бұл заклинание тек құдайлардың ақиқаты болып табылады
Dialogue: 0,0:00:39.44,0:00:44.50,JP_ED,NTP,0000,0000,0000,,Қараңғылықты кесіп өт
Dialogue: 0,0:00:44.96,0:00:47.70,JP_ED,NTP,0000,0000,0000,,Шексіздік сызығы неге қан кету керек
Dialogue: 0,0:00:47.85,0:00:50.62,JP_ED,NTP,0000,0000,0000,,менің меланхолиямды көтеріп
Dialogue: 0,0:00:50.79,0:00:53.48,JP_ED,NTP,0000,0000,0000,,тезірек келдім деп айта алмаймын
Dialogue: 0,0:00:53.55,0:00:54.75,JP_ED,NTP,0000,0000,0000,,себебі мен жасаймын
Dialogue: 0,0:00:55.01,0:00:55.97,JP_ED,NTP,0000,0000,0000,,ешқашан аяқталмайды
Dialogue: 0,0:00:56.51,0:00:58.34,JP_ED,NTP,0000,0000,0000,,менің croixтегі чипсы
Dialogue: 0,0:00:58.76,0:01:01.06,JP_ED,NTP,0000,0000,0000,,бұл мен сені қалайтындықтан
Dialogue: 0,0:01:01.70,0:01:04.50,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс орындалмайды
Dialogue: 0,0:01:04.90,0:01:06.00,JP_ED,NTP,0000,0000,0000,,Қазіргі уақытта жарқыраған жарық
Dialogue: 0,0:01:06.16,0:01:10.08,JP_ED,NTP,0000,0000,0000,,Бұл менің шындықты алып жүретін соңғы күшім
Dialogue: 0,0:01:10.44,0:01:13.26,JP_ED,NTP,0000,0000,0000,,Еш ауыртпалық жоқ пайда жоқ Абсолютті әділдік
Dialogue: 0,0:01:13.41,0:01:15.87,JP_ED,NTP,0000,0000,0000,,Себебін оқысаңыз және
Dialogue: 0,0:01:15.97,0:01:18.18,JP_ED,NTP,0000,0000,0000,,Мен шамымды қойдым
Dialogue: 0,0:01:18.38,0:01:20.95,JP_ED,NTP,0000,0000,0000,,Апокалипсис біреуді білу керек
Dialogue: 0,0:01:21.39,0:01:24.14,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс өзгеріссіз қалады
Dialogue: 0,0:01:24.57,0:01:26.89,JP_ED,NTP,0000,0000,0000,,у...
Dialogue: 0,0:02:01.06,0:02:02.60,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:02:04.62,0:02:06.34,日文对话,NTP,0000,0000,0000,,Сіз адамдарды жасайсыз
Dialogue: 0,0:02:06.71,0:02:09.59,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл уақыт болуы мүмкін.
Dialogue: 0,0:02:20.87,0:02:21.94,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:02:23.84,0:02:25.53,日文对话,NTP,0000,0000,0000,,Ұзақ уақыт аралығында
Dialogue: 0,0:02:25.63,0:02:26.88,日文对话,NTP,0000,0000,0000,,Тәжірибе жинақтау
Dialogue: 0,0:02:27.40,0:02:28.86,日文对话,NTP,0000,0000,0000,,Қайталанатын кездесулер
Dialogue: 0,0:02:29.70,0:02:32.01,日文对话,NTP,0000,0000,0000,,Адамдар осылай қалыптасады
Dialogue: 0,0:03:02.43,0:03:03.53,日文对话,NTP,0000,0000,0000,,Алайда
Dialogue: 0,0:03:03.99,0:03:07.54,日文对话,NTP,0000,0000,0000,,Өйткені, бұл бәрі емес.
Dialogue: 0,0:03:07.82,0:03:09.13,日文对话,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:03:10.35,0:03:11.73,日文对话,NTP,0000,0000,0000,,Қараңыз...
Dialogue: 0,0:03:14.07,0:03:15.76,强调,NTP,0000,0000,0000,,2 эпизод «Сіз үшін»
Dialogue: 0,0:03:16.70,0:03:19.49,日文对话,NTP,0000,0000,0000,,Бүгін ауа-райы жақсы
Dialogue: 0,0:03:21.69,0:03:23.57,日文对话,NTP,0000,0000,0000,,Таулардың өзі жасыл
Dialogue: 0,0:03:24.10,0:03:26.30,日文对话,NTP,0000,0000,0000,,Таңертеңгілік жұмыс
Dialogue: 0,0:03:26.66,0:03:31.00,日文对话,NTP,0000,0000,0000,,Ұйықтамай орындадым.
Dialogue: 0,0:03:36.13,0:03:39.69,日文对话,NTP,0000,0000,0000,,Кірді дұрыс жуыңыз
Dialogue: 0,0:03:41.46,0:03:46.40,日文对话,NTP,0000,0000,0000,,Мен кенеттен жауған жаңбырға алаңдаймын.
Dialogue: 0,0:03:47.70,0:03:49.92,日文对话,NTP,0000,0000,0000,,Әкесі: «Жаңбыр жаумайды» деді.
Dialogue: 0,0:03:50.25,0:03:52.35,日文对话,NTP,0000,0000,0000,,Өйткені сен солай айттың.
Dialogue: 0,0:03:52.55,0:03:54.28,日文对话,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:03:55.08,0:03:56.98,日文对话,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:03:56.10,0:03:57.22,日文对话,NTP,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:03:57.44,0:04:04.83,日文对话,NTP,0000,0000,0000,,О... аа... иә... Бунто-сан
Dialogue: 0,0:04:11.87,0:04:13.68,日文对话,NTP,0000,0000,0000,,...ұят.
Dialogue: 0,0:04:14.00,0:04:14.92,日文对话,NTP,0000,0000,0000,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:04:15.30,0:04:17.35,日文对话,NTP,0000,0000,0000,,Бұл сүйкімді ән болды
Dialogue: 0,0:04:17.68,0:04:19.72,日文对话,NTP,0000,0000,0000,,«Әке жаңбыр жаумаса,
Dialogue: 0,0:04:19.93,0:04:21.92,日文对话,NTP,0000,0000,0000,,Себебі сен солай айттың.
Dialogue: 0,0:04:22.04,0:04:24.00,日文对话,NTP,0000,0000,0000,,Жарайды».
Dialogue: 0,0:04:26.67,0:04:27.61,日文对话,NTP,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:04:27.75,0:04:30.20,日文对话,NTP,0000,0000,0000,,Әке тіпті әнде кездеседі.
Dialogue: 0,0:04:30.27,0:04:32.98,日文对话,NTP,0000,0000,0000,,Әкем шын айтса, күн ашық болады.
Dialogue: 0,0:04:33.07,0:04:34.02,日文对话,NTP,0000,0000,0000,,Күн ашық.
Dialogue: 0,0:04:34.44,0:04:36.44,日文对话,NTP,0000,0000,0000,,Сондықтан да жақсы
Dialogue: 0,0:04:36.77,0:04:37.72,日文对话,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:04:37.83,0:04:40.80,日文对话,NTP,0000,0000,0000,,Юйоши ауа райы болжамын тексеріп жатқандықтан болар.
Dialogue: 0,0:04:40.99,0:04:43.33,日文对话,NTP,0000,0000,0000,,Бірақ әкем айтқандай,
Dialogue: 0,0:04:43.53,0:04:44.82,日文对话,NTP,0000,0000,0000,,Қате жоқ
Dialogue: 0,0:04:49.52,0:04:51.99,日文对话,NTP,0000,0000,0000,,Сайо-чан әкесін шынымен жақсы көреді~
Dialogue: 0,0:04:52.42,0:04:53.10,日文对话,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:05:00.15,0:05:01.15,日文对话,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:05:03.45,0:05:04.61,日文对话,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:05:05.43,0:05:09.12,日文对话,NTP,0000,0000,0000,,Таңертең кір жууға көп жұмыс істеген Сайо-чанға сыйлық
Dialogue: 0,0:05:09.66,0:05:11.36,日文对话,NTP,0000,0000,0000,,Кірден?
Dialogue: 0,0:05:11.86,0:05:13.73,日文对话,NTP,0000,0000,0000,,Бұл соншалықты қатты болды ма?
Dialogue: 0,0:05:13.83,0:05:15.27,日文对话,NTP,0000,0000,0000,,Менің әнім…
Dialogue: 0,0:05:15.63,0:05:19.12,日文对话,NTP,0000,0000,0000,,Иә, бұл жанды ән болатын дауыс еді.
Dialogue: 0,0:05:25.96,0:05:27.27,日文对话,NTP,0000,0000,0000,,Міне.
Dialogue: 0,0:05:27.60,0:05:29.18,日文对话,NTP,0000,0000,0000,,Мен оны «Жимаув» деп атадым.
Dialogue: 0,0:05:30.47,0:05:32.04,日文对话,NTP,0000,0000,0000,,Осы дүкеннің атауы және...
Dialogue: 0,0:05:32.25,0:05:33.94,日文对话,NTP,0000,0000,0000,,Иә, дәл солай
Dialogue: 0,0:05:35.12,0:05:37.86,日文对话,NTP,0000,0000,0000,,Сайо-чан, бұл әрқашан қара кофе.
Dialogue: 0,0:05:38.11,0:05:40.66,日文对话,NTP,0000,0000,0000,,Иә, өте дәмді.
Dialogue: 0,0:05:41.90,0:05:44.83,日文对话,NTP,0000,0000,0000,,Мен бұл кофені кем дегенде күніне бір рет ішуім керек.
Dialogue: 0,0:05:44.93,0:05:46.15,日文对话,NTP,0000,0000,0000,,Мен тынышсызмын
Dialogue: 0,0:05:46.93,0:05:47.92,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:48.62,0:05:51.21,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл кофемен жақсы көрінеді.
Dialogue: 0,0:06:08.89,0:06:10.95,日文对话,NTP,0000,0000,0000,,Әйтеуір, ұстағанда біртүрлі сезіледі.
Dialogue: 0,0:06:12.37,0:06:13.43,日文对话,NTP,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:06:14.20,0:06:16.85,日文对话,NTP,0000,0000,0000,,Хмм, бұл дәмді.
Dialogue: 0,0:06:17.38,0:06:19.79,日文对话,NTP,0000,0000,0000,,Сізге ұнағаны жақсы.
Dialogue: 0,0:06:25.54,0:06:27.25,日文对话,NTP,0000,0000,0000,,Бұл өте дәмді
Dialogue: 0,0:06:28.06,0:06:30.67,日文对话,NTP,0000,0000,0000,,Әкем маған бұрын берген.
Dialogue: 0,0:06:31.07,0:06:32.85,日文对话,NTP,0000,0000,0000,,Фу манжу да дәмді болды.
Dialogue: 0,0:06:34.40,0:06:35.39,日文对话,NTP,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,0:06:35.43,0:06:37.50,日文对话,NTP,0000,0000,0000,,Иә! Кез келген тәтті
Dialogue: 0,0:06:38.00,0:06:41.58,日文对话,NTP,0000,0000,0000,,Юйоши де тәттілерді жақсы көретін сияқты.
Dialogue: 0,0:06:41.71,0:06:42.43,日文对话,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:06:42.55,0:06:45.72,日文对话,NTP,0000,0000,0000,,Менімен тамақты жиі жемейді.
Dialogue: 0,0:06:47.14,0:06:48.30,日文对话,NTP,0000,0000,0000,,Бұл ұят болуы керек.
Dialogue: 0,0:06:48.90,0:06:51.24,日文对话,NTP,0000,0000,0000,,У...Мен...бірдеңе жегенде.
Dialogue: 0,0:06:51.40,0:06:53.42,日文对话,NTP,0000,0000,0000,,Сіз ұят нәрсе жасадыңыз ба?
Dialogue: 0,0:06:53.49,0:06:54.26,日文对话,NTP,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:06:54.58,0:06:56.47,日文对话,NTP,0000,0000,0000,,Сайо-чан әрқашан сүйкімді
Dialogue: 0,0:06:59.94,0:07:00.68,日文对话,NTP,0000,0000,0000,,Өзің бар
Dialogue: 0,0:07:01.97,0:07:05.28,日文对话,NTP,0000,0000,0000,,Ересек еркектің көпшілік алдында тәтті жегені дұрыс па?
Dialogue: 0,0:07:05.45,0:07:07.24,日文对话,NTP,0000,0000,0000,,Кедергілер өте жоғары.
Dialogue: 0,0:07:07.84,0:07:10.02,日文对话,NTP,0000,0000,0000,,Ересек болған дұрыс па?
Dialogue: 0,0:07:10.25,0:07:11.31,日文对话,NTP,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:07:11.76,0:07:14.79,日文对话,NTP,0000,0000,0000,,Бірақ Юйоши салқын көрінгісі келетін шығар.
Dialogue: 0,0:07:15.09,0:07:16.52,日文对话,NTP,0000,0000,0000,,Сайо-чанның алдында
Dialogue: 0,0:07:17.06,0:07:19.59,日文对话,NTP,0000,0000,0000,,Әкем онсыз да жақсы көрінеді.
Dialogue: 0,0:07:22.25,0:07:23.32,日文对话,NTP,0000,0000,0000,,Менің айтып тұрғаным осы.
Dialogue: 0,0:07:23.66,0:07:26.56,日文对话,NTP,0000,0000,0000,,Айтпақшы, жасыруға ниетіңіз болса да
Dialogue: 0,0:07:26.98,0:07:29.99,日文对话,NTP,0000,0000,0000,,Тәтті дегенім де белгілі.
Dialogue: 0,0:07:31.93,0:07:33.11,日文对话,NTP,0000,0000,0000,,Гимоув
Dialogue: 0,0:07:33.24,0:07:34.42,日文对话,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:07:34.59,0:07:35.72,日文对话,NTP,0000,0000,0000,,Оны ала аламын ба?
Dialogue: 0,0:07:36.09,0:07:36.85,日文对话,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:07:37.41,0:07:38.92,日文对话,NTP,0000,0000,0000,,Рахмет!
Dialogue: 0,0:07:43.54,0:07:45.93,日文对话,NTP,0000,0000,0000,,Гимоув Гимоув~
Dialogue: 0,0:07:46.06,0:07:48.07,日文对话,NTP,0000,0000,0000,,Жұмбақ есім
Dialogue: 0,0:07:48.49,0:07:52.89,日文对话,NTP,0000,0000,0000,,Тәтті, жұмбақ және үлпілдек
Dialogue: 0,0:08:02.43,0:08:04.50,日文对话,NTP,0000,0000,0000,,Гимоув
Dialogue: 0,0:08:05.10,0:08:08.34,日文对话,NTP,0000,0000,0000,,Кейбір заттарға қол тигізу сезімі өте ұқсас деп айтылады.
Dialogue: 0,0:08:11.16,0:08:12.19,日文对话,NTP,0000,0000,0000,,Хигучи расталды.
Dialogue: 0,0:08:13.18,0:08:14.88,日文对话,NTP,0000,0000,0000,,Қызық, бұл не?
Dialogue: 0,0:08:20.21,0:08:23.08,日文对话,NTP,0000,0000,0000,,Оны ұстағанда қандай сезім пайда болады?
Dialogue: 0,0:09:33.41,0:09:34.51,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:09:36.91,0:09:38.34,日文对话,NTP,0000,0000,0000,,Бүгін не?
Dialogue: 0,0:09:39.57,0:09:40.24,日文对话,NTP,0000,0000,0000,,Ит...
Dialogue: 0,0:09:40.38,0:09:42.02,日文对话,NTP,0000,0000,0000,,Мені тағы да тастап кетті
Dialogue: 0,0:09:42.82,0:09:44.58,日文对话,NTP,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:09:44.91,0:09:46.01,日文对话,NTP,0000,0000,0000,,Жалғыз болу...
Dialogue: 0,0:09:47.57,0:09:49.22,日文对话,NTP,0000,0000,0000,,Сонда бұл тастанды ит пе?
Dialogue: 0,0:09:49.52,0:09:53.05,日文对话,NTP,0000,0000,0000,,Жоқ. Мен оны тастап кеткен ит үшін сабырлы дер едім.
Dialogue: 0,0:09:53.18,0:09:55.09,日文对话,NTP,0000,0000,0000,,Сіз мұны лайықты деп айта аласыз ба?
Dialogue: 0,0:09:55.37,0:09:56.90,日文对话,NTP,0000,0000,0000,,Бұл үлкен ит болды.
Dialogue: 0,0:09:57.24,0:09:58.95,日文对话,NTP,0000,0000,0000,,Жарайды, кішкентай болды.
Dialogue: 0,0:09:59.20,0:10:00.03,日文对话,NTP,0000,0000,0000,,Күшік?
Dialogue: 0,0:10:00.42,0:10:02.14,日文对话,NTP,0000,0000,0000,,кем
Dialogue: 0,0:10:02.74,0:10:04.76,日文对话,NTP,0000,0000,0000,,Оның біртүрлі үлгісі бар.
Dialogue: 0,0:10:05.22,0:10:06.24,日文对话,NTP,0000,0000,0000,,Оюдың қандай түрі?
Dialogue: 0,0:10:06.86,0:10:09.59,日文对话,NTP,0000,0000,0000,,Аа, қайырлы таң, төраға.
Dialogue: 0,0:10:10.27,0:10:11.04,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:10:11.70,0:10:13.49,日文对话,NTP,0000,0000,0000,,Мүмкін болса, атымды атаңыз.
Dialogue: 0,0:10:13.72,0:10:15.02,日文对话,NTP,0000,0000,0000,,Мен бақыттырақ болар едім.
Dialogue: 0,0:10:17.07,0:10:20.45,日文对话,NTP,0000,0000,0000,,Менің ойымша, ол сізді Томо төрағасы деп те атайды.
Dialogue: 0,0:10:20.55,0:10:22.79,日文对话,NTP,0000,0000,0000,,Жоқ, бұл менің айтқым келгенім емес...
Dialogue: 0,0:10:22.91,0:10:24.71,日文对话,NTP,0000,0000,0000,,Ицуки-чан бүлігі!
Dialogue: 0,0:10:25.00,0:10:27.13,日文对话,NTP,0000,0000,0000,,Сайо-чан еркелеп, байқамайды.
Dialogue: 0,0:10:27.51,0:10:29.90,日文对话,NTP,0000,0000,0000,,Жоқ, егер сіздің шеберлігіңіз жоғары болса
Dialogue: 0,0:10:29.99,0:10:31.62,日文对话,NTP,0000,0000,0000,,Керісінше, маған жауынгерлік рух береді.
Dialogue: 0,0:10:31.68,0:10:33.42,日文对话,NTP,0000,0000,0000,,Күтілгендей, Төраға
Dialogue: 0,0:10:37.33,0:10:38.57,日文对话,NTP,0000,0000,0000,,Үй бөлмесі
Dialogue: 0,0:10:45.22,0:10:46.89,日文对话,NTP,0000,0000,0000,,Әрең.
Dialogue: 0,0:10:48.22,0:10:49.27,日文对话,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:10:49.51,0:10:53.06,日文对话,NTP,0000,0000,0000,,Сондай-ақ, жүректің жетіспеуі әрең болады.
Dialogue: 0,0:11:01.56,0:11:03.05,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:11:16.51,0:11:17.59,日文对话,NTP,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:11:17.90,0:11:20.35,日文对话,NTP,0000,0000,0000,,Чанги мырза, қолдан жасалған ба?
Dialogue: 0,0:11:22.18,0:11:25.36,日文对话,NTP,0000,0000,0000,,Оны жазушы жасаған.
Dialogue: 0,0:11:25.57,0:11:26.60,日文对话,NTP,0000,0000,0000,,Әдебиетші мырза?
Dialogue: 0,0:11:27.08,0:11:29.61,日文对话,NTP,0000,0000,0000,,«Cafe Gimauve» Сіз мұны білесіз бе?
Dialogue: 0,0:11:29.93,0:11:33.77,日文对话,NTP,0000,0000,0000,,Дұрыс, өйткені бұл қаладағы жалғыз дәмхана.
Dialogue: 0,0:11:34.00,0:11:37.64,日文对话,NTP,0000,0000,0000,,Дәлірек айтсақ, кофехана сияқты ештеңе жоқ.
Dialogue: 0,0:11:38.34,0:11:39.87,日文对话,NTP,0000,0000,0000,,Бұл жерде шебер.
Dialogue: 0,0:11:39.94,0:11:43.06,日文对话,NTP,0000,0000,0000,,Ол адам Чан мырзаның түскі асын неліктен сатып алды?
Dialogue: 0,0:11:44.04,0:11:46.95,日文对话,NTP,0000,0000,0000,,Ол менің әкемнің орта мектепте кіші сынып оқушысы болса керек.
Dialogue: 0,0:11:48.34,0:11:50.13,日文对话,NTP,0000,0000,0000,,Чанг мырзаның әкесімен
Dialogue: 0,0:11:50.66,0:11:52.82,日文对话,NTP,0000,0000,0000,,Арамызда жылдар алшақтығы бар сияқты.
Dialogue: 0,0:11:53.30,0:11:56.19,日文对话,NTP,0000,0000,0000,,Олар бір уақытта қатыспаған сияқты.
Dialogue: 0,0:11:56.77,0:11:57.68,日文对话,NTP,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:11:58.29,0:11:59.96,日文对话,NTP,0000,0000,0000,,Саған жақсы, Ицуки-чан
Dialogue: 0,0:12:00.05,0:12:02.35,日文对话,NTP,0000,0000,0000,,Әлі үміт бар, Ицуки-чан.
Dialogue: 0,0:12:03.17,0:12:05.71,日文对话,NTP,0000,0000,0000,,Рахмет, мен бар күшімді саламын.
Dialogue: 0,0:12:10.91,0:12:14.14,日文对话,NTP,0000,0000,0000,,«Жимаув» деген не екенін білесіз бе?
Dialogue: 0,0:12:15.99,0:12:17.23,日文对话,NTP,0000,0000,0000,,Бұл кафе, солай ма?
Dialogue: 0,0:12:17.48,0:12:19.19,日文对话,NTP,0000,0000,0000,,Тәттілер жоқ
Dialogue: 0,0:12:19.43,0:12:22.76,日文对话,NTP,0000,0000,0000,,Әй, бұл зефирді батырған сияқты.
Dialogue: 0,0:12:22.92,0:12:24.19,日文对话,NTP,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:12:25.14,0:12:29.14,日文对话,NTP,0000,0000,0000,,Текстура бір нәрсеге ұқсайтын сияқты.
Dialogue: 0,0:12:29.97,0:12:31.41,日文对话,NTP,0000,0000,0000,,Мен оны ешқашан жеген емеспін.
Dialogue: 0,0:12:31.97,0:12:32.80,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:33.73,0:12:34.70,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:12:35.68,0:12:37.28,日文对话,NTP,0000,0000,0000,,Ол неге ұқсайды?
Dialogue: 0,0:12:37.59,0:12:39.39,日文对话,NTP,0000,0000,0000,,Шайнау
Dialogue: 0,0:12:40.79,0:12:43.80,日文对话,NTP,0000,0000,0000,,Бұл шайнау сезіміне ұқсас.
Dialogue: 0,0:12:44.09,0:12:44.87,日文对话,NTP,0000,0000,0000,,Е! ?
Dialogue: 0,0:12:45.71,0:12:49.11,日文对话,NTP,0000,0000,0000,,Күткендей, ол Чуға жауап бермеді.
Dialogue: 0,0:12:50.28,0:12:52.48,日文对话,NTP,0000,0000,0000,,Саған жақсы, Ицуки-чан
Dialogue: 0,0:12:52.98,0:12:55.24,日文对话,NTP,0000,0000,0000,,Ах, рахмет. Мен көбірек тырысамын.
Dialogue: 0,0:12:56.22,0:12:59.63,日文对话,NTP,0000,0000,0000,,Тез тамақ ішпесең, Сая, түскі үзіліс бітеді.
Dialogue: 0,0:12:59.94,0:13:00.61,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:08.27,0:13:09.24,日文对话,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:13:09.39,0:13:10.42,日文对话,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:13:10.60,0:13:12.21,日文对话,NTP,0000,0000,0000,,Үйде жасалған түскі ас қорабы
Dialogue: 0,0:13:13.67,0:13:15.28,日文对话,NTP,0000,0000,0000,,Бүгін екеуің...
Dialogue: 0,0:13:15.58,0:13:18.20,日文对话,NTP,0000,0000,0000,,Пан Warbler дүкені
Dialogue: 0,0:13:19.71,0:13:22.54,日文对话,NTP,0000,0000,0000,,Анау дүкеннің наны дәмді ғой, солай емес пе?
Dialogue: 0,0:13:23.07,0:13:25.53,日文对话,NTP,0000,0000,0000,,Бұл қаладағы жалғыз наубайхана.
Dialogue: 0,0:13:26.07,0:13:28.26,日文对话,NTP,0000,0000,0000,,Жаман болса, мен оны жоғалтамын.
Dialogue: 0,0:13:29.40,0:13:32.01,日文对话,NTP,0000,0000,0000,,Бұл қалада тек «біреулер» бар.
Dialogue: 0,0:13:32.17,0:13:34.16,日文对话,NTP,0000,0000,0000,,Бір ғана супермаркет бар.
Dialogue: 0,0:13:34.34,0:13:36.17,日文对话,NTP,0000,0000,0000,,Бұл тіпті жұмыс істемейтін жалғыз нәрсе.
Dialogue: 0,0:13:36.42,0:13:37.49,日文对话,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:13:37.61,0:13:38.79,日文对话,NTP,0000,0000,0000,,Қайда ойнауға болады
Dialogue: 0,0:13:39.00,0:13:40.19,日文对话,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:13:40.52,0:13:41.98,日文对话,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес
Dialogue: 0,0:13:42.10,0:13:46.08,日文对话,NTP,0000,0000,0000,,Қаладан гөрі ауыл сияқты сезінеді.
Dialogue: 0,0:13:46.52,0:13:47.94,日文对话,NTP,0000,0000,0000,,Адамдар да көп емес.
Dialogue: 0,0:13:48.26,0:13:49.23,日文对话,NTP,0000,0000,0000,,Дәл
Dialogue: 0,0:13:49.73,0:13:50.94,日文对话,NTP,0000,0000,0000,,Халық қоныстанған аймақтар
Dialogue: 0,0:13:52.31,0:13:55.09,日文对话,NTP,0000,0000,0000,,Бірақ жақсы жер, тыныш.
Dialogue: 0,0:13:56.26,0:13:58.90,日文对话,NTP,0000,0000,0000,,Сізге бұл жер ұнай ма?
Dialogue: 0,0:13:59.80,0:14:00.63,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:12.19,0:14:13.06,日文对话,NTP,0000,0000,0000,,Сая?
Dialogue: 0,0:14:16.02,0:14:18.95,日文对话,NTP,0000,0000,0000,,Ух,
Dialogue: 0,0:14:20.95,0:14:22.96,日文对话,NTP,0000,0000,0000,,Сол Токима-сан
Dialogue: 0,0:14:23.23,0:14:23.99,日文对话,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:14:24.24,0:14:25.37,日文对话,NTP,0000,0000,0000,,Түскі ас ше?
Dialogue: 0,0:14:25.98,0:14:27.55,日文对话,NTP,0000,0000,0000,,Жоқ, әлі жоқ.
Dialogue: 0,0:14:27.63,0:14:30.26,日文对话,NTP,0000,0000,0000,,Тез тамақ ішпесең, түскі ас бітеді.
Dialogue: 0,0:14:30.38,0:14:32.43,日文对话,NTP,0000,0000,0000,,Мен әсіресе аш емеспін.
Dialogue: 0,0:14:32.55,0:14:33.45,日文对话,NTP,0000,0000,0000,,№
Dialogue: 0,0:14:34.07,0:14:35.28,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:14:35.47,0:14:38.92,日文对话,NTP,0000,0000,0000,,Қарным ашса, мұңаямын.
Dialogue: 0,0:14:41.38,0:14:42.10,日文对话,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:14:48.24,0:14:48.89,日文对话,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:14:50.34,0:14:51.22,日文对话,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,0:14:52.80,0:14:54.09,日文对话,NTP,0000,0000,0000,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:15:13.76,0:15:15.18,日文对话,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:16.63,0:15:18.66,日文对话,NTP,0000,0000,0000,,Жақсы...
Dialogue: 0,0:15:21.39,0:15:22.70,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:15:23.18,0:15:25.60,日文对话,NTP,0000,0000,0000,,Маған неге рахмет айтасың?
Dialogue: 0,0:15:25.74,0:15:27.50,日文对话,NTP,0000,0000,0000,,Өйткені сен оны жедің.
Dialogue: 0,0:15:27.80,0:15:31.52,日文对话,NTP,0000,0000,0000,,Сонымен қатар, Фумито-сан менің түскі ас қорабын мақтады.
Dialogue: 0,0:15:31.61,0:15:32.56,日文对话,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:15:34.15,0:15:35.82,日文对话,NTP,0000,0000,0000,,Так, мына бала.
Dialogue: 0,0:15:36.32,0:15:37.55,日文对话,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:15:37.98,0:15:39.92,日文对话,NTP,0000,0000,0000,,Басқа бағыт орын алса ше?
Dialogue: 0,0:15:40.00,0:15:43.13,日文对话,NTP,0000,0000,0000,,Жеңіске жеткен бенто графигін жасау қиынға соқса да.
Dialogue: 0,0:15:52.62,0:15:55.72,日文对话,NTP,0000,0000,0000,,Кейін...ештеңе қалмады деп үміттенемін.
Dialogue: 0,0:16:22.57,0:16:26.45,日文对话,NTP,0000,0000,0000,,Сая, сен қашанға дейін тұрасың?
Dialogue: 0,0:16:27.55,0:16:29.66,日文对话,NTP,0000,0000,0000,,Мен тамақты осында бітіремін.
Dialogue: 0,0:16:30.08,0:16:31.31,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:16:37.20,0:16:40.64,日文对话,NTP,0000,0000,0000,,Бүгін ауа-райы әлдеқайда жақсы.
Dialogue: 0,0:16:41.17,0:16:43.45,日文对话,NTP,0000,0000,0000,,Аспан қызыл
Dialogue: 0,0:16:43.99,0:16:49.46,日文对话,NTP,0000,0000,0000,,Әкем айтқандай ғой.
Dialogue: 0,0:16:50.05,0:16:54.00,日文对话,NTP,0000,0000,0000,,Киімді жууға болмайды.
Dialogue: 0,0:16:54.88,0:16:59.30,日文对话,NTP,0000,0000,0000,,Әкем айтқандай ғой.
Dialogue: 0,0:16:59.79,0:17:04.16,日文对话,NTP,0000,0000,0000,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:17:07.70,0:17:08.72,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:17:13.09,0:17:14.48,日文对话,NTP,0000,0000,0000,,Мен үйге жаңа ғана оралдым.
Dialogue: 0,0:17:15.20,0:17:17.00,日文对话,NTP,0000,0000,0000,,Иә, Сайо
Dialogue: 0,0:17:17.11,0:17:18.02,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:18.41,0:17:22.15,日文对话,NTP,0000,0000,0000,,Көңілді болған жақсы, бірақ сол ән...
Dialogue: 0,0:17:22.79,0:17:24.42,日文对话,NTP,0000,0000,0000,,Өйткені, мен сізді естимін.
Dialogue: 0,0:17:24.96,0:17:27.04,日文对话,NTP,0000,0000,0000,,А...иә...
Dialogue: 0,0:17:30.39,0:17:32.40,日文对话,NTP,0000,0000,0000,,Сақтау бөлмесін пайдаландыңыз ба?
Dialogue: 0,0:17:32.59,0:17:33.43,日文对话,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:33.71,0:17:34.88,日文对话,NTP,0000,0000,0000,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:17:36.82,0:17:39.36,日文对话,NTP,0000,0000,0000,,«Ежелгі заттар» деп кім атады?
Dialogue: 0,0:17:39.72,0:17:43.42,日文对话,NTP,0000,0000,0000,,Өйткені ол ешбір кітапта жазылмаған.
Dialogue: 0,0:17:43.57,0:17:48.02,日文对话,NTP,0000,0000,0000,,Бірақ онда ерте заманнан деп жазылған
Dialogue: 0,0:17:48.12,0:17:51.28,日文对话,NTP,0000,0000,0000,,Адамдарды жеу үшін жасалғаны анық.
Dialogue: 0,0:17:51.79,0:17:53.40,日文对话,NTP,0000,0000,0000,,Адамдарды не жейді
Dialogue: 0,0:17:53.55,0:17:57.65,日文对话,NTP,0000,0000,0000,,Екінші жағынан Сая ең хабардар болса керек.
Dialogue: 0,0:17:58.21,0:18:00.09,日文对话,NTP,0000,0000,0000,,Олар күшті
Dialogue: 0,0:18:00.28,0:18:00.89,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:01.20,0:18:04.63,日文对话,NTP,0000,0000,0000,,Ал оларды жеңетін жалғыз нәрсе
Dialogue: 0,0:18:05.01,0:18:06.39,日文对话,NTP,0000,0000,0000,,Құдайдың семсері
Dialogue: 0,0:18:07.20,0:18:14.56,日文对话,NTP,0000,0000,0000,,Дұрыс, анаң да қолына тәңірлік қылыш алып, көне дүниелерге қарсы күрескен.
Dialogue: 0,0:18:15.09,0:18:16.42,日文对话,NTP,0000,0000,0000,,Және жеңілді
Dialogue: 0,0:18:20.51,0:18:22.36,日文对话,NTP,0000,0000,0000,,Сая жеңілмейді
Dialogue: 0,0:18:24.37,0:18:29.14,日文对话,NTP,0000,0000,0000,,Мен ескіні ұрып, әкемді ... және барлығын қорғаймын.
Dialogue: 0,0:22:11.89,0:22:13.54,日文对话,NTP,0000,0000,0000,,Қорғау
Dialogue: 0,0:22:29.12,0:22:34.65,JP_ED,NTP,0000,0000,0000,,Бұлыңғыр түнге ағып жатқан дөрекі дауыс
Dialogue: 0,0:22:34.94,0:22:40.13,JP_ED,NTP,0000,0000,0000,,Туған жерді жеңіл билеу
Dialogue: 0,0:22:40.74,0:22:43.63,JP_ED,NTP,0000,0000,0000,,Қолыңызды созсаңыз, ол жоғалады
Dialogue: 0,0:22:43.86,0:22:46.77,JP_ED,NTP,0000,0000,0000,,Өтпелі түсте
Dialogue: 0,0:22:47.00,0:22:49.44,JP_ED,NTP,0000,0000,0000,,Көрінбейтін махаббатқа көлеңке түсіру
Dialogue: 0,0:22:49.62,0:22:52.37,JP_ED,NTP,0000,0000,0000,,Жалғыз күліңіз
Dialogue: 0,0:22:52.94,0:22:56.16,JP_ED,NTP,0000,0000,0000,,Айдың қуыс сәулесін бақылау
Dialogue: 0,0:22:56.18,0:22:59.14,JP_ED,NTP,0000,0000,0000,,Сол серпімді саусақтардың ұштарына
Dialogue: 0,0:22:59.22,0:23:03.00,JP_ED,NTP,0000,0000,0000,,Бәрін маған қалдыр
Dialogue: 0,0:23:03.97,0:23:07.38,JP_ED,NTP,0000,0000,0000,,Әй, әрбір жанып тұрған айқай
Dialogue: 0,0:23:07.59,0:23:13.46,JP_ED,NTP,0000,0000,0000,,Жіпсіз күй жұмаққа шақырады
Dialogue: 0,0:23:13.61,0:23:19.65,JP_ED,NTP,0000,0000,0000,,Мәңгілік естеліктер бір-бірімен әдемі өрілгені сонша, олар ән салады
Dialogue: 0,0:23:19.79,0:23:24.98,JP_ED,NTP,0000,0000,0000,,Сезімімнің шықы сені іздейді
Dialogue: 0,0:23:25.32,0:23:29.66,JP_ED,NTP,0000,0000,0000,,Өлмей-ақ мына аспанды боя
Dialogue: 0,0:23:29.95,0:23:36.19,JP_ED,NTP,0000,0000,0000,,Ол жарқырай береді
Dialogue: 0,0:23:46.73,0:23:47.52,强调,NTP,0000,0000,0000,,Ескерту
Dialogue: 0,0:23:47.75,0:23:50.35,日文对话,NTP,0000,0000,0000,,Мен кешігіп қалдым.
Dialogue: 0,0:23:50.74,0:23:52.70,日文对话,NTP,0000,0000,0000,,Кешке дейін теледидар қарап отырдым.
Dialogue: 0,0:23:52.99,0:23:54.55,日文对话,NTP,0000,0000,0000,,Жаңалықтар мен комедия
Dialogue: 0,0:23:54.72,0:23:56.49,日文对话,NTP,0000,0000,0000,,Пошта тапсырысы, Докиметтари және т.б.
Dialogue: 0,0:23:56.72,0:23:58.28,日文对话,NTP,0000,0000,0000,,Эстрадалық шоулар, ән айту шоулары және т.б.
Dialogue: 0,0:23:58.40,0:24:00.85,日文对话,NTP,0000,0000,0000,,Саяхат бағдарламалары, тамақ әзірлеу бағдарламалары және т.б.
Dialogue: 0,0:24:01.40,0:24:04.73,日文对话,NTP,0000,0000,0000,,Бұл не нәрсе?
Dialogue: 0,0:24:04.98,0:24:05.87,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:24:05.91,0:24:08.59,日文对话,NTP,0000,0000,0000,,Киім ауыстыратын үйдің сыры ақыры ашылды
Dialogue: 0,0:24:08.91,0:24:11.02,日文对话,NTP,0000,0000,0000,,Таңғажайып шындық қандай?
Dialogue: 0,0:24:11.36,0:24:11.94,日文对话,NTP,0000,0000,0000,,Бұл қоқыс
Dialogue: 0,0:24:12.93,0:24:15.84,强调,NTP,0000,0000,0000,,Келесі жолы қан с «Хито ва Иса»
Dialogue: 0,0:24:17.34,0:24:23.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory