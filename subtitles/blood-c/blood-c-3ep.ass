Dialogue: 0,0:01:30.00,0:01:39.59,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.00,0:01:39.59,诸神字幕组显示,NTP,0000,0000,0000,,： ： ： ：Akira ： ：
Dialogue: 0,0:02:04.24,0:02:05.43,日文对话,NTP,0000,0000,0000,,Не болды, Сая?
Dialogue: 0,0:02:06.24,0:02:08.91,日文对话,NTP,0000,0000,0000,,Тамагояки таяқшалары ұсақталды.
Dialogue: 0,0:02:10.14,0:02:13.82,日文对话,NTP,0000,0000,0000,,Жарайды, мен Юйошиге сол бөлікті жеуге рұқсат етемін.
Dialogue: 0,0:02:14.32,0:02:15.95,日文对话,NTP,0000,0000,0000,,Жоқ, бұл менмін.
Dialogue: 0,0:02:16.96,0:02:18.60,日文对话,NTP,0000,0000,0000,,Жоқ, алайық.
Dialogue: 0,0:02:19.36,0:02:20.40,日文对话,NTP,0000,0000,0000,,Бірақ әке
Dialogue: 0,0:02:21.20,0:02:24.33,日文对话,NTP,0000,0000,0000,,Юйоши Сайо-чан жасаған тамагоякиді жеді.
Dialogue: 0,0:02:24.80,0:02:27.68,日文对话,NTP,0000,0000,0000,,Соңына дейін татып көргім келеді, эй.
Dialogue: 0,0:02:29.88,0:02:30.80,日文对话,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:02:31.63,0:02:33.25,日文对话,NTP,0000,0000,0000,,Егер сіз тамагоякиді қатты ұнатсаңыз
Dialogue: 0,0:02:33.80,0:02:35.72,日文对话,NTP,0000,0000,0000,,Сая Мен көп жұмыс істеймін
Dialogue: 0,0:02:50.21,0:02:51.90,日文对话,NTP,0000,0000,0000,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:02:53.15,0:02:55.36,日文对话,NTP,0000,0000,0000,,Тамагояки дәмді болды.
Dialogue: 0,0:02:56.06,0:02:57.14,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:02:57.62,0:03:00.86,日文对话,NTP,0000,0000,0000,,Келесі жолы одан да жақсырақ ету үшін бар күшімді саламын.
Dialogue: 0,0:03:01.02,0:03:01.46,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:01.62,0:03:02.95,日文对话,NTP,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,0:03:03.57,0:03:04.45,日文对话,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:05.52,0:03:07.24,日文对话,NTP,0000,0000,0000,,А... әкең ше?
Dialogue: 0,0:03:09.69,0:03:11.20,日文对话,NTP,0000,0000,0000,,Мен қазір қайнатып жатқан жерім
Dialogue: 0,0:03:11.70,0:03:13.45,日文对话,NTP,0000,0000,0000,,А...олай болса менен алда жүр.
Dialogue: 0,0:03:13.92,0:03:16.21,日文对话,NTP,0000,0000,0000,,Сайо-чан мен Юйоши-сан әр түрлі.
Dialogue: 0,0:03:16.75,0:03:17.45,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:03:18.81,0:03:22.31,日文对话,NTP,0000,0000,0000,,Бұл адам өте әлсіз кофені ғана іше алады.
Dialogue: 0,0:03:23.02,0:03:24.58,日文对话,NTP,0000,0000,0000,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:03:25.27,0:03:26.39,日文对话,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:03:29.70,0:03:31.71,日文对话,NTP,0000,0000,0000,,Ах...гимав
Dialogue: 0,0:03:32.99,0:03:34.44,日文对话,NTP,0000,0000,0000,,Ол дәмді болды деді.
Dialogue: 0,0:03:34.60,0:03:35.79,日文对话,NTP,0000,0000,0000,,Мен оны әлі жасап жүрдім.
Dialogue: 0,0:03:36.17,0:03:37.66,日文对话,NTP,0000,0000,0000,,Оны ала аламын ба?
Dialogue: 0,0:03:38.59,0:03:39.11,日文对话,NTP,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:03:49.43,0:03:52.04,日文对话,NTP,0000,0000,0000,,Неге екені белгісіз, мен оны жесем үлпілдеп қалады.
Dialogue: 0,0:03:52.17,0:03:54.13,日文对话,NTP,0000,0000,0000,,Бұл текстураға байланысты емес пе?
Dialogue: 0,0:03:54.77,0:03:56.45,日文对话,NTP,0000,0000,0000,,Жоқ, бұл ғана емес.
Dialogue: 0,0:03:56.78,0:03:59.03,日文对话,NTP,0000,0000,0000,,Бұл мені шынымен де жұмсақ сезінеді.
Dialogue: 0,0:04:03.81,0:04:06.58,日文对话,NTP,0000,0000,0000,,кофемен жұмсақырақ.
Dialogue: 0,0:04:07.11,0:04:08.14,日文对话,NTP,0000,0000,0000,,Үлпілдек?
Dialogue: 0,0:04:09.56,0:04:11.77,日文对话,NTP,0000,0000,0000,,Юйоши-санға да бұл керек пе?
Dialogue: 0,0:04:13.12,0:04:15.09,日文对话,NTP,0000,0000,0000,,Жоқ, мен одан бас тартамын.
Dialogue: 0,0:04:17.71,0:04:18.77,日文对话,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:04:32.00,0:04:34.63,日文对话,NTP,0000,0000,0000,,Бүгін әкеммен
Dialogue: 0,0:04:36.86,0:04:41.59,日文对话,NTP,0000,0000,0000,,Біз таңғы асты бірге іштік.
Dialogue: 0,0:04:41.97,0:04:44.00,日文对话,NTP,0000,0000,0000,,Бұл өте жақсы күн
Dialogue: 0,0:04:44.45,0:04:46.37,日文对话,NTP,0000,0000,0000,,Гимоув дәмді
Dialogue: 0,0:04:46.84,0:04:49.85,日文对话,NTP,0000,0000,0000,,өте өте
Dialogue: 0,0:05:21.31,0:05:22.53,日文对话,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:05:26.15,0:05:26.99,日文对话,NTP,0000,0000,0000,,бара алмайды...
Dialogue: 0,0:05:27.23,0:05:28.27,日文对话,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:05:30.25,0:05:32.06,日文对话,NTP,0000,0000,0000,,Өйткені үлкен көшеде қауіпті
Dialogue: 0,0:05:33.23,0:05:35.44,日文对话,NTP,0000,0000,0000,,Бұл жерден көлік өтуі мүмкін.
Dialogue: 0,0:06:12.47,0:06:15.58,日文对话,NTP,0000,0000,0000,,Ол итпен ойнағандықтан кешіккенін айтты.
Dialogue: 0,0:06:16.14,0:06:16.70,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:06:17.31,0:06:21.59,日文对话,NTP,0000,0000,0000,,Ал, маған дайындық бөлмесін жинауға көмектесуімді өтінді.
Dialogue: 0,0:06:22.06,0:06:23.31,日文对话,NTP,0000,0000,0000,,Жақсы.
Dialogue: 0,0:06:23.79,0:06:27.31,日文对话,NTP,0000,0000,0000,,Жарай ма? Бұл кешіккеннің жалғыз жазасы.
Dialogue: 0,0:06:27.85,0:06:28.94,日文对话,NTP,0000,0000,0000,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:06:29.57,0:06:33.05,日文对话,NTP,0000,0000,0000,,Бұл мектеп бәрібір демалатындай.
Dialogue: 0,0:06:33.34,0:06:36.29,日文对话,NTP,0000,0000,0000,,Мен сабақ беріп жатсам да демалуым керек.
Dialogue: 0,0:06:36.88,0:06:40.01,日文对话,NTP,0000,0000,0000,,Цуцутори мырза мұғалім болғаннан бері,
Dialogue: 0,0:06:40.37,0:06:42.80,日文对话,NTP,0000,0000,0000,,Сіз бұл мектепте көптен бері сабақ бердіңіз бе?
Dialogue: 0,0:06:43.46,0:06:46.23,日文对话,NTP,0000,0000,0000,,Иә, мұғалім болғаннан бері.
Dialogue: 0,0:06:46.76,0:06:48.37,日文对话,NTP,0000,0000,0000,,Сіздің бұрын басқа жұмысыңыз болды ма?
Dialogue: 0,0:06:48.90,0:06:50.11,日文对话,NTP,0000,0000,0000,,Зерттеу жұмысы
Dialogue: 0,0:06:50.59,0:06:53.89,日文对话,NTP,0000,0000,0000,,Бұл мен сабақ беретін химиядан сәл басқа сала болды.
Dialogue: 0,0:06:54.66,0:06:56.93,日文对话,NTP,0000,0000,0000,,Жұмысыңды тастап, мұғалім болдың...
Dialogue: 0,0:06:57.59,0:06:58.13,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:06:59.66,0:07:04.56,日文对话,NTP,0000,0000,0000,,Мен, мен әрқашан бір нәрсені білгім келді, мен тоқтай алмаймын.
Dialogue: 0,0:07:05.21,0:07:07.61,日文对话,NTP,0000,0000,0000,,Нені білгің келді?
Dialogue: 0,0:07:09.74,0:07:12.74,日文对话,NTP,0000,0000,0000,,Осы тапсырманы орындамайынша, сіз білмейтін нәрселер
Dialogue: 0,0:07:15.45,0:07:16.85,日文对话,NTP,0000,0000,0000,,Чанги мырза ше?
Dialogue: 0,0:07:17.31,0:07:18.35,日文对话,NTP,0000,0000,0000,,Мектеп өмірі
Dialogue: 0,0:07:18.87,0:07:19.90,日文对话,NTP,0000,0000,0000,,Бұл қызық
Dialogue: 0,0:07:20.56,0:07:22.76,日文对话,NTP,0000,0000,0000,,Барлығы өте жақсы.
Dialogue: 0,0:07:23.32,0:07:26.26,日文对话,NTP,0000,0000,0000,,Иә, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:07:26.69,0:07:30.24,日文对话,NTP,0000,0000,0000,,Ум... у...
Dialogue: 0,0:07:31.25,0:07:34.18,日文对话,NTP,0000,0000,0000,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:07:34.99,0:07:35.52,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:07:36.57,0:07:38.50,日文对话,NTP,0000,0000,0000,,Әкем маған үнемі айтып отырады
Dialogue: 0,0:07:39.07,0:07:40.74,日文对话,NTP,0000,0000,0000,,Мен…аздап…
Dialogue: 0,0:07:41.27,0:07:43.45,日文对话,NTP,0000,0000,0000,,А, жоқ, мүмкін...
Dialogue: 0,0:07:43.75,0:07:46.13,日文对话,NTP,0000,0000,0000,,Сіз парасаттылықтың не екенін түсінбейтін сияқтысыз.
Dialogue: 0,0:07:46.59,0:07:48.24,日文对话,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:49.13,0:07:49.76,日文对话,NTP,0000,0000,0000,,№ №
Dialogue: 0,0:07:50.16,0:07:53.22,日文对话,NTP,0000,0000,0000,,Сарай мырзаны бәрі жақсы көрсе керек.
Dialogue: 0,0:07:54.37,0:07:55.02,日文对话,NTP,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:08:00.20,0:08:03.07,日文对话,NTP,0000,0000,0000,,Мен де сені жақсы көремін
Dialogue: 0,0:08:04.06,0:08:05.72,日文对话,NTP,0000,0000,0000,,бұл...мұғалім...
Dialogue: 0,0:08:09.92,0:08:13.91,日文对话,NTP,0000,0000,0000,,Сондықтан сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 0,0:08:15.01,0:08:16.71,日文对话,NTP,0000,0000,0000,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:08:29.75,0:08:31.10,日文对话,NTP,0000,0000,0000,,Сайо-чан!
Dialogue: 0,0:08:31.72,0:08:32.79,日文对话,NTP,0000,0000,0000,,Хигучи расталды.
Dialogue: 0,0:08:33.41,0:08:35.65,日文对话,NTP,0000,0000,0000,,Түске дейін ғана.
Dialogue: 0,0:08:35.99,0:08:37.59,日文对话,NTP,0000,0000,0000,,Бір жерге тоқтап, үйге қайтайық.
Dialogue: 0,0:08:37.99,0:08:39.38,日文对话,NTP,0000,0000,0000,,«Бір жерде» деп көбірек айтқан сайын
Dialogue: 0,0:08:39.63,0:08:42.24,日文对话,NTP,0000,0000,0000,,Бұл қаланың таңдау мүмкіндігі бар ма?
Dialogue: 0,0:08:42.99,0:08:45.00,日文对话,NTP,0000,0000,0000,,Юка-чанның қорқытуы?
Dialogue: 0,0:08:45.53,0:08:47.26,日文对话,NTP,0000,0000,0000,,Сонда да бір жерде тоқтағым келеді.
Dialogue: 0,0:08:48.56,0:08:51.94,日文对话,NTP,0000,0000,0000,,Мен жоғары сынып оқушысы сияқты көңіл көтергім келеді.
Dialogue: 0,0:08:52.45,0:08:54.92,日文对话,NTP,0000,0000,0000,,Ноно-сан Нене-сан Ах...жылама
Dialogue: 0,0:08:56.65,0:08:57.87,日文对话,NTP,0000,0000,0000,,Ах...Төраға
Dialogue: 0,0:08:59.38,0:09:00.48,日文对话,NTP,0000,0000,0000,,Қызық, бұл не?
Dialogue: 0,0:09:00.90,0:09:04.01,日文对话,NTP,0000,0000,0000,,Бұрын мен дәмді торттары бар дүкен таба алатынмын.
Dialogue: 0,0:09:04.65,0:09:06.56,日文对话,NTP,0000,0000,0000,,Есіңе түскеніне қуаныштымын.
Dialogue: 0,0:09:06.90,0:09:08.28,日文对话,NTP,0000,0000,0000,,Бұл қайсысы?
Dialogue: 0,0:09:08.94,0:09:10.17,日文对话,NTP,0000,0000,0000,,Гимоув
Dialogue: 0,0:09:10.55,0:09:11.17,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:09:11.74,0:09:14.42,日文对话,NTP,0000,0000,0000,,Бұл Gimauve кафесі туралы болды.
Dialogue: 0,0:09:14.89,0:09:16.82,日文对话,NTP,0000,0000,0000,,Бұл кофехана сияқты.
Dialogue: 0,0:09:17.49,0:09:19.93,日文对话,NTP,0000,0000,0000,,Бұл жалғыз орын, солай ма?
Dialogue: 0,0:09:20.18,0:09:22.08,日文对话,NTP,0000,0000,0000,,Мұнда неге бұлай?
Dialogue: 0,0:09:22.30,0:09:25.07,日文对话,NTP,0000,0000,0000,,Ойын-сауық Ойын-сауық қайда?
Dialogue: 0,0:09:26.23,0:09:29.81,日文对话,NTP,0000,0000,0000,,Жоқ, Чанги мырзаның сол кезде бас тартқанына қуаныштымын.
Dialogue: 0,0:09:30.32,0:09:30.94,日文对话,NTP,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:09:31.80,0:09:33.54,日文对话,NTP,0000,0000,0000,,Мен бастық болып жүрсем де.
Dialogue: 0,0:09:33.86,0:09:35.98,日文对话,NTP,0000,0000,0000,,Мейрамхана болудан аулақпын, мен қарапайыммын.
Dialogue: 0,0:09:36.95,0:09:39.03,日文对话,NTP,0000,0000,0000,,Қаншалықты қарсы тұра алмайтыныңыздың шегі бар
Dialogue: 0,0:09:39.29,0:09:40.53,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:40.75,0:09:44.86,日文对话,NTP,0000,0000,0000,,Енді бәріміз Гимоувқа барып, торт жеп алайық.
Dialogue: 0,0:09:45.62,0:09:46.35,日文对话,NTP,0000,0000,0000,,Торт?
Dialogue: 0,0:09:47.31,0:09:48.99,日文对话,NTP,0000,0000,0000,,Жоғары сынып оқушысы сияқты ма?
Dialogue: 0,0:09:49.38,0:09:50.93,日文对话,NTP,0000,0000,0000,,Бұл мүмкін емес
Dialogue: 0,0:09:51.17,0:09:54.77,日文对话,NTP,0000,0000,0000,,Фумито жасаған тағам шынымен дәмді.
Dialogue: 0,0:09:55.22,0:09:56.16,日文对话,NTP,0000,0000,0000,,Бізге қосылыңыз
Dialogue: 0,0:09:57.74,0:10:00.86,日文对话,NTP,0000,0000,0000,,Гимоув Бұл мүмкін болған сияқты.
Dialogue: 0,0:10:07.14,0:10:10.30,日文对话,NTP,0000,0000,0000,,Сіз шынымен мен күткеннен де асып түстіңіз.
Dialogue: 0,0:10:21.24,0:10:22.93,日文对话,NTP,0000,0000,0000,,Жел жақсы сезінеді.
Dialogue: 0,0:10:23.74,0:10:24.48,日文对话,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:10:25.24,0:10:27.81,日文对话,NTP,0000,0000,0000,,Бұл жақсы сезінеді, бірақ тым ұзақ.
Dialogue: 0,0:10:28.33,0:10:30.87,日文对话,NTP,0000,0000,0000,,Ұзақ тыныштық? Әлде... тыныш деуім керек пе?
Dialogue: 0,0:10:31.17,0:10:32.00,日文对话,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:10:32.30,0:10:33.13,日文对话,NTP,0000,0000,0000,,Шағымдану
Dialogue: 0,0:10:33.26,0:10:35.54,日文对话,NTP,0000,0000,0000,,Ландшафт пен халық тығыздығы өзгермейтін шығар.
Dialogue: 0,0:10:36.84,0:10:39.68,日文对话,NTP,0000,0000,0000,,Бірақ бұл жақсы және тыныш жер.
Dialogue: 0,0:10:41.71,0:10:44.34,日文对话,NTP,0000,0000,0000,,Демек, сіз тым тыныш дейсіз бе?
Dialogue: 0,0:10:44.71,0:10:48.61,日文对话,NTP,0000,0000,0000,,Тыныш болған соң, «Бұл оқиға болды ғой!» деп ойлай бастаймын.
Dialogue: 0,0:10:49.37,0:10:50.23,日文对话,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:10:52.09,0:10:54.51,日文对话,NTP,0000,0000,0000,,Екі Бұл тамаша.
Dialogue: 0,0:10:56.24,0:10:57.90,日文对话,NTP,0000,0000,0000,,Комедияға ұқсайды
Dialogue: 0,0:10:58.19,0:10:59.98,日文对话,NTP,0000,0000,0000,,Кем дегенде, ол кумирге ұқсайды.
Dialogue: 0,0:11:00.23,0:11:01.62,日文对话,NTP,0000,0000,0000,,Бірлік сияқты ма?
Dialogue: 0,0:11:03.41,0:11:05.94,日文对话,NTP,0000,0000,0000,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:11:08.23,0:11:08.78,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:11:10.43,0:11:12.74,日文对话,NTP,0000,0000,0000,,Себебі мен теледидар көрмеймін.
Dialogue: 0,0:11:15.04,0:11:16.53,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:11:17.11,0:11:19.35,日文对话,NTP,0000,0000,0000,,Мен комедиялық немесе эстрадалық шоуларды көрмеймін.
Dialogue: 0,0:11:19.72,0:11:22.42,日文对话,NTP,0000,0000,0000,,Жоқ, менде үйде жоқ.
Dialogue: 0,0:11:22.71,0:11:24.61,日文对话,NTP,0000,0000,0000,,Теледидар жоқ па?
Dialogue: 0,0:11:24.91,0:11:25.46,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:26.05,0:11:28.74,日文对话,NTP,0000,0000,0000,,Бөлмеде демейсіз бе?
Dialogue: 0,0:11:29.23,0:11:30.02,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:30.79,0:11:35.10,日文对话,NTP,0000,0000,0000,,Ол ғибадатханада да, мен тұратын жерде де жоқ...
Dialogue: 0,0:11:35.74,0:11:36.62,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:37.03,0:11:39.21,日文对话,NTP,0000,0000,0000,,Жо...жоғары сынып оқушысы
Dialogue: 0,0:11:39.44,0:11:41.11,日文对话,NTP,0000,0000,0000,,Теледидарсыз өмір
Dialogue: 0,0:11:41.95,0:11:43.44,日文对话,NTP,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:11:43.74,0:11:45.44,日文对话,NTP,0000,0000,0000,,Ешқандай ыңғайсыздық жоқ.
Dialogue: 0,0:11:45.83,0:11:47.19,日文对话,NTP,0000,0000,0000,,Сен үйде не істеп жүрсің?
Dialogue: 0,0:11:47.79,0:11:52.82,日文对话,NTP,0000,0000,0000,,Ғибадатханаға көмектесіп, мектепте үй тапсырмасын орындағаннан кейін...
Dialogue: 0,0:11:53.02,0:11:53.88,日文对话,NTP,0000,0000,0000,,Көңілді ше?
Dialogue: 0,0:11:54.48,0:11:56.02,日文对话,NTP,0000,0000,0000,,Әкемен сөйлесу
Dialogue: 0,0:11:56.67,0:12:00.62,日文对话,NTP,0000,0000,0000,,-дан кейін Гимоувқа бару өте қызықты.
Dialogue: 0,0:12:00.89,0:12:02.68,日文对话,NTP,0000,0000,0000,,Иә, тезірек барайық.
Dialogue: 0,0:12:06.65,0:12:09.22,日文对话,NTP,0000,0000,0000,,Сізді дәмді торт пен кофе күтуде.
Dialogue: 0,0:12:12.42,0:12:14.15,日文对话,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:12:21.55,0:12:23.63,日文对话,NTP,0000,0000,0000,,Сонымен барлығы келді.
Dialogue: 0,0:12:25.96,0:12:27.14,日文对话,NTP,0000,0000,0000,,Өйткені ол дәмді
Dialogue: 0,0:12:27.44,0:12:29.14,日文对话,NTP,0000,0000,0000,,Бірақ бұл өте дәмді
Dialogue: 0,0:12:29.51,0:12:30.58,日文对话,NTP,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:12:31.15,0:12:32.28,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:35.83,0:12:37.51,日文对话,NTP,0000,0000,0000,,Мен тортты ұнатпаймын.
Dialogue: 0,0:12:37.71,0:12:39.10,日文对话,NTP,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:12:41.70,0:12:43.70,日文对话,NTP,0000,0000,0000,,Иә, бұл өте дәмді.
Dialogue: 0,0:12:44.39,0:12:46.13,日文对话,NTP,0000,0000,0000,,Мен оны қалай жасау керектігін білгім келеді.
Dialogue: 0,0:12:46.70,0:12:49.54,日文对话,NTP,0000,0000,0000,,Сіз өз торттарыңызды жасайтын адамсыз ба?
Dialogue: 0,0:12:50.48,0:12:52.61,日文对话,NTP,0000,0000,0000,,Маған жалпы тамақ пісірген ұнайды.
Dialogue: 0,0:12:53.07,0:12:55.52,日文对话,NTP,0000,0000,0000,,О? Сайо-чанға өтініш?
Dialogue: 0,0:12:56.13,0:12:57.17,日文对话,NTP,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:12:57.67,0:13:00.26,日文对话,NTP,0000,0000,0000,,Сіз мұны апелляция ретінде қабылдайсыз деп үміттенемін.
Dialogue: 0,0:13:11.73,0:13:12.95,日文对话,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:13.47,0:13:15.67,日文对话,NTP,0000,0000,0000,,Сайо-чан, қабырғалары биік.
Dialogue: 0,0:13:16.31,0:13:20.20,日文对话,NTP,0000,0000,0000,,Бірақ Токума-сан бізге қосылса жақсы болар еді.
Dialogue: 0,0:13:20.85,0:13:24.62,日文对话,NTP,0000,0000,0000,,Мен сені іздедім, бірақ үйге кіріп, жан-жағыма қарадым.
Dialogue: 0,0:13:25.40,0:13:27.12,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:13:27.67,0:13:29.53,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл ойық болуы керек пе?
Dialogue: 0,0:13:30.06,0:13:32.46,日文对话,NTP,0000,0000,0000,,Немесе оның ағып кетуіне жол берген дұрыс шығар?
Dialogue: 0,0:13:34.05,0:13:35.02,日文对话,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:13:35.58,0:13:37.62,日文对话,NTP,0000,0000,0000,,Бизнеске ашық Кешіріңіз.
Dialogue: 0,0:13:37.98,0:13:39.13,日文对话,NTP,0000,0000,0000,,Ештеңе жоқ
Dialogue: 0,0:13:40.55,0:13:43.46,日文对话,NTP,0000,0000,0000,,Әй, шынында да, төбет дүкенінің иесі
Dialogue: 0,0:13:43.81,0:13:45.75,日文对话,NTP,0000,0000,0000,,Кешеден бері үйге келмеген сияқты.
Dialogue: 0,0:13:46.67,0:13:47.77,日文对话,NTP,0000,0000,0000,,Наубайхана?
Dialogue: 0,0:13:47.99,0:13:49.91,日文对话,NTP,0000,0000,0000,,Ойлап қарасам, бұрын жабылған.
Dialogue: 0,0:14:00.15,0:14:01.39,日文对话,NTP,0000,0000,0000,,Байланыссыз
Dialogue: 0,0:14:02.23,0:14:04.92,日文对话,NTP,0000,0000,0000,,Жас әйел бұрын-соңды мұндай ештеңе болмағанын айтты.
Dialogue: 0,0:14:05.33,0:14:08.01,日文对话,NTP,0000,0000,0000,,Бұл... алаңдатады.
Dialogue: 0,0:14:08.56,0:14:11.54,日文对话,NTP,0000,0000,0000,,Оқиға болуы мүмкін.
Dialogue: 0,0:14:12.37,0:14:15.22,日文对话,NTP,0000,0000,0000,,Көршілерді хабардар еттік.
Dialogue: 0,0:14:15.57,0:14:17.41,日文对话,NTP,0000,0000,0000,,Егер жоспар басталғанда мен бос болсам,
Dialogue: 0,0:14:18.62,0:14:21.98,日文对话,NTP,0000,0000,0000,,Балалар, үйге тезірек баруларың керек.
Dialogue: 0,0:14:22.13,0:14:22.42,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:22.42,0:14:23.55,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:14:23.48,0:14:24.58,日文对话,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:14:34.99,0:14:35.65,日文对话,NTP,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:14:49.13,0:14:50.19,日文对话,NTP,0000,0000,0000,,«Ежелгі»
Dialogue: 0,0:14:53.69,0:14:56.42,日文对话,NTP,0000,0000,0000,,Ол Багуада да кездеседі...
Dialogue: 0,0:14:59.54,0:15:02.35,日文对话,NTP,0000,0000,0000,,Бірақ ол міндетті түрде бүгін кешке келеді.
Dialogue: 0,0:15:23.57,0:15:26.55,日文对话,NTP,0000,0000,0000,,Ол бұрынғыдан басқаша болуы мүмкін.
Dialogue: 0,0:15:30.63,0:15:31.74,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:15:35.97,0:15:37.64,日文对话,NTP,0000,0000,0000,,Қанша күшті болса да
Dialogue: 0,0:15:38.74,0:15:41.11,日文对话,NTP,0000,0000,0000,,Сая саған қалай ойнау керектігін көрсетеді, әке.
Dialogue: 0,0:16:16.73,0:16:17.73,日文对话,NTP,0000,0000,0000,,Сол адам...
Dialogue: 0,0:21:17.87,0:21:24.66,日文对话,NTP,0000,0000,0000,,Уәдеңде тұр
Dialogue: 0,0:21:33.87,0:21:37.76,日文对话,NTP,0000,0000,0000,,Адамдар өзгереді, әрине.
Dialogue: 0,0:21:38.69,0:21:39.58,日文对话,NTP,0000,0000,0000,,Алайда
Dialogue: 0,0:21:40.15,0:21:43.28,日文对话,NTP,0000,0000,0000,,Өзгеретін және өзгермейтін нәрселер бар.
Dialogue: 0,0:21:45.54,0:21:48.84,日文对话,NTP,0000,0000,0000,,Өзгертуге болмайтын негізгі бөлік
Dialogue: 0,0:21:50.84,0:21:52.90,日文对话,NTP,0000,0000,0000,,Егер бұл өзгерсе ше?
Dialogue: 0,0:21:54.14,0:21:56.78,日文对话,NTP,0000,0000,0000,,Бұл бұрынғы адам ба?
Dialogue: 0,0:21:58.65,0:22:05.43,日文对话,NTP,0000,0000,0000,,Жоқ.Оған дейін «іргелі» нені өзгертеді?
Dialogue: 0,0:22:07.88,0:22:10.46,日文对话,NTP,0000,0000,0000,,Бұл болғалы тұр...
Dialogue: 0,0:23:47.82,0:24:12.86,强调,NTP,0000,0000,0000,,Ескерту
Dialogue: 0,0:23:47.82,0:23:50.39,日文对话,NTP,0000,0000,0000,,Токима-сан, түскі асыңды іше алмайсың ба?
Dialogue: 0,0:23:50.79,0:23:52.27,日文对话,NTP,0000,0000,0000,,Тамақтан гөрі ұйықтаған жақсы
Dialogue: 0,0:23:52.44,0:23:54.41,日文对话,NTP,0000,0000,0000,,Аш қалма.
Dialogue: 0,0:23:54.41,0:23:55.63,日文对话,NTP,0000,0000,0000,,Бұл мені қынжылтады.
Dialogue: 0,0:23:57.34,0:23:59.27,日文对话,NTP,0000,0000,0000,,Сіз қызықсыз.
Dialogue: 0,0:23:59.82,0:24:01.73,日文对话,NTP,0000,0000,0000,,Керемет атмосфера.
Dialogue: 0,0:24:02.28,0:24:04.17,日文对话,NTP,0000,0000,0000,,Шынайы Жақсы атмосфера
Dialogue: 0,0:24:04.74,0:24:06.85,日文对话,NTP,0000,0000,0000,,Осы қарқынмен біз қиындыққа тап болуымыз мүмкін.
Dialogue: 0,0:24:07.06,0:24:09.25,日文对话,NTP,0000,0000,0000,,Мен бұған шыдамаймын.
Dialogue: 0,0:24:09.69,0:24:11.25,日文对话,NTP,0000,0000,0000,,Ах, мен сені кешірдім.
Dialogue: 0,0:24:11.78,0:24:12.22,日文对话,NTP,0000,0000,0000,,Е...
Dialogue: 0,0:24:12.86,0:24:16.33,日文对话,NTP,0000,0000,0000,,Келесі жолы BLOOD-C Нагекето
Dialogue: 0,0:24:17.83,0:24:23.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory