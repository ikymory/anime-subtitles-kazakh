Dialogue: 0,0:01:29.94,0:01:39.95,disclaimer（免责声明）,NTP,0000,0000,0000,,Бұл субтитр көзі субтитр тобы (www.kamigami.org) өндіру, жеткізу алмасуды үйрену, коммерциялық пайдалану үшін тыйым салынған
Dialogue: 0,0:01:29.94,0:01:39.95,staff（制作成员表）,NTP,0000,0000,0000,,---Құдай субтитрлері---
Dialogue: 0,0:01:29.94,0:01:39.95,staff（制作成员表）,NTP,0000,0000,0000,,&
Dialogue: 0,0:04:51.47,0:04:54.48,title（标题）,NTP,0000,0000,0000,,11 эпизод «Мүмкін тұздық»
Dialogue: 0,0:01:51.21,0:01:55.37,JP（日文对话）,NTP,0000,0000,0000,,Енді, Сайо-чан, біз көп нәрсені шайқауға тырыстық.
Dialogue: 0,0:01:55.53,0:01:56.99,JP（日文对话）,NTP,0000,0000,0000,,Мен жақында ораламын.
Dialogue: 0,0:01:57.41,0:01:58.47,JP（日文对话）,NTP,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:01:58.79,0:02:02.31,JP（日文对话）,NTP,0000,0000,0000,,«Қайттың ба, бәрі есіңде ме?» деп ойласаң да.
Dialogue: 0,0:02:02.67,0:02:04.54,JP（日文对话）,NTP,0000,0000,0000,,Мен қайтадан ұмытып кетемін.
Dialogue: 0,0:02:05.11,0:02:06.06,JP（日文对话）,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:07.33,0:02:10.03,JP（日文对话）,NTP,0000,0000,0000,,Сондықтан мен тоқтайық дедім.
Dialogue: 0,0:02:10.57,0:02:12.45,JP（日文对话）,NTP,0000,0000,0000,,Бір нәрсені қайталау
Dialogue: 0,0:02:13.88,0:02:16.92,JP（日文对话）,NTP,0000,0000,0000,,Жаз басталғаннан бері
Dialogue: 0,0:02:17.04,0:02:19.42,JP（日文对话）,NTP,0000,0000,0000,,Өйткені мен бұл фарспен бірге жүрдім.
Dialogue: 0,0:02:19.70,0:02:20.94,JP（日文对话）,NTP,0000,0000,0000,,Жетеді.
Dialogue: 0,0:02:21.41,0:02:23.71,JP（日文对话）,NTP,0000,0000,0000,,Жаздан
Dialogue: 0,0:02:24.15,0:02:26.55,JP（日文对话）,NTP,0000,0000,0000,,Сіз әлі бірдеңе бердіңіз бе?
Dialogue: 0,0:02:27.49,0:02:29.33,JP（日文对话）,NTP,0000,0000,0000,,Бұл ойын жазғы ойын.
Dialogue: 0,0:02:29.92,0:02:34.44,JP（日文对话）,NTP,0000,0000,0000,,Дәлел - бұл Санкей академиясының қысқы формасы емес.
Dialogue: 0,0:02:36.00,0:02:39.04,JP（日文对话）,NTP,0000,0000,0000,,Ой, мен таң қалдым, Сайо-чан.
Dialogue: 0,0:02:39.49,0:02:42.05,JP（日文对话）,NTP,0000,0000,0000,,Таң қалсаң да есіңе түспейді.
Dialogue: 0,0:02:42.71,0:02:46.97,JP（日文对话）,NTP,0000,0000,0000,,Бастауыш және орта мектептегі бірыңғай мектеп формасы
Dialogue: 0,0:02:47.85,0:02:53.46,JP（日文对话）,NTP,0000,0000,0000,,Жоқ. Бірінші курстағы сыныптастарыңды да есіңе түсіре алмайсың.
Dialogue: 0,0:02:53.67,0:02:57.63,JP（日文对话）,NTP,0000,0000,0000,,Өйткені мұндай нәрсе жоқ.
Dialogue: 0,0:02:58.54,0:03:01.58,JP（日文对话）,NTP,0000,0000,0000,,Мүмкін мен оны кейінірек жасауды жоспарлаған шығармын.
Dialogue: 0,0:03:02.02,0:03:03.87,JP（日文对话）,NTP,0000,0000,0000,,Қайта жалғастырғыңыз келсе.
Dialogue: 0,0:03:05.57,0:03:06.34,JP（日文对话）,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:03:06.44,0:03:07.10,JP（日文对话）,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:03:07.42,0:03:08.22,JP（日文对话）,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:03:08.39,0:03:10.59,JP（日文对话）,NTP,0000,0000,0000,,Анаңның жолын қу
Dialogue: 0,0:03:10.91,0:03:13.04,JP（日文对话）,NTP,0000,0000,0000,,Осы киелі жердің әулие қызы болсаң.
Dialogue: 0,0:03:13.52,0:03:15.00,JP（日文对话）,NTP,0000,0000,0000,,Сенің анаңның аты кім?
Dialogue: 0,0:03:16.21,0:03:17.99,JP（日文对话）,NTP,0000,0000,0000,,Отбасылық суретке түсіру
Dialogue: 0,0:03:19.35,0:03:22.64,JP（日文对话）,NTP,0000,0000,0000,,Әкеңізбен қандай естеліктеріңіз бар?
Dialogue: 0,0:03:23.30,0:03:24.99,JP（日文对话）,NTP,0000,0000,0000,,Ештеңе болмайды.
Dialogue: 0,0:03:27.27,0:03:30.31,JP（日文对话）,NTP,0000,0000,0000,,Менмін менмін
Dialogue: 0,0:03:30.38,0:03:31.81,JP（日文对话）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:32.26,0:03:35.57,JP（日文对话）,NTP,0000,0000,0000,,Киім ауыстыру Сая
Dialogue: 0,0:03:36.04,0:03:37.88,JP（日文对话）,NTP,0000,0000,0000,,Киім ауыстыру Эй
Dialogue: 0,0:03:40.58,0:03:41.57,JP（日文对话）,NTP,0000,0000,0000,,Күлкілі
Dialogue: 0,0:03:41.61,0:03:45.32,JP（日文对话）,NTP,0000,0000,0000,,Дәлірек айтқанда, бұл фамилияны қолдануға рұқсат бергені біртүрлі.
Dialogue: 0,0:03:47.44,0:03:52.17,JP（日文对话）,NTP,0000,0000,0000,,Әй, мен «киім ауыстыру» дегенді білемін.
Dialogue: 0,0:03:53.87,0:03:54.72,JP（日文对话）,NTP,0000,0000,0000,,Мағынасы
Dialogue: 0,0:03:55.34,0:03:59.10,JP（日文对话）,NTP,0000,0000,0000,,Киім ауыстыру дегеніміз - киім ауыстыру.
Dialogue: 0,0:04:00.08,0:04:02.55,JP（日文对话）,NTP,0000,0000,0000,,Басыңыздың мазмұнын өзгерткен сізге
Dialogue: 0,0:04:02.87,0:04:04.27,JP（日文对话）,NTP,0000,0000,0000,,Бұл тамаша фамилия.
Dialogue: 0,0:04:04.87,0:04:07.38,JP（日文对话）,NTP,0000,0000,0000,,Айтыңызшы, Чанги мырза.
Dialogue: 0,0:04:09.12,0:04:10.43,JP（日文对话）,NTP,0000,0000,0000,,Жоқ Сайо
Dialogue: 0,0:04:11.26,0:04:13.94,JP（日文对话）,NTP,0000,0000,0000,,Басыңыздың мазмұны ауыстырылса да
Dialogue: 0,0:04:14.67,0:04:16.57,JP（日文对话）,NTP,0000,0000,0000,,Мұнда өзгермейтіндер үшін
Dialogue: 0,0:04:19.34,0:04:21.29,JP（日文对话）,NTP,0000,0000,0000,,Мен көбейттім
Dialogue: 0,0:04:29.98,0:04:32.95,JP（日文对话）,NTP,0000,0000,0000,,Бізге бәрібір.
Dialogue: 0,0:04:33.31,0:04:37.21,JP（日文对话）,NTP,0000,0000,0000,,Мен тезірек ескі өміріме оралғым келеді.
Dialogue: 0,0:04:38.48,0:04:39.89,JP（日文对话）,NTP,0000,0000,0000,,Сіз де солай ойлайсыз.
Dialogue: 0,0:04:47.58,0:04:50.63,JP（日文对话）,NTP,0000,0000,0000,,Токима мырза
Dialogue: 0,0:04:55.97,0:04:59.13,JP（日文对话）,NTP,0000,0000,0000,,Цк, мен мұны тез шешемін.
Dialogue: 0,0:04:59.18,0:05:00.38,JP（日文对话）,NTP,0000,0000,0000,,Мен ақша алғым келеді
Dialogue: 0,0:05:00.66,0:05:02.57,JP（日文对话）,NTP,0000,0000,0000,,Бұл түсінікті
Dialogue: 0,0:05:03.53,0:05:05.11,JP（日文对话）,NTP,0000,0000,0000,,Сізге де солай.
Dialogue: 0,0:05:05.26,0:05:06.42,JP（日文对话）,NTP,0000,0000,0000,,Біз
Dialogue: 0,0:05:06.59,0:05:08.56,JP（日文对话）,NTP,0000,0000,0000,,Бұл жұмысқа орналасу үшін тиімді.
Dialogue: 0,0:05:08.66,0:05:11.03,JP（日文对话）,NTP,0000,0000,0000,,Қарашы, мен болашаққа алаңдаймын.
Dialogue: 0,0:05:11.33,0:05:13.55,JP（日文对话）,NTP,0000,0000,0000,,Осы жоспарды орындау
Dialogue: 0,0:05:13.92,0:05:16.76,JP（日文对话）,NTP,0000,0000,0000,,Негізгі топ мүшелері жұмысқа орналасуға алаңдай ма?
Dialogue: 0,0:05:17.87,0:05:19.38,JP（日文对话）,NTP,0000,0000,0000,,Негізгі актерлер
Dialogue: 0,0:05:20.46,0:05:23.03,JP（日文对话）,NTP,0000,0000,0000,,Иә, біз негізгі актерлерміз.
Dialogue: 0,0:05:23.57,0:05:26.85,JP（日文对话）,NTP,0000,0000,0000,,Екеуміз және Шиничиро Токима
Dialogue: 0,0:05:27.25,0:05:30.19,JP（日文对话）,NTP,0000,0000,0000,,Юка Амино мен Ицуки Саясодан кейін
Dialogue: 0,0:05:31.82,0:05:35.14,JP（日文对话）,NTP,0000,0000,0000,,Және Канако Цуцутори.
Dialogue: 0,0:05:35.97,0:05:37.81,JP（日文对话）,NTP,0000,0000,0000,,Қалғандардың барлығы қосымша.
Dialogue: 0,0:05:38.12,0:05:40.97,JP（日文对话）,NTP,0000,0000,0000,,Ах, өйткені біз тіріміз.
Dialogue: 0,0:05:41.45,0:05:43.22,JP（日文对话）,NTP,0000,0000,0000,,Басқаша ойламаңыз.
Dialogue: 0,0:05:43.60,0:05:46.20,JP（日文对话）,NTP,0000,0000,0000,,Дұрыс, біз басты кейіпкерлер ерекшеміз.
Dialogue: 0,0:05:46.51,0:05:49.03,JP（日文对话）,NTP,0000,0000,0000,,Бұл жиіркенішті нәрсе сізге шабуыл жасауға жол бермеңіз
Dialogue: 0,0:05:49.94,0:05:51.55,JP（日文对话）,NTP,0000,0000,0000,,Мен де осындай нәрсені алдым
Dialogue: 0,0:05:53.77,0:05:57.89,JP（日文对话）,NTP,0000,0000,0000,,Содан кейін басқа қала тұрғындары
Dialogue: 0,0:05:58.58,0:06:00.45,JP（日文对话）,NTP,0000,0000,0000,,Ол өлді, солай ма?
Dialogue: 0,0:06:04.48,0:06:06.68,JP（日文对话）,NTP,0000,0000,0000,,Бұл өте қызық болды
Dialogue: 0,0:06:07.35,0:06:09.28,JP（日文对话）,NTP,0000,0000,0000,,Шынымды айтсам, мен одан шаршадым.
Dialogue: 0,0:06:09.49,0:06:12.58,JP（日文对话）,NTP,0000,0000,0000,,Айырбастау шарттарын ескерсек те, бұл тым ұзақ.
Dialogue: 0,0:06:14.83,0:06:17.11,JP（日文对话）,NTP,0000,0000,0000,,Сіздің табысқа жету ақысы қандай?
Dialogue: 0,0:06:17.39,0:06:20.29,JP（日文对话）,NTP,0000,0000,0000,,Жоқ, мені қуып жібер.
Dialogue: 0,0:06:20.65,0:06:23.54,JP（日文对话）,NTP,0000,0000,0000,,Егер бұл анықталса, сіз жұмысқа орналаса аласыз.
Dialogue: 0,0:06:24.06,0:06:26.44,JP（日文对话）,NTP,0000,0000,0000,,Табиғи өсу қауіпті сезінеді.
Dialogue: 0,0:06:26.91,0:06:31.86,JP（日文对话）,NTP,0000,0000,0000,,Ол ешқашан болмайтын нәрсені жасайтынын айтты.
Dialogue: 0,0:06:32.08,0:06:33.07,JP（日文对话）,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:06:33.96,0:06:35.85,JP（日文对话）,NTP,0000,0000,0000,,Сіз қылмыс жасадыңыз ба?
Dialogue: 0,0:06:36.50,0:06:39.71,JP（日文对话）,NTP,0000,0000,0000,,Мен қосымшалардың өлетін жерін білдім.
Dialogue: 0,0:06:39.78,0:06:41.33,JP（日文对话）,NTP,0000,0000,0000,,Саған ешкім көмектескен жоқ.
Dialogue: 0,0:06:41.49,0:06:42.48,JP（日文对话）,NTP,0000,0000,0000,,Керісінше
Dialogue: 0,0:06:42.55,0:06:45.51,JP（日文对话）,NTP,0000,0000,0000,,Батыр қызға жақындаған қылмыскер - дәмді бюрократ.
Dialogue: 0,0:06:45.64,0:06:46.74,JP（日文对话）,NTP,0000,0000,0000,,Көңілді болса керек
Dialogue: 0,0:06:46.77,0:06:47.65,JP（日文对话）,NTP,0000,0000,0000,,Мұны жасамаңыз.
Dialogue: 0,0:06:48.25,0:06:51.29,JP（日文对话）,NTP,0000,0000,0000,,Кәне, балалар, тыныш болыңдар.
Dialogue: 0,0:06:52.55,0:06:54.17,JP（日文对话）,NTP,0000,0000,0000,,Сая қиналып қалған болуы керек.
Dialogue: 0,0:06:56.84,0:06:59.20,JP（日文对话）,NTP,0000,0000,0000,,Маған көп қиналған ұстаз
Dialogue: 0,0:06:59.26,0:07:01.65,JP（日文对话）,NTP,0000,0000,0000,,А, мұғалім емес пе?
Dialogue: 0,0:07:04.55,0:07:05.52,JP（日文对话）,NTP,0000,0000,0000,,әкелінді
Dialogue: 0,0:07:06.40,0:07:06.97,JP（日文对话）,NTP,0000,0000,0000,,О
Dialogue: 0,0:07:09.24,0:07:10.68,JP（日文对话）,NTP,0000,0000,0000,,Эй, не?
Dialogue: 0,0:07:20.49,0:07:21.99,JP（日文对话）,NTP,0000,0000,0000,,Нене Бұл не?
Dialogue: 0,0:07:22.59,0:07:23.32,JP（日文对话）,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:07:23.65,0:07:25.75,JP（日文对话）,NTP,0000,0000,0000,,Керемет айтыңызшы
Dialogue: 0,0:07:25.83,0:07:28.16,JP（日文对话）,NTP,0000,0000,0000,,Мен оны шынымен қабылдайды деп ойламадым.
Dialogue: 0,0:07:28.91,0:07:29.74,JP（日文对话）,NTP,0000,0000,0000,,Сіз мұны қалай жасадыңыз?
Dialogue: 0,0:07:30.96,0:07:33.51,JP（日文对话）,NTP,0000,0000,0000,,Шабуыл жасап, қашып кету
Dialogue: 0,0:07:34.15,0:07:35.79,JP（日文对话）,NTP,0000,0000,0000,,Е... бұл шынымен мүмкін емес.
Dialogue: 0,0:07:36.02,0:07:38.44,JP（日文对话）,NTP,0000,0000,0000,,Мен оған тиісе алмаймын. Бұл мүмкін емес.
Dialogue: 0,0:07:39.36,0:07:42.59,JP（日文对话）,NTP,0000,0000,0000,,Маған да ұнамайды, бірақ...
Dialogue: 0,0:07:43.60,0:07:46.07,JP（日文对话）,NTP,0000,0000,0000,,Мен енді бұл жігіттермен ештеңе істегім келмейді.
Dialogue: 0,0:07:47.08,0:07:48.58,JP（日文对话）,NTP,0000,0000,0000,,Мұндай құбыжық
Dialogue: 0,0:07:51.95,0:07:54.79,JP（日文对话）,NTP,0000,0000,0000,,Енді оны Сая ішсін.
Dialogue: 0,0:07:55.11,0:07:56.47,JP（日文对话）,NTP,0000,0000,0000,,Уақыт қозғала бастайды
Dialogue: 0,0:07:57.20,0:08:01.03,JP（日文对话）,NTP,0000,0000,0000,,Қандай қорытындыға келсеңіз де, бәрі жақсы.
Dialogue: 0,0:08:02.02,0:08:02.98,JP（日文对话）,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:08:03.55,0:08:04.14,JP（日文对话）,NTP,0000,0000,0000,,О
Dialogue: 0,0:08:16.34,0:08:19.12,JP（日文对话）,NTP,0000,0000,0000,,Жүр, іш, Сая.
Dialogue: 0,0:08:24.34,0:08:27.47,JP（日文对话）,NTP,0000,0000,0000,,Ежелгі дейтіндердің қаны
Dialogue: 0,0:09:16.43,0:09:18.38,JP（日文对话）,NTP,0000,0000,0000,,Сіз шынымен күштісіз.
Dialogue: 0,0:09:19.98,0:09:21.57,JP（日文对话）,NTP,0000,0000,0000,,Мен өсектен естігенімдей.
Dialogue: 0,0:09:22.38,0:09:24.94,JP（日文对话）,NTP,0000,0000,0000,,Мен АҚШ әскері мен Жапония үкіметінің мұны неге жасырғысы келетінін түсінемін.
Dialogue: 0,0:09:26.60,0:09:31.21,JP（日文对话）,NTP,0000,0000,0000,,Сая адам пішінді адам емес
Dialogue: 0,0:09:45.95,0:09:49.36,JP（日文对话）,NTP,0000,0000,0000,,Мүмкін бұл күш адам болмағандықтан шығар?
Dialogue: 0,0:09:50.13,0:09:54.00,JP（日文对话）,NTP,0000,0000,0000,,Әлде сенің жүріп өткен жолыңнан ба?
Dialogue: 0,0:09:55.68,0:09:57.07,JP（日文对话）,NTP,0000,0000,0000,,Мен білгім келеді
Dialogue: 0,0:09:59.09,0:10:01.19,JP（日文对话）,NTP,0000,0000,0000,,Мен сені қалаймын Сая
Dialogue: 0,0:10:02.59,0:10:07.22,JP（日文对话）,NTP,0000,0000,0000,,Ол үшін алдымен сені ұйықтатуым керек.
Dialogue: 0,0:10:24.64,0:10:27.92,JP（日文对话）,NTP,0000,0000,0000,,Мен күткендей, қан ішкеннен кейін бірден есіме түсті.
Dialogue: 0,0:10:28.66,0:10:31.02,JP（日文对话）,NTP,0000,0000,0000,,Беттері Сол кездегідей.
Dialogue: 0,0:10:31.13,0:10:34.09,JP（日文对话）,NTP,0000,0000,0000,,Сол жиіркенішті адамның қанын ішкенім рас.
Dialogue: 0,0:10:34.24,0:10:35.56,JP（日文对话）,NTP,0000,0000,0000,,Ашық қызыл түске айналады.
Dialogue: 0,0:10:35.99,0:10:37.62,JP（日文对话）,NTP,0000,0000,0000,,Бұл мені таң қалдырды, солай емес пе?
Dialogue: 0,0:10:37.94,0:10:41.45,JP（日文对话）,NTP,0000,0000,0000,,Қараңдаршы, маған шабуыл жасап, қашып кеткенде.
Dialogue: 0,0:10:41.87,0:10:44.86,JP（日文对话）,NTP,0000,0000,0000,,Сайо: Сол жиіркенішті нәрсені жеңгеннен кейін.
Dialogue: 0,0:10:45.27,0:10:46.86,JP（日文对话）,NTP,0000,0000,0000,,Қан сора бастайды.
Dialogue: 0,0:11:44.50,0:11:47.14,JP（日文对话）,NTP,0000,0000,0000,,Бірақ бұл әдемі, солай емес пе?
Dialogue: 0,0:11:51.45,0:11:55.24,JP（日文对话）,NTP,0000,0000,0000,,Аңыздар мен мифтерде кездесетін адам емес адамдар әдетте әдемі болады.
Dialogue: 0,0:11:55.64,0:11:57.97,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:58.54,0:12:00.57,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:01.27,0:12:02.45,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:03.09,0:12:05.83,JP（日文对话）,NTP,0000,0000,0000,,Мен бастапқыда Хякунин Исшуды зерттедім.
Dialogue: 0,0:12:06.20,0:12:08.28,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:08.50,0:12:10.82,JP（日文对话）,NTP,0000,0000,0000,,Әртүрлі жұмбақтар жасырылады.
Dialogue: 0,0:12:10.94,0:12:12.62,JP（日文对话）,NTP,0000,0000,0000,,Тек ақымақ ескі әндер емес
Dialogue: 0,0:12:13.42,0:12:15.58,JP（日文对话）,NTP,0000,0000,0000,,Құпия сақталуы тиіс құпиялар мен қауіптер
Dialogue: 0,0:12:15.73,0:12:17.53,JP（日文对话）,NTP,0000,0000,0000,,Түрлі әндермен араласқан
Dialogue: 0,0:12:18.08,0:12:21.19,JP（日文对话）,NTP,0000,0000,0000,,Сая мен сені сол жерден таптым.
Dialogue: 0,0:12:21.68,0:12:24.62,JP（日文对话）,NTP,0000,0000,0000,,Мен бірден мамандығымды ауыстырып, зерттедім.
Dialogue: 0,0:12:24.85,0:12:26.03,JP（日文对话）,NTP,0000,0000,0000,,Бірақ ол жұмбақтарға толы
Dialogue: 0,0:12:26.57,0:12:28.47,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:28.82,0:12:30.84,JP（日文对话）,NTP,0000,0000,0000,,Бұл өте күшті және әдемі.
Dialogue: 0,0:12:31.04,0:12:32.96,JP（日文对话）,NTP,0000,0000,0000,,Сіз Құдайға жақын нәрсесіз
Dialogue: 0,0:12:33.38,0:12:36.96,JP（日文对话）,NTP,0000,0000,0000,,Ол сол құбыжықтардан мүлде бөлек, жоғары дәрежелі жан.
Dialogue: 0,0:12:39.05,0:12:40.57,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:40.72,0:12:42.67,JP（日文对话）,NTP,0000,0000,0000,,Бұл жігіттер қосымшалар
Dialogue: 0,0:12:42.98,0:12:44.59,JP（日文对话）,NTP,0000,0000,0000,,Сайо-чан керемет
Dialogue: 0,0:12:45.33,0:12:46.48,JP（日文对话）,NTP,0000,0000,0000,,Сценарийді былай қойғанда
Dialogue: 0,0:12:46.73,0:12:49.75,JP（日文对话）,NTP,0000,0000,0000,,Көрініп жатқан басты кейіпкер мен ол туралы тіпті білмеймін.
Dialogue: 0,0:12:50.36,0:12:53.55,JP（日文对话）,NTP,0000,0000,0000,,Бірақ мұны істегеннен кейін,
Dialogue: 0,0:12:53.68,0:12:55.85,JP（日文对话）,NTP,0000,0000,0000,,Сіз мүлдем ұмытыласыз.
Dialogue: 0,0:12:56.71,0:13:00.65,JP（日文对话）,NTP,0000,0000,0000,,Бұл экспериментке жауапты адам шешетін ереже.
Dialogue: 0,0:13:01.26,0:13:03.11,JP（日文对话）,NTP,0000,0000,0000,,Жалған естеліктер отырғызу
Dialogue: 0,0:13:03.68,0:13:06.56,JP（日文对话）,NTP,0000,0000,0000,,Егер сіз қайтып оралғыңыз келсе, қолыңыздан келгеннің бәрін жасаңыз.
Dialogue: 0,0:13:07.50,0:13:11.58,JP（日文对话）,NTP,0000,0000,0000,,Мен мұны мәңгі жасай беруім керек және кездейсоқ қыз болып қалуым керек пе?
Dialogue: 0,0:13:12.17,0:13:15.61,JP（日文对话）,NTP,0000,0000,0000,,Саяға қайтады ма?
Dialogue: 0,0:13:17.03,0:13:18.79,JP（日文对话）,NTP,0000,0000,0000,,Неліктен мұндай қиындыққа бару керек?
Dialogue: 0,0:13:19.38,0:13:23.50,JP（日文对话）,NTP,0000,0000,0000,,Енді мұны осы ойынды ойлап тапқан адам ғана түсіне алады.
Dialogue: 0,0:13:25.84,0:13:30.19,JP（日文对话）,NTP,0000,0000,0000,,-де мұғалім бұл ойынға енді қатыспауды шешті.
Dialogue: 0,0:13:30.39,0:13:32.85,JP（日文对话）,NTP,0000,0000,0000,,Сіз бізді және Токуманы шақырдыңыз.
Dialogue: 0,0:13:33.35,0:13:35.37,JP（日文对话）,NTP,0000,0000,0000,,Бүгінгі «Нағыз ұстаз» кезегі
Dialogue: 0,0:13:35.72,0:13:37.60,JP（日文对话）,NTP,0000,0000,0000,,Гимаувте Сайо-чанмен сөйлесіңіз
Dialogue: 0,0:13:37.69,0:13:39.55,JP（日文对话）,NTP,0000,0000,0000,,Менің ойымша, бұл оны шайқау үшін болды.
Dialogue: 0,0:13:40.04,0:13:40.63,JP（日文对话）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:41.06,0:13:44.31,JP（日文对话）,NTP,0000,0000,0000,,Жарайды, солай ма? Сосын сен осында келдің.
Dialogue: 0,0:13:44.78,0:13:47.40,JP（日文对话）,NTP,0000,0000,0000,,Мен мұның да шайқау екенін түсіндіремін.
Dialogue: 0,0:13:47.81,0:13:51.37,JP（日文对话）,NTP,0000,0000,0000,,Сонымен қатар, қоймадағы бақылау камерасы қосулы болды.
Dialogue: 0,0:13:51.62,0:13:53.05,JP（日文对话）,NTP,0000,0000,0000,,Жасаңыз
Dialogue: 0,0:13:53.84,0:13:55.47,JP（日文对话）,NTP,0000,0000,0000,,Канако мырза күткендей
Dialogue: 0,0:13:55.82,0:13:57.96,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:58.85,0:14:00.09,JP（日文对话）,NTP,0000,0000,0000,,Бұл бүркеншік ат
Dialogue: 0,0:14:00.46,0:14:01.67,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:02.13,0:14:03.47,JP（日文对话）,NTP,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:14:03.99,0:14:06.09,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:06.38,0:14:07.84,JP（日文对话）,NTP,0000,0000,0000,,Мұнда көп адам болуы мүмкін емес.
Dialogue: 0,0:14:09.11,0:14:12.71,JP（日文对话）,NTP,0000,0000,0000,,Бұл жобаға не қатысқыңыз келді?
Dialogue: 0,0:14:16.26,0:14:18.13,JP（日文对话）,NTP,0000,0000,0000,,Өйткені мен шынайы нәрсені көргім келді.
Dialogue: 0,0:14:19.52,0:14:21.19,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:22.30,0:14:26.50,JP（日文对话）,NTP,0000,0000,0000,,Мен әрқашан ескі өмірбаяндар мен мифтерге қызығатынмын.
Dialogue: 0,0:14:27.54,0:14:30.70,JP（日文对话）,NTP,0000,0000,0000,,Бірақ менде шындықты көруге мүмкіндігім жоқ.
Dialogue: 0,0:14:31.74,0:14:35.19,JP（日文对话）,NTP,0000,0000,0000,,Менің бұл қалаға келу себебім, мен шынайы нәрсені көргім келді.
Dialogue: 0,0:14:36.28,0:14:39.60,JP（日文对话）,NTP,0000,0000,0000,,Мынау өтірік емес, нағыз Шушокүмен.
Dialogue: 0,0:14:40.15,0:14:41.05,JP（日文对话）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:41.24,0:14:43.17,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:44.02,0:14:46.42,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:47.04,0:14:51.09,JP（日文对话）,NTP,0000,0000,0000,,Басқаша айтқанда, бұл адамдарды жеуге рұқсат.
Dialogue: 0,0:14:52.82,0:14:54.05,JP（日文对话）,NTP,0000,0000,0000,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:14:55.44,0:14:57.41,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:57.96,0:14:59.55,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:59.68,0:15:03.87,JP（日文对话）,NTP,0000,0000,0000,,Академик ортада қатал ақсақал мені қанша келеке етсе де,
Dialogue: 0,0:15:04.52,0:15:07.41,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:08.22,0:15:13.22,JP（日文对话）,NTP,0000,0000,0000,,Өйткені Сая және сіз айтып отырған көне нәрсе
Dialogue: 0,0:15:13.61,0:15:15.44,JP（日文对话）,NTP,0000,0000,0000,,Ол шынымен де болған
Dialogue: 0,0:15:19.37,0:15:23.14,JP（日文对话）,NTP,0000,0000,0000,,Мен бұл ақымақ эксперимент тез бітеді деп ойладым.
Dialogue: 0,0:15:23.73,0:15:28.14,JP（日文对话）,NTP,0000,0000,0000,,Сол адам, жоқ, ол адам.
Dialogue: 0,0:15:28.86,0:15:30.75,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:30.79,0:15:33.96,JP（日文对话）,NTP,0000,0000,0000,,Мені талай рет дәрі-дәрмекпен, ұсыныстармен Саяға қайтарды.
Dialogue: 0,0:15:34.88,0:15:35.90,JP（日文对话）,NTP,0000,0000,0000,,Тек мен және жіптерім ғана жанып кеткен жоқ па?
Dialogue: 0,0:15:36.61,0:15:40.66,JP（日文对话）,NTP,0000,0000,0000,,Қалыпты болған соң, мен саған Шушокүменнің тұрған жерін табуға рұқсат етемін.
Dialogue: 0,0:15:40.93,0:15:44.39,JP（日文对话）,NTP,0000,0000,0000,,Кел, көненің қанын көбірек іш.
Dialogue: 0,0:15:45.21,0:15:47.98,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:59.15,0:16:03.05,JP（日文对话）,NTP,0000,0000,0000,,Анестезия күшіне енсе де, тез оянатын сияқты.
Dialogue: 0,0:16:04.61,0:16:06.87,JP（日文对话）,NTP,0000,0000,0000,,Бірақ мен оның кем дегенде бір рет жұмыс істегеніне қуаныштымын.
Dialogue: 0,0:16:07.84,0:16:12.26,JP（日文对话）,NTP,0000,0000,0000,,Әйтпесе, ол да сені ұстап алуы қиын еді.
Dialogue: 0,0:16:13.05,0:16:16.41,JP（日文对话）,NTP,0000,0000,0000,,Бірақ мен оның қайтадан зорлық көрсеткенін қаламаймын.
Dialogue: 0,0:16:17.32,0:16:18.26,JP（日文对话）,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:16:27.37,0:16:31.43,JP（日文对话）,NTP,0000,0000,0000,,Жарайды, мен бәрін алып тастаймын деп кейіп танытпаймын.
Dialogue: 0,0:16:32.46,0:16:34.10,JP（日文对话）,NTP,0000,0000,0000,,Бұл сенің асыл қаның.
Dialogue: 0,0:16:34.78,0:16:36.51,JP（日文对话）,NTP,0000,0000,0000,,Мен оны абайлап қолданамын.
Dialogue: 0,0:16:37.69,0:16:40.88,JP（日文对话）,NTP,0000,0000,0000,,Иә, мен оны алдымен оған беруім керек.
Dialogue: 0,0:16:41.84,0:16:45.02,JP（日文对话）,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:46.06,0:16:51.91,JP（日文对话）,NTP,0000,0000,0000,,Сая, мен саған тамақ ұсынсам ба деп ойладым.
Dialogue: 0,0:17:04.77,0:17:09.50,JP（日文对话）,NTP,0000,0000,0000,,Күрсін, мен бұл ақымақ комедиялық өмірден құтыла аламын.
Dialogue: 0,0:17:09.91,0:17:13.59,JP（日文对话）,NTP,0000,0000,0000,,Маған өте қызықты болды. Форма сүйкімді.
Dialogue: 0,0:17:13.88,0:17:16.18,JP（日文对话）,NTP,0000,0000,0000,,Біріншіден, форма кию мүмкін емес.
Dialogue: 0,0:17:16.62,0:17:18.18,JP（日文对话）,NTP,0000,0000,0000,,Бұл ауылда бізде жоқ.
Dialogue: 0,0:17:18.23,0:17:19.44,JP（日文对话）,NTP,0000,0000,0000,,Жынды болу
Dialogue: 0,0:17:19.76,0:17:21.46,JP（日文对话）,NTP,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:17:21.98,0:17:23.99,JP（日文对话）,NTP,0000,0000,0000,,Бірақ мен таң қалдым, олар неге бұлай жасады?
Dialogue: 0,0:17:24.30,0:17:26.35,JP（日文对话）,NTP,0000,0000,0000,,Біркелкі бола алмайды, себебі ол қара және қызыл.
Dialogue: 0,0:17:27.51,0:17:29.40,JP（日文对话）,NTP,0000,0000,0000,,Көзге көрінбейтін шығар
Dialogue: 0,0:17:30.09,0:17:30.90,JP（日文对话）,NTP,0000,0000,0000,,Не
Dialogue: 0,0:17:32.57,0:17:33.23,JP（日文对话）,NTP,0000,0000,0000,,Қан
Dialogue: 0,0:17:34.87,0:17:38.94,JP（日文对话）,NTP,0000,0000,0000,,Түсінемін, Сайо-чан, мен онымен ойнасам да.
Dialogue: 0,0:17:39.06,0:17:40.33,JP（日文对话）,NTP,0000,0000,0000,,Қанға боялған.
Dialogue: 0,0:17:40.45,0:17:43.18,JP（日文对话）,NTP,0000,0000,0000,,Жарайды, мен мұнымен қоштасамын, бұл жақсы.
Dialogue: 0,0:17:43.36,0:17:46.15,JP（日文对话）,NTP,0000,0000,0000,,Эй, менде бұл болмауы керек сияқты.
Dialogue: 0,0:17:46.62,0:17:50.36,JP（日文对话）,NTP,0000,0000,0000,,Бұл не үшін қолданылады? Бұл толығымен косплей.
Dialogue: 0,0:17:51.14,0:17:54.80,JP（日文对话）,NTP,0000,0000,0000,,Жоқ, қараңдаршы, оны қолданудың көптеген жолдары бар.
Dialogue: 0,0:17:57.31,0:17:59.59,JP（日文对话）,NTP,0000,0000,0000,,Нару Нару Бұл пайдалы болуы мүмкін.
Dialogue: 0,0:17:59.65,0:18:01.22,JP（日文对话）,NTP,0000,0000,0000,,Жаппай өндіріп, қыздарға кигізсеңіз
Dialogue: 0,0:18:01.68,0:18:03.44,JP（日文对话）,NTP,0000,0000,0000,,Бұрын мен ебедейсіз едім.
Dialogue: 0,0:18:03.88,0:18:05.50,JP（日文对话）,NTP,0000,0000,0000,,Тек бұл жолы табылмауға тырысыңыз.
Dialogue: 0,0:18:05.83,0:18:07.89,JP（日文对话）,NTP,0000,0000,0000,,Иә, ол ашылмағанша жақсы.
Dialogue: 0,0:18:08.42,0:18:09.85,JP（日文对话）,NTP,0000,0000,0000,,Не болса да
Dialogue: 0,0:18:13.33,0:18:14.30,JP（日文对话）,NTP,0000,0000,0000,,Әлі жоқ
Dialogue: 0,0:18:14.98,0:18:19.23,JP（日文对话）,NTP,0000,0000,0000,,Егер сіз көне қанды көп сорсаңыз, есте сақтау қабілетіңіз қалпына келуі керек.
Dialogue: 0,0:18:40.31,0:18:41.16,JP（日文对话）,NTP,0000,0000,0000,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:18:41.18,0:18:42.09,JP（日文对话）,NTP,0000,0000,0000,,Мен тыңдамаймын.
Dialogue: 0,0:19:05.12,0:19:06.04,JP（日文对话）,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:19:08.93,0:19:11.19,JP（日文对话）,NTP,0000,0000,0000,,Бас кейіпкерде қандай да бір өзгеріс болса
Dialogue: 0,0:19:11.37,0:19:13.72,JP（日文对话）,NTP,0000,0000,0000,,Маған міндетті түрде хабарлау керектігін айтты.
Dialogue: 0,0:19:14.41,0:19:17.00,JP（日文对话）,NTP,0000,0000,0000,,Жақында есеп бермей жиналдық.
Dialogue: 0,0:19:17.47,0:19:19.68,JP（日文对话）,NTP,0000,0000,0000,,Не істеп жатырсың деп қызық болдым.
Dialogue: 0,0:19:20.38,0:19:21.67,JP（日文对话）,NTP,0000,0000,0000,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:19:22.11,0:19:22.90,JP（日文对话）,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:23.69,0:19:25.64,JP（日文对话）,NTP,0000,0000,0000,,Біз үшін басты актерлер,
Dialogue: 0,0:19:26.04,0:19:28.06,JP（日文对话）,NTP,0000,0000,0000,,Сізді бақылап жатқанын білесіз.
Dialogue: 0,0:19:28.85,0:19:30.59,JP（日文对话）,NTP,0000,0000,0000,,Бұл тек орындау кезінде.
Dialogue: 0,0:19:31.15,0:19:33.29,JP（日文对话）,NTP,0000,0000,0000,,Дұрыс, Сая жоқта.
Dialogue: 0,0:19:33.52,0:19:36.35,JP（日文对话）,NTP,0000,0000,0000,,Барлық GPS және камералар өшірілді.
Dialogue: 0,0:19:37.71,0:19:40.40,JP（日文对话）,NTP,0000,0000,0000,,Мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,0:19:41.19,0:19:43.25,JP（日文对话）,NTP,0000,0000,0000,,Жоба әлі орындалуда
Dialogue: 0,0:19:44.01,0:19:45.76,JP（日文对话）,NTP,0000,0000,0000,,Неліктен бұған еліктедің?
Dialogue: 0,0:19:46.63,0:19:48.40,JP（日文对话）,NTP,0000,0000,0000,,Мен әлі өлген жоқпын.
Dialogue: 0,0:19:48.99,0:19:52.85,JP（日文对话）,NTP,0000,0000,0000,,Оның үстіне, мен сізді осындай әлсіздікке итермелегеніме сене алар емеспін.
Dialogue: 0,0:19:53.39,0:19:56.84,JP（日文对话）,NTP,0000,0000,0000,,Басты кейіпкерді жарақаттау – ең тыйым салынған жазатайым оқиға.
Dialogue: 0,0:19:57.64,0:20:00.73,JP（日文对话）,NTP,0000,0000,0000,,Біз ерекше ештеңе жасамадық.
Dialogue: 0,0:20:01.86,0:20:03.44,JP（日文对话）,NTP,0000,0000,0000,,Менің шеге де жоқ.
Dialogue: 0,0:20:03.83,0:20:05.49,JP（日文对话）,NTP,0000,0000,0000,,Менің саусақтарым да сынған жоқ.
Dialogue: 0,0:20:06.25,0:20:09.09,JP（日文对话）,NTP,0000,0000,0000,,Мұғалім көп нәрсені айтты.
Dialogue: 0,0:20:10.30,0:20:11.83,JP（日文对话）,NTP,0000,0000,0000,,Мен тек шындықты айттым.
Dialogue: 0,0:20:12.57,0:20:14.60,JP（日文对话）,NTP,0000,0000,0000,,Шындықты айтпау
Dialogue: 0,0:20:15.09,0:20:16.13,JP（日文对话）,NTP,0000,0000,0000,,Бұл актерлік құрамның рөлі.
Dialogue: 0,0:20:16.60,0:20:18.57,JP（日文对话）,NTP,0000,0000,0000,,Бірақ мен қазірдің өзінде үйге барғым келеді.
Dialogue: 0,0:20:18.84,0:20:21.46,JP（日文对话）,NTP,0000,0000,0000,,Мұның қашан бітетінін білмеймін.
Dialogue: 0,0:20:22.89,0:20:24.87,JP（日文对话）,NTP,0000,0000,0000,,Менің ойымша, сіз де соны біле тұра қатысқансыз.
Dialogue: 0,0:20:25.26,0:20:26.26,JP（日文对话）,NTP,0000,0000,0000,,Осы мақсатта
Dialogue: 0,0:20:26.69,0:20:28.40,JP（日文对话）,NTP,0000,0000,0000,,Мен одан шаршадым
Dialogue: 0,0:20:28.96,0:20:30.59,JP（日文对话）,NTP,0000,0000,0000,,Ақшаны ала алсам ғой
Dialogue: 0,0:20:30.64,0:20:31.88,JP（日文对话）,NTP,0000,0000,0000,,Кез келген адам жақсы.
Dialogue: 0,0:20:32.47,0:20:34.05,JP（日文对话）,NTP,0000,0000,0000,,Осы жігіттің естелігін қайтарып алсам ғой
Dialogue: 0,0:20:34.30,0:20:36.91,JP（日文对话）,NTP,0000,0000,0000,,Мұғалімнен ақша алып, кет.
Dialogue: 0,0:20:37.41,0:20:38.76,JP（日文对话）,NTP,0000,0000,0000,,Мен мұнда қиындыққа тап болдым.
Dialogue: 0,0:20:39.18,0:20:41.36,JP（日文对话）,NTP,0000,0000,0000,,Ол сол адам болғандықтан, оның соттылығы да жоқ.
Dialogue: 0,0:20:41.70,0:20:44.69,JP（日文对话）,NTP,0000,0000,0000,,Бұл ақылсыз, өйткені сіз бұл нәрсені сүртіп тастай аласыз.
Dialogue: 0,0:20:45.33,0:20:48.69,JP（日文对话）,NTP,0000,0000,0000,,Ей, мұғалім, сіз ешқашан білмеймін дедіңіз.
Dialogue: 0,0:20:48.86,0:20:49.80,JP（日文对话）,NTP,0000,0000,0000,,Мен сонда бардым, солай ма?
Dialogue: 0,0:20:52.02,0:20:53.21,JP（日文对话）,NTP,0000,0000,0000,,Оны анықтау мүмкін емес
Dialogue: 0,0:20:54.05,0:20:57.55,JP（日文对话）,NTP,0000,0000,0000,,Бүкіл қала осы жоба үшін салынған.
Dialogue: 0,0:20:58.53,0:21:01.40,JP（日文对话）,NTP,0000,0000,0000,,Ғимараттар, адамдар, бәрі
Dialogue: 0,0:21:02.59,0:21:05.75,JP（日文对话）,NTP,0000,0000,0000,,Бұл жағдайда бақылаудан құтылу мүмкін емес.
Dialogue: 0,0:21:06.88,0:21:08.09,JP（日文对话）,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:21:08.32,0:21:09.16,JP（日文对话）,NTP,0000,0000,0000,,Мұғалім
Dialogue: 0,0:21:11.82,0:21:13.72,JP（日文对话）,NTP,0000,0000,0000,,Мен оны білуге ​​болады деп ойладым.
Dialogue: 0,0:21:16.07,0:21:17.62,JP（日文对话）,NTP,0000,0000,0000,,Осылай істей берсеңіз
Dialogue: 0,0:21:17.87,0:21:19.65,JP（日文对话）,NTP,0000,0000,0000,,Саяның естеліктері қайтып келмейді.
Dialogue: 0,0:21:20.41,0:21:24.81,JP（日文对话）,NTP,0000,0000,0000,,Бұл қандай эксперимент? Қайта оралуға тырысқан сайын, мен оны қайтадан отырғызамын.
Dialogue: 0,0:21:25.03,0:21:27.12,JP（日文对话）,NTP,0000,0000,0000,,Бұл соңы, сондықтан ол келмеуі керек.
Dialogue: 0,0:21:27.35,0:21:30.18,JP（日文对话）,NTP,0000,0000,0000,,Мен оны әлемге жариялай алмаймын.
Dialogue: 0,0:21:30.78,0:21:31.57,JP（日文对话）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:31.69,0:21:33.23,JP（日文对话）,NTP,0000,0000,0000,,Ақша не болады?
Dialogue: 0,0:21:33.50,0:21:35.26,JP（日文对话）,NTP,0000,0000,0000,,Сенің жаңғырығың маған бәрібір.
Dialogue: 0,0:21:35.47,0:21:37.17,JP（日文对话）,NTP,0000,0000,0000,,Бұл жерде өмірге қауіп төніп тұр.
Dialogue: 0,0:21:37.64,0:21:38.75,JP（日文对话）,NTP,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:21:38.95,0:21:41.00,JP（日文对话）,NTP,0000,0000,0000,,Егер ол анықталса, оны сүртіп алсаңыз да өшіре алмайсыз.
Dialogue: 0,0:21:41.03,0:21:41.92,JP（日文对话）,NTP,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:21:42.93,0:21:44.88,JP（日文对话）,NTP,0000,0000,0000,,Уақытымыз аз қалды.
Dialogue: 0,0:21:45.30,0:21:47.25,JP（日文对话）,NTP,0000,0000,0000,,Бұлай жалғаса берсе, мен академиядан шығарыламын.
Dialogue: 0,0:21:47.77,0:21:51.52,JP（日文对话）,NTP,0000,0000,0000,,Бұл әзіл емес. Менің алдымда тірі дәлелдер бар.
Dialogue: 0,0:21:52.36,0:21:55.37,JP（日文对话）,NTP,0000,0000,0000,,Саяның Сая туралы естеліктері қайта оралса
Dialogue: 0,0:21:55.89,0:21:58.09,JP（日文对话）,NTP,0000,0000,0000,,Мен оған сенімдімін
Dialogue: 0,0:21:58.75,0:21:59.54,JP（日文对话）,NTP,0000,0000,0000,,Мен
Dialogue: 0,0:22:14.06,0:22:16.40,JP（日文对话）,NTP,0000,0000,0000,,Менімен не істеу керек?
Dialogue: 0,0:23:47.86,0:23:50.62,JP（日文对话）,NTP,0000,0000,0000,,Сайо: Сіздің ойыңызша, адамды не етеді?
Dialogue: 0,0:23:51.72,0:23:53.52,JP（日文对话）,NTP,0000,0000,0000,,Онда адамдар туа ма?
Dialogue: 0,0:23:54.19,0:23:57.11,JP（日文对话）,NTP,0000,0000,0000,,Әлде солай бола ма?
Dialogue: 0,0:23:57.82,0:24:01.13,JP（日文对话）,NTP,0000,0000,0000,,Келесі жолы BLOOD-C «Ұмытып қалдым»
Dialogue: 0,0:24:02.63,0:24:08.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory