Dialogue: 0,0:01:30.13,0:01:39.49,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:01:30.13,0:01:39.49,成员名显示,NTP,0000,0000,0000,,：   ： ： ：akira ：
Dialogue: 0,0:01:59.67,0:02:02.95,日文对话,NTP,0000,0000,0000,,Кеш...Мен мұнда сенімдімін...
Dialogue: 0,0:02:08.22,0:02:09.39,日文对话,NTP,0000,0000,0000,,Менің басым...
Dialogue: 0,0:02:16.08,0:02:16.64,日文对话,NTP,0000,0000,0000,,Сайо-чан?
Dialogue: 0,0:02:21.42,0:02:22.07,日文对话,NTP,0000,0000,0000,,Бунджин-сан
Dialogue: 0,0:02:24.01,0:02:27.19,强调,NTP,0000,0000,0000,,5 эпизод «Мегуриахит»
Dialogue: 0,0:02:39.78,0:02:40.63,日文对话,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:02:41.90,0:02:43.57,日文对话,NTP,0000,0000,0000,,Иә, жақсы
Dialogue: 0,0:02:44.72,0:02:46.88,日文对话,NTP,0000,0000,0000,,Өтірік айта алмайсың, Сайо-чан.
Dialogue: 0,0:02:50.26,0:02:52.33,日文对话,NTP,0000,0000,0000,,Мені алаңдатқың келмейтінін білемін, бірақ
Dialogue: 0,0:02:53.18,0:02:55.42,日文对话,NTP,0000,0000,0000,,Егер ол жасырын болса, мен көбірек уайымдайтын едім.
Dialogue: 0,0:02:57.22,0:03:01.00,日文对话,NTP,0000,0000,0000,,Егер бірдеңе болса, маған хабарлаңыз.
Dialogue: 0,0:03:04.47,0:03:07.47,日文对话,NTP,0000,0000,0000,,Мен біраз абдырап қалдым.
Dialogue: 0,0:03:08.27,0:03:10.05,日文对话,NTP,0000,0000,0000,,Сондай-ақ, менің басым...
Dialogue: 0,0:03:10.86,0:03:11.76,日文对话,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:03:12.81,0:03:13.63,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:18.25,0:03:20.36,日文对话,NTP,0000,0000,0000,,Сіздің қызуыңыз жоқ сияқты.
Dialogue: 0,0:03:21.08,0:03:23.24,日文对话,NTP,0000,0000,0000,,Бұл ауру немесе басқа нәрсе емес.
Dialogue: 0,0:03:24.26,0:03:26.40,日文对话,NTP,0000,0000,0000,,Мен мұны өзім түсінбеймін.
Dialogue: 0,0:03:29.21,0:03:32.48,日文对话,NTP,0000,0000,0000,,Басыңыз ауырса, кофеин сізге зиянды ма?
Dialogue: 0,0:03:33.22,0:03:37.13,日文对话,NTP,0000,0000,0000,,Жоқ, мен Фумито-санның кофесін ішкенде.
Dialogue: 0,0:03:37.41,0:03:38.76,日文对话,NTP,0000,0000,0000,,Бұл мені әрқашан тыныштандырады.
Dialogue: 0,0:03:39.44,0:03:40.70,日文对话,NTP,0000,0000,0000,,Мен солай болғанын қалаймын.
Dialogue: 0,0:03:47.09,0:03:48.49,日文对话,NTP,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,0:03:49.74,0:03:50.98,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:03:59.46,0:04:00.22,日文对话,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:04:01.18,0:04:01.99,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:04:02.30,0:04:06.57,日文对话,NTP,0000,0000,0000,,Мен өзімді шынымен қауіпсіз және бақытты сезінемін.
Dialogue: 0,0:04:28.55,0:04:30.95,日文对话,NTP,0000,0000,0000,,Тш, мен ұйықтап қалдым.
Dialogue: 0,0:04:32.35,0:04:33.34,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:36.23,0:04:38.98,日文对话,NTP,0000,0000,0000,,Сайо-чан басы ауырып тұрғанын айтты.
Dialogue: 0,0:05:12.51,0:05:14.77,日文对话,NTP,0000,0000,0000,,Бұл ескі нәрсе.
Dialogue: 0,0:05:15.66,0:05:16.35,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:05:30.94,0:05:31.94,日文对话,NTP,0000,0000,0000,,Мен мұны істей аламын.
Dialogue: 0,0:05:33.74,0:05:35.20,日文对话,NTP,0000,0000,0000,,Сая жеңілмейді
Dialogue: 0,0:06:18.76,0:06:20.45,日文对话,NTP,0000,0000,0000,,Нуши - Саякаэ
Dialogue: 0,0:06:33.67,0:06:34.76,日文对话,NTP,0000,0000,0000,,Эй, Изуна.
Dialogue: 0,0:06:36.94,0:06:37.83,日文对话,NTP,0000,0000,0000,,Екі
Dialogue: 0,0:06:42.14,0:06:43.87,日文对话,NTP,0000,0000,0000,,Шынымен әлсіз
Dialogue: 0,0:06:44.31,0:06:47.31,日文对话,NTP,0000,0000,0000,,Бауырларымызды сойған осы.
Dialogue: 0,0:07:05.04,0:07:05.51,日文对话,NTP,0000,0000,0000,,Көрінбеген
Dialogue: 0,0:07:28.08,0:07:29.23,日文对话,NTP,0000,0000,0000,,Тұманға байланысты
Dialogue: 0,0:08:02.01,0:08:05.37,日文对话,NTP,0000,0000,0000,,Уәдеде тұрмағанның бәрі кінәлі
Dialogue: 0,0:08:06.29,0:08:07.29,日文对话,NTP,0000,0000,0000,,Шарт…
Dialogue: 0,0:08:09.76,0:08:11.25,日文对话,NTP,0000,0000,0000,,Кім және кімдікі?
Dialogue: 0,0:08:12.59,0:08:14.73,日文对话,NTP,0000,0000,0000,,Адамдар және біз
Dialogue: 0,0:08:15.62,0:08:16.68,日文对话,NTP,0000,0000,0000,,Сіз не уәде бердіңіз?
Dialogue: 0,0:08:17.09,0:08:19.68,日文对话,NTP,0000,0000,0000,,О... жоқ
Dialogue: 0,0:08:20.92,0:08:21.42,日文对话,NTP,0000,0000,0000,,Адамдар...!
Dialogue: 0,0:08:31.89,0:08:32.71,日文对话,NTP,0000,0000,0000,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:08:44.71,0:08:46.96,日文对话,NTP,0000,0000,0000,,Сіз қарыз алушы сияқтысыз.
Dialogue: 0,0:08:50.39,0:08:56.28,日文对话,NTP,0000,0000,0000,,Қорғаңыз...Мен сізді қызықтыратындардың барлығын сенен қорғаймын.
Dialogue: 0,0:09:17.56,0:09:19.27,日文对话,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:09:37.95,0:09:39.11,日文对话,NTP,0000,0000,0000,,Көрінбейтін өзгеріс?
Dialogue: 0,0:09:40.20,0:09:41.74,日文对话,NTP,0000,0000,0000,,Қозғалыс оқылады
Dialogue: 0,0:10:46.86,0:10:48.31,日文对话,NTP,0000,0000,0000,,Сіз не уәде бердіңіз?
Dialogue: 0,0:11:14.89,0:11:15.73,日文对话,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:11:18.34,0:11:19.78,日文对话,NTP,0000,0000,0000,,Жоқ…
Dialogue: 0,0:11:25.40,0:11:28.81,日文对话,NTP,0000,0000,0000,,Адам мен ежелгі заттар арасындағы келісім
Dialogue: 0,0:11:33.81,0:11:35.02,日文对话,NTP,0000,0000,0000,,Бұл ит?
Dialogue: 0,0:11:56.71,0:12:01.90,日文对话,NTP,0000,0000,0000,,Адамдар түсінбейтін нәрсеге тап болған кезде не істейді?
Dialogue: 0,0:12:03.23,0:12:05.33,日文对话,NTP,0000,0000,0000,,Менің ойымша, бұл.
Dialogue: 0,0:12:06.87,0:12:08.42,日文对话,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:09.00,0:12:10.20,日文对话,NTP,0000,0000,0000,,Неліктен бұлай болды?
Dialogue: 0,0:12:11.01,0:12:12.52,日文对话,NTP,0000,0000,0000,,Оны қалай қабылдауым керек?
Dialogue: 0,0:12:13.27,0:12:14.70,日文对话,NTP,0000,0000,0000,,Енді не істеуім керек?
Dialogue: 0,0:12:16.38,0:12:19.54,日文对话,NTP,0000,0000,0000,,Бірақ мен бұл туралы неғұрлым көп ойласам, соғұрлым ол туралы көбірек ойлаймын.
Dialogue: 0,0:12:20.46,0:12:23.98,日文对话,NTP,0000,0000,0000,,Мәнінен біртүрлі ауытқиды.
Dialogue: 0,0:12:24.96,0:12:28.63,日文对话,NTP,0000,0000,0000,,Иә, ойлар кедергі жасайды.
Dialogue: 0,0:12:30.16,0:12:32.16,日文对话,NTP,0000,0000,0000,,Сіздің инстинктіңіз нені қалайды
Dialogue: 0,0:12:33.02,0:12:34.66,日文对话,NTP,0000,0000,0000,,Нақты жауап
Dialogue: 0,0:12:47.39,0:12:49.59,日文对话,NTP,0000,0000,0000,,Мен аң-таң болдым.
Dialogue: 0,0:12:51.43,0:12:52.71,日文对话,NTP,0000,0000,0000,,Юка-сан
Dialogue: 0,0:12:53.19,0:12:55.29,日文对话,NTP,0000,0000,0000,,PE жаңбырға байланысты тоқтатылды.
Dialogue: 0,0:12:55.55,0:12:57.18,日文对话,NTP,0000,0000,0000,,Неге сонша көңілсізсің?
Dialogue: 0,0:12:57.95,0:12:59.89,日文对话,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:13:00.75,0:13:02.61,日文对话,NTP,0000,0000,0000,,Саған не болды?
Dialogue: 0,0:13:03.48,0:13:06.70,日文对话,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:13:08.04,0:13:11.01,日文对话,NTP,0000,0000,0000,,Көп нәрсе анық емес
Dialogue: 0,0:13:12.03,0:13:12.94,日文对话,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:13:13.51,0:13:17.31,日文对话,NTP,0000,0000,0000,,Менің басым аздап ауырады.
Dialogue: 0,0:13:18.18,0:13:20.92,日文对话,NTP,0000,0000,0000,,Мен жақсы ойлай алмайтын сияқтымын.
Dialogue: 0,0:13:21.74,0:13:22.88,日文对话,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:24.16,0:13:27.06,日文对话,NTP,0000,0000,0000,,Мазасыздық пен жағымсыз нәрселер
Dialogue: 0,0:13:29.49,0:13:32.33,日文对话,NTP,0000,0000,0000,,Бар, ештеңені жасырма.
Dialogue: 0,0:13:33.72,0:13:35.65,日文对话,NTP,0000,0000,0000,,Біз сол үшін келдік.
Dialogue: 0,0:13:37.57,0:13:38.40,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:40.00,0:13:44.53,日文对话,NTP,0000,0000,0000,,Байланыс! Дене шынықтыру сабағында оқушылар сабақта өз бетімен оқиды.
Dialogue: 0,0:13:44.86,0:13:46.82,日文对话,NTP,0000,0000,0000,,Аруақ оқиғасын айт
Dialogue: 0,0:13:47.27,0:13:49.67,日文对话,NTP,0000,0000,0000,,Ал, бұл елес әңгімелер үшін жақсы күн.
Dialogue: 0,0:13:50.23,0:13:51.49,日文对话,NTP,0000,0000,0000,,Бұл болады
Dialogue: 0,0:13:51.74,0:13:53.16,日文对话,NTP,0000,0000,0000,,Екеуміз бірге елес әңгіме құрастырайық
Dialogue: 0,0:13:53.60,0:13:55.13,日文对话,NTP,0000,0000,0000,,Тек жақсы идеялар
Dialogue: 0,0:13:55.46,0:13:57.57,日文对话,NTP,0000,0000,0000,,Өзіндік жұмыс дегеніміз не?
Dialogue: 0,0:13:57.87,0:14:00.46,日文对话,NTP,0000,0000,0000,,Өз бетімен оқуыңды сұраймын.
Dialogue: 0,0:14:01.07,0:14:02.20,日文对话,NTP,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:14:02.83,0:14:06.23,日文对话,NTP,0000,0000,0000,,Қорқынышты оқиғаларды өздік жұмыс ретінде зерттейміз.
Dialogue: 0,0:14:07.06,0:14:08.76,日文对话,NTP,0000,0000,0000,,Бұл қандай оқу түрі?
Dialogue: 0,0:14:14.89,0:14:17.96,日文对话,NTP,0000,0000,0000,,Жарайды, төраға айтқандай.
Dialogue: 0,0:14:18.26,0:14:19.98,日文对话,NTP,0000,0000,0000,,Бұл елес әңгімелер үшін тамаша күн
Dialogue: 0,0:14:20.97,0:14:21.82,日文对话,NTP,0000,0000,0000,,Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:14:22.15,0:14:23.56,日文对话,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:14:25.06,0:14:26.65,日文对话,NTP,0000,0000,0000,,Орыныңызға отырыңыз.
Dialogue: 0,0:14:27.21,0:14:27.92,日文对话,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:14:28.45,0:14:31.62,日文对话,NTP,0000,0000,0000,,Ешқандай сабақ алудан айырмашылығы жоқ, солай ма?
Dialogue: 0,0:14:32.06,0:14:33.16,日文对话,NTP,0000,0000,0000,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:14:33.51,0:14:35.68,日文对话,NTP,0000,0000,0000,,Ең болмаса партаны соңына дейін жылжытыңыз.
Dialogue: 0,0:14:36.06,0:14:38.67,日文对话,NTP,0000,0000,0000,,Маған орындықты осылай айналдырамын.
Dialogue: 0,0:14:39.44,0:14:40.85,日文对话,NTP,0000,0000,0000,,Неге алаңдау керек?
Dialogue: 0,0:14:41.15,0:14:44.32,日文对话,NTP,0000,0000,0000,,«Ия» немесе «қорқынышты» сияқты сөздерді айту кезінде
Dialogue: 0,0:14:44.67,0:14:47.36,日文对话,NTP,0000,0000,0000,,Сен мені құшақтап, секіргің келеді, солай емес пе?
Dialogue: 0,0:14:47.76,0:14:50.09,日文对话,NTP,0000,0000,0000,,Қазіргі қыздар алға ұмтылады.
Dialogue: 0,0:14:50.71,0:14:52.67,日文对话,NTP,0000,0000,0000,,Бұл екеуі тым көп.
Dialogue: 0,0:14:54.03,0:14:55.09,日文对话,NTP,0000,0000,0000,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:14:55.52,0:14:57.50,日文对话,NTP,0000,0000,0000,,Содан кейін партаны артыңызға қойыңыз.
Dialogue: 0,0:14:57.85,0:14:59.60,日文对话,NTP,0000,0000,0000,,Орындықтарды қалағаныңызша орналастыра аласыз.
Dialogue: 0,0:15:00.53,0:15:04.57,日文对话,NTP,0000,0000,0000,,Сондықтан оны шешуге болмайды, Токима-күн.
Dialogue: 0,0:15:06.33,0:15:06.44,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:11.98,0:15:13.89,日文对话,NTP,0000,0000,0000,,Баланың артында ер адам тұр
Dialogue: 0,0:15:14.26,0:15:15.99,日文对话,NTP,0000,0000,0000,,Дыбыс шығармай жақындады
Dialogue: 0,0:15:16.86,0:15:19.96,日文对话,NTP,0000,0000,0000,,Сосын қолын созып, арқаңды ұстамақ болды.
Dialogue: 0,0:15:21.12,0:15:23.97,日文对话,NTP,0000,0000,0000,,Содан кейін бала бұрылды да
Dialogue: 0,0:15:24.51,0:15:25.79,日文对话,NTP,0000,0000,0000,,Мен ол кісіге айттым
Dialogue: 0,0:15:28.09,0:15:33.38,日文对话,NTP,0000,0000,0000,,«Әке, бұл жолы мені жардан итермеңізші».
Dialogue: 0,0:15:33.64,0:15:35.71,日文对话,NTP,0000,0000,0000,,Қандай қорқынышты
Dialogue: 0,0:15:36.79,0:15:38.44,日文对话,NTP,0000,0000,0000,,Тек оқудың да шегі бар
Dialogue: 0,0:15:39.68,0:15:43.24,日文对话,NTP,0000,0000,0000,,Юка-чан, бұл қорқынышты, бұл өте қорқынышты.
Dialogue: 0,0:15:43.80,0:15:46.69,日文对话,NTP,0000,0000,0000,,Оған құмар болып қана қоймай, одан да өтірікші екенсің.
Dialogue: 0,0:15:47.27,0:15:48.64,日文对话,NTP,0000,0000,0000,,Сайо-чан қалай болды?
Dialogue: 0,0:15:49.45,0:15:52.70,日文对话,NTP,0000,0000,0000,,Балаңызды неге жарға апардыңыз?
Dialogue: 0,0:15:53.35,0:15:54.35,日文对话,NTP,0000,0000,0000,,Қауіпті
Dialogue: 0,0:15:54.15,0:15:54.66,日文对话,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:15:55.49,0:15:59.69,日文对话,NTP,0000,0000,0000,,Жоқ, бұл менің сенімділігімді жоғалтатындай емес.
Dialogue: 0,0:16:00.42,0:16:01.87,日文对话,NTP,0000,0000,0000,,Маған осыншама құтылуға рұқсат етсеңіз
Dialogue: 0,0:16:02.56,0:16:05.32,日文对话,NTP,0000,0000,0000,,Өйткені бұл тамаша үлгі әңгіме.
Dialogue: 0,0:16:05.83,0:16:08.39,日文对话,NTP,0000,0000,0000,,Елес әңгімелер негізінен шаблондар.
Dialogue: 0,0:16:08.81,0:16:12.57,日文对话,NTP,0000,0000,0000,,Бірақ біз сәл жақынырақ болуымыз керек.
Dialogue: 0,0:16:13.09,0:16:17.81,日文对话,NTP,0000,0000,0000,,Бұл менің аға досымның ағасы басынан өткен оқиға.
Dialogue: 0,0:16:18.55,0:16:19.34,日文对话,NTP,0000,0000,0000,,Токаса
Dialogue: 0,0:16:20.04,0:16:21.91,日文对话,NTP,0000,0000,0000,,Сіз білесіз бе, әлде білмейсіз бе?
Dialogue: 0,0:16:22.13,0:16:24.14,日文对话,NTP,0000,0000,0000,,Сіз бір-біріңізді түсінуді қиындататын деңгейде білесіз.
Dialogue: 0,0:16:24.69,0:16:27.04,日文对话,NTP,0000,0000,0000,,Болды, түпнұсқаға жақын болған жақсы.
Dialogue: 0,0:16:27.73,0:16:29.03,日文对话,NTP,0000,0000,0000,,Бұл қала т.б.
Dialogue: 0,0:16:29.10,0:16:29.57,日文对话,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:16:30.55,0:16:33.01,日文对话,NTP,0000,0000,0000,,Шынайы болса қорқынышты болар еді.
Dialogue: 0,0:16:33.76,0:16:35.65,日文对话,NTP,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:16:36.20,0:16:37.25,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:16:38.43,0:16:40.29,日文对话,NTP,0000,0000,0000,,Осы қаланың тарихы
Dialogue: 0,0:16:40.71,0:16:42.17,日文对话,NTP,0000,0000,0000,,Профессор Канако күткендей
Dialogue: 0,0:16:42.94,0:16:44.60,日文对话,NTP,0000,0000,0000,,Бұл тым жақын шығар.
Dialogue: 0,0:16:45.07,0:16:47.55,日文对话,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Бұл елес оқиға.
Dialogue: 0,0:16:48.08,0:16:49.45,日文对话,NTP,0000,0000,0000,,Қорыққанның мәні неде?
Dialogue: 0,0:16:49.70,0:16:52.00,日文对话,NTP,0000,0000,0000,,Бірақ бұл сөз тіркесі емес.
Dialogue: 0,0:16:52.22,0:16:52.82,日文对话,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:16:53.70,0:16:55.75,日文对话,NTP,0000,0000,0000,,Бұл шынайы оқиға сияқты.
Dialogue: 0,0:16:56.46,0:16:59.53,日文对话,NTP,0000,0000,0000,,Тыңдасаң, сенің де басыңа түсетін сияқты.
Dialogue: 0,0:17:01.14,0:17:02.68,日文对话,NTP,0000,0000,0000,,Әй, солай.
Dialogue: 0,0:17:03.23,0:17:06.29,日文对话,NTP,0000,0000,0000,,Жақсы, жақсы, менің үстімнен құлағаныңды қалаймын.
Dialogue: 0,0:17:06.70,0:17:09.12,日文对话,NTP,0000,0000,0000,,Әр күн қазірдің өзінде қызықсыз.
Dialogue: 0,0:17:09.66,0:17:11.57,日文对话,NTP,0000,0000,0000,,Мұғалім, өтінемін.
Dialogue: 0,0:17:12.01,0:17:14.92,日文对话,NTP,0000,0000,0000,,Кейін шағымданбаңыз, Куэ мырза.
Dialogue: 0,0:17:19.13,0:17:20.35,日文对话,NTP,0000,0000,0000,,Осы қалада
Dialogue: 0,0:17:20.78,0:17:24.85,日文对话,NTP,0000,0000,0000,,Ол жерде ерте заманнан адам емес адамдар өмір сүрген дейді.
Dialogue: 0,0:17:25.99,0:17:30.05,日文对话,NTP,0000,0000,0000,,Кейде ол басқа адамдарға қарағанда басқа пішінде болады.
Dialogue: 0,0:17:30.46,0:17:33.26,日文对话,NTP,0000,0000,0000,,Ұқсас формаларда пайда болуы мүмкін
Dialogue: 0,0:17:34.58,0:17:38.34,日文对话,NTP,0000,0000,0000,,Алайда олардың барлығы бірдей.
Dialogue: 0,0:17:38.77,0:17:40.50,日文对话,NTP,0000,0000,0000,,Адамдарды жеу
Dialogue: 0,0:17:44.76,0:17:46.54,日文对话,NTP,0000,0000,0000,,Бұл өте күшті
Dialogue: 0,0:17:46.98,0:17:50.53,日文对话,NTP,0000,0000,0000,,Адам сол күштің алдында соншалықты дәрменсіз.
Dialogue: 0,0:17:51.58,0:17:55.39,日文对话,NTP,0000,0000,0000,,Жоғалтпайтын нәрселер болса да, Сүйетін нәрселер болса да
Dialogue: 0,0:17:55.88,0:17:58.99,日文对话,NTP,0000,0000,0000,,Тұлға болып табылмайтын нәрсеге қатысы жоқ
Dialogue: 0,0:17:59.51,0:18:01.41,日文对话,NTP,0000,0000,0000,,Егер табылса немесе шабуыл жасалса
Dialogue: 0,0:18:01.98,0:18:04.03,日文对话,NTP,0000,0000,0000,,Оны жаңа ғана жеп жатыр еді.
Dialogue: 0,0:18:06.03,0:18:11.11,日文对话,NTP,0000,0000,0000,,Адамдар өздеріне ұқсамайтын нәрсемен сөйлесуге тырысты
Dialogue: 0,0:18:11.96,0:18:17.23,日文对话,NTP,0000,0000,0000,,Кейбір адам емес адамдар адамдармен бір тілде сөйледі.
Dialogue: 0,0:18:18.81,0:18:21.78,日文对话,NTP,0000,0000,0000,,Бірақ ештеңе өзгерген жоқ.
Dialogue: 0,0:18:23.41,0:18:24.81,日文对话,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:26.48,0:18:32.60,日文对话,NTP,0000,0000,0000,,Адам емес адамдар үшін адам тамақтан басқа ештеңе емес.
Dialogue: 0,0:18:33.49,0:18:38.13,日文对话,NTP,0000,0000,0000,,Ал халық шешім қабылдады
Dialogue: 0,0:18:39.60,0:18:40.64,日文对话,NTP,0000,0000,0000,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:19:07.40,0:19:08.23,日文对话,NTP,0000,0000,0000,,Сая!
Dialogue: 0,0:19:09.79,0:19:10.70,日文对话,NTP,0000,0000,0000,,Сайо-чан?
Dialogue: 0,0:19:11.33,0:19:14.31,日文对话,NTP,0000,0000,0000,,Амансың ба? Мықты болыңыз! Эй!
Dialogue: 0,0:19:15.42,0:19:18.52,日文对话,NTP,0000,0000,0000,,Сая Сая!
Dialogue: 0,0:19:33.82,0:19:35.72,日文对话,NTP,0000,0000,0000,,Мен тағы құладым.
Dialogue: 0,0:19:36.93,0:19:38.88,日文对话,NTP,0000,0000,0000,,Мен найзағайдан қорықпаймын
Dialogue: 0,0:19:52.00,0:19:54.51,日文对话,NTP,0000,0000,0000,,Адам қабылдаған шешім
Dialogue: 0,0:19:55.79,0:19:56.84,日文对话,NTP,0000,0000,0000,,Сая!
Dialogue: 0,0:19:59.95,0:20:01.63,日文对话,NTP,0000,0000,0000,,Тек атымен шақырылады
Dialogue: 0,0:20:02.17,0:20:05.17,日文对话,NTP,0000,0000,0000,,Бұл менің әкемнен басқа адам үшін бірінші рет болуы мүмкін.
Dialogue: 0,0:20:10.34,0:20:14.54,日文对话,NTP,0000,0000,0000,,Бір нәрсе басқаша болып көрінеді.
Dialogue: 0,0:20:17.96,0:20:19.16,日文对话,NTP,0000,0000,0000,,Сайо-чан
Dialogue: 0,0:20:20.23,0:20:21.36,日文对话,NTP,0000,0000,0000,,Бұл дауыс
Dialogue: 0,0:20:24.18,0:20:27.26,日文对话,NTP,0000,0000,0000,,Нене-сан, сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:20:28.34,0:20:29.64,日文对话,NTP,0000,0000,0000,,Мен мүлде күтпеймін.
Dialogue: 0,0:20:30.30,0:20:32.55,日文对话,NTP,0000,0000,0000,,Бірақ мен оны жақсы түсінемін.
Dialogue: 0,0:20:33.15,0:20:35.46,日文对话,NTP,0000,0000,0000,,Айыра алатын адамдар жоқтың қасы.
Dialogue: 0,0:20:36.15,0:20:37.10,日文对话,NTP,0000,0000,0000,,Өйткені ол басқаша.
Dialogue: 0,0:20:38.50,0:20:41.73,日文对话,NTP,0000,0000,0000,,Бірдей болса да, әртүрлі, сондықтан түсінемін.
Dialogue: 0,0:20:42.39,0:20:43.71,日文对话,NTP,0000,0000,0000,,Сайо-чан күткендей
Dialogue: 0,0:20:44.38,0:20:47.57,日文对话,NTP,0000,0000,0000,,Бірақ егер солай болса, онда оны салыстыратын ештеңе жоқ.
Dialogue: 0,0:20:47.91,0:20:50.16,日文对话,NTP,0000,0000,0000,,Қайсысы дұрыс екенін білмейсіз бе?
Dialogue: 0,0:20:51.41,0:20:53.88,日文对话,NTP,0000,0000,0000,,Дұрыс жауап болса, ол дұрыс болады...
Dialogue: 0,0:20:54.69,0:20:56.33,日文对话,NTP,0000,0000,0000,,Нене-сан - Нене-сан
Dialogue: 0,0:20:56.94,0:20:58.76,日文对话,NTP,0000,0000,0000,,Ноно мырза - Ноно мырза.
Dialogue: 0,0:21:00.37,0:21:01.22,日文对话,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:02.02,0:21:03.88,日文对话,NTP,0000,0000,0000,,Күніңіз қалай өтті?
Dialogue: 0,0:21:04.81,0:21:06.57,日文对话,NTP,0000,0000,0000,,Біздің ғибадатханаға барғыңыз келе ме?
Dialogue: 0,0:21:07.10,0:21:10.40,日文对话,NTP,0000,0000,0000,,Жоқ, Сайо-чан бүгін құлап қалған шығар.
Dialogue: 0,0:21:10.89,0:21:14.37,日文对话,NTP,0000,0000,0000,,Мен мұғаліміме осы қала туралы айтқаннан кейін
Dialogue: 0,0:21:15.37,0:21:17.57,日文对话,NTP,0000,0000,0000,,Олай болса, бұл дұрыс па деп ойлаймын?
Dialogue: 0,0:21:19.21,0:21:20.60,日文对话,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:21:21.27,0:21:23.86,日文对话,NTP,0000,0000,0000,,Ол Нононың оны тоқтатқанына ашулы.
Dialogue: 0,0:21:24.68,0:21:27.01,日文对话,NTP,0000,0000,0000,,Қызық, Сайо-чан да ашулы ма?
Dialogue: 0,0:21:27.74,0:21:29.12,日文对话,NTP,0000,0000,0000,,Мен ашуланбаймын
Dialogue: 0,0:21:29.63,0:21:31.98,日文对话,NTP,0000,0000,0000,,Мен үшін алаңдағаныңызға қуаныштымын.
Dialogue: 0,0:21:33.54,0:21:37.00,日文对话,NTP,0000,0000,0000,,Бірақ бірдеңе дұрыс емес сияқты болды.
Dialogue: 0,0:21:37.79,0:21:40.86,日文对话,NTP,0000,0000,0000,,Бұл сәл ғана бас ауруы болды.
Dialogue: 0,0:21:41.31,0:21:43.18,日文对话,NTP,0000,0000,0000,,Сол оқиғаның кесірінен бе?
Dialogue: 0,0:21:44.22,0:21:46.67,日文对话,NTP,0000,0000,0000,,Жоқ, содан бері біраз уақыт өтті.
Dialogue: 0,0:21:48.16,0:21:49.57,日文对话,NTP,0000,0000,0000,,Мен де соған алаңдаймын.
Dialogue: 0,0:21:50.11,0:21:54.51,日文对话,NTP,0000,0000,0000,,Бірақ егер менің басыма бірдеңе келсе, ол мен болар едім.
Dialogue: 0,0:21:57.96,0:21:58.55,日文对话,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:21:59.63,0:22:00.17,日文对话,NTP,0000,0000,0000,,Нене-сан!
Dialogue: 0,0:22:10.62,0:22:11.89,日文对话,NTP,0000,0000,0000,,Құбыжық!
Dialogue: 0,0:23:47.73,0:23:48.57,日文对话,NTP,0000,0000,0000,,Сәлем Сайо-чан
Dialogue: 0,0:23:48.96,0:23:52.66,日文对话,NTP,0000,0000,0000,,Қайсысы Нене, қайсысы Нене екенін білеміз.
Dialogue: 0,0:23:52.74,0:23:56.13,日文对话,NTP,0000,0000,0000,,Мм, оң жақтағы - Нене, сол жақта - Ноно?
Dialogue: 0,0:23:56.42,0:23:57.35,日文对话,NTP,0000,0000,0000,,Дұрыс
Dialogue: 0,0:23:57.62,0:23:59.30,日文对话,NTP,0000,0000,0000,,Ой, сен қайдан білдің?
Dialogue: 0,0:23:59.62,0:24:01.45,日文对话,NTP,0000,0000,0000,,Неліктен? Әйтеуір.
Dialogue: 0,0:24:01.69,0:24:02.88,日文对话,NTP,0000,0000,0000,,Ал, бұл жолы ше?
Dialogue: 0,0:24:03.18,0:24:06.92,日文对话,NTP,0000,0000,0000,,Бұлардың арасында нағыз Нене бар ма?
Dialogue: 0,0:24:07.26,0:24:08.46,日文对话,NTP,0000,0000,0000,,Үш Ненес
Dialogue: 0,0:24:08.74,0:24:10.44,日文对话,NTP,0000,0000,0000,,Эй, болжап көріңіз.
Dialogue: 0,0:24:12.79,0:24:15.94,日文对话,NTP,0000,0000,0000,,Келесі жолы қан-С «Суықты ауыртады»
Dialogue: 0,0:00:11.81,0:00:14.54,JP_ED,NTP,0000,0000,0000,,Осы түнде қыдырудың түсуі
Dialogue: 0,0:00:14.64,0:00:17.40,JP_ED,NTP,0000,0000,0000,,Мен өмір сүргім келеді, бірақ мен жоғалдым
Dialogue: 0,0:00:17.42,0:00:22.21,JP_ED,NTP,0000,0000,0000,,Қайтып оралуға болмайтын өткен және сіз білетініңізге күмәнданбайсыз ба
Dialogue: 0,0:00:23.35,0:00:26.26,JP_ED,NTP,0000,0000,0000,,Мен сенетін барлық нәрселер
Dialogue: 0,0:00:26.24,0:00:28.52,JP_ED,NTP,0000,0000,0000,,Шындықты көргім келмейтін қара күндер
Dialogue: 0,0:00:29.11,0:00:34.23,JP_ED,NTP,0000,0000,0000,,Баруға болмайтын жағдай, қайда барарыңды білмейсің
Dialogue: 0,0:00:34.56,0:00:37.07,JP_ED,NTP,0000,0000,0000,,Үміттің де жалған екенін білесің бе?
Dialogue: 0,0:00:37.31,0:00:39.52,JP_ED,NTP,0000,0000,0000,,және бұл заклинание тек құдайлардың ақиқаты болып табылады
Dialogue: 0,0:00:39.74,0:00:44.50,JP_ED,NTP,0000,0000,0000,,Қараңғылықты кесіп өт
Dialogue: 0,0:00:45.26,0:00:48.00,JP_ED,NTP,0000,0000,0000,,Шексіздік сызығы неге қан кету керек
Dialogue: 0,0:00:48.05,0:00:50.62,JP_ED,NTP,0000,0000,0000,,менің меланхолиямды көтеріп
Dialogue: 0,0:00:50.89,0:00:54.01,JP_ED,NTP,0000,0000,0000,,тезірек келдім деп айта алмаймын
Dialogue: 0,0:00:54.05,0:00:54.75,JP_ED,NTP,0000,0000,0000,,себебі мен жасаймын
Dialogue: 0,0:00:55.11,0:00:56.32,JP_ED,NTP,0000,0000,0000,,ешқашан аяқталмайды
Dialogue: 0,0:00:56.51,0:00:58.64,JP_ED,NTP,0000,0000,0000,,менің croixтегі чипсы
Dialogue: 0,0:00:58.96,0:01:01.36,JP_ED,NTP,0000,0000,0000,,бұл мен сені қалайтындықтан
Dialogue: 0,0:01:01.96,0:01:04.80,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс орындалмайды
Dialogue: 0,0:01:05.06,0:01:06.70,JP_ED,NTP,0000,0000,0000,,Қазіргі уақытта жарқыраған жарық
Dialogue: 0,0:01:06.75,0:01:10.38,JP_ED,NTP,0000,0000,0000,,Бұл менің шындықты алып жүретін соңғы күшім
Dialogue: 0,0:01:10.64,0:01:13.56,JP_ED,NTP,0000,0000,0000,,Еш ауыртпалық жоқ пайда жоқ Абсолютті әділеттілік
Dialogue: 0,0:01:13.61,0:01:16.47,JP_ED,NTP,0000,0000,0000,,Себебін оқысаңыз және
Dialogue: 0,0:01:16.57,0:01:18.90,JP_ED,NTP,0000,0000,0000,,Мен шамымды қойдым
Dialogue: 0,0:01:18.98,0:01:21.55,JP_ED,NTP,0000,0000,0000,,Апокалипсис біреуді білу керек
Dialogue: 0,0:01:21.79,0:01:25.08,JP_ED,NTP,0000,0000,0000,,Бұл ұсынысты өзгертуге болмайды
Dialogue: 0,0:01:25.11,0:01:27.49,JP_ED,NTP,0000,0000,0000,,у...
Dialogue: 0,0:22:29.12,0:22:34.65,JP_ED,NTP,0000,0000,0000,,Бұлыңғыр түнге ағып жатқан дөрекі дауыс
Dialogue: 0,0:22:34.94,0:22:40.13,JP_ED,NTP,0000,0000,0000,,Туған жерді жеңіл билеу
Dialogue: 0,0:22:40.74,0:22:43.63,JP_ED,NTP,0000,0000,0000,,Қолыңызды созсаңыз, ол жоғалады
Dialogue: 0,0:22:43.86,0:22:46.77,JP_ED,NTP,0000,0000,0000,,Өтпелі арманда
Dialogue: 0,0:22:47.00,0:22:49.44,JP_ED,NTP,0000,0000,0000,,Көрінбейтін махаббатты жасыру
Dialogue: 0,0:22:49.62,0:22:52.37,JP_ED,NTP,0000,0000,0000,,Жалғыз күліңіз
Dialogue: 0,0:22:52.94,0:22:56.16,JP_ED,NTP,0000,0000,0000,,Айдың қуыс сәулесін бақылау
Dialogue: 0,0:22:56.18,0:22:59.14,JP_ED,NTP,0000,0000,0000,,Сол серпімді саусақтардың ұштарына
Dialogue: 0,0:22:59.22,0:23:03.00,JP_ED,NTP,0000,0000,0000,,Бәрі шешіліп, саған сеніп тапсырылған.
Dialogue: 0,0:23:03.97,0:23:07.38,JP_ED,NTP,0000,0000,0000,,Әй, әр жанған айғай
Dialogue: 0,0:23:07.59,0:23:13.46,JP_ED,NTP,0000,0000,0000,,Жіпсіз күй жұмаққа шақырады
Dialogue: 0,0:23:13.61,0:23:19.65,JP_ED,NTP,0000,0000,0000,,Мәңгілік естеліктер бір-бірімен әдемі өрілгені сонша, ән салады
Dialogue: 0,0:23:19.79,0:23:24.98,JP_ED,NTP,0000,0000,0000,,Сезімімнің шықы сені іздейді
Dialogue: 0,0:23:25.32,0:23:29.66,JP_ED,NTP,0000,0000,0000,,Өлмей-ақ мына аспанды боя
Dialogue: 0,0:23:29.95,0:23:36.19,JP_ED,NTP,0000,0000,0000,,Ол жарқырай береді
Dialogue: 0,0:24:17.44,0:24:23.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory