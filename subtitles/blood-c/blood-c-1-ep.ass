Dialogue: 0,0:00:03.00,0:00:09.71,诸神字幕组显示,NTP,0000,0000,0000,,Бұл субтитрді Yushujin Subtitles Group (kamigami.org) шығарған және білім беру және алмасу мақсаттарына арналған. Бұл Киёши Вакаенің түпнұсқа жұмысы және фильмнің түпнұсқа нұсқасын автор қолдайды.
Dialogue: 0,0:02:41.69,0:02:45.81,成员名显示,NTP,0000,0000,0000,,：  ： ： ：akira ： ：
Dialogue: 0,0:00:16.07,0:00:20.04,日文对话,NTP,0000,0000,0000,,Адамды не етеді деп ойлайсыңдар?
Dialogue: 0,0:00:22.56,0:00:24.30,日文对话,NTP,0000,0000,0000,,Мен ет пен қанды айтып тұрған жоқпын.
Dialogue: 0,0:00:25.93,0:00:27.74,日文对话,NTP,0000,0000,0000,,Сыртқы түрі Пішін оның бөлігі болғанымен
Dialogue: 0,0:00:28.84,0:00:30.14,日文对话,NTP,0000,0000,0000,,Қазір не істегіңіз келеді?
Dialogue: 0,0:00:31.53,0:00:34.48,日文对话,NTP,0000,0000,0000,,Бұл ішкі бет деп аталатын бөлік туралы.
Dialogue: 0,0:00:37.14,0:00:38.80,日文对话,NTP,0000,0000,0000,,Меншік деп те атауға болады
Dialogue: 0,0:00:40.60,0:00:44.83,日文对话,NTP,0000,0000,0000,,Бұл туа біткен қасиет пе?
Dialogue: 0,0:00:45.99,0:00:50.50,日文对话,NTP,0000,0000,0000,,Немесе кейін ол қалай тәрбиеленді?
Dialogue: 0,0:00:53.19,0:00:57.24,日文对话,NTP,0000,0000,0000,,Адамдар «оған» туады ма?
Dialogue: 0,0:00:58.56,0:01:02.70,日文对话,NTP,0000,0000,0000,,Әлде ол «ол» бола ма?
Dialogue: 0,0:01:04.22,0:01:09.47,日文对话,NTP,0000,0000,0000,,Жауап...
Dialogue: 0,0:01:22.08,0:01:24.51,JP_ED,NTP,0000,0000,0000,,Осы түнде қыдырудың түсуі
Dialogue: 0,0:01:24.91,0:01:27.43,JP_ED,NTP,0000,0000,0000,,Мен өмір сүргім келеді, бірақ мен жоғалдым
Dialogue: 0,0:01:27.69,0:01:32.48,JP_ED,NTP,0000,0000,0000,,Қайта оралуға болмайтын өткен және сіз білетініңізге күмәнданбайсыз ба
Dialogue: 0,0:01:33.62,0:01:35.93,JP_ED,NTP,0000,0000,0000,,Мен сенетін барлық нәрселер
Dialogue: 0,0:01:36.11,0:01:38.79,JP_ED,NTP,0000,0000,0000,,Шындықты көргім келмейтін қара күндер
Dialogue: 0,0:01:38.98,0:01:44.20,JP_ED,NTP,0000,0000,0000,,Сіз бара алмайтын жағдайлар қайда барарыңызды білмейсіз
Dialogue: 0,0:01:44.33,0:01:46.44,JP_ED,NTP,0000,0000,0000,,Үміттің де жалған екенін білесің бе?
Dialogue: 0,0:01:47.08,0:01:49.19,JP_ED,NTP,0000,0000,0000,,және бұл заклинание тек құдайлардың ақиқаты болып табылады
Dialogue: 0,0:01:49.71,0:01:54.77,JP_ED,NTP,0000,0000,0000,,Қараңғылықты кесіп өт
Dialogue: 0,0:01:55.23,0:01:57.97,JP_ED,NTP,0000,0000,0000,,Шексіздік сызығы неге қан кету керек
Dialogue: 0,0:01:58.12,0:02:00.89,JP_ED,NTP,0000,0000,0000,,менің меланхолиямды көтеріп
Dialogue: 0,0:02:01.06,0:02:03.75,JP_ED,NTP,0000,0000,0000,,тезірек келдім деп айта алмаймын
Dialogue: 0,0:02:03.82,0:02:05.02,JP_ED,NTP,0000,0000,0000,,себебі мен жасаймын
Dialogue: 0,0:02:05.28,0:02:06.24,JP_ED,NTP,0000,0000,0000,,ешқашан аяқталмайды
Dialogue: 0,0:02:06.78,0:02:08.61,JP_ED,NTP,0000,0000,0000,,менің croixтегі чипсы
Dialogue: 0,0:02:09.03,0:02:11.33,JP_ED,NTP,0000,0000,0000,,бұл мен өлу мүмкін емес болғандықтан
Dialogue: 0,0:02:11.97,0:02:14.77,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс орындалмайды
Dialogue: 0,0:02:15.17,0:02:16.27,JP_ED,NTP,0000,0000,0000,,Қазіргі уақытта жарқыраған жарық
Dialogue: 0,0:02:16.43,0:02:20.35,JP_ED,NTP,0000,0000,0000,,Бұл менің шындықты алып жүретін соңғы күшім
Dialogue: 0,0:02:20.71,0:02:23.53,JP_ED,NTP,0000,0000,0000,,Еш ауыртпалық жоқ, пайда жоқ Абсолютті әділдік
Dialogue: 0,0:02:23.68,0:02:26.14,JP_ED,NTP,0000,0000,0000,,Себебін оқысаңыз және
Dialogue: 0,0:02:26.24,0:02:28.45,JP_ED,NTP,0000,0000,0000,,Мен шамымды қойдым
Dialogue: 0,0:02:28.65,0:02:31.22,JP_ED,NTP,0000,0000,0000,,Апокалипсис біреуді білу керек
Dialogue: 0,0:02:31.66,0:02:34.41,JP_ED,NTP,0000,0000,0000,,Бұл ұсыныс өзгеріссіз қалады.
Dialogue: 0,0:02:34.84,0:02:37.16,JP_ED,NTP,0000,0000,0000,,у...
Dialogue: 0,0:03:09.76,0:03:12.06,日文对话,NTP,0000,0000,0000,,Мен оны жақын арада аламын деп ойлаймын.
Dialogue: 0,0:03:14.05,0:03:14.71,日文对话,NTP,0000,0000,0000,,Сол жарық...
Dialogue: 0,0:03:16.63,0:03:18.76,日文对话,NTP,0000,0000,0000,,Жарық нені білдіреді?
Dialogue: 0,0:03:21.82,0:03:22.88,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:03:26.82,0:03:27.57,日文对话,NTP,0000,0000,0000,,Әй, әке.
Dialogue: 0,0:03:30.21,0:03:31.38,日文对话,NTP,0000,0000,0000,,Сая
Dialogue: 0,0:03:32.44,0:03:35.52,日文对话,NTP,0000,0000,0000,,Ештеңе етпейді, Сая мықты.
Dialogue: 0,0:03:36.62,0:03:37.86,日文对话,NTP,0000,0000,0000,,Мен оның төзімді екенін білемін.
Dialogue: 0,0:03:38.26,0:03:40.24,日文对话,NTP,0000,0000,0000,,Қыздар мұны қайта-қайта жасайды.
Dialogue: 0,0:03:40.56,0:03:43.33,日文对话,NTP,0000,0000,0000,,Мен біреудің бетінен ұру дұрыс емес деп ойлаймын.
Dialogue: 0,0:03:44.43,0:03:46.04,日文对话,NTP,0000,0000,0000,,Қайта-қайта емес
Dialogue: 0,0:03:46.75,0:03:47.65,日文对话,NTP,0000,0000,0000,,Бет...
Dialogue: 0,0:03:48.09,0:03:51.73,日文对话,NTP,0000,0000,0000,,Құлау, соғу, құлау, бет болмаса да
Dialogue: 0,0:03:52.02,0:03:53.89,日文对话,NTP,0000,0000,0000,,Сақ болу ешқашан жақсы емес
Dialogue: 0,0:03:55.85,0:03:58.13,日文对话,NTP,0000,0000,0000,,Кешіріңіз, әке.
Dialogue: 0,0:03:59.30,0:04:02.01,日文对话,NTP,0000,0000,0000,,Жарайды, менің ойымша, ол соншалықты мұқият отырды.
Dialogue: 0,0:04:02.55,0:04:03.39,日文对话,NTP,0000,0000,0000,,Таң намазы?
Dialogue: 0,0:04:04.27,0:04:07.16,日文对话,NTP,0000,0000,0000,,Иә, сонымен қатар жарық бар...
Dialogue: 0,0:04:08.06,0:04:09.14,日文对话,NTP,0000,0000,0000,,Түсіндіңіз бе?
Dialogue: 0,0:04:09.60,0:04:13.52,日文对话,NTP,0000,0000,0000,,Жоқ, қолымды созсам да қашып кетеді.
Dialogue: 0,0:04:15.77,0:04:19.01,日文对话,NTP,0000,0000,0000,,Мен бұл жерді жиі көремін.
Dialogue: 0,0:04:19.30,0:04:22.62,日文对话,NTP,0000,0000,0000,,Иә, есімде қалғандай.
Dialogue: 0,0:04:24.05,0:04:26.67,日文对话,NTP,0000,0000,0000,,Бірақ мен әлі түсінбеймін
Dialogue: 0,0:04:30.18,0:04:32.37,日文对话,NTP,0000,0000,0000,,Әулие қыз болған анаң,
Dialogue: 0,0:04:32.86,0:04:35.86,日文对话,NTP,0000,0000,0000,,Ол арман мен шындықтың арасындағы алшақтықта оракуль алды.
Dialogue: 0,0:04:36.39,0:04:38.34,日文对话,NTP,0000,0000,0000,,Сіз көріп тұрған жарық
Dialogue: 0,0:04:39.00,0:04:41.90,日文对话,NTP,0000,0000,0000,,Ол сізге келесі әрекеттерді көрсетуі мүмкін.
Dialogue: 0,0:04:42.27,0:04:44.93,日文对话,NTP,0000,0000,0000,,Бұл сіздің «жұмысыңызды» орындауға көмектеседі
Dialogue: 0,0:04:45.88,0:04:48.36,日文对话,NTP,0000,0000,0000,,Асықпаудың қажеті жоқ.
Dialogue: 0,0:04:48.94,0:04:50.50,日文对话,NTP,0000,0000,0000,,Егер сіз бірдеңені байқасаңыз
Dialogue: 0,0:04:51.85,0:04:54.96,日文对话,NTP,0000,0000,0000,,Иә, алдымен әкеме хабарлаймын.
Dialogue: 0,0:04:55.10,0:04:56.47,日文对话,NTP,0000,0000,0000,,Атона Сая
Dialogue: 0,0:04:56.47,0:04:57.24,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:58.86,0:05:00.40,日文对话,NTP,0000,0000,0000,,Жаныңызда таңғы ас ішсеңіз
Dialogue: 0,0:05:00.91,0:05:02.30,日文对话,NTP,0000,0000,0000,,Қазір киіміңді ауыстырма.
Dialogue: 0,0:05:02.56,0:05:04.34,日文对话,NTP,0000,0000,0000,,Бұл жаман уақыт емес пе?
Dialogue: 0,0:05:07.81,0:05:09.54,强调,NTP,0000,0000,0000,,1 эпизод Тентсуфу
Dialogue: 0,0:05:32.52,0:05:38.10,日文对话,NTP,0000,0000,0000,,Хаха, мұрныңның ұшын тағы тырнап жатырсың.
Dialogue: 0,0:05:39.14,0:05:41.95,日文对话,NTP,0000,0000,0000,,Мүмкін мен де солай шығармын?
Dialogue: 0,0:05:42.51,0:05:46.19,日文对话,NTP,0000,0000,0000,,Иә...Мен біраз дүрбелең бала сияқтымын.
Dialogue: 0,0:05:47.10,0:05:50.33,日文对话,NTP,0000,0000,0000,,Сіз шынымен де әкеңізге қиындық туғызып жатырсыз.
Dialogue: 0,0:05:50.66,0:05:54.16,日文对话,NTP,0000,0000,0000,,Юйоши үшін де солай шығар, өйткені ол көп уақытты алады.
Dialogue: 0,0:05:55.36,0:05:58.26,日文对话,NTP,0000,0000,0000,,Әлі де қыңыр және икемсіз
Dialogue: 0,0:05:58.54,0:06:01.59,日文对话,NTP,0000,0000,0000,,Жоқ, әке адал, мейірімді.
Dialogue: 0,0:06:01.83,0:06:03.41,日文对话,NTP,0000,0000,0000,,Сондай-ақ, ол берік.
Dialogue: 0,0:06:04.11,0:06:07.80,日文对话,NTP,0000,0000,0000,,Сайо-чан әкесін шынымен жақсы көреді.
Dialogue: 0,0:06:08.56,0:06:09.97,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:06:11.02,0:06:14.10,日文对话,NTP,0000,0000,0000,,Әкеме көбірек көмектесер едім.
Dialogue: 0,0:06:15.43,0:06:17.85,日文对话,NTP,0000,0000,0000,,Мен не істесем де әлі жетілмегенмін.
Dialogue: 0,0:06:18.57,0:06:22.30,日文对话,NTP,0000,0000,0000,,Бұл дұрыс емес, Сайо-чан барын салып жатыр.
Dialogue: 0,0:06:22.50,0:06:23.82,日文对话,NTP,0000,0000,0000,,Өте
Dialogue: 0,0:06:25.51,0:06:28.01,日文对话,NTP,0000,0000,0000,,Ал, кететін уақыт.
Dialogue: 0,0:06:28.23,0:06:29.29,日文对话,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:30.02,0:06:34.16,日文对话,NTP,0000,0000,0000,,Сізде 10 минут қалды, асықпаңыз және ішпеңіз.
Dialogue: 0,0:06:51.03,0:06:54.27,日文对话,NTP,0000,0000,0000,,Бүгін ауа-райы жақсы
Dialogue: 0,0:06:55.19,0:07:00.94,日文对话,NTP,0000,0000,0000,,Аспан кең, көк, кең
Dialogue: 0,0:07:01.13,0:07:05.85,日文对话,NTP,0000,0000,0000,,Дәмді кофе қосылған тосттар мен жұмыртқалар
Dialogue: 0,0:07:06.43,0:07:12.05,日文对话,NTP,0000,0000,0000,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:07:13.39,0:07:16.78,日文对话,NTP,0000,0000,0000,,Бүгін де ауа райы жақсы
Dialogue: 0,0:07:18.69,0:07:20.82,日文对话,NTP,0000,0000,0000,,Мен дұрыс ояндым
Dialogue: 0,0:07:21.11,0:07:23.45,日文对话,NTP,0000,0000,0000,,Мен жұмыс істей алдым.
Dialogue: 0,0:07:23.80,0:07:25.95,日文对话,NTP,0000,0000,0000,,Көбелектердің ұшуы
Dialogue: 0,0:07:26.42,0:07:28.50,日文对话,NTP,0000,0000,0000,,Аби шығармашылығы
Dialogue: 0,0:07:28.88,0:07:34.72,日文对话,NTP,0000,0000,0000,,Өте жақсы сезім
Dialogue: 0,0:07:36.27,0:07:39.43,日文对话,NTP,0000,0000,0000,,Бүгін ауа-райы жақсы
Dialogue: 0,0:07:41.01,0:07:43.57,日文对话,NTP,0000,0000,0000,,Бұл өте жұмсақ
Dialogue: 0,0:07:43.92,0:07:46.26,日文对话,NTP,0000,0000,0000,,Бұл өте босаңсытады
Dialogue: 0,0:07:54.05,0:07:55.55,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:58.99,0:08:00.69,日文对话,NTP,0000,0000,0000,,Бүгін уақытында орындадың.
Dialogue: 0,0:08:01.03,0:08:02.71,日文对话,NTP,0000,0000,0000,,түн
Dialogue: 0,0:08:02.85,0:08:04.74,日文对话,NTP,0000,0000,0000,,Бүгін жоғалған балалар болған жоқ.
Dialogue: 0,0:08:05.88,0:08:08.26,日文对话,NTP,0000,0000,0000,,Бүгін бірде-бір әже қиналған жоқ.
Dialogue: 0,0:08:08.50,0:08:09.30,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:09.34,0:08:12.02,日文对话,NTP,0000,0000,0000,,Жолда тек қоқыс шашылған.
Dialogue: 0,0:08:12.36,0:08:15.42,日文对话,NTP,0000,0000,0000,,Сіз мұны түсінбедіңіз деп ойлаймын.
Dialogue: 0,0:08:15.58,0:08:16.40,日文对话,NTP,0000,0000,0000,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:08:16.60,0:08:19.27,日文对话,NTP,0000,0000,0000,,Оны тазалау машинасына апармайынша жасай алмайсыз.
Dialogue: 0,0:08:19.64,0:08:22.62,日文对话,NTP,0000,0000,0000,,Бірақ мен бәрін қоқыс төгетін жерге жинадым.
Dialogue: 0,0:08:22.80,0:08:23.90,日文对话,NTP,0000,0000,0000,,Мен бәрі жақсы болатынына сенімдімін
Dialogue: 0,0:08:23.98,0:08:25.21,日文对话,NTP,0000,0000,0000,,Ахока
Dialogue: 0,0:08:25.70,0:08:29.62,日文对话,NTP,0000,0000,0000,,Күн сайын көшеде бір қиыншылыққа тап болып, кешігіп қаламын.
Dialogue: 0,0:08:29.85,0:08:31.29,日文对话,NTP,0000,0000,0000,,Сіз қаншалықты мейірімдісіз?
Dialogue: 0,0:08:32.22,0:08:34.51,日文对话,NTP,0000,0000,0000,,Мен бүгін кешіккен жоқпын.
Dialogue: 0,0:08:34.59,0:08:36.15,日文对话,NTP,0000,0000,0000,,Бұл тек бүгінгі күн туралы емес.
Dialogue: 0,0:08:36.44,0:08:39.20,日文对话,NTP,0000,0000,0000,,Неліктен аптасына екі күн кешігіп келесіз?
Dialogue: 0,0:08:40.58,0:08:41.55,日文对话,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:42.11,0:08:43.89,日文对话,NTP,0000,0000,0000,,Менен кешірім сұраудың мәні жоқ.
Dialogue: 0,0:08:44.27,0:08:45.56,日文对话,NTP,0000,0000,0000,,Юка-чан қорқынышты
Dialogue: 0,0:08:45.83,0:08:47.36,日文对话,NTP,0000,0000,0000,,Тәрбиеші ана сияқты қорқынышты
Dialogue: 0,0:08:47.66,0:08:48.63,日文对话,NTP,0000,0000,0000,,Не болса да
Dialogue: 0,0:08:51.18,0:08:52.60,日文对话,NTP,0000,0000,0000,,Ет...
Dialogue: 0,0:08:53.15,0:08:54.62,日文对话,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:08:55.10,0:08:56.20,日文对话,NTP,0000,0000,0000,,Жоқ, ол табиғи жау.
Dialogue: 0,0:08:56.22,0:08:57.66,日文对话,NTP,0000,0000,0000,,Жақын арада мұғалім келеді.
Dialogue: 0,0:08:57.99,0:08:59.53,日文对话,NTP,0000,0000,0000,,А...осындай шу шығарғаны үшін кешіріңіз.
Dialogue: 0,0:08:59.71,0:09:02.10,日文对话,NTP,0000,0000,0000,,Жоқ, қызықты болғандықтан көргім келді.
Dialogue: 0,0:09:02.32,0:09:03.01,日文对话,NTP,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:09:03.14,0:09:04.19,日文对话,NTP,0000,0000,0000,,Бұл жолы емес
Dialogue: 0,0:09:04.66,0:09:07.37,日文对话,NTP,0000,0000,0000,,Өйткені комедияда покинг маңызды.
Dialogue: 0,0:09:07.43,0:09:08.81,日文对话,NTP,0000,0000,0000,,Кім жауапты?
Dialogue: 0,0:09:08.94,0:09:10.10,日文对话,NTP,0000,0000,0000,,Жақсы соққы
Dialogue: 0,0:09:10.85,0:09:13.16,日文对话,NTP,0000,0000,0000,,Иә, бұл қызықты көрінеді.
Dialogue: 0,0:09:13.23,0:09:14.43,日文对话,NTP,0000,0000,0000,,Үй бөлмесі
Dialogue: 0,0:09:15.97,0:09:18.30,日文对话,NTP,0000,0000,0000,,Келесі жолы түскі үзіліс кезінде жалғастырыңыз.
Dialogue: 0,0:09:18.40,0:09:19.70,日文对话,NTP,0000,0000,0000,,Канако мырзаға
Dialogue: 0,0:09:20.89,0:09:22.62,日文对话,NTP,0000,0000,0000,,Алға ұмтылу да маңызды.
Dialogue: 0,0:09:22.93,0:09:24.48,日文对话,NTP,0000,0000,0000,,Бұлыңғырлық та маңызды
Dialogue: 0,0:09:26.51,0:09:30.03,日文对话,NTP,0000,0000,0000,,Токима-кун, сен мақтанышпен кешігіп қалдың.
Dialogue: 0,0:09:31.19,0:09:32.73,日文对话,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:33.16,0:09:34.94,日文对话,NTP,0000,0000,0000,,Бұл шын жүректен емес.
Dialogue: 0,0:09:36.52,0:09:40.10,日文对话,NTP,0000,0000,0000,,Енді уәде етілген қоңырауды аламыз ба?
Dialogue: 0,0:09:40.97,0:09:42.76,日文对话,NTP,0000,0000,0000,,Түнді өзгерту
Dialogue: 0,0:09:43.19,0:09:44.22,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:09:44.42,0:09:45.84,日文对话,NTP,0000,0000,0000,,Бар болғаны
Dialogue: 0,0:09:46.73,0:09:48.16,日文对话,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:49.96,0:09:52.41,日文对话,NTP,0000,0000,0000,,Мұғалім, бұл бұлыңғырлыққа түсу қиын.
Dialogue: 0,0:10:20.77,0:10:22.58,日文对话,NTP,0000,0000,0000,,Әдеттегідей салқын
Dialogue: 0,0:10:22.66,0:10:24.05,日文对话,NTP,0000,0000,0000,,Сайо-чан - ең жақсы!
Dialogue: 0,0:10:24.98,0:10:26.42,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:10:26.93,0:10:29.01,日文对话,NTP,0000,0000,0000,,Бірақ ол шынымен де спортшы.
Dialogue: 0,0:10:29.25,0:10:30.80,日文对话,NTP,0000,0000,0000,,Баяғыда ма?
Dialogue: 0,0:10:31.17,0:10:33.30,日文对话,NTP,0000,0000,0000,,Иә, көп өзгермейді деп ойлаймын.
Dialogue: 0,0:10:33.52,0:10:35.97,日文对话,NTP,0000,0000,0000,,Спорт күнін өткізу керемет болар еді.
Dialogue: 0,0:10:36.09,0:10:37.70,日文对话,NTP,0000,0000,0000,,Менің отбасым өте қуанышты
Dialogue: 0,0:10:38.19,0:10:41.04,日文对话,NTP,0000,0000,0000,,Жоқ, әкем әулиелікпен айналысады.
Dialogue: 0,0:10:41.56,0:10:44.07,日文对话,NTP,0000,0000,0000,,Менің анам жоқ
Dialogue: 0,0:10:45.61,0:10:46.78,日文对话,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:10:47.26,0:10:50.14,日文对话,NTP,0000,0000,0000,,Кешірім сұрайтын ештеңе жоқ
Dialogue: 0,0:10:50.45,0:10:53.51,日文对话,NTP,0000,0000,0000,,Анамның бастауыш мектепке барғаны рас.
Dialogue: 0,0:10:53.65,0:10:54.83,日文对话,NTP,0000,0000,0000,,Ол өлсе де
Dialogue: 0,0:10:55.34,0:10:58.01,日文对话,NTP,0000,0000,0000,,Фумито-сан оның орнына түскі қорап жасады.
Dialogue: 0,0:10:58.19,0:10:59.99,日文对话,NTP,0000,0000,0000,,Себебі сен бізді қолдауға келдің.
Dialogue: 0,0:11:00.28,0:11:02.49,日文对话,NTP,0000,0000,0000,,Ол көрші кафенің қожайыны.
Dialogue: 0,0:11:02.62,0:11:06.52,日文对话,NTP,0000,0000,0000,,Иә, әкем екеуміз тамақ жасай алмаймыз.
Dialogue: 0,0:11:06.88,0:11:09.76,日文对话,NTP,0000,0000,0000,,Әрдайым түрлі заттар жасап, маған әкеліп отырады.
Dialogue: 0,0:11:10.12,0:11:10.91,日文对话,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:11.17,0:11:14.36,日文对话,NTP,0000,0000,0000,,Әкең де, жазушы да жақсы адамдар.
Dialogue: 0,0:11:15.77,0:11:16.92,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:25.64,0:11:27.10,日文对话,NTP,0000,0000,0000,,Чанги мырза
Dialogue: 0,0:11:28.87,0:11:29.68,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:30.08,0:11:33.08,日文对话,NTP,0000,0000,0000,,Қарсы болмасаң, мен сенімен үйге бармаймын.
Dialogue: 0,0:11:33.61,0:11:37.15,日文对话,NTP,0000,0000,0000,,Мен дәмді торттар бар дүкен таптым.
Dialogue: 0,0:11:38.03,0:11:39.99,日文对话,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:11:40.14,0:11:42.37,日文对话,NTP,0000,0000,0000,,Бірақ ертең мереке.
Dialogue: 0,0:11:42.43,0:11:44.79,日文对话,NTP,0000,0000,0000,,Мен ертерек үйге барып, әкеме көмектесуім керек.
Dialogue: 0,0:11:45.52,0:11:47.81,日文对话,NTP,0000,0000,0000,,Түсінемін, бұл ұят.
Dialogue: 0,0:11:48.18,0:11:51.61,日文对话,NTP,0000,0000,0000,,Мен де дәмді тортты жей алмағаныма өкінемін.
Dialogue: 0,0:11:52.44,0:11:53.70,日文对话,NTP,0000,0000,0000,,Тек осы ма?
Dialogue: 0,0:11:54.02,0:11:54.83,日文对话,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:11:54.92,0:11:58.45,日文对话,NTP,0000,0000,0000,,А...жоқ, үйге барғанда абай бол.
Dialogue: 0,0:11:58.67,0:12:01.46,日文对话,NTP,0000,0000,0000,,Иә, Сая төраға, сақ болыңыз.
Dialogue: 0,0:12:03.02,0:12:03.90,日文对话,NTP,0000,0000,0000,,Әй...
Dialogue: 0,0:12:04.01,0:12:05.50,日文对话,NTP,0000,0000,0000,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:12:07.67,0:12:09.75,日文对话,NTP,0000,0000,0000,,Иә, ертең кездескенше
Dialogue: 0,0:13:23.28,0:13:25.66,日文对话,NTP,0000,0000,0000,,«Ақымақ» картасының белгісін арқалаған Рух толқыны қолданушысы.
Dialogue: 0,0:13:34.97,0:13:36.92,日文对话,NTP,0000,0000,0000,,Тезірек үйге баруым керек.
Dialogue: 0,0:13:58.38,0:13:59.42,日文对话,NTP,0000,0000,0000,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:14:06.93,0:14:10.17,日文对话,NTP,0000,0000,0000,,«Жұмыс»...?
Dialogue: 0,0:14:12.54,0:14:13.42,日文对话,NTP,0000,0000,0000,,Үлкен залға
Dialogue: 0,0:14:45.60,0:14:48.35,日文对话,NTP,0000,0000,0000,,Ежелгі зат пайда болған кезде пайда болды.
Dialogue: 0,0:14:48.70,0:14:50.53,日文对话,NTP,0000,0000,0000,,Бұл багуа.
Dialogue: 0,0:14:51.04,0:14:55.26,日文对话,NTP,0000,0000,0000,,Фестиваль алдында орындалған берекелі багуада пайда болды.
Dialogue: 0,0:14:55.41,0:14:56.75,日文对话,NTP,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:15:12.88,0:15:15.59,日文对话,NTP,0000,0000,0000,,Саяны басыңыз
Dialogue: 0,0:16:23.75,0:16:28.71,日文对话,NTP,0000,0000,0000,,Тірі жан, аяқ жан, доп жан
Dialogue: 0,0:16:29.57,0:16:32.01,日文对话,NTP,0000,0000,0000,,Көктегі Мәңгілік Құдай
Dialogue: 0,0:16:33.36,0:16:35.78,日文对话,NTP,0000,0000,0000,,Ұлттық Мәңгілік Құдай
Dialogue: 0,0:20:56.96,0:20:58.71,日文对话,NTP,0000,0000,0000,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:21:00.60,0:21:01.67,日文对话,NTP,0000,0000,0000,,Жарақат бар ма?
Dialogue: 0,0:21:01.80,0:21:03.27,日文对话,NTP,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:21:03.44,0:21:05.85,日文对话,NTP,0000,0000,0000,,Ежелгі нәрсені жеңдім.
Dialogue: 0,0:21:06.08,0:21:08.72,日文对话,NTP,0000,0000,0000,,Иә, жақсы орындадың, Сая.
Dialogue: 0,0:21:09.63,0:21:12.14,日文对话,NTP,0000,0000,0000,,Енді қасиетті қылышыңды тазарт.
Dialogue: 0,0:21:12.53,0:21:13.79,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:15.28,0:21:17.80,日文对话,NTP,0000,0000,0000,,Сая не болды?
Dialogue: 0,0:21:17.81,0:21:19.02,日文对话,NTP,0000,0000,0000,,Жоқ…
Dialogue: 0,0:21:24.16,0:21:25.53,日文对话,NTP,0000,0000,0000,,Менің қолым...
Dialogue: 0,0:21:27.75,0:21:31.48,日文对话,NTP,0000,0000,0000,,Мен оны тым қатты ұстадым деп ойлаймын.
Dialogue: 0,0:21:46.72,0:21:48.15,日文对话,NTP,0000,0000,0000,,Сая?
Dialogue: 0,0:21:48.36,0:21:50.11,日文对话,NTP,0000,0000,0000,,Қайырлы таң, Камилла.
Dialogue: 0,0:21:50.52,0:21:54.48,日文对话,NTP,0000,0000,0000,,Жүр, монша қайнап жатыр. Киіміңді ауыстыр.
Dialogue: 0,0:21:55.57,0:21:57.24,日文对话,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:22:29.12,0:22:34.65,JP_ED,NTP,0000,0000,0000,,Бұлыңғыр түнге ағып жатқан дөрекі дауыс
Dialogue: 0,0:22:34.94,0:22:40.13,JP_ED,NTP,0000,0000,0000,,Туған жерді жеңіл билеу
Dialogue: 0,0:22:40.74,0:22:43.63,JP_ED,NTP,0000,0000,0000,,Қолыңызды созсаңыз, ол жоғалады
Dialogue: 0,0:22:43.86,0:22:46.77,JP_ED,NTP,0000,0000,0000,,Өтпелі түсте
Dialogue: 0,0:22:47.00,0:22:49.44,JP_ED,NTP,0000,0000,0000,,Көрінбейтін махаббатқа көлеңке түсіру
Dialogue: 0,0:22:49.62,0:22:52.37,JP_ED,NTP,0000,0000,0000,,Жалғыз күліңіз
Dialogue: 0,0:22:52.94,0:22:56.16,JP_ED,NTP,0000,0000,0000,,Айдың қуыс сәулесін бақылау
Dialogue: 0,0:22:56.18,0:22:59.14,JP_ED,NTP,0000,0000,0000,,Сол серпімді саусақтардың ұштарына
Dialogue: 0,0:22:59.22,0:23:03.00,JP_ED,NTP,0000,0000,0000,,Бәрі шешіліп, саған сеніп тапсырылған.
Dialogue: 0,0:23:03.97,0:23:07.38,JP_ED,NTP,0000,0000,0000,,Әй, әр жанған айғай
Dialogue: 0,0:23:07.59,0:23:13.46,JP_ED,NTP,0000,0000,0000,,Есілмес әуен жұмаққа шақырады
Dialogue: 0,0:23:13.61,0:23:19.65,JP_ED,NTP,0000,0000,0000,,Мәңгілік естеліктердің бір-бірімен әдемі өрілгені сонша, олар ән салады
Dialogue: 0,0:23:19.79,0:23:24.98,JP_ED,NTP,0000,0000,0000,,Сезімімнің шықы сені іздейді
Dialogue: 0,0:23:25.32,0:23:29.66,JP_ED,NTP,0000,0000,0000,,Өлмей-ақ мына аспанды боя
Dialogue: 0,0:23:29.95,0:23:36.19,JP_ED,NTP,0000,0000,0000,,Ол жарқырай береді
Dialogue: 0,0:23:47.69,0:23:48.54,日文对话,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:23:49.01,0:23:51.20,日文对话,NTP,0000,0000,0000,,Сая бүгін де сабаққа уақытында келді.
Dialogue: 0,0:23:51.74,0:23:54.45,日文对话,NTP,0000,0000,0000,,Мен күнде кешікпеймін.
Dialogue: 0,0:23:54.69,0:23:57.84,日文对话,NTP,0000,0000,0000,,Қиындыққа тап болған адам немесе күшік, т.б.
Dialogue: 0,0:23:57.97,0:23:59.22,日文对话,NTP,0000,0000,0000,,Тек...
Dialogue: 0,0:23:59.47,0:24:00.27,日文对话,NTP,0000,0000,0000,,Бұл туралы айтатын болсақ
Dialogue: 0,0:24:00.60,0:24:04.72,日文对话,NTP,0000,0000,0000,,Сол кішкентай ит маған жабыса ма?
Dialogue: 0,0:24:05.55,0:24:06.63,日文对话,NTP,0000,0000,0000,,Мүмкін бір күні
Dialogue: 0,0:24:06.75,0:24:07.99,日文对话,NTP,0000,0000,0000,,Мен сені алып, көрсетемін
Dialogue: 0,0:24:08.73,0:24:09.65,日文对话,NTP,0000,0000,0000,,Оған дейін
Dialogue: 0,0:24:09.67,0:24:10.96,日文对话,NTP,0000,0000,0000,,Сая жеңілмейді
Dialogue: 0,0:24:11.88,0:24:15.20,日文对话,NTP,0000,0000,0000,,Келесі жолы Blood-c «Кимигатам»
Dialogue: 0,0:24:16.70,0:24:22.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory