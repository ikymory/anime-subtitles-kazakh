Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:08.50,Default,,0,0,0,,(Аштық Альянсы Grunt)
Dialogue: 0,0:00:14.51,0:00:18.51,Default,,0,0,0,,Сенің осында келгеніңе сене алар емеспін...
Dialogue: 0,0:00:18.51,0:00:21.52,Default,,0,0,0,,Балапандар ұядан шықты.
Dialogue: 0,0:00:21.52,0:00:24.52,Default,,0,0,0,,Қара түсті (көгілдір) жақсы көремін
Dialogue: 0,0:00:24.52,0:00:27.52,Default,,0,0,0,,Оның қолы ұшып кетті.
Dialogue: 0,0:00:27.52,0:00:29.53,Default,,0,0,0,,Мен өліп қала жаздадым.
Dialogue: 0,0:00:29.53,0:00:32.53,Default,,0,0,0,,Менің денем жақсы, бірақ
Dialogue: 0,0:00:32.53,0:00:35.53,Default,,0,0,0,,Қылыш әйтеуір сау емес.
Dialogue: 0,0:00:35.53,0:00:39.54,Default,,0,0,0,,Сіз әлі абайсыз әрекет етесіз.
Dialogue: 0,0:00:39.54,0:00:43.54,Default,,0,0,0,,Мен мұны байланыстырудың себебін қалаймын.
Dialogue: 0,0:00:43.54,0:00:47.54,Default,,0,0,0,,Себебі сен Драмбуи деген жігітті жасаған қылыш суретшісісің.
Dialogue: 0,0:00:47.54,0:00:50.55,Default,,0,0,0,,Бұл затты тек сіз ғана қоса аласыз.
Dialogue: 0,0:00:50.55,0:00:54.55,Default,,0,0,0,,Иә, сен әлі иллюзия шегесің бе?
Dialogue: 0,0:00:55.55,0:00:58.55,Default,,0,0,0,,Фу... (барабан) Бала Шэнди қалай?
Dialogue: 0,0:00:58.55,0:01:00.56,Default,,0,0,0,,Мен енді бала болуға жасым жетпейді.
Dialogue: 0,0:01:00.56,0:01:04.56,Default,,0,0,0,,Гафтың адамы келесі үлкен ағасы патша болады.
Dialogue: 0,0:01:04.56,0:01:08.56,Default,,0,0,0,,Сол бала киелі күлдің қалай жасалатынын біле ме?
Dialogue: 0,0:01:08.56,0:01:10.57,Default,,0,0,0,,Сіз білмедіңіз.
Dialogue: 0,0:01:10.57,0:01:14.57,Default,,0,0,0,,Бірақ оны ашқан адам қамалға кетті.
Dialogue: 0,0:01:14.57,0:01:16.57,Default,,0,0,0,,Парасатты қыз…
Dialogue: 0,0:01:16.57,0:01:19.58,Default,,0,0,0,,Ол мінсіз бала.
Dialogue: 0,0:01:19.58,0:01:24.58,Default,,0,0,0,,Сен жасаған қылышыңды ұстадың және менің барлық ілімдерімді мұра еттің.
Dialogue: 0,0:01:24.58,0:01:29.59,Default,,0,0,0,,Мен қалдырған оның ішіндегі жолбасшы ақырында оны жетелейді.
Dialogue: 0,0:01:29.59,0:01:32.59,Default,,0,0,0,,Ол сізді біз жете алмаған жерлерге апарады.
Dialogue: 0,0:01:32.59,0:01:35.59,Default,,0,0,0,,Ол біздің баламыз.
Dialogue: 0,0:01:36.59,0:01:40.60,Default,,0,0,0,,Бізге ақылға күмәнмен қарайтын адам керек.
Dialogue: 0,0:01:40.60,0:01:42.60,Default,,0,0,0,,Болжам бар ма?
Dialogue: 0,0:01:42.60,0:01:45.60,Default,,0,0,0,,Аштық альянсының өткір мұрны бар.
Dialogue: 0,0:01:45.60,0:01:50.61,Default,,0,0,0,,Ақырында, оның себептері туралы бұл ел де сұралады.
Dialogue: 0,0:01:50.61,0:01:53.61,Default,,0,0,0,,Механикалық құдай да...
Dialogue: 0,0:01:54.61,0:01:57.61,Default,,0,0,0,,Қылыш біткен бойда мен оны саған жеткіземін.
Dialogue: 0,0:01:59.62,0:02:02.62,Default,,0,0,0,,Біз тағы кездесеміз деп үміттенемін.
Dialogue: 0,0:02:04.62,0:02:24.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:24.64,0:02:44.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:44.66,0:03:04.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:04.68,0:03:24.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:24.70,0:03:33.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:34.71,0:03:43.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:43.72,0:03:49.73,Default,,0,0,0,,Төрт салт аттының бірі Келісім рәсімін өткізеді, Киль-Луара!
Dialogue: 0,0:03:49.73,0:03:53.73,Default,,0,0,0,,Мен сені енді осылай көремін деп ойламаппын.
Dialogue: 0,0:03:53.73,0:03:55.73,Default,,0,0,0,,《Кир-Луара…》
Dialogue: 0,0:03:55.73,0:03:58.73,Default,,0,0,0,,《Сол кездегі қылышшы》
Dialogue: 0,0:03:58.73,0:04:01.74,Default,,0,0,0,,《Қарсылас кім болса да, менің жеңілетін ойым жоқ》
Dialogue: 0,0:04:01.74,0:04:06.74,Default,,0,0,0,,《Бірақ енді мен қарғысқа ұшырадым, мен кесіп тастай аламын ба? 》
Dialogue: 0,0:04:06.74,0:04:09.75,Default,,0,0,0,,Тәңір сындырған ескі қылыш көшет болады.
Dialogue: 0,0:04:09.75,0:04:11.75,Default,,0,0,0,,Әзірге біз жаңадан әзірледік
Dialogue: 0,0:04:11.75,0:04:14.75,Default,,0,0,0,,Бұл Ривдо.
Dialogue: 0,0:04:14.75,0:04:17.75,Default,,0,0,0,,Қылыштың сынуы мені күшейтті.
Dialogue: 0,0:04:17.75,0:04:20.76,Default,,0,0,0,,Сол үшін рахмет.
Dialogue: 0,0:04:20.76,0:04:23.76,Default,,0,0,0,,Бұл сен екеуміздің арамыздағы ұрыс.
Dialogue: 0,0:04:23.76,0:04:27.76,Default,,0,0,0,,Түсіндің бе? Мен түссіндім.
Dialogue: 0,0:04:30.77,0:04:33.77,Default,,0,0,0,,Адонис?
Dialogue: 0,0:04:33.77,0:04:38.77,Default,,0,0,0,,Тәңірге ұнау үшін қылыш ойнауды ұнатпайтын шебер сирек.
Dialogue: 0,0:04:38.77,0:04:42.78,Default,,0,0,0,,Солай емес пе? Сіздің сіңліңіздің шәкірті
Dialogue: 0,0:04:42.78,0:04:45.78,Default,,0,0,0,,Бұл шынымен де ғажайып қылыш.
Dialogue: 0,0:04:45.78,0:04:48.78,Default,,0,0,0,,Қоңырау... кішкентай ма?
Dialogue: 0,0:04:53.79,0:04:58.79,Default,,0,0,0,,《Мен сенімен кез келген қиындықты жеңе аламын.》
Dialogue: 0,0:05:00.80,0:05:03.80,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:03.80,0:05:05.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:06.80,0:05:08.80,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:09.81,0:05:11.81,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:05:11.81,0:05:14.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:17.81,0:05:19.82,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:19.82,0:05:21.82,Default,,0,0,0,,Иә
Dialogue: 0,0:05:22.82,0:05:24.82,Default,,0,0,0,,《Бұл керемет дірілдеген қылыш, бірақ...》
Dialogue: 0,0:05:24.82,0:05:26.82,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:27.82,0:05:29.83,Default,,0,0,0,,《Мен жеңілгім келмейді! 》
Dialogue: 0,0:05:29.83,0:05:32.83,Default,,0,0,0,,Ха! Уау
Dialogue: 0,0:05:35.83,0:05:37.83,Default,,0,0,0,,《Мен мұны жасадым...》
Dialogue: 0,0:05:37.83,0:05:39.84,Default,,0,0,0,,Кесілген жоқ...
Dialogue: 0,0:05:39.84,0:05:42.84,Default,,0,0,0,,Қазір үлкен ме? (Айуан адам) Мен шешті деп ойладым.
Dialogue: 0,0:05:42.84,0:05:44.84,Default,,0,0,0,,《Қарғыс...》
Dialogue: 0,0:05:45.84,0:05:48.84,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:05:48.84,0:05:50.85,Default,,0,0,0,,Қиып алмасаң, жеңе алмайсың... (Гүрілдеп)
Dialogue: 0,0:05:50.85,0:05:52.85,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:05:52.85,0:05:56.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:56.85,0:06:00.86,Default,,0,0,0,,《Бұл жалғыз нәрсе...》 Ха!
Dialogue: 0,0:06:07.86,0:06:09.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:10.87,0:06:18.87,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:06:18.87,0:06:20.88,Default,,0,0,0,,Кесу
Dialogue: 0,0:06:23.88,0:06:25.88,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:06:29.89,0:06:32.89,Default,,0,0,0,,《Бұл жалғыз нәрсе》
Dialogue: 0,0:06:32.89,0:06:35.89,Default,,0,0,0,,《Бұл жалғыз》
Dialogue: 0,0:06:35.89,0:06:37.89,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:06:38.89,0:06:40.90,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:06:40.90,0:06:44.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:44.90,0:06:49.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:49.91,0:06:52.91,Default,,0,0,0,,Қылышты сындыру... (Айуан адам) Сене алар емеспін!
Dialogue: 0,0:06:52.91,0:06:55.91,Default,,0,0,0,,Қандай ұятсыз (айуан) қорықпайтын!
Dialogue: 0,0:06:55.91,0:06:57.91,Default,,0,0,0,,Қорқыныштан өртен! Нопперабо!
Dialogue: 0,0:06:57.91,0:06:59.92,Default,,0,0,0,,Қорқыныш сені кешірмейді!
Dialogue: 0,0:06:59.92,0:07:04.92,Default,,0,0,0,,Темір қорқынышы! Қорқынышты темірмен қапталған!
Dialogue: 0,0:07:04.92,0:07:09.93,Default,,0,0,0,,Темір үрейі! Қорқынышты темірмен қапталған!
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0,0,0,,Мен осылай істеймін!
Dialogue: 0,0:07:11.93,0:07:15.93,Default,,0,0,0,,Егер шағымыңыз болса, осында түсіп, менімен соғысыңыз!
Dialogue: 0,0:07:15.93,0:07:18.93,Default,,0,0,0,,Қорқынышты темір жамылғы! Ха...хаха
Dialogue: 0,0:07:18.93,0:07:21.94,Default,,0,0,0,,Қорқынышты темір жамылғы! Хахахахахаха
Dialogue: 0,0:07:21.94,0:07:23.94,Default,,0,0,0,,Ахахахахаха!
Dialogue: 0,0:07:23.94,0:07:25.94,Default,,0,0,0,,Жеңімпазға құрмет!
Dialogue: 0,0:07:25.94,0:07:30.95,Default,,0,0,0,,Келісім жасау рәсіміндегі сынақ орындалды.
Dialogue: 0,0:07:30.95,0:07:34.95,Default,,0,0,0,,Бұл менің жоғалтым. Сен мықтысың.
Dialogue: 0,0:07:38.95,0:07:41.96,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:42.96,0:07:47.96,Default,,0,0,0,,Мен сені қылышшы ретінде қарсы аламын, кішкентай.
Dialogue: 0,0:07:47.96,0:07:51.97,Default,,0,0,0,,Мен қалаға қылыш ойнауға келген жоқпын.
Dialogue: 0,0:07:51.97,0:07:54.97,Default,,0,0,0,,Саяхат есігін қаққан.
Dialogue: 0,0:07:54.97,0:07:58.97,Default,,0,0,0,,Үш тапсырманы күтіңіз.
Dialogue: 0,0:07:58.97,0:08:00.98,Default,,0,0,0,,Қылыш елінің елтаңбасы бойынша
Dialogue: 0,0:08:00.98,0:08:05.98,Default,,0,0,0,,Құдайларды тыныштандыру үшін үш қылышпен ойнау.
Dialogue: 0,0:08:05.98,0:08:08.98,Default,,0,0,0,,Бірақ бұл әлі де жеткіліксіз
Dialogue: 0,0:08:08.98,0:08:11.99,Default,,0,0,0,,Кездейсоқ кездесейік. Кездейсоқтық...?
Dialogue: 0,0:08:11.99,0:08:15.99,Default,,0,0,0,,Қараңдаршы, саған қарғыс жауды
Dialogue: 0,0:08:15.99,0:08:22.00,Default,,0,0,0,,Солай істе, уақыты келгенде батасын аласың.
Dialogue: 0,0:08:26.00,0:08:29.00,Default,,0,0,0,,Не? (Гуфф) Бұл қасиетті күл.
Dialogue: 0,0:08:29.00,0:08:33.01,Default,,0,0,0,,Гафф... Қасиетті күл? Бұл...
Dialogue: 0,0:08:34.01,0:08:36.01,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:36.01,0:08:39.01,Default,,0,0,0,,Жетеді! Қалғанын өзім істеймін!
Dialogue: 0,0:08:39.01,0:08:42.02,Default,,0,0,0,,Не болды? Ол тыртық қалдырады
Dialogue: 0,0:08:42.02,0:08:46.02,Default,,0,0,0,,Ауыруы әп-сәтте басылғандықтан, бұл қорқынышты болды...
Dialogue: 0,0:08:46.02,0:08:48.02,Default,,0,0,0,,Өйткені ол қасиетті күл.
Dialogue: 0,0:08:48.02,0:08:50.03,Default,,0,0,0,,Сізге қайсысын қарызға беруім керек?
Dialogue: 0,0:08:50.03,0:08:54.03,Default,,0,0,0,,《Тіпті ауырсыну саябақтағы өтірік сияқты》
Dialogue: 0,0:08:54.03,0:08:56.03,Default,,0,0,0,,Сіз Кильге қарсы жақсы ойнадыңыз.
Dialogue: 0,0:08:56.03,0:09:00.04,Default,,0,0,0,,Мен де құрметтімін, бірақ...
Dialogue: 0,0:09:00.04,0:09:03.04,Default,,0,0,0,,Қылышшы үшін қылыш оның өмірі.
Dialogue: 0,0:09:03.04,0:09:06.04,Default,,0,0,0,,Аяқ тәрізді көтерілген нәрсе
Dialogue: 0,0:09:06.04,0:09:10.05,Default,,0,0,0,,Бір рет сынған ол өсуін тоқтатады және тек шіриді.
Dialogue: 0,0:09:10.05,0:09:12.05,Default,,0,0,0,,《Мен мұны білемін! 》
Dialogue: 0,0:09:12.05,0:09:14.05,Default,,0,0,0,,《Бірақ кесіп алмасаң
Dialogue: 0,0:09:14.05,0:09:18.05,Default,,0,0,0,,Бұдан былай қарсыластың қылышын сындырудан басқа амалымыз жоқ! 》
Dialogue: 0,0:09:18.05,0:09:20.06,Default,,0,0,0,,Бұл мүлдем бидғат.
Dialogue: 0,0:09:20.06,0:09:24.06,Default,,0,0,0,,Бір нәрсені мәңгілік қайталау
Dialogue: 0,0:09:25.06,0:09:30.07,Default,,0,0,0,,Ол қызды өзімшіл қалауларыңыз үшін құрбан етуге дайынсыз ба?
Dialogue: 0,0:09:30.07,0:09:33.07,Default,,0,0,0,,Құдайдан кек алғың келе ме?
Dialogue: 0,0:09:33.07,0:09:36.07,Default,,0,0,0,,Сені байлаған құдайға
Dialogue: 0,0:09:36.07,0:09:40.08,Default,,0,0,0,,Корольдік отбасында дүниеге келген (Король Рохиде: Зұлым) Діни қызметкерде дүниеге келген
Dialogue: 0,0:09:40.08,0:09:43.08,Default,,0,0,0,,Ұстаз болу арқылы Құдайдан құтылу
Dialogue: 0,0:09:43.08,0:09:47.08,Default,,0,0,0,,Саяхатшы болып елден қашу
Dialogue: 0,0:09:47.08,0:09:51.09,Default,,0,0,0,,Бұл қандай адамды тәрбиелеу керек еді?
Dialogue: 0,0:09:51.09,0:09:56.09,Default,,0,0,0,,Саяхаттың соңында не ұттың?
Dialogue: 0,0:09:58.09,0:10:03.10,Default,,0,0,0,,Мен көремін. Мен осында қоштасу үшін қайтып келдім.
Dialogue: 0,0:10:03.10,0:10:08.10,Default,,0,0,0,,Бізді құрту үшін мұнда қайтып келдің бе?
Dialogue: 0,0:10:08.10,0:10:13.11,Default,,0,0,0,,Ол кісі алысқа барады, ақылды қыз.
Dialogue: 0,0:10:13.11,0:10:18.11,Default,,0,0,0,,Енді сізді шынымен босатудың уақыты келді.
Dialogue: 0,0:10:18.11,0:10:20.12,Default,,0,0,0,,Өлген адам сияқты өмір сүр
Dialogue: 0,0:10:20.12,0:10:23.12,Default,,0,0,0,,Өлгенді ешкім қумайды
Dialogue: 0,0:10:23.12,0:10:26.12,Default,,0,0,0,,Тіпті Құдай
Dialogue: 0,0:10:26.12,0:10:30.13,Default,,0,0,0,,Көгілдір
Dialogue: 0,0:10:36.13,0:10:40.14,Default,,0,0,0,,Қош бол, інім.
Dialogue: 0,0:10:45.14,0:10:50.15,Default,,0,0,0,,(кеміру дыбысы)
Dialogue: 0,0:10:51.15,0:10:54.15,Default,,0,0,0,,О...
Dialogue: 0,0:10:58.15,0:11:02.16,Default,,0,0,0,,Мен көремін. Бұл Философиялық тас па?
Dialogue: 0,0:11:02.16,0:11:05.16,Default,,0,0,0,,Қандай қызық дәм.
Dialogue: 0,0:11:05.16,0:11:07.16,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:11:07.16,0:11:09.16,Default,,0,0,0,,Иә? Utsukeme
Dialogue: 0,0:11:09.16,0:11:13.17,Default,,0,0,0,,Сол себеп-салдар жібін тапсыратын адам бар ма?
Dialogue: 0,0:11:13.17,0:11:16.17,Default,,0,0,0,,Қайта есептеудің қажеті жоқ
Dialogue: 0,0:11:16.17,0:11:18.17,Default,,0,0,0,,Менің Аманеки Шикилерім.
Dialogue: 0,0:11:18.17,0:11:21.18,Default,,0,0,0,,Жақында қауесетті тыңдайық.
Dialogue: 0,0:11:23.18,0:11:25.18,Default,,0,0,0,,Онда?
Dialogue: 0,0:11:27.18,0:11:29.18,Default,,0,0,0,,Қасиетті күл...
Dialogue: 0,0:11:29.18,0:11:31.19,Default,,0,0,0,,Егер Адонис осы қасиетті күлді пайдаланса,
Dialogue: 0,0:11:31.19,0:11:34.19,Default,,0,0,0,,Қылышымыз қайта тіріледі деді.
Dialogue: 0,0:11:34.19,0:11:37.19,Default,,0,0,0,,Бұл рас па? (Тағзым Хитоми тайпасы) Бұл біртүрлі.
Dialogue: 0,0:11:37.19,0:11:41.20,Default,,0,0,0,,Ол біздің зұлымдығымызды сынамақшы дейді...
Dialogue: 0,0:11:41.20,0:11:43.20,Default,,0,0,0,,Бәрі де болады!
Dialogue: 0,0:11:43.20,0:11:45.20,Default,,0,0,0,,Мына қылышты қайта серме
Dialogue: 0,0:11:45.20,0:11:47.20,Default,,0,0,0,,Сол қоян мен Нопперабо баласына
Dialogue: 0,0:11:47.20,0:11:49.20,Default,,0,0,0,,Саған бірдеңе көрсете алсам ғой!
Dialogue: 0,0:11:49.20,0:11:52.21,Default,,0,0,0,,Мына қояннан бір топ заттар бар.
Dialogue: 0,0:11:52.21,0:11:54.21,Default,,0,0,0,,Бұны жем ретінде ал...
Dialogue: 0,0:11:54.21,0:11:56.21,Default,,0,0,0,,Оқпайтындар (Тағзым тайпасы) Әй?
Dialogue: 0,0:11:56.21,0:11:59.21,Default,,0,0,0,,Маған кімді көрсетесің?
Dialogue: 0,0:11:59.21,0:12:01.22,Default,,0,0,0,,Не... Қайдан келдің?
Dialogue: 0,0:12:01.22,0:12:03.22,Default,,0,0,0,,Балалар, сендерге менталды арифметика жеткілікті.
Dialogue: 0,0:12:03.22,0:12:06.22,Default,,0,0,0,,ше? Апыр-ай!
Dialogue: 0,0:12:06.22,0:12:11.23,Default,,0,0,0,,(Садақ көзінің айқайы)
Dialogue: 0,0:12:11.23,0:12:15.23,Default,,0,0,0,,Жану! Жанып жатыр! (Бағзы көз тайпасы) Уау!
Dialogue: 0,0:12:15.23,0:12:18.23,Default,,0,0,0,,Жақсы түндер
Dialogue: 0,0:12:18.23,0:12:21.24,Default,,0,0,0,,Мм. Бұл қылыш елінің ерекшелігі ме?
Dialogue: 0,0:12:21.24,0:12:23.24,Default,,0,0,0,,Қандай бейбақ.
Dialogue: 0,0:12:23.24,0:12:25.24,Default,,0,0,0,,(Аштық Альянсы Grunt)
Dialogue: 0,0:12:25.24,0:12:30.25,Default,,0,0,0,,Хехе, ән айтатын көңілді дауыс сияқты емес пе?
Dialogue: 0,0:12:30.25,0:12:32.25,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:12:32.25,0:12:34.25,Default,,0,0,0,,Менің сүйікті қызым, оңай
Dialogue: 0,0:12:34.25,0:12:37.25,Default,,0,0,0,,Тазарту арманына өзіңізді жұтып қоюға жол бермеңіз.
Dialogue: 0,0:12:37.25,0:12:40.26,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:12:40.76,0:12:43.76,Default,,0,0,0,,Қасиетті күл таңғажайып.
Dialogue: 0,0:12:43.76,0:12:46.76,Default,,0,0,0,,Бұл таңқаларлық және қорқынышты, бірақ мен ризамын.
Dialogue: 0,0:12:46.76,0:12:49.76,Default,,0,0,0,,Емді дер кезінде алғаныма қуаныштымын, иә?
Dialogue: 0,0:12:49.76,0:12:51.77,Default,,0,0,0,,Қазірдің өзінде зұлым қылышшылар бар
Dialogue: 0,0:12:51.77,0:12:53.77,Default,,0,0,0,,Енді төменгі шығыстағы қалаға шабуыл жасайтын уақыт.
Dialogue: 0,0:12:53.77,0:12:55.77,Default,,0,0,0,,Не!?
Dialogue: 0,0:12:55.77,0:12:57.77,Default,,0,0,0,,Ата-анаңның тұратын жері
Dialogue: 0,0:12:57.77,0:12:59.77,Default,,0,0,0,,Нысанаға жақындағалы тұр
Dialogue: 0,0:12:59.77,0:13:01.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:02.78,0:13:05.78,Default,,0,0,0,,Білсең, неге айтпадың!
Dialogue: 0,0:13:05.78,0:13:08.78,Default,,0,0,0,,Бұл заңға қайшы
Dialogue: 0,0:13:08.78,0:13:11.79,Default,,0,0,0,,Шабуылдың жоспары патшаға белгілі болды.
Dialogue: 0,0:13:11.79,0:13:16.79,Default,,0,0,0,,Қылышпен шайқаста тек құдайдың сөздері арқылы таңдалған қылышшылар корпусы ғана айналысады.
Dialogue: 0,0:13:16.79,0:13:19.79,Default,,0,0,0,,Шабуыл жасағаннан кейін, тым кеш! ақымақ!
Dialogue: 0,0:13:19.79,0:13:21.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.80,0:13:23.80,Default,,0,0,0,,Бұдан былай қамалда іріктеу болады.
Dialogue: 0,0:13:23.80,0:13:25.80,Default,,0,0,0,,Сіз мұны күте аласыз ба?
Dialogue: 0,0:13:25.80,0:13:27.80,Default,,0,0,0,,Күтпейсіз бе?
Dialogue: 0,0:13:27.80,0:13:29.80,Default,,0,0,0,,《Мен түсінемін》
Dialogue: 0,0:13:29.80,0:13:33.81,Default,,0,0,0,,《Мен оны Гаффтың позициясынан айта алмаймын, бірақ шындық...''
Dialogue: 0,0:13:33.81,0:13:36.81,Default,,0,0,0,,Мен таңдалмаған болсам ше?
Dialogue: 0,0:13:36.81,0:13:41.82,Default,,0,0,0,,Сіз семсеріңіздің салмағына тең алтын теңге төлейсіз.
Dialogue: 0,0:13:41.82,0:13:44.82,Default,,0,0,0,,Ол кезде мен сынып қалар едім.
Dialogue: 0,0:13:44.82,0:13:47.82,Default,,0,0,0,,Иә
Dialogue: 0,0:13:48.32,0:13:51.33,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,0:13:51.33,0:13:54.33,Default,,0,0,0,,Бұл қандай ойын-сауық?
Dialogue: 0,0:13:55.33,0:13:57.33,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,0:13:57.33,0:14:00.34,Default,,0,0,0,,Ууу... Ууу әке!? Ах...
Dialogue: 0,0:14:00.34,0:14:03.34,Default,,0,0,0,,Мұнда кімдер болды? Қаладағылардың барлығы ше!?
Dialogue: 0,0:14:03.34,0:14:08.34,Default,,0,0,0,,Уф... сырттағы жігіттер мені алып кетті.
Dialogue: 0,0:14:11.35,0:14:13.35,Default,,0,0,0,,《Фермерлерге арналған конкурс》
Dialogue: 0,0:14:13.35,0:14:16.35,Default,,0,0,0,,``Сыртта музыкалық аспаптар мен егін аз''
Dialogue: 0,0:14:16.35,0:14:19.35,Default,,0,0,0,,Менің ойымша, олар аман қалуға тырысады...》
Dialogue: 0,0:14:21.36,0:14:23.36,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:14:24.36,0:14:26.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:27.36,0:14:29.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:29.36,0:14:32.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:32.37,0:14:34.37,Default,,0,0,0,,Уау (Бағдарлы көз тайпасы) Уау
Dialogue: 0,0:14:34.37,0:14:36.37,Default,,0,0,0,,Ах! Уау
Dialogue: 0,0:14:38.37,0:14:41.38,Default,,0,0,0,,Ха (Садақ көз тайпасы) Уау!
Dialogue: 0,0:14:41.38,0:14:44.38,Default,,0,0,0,,Кел! Апыр-ай!
Dialogue: 0,0:14:44.38,0:14:46.38,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:14:46.38,0:14:49.38,Default,,0,0,0,,Ах... Уау (Су мүйіздері) Уау
Dialogue: 0,0:14:49.38,0:14:53.39,Default,,0,0,0,,Ей, сен сондай бәйбішесің. (Тұман) Кеттік!
Dialogue: 0,0:14:53.39,0:14:55.39,Default,,0,0,0,,Ha
Dialogue: 0,0:14:55.39,0:14:58.39,Default,,0,0,0,,Иә! (Тұман) Ааа
Dialogue: 0,0:14:58.39,0:15:02.40,Default,,0,0,0,,Паркке жын бала кірді деп естідім... бірақ твиттер жазбаңыз.
Dialogue: 0,0:15:02.40,0:15:04.40,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:07.40,0:15:10.41,Default,,0,0,0,,Аа... ннн!
Dialogue: 0,0:15:10.41,0:15:13.41,Default,,0,0,0,,Сіз семсеріңізбен белгіні жойдыңыз!
Dialogue: 0,0:15:13.41,0:15:16.41,Default,,0,0,0,,Хмф (ұзын аяқты адамдар) Уау!
Dialogue: 0,0:15:17.41,0:15:22.42,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:15:22.42,0:15:24.42,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:15:26.42,0:15:28.42,Default,,0,0,0,,Кесілген
Dialogue: 0,0:15:30.43,0:15:33.43,Default,,0,0,0,,Қоңырау? А... Анашым!
Dialogue: 0,0:15:33.43,0:15:35.43,Default,,0,0,0,,Бұл сенсің, Белл!
Dialogue: 0,0:15:35.43,0:15:39.43,Default,,0,0,0,,Жақсы, Белл Белл...
Dialogue: 0,0:15:39.43,0:15:41.44,Default,,0,0,0,,Белле әке!
Dialogue: 0,0:15:41.44,0:15:44.44,Default,,0,0,0,,Қайтып келгеніңізге рахмет, Белл.
Dialogue: 0,0:15:45.44,0:15:47.44,Default,,0,0,0,,《Мен қартайдым...》
Dialogue: 0,0:15:47.44,0:15:50.45,Default,,0,0,0,,Әке ана!
Dialogue: 0,0:15:52.45,0:15:55.45,Default,,0,0,0,,Рахмет, қылышшы!
Dialogue: 0,0:15:55.45,0:16:00.46,Default,,0,0,0,,《Әке мен шешенің шын баласы...》
Dialogue: 0,0:16:04.46,0:16:07.46,Default,,0,0,0,,Сенің атың кім, қызым?
Dialogue: 0,0:16:07.46,0:16:09.46,Default,,0,0,0,,Вермут!
Dialogue: 0,0:16:09.46,0:16:13.47,Default,,0,0,0,,《Вермут... Белленің әпкесі дегенді білдіреді...》
Dialogue: 0,0:16:13.47,0:16:15.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:21.48,0:16:23.48,Default,,0,0,0,,Белл, қарсы болмасаң...
Dialogue: 0,0:16:23.48,0:16:27.48,Default,,0,0,0,,Мені өсіргеніңіздің есесін қайтара алғаныма қуаныштымын.
Dialogue: 0,0:16:31.49,0:16:33.49,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.49,0:16:37.49,Default,,0,0,0,,Мен көшпенді боламын
Dialogue: 0,0:16:46.50,0:16:48.50,Default,,0,0,0,,А... жоқ!
Dialogue: 0,0:16:48.50,0:16:50.51,Default,,0,0,0,,Дәл қазір шайқаста...
Dialogue: 0,0:16:53.51,0:16:55.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:16:55.51,0:16:59.51,Default,,0,0,0,,Мен олардың бәрін ақырында жеймін
Dialogue: 0,0:17:01.52,0:17:05.52,Default,,0,0,0,,Сен сондай жынсың ғой, солай ма?
Dialogue: 0,0:17:05.52,0:17:07.52,Default,,0,0,0,,Ио Тұман, бұл не? Бұл дұрыс
Dialogue: 0,0:17:07.52,0:17:09.52,Default,,0,0,0,,Жын бала
Dialogue: 0,0:17:09.52,0:17:11.53,Default,,0,0,0,,Шынымды айтсам, мені ұрдың ба?
Dialogue: 0,0:17:11.53,0:17:13.53,Default,,0,0,0,,Өйткені бұл ренжітпейді.
Dialogue: 0,0:17:13.53,0:17:15.53,Default,,0,0,0,,Бұл маған мүлдем сәйкес келмейді.
Dialogue: 0,0:17:17.03,0:17:20.03,Default,,0,0,0,,Иә? хун
Dialogue: 0,0:17:22.04,0:17:26.04,Default,,0,0,0,,Қоян... саған бізден не керек?
Dialogue: 0,0:17:26.04,0:17:28.04,Default,,0,0,0,,Менің ұрысуға ниетім жоқ.
Dialogue: 0,0:17:28.04,0:17:32.05,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:17:35.55,0:17:37.55,Default,,0,0,0,,Қайырлы кеш, жас ханым.
Dialogue: 0,0:17:37.55,0:17:39.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.56,0:17:43.56,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:17:43.56,0:17:45.56,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:17:45.56,0:17:47.56,Default,,0,0,0,,Мен оны бәрібір таба алмаймын.
Dialogue: 0,0:17:47.56,0:17:51.57,Default,,0,0,0,,Мені серуендеуге апарғыңыз келе ме?
Dialogue: 0,0:17:52.57,0:17:54.57,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:54.57,0:17:56.57,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:17:56.57,0:18:00.58,Default,,0,0,0,,Менің атым Китти.
Dialogue: 0,0:18:00.58,0:18:02.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:02.58,0:18:05.58,Default,,0,0,0,,Мен мұны білемін, Ловерак Белл.
Dialogue: 0,0:18:05.58,0:18:09.58,Default,,0,0,0,,Не? Неге менің атым?
Dialogue: 0,0:18:09.58,0:18:12.59,Default,,0,0,0,,Сіздің орныңызда сізге қамқорлық жасайтын адам бар.
Dialogue: 0,0:18:12.59,0:18:15.59,Default,,0,0,0,,Оның есімі Ештеңе емес Китти.
Dialogue: 0,0:18:15.59,0:18:17.59,Default,,0,0,0,,Бұл үшін сізге алғыс айтқым келеді.
Dialogue: 0,0:18:17.59,0:18:21.60,Default,,0,0,0,,Сонда сен оның ағасысың ба әлде басқасысың ба?
Dialogue: 0,0:18:21.60,0:18:25.60,Default,,0,0,0,,Біздің елде барлық нагами халқы отбасы болып табылады.
Dialogue: 0,0:18:25.60,0:18:28.60,Default,,0,0,0,,Бұл қай жерде? Тей жартасында
Dialogue: 0,0:18:28.60,0:18:32.61,Default,,0,0,0,,Әр елде көшпелілер жиналатын жер
Dialogue: 0,0:18:32.61,0:18:35.61,Default,,0,0,0,,Бұл солардың бірі.
Dialogue: 0,0:18:37.61,0:18:41.62,Default,,0,0,0,,《Қызық, бұл не... Бұл біртүрлі ыңғайлы》
Dialogue: 0,0:18:41.62,0:18:44.62,Default,,0,0,0,,Мен ән сұрадым. Ән?
Dialogue: 0,0:18:44.62,0:18:50.63,Default,,0,0,0,,Сол қарлығаш әйел ән айтып күн көретін саяхатшы еді.
Dialogue: 0,0:18:50.63,0:18:54.63,Default,,0,0,0,,Ән айт... Мұнда егін өсіргің келе ме?
Dialogue: 0,0:18:54.63,0:18:58.63,Default,,0,0,0,,Ғимарат салмасам да, ән айта алмаймын...
Dialogue: 0,0:18:58.63,0:19:03.64,Default,,0,0,0,,Бірдеңе жасау үшін әннің қажеті жоқ екені рас шығар.
Dialogue: 0,0:19:03.64,0:19:05.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:07.64,0:19:09.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:09.64,0:19:16.65,Default,,0,0,0,,♪～
Dialogue: 0,0:19:16.65,0:19:21.66,Default,,0,0,0,,♪(Қарлығаштың ән салған дауысы)
Dialogue: 0,0:19:21.66,0:19:41.68,Default,,0,0,0,,♪～
Dialogue: 0,0:19:41.68,0:20:01.70,Default,,0,0,0,,♪～
Dialogue: 0,0:20:01.70,0:20:17.71,Default,,0,0,0,,♪～
Dialogue: 0,0:20:17.71,0:20:21.72,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:20:21.72,0:20:23.72,Default,,0,0,0,,Кетейін деп жатқандардың қарғысы
Dialogue: 0,0:20:23.72,0:20:28.72,Default,,0,0,0,,Бұл ақыр аяғында батаға айналады деп үміттенемін...
Dialogue: 0,0:20:28.72,0:20:30.73,Default,,0,0,0,,А...
Dialogue: 0,0:20:33.73,0:20:35.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:39.73,0:20:43.74,Default,,0,0,0,,Ән айтпағанда сөйлей алмайды.
Dialogue: 0,0:20:43.74,0:20:45.74,Default,,0,0,0,,Не? (Китти) Бұл ол
Dialogue: 0,0:20:45.74,0:20:48.74,Default,,0,0,0,,Көшпенді болудың қарғысы шығар.
Dialogue: 0,0:20:48.74,0:20:51.75,Default,,0,0,0,,Ол шынымен ештеңе шығармайды ма?
Dialogue: 0,0:20:51.75,0:20:53.75,Default,,0,0,0,,Даусыңыз сондай әдемі болса да...
Dialogue: 0,0:20:53.75,0:20:56.75,Default,,0,0,0,,Талантты босқа өткізген сияқты.
Dialogue: 0,0:20:56.75,0:21:00.76,Default,,0,0,0,,Бірақ мен бұл әнді ешқашан ұмытпаймын
Dialogue: 0,0:21:00.76,0:21:03.76,Default,,0,0,0,,Әнде кішкентай қоңырау бар
Dialogue: 0,0:21:03.76,0:21:07.76,Default,,0,0,0,,Іздегеніңді таптың ба? сурет?
Dialogue: 0,0:21:07.76,0:21:09.76,Default,,0,0,0,,Ата-анаң да бір жерде.
Dialogue: 0,0:21:09.76,0:21:12.77,Default,,0,0,0,,Мүмкін сіз бұл әнді естіген шығарсыз.
Dialogue: 0,0:21:12.77,0:21:15.77,Default,,0,0,0,,Кеткендер туралы жыр
Dialogue: 0,0:21:16.77,0:21:20.78,Default,,0,0,0,,《Түсіндім, Белл есімі сол әннен шыққан...》
Dialogue: 0,0:21:20.78,0:21:24.78,Default,,0,0,0,,《Мен бір күні кететінімді білдім...》
Dialogue: 0,0:21:24.78,0:21:29.78,Default,,0,0,0,,《Бәрі де сен мен туралы осылай ойлайсың...》
Dialogue: 0,0:21:32.79,0:21:34.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.79,0:21:36.79,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:21:37.79,0:21:39.79,Default,,0,0,0,,(Сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:21:39.79,0:21:41.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:50.81,0:21:54.81,Default,,0,0,0,,《Іздегенімді таптым》
Dialogue: 0,0:22:00.82,0:22:20.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.84,0:22:38.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:38.85,0:22:57.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:57.87,0:23:04.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:04.88,0:23:17.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.89,0:23:26.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.91,0:23:32.91,Default,,0,0,0,,Мен саған төмен қарап тұрған жоқпын.
Dialogue: 0,0:23:32.91,0:23:35.91,Default,,0,0,0,,Қылыш кеспей өседі, Қылыш ұры дейді.
Dialogue: 0,0:23:35.91,0:23:37.91,Default,,0,0,0,,Таразы тым алыс ауытқып кетпесін.
Dialogue: 0,0:23:37.91,0:23:39.91,Default,,0,0,0,,Бұл ең нашар таңдау.
Dialogue: 0,0:23:41.41,0:23:47.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory