Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.50,0:00:07.50,Default,,0,0,0,,《Тыныштық》
Dialogue: 0,0:00:07.50,0:00:10.51,Default,,0,0,0,,《Ешкім саяхатқа шыққысы келмейтін сияқты.
Dialogue: 0,0:00:10.51,0:00:12.51,Default,,0,0,0,,Ол жоқ сияқты...》
Dialogue: 0,0:00:12.51,0:00:15.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.52,0:00:24.52,Default,,0,0,0,,Мен саяхатшы боламын
Dialogue: 0,0:00:32.03,0:00:34.03,Default,,0,0,0,,《Кеттік》
Dialogue: 0,0:00:34.03,0:00:37.03,Default,,0,0,0,,《Мен қайда барарымды білмеймін, бірақ
Dialogue: 0,0:00:37.03,0:00:40.04,Default,,0,0,0,,Мұнда емес, бір жерде》
Dialogue: 0,0:00:40.54,0:01:00.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:00.56,0:01:20.58,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:20.58,0:01:40.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:40.60,0:02:00.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:00.62,0:02:09.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:10.63,0:02:15.63,Default,,0,0,0,,Осы тақ бөлмесіне баратын адамның атын айт.
Dialogue: 0,0:02:15.63,0:02:18.63,Default,,0,0,0,,Ловерак-Белл Бұл менің атым.
Dialogue: 0,0:02:18.63,0:02:22.64,Default,,0,0,0,,Мына тақ бөлмесінде не қалайсыз?
Dialogue: 0,0:02:22.64,0:02:27.64,Default,,0,0,0,,Қаладан шығып, Құдай белгілеген елдің шекарасынан өту
Dialogue: 0,0:02:27.64,0:02:29.65,Default,,0,0,0,,Мен оның кілтін алғым келеді.
Dialogue: 0,0:02:29.65,0:02:31.65,Default,,0,0,0,,Осы тақ бөлмесінен
Dialogue: 0,0:02:31.65,0:02:35.65,Default,,0,0,0,,Елден кетуге не себеп болды?
Dialogue: 0,0:02:35.65,0:02:37.65,Default,,0,0,0,,Мен саяхатқа шығамын
Dialogue: 0,0:02:37.65,0:02:42.66,Default,,0,0,0,,Менің кім екенімді білу
Dialogue: 0,0:02:42.66,0:02:44.66,Default,,0,0,0,,Осы тақ бөлмесінде
Dialogue: 0,0:02:44.66,0:02:48.66,Default,,0,0,0,,Сенің атыңды қалай атағың келеді?
Dialogue: 0,0:02:49.67,0:02:52.67,Default,,0,0,0,,Мен көшпенді болғым келеді
Dialogue: 0,0:02:52.67,0:02:57.67,Default,,0,0,0,,Менің қалаған есімім, маған ең лайықтысы!
Dialogue: 0,0:03:04.68,0:03:09.69,Default,,0,0,0,,Енді, балақай, кілтті ойна.
Dialogue: 0,0:03:09.69,0:03:13.69,Default,,0,0,0,,Жан дүниеңнің өңін аш
Dialogue: 0,0:03:13.69,0:03:18.69,Default,,0,0,0,,Осылайша Құдайдың кедергісін жеңу
Dialogue: 0,0:03:18.69,0:03:23.70,Default,,0,0,0,,Ішіңізде белгі жазылады.
Dialogue: 0,0:03:23.70,0:03:25.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:28.70,0:03:30.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:30.71,0:03:33.71,Default,,0,0,0,,Сондықтан оны пернетақта аспабы деп атайды.
Dialogue: 0,0:03:33.71,0:03:36.71,Default,,0,0,0,,Бұл саяхаттың кілті.
Dialogue: 0,0:03:36.71,0:03:39.72,Default,,0,0,0,,Бұл кілт...
Dialogue: 0,0:03:43.72,0:03:49.73,Default,,0,0,0,,Әй... кілт ойнағанды таныды.
Dialogue: 0,0:03:49.73,0:03:52.73,Default,,0,0,0,,Оны қалай ойнауға болады...
Dialogue: 0,0:03:52.73,0:03:56.73,Default,,0,0,0,,Өзіңіз қалағандай жасаңыз
Dialogue: 0,0:03:56.73,0:03:59.74,Default,,0,0,0,,Соны айтсаң да... А?
Dialogue: 0,0:03:59.74,0:04:01.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:01.74,0:04:03.74,Default,,0,0,0,,Айды жасау
Dialogue: 0,0:04:03.74,0:04:08.74,Default,,0,0,0,,Басқаша айтқанда, бұл «айда қозғалу» дегенді білдіретін көне емле.
Dialogue: 0,0:04:08.74,0:04:11.75,Default,,0,0,0,,Айды жасау үшін…
Dialogue: 0,0:04:11.75,0:04:14.75,Default,,0,0,0,,Бұл даму мен регрессия спиралы
Dialogue: 0,0:04:14.75,0:04:20.76,Default,,0,0,0,,«Айдың саяхаты» нені білдіреді? Жыл мезгілдері мен өмірдің тууы мен өлімі сияқты.
Dialogue: 0,0:04:20.76,0:04:26.76,Default,,0,0,0,,Өзінің дамуын кеңейте отырып, ол қайта оралады, ал қайтқаны бар
Dialogue: 0,0:04:26.76,0:04:32.77,Default,,0,0,0,,Бұрынғыдай болуы мүмкін емес, өзгеріп жатыр.
Dialogue: 0,0:04:32.77,0:04:36.77,Default,,0,0,0,,Ай... Жердегі ай дегеніміз не?
Dialogue: 0,0:04:36.77,0:04:39.78,Default,,0,0,0,,Оны енді ешкім түсіне алмайды
Dialogue: 0,0:04:39.78,0:04:43.78,Default,,0,0,0,,Тәңір заманынан сыр болса керек.
Dialogue: 0,0:04:43.78,0:04:46.78,Default,,0,0,0,,《Бұл не сезім...》
Dialogue: 0,0:04:46.78,0:04:50.79,Default,,0,0,0,,《Туған кезде білуім керек жауап...》
Dialogue: 0,0:04:50.79,0:04:53.79,Default,,0,0,0,,《Менің сөздерім...》
Dialogue: 0,0:04:53.79,0:04:56.79,Default,,0,0,0,,《Мен қателескен жоқпын》
Dialogue: 0,0:04:56.79,0:04:59.80,Default,,0,0,0,,《Саяхатқа шығып, Лундингпен кездесу
Dialogue: 0,0:04:59.80,0:05:01.80,Default,,0,0,0,,Мен де саябаққа келдім
Dialogue: 0,0:05:01.80,0:05:07.80,Default,,0,0,0,,Мен ешқашан өзімді танудан тыс болған емеспін.
Dialogue: 0,0:05:07.80,0:05:11.81,Default,,0,0,0,,Барлығы тегін
Dialogue: 0,0:05:12.81,0:05:19.82,Default,,0,0,0,,♪～
Dialogue: 0,0:05:19.82,0:05:23.82,Default,,0,0,0,,《Бұл... менің үнім》
Dialogue: 0,0:05:24.82,0:05:26.82,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:05:26.82,0:05:29.83,Default,,0,0,0,,Кілт сізге жауап береді
Dialogue: 0,0:05:29.83,0:05:32.83,Default,,0,0,0,,Саяхаттың ескі сиқырын ойнау
Dialogue: 0,0:05:32.83,0:05:35.83,Default,,0,0,0,,Осы мақсатта біз «кездейсоқтыққа» тап болуымыз керек.
Dialogue: 0,0:05:35.83,0:05:40.84,Default,,0,0,0,,Біз «жүректің пішіні бар нәрселерді» түсінуіміз керек.
Dialogue: 0,0:05:40.84,0:05:43.84,Default,,0,0,0,,Жүрек пішіні бар нәрсе...
Dialogue: 0,0:05:43.84,0:05:45.84,Default,,0,0,0,,Аты...
Dialogue: 0,0:05:45.84,0:05:49.85,Default,,0,0,0,,Бар Ha… Қазір осында
Dialogue: 0,0:05:49.85,0:05:53.85,Default,,0,0,0,,Құдай заңынан тыс өзіңізді қудалаңыз
Dialogue: 0,0:05:53.85,0:05:56.85,Default,,0,0,0,,Үлкен қарғысты көтеру
Dialogue: 0,0:05:56.85,0:06:01.86,Default,,0,0,0,,Бір күні сол қарғыс нығметке айналарына сеніңіз.
Dialogue: 0,0:06:01.86,0:06:03.86,Default,,0,0,0,,Қай жерде болсаңыз да
Dialogue: 0,0:06:03.86,0:06:07.86,Default,,0,0,0,,Осы жерде және қазір жалғыз болу
Dialogue: 0,0:06:07.86,0:06:11.87,Default,,0,0,0,,Бұл өз бетінше жасалған сиқыр.
Dialogue: 0,0:06:11.87,0:06:13.87,Default,,0,0,0,,Әлемді тесіп өт!
Dialogue: 0,0:06:13.87,0:06:16.87,Default,,0,0,0,,Дауыссыз, дауыс шығар
Dialogue: 0,0:06:16.87,0:06:20.88,Default,,0,0,0,,Сол кезде дүниеде мен деген тесігі ашылады!
Dialogue: 0,0:06:20.88,0:06:25.88,Default,,0,0,0,,Менің тіршілігім шынымен гүлдейді.
Dialogue: 0,0:06:25.88,0:06:30.89,Default,,0,0,0,,Міне, қылышымның үйреткені.
Dialogue: 0,0:06:35.89,0:06:37.89,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:06:37.89,0:06:40.90,Default,,0,0,0,,Бірақ бұл жақсы емес.
Dialogue: 0,0:06:40.90,0:06:42.90,Default,,0,0,0,,Яғни, біз кездесуге тиіс едік пе?
Dialogue: 0,0:06:44.90,0:06:49.91,Default,,0,0,0,,Менде бұл құрал көрсететін еркіндік әлі де бар.
Dialogue: 0,0:06:49.91,0:06:51.91,Default,,0,0,0,,Өзін еркін сезіне алмаймын
Dialogue: 0,0:06:51.91,0:06:55.91,Default,,0,0,0,,Мен жалғызбын... Мен сондай жалғызбын...
Dialogue: 0,0:06:55.91,0:06:58.91,Default,,0,0,0,,Жынды болу
Dialogue: 0,0:06:58.91,0:07:02.92,Default,,0,0,0,,Демек, сіз бұл сынақтан бас тартасыз ба?
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Өйткені, қараңыз...
Dialogue: 0,0:07:04.92,0:07:06.92,Default,,0,0,0,,(құрғақ дыбыс)
Dialogue: 0,0:07:08.92,0:07:11.93,Default,,0,0,0,,《Қандай ауыр!》
Dialogue: 0,0:07:11.93,0:07:15.93,Default,,0,0,0,,Сонымен, сізге осы елде тұрақты тұруға рұқсат беріледі ме?
Dialogue: 0,0:07:15.93,0:07:17.93,Default,,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:07:17.93,0:07:20.94,Default,,0,0,0,,Мен келесі мүмкіндікті күтемін.
Dialogue: 0,0:07:20.94,0:07:23.94,Default,,0,0,0,,Бірақ кішкентай
Dialogue: 0,0:07:23.94,0:07:25.94,Default,,0,0,0,,Айқай алып келген сен
Dialogue: 0,0:07:25.94,0:07:27.94,Default,,0,0,0,,Гүрдіре ме?
Dialogue: 0,0:07:27.94,0:07:32.95,Default,,0,0,0,,Жолға шықсаң, көбі шыдай алмайды.
Dialogue: 0,0:07:32.95,0:07:36.95,Default,,0,0,0,,Сіз мазасызданасыз
Dialogue: 0,0:07:36.95,0:07:40.96,Default,,0,0,0,,Сенің тіршілігіңнің шуылдауына
Dialogue: 0,0:07:40.96,0:07:44.96,Default,,0,0,0,,Мен айналамдағы адамдарға жаман әсер еттім деп ойлайсың ба?
Dialogue: 0,0:07:44.96,0:07:46.96,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:07:46.96,0:07:49.97,Default,,0,0,0,,Сіз не әкелесіз
Dialogue: 0,0:07:49.97,0:07:53.97,Default,,0,0,0,,Құдай мұны қаламайды
Dialogue: 0,0:07:53.97,0:07:56.97,Default,,0,0,0,,Кішкентай, егер сен
Dialogue: 0,0:07:56.97,0:07:59.98,Default,,0,0,0,,Мен кілтті ала алмайтынымды түсінгенде
Dialogue: 0,0:07:59.98,0:08:03.98,Default,,0,0,0,,Тағы да осы саябаққа... жоқ...
Dialogue: 0,0:08:03.98,0:08:06.98,Default,,0,0,0,,Сіз осы сарайда тұруыңыз керек.
Dialogue: 0,0:08:06.98,0:08:08.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:14.99,0:08:16.99,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:08:16.99,0:08:21.00,Default,,0,0,0,,Бірақ мен саяхатқа шығуды шештім.
Dialogue: 0,0:08:21.00,0:08:24.00,Default,,0,0,0,,Бұл менің туған жерім емес.
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Мен пернелерді ойнай алмасам да
Dialogue: 0,0:08:27.00,0:08:34.01,Default,,0,0,0,,Ондай жағдайда Құдайдың тосқауылымен күресіп, жолы болмаса өлесің.
Dialogue: 0,0:08:34.01,0:08:38.01,Default,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:08:54.03,0:08:56.03,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:08:56.03,0:08:58.03,Default,,0,0,0,,Цк (Су мүйізі) Бұл қылыш ұры!
Dialogue: 0,0:08:58.03,0:09:00.04,Default,,0,0,0,,Менің ойымша, сіз дайынсыз.
Dialogue: 0,0:09:00.04,0:09:03.04,Default,,0,0,0,,Қылышымызды қайтарамыз ба?
Dialogue: 0,0:09:03.04,0:09:06.04,Default,,0,0,0,,Түсінді ме (барлығы)?
Dialogue: 0,0:09:07.04,0:09:09.04,Default,,0,0,0,,Бамбук
Dialogue: 0,0:09:10.05,0:09:13.05,Default,,0,0,0,,Біртүрлі сиқырды қолдану
Dialogue: 0,0:09:13.05,0:09:16.05,Default,,0,0,0,,Қанша іздесең де, таба алмайсың.
Dialogue: 0,0:09:16.05,0:09:18.05,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:09:18.05,0:09:22.06,Default,,0,0,0,,Дәл осы жерде және қазір жасырып жүрген барлық қылыштарыңызды түкіріңіз.
Dialogue: 0,0:09:22.06,0:09:26.06,Default,,0,0,0,,Сонымен? Мен сіздің позицияңызды аламын!
Dialogue: 0,0:09:26.06,0:09:28.06,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:09:28.06,0:09:31.07,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:09:31.07,0:09:33.07,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:33.07,0:09:35.07,Default,,0,0,0,,Абай бол, ЖоЖо
Dialogue: 0,0:09:35.07,0:09:38.07,Default,,0,0,0,,Уау уау
Dialogue: 0,0:09:38.07,0:09:42.08,Default,,0,0,0,,Мен саябаққа келгенде мұның болатынын білдім!
Dialogue: 0,0:09:42.08,0:09:45.08,Default,,0,0,0,,Қылыш шебері болған кезде! (Су мүйізі тайпасы) Ух
Dialogue: 0,0:09:45.08,0:09:49.08,Default,,0,0,0,,Қарғыс атсын... Мен сен сияқты қылышкер болуды шыдамаймын!
Dialogue: 0,0:09:49.08,0:09:51.09,Default,,0,0,0,,Мына құбыжық!
Dialogue: 0,0:09:51.09,0:09:55.09,Default,,0,0,0,,Қылыш шебері дегеніміз не? Қылыш дегеніміз не?
Dialogue: 0,0:09:55.09,0:09:58.09,Default,,0,0,0,,Сіз кімсіз? Сен кімсің? Уф...
Dialogue: 0,0:09:58.09,0:10:01.10,Default,,0,0,0,,Сіз не үшін өмір сүріп жатырсыз? Не үшін өлесің?
Dialogue: 0,0:10:01.10,0:10:03.10,Default,,0,0,0,,Өлім дегеніміз не?
Dialogue: 0,0:10:03.10,0:10:05.10,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:10:05.10,0:10:08.10,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:10:10.11,0:10:12.11,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:10:14.11,0:10:17.11,Default,,0,0,0,,Мен бұлай болатынын білдім.
Dialogue: 0,0:10:17.11,0:10:21.12,Default,,0,0,0,,Қанша шеберлігімді арттырсам да, қылышымды...
Dialogue: 0,0:10:21.12,0:10:26.12,Default,,0,0,0,,Мен не істеуім керек... өлтірілу керек пе? Мен аман қалуым керек пе?
Dialogue: 0,0:10:26.12,0:10:31.13,Default,,0,0,0,,Мені біреу өлтірсін деп айқайлауым керек пе?
Dialogue: 0,0:10:34.13,0:10:38.13,Default,,0,0,0,,Мен бұлай болатынын білдім.
Dialogue: 0,0:10:39.13,0:10:42.14,Default,,0,0,0,,《Мен толық емес өлі адаммын》
Dialogue: 0,0:10:42.14,0:10:45.14,Default,,0,0,0,,《Қарғысқа ұшырап, лақтырып туған бұл дүниеде.
Dialogue: 0,0:10:45.14,0:10:50.15,Default,,0,0,0,,Мен не іздеп жүргенімді де білмеймін
Dialogue: 0,0:10:50.15,0:10:53.15,Default,,0,0,0,,Дүниеге күмәнмен қарау керек болды.
Dialogue: 0,0:10:53.15,0:10:57.15,Default,,0,0,0,,《Мен ол қызды кездестіргенше...》
Dialogue: 0,0:10:58.15,0:11:01.16,Default,,0,0,0,,《Мінсіз тірі фигура...》
Dialogue: 0,0:11:01.16,0:11:04.16,Default,,0,0,0,,《Мені ең бірінші қызықтырған адам...》
Dialogue: 0,0:11:04.16,0:11:09.16,Default,,0,0,0,,《Мен бірдеңені шынымен іздей алатындай сезіндім》
Dialogue: 0,0:11:09.16,0:11:12.17,Default,,0,0,0,,《Мен шынымен тірі бола алатынымды сезіндім.》
Dialogue: 0,0:11:12.17,0:11:14.17,Default,,0,0,0,,Адонис!
Dialogue: 0,0:11:15.67,0:11:17.67,Default,,0,0,0,,Сіз әлі емтихан тапсырдыңыз ба?
Dialogue: 0,0:11:17.67,0:11:21.68,Default,,0,0,0,,А, жоқ, мен ол есікті әлі аша алмаймын.
Dialogue: 0,0:11:21.68,0:11:24.68,Default,,0,0,0,,Оны жақында аша аласыз.
Dialogue: 0,0:11:24.68,0:11:28.68,Default,,0,0,0,,Шынымды айтсам, сіз мұны айтқанда мен жеңілдеп қалдым.
Dialogue: 0,0:11:28.68,0:11:30.69,Default,,0,0,0,,Мен мүлдем жоғалып кеттім.
Dialogue: 0,0:11:30.69,0:11:33.69,Default,,0,0,0,,Иә? Қанның иісі...
Dialogue: 0,0:11:33.69,0:11:36.69,Default,,0,0,0,,Барлық қылышшылар бірдей...
Dialogue: 0,0:11:36.69,0:11:38.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:38.69,0:11:41.70,Default,,0,0,0,,Қанның иісі де саған жақсы иіс береді.
Dialogue: 0,0:11:41.70,0:11:44.70,Default,,0,0,0,,Баркер...
Dialogue: 0,0:11:44.70,0:11:46.70,Default,,0,0,0,,Сіз бұл кілтті көрдіңіз бе?
Dialogue: 0,0:11:46.70,0:11:49.70,Default,,0,0,0,,Мен үшін бұл мені қуғынға ұшыратады.
Dialogue: 0,0:11:49.70,0:11:52.71,Default,,0,0,0,,Құрал сияқты сезінеді
Dialogue: 0,0:11:52.71,0:11:55.71,Default,,0,0,0,,Ауырды, ауырады...
Dialogue: 0,0:11:55.71,0:11:57.71,Default,,0,0,0,,Мен мұны білмей тұрып, айналамды қап-қара болды.
Dialogue: 0,0:11:57.71,0:12:01.72,Default,,0,0,0,,Тексеру үшін оны ұстай алмайсыз.
Dialogue: 0,0:12:02.72,0:12:05.72,Default,,0,0,0,,Маған әкең айтты
Dialogue: 0,0:12:05.72,0:12:07.72,Default,,0,0,0,,Оны қараңғыда көре алатыныңызға сеніңіз
Dialogue: 0,0:12:07.72,0:12:12.73,Default,,0,0,0,,Қараңғылыққа берілу және алда не күтіп тұрғанын сезіну арқылы
Dialogue: 0,0:12:12.73,0:12:17.73,Default,,0,0,0,,Дәл осы жерде сізді бағыттайтын нәрсе пайда болады.
Dialogue: 0,0:12:17.73,0:12:19.73,Default,,0,0,0,,Рахмет сізге Адонис...
Dialogue: 0,0:12:19.73,0:12:24.74,Default,,0,0,0,,Мен өз жолыммен күресемін деп ойлаймын.
Dialogue: 0,0:12:35.75,0:12:38.75,Default,,0,0,0,,Мен сенің бөлмеңде күтемін.
Dialogue: 0,0:12:46.76,0:12:50.77,Default,,0,0,0,,Патша! Енді сіздің скептицизміңізге күмән келтіретін кез келді!
Dialogue: 0,0:12:51.77,0:12:53.77,Default,,0,0,0,,Сынаушының күлі дегеніміз не?
Dialogue: 0,0:12:53.77,0:12:58.77,Default,,0,0,0,,Қылышы сынған адам не сынамақ?
Dialogue: 0,0:12:58.77,0:13:01.78,Default,,0,0,0,,Қасиетті күл дегеніміз не? Жер бетінде ол қайдан келеді?
Dialogue: 0,0:13:01.78,0:13:05.78,Default,,0,0,0,,Оның сынаушының күліне қандай қатысы бар?
Dialogue: 0,0:13:05.78,0:13:08.78,Default,,0,0,0,,Қылыш дегеніміз не? Қылышшы дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:08.78,0:13:12.79,Default,,0,0,0,,Құдай бізге неліктен қылыш ұстатты?
Dialogue: 0,0:13:12.79,0:13:16.79,Default,,0,0,0,,Егер бұл заң болса, онда тақырып қандай?
Dialogue: 0,0:13:16.79,0:13:18.79,Default,,0,0,0,,Қатерлі қылыш дегеніміз не?
Dialogue: 0,0:13:18.79,0:13:21.80,Default,,0,0,0,,Неліктен бұл қылышшыларды жынды етеді?
Dialogue: 0,0:13:21.80,0:13:23.80,Default,,0,0,0,,Жер бетіндегі жын дегеніміз не?
Dialogue: 0,0:13:23.80,0:13:27.80,Default,,0,0,0,,Неліктен Құдай оны өзі жаратуға тырысады?
Dialogue: 0,0:13:27.80,0:13:30.81,Default,,0,0,0,,Тициан неліктен есінен тануы керек болды?
Dialogue: 0,0:13:30.81,0:13:32.81,Default,,0,0,0,,Киль де!
Dialogue: 0,0:13:32.81,0:13:35.81,Default,,0,0,0,,Неге мені сынаушының күлін айналдыруға мәжбүрледің?
Dialogue: 0,0:13:35.81,0:13:38.81,Default,,0,0,0,,Патша! Менің скептицизмімді ести аласыз ба?
Dialogue: 0,0:13:38.81,0:13:41.82,Default,,0,0,0,,Құдай дегеніміз не? Механикалық құдай дегеніміз не?
Dialogue: 0,0:13:41.82,0:13:44.82,Default,,0,0,0,,О скептиктер
Dialogue: 0,0:13:44.82,0:13:48.82,Default,,0,0,0,,Барлығы Құдай жоспарлаған үйлесімділікте.
Dialogue: 0,0:13:48.82,0:13:53.83,Default,,0,0,0,,Сіздің скептицизміңіз ешқашан тақырыптан ауытқымайды.
Dialogue: 0,0:13:53.83,0:13:55.83,Default,,0,0,0,,Не?
Dialogue: 0,0:13:55.83,0:13:57.83,Default,,0,0,0,,Оның артына қараңыз
Dialogue: 0,0:13:57.83,0:14:02.84,Default,,0,0,0,,Сіз ұстаған пышақтың белгісін көре аласыз ба?
Dialogue: 0,0:14:02.84,0:14:04.84,Default,,0,0,0,,Сен сондай ақымақсың...
Dialogue: 0,0:14:04.84,0:14:07.84,Default,,0,0,0,,Сынаушының күлі шашылып жатыр
Dialogue: 0,0:14:07.84,0:14:12.85,Default,,0,0,0,,Құдайдың ағашы бұтақтарын шығарып, тамырларын тіреуі үшін.
Dialogue: 0,0:14:12.85,0:14:15.85,Default,,0,0,0,,Бұл өлімге әкелетін күл
Dialogue: 0,0:14:15.85,0:14:20.86,Default,,0,0,0,,Қылышшының өмірін қатерге тігу арқылы ғана қасиетті күл бола аласыз.
Dialogue: 0,0:14:20.86,0:14:25.86,Default,,0,0,0,,Қатерлі қылыш дегеніміз не? Шексіз өсетін болат ұяшық.
Dialogue: 0,0:14:25.86,0:14:28.86,Default,,0,0,0,,Бұл өлімге әкеледі
Dialogue: 0,0:14:28.86,0:14:30.87,Default,,0,0,0,,Өлімнен өлімге дейін
Dialogue: 0,0:14:30.87,0:14:33.87,Default,,0,0,0,,Бұл сізге мәңгілік өмір сүруге мүмкіндік береді.
Dialogue: 0,0:14:33.87,0:14:39.87,Default,,0,0,0,,Қарғыстың кесірінен сыртта тудың.
Dialogue: 0,0:14:39.87,0:14:45.88,Default,,0,0,0,,Ендеше, Құдай сізге биліктің ұлы құралын береді.
Dialogue: 0,0:14:45.88,0:14:48.88,Default,,0,0,0,,Сондықтан, trialer
Dialogue: 0,0:14:48.88,0:14:51.89,Default,,0,0,0,,Сондықтан, аға патша
Dialogue: 0,0:14:51.89,0:14:53.89,Default,,0,0,0,,Егер бұл кіші патша болса...
Dialogue: 0,0:14:53.89,0:14:56.89,Default,,0,0,0,,Менің іздегенім бұл емес!
Dialogue: 0,0:14:56.89,0:15:01.90,Default,,0,0,0,,Міне, сіз іздеген нәрсе Құдайдың алдын ала жазғанына сәйкес.
Dialogue: 0,0:15:01.90,0:15:03.90,Default,,0,0,0,,үйлесім тапты
Dialogue: 0,0:15:03.90,0:15:05.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:06.90,0:15:08.90,Default,,0,0,0,,Шірімесе...
Dialogue: 0,0:15:08.90,0:15:10.91,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:15:10.91,0:15:14.91,Default,,0,0,0,,Мен не қалайтынымды шешемін!
Dialogue: 0,0:15:15.91,0:15:17.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:18.91,0:15:20.92,Default,,0,0,0,,Бұл қандай жалғандық?
Dialogue: 0,0:15:20.92,0:15:25.92,Default,,0,0,0,,Жаңа көргендеріңіз өзіңіздің тональдық формаңыз болды.
Dialogue: 0,0:15:25.92,0:15:31.93,Default,,0,0,0,,Жаңа ғана түрткеніңіз – сіздің механикаландырылған пішініңіз.
Dialogue: 0,0:15:31.93,0:15:37.93,Default,,0,0,0,,Құдай ағашының астында сіз Құдайдың жазбаларының біріне айналасыз.
Dialogue: 0,0:15:37.93,0:15:39.93,Default,,0,0,0,,Жазбалар туралы не деуге болады?
Dialogue: 0,0:15:39.93,0:15:44.94,Default,,0,0,0,,Барлық естеліктер лақтырып, бәрі жазылады.
Dialogue: 0,0:15:44.94,0:15:50.95,Default,,0,0,0,,Мәңгілік болмысқа беріл, Көк әулие болып
Dialogue: 0,0:15:50.95,0:15:55.95,Default,,0,0,0,,Құдаймен бірге Құдай ағашының тамырында бар
Dialogue: 0,0:15:56.95,0:15:58.95,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:16:00.96,0:16:02.96,Default,,0,0,0,,Міне
Dialogue: 0,0:16:02.96,0:16:04.96,Default,,0,0,0,,Сіздің қолыңызда
Dialogue: 0,0:16:04.96,0:16:10.97,Default,,0,0,0,,Өзін Құдайға бағыштап, еліктегендердің бейнесі.
Dialogue: 0,0:16:12.97,0:16:16.97,Default,,0,0,0,,Жоқ... бұл ақымақ...
Dialogue: 0,0:16:16.97,0:16:29.98,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:29.98,0:16:32.99,Default,,0,0,0,,Тоқта... тоқта!
Dialogue: 0,0:16:32.99,0:16:34.99,Default,,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:16:34.99,0:16:37.99,Default,,0,0,0,,Қоңырау... маған көмектес
Dialogue: 0,0:16:37.99,0:16:41.00,Default,,0,0,0,,Мен қашып құтыла алмаймын, а...
Dialogue: 0,0:16:41.00,0:16:45.00,Default,,0,0,0,,Қашудың бір ғана жолы бар
Dialogue: 0,0:16:52.01,0:16:55.01,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:16:55.01,0:17:02.02,Default,,0,0,0,,(құрғақ дыбыс)
Dialogue: 0,0:17:02.02,0:17:04.02,Default,,0,0,0,,Nh... ngh
Dialogue: 0,0:17:04.02,0:17:10.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:10.02,0:17:12.03,Default,,0,0,0,,№
Dialogue: 0,0:17:12.03,0:17:17.03,Default,,0,0,0,,Менің сапарға шығуыма себеп жоқ.
Dialogue: 0,0:17:17.03,0:17:19.03,Default,,0,0,0,,О скептиктер
Dialogue: 0,0:17:19.03,0:17:24.04,Default,,0,0,0,,Осы ұлттың іргетасы болуға уәде.
Dialogue: 0,0:17:24.04,0:17:28.04,Default,,0,0,0,,Сенің мәңгілік тыныштығың осында...
Dialogue: 0,0:17:28.04,0:17:30.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.05,0:17:39.05,Default,,0,0,0,,(Аштық Альянсы Grunt)
Dialogue: 0,0:17:39.05,0:17:43.06,Default,,0,0,0,,Ақырында, тіпті сіз...
Dialogue: 0,0:17:48.06,0:17:51.07,Default,,0,0,0,,Ештеңе... ештеңе
Dialogue: 0,0:17:53.07,0:18:00.07,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,0:18:04.08,0:18:06.08,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:18:06.08,0:18:08.08,Default,,0,0,0,,《Кез келген сот процесі
Dialogue: 0,0:18:08.08,0:18:12.09,Default,,0,0,0,,Мен онымен бетпе-бет келе алатыныма сенімді болдым...
Dialogue: 0,0:18:22.60,0:18:26.60,Default,,0,0,0,,Сене алмадым... үлкен ағам қайтыс болды.
Dialogue: 0,0:18:26.60,0:18:28.60,Default,,0,0,0,,Адонис…
Dialogue: 0,0:18:28.60,0:18:30.61,Default,,0,0,0,,Өлімнің миазмасы жеген
Dialogue: 0,0:18:30.61,0:18:34.61,Default,,0,0,0,,Бұл отбасы катакомбаларды қорғағаны үшін төлейтін баға.
Dialogue: 0,0:18:34.61,0:18:39.61,Default,,0,0,0,,Ха... күткендей жұмыс істемеді.
Dialogue: 0,0:18:39.61,0:18:41.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:42.62,0:18:45.62,Default,,0,0,0,,Қоңырау... Маған көмектесші, Белл.
Dialogue: 0,0:18:45.62,0:18:48.62,Default,,0,0,0,,Сіз маған көмектескеніңізді айттыңыз...
Dialogue: 0,0:18:48.62,0:18:50.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:50.63,0:18:52.63,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:52.63,0:18:57.63,Default,,0,0,0,,Неліктен бұл қолдар мені құрғатпайды?
Dialogue: 0,0:18:57.63,0:19:01.64,Default,,0,0,0,,Мен дүниеге келгенде анам қайтыс болды.
Dialogue: 0,0:19:01.64,0:19:04.64,Default,,0,0,0,,Бұл қолдар анамды іштен өлтірді.
Dialogue: 0,0:19:04.64,0:19:09.64,Default,,0,0,0,,Сондықтан мен анамның жылуын білмеймін.
Dialogue: 0,0:19:09.64,0:19:11.65,Default,,0,0,0,,Жылудың не екенін білмеймін
Dialogue: 0,0:19:11.65,0:19:14.65,Default,,0,0,0,,Суық болса да
Dialogue: 0,0:19:14.65,0:19:16.65,Default,,0,0,0,,Мен толық емес өлі адаммын
Dialogue: 0,0:19:16.65,0:19:18.65,Default,,0,0,0,,Ешқашан тірі адамға айналмау
Dialogue: 0,0:19:18.65,0:19:22.66,Default,,0,0,0,,Мен толық өлген адам болу үшін ғана өмір сүрдім.
Dialogue: 0,0:19:22.66,0:19:26.66,Default,,0,0,0,,Бүгін мен мәңгілік өлілердің қайда екенін білдім.
Dialogue: 0,0:19:26.66,0:19:31.67,Default,,0,0,0,,Мені сонда сүйреткім келмейді.
Dialogue: 0,0:19:31.67,0:19:34.67,Default,,0,0,0,,Дегенмен, менің күресуден басқа амалым жоқ...
Dialogue: 0,0:19:34.67,0:19:38.67,Default,,0,0,0,,Мен сізге ештеңе істей алмаймын ба?
Dialogue: 0,0:19:38.67,0:19:41.68,Default,,0,0,0,,Сіз мені... кесіп тастай аласыз ба?
Dialogue: 0,0:19:42.68,0:19:44.68,Default,,0,0,0,,Оны кесуге мүмкіндік жоқ
Dialogue: 0,0:19:44.68,0:19:48.68,Default,,0,0,0,,Белл, менімен соғыс. Неліктен?
Dialogue: 0,0:19:48.68,0:19:52.69,Default,,0,0,0,,Жолдың есігі екі адам өтетіндей кең емес.
Dialogue: 0,0:19:52.69,0:19:54.69,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін!
Dialogue: 0,0:19:54.69,0:19:58.69,Default,,0,0,0,,Мені ақымақ рөлге мәжбүрлеме! Ах...
Dialogue: 0,0:19:59.69,0:20:01.70,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:01.70,0:20:04.70,Default,,0,0,0,,Менің бұл әрекетімнен қорқасың ба?
Dialogue: 0,0:20:04.70,0:20:06.70,Default,,0,0,0,,Қорықпа, онда...
Dialogue: 0,0:20:06.70,0:20:09.70,Default,,0,0,0,,Маған ұнамайды Не?
Dialogue: 0,0:20:09.70,0:20:12.71,Default,,0,0,0,,Біз әлі ғашық болған жоқпыз.
Dialogue: 0,0:20:12.71,0:20:15.71,Default,,0,0,0,,Мен де сен
Dialogue: 0,0:20:15.71,0:20:17.71,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:20:17.71,0:20:20.72,Default,,0,0,0,,Өмірімде мұндай сезім болған емес.
Dialogue: 0,0:20:20.72,0:20:24.72,Default,,0,0,0,,Менде мұндай нәрсе болуы мүмкін емес деп ойлаймын.
Dialogue: 0,0:20:24.72,0:20:27.72,Default,,0,0,0,,Бірақ сен... А... Адонис!
Dialogue: 0,0:20:27.72,0:20:31.73,Default,,0,0,0,,Менен басқа сені әйел ретінде көретін адам бар ма?
Dialogue: 0,0:20:31.73,0:20:33.73,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:33.73,0:20:35.73,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:20:35.73,0:20:38.73,Default,,0,0,0,,Ха-ха...
Dialogue: 0,0:20:38.73,0:20:44.74,Default,,0,0,0,,Nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
Dialogue: 0,0:20:44.74,0:20:46.74,Default,,0,0,0,,《Мен сені өлтіремін...》
Dialogue: 0,0:20:48.74,0:20:51.75,Default,,0,0,0,,Жылысың
Dialogue: 0,0:20:51.75,0:20:55.75,Default,,0,0,0,,У-у!
Dialogue: 0,0:20:55.75,0:20:59.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.76,0:21:02.76,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:21:03.76,0:21:05.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:05.76,0:21:09.76,Default,,0,0,0,,Жеңіліс пен сәтсіздіктің ащылығын татып, жараланасың—
Dialogue: 0,0:21:09.76,0:21:12.77,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:12.77,0:21:15.77,Default,,0,0,0,,ертең оны үйіңізге әкеліп береміз.
Dialogue: 0,0:21:15.77,0:21:28.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:28.78,0:21:34.79,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:21:34.79,0:21:40.80,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:21:45.80,0:21:49.80,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:21:54.31,0:22:00.31,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:22:00.31,0:22:20.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.33,0:22:38.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:38.35,0:22:58.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:58.37,0:23:04.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:04.38,0:23:17.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:17.39,0:23:26.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:33.41,Default,,0,0,0,,Мен қылыш ұстағым келеді... Бұл менің өмірімдегі бірінші қылышым.
Dialogue: 0,0:23:33.41,0:23:35.41,Default,,0,0,0,,Менің қарғысымның пішіні мені осылай жасауға мәжбүр етеді.
Dialogue: 0,0:23:35.41,0:23:39.41,Default,,0,0,0,,Мәңгілікке өшетін өлім күші
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory