Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.04,0:00:12.05,Default,,0,0,0,,♪〜
Dialogue: 0,0:00:46.83,0:00:51.84,Default,,0,0,0,,〜♪
Dialogue: 0,0:00:56.80,0:01:00.93,Default,,0,0,0,,(динозаврлардың дауысы)
Dialogue: 0,0:01:14.49,0:01:16.57,Default,,0,0,0,,(динозаврлардың дауысы)
Dialogue: 0,0:01:16.70,0:01:20.74,Default,,0,0,0,,Шамамен 100 миллион жыл бұрын, бор кезеңі деп аталатын дәуір
Dialogue: 0,0:01:20.87,0:01:23.04,Default,,0,0,0,,Жер бауырымен жорғалаушылар елі болды.
Dialogue: 0,0:01:24.08,0:01:27.17,Default,,0,0,0,,Ең бастысы, патша деген атқа лайық адам
Dialogue: 0,0:01:27.29,0:01:29.50,Default,,0,0,0,,Бұл Тираннозавр
Dialogue: 0,0:01:29.63,0:01:32.84,Default,,0,0,0,,Иә~ Бұл динозаврдың бөлігі ме?
Dialogue: 0,0:01:33.38,0:01:35.97,Default,,0,0,0,,Бұл шын ба? (Сунео) Әрине.
Dialogue: 0,0:01:36.22,0:01:39.14,Default,,0,0,0,,Ол Юта штатындағы динозаврлар саябағында табылды.
Dialogue: 0,0:01:39.26,0:01:40.76,Default,,0,0,0,,Бұл менің әкемнің Америкадан келген кәдесыйы.
Dialogue: 0,0:01:40.89,0:01:42.76,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:01:42.89,0:01:44.47,Default,,0,0,0,,Қайсысы жақсы екенін көрсетіңізші.
Dialogue: 0,0:01:44.60,0:01:45.93,Default,,0,0,0,,О, күте тұр (Нобита) Уау.
Dialogue: 0,0:01:46.27,0:01:48.60,Default,,0,0,0,,Күрсіну~ Бұл жүздеген миллион жыл бұрын болған.
Dialogue: 0,0:01:48.73,0:01:51.19,Default,,0,0,0,,Неліктен ол тірі және қозғалады?
Dialogue: 0,0:01:51.31,0:01:53.19,Default,,0,0,0,,Эй, маған да көрсетші.
Dialogue: 0,0:01:53.32,0:01:56.15,Default,,0,0,0,,Қарашы, Шизука-чан, сен де жақсылап қара.
Dialogue: 0,0:01:57.03,0:01:58.78,Default,,0,0,0,,Мен оған былай қарасам,
Dialogue: 0,0:01:58.91,0:02:01.99,Default,,0,0,0,,Мен сол дәуірдің көріне бастағанын сеземін.
Dialogue: 0,0:02:02.20,0:02:04.49,Default,,0,0,0,,Папоротниктердің қалың джунглиі
Dialogue: 0,0:02:04.62,0:02:06.37,Default,,0,0,0,,Кішкентай тауға ұқсайтын динозавр...
Dialogue: 0,0:02:06.62,0:02:09.75,Default,,0,0,0,,Ей, жеткілікті, солай ма? Маған тез көрсет
Dialogue: 0,0:02:09.87,0:02:11.00,Default,,0,0,0,,Иә, иә, бітті.
Dialogue: 0,0:02:11.08,0:02:11.75,Default,,0,0,0,,Ах
Dialogue: 0,0:02:12.09,0:02:15.21,Default,,0,0,0,,Қойайық, қираса қиналмаймыз.
Dialogue: 0,0:02:17.30,0:02:19.80,Default,,0,0,0,,А... жұт
Dialogue: 0,0:02:21.01,0:02:23.39,Default,,0,0,0,,Сунео-кун, қымбат нәрсе үшін рахмет.
Dialogue: 0,0:02:23.51,0:02:25.68,Default,,0,0,0,,Оны қайта көргіңіз келсе, кез келген уақытта келіңіз.
Dialogue: 0,0:02:26.06,0:02:28.60,Default,,0,0,0,,Бұл не? Тасқа айналған тырнақ үшін ашуланбаңыз!
Dialogue: 0,0:02:28.81,0:02:29.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:30.60,0:02:33.23,Default,,0,0,0,,Мен бұл жерде менің тырнақтарым ғана емес деп мәлімдеу үшін келдім
Dialogue: 0,0:02:33.36,0:02:36.15,Default,,0,0,0,,Тұтас динозавр қазбасын қазу!
Dialogue: 0,0:02:37.78,0:02:41.20,Default,,0,0,0,,Кешіріңіз, мен тағы да қажетсіз нәрсе айттым.
Dialogue: 0,0:02:41.74,0:02:44.20,Default,,0,0,0,,Не, тағы бір ақымақтық па?
Dialogue: 0,0:02:44.33,0:02:45.95,Default,,0,0,0,,Бұл өтірік емес! Өтірік болса
Dialogue: 0,0:02:46.08,0:02:48.33,Default,,0,0,0,,Спагеттиді мұрынмен жеп көріңіз
Dialogue: 0,0:02:48.45,0:02:49.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.50,0:02:54.96,Default,,0,0,0,,Өкініштен өтірік айту менің жаман әдетім.
Dialogue: 0,0:02:55.09,0:02:59.88,Default,,0,0,0,,(Джианның күлкісі)
Dialogue: 0,0:03:01.26,0:03:02.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:04.05,0:03:07.39,Default,,0,0,0,,Егер бұл орын алса, мен не болса да динозаврдың қалдықтарын табуым керек.
Dialogue: 0,0:03:07.52,0:03:09.23,Default,,0,0,0,,Және бәрі.
Dialogue: 0,0:03:09.68,0:03:12.81,Default,,0,0,0,,Иә? Толық динозавр қазбалары?
Dialogue: 0,0:03:12.94,0:03:14.23,Default,,0,0,0,,Дорэмон өтінемін
Dialogue: 0,0:03:14.36,0:03:18.07,Default,,0,0,0,,Сөйлемес бұрын не істей алатыныңызды немесе жасай алмайтыныңызды мұқият ойластырыңыз.
Dialogue: 0,0:03:18.19,0:03:20.49,Default,,0,0,0,,Дораемон - мен сенетін жалғыз адам.
Dialogue: 0,0:03:20.61,0:03:23.11,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:03:23.24,0:03:24.91,Default,,0,0,0,,Тыңда, Нобита-кун
Dialogue: 0,0:03:25.16,0:03:29.04,Default,,0,0,0,,Жапонияда тиранозавр сияқты динозаврлар өмір сүрмеген.
Dialogue: 0,0:03:29.16,0:03:30.83,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:03:30.96,0:03:32.75,Default,,0,0,0,,Жоғалған динозавр қалдықтары
Dialogue: 0,0:03:32.83,0:03:34.46,Default,,0,0,0,,Оны қалай шығаруға болады?
Dialogue: 0,0:03:34.58,0:03:36.84,Default,,0,0,0,,Хмм, бұл туралы бірдеңе істейік.
Dialogue: 0,0:03:36.96,0:03:39.17,Default,,0,0,0,,Нобита-кунға келгенде
Dialogue: 0,0:03:39.30,0:03:42.55,Default,,0,0,0,,Бұл жауапсыздық па, әлде абайсыздық па?
Dialogue: 0,0:03:42.68,0:03:44.43,Default,,0,0,0,,Бұл ебедейсіз.
Dialogue: 0,0:03:44.55,0:03:46.18,Default,,0,0,0,,Жетеді! иә?
Dialogue: 0,0:03:46.60,0:03:48.18,Default,,0,0,0,,Мен енді кері шегіне алмаймын.
Dialogue: 0,0:03:48.31,0:03:50.73,Default,,0,0,0,,Мен мұны өзім жасаймын, бұл жеткілікті!
Dialogue: 0,0:03:51.18,0:03:52.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:03.03,0:04:05.82,Default,,0,0,0,,Аа, бұның бәрін қайдан алдың?
Dialogue: 0,0:04:08.45,0:04:11.75,Default,,0,0,0,,Бірақ бұл бас оның жартысын түсінбейді.
Dialogue: 0,0:04:12.12,0:04:14.25,Default,,0,0,0,,Меніңше, тез арада шаршап, лақтырып жібересің.
Dialogue: 0,0:04:14.37,0:04:17.63,Default,,0,0,0,,Өз бетімен орындауға талпыну таң қалдырады.
Dialogue: 0,0:04:17.79,0:04:22.01,Default,,0,0,0,,Сәтсіз болсам жарайды, Жылы көзбен қараймын.
Dialogue: 0,0:04:22.76,0:04:24.09,Default,,0,0,0,,Nii~
Dialogue: 0,0:04:27.26,0:04:29.18,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:04:29.56,0:04:32.64,Default,,0,0,0,,Жылы көзбен, ni~
Dialogue: 0,0:04:33.60,0:04:36.31,Default,,0,0,0,,Күлімсіреген жүзбен кедергі жасама
Dialogue: 0,0:04:36.44,0:04:37.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.69,0:04:38.86,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:04:39.94,0:04:41.32,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:04:41.44,0:04:43.40,Default,,0,0,0,,«Қозбалар ескі қабаттардан шыққан»
Dialogue: 0,0:04:43.53,0:04:46.07,Default,,0,0,0,,«Ескі қабаттар – жер сілкінісі нәтижесінде пайда болған жарықтар».
Dialogue: 0,0:04:46.24,0:04:49.41,Default,,0,0,0,,«Көбінесе құрылыспен кесілген жартастарда пайда болады».
Dialogue: 0,0:04:49.53,0:04:50.74,Default,,0,0,0,,Бұдан басқа, қауесетке сенсек, сол жігіт... өзімен бірге екі Өлім дәптерін алып кеткен.
Dialogue: 0,0:04:55.21,0:04:58.29,Default,,0,0,0,,Менің түйсігім бұл жер сөзсіз перспективалы.
Dialogue: 0,0:05:05.93,0:05:06.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:08.34,0:05:11.76,Default,,0,0,0,,Мен бұл перспективалы болып көрінді деп ойладым, бірақ қателескен сияқтымын.
Dialogue: 0,0:05:11.89,0:05:13.77,Default,,0,0,0,,Сәлем! (Нобита) А
Dialogue: 0,0:05:15.10,0:05:17.15,Default,,0,0,0,,Ондай жерде не істеп жүрсің?
Dialogue: 0,0:05:17.48,0:05:20.44,Default,,0,0,0,,Аа... ааа ааа
Dialogue: 0,0:05:20.57,0:05:21.86,Default,,0,0,0,,Ите уу
Dialogue: 0,0:05:22.32,0:05:24.03,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:05:24.28,0:05:25.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:25.82,0:05:28.36,Default,,0,0,0,,Уайымдамаңыз, ағай, мен жұмыстан кетейін деп жатырмын.
Dialogue: 0,0:05:28.49,0:05:30.91,Default,,0,0,0,,Тек тоқтау керек емес.
Dialogue: 0,0:05:35.91,0:05:38.17,Default,,0,0,0,,Не? Мұның бәрі мен бе?
Dialogue: 0,0:05:38.29,0:05:39.75,Default,,0,0,0,,Иә, сіз не істейсіз?
Dialogue: 0,0:05:39.96,0:05:41.67,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:05:41.79,0:05:44.51,Default,,0,0,0,,Олай болса, қоқысты салу үшін шұңқыр қаз.
Dialogue: 0,0:05:44.63,0:05:46.38,Default,,0,0,0,,Не? Сіз тағы да қазуға барасыз ба?
Dialogue: 0,0:05:50.43,0:05:56.10,Default,,0,0,0,,Менің мұндай жағдайға келген себебім, Дораемон маған көмектеспейді.
Dialogue: 0,0:05:56.35,0:05:57.94,Default,,0,0,0,,Қайырлы таң... А?
Dialogue: 0,0:05:58.98,0:06:00.73,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:06:02.11,0:06:02.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.44,0:06:05.11,Default,,0,0,0,,Динозавр жұмыртқалары!
Dialogue: 0,0:06:05.32,0:06:08.91,Default,,0,0,0,,Иә! Мен оны таптым, ақыры таптым!
Dialogue: 0,0:06:09.03,0:06:10.24,Default,,0,0,0,,О~
Dialogue: 0,0:06:10.36,0:06:12.95,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,0:06:13.08,0:06:14.45,Default,,0,0,0,,Пун
Dialogue: 0,0:06:14.74,0:06:16.37,Default,,0,0,0,,Уф, ой, ой!
Dialogue: 0,0:06:16.50,0:06:18.79,Default,,0,0,0,,Әй, күте тұр... Уау.
Dialogue: 0,0:06:18.92,0:06:20.04,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:20.17,0:06:21.29,Default,,0,0,0,,Дораемон! иә?
Dialogue: 0,0:06:21.83,0:06:23.71,Default,,0,0,0,,Хе хехе хехе
Dialogue: 0,0:06:28.30,0:06:30.80,Default,,0,0,0,,Доской доддодо...
Dialogue: 0,0:06:30.93,0:06:35.68,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,0:06:35.89,0:06:37.27,Default,,0,0,0,,Бұл динозавр жұмыртқасы.
Dialogue: 0,0:06:37.39,0:06:38.81,Default,,0,0,0,,Қараңдаршы, қараңдаршы, бұл не?
Dialogue: 0,0:06:38.94,0:06:41.23,Default,,0,0,0,,Мен оны өзім таптым. Сіз оны қарап шықтыңыз ба?
Dialogue: 0,0:06:41.60,0:06:42.69,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:42.81,0:06:46.44,Default,,0,0,0,,Бірақ бұл динозавр жұмыртқасы екенін қайдан білеміз?
Dialogue: 0,0:06:46.57,0:06:47.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.03,0:06:50.40,Default,,0,0,0,,Бұл жай ғана тас болуы мүмкін.
Dialogue: 0,0:06:50.53,0:06:54.37,Default,,0,0,0,,Бұл қазба болса да, ежелгі ағаштың жаңғағы болуы мүмкін.
Dialogue: 0,0:06:54.74,0:06:55.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:55.83,0:06:58.96,Default,,0,0,0,,Немесе бұл Науманның пілінің тезегі шығар.
Dialogue: 0,0:06:59.08,0:07:00.54,Default,,0,0,0,,Иә, тезек?
Dialogue: 0,0:07:00.67,0:07:01.83,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:07:02.33,0:07:04.17,Default,,0,0,0,,Себебі сіз түсінбейсіз.
Dialogue: 0,0:07:04.63,0:07:07.00,Default,,0,0,0,,Жағымсыз сөздерді айтпа
Dialogue: 0,0:07:08.42,0:07:09.30,Default,,0,0,0,,Хун
Dialogue: 0,0:07:09.88,0:07:13.14,Default,,0,0,0,,Мұны айтсаң да, оны растауға мүмкіндік жоқ.
Dialogue: 0,0:07:13.26,0:07:15.72,Default,,0,0,0,,Хм, не істеуім керек, Дораемон!
Dialogue: 0,0:07:15.85,0:07:17.52,Default,,0,0,0,,О?
Dialogue: 0,0:07:18.85,0:07:21.44,Default,,0,0,0,,Иә? Уақыт Фурошики
Dialogue: 0,0:07:22.02,0:07:23.69,Default,,0,0,0,,Мен оны бұрын қолданғанмын.
Dialogue: 0,0:07:23.81,0:07:27.73,Default,,0,0,0,,Бұған оралған заттар уақытты кері қайтара алады.
Dialogue: 0,0:07:29.28,0:07:30.15,Default,,0,0,0,,...
Dialogue: 0,0:07:33.03,0:07:34.07,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:07:45.00,0:07:48.67,Default,,0,0,0,,Осылайша біз бұл қазбаны 100 миллион жыл бұрынғы күйіне қайтара аламыз.
Dialogue: 0,0:07:48.80,0:07:50.59,Default,,0,0,0,,Шынайы тұлға айқындалады.
Dialogue: 0,0:07:51.26,0:07:53.05,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:07:53.18,0:07:57.05,Default,,0,0,0,,Соңғы кездері сен маған тым көп сенуді әдетке айналдырдың.
Dialogue: 0,0:07:57.18,0:08:00.73,Default,,0,0,0,,Мұндай нәрсе ешқашан тәуелсіздік сезімін дамыта алмайды.
Dialogue: 0,0:08:00.85,0:08:05.31,Default,,0,0,0,,Өзіңіз ойланыңыз және өз күшіңізбен осы мәселені жеңіңіз.
Dialogue: 0,0:08:05.56,0:08:09.44,Default,,0,0,0,,Мен сені жылы көздеріммен бақылаймын.
Dialogue: 0,0:08:09.73,0:08:11.65,Default,,0,0,0,,Уақыт қажет.
Dialogue: 0,0:08:12.03,0:08:14.82,Default,,0,0,0,,Өйткені, біз уақытты 100 миллион жылға кері қайтарамыз.
Dialogue: 0,0:08:14.95,0:08:16.66,Default,,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:08:18.78,0:08:19.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:21.33,0:08:22.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.34,0:08:29.21,Default,,0,0,0,,Иә! Бұл міндетті түрде жұмыртқа
Dialogue: 0,0:08:29.34,0:08:31.71,Default,,0,0,0,,Жарайды, мен мұны бұрып көрейін.
Dialogue: 0,0:08:36.18,0:08:37.64,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:08:38.18,0:08:40.89,Default,,0,0,0,,Не? Күннің ортасында?
Dialogue: 0,0:08:41.14,0:08:43.56,Default,,0,0,0,,Егер сізге тапсырма орындау керек болса, Дораемоннан сұраңыз.
Dialogue: 0,0:08:43.68,0:08:45.48,Default,,0,0,0,,Мен сені қазір жібере алмаймын
Dialogue: 0,0:08:45.69,0:08:50.73,Default,,0,0,0,,Бұл шынымен де жақсы емес. Оян, Нобита.
Dialogue: 0,0:08:50.86,0:08:53.32,Default,,0,0,0,,Бұл! Сен оған көмектесе алмайсың, балам.
Dialogue: 0,0:08:58.32,0:08:59.91,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,0:09:00.91,0:09:02.50,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:09:04.41,0:09:06.37,Default,,0,0,0,,Әке, бірдеңе жасаңызшы.
Dialogue: 0,0:09:06.50,0:09:07.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:07.54,0:09:10.21,Default,,0,0,0,,Семіргенде, күндіз ұйықтай бастайсың.
Dialogue: 0,0:09:11.42,0:09:12.17,Default,,0,0,0,,Нобита
Dialogue: 0,0:09:13.17,0:09:16.34,Default,,0,0,0,,Нобита Кукуку...
Dialogue: 0,0:09:16.47,0:09:20.43,Default,,0,0,0,,(Нобитаның қорқытқан дауысы)
Dialogue: 0,0:09:20.93,0:09:22.68,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:09:22.81,0:09:24.48,Default,,0,0,0,,О, күте тұрыңыз
Dialogue: 0,0:09:24.60,0:09:25.85,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:09:25.98,0:09:28.31,Default,,0,0,0,,Ой-оу
Dialogue: 0,0:09:28.48,0:09:31.27,Default,,0,0,0,,Жақында жалықтырасың. Оны жайына қалдырайық.
Dialogue: 0,0:09:36.45,0:09:37.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:39.82,0:09:43.37,Default,,0,0,0,,А, жақсы, үміт бар.
Dialogue: 0,0:09:43.49,0:09:45.71,Default,,0,0,0,,Бір дем алайық. Барымызды салайық.
Dialogue: 0,0:09:54.42,0:09:55.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:56.97,0:09:58.34,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:10:00.30,0:10:02.47,Default,,0,0,0,,Дорэмон, оян!
Dialogue: 0,0:10:03.10,0:10:05.98,Default,,0,0,0,,Хмм... (Нобита) Эй...
Dialogue: 0,0:10:06.48,0:10:08.06,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:10:08.19,0:10:11.73,Default,,0,0,0,,Мен жақсы ұйықтамаймын, сондықтан жұмыртқалар суық болады.
Dialogue: 0,0:10:11.86,0:10:13.61,Default,,0,0,0,,Мені осымен байланыстырыңыз
Dialogue: 0,0:10:17.15,0:10:20.62,Default,,0,0,0,,А, бұл өте қиын.
Dialogue: 0,0:10:20.95,0:10:24.29,Default,,0,0,0,,Жарайды... Ой.
Dialogue: 0,0:10:24.41,0:10:25.66,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:10:25.95,0:10:28.04,Default,,0,0,0,,Иә? Ааа!
Dialogue: 0,0:10:28.16,0:10:31.00,Default,,0,0,0,,Дораемон, шеш! Тезірек, эй
Dialogue: 0,0:10:31.13,0:10:33.46,Default,,0,0,0,,Мен оны жай ғана байлап қойсам да.
Dialogue: 0,0:10:33.59,0:10:36.96,Default,,0,0,0,,Жарайды, жарайды, жамбасым ағып кете жаздады.
Dialogue: 0,0:10:37.34,0:10:39.47,Default,,0,0,0,,О? Ха
Dialogue: 0,0:10:48.85,0:10:50.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:54.11,0:10:56.03,Default,,0,0,0,,Пуэй
Dialogue: 0,0:11:04.49,0:11:06.49,Default,,0,0,0,,Туған
Dialogue: 0,0:11:06.62,0:11:08.79,Default,,0,0,0,,Пуй Пуй Пуй
Dialogue: 0,0:11:15.34,0:11:16.88,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:11:18.46,0:11:19.47,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:11:20.80,0:11:22.93,Default,,0,0,0,,Хмм... уау!
Dialogue: 0,0:11:23.97,0:11:27.60,Default,,0,0,0,,О? Ой ~
Dialogue: 0,0:11:28.64,0:11:30.81,Default,,0,0,0,,Не көрдіңіз? Иә
Dialogue: 0,0:11:31.60,0:11:34.77,Default,,0,0,0,,Бұл қандай зат? Жай айт.
Dialogue: 0,0:11:35.31,0:11:36.23,Default,,0,0,0,,Уф
Dialogue: 0,0:11:36.77,0:11:38.48,Default,,0,0,0,,Уау, мен қорқып тұрмын.
Dialogue: 0,0:11:38.61,0:11:42.15,Default,,0,0,0,,Бұл плезиозаврдың бір түрі, Футабасзукирю.
Dialogue: 0,0:11:42.61,0:11:43.95,Default,,0,0,0,,Футабассузукирю?
Dialogue: 0,0:11:44.03,0:11:44.95,Default,,0,0,0,,Иә
Dialogue: 0,0:11:45.74,0:11:48.62,Default,,0,0,0,,Олар бор дәуірінде Жапония маңындағы суларда өмір сүрген.
Dialogue: 0,0:11:50.04,0:11:53.17,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:11:53.29,0:11:56.59,Default,,0,0,0,,Уфуфу, бұл жігіт мені ата-анасы деп есептей ме?
Dialogue: 0,0:11:57.46,0:12:00.51,Default,,0,0,0,,Жарайды, жарайды, сен сүйкімдісің. Сенің атың кім?
Dialogue: 0,0:12:00.71,0:12:03.51,Default,,0,0,0,,Пуй Пуй Пуй
Dialogue: 0,0:12:04.18,0:12:07.47,Default,,0,0,0,,Дұрыс, бұл Пи-суке. Пи-суке жасайық.
Dialogue: 0,0:12:08.06,0:12:08.93,Default,,0,0,0,,Пуэй
Dialogue: 0,0:12:10.18,0:12:13.10,Default,,0,0,0,,Дұрыс, оны Сунео мен басқаларға көрсетіп, таң қалдырайық.
Dialogue: 0,0:12:13.23,0:12:16.27,Default,,0,0,0,,Күте тұрыңыз, міне, ебедейсіз.
Dialogue: 0,0:12:16.40,0:12:17.36,Default,,0,0,0,,Нану?
Dialogue: 0,0:12:17.69,0:12:20.57,Default,,0,0,0,,Ойланып қарашы, мен сендерге сондай кішкентай нәрсе көрсеттім.
Dialogue: 0,0:12:20.69,0:12:23.28,Default,,0,0,0,,Мені кесіртке десеңіз, күлетініңізге сенімдімін.
Dialogue: 0,0:12:23.40,0:12:24.86,Default,,0,0,0,,Ах… Бип, бип…
Dialogue: 0,0:12:24.99,0:12:25.82,Default,,0,0,0,,Пю?
Dialogue: 0,0:12:26.20,0:12:27.78,Default,,0,0,0,,Жарайды, мен қазір кетейін
Dialogue: 0,0:12:28.37,0:12:30.66,Default,,0,0,0,,Аа, дұрыс, мен өсіремін.
Dialogue: 0,0:12:30.74,0:12:32.66,Default,,0,0,0,,Кем дегенде 10 метр немесе одан да көп
Dialogue: 0,0:12:32.79,0:12:36.04,Default,,0,0,0,,Ал, әсерлі үлкен ашу туралы сөйлесейік.
Dialogue: 0,0:12:36.13,0:12:36.79,Default,,0,0,0,,Пуэй
Dialogue: 0,0:12:37.00,0:12:38.21,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:12:39.09,0:12:41.13,Default,,0,0,0,,Қандай тағам пайдалы?
Dialogue: 0,0:12:41.88,0:12:42.88,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:12:43.01,0:12:45.13,Default,,0,0,0,,...
Dialogue: 0,0:12:47.01,0:12:49.01,Default,,0,0,0,,Сіз жауын құрттарын іздеп жүрсіз бе?
Dialogue: 0,0:12:57.81,0:13:00.69,Default,,0,0,0,,Маған бұл күндері жауын құрттарын табу қиынға соғады.
Dialogue: 0,0:13:00.82,0:13:02.28,Default,,0,0,0,,Ах хехехе...
Dialogue: 0,0:13:02.40,0:13:03.74,Default,,0,0,0,,мүлде жоқ.
Dialogue: 0,0:13:03.86,0:13:05.70,Default,,0,0,0,,Йо Нобита, жаттығу жасайсың ба?
Dialogue: 0,0:13:06.70,0:13:07.74,Default,,0,0,0,,Қандай тәжірибе?
Dialogue: 0,0:13:07.87,0:13:10.66,Default,,0,0,0,,Хм, спагеттиді мұрынмен жеуге жаттықты.
Dialogue: 0,0:13:10.99,0:13:13.12,Default,,0,0,0,,Не? Мен оны асыға күтемін
Dialogue: 0,0:13:13.25,0:13:16.33,Default,,0,0,0,,(Джан мен Сунеоның күлкісі)
Dialogue: 0,0:13:17.46,0:13:20.59,Default,,0,0,0,,Мені мазақ ет! Қазір қара
Dialogue: 0,0:13:23.13,0:13:26.05,Default,,0,0,0,,Су қаншалықты ыстық? Иә, дәл солай
Dialogue: 0,0:13:26.68,0:13:27.93,Default,,0,0,0,,Сіз ояндыңыз ба? Мен түсінемін
Dialogue: 0,0:13:28.05,0:13:29.01,Default,,0,0,0,,Не!
Dialogue: 0,0:13:29.68,0:13:31.85,Default,,0,0,0,,Пи-суке Пи-суке!
Dialogue: 0,0:13:31.97,0:13:35.14,Default,,0,0,0,,Не болды? (Нобита) Анамның динозаврды өлтіруі!
Dialogue: 0,0:13:35.27,0:13:37.10,Default,,0,0,0,,Уау, Нобита-кун!
Dialogue: 0,0:13:37.23,0:13:38.69,Default,,0,0,0,,Дорэмон Писуке
Dialogue: 0,0:13:38.81,0:13:40.31,Default,,0,0,0,,Міне, осылай
Dialogue: 0,0:13:40.44,0:13:41.82,Default,,0,0,0,,Не? (Әке, ана) Иә?
Dialogue: 0,0:13:42.07,0:13:43.53,Default,,0,0,0,,П-суке - П-суке
Dialogue: 0,0:13:43.65,0:13:45.74,Default,,0,0,0,,Мен оны осында жылжыттым.
Dialogue: 0,0:13:45.86,0:13:46.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:47.57,0:13:49.37,Default,,0,0,0,,Пуй Пуй (Нобита) Ах!
Dialogue: 0,0:13:50.16,0:13:53.33,Default,,0,0,0,,Пи-суке! Ухухухуху
Dialogue: 0,0:13:54.25,0:13:55.75,Default,,0,0,0,,Қарашы, Писуке.
Dialogue: 0,0:13:57.46,0:14:01.13,Default,,0,0,0,,Мен оларды жемеймін. Мүмкін сізге жауын құрттары ұнамайтын шығар?
Dialogue: 0,0:14:01.84,0:14:03.59,Default,,0,0,0,,Ұрланып әкетілген адамдардың кимонолары мен заттары ма?
Dialogue: 0,0:14:03.71,0:14:06.05,Default,,0,0,0,,Сашими - Нобитаның сүйікті тағамы.
Dialogue: 0,0:14:06.17,0:14:08.55,Default,,0,0,0,,Иә, мен өз бөлмемде ас ішемін.
Dialogue: 0,0:14:08.68,0:14:11.18,Default,,0,0,0,,Мен де (Анам/Әкем) Иә?
Dialogue: 0,0:14:15.77,0:14:17.56,Default,,0,0,0,,Сізге ұнады ма? П-суке
Dialogue: 0,0:14:18.10,0:14:20.52,Default,,0,0,0,,Пю пю пю!
Dialogue: 0,0:14:21.19,0:14:24.23,Default,,0,0,0,,Дұрыс тамақтаныңыз және тез өсіңіз.
Dialogue: 0,0:14:25.15,0:14:29.11,Default,,0,0,0,,Нобита-кун, мұндай қорқынышты нәрсені доғар.
Dialogue: 0,0:14:29.24,0:14:30.28,Default,,0,0,0,,Мен мұны ішсем ше?
Dialogue: 0,0:14:30.36,0:14:31.16,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:14:31.70,0:14:33.78,Default,,0,0,0,,Өсуді ынталандырушылар
Dialogue: 0,0:14:33.91,0:14:36.04,Default,,0,0,0,,Ішуге рұқсат етсең, олар басқаша өседі.
Dialogue: 0,0:14:36.16,0:14:38.29,Default,,0,0,0,,Шынымен бе? Сізге көп рахмет
Dialogue: 0,0:14:42.96,0:14:44.50,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:54.47,0:14:55.89,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:58.06,0:14:59.10,Default,,0,0,0,,Уау
Dialogue: 0,0:15:00.60,0:15:02.10,Default,,0,0,0,,Пуэй
Dialogue: 0,0:15:02.61,0:15:04.27,Default,,0,0,0,,Пи-суке! Хехе
Dialogue: 0,0:15:04.40,0:15:06.32,Default,,0,0,0,,Сіз жалғыз болдыңыз, солай емес пе? Жүр, ойнайық
Dialogue: 0,0:15:06.82,0:15:07.90,Default,,0,0,0,,Сора
Dialogue: 0,0:15:08.99,0:15:09.86,Default,,0,0,0,,...
Dialogue: 0,0:15:10.03,0:15:12.41,Default,,0,0,0,,Хмм, жақсы болды, жақсы болды, кеттік.
Dialogue: 0,0:15:12.57,0:15:14.24,Default,,0,0,0,,Холлет (Пи-суке) Пют
Dialogue: 0,0:15:14.49,0:15:16.37,Default,,0,0,0,,Жарайды, тағы бір нәрсе.
Dialogue: 0,0:15:16.49,0:15:18.41,Default,,0,0,0,,Қараңызшы, бұл жақсы. Келесі жолы сол жаққа барыңыз.
Dialogue: 0,0:15:19.54,0:15:20.62,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:15:20.75,0:15:23.88,Default,,0,0,0,,Күн сайын өзіңізді шағын шкафқа жабыңыз.
Dialogue: 0,0:15:23.96,0:15:25.34,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:15:25.46,0:15:27.76,Default,,0,0,0,,Тіпті ойын алаңы қазірдің өзінде кішкентай.
Dialogue: 0,0:15:27.88,0:15:28.80,Default,,0,0,0,,Иә
Dialogue: 0,0:15:29.26,0:15:32.09,Default,,0,0,0,,Мен сені анда-санда серуендетуім керек пе?
Dialogue: 0,0:15:32.97,0:15:34.26,Default,,0,0,0,,Сіз мені шығарып саласыз ба?
Dialogue: 0,0:15:34.51,0:15:36.97,Default,,0,0,0,,үшін Писукені көрсе, шу шығар еді.
Dialogue: 0,0:15:37.10,0:15:39.77,Default,,0,0,0,,Қараңдар, бәрің, мен сендерді таң қалдырамын.
Dialogue: 0,0:15:39.89,0:15:41.14,Default,,0,0,0,,Динозавр үй жануарлары?
Dialogue: 0,0:15:41.23,0:15:44.73,Default,,0,0,0,,Бұл бүкіл Жапонияда қызу тақырыпқа айналады... Уау, бүкіл әлемде.
Dialogue: 0,0:15:44.86,0:15:47.19,Default,,0,0,0,,Ал Писукені алып кетеді.
Dialogue: 0,0:15:55.20,0:15:57.91,Default,,0,0,0,,Ғалымдар зерттеу үшін бөлшектей ме?
Dialogue: 0,0:15:58.04,0:16:00.70,Default,,0,0,0,,Әлде хайуанаттар бағында көрмеге қою керек пе?
Dialogue: 0,0:16:03.83,0:16:08.55,Default,,0,0,0,,Қалай болғанда да, бұл Писуке үшін өмір сүру қиын дүние.
Dialogue: 0,0:16:19.35,0:16:20.56,Default,,0,0,0,,P-көмек
Dialogue: 0,0:16:23.19,0:16:24.77,Default,,0,0,0,,Пи-суке (П-суке) Пуй
Dialogue: 0,0:16:26.15,0:16:30.40,Default,,0,0,0,,Мен сізді 100 миллион жыл бұрын қайтару үшін уақыт машинасын пайдаланғалы жатырмын.
Dialogue: 0,0:16:30.53,0:16:33.70,Default,,0,0,0,,Бірақ оған дейін мен Сунеоны жылатамын.
Dialogue: 0,0:16:33.82,0:16:35.49,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:16:36.45,0:16:39.12,Default,,0,0,0,,Ах~ Ыстық.
Dialogue: 0,0:16:40.83,0:16:43.62,Default,,0,0,0,,Шелектегі судың өзі тез жылып кетеді.
Dialogue: 0,0:16:43.75,0:16:46.04,Default,,0,0,0,,Бейшара Нобита, егер майдан жақсы болмаса.
Dialogue: 0,0:16:46.17,0:16:48.13,Default,,0,0,0,,Тым болмаса бақшаға шомылайын.
Dialogue: 0,0:16:48.25,0:16:51.09,Default,,0,0,0,,Иә? Бұл да қауіпті емес пе?
Dialogue: 0,0:16:54.97,0:16:56.30,Default,,0,0,0,,Дәл қазір, Писуке.
Dialogue: 0,0:16:56.43,0:16:59.56,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:17:00.14,0:17:02.14,Default,,0,0,0,,Сіз бақыттысыз ба? П-суке
Dialogue: 0,0:17:02.27,0:17:05.56,Default,,0,0,0,,Бұл мен балабақшада жүргенде пайдаланатын бассейн.
Dialogue: 0,0:17:05.69,0:17:06.52,Default,,0,0,0,,Нобита
Dialogue: 0,0:17:07.06,0:17:08.61,Default,,0,0,0,,О, мама мама
Dialogue: 0,0:17:08.73,0:17:11.44,Default,,0,0,0,,Эй, эй, мына бассейн есімде.
Dialogue: 0,0:17:11.57,0:17:14.40,Default,,0,0,0,,Балабақшадағы уақытымды есіме түсіргеніме көп уақыт болды.
Dialogue: 0,0:17:14.53,0:17:16.49,Default,,0,0,0,,Уфуфу Уфуфу... Хаа~
Dialogue: 0,0:17:16.78,0:17:20.20,Default,,0,0,0,,Нобита, шын айтсаңшы.
Dialogue: 0,0:17:20.33,0:17:23.95,Default,,0,0,0,,Соңғы кездері тоңазытқышта балық пен ет таусылып қалды.
Dialogue: 0,0:17:24.08,0:17:26.46,Default,,0,0,0,,Сіз ит пен мысықты жасырын ұстамайсыз ба?
Dialogue: 0,0:17:26.58,0:17:28.88,Default,,0,0,0,,Дұрыс! Құдайға ант етемін
Dialogue: 0,0:17:29.21,0:17:32.21,Default,,0,0,0,,Жасырсаң, анам білмейді.
Dialogue: 0,0:17:32.34,0:17:34.01,Default,,0,0,0,,Жақсы (Нобита) Иә.
Dialogue: 0,0:17:35.30,0:17:38.93,Default,,0,0,0,,Уау, менде үй жануарлары динозавры бар.
Dialogue: 0,0:17:39.05,0:17:41.35,Default,,0,0,0,,Анашым, сен аударылып ұйықтап кетесің деп ойлаймын.
Dialogue: 0,0:17:41.47,0:17:42.85,Default,,0,0,0,,Сондықтан мен сізге айтпаймын.
Dialogue: 0,0:17:43.68,0:17:47.44,Default,,0,0,0,,(айқай)
Dialogue: 0,0:17:54.94,0:17:57.86,Default,,0,0,0,,Йошо Йоскойшо
Dialogue: 0,0:17:59.87,0:18:03.08,Default,,0,0,0,,Оның өскені сонша, мен оны жасырып ұстай алмаймын.
Dialogue: 0,0:18:03.20,0:18:04.95,Default,,0,0,0,,Бор кезеңінің уақыты жақындап қалды...
Dialogue: 0,0:18:05.29,0:18:09.42,Default,,0,0,0,,Жоқ, әлі жоқ. Оны үлкейтіп, Сунеоны дірілдетіңіз.
Dialogue: 0,0:18:16.97,0:18:20.18,Default,,0,0,0,,Дораемон, мен оны саябақтағы тоғанға жібердім, сондықтан ол қазір қауіпсіз.
Dialogue: 0,0:18:20.30,0:18:22.26,Default,,0,0,0,,Саябақ? (Нобита) Жарайды.
Dialogue: 0,0:18:22.39,0:18:24.68,Default,,0,0,0,,Мен сені шақырмайынша бетіңді көрсетпе.
Dialogue: 0,0:18:24.81,0:18:26.35,Default,,0,0,0,,Саған сақ бол дедім.
Dialogue: 0,0:18:26.48,0:18:29.73,Default,,0,0,0,,Хмм, бұл қандай екен деп ойлаймын.
Dialogue: 0,0:18:43.49,0:18:45.24,Default,,0,0,0,,Дыбыс... аааа
Dialogue: 0,0:18:48.41,0:18:49.41,Default,,0,0,0,,О
Dialogue: 0,0:18:49.67,0:18:51.38,Default,,0,0,0,,Пуэй
Dialogue: 0,0:18:54.21,0:18:57.30,Default,,0,0,0,,Мені аяғымнан тани аласың ба? О, жарайды
Dialogue: 0,0:18:58.09,0:19:01.64,Default,,0,0,0,,Жалғыз болдыңыз ба? Кешіріңіз, мен түнде ғана келе аламын.
Dialogue: 0,0:19:01.76,0:19:02.72,Default,,0,0,0,,Пуэй
Dialogue: 0,0:19:04.18,0:19:06.52,Default,,0,0,0,,Бүгінгі кештің кәдесыйы – шұжық.
Dialogue: 0,0:19:06.64,0:19:07.68,Default,,0,0,0,,Пуэй
Dialogue: 0,0:19:08.06,0:19:08.77,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:19:09.73,0:19:12.40,Default,,0,0,0,,Sora Eat иә.
Dialogue: 0,0:19:13.94,0:19:15.65,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:19:18.32,0:19:20.53,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:19:20.90,0:19:22.95,Default,,0,0,0,,Кешіріңіз, кешіріңіз, Сора.
Dialogue: 0,0:19:34.84,0:19:35.67,Default,,0,0,0,,Ах
Dialogue: 0,0:19:36.21,0:19:38.92,Default,,0,0,0,,Писуке, жаңбыр жауып тұр, мен тағы келемін.
Dialogue: 0,0:19:40.80,0:19:41.84,Default,,0,0,0,,Пуэй
Dialogue: 0,0:20:06.45,0:20:07.70,Default,,0,0,0,,Пи-суке!
Dialogue: 0,0:20:47.45,0:20:50.54,Default,,0,0,0,,Писуке, сен қазір не істеп жүрсің деп ойлаймын.
Dialogue: 0,0:20:52.96,0:20:54.62,Default,,0,0,0,,А, Дораемон, қалай болды?
Dialogue: 0,0:20:55.08,0:20:58.63,Default,,0,0,0,,Иә... сондықтан мүлде жемейді.
Dialogue: 0,0:20:58.75,0:21:01.63,Default,,0,0,0,,Ол сені сағынатын сияқты.
Dialogue: 0,0:21:02.05,0:21:04.09,Default,,0,0,0,,Нобита-кун суық тиген соң
Dialogue: 0,0:21:04.22,0:21:06.43,Default,,0,0,0,,Үш күннен бері бір-бірімізді көрмедік.
Dialogue: 0,0:21:06.55,0:21:07.93,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:08.05,0:21:09.89,Default,,0,0,0,,Ах
Dialogue: 0,0:21:10.01,0:21:10.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:11.93,0:21:12.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:13.35,0:21:14.69,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:21:14.81,0:21:17.85,Default,,0,0,0,,(шу)
Dialogue: 0,0:21:17.98,0:21:19.86,Default,,0,0,0,,Уау! (Нобита) Уау, Писуке!
Dialogue: 0,0:21:20.52,0:21:23.49,Default,,0,0,0,,О, бұл жақсы емес.
Dialogue: 0,0:21:23.74,0:21:25.70,Default,,0,0,0,,О, Писуке
Dialogue: 0,0:21:26.49,0:21:29.62,Default,,0,0,0,,Егер сізді біреу көрсе, не істейсіз? Сіз осы уақытқа дейін келдіңіз.
Dialogue: 0,0:21:30.12,0:21:32.58,Default,,0,0,0,,Сен Нобита-кунға қонаққа келдің ғой, солай ма?
Dialogue: 0,0:21:32.83,0:21:35.54,Default,,0,0,0,,А, түсіндім, Писуке.
Dialogue: 0,0:21:36.96,0:21:38.42,Default,,0,0,0,,Сабырлы болыңыз.
Dialogue: 0,0:21:38.54,0:21:41.09,Default,,0,0,0,,Негізі мен сені күнде көргім келеді.
Dialogue: 0,0:21:41.21,0:21:44.05,Default,,0,0,0,,Эй, сен жақсы баласың, Пи-суке.
Dialogue: 0,0:21:45.01,0:21:48.26,Default,,0,0,0,,Дорэмон, Писукені саябаққа апар.
Dialogue: 0,0:21:48.39,0:21:49.34,Default,,0,0,0,,Иә
Dialogue: 0,0:21:50.30,0:21:51.64,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:22:05.49,0:22:07.74,Default,,0,0,0,,Дұрыс тамақтаныңыз!
Dialogue: 0,0:22:08.28,0:22:10.66,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:22:11.99,0:22:15.08,Default,,0,0,0,,Мен бұдан былай күте алмаймын.
Dialogue: 0,0:22:32.43,0:22:35.93,Default,,0,0,0,,Эй Сунео, мен саған бүгін кешке не уәде еткенімді көрсетемін.
Dialogue: 0,0:22:36.22,0:22:38.02,Default,,0,0,0,,О, Нобита-чан
Dialogue: 0,0:22:38.14,0:22:39.77,Default,,0,0,0,,Бүгіннен бастап мерекелерді бастаймыз ба?
Dialogue: 0,0:22:39.90,0:22:44.02,Default,,0,0,0,,Сунео Чама түнеу үшін Каруизаваға барды.
Dialogue: 0,0:22:44.44,0:22:47.11,Default,,0,0,0,,Шизука да түнгі сапарға шыға ма?
Dialogue: 0,0:22:48.20,0:22:51.20,Default,,0,0,0,,Толық емес жұмыс ретінде мен атаммен бірге тауға шөп шабуға бардым.
Dialogue: 0,0:22:51.70,0:22:53.33,Default,,0,0,0,,Джан Мока
Dialogue: 0,0:22:53.45,0:22:57.25,Default,,0,0,0,,Бұл мұнда ешкім жоқ дегенді білдіре ме?
Dialogue: 0,0:22:57.58,0:22:59.83,Default,,0,0,0,,Эй, сен білесің бе? саябақтағы тоғанда
Dialogue: 0,0:22:59.96,0:23:01.75,Default,,0,0,0,,Динозаврлар бар. (2-қыз) Иә?
Dialogue: 0,0:23:02.29,0:23:03.46,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:23:03.59,0:23:06.25,Default,,0,0,0,,Оны көрген адамдар бар екеніне сенімдімін.
Dialogue: 0,0:23:06.38,0:23:07.71,Default,,0,0,0,,Иә~ (Нобита) Иә?
Dialogue: 0,0:23:08.01,0:23:10.97,Default,,0,0,0,,Биологиялық қоғам бұл мүмкін емес деп, оны жоққа шығарады.
Dialogue: 0,0:23:11.09,0:23:13.89,Default,,0,0,0,,Сыбыс тараған соң, билік басын бере алмады
Dialogue: 0,0:23:14.01,0:23:16.85,Default,,0,0,0,,Мен ертең тоғанға сүңгуірді тергеу үшін жіберуді шештім.
Dialogue: 0,0:23:16.93,0:23:17.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:17.77,0:23:19.39,Default,,0,0,0,,Жаңалық келе салысымен...
Dialogue: 0,0:23:19.52,0:23:22.40,Default,,0,0,0,,Саябақтағы тоғанда құбыжық бар...
Dialogue: 0,0:23:22.52,0:23:25.32,Default,,0,0,0,,Do Doraemon... Не істеу керек? не болу керек?
Dialogue: 0,0:23:25.65,0:23:28.36,Default,,0,0,0,,Егер сіз мұны менен сұрасаңыз, бір ғана жауап бар.
Dialogue: 0,0:23:28.49,0:23:31.24,Default,,0,0,0,,Писукені мүмкіндігінше тезірек 100 миллион жыл бұрынғыға қайтарыңыз.
Dialogue: 0,0:23:31.36,0:23:34.12,Default,,0,0,0,,Мұндай спагетти...
Dialogue: 0,0:23:34.24,0:23:37.74,Default,,0,0,0,,Мұқият ойлан, бұл сенің динозаврың.
Dialogue: 0,0:23:38.50,0:23:39.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:48.59,0:23:50.01,Default,,0,0,0,,P-көмек...
Dialogue: 0,0:23:50.38,0:23:52.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:57.51,0:24:00.43,Default,,0,0,0,,Ой, бұл кім?
Dialogue: 0,0:24:01.94,0:24:03.81,Default,,0,0,0,,Сіз Нобита-кун дедіңіз.
Dialogue: 0,0:24:03.94,0:24:07.02,Default,,0,0,0,,Біз сізді және сол динозаврды зерттедік.
Dialogue: 0,0:24:07.15,0:24:09.69,Default,,0,0,0,,Мен оған сол динозаврды беруді шештім.
Dialogue: 0,0:24:10.15,0:24:13.16,Default,,0,0,0,,Мен мұндай нәрсеге жол бермеймін.
Dialogue: 0,0:24:13.70,0:24:15.53,Default,,0,0,0,,Мен бүгін үйге барамын.
Dialogue: 0,0:24:15.66,0:24:18.58,Default,,0,0,0,,Мен оны маған беруіңізді міндетті түрде сұраймын, сондықтан менің ниетім осы.
Dialogue: 0,0:24:28.38,0:24:29.46,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:24:29.96,0:24:31.42,Default,,0,0,0,,Егер бұл орын алса, бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:24:31.55,0:24:34.18,Default,,0,0,0,,Өйткені, Писукені 100 миллион жыл бұрынғыға қайтару керек.
Dialogue: 0,0:24:57.41,0:24:59.24,Default,,0,0,0,,Дораэмон Кіші жарық
Dialogue: 0,0:24:59.37,0:25:00.24,Default,,0,0,0,,Иә
Dialogue: 0,0:25:01.08,0:25:01.79,Default,,0,0,0,,Иә
Dialogue: 0,0:25:12.96,0:25:15.18,Default,,0,0,0,,Пуй Пуй Пуй
Dialogue: 0,0:25:18.97,0:25:21.22,Default,,0,0,0,,Дораэмон Тезірек барайық
Dialogue: 0,0:25:27.94,0:25:29.69,Default,,0,0,0,,Йоишото
Dialogue: 0,0:25:29.81,0:25:31.52,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:25:37.49,0:25:40.08,Default,,0,0,0,,Писуке, сәл ғана ұстаңыз.
Dialogue: 0,0:25:40.20,0:25:41.83,Default,,0,0,0,,Уау, уау, не?
Dialogue: 0,0:25:42.70,0:25:43.83,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:25:44.37,0:25:48.29,Default,,0,0,0,,Уәде бойынша мен сол динозаврды алуға келдім.
Dialogue: 0,0:25:48.46,0:25:50.50,Default,,0,0,0,,Әй, баяғыда сол қара адам.
Dialogue: 0,0:25:50.67,0:25:52.63,Default,,0,0,0,,Сіз білесіз бе? (Нобита) Мен келемін.
Dialogue: 0,0:25:52.75,0:25:55.05,Default,,0,0,0,,Ол Писукені ұрлау үшін келді.
Dialogue: 0,0:25:55.17,0:25:56.63,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:25:56.76,0:25:57.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:25:59.64,0:26:00.89,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:26:01.47,0:26:03.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:26:04.47,0:26:06.27,Default,,0,0,0,,Қыңыр жігіт
Dialogue: 0,0:26:06.69,0:26:07.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:08.65,0:26:11.36,Default,,0,0,0,,Енді маған сол динозаврды беріңіз.
Dialogue: 0,0:26:12.69,0:26:13.36,Default,,0,0,0,,Уау
Dialogue: 0,0:26:13.48,0:26:15.82,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:26:15.94,0:26:17.86,Default,,0,0,0,,Иә? Ия, иә!
Dialogue: 0,0:26:41.97,0:26:43.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:45.47,0:26:47.31,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:27:02.41,0:27:04.95,Default,,0,0,0,,Йойшо Дораемон Үлкен жарық
Dialogue: 0,0:27:05.08,0:27:05.99,Default,,0,0,0,,Иә
Dialogue: 0,0:27:12.33,0:27:14.84,Default,,0,0,0,,Писуке, бұл сенің әлемің.
Dialogue: 0,0:27:19.51,0:27:21.80,Default,,0,0,0,,Мұнда бақытты өмір сүр
Dialogue: 0,0:27:23.05,0:27:24.47,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:27:24.89,0:27:27.85,Default,,0,0,0,,Олай болса, сау болыңыз. Қош бол.
Dialogue: 0,0:27:30.60,0:27:32.85,Default,,0,0,0,,Пуй (Нобита) Уау Уау Уау
Dialogue: 0,0:27:33.19,0:27:34.86,Default,,0,0,0,,А-а, сәл күте тұрыңыз.
Dialogue: 0,0:27:35.82,0:27:39.15,Default,,0,0,0,,Менің артымнан келе алмасаң,
Dialogue: 0,0:27:39.28,0:27:40.24,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:27:42.16,0:27:44.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:27:45.45,0:27:46.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:46.62,0:27:47.95,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:27:48.50,0:27:50.21,Default,,0,0,0,,Қазірдің өзінде! Қарғыс атсын
Dialogue: 0,0:27:54.00,0:27:55.17,Default,,0,0,0,,Пуэй
Dialogue: 0,0:27:57.75,0:27:58.80,Default,,0,0,0,,Пуэй
Dialogue: 0,0:28:03.13,0:28:04.09,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:28:05.30,0:28:05.97,Default,,0,0,0,,Пуэй
Dialogue: 0,0:28:06.55,0:28:09.39,Default,,0,0,0,,Пи-суке! Бұл сіз үшін ең жақсы жер.
Dialogue: 0,0:28:09.52,0:28:11.56,Default,,0,0,0,,Пуу
Dialogue: 0,0:28:12.69,0:28:15.31,Default,,0,0,0,,Осыны айтсам да түсінбейсің бе?
Dialogue: 0,0:28:17.57,0:28:18.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:20.44,0:28:22.49,Default,,0,0,0,,Дораемон кеттік
Dialogue: 0,0:28:30.70,0:28:32.71,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:28:34.75,0:28:35.83,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:28:49.64,0:28:52.27,Default,,0,0,0,,Пуэй
Dialogue: 0,0:28:53.60,0:28:55.77,Default,,0,0,0,,(Писукенің жаңғырық дауысы)
Dialogue: 0,0:29:03.65,0:29:10.41,Default,,0,0,0,,Пуэй
Dialogue: 0,0:29:16.21,0:29:22.84,Default,,0,0,0,,Пуэй
Dialogue: 0,0:29:28.72,0:29:33.18,Default,,0,0,0,,Пуэй
Dialogue: 0,0:29:58.54,0:30:01.50,Default,,0,0,0,,Бұл жолы Нобита-кун маған сенбейді.
Dialogue: 0,0:30:01.63,0:30:06.76,Default,,0,0,0,,Қалай болғанда да, менің өз бетімше ойлап, әрекет етуімнің маңызы зор болды.
Dialogue: 0,0:30:16.56,0:30:17.19,Default,,0,0,0,,Пуэй
Dialogue: 0,0:30:19.06,0:30:22.65,Default,,0,0,0,,...
Dialogue: 0,0:30:23.36,0:30:25.90,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:30:30.70,0:30:33.79,Default,,0,0,0,,Нобита, мен спагеттиді мұрынмен жеуге уәде беремін.
Dialogue: 0,0:30:34.54,0:30:36.58,Default,,0,0,0,,Нобита-кун Джан мен Сунео
Dialogue: 0,0:30:39.25,0:30:40.54,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:30:43.21,0:30:44.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:46.30,0:30:47.42,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:30:47.51,0:30:49.43,Default,,0,0,0,,Жүр, мұрныңмен жейміз.
Dialogue: 0,0:30:49.55,0:30:53.85,Default,,0,0,0,,Бірақ мен тұтас динозаврды өсірдім.
Dialogue: 0,0:30:53.97,0:30:55.10,Default,,0,0,0,,Өйткені бұл шындық
Dialogue: 0,0:30:55.22,0:30:56.85,Default,,0,0,0,,Әлі де солай айтып жатыр
Dialogue: 0,0:30:57.48,0:30:59.27,Default,,0,0,0,,Өлім алдында тұрған жаман жігіт.
Dialogue: 0,0:30:59.56,0:31:01.52,Default,,0,0,0,,Маған сеніңіз, бұл рас.
Dialogue: 0,0:31:01.69,0:31:04.61,Default,,0,0,0,,Тым шулы болмаңыз! Жүр, жей бер.
Dialogue: 0,0:31:04.73,0:31:07.28,Default,,0,0,0,,Эй, эй... (Сунео) Мұрынмен тамақтан. Мұрынмен тамақтаныңыз.
Dialogue: 0,0:31:07.40,0:31:09.03,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:31:12.49,0:31:13.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:14.78,0:31:16.04,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:31:16.29,0:31:17.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:19.00,0:31:20.12,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:31:21.92,0:31:22.67,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:31:22.92,0:31:25.21,Default,,0,0,0,,Не болды? Сол кезден бастап
Dialogue: 0,0:31:25.34,0:31:26.75,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:31:26.88,0:31:28.63,Default,,0,0,0,,Ааа
Dialogue: 0,0:31:29.22,0:31:32.34,Default,,0,0,0,,Уф, кешір мені Сунео мен Джиан қуып жүр.
Dialogue: 0,0:31:32.47,0:31:34.26,Default,,0,0,0,,Ал, уәде?
Dialogue: 0,0:31:34.39,0:31:35.39,Default,,0,0,0,,Иә...
Dialogue: 0,0:31:35.89,0:31:37.68,Default,,0,0,0,,Тек оны жасырыңыз.
Dialogue: 0,0:31:38.85,0:31:40.39,Default,,0,0,0,,Күрсін
Dialogue: 0,0:31:41.23,0:31:43.40,Default,,0,0,0,,Бастау үшін бұл ақылсыз әңгіме болды.
Dialogue: 0,0:31:43.52,0:31:46.40,Default,,0,0,0,,Қазіргі кезде тірі динозаврлар болуы мүмкін емес.
Dialogue: 0,0:31:46.52,0:31:49.24,Default,,0,0,0,,Спагеттиді мұрынмен жеуге болмайды.
Dialogue: 0,0:31:49.90,0:31:53.16,Default,,0,0,0,,Егер сіз жай ғана кешірім сұрасаңыз, бұл жай ғана әзіл емес пе?
Dialogue: 0,0:31:53.28,0:31:56.74,Default,,0,0,0,,Өйткені, мен динозаврларды қалаймын...
Dialogue: 0,0:31:56.87,0:31:58.12,Default,,0,0,0,,Жақсы
Dialogue: 0,0:31:58.24,0:32:01.29,Default,,0,0,0,,Кез келген адам өз еркімен өтірік айта алады.
Dialogue: 0,0:32:01.41,0:32:05.17,Default,,0,0,0,,Мәңгілікке қыңыр болып жүру ер мінезді емес деп ойлаймын.
Dialogue: 0,0:32:05.71,0:32:06.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:07.71,0:32:10.63,Default,,0,0,0,,Осыншама талап етсең, көрсетемін. О, мен саған көрсетемін.
Dialogue: 0,0:32:15.01,0:32:16.64,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:32:16.76,0:32:20.81,Default,,0,0,0,,Кем дегенде барлығына Писуке Time TV-де көрсетіңіз.
Dialogue: 0,0:32:22.44,0:32:24.65,Default,,0,0,0,,Тек теледидар жақсы болар еді, солай ма?
Dialogue: 0,0:32:24.77,0:32:26.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:32:28.78,0:32:29.82,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:32:30.82,0:32:33.66,Default,,0,0,0,,L өліпті
Dialogue: 0,0:32:38.58,0:32:39.62,Default,,0,0,0,,Пуэй
Dialogue: 0,0:32:40.58,0:32:41.45,Default,,0,0,0,,Әй, Писуке!
Dialogue: 0,0:32:50.09,0:32:51.51,Default,,0,0,0,,Пуэй
Dialogue: 0,0:32:53.51,0:32:54.30,Default,,0,0,0,,Пюэй
Dialogue: 0,0:32:56.72,0:32:57.64,Default,,0,0,0,,Пуэй
Dialogue: 0,0:33:00.72,0:33:02.48,Default,,0,0,0,,(Динозаврлар айқайлайды)
Dialogue: 0,0:33:09.57,0:33:11.11,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:33:11.65,0:33:14.07,Default,,0,0,0,,Ха, бұл үлкен мәселе.
Dialogue: 0,0:33:14.20,0:33:15.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:15.86,0:33:18.66,Default,,0,0,0,,Писуке - Жапониядан шыққан плезиозавр.
Dialogue: 0,0:33:18.78,0:33:21.58,Default,,0,0,0,,Мен оны дұрыс емес жерге жіберген сияқтымын.
Dialogue: 0,0:33:21.70,0:33:22.79,Default,,0,0,0,,Не?
Dialogue: 0,0:33:22.91,0:33:25.33,Default,,0,0,0,,Уақыт машиналары өткенге немесе болашаққа барады
Dialogue: 0,0:33:25.46,0:33:28.58,Default,,0,0,0,,Басқаша айтқанда, уақыт бойынша саяхат функциясы және тағы бір нәрсе.
Dialogue: 0,0:33:28.71,0:33:30.88,Default,,0,0,0,,Одан ол жерге, одан анау жерге
Dialogue: 0,0:33:31.00,0:33:34.26,Default,,0,0,0,,Орыннан орынға жылжу Кеңістіктік қозғалыс функциясы бар.
Dialogue: 0,0:33:34.38,0:33:38.30,Default,,0,0,0,,Ғарышқа сапар шегетін құрылғыны сол қара адам жойған.
Dialogue: 0,0:33:38.43,0:33:39.89,Default,,0,0,0,,Осылайша
Dialogue: 0,0:33:42.02,0:33:43.64,Default,,0,0,0,,Ең қорқынышты жер қай жерде?
Dialogue: 0,0:33:44.39,0:33:47.10,Default,,0,0,0,,Хмм, менің ойымша, бұл Солтүстік Америка материгі.
Dialogue: 0,0:33:47.23,0:33:48.73,Default,,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:33:48.86,0:33:52.32,Default,,0,0,0,,Дораэмон Писукені бірден Бор дәуіріндегі Жапонияға қайтарайық.
Dialogue: 0,0:33:52.44,0:33:53.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:33:53.48,0:33:56.28,Default,,0,0,0,,Тезірек, Дораемон, аа!
Dialogue: 0,0:33:57.32,0:33:59.16,Default,,0,0,0,,Әй, ауырады... (Нобита) Қараңызшы.
Dialogue: 0,0:33:59.28,0:34:00.87,Default,,0,0,0,,Біз де барамыз, жарай ма?
Dialogue: 0,0:34:00.95,0:34:02.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:02.20,0:34:03.75,Default,,0,0,0,,Бұл біраз ақылсыз.
Dialogue: 0,0:34:03.87,0:34:06.04,Default,,0,0,0,,Сыйымдылығымыз асып кетті. Өтінемін, түсіңіз.
Dialogue: 0,0:34:06.16,0:34:08.58,Default,,0,0,0,,Уау
Dialogue: 0,0:34:27.94,0:34:31.86,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:34:38.91,0:34:41.16,Default,,0,0,0,,Менің басым айналып кетті!
Dialogue: 0,0:34:41.28,0:34:46.00,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:35:29.29,0:35:30.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:30.58,0:35:32.33,Default,,0,0,0,,Хмм (Сунео) Ах!
Dialogue: 0,0:35:32.46,0:35:33.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:33.42,0:35:37.17,Default,,0,0,0,,Не болып жатыр? Дораемонның сұмдығы.
Dialogue: 0,0:35:37.30,0:35:38.59,Default,,0,0,0,,Дораемон туралы не деуге болады?
Dialogue: 0,0:35:39.84,0:35:42.51,Default,,0,0,0,,Дораемонсыз бізбен не болар еді?
Dialogue: 0,0:35:42.64,0:35:44.55,Default,,0,0,0,,Ах хмм
Dialogue: 0,0:35:45.47,0:35:48.98,Default,,0,0,0,,Дораемон! (үшін) Дораемон!
Dialogue: 0,0:35:49.10,0:35:50.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:50.35,0:35:53.35,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,0:35:53.65,0:35:55.23,Default,,0,0,0,,Міне.
Dialogue: 0,0:35:56.48,0:35:58.11,Default,,0,0,0,,Міне!
Dialogue: 0,0:36:01.03,0:36:02.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:05.45,0:36:06.33,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:36:06.62,0:36:09.50,Default,,0,0,0,,Жақсы жақсы Дораемон
Dialogue: 0,0:36:09.62,0:36:10.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:12.04,0:36:15.96,Default,,0,0,0,,Міне, мен Писукемен ажырастым. Алақай!
Dialogue: 0,0:36:16.21,0:36:18.38,Default,,0,0,0,,О? Жарайды
Dialogue: 0,0:36:23.05,0:36:24.09,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:36:24.84,0:36:26.64,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:36:30.10,0:36:32.85,Default,,0,0,0,,Хмм? Ахх
Dialogue: 0,0:36:38.69,0:36:41.74,Default,,0,0,0,,Пи-суке~!
Dialogue: 0,0:36:57.84,0:36:59.00,Default,,0,0,0,,P-көмек...
Dialogue: 0,0:37:01.46,0:37:04.22,Default,,0,0,0,,Пи… (Пи-суке) Пуи
Dialogue: 0,0:37:04.93,0:37:07.97,Default,,0,0,0,,Әй, Пи-суке! Ия
Dialogue: 0,0:37:08.72,0:37:09.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:37:09.89,0:37:11.72,Default,,0,0,0,,Пи-суке Пи-суке!
Dialogue: 0,0:37:11.85,0:37:14.19,Default,,0,0,0,,Ах~ (P-көмек) Пуй Пуй
Dialogue: 0,0:37:14.31,0:37:16.15,Default,,0,0,0,,Пи-суке! Ия ия
Dialogue: 0,0:37:16.56,0:37:20.15,Default,,0,0,0,,Пи-суке Пи-суке Пи… (Пи-суке) Пуй
Dialogue: 0,0:37:28.82,0:37:32.83,Default,,0,0,0,,Ах, Писуке, танысқаныма қуаныштымын.
Dialogue: 0,0:37:32.95,0:37:34.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:39.59,0:37:42.46,Default,,0,0,0,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:37:42.59,0:37:44.34,Default,,0,0,0,,Сізге күмәнданғаным үшін кешіріңіз.
Dialogue: 0,0:37:45.09,0:37:48.30,Default,,0,0,0,,Хе, білсем ғой, бірақ бұл рас еді ғой?
Dialogue: 0,0:37:49.14,0:37:52.18,Default,,0,0,0,,Иә, мм
Dialogue: 0,0:37:52.97,0:37:56.31,Default,,0,0,0,,Бұл шынайы. Бұл нағыз Футаба Басс Кирю.
Dialogue: 0,0:37:56.60,0:37:57.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:58.94,0:38:02.19,Default,,0,0,0,,Йойшо Йойшо Йойшо Йойшо Йойшо
Dialogue: 0,0:38:02.57,0:38:04.65,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:38:04.90,0:38:08.20,Default,,0,0,0,,Уау, сен сондай сүйкімдісің (Сунео) Жүр, жүр.
Dialogue: 0,0:38:08.32,0:38:09.62,Default,,0,0,0,,Жүр, жүр, Писуке?
Dialogue: 0,0:38:12.45,0:38:14.00,Default,,0,0,0,,(Дораэмонның күрсінуі)
Dialogue: 0,0:38:14.83,0:38:15.58,Default,,0,0,0,,Бекітілмеген
Dialogue: 0,0:38:16.16,0:38:17.16,Default,,0,0,0,,...
Dialogue: 0,0:38:18.62,0:38:19.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:38:20.88,0:38:23.42,Default,,0,0,0,,Элазмосавр платиурусы
Dialogue: 0,0:38:23.55,0:38:25.51,Default,,0,0,0,,Тіпті бір плезиозаврлар тұқымдасының мүшелері
Dialogue: 0,0:38:25.63,0:38:28.18,Default,,0,0,0,,Жапония мен Америка әртүрлі типтер.
Dialogue: 0,0:38:28.68,0:38:31.64,Default,,0,0,0,,Аа, сен маған қосыла алмайсың ба?
Dialogue: 0,0:38:31.76,0:38:33.56,Default,,0,0,0,,Бірақ Писуке, уайымдама.
Dialogue: 0,0:38:33.68,0:38:37.14,Default,,0,0,0,,Мен сені бірден Жапонияға апарамын.
Dialogue: 0,0:38:57.96,0:39:01.04,Default,,0,0,0,,Хмм... аа аа
Dialogue: 0,0:39:09.59,0:39:13.10,Default,,0,0,0,,Дорэмон, тезірек Писукені Жапонияға қайтарайық.
Dialogue: 0,0:39:13.76,0:39:15.56,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:39:16.27,0:39:18.81,Default,,0,0,0,,Өйткені, біз мұнда 100 миллион жыл бұрын келдік.
Dialogue: 0,0:39:18.93,0:39:21.06,Default,,0,0,0,,Біз де бүгін күні бойы осында тұрдық.
Dialogue: 0,0:39:21.19,0:39:23.48,Default,,0,0,0,,Ертең кетсем ше?
Dialogue: 0,0:39:23.86,0:39:26.23,Default,,0,0,0,,Ия, жақсы, жақсы.
Dialogue: 0,0:39:26.36,0:39:29.36,Default,,0,0,0,,Бірақ мен бүгінгі үй тапсырмасын әлі орындаған жоқпын.
Dialogue: 0,0:39:29.49,0:39:31.61,Default,,0,0,0,,Сондай-ақ, сұрамай басқа жерде ұйықтамаңыз.
Dialogue: 0,0:39:31.74,0:39:33.66,Default,,0,0,0,,Анам мені ұрсады
Dialogue: 0,0:39:33.78,0:39:36.95,Default,,0,0,0,,Дұрыс, дұрыс, Дораемон, жауапсыз ештеңе айтпа.
Dialogue: 0,0:39:37.62,0:39:38.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:39:41.17,0:39:42.92,Default,,0,0,0,,А, уайымдама.
Dialogue: 0,0:39:43.04,0:39:44.67,Default,,0,0,0,,Мен уақыт машинасымен келдім.
Dialogue: 0,0:39:44.79,0:39:47.76,Default,,0,0,0,,Бұл дүниеде қанша күн... тіпті жыл өмір сүрсең де.
Dialogue: 0,0:39:47.88,0:39:50.88,Default,,0,0,0,,Егер сіз кету уақытынан 5 минуттан кейін оралсаңыз,
Dialogue: 0,0:39:51.01,0:39:53.89,Default,,0,0,0,,Сонымен мен бар болғаны 5 минутқа кеттім.
Dialogue: 0,0:39:54.01,0:39:56.81,Default,,0,0,0,,Ойнайық! Писукемен бірге жүзейік.
Dialogue: 0,0:39:56.93,0:39:58.47,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:39:59.10,0:39:59.81,Default,,0,0,0,,Иә
Dialogue: 0,0:39:59.93,0:40:01.19,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:40:02.06,0:40:05.36,Default,,0,0,0,,Сіз осы теңшеу камерасымен купальник жасай аласыз.
Dialogue: 0,0:40:05.48,0:40:08.15,Default,,0,0,0,,Осы дизайн кітабында сүйікті дизайныңызды салыңыз.
Dialogue: 0,0:40:08.61,0:40:10.53,Default,,0,0,0,,О, дизайнды маған қалдырыңыз.
Dialogue: 0,0:40:14.20,0:40:15.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:40:17.66,0:40:18.41,Default,,0,0,0,,Иә
Dialogue: 0,0:40:20.91,0:40:23.37,Default,,0,0,0,,Олай болса барлығың сол жерге сапқа тұрыңдар.
Dialogue: 0,0:40:29.71,0:40:36.35,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:40:37.18,0:40:38.68,Default,,0,0,0,,А, жоқ (Джан Сунео) О!
Dialogue: 0,0:40:38.81,0:40:40.18,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:40:40.68,0:40:42.69,Default,,0,0,0,,Сессия Сессия сессиясы
Dialogue: 0,0:40:43.52,0:40:44.69,Default,,0,0,0,,Жарайды
Dialogue: 0,0:40:46.15,0:40:48.02,Default,,0,0,0,,Ойшотто (ысырма дыбысы)
Dialogue: 0,0:40:50.15,0:40:50.99,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:40:51.78,0:40:55.45,Default,,0,0,0,,Осы желбезек түтігімен теңіз суынан оттегімен дем алуға болады.
Dialogue: 0,0:40:55.57,0:40:59.16,Default,,0,0,0,,Осы терең теңіз кремін жақсаңыз, ол су температурасы мен су қысымына төтеп бере алады.
Dialogue: 0,0:40:59.29,0:41:01.41,Default,,0,0,0,,Уау~ (Писуке) Пуй
Dialogue: 0,0:41:02.41,0:41:04.54,Default,,0,0,0,,Міне!
Dialogue: 0,0:41:05.42,0:41:06.83,Default,,0,0,0,,Ооо аааа
Dialogue: 0,0:41:09.25,0:41:11.34,Default,,0,0,0,,Пюэй
Dialogue: 0,0:41:16.59,0:41:21.64,Default,,0,0,0,,(Нобитаның ыңырсыуы)
Dialogue: 0,0:41:22.35,0:41:24.14,Default,,0,0,0,,Тантакатаан
Dialogue: 0,0:41:24.77,0:41:27.06,Default,,0,0,0,,Yahoo және tottotto
Dialogue: 0,0:41:27.73,0:41:29.19,Default,,0,0,0,,Таа~
Dialogue: 0,0:41:30.82,0:41:32.94,Default,,0,0,0,,Йойшо Йоишокорашо Доккойшо
Dialogue: 0,0:41:54.80,0:41:55.84,Default,,0,0,0,,Хаха
Dialogue: 0,0:41:56.59,0:42:00.39,Default,,0,0,0,,Уфуфу Уау хммм сүйкімді
Dialogue: 0,0:42:01.81,0:42:03.97,Default,,0,0,0,,Уфу жақсы
Dialogue: 0,0:42:04.43,0:42:06.77,Default,,0,0,0,,(Екі адамның көңілді дауысы)
Dialogue: 0,0:42:06.89,0:42:10.36,Default,,0,0,0,,Бұл не? Бұл не? О, аммонит
Dialogue: 0,0:42:11.07,0:42:13.32,Default,,0,0,0,,Жақсы, аа
Dialogue: 0,0:42:23.16,0:42:26.33,Default,,0,0,0,,Иә? Хмм, аа
Dialogue: 0,0:42:26.87,0:42:28.87,Default,,0,0,0,,Уау
Dialogue: 0,0:42:58.07,0:42:59.15,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:42:59.28,0:43:01.87,Default,,0,0,0,,Дораэмонның қалтасына тіпті тамақ бар ма?
Dialogue: 0,0:43:01.99,0:43:03.66,Default,,0,0,0,,Дәмді тамақты көбірек же, мен.
Dialogue: 0,0:43:04.41,0:43:06.91,Default,,0,0,0,,Бұл заманда сән-салтанат.
Dialogue: 0,0:43:07.04,0:43:10.08,Default,,0,0,0,,Динозаврлар шықса, бізді жеп қояды, солай ма?
Dialogue: 0,0:43:11.21,0:43:12.50,Default,,0,0,0,,Дора-чан, не болды?
Dialogue: 0,0:43:12.63,0:43:14.96,Default,,0,0,0,,Иә? О... бұл ештеңе емес
Dialogue: 0,0:43:15.09,0:43:16.76,Default,,0,0,0,,Біртүрлі Дораемон
Dialogue: 0,0:43:16.88,0:43:20.47,Default,,0,0,0,,Бұл 100 миллион жыл бұрынғы әлемге көбірек ұқсайды.
Dialogue: 0,0:43:20.59,0:43:23.05,Default,,0,0,0,,100 миллион жыл бұрын неше жыл?
Dialogue: 0,0:43:23.80,0:43:26.02,Default,,0,0,0,,Дұрыс, сен, бір жылдан 100 миллион есе көп.
Dialogue: 0,0:43:26.39,0:43:29.35,Default,,0,0,0,,Сондықтан бұлай десеңіз де, маған мағынасы жоқ.
Dialogue: 0,0:43:29.60,0:43:31.98,Default,,0,0,0,,Мен бұл сезімді түсіне алмаймын деп ойлаймын.
Dialogue: 0,0:43:33.69,0:43:35.40,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:43:35.69,0:43:40.11,Default,,0,0,0,,Мысалы, атамыздың балалық шағы туралы әңгімелерді тыңдай аламыз.
Dialogue: 0,0:43:40.24,0:43:42.49,Default,,0,0,0,,Баяғыда сияқты сезілсе де
Dialogue: 0,0:43:42.62,0:43:45.37,Default,,0,0,0,,Ең көп дегенде 60 жыл бұрын болуы мүмкін.
Dialogue: 0,0:43:45.91,0:43:48.62,Default,,0,0,0,,100 миллион жылды 60-қа бөліңіз.
Dialogue: 0,0:43:48.75,0:43:51.79,Default,,0,0,0,,Атамның атасының...
Dialogue: 0,0:43:51.92,0:43:54.34,Default,,0,0,0,,Хмм, мен оны енді мүлдем түсінбеймін.
Dialogue: 0,0:43:54.46,0:43:56.80,Default,,0,0,0,,Әйтеуір, баяғыда.
Dialogue: 0,0:43:56.92,0:43:58.30,Default,,0,0,0,,Бұл біздің келе жатқанымызды білдіреді.
Dialogue: 0,0:43:58.55,0:44:00.42,Default,,0,0,0,,Ммм
Dialogue: 0,0:44:09.10,0:44:11.19,Default,,0,0,0,,Тарих жұмбақ, солай емес пе?
Dialogue: 0,0:44:15.56,0:44:21.11,Default,,0,0,0,,Пуэй
Dialogue: 0,0:44:21.65,0:44:23.24,Default,,0,0,0,,Мен тамақтанып болдым.
Dialogue: 0,0:44:23.36,0:44:26.08,Default,,0,0,0,,Мен осы мүмкіндікті пайдаланып, өз баяндамамды беремін.
Dialogue: 0,0:44:26.74,0:44:28.49,Default,,0,0,0,,Джиан ән айтады?
Dialogue: 0,0:44:28.83,0:44:30.33,Default,,0,0,0,,Сіз шағымданасыз ба? Нобита
Dialogue: 0,0:44:30.54,0:44:32.79,Default,,0,0,0,,Жоқ, жоқ, ән айтыңызшы. Иә.
Dialogue: 0,0:44:33.08,0:44:34.33,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:44:34.75,0:44:38.67,Default,,0,0,0,,♪ Дора Дора Дондо Дон Дон Дон Дон Дон
Dialogue: 0,0:44:38.80,0:44:42.68,Default,,0,0,0,,♪ Мен бұзық Джианмын
Dialogue: 0,0:44:42.80,0:44:46.39,Default,,0,0,0,,♪ Үй тапсырмасын тексеру Жақсы емес
Dialogue: 0,0:44:46.51,0:44:50.06,Default,,0,0,0,,♪ Мен әрқашан еркелік ойнаймын
Dialogue: 0,0:44:50.18,0:44:53.69,Default,,0,0,0,,♪ Сабақтан кейін маған қалдырыңыз
Dialogue: 0,0:44:53.81,0:44:57.48,Default,,0,0,0,,♪ Ах~ Зуккоке Хаккоке Хатчаке Хачамеча
Dialogue: 0,0:44:57.61,0:45:01.24,Default,,0,0,0,,♪ Мен тентек дәумін
Dialogue: 0,0:45:01.36,0:45:05.16,Default,,0,0,0,,♪ Ах~ Зуккоке Хаккоке Хатчаке Хачамеча
Dialogue: 0,0:45:05.28,0:45:08.16,Default,,0,0,0,,♪ Мен тентек дәумін
Dialogue: 0,0:45:08.49,0:45:10.66,Default,,0,0,0,,Уау~ Тоқта, тоқта, Джан.
Dialogue: 0,0:45:10.79,0:45:13.16,Default,,0,0,0,,Сіздің дауысыңызбен динозаврлар резонанс жасайды
Dialogue: 0,0:45:13.29,0:45:16.00,Default,,0,0,0,,Не? Мұндай жағдай бола ма?
Dialogue: 0,0:45:16.13,0:45:18.54,Default,,0,0,0,,♪ Дора Дора Дондо Дон Дон Дон Дон
Dialogue: 0,0:45:18.67,0:45:21.59,Default,,0,0,0,,(Динозаврлардың айқайы)
Dialogue: 0,0:45:21.96,0:45:24.34,Default,,0,0,0,,♪ Джан-сама
Dialogue: 0,0:45:24.47,0:45:25.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:26.97,0:45:30.14,Default,,0,0,0,,(Тиранозаврдың айқайы)
Dialogue: 0,0:45:30.26,0:45:32.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:33.85,0:45:35.44,Default,,0,0,0,,(үшінның қорқынышты дауыстары)
Dialogue: 0,0:45:35.73,0:45:37.90,Default,,0,0,0,,Додо Дораемон, маған көмектесіңізші
Dialogue: 0,0:45:39.57,0:45:41.11,Default,,0,0,0,,(үшінның қорқынышты дауыстары)
Dialogue: 0,0:45:42.40,0:45:44.24,Default,,0,0,0,,Дорэмон, сен не істеп жатырсың?
Dialogue: 0,0:45:55.33,0:45:59.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:46:08.97,0:46:10.43,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:46:10.55,0:46:13.68,Default,,0,0,0,,Болды, қазір үйге қайтайық.
Dialogue: 0,0:46:13.89,0:46:17.94,Default,,0,0,0,,Дұрыс, Писукені алып, 20 ғасырдағы Жапонияға оралайық.
Dialogue: 0,0:46:18.85,0:46:22.94,Default,,0,0,0,,Пуэй
Dialogue: 0,0:46:25.03,0:46:26.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:26.65,0:46:28.16,Default,,0,0,0,,Үйге бара алмайсыз ба?
Dialogue: 0,0:46:28.53,0:46:30.62,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:46:30.95,0:46:32.12,Default,,0,0,0,,Түсінікті болу үшін,
Dialogue: 0,0:46:32.20,0:46:34.45,Default,,0,0,0,,Уақыт машинасының ғарыштық саяхат құрылғысы
Dialogue: 0,0:46:34.54,0:46:35.70,Default,,0,0,0,,Ол сынған.
Dialogue: 0,0:46:35.83,0:46:37.41,Default,,0,0,0,,Ол енді түзетілмейді.
Dialogue: 0,0:46:37.54,0:46:40.54,Default,,0,0,0,,Бұл үйге бара алмайтынымызды білдіре ме?
Dialogue: 0,0:46:40.79,0:46:43.17,Default,,0,0,0,,Жоқ, сіз тек уақыт бойынша саяхаттай аласыз.
Dialogue: 0,0:46:43.30,0:46:45.59,Default,,0,0,0,,Мәселен, бұл уақыт машинасы
Dialogue: 0,0:46:45.71,0:46:47.51,Default,,0,0,0,,Егер сіз оны Жапонияға апарсаңыз...
Dialogue: 0,0:46:47.63,0:46:51.64,Default,,0,0,0,,Жоқ, жапон архипелагы 100 миллион жыл бұрын әлі қалыптаспаған.
Dialogue: 0,0:46:51.76,0:46:53.89,Default,,0,0,0,,Жапония болашақта қайда болуы керек
Dialogue: 0,0:46:54.01,0:46:57.48,Default,,0,0,0,,Бұл дәл Токиодағы Нобита-кунның үйі.
Dialogue: 0,0:46:57.60,0:47:00.60,Default,,0,0,0,,Нобита-кунның бөлмесіндегі Нобита-кунның үстелі
Dialogue: 0,0:47:00.73,0:47:03.40,Default,,0,0,0,,Егер осы уақыт машинасын қабаттасатын орынға орналастырсақ
Dialogue: 0,0:47:03.52,0:47:05.44,Default,,0,0,0,,Мен үйге бара алуым керек.
Dialogue: 0,0:47:06.15,0:47:08.57,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:47:08.70,0:47:10.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:12.37,0:47:13.62,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:47:16.75,0:47:19.37,Default,,0,0,0,,Дұрыс, Дораемон, таккоптермен ұшайық.
Dialogue: 0,0:47:19.71,0:47:20.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:20.96,0:47:24.67,Default,,0,0,0,,Баспропеллер-дің максималды жылдамдығы 80км/сағ
Dialogue: 0,0:47:24.80,0:47:28.01,Default,,0,0,0,,Оны 8 сағат үздіксіз пайдалансаңыз, батарея заряды таусылады.
Dialogue: 0,0:47:28.13,0:47:30.51,Default,,0,0,0,,Алға жүру қашықтығы 640 км.
Dialogue: 0,0:47:30.63,0:47:32.80,Default,,0,0,0,,Жапонияға дейін неше километр қалды деп ойлайсыңдар?
Dialogue: 0,0:47:33.18,0:47:34.93,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:47:36.10,0:47:38.73,Default,,0,0,0,,...
Dialogue: 0,0:47:39.60,0:47:41.31,Default,,0,0,0,,Міне, осындай жалған машинамен.
Dialogue: 0,0:47:41.44,0:47:44.23,Default,,0,0,0,,Бізді осы жерге әкелдің.
Dialogue: 0,0:47:44.36,0:47:45.77,Default,,0,0,0,,Не туралы айтып тұрсың, Джан?
Dialogue: 0,0:47:45.90,0:47:47.78,Default,,0,0,0,,Мүмкін олар рұқсатсыз кірген шығар?
Dialogue: 0,0:47:47.90,0:47:51.24,Default,,0,0,0,,Сондықтан сыйымдылық асып кеткендіктен осындай жағдайлар орын алды.
Dialogue: 0,0:47:51.36,0:47:52.36,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:47:54.03,0:47:56.29,Default,,0,0,0,,Әй, бәрің тыңдаңдар.
Dialogue: 0,0:47:56.70,0:47:57.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:58.04,0:48:00.12,Default,,0,0,0,,Радио басқару элементтерімен ойнаған кезде
Dialogue: 0,0:48:00.25,0:48:01.71,Default,,0,0,0,,Егер сіз үздіксіз жұмыс жасасаңыз
Dialogue: 0,0:48:01.79,0:48:03.83,Default,,0,0,0,,Батарея тез бітеді.
Dialogue: 0,0:48:03.96,0:48:05.79,Default,,0,0,0,,Дұрыс демалу кезінде қолданғанда
Dialogue: 0,0:48:05.88,0:48:07.88,Default,,0,0,0,,Бұл біраз уақытқа созылады.
Dialogue: 0,0:48:08.01,0:48:09.55,Default,,0,0,0,,Мүмкін ұқсас нәрсе
Dialogue: 0,0:48:09.67,0:48:11.47,Default,,0,0,0,,Баспропеллер үшін де солай деуге болады, солай ма?
Dialogue: 0,0:48:12.38,0:48:16.39,Default,,0,0,0,,Дұрыс, Дораемон, солай ма? Ол ұзаққа созыла ма?
Dialogue: 0,0:48:16.89,0:48:19.81,Default,,0,0,0,,Ия, мен Жапонияға қайтуға болады.
Dialogue: 0,0:48:19.93,0:48:20.85,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:48:21.56,0:48:22.98,Default,,0,0,0,,Мен қайда демалуым керек?
Dialogue: 0,0:48:23.10,0:48:27.32,Default,,0,0,0,,Америка мен Жапонияның арасында кең Тынық мұхиты бар.
Dialogue: 0,0:48:27.44,0:48:28.61,Default,,0,0,0,,Сәлем Сунео
Dialogue: 0,0:48:28.73,0:48:30.78,Default,,0,0,0,,Кездейсоқ идеялар туралы айту
Dialogue: 0,0:48:31.07,0:48:33.24,Default,,0,0,0,,Жоқ, бұл әзіл емес.
Dialogue: 0,0:48:33.53,0:48:34.53,Default,,0,0,0,,Иә? (Сунео) Иә?
Dialogue: 0,0:48:35.32,0:48:37.49,Default,,0,0,0,,Ей, 100 миллион жылдан кейін
Dialogue: 0,0:48:37.58,0:48:39.66,Default,,0,0,0,,Жер бедері айтарлықтай өзгерді.
Dialogue: 0,0:48:39.79,0:48:42.46,Default,,0,0,0,,Сондықтан бұл дәуірде Америка және Азия құрлығы
Dialogue: 0,0:48:42.58,0:48:44.54,Default,,0,0,0,,Ол жер арқылы қосылуы керек еді.
Dialogue: 0,0:48:45.13,0:48:46.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:48:47.50,0:48:51.72,Default,,0,0,0,,Олай болса, үйге қайтуға болады, солай ма? Жапонияға
Dialogue: 0,0:48:51.84,0:48:52.51,Default,,0,0,0,,Иә
Dialogue: 0,0:48:52.63,0:48:56.39,Default,,0,0,0,,Иә! Ия, иә (3 адам) Иә!
Dialogue: 0,0:48:56.60,0:49:01.89,Default,,0,0,0,,Мен қайтуға болады. Мен Жапонияға қайта аламын.
Dialogue: 0,0:49:14.07,0:49:16.78,Default,,0,0,0,,Сәлем Писуке
Dialogue: 0,0:49:17.45,0:49:19.03,Default,,0,0,0,,Пуэй
Dialogue: 0,0:49:30.67,0:49:33.09,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,0:49:35.80,0:49:37.59,Default,,0,0,0,,Кіріңіз, (Писуке) Пуй.
Dialogue: 0,0:49:38.35,0:49:40.06,Default,,0,0,0,,Кеттік
Dialogue: 0,0:50:35.69,0:50:38.45,Default,,0,0,0,,Пуй (Нобита) Тек шыдамды болыңыз.
Dialogue: 0,0:50:38.57,0:50:40.41,Default,,0,0,0,,Мен сені бірден шығарамын, Писуке.
Dialogue: 0,0:50:47.12,0:50:50.33,Default,,0,0,0,,Бүгінгі күн осымен бітті, сол жағажайға қосылайық.
Dialogue: 0,0:50:56.05,0:50:58.68,Default,,0,0,0,,Йойшотто (Сунео) Оттотто
Dialogue: 0,0:50:59.26,0:51:01.01,Default,,0,0,0,,Дораемон, үлкен жарықты шығар
Dialogue: 0,0:51:01.14,0:51:02.01,Default,,0,0,0,,Ай
Dialogue: 0,0:51:04.01,0:51:06.14,Default,,0,0,0,,...
Dialogue: 0,0:51:07.48,0:51:08.60,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:51:10.40,0:51:12.56,Default,,0,0,0,,Уау~
Dialogue: 0,0:51:12.90,0:51:14.27,Default,,0,0,0,,Пуэй
Dialogue: 0,0:51:14.40,0:51:16.53,Default,,0,0,0,,Ертең таңға дейін осында тұрамыз.
Dialogue: 0,0:51:16.65,0:51:18.45,Default,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,0:51:19.78,0:51:21.87,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:51:22.78,0:51:24.49,Default,,0,0,0,,Хмм, аа
Dialogue: 0,0:51:24.62,0:51:27.25,Default,,0,0,0,,Дада, жоқ, мен бос емеспін.
Dialogue: 0,0:51:27.37,0:51:28.79,Default,,0,0,0,,Кәне, ойнайық
Dialogue: 0,0:51:35.50,0:51:37.34,Default,,0,0,0,,Хехе Хмм.
Dialogue: 0,0:51:37.76,0:51:39.80,Default,,0,0,0,,Кемпинг капсуласы
Dialogue: 0,0:51:40.51,0:51:44.55,Default,,0,0,0,,Мм, мм, қайда...
Dialogue: 0,0:51:44.68,0:51:47.64,Default,,0,0,0,,Хмм және а
Dialogue: 0,0:51:50.39,0:51:52.19,Default,,0,0,0,,Уау~
Dialogue: 0,0:51:57.07,0:51:57.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:52:05.28,0:52:06.87,Default,,0,0,0,,Қане, бәріміз, мініңдер, мініңдер
Dialogue: 0,0:52:06.99,0:52:08.16,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:52:25.55,0:52:28.89,Default,,0,0,0,,Біздің ұзақ сапарымыз ақыры басталды
Dialogue: 0,0:52:31.23,0:52:34.06,Default,,0,0,0,,Yahoo! Жақсы, жақсы
Dialogue: 0,0:52:34.19,0:52:35.40,Default,,0,0,0,,Ойчный Ойчный
Dialogue: 0,0:52:35.81,0:52:37.48,Default,,0,0,0,,Ана…
Dialogue: 0,0:53:42.51,0:53:46.01,Default,,0,0,0,,Жақсы, жақсы, ей, мынау.
Dialogue: 0,0:53:50.31,0:53:52.35,Default,,0,0,0,,Уау~
Dialogue: 0,0:53:52.93,0:53:57.23,Default,,0,0,0,,А, мен енді жүре алмаймын. Баспропеллер алыңыз.
Dialogue: 0,0:53:57.40,0:53:58.56,Default,,0,0,0,,Эй
Dialogue: 0,0:54:00.23,0:54:03.36,Default,,0,0,0,,Жоқ. Жапонияға қайтып бара алмасам жақсы ма? мен жаяу барамын.
Dialogue: 0,0:54:03.49,0:54:05.28,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,0:54:10.99,0:54:12.58,Default,,0,0,0,,Жабық
Dialogue: 0,0:54:14.00,0:54:16.83,Default,,0,0,0,,Момотаро мөрі бар тары тұшпара
Dialogue: 0,0:54:29.39,0:54:32.14,Default,,0,0,0,,Жүр, бізді көтеріп, жүгір.
Dialogue: 0,0:54:32.26,0:54:33.68,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:55:37.08,0:55:38.20,Default,,0,0,0,,Уау! (Сунео) Керемет
Dialogue: 0,0:55:38.33,0:55:40.25,Default,,0,0,0,,Бұл нағыз Бронтозавр.
Dialogue: 0,0:55:40.37,0:55:42.00,Default,,0,0,0,,Қазба немесе тұлып емес
Dialogue: 0,0:55:42.13,0:55:44.17,Default,,0,0,0,,Тірі, қозғалатын Бронтозавр.
Dialogue: 0,0:55:44.29,0:55:45.88,Default,,0,0,0,,А, мен қатты әсер алдым!
Dialogue: 0,0:55:46.00,0:55:48.51,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз жегенге жарайсыз ба?
Dialogue: 0,0:55:48.67,0:55:51.05,Default,,0,0,0,,Жарайды, Бронтозавр.
Dialogue: 0,0:55:51.18,0:55:53.80,Default,,0,0,0,,Шөпқоректі, мойынсұнғыш, қимылы баяу.
Dialogue: 0,0:55:53.93,0:55:56.01,Default,,0,0,0,,Сақ болыңыз, тапталып қалмаңыз
Dialogue: 0,0:55:56.14,0:55:58.27,Default,,0,0,0,,Маған жақындасаңыз, қарсы емеспін.
Dialogue: 0,0:56:07.07,0:56:09.32,Default,,0,0,0,,Сунео, тез кел (Сунео) Ахахха
Dialogue: 0,0:56:09.44,0:56:10.53,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:56:10.65,0:56:14.53,Default,,0,0,0,,Йотто, ау, тоттотто...
Dialogue: 0,0:56:23.79,0:56:27.21,Default,,0,0,0,,Тоттотто... Қауіп Қауіп Қауіп Аххх
Dialogue: 0,0:56:27.71,0:56:28.92,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:56:36.01,0:56:38.60,Default,,0,0,0,,Қараңдаршы, бұл слайд.
Dialogue: 0,0:56:38.72,0:56:43.10,Default,,0,0,0,,Ааа
Dialogue: 0,0:56:50.24,0:56:52.65,Default,,0,0,0,,Ах
Dialogue: 0,0:56:52.78,0:56:54.82,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:56:57.12,0:56:58.62,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:56:58.74,0:57:00.70,Default,,0,0,0,,Әй, бәрі, қараңдар, қараңдар.
Dialogue: 0,0:57:00.83,0:57:02.79,Default,,0,0,0,,Не? не?
Dialogue: 0,0:57:04.62,0:57:05.79,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:57:05.92,0:57:07.13,Default,,0,0,0,,Уау~
Dialogue: 0,0:57:07.25,0:57:10.63,Default,,0,0,0,,А, сен жаңа туғанда сондай сүйкімдісің.
Dialogue: 0,0:57:13.72,0:57:15.80,Default,,0,0,0,,Хахахаха хехехе
Dialogue: 0,0:57:18.97,0:57:22.77,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:57:22.98,0:57:27.23,Default,,0,0,0,,(Тиранозаврдың айқайы)
Dialogue: 0,0:57:29.48,0:57:30.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:57:35.61,0:57:40.54,Default,,0,0,0,,(бала динозавр дыбысы)
Dialogue: 0,0:57:40.66,0:57:43.46,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:57:58.80,0:58:00.60,Default,,0,0,0,,(Бронтозаврдың айқайы)
Dialogue: 0,0:58:01.18,0:58:03.22,Default,,0,0,0,,(Тиранозаврдың айқайы)
Dialogue: 0,0:58:06.56,0:58:09.73,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:58:12.11,0:58:13.53,Default,,0,0,0,,(Бронтозавр ыңырсыды)
Dialogue: 0,0:58:24.54,0:58:26.29,Default,,0,0,0,,Әй, қандай сұмдық сәби!
Dialogue: 0,0:58:33.05,0:58:34.46,Default,,0,0,0,,Ах, Шизука-чан, аа!
Dialogue: 0,0:58:34.59,0:58:35.72,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:58:36.84,0:58:38.68,Default,,0,0,0,,(Бронтозавр ыңырсыды)
Dialogue: 0,0:58:42.01,0:58:44.14,Default,,0,0,0,,Жүр, бірге қашайық.
Dialogue: 0,0:58:44.31,0:58:45.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:53.44,0:58:55.90,Default,,0,0,0,,(Бронтозавр ыңырсыды)
Dialogue: 0,0:58:59.57,0:59:03.20,Default,,0,0,0,,(Тиранозаврдың айқайы)
Dialogue: 0,0:59:05.20,0:59:07.37,Default,,0,0,0,,Ой, жоқ, мен таптым.
Dialogue: 0,0:59:08.41,0:59:10.29,Default,,0,0,0,,(Үш қорқынышты дауыс)
Dialogue: 0,0:59:14.67,0:59:16.51,Default,,0,0,0,,Иә
Dialogue: 0,0:59:16.63,0:59:19.22,Default,,0,0,0,,Жоқ, бұл емес, бұл да емес.
Dialogue: 0,0:59:19.72,0:59:21.34,Default,,0,0,0,,Ах, жоқ.
Dialogue: 0,0:59:21.47,0:59:24.35,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:59:24.64,0:59:27.81,Default,,0,0,0,,Ух... Момотароның Кибиданго маркасы бар еді
Dialogue: 0,0:59:29.06,0:59:30.14,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:59:34.48,0:59:36.90,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:59:37.03,0:59:38.90,Default,,0,0,0,,Тиранозавр менің қызметшім.
Dialogue: 0,0:59:38.99,0:59:40.86,Default,,0,0,0,,Бірге ойнаған дұрыс.
Dialogue: 0,0:59:41.49,0:59:43.07,Default,,0,0,0,,Бұл рас па? (Сунео) Шынымен бе?
Dialogue: 0,0:59:43.74,0:59:45.83,Default,,0,0,0,,Эй, эй, жарайды.
Dialogue: 0,0:59:47.62,0:59:49.12,Default,,0,0,0,,О, оны үлгі етіңіз.
Dialogue: 0,0:59:49.25,0:59:51.58,Default,,0,0,0,,Сәлем Дораемон Шизука-чан
Dialogue: 0,0:59:51.79,0:59:53.17,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:59:54.59,0:59:56.46,Default,,0,0,0,,Кету
Dialogue: 0,1:00:24.82,1:00:26.03,Default,,0,0,0,,Ана…
Dialogue: 0,1:00:32.04,1:00:33.79,Default,,0,0,0,,Түрлі оқиғалар болғанымен
Dialogue: 0,1:00:33.92,1:00:37.84,Default,,0,0,0,,Америка бойынша саяхат бірқалыпты жүріп жатыр.
Dialogue: 0,1:00:42.97,1:00:44.64,Default,,0,0,0,,Анашым, мені кешіріңіз.
Dialogue: 0,1:00:44.76,1:00:46.22,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,1:01:06.37,1:01:08.16,Default,,0,0,0,,О? Ах
Dialogue: 0,1:01:08.45,1:01:10.75,Default,,0,0,0,,Ах, Дораемон
Dialogue: 0,1:01:10.87,1:01:12.66,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:01:12.79,1:01:14.08,Default,,0,0,0,,Баспропеллер істен шыққан.
Dialogue: 0,1:01:14.54,1:01:17.17,Default,,0,0,0,,Лайықты жер тапсақ, бүгін ерте түсейік.
Dialogue: 0,1:01:22.05,1:01:23.59,Default,,0,0,0,,(динозавр дыбыстары)
Dialogue: 0,1:01:25.05,1:01:26.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:26.84,1:01:28.55,Default,,0,0,0,,Нобита, уайымдама.
Dialogue: 0,1:01:28.68,1:01:31.52,Default,,0,0,0,,Жалғыз сен кешігіп қалсаң, барлығына ыңғайсыздық туады.
Dialogue: 0,1:01:31.64,1:01:34.39,Default,,0,0,0,,Нобитаның номасы Баспропеллер-ге берілді.
Dialogue: 0,1:01:34.52,1:01:35.98,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,1:01:36.40,1:01:39.90,Default,,0,0,0,,Басқалар қиналғанда олай айтпау керек.
Dialogue: 0,1:01:40.02,1:01:42.40,Default,,0,0,0,,Амансың ба? (Нобита) О, Шизука-чан
Dialogue: 0,1:01:43.82,1:01:46.11,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, сәл ғана көп (Нобита) Иә.
Dialogue: 0,1:01:52.33,1:01:54.29,Default,,0,0,0,,Уау, бұл птеранодон.
Dialogue: 0,1:01:54.41,1:01:57.25,Default,,0,0,0,,Уау, күте тұрыңыз.
Dialogue: 0,1:02:03.01,1:02:04.59,Default,,0,0,0,,(үшін дүрбелең)
Dialogue: 0,1:02:05.72,1:02:06.84,Default,,0,0,0,,(Птеранодон айқайы)
Dialogue: 0,1:02:07.09,1:02:08.39,Default,,0,0,0,,Уау
Dialogue: 0,1:02:12.60,1:02:14.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:33.49,1:02:35.29,Default,,0,0,0,,Тары Данго Тары Данго Тары Данго
Dialogue: 0,1:02:36.62,1:02:37.79,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:02:37.92,1:02:39.83,Default,,0,0,0,,Ахх (Нобита) Ахх
Dialogue: 0,1:02:42.09,1:02:43.46,Default,,0,0,0,,Бұл кетті (Нобита) А...
Dialogue: 0,1:02:45.47,1:02:47.18,Default,,0,0,0,,(үшінның қорқынышты дауыстары)
Dialogue: 0,1:02:51.18,1:02:51.93,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:02:54.35,1:02:58.06,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:03:01.15,1:03:02.02,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:05.74,1:03:07.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:16.45,1:03:17.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:37.27,1:03:39.31,Default,,0,0,0,,Қарттар кімдер?
Dialogue: 0,1:03:39.44,1:03:41.35,Default,,0,0,0,,Неліктен бізге ілесесіз?
Dialogue: 0,1:03:41.48,1:03:44.32,Default,,0,0,0,,Сіз бұл сіздің П-суке-кун екенін білесіз.
Dialogue: 0,1:03:44.44,1:03:45.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:45.61,1:03:47.57,Default,,0,0,0,,Пю? puey
Dialogue: 0,1:03:48.24,1:03:49.03,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,1:03:49.24,1:03:51.20,Default,,0,0,0,,Мен негізінен осы дәуірге назар аударамын.
Dialogue: 0,1:03:51.32,1:03:53.91,Default,,0,0,0,,Сансыз динозаврларды өлтірді
Dialogue: 0,1:03:54.03,1:03:55.54,Default,,0,0,0,,Мен ұстадым
Dialogue: 0,1:03:55.66,1:03:58.66,Default,,0,0,0,,Мен ешқашан Писуке сияқты ұстамды динозаврды көрген емеспін.
Dialogue: 0,1:03:58.79,1:04:00.75,Default,,0,0,0,,Мен оны шынымен алғым келеді.
Dialogue: 0,1:04:01.54,1:04:03.88,Default,,0,0,0,,Иә, динозавр аңшысы.
Dialogue: 0,1:04:04.00,1:04:06.00,Default,,0,0,0,,Не? Сол динозавр аңшысы
Dialogue: 0,1:04:06.13,1:04:09.09,Default,,0,0,0,,Уақыт бойынша саяхатқа арналған Навигация уақыт заңы деп аталатын заң бар.
Dialogue: 0,1:04:09.22,1:04:12.89,Default,,0,0,0,,Бұрынғы тіршілік иелерін таңдаусыз ұстауға тыйым салынады.
Dialogue: 0,1:04:13.01,1:04:15.10,Default,,0,0,0,,Өйткені ол тарихты өзгертеді.
Dialogue: 0,1:04:15.22,1:04:18.81,Default,,0,0,0,,Мысалы, адамзаттың ата-бабалары осы дәуірде бір жерде болған.
Dialogue: 0,1:04:18.93,1:04:21.56,Default,,0,0,0,,Олар сүтқоректілердің бауырымен жорғалаушылар ретінде тіршілік етеді.
Dialogue: 0,1:04:21.69,1:04:23.35,Default,,0,0,0,,Егер сіз оны өлтірсеңіз не болады?
Dialogue: 0,1:04:23.48,1:04:26.86,Default,,0,0,0,,Бұл жер бетінде ешқашан адам тумайды.
Dialogue: 0,1:04:26.98,1:04:29.65,Default,,0,0,0,,Сізге ешкім қалмайды.
Dialogue: 0,1:04:29.78,1:04:32.95,Default,,0,0,0,,Бұл маңызды емес, динозаврлар өте көп.
Dialogue: 0,1:04:33.07,1:04:35.66,Default,,0,0,0,,Мені аздап ұстасаң бәрібір.
Dialogue: 0,1:04:35.78,1:04:37.62,Default,,0,0,0,,Бірақ сіз заңды бұзасыз.
Dialogue: 0,1:04:38.08,1:04:39.87,Default,,0,0,0,,Мұның бәрі ақша табу.
Dialogue: 0,1:04:40.00,1:04:41.46,Default,,0,0,0,,Толтырылған птеранодон
Dialogue: 0,1:04:41.54,1:04:43.29,Default,,0,0,0,,Тиранозавр басы
Dialogue: 0,1:04:43.42,1:04:45.59,Default,,0,0,0,,Бір бай бар екен, оны бөлмесінің сәні болсын деп қалаған.
Dialogue: 0,1:04:46.09,1:04:49.55,Default,,0,0,0,,Міне! Осындай жаман жігітке Писукені беруге бола ма?
Dialogue: 0,1:04:51.38,1:04:54.22,Default,,0,0,0,,Ал, қорытынды жасауға асықпа.
Dialogue: 0,1:04:54.34,1:04:55.85,Default,,0,0,0,,Мен оны тегін деп айтпаймын.
Dialogue: 0,1:04:55.97,1:04:57.93,Default,,0,0,0,,Қомақты ақша төлегеннен кейін
Dialogue: 0,1:04:58.06,1:05:00.98,Default,,0,0,0,,Мен сізді уақытыңызға қайтарамын.
Dialogue: 0,1:05:01.43,1:05:03.44,Default,,0,0,0,,Сіз оны кері жібересіз бе?
Dialogue: 0,1:05:03.64,1:05:06.98,Default,,0,0,0,,Иә, бүгін кешке бәріміз бірге сөйлесейік.
Dialogue: 0,1:05:07.11,1:05:08.65,Default,,0,0,0,,Ал сіз базаға келгіңіз келе ме?
Dialogue: 0,1:05:08.90,1:05:10.78,Default,,0,0,0,,Осы төменгі ағындағы сарқыраманың арғы жағында
Dialogue: 0,1:05:10.90,1:05:12.65,Default,,0,0,0,,Уақыт патрульі сізді таппасын
Dialogue: 0,1:05:12.78,1:05:14.11,Default,,0,0,0,,Ол жер астында салынған.
Dialogue: 0,1:05:14.78,1:05:16.07,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:05:16.70,1:05:18.41,Default,,0,0,0,,Иә, жоқ па?
Dialogue: 0,1:05:18.53,1:05:21.33,Default,,0,0,0,,Ал, ертең таңертең қайтайық. Мен жақсы жауап естігім келеді.
Dialogue: 0,1:05:21.45,1:05:23.87,Default,,0,0,0,,Мен ақкөңіл адаммын
Dialogue: 0,1:05:24.00,1:05:25.04,Default,,0,0,0,,Хехехе
Dialogue: 0,1:06:03.16,1:06:05.83,Default,,0,0,0,,Жоқ, мен Жапонияға қайтқым келеді.
Dialogue: 0,1:06:05.96,1:06:07.63,Default,,0,0,0,,Енді шытырман оқиға жоқ
Dialogue: 0,1:06:08.08,1:06:11.25,Default,,0,0,0,,Бірақ мен Писуке-чанды аяймын.
Dialogue: 0,1:06:15.05,1:06:17.09,Default,,0,0,0,,Бірақ бұл сізді жеп қояды деген сөз емес.
Dialogue: 0,1:06:17.22,1:06:19.35,Default,,0,0,0,,Болашақ дүниеде байға сатылады
Dialogue: 0,1:06:19.47,1:06:21.01,Default,,0,0,0,,Олар бассейнде немесе басқа нәрседе сақталған болуы мүмкін.
Dialogue: 0,1:06:21.56,1:06:24.27,Default,,0,0,0,,Бұл Писукені бақытты етеді деп ойлайсыз ба?
Dialogue: 0,1:06:24.39,1:06:25.85,Default,,0,0,0,,Бұған жол бермеңіз
Dialogue: 0,1:06:25.98,1:06:27.94,Default,,0,0,0,,Осы уақытқа дейін қиналған жоқпыз ба?
Dialogue: 0,1:06:28.52,1:06:30.82,Default,,0,0,0,,Содан кейін бұл адамның ұсынысынан бас тартыңыз.
Dialogue: 0,1:06:30.94,1:06:34.07,Default,,0,0,0,,Сіз Жапонияға қалай оралуды жоспарлап отырсыз?
Dialogue: 0,1:06:34.19,1:06:35.82,Default,,0,0,0,,Бұл...
Dialogue: 0,1:06:43.20,1:06:44.91,Default,,0,0,0,,Хмм.
Dialogue: 0,1:06:54.01,1:06:57.30,Default,,0,0,0,,Пуэй
Dialogue: 0,1:06:57.68,1:06:58.88,Default,,0,0,0,,Әй?
Dialogue: 0,1:06:59.05,1:06:59.76,Default,,0,0,0,,Ах
Dialogue: 0,1:07:06.68,1:07:08.02,Default,,0,0,0,,P-көмек
Dialogue: 0,1:07:18.03,1:07:22.03,Default,,0,0,0,,Пуэй
Dialogue: 0,1:07:23.03,1:07:25.54,Default,,0,0,0,,Өйткені, мен Писуке-чанды жалғыз қалдыра алмаймын.
Dialogue: 0,1:07:25.87,1:07:27.50,Default,,0,0,0,,Не? Иә...
Dialogue: 0,1:07:27.91,1:07:29.92,Default,,0,0,0,,Сунео-кун да солай ойлайды, солай ма?
Dialogue: 0,1:07:30.04,1:07:31.88,Default,,0,0,0,,Хмм... жарайды, егер бәрі солай айтса.
Dialogue: 0,1:07:32.00,1:07:35.09,Default,,0,0,0,,...
Dialogue: 0,1:07:44.85,1:07:48.31,Default,,0,0,0,,Жақсы жұмыс Жақсы жұмыс...
Dialogue: 0,1:08:36.40,1:08:39.28,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:08:45.53,1:08:46.58,Default,,0,0,0,,Эй, бұл сенсің.
Dialogue: 0,1:08:46.70,1:08:49.50,Default,,0,0,0,,Түсіндіңіз бе? Мысалы, адамға айналуы мүмкін динозавр.
Dialogue: 0,1:08:49.62,1:08:52.00,Default,,0,0,0,,Мен алған сияқтымын.
Dialogue: 0,1:08:52.12,1:08:56.21,Default,,0,0,0,,Соңғы әрлеуді өзіңіз жасай аласыз ба деп ойладым.
Dialogue: 0,1:08:56.84,1:09:00.67,Default,,0,0,0,,Қожайынның балалары оны оңай жібере алмайды.
Dialogue: 0,1:09:00.80,1:09:03.26,Default,,0,0,0,,Ертең біраз әбігер болуы керек.
Dialogue: 0,1:09:03.38,1:09:04.97,Default,,0,0,0,,Күйеу, тек адам аулау
Dialogue: 0,1:09:05.09,1:09:07.22,Default,,0,0,0,,Сіз мұны әлі басынан өткерген жоқсыз, солай ма?
Dialogue: 0,1:09:08.22,1:09:09.81,Default,,0,0,0,,Хехехе Жарайды, кеттік.
Dialogue: 0,1:09:09.93,1:09:13.19,Default,,0,0,0,,7-негіз? Бор дәуірінің ортасындағы Солтүстік Америка.
Dialogue: 0,1:09:13.56,1:09:15.94,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,1:10:11.24,1:10:13.91,Default,,0,0,0,,Арбасыз машина, оны қайда жасырдың?
Dialogue: 0,1:10:18.83,1:10:22.71,Default,,0,0,0,,Бұл сіздің ультиматумыңыз: динозаврды ақырын тапсырыңыз.
Dialogue: 0,1:11:01.71,1:11:02.71,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:11:03.21,1:11:04.92,Default,,0,0,0,,Ах (2 бағыныңқы) О...
Dialogue: 0,1:11:05.30,1:11:06.47,Default,,0,0,0,,Бұл да балшық қуыршақ
Dialogue: 0,1:11:08.97,1:11:12.47,Default,,0,0,0,,Ей, бізді осы нәрсеге тарта бер.
Dialogue: 0,1:11:12.60,1:11:14.56,Default,,0,0,0,,Шынайы қайда кетті?
Dialogue: 0,1:11:14.77,1:11:15.77,Default,,0,0,0,,Радиотолқындарды бақылаңыз
Dialogue: 0,1:11:15.89,1:11:18.19,Default,,0,0,0,,Егер бұл радиобасқару құралы болса, ол бір жерде жұмыс істеп тұрған болуы мүмкін.
Dialogue: 0,1:11:18.31,1:11:19.90,Default,,0,0,0,,Иә, мен жеңілдім.
Dialogue: 0,1:11:25.07,1:11:29.03,Default,,0,0,0,,Олар базасы төменгі ағында жасырылған деді, солай ма?
Dialogue: 0,1:11:29.15,1:11:29.99,Default,,0,0,0,,Иә
Dialogue: 0,1:11:39.29,1:11:41.38,Default,,0,0,0,,Біз бос базаға отырдық.
Dialogue: 0,1:11:41.50,1:11:42.67,Default,,0,0,0,,Олардың уақыт машинасы
Dialogue: 0,1:11:42.79,1:11:45.21,Default,,0,0,0,,Үйге құр қол барсам, байқамайсың.
Dialogue: 0,1:11:45.80,1:11:48.22,Default,,0,0,0,,Бірақ олар балшықпен алдап жатыр.
Dialogue: 0,1:11:48.34,1:11:50.30,Default,,0,0,0,,Менің ойымша, бұл ұзаққа созылмайды.
Dialogue: 0,1:11:50.43,1:11:52.64,Default,,0,0,0,,Ах, радиобасқару енді жұмыс істемейді.
Dialogue: 0,1:11:52.97,1:11:53.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:12.78,1:12:14.49,Default,,0,0,0,,Жоғалған зат
Dialogue: 0,1:12:16.16,1:12:17.54,Default,,0,0,0,,А-а-а
Dialogue: 0,1:12:19.08,1:12:21.67,Default,,0,0,0,,(үшін дүрбелең)
Dialogue: 0,1:12:23.75,1:12:24.79,Default,,0,0,0,,Уау
Dialogue: 0,1:12:26.84,1:12:27.80,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,1:12:38.31,1:12:39.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:42.35,1:12:43.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:44.06,1:12:46.23,Default,,0,0,0,,Уау
Dialogue: 0,1:12:46.69,1:12:48.53,Default,,0,0,0,,Шампунь көзіне тигенін айтты ғой, иә?
Dialogue: 0,1:12:48.65,1:12:51.95,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,1:12:52.07,1:12:52.99,Default,,0,0,0,,Пуэй
Dialogue: 0,1:13:02.08,1:13:05.04,Default,,0,0,0,,(Қара адамның күлкісі)
Dialogue: 0,1:14:21.20,1:14:24.25,Default,,0,0,0,,Уақыт машинасын ұрлау туралы не деуге болады? Мен сені енді кешіре алмаймын
Dialogue: 0,1:14:25.08,1:14:29.71,Default,,0,0,0,,Мен бала деп ойлап, тәтті жүзді қойдым, бірақ мен үшін бұл туралы.
Dialogue: 0,1:14:29.84,1:14:32.42,Default,,0,0,0,,Жоқ, жоқ, мұнда алдау бар.
Dialogue: 0,1:14:32.55,1:14:35.17,Default,,0,0,0,,Қалған екеуі осы жолмен келетініне сенімдімін.
Dialogue: 0,1:14:35.30,1:14:39.60,Default,,0,0,0,,Сәлемдеуге дайындалайық па? Хэхехехахаха
Dialogue: 0,1:14:39.72,1:14:42.22,Default,,0,0,0,,Тезірек (бағыныңқы) Иә, түсіндім.
Dialogue: 0,1:14:59.95,1:15:04.75,Default,,0,0,0,,...
Dialogue: 0,1:15:14.30,1:15:16.63,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:15:17.47,1:15:19.43,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,1:15:21.47,1:15:23.10,Default,,0,0,0,,Әй, Писуке!
Dialogue: 0,1:15:23.47,1:15:26.06,Default,,0,0,0,,Дораэмон Дораэмон Дораэмон!
Dialogue: 0,1:15:26.31,1:15:28.23,Default,,0,0,0,,Мм... А, Нобита-кун
Dialogue: 0,1:15:28.35,1:15:30.06,Default,,0,0,0,,Уа, Дораемон!
Dialogue: 0,1:15:30.19,1:15:33.65,Default,,0,0,0,,Писуке, бәрі жақсы деп үміттенемін.
Dialogue: 0,1:15:33.94,1:15:36.03,Default,,0,0,0,,Нобита-кун Мынау Анау
Dialogue: 0,1:15:58.88,1:16:01.68,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:16:19.86,1:16:21.99,Default,,0,0,0,,Писуке, сабырлы бол.
Dialogue: 0,1:16:23.07,1:16:23.87,Default,,0,0,0,,...
Dialogue: 0,1:16:24.62,1:16:25.70,Default,,0,0,0,,Дорэмон, кеттік
Dialogue: 0,1:16:25.83,1:16:27.79,Default,,0,0,0,,Жақын арада барлығын таппасақ қиын болады.
Dialogue: 0,1:16:27.91,1:16:29.33,Default,,0,0,0,,Иә (Нобита) Жүр.
Dialogue: 0,1:16:40.17,1:16:42.80,Default,,0,0,0,,Пуй Пуй Пуй Пуй
Dialogue: 0,1:16:52.44,1:16:53.31,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:18.80,1:17:21.34,Default,,0,0,0,,Біз үшінші қақпаға жақындап қалдық. Сіз оны ұстағыңыз келе ме?
Dialogue: 0,1:17:21.47,1:17:23.43,Default,,0,0,0,,Қажетсіз күш салмаңыз
Dialogue: 0,1:17:23.55,1:17:27.35,Default,,0,0,0,,Күйеуім, қазір қызық шоу көрейік.
Dialogue: 0,1:17:40.98,1:17:43.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:43.61,1:17:45.41,Default,,0,0,0,,Ооо
Dialogue: 0,1:18:13.60,1:18:15.94,Default,,0,0,0,,Жақсы, ә!
Dialogue: 0,1:18:16.56,1:18:19.77,Default,,0,0,0,,А, бұл есік мүлдем ашылмайды.
Dialogue: 0,1:18:21.73,1:18:23.90,Default,,0,0,0,,Құрсау арқылы өту
Dialogue: 0,1:18:30.49,1:18:31.49,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:18:35.50,1:18:38.38,Default,,0,0,0,,Мені жіберіңізші! (Сидзука Сунео жылап жатыр)
Dialogue: 0,1:18:48.59,1:18:50.97,Default,,0,0,0,,Жарайды, мені стадионға шақыр.
Dialogue: 0,1:18:56.31,1:18:57.56,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:05.49,1:19:06.95,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:07.95,1:19:09.82,Default,,0,0,0,,(Үш адам жылайды)
Dialogue: 0,1:19:10.62,1:19:11.28,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:19:15.08,1:19:18.08,Default,,0,0,0,,Хе, күйеу, тезірек келеміз бе?
Dialogue: 0,1:19:18.21,1:19:19.12,Default,,0,0,0,,О
Dialogue: 0,1:19:34.14,1:19:37.06,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:19:37.35,1:19:41.06,Default,,0,0,0,,О, бор дәуірінің ортасында қалыптан тыс электромагниттік сәулелену байқалды.
Dialogue: 0,1:19:41.19,1:19:42.06,Default,,0,0,0,,Адам қолымен жасалған сияқты
Dialogue: 0,1:19:42.15,1:19:43.02,Default,,0,0,0,,Иә
Dialogue: 0,1:19:43.69,1:19:44.90,Default,,0,0,0,,Патрульдік қайықты жіберіңіз
Dialogue: 0,1:19:45.03,1:19:46.99,Default,,0,0,0,,Оларды аңдыған браконьерлік топ болса керек.
Dialogue: 0,1:19:48.20,1:19:50.45,Default,,0,0,0,,№1 уақыт патрульі жіберілді
Dialogue: 0,1:20:00.75,1:20:02.63,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:20:03.17,1:20:04.80,Default,,0,0,0,,Бұл Джианның дауысы.
Dialogue: 0,1:20:05.50,1:20:06.71,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:20:06.84,1:20:08.01,Default,,0,0,0,,Сунеоның да дауысы
Dialogue: 0,1:20:08.13,1:20:09.22,Default,,0,0,0,,Осы жолмен (Нобита) Иә.
Dialogue: 0,1:20:19.60,1:20:20.60,Default,,0,0,0,,Ах
Dialogue: 0,1:20:29.49,1:20:30.61,Default,,0,0,0,,Ах (Нобита) Шизука-чан
Dialogue: 0,1:20:31.24,1:20:33.62,Default,,0,0,0,,Маған көмектес, Дораемон!
Dialogue: 0,1:20:37.41,1:20:39.12,Default,,0,0,0,,Ах
Dialogue: 0,1:20:39.25,1:20:40.91,Default,,0,0,0,,Хахаха... (Нобита) Ой, не?
Dialogue: 0,1:20:41.04,1:20:42.75,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,1:20:45.50,1:20:48.34,Default,,0,0,0,,Менің стадионыма қош келдіңіз
Dialogue: 0,1:20:48.46,1:20:52.97,Default,,0,0,0,,Бұл жер динозаврлардың бір-бірімен күресуін көру үшін салынған.
Dialogue: 0,1:20:53.22,1:20:54.59,Default,,0,0,0,,Әй, тыңда.
Dialogue: 0,1:20:54.68,1:20:56.93,Default,,0,0,0,,Қанқұмар динозаврлар көзге түседі
Dialogue: 0,1:20:57.06,1:21:00.48,Default,,0,0,0,,(динозаврлардың дауысы)
Dialogue: 0,1:21:03.23,1:21:04.48,Default,,0,0,0,,Уау
Dialogue: 0,1:21:05.90,1:21:07.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:10.94,1:21:13.11,Default,,0,0,0,,Динозаврлар сізге 5 минуттан кейін шабуыл жасайды
Dialogue: 0,1:21:13.57,1:21:16.03,Default,,0,0,0,,Менің тоқтағанымды қаласаңыз, дәл қазір маған Писукені беріңіз.
Dialogue: 0,1:21:20.29,1:21:21.45,Default,,0,0,0,,(Үш қорқынышты дауыс)
Dialogue: 0,1:21:21.83,1:21:24.92,Default,,0,0,0,,Уақыт шектеуі 5 минут. Мұқият ойлан.
Dialogue: 0,1:21:38.89,1:21:41.77,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:21:43.27,1:21:46.10,Default,,0,0,0,,(Тиранозаврдың үруі)
Dialogue: 0,1:21:46.44,1:21:48.52,Default,,0,0,0,,(үшінның қорқынышты дауыстары)
Dialogue: 0,1:21:54.07,1:21:55.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:55.49,1:21:56.57,Default,,0,0,0,,...
Dialogue: 0,1:22:21.22,1:22:22.18,Default,,0,0,0,,Ах
Dialogue: 0,1:22:22.31,1:22:26.27,Default,,0,0,0,,Жетеді... бұл жай ғана плезиозавр, енді маңызды емес
Dialogue: 0,1:22:27.02,1:22:31.07,Default,,0,0,0,,Одан гөрі бұл көруге болатын нәрсе, сондықтан оны соңына дейін тамашалайық.
Dialogue: 0,1:22:35.90,1:22:37.41,Default,,0,0,0,,Хирари плащы
Dialogue: 0,1:22:46.33,1:22:47.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:47.83,1:22:48.92,Default,,0,0,0,,Ах
Dialogue: 0,1:23:03.56,1:23:05.18,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:23:05.27,1:23:07.48,Default,,0,0,0,,Сен өткен күні тары тұшпара жедің.
Dialogue: 0,1:23:08.02,1:23:10.56,Default,,0,0,0,,(Тиранозавр айқайы)
Dialogue: 0,1:23:10.90,1:23:12.98,Default,,0,0,0,,Не, керексіз нәрсе?
Dialogue: 0,1:23:13.11,1:23:15.11,Default,,0,0,0,,Ақымақ динозавр
Dialogue: 0,1:23:15.24,1:23:16.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:16.44,1:23:20.45,Default,,0,0,0,,Жарайды, оларды жеңейік!
Dialogue: 0,1:23:22.62,1:23:24.04,Default,,0,0,0,,Қарғыс атсын бұл жер.
Dialogue: 0,1:23:28.83,1:23:31.04,Default,,0,0,0,,Уау
Dialogue: 0,1:23:31.58,1:23:33.04,Default,,0,0,0,,Уау
Dialogue: 0,1:23:34.09,1:23:35.88,Default,,0,0,0,,Уау
Dialogue: 0,1:23:40.72,1:23:42.01,Default,,0,0,0,,Хоикита
Dialogue: 0,1:23:45.14,1:23:47.68,Default,,0,0,0,,(Қара адамдардың үрейлі дауыстары)
Dialogue: 0,1:24:08.08,1:24:09.33,Default,,0,0,0,,Хирари плащы
Dialogue: 0,1:24:10.08,1:24:11.08,Default,,0,0,0,,Иә
Dialogue: 0,1:24:11.29,1:24:12.54,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:12.88,1:24:15.50,Default,,0,0,0,,Хирари Тея~
Dialogue: 0,1:24:17.38,1:24:18.84,Default,,0,0,0,,Хирари~
Dialogue: 0,1:24:36.27,1:24:37.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:39.11,1:24:39.82,Default,,0,0,0,,Не?
Dialogue: 0,1:24:40.15,1:24:41.78,Default,,0,0,0,,Патруль уақыты келді, ойланыңыз.
Dialogue: 0,1:24:42.24,1:24:43.99,Default,,0,0,0,,Аңшы ойнау үшін өте көп.
Dialogue: 0,1:24:44.12,1:24:48.24,Default,,0,0,0,,Енді біз сізді 23 ғасырдағы түрмеге апарамыз.
Dialogue: 0,1:24:48.50,1:24:49.75,Default,,0,0,0,,Ойлан
Dialogue: 0,1:24:50.08,1:24:52.00,Default,,0,0,0,,Нуу… (қатты шу)
Dialogue: 0,1:24:52.21,1:24:53.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:02.72,1:25:03.84,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:08.35,1:25:10.48,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,1:25:11.02,1:25:14.27,Default,,0,0,0,,Уху, бұл жақсы Писуке Ухуфуфу
Dialogue: 0,1:25:41.84,1:25:46.18,Default,,0,0,0,,Писуке екеуміздің жолымызды ажырататын кез келді.
Dialogue: 0,1:25:52.60,1:25:55.52,Default,,0,0,0,,Бұл сіздің туған қалаңыз. Жақсы тұрыңыз.
Dialogue: 0,1:25:56.15,1:25:57.44,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,1:25:57.77,1:25:58.98,Default,,0,0,0,,P-көмек
Dialogue: 0,1:25:59.11,1:26:01.99,Default,,0,0,0,,Қалай ойлайсыңдар, біз неге осы жерге жету үшін көп еңбек еттік?
Dialogue: 0,1:26:02.32,1:26:04.20,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,1:26:04.86,1:26:07.24,Default,,0,0,0,,Тек мені тыңда.
Dialogue: 0,1:26:08.03,1:26:09.37,Default,,0,0,0,,Немесе мен сені жұдырықтаймын.
Dialogue: 0,1:26:09.78,1:26:11.54,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,1:26:14.12,1:26:16.08,Default,,0,0,0,,Пи-суке!
Dialogue: 0,1:26:17.58,1:26:18.84,Default,,0,0,0,,Куу~
Dialogue: 0,1:26:19.00,1:26:21.92,Default,,0,0,0,,Уф Пи-суке Пи-суке!
Dialogue: 0,1:26:25.68,1:26:26.34,Default,,0,0,0,,Пю?
Dialogue: 0,1:26:27.55,1:26:29.35,Default,,0,0,0,,Pew
Dialogue: 0,1:26:33.64,1:26:35.69,Default,,0,0,0,,Пуй Пуй
Dialogue: 0,1:26:35.81,1:26:36.64,Default,,0,0,0,,Пуэй
Dialogue: 0,1:26:42.57,1:26:44.82,Default,,0,0,0,,Капитан, қазір барайық.
Dialogue: 0,1:26:45.07,1:26:46.86,Default,,0,0,0,,Иә, бұл ұят.
Dialogue: 0,1:26:46.99,1:26:48.91,Default,,0,0,0,,Эй, мен үйге бара жатырмын.
Dialogue: 0,1:26:50.33,1:26:52.37,Default,,0,0,0,,Писуке, сау бол.
Dialogue: 0,1:26:53.91,1:26:57.75,Default,,0,0,0,,Мақсат 20 ғасыр Токио-Ноби отбасы Кету!
Dialogue: 0,1:27:05.09,1:27:06.22,Default,,0,0,0,,Пуэй
Dialogue: 0,1:27:14.89,1:27:16.48,Default,,0,0,0,,Қош бол Писуке
Dialogue: 0,1:27:17.39,1:27:19.52,Default,,0,0,0,,Бақытты болыңыз!
Dialogue: 0,1:27:28.66,1:27:31.32,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,1:28:09.49,1:28:10.82,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,1:28:12.82,1:28:14.37,Default,,0,0,0,,Йоккоишотто
Dialogue: 0,1:28:15.70,1:28:18.00,Default,,0,0,0,,Ал, бәрің екінші қабатта не істеп жаттыңдар?
Dialogue: 0,1:28:18.12,1:28:19.08,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,1:28:25.59,1:28:27.26,Default,,0,0,0,,Сонда кездескенше, Нобита-кун.
Dialogue: 0,1:28:27.38,1:28:29.13,Default,,0,0,0,,Иә (Джан Сунео) Сонда кездескенше.
Dialogue: 0,1:28:29.67,1:28:32.09,Default,,0,0,0,,Сунео, үй тапсырмасын көрсет.
Dialogue: 0,1:28:32.22,1:28:34.97,Default,,0,0,0,,Өмір мен өлімді бөліссек те доспыз.
Dialogue: 0,1:28:35.10,1:28:36.76,Default,,0,0,0,,(Джан мен Сунеоның күлкісі)
Dialogue: 0,1:28:36.89,1:28:38.39,Default,,0,0,0,,Хехехе
Dialogue: 0,1:28:57.45,1:28:59.83,Default,,0,0,0,,Қайырлы түн (Нобита) Қайырлы түн
Dialogue: 0,1:29:27.32,1:29:31.78,Default,,0,0,0,,Ай!
Dialogue: 0,1:29:44.62,1:29:46.08,Default,,0,0,0,,P-көмек...
Dialogue: 0,1:30:12.86,1:30:17.87,Default,,0,0,0,,♪〜
Dialogue: 0,1:32:14.02,1:32:19.03,Default,,0,0,0,,〜♪
