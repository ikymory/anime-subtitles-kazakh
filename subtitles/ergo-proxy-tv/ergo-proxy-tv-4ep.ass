Dialogue: 0,0:10:22.00,0:10:26.00,Default,,0,0,0,,Ахахахаха Джо
Dialogue: 0,0:10:26.00,0:10:29.00,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:10:30.00,0:10:35.00,Default,,0,0,0,,Жоқ, мен Гуди Джо Калсонның шебері.
Dialogue: 0,0:10:35.00,0:10:38.00,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:10:38.00,0:10:41.00,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:41.00,0:10:44.00,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:44.00,0:10:47.00,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:47.00,0:10:50.00,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:10:50.00,0:10:53.00,Default,,0,0,0,,Ахахха
Dialogue: 0,0:10:53.00,0:10:57.00,Default,,0,0,0,,Маған неге сонша мейірімділік танытасың?
Dialogue: 0,0:10:57.00,0:11:00.00,Default,,0,0,0,,Сізге де тітіркендіргіш
Dialogue: 0,0:11:00.00,0:11:06.00,Default,,0,0,0,,Біз бір кездері жылы шырайлы, жомарт және жақсы қорғандық.
Dialogue: 0,0:11:06.00,0:11:09.00,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:11:09.00,0:11:14.00,Default,,0,0,0,,Менің ойымша, қала бұрынғыдай әдемі.
Dialogue: 0,0:11:14.00,0:11:18.00,Default,,0,0,0,,Бұл қалада бәрі өтірік.
Dialogue: 0,0:11:18.00,0:11:21.00,Default,,0,0,0,,Өтірік оның өтірік екенін білмейінше, шындық
Dialogue: 0,0:11:21.00,0:11:25.00,Default,,0,0,0,,Шындықты өтіріктен ажырату дұрыс шығар, бірақ
Dialogue: 0,0:11:25.00,0:11:29.00,Default,,0,0,0,,Бұл міндетті түрде бақыт әкелмейді
Dialogue: 0,0:11:29.00,0:11:33.00,Default,,0,0,0,,Өтірік айту бақытты ма? Өтірік айту бақытты ма?
Dialogue: 0,0:11:33.00,0:11:38.00,Default,,0,0,0,,Дұрыс, Бино ақылды бала, жақсы көрсет.
Dialogue: 0,0:11:38.00,0:11:44.00,Default,,0,0,0,,Керемет. Авторава бізге барған сайын жақындай түскендей.
Dialogue: 0,0:11:44.00,0:11:48.00,Default,,0,0,0,,Менің ойымша, бұл түрі қазірде жиі кездеседі.
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,Онда? Сен не туралы айтып тұрсың?
Dialogue: 0,0:11:51.00,0:11:54.00,Default,,0,0,0,,Бұл Roamed туралы.
Dialogue: 0,0:11:54.00,0:11:58.00,Default,,0,0,0,,Роумингте ме? Бұл ностальгиялық естіледі.
Dialogue: 0,0:11:58.00,0:12:02.00,Default,,0,0,0,,Бір минут күтіңіз, бұл иммигранттар ауданы.
Dialogue: 0,0:12:08.00,0:12:11.00,Default,,0,0,0,,Қаншалықты тірі
Dialogue: 0,0:12:11.00,0:12:14.00,Default,,0,0,0,,Қазір не анық?
Dialogue: 0,0:12:14.00,0:12:17.00,Default,,0,0,0,,Олар күмбезден бірге қашып кеткен шығар.
Dialogue: 0,0:12:17.00,0:12:19.00,Default,,0,0,0,,Күмбездің сыртында?
Dialogue: 0,0:12:19.00,0:12:22.00,Default,,0,0,0,,Иә, иә, мен Биноны білемін.
Dialogue: 0,0:12:22.00,0:12:27.00,Default,,0,0,0,,Осы жерден 1246,65 бірлік қашықтықта күмбез бар.
Dialogue: 0,0:12:27.00,0:12:32.00,Default,,0,0,0,,Винс жерге секірген саңылау саңылауының биіктігі қандай?
Dialogue: 0,0:12:32.00,0:12:35.00,Default,,0,0,0,,Бұл шамамен 517 бірлік.
Dialogue: 0,0:12:35.00,0:12:39.00,Default,,0,0,0,,Мен көп нәрсені көргендіктен және барлығынан сұрағандықтан, мен бәрін білемін.
Dialogue: 0,0:12:39.00,0:12:43.00,Default,,0,0,0,,Бұл керемет болар еді, Винс.
Dialogue: 0,0:12:44.00,0:12:47.00,Default,,0,0,0,,Иә? Винс
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Винс
Dialogue: 0,0:13:13.00,0:13:15.00,Default,,0,0,0,,Винс
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,Винс
Dialogue: 0,0:14:13.00,0:14:16.00,Default,,0,0,0,,Қарияның айтқаны осы.
Dialogue: 0,0:14:16.00,0:14:19.00,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия.
Dialogue: 0,0:14:19.00,0:14:24.00,Default,,0,0,0,,Мен сенің қожайын болғанша, Мен әрқашан сенің жаныңда боламын.
Dialogue: 0,0:14:24.00,0:14:27.00,Default,,0,0,0,,Сіз маған сенесіз, солай ма?
Dialogue: 0,0:14:27.00,0:14:29.00,Default,,0,0,0,,Билл
Dialogue: 0,0:14:30.00,0:14:32.00,Default,,0,0,0,,Ешкімге айтпайсыз ба?
Dialogue: 0,0:14:32.00,0:14:35.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:35.00,0:14:39.00,Default,,0,0,0,,Мен Праксидің мәйітін таптым.
Dialogue: 0,0:14:39.00,0:14:42.00,Default,,0,0,0,,Тіпті қауіпсіздік бюросы да әлі білмейді.
Dialogue: 0,0:14:42.00,0:14:48.00,Default,,0,0,0,,Бұл Рауль мен оның достары жасырын түрде, тіпті Барлау бюросынан да іздейтін құбыжық.
Dialogue: 0,0:14:48.00,0:14:50.00,Default,,0,0,0,,Менің өтінішім бар.
Dialogue: 0,0:14:50.00,0:14:54.00,Default,,0,0,0,,Осыны қарап, маған хабарлауыңызды қалаймын.
Dialogue: 0,0:14:54.00,0:14:56.00,Default,,0,0,0,,Оны тіпті қария да жасырып отыр.
Dialogue: 0,0:14:56.00,0:14:59.00,Default,,0,0,0,,Оның не екенін өз көзіммен, аяғыммен білгім келеді.
Dialogue: 0,0:14:59.00,0:15:03.00,Default,,0,0,0,,Жауапты білу сізді міндетті түрде бақытты етпейді
Dialogue: 0,0:15:03.00,0:15:05.00,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:15:05.00,0:15:08.00,Default,,0,0,0,,Өтінемін, Дедалус
Dialogue: 0,0:15:12.00,0:15:16.00,Default,,0,0,0,,Түсіндім, сенің айтқаныңды орындаймын.
Dialogue: 0,0:15:16.00,0:15:19.00,Default,,0,0,0,,Сіз маған орынды айта аласыз ба?
Dialogue: 0,0:15:37.00,0:15:41.00,Default,,0,0,0,,Шынында да, мен сол жақтанмын.
Dialogue: 0,0:15:41.00,0:15:47.00,Default,,0,0,0,,Мені құбыжықтар қуды, дымқыл иттер мені қуды, мен сатқын ретінде қарадым.
Dialogue: 0,0:15:47.00,0:15:50.00,Default,,0,0,0,,Құбыжықтар туралы не деуге болады?
Dialogue: 0,0:15:50.00,0:15:52.00,Default,,0,0,0,,Сіз мұны көрдіңіз бе?
Dialogue: 0,0:15:52.00,0:15:56.00,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:15:56.00,0:15:58.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:16:01.00,0:16:07.00,Default,,0,0,0,,Бұлар баратын жерді жер жаратқан жындар.
Dialogue: 0,0:16:11.00,0:16:16.00,Default,,0,0,0,,Аман-есен туылған амрита жасушалары өлді.
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:20.00,0:16:24.00,Default,,0,0,0,,Мен оны зертханаға апарып, зерттеуім керек.
Dialogue: 0,0:16:24.00,0:16:28.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:16:28.00,0:16:31.00,Default,,0,0,0,,Ұмытқаныңыз жөн
Dialogue: 0,0:16:31.00,0:16:33.00,Default,,0,0,0,,Мұнда көргендердің бәрі
Dialogue: 0,0:16:33.00,0:16:36.00,Default,,0,0,0,,Бұл праксис пе?
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0,0,0,,Ол әлі бір жерде тірі болуы керек.
Dialogue: 0,0:16:38.00,0:16:39.00,Default,,0,0,0,,Сол
Dialogue: 0,0:16:39.00,0:16:43.00,Default,,0,0,0,,Лил, сен Дедалусты білесің.
Dialogue: 0,0:16:43.00,0:16:47.00,Default,,0,0,0,,Кешіріңіз, әрине олай айта алмаймын.
Dialogue: 0,0:16:47.00,0:16:48.00,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:16:48.00,0:16:50.00,Default,,0,0,0,,Дедалус жеткілікті
Dialogue: 0,0:16:50.00,0:16:53.00,Default,,0,0,0,,Менің тағы өлгім келеді
Dialogue: 0,0:16:53.00,0:16:56.00,Default,,0,0,0,,Қайтадан өлгім келеді
Dialogue: 0,0:16:56.00,0:16:59.00,Default,,0,0,0,,Қайтадан өлгім келеді
Dialogue: 0,0:16:59.00,0:17:02.00,Default,,0,0,0,,Қайтадан өлгім келеді
Dialogue: 0,0:17:02.00,0:17:05.00,Default,,0,0,0,,Қайтадан өлгім келеді
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,Дедалус
Dialogue: 0,0:17:06.00,0:17:11.00,Default,,0,0,0,,Сіз біраз қиындыққа тап болған сияқтысыз.
Dialogue: 0,0:17:11.00,0:17:14.00,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:17:14.00,0:17:16.00,Default,,0,0,0,,Маған да уәде беріңізші.
Dialogue: 0,0:17:16.00,0:17:20.00,Default,,0,0,0,,Сіз бұл жерден ештеңе таппадыңыз.
Dialogue: 0,0:17:20.00,0:17:22.00,Default,,0,0,0,,О, керісінше
Dialogue: 0,0:17:22.00,0:17:25.00,Default,,0,0,0,,Мен мұндай жерде ешқашан болған емеспін.
Dialogue: 0,0:17:25.00,0:17:27.00,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:17:27.00,0:17:29.00,Default,,0,0,0,,Олай болса қалғанын саған қалдырамын.
Dialogue: 0,0:17:29.00,0:17:31.00,Default,,0,0,0,,Тергеу нәтижелерін тапсырыңыз.
Dialogue: 0,0:17:31.00,0:17:34.00,Default,,0,0,0,,Мен оны келесі жолы тыңдаймын.
Dialogue: 0,0:17:34.00,0:17:37.00,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:17:37.00,0:17:40.00,Default,,0,0,0,,Мен мұны өзім зерттегенімді айттым.
Dialogue: 0,0:17:40.00,0:17:44.00,Default,,0,0,0,,Тек вирус жұқтырған авторовтар білетін саңылау бар.
Dialogue: 0,0:17:44.00,0:17:47.00,Default,,0,0,0,,Бұдан асып кетіңіз
Dialogue: 0,0:17:47.00,0:17:49.00,Default,,0,0,0,,Лил
Dialogue: 0,0:18:04.00,0:18:07.00,Default,,0,0,0,,Сіз иммигрантсыз, солай ма?
Dialogue: 0,0:18:07.00,0:18:10.00,Default,,0,0,0,,Менің ойымша, Ромдодағы атмосфера оған сәйкес келмеді.
Dialogue: 0,0:18:10.00,0:18:11.00,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:11.00,0:18:13.00,Default,,0,0,0,,Олай болса, қош келдіңіз.
Dialogue: 0,0:18:13.00,0:18:16.00,Default,,0,0,0,,Айтыңызшы, сіз мұнда мәңгі қала аласыз.
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Бұл жерде тегін
Dialogue: 0,0:18:18.00,0:18:22.00,Default,,0,0,0,,Күмбезді тастап, нағыз еркіндікке қол жеткіздік.
Dialogue: 0,0:18:24.00,0:18:25.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:18:25.00,0:18:28.00,Default,,0,0,0,,Күмбезде қажет емес заттарды лақтыруға болады.
Dialogue: 0,0:18:28.00,0:18:31.00,Default,,0,0,0,,Бірақ ол әлі де толығымен пайдалануға жарамды.
Dialogue: 0,0:18:31.00,0:18:33.00,Default,,0,0,0,,Мен мұны да алдым
Dialogue: 0,0:18:46.00,0:18:50.00,Default,,0,0,0,,Мұндағы адамдар әртүрлі себептермен Ромдодан кетіп қалды.
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0,0,0,,Қаладан жер аударылған
Dialogue: 0,0:18:52.00,0:18:56.00,Default,,0,0,0,,Сондықтан көптеген адамдар Ромдаға дұшпандықпен қарайды.
Dialogue: 0,0:18:56.00,0:19:00.00,Default,,0,0,0,,Ешкім үйге барғысы келмейді деп ойлаймын.
Dialogue: 0,0:19:00.00,0:19:01.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:01.00,0:19:03.00,Default,,0,0,0,,Ешқашан қайтып оралуға болмайды дейді
Dialogue: 0,0:19:03.00,0:19:05.00,Default,,0,0,0,,Мұны кім жасайды?
Dialogue: 0,0:19:05.00,0:19:07.00,Default,,0,0,0,,Анадағы әйел
Dialogue: 0,0:19:07.00,0:19:10.00,Default,,0,0,0,,Королеваның жігіті немесе сол әуесқой
Dialogue: 0,0:19:10.00,0:19:12.00,Default,,0,0,0,,Иә, ақсақал осылай деді.
Dialogue: 0,0:19:12.00,0:19:15.00,Default,,0,0,0,,Бұл ең соңғы сәнді зат.
Dialogue: 0,0:19:15.00,0:19:18.00,Default,,0,0,0,,Оны азаматтық деңгейі жоғары адамдар пайдаланса керек.
Dialogue: 0,0:19:18.00,0:19:23.00,Default,,0,0,0,,Олай болса, жоғалған затты алып кетуге біреу келіп қалар, қыз.
Dialogue: 0,0:19:24.00,0:19:26.00,Default,,0,0,0,,Пинс
Dialogue: 0,0:19:27.00,0:19:29.00,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:19:31.00,0:19:33.00,Default,,0,0,0,,Ондай жерге кім қайтады?
Dialogue: 0,0:19:33.00,0:19:34.00,Default,,0,0,0,,На
Dialogue: 0,0:19:34.00,0:19:35.00,Default,,0,0,0,,Ура!
Dialogue: 0,0:19:35.00,0:19:37.00,Default,,0,0,0,,Ура!
Dialogue: 0,0:19:41.00,0:19:43.00,Default,,0,0,0,,Ура!
Dialogue: 0,0:19:43.00,0:19:44.00,Default,,0,0,0,,Ура!
Dialogue: 0,0:19:57.00,0:19:58.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:19:58.00,0:20:00.00,Default,,0,0,0,,Бұдан былай I
Dialogue: 0,0:20:02.00,0:20:04.00,Default,,0,0,0,,Сіз Пиноның серігісіз
Dialogue: 0,0:20:04.00,0:20:05.00,Default,,0,0,0,,На
Dialogue: 0,0:20:08.00,0:20:10.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:20:10.00,0:20:13.00,Default,,0,0,0,,Дәл осылай теңізге түсіп кеткен заттарды жинап жатырмын.
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Бұл өте жасырын асыл тас.
Dialogue: 0,0:20:15.00,0:20:18.00,Default,,0,0,0,,Күмбездің жылу шығару әсерінен шығанақтың іші жылы.
Dialogue: 0,0:20:18.00,0:20:19.00,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:20:19.00,0:20:20.00,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:20:20.00,0:20:22.00,Default,,0,0,0,,Автолавтағы су
Dialogue: 0,0:20:22.00,0:20:24.00,Default,,0,0,0,,Бұл су өткізбейтін.
Dialogue: 0,0:20:24.00,0:20:27.00,Default,,0,0,0,,Оны қоян тарату жүйесінің алмастырғышы ретінде пайдалануға болады.
Dialogue: 0,0:20:27.00,0:20:28.00,Default,,0,0,0,,Қоян?
Dialogue: 0,0:20:28.00,0:20:29.00,Default,,0,0,0,,Иә
Dialogue: 0,0:20:29.00,0:20:31.00,Default,,0,0,0,,Мен мұндай жерде мәңгі қалуым мүмкін еді
Dialogue: 0,0:20:31.00,0:20:33.00,Default,,0,0,0,,Қыңыр болып тұрғандай емес.
Dialogue: 0,0:20:35.00,0:20:37.00,Default,,0,0,0,,Алғаш кездескен кезде мен саған ғашық болдым.
Dialogue: 0,0:20:37.00,0:20:39.00,Default,,0,0,0,,Мені мақтаншақ адам деп ойлайтын сияқтысың.
Dialogue: 0,0:20:39.00,0:20:40.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:40.00,0:20:43.00,Default,,0,0,0,,Сіз оны Кудиден естіген боларсыз.
Dialogue: 0,0:20:43.00,0:20:45.00,Default,,0,0,0,,Мен тақ болып барамын.
Dialogue: 0,0:20:45.00,0:20:46.00,Default,,0,0,0,,Жай
Dialogue: 0,0:20:46.00,0:20:50.00,Default,,0,0,0,,Менің көзқарасым бойынша, бостандық деп шу шығаратындар жақсы.
Dialogue: 0,0:20:50.00,0:20:53.00,Default,,0,0,0,,Менің ойымша, ол өте біртүрлі.
Dialogue: 0,0:20:53.00,0:20:54.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:54.00,0:20:57.00,Default,,0,0,0,,Мен күмбездің бақылауында мәңгілікке қала беремін.
Dialogue: 0,0:20:57.00,0:20:59.00,Default,,0,0,0,,Өйткені менің өмір сүруге ниетім жоқ
Dialogue: 0,0:20:59.00,0:21:01.00,Default,,0,0,0,,Мұқият есте сақтаңыз
Dialogue: 0,0:21:01.00,0:21:02.00,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:21:02.00,0:21:03.00,Default,,0,0,0,,Ал сіз
Dialogue: 0,0:21:03.00,0:21:04.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:04.00,0:21:08.00,Default,,0,0,0,,Мен осындай жерде тіземді ұстап тұрмын
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Бөлек
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Пино-чан әлдеқайда ересек.
Dialogue: 0,0:21:12.00,0:21:14.00,Default,,0,0,0,,Зұлымдар Альянсының көлеңкесі – біздің ең үлкен алаңдаушылығымыз
Dialogue: 0,0:21:14.00,0:21:15.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:15.00,0:21:18.00,Default,,0,0,0,,Ақырында сіз мұнда өмірге үйренесіз.
Dialogue: 0,0:21:18.00,0:21:21.00,Default,,0,0,0,,Баяу қозғалған дұрыс
Dialogue: 0,0:21:21.00,0:21:24.00,Default,,0,0,0,,Егер сіз қалай баяу қозғалатыныңызды ойласаңыз
Dialogue: 0,0:21:24.00,0:21:26.00,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:21:26.00,0:21:27.00,Default,,0,0,0,,Қаш
Dialogue: 0,0:21:27.00,0:21:29.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:21:29.00,0:21:30.00,Default,,0,0,0,,Тұрақты ұшу
Dialogue: 0,0:21:30.00,0:21:32.00,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,Тұрақты жеткізу?
Dialogue: 0,0:21:46.00,0:21:48.00,Default,,0,0,0,,Ромдоның ұшқышсыз ұшағы
Dialogue: 0,0:21:48.00,0:21:52.00,Default,,0,0,0,,Әдепті болыңыз және күн сайын белгіленген уақытта белгіленген курсты сұраңыз.
Dialogue: 0,0:21:52.00,0:21:56.00,Default,,0,0,0,,Бірақ егер сіз оны таба алмасаңыз, сізді іздемейді.
Dialogue: 0,0:21:56.00,0:22:00.00,Default,,0,0,0,,Біз Ромдо үшін осындай адамбыз ба?
Dialogue: 0,0:22:00.00,0:22:01.00,Default,,0,0,0,,Пино
Dialogue: 0,0:22:01.00,0:22:03.00,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,0:22:03.00,0:22:04.00,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:22:04.00,0:22:05.00,Default,,0,0,0,,Авторав
Dialogue: 0,0:22:18.00,0:22:19.00,Default,,0,0,0,,Пино
Dialogue: 0,0:22:19.00,0:22:20.00,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:22:30.00,0:22:31.00,Default,,0,0,0,,Эй
Dialogue: 0,0:22:31.00,0:22:36.00,Default,,0,0,0,,Autorave – тұрақты жеткізу қызметі.
Dialogue: 0,0:22:36.00,0:22:38.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:38.00,0:22:40.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:40.00,0:22:42.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:42.00,0:22:44.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:44.00,0:22:46.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:46.00,0:22:50.00,Default,,0,0,0,,Менің ойымша, тұрақты рейстерде авторейв болмайды.
Dialogue: 0,0:22:50.00,0:22:53.00,Default,,0,0,0,,Мен бұл қиындық тудырмайды деп үміттенемін.
Dialogue: 0,0:23:04.00,0:23:05.00,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:23:05.00,0:23:07.00,Default,,0,0,0,,Винсент Ло
Dialogue: 0,0:23:07.00,0:23:09.00,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:23:09.00,0:23:11.00,Default,,0,0,0,,Біз не үшін тіріміз?
Dialogue: 0,0:23:11.00,0:23:13.00,Default,,0,0,0,,Jet Black-ке есеп бересіз бе?
Dialogue: 0,0:23:13.00,0:23:14.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:14.00,0:23:16.00,Default,,0,0,0,,Қызықпайтын шығар
Dialogue: 0,0:23:16.00,0:23:19.00,Default,,0,0,0,,Оның орнына патрульдік ұшақтарды орналастыруды көбейтіңіз.
Dialogue: 0,0:23:19.00,0:23:21.00,Default,,0,0,0,,Күтуде
Dialogue: 0,0:23:21.00,0:23:23.00,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:23:23.00,0:23:27.00,Default,,0,0,0,,Тиісті бөлімдерге жөнелтуді сұрау
Dialogue: 0,0:23:27.00,0:23:31.00,Default,,0,0,0,,Алайда үлгінің қайда екені әлі анықталған жоқ.
Dialogue: 0,0:23:31.00,0:23:32.00,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:23:32.00,0:23:34.00,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:23:34.00,0:23:37.00,Default,,0,0,0,,Бұл адамның жауабы бар
Dialogue: 0,0:23:37.00,0:23:39.00,Default,,0,0,0,,Қазір мен үшін
Dialogue: 0,0:23:39.00,0:23:40.00,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:23:40.00,0:23:42.00,Default,,0,0,0,,Сирек
Dialogue: 0,0:23:42.00,0:23:43.00,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:23:43.00,0:23:46.00,Default,,0,0,0,,Сөздердің эмоционалды реңктері
Dialogue: 0,0:23:46.00,0:23:47.00,Default,,0,0,0,,болып табылады
Dialogue: 0,0:23:47.00,0:23:50.00,Default,,0,0,0,,Мен тіпті таң қалдым.
Dialogue: 0,0:23:53.00,0:23:56.00,Default,,0,0,0,,Бұл ергежейлі жұқтырған сияқты.
Dialogue: 0,0:23:56.00,0:23:59.00,Default,,0,0,0,,Бұл мен үшін күлкілі әзіл
Dialogue: 0,0:24:13.00,0:24:15.00,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:24:15.00,0:24:17.00,Default,,0,0,0,,Менің өмірімнің бірі
Dialogue: 0,0:24:17.00,0:24:19.00,Default,,0,0,0,,бірінші
