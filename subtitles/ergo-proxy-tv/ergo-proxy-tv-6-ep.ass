Dialogue: 0,0:00:30.00,0:00:34.00,Default,,0,0,0,,байыпты арқан
Dialogue: 0,0:00:34.00,0:00:37.00,Default,,0,0,0,,шын мәнінде арқан
Dialogue: 0,0:00:39.00,0:00:42.00,Default,,0,0,0,,Мацуя ақын
Dialogue: 0,0:00:51.00,0:00:53.00,Default,,0,0,0,,Иә
Dialogue: 0,0:00:53.00,0:00:58.00,Default,,0,0,0,,Ол мұнда.
Dialogue: 0,0:01:04.00,0:01:07.00,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:01:07.00,0:01:08.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:21.00,0:01:23.00,Default,,0,0,0,,Тимаши!
Dialogue: 0,0:01:26.00,0:01:28.00,Default,,0,0,0,,Эмо...
Dialogue: 0,0:01:37.00,0:01:39.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:02:07.00,0:02:09.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:02:37.00,0:02:39.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:03:07.00,0:03:09.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:03:37.00,0:03:39.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:04:07.00,0:04:09.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Ей!
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,Не деген сұмдық жүз
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Мені ренжіткен адам
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:07.00,0:05:09.00,Default,,0,0,0,,Эмоция
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Дейдал!
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Салқын.
Dialogue: 0,0:05:49.00,0:05:53.00,Default,,0,0,0,,Жоғары температура, тері және қан тамырларының тарылуына байланысты
Dialogue: 0,0:05:54.00,0:05:58.00,Default,,0,0,0,,Ана, Ұстаз және Өлім
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:06:01.00,0:06:02.00,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0,0,0,,Жоқ, мен бұл жерден әлі кеткен жоқпын.
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0,0,0,,Бірақ ертең болуы мүмкін
Dialogue: 0,0:06:09.00,0:06:10.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:11.00,0:06:14.00,Default,,0,0,0,,А, ондай денеңмен жазықсыз болмау керек.
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:06:22.00,0:06:24.00,Default,,0,0,0,,Проксидің аты
Dialogue: 0,0:06:24.00,0:06:26.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:06:27.00,0:06:30.00,Default,,0,0,0,,Пракси жұмбағын шешудің жалғыз анықтамасы
Dialogue: 0,0:06:40.00,0:06:42.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,«Ұн» немесе «күн» деп айтқым келмейді.
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Ромдоның соңғы үлгісінен күткендей
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Қымбат тұру
Dialogue: 0,0:06:51.00,0:06:53.00,Default,,0,0,0,,О, бұл дұрыс болды.
Dialogue: 0,0:06:53.00,0:06:55.00,Default,,0,0,0,,Сіз машиналар туралы көп білесіз.
Dialogue: 0,0:06:55.00,0:06:56.00,Default,,0,0,0,,Бұл қалай болды...
Dialogue: 0,0:06:56.00,0:06:57.00,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:06:58.00,0:06:59.00,Default,,0,0,0,,Сен оны ұрладың ба?
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Ол ұрлағанын айтты.
Dialogue: 0,0:07:02.00,0:07:05.00,Default,,0,0,0,,Бұл бастапқыда капюшон емес.
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:07:07.00,0:07:10.00,Default,,0,0,0,,Әлгі биік таулы адамды осылай еліктіресің.
Dialogue: 0,0:07:10.00,0:07:11.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0,0,0,,Королева, Тимоти қайтыс болғаннан бері.
Dialogue: 0,0:07:14.00,0:07:17.00,Default,,0,0,0,,Менің басымда біраз бұранда бар.
Dialogue: 0,0:07:17.00,0:07:19.00,Default,,0,0,0,,Біз де емеспіз.
Dialogue: 0,0:07:23.00,0:07:24.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,Винсент заңы қайда?
Dialogue: 0,0:07:26.00,0:07:27.00,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:07:28.00,0:07:31.00,Default,,0,0,0,,Сіз менің AHT-ті ұрладыңыз.
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Оны қайтарғыңыз келе ме?
Dialogue: 0,0:07:37.00,0:07:40.00,Default,,0,0,0,,Мен ол кісіні Ромдоға қайтарамын.
Dialogue: 0,0:07:41.00,0:07:43.00,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0,0,0,,Сен үйге сол аттракционмен барасың ба?
Dialogue: 0,0:07:46.00,0:07:49.00,Default,,0,0,0,,Сізді Ромдоға қайтарады.
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0,0,0,,Сізді Ромдоға қайтарады.
Dialogue: 0,0:07:51.00,0:07:53.00,Default,,0,0,0,,Сен үйге сол аттракционмен барасың ба?
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0,0,0,,Ер адамды немесе көлікті таңдаңыз.
Dialogue: 0,0:07:57.00,0:07:59.00,Default,,0,0,0,,Уайымдама, ханшайым.
Dialogue: 0,0:08:05.00,0:08:06.00,Default,,0,0,0,,Лил мырза
Dialogue: 0,0:08:09.00,0:08:11.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:08:16.00,0:08:17.00,Default,,0,0,0,,Лил мырза
Dialogue: 0,0:08:17.00,0:08:19.00,Default,,0,0,0,,Капуста ешқандай вакцина жоқ.
Dialogue: 0,0:08:20.00,0:08:23.00,Default,,0,0,0,,Ол баяғыда қайтыс болды.
Dialogue: 0,0:08:24.00,0:08:26.00,Default,,0,0,0,,Осындағы адамдардан жасырып тұрмын.
Dialogue: 0,0:08:26.00,0:08:29.00,Default,,0,0,0,,Бірақ ол менің ауруымды емдейді
Dialogue: 0,0:08:29.00,0:08:31.00,Default,,0,0,0,,Сіз мені емдедім дедіңіз бе?
Dialogue: 0,0:08:31.00,0:08:32.00,Default,,0,0,0,,Бұл түсінбеушілік.
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Сіз өз бетіңізше қалпына келдіңіз.
Dialogue: 0,0:08:34.00,0:08:37.00,Default,,0,0,0,,Дәрі жоқ па?
Dialogue: 0,0:08:37.00,0:08:38.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:39.00,0:08:40.00,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:08:41.00,0:08:42.00,Default,,0,0,0,,Бұл соңғысы.
Dialogue: 0,0:08:43.00,0:08:45.00,Default,,0,0,0,,Біз мұны тегін жасай алмаймыз
Dialogue: 0,0:08:45.00,0:08:46.00,Default,,0,0,0,,Қызы
Dialogue: 0,0:08:47.00,0:08:49.00,Default,,0,0,0,,Қоянды әкелсең
Dialogue: 0,0:08:49.00,0:08:50.00,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Қиын бет жасама
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Егер сізде бұл болса, ауруыңыз жазылады.
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Жанды болған кезде қызық болады
Dialogue: 0,0:08:57.00,0:08:58.00,Default,,0,0,0,,Саяхат
Dialogue: 0,0:09:08.00,0:09:09.00,Default,,0,0,0,,Капус
Dialogue: 0,0:09:09.00,0:09:10.00,Default,,0,0,0,,Пино?
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:12.00,0:09:13.00,Default,,0,0,0,,Бір адамның кінәсі жоқ.
Dialogue: 0,0:09:13.00,0:09:14.00,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:09:16.00,0:09:17.00,Default,,0,0,0,,Пино да ертең
Dialogue: 0,0:09:17.00,0:09:19.00,Default,,0,0,0,,Сіз бұл жерден кетесіз.
Dialogue: 0,0:09:19.00,0:09:20.00,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:09:21.00,0:09:24.00,Default,,0,0,0,,Ромдоға қайта барғың келмей ме?
Dialogue: 0,0:09:24.00,0:09:25.00,Default,,0,0,0,,Бөлек
Dialogue: 0,0:09:25.00,0:09:26.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:27.00,0:09:30.00,Default,,0,0,0,,Өйткені мен Винсті жалғыз қалдыра алмаймын.
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Ах, бірақ Па.
Dialogue: 0,0:09:35.00,0:09:36.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Хмм, ештеңе жоқ.
Dialogue: 0,0:09:38.00,0:09:39.00,Default,,0,0,0,,Сәлем, Капус
Dialogue: 0,0:09:39.00,0:09:40.00,Default,,0,0,0,,А?
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Сіз Тимотиді танымайсыз ба?
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Мен оны іздеп жүрмін
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Еш жерде
Dialogue: 0,0:09:47.00,0:09:48.00,Default,,0,0,0,,Тімоте
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Ол өлді, солай ма?
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:52.00,0:09:55.00,Default,,0,0,0,,Сонымен, басқа Тимоти бар ма екен?
Dialogue: 0,0:09:55.00,0:09:56.00,Default,,0,0,0,,Пино
Dialogue: 0,0:09:58.00,0:10:00.00,Default,,0,0,0,,Егер адам өлсе ше?
Dialogue: 0,0:10:00.00,0:10:03.00,Default,,0,0,0,,Біз енді ешқашан кездеспейміз
Dialogue: 0,0:10:03.00,0:10:04.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:04.00,0:10:05.00,Default,,0,0,0,,Сабарудың арқасында болар.
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:10:07.00,0:10:10.00,Default,,0,0,0,,Мен сенімен көбірек араласқым келді.
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Сен жалғызсың ба, Пино?
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Жалғызсың ба?
Dialogue: 0,0:10:16.00,0:10:17.00,Default,,0,0,0,,О
Dialogue: 0,0:10:17.00,0:10:20.00,Default,,0,0,0,,Пинода қазір не бар
Dialogue: 0,0:10:20.00,0:10:23.00,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:10:27.00,0:10:28.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:28.00,0:10:29.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:29.00,0:10:30.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:30.00,0:10:31.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:31.00,0:10:32.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:32.00,0:10:33.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:33.00,0:10:34.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:34.00,0:10:35.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:35.00,0:10:36.00,Default,,0,0,0,,Пино
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Жалғыздық
Dialogue: 0,0:10:39.00,0:10:43.00,Default,,0,0,0,,Шүкір, қызыңды арбауға да бардың.
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:10:45.00,0:10:48.00,Default,,0,0,0,,Қызымның көлігі әлі осында.
Dialogue: 0,0:10:48.00,0:10:51.00,Default,,0,0,0,,Ол жігітті ашуландырмағаныңыз жөн.
Dialogue: 0,0:10:51.00,0:10:53.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:53.00,0:10:56.00,Default,,0,0,0,,Хиросукеден соншалықты қорқасың ба?
Dialogue: 0,0:10:56.00,0:10:59.00,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:10:59.00,0:11:01.00,Default,,0,0,0,,Түсіндім, патшайым.
Dialogue: 0,0:11:02.00,0:11:03.00,Default,,0,0,0,,О
Dialogue: 0,0:11:03.00,0:11:05.00,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:05.00,0:11:08.00,Default,,0,0,0,,Бұл не, соншама?
Dialogue: 0,0:11:09.00,0:11:11.00,Default,,0,0,0,,Тұқымдар оралды
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Енді ол қалай жауап береді?
Dialogue: 0,0:11:15.00,0:11:18.00,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Мұның бәрі бар
Dialogue: 0,0:11:21.00,0:11:23.00,Default,,0,0,0,,Пинс?
Dialogue: 0,0:11:26.00,0:11:29.00,Default,,0,0,0,,Қызыңызды өзіңізбен бірге алып кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:11:29.00,0:11:32.00,Default,,0,0,0,,Жұқпалы ауруларды бұл жерде де емдеу мүмкін емес.
Dialogue: 0,0:11:32.00,0:11:34.00,Default,,0,0,0,,Бенсент, не?
Dialogue: 0,0:11:34.00,0:11:37.00,Default,,0,0,0,,Мұны сіз жақсы білуіңіз керек.
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:11:40.00,0:11:43.00,Default,,0,0,0,,Егер сіз сол кемеге мінсеңіз, сіз вакцина аласыз.
Dialogue: 0,0:11:43.00,0:11:46.00,Default,,0,0,0,,Патшайым қызды құтқарғанда
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:11:48.00,0:11:51.00,Default,,0,0,0,,Ол Тимотидің өмірін қиған ломдо адамы.
Dialogue: 0,0:11:52.00,0:11:57.00,Default,,0,0,0,,Қоян кетсе, міндетті түрде күмбезден қуылады.
Dialogue: 0,0:11:57.00,0:12:01.00,Default,,0,0,0,,Сол қызды қалқан ретінде пайдалансаң, шабуыл жасай алмайсың.
Dialogue: 0,0:12:01.00,0:12:03.00,Default,,0,0,0,,Бірақ аман қал
Dialogue: 0,0:12:03.00,0:12:06.00,Default,,0,0,0,,Сіз қуудан құтылсаңыз, сіз үлкен егінді тез жинай аласыз.
Dialogue: 0,0:12:06.00,0:12:09.00,Default,,0,0,0,,Королеваның көмектесу сияқты үлкен сөздері
Dialogue: 0,0:12:09.00,0:12:12.00,Default,,0,0,0,,Сену тым ақымақтық
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Бірақ вакцина болса
Dialogue: 0,0:12:16.00,0:12:19.00,Default,,0,0,0,,Вакцина жалған болса ше?
Dialogue: 0,0:12:19.00,0:12:24.00,Default,,0,0,0,,Шынайы болса да, аязды жер
Dialogue: 0,0:12:24.00,0:12:27.00,Default,,0,0,0,,Әлсіреген денемен
Dialogue: 0,0:12:27.00,0:12:30.00,Default,,0,0,0,,Сол себепті ол қазіргі күйінде қалады.
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,О, ұзақ емес.
Dialogue: 0,0:12:33.00,0:12:35.00,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:12:35.00,0:12:38.00,Default,,0,0,0,,Оны Ромдоға қайтарыңыз.
Dialogue: 0,0:12:38.00,0:12:41.00,Default,,0,0,0,,Ромдоға оралу
Dialogue: 0,0:12:41.00,0:12:43.00,Default,,0,0,0,,Менің өлгенімді қаламасаң
Dialogue: 0,0:12:43.00,0:12:45.00,Default,,0,0,0,,Ромдоға қайтарудан басқа амалым жоқ.
Dialogue: 0,0:12:45.00,0:12:48.00,Default,,0,0,0,,Мен күмбезде не істегеніңді білмеймін.
Dialogue: 0,0:12:48.00,0:12:51.00,Default,,0,0,0,,Бірақ ол қыз сені алуға келді.
Dialogue: 0,0:12:51.00,0:12:54.00,Default,,0,0,0,,Сіз үйге бара алатын ерекше адамсыз.
Dialogue: 0,0:12:54.00,0:12:56.00,Default,,0,0,0,,Ромдо тұрғындары Домдоға барады.
Dialogue: 0,0:12:56.00,0:12:59.00,Default,,0,0,0,,Бұл үнемді.
Dialogue: 0,0:12:59.00,0:13:01.00,Default,,0,0,0,,Қарсы болсаң, шірисің
Dialogue: 0,0:13:03.00,0:13:06.00,Default,,0,0,0,,Ромдоға оралу
Dialogue: 0,0:13:10.00,0:13:13.00,Default,,0,0,0,,Ханшайым, кел
Dialogue: 0,0:13:13.00,0:13:15.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:13:17.00,0:13:20.00,Default,,0,0,0,,Сіз Ромдоға оралуды жоспарлап отырсыз ба?
Dialogue: 0,0:13:21.00,0:13:24.00,Default,,0,0,0,,Сіз Ромдоға оралуды жоспарлап отырсыз ба?
Dialogue: 0,0:13:32.00,0:13:34.00,Default,,0,0,0,,Ууух!
Dialogue: 0,0:13:35.00,0:13:37.00,Default,,0,0,0,,Сау болыңыз.
Dialogue: 0,0:13:37.00,0:13:39.00,Default,,0,0,0,,Сіз де
Dialogue: 0,0:13:45.00,0:13:48.00,Default,,0,0,0,,Ромдоға оралыңыз, Лил.
Dialogue: 0,0:13:51.00,0:13:54.00,Default,,0,0,0,,Сіз Ромдоға оралуды жоспарлап отырсыз ба?
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Қорқыт
Dialogue: 0,0:14:10.00,0:14:12.00,Default,,0,0,0,,Кету уақыты келді.
Dialogue: 0,0:14:21.00,0:14:23.00,Default,,0,0,0,,Қош бол
Dialogue: 0,0:14:51.00,0:14:53.00,Default,,0,0,0,,Мені күте тұрыңыз
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Күмбез сыртына рұқсатсыз шыққан адамдар
Dialogue: 0,0:14:55.00,0:14:57.00,Default,,0,0,0,,Қайтуға рұқсат етілмейді
Dialogue: 0,0:14:57.00,0:14:59.00,Default,,0,0,0,,Күмбезден де солай
Dialogue: 0,0:14:59.00,0:15:01.00,Default,,0,0,0,,Ауытқығандар жазаланады.
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0,0,0,,Әрине мүмкін емес
Dialogue: 0,0:15:03.00,0:15:06.00,Default,,0,0,0,,Бұл, әрине, жалпылау.
Dialogue: 0,0:15:06.00,0:15:09.00,Default,,0,0,0,,Жоқ, сондықтан
Dialogue: 0,0:15:09.00,0:15:11.00,Default,,0,0,0,,Тиянақты болуы керек
Dialogue: 0,0:15:11.00,0:15:13.00,Default,,0,0,0,,Дұрыс, Кристима.
Dialogue: 0,0:15:13.00,0:15:15.00,Default,,0,0,0,,Толқындар жоқ
Dialogue: 0,0:15:17.00,0:15:18.00,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:18.00,0:15:21.00,Default,,0,0,0,,Жоқ, менің ұшағым жақсы.
Dialogue: 0,0:15:21.00,0:15:23.00,Default,,0,0,0,,Ол суға батпайды.
Dialogue: 0,0:15:23.00,0:15:26.00,Default,,0,0,0,,Інжу болса, мен жақсы адамды таңдар едім.
Dialogue: 0,0:15:26.00,0:15:27.00,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:15:27.00,0:15:30.00,Default,,0,0,0,,Мен сен туралы айтып отырмын, ақымақ.
Dialogue: 0,0:15:30.00,0:15:33.00,Default,,0,0,0,,Қалай болғанда да, үзілген сызықтарды қайта қосыңыз
Dialogue: 0,0:15:33.00,0:15:35.00,Default,,0,0,0,,Алғашқы көмек жақсы.
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Бірақ, патшайым.
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Ханшайым, сен не істеп жатырсың?
Dialogue: 0,0:15:39.00,0:15:42.00,Default,,0,0,0,,Ханшайым, қорқынышты нәрселер көп бола ма?
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:15:46.00,0:15:48.00,Default,,0,0,0,,Патшайым, әке сияқты
Dialogue: 0,0:15:48.00,0:15:51.00,Default,,0,0,0,,Әй, анам қателесіпті.
Dialogue: 0,0:15:51.00,0:15:53.00,Default,,0,0,0,,Күлмеймін.
Dialogue: 0,0:15:53.00,0:15:55.00,Default,,0,0,0,,Эххе
Dialogue: 0,0:15:55.00,0:15:58.00,Default,,0,0,0,,Патшайым, бұл сен туралы.
Dialogue: 0,0:15:58.00,0:16:00.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:00.00,0:16:02.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:06.00,0:16:09.00,Default,,0,0,0,,Патшайым, бұл сен туралы.
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:11.00,0:16:13.00,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:16:13.00,0:16:15.00,Default,,0,0,0,,Патшайым, Лука
Dialogue: 0,0:16:15.00,0:16:33.00,Default,,0,0,0,,Королева, Р.
Dialogue: 0,0:16:33.00,0:16:45.00,Default,,0,0,0,,Сәби лейтенант
Dialogue: 0,0:16:45.00,0:16:52.00,Default,,0,0,0,,Кәсіби күрес
Dialogue: 0,0:16:52.00,0:16:57.00,Default,,0,0,0,,Ол мені қайтарды. Қарап шығуға тұрарлық.
Dialogue: 0,0:16:57.00,0:16:59.00,Default,,0,0,0,,Жолаушы бар екенін хабарлаңыз.
Dialogue: 0,0:16:59.00,0:17:03.00,Default,,0,0,0,,Мен оның Винсент екенін білмедім.
Dialogue: 0,0:17:03.00,0:17:06.00,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:17:06.00,0:17:11.00,Default,,0,0,0,,Бірақ мен сізге қажетсіз карталарды көрсетуге итермелей алмаймын.
Dialogue: 0,0:17:16.00,0:17:18.00,Default,,0,0,0,,Қозғалыс, қаһарлы сүйек
Dialogue: 0,0:17:22.00,0:17:25.00,Default,,0,0,0,,Юно, жасырын.
Dialogue: 0,0:17:53.00,0:17:55.00,Default,,0,0,0,,Қазір
Dialogue: 0,0:17:55.00,0:17:57.00,Default,,0,0,0,,Жақсы жер
Dialogue: 0,0:17:57.00,0:18:00.00,Default,,0,0,0,,Сіз үшінші штепсельдік саңылауды босату туралы сұрауды естуіңіз керек еді.
Dialogue: 0,0:18:00.00,0:18:03.00,Default,,0,0,0,,Сырттағы машина алтынға толы.
Dialogue: 0,0:18:03.00,0:18:07.00,Default,,0,0,0,,Оның үстіне жұқтырған адамды кездестірсеңіз, оны оңай жібере алмайсыз.
Dialogue: 0,0:18:07.00,0:18:12.00,Default,,0,0,0,,Мен сізге Юноны беруге дайынмын, қауіпсіздік бюросының директоры.
Dialogue: 0,0:18:12.00,0:18:17.00,Default,,0,0,0,,Мұнда барлық дайындықтар жасалды. Шығару рұқсаты.
Dialogue: 0,0:18:17.00,0:18:19.00,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:18:19.00,0:18:23.00,Default,,0,0,0,,Юно жолаушылармен де айналысады.
Dialogue: 0,0:18:23.00,0:18:25.00,Default,,0,0,0,,Жолаушы?
Dialogue: 0,0:18:25.00,0:18:28.00,Default,,0,0,0,,Джажаума жалғыз емес пе?
Dialogue: 0,0:18:29.00,0:18:31.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:18:33.00,0:18:38.00,Default,,0,0,0,,Үш қуғыншыны қалдырыңыз және олардың барлығын үшінші тығынға жіберіңіз.
Dialogue: 0,0:18:38.00,0:18:40.00,Default,,0,0,0,,Мен де бара жатырмын
Dialogue: 0,0:18:40.00,0:18:41.00,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:18:42.00,0:18:46.00,Default,,0,0,0,,Ол сол жерде. Бұл басу емес.
Dialogue: 0,0:18:50.00,0:18:53.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:53.00,0:18:55.00,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,0:18:55.00,0:18:58.00,Default,,0,0,0,,Қалай болғанда да, бұл сіздің мүмкіндігіңіз. Тезірек жөндеңіз.
Dialogue: 0,0:18:58.00,0:19:00.00,Default,,0,0,0,,Бұл біртүрлі оқиға.
Dialogue: 0,0:19:00.00,0:19:03.00,Default,,0,0,0,,Мен жолаушының атын да сұрамадым.
Dialogue: 0,0:19:03.00,0:19:05.00,Default,,0,0,0,,Неліктен ол ол деп ойлайсың?
Dialogue: 0,0:19:05.00,0:19:07.00,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:19:07.00,0:19:09.00,Default,,0,0,0,,Бірақ мүмкіндігі жоғары
Dialogue: 0,0:19:09.00,0:19:11.00,Default,,0,0,0,,Винсент заңы
Dialogue: 0,0:19:11.00,0:19:14.00,Default,,0,0,0,,Айналадағылардың жойылуына байланысты сатқындық
Dialogue: 0,0:19:14.00,0:19:17.00,Default,,0,0,0,,Отанға опасыздық? Мен иммигрантпын.
Dialogue: 0,0:19:17.00,0:19:19.00,Default,,0,0,0,,Мазасыз адам болса да
Dialogue: 0,0:19:19.00,0:19:22.00,Default,,0,0,0,,Менің ойымша, бұл Қауіпсіздік бюросы бар күшін салуы керек нәрсе емес.
Dialogue: 0,0:19:22.00,0:19:25.00,Default,,0,0,0,,Өйткені ол сондай қызықсыз адам
Dialogue: 0,0:19:25.00,0:19:28.00,Default,,0,0,0,,Мен сенің маған қолыңды қойғаныңды қаламаймын деп жатырмын.
Dialogue: 0,0:19:30.00,0:19:33.00,Default,,0,0,0,,Кешіріңіз, менің жеке бөлмем бар.
Dialogue: 0,0:19:33.00,0:19:36.00,Default,,0,0,0,,Лилмаре люктің екінші жағында.
Dialogue: 0,0:19:36.00,0:19:38.00,Default,,0,0,0,,Бас Редалус
Dialogue: 0,0:19:38.00,0:19:41.00,Default,,0,0,0,,Адамдардың ұмытқанын қаламаймын.
Dialogue: 0,0:19:44.00,0:19:46.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:05.00,0:20:07.00,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:20:07.00,0:20:09.00,Default,,0,0,0,,Жолаушы Винсент Ло
Dialogue: 0,0:20:09.00,0:20:11.00,Default,,0,0,0,,Растаусыз дереу орындауды білдіреді.
Dialogue: 0,0:20:11.00,0:20:13.00,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Лил қазір менің басты басымдығым.
Dialogue: 0,0:20:15.00,0:20:17.00,Default,,0,0,0,,Егер сіз Лилді ренжітсеңіз
Dialogue: 0,0:20:17.00,0:20:19.00,Default,,0,0,0,,Тек ол тегін ашылмайды деп айтыңыз.
Dialogue: 0,0:20:21.00,0:20:23.00,Default,,0,0,0,,Желдеткіш саңылау ашылды
Dialogue: 0,0:20:23.00,0:20:25.00,Default,,0,0,0,,Сол бір қадам біз үшін үлкен ілгерілеу болар еді.
Dialogue: 0,0:20:25.00,0:20:27.00,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:20:28.00,0:20:30.00,Default,,0,0,0,,Люктің ашылуы
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,Бетіңізді көрсетіңіз
Dialogue: 0,0:20:46.00,0:20:48.00,Default,,0,0,0,,Винсент
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Мен жасадым, қозғалдым.
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:21:12.00,0:21:14.00,Default,,0,0,0,,Жылжыту
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Жарайсың бала монах
Dialogue: 0,0:21:42.00,0:21:44.00,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:21:45.00,0:21:47.00,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:22:08.00,0:22:10.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:22:10.00,0:22:12.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:22:32.00,0:22:34.00,Default,,0,0,0,,Сызық бір арқылы өтті
Dialogue: 0,0:22:34.00,0:22:36.00,Default,,0,0,0,,Патрульдік ұшақта
Dialogue: 0,0:22:36.00,0:22:38.00,Default,,0,0,0,,Бұдан әрі қудалау мүмкін емес
Dialogue: 0,0:22:38.00,0:22:40.00,Default,,0,0,0,,Коммуна
Dialogue: 0,0:22:40.00,0:22:42.00,Default,,0,0,0,,Оны өртеп жіберіңіз
Dialogue: 0,0:22:44.00,0:22:46.00,Default,,0,0,0,,Патшайым мырза
Dialogue: 0,0:22:46.00,0:22:48.00,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:22:48.00,0:22:50.00,Default,,0,0,0,,Шақырылмаған қонақ.
Dialogue: 0,0:22:50.00,0:22:52.00,Default,,0,0,0,,Арнайы
Dialogue: 0,0:22:52.00,0:22:54.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:54.00,0:22:56.00,Default,,0,0,0,,Сусын
Dialogue: 0,0:22:56.00,0:22:58.00,Default,,0,0,0,,Енді коммунаға оралуға болады.
Dialogue: 0,0:22:58.00,0:23:00.00,Default,,0,0,0,,Қайтарыңыз және емдеңіз
Dialogue: 0,0:23:00.00,0:23:02.00,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:23:02.00,0:23:04.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
