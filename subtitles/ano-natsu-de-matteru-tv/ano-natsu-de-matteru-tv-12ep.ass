Dialogue: 0,0:01:28.00,0:01:37.95,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:01:28.00,0:01:37.95,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:24.03,0:00:24.82,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:00:25.17,0:00:25.79,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:00:28.68,0:00:29.42,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:00:29.69,0:00:29.99,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:00:33.05,0:00:33.77,Default,,0000,0000,0000,,Киришима-кун
Dialogue: 0,0:00:34.77,0:00:36.43,Default,,0000,0000,0000,,Мұны маған қалдырыңыз
Dialogue: 0,0:00:36.63,0:00:37.19,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:00:37.52,0:00:39.56,Default,,0000,0000,0000,,Үлкендеріңізді тыңдаңыз
Dialogue: 0,0:00:40.68,0:00:41.43,Default,,0000,0000,0000,,Егер ол осылай көрінсе де
Dialogue: 0,0:00:42.32,0:00:44.04,Default,,0000,0000,0000,,Сіз қашып кететініңізге сенімдісіз бе?
Dialogue: 0,0:00:45.65,0:00:46.42,Default,,0000,0000,0000,,Лимон
Dialogue: 0,0:00:49.41,0:00:49.95,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:00:52.26,0:00:52.98,Default,,0000,0000,0000,,♪ Ка-та-на
Dialogue: 0,0:00:55.52,0:00:57.29,Default,,0000,0000,0000,,Мен бірінші кездестірген бөтен планеталық болды
Dialogue: 0,0:00:58.63,0:01:00.12,Default,,0000,0000,0000,,Ол өте жақсы қыз.
Dialogue: 0,0:01:00.81,0:01:02.28,Default,,0000,0000,0000,,Ол менің ең жақын досым
Dialogue: 0,0:01:03.03,0:01:05.51,Default,,0000,0000,0000,,Егер сіз сол баланың жолына түссеңіз.
Dialogue: 0,0:01:09.84,0:01:12.10,Default,,0000,0000,0000,,Мен ғажайып нәрсе істеймін
Dialogue: 0,0:01:17.61,0:01:18.46,Default,,0000,0000,0000,,Лимон
Dialogue: 0,0:01:20.45,0:01:21.37,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:01:24.05,0:01:24.82,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:01:48.36,0:01:49.83,Default,,0000,0000,0000,,Бұл енді мүмкін емес
Dialogue: 0,0:01:49.97,0:01:51.04,Default,,0000,0000,0000,,Жүгірмеңіз
Dialogue: 0,0:01:51.32,0:01:52.04,Default,,0000,0000,0000,,Канна-чан
Dialogue: 0,0:01:53.13,0:01:53.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:54.37,0:01:56.24,Default,,0000,0000,0000,,Манами-сан, неге?
Dialogue: 0,0:01:56.49,0:02:00.34,Default,,0000,0000,0000,,Күйеуім кенет осында келуімді өтінді.
Dialogue: 0,0:02:02.04,0:02:02.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:02.92,0:02:05.68,Default,,0000,0000,0000,,Көліктен түсіңіз. Мені аңдып жүр.
Dialogue: 0,0:02:05.91,0:02:06.97,Default,,0000,0000,0000,,Сталкер?
Dialogue: 0,0:02:07.05,0:02:08.91,Default,,0000,0000,0000,,Бұл мен ғана
Dialogue: 0,0:02:13.88,0:02:17.34,Default,,0000,0000,0000,,Сталкер тым үлкен
Dialogue: 0,0:02:20.57,0:02:21.27,Default,,0000,0000,0000,,Қуғыншы
Dialogue: 0,0:02:22.86,0:02:23.93,Default,,0000,0000,0000,,Мен сізге еріп келемін
Dialogue: 0,0:02:24.00,0:02:24.72,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:02:25.22,0:02:26.63,Default,,0000,0000,0000,,Барлығы жақсы ма?
Dialogue: 0,0:02:26.83,0:02:29.62,Default,,0000,0000,0000,,Не? Сенің үйренетін кезің емес пе?
Dialogue: 0,0:02:30.34,0:02:32.10,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:02:33.39,0:02:35.51,Default,,0000,0000,0000,,Сенпай, жақсысың ба?
Dialogue: 0,0:02:37.77,0:02:39.24,Default,,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,0:02:40.56,0:02:43.37,Default,,0000,0000,0000,,Сіз бұл таудан өткенде, сіз жақын арада станцияда болуыңыз керек.
Dialogue: 0,0:02:43.83,0:02:44.43,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:02:46.15,0:02:47.86,Default,,0000,0000,0000,,Тағы да осындай нәрсе
Dialogue: 0,0:02:47.93,0:02:48.95,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:02:52.96,0:02:53.85,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:02:58.82,0:03:00.50,Default,,0000,0000,0000,,Ринна емес
Dialogue: 0,0:03:01.78,0:03:02.85,Default,,0000,0000,0000,,Ой, аралы тен
Dialogue: 0,0:03:03.15,0:03:03.97,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:03:04.71,0:03:06.35,Default,,0000,0000,0000,,Өйткені антиөріс бар
Dialogue: 0,0:03:06.72,0:03:08.32,Default,,0000,0000,0000,,Менің қолымнан келетіні осы
Dialogue: 0,0:03:10.45,0:03:11.99,Default,,0000,0000,0000,,Бар, Ичика.
Dialogue: 0,0:03:12.76,0:03:15.47,Default,,0000,0000,0000,,Ең болмаса өкінбеңіз
Dialogue: 0,0:03:15.95,0:03:17.01,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:03:17.31,0:03:19.13,Default,,0000,0000,0000,,Әлі де сол жігіт
Dialogue: 0,0:03:22.36,0:03:23.00,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:03:25.22,0:03:26.04,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:03:29.04,0:03:30.21,Default,,0000,0000,0000,,Кеттік, Кайто-кун.
Dialogue: 0,0:03:31.01,0:03:31.90,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:40.30,0:03:41.15,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:03:49.20,0:03:51.54,Default,,0000,0000,0000,,Енді межелі жерге жете аласыз
Dialogue: 0,0:03:55.18,0:03:56.18,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,0:03:56.94,0:03:59.59,Default,,0000,0000,0000,,Менің өзімшілдігім үшін
Dialogue: 0,0:04:00.38,0:04:01.13,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:04:01.73,0:04:03.69,Default,,0000,0000,0000,,Исигаки мырза Китахара мырза
Dialogue: 0,0:04:07.92,0:04:10.05,Default,,0000,0000,0000,,Лимон Ринонмо
Dialogue: 0,0:04:11.32,0:04:13.88,Default,,0000,0000,0000,,Барлығын кешіріңіз
Dialogue: 0,0:04:14.61,0:04:15.84,Default,,0000,0000,0000,,Кешірім сұрасаң жақсы емес.
Dialogue: 0,0:04:17.01,0:04:20.22,Default,,0000,0000,0000,,Әркім өзінің аға тілегін орындағысы келеді.
Dialogue: 0,0:04:20.36,0:04:21.19,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:04:21.31,0:04:22.11,Default,,0000,0000,0000,,Барлығы үшін
Dialogue: 0,0:04:22.64,0:04:25.96,Default,,0000,0000,0000,,Сол жерге барып, жат планеталықтардың іздерін табыңыз.
Dialogue: 0,0:04:26.46,0:04:29.32,Default,,0000,0000,0000,,Осылайша сіздің аға буыныңыз ғарышқа ұшуға мәжбүр болмайды.
Dialogue: 0,0:04:30.56,0:04:31.90,Default,,0000,0000,0000,,Біз бәріміз бірге бола аламыз
Dialogue: 0,0:04:33.19,0:04:35.90,Default,,0000,0000,0000,,Жарайды, бәрі жақсы болады.
Dialogue: 0,0:04:36.37,0:04:37.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:43.28,0:04:45.57,Default,,0000,0000,0000,,Егер бәрі жақсы болса
Dialogue: 0,0:04:46.66,0:04:50.27,Default,,0000,0000,0000,,Мен бір күні ағамның планетасына бара аламын ба?
Dialogue: 0,0:04:50.66,0:04:52.04,Default,,0000,0000,0000,,Сізді қызықтырады ма?
Dialogue: 0,0:04:52.35,0:04:53.50,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:04:54.00,0:04:56.03,Default,,0000,0000,0000,,Сенің ағаң қайда тұрды?
Dialogue: 0,0:04:56.73,0:04:58.29,Default,,0000,0000,0000,,Сіздің отбасыңыз қандай адамдар?
Dialogue: 0,0:04:59.01,0:05:00.46,Default,,0000,0000,0000,,Білгім келеді, танысқым келеді
Dialogue: 0,0:05:02.15,0:05:04.43,Default,,0000,0000,0000,,Мен де сізді таныстырғым келеді.
Dialogue: 0,0:05:05.03,0:05:07.14,Default,,0000,0000,0000,,Сіз мені қалай таныстырасыз?
Dialogue: 0,0:05:09.27,0:05:09.85,Default,,0000,0000,0000,,Иә…♡
Dialogue: 0,0:05:10.87,0:05:13.73,Default,,0000,0000,0000,,Мен де ата-анаммен ағамды таныстырғым келді.
Dialogue: 0,0:05:15.49,0:05:17.53,Default,,0000,0000,0000,,Мен қазір ата-анаммен жақсымын.
Dialogue: 0,0:05:17.78,0:05:18.59,Default,,0000,0000,0000,,Менің де үлкен әпкем бар.
Dialogue: 0,0:05:19.82,0:05:24.34,Default,,0000,0000,0000,,Бірақ мен көбірек естеліктер жасағанымды қалаймын.
Dialogue: 0,0:05:24.52,0:05:25.76,Default,,0000,0000,0000,,Кейде ойлаймын
Dialogue: 0,0:05:27.15,0:05:29.01,Default,,0000,0000,0000,,Бірақ сол себепті бұл
Dialogue: 0,0:05:29.21,0:05:31.87,Default,,0000,0000,0000,,Артымда көп нәрсе қалдырдым.
Dialogue: 0,0:05:32.49,0:05:34.51,Default,,0000,0000,0000,,Тіпті ұсақ, ұсақ-түйек заттар
Dialogue: 0,0:05:34.83,0:05:36.37,Default,,0000,0000,0000,,Кейін өкінбе
Dialogue: 0,0:05:37.81,0:05:40.89,Default,,0000,0000,0000,,Кайто-кунның естеліктері осында жинақталған.
Dialogue: 0,0:05:41.58,0:05:44.03,Default,,0000,0000,0000,,Иә Тецуро Танигава
Dialogue: 0,0:05:44.65,0:05:46.31,Default,,0000,0000,0000,,Китахара Лимон Сенпай
Dialogue: 0,0:05:46.88,0:05:47.48,Default,,0000,0000,0000,,Менің әпкем де
Dialogue: 0,0:05:48.09,0:05:49.10,Default,,0000,0000,0000,,Барлығы қамтылған.
Dialogue: 0,0:05:49.27,0:05:50.09,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:05:50.31,0:05:50.95,Default,,0000,0000,0000,,Бірлесіп күресу
Dialogue: 0,0:05:51.56,0:05:52.40,Default,,0000,0000,0000,,Өйткені ол батыр қыз
Dialogue: 0,0:05:55.41,0:05:56.65,Default,,0000,0000,0000,,Мына планетаға кел
Dialogue: 0,0:05:57.50,0:05:59.31,Default,,0000,0000,0000,,Менің ойымша, бұл өте жақсы болды.
Dialogue: 0,0:05:59.86,0:06:01.32,Default,,0000,0000,0000,,Барлығымен кездесу
Dialogue: 0,0:06:01.67,0:06:03.98,Default,,0000,0000,0000,,Фильмдерді ойнату және түсіру
Dialogue: 0,0:06:04.78,0:06:06.22,Default,,0000,0000,0000,,Мұндай нәрсе қызық
Dialogue: 0,0:06:07.86,0:06:11.43,Default,,0000,0000,0000,,Жаз ешқашан осылай аяқталмайды деп үміттенемін
Dialogue: 0,0:06:12.04,0:06:14.90,Default,,0000,0000,0000,,Мен де солай ойладым.
Dialogue: 0,0:06:18.77,0:06:20.30,Default,,0000,0000,0000,,Мен де өзіме ұнайтын адамды таптым
Dialogue: 0,0:06:21.19,0:06:24.84,Default,,0000,0000,0000,,Мен мұны білмей тұрып, Кайто-кун менің орталығыма айналды.
Dialogue: 0,0:06:25.43,0:06:27.22,Default,,0000,0000,0000,,Мен де ортадамын.
Dialogue: 0,0:06:29.51,0:06:31.35,Default,,0000,0000,0000,,Мұның бәрі қызық болған жоқ.
Dialogue: 0,0:06:32.09,0:06:33.64,Default,,0000,0000,0000,,Қиын кездер болды.
Dialogue: 0,0:06:34.08,0:06:35.72,Default,,0000,0000,0000,,Ашулану немесе жылау
Dialogue: 0,0:06:36.05,0:06:38.08,Default,,0000,0000,0000,,Алда көп нәрсе бар.
Dialogue: 0,0:06:38.90,0:06:40.47,Default,,0000,0000,0000,,Біз тіпті ұрысып қалуымыз мүмкін.
Dialogue: 0,0:06:40.79,0:06:42.04,Default,,0000,0000,0000,,Бұл жағдайда не істеу керек
Dialogue: 0,0:06:43.46,0:06:44.27,Default,,0000,0000,0000,,Жасампаздық
Dialogue: 0,0:06:44.75,0:06:45.57,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:06:47.69,0:06:51.21,Default,,0000,0000,0000,,Егер сізде махаббат болса, сіз кез келген нәрсені жеңе аласыз.
Dialogue: 0,0:06:53.81,0:06:56.48,Default,,0000,0000,0000,,Сіз мені әрқашан жақсы көресіз
Dialogue: 0,0:06:56.80,0:06:57.57,Default,,0000,0000,0000,,Бірлесіп күресу
Dialogue: 0,0:06:58.39,0:07:01.00,Default,,0000,0000,0000,,Мен де Кайтоға ғашықпын.
Dialogue: 0,0:07:01.42,0:07:02.74,Default,,0000,0000,0000,,Мен сені әрқашан жақсы көремін
Dialogue: 0,0:07:04.26,0:07:05.00,Default,,0000,0000,0000,,Тек қарап тұр.
Dialogue: 0,0:07:07.61,0:07:09.34,Default,,0000,0000,0000,,Жаңа айтқаныңызды қайталаңыз.
Dialogue: 0,0:07:09.65,0:07:10.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:12.88,0:07:17.15,Default,,0000,0000,0000,,Мен Кайто-кунды әрқашан жақсы көретінмін.
Dialogue: 0,0:07:18.00,0:07:18.80,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:07:23.13,0:07:25.43,Default,,0000,0000,0000,,Өтінемін, мені мәңгі сүй
Dialogue: 0,0:07:28.43,0:07:28.74,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:31.24,0:07:31.87,Default,,0000,0000,0000,,Ант етемін
Dialogue: 0,0:07:40.52,0:07:42.06,Default,,0000,0000,0000,,Шынымен қатал
Dialogue: 0,0:07:42.95,0:07:45.99,Default,,0000,0000,0000,,Бірақ мен әлі бас тарта алмаймын.
Dialogue: 0,0:07:51.08,0:07:52.27,Default,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:08:00.65,0:08:02.46,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:08:02.66,0:08:03.86,Default,,0000,0000,0000,,Нашар Мио
Dialogue: 0,0:08:04.28,0:08:05.22,Default,,0000,0000,0000,,Менде бензин бітті.
Dialogue: 0,0:08:05.37,0:08:08.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:10.27,0:08:12.46,Default,,0000,0000,0000,,Амансың ба, Тецуро-кун?
Dialogue: 0,0:08:12.73,0:08:14.97,Default,,0000,0000,0000,,Бұл дауыс Сатоши-сан емес еді.
Dialogue: 0,0:08:15.56,0:08:18.59,Default,,0000,0000,0000,,Сатоси-сан Манами-сандікі
Dialogue: 0,0:08:19.56,0:08:21.40,Default,,0000,0000,0000,,Маған көмектес, Сатоси
Dialogue: 0,0:08:21.80,0:08:24.81,Default,,0000,0000,0000,,бұзылған
Dialogue: 0,0:08:32.59,0:08:33.58,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:34.05,0:08:37.31,Default,,0000,0000,0000,,Білмеймін, бірақ жалғастырайық.
Dialogue: 0,0:08:56.78,0:08:57.52,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:08:59.15,0:09:01.17,Default,,0000,0000,0000,,Бұл шынымен де болды
Dialogue: 0,0:09:01.67,0:09:02.29,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:02.79,0:09:03.11,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:03.76,0:09:04.30,Default,,0000,0000,0000,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:09:05.62,0:09:07.66,Default,,0000,0000,0000,,Мендегі бейненің орны
Dialogue: 0,0:09:09.01,0:09:09.94,Default,,0000,0000,0000,,Ақыры келдің
Dialogue: 0,0:09:11.20,0:09:12.38,Default,,0000,0000,0000,,Мен оны таптым
Dialogue: 0,0:09:14.22,0:09:14.79,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:15.55,0:09:16.58,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:09:17.32,0:09:17.90,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:09:19.47,0:09:20.03,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:09:20.48,0:09:21.65,Default,,0000,0000,0000,,Іздерді іздеңіз
Dialogue: 0,0:09:22.19,0:09:22.54,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:27.34,0:09:27.89,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:09:28.71,0:09:29.25,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:09:29.72,0:09:30.70,Default,,0000,0000,0000,,Бұл бөтен адам
Dialogue: 0,0:09:33.16,0:09:34.77,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:09:41.68,0:09:43.60,Default,,0000,0000,0000,,Бұл реакция ақыр соңында
Dialogue: 0,0:09:43.92,0:09:45.58,Default,,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:09:52.44,0:09:53.38,Default,,0000,0000,0000,,Се Сенпай
Dialogue: 0,0:09:54.26,0:09:55.93,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:56.02,0:09:56.99,Default,,0000,0000,0000,,Сіз оны көре аласыз ба?
Dialogue: 0,0:09:57.40,0:09:57.97,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:58.61,0:10:01.74,Default,,0000,0000,0000,,Өйткені бұл менің бейнемде
Dialogue: 0,0:10:03.06,0:10:04.92,Default,,0000,0000,0000,,Емдеуге қолданылатын жасушаларым
Dialogue: 0,0:10:15.21,0:10:16.45,Default,,0000,0000,0000,,Іздер
Dialogue: 0,0:10:17.40,0:10:18.09,Default,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:10:20.11,0:10:21.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:23.51,0:10:24.23,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:10:33.68,0:10:34.19,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:10:35.83,0:10:36.19,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:10:37.35,0:10:40.69,Default,,0000,0000,0000,,Үлкен күш
Dialogue: 0,0:10:44.71,0:10:47.47,Default,,0000,0000,0000,,Ичика мен басқалары сол жаққа қарай бет алды.
Dialogue: 0,0:10:48.27,0:10:50.40,Default,,0000,0000,0000,,Кеңістіктің мөрі бұзылды.
Dialogue: 0,0:10:52.94,0:10:53.88,Default,,0000,0000,0000,,Жоқ, Ичика
Dialogue: 0,0:10:54.85,0:10:57.34,Default,,0000,0000,0000,,Ол жерден тез қашыңыз.
Dialogue: 0,0:11:03.13,0:11:03.97,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:11:04.94,0:11:06.31,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:11:06.36,0:11:06.94,Default,,0000,0000,0000,,Тоқта
Dialogue: 0,0:11:07.40,0:11:08.82,Default,,0000,0000,0000,,Адамды ренжітпеңіз
Dialogue: 0,0:11:09.57,0:11:12.23,Default,,0000,0000,0000,,Мен енді қашпаймын
Dialogue: 0,0:11:12.79,0:11:13.82,Default,,0000,0000,0000,,Жоқ, сенпай.
Dialogue: 0,0:11:16.07,0:11:16.90,Default,,0000,0000,0000,,Тоқта
Dialogue: 0,0:11:17.72,0:11:18.41,Default,,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:11:18.90,0:11:19.68,Default,,0000,0000,0000,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,0:11:19.91,0:11:20.65,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:11:21.42,0:11:22.81,Default,,0000,0000,0000,,Кешіріңіз Кайто-кун
Dialogue: 0,0:11:23.16,0:11:23.79,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:11:24.38,0:11:25.72,Default,,0000,0000,0000,,Мен қазірдің өзінде
Dialogue: 0,0:11:26.04,0:11:26.47,Default,,0000,0000,0000,,Не
Dialogue: 0,0:11:26.54,0:11:27.31,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,0:11:28.51,0:11:32.53,Default,,0000,0000,0000,,Кайто-кунға және барлығына қауіп төндіру.
Dialogue: 0,0:11:33.53,0:11:36.14,Default,,0000,0000,0000,,Мұның бәрі менің өзімшілдігім.
Dialogue: 0,0:11:36.14,0:11:36.71,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:37.73,0:11:39.07,Default,,0000,0000,0000,,Бұл дұрыс емес, Сенпай.
Dialogue: 0,0:11:39.69,0:11:40.33,Default,,0000,0000,0000,,Мен айттым
Dialogue: 0,0:11:42.47,0:11:45.56,Default,,0000,0000,0000,,Барлығы, ең болмағанда мен.
Dialogue: 0,0:11:46.18,0:11:48.02,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:11:48.74,0:11:51.72,Default,,0000,0000,0000,,Керісінше, бұл менің өзімшілдігім.
Dialogue: 0,0:11:52.64,0:11:54.77,Default,,0000,0000,0000,,Мен ағамды жібергім келмейді.
Dialogue: 0,0:12:01.01,0:12:01.71,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:02.03,0:12:02.85,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:12:03.38,0:12:04.20,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:12:05.29,0:12:09.54,Default,,0000,0000,0000,,Мен бұл планетаға келгеніме өкіне бастадым.
Dialogue: 0,0:12:11.01,0:12:14.04,Default,,0000,0000,0000,,Менің өзімшіл ойларым барлығын қамтиды
Dialogue: 0,0:12:15.21,0:12:18.31,Default,,0000,0000,0000,,Соңында ештеңе орындалмады
Dialogue: 0,0:12:19.38,0:12:21.64,Default,,0000,0000,0000,,Бірақ мен ақыры түсіндім.
Dialogue: 0,0:12:22.41,0:12:25.69,Default,,0000,0000,0000,,Біз бір нәрсені бастағымыз келеді
Dialogue: 0,0:12:25.79,0:12:26.96,Default,,0000,0000,0000,,Бір-бірін тапты
Dialogue: 0,0:12:28.18,0:12:29.80,Default,,0000,0000,0000,,Мен оны дұрыстап таба алдым.
Dialogue: 0,0:12:33.92,0:12:36.11,Default,,0000,0000,0000,,Менің бойымда туылған осы сезім
Dialogue: 0,0:12:36.63,0:12:37.75,Default,,0000,0000,0000,,Ол мәңгілікке жалғасады
Dialogue: 0,0:12:38.74,0:12:40.06,Default,,0000,0000,0000,,Ол ешқашан жоғалмайды
Dialogue: 0,0:12:40.48,0:12:41.53,Default,,0000,0000,0000,,Сенген
Dialogue: 0,0:12:43.32,0:12:44.16,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:12:45.40,0:12:46.35,Default,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:12:46.78,0:12:47.62,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:12:48.59,0:12:49.38,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:12:49.85,0:12:52.24,Default,,0000,0000,0000,,мәңгілік
Dialogue: 0,0:12:53.88,0:12:54.65,Default,,0000,0000,0000,,Тағайындалған жер
Dialogue: 0,0:12:58.78,0:12:59.67,Default,,0000,0000,0000,,Мен сені алып кетемін
Dialogue: 0,0:13:00.12,0:13:01.29,Default,,0000,0000,0000,,Мен міндетті түрде барамын
Dialogue: 0,0:13:02.58,0:13:04.75,Default,,0000,0000,0000,,Иә, мен күтемін.
Dialogue: 0,0:13:08.94,0:13:10.93,Default,,0000,0000,0000,,Сенпай! ! !
Dialogue: 0,0:13:12.20,0:13:12.85,Default,,0000,0000,0000,,Теңіз
Dialogue: 0,0:13:31.36,0:13:32.48,Default,,0000,0000,0000,,Содан бері
Dialogue: 0,0:13:33.79,0:13:35.88,Default,,0000,0000,0000,,Қанша уақыт өтті?
Dialogue: 0,0:13:37.50,0:13:38.33,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:13:38.74,0:13:40.36,Default,,0000,0000,0000,,Оны тапқаныңызға рахмет.
Dialogue: 0,0:13:40.46,0:13:43.86,Default,,0000,0000,0000,,Мұны тікелей Ингровтан естуге болады.
Dialogue: 0,0:13:44.93,0:13:47.81,Default,,0000,0000,0000,,Тұқым қуалайтын ата деректері шығарылады
Dialogue: 0,0:13:44.18,0:13:47.49,Default,,0000,0000,0000,,Мен ғарыш кемесіндемін
Dialogue: 0,0:13:47.51,0:13:49.70,Default,,0000,0000,0000,,Апат осы планетаға қонды
Dialogue: 0,0:13:49.78,0:13:52.04,Default,,0000,0000,0000,,Маған осы планетадан біреу көмектесті.
Dialogue: 0,0:13:53.23,0:13:56.66,Default,,0000,0000,0000,,Мен мұны білмей тұрып, ол адам мен үшін маңызды адамға айналды.
Dialogue: 0,0:13:57.28,0:14:02.50,Default,,0000,0000,0000,,Бірақ бұл планета жергілікті тұрғындармен байланыста болуға рұқсат етілмеген шалғай планета.
Dialogue: 0,0:14:03.32,0:14:05.26,Default,,0000,0000,0000,,Жақында сені алып кетуге біреу келеді.
Dialogue: 0,0:14:06.33,0:14:07.67,Default,,0000,0000,0000,,Құпиялылық мақсатында
Dialogue: 0,0:14:08.01,0:14:10.59,Default,,0000,0000,0000,,Бұл планетадағы естеліктер бұғатталған.
Dialogue: 0,0:14:11.85,0:14:12.49,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:14:13.26,0:14:14.21,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:14:14.78,0:14:17.37,Default,,0000,0000,0000,,Мен ол адаммен естеліктерімді сақтағым келді.
Dialogue: 0,0:14:18.43,0:14:20.57,Default,,0000,0000,0000,,Жадым жоғалса да
Dialogue: 0,0:14:21.19,0:14:22.46,Default,,0000,0000,0000,,Есіңізде болмаса да
Dialogue: 0,0:14:23.19,0:14:24.67,Default,,0000,0000,0000,,Мен оны сақтағым келді.
Dialogue: 0,0:14:25.72,0:14:27.41,Default,,0000,0000,0000,,Мені тапқаныңызға рахмет
Dialogue: 0,0:14:28.03,0:14:32.50,Default,,0000,0000,0000,,Ең болмаса менің естеліктерім сенің естеліктеріңе айналады.
Dialogue: 0,0:14:33.17,0:14:36.05,Default,,0000,0000,0000,,Өтінемін, ұмытпаңыз
Dialogue: 0,0:14:37.74,0:14:38.69,Default,,0000,0000,0000,,Мен ұмытпаймын
Dialogue: 0,0:14:40.13,0:14:41.65,Default,,0000,0000,0000,,Ұмыту мүмкін емес
Dialogue: 0,0:14:44.78,0:14:47.65,Default,,0000,0000,0000,,Мен көптен күттім.
Dialogue: 0,0:14:49.45,0:14:53.05,Default,,0000,0000,0000,,Бұл бірнеше айдың ішінде болды.
Dialogue: 0,0:14:54.20,0:14:55.76,Default,,0000,0000,0000,,Жаздағы оқиғалар
Dialogue: 0,0:14:56.71,0:14:58.37,Default,,0000,0000,0000,,Біз ол кезде болатынбыз
Dialogue: 0,0:14:59.07,0:15:00.81,Default,,0000,0000,0000,,Мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:15:02.08,0:15:04.34,Default,,0000,0000,0000,,Бірақ мен бірдеңе істегім келді
Dialogue: 0,0:15:05.56,0:15:08.32,Default,,0000,0000,0000,,Дәл осы кезде Ичика-сенпай пайда болды.
Dialogue: 0,0:15:09.51,0:15:13.04,Default,,0000,0000,0000,,Сіз біздің жазды ерекше еттіңіз.
Dialogue: 0,0:15:14.53,0:15:16.17,Default,,0000,0000,0000,,Қуаныш немесе қайғы
Dialogue: 0,0:15:16.65,0:15:18.07,Default,,0000,0000,0000,,Барлығы қапталған
Dialogue: 0,0:15:18.60,0:15:19.47,Default,,0000,0000,0000,,Сол жаз
Dialogue: 0,0:15:20.53,0:15:21.26,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:15:24.21,0:15:26.34,Default,,0000,0000,0000,,Мен сол жазды ешқашан ұмытпаймын
Dialogue: 0,0:15:41.99,0:15:42.99,Default,,0000,0000,0000,,Тецуро бұл
Dialogue: 0,0:15:44.53,0:15:46.44,Default,,0000,0000,0000,,Маған көрші сыныптағы бір бала өтінді
Dialogue: 0,0:15:47.58,0:15:48.79,Default,,0000,0000,0000,,Оны қабылдамаңыз
Dialogue: 0,0:15:49.20,0:15:50.47,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес
Dialogue: 0,0:15:51.14,0:15:52.78,Default,,0000,0000,0000,,Дұрыс жауап беріңіз.
Dialogue: 0,0:15:53.15,0:15:55.81,Default,,0000,0000,0000,,Дәлірек айтсақ, қызды ал.
Dialogue: 0,0:15:56.71,0:15:58.25,Default,,0000,0000,0000,,Шаршасаңыз да
Dialogue: 0,0:15:58.67,0:16:00.46,Default,,0000,0000,0000,,Мио жақсы. Мио жақсы.
Dialogue: 0,0:16:01.03,0:16:02.05,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:16:03.04,0:16:05.19,Default,,0000,0000,0000,,Жоқ, солай.
Dialogue: 0,0:16:06.60,0:16:08.26,Default,,0000,0000,0000,,Күлме, теңіз
Dialogue: 0,0:16:11.54,0:16:13.28,Default,,0000,0000,0000,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:16:14.38,0:16:15.06,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:16:15.55,0:16:16.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:16.86,0:16:17.90,Default,,0000,0000,0000,,Сосын мен де
Dialogue: 0,0:16:18.88,0:16:19.65,Default,,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:16:22.79,0:16:23.13,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:16:24.10,0:16:24.56,Default,,0000,0000,0000,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:16:27.03,0:16:27.57,Default,,0000,0000,0000,,О
Dialogue: 0,0:16:35.80,0:16:38.46,Default,,0000,0000,0000,,Ой, кілтті құлыптауды ұмытып кетіппін.
Dialogue: 0,0:16:38.56,0:16:39.65,Default,,0000,0000,0000,,Қош келдің үйге.
Dialogue: 0,0:16:40.95,0:16:41.56,Default,,0000,0000,0000,,Үлкен апа
Dialogue: 0,0:16:42.39,0:16:43.81,Default,,0000,0000,0000,,Мен үйге жаңа ғана оралдым.
Dialogue: 0,0:16:44.85,0:16:46.39,Default,,0000,0000,0000,,Боливия қалай болды?
Dialogue: 0,0:16:46.61,0:16:48.55,Default,,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,0:16:48.90,0:16:50.19,Default,,0000,0000,0000,,Бірақ қызық болды
Dialogue: 0,0:16:50.79,0:16:51.41,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:16:51.88,0:16:52.80,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:53.42,0:16:54.69,Default,,0000,0000,0000,,Иә Сувенир
Dialogue: 0,0:16:56.38,0:16:57.52,Default,,0000,0000,0000,,Дәмі нашар емес
Dialogue: 0,0:16:57.85,0:17:02.05,Default,,0000,0000,0000,,Ой, тілектерді орындайтын қуыршақтар ол жақта әйгілі.
Dialogue: 0,0:17:02.62,0:17:04.93,Default,,0000,0000,0000,,Ал бұл Ичика-чанның бөлігі
Dialogue: 0,0:17:06.32,0:17:08.17,Default,,0000,0000,0000,,Ойланып қарашы, Ичика-чан
Dialogue: 0,0:17:08.81,0:17:10.82,Default,,0000,0000,0000,,Аға - бұл
Dialogue: 0,0:17:11.34,0:17:15.47,Default,,0000,0000,0000,,Шетелде оқу мерзімім біткен соң туған жеріме оралдым.
Dialogue: 0,0:17:15.92,0:17:17.81,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:17:17.93,0:17:19.55,Default,,0000,0000,0000,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:17:20.49,0:17:21.32,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:23.35,0:17:25.00,Default,,0000,0000,0000,,Олай болса маған жібер.
Dialogue: 0,0:17:25.44,0:17:27.03,Default,,0000,0000,0000,,Менің ойымша, сіз мекенжайды білесіз.
Dialogue: 0,0:17:31.60,0:17:33.22,Default,,0000,0000,0000,,Иә, аламын.
Dialogue: 0,0:17:46.54,0:17:48.62,Default,,0000,0000,0000,,Тілек?
Dialogue: 0,0:17:50.19,0:17:51.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:51.51,0:17:53.17,Default,,0000,0000,0000,,Сіз аударып жатырсыз ба?
Dialogue: 0,0:17:54.12,0:17:56.68,Default,,0000,0000,0000,,Иә, отбасылық жағдайға байланысты.
Dialogue: 0,0:17:57.25,0:17:59.56,Default,,0000,0000,0000,,Тіпті Лимон-сенпай да кетіп қалды.
Dialogue: 0,0:18:03.18,0:18:05.77,Default,,0000,0000,0000,,Сонымен, сіз қашан ауыстырмақсыз?
Dialogue: 0,0:18:05.90,0:18:06.64,Default,,0000,0000,0000,,Бұдан былай
Dialogue: 0,0:18:08.73,0:18:10.62,Default,,0000,0000,0000,,Бұл қоштасу емес.
Dialogue: 0,0:18:10.92,0:18:11.70,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:18:12.06,0:18:12.87,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:15.57,0:18:16.17,Default,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:18:17.90,0:18:18.65,Default,,0000,0000,0000,,Фильм
Dialogue: 0,0:18:19.54,0:18:20.24,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:22.85,0:18:24.17,Default,,0000,0000,0000,,Лимон Сенпай
Dialogue: 0,0:18:25.43,0:18:28.24,Default,,0000,0000,0000,,Бұл шынымен де керемет жаз болды.
Dialogue: 0,0:18:29.44,0:18:30.06,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:18:32.77,0:18:34.18,Default,,0000,0000,0000,,Фильм аяқталмады
Dialogue: 0,0:18:35.13,0:18:38.95,Default,,0000,0000,0000,,Соңғы көріністі безендіретін сенсің
Dialogue: 0,0:18:41.79,0:18:42.91,Default,,0000,0000,0000,,Жаман теңіз
Dialogue: 0,0:18:43.31,0:18:44.40,Default,,0000,0000,0000,,кенет шапшаңдық
Dialogue: 0,0:18:44.82,0:18:46.91,Default,,0000,0000,0000,,Жарайды, сенің әпкең бүгін кешікті.
Dialogue: 0,0:18:48.87,0:18:51.01,Default,,0000,0000,0000,,Бірақ біраз уақыт өтті.
Dialogue: 0,0:18:51.23,0:18:52.90,Default,,0000,0000,0000,,Барлығымыз осында жиналамыз
Dialogue: 0,0:18:54.34,0:18:55.89,Default,,0000,0000,0000,,Содан кейін мен шамдарды өшіремін.
Dialogue: 0,0:18:56.08,0:18:56.73,Default,,0000,0000,0000,,О
Dialogue: 0,0:19:02.78,0:19:03.12,Default,,0000,0000,0000,,Теңіз
Dialogue: 0,0:19:05.26,0:19:05.65,Default,,0000,0000,0000,,Ал сосын!
Dialogue: 0,0:19:12.11,0:19:12.85,Default,,0000,0000,0000,,Оны бұрыңыз
Dialogue: 0,0:21:07.91,0:21:09.17,Default,,0000,0000,0000,,Адам қайтыс болған кезде
Dialogue: 0,0:21:09.65,0:21:11.06,Default,,0000,0000,0000,,Жұмаққа баруға болады дейді
Dialogue: 0,0:21:12.33,0:21:14.67,Default,,0000,0000,0000,,Бірақ мен олай ойламаймын.
Dialogue: 0,0:21:16.57,0:21:21.58,Default,,0000,0000,0000,,Өлген адам міндетті түрде біреудің жүрегіне саяхат жасайды.
Dialogue: 0,0:21:23.84,0:21:27.09,Default,,0000,0000,0000,,Ол естелікке айналады және өмір сүруін жалғастырады.
Dialogue: 0,0:21:32.71,0:21:33.46,Default,,0000,0000,0000,,Алайда
Dialogue: 0,0:21:34.55,0:21:36.34,Default,,0000,0000,0000,,Бұл да ақырында жоғалады
Dialogue: 0,0:21:37.56,0:21:40.89,Default,,0000,0000,0000,,Сондықтан адамдар бірдеңе қалдырғысы келеді.
Dialogue: 0,0:21:42.58,0:21:44.04,Default,,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:21:45.11,0:21:46.11,Default,,0000,0000,0000,,Есте сақта
Dialogue: 0,0:21:47.65,0:21:50.08,Default,,0000,0000,0000,,Мен камераны бұра беремін
Dialogue: 0,0:21:52.99,0:21:54.71,Default,,0000,0000,0000,,Сол жазда пленкаға басылған
Dialogue: 0,0:21:56.87,0:21:57.84,Default,,0000,0000,0000,,Жалғасы
Dialogue: 0,0:23:01.02,0:23:02.78,Default,,0000,0000,0000,,Бұл фильм биыл тағы түсірілуде
Dialogue: 0,0:23:03.15,0:23:05.32,Default,,0000,0000,0000,,Оны аспирант қалдырды.
Dialogue: 0,0:23:05.91,0:23:08.15,Default,,0000,0000,0000,,Өткен жылы көрдім, керемет болды
Dialogue: 0,0:23:08.55,0:23:09.79,Default,,0000,0000,0000,,Ғарыш кемелері, меха және т.б.
Dialogue: 0,0:23:09.87,0:23:10.93,Default,,0000,0000,0000,,Арнайы әсерлерге толы
Dialogue: 0,0:23:11.33,0:23:12.85,Default,,0000,0000,0000,,Сондай-ақ, кейіпкер сұлу
Dialogue: 0,0:23:13.08,0:23:14.27,Default,,0000,0000,0000,,Міне, осыған байланысты
Dialogue: 0,0:23:17.00,0:23:18.01,Default,,0000,0000,0000,,Тұратын жер жоқ
Dialogue: 0,0:23:18.54,0:23:19.78,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:23:20.30,0:23:22.59,Default,,0000,0000,0000,,Олай болса, менің үйіме барғың келе ме?
Dialogue: 0,0:23:23.21,0:23:24.38,Default,,0000,0000,0000,,Мен жалғыз тұрамын.
Dialogue: 0,0:23:25.08,0:23:26.58,Default,,0000,0000,0000,,Менің үйде қосымша бөлмем бар.
Dialogue: 0,0:23:27.14,0:23:29.40,Default,,0000,0000,0000,,Сонымен ғарыш кемесіне не болды?
Dialogue: 0,0:23:30.05,0:23:31.84,Default,,0000,0000,0000,,ше? сынған
Dialogue: 0,0:23:32.33,0:23:33.03,Default,,0000,0000,0000,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:23:41.33,0:23:44.54,Default,,0000,0000,0000,,Қолдауларыңыз үшін барлығыңызға рахмет
Dialogue: 0,0:23:45.12,0:23:46.65,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:13:44.18,0:13:47.49,Default,,0000,0000,0000,,Менің отырған ғарыш кемесі
Dialogue: 0,0:13:47.51,0:13:49.70,Default,,0000,0000,0000,,Жоқсыз құлаған метеорит шары
Dialogue: 0,0:15:23.48,0:15:26.96,Default,,0000,0000,0000,,Жаздың ортасында
Dialogue: 0,0:19:51.53,0:19:57.24,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:19:57.34,0:20:04.30,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:20:06.56,0:20:12.08,Default,,0000,0000,0000,,Мен мұны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:20:12.54,0:20:19.94,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:20:21.23,0:20:27.82,Default,,0000,0000,0000,,Еш ойланбай, қаш
Dialogue: 0,0:20:28.60,0:20:33.64,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:20:34.89,0:20:38.83,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:20:38.94,0:20:41.34,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:20:41.44,0:20:46.29,Default,,0000,0000,0000,,Жаз ортасының иісімен
Dialogue: 0,0:20:46.35,0:20:49.86,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:20:49.93,0:20:53.51,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:20:53.60,0:20:58.25,Default,,0000,0000,0000,,Душ сияқты өтіңіз
Dialogue: 0,0:20:58.35,0:21:05.97,Default,,0000,0000,0000,,Ол түсті шығарды.
Dialogue: 0,0:21:08.45,0:21:14.22,Default,,0000,0000,0000,,Мен объектив арқылы көрген дүние болды
Dialogue: 0,0:21:14.67,0:21:21.53,Default,,0000,0000,0000,,Басқа біреудің мәселесі сияқты
Dialogue: 0,0:21:23.09,0:21:28.86,Default,,0000,0000,0000,,Мен жоғалтқан сезімдерді түсінгенде
Dialogue: 0,0:21:28.86,0:21:36.21,Default,,0000,0000,0000,,Біздің уақытымыз жылжи бастады
Dialogue: 0,0:21:37.58,0:21:44.24,Default,,0000,0000,0000,,Өлшенетін махаббат массасы
Dialogue: 0,0:21:45.11,0:21:50.08,Default,,0000,0000,0000,,Мен не істесем де тепе-теңдік сақтамайды.
Dialogue: 0,0:21:51.60,0:21:55.40,Default,,0000,0000,0000,,Бос пішін Жану
Dialogue: 0,0:21:55.40,0:21:57.79,Default,,0000,0000,0000,,Күмістің сыртында
Dialogue: 0,0:21:57.84,0:22:02.34,Default,,0000,0000,0000,,Күннің жарқырауы және температура
Dialogue: 0,0:22:02.49,0:22:06.36,Default,,0000,0000,0000,,Мен мұның бәрін қалаймын.
Dialogue: 0,0:22:06.46,0:22:09.82,Default,,0000,0000,0000,,Сол жаз анық болды
Dialogue: 0,0:22:10.07,0:22:12.50,Default,,0000,0000,0000,,Балалық шақтағы естеліктер
Dialogue: 0,0:22:12.53,0:22:26.17,Default,,0000,0000,0000,,Қамау Алысқа теңізге ұшайық
Dialogue: 0,0:19:51.53,0:19:57.24,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:19:57.34,0:20:04.30,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:20:06.56,0:20:12.08,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:20:12.54,0:20:19.94,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:21.23,0:20:27.82,Default,,0000,0000,0000,,Ол үшін ақы төлеудің қажеті жоқ.
Dialogue: 0,0:20:28.60,0:20:33.64,Default,,0000,0000,0000,,Накая ұзақ уақыт бойы белсенділік танытты
Dialogue: 0,0:20:34.89,0:20:38.83,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:20:38.94,0:20:41.34,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:20:41.44,0:20:46.29,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:20:46.35,0:20:49.86,Default,,0000,0000,0000,,Маған шексіз өкін
Dialogue: 0,0:20:49.93,0:20:53.51,Default,,0000,0000,0000,,Мен үшін бұл жай ғана ғажайып
Dialogue: 0,0:20:53.60,0:20:58.25,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:58.35,0:21:05.97,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:21:08.45,0:21:14.22,Default,,0000,0000,0000,,Мөлдір айна әлемі
Dialogue: 0,0:21:14.67,0:21:21.53,Default,,0000,0000,0000,,Бейне көзіме түспейді.
Dialogue: 0,0:21:23.09,0:21:28.86,Default,,0000,0000,0000,,Бұл қайталану уақыты
Dialogue: 0,0:21:28.86,0:21:36.21,Default,,0000,0000,0000,,Біздің қозғалыстың басталу уақыты
Dialogue: 0,0:21:37.58,0:21:44.24,Default,,0000,0000,0000,,Махаббат тепе-теңдігі
Dialogue: 0,0:21:45.11,0:21:50.08,Default,,0000,0000,0000,,Қол жетпейтін тепе-теңдік
Dialogue: 0,0:21:51.60,0:21:55.40,Default,,0000,0000,0000,,Аспан бренді
Dialogue: 0,0:21:55.40,0:21:57.79,Default,,0000,0000,0000,,Тікелей галактика
Dialogue: 0,0:21:57.84,0:22:02.34,Default,,0000,0000,0000,,Күн сәулесінің температурасы
Dialogue: 0,0:22:02.49,0:22:06.36,Default,,0000,0000,0000,,Бүкіл қалаға бөлінбеген сұраныс
Dialogue: 0,0:22:06.46,0:22:09.82,Default,,0000,0000,0000,,Нағыз бар табиғи жазғы аспан
Dialogue: 0,0:22:10.07,0:22:12.50,Default,,0000,0000,0000,,Жадтың жан-жақты жинағы
Dialogue: 0,0:22:12.53,0:22:26.17,Default,,0000,0000,0000,,Жабдықтардың кең ауқымы
Dialogue: 0,0:23:48.15,0:23:54.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
