Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:59.96,0:03:09.96,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:59.96,0:03:09.96,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:02.26,0:00:03.03,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:00:05.84,0:00:09.84,Default,,0000,0000,0000,,Сенпай Мынау
Dialogue: 0,0:00:10.76,0:00:12.67,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:00:13.71,0:00:15.40,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:00:15.83,0:00:17.24,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:00:19.51,0:00:22.03,Default,,0000,0000,0000,,Бәріне менің кінәм
Dialogue: 0,0:00:24.40,0:00:26.71,Default,,0000,0000,0000,,Мен менмін
Dialogue: 0,0:00:26.96,0:00:29.74,Default,,0000,0000,0000,,Әй, бәрі қайда?
Dialogue: 0,0:00:29.02,0:00:29.72,Default,,0000,0000,0000,,Әпке
Dialogue: 0,0:00:35.66,0:00:38.10,Default,,0000,0000,0000,,Барлығы қайда?
Dialogue: 0,0:00:45.43,0:00:47.94,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:00:48.21,0:00:49.13,Default,,0000,0000,0000,,Ой, аралы тен
Dialogue: 0,0:00:50.75,0:00:51.52,Default,,0000,0000,0000,,осында
Dialogue: 0,0:00:56.59,0:00:57.33,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:00:59.37,0:01:00.06,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:01:01.38,0:01:02.03,Default,,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:01:05.21,0:01:07.75,Default,,0000,0000,0000,,Такидзуки Сенпай
Dialogue: 0,0:01:08.84,0:01:09.64,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:01:11.18,0:01:11.92,Default,,0000,0000,0000,,Осы кеменің бортында
Dialogue: 0,0:01:12.67,0:01:14.11,Default,,0000,0000,0000,,Мен бұл планетаға келдім
Dialogue: 0,0:01:17.07,0:01:20.87,Default,,0000,0000,0000,,Мен бұл планетадан емеспін
Dialogue: 0,0:01:22.24,0:01:25.40,Default,,0000,0000,0000,,Иә, мен мұны білдім.
Dialogue: 0,0:01:25.97,0:01:29.61,Default,,0000,0000,0000,,Сондықтан мен таң қалмаймын
Dialogue: 0,0:03:13.24,0:03:14.45,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:15.15,0:03:16.99,Default,,0000,0000,0000,,Бұл ғылыми фантастика.
Dialogue: 0,0:03:17.41,0:03:18.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:18.46,0:03:20.12,Default,,0000,0000,0000,,Бұл жұмыс істемейді
Dialogue: 0,0:03:21.74,0:03:24.07,Default,,0000,0000,0000,,Мен осы планетаға барар жолда апатқа тап болдым.
Dialogue: 0,0:03:24.72,0:03:26.83,Default,,0000,0000,0000,,Қазіргі уақытта шарлау мүмкін емес
Dialogue: 0,0:03:27.08,0:03:28.84,Default,,0000,0000,0000,,Сондай-ақ жүйеде ақау бар.
Dialogue: 0,0:03:29.42,0:03:32.57,Default,,0000,0000,0000,,Бастапқыда мен осында тұруды жоспарлағанмын.
Dialogue: 0,0:03:33.00,0:03:35.28,Default,,0000,0000,0000,,Сонымен мен Киришима-кунның үйіне бардым.
Dialogue: 0,0:03:36.45,0:03:38.80,Default,,0000,0000,0000,,Басқа да себептер бар.
Dialogue: 0,0:03:39.56,0:03:42.32,Default,,0000,0000,0000,,Сонда бұл механикалық нәрсе не?
Dialogue: 0,0:03:42.74,0:03:44.63,Default,,0000,0000,0000,,Маған шабуыл жасадыңыз ба?
Dialogue: 0,0:03:44.93,0:03:46.09,Default,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:03:46.67,0:03:50.14,Default,,0000,0000,0000,,Бұл апаттық құтқару боты.
Dialogue: 0,0:03:50.44,0:03:51.67,Default,,0000,0000,0000,,Бұл кеме
Dialogue: 0,0:03:52.23,0:03:54.97,Default,,0000,0000,0000,,Автоматты түрде берілетін апат сигналына жауап ретінде
Dialogue: 0,0:03:55.41,0:03:57.20,Default,,0000,0000,0000,,Сен мені құтқаруға келдің.
Dialogue: 0,0:03:57.53,0:03:59.54,Default,,0000,0000,0000,,Сен бұздың ба?
Dialogue: 0,0:03:59.76,0:04:01.80,Default,,0000,0000,0000,,Бұл қалай болады
Dialogue: 0,0:04:02.00,0:04:02.99,Default,,0000,0000,0000,,Оқиғалардың барысы
Dialogue: 0,0:04:03.37,0:04:05.70,Default,,0000,0000,0000,,Бұл кеме қозғалмайды, солай ма?
Dialogue: 0,0:04:06.08,0:04:08.21,Default,,0000,0000,0000,,Құтқарылмағаныңызға қуаныштысыз ба?
Dialogue: 0,0:04:08.59,0:04:10.18,Default,,0000,0000,0000,,Бұл жақсы емес, бірақ
Dialogue: 0,0:04:13.18,0:04:15.47,Default,,0000,0000,0000,,Өйткені мен әлі де осы планетада болғым келді
Dialogue: 0,0:04:16.22,0:04:17.09,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:17.63,0:04:19.55,Default,,0000,0000,0000,,Мен осы планетадамын
Dialogue: 0,0:04:19.90,0:04:21.47,Default,,0000,0000,0000,,Мен жер іздеп келдім.
Dialogue: 0,0:04:21.98,0:04:22.80,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:04:23.45,0:04:25.85,Default,,0000,0000,0000,,Менің жадымдағы орны
Dialogue: 0,0:04:26.95,0:04:29.44,Default,,0000,0000,0000,,Мен оның шынымен бар-жоғын білмеймін.
Dialogue: 0,0:04:30.48,0:04:31.85,Default,,0000,0000,0000,,Мен сонда барғым келеді
Dialogue: 0,0:04:32.65,0:04:33.89,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:04:34.53,0:04:36.52,Default,,0000,0000,0000,,Сау болыңыз, Сенпай.
Dialogue: 0,0:04:37.79,0:04:40.76,Default,,0000,0000,0000,,Мен ағамның жат жерлік екенін ешкімге айтпаймын.
Dialogue: 0,0:04:41.15,0:04:41.72,Default,,0000,0000,0000,,На
Dialogue: 0,0:04:42.14,0:04:43.40,Default,,0000,0000,0000,,Жақсы, жақсы.
Dialogue: 0,0:04:43.98,0:04:46.44,Default,,0000,0000,0000,,Жарайды, менің ағам оны жат планеталық деді.
Dialogue: 0,0:04:46.56,0:04:47.73,Default,,0000,0000,0000,,Ешкімге сенбе
Dialogue: 0,0:04:48.13,0:04:50.37,Default,,0000,0000,0000,,Бірақ егер Қара киімді адамдар білсе ше?
Dialogue: 0,0:04:51.93,0:04:52.75,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:04:53.30,0:04:54.74,Default,,0000,0000,0000,,Мұндай ұйым жоқ.
Dialogue: 0,0:04:55.04,0:04:56.34,Default,,0000,0000,0000,,немесе диссекция
Dialogue: 0,0:04:56.53,0:04:57.33,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:04:57.57,0:04:59.29,Default,,0000,0000,0000,,Сіз бұл туралы уайымдадыңыз ба?
Dialogue: 0,0:04:59.51,0:05:01.10,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:05:02.12,0:05:04.98,Default,,0000,0000,0000,,Такизуки-сенпай, мен де ешкімге айтпаймын.
Dialogue: 0,0:05:05.15,0:05:05.92,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:05:06.17,0:05:07.26,Default,,0000,0000,0000,,Мен ешкімге айтпаймын
Dialogue: 0,0:05:08.24,0:05:09.31,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:09.95,0:05:11.96,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:05:13.53,0:05:15.19,Default,,0000,0000,0000,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,0:05:17.90,0:05:18.61,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:19.94,0:05:21.71,Default,,0000,0000,0000,,Өйткені бұл үлкен мәселе.
Dialogue: 0,0:05:21.78,0:05:23.46,Default,,0000,0000,0000,,Мен мұнда экскурсия жасай аламын ба?
Dialogue: 0,0:05:23.62,0:05:25.58,Default,,0000,0000,0000,,Тецуро, сен осындай уақытта не істейсің?
Dialogue: 0,0:05:25.68,0:05:28.22,Default,,0000,0000,0000,,Өйткені мұндай мүмкіндіктер жиі бола бермейді.
Dialogue: 0,0:05:28.57,0:05:29.86,Default,,0000,0000,0000,,Сіз бұл Мио болады деп ойлайсыз.
Dialogue: 0,0:05:30.16,0:05:32.47,Default,,0000,0000,0000,,Мүмкін солай шығар.
Dialogue: 0,0:05:32.59,0:05:34.46,Default,,0000,0000,0000,,Бұл, әрине, қызық.
Dialogue: 0,0:05:34.66,0:05:35.19,Default,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:05:39.65,0:05:42.47,Default,,0000,0000,0000,,Уау, бұл керемет. Бұл өте ыңғайлы.
Dialogue: 0,0:05:42.66,0:05:43.80,Default,,0000,0000,0000,,Тецуро-кун
Dialogue: 0,0:05:44.62,0:05:45.62,Default,,0000,0000,0000,,Осыншама уақыт өтті
Dialogue: 0,0:05:45.97,0:05:47.62,Default,,0000,0000,0000,,Аналар міндетті түрде уайымдайды.
Dialogue: 0,0:05:47.98,0:05:50.09,Default,,0000,0000,0000,,Менің сізге жіберуден басқа амалым жоқ.
Dialogue: 0,0:05:50.46,0:05:52.23,Default,,0000,0000,0000,,Осылайша мен әпкемді ұмытып кеттім.
Dialogue: 0,0:05:52.63,0:05:53.37,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:54.22,0:05:56.30,Default,,0000,0000,0000,,Мені кешке дейін ұстаңыз.
Dialogue: 0,0:05:57.17,0:05:58.67,Default,,0000,0000,0000,,Мені тыңда
Dialogue: 0,0:05:58.91,0:06:03.23,Default,,0000,0000,0000,,Уайымдама, Ичика, әдеттегідей бол.
Dialogue: 0,0:06:04.93,0:06:05.62,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:07.61,0:06:09.00,Default,,0000,0000,0000,,Бұл таңқаларлық, солай емес пе?
Dialogue: 0,0:06:09.40,0:06:11.81,Default,,0000,0000,0000,,Такидзуки-сенпай - жат планеталық.
Dialogue: 0,0:06:12.14,0:06:14.08,Default,,0000,0000,0000,,Айтайын дегенім, мен әлі де сене алар емеспін.
Dialogue: 0,0:06:14.22,0:06:16.72,Default,,0000,0000,0000,,Бұл таң қалдырды десең сенер едім
Dialogue: 0,0:06:16.86,0:06:20.11,Default,,0000,0000,0000,,О, мен бұл туралы түсініксіз ғана білдім.
Dialogue: 0,0:06:20.34,0:06:21.76,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:06:21.95,0:06:24.96,Default,,0000,0000,0000,,Өтірік сияқты, бірақ мен оны толығымен жоққа шығара алмаймын.
Dialogue: 0,0:06:25.21,0:06:27.15,Default,,0000,0000,0000,,Бұл дұрыс, өйткені мен
Dialogue: 0,0:06:27.35,0:06:29.55,Default,,0000,0000,0000,,Қара киімді адамдардың агенті
Dialogue: 0,0:06:29.71,0:06:30.73,Default,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:06:31.00,0:06:32.82,Default,,0000,0000,0000,,Менің айтайын дегенім, бұл не әзіл?
Dialogue: 0,0:06:32.86,0:06:34.58,Default,,0000,0000,0000,,Такизуки-сенпай, мен қорқамын.
Dialogue: 0,0:06:34.63,0:06:35.08,Default,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:06:34.13,0:06:36.94,Default,,0000,0000,0000,,Теңіз туралы не істейсіз?
Dialogue: 0,0:06:39.00,0:06:42.41,Default,,0000,0000,0000,,Бұл таңғажайып күн болды.
Dialogue: 0,0:06:42.81,0:06:43.73,Default,,0000,0000,0000,,Үйге ерте бар
Dialogue: 0,0:06:43.76,0:06:44.41,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:06:45.62,0:06:48.53,Default,,0000,0000,0000,,Мен Кайтоға әлі айтпаған нәрсем бар.
Dialogue: 0,0:06:49.02,0:06:49.75,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:50.54,0:06:53.52,Default,,0000,0000,0000,,Мен бұл планетаға ғарыш кемесімен алғаш рет келдім
Dialogue: 0,0:06:54.59,0:06:57.17,Default,,0000,0000,0000,,Мен, Кайто-кун
Dialogue: 0,0:06:57.27,0:06:58.08,Default,,0000,0000,0000,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:06:59.68,0:07:01.96,Default,,0000,0000,0000,,Менің сенпайым ол кезде болмаса,
Dialogue: 0,0:07:02.69,0:07:04.90,Default,,0000,0000,0000,,Мен өліп кетуім мүмкін еді.
Dialogue: 0,0:07:05.82,0:07:07.09,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:07:07.83,0:07:09.33,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:07:09.45,0:07:10.89,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:07:11.96,0:07:14.32,Default,,0000,0000,0000,,Өйткені мен оны жұлдызды технологияммен өңдедім
Dialogue: 0,0:07:14.50,0:07:17.03,Default,,0000,0000,0000,,Мәселе неде болуы мүмкін деп ойлайсыз?
Dialogue: 0,0:07:17.35,0:07:18.77,Default,,0000,0000,0000,,Олай болса маған кел
Dialogue: 0,0:07:19.44,0:07:20.17,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:20.51,0:07:22.31,Default,,0000,0000,0000,,Ой, уайымдама
Dialogue: 0,0:07:22.57,0:07:23.98,Default,,0000,0000,0000,,Бұл апат болды ма, жоқ па
Dialogue: 0,0:07:24.31,0:07:26.13,Default,,0000,0000,0000,,Осылайша мен ағаммен кездесіп қалдым.
Dialogue: 0,0:07:26.67,0:07:28.15,Default,,0000,0000,0000,,Мен шынымен бақыттымын.
Dialogue: 0,0:07:30.38,0:07:35.07,Default,,0000,0000,0000,,Иә, мәселе менің ағамның бөтен адам болғанында емес.
Dialogue: 0,0:07:36.32,0:07:37.44,Default,,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:07:40.79,0:07:42.53,Default,,0000,0000,0000,,Жарайды, кешірім сұрама.
Dialogue: 0,0:07:42.78,0:07:45.66,Default,,0000,0000,0000,,Барлығымен дұрыс сөйлесе алу шынымен де сергітетін болды.
Dialogue: 0,0:07:46.96,0:07:47.53,Default,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:07:47.85,0:07:50.95,Default,,0000,0000,0000,,Федерацияның қауіпсіздік бюросы құтқару ботының жойылғанын біледі.
Dialogue: 0,0:07:51.45,0:07:53.53,Default,,0000,0000,0000,,Олар тергеушіні жібере алады.
Dialogue: 0,0:07:54.09,0:07:57.76,Default,,0000,0000,0000,,Егер бұл орын алса, ол барлығына қиындық тудыруы мүмкін.
Dialogue: 0,0:07:58.64,0:08:01.04,Default,,0000,0000,0000,,Мен сені тағы да ренжітуім мүмкін
Dialogue: 0,0:08:02.84,0:08:04.22,Default,,0000,0000,0000,,Уақыт шектеулі
Dialogue: 0,0:08:05.52,0:08:06.84,Default,,0000,0000,0000,,Қалған уақыт
Dialogue: 0,0:08:09.08,0:08:11.83,Default,,0000,0000,0000,,Мионың менің үйіме келгеніне біраз болды.
Dialogue: 0,0:08:12.01,0:08:15.04,Default,,0000,0000,0000,,Кешіріңіз, кенет түнде қалғым келеді деп айтқаныңыз үшін.
Dialogue: 0,0:08:15.36,0:08:17.68,Default,,0000,0000,0000,,Бұл жақсы, бірақ неге?
Dialogue: 0,0:08:18.45,0:08:22.25,Default,,0000,0000,0000,,Мен Канна абдырап қалады деп ойладым.
Dialogue: 0,0:08:22.75,0:08:27.17,Default,,0000,0000,0000,,Дұрыс. Такидзуки-сенпайдың жат жерлік екенін естігенде.
Dialogue: 0,0:08:27.27,0:08:28.46,Default,,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,0:08:28.93,0:08:30.57,Default,,0000,0000,0000,,Киришима-кун туралы
Dialogue: 0,0:08:31.47,0:08:33.67,Default,,0000,0000,0000,,Киришима-кун, сен не істейсің?
Dialogue: 0,0:08:34.20,0:08:38.03,Default,,0000,0000,0000,,Такидзуки-сенпай бөтен адам болса, онда ол қашан болады?
Dialogue: 0,0:08:39.62,0:08:40.40,Default,,0000,0000,0000,,Айтпа
Dialogue: 0,0:08:41.76,0:08:45.24,Default,,0000,0000,0000,,Осыны ойласам, мен өте жағымсыз балаға айналамын.
Dialogue: 0,0:08:45.59,0:08:46.58,Default,,0000,0000,0000,,Айлакер бала бол
Dialogue: 0,0:08:47.40,0:08:48.67,Default,,0000,0000,0000,,Қырсық болғаны дұрыс
Dialogue: 0,0:08:49.34,0:08:50.81,Default,,0000,0000,0000,,Мен сені жақсы көруді тоқтата алмаймын
Dialogue: 0,0:08:52.07,0:08:53.93,Default,,0000,0000,0000,,Сіз тоқтамайсыз
Dialogue: 0,0:08:55.90,0:08:58.26,Default,,0000,0000,0000,,Айтайын дегенім, менің сезімімді қайдан білесің?
Dialogue: 0,0:08:58.63,0:08:59.68,Default,,0000,0000,0000,,Бұл анық болады
Dialogue: 0,0:09:02.46,0:09:05.90,Default,,0000,0000,0000,,Кайто-кун, осы уақытқа дейін көрсеткен көмегіңіз үшін көп рахмет.
Dialogue: 0,0:09:06.41,0:09:08.79,Default,,0000,0000,0000,,Мен ата-анамның үйіне қайтамын.
Dialogue: 0,0:09:09.27,0:09:11.97,Default,,0000,0000,0000,,Кайто туралы Мұнда уақыт өткізудің мағынасы
Dialogue: 0,0:09:12.16,0:09:14.40,Default,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын.
Dialogue: 0,0:09:14.57,0:09:16.66,Default,,0000,0000,0000,,Сенпай Мен толық емес жұмыс күні немесе басқаша жұмыс істеймін.
Dialogue: 0,0:09:16.80,0:09:18.20,Default,,0000,0000,0000,,Мен сізге міндетті түрде келемін.
Dialogue: 0,0:09:18.44,0:09:22.17,Default,,0000,0000,0000,,Бірақ менің үйім - Андромеда.
Dialogue: 0,0:09:25.73,0:09:30.92,Default,,0000,0000,0000,,2,3 миллион жарық жылы?
Dialogue: 0,0:09:33.26,0:09:36.46,Default,,0000,0000,0000,,Ғалам өте кең, солай емес пе?
Dialogue: 0,0:09:39.35,0:09:40.04,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:09:40.79,0:09:42.15,Default,,0000,0000,0000,,Қайырлы таң Кайто-кун
Dialogue: 0,0:09:42.40,0:09:44.08,Default,,0000,0000,0000,,Мен біраз уақытқа шығамын.
Dialogue: 0,0:09:44.27,0:09:45.91,Default,,0000,0000,0000,,О, мен шығамын.
Dialogue: 0,0:09:47.03,0:09:49.49,Default,,0000,0000,0000,,Мүмкін сол жер шығар?
Dialogue: 0,0:09:49.66,0:09:52.24,Default,,0000,0000,0000,,Иә, мен таңғы ас әзірледім.
Dialogue: 0,0:09:52.92,0:09:54.83,Default,,0000,0000,0000,,Мен кешкі асқа ораламын.
Dialogue: 0,0:09:55.75,0:09:56.30,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:59.30,0:10:00.63,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:01.71,0:10:03.37,Default,,0000,0000,0000,,Егер мен осы планетада қала берсем
Dialogue: 0,0:10:03.95,0:10:05.47,Default,,0000,0000,0000,,Бұл әркімге кедергі
Dialogue: 0,0:10:06.69,0:10:08.81,Default,,0000,0000,0000,,Көмекке қазір қоңырау шалу керек.
Dialogue: 0,0:10:09.87,0:10:13.07,Default,,0000,0000,0000,,Мен неге үйге бармаймын?
Dialogue: 0,0:10:14.19,0:10:17.88,Default,,0000,0000,0000,,Эй, Мио, менің тоқтаудан басқа амалым жоқ.
Dialogue: 0,0:10:18.12,0:10:18.99,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:10:19.29,0:10:21.25,Default,,0000,0000,0000,,Өйткені бүгін кеше болды.
Dialogue: 0,0:10:21.45,0:10:23.26,Default,,0000,0000,0000,,Дәлірек айтсақ, бүгінгі күн.
Dialogue: 0,0:10:23.64,0:10:26.82,Default,,0000,0000,0000,,Мен Такизуки-сенпаймен қалай араласатынымды білмеймін.
Dialogue: 0,0:10:26.97,0:10:28.69,Default,,0000,0000,0000,,Қажетсіз нәрселер туралы ойламаңыз
Dialogue: 0,0:10:28.98,0:10:30.62,Default,,0000,0000,0000,,Әдетте жасайтын нәрсені ғана істе.
Dialogue: 0,0:10:30.77,0:10:31.91,Default,,0000,0000,0000,,Мен бұл туралы ойлаймын
Dialogue: 0,0:10:32.06,0:10:33.30,Default,,0000,0000,0000,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:10:33.48,0:10:36.71,Default,,0000,0000,0000,,Мио: Шашын қиғаннан бері оның мінезі өзгерген жоқ.
Dialogue: 0,0:10:36.91,0:10:38.10,Default,,0000,0000,0000,,Не болды
Dialogue: 0,0:10:38.92,0:10:39.69,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:10:40.34,0:10:43.12,Default,,0000,0000,0000,,Ештеңе
Dialogue: 0,0:10:43.97,0:10:46.87,Default,,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:10:48.32,0:10:51.47,Default,,0000,0000,0000,,Түсіндім, Такизуки-сенпай шығып жатыр.
Dialogue: 0,0:10:51.89,0:10:54.18,Default,,0000,0000,0000,,Мен кеше сен айтқан жерді іздеймін.
Dialogue: 0,0:10:54.65,0:10:57.59,Default,,0000,0000,0000,,Сенің жалғыз барғаның жиіркенішті.
Dialogue: 0,0:10:57.76,0:11:00.00,Default,,0000,0000,0000,,Сен мені жіберсең, біз де ынтымақтасатын едік.
Dialogue: 0,0:11:00.67,0:11:04.32,Default,,0000,0000,0000,,Ойланатын дүние көп деп ойлаймын.
Dialogue: 0,0:11:05.84,0:11:06.72,Default,,0000,0000,0000,,Сіз түсіріп жатырсыз ба?
Dialogue: 0,0:11:06.96,0:11:07.50,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:09.64,0:11:11.26,Default,,0000,0000,0000,,Жақсы, сол жаққа барыңыз.
Dialogue: 0,0:11:11.65,0:11:12.80,Default,,0000,0000,0000,,Иә, шабуыл жасалды
Dialogue: 0,0:11:14.41,0:11:20.22,Default,,0000,0000,0000,,Мен ол туралы сыныптастарым арасындағы өсек-аяң арқылы білдім.
Dialogue: 0,0:11:20.60,0:11:21.52,Default,,0000,0000,0000,,Оқушыны ауыстыру
Dialogue: 0,0:11:22.52,0:11:25.10,Default,,0000,0000,0000,,Ол әкімдікке барған Киришима атасының немересі.
Dialogue: 0,0:11:25.37,0:11:26.78,Default,,0000,0000,0000,,Әй, әлгі фанат.
Dialogue: 0,0:11:26.94,0:11:28.61,Default,,0000,0000,0000,,Менің ата-анам жол апатынан қайтыс болды.
Dialogue: 0,0:11:28.88,0:11:31.18,Default,,0000,0000,0000,,Мама сенің осында оралдың деді.
Dialogue: 0,0:11:31.39,0:11:32.71,Default,,0000,0000,0000,,О, бейшара.
Dialogue: 0,0:11:32.85,0:11:35.17,Default,,0000,0000,0000,,Барлығы өз орындарына отырады.
Dialogue: 0,0:11:37.10,0:11:39.45,Default,,0000,0000,0000,,Бүгіннен бастап мен бәріңмен бірге оқимын.
Dialogue: 0,0:11:39.54,0:11:41.15,Default,,0000,0000,0000,,Мен сізді ауысатын студентпен таныстырамын.
Dialogue: 0,0:11:41.78,0:11:44.03,Default,,0000,0000,0000,,Мен Токиодан келген Кайто Киришимамын.
Dialogue: 0,0:11:44.66,0:11:45.90,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:11:47.92,0:11:49.79,Default,,0000,0000,0000,,Соны айтты да, күлді.
Dialogue: 0,0:11:50.80,0:11:53.68,Default,,0000,0000,0000,,Ата-анамнан айырылғаныма сене алар емеспін.
Dialogue: 0,0:11:54.35,0:11:56.12,Default,,0000,0000,0000,,Өзіңізді оның орнына қойыңыз
Dialogue: 0,0:11:56.57,0:11:58.53,Default,,0000,0000,0000,,Бұл өте күлкілі жағдай емес.
Dialogue: 0,0:11:59.40,0:12:01.59,Default,,0000,0000,0000,,Сонда да күлуге тырысады
Dialogue: 0,0:12:03.30,0:12:05.97,Default,,0000,0000,0000,,Сол уақыттан бері шығар
Dialogue: 0,0:12:07.05,0:12:08.71,Default,,0000,0000,0000,,Менің ойымша, ол мұны түсінді.
Dialogue: 0,0:12:10.68,0:12:12.28,Default,,0000,0000,0000,,Сол кездегі бет-әлпетіңіз
Dialogue: 0,0:12:14.61,0:12:15.98,Default,,0000,0000,0000,,Қазір Кайто-кунмен
Dialogue: 0,0:12:16.95,0:12:17.49,Default,,0000,0000,0000,,Қосарлы
Dialogue: 0,0:12:20.45,0:12:22.35,Default,,0000,0000,0000,,Егер сізде пленка жеткіліксіз болса, сатып алыңыз және сатыңыз.
Dialogue: 0,0:12:22.84,0:12:25.32,Default,,0000,0000,0000,,Сондай-ақ, мүмкін қолшатыр.
Dialogue: 0,0:12:27.01,0:12:29.31,Default,,0000,0000,0000,,А, қайырлы таң, Сенпай.
Dialogue: 0,0:12:29.65,0:12:30.91,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:31.78,0:12:33.84,Default,,0000,0000,0000,,Бүгін ерте келдің ғой, солай ма?
Dialogue: 0,0:12:34.14,0:12:35.86,Default,,0000,0000,0000,,Мен де бүгін сені іздеймін.
Dialogue: 0,0:12:36.98,0:12:38.67,Default,,0000,0000,0000,,Маған да көмектесуге рұқсат етіңіз.
Dialogue: 0,0:12:38.92,0:12:40.86,Default,,0000,0000,0000,,Барлығынан да фильм түсіруді сұраңыз.
Dialogue: 0,0:12:41.05,0:12:42.60,Default,,0000,0000,0000,,Мен біраз уақыт үзіліс жасадым.
Dialogue: 0,0:12:42.94,0:12:43.59,Default,,0000,0000,0000,,Сонымен қатар, Ягами-сан, Мокки-саннан Цукидің қозғалысын бақылап отыруды сұраңыз
Dialogue: 0,0:12:43.61,0:12:46.81,Default,,0000,0000,0000,,Мм, мен жалғыз барамын.
Dialogue: 0,0:12:48.00,0:12:50.02,Default,,0000,0000,0000,,Мен Кайто-кунға қиындық туғыза алмаймын.
Dialogue: 0,0:12:50.46,0:12:52.85,Default,,0000,0000,0000,,Бұл мен үшін жеке мәселе.
Dialogue: 0,0:12:53.10,0:12:53.82,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:12:54.34,0:12:55.26,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:55.67,0:12:57.46,Default,,0000,0000,0000,,Бірақ кешіріңіз.
Dialogue: 0,0:12:57.88,0:12:59.55,Default,,0000,0000,0000,,Киноға сәттілік
Dialogue: 0,0:13:00.49,0:13:00.97,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:13:08.10,0:13:10.51,Default,,0000,0000,0000,,Бүгін түсірілім болмайды дедім.
Dialogue: 0,0:13:10.66,0:13:12.10,Default,,0000,0000,0000,,Келу жаман ой ма?
Dialogue: 0,0:13:12.62,0:13:13.78,Default,,0000,0000,0000,,Жаман емес
Dialogue: 0,0:13:14.33,0:13:15.35,Default,,0000,0000,0000,,Бұл дәмді
Dialogue: 0,0:13:15.68,0:13:16.82,Default,,0000,0000,0000,,Бұл қарбыз емес.
Dialogue: 0,0:13:17.44,0:13:20.27,Default,,0000,0000,0000,,Ичика-сенпай, тағы шығасың ба?
Dialogue: 0,0:13:22.69,0:13:24.15,Default,,0000,0000,0000,,Неге маған көмектеспейсің?
Dialogue: 0,0:13:25.87,0:13:28.02,Default,,0000,0000,0000,,Жеке мәселе болғандықтан қабылданбады
Dialogue: 0,0:13:28.58,0:13:29.79,Default,,0000,0000,0000,,Фильмге сәттілік тілейміз
Dialogue: 0,0:13:30.19,0:13:32.54,Default,,0000,0000,0000,,Түсіндім, не болды?
Dialogue: 0,0:13:33.20,0:13:34.99,Default,,0000,0000,0000,,Мен түсірмеген пейзаждық кадр есіме түсті.
Dialogue: 0,0:13:36.21,0:13:37.57,Default,,0000,0000,0000,,Мен біраз уақытқа Каруизаваға барамын.
Dialogue: 0,0:13:37.95,0:13:39.36,Default,,0000,0000,0000,,Үйге баратын болсаң, есікті құлыптауымды сұрама.
Dialogue: 0,0:13:39.42,0:13:40.40,Default,,0000,0000,0000,,Әй теңіз
Dialogue: 0,0:13:40.79,0:13:42.14,Default,,0000,0000,0000,,Әрқашан кілтті бір жерде ұстаңыз
Dialogue: 0,0:13:42.69,0:13:43.62,Default,,0000,0000,0000,,Бәрі жақсы болғандықтан
Dialogue: 0,0:13:44.09,0:13:45.82,Default,,0000,0000,0000,,Мұнымен не істеуім керек?
Dialogue: 0,0:13:50.57,0:13:51.06,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:13:51.23,0:13:51.90,Default,,0000,0000,0000,,Тецуро
Dialogue: 0,0:13:52.16,0:13:52.88,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:13:53.45,0:13:54.67,Default,,0000,0000,0000,,Қарбыз тағы?
Dialogue: 0,0:13:55.58,0:13:56.61,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:13:57.17,0:13:58.84,Default,,0000,0000,0000,,Мен пейзажды түсіремін.
Dialogue: 0,0:13:59.60,0:14:00.91,Default,,0000,0000,0000,,Такизуки-сенпай
Dialogue: 0,0:14:01.36,0:14:02.47,Default,,0000,0000,0000,,Ол сыртқа шығатынын айтты.
Dialogue: 0,0:14:02.95,0:14:05.12,Default,,0000,0000,0000,,Сонымен не істеп жатырсың?
Dialogue: 0,0:14:06.39,0:14:07.08,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:14:07.44,0:14:08.91,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:14:10.53,0:14:12.68,Default,,0000,0000,0000,,Бұл Каруизавадан
Dialogue: 0,0:14:13.17,0:14:14.67,Default,,0000,0000,0000,,Бұл сүйкімді көрінеді
Dialogue: 0,0:14:19.37,0:14:20.49,Default,,0000,0000,0000,,Такидзуки Сенпай
Dialogue: 0,0:14:20.96,0:14:23.51,Default,,0000,0000,0000,,Иә, сіз осындай нәрсені түсіріп жатырсыз ба?
Dialogue: 0,0:14:32.24,0:14:32.79,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:14:32.96,0:14:34.32,Default,,0000,0000,0000,,Ой, кешіріңіз.
Dialogue: 0,0:14:34.55,0:14:35.83,Default,,0000,0000,0000,,Ештеңе Ештеңе
Dialogue: 0,0:14:36.22,0:14:36.78,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:36.89,0:14:38.78,Default,,0000,0000,0000,,Оның орнына қарбыз жеңіз.Қарбыз
Dialogue: 0,0:14:45.01,0:14:45.67,Default,,0000,0000,0000,,Ыстық, солай емес пе?
Dialogue: 0,0:14:45.81,0:14:46.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:48.10,0:14:49.61,Default,,0000,0000,0000,,Қандай сүйкімді бала.
Dialogue: 0,0:14:50.02,0:14:51.52,Default,,0000,0000,0000,,Менімен кездеспе
Dialogue: 0,0:14:52.10,0:14:53.74,Default,,0000,0000,0000,,Шын жүректен кешірім сұраймыз.
Dialogue: 0,0:14:54.14,0:14:55.29,Default,,0000,0000,0000,,Мен ашуландым
Dialogue: 0,0:14:55.66,0:14:56.66,Default,,0000,0000,0000,,ұқсайды
Dialogue: 0,0:14:57.24,0:14:58.07,Default,,0000,0000,0000,,Себебі
Dialogue: 0,0:14:58.61,0:15:01.45,Default,,0000,0000,0000,,Иә, Ичикамен бірдеңе болды.
Dialogue: 0,0:15:02.07,0:15:03.30,Default,,0000,0000,0000,,Ештеңе жоқ.
Dialogue: 0,0:15:03.80,0:15:06.33,Default,,0000,0000,0000,,Дәлірек айтқанда, олар маған ештеңе жасауға рұқсат бермейді.
Dialogue: 0,0:15:06.93,0:15:08.99,Default,,0000,0000,0000,,Сезімімді Сенпай түсінбейді.
Dialogue: 0,0:15:09.32,0:15:13.65,Default,,0000,0000,0000,,Бала, сен қалағандай болмайды, сондықтан сен опасызсың.
Dialogue: 0,0:15:13.91,0:15:15.06,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:15:15.38,0:15:18.28,Default,,0000,0000,0000,,Сонда Ичиканың сезімін түсінесің бе?
Dialogue: 0,0:15:19.17,0:15:22.08,Default,,0000,0000,0000,,Ичика не ойлап отыр?
Dialogue: 0,0:15:22.19,0:15:24.00,Default,,0000,0000,0000,,Мен бұл планетаға жалғыз келдім деп ойлаймын.
Dialogue: 0,0:15:24.50,0:15:25.98,Default,,0000,0000,0000,,Қазір қалай ойлайсың?
Dialogue: 0,0:15:26.17,0:15:27.95,Default,,0000,0000,0000,,Сіз қалай ойлайсыз және әрекет етесіз?
Dialogue: 0,0:15:28.38,0:15:30.81,Default,,0000,0000,0000,,Мен бұл туралы Киришима-кун ойланып көрді ме деп ойлаймын.
Dialogue: 0,0:15:31.87,0:15:32.85,Default,,0000,0000,0000,,Батыл бол
Dialogue: 0,0:15:33.32,0:15:35.50,Default,,0000,0000,0000,,Өзінің шынайы болмысын ашқан Ичикаға
Dialogue: 0,0:15:35.92,0:15:37.98,Default,,0000,0000,0000,,Сіз маған жауап бердіңіз
Dialogue: 0,0:15:42.59,0:15:45.33,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:15:45.89,0:15:48.11,Default,,0000,0000,0000,,Мен саған ойлан деп айттым.
Dialogue: 0,0:15:48.51,0:15:50.66,Default,,0000,0000,0000,,Ичика үшін не істей аламыз?
Dialogue: 0,0:15:51.20,0:15:52.42,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:15:53.28,0:15:55.18,Default,,0000,0000,0000,,Егер сіз Ичика туралы ойласаңыз
Dialogue: 0,0:15:55.64,0:15:57.01,Default,,0000,0000,0000,,Жауап шығуы керек.
Dialogue: 0,0:16:01.26,0:16:02.30,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:16:03.32,0:16:04.12,Default,,0000,0000,0000,,Ойлау
Dialogue: 0,0:16:07.11,0:16:08.84,Default,,0000,0000,0000,,Иә, қозғалады.
Dialogue: 0,0:16:09.49,0:16:12.50,Default,,0000,0000,0000,,Тоқтамай, алға
Dialogue: 0,0:16:25.73,0:16:28.28,Default,,0000,0000,0000,,Теңіз жігіті, сен не істеп жатырсың?
Dialogue: 0,0:16:28.96,0:16:30.97,Default,,0000,0000,0000,,Мен көптен бері үйге келмедім.
Dialogue: 0,0:16:31.32,0:16:32.36,Default,,0000,0000,0000,,Телефонға жауап бере алмаймын
Dialogue: 0,0:16:33.15,0:16:37.43,Default,,0000,0000,0000,,Сатошидің ақымақ ешқашан оралмайды
Dialogue: 0,0:16:37.55,0:16:40.87,Default,,0000,0000,0000,,Жарайды, үйге қайт, әпке.
Dialogue: 0,0:16:49.29,0:16:51.28,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:16:56.94,0:17:00.49,Default,,0000,0000,0000,,Маған ұнайтын адам
Dialogue: 0,0:17:03.21,0:17:04.10,Default,,0000,0000,0000,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:17:11.28,0:17:13.03,Default,,0000,0000,0000,,Мен FD32 тексердім.
Dialogue: 0,0:17:13.13,0:17:14.59,Default,,0000,0000,0000,,Келесі - BF
Dialogue: 0,0:17:21.76,0:17:23.02,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:17:25.04,0:17:26.14,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:17:27.05,0:17:30.02,Default,,0000,0000,0000,,Сіз қайтадан орын іздейсіз бе?
Егер сіз оны
Dialogue: 0,0:17:30.23,0:17:31.72,Default,,0000,0000,0000,,Э? Иә, иә.
Dialogue: 0,0:17:32.39,0:17:34.80,Default,,0000,0000,0000,,-де тапсаңыз
Dialogue: 0,0:17:34.96,0:17:38.13,Default,,0000,0000,0000,,Қоштасып, планетаңызға қайтып бара жатқандай.
Dialogue: 0,0:17:39.99,0:17:41.28,Default,,0000,0000,0000,,Бұл жақсы, шын мәнінде емес.
Dialogue: 0,0:17:41.89,0:17:43.66,Default,,0000,0000,0000,,Мен үшін бақыт
Dialogue: 0,0:17:44.13,0:17:47.83,Default,,0000,0000,0000,,Себебі мен Кайто-кунды жақсы көремін.
Dialogue: 0,0:17:48.81,0:17:52.68,Default,,0000,0000,0000,,Менің қарсыластарым жоқ
Dialogue: 0,0:17:53.26,0:17:54.15,Default,,0000,0000,0000,,Танигава мырза
Dialogue: 0,0:17:55.34,0:17:57.65,Default,,0000,0000,0000,,Сенпай, байқаған боларсың.
Dialogue: 0,0:17:58.15,0:17:59.36,Default,,0000,0000,0000,,Кайтоның сезімі
Dialogue: 0,0:18:00.16,0:18:02.11,Default,,0000,0000,0000,,Менің түсінуім үшін бұл жеткілікті.
Dialogue: 0,0:18:02.40,0:18:04.51,Default,,0000,0000,0000,,Тіпті үлкендеріңіз де байқаған болар еді.
Dialogue: 0,0:18:05.02,0:18:07.80,Default,,0000,0000,0000,,Мен тағы бір нәрсені байқадым.
Dialogue: 0,0:18:08.35,0:18:12.00,Default,,0000,0000,0000,,Сенпай да Кайтоны жақсы көреді.
Dialogue: 0,0:18:12.95,0:18:13.85,Default,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:18:16.11,0:18:18.00,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:18.69,0:18:19.32,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:18:19.37,0:18:21.35,Default,,0000,0000,0000,,Сіз бөтен адам болғандықтан жақсы емес дейсіз бе?
Dialogue: 0,0:18:21.99,0:18:26.10,Default,,0000,0000,0000,,Қайтоның сезіміне жауап бере алмайсың ба, өйткені мәңгі бірге бола алмайсың ба?
Dialogue: 0,0:18:27.06,0:18:28.49,Default,,0000,0000,0000,,Мұны сылтау ретінде пайдаланыңыз
Dialogue: 0,0:18:28.96,0:18:31.27,Default,,0000,0000,0000,,Сіз Кайто-куннан қашуға ниетіңіз бар ма?
Dialogue: 0,0:18:33.00,0:18:35.33,Default,,0000,0000,0000,,Осылайша қашасың
Dialogue: 0,0:18:35.86,0:18:37.24,Default,,0000,0000,0000,,Мен мұны қазір істеп жатырмын.
Dialogue: 0,0:18:38.78,0:18:40.71,Default,,0000,0000,0000,,Мен ол жерді көргім келеді
Dialogue: 0,0:18:40.75,0:18:42.85,Default,,0000,0000,0000,,Іздеу қиын болып көріну
Dialogue: 0,0:18:43.00,0:18:45.96,Default,,0000,0000,0000,,Ол Кайто-куннан бұрылып, қашып барады.
Dialogue: 0,0:18:46.06,0:18:47.23,Default,,0000,0000,0000,,Өйткені бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:18:47.71,0:18:49.20,Default,,0000,0000,0000,,Мен бұл планетада мәңгі боламын
Dialogue: 0,0:18:49.28,0:18:50.26,Default,,0000,0000,0000,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:18:50.36,0:18:50.89,Default,,0000,0000,0000,,Не
Dialogue: 0,0:18:51.02,0:18:52.47,Default,,0000,0000,0000,,Тек мені жақсы көретініңді айт
Dialogue: 0,0:18:53.87,0:18:55.38,Default,,0000,0000,0000,,Маған неге айтпайсың?
Dialogue: 0,0:18:56.03,0:18:58.05,Default,,0000,0000,0000,,Сіз өзіңіз жақсы көретін адаммен байланыс жасай аласыз.
Dialogue: 0,0:18:58.33,0:18:59.47,Default,,0000,0000,0000,,Бұл жақсы емес
Dialogue: 0,0:19:00.11,0:19:01.56,Default,,0000,0000,0000,,Қанша тілесем де
Dialogue: 0,0:19:02.01,0:19:03.23,Default,,0000,0000,0000,,Сіз нені ала алмайсыз
Dialogue: 0,0:19:03.42,0:19:05.05,Default,,0000,0000,0000,,Дәл сол жерде
Dialogue: 0,0:19:05.40,0:19:06.85,Default,,0000,0000,0000,,Тек қисынды нәрсе
Dialogue: 0,0:19:06.93,0:19:07.97,Default,,0000,0000,0000,,Жаңа ғана қашып кетті
Dialogue: 0,0:19:08.65,0:19:12.49,Default,,0000,0000,0000,,Мен Кайтокунның дәл қазір не істеп жатқанын білмесем де.
Dialogue: 0,0:19:14.62,0:19:18.30,Default,,0000,0000,0000,,Кайто-кун Кайто-кун дегеніміз не?
Dialogue: 0,0:19:18.40,0:19:22.02,Default,,0000,0000,0000,,Соған өзің қара, ақымақ.
Dialogue: 0,0:19:36.67,0:19:37.52,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:39.61,0:19:42.34,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:43.76,0:19:47.36,Default,,0000,0000,0000,,Мені тастап кеткенін көру өте қызық
Dialogue: 0,0:19:47.92,0:19:49.12,Default,,0000,0000,0000,,Қолдайтын кейіп таныту
Dialogue: 0,0:19:49.42,0:19:51.08,Default,,0000,0000,0000,,Мен осылай болғанын көргім келді.
Dialogue: 0,0:19:51.28,0:19:52.54,Default,,0000,0000,0000,,Дәмі нашар.
Dialogue: 0,0:19:52.67,0:19:54.90,Default,,0000,0000,0000,,Кет, ақымақ.
Dialogue: 0,0:19:55.64,0:19:56.97,Default,,0000,0000,0000,,Артқа оралу
Dialogue: 0,0:19:58.97,0:20:00.03,Default,,0000,0000,0000,,Маған жылай берші
Dialogue: 0,0:20:06.39,0:20:07.92,Default,,0000,0000,0000,,Өтінемін, Канна.
Dialogue: 0,0:20:09.31,0:20:10.14,Default,,0000,0000,0000,,Жылама
Dialogue: 0,0:20:15.98,0:20:17.40,Default,,0000,0000,0000,,Мен Кайто-кунды жақсы көремін
Dialogue: 0,0:20:18.98,0:20:20.24,Default,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:20:38.98,0:20:41.88,Default,,0000,0000,0000,,Ағаштар бар, тоғандар бар.
Dialogue: 0,0:20:42.66,0:20:44.80,Default,,0000,0000,0000,,Қызық, онда не бар?
Dialogue: 0,0:21:03.78,0:21:04.86,Default,,0000,0000,0000,,Ал 1-сыныпты Джудзюцу сиқыршысы лауазымына ұсыныс жасауға келетін болсақ, мен оны қуана қабылдаймын.
Dialogue: 0,0:21:05.29,0:21:06.16,Default,,0000,0000,0000,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:21:08.72,0:21:09.94,Default,,0000,0000,0000,,Се Сенпай
Dialogue: 0,0:21:11.06,0:21:11.72,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:21:12.71,0:21:15.14,Default,,0000,0000,0000,,Мен оның керемет екенін бұрыннан білетінмін.
Dialogue: 0,0:21:16.82,0:21:18.54,Default,,0000,0000,0000,,Сіз мені іздедіңіз ғой, солай ма?
Dialogue: 0,0:21:20.15,0:21:20.75,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:21:21.41,0:21:23.42,Default,,0000,0000,0000,,Өзімшіл болғаным үшін кешіріңіз.
Dialogue: 0,0:21:23.48,0:21:26.31,Default,,0000,0000,0000,,Мен, мен үйге баруым керек деп ойладым.
Dialogue: 0,0:21:27.07,0:21:29.80,Default,,0000,0000,0000,,Менің кесірімнен бәрі қиыншылықта.
Dialogue: 0,0:21:30.84,0:21:33.29,Default,,0000,0000,0000,,Бірақ мен үйге барғым келмеді
Dialogue: 0,0:21:34.82,0:21:37.22,Default,,0000,0000,0000,,Танигава мырза мұны маған түсіндірді.
Dialogue: 0,0:21:38.34,0:21:39.60,Default,,0000,0000,0000,,Менің үйге барғым келмейтін себебім
Dialogue: 0,0:21:39.99,0:21:42.08,Default,,0000,0000,0000,,Мен сол жерге барғым келгендіктен ғана емес.
Dialogue: 0,0:21:42.93,0:21:44.95,Default,,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,0:21:46.42,0:21:47.61,Default,,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:21:47.99,0:21:49.46,Default,,0000,0000,0000,,Бөтен планеталық болған дұрыс па?
Dialogue: 0,0:21:51.81,0:21:53.49,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:21:55.45,0:21:56.13,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:57.72,0:21:59.28,Default,,0000,0000,0000,,Мен мойындай аламын ба?
Dialogue: 0,0:22:00.00,0:22:00.69,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:22:01.63,0:22:02.29,Default,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:22:03.32,0:22:04.29,Default,,0000,0000,0000,,Мен мұны өзім жасаймын.
Dialogue: 0,0:22:06.49,0:22:09.61,Default,,0000,0000,0000,,Мен сені сүйемін, мен сені әрқашан сүйдім.
Dialogue: 0,0:22:13.59,0:22:15.03,Default,,0000,0000,0000,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:22:15.43,0:22:17.94,Default,,0000,0000,0000,,Бәлкім, бірінші кездескенімізден
Dialogue: 0,0:22:19.40,0:22:21.65,Default,,0000,0000,0000,,Мен түсінбедім
Dialogue: 0,0:22:22.79,0:22:26.47,Default,,0000,0000,0000,,Бірақ мен саған ғашық болдым
Dialogue: 0,0:22:36.06,0:22:38.62,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:22:39.28,0:22:41.49,Default,,0000,0000,0000,,Өйткені бұл менің бірінші рет болды.
Dialogue: 0,0:22:41.83,0:22:43.60,Default,,0000,0000,0000,,Бұл менің төртінші рет
Dialogue: 0,0:22:44.72,0:22:45.98,Default,,0000,0000,0000,,Бірінші рет бөгетте болды.
Dialogue: 0,0:22:46.85,0:22:48.69,Default,,0000,0000,0000,,Екінші рет кіре берісте құлап қалдым.
Dialogue: 0,0:22:49.55,0:22:52.51,Default,,0000,0000,0000,,Үшінші рет маған құтқарушы бот шабуыл жасады.
Dialogue: 0,0:22:53.36,0:22:54.20,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:22:55.18,0:22:57.39,Default,,0000,0000,0000,,Менің ішімдегі емдік машина
Dialogue: 0,0:22:57.64,0:22:59.19,Default,,0000,0000,0000,,Кайто-кунға жіберу
Dialogue: 0,0:23:00.14,0:23:01.88,Default,,0000,0000,0000,,Жақсы сәйкес келгеніне қуаныштымын.
Dialogue: 0,0:23:02.22,0:23:03.79,Default,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:23:04.66,0:23:06.47,Default,,0000,0000,0000,,Романтикалық емес
Dialogue: 0,0:23:07.02,0:23:08.07,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:23:08.24,0:23:09.44,Default,,0000,0000,0000,,Ол әлі де қолжетімді ме?
Dialogue: 0,0:23:11.25,0:23:12.62,Default,,0000,0000,0000,,Бұл бесінші рет
Dialogue: 0,0:23:40.81,0:23:43.19,Default,,0000,0000,0000,,Өйткені қайғы бар, қуаныш бар.
Dialogue: 0,0:23:43.27,0:23:44.95,Default,,0000,0000,0000,,Біреудің бақытының көлеңкесінде
Dialogue: 0,0:23:45.07,0:23:46.59,Default,,0000,0000,0000,,Біреу көз жасын төгеді
Dialogue: 0,0:23:46.68,0:23:47.98,Default,,0000,0000,0000,,Сіз мұны білсеңіз де
Dialogue: 0,0:23:48.08,0:23:49.82,Default,,0000,0000,0000,,Күшті сезімдерге қарсы тұру мүмкін емес
Dialogue: 0,0:00:26.96,0:00:29.74,Default,,0000,0000,0000,,...
Dialogue: 0,0:06:32.86,0:06:34.58,Default,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:06:34.63,0:06:35.08,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:12:16.03,0:12:17.94,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:38.74,0:01:41.94,Default,,0000,0000,0000,,Теңіз самалы жүзіңнен соғады
Dialogue: 0,0:01:42.71,0:01:45.83,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:01:46.52,0:01:50.51,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:01:51.23,0:01:54.14,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:01:54.25,0:01:57.54,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:01:58.39,0:02:01.56,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:02:02.01,0:02:08.68,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:02:10.24,0:02:17.15,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:02:17.31,0:02:23.45,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:02:24.44,0:02:28.14,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:02:28.67,0:02:32.41,Default,,0000,0000,0000,,Бізді мәңгі күту
Dialogue: 0,0:02:32.49,0:02:39.66,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:02:39.97,0:02:43.89,Default,,0000,0000,0000,,Ешқашан кетпейтін алдын ала ескерту
Dialogue: 0,0:02:44.12,0:02:48.61,Default,,0000,0000,0000,,Қараған объективтің үстінен секіріңіз
Dialogue: 0,0:02:48.93,0:02:54.04,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:01:38.74,0:01:41.94,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:01:43.18,0:01:45.83,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:01:46.52,0:01:50.51,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:01:51.23,0:01:54.14,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:01:54.25,0:01:57.54,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:58.39,0:02:01.56,Default,,0000,0000,0000,,Түсінде жатқан түсте
Dialogue: 0,0:02:02.01,0:02:08.68,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:02:10.57,0:02:17.15,Default,,0000,0000,0000,,Күтпеген сөз, күтпеген күнделікті өмір
Dialogue: 0,0:02:17.31,0:02:23.45,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:02:24.44,0:02:28.14,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:02:28.67,0:02:32.41,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:02:32.49,0:02:39.66,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:39.97,0:02:43.89,Default,,0000,0000,0000,,Жауапсыз қозу сезімі
Dialogue: 0,0:02:44.12,0:02:48.61,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:02:48.93,0:02:54.04,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Мен мұны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Еш ойланбай, қаш
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының иісімен
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,Душ сияқты
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Ол түсті шығарды.
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Оңтүстік және терең ойлар
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Оған назар аударудың қажеті жоқ.
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Накагидің мәңгілік өмірі
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Болашақта шексіз еске алу үшін тіркелу
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Сенде ғана керемет бар
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:23:51.32,0:23:57.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
