Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:20.07,0:02:29.94,Default,,0000,0000,0000,,Бұл субтитр көзі коммерциялық пайдалануға тыйым салынған субтитрлер тобының өндірісі, жеткізу алмасуы болып табылады.
Dialogue: 0,0:02:20.07,0:02:29.94,Default,,0000,0000,0000,,: ： яя : Сюра :
Dialogue: 0,0:00:07.92,0:00:09.27,Default,,0000,0000,0000,,Бірнеше сәт бұрын гуль—
Dialogue: 0,0:00:11.85,0:00:15.03,Default,,0000,0000,0000,,Сонымен, жазғы демалыс болды ма?
Dialogue: 0,0:00:15.38,0:00:17.04,Default,,0000,0000,0000,,Хора Ринон
Dialogue: 0,0:00:17.77,0:00:19.88,Default,,0000,0000,0000,,Енді мені мазалама
Dialogue: 0,0:00:23.61,0:00:26.12,Default,,0000,0000,0000,,Қолыңнан келмесе, қытық.
Dialogue: 0,0:00:27.81,0:00:29.75,Default,,0000,0000,0000,,Қайырлы таң Кайто-кун
Dialogue: 0,0:00:30.79,0:00:32.40,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:00:35.81,0:00:37.87,Default,,0000,0000,0000,,Алғы сөз түсіп қалған Сама апа
Dialogue: 0,0:00:38.54,0:00:39.79,Default,,0000,0000,0000,,Менің лайықсыз інім.
Dialogue: 0,0:00:40.33,0:00:42.16,Default,,0000,0000,0000,,Жазғы демалыстың бірінші күнінен
Dialogue: 0,0:00:42.37,0:00:43.46,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:00:44.09,0:00:46.04,Default,,0000,0000,0000,,Сіз өзіңіздің ұтымдылығыңызды сақтай аласыз ба?
Dialogue: 0,0:00:46.32,0:00:49.63,Default,,0000,0000,0000,,Шынымды айтсам, мен өзіме сенімді емеспін
Dialogue: 0,0:02:38.91,0:02:39.68,Default,,0000,0000,0000,,Кайто-кун
Dialogue: 0,0:02:39.78,0:02:41.07,Default,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:02:42.14,0:02:44.10,Default,,0000,0000,0000,,Сіз камераны сатып алдыңыз ба?
Dialogue: 0,0:02:44.73,0:02:47.42,Default,,0000,0000,0000,,үшін бұл өте ескі сияқты
Dialogue: 0,0:02:48.23,0:02:49.75,Default,,0000,0000,0000,,Үйдегі қорада болды.
Dialogue: 0,0:02:50.07,0:02:52.38,Default,,0000,0000,0000,,Менің ойымша, бұл өлген атамдікі шығар.
Dialogue: 0,0:02:53.30,0:02:54.99,Default,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:02:55.17,0:02:56.86,Default,,0000,0000,0000,,Эй, эй, мен оны қалай пайдаланамын?
Dialogue: 0,0:02:57.47,0:02:58.26,Default,,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:02:58.80,0:03:00.14,Default,,0000,0000,0000,,Осы фильмді орнатыңыз
Dialogue: 0,0:03:00.46,0:03:03.39,Default,,0000,0000,0000,,Тек объективті фокустап, ысырманы басыңыз
Dialogue: 0,0:03:04.76,0:03:06.25,Default,,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:03:06.55,0:03:07.32,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:03:09.06,0:03:09.86,Default,,0000,0000,0000,,Жабу
Dialogue: 0,0:03:13.09,0:03:15.25,Default,,0000,0000,0000,,Жазғы демалыстың бірінші күнінен
Dialogue: 0,0:03:15.74,0:03:17.98,Default,,0000,0000,0000,,Сіз әлдеқайда ашық болдыңыз.
Dialogue: 0,0:03:18.11,0:03:19.05,Default,,0000,0000,0000,,Уфуфуфуфуфу
Dialogue: 0,0:03:19.60,0:03:21.61,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:03:22.61,0:03:23.48,Default,,0000,0000,0000,,Чису
Dialogue: 0,0:03:23.77,0:03:24.82,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:03:25.74,0:03:27.60,Default,,0000,0000,0000,,Не істеп жатырсың, Кайто-кун?
Dialogue: 0,0:03:28.94,0:03:30.06,Default,,0000,0000,0000,,Ол икемді ме?
Dialogue: 0,0:03:30.41,0:03:34.41,Default,,0000,0000,0000,,Енді көңілді фильмдер түсіруді бастайық.
Dialogue: 0,0:03:37.39,0:03:40.14,Default,,0000,0000,0000,,Эй Уми, біз бүгін нені суретке түсіреміз?
Dialogue: 0,0:03:40.33,0:03:41.19,Default,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:03:41.55,0:03:43.66,Default,,0000,0000,0000,,Сценарийге жауапты адам Лимон-сенпай.
Dialogue: 0,0:03:44.03,0:03:48.58,Default,,0000,0000,0000,,Жарайды, бүгінгі кітап дайын.
Dialogue: 0,0:03:48.70,0:03:49.56,Default,,0000,0000,0000,,Бүгінгі бөлім
Dialogue: 0,0:03:49.95,0:03:52.46,Default,,0000,0000,0000,,Менің өндіріс стилім - Гонконг стилі
Dialogue: 0,0:03:53.40,0:03:55.17,Default,,0000,0000,0000,,Бүгін түсірілетін фильмнің мазмұны қандай?
Dialogue: 0,0:03:55.31,0:03:56.88,Default,,0000,0000,0000,,Сол күні таңертең шешіңіз
Dialogue: 0,0:03:57.38,0:03:59.76,Default,,0000,0000,0000,,Бұл кездейсоқ.
Dialogue: 0,0:04:00.04,0:04:01.47,Default,,0000,0000,0000,,Мен киімімді ауыстырып бітірдім.
Dialogue: 0,0:04:02.99,0:04:06.70,Default,,0000,0000,0000,,Уау, бұл саған керемет көрінеді.
Dialogue: 0,0:04:06.77,0:04:07.32,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:04:07.64,0:04:09.27,Default,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:04:09.43,0:04:11.22,Default,,0000,0000,0000,,Бұл костюмде не болды?
Dialogue: 0,0:04:11.52,0:04:13.85,Default,,0000,0000,0000,,Бұл көп ақша жұмсайтын сияқты.
Dialogue: 0,0:04:14.10,0:04:16.89,Default,,0000,0000,0000,,Мен мектебімдегі косплей клубынан көмек сұрадым.
Dialogue: 0,0:04:17.21,0:04:18.86,Default,,0000,0000,0000,,Осындай үйірме болды ма?
Dialogue: 0,0:04:19.45,0:04:20.02,Default,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:04:20.49,0:04:22.68,Default,,0000,0000,0000,,Мен білмеймін. Бұл біртүрлі емес.
Dialogue: 0,0:04:23.40,0:04:25.61,Default,,0000,0000,0000,,Бұл сізге шынымен сәйкес келеді.
Dialogue: 0,0:04:26.33,0:04:27.59,Default,,0000,0000,0000,,жақсы болар еді.
Dialogue: 0,0:04:30.21,0:04:34.73,Default,,0000,0000,0000,,Бүгін түсіретін мазмұн - кейіпкердің баламен алғаш танысуы.
Dialogue: 0,0:04:34.91,0:04:36.29,Default,,0000,0000,0000,,Бұл махаббат хикаясы
Dialogue: 0,0:04:36.37,0:04:37.86,Default,,0000,0000,0000,,Өте жақсы болуы мүмкін
Dialogue: 0,0:04:37.94,0:04:41.29,Default,,0000,0000,0000,,Айтпақшы, кейіпкер жат жерлік.
Dialogue: 0,0:04:41.54,0:04:43.51,Default,,0000,0000,0000,,жаңашыл.
Dialogue: 0,0:04:43.78,0:04:45.35,Default,,0000,0000,0000,,Міне, бұл костюм.
Dialogue: 0,0:04:45.82,0:04:47.97,Default,,0000,0000,0000,,Жерге қонған батыр қыз
Dialogue: 0,0:04:48.15,0:04:51.58,Default,,0000,0000,0000,,Жердегі баламен тағдырлы кездесу
Dialogue: 0,0:04:52.73,0:04:54.77,Default,,0000,0000,0000,,Барлық жолдар жарнамаланған.
Dialogue: 0,0:04:54.99,0:04:57.00,Default,,0000,0000,0000,,Қалғанын директорға тапсырамын.
Dialogue: 0,0:04:57.38,0:04:58.87,Default,,0000,0000,0000,,Бұл абсурд.
Dialogue: 0,0:04:59.16,0:05:01.95,Default,,0000,0000,0000,,Сонымен, жердегі баланың рөлі
Dialogue: 0,0:05:02.32,0:05:04.68,Default,,0000,0000,0000,,Мен камераны бұруым керек.
Dialogue: 0,0:05:05.45,0:05:06.87,Default,,0000,0000,0000,,Еріксіз мен бе?
Dialogue: 0,0:05:06.97,0:05:09.53,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы Менің ойымша, бұл өте жақсы
Dialogue: 0,0:05:09.60,0:05:12.73,Default,,0000,0000,0000,,Күте тұрыңыз, мен сахна артында көмектесемін.
Dialogue: 0,0:05:12.86,0:05:13.88,Default,,0000,0000,0000,,Исигаки мырза
Dialogue: 0,0:05:14.65,0:05:16.84,Default,,0000,0000,0000,,Жағдайға сәйкес жауап беру
Dialogue: 0,0:05:17.38,0:05:19.67,Default,,0000,0000,0000,,Иә, сайт тірі нәрсе.
Dialogue: 0,0:05:19.94,0:05:21.16,Default,,0000,0000,0000,,Таныс ауыз
Dialogue: 0,0:05:21.61,0:05:26.01,Default,,0000,0000,0000,,Жақсы емес пе, өйткені мен Такизуки-сенпай сияқты сұлу әйелді кездестіре аламын ба?
Dialogue: 0,0:05:26.38,0:05:29.34,Default,,0000,0000,0000,,Бұл ұмытылмайтын естелік болары сөзсіз.
Dialogue: 0,0:05:29.46,0:05:31.70,Default,,0000,0000,0000,,Бұл менің өмірімнің шыңы ма?
Dialogue: 0,0:05:31.95,0:05:33.99,Default,,0000,0000,0000,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:05:34.08,0:05:35.87,Default,,0000,0000,0000,,Көңілді отырсың ғой, солай ма?
Dialogue: 0,0:05:36.00,0:05:37.99,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:38.96,0:05:40.40,Default,,0000,0000,0000,,Бөтеннің рөлі
Dialogue: 0,0:05:40.70,0:05:41.76,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:05:42.26,0:05:43.93,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:05:44.80,0:05:46.14,Default,,0000,0000,0000,,Йошитто
Dialogue: 0,0:05:46.86,0:05:49.17,Default,,0000,0000,0000,,Кайто-кун, бәрі дайын.
Dialogue: 0,0:05:49.59,0:05:50.41,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:05:50.49,0:05:51.43,Default,,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:05:59.83,0:06:01.37,Default,,0000,0000,0000,,Міне, жер
Dialogue: 0,0:06:02.07,0:06:04.51,Default,,0000,0000,0000,,Даму деңгейі F шекаралық планета
Dialogue: 0,0:06:05.08,0:06:07.46,Default,,0000,0000,0000,,Ғарышты зерттеу енді ғана басталды.
Dialogue: 0,0:06:07.59,0:06:10.60,Default,,0000,0000,0000,,Адамдар жеткен айды ай деп атайды.
Dialogue: 0,0:06:10.77,0:06:12.58,Default,,0000,0000,0000,,Тек осы жұлдыздың серіктері
Dialogue: 0,0:06:12.91,0:06:15.30,Default,,0000,0000,0000,,Жолдар өте шынайы.
Dialogue: 0,0:06:15.64,0:06:17.23,Default,,0000,0000,0000,,Бұл біраз түсініксіз, бірақ
Dialogue: 0,0:06:17.73,0:06:19.79,Default,,0000,0000,0000,,Келесі, Ишигаки мырза, кіріңіз.
Dialogue: 0,0:06:20.11,0:06:20.91,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:22.60,0:06:26.15,Default,,0000,0000,0000,,Мен бұл планетаға бір себеппен келдім.
Dialogue: 0,0:06:26.33,0:06:29.01,Default,,0000,0000,0000,,Мен осы жердемін
Dialogue: 0,0:06:29.11,0:06:30.48,Default,,0000,0000,0000,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:06:30.60,0:06:32.34,Default,,0000,0000,0000,,О, сен
Dialogue: 0,0:06:32.77,0:06:34.28,Default,,0000,0000,0000,,Мен сені іздедім
Dialogue: 0,0:06:34.73,0:06:36.54,Default,,0000,0000,0000,,мен
Dialogue: 0,0:06:36.94,0:06:39.38,Default,,0000,0000,0000,,Параметр енді сіз бұрыннан кездесіп қойғансыз.
Dialogue: 0,0:06:39.82,0:06:40.70,Default,,0000,0000,0000,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:06:41.46,0:06:43.50,Default,,0000,0000,0000,,Мен сені бақылап жүрмін
Dialogue: 0,0:06:43.68,0:06:46.48,Default,,0000,0000,0000,,Демек, сіз бөтен адамсыз
Dialogue: 0,0:06:48.03,0:06:50.56,Default,,0000,0000,0000,,Ал мен қара киімді адаммын
Dialogue: 0,0:06:51.36,0:06:53.20,Default,,0000,0000,0000,,Қара киімді ерлер
Dialogue: 0,0:06:53.29,0:06:55.11,Default,,0000,0000,0000,,Жоооу
Dialogue: 0,0:06:59.19,0:07:00.48,Default,,0000,0000,0000,,Жарайды, тоқтат
Dialogue: 0,0:07:00.88,0:07:03.66,Default,,0000,0000,0000,,Керемет болды, Ичика Ишигаки-кун.
Dialogue: 0,0:07:04.21,0:07:06.89,Default,,0000,0000,0000,,Жоқ, қызып кетті.
Dialogue: 0,0:07:07.11,0:07:09.36,Default,,0000,0000,0000,,Қарсылас қайтыс болды
Dialogue: 0,0:07:09.57,0:07:11.59,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:07:13.75,0:07:15.86,Default,,0000,0000,0000,,Сенпай, бұл керемет импровизация болды.
Dialogue: 0,0:07:16.38,0:07:19.29,Default,,0000,0000,0000,,Ахххххх
Dialogue: 0,0:07:19.67,0:07:20.86,Default,,0000,0000,0000,,және қазір
Dialogue: 0,0:07:21.18,0:07:22.85,Default,,0000,0000,0000,,Себебі фильмнің мазмұны өзгерді
Dialogue: 0,0:07:23.32,0:07:25.01,Default,,0000,0000,0000,,Лимон-сенпайдың ойларын күтемін.
Dialogue: 0,0:07:25.48,0:07:27.67,Default,,0000,0000,0000,,Кез келген нәрсе Батыр қыз қаша бастайды
Dialogue: 0,0:07:28.17,0:07:32.25,Default,,0000,0000,0000,,Қара киім киген ерлердің қызу қууы басталады.
Dialogue: 0,0:07:33.14,0:07:34.11,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:35.27,0:07:36.66,Default,,0000,0000,0000,,Мұнда қалай?
Dialogue: 0,0:07:38.18,0:07:42.06,Default,,0000,0000,0000,,Мұндағы көрініс Алда тоған да бар.
Dialogue: 0,0:07:42.36,0:07:45.18,Default,,0000,0000,0000,,Қарашы, Сенпай, сен бұрын айттың ғой, солай ма?
Dialogue: 0,0:07:45.54,0:07:46.91,Default,,0000,0000,0000,,Менің барғым келетін жер бар
Dialogue: 0,0:07:48.07,0:07:50.51,Default,,0000,0000,0000,,Ағаштар бар, тоғандар бар.
Dialogue: 0,0:07:51.40,0:07:53.87,Default,,0000,0000,0000,,Бұл қарапайым емес орын.
Dialogue: 0,0:07:54.51,0:07:56.34,Default,,0000,0000,0000,,Олай болса іздеп көрейік.
Dialogue: 0,0:07:57.12,0:07:58.09,Default,,0000,0000,0000,,Дұрыс па, солай емес пе?
Dialogue: 0,0:07:59.08,0:08:00.82,Default,,0000,0000,0000,,Бірақ мен барғым келеді
Dialogue: 0,0:08:02.19,0:08:05.16,Default,,0000,0000,0000,,Кайто-кун, сен мені есіңе түсірдің.
Dialogue: 0,0:08:05.84,0:08:07.86,Default,,0000,0000,0000,,Мен осындай жерді таңдадым.
Dialogue: 0,0:08:08.08,0:08:09.52,Default,,0000,0000,0000,,Басқаша көрінеді.
Dialogue: 0,0:08:09.67,0:08:10.47,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:10.86,0:08:11.98,Default,,0000,0000,0000,,Ондай нәрсе жоқ
Dialogue: 0,0:08:13.55,0:08:14.32,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:08:15.81,0:08:17.39,Default,,0000,0000,0000,,Мен сені тағы іздеймін.
Dialogue: 0,0:08:19.39,0:08:23.22,Default,,0000,0000,0000,,мынау мынау мынау мынау
Dialogue: 0,0:08:23.34,0:08:26.52,Default,,0000,0000,0000,,Эй, тоқташы.
Dialogue: 0,0:08:28.91,0:08:32.24,Default,,0000,0000,0000,,Канна: Ичика-сенпайға және басқаларға сусын әкел.
Dialogue: 0,0:08:36.39,0:08:38.59,Default,,0000,0000,0000,,О, не?
Dialogue: 0,0:08:40.02,0:08:42.21,Default,,0000,0000,0000,,Маған біраздан бері қызық болды.
Dialogue: 0,0:08:42.75,0:08:45.47,Default,,0000,0000,0000,,Тецуро, сен менің сезімімді білесің.
Dialogue: 0,0:08:46.13,0:08:47.44,Default,,0000,0000,0000,,Өйткені бұл анық
Dialogue: 0,0:08:49.56,0:08:50.51,Default,,0000,0000,0000,,Қашаннан бері
Dialogue: 0,0:08:50.81,0:08:51.67,Default,,0000,0000,0000,,Көк, көк…
Dialogue: 0,0:08:52.79,0:08:55.65,Default,,0000,0000,0000,,Мүмкін мені қолдайтын шығарсың?
Dialogue: 0,0:08:57.27,0:08:58.73,Default,,0000,0000,0000,,Өйткені біз бала кезден доспыз
Dialogue: 0,0:09:01.17,0:09:02.04,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:03.38,0:09:05.74,Default,,0000,0000,0000,,Тецуро, мүмкін болса, маған хабарлаңыз.
Dialogue: 0,0:09:05.87,0:09:06.96,Default,,0000,0000,0000,,Мен сені қолдаймын
Dialogue: 0,0:09:10.14,0:09:11.96,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:09:14.24,0:09:15.78,Default,,0000,0000,0000,,Ауырды, Китахара-сан.
Dialogue: 0,0:09:16.33,0:09:19.88,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:09:20.31,0:09:23.31,Default,,0000,0000,0000,,Дайын, түсіруді жалғастырыңыз.
Dialogue: 0,0:09:25.60,0:09:27.04,Default,,0000,0000,0000,,Қуғыншылардан қашу
Dialogue: 0,0:09:27.29,0:09:29.03,Default,,0000,0000,0000,,Кейіпкер ғарыш кемесіне оралады
Dialogue: 0,0:09:29.43,0:09:31.22,Default,,0000,0000,0000,,Онда мен достарыммен кездесемін.
Dialogue: 0,0:09:31.57,0:09:32.16,Default,,0000,0000,0000,,Жарайды, киемін.
Dialogue: 0,0:09:32.54,0:09:33.78,Default,,0000,0000,0000,,Мұны кім жасайды?
Dialogue: 0,0:09:34.10,0:09:34.97,Default,,0000,0000,0000,,Бұл бала
Dialogue: 0,0:09:36.16,0:09:36.79,Default,,0000,0000,0000,,Ринон
Dialogue: 0,0:09:36.89,0:09:38.08,Default,,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:09:38.80,0:09:42.25,Default,,0000,0000,0000,,Бұл бала ғарыш кемесіндегі бионикалық терминал ретінде орнатылған.
Dialogue: 0,0:09:42.68,0:09:45.07,Default,,0000,0000,0000,,Саған көп рахмет, Ичика.
Dialogue: 0,0:09:45.36,0:09:46.95,Default,,0000,0000,0000,,Иә, жақсы
Dialogue: 0,0:09:48.04,0:09:49.61,Default,,0000,0000,0000,,Жарайды, бастайық.
Dialogue: 0,0:09:55.58,0:09:57.99,Default,,0000,0000,0000,,Лимон-сенпай, дайындық аяқталды.
Dialogue: 0,0:09:58.51,0:09:59.42,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:09:59.90,0:10:02.55,Default,,0000,0000,0000,,Мен енді директордың кім екенін білмеймін.
Dialogue: 0,0:10:02.78,0:10:04.48,Default,,0000,0000,0000,,Камераны дайындау
Dialogue: 0,0:10:04.65,0:10:05.96,Default,,0000,0000,0000,,Иә, ол дайын.
Dialogue: 0,0:10:06.31,0:10:08.18,Default,,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:10:09.20,0:10:11.38,Default,,0000,0000,0000,,Ринон, менің қуғыншым келе жатыр.
Dialogue: 0,0:10:11.51,0:10:13.12,Default,,0000,0000,0000,,Маған көмектесіңізші
Dialogue: 0,0:10:14.19,0:10:15.96,Default,,0000,0000,0000,,Бұл болмайды.
Dialogue: 0,0:10:16.53,0:10:19.62,Default,,0000,0000,0000,,Неге?
Dialogue: 0,0:10:19.83,0:10:23.98,Default,,0000,0000,0000,,Ағам үшін кек аламын.
Dialogue: 0,0:10:30.22,0:10:32.48,Default,,0000,0000,0000,,Жарайды, тоқтат
Dialogue: 0,0:10:32.86,0:10:36.21,Default,,0000,0000,0000,,Бұл керемет Ичика Ишигаки Риннон болды
Dialogue: 0,0:10:37.58,0:10:39.72,Default,,0000,0000,0000,,Неге рұқсатсыз басып кірдің?
Dialogue: 0,0:10:41.23,0:10:43.62,Default,,0000,0000,0000,,Актер ретінде дастан ба?
Dialogue: 0,0:10:43.87,0:10:45.74,Default,,0000,0000,0000,,Сізді бұған тым қызықтыратын шығар.
Dialogue: 0,0:10:45.98,0:10:49.12,Default,,0000,0000,0000,,Енді не істейсіз?
Dialogue: 0,0:10:49.53,0:10:52.62,Default,,0000,0000,0000,,Шешілді, мен қазір ойланамын.
Dialogue: 0,0:10:55.52,0:10:56.82,Default,,0000,0000,0000,,Тұратын жер жоқ
Dialogue: 0,0:10:57.29,0:10:59.46,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:10:59.67,0:11:01.99,Default,,0000,0000,0000,,Олай болса, менің үйіме келгің келе ме?
Dialogue: 0,0:11:02.78,0:11:06.58,Default,,0000,0000,0000,,Мен жалғыз тұрамын, үйде қосымша бөлме бар.
Dialogue: 0,0:11:06.98,0:11:07.98,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:11:10.68,0:11:13.78,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:11:14.21,0:11:14.93,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:15.56,0:11:16.58,Default,,0000,0000,0000,,Жарайды, тоқтат
Dialogue: 0,0:11:18.51,0:11:20.85,Default,,0000,0000,0000,,Ақырында біз негізгі мәселеге қайта оралдық.
Dialogue: 0,0:11:21.52,0:11:22.34,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:24.18,0:11:25.24,Default,,0000,0000,0000,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:11:26.39,0:11:30.02,Default,,0000,0000,0000,,Мен мұны білмей тұрып, мен актер болдым, камерамен жұмыс істемедім.
Dialogue: 0,0:11:30.34,0:11:33.77,Default,,0000,0000,0000,,Жарайды, өйткені мен Ичика-сенпайдың серіктесімін.
Dialogue: 0,0:11:33.92,0:11:35.61,Default,,0000,0000,0000,,Мен сенен мұны әдейі жасайды деп күтпедім.
Dialogue: 0,0:11:36.46,0:11:37.40,Default,,0000,0000,0000,,О… Ах…
Dialogue: 0,0:11:38.97,0:11:41.38,Default,,0000,0000,0000,,Кайто-кун сенің серігің болды.
Dialogue: 0,0:11:42.08,0:11:43.07,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:11:43.57,0:11:46.35,Default,,0000,0000,0000,,Енді екеуіңнің тағдырларың не болады деп ойлайсыңдар?
Dialogue: 0,0:11:46.45,0:11:49.78,Default,,0000,0000,0000,,Ал, мен білмеймін.
Dialogue: 0,0:11:50.40,0:11:54.89,Default,,0000,0000,0000,,Олай болса, қалай ойлайсыңдар, аға буын өкілдері?
Dialogue: 0,0:11:57.39,0:11:59.95,Default,,0000,0000,0000,,Бақытты болғанымды қалаймын.
Dialogue: 0,0:12:01.66,0:12:02.58,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:04.25,0:12:05.79,Default,,0000,0000,0000,,Сонымен…
Dialogue: 0,0:12:10.41,0:12:14.16,Default,,0000,0000,0000,,Өйткені режиссер де, камера да Лимон-сенпай.
Dialogue: 0,0:12:15.23,0:12:17.27,Default,,0000,0000,0000,,Бұдан былай не болады?
Dialogue: 0,0:12:21.15,0:12:22.64,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:12:23.41,0:12:24.57,Default,,0000,0000,0000,,Мен көптен бері өлі болсам да
Dialogue: 0,0:12:24.82,0:12:26.39,Default,,0000,0000,0000,,Ыстық су жақсы болды.
Түсірілім ертең
Dialogue: 0,0:12:28.30,0:12:29.82,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:30.17,0:12:33.11,Default,,0000,0000,0000,,Лимон-сенпайға байланысты сияқты.
Dialogue: 0,0:12:33.77,0:12:34.29,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:35.01,0:12:36.66,Default,,0000,0000,0000,,Мұны маған Лимон-сенпай айтты.
Dialogue: 0,0:12:37.20,0:12:39.74,Default,,0000,0000,0000,,Кейіпкердің жердегі өмірге бейімделуі.
Dialogue: 0,0:12:39.99,0:12:41.33,Default,,0000,0000,0000,,Мүмкіндігінше көп суретке түсіріңіз
Dialogue: 0,0:12:42.47,0:12:45.48,Default,,0000,0000,0000,,Мұндай жерлерде суретке түспеңіз.
Dialogue: 0,0:12:46.15,0:12:46.90,Default,,0000,0000,0000,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:12:47.37,0:12:47.94,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:48.54,0:12:49.99,Default,,0000,0000,0000,,Бұл фильм туралы.
Dialogue: 0,0:12:50.65,0:12:53.68,Default,,0000,0000,0000,,Кейто кейіпкердің шын тұлғасын білсе, не істейді?
Dialogue: 0,0:12:54.83,0:12:57.37,Default,,0000,0000,0000,,Лимон-сенпай осылай ойлайды.
Dialogue: 0,0:12:57.38,0:12:59.25,Default,,0000,0000,0000,,Кайто не істер еді?
Dialogue: 0,0:12:59.55,0:13:00.34,Default,,0000,0000,0000,,Үйрет бізге.
Dialogue: 0,0:13:00.91,0:13:04.10,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:13:04.32,0:13:06.33,Default,,0000,0000,0000,,Олар – Құдайдың үкімі еді.
Dialogue: 0,0:13:07.23,0:13:09.89,Default,,0000,0000,0000,,Қызық, мені ғарышқа алып кете ала ма?
Dialogue: 0,0:13:10.26,0:13:12.24,Default,,0000,0000,0000,,Өйткені ережелер бар
Dialogue: 0,0:13:12.25,0:13:12.77,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:13.76,0:13:16.25,Default,,0000,0000,0000,,Басқа планетадан келген адаммен бірге болған дұрыс.
Dialogue: 0,0:13:16.75,0:13:19.58,Default,,0000,0000,0000,,Иә, егер сіз біртүрлі сұйықтықты шығармасаңыз.
Dialogue: 0,0:13:19.65,0:13:20.87,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:13:20.97,0:13:23.06,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:13:23.58,0:13:25.42,Default,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:13:27.33,0:13:28.36,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:13:28.90,0:13:31.04,Default,,0000,0000,0000,,Сол аға
Dialogue: 0,0:13:31.21,0:13:32.48,Default,,0000,0000,0000,,Мен саған шай әкелейін.
Dialogue: 0,0:13:34.19,0:13:35.09,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:13:36.60,0:13:38.30,Default,,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:13:42.99,0:13:43.91,Default,,0000,0000,0000,,Иә Танигава
Dialogue: 0,0:13:44.51,0:13:45.97,Default,,0000,0000,0000,,О, Мио, И
Dialogue: 0,0:13:46.67,0:13:48.36,Default,,0000,0000,0000,,Өйткені, түсірілім болған жоқ.
Dialogue: 0,0:13:48.73,0:13:49.85,Default,,0000,0000,0000,,Бұл жаңбыр.
Dialogue: 0,0:13:51.52,0:13:52.78,Default,,0000,0000,0000,,Иә, түсінемін.
Dialogue: 0,0:13:53.29,0:13:54.32,Default,,0000,0000,0000,,Мен сізге қайта хабарласамын.
Dialogue: 0,0:13:54.62,0:13:55.24,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:14:01.36,0:14:02.68,Default,,0000,0000,0000,,Сіз не туралы айттыңыз?
Dialogue: 0,0:14:03.00,0:14:03.84,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:14:04.42,0:14:05.87,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:14:05.96,0:14:06.38,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:06.93,0:14:10.09,Default,,0000,0000,0000,,Такизуки-сенпай, мен мұнда тұруға үйреніп қалдым.
Dialogue: 0,0:14:10.53,0:14:11.70,Default,,0000,0000,0000,,Иә, әлдеқашан.
Dialogue: 0,0:14:12.05,0:14:14.63,Default,,0000,0000,0000,,Бірақ, Сенпай, сен сәл басқашасың.
Dialogue: 0,0:14:14.93,0:14:17.02,Default,,0000,0000,0000,,Мен шоколад дәмі бар карри жасаймын.
Dialogue: 0,0:14:17.09,0:14:18.18,Default,,0000,0000,0000,,Не, жоқ?
Dialogue: 0,0:14:18.63,0:14:19.92,Default,,0000,0000,0000,,Ал, сәл ғана.
Dialogue: 0,0:14:20.37,0:14:21.66,Default,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:14:22.51,0:14:24.03,Default,,0000,0000,0000,,А, мен көбірек ингредиенттер сатып алуым керек.
Dialogue: 0,0:14:24.52,0:14:26.68,Default,,0000,0000,0000,,Ал, мен үйге қайтып бара жатып супермаркетке барамын.
Dialogue: 0,0:14:27.68,0:14:29.82,Default,,0000,0000,0000,,Ойлап қарасақ, ұлпаларымыз азайып бара жатыр еді.
Dialogue: 0,0:14:29.92,0:14:30.87,Default,,0000,0000,0000,,Сондай-ақ жуғыш зат
Dialogue: 0,0:14:31.16,0:14:32.95,Default,,0000,0000,0000,,Олай болса, дәріханаға барайық.
Dialogue: 0,0:14:33.17,0:14:33.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:44.95,0:14:46.84,Default,,0000,0000,0000,,Иә, мырза.
Dialogue: 0,0:14:49.30,0:14:49.85,Default,,0000,0000,0000,,Таникава
Dialogue: 0,0:14:50.35,0:14:54.85,Default,,0000,0000,0000,,Сәлеметсіз бе, анам саған әкеліп бер деді.
Dialogue: 0,0:14:55.86,0:14:56.51,Default,,0000,0000,0000,,Нозавана
Dialogue: 0,0:14:56.73,0:14:58.67,Default,,0000,0000,0000,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:14:58.80,0:15:00.73,Default,,0000,0000,0000,,Уау, өте көп
Dialogue: 0,0:15:03.42,0:15:04.36,Default,,0000,0000,0000,,О, ммм.
Dialogue: 0,0:15:04.91,0:15:06.10,Default,,0000,0000,0000,,Кайто-кун, бұл қиын.
Dialogue: 0,0:15:06.38,0:15:07.46,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:13.49,0:15:14.88,Default,,0000,0000,0000,,Бұл үй ескі
Dialogue: 0,0:15:15.75,0:15:17.44,Default,,0000,0000,0000,,Ауа-райы ашылғанда, төбені қараймын.
Dialogue: 0,0:15:17.93,0:15:20.02,Default,,0000,0000,0000,,Кешіріңіз, мен таң қалдым.
Dialogue: 0,0:15:20.32,0:15:22.28,Default,,0000,0000,0000,,Бұл өте жиі бола бермейді.
Dialogue: 0,0:15:23.92,0:15:25.39,Default,,0000,0000,0000,,О, Танигава-сан
Dialogue: 0,0:15:25.56,0:15:27.43,Default,,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:15:27.63,0:15:31.16,Default,,0000,0000,0000,,Мен айтпауым керек, өтінемін, өтінемін.
Dialogue: 0,0:15:31.95,0:15:34.81,Default,,0000,0000,0000,,Иә, қаласаңыз, түскі асты бірге ішейік.
Dialogue: 0,0:15:37.57,0:15:39.02,Default,,0000,0000,0000,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:15:39.43,0:15:41.05,Default,,0000,0000,0000,,Иә, онда
Dialogue: 0,0:15:43.46,0:15:46.47,Default,,0000,0000,0000,,Е, Канна, сен сыртқа шықтың ба?
Dialogue: 0,0:15:46.74,0:15:48.09,Default,,0000,0000,0000,,Жаңбыр жауып тұрса да
Dialogue: 0,0:15:48.36,0:15:49.90,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:15:50.00,0:15:52.32,Default,,0000,0000,0000,,Мен үйімде бар Нозавананы алып шықтым.
Dialogue: 0,0:15:52.53,0:15:54.84,Default,,0000,0000,0000,,Менің қызым болса да, біртүрлі қыз.
Dialogue: 0,0:15:56.71,0:16:00.29,Default,,0000,0000,0000,,Қайтып келгенде, маған қоңырау шалғаныңызды хабарлаңыз.
Dialogue: 0,0:16:00.91,0:16:02.50,Default,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:16:07.39,0:16:08.39,Default,,0000,0000,0000,,Канна
Dialogue: 0,0:16:11.57,0:16:14.27,Default,,0000,0000,0000,,Нозавана сэндвичі
Dialogue: 0,0:16:14.63,0:16:17.06,Default,,0000,0000,0000,,Мен оны ингредиент ретінде пайдалану мүмкіндігін пайдаландым.
Dialogue: 0,0:16:17.81,0:16:18.53,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:16:19.03,0:16:20.52,Default,,0000,0000,0000,,Бірдеңе дұрыс емес
Dialogue: 0,0:16:21.01,0:16:25.19,Default,,0000,0000,0000,,Иә, бұл дәмді.
Dialogue: 0,0:16:25.34,0:16:26.82,Default,,0000,0000,0000,,Бұл грильдегі тағамға ұқсайды.
Dialogue: 0,0:16:26.98,0:16:28.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:28.22,0:16:30.99,Default,,0000,0000,0000,,Ал, мен грейпфрут тостағанын жеңдім.
Dialogue: 0,0:16:31.35,0:16:33.04,Default,,0000,0000,0000,,Сіз кез келген нәрсемен келе алатындай сезінесіз.
Dialogue: 0,0:16:33.42,0:16:34.91,Default,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:16:44.65,0:16:46.04,Default,,0000,0000,0000,,Басқа суретке түсіріңіз
Dialogue: 0,0:16:46.44,0:16:48.30,Default,,0000,0000,0000,,Олар маған көп алуды айтты.
Dialogue: 0,0:16:48.97,0:16:50.17,Default,,0000,0000,0000,,Танигава, сіз де ынтымақтастықта болыңыз.
Dialogue: 0,0:16:50.49,0:16:52.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:52.75,0:16:54.47,Default,,0000,0000,0000,,Табиғи сөйлесуге тырысыңыз
Dialogue: 0,0:16:55.19,0:16:57.21,Default,,0000,0000,0000,,Табиғи деп аталса да
Dialogue: 0,0:16:58.92,0:17:00.56,Default,,0000,0000,0000,,Эй, эй, эй
Dialogue: 0,0:17:01.23,0:17:03.99,Default,,0000,0000,0000,,Танигава мырза, сіздің бауырларыңыз бар ма?
Dialogue: 0,0:17:04.57,0:17:05.42,Default,,0000,0000,0000,,Жалғыз бала
Dialogue: 0,0:17:05.95,0:17:09.18,Default,,0000,0000,0000,,Бірақ мен кішкентай кезімнен Тецуромен ойнадым.
Dialogue: 0,0:17:09.53,0:17:11.27,Default,,0000,0000,0000,,Мен ешқашан жалғыздықты сезінбедім.
Dialogue: 0,0:17:11.39,0:17:13.61,Default,,0000,0000,0000,,Ишигаки-кун екеуміз сондай қартпыз.
Dialogue: 0,0:17:13.88,0:17:15.99,Default,,0000,0000,0000,,Мен өзімді ақымақ інімдей сезінемін.
Dialogue: 0,0:17:16.19,0:17:20.51,Default,,0000,0000,0000,,Иә, маған Ишигаки-кун ағаға көбірек ұқсайды.
Dialogue: 0,0:17:20.81,0:17:23.19,Default,,0000,0000,0000,,Бойым ұзын болғандықтан ғана солай ойлаймын.
Dialogue: 0,0:17:23.45,0:17:25.27,Default,,0000,0000,0000,,Үлкендер ағайынды.
Dialogue: 0,0:17:25.83,0:17:26.98,Default,,0000,0000,0000,,Әпкесі мен қарындасы
Dialogue: 0,0:17:27.23,0:17:29.50,Default,,0000,0000,0000,,Біз үш апалы болғанымыз өте жақсы.
Dialogue: 0,0:17:29.74,0:17:31.28,Default,,0000,0000,0000,,Біз әйелдер отбасымыз.
Dialogue: 0,0:17:31.65,0:17:34.18,Default,,0000,0000,0000,,Олай болса, мұнда болу біраз сергітеді.
Dialogue: 0,0:17:34.61,0:17:36.25,Default,,0000,0000,0000,,Отбасында ер адам болса
Dialogue: 0,0:17:36.50,0:17:38.23,Default,,0000,0000,0000,,Осылай ма деп ойлаймын
Dialogue: 0,0:17:39.68,0:17:41.64,Default,,0000,0000,0000,,Кайтоны отбасы мүшесімен салыстыру
Dialogue: 0,0:17:42.34,0:17:43.46,Default,,0000,0000,0000,,Бұл менің інім болса керек.
Dialogue: 0,0:17:44.28,0:17:46.70,Default,,0000,0000,0000,,Иә, мен де солай сезінемін.
Dialogue: 0,0:17:47.08,0:17:48.80,Default,,0000,0000,0000,,Сенуге болатын орындар бар.
Dialogue: 0,0:17:49.30,0:17:51.46,Default,,0000,0000,0000,,Қызық, бұл не екен, дұрыс айта алмаймын.
Dialogue: 0,0:17:51.63,0:17:52.75,Default,,0000,0000,0000,,A қазір
Dialogue: 0,0:17:54.56,0:17:56.70,Default,,0000,0000,0000,,Жарайды, сол күйінде қалдырыңыз.
Dialogue: 0,0:17:56.88,0:17:58.72,Default,,0000,0000,0000,,Иә, білмеймін.
Dialogue: 0,0:17:59.09,0:17:59.93,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:00.21,0:18:01.87,Default,,0000,0000,0000,,Қараңызшы, дәл бұрынғыдай.
Dialogue: 0,0:18:02.17,0:18:04.06,Default,,0000,0000,0000,,Соны айтсаң да
Dialogue: 0,0:18:04.13,0:18:04.98,Default,,0000,0000,0000,,Сол аға
Dialogue: 0,0:18:06.35,0:18:09.30,Default,,0000,0000,0000,,Сіздің жоғары сыныптарыңыз шетелде оқыды, солай ма?
Dialogue: 0,0:18:09.60,0:18:10.52,Default,,0000,0000,0000,,Иә, жақсы
Dialogue: 0,0:18:10.72,0:18:12.91,Default,,0000,0000,0000,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:18:13.65,0:18:16.59,Default,,0000,0000,0000,,Жарты жыл немесе бір жыл
Dialogue: 0,0:18:17.21,0:18:18.48,Default,,0000,0000,0000,,Аня Форджер
Dialogue: 0,0:18:21.66,0:18:22.92,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:18:23.02,0:18:24.07,Default,,0000,0000,0000,,Мен қосымша істермен айналысамын
Dialogue: 0,0:18:24.24,0:18:25.28,Default,,0000,0000,0000,,Иә, иә, жарайды.
Dialogue: 0,0:18:25.48,0:18:26.18,Default,,0000,0000,0000,,Хм, солай ма?
Dialogue: 0,0:18:27.84,0:18:28.52,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:18:31.85,0:18:32.84,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:34.73,0:18:36.82,Default,,0000,0000,0000,,Неге олай дедің?
Dialogue: 0,0:18:39.30,0:18:40.77,Default,,0000,0000,0000,,Бұл жиіркенішті.
Dialogue: 0,0:18:43.65,0:18:44.71,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:18:47.01,0:18:48.32,Default,,0000,0000,0000,,Ол әдепсіз.
Dialogue: 0,0:18:49.42,0:18:50.59,Default,,0000,0000,0000,,Бұл сүйкімді емес
Dialogue: 0,0:18:52.08,0:18:52.86,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:19:04.95,0:19:06.58,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:19:07.59,0:19:08.64,Default,,0000,0000,0000,,Уа! Ах, ах, ах! (Цубаки) Хмм!—
Dialogue: 0,0:19:08.98,0:19:10.22,Default,,0000,0000,0000,,Mio болуы керек
Dialogue: 0,0:19:11.22,0:19:13.03,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:19:17.21,0:19:18.93,Default,,0000,0000,0000,,Умичи кеткен болуы керек.
Dialogue: 0,0:19:21.88,0:19:23.09,Default,,0000,0000,0000,,Сіз біраз батылдық жинадыңыз.
Dialogue: 0,0:19:23.94,0:19:25.47,Default,,0000,0000,0000,,Мен бармауым керек еді.
Dialogue: 0,0:19:25.98,0:19:26.77,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:27.72,0:19:28.86,Default,,0000,0000,0000,,Мен кіре алмаймын.
Dialogue: 0,0:19:30.03,0:19:31.24,Default,,0000,0000,0000,,Моямоя ни
Dialogue: 0,0:19:31.62,0:19:33.09,Default,,0000,0000,0000,,Екі адам сөйлесіп тұр
Dialogue: 0,0:19:34.21,0:19:35.98,Default,,0000,0000,0000,,Мен осылай ойлағаным үшін өзімді жек көремін.
Dialogue: 0,0:19:37.44,0:19:38.56,Default,,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:19:41.04,0:19:42.76,Default,,0000,0000,0000,,Умихаса Мада Сенпай
Dialogue: 0,0:19:42.78,0:19:43.43,Default,,0000,0000,0000,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:19:43.87,0:19:44.74,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:45.39,0:19:46.61,Default,,0000,0000,0000,,Мен мұны істей алмаймын.
Dialogue: 0,0:19:46.88,0:19:49.22,Default,,0000,0000,0000,,Егер ол жұмыс істемесе, ыңғайсыз болатынына сенімдімін.
Dialogue: 0,0:19:49.54,0:19:50.33,Default,,0000,0000,0000,,Өзін жайсыз сезіну
Dialogue: 0,0:19:51.28,0:19:53.43,Default,,0000,0000,0000,,Енді бәріміз бірге фильм түсіреміз.
Dialogue: 0,0:19:54.66,0:19:56.89,Default,,0000,0000,0000,,Егер бұлай болса, мен бара алмаймын.
Dialogue: 0,0:19:58.36,0:20:00.28,Default,,0000,0000,0000,,Кайто-кунның да қиындығы сөзсіз.
Dialogue: 0,0:20:02.32,0:20:05.87,Default,,0000,0000,0000,,Олай болса, неге ештеңе істемей-ақ сыпырмайсың?
Dialogue: 0,0:20:08.16,0:20:10.44,Default,,0000,0000,0000,,Біреуге ұнамайынша білмейсің
Dialogue: 0,0:20:13.03,0:20:14.80,Default,,0000,0000,0000,,Тецуро түсінбейді.
Dialogue: 0,0:20:17.18,0:20:18.91,Default,,0000,0000,0000,,Иә, бұл жаман.
Dialogue: 0,0:20:20.93,0:20:22.20,Default,,0000,0000,0000,,Мен де тым көп айтып отырмын.
Dialogue: 0,0:20:23.86,0:20:24.78,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:20:30.18,0:20:32.59,Default,,0000,0000,0000,,Тоқта, тоқта, жақсы.
Dialogue: 0,0:20:34.33,0:20:35.86,Default,,0000,0000,0000,,Анаса Канна
Dialogue: 0,0:20:36.07,0:20:37.88,Default,,0000,0000,0000,,Мен жай ғана қалыптымын.
Dialogue: 0,0:20:38.40,0:20:41.46,Default,,0000,0000,0000,,Жазғы демалыс: Бірге фильм түсіріп, көңіл көтеріңіз
Dialogue: 0,0:20:42.21,0:20:45.52,Default,,0000,0000,0000,,Кино түсіріп, оны мектептегі фестивальде немесе бірдеңеде көрсету.
Dialogue: 0,0:20:46.36,0:20:49.23,Default,,0000,0000,0000,,Қалай болғанда да, мен әдеттегідей Канна Танигавамын.
Dialogue: 0,0:20:50.23,0:20:51.47,Default,,0000,0000,0000,,Мен осылай шештім
Dialogue: 0,0:20:51.85,0:20:52.69,Default,,0000,0000,0000,,О
Dialogue: 0,0:20:54.38,0:20:56.07,Default,,0000,0000,0000,,Жүр, кеттік, Тецуро.
Dialogue: 0,0:20:56.47,0:20:57.51,Default,,0000,0000,0000,,Иә Иә
Dialogue: 0,0:20:58.19,0:21:01.39,Default,,0000,0000,0000,,Мен ол кезде мұндай оқиға болғанына сене алар емеспін.
Dialogue: 0,0:21:01.94,0:21:02.96,Default,,0000,0000,0000,,Білмей
Dialogue: 0,0:21:04.00,0:21:05.33,Default,,0000,0000,0000,,Танигаваның да сезімі
Dialogue: 0,0:21:06.30,0:21:07.43,Default,,0000,0000,0000,,Тецуроның да сезімі
Dialogue: 0,0:21:08.85,0:21:10.02,Default,,0000,0000,0000,,Китахараның да сезімі
Dialogue: 0,0:21:10.76,0:21:12.03,Default,,0000,0000,0000,,Білудің жолы жоқ
Dialogue: 0,0:21:13.12,0:21:17.65,Default,,0000,0000,0000,,Сол кезде мен бір ойға батып кеттім.
Dialogue: 0,0:21:18.92,0:21:22.05,Default,,0000,0000,0000,,Мен ағам бір күні жоғалып кететін сияқтымын
Dialogue: 0,0:21:27.27,0:21:28.65,Default,,0000,0000,0000,,Йойо
Dialogue: 0,0:21:28.88,0:21:31.96,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:32.09,0:21:33.85,Default,,0000,0000,0000,,Маған кіруге рұқсат етіңіз.
Dialogue: 0,0:21:34.55,0:21:35.65,Default,,0000,0000,0000,,Қолды ұстай алмайды
Dialogue: 0,0:21:38.28,0:21:39.34,Default,,0000,0000,0000,,Биологиялық реакциялар
Dialogue: 0,0:21:40.12,0:21:41.23,Default,,0000,0000,0000,,Осындай уақытта
Dialogue: 0,0:21:42.83,0:21:44.22,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:45.04,0:21:46.86,Default,,0000,0000,0000,,Ал, алдыңғы есіктен кір.
Dialogue: 0,0:21:47.25,0:21:48.25,Default,,0000,0000,0000,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:21:48.72,0:21:49.70,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:50.63,0:21:51.47,Default,,0000,0000,0000,,Каннана
Dialogue: 0,0:21:51.90,0:21:54.38,Default,,0000,0000,0000,,Танигава Егер бұл Танигава болса, бүгін менің үйіме кел.
Dialogue: 0,0:21:54.46,0:21:55.23,Default,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:21:55.53,0:21:56.47,Default,,0000,0000,0000,,Мен теңізді жақсы көремін
Dialogue: 0,0:22:02.51,0:22:03.90,Default,,0000,0000,0000,,Канна Таникава
Dialogue: 0,0:22:05.22,0:22:06.67,Default,,0000,0000,0000,,Кайто Киришима
Dialogue: 0,0:22:08.13,0:22:09.32,Default,,0000,0000,0000,,♪ Дан, дан-тан…
Dialogue: 0,0:23:41.21,0:23:42.10,Default,,0000,0000,0000,,Окинава
Dialogue: 0,0:23:42.22,0:23:43.79,Default,,0000,0000,0000,,Ах, Окинава.
Dialogue: 0,0:23:43.96,0:23:44.86,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:23:45.03,0:23:46.43,Default,,0000,0000,0000,,О, бұл өте қызықты.
Dialogue: 0,0:23:46.90,0:23:49.41,Default,,0000,0000,0000,,О, мен шыдай алмаймын.
Dialogue: 0,0:12:02.78,0:12:06.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:39.74,0:23:49.95,Default,,0000,0000,0000,,Жапонтану
Dialogue: 0,0:00:58.82,0:01:02.02,Default,,0000,0000,0000,,Теңіз самалы сенің бетіңді
Dialogue: 0,0:01:02.79,0:01:05.91,Default,,0000,0000,0000,,Сіз үндемейсіз
Dialogue: 0,0:01:06.60,0:01:10.59,Default,,0000,0000,0000,,Іс жүзінде бұл профиль
Dialogue: 0,0:01:11.31,0:01:14.22,Default,,0000,0000,0000,,Мен оған қол тигізгім келеді
Dialogue: 0,0:01:14.33,0:01:17.62,Default,,0000,0000,0000,,Мен сені сүйіп тұрғандай болдым
Dialogue: 0,0:01:18.47,0:01:21.64,Default,,0000,0000,0000,,Бұл түсінде болды
Dialogue: 0,0:01:22.09,0:01:28.76,Default,,0000,0000,0000,,Жел шындықтың шекарасына тиеді
Dialogue: 0,0:01:30.32,0:01:37.23,Default,,0000,0000,0000,,Күнделікті өмір кездейсоқ сөздермен жарқырайды
Dialogue: 0,0:01:37.39,0:01:43.53,Default,,0000,0000,0000,,Бір күні көрген кино сияқты.
Dialogue: 0,0:01:44.52,0:01:48.22,Default,,0000,0000,0000,,Жыл мезгілдері келіп-кетсе де
Dialogue: 0,0:01:48.75,0:01:52.49,Default,,0000,0000,0000,,Бізді мәңгі күтеді
Dialogue: 0,0:01:52.57,0:01:59.74,Default,,0000,0000,0000,,Күйген пленка сияқты жаздың иісі
Dialogue: 0,0:02:00.05,0:02:03.97,Default,,0000,0000,0000,,Ешқашан өшпейтін алдын ала ескерту
Dialogue: 0,0:02:04.20,0:02:08.69,Default,,0000,0000,0000,,Мен қараған объективтен секіру
Dialogue: 0,0:02:09.01,0:02:14.12,Default,,0000,0000,0000,,Мен сенің қолыңнан ұстаймын
Dialogue: 0,0:00:58.82,0:01:02.02,Default,,0000,0000,0000,,Теңіз самалы
Dialogue: 0,0:01:03.26,0:01:05.91,Default,,0000,0000,0000,,Сізде сөз жоқ.
Dialogue: 0,0:01:06.60,0:01:10.59,Default,,0000,0000,0000,,Менің ойымша, дәл осылай.
Dialogue: 0,0:01:11.31,0:01:14.22,Default,,0000,0000,0000,,Үстелдің жағы
Dialogue: 0,0:01:14.33,0:01:17.62,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:18.47,0:01:21.64,Default,,0000,0000,0000,,Түсінде жатқан түсте
Dialogue: 0,0:01:22.09,0:01:28.76,Default,,0000,0000,0000,,Теңіз желінің нақты әлемі
Dialogue: 0,0:01:30.65,0:01:37.23,Default,,0000,0000,0000,,Күтпеген сөз, күтпеген күнделікті өмір
Dialogue: 0,0:01:37.39,0:01:43.53,Default,,0000,0000,0000,,Сурет дегеніміз не?
Dialogue: 0,0:01:44.52,0:01:48.22,Default,,0000,0000,0000,,Өкілді дереу ауыстыру
Dialogue: 0,0:01:48.75,0:01:52.49,Default,,0000,0000,0000,,Біз мәңгі бірге жұмыс істей береміз.
Dialogue: 0,0:01:52.57,0:01:59.74,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:00.05,0:02:03.97,Default,,0000,0000,0000,,Қозу сезімінің жауапсыздығы
Dialogue: 0,0:02:04.20,0:02:08.69,Default,,0000,0000,0000,,Мөлдір айна
Dialogue: 0,0:02:09.01,0:02:14.12,Default,,0000,0000,0000,,Гайкай Коукен Сумина Тадате
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Саған ғашық болу үшін іздеген себебім
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл ең қуанышты сөз деп айтылады.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Мен оны түсінгенде, жіптер дұрыс емес тураланған.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Бір жақты түйін күшейе түсті.
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Еш ойланбай, қаш
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,Сіз мәңгілік емессіз
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,Бұлт пішінін пирсинг
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ойлы серпін фильмі
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының иісімен
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Бұл менің есімде талай рет
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Тек сен маған берген ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,Душ сияқты түсіп кетіңіз
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Түсін шығарды.
Dialogue: 0,0:22:25.13,0:22:30.84,Default,,0000,0000,0000,,Адал болу қуанышының себебі
Dialogue: 0,0:22:30.94,0:22:37.90,Default,,0000,0000,0000,,Бұл сіздің ең ашық әңгімеңіз.
Dialogue: 0,0:22:40.16,0:22:45.68,Default,,0000,0000,0000,,Ниет жеткенде кенет қызыл сызық ашылады.
Dialogue: 0,0:22:46.14,0:22:53.54,Default,,0000,0000,0000,,Оңтүстік кезең ойы
Dialogue: 0,0:22:54.83,0:23:01.42,Default,,0000,0000,0000,,Оны оқудың қажеті болмаса, қашып құтыла аласыз.
Dialogue: 0,0:23:02.20,0:23:07.24,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:08.49,0:23:12.43,Default,,0000,0000,0000,,ену қабаты
Dialogue: 0,0:23:12.54,0:23:14.94,Default,,0000,0000,0000,,Ой қозғайтын бейне
Dialogue: 0,0:23:15.04,0:23:19.89,Default,,0000,0000,0000,,Жаз ортасының дәмі
Dialogue: 0,0:23:19.95,0:23:23.46,Default,,0000,0000,0000,,Маған шексіз өкін
Dialogue: 0,0:23:23.53,0:23:27.11,Default,,0000,0000,0000,,Мен үшін бұл жай ғана ғажайып
Dialogue: 0,0:23:27.20,0:23:31.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:31.95,0:23:39.57,Default,,0000,0000,0000,,Түсімен әдемі ашылған
Dialogue: 0,0:23:51.45,0:23:57.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory