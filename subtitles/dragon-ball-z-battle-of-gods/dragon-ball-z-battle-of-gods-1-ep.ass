Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:44.02,0:00:49.94,Japonais,,0,0,0,,Ертеде жердің түкпір-түкпірінде шағын кездесу болыпты.
Dialogue: 0,0:00:53.57,0:00:58.28,Japonais,,0,0,0,,Сон Гоку және оның достары Айдаһар шарларының айналасында
Dialogue: 0,0:00:58.28,0:01:03.37,Japonais,,0,0,0,,Шытырман оқиғалар мен шайқастардың ұзақ күндері басталды.
Dialogue: 0,0:01:06.37,0:01:12.42,Japonais,,0,0,0,,Кез келген тілекті орындай алатын Шенрон сиқырлаған жаумен күресіңіз.
Dialogue: 0,0:01:12.59,0:01:13.63,Japonais,,0,0,0,,Еніп алыңыз!
Dialogue: 0,0:01:15.26,0:01:19.30,Japonais,,0,0,0,,Кекшіл Пикколомен кескілескен шайқас
Dialogue: 0,0:01:23.56,0:01:25.73,Japonais,,0,0,0,,Сіз жеңілдіңіз!
Dialogue: 0,0:01:32.98,0:01:37.24,Japonais,,0,0,0,,Адамзаттың аман қалуы үшін Вегетамен шайқас
Dialogue: 0,0:01:46.62,0:01:48.08,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:01:49.13,0:01:51.84,Japonais,,0,0,0,,Намектегі Фриза шайқасы
Dialogue: 0,0:01:53.80,0:01:56.55,Japonais,,0,0,0,,Android жүйесі бар ұялы ойындар
Dialogue: 0,0:02:00.35,0:02:01.80,Japonais,,0,0,0,,Бітір!
Dialogue: 0,0:02:01.97,0:02:03.14,Japonais,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:02:04.72,0:02:07.44,Japonais,,0,0,0,,Маджин Буумен соңғы шайқас
Dialogue: 0,0:02:08.73,0:02:11.94,Japonais,,0,0,0,,Бірінен соң бірі пайда болатын күшті жауларға қарсы
Dialogue: 0,0:02:12.65,0:02:15.74,Japonais,,0,0,0,,Гоку супер Сайян болды.
Dialogue: 0,0:02:15.74,0:02:20.70,Japonais,,0,0,0,,Ересек ұлдарым Гохан және Готен және олардың достарымен
Dialogue: 0,0:02:20.70,0:02:23.24,Japonais,,0,0,0,,Дүниеге қиындықтан шығуға көмектес
Dialogue: 0,0:02:23.24,0:02:27.87,Japonais,,0,0,0,,Біз білмей тұрып, жер бетіне тыныштық орнады.
Dialogue: 0,0:02:30.46,0:02:31.42,Japonais,,0,0,0,,Бірақ...
Dialogue: 0,0:02:57.78,0:02:59.40,Japonais,,0,0,0,,Сен де сездің бе?
Dialogue: 0,0:02:59.40,0:03:01.07,Japonais,,0,0,0,,Кай патша?
Dialogue: 0,0:03:01.66,0:03:02.41,Japonais,,0,0,0,,Иә
Dialogue: 0,0:03:02.74,0:03:05.70,Japonais,,0,0,0,,Сіз бұл жолы өте ерте ояндыңыз.
Dialogue: 0,0:03:06.83,0:03:08.00,Japonais,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:03:08.71,0:03:09.87,Japonais,,0,0,0,,Бейбітшілік дегеніміз не?
Dialogue: 0,0:03:10.04,0:03:12.88,Japonais,,0,0,0,,Бұл өте қысқа.
Dialogue: 0,0:03:13.79,0:03:16.80,Japonais,,0,0,0,,Біз жаңа жұлдыз жасасақ та...
Dialogue: 0,0:03:17.13,0:03:20.38,Japonais,,0,0,0,,Менің ойымша, Кайу және басқалары да байқады.
Dialogue: 0,0:03:20.84,0:03:24.14,Japonais,,0,0,0,,Оларға сақ болуды айтыңыз.
Dialogue: 0,0:03:26.35,0:03:27.97,Japonais,,0,0,0,,Түсінікті
Dialogue: 0,0:03:33.15,0:03:35.77,Japonais,,0,0,0,,Иә! Құдай Кай...
Dialogue: 0,0:03:38.15,0:03:39.82,Japonais,,0,0,0,,Иә, иә…
Dialogue: 0,0:03:42.16,0:03:44.70,Japonais,,0,0,0,,Иә, мен де байқадым...
Dialogue: 0,0:03:45.83,0:03:46.28,Japonais,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:03:46.58,0:03:48.16,Japonais,,0,0,0,,Тыныш бол, Гоку!
Dialogue: 0,0:03:48.33,0:03:49.33,Japonais,,0,0,0,,Бос емес!
Dialogue: 0,0:03:50.16,0:03:51.08,Japonais,,0,0,0,,Гоку?
Dialogue: 0,0:03:51.50,0:03:53.46,Japonais,,0,0,0,,Мүмкін Сон Гоку...
Dialogue: 0,0:03:53.50,0:03:54.38,Japonais,,0,0,0,,Онда?
Dialogue: 0,0:03:54.42,0:03:55.84,Japonais,,0,0,0,,Иә, иә
Dialogue: 0,0:03:55.92,0:03:58.55,Japonais,,0,0,0,,Мен бұл планетаға жаттығуға келдім.
Dialogue: 0,0:03:58.63,0:04:00.67,Japonais,,0,0,0,,Оған байқамау.
Dialogue: 0,0:04:00.76,0:04:03.05,Japonais,,0,0,0,,Сізді қызықтыратынына сенімдімін.
Dialogue: 0,0:04:04.34,0:04:06.80,Japonais,,0,0,0,,Әрине, Беерус-сама туралы...
Dialogue: 0,0:04:07.05,0:04:08.39,Japonais,,0,0,0,,Сонымен... онда...
Dialogue: 0,0:04:12.23,0:04:13.77,Japonais,,0,0,0,,Беерус-сама дегеніміз не?
Dialogue: 0,0:04:15.23,0:04:17.23,Japonais,,0,0,0,,Эй...Гоку!
Dialogue: 0,0:04:18.23,0:04:19.90,Japonais,,0,0,0,,Бұл тәттінің аты ма?
Dialogue: 0,0:04:22.99,0:04:27.24,Japonais,,0,0,0,,Жоқ... түсіндім. Бұл өте дәмді тағамдар.
Dialogue: 0,0:04:27.28,0:04:29.24,Japonais,,0,0,0,,Мұның мағынасы жоқ.
Dialogue: 0,0:04:29.24,0:04:32.08,Japonais,,0,0,0,,Қай патша бұл туралы айтқанда қатты қорқып кетсе де.
Dialogue: 0,0:04:38.00,0:04:40.63,Japonais,,0,0,0,,Сіз білуіңіз керек...
Dialogue: 0,0:04:40.63,0:04:43.67,Japonais,,0,0,0,,Олай десеңіз, мен одан да көп тыңдаймын.
Dialogue: 0,0:04:43.67,0:04:45.72,Japonais,,0,0,0,,Ешқашан олай айтпа!
Dialogue: 0,0:04:45.72,0:04:47.89,Japonais,,0,0,0,,Сіз Кай патша туралы айттыңыз, солай ма?
Dialogue: 0,0:04:48.05,0:04:49.60,Japonais,,0,0,0,,Сізден тікелей сұрау керек пе?
Dialogue: 0,0:04:51.31,0:04:54.94,Japonais,,0,0,0,,Түсіндім, түсінемін, сондықтан телепортацияны тоқтатыңыз.
Dialogue: 0,0:04:57.15,0:05:00.23,Japonais,,0,0,0,,Менен естісең де Кай патшаға айтпа.
Dialogue: 0,0:05:01.78,0:05:05.74,Japonais,,0,0,0,,Бұл дүниеде жұлдыздар мен тіршілікті жаратқан Құдай бар.
Dialogue: 0,0:05:05.82,0:05:08.41,Japonais,,0,0,0,,Кайошин сияқты
Dialogue: 0,0:05:08.41,0:05:10.20,Japonais,,0,0,0,,Және керісінше
Dialogue: 0,0:05:10.20,0:05:14.71,Japonais,,0,0,0,,Жұлдыздар мен тіршілікті құртатын құдай да бар...
Dialogue: 0,0:05:19.54,0:05:22.63,Japonais,,0,0,0,,Бұл Беерус-сама ма?
Dialogue: 0,0:05:24.80,0:05:26.84,Japonais,,0,0,0,,Осымен
Dialogue: 0,0:05:26.97,0:05:29.14,Japonais,,0,0,0,,Жою құдайы Берус
Dialogue: 0,0:05:29.72,0:05:33.22,Japonais,,0,0,0,,Тәңір болсаң да, бұзасың ба?
Dialogue: 0,0:05:34.77,0:05:37.40,Japonais,,0,0,0,,Туу және жойылу
Dialogue: 0,0:05:41.94,0:05:46.95,Japonais,,0,0,0,,Әлемдегі тепе-теңдікті сақтау керек...
Dialogue: 0,0:05:48.24,0:05:49.41,Japonais,,0,0,0,,Енді ше?
Dialogue: 0,0:05:49.41,0:05:51.74,Japonais,,0,0,0,,Қанша жұлдыз құрбандыққа шалынады?
Dialogue: 0,0:05:52.08,0:05:53.12,Japonais,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:05:54.29,0:05:57.50,Japonais,,0,0,0,,Жою құдайы Бердің оянуы?
Dialogue: 0,0:05:58.25,0:06:01.50,Japonais,,0,0,0,,Мен біраз уақыт тыныға алмаймын.
Dialogue: 0,0:06:02.21,0:06:04.17,Japonais,,0,0,0,,Неліктен форма киіп жүрсің?
Dialogue: 0,0:06:05.17,0:06:07.88,Japonais,,0,0,0,,Беерус-сама өте күшті.
Dialogue: 0,0:06:08.22,0:06:09.89,Japonais,,0,0,0,,Бірақ басқа амалым жоқ, баруым керек. Кабинаға апаратын жол бос.
Dialogue: 0,0:06:09.89,0:06:12.60,Japonais,,0,0,0,,Мен оның қаншалықты күшті екенін асыға күтемін.
Dialogue: 0,0:06:12.89,0:06:14.22,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:06:14.72,0:06:15.68,Japonais,,0,0,0,,Не?
Dialogue: 0,0:06:15.68,0:06:18.23,Japonais,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:06:18.48,0:06:22.23,Japonais,,0,0,0,,Тек Беерус-саманың күші басқа деңгейде.
Dialogue: 0,0:06:22.36,0:06:25.94,Japonais,,0,0,0,,Бұл Берус, осы дүниедегі ең ұлы жою құдайы.
Dialogue: 0,0:06:25.94,0:06:29.74,Japonais,,0,0,0,,Сен оның алдында тұрған Құдайды Кайдың өзі де шошып кетті.
Dialogue: 0,0:06:29.74,0:06:33.87,Japonais,,0,0,0,,Қиратушы құдайдың құдіреттілігі сонша, ол сізді аздап кішкентай сезінеді.
Dialogue: 0,0:06:34.24,0:06:39.25,Japonais,,0,0,0,,Бұл дүниедегі ең бастысы – оған тартылмау.
Dialogue: 0,0:08:10.21,0:08:11.55,Japonais,,0,0,0,,Ояныңыз
Dialogue: 0,0:08:11.76,0:08:12.80,Japonais,,0,0,0,,Лорд Берус
Dialogue: 0,0:08:15.22,0:08:16.85,Japonais,,0,0,0,,Екі рет ұйықтамау керек.
Dialogue: 0,0:08:17.22,0:08:18.06,Japonais,,0,0,0,,Ең алдымен,
Dialogue: 0,0:08:18.10,0:08:21.85,Japonais,,0,0,0,,Сіз өзіңіздің оятарыңызды және бомбаңызды осы уақытта орнатасыз, солай ма?
Dialogue: 0,0:08:22.39,0:08:25.27,Japonais,,0,0,0,,Ерте тұрмасаңыз, қосымша оятқыш бар...
Dialogue: 0,0:08:30.23,0:08:31.74,Japonais,,0,0,0,,Мен білемін...
Dialogue: 0,0:08:31.74,0:08:33.74,Japonais,,0,0,0,,Мен білемін!
Dialogue: 0,0:08:35.78,0:08:40.45,Japonais,,0,0,0,,Мен сенің бұрынғы мен сияқты 15 жыл ұйықтағаныңды қаламаймын.
Dialogue: 0,0:08:40.45,0:08:42.96,Japonais,,0,0,0,,Егер олай болмаса...
Dialogue: 0,0:08:44.54,0:08:48.29,Japonais,,0,0,0,,Қайтадан сенің ояну әніңді айтайын ба?
Dialogue: 0,0:08:50.55,0:08:51.38,Japonais,,0,0,0,,Олай болса!
Dialogue: 0,0:08:51.76,0:08:54.93,Japonais,,0,0,0,,Түсіндім! Мен түсінемін...
Dialogue: 0,0:09:28.21,0:09:31.84,Japonais,,0,0,0,,Бұл жолы мен 39 жыл ғана ұйықтадым...
Dialogue: 0,0:09:32.09,0:09:34.42,Japonais,,0,0,0,,Бұл ұйықтау сияқты...
Dialogue: 0,0:09:34.84,0:09:38.55,Japonais,,0,0,0,,Ояну уақытын шешкен Беерус-сама болды.
Dialogue: 0,0:09:38.97,0:09:41.35,Japonais,,0,0,0,,Айтпақшы, неге дәл осы уақытта?
Dialogue: 0,0:09:41.97,0:09:44.31,Japonais,,0,0,0,,Мені біраз мазалайтын нәрсе бар.
Dialogue: 0,0:09:45.39,0:09:48.23,Japonais,,0,0,0,,Ванна қайнап жатыр.
Dialogue: 0,0:09:48.23,0:09:49.44,Japonais,,0,0,0,,Кіріңіз
Dialogue: 0,0:09:49.73,0:09:50.73,Japonais,,0,0,0,,Жоқ!
Dialogue: 0,0:09:50.90,0:09:52.44,Japonais,,0,0,0,,Мен ваннаны жек көремін.
Dialogue: 0,0:09:53.40,0:09:55.53,Japonais,,0,0,0,,Бомбаның күйеуіне толы!
Dialogue: 0,0:09:56.24,0:09:58.66,Japonais,,0,0,0,,Зең де өсіп кетуі мүмкін.
Dialogue: 0,0:09:59.66,0:10:00.53,Japonais,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:10:00.70,0:10:02.24,Japonais,,0,0,0,,Егер сізге ұнамаса
Dialogue: 0,0:10:02.24,0:10:09.08,Japonais,,0,0,0,,Жою құдайы Берус ғажап, бірақ оның сасықтығы бар деген қауесет бар.
Dialogue: 0,0:10:10.50,0:10:11.29,Japonais,,0,0,0,,Whis
Dialogue: 0,0:10:11.67,0:10:14.92,Japonais,,0,0,0,,Мен сіздің қызықсыз әзілдеріңізден шаршадым...
Dialogue: 0,0:10:17.68,0:10:19.59,Japonais,,0,0,0,,Мен оны құртамын...
Dialogue: 0,0:10:23.10,0:10:24.43,Japonais,,0,0,0,,Айтпақшы, Whis
Dialogue: 0,0:10:24.93,0:10:26.73,Japonais,,0,0,0,,Мен ұйықтап жатқанда
Dialogue: 0,0:10:26.89,0:10:31.48,Japonais,,0,0,0,,Фриза Вегета планетасын жойды ма?
Dialogue: 0,0:10:32.40,0:10:32.98,Japonais,,0,0,0,,Иә
Dialogue: 0,0:10:32.98,0:10:34.53,Japonais,,0,0,0,,Ізсіз
Dialogue: 0,0:10:35.15,0:10:36.32,Japonais,,0,0,0,,Иә?
Dialogue: 0,0:10:36.65,0:10:40.66,Japonais,,0,0,0,,Бұл планетаның адамдары әрқашан сұмдық болған.
Dialogue: 0,0:10:40.95,0:10:43.24,Japonais,,0,0,0,,Патша Вегета ерекше сараң болды.
Dialogue: 0,0:10:45.08,0:10:48.04,Japonais,,0,0,0,,Мен оны жойып жіберуім мүмкін еді.
Dialogue: 0,0:10:48.12,0:10:50.46,Japonais,,0,0,0,,Бұл жұлдыз онша алыс емес...
Dialogue: 0,0:10:50.46,0:10:52.25,Japonais,,0,0,0,,Себебі бұл қиын болды.
Dialogue: 0,0:10:52.50,0:10:55.80,Japonais,,0,0,0,,Әйтеуір, Фриза да жаман жігіт.
Dialogue: 0,0:10:56.55,0:10:57.92,Japonais,,0,0,0,,Ол бастық сияқты.
Dialogue: 0,0:10:58.05,0:11:01.47,Japonais,,0,0,0,,Келесі жолы кездессек, мен оны да құртып алармын...
Dialogue: 0,0:11:03.05,0:11:04.56,Japonais,,0,0,0,,Оған таралмайды
Dialogue: 0,0:11:04.56,0:11:06.35,Japonais,,0,0,0,,Фриза жеңілді
Dialogue: 0,0:11:08.27,0:11:11.23,Japonais,,0,0,0,,Фризаны жеңетін адам бар ма?
Dialogue: 0,0:11:11.73,0:11:13.36,Japonais,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:11:23.57,0:11:27.04,Japonais,,0,0,0,,Иә? Мен мұны бұрын бір жерде көргендей сезінемін
Dialogue: 0,0:11:27.49,0:11:28.87,Japonais,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:11:29.33,0:11:30.54,Japonais,,0,0,0,,Мен Сайянмын
Dialogue: 0,0:11:31.12,0:11:35.25,Japonais,,0,0,0,,Оны Сон Гоку және Какарот деп те атайтын сияқты...
Dialogue: 0,0:11:38.84,0:11:43.34,Japonais,,0,0,0,,Сайяндар Вегета планетасымен бірге жойылды емес пе?
Dialogue: 0,0:11:43.47,0:11:45.55,Japonais,,0,0,0,,Олардың көпшілігі қырылды, бірақ
Dialogue: 0,0:11:45.60,0:11:49.31,Japonais,,0,0,0,,Басқа планетаға кеткендер аман қалды...
Dialogue: 0,0:11:49.73,0:11:53.44,Japonais,,0,0,0,,Айтпақшы, ханзада Вегета солардың бірі.
Dialogue: 0,0:11:53.52,0:11:57.27,Japonais,,0,0,0,,Сайянның шашы қара емес пе?
Dialogue: 0,0:11:59.32,0:12:03.45,Japonais,,0,0,0,,Солай бола тұра, Сайяндар Фризаны жеңіп, жақсы жұмыс жасады.
Dialogue: 0,0:12:12.54,0:12:14.79,Japonais,,0,0,0,,Сайяндар осында келді
Dialogue: 0,0:12:14.79,0:12:19.00,Japonais,,0,0,0,,Сүйчипа мутацияға ұшырап, Сайянға айналу қабілетіне ие болған сияқты.
Dialogue: 0,0:12:19.59,0:12:20.38,Japonais,,0,0,0,,Не?
Dialogue: 0,0:12:21.13,0:12:22.93,Japonais,,0,0,0,,Супер Сайян...
Dialogue: 0,0:12:23.72,0:12:25.39,Japonais,,0,0,0,,Супер Сайян
Dialogue: 0,0:12:25.89,0:12:27.72,Japonais,,0,0,0,,Супер Сайян!
Dialogue: 0,0:12:28.81,0:12:30.14,Japonais,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:12:30.43,0:12:32.23,Japonais,,0,0,0,,Бұл осылай болды!
Dialogue: 0,0:12:32.23,0:12:33.60,Japonais,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:12:33.64,0:12:35.02,Japonais,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:12:35.02,0:12:36.61,Japonais,,0,0,0,,Супер Сайян...
Dialogue: 0,0:12:36.98,0:12:39.11,Japonais,,0,0,0,,Супер Сайян...
Dialogue: 0,0:12:39.11,0:12:40.32,Japonais,,0,0,0,,Құдай!
Dialogue: 0,0:12:40.94,0:12:42.99,Japonais,,0,0,0,,Түсімде көрдім!
Dialogue: 0,0:12:43.07,0:12:47.45,Japonais,,0,0,0,,Бірдеңе... Супер Сайян Құдай, мен онымен күресуді армандаймын!
Dialogue: 0,0:12:48.83,0:12:51.33,Japonais,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,0:12:51.33,0:12:52.79,Japonais,,0,0,0,,Бұл пайғамбарлық түс!
Dialogue: 0,0:12:52.79,0:12:54.12,Japonais,,0,0,0,,Прекогнитивті арман!
Dialogue: 0,0:12:54.62,0:12:56.54,Japonais,,0,0,0,,Арман...?
Dialogue: 0,0:13:00.80,0:13:02.92,Japonais,,0,0,0,,Беерус-саманың алдын ала арманы қандай?
Dialogue: 0,0:13:02.92,0:13:05.68,Japonais,,0,0,0,,Дәлдік деңгейі соншалықты жоғары емес, солай емес пе?
Dialogue: 0,0:13:06.93,0:13:10.68,Japonais,,0,0,0,,Күні кеше де... Түсімде бір кумир көшіп келді.
Dialogue: 0,0:13:10.81,0:13:12.85,Japonais,,0,0,0,,Бұл жұмыс істемеді, солай ма?
Dialogue: 0,0:13:12.85,0:13:14.64,Japonais,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:13:14.73,0:13:17.48,Japonais,,0,0,0,,Жақсы! Менімен бірге Whis
Dialogue: 0,0:13:21.69,0:13:22.99,Japonais,,0,0,0,,Пайғамбарлық балық!
Dialogue: 0,0:13:23.40,0:13:25.45,Japonais,,0,0,0,,Пайғамбарлық балық бар ма?
Dialogue: 0,0:13:36.00,0:13:37.50,Japonais,,0,0,0,,Мен серуендеп жүрдім.
Dialogue: 0,0:13:37.50,0:13:38.29,Japonais,,0,0,0,,Не?
Dialogue: 0,0:13:38.75,0:13:41.42,Japonais,,0,0,0,,Сіз мұны 39 жыл бұрын айттыңыз.
Dialogue: 0,0:13:41.88,0:13:45.92,Japonais,,0,0,0,,Маған 39 жылдан кейін күшті жау пайда болады.
Dialogue: 0,0:13:48.39,0:13:49.80,Japonais,,0,0,0,,Мен бұл туралы айттым ба?
Dialogue: 0,0:13:49.80,0:13:51.39,Japonais,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:13:53.56,0:13:54.85,Japonais,,0,0,0,,Сонда мен айттым
Dialogue: 0,0:13:54.93,0:13:55.85,Japonais,,0,0,0,,Қараңыз
Dialogue: 0,0:13:55.98,0:13:58.90,Japonais,,0,0,0,,Пайғамбарлық балықтың пайғамбарлығы және менің пайғамбарлық арманым...
Dialogue: 0,0:13:58.98,0:14:00.65,Japonais,,0,0,0,,Пайда!
Dialogue: 0,0:14:00.65,0:14:02.48,Japonais,,0,0,0,,Менің күшті жауым
Dialogue: 0,0:14:02.52,0:14:04.49,Japonais,,0,0,0,,Супер Сайян Құдайы!
Dialogue: 0,0:14:06.07,0:14:08.32,Japonais,,0,0,0,,Бұл өте таңқаларлық.
Dialogue: 0,0:14:08.70,0:14:12.87,Japonais,,0,0,0,,Біріншіден, Беерус-саманың күшті жауы бар екенін елестету қиын...
Dialogue: 0,0:14:13.45,0:14:18.00,Japonais,,0,0,0,,Жарайды... Пайғамбарлық балық айбатты жау десем, артық айтқан болармын.
Dialogue: 0,0:14:18.00,0:14:20.50,Japonais,,0,0,0,,Қызықты нәрсе пайда болады деп ойлаймын, солай ма?
Dialogue: 0,0:14:20.58,0:14:23.42,Japonais,,0,0,0,,Сондықтан мен бұл жолы ерте тұрдым.
Dialogue: 0,0:14:23.75,0:14:26.59,Japonais,,0,0,0,,Мен... көремін...
Dialogue: 0,0:14:27.38,0:14:31.26,Japonais,,0,0,0,,Ендеше... сен сайяндармен кездесесің бе?
Dialogue: 0,0:14:31.26,0:14:32.35,Japonais,,0,0,0,,Әрине.
Dialogue: 0,0:14:32.72,0:14:36.43,Japonais,,0,0,0,,Маған Супер Сайян Құдайын табу керек
Dialogue: 0,0:14:36.64,0:14:39.48,Japonais,,0,0,0,,Сіз супер Сайян құдайсыз ба?
Dialogue: 0,0:14:39.60,0:14:42.36,Japonais,,0,0,0,,Бұл өте асыра айтылған атау.
Dialogue: 0,0:14:42.44,0:14:43.94,Japonais,,0,0,0,,Өте арзан
Dialogue: 0,0:14:49.99,0:14:51.41,Japonais,,0,0,0,,Мен таптым
Dialogue: 0,0:14:51.57,0:14:53.95,Japonais,,0,0,0,,Тірі қалған сайяндар негізінен...
Dialogue: 0,0:14:54.03,0:14:57.96,Japonais,,0,0,0,,4032 жасыл 877 планета
Dialogue: 0,0:14:57.96,0:15:01.29,Japonais,,0,0,0,,Жер деп аталатын планетада шамамен бес адам бар сияқты...
Dialogue: 0,0:15:02.29,0:15:03.29,Japonais,,0,0,0,,Жер…
Dialogue: 0,0:15:03.38,0:15:06.80,Japonais,,0,0,0,,Мен бұған дейін бір рет болғаныма сенімдімін.
Dialogue: 0,0:15:06.92,0:15:10.63,Japonais,,0,0,0,,Динозаврлар маған өте дөрекі болды...
Dialogue: 0,0:15:10.68,0:15:13.39,Japonais,,0,0,0,,Бұл біз сөнген жұлдыз емес пе?
Dialogue: 0,0:15:13.64,0:15:15.43,Japonais,,0,0,0,,Солардың бірі ғана
Dialogue: 0,0:15:15.68,0:15:18.18,Japonais,,0,0,0,,Фризаны жеңген Сайян
Dialogue: 0,0:15:18.23,0:15:21.60,Japonais,,0,0,0,,Сіз қазір солтүстікте Кай патшаның планетасында жүрген сияқтысыз.
Dialogue: 0,0:15:22.19,0:15:25.19,Japonais,,0,0,0,,Сайяндар Кай патшаға?
Dialogue: 0,0:15:25.19,0:15:26.69,Japonais,,0,0,0,,Бұл күдікті...
Dialogue: 0,0:15:28.24,0:15:30.70,Japonais,,0,0,0,,Whis! Ол жерге жету үшін қанша уақыт қажет?
Dialogue: 0,0:15:30.70,0:15:32.53,Japonais,,0,0,0,,Шамамен 26 минут
Dialogue: 0,0:15:32.78,0:15:34.99,Japonais,,0,0,0,,Теледидар анимесінің шамамен 1 бөлімі
Dialogue: 0,0:15:35.83,0:15:37.29,Japonais,,0,0,0,,Бұл алыс!!
Dialogue: 0,0:15:37.58,0:15:40.71,Japonais,,0,0,0,,Жарайды, оған көмектесу мүмкін емес! Мен ұстануым керек пе...
Dialogue: 0,0:15:41.04,0:15:43.04,Japonais,,0,0,0,,Кеттік!
Dialogue: 0,0:15:44.25,0:15:46.09,Japonais,,0,0,0,,Солтүстіктегі Кай патшаның жұлдызына...
Dialogue: 0,0:16:23.21,0:16:25.42,Japonais,,0,0,0,,Туған күнің құтты болсын, Бұлма...
Dialogue: 0,0:16:25.50,0:16:27.67,Japonais,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:16:36.22,0:16:38.35,Japonais,,0,0,0,,Эх! ? Келмейсің бе?
Dialogue: 0,0:16:38.35,0:16:42.27,Japonais,,0,0,0,,Неліктен осындай уақытта Кай патшаның орнында жаттығасың?
Dialogue: 0,0:16:42.52,0:16:44.69,Japonais,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,0:16:44.90,0:16:48.27,Japonais,,0,0,0,,Ммм... Бұл туралы жарты жыл бұрын айтқан едім...
Dialogue: 0,0:16:50.23,0:16:51.94,Japonais,,0,0,0,,Вегета ше?
Dialogue: 0,0:16:51.94,0:16:54.07,Japonais,,0,0,0,,Ол жаттығу жасап жатқан сияқты.
Dialogue: 0,0:16:55.24,0:16:57.45,Japonais,,0,0,0,,Ол шынымен Сайян...
Dialogue: 0,0:17:07.21,0:17:08.59,Japonais,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:17:09.88,0:17:12.51,Japonais,,0,0,0,,Босаңсуды доғар да, маған ішімдік әкел.
Dialogue: 0,0:17:12.63,0:17:15.22,Japonais,,0,0,0,,Мен оған кейінірек қол қоямын.
Dialogue: 0,0:17:15.22,0:17:18.22,Japonais,,0,0,0,,Хойхой, қандай алкогольді ішкенді қалайсың?
Dialogue: 0,0:17:18.22,0:17:19.60,Japonais,,0,0,0,,Шайтан мырза
Dialogue: 0,0:17:19.68,0:17:22.22,Japonais,,0,0,0,,Бұл кісі Бұлма-санның әкесі.
Dialogue: 0,0:17:22.35,0:17:24.10,Japonais,,0,0,0,,Бұл доктор Бриф.
Dialogue: 0,0:17:29.27,0:17:32.23,Japonais,,0,0,0,,А... сіз әлемдегі ең ұлы данышпансыз ба?
Dialogue: 0,0:17:32.32,0:17:34.82,Japonais,,0,0,0,,Және ол әлемдегі ең бай адам.
Dialogue: 0,0:17:34.82,0:17:38.74,Japonais,,0,0,0,,О, сен әлемдегі ең бай адамсың ба?
Dialogue: 0,0:17:39.16,0:17:40.74,Japonais,,0,0,0,,О? Мен де көп білмеймін
Dialogue: 0,0:17:41.24,0:17:43.25,Japonais,,0,0,0,,Бұл... Бұл үшін кешірім сұраймын...
Dialogue: 0,0:17:43.29,0:17:45.83,Japonais,,0,0,0,,Айтпақшы, қандай алкогольді ішкенді қалайсыз?
Dialogue: 0,0:17:45.96,0:17:48.42,Japonais,,0,0,0,,Және... Олай емес!
Dialogue: 0,0:17:48.50,0:17:51.50,Japonais,,0,0,0,,Мен саған сусыныңды әкелемін.
Dialogue: 0,0:17:51.59,0:17:54.26,Japonais,,0,0,0,,Сіз не алғыңыз келеді?
Dialogue: 0,0:17:54.26,0:17:56.59,Japonais,,0,0,0,,Не? Қазір бәрі жақсы...
Dialogue: 0,0:17:56.88,0:18:00.10,Japonais,,0,0,0,,Олай айтпа, бірдеңе іш...
Dialogue: 0,0:18:01.10,0:18:02.89,Japonais,,0,0,0,,Сонымен... Кокс
Dialogue: 0,0:18:02.89,0:18:06.64,Japonais,,0,0,0,,Кола! Ха... иә! Менде бар!
Dialogue: 0,0:18:06.94,0:18:09.19,Japonais,,0,0,0,,Мен істі бірден сізге жеткіземін.
Dialogue: 0,0:18:11.61,0:18:15.07,Japonais,,0,0,0,,Әке атансам... Ұялып қалар едім...
Dialogue: 0,0:18:22.37,0:18:23.95,Japonais,,0,0,0,,Айтпақшы, Бұлма-сан!
Dialogue: 0,0:18:23.99,0:18:26.83,Japonais,,0,0,0,,Сіздің туған күніңіз нешеде?
Dialogue: 0,0:18:26.87,0:18:30.04,Japonais,,0,0,0,,Кешіріңіз... Осыны үйретіп жатырсыз ба?
Dialogue: 0,0:18:30.21,0:18:32.00,Japonais,,0,0,0,,Бинго турнирінің жүлдесі...
Dialogue: 0,0:18:32.00,0:18:35.34,Japonais,,0,0,0,,Құлыптар мен ұшақтар бар екені рас па?
Dialogue: 0,0:18:35.34,0:18:36.21,Japonais,,0,0,0,,Иә!
Dialogue: 0,0:18:36.21,0:18:38.63,Japonais,,0,0,0,,Егер бұл өте қиын болса, оны ақшаға айырбастауға болады.
Dialogue: 0,0:18:38.68,0:18:41.30,Japonais,,0,0,0,,Күтілгендей ол әлемдегі ең бай адам.
Dialogue: 0,0:18:41.43,0:18:44.85,Japonais,,0,0,0,,Бинго турнирі үшін болса да Гоку өз бетін көрсете ме деп ойлаймын.
Dialogue: 0,0:18:45.18,0:18:48.60,Japonais,,0,0,0,,Блумерлер, жүлде ретінде тентек DVD дискілері жоқ па?
Dialogue: 0,0:18:48.60,0:18:49.19,Japonais,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:18:52.73,0:18:55.48,Japonais,,0,0,0,,Ши... кетті!
Dialogue: 0,0:18:55.57,0:18:57.53,Japonais,,0,0,0,,Не...не болды? Гоку
Dialogue: 0,0:18:57.65,0:19:00.24,Japonais,,0,0,0,,Бүгін Бұлманың туған күні болды!
Dialogue: 0,0:19:01.16,0:19:02.53,Japonais,,0,0,0,,Қарғыс атсын!!
Dialogue: 0,0:19:02.53,0:19:04.20,Japonais,,0,0,0,,Сіз ашуланасыз!!
Dialogue: 0,0:19:04.20,0:19:06.58,Japonais,,0,0,0,,Мені бұлай деп қорқытпа.
Dialogue: 0,0:19:06.87,0:19:08.58,Japonais,,0,0,0,,Ол жігіт мені қорқытады.
Dialogue: 0,0:19:08.79,0:19:09.37,Japonais,,0,0,0,,О, расымен бе?
Dialogue: 0,0:19:09.37,0:19:13.50,Japonais,,0,0,0,,Бұл қиратушы құдай мен сол жігітке қарсы жақсы күрес.
Dialogue: 0,0:19:25.85,0:19:27.10,Japonais,,0,0,0,,Кай патша?
Dialogue: 0,0:19:28.43,0:19:29.64,Japonais,,0,0,0,,Гоку!
Dialogue: 0,0:19:29.73,0:19:32.94,Japonais,,0,0,0,,Бұл... қиын. Мұнда... осында...
Dialogue: 0,0:19:32.98,0:19:34.61,Japonais,,0,0,0,,Не? Булма келе ме?
Dialogue: 0,0:19:34.61,0:19:37.78,Japonais,,0,0,0,,Жоқ! Бұл Беерус-сама
Dialogue: 0,0:19:37.90,0:19:40.95,Japonais,,0,0,0,,Бұзылу құдайы Берус осында келе жатыр.
Dialogue: 0,0:19:43.66,0:19:45.74,Japonais,,0,0,0,,Эй... Мен ештеңе сезбеймін бе?
Dialogue: 0,0:19:45.74,0:19:48.37,Japonais,,0,0,0,,Құдайдың бар екенін білмейсің.
Dialogue: 0,0:19:48.58,0:19:52.87,Japonais,,0,0,0,,Жарайсың ба? Өтінемін, ақымақтық жасаудан аулақ болыңыз.
Dialogue: 0,0:19:53.13,0:19:55.75,Japonais,,0,0,0,,Сіз жақсы дедіңіз, солай ма? !
Dialogue: 0,0:19:56.75,0:19:57.84,Japonais,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:19:59.67,0:20:01.05,Japonais,,0,0,0,,Мен уайымдап тұрмын
Dialogue: 0,0:20:01.05,0:20:04.43,Japonais,,0,0,0,,О? Гоку! Ішіне жасырын!!
Dialogue: 0,0:20:04.55,0:20:05.22,Japonais,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:20:05.39,0:20:06.89,Japonais,,0,0,0,,Асығыңыз!
Dialogue: 0,0:20:06.89,0:20:09.14,Japonais,,0,0,0,,Ерте болса да... қазірдің өзінде...
Dialogue: 0,0:20:09.39,0:20:10.48,Japonais,,0,0,0,,Жүгір!
Dialogue: 0,0:20:10.48,0:20:11.60,Japonais,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:20:14.27,0:20:18.19,Japonais,,0,0,0,,Неліктен? Неліктен Берус-сама мұнда?
Dialogue: 0,0:20:18.73,0:20:20.44,Japonais,,0,0,0,,Неліктен?
Dialogue: 0,0:20:30.00,0:20:31.87,Japonais,,0,0,0,,Бұл...бұл Берус-сама.
Dialogue: 0,0:20:34.33,0:20:35.63,Japonais,,0,0,0,,Бұл кім?
Dialogue: 0,0:20:36.33,0:20:39.38,Japonais,,0,0,0,,Ол, әрине, қарапайым адам емес сияқты...
Dialogue: 0,0:20:39.59,0:20:40.80,Japonais,,0,0,0,,Осындай жерде...
Dialogue: 0,0:20:41.30,0:20:42.80,Japonais,,0,0,0,,Йо... Қош келдіңіз...
Dialogue: 0,0:20:42.84,0:20:45.84,Japonais,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:20:48.31,0:20:49.85,Japonais,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:20:51.48,0:20:52.68,Japonais,,0,0,0,,Солтүстік патшасы Кай
Dialogue: 0,0:20:53.14,0:20:56.35,Japonais,,0,0,0,,Не? Анау Беерус-сама ма?
Dialogue: 0,0:20:56.86,0:20:58.40,Japonais,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:20:58.73,0:21:00.15,Japonais,,0,0,0,,Сіздің жұлдызыңыз...
Dialogue: 0,0:21:00.48,0:21:01.65,Japonais,,0,0,0,,Бұл кішкентай...
Dialogue: 0,0:21:03.78,0:21:05.32,Japonais,,0,0,0,,Сондай-ақ... Кешіріңіз...
Dialogue: 0,0:21:05.32,0:21:07.70,Japonais,,0,0,0,,Қиын жағдай үшін кешірім сұраймын...
Dialogue: 0,0:21:08.74,0:21:12.83,Japonais,,0,0,0,,Баяғыда Беерус-сама оны қиратып, кішірейіп кеткен.
Dialogue: 0,0:21:12.87,0:21:15.08,Japonais,,0,0,0,,Себебі мен жасырынбақта жеңілдім...
Dialogue: 0,0:21:15.50,0:21:16.75,Japonais,,0,0,0,,Солай ма?
Dialogue: 0,0:21:17.38,0:21:20.80,Japonais,,0,0,0,,Бірақ... өткен күні жұлдыздар қалпына келтірілгенде.
Dialogue: 0,0:21:20.80,0:21:25.18,Japonais,,0,0,0,,Оның бастапқы өлшеміне қайтарылмағанын ескере отырып.
Dialogue: 0,0:21:25.26,0:21:27.68,Japonais,,0,0,0,,Бұл өлшем сізге ұнайды.
Dialogue: 0,0:21:29.35,0:21:30.68,Japonais,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:21:30.68,0:21:33.85,Japonais,,0,0,0,,Неліктен Беерус-сама мұндай жерде?
Dialogue: 0,0:21:34.68,0:21:38.10,Japonais,,0,0,0,,Мен бір сәтке осындамын. Менің Сайяндармен бір қатысым бар.
Dialogue: 0,0:21:39.27,0:21:40.27,Japonais,,0,0,0,,О, жоқ!
Dialogue: 0,0:21:40.27,0:21:41.40,Japonais,,0,0,0,,Шық!
Dialogue: 0,0:21:42.44,0:21:44.57,Japonais,,0,0,0,,Бұл үшін кешірім сұраймыз...
Dialogue: 0,0:21:44.74,0:21:45.57,Japonais,,0,0,0,,Гоку!
Dialogue: 0,0:21:45.65,0:21:47.99,Japonais,,0,0,0,,Беерус-самаға сәлем...
Dialogue: 0,0:21:52.20,0:21:53.29,Japonais,,0,0,0,,Оссу! Сәлем...
Dialogue: 0,0:21:55.04,0:21:56.29,Japonais,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:21:57.79,0:21:59.63,Japonais,,0,0,0,,Міндетті түрде айтамын деп ойладым...
Dialogue: 0,0:21:59.75,0:22:03.05,Japonais,,0,0,0,,Сіздің де жасыңыз жақсы, сондықтан дұрыс сәлемдесу маңызды.
Dialogue: 0,0:22:05.63,0:22:07.84,Japonais,,0,0,0,,Жаса... Жасай... Сәлем, сәлем...
Dialogue: 0,0:22:07.84,0:22:09.64,Japonais,,0,0,0,,Мен...жоқ...
Dialogue: 0,0:22:10.30,0:22:12.68,Japonais,,0,0,0,,Мен және Сон Гоку...
Dialogue: 0,0:22:12.68,0:22:14.43,Japonais,,0,0,0,,Сіз айтасыз... бұл...
Dialogue: 0,0:22:14.60,0:22:15.85,Japonais,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:16.23,0:22:19.94,Japonais,,0,0,0,,Айтпақшы, сізден сұрайын дегенім бар...
Dialogue: 0,0:22:20.23,0:22:21.90,Japonais,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:22:22.44,0:22:23.65,Japonais,,0,0,0,,Керемет…
Dialogue: 0,0:22:23.65,0:22:25.74,Japonais,,0,0,0,,Супер Сайян Құдайы
Dialogue: 0,0:22:26.03,0:22:27.15,Japonais,,0,0,0,,Оған не болды?
Dialogue: 0,0:22:27.15,0:22:31.53,Japonais,,0,0,0,,Супер Сайян Құдайының бар екенін білесіз бе?
Dialogue: 0,0:22:31.87,0:22:33.74,Japonais,,0,0,0,,Супер Сайян Құдайы ма?
Dialogue: 0,0:22:33.79,0:22:36.83,Japonais,,0,0,0,,Егер сіз жай ғана Супер Сайян болсаңыз, мен білетін едім.
Dialogue: 0,0:22:36.87,0:22:39.58,Japonais,,0,0,0,,Мен бұл құдай туралы ешқашан естіген емеспін ...
Dialogue: 0,0:22:42.04,0:22:43.92,Japonais,,0,0,0,,Менің естігенім... Эй.
Dialogue: 0,0:22:44.00,0:22:48.72,Japonais,,0,0,0,,Мен де Super Saiyan God туралы бірінші рет естідім...
Dialogue: 0,0:22:49.43,0:22:50.64,Japonais,,0,0,0,,А... Түсіндім...?
Dialogue: 0,0:22:53.22,0:22:55.64,Japonais,,0,0,0,,Мен мұны мына сөзден естідім...
Dialogue: 0,0:22:55.64,0:22:58.27,Japonais,,0,0,0,,Сонда сіз Фризаны жеңдіңіз бе?
Dialogue: 0,0:22:58.27,0:22:59.14,Japonais,,0,0,0,,Фриза?
Dialogue: 0,0:23:00.94,0:23:03.40,Japonais,,0,0,0,,Оны жеңгенім рас...
Dialogue: 0,0:23:11.07,0:23:14.28,Japonais,,0,0,0,,Сен мені қазір жеңе алмайсың деп ойлаймын.
Dialogue: 0,0:23:14.28,0:23:16.79,Japonais,,0,0,0,,Шамасы, ол мутацияға ұшырап, қуат береді.
Dialogue: 0,0:23:16.79,0:23:18.71,Japonais,,0,0,0,,Ол супер Сайян болса да...
Dialogue: 0,0:23:19.21,0:23:20.96,Japonais,,0,0,0,,Қош бол
Dialogue: 0,0:23:20.96,0:23:22.25,Japonais,,0,0,0,,Өздеріңіз жақсы білесіздер
Dialogue: 0,0:23:22.92,0:23:23.84,Japonais,,0,0,0,,Бірақ...
Dialogue: 0,0:23:23.84,0:23:26.42,Japonais,,0,0,0,,Құдайдың не екенін білмейсің бе?
Dialogue: 0,0:23:29.63,0:23:30.34,Japonais,,0,0,0,,Whis
Dialogue: 0,0:23:31.05,0:23:35.35,Japonais,,0,0,0,,Жер планетасындағы Ханзада Вегета да супер Сайян ба?
Dialogue: 0,0:23:35.35,0:23:36.18,Japonais,,0,0,0,,Иә
Dialogue: 0,0:23:36.18,0:23:37.64,Japonais,,0,0,0,,3 басқалар
Dialogue: 0,0:23:37.64,0:23:39.89,Japonais,,0,0,0,,Әр адам мутацияға ұшырауы мүмкін
Dialogue: 0,0:23:39.89,0:23:42.44,Japonais,,0,0,0,,Сонымен... сіз соншалықты көп білдіңіз бе?
Dialogue: 0,0:23:43.61,0:23:46.98,Japonais,,0,0,0,,Олардың бәрі... Бұл күдікті...
Dialogue: 0,0:23:47.53,0:23:51.24,Japonais,,0,0,0,,Сондықтан мен Жерге барсам бірдеңе таба аламын ба деп ойлаймын...
Dialogue: 0,0:23:51.49,0:23:52.66,Japonais,,0,0,0,,Берус мырза
Dialogue: 0,0:23:52.66,0:23:56.37,Japonais,,0,0,0,,Басқа Сайандар да білмейді деп ойлаймын...
Dialogue: 0,0:23:56.37,0:23:59.58,Japonais,,0,0,0,,Мұқият тыңдамайынша білмейсің.
Dialogue: 0,0:23:59.96,0:24:02.75,Japonais,,0,0,0,,Бұл жерден Жерге дейінгі қашықтық қанша?
Dialogue: 0,0:24:02.75,0:24:04.92,Japonais,,0,0,0,,Шамамен 3 минут?
Dialogue: 0,0:24:04.92,0:24:07.00,Japonais,,0,0,0,,3 минут жақсы ма?
Dialogue: 0,0:24:07.00,0:24:07.75,Japonais,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:24:07.75,0:24:10.34,Japonais,,0,0,0,,Мүмкін мен... Жерге баруым керек шығар.
Dialogue: 0,0:24:10.34,0:24:11.34,Japonais,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:24:12.80,0:24:15.39,Japonais,,0,0,0,,Сіз оны жоймас едіңіз, солай ма?
Dialogue: 0,0:24:15.72,0:24:18.22,Japonais,,0,0,0,,Бұл сізді алаңдатпайынша
Dialogue: 0,0:24:18.22,0:24:19.47,Japonais,,0,0,0,,Онда!
Dialogue: 0,0:24:19.47,0:24:21.35,Japonais,,0,0,0,,Сіз... емес...
Dialogue: 0,0:24:21.69,0:24:24.65,Japonais,,0,0,0,,Мен Беерус-саманың шынымен керемет екенін естідім...
Dialogue: 0,0:24:25.02,0:24:27.15,Japonais,,0,0,0,,Маған аздап көрсете аласыз ба?
Dialogue: 0,0:24:27.15,0:24:27.90,Japonais,,0,0,0,,болып табылады
Dialogue: 0,0:24:28.40,0:24:30.53,Japonais,,0,0,0,,Менің күшімді көргің келе ме?
Dialogue: 0,0:24:30.90,0:24:31.99,Japonais,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:24:32.45,0:24:35.78,Japonais,,0,0,0,,Аз уақыт болса да менімен матч болғаныңызды қалаймын.
Dialogue: 0,0:24:35.78,0:24:37.99,Japonais,,0,0,0,,Гоку! Мені кінәлаңыз!
Dialogue: 0,0:24:37.99,0:24:40.08,Japonais,,0,0,0,,Мен ұзақ өмір сүрсем де
Dialogue: 0,0:24:40.08,0:24:43.71,Japonais,,0,0,0,,Мұндай ерекше жолды бірінші рет естіп тұрмын.
Dialogue: 0,0:24:44.08,0:24:46.17,Japonais,,0,0,0,,Сіз өте сенімдісіз...
Dialogue: 0,0:24:46.54,0:24:49.75,Japonais,,0,0,0,,Әлде сен ақымақсың ба?
Dialogue: 0,0:24:49.75,0:24:51.26,Japonais,,0,0,0,,Иә! ақымақ
Dialogue: 0,0:24:51.26,0:24:53.63,Japonais,,0,0,0,,Мен жай ғана ақымақпын.
Dialogue: 0,0:24:53.93,0:24:54.72,Japonais,,0,0,0,,Жарайды.
Dialogue: 0,0:24:55.59,0:24:58.30,Japonais,,0,0,0,,Олай болса! Маған толық қуатпен қоңырау шалыңыз
Dialogue: 0,0:24:58.30,0:25:00.60,Japonais,,0,0,0,,Рахмет! Жоқ...
Dialogue: 0,0:25:00.60,0:25:01.93,Japonais,,0,0,0,,Рахмет
Dialogue: 0,0:25:02.98,0:25:05.65,Japonais,,0,0,0,,Бірақ кенеттен толық қуатты пайдалану дұрыс па?
Dialogue: 0,0:25:06.02,0:25:10.03,Japonais,,0,0,0,,Маған ренжігенім үшін ашуланба... және бұл планетаны жойма.
Dialogue: 0,0:25:10.40,0:25:11.82,Japonais,,0,0,0,,Уәде берейік
Dialogue: 0,0:25:12.07,0:25:13.49,Japonais,,0,0,0,,Енді... өтінемін...
Dialogue: 0,0:25:20.45,0:25:21.33,Japonais,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:25:25.71,0:25:28.13,Japonais,,0,0,0,,Бірінші... бұл Супер Сайян
Dialogue: 0,0:25:32.51,0:25:35.13,Japonais,,0,0,0,,Және... Super Saiyan 2!
Dialogue: 0,0:25:46.69,0:25:51.02,Japonais,,0,0,0,,Бұл... ең күшті Super Saiyan 3!
Dialogue: 0,0:25:51.36,0:25:53.69,Japonais,,0,0,0,,Қашыңдар, көпіршіктер!
Dialogue: 0,0:25:55.82,0:25:57.07,Japonais,,0,0,0,,О, менің...
Dialogue: 0,0:25:57.07,0:25:58.49,Japonais,,0,0,0,,Бұл мені таң қалдырды...
Dialogue: 0,0:25:58.74,0:26:01.83,Japonais,,0,0,0,,Әрине, ол жай ғана сөйлеп тұрған сияқты емес...
Dialogue: 0,0:26:02.70,0:26:03.62,Japonais,,0,0,0,,Дұрыс па?
Dialogue: 0,0:26:03.79,0:26:06.25,Japonais,,0,0,0,,2-ге қайта оралуым керек пе?
Dialogue: 0,0:26:06.25,0:26:06.96,Japonais,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:26:06.96,0:26:08.71,Japonais,,0,0,0,,Оны сол күйінде қалдырыңыз...
Dialogue: 0,0:26:09.42,0:26:11.38,Japonais,,0,0,0,,Енді... бастайық...
Dialogue: 0,0:26:11.54,0:26:12.84,Japonais,,0,0,0,,Мені жалама...
Dialogue: 0,0:26:12.84,0:26:13.55,Japonais,,0,0,0,,Жарайды!
Dialogue: 0,0:27:38.26,0:27:39.84,Japonais,,0,0,0,,Кеттік
Dialogue: 0,0:27:39.84,0:27:40.88,Japonais,,0,0,0,,Жарайды
Dialogue: 0,0:27:41.63,0:27:43.72,Japonais,,0,0,0,,Кездескенше... Солтүстік патшасы Кай
Dialogue: 0,0:28:03.78,0:28:05.58,Japonais,,0,0,0,,Ол тірі болды ма? …
Dialogue: 0,0:28:05.58,0:28:07.58,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:28:18.09,0:28:19.01,Japonais,,0,0,0,,Иә.
Dialogue: 0,0:28:19.17,0:28:20.30,Japonais,,0,0,0,,Коуши Чаорен...
Dialogue: 0,0:28:20.30,0:28:23.43,Japonais,,0,0,0,,Мен Вегетаға тезірек айтуым керек...
Dialogue: 0,0:28:37.90,0:28:40.19,Japonais,,0,0,0,,Вегета, Кай патша!
Dialogue: 0,0:28:51.25,0:28:53.29,Japonais,,0,0,0,,Кай патша меннен не қалайды?
Dialogue: 0,0:28:53.46,0:28:55.50,Japonais,,0,0,0,,Менің айтайын деп тұрғанымды мұқият тыңдаңыз.
Dialogue: 0,0:28:55.63,0:28:59.30,Japonais,,0,0,0,,Жақында Жою құдайы Берус сонда болады.
Dialogue: 0,0:28:59.38,0:29:00.67,Japonais,,0,0,0,,Жою құдайы?
Dialogue: 0,0:29:01.34,0:29:03.51,Japonais,,0,0,0,,Бұл мен бұрын естіген есім...
Dialogue: 0,0:29:04.13,0:29:07.68,Japonais,,0,0,0,,Әйтеуір, ол жерге Беерус-сама келсе де.
Dialogue: 0,0:29:07.68,0:29:10.97,Japonais,,0,0,0,,Менімен ешқашан, ешқашан, ешқашан араласпа.
Dialogue: 0,0:29:11.18,0:29:13.14,Japonais,,0,0,0,,Әйтпесе, Жердің өзі...
Dialogue: 0,0:29:13.14,0:29:16.31,Japonais,,0,0,0,,...Оның соңы жоғалып кетеді.
Dialogue: 0,0:29:16.31,0:29:18.02,Japonais,,0,0,0,,Жер жойылып кете ме?
Dialogue: 0,0:29:18.11,0:29:21.48,Japonais,,0,0,0,,Гоку да қажетсіз нәрсе жасады және оңай жеңілді.
Dialogue: 0,0:29:21.48,0:29:23.65,Japonais,,0,0,0,,Не? Какарот?
Dialogue: 0,0:29:24.15,0:29:29.33,Japonais,,0,0,0,,Super Saiyan 3 Goku 2 рет түсіріп, жәндіктердің тынысын алады.
Dialogue: 0,0:29:29.33,0:29:30.70,Japonais,,0,0,0,,Тек екі ату...
Dialogue: 0,0:29:30.70,0:29:31.70,Japonais,,0,0,0,,ше?
Dialogue: 0,0:29:32.54,0:29:33.71,Japonais,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:29:34.08,0:29:37.08,Japonais,,0,0,0,,Жер тағдыры саған байланысты.
Dialogue: 0,0:29:46.72,0:29:48.34,Japonais,,0,0,0,,Керемет...
Dialogue: 0,0:29:48.72,0:29:51.06,Japonais,,0,0,0,,Мен мұндай адамның бар екеніне сене алмаймын...
Dialogue: 0,0:29:51.18,0:29:53.93,Japonais,,0,0,0,,Сондықтан мен сізге көп рет ескерттім.
Dialogue: 0,0:29:53.93,0:29:57.35,Japonais,,0,0,0,,Өлмегеніме шүкіршілік етемін...
Dialogue: 0,0:30:00.27,0:30:02.40,Japonais,,0,0,0,,Бұл одан да күшті...
Dialogue: 0,0:30:02.69,0:30:06.28,Japonais,,0,0,0,,Жалғыз нұсқа - Vegeta...
Dialogue: 0,0:30:06.28,0:30:06.99,Japonais,,0,0,0,,Жоқ…
Dialogue: 0,0:30:07.32,0:30:09.78,Japonais,,0,0,0,,Бұл жеңіс емес сияқты.
Dialogue: 0,0:30:10.95,0:30:14.75,Japonais,,0,0,0,,Жер бетіндегі адамдар қажетсіз ештеңе жасамайды деп үміттенемін.
Dialogue: 0,0:30:15.79,0:30:18.04,Japonais,,0,0,0,,Супер Сайян Құдайы...
Сіз
Dialogue: 0,0:30:18.29,0:30:20.04,Japonais,,0,0,0,,сияқты нәрсе айттыңыз ...
Dialogue: 0,0:30:20.54,0:30:21.54,Japonais,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:30:21.54,0:30:24.17,Japonais,,0,0,0,,Оқыту арқылы қол жеткізуге болатын нәрсе ме?
Dialogue: 0,0:30:24.76,0:30:25.76,Japonais,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:30:26.26,0:30:28.93,Japonais,,0,0,0,,Құдай есімді Сайян...
Dialogue: 0,0:30:28.93,0:30:30.30,Japonais,,0,0,0,,Тағы бірдеңе бар ма? …
Dialogue: 0,0:30:44.53,0:30:45.49,Japonais,,0,0,0,,Сензу бұршақтары?
Dialogue: 0,0:30:55.29,0:30:56.87,Japonais,,0,0,0,,Сауықты!!!
Dialogue: 0,0:30:59.83,0:31:00.88,Japonais,,0,0,0,,Кай патша
Dialogue: 0,0:31:00.88,0:31:03.25,Japonais,,0,0,0,,Мен жер бетіндегі барлық адамдарға білуім керек ...
Dialogue: 0,0:31:03.92,0:31:06.30,Japonais,,0,0,0,,Мен Вегетаға хабарладым...
Dialogue: 0,0:31:06.30,0:31:09.88,Japonais,,0,0,0,,Ол ең қажетсіз нәрселерді жасайтын адам...
Dialogue: 0,0:31:11.89,0:31:13.30,Japonais,,0,0,0,,Қауіпті көрінеді...
Dialogue: 0,0:31:13.30,0:31:15.31,Japonais,,0,0,0,,Жақында Жерге ораласыз ба?
Dialogue: 0,0:31:17.68,0:31:19.69,Japonais,,0,0,0,,Әлде жаттығу керек пе...
Dialogue: 0,0:31:24.40,0:31:26.65,Japonais,,0,0,0,,Сіз келдіңіз, Вегета...
Dialogue: 0,0:31:27.32,0:31:29.53,Japonais,,0,0,0,,Әйелімнің туған күнінде...
Dialogue: 0,0:31:29.53,0:31:31.78,Japonais,,0,0,0,,Неліктен жауынгерлік киім киіп жүрсің?
Dialogue: 0,0:31:31.99,0:31:34.62,Japonais,,0,0,0,,Не? Сіз шынымен көк түстіңіз бе?
Dialogue: 0,0:31:35.70,0:31:39.54,Japonais,,0,0,0,,Менің сүйікті жарымның тағы бір жасқа қартайғаны таң қалды ма?
Dialogue: 0,0:31:39.96,0:31:41.79,Japonais,,0,0,0,,Жарайды, Сайян...
Dialogue: 0,0:31:42.21,0:31:43.79,Japonais,,0,0,0,,Қартаюға болмайды
Dialogue: 0,0:31:45.75,0:31:47.30,Japonais,,0,0,0,,Аузыңды жап!!!
Dialogue: 0,0:31:50.43,0:31:52.09,Japonais,,0,0,0,,Неге үндемеу керек?
Dialogue: 0,0:31:52.64,0:31:54.93,Japonais,,0,0,0,,Бұл не? Бұл толқу
Dialogue: 0,0:31:55.43,0:31:58.18,Japonais,,0,0,0,,Мына Вегета-сама қорқыныштан дірілдеп тұр ма?
Dialogue: 0,0:31:59.14,0:32:00.94,Japonais,,0,0,0,,Не? Қазірдің өзінде...
Dialogue: 0,0:32:02.27,0:32:03.73,Japonais,,0,0,0,,Жою құдайы Берус...
Dialogue: 0,0:32:04.11,0:32:06.73,Japonais,,0,0,0,,Мен сені бір жерде кездестіргендей сезінемін...
Dialogue: 0,0:32:06.86,0:32:09.40,Japonais,,0,0,0,,Сәлем! Бұл ханзада Вегета ма?
Dialogue: 0,0:32:09.49,0:32:11.74,Japonais,,0,0,0,,Сіз ересек адам болдыңыз, солай емес пе?
Dialogue: 0,0:32:11.82,0:32:13.82,Japonais,,0,0,0,,Ки дегенді қалай түсінесіңдер?
Dialogue: 0,0:32:14.07,0:32:17.08,Japonais,,0,0,0,,Құдаймен тіл табыса алмайтын сияқтысың...
Dialogue: 0,0:32:17.95,0:32:19.95,Japonais,,0,0,0,,О... иә...
Dialogue: 0,0:32:28.63,0:32:30.92,Japonais,,0,0,0,,Вегета, не болды?
Dialogue: 0,0:32:38.81,0:32:40.48,Japonais,,0,0,0,,Есіңде ме?
Dialogue: 0,0:32:41.85,0:32:43.35,Japonais,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:32:43.73,0:32:45.52,Japonais,,0,0,0,,Мен соңғы рет кездестім...
Dialogue: 0,0:32:45.52,0:32:48.65,Japonais,,0,0,0,,Бұл сіздің кішкентай бала кезіңізде болды...
Dialogue: 0,0:32:49.53,0:32:51.15,Japonais,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:32:51.40,0:32:53.99,Japonais,,0,0,0,,Әкеңе, Вегета патшаға...
Dialogue: 0,0:32:53.99,0:32:58.33,Japonais,,0,0,0,,Маған үлкен той берілді.
Dialogue: 0,0:33:23.27,0:33:24.94,Japonais,,0,0,0,,Жою құдайы Берус...
Dialogue: 0,0:33:26.40,0:33:27.23,Japonais,,0,0,0,,…Мырза
Dialogue: 0,0:33:28.40,0:33:30.90,Japonais,,0,0,0,,Кай патшаның айтқаны асыра сілтеу немесе ештеңе де емес.
Dialogue: 0,0:33:31.19,0:33:33.44,Japonais,,0,0,0,,Бұл жігіт қауіпті, тым қауіпті.
Dialogue: 0,0:33:34.53,0:33:35.53,Japonais,,0,0,0,,Не?
Dialogue: 0,0:33:35.57,0:33:37.74,Japonais,,0,0,0,,Сіз қызықты нәрсе істеп жатқан сияқтысыз.
Dialogue: 0,0:33:38.37,0:33:40.83,Japonais,,0,0,0,,Және оның иісі өте жақсы.
Dialogue: 0,0:33:41.99,0:33:44.96,Japonais,,0,0,0,,Бұл менің әйелімнің туған күні.
Dialogue: 0,0:33:45.29,0:33:46.46,Japonais,,0,0,0,,Сіздің әйеліңіз?
Dialogue: 0,0:33:46.46,0:33:48.88,Japonais,,0,0,0,,Олай болса, сәлем беруім керек...
Dialogue: 0,0:33:49.38,0:33:50.38,Japonais,,0,0,0,,Лорд Берус
Dialogue: 0,0:33:51.05,0:33:52.88,Japonais,,0,0,0,,Дұрыс... маңыздысы
Dialogue: 0,0:33:55.05,0:33:55.97,Japonais,,0,0,0,,Сіз...
Dialogue: 0,0:33:56.05,0:33:59.97,Japonais,,0,0,0,,Super Saiyan God атауы таныс естіледі ме?
Dialogue: 0,0:34:00.05,0:34:01.85,Japonais,,0,0,0,,Супер Сайян Құдайы ма?
Dialogue: 0,0:34:02.35,0:34:03.64,Japonais,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:34:03.98,0:34:06.73,Japonais,,0,0,0,,Прекогнитивті армандар дұрыс емес пе?
Dialogue: 0,0:34:06.77,0:34:08.40,Japonais,,0,0,0,,Маған ешнәрсе жоқ!
Dialogue: 0,0:34:10.44,0:34:12.15,Japonais,,0,0,0,,Олар өте аз.
Dialogue: 0,0:34:12.15,0:34:14.32,Japonais,,0,0,0,,Мен аздап тітіркеніп барамын.
Dialogue: 0,0:34:15.15,0:34:15.90,Japonais,,0,0,0,,О!
Dialogue: 0,0:34:15.90,0:34:18.24,Japonais,,0,0,0,,Вегета әйеліне аузын жабуды бұйырды
Dialogue: 0,0:34:18.24,0:34:19.32,Japonais,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:34:20.32,0:34:21.49,Japonais,,0,0,0,,Бұл...
Dialogue: 0,0:34:21.49,0:34:22.74,Japonais,,0,0,0,,Беерус-сан және...
Dialogue: 0,0:34:22.74,0:34:24.08,Japonais,,0,0,0,,Менің атым Уис.
Dialogue: 0,0:34:24.45,0:34:26.08,Japonais,,0,0,0,,Ал, сендер бір-біріңді білесіңдер ме?
Dialogue: 0,0:34:26.29,0:34:29.88,Japonais,,0,0,0,,Сәлеметсіз бе, мен Булма Вегетаның...
Dialogue: 0,0:34:30.25,0:34:31.88,Japonais,,0,0,0,,Әдемі әйел
Dialogue: 0,0:34:31.88,0:34:34.01,Japonais,,0,0,0,,Сәлем Бұлма-сан
Dialogue: 0,0:34:34.01,0:34:37.68,Japonais,,0,0,0,,О...олар сенің таныстарың ретінде болатын классикалық адамдар.
Dialogue: 0,0:34:37.68,0:34:40.93,Japonais,,0,0,0,,Бірақ мен оны Жерден емес деп ойлаймын.
Dialogue: 0,0:34:40.93,0:34:43.06,Japonais,,0,0,0,,Сіз бөтен адамсыз ба? бөтен
Dialogue: 0,0:34:43.06,0:34:44.60,Japonais,,0,0,0,,Сондай-ақ...жеткілікті, солай ма?
Dialogue: 0,0:34:44.60,0:34:49.02,Japonais,,0,0,0,,Жерге кездейсоқ тоқтағанымда, мен Вегетаны көрдім.
Dialogue: 0,0:34:49.02,0:34:50.19,Japonais,,0,0,0,,Бұл туризм ме?
Dialogue: 0,0:34:50.19,0:34:52.44,Japonais,,0,0,0,,Қарсы болмасаң, менімен кешке барғың келе ме?
Dialogue: 0,0:34:52.90,0:34:54.53,Japonais,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:34:54.53,0:34:55.07,Japonais,,0,0,0,,Эй...эй!
Dialogue: 0,0:34:55.44,0:34:57.40,Japonais,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:34:58.32,0:35:02.49,Japonais,,0,0,0,,Негізі, мен біраз уақыттан бері өте дәмді тағамды байқадым.
Dialogue: 0,0:35:04.12,0:35:05.95,Japonais,,0,0,0,,Өтінемін! Өтінемін...
Dialogue: 0,0:35:07.00,0:35:10.33,Japonais,,0,0,0,,Жүр... жүр, кеттік.
Dialogue: 0,0:35:34.36,0:35:36.23,Japonais,,0,0,0,,Сәлем! Сол құбыжық мысық!
Dialogue: 0,0:35:36.23,0:35:38.53,Japonais,,0,0,0,,Сіз қалай ойлайсыз? Менімен жарысқыңыз келе ме?
Dialogue: 0,0:35:39.28,0:35:40.24,Japonais,,0,0,0,,Жарыс?
Dialogue: 0,0:35:40.24,0:35:41.45,Japonais,,0,0,0,,Ах... анау ақымақ!
Dialogue: 0,0:35:41.70,0:35:43.99,Japonais,,0,0,0,,Мен күштімін!
Dialogue: 0,0:35:45.03,0:35:47.62,Japonais,,0,0,0,,Әкем ұялып қалды.
Dialogue: 0,0:35:47.95,0:35:50.12,Japonais,,0,0,0,,Кешіріңіз... дөрекілік үшін...
Dialogue: 0,0:36:09.93,0:36:12.35,Japonais,,0,0,0,,Ол қайда? Айдаһар добы!
Dialogue: 0,0:36:22.03,0:36:23.07,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:36:23.45,0:36:25.74,Japonais,,0,0,0,,Егер сіз қатты дыбыс шығарсаңыз, адамдар сізді байқайды!
Dialogue: 0,0:36:25.74,0:36:27.12,Japonais,,0,0,0,,бұл... иә!
Dialogue: 0,0:36:42.51,0:36:45.47,Japonais,,0,0,0,,Бұл ақымақ үлкен үй!
Dialogue: 0,0:36:48.64,0:36:49.93,Japonais,,0,0,0,,Тітіркендіргіш!
Dialogue: 0,0:36:49.93,0:36:50.85,Japonais,,0,0,0,,Кешіріңіз
Dialogue: 0,0:36:50.85,0:36:51.98,Japonais,,0,0,0,,Такумо!
Dialogue: 0,0:36:52.48,0:36:53.94,Japonais,,0,0,0,,Жердің қай жерінде?
Dialogue: 0,0:36:53.94,0:36:55.52,Japonais,,0,0,0,,Айдаһар добы ше?
Dialogue: 0,0:36:55.86,0:36:58.77,Japonais,,0,0,0,,Барлық жеті зат осында болуы керек...
Dialogue: 0,0:36:58.98,0:37:01.24,Japonais,,0,0,0,,Тілектеріңіз неге орындалмайтынын түсінбеймін.
Dialogue: 0,0:37:01.24,0:37:03.28,Japonais,,0,0,0,,Біз бақыттымыз.
Dialogue: 0,0:37:05.66,0:37:06.66,Japonais,,0,0,0,,Келесі мақсат...
Dialogue: 0,0:37:06.66,0:37:08.03,Japonais,,0,0,0,,Ол өте бай!!!
Dialogue: 0,0:37:09.08,0:37:11.29,Japonais,,0,0,0,,Дүниенің үстемдігі емес пе?
Dialogue: 0,0:37:11.79,0:37:14.62,Japonais,,0,0,0,,Біріншіден, көп ақша алыңыз.
Dialogue: 0,0:37:14.87,0:37:17.29,Japonais,,0,0,0,,Жоқшылыққа тойдым.
Dialogue: 0,0:37:17.67,0:37:22.55,Japonais,,0,0,0,,Егер сіз балаға ұқсайтын болсаңыз, сізді толық емес жұмысқа да алмайды!
Dialogue: 0,0:37:25.84,0:37:29.22,Japonais,,0,0,0,,Мен... Палау патшасымын!
Dialogue: 0,0:37:31.81,0:37:35.85,Japonais,,0,0,0,,Өткен күні Шенрон менің тілегімді орындады...
Dialogue: 0,0:37:36.10,0:37:40.11,Japonais,,0,0,0,,Палау-сама сені кішірейтейін деді.
Dialogue: 0,0:37:40.11,0:37:41.48,Japonais,,0,0,0,,Бірақ...бірақ...
Dialogue: 0,0:37:41.48,0:37:45.65,Japonais,,0,0,0,,Өліп қалсаң, қария боп дүниені жаулағанның мәні жоқ.
Dialogue: 0,0:37:45.74,0:37:47.95,Japonais,,0,0,0,,Алайда мен тым жас болып бара жатырмын.
Dialogue: 0,0:37:48.28,0:37:49.49,Japonais,,0,0,0,,Мен құтқарылдым
Dialogue: 0,0:37:49.62,0:37:52.04,Japonais,,0,0,0,,Ол иттің өмірінен әлдеқашан асып кетті.
Dialogue: 0,0:37:55.29,0:37:58.63,Japonais,,0,0,0,,Араласуды доғарыңыз және Айдаһар шарларын тез табыңыз!
Dialogue: 0,0:37:58.75,0:38:01.63,Japonais,,0,0,0,,Ең нашар болса, мен оған тұрарлық нәрсені аламын.
Dialogue: 0,0:38:08.09,0:38:09.30,Japonais,,0,0,0,,Пи...Палау-сама
Dialogue: 0,0:38:09.35,0:38:10.10,Japonais,,0,0,0,,Не?
Dialogue: 0,0:38:10.85,0:38:11.56,Japonais,,0,0,0,,Бұл...бұл...
Dialogue: 0,0:38:12.93,0:38:14.06,Japonais,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,0:38:16.19,0:38:18.35,Japonais,,0,0,0,,Бинго жүлдесі?
Dialogue: 0,0:38:28.66,0:38:29.57,Japonais,,0,0,0,,Жер
Dialogue: 0,0:38:29.57,0:38:30.57,Japonais,,0,0,0,,Осының бәрі?
Dialogue: 0,0:38:30.57,0:38:32.37,Japonais,,0,0,0,,Бұл жүлде ме? ?
Dialogue: 0,0:38:32.37,0:38:34.58,Japonais,,0,0,0,,Құлып - бұл жүлде! ?
Dialogue: 0,0:38:34.83,0:38:35.75,Japonais,,0,0,0,,Уау...
Dialogue: 0,0:38:35.75,0:38:38.50,Japonais,,0,0,0,,Қарғыс атсын... не деген ысырапшылдар.
Dialogue: 0,0:38:41.59,0:38:44.17,Japonais,,0,0,0,,Мен дудл жасаймын!
Dialogue: 0,0:38:49.93,0:38:51.22,Japonais,,0,0,0,,Бұл әдепсіз
Dialogue: 0,0:38:53.64,0:38:54.60,Japonais,,0,0,0,,Асығыңыз!
Dialogue: 0,0:38:56.39,0:38:58.98,Japonais,,0,0,0,,Айдаһар добы осында жасырылған болуы керек.
Dialogue: 0,0:38:59.02,0:39:00.27,Japonais,,0,0,0,,Оны табыңыз!
Dialogue: 0,0:39:18.00,0:39:20.29,Japonais,,0,0,0,,Бұл қамалдың ішінде болуы мүмкін бе?
Dialogue: 0,0:39:20.54,0:39:21.75,Japonais,,0,0,0,,Құрметті палау!
Dialogue: 0,0:39:22.42,0:39:23.34,Japonais,,0,0,0,,Warm! ?
Dialogue: 0,0:39:23.34,0:39:27.30,Japonais,,0,0,0,,Қатысу жүлдесі - ең жақсы ветчинаның 10 жылдық ассортименті!
Dialogue: 0,0:39:29.72,0:39:31.72,Japonais,,0,0,0,,Маған 2-3 қорап беріңізші.
Dialogue: 0,0:39:33.14,0:39:34.56,Japonais,,0,0,0,,Екінші жүлдені түртіңіз
Dialogue: 0,0:39:37.81,0:39:40.39,Japonais,,0,0,0,,Қандай ақымақ үлкен гауһар!
Dialogue: 0,0:39:40.48,0:39:42.02,Japonais,,0,0,0,,Қабыл ал!
Dialogue: 0,0:39:42.02,0:39:44.15,Japonais,,0,0,0,,Бірақ бұл екінші жүлде болса...
Dialogue: 0,0:39:44.15,0:39:45.44,Japonais,,0,0,0,,Бірінші жүлде...
Dialogue: 0,0:39:50.03,0:39:51.82,Japonais,,0,0,0,,Сіз оны оңай таптыңыз.
Dialogue: 0,0:39:52.03,0:39:52.99,Japonais,,0,0,0,,Палау-сама
Dialogue: 0,0:39:53.07,0:39:56.83,Japonais,,0,0,0,,Уау...шынымен бізде олардың 7-сі де бар!
Dialogue: 0,0:39:56.83,0:40:00.29,Japonais,,0,0,0,,Иә! Алақай! Ура! Ура!
Dialogue: 0,0:40:00.33,0:40:03.13,Japonais,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:40:03.13,0:40:04.04,Japonais,,0,0,0,,Палау-сама
Dialogue: 0,0:40:04.04,0:40:06.55,Japonais,,0,0,0,,Енді тілегімізді орындайық.
Dialogue: 0,0:40:08.13,0:40:09.09,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:40:09.26,0:40:11.26,Japonais,,0,0,0,,Шенронды осындай жерге жіберсем ше?
Dialogue: 0,0:40:11.34,0:40:13.43,Japonais,,0,0,0,,Төбе құлап қалады, солай ма?
Dialogue: 0,0:40:13.43,0:40:14.85,Japonais,,0,0,0,,Сәлем? Сіз жігіттер!
Dialogue: 0,0:40:17.85,0:40:20.18,Japonais,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:40:21.44,0:40:22.48,Japonais,,0,0,0,,Біз
Dialogue: 0,0:40:22.48,0:40:24.77,Japonais,,0,0,0,,Мұнда балалардың достары
Dialogue: 0,0:40:25.23,0:40:26.48,Japonais,,0,0,0,,Менің досым?
Dialogue: 0,0:40:27.44,0:40:29.40,Japonais,,0,0,0,,Әй... сен осы үйдің баласысың ба?
Dialogue: 0,0:40:29.53,0:40:30.99,Japonais,,0,0,0,,Маймыл сөйледі!
Dialogue: 0,0:40:33.41,0:40:34.70,Japonais,,0,0,0,,Маймыл кім?
Dialogue: 0,0:40:34.70,0:40:37.20,Japonais,,0,0,0,,Мен палау патшамын!
Dialogue: 0,0:40:38.87,0:40:41.08,Japonais,,0,0,0,,Біз ұрылар үшін осындамыз.
Dialogue: 0,0:40:41.08,0:40:43.58,Japonais,,0,0,0,,Шын есіміңді айтқанда не істейсің?
Dialogue: 0,0:40:44.67,0:40:45.88,Japonais,,0,0,0,,Сәлем! Готен!
Dialogue: 0,0:40:45.88,0:40:47.34,Japonais,,0,0,0,,Мұнда кел!
Dialogue: 0,0:40:47.34,0:40:49.13,Japonais,,0,0,0,,Бір көңілді маймыл бар!
Dialogue: 0,0:40:49.13,0:40:50.05,Japonais,,0,0,0,,Маймыл емес!
Dialogue: 0,0:40:50.88,0:40:52.63,Japonais,,0,0,0,,Ей, балам, үндеме!
Dialogue: 0,0:40:53.05,0:40:54.64,Japonais,,0,0,0,,Ауырсынуды қалайсыз ба?
Dialogue: 0,0:40:54.80,0:40:55.59,Japonais,,0,0,0,,Не?
Dialogue: 0,0:40:56.18,0:40:56.89,Japonais,,0,0,0,,Қараңдар!
Dialogue: 0,0:40:58.81,0:41:01.23,Japonais,,0,0,0,,Ах... бұл ерекше шаш үлгісі...
Dialogue: 0,0:41:01.81,0:41:04.27,Japonais,,0,0,0,,Бұл өте таныс көрінеді
Dialogue: 0,0:41:04.81,0:41:08.48,Japonais,,0,0,0,,Мм... бейкүнә көрінетін сол көздер ме?
Dialogue: 0,0:41:08.82,0:41:11.40,Japonais,,0,0,0,,Бұл өте таныс сияқты!
Dialogue: 0,0:41:11.65,0:41:13.45,Japonais,,0,0,0,,Мынау... бала ма?
Dialogue: 0,0:41:13.53,0:41:15.20,Japonais,,0,0,0,,Нағыз тамаша маймыл!
Dialogue: 0,0:41:18.37,0:41:22.50,Japonais,,0,0,0,,Кетіңіз!
Dialogue: 0,0:41:37.68,0:41:39.10,Japonais,,0,0,0,,Мұны істе!
Dialogue: 0,0:41:46.10,0:41:48.94,Japonais,,0,0,0,,Палау, күте тұрыңыз!
Dialogue: 0,0:41:51.15,0:41:54.19,Japonais,,0,0,0,,Уау! Бұл шынымен де біртүрлі маймыл мен ит болды.
Dialogue: 0,0:41:55.95,0:41:59.74,Japonais,,0,0,0,,Сәлем? Әдемі тасты сыйлыққа берген қыз кім болды?
Dialogue: 0,0:41:59.74,0:42:01.70,Japonais,,0,0,0,,Сіз Транкстың досысыз ба?
Dialogue: 0,0:42:01.70,0:42:02.95,Japonais,,0,0,0,,Не болды саған, жексұрын? Неге күліп тұрсың!
Dialogue: 0,0:42:03.20,0:42:04.79,Japonais,,0,0,0,,Менің қызым
Dialogue: 0,0:42:05.71,0:42:07.75,Japonais,,0,0,0,,Сіз қалай ойлайсыз? Бұл таңқаларлық емес пе?
Dialogue: 0,0:42:07.75,0:42:09.71,Japonais,,0,0,0,,Бұл кездесіп жүргеніңізді білдіре ме?
Dialogue: 0,0:42:10.04,0:42:11.30,Japonais,,0,0,0,,Жақсы... жақсы.
Dialogue: 0,0:42:11.30,0:42:13.59,Japonais,,0,0,0,,Тіпті қол ұстасып қалдық.
Dialogue: 0,0:42:13.71,0:42:15.55,Japonais,,0,0,0,,Керемет!!!
Dialogue: 0,0:42:15.55,0:42:16.97,Japonais,,0,0,0,,Ал... жақсы!
Dialogue: 0,0:42:17.47,0:42:18.72,Japonais,,0,0,0,,Бұл керемет!!!
Dialogue: 0,0:42:27.39,0:42:29.90,Japonais,,0,0,0,,Қат! Ол неге мұнда?
Dialogue: 0,0:42:29.94,0:42:31.94,Japonais,,0,0,0,,Ол да әлі бала еді!
Dialogue: 0,0:42:31.94,0:42:36.28,Japonais,,0,0,0,,Сізге рахмет, мен Айдаһар допын ала алмадым.
Dialogue: 0,0:42:39.32,0:42:40.66,Japonais,,0,0,0,,Не? жиіркенішті
Dialogue: 0,0:42:40.66,0:42:42.03,Japonais,,0,0,0,,Қараңыз...
Dialogue: 0,0:42:42.28,0:42:43.37,Japonais,,0,0,0,,Қараңдар! Бұл!
Dialogue: 0,0:42:44.79,0:42:48.46,Japonais,,0,0,0,,Мен оларды гауһар тастармен соқырладым.
Dialogue: 0,0:42:48.79,0:42:52.84,Japonais,,0,0,0,,Олар төрт жұлдызды доптың ұрланғанын байқамайды да.
Dialogue: 0,0:42:55.34,0:42:56.92,Japonais,,0,0,0,,Үлкен менің!
Dialogue: 0,0:42:56.92,0:42:57.80,Japonais,,0,0,0,,Иә!
Dialogue: 0,0:42:57.80,0:42:58.97,Japonais,,0,0,0,,"Ол жағдайды өз әдісімен шешуге тырысты."
Dialogue: 0,0:42:58.97,0:43:01.43,Japonais,,0,0,0,,Бір ғана тілек орындалмайды.
Dialogue: 0,0:43:01.43,0:43:03.64,Japonais,,0,0,0,,Уайымдамаңыз, палау мырза.
Dialogue: 0,0:43:03.97,0:43:05.93,Japonais,,0,0,0,,Егер сіз бұл жігітті қайтарғыңыз келсе...
Dialogue: 0,0:43:06.39,0:43:08.77,Japonais,,0,0,0,,Мен саған 1 миллион зенни беремін!
Dialogue: 0,0:43:08.81,0:43:11.11,Japonais,,0,0,0,,...мен соны талап етіп отырмын!
Dialogue: 0,0:43:11.11,0:43:13.11,Japonais,,0,0,0,,Түсіндім!
Dialogue: 0,0:43:13.19,0:43:14.98,Japonais,,0,0,0,,Менің сен данышпансың!
Dialogue: 0,0:43:14.98,0:43:16.44,Japonais,,0,0,0,,Сен үлкен арамза
Dialogue: 0,0:43:16.53,0:43:18.82,Japonais,,0,0,0,,Жоқ, палау-сама сияқты емес.
Dialogue: 0,0:43:20.07,0:43:24.58,Japonais,,0,0,0,,Олай болса, бұл гауһар тастың құны 10 миллиард ценниден асатын емес пе?
Dialogue: 0,0:43:37.55,0:43:38.63,Japonais,,0,0,0,,А...мм...
Dialogue: 0,0:43:38.63,0:43:40.09,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:43:40.18,0:43:43.39,Japonais,,0,0,0,,Керісінше, осындай қомақты ақшаға келгенде қобалжымайсыз ба?
Dialogue: 0,0:43:43.80,0:43:44.56,Japonais,,0,0,0,,Дұрыс!
Dialogue: 0,0:43:44.56,0:43:46.56,Japonais,,0,0,0,,Мен қобалжып, несеп ағып кетсе ше?
Dialogue: 0,0:43:46.56,0:43:48.52,Japonais,,0,0,0,,Менің шалбарымды жуайын деп жатырсың ба?
Dialogue: 0,0:43:51.10,0:43:53.48,Japonais,,0,0,0,,Ағымдағы мысал туралы не айтасыз?
Dialogue: 0,0:43:53.52,0:43:55.65,Japonais,,0,0,0,,Менің ойымша, бұл сәл дәмсіз болды.
Dialogue: 0,0:43:56.53,0:43:57.90,Japonais,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:43:59.44,0:44:00.28,Japonais,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:44:04.03,0:44:06.03,Japonais,,0,0,0,,Бұл ол! Сен не туралы айтып тұрсың?
Dialogue: 0,0:44:11.75,0:44:14.84,Japonais,,0,0,0,,Бұл қыз Транкстың сүйіктісі ме?
Dialogue: 0,0:44:15.00,0:44:17.42,Japonais,,0,0,0,,Кімнің қанынан тарағаныңды білмеймін?
Dialogue: 0,0:44:17.55,0:44:19.13,Japonais,,0,0,0,,Бұрышқа қоюға болмайтын бала.
Dialogue: 0,0:44:19.17,0:44:20.80,Japonais,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:44:20.80,0:44:22.05,Japonais,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:44:22.05,0:44:23.84,Japonais,,0,0,0,,Жақсы... жақсы!
Dialogue: 0,0:44:23.84,0:44:25.35,Japonais,,0,0,0,,Маған осында қоңырау шалыңыз.
Dialogue: 0,0:44:30.68,0:44:34.73,Japonais,,0,0,0,,Жаңа ғана аспанға ұшып кеттің бе, кішкентай бала?
Dialogue: 0,0:44:34.77,0:44:36.11,Japonais,,0,0,0,,Одан жақсырақ.
Dialogue: 0,0:44:36.11,0:44:36.69,Japonais,,0,0,0,,Мен...
Dialogue: 0,0:44:36.69,0:44:39.07,Japonais,,0,0,0,,Сіз туралы, мен жай ғана салқын болуға тырысамын...
Dialogue: 0,0:44:39.07,0:44:41.78,Japonais,,0,0,0,,Сіз менің қызым деп айттыңыз...
Dialogue: 0,0:44:41.99,0:44:43.20,Japonais,,0,0,0,,Мен ше?
Dialogue: 0,0:44:43.41,0:44:44.49,Japonais,,0,0,0,,Сіз емес!
Dialogue: 0,0:44:44.49,0:44:45.20,Japonais,,0,0,0,,Мен?
Dialogue: 0,0:44:45.32,0:44:46.58,Japonais,,0,0,0,,Неліктен?
Dialogue: 0,0:44:46.58,0:44:47.83,Japonais,,0,0,0,,Мына қыз!
Dialogue: 0,0:44:49.33,0:44:50.04,Japonais,,0,0,0,,Мен?
Dialogue: 0,0:44:50.95,0:44:53.58,Japonais,,0,0,0,,Мен де сен сияқты баламын ба?
Dialogue: 0,0:44:53.71,0:44:55.58,Japonais,,0,0,0,,Сіз жай ғана баласыз, солай емес пе?
Dialogue: 0,0:44:56.84,0:44:57.59,Japonais,,0,0,0,,Иә?
Dialogue: 0,0:44:57.79,0:44:58.88,Japonais,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:44:59.09,0:45:01.38,Japonais,,0,0,0,,Менің дос қызым болып көрін.
Dialogue: 0,0:45:01.55,0:45:03.13,Japonais,,0,0,0,,Сенің қызың болып көріну
Dialogue: 0,0:45:03.38,0:45:04.80,Japonais,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:45:04.80,0:45:07.22,Japonais,,0,0,0,,Ал... қол ұстасып... т.б.
Dialogue: 0,0:45:07.22,0:45:08.06,Japonais,,0,0,0,,Қол... қол?
Dialogue: 0,0:45:08.43,0:45:09.22,Japonais,,0,0,0,,Жоқ
Dialogue: 0,0:45:09.81,0:45:11.98,Japonais,,0,0,0,,Қазіргі балалар қандай құқық бұзушылар?
Dialogue: 0,0:45:12.35,0:45:14.90,Japonais,,0,0,0,,Қалағаныңызша жеуге болады.
Dialogue: 0,0:45:14.90,0:45:15.90,Japonais,,0,0,0,,Мереке!
Dialogue: 0,0:45:16.69,0:45:18.86,Japonais,,0,0,0,,Тіпті бинго турнирі де бар.
Dialogue: 0,0:45:18.86,0:45:20.40,Japonais,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:45:20.57,0:45:21.07,Japonais,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:45:21.07,0:45:22.49,Japonais,,0,0,0,,Сәл күтіңіз...
Dialogue: 0,0:45:23.32,0:45:24.20,Japonais,,0,0,0,,Құрметті палау...
Dialogue: 0,0:45:24.20,0:45:25.78,Japonais,,0,0,0,,Қанша жас болсаң да...
Dialogue: 0,0:45:25.78,0:45:29.49,Japonais,,0,0,0,,Маған, бірінші кездескен күнімізде қол ұстасу үшін!
Dialogue: 0,0:45:29.53,0:45:30.37,Japonais,,0,0,0,,Сіз
Dialogue: 0,0:45:30.58,0:45:32.50,Japonais,,0,0,0,,Негізі, қазірдің өзінде жақсы жыл емес пе?
Dialogue: 0,0:45:32.50,0:45:35.25,Japonais,,0,0,0,,Палау туралы қандай жақсы және жаман сөздер айтуға болады?
Dialogue: 0,0:45:36.00,0:45:37.38,Japonais,,0,0,0,,Жасай бер, менің
Dialogue: 0,0:45:37.38,0:45:39.38,Japonais,,0,0,0,,Бұл мерекеге және бингоға арналған.
Dialogue: 0,0:45:39.38,0:45:42.34,Japonais,,0,0,0,,Сосын... Айдаһар шарлары
Dialogue: 0,0:45:43.26,0:45:46.34,Japonais,,0,0,0,,Мен ол ханымды бір жерден көргенмін.
Dialogue: 0,0:45:58.77,0:46:01.02,Japonais,,0,0,0,,Ах... сол кезде!
Dialogue: 0,0:46:01.94,0:46:04.07,Japonais,,0,0,0,,Өйткені, бұл рас!
Dialogue: 0,0:46:04.28,0:46:07.20,Japonais,,0,0,0,,Бұрынғы баламен бірге болдым.
Dialogue: 0,0:46:08.74,0:46:10.78,Japonais,,0,0,0,,Менде мүлдем жаман сезім бар.
Dialogue: 0,0:46:11.20,0:46:12.37,Japonais,,0,0,0,,Келіңіздер! барайық!
Dialogue: 0,0:46:12.37,0:46:14.04,Japonais,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:46:16.08,0:46:18.92,Japonais,,0,0,0,,Бұл Такояки деп аталатын доп қызық.
Dialogue: 0,0:46:21.25,0:46:22.59,Japonais,,0,0,0,,Бұл өте дәмді.
Dialogue: 0,0:46:22.59,0:46:26.51,Japonais,,0,0,0,,Соустың дәмі де, соя соусының дәмі де жақсы.
Dialogue: 0,0:46:27.97,0:46:29.59,Japonais,,0,0,0,,Менің атым Май Чан.
Dialogue: 0,0:46:29.89,0:46:31.56,Japonais,,0,0,0,,Май Чан неше жаста?
Dialogue: 0,0:46:31.56,0:46:32.64,Japonais,,0,0,0,,41
Dialogue: 0,0:46:34.18,0:46:36.23,Japonais,,0,0,0,,Үлкендерді мазақ ету дұрыс емес.
Dialogue: 0,0:46:40.98,0:46:42.94,Japonais,,0,0,0,,«Ка…»
Dialogue: 0,0:46:43.57,0:46:45.57,Japonais,,0,0,0,,Мен…
Dialogue: 0,0:46:46.53,0:46:48.57,Japonais,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:46:48.99,0:46:50.91,Japonais,,0,0,0,,Мен…
Dialogue: 0,0:46:50.91,0:46:53.45,Japonais,,0,0,0,,Оны жоюды доғарыңыз.
Dialogue: 0,0:46:53.95,0:46:56.54,Japonais,,0,0,0,,Толқындар!
Dialogue: 0,0:47:17.77,0:47:19.64,Japonais,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:47:25.69,0:47:26.65,Japonais,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:47:26.65,0:47:28.20,Japonais,,0,0,0,,Мынадай
Dialogue: 0,0:47:28.45,0:47:30.16,Japonais,,0,0,0,,Сіз жойқын Құдайға қарсы жеңе алмайсыз
Dialogue: 0,0:47:30.91,0:47:33.53,Japonais,,0,0,0,,Беерус-сама одан да күшті болды.
Dialogue: 0,0:47:36.08,0:47:37.79,Japonais,,0,0,0,,Сәлем Кай патша
Dialogue: 0,0:47:39.25,0:47:41.92,Japonais,,0,0,0,,Бұл аз ғана жаттығу.
Dialogue: 0,0:47:42.08,0:47:45.38,Japonais,,0,0,0,,Қарашы, мен Супер Сайян Құдайы бола алмаймын.
Dialogue: 0,0:47:47.26,0:47:48.42,Japonais,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:47:48.42,0:47:50.34,Japonais,,0,0,0,,Ол мүлдем көрсетілмейді.
Dialogue: 0,0:47:50.34,0:47:52.30,Japonais,,0,0,0,,Супер Сайян Құдайы
Dialogue: 0,0:47:53.30,0:47:56.18,Japonais,,0,0,0,,Мен оны асыға күтетінмін.
Dialogue: 0,0:47:57.64,0:47:59.94,Japonais,,0,0,0,,Менің естігенім бойынша, Сайян болса да...
Dialogue: 0,0:47:59.94,0:48:02.23,Japonais,,0,0,0,,Сон Гоку мен Вегетадан басқа.
Dialogue: 0,0:48:02.23,0:48:04.65,Japonais,,0,0,0,,Ол жартылай Жерге ұқсайды.
Dialogue: 0,0:48:04.86,0:48:07.23,Japonais,,0,0,0,,Олардың екеуі әлі бала.
Dialogue: 0,0:48:09.53,0:48:14.87,Japonais,,0,0,0,,Енді ең қызықты бинго турнирінің уақыты келді!
Dialogue: 0,0:48:15.37,0:48:18.20,Japonais,,0,0,0,,Құлыптар мен ұшақтар тамаша жүлде.
Dialogue: 0,0:48:18.87,0:48:21.71,Japonais,,0,0,0,,Ең бастысы...
Dialogue: 0,0:48:22.12,0:48:22.96,Japonais,,0,0,0,,Шекара!
Dialogue: 0,0:48:22.96,0:48:25.54,Japonais,,0,0,0,,Барлық жеті айдаһар шары!
Dialogue: 0,0:48:25.75,0:48:26.92,Japonais,,0,0,0,,Жеңіске жеткенде не болады?
Dialogue: 0,0:48:26.92,0:48:29.88,Japonais,,0,0,0,,Тек сүйікті тілегіңізді орындаңыз
Dialogue: 0,0:48:34.09,0:48:37.60,Japonais,,0,0,0,,Бұл шар Намек планетасының тілек допына ұқсайды.
Dialogue: 0,0:48:38.22,0:48:41.18,Japonais,,0,0,0,,Жер құдайы Намекиан сияқты.
Dialogue: 0,0:48:41.18,0:48:44.35,Japonais,,0,0,0,,Егер есімде дұрыс болса, сол тілек шарының ішінен айдаһар шықты.
Dialogue: 0,0:48:44.35,0:48:47.27,Japonais,,0,0,0,,Ол кез келген тілегін орындай алатын.
Dialogue: 0,0:48:48.69,0:48:49.99,Japonais,,0,0,0,,Сәлем! Бір минут күтіңіз!
Dialogue: 0,0:48:50.82,0:48:52.95,Japonais,,0,0,0,,Бір Айдаһар добы жоқ па?
Dialogue: 0,0:48:54.16,0:48:55.87,Japonais,,0,0,0,,Төрт жұлдызды доп жоқ!
Dialogue: 0,0:48:55.87,0:48:56.49,Japonais,,0,0,0,,Өтірік!
Dialogue: 0,0:48:56.49,0:48:58.74,Japonais,,0,0,0,,Осы уақытқа дейін менде бәрі болды.
Dialogue: 0,0:48:58.83,0:49:00.50,Japonais,,0,0,0,,Сәлем! Сіз қазірдің өзінде кетесіз бе?
Dialogue: 0,0:49:00.50,0:49:02.96,Japonais,,0,0,0,,Маған ұялы телефон нөмірімді айтыңызшы.
Dialogue: 0,0:49:03.87,0:49:06.08,Japonais,,0,0,0,,Менде онша қымбат ештеңе жоқ!
Dialogue: 0,0:49:06.08,0:49:07.42,Japonais,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:49:09.13,0:49:10.30,Japonais,,0,0,0,,Ақымақ!
Dialogue: 0,0:49:14.18,0:49:15.47,Japonais,,0,0,0,,Ши... кетті!
Dialogue: 0,0:49:15.47,0:49:16.97,Japonais,,0,0,0,,Мен тұзаққа түстім!
Dialogue: 0,0:49:16.97,0:49:19.22,Japonais,,0,0,0,,Өзіңіз айғайлағаныңыз үшін.
Dialogue: 0,0:49:19.43,0:49:21.31,Japonais,,0,0,0,,Егер бұл орын алса, бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:49:23.35,0:49:24.14,Japonais,,0,0,0,,Пи...Палау:
Dialogue: 0,0:49:24.98,0:49:26.48,Japonais,,0,0,0,,Сәлем! Сіз жігіттер!
Dialogue: 0,0:49:26.90,0:49:28.65,Japonais,,0,0,0,,Бұл баланың өлтірілгенін қаламасаңыз.
Dialogue: 0,0:49:28.65,0:49:30.65,Japonais,,0,0,0,,Маған 1 миллион зенни беріңіз!
Dialogue: 0,0:49:33.90,0:49:36.07,Japonais,,0,0,0,,Жақсы, 100 000 Zeni жақсы.
Dialogue: 0,0:49:39.95,0:49:42.70,Japonais,,0,0,0,,Не...не болды? Мен сені шынымен өлтіремін!
Dialogue: 0,0:49:42.91,0:49:44.12,Japonais,,0,0,0,,Сол балалар
Dialogue: 0,0:49:44.50,0:49:47.83,Japonais,,0,0,0,,Мен сені өлтіремін десем де бәрі күліп жатыр.
Dialogue: 0,0:49:48.00,0:49:49.63,Japonais,,0,0,0,,Сізге жаза керек пе?
Dialogue: 0,0:49:49.84,0:49:53.30,Japonais,,0,0,0,,Жоқ! Ол қыз баламның құрбысы сияқты.
Dialogue: 0,0:49:53.34,0:49:55.05,Japonais,,0,0,0,,Бұл қызықсыз ойын.
Dialogue: 0,0:49:56.13,0:49:58.85,Japonais,,0,0,0,,Бұл рас, рас!
Dialogue: 0,0:49:58.85,0:50:00.39,Japonais,,0,0,0,,А... у... Май-чан
Dialogue: 0,0:50:00.39,0:50:01.68,Japonais,,0,0,0,,Кепілге алынғандар, аузыңды жап!
Dialogue: 0,0:50:01.68,0:50:03.14,Japonais,,0,0,0,,Кеудемді соғып тұр.
Dialogue: 0,0:50:04.52,0:50:06.65,Japonais,,0,0,0,,Бұл көңілді шоу.
Dialogue: 0,0:50:06.69,0:50:09.36,Japonais,,0,0,0,,Жақсы! Мен де қатысамын!
Dialogue: 0,0:50:12.23,0:50:14.07,Japonais,,0,0,0,,Сүйкімді жауыздар!
Dialogue: 0,0:50:14.07,0:50:18.20,Japonais,,0,0,0,,Мына Ұлы Сайяман жамандарды кешірмейді!
Dialogue: 0,0:50:19.45,0:50:20.45,Japonais,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:50:20.78,0:50:24.04,Japonais,,0,0,0,,Бұл Super Saiyan Құдайы болуы мүмкін бе?
Dialogue: 0,0:50:24.04,0:50:25.87,Japonais,,0,0,0,,Мені қате түсінбеуіңізді өтінемін.
Dialogue: 0,0:50:25.87,0:50:29.04,Japonais,,0,0,0,,Бұл жай ғана бетперде киген Какарот ұлы еді.
Dialogue: 0,0:50:29.58,0:50:30.63,Japonais,,0,0,0,,Қыз бала…
Dialogue: 0,0:50:30.63,0:50:32.42,Japonais,,0,0,0,,Мені атып көріңіз.
Dialogue: 0,0:50:32.88,0:50:33.88,Japonais,,0,0,0,,Бұл... бұл ...
Dialogue: 0,0:50:33.88,0:50:34.88,Japonais,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:50:35.13,0:50:37.63,Japonais,,0,0,0,,Шынымен атсаң да, жарайды.
Dialogue: 0,0:50:37.63,0:50:39.89,Japonais,,0,0,0,,Менің ойымша, осылайша қызықтырақ болар еді.
Dialogue: 0,0:50:41.10,0:50:42.06,Japonais,,0,0,0,,Иә.
Dialogue: 0,0:50:42.06,0:50:44.68,Japonais,,0,0,0,,Барлық оқтарды бірден атыңыз.
Dialogue: 0,0:50:45.14,0:50:46.48,Japonais,,0,0,0,,Бұл жақсы
Dialogue: 0,0:50:46.48,0:50:48.02,Japonais,,0,0,0,,Барлығы! ?
Dialogue: 0,0:50:48.23,0:50:49.44,Japonais,,0,0,0,,Жарайды!
Dialogue: 0,0:50:49.44,0:50:52.65,Japonais,,0,0,0,,Мына жігіт соның бәрін желге ұшырып жібереді!
Dialogue: 0,0:50:52.82,0:50:54.53,Japonais,,0,0,0,,Менің аяғыма оқ атпа.
Dialogue: 0,0:50:54.53,0:50:55.65,Japonais,,0,0,0,,Өйткені бұл қарапайым
Dialogue: 0,0:50:55.82,0:50:57.78,Japonais,,0,0,0,,Бетке мықтап көздеңіз.
Dialogue: 0,0:50:58.20,0:51:00.82,Japonais,,0,0,0,,Жүр, жауыз, қолыңнан келгенше ат!
Dialogue: 0,0:51:01.41,0:51:02.37,Japonais,,0,0,0,,Қалағаныңды істе!!
Dialogue: 0,0:51:07.16,0:51:08.46,Japonais,,0,0,0,,Не болды, тентек?
Dialogue: 0,0:51:08.62,0:51:11.63,Japonais,,0,0,0,,Ұлы Сайяманның құдіретін түсіндің бе?
Dialogue: 0,0:51:11.84,0:51:13.84,Japonais,,0,0,0,,Ол... мінезі біртүрлі екен.
Dialogue: 0,0:51:13.84,0:51:15.84,Japonais,,0,0,0,,Мен бұған үйренбегенмін. Мен алкоголь іштім.
Dialogue: 0,0:51:15.84,0:51:16.92,Japonais,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,0:51:16.97,0:51:20.22,Japonais,,0,0,0,,Мен бұл ойыншық деп ойладым, бірақ ол нағыз мылтық болып шықты.
Dialogue: 0,0:51:20.68,0:51:21.55,Japonais,,0,0,0,,Жақсы емес.
Dialogue: 0,0:51:21.55,0:51:23.31,Japonais,,0,0,0,,Ешбір балада мұндай нәрсе болмауы керек.
Dialogue: 0,0:51:23.51,0:51:26.02,Japonais,,0,0,0,,Мен болмасам, бұл үлкен мәселе болар еді
Dialogue: 0,0:51:26.64,0:51:27.68,Japonais,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:51:29.52,0:51:31.52,Japonais,,0,0,0,,Видель... Видель Жақсысың ба?
Dialogue: 0,0:51:31.61,0:51:32.73,Japonais,,0,0,0,,Видель-сан!
Dialogue: 0,0:51:33.15,0:51:33.94,Japonais,,0,0,0,,Гохан
Dialogue: 0,0:51:33.94,0:51:36.40,Japonais,,0,0,0,,Әйелім туралы не істеуім керек?
Dialogue: 0,0:51:36.40,0:51:37.86,Japonais,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:51:38.40,0:51:40.28,Japonais,,0,0,0,,Қайсысын көремін.
Dialogue: 0,0:51:40.70,0:51:42.74,Japonais,,0,0,0,,Оны емдеуге бола ма? Каме-сеннин...
Dialogue: 0,0:51:42.78,0:51:44.03,Japonais,,0,0,0,,Жасанды тыныс алу...
Dialogue: 0,0:51:44.53,0:51:46.83,Japonais,,0,0,0,,Оның аяқ жарақатына қатысы жоқ!
Dialogue: 0,0:51:46.83,0:51:48.25,Japonais,,0,0,0,,Ол өзгерген жоқ.
Dialogue: 0,0:51:48.25,0:51:49.83,Japonais,,0,0,0,,Бұл эротикалық қарт
Dialogue: 0,0:51:49.83,0:51:51.12,Japonais,,0,0,0,,О...сен де.
Dialogue: 0,0:51:51.12,0:51:53.54,Japonais,,0,0,0,,Ұлы дәретханаға не дедіңіз?
Dialogue: 0,0:51:53.92,0:51:55.46,Japonais,,0,0,0,,Мен сені емдеймін.
Dialogue: 0,0:51:56.21,0:51:57.46,Japonais,,0,0,0,,Не істемекшісің?
Dialogue: 0,0:51:57.88,0:51:59.17,Japonais,,0,0,0,,Аузыңызды бақылаңыз.
Dialogue: 0,0:51:59.67,0:52:00.97,Japonais,,0,0,0,,Бұл адам – Құдай
Dialogue: 0,0:52:00.97,0:52:02.39,Japonais,,0,0,0,,Немесе... Құдай! ?
Dialogue: 0,0:52:02.51,0:52:03.55,Japonais,,0,0,0,,Жоқ... шынымен бе?
Dialogue: 0,0:52:03.55,0:52:05.43,Japonais,,0,0,0,,Сіз құдай болдыңыз ба?
Dialogue: 0,0:52:09.10,0:52:10.02,Japonais,,0,0,0,,Сауықты...
Dialogue: 0,0:52:10.69,0:52:11.98,Japonais,,0,0,0,,Рахмет...
Dialogue: 0,0:52:12.10,0:52:12.85,Japonais,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:52:12.98,0:52:15.36,Japonais,,0,0,0,,Мм... сіз... ішіңізде ме?
Dialogue: 0,0:52:17.53,0:52:18.44,Japonais,,0,0,0,,Бұл әлі құпия.
Dialogue: 0,0:52:18.86,0:52:19.94,Japonais,,0,0,0,,болды ма?
Dialogue: 0,0:52:20.07,0:52:22.57,Japonais,,0,0,0,,Гоханға әзірге алкогольге тыйым салынады.
Dialogue: 0,0:52:22.57,0:52:23.24,Japonais,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:52:23.24,0:52:24.45,Japonais,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:52:24.62,0:52:25.58,Japonais,,0,0,0,,Рахмет Денде
Dialogue: 0,0:52:26.16,0:52:27.58,Japonais,,0,0,0,,Құдай емес
Dialogue: 0,0:52:28.12,0:52:30.12,Japonais,,0,0,0,,Бұл арман, солай ма? арман
Dialogue: 0,0:52:30.41,0:52:34.58,Japonais,,0,0,0,,Бірақ бұған дейін де мен мұны арман деп ойладым, бірақ оның бәрі шындық еді.
Dialogue: 0,0:52:34.67,0:52:37.75,Japonais,,0,0,0,,Кез келген жағдайда, сіз оқтарды да секіре аласыз ба?
Dialogue: 0,0:52:37.88,0:52:38.71,Japonais,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:52:38.96,0:52:41.17,Japonais,,0,0,0,,Сіз мұны біліп, бұл пьеса туралы ойладыңыз, солай ма?
Dialogue: 0,0:52:42.51,0:52:45.89,Japonais,,0,0,0,,Анау анау ит, қапы қалма.
Dialogue: 0,0:52:45.89,0:52:48.26,Japonais,,0,0,0,,Осындай кезде шабуылға шығу керек.
Dialogue: 0,0:52:48.56,0:52:49.81,Japonais,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:52:50.31,0:52:52.52,Japonais,,0,0,0,,Маймылдар да соншалықты әсерлі емес.
Dialogue: 0,0:52:52.60,0:52:53.73,Japonais,,0,0,0,,Қандай ұят!
Dialogue: 0,0:52:53.90,0:52:55.40,Japonais,,0,0,0,,Бұл танымалырақ болар еді...
Dialogue: 0,0:52:55.69,0:52:57.07,Japonais,,0,0,0,,Келесі жолы бар күшімді саламын
Dialogue: 0,0:52:57.82,0:52:59.11,Japonais,,0,0,0,,Не... бұл қалай?
Dialogue: 0,0:52:59.23,0:53:00.94,Japonais,,0,0,0,,Бұл көңілді шоу болды, солай емес пе?
Dialogue: 0,0:53:01.82,0:53:04.66,Japonais,,0,0,0,,Маған да ұшып кетті, солай емес пе?
Dialogue: 0,0:53:06.70,0:53:08.16,Japonais,,0,0,0,,Аздап қышиды
Dialogue: 0,0:53:08.20,0:53:09.16,Japonais,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:53:09.16,0:53:10.83,Japonais,,0,0,0,,Өте жағымсыз
Dialogue: 0,0:53:11.08,0:53:12.71,Japonais,,0,0,0,,Сонда жер...
Dialogue: 0,0:53:12.71,0:53:13.96,Japonais,,0,0,0,,Ол жойылады ма?
Dialogue: 0,0:53:14.00,0:53:17.84,Japonais,,0,0,0,,Әр жұлдызды жаңартқан дұрыс болар.
Dialogue: 0,0:53:22.01,0:53:25.22,Japonais,,0,0,0,,Жаратылыстан бұрын жойылу бар
Dialogue: 0,0:53:25.68,0:53:26.55,Japonais,,0,0,0,,Сәлем!
Dialogue: 0,0:53:26.68,0:53:27.55,Japonais,,0,0,0,,Балалар!
Dialogue: 0,0:53:29.43,0:53:31.06,Japonais,,0,0,0,,Ойын-сауық аяқталды!
Dialogue: 0,0:53:31.22,0:53:31.93,Japonais,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:53:31.93,0:53:33.44,Japonais,,0,0,0,,Көңілді бинго турнирі
Dialogue: 0,0:53:33.44,0:53:35.40,Japonais,,0,0,0,,Бастау! Басталуы!
Dialogue: 0,0:53:42.78,0:53:43.57,Japonais,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:53:43.57,0:53:44.61,Japonais,,0,0,0,,Вегетаға дейін...
Dialogue: 0,0:53:44.61,0:53:45.86,Japonais,,0,0,0,,Көңілді Бинго
Dialogue: 0,0:53:46.82,0:53:48.95,Japonais,,0,0,0,,Жер қызық
Dialogue: 0,0:53:48.95,0:53:50.83,Japonais,,0,0,0,,Айтпақшы
Dialogue: 0,0:53:51.37,0:53:52.04,Japonais,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:53:52.04,0:53:52.54,Japonais,,0,0,0,,Тамақтану
Dialogue: 0,0:53:52.54,0:53:53.66,Japonais,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:53:53.66,0:53:54.33,Japonais,,0,0,0,,О.
Dialogue: 0,0:53:54.33,0:53:54.71,Japonais,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:53:54.71,0:53:55.37,Japonais,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:53:55.37,0:53:56.00,Japonais,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:53:56.00,0:53:57.58,Japonais,,0,0,0,,Көңілді бинго
Dialogue: 0,0:53:58.25,0:53:59.71,Japonais,,0,0,0,,Көңілді бинго
Dialogue: 0,0:54:02.80,0:54:04.09,Japonais,,0,0,0,,Мен оны аздап тарттым.
Dialogue: 0,0:54:04.09,0:54:04.84,Japonais,,0,0,0,,О
Dialogue: 0,0:54:05.05,0:54:07.84,Japonais,,0,0,0,,Мен оның ән мен биге соншалықты нашар екенін ешқашан білмедім.
Dialogue: 0,0:54:08.14,0:54:10.26,Japonais,,0,0,0,,Бұл Whis әнімен жақсы үйлеседі.
Dialogue: 0,0:54:10.26,0:54:11.39,Japonais,,0,0,0,,Бұл күтпеген жағдай
Dialogue: 0,0:54:12.60,0:54:14.14,Japonais,,0,0,0,,Енді өзіңізді тартыңыз.
Dialogue: 0,0:54:14.18,0:54:16.10,Japonais,,0,0,0,,Тамақты көбірек алайық
Dialogue: 0,0:54:16.10,0:54:17.06,Japonais,,0,0,0,,That's right.
Dialogue: 0,0:54:19.56,0:54:21.23,Japonais,,0,0,0,,Иә, иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:54:21.78,0:54:22.65,Japonais,,0,0,0,,Балалар
Dialogue: 0,0:54:22.65,0:54:24.65,Japonais,,0,0,0,,Бұл доп ойыншық емес.
Dialogue: 0,0:54:24.69,0:54:26.24,Japonais,,0,0,0,,Рұқсатсыз қабылдамаңыз.
Dialogue: 0,0:54:27.07,0:54:29.99,Japonais,,0,0,0,,Бірақ спектакль аздап қызықты болды.
Dialogue: 0,0:54:29.99,0:54:30.99,Japonais,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:54:31.03,0:54:34.66,Japonais,,0,0,0,,Енді бізде Айдаһар шарлары бар, бинго ойнауды бастайық!
Dialogue: 0,0:54:37.50,0:54:38.29,Japonais,,0,0,0,,немесе мүсіндердің өрнектері мен материалдарын зерттейтінмін,
Dialogue: 0,0:54:38.29,0:54:41.09,Japonais,,0,0,0,,Өйткені мен намысымды лақтырып, Берусты жақсы көңіл күйде ұстадым.
Dialogue: 0,0:54:41.09,0:54:42.63,Japonais,,0,0,0,,Бірдеңе дұрыс болмады
Dialogue: 0,0:54:43.05,0:54:44.88,Japonais,,0,0,0,,Бірақ бұл енді маңызды емес.
Dialogue: 0,0:54:44.88,0:54:48.80,Japonais,,0,0,0,,Жерді жақсы көңіл-күйде қалдыру ғана қалды.
Dialogue: 0,0:54:56.81,0:54:58.73,Japonais,,0,0,0,,Басқа біреу қол жеткізе алады ма?
Dialogue: 0,0:55:07.95,0:55:08.99,Japonais,,0,0,0,,Лорд Берус?
Dialogue: 0,0:55:09.36,0:55:13.28,Japonais,,0,0,0,,Сол пудингті немесе басқа десертті жеп көрдіңіз бе?
Dialogue: 0,0:55:13.33,0:55:16.08,Japonais,,0,0,0,,Бұл шынымен тегіс және дәмді.
Dialogue: 0,0:55:16.12,0:55:17.83,Japonais,,0,0,0,,Не? Ал пудинг ше?
Dialogue: 0,0:55:17.83,0:55:19.83,Japonais,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:55:19.83,0:55:20.96,Japonais,,0,0,0,,Сол жерде
Dialogue: 0,0:55:24.84,0:55:25.84,Japonais,,0,0,0,,Жек көру?
Dialogue: 0,0:55:25.84,0:55:28.17,Japonais,,0,0,0,,Біраз бұрын осында болған.
Dialogue: 0,0:55:28.38,0:55:29.59,Japonais,,0,0,0,,Жоқ
Dialogue: 0,0:55:29.59,0:55:30.97,Japonais,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:55:31.51,0:55:32.85,Japonais,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:55:36.85,0:55:38.85,Japonais,,0,0,0,,Сіз пудингке екінші көмек алғыңыз келе ме?
Dialogue: 0,0:55:39.52,0:55:40.85,Japonais,,0,0,0,,I'm sorry.
Dialogue: 0,0:55:41.10,0:55:42.48,Japonais,,0,0,0,,Пудинг сол жерде.
Dialogue: 0,0:55:42.48,0:55:44.02,Japonais,,0,0,0,,Бұл соңғысы.
Dialogue: 0,0:55:49.61,0:55:50.61,Japonais,,0,0,0,,Сіз! сен!
Dialogue: 0,0:55:51.07,0:55:53.66,Japonais,,0,0,0,,Сізде бар бір нәрсемен бөлісе аласыз ба?
Dialogue: 0,0:55:54.12,0:55:56.08,Japonais,,0,0,0,,Екі, соның ішінде менікі
Dialogue: 0,0:55:58.58,0:56:01.46,Japonais,,0,0,0,,Ең нашар, маған бір ғана керек.
Dialogue: 0,0:56:01.46,0:56:03.04,Japonais,,0,0,0,,Беерус-сама қу.
Dialogue: 0,0:56:03.38,0:56:05.42,Japonais,,0,0,0,,Сіз жеп қойғансыз, солай ма?
Dialogue: 0,0:56:06.09,0:56:07.21,Japonais,,0,0,0,,Маған беріңіз
Dialogue: 0,0:56:07.88,0:56:08.76,Japonais,,0,0,0,,Жоқ!!!
Dialogue: 0,0:56:08.88,0:56:09.59,Japonais,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:56:09.80,0:56:11.34,Japonais,,0,0,0,,Мен бәрін жеймін
Dialogue: 0,0:56:11.63,0:56:12.93,Japonais,,0,0,0,,Өте көп! ?
Dialogue: 0,0:56:13.01,0:56:14.64,Japonais,,0,0,0,,Бәрі менікі!
Dialogue: 0,0:56:18.31,0:56:19.02,Japonais,,0,0,0,,Беріңіз!
Dialogue: 0,0:56:19.02,0:56:19.60,Japonais,,0,0,0,,Жоқ!
Dialogue: 0,0:56:19.98,0:56:20.73,Japonais,,0,0,0,,Беріңіз!
Dialogue: 0,0:56:20.73,0:56:21.31,Japonais,,0,0,0,,Жоқ!
Dialogue: 0,0:56:21.48,0:56:22.98,Japonais,,0,0,0,,Кет мына жерден, ақымақ!
Dialogue: 0,0:56:24.56,0:56:25.61,Japonais,,0,0,0,,Мен сен ақымақсың дедім.
Dialogue: 0,0:56:25.61,0:56:27.82,Japonais,,0,0,0,,Мен сені кәмпитке айналдырып, жеймін!!!
Dialogue: 0,0:56:28.28,0:56:29.15,Japonais,,0,0,0,,Жоқ!!!
Dialogue: 0,0:56:29.15,0:56:30.70,Japonais,,0,0,0,,Қарамасаңда!!!
Dialogue: 0,0:56:31.24,0:56:35.95,Japonais,,0,0,0,,Мен қатты ашуландым!
Dialogue: 0,0:56:45.67,0:56:46.38,Japonais,,0,0,0,,Ей!
Dialogue: 0,0:56:48.30,0:56:50.13,Japonais,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:56:55.05,0:56:56.72,Japonais,,0,0,0,,Лорд Берус! Өтінемін тоқта!
Dialogue: 0,0:56:56.72,0:56:59.02,Japonais,,0,0,0,,Және...тоқтат!
Dialogue: 0,0:57:12.86,0:57:13.70,Japonais,,0,0,0,,Тен мырза
Dialogue: 0,0:57:14.49,0:57:15.37,Japonais,,0,0,0,,Сол жігіт!
Dialogue: 0,0:57:15.37,0:57:16.45,Japonais,,0,0,0,,Бұл шектен шыққан!!!
Dialogue: 0,0:57:16.87,0:57:17.53,Japonais,,0,0,0,,Криллин-сан!
Dialogue: 0,0:57:17.53,0:57:18.91,Japonais,,0,0,0,,Барлығы қашып кетсін!
Dialogue: 0,0:57:29.42,0:57:30.30,Japonais,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:57:31.51,0:57:32.17,Japonais,,0,0,0,,Готен!
Dialogue: 0,0:57:32.30,0:57:33.76,Japonais,,0,0,0,,Мына екі дос!
Dialogue: 0,0:57:41.89,0:57:45.02,Japonais,,0,0,0,,Егер сіз маған көже бермесеңіз, мен сізді одан сайын ренжітемін.
Dialogue: 0,0:57:45.02,0:57:46.15,Japonais,,0,0,0,,Тоқта!
Dialogue: 0,0:57:55.45,0:57:56.07,Japonais,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:57:56.07,0:57:57.66,Japonais,,0,0,0,,Өзіңіз қалаған нәрсеге айналыңыз!
Dialogue: 0,0:58:01.70,0:58:03.00,Japonais,,0,0,0,,Осы жолмен! Берус!
Dialogue: 0,0:58:23.56,0:58:24.39,Japonais,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:58:29.73,0:58:31.90,Japonais,,0,0,0,,Бұл өте дәмді!
Dialogue: 0,0:58:32.03,0:58:33.90,Japonais,,0,0,0,,Бұл қандай тағам?
Dialogue: 0,0:58:35.15,0:58:35.78,Japonais,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:58:36.03,0:58:37.24,Japonais,,0,0,0,,Бұл суши деп аталады...
Dialogue: 0,0:58:45.75,0:58:47.75,Japonais,,0,0,0,,Бұл Вегета бір сәтте?
Dialogue: 0,0:58:48.50,0:58:50.50,Japonais,,0,0,0,,Менің... сәл күте тұрыңыз.
Dialogue: 0,0:58:50.71,0:58:51.38,Japonais,,0,0,0,,Готен!
Dialogue: 0,0:58:52.00,0:58:53.30,Japonais,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:58:57.80,0:58:59.89,Japonais,,0,0,0,,Фу…
Dialogue: 0,0:58:59.89,0:59:00.55,Japonais,,0,0,0,,Джон!
Dialogue: 0,0:59:09.94,0:59:12.36,Japonais,,0,0,0,,Ал... Гөтен тағы да қылмыскер болып кетті.
Dialogue: 0,0:59:12.73,0:59:15.61,Japonais,,0,0,0,,Оның жауынгерлік сезімі өте жақсы.
Dialogue: 0,0:59:15.90,0:59:18.11,Japonais,,0,0,0,,Сәлем! бұл мысық адам
Dialogue: 0,0:59:18.32,0:59:20.66,Japonais,,0,0,0,,Ол пудинг үстінде жабайы кетті.
Dialogue: 0,0:59:20.66,0:59:22.58,Japonais,,0,0,0,,Осындай тәртіпті бұзғандар
Dialogue: 0,0:59:22.58,0:59:25.16,Japonais,,0,0,0,,Бұл Готенкс-сама сізді ұшырып жібереді!
Dialogue: 0,0:59:25.16,0:59:26.50,Japonais,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:59:26.50,0:59:30.08,Japonais,,0,0,0,,Жердегілер, оны жеуге дағдыланған шығарсыңдар, бірақ...
Dialogue: 0,0:59:30.08,0:59:33.80,Japonais,,0,0,0,,Дәмі қандай екенін елестете алмайтын беймәлім тағам!
Dialogue: 0,0:59:34.09,0:59:35.42,Japonais,,0,0,0,,пудинг!
Dialogue: 0,0:59:35.42,0:59:39.18,Japonais,,0,0,0,,Қандай дәмді атау!
Dialogue: 0,0:59:40.18,0:59:41.89,Japonais,,0,0,0,,О... қандай қатты!
Dialogue: 0,0:59:42.80,0:59:45.93,Japonais,,0,0,0,,Келіңдер... балалар... лайықты қарсылассыңдар...
Dialogue: 0,0:59:48.10,0:59:50.44,Japonais,,0,0,0,,Ауырды... Ауырды!
Dialogue: 0,0:59:53.40,0:59:55.19,Japonais,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,1:00:09.62,1:00:12.38,Japonais,,0,0,0,,Мен бұл шектен шыққан нәрсе болар деп ойладым.
Dialogue: 0,1:00:13.13,1:00:15.80,Japonais,,0,0,0,,Деңгей мұншалықты басқаша болады деп күткен жоқпын.
Dialogue: 0,1:00:16.13,1:00:16.84,Japonais,,0,0,0,,Ақымақ
Dialogue: 0,1:00:17.26,1:00:18.84,Japonais,,0,0,0,,Бұл аяқталды ма?
Dialogue: 0,1:00:19.72,1:00:21.51,Japonais,,0,0,0,,Пудинг те жоқ
Dialogue: 0,1:00:22.01,1:00:24.39,Japonais,,0,0,0,,Супер Сайян Құдайы да жоқ.
Dialogue: 0,1:00:24.97,1:00:27.06,Japonais,,0,0,0,,Ол әлдеқашан жойылды ма?
Dialogue: 0,1:00:34.11,1:00:36.11,Japonais,,0,0,0,,Егер мені жою Құдайы Берус өшіретін болса
Dialogue: 0,1:00:36.11,1:00:37.23,Japonais,,0,0,0,,Бұл құрмет болуы мүмкін.
Dialogue: 0,1:00:37.73,1:00:41.45,Japonais,,0,0,0,,Әй... жақсы сөз айтып тұрсың ғой, солай ма?
Dialogue: 0,1:00:41.74,1:00:43.61,Japonais,,0,0,0,,Содан кейін қалауыңызша
Dialogue: 0,1:00:44.91,1:00:47.03,Japonais,,0,0,0,,Тек абай болыңыз!
Dialogue: 0,1:00:47.74,1:00:50.66,Japonais,,0,0,0,,Ол Вегетаның танысы ма, әлде басқасы ма, білмеймін.
Dialogue: 0,1:00:50.66,1:00:54.04,Japonais,,0,0,0,,Менің 38 жасқа толған туған күнім төбелес емес!
Dialogue: 0,1:00:54.29,1:00:56.34,Japonais,,0,0,0,,Ол 38 жаста болды ма?
Dialogue: 0,1:01:04.09,1:01:06.64,Japonais,,0,0,0,,Жарайсың! менікі
Dialogue: 0,1:01:06.64,1:01:13.10,Japonais,,0,0,0,,Блумерлер!
Dialogue: 0,1:01:14.15,1:01:16.56,Japonais,,0,0,0,,(Hol Horse) «Мен осы жерде сұрақ қойғым келетін адаммын!»
Dialogue: 0,1:01:29.70,1:01:31.70,Japonais,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,1:01:31.70,1:01:32.83,Japonais,,0,0,0,,Вегетаның біреуі
Dialogue: 0,1:01:32.83,1:01:35.29,Japonais,,0,0,0,,Ол ақыры Гокудан асып түскен жоқ па?
Dialogue: 0,1:01:42.72,1:01:43.51,Japonais,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,1:01:51.68,1:01:52.60,Japonais,,0,0,0,,Не...не?
Dialogue: 0,1:01:55.06,1:01:57.31,Japonais,,0,0,0,,Сондай-ақ Capsule корпорациясында
Dialogue: 0,1:01:57.36,1:01:59.86,Japonais,,0,0,0,,Олар үлкен отшашуды да атқылап жатыр ма?
Dialogue: 0,1:02:01.86,1:02:02.78,Japonais,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:02:08.41,1:02:12.29,Japonais,,0,0,0,,Бұл Супер Сайян Құдайы емес сияқты.
Dialogue: 0,1:02:12.58,1:02:13.41,Japonais,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,1:02:13.41,1:02:15.21,Japonais,,0,0,0,,Жерді жойып, қайтып оралу
Dialogue: 0,1:02:15.46,1:02:16.04,Japonais,,0,0,0,,Whis!
Dialogue: 0,1:02:17.12,1:02:18.54,Japonais,,0,0,0,,Сәл күте тұрыңыз!
Dialogue: 0,1:02:19.34,1:02:20.75,Japonais,,0,0,0,,Теңіз кірпісі гунканмаки?
Dialogue: 0,1:02:21.46,1:02:23.38,Japonais,,0,0,0,,Бұл да дәмді.
Dialogue: 0,1:02:25.01,1:02:27.01,Japonais,,0,0,0,,Ал... Мен саған олай істеуге рұқсат бермеймін!
Dialogue: 0,1:02:27.01,1:02:29.01,Japonais,,0,0,0,,Жою! Сіз жойылу туралы айтасыз!
Dialogue: 0,1:02:29.01,1:02:30.14,Japonais,,0,0,0,,Бұл қызықсыз
Dialogue: 0,1:02:30.22,1:02:32.31,Japonais,,0,0,0,,Мен саған бәрі бітті дедім.
Dialogue: 0,1:02:36.77,1:02:37.73,Japonais,,0,0,0,,Вегета!
Dialogue: 0,1:02:39.19,1:02:40.15,Japonais,,0,0,0,,Вегета!
Dialogue: 0,1:02:42.07,1:02:43.15,Japonais,,0,0,0,,Whis!
Dialogue: 0,1:02:45.28,1:02:46.24,Japonais,,0,0,0,,Сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,1:02:46.24,1:02:47.32,Japonais,,0,0,0,,Лорд Берус?
Dialogue: 0,1:02:47.70,1:02:50.57,Japonais,,0,0,0,,Шамасы, Супер Сайян Құдайы
Dialogue: 0,1:02:50.87,1:02:52.12,Japonais,,0,0,0,,Сіз айтқандай
Dialogue: 0,1:02:52.12,1:02:54.33,Japonais,,0,0,0,,Бұл жай ғана ақымақ арман болған сияқты.
Dialogue: 0,1:02:54.58,1:02:55.71,Japonais,,0,0,0,,Қайта-қайта айтамын
Dialogue: 0,1:02:55.71,1:02:57.50,Japonais,,0,0,0,,Жерді жойып, үйге қайт!
Dialogue: 0,1:02:57.62,1:02:58.67,Japonais,,0,0,0,,Түсінікті
Dialogue: 0,1:02:58.92,1:03:01.21,Japonais,,0,0,0,,Бірақ сәл күте тұрыңыз.
Dialogue: 0,1:03:03.21,1:03:04.71,Japonais,,0,0,0,,Сізге қалай ұнайды? Текка ролл?
Dialogue: 0,1:03:05.63,1:03:06.76,Japonais,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,1:03:06.97,1:03:09.97,Japonais,,0,0,0,,Айтпақшы, менің уақытым аз қалған сияқты.
Dialogue: 0,1:03:10.18,1:03:12.64,Japonais,,0,0,0,,Мен мұны үйге апара аламын ба?
Dialogue: 0,1:03:23.90,1:03:26.57,Japonais,,0,0,0,,Ал... Жер бұл... Түсінемін...
Dialogue: 0,1:03:26.61,1:03:29.16,Japonais,,0,0,0,,Бұл кейде көңілді болды.
Dialogue: 0,1:03:29.66,1:03:31.99,Japonais,,0,0,0,,Мен саған соңғы мүмкіндік беремін.
Dialogue: 0,1:03:33.37,1:03:34.41,Japonais,,0,0,0,,Сен сонда!
Dialogue: 0,1:03:39.50,1:03:41.63,Japonais,,0,0,0,,Мына жақта сенсің... Сен!!!
Dialogue: 0,1:03:42.71,1:03:43.54,Japonais,,0,0,0,,О...мен! ?
Dialogue: 0,1:03:43.75,1:03:44.42,Japonais,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,1:03:44.42,1:03:46.42,Japonais,,0,0,0,,Сіз дәмді көрінесіз.
Dialogue: 0,1:03:48.38,1:03:50.22,Japonais,,0,0,0,,Бұл... жеуге болатын.
Dialogue: 0,1:03:50.22,1:03:51.76,Japonais,,0,0,0,,Мұнда келіңіз
Dialogue: 0,1:03:52.22,1:03:55.10,Japonais,,0,0,0,,Жарайды... бұл жаман. Мен шынымен жаманмын!
Dialogue: 0,1:03:55.26,1:03:58.02,Japonais,,0,0,0,,Менімен тас, қағаз, қайшы ойнасаң, жеңсең
Dialogue: 0,1:03:58.02,1:04:00.10,Japonais,,0,0,0,,Үйге қайтайық.
Dialogue: 0,1:04:00.31,1:04:02.19,Japonais,,0,0,0,,Бірақ мен жеңсем
Dialogue: 0,1:04:02.40,1:04:04.11,Japonais,,0,0,0,,Өйткені ол Жерді жояды!
Dialogue: 0,1:04:04.57,1:04:05.52,Japonais,,0,0,0,,Сонымен...тас, қағаз, қайшы?
Dialogue: 0,1:04:05.73,1:04:07.36,Japonais,,0,0,0,,Жер жойылады ма?
Dialogue: 0,1:04:08.78,1:04:11.82,Japonais,,0,0,0,,Жоқ! Мен тас-қағаз-қайшыдан әлсізмін!!
Dialogue: 0,1:04:12.28,1:04:14.45,Japonais,,0,0,0,,Жер тағдырына жауапты болу
Dialogue: 0,1:04:14.49,1:04:16.66,Japonais,,0,0,0,,Бұл сіздің бірінші үлкен рөліңіз емес пе?
Dialogue: 0,1:04:16.79,1:04:18.62,Japonais,,0,0,0,,Жеңілсем, саған кек сақтаймын.
Dialogue: 0,1:04:18.79,1:04:20.16,Japonais,,0,0,0,,Пуэр! Теме!
Dialogue: 0,1:04:21.46,1:04:23.00,Japonais,,0,0,0,,Шынымен бе? Эй, түсіндім!
Dialogue: 0,1:04:23.46,1:04:26.17,Japonais,,0,0,0,,Неліктен ол Улонгты тағайындау үшін барын салды?
Dialogue: 0,1:04:27.34,1:04:28.13,Japonais,,0,0,0,,Сол жігіт
Dialogue: 0,1:04:28.13,1:04:30.59,Japonais,,0,0,0,,Олар сені жай ғана шошқа деп ойлайды!
Dialogue: 0,1:04:31.38,1:04:34.18,Japonais,,0,0,0,,Бұл шошқа болғандықтан, ол тек таяқша шығара алатынын есептеді!
Dialogue: 0,1:04:34.72,1:04:36.64,Japonais,,0,0,0,,Дегенмен, сен шошқа адамсың.
Dialogue: 0,1:04:37.31,1:04:39.60,Japonais,,0,0,0,,Мен тең және жақсы орындай алатынымды түсінбедім!
Dialogue: 0,1:04:40.77,1:04:42.81,Japonais,,0,0,0,,Ол міндетті түрде иіс шығарады.
Dialogue: 0,1:04:43.02,1:04:45.36,Japonais,,0,0,0,,Егер Улонг тең болса, ол жеңеді!
Dialogue: 0,1:04:48.19,1:04:49.61,Japonais,,0,0,0,,Түсіндім!
Dialogue: 0,1:04:49.61,1:04:50.53,Japonais,,0,0,0,,Жарайды!
Dialogue: 0,1:04:50.78,1:04:52.24,Japonais,,0,0,0,,Мен орындаймын 1
Dialogue: 0,1:04:53.16,1:04:54.49,Japonais,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,1:04:56.99,1:04:57.70,Japonais,,0,0,0,,Сонымен
Dialogue: 0,1:04:59.04,1:05:01.08,Japonais,,0,0,0,,Бұл тас, қағаз, қайшы сияқты!
Dialogue: 0,1:05:03.37,1:05:04.29,Japonais,,0,0,0,,Гаккуши…
Dialogue: 0,1:05:07.17,1:05:08.13,Japonais,,0,0,0,,Бұл жебе аса бағалы — олардың тек біреуі ғана бар.
Dialogue: 0,1:05:08.46,1:05:10.30,Japonais,,0,0,0,,Мен бүкіл жоспарды ести аламын!
Dialogue: 0,1:05:34.11,1:05:35.32,Japonais,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:05:40.16,1:05:40.83,Japonais,,0,0,0,,Гоку
Dialogue: 0,1:05:40.83,1:05:41.79,Japonais,,0,0,0,,Гоку!
Dialogue: 0,1:05:50.92,1:05:51.80,Japonais,,0,0,0,,Немересі? !
Dialogue: 0,1:05:59.31,1:06:00.81,Japonais,,0,0,0,,Тағы да сен бе?
Dialogue: 0,1:06:00.81,1:06:02.02,Japonais,,0,0,0,,Бұл не?
Dialogue: 0,1:06:02.27,1:06:04.77,Japonais,,0,0,0,,Сіз Құдайдың шынайы болмысын білдіңіз бе?
Dialogue: 0,1:06:05.10,1:06:07.27,Japonais,,0,0,0,,Бұл әлі жұмбақ.
Dialogue: 0,1:06:07.65,1:06:09.65,Japonais,,0,0,0,,Өтінемін, бұл планетаны жоймаңыз!
Dialogue: 0,1:06:10.15,1:06:12.15,Japonais,,0,0,0,,Мен жойылу құдайымын.
Dialogue: 0,1:06:13.36,1:06:15.45,Japonais,,0,0,0,,Түсіндім, Беерус-сама!
Dialogue: 0,1:06:15.61,1:06:17.99,Japonais,,0,0,0,,Бірақ дәл осы жолы, өтінемін, жіберіп алайын!
Dialogue: 0,1:06:18.70,1:06:19.83,Japonais,,0,0,0,,Сонымен не?
Dialogue: 0,1:06:19.83,1:06:21.87,Japonais,,0,0,0,,Сіз тағы да төбелесесіз бе?
Dialogue: 0,1:06:21.95,1:06:23.91,Japonais,,0,0,0,,Мен жай ғана айтқым келеді...
Dialogue: 0,1:06:24.41,1:06:26.12,Japonais,,0,0,0,,...Кешіріңіз!
Dialogue: 0,1:06:26.42,1:06:29.25,Japonais,,0,0,0,,Шынымды айтсам, мен сені не болса да жеңе алатындай сезінемін...
Dialogue: 0,1:06:30.67,1:06:31.71,Japonais,,0,0,0,,Міне!
Dialogue: 0,1:06:32.55,1:06:33.38,Japonais,,0,0,0,,Лорд Берус!
Dialogue: 0,1:06:33.38,1:06:35.88,Japonais,,0,0,0,,Бұл хит пе, жоқ па? Мен оны сынап көрейін бе?
Dialogue: 0,1:06:35.97,1:06:37.01,Japonais,,0,0,0,,Не?
Dialogue: 0,1:06:37.01,1:06:40.22,Japonais,,0,0,0,,Қараңдар! Бұл супер Сайян Құдайы!
Dialogue: 0,1:06:40.30,1:06:41.81,Japonais,,0,0,0,,Мүмкін, бірақ
Dialogue: 0,1:06:42.10,1:06:43.47,Japonais,,0,0,0,,Бұл таныс шығар!
Dialogue: 0,1:06:43.56,1:06:44.48,Japonais,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:06:44.64,1:06:46.73,Japonais,,0,0,0,,Маған аз ғана уақыт бере аласыз ба?
Dialogue: 0,1:06:46.89,1:06:48.44,Japonais,,0,0,0,,Кішкене ғана! Не? !
Dialogue: 0,1:06:49.10,1:06:50.15,Japonais,,0,0,0,,Өтінемін!
Dialogue: 0,1:06:50.86,1:06:51.82,Japonais,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,1:06:51.94,1:06:52.98,Japonais,,0,0,0,,Кішкене ғана
Dialogue: 0,1:06:53.73,1:06:54.57,Japonais,,0,0,0,,Рахмет!
Dialogue: 0,1:07:00.95,1:07:01.74,Japonais,,0,0,0,,Блумерлер!
Dialogue: 0,1:07:02.08,1:07:04.50,Japonais,,0,0,0,,Мен сізге бұл Айдаһар шарларын пайдалануға рұқсат етемін!
Dialogue: 0,1:07:04.70,1:07:05.66,Japonais,,0,0,0,,Жақсы!
Dialogue: 0,1:07:05.91,1:07:08.87,Japonais,,0,0,0,,Сол менсінбеген тентектен құтылсаң.
Dialogue: 0,1:07:08.87,1:07:10.38,Japonais,,0,0,0,,Қалағаныңызша пайдаланыңыз!
Dialogue: 0,1:07:10.50,1:07:13.67,Japonais,,0,0,0,,Аузың нашар. Ол адам Құдай!
Dialogue: 0,1:07:14.42,1:07:15.55,Japonais,,0,0,0,,Құдай?
Dialogue: 0,1:07:17.63,1:07:18.55,Japonais,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,1:07:18.55,1:07:19.89,Japonais,,0,0,0,,Сен де құдай болсаң
Dialogue: 0,1:07:19.89,1:07:21.72,Japonais,,0,0,0,,Пудингке ақымақ болмаңыз!
Dialogue: 0,1:07:21.72,1:07:22.30,Japonais,,0,0,0,,Идиот!
Dialogue: 0,1:07:23.68,1:07:25.31,Japonais,,0,0,0,,Ол жай құдай емес...
Dialogue: 0,1:07:25.89,1:07:27.64,Japonais,,0,0,0,,Дүниедегі ең қорқынышты нәрсе
Dialogue: 0,1:07:27.64,1:07:28.85,Japonais,,0,0,0,,Жоюшы Құдай!
Dialogue: 0,1:07:30.02,1:07:31.40,Japonais,,0,0,0,,Бұл Беерус-сама.
Dialogue: 0,1:07:31.69,1:07:33.52,Japonais,,0,0,0,,Бұл әлемдегі ең күшті.
Dialogue: 0,1:07:33.98,1:07:37.57,Japonais,,0,0,0,,Кай патша да, Құдай Кай да қорқып, қорқады.
Dialogue: 0,1:07:39.32,1:07:40.28,Japonais,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,1:07:40.78,1:07:42.83,Japonais,,0,0,0,,Сөздеріңізге абай болыңыздар
Dialogue: 0,1:07:43.12,1:07:45.08,Japonais,,0,0,0,,Беерус-саманың мазасын алса.
Dialogue: 0,1:07:45.49,1:07:49.25,Japonais,,0,0,0,,Біраз уақыттан кейін бүкіл күн жүйесі жойылады.
Dialogue: 0,1:07:49.71,1:07:51.42,Japonais,,0,0,0,,Лорд Берус!
Dialogue: 0,1:07:51.42,1:07:52.29,Japonais,,0,0,0,,Тоқта
Dialogue: 0,1:07:52.29,1:07:54.21,Japonais,,0,0,0,,Орта жастағы әйелдер керісінше әсер етеді.
Dialogue: 0,1:07:54.21,1:07:54.71,Japonais,,0,0,0,,Шулы!
Dialogue: 0,1:07:56.80,1:07:57.38,Japonais,,0,0,0,,Гоку
Dialogue: 0,1:07:57.38,1:07:59.43,Japonais,,0,0,0,,Айдаһар шарларымен не істейсіз?
Dialogue: 0,1:08:00.72,1:08:02.68,Japonais,,0,0,0,,Кел, Шенрон!
Dialogue: 0,1:08:02.68,1:08:05.22,Japonais,,0,0,0,,Тілегіңіз орындалсын!
Dialogue: 0,1:08:06.85,1:08:07.73,Japonais,,0,0,0,,Мен көремін.
Dialogue: 0,1:08:07.73,1:08:10.56,Japonais,,0,0,0,,Шенронның Жерді жоюды тоқтатқанын қалайсыз ба? !
Dialogue: 0,1:08:11.73,1:08:13.31,Japonais,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,1:08:29.46,1:08:31.83,Japonais,,0,0,0,,Capsule Corporation?
Dialogue: 0,1:08:32.46,1:08:35.54,Japonais,,0,0,0,,Байлардың аттракциондары жарқырайды!
Dialogue: 0,1:08:36.63,1:08:39.51,Japonais,,0,0,0,,Кез келген тілекті орындаймын
Dialogue: 0,1:08:39.67,1:08:40.97,Japonais,,0,0,0,,Енді айт!
Dialogue: 0,1:08:41.43,1:08:43.39,Japonais,,0,0,0,,Міне, сіз! Шенрон!
Dialogue: 0,1:08:45.05,1:08:47.85,Japonais,,0,0,0,,Сіз Super Saiyan Құдайының не екенін білесіз бе?
Dialogue: 0,1:08:48.43,1:08:49.43,Japonais,,0,0,0,,Бұл не?
Dialogue: 0,1:08:50.56,1:08:53.56,Japonais,,0,0,0,,Дәл осы сұрақты мен қояйын деп жүргенмін.
Dialogue: 0,1:08:53.85,1:08:55.65,Japonais,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,1:08:56.19,1:08:57.86,Japonais,,0,0,0,,Сіз білесіз бе? Шынымен бе?
Dialogue: 0,1:08:58.11,1:08:59.19,Japonais,,0,0,0,,Бұл рас
Dialogue: 0,1:08:59.36,1:09:03.16,Japonais,,0,0,0,,Сіздің тілегіңіз орындалды ма, жоқ па?
Dialogue: 0,1:09:03.16,1:09:04.57,Japonais,,0,0,0,,No, no, no, no
Dialogue: 0,1:09:04.74,1:09:07.62,Japonais,,0,0,0,,Егер сіз білмесеңіз, мені осында әкеле аласыз ба?
Dialogue: 0,1:09:08.04,1:09:09.66,Japonais,,0,0,0,,әкелуге болмайды
Dialogue: 0,1:09:09.87,1:09:11.79,Japonais,,0,0,0,,Өйткені ол жоқ
Dialogue: 0,1:09:12.62,1:09:15.33,Japonais,,0,0,0,,Супер Сайян Құдайы бұл...
Dialogue: 0,1:09:15.54,1:09:21.84,Japonais,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:09:19.80,1:09:21.84,Japonais,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:09:21.88,1:09:23.51,Japonais,,0,0,0,,Менің сұрақтарым көп.
Dialogue: 0,1:09:23.72,1:09:26.05,Japonais,,0,0,0,,Сіздің қалауыңыз қандай?
Dialogue: 0,1:09:26.72,1:09:30.81,Japonais,,0,0,0,,Лорд Берус менің Супер Сайян құдайын алып шыққанымды қалайды.
Dialogue: 0,1:09:32.14,1:09:33.81,Japonais,,0,0,0,,Беерус-сама?
Dialogue: 0,1:09:34.69,1:09:37.06,Japonais,,0,0,0,,Бұл Берус-сама, танысқаныма қуаныштымын.
Dialogue: 0,1:09:37.15,1:09:41.19,Japonais,,0,0,0,,Маған супер Сайян құдайын қалай жасау керектігін үйретіңіз
Dialogue: 0,1:09:41.19,1:09:42.70,Japonais,,0,0,0,,А... иә!
Dialogue: 0,1:09:42.70,1:09:44.70,Japonais,,0,0,0,,Шенронды бірінші рет көріп тұрмын.
Dialogue: 0,1:09:46.07,1:09:49.37,Japonais,,0,0,0,,Супер Сайян Құдай ертеде болған.
Dialogue: 0,1:09:49.37,1:09:53.83,Japonais,,0,0,0,,Сайян жолдастарымның зұлымдығына күмәнім бар.
Dialogue: 0,1:09:54.04,1:09:58.17,Japonais,,0,0,0,,Бір уыс әділ сайяндар бас көтерді.
Dialogue: 0,1:09:58.34,1:10:01.05,Japonais,,0,0,0,,Кездейсоқ жаралған құтқарушы.
Dialogue: 0,1:10:01.80,1:10:04.38,Japonais,,0,0,0,,Құтқарушы зор күшке ие
Dialogue: 0,1:10:04.55,1:10:07.80,Japonais,,0,0,0,,Мен зұлым сайяндарды бірден жеңдім, бірақ
Dialogue: 0,1:10:08.43,1:10:13.56,Japonais,,0,0,0,,Санаулы сәттерде қайтып келе жатқанда оның қуаты таусылғандай болды.
Dialogue: 0,1:10:14.39,1:10:16.27,Japonais,,0,0,0,,Тағы да Вегета планетасы
Dialogue: 0,1:10:16.27,1:10:18.61,Japonais,,0,0,0,,Зұлым Сайянның жұлдызына айналу
Dialogue: 0,1:10:18.61,1:10:22.61,Japonais,,0,0,0,,Құтқарушы аңыздан өшірілді.
Dialogue: 0,1:10:23.28,1:10:25.86,Japonais,,0,0,0,,Бұл өшірілген аңыз не...
Dialogue: 0,1:10:25.86,1:10:27.61,Japonais,,0,0,0,,Бұл ұзақ әңгіме.
Dialogue: 0,1:10:27.61,1:10:29.16,Japonais,,0,0,0,,Түсіндің бе, Вегета?
Dialogue: 0,1:10:29.28,1:10:30.70,Japonais,,0,0,0,,Тынш! Тыныш
Dialogue: 0,1:10:31.20,1:10:35.75,Japonais,,0,0,0,,Бес жүректі сайандар қол ұстасып
Dialogue: 0,1:10:35.75,1:10:40.00,Japonais,,0,0,0,,Тағы бір әділ Сайянның жүрегіне нұр құйсақ,
Dialogue: 0,1:10:40.04,1:10:43.30,Japonais,,0,0,0,,Сайяндардың құдайына айналады.
Dialogue: 0,1:10:44.92,1:10:48.05,Japonais,,0,0,0,,Мен саған әдісті үйреттім, сау бол.
Dialogue: 0,1:10:48.47,1:10:50.39,Japonais,,0,0,0,,Кешіріңіз
Dialogue: 0,1:10:57.10,1:11:00.40,Japonais,,0,0,0,,Бес жүрегі таза сайандар?
Dialogue: 0,1:11:01.48,1:11:02.48,Japonais,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:11:02.90,1:11:05.90,Japonais,,0,0,0,,Мұндай екі ғана Сайян бар, олар Гохан және Готен.
Dialogue: 0,1:11:06.40,1:11:07.74,Japonais,,0,0,0,,Кешіріңіз, сіз
Dialogue: 0,1:11:07.91,1:11:09.70,Japonais,,0,0,0,,Вегета оған көмектесуге болмайтынын айтады.
Dialogue: 0,1:11:09.87,1:11:12.62,Japonais,,0,0,0,,Транкс оның есі дұрыс емес.
Dialogue: 0,1:11:13.41,1:11:17.66,Japonais,,0,0,0,,Кішкентай кезінен қызбен жүргендер арам.
Dialogue: 0,1:11:18.25,1:11:19.71,Japonais,,0,0,0,,Қандай сұмдық
Dialogue: 0,1:11:19.96,1:11:21.96,Japonais,,0,0,0,,Якимочи пісіріп жатқан жоқсың ба?
Dialogue: 0,1:11:22.29,1:11:23.88,Japonais,,0,0,0,,Дұрыс, Пикколо мырза!
Dialogue: 0,1:11:24.05,1:11:26.13,Japonais,,0,0,0,,Гоку да таза емес пе?
Dialogue: 0,1:11:28.22,1:11:30.47,Japonais,,0,0,0,,Гоку кінәсіз екені рас.
Dialogue: 0,1:11:30.59,1:11:32.60,Japonais,,0,0,0,,Таза күрескер ақымақ
Dialogue: 0,1:11:32.72,1:11:35.93,Japonais,,0,0,0,,Дұрыс, бұл сіздің жүрегіңіздің ісі.
Dialogue: 0,1:11:35.93,1:11:37.56,Japonais,,0,0,0,,Тыныш! Эротикалық қария!
Dialogue: 0,1:11:37.81,1:11:38.89,Japonais,,0,0,0,,Не?!
Dialogue: 0,1:11:38.89,1:11:40.06,Japonais,,0,0,0,,Гермитке!
Dialogue: 0,1:11:40.35,1:11:44.11,Japonais,,0,0,0,,Тезірек супер Сайян Құдайын дүниеге әкел!
Dialogue: 0,1:11:48.74,1:11:49.49,Japonais,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,1:11:49.70,1:11:51.28,Japonais,,0,0,0,,Егер сіз бұл туралы шамамен ойласаңыз
Dialogue: 0,1:11:51.62,1:11:54.37,Japonais,,0,0,0,,Мұндағы бес сайян
Dialogue: 0,1:11:54.58,1:11:57.29,Japonais,,0,0,0,,Сенің жүрегің жақсы деп үміттенемін.
Dialogue: 0,1:11:58.41,1:11:59.54,Japonais,,0,0,0,,Вегета да?
Dialogue: 0,1:11:59.79,1:12:00.83,Japonais,,0,0,0,,Сіз айтасыз!
Dialogue: 0,1:12:01.38,1:12:02.58,Japonais,,0,0,0,,Тіпті Вегета мырза
Dialogue: 0,1:12:02.71,1:12:05.09,Japonais,,0,0,0,,Бұрын жаман болған шығар, бірақ
Dialogue: 0,1:12:05.30,1:12:06.63,Japonais,,0,0,0,,Енді ше?
Dialogue: 0,1:12:06.92,1:12:07.80,Japonais,,0,0,0,,Жаман ба?
Dialogue: 0,1:12:08.17,1:12:09.76,Japonais,,0,0,0,,Иә, дұрыс...
Dialogue: 0,1:12:10.01,1:12:13.51,Japonais,,0,0,0,,Ол біраз уақыттан бері жамандық жасаған жоқ.
Dialogue: 0,1:12:15.06,1:12:16.27,Japonais,,0,0,0,,Маған тіл тигізбе!
Dialogue: 0,1:12:16.47,1:12:19.14,Japonais,,0,0,0,,Бұл Вегета-саманың жүрегі дұрыс! ?
Dialogue: 0,1:12:19.52,1:12:20.77,Japonais,,0,0,0,,Маған бәрібір.
Dialogue: 0,1:12:20.77,1:12:22.60,Japonais,,0,0,0,,Қазір көріңіз!
Dialogue: 0,1:12:39.58,1:12:41.50,Japonais,,0,0,0,,Неліктен Какарот басты кейіпкер?
Dialogue: 0,1:12:42.29,1:12:43.58,Japonais,,0,0,0,,Шағымдамаңыз!
Dialogue: 0,1:12:44.63,1:12:45.29,Japonais,,0,0,0,,Әкем
Dialogue: 0,1:12:45.92,1:12:47.88,Japonais,,0,0,0,,Бірдеңе өзгерді ме?
Dialogue: 0,1:12:48.51,1:12:50.38,Japonais,,0,0,0,,Енді... сіз қалай ойлайсыз?
Dialogue: 0,1:12:50.76,1:12:51.93,Japonais,,0,0,0,,Иә! Күте тұрыңыз...
Dialogue: 0,1:12:52.55,1:12:55.01,Japonais,,0,0,0,,Бұл асшаяндарды темпура деп атайсыз ба?
Dialogue: 0,1:13:06.61,1:13:08.03,Japonais,,0,0,0,,Мен де соны қалаймын.
Dialogue: 0,1:13:15.37,1:13:16.49,Japonais,,0,0,0,,Сіз мұны істедіңіз! ?
Dialogue: 0,1:13:20.08,1:13:21.75,Japonais,,0,0,0,,Сіз қалай ойлайсыз? Какарот?
Dialogue: 0,1:13:24.37,1:13:25.42,Japonais,,0,0,0,,Әкем
Dialogue: 0,1:13:25.42,1:13:27.29,Japonais,,0,0,0,,Бұл таңғажайып жауынгерлік күш.
Dialogue: 0,1:13:29.13,1:13:31.97,Japonais,,0,0,0,,Гоку ақыры құдайға айналды!
Dialogue: 0,1:13:31.97,1:13:34.72,Japonais,,0,0,0,,Немерем! Енді көрсет!
Dialogue: 0,1:13:34.72,1:13:36.43,Japonais,,0,0,0,,Тоқта, Гоку!
Dialogue: 0,1:13:38.01,1:13:39.51,Japonais,,0,0,0,,Ұрысудың пайдасы жоқ.
Dialogue: 0,1:13:39.93,1:13:41.56,Japonais,,0,0,0,,Бұл Құдай емес.
Dialogue: 0,1:13:41.77,1:13:42.64,Japonais,,0,0,0,,Және...бірақ!
Dialogue: 0,1:13:43.27,1:13:45.19,Japonais,,0,0,0,,Жауынгерлік күш артты
Dialogue: 0,1:13:45.52,1:13:48.44,Japonais,,0,0,0,,Бұл жай ғана әркімнің энергиясын жинады.
Dialogue: 0,1:13:50.11,1:13:51.57,Japonais,,0,0,0,,Міне...
Dialogue: 0,1:13:51.78,1:13:54.91,Japonais,,0,0,0,,Сіздің жауынгерлік қабілетіңіз сырттай көрініп тұрған сияқты.
Dialogue: 0,1:13:54.91,1:13:56.45,Japonais,,0,0,0,,Құдай деп атауға болмайды
Dialogue: 0,1:13:57.20,1:13:58.83,Japonais,,0,0,0,,Мен көрдім...
Dialogue: 0,1:13:59.12,1:14:00.20,Japonais,,0,0,0,,Өйткені
Dialogue: 0,1:14:00.58,1:14:02.33,Japonais,,0,0,0,,Мен Беерус-саманы жеңе алатындай сезінбеймін.
Dialogue: 0,1:14:02.66,1:14:03.54,Japonais,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:14:06.88,1:14:08.25,Japonais,,0,0,0,,Жарайсыңдар ма?
Dialogue: 0,1:14:08.63,1:14:10.25,Japonais,,0,0,0,,Есіңізде болсын...
Dialogue: 0,1:14:10.88,1:14:13.84,Japonais,,0,0,0,,Бес адамның нұрын басқа адамға құйыңыз.
Dialogue: 0,1:14:14.22,1:14:16.47,Japonais,,0,0,0,,Барлығы Сайан қажет
Dialogue: 0,1:14:16.55,1:14:18.39,Japonais,,0,0,0,,Бар болғаны 6 адам емес пе?
Dialogue: 0,1:14:19.39,1:14:20.26,Japonais,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:20.26,1:14:21.18,Japonais,,0,0,0,,Қате жіберді
Dialogue: 0,1:14:21.43,1:14:22.31,Japonais,,0,0,0,,Алты адам?
Dialogue: 0,1:14:22.60,1:14:23.77,Japonais,,0,0,0,,Мен осы маңдағы бірнеше ғибадатханаларды аралап келемін.
Dialogue: 0,1:14:23.77,1:14:25.31,Japonais,,0,0,0,,Тағы бір адам қалды
Dialogue: 0,1:14:25.44,1:14:29.23,Japonais,,0,0,0,,Иә! Вегета... сенің байсалды інің бар еді ғой, солай емес пе?
Dialogue: 0,1:14:29.40,1:14:30.82,Japonais,,0,0,0,,Алыстағы жұлдыз
Dialogue: 0,1:14:31.11,1:14:32.94,Japonais,,0,0,0,,Мен қайда екенін білмеймін.
Dialogue: 0,1:14:33.19,1:14:35.45,Japonais,,0,0,0,,Сіз менің ұялы телефон нөмірімді сұрамадыңыз ба?
Dialogue: 0,1:14:35.82,1:14:37.03,Japonais,,0,0,0,,Жетеді
Dialogue: 0,1:14:37.03,1:14:39.49,Japonais,,0,0,0,,Мен қызықты дамудан үміттендім.
Dialogue: 0,1:14:39.66,1:14:40.91,Japonais,,0,0,0,,Менің көңілім қалды!
Dialogue: 0,1:14:41.03,1:14:45.08,Japonais,,0,0,0,,Менің ұйқым қашып барады, сондықтан мен Жерді тез жойып, үйге барамын.
Dialogue: 0,1:14:46.08,1:14:47.12,Japonais,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:14:47.12,1:14:48.50,Japonais,,0,0,0,,Тағы бір адам бар
Dialogue: 0,1:14:49.75,1:14:50.63,Japonais,,0,0,0,,Видель мырза...
Dialogue: 0,1:14:50.63,1:14:51.80,Japonais,,0,0,0,,Басқа адам кім?
Dialogue: 0,1:14:52.09,1:14:52.80,Japonais,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:14:52.96,1:14:54.46,Japonais,,0,0,0,,Жалғыз айтып отырмын.
Dialogue: 0,1:14:54.97,1:14:57.22,Japonais,,0,0,0,,Мен жалғыз болуға тырысамын...
Dialogue: 0,1:14:57.30,1:14:58.14,Japonais,,0,0,0,,Бірақ
Dialogue: 0,1:14:58.22,1:15:00.72,Japonais,,0,0,0,,Тамырымда Сайян қанының ағып жатқаны рас...
Dialogue: 0,1:15:01.14,1:15:03.10,Japonais,,0,0,0,,Не туралы айтып тұрсың, Видель?
Dialogue: 0,1:15:03.18,1:15:04.56,Japonais,,0,0,0,,Әкем керемет, бірақ
Dialogue: 0,1:15:04.56,1:15:06.52,Japonais,,0,0,0,,Ол таза жер адамы.
Dialogue: 0,1:15:06.56,1:15:08.27,Japonais,,0,0,0,,Бұл менің әкем туралы емес!
Dialogue: 0,1:15:08.35,1:15:09.02,Japonais,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,1:15:09.60,1:15:11.31,Japonais,,0,0,0,,Видель-санның асқазанында...
Dialogue: 0,1:15:11.61,1:15:13.32,Japonais,,0,0,0,,Біз балалы боламыз!
Dialogue: 0,1:15:17.49,1:15:18.95,Japonais,,0,0,0,,Қалай... шынымен бе? ?
Dialogue: 0,1:15:19.74,1:15:20.95,Japonais,,0,0,0,,Бұл рас!
Dialogue: 0,1:15:21.20,1:15:23.66,Japonais,,0,0,0,,Мен Гоханды таң қалдыру үшін үндемеуге тырыстым, бірақ
Dialogue: 0,1:15:23.74,1:15:25.20,Japonais,,0,0,0,,Иә!
Dialogue: 0,1:15:32.13,1:15:33.38,Japonais,,0,0,0,,Сіз құдай боласыз ба?
Dialogue: 0,1:15:33.38,1:15:34.46,Japonais,,0,0,0,,солай емес пе?
Dialogue: 0,1:15:35.59,1:15:38.84,Japonais,,0,0,0,,Енді... енді... Видель-санды қосу арқылы басынан бастайық.
Dialogue: 0,1:15:40.01,1:15:41.60,Japonais,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:15:41.60,1:15:43.60,Japonais,,0,0,0,,Мен әлі туылмасам да...
Dialogue: 0,1:15:43.85,1:15:44.60,Japonais,,0,0,0,,Қалай болғанда да
Dialogue: 0,1:15:44.64,1:15:46.18,Japonais,,0,0,0,,Егер ол жұмыс істемесе, қолданып көрейік
Dialogue: 0,1:15:46.31,1:15:46.89,Japonais,,0,0,0,,Иә
Dialogue: 0,1:16:05.58,1:16:07.54,Japonais,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,1:17:09.47,1:17:11.60,Japonais,,0,0,0,,Бұл әдеттегі Гоку емес пе?
Dialogue: 0,1:17:11.81,1:17:12.77,Japonais,,0,0,0,,Бірақ қараңыз
Dialogue: 0,1:17:12.94,1:17:13.81,Japonais,,0,0,0,,Шаш
Dialogue: 0,1:17:13.81,1:17:14.52,Japonais,,0,0,0,,Қызыл!
Dialogue: 0,1:17:14.81,1:17:15.61,Japonais,,0,0,0,,Шынымен бе?
Dialogue: 0,1:17:15.61,1:17:17.61,Japonais,,0,0,0,,Ал сіз аздап арықтаған сияқтысыз.
Dialogue: 0,1:17:18.15,1:17:20.78,Japonais,,0,0,0,,Мен Гокудың жауынгерлік күшін білмеймін.
Dialogue: 0,1:17:21.03,1:17:22.24,Japonais,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:17:22.61,1:17:24.61,Japonais,,0,0,0,,Бұл сәтті болған сияқты.
Dialogue: 0,1:17:24.99,1:17:27.37,Japonais,,0,0,0,,Сабырлықпен күтуге тұрарлық еді.
Dialogue: 0,1:17:27.70,1:17:28.37,Japonais,,0,0,0,,Шынымен бе?
Dialogue: 0,1:17:28.45,1:17:29.16,Japonais,,0,0,0,,О...
Dialogue: 0,1:17:29.16,1:17:31.37,Japonais,,0,0,0,,Сіз Super Saiyan Құдайы болдыңыз ба?
Dialogue: 0,1:17:32.66,1:17:35.13,Japonais,,0,0,0,,Ұрыссаң, түсінерсің.
Dialogue: 0,1:17:35.13,1:17:37.54,Japonais,,0,0,0,,Кел, кел!
Dialogue: 0,1:17:37.71,1:17:38.55,Japonais,,0,0,0,,Жарайды!
Dialogue: 0,1:17:38.55,1:17:39.88,Japonais,,0,0,0,,Олай болса кеттік! ?
Dialogue: 0,1:17:40.13,1:17:40.84,Japonais,,0,0,0,,Жарайды.
Dialogue: 0,1:17:41.38,1:17:43.43,Japonais,,0,0,0,,Сен күштірек болсаң
Dialogue: 0,1:17:43.51,1:17:45.76,Japonais,,0,0,0,,Жерді құртпайық
Dialogue: 0,1:17:46.51,1:17:48.22,Japonais,,0,0,0,,Шынымен бе? Рақмет сізге!!!
Dialogue: 0,1:17:48.81,1:17:49.81,Japonais,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,1:17:49.97,1:17:51.06,Japonais,,0,0,0,,Бұл қауіпті.
Dialogue: 0,1:17:51.14,1:17:52.98,Japonais,,0,0,0,,Кішкене артқа шегініңіз.
Dialogue: 0,1:18:58.71,1:18:59.54,Japonais,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:18:59.75,1:19:01.92,Japonais,,0,0,0,,Сіз құдай болуға қалай қарайсыз?
Dialogue: 0,1:19:02.75,1:19:03.71,Japonais,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:19:03.92,1:19:06.51,Japonais,,0,0,0,,Иә, таң қалдыңыз ба?
Dialogue: 0,1:19:08.72,1:19:11.55,Japonais,,0,0,0,,Мен үшін де дәл осындай сезім.
Dialogue: 0,1:19:49.43,1:19:51.68,Japonais,,0,0,0,,Керемет! Бұл солай
Dialogue: 0,1:19:53.85,1:19:56.39,Japonais,,0,0,0,,Не болды? Сіз қанағаттанбаған сияқтысыз, солай емес пе?
Dialogue: 0,1:19:57.06,1:19:58.27,Japonais,,0,0,0,,Аздап
Dialogue: 0,1:19:58.52,1:20:00.19,Japonais,,0,0,0,,Құдайды ұнатпайсың ба?
Dialogue: 0,1:20:01.69,1:20:03.90,Japonais,,0,0,0,,Мен мұндай дүниенің болғанына сене алмаймын
Dialogue: 0,1:20:04.44,1:20:05.86,Japonais,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:20:06.36,1:20:08.82,Japonais,,0,0,0,,Бұл мен жалғыз келе алмайтын дүние.
Dialogue: 0,1:20:08.99,1:20:10.70,Japonais,,0,0,0,,Осыған көңіліңіз толмай ма?
Dialogue: 0,1:20:12.32,1:20:13.53,Japonais,,0,0,0,,Қанағаттанбадым!
Dialogue: 0,1:20:24.13,1:20:25.67,Japonais,,0,0,0,,Не? Бұл жер сілкінісі болды ма?
Dialogue: 0,1:20:28.13,1:20:30.09,Japonais,,0,0,0,,Қызықты айтатын адам.
Dialogue: 0,1:20:30.38,1:20:33.35,Japonais,,0,0,0,,Достарыммен құдайға айналу
Dialogue: 0,1:20:33.35,1:20:34.97,Japonais,,0,0,0,,Сізге ұнамай ма?
Dialogue: 0,1:20:36.77,1:20:37.93,Japonais,,0,0,0,,Қуаныш
Dialogue: 0,1:20:38.06,1:20:39.23,Japonais,,0,0,0,,Мен қуаныштымын
Dialogue: 0,1:20:39.93,1:20:41.94,Japonais,,0,0,0,,Мен барлығының көмегін алуым керек
Dialogue: 0,1:20:41.98,1:20:44.98,Japonais,,0,0,0,,Мен Беерус-самамен бұлай күресе алмадым.
Dialogue: 0,1:20:45.19,1:20:46.32,Japonais,,0,0,0,,Бұл көңілсіз!
Dialogue: 0,1:20:47.07,1:20:47.90,Japonais,,0,0,0,,Сонымен
Dialogue: 0,1:20:47.98,1:20:49.78,Japonais,,0,0,0,,Неліктен құдай болдың?
Dialogue: 0,1:20:50.57,1:20:53.24,Japonais,,0,0,0,,Себебі мен Беерус-самамен жекпе-жек өткізгім келді.
Dialogue: 0,1:20:54.12,1:20:56.49,Japonais,,0,0,0,,Сіз жауынгерлік ақымақсыз.
Dialogue: 0,1:20:57.16,1:20:58.87,Japonais,,0,0,0,,Бұл жиі айтылады
Dialogue: 0,1:21:18.60,1:21:19.81,Japonais,,0,0,0,,Мені қума!!!
Dialogue: 0,1:21:20.06,1:21:20.64,Japonais,,0,0,0,,Yes!!!
Dialogue: 0,1:21:33.36,1:21:34.16,Japonais,,0,0,0,,Барайық
Dialogue: 0,1:21:48.63,1:21:49.75,Japonais,,0,0,0,,It's picked up!
Dialogue: 0,1:22:17.49,1:22:18.45,Japonais,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:22:20.99,1:22:22.70,Japonais,,0,0,0,,Бір сәт кешіріңіз
Dialogue: 0,1:22:22.79,1:22:25.58,Japonais,,0,0,0,,Бұл жұмбақ және дәмді нәрсе не?
Dialogue: 0,1:22:27.79,1:22:29.09,Japonais,,0,0,0,,It's ice cream.
Dialogue: 0,1:22:29.38,1:22:30.92,Japonais,,0,0,0,,Балмұздақ?
Dialogue: 0,1:22:30.96,1:22:32.71,Japonais,,0,0,0,,So innovative!
Dialogue: 0,1:22:32.80,1:22:35.72,Japonais,,0,0,0,,Тамақты қалай салқын етіп жасауға болады?
Dialogue: 0,1:22:36.05,1:22:38.34,Japonais,,0,0,0,,Сіз оны қалай жасайсыз?
Dialogue: 0,1:22:39.18,1:22:40.31,Japonais,,0,0,0,,Мен білмеймін
Dialogue: 0,1:22:40.31,1:22:40.93,Japonais,,0,0,0,,Oh my...
Dialogue: 0,1:22:41.81,1:22:44.68,Japonais,,0,0,0,,Балмұздақ үшін ғана суық сөздер
Dialogue: 0,1:22:47.94,1:22:48.65,Japonais,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:22:48.69,1:22:51.36,Japonais,,0,0,0,,Ол сәл жақсырақ болған жоқ па?
Dialogue: 0,1:22:57.53,1:22:59.99,Japonais,,0,0,0,,Қандай керемет шайқас.
Dialogue: 0,1:23:00.95,1:23:02.16,Japonais,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,1:23:02.37,1:23:05.58,Japonais,,0,0,0,,Ол әрқашан өзімен бірге барлық дәмді заттарды ала келеді.
Dialogue: 0,1:23:06.12,1:23:06.83,Japonais,,0,0,0,,Бірақ...
Dialogue: 0,1:23:07.08,1:23:08.46,Japonais,,0,0,0,,Не...?
Dialogue: 0,1:23:11.71,1:23:13.42,Japonais,,0,0,0,,Мен емес екеніне қуаныштымын
Dialogue: 0,1:23:26.64,1:23:28.81,Japonais,,0,0,0,,Құдай әлі де наразы ма?
Dialogue: 0,1:23:28.90,1:23:29.65,Japonais,,0,0,0,,Жақсы!
Dialogue: 0,1:23:33.82,1:23:36.57,Japonais,,0,0,0,,Сол мақтаныш сенің әлсіздігіңе айналады.
Dialogue: 0,1:23:56.92,1:23:58.88,Japonais,,0,0,0,,Бұл ақымақ мақтаныш.
Dialogue: 0,1:24:00.64,1:24:03.93,Japonais,,0,0,0,,Сайянның мұндай нәрселерге ерекше көңіл бөлуі сирек.
Dialogue: 0,1:24:11.94,1:24:13.61,Japonais,,0,0,0,,What power!
Dialogue: 0,1:24:19.90,1:24:21.36,Japonais,,0,0,0,,Шындығында, онша кенеттен емес қой.
Dialogue: 0,1:24:22.07,1:24:23.83,Japonais,,0,0,0,,Вегета маған қарағанда жақсы
Dialogue: 0,1:24:24.20,1:24:26.29,Japonais,,0,0,0,,Менің мақтанышым әлдеқайда көп.
Dialogue: 0,1:24:27.20,1:24:28.04,Japonais,,0,0,0,,Ойланып көрейікші
Dialogue: 0,1:24:28.04,1:24:30.50,Japonais,,0,0,0,,Ол намысын лақтырып жіберді.
Dialogue: 0,1:24:30.54,1:24:32.21,Japonais,,0,0,0,,Сен бәрін қорғадың.
Dialogue: 0,1:24:32.63,1:24:33.33,Japonais,,0,0,0,,Мен білемін
Dialogue: 0,1:24:33.71,1:24:36.63,Japonais,,0,0,0,,Ол ханзада деген мақтаныштан бас тартуы керек.
Dialogue: 0,1:24:36.92,1:24:38.01,Japonais,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:24:38.01,1:24:40.43,Japonais,,0,0,0,,Мен сізге сәл құрметпен қараймын.
Dialogue: 0,1:24:41.88,1:24:43.14,Japonais,,0,0,0,,So you too
Dialogue: 0,1:24:43.14,1:24:45.60,Japonais,,0,0,0,,Тәкаппарлығыңды тастап, құдай болдың ғой?
Dialogue: 0,1:24:47.10,1:24:48.43,Japonais,,0,0,0,,Осындай нәрсе...
Dialogue: 0,1:24:48.73,1:24:49.68,Japonais,,0,0,0,,Those two
Dialogue: 0,1:24:49.68,1:24:51.69,Japonais,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,1:24:52.10,1:24:53.40,Japonais,,0,0,0,,Goku is like
Dialogue: 0,1:24:53.40,1:24:55.48,Japonais,,0,0,0,,Сіз жаттығудан өтіп жатқан сияқтысыз.
Dialogue: 0,1:24:57.44,1:24:58.53,Japonais,,0,0,0,,I tell you
Dialogue: 0,1:24:58.53,1:25:00.70,Japonais,,0,0,0,,Тіпті менің шағымдарым бар.
Dialogue: 0,1:25:01.45,1:25:02.41,Japonais,,0,0,0,,Не?
Dialogue: 0,1:25:03.03,1:25:06.74,Japonais,,0,0,0,,Мен әлі де шындап күрескен жоқпын.
Dialogue: 0,1:25:07.45,1:25:10.96,Japonais,,0,0,0,,Шынымен бе? Маған 80% беріңіз, мен байыпты болдым.
Dialogue: 0,1:25:11.75,1:25:12.58,Japonais,,0,0,0,,80%?
Dialogue: 0,1:25:14.92,1:25:18.09,Japonais,,0,0,0,,Олай болса, осы жылдамдыққа ілесе аласыз ба?
Dialogue: 0,1:25:30.02,1:25:32.02,Japonais,,0,0,0,,Не болды? So are you serious?
Dialogue: 0,1:25:33.35,1:25:35.23,Japonais,,0,0,0,,Мен байсалдымын!
Dialogue: 0,1:25:53.75,1:25:55.79,Japonais,,0,0,0,,Не! A projectile?
Dialogue: 0,1:26:01.01,1:26:03.34,Japonais,,0,0,0,,Мен спортпен айналыспаймын.
Dialogue: 0,1:26:22.15,1:26:25.57,Japonais,,0,0,0,,Жоюдан ләззат алма!
Dialogue: 0,1:26:48.26,1:26:49.89,Japonais,,0,0,0,,Ол құдай емес
Dialogue: 0,1:26:50.68,1:26:53.31,Japonais,,0,0,0,,Ол жай ғана Супер Сайян болып оралды.
Dialogue: 0,1:27:18.42,1:27:19.92,Japonais,,0,0,0,,Сіз оны көре аласыз ба? Криллин
Dialogue: 0,1:27:20.42,1:27:21.38,Japonais,,0,0,0,,Көрінбейді
Dialogue: 0,1:27:28.05,1:27:31.18,Japonais,,0,0,0,,Егер олар снарядтарды қолданса!
Dialogue: 0,1:27:33.64,1:27:34.72,Japonais,,0,0,0,,Ашуланған
Dialogue: 0,1:27:35.85,1:27:38.14,Japonais,,0,0,0,,Жақында кездесеміз!
Dialogue: 0,1:27:40.06,1:27:42.27,Japonais,,0,0,0,,Өтінемін! Өзіңізді еркін сезініңіз
Dialogue: 0,1:27:55.16,1:27:57.25,Japonais,,0,0,0,,Бұл Гоку Камехамеха
Dialogue: 0,1:28:06.30,1:28:07.26,Japonais,,0,0,0,,Не?
Dialogue: 0,1:28:16.52,1:28:18.18,Japonais,,0,0,0,,Өз кезегінде
Dialogue: 0,1:28:22.27,1:28:24.90,Japonais,,0,0,0,,Мен оны солай қабылдаймын!
Dialogue: 0,1:28:36.37,1:28:37.50,Japonais,,0,0,0,,Не? Бұл не?
Dialogue: 0,1:28:38.08,1:28:39.75,Japonais,,0,0,0,,Берус шабуылы
Dialogue: 0,1:28:39.75,1:28:41.21,Japonais,,0,0,0,,Ал... бұл жаман!
Dialogue: 0,1:28:51.43,1:28:54.22,Japonais,,0,0,0,,Сіз байқамаған сияқтысыз.
Dialogue: 0,1:28:54.60,1:28:56.01,Japonais,,0,0,0,,Не...?
Dialogue: 0,1:28:56.26,1:28:58.31,Japonais,,0,0,0,,Супер Сайян Құдай
Dialogue: 0,1:28:58.31,1:28:59.98,Japonais,,0,0,0,,Уақыт өтіп жатыр.
Dialogue: 0,1:29:00.52,1:29:02.14,Japonais,,0,0,0,,О... шынымен бе?
Dialogue: 0,1:29:04.65,1:29:06.23,Japonais,,0,0,0,,Сол сәтте брошьты алып, кокпитке қашып кетемін
Dialogue: 0,1:29:06.48,1:29:07.98,Japonais,,0,0,0,,Шамасы, сіз
Dialogue: 0,1:29:08.11,1:29:10.36,Japonais,,0,0,0,,Тәңір болып, соғысу
Dialogue: 0,1:29:10.36,1:29:14.57,Japonais,,0,0,0,,Сол дүниені бойыма сіңіріп алған сияқтымын.
Dialogue: 0,1:29:14.57,1:29:16.95,Japonais,,0,0,0,,Сонымен қалыпты жағдайға оралса да
Dialogue: 0,1:29:16.95,1:29:19.12,Japonais,,0,0,0,,Қуатты көп өшірген жоқ.
Dialogue: 0,1:29:19.87,1:29:21.29,Japonais,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,1:29:21.54,1:29:24.08,Japonais,,0,0,0,,Оны сирек данышпан деп атауға болады.
Dialogue: 0,1:29:24.58,1:29:27.00,Japonais,,0,0,0,,Егер бұл рас болса, мен бақытты болар едім.
Dialogue: 0,1:29:27.38,1:29:29.51,Japonais,,0,0,0,,Олай болса, жай ғана бақытты бол.
Dialogue: 0,1:29:29.51,1:29:31.51,Japonais,,0,0,0,,Сіз де соны қаладыңыз, солай ма?
Dialogue: 0,1:29:31.51,1:29:33.01,Japonais,,0,0,0,,Олай емес.
Dialogue: 0,1:29:33.51,1:29:35.22,Japonais,,0,0,0,,Ең үлкен мәселе қандай?
Dialogue: 0,1:29:36.14,1:29:38.31,Japonais,,0,0,0,,Дегенмен, қуат айырмашылығы ...
Dialogue: 0,1:29:38.31,1:29:40.02,Japonais,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,1:29:40.14,1:29:42.94,Japonais,,0,0,0,,Олай болса, беріл және беріл!!!
Dialogue: 0,1:30:32.61,1:30:34.28,Japonais,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:30:50.92,1:30:51.80,Japonais,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,1:31:03.14,1:31:04.14,Japonais,,0,0,0,,Гоку!
Dialogue: 0,1:31:04.23,1:31:05.98,Japonais,,0,0,0,,Гоку!
Dialogue: 0,1:31:49.06,1:31:51.02,Japonais,,0,0,0,,Сәлем! Жаңа ғана не істедің?
Dialogue: 0,1:31:51.98,1:31:54.23,Japonais,,0,0,0,,Мен...білмеймін!
Dialogue: 0,1:31:55.69,1:31:57.19,Japonais,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:31:58.20,1:31:59.86,Japonais,,0,0,0,,Қызық жігіт.
Dialogue: 0,1:32:16.17,1:32:19.18,Japonais,,0,0,0,,Не? Неге тоқтадың?
Dialogue: 0,1:32:19.59,1:32:22.18,Japonais,,0,0,0,,«Көңілім қалды» деуіңізді қаладым.
Dialogue: 0,1:32:24.26,1:32:25.18,Japonais,,0,0,0,,Кешіріңіз...
Dialogue: 0,1:32:26.10,1:32:27.48,Japonais,,0,0,0,,Кешіріңіз
Dialogue: 0,1:32:28.35,1:32:29.98,Japonais,,0,0,0,,Мықты бол, Беерус-сама.
Dialogue: 0,1:32:29.98,1:32:31.98,Japonais,,0,0,0,,Мен оған мүлдем сәйкес келе алмадым.
Dialogue: 0,1:32:32.81,1:32:34.65,Japonais,,0,0,0,,Күтілгендей, бұл әлемдегі ең жақсы!
Dialogue: 0,1:32:35.07,1:32:37.78,Japonais,,0,0,0,,Ақырында, Беердің, жойылу Құдайынан қорқу
Dialogue: 0,1:32:37.78,1:32:39.70,Japonais,,0,0,0,,Түсінген сияқтысыз.
Dialogue: 0,1:32:40.24,1:32:40.91,Japonais,,0,0,0,,Дегенмен
Dialogue: 0,1:32:40.91,1:32:43.37,Japonais,,0,0,0,,Сен де мықты едің.
Dialogue: 0,1:32:44.03,1:32:47.37,Japonais,,0,0,0,,Тіпті шайқастардың ұзақ тарихында...
Dialogue: 0,1:32:47.66,1:32:49.66,Japonais,,0,0,0,,Бұл екінші күшті болды
Dialogue: 0,1:32:50.71,1:32:52.83,Japonais,,0,0,0,,Бұл не, екінші сан?
Dialogue: 0,1:32:55.21,1:32:56.71,Japonais,,0,0,0,,Соңында
Dialogue: 0,1:32:56.71,1:32:59.13,Japonais,,0,0,0,,Сізге тағы бір жақсы нәрсе айтайын.
Dialogue: 0,1:32:59.47,1:33:02.97,Japonais,,0,0,0,,Не? Сіз жерді жоюды тоқтатасыз ба?
Dialogue: 0,1:33:03.51,1:33:04.76,Japonais,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:33:05.01,1:33:06.72,Japonais,,0,0,0,,Мен бір рет шешім қабылдадым
Dialogue: 0,1:33:06.72,1:33:08.72,Japonais,,0,0,0,,Бұл өзгермеу принципі.
Dialogue: 0,1:33:08.72,1:33:10.68,Japonais,,0,0,0,,Сонымен... не?
Dialogue: 0,1:33:11.27,1:33:15.15,Japonais,,0,0,0,,Мына жерде менің Уис есімді қызметшім бар.
Dialogue: 0,1:33:21.45,1:33:24.12,Japonais,,0,0,0,,Ол да менің қызметшім.
Dialogue: 0,1:33:24.16,1:33:25.78,Japonais,,0,0,0,,Шебер де бар.
Dialogue: 0,1:33:26.24,1:33:27.79,Japonais,,0,0,0,,Ұстаз! ?
Dialogue: 0,1:33:28.49,1:33:29.79,Japonais,,0,0,0,,Әлемдегі ең жақсысы не?
Dialogue: 0,1:33:31.62,1:33:34.13,Japonais,,0,0,0,,Бұл әлем жетінші ғалам.
Dialogue: 0,1:33:34.79,1:33:37.50,Japonais,,0,0,0,,Мен Әлемнің жойылу Құдайымын 7
Dialogue: 0,1:33:38.13,1:33:39.13,Japonais,,0,0,0,,Кеңістік
Dialogue: 0,1:33:39.59,1:33:41.47,Japonais,,0,0,0,,Барлығы 12.
Dialogue: 0,1:33:42.01,1:33:45.26,Japonais,,0,0,0,,Бұл жерде жақсы адамдар бар деп ойламайсыз ба?
Dialogue: 0,1:34:05.82,1:34:06.82,Japonais,,0,0,0,,Гоку!
Dialogue: 0,1:34:06.91,1:34:07.83,Japonais,,0,0,0,,Гоку!
Dialogue: 0,1:34:10.87,1:34:11.58,Japonais,,0,0,0,,Жарайды
Dialogue: 0,1:34:12.04,1:34:13.29,Japonais,,0,0,0,,Жылдамдықтан гөрі сабыр сақтауды басты ұстаным ет.
Dialogue: 0,1:34:13.58,1:34:15.21,Japonais,,0,0,0,,Уәде етілгендей
Dialogue: 0,1:34:15.21,1:34:17.63,Japonais,,0,0,0,,Жер жойылсын
Dialogue: 0,1:34:46.32,1:34:47.74,Japonais,,0,0,0,,Сәлем Берус-сама...
Dialogue: 0,1:34:48.28,1:34:51.45,Japonais,,0,0,0,,Сіз өте кішкентай Жерді жойдыңыз.
Dialogue: 0,1:34:52.08,1:34:53.20,Japonais,,0,0,0,,Өте жаман
Dialogue: 0,1:34:53.50,1:34:55.92,Japonais,,0,0,0,,Дене күшің қалмады ма?
Dialogue: 0,1:34:56.58,1:34:59.59,Japonais,,0,0,0,,Толық жоюды басқа уақытқа қалдырайық.
Dialogue: 0,1:35:00.46,1:35:01.38,Japonais,,0,0,0,,Лорд Берус!
Dialogue: 0,1:35:03.17,1:35:04.05,Japonais,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:35:04.34,1:35:05.88,Japonais,,0,0,0,,Егер Беерус-сама өлсе...
Dialogue: 0,1:35:05.88,1:35:08.01,Japonais,,0,0,0,,Сіз келесі жойылу Құдайы болғыңыз келе ме?
Dialogue: 0,1:35:08.09,1:35:08.59,Japonais,,0,0,0,,Эй!
Dialogue: 0,1:35:09.55,1:35:11.06,Japonais,,0,0,0,,Бұл үшін кешіріңіз!
Dialogue: 0,1:35:11.26,1:35:12.60,Japonais,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,1:35:12.93,1:35:14.31,Japonais,,0,0,0,,Леди Вегета
Dialogue: 0,1:35:14.85,1:35:15.60,Japonais,,0,0,0,,Мен?
Dialogue: 0,1:35:16.81,1:35:17.69,Japonais,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,1:35:18.06,1:35:20.19,Japonais,,0,0,0,,Осындай шу шығарғаным үшін кешіріңіз...
Dialogue: 0,1:35:21.27,1:35:24.19,Japonais,,0,0,0,,Оның орнына мені ұрғаныңыз үшін кешірім сұраңыз...
Dialogue: 0,1:35:25.65,1:35:26.45,Japonais,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,1:35:26.53,1:35:28.53,Japonais,,0,0,0,,Сәлем! Сен ақымақсың ба...
Dialogue: 0,1:35:28.61,1:35:31.33,Japonais,,0,0,0,,Қаласаңыз, мені тағы да кешке шақырыңыз.
Dialogue: 0,1:35:31.41,1:35:33.95,Japonais,,0,0,0,,Ашуланбаймын деп уәде берсеңіз.
Dialogue: 0,1:35:34.45,1:35:35.45,Japonais,,0,0,0,,Түсінікті!
Dialogue: 0,1:35:35.75,1:35:38.83,Japonais,,0,0,0,,Бұл жолы мен саған пудинг деген нәрсені жеуге рұқсат етемін.
Dialogue: 0,1:35:39.04,1:35:41.42,Japonais,,0,0,0,,Мен сізге бассейнді толтырамын!
Dialogue: 0,1:35:41.63,1:35:44.84,Japonais,,0,0,0,,Бірақ оны жегеннен кейін дәмі жаман болады деп айтпаңыз.
Dialogue: 0,1:35:45.21,1:35:48.68,Japonais,,0,0,0,,Қате кетсе, мен бұл жолы жерді құртамын.
Dialogue: 0,1:35:48.80,1:35:49.89,Japonais,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,1:35:50.01,1:35:51.05,Japonais,,0,0,0,,Сіз шайқаса аласыз, солай ма?
Dialogue: 0,1:35:51.14,1:35:51.93,Japonais,,0,0,0,,Лорд Берус?
Dialogue: 0,1:35:53.06,1:35:53.97,Japonais,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,1:36:10.66,1:36:12.07,Japonais,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,1:36:12.32,1:36:13.33,Japonais,,0,0,0,,Мүлдем.
Dialogue: 0,1:36:17.41,1:36:19.87,Japonais,,0,0,0,,Сол Жою құдайы Беерус-сама
Dialogue: 0,1:36:20.00,1:36:21.92,Japonais,,0,0,0,,Бұзған жоқ
Dialogue: 0,1:36:22.08,1:36:22.79,Japonais,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:36:22.96,1:36:24.34,Japonais,,0,0,0,,Аты Сон Гоку
Dialogue: 0,1:36:24.34,1:36:26.46,Japonais,,0,0,0,,Жұмбақ кейіпкерге байланысты ма?
Dialogue: 0,1:36:27.80,1:36:29.84,Japonais,,0,0,0,,Достар тез көбейеді
Dialogue: 0,1:36:30.55,1:36:31.30,Japonais,,0,0,0,,Соңында
Dialogue: 0,1:36:31.30,1:36:32.47,Japonais,,0,0,0,,Беерус-самаға
Dialogue: 0,1:36:33.89,1:36:34.64,Japonais,,0,0,0,,Жоқ
Dialogue: 0,1:36:35.14,1:36:38.56,Japonais,,0,0,0,,Мұның бәрі Сон Гокудың арқасында деп айта алмаймын.
Dialogue: 0,1:36:39.02,1:36:41.23,Japonais,,0,0,0,,Барлық жігіттер
Dialogue: 0,1:36:41.52,1:36:45.52,Japonais,,0,0,0,,Жоқ, мүмкін бұл Жер планетасының арқасында шығар.
Dialogue: 0,1:36:45.98,1:36:50.24,Japonais,,0,0,0,,Сон Гоку, ол қатыгез Сайян болуы керек.
Dialogue: 0,1:36:50.78,1:36:54.37,Japonais,,0,0,0,,Тіпті Вегета Жерге келгеннен кейін өзгерді.
Dialogue: 0,1:36:56.41,1:36:59.83,Japonais,,0,0,0,,Бұл адамдардан басқа керемет планета.
Dialogue: 0,1:37:00.54,1:37:02.12,Japonais,,0,0,0,,Ол кісі де
Dialogue: 0,1:37:02.37,1:37:04.42,Japonais,,0,0,0,,Әртүрлі мәселелер бар
Dialogue: 0,1:37:05.25,1:37:07.92,Japonais,,0,0,0,,Жұмбақ сүйкімділікке толы...
Dialogue: 0,1:37:11.80,1:37:14.22,Japonais,,0,0,0,,Сізге аздап ұнады ма?
Dialogue: 0,1:37:15.68,1:37:17.10,Japonais,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,1:37:17.10,1:37:21.10,Japonais,,0,0,0,,Оның мүмкіндігі өлшеусіз.
Dialogue: 0,1:37:21.31,1:37:25.61,Japonais,,0,0,0,,Жарайды... бұл шын мәнінде күшті жау емес еді...
Dialogue: 0,1:37:26.82,1:37:27.82,Japonais,,0,0,0,,Мұнда рух бар.
Dialogue: 0,1:37:28.07,1:37:31.45,Japonais,,0,0,0,,Беерус-саманың күші 70%-ға жетті...
Dialogue: 0,1:37:31.49,1:37:33.82,Japonais,,0,0,0,,Мен сені көрмегелі біраз болды.
Dialogue: 0,1:37:34.66,1:37:36.45,Japonais,,0,0,0,,Ол не деді?
Dialogue: 0,1:37:36.45,1:37:38.12,Japonais,,0,0,0,,Бұл Сон Гоку
Dialogue: 0,1:37:39.29,1:37:40.87,Japonais,,0,0,0,,Әлгі жігіт пен Вегета
Dialogue: 0,1:37:40.87,1:37:44.79,Japonais,,0,0,0,,Ол бір күні менің қас жауыма айналуы мүмкін.
Dialogue: 0,1:37:46.88,1:37:48.38,Japonais,,0,0,0,,Бақытты көрінеді
Dialogue: 0,1:37:48.55,1:37:50.05,Japonais,,0,0,0,,Бұл...
Dialogue: 0,1:37:50.34,1:37:53.34,Japonais,,0,0,0,,Екеуміз ұзақ өмір сүрсек қызық болар еді.
Dialogue: 0,1:37:53.76,1:37:56.80,Japonais,,0,0,0,,Не керек, мен ұйықтамаймын.
Dialogue: 0,1:37:57.43,1:37:58.39,Japonais,,0,0,0,,♪ Ка-та-на
Dialogue: 0,1:37:58.68,1:38:00.31,Japonais,,0,0,0,,Мен аздап шаршадым.
Dialogue: 0,1:38:00.31,1:38:02.52,Japonais,,0,0,0,,Мен 3 жылдай ұйықтаймын деп ойлаймын.
Dialogue: 0,1:38:02.98,1:38:04.06,Japonais,,0,0,0,,3 жыл?
Dialogue: 0,1:38:04.06,1:38:08.23,Japonais,,0,0,0,,Бұл қысқа ұйқы, дәл ұйқы сияқты.
Dialogue: 0,1:38:09.15,1:38:10.32,Japonais,,0,0,0,,Жерде
Dialogue: 0,1:38:10.32,1:38:12.61,Japonais,,0,0,0,,Тағы да дәмді тағам
Dialogue: 0,1:38:12.74,1:38:14.74,Japonais,,0,0,0,,Олар көп сияқты.
Dialogue: 0,1:38:16.57,1:38:18.87,Japonais,,0,0,0,,Тамақ дәмді болғанша
Dialogue: 0,1:38:18.91,1:38:22.08,Japonais,,0,0,0,,Жерді жою ниетіңіз болмаған сияқты.
Dialogue: 0,1:38:23.25,1:38:25.17,Japonais,,0,0,0,,Енді бұл туралы не деуге болады?
Dialogue: 0,1:38:27.13,1:38:28.25,Japonais,,0,0,0,,Ойланып көрейікші
Dialogue: 0,1:38:29.09,1:38:30.50,Japonais,,0,0,0,,Өте дәмді
Dialogue: 0,1:38:30.50,1:38:34.30,Japonais,,0,0,0,,Мен үйге апару үшін суши алдым.
Dialogue: 0,1:38:35.05,1:38:37.01,Japonais,,0,0,0,,Сен де жегің келе ме, Беерус-сама?
Dialogue: 0,1:38:37.30,1:38:39.35,Japonais,,0,0,0,,Әлде ұйықтайсың ба?
Dialogue: 0,1:38:40.01,1:38:41.85,Japonais,,0,0,0,,Әрине қабылдаймын.
Dialogue: 0,1:38:42.47,1:38:44.06,Japonais,,0,0,0,,Мен төбелесіп жатқанда
Dialogue: 0,1:38:44.06,1:38:48.19,Japonais,,0,0,0,,Сіз дәмді тағамды көп жеген сияқтысыз.
Dialogue: 0,1:38:48.40,1:38:49.52,Japonais,,0,0,0,,Whis
Dialogue: 0,1:38:53.57,1:38:56.07,Japonais,,0,0,0,,Бұл әдемі тағам.
Dialogue: 0,1:38:56.99,1:39:01.33,Japonais,,0,0,0,,Соя соусы деп аталатын осы сұйықтықтың кішкене бөлігімен жейді.
Dialogue: 0,1:39:01.91,1:39:04.37,Japonais,,0,0,0,,Бұл жасыл масса қандай?
Dialogue: 0,1:39:04.75,1:39:05.75,Japonais,,0,0,0,,Жек көру?
Dialogue: 0,1:39:07.21,1:39:08.79,Japonais,,0,0,0,,Енді ойлап қарасам, аспаз...
Dialogue: 0,1:39:08.96,1:39:10.00,Japonais,,0,0,0,,«Қалауыңызша»
Dialogue: 0,1:39:10.00,1:39:13.05,Japonais,,0,0,0,,Бұл васаби деген нәрсе емес пе?
Dialogue: 0,1:39:14.38,1:39:17.51,Japonais,,0,0,0,,Енді ойлап қарасам, біреудің осылай сөйлегенін естідім.
Dialogue: 0,1:39:17.76,1:39:19.93,Japonais,,0,0,0,,Мен ұрысқан кезде
Dialogue: 0,1:39:20.80,1:39:22.89,Japonais,,0,0,0,,Сусын әкеліңіз
Dialogue: 0,1:39:24.39,1:39:25.27,Japonais,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,1:39:39.70,1:39:40.66,Japonais,,0,0,0,,Жоқ!
Dialogue: 0,1:39:50.29,1:39:53.30,Japonais,,0,0,0,,Ауыруы қорқынышты.
Dialogue: 0,1:39:54.17,1:39:56.22,Japonais,,0,0,0,,Бейрус-сама бейкүнә планетада
Dialogue: 0,1:39:56.22,1:39:58.01,Japonais,,0,0,0,,Себебі сегіз соққы аласыз.
Dialogue: 0,1:39:59.47,1:40:01.55,Japonais,,0,0,0,,Жер кінәлі болды.
Dialogue: 0,1:40:02.10,1:40:04.56,Japonais,,0,0,0,,Жақсы! енді жерге қайт
Dialogue: 0,1:40:04.56,1:40:06.06,Japonais,,0,0,0,,Мен оны құртамын!
Dialogue: 0,1:40:06.48,1:40:07.60,Japonais,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,1:40:07.60,1:40:09.35,Japonais,,0,0,0,,«Өз қалауыңызша»
Мен
Dialogue: 0,1:40:09.52,1:40:10.94,Japonais,,0,0,0,,дедім
Dialogue: 0,1:40:11.23,1:40:14.15,Japonais,,0,0,0,,Себебі Беерус-сама бәрін бірден жеп қойды.
Dialogue: 0,1:40:15.90,1:40:17.61,Japonais,,0,0,0,,Сонымен суши дегеніміз не?
Dialogue: 0,1:40:17.61,1:40:19.78,Japonais,,0,0,0,,Дәміңе сай келмесе, құртып жібер
Dialogue: 0,1:40:19.78,1:40:21.78,Japonais,,0,0,0,,делік
Dialogue: 0,1:40:45.51,1:40:46.39,Japonais,,0,0,0,,Сонымен
Dialogue: 0,1:40:46.81,1:40:49.10,Japonais,,0,0,0,,Мені үш жылдан кейін оят.
Dialogue: 0,1:40:49.73,1:40:51.81,Japonais,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,1:40:54.90,1:40:56.65,Japonais,,0,0,0,,Сонымен... Қайырлы түн.
Dialogue: 0,1:41:09.62,1:41:12.50,Japonais,,0,0,0,,Беерус-сама, ұйықтар алдында тістеріңізді жақсылап тазалаңыз.
Dialogue: 0,1:41:14.54,1:41:16.92,Japonais,,0,0,0,,Түсінемін, түсінемін
Dialogue: 0,1:41:19.84,1:41:21.88,Japonais,,0,0,0,,Иә! Сосын тағы
Dialogue: 0,1:41:21.88,1:41:23.72,Japonais,,0,0,0,,Бұлма-сан, туған күнің құтты болсын...
Dialogue: 0,1:41:23.84,1:41:26.05,Japonais,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,1:41:26.05,1:41:27.26,Japonais,,0,0,0,,38 жаста!
Dialogue: 0,1:41:27.26,1:41:28.10,Japonais,,0,0,0,,Шулы!
Dialogue: 0,1:41:44.24,1:41:45.95,Japonais,,0,0,0,,Сіз бұрышта тұрсыз
Dialogue: 0,1:41:45.95,1:41:48.49,Japonais,,0,0,0,,Бұл бәрінен де қорқынышты болуы мүмкін.
Dialogue: 0,1:41:48.54,1:41:50.16,Japonais,,0,0,0,,Сәлем Какарот
Dialogue: 0,1:41:50.16,1:41:52.33,Japonais,,0,0,0,,Өйткені бұл жолы құдайға айналатын менмін.
Dialogue: 0,1:41:52.33,1:41:54.25,Japonais,,0,0,0,,Дұрыс ынтымақтастықта болыңыз!
Dialogue: 0,1:41:55.38,1:41:56.54,Japonais,,0,0,0,,Әрине!
Dialogue: 0,1:41:56.67,1:41:58.84,Japonais,,0,0,0,,Бірақ мен өзімді күштірек болуға мәжбүрледім.
Dialogue: 0,1:41:58.84,1:42:00.30,Japonais,,0,0,0,,Кейін шаршайсың!
Dialogue: 0,1:42:01.26,1:42:03.01,Japonais,,0,0,0,,Иә, Вегета
Dialogue: 0,1:42:03.09,1:42:05.14,Japonais,,0,0,0,,Сіздің гүлденушілеріңіз соққыға жығылған кезде
Dialogue: 0,1:42:05.14,1:42:07.30,Japonais,,0,0,0,,«Менің гүлдерім» ашуланып
Dialogue: 0,1:42:07.30,1:42:10.06,Japonais,,0,0,0,,Керемет, ол Супер Сайян болды.
Dialogue: 0,1:42:10.06,1:42:11.77,Japonais,,0,0,0,,Мен махаббатты сезіндім
Dialogue: 0,1:42:11.77,1:42:14.85,Japonais,,0,0,0,,О...олай айтқаным есімде жоқ!
Dialogue: 0,1:42:15.56,1:42:17.27,Japonais,,0,0,0,,Бірақ...бірақ сол кезде
Dialogue: 0,1:42:17.27,1:42:20.07,Japonais,,0,0,0,,Мен сізден міндетті түрде асып түстім деп ойлаймын.
Dialogue: 0,1:42:20.82,1:42:21.78,Japonais,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,1:42:22.65,1:42:25.07,Japonais,,0,0,0,,Келесі жолы қауіпті адаммен ұрысыңыз
Dialogue: 0,1:42:25.07,1:42:27.53,Japonais,,0,0,0,,Гүлдеріңді шапалақпен ұрсын.
Dialogue: 0,1:42:27.99,1:42:28.87,Japonais,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,1:42:29.33,1:42:30.04,Japonais,,0,0,0,,Әзіл
Dialogue: 0,1:42:30.74,1:42:32.54,Japonais,,0,0,0,,Вегета осылай болған кезде
Dialogue: 0,1:42:32.54,1:42:34.67,Japonais,,0,0,0,,Сіз болған жоқсыз, солай ма?
Dialogue: 0,1:42:35.71,1:42:38.13,Japonais,,0,0,0,,Мұнда телепортация арқылы баяғыда келген
Dialogue: 0,1:42:38.38,1:42:40.17,Japonais,,0,0,0,,Сіз не болып жатқанын бақылап тұрдыңыз, солай емес пе?
Dialogue: 0,1:42:41.46,1:42:42.67,Japonais,,0,0,0,,Ах... ммм.
Dialogue: 0,1:42:43.55,1:42:44.38,Japonais,,0,0,0,,Немерем!
Dialogue: 0,1:42:44.38,1:42:45.76,Japonais,,0,0,0,,Шынымен бе? Сен бейбақ!
Dialogue: 0,1:42:45.76,1:42:47.80,Japonais,,0,0,0,,Қалғандардың бәрі жеңілген кезде
Dialogue: 0,1:42:48.47,1:42:49.60,Japonais,,0,0,0,,жаман жаман
Dialogue: 0,1:42:49.60,1:42:51.39,Japonais,,0,0,0,,Қарсыласыңыздың қимылын бақылаңыз
Dialogue: 0,1:42:51.39,1:42:53.77,Japonais,,0,0,0,,Мен стратегияны жоспарлауды ойладым.
Dialogue: 0,1:42:53.77,1:42:56.73,Japonais,,0,0,0,,Ойыма ештеңе келмеді.
Dialogue: 0,1:42:56.73,1:42:57.56,Japonais,,0,0,0,,Блумерлер!
Dialogue: 0,1:42:57.56,1:42:59.90,Japonais,,0,0,0,,Бинтаға тағы бірнеше соққы беріңіз!
Dialogue: 0,1:42:59.90,1:43:00.94,Japonais,,0,0,0,,Бір, екі, үш.
Dialogue: 0,1:43:01.36,1:43:02.15,Japonais,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:43:02.15,1:43:04.32,Japonais,,0,0,0,,Мен бұл туралы ойладым!
Dialogue: 0,1:43:05.82,1:43:11.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
