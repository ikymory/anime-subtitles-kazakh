Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.04,0:00:25.00,STAFF,,0,0,0,,Бұл субтитрге арналған субтитрлер қытай және жапон субтитрлерінде қолжетімді.
Dialogue: 0,0:00:18.04,0:00:25.00,STAFF,,0,0,0,,Сценарий және аударма және түзету: Ое мам Уақыты: Фойзи Редакция: Юки Юки
Dialogue: 0,0:00:30.27,0:00:33.57,TEXT-JP-U,,0,0,0,,Құдайдың сүйіспеншілігі шексіз болғандықтан
Dialogue: 0,0:00:33.57,0:00:36.85,TEXT-JP-U,,0,0,0,,Құдайдың қаһарында да шек жоқ
Dialogue: 0,0:00:38.67,0:00:43.68,TEXT-JP-U,,0,0,0,,Бауырлар, бұл дүниенің зұлымдығына балға түсіріңдер.
Dialogue: 0,0:01:11.01,0:01:12.16,TEXT-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:46.82,0:01:47.73,TEXT-JP,,0,0,0,,Dr.
Dialogue: 0,0:01:49.37,0:01:50.94,TEXT-JP,,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,0:01:52.50,0:01:56.43,TEXT-JP,,0,0,0,,Қауіпсіздік тобымен байланыс жоқ. Жағдайы ауыр.
Dialogue: 0,0:01:56.68,0:01:58.68,TEXT-JP,,0,0,0,,Саған қалдырамын, Когами.
Dialogue: 0,0:01:59.23,0:02:00.68,TEXT-JP,,0,0,0,,Түсінді.
Dialogue: 0,0:02:07.46,0:02:08.91,TEXT-JP,,0,0,0,,Бір рет кетіңіз
Dialogue: 0,0:02:08.91,0:02:10.43,TEXT-JP,,0,0,0,,Когами, өтінемін, алға.
Dialogue: 0,0:02:21.16,0:02:22.41,TEXT-JP,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:02:23.65,0:02:25.19,TEXT-JP,,0,0,0,,Мен күттім
Dialogue: 0,0:02:28.85,0:02:30.73,TEXT-JP,,0,0,0,,Сен Кайды орындамадың.
Dialogue: 0,0:02:32.19,0:02:33.74,TEXT-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:34.80,0:02:38.50,TEXT-JP,,0,0,0,,Менің В жоспарына ауысудан басқа амалым жоқ.
Dialogue: 0,0:02:53.26,0:02:54.69,TEXT-JP,,0,0,0,,Күшейткіштер келеді
Dialogue: 0,0:02:56.54,0:02:58.15,TEXT-JP,,0,0,0,,Барлығы шегінеді.
Dialogue: 0,0:02:58.15,0:03:00.50,TEXT-JP,,0,0,0,,Мен саған уақыт сатып аламын
Dialogue: 0,0:03:44.03,0:03:49.25,TEXT-JP,,0,0,0,,Сіз туралы бұрын алдын ала айтылғандар бойынша
Dialogue: 0,0:03:52.05,0:03:54.70,TEXT-JP,,0,0,0,,Осы бұйрықты беріңіз
Dialogue: 0,0:03:56.35,0:04:01.42,TEXT-JP,,0,0,0,,Пайғамбарлықпен шыңдалып, ерлікпен күрес.
Dialogue: 0,0:04:19.72,0:04:21.62,TEXT-JP,,0,0,0,,Когами Жағдай қандай?
Dialogue: 0,0:04:22.96,0:04:26.37,TEXT-JP,,0,0,0,,Кешіріңіз, мен жеңілдім.
Dialogue: 0,0:06:11.48,0:06:14.01,TEXT-JP,,0,0,0,,Сибил жүйесінің бақылауында
Dialogue: 0,0:06:14.01,0:06:15.85,TEXT-JP,,0,0,0,,Заң талап етілмейді
Dialogue: 0,0:06:16.85,0:06:18.99,TEXT-JP,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:06:18.99,0:06:20.61,TEXT-JP,,0,0,0,,Мүмкін... көру қабілетім де бұлдырап бара жатқан болар?
Dialogue: 0,0:06:20.61,0:06:23.56,TEXT-JP,,0,0,0,,Сізді не алаңдатады?
Dialogue: 0,0:06:23.56,0:06:26.70,TEXT-JP,,0,0,0,,Құқықты жою халықаралық құқықты да жоққа шығарады
Dialogue: 0,0:06:27.53,0:06:29.65,TEXT-JP,,0,0,0,,Жапония әлеммен бетпе-бет келуге тиіс уақытта...
Dialogue: 0,0:06:29.65,0:06:32.62,TEXT-JP,,0,0,0,,Сиан нақты нәтижелер шығаруда.
Dialogue: 0,0:06:33.33,0:06:38.63,TEXT-JP,,0,0,0,,Сибил жүйесі жаһандық жаңа әлемдік тәртіп ретінде танылды.
Dialogue: 0,0:06:39.21,0:06:42.80,TEXT-JP,,0,0,0,,Отандық немесе шетелдік екеніне қарамастан
Dialogue: 0,0:06:43.42,0:06:46.14,TEXT-JP,,0,0,0,,Заң қажетсіз болады
Dialogue: 0,0:06:46.97,0:06:49.39,TEXT-JP,,0,0,0,,Мен қалаған нәрсені істей аламын ба?
Dialogue: 0,0:06:49.57,0:06:50.78,TEXT-JP,,0,0,0,,Синдо мырза
Dialogue: 0,0:06:51.70,0:06:52.91,TEXT-JP,,0,0,0,,It's okay.
Dialogue: 0,0:06:53.68,0:06:57.17,TEXT-JP,,0,0,0,,Оның реңкі сенікінен айқынырақ.
Dialogue: 0,0:06:58.50,0:07:02.53,TEXT-JP,,0,0,0,,Біз де Әділет министрлігінің пікірін тыңдауымыз керек емес пе?
Dialogue: 0,0:07:03.47,0:07:09.16,TEXT-JP,,0,0,0,,Ал, заңды толық жою, Әділет министрлігін тарату
Dialogue: 0,0:07:09.16,0:07:12.29,TEXT-JP,,0,0,0,,қандай да бір өрескел...
Dialogue: 0,0:07:12.29,0:07:15.69,TEXT-JP,,0,0,0,,Құқықтық мемлекет ұғымы
Dialogue: 0,0:07:15.69,0:07:19.06,TEXT-JP,,0,0,0,,Ол рөлді Сибил орындады.
Dialogue: 0,0:07:19.06,0:07:20.29,TEXT-JP,,0,0,0,,Сол заттар
Dialogue: 0,0:07:20.82,0:07:23.06,TEXT-JP,,0,0,0,,Nona Tower жабық бөлмесінде шешілмеген
Dialogue: 0,0:07:23.68,0:07:26.25,TEXT-JP,,0,0,0,,Біз халықтың жалпы қалауын сұрауымыз керек
Dialogue: 0,0:07:26.25,0:07:29.59,TEXT-JP,,0,0,0,,Бұл консенсус жүйені таниды.
Dialogue: 0,0:07:30.26,0:07:34.73,TEXT-JP,,0,0,0,,Өзіңіз Денсаулық және әл-ауқат министрлігін құрметтемейсіз бе?
Dialogue: 0,0:07:34.73,0:07:36.06,TEXT-JP,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:07:36.93,0:07:42.97,TEXT-JP,,0,0,0,,Жапонияның қазіргі көрші елдерді қанау және жыртқыш экономикасын кеңейту әдісі
Dialogue: 0,0:07:42.97,0:07:44.43,TEXT-JP,,0,0,0,,Мен алаңдаймын.
Dialogue: 0,0:07:46.32,0:07:48.06,TEXT-JP,,0,0,0,,Бұл тәртіпсіздік
Dialogue: 0,0:07:48.06,0:07:52.45,TEXT-JP,,0,0,0,,Қару-жарақ экспорты - дүние жүзіндегі бейбітшілікке пайдалы көмек
Dialogue: 0,0:07:54.15,0:07:57.00,TEXT-JP,,0,0,0,,Ал, бәрің тынышталыңдар.
Dialogue: 0,0:07:58.37,0:08:03.09,TEXT-JP,,0,0,0,,Бұл Сибилді енгізуге дейін болған шатасуға ұқсайды.
Dialogue: 0,0:08:03.72,0:08:07.74,TEXT-JP,,0,0,0,,Біріншіден, Жапонияға қауіп төніп тұр деп ойлайтын кез келді
Dialogue: 0,0:08:07.74,0:08:13.25,TEXT-JP,,0,0,0,,Цунемори мырзаның дәлелімен келісемін.
Dialogue: 0,0:08:13.25,0:08:15.10,TEXT-JP,,0,0,0,,Сіз де солай.
Dialogue: 0,0:08:15.63,0:08:22.32,TEXT-JP,,0,0,0,,Шындығында, бұл конференцияда Жапония мен әлем арасындағы қарым-қатынасты ашатын қонақ бар.
Dialogue: 0,0:08:22.32,0:08:24.11,TEXT-JP,,0,0,0,,Ол келуі керек еді.
Dialogue: 0,0:08:25.21,0:08:27.11,TEXT-JP,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:08:28.37,0:08:32.38,TEXT-JP,,0,0,0,,Иә, ол уақытында үлгермеді.
Dialogue: 0,0:08:38.79,0:08:40.00,TEXT-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:45.63,0:08:48.50,TEXT-JP,,0,0,0,,Жапония жағалау күзеті қандай есеп берді?
Dialogue: 0,0:08:48.50,0:08:51.26,TEXT-JP,,0,0,0,,Шетелдік Grootslang кемесі
Dialogue: 0,0:08:51.26,0:08:54.91,TEXT-JP,,0,0,0,,Бортта өлгендер көп, тірі қалғандар жоқ
Dialogue: 0,0:08:55.33,0:08:57.19,TEXT-JP,,0,0,0,,Атыс айғағы
Dialogue: 0,0:08:58.21,0:08:59.55,TEXT-JP,,0,0,0,,Түсіру?
Dialogue: 0,0:08:59.55,0:09:01.17,TEXT-JP,,0,0,0,,Барлығы нұсқаулыққа сәйкес дәл осылай өтті.
Dialogue: 0,0:09:01.17,0:09:03.77,TEXT-JP,,0,0,0,,Бұл саясаткер ретінде ойнайтын уақыт емес.
Dialogue: 0,0:09:04.90,0:09:09.03,TEXT-JP,,0,0,0,,Иә, Сыртқы істер министрлігі деген осы.
Dialogue: 0,0:09:10.09,0:09:11.77,TEXT-JP,,0,0,0,,Хиёри! Қош келдің!
Dialogue: 0,0:09:13.56,0:09:14.90,TEXT-JP,,0,0,0,,Мен бірден жолға шығамын.
Dialogue: 0,0:09:16.06,0:09:18.35,TEXT-JP,,0,0,0,,Мен жиналысты аяқтадым.
Dialogue: 0,0:09:19.96,0:09:21.77,TEXT-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:21.77,0:09:23.42,TEXT-JP,,0,0,0,,Бұл шұғыл іс пе?
Dialogue: 0,0:09:23.42,0:09:26.38,TEXT-JP,,0,0,0,,Иә, шетелдік кемеде оқиға болды.
Dialogue: 0,0:09:27.00,0:09:30.80,TEXT-JP,,0,0,0,,Мүмкін Грозланг?
Dialogue: 0,0:09:31.63,0:09:32.77,TEXT-JP,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:09:36.31,0:09:41.81,TEXT-JP,,0,0,0,,Кемеде конференцияның қонағы доктор Милиция Сторонская болды.
Dialogue: 0,0:09:42.81,0:09:46.77,TEXT-JP,,0,0,0,,Мінез-құлық экономикасы мен статистикасы бойынша әлемдік билік
Dialogue: 0,0:09:47.73,0:09:53.41,TEXT-JP,,0,0,0,,Соңғы жылдары ол симуляцияның негізгі теориясын құрды.
Dialogue: 0,0:09:53.41,0:09:55.07,TEXT-JP,,0,0,0,,Модельдеу?
Dialogue: 0,0:09:55.48,0:09:58.90,TEXT-JP,,0,0,0,,Әдетте Сторонская құжаттары ретінде белгілі
Dialogue: 0,0:09:58.90,0:10:03.46,TEXT-JP,,0,0,0,,Сіз оны Сибилдің әлемге әсерін болжау үшін пайдалана аласыз.
Dialogue: 0,0:10:04.71,0:10:08.34,TEXT-JP,,0,0,0,,Факттер Теан да болжағандай шықты.
Dialogue: 0,0:10:11.18,0:10:13.16,TEXT-JP,,0,0,0,,Мен бұл сезімді түсінемін.
Dialogue: 0,0:10:14.91,0:10:16.85,TEXT-JP,,0,0,0,,Дәрігер кім? Қайда?
Dialogue: 0,0:10:16.85,0:10:19.86,TEXT-JP,,0,0,0,,Мен иммиграциялық бюрода болған кезде
Dialogue: 0,0:10:19.86,0:10:22.47,TEXT-JP,,0,0,0,,Мен де саған ұқсағым келді.
Dialogue: 0,0:10:22.47,0:10:27.74,TEXT-JP,,0,0,0,,Мен Синдо мырзаның иммигранттарды өзі қабылдай алатынын естідім.
Dialogue: 0,0:10:27.74,0:10:30.48,TEXT-JP,,0,0,0,,Сол себепті ол заңды жалғастыруды сұрады.
Dialogue: 0,0:10:30.48,0:10:32.75,TEXT-JP,,0,0,0,,Бұл қиын болды
Dialogue: 0,0:10:32.75,0:10:37.80,TEXT-JP,,0,0,0,,«Барлық босқындарды өлтіруді» шындап ойлайтын адамдар бар.
Dialogue: 0,0:10:38.39,0:10:43.50,TEXT-JP,,0,0,0,,Айтпақшы, елдің ашылуы мен заңның жалғасуы неге жиынтық екенін түсінесіз бе?
Dialogue: 0,0:10:44.76,0:10:47.42,TEXT-JP,,0,0,0,,Өйткені олардың көпшілігінде қақтығыс тәжірибесі бар.
Dialogue: 0,0:10:48.46,0:10:51.10,TEXT-JP,,0,0,0,,Сибил стандарттары бойынша қабылдау қиын
Dialogue: 0,0:10:51.10,0:10:54.97,TEXT-JP,,0,0,0,,Ел халықаралық құқыққа негізделмесе, оны ашу мүмкін емес.
Dialogue: 0,0:10:54.97,0:10:56.35,TEXT-JP,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:10:56.35,0:10:57.98,TEXT-JP,,0,0,0,,және нәтиже
Dialogue: 0,0:10:57.98,0:11:01.14,TEXT-JP,,0,0,0,,Әлем қалпына келе жатқанда Жапония артта қалады
Dialogue: 0,0:11:02.62,0:11:06.94,TEXT-JP,,0,0,0,,Синдо мырза қабылдауға қалай қол жеткізді?
Dialogue: 0,0:11:07.85,0:11:11.53,TEXT-JP,,0,0,0,,Біріншіден, қазіргідей айналаңыздағыларға немқұрайлы қарамаңыз.
Dialogue: 0,0:11:11.53,0:11:13.32,TEXT-JP,,0,0,0,,Абайлаңыз
Dialogue: 0,0:11:15.71,0:11:16.70,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:11:18.56,0:11:21.79,TEXT-JP,,0,0,0,,Сіз тым ұзақ уақыт бақылаушы болдыңыз.
Dialogue: 0,0:11:21.79,0:11:23.86,TEXT-JP,,0,0,0,,Жоғары мақсат қойыңыз
Dialogue: 0,0:11:23.86,0:11:26.46,TEXT-JP,,0,0,0,,Мен Цунемори-саннан үлкен үміт күтемін.
Dialogue: 0,0:11:27.35,0:11:28.89,TEXT-JP,,0,0,0,,Маған?
Dialogue: 0,0:11:30.10,0:11:32.41,TEXT-JP,,0,0,0,,Үлкен үміт күтпесең, өтірік айтасың.
Dialogue: 0,0:11:32.41,0:11:37.22,TEXT-JP,,0,0,0,,Сибил жүйесіне күмән келтіре отырып, оның реңктері тамаша.
Dialogue: 0,0:11:38.24,0:11:41.47,TEXT-JP,,0,0,0,,Жүйенің мәнін танимын.
Dialogue: 0,0:11:42.86,0:11:46.35,TEXT-JP,,0,0,0,,Сенетін тағы бір нәрсе бар.
Dialogue: 0,0:11:48.08,0:11:50.66,TEXT-JP,,0,0,0,,Сол сияқты.
Dialogue: 0,0:12:01.49,0:12:06.73,TEXT-JP,,0,0,0,,Ішкі тергеу өкілеттігі бізге, Қоғамдық қауіпсіздік бюросына берілген.
Dialogue: 0,0:12:06.73,0:12:09.54,TEXT-JP,,0,0,0,,Үйге тез қайт, Сыртқы істер министрлігі
Dialogue: 0,0:12:09.97,0:12:13.27,TEXT-JP,,0,0,0,,Эй, мен мұны бейбіт түрде аяқтағым келеді.
Dialogue: 0,0:12:13.27,0:12:15.63,TEXT-JP,,0,0,0,,Шулы, еститін құлақ жоқ
Dialogue: 0,0:12:31.70,0:12:33.07,TEXT-JP,,0,0,0,,Фредерика
Dialogue: 0,0:12:33.59,0:12:35.17,TEXT-JP,,0,0,0,,Көптен бері көрмеген.
Dialogue: 0,0:12:36.79,0:12:37.65,TEXT-JP,,0,0,0,,Сәлем
Dialogue: 0,0:12:37.65,0:12:41.66,TEXT-JP,,0,0,0,,Бұл Ябуки, Сыртқы істер министрлігі Шетелдегі үйлестіру бюросының бас директоры.
Dialogue: 0,0:12:42.16,0:12:47.40,TEXT-JP,,0,0,0,,Мен сізге егжей-тегжейлі айта алмаймын, бірақ бұл кеме Сыртқы істер министрлігінің маңызды мәселесіне қатысты.
Dialogue: 0,0:12:47.40,0:12:49.29,TEXT-JP,,0,0,0,,Тергеуді маған тапсырғанын қалаймын.
Dialogue: 0,0:12:50.77,0:12:52.69,TEXT-JP,,0,0,0,,Шетелдегі үйлестіру бюросы
Dialogue: 0,0:12:53.56,0:12:56.30,TEXT-JP,,0,0,0,,Біз осындамыз. Барлығы осында.
Dialogue: 0,0:12:58.37,0:13:00.05,TEXT-JP,,0,0,0,,Директор Каси
Dialogue: 0,0:13:01.00,0:13:02.26,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:13:02.84,0:13:07.43,TEXT-JP,,0,0,0,,Алаңды Сыртқы істер министрлігіне қалдырыңыз, бәріңіз орныңыздан тұруыңыз керек.
Dialogue: 0,0:13:13.55,0:13:16.64,TEXT-JP,,0,0,0,,Қосымша ақпарат алу үшін Қоғамдық қауіпсіздік бюросына хабарласыңыз.
Dialogue: 0,0:13:32.29,0:13:33.94,TEXT-JP,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:13:33.94,0:13:37.04,TEXT-JP,,0,0,0,,Әй, жеткізуге көп уақыт кетеді.
Dialogue: 0,0:13:41.36,0:13:42.97,TEXT-JP,,0,0,0,,Құтқару жіпсіз
Dialogue: 0,0:13:44.30,0:13:46.71,TEXT-JP,,0,0,0,,Сіз тым терең сүңгіп жатырсыз.
Dialogue: 0,0:13:51.20,0:13:52.93,TEXT-JP,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:13:52.93,0:13:55.98,TEXT-JP,,0,0,0,,Қозғалғаннан кейін тоқтауға рұқсат етілмейді.
Dialogue: 0,0:13:57.98,0:14:00.06,TEXT-JP,,0,0,0,,Сіз үндемей шегінуді жоспарлап отырсыз ба?
Dialogue: 0,0:14:00.70,0:14:02.73,TEXT-JP,,0,0,0,,Бас директордың бұйрығы.
Dialogue: 0,0:14:03.43,0:14:05.99,TEXT-JP,,0,0,0,,Өйткені мен осындай үлкен есімді әкеліп жатырмын.
Dialogue: 0,0:14:07.23,0:14:10.41,TEXT-JP,,0,0,0,,Кемеде бас Синдоның қонағы болды.
Dialogue: 0,0:14:11.14,0:14:13.25,TEXT-JP,,0,0,0,,Доктор Сторонская есімді әйел
Dialogue: 0,0:14:16.27,0:14:20.75,TEXT-JP,,0,0,0,,Бортта жауынгерлер болып көрінетін көптеген денелер табылды.
Dialogue: 0,0:14:21.26,0:14:24.59,TEXT-JP,,0,0,0,,Алайда залал ауыр және егжей-тегжейлері белгісіз.
Dialogue: 0,0:14:25.48,0:14:28.26,TEXT-JP,,0,0,0,,Олардың арасында бір ғана әйел болды.
Dialogue: 0,0:14:28.61,0:14:30.36,TEXT-JP,,0,0,0,,Мен бұл доктор екеніне сенімдімін.
Dialogue: 0,0:14:31.81,0:14:34.85,TEXT-JP,,0,0,0,,Дегенмен, жеке басыңызды растау үшін уақыт қажет.
Dialogue: 0,0:14:34.85,0:14:35.95,TEXT-JP,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:14:37.50,0:14:42.15,TEXT-JP,,0,0,0,,Ол кісі өлтіргеннен кейін басы кесілген, басы ешқашан табылмаған.
Dialogue: 0,0:14:43.74,0:14:44.79,TEXT-JP,,0,0,0,,Мойын
Dialogue: 0,0:14:45.64,0:14:51.04,TEXT-JP,,0,0,0,,Дәрігер бөлмесінде компьютерден мәліметтерді көшіріп, талдап жатырмыз.
Dialogue: 0,0:14:52.02,0:14:53.04,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:14:54.15,0:14:55.04,TEXT-JP,,0,0,0,,Ууух!
Dialogue: 0,0:14:55.42,0:14:57.75,TEXT-JP,,0,0,0,,Тіркелген деректерге қолданылады
Dialogue: 0,0:14:57.75,0:15:01.89,TEXT-JP,,0,0,0,,Мылтық Сыртқы істер министрлігінің Шетелдегі үйлестіру бюросында тіркелген.
Dialogue: 0,0:15:03.38,0:15:06.19,TEXT-JP,,0,0,0,,Сыртқы істер министрлігі докторды қорғады.
Dialogue: 0,0:15:07.34,0:15:11.02,TEXT-JP,,0,0,0,,Мұнда рұқсатсыз орналастырылған қарулы қызметкерлер
Dialogue: 0,0:15:11.02,0:15:12.48,TEXT-JP,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:15:13.05,0:15:16.47,TEXT-JP,,0,0,0,,Ханаширо да, Ябуки де тойып қалды.
Dialogue: 0,0:15:16.47,0:15:19.19,TEXT-JP,,0,0,0,,Қоқыс иісі шығады.
Dialogue: 0,0:15:20.12,0:15:20.89,TEXT-JP,,0,0,0,,Эй
Dialogue: 0,0:15:22.95,0:15:25.84,TEXT-JP,,0,0,0,,Өзгелер туралы көп жаман сөз айтпаған абзал.
Dialogue: 0,0:15:32.00,0:15:35.55,TEXT-JP,,0,0,0,,Бұл жігіт өнімділігі жоғары есту аппараттарын пайдаланады.
Dialogue: 0,0:15:39.91,0:15:43.05,TEXT-JP,,0,0,0,,Дәрігердің өлтірілгенін білдіңіз бе?
Dialogue: 0,0:15:43.64,0:15:46.05,TEXT-JP,,0,0,0,,Ах, Ябукиден.
Dialogue: 0,0:15:46.73,0:15:50.21,TEXT-JP,,0,0,0,,Сыртқы істер министрлігімен бірлесіп дәрігерді жасырын шақырды
Dialogue: 0,0:15:50.21,0:15:51.10,TEXT-JP,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:15:51.83,0:15:56.17,TEXT-JP,,0,0,0,,Өте құпия не? Бұл өте құпия, өйткені сіз ешкімге айтпайсыз.
Dialogue: 0,0:15:57.51,0:15:58.47,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:15:59.18,0:16:01.51,TEXT-JP,,0,0,0,,Компьютерлік талдау нәтижелері шықты.
Dialogue: 0,0:16:02.04,0:16:06.73,TEXT-JP,,0,0,0,,Дәрігер оқиға болған күні бір ғана электронды хат жіберді.
Dialogue: 0,0:16:07.62,0:16:08.86,TEXT-JP,,0,0,0,,Үй адамы?
Dialogue: 0,0:16:09.41,0:16:10.09,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:16:11.08,0:16:12.87,TEXT-JP,,0,0,0,,Бұл профессор Джодзи Сайга.
Dialogue: 0,0:16:21.71,0:16:24.30,TEXT-JP,,0,0,0,,Сізбен кенеттен байланысуымыз әдеттен тыс.
Dialogue: 0,0:16:24.74,0:16:27.26,TEXT-JP,,0,0,0,,Мұғалімнен не сұрағың келеді?
Dialogue: 0,0:16:32.83,0:16:33.71,TEXT-JP,,0,0,0,,Не болды?
Dialogue: 0,0:16:36.51,0:16:39.18,TEXT-JP,,0,0,0,,Джодзи Біраз уақыт өтті.
Dialogue: 0,0:16:41.31,0:16:43.64,TEXT-JP,,0,0,0,,Неге... сен
Dialogue: 0,0:16:43.64,0:16:46.53,TEXT-JP,,0,0,0,,Осылай айтасың, құрметің жетпейді.
Dialogue: 0,0:16:47.79,0:16:50.62,TEXT-JP,,0,0,0,,Біраз болды, Сенпай.
Dialogue: 0,0:16:51.43,0:16:53.21,TEXT-JP,,0,0,0,,Оқшаулау қондырғылары туралы не деуге болады?
Dialogue: 0,0:16:53.89,0:16:55.45,TEXT-JP,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:16:56.71,0:16:58.16,TEXT-JP,,0,0,0,,Мақсаты не?
Dialogue: 0,0:16:58.85,0:17:01.54,TEXT-JP,,0,0,0,,Бұл доктор Сторонская туралы.
Dialogue: 0,0:17:04.00,0:17:05.24,TEXT-JP,,0,0,0,,Солай ма?
Dialogue: 0,0:17:06.09,0:17:07.85,TEXT-JP,,0,0,0,,Жақын адамынан айырылды
Dialogue: 0,0:17:08.84,0:17:11.28,TEXT-JP,,0,0,0,,Мен барып ертегіні тыңдай аламын ба?
Dialogue: 0,0:17:11.28,0:17:12.81,TEXT-JP,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:17:12.81,0:17:17.22,TEXT-JP,,0,0,0,,Мен тек Цунемонори күзетшісімен осы мәселе туралы сөйлескім келеді.
Dialogue: 0,0:17:22.29,0:17:23.72,TEXT-JP,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:17:32.02,0:17:34.42,TEXT-JP,,0,0,0,,Сіздің доктормен қарым-қатынасыңыз қандай?
Dialogue: 0,0:17:35.87,0:17:38.83,TEXT-JP,,0,0,0,,Мені Синдо-санмен таныстырды.
Dialogue: 0,0:17:41.63,0:17:47.27,TEXT-JP,,0,0,0,,Ұзақ уақыт бұрын мен оның зерттеушісі ретінде отандық талдау деректерін ұсындым.
Dialogue: 0,0:17:48.18,0:17:50.84,TEXT-JP,,0,0,0,,Қашан кездессек те қызу айтысамыз.
Dialogue: 0,0:17:51.83,0:17:54.75,TEXT-JP,,0,0,0,,Жоқ. Чатта да солай ма?
Dialogue: 0,0:17:56.24,0:17:59.77,TEXT-JP,,0,0,0,,Дәрігер соңғы сөйлескен адам мұғалім болды.
Dialogue: 0,0:18:01.06,0:18:04.40,TEXT-JP,,0,0,0,,Бұл олардың зерттеу нәтижелерін тапсырғысы келетіні туралы хабарлама болды.
Dialogue: 0,0:18:05.83,0:18:07.40,TEXT-JP,,0,0,0,,Сторонская құжаттары
Dialogue: 0,0:18:08.20,0:18:09.48,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:18:10.14,0:18:11.52,TEXT-JP,,0,0,0,,Сіз оны алдыңыз ба?
Dialogue: 0,0:18:12.15,0:18:15.27,TEXT-JP,,0,0,0,,Бұл тез болар еді.
Dialogue: 0,0:18:15.27,0:18:18.91,TEXT-JP,,0,0,0,,Бұл мен алған нөмір.
Dialogue: 0,0:18:20.77,0:18:24.42,TEXT-JP,,0,0,0,,Ол Дежимадағы халықаралық пошта жәшігіне жіберілген сияқты.
Dialogue: 0,0:18:24.42,0:18:29.32,TEXT-JP,,0,0,0,,Абайлаңыз, мен жеке бармайынша оны ала алмаймын.
Dialogue: 0,0:18:30.33,0:18:32.34,TEXT-JP,,0,0,0,,Менімен бірге бола аласыз ба?
Dialogue: 0,0:18:32.86,0:18:34.59,TEXT-JP,,0,0,0,,Әрине маңызды емес.
Dialogue: 0,0:18:40.68,0:18:44.62,TEXT-JP,,0,0,0,,Мен сізді жоғарылатты деп естідім.
Dialogue: 0,0:18:44.62,0:18:46.62,TEXT-JP,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:18:48.19,0:18:51.44,TEXT-JP,,0,0,0,,Шынымды айтсам, басым жарылып кететін сияқты.
Dialogue: 0,0:18:52.61,0:18:58.58,TEXT-JP,,0,0,0,,Адамдар бейсаналық түрде жұбаныш іздейді, оны білмей тұрып, олар сол жерден қозғала алмайды.
Dialogue: 0,0:18:59.03,0:19:00.79,TEXT-JP,,0,0,0,,Мен жақсы үлгі аламын деп ойлаймын.
Dialogue: 0,0:19:01.51,0:19:03.08,TEXT-JP,,0,0,0,,Мұғалім басқаша.
Dialogue: 0,0:19:04.81,0:19:08.84,TEXT-JP,,0,0,0,,Айтпақшы, Шиндо-сан бұл мәселеге қаншалықты қатысы бар?
Dialogue: 0,0:19:09.93,0:19:13.15,TEXT-JP,,0,0,0,,Докторды шақырған директор болды.
Dialogue: 0,0:19:14.18,0:19:16.09,TEXT-JP,,0,0,0,,Сізді бір нәрсе мазалайды ма?
Dialogue: 0,0:19:17.02,0:19:19.76,TEXT-JP,,0,0,0,,Ол кісі менің университетте оқитын курста оқиды.
Dialogue: 0,0:19:19.76,0:19:23.64,TEXT-JP,,0,0,0,,Қоғамдық қауіпсіздік бюросында менің сыныбымды салған адам.
Dialogue: 0,0:19:25.01,0:19:27.85,TEXT-JP,,0,0,0,,Мен әрқашан өзімді пайдаланып жатқандай сезіндім.
Dialogue: 0,0:19:29.55,0:19:31.63,TEXT-JP,,0,0,0,,Мен де қолдансам ше?
Dialogue: 0,0:19:32.70,0:19:35.53,TEXT-JP,,0,0,0,,Мүмкін ол сені оттан каштан жинауға мәжбүрлейтін шығар.
Dialogue: 0,0:19:36.73,0:19:39.42,TEXT-JP,,0,0,0,,Құжаттың бар екенін растаңыз.
Dialogue: 0,0:19:40.48,0:19:44.02,TEXT-JP,,0,0,0,,Нәтиже Сыртқы істер министрлігі және Жапония үкіметі
Dialogue: 0,0:19:44.55,0:19:47.98,TEXT-JP,,0,0,0,,Бұл Сибилді айыптауға әкелуі мүмкін.
Dialogue: 0,0:19:49.76,0:19:51.03,TEXT-JP,,0,0,0,,Айыптау?
Dialogue: 0,0:19:52.72,0:19:57.48,TEXT-JP,,0,0,0,,Бұл елдің өз ішінде және шетелде не істегенін көрсету
Dialogue: 0,0:19:57.48,0:19:59.19,TEXT-JP,,0,0,0,,Қауіпті оқиға
Dialogue: 0,0:20:04.07,0:20:06.77,TEXT-JP,,0,0,0,,Сондықтан мен тек сенімен сөйлесе алдым
Dialogue: 0,0:20:15.37,0:20:18.14,TEXT-JP,,0,0,0,,Шетелдегі үйлестіру бюросымен сөйлесті
Dialogue: 0,0:20:18.82,0:20:23.57,TEXT-JP,,0,0,0,,Төменде Қоғамдық қауіпсіздік бюросы мен мінез-құлық бөлімі арасындағы бірлескен тергеу жүргізіледі.
Dialogue: 0,0:20:23.57,0:20:26.08,TEXT-JP,,0,0,0,,Командалық билік осында орналасқан.
Dialogue: 0,0:20:26.08,0:20:29.41,TEXT-JP,,0,0,0,,Ақпарат ортақ болғанша
Dialogue: 0,0:20:29.41,0:20:33.46,TEXT-JP,,0,0,0,,Шокердің нақты тұлғасы анық болуы керек.
Dialogue: 0,0:20:33.46,0:20:34.37,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:20:36.70,0:20:40.02,TEXT-JP,,0,0,0,,Сыртқы істер министрлігі Шетелдік зерттеулер департаментінің далалық зерттеу тобы
Dialogue: 0,0:20:40.02,0:20:42.25,TEXT-JP,,0,0,0,,Жалпы аты: Бейбітшілікті бұзушы
Dialogue: 0,0:20:43.32,0:20:48.98,TEXT-JP,,0,0,0,,Бұл диверсия үшін Сыртқы істер министрлігіне қатал жақтаушылар шетелде жасырған бөлімше.
Dialogue: 0,0:20:49.24,0:20:51.98,TEXT-JP,,0,0,0,,Бөлім 5 жыл бұрын таратылды
Dialogue: 0,0:20:51.98,0:20:54.98,TEXT-JP,,0,0,0,,Бірақ мүшелердің ешқайсысы үйге оралмады.
Dialogue: 0,0:20:54.98,0:20:59.74,TEXT-JP,,0,0,0,,Ол жай ғана жоғалып кетті және әлі де өз бастамасымен әрекет етуде.
Dialogue: 0,0:21:00.55,0:21:03.12,TEXT-JP,,0,0,0,,Сіздің итіңіз қолыңызды тістеп алды ма?
Dialogue: 0,0:21:03.12,0:21:07.93,TEXT-JP,,0,0,0,,Енді олар Жапонияда пайда болды, бізде оларды жоюға ең жақсы мүмкіндік бар.
Dialogue: 0,0:21:07.93,0:21:11.50,TEXT-JP,,0,0,0,,Біздің әрекет ету бөлімі осы мақсат үшін қызметкерлерді жинады.
Dialogue: 0,0:21:12.01,0:21:13.01,TEXT-JP,,0,0,0,,Персонал?
Dialogue: 0,0:21:13.65,0:21:16.59,TEXT-JP,,0,0,0,,Бірде жағасын лақтырып жіберген ит
Dialogue: 0,0:21:16.59,0:21:19.58,TEXT-JP,,0,0,0,,Қоғамдық қауіпсіздік қайтадан қолға алынбайды
Dialogue: 0,0:21:20.32,0:21:25.38,TEXT-JP,,0,0,0,,Бірақ ол азу тістерін жалаңаштап жүрген қасқырлар тобына лайықты адам шығар.
Dialogue: 0,0:21:26.50,0:21:27.64,TEXT-JP,,0,0,0,,Жақсы істе
Dialogue: 0,0:21:32.39,0:21:33.52,TEXT-JP,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:21:39.53,0:21:42.36,TEXT-JP,,0,0,0,,Мен саған енді ешқашан көрсетпе дедім.
Dialogue: 0,0:21:42.36,0:21:46.87,TEXT-JP,,0,0,0,,Джино Жекелеген жағдайда мүмкін бе?
Dialogue: 0,0:21:47.57,0:21:48.27,TEXT-JP,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:21:48.27,0:21:50.00,TEXT-JP,,0,0,0,,қазіргі уақытта қарғысқа ұшыраған эмбрионмен бірге әлі де сонда қамалып отыр –
Dialogue: 0,0:21:50.62,0:21:52.07,TEXT-JP,,0,0,0,,Бұл станцияның ішінде.
Dialogue: 0,0:22:02.17,0:22:05.50,TEXT-JP,,0,0,0,,Бұл өте шулы. Сен не істеп жатырсың?
Dialogue: 0,0:22:07.65,0:22:09.39,TEXT-JP,,0,0,0,,Шинья Когами
Dialogue: 0,0:22:11.88,0:22:13.47,TEXT-JP,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:22:14.33,0:22:15.36,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:22:16.47,0:22:18.81,TEXT-JP,,0,0,0,,Кіріспе қажет емес.
Dialogue: 0,0:22:36.33,0:22:38.13,TEXT-JP,,0,0,0,,Басты күдікті туралы қандай мәліметтер бар?
Dialogue: 0,0:22:39.18,0:22:40.98,TEXT-JP,,0,0,0,,Капитанның аты - Тонами.
Dialogue: 0,0:22:40.98,0:22:42.72,TEXT-JP,,0,0,0,,Мен сенен сұрамаймын.
Dialogue: 0,0:22:45.96,0:22:47.51,TEXT-JP,,0,0,0,,Содан кейін I
Dialogue: 0,0:22:48.46,0:22:54.19,TEXT-JP,,0,0,0,,Кокузен Тонами Ұлттық қорғаныс күштеріне 18 жасында қабілеттілік сынағынан кейін қосылды.
Dialogue: 0,0:22:54.71,0:22:57.67,TEXT-JP,,0,0,0,,Ұзақ уақыт Әскери-теңіз күштерінің арнайы күштерінің мүшесі
Dialogue: 0,0:22:57.67,0:23:00.89,TEXT-JP,,0,0,0,,Сырт көзге түспейтін байсалды адам болса керек.
Dialogue: 0,0:23:02.09,0:23:05.67,TEXT-JP,,0,0,0,,Басшының ұсынысы бойынша Бейбітшілік бұзушыға жіберілді
Dialogue: 0,0:23:05.67,0:23:07.71,TEXT-JP,,0,0,0,,Қосымша ақпарат жоқ
Dialogue: 0,0:23:09.10,0:23:11.00,TEXT-JP,,0,0,0,,Ештеңе...?
Dialogue: 0,0:23:11.64,0:23:13.07,TEXT-JP,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:23:14.54,0:23:18.20,TEXT-JP,,0,0,0,,Бізде оның не істегені туралы жазба ғана бар.
Dialogue: 0,0:23:29.46,0:23:30.74,TEXT-JP,,0,0,0,,Сен жындысың
Dialogue: 0,0:23:31.67,0:23:35.27,TEXT-JP,,0,0,0,,Бұл жігіттің профилін маған қалдырыңыз.
Dialogue: 0,0:23:35.27,0:23:37.09,TEXT-JP,,0,0,0,,Дәрігердің кек алуы
Dialogue: 0,0:23:55.48,0:23:59.83,TEXT-JP,,0,0,0,,Бұл Дежима, Сыртқы істер министрлігінің арнайы юрисдикциясы аймағы
Dialogue: 0,0:24:01.67,0:24:04.84,TEXT-JP,,0,0,0,,Көбісі иммиграциялық тексеруден бұрын шетелдіктерге арналған тұрғын аудандар
Dialogue: 0,0:24:05.39,0:24:07.99,TEXT-JP,,0,0,0,,Қоғамдық қауіпсіздік бюросымен үйлесімділік ең нашар
Dialogue: 0,0:24:18.34,0:24:22.37,TEXT-JP,,0,0,0,,Қоғамдық қауіпсіздік бюросының өкілеттіктері болу кезінде шектеледі.
Dialogue: 0,0:24:22.37,0:24:25.78,TEXT-JP,,0,0,0,,Мен Dominator қолданбасын пайдалануға рұқсат сұрадым.
Dialogue: 0,0:24:26.76,0:24:27.61,TEXT-JP,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:24:53.50,0:24:55.01,TEXT-JP,,0,0,0,,Мұғалімнің қорытындылары қандай?
Dialogue: 0,0:24:56.95,0:25:00.52,TEXT-JP,,0,0,0,,Ол жоғалғанға дейін де, кейін де басқа адам сияқты.
Dialogue: 0,0:25:02.75,0:25:05.33,TEXT-JP,,0,0,0,,Сіз бұл жігітті кездестірдіңіз бе?
Dialogue: 0,0:25:06.21,0:25:07.16,TEXT-JP,,0,0,0,,Жоқ
Dialogue: 0,0:25:09.06,0:25:11.60,TEXT-JP,,0,0,0,,Мазасыздық бар ма?
Dialogue: 0,0:25:11.60,0:25:15.88,TEXT-JP,,0,0,0,,Топтық сипаттамаларға байланысты тұлғаның ойлары мен астарлары
Dialogue: 0,0:25:19.26,0:25:21.95,TEXT-JP,,0,0,0,,Бұл тұспал ма, білмеймін, бірақ
Dialogue: 0,0:25:21.95,0:25:24.51,TEXT-JP,,0,0,0,,Мен ұрыс кезінде дауысты естідім
Dialogue: 0,0:25:25.08,0:25:27.80,TEXT-JP,,0,0,0,,Бұл Жаңа өсиеттен үзінді.
Dialogue: 0,0:25:28.55,0:25:29.50,TEXT-JP,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:25:31.64,0:25:35.91,TEXT-JP,,0,0,0,,«Сіз туралы бұрын алдын ала айтылғандарға сәйкес».
Dialogue: 0,0:25:35.91,0:25:37.91,TEXT-JP,,0,0,0,,«Мен осы бұйрықты беремін»
Dialogue: 0,0:25:38.63,0:25:43.38,TEXT-JP,,0,0,0,,«Осы пайғамбарлық арқылы күш-қуат бер және батыл күрес».
Dialogue: 0,0:25:45.63,0:25:47.76,TEXT-JP,,0,0,0,,Бұл Тімотеге хат.
Dialogue: 0,0:25:49.44,0:25:50.21,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:25:51.11,0:25:52.98,TEXT-JP,,0,0,0,,1-тарау 18-бөлім
Dialogue: 0,0:25:53.61,0:25:55.02,TEXT-JP,,0,0,0,,Бұл пайдалы ма?
Dialogue: 0,0:25:56.01,0:25:57.12,TEXT-JP,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:25:57.85,0:26:00.37,TEXT-JP,,0,0,0,,Тонами христиан емес.
Dialogue: 0,0:26:00.37,0:26:01.78,TEXT-JP,,0,0,0,,Жазба жоқ
Dialogue: 0,0:26:09.80,0:26:13.22,TEXT-JP,,0,0,0,,Сен Павел деген әулиені білесің бе?
Dialogue: 0,0:26:13.88,0:26:17.03,TEXT-JP,,0,0,0,,Алдымен олар Исаға шабуыл жасады, бірақ
Dialogue: 0,0:26:17.03,0:26:21.00,TEXT-JP,,0,0,0,,Оның ғажайыптарын көргеннен кейін дінге кірген адам.
Dialogue: 0,0:26:25.64,0:26:29.98,TEXT-JP,,0,0,0,,Мүмкін Тонами Павелмен сәйкестендіруі мүмкін.
Dialogue: 0,0:26:31.26,0:26:35.11,TEXT-JP,,0,0,0,,Тұйықталуға бейім мұғалім Джон сияқты.
Dialogue: 0,0:26:36.84,0:26:39.65,TEXT-JP,,0,0,0,,Апокалипсис Патмоста жазыла ма?
Dialogue: 0,0:26:43.09,0:26:48.48,TEXT-JP,,0,0,0,,Шынымен, мұғалім қоғамдық қауіпсіздік бюросымен ынтымақтасады ма?
Dialogue: 0,0:26:49.96,0:26:55.39,TEXT-JP,,0,0,0,,Мен Акане Цунаморимен жұмыс істеймін.
Dialogue: 0,0:27:04.64,0:27:05.77,TEXT-JP,,0,0,0,,Когами
Dialogue: 0,0:27:06.43,0:27:08.98,TEXT-JP,,0,0,0,,Денеңізді дұрыс қозғалтпаңыз
Dialogue: 0,0:27:08.98,0:27:10.70,TEXT-JP,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:27:12.00,0:27:15.32,TEXT-JP,,0,0,0,,Тонами де әуел бастан кісі өлтіруші емес еді.
Dialogue: 0,0:27:16.14,0:27:19.41,TEXT-JP,,0,0,0,,Бұл зорлық-зомбылықтың қайғылы соңы.
Dialogue: 0,0:27:20.56,0:27:22.15,TEXT-JP,,0,0,0,,Менде де солай болса ше?
Dialogue: 0,0:27:22.15,0:27:23.74,TEXT-JP,,0,0,0,,Бұл сізге байланысты
Dialogue: 0,0:27:24.75,0:27:28.04,TEXT-JP,,0,0,0,,Негізі мен дұрыс емес үй таңдама деп жатырмын.
Dialogue: 0,0:27:30.08,0:27:32.89,TEXT-JP,,0,0,0,,Ол Бодхисаттва да, Будда да емес.
Dialogue: 0,0:27:33.91,0:27:37.41,TEXT-JP,,0,0,0,,Өзіңіз қалағандай істесеңіз, өлім жазасына кесіледі.
Dialogue: 0,0:27:38.15,0:27:40.52,TEXT-JP,,0,0,0,,Мен өзім қалаған нәрсені істеп жатырмын деп ойладым...
Dialogue: 0,0:27:42.03,0:27:45.06,TEXT-JP,,0,0,0,,Мен өз әрекеттеріме жауаптымын
Dialogue: 0,0:27:45.06,0:27:47.74,TEXT-JP,,0,0,0,,Айналаңыздағыларға бұл жеткіліксіз.
Dialogue: 0,0:27:47.74,0:27:50.21,TEXT-JP,,0,0,0,,Қоштасу ғана қалды.
Dialogue: 0,0:27:50.21,0:27:52.21,TEXT-JP,,0,0,0,,Қарт кісінің кеңесі
Dialogue: 0,0:28:00.40,0:28:01.49,TEXT-JP,,0,0,0,,Когами мырза
Dialogue: 0,0:28:03.22,0:28:03.97,TEXT-JP,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:28:09.64,0:28:11.67,TEXT-JP,,0,0,0,,Мінез-құлық бөлімі дегеніміз не?
Dialogue: 0,0:28:12.17,0:28:15.19,TEXT-JP,,0,0,0,,Сыртқы істер министрлігінің ғылыми-зерттеу бөлімі және белсенді күш...
Dialogue: 0,0:28:15.19,0:28:17.01,TEXT-JP,,0,0,0,,Мен айтпай-ақ білемін.
Dialogue: 0,0:28:18.26,0:28:19.08,TEXT-JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:22.37,0:28:28.77,TEXT-JP,,0,0,0,,Когами мырзаға зорлық-зомбылыққа жауап ретінде зорлық-зомбылық түрі ретінде Жапонияға оралуға рұқсат етілді ме?
Dialogue: 0,0:28:29.36,0:28:32.52,TEXT-JP,,0,0,0,,Сыртқы істер министрлігі де сот орындаушысын іздеді.
Dialogue: 0,0:28:32.52,0:28:34.40,TEXT-JP,,0,0,0,,Осылайша мені шақырды.
Dialogue: 0,0:28:36.85,0:28:39.03,TEXT-JP,,0,0,0,,Мен қоңырау шалған кезде үйде болдыңыз ба?
Dialogue: 0,0:28:39.41,0:28:42.18,TEXT-JP,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:28:44.24,0:28:47.71,TEXT-JP,,0,0,0,,Жарайды, мен оны лауазымыммен, беделіммен жасай алмаймын.
Dialogue: 0,0:28:48.72,0:28:54.92,TEXT-JP,,0,0,0,,Директор Ябуки, Когами-сан жасаған қылмыс туралы не ойлайсыз?
Dialogue: 0,0:28:55.39,0:28:57.35,TEXT-JP,,0,0,0,,Мен бұл туралы ешқашан айтқан емеспін.
Dialogue: 0,0:28:57.91,0:28:59.32,TEXT-JP,,0,0,0,,Менің ойымша, сізге бәрібір.
Dialogue: 0,0:29:00.56,0:29:03.43,TEXT-JP,,0,0,0,,Бұл адамды Бейбітшілік бұзушыдан басқа ештеңе қызықтырмайды.
Dialogue: 0,0:29:04.11,0:29:06.73,TEXT-JP,,0,0,0,,Сіз Сыртқы істер министрлігінде жұмысыңызды жалғастырасыз ба?
Dialogue: 0,0:29:07.49,0:29:10.41,TEXT-JP,,0,0,0,,Мен тек өзіме қажет нәрсені істеймін
Dialogue: 0,0:29:11.78,0:29:17.07,TEXT-JP,,0,0,0,,Когами мырза заң бұзғысы келсе, келесі жолы міндетті түрде тоқтатамын.
Dialogue: 0,0:29:20.02,0:29:22.20,TEXT-JP,,0,0,0,,Өзіңіз дұрыс деп санайтын нәрсені жасаңыз
Dialogue: 0,0:29:24.28,0:29:26.81,TEXT-JP,,0,0,0,,Мен істеген ісіме өкінбеймін.
Dialogue: 0,0:29:41.90,0:29:44.60,TEXT-JP,,0,0,0,,Мен жай ғана кешірім сұрағаныңды қаладым.
Dialogue: 0,0:29:51.12,0:29:53.22,TEXT-JP,,0,0,0,,Когамиге айтпа
Dialogue: 0,0:29:53.22,0:29:55.57,TEXT-JP,,0,0,0,,Ақбөкен біліп қалса, қиын болады.
Dialogue: 0,0:29:56.65,0:29:59.48,TEXT-JP,,0,0,0,,Мұғалім түсінеді деп ойлаймын.
Dialogue: 0,0:30:00.01,0:30:02.05,TEXT-JP,,0,0,0,,Тәуекелдерді азайту
Dialogue: 0,0:30:03.51,0:30:04.80,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,0:30:07.84,0:30:09.33,TEXT-JP,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:30:09.33,0:30:12.25,TEXT-JP,,0,0,0,,Тек аңғал идеалдармен ештеңе өзгермейді.
Dialogue: 0,0:30:13.24,0:30:16.94,TEXT-JP,,0,0,0,,Қажетті нәрсе - стигмаға қарамастан әділдікке жету үшін күш.
Dialogue: 0,0:30:32.60,0:30:35.42,TEXT-JP,,0,0,0,,Сен неге олайсың?
Dialogue: 0,0:30:35.42,0:30:36.98,TEXT-JP,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:30:50.26,0:30:52.41,TEXT-JP,,0,0,0,,Тақырып келді
Dialogue: 0,0:30:52.41,0:30:54.92,TEXT-JP,,0,0,0,,Жарайсыңдар, бәрің ұрысқа дайындалыңдар.
Dialogue: 0,0:31:00.28,0:31:02.81,TEXT-JP,,0,0,0,,Біз осында күтеміз.
Dialogue: 0,0:31:03.53,0:31:04.43,TEXT-JP,,0,0,0,,Өтінемін
Dialogue: 0,0:31:11.07,0:31:13.94,TEXT-JP,,0,0,0,,Бұл ғимарат өте бос.
Dialogue: 0,0:31:13.94,0:31:16.81,TEXT-JP,,0,0,0,,Менің ойымша, бұл жақындап келе жатқан Ай жаңа жылы болғандықтан шығар.
Dialogue: 0,0:31:18.74,0:31:20.24,TEXT-JP,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:31:21.48,0:31:23.50,TEXT-JP,,0,0,0,,Бейбіт тұрғындар эвакуацияланды.
Dialogue: 0,0:31:26.43,0:31:27.45,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:31:27.45,0:31:31.74,TEXT-JP,,0,0,0,,Мінез-құлық бөлімінің қызметкерлері дос/дұшпанды анықтау сигналына қосылды.
Dialogue: 0,0:31:31.74,0:31:33.17,TEXT-JP,,0,0,0,,Біртүрлі.
Dialogue: 0,0:31:34.89,0:31:37.13,TEXT-JP,,0,0,0,,Бізді қартқа айналдырдың.
Dialogue: 0,0:31:37.88,0:31:39.26,TEXT-JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:31:39.77,0:31:42.46,TEXT-JP,,0,0,0,,Мұғалімнің қауіпсіздігіне кепілдік беріледі
Dialogue: 0,0:31:45.56,0:31:48.02,TEXT-JP,,0,0,0,,Мен осылай болады деп ойладым.
Dialogue: 0,0:31:48.58,0:31:50.96,TEXT-JP,,0,0,0,,Біз қалай ештеңе айта алмаймыз?
Dialogue: 0,0:31:51.40,0:31:53.39,TEXT-JP,,0,0,0,,Жарайды, олай ашуланба.
Dialogue: 0,0:31:53.39,0:31:55.73,TEXT-JP,,0,0,0,,Құжаттар бәрібір бірінші орында
Dialogue: 0,0:32:00.69,0:32:03.96,TEXT-JP,,0,0,0,,Директор Ябуки нұсқау берсе, мұғалім де алданып қала ма?
Dialogue: 0,0:32:13.78,0:32:14.79,TEXT-JP,,0,0,0,,Құдай-ай. Дұшпанның қабілетін түсіне бастадым.
Dialogue: 0,0:32:16.79,0:32:18.88,TEXT-JP,,0,0,0,,Бұл ескерту.
Dialogue: 0,0:32:18.88,0:32:20.68,TEXT-JP,,0,0,0,,Құжат мұнда жоқ
Dialogue: 0,0:32:21.43,0:32:22.75,TEXT-JP,,0,0,0,,Неге...
Dialogue: 0,0:32:22.75,0:32:26.01,TEXT-JP,,0,0,0,,Ол да сақ.
Dialogue: 0,0:32:26.01,0:32:28.51,TEXT-JP,,0,0,0,,Мен әу бастан қарт адам едім.
Dialogue: 0,0:32:38.55,0:32:44.60,TEXT-JP,,0,0,0,,Сторонская құжаты жоқ десем де, сенбейсіңдер.
Dialogue: 0,0:32:53.47,0:32:55.58,TEXT-JP,,0,0,0,,Біз сізді эвакуациялау жолына бағыттаймыз.
Dialogue: 0,0:33:02.62,0:33:03.46,TEXT-JP,,0,0,0,,Цунемори
Dialogue: 0,0:33:04.08,0:33:06.52,TEXT-JP,,0,0,0,,Мен және Суго жаумен күресеміз.
Dialogue: 0,0:33:06.52,0:33:08.43,TEXT-JP,,0,0,0,,Бұл сізге біраз уақыт сатып алуы керек.
Dialogue: 0,0:33:08.85,0:33:10.34,TEXT-JP,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:33:10.70,0:33:12.15,TEXT-JP,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:33:23.61,0:33:26.00,TEXT-JP,,0,0,0,,Капитан тазалап жатыр
Dialogue: 0,0:33:26.00,0:33:28.24,TEXT-JP,,0,0,0,,Біз нысананы қамтамасыз етеміз
Dialogue: 0,0:33:28.68,0:33:29.74,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,0:33:36.76,0:33:37.94,TEXT-JP,,0,0,0,,Тоқта
Dialogue: 0,0:33:49.18,0:33:51.63,TEXT-JP,,0,0,0,,«50-ден төмен қылмыс коэффициенті»
Dialogue: 0,0:33:51.63,0:33:54.39,TEXT-JP,,0,0,0,,«Орындауға жатпайды»
Dialogue: 0,0:33:54.39,0:33:56.63,TEXT-JP,,0,0,0,,«Триггерді құлыптау»
Dialogue: 0,0:34:36.43,0:34:38.10,TEXT-JP,,0,0,0,,Бұл өзара шабуыл сияқты.
Dialogue: 0,0:34:39.12,0:34:40.98,TEXT-JP,,0,0,0,,Бастықпен байланысу мүмкін емес
Dialogue: 0,0:34:44.54,0:34:45.70,TEXT-JP,,0,0,0,,Дионы жеңуге арналған бұл сапар—
Dialogue: 0,0:34:57.29,0:35:00.22,TEXT-JP,,0,0,0,,Бұл жерде қауіпті. Мен қайтамын.
Dialogue: 0,0:35:00.79,0:35:01.58,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:35:04.19,0:35:05.39,TEXT-JP,,0,0,0,,Инспектор
Dialogue: 0,0:35:05.39,0:35:09.00,TEXT-JP,,0,0,0,,Доминаторды пайдалану мүмкін емес, жау қатты қаруланған және шабуылдауда
Dialogue: 0,0:35:48.41,0:35:50.12,TEXT-JP,,0,0,0,,Суго мықты бол
Dialogue: 0,0:35:51.07,0:35:53.90,TEXT-JP,,0,0,0,,Ештеңе емес, сызат қана.
Dialogue: 0,0:35:59.94,0:36:02.80,TEXT-JP,,0,0,0,,Жағдай әзірге өмірге қауіп төндірмейді.
Dialogue: 0,0:36:02.80,0:36:04.31,TEXT-JP,,0,0,0,,Мен де жақында барамын.
Dialogue: 0,0:36:04.73,0:36:07.15,TEXT-JP,,0,0,0,,Суго мырзаның қауіпсіздігін қамтамасыз етіңіз.
Dialogue: 0,0:36:17.49,0:36:18.53,TEXT-JP,,0,0,0,,Мұғалім
Dialogue: 0,0:36:40.18,0:36:41.41,TEXT-JP,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:36:45.10,0:36:47.01,TEXT-JP,,0,0,0,,Құжат қайда?
Dialogue: 0,0:36:47.01,0:36:48.55,TEXT-JP,,0,0,0,,Оны қолданба — нағыз атыңды айт.
Dialogue: 0,0:36:49.08,0:36:50.05,TEXT-JP,,0,0,0,,Тоқта
Dialogue: 0,0:36:56.52,0:36:57.61,TEXT-JP,,0,0,0,,Құжатты тапсыру
Dialogue: 0,0:36:58.24,0:36:59.69,TEXT-JP,,0,0,0,,Мына жігітті өлтіріңіз...
Dialogue: 0,0:37:05.88,0:37:08.00,TEXT-JP,,0,0,0,,Бұл абайсызда болды
Dialogue: 0,0:37:08.00,0:37:10.12,TEXT-JP,,0,0,0,,Бұл ең жақсы шешім.
Dialogue: 0,0:37:13.38,0:37:14.75,TEXT-JP,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:37:15.37,0:37:17.76,TEXT-JP,,0,0,0,,Сіздің рөліңіз аяқталмады.
Dialogue: 0,0:37:38.92,0:37:40.06,TEXT-JP,,0,0,0,,Мұғалім
Dialogue: 0,0:37:49.00,0:37:50.62,TEXT-JP,,0,0,0,,Цунемори Акане
Dialogue: 0,0:37:51.12,0:37:54.66,TEXT-JP,,0,0,0,,Әділдік те, шындық та сан қырлы.
Dialogue: 0,0:37:54.66,0:37:59.30,TEXT-JP,,0,0,0,,Кейде жоғарыдан қарамасаң түсіне алмай қаласың.
Dialogue: 0,0:37:59.97,0:38:01.95,TEXT-JP,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:38:31.27,0:38:32.82,TEXT-JP,,0,0,0,,Мұнда ешқандай құжат жоқ
Dialogue: 0,0:38:33.83,0:38:35.13,TEXT-JP,,0,0,0,,Сіз ренжіп қалдыңыз.
Dialogue: 0,0:38:35.13,0:38:38.38,TEXT-JP,,0,0,0,,В нысанасы қалпына келтірілді. Шегіну.
Dialogue: 0,0:38:39.33,0:38:40.63,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,0:38:51.89,0:38:52.82,TEXT-JP,,0,0,0,,Барыңыз
Dialogue: 0,0:39:16.99,0:39:18.40,TEXT-JP,,0,0,0,,Егер қарсы болмасаңыз, жол көрсетейін
Dialogue: 0,0:39:31.62,0:39:33.27,TEXT-JP,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:40:33.13,0:40:34.41,TEXT-JP,,0,0,0,,өлтіру
Dialogue: 0,0:41:55.25,0:42:00.08,TEXT-JP,,0,0,0,,Осы сәтте жүз жыл өтсе де
Dialogue: 0,0:42:00.08,0:42:01.88,TEXT-JP,,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:42:02.79,0:42:04.40,TEXT-JP,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:42:04.91,0:42:07.27,TEXT-JP,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:42:38.13,0:42:39.78,TEXT-JP,,0,0,0,,Өте қиын
Dialogue: 0,0:42:40.44,0:42:42.54,TEXT-JP,,0,0,0,,Бірақ уақыт бітті.
Dialogue: 0,0:42:43.37,0:42:44.28,TEXT-JP,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:42:54.19,0:42:56.64,TEXT-JP,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:43:18.39,0:43:20.02,TEXT-JP,,0,0,0,,Ақбөкен мырза
Dialogue: 0,0:43:33.89,0:43:36.79,TEXT-JP,,0,0,0,,Директор Ябуки еш жерде көрінбейді.
Dialogue: 0,0:43:49.51,0:43:52.18,TEXT-JP,,0,0,0,,Олар ақпараттың ағып кетуін күтумен әрекет етті.
Dialogue: 0,0:43:52.69,0:43:54.54,TEXT-JP,,0,0,0,,Бұл нәтиже ме?
Dialogue: 0,0:43:56.81,0:43:58.60,TEXT-JP,,0,0,0,,Мен сылтау айтпаймын
Dialogue: 0,0:43:58.99,0:44:02.76,TEXT-JP,,0,0,0,,Фредериканы кінәлау ештеңені шешпейді.
Dialogue: 0,0:44:03.25,0:44:05.75,TEXT-JP,,0,0,0,,Сұрақ неліктен сәтсіз болды?
Dialogue: 0,0:44:15.98,0:44:18.64,TEXT-JP,,0,0,0,,Штаб-пәтер Синдо...неге мұндасың?
Dialogue: 0,0:44:19.01,0:44:23.64,TEXT-JP,,0,0,0,,Қызметіме байланысты мен Сыртқы істер министрлігімен жағдайды реттеуге тырысуым керек.
Dialogue: 0,0:44:23.64,0:44:28.87,TEXT-JP,,0,0,0,,Ең нашар жағдайда біз Ұлттық қорғаныс күштерінен ынтымақтастық сұрауды шештік.
Dialogue: 0,0:44:30.20,0:44:32.67,TEXT-JP,,0,0,0,,Қорғаныс министрлігінен Сыртқы істер министрлігіне
Dialogue: 0,0:44:32.67,0:44:34.90,TEXT-JP,,0,0,0,,Сіз бәрін басқаратын сияқтысыз.
Dialogue: 0,0:44:35.93,0:44:38.55,TEXT-JP,,0,0,0,,Бұл соншалықты үлкен емес.
Dialogue: 0,0:44:38.55,0:44:44.91,TEXT-JP,,0,0,0,,Дегенмен Ябуки екеуміз сол бөлімшеге басынан бері араластық.
Dialogue: 0,0:44:52.53,0:44:55.51,TEXT-JP,,0,0,0,,Аңдар табыны жабайы болды.
Dialogue: 0,0:44:56.69,0:44:59.66,TEXT-JP,,0,0,0,,Бұл жауапкершілікті алу керек.
Dialogue: 0,0:45:00.63,0:45:04.18,TEXT-JP,,0,0,0,,Сіз ақбөкен мырзаны осы мақсатта пайдаландыңыз ба?
Dialogue: 0,0:45:05.90,0:45:07.23,TEXT-JP,,0,0,0,,Салдары
Dialogue: 0,0:45:07.76,0:45:10.06,TEXT-JP,,0,0,0,,Ешкім құрбандықты қаламайды
Dialogue: 0,0:45:31.49,0:45:34.15,TEXT-JP,,0,0,0,,Ашу дұрыс шешім қабылдауды бұзады
Dialogue: 0,0:45:35.60,0:45:38.17,TEXT-JP,,0,0,0,,Үнемі сабырлы болудың қажеті жоқ, бірақ
Dialogue: 0,0:45:38.87,0:45:40.09,TEXT-JP,,0,0,0,,Қазір емес
Dialogue: 0,0:45:40.44,0:45:44.64,TEXT-JP,,0,0,0,,Оқиғаға мұғалімді әкелдім.
Dialogue: 0,0:45:45.14,0:45:47.33,TEXT-JP,,0,0,0,,Бұл да адамның қалаған нәрсесі.
Dialogue: 0,0:45:48.11,0:45:51.67,TEXT-JP,,0,0,0,,Қазір өз міндеттеріңізді орындаңыз.
Dialogue: 0,0:45:56.82,0:46:01.03,TEXT-JP,,0,0,0,,Бұл реттеліп болғаннан кейін, сіз қалағаныңызша жылай аласыз.
Dialogue: 0,0:46:07.62,0:46:08.44,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:46:15.55,0:46:16.84,TEXT-JP,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:46:17.61,0:46:21.63,TEXT-JP,,0,0,0,,Мұнда жаудың байланыс желісінің және кептелістің шынайы табиғаты ашылады.
Dialogue: 0,0:46:22.16,0:46:25.33,TEXT-JP,,0,0,0,,Бар байланыс жүйесін пайдалансаңыз
Dialogue: 0,0:46:25.33,0:46:28.02,TEXT-JP,,0,0,0,,Сіз оны әлдеқашан анықтауыңыз керек еді.
Dialogue: 0,0:46:28.47,0:46:30.30,TEXT-JP,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,0:46:30.30,0:46:32.38,TEXT-JP,,0,0,0,,Фонды тексеруді сұрау
Dialogue: 0,0:46:32.38,0:46:33.90,TEXT-JP,,0,0,0,,Кімдікі?
Dialogue: 0,0:46:33.90,0:46:35.75,TEXT-JP,,0,0,0,,Синдо бас кеңсесі
Dialogue: 0,0:46:35.75,0:46:37.15,TEXT-JP,,0,0,0,,Оны тексер
Dialogue: 0,0:46:49.42,0:46:50.41,TEXT-JP,,0,0,0,,Өкінішті
Dialogue: 0,0:46:51.63,0:46:55.04,TEXT-JP,,0,0,0,,Дәрігер тек бақыт тіледі.
Dialogue: 0,0:46:55.78,0:46:58.45,TEXT-JP,,0,0,0,,Анам дайындалды.
Dialogue: 0,0:46:59.86,0:47:02.94,TEXT-JP,,0,0,0,,Осы көздер болмаса, мен...
Dialogue: 0,0:47:09.43,0:47:12.98,TEXT-JP,,0,0,0,,Мен Майконы міндетті түрде қуантамын.
Dialogue: 0,0:47:12.98,0:47:15.44,TEXT-JP,,0,0,0,,Милиция мырзаның тілегіне жауап беру
Dialogue: 0,0:47:16.61,0:47:17.73,TEXT-JP,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:47:18.39,0:47:21.53,TEXT-JP,,0,0,0,,Күл келгенде бәріміз бірге жоқтайық.
Dialogue: 0,0:47:28.99,0:47:30.08,TEXT-JP,,0,0,0,,Және…
Dialogue: 0,0:47:30.86,0:47:32.58,TEXT-JP,,0,0,0,,Бұл сіз туралы, мырза.
Dialogue: 0,0:47:34.16,0:47:36.06,TEXT-JP,,0,0,0,,Сіз ағаңызбен хабарластыңыз ба?
Dialogue: 0,0:47:36.06,0:47:39.27,TEXT-JP,,0,0,0,,А, мен оны рәсімге уақытында жеткізіп аламын.
Dialogue: 0,0:47:44.94,0:47:46.85,TEXT-JP,,0,0,0,,Сізге жақсы Кей
Dialogue: 0,0:47:59.86,0:48:02.86,TEXT-JP,,0,0,0,,Салтанатта әкем де болады, солай ма?
Dialogue: 0,0:48:02.86,0:48:07.24,TEXT-JP,,0,0,0,,Аа, мен сізді шатастырып жібересіз бе деп қорқамын.
Dialogue: 0,0:48:08.43,0:48:10.24,TEXT-JP,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:48:21.60,0:48:23.68,TEXT-JP,,0,0,0,,Абайлаңыз
Dialogue: 0,0:48:23.68,0:48:25.68,TEXT-JP,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:48:31.11,0:48:32.82,TEXT-JP,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,0:48:34.09,0:48:37.16,TEXT-JP,,0,0,0,,Мен екі адамды сұрадым.
Dialogue: 0,0:48:38.18,0:48:40.27,TEXT-JP,,0,0,0,,Сен айтпасаң да білемін.
Dialogue: 0,0:48:56.59,0:49:00.51,TEXT-JP,,0,0,0,,Бауырлар, өлімнен қорықпаңдар.
Dialogue: 0,0:49:00.51,0:49:05.09,TEXT-JP,,0,0,0,,Біз Жаратқан Иенің қылышы мен қалқанымыз.
Dialogue: 0,0:49:05.09,0:49:10.02,TEXT-JP,,0,0,0,,Медиатор ретіндегі миссияңызды орындау үшін бар күшіңізді салыңыз.
Dialogue: 0,0:49:11.22,0:49:15.01,TEXT-JP,,0,0,0,,Біздің Раббымыз генерал келе жатыр.
Dialogue: 0,0:49:17.74,0:49:21.02,TEXT-JP,,0,0,0,,Әркім, сөздерді жан дүниеңе ойып ал
Dialogue: 0,0:49:28.84,0:49:31.74,TEXT-JP,,0,0,0,,«Менің сарбаздарымды мадақтаңдар».
Dialogue: 0,0:49:31.74,0:49:35.47,TEXT-JP,,0,0,0,,«Қорқыныштарыңды тастап, барыңды бер».
Dialogue: 0,0:49:35.47,0:49:40.75,TEXT-JP,,0,0,0,,«Жақында Уәде етілген жер бәріңді қарсы алады».
Dialogue: 0,0:49:40.75,0:49:44.07,TEXT-JP,,0,0,0,,«Әлемге әділдік пен тәртіп орнату»
Dialogue: 0,0:49:44.07,0:49:47.76,TEXT-JP,,0,0,0,,«Мен әрқашан сенімен біргемін».
Dialogue: 0,0:49:50.03,0:49:54.64,TEXT-JP,,0,0,0,,Мен өзімді көп пайғамбарлыққа құрбан етемін.
Dialogue: 0,0:50:10.24,0:50:13.00,TEXT-JP,,0,0,0,,Сен біздің ортамызға егеуқұйрықты жібердің.
Dialogue: 0,0:50:13.81,0:50:15.97,TEXT-JP,,0,0,0,,Әйтпесе, буксирлеу мүмкін емес.
Dialogue: 0,0:50:16.82,0:50:20.45,TEXT-JP,,0,0,0,,Құжаттың қайда екенін таңдаңыз, менімен сөйлесіңіз немесе өліңіз.
Dialogue: 0,0:50:21.41,0:50:22.64,TEXT-JP,,0,0,0,,Ақылсыз ит
Dialogue: 0,0:50:23.27,0:50:25.67,TEXT-JP,,0,0,0,,Сіз үшін бәрі аяқталды.
Dialogue: 0,0:50:26.74,0:50:30.19,TEXT-JP,,0,0,0,,Мені өзгерткеніңді ұмытпа
Dialogue: 0,0:50:31.14,0:50:32.93,TEXT-JP,,0,0,0,,Кай, қазір қайт.
Dialogue: 0,0:50:32.93,0:50:33.90,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:51:29.71,0:51:32.49,TEXT-JP,,0,0,0,,Кай жауап алуды саған қалдырдым.
Dialogue: 0,0:51:33.55,0:51:35.01,TEXT-JP,,0,0,0,,Мен солтүстікке барамын
Dialogue: 0,0:51:36.02,0:51:38.68,TEXT-JP,,0,0,0,,Уәде етілген жерде генерал?
Dialogue: 0,0:51:38.68,0:51:41.75,TEXT-JP,,0,0,0,,Аа, сіз жаңа ғана көшіп кеттіңіз.
Dialogue: 0,0:51:44.81,0:51:49.19,TEXT-JP,,0,0,0,,Осы сәтте жүз жыл өтсе де
Dialogue: 0,0:51:52.14,0:51:55.14,TEXT-JP,,0,0,0,,Тацудзи Миёши…“Оасо”
Dialogue: 0,0:52:02.37,0:52:04.39,TEXT-JP,,0,0,0,,Пышақты талдау нәтижелері?
Dialogue: 0,0:52:05.29,0:52:07.84,TEXT-JP,,0,0,0,,Әй, мен қалпына келтірдім.
Dialogue: 0,0:52:09.35,0:52:11.52,TEXT-JP,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:52:12.90,0:52:16.28,TEXT-JP,,0,0,0,,Пышақтағы жалғыз қан - Шиньяныкі.
Dialogue: 0,0:52:16.28,0:52:18.64,TEXT-JP,,0,0,0,,Тұтқаға жылқының жүні байланған.
Dialogue: 0,0:52:19.79,0:52:24.29,TEXT-JP,,0,0,0,,Жылқының қайдан шыққанын табыңыз. Бұл Кюсюдағы Асо.
Dialogue: 0,0:52:24.88,0:52:26.99,TEXT-JP,,0,0,0,,Ауданды шектеу дұрыс па?
Dialogue: 0,0:52:26.99,0:52:28.26,TEXT-JP,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:52:39.30,0:52:41.93,TEXT-JP,,0,0,0,,Профессор үшін кешірім сұраймын.
Dialogue: 0,0:52:44.54,0:52:45.33,TEXT-JP,,0,0,0,,О
Dialogue: 0,0:52:49.81,0:52:54.01,TEXT-JP,,0,0,0,,Сугокун жіберген мәйітті талдау нәтижелері шықты.
Dialogue: 0,0:52:54.71,0:52:58.46,TEXT-JP,,0,0,0,,Оққа ұшса да қозғала берген адам
Dialogue: 0,0:52:58.46,0:53:01.65,TEXT-JP,,0,0,0,,Оның миына арнайы чип орнатылған.
Dialogue: 0,0:53:02.95,0:53:06.82,TEXT-JP,,0,0,0,,Дене қатты зақымдалған, маған көбірек білу үшін көбірек уақыт керек.
Dialogue: 0,0:53:08.68,0:53:11.60,TEXT-JP,,0,0,0,,Ей, иелік ету туралы не ойлайсың?
Dialogue: 0,0:53:12.18,0:53:13.66,TEXT-JP,,0,0,0,,Не? Кенеттен
Dialogue: 0,0:53:14.92,0:53:17.65,TEXT-JP,,0,0,0,,Адамдарда басқа нәрсе бар
Dialogue: 0,0:53:18.25,0:53:22.25,TEXT-JP,,0,0,0,,Мұндай құбылысқа ғылыми түсініктеме беруге бола ма?
Dialogue: 0,0:53:23.19,0:53:25.36,TEXT-JP,,0,0,0,,Тағы бірдеңе...
Dialogue: 0,0:53:25.36,0:53:27.67,TEXT-JP,,0,0,0,,Періште немесе шайтан?
Dialogue: 0,0:53:27.67,0:53:28.98,TEXT-JP,,0,0,0,,Құдай т.б.
Dialogue: 0,0:53:29.51,0:53:31.37,TEXT-JP,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,0:53:31.37,0:53:33.82,TEXT-JP,,0,0,0,,Адамдар мен басқа жануарлар арасындағы
Dialogue: 0,0:53:33.82,0:53:37.01,TEXT-JP,,0,0,0,,Психикалық құрылымда шешуші айырмашылық бар
Dialogue: 0,0:53:37.01,0:53:38.19,TEXT-JP,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:53:38.95,0:53:40.95,TEXT-JP,,0,0,0,,Менің ойымша, бірнеше бар
Dialogue: 0,0:53:41.93,0:53:44.03,TEXT-JP,,0,0,0,,Эмпатия және әзіл туралы түсінік
Dialogue: 0,0:53:44.90,0:53:47.90,TEXT-JP,,0,0,0,,Оқиға ағымына негізделген объективті ме?
Dialogue: 0,0:53:47.90,0:53:51.12,TEXT-JP,,0,0,0,,Иә, адамдар
Dialogue: 0,0:53:51.12,0:53:54.62,TEXT-JP,,0,0,0,,«Құдайдың көзқарасы» деп аталатын нәрседен көруге болады
Dialogue: 0,0:53:54.62,0:53:59.79,TEXT-JP,,0,0,0,,Бір невролог мұны «Жүректе өмір сүретін Құдай» деп білдірді.
Dialogue: 0,0:54:00.65,0:54:05.05,TEXT-JP,,0,0,0,,Адам санасын хайуандық және құдайлық бөліктерге бөлу
Dialogue: 0,0:54:05.05,0:54:07.66,TEXT-JP,,0,0,0,,Джулиан Джейнстің бицентрлік гипотезасы
Dialogue: 0,0:54:08.14,0:54:12.21,TEXT-JP,,0,0,0,,Егер Құдайдың бұл бөлігі өзін тәуелсіз сияқты ұстаса,
Dialogue: 0,0:54:12.21,0:54:15.33,TEXT-JP,,0,0,0,,«Құдайдың даусын ести білу»
Dialogue: 0,0:54:17.95,0:54:22.19,TEXT-JP,,0,0,0,,Екі бөлінген рух және Құдайдың дауысы?
Dialogue: 0,0:54:27.38,0:54:30.73,TEXT-JP,,0,0,0,,Жау базасы Асо, Кюсю деп анықталды
Dialogue: 0,0:54:30.73,0:54:33.29,TEXT-JP,,0,0,0,,Барлау дронымен расталған
Dialogue: 0,0:54:34.14,0:54:38.39,TEXT-JP,,0,0,0,,Қорғаныс күштеріне әскери ұшқышсыз ұшақтарды беру туралы өтініш жасалды ма?
Dialogue: 0,0:54:39.61,0:54:42.06,TEXT-JP,,0,0,0,,Мәселе қылмыс коэффициенті.
Dialogue: 0,0:54:43.03,0:54:48.49,TEXT-JP,,0,0,0,,Қылмыстық коэффициент мидағы арнайы чип арқылы жасырылған деген болжам бар.
Dialogue: 0,0:54:49.93,0:54:53.79,TEXT-JP,,0,0,0,,Онымен күресудің жалғыз жолы – қалыпты қылмыстық заңды қолдану.
Dialogue: 0,0:54:56.19,0:54:58.64,TEXT-JP,,0,0,0,,Даулы болса да
Dialogue: 0,0:54:59.47,0:55:03.70,TEXT-JP,,0,0,0,,Заңсыз қаруды тәркілеуге жіберуге рұқсат беру
Dialogue: 0,0:55:04.57,0:55:06.00,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,0:55:22.86,0:55:25.72,TEXT-JP,,0,0,0,,Операция енді орындалады.
Dialogue: 0,0:56:49.49,0:56:51.05,TEXT-JP,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:56:51.85,0:56:52.69,TEXT-JP,,0,0,0,,О
Dialogue: 0,0:56:53.36,0:56:54.41,TEXT-JP,,0,0,0,,Бұл тұзақ па?
Dialogue: 0,0:56:54.94,0:56:56.83,TEXT-JP,,0,0,0,,Тек сақ бол, Джино.
Dialogue: 0,0:58:14.97,0:58:16.47,TEXT-JP,,0,0,0,,Не болды?
Dialogue: 0,0:58:27.35,0:58:28.30,TEXT-JP,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:58:34.84,0:58:36.14,TEXT-JP,,0,0,0,,Джиноны атпа
Dialogue: 0,0:58:39.55,0:58:43.86,TEXT-JP,,0,0,0,,Мен Сыртқы істер министрлігінің Шетелдегі үйлестіру бюросының жасырын тергеушісімін.
Dialogue: 0,0:58:44.54,0:58:46.18,TEXT-JP,,0,0,0,,Тонами мұнда жоқ
Dialogue: 0,0:58:47.70,0:58:49.64,TEXT-JP,,0,0,0,,Алдымен адамды жерге қойыңыз.
Dialogue: 0,0:58:50.24,0:58:51.27,TEXT-JP,,0,0,0,,Түсіндім
Dialogue: 0,0:59:01.47,0:59:03.29,TEXT-JP,,0,0,0,,Мені қазір ұстаңыз.
Dialogue: 0,0:59:04.10,0:59:05.90,TEXT-JP,,0,0,0,,Тонами байқаса жаман болар еді.
Dialogue: 0,0:59:08.47,0:59:09.79,TEXT-JP,,0,0,0,,Шығатын жол жоқ сияқты
Dialogue: 0,0:59:13.31,0:59:17.03,TEXT-JP,,0,0,0,,Ябуки мырза, қазір бәрі жақсы.
Dialogue: 0,0:59:21.54,0:59:23.75,TEXT-JP,,0,0,0,,Мен сот отырысына қатысамын.
Dialogue: 0,0:59:24.34,0:59:28.35,TEXT-JP,,0,0,0,,Гиноза мырзаның сот орындаушысының бақылауын уақытша өшіріңіз.
Dialogue: 0,0:59:29.09,0:59:31.60,TEXT-JP,,0,0,0,,Тергеуді осында жүргізіңіз.
Dialogue: 0,0:59:31.60,0:59:32.62,TEXT-JP,,0,0,0,,Түсінді.
Dialogue: 0,0:59:33.29,0:59:35.16,TEXT-JP,,0,0,0,,Бірдеңе болса, маған дереу хабарлаңыз
Dialogue: 0,0:59:36.11,0:59:37.43,TEXT-JP,,0,0,0,,Сондай-ақ абай болыңыз
Dialogue: 0,0:59:38.40,0:59:39.31,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,0:59:45.00,0:59:47.89,TEXT-JP,,0,0,0,,Мен Василий Игнатовпын.
Dialogue: 0,0:59:48.44,0:59:51.94,TEXT-JP,,0,0,0,,Ол директор Ябукидің басшылығымен жасырын тергеу жүргізді.
Dialogue: 0,0:59:52.52,0:59:54.38,TEXT-JP,,0,0,0,,Мен бастықтан хабар алған жоқпын.
Dialogue: 0,0:59:54.85,0:59:56.77,TEXT-JP,,0,0,0,,Ябуки мырзадан басқа
Dialogue: 0,0:59:56.77,0:59:59.83,TEXT-JP,,0,0,0,,Денсаулық және әл-ауқат министрлігінен Атсуши Шиндо мұны дәлелдейді.
Dialogue: 0,1:00:01.03,1:00:02.20,TEXT-JP,,0,0,0,,Бастық...
Dialogue: 0,1:00:02.98,1:00:07.37,TEXT-JP,,0,0,0,,Мен бұл стратегия туралы Шиндо-саннан шифрланған байланыс арқылы да білдім.
Dialogue: 0,1:00:08.00,1:00:11.54,TEXT-JP,,0,0,0,,Тонами қайда орналасқан? Ол құжатты алды ма?
Dialogue: 0,1:00:12.24,1:00:15.47,TEXT-JP,,0,0,0,,Мен оны түсінбедім. Менде бар.
Dialogue: 0,1:00:16.14,1:00:17.10,TEXT-JP,,0,0,0,,Сіз?
Dialogue: 0,1:00:18.18,1:00:21.16,TEXT-JP,,0,0,0,,Миға құпия операциялық чип орнатылды.
Dialogue: 0,1:00:21.91,1:00:24.79,TEXT-JP,,0,0,0,,Онда дәрігердің зерттеу нәтижелері енгізілді.
Dialogue: 0,1:00:25.81,1:00:27.49,TEXT-JP,,0,0,0,,Менің миымда...
Dialogue: 0,1:00:28.52,1:00:30.48,TEXT-JP,,0,0,0,,Бірінші кезекте Тонамидің мақсаты қандай?
Dialogue: 0,1:00:31.29,1:00:33.50,TEXT-JP,,0,0,0,,Құжатпен не істегіңіз келеді?
Dialogue: 0,1:00:34.08,1:00:38.22,TEXT-JP,,0,0,0,,Ол құжат деп аталады, бірақ шын мәнінде бұл симулятор теориясы.
Dialogue: 0,1:00:39.66,1:00:44.23,TEXT-JP,,0,0,0,,Этникалық қақтығыстар мен жаппай наразылық болжанып, сандық түрде бағаланды.
Dialogue: 0,1:00:44.23,1:00:46.25,TEXT-JP,,0,0,0,,«Қақтығыс коэффициентін» өлшеу
Dialogue: 0,1:00:49.29,1:00:55.01,TEXT-JP,,0,0,0,,Осыны пайдалана отырып, қақтығыстар пайда болғанға дейін алдын алуға немесе оларды күшейтуге болады.
Dialogue: 0,1:00:55.52,1:00:59.39,TEXT-JP,,0,0,0,,Тонами оны қай жолмен пайдаланады деп сұраудың қажеті жоқ.
Dialogue: 0,1:01:00.05,1:01:04.52,TEXT-JP,,0,0,0,,Деректерді шығарып алғанша, мені анекогенді камерада ұстаңыз.
Dialogue: 0,1:01:05.98,1:01:08.49,TEXT-JP,,0,0,0,,Сіз жынданып қалудан қорқасыз ба?
Dialogue: 0,1:01:09.02,1:01:09.87,TEXT-JP,,0,0,0,,Иә.
Dialogue: 0,1:01:10.85,1:01:15.02,TEXT-JP,,0,0,0,,Менің миыма тағы бір чип бөлгіш имплантацияланды
Dialogue: 0,1:01:16.16,1:01:18.40,TEXT-JP,,0,0,0,,Ол мұны адамдарға жақын болу үшін пайдаланады.
Dialogue: 0,1:01:20.63,1:01:23.55,TEXT-JP,,0,0,0,,Сенімді болу үшін мен бастықты тексеруге ертіп барамын.
Dialogue: 0,1:01:23.55,1:01:25.87,TEXT-JP,,0,0,0,,Когами, оны тыңда.
Dialogue: 0,1:01:25.87,1:01:26.87,TEXT-JP,,0,0,0,,Түсіндім
Dialogue: 0,1:01:37.55,1:01:38.30,TEXT-JP,,0,0,0,,мырза.
Dialogue: 0,1:01:42.30,1:01:44.56,TEXT-JP,,0,0,0,,Бұл қиын жұмыс болды.
Dialogue: 0,1:01:48.94,1:01:51.94,TEXT-JP,,0,0,0,,Синдо мырза, мән-жайды айтып беріңізші.
Dialogue: 0,1:01:57.88,1:02:01.72,TEXT-JP,,0,0,0,,Доктор Сторонская қандай жағдайда өлтірілгенін айтып беріңізші.
Dialogue: 0,1:02:03.00,1:02:05.73,TEXT-JP,,0,0,0,,Мен дәрігерді өлтірдім.
Dialogue: 0,1:02:12.28,1:02:17.03,TEXT-JP,,0,0,0,,Бұл зерттеу қызымды жалғыз сезінді.
Dialogue: 0,1:02:18.49,1:02:20.09,TEXT-JP,,0,0,0,,Ана болу құқығынан айыру
Dialogue: 0,1:02:21.40,1:02:22.48,TEXT-JP,,0,0,0,,Әлі де...
Dialogue: 0,1:02:24.01,1:02:26.46,TEXT-JP,,0,0,0,,Мен тек сол балалардың болашағын қорғаймын.
Dialogue: 0,1:02:30.86,1:02:32.03,TEXT-JP,,0,0,0,,Милиция-сан
Dialogue: 0,1:02:33.63,1:02:35.44,TEXT-JP,,0,0,0,,Біз оны міндетті түрде жеткіземіз.
Dialogue: 0,1:02:49.99,1:02:51.82,TEXT-JP,,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,1:03:01.30,1:03:02.83,TEXT-JP,,0,0,0,,Бөлгіш дегеніміз не?
Dialogue: 0,1:03:06.19,1:03:08.52,TEXT-JP,,0,0,0,,Бұл сананы бөлетін құрылғы.
Dialogue: 0,1:03:09.24,1:03:11.68,TEXT-JP,,0,0,0,,Өзіңізді басқа адам ретінде тану
Dialogue: 0,1:03:12.79,1:03:16.06,TEXT-JP,,0,0,0,,Балалар өз кінәсін басқа адамға бере алады.
Dialogue: 0,1:03:17.33,1:03:20.31,TEXT-JP,,0,0,0,,Осылайша сіз реңкті анық сақтай аласыз.
Dialogue: 0,1:03:21.62,1:03:24.57,TEXT-JP,,0,0,0,,Сіз өз ойыңыздың бір бөлігін Тонамиге сеніп тапсырасыз ба?
Dialogue: 0,1:03:24.57,1:03:25.53,TEXT-JP,,0,0,0,,О
Dialogue: 0,1:03:26.19,1:03:29.40,TEXT-JP,,0,0,0,,Бұл да діни толқудың ғылыми репродукциясы.
Dialogue: 0,1:03:30.48,1:03:32.52,TEXT-JP,,0,0,0,,Құдайға мойынсұн
Dialogue: 0,1:03:32.52,1:03:35.16,TEXT-JP,,0,0,0,,Барлық әрекеттерді Тонамиге тапсырыңыз
Dialogue: 0,1:03:36.61,1:03:38.86,TEXT-JP,,0,0,0,,Иелену де осы жерде орын алды.
Dialogue: 0,1:03:39.65,1:03:40.91,TEXT-JP,,0,0,0,,Ол жарылып жатыр
Dialogue: 0,1:03:41.64,1:03:46.16,TEXT-JP,,0,0,0,,Сыртқы істер министрлігі қызметкерлерінің миына қондырылған аударма патчтары
Dialogue: 0,1:03:46.16,1:03:47.87,TEXT-JP,,0,0,0,,Осыған әуес
Dialogue: 0,1:03:48.44,1:03:50.97,TEXT-JP,,0,0,0,,Көлемі мен уақыты шектеулі болғанымен
Dialogue: 0,1:03:51.70,1:03:52.90,TEXT-JP,,0,0,0,,Мен көремін.
Dialogue: 0,1:03:53.60,1:03:56.47,TEXT-JP,,0,0,0,,Егер бұлай болса, бұл маған немесе қоғамдық қауіпсіздік мүшелеріне жұмыс істемейді.
Dialogue: 0,1:03:58.31,1:03:59.81,TEXT-JP,,0,0,0,,Бұл негізгі тақырып.
Dialogue: 0,1:03:59.81,1:04:01.81,TEXT-JP,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,1:04:02.77,1:04:06.32,TEXT-JP,,0,0,0,,Бұл генерал деп аталатын жоғарғы қолбасшының орны.
Dialogue: 0,1:04:06.94,1:04:08.24,TEXT-JP,,0,0,0,,Бірақ мен таң қалдым, Нагарегава.
Dialogue: 0,1:04:08.96,1:04:11.74,TEXT-JP,,0,0,0,,Мен сенің атыңды білмеймін және сені ешқашан кездестірмедім.
Dialogue: 0,1:04:12.52,1:04:15.57,TEXT-JP,,0,0,0,,Бірақ біз ақыры орналасқан жерді анықтадық.
Dialogue: 0,1:04:15.57,1:04:16.51,TEXT-JP,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,1:04:19.07,1:04:22.03,TEXT-JP,,0,0,0,,Жапонияның ең солтүстік архипелагы
Dialogue: 0,1:04:28.53,1:04:29.51,TEXT-JP,,0,0,0,,Аудио: zwx & Tsurou; Аударма: Pulsar & Basugi; Өңдеу: Xiao Ke & Ariake no Tsuki; Уақыт белгісі: Feng She; Дәстүрлі қытайшаға аудару: incot; Кодтау: Ginsou
Dialogue: 0,1:04:37.39,1:04:38.97,TEXT-JP,,0,0,0,,Өз күшіңді қалай қолдануды үйрен.
Dialogue: 0,1:04:40.11,1:04:40.93,TEXT-JP,,0,0,0,,Кай
Dialogue: 0,1:04:43.65,1:04:44.69,TEXT-JP,,0,0,0,,Тонами
Dialogue: 0,1:04:54.28,1:04:58.73,TEXT-JP,,0,0,0,,Анеходы камерадан шығыңыз. Егер бас тартсаң, мен сені өлтіремін.
Dialogue: 0,1:05:00.21,1:05:01.25,TEXT-JP,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:05:03.82,1:05:05.33,TEXT-JP,,0,0,0,,Атпа.
Dialogue: 0,1:05:07.48,1:05:09.57,TEXT-JP,,0,0,0,,Оны неге жасырдың?
Dialogue: 0,1:05:10.66,1:05:12.89,TEXT-JP,,0,0,0,,Тонами жапондықтарға сенбейді
Dialogue: 0,1:05:13.52,1:05:16.94,TEXT-JP,,0,0,0,,Ал Цанг мырзаның өзі ерікті болды.
Dialogue: 0,1:05:17.64,1:05:22.69,TEXT-JP,,0,0,0,,Өз бетіңізді өртеп жіберіңіз, сонда сіздің шынайы тұлғаңыз ашылып, миссияға барыңыз.
Dialogue: 0,1:05:23.22,1:05:24.90,TEXT-JP,,0,0,0,,Мен өлуге дайынмын.
Dialogue: 0,1:05:26.95,1:05:31.10,TEXT-JP,,0,0,0,,Бұл оқиға мені көптен бері мазалап жүр.
Dialogue: 0,1:05:31.80,1:05:32.91,TEXT-JP,,0,0,0,,Бір нәрсе
Dialogue: 0,1:05:33.39,1:05:38.41,TEXT-JP,,0,0,0,,Елге жасырын түрде келген доктор Сторонскаяға неліктен шабуыл жасалды?
Dialogue: 0,1:05:40.37,1:05:41.91,TEXT-JP,,0,0,0,,Ақпарат сыртқа шықты
Dialogue: 0,1:05:45.16,1:05:50.42,TEXT-JP,,0,0,0,,Дәлірек айтсақ, сіз және директор Ябуки ақпаратты әдейі сыртқа шығардыңыз.
Dialogue: 0,1:05:51.39,1:05:53.08,TEXT-JP,,0,0,0,,Тонамиді еліктіру үшін
Dialogue: 0,1:05:53.98,1:05:55.12,TEXT-JP,,0,0,0,,Жоқ?
Dialogue: 0,1:05:56.33,1:05:58.68,TEXT-JP,,0,0,0,,Сіздің қиялыңыз бай.
Dialogue: 0,1:06:00.76,1:06:05.57,TEXT-JP,,0,0,0,,Мен сіздің фоныңызды тексердім және күдікті ештеңе таппадым.
Dialogue: 0,1:06:06.91,1:06:08.87,TEXT-JP,,0,0,0,,Дегенмен мен жайсыздықты сезіндім.
Dialogue: 0,1:06:09.57,1:06:11.48,TEXT-JP,,0,0,0,,Сіз қателеспейсіз
Dialogue: 0,1:06:12.16,1:06:16.60,TEXT-JP,,0,0,0,,Әрқашан дұрыс жолды таңда, ол мансапқа жетелейді
Dialogue: 0,1:06:17.71,1:06:22.03,TEXT-JP,,0,0,0,,Әу бастан дайындалған баспалдақпен көтеріліп бара жатқандайсың.
Dialogue: 0,1:06:23.80,1:06:26.36,TEXT-JP,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:06:30.82,1:06:32.97,TEXT-JP,,0,0,0,,Когами-сан, не болды?
Dialogue: 0,1:06:34.14,1:06:35.23,TEXT-JP,,0,0,0,,Тонами...
Dialogue: 0,1:06:35.89,1:06:39.60,TEXT-JP,,0,0,0,,Агент Игнатоффты ұстап алып, қашып кетті.
Dialogue: 0,1:06:40.05,1:06:42.10,TEXT-JP,,0,0,0,,Директор Ябуки...
Dialogue: 0,1:06:42.10,1:06:43.23,TEXT-JP,,0,0,0,,Өлім
Dialogue: 0,1:06:44.00,1:06:45.60,TEXT-JP,,0,0,0,,Шұғыл әрекет жасаңыз
Dialogue: 0,1:06:49.01,1:06:51.49,TEXT-JP,,0,0,0,,Осы уақытқа дейін сіз Коу-кунның қайда екенін білуіңіз керек.
Dialogue: 0,1:06:53.48,1:06:54.69,TEXT-JP,,0,0,0,,Гвуу…
Dialogue: 0,1:07:04.38,1:07:05.50,TEXT-JP,,0,0,0,,Тоқта
Dialogue: 0,1:07:12.69,1:07:16.76,TEXT-JP,,0,0,0,,Атсуши Синдо Сіз де бұл адамды тастадыңыз ба?
Dialogue: 0,1:07:19.78,1:07:20.77,TEXT-JP,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,1:07:22.84,1:07:25.02,TEXT-JP,,0,0,0,,«Қылмыс коэффициенті 100-ден жоғары»
Dialogue: 0,1:07:25.57,1:07:27.39,TEXT-JP,,0,0,0,,«Орындауға жатады».
Dialogue: 0,1:07:28.37,1:07:31.28,TEXT-JP,,0,0,0,,Бөлгіш шамадан тыс жүктелген
Dialogue: 0,1:07:36.37,1:07:39.29,TEXT-JP,,0,0,0,,Бұл сіздің миыңызды күйдіреді.
Dialogue: 0,1:07:41.59,1:07:45.56,TEXT-JP,,0,0,0,,Әу бастан өлемін деп ойладыңыз ба? Кай
Dialogue: 0,1:07:46.98,1:07:50.17,TEXT-JP,,0,0,0,,«Нысананың қауіп рейтингі жаңартылды»
Dialogue: 0,1:07:50.17,1:07:52.96,TEXT-JP,,0,0,0,,«Қылмыс коэффициенті 301»
Dialogue: 0,1:07:53.51,1:07:55.47,TEXT-JP,,0,0,0,,«Өлімге әкелетін жоюшы»
Dialogue: 0,1:08:11.74,1:08:12.53,TEXT-JP,,0,0,0,,Кай
Dialogue: 0,1:08:28.53,1:08:29.56,TEXT-JP,,0,0,0,,Мен...
Dialogue: 0,1:08:30.44,1:08:33.06,TEXT-JP,,0,0,0,,Бұл Игнатов.
Dialogue: 0,1:08:36.25,1:08:38.53,TEXT-JP,,0,0,0,,Ақымақ... жігіт.
Dialogue: 0,1:08:51.08,1:08:53.40,TEXT-JP,,0,0,0,,Мені қазір өлтір.
Dialogue: 0,1:09:03.53,1:09:06.61,TEXT-JP,,0,0,0,,Мен тамақ алғым келеді, өтінемін.
Dialogue: 0,1:09:07.36,1:09:12.53,TEXT-JP,,0,0,0,,Мен оның менен басқаша өмір сүргенін қалаймын.
Dialogue: 0,1:09:14.07,1:09:15.63,TEXT-JP,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,1:09:16.83,1:09:18.54,TEXT-JP,,0,0,0,,Қалғанын маған қалдыр
Dialogue: 0,1:09:38.74,1:09:42.36,TEXT-JP,,0,0,0,,Ұзақ жауған жаңбыр жақында тоқтайды
Dialogue: 0,1:10:11.82,1:10:15.39,TEXT-JP,,0,0,0,,Синдоның бас штабынан жауап алу тоқтатылды
Dialogue: 0,1:10:15.39,1:10:16.25,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,1:10:16.94,1:10:19.72,TEXT-JP,,0,0,0,,Директор Касей тікелей сөйлегенде
Dialogue: 0,1:10:21.05,1:10:22.26,TEXT-JP,,0,0,0,,Мен көремін.
Dialogue: 0,1:10:23.72,1:10:27.62,TEXT-JP,,0,0,0,,Әйтеуір, Когами-санның аман-есен екеніне көңілім толды.
Dialogue: 0,1:10:29.06,1:10:31.83,TEXT-JP,,0,0,0,,Кешіріңіз, бұл менің қателігім болды.
Dialogue: 0,1:10:38.31,1:10:40.27,TEXT-JP,,0,0,0,,Біз бір командамыз
Dialogue: 0,1:10:41.05,1:10:42.84,TEXT-JP,,0,0,0,,Talking Heads
Dialogue: 0,1:10:44.51,1:10:45.98,TEXT-JP,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,1:10:47.38,1:10:49.53,TEXT-JP,,0,0,0,,Не істеуім керек?
Dialogue: 0,1:10:51.02,1:10:54.86,TEXT-JP,,0,0,0,,Біз қазір агент Игнатовтан алған ақпаратты талдап жатырмыз.
Dialogue: 0,1:10:55.70,1:10:57.73,TEXT-JP,,0,0,0,,Аяқтаған бойда жылжытыңыз
Dialogue: 0,1:10:58.38,1:11:00.47,TEXT-JP,,0,0,0,,Келесі жолы мен Тонамидің қашып кетуіне жол бермеймін.
Dialogue: 0,1:11:30.12,1:11:34.49,TEXT-JP,,0,0,0,,Мен оны көп жылдан бері көрдім, бірақ ол әлі мен жей алмайтын адам.
Dialogue: 0,1:11:35.44,1:11:37.90,TEXT-JP,,0,0,0,,Бұл өзара байланысты ма?
Dialogue: 0,1:11:39.13,1:11:42.33,TEXT-JP,,0,0,0,,Мен сізден осы мәселеге жауапкершілік алуыңызды сұраймын.
Dialogue: 0,1:11:42.90,1:11:47.51,TEXT-JP,,0,0,0,,Директор Ябукидің өлімімен ақпаратты реттеу өз шегіне жетті.
Dialogue: 0,1:11:48.29,1:11:49.56,TEXT-JP,,0,0,0,,Менің ойымша
Dialogue: 0,1:11:50.59,1:11:53.04,TEXT-JP,,0,0,0,,Менің де ниетім осы еді.
Dialogue: 0,1:11:54.29,1:11:59.61,TEXT-JP,,0,0,0,,Мен осы уақытқа дейін қол жеткізген жетістіктеріме, құралдарға қарамастан ризамын.
Dialogue: 0,1:12:01.92,1:12:03.62,TEXT-JP,,0,0,0,,Мен сенен бір нәрсе сұрағым келеді.
Dialogue: 0,1:12:04.13,1:12:09.59,TEXT-JP,,0,0,0,,Сибил жүйесі адам әлеуетіне сенуді жалғастыра ма?
Dialogue: 0,1:12:11.03,1:12:12.54,TEXT-JP,,0,0,0,,Бұл ақымақ сұрақ.
Dialogue: 0,1:12:13.69,1:12:16.17,TEXT-JP,,0,0,0,,Біз сол үшін өмір сүреміз
Dialogue: 0,1:12:19.15,1:12:21.09,TEXT-JP,,0,0,0,,Бұл жақсы жауап.
Dialogue: 0,1:12:21.83,1:12:26.71,TEXT-JP,,0,0,0,,Мен сіздің ұлыңыз бен оның достарының қауіпсіздігіне кепілдік беремін.
Dialogue: 0,1:12:27.41,1:12:31.08,TEXT-JP,,0,0,0,,Бұл уәде, Сибил жүйесі.
Dialogue: 0,1:12:32.45,1:12:33.81,TEXT-JP,,0,0,0,,Бөлек
Dialogue: 0,1:12:42.52,1:12:48.87,TEXT-JP,,0,0,0,,Сіз Сторонская құжаттарын әу бастан-ақ қоғамдық қауіпсіздікке тапсыруды жоспарлағансыз.
Dialogue: 0,1:12:48.87,1:12:49.97,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,1:12:49.97,1:12:52.51,TEXT-JP,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:12:53.80,1:12:55.27,TEXT-JP,,0,0,0,,Өкінішті
Dialogue: 0,1:12:56.12,1:13:01.73,TEXT-JP,,0,0,0,,Барлық инспекторлық құқықтарыңыз тоқтатылды.
Dialogue: 0,1:13:26.22,1:13:28.14,TEXT-JP,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,1:13:28.86,1:13:29.66,TEXT-JP,,0,0,0,,Жоқ
Dialogue: 0,1:13:31.31,1:13:34.94,TEXT-JP,,0,0,0,,Ертең інің үйленеді.
Dialogue: 0,1:13:35.98,1:13:40.27,TEXT-JP,,0,0,0,,Оның қайтыс болғаны туралы хабарды салтанатты рәсім аяқталғанша құпия ұстауларыңызды қалаймын.
Dialogue: 0,1:13:41.42,1:13:42.62,TEXT-JP,,0,0,0,,Қарастыру
Dialogue: 0,1:13:44.14,1:13:45.16,TEXT-JP,,0,0,0,,Рахмет
Dialogue: 0,1:13:54.10,1:13:57.42,TEXT-JP,,0,0,0,,Иә, сенің де маған қосылғаныңды қалаймын.
Dialogue: 0,1:14:08.29,1:14:10.18,TEXT-JP,,0,0,0,,Әке, кешігіп қалдыңыз.
Dialogue: 0,1:14:10.57,1:14:11.51,TEXT-JP,,0,0,0,,Нашар
Dialogue: 0,1:14:49.51,1:14:54.49,TEXT-JP,,0,0,0,,Кей-кун мен Майко-санды некелеріңізбен құттықтаймыз.
Dialogue: 0,1:15:03.30,1:15:06.13,TEXT-JP,,0,0,0,,Сибил жүйесі болса да...
Dialogue: 0,1:15:06.13,1:15:08.55,TEXT-JP,,0,0,0,,Жоқ, өйткені бар
Dialogue: 0,1:15:08.55,1:15:13.11,TEXT-JP,,0,0,0,,Шет елде дүниеге келген бұл екі жасты қиындықтар күтіп тұр деп ойлаймын.
Dialogue: 0,1:15:14.66,1:15:17.63,TEXT-JP,,0,0,0,,Мен көп өтірік айттым.
Dialogue: 0,1:15:18.42,1:15:22.48,TEXT-JP,,0,0,0,,Өзіңізге бұл дұрыс нәрсені істеу туралы айтыңыз.
Dialogue: 0,1:15:23.21,1:15:26.25,TEXT-JP,,0,0,0,,Бірақ өкінбеймін десем, өтірік айтқан болар едім.
Dialogue: 0,1:15:27.92,1:15:31.26,TEXT-JP,,0,0,0,,Сондықтан оны қайталағаныңызды қаламаймын.
Dialogue: 0,1:15:32.01,1:15:35.64,TEXT-JP,,0,0,0,,Өкінбей жол таңдап, жауап беруіңді қалаймын.
Dialogue: 0,1:15:37.31,1:15:41.62,TEXT-JP,,0,0,0,,Заман өзгерген сайын дұрыс таңдау да қателікке айналады.
Dialogue: 0,1:15:42.20,1:15:48.73,TEXT-JP,,0,0,0,,Өйткені дұрыстық салыстырмалы, ал ақиқат абсолютті.
Dialogue: 0,1:15:50.69,1:15:53.12,TEXT-JP,,0,0,0,,Бізге керек нәрсе – шындық
Dialogue: 0,1:15:53.12,1:15:57.53,TEXT-JP,,0,0,0,,Мұны түсініп, ешкімге зиян тигізбейтін таңдау жасаңыз
Dialogue: 0,1:15:58.27,1:16:03.27,TEXT-JP,,0,0,0,,Нағыз бақыт осында деп ойлаймын.
Dialogue: 0,1:16:03.97,1:16:06.60,TEXT-JP,,0,0,0,,Осымен менің сәлемдесуім аяқталды.
Dialogue: 0,1:16:46.65,1:16:49.17,TEXT-JP,,0,0,0,,Қайда бардың, әке?
Dialogue: 0,1:17:23.72,1:17:26.78,TEXT-JP,,0,0,0,,Болды, тезірек орал.
Dialogue: 0,1:17:27.47,1:17:28.74,TEXT-JP,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,1:17:44.39,1:17:46.80,TEXT-JP,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:17:47.53,1:17:51.98,TEXT-JP,,0,0,0,,Түсінбегенім сонша, мен жынданып бара жатқандай сезінемін.
Dialogue: 0,1:17:53.54,1:17:55.08,TEXT-JP,,0,0,0,,Мен де білмеймін
Dialogue: 0,1:17:55.65,1:17:59.66,TEXT-JP,,0,0,0,,Бірақ әкең сен үшін бәрін жасады.
Dialogue: 0,1:18:00.24,1:18:01.51,TEXT-JP,,0,0,0,,Мен солай сезінемін
Dialogue: 0,1:18:02.26,1:18:03.88,TEXT-JP,,0,0,0,,Мен үшін?
Dialogue: 0,1:18:03.88,1:18:06.93,TEXT-JP,,0,0,0,,Бұл не? Соны айт
Dialogue: 0,1:18:08.82,1:18:10.82,TEXT-JP,,0,0,0,,Оны өзіңіз табуыңыз керек
Dialogue: 0,1:18:11.68,1:18:13.61,TEXT-JP,,0,0,0,,Әкем айтқандай
Dialogue: 0,1:18:15.37,1:18:17.22,TEXT-JP,,0,0,0,,Шындықты іздеңіз
Dialogue: 0,1:18:23.99,1:18:28.04,TEXT-JP,,0,0,0,,Директордың бұйрығымен бірлескен тергеу тоқтатылды деп естідім.
Dialogue: 0,1:18:28.93,1:18:30.12,TEXT-JP,,0,0,0,,Не болды?
Dialogue: 0,1:18:30.53,1:18:31.44,TEXT-JP,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:18:32.36,1:18:35.49,TEXT-JP,,0,0,0,,Токиоға қайтып, директормен сөйлесіңіз.
Dialogue: 0,1:18:43.24,1:18:47.06,TEXT-JP,,0,0,0,,Біз «Пейсбрейкерлер» тәуелсіз ел деп жариялаймыз.
Dialogue: 0,1:18:47.81,1:18:49.26,TEXT-JP,,0,0,0,,Бұл Жапония
Dialogue: 0,1:18:49.26,1:18:53.23,TEXT-JP,,0,0,0,,Сонымен қатар, ол Сибил жүйесіне ешқандай қарсылық білдірмейді.
Dialogue: 0,1:18:54.05,1:19:00.58,TEXT-JP,,0,0,0,,Осының дәлелі ретінде мен реңк пен қылмыс санының өлшемін сұраймын.
Dialogue: 0,1:19:03.22,1:19:05.95,TEXT-JP,,0,0,0,,Нәтиже – таңғаларлық таза түс
Dialogue: 0,1:19:06.78,1:19:10.54,TEXT-JP,,0,0,0,,Өте мейірімді келіссөз серіктесі ретінде диагноз қойылған
Dialogue: 0,1:19:11.69,1:19:14.42,TEXT-JP,,0,0,0,,Менің ойымша, бұл да сенің Сибилдік үкімің емес.
Dialogue: 0,1:19:15.42,1:19:20.18,TEXT-JP,,0,0,0,,Мен олардың жоғарғы басшысы генералмен сөйлестім.
Dialogue: 0,1:19:20.74,1:19:23.85,TEXT-JP,,0,0,0,,Логикалық ойлаудың иесі
Dialogue: 0,1:19:23.85,1:19:27.87,TEXT-JP,,0,0,0,,Олар болашақта біздің шетелдегі іс-әрекеттерімізді қолдайтындарын айтады.
Dialogue: 0,1:19:29.27,1:19:34.61,TEXT-JP,,0,0,0,,Біз олардың Солтүстік архипелагтағы тәуелсіздігін мойындаймыз.
Dialogue: 0,1:19:35.73,1:19:38.88,TEXT-JP,,0,0,0,,Бұл енді Қоғамдық қауіпсіздік бюросының мәселесі емес пе?
Dialogue: 0,1:19:39.32,1:19:40.64,TEXT-JP,,0,0,0,,Бұл сандық іштен құлыпталған екен.
Dialogue: 0,1:19:41.32,1:19:46.63,TEXT-JP,,0,0,0,,Сіз оларға Сторонская құжатын жеткізуге жауапты боласыз.
Dialogue: 0,1:19:47.64,1:19:49.64,TEXT-JP,,0,0,0,,Осы уақытқа дейін қандай құрбандық шалды?
Dialogue: 0,1:19:50.51,1:19:54.40,TEXT-JP,,0,0,0,,Жақында Атсуши Шиндоның жазбасы сіздікі болады.
Dialogue: 0,1:19:55.08,1:19:56.67,TEXT-JP,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,1:19:57.80,1:20:00.53,TEXT-JP,,0,0,0,,Менің Қоғамдық қауіпсіздік бюросынан кеткенімді қалайсыз ба?
Dialogue: 0,1:20:01.95,1:20:06.28,TEXT-JP,,0,0,0,,Сіз қазірдің өзінде Қоғамдық қауіпсіздік бюросының ауқымынан тыс жұмыс істеп жатырсыз.
Dialogue: 0,1:20:26.35,1:20:27.30,TEXT-JP,,0,0,0,,Когами мырза
Dialogue: 0,1:20:28.75,1:20:32.89,TEXT-JP,,0,0,0,,Мен оқиғаны сол күйінде жасыра алмаймын.
Dialogue: 0,1:20:33.92,1:20:36.31,TEXT-JP,,0,0,0,,Сіз дайын сияқтысыз.
Dialogue: 0,1:20:37.74,1:20:39.81,TEXT-JP,,0,0,0,,Келе аласыз ба...?
Dialogue: 0,1:20:39.81,1:20:43.19,TEXT-JP,,0,0,0,,Келме десем де, артыңыздан еремін.
Dialogue: 0,1:20:44.15,1:20:47.87,TEXT-JP,,0,0,0,,Әңгіме сіз туралы болғандықтан, жеңу мүмкіндігіңіз жоғары деп ойлаймын.
Dialogue: 0,1:20:49.46,1:20:53.83,TEXT-JP,,0,0,0,,Қарсыластың тұлғасы күткендей болса, жеңу мүмкіндігіміз бар деп ойлаймын.
Dialogue: 0,1:20:54.53,1:20:55.97,TEXT-JP,,0,0,0,,жеткілікті
Dialogue: 0,1:20:57.89,1:20:59.33,TEXT-JP,,0,0,0,,Мен осылай естідім.
Dialogue: 0,1:21:00.47,1:21:01.73,TEXT-JP,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,1:21:02.60,1:21:04.18,TEXT-JP,,0,0,0,,Сұрау қажет емес.
Dialogue: 0,1:21:04.93,1:21:08.88,TEXT-JP,,0,0,0,,Мен бастық жасай алмаған мұраны аламын.
Dialogue: 0,1:21:14.12,1:21:19.99,TEXT-JP,,0,0,0,,Кензен Тонами мен Бейбітшілік бұзушы мүшелері заңға сәйкес қамауға алынады.
Dialogue: 0,1:21:20.67,1:21:24.61,TEXT-JP,,0,0,0,,Қамауға алу кезінде Қоғамдық қауіпсіздік бюросының қарулану ережелерін сақтаңыз
Dialogue: 0,1:21:25.00,1:21:28.45,TEXT-JP,,0,0,0,,Жалпы ереже бойынша тек доминаторларды пайдаланыңыз
Dialogue: 0,1:21:29.02,1:21:32.19,TEXT-JP,,0,0,0,,Сіз қатты қаруланған қарсыласқа шындап қарайсыз ба?
Dialogue: 0,1:21:32.19,1:21:38.75,TEXT-JP,,0,0,0,,Иә, біз Қылмыстық бөлімнің, Қоғамдық қауіпсіздік бюросының, Денсаулық сақтау және әл-ауқат министрлігінің детективтері ретінде күресеміз.
Dialogue: 0,1:21:40.09,1:21:42.84,TEXT-JP,,0,0,0,,Құқықтық заңдылық болмаса, мағынасы жоқ.
Dialogue: 0,1:21:43.56,1:21:45.51,TEXT-JP,,0,0,0,,Қатысу міндетті емес
Dialogue: 0,1:21:46.90,1:21:51.76,TEXT-JP,,0,0,0,,Когами екеуміз инспектор Цунеморимен бірге жұмыс істейміз.
Dialogue: 0,1:21:52.95,1:21:55.90,TEXT-JP,,0,0,0,,Біздің шешіміміз әлдеқашан шешілді.
Dialogue: 0,1:21:56.70,1:22:00.91,TEXT-JP,,0,0,0,,Жау базасына тасымалдауды өзіңізге қалдырыңыз
Dialogue: 0,1:22:01.41,1:22:03.16,TEXT-JP,,0,0,0,,Менің ойымда бір нәрсе бар
Dialogue: 0,1:22:03.67,1:22:07.14,TEXT-JP,,0,0,0,,Барлығы жұдырықтаса, бәрі бірден жойылады.
Dialogue: 0,1:22:07.14,1:22:09.46,TEXT-JP,,0,0,0,,Логистикалық қолдау өте маңызды
Dialogue: 0,1:22:09.46,1:22:16.54,TEXT-JP,,0,0,0,,Мен және Рокугозука мырза, талдаушы Караномори Хинагава, біз сізді осы жерден қолдаймыз.
Dialogue: 0,1:22:17.52,1:22:18.53,TEXT-JP,,0,0,0,,Рахмет
Dialogue: 0,1:22:19.18,1:22:21.77,TEXT-JP,,0,0,0,,Қазір күлетін уақыт па?
Dialogue: 0,1:22:21.77,1:22:24.07,TEXT-JP,,0,0,0,,Менің ағаларымның бәрі өлсе
Dialogue: 0,1:22:24.07,1:22:28.24,TEXT-JP,,0,0,0,,Мен сені қорқытқандай етіп, қашып кетемін.
Dialogue: 0,1:22:32.47,1:22:37.04,TEXT-JP,,0,0,0,,Peace Breaker байланыс жүйесінің көзі қозғалды.
Dialogue: 0,1:22:37.57,1:22:40.05,TEXT-JP,,0,0,0,,Сондықтан мен оны осы уақытқа дейін таба алмадым.
Dialogue: 0,1:22:40.98,1:22:42.14,TEXT-JP,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,1:22:43.16,1:22:47.28,TEXT-JP,,0,0,0,,Сіз биіктіктегі псевдоспутниктік байланыс желісін пайдаланасыз ба?
Dialogue: 0,1:22:48.06,1:22:50.53,TEXT-JP,,0,0,0,,Стратосферадағы дирижабль?
Dialogue: 0,1:22:50.53,1:22:53.91,TEXT-JP,,0,0,0,,Иә, жасырын материалды дирижабль
Dialogue: 0,1:22:55.17,1:22:58.18,TEXT-JP,,0,0,0,,Мен оны үнемі бір жерден екінші жерге ауыстыра отырып қолданамын.
Dialogue: 0,1:22:58.90,1:23:04.16,TEXT-JP,,0,0,0,,Егер бұл кеңінен қолданылса, әлемнің кез келген жерінде үлкен сыйымдылықтағы байланыс мүмкін.
Dialogue: 0,1:23:05.29,1:23:08.92,TEXT-JP,,0,0,0,,Бұл жүйені бұзып, оны басып алыңыз.
Dialogue: 0,1:23:09.93,1:23:13.58,TEXT-JP,,0,0,0,,Бөлгішті өшіргіңіз келсе, оны жою керек.
Dialogue: 0,1:23:14.56,1:23:19.73,TEXT-JP,,0,0,0,,Радио қабылдауы нашар солтүстік архипелагта Доминаторды үздіксіз пайдалану мүмкін емес.
Dialogue: 0,1:23:20.34,1:23:23.19,TEXT-JP,,0,0,0,,Сонымен, біз бұл дирижабльді кері бағытта қолданамыз.
Dialogue: 0,1:23:24.67,1:23:27.57,TEXT-JP,,0,0,0,,Енді осыған байланысты стратегиямызды жоспарлап көрейік.
Dialogue: 0,1:23:38.95,1:23:43.67,TEXT-JP,,0,0,0,,Бұл мен әзірлеу бөлімі жасаған Dominator прототипі.
Dialogue: 0,1:23:44.40,1:23:47.21,TEXT-JP,,0,0,0,,Оны меңгерсең, ол күшті қаруға айналады.
Dialogue: 0,1:23:48.66,1:23:49.59,TEXT-JP,,0,0,0,,Одаққа қатысты оқиғалар немесе байқаулар туралы ешқандай хабар жоқ
Dialogue: 0,1:23:51.41,1:23:55.67,TEXT-JP,,0,0,0,,Бұл өте қымбат, сондықтан оны қайтаруды ұмытпаңыз.
Dialogue: 0,1:23:57.42,1:23:59.81,TEXT-JP,,0,0,0,,Екі адамға арналған аутентификация параметрлері аяқталды.
Dialogue: 0,1:24:00.49,1:24:01.82,TEXT-JP,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,1:24:02.40,1:24:04.50,TEXT-JP,,0,0,0,,Мен стратегияны түсінемін, бірақ
Dialogue: 0,1:24:04.50,1:24:07.54,TEXT-JP,,0,0,0,,Біз келгенше абайсызда ештеңе жасамаңыз.
Dialogue: 0,1:24:08.54,1:24:10.73,TEXT-JP,,0,0,0,,Сіз, Отори рөлі, ең қауіптісі.
Dialogue: 0,1:24:12.28,1:24:13.99,TEXT-JP,,0,0,0,,Ешқандай уәде беруге болмайды
Dialogue: 0,1:24:16.99,1:24:20.00,TEXT-JP,,0,0,0,,Сондықтан тез келіңізші.
Dialogue: 0,1:24:28.84,1:24:30.54,TEXT-JP,,0,0,0,,Сіздің аяқтарыңыз жақсы ма?
Dialogue: 0,1:24:31.35,1:24:33.99,TEXT-JP,,0,0,0,,А-а, мен жаралануға үйреніп қалдым.
Dialogue: 0,1:24:36.58,1:24:41.37,TEXT-JP,,0,0,0,,Сен екеуміз Цунемориді осы жұмысқа байладық.
Dialogue: 0,1:24:42.25,1:24:44.03,TEXT-JP,,0,0,0,,Кейде мен солай ойлаймын.
Dialogue: 0,1:24:45.73,1:24:48.52,TEXT-JP,,0,0,0,,Мен бұл өзімшіл болжам екенін білемін, бірақ
Dialogue: 0,1:24:49.34,1:24:51.85,TEXT-JP,,0,0,0,,Мен оның қалқаны боламын деп шештім.
Dialogue: 0,1:24:52.53,1:24:54.54,TEXT-JP,,0,0,0,,Жасырын қылмыскер болуы керек
Dialogue: 0,1:24:56.15,1:24:58.11,TEXT-JP,,0,0,0,,Бұл мен өтеуім мүмкін.
Dialogue: 0,1:24:59.78,1:25:01.07,TEXT-JP,,0,0,0,,Біз бәріміз құтқарылар едік
Dialogue: 0,1:25:05.71,1:25:07.34,TEXT-JP,,0,0,0,,Тағы да сұрайын
Dialogue: 0,1:25:08.72,1:25:10.41,TEXT-JP,,0,0,0,,Неге қайтып келдің?
Dialogue: 0,1:25:11.95,1:25:13.56,TEXT-JP,,0,0,0,,Өлмеу
Dialogue: 0,1:25:15.24,1:25:18.34,TEXT-JP,,0,0,0,,Өзімнің кек алу және борыш сезімім ғана емес.
Dialogue: 0,1:25:19.09,1:25:23.62,TEXT-JP,,0,0,0,,Сіз басқа біреуге жақсырақ нәрсе жасай аласыз.
Dialogue: 0,1:25:24.47,1:25:25.86,TEXT-JP,,0,0,0,,Мен солай сезіндім.
Dialogue: 0,1:25:28.00,1:25:31.43,TEXT-JP,,0,0,0,,Жақсырақ болды, сәл ғана.
Dialogue: 0,1:26:16.73,1:26:20.11,TEXT-JP,,0,0,0,,Амфибия шабуылдау кемесі межелі жерге 17 минутта жетеді.
Dialogue: 0,1:26:20.11,1:26:23.28,TEXT-JP,,0,0,0,,Түсіндім, қырағы бол.
Dialogue: 0,1:26:23.92,1:26:25.79,TEXT-JP,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:26:25.79,1:26:29.87,TEXT-JP,,0,0,0,,Уайымдама, мен сенің қарызыңды өтегеніме қуаныштымын.
Dialogue: 0,1:26:30.54,1:26:33.76,TEXT-JP,,0,0,0,,Бұл құпия жаттығу болуы керек.
Dialogue: 0,1:26:34.49,1:26:36.31,TEXT-JP,,0,0,0,,Рахмет саған Сарутоби
Dialogue: 0,1:26:40.29,1:26:45.93,TEXT-JP,,0,0,0,,Шындығында, мен Денсаулық сақтау және әл-ауқат министрлігінің Синдо штабының нұсқаулары негізінде дайындалдым.
Dialogue: 0,1:27:37.24,1:27:39.07,TEXT-JP,,0,0,0,,Қазір сканерлеуді бастаңыз
Dialogue: 0,1:27:47.55,1:27:50.20,TEXT-JP,,0,0,0,,Деректерді Hound командасына жіберу
Dialogue: 0,1:27:50.70,1:27:52.18,TEXT-JP,,0,0,0,,Түсірілген позиция
Dialogue: 0,1:27:53.00,1:27:54.56,TEXT-JP,,0,0,0,,Енді әрекет жасаңыз
Dialogue: 0,1:27:55.29,1:27:58.84,TEXT-JP,,0,0,0,,Түсінікті, екінші кезеңге көшеміз.
Dialogue: 0,1:27:58.84,1:28:00.07,TEXT-JP,,0,0,0,,Келесі шайқас!
Dialogue: 0,1:28:01.64,1:28:03.51,TEXT-JP,,0,0,0,,Цунемори келгенше уақыт аз.
Dialogue: 0,1:28:03.99,1:28:04.91,TEXT-JP,,0,0,0,,Кеттік
Dialogue: 0,1:28:57.14,1:29:01.11,TEXT-JP,,0,0,0,,«Аймақтағы жауынгерлік коэффициенттің стандартты мәнін жою»
Dialogue: 0,1:29:01.11,1:29:03.53,TEXT-JP,,0,0,0,,«Ұрыс жүргізуге мүмкіндік жоқ»
Dialogue: 0,1:29:04.68,1:29:09.28,TEXT-JP,,0,0,0,,Акане Цунемори Сіз Сибил жүйесінің арнайы өкілісіз бе?
Dialogue: 0,1:29:09.28,1:29:13.25,TEXT-JP,,0,0,0,,Енді құжатты қайдан алуға болады?
Dialogue: 0,1:29:15.34,1:29:18.29,TEXT-JP,,0,0,0,,Міне, Сторонская құжаттары.
Dialogue: 0,1:29:19.56,1:29:22.11,TEXT-JP,,0,0,0,,Кайдың сақтау құрылғысы?
Dialogue: 0,1:29:22.11,1:29:24.17,TEXT-JP,,0,0,0,,Мазасыз нәрсе жасаңыз
Dialogue: 0,1:29:24.17,1:29:26.53,TEXT-JP,,0,0,0,,Деректерді кез келген уақытта жоюға болады
Dialogue: 0,1:29:26.53,1:29:28.79,TEXT-JP,,0,0,0,,Біртүрлі қозғалыстар жасамаңыз.
Dialogue: 0,1:29:28.79,1:29:30.30,TEXT-JP,,0,0,0,,Сізге не керек?
Dialogue: 0,1:29:31.16,1:29:33.56,TEXT-JP,,0,0,0,,Енді генералды көрейін.
Dialogue: 0,1:29:34.57,1:29:37.44,TEXT-JP,,0,0,0,,Байланыс жүйесінің орналасуын одан әрі тарылту мүмкін емес.
Dialogue: 0,1:29:37.44,1:29:41.69,TEXT-JP,,0,0,0,,Егер олар бөлгішті пайдаланса, біз оларды оңай анықтай аламыз.
Dialogue: 0,1:29:42.00,1:29:44.96,TEXT-JP,,0,0,0,,Менің ағамнан хабар күтуім керек шығар.
Dialogue: 0,1:29:44.96,1:29:46.32,TEXT-JP,,0,0,0,,Хинагава, дайынсың ба?
Dialogue: 0,1:29:47.19,1:29:48.58,TEXT-JP,,0,0,0,,Дайын
Dialogue: 0,1:29:48.58,1:29:51.86,TEXT-JP,,0,0,0,,Бағдарлама Суго мырзаның ұшқышсыз ұшағы арқылы көрсетіледі.
Dialogue: 0,1:29:52.35,1:29:56.33,TEXT-JP,,0,0,0,,Дегенмен, кедергіні жүктеп салу және жою үшін уақыт қажет.
Dialogue: 0,1:29:56.99,1:29:58.94,TEXT-JP,,0,0,0,,It's a close call.
Dialogue: 0,1:30:24.91,1:30:26.57,TEXT-JP,,0,0,0,,Let's move right away
Dialogue: 0,1:30:26.57,1:30:28.74,TEXT-JP,,0,0,0,,Сандарды олар байқамай тұрып азайтыңыз
Dialogue: 0,1:30:29.83,1:30:33.06,TEXT-JP,,0,0,0,,Мен Dominator қолданбасын қолдансам, сәл жеңілірек болар еді.
Dialogue: 0,1:30:33.70,1:30:35.49,TEXT-JP,,0,0,0,,Сіз тек сене аласыз және күте аласыз.
Dialogue: 0,1:30:41.77,1:30:45.00,TEXT-JP,,0,0,0,,Осындай қирандыларда ұлттың құрылғанын қалай жариялауға болады?
Dialogue: 0,1:30:45.58,1:30:46.89,TEXT-JP,,0,0,0,,(Хонда) Тағы қолдансаңдар, ұшыратып жібереміз!
Dialogue: 0,1:30:50.90,1:30:52.76,TEXT-JP,,0,0,0,,Difference in values
Dialogue: 0,1:30:53.89,1:30:59.05,TEXT-JP,,0,0,0,,Бұл автономды компьютерлермен салынған адамсыз өнеркәсіптік қала.
Dialogue: 0,1:31:00.29,1:31:04.15,TEXT-JP,,0,0,0,,Мен болашақты адам қолынан бос эволюциядан көрдім.
Dialogue: 0,1:31:05.02,1:31:09.78,TEXT-JP,,0,0,0,,Өкінішке орай, ол әлемдік қақтығыстың хаосына байланысты тоқтатылды.
Dialogue: 0,1:31:09.78,1:31:12.61,TEXT-JP,,0,0,0,,You are complicit in the conflict.
Dialogue: 0,1:31:32.63,1:31:34.43,TEXT-JP,,0,0,0,,The true identity of the general
Dialogue: 0,1:31:35.26,1:31:38.53,TEXT-JP,,0,0,0,,Күтілгендей, бұл Сибил жүйесімен бірдей AI.
Dialogue: 0,1:31:39.61,1:31:41.16,TEXT-JP,,0,0,0,,After all?
Dialogue: 0,1:31:41.77,1:31:44.94,TEXT-JP,,0,0,0,,Көптің зұлымдығы мен кінәсі сеніп тапсырылған
Dialogue: 0,1:31:44.94,1:31:47.44,TEXT-JP,,0,0,0,,Ал Сибилмен кім татуласа алады?
Dialogue: 0,1:31:48.11,1:31:49.91,TEXT-JP,,0,0,0,,Адам ретінде елестету қиын
Dialogue: 0,1:31:51.08,1:31:54.08,TEXT-JP,,0,0,0,,This answer was given to me by Mr. Saiga.
Dialogue: 0,1:31:55.03,1:31:59.91,TEXT-JP,,0,0,0,,Бастапқыда психологиялық қауіптерге қарсы тұру үшін медициналық AI ретінде жасалған.
Dialogue: 0,1:31:59.91,1:32:01.98,TEXT-JP,,0,0,0,,Сибилдің көмекші жүйесі
Dialogue: 0,1:32:03.03,1:32:06.70,TEXT-JP,,0,0,0,,Жалпы сипаттамаларды өзгерту арқылы жасалды.
Dialogue: 0,1:32:07.78,1:32:11.55,TEXT-JP,,0,0,0,,To make us soldiers fight to the death.
Dialogue: 0,1:32:11.55,1:32:13.72,TEXT-JP,,0,0,0,,Why don't you leave the general?
Dialogue: 0,1:32:16.04,1:32:17.81,TEXT-JP,,0,0,0,,Because it's right
Dialogue: 0,1:32:17.81,1:32:21.22,TEXT-JP,,0,0,0,,Мәселе оны сахнаның артында басқаратын адамда.
Dialogue: 0,1:32:21.72,1:32:25.36,TEXT-JP,,0,0,0,,Бейбітшілікті бұзушылар корпусын құрудың астарындағы қараңғылық міндетті түрде ашылады.
Dialogue: 0,1:32:25.36,1:32:28.66,TEXT-JP,,0,0,0,,Бірақ бұл сіз жасаған қылмысты өшірмейді.
Dialogue: 0,1:32:28.66,1:32:30.37,TEXT-JP,,0,0,0,,What to do if
Dialogue: 0,1:32:31.82,1:32:34.99,TEXT-JP,,0,0,0,,Тонами Кензен Сіз қамауға алындыңыз
Dialogue: 0,1:32:36.22,1:32:40.74,TEXT-JP,,0,0,0,,«Қылмыс коэффициенті 48, орындауға жатпайды»
Dialogue: 0,1:32:41.67,1:32:46.25,TEXT-JP,,0,0,0,,Too bad your god recognizes me.
Dialogue: 0,1:32:46.25,1:32:48.77,TEXT-JP,,0,0,0,,Akane used Dominator
Dialogue: 0,1:32:48.77,1:32:50.50,TEXT-JP,,0,0,0,,Also check the operation of the divider
Dialogue: 0,1:32:50.50,1:32:53.26,TEXT-JP,,0,0,0,,Байланыс жүйесі мен Тонамидің орны анықталды.
Dialogue: 0,1:32:53.26,1:32:56.05,TEXT-JP,,0,0,0,,Бас координаттарын дереу растаңыз
Dialogue: 0,1:32:56.71,1:32:57.64,TEXT-JP,,0,0,0,,Жарайды
Dialogue: 0,1:33:00.90,1:33:03.39,TEXT-JP,,0,0,0,,Әлі де біразы қалды.
Dialogue: 0,1:33:03.39,1:33:05.81,TEXT-JP,,0,0,0,,proceed with due caution
Dialogue: 0,1:33:05.81,1:33:07.06,TEXT-JP,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,1:33:13.22,1:33:15.09,TEXT-JP,,0,0,0,,Enemy communication system discovered
Dialogue: 0,1:33:19.24,1:33:20.78,TEXT-JP,,0,0,0,,Enter contact approach
Dialogue: 0,1:33:23.28,1:33:26.29,TEXT-JP,,0,0,0,,Түсінікті. Let's start hacking now.
Dialogue: 0,1:33:26.91,1:33:29.26,TEXT-JP,,0,0,0,,Don't leave too far until it's done
Dialogue: 0,1:33:56.07,1:33:58.05,TEXT-JP,,0,0,0,,Hacking area is just around the corner
Dialogue: 0,1:33:58.05,1:33:59.28,TEXT-JP,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,1:34:01.02,1:34:04.59,TEXT-JP,,0,0,0,,Шабуыл күткеннен де қарқынды. Өтінемін, асығыңыз.
Dialogue: 0,1:34:09.63,1:34:12.67,TEXT-JP,,0,0,0,,Сізде имплантацияланған сақтау құрылғысы жоқ.
Dialogue: 0,1:34:13.31,1:34:15.94,TEXT-JP,,0,0,0,,Маған Сторонская құжатын беріңіз.
Dialogue: 0,1:34:15.94,1:34:18.67,TEXT-JP,,0,0,0,,Necessary to complete the system
Dialogue: 0,1:34:19.66,1:34:24.03,TEXT-JP,,0,0,0,,Мен дәрігердің миын алмастыруға тырыстым, бірақ ол толық болмады.
Dialogue: 0,1:34:24.47,1:34:26.43,TEXT-JP,,0,0,0,,Неліктен бұлай істей бересің?
Dialogue: 0,1:34:26.43,1:34:29.23,TEXT-JP,,0,0,0,,Why was Sibyl born?
Dialogue: 0,1:34:29.23,1:34:32.06,TEXT-JP,,0,0,0,,Because the world has fallen into chaos.
Dialogue: 0,1:34:32.06,1:34:34.44,TEXT-JP,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,1:34:34.44,1:34:37.54,TEXT-JP,,0,0,0,,Себеп - бай мен кедей арасындағы алшақтықтың кеңеюі.
Dialogue: 0,1:34:38.27,1:34:42.95,TEXT-JP,,0,0,0,,Және оны абсолютті күшпен ғана түзетуге болады.
Dialogue: 0,1:34:42.95,1:34:46.20,TEXT-JP,,0,0,0,,Бұл шектен шыққан. Мұны ешкім қаламайды.
Dialogue: 0,1:34:46.20,1:34:48.31,TEXT-JP,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,1:34:49.25,1:34:53.96,TEXT-JP,,0,0,0,,Бейбітшіліктің пайдасын көргенде, сахна артында болып жатқан нәрсе.
Dialogue: 0,1:34:53.96,1:34:59.97,TEXT-JP,,0,0,0,,Адамдар басқаларға билік жүргізе бергенше, біреу әрқашан әділетсіз өлтіріледі.
Dialogue: 0,1:35:15.72,1:35:20.49,TEXT-JP,,0,0,0,,Rulers can rule on all people equally.
Dialogue: 0,1:35:21.13,1:35:23.45,TEXT-JP,,0,0,0,,AI болуы керек
Dialogue: 0,1:35:24.29,1:35:27.74,TEXT-JP,,0,0,0,,Онда адамдар араласпауы керек.
Dialogue: 0,1:35:27.74,1:35:28.82,TEXT-JP,,0,0,0,,Жоқ
Dialogue: 0,1:35:28.82,1:35:30.87,TEXT-JP,,0,0,0,,Жоқ, бұл дұрыс.
Dialogue: 0,1:35:30.87,1:35:35.00,TEXT-JP,,0,0,0,,Адам Алланың әмірімен ғана өмір сүреді.
Dialogue: 0,1:35:38.84,1:35:43.00,TEXT-JP,,0,0,0,,«Rafael байланыс жүйесінде заңсыз үдеткіш анықталды»
Dialogue: 0,1:35:43.00,1:35:46.16,TEXT-JP,,0,0,0,,«Аймақтағы ұрыс коэффициенті өсуде»
Dialogue: 0,1:35:46.16,1:35:48.51,TEXT-JP,,0,0,0,,«Жедел шара қолдануыңызды өтінемін»
Dialogue: 0,1:35:48.95,1:35:51.31,TEXT-JP,,0,0,0,,Сіз әлі өтірік айттыңыз ба?
Dialogue: 0,1:35:52.14,1:35:54.93,TEXT-JP,,0,0,0,,Ішке егеуқұйрық кірді. Өлтір.
Dialogue: 0,1:35:54.93,1:35:56.33,TEXT-JP,,0,0,0,,Мен де жақында кетемін.
Dialogue: 0,1:35:56.33,1:35:57.27,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,1:35:57.27,1:35:58.69,TEXT-JP,,0,0,0,,Сізде...
Dialogue: 0,1:36:11.24,1:36:16.04,TEXT-JP,,0,0,0,,Осылай тірі болсам да, жас келіншектен ұтыла алмаймын.
Dialogue: 0,1:36:27.89,1:36:29.68,TEXT-JP,,0,0,0,,Әрі қарай жалғастыру мүмкін емес
Dialogue: 0,1:36:29.68,1:36:32.56,TEXT-JP,,0,0,0,,Dominator пайдаланылғанша осында болыңыз.
Dialogue: 0,1:36:46.82,1:36:48.37,TEXT-JP,,0,0,0,,Бұл жолы өлтіріңіз
Dialogue: 0,1:36:48.77,1:36:49.78,TEXT-JP,,0,0,0,,Тонами?
Dialogue: 0,1:37:26.00,1:37:27.03,TEXT-JP,,0,0,0,,Когами
Dialogue: 0,1:37:28.79,1:37:30.32,TEXT-JP,,0,0,0,,It's no use, give up.
Dialogue: 0,1:38:39.34,1:38:41.77,TEXT-JP,,0,0,0,,Is it still there? Бұл енді ұзаққа бармайтын сияқты.
Dialogue: 0,1:38:46.04,1:38:47.55,TEXT-JP,,0,0,0,,Тағы да...
Dialogue: 0,1:38:55.08,1:38:56.45,TEXT-JP,,0,0,0,,Сәтті шабуыл
Dialogue: 0,1:38:56.77,1:38:57.82,TEXT-JP,,0,0,0,,Шион
Dialogue: 0,1:38:59.27,1:39:01.08,TEXT-JP,,0,0,0,,Мен білемін
Dialogue: 0,1:39:01.08,1:39:02.83,TEXT-JP,,0,0,0,,Қарсы шабуылды бастаңыз!
Dialogue: 0,1:39:09.05,1:39:10.09,TEXT-JP,,0,0,0,,Инспектор?
Dialogue: 0,1:39:33.16,1:39:34.03,TEXT-JP,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,1:39:34.55,1:39:37.53,TEXT-JP,,0,0,0,,Бөлгіш жарамсыз. Dominator can be used.
Dialogue: 0,1:39:37.79,1:39:38.89,TEXT-JP,,0,0,0,,Түсінікті
Dialogue: 0,1:39:40.39,1:39:42.71,TEXT-JP,,0,0,0,,«Доминатор іске қосылды»
Dialogue: 0,1:39:42.71,1:39:45.84,TEXT-JP,,0,0,0,,“User authentication Shinya Kogami”
Dialogue: 0,1:39:45.84,1:39:50.29,TEXT-JP,,0,0,0,,«Сыртқы істер министрлігінің әрекет ету бөліміне жататындығы үшін арнайы лицензияны растау»
Dialogue: 0,1:39:50.29,1:39:52.05,TEXT-JP,,0,0,0,,"Temporary user"
Dialogue: 0,1:39:58.92,1:40:03.25,TEXT-JP,,0,0,0,,«Қылмыстық коэффициенті 100-ден асатын бірнеше нысана анықталды»
Dialogue: 0,1:40:03.25,1:40:05.10,TEXT-JP,,0,0,0,,«Қауіпсіздікті өшіру»
Dialogue: 0,1:40:05.10,1:40:07.36,TEXT-JP,,0,0,0,,«Нысананы басу».
Dialogue: 0,1:40:09.40,1:40:12.71,TEXT-JP,,0,0,0,,«Орындау режимі декомпозиторды жою»
Dialogue: 0,1:40:12.71,1:40:16.17,TEXT-JP,,0,0,0,,«Аймақтағы қару нысандарын толығымен жою»
Dialogue: 0,1:40:16.17,1:40:17.45,TEXT-JP,,0,0,0,,«Абайлаңыз»
Dialogue: 0,1:40:35.31,1:40:38.21,TEXT-JP,,0,0,0,,"Қате орын алды. Өшіру."
Dialogue: 0,1:40:39.04,1:40:42.10,TEXT-JP,,0,0,0,,Leave this to me. Тұрақты күзетті қадағалаңыз.
Dialogue: 0,1:40:52.87,1:40:53.86,TEXT-JP,,0,0,0,,Тоқтама.
Dialogue: 0,1:40:53.86,1:40:54.79,TEXT-JP,,0,0,0,,Барыңыз
Dialogue: 0,1:40:57.79,1:40:58.81,TEXT-JP,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,1:41:21.37,1:41:22.80,TEXT-JP,,0,0,0,,Son's Enemy
Dialogue: 0,1:41:22.80,1:41:24.02,TEXT-JP,,0,0,0,,өлтіру
Dialogue: 0,1:41:24.85,1:41:25.84,TEXT-JP,,0,0,0,,Күлкілі
Dialogue: 0,1:41:26.59,1:41:29.30,TEXT-JP,,0,0,0,,Байланыс жүйесінің автоматтандырылған навигациясы жұмыс істейді
Dialogue: 0,1:41:29.74,1:41:32.44,TEXT-JP,,0,0,0,,Жоқ, ол құлыпталған және оны басқару мүмкін емес.
Dialogue: 0,1:41:33.21,1:41:34.28,TEXT-JP,,0,0,0,,Міне, осы
Dialogue: 0,1:41:34.79,1:41:39.00,TEXT-JP,,0,0,0,,Өзін-өзі жою жүйесі бұзылған жағдайда іске қосылады.
Dialogue: 0,1:41:39.61,1:41:40.82,TEXT-JP,,0,0,0,,Жою мүмкін емес
Dialogue: 0,1:41:41.58,1:41:44.39,TEXT-JP,,0,0,0,,Нашар, базаға барады.
Dialogue: 0,1:41:44.39,1:41:45.87,TEXT-JP,,0,0,0,,Мика-чан, не істеуіміз керек...
Dialogue: 0,1:41:46.36,1:41:47.08,TEXT-JP,,0,0,0,,Иә?
Dialogue: 0,1:41:51.02,1:41:53.59,TEXT-JP,,0,0,0,,Менен сатқынға көмектесуімді сұрап тұрсың ба?
Dialogue: 0,1:41:54.11,1:41:54.94,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,1:41:55.89,1:41:59.79,TEXT-JP,,0,0,0,,Қоғамдық қауіпсіздік бюросы... Жоқ, Сибил үшін де.
Dialogue: 0,1:42:00.29,1:42:03.73,TEXT-JP,,0,0,0,,Цунемори Аканенің осында өлуіне жол берме.
Dialogue: 0,1:42:16.93,1:42:19.38,TEXT-JP,,0,0,0,,Негізгі жүйе қауіпсіз бе?
Dialogue: 0,1:42:20.44,1:42:22.16,TEXT-JP,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:42:23.23,1:42:28.50,TEXT-JP,,0,0,0,,Put the Storonskaya document in your god
Dialogue: 0,1:42:29.02,1:42:30.75,TEXT-JP,,0,0,0,,In the right way
Dialogue: 0,1:42:31.08,1:42:32.08,TEXT-JP,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:42:32.54,1:42:38.13,TEXT-JP,,0,0,0,,Егер сіздің генералыңыз қақтығысты тоқтату үшін AI болса
Dialogue: 0,1:42:38.50,1:42:41.39,TEXT-JP,,0,0,0,,Жауап өзгеретініне сенімдімін.
Dialogue: 0,1:42:41.39,1:42:43.58,TEXT-JP,,0,0,0,,Содан кейін басты оқиға енді басталғалы тұрғандай сезіледі… Яаах~♡
Dialogue: 0,1:42:43.58,1:42:48.52,TEXT-JP,,0,0,0,,Сен бәрін білесің, сосын менің жолыма түсесің.
Dialogue: 0,1:42:49.30,1:42:53.11,TEXT-JP,,0,0,0,,Detective in charge of law enforcement.
Dialogue: 0,1:42:58.53,1:43:00.53,TEXT-JP,,0,0,0,,Document to Dominator…
Dialogue: 0,1:43:03.22,1:43:05.69,TEXT-JP,,0,0,0,,«Солдаттарды мадақтаңдар»
Dialogue: 0,1:43:05.69,1:43:10.99,TEXT-JP,,0,0,0,,«Бұдан былай біз Сибил жүйесімен, уәде етілген жермен бір боламыз».
Dialogue: 0,1:43:10.99,1:43:15.26,TEXT-JP,,0,0,0,,«Ол әлемге әділдік пен тәртіп әкеледі».
Dialogue: 0,1:43:15.26,1:43:18.17,TEXT-JP,,0,0,0,,«Мен әрқашан сенімен бірге боламын...»
Dialogue: 0,1:43:18.78,1:43:22.14,TEXT-JP,,0,0,0,,«Медициналық АИ-дегі ақауларды реттеу»
Dialogue: 0,1:43:22.14,1:43:26.18,TEXT-JP,,0,0,0,,"Updated as part of the Sibyl System"
Dialogue: 0,1:43:26.94,1:43:30.87,TEXT-JP,,0,0,0,,«Қажет болмаған кезде құрылғыны өшіріңіз»
Dialogue: 0,1:43:37.22,1:43:41.32,TEXT-JP,,0,0,0,,General, is that your answer?
Dialogue: 0,1:43:50.37,1:43:52.82,TEXT-JP,,0,0,0,,Ол күткеннен жылдамырақ болғанымен
Dialogue: 0,1:43:53.45,1:43:56.26,TEXT-JP,,0,0,0,,Олардың ассимиляциясы қажет болды.
Dialogue: 0,1:43:57.43,1:44:01.74,TEXT-JP,,0,0,0,,Адам өте құдіретті Сибил деген құдайды жаратты.
Dialogue: 0,1:44:02.87,1:44:05.72,TEXT-JP,,0,0,0,,Бірақ құдайды өлтіретін де халық.
Dialogue: 0,1:44:06.45,1:44:10.82,TEXT-JP,,0,0,0,,Сіз қоғамға апат әкелетін бақсысыз.
Dialogue: 0,1:44:41.77,1:44:42.67,TEXT-JP,,0,0,0,,Жаңа қозғалыс?
Dialogue: 0,1:45:09.53,1:45:10.95,TEXT-JP,,0,0,0,,Атыс күші жеткіліксіз
Dialogue: 0,1:45:26.77,1:45:28.52,TEXT-JP,,0,0,0,,Барлығы таусылды ма?
Dialogue: 0,1:45:28.92,1:45:30.25,TEXT-JP,,0,0,0,,Жарайды
Dialogue: 0,1:45:31.40,1:45:32.90,TEXT-JP,,0,0,0,,Мен мұны істедім.
Dialogue: 0,1:45:35.29,1:45:38.48,TEXT-JP,,0,0,0,,Түсінді. Мен бұйрықты дереу орындаймын.
Dialogue: 0,1:45:39.01,1:45:41.59,TEXT-JP,,0,0,0,,Енді ұрысқа дайындал
Dialogue: 0,1:45:42.05,1:45:44.52,TEXT-JP,,0,0,0,,Кемеге қарсы зымыран ұшыруға дайын
Dialogue: 0,1:45:52.67,1:45:53.52,TEXT-JP,,0,0,0,,Іске қосу
Dialogue: 0,1:46:26.26,1:46:27.42,TEXT-JP,,0,0,0,,Ой, тоқта! Төмендегі Коике үйінде су ағып жатыр!
Dialogue: 0,1:46:28.17,1:46:30.54,TEXT-JP,,0,0,0,,Байланыс жүйесінің бұзылуы расталды
Dialogue: 0,1:46:55.22,1:46:57.02,TEXT-JP,,0,0,0,,Жаман екен, қашамын.
Dialogue: 0,1:47:07.12,1:47:09.65,TEXT-JP,,0,0,0,,Неге мені бірден өлтірмейсің?
Dialogue: 0,1:47:10.07,1:47:11.94,TEXT-JP,,0,0,0,,Ауырсынуды біл
Dialogue: 0,1:47:19.93,1:47:21.31,TEXT-JP,,0,0,0,,Мылтықты қойыңыз
Dialogue: 0,1:47:24.91,1:47:29.34,TEXT-JP,,0,0,0,,Тонами Кокузен Мен сені заң бойынша соттаймын
Dialogue: 0,1:47:29.72,1:47:31.80,TEXT-JP,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,1:47:31.80,1:47:35.07,TEXT-JP,,0,0,0,,Оның жұмыс істемейтін және ескірген заңдары
Dialogue: 0,1:47:35.07,1:47:38.85,TEXT-JP,,0,0,0,,Сибил адамдарды босатуға тырысады.
Dialogue: 0,1:47:39.42,1:47:46.86,TEXT-JP,,0,0,0,,Сибил де, генерал да мен сияқты адамдарды әділдік іздеу үшін пайдаланады.
Dialogue: 0,1:47:47.84,1:47:52.49,TEXT-JP,,0,0,0,,Мені өлтірсең де, мұның басталуын тоқтата алмайсың.
Dialogue: 0,1:47:53.98,1:47:55.12,TEXT-JP,,0,0,0,,Жоқ
Dialogue: 0,1:47:55.12,1:47:57.22,TEXT-JP,,0,0,0,,Сибил олай емес
Dialogue: 0,1:47:57.88,1:48:02.62,TEXT-JP,,0,0,0,,Адамдар мен жүйелер арасында симбиотикалық қатынас болуы керек
Dialogue: 0,1:48:04.52,1:48:09.38,TEXT-JP,,0,0,0,,Әйтпесе өмір сүрудің құнын жоғалтамыз.
Dialogue: 0,1:48:10.41,1:48:12.26,TEXT-JP,,0,0,0,,Пішін
Dialogue: 0,1:48:13.00,1:48:14.41,TEXT-JP,,0,0,0,,Бұл заң.
Dialogue: 0,1:48:16.19,1:48:19.91,TEXT-JP,,0,0,0,,Мұндай дүниеде мұндай нәрсені кім қалайды?
Dialogue: 0,1:48:20.47,1:48:24.89,TEXT-JP,,0,0,0,,Адамдар тек Сибилдің астында қарапайым бақыт іздейді.
Dialogue: 0,1:48:25.30,1:48:28.90,TEXT-JP,,0,0,0,,Мен дұрыстық іздемеймін.
Dialogue: 0,1:48:30.75,1:48:32.65,TEXT-JP,,0,0,0,,Толықтай келісемін.
Dialogue: 0,1:48:43.36,1:48:44.59,TEXT-JP,,0,0,0,,Когами мырза
Dialogue: 0,1:48:46.44,1:48:50.30,TEXT-JP,,0,0,0,,Мен саған мұны қайталамаймын дедім.
Dialogue: 0,1:48:55.99,1:48:58.68,TEXT-JP,,0,0,0,,Заңның күшін жоюдың ешбір жолы жоқ
Dialogue: 0,1:48:59.16,1:49:01.50,TEXT-JP,,0,0,0,,Барлығы Тонами айтқандай шығар.
Dialogue: 0,1:49:02.47,1:49:07.31,TEXT-JP,,0,0,0,,Сонда да әділдік іздеген саған сенемін.
Dialogue: 0,1:49:09.23,1:49:11.29,TEXT-JP,,0,0,0,,Мені де соттау керек.
Dialogue: 0,1:49:12.86,1:49:14.25,TEXT-JP,,0,0,0,,Когами мырза
Dialogue: 0,1:49:33.89,1:49:34.92,TEXT-JP,,0,0,0,,Амансың ба?
Dialogue: 0,1:49:35.55,1:49:37.06,TEXT-JP,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,1:49:56.43,1:50:00.31,TEXT-JP,,0,0,0,,Ақыры Сибил бәріне қол жеткізді.
Dialogue: 0,1:50:00.31,1:50:02.74,TEXT-JP,,0,0,0,,Осылайша ол біздікі болды.
Dialogue: 0,1:50:03.33,1:50:06.17,TEXT-JP,,0,0,0,,Заң шегіне жетіп, жұмыстан шығады
Dialogue: 0,1:50:06.17,1:50:08.91,TEXT-JP,,0,0,0,,Келесі конгрессменді асыға күтеміз
Dialogue: 0,1:50:11.96,1:50:15.64,TEXT-JP,,0,0,0,,«Ацуши Шинду, Шого Ябукидің нұсқауы бойынша»
Dialogue: 0,1:50:15.64,1:50:20.67,TEXT-JP,,0,0,0,,«Бейбітшілік бұзушылар басқа елдерге қарсы жойқын әрекеттер жасады».
Dialogue: 0,1:50:21.18,1:50:23.50,TEXT-JP,,0,0,0,,«Заңсыздықты жасыру»
Dialogue: 0,1:50:23.50,1:50:28.35,TEXT-JP,,0,0,0,,«Ол бөлімше командирі Тонами Козеннің көтерілісін қоздырды».
Dialogue: 0,1:50:28.82,1:50:33.68,TEXT-JP,,0,0,0,,«Мұны Атсуши Синдо қалдырған мойындау деректері дәлелдейді».
Dialogue: 0,1:50:33.68,1:50:35.48,TEXT-JP,,0,0,0,,«дәлелденді»
Dialogue: 0,1:50:35.48,1:50:42.09,TEXT-JP,,0,0,0,,«Синдо Ябуки, осы екі адамның өлімімен біз оқиғаны тергеуді аяқтаймыз».
Dialogue: 0,1:50:42.63,1:50:45.70,TEXT-JP,,0,0,0,,Олар кінәні үкіметке жүктеп қана қойған жоқ.
Dialogue: 0,1:50:45.70,1:50:49.65,TEXT-JP,,0,0,0,,«Бұл олардың әу бастан қалаған нәтижесі».
Dialogue: 0,1:50:54.71,1:51:00.13,TEXT-JP,,0,0,0,,Мен жауапты қызметкерді Сыртқы істер министрлігіне ауыстыруға рұқсат бергеніңіз үшін алғыс айтамын.
Dialogue: 0,1:51:00.13,1:51:04.74,TEXT-JP,,0,0,0,,«Жақында Шинья Когамиге мінез-құлық бөліміне оралуға рұқсат беріледі».
Dialogue: 0,1:51:04.74,1:51:07.49,TEXT-JP,,0,0,0,,Мен де мәселені қиындатқым келмейді.
Dialogue: 0,1:51:09.41,1:51:10.89,TEXT-JP,,0,0,0,,«Бұл таңқаларлық реакция».
Dialogue: 0,1:51:10.89,1:51:14.87,TEXT-JP,,0,0,0,,Мен сіз салған рельстерге мінгенім таң қалдырды ма?
Dialogue: 0,1:51:14.87,1:51:17.03,TEXT-JP,,0,0,0,,«Бұл бақытты қате есептеу болды».
Dialogue: 0,1:51:17.03,1:51:22.05,TEXT-JP,,0,0,0,,«Сізден Синдо Атсуши ұстанған жолмен жүруіңізді сұраймын».
Dialogue: 0,1:51:22.58,1:51:23.38,TEXT-JP,,0,0,0,,Иә
Dialogue: 0,1:51:25.20,1:51:26.94,TEXT-JP,,0,0,0,,Мен Қоғамдық қауіпсіздік бюросының қызметінен кетемін.
Dialogue: 0,1:51:34.68,1:51:36.67,TEXT-JP,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,1:51:39.51,1:51:43.12,TEXT-JP,,0,0,0,,Егер заттар ешқашан өзгермесе, әлем табиғи болмас еді.
Dialogue: 0,1:51:45.31,1:51:46.42,TEXT-JP,,0,0,0,,Иә.
Dialogue: 0,1:51:47.90,1:51:51.43,TEXT-JP,,0,0,0,,Аа, уақыт келді емес пе? Шу-чанды тағайындау рәсімі
Dialogue: 0,1:52:00.10,1:52:03.78,TEXT-JP,,0,0,0,,«Мені көптен бері бір нәрсе уайымдап жүр».
Dialogue: 0,1:52:04.52,1:52:06.79,TEXT-JP,,0,0,0,,«Қылмыс коэффициенті өзгермеген».
Dialogue: 0,1:52:07.42,1:52:11.70,TEXT-JP,,0,0,0,,«Осы Сибил қоғамының жағдайы талқыланбайды».
Dialogue: 0,1:52:12.66,1:52:14.59,TEXT-JP,,0,0,0,,«Бастапқыда заңмен басқарылатын елде»
Dialogue: 0,1:52:14.59,1:52:18.96,TEXT-JP,,0,0,0,,«Күнәнің табиғаты туралы пікірталас үшін әрқашан орын болған».
Dialogue: 0,1:52:19.76,1:52:21.24,TEXT-JP,,0,0,0,,«Күнә дегеніміз не?»
Dialogue: 0,1:52:21.94,1:52:23.59,TEXT-JP,,0,0,0,,«Жаза әділ бе?»
Dialogue: 0,1:52:24.02,1:52:27.60,TEXT-JP,,0,0,0,,«Басқалардың жамандығын түсініп, өз әділдігіңе күмәнданба».
Dialogue: 0,1:52:29.07,1:52:34.23,TEXT-JP,,0,0,0,,«Адамдардың адам болуы үшін ең маңыздысы - үнемі пікірталас жүргізу».
Dialogue: 0,1:52:34.83,1:52:37.12,TEXT-JP,,0,0,0,,«Бұл оқиға мені бұл туралы қатты хабардар етті».
Dialogue: 0,1:52:38.39,1:52:44.11,TEXT-JP,,0,0,0,,«Бұл талқылауды тоқтату әділеттіліктің болашақтағы дұрыс түрі емес».
Dialogue: 0,1:52:44.11,1:52:45.62,TEXT-JP,,0,0,0,,«Менің ойымша»
Dialogue: 0,1:52:46.34,1:52:48.49,TEXT-JP,,0,0,0,,«Адамдарға заңдар қажет».
Dialogue: 0,1:52:49.34,1:52:50.71,TEXT-JP,,0,0,0,,«Мен де солаймын».
Dialogue: 0,1:52:51.90,1:52:56.15,TEXT-JP,,0,0,0,,«Мен әділдікті тек менің қолымнан келетін жолмен іздеймін».
Dialogue: 0,1:52:57.64,1:52:59.82,TEXT-JP,,0,0,0,,«Мен Когами-санды кездестіргеніме қуаныштымын».
Dialogue: 0,1:53:01.22,1:53:02.63,TEXT-JP,,0,0,0,,«Рахмет сізге»
Dialogue: 0,1:53:04.22,1:53:06.05,TEXT-JP,,0,0,0,,«Мен бұл жауапты бере алдым.»
Dialogue: 0,1:53:14.34,1:53:15.55,TEXT-JP,,0,0,0,,Ақымақ.
Dialogue: 0,1:53:33.36,1:53:36.05,TEXT-JP,,0,0,0,,«60-тан төмен қылмыс коэффициенті»
Dialogue: 0,1:53:36.05,1:53:38.29,TEXT-JP,,0,0,0,,«Орындауға жатпайды»
Dialogue: 0,1:53:38.84,1:53:41.17,TEXT-JP,,0,0,0,,«Триггерді құлыптау»
Dialogue: 0,1:53:42.99,1:53:46.13,TEXT-JP,,0,0,0,,Маған көмектесші, Мика-чан
Dialogue: 0,1:53:48.64,1:53:49.92,TEXT-JP,,0,0,0,,Осыған ұқсас нәрсе...
Dialogue: 0,1:53:50.76,1:53:52.06,TEXT-JP,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,1:53:57.47,1:54:02.11,TEXT-JP,,0,0,0,,Бір таңғаларлығы, ол кісі өлтіруді көпшіліктің көзінше жасаса да.
Dialogue: 0,1:54:02.11,1:54:06.36,TEXT-JP,,0,0,0,,Күдікті Акане Цунаморидің қылмыс коэффициенті төмен.
Dialogue: 0,1:54:06.36,1:54:10.85,TEXT-JP,,0,0,0,,Күдікті Цунаморидің қылмыс коэффициенті жария етілмеді.
Dialogue: 0,1:54:10.85,1:54:13.74,TEXT-JP,,0,0,0,,Facts Dominator басталмады
Dialogue: 0,1:54:14.51,1:54:16.19,TEXT-JP,,0,0,0,,Осы оқиғадан зардап шеккен
Dialogue: 0,1:54:16.19,1:54:21.63,TEXT-JP,,0,0,0,,Үкімет Әділет министрлігін тарату жоспарланғанын уақытша тоқтататынын хабарлады.
Dialogue: 0,1:54:25.00,1:54:29.24,TEXT-JP,,0,0,0,,«Цунемори Акане, бұл сіздің таңдауыңыз ба?»
Dialogue: 0,1:54:30.55,1:54:32.53,TEXT-JP,,0,0,0,,Заңдардың күші жойылмайды.
Dialogue: 0,1:54:33.47,1:54:35.39,TEXT-JP,,0,0,0,,Бұл тек адамдарға ғана қатысты емес
Dialogue: 0,1:54:35.79,1:54:39.17,TEXT-JP,,0,0,0,,Мен міндетті түрде Сибилді қорғайтын жалғыз қалқаныңа айналамын.
Dialogue: 0,1:54:40.31,1:54:48.25,TEXT-JP,,0,0,0,,Ол сондай-ақ Атсуши Шиндо мен Игнатовтың өз өмірлерін қатерге тігіп, қорғайтын нәрселерін сақтауы керек.
Dialogue: 0,1:54:48.86,1:54:50.28,TEXT-JP,,0,0,0,,«Қызықты»
Dialogue: 0,1:54:50.91,1:54:54.91,TEXT-JP,,0,0,0,,«Сіздің әрекетіңіз бұл қоғамға не береді?»
Dialogue: 0,1:54:54.91,1:54:56.58,TEXT-JP,,0,0,0,,«Сізге көрсетейін.»
Dialogue: 0,1:55:51.90,1:55:53.83,TEXT-JP,,0,0,0,,Мен сені міндетті түрде алып кетемін.
Dialogue: 1,0:04:36.93,0:04:37.31,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 0,0:04:37.31,0:04:37.52,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 0,0:04:37.52,0:04:37.56,OP-JP,,0,0,0,,HHeLiBeB
Dialogue: 0,0:04:37.56,0:04:37.60,OP-JP,,0,0,0,,BkeShRendeQX
Dialogue: 0,0:04:37.60,0:04:37.64,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 0,0:04:37.64,0:04:37.69,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 0,0:04:37.69,0:04:43.10,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 0,0:04:43.10,0:04:43.26,OP-JP,,0,0,0,,Сезім бар ма? Жүрегіңізде дауыс бар ма?
Dialogue: 1,0:04:43.26,0:04:43.64,OP-JP,,0,0,0,,Анонимділікке батқан ми - нөлдердің шексіз саны.
Dialogue: 0,0:04:43.64,0:04:43.85,OP-JP,,0,0,0,,Анонимділікке батқан ми - нөлдердің шексіз саны.
Dialogue: 0,0:04:43.85,0:04:43.89,OP-JP,,0,0,0,,CNOFNe
Dialogue: 0,0:04:43.89,0:04:43.93,OP-JP,,0,0,0,,ZaiNjYHuiBUX
