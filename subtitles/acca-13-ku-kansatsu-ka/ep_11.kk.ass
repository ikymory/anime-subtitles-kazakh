Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.52,0:00:23.89,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:24.73,0:00:28.40,Default,,0,0,0,,Патша қаны бар адамды қалай шақырар едің?
Dialogue: 0,0:00:29.19,0:00:32.86,Default,,0,0,0,,Лилиум отбасы үшін қандай қуанышты күн!
Dialogue: 0,0:00:33.03,0:00:34.03,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:00:34.90,0:00:36.07,Default,,0,0,0,,Иә
Dialogue: 0,0:00:40.95,0:00:41.87,Default,,0,0,0,,Ум...
Dialogue: 0,0:00:42.00,0:00:45.79,Default,,0,0,0,,Мен осы аймаққа ACCA инспекциялық бөлімімен жұмыс істеу үшін бардым.
Dialogue: 0,0:00:46.29,0:00:47.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:47.50,0:00:50.17,Default,,0,0,0,,Мен жұмысқа баруым керек.
Dialogue: 0,0:00:50.42,0:00:52.17,Default,,0,0,0,,Менің қарамағындағылар күтіп тұр.
Dialogue: 0,0:00:52.30,0:00:53.30,Default,,0,0,0,,Жарайды, тіпті шай болса да.
Dialogue: 0,0:00:54.42,0:00:57.59,Default,,0,0,0,,Флорауда өсірілген гүлдерден дайындалған шөп шайы.
Dialogue: 0,0:01:00.51,0:01:03.89,Default,,0,0,0,,Бұл жерде шынымен де көп гүлдер бар және бұл әдемі.
Dialogue: 0,0:01:04.10,0:01:05.56,Default,,0,0,0,,Біз ауданымызбен мақтанамыз.
Dialogue: 0,0:01:06.48,0:01:11.07,Default,,0,0,0,,Гүл де көп гүл өсетін тамаша өлке.
Dialogue: 0,0:01:11.98,0:01:13.65,Default,,0,0,0,,Адамдар да солай.
Dialogue: 0,0:01:13.78,0:01:18.20,Default,,0,0,0,,Барлық тұрғындар сол гүлдер сияқты көңілді, сымбатты.
Dialogue: 0,0:01:18.32,0:01:21.79,Default,,0,0,0,,Флорау Уордтың өкілі де көңілді.
Dialogue: 0,0:01:21.95,0:01:23.66,Default,,0,0,0,,Сіз отбасы мүшесісіз бе?
Dialogue: 0,0:01:24.20,0:01:26.83,Default,,0,0,0,,Ол жақсы бағынушы.
Dialogue: 0,0:01:28.88,0:01:31.04,Default,,0,0,0,,Мэр Бардонда да көрінеді.
Dialogue: 0,0:01:31.17,0:01:33.71,Default,,0,0,0,,Жұмсақ өрнек қойыңыз.
Dialogue: 0,0:01:33.84,0:01:35.17,Default,,0,0,0,,Бәрі де осы жердің арқасы.
Dialogue: 0,0:01:35.84,0:01:37.26,Default,,0,0,0,,Директор Лилиум да
Dialogue: 0,0:01:37.38,0:01:39.55,Default,,0,0,0,,Мен мұнда қайтып келсем, жағдай өзгере ме?
Dialogue: 0,0:01:39.68,0:01:42.97,Default,,0,0,0,,Хм, мына бала ше?
Dialogue: 0,0:01:43.10,0:01:45.48,Default,,0,0,0,,Бұл адамның жүрегі тым салмақты.
Dialogue: 0,0:01:45.60,0:01:49.06,Default,,0,0,0,,Ағалар мен апалар арасында тек біреуі ғана ерекшеленеді.
Dialogue: 0,0:01:49.19,0:01:50.65,Default,,0,0,0,,Айналадағы ауа
Dialogue: 0,0:01:50.90,0:01:52.94,Default,,0,0,0,,Алға және ортаға барыңыз
Dialogue: 0,0:01:53.82,0:01:58.40,Default,,0,0,0,,Әйтсе де әлгі бала басқалардан гөрі осы елді көбірек ойлайды.
Dialogue: 0,0:01:59.91,0:02:01.28,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:02:01.78,0:02:03.24,Default,,0,0,0,,Мен сені күттірер едім.
Dialogue: 0,0:02:03.37,0:02:04.20,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:02:04.99,0:02:07.00,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:02:16.42,0:02:22.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:39.88,0:03:45.89,Default,,0,0,0,,~♪
Dialogue: 0,0:03:51.98,0:03:54.81,Default,,0,0,0,,Тұрғындардың жүздері шынында да жарқын.
Dialogue: 0,0:03:54.94,0:03:57.61,Default,,0,0,0,,Мен көңілдіден гөрі күшті сезінемін.
Dialogue: 0,0:03:58.36,0:04:00.24,Default,,0,0,0,,Жарықтық Планета тұрғындарынан өзгеше.
Dialogue: 0,0:04:01.69,0:04:03.61,Default,,0,0,0,,А... бірдеңе ме?
Dialogue: 0,0:04:04.03,0:04:05.66,Default,,0,0,0,,Сен де үйреніп бара жатырсың.
Dialogue: 0,0:04:05.78,0:04:06.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:06.74,0:04:08.08,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:04:09.08,0:04:11.70,Default,,0,0,0,,Гүлдермен қоршалғандықтан шығар.
Dialogue: 0,0:04:12.91,0:04:15.33,Default,,0,0,0,,Мен өзімді өте тыныш сезінемін.
Dialogue: 0,0:04:16.13,0:04:19.05,Default,,0,0,0,,Менің келесі тапсырмам Якқала болды.
Dialogue: 0,0:04:19.17,0:04:20.13,Default,,0,0,0,,Аа.
Dialogue: 0,0:04:25.43,0:04:26.43,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:04:29.76,0:04:30.97,Default,,0,0,0,,Енді нысана қайда?
Dialogue: 0,0:04:31.85,0:04:33.73,Default,,0,0,0,,Мен аудан әкімінің үйінде кешкі ас ішіп жатырмын.
Dialogue: 0,0:04:33.98,0:04:35.27,Default,,0,0,0,,Қонақ үйге қайтып оралмаңыз
Dialogue: 0,0:04:35.40,0:04:37.81,Default,,0,0,0,,Мен сарайда осылай қалуым мүмкін.
Dialogue: 0,0:04:38.82,0:04:42.28,Default,,0,0,0,,Мен сені көрінбейтін жерге жетелеуге шамам жоқ.
Dialogue: 0,0:04:42.74,0:04:45.36,Default,,0,0,0,,Аа, сіз қашан кедергі болатынын ешқашан білмейсіз.
Dialogue: 0,0:04:46.03,0:04:48.32,Default,,0,0,0,,Мүмкіндікті жіберіп алмаңыз
Dialogue: 0,0:04:48.74,0:04:51.20,Default,,0,0,0,,Сәтсіздік енді опция емес
Dialogue: 0,0:04:54.91,0:04:56.75,Default,,0,0,0,,Осының алдында қай жақта тұр?
Dialogue: 0,0:04:57.08,0:04:58.13,Default,,0,0,0,,Планета
Dialogue: 0,0:04:58.25,0:04:59.96,Default,,0,0,0,,О, бұл көрші үй.
Dialogue: 0,0:05:00.71,0:05:03.88,Default,,0,0,0,,Көрші болғанымен, табиғаты мүлде бөлек.
Dialogue: 0,0:05:04.22,0:05:05.72,Default,,0,0,0,,Флорау аудандары арасында
Dialogue: 0,0:05:05.84,0:05:08.59,Default,,0,0,0,,Планетамен шекарасы шөлді аймақ.
Dialogue: 0,0:05:09.14,0:05:13.02,Default,,0,0,0,,Сонша барсаң, мүлде ештеңе таппайсың.
Dialogue: 0,0:05:14.60,0:05:19.56,Default,,0,0,0,,Ресурстар оңтүстік-батыстағы мұхит түбінде шоғырланған болуы мүмкін.
Dialogue: 0,0:05:19.86,0:05:24.11,Default,,0,0,0,,Планеттадағы барлық адамдарға көңіл айтудан басқа амалым жоқ.
Dialogue: 0,0:05:24.32,0:05:28.70,Default,,0,0,0,,Алайда, егер орталық жиналыстың бюджеті қаланы дамытуға жұмсалса.
Dialogue: 0,0:05:28.99,0:05:31.58,Default,,0,0,0,,Бұл палата өзгеріп, өмір сүруге қолайлы болар еді.
Dialogue: 0,0:05:31.95,0:05:33.49,Default,,0,0,0,,Көшбасшының эгосы ма?
Dialogue: 0,0:05:34.00,0:05:37.12,Default,,0,0,0,,Жоқ, бұл барлық палата тұрғындарының ойы сияқты.
Dialogue: 0,0:05:37.67,0:05:39.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:39.50,0:05:40.79,Default,,0,0,0,,Сондай-ақ, Флороуда
Dialogue: 0,0:05:40.92,0:05:42.05,Default,,0,0,0,,Тұрғындар бір кісідей жиналады
Dialogue: 0,0:05:42.17,0:05:44.67,Default,,0,0,0,,Менде сіз қалаған нәрсе бар.
Dialogue: 0,0:05:44.80,0:05:45.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:46.17,0:05:47.47,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:47.76,0:05:51.39,Default,,0,0,0,,Бүкіл Довар ауданына жеткізілетін мұнайдың 90% құрайды
Dialogue: 0,0:05:51.51,0:05:53.31,Default,,0,0,0,,Бұл Флораудан.
Dialogue: 0,0:05:54.14,0:05:56.98,Default,,0,0,0,,Ресурстар мағыналы түрде пайдаланылады
Dialogue: 0,0:05:57.10,0:06:00.23,Default,,0,0,0,,Біз, тұрғындар, осылай ойлаймыз.
Dialogue: 0,0:06:01.11,0:06:03.73,Default,,0,0,0,,Довар елін не қолдайды?
Dialogue: 0,0:06:03.98,0:06:05.82,Default,,0,0,0,,Бұл тұрғындардың мақтанышы.
Dialogue: 0,0:06:07.36,0:06:09.24,Default,,0,0,0,,Егер ресурстар табылса
Dialogue: 0,0:06:09.36,0:06:12.12,Default,,0,0,0,,Әрине, мен оны әр ауданмен бөліскім келеді.
Dialogue: 0,0:06:13.08,0:06:15.83,Default,,0,0,0,,Бірақ егер оны біржақты алып кетсе
Dialogue: 0,0:06:15.95,0:06:17.04,Default,,0,0,0,,Бұл қатты болуы керек.
Dialogue: 0,0:06:18.08,0:06:21.25,Default,,0,0,0,,Флорау ауданы Довар патшалығы өзінің қазіргі түрін алғанға дейін болған.
Dialogue: 0,0:06:21.38,0:06:23.04,Default,,0,0,0,,ресурстары болды
Dialogue: 0,0:06:23.59,0:06:26.38,Default,,0,0,0,,Менен ұрланған сияқты.
Dialogue: 0,0:06:27.01,0:06:29.84,Default,,0,0,0,,Олар сенімді ме?
Dialogue: 0,0:06:33.47,0:06:36.89,Default,,0,0,0,,Енді, мэр, оны тапсыратын кез келді ме?
Dialogue: 0,0:06:37.68,0:06:40.02,Default,,0,0,0,,Сіз тамақ ішуге дайынсыз ба?
Dialogue: 0,0:06:40.23,0:06:41.06,Default,,0,0,0,,Иә
Dialogue: 0,0:06:41.23,0:06:43.98,Default,,0,0,0,,Енді орындарды жылжытайық.
Dialogue: 0,0:06:52.03,0:06:55.03,Default,,0,0,0,,Төңкерістің жетекшісі Флорау болды, солай ма?
Dialogue: 0,0:06:56.37,0:06:58.91,Default,,0,0,0,,Сіз тұра аласыз, солай ма?
Dialogue: 0,0:06:59.62,0:07:01.17,Default,,0,0,0,,Бізбен бірге
Dialogue: 0,0:07:06.25,0:07:08.92,Default,,0,0,0,,Жарайды, бұл көлік қайтып келді.
Dialogue: 0,0:07:10.26,0:07:12.18,Default,,0,0,0,,Тыңда, мен сені көліктен түскенде атып тастаймын.
Dialogue: 0,0:07:12.97,0:07:15.14,Default,,0,0,0,,Егер сәтсіздікке ұшырасақ, өміріміз жойылады.
Dialogue: 0,0:07:18.02,0:07:21.52,Default,,0,0,0,,Оны өлтіріп, әйтеуір қашып құтылуға бәс тігейік.
Dialogue: 0,0:07:23.52,0:07:24.36,Default,,0,0,0,,Мазасыз...
Dialogue: 0,0:07:24.86,0:07:27.11,Default,,0,0,0,,Ату! Жанама әсерлері болса да көмектесу мүмкін емес.
Dialogue: 0,0:07:28.32,0:07:29.78,Default,,0,0,0,,Мені қазір өлтір
Dialogue: 0,0:07:38.20,0:07:39.70,Default,,0,0,0,,Ген!
Dialogue: 0,0:07:39.95,0:07:41.96,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:50.80,0:07:51.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.30,0:07:53.13,Default,,0,0,0,,Нино!
Dialogue: 0,0:07:53.89,0:07:55.97,Default,,0,0,0,,Сізге оқ атылды. Дереу ауруханаға барыңыз!
Dialogue: 0,0:07:56.72,0:07:58.97,Default,,0,0,0,,Алдымен филиал басшысына есеп беріп, нұсқаулар беріңіз.
Dialogue: 0,0:07:59.35,0:08:02.56,Default,,0,0,0,,Бұл туралы уайымдамаңыз! Қазір біз әр сәт үшін жарысамыз
Dialogue: 0,0:08:02.85,0:08:03.77,Default,,0,0,0,,Иә
Dialogue: 0,0:08:04.81,0:08:06.48,Default,,0,0,0,,(Канарияның айқайы)
Dialogue: 0,0:08:06.98,0:08:08.23,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:08:08.69,0:08:11.03,Default,,0,0,0,,Шабуылға ұшыраған адам менеджердің орынбасары болды.
Dialogue: 0,0:08:11.40,0:08:12.61,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:08:12.74,0:08:15.62,Default,,0,0,0,,Оны жеке өңдеу керек пе?
Dialogue: 0,0:08:16.20,0:08:19.29,Default,,0,0,0,,Басқа таңдау жоқ. Бұл бөлім бастығының шешімі.
Dialogue: 0,0:08:19.45,0:08:21.20,Default,,0,0,0,,Қандай да бір себеп болуы керек.
Dialogue: 0,0:08:21.95,0:08:23.50,Default,,0,0,0,,Уф... (аяқ дыбысы)
Dialogue: 0,0:08:23.92,0:08:26.38,Default,,0,0,0,,Науқас есін жиды
Dialogue: 0,0:08:29.09,0:08:30.09,Default,,0,0,0,,Сәтсіздік.
Dialogue: 0,0:08:32.47,0:08:35.09,Default,,0,0,0,,Лоттаға шабуыл жасаған қылмыскермен бірдей болса.
Dialogue: 0,0:08:35.47,0:08:37.51,Default,,0,0,0,,Доуэр отбасына қатысты ма?
Dialogue: 0,0:08:38.30,0:08:39.26,Default,,0,0,0,,О
Dialogue: 0,0:08:39.51,0:08:41.60,Default,,0,0,0,,Кінәлі өз өмірін қиған сияқты.
Dialogue: 0,0:08:42.02,0:08:46.15,Default,,0,0,0,,Бұл екеуінен басқалары болуы керек. Олар қашып кетті ме?
Dialogue: 0,0:08:46.27,0:08:47.10,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:08:48.23,0:08:50.27,Default,,0,0,0,,Мен мұнда бірінші рет келіп тұрмын.
Dialogue: 0,0:08:50.40,0:08:54.24,Default,,0,0,0,,Тек Гүлге ұзақ уақыт кіруге тыйым салынды.
Dialogue: 0,0:08:54.36,0:08:55.70,Default,,0,0,0,,Сіздің бастығыңызға.
Dialogue: 0,0:08:56.78,0:08:58.16,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:08:58.28,0:09:03.25,Default,,0,0,0,,Мен 5-директордың ACCA мүшесі «Crow» ретінде тірі болғанына қуаныштымын.
Dialogue: 0,0:09:03.87,0:09:06.12,Default,,0,0,0,,Доуэр отбасымен араласпаңыз.
Dialogue: 0,0:09:06.25,0:09:08.33,Default,,0,0,0,,Мен айтқанын орындадым.
Dialogue: 0,0:09:08.71,0:09:10.75,Default,,0,0,0,,Бұл мәселе міндетті түрде жоғары бағаланады.
Dialogue: 0,0:09:11.71,0:09:12.84,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:09:13.63,0:09:15.17,Default,,0,0,0,,Сәлем Джин
Dialogue: 0,0:09:15.59,0:09:17.97,Default,,0,0,0,,Соңғы кезде саған қарап тұрмын.
Dialogue: 0,0:09:18.39,0:09:21.93,Default,,0,0,0,,Сіз араласып жатырсыз ба, әлде мойныңызды тығып жатырсыз ба?
Dialogue: 0,0:09:22.39,0:09:24.31,Default,,0,0,0,,Кейде мен түсінбеймін
Dialogue: 0,0:09:25.89,0:09:27.69,Default,,0,0,0,,Араласпа
Dialogue: 0,0:09:27.94,0:09:31.23,Default,,0,0,0,,Менің міндетім тек сені қарау.
Dialogue: 0,0:09:32.23,0:09:33.73,Default,,0,0,0,,Қарап тұрсыз ба?
Dialogue: 0,0:09:34.28,0:09:36.03,Default,,0,0,0,,Тоқта, Нино.
Dialogue: 0,0:09:37.28,0:09:40.45,Default,,0,0,0,,Сіздің өміріңіз Дорерлер үшін емес.
Dialogue: 0,0:09:41.28,0:09:44.41,Default,,0,0,0,,Бұл маған да, Лоттаға да ұнамайды.
Dialogue: 0,0:09:47.92,0:09:49.67,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:51.09,0:09:53.50,Default,,0,0,0,,Жан, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:09:54.17,0:09:58.09,Default,,0,0,0,,Мен патша отбасының қиыншылықтарына араласуым қалыпты деп ойладым.
Dialogue: 0,0:09:59.51,0:10:03.18,Default,,0,0,0,,АССА жойылса, халық қиыншылыққа ұшырайды.
Dialogue: 0,0:10:04.52,0:10:07.14,Default,,0,0,0,,Мысал элементін алайық.
Dialogue: 0,0:10:08.98,0:10:12.27,Default,,0,0,0,,Енді патша құлады, әр сәт санаулы.
Dialogue: 0,0:10:13.36,0:10:17.03,Default,,0,0,0,,Бардонға қайтқанда ағамды қарсы алыңыз.
Dialogue: 0,0:10:18.95,0:10:20.53,Default,,0,0,0,,Мен Бардондамын ба?
Dialogue: 0,0:10:21.62,0:10:22.78,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:22.91,0:10:27.20,Default,,0,0,0,,Король маңызды ұлттық рәсімге қатысуы керек еді.
Dialogue: 0,0:10:27.33,0:10:30.21,Default,,0,0,0,,Сіз келесі патша ретінде қатысасыз, солай ма?
Dialogue: 0,0:10:31.63,0:10:32.75,Default,,0,0,0,,Бұл қандай рәсім?
Dialogue: 0,0:10:33.75,0:10:36.34,Default,,0,0,0,,ACCA-ның 100 жылдық мерейтойы
Dialogue: 0,0:10:38.55,0:10:40.59,Default,,0,0,0,,Ешқандай әңгіме немесе басқа ештеңе жоқ.
Dialogue: 0,0:10:40.80,0:10:43.18,Default,,0,0,0,,Қатысып, аяқтаған бойда кетіңіз
Dialogue: 0,0:10:43.30,0:10:44.22,Default,,0,0,0,,Бардонда
Dialogue: 0,0:10:44.35,0:10:46.81,Default,,0,0,0,,Біз сізді шынайы нанмен сыйлаймыз.
Dialogue: 0,0:10:49.35,0:10:50.73,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:11:08.45,0:11:13.17,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:17.51,0:11:20.17,Default,,0,0,0,,Мен Қарғаның сені қорғағанын естідім.
Dialogue: 0,0:11:20.76,0:11:21.76,Default,,0,0,0,,Ол?
Dialogue: 0,0:11:22.34,0:11:25.81,Default,,0,0,0,,Ол жарасы жазылмайынша Флорода қалады.
Dialogue: 0,0:11:26.39,0:11:28.77,Default,,0,0,0,,Мүмкін, егер адамның өзі қаласа.
Dialogue: 0,0:11:28.89,0:11:30.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:30.14,0:11:34.52,Default,,0,0,0,,Оның басқа да жұмысы бар сияқты, бірақ мен оған араласпаймын.
Dialogue: 0,0:11:36.82,0:11:41.57,Default,,0,0,0,,Қалай болғанда да, шешім қабылдағаныңызға қуаныштымын.
Dialogue: 0,0:11:42.66,0:11:45.03,Default,,0,0,0,,Сіз қанша темекі алдыңыз?
Dialogue: 0,0:11:45.70,0:11:47.16,Default,,0,0,0,,Мемлекеттік төңкеріске қатысу ниеті
Dialogue: 0,0:11:47.28,0:11:51.29,Default,,0,0,0,,«Келесі патшаға» темекі түрінде беру үшін таралды.
Dialogue: 0,0:11:52.92,0:11:55.63,Default,,0,0,0,,13 кітап Дорвар ауданына
Dialogue: 0,0:11:55.75,0:11:58.30,Default,,0,0,0,,Филиал менеджері Доуэрдің қалауы бойынша.
Dialogue: 0,0:11:58.42,0:12:01.59,Default,,0,0,0,,Кардинал Президенттің қатысуы күтілмейді.
Dialogue: 0,0:12:01.92,0:12:05.18,Default,,0,0,0,,Біз салтанатты күнді білмейміз.
Dialogue: 0,0:12:05.30,0:12:08.06,Default,,0,0,0,,Князьдің күзетшілерінің санын көргенше.
Dialogue: 0,0:12:09.06,0:12:10.02,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:10.22,0:12:11.52,Default,,0,0,0,,Сіздің нөміріңіз...
Dialogue: 0,0:12:11.64,0:12:15.27,Default,,0,0,0,,Сенің таққа отыруыңды бәрі осылай қалайды.
Dialogue: 0,0:12:15.40,0:12:19.19,Default,,0,0,0,,Егер бұл ханзада болмаса, мен болуым керек емес еді.
Dialogue: 0,0:12:19.65,0:12:21.28,Default,,0,0,0,,Бірақ бұл сенсің
Dialogue: 0,0:12:21.86,0:12:26.99,Default,,0,0,0,,АССА мен халықты қорғай алатын жалғыз адам.
Dialogue: 0,0:12:27.91,0:12:32.50,Default,,0,0,0,,Сәтті төңкеріс жасап, осы елдің тағына отыр.
Dialogue: 0,0:12:32.62,0:12:36.42,Default,,0,0,0,,Азаматтар бұрынғыдай өмір сүреді.
Dialogue: 0,0:12:37.75,0:12:39.67,Default,,0,0,0,,Алдымен сәттілік
Dialogue: 0,0:12:41.55,0:12:45.93,Default,,0,0,0,,Уайымдамаңыз, сізде біз бар.
Dialogue: 0,0:12:46.80,0:12:48.97,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:50.93,0:12:53.85,Default,,0,0,0,,Өте өкінішті, Лотаны жайына қалдырыңыз.
Dialogue: 0,0:12:54.31,0:12:55.69,Default,,0,0,0,,Бұл жерде ерекше ештеңе жоқ.
Dialogue: 0,0:12:56.85,0:12:59.77,Default,,0,0,0,,Сіз кенеттен мұны сұрағаныңызда таң қалдым.
Dialogue: 0,0:13:01.53,0:13:05.24,Default,,0,0,0,,Мен Flower Wow-ға барғанша, сіз Лоттаға назар аудара аласыз ба?
Dialogue: 0,0:13:05.36,0:13:06.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:07.36,0:13:08.95,Default,,0,0,0,,Мұнда ештеңе болған жоқ.
Dialogue: 0,0:13:09.95,0:13:11.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:12.29,0:13:13.70,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:14.08,0:13:14.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:15.12,0:13:17.33,Default,,0,0,0,,Сізде патша қаны бар, солай ма?
Dialogue: 0,0:13:19.46,0:13:21.63,Default,,0,0,0,,Ол сол ақымақ ханзададан үлкен.
Dialogue: 0,0:13:21.75,0:13:23.76,Default,,0,0,0,,Тақ Сіз оған отыра аласыз, солай ма?
Dialogue: 0,0:13:24.26,0:13:26.01,Default,,0,0,0,,Сіз отырғанда не істейсіз?
Dialogue: 0,0:13:26.84,0:13:28.68,Default,,0,0,0,,Әлгі ақымақтан жақсырақ шығар.
Dialogue: 0,0:13:29.55,0:13:30.51,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:13:30.64,0:13:32.22,Default,,0,0,0,,Ал, орнымызға отырайық.
Dialogue: 0,0:13:32.35,0:13:33.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.31,0:13:35.14,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.02,0:13:39.27,Default,,0,0,0,,ACCA 100 жылдық мерейтойына қатысу
Dialogue: 0,0:13:39.40,0:13:43.69,Default,,0,0,0,,Міне, Бардонда әр ауданның маңызды адамдары бірінен соң бірі жиналып жатыр.
Dialogue: 0,0:13:43.98,0:13:47.36,Default,,0,0,0,,Салтанат осы демалыс күндері Чуо округінің кеңсе алаңында өтеді...
Dialogue: 0,0:13:47.49,0:13:50.41,Default,,0,0,0,,Патша мұнда жоқ, солай ма?
Dialogue: 0,0:13:50.99,0:13:53.41,Default,,0,0,0,,Оның орнына князь Шван келеді.
Dialogue: 0,0:13:53.54,0:13:56.87,Default,,0,0,0,,Салтанат Оны жалпы жұртшылық та тамашалай алады, солай ма?
Dialogue: 0,0:13:57.67,0:13:58.67,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:13:59.67,0:14:03.13,Default,,0,0,0,,Үлкен аға, сіз қиын жүзді жасай бересіз.
Dialogue: 0,0:14:04.92,0:14:06.63,Default,,0,0,0,,Мен жай ғана шаршадым.
Dialogue: 0,0:14:07.51,0:14:09.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:09.26,0:14:10.43,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:12.26,0:14:15.10,Default,,0,0,0,,Әй, бәрі, ерте келдіңдер.
Dialogue: 0,0:14:15.22,0:14:18.23,Default,,0,0,0,,Жақын болғандықтан көп уақыт кетпей ме?
Dialogue: 0,0:14:18.39,0:14:19.73,Default,,0,0,0,,Грус бюросының қызметкері
Dialogue: 0,0:14:20.40,0:14:24.02,Default,,0,0,0,,Әлі келмегендер - мистер Варблер, Пульс және...
Dialogue: 0,0:14:24.15,0:14:25.11,Default,,0,0,0,,Адер?
Dialogue: 0,0:14:25.23,0:14:27.53,Default,,0,0,0,,Галле мен Фармас алыс.
Dialogue: 0,0:14:28.20,0:14:30.45,Default,,0,0,0,,Тәттілер көп уақытты алады.
Dialogue: 0,0:14:30.57,0:14:32.28,Default,,0,0,0,,Уа, менің шашым ұзарып барады.
Dialogue: 0,0:14:32.41,0:14:33.62,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:14:33.74,0:14:34.95,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:14:35.41,0:14:37.16,Default,,0,0,0,,Импульстік көмекші де!
Dialogue: 0,0:14:37.41,0:14:40.58,Default,,0,0,0,,Эй, Адер, мен сені күттім!
Dialogue: 0,0:14:40.92,0:14:41.96,Default,,0,0,0,,Мұнда
Dialogue: 0,0:14:43.17,0:14:44.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:44.46,0:14:47.59,Default,,0,0,0,,Адер басшының орынбасарын жақсы көреді ме?
Dialogue: 0,0:14:47.72,0:14:49.26,Default,,0,0,0,,Иә, бұл дұрыс емес...
Dialogue: 0,0:14:49.38,0:14:51.80,Default,,0,0,0,,Жарайды, енді алдауға болмайды.
Dialogue: 0,0:14:51.93,0:14:53.76,Default,,0,0,0,,Сіз мені көруге жол бойы келдіңіз.
Dialogue: 0,0:14:53.89,0:14:57.06,Default,,0,0,0,,Бұл, әрине, сол кездегі шындық.
Dialogue: 0,0:14:57.18,0:14:59.98,Default,,0,0,0,,Енді бұл...
Dialogue: 0,0:15:00.35,0:15:02.23,Default,,0,0,0,,Қыздарға махаббат әндері ұнайды.
Dialogue: 0,0:15:02.35,0:15:03.77,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:15:04.15,0:15:07.57,Default,,0,0,0,,Ех! Сіз Гурус мүшесімен кездесесіз бе?
Dialogue: 0,0:15:08.74,0:15:12.03,Default,,0,0,0,,Мм... Ол менімен әртүрлі мәселелерде кеңесетін.
Dialogue: 0,0:15:12.16,0:15:14.87,Default,,0,0,0,,Осы арада... Иә.
Dialogue: 0,0:15:14.99,0:15:15.83,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:15:15.95,0:15:18.54,Default,,0,0,0,,Бардон мен Фирмус өте алыс!
Dialogue: 0,0:15:18.70,0:15:21.83,Default,,0,0,0,,Хехе, бұрышқа қоюға болмайды, офицер Гурус.
Dialogue: 0,0:15:21.96,0:15:27.00,Default,,0,0,0,,Жоқ, посттардың келесі ауысуы бізді жақындастырады деп сенемін.
Dialogue: 0,0:15:27.13,0:15:28.46,Default,,0,0,0,,Постты ауыстыруға келгенде
Dialogue: 0,0:15:28.80,0:15:31.43,Default,,0,0,0,,Басқарушы орынбасарының орны бос болғалы тұрған жоқ па?
Dialogue: 0,0:15:31.88,0:15:34.39,Default,,0,0,0,,Содан кейін Варблер бастықтың орынбасары.
Dialogue: 0,0:15:35.05,0:15:37.93,Default,,0,0,0,,Көшбасшының да жүзінде бір қимыл бар шығар.
Dialogue: 0,0:15:38.18,0:15:39.77,Default,,0,0,0,,Төмендету және т.б.
Dialogue: 0,0:15:40.81,0:15:42.23,Default,,0,0,0,,Төңкеріс те болады.
Dialogue: 0,0:15:44.40,0:15:45.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.65,0:15:47.27,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:15:47.40,0:15:49.61,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:15:49.74,0:15:52.36,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:15:52.86,0:15:54.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:54.91,0:15:55.95,Default,,0,0,0,,Төңкеріс?
Dialogue: 0,0:15:56.08,0:15:57.99,Default,,0,0,0,,Қарашы, тәттім.
Dialogue: 0,0:15:58.12,0:16:00.41,Default,,0,0,0,,Ақпараттан бейхабар боласың.
Dialogue: 0,0:16:00.58,0:16:02.37,Default,,0,0,0,,Шалбар Бұл мүмкін емес емес пе?
Dialogue: 0,0:16:02.50,0:16:03.92,Default,,0,0,0,,Бөлім меңгерушісінің орынбасары
Dialogue: 0,0:16:04.50,0:16:08.00,Default,,0,0,0,,Олай болса, мен ең ақылдымын.
Dialogue: 0,0:16:08.13,0:16:09.17,Default,,0,0,0,,Түйін
Dialogue: 0,0:16:09.30,0:16:10.88,Default,,0,0,0,,Мемлекеттік төңкеріс нені білдіреді?
Dialogue: 0,0:16:13.97,0:16:15.68,Default,,0,0,0,,АССА төңкеріс жасады ма?
Dialogue: 0,0:16:16.51,0:16:18.89,Default,,0,0,0,,Иә Шатаспау үшін
Dialogue: 0,0:16:19.01,0:16:21.77,Default,,0,0,0,,ACCA мұны барлық аудандармен бірлесіп жасайды.
Dialogue: 0,0:16:22.02,0:16:24.65,Default,,0,0,0,,Бір минут күтіңіз, не үшін?
Dialogue: 0,0:16:24.98,0:16:28.57,Default,,0,0,0,,Бұл ACCA-ны қорғау үшін жасалған сияқты.
Dialogue: 0,0:16:29.15,0:16:33.20,Default,,0,0,0,,ханзада Шванға қарсы, ол таққа отырғаннан кейін ACCA-ны бөлшектейтінін ашық мәлімдейді.
Dialogue: 0,0:16:33.45,0:16:37.03,Default,,0,0,0,,Оның таққа отыруына жол бермеу үшін мемлекеттік төңкерісті сәтті жасады.
Dialogue: 0,0:16:38.08,0:16:41.37,Default,,0,0,0,,АССА қалса, адамдардың өмірі қорғалады.
Dialogue: 0,0:16:42.12,0:16:44.71,Default,,0,0,0,,Себеп пен атау осылай.
Dialogue: 0,0:16:45.17,0:16:48.75,Default,,0,0,0,,Олай болса, мемлекеттік төңкеріс неліктен соншалықты алыс идея?
Dialogue: 0,0:16:49.04,0:16:50.55,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,0:16:50.67,0:16:51.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:51.92,0:16:54.30,Default,,0,0,0,,Уорблер мырза, бір сәт қарсы боласыз ба?
Dialogue: 0,0:16:55.38,0:16:56.47,Default,,0,0,0,,Менеджер
Dialogue: 0,0:16:58.10,0:16:59.30,Default,,0,0,0,,Осы мәселе бойынша
Dialogue: 0,0:16:59.93,0:17:03.56,Default,,0,0,0,,5 Оны Директор мен Штаб қабылдады.
Dialogue: 0,0:17:04.31,0:17:06.77,Default,,0,0,0,,Болашақта болатын мемлекеттік төңкеріс
Dialogue: 0,0:17:06.90,0:17:11.65,Default,,0,0,0,,Содан кейін ACCA тізгінді өз қолына алып, шатасуға жол бермеуі керек.
Dialogue: 0,0:17:11.78,0:17:13.61,Default,,0,0,0,,...
Dialogue: 0,0:17:14.24,0:17:16.66,Default,,0,0,0,,Бұл болады ма? Мүмкін емес
Dialogue: 0,0:17:16.78,0:17:17.61,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:17:18.03,0:17:20.70,Default,,0,0,0,,13 палатаның әрқайсысында шағымдар болуы мүмкін.
Dialogue: 0,0:17:20.83,0:17:22.54,Default,,0,0,0,,Доуэр отбасы басқаратындықтан
Dialogue: 0,0:17:22.66,0:17:25.12,Default,,0,0,0,,Сіз артықшылықтар көбірек деп ойлауыңыз керек.
Dialogue: 0,0:17:26.54,0:17:28.21,Default,,0,0,0,,ACCA-ны бөлшектеу
Dialogue: 0,0:17:28.46,0:17:30.54,Default,,0,0,0,,Бұл ханзаданың айтқаны ғана ма?
Dialogue: 0,0:17:31.09,0:17:34.01,Default,,0,0,0,,Ақымақ болсаң да, тиран бола аласың ба?
Dialogue: 0,0:17:34.13,0:17:36.93,Default,,0,0,0,,Секи тауы кардиналдың бұйрығына бағынады.
Dialogue: 0,0:17:38.43,0:17:42.85,Default,,0,0,0,,Довар корольдік отбасы өздерінің күш-қуатының көлемін біледі.
Dialogue: 0,0:17:43.31,0:17:44.81,Default,,0,0,0,,Тиранияны таңу тым кеш
Dialogue: 0,0:17:44.93,0:17:47.98,Default,,0,0,0,,Ағымдағы жүйені бұзу үшін олар ештеңе істей алмайды.
Dialogue: 0,0:17:49.23,0:17:52.27,Default,,0,0,0,,Менің ойымша, ACCA қорғау атауы өтпейді.
Dialogue: 0,0:17:54.03,0:17:56.40,Default,,0,0,0,,Ол ешқашан жойылмайды деп айтуға болмайды.
Dialogue: 0,0:17:56.61,0:17:59.87,Default,,0,0,0,,Ал ақымақтан қорқынышты ештеңе жоқ.
Dialogue: 0,0:18:00.03,0:18:03.99,Default,,0,0,0,,Өзіңді тұншықтырып өлтіру болса да, еш ойланбастан жасайсың.
Dialogue: 0,0:18:05.54,0:18:08.79,Default,,0,0,0,,ACCA әлі де қажет.
Dialogue: 0,0:18:08.92,0:18:11.46,Default,,0,0,0,,Халықтың қалауы осы.
Dialogue: 0,0:18:11.63,0:18:13.75,Default,,0,0,0,,ACCA-ға тым көп көңіл бөлінеді
Dialogue: 0,0:18:14.30,0:18:16.01,Default,,0,0,0,,Барлығы біртүрлі.
Dialogue: 0,0:18:17.63,0:18:20.72,Default,,0,0,0,,Соңғы кездері нан алуға шықпайтын сияқтысың.
Dialogue: 0,0:18:21.30,0:18:22.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:23.51,0:18:25.52,Default,,0,0,0,,Әр ауданнан берілген темекі
Dialogue: 0,0:18:25.64,0:18:28.81,Default,,0,0,0,,Бұл мемлекеттік төңкеріске қатысу ниеті туралы мәлімдеме болған сияқты.
Dialogue: 0,0:18:29.19,0:18:31.94,Default,,0,0,0,,13 дана болған көрінеді.
Dialogue: 0,0:18:32.44,0:18:34.32,Default,,0,0,0,,5 Директор хабарлайды
Dialogue: 0,0:18:34.98,0:18:37.57,Default,,0,0,0,,Мен директор Лилиумға хабарладым.
Dialogue: 0,0:18:38.28,0:18:40.16,Default,,0,0,0,,Менің алдымда?
Dialogue: 0,0:18:42.28,0:18:44.12,Default,,0,0,0,,Не бұйырылды?
Dialogue: 0,0:18:44.41,0:18:46.25,Default,,0,0,0,,Бұйрық болды ма?
Dialogue: 0,0:18:47.33,0:18:48.16,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:49.67,0:18:51.17,Default,,0,0,0,,Есеп жеткілікті.
Dialogue: 0,0:18:52.79,0:18:54.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:56.17,0:18:57.21,Default,,0,0,0,,Отус
Dialogue: 0,0:18:58.38,0:18:59.68,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:19:00.88,0:19:01.72,Default,,0,0,0,,Иә
Dialogue: 0,0:19:02.43,0:19:04.81,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:08.68,0:19:09.56,Default,,0,0,0,,Қоян
Dialogue: 0,0:19:10.48,0:19:11.81,Default,,0,0,0,,Төңкеріс фракциясы
Dialogue: 0,0:19:11.94,0:19:15.40,Default,,0,0,0,,Сонда сіз келесі патша болуды жоспарлап отырсыз ба?
Dialogue: 0,0:19:16.86,0:19:20.20,Default,,0,0,0,,Егер бұл патшаның немерелерінің арасында болса, онда танымал емес князь Шван.
Dialogue: 0,0:19:20.32,0:19:22.20,Default,,0,0,0,,Ұлт мақтанышы АССА-ға жатады
Dialogue: 0,0:19:22.32,0:19:24.49,Default,,0,0,0,,Қош келдіңіздер
Dialogue: 0,0:19:24.91,0:19:27.70,Default,,0,0,0,,Егер кардиналдардың бүйірлік әрекеті болмаса, проблема болмайды.
Dialogue: 0,0:19:28.45,0:19:30.54,Default,,0,0,0,,Мемлекеттік төңкеріс жасауға болады ма?
Dialogue: 0,0:19:31.75,0:19:33.29,Default,,0,0,0,,Сіз мінесіз, солай ма?
Dialogue: 0,0:19:33.88,0:19:36.00,Default,,0,0,0,,Саған таққа қарамайсың ба?
Dialogue: 0,0:19:36.38,0:19:37.84,Default,,0,0,0,,Бұл ACCA үшін бе?
Dialogue: 0,0:19:38.51,0:19:40.01,Default,,0,0,0,,Бұл ақымақ сияқты емес пе?
Dialogue: 0,0:19:40.76,0:19:44.30,Default,,0,0,0,,Өйткені, мен мұны сізге қалдырғым келеді.
Dialogue: 0,0:19:45.85,0:19:48.97,Default,,0,0,0,,Бірақ, менің ойымша, әлі де біраз уақыт қалды.
Dialogue: 0,0:19:51.56,0:19:55.81,Default,,0,0,0,,Әлгі ханзада шынымен де қиналып жатыр емес пе?
Dialogue: 0,0:20:00.40,0:20:01.53,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:20:01.65,0:20:04.41,Default,,0,0,0,,Нағашы ағамды кездестірмесем болады ма?
Dialogue: 0,0:20:04.62,0:20:05.66,Default,,0,0,0,,Туыстар?
Dialogue: 0,0:20:05.78,0:20:07.37,Default,,0,0,0,,Иә, Бардоннан.
Dialogue: 0,0:20:07.49,0:20:09.24,Default,,0,0,0,,Менің немере ағам тек Дорварда.
Dialogue: 0,0:20:10.25,0:20:13.33,Default,,0,0,0,,Түсіндім, ол жақсы болды.
Dialogue: 0,0:20:13.46,0:20:14.88,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:20:15.33,0:20:18.46,Default,,0,0,0,,Мен тірімін бе, өлдім бе, бәрібір.
Dialogue: 0,0:20:18.75,0:20:20.76,Default,,0,0,0,,Оның маған қатысы жоқ!
Dialogue: 0,0:20:21.88,0:20:24.68,Default,,0,0,0,,Ханзада аздап ел қамы, ел қамы.
Dialogue: 0,0:20:24.80,0:20:27.05,Default,,0,0,0,,Сізді көбірек қызықтырғаныңыз дұрыс емес пе?
Dialogue: 0,0:20:27.18,0:20:28.01,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:20:28.14,0:20:30.27,Default,,0,0,0,,Ең болмаса отбасыңыздың көңілінен шығу
Dialogue: 0,0:20:30.39,0:20:32.52,Default,,0,0,0,,Кетемін десеңіз, жақсы.
Dialogue: 0,0:20:33.14,0:20:35.60,Default,,0,0,0,,Бұл өте пайдалы болмаса да!
Dialogue: 0,0:20:37.27,0:20:39.27,Default,,0,0,0,,Бұл сендер туралы емес.
Dialogue: 0,0:20:39.98,0:20:41.44,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:45.20,0:20:46.87,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,0:20:47.16,0:20:49.79,Default,,0,0,0,,Мен Довар патшалығының патшасымын.
Dialogue: 0,0:20:50.62,0:20:51.54,Default,,0,0,0,,Әр ауданның маңызды адамдары
Dialogue: 0,0:20:51.66,0:20:53.25,Default,,0,0,0,,Қазірдің өзінде Бардонда
Dialogue: 0,0:20:53.37,0:20:54.37,Default,,0,0,0,,Бұрынғы Дауэрден
Dialogue: 0,0:20:54.50,0:20:57.04,Default,,0,0,0,,Шван ханзада келді.
Dialogue: 0,0:20:57.25,0:20:58.38,Default,,0,0,0,,Иә, Мэгги?
Dialogue: 0,0:20:59.13,0:21:01.76,Default,,0,0,0,,Ол Доуэр отбасының SS мүшесі болды ма?
Dialogue: 0,0:21:02.55,0:21:03.88,Default,,0,0,0,,Бұл нан бала!
Dialogue: 0,0:21:04.72,0:21:08.60,Default,,0,0,0,,Довардың досы теміржол қызметкерінің айтқаны болды...
Dialogue: 0,0:21:09.93,0:21:13.93,Default,,0,0,0,,Бүгін кешке әр палатаның өкілдерімен соңғы кездесу өтеді.
Dialogue: 0,0:21:14.73,0:21:18.86,Default,,0,0,0,,Төңкеріс сәтті аяқталып, Отус келесі патша болады.
Dialogue: 0,0:21:20.11,0:21:23.86,Default,,0,0,0,,Мен ертеңгі жарқын болашақты көре аламын.
Dialogue: 0,0:21:24.86,0:21:28.24,Default,,0,0,0,,Лилийлер отбасы мұны күтті.
Dialogue: 0,0:21:32.70,0:21:34.87,Default,,0,0,0,,Сіз «Лилиум отбасы» дедіңіз
Dialogue: 0,0:21:38.08,0:21:39.17,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:21:40.42,0:21:44.13,Default,,0,0,0,,Сен де күттің, бәрі де күтті.
Dialogue: 0,0:21:44.63,0:21:45.80,Default,,0,0,0,,Мені алаңдатқаны — Кираны оның отбасы байқап қалуы мүмкін —
Dialogue: 0,0:21:46.34,0:21:47.18,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:21:47.97,0:21:49.43,Default,,0,0,0,,Өзіңіздің шынымен не ойлайтыныңызды айтыңыз
Dialogue: 0,0:21:50.89,0:21:52.51,Default,,0,0,0,,Otus тұрыңыз
Dialogue: 0,0:21:52.64,0:21:55.77,Default,,0,0,0,,Отус көш, ел көш
Dialogue: 0,0:21:56.02,0:21:57.77,Default,,0,0,0,,Барлығы түсінгенде
Dialogue: 0,0:21:57.89,0:22:00.61,Default,,0,0,0,,Елді Гүлдер басқаратын қазіргі жағдай
Dialogue: 0,0:22:00.73,0:22:03.11,Default,,0,0,0,,Оны қабылдаудан басқа амалым жоқ.
Dialogue: 0,0:22:04.07,0:22:07.28,Default,,0,0,0,,Иә, дәл қазір сіз сияқты.
Dialogue: 0,0:22:08.36,0:22:11.87,Default,,0,0,0,,Мен бұлай жалғастыра алмайтынымды білуім керек еді.
Dialogue: 0,0:22:12.03,0:22:13.95,Default,,0,0,0,,Неге қарсы тұра алмайсың?
Dialogue: 0,0:22:15.12,0:22:18.92,Default,,0,0,0,,Себебі екінші тарап Флору елінен шыққан Лилиумдар отбасы.
Dialogue: 0,0:22:23.75,0:22:26.63,Default,,0,0,0,,Сіз кеңеске қатыспайсыз ба?
Dialogue: 0,0:22:27.34,0:22:28.18,Default,,0,0,0,,О
Dialogue: 0,0:22:29.09,0:22:32.89,Default,,0,0,0,,Отус директор Лилиуммен тікелей кездескен сияқты.
Dialogue: 0,0:22:33.51,0:22:35.10,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:22:35.81,0:22:36.64,Default,,0,0,0,,Ягами
Dialogue: 0,0:22:39.64,0:22:40.98,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:22:44.15,0:22:44.98,Default,,0,0,0,,О
Dialogue: 0,0:22:46.44,0:22:52.45,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:09.28,0:24:15.28,Default,,0,0,0,,~♪
Dialogue: 0,0:24:16.74,0:24:19.74,Default,,0,0,0,,Келесі жолы «ACCA 13-ші палаталық инспекция бөлімі»
Dialogue: 0,0:24:19.87,0:24:21.29,Default,,0,0,0,,«Құстың жүрген жері»
Dialogue: 0,0:24:22.00,0:24:25.08,Default,,0,0,0,,Жақсы, қайда барсаң да.
Dialogue: 0,0:24:25.58,0:24:29.30,Default,,0,0,0,,Олай болса, маған тағы біраз уақыт қарауға рұқсат етіңіз.
Dialogue: 0,0:24:30.80,0:24:36.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory