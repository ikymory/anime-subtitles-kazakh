Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.48,0:00:33.49,Default,,0,0,0,,Корольдік отбасы мүшелері көбірек шығуы керек.
Dialogue: 0,0:00:34.28,0:00:37.99,Default,,0,0,0,,Қамалдың сыртында не болып жатқанын өз көзіңмен көрмесең, жақсы емес.
Dialogue: 0,0:00:38.53,0:00:40.58,Default,,0,0,0,,Әр ауданның есептерінің қысқаша мазмұны
Dialogue: 0,0:00:40.70,0:00:43.20,Default,,0,0,0,,Мен кардиналдардан жаңа ғана естіп жатырмын.
Dialogue: 0,0:00:43.33,0:00:46.12,Default,,0,0,0,,Жел туралы өсек естуден айырмашылығы жоқ.
Dialogue: 0,0:00:47.08,0:00:51.00,Default,,0,0,0,,Колоретте шетелде қысқа мерзімді оқудан оралғаннан кейін
Dialogue: 0,0:00:51.13,0:00:55.38,Default,,0,0,0,,Шнее-сама елге қатты қызығатын.
Dialogue: 0,0:00:56.18,0:01:00.43,Default,,0,0,0,,Ол алғашында көп нәрсеге қызығатын бала еді.
Dialogue: 0,0:01:00.60,0:01:03.14,Default,,0,0,0,,Олар келесі астана Бадонға барғысы келетін сияқты.
Dialogue: 0,0:01:03.43,0:01:08.02,Default,,0,0,0,,Қаланың озық ойлы жастарымен де байланыстасыз.
Dialogue: 0,0:01:08.61,0:01:12.32,Default,,0,0,0,,Оқылатын кітаптар Философия тарихы Саяси ой
Dialogue: 0,0:01:12.98,0:01:15.32,Default,,0,0,0,,Тоқтайтын кез келді.
Dialogue: 0,0:01:15.45,0:01:17.57,Default,,0,0,0,,Ханшайымның әрекеті - Доуэр отбасы.
Dialogue: 0,0:01:17.70,0:01:20.99,Default,,0,0,0,,Ақыры елге көлеңке түсіреді.
Dialogue: 0,0:01:21.12,0:01:23.12,Default,,0,0,0,,Торға қоршау
Dialogue: 0,0:01:24.16,0:01:26.12,Default,,0,0,0,,Өкінетін қанаты бар бала.
Dialogue: 0,0:01:39.26,0:01:42.18,Default,,0,0,0,,Бір ғана жол бар
Dialogue: 0,0:01:43.43,0:01:49.44,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:06.93,0:03:12.94,Default,,0,0,0,,~♪
Dialogue: 0,0:03:14.11,0:03:15.11,Default,,0,0,0,,
Dialogue: 0,0:03:15.36,0:03:17.23,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:19.57,0:03:21.74,Default,,0,0,0,,Маған қоңырау шалыңыз ба? Директор Кварм
Dialogue: 0,0:03:23.95,0:03:26.62,Default,,0,0,0,,Сізге, Шни-саманың қызметшісі.
Dialogue: 0,0:03:27.24,0:03:29.62,Default,,0,0,0,,Бұл бұйрық, Арбент.
Dialogue: 0,0:03:30.16,0:03:32.33,Default,,0,0,0,,Бірақ сіз бас тарта аласыз.
Dialogue: 0,0:03:33.50,0:03:36.75,Default,,0,0,0,,Бұйрық болса да бас тартуға болады.
Dialogue: 0,0:03:38.30,0:03:42.26,Default,,0,0,0,,Егер сіз ханшайымның қызметшісі ретінде қызмет етуден бас тартсаңыз, бас тартуға болады дегенді білдіреді.
Dialogue: 0,0:03:43.05,0:03:45.26,Default,,0,0,0,,Осы антқа қол қою
Dialogue: 0,0:03:45.80,0:03:48.77,Default,,0,0,0,,Оны бұзсаң, сені өлім күтіп тұр.
Dialogue: 0,0:03:49.64,0:03:51.14,Default,,0,0,0,,Мұндай тапсырма...
Dialogue: 0,0:03:51.81,0:03:53.35,Default,,0,0,0,,Мен сізден сұрайын деп едім
Dialogue: 0,0:03:54.27,0:03:56.31,Default,,0,0,0,,Екінші ханшайым, Леди Шни,
Dialogue: 0,0:03:56.44,0:03:59.28,Default,,0,0,0,,Ол Доуэр отбасынан шығарылды.
Dialogue: 0,0:03:59.40,0:04:01.90,Default,,0,0,0,,Ханшайым әлемге түседі
Dialogue: 0,0:04:02.40,0:04:06.12,Default,,0,0,0,,Шығу... Мұндай нәрсе болуы мүмкін бе?
Dialogue: 0,0:04:06.53,0:04:09.70,Default,,0,0,0,,Патшалық заңдары бойынша жария түрде мүмкін емес
Dialogue: 0,0:04:10.45,0:04:12.12,Default,,0,0,0,,Бірақ біз мұны істей аламыз.
Dialogue: 0,0:04:12.75,0:04:16.63,Default,,0,0,0,,Төрт адам болса: патша, ханшайым, мен және сен.
Dialogue: 0,0:04:17.25,0:04:18.54,Default,,0,0,0,,7 күннен кейін
Dialogue: 0,0:04:18.67,0:04:21.76,Default,,0,0,0,,Ханшайым Пеши Уордтан шетелге сапар шегеді.
Dialogue: 0,0:04:21.88,0:04:25.30,Default,,0,0,0,,Пеши аралдарын қайықпен кесіп өту
Dialogue: 0,0:04:25.43,0:04:28.26,Default,,0,0,0,,Ханшайым кішкентай қайық алғысы келеді.
Dialogue: 0,0:04:29.43,0:04:32.48,Default,,0,0,0,,Тек сіз ханшайыммен бірге мінесіз.
Dialogue: 0,0:04:33.77,0:04:36.02,Default,,0,0,0,,Кеме суға батады.
Dialogue: 0,0:04:36.85,0:04:39.40,Default,,0,0,0,,Сіз ханшайымды Бардонға апарасыз.
Dialogue: 0,0:04:40.19,0:04:41.69,Default,,0,0,0,,Бұл ханшайымға арналған ба?
Dialogue: 0,0:04:41.94,0:04:43.57,Default,,0,0,0,,Патшалық үшін
Dialogue: 0,0:04:43.74,0:04:46.45,Default,,0,0,0,,Ханшайымның бар болуы елге көлеңке түсіреді
Dialogue: 0,0:04:47.37,0:04:50.24,Default,,0,0,0,,Бірақ сіздің мотивтеріңіз кез келген нәрсе болуы мүмкін.
Dialogue: 0,0:04:50.37,0:04:53.25,Default,,0,0,0,,Сіз Шни ханшайымның қызметшісісіз.
Dialogue: 0,0:04:53.96,0:04:55.46,Default,,0,0,0,,Біз оны қабылдаймыз.
Dialogue: 0,0:04:56.33,0:04:57.46,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:04:58.50,0:05:01.30,Default,,0,0,0,,Мен сізден тағы бір сұрағым келеді.
Dialogue: 0,0:05:05.59,0:05:07.05,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:07.59,0:05:10.60,Default,,0,0,0,,Мен өзіммен бірге қызметшілерімнің бірін ала кеткім келеді.
Dialogue: 0,0:05:10.72,0:05:12.18,Default,,0,0,0,,Сіз мені кешіре аласыз ба?
Dialogue: 0,0:05:12.85,0:05:13.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:14.39,0:05:17.27,Default,,0,0,0,,Мен Доуэр отбасына ант беруге рұқсат етемін.
Dialogue: 0,0:05:17.44,0:05:20.15,Default,,0,0,0,,Менің отбасыма адал болуға ант берген адам.
Dialogue: 0,0:05:20.69,0:05:22.61,Default,,0,0,0,,Адамның отбасы бар ма?
Dialogue: 0,0:05:22.73,0:05:24.36,Default,,0,0,0,,Бір кішкентай ұлы
Dialogue: 0,0:05:24.94,0:05:26.36,Default,,0,0,0,,Оны лақтыра ма?
Dialogue: 0,0:05:27.49,0:05:29.07,Default,,0,0,0,,Мен оны лақтырамын
Dialogue: 0,0:05:31.78,0:05:35.62,Default,,0,0,0,,Біз патшаға қызмет етуіміз керек.
Dialogue: 0,0:05:40.25,0:05:41.63,Default,,0,0,0,,Біз бірге боламыз.
Dialogue: 0,0:05:42.21,0:05:43.71,Default,,0,0,0,,Мен сені осылай айтты деп ойладым.
Dialogue: 0,0:05:43.84,0:05:46.47,Default,,0,0,0,,Кардинал президенттен рұқсат алынды.
Dialogue: 0,0:05:47.59,0:05:49.89,Default,,0,0,0,,Менің Дорварға қайтып баруға мүмкіндігім жоқ.
Dialogue: 0,0:05:50.01,0:05:52.56,Default,,0,0,0,,Бәрінен бас тарту керек
Dialogue: 0,0:05:54.18,0:05:55.60,Default,,0,0,0,,Оны лақтырыңыз
Dialogue: 0,0:05:55.93,0:05:58.19,Default,,0,0,0,,Патша Иеміз үшін
Dialogue: 0,0:05:58.31,0:06:02.23,Default,,0,0,0,,Күйеуі өз орнын және үйін тастап, далаға шыға алады.
Dialogue: 0,0:06:03.23,0:06:07.11,Default,,0,0,0,,Мен де тек Саған мойынсұнып әрекет етемін, Ием.
Dialogue: 0,0:06:08.78,0:06:10.36,Default,,0,0,0,,Сіз де дайындалыңыз.
Dialogue: 0,0:06:11.12,0:06:12.41,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:06:12.53,0:06:15.70,Default,,0,0,0,,Хонигштрассеге шығуға болады ма?
Dialogue: 0,0:06:17.29,0:06:20.37,Default,,0,0,0,,Мен саған торт бергім келеді.
Dialogue: 0,0:06:21.08,0:06:23.88,Default,,0,0,0,,Соңында сол баланың жақсы көретін алма торты.
Dialogue: 0,0:06:25.55,0:06:27.63,Default,,0,0,0,,Сіз оны шынымен қалдыра аласыз ба?
Dialogue: 0,0:06:28.51,0:06:32.47,Default,,0,0,0,,Менің алыстағы туысым бар, ыңғайсыздық тудырмайды.
Dialogue: 0,0:06:32.85,0:06:35.01,Default,,0,0,0,,Ата-анасыз бақытсыз болу мүмкін.
Dialogue: 0,0:06:35.14,0:06:36.27,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:06:38.81,0:06:40.14,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:06:40.73,0:06:42.15,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:45.65,0:06:46.61,Default,,0,0,0,,Ах
Dialogue: 0,0:06:48.44,0:06:49.99,Default,,0,0,0,,Сіз тыңдаңыз...
Dialogue: 0,0:06:50.40,0:06:52.70,Default,,0,0,0,,Тортты жесем жоғалып кете ме?
Dialogue: 0,0:06:56.79,0:06:57.75,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:59.87,0:07:01.58,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:07:02.63,0:07:04.38,Default,,0,0,0,,Король үшін
Dialogue: 0,0:07:05.80,0:07:08.84,Default,,0,0,0,,Алма тортын бірге жейміз.
Dialogue: 0,0:07:09.17,0:07:10.59,Default,,0,0,0,,Ұшу алдында
Dialogue: 0,0:07:16.31,0:07:19.27,Default,,0,0,0,,Енді өз көзіммен сыртқа қарай алмасам
Dialogue: 0,0:07:19.39,0:07:22.77,Default,,0,0,0,,Мен Дорвердің үйін тастап кетсем, бәрібір деп ойладым.
Dialogue: 0,0:07:23.65,0:07:25.57,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:07:25.86,0:07:28.15,Default,,0,0,0,,Маған сыртқа ұшуға рұқсат бергеніңіз үшін
Dialogue: 0,0:07:29.28,0:07:31.15,Default,,0,0,0,,Сыртта қатал, солай емес пе?
Dialogue: 0,0:07:31.53,0:07:33.07,Default,,0,0,0,,Сондықтан мен барамын!
Dialogue: 0,0:07:35.99,0:07:38.91,Default,,0,0,0,,Мен бұл патшалықты жойғым келмейді.
Dialogue: 0,0:07:39.04,0:07:43.17,Default,,0,0,0,,Бұл елде тұрақты бейбітшілік болуы үшін не қажет?
Dialogue: 0,0:07:43.37,0:07:45.29,Default,,0,0,0,,Өзіңіз сезіну арқылы үйреніңіз
Dialogue: 0,0:07:45.88,0:07:49.26,Default,,0,0,0,,Доуэр отбасының мүшесі емес, азамат ретінде.
Dialogue: 0,0:07:49.55,0:07:53.30,Default,,0,0,0,,Әкеге көмектесетін күн келеді деп үміттенемін.
Dialogue: 0,0:07:57.97,0:08:00.22,Default,,0,0,0,,Кварм әке үшін жақсы емес.
Dialogue: 0,0:08:00.35,0:08:02.31,Default,,0,0,0,,Мен ешқашан кеңес берген емеспін
Dialogue: 0,0:08:02.60,0:08:05.40,Default,,0,0,0,,Бұл сіз үшін ең маңыздысы болуы керек, әке.
Dialogue: 0,0:08:07.77,0:08:10.49,Default,,0,0,0,,Әбендті тарту қиын...
Dialogue: 0,0:08:12.86,0:08:16.53,Default,,0,0,0,,Әркім нұсқалардың ішінен өзі шешім қабылдады.
Dialogue: 0,0:08:16.66,0:08:18.78,Default,,0,0,0,,Міне, Шни.
Dialogue: 0,0:08:22.71,0:08:26.75,Default,,0,0,0,,Мазасыздық болса да, өкінбеу керек.
Dialogue: 0,0:08:31.80,0:08:34.47,Default,,0,0,0,,Шни ханшайым мінген қайық суға батып кетті!
Dialogue: 0,0:08:34.59,0:08:36.30,Default,,0,0,0,,Ешқандай кеме көрінбейді
Dialogue: 0,0:08:36.64,0:08:39.97,Default,,0,0,0,,Мен саған осындай үлкен кемемен жүруге кеңес бердім.
Dialogue: 0,0:08:40.10,0:08:42.85,Default,,0,0,0,,Теңіз түбіне батып кетті...
Dialogue: 0,0:08:50.32,0:08:51.15,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:08:51.28,0:08:52.11,Default,,0,0,0,,Парик
Dialogue: 0,0:08:54.61,0:08:56.11,Default,,0,0,0,,Сен де қалпақ кию керек.
Dialogue: 0,0:08:57.99,0:09:01.29,Default,,0,0,0,,Сіздің шашыңыз менікінен де ерекше көрінеді.
Dialogue: 0,0:09:03.41,0:09:04.50,Default,,0,0,0,,Абенд
Dialogue: 0,0:09:07.88,0:09:10.04,Default,,0,0,0,,Енді Бардонға
Dialogue: 0,0:09:24.31,0:09:26.35,Default,,0,0,0,,Менің багажымды алып кетіңізші.
Dialogue: 0,0:09:28.23,0:09:31.02,Default,,0,0,0,,Әбенд, бас киіміңді шеш.
Dialogue: 0,0:09:35.28,0:09:38.28,Default,,0,0,0,,Мен үшін бірдеңе істеуді ойламаңыз.
Dialogue: 0,0:09:38.41,0:09:40.45,Default,,0,0,0,,Өз өміріңді сүр
Dialogue: 0,0:09:41.41,0:09:44.91,Default,,0,0,0,,Мен бұл ақ шашты енді ешқашан көрмеймін
Dialogue: 0,0:09:46.16,0:09:48.83,Default,,0,0,0,,Сен ана жаққа, мен мына жаққа барамын.
Dialogue: 0,0:09:48.96,0:09:51.29,Default,,0,0,0,,Алысқа немесе артқа қарамаңыз
Dialogue: 0,0:09:51.92,0:09:54.92,Default,,0,0,0,,Рахмет Әбенд
Dialogue: 0,0:09:55.72,0:09:56.80,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:10:09.10,0:10:10.61,Default,,0,0,0,,Ханшайымға арналған
Dialogue: 0,0:10:18.11,0:10:21.16,Default,,0,0,0,,Шни ханшайым нанға ессіз.
Dialogue: 0,0:10:21.28,0:10:22.91,Default,,0,0,0,,Әкем де ақ нан алмақшы.
Dialogue: 0,0:10:23.20,0:10:24.16,Default,,0,0,0,,Міне, Бардонда
Dialogue: 0,0:10:24.29,0:10:26.79,Default,,0,0,0,,Шоколадты кәмпиттердің көптігі мені қатты таң қалдырады.
Dialogue: 0,0:10:27.46,0:10:28.58,Default,,0,0,0,,Мен бүгін немен таныстым
Dialogue: 0,0:10:28.71,0:10:32.25,Default,,0,0,0,,Шоколадпен қапталған күріш тортынан жасалған жұмбақ кондитерлік өнім.
Dialogue: 0,0:10:32.38,0:10:33.79,Default,,0,0,0,,Онда не бар сенікі.
Dialogue: 0,0:10:33.92,0:10:35.05,Default,,0,0,0,,Ниноны жеңіз
Dialogue: 0,0:10:35.34,0:10:36.21,Default,,0,0,0,,Нино
Dialogue: 0,0:10:36.34,0:10:37.67,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:10:38.42,0:10:40.13,Default,,0,0,0,,Күтілгендей, аты...
Dialogue: 0,0:10:40.26,0:10:42.55,Default,,0,0,0,,Бірақ мен Довар есімімнен бас тарттым.
Dialogue: 0,0:10:43.60,0:10:47.89,Default,,0,0,0,,Ханшайымның келбетін патшаға жеткізу құрметті рөл.
Dialogue: 0,0:10:52.69,0:10:56.48,Default,,0,0,0,,Ханшайым нан сататын дүкенде танысқан жас жігітке ғашық болып қалады.
Dialogue: 0,0:10:56.61,0:10:59.61,Default,,0,0,0,,Бірақ ол кедей жігіт.
Dialogue: 0,0:11:02.16,0:11:04.53,Default,,0,0,0,,Күйеуіңіз көшеді.
Dialogue: 0,0:11:04.91,0:11:06.95,Default,,0,0,0,,Жас жігіт жұмысқа орналасты
Dialogue: 0,0:11:07.24,0:11:08.70,Default,,0,0,0,,Күйеуі өз ақшасын салады
Dialogue: 0,0:11:08.83,0:11:11.37,Default,,0,0,0,,Қаланың қақ ортасынан пәтер салуға болады.
Dialogue: 0,0:11:11.62,0:11:13.88,Default,,0,0,0,,Мені сонда қараушы етіп тағайындады.
Dialogue: 0,0:11:14.38,0:11:17.63,Default,,0,0,0,,Жігіт кенеттен келген бақытқа қуанып кетті!
Dialogue: 0,0:11:22.51,0:11:24.89,Default,,0,0,0,,Ханшайым мұны аздап сезінуі мүмкін.
Dialogue: 0,0:11:29.85,0:11:31.64,Default,,0,0,0,,Ханзада мен ханшайым, қайсысы?
Dialogue: 0,0:11:36.40,0:11:37.40,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:11:37.53,0:11:39.19,Default,,0,0,0,,Сэндвич үшін рахмет
Dialogue: 0,0:11:39.32,0:11:41.20,Default,,0,0,0,,Кеш болады, алдымен демалу керек.
Dialogue: 0,0:11:41.32,0:11:42.15,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:45.66,0:11:47.12,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:11:47.24,0:11:51.37,Default,,0,0,0,,Фотосуреттерді тез дайындап, есеппен бірге жіберемін.
Dialogue: 0,0:12:06.64,0:12:09.52,Default,,0,0,0,,Салмақ бойынша сатылатын шоколад дүкендері дәмді.
Dialogue: 0,0:12:10.93,0:12:12.81,Default,,0,0,0,,Бұл Кита Уордтағы дүкен емес пе?
Dialogue: 0,0:12:12.94,0:12:14.23,Default,,0,0,0,,Сіз барлық жолмен жүрдіңіз бе?
Dialogue: 0,0:12:14.69,0:12:16.77,Default,,0,0,0,,Мен оны кездейсоқ таптым.
Dialogue: 0,0:12:20.32,0:12:22.15,Default,,0,0,0,,Сіз оны күйеуіңізге жібердіңіз бе?
Dialogue: 0,0:12:22.28,0:12:23.11,Default,,0,0,0,,Күндізгі рейспен
Dialogue: 0,0:12:25.20,0:12:29.45,Default,,0,0,0,,Фотосуреттер, бірақ мен есеп беруде жақсы емеспін, әке.
Dialogue: 0,0:12:30.16,0:12:33.29,Default,,0,0,0,,Біртүрлі, өйткені мен оны әңгіме сияқты жазуға тырысамын.
Dialogue: 0,0:12:33.71,0:12:38.00,Default,,0,0,0,,Бұл сізді көбірек бақытты етеді деп ойламайсыз ба? Король де
Dialogue: 0,0:12:38.63,0:12:42.92,Default,,0,0,0,,Патша риза болса, кардинал да риза болады.
Dialogue: 0,0:12:43.09,0:12:46.22,Default,,0,0,0,,Олай болса, күйеуің де бақытты болады.
Dialogue: 0,0:12:46.34,0:12:48.72,Default,,0,0,0,,Бұл біздің қуанышымызға айналады дегенді білдіреді.
Dialogue: 0,0:12:49.60,0:12:51.14,Default,,0,0,0,,Бұл дәмді шоколад!
Dialogue: 0,0:12:51.27,0:12:52.10,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:12:53.73,0:12:55.90,Default,,0,0,0,,Сенің осында болғаныңа қуаныштымын
Dialogue: 0,0:12:56.85,0:13:00.23,Default,,0,0,0,,Сол кезде күйеуіңіз сізге еріп жүруге рұқсат берді.
Dialogue: 0,0:13:00.36,0:13:01.19,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:13:02.28,0:13:04.53,Default,,0,0,0,,Әкең сені тастап кетпек болды.
Dialogue: 0,0:13:04.65,0:13:07.95,Default,,0,0,0,,Сіз мені кінәламай, менімен жиі келетінсіз.
Dialogue: 0,0:13:08.53,0:13:10.16,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:13:10.28,0:13:13.45,Default,,0,0,0,,Күйеуіме қызмет ету әкемнің міндеті еді.
Dialogue: 0,0:13:14.16,0:13:16.25,Default,,0,0,0,,Басқаша айтқанда, бұл менің де міндетім.
Dialogue: 0,0:13:18.00,0:13:19.00,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:13:19.59,0:13:21.88,Default,,0,0,0,,Жылау - бұл асыра сілтеу.
Dialogue: 0,0:13:22.00,0:13:22.96,Default,,0,0,0,,Иә
Dialogue: 0,0:13:23.09,0:13:25.88,Default,,0,0,0,,Сіз болмасаңыз не болар еді, әке?
Dialogue: 0,0:13:26.63,0:13:28.14,Default,,0,0,0,,Сіздің күйеуіңіз жалғыз.
Dialogue: 0,0:13:29.14,0:13:32.93,Default,,0,0,0,,Күйеуіңіз таңдаған жол ғой, әке.
Dialogue: 0,0:13:45.24,0:13:47.95,Default,,0,0,0,,Нино, бүгін ханзада қалай болды?
Dialogue: 0,0:13:48.53,0:13:50.37,Default,,0,0,0,,Біз саябақта ойнадық.
Dialogue: 0,0:13:50.49,0:13:53.58,Default,,0,0,0,,Шни ханшайымы ше? Нан сабағының күні ме?
Dialogue: 0,0:13:54.45,0:13:57.21,Default,,0,0,0,,Мен қатыса бастағаныма бір ай болды.
Dialogue: 0,0:13:57.54,0:14:00.13,Default,,0,0,0,,Бүгін қолыма таудай нан ұстап отырдым.
Dialogue: 0,0:14:00.25,0:14:01.96,Default,,0,0,0,,Ол қайтып келді.
Dialogue: 0,0:14:02.34,0:14:05.13,Default,,0,0,0,,Ханзада да риза болады.
Dialogue: 0,0:14:05.26,0:14:07.17,Default,,0,0,0,,Бұл қандай нан?
Dialogue: 0,0:14:07.88,0:14:09.51,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:14:10.05,0:14:12.51,Default,,0,0,0,,«Ханзада» туралы не деуге болады? әке
Dialogue: 0,0:14:12.68,0:14:13.76,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:14:13.89,0:14:16.52,Default,,0,0,0,,Олай болса біз «ханшайым» туралы бірдеңе жасауымыз керек.
Dialogue: 0,0:14:17.64,0:14:20.15,Default,,0,0,0,,«Ханшайым» өйткені ол ханшайым сияқты әдемі әйел.
Dialogue: 0,0:14:20.27,0:14:22.52,Default,,0,0,0,,«Ханзада» себебі ол ханзададай әдемі бала
Dialogue: 0,0:14:23.11,0:14:24.40,Default,,0,0,0,,Сонымен... бұл қалай?
Dialogue: 0,0:14:25.40,0:14:26.74,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:14:27.40,0:14:29.28,Default,,0,0,0,,Ханшайымнан ханшайым туады!
Dialogue: 0,0:14:30.45,0:14:31.70,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:14:33.49,0:14:36.41,Default,,0,0,0,,«Шни-сама» мен «жас ханым» жақсы, солай ма?
Dialogue: 0,0:14:36.79,0:14:37.75,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:39.08,0:14:41.13,Default,,0,0,0,,Ханзада «ханзада» Нино
Dialogue: 0,0:14:42.79,0:14:45.63,Default,,0,0,0,,Довар отбасында ханзада дүниеге келді.
Dialogue: 0,0:14:45.75,0:14:47.17,Default,,0,0,0,,Бұл ондаған жылдар бойы жалғасып келеді.
Dialogue: 0,0:14:48.01,0:14:51.26,Default,,0,0,0,,Кіші ханшайым бірнеше жыл бұрын ұлды болды.
Dialogue: 0,0:14:51.59,0:14:53.55,Default,,0,0,0,,Ол келесі патша
Dialogue: 0,0:14:54.31,0:14:57.22,Default,,0,0,0,,Менің ханзадам он жас үлкен.
Dialogue: 0,0:14:58.48,0:15:00.85,Default,,0,0,0,,Доуэр отбасы енді...
Dialogue: 0,0:15:00.98,0:15:01.81,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.86,0:15:03.90,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:04.02,0:15:04.86,Default,,0,0,0,,Нино!
Dialogue: 0,0:15:05.44,0:15:06.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.82,0:15:09.90,Default,,0,0,0,,Менің ханзадам ақыры мектеп оқушысы болады!
Dialogue: 0,0:15:10.61,0:15:11.45,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.57,0:15:14.12,Default,,0,0,0,,Мен сізге ресми түрде тапсырма беремін.
Dialogue: 0,0:15:16.54,0:15:18.29,Default,,0,0,0,,Сол орта мектепке барыңыз
Dialogue: 0,0:15:18.45,0:15:19.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.41,0:15:21.17,Default,,0,0,0,,Мен сені жаныңда қорғаймын.
Dialogue: 0,0:15:21.83,0:15:23.33,Default,,0,0,0,,Үйірменің қызметі - фотосурет үйірмесі.
Dialogue: 0,0:15:23.46,0:15:25.63,Default,,0,0,0,,Жақын қашықтықта суретке түсіріңіз.
Dialogue: 0,0:15:25.75,0:15:27.63,Default,,0,0,0,,Патша да риза болады.
Dialogue: 0,0:15:27.76,0:15:28.59,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:28.71,0:15:31.18,Default,,0,0,0,,Менің фотомды күтіңіз.
Dialogue: 0,0:15:31.30,0:15:33.30,Default,,0,0,0,,Мен де сіздің фотоларыңызды күтемін.
Dialogue: 0,0:15:34.18,0:15:35.97,Default,,0,0,0,,Екеуміз жақсы дос болып, үйіме шақырдық.
Dialogue: 0,0:15:36.10,0:15:39.43,Default,,0,0,0,,Мерекеге Шни-саманың үй нанын алсаңыз жақсы болар еді.
Dialogue: 0,0:15:39.56,0:15:42.31,Default,,0,0,0,,Біз сізден дәмнен алған әсерлеріңіз туралы есеп беруіңізді сұраймыз.
Dialogue: 0,0:15:42.90,0:15:44.94,Default,,0,0,0,,Мен биыл 25 жастамын...
Dialogue: 0,0:15:45.06,0:15:48.32,Default,,0,0,0,,Көзілдірік! Көзімді жасырсам, жасыра аламын
Dialogue: 0,0:15:49.53,0:15:52.15,Default,,0,0,0,,Бұл менің күйеуімнен сізге.
Dialogue: 0,0:15:57.33,0:15:58.16,Default,,0,0,0,,Бұл камера.
Dialogue: 0,0:15:59.24,0:16:01.21,Default,,0,0,0,,Көзілдірік менің әкемдікі.
Dialogue: 0,0:16:21.27,0:16:22.35,Default,,0,0,0,,Мен Ниномын
Dialogue: 0,0:16:22.94,0:16:24.98,Default,,0,0,0,,Құрметпен, Джин
Dialogue: 0,0:16:27.73,0:16:28.57,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:34.95,0:16:35.95,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:42.96,0:16:43.96,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:08.81,0:17:09.81,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:12.32,0:17:15.45,Default,,0,0,0,,«Ханзада да нанды жақсы көреді».
Dialogue: 0,0:17:17.03,0:17:20.58,Default,,0,0,0,,Жас ханым ше? Сізге нан ұнайды ма?
Dialogue: 0,0:17:29.54,0:17:30.46,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:17:33.88,0:17:35.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:41.51,0:17:42.35,Default,,0,0,0,,Ах
Dialogue: 0,0:17:43.18,0:17:44.48,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:17:51.90,0:17:52.73,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:58.66,0:17:59.74,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:00.16,0:18:01.37,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:18:01.49,0:18:02.41,Default,,0,0,0,,Құрметті Жан
Dialogue: 0,0:18:02.53,0:18:04.91,Default,,0,0,0,,Отас отбасының үйінде қандай болды?
Dialogue: 0,0:18:06.04,0:18:06.87,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:18:07.00,0:18:10.29,Default,,0,0,0,,Иә? Жақсы иіс шығады.
Dialogue: 0,0:18:10.42,0:18:11.25,Default,,0,0,0,,Иә
Dialogue: 0,0:18:15.42,0:18:17.01,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:18.38,0:18:21.76,Default,,0,0,0,,Егер сіз оны супер-экспресс арқылы жіберсеңіз, бәрі жақсы болады.
Dialogue: 0,0:18:22.14,0:18:23.10,Default,,0,0,0,,Бұл жаз емес
Dialogue: 0,0:18:23.22,0:18:24.06,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:18:25.31,0:18:27.68,Default,,0,0,0,,Керексіз іс істесем ұрыса ма?
Dialogue: 0,0:18:28.35,0:18:30.69,Default,,0,0,0,,Бетпе-бет кездеспесек, қорқынышты емес.
Dialogue: 0,0:18:31.06,0:18:32.36,Default,,0,0,0,,That's right.
Dialogue: 0,0:18:32.69,0:18:36.19,Default,,0,0,0,,Өйткені, нанның дәмін күйеуіңізге хабарлау керек.
Dialogue: 0,0:18:37.36,0:18:40.20,Default,,0,0,0,,Шни-сама онымен ненің дәмі жақсы дейді?
Dialogue: 0,0:18:40.32,0:18:41.99,Default,,0,0,0,,Көп сары май
Dialogue: 0,0:18:42.74,0:18:45.66,Default,,0,0,0,,«Көп сары май»
Dialogue: 0,0:18:50.83,0:18:54.63,Default,,0,0,0,,Бұл қайғылы оқиға жергілікті уақыт бойынша таңғы сағат 8:18-де болды.
Dialogue: 0,0:18:54.84,0:18:56.71,Default,,0,0,0,,Pesci және Rocks палаталарының шекарасында орын алды.
Dialogue: 0,0:18:57.55,0:19:00.68,Default,,0,0,0,,Орталық кеңес шұғыл мәжіліс шақырып, мәлімдеме жасады.
Dialogue: 0,0:19:00.80,0:19:02.72,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:19:04.01,0:19:04.85,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.97,0:19:06.64,Default,,0,0,0,,Жаңалықты көрдіңіз бе?
Dialogue: 0,0:19:06.81,0:19:07.93,Default,,0,0,0,,Қарау
Dialogue: 0,0:19:08.10,0:19:10.06,Default,,0,0,0,,Шни-сама мен күйеуіңіз ше?
Dialogue: 0,0:19:10.52,0:19:13.23,Default,,0,0,0,,Ол отырған көлік жағалауға құлады.
Dialogue: 0,0:19:13.69,0:19:16.36,Default,,0,0,0,,Бұған сенің әкең де қатысы бар шығар.
Dialogue: 0,0:19:17.86,0:19:19.95,Default,,0,0,0,,Содан кейін ол туралы.
Dialogue: 0,0:19:20.11,0:19:21.70,Default,,0,0,0,,Доуэр тұқымдасы немен байланысты?
Dialogue: 0,0:19:21.82,0:19:23.99,Default,,0,0,0,,Олар оны басқа адамдарға жетпейтіндей етіп тастаған болар еді.
Dialogue: 0,0:19:24.87,0:19:27.24,Default,,0,0,0,,Қазір жартастарға барыңыз.
Dialogue: 0,0:19:27.62,0:19:30.87,Default,,0,0,0,,Әкемнің қалдырғанын алып қайт.
Dialogue: 0,0:19:33.33,0:19:34.88,Default,,0,0,0,,Осы күнге
Dialogue: 0,0:19:35.13,0:19:39.26,Default,,0,0,0,,Әкем мені алып кетуге рұқсат берді, солай ма?
Dialogue: 0,0:19:40.13,0:19:44.60,Default,,0,0,0,,Менің есіктің сыртында екенімді сол кезде білдің.
Dialogue: 0,0:19:46.76,0:19:48.39,Default,,0,0,0,,Мен патшаны жақтаймын
Dialogue: 0,0:19:48.52,0:19:51.52,Default,,0,0,0,,Мен сенімен әрекет еткен жоқпын.
Dialogue: 0,0:19:52.19,0:19:53.60,Default,,0,0,0,,Бұл менің әкеме арналған, солай ма?
Dialogue: 0,0:19:54.10,0:19:55.02,Default,,0,0,0,,Иә
Dialogue: 0,0:19:55.77,0:19:58.11,Default,,0,0,0,,Яғни, өз мүддесі үшін.
Dialogue: 0,0:19:59.65,0:20:01.45,Default,,0,0,0,,Сіз де солай.
Dialogue: 0,0:20:01.99,0:20:05.70,Default,,0,0,0,,Король үшін емес, кардинал үшін емес.
Dialogue: 0,0:20:05.91,0:20:07.74,Default,,0,0,0,,Шни ханшайымы үшін
Dialogue: 0,0:20:08.54,0:20:11.79,Default,,0,0,0,,Өйткені ханшайымның қуанышы сенің қуанышың болады.
Dialogue: 0,0:20:36.44,0:20:38.44,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:20:39.07,0:20:41.69,Default,,0,0,0,,Нақты хабарлау керек нәрсе
Dialogue: 0,0:20:42.49,0:20:45.78,Default,,0,0,0,,Мастер Шни Довар отбасынан шығарылды.
Dialogue: 0,0:20:45.91,0:20:48.45,Default,,0,0,0,,Бұл сіздің тақты мұрагер болуға құқығыңыз жоқ дегенді білдіреді.
Dialogue: 0,0:20:49.53,0:20:50.95,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:20:52.58,0:20:53.46,Default,,0,0,0,,Ол кезде сіз
Dialogue: 0,0:20:54.21,0:20:57.29,Default,,0,0,0,,Ата-анамнан айырылып, көңілімді көтердің.
Dialogue: 0,0:21:00.50,0:21:02.80,Default,,0,0,0,,Сенің қарындасың бар, солай ма?
Dialogue: 0,0:21:02.92,0:21:05.22,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған қоңырау шалыңыз.
Dialogue: 0,0:21:05.55,0:21:07.84,Default,,0,0,0,,Мен саған қарағанда тамақ жасауда жақсымын.
Dialogue: 0,0:21:13.68,0:21:16.69,Default,,0,0,0,,Бауырлар мен апаларыңа қамқор боламын деп шештім.
Dialogue: 0,0:21:16.98,0:21:18.44,Default,,0,0,0,,Менің бастығым да, мен де
Dialogue: 0,0:21:20.02,0:21:21.69,Default,,0,0,0,,Сізді қарауды қаламайтын шығарсыз.
Dialogue: 0,0:21:22.44,0:21:25.99,Default,,0,0,0,,Патша тірі болғанша, бұл туралы ештеңе істей алмаймын деп ойлаңыз.
Dialogue: 0,0:21:27.66,0:21:30.66,Default,,0,0,0,,Мен енді назар аударатын қателіктер жасамаймын.
Dialogue: 0,0:21:39.21,0:21:41.55,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:41.71,0:21:42.59,Default,,0,0,0,,Кейде жергілікті тұрғынды пайдаланған ыңғайлы.
Dialogue: 0,0:21:43.80,0:21:45.09,Default,,0,0,0,,Сіз осыншама сатып алдыңыз ба?
Dialogue: 0,0:21:45.47,0:21:46.72,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:21:48.55,0:21:50.22,Default,,0,0,0,,Мен мұны бөлісе аламын ба?
Dialogue: 0,0:21:50.72,0:21:51.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.93,0:21:52.89,Default,,0,0,0,,Нино
Dialogue: 0,0:21:53.43,0:21:54.64,Default,,0,0,0,,О
Dialogue: 0,0:21:55.77,0:21:58.60,Default,,0,0,0,,Ол біраз уақытқа келмеуі мүмкін.
Dialogue: 0,0:21:59.06,0:22:00.06,Default,,0,0,0,,Сіз бос емессіз бе?
Dialogue: 0,0:22:01.15,0:22:01.98,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:22:04.57,0:22:06.15,Default,,0,0,0,,Менің ойымша, бұл солай.
Dialogue: 0,0:22:06.61,0:22:07.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:08.11,0:22:09.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:09.61,0:22:13.24,Default,,0,0,0,,Мен менеджермен жаңа жылдық торт үшін алғыс айту үшін кафеге бардым.
Dialogue: 0,0:22:13.66,0:22:15.45,Default,,0,0,0,,Мен тағы бір торт алдым.
Dialogue: 0,0:22:17.87,0:22:20.13,Default,,0,0,0,,Сіз анаңызға ұқсай бастадыңыз.
Dialogue: 0,0:22:20.96,0:22:23.30,Default,,0,0,0,,Бала кезімізде ұқсас болған шығармыз.
Dialogue: 0,0:22:23.63,0:22:24.46,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:22:28.97,0:22:30.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:30.34,0:22:32.97,Default,,0,0,0,,Менде анамның кішкентай кезіндегі суреті жоқ.
Dialogue: 0,0:22:35.02,0:22:35.93,Default,,0,0,0,,Эй
Dialogue: 0,0:22:36.48,0:22:37.98,Default,,0,0,0,,Мұны сенің ағаң да жейді, солай ма?
Dialogue: 0,0:22:43.36,0:22:45.03,Default,,0,0,0,,Алма торты
Dialogue: 0,0:22:46.44,0:22:52.45,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:09.28,0:24:15.28,Default,,0,0,0,,~♪
Dialogue: 0,0:24:16.99,0:24:19.58,Default,,0,0,0,,Келесі жолы «ACCA 13-ші палаталық инспекция бөлімі»
Dialogue: 0,0:24:19.70,0:24:22.12,Default,,0,0,0,,«Азу тістерін ашқан сымбатты қара жылан»
Dialogue: 0,0:24:22.29,0:24:23.87,Default,,0,0,0,,Уайымдаудың шегі жоқ
Dialogue: 0,0:24:24.00,0:24:26.50,Default,,0,0,0,,Бірақ... Мен бұл екеуінің жақсы болатынына сенімдімін.
Dialogue: 0,0:24:26.63,0:24:27.46,Default,,0,0,0,,Аа...
Dialogue: 0,0:24:27.59,0:24:30.80,Default,,0,0,0,,Біздің ханзада үлкен адам болды, әке.
Dialogue: 0,0:24:32.30,0:24:38.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory