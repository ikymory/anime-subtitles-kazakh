Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.27,0:00:25.65,Default,,0,0,0,,Мен шай дайындаймын.
Dialogue: 0,0:00:26.31,0:00:28.06,Default,,0,0,0,,Тыныс алыңыз.
Dialogue: 0,0:00:28.19,0:00:29.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:29.65,0:00:30.69,Default,,0,0,0,,Темекі алғыңыз келе ме?
Dialogue: 0,0:00:30.82,0:00:32.69,Default,,0,0,0,,Бөлмеде
Dialogue: 0,0:00:32.86,0:00:34.32,Default,,0,0,0,,Довар халқы сені көрмесін.
Dialogue: 0,0:00:34.49,0:00:35.32,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:35.61,0:00:36.61,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,0:00:38.07,0:00:39.83,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:00:40.91,0:00:43.33,Default,,0,0,0,,Бұл мен Галле Уордта естігенім.
Dialogue: 0,0:00:43.46,0:00:46.62,Default,,0,0,0,,Бұл мемлекеттік төңкеріс туралы хабардың ауданға тарап жатқанын білдіреді.
Dialogue: 0,0:00:47.04,0:00:51.34,Default,,0,0,0,,Мен төңкеріс фракциясының арасындағы көпір ретінде ел аралап жүрмін.
Dialogue: 0,0:00:52.42,0:00:56.22,Default,,0,0,0,,Сіз жай ғана жағдайды бақылап отырсыз ба? Палаталардың ешқайсысында қозғалыс аз.
Dialogue: 0,0:00:57.72,0:01:00.39,Default,,0,0,0,,Қазір жағдай қалай?
Dialogue: 0,0:01:01.47,0:01:03.56,Default,,0,0,0,,Мен бүкіл ауданның жоғарғы эшелонынанмын.
Dialogue: 0,0:01:03.68,0:01:06.77,Default,,0,0,0,,Төңкеріс фракциясының мүшесі деп танылды
Dialogue: 0,0:01:06.90,0:01:07.85,Default,,0,0,0,,Директор Гросслер
Dialogue: 0,0:01:07.98,0:01:10.57,Default,,0,0,0,,Олар мені төңкерісші деп ойлап, мені бақылап отыр.
Dialogue: 0,0:01:10.69,0:01:13.44,Default,,0,0,0,,...бірақ кейбір күмәндар бар
Dialogue: 0,0:01:13.57,0:01:14.40,Default,,0,0,0,,Иә
Dialogue: 0,0:01:15.24,0:01:17.49,Default,,0,0,0,,Бұл қауесетті кім жасап, таратқан
Dialogue: 0,0:01:17.61,0:01:19.74,Default,,0,0,0,,Мен өзімді өрескел деп ойлаймын
Dialogue: 0,0:01:20.66,0:01:23.16,Default,,0,0,0,,Ол мемлекеттік төңкерісші.
Dialogue: 0,0:01:23.83,0:01:25.50,Default,,0,0,0,,Директор Лилиум
Dialogue: 0,0:01:25.62,0:01:29.00,Default,,0,0,0,,Ол менің кінәсіздігіме сеніп, қасымда тұрады.
Dialogue: 0,0:01:29.42,0:01:31.75,Default,,0,0,0,,Мен директор Гросслерді мемлекеттік төңкеріс жасады деп күдіктенемін.
Dialogue: 0,0:01:31.88,0:01:33.17,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:01:33.63,0:01:37.05,Default,,0,0,0,,Сондықтан ол менен мәселені шешу үшін бар күшімді салуымды өтінді.
Dialogue: 0,0:01:37.72,0:01:42.47,Default,,0,0,0,,АССА іші аласапыран болса да, біз бұл елдің тәртібін қорғаймыз.
Dialogue: 0,0:01:43.43,0:01:44.85,Default,,0,0,0,,Директор Маув
Dialogue: 0,0:01:44.97,0:01:47.56,Default,,0,0,0,,Төңкеріске қатысты тергеу жүргізуді сұрады.
Dialogue: 0,0:01:48.10,0:01:49.69,Default,,0,0,0,,Мен сенің көмегіңді алғым келеді
Dialogue: 0,0:01:50.31,0:01:51.27,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:01:51.40,0:01:54.61,Default,,0,0,0,,Сіз мені араша ретінде пайдаланады деген қауесеттерді білмейтін сияқтысыз.
Dialogue: 0,0:01:57.20,0:01:59.61,Default,,0,0,0,,Басқа бастықтарды білмеймін.
Dialogue: 0,0:01:59.74,0:02:03.87,Default,,0,0,0,,Төңкерісті жоғары жақтағылардың бәрі бірдей түсінетін сияқты.
Dialogue: 0,0:02:04.83,0:02:07.29,Default,,0,0,0,,Бұл жолы жай қауесет емес.
Dialogue: 0,0:02:07.79,0:02:10.33,Default,,0,0,0,,Ниноға директор Гросслер тапсырыс берген.
Dialogue: 0,0:02:10.46,0:02:12.29,Default,,0,0,0,,Менің күзетшім ретінде әрекет ету
Dialogue: 0,0:02:15.42,0:02:18.68,Default,,0,0,0,,Мен Нино туралы сенімді емеспін.
Dialogue: 0,0:02:20.34,0:02:23.56,Default,,0,0,0,,Мұның бәрі Доуэр отбасына байланысты болуы мүмкін.
Dialogue: 0,0:02:24.39,0:02:27.06,Default,,0,0,0,,Патша тағы қанша жыл отыратынына байланысты.
Dialogue: 0,0:02:28.98,0:02:29.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.06,0:02:33.86,Default,,0,0,0,,Бірақ мен араға көмектесіп жатырмын.
Dialogue: 0,0:02:34.02,0:02:35.82,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:02:37.40,0:02:43.41,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:04:00.90,0:04:06.91,Default,,0,0,0,,~♪
Dialogue: 0,0:04:08.91,0:04:10.75,Default,,0,0,0,,Мен ертең қауіпсіздікті сұрадым.
Dialogue: 0,0:04:11.08,0:04:12.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:14.62,0:04:19.00,Default,,0,0,0,,Бұл жай ғана жасалатын нәрсе, өйткені бұл менің қатысым жоқ, Мэгги.
Dialogue: 0,0:04:19.67,0:04:23.30,Default,,0,0,0,,Ертең ханзаданың қызметшісі ретінде үйде болыңыз.
Dialogue: 0,0:04:23.42,0:04:24.26,Default,,0,0,0,,Га
Dialogue: 0,0:04:24.59,0:04:28.72,Default,,0,0,0,,Ханзадаға бірдеңе болса, сен де сонда боласың.
Dialogue: 0,0:04:28.97,0:04:31.85,Default,,0,0,0,,33 жыл бұрынғыдай.
Dialogue: 0,0:04:31.98,0:04:32.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.02,0:04:35.14,Default,,0,0,0,,Тек ханзада және оның оқиғасы
Dialogue: 0,0:04:35.65,0:04:36.48,Default,,0,0,0,,Иә
Dialogue: 0,0:04:37.15,0:04:41.57,Default,,0,0,0,,Біз Дова корольдік отбасын қорғау үшін бармыз.
Dialogue: 0,0:04:41.69,0:04:46.70,Default,,0,0,0,,Бірақ кейде біздің бақылауымыздан тыс нәрселер болады.
Dialogue: 0,0:04:47.87,0:04:54.08,Default,,0,0,0,,Корольдің қазынасы мен асыл жолдастарымызды алып кеткен кеме суға батып кетті.
Dialogue: 0,0:04:54.91,0:04:57.42,Default,,0,0,0,,Ханзада сыртқа шыққысы келеді.
Dialogue: 0,0:04:58.00,0:04:58.84,Default,,0,0,0,,Хо
Dialogue: 0,0:04:59.63,0:05:01.88,Default,,0,0,0,,Тақтың жалғыз мұрагері ретінде
Dialogue: 0,0:05:02.01,0:05:04.34,Default,,0,0,0,,Менің барлық ойым сізде екенін көргеніме қуаныштымын.
Dialogue: 0,0:05:06.09,0:05:07.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:07.97,0:05:09.01,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:05:09.14,0:05:13.56,Default,,0,0,0,,Қандай жағдай болмасын, сен менің қасымда боласың, Мэгги.
Dialogue: 0,0:05:14.43,0:05:21.19,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:05:23.74,0:05:25.70,Default,,0,0,0,,Ол әдеттегіден де қара түсті.
Dialogue: 0,0:05:26.86,0:05:28.99,Default,,0,0,0,,Довардағы жел суық.
Dialogue: 0,0:05:29.12,0:05:29.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:30.95,0:05:32.79,Default,,0,0,0,,Лоттаға арналған кәдесый торт па?
Dialogue: 0,0:05:32.91,0:05:34.58,Default,,0,0,0,,Жоқ, маған мұны істеуді өтінді.
Dialogue: 0,0:05:35.08,0:05:36.46,Default,,0,0,0,,«Қарлы кесек»
Dialogue: 0,0:05:36.79,0:05:40.50,Default,,0,0,0,,Өткен күні Нотт баласына кәдесый ретінде сатып алды.
Dialogue: 0,0:05:40.63,0:05:42.21,Default,,0,0,0,,Бұл оқиғаны тыңдаңыз...
Dialogue: 0,0:05:42.71,0:05:44.46,Default,,0,0,0,,Мен оны көрмедім, оны жегім келеді!
Dialogue: 0,0:05:44.80,0:05:45.76,Default,,0,0,0,,...
Dialogue: 0,0:05:46.05,0:05:47.84,Default,,0,0,0,,Өйткені мен оны сол кезде таңертеңгі базардан сатып алғанмын.
Dialogue: 0,0:05:47.97,0:05:50.64,Default,,0,0,0,,Дүкеннің өзі қайда екенін білмеймін.
Dialogue: 0,0:05:51.01,0:05:52.47,Default,,0,0,0,,Бұл сәл әрірек
Dialogue: 0,0:05:52.60,0:05:55.52,Default,,0,0,0,,Ол қазірдің өзінде жабық, мен сені ертең сонда апарамын.
Dialogue: 0,0:05:55.89,0:05:57.27,Default,,0,0,0,,Ертеңгі тексеру ше?
Dialogue: 0,0:05:57.39,0:06:01.19,Default,,0,0,0,,Патша келе жатыр, мен қозғалмаймын деп шештім.
Dialogue: 0,0:06:01.56,0:06:03.15,Default,,0,0,0,,Мен күні бойы босмын.
Dialogue: 0,0:06:03.65,0:06:05.53,Default,,0,0,0,,Олай болса, сағат 15.00-де ше?
Dialogue: 0,0:06:05.65,0:06:07.78,Default,,0,0,0,,Торт дәмді, ендеше жейік.
Dialogue: 0,0:06:07.90,0:06:09.03,Default,,0,0,0,,Шоколад тағы?
Dialogue: 0,0:06:09.53,0:06:11.95,Default,,0,0,0,,Жоқ, бұл алма торты.
Dialogue: 0,0:06:12.08,0:06:14.62,Default,,0,0,0,,Шоколадтан басқа бірдеңе болуың сирек.
Dialogue: 0,0:06:14.74,0:06:16.83,Default,,0,0,0,,Жақсы, білмейсің бе?
Dialogue: 0,0:06:16.95,0:06:19.50,Default,,0,0,0,,Сіз шынымен көп нәрсені білесіз.
Dialogue: 0,0:06:19.87,0:06:23.21,Default,,0,0,0,,Ертең күнделікті киім киіңіз. Формалар ерекше көзге түседі.
Dialogue: 0,0:06:23.34,0:06:26.30,Default,,0,0,0,,Не? Мен формамнан басқа ештеңе әкелген жоқпын.
Dialogue: 0,0:06:26.42,0:06:27.84,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:06:30.51,0:06:32.47,Default,,0,0,0,,Ертең қар жауады ма?
Dialogue: 0,0:06:33.22,0:06:34.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:35.56,0:06:37.81,Default,,0,0,0,,Ақшақар!
Dialogue: 0,0:06:37.93,0:06:39.77,Default,,0,0,0,,Бұл үлкен! толық!
Dialogue: 0,0:06:39.89,0:06:41.69,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:06:41.81,0:06:44.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:44.65,0:06:48.07,Default,,0,0,0,,Мен қарды тез жедім.
Dialogue: 0,0:06:51.66,0:06:54.24,Default,,0,0,0,,Бауырым, ұмытқан жоқсың ба?
Dialogue: 0,0:06:55.20,0:06:56.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.41,0:06:58.70,Default,,0,0,0,,Уау, қар жауып тұр!
Dialogue: 0,0:07:05.75,0:07:08.76,Default,,0,0,0,,Ей, кездескің келмейтін адам бар ма?
Dialogue: 0,0:07:09.51,0:07:10.80,Default,,0,0,0,,Сізде жақсы болжам бар.
Dialogue: 0,0:07:10.93,0:07:12.01,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:07:12.89,0:07:15.22,Default,,0,0,0,,Мұндағы қожайынның бұл ісі жақсы емес.
Dialogue: 0,0:07:19.73,0:07:21.56,Default,,0,0,0,,Бұл Лотаны бақытты етпейді.
Dialogue: 0,0:07:22.52,0:07:24.15,Default,,0,0,0,,Қандай тортты жегің келеді?
Dialogue: 0,0:07:24.27,0:07:26.07,Default,,0,0,0,,Мен мына қарды жеймін
Dialogue: 0,0:07:26.32,0:07:28.61,Default,,0,0,0,,Патшаға да ұнаса керек.
Dialogue: 0,0:07:28.73,0:07:31.20,Default,,0,0,0,,Бұл жер корольдік отбасын жеткізуші болып табылады.
Dialogue: 0,0:07:31.49,0:07:34.03,Default,,0,0,0,,Тәтті нәрселерді ұнатасың.
Dialogue: 0,0:07:34.16,0:07:36.95,Default,,0,0,0,,Ақ шоколад дәмі мен алма торты дүкенде бар
Dialogue: 0,0:07:38.58,0:07:42.12,Default,,0,0,0,,Патшаның аялдамасы Бұл жолы бұл біздің дүкен.
Dialogue: 0,0:07:42.25,0:07:43.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.21,0:07:45.08,Default,,0,0,0,,О, сен білмейсің бе?
Dialogue: 0,0:07:45.21,0:07:46.17,Default,,0,0,0,,Сіз шыққан сайын
Dialogue: 0,0:07:46.29,0:07:49.46,Default,,0,0,0,,Сіз өзіңіздің сүйікті кондитерлік дүкеніңізге барасыз.
Dialogue: 0,0:07:49.76,0:07:51.05,Default,,0,0,0,,Онда мен кетуім керек.
Dialogue: 0,0:07:51.17,0:07:52.59,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:53.43,0:07:54.80,Default,,0,0,0,,Орынға отырыңыз
Dialogue: 0,0:07:54.93,0:07:58.14,Default,,0,0,0,,Бұйрық әдеттегідей жұмысты жалғастыру.
Dialogue: 0,0:07:59.14,0:08:01.89,Default,,0,0,0,,Қонақтармен бірге өткізген уақытты ләззат алыңыз
Dialogue: 0,0:08:03.23,0:08:07.15,Default,,0,0,0,,Патшаның орны артқы жағында, бірақ басқа жерге баруға болады.
Dialogue: 0,0:08:08.77,0:08:10.86,Default,,0,0,0,,Күйеуіңіз әдемі емес пе?
Dialogue: 0,0:08:10.99,0:08:13.70,Default,,0,0,0,,Патшаның келуіне қуанғаныңызға сенімдімін.
Dialogue: 0,0:08:13.82,0:08:16.53,Default,,0,0,0,,Қалпақ пен күннен қорғайтын көзілдірікті шешіңіз
Dialogue: 0,0:08:19.04,0:08:23.92,Default,,0,0,0,,Бұл адам ACCA штаб-пәтеріндегі инспекция бөлімінің қызметкері ме?
Dialogue: 0,0:08:24.04,0:08:28.00,Default,,0,0,0,,Патшаның келгенін біліп, дүкенге келдің бе?
Dialogue: 0,0:08:28.13,0:08:29.92,Default,,0,0,0,,Біз де бүгін таңертең білдік.
Dialogue: 0,0:08:30.51,0:08:32.17,Default,,0,0,0,,Кездейсоқ шығар
Dialogue: 0,0:08:32.47,0:08:35.84,Default,,0,0,0,,Дегенмен бірге отыру өте батылдық.
Dialogue: 0,0:08:36.05,0:08:38.30,Default,,0,0,0,,Екіншісі кім?
Dialogue: 0,0:08:41.10,0:08:46.98,Default,,0,0,0,,Қауіп төнсе, директор Квармға белгі беріледі.
Dialogue: 0,0:08:49.86,0:08:53.65,Default,,0,0,0,,Бұл дәмді. Мен де сіздің тортыңызды аламын ба?
Dialogue: 0,0:08:54.15,0:08:56.28,Default,,0,0,0,,Сіз, әрине, немере ағасысыз.
Dialogue: 0,0:08:56.41,0:08:57.24,Default,,0,0,0,,Не?
Dialogue: 0,0:08:57.82,0:09:01.95,Default,,0,0,0,,Әдетте мен бұл атмосферада бір ауыз сөз айта алмайтын едім.
Dialogue: 0,0:09:02.50,0:09:05.00,Default,,0,0,0,,Себебі мен саған қалыпты бол дедім.
Dialogue: 0,0:09:05.21,0:09:07.08,Default,,0,0,0,,Көп шуламасаңыз, бәрі жақсы болады.
Dialogue: 0,0:09:07.54,0:09:09.38,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:09:10.88,0:09:13.09,Default,,0,0,0,,Иә (Патша) Бұл қарлы ма?
Dialogue: 0,0:09:13.21,0:09:14.38,Default,,0,0,0,,Иә (Патша) Иә.
Dialogue: 0,0:09:14.51,0:09:17.47,Default,,0,0,0,,Мен ACCA штаб-пәтерінің инспекция бөліміненмін.
Dialogue: 0,0:09:17.59,0:09:19.51,Default,,0,0,0,,Дұрыс? (Джин) Иә.
Dialogue: 0,0:09:19.64,0:09:22.18,Default,,0,0,0,,Киім Доуэрдікі сияқты.
Dialogue: 0,0:09:22.31,0:09:23.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:23.43,0:09:27.27,Default,,0,0,0,,Мен өз киімімді әкелген жоқпын, сондықтан ол маған киімдер алып берді.
Dialogue: 0,0:09:27.85,0:09:32.02,Default,,0,0,0,,Сіз фотографсыз. Сіз кәмелетке толу рәсімінде болдыңыз.
Dialogue: 0,0:09:32.36,0:09:34.94,Default,,0,0,0,,Бұл бөлім үшін рахмет.
Dialogue: 0,0:09:35.40,0:09:37.82,Default,,0,0,0,,Сізге рахмет, мен керемет фотосуреттер түсіре алдым.
Dialogue: 0,0:09:38.16,0:09:39.07,Default,,0,0,0,,Иә
Dialogue: 0,0:09:39.37,0:09:41.58,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:09:42.16,0:09:43.79,Default,,0,0,0,,Сен
Dialogue: 0,0:09:45.87,0:09:48.83,Default,,0,0,0,,Қаласаңыз, маған осында қосыла аласыз ба?
Dialogue: 0,0:09:48.96,0:09:50.96,Default,,0,0,0,,Мен онша көп жей алмаймын.
Dialogue: 0,0:09:51.09,0:09:53.17,Default,,0,0,0,,Не? (Нино) Бұл кел дегенді білдіреді.
Dialogue: 0,0:09:53.59,0:09:56.17,Default,,0,0,0,,Көтеріліс жасамаған дұрыс сияқты.
Dialogue: 0,0:09:56.72,0:09:57.93,Default,,0,0,0,,Онда
Dialogue: 0,0:09:58.30,0:10:01.18,Default,,0,0,0,,Мен суретке түсіре аламын ба?
Dialogue: 0,0:10:01.30,0:10:03.47,Default,,0,0,0,,Бұл тек осы жағдайға арналған.
Dialogue: 0,0:10:03.81,0:10:04.85,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.93,0:10:06.77,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:08.06,0:10:08.89,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:12.44,0:10:13.27,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:13.94,0:10:14.78,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:21.78,0:10:23.70,Default,,0,0,0,,Бұл таңғажайып күн болды.
Dialogue: 0,0:10:24.87,0:10:27.66,Default,,0,0,0,,О, қандай тамаша күн.
Dialogue: 0,0:10:28.25,0:10:31.71,Default,,0,0,0,,Маған алғыс жиі айтылмайды.
Dialogue: 0,0:10:31.83,0:10:34.96,Default,,0,0,0,,Лотта екеуміз осылай айтамыз.
Dialogue: 0,0:10:35.34,0:10:37.09,Default,,0,0,0,,Осы тапсырманы орындаңыз
Dialogue: 0,0:10:37.92,0:10:39.88,Default,,0,0,0,,Сіз әдеттен тыс мас екенсіз.
Dialogue: 0,0:10:40.01,0:10:42.09,Default,,0,0,0,,Мақтау жақсы ғой, солай ма? бастыққа
Dialogue: 0,0:10:43.22,0:10:45.85,Default,,0,0,0,,Сіздің жұмысыңызда бастық бар ма?
Dialogue: 0,0:10:46.56,0:10:49.35,Default,,0,0,0,,Әй, мені ешқашан мақтаған емес.
Dialogue: 0,0:10:49.48,0:10:53.11,Default,,0,0,0,,Екеуміз кездескенде, тіпті бір күннің өзінде маған ұрысады.
Dialogue: 0,0:10:55.57,0:11:00.45,Default,,0,0,0,,Мен сенімен осылай сөйлесем, тағы да белімнен ұстайсың.
Dialogue: 0,0:11:00.95,0:11:04.24,Default,,0,0,0,,Жұмыс қызық па? нино
Dialogue: 0,0:11:05.70,0:11:07.75,Default,,0,0,0,,Бұл қызық емес.
Dialogue: 0,0:11:08.25,0:11:10.41,Default,,0,0,0,,Ләззат алсаң жақсы емес
Dialogue: 0,0:11:11.08,0:11:14.54,Default,,0,0,0,,Бірақ бұл маған ұнайтын сияқты.
Dialogue: 0,0:11:15.38,0:11:18.05,Default,,0,0,0,,Сондықтан маған ұрысады.
Dialogue: 0,0:11:21.51,0:11:23.39,Default,,0,0,0,,Нино ұйықтап қалды.
Dialogue: 0,0:11:23.80,0:11:27.85,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:29.98,0:11:32.77,Default,,0,0,0,,Жақсы сурет Шван.
Dialogue: 0,0:11:35.23,0:11:36.61,Default,,0,0,0,,Ата
Dialogue: 0,0:11:36.90,0:11:39.07,Default,,0,0,0,,Сізге қай сурет ұнайды?
Dialogue: 0,0:11:45.62,0:11:47.62,Default,,0,0,0,,Барлығы
Dialogue: 0,0:11:50.25,0:11:52.12,Default,,0,0,0,,Бұл жаңа жаңғақ жаңғағы
Dialogue: 0,0:11:52.62,0:11:54.50,Default,,0,0,0,,Егер сізге ұнаса, көріңіз.
Dialogue: 0,0:11:54.79,0:11:55.79,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:56.00,0:11:59.21,Default,,0,0,0,,Сіз бұл жерде емессіз, бастық.
Dialogue: 0,0:11:59.76,0:12:00.97,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:05.26,0:12:07.01,Default,,0,0,0,,Сізді айналып өтіп жатыр ма?
Dialogue: 0,0:12:08.47,0:12:11.35,Default,,0,0,0,,Ұнға толы! дәмді!
Dialogue: 0,0:12:12.06,0:12:16.44,Default,,0,0,0,,Қант ұнтағы мен ақ шоколад шынымен де қарға ұқсайды
Dialogue: 0,0:12:16.56,0:12:19.36,Default,,0,0,0,,Иә, өткен күні қар жауды.
Dialogue: 0,0:12:19.48,0:12:20.86,Default,,0,0,0,,Жаңбыр да жауды
Dialogue: 0,0:12:21.19,0:12:24.70,Default,,0,0,0,,Ей, мен де қарлы Доварға барғым келеді.
Dialogue: 0,0:12:24.82,0:12:26.32,Default,,0,0,0,,Бұл сүйкімді емес пе?
Dialogue: 0,0:12:26.45,0:12:29.12,Default,,0,0,0,,Саған қатты ұнайтын сияқты, Дауэр.
Dialogue: 0,0:12:29.49,0:12:32.62,Default,,0,0,0,,Иә, мен оны жақсы көремін! Ал ағаң ше?
Dialogue: 0,0:12:32.75,0:12:35.92,Default,,0,0,0,,Барлық аудандар айналып жатыр, солай ма? Сізге қайсысы көбірек ұнайды?
Dialogue: 0,0:12:36.04,0:12:36.88,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:38.25,0:12:40.50,Default,,0,0,0,,Маған да Доуэр ұнайды.
Dialogue: 0,0:12:40.84,0:12:42.76,Default,,0,0,0,,Бірақ ең жақсысы Бардон шығар.
Dialogue: 0,0:12:42.97,0:12:45.01,Default,,0,0,0,,Мен сенімдімін (Джин) Ха
Dialogue: 0,0:12:45.13,0:12:49.43,Default,,0,0,0,,Барлығына бірдей. Менің палатамның ең жақсысы екеніне сенімдімін.
Dialogue: 0,0:12:49.89,0:12:52.14,Default,,0,0,0,,Сіздің келесі іссапарыңыз қайда? Бірден, солай ма?
Dialogue: 0,0:12:52.77,0:12:54.77,Default,,0,0,0,,Иә, Ниноны тамақ ішуге апарыңыз...
Dialogue: 0,0:12:54.89,0:12:57.19,Default,,0,0,0,,Нино да бос емес, солай ма? (Джин) А?
Dialogue: 0,0:12:57.31,0:13:00.15,Default,,0,0,0,,Хехе, мен менеджерге уәде бердім.
Dialogue: 0,0:13:00.61,0:13:04.40,Default,,0,0,0,,Жаңа жылдық торт үшін дәмхана иесіне алғыс айту
Dialogue: 0,0:13:04.90,0:13:06.53,Default,,0,0,0,,Сондықтан мен жалғыз емеспін
Dialogue: 0,0:13:06.66,0:13:08.66,Default,,0,0,0,,Әй, бұл жақсы.
Dialogue: 0,0:13:08.78,0:13:10.16,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:13:10.28,0:13:11.29,Default,,0,0,0,,Колор ауданы
Dialogue: 0,0:13:11.41,0:13:12.50,Default,,0,0,0,,Маған шоколад сатып ал!
Dialogue: 0,0:13:12.62,0:13:13.54,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:13.75,0:13:15.71,Default,,0,0,0,,Coloré - бұл шоколад!
Dialogue: 0,0:13:15.83,0:13:17.58,Default,,0,0,0,,Шоколад?
Dialogue: 0,0:13:17.71,0:13:19.54,Default,,0,0,0,,Нино да міндетті түрде келеді.
Dialogue: 0,0:13:21.34,0:13:22.59,Default,,0,0,0,,Галле Уорд мүшелері
Dialogue: 0,0:13:22.71,0:13:25.88,Default,,0,0,0,,Сіз төңкеріске қатысты белсенділік танытқан сияқтысыз.
Dialogue: 0,0:13:27.09,0:13:30.64,Default,,0,0,0,,Колорға басқа палаталардағы үрдістер әсер етпейді.
Dialogue: 0,0:13:30.76,0:13:32.43,Default,,0,0,0,,Қозғалыс болуы мүмкін
Dialogue: 0,0:13:33.02,0:13:34.85,Default,,0,0,0,,Біз қайтадан хабарлаймыз.
Dialogue: 0,0:13:35.02,0:13:36.81,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:13:36.94,0:13:39.77,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:13:40.48,0:13:41.77,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:13:41.90,0:13:44.82,Default,,0,0,0,,Директор Гросслерге есеп аяқталды.
Dialogue: 0,0:13:45.57,0:13:47.95,Default,,0,0,0,,Ертең мен Колораға кіремін.
Dialogue: 0,0:13:48.45,0:13:52.54,Default,,0,0,0,,Доуэр? Мен тек жақсы болды деп айта аламын.
Dialogue: 0,0:13:52.66,0:13:56.21,Default,,0,0,0,,Мен сізге барлық фотосуреттер мен есептерді жібердім.
Dialogue: 0,0:13:56.91,0:13:58.33,Default,,0,0,0,,Ерте емес пе?
Dialogue: 0,0:13:58.46,0:14:01.46,Default,,0,0,0,,Мен Дорвардан қайтып келгеннен бері бірде-бір көзімді қыспадым.
Dialogue: 0,0:14:02.50,0:14:05.09,Default,,0,0,0,,Мен шаршай бастадым.
Dialogue: 0,0:14:05.21,0:14:07.93,Default,,0,0,0,,Шоколадтың дәмі жақсы болса да, мен оны жеуім керек.
Dialogue: 0,0:14:08.72,0:14:11.22,Default,,0,0,0,,Иә, келесіде Coloret.
Dialogue: 0,0:14:12.35,0:14:14.60,Default,,0,0,0,,Иә, көріскенше.
Dialogue: 0,0:14:15.14,0:14:16.10,Default,,0,0,0,,(шоколадты тістеп жатқан дыбыс)
Dialogue: 0,0:14:17.35,0:14:19.40,Default,,0,0,0,,30 жыл?
Dialogue: 0,0:14:19.85,0:14:22.11,Default,,0,0,0,,Мен қартайдым.
Dialogue: 0,0:14:25.57,0:14:29.11,Default,,0,0,0,,Неліктен бастық мұндай адамға маңызды жауапкершілікті жүктеді...
Dialogue: 0,0:14:30.61,0:14:31.91,Default,,0,0,0,,Екеуің!
Dialogue: 0,0:14:33.12,0:14:34.37,Default,,0,0,0,,Даусыңыз жоғары.
Dialogue: 0,0:14:34.49,0:14:36.00,Default,,0,0,0,,Бұл үшін кешіріңіз
Dialogue: 0,0:14:38.25,0:14:40.37,Default,,0,0,0,,Сіз төңкеріс топтарымен байланыссыз ба?
Dialogue: 0,0:14:40.50,0:14:41.63,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:14:42.42,0:14:43.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:43.75,0:14:45.09,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:14:47.38,0:14:48.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:49.09,0:14:50.47,Default,,0,0,0,,Ген Ортас...
Dialogue: 0,0:14:51.84,0:14:53.97,Default,,0,0,0,,Ол енді Колоре ме?
Dialogue: 0,0:14:55.93,0:14:56.97,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:14:58.85,0:15:00.48,Default,,0,0,0,,Маған қарап тұрсың ба?
Dialogue: 0,0:15:01.15,0:15:04.57,Default,,0,0,0,,Төңкеріс жасаушымын деген қауесет естігендіктен болар.
Dialogue: 0,0:15:04.69,0:15:06.23,Default,,0,0,0,,Мүмкін болуы мүмкін
Dialogue: 0,0:15:07.61,0:15:10.65,Default,,0,0,0,,Өлеңді білген бастыққа түсіндіру мүмкіндігі
Dialogue: 0,0:15:10.78,0:15:11.78,Default,,0,0,0,,Менде бар ма?
Dialogue: 0,0:15:12.62,0:15:14.41,Default,,0,0,0,,Колор ауданына қош келдіңіз
Dialogue: 0,0:15:15.49,0:15:16.99,Default,,0,0,0,,Майлау бөлімінің бастығы
Dialogue: 0,0:15:19.87,0:15:22.00,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:15:22.12,0:15:24.63,Default,,0,0,0,,Колоре ауданына уақыт бөліңіз.
Dialogue: 0,0:15:25.04,0:15:25.88,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:26.00,0:15:28.71,Default,,0,0,0,,Басқа палаталарда ойын-сауық көп болды деп ойлаймын.
Dialogue: 0,0:15:28.84,0:15:31.01,Default,,0,0,0,,Бізде ондай уақыт жоқ.
Dialogue: 0,0:15:31.13,0:15:33.89,Default,,0,0,0,,Әкім де, біз де бір шешімге келдік.
Dialogue: 0,0:15:35.05,0:15:37.85,Default,,0,0,0,,Басқа палаталардағы адамдар сияқты айналмалы заттар жоқ.
Dialogue: 0,0:15:37.97,0:15:39.64,Default,,0,0,0,,Біз ешқашан жасамаймыз
Dialogue: 0,0:15:40.81,0:15:41.94,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:15:42.06,0:15:45.36,Default,,0,0,0,,Мен төңкеріс туралы білгім келгенін сезбедім.
Dialogue: 0,0:15:45.48,0:15:46.32,Default,,0,0,0,,Директордың орынбасары
Dialogue: 0,0:15:47.23,0:15:49.53,Default,,0,0,0,,Ертеңнен бастап әр аймақты аралайтын көліктер
Dialogue: 0,0:15:49.65,0:15:51.07,Default,,0,0,0,,Ұйымдастырылған
Dialogue: 0,0:15:51.49,0:15:54.74,Default,,0,0,0,,Рахмет, әдеттегідей өте шебер.
Dialogue: 0,0:15:54.87,0:15:57.91,Default,,0,0,0,,Ерлердің түсі кішкентай
Dialogue: 0,0:15:58.24,0:16:00.91,Default,,0,0,0,,Әйелдердің аздап артықшылығы бар
Dialogue: 0,0:16:01.04,0:16:03.67,Default,,0,0,0,,Талантты ерлер де көп.
Dialogue: 0,0:16:04.58,0:16:06.54,Default,,0,0,0,,Айтпақшы, бұл Дорвар.
Dialogue: 0,0:16:07.21,0:16:09.92,Default,,0,0,0,,Патша қалай?
Dialogue: 0,0:16:10.80,0:16:12.51,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:16:12.76,0:16:14.72,Default,,0,0,0,,Ақыр аяғында, бәрінің қамы бар.
Dialogue: 0,0:16:15.47,0:16:17.18,Default,,0,0,0,,ACCA болашағы
Dialogue: 0,0:16:18.56,0:16:21.14,Default,,0,0,0,,Біз келесі ұрпаққа көшкенде жағдай қалай өзгереді?
Dialogue: 0,0:16:21.27,0:16:22.73,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:16:23.31,0:16:25.15,Default,,0,0,0,,Бұл Шван
Dialogue: 0,0:16:25.27,0:16:29.07,Default,,0,0,0,,Бұл жерде көріну әдеттен тыс.
Dialogue: 0,0:16:29.53,0:16:32.11,Default,,0,0,0,,Апайға сәттілік тілейміз.
Dialogue: 0,0:16:32.32,0:16:33.70,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:16:33.82,0:16:36.45,Default,,0,0,0,,Ескі әңгімені тыңдау
Dialogue: 0,0:16:36.95,0:16:38.08,Default,,0,0,0,,Барлығы қайда?
Dialogue: 0,0:16:38.78,0:16:42.66,Default,,0,0,0,,Өйткені бұл оқиғаны анам жас кезінде айтып берген.
Dialogue: 0,0:16:42.87,0:16:47.84,Default,,0,0,0,,Апамның әпкесі кім екенін сұрауға асықтым.
Dialogue: 0,0:16:48.79,0:16:52.26,Default,,0,0,0,,33 жыл бұрын өмірден өтті.
Dialogue: 0,0:16:52.59,0:16:56.30,Default,,0,0,0,,Әпкеңнің саған сыйлаған екінші ханшайымы туралы.
Dialogue: 0,0:16:59.60,0:17:03.39,Default,,0,0,0,,Көп нәрсе бар, қайсысы жақсы екенін білмеймін.
Dialogue: 0,0:17:03.52,0:17:04.35,Default,,0,0,0,,
Dialogue: 0,0:17:07.90,0:17:11.69,Default,,0,0,0,,Нино Ол сонда емес пе? Маған айтып берсеңіз екен
Dialogue: 0,0:17:22.33,0:17:25.54,Default,,0,0,0,,Отус сізге қатысты хабарлама алды.
Dialogue: 0,0:17:25.66,0:17:28.04,Default,,0,0,0,,Бастық, бұл туралы.
Dialogue: 0,0:17:28.17,0:17:30.46,Default,,0,0,0,,Сыбыс, дәлірек айтсақ...
Dialogue: 0,0:17:31.09,0:17:32.76,Default,,0,0,0,,Сіз корольдік отбасының мүшесісіз.
Dialogue: 0,0:17:33.46,0:17:36.30,Default,,0,0,0,,Не? (Күлгін) Тақтың мұрагерлігі бойынша бірінші
Dialogue: 0,0:17:38.89,0:17:41.14,Default,,0,0,0,,Сіз мұны білмедіңіз бе?
Dialogue: 0,0:17:41.68,0:17:43.39,Default,,0,0,0,,Жарайды, мекенжайы ше? Ол – 1-6 Жозендзи.
Dialogue: 0,0:17:46.77,0:17:48.15,Default,,0,0,0,,Бағыныштылардың есептерінде
Dialogue: 0,0:17:48.27,0:17:51.36,Default,,0,0,0,,Мен сіздің төңкеріс фракциясының арасы екеніңізді білдім.
Dialogue: 0,0:17:51.48,0:17:52.52,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:53.65,0:17:57.61,Default,,0,0,0,,Мен сіздің патша әулетінен шыққаныңыз туралы мәліметтерді көрдім.
Dialogue: 0,0:17:59.07,0:18:01.41,Default,,0,0,0,,Сол кезде мен сезіндім
Dialogue: 0,0:18:01.53,0:18:04.87,Default,,0,0,0,,Gene Autus қолданылуда деген күдік бар.
Dialogue: 0,0:18:05.91,0:18:09.25,Default,,0,0,0,,Мен ешқашан өз түйсігіме тым көп сенбеймін.
Dialogue: 0,0:18:09.37,0:18:11.17,Default,,0,0,0,,... солай ойладым.
Dialogue: 0,0:18:11.50,0:18:14.67,Default,,0,0,0,,Сіз қателеспейсіз деп ойлаймын.
Dialogue: 0,0:18:15.21,0:18:16.42,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:16.55,0:18:19.97,Default,,0,0,0,,Сіз жай ғана ара-арасында әрекет етесіз бе?
Dialogue: 0,0:18:20.26,0:18:21.18,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:18:22.85,0:18:24.14,Default,,0,0,0,,Сенейік
Dialogue: 0,0:18:24.39,0:18:27.02,Default,,0,0,0,,Өтірік айтпайтын адам екеніңді.
Dialogue: 0,0:18:27.14,0:18:28.56,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:18:30.94,0:18:35.78,Default,,0,0,0,,Өткен күні мен сізге айтқан «бұл пайдалы емес» деген сөздер болған жоқ.
Dialogue: 0,0:18:36.57,0:18:38.40,Default,,0,0,0,,Сіз құйынға түсесіз
Dialogue: 0,0:18:38.53,0:18:42.37,Default,,0,0,0,,Менің іздегенім саған ешқашан келмеуі мүмкін
Dialogue: 0,0:18:42.49,0:18:45.79,Default,,0,0,0,,Ештеңе хабарлай алмағаным рас.
Dialogue: 0,0:18:45.91,0:18:48.79,Default,,0,0,0,,Бірдеңе хабарлау керек еді.
Dialogue: 0,0:18:49.08,0:18:51.08,Default,,0,0,0,,Костюмдер туралы және т.б.
Dialogue: 0,0:18:53.54,0:18:57.92,Default,,0,0,0,,Сіз маған директор Гроссюлар туралы айтуға батылыңыз келмеді, солай ма?
Dialogue: 0,0:18:59.13,0:19:01.39,Default,,0,0,0,,Мен сізді жиі Мауве көшесінде жүретініңізді естідім.
Dialogue: 0,0:19:02.26,0:19:05.14,Default,,0,0,0,,Менің директорға деген құрметімді білесіз.
Dialogue: 0,0:19:05.26,0:19:07.85,Default,,0,0,0,,«Төңкеріс жасағы» деген күдік директордың үстінен ілініп тұр.
Dialogue: 0,0:19:07.98,0:19:10.02,Default,,0,0,0,,Маған айтқан жоқ
Dialogue: 0,0:19:10.64,0:19:11.90,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:19:12.15,0:19:15.11,Default,,0,0,0,,Менен мұны сұрасаң, жоққа шығару қиын.
Dialogue: 0,0:19:16.07,0:19:17.07,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:19:17.57,0:19:21.41,Default,,0,0,0,,Маған есеп беруге болатын үлкен жетістік болды.
Dialogue: 0,0:19:22.03,0:19:24.03,Default,,0,0,0,,Мен сізді алаңдаттым.
Dialogue: 0,0:19:24.24,0:19:27.70,Default,,0,0,0,,Бірақ мұндай қараудың маған пайдасы жоқ.
Dialogue: 0,0:19:28.54,0:19:31.37,Default,,0,0,0,,Хабарламауымның тағы бір себебі бар.
Dialogue: 0,0:19:31.50,0:19:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.96,0:19:35.25,Default,,0,0,0,,Директор Гросслер басқаша.
Dialogue: 0,0:19:35.59,0:19:38.17,Default,,0,0,0,,Сондықтан мен бұл туралы хабарлаған жоқпын.
Dialogue: 0,0:19:40.22,0:19:43.84,Default,,0,0,0,,Бастық: Мен несие алмаймын.
Dialogue: 0,0:19:50.98,0:19:52.85,Default,,0,0,0,,Менен сұрамайсың.
Dialogue: 0,0:19:53.81,0:19:55.98,Default,,0,0,0,,Өзім туралы
Dialogue: 0,0:19:56.23,0:19:57.61,Default,,0,0,0,,Сіз мұны алдын ала ойладыңыз ба?
Dialogue: 0,0:19:58.98,0:20:01.78,Default,,0,0,0,,Жоқ, мен әлі де күмәнмен қараймын.
Dialogue: 0,0:20:01.90,0:20:03.24,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:20:03.36,0:20:04.99,Default,,0,0,0,,Шынымен де...
Dialogue: 0,0:20:06.24,0:20:07.99,Default,,0,0,0,,Сөйлесетін адам бар.
Dialogue: 0,0:20:08.87,0:20:11.25,Default,,0,0,0,,Палатаның сыртында саяхаттау? Неге мен?
Dialogue: 0,0:20:11.96,0:20:14.71,Default,,0,0,0,,«Мен Бардонға барып, білімімді кеңейткім келеді»...
Dialogue: 0,0:20:14.83,0:20:16.92,Default,,0,0,0,,жеткілікті түсінікке ие болу және т.б.
Dialogue: 0,0:20:17.75,0:20:20.09,Default,,0,0,0,,Мен Бардонға барғым келетінін айттым.
Dialogue: 0,0:20:20.21,0:20:22.17,Default,,0,0,0,,Қызым туралы білу үшін.
Dialogue: 0,0:20:22.30,0:20:24.80,Default,,0,0,0,,Ах! Мұның бәрі Мисс Лотта туралы ...
Dialogue: 0,0:20:24.93,0:20:26.68,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:20:27.39,0:20:30.72,Default,,0,0,0,,Сен маған кедергі боласың ба?
Dialogue: 0,0:20:32.06,0:20:35.40,Default,,0,0,0,,Апаймен сөйлескеннен кейін түсіндім деп ойлаймын.
Dialogue: 0,0:20:36.23,0:20:39.57,Default,,0,0,0,,Ол қызда екінші ханшайымның қаны бар шығар.
Dialogue: 0,0:20:40.57,0:20:44.07,Default,,0,0,0,,Ханшайым шынымен 33 жыл бұрын қайтыс болды ма?
Dialogue: 0,0:20:45.07,0:20:49.08,Default,,0,0,0,,Портрет бөлмесіндегі 16 жасар ханшайым үшін бұл қыз тірі көшірме.
Dialogue: 0,0:20:51.16,0:20:55.58,Default,,0,0,0,,Жарайды, ол екінші ханшайыммен туысқан болса да, ол бәрібір әйел.
Dialogue: 0,0:20:55.71,0:20:58.09,Default,,0,0,0,,Менің мұрагерлік құқығым өзгеріссіз қалады.
Dialogue: 0,0:20:58.21,0:21:01.13,Default,,0,0,0,,Мисс Лоттаның ағасы бар.
Dialogue: 0,0:21:01.55,0:21:04.30,Default,,0,0,0,,Салтанатты күні мен сарайдың ішінде темекі шегіп отырдым.
Dialogue: 0,0:21:04.42,0:21:06.26,Default,,0,0,0,,Бұл ақымақ жігіт.
Dialogue: 0,0:21:06.59,0:21:08.22,Default,,0,0,0,,Сіз тыңдамайсыз, Мэгги!
Dialogue: 0,0:21:08.35,0:21:09.81,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:21:09.93,0:21:13.18,Default,,0,0,0,,Қажет болса, Бардонға тағы барамын.
Dialogue: 0,0:21:13.31,0:21:15.06,Default,,0,0,0,,Мисс Лоттаға қатысты мұқият тергеу...
Dialogue: 0,0:21:15.19,0:21:17.73,Default,,0,0,0,,Мен бұл кішкентай қызды ойламаймын!
Dialogue: 0,0:21:18.11,0:21:20.57,Default,,0,0,0,,Мен сол ағаны қараймын.
Dialogue: 0,0:21:20.69,0:21:22.44,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:21:22.57,0:21:23.49,Default,,0,0,0,,Бұл – иллюзия сиқыры.
Dialogue: 0,0:21:23.61,0:21:26.70,Default,,0,0,0,,Мен ханзаданың қасынан кете алмаймын.
Dialogue: 0,0:21:27.32,0:21:32.58,Default,,0,0,0,,«33 жыл бұрын, ханшайыммен бірге мұхитқа жоғалып кеткен қызметші сияқты».
Dialogue: 0,0:21:32.70,0:21:34.96,Default,,0,0,0,,«Әрқашан оның жанында бол»
Dialogue: 0,0:21:35.50,0:21:38.13,Default,,0,0,0,,Бұл офицердің аты кім?
Dialogue: 0,0:21:38.96,0:21:40.38,Default,,0,0,0,,Абенд
Dialogue: 0,0:21:41.09,0:21:44.38,Default,,0,0,0,,Сарбаздар арасында бұл есімді білмейтін адам жоқ.
Dialogue: 0,0:21:44.59,0:21:46.63,Default,,0,0,0,,Әдемі ақ шашы бар
Dialogue: 0,0:21:46.76,0:21:50.01,Default,,0,0,0,,Сондықтан ол қардай сұлу екінші ханшайымның көзіне түсті.
Dialogue: 0,0:21:50.14,0:21:51.85,Default,,0,0,0,,Өзін-өзі ұсынды
Dialogue: 0,0:21:51.97,0:21:54.60,Default,,0,0,0,,Әңгімені мұраға қалдыру керек адам
Dialogue: 0,0:21:57.44,0:21:58.60,Default,,0,0,0,,Джин білген.
Dialogue: 0,0:21:59.73,0:22:01.65,Default,,0,0,0,,Директор Маувтан
Dialogue: 0,0:22:01.77,0:22:05.03,Default,,0,0,0,,Екеуінің қандай әңгіме болғанын білмеймін.
Dialogue: 0,0:22:05.99,0:22:09.70,Default,,0,0,0,,Джин келеді, мен сөйлесемін.
Dialogue: 0,0:22:09.99,0:22:14.70,Default,,0,0,0,,Енді сіз араласу себебін білесіз, бұл туралы сөйлесетін уақыт емес пе?
Dialogue: 0,0:22:15.00,0:22:18.00,Default,,0,0,0,,Сізге қалай ұнайды? Сіз бірінші сөйлескіңіз келе ме?
Dialogue: 0,0:22:18.12,0:22:21.50,Default,,0,0,0,,Директор Кварммен кеңесуге уақытым жоқ.
Dialogue: 0,0:22:21.79,0:22:22.88,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:22:24.00,0:22:25.84,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:22:25.96,0:22:26.80,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:22:26.92,0:22:29.68,Default,,0,0,0,,Телефонды пайдалану әлі дұрыс па? нино
Dialogue: 0,0:22:29.93,0:22:32.93,Default,,0,0,0,,А, сен кәдесый сатып алдың ба?
Dialogue: 0,0:22:33.10,0:22:36.18,Default,,0,0,0,,Егер сізде әлі де жақсы дүкен болса, маған хабарлаңыз.
Dialogue: 0,0:22:37.02,0:22:37.85,Default,,0,0,0,,О
Dialogue: 0,0:22:39.56,0:22:41.86,Default,,0,0,0,,Бұл ұзақ әңгіме.
Dialogue: 0,0:22:43.57,0:22:45.57,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:22:46.44,0:22:52.45,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:09.28,0:24:15.28,Default,,0,0,0,,~♪
Dialogue: 0,0:24:16.66,0:24:19.41,Default,,0,0,0,,Келесі жолы «ACCA 13-ші палаталық инспекция бөлімі»
Dialogue: 0,0:24:19.54,0:24:22.75,Default,,0,0,0,,«Қанат жайған ханшайым және достарының міндеттері»
Dialogue: 0,0:24:23.04,0:24:25.29,Default,,0,0,0,,Тек бүгінгі кеш ерекше.
Dialogue: 0,0:24:25.50,0:24:28.50,Default,,0,0,0,,Өйткені менде өткенге қарамау саясаты бар.
Dialogue: 0,0:24:28.63,0:24:30.84,Default,,0,0,0,,Бұл тек бір рет
Dialogue: 0,0:24:32.34,0:24:38.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory