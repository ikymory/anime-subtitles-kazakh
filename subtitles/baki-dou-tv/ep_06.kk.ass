Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.55,0:01:39.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:53.11,0:01:56.90,Default,,0,0,0,,Толық шаш, Самуе және жалаң аяқ...
Dialogue: 0,0:01:57.74,0:01:59.95,Default,,0,0,0,,«Нари» штабынан хабарлады
Dialogue: 0,0:02:00.03,0:02:00.70,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:02:00.70,0:02:01.62,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:02:00.70,0:02:01.62,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:02:01.62,0:02:01.70,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:02:01.70,0:02:02.33,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:02:01.70,0:02:02.33,Default,,0,0,0,,Бетперде жоқ
Dialogue: 0,0:02:02.33,0:02:03.20,Default,,0,0,0,,Бетперде жоқ
Dialogue: 0,0:02:03.28,0:02:05.04,Default,,0,0,0,,Бұл құрметті.
Dialogue: 0,0:02:06.29,0:02:08.29,Default,,0,0,0,,Мұсашиден
Dialogue: 0,0:02:08.37,0:02:11.04,Default,,0,0,0,,(Хикикидің күлген дауысы)
Dialogue: 0,0:02:12.63,0:02:16.55,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:02:16.63,0:02:17.84,Default,,0,0,0,,Хикики мырза
Dialogue: 0,0:02:17.92,0:02:20.18,Default,,0,0,0,,Тоқтамаңыз, жалғастырыңыз
Dialogue: 0,0:02:22.26,0:02:23.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.19,0:02:30.31,Default,,0,0,0,,Хикики мырза
Dialogue: 0,0:02:30.40,0:02:33.06,Default,,0,0,0,,Менің артқа бұрылу мүмкін емес.
Dialogue: 0,0:02:38.90,0:02:40.41,Default,,0,0,0,,О!
Dialogue: 0,0:02:40.91,0:02:43.74,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:02:43.83,0:02:45.83,Default,,0,0,0,,Хикики мырза, бұл жер...
Dialogue: 0,0:02:45.91,0:02:47.87,Default,,0,0,0,,Бұл Токугава резиденциясы емес пе?
Dialogue: 0,0:02:47.95,0:02:49.96,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:02:50.04,0:02:51.62,Default,,0,0,0,,Бастыққа хабарласыңыз!
Dialogue: 0,0:02:51.71,0:02:52.71,Default,,0,0,0,,Иә
Dialogue: 0,0:02:58.80,0:03:00.97,Default,,0,0,0,,Құқық бұзу?
Dialogue: 0,0:03:01.05,0:03:02.80,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:03:02.89,0:03:05.35,Default,,0,0,0,,Оған менің қол астындағы қызметкерім куә болды.
Dialogue: 0,0:03:05.43,0:03:08.14,Default,,0,0,0,,Оны жай қалдырсаңыз жақсы.
Dialogue: 0,0:03:08.22,0:03:10.73,Default,,0,0,0,,Жоқ, бұл да дұрыс.
Dialogue: 0,0:03:10.81,0:03:14.23,Default,,0,0,0,,Өйткені, ол да төтенше жағдайға қатысты күдікті...
Dialogue: 0,0:03:14.31,0:03:16.77,Default,,0,0,0,,Күдікті? Миямотоден?
Dialogue: 0,0:03:16.86,0:03:18.23,Default,,0,0,0,,Е... жоқ...
Dialogue: 0,0:03:18.32,0:03:21.49,Default,,0,0,0,,Ол қауіпті адам.
Dialogue: 0,0:03:21.57,0:03:24.49,Default,,0,0,0,,Миё-кун, Уцумиге айт.
Dialogue: 0,0:03:24.57,0:03:26.70,Default,,0,0,0,,Депрессия... Мм...
Dialogue: 0,0:03:26.78,0:03:30.50,Default,,0,0,0,,Шунзоу Уцуми туралы, полиция бастығы...
Dialogue: 0,0:03:30.58,0:03:33.21,Default,,0,0,0,,«Мені жалғыз қалдыр» және «Маған тиіспе»
Dialogue: 0,0:03:33.29,0:03:34.58,Default,,0,0,0,,«Күте және көр»
Dialogue: 0,0:03:34.67,0:03:36.50,Default,,0,0,0,,Токугава осылай деді.
Dialogue: 0,0:03:36.59,0:03:38.00,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:03:39.09,0:03:41.13,Default,,0,0,0,,Иә? Миё-кун
Dialogue: 0,0:03:41.22,0:03:44.64,Default,,0,0,0,,Керемет! Мен сізге соны айтқым келеді!\NЖалғасы
Dialogue: 0,0:03:50.73,0:03:52.64,Default,,0,0,0,,...
Dialogue: 0,0:03:59.53,0:04:01.28,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:04:01.36,0:04:03.61,Default,,0,0,0,,Неліктен мен білемін деп ойладың?
Dialogue: 0,0:04:05.20,0:04:06.99,Default,,0,0,0,,Сәлем Джи Чан
Dialogue: 0,0:04:07.08,0:04:11.45,Default,,0,0,0,,Сіз Tokyo Dome жер асты аренасы иесісіз.
Dialogue: 0,0:04:11.54,0:04:16.88,Default,,0,0,0,,Отандық немесе шетелдік заттар туралы барлық ақпарат сізде жинақталған.
Dialogue: 0,0:04:16.96,0:04:20.05,Default,,0,0,0,,Күшті деп өсек айтатын бейбақ.
Dialogue: 0,0:04:20.13,0:04:24.13,Default,,0,0,0,,Жапонияда сіз білмейтін бірде-бір ер адам жоқ.
Dialogue: 0,0:04:24.22,0:04:25.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:26.18,0:04:27.64,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:30.43,0:04:32.68,Default,,0,0,0,,Каратэ емес, жұмсақ емес
Dialogue: 0,0:04:32.77,0:04:35.44,Default,,0,0,0,,Кез келген бар тайджуцудан айырмашылығы
Dialogue: 0,0:04:35.52,0:04:38.02,Default,,0,0,0,,Егер солай болса, онда не істеу керек?
Dialogue: 0,0:04:38.11,0:04:42.03,Default,,0,0,0,,Оны өзі айтты, Миямото Мусаши.
Dialogue: 0,0:04:42.74,0:04:44.03,Default,,0,0,0,,Бұл қылыш
Dialogue: 0,0:04:44.11,0:04:45.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:45.61,0:04:48.28,Default,,0,0,0,,Ал бұл деңгей мүмкін емес.
Dialogue: 0,0:04:48.37,0:04:51.83,Default,,0,0,0,,Тіпті Iai сияқты қарапайым қылыш әдістерімен салыстырғанда
Dialogue: 0,0:04:51.91,0:04:53.79,Default,,0,0,0,,2 цифрдан жоғары.
Dialogue: 0,0:04:54.41,0:04:56.50,Default,,0,0,0,,Күтіңіз Күтіңіз Күтіңіз
Dialogue: 0,0:04:56.58,0:04:58.29,Default,,0,0,0,,Доппо Оноши
Dialogue: 0,0:04:58.38,0:05:01.25,Default,,0,0,0,,Адамның шынайы екеніне сене аласыз ба?
Dialogue: 0,0:05:01.34,0:05:04.55,Default,,0,0,0,,Бұл жақсы, шынайы немесе жалған.
Dialogue: 0,0:05:05.51,0:05:08.14,Default,,0,0,0,,Егер техника шынайы болса, бұл жақсы.
Dialogue: 0,0:05:08.22,0:05:09.55,Default,,0,0,0,,Қалғанының бәрі жақсы.
Dialogue: 0,0:05:09.64,0:05:11.56,Default,,0,0,0,,(қолданған күш дыбысы)
Dialogue: 0,0:05:11.64,0:05:14.14,Default,,0,0,0,,Доппо ашуланба
Dialogue: 0,0:05:15.69,0:05:17.15,Default,,0,0,0,,Кездескенше
Dialogue: 0,0:05:17.65,0:05:19.06,Default,,0,0,0,,Жалғыз жүру
Dialogue: 0,0:05:20.61,0:05:21.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:21.65,0:05:23.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:24.15,0:05:27.28,Default,,0,0,0,,Жарайды, қарным ашты.
Dialogue: 0,0:05:28.66,0:05:29.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.78,0:05:31.49,Default,,0,0,0,,Қонақты кешіріңіз
Dialogue: 0,0:05:31.58,0:05:32.58,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:32.66,0:05:34.58,Default,,0,0,0,,Мұсашиден
Dialogue: 0,0:05:32.66,0:05:34.58,Default,,0,0,0,,(қатты жақындаған аяқ дыбысы)
Dialogue: 0,0:05:34.58,0:05:35.33,Default,,0,0,0,,(қатты жақындаған аяқ дыбысы)
Dialogue: 0,0:05:35.33,0:05:37.08,Default,,0,0,0,,(қатты жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:05:35.33,0:05:37.08,Default,,0,0,0,,Кенеттен
Dialogue: 0,0:05:37.83,0:05:40.84,Default,,0,0,0,,Бұл адамға қараған кезде қандай сезімде боласыз?
Dialogue: 0,0:05:42.92,0:05:45.47,Default,,0,0,0,,Хмм, бұл адам
Dialogue: 0,0:05:45.55,0:05:48.18,Default,,0,0,0,,Мен тамақтың алдында тұруға қарсы емеспін.
Dialogue: 0,0:05:48.68,0:05:50.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:50.68,0:05:54.72,Default,,0,0,0,,Доппо Гучидің алдында соғыс құдайы «бұл ас» дейді...
Dialogue: 0,0:06:01.86,0:06:03.98,Default,,0,0,0,,Дасужага Доппо
Dialogue: 0,0:06:04.07,0:06:06.99,Default,,0,0,0,,Хехе, кешіріңіз.
Dialogue: 0,0:06:07.07,0:06:08.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:12.08,0:06:13.91,Default,,0,0,0,,Кез келген пішін жақсы.
Dialogue: 0,0:06:13.99,0:06:17.12,Default,,0,0,0,,Мен сізден бір рет болса да маған қосылуыңызды өтінемін.
Dialogue: 0,0:06:17.21,0:06:20.00,Default,,0,0,0,,Жоқ, мен сенімен кездесуге қарсы емеспін.
Dialogue: 0,0:06:20.08,0:06:23.00,Default,,0,0,0,,Мен қатты ғашық болған адам
Dialogue: 0,0:06:23.09,0:06:27.05,Default,,0,0,0,,Ол менің алдымда осылай көрінді ме?
Dialogue: 0,0:06:27.13,0:06:30.01,Default,,0,0,0,,Мен тіпті кездесуге дайындықты да ұйымдастырдым.
Dialogue: 0,0:06:30.64,0:06:34.60,Default,,0,0,0,,Жәндіктердің жақсылығы сонша, ол шындыққа жанаспайды
Dialogue: 0,0:06:35.10,0:06:37.52,Default,,0,0,0,,Сіз мұны естідіңіз бе, Миямото мырза?
Dialogue: 0,0:06:37.60,0:06:39.02,Default,,0,0,0,,Бұл арман сияқты
Dialogue: 0,0:06:42.40,0:06:43.77,Default,,0,0,0,,басылған
Dialogue: 0,0:06:44.36,0:06:45.53,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:47.61,0:06:50.82,Default,,0,0,0,,Осы бөлмеге кіргеннен бастап осында отырғанға дейін
Dialogue: 0,0:06:50.91,0:06:52.41,Default,,0,0,0,,Мен оны үш рет көрдім
Dialogue: 0,0:06:52.49,0:06:53.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.62,0:06:56.20,Default,,0,0,0,,Тартпа, басыңды ұста
Dialogue: 0,0:06:56.29,0:06:57.41,Default,,0,0,0,,Барлық үш рет
Dialogue: 0,0:06:57.50,0:07:02.92,Default,,0,0,0,,Хехе, кешкі астан кейін кездесуге жақсы уақыт сияқты.
Dialogue: 0,0:07:03.00,0:07:05.04,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:07:05.13,0:07:06.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:12.18,0:07:16.56,Default,,0,0,0,,Доджо картоптары қызметшілерді үйрету және билеу үшін қолданылады
Dialogue: 0,0:07:16.64,0:07:18.06,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:18.64,0:07:20.23,Default,,0,0,0,,жеткілікті
Dialogue: 0,0:07:20.31,0:07:22.15,Default,,0,0,0,,Айтпақшы, Миямото мырза
Dialogue: 0,0:07:22.23,0:07:24.86,Default,,0,0,0,,Кешіріңіз, мен сіздің көңіліңізді түсіретін сияқтымын.
Dialogue: 0,0:07:24.94,0:07:27.02,Default,,0,0,0,,Мен осы мүмкіндікті тағы бір рет пайдаланғым келеді
Dialogue: 0,0:07:27.11,0:07:29.32,Default,,0,0,0,,Мен Доппо Гучи мырзаны таныстырғым келеді.
Dialogue: 0,0:07:29.40,0:07:30.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:31.40,0:07:33.07,Default,,0,0,0,,- (Мицунари) Кано - (Хидеаки Кано) Ха
Dialogue: 0,0:07:35.66,0:07:37.08,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:07:37.16,0:07:41.66,Default,,0,0,0,,Бұл ауызша түсіндіруден жылдамырақ.
Dialogue: 0,0:07:41.75,0:07:44.08,Default,,0,0,0,,Біраз болды, мен де көргім келеді
Dialogue: 0,0:07:44.17,0:07:45.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.17,0:07:47.55,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:07:47.63,0:07:50.09,Default,,0,0,0,,Мен Джи Чанды жеңе алмаймын.
Dialogue: 0,0:07:51.51,0:07:52.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:57.05,0:07:58.10,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:08:09.69,0:08:11.11,Default,,0,0,0,,Ngggggg...
Dialogue: 0,0:08:11.19,0:08:12.49,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:15.28,0:08:16.62,Default,,0,0,0,,Хамф!
Dialogue: 0,0:08:21.70,0:08:23.87,Default,,0,0,0,,Куә!
Dialogue: 0,0:08:23.96,0:08:24.96,Default,,0,0,0,,(көпіршіктердің атқылаған дыбысы)
Dialogue: 0,0:08:25.04,0:08:25.88,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:29.84,0:08:31.01,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:08:36.34,0:08:36.84,Default,,0,0,0,,(құлаған ағаштың дыбысы)
Dialogue: 0,0:08:36.84,0:08:38.05,Default,,0,0,0,,(құлаған ағаштың дыбысы)
Dialogue: 0,0:08:36.84,0:08:38.05,Default,,0,0,0,,Бұл Доппо Гучи.
Dialogue: 0,0:08:38.05,0:08:39.26,Default,,0,0,0,,Бұл Доппо Гучи.
Dialogue: 0,0:08:39.35,0:08:41.77,Default,,0,0,0,,Ол қалай шығады? Мусаши!
Dialogue: 0,0:08:42.39,0:08:43.39,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:44.94,0:08:47.10,Default,,0,0,0,,Жауынгерлік өнерден гөрі би
Dialogue: 0,0:08:47.19,0:08:48.27,Default,,0,0,0,,Бұл би.
Dialogue: 0,0:08:48.36,0:08:51.28,Default,,0,0,0,,Бірақ неге тас пен ағаш?
Dialogue: 0,0:08:51.36,0:08:52.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:52.86,0:08:55.86,Default,,0,0,0,,Не? Теми
Dialogue: 0,0:08:57.87,0:08:59.78,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:08:59.87,0:09:01.79,Default,,0,0,0,,«Би»?
Dialogue: 0,0:09:01.87,0:09:04.29,Default,,0,0,0,,Сіз ашулысыз ба, Гучи мырза?
Dialogue: 0,0:09:04.37,0:09:06.12,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:09:07.00,0:09:09.92,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:09:07.00,0:09:09.92,Default,,0,0,0,,Сіз Доппо Гучи жекпе-жегін көре аласыз!
Dialogue: 0,0:09:10.00,0:09:13.17,Default,,0,0,0,,Би билей ме?
Dialogue: 0,0:09:13.97,0:09:17.43,Default,,0,0,0,,Сіз оны сол денемен сынап көргіңіз келе ме?
Dialogue: 0,0:09:17.51,0:09:19.22,Default,,0,0,0,,Бұл сәйкестік емес!
Dialogue: 0,0:09:19.30,0:09:20.93,Default,,0,0,0,,Бұл шеберлікті салыстыру емес.
Dialogue: 0,0:09:21.01,0:09:22.43,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:09:22.52,0:09:24.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:27.02,0:09:28.69,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:09:28.77,0:09:30.19,Default,,0,0,0,,- (Соло) Хмф! -(Мицунари) Ах...
Dialogue: 0,0:09:34.78,0:09:37.20,Default,,0,0,0,,Мені кешіріңіз, Гучи мырза.
Dialogue: 0,0:09:37.28,0:09:39.45,Default,,0,0,0,,Мен сені аздап мазақтауға тырыстым.
Dialogue: 0,0:09:39.53,0:09:40.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:41.53,0:09:42.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:43.54,0:09:44.95,Default,,0,0,0,,Іс…
Dialogue: 0,0:09:45.04,0:09:49.29,Default,,0,0,0,,Сіз маған бұрын көрсеткен қолмен кесу мүсіні.
Dialogue: 0,0:09:49.38,0:09:52.21,Default,,0,0,0,,Әрине, мен оның «Бу» екенін білдім.
Dialogue: 0,0:09:52.30,0:09:54.21,Default,,0,0,0,,Іс басқаша.
Dialogue: 0,0:09:56.30,0:09:58.22,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:09:58.97,0:10:02.22,Default,,0,0,0,,Мен жалғыз жүрсем де, басқа адамды көре аламын
Dialogue: 0,0:10:02.85,0:10:06.73,Default,,0,0,0,,Күшті қарсылас болмаса да, ол оңай қарсылас емес.
Dialogue: 0,0:10:07.69,0:10:11.44,Default,,0,0,0,,Ауыр және өткір шабуылмен 5 адамды бағындырды.
Dialogue: 0,0:10:12.02,0:10:14.36,Default,,0,0,0,,Сен керемет жұмыс жасадың, Гучи-доно.
Dialogue: 0,0:10:14.44,0:10:16.86,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:10:16.94,0:10:20.24,Default,,0,0,0,,Менің таң қалдырған соққым өтпей қалды.
Dialogue: 0,0:10:20.32,0:10:22.74,Default,,0,0,0,,Жаман болса, ол болмайды.
Dialogue: 0,0:10:22.83,0:10:24.04,Default,,0,0,0,,Хо
Dialogue: 0,0:10:24.87,0:10:26.25,Default,,0,0,0,,Бұл қымбат
Dialogue: 0,0:10:27.25,0:10:30.25,Default,,0,0,0,,Мына тақыр басын сипау қанша тұрады?
Dialogue: 0,0:10:30.88,0:10:32.00,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:10:32.08,0:10:33.75,Default,,0,0,0,,О!
Dialogue: 0,0:10:43.51,0:10:44.56,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:10:46.64,0:10:49.77,Default,,0,0,0,,Хе! Күткендей
Dialogue: 0,0:10:50.35,0:10:52.52,Default,,0,0,0,,Оны дұрыс ұстаңыз
Dialogue: 0,0:10:57.86,0:10:59.32,Default,,0,0,0,,…және
Dialogue: 0,0:11:00.36,0:11:03.07,Default,,0,0,0,,алыс көрінбейтін
Dialogue: 0,0:11:03.16,0:11:07.37,Default,,0,0,0,,Қашықтыққа жоқ қылыш қауіп төндіреді
Dialogue: 0,0:11:11.87,0:11:13.29,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:11:17.88,0:11:19.30,Default,,0,0,0,,О!
Dialogue: 0,0:11:23.39,0:11:24.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:25.05,0:11:26.31,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:11:26.39,0:11:27.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:27.64,0:11:29.52,Default,,0,0,0,,Сәлем, Гучи мырза.
Dialogue: 0,0:11:29.60,0:11:31.81,Default,,0,0,0,,Олар күткендей биледі.
Dialogue: 0,0:11:31.89,0:11:33.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:34.90,0:11:36.65,Default,,0,0,0,,Өлтірудің қажеті жоқ
Dialogue: 0,0:11:40.86,0:11:42.82,Default,,0,0,0,,(қанның тамшылаған дыбысы)
Dialogue: 0,0:11:45.91,0:11:47.33,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:11:48.24,0:11:49.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:50.25,0:11:51.33,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:52.62,0:11:53.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:53.92,0:11:56.00,Default,,0,0,0,,«Аспандағы, үстіңгі және астындағы қалып»
Dialogue: 0,0:11:56.09,0:11:57.17,Default,,0,0,0,,Мотивация!
Dialogue: 0,0:11:57.25,0:11:59.21,Default,,0,0,0,,Мен әлі де жалғыз жүруге ынталымын!
Dialogue: 0,0:11:59.30,0:12:02.34,Default,,0,0,0,,Сізге не болды, Гуджи мырза?
Dialogue: 0,0:12:02.97,0:12:04.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.55,0:12:07.01,Default,,0,0,0,,Тұр, өйткені сен тұра аласың
Dialogue: 0,0:12:07.10,0:12:08.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:09.22,0:12:12.60,Default,,0,0,0,,Сіз оны кесіп алған жоқсыз ба? Сіз мұны байқаған шығарсыз?
Dialogue: 0,0:12:12.69,0:12:14.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:14.19,0:12:18.61,Default,,0,0,0,,Мұнда кесаны диагональ бойынша төмен қарай іліңіз.
Dialogue: 0,0:12:18.69,0:12:20.74,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:12:21.32,0:12:23.36,Default,,0,0,0,,Имитациялық кесу
Dialogue: 0,0:12:23.45,0:12:25.32,Default,,0,0,0,,Соған «еліктеу» дейсіз бе?
Dialogue: 0,0:12:25.41,0:12:26.82,Default,,0,0,0,,Миямото мырза
Dialogue: 0,0:12:26.91,0:12:28.62,Default,,0,0,0,,Сіздің ең үлкен қателігіңіз
Dialogue: 0,0:12:28.70,0:12:31.37,Default,,0,0,0,,Мен бұл жерде шындап тұрған жоқпын.
Dialogue: 0,0:12:31.45,0:12:32.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:32.79,0:12:34.21,Default,,0,0,0,,Еліктеу - еліктеу
Dialogue: 0,0:12:34.29,0:12:37.08,Default,,0,0,0,,Ол іс жүзінде кесілген жоқ.
Dialogue: 0,0:12:39.46,0:12:40.46,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:12:40.96,0:12:41.80,Default,,0,0,0,,Лорд Токугава
Dialogue: 0,0:12:41.88,0:12:42.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.84,0:12:44.13,Default,,0,0,0,,Сенің қылышың бар ма?
Dialogue: 0,0:12:45.26,0:12:48.64,Default,,0,0,0,,Токугава жұқа ма, әлде солған ма, Токугава.
Dialogue: 0,0:12:49.72,0:12:52.02,Default,,0,0,0,,«Ұлттық жолбарыс» ұлттық қазынасы
Dialogue: 0,0:12:52.10,0:12:55.19,Default,,0,0,0,,Аңызға айналған семсерді қарсы алайық
Dialogue: 0,0:12:57.73,0:12:58.94,Default,,0,0,0,,(Суралған қылыштың дыбысы)
Dialogue: 0,0:13:05.86,0:13:07.66,Default,,0,0,0,,Хмм, бұл жақсы қылыш.
Dialogue: 0,0:13:08.41,0:13:09.91,Default,,0,0,0,,Егер бұлай болса, уайымдамаңыз
Dialogue: 0,0:13:14.08,0:13:16.17,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Гучи мырза.
Dialogue: 0,0:13:16.25,0:13:18.17,Default,,0,0,0,,Сізді не қызықтырады?
Dialogue: 0,0:13:18.25,0:13:21.09,Default,,0,0,0,,Оны арандатқан мен болдым.
Dialogue: 0,0:13:21.17,0:13:22.55,Default,,0,0,0,,Жалғыз жүру
Dialogue: 0,0:13:22.63,0:13:24.59,Default,,0,0,0,,Толық түсініктеме кейінірек беріледі
Dialogue: 0,0:13:24.67,0:13:27.89,Default,,0,0,0,,Бұл адам өзін Миямото Мусаши деп атайтын адам...
Dialogue: 0,0:13:27.97,0:13:28.97,Default,,0,0,0,,емес!
Dialogue: 0,0:13:29.05,0:13:31.06,Default,,0,0,0,,Нағыз Миямото Мусаши!
Dialogue: 0,0:13:31.14,0:13:32.31,Default,,0,0,0,,Не?
Dialogue: 0,0:13:32.39,0:13:35.18,Default,,0,0,0,,Егжей-тегжейлі түсіндірудің қажеті жоқ.
Dialogue: 0,0:13:35.27,0:13:38.15,Default,,0,0,0,,Маған логика маңызды емес.
Dialogue: 0,0:13:38.23,0:13:40.06,Default,,0,0,0,,Мен бұл нақты нәрсе деп үміттенемін.
Dialogue: 0,0:13:40.65,0:13:43.48,Default,,0,0,0,,Сол үшін оған қылыш берген жоқсың ба?
Dialogue: 0,0:13:43.98,0:13:46.20,Default,,0,0,0,,Оны жай ғана мазақ етпе! Доппо!
Dialogue: 0,0:13:46.28,0:13:49.07,Default,,0,0,0,,Жынға темір сойыл емес, Мұсашыға қылыш!
Dialogue: 0,0:13:49.16,0:13:50.83,Default,,0,0,0,,Бұл нені білдіреді...
Dialogue: 0,0:13:50.91,0:13:53.45,Default,,0,0,0,,Бұл адам жалғыз қару емес.
Dialogue: 0,0:13:55.54,0:13:57.96,Default,,0,0,0,,Каратэде бес дене қару болып табылады.
Dialogue: 0,0:13:58.58,0:14:01.96,Default,,0,0,0,,Қол қылыш, аяқ қылыш, семсерге алдыңғы тепкі
Dialogue: 0,0:14:02.04,0:14:05.21,Default,,0,0,0,,Қылыш пен найзаның бәрі қадірлі.
Dialogue: 0,0:14:05.92,0:14:07.09,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:14:07.80,0:14:09.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:11.30,0:14:13.47,Default,,0,0,0,,Күлкілі бірдеңе айтыңыз
Dialogue: 0,0:14:13.56,0:14:16.73,Default,,0,0,0,,Сіз сондай күлкілісіз хахаха...
Dialogue: 0,0:14:16.81,0:14:18.23,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:19.81,0:14:22.65,Default,,0,0,0,,Құдай емес адам «соғыс құдайы» деп аталады.
Dialogue: 0,0:14:22.73,0:14:24.98,Default,,0,0,0,,Оны адам да қабылдайды.
Dialogue: 0,0:14:25.07,0:14:29.11,Default,,0,0,0,,Бір жапырақ қағаз, еті кесілмеген қылыш немесе найза.
Dialogue: 0,0:14:29.20,0:14:31.37,Default,,0,0,0,,Бұл енді билеуге тұрарлық емес!
Dialogue: 0,0:14:32.99,0:14:34.62,Default,,0,0,0,,Хмф! Алақай!
Dialogue: 0,0:14:47.34,0:14:49.26,Default,,0,0,0,,(жеке тыныс алу дыбысы)
Dialogue: 0,0:14:50.34,0:14:51.34,Default,,0,0,0,,Кесу…
Dialogue: 0,0:14:56.64,0:14:59.27,Default,,0,0,0,,Хмм, кесу жоқ.
Dialogue: 0,0:15:00.56,0:15:03.65,Default,,0,0,0,,Тек оған қысым жасаңыз
Dialogue: 0,0:15:06.65,0:15:10.28,Default,,0,0,0,,Жай басу оны кеспейді. Жай басу оны кеспейді.
Dialogue: 0,0:15:10.36,0:15:11.78,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:15:14.87,0:15:16.24,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:15:18.37,0:15:20.92,Default,,0,0,0,,Соғып, тартпасаң, кеспейді.
Dialogue: 0,0:15:22.96,0:15:24.79,Default,,0,0,0,,Пышақ дегеніміз не?
Dialogue: 0,0:15:24.88,0:15:27.05,Default,,0,0,0,,Тері дегеніміз не?
Dialogue: 0,0:15:27.13,0:15:30.09,Default,,0,0,0,,Аты аңызға айналған қылыш «Көкутора» болса да
Dialogue: 0,0:15:30.17,0:15:32.93,Default,,0,0,0,,Ол логикадан ауытқу мүмкін емес.
Dialogue: 0,0:15:36.01,0:15:37.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:38.02,0:15:40.43,Default,,0,0,0,,О, мынау...
Dialogue: 0,0:15:41.19,0:15:43.81,Default,,0,0,0,,Мен бұл туралы көп ойлануым керек.
Dialogue: 0,0:15:44.69,0:15:47.07,Default,,0,0,0,,«Қағазды кесуге болмайды»?
Dialogue: 0,0:15:47.15,0:15:48.57,Default,,0,0,0,,Төтенше
Dialogue: 0,0:15:48.65,0:15:52.82,Default,,0,0,0,,Гучи мырза, сіздің қол-аяқтарыңыз жақсы жүздер.
Dialogue: 0,0:15:53.45,0:15:56.08,Default,,0,0,0,,Менің аяғымда жеңілгендер сәждеде жатыр.
Dialogue: 0,0:15:56.16,0:15:58.33,Default,,0,0,0,,Керемет мақтау
Dialogue: 0,0:15:59.12,0:16:02.33,Default,,0,0,0,,Мақтағанымен, шындық өзгеріссіз қалады
Dialogue: 0,0:16:03.29,0:16:04.92,Default,,0,0,0,,сызылған
Dialogue: 0,0:16:06.17,0:16:09.59,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:16:10.26,0:16:12.09,Default,,0,0,0,,Клондау
Dialogue: 0,0:16:12.17,0:16:14.26,Default,,0,0,0,,Түсіндіру ұзақ болғанымен,
Dialogue: 0,0:16:14.34,0:16:18.10,Default,,0,0,0,,Жоғарыда «Миямото Мусашидің» туу тарихы берілген.
Dialogue: 0,0:16:20.18,0:16:21.93,Default,,0,0,0,,Келісесіз бе?
Dialogue: 0,0:16:22.43,0:16:26.94,Default,,0,0,0,,Өзімді сендіру үшін білімім жеткіліксіз
Dialogue: 0,0:16:27.44,0:16:30.86,Default,,0,0,0,,Бес денеге қашалған естеліктер ғана
Dialogue: 0,0:16:30.94,0:16:34.61,Default,,0,0,0,,Оның Миямото Мусаши екенін түсініңіз
Dialogue: 0,0:16:36.41,0:16:37.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:37.70,0:16:38.74,Default,,0,0,0,,
Dialogue: 0,0:16:38.83,0:16:40.66,Default,,0,0,0,,Мұны есту қиын.
Dialogue: 0,0:16:40.74,0:16:43.62,Default,,0,0,0,,Мм... бұл нәтиже туралы.
Dialogue: 0,0:16:43.71,0:16:46.46,Default,,0,0,0,,Жекпе-жекте жеңілу
Dialogue: 0,0:16:46.54,0:16:48.34,Default,,0,0,0,,Ал жекпе-жек өнерінде жеңілген
Dialogue: 0,0:16:48.42,0:16:51.13,Default,,0,0,0,,Сергітетін толық жеңіліс.
Dialogue: 0,0:16:52.01,0:16:55.38,Default,,0,0,0,,Жапон қылыш деп аталатын ерекше өткір жүз
Dialogue: 0,0:16:56.01,0:16:57.47,Default,,0,0,0,,Жартысын кесіңіз
Dialogue: 0,0:16:57.55,0:17:00.39,Default,,0,0,0,,Егер мені бамбук кесектеріне кессе, жақсы болар еді.
Dialogue: 0,0:17:01.18,0:17:04.31,Default,,0,0,0,,Соқ, басыңыз, бірақ кеспеңіз
Dialogue: 0,0:17:04.39,0:17:08.02,Default,,0,0,0,,Оны аман-есен бағындыруға тырысатын сияқты.
Dialogue: 0,0:17:08.11,0:17:13.03,Default,,0,0,0,,Токугава мырза, бұл жігіт жеңіліске қарағанда әлдеқайда жаман.
Dialogue: 0,0:17:13.11,0:17:15.82,Default,,0,0,0,,Қарсыласыңыз сізге қамқор болады.
Dialogue: 0,0:17:15.90,0:17:17.53,Default,,0,0,0,,Солдаттар да тоқтауы керек.
Dialogue: 0,0:17:18.24,0:17:20.70,Default,,0,0,0,,Кесілгеннен гөрі ауырады
Dialogue: 0,0:17:21.37,0:17:24.91,Default,,0,0,0,,Айтарға сөз таппай отырмын
Dialogue: 0,0:17:25.00,0:17:27.54,Default,,0,0,0,,Рахмет, Джикчан.
Dialogue: 0,0:17:27.62,0:17:29.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:30.96,0:17:33.67,Default,,0,0,0,,Кітап сөресін безендіру «Бес сақина кітабы».
Dialogue: 0,0:17:35.76,0:17:38.93,Default,,0,0,0,,Мен оны неше рет қайта оқыдым?
Dialogue: 0,0:17:39.68,0:17:41.68,Default,,0,0,0,,Неғұрлым көп жаттайсыз
Dialogue: 0,0:17:42.81,0:17:44.10,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:17:44.18,0:17:47.14,Default,,0,0,0,,Мен шындықты түсіне алмаған сияқтымын.
Dialogue: 0,0:17:47.23,0:17:49.56,Default,,0,0,0,,Сол кезде мен түсіндім
Dialogue: 0,0:17:50.65,0:17:54.07,Default,,0,0,0,,Түсіндім, бұл автордың өзі емес.
Dialogue: 0,0:17:54.15,0:17:56.53,Default,,0,0,0,,Бұл жаста айтылған.
Dialogue: 0,0:17:56.61,0:17:58.70,Default,,0,0,0,,«Бұл болып жатқандай емес.»
Dialogue: 0,0:17:58.78,0:18:02.20,Default,,0,0,0,,Сіз баруды жоспарлап отырсыз ба? Сіз оны тартуды жоспарлап отырсыз ба?
Dialogue: 0,0:18:03.91,0:18:04.95,Default,,0,0,0,,(жұтатын дыбыс)
Dialogue: 0,0:18:06.00,0:18:09.08,Default,,0,0,0,,Хаа... Мен біраз уақыт үй ішінде қалатын шығармын.
Dialogue: 0,0:18:09.17,0:18:10.38,Default,,0,0,0,,(мазасыздық)
Dialogue: 0,0:18:10.46,0:18:11.96,Default,,0,0,0,,Нарита әуежайы
Dialogue: 0,0:18:12.46,0:18:15.21,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:17.55,0:18:20.72,Default,,0,0,0,,Сіріңкенің өзі көрме деп естідім.
Dialogue: 0,0:18:20.80,0:18:23.47,Default,,0,0,0,,Ресми матч еместігіне қатысты
Dialogue: 0,0:18:23.56,0:18:24.97,Default,,0,0,0,,Ол қалай қабылданады?
Dialogue: 0,0:18:26.02,0:18:27.48,Default,,0,0,0,,Аяқтарды қолданбай
Dialogue: 0,0:18:28.39,0:18:29.98,Default,,0,0,0,,Тізені қолданбай
Dialogue: 0,0:18:30.77,0:18:32.48,Default,,0,0,0,,Шынтақты қолданбай
Dialogue: 0,0:18:33.73,0:18:35.48,Default,,0,0,0,,Тек екі жұдырық
Dialogue: 0,0:18:37.61,0:18:39.66,Default,,0,0,0,,Болт мырзаның тек жоғарғы денесі
Dialogue: 0,0:18:39.74,0:18:41.70,Default,,0,0,0,,Тек алдыңғы жақтан шабуылдау арқылы
Dialogue: 0,0:18:41.78,0:18:42.62,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:42.70,0:18:44.58,Default,,0,0,0,,Шайқаста жеңіске жетті
Dialogue: 0,0:18:45.83,0:18:47.58,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:18:48.08,0:18:50.50,Default,,0,0,0,,Ештеңе артық, кем емес
Dialogue: 0,0:18:50.58,0:18:54.25,Default,,0,0,0,,〝Ауыр салмақтағы әлем чемпионы〞
Dialogue: 0,0:18:50.58,0:18:54.25,Default,,0,0,0,,Ресми немесе бейресми?
Dialogue: 0,0:18:55.75,0:18:58.76,Default,,0,0,0,,Немесе сізге Кайзер мырза берген мына белбеу.
Dialogue: 0,0:18:59.55,0:19:01.89,Default,,0,0,0,,Ресми немесе бейресми?
Dialogue: 0,0:19:02.39,0:19:05.10,Default,,0,0,0,,Менің білуімше емес
Dialogue: 0,0:19:05.18,0:19:06.39,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:19:06.47,0:19:08.14,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:08.85,0:19:11.10,Default,,0,0,0,,Қытай жекпе-жек өнерінің негізгі ісі
Dialogue: 0,0:19:11.19,0:19:13.61,Default,,0,0,0,,Оның бір бөлігін ғана қолдану арқылы
Dialogue: 0,0:19:14.11,0:19:16.02,Default,,0,0,0,,Бокс ережесімен жеңіске жетті
Dialogue: 0,0:19:16.98,0:19:18.03,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:18.11,0:19:19.28,Default,,0,0,0,,
Dialogue: 0,0:19:19.36,0:19:22.03,Default,,0,0,0,,- (В репортер) А... Рецу! -(Репортер С) Рецу-сан!
Dialogue: 0,0:19:23.28,0:19:25.78,Default,,0,0,0,,Жапониядағы болашақ іс-әрекеттеріңіз қандай?
Dialogue: 0,0:19:25.87,0:19:28.12,Default,,0,0,0,,Боксшы Реккайо бейресми
Dialogue: 0,0:19:28.62,0:19:30.08,Default,,0,0,0,,Қорғану мүмкін емес
Dialogue: 0,0:19:30.58,0:19:33.42,Default,,0,0,0,,Боксшы ретіндегі іс-әрекет аяқталады
Dialogue: 0,0:19:33.50,0:19:35.71,Default,,0,0,0,,Жапонияда не істейсің?
Dialogue: 0,0:19:35.79,0:19:38.01,Default,,0,0,0,,Басқа сәйкестіктер жоқ па?
Dialogue: 0,0:19:40.51,0:19:43.05,Default,,0,0,0,,Барлығы, бірақ кейбіреулері емес
Dialogue: 0,0:19:43.14,0:19:44.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.85,0:19:46.18,Default,,0,0,0,,Жұдырық
Dialogue: 0,0:19:47.14,0:19:49.31,Default,,0,0,0,,Жамбас, яғни тебу
Dialogue: 0,0:19:50.27,0:19:51.44,Default,,0,0,0,,Жазалаушы
Dialogue: 0,0:19:52.02,0:19:54.19,Default,,0,0,0,,Қылыш найза клубы
Dialogue: 0,0:19:54.27,0:19:56.27,Default,,0,0,0,,Шурикенге дейін
Dialogue: 0,0:19:57.48,0:20:01.57,Default,,0,0,0,,Олардың барлығын пайдалана алатын қарсылас Жапонияда пайда болды!
Dialogue: 0,0:20:01.65,0:20:04.57,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:20:04.66,0:20:06.03,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:20:07.24,0:20:09.91,Default,,0,0,0,,Гучи мырза ес-түссіз жатыр ма?
Dialogue: 0,0:20:10.41,0:20:11.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:12.37,0:20:15.33,Default,,0,0,0,,Шамамен айтқанда...
Dialogue: 0,0:20:16.46,0:20:18.09,Default,,0,0,0,,Жоғалдың ба?
Dialogue: 0,0:20:18.17,0:20:22.47,Default,,0,0,0,,Қарғыс атсын... Доппо Гучи дарынды адам.
Dialogue: 0,0:20:22.55,0:20:25.89,Default,,0,0,0,,Үздік жекпе-жек шеберлері мен каратэшілердің бірі...
Dialogue: 0,0:20:25.97,0:20:27.35,Default,,0,0,0,,Мықты бол
Dialogue: 0,0:20:28.93,0:20:31.60,Default,,0,0,0,,Әлемдегі ең үздік каратэші
Dialogue: 0,0:20:32.14,0:20:34.06,Default,,0,0,0,,Бірақ мен жеңілдім.
Dialogue: 0,0:20:34.14,0:20:36.36,Default,,0,0,0,,Теңдесі жоқ мазмұнымен
Dialogue: 0,0:20:36.98,0:20:39.11,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:20:41.65,0:20:43.78,Default,,0,0,0,,Бұл жерде ешқандай қате жоқ.
Dialogue: 0,0:20:43.86,0:20:45.95,Default,,0,0,0,,Бұл шағымдануға болмайтын қорытынды.
Dialogue: 0,0:20:46.03,0:20:46.87,Default,,0,0,0,,Егер...
Dialogue: 0,0:20:47.62,0:20:51.62,Default,,0,0,0,,Мен Мұсашимен немесе басқалармен күресуге тырыссам да
Dialogue: 0,0:20:52.70,0:20:56.38,Default,,0,0,0,,Бұл кек алу емес, бұл Катцуми Гучидің жеке кездесуі.
Dialogue: 0,0:20:56.46,0:20:57.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:58.54,0:20:59.88,Default,,0,0,0,,Мен қару қолданамын
Dialogue: 0,0:21:02.34,0:21:05.38,Default,,0,0,0,,Біртүрлі ештеңе айтпа, Реккайо-сан.
Dialogue: 0,0:21:05.47,0:21:06.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.97,0:21:10.14,Default,,0,0,0,,Біріншіден, каратэ де, қытайлық жекпе-жек өнері де
Dialogue: 0,0:21:10.22,0:21:13.64,Default,,0,0,0,,Бұл жан-жақты жекпе-жек өнерінің барлық бағыттарға бағытталған техникасы емес пе еді?
Dialogue: 0,0:21:13.73,0:21:16.44,Default,,0,0,0,,Көп ойыншыға қарсы қаруға қарсы
Dialogue: 0,0:21:16.52,0:21:20.40,Default,,0,0,0,,Ешқашан тапсырысқа шағымданбайтын жалаң қолмен сауда компаниясы!
Dialogue: 0,0:21:20.48,0:21:25.90,Default,,0,0,0,,Біз жекпе-жек пен каратэге келгенде шынымен де осыны қалайтынбыз емес пе?
Dialogue: 0,0:21:29.62,0:21:31.66,Default,,0,0,0,,Мен оны бейне сайттан көрдім
Dialogue: 0,0:21:33.20,0:21:36.79,Default,,0,0,0,,Тек бір адам бес полицейдің қоршауында
Dialogue: 0,0:21:39.17,0:21:40.54,Default,,0,0,0,,Бірінен соң бірі...
Dialogue: 0,0:21:40.63,0:21:41.50,Default,,0,0,0,,(Бейне: аудио жоқ)
Dialogue: 0,0:21:41.50,0:21:42.67,Default,,0,0,0,,(Бейне: аудио жоқ)
Dialogue: 0,0:21:41.50,0:21:42.67,Default,,0,0,0,,Оқиғасыз бірінен соң бірі
Dialogue: 0,0:21:42.67,0:21:43.80,Default,,0,0,0,,Оқиғасыз бірінен соң бірі
Dialogue: 0,0:21:46.22,0:21:48.26,Default,,0,0,0,,Бұл ойын сияқты емес.
Dialogue: 0,0:21:49.89,0:21:52.81,Default,,0,0,0,,Ондай жағдайда 5 адамның орнына 20 адам болса да.
Dialogue: 0,0:21:53.52,0:21:55.48,Default,,0,0,0,,Нәтиже бірдей болар еді
Dialogue: 0,0:21:56.52,0:21:58.77,Default,,0,0,0,,Сіз мұны көрдіңіз бе?
Dialogue: 0,0:21:58.85,0:22:00.69,Default,,0,0,0,,Мойындауды жек көремін, бірақ
Dialogue: 0,0:22:00.77,0:22:05.94,Default,,0,0,0,,Біз қолданатын қаруға қарсы әдістер мұндай деңгейге арналмаған.
Dialogue: 0,0:22:06.03,0:22:09.87,Default,,0,0,0,,Мұны түсінбейтін Кацуми-сан болуы мүмкін емес.
Dialogue: 0,0:22:12.33,0:22:13.33,Default,,0,0,0,,Катцуми мырза
Dialogue: 0,0:22:13.41,0:22:14.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:14.66,0:22:16.87,Default,,0,0,0,,Қаруыңызды қолданудан тартынбаңыз.
Dialogue: 0,0:22:17.37,0:22:20.04,Default,,0,0,0,,Ол кісі туралы ойланба!
Dialogue: 0,0:22:21.79,0:22:26.80,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.17,0:23:50.17,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory