Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.55,0:01:39.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:47.81,0:01:48.73,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:01:48.81,0:01:50.52,Default,,0,0,0,,Жүктеп салмаңыз
Dialogue: 0,0:01:51.11,0:01:52.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:52.23,0:01:54.11,Default,,0,0,0,,Ол жекпе-жек шебері.
Dialogue: 0,0:01:54.19,0:01:55.15,Default,,0,0,0,,Баки-сан
Dialogue: 0,0:01:55.24,0:01:57.65,Default,,0,0,0,,Мынау
Dialogue: 0,0:01:57.74,0:02:01.24,Default,,0,0,0,,Менің курткам ауыр көрінеді.
Dialogue: 0,0:02:01.32,0:02:02.24,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:02:02.74,0:02:05.16,Default,,0,0,0,,Осылайша орнату аяқталды.
Dialogue: 0,0:02:05.25,0:02:07.91,Default,,0,0,0,,Бүгін түнде ереже солай болса
Dialogue: 0,0:02:08.00,0:02:11.42,Default,,0,0,0,,Рецу-санға ұқсайды.
Dialogue: 0,0:02:11.50,0:02:13.75,Default,,0,0,0,,Мен сияқтысыз ба?
Dialogue: 0,0:02:15.00,0:02:15.92,Default,,0,0,0,,Жәрмеңке
Dialogue: 0,0:02:16.92,0:02:21.68,Default,,0,0,0,,Біз самурайлармен айналысатындықтан, қаруға рұқсат берсек, бұл әділ болады.
Dialogue: 0,0:02:21.76,0:02:25.77,Default,,0,0,0,,Оның руханилығы Реккайо-санды өте еске түсіреді.
Dialogue: 0,0:02:26.93,0:02:28.18,Default,,0,0,0,,Қызғаншақ болмаңыз
Dialogue: 0,0:02:28.27,0:02:31.23,Default,,0,0,0,,«Сен самурайсың, сондықтан қылыш қолдану керек».
Dialogue: 0,0:02:32.02,0:02:34.44,Default,,0,0,0,,Мен бұл сөзді айта алмадым.
Dialogue: 0,0:02:34.98,0:02:36.19,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:02:36.28,0:02:37.19,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:02:37.28,0:02:39.20,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:02:39.28,0:02:40.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:40.78,0:02:43.70,Default,,0,0,0,,Бұл жағымсыз болуы мүмкін, бірақ
Dialogue: 0,0:02:44.45,0:02:47.45,Default,,0,0,0,,Миямото Мусашидің қылышсыз күші...
Dialogue: 0,0:02:48.08,0:02:51.21,Default,,0,0,0,,3 күн бұрын Бір-бірімізге қолымызбен тигіземіз.
Dialogue: 0,0:02:54.00,0:02:56.71,Default,,0,0,0,,Қолында қылышсыз Миямото Мусаши
Dialogue: 0,0:02:57.59,0:03:00.18,Default,,0,0,0,,Сол кезде менімен бес минут бес минут болды.
Dialogue: 0,0:03:00.68,0:03:04.26,Default,,0,0,0,,Немесе менен жақсырақ шығар
Dialogue: 0,0:03:04.35,0:03:06.72,Default,,0,0,0,,(Дыбыстық дауыс)
Dialogue: 0,0:03:12.56,0:03:13.73,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:13.81,0:03:15.65,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:15.73,0:03:18.48,Default,,0,0,0,,Бір-бірімізді өлтірмекпіз.
Dialogue: 0,0:03:18.57,0:03:21.24,Default,,0,0,0,,Шынында олай емес.
Dialogue: 0,0:03:21.86,0:03:25.99,Default,,0,0,0,,Бір нәрсеге толқығандай.
Dialogue: 0,0:03:26.58,0:03:28.49,Default,,0,0,0,,«Қызықты»
Dialogue: 0,0:03:29.41,0:03:30.87,Default,,0,0,0,,Жетілмегендіктен—
Dialogue: 0,0:03:31.62,0:03:35.34,Default,,0,0,0,,Мейкёдан алыстағы газсыз су
Dialogue: 0,0:03:35.84,0:03:38.67,Default,,0,0,0,,Көтерілген намысымды тоқтата алмаймын
Dialogue: 0,0:03:38.76,0:03:39.80,Default,,0,0,0,,Кесу мен байлау қуанышында бұлт жоқ
Dialogue: 0,0:03:39.80,0:03:43.26,Default,,0,0,0,,Кесу, байлау қуанышында бұлт жоқ
Dialogue: 0,0:03:39.80,0:03:43.26,Default,,0,0,0,,(қуаныш естіледі)
Dialogue: 0,0:03:43.34,0:03:44.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:43.34,0:03:44.51,Default,,0,0,0,,♬~
Dialogue: 0,0:03:44.51,0:03:44.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:44.59,0:03:46.26,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:44.59,0:03:46.26,Default,,0,0,0,,- (2-ер адам) Бұл шықты! -(3-ер адам) Бұл не?
Dialogue: 0,0:03:46.35,0:03:47.72,Default,,0,0,0,,Миямото Мусаши?
Dialogue: 0,0:03:47.81,0:03:48.93,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:03:49.02,0:03:51.10,Default,,0,0,0,,Қандай керемет жүз.
Dialogue: 0,0:03:51.18,0:03:52.94,Default,,0,0,0,,«Ардагерлер соғысы» туралы не айтасыз?
Dialogue: 0,0:03:53.02,0:03:54.60,Default,,0,0,0,,Бұл мен теледидардан көрген жүзім.
Dialogue: 0,0:03:54.69,0:03:56.02,Default,,0,0,0,,Шынымен де шынайы көрінеді
Dialogue: 0,0:03:56.11,0:03:57.57,Default,,0,0,0,,Мен қылышымды созамын
Dialogue: 0,0:03:57.65,0:03:59.90,Default,,0,0,0,,- (Еркек 10) Мен сені кесіп тастаймын! -(Еркек 11) Сізге жарасады.
Dialogue: 0,0:03:59.98,0:04:02.36,Default,,0,0,0,,Күткендей, бұл сурет!
Dialogue: 0,0:04:03.61,0:04:06.53,Default,,0,0,0,,Ол мені бір қарағанда түсіндірді
Dialogue: 0,0:04:07.33,0:04:09.62,Default,,0,0,0,,Бұл шынайы.
Dialogue: 0,0:04:10.83,0:04:12.04,Default,,0,0,0,,
Dialogue: 0,0:04:12.62,0:04:13.96,Default,,0,0,0,,Рецу!
Dialogue: 0,0:04:14.04,0:04:15.54,Default,,0,0,0,,Міне, Сәлем!
Dialogue: 0,0:04:15.63,0:04:17.54,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,0:04:17.63,0:04:19.05,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:04:19.13,0:04:20.55,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:04:20.63,0:04:21.92,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:04:22.01,0:04:24.01,Default,,0,0,0,,Кесіңіз!
Dialogue: 0,0:04:34.14,0:04:35.73,Default,,0,0,0,,Негізгі жиналыс
Dialogue: 0,0:04:35.81,0:04:38.86,Default,,0,0,0,,Ол арнайы ережелер бойынша жүзеге асырылады.
Dialogue: 0,0:04:38.94,0:04:42.36,Default,,0,0,0,,Мұнда орнатылған барлық қаруды пайдалануға рұқсат етіледі.
Dialogue: 0,0:04:42.44,0:04:46.07,Default,,0,0,0,,Екі жақ дайындаған қаруларға да солай.
Dialogue: 0,0:04:46.16,0:04:46.66,Default,,0,0,0,,(Көрермендердің дем алған дыбысы)
Dialogue: 0,0:04:46.66,0:04:49.16,Default,,0,0,0,,(Көрермендердің дем алған дыбысы)
Dialogue: 0,0:04:46.66,0:04:49.16,Default,,0,0,0,,Бір ғана құқық бұзушылық бар: атыс қаруын қолдану.
Dialogue: 0,0:04:49.16,0:04:50.08,Default,,0,0,0,,Бір ғана құқық бұзушылық бар: атыс қаруын қолдану.
Dialogue: 0,0:04:54.16,0:04:55.87,Default,,0,0,0,,Бастапқы ұстаным!
Dialogue: 0,0:05:02.71,0:05:05.84,Default,,0,0,0,,Рецу-сан, сен керемет көрінесің!
Dialogue: 0,0:05:05.93,0:05:07.26,Default,,0,0,0,,Иә
Dialogue: 0,0:05:08.68,0:05:10.60,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,0:05:13.18,0:05:14.43,Default,,0,0,0,,) Ммм.
Dialogue: 0,0:05:14.52,0:05:15.60,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:05:15.69,0:05:16.85,Default,,0,0,0,,Бастау!
Dialogue: 0,0:05:16.94,0:05:18.35,Default,,0,0,0,,Хамф!
Dialogue: 0,0:05:20.44,0:05:23.32,Default,,0,0,0,,Бүкіл аудитория таң қалды.
Dialogue: 0,0:05:23.82,0:05:26.86,Default,,0,0,0,,Көңіл-күй, тіпті күбір-сыбыр да болған жоқ.
Dialogue: 0,0:05:26.95,0:05:28.45,Default,,0,0,0,,Соңында
Dialogue: 0,0:05:28.53,0:05:30.37,Default,,0,0,0,,Ақыры жетіп алдым.
Dialogue: 0,0:05:31.16,0:05:33.70,Default,,0,0,0,,Біз бір-бірімізді өлтіріп жатқанымызды көреміз
Dialogue: 0,0:05:34.70,0:05:35.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:36.96,0:05:40.63,Default,,0,0,0,,Біз енді ғана басталып жатырмыз.
Dialogue: 0,0:05:41.50,0:05:46.22,Default,,0,0,0,,Тыныштықты дәл осы адам бұзды.
Dialogue: 0,0:05:46.72,0:05:48.13,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:05:49.80,0:05:51.76,Default,,0,0,0,,Еш нәрсе ұзаққа созылмайды
Dialogue: 0,0:05:51.85,0:05:54.64,Default,,0,0,0,,Ең қысқа мерзімде ең жылдам мәре?
Dialogue: 0,0:05:57.14,0:05:58.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:58.73,0:05:59.65,Default,,0,0,0,,Пышақ?
Dialogue: 0,0:05:59.73,0:06:00.65,Default,,0,0,0,,Шүрікен?
Dialogue: 0,0:06:03.44,0:06:04.36,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:07.07,0:06:07.90,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:14.74,0:06:16.16,Default,,0,0,0,,Сіз сәтті өттіңіз!
Dialogue: 0,0:06:16.25,0:06:17.66,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:17.75,0:06:20.33,Default,,0,0,0,,Оның жылдам болғаны сонша, кейінгі кескін пайда болады.
Dialogue: 0,0:06:20.42,0:06:23.17,Default,,0,0,0,,Егер бұл сіздің бірінші атуыңыз болса, бұл мүмкін емес.
Dialogue: 0,0:06:31.76,0:06:32.68,Default,,0,0,0,,Екі жақты!
Dialogue: 0,0:06:32.76,0:06:33.93,Default,,0,0,0,,О!
Dialogue: 0,0:06:34.85,0:06:35.93,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:06:36.02,0:06:37.43,Default,,0,0,0,,Оңды және солды пайдаланыңыз!
Dialogue: 0,0:06:41.15,0:06:43.06,Default,,0,0,0,,Уа, мен оны ұстадым!
Dialogue: 0,0:07:05.17,0:07:05.67,Default,,0,0,0,,
Dialogue: 0,0:07:05.67,0:07:07.17,Default,,0,0,0,,
Dialogue: 0,0:07:05.67,0:07:07.17,Default,,0,0,0,,Жарайды ма? Мұндай нәрсені көру дұрыс па?
Dialogue: 0,0:07:07.17,0:07:09.05,Default,,0,0,0,,Жарайды ма? Мұндай нәрсені көру дұрыс па?
Dialogue: 0,0:07:09.92,0:07:12.59,Default,,0,0,0,,Теледидарда, фильмдерде, комикстерде
Dialogue: 0,0:07:13.51,0:07:15.81,Default,,0,0,0,,Талай рет көрген қару
Dialogue: 0,0:07:15.89,0:07:17.10,Default,,0,0,0,,Шүрікен
Dialogue: 0,0:07:17.68,0:07:22.19,Default,,0,0,0,,Ол жеңіл көрінгенімен, оның қуаты қуырғыш табаны тесіп өтеді.
Dialogue: 0,0:07:23.35,0:07:26.11,Default,,0,0,0,,Мұндай затты адам денесіне лақтыру
Dialogue: 0,0:07:26.86,0:07:28.86,Default,,0,0,0,,Бар күшіммен, көп
Dialogue: 0,0:07:29.78,0:07:31.36,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:07:31.95,0:07:34.74,Default,,0,0,0,,жалтару
Dialogue: 0,0:07:34.82,0:07:37.62,Default,,0,0,0,,Жалаң қолмен ұстау Жалаң қолмен ұстау
Dialogue: 0,0:07:38.95,0:07:40.12,Default,,0,0,0,,Аматсуса...
Dialogue: 0,0:07:41.83,0:07:43.21,Default,,0,0,0,,Екеуін де кесіңіз...
Dialogue: 0,0:07:44.46,0:07:45.17,Default,,0,0,0,,
Dialogue: 0,0:07:45.17,0:07:46.17,Default,,0,0,0,,
Dialogue: 0,0:07:45.17,0:07:46.17,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:07:46.17,0:07:46.46,Default,,0,0,0,,
Dialogue: 0,0:07:47.59,0:07:49.88,Default,,0,0,0,,Қолым терлеп жатыр, бірақ мен бар күшімді саламын.
Dialogue: 0,0:07:49.96,0:07:50.72,Default,,0,0,0,,(аудиторияның дірілдеген дауыстары)
Dialogue: 0,0:07:50.72,0:07:51.72,Default,,0,0,0,,(аудиторияның дірілдеген дауыстары)
Dialogue: 0,0:07:50.72,0:07:51.72,Default,,0,0,0,,Қайнату мүмкін емес
Dialogue: 0,0:07:51.72,0:07:52.30,Default,,0,0,0,,(аудиторияның дірілдеген дауыстары)
Dialogue: 0,0:07:52.38,0:07:53.97,Default,,0,0,0,,Әрекет ету мүмкін емес
Dialogue: 0,0:07:55.09,0:07:57.60,Default,,0,0,0,,Мен білетін бір ғана нәрсе бар.
Dialogue: 0,0:07:58.22,0:08:01.64,Default,,0,0,0,,Оқиғасыз, боқсыз маған ұсынылған факт.
Dialogue: 0,0:08:02.23,0:08:04.73,Default,,0,0,0,,Ең қабылданбайтын фактілер
Dialogue: 0,0:08:06.02,0:08:09.65,Default,,0,0,0,,Бұл Миямото Мусаши шынайы!
Dialogue: 0,0:08:09.73,0:08:12.40,Default,,0,0,0,,Мен қылышымды қынап алдым.
Dialogue: 0,0:08:16.78,0:08:18.16,Default,,0,0,0,,Ол бос
Dialogue: 0,0:08:18.24,0:08:19.91,Default,,0,0,0,,Мен таусылып қалдым
Dialogue: 0,0:08:24.00,0:08:25.42,Default,,0,0,0,,
Dialogue: 0,0:08:35.76,0:08:36.89,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:08:41.02,0:08:42.35,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:42.43,0:08:44.85,Default,,0,0,0,,Бұл коррида сияқты...
Dialogue: 0,0:08:44.94,0:08:46.19,Default,,0,0,0,,Бұл шапан сияқты
Dialogue: 0,0:08:47.48,0:08:49.19,Default,,0,0,0,,Одан алыс
Dialogue: 0,0:08:49.27,0:08:50.61,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:54.28,0:08:55.57,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:08:55.66,0:08:56.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.37,0:09:03.16,Default,,0,0,0,,Ол кептеліп қалды! тырнақтар немесе тістер
Dialogue: 0,0:09:03.25,0:09:04.46,Default,,0,0,0,,Бұл шолақ мылтық сияқты.
Dialogue: 0,0:09:04.54,0:09:05.62,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:21.93,0:09:23.93,Default,,0,0,0,,
Dialogue: 0,0:09:26.10,0:09:27.19,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:27.69,0:09:30.11,Default,,0,0,0,,Жай ғана жыпылықтаңыз!
Dialogue: 0,0:09:30.69,0:09:35.19,Default,,0,0,0,,Көз алмасына тура тигеніне қарамастан, ол әлсіздік көрсетпейді!
Dialogue: 0,0:09:39.99,0:09:40.87,Default,,0,0,0,,Иә
Dialogue: 0,0:09:41.62,0:09:44.12,Default,,0,0,0,,Бала немесе Рецукай патша
Dialogue: 0,0:09:44.70,0:09:47.79,Default,,0,0,0,,Шүрікеннің қасында ұсақталған құм.
Dialogue: 0,0:09:47.87,0:09:52.88,Default,,0,0,0,,Снарядтар артымыздан келе жатыр, бірақ сен олардың жақындағанын қаламайсың, Реккайо.
Dialogue: 0,0:09:52.96,0:09:55.38,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:09:55.46,0:09:56.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:55.46,0:09:56.97,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:09:56.97,0:09:57.05,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:09:57.05,0:09:58.88,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:09:57.05,0:09:58.88,Default,,0,0,0,,Жақсы, Рецу-сан.
Dialogue: 0,0:09:58.97,0:10:04.64,Default,,0,0,0,,Лақтыратын заттарың таусылып қалса, неге түкірмейсің, Реккайо?
Dialogue: 0,0:10:06.77,0:10:07.64,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:09.23,0:10:11.15,Default,,0,0,0,,
Dialogue: 0,0:10:12.98,0:10:14.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:15.48,0:10:18.40,Default,,0,0,0,,Ой, жоспар жоқ.
Dialogue: 0,0:10:20.24,0:10:21.49,Default,,0,0,0,,Хмм!
Dialogue: 0,0:10:22.58,0:10:23.87,Default,,0,0,0,,Уф... дууоооооо
Dialogue: 0,0:10:24.49,0:10:25.91,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:28.50,0:10:30.42,Default,,0,0,0,,Тоғыз бағаналы қамшы
Dialogue: 0,0:10:31.50,0:10:34.17,Default,,0,0,0,,Бұл өте қытайлық.
Dialogue: 0,0:10:34.75,0:10:36.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:37.51,0:10:39.51,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:10:43.10,0:10:44.47,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:10:44.56,0:10:45.97,Default,,0,0,0,,Мусаши құлап қалды!
Dialogue: 0,0:10:46.06,0:10:48.52,Default,,0,0,0,,Толық нокдаун!
Dialogue: 0,0:10:54.61,0:10:56.98,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:10:54.61,0:10:56.98,Default,,0,0,0,,- (32 ер адам) Қансырап жатыр! -(33 жастағы ер адам) Нені әкелдің?
Dialogue: 0,0:10:57.07,0:10:59.03,Default,,0,0,0,,- (34 ер адам) Айналып жатыр! - (35 жаста) Дауысы керемет!
Dialogue: 0,0:10:59.11,0:11:01.53,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:11:02.16,0:11:03.03,Default,,0,0,0,,Уваах! Көзім…
Dialogue: 0,0:11:05.12,0:11:07.04,Default,,0,0,0,,(Жел дыбысы жалғасады)
Dialogue: 0,0:11:07.75,0:11:10.54,Default,,0,0,0,,Бар болғаны 3 дюйм шегерілді!
Dialogue: 0,0:11:10.62,0:11:11.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:12.04,0:11:13.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:13.63,0:11:16.92,Default,,0,0,0,,Жылдам Тек ұшы жылдам
Dialogue: 0,0:11:17.00,0:11:22.30,Default,,0,0,0,,Операциялық қолдың қозғалысының өзі біршама біртіндеп жүреді.
Dialogue: 0,0:11:23.39,0:11:24.72,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:11:24.80,0:11:27.31,Default,,0,0,0,,Қамшының ұшын көзбен ұстауға болмайды.
Dialogue: 0,0:11:31.39,0:11:32.81,Default,,0,0,0,,
Dialogue: 0,0:11:32.90,0:11:34.81,Default,,0,0,0,,Қылышыңды жібердің бе?
Dialogue: 0,0:11:34.90,0:11:36.82,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:11:38.90,0:11:40.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:46.33,0:11:47.83,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:47.91,0:11:50.58,Default,,0,0,0,,(Қайталанған желді кесу дыбысы)
Dialogue: 0,0:11:52.16,0:11:54.46,Default,,0,0,0,,Хмм... ммм!
Dialogue: 0,0:11:55.92,0:11:56.84,Default,,0,0,0,,Хамф!
Dialogue: 0,0:12:01.13,0:12:02.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:02.68,0:12:03.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:05.68,0:12:10.60,Default,,0,0,0,,
Dialogue: 0,0:12:10.68,0:12:11.98,Default,,0,0,0,,Үзіліс!
Dialogue: 0,0:12:14.94,0:12:16.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:16.81,0:12:19.11,Default,,0,0,0,,Хмм, мен оны шайқаймын.
Dialogue: 0,0:12:20.44,0:12:23.45,Default,,0,0,0,,Қалағаныңды тербетуге болады, бірақ...
Dialogue: 0,0:12:23.95,0:12:26.87,Default,,0,0,0,,
Dialogue: 0,0:12:26.95,0:12:30.33,Default,,0,0,0,,Өте ауыр емес
Dialogue: 0,0:12:30.41,0:12:32.62,Default,,0,0,0,,Өз өміріңді алма
Dialogue: 0,0:12:33.29,0:12:34.12,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:35.17,0:12:36.88,Default,,0,0,0,,Болат нашар
Dialogue: 0,0:12:39.96,0:12:42.13,Default,,0,0,0,,Неге кірмейсіз?
Dialogue: 0,0:12:42.72,0:12:45.63,Default,,0,0,0,,Континент адамы Реккаио
Dialogue: 0,0:12:46.43,0:12:50.64,Default,,0,0,0,,Осы ойыншықпен Мусашиді жеңе аламын деп ойлайсың ба?
Dialogue: 0,0:12:51.22,0:12:53.77,Default,,0,0,0,,Қамшы бір сәт көңілімнен шығып кетті.
Dialogue: 0,0:12:53.85,0:12:55.39,Default,,0,0,0,,Неліктен мен тере алмаймын?
Dialogue: 0,0:12:55.48,0:12:56.90,Default,,0,0,0,,Қанша рет болса да...
Dialogue: 0,0:12:58.48,0:13:00.65,Default,,0,0,0,,Мүмкіндіктер көп болса керек!
Dialogue: 0,0:13:00.73,0:13:01.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:01.65,0:13:02.65,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:13:02.74,0:13:04.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:06.03,0:13:08.66,Default,,0,0,0,,Өтірік айтпа, Реккайо!
Dialogue: 0,0:13:08.74,0:13:10.24,Default,,0,0,0,,Бір сәтке де...
Dialogue: 0,0:13:10.74,0:13:12.41,Default,,0,0,0,,Рецукай патша
Dialogue: 0,0:13:12.50,0:13:13.00,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:13:13.00,0:13:14.50,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:13:13.00,0:13:14.50,Default,,0,0,0,,Ешқандай бос жерлер, тіпті үзінділер де жоқ!
Dialogue: 0,0:13:14.50,0:13:15.92,Default,,0,0,0,,Ешқандай бос жерлер, тіпті үзінділер де жоқ!
Dialogue: 0,0:13:16.54,0:13:18.92,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:22.13,0:13:23.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:27.84,0:13:28.93,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:13:29.01,0:13:30.68,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:13:30.76,0:13:32.68,Default,,0,0,0,,- (37 ер адам) Қос қолмен! - (38 жаста) Шынжырлы!
Dialogue: 0,0:13:32.77,0:13:34.68,Default,,0,0,0,,Сіз Niten-дің ең жақсысын көре аласыз!
Dialogue: 0,0:13:39.27,0:13:41.32,Default,,0,0,0,,Мен мұны істеуге ынталандырдым!
Dialogue: 0,0:13:41.82,0:13:44.19,Default,,0,0,0,,Жасыл бамбукты бір әткеншекпен бөлшектеңіз!
Dialogue: 0,0:13:44.90,0:13:46.20,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:13:46.28,0:13:48.70,Default,,0,0,0,,
Dialogue: 0,0:13:49.28,0:13:50.45,Default,,0,0,0,,(Тоғыз сырық қамшының құлаған дыбысы)
Dialogue: 0,0:13:54.54,0:13:56.21,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:13:56.29,0:13:57.87,Default,,0,0,0,,Ол бұзылды!
Dialogue: 0,0:13:57.96,0:13:59.21,Default,,0,0,0,,-(Еркек 41) Бір әткеншек -(Әйел 2) Жоқ!
Dialogue: 0,0:13:59.29,0:14:00.67,Default,,0,0,0,,Мен секірмеймін!
Dialogue: 0,0:14:00.75,0:14:02.21,Default,,0,0,0,,Мен оны сілкіп жібергенімде, сынып қалды.
Dialogue: 0,0:14:02.29,0:14:03.96,Default,,0,0,0,,Енді адам емес!
Dialogue: 0,0:14:04.05,0:14:05.59,Default,,0,0,0,,Жарайды, жарайды, келдің.
Dialogue: 0,0:14:05.67,0:14:06.97,Default,,0,0,0,,Қару емес
Dialogue: 0,0:14:07.05,0:14:09.84,Default,,0,0,0,,Хехе, шыдай алмаймын.
Dialogue: 0,0:14:09.93,0:14:11.26,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:11.76,0:14:13.47,Default,,0,0,0,,Тоғыз бөлімді қамшы дегеніміз не?
Dialogue: 0,0:14:14.10,0:14:15.98,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:14:16.89,0:14:21.40,Default,,0,0,0,,Жастайымнан сілкіп жүрген темір қамшы.
Dialogue: 0,0:14:21.48,0:14:26.11,Default,,0,0,0,,Терім сынып, қан көрсем де, тоқтамаймын
Dialogue: 0,0:14:26.19,0:14:30.11,Default,,0,0,0,,Дезинфекциялаушы тұзды ысқылаңыз және шайқаңыз.
Dialogue: 0,0:14:30.74,0:14:34.70,Default,,0,0,0,,Оңай жабылмайтын жарамен ауыратынмын.
Dialogue: 0,0:14:35.87,0:14:40.71,Default,,0,0,0,,Дегенмен, қамшы денесінің жұлынуы туралы алаңдаушылық бар.
Dialogue: 0,0:14:41.21,0:14:42.63,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:14:42.71,0:14:44.38,Default,,0,0,0,,Сәлем, патша Рецукай
Dialogue: 0,0:14:46.59,0:14:48.22,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:14:50.22,0:14:51.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:51.97,0:14:54.47,Default,,0,0,0,,Оны тартып, айналдырыңыз
Dialogue: 0,0:14:54.56,0:14:56.81,Default,,0,0,0,,Айтыңызшы, бар болғаны.
Dialogue: 0,0:14:56.89,0:15:00.14,Default,,0,0,0,,Мен самураймен күреспекшімін. Ал қылышқа келсек...
Dialogue: 0,0:15:01.23,0:15:02.65,Default,,0,0,0,,Ммм... ммм!
Dialogue: 0,0:15:02.73,0:15:04.40,Default,,0,0,0,,Ой! Гррр...
Dialogue: 0,0:15:04.48,0:15:07.65,Default,,0,0,0,,(Мұсашидің ыңырануы)
Dialogue: 0,0:15:07.74,0:15:09.15,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:15:09.24,0:15:10.65,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:15:10.74,0:15:12.16,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:12.24,0:15:13.91,Default,,0,0,0,,
Dialogue: 0,0:15:13.99,0:15:15.91,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:15:15.99,0:15:18.91,Default,,0,0,0,,
Dialogue: 0,0:15:21.08,0:15:23.92,Default,,0,0,0,,Байқадым, аңыздай сұмдық.
Dialogue: 0,0:15:26.50,0:15:28.51,Default,,0,0,0,,Бірақ мен жекпе-жек шеберімін
Dialogue: 0,0:15:31.09,0:15:34.18,Default,,0,0,0,,Жалаң қолмен жақындауға болмайды!
Dialogue: 0,0:15:34.26,0:15:36.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:36.26,0:15:37.51,Default,,0,0,0,,Жақсы айттыңыз!
Dialogue: 0,0:15:37.60,0:15:39.93,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:15:44.48,0:15:46.52,Default,,0,0,0,,Жеңілу сәті
Dialogue: 0,0:15:46.61,0:15:49.44,Default,,0,0,0,,Бұл жеңіске жетудің жалғыз мүмкіндігі болды.
Dialogue: 0,0:15:50.03,0:15:51.74,Default,,0,0,0,,Ешқашан екінші рет болмайды
Dialogue: 0,0:15:53.28,0:15:56.58,Default,,0,0,0,,Рецукай патша жеңілді!
Dialogue: 0,0:15:56.66,0:15:57.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:58.04,0:15:59.95,Default,,0,0,0,,- (Гуо) Иә? -(Баки) Ха!
Dialogue: 0,0:16:00.04,0:16:00.91,Default,,0,0,0,,(LOL)
Dialogue: 0,0:16:01.00,0:16:02.21,Default,,0,0,0,,Маған шындықты айт!
Dialogue: 0,0:16:02.29,0:16:04.96,Default,,0,0,0,,- (Ер 48) Мұсаши мырза ашты! -(49 жаста) Бұл күлкілі!
Dialogue: 0,0:16:05.04,0:16:07.21,Default,,0,0,0,,«Кодзиро жеңілді!»
Dialogue: 0,0:16:07.88,0:16:09.71,Default,,0,0,0,,Не... Иә?
Dialogue: 0,0:16:35.61,0:16:38.12,Default,,0,0,0,,«Кодзиро жеңілді!»
Dialogue: 0,0:16:39.99,0:16:43.79,Default,,0,0,0,,Жеңіске жетуді көздесеңіз, қапты не үшін лақтырып тастау керек?
Dialogue: 0,0:16:44.46,0:16:45.92,Default,,0,0,0,,Дәл солай жазылған
Dialogue: 0,0:16:46.00,0:16:48.71,Default,,0,0,0,,Дуэль Мусашидің жеңісімен аяқталады.
Dialogue: 0,0:16:49.75,0:16:54.13,Default,,0,0,0,,Бірақ бұл сөз ұрпаққа қалды.
Dialogue: 0,0:16:54.22,0:16:55.97,Default,,0,0,0,,Білуге мүмкіндік жоқ...
Dialogue: 0,0:16:56.05,0:16:58.89,Default,,0,0,0,,Сіз білесіз бе? бұл сөз
Dialogue: 0,0:16:58.97,0:17:01.68,Default,,0,0,0,,Хабарды жеткізе аласыз ба? бұл сөз
Dialogue: 0,0:17:01.77,0:17:04.39,Default,,0,0,0,,Гиггл... Бұл өте танымал.
Dialogue: 0,0:17:08.90,0:17:10.52,Default,,0,0,0,,Жақындап барады
Dialogue: 0,0:17:10.61,0:17:13.32,Default,,0,0,0,,Жалаң қолмен, Кемпо дәрігері.
Dialogue: 0,0:17:14.40,0:17:15.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:18.57,0:17:20.78,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:17:21.41,0:17:23.83,Default,,0,0,0,,«Жалаң қолмен жақындауға болмайды»
Dialogue: 0,0:17:24.75,0:17:26.83,Default,,0,0,0,,Сөз нені білдіреді
Dialogue: 0,0:17:30.88,0:17:32.59,Default,,0,0,0,,Сіз түсінесіз деп үміттенемін!
Dialogue: 0,0:17:33.92,0:17:34.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:34.92,0:17:36.84,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:17:36.93,0:17:38.59,Default,,0,0,0,,
Dialogue: 0,0:17:38.68,0:17:40.35,Default,,0,0,0,,Көтерілді!
Dialogue: 0,0:17:40.43,0:17:42.10,Default,,0,0,0,,Бір қол!
Dialogue: 0,0:17:42.85,0:17:43.85,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:17:43.93,0:17:47.44,Default,,0,0,0,,Жақ сүйегінің соққысы ғажап.
Dialogue: 0,0:17:47.52,0:17:48.60,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:17:48.69,0:17:50.27,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:17:50.36,0:17:52.36,Default,,0,0,0,,Көзге көрінгеннен гөрі көп нәрсе бар.
Dialogue: 0,0:17:53.19,0:17:55.86,Default,,0,0,0,,Менің салмағым бір қолмен 100 кг-нан асады...
Dialogue: 0,0:17:57.03,0:17:58.99,Default,,0,0,0,,Бірақ епті
Dialogue: 0,0:17:59.07,0:18:01.28,Default,,0,0,0,,Шашты қаруға айналдыру
Dialogue: 0,0:18:02.33,0:18:05.62,Default,,0,0,0,,Сол қашықтықтан Аматсусаэді тебу.
Dialogue: 0,0:18:06.21,0:18:09.04,Default,,0,0,0,,Сізде осындай ұстау күші бар ма? Ақымақ!
Dialogue: 0,0:18:10.96,0:18:11.88,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:18:11.96,0:18:13.00,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:18:13.96,0:18:14.88,Default,,0,0,0,,Уф
Dialogue: 0,0:18:15.42,0:18:16.88,Default,,0,0,0,,Манипуляция
Dialogue: 0,0:18:17.47,0:18:19.38,Default,,0,0,0,,Кеноны ойыншық етіп жатыр!
Dialogue: 0,0:18:19.97,0:18:20.89,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:18:22.47,0:18:23.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:26.73,0:18:28.14,Default,,0,0,0,,(Бақидың дірілдеген тынысы)
Dialogue: 0,0:18:31.73,0:18:33.40,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:18:33.48,0:18:34.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.98,0:18:37.90,Default,,0,0,0,,
Dialogue: 0,0:18:46.66,0:18:48.91,Default,,0,0,0,,Қарсы шабуылдың баяулығы
Dialogue: 0,0:18:50.12,0:18:52.67,Default,,0,0,0,,Қытай жекпе-жек өнері: Ең болмағанда ерік күші ме?
Dialogue: 0,0:18:53.71,0:18:56.26,Default,,0,0,0,,Жолда тұрған Рецудың көрінісі...
Dialogue: 0,0:18:56.76,0:18:57.67,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:18:57.67,0:18:59.42,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:18:57.67,0:18:59.42,Default,,0,0,0,,Бүкіл бөлме, әр адамның жүрегінде өткен және өткен сезімдер
Dialogue: 0,0:18:59.42,0:19:02.26,Default,,0,0,0,,Толық үй, әркімнің жүрегінен өткен сезім
Dialogue: 0,0:19:09.77,0:19:14.77,Default,,0,0,0,,♪~
Dialogue: 0,0:20:33.14,0:20:38.15,Default,,0,0,0,,~♪
