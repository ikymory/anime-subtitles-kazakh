Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.55,0:01:39.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:47.60,0:01:52.27,Default,,0,0,0,,Күткендей оңай жеңіс болды.
Dialogue: 0,0:01:52.36,0:01:53.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:53.86,0:01:58.78,Default,,0,0,0,,Оның бет-әлпеті қатты бүлінген кезде «оңай жеңіс» болды.
Dialogue: 0,0:01:58.86,0:02:00.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:02.87,0:02:04.79,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:02:07.71,0:02:09.79,Default,,0,0,0,,Олай болса, сұрайын деп едім
Dialogue: 0,0:02:10.88,0:02:14.30,Default,,0,0,0,,Реккай патша қалай болды?
Dialogue: 0,0:02:22.39,0:02:27.31,Default,,0,0,0,,«Секигахарамен» тең келе ме?
Dialogue: 0,0:02:27.39,0:02:29.69,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:02:31.27,0:02:32.19,Default,,0,0,0,,Қаа!
Dialogue: 0,0:02:32.27,0:02:35.19,Default,,0,0,0,,Қашпа! Мен әлі баламын!
Dialogue: 0,0:02:35.28,0:02:37.19,Default,,0,0,0,,(Ашигару А және В дірілдеген тынысы)
Dialogue: 0,0:02:37.28,0:02:38.70,Default,,0,0,0,,Эндевордың орнына ма?
Dialogue: 0,0:02:39.28,0:02:40.70,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:02:43.07,0:02:44.45,Default,,0,0,0,,Дәл әуесқой сияқты!
Dialogue: 0,0:02:44.53,0:02:45.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:45.54,0:02:47.12,Default,,0,0,0,,Хмм... Нгг!
Dialogue: 0,0:02:51.04,0:02:53.50,Default,,0,0,0,,(Жас Мұсашидің ауыр тыныс алуы)
Dialogue: 0,0:02:54.17,0:02:56.46,Default,,0,0,0,,Ол 17 жастағы бала!
Dialogue: 0,0:02:56.55,0:02:58.46,Default,,0,0,0,,(Ашигару А-ның дірілдеп тыныс алуы)
Dialogue: 0,0:02:58.55,0:03:00.55,Default,,0,0,0,,Қашпа
Dialogue: 0,0:03:01.05,0:03:03.43,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:04.05,0:03:05.22,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:03:05.31,0:03:06.47,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:03:06.56,0:03:07.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:09.06,0:03:11.23,Default,,0,0,0,,- (Ашигару D) Эй! - (Жас Мусаши) Арх!
Dialogue: 0,0:03:12.31,0:03:14.36,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:03:15.44,0:03:17.23,Default,,0,0,0,,(Ашигару Д-ның ыңырсыуы)
Dialogue: 0,0:03:17.32,0:03:19.24,Default,,0,0,0,,Ммм...
Dialogue: 0,0:03:20.40,0:03:21.99,Default,,0,0,0,,О!
Dialogue: 0,0:03:22.07,0:03:25.62,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:25.70,0:03:26.99,Default,,0,0,0,,Мм... Пех!
Dialogue: 0,0:03:27.08,0:03:30.50,Default,,0,0,0,,Хаа... жеңілдің, ақымақ! Хаа...
Dialogue: 0,0:03:30.58,0:03:32.75,Default,,0,0,0,,Келіңіздер, хаа...
Dialogue: 0,0:03:32.83,0:03:34.83,Default,,0,0,0,,Секигахара~!
Dialogue: 0,0:03:36.21,0:03:39.63,Default,,0,0,0,,Секигахара... Орташа?
Dialogue: 0,0:03:39.71,0:03:41.63,Default,,0,0,0,,Шынында да
Dialogue: 0,0:03:41.72,0:03:46.14,Default,,0,0,0,,Хмм... аздап толығырақ...
Dialogue: 0,0:03:46.22,0:03:50.31,Default,,0,0,0,,Жоғары және төмен, алдыңғы және артқы, сол және оң
Dialogue: 0,0:03:50.89,0:03:53.65,Default,,0,0,0,,Сақтықты бір сәтке де түсірме
Dialogue: 0,0:03:53.73,0:03:57.98,Default,,0,0,0,,Ұзын қылыш, найза, садақ жебе, нагината
Dialogue: 0,0:03:58.07,0:04:00.40,Default,,0,0,0,,Мылтыққа дейін
Dialogue: 0,0:04:00.49,0:04:04.41,Default,,0,0,0,,Мен нені немесе кім секіретінін білмеймін.
Dialogue: 0,0:04:04.49,0:04:06.41,Default,,0,0,0,,(Мицунаридің дірілдеген дауысы)
Dialogue: 0,0:04:07.12,0:04:08.66,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:08.74,0:04:12.37,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:04:12.46,0:04:16.92,Default,,0,0,0,,Ол кезде мен үшін Секигахара солай болды.
Dialogue: 0,0:04:17.00,0:04:18.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:18.50,0:04:22.42,Default,,0,0,0,,Және... жақсы... солай...
Dialogue: 0,0:04:23.05,0:04:25.93,Default,,0,0,0,,Рецукай патша керемет еді...
Dialogue: 0,0:04:26.72,0:04:27.76,Default,,0,0,0,,Айт...
Dialogue: 0,0:04:28.51,0:04:29.97,Default,,0,0,0,,Енді...
Dialogue: 0,0:04:31.02,0:04:32.93,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:04:34.31,0:04:35.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.52,0:04:38.98,Default,,0,0,0,,Жұдырығыңызға тістеген пышақты ұстаңыз
Dialogue: 0,0:04:39.07,0:04:43.44,Default,,0,0,0,,Қолыңызда сезілетін әдеттен тыс ұстау күші
Dialogue: 0,0:04:44.11,0:04:46.11,Default,,0,0,0,,Бұл жаттығуды тамашалаңыз.
Dialogue: 0,0:04:46.20,0:04:48.53,Default,,0,0,0,,Идеялар секірісін жақсы көр
Dialogue: 0,0:04:48.62,0:04:50.95,Default,,0,0,0,,Оның батылдығына сүйсініңіз
Dialogue: 0,0:04:52.04,0:04:54.37,Default,,0,0,0,,Сол кезде мен қорықтым
Dialogue: 0,0:04:55.04,0:04:56.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:56.42,0:04:57.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:59.25,0:05:01.30,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:05:01.38,0:05:04.47,Default,,0,0,0,,Рахмет саған Мусаши-доно
Dialogue: 0,0:05:04.55,0:05:08.97,Default,,0,0,0,,Рецу да, мен де құтқарыламыз.
Dialogue: 0,0:05:10.05,0:05:12.47,Default,,0,0,0,,Бұл рас. Еш нәрсе істей алмайсың.
Dialogue: 0,0:05:13.18,0:05:15.06,Default,,0,0,0,,Мұсашиден
Dialogue: 0,0:05:15.14,0:05:20.48,Default,,0,0,0,,Оны сол данышпан қылышшы Нанигаши Сасакимен қалай салыстырады?
Dialogue: 0,0:05:20.57,0:05:24.49,Default,,0,0,0,,Рецу семсерші Мусашидің қарсыласына қарсы
Dialogue: 0,0:05:26.36,0:05:28.07,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:31.58,0:05:34.75,Default,,0,0,0,,Мұсашиден туралы не ойлайсың?
Dialogue: 0,0:05:34.83,0:05:39.00,Default,,0,0,0,,Сол данышпан қылышшы Кодзиро Сасаки мен король Рецукай
Dialogue: 0,0:05:39.08,0:05:41.50,Default,,0,0,0,,Қайсысы күшті!
Dialogue: 0,0:05:46.09,0:05:49.01,Default,,0,0,0,,Қандай құрмет!
Dialogue: 0,0:05:49.09,0:05:50.93,Default,,0,0,0,,Салыстыру!
Dialogue: 0,0:05:51.01,0:05:57.27,Default,,0,0,0,,Данышпан және әдемі қылышшы Кодзиро Сасаки және біздің жұдырықтай жауынгер Рецукайу!
Dialogue: 0,0:05:58.19,0:05:59.77,Default,,0,0,0,,Қылышшы күрескерге қарсы
Dialogue: 0,0:06:00.52,0:06:02.86,Default,,0,0,0,,Жауабы – қайсысы!
Dialogue: 0,0:06:05.28,0:06:06.28,Default,,0,0,0,,Ах
Dialogue: 0,0:06:06.36,0:06:08.03,Default,,0,0,0,,Қайсысы!
Dialogue: 0,0:06:09.03,0:06:10.03,Default,,0,0,0,,Фунаджима.
Dialogue: 0,0:06:10.11,0:06:12.45,Default,,0,0,0,,- (Мицунари) Иә? -(Мұсаши) Солай емес пе? Не?
Dialogue: 0,0:06:12.53,0:06:13.53,Default,,0,0,0,,Фуна…
Dialogue: 0,0:06:13.62,0:06:15.50,Default,,0,0,0,,Сіз не айтасыз
Dialogue: 0,0:06:15.58,0:06:19.04,Default,,0,0,0,,Мен Фунаджимада кездестірген Сасакиге не болды?
Dialogue: 0,0:06:19.12,0:06:20.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:20.63,0:06:24.13,Default,,0,0,0,,Мен бір нәрсені ұмытып кеткен сияқтымын...
Dialogue: 0,0:06:24.63,0:06:27.26,Default,,0,0,0,,Жоқ, жоқ, не айтып тұрсың?
Dialogue: 0,0:06:27.34,0:06:29.30,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:06:29.38,0:06:32.80,Default,,0,0,0,,Бұл... жарық па?
Dialogue: 0,0:06:32.89,0:06:35.26,Default,,0,0,0,,Бұл стиль екеніне сенімдімін...
Dialogue: 0,0:06:35.35,0:06:38.18,Default,,0,0,0,,Мм, Ганрю...
Dialogue: 0,0:06:38.27,0:06:40.06,Default,,0,0,0,,Сәл күте тұрыңыз... Хм...
Dialogue: 0,0:06:40.14,0:06:43.11,Default,,0,0,0,,Олар тағдырлас қарсыластар емес пе еді?
Dialogue: 0,0:06:43.19,0:06:45.19,Default,,0,0,0,,Кодзиро Сасаки деген кім?
Dialogue: 0,0:06:45.27,0:06:46.82,Default,,0,0,0,,Либару?
Dialogue: 0,0:06:46.90,0:06:49.40,Default,,0,0,0,,Кодзиро Сасаки Ганрю деген кім?
Dialogue: 0,0:06:49.49,0:06:52.32,Default,,0,0,0,,Ол сенің ең үлкен жауың емес пе еді?
Dialogue: 0,0:06:52.41,0:06:54.33,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:06:54.41,0:06:55.33,Default,,0,0,0,,(шайдың төгілген дыбысы)
Dialogue: 0,0:06:55.41,0:06:57.66,Default,,0,0,0,,«Қалыпты»…
Dialogue: 0,0:06:58.16,0:06:59.33,Default,,0,0,0,,(Танжиро) Барлығы жақсы болады. Бұл адам ешкімді өлтірген жоқ.
Dialogue: 0,0:07:00.04,0:07:03.33,Default,,0,0,0,,Әсіресе әлсіз емес, бірақ
Dialogue: 0,0:07:03.42,0:07:06.25,Default,,0,0,0,,Алайда, әсіресе...
Dialogue: 0,0:07:07.63,0:07:08.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:09.26,0:07:10.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.55,0:07:14.64,Default,,0,0,0,,Рецукай патша туралы не деуге болады?
Dialogue: 0,0:07:14.72,0:07:15.85,Default,,0,0,0,,Бұл қалыпты ма?
Dialogue: 0,0:07:15.93,0:07:17.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.93,0:07:21.23,Default,,0,0,0,,Ұрыспен салыстыруға болатын күш
Dialogue: 0,0:07:21.31,0:07:23.35,Default,,0,0,0,,Бұл қалыпты болуы мүмкін емес.
Dialogue: 0,0:07:23.44,0:07:24.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.44,0:07:29.53,Default,,0,0,0,,Бірінші кезекте сіз таныстырған үш адам
Dialogue: 0,0:07:29.61,0:07:32.36,Default,,0,0,0,,Олардың барлығы қалыпты емес.
Dialogue: 0,0:07:32.95,0:07:37.62,Default,,0,0,0,,Ол тіпті соғысып жатқан мемлекеттер дәуірінде де белгілі бір атаққа қол жеткізген шығар.
Dialogue: 0,0:07:37.70,0:07:40.62,Default,,0,0,0,,Тахаха! «Солай-ақ»?
Dialogue: 0,0:07:41.83,0:07:43.12,Default,,0,0,0,,Келесіні күтіңіз
Dialogue: 0,0:07:43.21,0:07:45.38,Default,,0,0,0,,Иә? Оноши
Dialogue: 0,0:07:45.46,0:07:47.38,Default,,0,0,0,,Мұны қазірдің өзінде орындағыңыз келе ме?
Dialogue: 0,0:07:48.38,0:07:50.72,Default,,0,0,0,,Әр күн жақсы.
Dialogue: 0,0:07:52.68,0:07:54.14,Default,,0,0,0,,Қарттар мен жас жігіттер мен әйелдер
Dialogue: 0,0:07:54.93,0:07:58.26,Default,,0,0,0,,Доджо барлығына ашық болғандықтан
Dialogue: 0,0:07:58.35,0:08:00.85,Default,,0,0,0,,Қабылдаудан бас тартуға негіз жоқ.
Dialogue: 0,0:08:00.93,0:08:05.65,Default,,0,0,0,,Неліктен осы күндері корю жекпе-жек өнерін үйренгіңіз келеді?
Dialogue: 0,0:08:07.61,0:08:09.15,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:09.23,0:08:11.90,Default,,0,0,0,,Бұл дегеніңіз, Мотобу-сан.
Dialogue: 0,0:08:11.99,0:08:16.03,Default,,0,0,0,,Мотобу мырзаға қонаққа келу себебім...
Dialogue: 0,0:08:16.74,0:08:19.49,Default,,0,0,0,,Ах... Тарихты қозғағым келеді...
Dialogue: 0,0:08:19.58,0:08:23.29,Default,,0,0,0,,Ал сіздің денсаулығыңызға пайдалы ма... әлде бір нәрсе ме?
Dialogue: 0,0:08:24.29,0:08:25.17,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:25.25,0:08:27.67,Default,,0,0,0,,Не, жоқ?
Dialogue: 0,0:08:28.25,0:08:31.26,Default,,0,0,0,,Мен оны тоқтату үшін мылтықпен қорқытуым керек еді.
Dialogue: 0,0:08:32.42,0:08:35.18,Default,,0,0,0,,Мен Реккайоны қорғай алмадым.
Dialogue: 0,0:08:35.84,0:08:36.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:37.35,0:08:39.39,Default,,0,0,0,,Бұл сізге мүмкін емес.
Dialogue: 0,0:08:39.89,0:08:41.68,Default,,0,0,0,,Басыңа тұрсаң да
Dialogue: 0,0:08:43.77,0:08:45.69,Default,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:08:46.19,0:08:49.19,Default,,0,0,0,,Сол Мұсашы жын қолынан, сен
Dialogue: 0,0:08:51.32,0:08:52.44,Default,,0,0,0,,Кім?
Dialogue: 0,0:08:52.94,0:08:55.74,Default,,0,0,0,,Сен кімді қорғайсың? Мотобу мырза
Dialogue: 0,0:08:57.82,0:09:01.24,Default,,0,0,0,,Сіз қазіргі жекпе-жек шеберлері туралы ештеңе білмейсіз.
Dialogue: 0,0:09:01.33,0:09:02.50,Default,,0,0,0,,Мотобу мырза
Dialogue: 0,0:09:02.58,0:09:06.04,Default,,0,0,0,,Мен сұрап тұрмын, сен кімді қорғайсың?
Dialogue: 0,0:09:06.12,0:09:09.00,Default,,0,0,0,,Сол денемен, сол техникамен
Dialogue: 0,0:09:09.09,0:09:10.25,Default,,0,0,0,,Хаха…
Dialogue: 0,0:09:10.75,0:09:12.51,Default,,0,0,0,,«Ақымақ болма»?
Dialogue: 0,0:09:12.59,0:09:15.05,Default,,0,0,0,,Менен әлдеқайда әлсіз қарт
Dialogue: 0,0:09:15.13,0:09:17.89,Default,,0,0,0,,Сіз неден секіресіз?
Dialogue: 0,0:09:17.97,0:09:20.60,Default,,0,0,0,,«Мен әлемдегі Ханма Бакимін».
Dialogue: 0,0:09:21.10,0:09:23.52,Default,,0,0,0,,«Оны назардан тыс қалдырмаңыз».
Dialogue: 0,0:09:23.60,0:09:26.60,Default,,0,0,0,,Бұл шамамен солай ма?
Dialogue: 0,0:09:27.10,0:09:29.06,Default,,0,0,0,,Дегенмен сәл басқаша.
Dialogue: 0,0:09:29.56,0:09:30.94,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:09:31.44,0:09:33.28,Default,,0,0,0,,Мен ешкімді кешірмеймін
Dialogue: 0,0:09:33.86,0:09:36.28,Default,,0,0,0,,Мен сені қорғауға рұқсат бермеймін.
Dialogue: 0,0:09:40.66,0:09:42.45,Default,,0,0,0,,Көрдің бе, Баки-күн?
Dialogue: 0,0:09:42.95,0:09:48.00,Default,,0,0,0,,Жауынгерлік өнер тарихындағы ең мықты қылышшы Миямото Мусашидің күші
Dialogue: 0,0:09:48.08,0:09:52.30,Default,,0,0,0,,Біздің мақтаныш жұдырығымыз Реккайоны бір қылышпен екіге бөл.
Dialogue: 0,0:09:54.96,0:09:55.97,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:09:56.67,0:09:58.05,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:09:58.84,0:10:00.60,Default,,0,0,0,,Король Рекканың өлімі
Dialogue: 0,0:10:01.10,0:10:03.51,Default,,0,0,0,,Мұның өзі өкінішті.
Dialogue: 0,0:10:03.60,0:10:05.39,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:10:05.89,0:10:07.60,Default,,0,0,0,,Бірақ, Баки-сан.
Dialogue: 0,0:10:07.69,0:10:09.81,Default,,0,0,0,,Мен жекпе-жек шеберімін.
Dialogue: 0,0:10:10.40,0:10:12.32,Default,,0,0,0,,Бұл керек емес пе?
Dialogue: 0,0:10:12.40,0:10:18.07,Default,,0,0,0,,Менің жолым қайда апарады, мен оның баратын жеріне куә болып қуанамын.
Dialogue: 0,0:10:18.57,0:10:20.82,Default,,0,0,0,,Бұл үшін мені кешіріңіз.
Dialogue: 0,0:10:21.87,0:10:24.83,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:10:24.91,0:10:26.62,Default,,0,0,0,,Әлі де біз
Dialogue: 0,0:10:26.70,0:10:29.83,Default,,0,0,0,,Мен Миямото Мусашидің ең жақсысын көрген жоқпын.
Dialogue: 0,0:10:29.92,0:10:32.42,Default,,0,0,0,,Қандай тамаша комплимент.
Dialogue: 0,0:10:32.50,0:10:36.34,Default,,0,0,0,,Рецукай патшаны жеңгеннен кейін де, сіз оған бар күшіңізді салуыңыз керек пе?
Dialogue: 0,0:10:36.42,0:10:40.64,Default,,0,0,0,,Менің ойымша, сіз мүмкіндігінше көп тәжірибе алғыңыз келді.
Dialogue: 0,0:10:40.72,0:10:42.85,Default,,0,0,0,,Қазіргі ұрыс техникасы
Dialogue: 0,0:10:43.43,0:10:45.60,Default,,0,0,0,,Демек, бұл үлкен мәселе емес пе?
Dialogue: 0,0:10:46.31,0:10:48.14,Default,,0,0,0,,Ол дарынды адам.
Dialogue: 0,0:10:48.23,0:10:51.10,Default,,0,0,0,,Дегенмен, сізді есінен танып жатқан адам емес.
Dialogue: 0,0:10:51.73,0:10:53.48,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:10:54.69,0:10:58.61,Default,,0,0,0,,Мен сені қорғауға міндеттімін.
Dialogue: 0,0:11:01.78,0:11:03.16,Default,,0,0,0,,Мотобу мырза
Dialogue: 0,0:11:04.20,0:11:07.20,Default,,0,0,0,,«Сол себепті» қайда орналасқан?
Dialogue: 0,0:11:08.79,0:11:09.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:09.91,0:11:13.38,Default,,0,0,0,,Баки Ханма қаншалықты шебер?
Dialogue: 0,0:11:14.71,0:11:17.76,Default,,0,0,0,,100 ұпайдан 100 ұпай
Dialogue: 0,0:11:17.84,0:11:21.13,Default,,0,0,0,,Жоқ, сіз тіпті 120 ұпай жинай аласыз.
Dialogue: 0,0:11:23.22,0:11:28.14,Default,,0,0,0,,Екінші жағынан, Мотобу Изоның қолмен жұмыс істеу шеберлігі қандай?
Dialogue: 0,0:11:28.22,0:11:29.93,Default,,0,0,0,,60 ұпай?
Dialogue: 0,0:11:30.43,0:11:32.14,Default,,0,0,0,,70 ұпай?
Dialogue: 0,0:11:32.23,0:11:36.90,Default,,0,0,0,,Қаншалықты бос ұпай жинасаңыз да, ол 80 ұпайдан аспайды.
Dialogue: 0,0:11:37.48,0:11:39.24,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:11:39.32,0:11:43.07,Default,,0,0,0,,Қылыш Найза Таяқша Орақ
Dialogue: 0,0:11:43.16,0:11:45.91,Default,,0,0,0,,Шинобиге арқан
Dialogue: 0,0:11:45.99,0:11:50.41,Default,,0,0,0,,Барлығын қоссаңыз, 300 ұпайдан кем түспейсіз.
Dialogue: 0,0:11:51.87,0:11:52.92,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:11:53.00,0:11:54.42,Default,,0,0,0,,(буындардың жарылған дыбысы)
Dialogue: 0,0:11:55.04,0:11:56.96,Default,,0,0,0,,Сіз мұның бәрін пайдалана аласыз.
Dialogue: 0,0:11:57.50,0:12:00.42,Default,,0,0,0,,Адамдардың қате есептеулерін еске түсіру
Dialogue: 0,0:12:07.76,0:12:09.31,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:09.39,0:12:10.43,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:11.02,0:12:11.93,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:16.52,0:12:17.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:19.15,0:12:21.07,Default,,0,0,0,,Бұл түсінікті ме?
Dialogue: 0,0:12:25.99,0:12:27.66,Default,,0,0,0,,Жекпе-жек өнері
Dialogue: 0,0:12:28.24,0:12:29.95,Default,,0,0,0,,Мен сақ болғанмен
Dialogue: 0,0:12:31.33,0:12:32.96,Default,,0,0,0,,Түтін экраны...
Dialogue: 0,0:12:34.04,0:12:36.96,Default,,0,0,0,,Бүгін таңертең маған Баки мырза қоңырау шалды.
Dialogue: 0,0:12:37.67,0:12:40.96,Default,,0,0,0,,Бұл даму сол кезде болжанған болатын.
Dialogue: 0,0:12:42.38,0:12:44.97,Default,,0,0,0,,Мен мұны саған дайындадым.
Dialogue: 0,0:12:45.59,0:12:49.47,Default,,0,0,0,,Бұл ниндзялар үшін «түтін бомбасы». Мен жасадым.
Dialogue: 0,0:12:50.18,0:12:52.43,Default,,0,0,0,,Жылтыратпаған қыштан шар жасау
Dialogue: 0,0:12:52.52,0:12:55.48,Default,,0,0,0,,Ішінде арнайы мылтық зарядталған.
Dialogue: 0,0:12:55.56,0:12:59.48,Default,,0,0,0,,Хехе, бұл қате есептеу емес еді.
Dialogue: 0,0:13:00.19,0:13:01.90,Default,,0,0,0,,Бұл соғыс өнері
Dialogue: 0,0:13:02.40,0:13:03.99,Default,,0,0,0,,Бұл да күрес
Dialogue: 0,0:13:04.07,0:13:09.33,Default,,0,0,0,,Бұл да Миямото Мусашидің стилі.
Dialogue: 0,0:13:10.66,0:13:14.00,Default,,0,0,0,,Мен өлтірілдім.
Dialogue: 0,0:13:15.58,0:13:17.46,Default,,0,0,0,,(Адам) Әке, бірдеңе болды ма?
Dialogue: 0,0:13:17.54,0:13:20.59,Default,,0,0,0,,Менің оны өлтіретін ойым болған жоқ.
Dialogue: 0,0:13:20.67,0:13:24.51,Default,,0,0,0,,Егер сен мені өлтіремін деп ойласаң, сенің реакцияң басқаша болар еді.
Dialogue: 0,0:13:25.88,0:13:28.01,Default,,0,0,0,,Бұл қате болды ма?
Dialogue: 0,0:13:28.09,0:13:29.76,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:13:29.85,0:13:33.93,Default,,0,0,0,,Сендер қазіргі жауынгерлер мұндайға үйренбегенсіңдер.
Dialogue: 0,0:13:34.02,0:13:37.52,Default,,0,0,0,,Бұл қорлау болуы мүмкін, бірақ бұл шындық.
Dialogue: 0,0:13:37.60,0:13:41.57,Default,,0,0,0,,Мен ғана бұл стильмен таныспын.
Dialogue: 0,0:13:42.07,0:13:44.19,Default,,0,0,0,,Тіпті Ханма Баки де емес
Dialogue: 0,0:13:44.28,0:13:46.86,Default,,0,0,0,,Тіпті Юдзиро Ханма да емес
Dialogue: 0,0:13:46.95,0:13:49.03,Default,,0,0,0,,Тіпті Гоки Шибукава да емес
Dialogue: 0,0:13:49.62,0:13:53.54,Default,,0,0,0,,Бұл Изо штаб-пәтері жалғыз.
Dialogue: 0,0:13:54.45,0:13:57.00,Default,,0,0,0,,Юдзиро Ханма Мокай
Dialogue: 0,0:13:57.62,0:14:02.04,Default,,0,0,0,,Бұл шайқас менің жауапкершілігім.
Dialogue: 0,0:14:07.13,0:14:11.55,Default,,0,0,0,,Бұл еліктеудің қандай түрі? Уцуми полициясының бас инспекторы
Dialogue: 0,0:14:11.64,0:14:14.35,Default,,0,0,0,,Кешіріңіз, қария.
Dialogue: 0,0:14:14.43,0:14:17.52,Default,,0,0,0,,Кісі өлтірді деген күдікпен сізді қамауға алу туралы ордер бар.
Dialogue: 0,0:14:17.60,0:14:20.06,Default,,0,0,0,,Ресми қамау
Dialogue: 0,0:14:20.65,0:14:22.11,Default,,0,0,0,,Бірақ бұл естеліктер мен үш-төрт жастағы кезімдегі ғой, иә?
Dialogue: 0,0:14:22.65,0:14:25.32,Default,,0,0,0,,Куәгерлер бар.
Dialogue: 0,0:14:26.15,0:14:27.74,Default,,0,0,0,,Көпше
Dialogue: 0,0:14:29.70,0:14:34.03,Default,,0,0,0,,Мен оны өз көзіммен анық көрдім.
Dialogue: 0,0:14:34.79,0:14:37.79,Default,,0,0,0,,Иә, бұл жапондық қылыш.
Dialogue: 0,0:14:38.54,0:14:42.79,Default,,0,0,0,,Бұл... иә, көпшілік алдында жасалған кісі өлтіру болды.
Dialogue: 0,0:14:43.88,0:14:45.80,Default,,0,0,0,,Өзім туралы
Dialogue: 0,0:14:45.88,0:14:48.42,Default,,0,0,0,,Мен әлі де абдырап жүрмін.
Dialogue: 0,0:14:48.51,0:14:51.55,Default,,0,0,0,,Сол күні мен көрген нәрсе не болды...
Dialogue: 0,0:14:52.05,0:14:54.93,Default,,0,0,0,,Бұл дәмсіз өлтіру болды ма?
Dialogue: 0,0:14:55.56,0:14:58.73,Default,,0,0,0,,Бұл асыл «қытай мен қытайды салыстыру» болды ма?
Dialogue: 0,0:14:59.85,0:15:01.23,Default,,0,0,0,,Демонстрация
Dialogue: 0,0:15:01.81,0:15:04.86,Default,,0,0,0,,Қылышпен көрсету
Dialogue: 0,0:15:04.94,0:15:07.74,Default,,0,0,0,,Бұл сол қателіктің нәтижесі ғана.
Dialogue: 0,0:15:08.57,0:15:09.78,Default,,0,0,0,,Ескі герцог
Dialogue: 0,0:15:10.91,0:15:13.53,Default,,0,0,0,,Мен ешқашан жамандық жасамаймын!
Dialogue: 0,0:15:13.62,0:15:15.49,Default,,0,0,0,,Бұл ішкі теңізде бір ғана жер бар...
Dialogue: 0,0:15:15.58,0:15:18.00,Default,,0,0,0,,Бұл әлсіз темір.
Dialogue: 0,0:15:18.08,0:15:20.04,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:15:20.58,0:15:22.50,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:15:22.58,0:15:26.75,Default,,0,0,0,,Уайымдама, Токугава мен жақында қайтамын
Dialogue: 0,0:15:26.84,0:15:27.88,Default,,0,0,0,,О!
Dialogue: 0,0:15:27.96,0:15:29.51,Default,,0,0,0,,Мұны да зерттеңіз!
Dialogue: 0,0:15:30.88,0:15:35.10,Default,,0,0,0,,О! Барлығына не болды?
Dialogue: 0,0:15:37.39,0:15:41.64,Default,,0,0,0,,1921 «Оомото оқиғасы» індеті
Dialogue: 0,0:15:42.56,0:15:44.31,Default,,0,0,0,,Сол кездегі Киото префектуралық полициясы
Dialogue: 0,0:15:44.40,0:15:47.69,Default,,0,0,0,,негізін қалаушы Онизабуро Дегучиді тұтқындау туралы
Dialogue: 0,0:15:47.78,0:15:49.32,Default,,0,0,0,,Мәселе болды
Dialogue: 0,0:15:49.40,0:15:53.66,Default,,0,0,0,,Дегучиге жақын жекпе-жек шебері болған.
Dialogue: 0,0:15:54.91,0:15:58.79,Default,,0,0,0,,Айкидоның негізін салушы Морихей Уэсиба.
Dialogue: 0,0:15:59.95,0:16:03.29,Default,,0,0,0,,Ол кезде елордалық полиция департаменті Уэшибаның басшылығында болды.
Dialogue: 0,0:16:04.00,0:16:07.29,Default,,0,0,0,,Мен Уэсибаның керемет қабілетін өз көзіммен білемін.
Dialogue: 0,0:16:08.17,0:16:11.47,Default,,0,0,0,,Нәтижелер Киото префектуралық полициясы қандай қорытындыға келді?
Dialogue: 0,0:16:11.55,0:16:13.80,Default,,0,0,0,,Біртүрлі деуге болатын біртүрлі жоспар еді.
Dialogue: 0,0:16:14.89,0:16:17.55,Default,,0,0,0,,Алдымен Уэсибаны өрт сөндіру көліктерімен қоршаңыз.
Dialogue: 0,0:16:18.56,0:16:19.56,Default,,0,0,0,,Су бірден бөлінді
Dialogue: 0,0:16:21.14,0:16:22.81,Default,,0,0,0,,Құйылған тормен жабыңыз
Dialogue: 0,0:16:22.89,0:16:25.56,Default,,0,0,0,,Ұзын таяқшаны дайында
Dialogue: 0,0:16:26.36,0:16:27.56,Default,,0,0,0,,Бір ауыздан қол соғу
Dialogue: 0,0:16:28.52,0:16:30.28,Default,,0,0,0,,Қамау... және
Dialogue: 0,0:16:31.40,0:16:34.99,Default,,0,0,0,,Жоғарыдағы оқиғаны автор осыдан 30 жылдай бұрын айтқан.
Dialogue: 0,0:16:35.07,0:16:38.87,Default,,0,0,0,,Морихей Уэшибаның тікелей шәкірті Гозо Шиодадан
Dialogue: 0,0:16:38.95,0:16:40.91,Default,,0,0,0,,Мен мұны талай рет естідім.
Dialogue: 0,0:16:41.41,0:16:45.87,Default,,0,0,0,,Операция сәтсіз аяқталды, себебі Уэсиба жасырынып кетті.
Dialogue: 0,0:16:45.96,0:16:47.67,Default,,0,0,0,,Аяқталған жекпе-жек шебері
Dialogue: 0,0:16:47.75,0:16:51.30,Default,,0,0,0,,Халықты қорқыту үшін ұлттық билікті пайдалану
Dialogue: 0,0:16:51.80,0:16:53.72,Default,,0,0,0,,
Dialogue: 0,0:16:53.80,0:16:56.22,Default,,0,0,0,,Барлығы не болды?
Dialogue: 0,0:16:56.80,0:16:57.39,Default,,0,0,0,,Төмен түсуге болмайды!
Dialogue: 0,0:16:57.39,0:16:58.22,Default,,0,0,0,,Артқа шегінуге болмайды!
Dialogue: 0,0:16:57.39,0:16:58.22,Default,,0,0,0,,(Төменгі қадамдар)
Dialogue: 0,0:16:58.22,0:16:58.30,Default,,0,0,0,,(Төмендеу қадамдары)
Dialogue: 0,0:16:58.30,0:16:59.30,Default,,0,0,0,,(Төменгі қадамдар)
Dialogue: 0,0:16:58.30,0:16:59.30,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:59.30,0:16:59.72,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:59.81,0:17:01.72,Default,,0,0,0,,
Dialogue: 0,0:17:01.81,0:17:03.56,Default,,0,0,0,,Уцуми-санмен?
Dialogue: 0,0:17:04.06,0:17:06.23,Default,,0,0,0,,Қаншама әскермен
Dialogue: 0,0:17:06.31,0:17:10.73,Default,,0,0,0,,Миямото Мусашиді басуға болады деп ойлайсыз ба?
Dialogue: 0,0:17:11.32,0:17:13.74,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:17:13.82,0:17:15.24,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:17:15.32,0:17:17.24,Default,,0,0,0,,
Dialogue: 0,0:17:17.32,0:17:20.24,Default,,0,0,0,,(ОМОН қызметкерлерінің үрейлі дауыстары)
Dialogue: 0,0:17:20.33,0:17:21.45,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:21.95,0:17:25.00,Default,,0,0,0,,Бұл пайдасыз нәрсе.
Dialogue: 0,0:17:25.08,0:17:28.00,Default,,0,0,0,,
Dialogue: 0,0:17:30.09,0:17:34.30,Default,,0,0,0,,Миямото мырза, бұл күтпеген жағдай болуы мүмкін, бірақ
Dialogue: 0,0:17:34.38,0:17:38.01,Default,,0,0,0,,Біздің сізді ешқандай қылмыспен айыптау ниетіміз жоқ.
Dialogue: 0,0:17:41.31,0:17:45.02,Default,,0,0,0,,Бізбен бизнес жасағыңыз келе ме?
Dialogue: 0,0:17:47.10,0:17:49.02,Default,,0,0,0,,Мәміледен
Dialogue: 0,0:17:49.10,0:17:53.28,Default,,0,0,0,,Mosoftly... mossoftly Сіз баяу жүгіре аласыз ба?
Dialogue: 0,0:17:53.36,0:17:55.28,Default,,0,0,0,,(Алыстан келе жатқан көліктің дыбысы)
Dialogue: 0,0:17:55.86,0:17:59.74,Default,,0,0,0,,Кэндодан 4 жыл қатарынан бүкіл Жапония чемпионатының жеңімпазы
Dialogue: 0,0:17:59.82,0:18:02.28,Default,,0,0,0,,Такеджо Мива, 7-ші Дан, 38 жаста
Dialogue: 0,0:18:03.08,0:18:05.12,Default,,0,0,0,,Шені сержант
Dialogue: 0,0:18:05.62,0:18:09.00,Default,,0,0,0,,Мм...Мива-сан шығар?
Dialogue: 0,0:18:09.50,0:18:11.79,Default,,0,0,0,,Сіз дәл қазір күлдіңіз бе?
Dialogue: 0,0:18:11.88,0:18:14.42,Default,,0,0,0,,Хехе, көрдің бе?
Dialogue: 0,0:18:14.51,0:18:18.05,Default,,0,0,0,,Иә, арт жағынан бақытты көрінеді.
Dialogue: 0,0:18:18.63,0:18:22.55,Default,,0,0,0,,Сене аласыз ба? Бұл Миямото Мусаши.
Dialogue: 0,0:18:22.64,0:18:26.56,Default,,0,0,0,,Оның үстіне босатылу шартымен кездессеңіз.
Dialogue: 0,0:18:26.64,0:18:30.06,Default,,0,0,0,,Оның шын екеніне сенесіз бе?
Dialogue: 0,0:18:30.15,0:18:33.52,Default,,0,0,0,,Байланысқа түскен қызметкерлер сөйлейді
Dialogue: 0,0:18:34.07,0:18:35.57,Default,,0,0,0,,«Бұл шын»
Dialogue: 0,0:18:35.65,0:18:40.20,Default,,0,0,0,,Бұл жалпы білімі бар қызметкердің сөзі.
Dialogue: 0,0:18:40.28,0:18:42.57,Default,,0,0,0,,Таңқаларлық ештеңе жоқ.
Dialogue: 0,0:18:42.66,0:18:47.08,Default,,0,0,0,,Мен таң қалдым, бірақ мен де бұл көріністі жасай аламын.
Dialogue: 0,0:18:47.70,0:18:49.67,Default,,0,0,0,,Егер сіз өзіңізді полиция қызметкері деп атасаңыз
Dialogue: 0,0:18:49.75,0:18:53.46,Default,,0,0,0,,Бұл қызметкерлер тайджуцу бойынша әдеттегіден көп дайындықтан өтеді.
Dialogue: 0,0:18:53.54,0:18:56.63,Default,,0,0,0,,400 жыл бұрынғы самурайлар қазіргі заманда қайта жаңғырды
Dialogue: 0,0:18:57.13,0:19:00.34,Default,,0,0,0,,Біз оны «бұл мүмкін емес» деп қабылдасақ та
Dialogue: 0,0:19:00.43,0:19:03.10,Default,,0,0,0,,Менің денем бұған жол бермейді.
Dialogue: 0,0:19:03.18,0:19:06.85,Default,,0,0,0,,Менің денем Мусаши сияқты
Dialogue: 0,0:19:06.93,0:19:08.39,Default,,0,0,0,,(Полиция қызметкері А-ның күрсінуі)
Dialogue: 0,0:19:08.93,0:19:12.35,Default,,0,0,0,,Оны көрмейінше сенбейсің.
Dialogue: 0,0:19:12.94,0:19:15.19,Default,,0,0,0,,Мүмкін жауабы шығады
Dialogue: 0,0:19:15.94,0:19:20.36,Default,,0,0,0,,Кендо жай ғана семсермен күресудің үлгісі ме?
Dialogue: 0,0:19:21.32,0:19:24.87,Default,,0,0,0,,Әлде бұл қылыш шеберлігінің дамыған түрі ме?
Dialogue: 0,0:19:25.58,0:19:29.12,Default,,0,0,0,,Хмм... Мива-санның жауабы әрине...
Dialogue: 0,0:19:29.87,0:19:31.21,Default,,0,0,0,,Соңғысы.
Dialogue: 0,0:19:32.37,0:19:34.63,Default,,0,0,0,,Сіз дайын сияқтысыз.
Dialogue: 0,0:19:35.71,0:19:37.34,Default,,0,0,0,,Полиция бастығы!
Dialogue: 0,0:19:37.42,0:19:41.97,Default,,0,0,0,,Қағаз процедуралары да көп уақытты қажет етеді.
Dialogue: 0,0:19:42.47,0:19:47.39,Default,,0,0,0,,Өйткені, бұл қамауға алу ісі.
Dialogue: 0,0:19:47.97,0:19:48.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:49.47,0:19:54.40,Default,,0,0,0,,Мынау, қауесет Миямото Мусаши.
Dialogue: 0,0:19:55.27,0:19:56.73,Default,,0,0,0,,(Миваның ауыр тынысы)
Dialogue: 0,0:19:58.48,0:20:02.91,Default,,0,0,0,,Хехе мен сіздің шынайы пікіріңізді естігім келеді.
Dialogue: 0,0:20:03.41,0:20:04.91,Default,,0,0,0,,Бүкіл Жапония чемпионы болу
Dialogue: 0,0:20:05.87,0:20:08.66,Default,,0,0,0,,Мен не айтуым керек? Бұл...
Dialogue: 0,0:20:09.24,0:20:11.62,Default,,0,0,0,,Оны жауынгерлік рух деп атауға болады ма?
Dialogue: 0,0:20:11.71,0:20:15.67,Default,,0,0,0,,Мен осы сияқты тікелей нәрсе бар ма деп ойлаймын ...
Dialogue: 0,0:20:19.67,0:20:21.17,Default,,0,0,0,,Бастау!
Dialogue: 0,0:20:21.26,0:20:22.76,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:23.76,0:20:25.64,Default,,0,0,0,,Мен мұны көргім келді
Dialogue: 0,0:20:26.80,0:20:31.68,Default,,0,0,0,,Заманауи кендо әртістерінің бамбук қылыштарымен маңызды сәйкестік!
Dialogue: 0,0:20:32.68,0:20:35.19,Default,,0,0,0,,Қарудың салмағын азайту -
Dialogue: 0,0:20:36.06,0:20:37.69,Default,,0,0,0,,Жылдамдықпен секіріңіз!
Dialogue: 0,0:20:39.02,0:20:40.28,Default,,0,0,0,,Біз...
Dialogue: 0,0:20:42.28,0:20:44.45,Default,,0,0,0,,Шебер қылышшыдан асып түс!
Dialogue: 0,0:20:46.53,0:20:49.70,Default,,0,0,0,,Кендодағы аралық қашықтықта шабуыл және қорғаныс
Dialogue: 0,0:20:50.66,0:20:51.70,Default,,0,0,0,,Жылдамдық
Dialogue: 0,0:20:52.66,0:20:55.71,Default,,0,0,0,,Көрерменнің динамикалық көру өткірлігінен әлдеқайда асып түседі
Dialogue: 0,0:21:00.80,0:21:03.26,Default,,0,0,0,,Мен әуесқоймын!
Dialogue: 0,0:21:03.34,0:21:07.80,Default,,0,0,0,,Шығарылған аура аты аңызға айналған қылышшы Миямото Мусашидің атына лайық.
Dialogue: 0,0:21:07.89,0:21:11.72,Default,,0,0,0,,Бірақ менің алдымдағы адам бамбук қылыш ұстаған әуесқой!
Dialogue: 0,0:21:11.81,0:21:13.68,Default,,0,0,0,,Қайсысы жылдам?
Dialogue: 0,0:21:14.31,0:21:18.02,Default,,0,0,0,,Салмағы 2 кг темірді бір сермеп айналдыру.
Dialogue: 0,0:21:18.11,0:21:20.27,Default,,0,0,0,,Бұл сұмдық дүние емес
Dialogue: 0,0:21:20.94,0:21:24.07,Default,,0,0,0,,Бұл секундтың 1/100 бөлігінде жарысатын әлем.
Dialogue: 0,0:21:24.57,0:21:28.24,Default,,0,0,0,,Ең жеңіл салмақпен ультра жоғары жылдамдық!
Dialogue: 0,0:21:28.32,0:21:30.99,Default,,0,0,0,,Хехе, қарашы.
Dialogue: 0,0:21:31.08,0:21:34.75,Default,,0,0,0,,Бұрынғы аураның белгісі жоқ.
Dialogue: 0,0:21:34.83,0:21:36.50,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:36.58,0:21:37.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:38.58,0:21:40.50,Default,,0,0,0,,Соңғы кезде мен осыған қатты қызығып жүрмін, білесің бе~
Dialogue: 0,0:21:41.63,0:21:42.84,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:44.34,0:21:47.26,Default,,0,0,0,,Е!
Dialogue: 0,0:21:47.34,0:21:49.26,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:21:49.34,0:21:51.35,Default,,0,0,0,,Эй… эй…
Dialogue: 0,0:21:53.35,0:21:55.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:57.35,0:21:59.27,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:22:01.36,0:22:02.86,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:22:03.48,0:22:04.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:05.61,0:22:07.24,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:22:08.49,0:22:10.66,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:22:12.74,0:22:14.66,Default,,0,0,0,,Каааа...
Dialogue: 0,0:22:21.84,0:22:26.84,Default,,0,0,0,,♪~
Dialogue: 0,0:23:44.46,0:23:50.26,Default,,0,0,0,,~♪
