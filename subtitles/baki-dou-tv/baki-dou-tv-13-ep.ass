Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.51,0:01:39.51,Default,,0,0,0,,~♪
Dialogue: 0,0:01:44.68,0:01:48.77,Default,,0,0,0,,Соңғы кездескенімізге біраз болды.Кездесейік.
Dialogue: 0,0:01:48.85,0:01:49.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:50.61,0:01:51.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:51.61,0:01:56.03,Default,,0,0,0,,«Дожоларда ережелер, тәртіп және парасаттылық бар».
Dialogue: 0,0:01:56.65,0:01:59.03,Default,,0,0,0,,«Сондықтан доджо қауіпсіз».
Dialogue: 0,0:01:59.11,0:02:01.03,Default,,0,0,0,,Өтірікке толы
Dialogue: 0,0:02:01.12,0:02:03.28,Default,,0,0,0,,Ммм...
Dialogue: 0,0:02:03.37,0:02:07.79,Default,,0,0,0,,Менің қарсыласым Мотобу Изо, жекпе-жек шебері.
Dialogue: 0,0:02:08.41,0:02:12.04,Default,,0,0,0,,Сенсей, Додзо қауіпті жер ғой.
Dialogue: 0,0:02:12.79,0:02:16.05,Default,,0,0,0,,Жақсы ма? Сіз бастасаңыз да
Dialogue: 0,0:02:16.13,0:02:19.43,Default,,0,0,0,,Кез келген уақытта, кез келген жерде, кез келген адаммен—
Dialogue: 0,0:02:19.93,0:02:22.80,Default,,0,0,0,,Сізге практикалық жекпе-жек ұнайды.
Dialogue: 0,0:02:24.81,0:02:26.77,Default,,0,0,0,,Есеп айырысу дегеніміз не?
Dialogue: 0,0:02:27.27,0:02:30.10,Default,,0,0,0,,Ммм.
Dialogue: 0,0:02:30.19,0:02:31.94,Default,,0,0,0,,Сіз мұны орындай отырып шешесіз бе?
Dialogue: 0,0:02:34.36,0:02:35.69,Default,,0,0,0,,Растау
Dialogue: 0,0:02:35.78,0:02:37.44,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:02:41.82,0:02:44.20,Default,,0,0,0,,Капсуладағы күкірт қышқылы
Dialogue: 0,0:02:44.28,0:02:46.91,Default,,0,0,0,,Мен мұны айттым.
Dialogue: 0,0:02:47.00,0:02:49.96,Default,,0,0,0,,Бетіме тисе, мен дірілдеп қалар едім.
Dialogue: 0,0:02:57.05,0:02:58.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:00.22,0:03:01.22,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:03:04.55,0:03:05.72,Default,,0,0,0,,Хамф!
Dialogue: 0,0:03:05.81,0:03:06.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:08.06,0:03:09.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:09.81,0:03:10.69,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:11.31,0:03:12.85,Default,,0,0,0,,Уа! Гррр...
Dialogue: 0,0:03:12.94,0:03:14.36,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:03:14.44,0:03:16.36,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:03:16.44,0:03:19.36,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:03:23.82,0:03:25.16,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:03:26.20,0:03:27.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:31.75,0:03:33.63,Default,,0,0,0,,Сіз зиянсыз қаласыз.
Dialogue: 0,0:03:34.33,0:03:36.21,Default,,0,0,0,,Қалайсың, Гайя-кун?
Dialogue: 0,0:03:36.71,0:03:39.63,Default,,0,0,0,,Доджо қауіпсіз...
Dialogue: 0,0:03:39.71,0:03:41.38,Default,,0,0,0,,Хмм? Ой
Dialogue: 0,0:03:42.26,0:03:43.64,Default,,0,0,0,,...Бірақ солай емес пе?
Dialogue: 0,0:03:44.22,0:03:45.89,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:03:46.89,0:03:49.14,Default,,0,0,0,,Маған белбеуімді қайтар, Гайя-кун.
Dialogue: 0,0:03:49.22,0:03:50.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:50.98,0:03:53.90,Default,,0,0,0,,Нақты шайқассыз туған ел: Жапония
Dialogue: 0,0:03:55.56,0:03:59.07,Default,,0,0,0,,Мотобу Сенсэй әрекеттегі адам
Dialogue: 0,0:04:01.61,0:04:04.28,Default,,0,0,0,,Бұл баршаға белгілі ақиқат
Dialogue: 0,0:04:04.36,0:04:08.79,Default,,0,0,0,,Үлкен кішіден күшті.
Dialogue: 0,0:04:08.87,0:04:10.54,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:08.87,0:04:10.54,Default,,0,0,0,,Бәрі біледі
Dialogue: 0,0:04:10.62,0:04:12.79,Default,,0,0,0,,Ешкім істемейді
Dialogue: 0,0:04:13.67,0:04:16.83,Default,,0,0,0,,2 метр 43 см 201 кг
Dialogue: 0,0:04:17.34,0:04:21.55,Default,,0,0,0,,Бұл сіздің спорттық қабілетіңізді сақтауға мүмкіндік беретін шекті өлшем.
Dialogue: 0,0:04:21.63,0:04:24.30,Default,,0,0,0,,Маған Мусаши Миямотомен кездесуге рұқсат етіңізші.
Dialogue: 0,0:04:24.38,0:04:25.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:25.51,0:04:29.51,Default,,0,0,0,,О... «үлкенірек болса жақсы»
Dialogue: 0,0:04:29.60,0:04:32.81,Default,,0,0,0,,Сенің Мұсашимен кездескеніңді қаламайтын адам бар.
Dialogue: 0,0:04:35.90,0:04:37.73,Default,,0,0,0,,Бас кеңсе?
Dialogue: 0,0:04:37.81,0:04:39.82,Default,,0,0,0,,Иә Бас кеңсе
Dialogue: 0,0:04:39.90,0:04:43.07,Default,,0,0,0,,Штаб дегеніміз не?
Dialogue: 0,0:04:43.15,0:04:45.03,Default,,0,0,0,,Сол штаб.
Dialogue: 0,0:04:45.11,0:04:46.41,Default,,0,0,0,,(Сазанның су бетіне шашыраған дыбысы)
Dialogue: 0,0:04:46.49,0:04:47.87,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:04:47.95,0:04:51.83,Default,,0,0,0,,Неліктен әлгі Иззу Мотобе мені кешірмейді?
Dialogue: 0,0:04:51.91,0:04:53.29,Default,,0,0,0,,«Неге бұл штаб?»
Dialogue: 0,0:04:53.29,0:04:55.12,Default,,0,0,0,,«Неге бұл штаб?»
Dialogue: 0,0:04:53.29,0:04:55.12,Default,,0,0,0,,(Сазанның су бетіне шашыраған дыбысы)
Dialogue: 0,0:04:55.12,0:04:55.96,Default,,0,0,0,,(Сазанның су бетіне шашыраған дыбысы)
Dialogue: 0,0:04:56.04,0:04:57.58,Default,,0,0,0,,Джек Хаммер
Dialogue: 0,0:04:58.21,0:05:01.59,Default,,0,0,0,,Сол Изо штабымен бетпе-бет келіңіз.
Dialogue: 0,0:05:01.67,0:05:02.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:02.92,0:05:05.05,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:05:06.34,0:05:07.59,Default,,0,0,0,,Бас кеңсе?
Dialogue: 0,0:05:07.68,0:05:09.26,Default,,0,0,0,,«Бұл»
Dialogue: 0,0:05:09.35,0:05:10.85,Default,,0,0,0,,Бұл әлсіз
Dialogue: 0,0:05:10.93,0:05:12.43,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:05:12.52,0:05:14.18,Default,,0,0,0,,Сол қария
Dialogue: 0,0:05:14.27,0:05:17.85,Default,,0,0,0,,Мотобу Изоны түсінбеймін.
Dialogue: 0,0:05:18.69,0:05:19.19,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:05:19.19,0:05:20.61,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:05:19.19,0:05:20.61,Default,,0,0,0,,(Сазанның су бетіне шашыраған дыбысы)
Dialogue: 0,0:05:20.61,0:05:21.65,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:05:21.73,0:05:24.69,Default,,0,0,0,,Мен, сен, Джек.
Dialogue: 0,0:05:25.82,0:05:31.12,Default,,0,0,0,,Мен Мотобу Изо есімді адамның кім екенін білмеймін.
Dialogue: 0,0:05:31.83,0:05:33.37,Default,,0,0,0,,Unconscious!
Dialogue: 0,0:05:33.45,0:05:34.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.95,0:05:36.33,Default,,0,0,0,,Джек
Dialogue: 0,0:05:36.41,0:05:38.88,Default,,0,0,0,,Қару туралы не білу керек?
Dialogue: 0,0:05:40.34,0:05:41.63,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:05:42.55,0:05:43.55,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:05:43.63,0:05:44.63,Default,,0,0,0,,…бірақ
Dialogue: 0,0:05:46.13,0:05:47.76,Default,,0,0,0,,Менің тәжірибем бар
Dialogue: 0,0:05:50.68,0:05:53.01,Default,,0,0,0,,Мен ешқашан қиындық көрген емеспін.
Dialogue: 0,0:05:54.64,0:05:57.10,Default,,0,0,0,,Хехе, солай.
Dialogue: 0,0:05:57.19,0:06:00.23,Default,,0,0,0,,Мен штабтың есіне салуым керек.
Dialogue: 0,0:06:00.31,0:06:01.73,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:06:02.44,0:06:05.07,Default,,0,0,0,,Ойын алаңында емес.
Dialogue: 0,0:06:06.49,0:06:08.91,Default,,0,0,0,,Орналасқан жері түнгі саябақ.
Dialogue: 0,0:06:09.53,0:06:13.28,Default,,0,0,0,,Бұл ереже бразилиялық джиу-джитсудың бастауы болып табылады.
Dialogue: 0,0:06:13.37,0:06:15.33,Default,,0,0,0,,Кодокан дзюдо ардагері
Dialogue: 0,0:06:15.41,0:06:19.29,Default,,0,0,0,,Конде Команы Мицуё Маэда ұсынған.
Dialogue: 0,0:06:20.00,0:06:23.54,Default,,0,0,0,,Уақыт күресінен ауыр салмақтағы әлем чемпионы
Dialogue: 0,0:06:23.63,0:06:27.30,Default,,0,0,0,,Хакеншмидт, «Орыс арыстаны» деген атпен белгілі батыр
Dialogue: 0,0:06:28.05,0:06:30.89,Default,,0,0,0,,Маэда Шмидтпен кеште кездесті.
Dialogue: 0,0:06:30.97,0:06:34.76,Default,,0,0,0,,Сәлемдесу жеткілікті. Басқа стильдегі сәйкестікке өтініш беріңіз
Dialogue: 0,0:06:34.85,0:06:38.14,Default,,0,0,0,,Сондықтан мен бір ережені ұсынамын.
Dialogue: 0,0:06:38.64,0:06:43.56,Default,,0,0,0,,Екі жақ саябақта қарапайым киіммен жүреді.
Dialogue: 0,0:06:44.40,0:06:47.82,Default,,0,0,0,,Серуен екеуі кездескенше жалғасады
Dialogue: 0,0:06:48.40,0:06:50.66,Default,,0,0,0,,Кездесу Матчтың басталуы
Dialogue: 0,0:06:50.74,0:06:55.16,Default,,0,0,0,,Маэданың өтінішінде парасаттылық жетіспеді және жағдайды түсінбеді.
Dialogue: 0,0:06:55.24,0:06:58.83,Default,,0,0,0,,Шмидттің үлкендердің жауабының арқасында бәрі жақсы болды, бірақ...
Dialogue: 0,0:06:58.91,0:07:01.87,Default,,0,0,0,,Сіз бірінші нөмірлі дзюдосыз
Dialogue: 0,0:07:01.96,0:07:04.59,Default,,0,0,0,,I Бірінші нөмірлі күрес
Dialogue: 0,0:07:04.67,0:07:06.38,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:07:15.18,0:07:17.72,Default,,0,0,0,,Маған алдын ала хабарлаңыз
Dialogue: 0,0:07:18.39,0:07:21.48,Default,,0,0,0,,Күнделікті киім киетін Мотобу Изо толығымен қарусыз емес.
Dialogue: 0,0:07:21.56,0:07:23.73,Default,,0,0,0,,Қылыш немесе Яппа?
Dialogue: 0,0:07:23.81,0:07:25.98,Default,,0,0,0,,Орақ па, шурикен ме?
Dialogue: 0,0:07:26.07,0:07:28.23,Default,,0,0,0,,Жарылғыш заттар немесе шынжырлар?
Dialogue: 0,0:07:28.82,0:07:32.99,Default,,0,0,0,,Кез келген жағдайда қарсылас спортшы да, бәсекелес те емес.
Dialogue: 0,0:07:33.07,0:07:34.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:36.33,0:07:37.54,Default,,0,0,0,,Иә
Dialogue: 0,0:07:38.08,0:07:41.50,Default,,0,0,0,,Практикалық жекпе-жек суретшісі Мотобу Изо!
Dialogue: 0,0:07:41.58,0:07:44.67,Default,,0,0,0,,Ура!
Dialogue: 0,0:07:46.25,0:07:47.25,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:07:47.34,0:07:50.51,Default,,0,0,0,,Мен түсінемін, бұл сөзсіз үлкенірек.
Dialogue: 0,0:07:50.59,0:07:51.34,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:07:51.34,0:07:53.76,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:07:51.34,0:07:53.76,Default,,0,0,0,,Ол көп мағынада қолданылатын сияқты.
Dialogue: 0,0:07:53.76,0:07:53.84,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:07:53.84,0:07:54.76,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:07:53.84,0:07:54.76,Default,,0,0,0,,Әділ
Dialogue: 0,0:07:54.76,0:07:55.26,Default,,0,0,0,,Әділ
Dialogue: 0,0:07:55.34,0:07:59.52,Default,,0,0,0,,Қазіргі уақытта темекі шегетіндердің де санасы аз.
Dialogue: 0,0:08:08.36,0:08:09.28,Default,,0,0,0,,Біріншіден, қарсыласты гайка кілтесімен есінен тандырарлықтай ұрудың қаталдығы
Dialogue: 0,0:08:11.11,0:08:12.53,Default,,0,0,0,,Gunu...
Dialogue: 0,0:08:12.61,0:08:13.91,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:08:15.99,0:08:16.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:17.95,0:08:19.91,Default,,0,0,0,,Менің көру қабілетім нашар болса да
Dialogue: 0,0:08:20.50,0:08:22.41,Default,,0,0,0,,Бұл шайқастың түрі.
Dialogue: 0,0:08:23.37,0:08:26.04,Default,,0,0,0,,Жанып тұрған темекі шегу
Dialogue: 0,0:08:26.13,0:08:28.42,Default,,0,0,0,,Тосын шабуылды пайдаланатын дропкик
Dialogue: 0,0:08:28.50,0:08:32.67,Default,,0,0,0,,Джекпен болған оқиға оның сүйегіне бірден сіңіп кетті.
Dialogue: 0,0:08:33.26,0:08:34.18,Default,,0,0,0,,...болуы керек еді
Dialogue: 0,0:08:34.26,0:08:35.18,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:08:36.26,0:08:37.43,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:08:39.76,0:08:40.93,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:08:42.98,0:08:44.19,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:08:45.27,0:08:47.69,Default,,0,0,0,,Осыған қарамастан, ол әлі де үлкен.
Dialogue: 0,0:08:47.77,0:08:49.19,Default,,0,0,0,,Нуааах!
Dialogue: 0,0:08:49.27,0:08:50.44,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:56.28,0:08:59.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:59.78,0:09:00.95,Default,,0,0,0,,Аху
Dialogue: 0,0:09:01.04,0:09:03.70,Default,,0,0,0,,Ағаш қылышпен кесуге болатын доп?
Dialogue: 0,0:09:04.83,0:09:05.71,Default,,0,0,0,,Иә
Dialogue: 0,0:09:07.79,0:09:09.79,Default,,0,0,0,,(Джектің айқайлауы)
Dialogue: 0,0:09:10.29,0:09:11.75,Default,,0,0,0,,Хамф!
Dialogue: 0,0:09:15.47,0:09:17.47,Default,,0,0,0,,Қолға қару алуға әділ
Dialogue: 0,0:09:18.05,0:09:19.97,Default,,0,0,0,,Мен қателескен жоқпын
Dialogue: 0,0:09:23.56,0:09:26.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:26.81,0:09:28.73,Default,,0,0,0,,
Dialogue: 0,0:09:32.07,0:09:36.61,Default,,0,0,0,,Кез келген жағдайда, қарсылас «спортшы» немесе «бәсекелес» емес.
Dialogue: 0,0:09:36.70,0:09:41.33,Default,,0,0,0,,Ол стадионда көріп отырған Мотобу Изодан мүлдем өзгеше.
Dialogue: 0,0:09:43.16,0:09:44.50,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:09:45.25,0:09:47.25,Default,,0,0,0,,Бұл штаб емес.
Dialogue: 0,0:09:47.33,0:09:50.75,Default,,0,0,0,,Спортшыдан гөрі жауынгер
Dialogue: 0,0:09:50.84,0:09:54.26,Default,,0,0,0,,Жақсы дайындалған жауынгер сияқты
Dialogue: 0,0:09:54.34,0:09:55.26,Default,,0,0,0,,…бірақ
Dialogue: 0,0:09:55.34,0:09:58.01,Default,,0,0,0,,Адамдардың менің бәсекелестерімді сынағанын қаламаймын.
Dialogue: 0,0:09:58.09,0:10:00.26,Default,,0,0,0,,Қатты нәрсе...
Dialogue: 0,0:10:00.34,0:10:04.77,Default,,0,0,0,,Үйренген бәсекелес әрқашан жекпе-жек шеберлеріне қауіп төндіреді.
Dialogue: 0,0:10:05.60,0:10:09.23,Default,,0,0,0,,Қарсылас доп ойыншысы болса да
Dialogue: 0,0:10:09.31,0:10:12.15,Default,,0,0,0,,Үздік спортшыларды басқару өте қиын
Dialogue: 0,0:10:12.73,0:10:14.40,Default,,0,0,0,,Көптеген жекпе-жек шеберлері
Dialogue: 0,0:10:14.48,0:10:17.78,Default,,0,0,0,,Физикалық күштің үлкен айырмашылығы сізді итермелейді.
Dialogue: 0,0:10:17.86,0:10:21.53,Default,,0,0,0,,Әсіресе сол Джек Хаммерге қарсы.
Dialogue: 0,0:10:21.62,0:10:23.12,Default,,0,0,0,,(Джек рухы)
Dialogue: 0,0:10:24.12,0:10:25.41,Default,,0,0,0,,- (Өтіп бара жатқан А) О! -(Өтіп бара жатқан В) Әй...
Dialogue: 0,0:10:25.49,0:10:26.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:26.75,0:10:28.41,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:10:28.50,0:10:29.92,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:10:30.00,0:10:31.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:33.25,0:10:34.67,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:10:40.93,0:10:42.18,Default,,0,0,0,,Одан да көп...
Dialogue: 0,0:10:44.26,0:10:46.06,Default,,0,0,0,,Әсіресе басқа адам
Dialogue: 0,0:10:46.14,0:10:48.02,Default,,0,0,0,,Сол Джек Хаммер
Dialogue: 0,0:10:48.10,0:10:51.65,Default,,0,0,0,,2 метр 43 см 201 кг
Dialogue: 0,0:10:51.73,0:10:56.44,Default,,0,0,0,,Бұл өзінің ерекше өлшемін еркін басқара алатын физикалық құбыжық.
Dialogue: 0,0:10:56.53,0:10:57.94,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:10:59.15,0:11:03.95,Default,,0,0,0,,Орташа жекпе-жек шебері қолын немесе аяғын, найзасын немесе қылышын пайдалана алмайды.
Dialogue: 0,0:11:04.03,0:11:06.20,Default,,0,0,0,,- (Жолдан өтуші С) Не? -(Өтіп бара жатқан D) Суретке түсіп жатыр ма?
Dialogue: 0,0:11:06.29,0:11:08.00,Default,,0,0,0,,Өте үлкен!
Dialogue: 0,0:11:08.08,0:11:09.96,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:11:10.54,0:11:14.46,Default,,0,0,0,,Бақытымызға орай, өкінішке орай, мен орташа емеспін.
Dialogue: 0,0:11:14.54,0:11:16.71,Default,,0,0,0,,Ой!
Dialogue: 0,0:11:16.80,0:11:18.21,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:18.30,0:11:18.96,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:11:19.05,0:11:21.51,Default,,0,0,0,,Сіз күткендей, Джек.
Dialogue: 0,0:11:21.59,0:11:23.97,Default,,0,0,0,,Бұл таңғажайып сүйек тығыздығы.
Dialogue: 0,0:11:24.05,0:11:26.47,Default,,0,0,0,,Ең алдымен, сөзсіз
Dialogue: 0,0:11:27.06,0:11:28.97,Default,,0,0,0,,Мен бұны ампутация деп ойладым.
Dialogue: 0,0:11:29.77,0:11:32.48,Default,,0,0,0,,Ну~ Гуах~!
Dialogue: 0,0:11:32.56,0:11:33.56,Default,,0,0,0,,Гуваха!
Dialogue: 0,0:11:34.06,0:11:36.23,Default,,0,0,0,,(Джектің айқайлауы)
Dialogue: 0,0:11:36.82,0:11:38.78,Default,,0,0,0,,Не... құрастырады?
Dialogue: 0,0:11:38.86,0:11:40.49,Default,,0,0,0,,Кешіріңіз, мен жасырын жолаушымын.
Dialogue: 0,0:11:40.57,0:11:41.53,Default,,0,0,0,,(Үру)
Dialogue: 0,0:11:41.61,0:11:43.53,Default,,0,0,0,,Мені тістеп жатыр!
Dialogue: 0,0:11:46.12,0:11:48.04,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:11:48.12,0:11:50.37,Default,,0,0,0,,Бұл біртүрлі, Ан-Чан.
Dialogue: 0,0:11:50.45,0:11:54.54,Default,,0,0,0,,Нағыз Джек әп-сәтте сүйекті шайнап жіберер еді.
Dialogue: 0,0:11:56.13,0:11:58.55,Default,,0,0,0,,Бұл біртүрлі, Ан-чан.
Dialogue: 0,0:11:58.63,0:11:59.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:59.96,0:12:01.76,Default,,0,0,0,,Бұл тістеу жақсы.
Dialogue: 0,0:12:02.26,0:12:07.05,Default,,0,0,0,,Ол күшті, бірақ жауынгерлік емес.
Dialogue: 0,0:12:07.14,0:12:08.31,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:12:08.39,0:12:10.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:13.64,0:12:14.56,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:12:16.65,0:12:18.77,Default,,0,0,0,,- (I жүргінші) Иә? -(Өтіп бара жатқан Дж) Бірдеңе...
Dialogue: 0,0:12:18.86,0:12:20.57,Default,,0,0,0,,- (Өтіп бара жатқан К) Тіс - (Өтіп бара жатқан L) А!
Dialogue: 0,0:12:20.65,0:12:21.40,Default,,0,0,0,,Пакман Киборг
Dialogue: 0,0:12:21.40,0:12:22.65,Default,,0,0,0,,Пакман Киборг
Dialogue: 0,0:12:21.40,0:12:22.65,Default,,0,0,0,,(Джектің дірілдеген тынысы)
Dialogue: 0,0:12:22.65,0:12:22.74,Default,,0,0,0,,(Джектің дірілдеп тыныс алуы)
Dialogue: 0,0:12:22.74,0:12:24.82,Default,,0,0,0,,(Джектің дірілдеген тынысы)
Dialogue: 0,0:12:22.74,0:12:24.82,Default,,0,0,0,,Джек Хаммермен бірге тұру
Dialogue: 0,0:12:25.45,0:12:28.33,Default,,0,0,0,,Мен тіпті кәдімгі куртка кие алмаймын.
Dialogue: 0,0:12:28.41,0:12:29.58,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:12:30.20,0:12:31.83,Default,,0,0,0,,Арамид талшығы
Dialogue: 0,0:12:32.41,0:12:34.17,Default,,0,0,0,,Ұшақты күшейту
Dialogue: 0,0:12:34.25,0:12:35.83,Default,,0,0,0,,Парапландар сызығы
Dialogue: 0,0:12:35.92,0:12:38.34,Default,,0,0,0,,Радиалды шина материалдарында қолданылады
Dialogue: 0,0:12:39.00,0:12:42.21,Default,,0,0,0,,Оқ және жүз өткізбейтін мақсаттар үшін жасалған.
Dialogue: 0,0:12:42.30,0:12:44.84,Default,,0,0,0,,Бұл біраз қымбат болды.
Dialogue: 0,0:12:44.93,0:12:45.97,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:12:46.05,0:12:48.60,Default,,0,0,0,,Массетер кокос жаңғағын тістеуге мәжбүр етеді
Dialogue: 0,0:12:49.18,0:12:51.35,Default,,0,0,0,,Тістеген иық қауіпсіз емес, бірақ
Dialogue: 0,0:12:52.18,0:12:53.85,Default,,0,0,0,,Әлі де
Dialogue: 0,0:12:54.44,0:12:57.35,Default,,0,0,0,,Тәкаппар қаруымды жұлып алдым.
Dialogue: 0,0:12:57.44,0:12:59.61,Default,,0,0,0,,Нггаааааааааааааааа!
Dialogue: 0,0:13:00.27,0:13:01.61,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:13:01.69,0:13:03.11,Default,,0,0,0,,(өтіп бара жатқан адамның дірілдеген дауысы М)
Dialogue: 0,0:13:03.78,0:13:05.86,Default,,0,0,0,,Менің сол аяғым жоқ сияқты жақсы.
Dialogue: 0,0:13:05.95,0:13:09.12,Default,,0,0,0,,Жақтағы қару да жоғалған.
Dialogue: 0,0:13:09.20,0:13:13.04,Default,,0,0,0,,Мен тапқан биіктің енді мағынасы жоқ.
Dialogue: 0,0:13:13.12,0:13:14.37,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:13:14.46,0:13:16.87,Default,,0,0,0,,(Үру)
Dialogue: 0,0:13:16.96,0:13:18.63,Default,,0,0,0,,-(Өтіп бара жатқан N) Ой... -(Өтуші О) О~
Dialogue: 0,0:13:18.71,0:13:20.88,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:13:21.46,0:13:25.63,Default,,0,0,0,,Азу тістері жоғалса да, ол әлі де Джек Хаммер.
Dialogue: 0,0:13:26.22,0:13:29.39,Default,,0,0,0,,Арыстан азуынан айырылса да арыстан болып қалады
Dialogue: 0,0:13:29.47,0:13:32.89,Default,,0,0,0,,Аю тырнақтары сынса да аю.
Dialogue: 0,0:13:32.97,0:13:33.56,Default,,0,0,0,,(Арыстанның ақыруы)
Dialogue: 0,0:13:33.56,0:13:35.73,Default,,0,0,0,,(Арыстанның ақыруы)
Dialogue: 0,0:13:33.56,0:13:35.73,Default,,0,0,0,,Азу, тырнақсыз аң
Dialogue: 0,0:13:35.81,0:13:37.90,Default,,0,0,0,,Сіз жеңе аласыз ба?
Dialogue: 0,0:13:37.98,0:13:41.98,Default,,0,0,0,,Жасайық! Гуаааааааааааааааа!
Dialogue: 0,0:13:44.49,0:13:45.44,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:44.49,0:13:45.44,Default,,0,0,0,,(Джектің ұрыс айқайы жалғасуда)
Dialogue: 0,0:13:45.44,0:13:45.53,Default,,0,0,0,,(Джектің ұрыс айқайы жалғасуда)
Dialogue: 0,0:13:45.53,0:13:47.40,Default,,0,0,0,,(Джектің ұрыс айқайы жалғасуда)
Dialogue: 0,0:13:45.53,0:13:47.40,Default,,0,0,0,,- (Өтіп бара жатқан С.) Бітті - (Өтуші Р) Бұл полиция!
Dialogue: 0,0:13:48.03,0:13:49.74,Default,,0,0,0,,Джек күткендей
Dialogue: 0,0:13:50.74,0:13:54.12,Default,,0,0,0,,Мен сенімен физикалық тұрғыда бәсекелесе алмаймын.
Dialogue: 0,0:13:55.20,0:13:57.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:57.25,0:13:58.46,Default,,0,0,0,,
Dialogue: 0,0:13:58.54,0:13:59.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:59.79,0:14:01.42,Default,,0,0,0,,Жарылыс О, жоқ!
Dialogue: 0,0:14:01.50,0:14:04.42,Default,,0,0,0,,(Джектің ұрыс айқайы жалғасуда)
Dialogue: 0,0:14:05.01,0:14:05.92,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:14:06.80,0:14:08.01,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:14:08.09,0:14:10.97,Default,,0,0,0,,Бір... жалғасы!
Dialogue: 0,0:14:11.05,0:14:13.18,Default,,0,0,0,,Мен сені әлі ұрып жатырмын!
Dialogue: 0,0:14:13.85,0:14:15.43,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:14:15.52,0:14:16.98,Default,,0,0,0,,Сәлем Джек
Dialogue: 0,0:14:17.06,0:14:18.44,Default,,0,0,0,,Джек...
Dialogue: 0,0:14:18.52,0:14:21.19,Default,,0,0,0,,Бұл тоқтайды, солай ма?
Dialogue: 0,0:14:22.73,0:14:23.90,Default,,0,0,0,,Және...
Dialogue: 0,0:14:24.78,0:14:25.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:26.57,0:14:28.20,Default,,0,0,0,,Ол жылдамдауда!
Dialogue: 0,0:14:28.28,0:14:30.24,Default,,0,0,0,,Қалқымалы дене!
Dialogue: 0,0:14:31.03,0:14:32.45,Default,,0,0,0,,Ku~!
Dialogue: 0,0:14:33.03,0:14:34.45,Default,,0,0,0,,Сондай дарынды адам...
Dialogue: 0,0:14:35.24,0:14:37.45,Default,,0,0,0,,Оны Мұсашыға берме!
Dialogue: 0,0:14:38.12,0:14:39.46,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:40.88,0:14:42.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:43.09,0:14:43.92,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:44.00,0:14:44.96,Default,,0,0,0,,Иіс...
Dialogue: 0,0:14:45.96,0:14:47.72,Default,,0,0,0,,Мотобу Изо
Dialogue: 0,0:14:47.80,0:14:48.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.05,0:14:52.72,Default,,0,0,0,,Сізде мылтық жасырылған.
Dialogue: 0,0:14:52.80,0:14:54.72,Default,,0,0,0,,
Dialogue: 0,0:14:54.81,0:14:57.10,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:14:57.18,0:15:01.23,Default,,0,0,0,,Нағыз күрескердің мұндай болғаны таң қалдырады.
Dialogue: 0,0:15:01.90,0:15:06.23,Default,,0,0,0,,Жұдырықпен ұруға берілгені сонша, жарылысты да байқамай қалды.
Dialogue: 0,0:15:06.86,0:15:09.28,Default,,0,0,0,,Мен ерініп қалдым.
Dialogue: 0,0:15:09.36,0:15:14.12,Default,,0,0,0,,Мен консервативті баға бердім, өйткені мен оны асыра алғым келмеді.
Dialogue: 0,0:15:14.74,0:15:16.62,Default,,0,0,0,,Қарсылас – Джек Хаммер
Dialogue: 0,0:15:16.70,0:15:19.62,Default,,0,0,0,,Мен тағы да мылтық қосуым керек еді.
Dialogue: 0,0:15:21.21,0:15:22.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:26.50,0:15:27.88,Default,,0,0,0,,Өте өкінішті, Джек.
Dialogue: 0,0:15:27.96,0:15:29.42,Default,,0,0,0,,Толық дроссель!
Dialogue: 0,0:15:29.51,0:15:30.63,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:32.47,0:15:34.64,Default,,0,0,0,,Менің өмірім оған тұрарлық емес
Dialogue: 0,0:15:34.72,0:15:37.39,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:15:39.22,0:15:40.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:43.94,0:15:45.40,Default,,0,0,0,,Гррр!
Dialogue: 0,0:15:47.19,0:15:48.65,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:50.49,0:15:51.65,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:51.74,0:15:52.91,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:15:51.74,0:15:52.91,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:53.95,0:15:55.66,Default,,0,0,0,,Нгия! Арх!
Dialogue: 0,0:15:56.49,0:15:57.74,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:03.25,0:16:06.92,Default,,0,0,0,,(арқанмен скрипка дыбысы)
Dialogue: 0,0:16:07.00,0:16:09.92,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:16:10.01,0:16:11.55,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:11.63,0:16:14.22,Default,,0,0,0,,Мен дәуді байладым.
Dialogue: 0,0:16:14.72,0:16:16.18,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:16:16.26,0:16:17.47,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:16:17.55,0:16:20.43,Default,,0,0,0,,Бұл ұлы зұлым Юдзиро Ханманың сөздері.
Dialogue: 0,0:16:21.02,0:16:23.60,Default,,0,0,0,,«Ұрыс кезіндегі бастың жағдайы»
Dialogue: 0,0:16:24.10,0:16:27.44,Default,,0,0,0,,«Кім жоғары болса, сол жеңімпаз»
Dialogue: 0,0:16:29.40,0:16:31.86,Default,,0,0,0,,Осы тұрғыдан алғанда
Dialogue: 0,0:16:31.94,0:16:34.95,Default,,0,0,0,,Менің ойымша, бұл мен үшін жеңіс.
Dialogue: 0,0:16:35.03,0:16:36.95,Default,,0,0,0,,Қарғыс атсын! Гррр...
Dialogue: 0,0:16:37.03,0:16:40.95,Default,,0,0,0,,Бірақ менің пікірім сәл басқаша.
Dialogue: 0,0:16:41.04,0:16:42.45,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:16:43.04,0:16:44.96,Default,,0,0,0,,Өмір мен өлім беру және алу
Dialogue: 0,0:16:45.87,0:16:49.21,Default,,0,0,0,,Өлтіру еркіндігі, құтқару еркіндігі
Dialogue: 0,0:16:49.84,0:16:50.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:53.05,0:16:56.47,Default,,0,0,0,,Туу немесе өлтіру құқығын бірінші рет алған адам.
Dialogue: 0,0:16:56.55,0:16:59.10,Default,,0,0,0,,Бұл қозғалмаған жеңімпаз.
Dialogue: 0,0:16:59.18,0:17:01.31,Default,,0,0,0,,Оны талқылағым келмейді.
Dialogue: 0,0:17:02.60,0:17:05.69,Default,,0,0,0,,...сізді әрқашан қорғайды
Dialogue: 0,0:17:09.02,0:17:11.73,Default,,0,0,0,,Сыбыс басталды
Dialogue: 0,0:17:12.86,0:17:15.24,Default,,0,0,0,,Өткен жылдың соңынан бері?
Dialogue: 0,0:17:16.28,0:17:18.74,Default,,0,0,0,,Қанда өзеніндегі тұқы жоғалып кетті.
Dialogue: 0,0:17:19.58,0:17:20.74,Default,,0,0,0,,Оның бассейні
Dialogue: 0,0:17:21.62,0:17:26.00,Default,,0,0,0,,Әр жерде көрінген сазан жоғалып кетті дейді.
Dialogue: 0,0:17:30.79,0:17:33.51,Default,,0,0,0,,Хехе, бұл құпия жер.
Dialogue: 0,0:17:34.13,0:17:37.51,Default,,0,0,0,,Көбінесе күтпеген жерде...
Dialogue: 0,0:17:37.59,0:17:39.01,Default,,0,0,0,,Ой! Йотто
Dialogue: 0,0:17:39.09,0:17:41.26,Default,,0,0,0,,Иә! О!
Dialogue: 0,0:17:44.85,0:17:46.23,Default,,0,0,0,,(Жеміс жүзген судың дыбысы)
Dialogue: 0,0:17:46.73,0:17:48.02,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:17:48.10,0:17:49.35,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:48.10,0:17:49.35,Default,,0,0,0,,(Үлкен толқындардың дыбысы)
Dialogue: 0,0:17:49.35,0:17:49.86,Default,,0,0,0,,(Үлкен толқындардың дыбысы)
Dialogue: 0,0:17:49.86,0:17:50.98,Default,,0,0,0,,(Үлкен толқындардың дыбысы)
Dialogue: 0,0:17:49.86,0:17:50.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:50.98,0:17:51.07,Default,,0,0,0,,(Үлкен толқындардың дыбысы)
Dialogue: 0,0:17:51.07,0:17:52.52,Default,,0,0,0,,(Үлкен толқындардың дыбысы)
Dialogue: 0,0:17:51.07,0:17:52.52,Default,,0,0,0,,тунец?
Dialogue: 0,0:17:52.61,0:17:54.03,Default,,0,0,0,,Қай уақытта болса да, қазір тоғыз болды ғой!
Dialogue: 0,0:17:54.11,0:17:56.03,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:18:05.25,0:18:06.33,Default,,0,0,0,,(Тікұшақ винтінің дыбысы жалғасуда)
Dialogue: 0,0:18:06.33,0:18:08.17,Default,,0,0,0,,(Тікұшақ винтінің дыбысы жалғасуда)
Dialogue: 0,0:18:06.33,0:18:08.17,Default,,0,0,0,,Бұралған
Dialogue: 0,0:18:08.25,0:18:11.92,Default,,0,0,0,,10 метр - Арука деп аталатын үй қайығы.
Dialogue: 0,0:18:12.00,0:18:14.09,Default,,0,0,0,,Физикалық мүмкін емес
Dialogue: 0,0:18:14.17,0:18:16.92,Default,,0,0,0,,Корпустың ортасынан жіп үзілген дейді...
Dialogue: 0,0:18:17.55,0:18:19.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:19.43,0:18:21.76,Default,,0,0,0,,Қандай күш қолданылды?
Dialogue: 0,0:18:22.26,0:18:25.43,Default,,0,0,0,,Немесе не пайда болды?
Dialogue: 0,0:18:26.27,0:18:28.52,Default,,0,0,0,,Қазіргі уақытта полиция мен өрт сөндіру бөлімдері бірлесіп
Dialogue: 0,0:18:28.60,0:18:30.19,Default,,0,0,0,,Олар тергеу жүргізіп жатқан сияқты.
Dialogue: 0,0:18:30.27,0:18:31.23,Default,,0,0,0,,Йошида мырза
Dialogue: 0,0:18:31.31,0:18:34.23,Default,,0,0,0,,Жүргізуші Сатоси Такенака...
Dialogue: 0,0:18:34.32,0:18:35.36,Default,,0,0,0,,Йошида мырза
Dialogue: 0,0:18:35.44,0:18:38.45,Default,,0,0,0,,Баратын жерінде әлі есін жиған жоқ...
Dialogue: 0,0:18:38.53,0:18:39.61,Default,,0,0,0,,Йошида мырза
Dialogue: 0,0:18:39.70,0:18:41.70,Default,,0,0,0,,Мен сауығып кеткен бойда апаттың мән-жайын түсіндіремін...
Dialogue: 0,0:18:41.78,0:18:44.45,Default,,0,0,0,,Тікұшақтың дыбысынан ба?
Dialogue: 0,0:18:44.54,0:18:46.83,Default,,0,0,0,,Тыңдауға жоспарланған
Dialogue: 0,0:18:46.91,0:18:48.96,Default,,0,0,0,,Сіз мені естисіз деп ойлаймын.
Dialogue: 0,0:18:49.04,0:18:51.42,Default,,0,0,0,,Тағы бір ақпарат...
Dialogue: 0,0:18:51.50,0:18:53.17,Default,,0,0,0,,Аа, Йошида мырза, артыңызда!
Dialogue: 0,0:18:53.25,0:18:56.17,Default,,0,0,0,,Осы Қанда өзенінің алабындағы тұқы жоғалып кетті.
Dialogue: 0,0:18:56.26,0:18:57.17,Default,,0,0,0,,Йошида мырза!
Dialogue: 0,0:18:57.26,0:18:58.42,Default,,0,0,0,,Сол қауесет...
Dialogue: 0,0:18:58.51,0:19:00.43,Default,,0,0,0,,Йошида! артта!
Dialogue: 0,0:19:00.51,0:19:01.51,Default,,0,0,0,,Ha
Dialogue: 0,0:19:01.59,0:19:04.60,Default,,0,0,0,,(қолтырауынның ақыруы)
Dialogue: 0,0:19:01.59,0:19:04.60,Default,,0,0,0,,Артқа, артқа, артқа, артқа!
Dialogue: 0,0:19:04.60,0:19:05.26,Default,,0,0,0,,Артқа, артқа, артқа, артқа!
Dialogue: 0,0:19:05.85,0:19:07.27,Default,,0,0,0,,Йошида-кун
Dialogue: 0,0:19:07.35,0:19:09.27,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:19:09.35,0:19:11.52,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:21.03,0:19:24.53,Default,,0,0,0,,Гоминины Пиклдің пайда болуы
Dialogue: 0,0:19:25.12,0:19:26.29,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:25.12,0:19:26.29,Default,,0,0,0,,Иесі тастап кеткен
Dialogue: 0,0:19:26.29,0:19:26.37,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:26.37,0:19:28.83,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:26.37,0:19:28.83,Default,,0,0,0,,Үлкен болып кеткен тұзды су қолтырауыны
Dialogue: 0,0:19:28.83,0:19:29.29,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:30.16,0:19:32.54,Default,,0,0,0,,Ол өте үлкен болғанымен,
Dialogue: 0,0:19:32.62,0:19:33.33,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:33.33,0:19:34.79,Default,,0,0,0,,(қолтырауынның үруі)
Dialogue: 0,0:19:33.33,0:19:34.79,Default,,0,0,0,,Пиклдің көзінен
Dialogue: 0,0:19:35.59,0:19:37.55,Default,,0,0,0,,Пиклдің фоны негізінде,
Dialogue: 0,0:19:38.17,0:19:41.55,Default,,0,0,0,,Кішкентай динозавр
Dialogue: 0,0:19:41.63,0:19:42.38,Default,,0,0,0,,(Үру)
Dialogue: 0,0:19:42.38,0:19:44.55,Default,,0,0,0,,(Үру)
Dialogue: 0,0:19:42.38,0:19:44.55,Default,,0,0,0,,Көзінде қармақ
Dialogue: 0,0:19:44.64,0:19:48.06,Default,,0,0,0,,Эй... бұл кішкентай тесік.
Dialogue: 0,0:19:48.81,0:19:49.81,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:19:51.39,0:19:53.94,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:19:54.02,0:19:55.06,Default,,0,0,0,,Ауырды, солай ма?
Dialogue: 0,0:19:55.15,0:19:58.07,Default,,0,0,0,,(Үру)
Dialogue: 0,0:19:58.15,0:20:01.40,Default,,0,0,0,,Қандай... күш қандай?
Dialogue: 0,0:20:01.49,0:20:03.07,Default,,0,0,0,,Бұльдозер сияқты
Dialogue: 0,0:20:04.16,0:20:05.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:05.41,0:20:06.91,Default,,0,0,0,,О~
Dialogue: 0,0:20:07.45,0:20:09.33,Default,,0,0,0,,Ол кірді.
Dialogue: 0,0:20:10.91,0:20:15.50,Default,,0,0,0,,Мен өте жақсы репортер Йошида мырзадан хабар алған жоқпын.
Dialogue: 0,0:20:15.58,0:20:18.59,Default,,0,0,0,,Әрине, бұл оның кінәсі емес.
Dialogue: 0,0:20:18.67,0:20:22.84,Default,,0,0,0,,Динозаврға ұқсайтын үлкен қолтырауын пайда болды.
Dialogue: 0,0:20:23.51,0:20:26.35,Default,,0,0,0,,Қайық бұзылды және
Dialogue: 0,0:20:26.43,0:20:29.01,Default,,0,0,0,,Кенеттен жұмбақ құбыжық пайда болды...
Dialogue: 0,0:20:31.43,0:20:33.10,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:20:33.19,0:20:35.60,Default,,0,0,0,,Не істеп жатырсың, Мусаши?
Dialogue: 0,0:20:36.19,0:20:37.61,Default,,0,0,0,,Мен оны міндетті түрде өлтірдім.
Dialogue: 0,0:20:38.40,0:20:41.36,Default,,0,0,0,,Ол адам қайда жоғалып кетті?
Dialogue: 0,0:20:41.44,0:20:44.61,Default,,0,0,0,,Сен ақымақсың ба? Сіз теледидарды өшіргенде не істейсіз?
Dialogue: 0,0:20:44.70,0:20:47.16,Default,,0,0,0,,Бірінші орында радиотолқындар болды.
Dialogue: 0,0:20:47.24,0:20:50.87,Default,,0,0,0,,Тек ауада ұшып, камера түсірген суреттерді қайтару арқылы...
Dialogue: 0,0:20:50.95,0:20:54.62,Default,,0,0,0,,Ал ол адам кім?
Dialogue: 0,0:20:54.71,0:20:56.38,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:57.00,0:20:57.88,Default,,0,0,0,,Тұздалған қияр
Dialogue: 0,0:20:57.96,0:20:59.38,Default,,0,0,0,,Тұздалған қияр?
Dialogue: 0,0:20:59.46,0:21:01.34,Default,,0,0,0,,Гоминидтік тұздық
Dialogue: 0,0:21:01.42,0:21:05.13,Default,,0,0,0,,Бор кезеңіндегі ең күшті еркек, оның негізгі қорегі динозаврлар болды.
Dialogue: 0,0:21:05.22,0:21:08.64,Default,,0,0,0,,Гэнджин? Хакуаки?
Dialogue: 0,0:21:08.72,0:21:11.89,Default,,0,0,0,,Бүгінгі стиль... Тыңдамайтын мектеп.
Dialogue: 0,0:21:11.97,0:21:14.31,Default,,0,0,0,,Бірінші орында Нью-Мексико
Dialogue: 0,0:21:14.39,0:21:19.90,Default,,0,0,0,,Зерттеушілер 250 миллион жылдық тас тұзынан ұсақ дәндер тапты...
Dialogue: 0,0:21:20.82,0:21:23.40,Default,,0,0,0,,Бұл адам қайда?
Dialogue: 0,0:21:25.20,0:21:28.70,Default,,0,0,0,,Сізге Пикл қызық па?
Dialogue: 0,0:21:28.78,0:21:29.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:29.99,0:21:32.16,Default,,0,0,0,,Fungggggggg...
Dialogue: 0,0:21:32.24,0:21:35.71,Default,,0,0,0,,Хмм, мен жау болуға тым жетілмегенмін.
Dialogue: 0,0:21:35.79,0:21:37.25,Default,,0,0,0,,Сіз оны кесіп тастадыңыз.
Dialogue: 0,0:21:37.33,0:21:38.92,Default,,0,0,0,,Хмм қызық
Dialogue: 0,0:21:39.00,0:21:41.17,Default,,0,0,0,,Жылтыратпағанның беріктігі
Dialogue: 0,0:21:41.75,0:21:42.88,Default,,0,0,0,,Ол кір...
Dialogue: 0,0:21:42.96,0:21:45.17,Default,,0,0,0,,Сіз мені бір жағынан түсінесіз.
Dialogue: 0,0:21:45.26,0:21:46.43,Default,,0,0,0,,Ой!
Dialogue: 0,0:21:46.51,0:21:48.34,Default,,0,0,0,,(Мицунаридің ыңырсыуы)
Dialogue: 0,0:21:48.43,0:21:49.93,Default,,0,0,0,,Танысайық
Dialogue: 0,0:22:00.02,0:22:01.36,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:22:06.07,0:22:08.99,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:22:11.58,0:22:17.50,Default,,0,0,0,,Сен оны қорғай алмайсың ба?
Dialogue: 0,0:22:21.75,0:22:26.76,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.13,0:23:50.13,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.63,0:23:57.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory