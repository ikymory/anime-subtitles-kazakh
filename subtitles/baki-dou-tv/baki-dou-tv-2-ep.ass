Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.76,Default,,0,0,0,,♪~
Dialogue: 0,0:01:36.01,0:01:41.01,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.10,0:01:43.01,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:01:56.11,0:01:57.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:57.61,0:01:58.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:58.78,0:01:59.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:00.28,0:02:01.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:02.91,0:02:04.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:04.16,0:02:05.08,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:02:07.66,0:02:09.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:09.75,0:02:11.08,Default,,0,0,0,,Сені ұрып-соғып тастауға тура келуі – нағыз азап қой—
Dialogue: 0,0:02:11.75,0:02:14.67,Default,,0,0,0,,Шайқас генерал Шибукава Гокидің бас басшысы
Dialogue: 0,0:02:14.75,0:02:19.84,Default,,0,0,0,,Мен оны екінші аяқ қылышпен ұрлағаныма сенімді болдым, бірақ әрекет сәтсіз аяқталды.
Dialogue: 0,0:02:21.34,0:02:23.97,Default,,0,0,0,,Жоқ, менің шашымның бәрі тік тұр.
Dialogue: 0,0:02:24.06,0:02:26.85,Default,,0,0,0,,Менің басымнан ұшып кете жаздадым.
Dialogue: 0,0:02:27.43,0:02:28.18,Default,,0,0,0,,Иә
Dialogue: 0,0:02:28.69,0:02:31.35,Default,,0,0,0,,Бір қарулы түпнұсқа
Dialogue: 0,0:02:31.44,0:02:34.86,Default,,0,0,0,,Аяқтауға жеткен балық
Dialogue: 0,0:02:34.94,0:02:36.03,Default,,0,0,0,,2 буын
Dialogue: 0,0:02:36.11,0:02:38.28,Default,,0,0,0,,Сіз мені мазақтап жатырсыз.
Dialogue: 0,0:02:38.36,0:02:40.53,Default,,0,0,0,,Мен бір ғана түртуге рұқсат етсем де
Dialogue: 0,0:02:41.49,0:02:42.53,Default,,0,0,0,,Хи хи
Dialogue: 0,0:02:43.37,0:02:44.58,Default,,0,0,0,,Арнайы дайындық?
Dialogue: 0,0:02:44.66,0:02:45.54,Default,,0,0,0,,Иә
Dialogue: 0,0:02:46.20,0:02:49.00,Default,,0,0,0,,Ата-ана мен бала төбелесінен кейін басталды.
Dialogue: 0,0:02:49.08,0:02:51.29,Default,,0,0,0,,Мен мазасыздануды тоқтата алмаймын
Dialogue: 0,0:02:51.88,0:02:55.30,Default,,0,0,0,,Денеңізді шамадан тыс жүктемесеңіз...
Dialogue: 0,0:02:58.05,0:03:00.34,Default,,0,0,0,,Сіз де...
Dialogue: 0,0:03:00.84,0:03:02.89,Default,,0,0,0,,«Сен де» нені білдіреді?
Dialogue: 0,0:03:02.97,0:03:04.72,Default,,0,0,0,,Менің ойымша, барлығы осындай.
Dialogue: 0,0:03:04.80,0:03:05.81,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:03:05.89,0:03:08.73,Default,,0,0,0,,Бірінші әкесі Доппо
Dialogue: 0,0:03:08.81,0:03:11.31,Default,,0,0,0,,Сіздің сарқырама ванналарын қабылдай бастағаныңызды естідім.
Dialogue: 0,0:03:11.39,0:03:12.81,Default,,0,0,0,,Сенің жасыңда
Dialogue: 0,0:03:12.90,0:03:14.56,Default,,0,0,0,,Менің құлағым жылдам.
Dialogue: 0,0:03:15.19,0:03:16.65,Default,,0,0,0,,Бас кеңсе
Dialogue: 0,0:03:16.73,0:03:18.32,Default,,0,0,0,,Мотобу Изо-сан?
Dialogue: 0,0:03:18.40,0:03:20.07,Default,,0,0,0,,Ямагоморижато
Dialogue: 0,0:03:20.15,0:03:22.07,Default,,0,0,0,,Кошо Шиноги
Dialogue: 0,0:03:22.16,0:03:26.83,Default,,0,0,0,,Мен күндіз-түні перфораторды ашамын.
Dialogue: 0,0:03:26.91,0:03:30.83,Default,,0,0,0,,Жөндеу үшін жабысқақ таспаның құны жаман емес сияқты.
Dialogue: 0,0:03:31.66,0:03:33.33,Default,,0,0,0,,Менің ағам, Момиджи.
Dialogue: 0,0:03:34.00,0:03:36.34,Default,,0,0,0,,Менің негізгі жұмысым сол.
Dialogue: 0,0:03:36.42,0:03:40.09,Default,,0,0,0,,Джек дозасы артып келеді.
Dialogue: 0,0:03:40.17,0:03:43.30,Default,,0,0,0,,Мен білмеймін, өйткені Король Рецукай Америкадан.
Dialogue: 0,0:03:43.38,0:03:45.35,Default,,0,0,0,,Олива мырза ше?
Dialogue: 0,0:03:45.43,0:03:48.14,Default,,0,0,0,,Елордалық полиция бөлімінің студенттері туралы ақпарат
Dialogue: 0,0:03:48.22,0:03:51.35,Default,,0,0,0,,Мушодағы ең ауыр жұмысты жасайтын адам – Олива.
Dialogue: 0,0:03:52.06,0:03:53.73,Default,,0,0,0,,Менің білуімше
Dialogue: 0,0:03:53.81,0:03:57.11,Default,,0,0,0,,Өзгермеген жалғыз нәрсе - Каору Ханаяма.
Dialogue: 0,0:03:57.86,0:04:00.40,Default,,0,0,0,,Сонымен, Шибукава мырза, сіз ше?
Dialogue: 0,0:04:00.49,0:04:02.65,Default,,0,0,0,,Хмм Катцуми-сан
Dialogue: 0,0:04:02.74,0:04:05.11,Default,,0,0,0,,Сіз түсіндіңіз деп ойлаймын.
Dialogue: 0,0:04:05.20,0:04:09.91,Default,,0,0,0,,Егер сіз ұзақ уақыт бойы «бу» деп аталатын нәрсемен айналыссаңыз, сізде біртүрлі нәрсе пайда болады.
Dialogue: 0,0:04:09.99,0:04:12.12,Default,,0,0,0,,Дағдарыстарды алдын ала анықтау—
Dialogue: 0,0:04:12.21,0:04:15.88,Default,,0,0,0,,Болжау қабілеті деп аталатын нәрсеге ие боласыз.
Dialogue: 0,0:04:16.58,0:04:17.84,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:04:18.34,0:04:19.63,Default,,0,0,0,,Катцуми-сан
Dialogue: 0,0:04:20.21,0:04:23.13,Default,,0,0,0,,Менде бір нәрсені алдын ала сезіп тұрмын.
Dialogue: 0,0:04:23.22,0:04:24.72,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:04:31.85,0:04:34.64,Default,,0,0,0,,(Құрылғы жұмысының шуы)
Dialogue: 0,0:04:37.23,0:04:41.19,Default,,0,0,0,,Хе-хэ-хэ оның жыныстық тартымдылығы жоқ.
Dialogue: 0,0:04:41.28,0:04:45.11,Default,,0,0,0,,Бірақ тақсыр, бұл міндетті түрде қайта өндіру.
Dialogue: 0,0:04:45.20,0:04:47.99,Default,,0,0,0,,Қандай органикалық емес жыныстық әрекет.
Dialogue: 0,0:04:48.07,0:04:49.28,Default,,0,0,0,,Керемет...
Dialogue: 0,0:04:49.37,0:04:51.87,Default,,0,0,0,,Бұл керемет сексуалдық әрекет.
Dialogue: 0,0:04:51.95,0:04:53.41,Default,,0,0,0,,Мен сізбен келісемін.
Dialogue: 0,0:04:53.50,0:04:56.42,Default,,0,0,0,,Артынан қарасаңыз да, монитордан көруге болады.
Dialogue: 0,0:04:56.50,0:04:57.92,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:58.00,0:05:00.59,Default,,0,0,0,,Сау, ұрықтанбаған жұмыртқа
Dialogue: 0,0:05:00.67,0:05:03.17,Default,,0,0,0,,Осы жұмыртқаның ядросын алып тастаңыз
Dialogue: 0,0:05:03.26,0:05:05.93,Default,,0,0,0,,Бұған донордың ядросы ауыстырылады.
Dialogue: 0,0:05:06.01,0:05:08.68,Default,,0,0,0,,Донор бұл...
Dialogue: 0,0:05:08.76,0:05:11.97,Default,,0,0,0,,Дұрыс, бұл Миямото Мусаши.
Dialogue: 0,0:05:12.06,0:05:15.39,Default,,0,0,0,,Бұл тәжірибе сәтті болса...
Dialogue: 0,0:05:15.48,0:05:17.35,Default,,0,0,0,,«егер» емес
Dialogue: 0,0:05:17.85,0:05:20.94,Default,,0,0,0,,Оның ядролық тасымалдау технологиясы әлемдегі ең жақсы технология болып табылады.
Dialogue: 0,0:05:21.61,0:05:26.70,Default,,0,0,0,,28 күннен кейін сіз Миямото Мусашидің туылмаған баласына ғибадат ете аласыз.
Dialogue: 0,0:05:26.78,0:05:31.95,Default,,0,0,0,,То... 28 күн соншалықты аз уақыт па?
Dialogue: 0,0:05:32.04,0:05:34.70,Default,,0,0,0,,Технология дүние жүзіндегі шыңдарды қосады
Dialogue: 0,0:05:34.79,0:05:38.50,Default,,0,0,0,,Жабдық деңгейіне келетін болсақ, онымен салыстыруға болатын ештеңе жоқ.
Dialogue: 0,0:05:38.58,0:05:40.96,Default,,0,0,0,,Біздің командада қателіктерге орын жоқ.
Dialogue: 0,0:05:41.04,0:05:44.26,Default,,0,0,0,,Құрылыстың жалпы құны жер үсті объектілерінен 8 еседен астам
Dialogue: 0,0:05:44.34,0:05:48.22,Default,,0,0,0,,Бұл әлемдегі ең үлкен клондау зертханасы.
Dialogue: 0,0:05:48.89,0:05:50.51,Default,,0,0,0,,О, басталып жатыр.
Dialogue: 0,0:05:50.60,0:05:52.68,Default,,0,0,0,,Не шықты?
Dialogue: 0,0:05:52.76,0:05:54.02,Default,,0,0,0,,Шыны түтік
Dialogue: 0,0:05:54.10,0:05:57.14,Default,,0,0,0,,Бұл диаметрі 100 микрометр болатын ерекше нысан.
Dialogue: 0,0:05:57.23,0:06:00.23,Default,,0,0,0,,Бұл жұмыртқаның ядросын сору процесі.
Dialogue: 0,0:06:00.31,0:06:01.86,Default,,0,0,0,,Ой, ерте!
Dialogue: 0,0:06:01.94,0:06:05.49,Default,,0,0,0,,Доктор Хонер күткендей, сіз оны жұтып қойдыңыз.
Dialogue: 0,0:06:05.57,0:06:08.61,Default,,0,0,0,,Дұрыс, энуклеация аяқталды.
Dialogue: 0,0:06:08.70,0:06:10.37,Default,,0,0,0,,О, не?
Dialogue: 0,0:06:10.45,0:06:12.91,Default,,0,0,0,,Бұл ине тамшуыр деп аталатын құрылғы.
Dialogue: 0,0:06:12.99,0:06:15.50,Default,,0,0,0,,Қалыңдығы адам шашының 1/100 бөлігін құрайды.
Dialogue: 0,0:06:15.58,0:06:17.58,Default,,0,0,0,,Жаңа ядроны енгізіңіз
Dialogue: 0,0:06:17.66,0:06:18.71,Default,,0,0,0,,Кірістіру!
Dialogue: 0,0:06:23.29,0:06:24.46,Default,,0,0,0,,(Баспа дыбысы)
Dialogue: 0,0:06:24.55,0:06:25.46,Default,,0,0,0,,О!
Dialogue: 0,0:06:25.55,0:06:28.05,Default,,0,0,0,,Бұл клондалған эмбрион. Бұл ядро!
Dialogue: 0,0:06:28.13,0:06:30.34,Default,,0,0,0,,Миямото Мусаши жасушаларынан жиналған
Dialogue: 0,0:06:30.43,0:06:32.89,Default,,0,0,0,,Бұл Миямото Мусашидің өзегі!
Dialogue: 0,0:06:32.97,0:06:34.18,Default,,0,0,0,,О!
Dialogue: 0,0:06:34.26,0:06:36.10,Default,,0,0,0,,Ұрықтану аяқталды
Dialogue: 0,0:06:38.18,0:06:39.85,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:06:39.94,0:06:43.61,Default,,0,0,0,,Жоқ, бұл емес.
Dialogue: 0,0:06:43.69,0:06:46.36,Default,,0,0,0,,Бұл қарапайым жүрек соғысы емес.
Dialogue: 0,0:06:46.44,0:06:49.36,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:52.95,0:06:54.37,Default,,0,0,0,,Не!
Dialogue: 0,0:06:54.45,0:06:56.12,Default,,0,0,0,,Жасыру!
Dialogue: 0,0:06:56.20,0:06:57.20,Default,,0,0,0,,Ойын бар!
Dialogue: 0,0:06:57.29,0:06:59.96,Default,,0,0,0,,Енді… қазір, әрине…
Dialogue: 0,0:07:00.04,0:07:01.46,Default,,0,0,0,,Есту Сен оны тістеп алдың!
Dialogue: 0,0:07:01.46,0:07:02.88,Default,,0,0,0,,Естім мен тістеп алдым!
Dialogue: 0,0:07:01.46,0:07:02.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:02.96,0:07:05.63,Default,,0,0,0,,Біраз уақыт болады, Баки.
Dialogue: 0,0:07:05.71,0:07:06.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:06.21,0:07:08.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:06.21,0:07:08.13,Default,,0,0,0,,Тағы он айдан кейін сіздің есінеуіңіз тоқтайды.
Dialogue: 0,0:07:08.13,0:07:11.13,Default,,0,0,0,,Тағы он айдан кейін сіздің есінеуіңіз тоқтайды.
Dialogue: 0,0:07:11.72,0:07:14.30,Default,,0,0,0,,Тірі заттардың дүниеге келуінен адам дүниеге келгенге дейін шамамен 2 млрд.
Dialogue: 0,0:07:14.30,0:07:16.51,Default,,0,0,0,,Тірі заттардың дүниеге келуінен адам дүниеге келгенге дейін шамамен 2 млрд.
Dialogue: 0,0:07:14.30,0:07:16.51,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:07:16.60,0:07:19.39,Default,,0,0,0,,Жылдамдық сезімін сақтай отырып
Dialogue: 0,0:07:20.35,0:07:23.48,Default,,0,0,0,,Мусаши 11 ай 10 күн
Dialogue: 0,0:07:24.90,0:07:30.15,Default,,0,0,0,,Спринтингтен жоғары энергия тұтыну
Dialogue: 0,0:07:30.74,0:07:32.61,Default,,0,0,0,,Бұл айқаспалы тартылу болса да...
Dialogue: 0,0:07:32.70,0:07:35.16,Default,,0,0,0,,
Dialogue: 0,0:07:40.66,0:07:42.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:43.21,0:07:45.79,Default,,0,0,0,,Кеше орындық пресстің макс
Dialogue: 0,0:07:46.38,0:07:48.80,Default,,0,0,0,,Бұған дейін 100 метрге жүгіру
Dialogue: 0,0:07:49.46,0:07:52.80,Default,,0,0,0,,Биікке жетудің алдында, Мақсатқа жетудің алдында
Dialogue: 0,0:07:52.88,0:07:55.14,Default,,0,0,0,,Терең есінеу
Dialogue: 0,0:07:58.06,0:08:00.39,Default,,0,0,0,,Медициналық мүмкін емес
Dialogue: 0,0:08:00.89,0:08:02.69,Default,,0,0,0,,Неге жалықтысың?
Dialogue: 0,0:08:03.52,0:08:05.86,Default,,0,0,0,,Сіз неден жалықтыңыз?
Dialogue: 0,0:08:13.95,0:08:18.99,Default,,0,0,0,,Бұл жақсы нәрсе ме, әлде жаман нәрсе ме?
Dialogue: 0,0:08:19.08,0:08:21.45,Default,,0,0,0,,Төтенше суық сарқырамамен шомылу
Dialogue: 0,0:08:27.54,0:08:31.46,Default,,0,0,0,,Ағымдағы биіктікке қосымша қосу
Dialogue: 0,0:08:32.22,0:08:35.22,Default,,0,0,0,,жоғары және алыс
Dialogue: 0,0:08:35.80,0:08:38.60,Default,,0,0,0,,Менің денемнің үстіңгі бөлігінің ұзындығынан есептелген
Dialogue: 0,0:08:38.68,0:08:41.72,Default,,0,0,0,,Атлетикалық қабілетті бұзбай шекті мән
Dialogue: 0,0:08:42.31,0:08:44.48,Default,,0,0,0,,Сүйектің ұзаруы 30 см
Dialogue: 0,0:08:44.56,0:08:48.48,Default,,0,0,0,,Бойдың нысаналы мәні 2 метр 43 см!
Dialogue: 0,0:08:49.27,0:08:50.78,Default,,0,0,0,,Төменге қараңыз
Dialogue: 0,0:08:50.86,0:08:53.74,Default,,0,0,0,,Барлық жауларды елемейді
Dialogue: 0,0:08:53.82,0:08:55.49,Default,,0,0,0,,Гухехехе
Dialogue: 0,0:08:55.57,0:08:58.32,Default,,0,0,0,,Екінші сүйек ұзарту операциясы
Dialogue: 0,0:08:58.41,0:09:01.24,Default,,0,0,0,,Мен нәзіктікке байланысты ауырсынуды көтере аламын.
Dialogue: 0,0:09:01.33,0:09:02.91,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:09:03.00,0:09:05.25,Default,,0,0,0,,Осы қатты ауырсынуда
Dialogue: 0,0:09:05.33,0:09:10.42,Default,,0,0,0,,Маған қайта-қайта келе беретін осы есінеу үшін ғана...
Dialogue: 0,0:09:10.96,0:09:13.26,Default,,0,0,0,,(Құрылғы жұмысының шуы)
Dialogue: 0,0:09:13.34,0:09:15.38,Default,,0,0,0,,Тууға дайындық аяқталды
Dialogue: 0,0:09:15.47,0:09:17.34,Default,,0,0,0,,Импульс Аномалия жоқ
Dialogue: 0,0:09:17.43,0:09:19.43,Default,,0,0,0,,Амниотикалық сұйықтық температурасының қалыпты мәні
Dialogue: 0,0:09:19.51,0:09:22.06,Default,,0,0,0,,Дене қызуы 36 градус, ауытқулар жоқ
Dialogue: 0,0:09:22.14,0:09:25.77,Default,,0,0,0,,Ұрықтану 11 ай 10 күн 9 сағат 41 минут
Dialogue: 0,0:09:25.85,0:09:28.48,Default,,0,0,0,,Қолданылатын жас: 32 жас 6 ай
Dialogue: 0,0:09:28.56,0:09:30.36,Default,,0,0,0,,Барлық мәндер Аномалия жоқ
Dialogue: 0,0:09:34.61,0:09:35.65,Default,,0,0,0,,Туу!
Dialogue: 0,0:09:49.25,0:09:50.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.76,0:09:55.67,Default,,0,0,0,,О...
Dialogue: 0,0:10:01.76,0:10:05.18,Default,,0,0,0,,Бұл үлкен нәрсе дегенмен үлкен.
Dialogue: 0,0:10:05.27,0:10:07.44,Default,,0,0,0,,Бұл таңқаларлық қалыпты болып көрінеді.
Dialogue: 0,0:10:07.52,0:10:08.52,Default,,0,0,0,,(тырнақтарды кесу дыбысы)
Dialogue: 0,0:10:08.60,0:10:09.94,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:10:12.86,0:10:15.69,Default,,0,0,0,,Бұл Миямото Мусаши
Dialogue: 0,0:10:16.32,0:10:18.74,Default,,0,0,0,,Шайқаста шыңдалған Теңдесі жоқ
Dialogue: 0,0:10:18.82,0:10:21.45,Default,,0,0,0,,Нағыз Миямото Мусаши
Dialogue: 0,0:10:21.53,0:10:26.12,Default,,0,0,0,,Әскердің жоғары күшін бір қарағанда-ақ түсінуге болатыны рас.
Dialogue: 0,0:10:26.87,0:10:29.62,Default,,0,0,0,,Шынайы... бұл анық
Dialogue: 0,0:10:29.71,0:10:34.63,Default,,0,0,0,,«Ең күшті» сөзі осы кісіден шыққан.
Dialogue: 0,0:10:37.72,0:10:40.38,Default,,0,0,0,,
Dialogue: 0,0:10:40.47,0:10:43.89,Default,,0,0,0,,(Дүкенде жұмсақ музыка ойналады)
Dialogue: 0,0:10:43.97,0:10:45.39,Default,,0,0,0,,(Чихару Шибаның күрсінуі)
Dialogue: 0,0:10:45.47,0:10:49.14,Default,,0,0,0,,Жалпы Сіз неше рет ойлайсыз?
Dialogue: 0,0:10:49.73,0:10:53.40,Default,,0,0,0,,Осында отырғаннан бері осыншама есінегенім.
Dialogue: 0,0:10:53.48,0:10:57.61,Default,,0,0,0,,Мен түсінбейтін көп. Мен де.
Dialogue: 0,0:10:59.82,0:11:03.16,Default,,0,0,0,,Сені жалықтыратын мен болсам, неге жоғалып кетпейсің!
Dialogue: 0,0:11:03.24,0:11:04.66,Default,,0,0,0,,О... ой...
Dialogue: 0,0:11:06.20,0:11:08.41,Default,,0,0,0,,Бұл кешегі күн туралы болды.
Dialogue: 0,0:11:08.50,0:11:09.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:09.58,0:11:11.42,Default,,0,0,0,,Мені Чака нысанаға алды.
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Не!
Dialogue: 0,0:11:14.00,0:11:16.46,Default,,0,0,0,,Ханаяма, дайындал!
Dialogue: 0,0:11:16.55,0:11:19.67,Default,,0,0,0,,(Ер адамның түсініксіз айқайы)
Dialogue: 0,0:11:16.55,0:11:19.67,Default,,0,0,0,,Тез сөйлегенім сонша, айқайлап жібердім.
Dialogue: 0,0:11:21.76,0:11:22.76,Default,,0,0,0,,Қарғыс атсын... Ой!
Dialogue: 0,0:11:23.26,0:11:24.68,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:11:25.39,0:11:26.43,Default,,0,0,0,,Алмаңыз
Dialogue: 0,0:11:26.51,0:11:27.93,Default,,0,0,0,,(адамның үрейлі дауысы)
Dialogue: 0,0:11:28.02,0:11:30.69,Default,,0,0,0,,Егер сіз оны алып тастасаңыз...
Dialogue: 0,0:11:30.77,0:11:33.60,Default,,0,0,0,,Мен оның қасына бара жатып, онымен сөйлестім.
Dialogue: 0,0:11:33.69,0:11:34.69,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:11:35.36,0:11:38.44,Default,,0,0,0,,Мен мұны жаман деп ойладым.
Dialogue: 0,0:11:38.53,0:11:40.99,Default,,0,0,0,,Тоқтату мүмкін емес
Dialogue: 0,0:11:42.32,0:11:43.70,Default,,0,0,0,,(Ханаяманың күшті дауысы)
Dialogue: 0,0:11:43.78,0:11:46.70,Default,,0,0,0,,(адамның үрейлі дауысы)
Dialogue: 0,0:11:46.78,0:11:48.37,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:50.41,0:11:52.62,Default,,0,0,0,,(әйнек түсіру дыбысы)
Dialogue: 0,0:11:52.71,0:11:55.33,Default,,0,0,0,,Жалқаулық сіздің кінәңіз емес
Dialogue: 0,0:11:55.92,0:11:58.09,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:12:03.68,0:12:04.68,Default,,0,0,0,,Ішуге болмайды
Dialogue: 0,0:12:05.18,0:12:06.64,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:12:07.14,0:12:08.60,Default,,0,0,0,,Бұл зерігу...
Dialogue: 0,0:12:08.68,0:12:10.64,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:12:10.73,0:12:12.48,Default,,0,0,0,,Сол адамның көзінше...
Dialogue: 0,0:12:12.56,0:12:14.02,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:12:14.10,0:12:15.35,Default,,0,0,0,,Не болады?
Dialogue: 0,0:12:15.44,0:12:17.11,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:12:21.86,0:12:24.61,Default,,0,0,0,,Сіз таңғажайып нәрселерді айтасыз.
Dialogue: 0,0:12:25.53,0:12:28.12,Default,,0,0,0,,Огрмен күрескіңіз келе ме?
Dialogue: 0,0:12:28.20,0:12:30.62,Default,,0,0,0,,Ностальгиялық
Dialogue: 0,0:12:30.70,0:12:33.46,Default,,0,0,0,,Хмм... Есіңде ме?
Dialogue: 0,0:12:33.54,0:12:36.38,Default,,0,0,0,,Мен Юдзиро Ханмамен төбелескім келеді...
Dialogue: 0,0:12:36.96,0:12:41.38,Default,,0,0,0,,Мұндай батыл сөздерді естімегеніме көп болды.
Dialogue: 0,0:12:45.09,0:12:48.14,Default,,0,0,0,,Сіздің шешіміңіз жақсы болды.
Dialogue: 0,0:12:48.22,0:12:50.77,Default,,0,0,0,,Юдзиро Ханмаға қарсы тұру
Dialogue: 0,0:12:50.85,0:12:53.89,Default,,0,0,0,,Оны енді сәйкестік деп атауға болмайды.
Dialogue: 0,0:12:58.48,0:13:02.28,Default,,0,0,0,,Мұндай құбыжықпен ешкім бәсекелесе алмайды.
Dialogue: 0,0:13:02.36,0:13:04.53,Default,,0,0,0,,Онда неге шақыру керек?
Dialogue: 0,0:13:04.61,0:13:06.91,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,0:13:07.49,0:13:10.16,Default,,0,0,0,,Ха! Ой... ой...
Dialogue: 0,0:13:10.24,0:13:12.75,Default,,0,0,0,,5 жыл бұрын
Dialogue: 0,0:13:12.83,0:13:16.12,Default,,0,0,0,,Мен күтпеген жерден Токиодағы ойын орталығында тұрдым.
Dialogue: 0,0:13:16.21,0:13:19.29,Default,,0,0,0,,Юдзиро Ханма VS (Қарсы) Каору Ханаяма
Dialogue: 0,0:13:19.38,0:13:22.80,Default,,0,0,0,,Мен естіген әңгіме сұмдық оқиға.
Dialogue: 0,0:13:22.88,0:13:27.43,Default,,0,0,0,,Сіздің өміріңіздің соңына дейін күйзеліске ұшырататын өте маңызды шешім.
Dialogue: 0,0:13:27.51,0:13:30.35,Default,,0,0,0,,Қайта кездесудің қажеті жоқ.
Dialogue: 0,0:13:30.43,0:13:32.31,Default,,0,0,0,,Сенгісіз аяқталу
Dialogue: 0,0:13:33.39,0:13:35.98,Default,,0,0,0,,Қандай сұмдық
Dialogue: 0,0:13:36.06,0:13:39.98,Default,,0,0,0,,Сол түні мен бастан өткерген салқынқанды азап пен қорлық.
Dialogue: 0,0:13:40.06,0:13:42.69,Default,,0,0,0,,Одан да ауыр азап бар.
Dialogue: 0,0:13:42.78,0:13:44.36,Default,,0,0,0,,Бұл тағы да «ол қазір басталды» сценарийі ме, кіру емтихандарындағыдай?
Dialogue: 0,0:13:44.44,0:13:48.70,Default,,0,0,0,,Ешқандай ауыртпалық болуы мүмкін емес, тек зерігудің азабы.
Dialogue: 0,0:13:48.78,0:13:52.45,Default,,0,0,0,,Түсіндім, дәу сені емдей алады.
Dialogue: 0,0:13:52.54,0:13:55.12,Default,,0,0,0,,Рахмет, Ханаяма-кун.
Dialogue: 0,0:13:55.62,0:13:59.21,Default,,0,0,0,,Негізі, мен де Огрды Токиоға шақырғым келді.
Dialogue: 0,0:13:59.83,0:14:04.17,Default,,0,0,0,,Егер оның аты Каору Ханаяма болса, ол кісі де қозғалатын еді.
Dialogue: 0,0:14:04.67,0:14:08.59,Default,,0,0,0,,Немесе 'Akiba's●lip'
Dialogue: 0,0:14:09.51,0:14:13.10,Default,,0,0,0,,Қалыпты мәндердегі барлық элементтер Ақаулар табылмады
Dialogue: 0,0:14:13.18,0:14:16.31,Default,,0,0,0,,Дегенмен, әсер сіз білетіндей.
Dialogue: 0,0:14:16.39,0:14:19.06,Default,,0,0,0,,Туылғаннан кейінгі 81 сағаттағы жағдай бойынша
Dialogue: 0,0:14:19.14,0:14:21.61,Default,,0,0,0,,Сыналушы әлі оянған жоқ.
Dialogue: 0,0:14:23.69,0:14:26.90,Default,,0,0,0,,Импульс Дене температурасы Қан қысымы
Dialogue: 0,0:14:26.99,0:14:30.03,Default,,0,0,0,,Әрбір элемент тәулігіне 24 сағат бақыланады
Dialogue: 0,0:14:30.11,0:14:33.37,Default,,0,0,0,,Барлық элементтер жақсы, бірақ біреуі ғана
Dialogue: 0,0:14:33.45,0:14:36.87,Default,,0,0,0,,Ми толқындары жауап бермейді
Dialogue: 0,0:14:37.79,0:14:39.71,Default,,0,0,0,,Деректер мінсіз
Dialogue: 0,0:14:39.79,0:14:42.88,Default,,0,0,0,,Бұл факт қазір ештеңені білдірмейді.
Dialogue: 0,0:14:42.96,0:14:44.50,Default,,0,0,0,,Адам ұйықтап қалады
Dialogue: 0,0:14:44.59,0:14:47.80,Default,,0,0,0,,Деректер бұл шындықтың алдында дәрменсіз
Dialogue: 0,0:14:48.30,0:14:49.13,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:14:49.22,0:14:53.30,Default,,0,0,0,,Мына дәрменсіз палеонтологты құтқарыңызшы.
Dialogue: 0,0:14:53.80,0:14:55.14,Default,,0,0,0,,Бұл солай
Dialogue: 0,0:14:57.06,0:14:57.93,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:14:58.02,0:15:00.64,Default,,0,0,0,,Бұл жай ғана гипотеза...
Dialogue: 0,0:15:01.40,0:15:05.15,Default,,0,0,0,,Шулы және қызу пікірталас
Dialogue: 0,0:15:05.23,0:15:09.40,Default,,0,0,0,,Сол кезде менің пікірім таусылғандай болды...
Dialogue: 0,0:15:09.49,0:15:10.91,Default,,0,0,0,,(Қатты түрту дыбысы)
Dialogue: 0,0:15:11.57,0:15:14.41,Default,,0,0,0,,«Будда жасау оған жан салуды қажет етпейді»!
Dialogue: 0,0:15:14.49,0:15:19.46,Default,,0,0,0,,Дайын болды, бірақ маңызды нәрселер жоқ
Dialogue: 0,0:15:19.54,0:15:22.37,Default,,0,0,0,,Барлық мамандардың алдында өзімді кішіпейіл сезінемін.
Dialogue: 0,0:15:22.46,0:15:26.67,Default,,0,0,0,,Міне, бір нәрсе: мен әуесқойлардың пікірін тыңдағым келеді.
Dialogue: 0,0:15:27.38,0:15:30.59,Default,,0,0,0,,Соңғы деректер Өткен деректер
Dialogue: 0,0:15:30.67,0:15:32.43,Default,,0,0,0,,Жинақталған деректер
Dialogue: 0,0:15:33.05,0:15:35.93,Default,,0,0,0,,Деректер деректерінің деректері
Dialogue: 0,0:15:36.01,0:15:40.43,Default,,0,0,0,,Сан мен ғылым жете алмайтын салалар бар.
Dialogue: 0,0:15:40.52,0:15:41.48,Default,,0,0,0,,(Көшедегі дүрбелең)
Dialogue: 0,0:15:41.48,0:15:43.94,Default,,0,0,0,,(Көшедегі дүрбелең)
Dialogue: 0,0:15:41.48,0:15:43.94,Default,,0,0,0,,Мен өз әрекетім үшін кешірім сұраймын.
Dialogue: 0,0:15:44.02,0:15:47.44,Default,,0,0,0,,Менің бір әпкем бар.
Dialogue: 0,0:15:47.52,0:15:51.20,Default,,0,0,0,,Мамандығы Рух ортасы Күдікті
Dialogue: 0,0:15:51.90,0:15:55.20,Default,,0,0,0,,Сіз өте ұялшақ апасыз.
Dialogue: 0,0:15:55.28,0:15:58.95,Default,,0,0,0,,Демек, менің әпкем экстрасенс.
Dialogue: 0,0:15:59.04,0:16:01.29,Default,,0,0,0,,Райнов? не?
Dialogue: 0,0:16:01.37,0:16:02.67,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:02.75,0:16:03.83,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:03.92,0:16:05.92,Default,,0,0,0,,Ғибадатхана немесе басқа нәрсе ме?
Dialogue: 0,0:16:06.00,0:16:07.59,Default,,0,0,0,,Бұл Итако ма?
Dialogue: 0,0:16:07.67,0:16:12.09,Default,,0,0,0,,Токугава иесі әпкесіне не істеді?
Dialogue: 0,0:16:12.68,0:16:16.10,Default,,0,0,0,,Өзіңді экстрасенс десең, әрине, күдікті.
Dialogue: 0,0:16:16.18,0:16:19.60,Default,,0,0,0,,Ән айтып жатқанда, бірақ
Dialogue: 0,0:16:19.68,0:16:22.60,Default,,0,0,0,,Сіздің қиялыңыз өте тәтті!
Dialogue: 0,0:16:23.27,0:16:26.48,Default,,0,0,0,,Менің әпкем 100 есе күдіктенеді.
Dialogue: 0,0:16:26.56,0:16:27.73,Default,,0,0,0,,Оян!
Dialogue: 0,0:16:27.82,0:16:30.73,Default,,0,0,0,,Дұрыс, қарапайым адам сияқты.
Dialogue: 0,0:16:31.32,0:16:33.99,Default,,0,0,0,,Бұл Нобунагаға шақыру нені білдіреді?
Dialogue: 0,0:16:34.07,0:16:34.95,Default,,0,0,0,,Не?
Dialogue: 0,0:16:35.03,0:16:35.86,Default,,0,0,0,,Who?
Dialogue: 0,0:16:35.95,0:16:37.99,Default,,0,0,0,,Тіпті Ода Нобунага
Dialogue: 0,0:16:38.08,0:16:40.33,Default,,0,0,0,,- (Канко) Сізді қысқарту керек пе? -(Ер D) Уау!
Dialogue: 0,0:16:42.25,0:16:43.25,Default,,0,0,0,,Иә Келесі
Dialogue: 0,0:16:43.83,0:16:47.54,Default,,0,0,0,,Мм... Кез келген адам тастай алады деп естідім.
Dialogue: 0,0:16:47.63,0:16:48.84,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:16:49.34,0:16:51.05,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:16:51.13,0:16:54.13,Default,,0,0,0,,Мен сізді Джон Кеннеди деп атай аламын ба?
Dialogue: 0,0:16:54.22,0:16:55.13,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:55.22,0:16:56.34,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:16:56.43,0:16:57.47,Default,,0,0,0,,Сізге қоңырау шалғанымды қалайсыз ба?
Dialogue: 0,0:16:57.55,0:16:59.14,Default,,0,0,0,,Иә? А... иә
Dialogue: 0,0:16:59.22,0:17:00.18,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:17:00.26,0:17:02.14,Default,,0,0,0,,Кашикоми Кашикоми
Dialogue: 0,0:17:02.22,0:17:07.65,Default,,0,0,0,,Маған Дж.Ф.Кеннедидің рухын әкеліңізші.
Dialogue: 0,0:17:07.73,0:17:11.57,Default,,0,0,0,,Кашикоми Кашикоми Мен Кашикоми деймін
Dialogue: 0,0:17:12.19,0:17:13.15,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:13.24,0:17:14.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:14.24,0:17:16.66,Default,,0,0,0,,Ах... сәлем
Dialogue: 0,0:17:16.74,0:17:18.62,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:17:18.70,0:17:21.41,Default,,0,0,0,,Жапон жастары шақырады
Dialogue: 0,0:17:21.49,0:17:23.91,Default,,0,0,0,,Бұл жапондық~ Хахаха
Dialogue: 0,0:17:24.00,0:17:28.38,Default,,0,0,0,,Жапонияда топ-менеджерлердің бас айналдыратын айналымы бар сияқты.
Dialogue: 0,0:17:28.46,0:17:32.42,Default,,0,0,0,,Адамдар саясатқа бей-жай қараса, саясаткерлер ашуланады
Dialogue: 0,0:17:32.50,0:17:35.97,Default,,0,0,0,,Саясатқа немқұрайлылық – әлеуметтік зұлымдық.
Dialogue: 0,0:17:36.05,0:17:37.43,Default,,0,0,0,,А... иә
Dialogue: 0,0:17:38.18,0:17:40.80,Default,,0,0,0,,Сіз жоғарыда тұрғаныңыз дұрыс.
Dialogue: 0,0:17:40.89,0:17:42.31,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:43.89,0:17:44.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.93,0:17:46.56,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:17:47.14,0:17:48.56,Default,,0,0,0,,Иә Келесі
Dialogue: 0,0:17:51.90,0:17:53.82,Default,,0,0,0,,Еліктеу жақсы.
Dialogue: 0,0:17:54.40,0:17:56.32,Default,,0,0,0,,Оны қайдан үйрендің?
Dialogue: 0,0:17:56.40,0:18:00.03,Default,,0,0,0,,Бұл еліктеу емес, бұл елес
Dialogue: 0,0:18:00.12,0:18:01.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:01.28,0:18:02.95,Default,,0,0,0,,Олай болса, мама
Dialogue: 0,0:18:03.04,0:18:06.00,Default,,0,0,0,,Мен есейгенде әкем дүниеден өтті.
Dialogue: 0,0:18:06.08,0:18:07.08,Default,,0,0,0,,Сіз мені тастап кете аласыз ба?
Dialogue: 0,0:18:07.16,0:18:08.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:08.29,0:18:09.29,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:18:09.79,0:18:13.80,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:13.88,0:18:15.92,Default,,0,0,0,,Харассо Гьятей
Dialogue: 0,0:18:16.01,0:18:20.18,Default,,0,0,0,,Кашикоми Кашикоми Мен Кашикоми деймін
Dialogue: 0,0:18:21.55,0:18:22.72,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:18:22.81,0:18:24.72,Default,,0,0,0,,- (Канко) Болды - (Такаши) А?
Dialogue: 0,0:18:24.81,0:18:26.64,Default,,0,0,0,,Ол шынымен өлді ме?
Dialogue: 0,0:18:26.73,0:18:28.23,Default,,0,0,0,,Не? Не... неге?
Dialogue: 0,0:18:28.31,0:18:30.40,Default,,0,0,0,,Себебі мен оны таба алмаймын
Dialogue: 0,0:18:30.48,0:18:32.73,Default,,0,0,0,,Айтайын дегенім, біріншіден ешқандай белгі жоқ.
Dialogue: 0,0:18:32.82,0:18:36.94,Default,,0,0,0,,Әй... маған демалыс беріңізші. Сен не туралы айтып тұрсың?
Dialogue: 0,0:18:37.03,0:18:39.66,Default,,0,0,0,,Неге өз әкеңді өлтірдің?
Dialogue: 0,0:18:40.57,0:18:42.24,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:18:42.32,0:18:47.29,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:18:50.21,0:18:52.13,Default,,0,0,0,,Колла~ Такаши!
Dialogue: 0,0:18:53.29,0:18:55.17,Default,,0,0,0,,Сол күні не болды
Dialogue: 0,0:18:55.25,0:19:00.63,Default,,0,0,0,,Такаши Ясумото, 21 жастағы университет студенті кейінірек былай деді:
Dialogue: 0,0:19:01.22,0:19:04.35,Default,,0,0,0,,Шынымды айтсам, есімді атағанда таң қалдым.
Dialogue: 0,0:19:04.43,0:19:06.39,Default,,0,0,0,,Бұл жалпы есім.
Dialogue: 0,0:19:06.47,0:19:09.48,Default,,0,0,0,,Анам кез келген әке айтатын сияқты.
Dialogue: 0,0:19:09.56,0:19:11.90,Default,,0,0,0,,Баламды оқымағаны үшін ұрысу
Dialogue: 0,0:19:12.65,0:19:15.65,Default,,0,0,0,,Ол ''Мен мұны істедім'' деген көзқараспен артқа бұрылды.
Dialogue: 0,0:19:16.23,0:19:18.49,Default,,0,0,0,,Мен мұны ақырын айттым.
Dialogue: 0,0:19:19.03,0:19:20.15,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:19:21.11,0:19:23.28,Default,,0,0,0,,Шындығында, ол тірі, солай емес пе?
Dialogue: 0,0:19:24.24,0:19:26.79,Default,,0,0,0,,Менің айналамдағы адамдар депрессияға ұшырады.
Dialogue: 0,0:19:26.87,0:19:30.37,Default,,0,0,0,,Сіз анасыз ба? Бұл өте тыныш болды.
Dialogue: 0,0:19:30.46,0:19:31.54,Default,,0,0,0,,Келесі!
Dialogue: 0,0:19:31.62,0:19:34.29,Default,,0,0,0,,Мәселе осыдан кейін не болатынында.
Dialogue: 0,0:19:34.38,0:19:38.42,Default,,0,0,0,,Түнде мен үйде әкеммен күндіз болған оқиға туралы сөйлестім.
Dialogue: 0,0:19:38.51,0:19:42.13,Default,,0,0,0,,Сонда мен біртүрлі нәрсе естідім.
Dialogue: 0,0:19:42.22,0:19:44.80,Default,,0,0,0,,Бұл уақыт неше болды?
Dialogue: 0,0:19:44.89,0:19:46.89,Default,,0,0,0,,Толығырақ түсіндіру
Dialogue: 0,0:19:47.89,0:19:49.56,Default,,0,0,0,,Мен үндемедім.
Dialogue: 0,0:19:50.14,0:19:51.81,Default,,0,0,0,,Шын мәнінде Такаши
Dialogue: 0,0:19:52.77,0:19:54.44,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:19:54.52,0:19:56.82,Default,,0,0,0,,Әкем жұмыста құлап қалғанын айтты.
Dialogue: 0,0:19:57.48,0:20:02.32,Default,,0,0,0,,2-3 минуттай уақыт кеткен сияқты, бірақ сол уақыт ішінде мен түс көрдім.
Dialogue: 0,0:20:03.16,0:20:05.12,Default,,0,0,0,,Күн сайын өзіме көңілім толмайтынын сезінемін.
Dialogue: 0,0:20:05.20,0:20:08.33,Default,,0,0,0,,Мен оған немқұрайлы өмір салты үшін айғайладым.
Dialogue: 0,0:20:08.41,0:20:12.29,Default,,0,0,0,,Уағыздың әрбір сөзі Айналадағы көрініс Жағдай
Dialogue: 0,0:20:12.37,0:20:14.33,Default,,0,0,0,,Бұл тамаша сәйкестік болды.
Dialogue: 0,0:20:15.04,0:20:17.59,Default,,0,0,0,,Иә, оның мағынасы осы.
Dialogue: 0,0:20:18.17,0:20:20.59,Default,,0,0,0,,Анам шын.
Dialogue: 0,0:20:20.67,0:20:23.84,Default,,0,0,0,,Тірі ме, өлі ме бәрібір.
Dialogue: 0,0:20:23.93,0:20:27.89,Default,,0,0,0,,Канко Токугава түсіре алмайтын рух жоқ!
Dialogue: 0,0:20:29.18,0:20:31.73,Default,,0,0,0,,(Ауыр аяқ дыбыстары)
Dialogue: 0,0:20:33.81,0:20:36.36,Default,,0,0,0,,
Dialogue: 0,0:20:41.99,0:20:44.36,Default,,0,0,0,,Бұл ұрыс.
Dialogue: 0,0:20:44.95,0:20:48.12,Default,,0,0,0,,Бұл матчтан гөрі тірі жекпе-жек.
Dialogue: 0,0:20:48.83,0:20:50.54,Default,,0,0,0,,Ноу Ханаяма
Dialogue: 0,0:20:50.62,0:20:53.50,Default,,0,0,0,,Көпшілік алдында мұны істеуге болмайды.
Dialogue: 0,0:20:53.58,0:20:54.75,Default,,0,0,0,,
Dialogue: 0,0:21:10.85,0:21:13.77,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:21:16.23,0:21:19.27,Default,,0,0,0,,Сізге келуге мәжбүр болғаным үшін кешіріңіз.
Dialogue: 0,0:21:22.36,0:21:24.40,Default,,0,0,0,,Хмм, Нуха!
Dialogue: 0,0:21:24.49,0:21:27.41,Default,,0,0,0,,Ku~!
Dialogue: 0,0:21:28.20,0:21:30.53,Default,,0,0,0,,Мен көмектесе алмаймын!
Dialogue: 0,0:21:31.70,0:21:34.54,Default,,0,0,0,,А және В мен бірге орындағым келеді
Dialogue: 0,0:21:35.62,0:21:38.04,Default,,0,0,0,,Көңіліңізден шыққанша орындаңыз!
Dialogue: 0,0:21:38.13,0:21:41.96,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:21:42.05,0:21:43.55,Default,,0,0,0,,(Құрылғы жұмысының шуы)
Dialogue: 0,0:21:43.63,0:21:44.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:47.22,0:21:49.22,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:21:49.89,0:21:51.47,Default,,0,0,0,,жеткіліксіз
Dialogue: 0,0:21:51.56,0:21:55.98,Default,,0,0,0,,Дегенмен, менде шарттар дерлік орындалғандай әсер қалды.
Dialogue: 0,0:21:56.06,0:21:58.23,Default,,0,0,0,,(Қызметкерлердің тыныс алу дыбысы)
Dialogue: 0,0:21:59.15,0:22:02.19,Default,,0,0,0,,Жақсырақ инсулин және аминқышқылдары
Dialogue: 0,0:22:02.27,0:22:08.99,Default,,0,0,0,,PZ дәруменінің мөлшерін әрқайсысына 20% реттесем, тамаша болды.
Dialogue: 0,0:22:09.82,0:22:12.49,Default,,0,0,0,,«Будда жасау оған жан салуды білдірмейді»
Dialogue: 0,0:22:13.08,0:22:16.16,Default,,0,0,0,,Білімсіз Мицунаридің сөздері
Dialogue: 0,0:22:17.33,0:22:20.54,Default,,0,0,0,,Осының көмегімен сіз 5 минуттан кейін ояна аласыз
Dialogue: 0,0:22:21.84,0:22:26.84,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.17,0:23:50.17,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory