Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.76,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.55,0:01:39.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:43.10,0:01:45.02,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:45.10,0:01:48.52,Default,,0,0,0,,Жарайсың... бірақ
Dialogue: 0,0:01:49.19,0:01:51.02,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:01:51.82,0:01:55.03,Default,,0,0,0,,Бұл қандай ойын түрі?
Dialogue: 0,0:01:55.61,0:01:58.03,Default,,0,0,0,,Бұл бірінші кезекте жарыс болды ма?
Dialogue: 0,0:01:58.66,0:01:59.91,Default,,0,0,0,,Уцуми мырза
Dialogue: 0,0:02:00.41,0:02:03.03,Default,,0,0,0,,Мен уәде беремін. Мен үйге бара аламын ба?
Dialogue: 0,0:02:04.20,0:02:06.96,Default,,0,0,0,,Мм... асығып тұрсың ба?
Dialogue: 0,0:02:07.46,0:02:09.04,Default,,0,0,0,,Ах~
Dialogue: 0,0:02:09.12,0:02:13.04,Default,,0,0,0,,Бос емес пе? Уцуми мырза
Dialogue: 0,0:02:13.13,0:02:15.05,Default,,0,0,0,,Шибукава мырза
Dialogue: 0,0:02:15.13,0:02:16.80,Default,,0,0,0,,Os!
Dialogue: 0,0:02:16.88,0:02:19.30,Default,,0,0,0,,Біз сізді күттік.
Dialogue: 0,0:02:21.30,0:02:22.30,Default,,0,0,0,,Хо
Dialogue: 0,0:02:22.93,0:02:24.81,Default,,0,0,0,,Біраз уақыттан кейін оны бірінші рет көрмеңіз
Dialogue: 0,0:02:25.93,0:02:29.81,Default,,0,0,0,,Ортадағы бір білік мықтап өтеді.
Dialogue: 0,0:02:29.89,0:02:31.60,Default,,0,0,0,,Шибукава мырза
Dialogue: 0,0:02:32.11,0:02:34.82,Default,,0,0,0,,Сізге келетін болсақ...
Dialogue: 0,0:02:35.82,0:02:37.82,Default,,0,0,0,,Миямото Мусаши
Dialogue: 0,0:02:37.90,0:02:38.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:42.66,0:02:43.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:43.91,0:02:46.83,Default,,0,0,0,,Ол қалай шығады? екеуі де алып бастар
Dialogue: 0,0:02:47.91,0:02:49.33,Default,,0,0,0,,♬~
Dialogue: 0,0:02:49.41,0:02:51.79,Default,,0,0,0,,Ах~ Иә иә иә
Dialogue: 0,0:02:51.88,0:02:53.84,Default,,0,0,0,,Мұсаши мырза, иә, иә.
Dialogue: 0,0:02:55.42,0:02:59.09,Default,,0,0,0,,Жоқ~ Хахаха Әлгі Мусаши-сан...
Dialogue: 0,0:03:00.34,0:03:01.84,Default,,0,0,0,,Мм... Гохо.
Dialogue: 0,0:03:02.93,0:03:05.35,Default,,0,0,0,,Мен екеуіңе де сұрақ қойғым келеді.
Dialogue: 0,0:03:05.43,0:03:07.89,Default,,0,0,0,,Оның қатысуы енді жоқ
Dialogue: 0,0:03:07.97,0:03:11.35,Default,,0,0,0,,Жапонияда ғана емес, бүкіл адамзат тарихында
Dialogue: 0,0:03:11.94,0:03:13.98,Default,,0,0,0,,Теңдесі жоқ күрескер ретінде
Dialogue: 0,0:03:14.06,0:03:16.86,Default,,0,0,0,,Миямото Мусаши өз есімін тарихта қалдырды
Dialogue: 0,0:03:17.61,0:03:21.70,Default,,0,0,0,,Екінші жағынан, қазіргі уақытта өмір сүру шеберлерінің шебері
Dialogue: 0,0:03:21.78,0:03:24.37,Default,,0,0,0,,Белсенді белсенді Гоки Шибукава мырза
Dialogue: 0,0:03:24.99,0:03:27.62,Default,,0,0,0,,Қызық, қайсысы күшті?
Dialogue: 0,0:03:27.70,0:03:28.87,Default,,0,0,0,,Уф
Dialogue: 0,0:03:28.95,0:03:30.58,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:03:30.66,0:03:32.87,Default,,0,0,0,,Төтенше Ашу!
Dialogue: 0,0:03:32.96,0:03:36.00,Default,,0,0,0,,Маған не айтасыз ба?
Dialogue: 0,0:03:36.09,0:03:38.30,Default,,0,0,0,,Мықты бол, Уцуми-сан!
Dialogue: 0,0:03:38.38,0:03:39.38,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:39.46,0:03:42.34,Default,,0,0,0,,Миямото Мусаши сөздері
Dialogue: 0,0:03:42.43,0:03:44.39,Default,,0,0,0,,Бұл нені білдіреді
Dialogue: 0,0:03:44.47,0:03:48.51,Default,,0,0,0,,Бұл жекпе-жек өнерімен өмір сүретіндер үшін дұрыс емес.
Dialogue: 0,0:03:48.60,0:03:51.39,Default,,0,0,0,,Құдайдың патшалығы ғана емес, Құдайдың өзі!
Dialogue: 0,0:03:51.48,0:03:54.73,Default,,0,0,0,,Қайсысы күшті? мүмкін емес!
Dialogue: 0,0:03:55.23,0:03:59.65,Default,,0,0,0,,Сізбен осылай кездескенім үлкен мәртебе.
Dialogue: 0,0:03:59.73,0:04:02.90,Default,,0,0,0,,Қолымды қысып жібере аласыз ба?
Dialogue: 0,0:04:02.99,0:04:04.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.11,0:04:05.41,Default,,0,0,0,,Ақшу?
Dialogue: 0,0:04:05.49,0:04:08.41,Default,,0,0,0,,Батыс стиліндегі сәлемдесу...
Dialogue: 0,0:04:08.49,0:04:09.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:15.67,0:04:17.71,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:04:17.79,0:04:19.80,Default,,0,0,0,,- (Мусаши) Менің қолдарым... - (Уцуми) А?
Dialogue: 0,0:04:20.46,0:04:22.17,Default,,0,0,0,,Мен сені жібере алмаймын
Dialogue: 0,0:04:22.26,0:04:23.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.38,0:04:24.38,Default,,0,0,0,,Иә
Dialogue: 0,0:04:24.88,0:04:26.80,Default,,0,0,0,,Бұл техника.
Dialogue: 0,0:04:26.89,0:04:28.76,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:04:28.85,0:04:30.81,Default,,0,0,0,,Босатайын десем де, қолым жібермейді
Dialogue: 0,0:04:30.89,0:04:33.98,Default,,0,0,0,,Енді бәрі бітті
Dialogue: 0,0:04:34.06,0:04:35.06,Default,,0,0,0,,Камитама
Dialogue: 0,0:04:35.65,0:04:36.69,Default,,0,0,0,,О!
Dialogue: 0,0:04:42.28,0:04:43.70,Default,,0,0,0,,Ауыр…
Dialogue: 0,0:04:43.78,0:04:45.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:45.28,0:04:46.95,Default,,0,0,0,,- (Уцуми) Әй... - (Полиция қызметкері А) Айки!
Dialogue: 0,0:04:47.03,0:04:47.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.83,0:04:51.95,Default,,0,0,0,,Миямото мырза
Dialogue: 0,0:04:52.04,0:04:54.62,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:54.71,0:04:57.96,Default,,0,0,0,,Мен бұл ойын екенін білемін, бірақ шеше алмаймын.
Dialogue: 0,0:04:59.54,0:05:02.21,Default,,0,0,0,,Реккайо - нигга
Dialogue: 0,0:05:02.30,0:05:03.34,Default,,0,0,0,,Хамф!
Dialogue: 0,0:05:04.80,0:05:05.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:10.81,0:05:13.85,Default,,0,0,0,,Хе! Зама Миягаре
Dialogue: 0,0:05:13.93,0:05:15.48,Default,,0,0,0,,Шибукава мырза!
Dialogue: 0,0:05:15.56,0:05:17.90,Default,,0,0,0,,Қандай бақыт!
Dialogue: 0,0:05:17.98,0:05:20.48,Default,,0,0,0,,Мен тәжірибеде Айкидің жарылғанын көрдім!
Dialogue: 0,0:05:27.57,0:05:28.99,Default,,0,0,0,,- (Уцуми) Ах... - (Шибукава) Хмф.
Dialogue: 0,0:05:29.62,0:05:31.74,Default,,0,0,0,,Кешірім сұрамау
Dialogue: 0,0:05:33.83,0:05:36.79,Default,,0,0,0,,Мені негрдің жауы деп айту жақсы естіледі, бірақ
Dialogue: 0,0:05:36.87,0:05:39.00,Default,,0,0,0,,Мұндай кек шабуылы
Dialogue: 0,0:05:39.08,0:05:42.84,Default,,0,0,0,,Мұны тіпті Рекка патшаның өзі қаламас еді.
Dialogue: 0,0:05:42.92,0:05:44.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:45.09,0:05:48.51,Default,,0,0,0,,Мен мұны жеке сезімнен жасадым.
Dialogue: 0,0:05:49.09,0:05:53.81,Default,,0,0,0,,Миямото Мусаши оны ұнатпағандықтан, рұқсатсыз жасады.
Dialogue: 0,0:05:54.68,0:05:56.52,Default,,0,0,0,,Қысқаша әңгіме
Dialogue: 0,0:05:57.10,0:05:58.52,Default,,0,0,0,,Мұңымнан құтылдым.
Dialogue: 0,0:05:59.65,0:06:03.02,Default,,0,0,0,,Хмм, жақсы.
Dialogue: 0,0:06:03.61,0:06:07.03,Default,,0,0,0,,Бұл керемет техника. Мені ұстаған қолды жібере алмаймын.
Dialogue: 0,0:06:07.74,0:06:13.03,Default,,0,0,0,,Біз бір-бірімізді тең ұстағанымызбен, бізді біржақты басқарды.
Dialogue: 0,0:06:13.83,0:06:16.66,Default,,0,0,0,,Тәттілікті орта ретінде ұстаған қол арқылы
Dialogue: 0,0:06:17.37,0:06:19.58,Default,,0,0,0,,Мен оған көп салмақ салдым
Dialogue: 0,0:06:19.67,0:06:22.79,Default,,0,0,0,,Үлкен тасты сеніп тапсырғандай
Dialogue: 0,0:06:23.38,0:06:24.80,Default,,0,0,0,,Бұл мен білмейтін техника.
Dialogue: 0,0:06:24.88,0:06:25.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.88,0:06:27.72,Default,,0,0,0,,Бұл ең берік бөлігі ғой. Мүмкін емес.
Dialogue: 0,0:06:27.80,0:06:30.30,Default,,0,0,0,,Айки сенгоку дәуірінде болмаған.
Dialogue: 0,0:06:30.39,0:06:31.68,Default,,0,0,0,,Ұрыста
Dialogue: 0,0:06:31.76,0:06:35.72,Default,,0,0,0,,Қылыш немесе найза сияқты қаруды жоғалтқан кезде күресу
Dialogue: 0,0:06:35.81,0:06:38.81,Default,,0,0,0,,Қаруды жалаң қолмен басқару техникасы жасалды.
Dialogue: 0,0:06:39.77,0:06:40.81,Default,,0,0,0,,Бұл ұстаушы.
Dialogue: 0,0:06:41.40,0:06:44.82,Default,,0,0,0,,Сіз үшін бұл алыстағы оқиға.
Dialogue: 0,0:06:44.90,0:06:50.32,Default,,0,0,0,,Бұл ел қылыштан бас тарту ордені деген атпен халықты қылыштан айырды.
Dialogue: 0,0:06:50.95,0:06:55.58,Default,,0,0,0,,Нәтижесінде жалаң қолмен күресу әдістері сақталып қалды.
Dialogue: 0,0:06:55.66,0:06:57.37,Default,,0,0,0,,Джиу-джитсу ретінде
Dialogue: 0,0:06:57.45,0:06:59.12,Default,,0,0,0,,Дзюджитсу?
Dialogue: 0,0:06:59.21,0:07:03.33,Default,,0,0,0,,Ансей 6 Бір данышпан пайда болады
Dialogue: 0,0:07:03.96,0:07:06.09,Default,,0,0,0,,Бұл Сокаку Такеда.
Dialogue: 0,0:07:06.67,0:07:09.09,Default,,0,0,0,,15 жаста Инаваширода
Dialogue: 0,0:07:09.17,0:07:12.84,Default,,0,0,0,,Ол қаскөйлер арасындағы төбелеске түсіп қалады, бірақ оны өлтіру арқылы жеңіледі.
Dialogue: 0,0:07:13.55,0:07:16.35,Default,,0,0,0,,Артында ерлік туралы талай хикая қалдырса да
Dialogue: 0,0:07:16.43,0:07:20.60,Default,,0,0,0,,Бұл данышпан, Сокаку, мұнымен бітпейді.
Dialogue: 0,0:07:21.19,0:07:23.69,Default,,0,0,0,,Бұл ұзақ әңгіме.
Dialogue: 0,0:07:24.23,0:07:27.11,Default,,0,0,0,,Биіктігі шамамен 150 см.
Dialogue: 0,0:07:27.19,0:07:31.61,Default,,0,0,0,,Бойының қысқа болуының кемшілігінен туған революциялық әдіс.
Dialogue: 0,0:07:32.20,0:07:34.62,Default,,0,0,0,,Дұшпандық қарсыластың шабуылы
Dialogue: 0,0:07:35.45,0:07:40.87,Default,,0,0,0,,Мен оған қол тигізген сәтте мен «Айки» деп аталатын құпия әдіс ойлап таптым, ол мені күшсіз қалдырды.
Dialogue: 0,0:07:41.91,0:07:43.37,Default,,0,0,0,,Айки…
Dialogue: 0,0:07:43.46,0:07:47.30,Default,,0,0,0,,Сокаку Такедадан кейін бірнеше таланттар дүниеге келді.
Dialogue: 0,0:07:47.38,0:07:49.17,Default,,0,0,0,,Сокакудан асып түсті
Dialogue: 0,0:07:49.26,0:07:52.76,Default,,0,0,0,,Тағы бір ұлы данышпан пайда болады.
Dialogue: 0,0:07:54.01,0:07:54.89,Default,,0,0,0,,Хун
Dialogue: 0,0:07:54.97,0:07:57.60,Default,,0,0,0,,Мен Гоки Шибукавамын.
Dialogue: 0,0:07:57.68,0:07:59.89,Default,,0,0,0,,Ей, сен өз есіміңді жарияладың!
Dialogue: 0,0:07:59.97,0:08:01.39,Default,,0,0,0,,Бұл басталады!
Dialogue: 0,0:08:03.98,0:08:06.90,Default,,0,0,0,,Шибукава мырза, сіз не көріп тұрсыз?
Dialogue: 0,0:08:08.52,0:08:10.40,Default,,0,0,0,,Бүгін таңертеңнен бері
Dialogue: 0,0:08:11.57,0:08:13.57,Default,,0,0,0,,Гүл бақшасы...
Dialogue: 0,0:08:14.49,0:08:15.91,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:08:18.49,0:08:21.29,Default,,0,0,0,,Өзін-өзі қорғаудың ең жақсы әдісі?
Dialogue: 0,0:08:21.37,0:08:24.42,Default,,0,0,0,,Хехехе, бұл сенсің.
Dialogue: 0,0:08:24.50,0:08:28.67,Default,,0,0,0,,Біздің қытайлық жекпе-жек өнерінен артық өзін-өзі қорғау техникасы жоқ!
Dialogue: 0,0:08:29.46,0:08:31.84,Default,,0,0,0,,Қолымнан келсе, айтқым келеді.
Dialogue: 0,0:08:31.92,0:08:37.18,Default,,0,0,0,,Жасыңыз 150-ден асқан болса, сізді біржақты деп айту қиын.
Dialogue: 0,0:08:38.35,0:08:40.18,Default,,0,0,0,,Кезеңдер бар
Dialogue: 0,0:08:40.77,0:08:45.19,Default,,0,0,0,,Оларды тер төкпей тамаша физикалық әдістермен жеңіңіз
Dialogue: 0,0:08:47.27,0:08:49.48,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:08:49.57,0:08:52.36,Default,,0,0,0,,Мұндай кезең әлі де жүріп жатыр
Dialogue: 0,0:08:52.44,0:08:54.20,Default,,0,0,0,,Толық емес
Dialogue: 0,0:08:56.28,0:09:00.70,Default,,0,0,0,,Дене қорғанысының аяқталғанын көргенде, техниканы пайдалана алмайсыз.
Dialogue: 0,0:09:01.41,0:09:04.79,Default,,0,0,0,,Қолдануға тырыссаңыз да, оның қауіпке жақындауына жол бермеңіз.
Dialogue: 0,0:09:05.29,0:09:08.71,Default,,0,0,0,,Жолыңда тұрған қызыл жалын ба?
Dialogue: 0,0:09:09.46,0:09:11.21,Default,,0,0,0,,Ағып жатқан ағын?
Dialogue: 0,0:09:11.88,0:09:13.71,Default,,0,0,0,,Қылыш тауы?
Dialogue: 0,0:09:14.42,0:09:19.39,Default,,0,0,0,,Ол менің жолымды бөгеді, мен оған жақындай да алмаймын.
Dialogue: 0,0:09:19.47,0:09:22.22,Default,,0,0,0,,Не? А... бұл?
Dialogue: 0,0:09:22.31,0:09:23.98,Default,,0,0,0,,Роза моншақтары.
Dialogue: 0,0:09:24.06,0:09:28.23,Default,,0,0,0,,Мана шәкірті, өтінемін, бір сәт сонда барыңыз.
Dialogue: 0,0:09:29.27,0:09:32.11,Default,,0,0,0,,Күннің бейбіт басы
Dialogue: 0,0:09:32.19,0:09:34.74,Default,,0,0,0,,Тұрғын үй кешегідей
Dialogue: 0,0:09:35.32,0:09:37.74,Default,,0,0,0,,Өзгерген нәрселер туралы айту
Dialogue: 0,0:09:38.32,0:09:42.49,Default,,0,0,0,,Жол қайнаған лавадан тұрды ма?
Dialogue: 0,0:09:44.83,0:09:47.92,Default,,0,0,0,,Жаман күнде солай болады
Dialogue: 0,0:09:48.00,0:09:50.92,Default,,0,0,0,,Ол сізге «Барма!» дейді.
Dialogue: 0,0:09:53.38,0:09:56.05,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:09:57.43,0:10:00.60,Default,,0,0,0,,Сәлем, балалар, бұл «қауіпті» нәрсе.
Dialogue: 0,0:10:00.68,0:10:03.26,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:10:05.35,0:10:07.27,Default,,0,0,0,,- (Шибукава) Уцуми мырза - (Уцуми) Ха…
Dialogue: 0,0:10:07.94,0:10:11.77,Default,,0,0,0,,Бұл оның басталғанын білдіре ме?
Dialogue: 0,0:10:12.40,0:10:13.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:19.45,0:10:21.78,Default,,0,0,0,,Хе! келеді деп ойладым
Dialogue: 0,0:10:21.87,0:10:22.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.91,0:10:25.04,Default,,0,0,0,,Тосын шабуыл, тосын шабуыл сіздің шеберлігіңіз.
Dialogue: 0,0:10:25.66,0:10:27.54,Default,,0,0,0,,Сирек кездесетін сұм жын
Dialogue: 0,0:10:27.62,0:10:31.04,Default,,0,0,0,,Чамбараның арғы жағындағы тарихи драмадан
Dialogue: 0,0:10:31.71,0:10:35.63,Default,,0,0,0,,Миямото Мусаши келді.
Dialogue: 0,0:10:39.13,0:10:41.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:41.89,0:10:43.80,Default,,0,0,0,,Анашым!
Dialogue: 0,0:10:44.89,0:10:46.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.22,0:10:49.81,Default,,0,0,0,,Үлкенді-кішіні ұстаймын ғой.
Dialogue: 0,0:10:51.15,0:10:52.56,Default,,0,0,0,,Ура!
Dialogue: 0,0:10:53.15,0:10:55.07,Default,,0,0,0,,Самурай
Dialogue: 0,0:10:55.57,0:10:56.82,Default,,0,0,0,,Не!
Dialogue: 0,0:10:56.90,0:10:58.32,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:11:00.91,0:11:02.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:02.16,0:11:03.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:04.16,0:11:05.33,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,0:11:07.62,0:11:08.58,Default,,0,0,0,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:11:08.66,0:11:11.58,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:11:11.67,0:11:12.54,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:12.63,0:11:13.58,Default,,0,0,0,,(тізе бүккен дыбысы)
Dialogue: 0,0:11:13.67,0:11:17.84,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:11:17.92,0:11:19.09,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:11:20.47,0:11:22.09,Default,,0,0,0,,（）
Dialogue: 0,0:11:22.18,0:11:24.85,Default,,0,0,0,,А... м... мұғалім?
Dialogue: 0,0:11:24.93,0:11:25.85,Default,,0,0,0,,Уау?
Dialogue: 0,0:11:28.22,0:11:31.10,Default,,0,0,0,,Жоқ, күткендей.
Dialogue: 0,0:11:31.69,0:11:33.85,Default,,0,0,0,,Күтілгендей, күткендей
Dialogue: 0,0:11:34.56,0:11:36.86,Default,,0,0,0,,Қылыш иесінен күткендей.
Dialogue: 0,0:11:38.44,0:11:41.11,Default,,0,0,0,,Оны қалай шығару керектігін де көрсетпей-ақ
Dialogue: 0,0:11:41.20,0:11:42.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:43.20,0:11:45.37,Default,,0,0,0,,...Одан алыс.
Dialogue: 0,0:11:45.95,0:11:48.74,Default,,0,0,0,,Ол тіпті ішке кіргенін де көрсетпейді.
Dialogue: 0,0:11:48.83,0:11:51.12,Default,,0,0,0,,Байқасаңыз, шошып кетесіз
Dialogue: 0,0:11:51.71,0:11:55.13,Default,,0,0,0,,Мен бірінші аяғымды тигізбей тұрып-ақ жиналып қалды.
Dialogue: 0,0:11:55.96,0:11:57.80,Default,,0,0,0,,Оған қол тигізуге уақыт жоқ
Dialogue: 0,0:11:58.34,0:12:00.63,Default,,0,0,0,,Айки де емес.
Dialogue: 0,0:12:05.18,0:12:06.64,Default,,0,0,0,,Атуға үлгермей тұрып байқап қалды.
Dialogue: 0,0:12:06.72,0:12:07.89,Default,,0,0,0,,О!
Dialogue: 0,0:12:08.93,0:12:10.39,Default,,0,0,0,,Қап…
Dialogue: 0,0:12:10.47,0:12:12.31,Default,,0,0,0,,(қатты қысу дыбысы)
Dialogue: 0,0:12:12.39,0:12:14.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:14.48,0:12:16.65,Default,,0,0,0,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:12:17.40,0:12:21.24,Default,,0,0,0,,Ұлы қылышшы осындай болуы керек.
Dialogue: 0,0:12:21.74,0:12:23.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:24.16,0:12:25.70,Default,,0,0,0,,(қашықтықтағы көліктің дыбысы)
Dialogue: 0,0:12:25.78,0:12:28.08,Default,,0,0,0,,Токугава қарт.
Dialogue: 0,0:12:29.03,0:12:31.08,Default,,0,0,0,,Адамның тұрған жері ұрланған.
Dialogue: 0,0:12:32.46,0:12:36.08,Default,,0,0,0,,Мен көп айтқан жоқпын, бірақ Штаб.
Dialogue: 0,0:12:36.71,0:12:39.09,Default,,0,0,0,,Мен сізге қонаққа келмекші болдым.
Dialogue: 0,0:12:39.17,0:12:40.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:40.76,0:12:43.84,Default,,0,0,0,,Сіз маған қонаққа барасыз ба?
Dialogue: 0,0:12:43.92,0:12:47.34,Default,,0,0,0,,Бұл күндері тұтынушылардың саны артып жатыр емес пе?
Dialogue: 0,0:12:47.97,0:12:50.85,Default,,0,0,0,,Сіз оны жақсы білесіз.
Dialogue: 0,0:12:53.31,0:12:54.85,Default,,0,0,0,,Харди дос Норд
Dialogue: 0,0:12:55.77,0:12:56.85,Default,,0,0,0,,Коньяк.
Dialogue: 0,0:12:57.73,0:12:58.86,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:13:01.48,0:13:02.86,Default,,0,0,0,,(әйнек түсіру дыбысы)
Dialogue: 0,0:13:04.45,0:13:07.45,Default,,0,0,0,,(аузында алкогольдің ағу дыбысы)
Dialogue: 0,0:13:13.20,0:13:14.37,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:13:15.41,0:13:16.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:20.21,0:13:21.46,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:22.38,0:13:24.13,Default,,0,0,0,,Жақсы жүзім
Dialogue: 0,0:13:25.13,0:13:26.63,Default,,0,0,0,,Бөшкелер де жақсы
Dialogue: 0,0:13:30.72,0:13:32.89,Default,,0,0,0,,(қатты заттарды шайнау дыбысы)
Dialogue: 0,0:13:32.97,0:13:35.14,Default,,0,0,0,,Бұл арзан кәмпит.
Dialogue: 0,0:13:35.81,0:13:37.14,Default,,0,0,0,,Бұл жігітке жақсы жарасады.
Dialogue: 0,0:13:39.73,0:13:40.82,Default,,0,0,0,,(шайнау дыбысы)
Dialogue: 0,0:13:43.28,0:13:46.70,Default,,0,0,0,,Юдзиро Ханма кәмпит жеп жатыр
Dialogue: 0,0:13:46.78,0:13:50.16,Default,,0,0,0,,Тонда Маған қазына туралы бейнеролик көрсетілді.
Dialogue: 0,0:13:51.20,0:13:53.91,Default,,0,0,0,,Хехе, мен қатты толқып тұрмын.
Dialogue: 0,0:13:55.50,0:13:59.17,Default,,0,0,0,,Миямото Мусашидің абсолютті бренді
Dialogue: 0,0:14:00.33,0:14:02.17,Default,,0,0,0,,Кездескенше
Dialogue: 0,0:14:04.76,0:14:05.67,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:05.76,0:14:08.93,Default,,0,0,0,,Жаман сөз айтпа. Тоқта.
Dialogue: 0,0:14:09.64,0:14:10.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.52,0:14:18.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:20.27,0:14:23.19,Default,,0,0,0,,(шайнау дыбысы)
Dialogue: 0,0:14:23.27,0:14:26.19,Default,,0,0,0,,Бұл сіз басқара алатын адам емес.
Dialogue: 0,0:14:30.78,0:14:32.99,Default,,0,0,0,,(әлсіз тыныс)
Dialogue: 0,0:14:41.17,0:14:43.84,Default,,0,0,0,,Осы жаздың ұзаққа созылған ыстығы
Dialogue: 0,0:14:43.92,0:14:46.59,Default,,0,0,0,,Күн басыңды ауыртпайды.
Dialogue: 0,0:14:47.84,0:14:49.51,Default,,0,0,0,,Мотобу Изо
Dialogue: 0,0:14:50.38,0:14:52.85,Default,,0,0,0,,Оны кім шеше алады?
Dialogue: 0,0:14:53.89,0:14:57.85,Default,,0,0,0,,Юдзиро Ханма, сіз сенімді бола аласыз.
Dialogue: 0,0:14:57.93,0:15:01.35,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:15:01.44,0:15:03.61,Default,,0,0,0,,Қарғыс атсын... Керемет...
Dialogue: 0,0:15:03.69,0:15:06.11,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:15:06.19,0:15:08.11,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:09.70,0:15:12.24,Default,,0,0,0,,(Юдзироның дірілдеген тынысы)
Dialogue: 0,0:15:16.20,0:15:16.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.96,0:15:23.92,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:15:28.71,0:15:29.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:31.18,0:15:34.18,Default,,0,0,0,,Менің ойым аралас болды.
Dialogue: 0,0:15:34.97,0:15:36.89,Default,,0,0,0,,Сіз сенімді бола аласыз.
Dialogue: 0,0:15:36.97,0:15:39.98,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:15:40.06,0:15:42.39,Default,,0,0,0,,Ешқашан қорғалмаған
Dialogue: 0,0:15:43.06,0:15:45.65,Default,,0,0,0,,Туғаннан бүгінгі күнге дейін
Dialogue: 0,0:15:45.73,0:15:49.40,Default,,0,0,0,,Мен бір сәтке де ешкімнің мені қорғауға рұқсат бермеймін.
Dialogue: 0,0:15:51.70,0:15:55.91,Default,,0,0,0,,Тіпті босану да өзі тапсырыс беру арқылы орындалды.
Dialogue: 0,0:15:55.99,0:16:00.00,Default,,0,0,0,,Тіпті анасына емізуді бұйырды.
Dialogue: 0,0:16:00.50,0:16:01.00,Default,,0,0,0,,(Юдзироның арылдаған дауысы)
Dialogue: 0,0:16:01.00,0:16:04.00,Default,,0,0,0,,(Юдзироның арылдаған дауысы)
Dialogue: 0,0:16:01.00,0:16:04.00,Default,,0,0,0,,Қорғалудың бейтаныстығы
Dialogue: 0,0:16:04.00,0:16:04.42,Default,,0,0,0,,(Юдзироның арылдаған дауысы)
Dialogue: 0,0:16:05.00,0:16:07.54,Default,,0,0,0,,Қорғауға иммунитет жоқ
Dialogue: 0,0:16:08.50,0:16:09.63,Default,,0,0,0,,Хамф!
Dialogue: 0,0:16:09.71,0:16:11.17,Default,,0,0,0,,ашуланды
Dialogue: 0,0:16:11.26,0:16:12.51,Default,,0,0,0,,- (Тұтынушы А) Эй! -(Тапсырыс беруші В) О!
Dialogue: 0,0:16:11.26,0:16:12.51,Default,,0,0,0,,(жердің гуілдеген дыбысы)
Dialogue: 0,0:16:12.51,0:16:12.59,Default,,0,0,0,,(жердің гуілдеген дыбысы)
Dialogue: 0,0:16:12.59,0:16:14.18,Default,,0,0,0,,(жердің гуілдеген дыбысы)
Dialogue: 0,0:16:12.59,0:16:14.18,Default,,0,0,0,,- (Тапсырыс беруші С) Жер сілкінісі? -(Тапсырыс беруші D) Не?
Dialogue: 0,0:16:16.55,0:16:18.18,Default,,0,0,0,,«Шығу»
Dialogue: 0,0:16:18.26,0:16:21.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:21.27,0:16:23.19,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:16:23.27,0:16:26.19,Default,,0,0,0,,(Тістердің бір-біріне тиген дыбысы)
Dialogue: 0,0:16:26.27,0:16:29.78,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:16:32.82,0:16:35.70,Default,,0,0,0,,Хехехе, мен істеймін.
Dialogue: 0,0:16:36.37,0:16:41.95,Default,,0,0,0,,Мен сол ашулы дұшпанға өз өсиетімді орындадым.
Dialogue: 0,0:16:42.54,0:16:44.54,Default,,0,0,0,,Юдзиро Ханманы қорғаңыз
Dialogue: 0,0:16:45.04,0:16:46.71,Default,,0,0,0,,Ханма Баки
Dialogue: 0,0:16:46.79,0:16:48.71,Default,,0,0,0,,Шибукава мырза
Dialogue: 0,0:16:48.79,0:16:50.21,Default,,0,0,0,,Джек
Dialogue: 0,0:16:50.30,0:16:51.96,Default,,0,0,0,,Катцуми Гучи
Dialogue: 0,0:16:52.05,0:16:56.51,Default,,0,0,0,,Бүгінгі өмір сүріп жатқан жауынгерлер ешқашан көре алмайтын нәрселер
Dialogue: 0,0:16:56.59,0:16:58.97,Default,,0,0,0,,Сіз Мотобу Изо болғандықтан не көре аласыз
Dialogue: 0,0:16:59.89,0:17:02.56,Default,,0,0,0,,Мен өмірімді дәстүрлі жекпе-жек өнерімен өткіздім.
Dialogue: 0,0:17:02.64,0:17:05.48,Default,,0,0,0,,Көретіндер алдында тұрады
Dialogue: 0,0:17:05.56,0:17:08.56,Default,,0,0,0,,Бұл табиғи жауапкершілік.
Dialogue: 0,0:17:15.07,0:17:17.99,Default,,0,0,0,,Мм, маусым өзгерді ме?
Dialogue: 0,0:17:19.58,0:17:21.66,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:17:22.33,0:17:23.25,Default,,0,0,0,,О!
Dialogue: 0,0:17:23.33,0:17:24.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.58,0:17:29.25,Default,,0,0,0,,бұл...Мыр. Ханма
Dialogue: 0,0:17:29.33,0:17:30.34,Default,,0,0,0,,(Хане)
Dialogue: 0,0:17:33.34,0:17:35.30,Default,,0,0,0,,Уф!Уф...
Dialogue: 0,0:17:35.38,0:17:37.68,Default,,0,0,0,,Қауіпсіздікке жауапты адам
Dialogue: 0,0:17:37.76,0:17:41.26,Default,,0,0,0,,Мен сенің оңайлықпен артта қалуыңа жол бере алмаймын.
Dialogue: 0,0:17:41.35,0:17:44.43,Default,,0,0,0,,Ол бірінші рет сөйледі.
Dialogue: 0,0:17:44.52,0:17:46.77,Default,,0,0,0,,Мен... Менде ұят жоқ...
Dialogue: 0,0:17:46.85,0:17:51.07,Default,,0,0,0,,Неліктен интрузия? Егер бұл Ханма-сама болса, ол алдыңғы жақтан биік тұрады ...
Dialogue: 0,0:17:51.15,0:17:52.32,Default,,0,0,0,,Үлгі емес
Dialogue: 0,0:17:52.40,0:17:53.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.11,0:17:55.78,Default,,0,0,0,,Гада бірінші орында
Dialogue: 0,0:17:55.86,0:17:58.86,Default,,0,0,0,,Мен мұнда шай ішуге келген жоқпын.
Dialogue: 0,0:17:58.95,0:18:00.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:18:00.12,0:18:01.49,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:02.66,0:18:05.04,Default,,0,0,0,,Менде қонақ бар.
Dialogue: 0,0:18:08.67,0:18:11.59,Default,,0,0,0,,Мусаши-доноға не болды?
Dialogue: 0,0:18:11.67,0:18:12.92,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:18:13.00,0:18:14.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.63,0:18:17.97,Default,,0,0,0,,Кімді шақырдыңыз?
Dialogue: 0,0:18:18.05,0:18:19.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:19.38,0:18:21.85,Default,,0,0,0,,Кіріңіз, сэр.
Dialogue: 0,0:18:21.93,0:18:22.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.89,0:18:29.81,Default,,0,0,0,,Юудзиро!
Dialogue: 0,0:18:29.90,0:18:31.36,Default,,0,0,0,,Кім біледі?
Dialogue: 0,0:18:31.44,0:18:32.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:33.52,0:18:36.32,Default,,0,0,0,,Хмм, екеуі де жақсы.
Dialogue: 0,0:18:37.19,0:18:38.53,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:18:40.36,0:18:41.95,Default,,0,0,0,,Юдзиро
Dialogue: 0,0:18:42.78,0:18:46.29,Default,,0,0,0,,Токугава мырза, тағы бір ыдыс
Dialogue: 0,0:18:51.79,0:18:53.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:53.29,0:18:54.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:07.56,0:19:08.85,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:09.35,0:19:10.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:13.31,0:19:16.23,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:19:16.32,0:19:18.90,Default,,0,0,0,,Аспанға жету...
Dialogue: 0,0:19:18.99,0:19:20.99,Default,,0,0,0,,Не, не!
Dialogue: 0,0:19:22.11,0:19:23.53,Default,,0,0,0,,...
Dialogue: 0,0:19:24.58,0:19:26.49,Default,,0,0,0,,Меннен не көріп тұрсың?
Dialogue: 0,0:19:27.08,0:19:30.00,Default,,0,0,0,,Мен не көріп тұрмын?
Dialogue: 0,0:19:30.08,0:19:32.58,Default,,0,0,0,,Мен оны естігім келеді.
Dialogue: 0,0:19:33.08,0:19:34.79,Default,,0,0,0,,Ақымақ сұрақтар да ақымақ сұрақтар
Dialogue: 0,0:19:34.88,0:19:35.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:35.84,0:19:36.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:37.34,0:19:42.26,Default,,0,0,0,,Сіздің алдыңызда аты аңызға айналған қылышшы Миямото Мусашидің шынайы бейнесі.
Dialogue: 0,0:19:43.47,0:19:48.27,Default,,0,0,0,,Миямото Мусаши, соққанда әрекет етеді.
Dialogue: 0,0:19:48.89,0:19:50.27,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:19:50.35,0:19:52.85,Default,,0,0,0,,Бұл орындалған арман
Dialogue: 0,0:19:53.35,0:19:58.53,Default,,0,0,0,,Айналам алтын таулармен қоршалса да, Көретінім сен ғана.
Dialogue: 0,0:19:59.36,0:20:00.90,Default,,0,0,0,,Күткендей!
Dialogue: 0,0:20:00.99,0:20:03.53,Default,,0,0,0,,Жақсы айттыңыз, Юдзиро Ханма!
Dialogue: 0,0:20:04.62,0:20:08.54,Default,,0,0,0,,Сонда меннен не көріп тұрсың?
Dialogue: 0,0:20:08.62,0:20:10.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:10.12,0:20:13.04,Default,,0,0,0,,Бұл алтын емес.
Dialogue: 0,0:20:13.12,0:20:14.54,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:18.88,0:20:19.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:19.88,0:20:21.34,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:20:24.13,0:20:26.55,Default,,0,0,0,,Алтын ше?
Dialogue: 0,0:20:29.14,0:20:32.81,Default,,0,0,0,,Күрес мақсат емес, құрал ма?
Dialogue: 0,0:20:34.39,0:20:37.81,Default,,0,0,0,,Сіз қалай жауап бересіз? миямото мусаши
Dialogue: 0,0:20:39.02,0:20:40.82,Default,,0,0,0,,Төмен тазалық
Dialogue: 0,0:20:42.90,0:20:45.32,Default,,0,0,0,,Бұл қажет пе? Тазалық
Dialogue: 0,0:20:45.41,0:20:46.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:46.91,0:20:48.08,Default,,0,0,0,,Кесілген
Dialogue: 0,0:20:48.16,0:20:49.08,Default,,0,0,0,,Кесілген
Dialogue: 0,0:20:49.70,0:20:50.58,Default,,0,0,0,,Кесілген
Dialogue: 0,0:20:51.16,0:20:53.58,Default,,0,0,0,,60-тан астам рет қатысу керек
Dialogue: 0,0:20:53.66,0:20:58.67,Default,,0,0,0,,Тривиальды қақтығыстарды қоссаңыз, ол 100-ден кем емес.
Dialogue: 0,0:20:59.17,0:21:01.30,Default,,0,0,0,,Кесу және кесу
Dialogue: 0,0:21:01.80,0:21:03.09,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:03.72,0:21:07.18,Default,,0,0,0,,Мен қиғаштай бердім, атым жайылып кетті.
Dialogue: 0,0:21:08.18,0:21:09.10,Default,,0,0,0,,Киотоға
Dialogue: 0,0:21:09.18,0:21:10.60,Default,,0,0,0,,Нараға
Dialogue: 0,0:21:10.68,0:21:12.10,Default,,0,0,0,,Эдода
Dialogue: 0,0:21:12.93,0:21:17.10,Default,,0,0,0,,Ол тараған сайын, әртүрлі елдердің даймолары оны жалғыз қалдырмайды.
Dialogue: 0,0:21:17.19,0:21:20.15,Default,,0,0,0,,Барлығы мені қалайды
Dialogue: 0,0:21:21.19,0:21:22.44,Default,,0,0,0,,(Мицунаридің дірілдеген тынысы)
Dialogue: 0,0:21:22.53,0:21:23.94,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:21:24.44,0:21:28.16,Default,,0,0,0,,Әйгілі қылышшыны жеңгенде
Dialogue: 0,0:21:28.24,0:21:30.62,Default,,0,0,0,,Қызметшілерге қойылатын шарттар көтерілуде
Dialogue: 0,0:21:31.45,0:21:34.62,Default,,0,0,0,,Әйел-еркек, үлкен-кіші мені мақтады.
Dialogue: 0,0:21:35.29,0:21:38.13,Default,,0,0,0,,Толып жатқанымыз сонша, жолда жүре алмай қалдық.
Dialogue: 0,0:21:38.96,0:21:40.38,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:21:41.96,0:21:44.38,Default,,0,0,0,,Әдемі қыз да
Dialogue: 0,0:21:44.46,0:21:47.13,Default,,0,0,0,,Жарқыраған алтын да
Dialogue: 0,0:21:47.84,0:21:49.89,Default,,0,0,0,,Тамаша той
Dialogue: 0,0:21:50.47,0:21:51.89,Default,,0,0,0,,Алкоголь
Dialogue: 0,0:21:51.97,0:21:53.89,Default,,0,0,0,,Хмм, келіңіз.
Dialogue: 0,0:21:53.97,0:21:55.39,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:21:55.48,0:21:58.15,Default,,0,0,0,,Өз жолыңыз болсын!
Dialogue: 0,0:21:58.23,0:22:00.06,Default,,0,0,0,,Мен жоғары көтерілгім келеді!
Dialogue: 0,0:22:00.15,0:22:01.90,Default,,0,0,0,,Маған мақтау айтқым келеді!
Dialogue: 0,0:22:01.98,0:22:05.90,Default,,0,0,0,,Мақтау, мақтау, мақтау...
Dialogue: 0,0:22:05.99,0:22:08.16,Default,,0,0,0,,Ta~hahahaa!
Dialogue: 0,0:22:08.24,0:22:11.66,Default,,0,0,0,,Мен жүгіре алмаймын немесе тығылғым келеді!
Dialogue: 0,0:22:11.74,0:22:13.16,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:22:21.75,0:22:26.76,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.13,0:23:50.13,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.63,0:23:57.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory