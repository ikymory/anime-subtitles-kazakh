Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.59,0:00:16.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.59,0:01:39.59,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.10,0:01:42.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:43.72,0:01:45.52,Default,,0,0,0,,Маған жақсы бол, сен
Dialogue: 0,0:01:46.43,0:01:48.27,Default,,0,0,0,,Мен сені талай рет өлтіруім мүмкін еді.
Dialogue: 0,0:01:48.94,0:01:50.27,Default,,0,0,0,,Мен оны аяқтай алмадым!
Dialogue: 0,0:01:51.27,0:01:53.73,Default,,0,0,0,,Менікі жарықтан да жылдам!
Dialogue: 0,0:01:56.90,0:01:58.49,Default,,0,0,0,,Хиен
Dialogue: 0,0:02:00.66,0:02:01.99,Default,,0,0,0,,Жарықтың жарқылы
Dialogue: 0,0:02:04.16,0:02:05.50,Default,,0,0,0,,Мах
Dialogue: 0,0:02:08.12,0:02:11.04,Default,,0,0,0,,Барлығы техниканың жылдамдығын безендіретін сөздер.
Dialogue: 0,0:02:11.13,0:02:13.55,Default,,0,0,0,,Хмм… Иә.
Dialogue: 0,0:02:14.46,0:02:17.59,Default,,0,0,0,,Осы әдістердің барлығы мені күлдіреді
Dialogue: 0,0:02:17.67,0:02:20.80,Default,,0,0,0,,Дайын болған жауға тимейсің деген сөз.
Dialogue: 0,0:02:20.89,0:02:22.80,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:02:23.72,0:02:26.77,Default,,0,0,0,,Келетінін білсем, жемес едім.
Dialogue: 0,0:02:27.68,0:02:28.81,Default,,0,0,0,,Бірақ
Dialogue: 0,0:02:29.52,0:02:31.90,Default,,0,0,0,,Бұл жерде ерекшелік бар.
Dialogue: 0,0:02:32.40,0:02:33.31,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:02:33.40,0:02:34.32,Default,,0,0,0,,Соғу
Dialogue: 0,0:02:35.36,0:02:36.82,Default,,0,0,0,,Оның келе жатқанын білсең де
Dialogue: 0,0:02:37.78,0:02:39.32,Default,,0,0,0,,Дайын болсаңыз да
Dialogue: 0,0:02:40.07,0:02:41.82,Default,,0,0,0,,Дайын болсаңыз да
Dialogue: 0,0:02:42.57,0:02:44.33,Default,,0,0,0,,Ойланбай тамақтаныңыз
Dialogue: 0,0:02:45.12,0:02:47.12,Default,,0,0,0,,Әлем чемпионы?
Dialogue: 0,0:02:47.20,0:02:50.83,Default,,0,0,0,,Сақинаға сол техника соғылады деген болжаммен кіріңіз.
Dialogue: 0,0:02:51.79,0:02:53.84,Default,,0,0,0,,Техника дегеніміз не...
Dialogue: 0,0:02:53.92,0:02:56.05,Default,,0,0,0,,Galactica Phantom Ultra Super
Dialogue: 0,0:02:56.05,0:02:56.96,Default,,0,0,0,,Galactica Phantom Ultra Super
Dialogue: 0,0:02:56.05,0:02:56.96,Default,,0,0,0,,(Жас Бақидың дірілдеген дауысы)
Dialogue: 0,0:02:56.96,0:02:57.05,Default,,0,0,0,,(Жас Бақидың дірілдеген дауысы)
Dialogue: 0,0:02:57.05,0:02:59.05,Default,,0,0,0,,(Жас Бақидың дірілдеген дауысы)
Dialogue: 0,0:02:57.05,0:02:59.05,Default,,0,0,0,,Қырық төрт Magnum Ultimate…
Dialogue: 0,0:02:59.05,0:03:00.84,Default,,0,0,0,,Қырық төрт Magnum Ultimate…
Dialogue: 0,0:03:04.51,0:03:05.85,Default,,0,0,0,,Жаб
Dialogue: 0,0:03:05.93,0:03:06.93,Default,,0,0,0,,Е...
Dialogue: 0,0:03:07.43,0:03:10.35,Default,,0,0,0,,(Жас Бақидың ауыр тыныс алуы)
Dialogue: 0,0:03:10.44,0:03:13.10,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:03:13.19,0:03:16.57,Default,,0,0,0,,Бұл сөзсіз және лайықты фронтальды серпіліс.
Dialogue: 0,0:03:16.65,0:03:18.86,Default,,0,0,0,,Тек жылдамдық маңызды
Dialogue: 0,0:03:19.86,0:03:23.87,Default,,0,0,0,,Бұл жағынан сүйекті шымырлататын, қытайлық үлгідегі әдіс деуге болады.
Dialogue: 0,0:03:23.95,0:03:25.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:26.45,0:03:27.87,Default,,0,0,0,,Жаб…
Dialogue: 0,0:03:27.95,0:03:29.62,Default,,0,0,0,,Қайталаңыз!
Dialogue: 0,0:03:30.91,0:03:32.92,Default,,0,0,0,,Гравюраны қайталау
Dialogue: 0,0:03:34.04,0:03:35.38,Default,,0,0,0,,Жабық бұл...
Dialogue: 0,0:03:35.96,0:03:37.30,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:03:37.38,0:03:41.51,Default,,0,0,0,,Бұл қазіргі жекпе-жек өнеріндегі ең жылдам әдіс.
Dialogue: 0,0:03:44.09,0:03:45.51,Default,,0,0,0,,Хо…
Dialogue: 0,0:03:45.60,0:03:47.01,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:03:47.68,0:03:48.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:49.89,0:03:51.02,Default,,0,0,0,,Хо…
Dialogue: 0,0:04:01.61,0:04:02.78,Default,,0,0,0,,Төмен!
Dialogue: 0,0:04:03.78,0:04:04.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:05.37,0:04:07.37,Default,,0,0,0,,Соңғы 10 секунд
Dialogue: 0,0:04:08.41,0:04:10.37,Default,,0,0,0,,Қанша рет болса да мүмкін емес
Dialogue: 0,0:04:10.87,0:04:13.79,Default,,0,0,0,,Мен оны 3 рет өлтіруім мүмкін еді.
Dialogue: 0,0:04:13.87,0:04:15.79,Default,,0,0,0,,О...
Dialogue: 0,0:04:16.71,0:04:18.09,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:21.30,0:04:22.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:23.26,0:04:25.09,Default,,0,0,0,,Бон дұрыс айтады.
Dialogue: 0,0:04:25.59,0:04:27.55,Default,,0,0,0,,Мен өлтірілдім
Dialogue: 0,0:04:27.64,0:04:29.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.35,0:04:32.10,Default,,0,0,0,,өлді
Dialogue: 0,0:04:33.35,0:04:35.06,Default,,0,0,0,,Секірер алдында
Dialogue: 0,0:04:36.40,0:04:38.56,Default,,0,0,0,,Бетімді бір қағып жіберді.
Dialogue: 0,0:04:40.61,0:04:41.44,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:42.15,0:04:44.57,Default,,0,0,0,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:04:45.36,0:04:49.58,Default,,0,0,0,,Хмм, сіздің қатысуыңыз күшті.
Dialogue: 0,0:04:49.66,0:04:51.91,Default,,0,0,0,,Сол жақ соққы
Dialogue: 0,0:04:52.45,0:04:55.08,Default,,0,0,0,,Одан жалтарсаң, жалтардың ба?
Dialogue: 0,0:04:55.75,0:05:00.09,Default,,0,0,0,,Мен бұның алдын алмасам, мен енді тактик емеспін.
Dialogue: 0,0:05:01.05,0:05:02.17,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:05:03.17,0:05:04.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.72,0:05:08.59,Default,,0,0,0,,Менің білгім келгені әсер.
Dialogue: 0,0:05:09.39,0:05:13.60,Default,,0,0,0,,Соққы алған адам бетінің ортасы емес, иегі.
Dialogue: 0,0:05:15.69,0:05:17.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:19.73,0:05:22.11,Default,,0,0,0,,Жер еңкейді
Dialogue: 0,0:05:22.94,0:05:24.86,Default,,0,0,0,,Сол жақтан жақындап келе жатқан жер...
Dialogue: 0,0:05:26.11,0:05:27.36,Default,,0,0,0,,Тоқтады
Dialogue: 0,0:05:28.70,0:05:29.62,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:30.37,0:05:32.62,Default,,0,0,0,,Мәйіт өлі болды
Dialogue: 0,0:05:32.70,0:05:34.33,Default,,0,0,0,,О...
Dialogue: 0,0:05:35.83,0:05:37.37,Default,,0,0,0,,Ессіздік
Dialogue: 0,0:05:38.33,0:05:41.63,Default,,0,0,0,,Ермек үшін болса да, мен өзімді жоғалтып алдым.
Dialogue: 0,0:05:42.30,0:05:43.38,Default,,0,0,0,,Бұл ойын емес
Dialogue: 0,0:05:43.46,0:05:44.63,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:46.09,0:05:49.22,Default,,0,0,0,,Бон, атыңды қайта енгіз
Dialogue: 0,0:05:50.47,0:05:52.64,Default,,0,0,0,,Миямото Мусаши
Dialogue: 0,0:05:52.72,0:05:54.64,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:05:55.14,0:05:57.14,Default,,0,0,0,,Бұл Баки Ханма.
Dialogue: 0,0:06:02.77,0:06:03.82,Default,,0,0,0,,Баки
Dialogue: 0,0:06:04.73,0:06:06.65,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:06:09.24,0:06:11.24,Default,,0,0,0,,Қосарлы қолдану…
Dialogue: 0,0:06:11.32,0:06:14.16,Default,,0,0,0,,... Бұл Нитеннің ең жақсысы емес пе!
Dialogue: 0,0:06:15.24,0:06:18.16,Default,,0,0,0,,21 ғасырда өмір сүретін маған
Dialogue: 0,0:06:18.83,0:06:22.17,Default,,0,0,0,,Сенгоку дәуіріндегі шыңның төбесі...
Dialogue: 0,0:06:23.34,0:06:24.59,Default,,0,0,0,,Қазір
Dialogue: 0,0:06:28.26,0:06:31.18,Default,,0,0,0,,Ол сізге ерекше қамқорлық жасайды.
Dialogue: 0,0:06:34.10,0:06:36.68,Default,,0,0,0,,Әй, қандай сән-салтанат!
Dialogue: 0,0:06:37.27,0:06:38.94,Default,,0,0,0,,Қорқыныштан гөрі қызығушылық!
Dialogue: 0,0:06:39.52,0:06:42.19,Default,,0,0,0,,Жалғастырмасам, әдепсіздік болар еді!
Dialogue: 0,0:06:43.69,0:06:46.44,Default,,0,0,0,,Мононофу хабардар болды
Dialogue: 0,0:06:49.53,0:06:53.03,Default,,0,0,0,,Жұдырық келгенше жоғары жылдамдықпен ұшады
Dialogue: 0,0:06:53.53,0:06:57.04,Default,,0,0,0,,Артқы аяқтар жерді тепкенше көбірек
Dialogue: 0,0:06:57.54,0:07:01.04,Default,,0,0,0,,Мен қазір, әлдеқайда ертерек кірісуді шештім.
Dialogue: 0,0:07:01.54,0:07:04.09,Default,,0,0,0,,Мононофу хабардар болды
Dialogue: 0,0:07:04.17,0:07:07.59,Default,,0,0,0,,Жаудың миы шығаратын, тіпті жаудың өзі де байқамайды.
Dialogue: 0,0:07:07.67,0:07:10.47,Default,,0,0,0,,Шешім қабылдаудан 0,5 секунд бұрын сигнал
Dialogue: 0,0:07:11.93,0:07:15.97,Default,,0,0,0,,1991 дат жазушысы
Dialogue: 0,0:07:16.06,0:07:18.39,Default,,0,0,0,,Тор Норетландаш оқыды -
Dialogue: 0,0:07:18.47,0:07:21.69,Default,,0,0,0,,«Сана 0,5 секунд кідіріспен келеді»
Dialogue: 0,0:07:22.31,0:07:27.86,Default,,0,0,0,,Адамдар өз әрекеттерінің өз еркіне негізделгеніне күмәнданбайды.
Dialogue: 0,0:07:27.94,0:07:31.82,Default,,0,0,0,,Әрекет ету туралы шешім қабылдаудан 0,5 секунд бұрын әрекет етіңіз
Dialogue: 0,0:07:31.90,0:07:34.74,Default,,0,0,0,,Ми сигналдарды шығарады.
Dialogue: 0,0:07:35.49,0:07:38.24,Default,,0,0,0,,Жаудың өзінен де жүйрік болсаң
Dialogue: 0,0:07:39.20,0:07:41.83,Default,,0,0,0,,Егер адамның еркін түсіне алсақ ше?
Dialogue: 0,0:07:42.33,0:07:45.50,Default,,0,0,0,,Шабуыл жарқыл жылдамдығында болса да
Dialogue: 0,0:07:45.59,0:07:49.26,Default,,0,0,0,,Егер сізде жекпе-жек өнерінде тәжірибеңіз болса, сіз бұл туралы бірдеңе жасай алатын шығарсыз.
Dialogue: 0,0:07:49.34,0:07:50.59,Default,,0,0,0,,(Бакидің тыныс алу дыбысы)
Dialogue: 0,0:07:51.09,0:07:52.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:52.59,0:07:55.01,Default,,0,0,0,,Түсірілді! Іске қосу алдында!
Dialogue: 0,0:07:58.01,0:07:59.22,Default,,0,0,0,,(Бакидің тыныс алу дыбысы)
Dialogue: 0,0:08:01.27,0:08:04.27,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:18.03,0:08:19.70,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:19.79,0:08:21.45,Default,,0,0,0,,- (Баки) Нуга! - (Мусаши) А?
Dialogue: 0,0:08:25.29,0:08:27.54,Default,,0,0,0,,Нуах!
Dialogue: 0,0:08:28.71,0:08:29.71,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:30.30,0:08:31.46,Default,,0,0,0,,О...
Dialogue: 0,0:08:32.30,0:08:35.30,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:36.80,0:08:39.72,Default,,0,0,0,,Хаха~! Керемет Бон
Dialogue: 0,0:08:39.81,0:08:42.81,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:43.81,0:08:47.23,Default,,0,0,0,,Сол шапанмен күреседі деп ойлау.
Dialogue: 0,0:08:49.07,0:08:51.48,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:52.07,0:08:54.24,Default,,0,0,0,,Менің күткенімнен асып түсті
Dialogue: 0,0:08:54.32,0:08:56.57,Default,,0,0,0,,Сіз әлі де ойнай аласыз
Dialogue: 0,0:08:58.82,0:09:00.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:05.96,0:09:08.96,Default,,0,0,0,,(Қалада ағып жатқан жарқын әуен)
Dialogue: 0,0:09:12.84,0:09:13.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:15.55,0:09:18.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:19.68,0:09:22.39,Default,,0,0,0,,Е... бұл сурет емес.
Dialogue: 0,0:09:25.02,0:09:26.14,Default,,0,0,0,,Ол қозғалады!
Dialogue: 0,0:09:27.31,0:09:29.23,Default,,0,0,0,,Тез өзгереді
Dialogue: 0,0:09:30.27,0:09:31.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.07,0:09:36.03,Default,,0,0,0,,Бұл қабырға не болып жатыр...
Dialogue: 0,0:09:36.11,0:09:36.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:38.16,0:09:40.74,Default,,0,0,0,,Ешкімге мән бермейді
Dialogue: 0,0:09:41.87,0:09:43.54,Default,,0,0,0,,Сирек емес
Dialogue: 0,0:09:43.62,0:09:47.29,Default,,0,0,0,,Қандай эталон, қандай биіктік
Dialogue: 0,0:09:47.37,0:09:49.17,Default,,0,0,0,,Жоғарыда!
Dialogue: 0,0:09:50.08,0:09:52.80,Default,,0,0,0,,Бұл қалыпты жағдай ма?
Dialogue: 0,0:09:54.26,0:09:57.68,Default,,0,0,0,,(плиткамен жүрген жалаң аяқтың дыбысы)
Dialogue: 0,0:09:58.55,0:10:00.47,Default,,0,0,0,,(Эсидиси) Екі мың жыл бұрын жойып жіберуіміз керек еді —
Dialogue: 0,0:10:00.55,0:10:03.60,Default,,0,0,0,,Бұл үлкен айырмашылық.
Dialogue: 0,0:10:03.68,0:10:04.52,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:10:07.64,0:10:08.69,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:10:09.19,0:10:11.44,Default,,0,0,0,,Жүйрік атқа қарағанда әлдеқайда жүйрік
Dialogue: 0,0:10:12.11,0:10:14.32,Default,,0,0,0,,Ішінде адам көп...
Dialogue: 0,0:10:16.28,0:10:19.32,Default,,0,0,0,,Бұл сіз өмір сүрген дәуір.
Dialogue: 0,0:10:19.41,0:10:21.66,Default,,0,0,0,,400 жылдан кейінгі әлем.
Dialogue: 0,0:10:22.16,0:10:24.58,Default,,0,0,0,,400 жыл…
Dialogue: 0,0:10:24.66,0:10:27.08,Default,,0,0,0,,(Реми Аясаки) Ай! Не!? Сонымен не болды!?
Dialogue: 0,0:10:27.96,0:10:29.58,Default,,0,0,0,,400 жыл…
Dialogue: 0,0:10:30.71,0:10:34.17,Default,,0,0,0,,400 жылдың айырмашылығы осыншама!
Dialogue: 0,0:10:35.21,0:10:38.42,Default,,0,0,0,,«Теңдейсіз» дегеннен алыс
Dialogue: 0,0:10:38.92,0:10:40.97,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:10:41.05,0:10:44.85,Default,,0,0,0,,Мұндай нәрсені адам қолымен жасауға бола ма?
Dialogue: 0,0:10:47.52,0:10:49.35,Default,,0,0,0,,
Dialogue: 0,0:10:49.44,0:10:50.60,Default,,0,0,0,,Who?
Dialogue: 0,0:10:50.69,0:10:51.77,Default,,0,0,0,,(өтіп бара жатқан адам күледі)
Dialogue: 0,0:10:51.85,0:10:53.44,Default,,0,0,0,,Фотосурет?
Dialogue: 0,0:10:53.52,0:10:57.11,Default,,0,0,0,,Маған зори сандалдарын дайындау керек пе еді?
Dialogue: 0,0:10:57.19,0:10:59.61,Default,,0,0,0,,(плиткамен жүрген жалаң аяқтың дыбысы)
Dialogue: 0,0:11:00.20,0:11:03.12,Default,,0,0,0,,Мен ренжідім.
Dialogue: 0,0:11:03.74,0:11:05.12,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:11:05.83,0:11:09.37,Default,,0,0,0,,Мен шайқасқа қатысы жоқ нәрсеге ренжідім.
Dialogue: 0,0:11:12.38,0:11:13.63,Default,,0,0,0,,Көзіңізді жоғалтпаңыз
Dialogue: 0,0:11:14.84,0:11:17.63,Default,,0,0,0,,Сіз қарсы тұрған адам ғимарат емес.
Dialogue: 0,0:11:18.96,0:11:21.13,Default,,0,0,0,,Басқа адам - адам
Dialogue: 0,0:11:23.72,0:11:26.64,Default,,0,0,0,,Басқаларды жеңу жолын білу
Dialogue: 0,0:11:27.35,0:11:31.64,Default,,0,0,0,,Жоқ, мен тек адамдарды жеңуді білемін!
Dialogue: 0,0:11:31.73,0:11:32.90,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:11:32.98,0:11:35.48,Default,,0,0,0,,Бір сәтке кешіріңіз?
Dialogue: 0,0:11:35.98,0:11:37.90,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:38.48,0:11:40.90,Default,,0,0,0,,Бізге аздап көмектесіңізші.
Dialogue: 0,0:11:41.61,0:11:42.91,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:42.99,0:11:44.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:44.74,0:11:45.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:46.62,0:11:50.79,Default,,0,0,0,,Ал, олар полиция... хаха
Dialogue: 0,0:11:51.29,0:11:52.92,Default,,0,0,0,,Іс…
Dialogue: 0,0:11:53.96,0:11:56.92,Default,,0,0,0,,Сіздің аяқ киіміңіз ше?
Dialogue: 0,0:11:57.00,0:11:59.17,Default,,0,0,0,,Хмм... бұл?
Dialogue: 0,0:12:00.46,0:12:02.93,Default,,0,0,0,,Бейқам болма хаха
Dialogue: 0,0:12:03.88,0:12:05.59,Default,,0,0,0,,Кездейсоқ па?
Dialogue: 0,0:12:05.68,0:12:08.26,Default,,0,0,0,,Сіз абайсызда оны киюді ұмытып қалдыңыз ба?
Dialogue: 0,0:12:08.35,0:12:09.18,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:09.77,0:12:13.27,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:12:13.35,0:12:17.19,Default,,0,0,0,,Сіздің жеке басыңызды дәлелдейтін нәрсе...
Dialogue: 0,0:12:17.82,0:12:20.53,Default,,0,0,0,,Кіріспе хат сияқты нәрсе ме?
Dialogue: 0,0:12:21.03,0:12:22.19,Default,,0,0,0,,Осыншама ма?
Dialogue: 0,0:12:22.28,0:12:25.41,Default,,0,0,0,,Аты-жөні және тұрғылықты жері Туған күні
Dialogue: 0,0:12:25.49,0:12:27.20,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:12:27.83,0:12:30.04,Default,,0,0,0,,Менің атым Миямото Мусаши.
Dialogue: 0,0:12:30.58,0:12:33.21,Default,,0,0,0,,Теншо 12 жылы туған...
Dialogue: 0,0:12:33.29,0:12:34.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:35.92,0:12:37.33,Default,,0,0,0,,Тұрғын үй?
Dialogue: 0,0:12:37.84,0:12:40.21,Default,,0,0,0,,Мен жақында келдім.
Dialogue: 0,0:12:40.30,0:12:41.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:42.88,0:12:45.97,Default,,0,0,0,,Сіз шөптер жасайсыз ба?
Dialogue: 0,0:12:46.47,0:12:47.72,Default,,0,0,0,,Бұл шыбын ма?
Dialogue: 0,0:12:48.51,0:12:50.22,Default,,0,0,0,,«Хабу» дегеніміз не?
Dialogue: 0,0:12:50.31,0:12:51.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:51.81,0:12:53.48,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 0,0:12:53.56,0:12:54.48,Default,,0,0,0,,О...
Dialogue: 0,0:12:56.81,0:12:57.73,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:12:57.81,0:12:59.06,Default,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:12:59.15,0:12:59.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:00.07,0:13:00.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:11.99,0:13:13.08,Default,,0,0,0,,Арман...
Dialogue: 0,0:13:14.50,0:13:18.17,Default,,0,0,0,,Бұл түс емес еді, ұмытуға амалым жоқ
Dialogue: 0,0:13:20.92,0:13:23.63,Default,,0,0,0,,Дененің жоғарғы бөлігін диагональ бойынша өтетін соққы
Dialogue: 0,0:13:25.09,0:13:27.34,Default,,0,0,0,,Әлі де анық
Dialogue: 0,0:13:30.60,0:13:32.47,Default,,0,0,0,,Сіз қайта-қайта таң қаласыз!
Dialogue: 0,0:13:33.68,0:13:36.39,Default,,0,0,0,,Оған кім сенеді?
Dialogue: 0,0:13:36.98,0:13:39.65,Default,,0,0,0,,Самураймен шайқасты
Dialogue: 0,0:13:40.27,0:13:43.73,Default,,0,0,0,,Тіпті самурай емес, Миямото Мусаши!
Dialogue: 0,0:13:44.49,0:13:45.53,Default,,0,0,0,,(Мицунари: дыбыс жоқ)
Dialogue: 0,0:13:45.53,0:13:47.49,Default,,0,0,0,,(Мицунари: дыбыс жоқ)
Dialogue: 0,0:13:45.53,0:13:47.49,Default,,0,0,0,,Джикчанның түсіндірмесі мен сияқты білімсіз адамға қиын.
Dialogue: 0,0:13:47.49,0:13:49.66,Default,,0,0,0,,Джикчанның түсіндірмесі мен сияқты білімсіз адамға қиын.
Dialogue: 0,0:13:50.32,0:13:54.66,Default,,0,0,0,,Қалай болғанда да Мұсашыны шақырған сол сияқты.
Dialogue: 0,0:13:56.46,0:14:00.42,Default,,0,0,0,,Логикаға қарамастан, түсінікті нәрселер бар.
Dialogue: 0,0:14:01.25,0:14:06.01,Default,,0,0,0,,Миямото Мусашимен бірге болғанының дәлелі бес денеде ойып жазылған.
Dialogue: 0,0:14:07.30,0:14:11.43,Default,,0,0,0,,Ең күшті ұғым сол адамнан басталады.
Dialogue: 0,0:14:12.43,0:14:17.18,Default,,0,0,0,,Жасыл бамбуктың бір серпілу арқылы құлап кетуіне мүмкіндік беретін ерекше ұстау күші
Dialogue: 0,0:14:18.19,0:14:20.94,Default,,0,0,0,,Әрекет жасаған адамның еркіне дейін
Dialogue: 0,0:14:21.02,0:14:23.69,Default,,0,0,0,,Алдын ала болжау мүмкіндігі
Dialogue: 0,0:14:24.40,0:14:28.49,Default,,0,0,0,,Егер сіз мұны түсінбесеңіз, сіз тактик емессіз.
Dialogue: 0,0:14:29.82,0:14:34.49,Default,,0,0,0,,Менің 10 жыл бойы алған бастапқы дағдыларым
Dialogue: 0,0:14:34.58,0:14:37.71,Default,,0,0,0,,Хаха, оны оңай айтуға болады.
Dialogue: 0,0:14:39.21,0:14:42.59,Default,,0,0,0,,Қару үнемі адамның үстінде жүретін кез
Dialogue: 0,0:14:43.63,0:14:47.09,Default,,0,0,0,,Шайқастың салмағы қазіргідей емес.
Dialogue: 0,0:14:48.22,0:14:50.59,Default,,0,0,0,,Жеңіліс – өлім.
Dialogue: 0,0:14:51.59,0:14:54.14,Default,,0,0,0,,Нашар істесең, басың ұшып кетеді, тек метафора емес.
Dialogue: 0,0:14:55.26,0:14:59.94,Default,,0,0,0,,Бір немесе екі болжау қабілетін алған жөн.
Dialogue: 0,0:15:03.31,0:15:04.65,Default,,0,0,0,,Сол күндер
Dialogue: 0,0:15:05.19,0:15:07.61,Default,,0,0,0,,Бұл күш мөлшері
Dialogue: 0,0:15:07.69,0:15:10.61,Default,,0,0,0,,Үйрену табиғи әдет болды.
Dialogue: 0,0:15:13.20,0:15:15.20,Default,,0,0,0,,Қандай жақсы жәндік
Dialogue: 0,0:15:16.29,0:15:20.62,Default,,0,0,0,,Жоғары біздің заманымызға дейін жетті.
Dialogue: 0,0:15:21.42,0:15:22.92,Default,,0,0,0,,Твит
Dialogue: 0,0:15:23.42,0:15:25.38,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:15:26.09,0:15:27.71,Default,,0,0,0,,Ең ерте кезден
Dialogue: 0,0:15:27.80,0:15:30.38,Default,,0,0,0,,Тұздалған қиярдың кереметі келді.
Dialogue: 0,0:15:31.13,0:15:33.68,Default,,0,0,0,,Ал енді, тағы да Сенгоку дәуірінен
Dialogue: 0,0:15:33.76,0:15:36.39,Default,,0,0,0,,Алдымызда ең мықтысы келеді!
Dialogue: 0,0:15:42.35,0:15:43.77,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:44.27,0:15:46.02,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:46.94,0:15:51.45,Default,,0,0,0,,Уақыт, заңдар және Құдай...
Dialogue: 0,0:15:53.57,0:15:54.74,Default,,0,0,0,,I—
Dialogue: 0,0:15:55.28,0:15:58.45,Default,,0,0,0,,Біз адамзат тарихындағы ең күшті кім екенін анықтауға тырысамыз!
Dialogue: 0,0:16:00.25,0:16:01.62,Default,,0,0,0,,Уақыт таяп қалды
Dialogue: 0,0:16:02.12,0:16:03.75,Default,,0,0,0,,Ах, ол біте салысымен —
Dialogue: 0,0:16:03.83,0:16:06.04,Default,,0,0,0,,Ол жаққа көшпе!
Dialogue: 0,0:16:06.13,0:16:09.05,Default,,0,0,0,,Көп ұзамай барлығы байқай бастайды
Dialogue: 0,0:16:06.13,0:16:09.05,Default,,0,0,0,,(Полиция қызметкерлері ауыр тыныс алуда)
Dialogue: 0,0:16:09.13,0:16:11.05,Default,,0,0,0,,(Полиция қызметкері С-ның керілген дауысы)
Dialogue: 0,0:16:11.13,0:16:14.05,Default,,0,0,0,,Бүгінгі өмір сүріп жатқан Миямото мырзамен танысу
Dialogue: 0,0:16:11.13,0:16:14.05,Default,,0,0,0,,(полиция қызметкерлерінің дауысы)
Dialogue: 0,0:16:14.13,0:16:16.05,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:17.18,0:16:19.68,Default,,0,0,0,,Бұл жеткіліксіз!
Dialogue: 0,0:16:22.81,0:16:23.81,Default,,0,0,0,,Пішін
Dialogue: 0,0:16:24.35,0:16:29.19,Default,,0,0,0,,Дүние жүзінде жапондық жекпе-жек өнері сияқты пішінге ерекше мән беретін бірде-бір жекпе-жек өнері жоқ.
Dialogue: 0,0:16:30.15,0:16:34.70,Default,,0,0,0,,Біздің бұрынғыларымыздың әрқайсысы өз қажеттіліктеріне форма берді.
Dialogue: 0,0:16:35.53,0:16:37.70,Default,,0,0,0,,Одан кейінгілерге жолдау ретінде
Dialogue: 0,0:16:38.78,0:16:40.70,Default,,0,0,0,,Қылыш шеберлігін қылыш шеберлігін жасау
Dialogue: 0,0:16:41.66,0:16:43.71,Default,,0,0,0,,Дзюдомен айналысу Дзюдо
Dialogue: 0,0:16:44.54,0:16:46.71,Default,,0,0,0,,Каратэ-каратэ жасау
Dialogue: 0,0:16:47.88,0:16:48.88,Default,,0,0,0,,Пішін
Dialogue: 0,0:16:49.80,0:16:53.55,Default,,0,0,0,,Сол адамның денесін толтыратын жекпе-жек өнерінің мәні
Dialogue: 0,0:16:53.63,0:16:54.72,Default,,0,0,0,,Жекпе-жек өнерінің хрусталы
Dialogue: 0,0:16:55.93,0:16:58.22,Default,,0,0,0,,Сол арқаға секіру
Dialogue: 0,0:16:58.30,0:16:59.93,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:17:00.01,0:17:01.77,Default,,0,0,0,,Пішінді қарап шығу
Dialogue: 0,0:17:03.31,0:17:04.85,Default,,0,0,0,,Қандай пішін?
Dialogue: 0,0:17:08.02,0:17:09.36,Default,,0,0,0,,Шешілді
Dialogue: 0,0:17:10.23,0:17:11.86,Default,,0,0,0,,Менің пішінім
Dialogue: 0,0:17:15.99,0:17:17.36,Default,,0,0,0,,Ханма Баки
Dialogue: 0,0:17:18.20,0:17:20.03,Default,,0,0,0,,Баки Ханма
Dialogue: 0,0:17:20.95,0:17:22.62,Default,,0,0,0,,Ханма Баки үшін
Dialogue: 0,0:17:23.70,0:17:24.71,Default,,0,0,0,,Пішін
Dialogue: 0,0:17:26.25,0:17:27.37,Default,,0,0,0,,Пішін дегеніміз не?
Dialogue: 0,0:17:27.96,0:17:30.38,Default,,0,0,0,,Денеңізді қозғалту тәртібі емес
Dialogue: 0,0:17:30.46,0:17:31.63,Default,,0,0,0,,Техника
Dialogue: 0,0:17:32.38,0:17:35.22,Default,,0,0,0,,Техника талап ететін дене қимылдары
Dialogue: 0,0:17:35.30,0:17:38.09,Default,,0,0,0,,Өзіңіздің идеалды дене қозғалысын табыңыз
Dialogue: 0,0:17:39.39,0:17:41.22,Default,,0,0,0,,Мен қозғалып жатырмын ба?
Dialogue: 0,0:17:42.85,0:17:44.22,Default,,0,0,0,,Менің қозғалыстарым...
Dialogue: 0,0:17:45.56,0:17:47.14,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:17:47.73,0:17:49.98,Default,,0,0,0,,Оның мағынасы бар ма?
Dialogue: 0,0:17:54.61,0:17:55.53,Default,,0,0,0,,Ha
Dialogue: 0,0:17:58.61,0:18:00.57,Default,,0,0,0,,Сіз техникаңыздың талаптарына жауап бересіз бе?
Dialogue: 0,0:18:00.57,0:18:01.87,Default,,0,0,0,,Сіз техниканың талаптарына жауап бересіз бе?
Dialogue: 0,0:18:00.57,0:18:01.87,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:18:01.87,0:18:03.41,Default,,0,0,0,,Сіз техникаңыздың талаптарына жауап бересіз бе?
Dialogue: 0,0:18:07.29,0:18:08.33,Default,,0,0,0,,екі рет
Dialogue: 0,0:18:09.42,0:18:11.92,Default,,0,0,0,,Сен мені екі рет ұрдың.
Dialogue: 0,0:18:16.51,0:18:18.55,Default,,0,0,0,,Мен мұны дәл қазір істей алмаймын.
Dialogue: 0,0:18:19.34,0:18:20.43,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:18:21.76,0:18:24.97,Default,,0,0,0,,Мен сенің алдыңда есінеймін!
Dialogue: 0,0:18:26.64,0:18:27.56,Default,,0,0,0,,
Dialogue: 0,0:18:27.64,0:18:28.81,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,0:18:28.89,0:18:30.81,Default,,0,0,0,,Киім - Самуе!
Dialogue: 0,0:18:28.89,0:18:30.81,Default,,0,0,0,,(Тақтамен жүрген жалаң аяқтың дыбысы)
Dialogue: 0,0:18:30.81,0:18:31.40,Default,,0,0,0,,(плиткамен жүрген жалаң аяқтың дыбысы)
Dialogue: 0,0:18:31.40,0:18:31.90,Default,,0,0,0,,(плиткамен жүрген жалаң аяқтың дыбысы)
Dialogue: 0,0:18:31.40,0:18:31.90,Default,,0,0,0,,Түсі көк көк!
Dialogue: 0,0:18:31.90,0:18:32.40,Default,,0,0,0,,Түсі көк көк!
Dialogue: 0,0:18:32.90,0:18:35.57,Default,,0,0,0,,Сонымен қатар, Марухи жалаң аяқ сияқты.
Dialogue: 0,0:18:36.24,0:18:38.32,Default,,0,0,0,,Қазір Шибуяға қарай бет алды.
Dialogue: 0,0:18:38.40,0:18:41.03,Default,,0,0,0,,Айналадағы ДК (ДК) орынға жедел жеткізілді!
Dialogue: 0,0:18:44.70,0:18:46.29,Default,,0,0,0,,Тайфунның өтуі
Dialogue: 0,0:18:46.79,0:18:50.04,Default,,0,0,0,,Міне, Йойоги саябағында, мезгілсіз күн сәулесінде
Dialogue: 0,0:18:50.12,0:18:53.71,Default,,0,0,0,,Цикадалар да күздің белгілерін ұмытып кеткендей болды.
Dialogue: 0,0:18:53.79,0:18:55.80,Default,,0,0,0,,Келесі жаңалық.
Dialogue: 0,0:18:55.88,0:18:57.46,Default,,0,0,0,,Бүгін сағат 15:30 шамасында.
Dialogue: 0,0:18:57.55,0:19:00.84,Default,,0,0,0,,Өзін Миямото Мусаши деп атайтын адам Шибуя қаласының орталығында болды.
Dialogue: 0,0:19:00.93,0:19:05.22,Default,,0,0,0,,Ірі полиция рейдіне қатысты оқиға орын алды.
Dialogue: 0,0:19:05.31,0:19:08.73,Default,,0,0,0,,Бейнебақылау камерасы түсіріп алған.
Dialogue: 0,0:19:08.81,0:19:11.19,Default,,0,0,0,,Ортада жапон киімін киген адам
Dialogue: 0,0:19:11.27,0:19:14.77,Default,,0,0,0,,Мені бес мықты полиция қоршап тұр.
Dialogue: 0,0:19:14.86,0:19:16.36,Default,,0,0,0,,Ер адам жалаң аяқ
Dialogue: 0,0:19:17.15,0:19:19.86,Default,,0,0,0,,Ер адам ақырын қолдарын жайып жібереді.
Dialogue: 0,0:19:19.95,0:19:22.87,Default,,0,0,0,,Артыңыздағы полиция қызметкері секіреді.
Dialogue: 0,0:19:19.95,0:19:22.87,Default,,0,0,0,,(Жаңалықтар: аудио жоқ)
Dialogue: 0,0:19:23.53,0:19:24.87,Default,,0,0,0,,Додж
Dialogue: 0,0:19:24.95,0:19:29.12,Default,,0,0,0,,Алайда полиция қызметкері жақында ғана өтіп бара жатқандай, еңкейіп қалды.
Dialogue: 0,0:19:29.20,0:19:31.37,Default,,0,0,0,,Ақырында ол жұмысын тоқтатады.
Dialogue: 0,0:19:32.25,0:19:33.63,Default,,0,0,0,,Келесі - екінші адам.
Dialogue: 0,0:19:33.71,0:19:36.13,Default,,0,0,0,,Артынан сәтті түсірілді...
Dialogue: 0,0:19:36.75,0:19:38.38,Default,,0,0,0,,Бұл сияқты көрінді
Dialogue: 0,0:19:38.46,0:19:42.13,Default,,0,0,0,,Мен виталымды ұстап, құладым.
Dialogue: 0,0:19:42.76,0:19:44.14,Default,,0,0,0,,Мен таяқшамды алып шықтым.
Dialogue: 0,0:19:44.64,0:19:45.64,Default,,0,0,0,,Түр
Dialogue: 0,0:19:46.22,0:19:47.89,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:19:47.97,0:19:50.89,Default,,0,0,0,,Таяқша адамның қолында.
Dialogue: 0,0:19:51.56,0:19:54.40,Default,,0,0,0,,Бірдеңе болған сияқты, бірақ оны көру өте жылдам болды.
Dialogue: 0,0:19:54.98,0:19:56.94,Default,,0,0,0,,Мен құлап жатырмын. Мен құрысып жатырмын.
Dialogue: 0,0:19:57.02,0:19:58.65,Default,,0,0,0,,2 адам қалды
Dialogue: 0,0:19:59.23,0:20:00.65,Default,,0,0,0,,Мен таяқшамды лақтырып жібердім.
Dialogue: 0,0:20:00.74,0:20:02.65,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:20:03.24,0:20:06.16,Default,,0,0,0,,Мен не болып жатқанын түсінбеймін.
Dialogue: 0,0:20:06.24,0:20:08.37,Default,,0,0,0,,Тарихи драмадағы қылыш тартысқандай.
Dialogue: 0,0:20:08.45,0:20:11.91,Default,,0,0,0,,Жатқан полиция күшіне қарсы шабуылдың белгісі жоқ.
Dialogue: 0,0:20:12.00,0:20:15.42,Default,,0,0,0,,Ер адам ештеңе болмағандай оқиға орнынан кетіп қалады.
Dialogue: 0,0:20:15.50,0:20:18.59,Default,,0,0,0,,Осы күні осы оқиғаның алдында ер адам
Dialogue: 0,0:20:18.67,0:20:22.34,Default,,0,0,0,,Синджуку округінде төрт полиция қызметкері жарақат алды.
Dialogue: 0,0:20:22.42,0:20:26.43,Default,,0,0,0,,Ясакидегі оқиға елордалық полиция департаментінің жоғары дайындықта болуына себеп болды.
Dialogue: 0,0:20:27.30,0:20:31.68,Default,,0,0,0,,Енді, шашы тоқылған мына кісі өзін ежелгі қылыш шебері етіп көрсетеді.
Dialogue: 0,0:20:31.77,0:20:34.44,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:20:34.52,0:20:37.44,Default,,0,0,0,,(шашықтықтағы көліктің дыбысы)
Dialogue: 0,0:20:37.52,0:20:38.61,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:20:38.69,0:20:40.03,Default,,0,0,0,,Елордалық полиция департаменті жағдайды байыппен қабылдады.
Dialogue: 0,0:20:40.03,0:20:41.28,Default,,0,0,0,,Елордалық полиция департаменті жағдайға байыппен қарады.
Dialogue: 0,0:20:40.03,0:20:41.28,Default,,0,0,0,,(Үру)
Dialogue: 0,0:20:41.36,0:20:44.53,Default,,0,0,0,,Біз төтенше жағдай штабын құру және т.б.
Dialogue: 0,0:20:45.03,0:20:47.12,Default,,0,0,0,,Ұйымның беделіне қауіп төндіретін ауқымда
Dialogue: 0,0:20:47.12,0:20:47.66,Default,,0,0,0,,Ұйымның беделіне қауіп төндіретін ауқымда
Dialogue: 0,0:20:47.12,0:20:47.66,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:20:47.66,0:20:47.74,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:20:47.74,0:20:50.45,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:20:47.74,0:20:50.45,Default,,0,0,0,,Олар ер адамды іздеп жатқан сияқты.
Dialogue: 0,0:20:50.54,0:20:51.62,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:20:50.54,0:20:51.62,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:20:51.62,0:20:52.70,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:20:53.29,0:20:54.21,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:20:55.33,0:20:57.17,Default,,0,0,0,,Ата…
Dialogue: 0,0:20:57.25,0:20:59.50,Default,,0,0,0,,Пампака-пан!
Dialogue: 0,0:21:01.38,0:21:03.67,Default,,0,0,0,,Екеуі үнсіз қалды.
Dialogue: 0,0:21:04.88,0:21:07.59,Default,,0,0,0,,Тыныштықты кім бірінші бұзды?
Dialogue: 0,0:21:08.22,0:21:09.60,Default,,0,0,0,,Ол менің әкем болды.
Dialogue: 0,0:21:10.47,0:21:13.35,Default,,0,0,0,,Мен бір нәрсені жіберіп алдым
Dialogue: 0,0:21:14.18,0:21:15.35,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.60,0:21:19.44,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:21:19.94,0:21:21.32,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:21:27.24,0:21:29.12,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:21:30.58,0:21:31.62,Default,,0,0,0,,тым кеш
Dialogue: 0,0:21:32.58,0:21:35.87,Default,,0,0,0,,Сіз бізді жалған деп айтасыз ба?
Dialogue: 0,0:21:37.04,0:21:38.63,Default,,0,0,0,,Сол қозғалыс...
Dialogue: 0,0:21:38.71,0:21:42.46,Default,,0,0,0,,Сен солай айтқан сияқтысың.
Dialogue: 0,0:21:50.01,0:21:53.14,Default,,0,0,0,,Өткен жылғы тәжірибеге шақыру
Dialogue: 0,0:21:54.56,0:21:55.89,Default,,0,0,0,,Мен жауапты алдым
Dialogue: 0,0:21:56.39,0:21:57.64,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:21:58.73,0:22:01.61,Default,,0,0,0,,Соншама?
Dialogue: 0,0:22:03.69,0:22:04.90,Default,,0,0,0,,Баки де
Dialogue: 0,0:22:06.24,0:22:07.40,Default,,0,0,0,,Жалғыз жүру
Dialogue: 0,0:22:08.49,0:22:10.57,Default,,0,0,0,,Шибукава-сенпай да
Dialogue: 0,0:22:11.37,0:22:13.91,Default,,0,0,0,,Жоқ, тіпті огр емес.
Dialogue: 0,0:22:15.58,0:22:18.46,Default,,0,0,0,,Мен қорғауым керек
Dialogue: 0,0:22:21.79,0:22:26.80,Default,,0,0,0,,♪~
Dialogue: 0,0:23:45.17,0:23:50.17,Default,,0,0,0,,~♪
