Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.37,0:00:09.00,Default,,0,0,0,,Бір уыс ұстап, тез жүру керек.
Dialogue: 0,0:00:09.54,0:00:11.57,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:13.86,0:00:15.70,Default,,0,0,0,,Жоқ, бұл жүгірткі
Dialogue: 0,0:00:15.81,0:00:17.16,Default,,0,0,0,,Осы жерден бұрылыңыз...
Dialogue: 0,0:01:50.41,0:01:52.80,Default,,0,0,0,,Манами, жолдасым
Dialogue: 0,0:01:53.36,0:01:56.73,Default,,0,0,0,,Менің Акихабарада үлкен жарылыс жасауға деген амбициям тек жарты жолда орындалды.
Dialogue: 0,0:01:56.73,0:01:58.64,Default,,0,0,0,,Менің ойымша, бұл өте өкінішті болды.
Dialogue: 0,0:01:59.14,0:02:02.69,Default,,0,0,0,,Бірақ сіз қалдырған жұлдызды шаңның жарқын естелігі
Dialogue: 0,0:02:02.69,0:02:04.90,Default,,0,0,0,,Біздің жүрегімізде әлі тірі
Dialogue: 0,0:02:05.30,0:02:06.94,Default,,0,0,0,,Бұл ем дегеніміз не?
Dialogue: 0,0:02:07.28,0:02:09.92,Default,,0,0,0,,Аймиді жерлеу рәсімі сондай лас жерде өтті.
Dialogue: 0,0:02:09.92,0:02:11.43,Default,,0,0,0,,Бірігулердің ортасында
Dialogue: 0,0:02:11.43,0:02:14.23,Default,,0,0,0,,Кедамоноленд тобы да бұл туралы ештеңе істей алмаса керек.
Dialogue: 0,0:02:14.23,0:02:15.06,Default,,0,0,0,,Бірігу?
Dialogue: 0,0:02:15.06,0:02:16.44,Default,,0,0,0,,Біріктіру қайда?
Dialogue: 0,0:02:16.68,0:02:18.12,Default,,0,0,0,,Жануарлардың қолшатырында болу
Dialogue: 0,0:02:18.12,0:02:19.79,Default,,0,0,0,,Мэйдрианның аты өшірілді
Dialogue: 0,0:02:19.79,0:02:21.29,Default,,0,0,0,,Сізді осылай жеп қойдыңыз, солай ма?
Dialogue: 0,0:02:21.43,0:02:23.89,Default,,0,0,0,,Сіз Угаки мырзаның шешімін сынға алғыңыз келе ме?
Dialogue: 0,0:02:23.89,0:02:25.83,Default,,0,0,0,,Тоқта, бұл еске алу кеші.
Dialogue: 0,0:02:26.96,0:02:29.69,Default,,0,0,0,,Аңдар мен жат планеталықтар дос болды
Dialogue: 0,0:02:29.83,0:02:32.16,Default,,0,0,0,,Манами-сан да жұлдызды аспан астында күліп тұрған болуы керек.
Dialogue: 0,0:02:33.54,0:02:35.92,Default,,0,0,0,,Бұл Kedamoland тобынан.
Dialogue: 0,0:02:36.30,0:02:37.51,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:02:37.90,0:02:40.39,Default,,0,0,0,,Мен Maid Cafe Tontokoton менеджері Иә.
Dialogue: 0,0:02:41.17,0:02:42.36,Default,,0,0,0,,Толығырақ?
Dialogue: 0,0:02:45.58,0:02:48.38,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:02:48.38,0:02:51.65,Default,,0,0,0,,Бізге келуге қиналмай келгеніңіз үшін рахмет.
Dialogue: 0,0:02:51.90,0:02:54.33,Default,,0,0,0,,Күтпеген апат салдарынан...
Dialogue: 0,0:02:54.72,0:02:57.08,Default,,0,0,0,,Мен сіздің күшіңізді азайтқыңыз келетініне сенімдімін.
Dialogue: 0,0:02:57.08,0:02:58.09,Default,,0,0,0,,Қай ауыз
Dialogue: 0,0:02:58.09,0:03:01.41,Default,,0,0,0,,Басқыншы бөгде адам ретінде өмір сүргендердің барлығы.
Dialogue: 0,0:03:01.60,0:03:03.57,Default,,0,0,0,,Эгоизмде айырмашылықтар болуы мүмкін.
Dialogue: 0,0:03:03.57,0:03:06.87,Default,,0,0,0,,Егер біз хайуан ағалар ретінде бірдеңе істей аламыз ...
Dialogue: 0,0:03:06.87,0:03:11.02,Default,,0,0,0,,Угаки мырза мен оның достары хайуандық іс-әрекеттерін бастады.
Dialogue: 0,0:03:11.16,0:03:13.55,Default,,0,0,0,,Ол қазірдің өзінде көп сатылуда.
Dialogue: 0,0:03:14.44,0:03:16.28,Default,,0,0,0,,Аксолотль мотиві
Dialogue: 0,0:03:16.42,0:03:19.87,Default,,0,0,0,,Ол «Memory Animal Cafe Woopers» ретінде қайта дүниеге келді.
Dialogue: 0,0:03:20.93,0:03:22.55,Default,,0,0,0,,Аксолотл жануар ма?
Dialogue: 0,0:03:22.66,0:03:23.81,Default,,0,0,0,,Аң болса да
Dialogue: 0,0:03:24.18,0:03:25.44,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:03:26.30,0:03:27.24,Default,,0,0,0,,Өкіл
Dialogue: 0,0:03:35.53,0:03:37.16,Default,,0,0,0,,Осы арқылы фигураны қосыңыз
Dialogue: 0,0:03:38.79,0:03:40.28,Default,,0,0,0,,Жолдастық кездесу?
Dialogue: 0,0:03:40.52,0:03:42.47,Default,,0,0,0,,Бұл өкілдің бұйрығы.
Dialogue: 0,0:03:42.47,0:03:44.84,Default,,0,0,0,,Командалық бейсбол ма?
Dialogue: 0,0:03:44.84,0:03:46.67,Default,,0,0,0,,Жеке өту қиын
Dialogue: 0,0:03:46.67,0:03:49.75,Default,,0,0,0,,Бірін-бірі өлтіріп жатқан жігіттермен бейсбол ойыны өте күлкілі болар еді.
Dialogue: 0,0:03:50.03,0:03:50.86,Default,,0,0,0,,Жасайық
Dialogue: 0,0:03:51.11,0:03:53.21,Default,,0,0,0,,Өткен күндердің өкініштерін төгу
Dialogue: 0,0:03:53.47,0:03:56.30,Default,,0,0,0,,Қызметші ретінде мұндай бейбіт шешім жоқ.
Dialogue: 0,0:03:56.43,0:03:58.74,Default,,0,0,0,,Менің ойымша, мұндай нәрселер қауіпсіз аяқталады.
Dialogue: 0,0:03:58.74,0:04:00.06,Default,,0,0,0,,Оны аяқтаңыз.
Dialogue: 0,0:04:00.21,0:04:01.74,Default,,0,0,0,,Ақ допты бірге қуу
Dialogue: 0,0:04:01.74,0:04:03.27,Default,,0,0,0,,Татуласамыз.
Dialogue: 0,0:04:03.27,0:04:05.66,Default,,0,0,0,,Дұрыс, тек пішіні жақсы.
Dialogue: 0,0:04:05.66,0:04:08.21,Default,,0,0,0,,Жоқ, егер біз мұны орындайтын болсақ, біз міндетті түрде жеңеміз.
Dialogue: 0,0:04:08.21,0:04:09.65,Default,,0,0,0,,Үлкен мотивация
Dialogue: 0,0:04:09.65,0:04:12.71,Default,,0,0,0,,Бірақ жеті адам бейсбол ойнай алады ма?
Dialogue: 0,0:04:24.54,0:04:26.70,Default,,0,0,0,,Алдыңғы тартыста шашырап кеткендерге
Dialogue: 0,0:04:27.18,0:04:27.79,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:04:30.62,0:04:32.53,Default,,0,0,0,,Нерула-чан, қараңызшы.
Dialogue: 0,0:04:32.96,0:04:35.77,Default,,0,0,0,,Бұл матчта жақсы араласатынымызға сенімдімін.
Dialogue: 0,0:04:37.89,0:04:39.68,Default,,0,0,0,,Үнсіз дұға емес пе?
Dialogue: 0,0:04:40.07,0:04:42.58,Default,,0,0,0,,Менің ойымша, бейсбол енді жақсы емес.
Dialogue: 0,0:04:42.58,0:04:44.13,Default,,0,0,0,,Ойын қосылды.
Dialogue: 0,0:04:44.13,0:04:45.74,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:45.74,0:04:47.08,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:04:47.08,0:04:49.85,Default,,0,0,0,,Сіз шетелдіктерден бас тарттыңыз және Вупи Лупи болдыңыз.
Dialogue: 0,0:04:49.85,0:04:51.29,Default,,0,0,0,,Бұл аксолотль
Dialogue: 0,0:04:51.29,0:04:53.21,Default,,0,0,0,,Төменгі жақтағылар ығысып кетпесін.
Dialogue: 0,0:04:53.82,0:04:54.59,Default,,0,0,0,,Йосе
Dialogue: 0,0:04:54.82,0:04:57.49,Default,,0,0,0,,Мұнда да төменнен жоғары қарай күрес бар.
Dialogue: 0,0:04:57.49,0:04:58.64,Default,,0,0,0,,Төменгі?
Dialogue: 0,0:04:58.64,0:05:01.62,Default,,0,0,0,,Жоқ, айуанның жүгі деп күлсе де.
Dialogue: 0,0:05:01.62,0:05:04.27,Default,,0,0,0,,Мен сіздің немқұрайлы көзқарасыңызға тәнтімін.
Dialogue: 0,0:05:04.74,0:05:06.79,Default,,0,0,0,,Қане, көңіл көтерейік.
Dialogue: 0,0:05:07.02,0:05:10.42,Default,,0,0,0,,Бұл сондай-ақ барлығына әке мен әке болуға арналған мерекелік ойын.
Dialogue: 0,0:05:10.85,0:05:12.25,Default,,0,0,0,,Бұл жүнді жұмсарту болды ма?
Dialogue: 0,0:05:13.09,0:05:16.25,Default,,0,0,0,,Иә, бейсболда ақ-қара түсті киіңіз.
Dialogue: 0,0:05:16.54,0:05:19.31,Default,,0,0,0,,үшінмыз, әділ, шаршы алаңда күресейік.
Dialogue: 0,0:05:19.76,0:05:23.50,Default,,0,0,0,,Ей, мен сені құртамын, қарғыс атқыр шошқа.
Dialogue: 0,0:05:25.60,0:05:27.63,Default,,0,0,0,,Жануардың мінезін өзгертті
Dialogue: 0,0:05:27.85,0:05:30.37,Default,,0,0,0,,Жат жердегі намысымды таптады.
Dialogue: 0,0:05:30.74,0:05:32.94,Default,,0,0,0,,Мен сіздің ренішіңізді түсінемін.
Dialogue: 0,0:05:33.24,0:05:34.62,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,0:05:34.83,0:05:37.86,Default,,0,0,0,,Оларға сыныптағы айырмашылықты көрсетіңіз.
Dialogue: 0,0:05:38.06,0:05:39.75,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,0:05:39.75,0:05:40.36,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:05:40.58,0:05:42.33,Default,,0,0,0,,Аңның жүгі кім?
Dialogue: 0,0:05:42.52,0:05:44.02,Default,,0,0,0,,Сіз өзіңізге ұнайтын кез келген әдісті пайдалана аласыз
Dialogue: 0,0:05:44.02,0:05:45.26,Default,,0,0,0,,Оларды жойыңыз
Dialogue: 0,0:05:45.26,0:05:45.99,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:05:46.25,0:05:47.81,Default,,0,0,0,,Дөрекі ойнауға қатаң тыйым салынады
Dialogue: 0,0:05:48.26,0:05:51.04,Default,,0,0,0,,Менеджер: Біз бейсболды әділ және шаршы ойнау арқылы жеңеміз.
Dialogue: 0,0:05:51.27,0:05:53.96,Default,,0,0,0,,Нерула-чан мен басқалардың құрбандықтары зая кетпес үшін.
Dialogue: 0,0:05:54.13,0:05:56.25,Default,,0,0,0,,Бұл жерде зорлық-зомбылыққа сенуге болмайды.
Dialogue: 0,0:05:56.61,0:05:58.63,Default,,0,0,0,,Әділ күресте мән бар.
Dialogue: 0,0:05:58.98,0:05:59.92,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:06:06.97,0:06:07.60,Default,,0,0,0,,Екінші
Dialogue: 0,0:06:08.66,0:06:09.39,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:06:10.02,0:06:11.31,Default,,0,0,0,,Юмэчи Шипон
Dialogue: 0,0:06:11.52,0:06:12.89,Default,,0,0,0,,Дауыстап сөйлеңіз
Dialogue: 0,0:06:13.10,0:06:14.89,Default,,0,0,0,,Барған сайын тітіркендіреді.
Dialogue: 0,0:06:15.06,0:06:15.78,Default,,0,0,0,,Бірінші
Dialogue: 0,0:06:17.13,0:06:17.72,Default,,0,0,0,,Үшінші
Dialogue: 0,0:06:18.96,0:06:20.14,Default,,0,0,0,,Иә қадам
Dialogue: 0,0:06:20.62,0:06:22.42,Default,,0,0,0,,Ей, дала, айғайла.
Dialogue: 0,0:06:22.42,0:06:23.07,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:23.21,0:06:25.82,Default,,0,0,0,,Хола
Dialogue: 0,0:06:26.12,0:06:26.56,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:06:27.07,0:06:29.90,Default,,0,0,0,,Дүкен менеджері бір венесуэлалықты іздеді.
Dialogue: 0,0:06:30.30,0:06:32.83,Default,,0,0,0,,Зоя бір-бірін түсіне алмайтындарын айтты.
Dialogue: 0,0:06:33.51,0:06:34.29,Default,,0,0,0,,Доп ойнау
Dialogue: 0,0:06:41.09,0:06:42.76,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:06:43.20,0:06:44.16,Default,,0,0,0,,Ол жанып тұр
Dialogue: 0,0:06:44.80,0:06:47.57,Default,,0,0,0,,Касуми Манами-санды жақсы көретін.
Dialogue: 0,0:06:51.31,0:06:54.71,Default,,0,0,0,,Мен саған допты жеткіземін, Айми-сан.
Dialogue: 0,0:07:06.32,0:07:07.28,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:07:07.47,0:07:09.00,Default,,0,0,0,,Доп жүгіріп келеді
Dialogue: 0,0:07:09.00,0:07:10.30,Default,,0,0,0,,Салқын, салқын
Dialogue: 0,0:07:10.89,0:07:11.78,Default,,0,0,0,,Бұл туралы сен бәрінен жақсы білуің керек
Dialogue: 0,0:07:21.40,0:07:23.51,Default,,0,0,0,,Тезірек шошқаларды бағындыр.
Dialogue: 0,0:07:27.39,0:07:29.55,Default,,0,0,0,,Құмыраның иығы жылы емес
Dialogue: 0,0:07:29.55,0:07:31.07,Default,,0,0,0,,Бірінші тон тәтті түседі.
Dialogue: 0,0:07:31.07,0:07:32.62,Default,,0,0,0,,Әрқашан бірінші қадам үшін жарғанақты тербеңіз.
Dialogue: 0,0:07:33.19,0:07:34.56,Default,,0,0,0,,Бондман, мұндай қалай болды?
Dialogue: 0,0:07:37.31,0:07:38.73,Default,,0,0,0,,Құдай-ау, дұрыс түсіндім.
Dialogue: 0,0:07:39.64,0:07:40.77,Default,,0,0,0,,Керемет соққы
Dialogue: 0,0:07:41.11,0:07:43.08,Default,,0,0,0,,Құмыраның тұруы нашар.
Dialogue: 0,0:07:43.08,0:07:44.07,Default,,0,0,0,,Мүмкіндік
Dialogue: 0,0:07:49.01,0:07:49.36,Default,,0,0,0,,Мен
Dialogue: 0,0:07:49.36,0:07:50.74,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:07:52.18,0:07:52.87,Default,,0,0,0,,Біраз
Dialogue: 0,0:07:52.87,0:07:54.08,Default,,0,0,0,,Табыс табу
Dialogue: 0,0:07:54.27,0:07:55.37,Default,,0,0,0,,Жақсы, Юмэчи
Dialogue: 0,0:07:56.33,0:07:58.56,Default,,0,0,0,,Неліктен сіз негізсізсіз?
Dialogue: 0,0:07:58.56,0:08:00.31,Default,,0,0,0,,Лилия Лилия
Dialogue: 0,0:08:00.31,0:08:01.60,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:08:01.80,0:08:03.46,Default,,0,0,0,,Мен шынымен жүгіргім келмейді
Dialogue: 0,0:08:12.89,0:08:13.94,Default,,0,0,0,,Ақырында
Dialogue: 0,0:08:20.14,0:08:21.77,Default,,0,0,0,,Бейсбол тәжірибесі бар ма?
Dialogue: 0,0:08:22.20,0:08:24.14,Default,,0,0,0,,Аздап қоршау ішінде
Dialogue: 0,0:08:25.11,0:08:25.99,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:08:26.50,0:08:27.15,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:08:27.57,0:08:29.70,Default,,0,0,0,,Қамыр Шайқамасаңыз, соқпайды.
Dialogue: 0,0:08:30.04,0:08:31.01,Default,,0,0,0,,Менің айтып тұрғаным осы.
Dialogue: 0,0:08:32.14,0:08:32.94,Default,,0,0,0,,Шайқаймыз
Dialogue: 0,0:08:42.19,0:08:43.29,Default,,0,0,0,,Үйге қайту
Dialogue: 0,0:08:43.51,0:08:44.90,Default,,0,0,0,,Үйге қайту
Dialogue: 0,0:08:47.34,0:08:50.56,Default,,0,0,0,,Әңгімелейтін ештеңе жоқ. Қосмекенділер.
Dialogue: 0,0:08:51.45,0:08:53.18,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:08:54.51,0:08:56.72,Default,,0,0,0,,Мен софтбол ойнадым.
Dialogue: 0,0:08:58.83,0:08:59.81,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:09:00.76,0:09:01.88,Default,,0,0,0,,Соғудың уақыты келгенде
Dialogue: 0,0:09:04.43,0:09:06.23,Default,,0,0,0,,Қамырды тастаңыз
Dialogue: 0,0:09:07.23,0:09:08.49,Default,,0,0,0,,Уақыт дұрыс
Dialogue: 0,0:09:09.73,0:09:10.91,Default,,0,0,0,,Дон Май Дон Май
Dialogue: 0,0:09:10.91,0:09:12.37,Default,,0,0,0,,Ауысайық
Dialogue: 0,0:09:17.68,0:09:20.18,Default,,0,0,0,,Жарайды, қосмекенділерді талқанда.
Dialogue: 0,0:09:20.18,0:09:21.92,Default,,0,0,0,,Құпия қару
Dialogue: 0,0:09:22.28,0:09:23.82,Default,,0,0,0,,Өлетіндей ұстаңыз.
Dialogue: 0,0:09:28.69,0:09:29.07,Default,,0,0,0,,Сұлу…
Dialogue: 0,0:09:30.86,0:09:31.86,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:09:32.19,0:09:33.09,Default,,0,0,0,,¡На guará!
Dialogue: 0,0:09:36.07,0:09:36.93,Default,,0,0,0,,Қамыр бітеді
Dialogue: 0,0:09:38.02,0:09:40.37,Default,,0,0,0,,Венесуэла - бейсболдың қуатты орталығы, солай ма?
Dialogue: 0,0:09:40.74,0:09:42.67,Default,,0,0,0,,Бұл қандай адамдар?
Dialogue: 0,0:09:44.23,0:09:46.70,Default,,0,0,0,,Электр Таунға фотоаппарат сатып алуға келген халықаралық студент
Dialogue: 0,0:09:49.32,0:09:51.40,Default,,0,0,0,,Бейсбол ойыны аяқталды.
Dialogue: 0,0:09:52.30,0:09:53.77,Default,,0,0,0,,Оларды ұсақтаңыз
Dialogue: 0,0:09:55.30,0:09:56.41,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:09:57.09,0:10:00.41,Default,,0,0,0,,Енді нағыз ойын басталады.
Dialogue: 0,0:10:06.82,0:10:07.67,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:10:07.96,0:10:08.99,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:10:08.99,0:10:11.11,Default,,0,0,0,,Мен қамырды көре алмаймын. Мен оны көре алмаймын.
Dialogue: 0,0:10:12.31,0:10:13.56,Default,,0,0,0,,Мен болжаймын.
Dialogue: 0,0:10:25.36,0:10:26.29,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:10:27.47,0:10:28.32,Default,,0,0,0,,Нагоми
Dialogue: 0,0:10:28.54,0:10:30.19,Default,,0,0,0,,Нагоми-сан, жақсысың ба?
Dialogue: 0,0:10:30.41,0:10:31.82,Default,,0,0,0,,Жедел жәрдемнің менеджері
Dialogue: 0,0:10:32.24,0:10:33.07,Default,,0,0,0,,Жедел жәрдем?
Dialogue: 0,0:10:33.42,0:10:36.53,Default,,0,0,0,,Бұл асыра сілтеу. Бұл аз ғана соққы.
Dialogue: 0,0:10:37.86,0:10:38.59,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:39.18,0:10:39.83,Default,,0,0,0,,Теме
Dialogue: 0,0:10:40.60,0:10:42.22,Default,,0,0,0,,Сен бірінші орындадың.
Dialogue: 0,0:10:42.22,0:10:42.96,Default,,0,0,0,,Нандкора
Dialogue: 0,0:10:42.96,0:10:44.00,Default,,0,0,0,,Мен жақсы уақыт өткіземін.
Dialogue: 0,0:10:44.17,0:10:44.86,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:45.16,0:10:46.49,Default,,0,0,0,,Зорлық-зомбылық жоқ
Dialogue: 0,0:10:48.08,0:10:49.72,Default,,0,0,0,,Бұл... бұл соққы интерференциясы.
Dialogue: 0,0:10:50.09,0:10:51.72,Default,,0,0,0,,Мен еңкейдім.
Dialogue: 0,0:10:53.50,0:10:54.36,Default,,0,0,0,,Соққы кедергісі
Dialogue: 0,0:10:54.50,0:10:55.41,Default,,0,0,0,,Бірінші негізде жүгіруші
Dialogue: 0,0:10:55.41,0:10:57.89,Default,,0,0,0,,Неліктен Паппапарапа жаман?
Dialogue: 0,0:10:58.18,0:10:59.94,Default,,0,0,0,,Менің ойымша, сізге үзіліс жасау керек.
Dialogue: 0,0:11:01.13,0:11:03.08,Default,,0,0,0,,Мен бұл матчты аяқтағым келеді.
Dialogue: 0,0:11:06.69,0:11:09.11,Default,,0,0,0,,Жүр, көңілімізді көтерейік
Dialogue: 0,0:11:17.90,0:11:18.83,Default,,0,0,0,,Юмэчи-сан
Dialogue: 0,0:11:19.36,0:11:20.92,Default,,0,0,0,,Жаңа ғана түртті
Dialogue: 0,0:11:20.92,0:11:22.83,Default,,0,0,0,,Түртіп алу дегеніміз не?
Dialogue: 0,0:11:25.83,0:11:26.82,Default,,0,0,0,,Жою
Dialogue: 0,0:11:26.82,0:11:28.33,Default,,0,0,0,,үшінн құрту
Dialogue: 0,0:11:28.60,0:11:29.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:30.02,0:11:31.95,Default,,0,0,0,,Неліктен зорлық қолданасыз?
Dialogue: 0,0:11:32.65,0:11:35.01,Default,,0,0,0,,Бұл менің ең жақсы нұсқауым
Dialogue: 0,0:11:36.29,0:11:37.37,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:11:37.59,0:11:38.85,Default,,0,0,0,,Бұл бейсбол емес.
Dialogue: 0,0:11:39.09,0:11:41.00,Default,,0,0,0,,Тек Нагоми бейсбол ойнайды.
Dialogue: 0,0:11:41.27,0:11:43.45,Default,,0,0,0,,Сонда барлығы не істеп жатыр?
Dialogue: 0,0:11:43.94,0:11:44.77,Default,,0,0,0,,Бұл қызметші.
Dialogue: 0,0:11:55.65,0:11:56.28,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:11:56.28,0:11:57.65,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:58.05,0:11:59.66,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:12:00.74,0:12:02.20,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:12:02.86,0:12:05.07,Default,,0,0,0,,Бейсболда жеңіске жету керек.
Dialogue: 0,0:12:06.66,0:12:08.15,Default,,0,0,0,,Жарайды, кері.
Dialogue: 0,0:12:08.26,0:12:10.17,Default,,0,0,0,,Мен сізге тағы бір ұпай беремін.
Dialogue: 0,0:12:10.48,0:12:13.18,Default,,0,0,0,,Әй, сен де бір-екі адамды басу керек.
Dialogue: 0,0:12:13.38,0:12:14.01,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.33,0:12:16.27,Default,,0,0,0,,Олар міндетті түрде сенен кейін келеді.
Dialogue: 0,0:12:16.27,0:12:17.63,Default,,0,0,0,,Мен кез келген уақытта барамын
Dialogue: 0,0:12:24.30,0:12:27.11,Default,,0,0,0,,Бір уысыңызды қысқа ұстап, тез жүру керек.
Dialogue: 0,0:12:27.58,0:12:29.60,Default,,0,0,0,,Жоқ, керісінше
Dialogue: 0,0:12:32.70,0:12:34.57,Default,,0,0,0,,Жоқ, бұл жүгірткі
Dialogue: 0,0:12:34.72,0:12:35.90,Default,,0,0,0,,Осы жерден бұрылыңыз...
Dialogue: 0,0:12:37.18,0:12:37.95,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:12:37.95,0:12:38.91,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:12:39.19,0:12:39.96,Default,,0,0,0,,Дафу...
Dialogue: 0,0:12:40.06,0:12:41.41,Default,,0,0,0,,(Жануарлар дүкенінің сатушысы) Хмм… Таныс итті өсірушімнен сұрайын ба?
Dialogue: 0,0:12:42.06,0:12:43.41,Default,,0,0,0,,Оны негізге сілкіңіз
Dialogue: 0,0:12:43.64,0:12:44.86,Default,,0,0,0,,Келесі
Dialogue: 0,0:12:46.18,0:12:48.94,Default,,0,0,0,,Осы қарқынмен қанша өмір сүрсең де, бұл жеткіліксіз.
Dialogue: 0,0:12:49.92,0:12:50.87,Default,,0,0,0,,Әрі қарай, Эрен
Dialogue: 0,0:12:52.18,0:12:55.74,Default,,0,0,0,,Лилия Лилия…
Dialogue: 0,0:12:56.84,0:12:57.59,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:12:57.71,0:12:59.29,Default,,0,0,0,,Үш жақты өзгерту
Dialogue: 0,0:12:59.81,0:13:01.17,Default,,0,0,0,,Бүктейміз
Dialogue: 0,0:13:01.30,0:13:03.29,Default,,0,0,0,,Олардың әрқайсысын ұсақтаңыз.
Dialogue: 0,0:13:03.29,0:13:03.74,Default,,0,0,0,,Иә
Dialogue: 0,0:13:03.90,0:13:06.15,Default,,0,0,0,,Мына екеуі тыңдап тұр ма?
Dialogue: 0,0:13:06.33,0:13:08.73,Default,,0,0,0,,Әділ күресетін адамдар бар.
Dialogue: 0,0:13:09.55,0:13:11.69,Default,,0,0,0,,Әділ күресетін адамдар бар.
Dialogue: 0,0:13:11.95,0:13:14.51,Default,,0,0,0,,Балалар сендер маған шабуыл жасайсыңдар ма?
Dialogue: 0,0:13:14.51,0:13:16.25,Default,,0,0,0,,Әділ күресіп жатқан жігіт...
Dialogue: 0,0:13:16.25,0:13:17.96,Default,,0,0,0,,Жәрмеңке шулы, балалар.
Dialogue: 0,0:13:18.90,0:13:20.38,Default,,0,0,0,,...
Dialogue: 0,0:13:20.58,0:13:21.53,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:13:23.23,0:13:24.78,Default,,0,0,0,,ешкімге достықты мәжбүрлеп таңушы емеспін.
Dialogue: 0,0:13:25.66,0:13:26.91,Default,,0,0,0,,Эй гора
Dialogue: 0,0:13:27.07,0:13:29.62,Default,,0,0,0,,Не, Арашикоға әділ ойын?
Dialogue: 0,0:13:29.62,0:13:32.11,Default,,0,0,0,,Күңші екен деп сынаса, бітті.
Dialogue: 0,0:13:32.11,0:13:34.79,Default,,0,0,0,,Жауды арандату нәтижесіз.
Dialogue: 0,0:13:35.22,0:13:36.04,Default,,0,0,0,,Бедеу ме?
Dialogue: 0,0:13:36.04,0:13:38.16,Default,,0,0,0,,Упапаупаупа
Dialogue: 0,0:13:38.16,0:13:41.68,Default,,0,0,0,,Аяқ-қолдары өспей қалғанша, мен оны туралай беруім керек пе?
Dialogue: 0,0:13:41.68,0:13:44.21,Default,,0,0,0,,Үніңді жап, түбі жоқ шошқа.
Dialogue: 0,0:13:43.63,0:13:44.64,Default,,0,0,0,,Бұл бедеу.
Dialogue: 0,0:13:50.27,0:13:51.11,Default,,0,0,0,,Шипон
Dialogue: 0,0:13:51.11,0:13:51.77,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:13:52.49,0:13:53.15,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:13:54.28,0:13:56.43,Default,,0,0,0,,Юмэчи-сан Шипон-сан
Dialogue: 0,0:13:57.05,0:13:59.59,Default,,0,0,0,,Мен оның тез біткенін қалаймын
Dialogue: 0,0:13:59.59,0:14:01.41,Default,,0,0,0,,Тез тазалаңыз.
Dialogue: 0,0:14:01.99,0:14:03.10,Default,,0,0,0,,Балалар
Dialogue: 0,0:14:03.23,0:14:06.33,Default,,0,0,0,,Осындай жақын шайқаста ұялмайсың ба?
Dialogue: 0,0:14:07.55,0:14:08.76,Default,,0,0,0,,Уақыт
Dialogue: 0,0:14:09.99,0:14:11.60,Default,,0,0,0,,Бұл қашаннан бері?
Dialogue: 0,0:14:11.60,0:14:13.12,Default,,0,0,0,,Тырнақтарыңыз сынған.
Dialogue: 0,0:14:13.73,0:14:15.40,Default,,0,0,0,,Бәрін жұлып алсаңыз, лақтыра аласыз.
Dialogue: 0,0:14:15.63,0:14:16.97,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:17.13,0:14:18.92,Default,,0,0,0,,Дәлірек айтсақ, құмыра не істеу керек?
Dialogue: 0,0:14:20.33,0:14:21.65,Default,,0,0,0,,Мен оны өзім лақтырамын.
Dialogue: 0,0:14:22.14,0:14:23.01,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:14:23.27,0:14:24.67,Default,,0,0,0,,Бірақ мен әлі де жарақат алдым...
Dialogue: 0,0:14:24.90,0:14:25.71,Default,,0,0,0,,Мен бара аламын.
Dialogue: 0,0:14:27.99,0:14:28.88,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:14:30.08,0:14:32.32,Default,,0,0,0,,Арашико-сан өтінемін квадрат
Dialogue: 0,0:14:34.88,0:14:36.69,Default,,0,0,0,,үшінмыз, міндетті түрде жеңейік.
Dialogue: 0,0:14:36.96,0:14:38.01,Default,,0,0,0,,Мұқият
Dialogue: 0,0:14:38.01,0:14:40.47,Default,,0,0,0,,Боо…
Dialogue: 0,0:14:40.47,0:14:41.29,Default,,0,0,0,,Тонтон
Dialogue: 0,0:14:41.43,0:14:44.72,Default,,0,0,0,,Шошқа күйсе, азу тістерін жалаңаштады, Боо.
Dialogue: 0,0:14:45.16,0:14:46.87,Default,,0,0,0,,Жарайды, Касуми.
Dialogue: 0,0:14:46.87,0:14:48.79,Default,,0,0,0,,Кез келген әдіспен базаға тұрыңыз.
Dialogue: 0,0:14:48.96,0:14:51.04,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба?
Dialogue: 0,0:14:51.04,0:14:52.05,Default,,0,0,0,,Сәлем Касуми
Dialogue: 0,0:14:51.57,0:14:53.23,Default,,0,0,0,,Мен сені осылай атаймын.
Dialogue: 0,0:14:53.57,0:14:56.17,Default,,0,0,0,,Мен сендерді өз күшіммен жеңемін.
Dialogue: 0,0:14:57.57,0:14:58.40,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:15:05.05,0:15:05.86,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:15:10.33,0:15:11.21,Default,,0,0,0,,Қамыр бітеді
Dialogue: 0,0:15:11.82,0:15:12.59,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:14.13,0:15:17.45,Default,,0,0,0,,Бұлай жалғаса берсе, мен төменгі жақтағы шошқалардан жеңілемін.
Dialogue: 0,0:15:17.73,0:15:19.32,Default,,0,0,0,,Бетімізден айырылдық.
Dialogue: 0,0:15:19.32,0:15:21.53,Default,,0,0,0,,Төреші Пинч мені ұрды
Dialogue: 0,0:15:22.15,0:15:23.33,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:15:25.23,0:15:27.25,Default,,0,0,0,,Осылай аяқталуы керек пе?
Dialogue: 0,0:15:27.95,0:15:31.26,Default,,0,0,0,,Мен Maidrian Group компаниясының өкілімін.
Dialogue: 0,0:15:31.50,0:15:33.19,Default,,0,0,0,,Мен шошқа сияқты...
Dialogue: 0,0:15:33.50,0:15:34.53,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:35.50,0:15:36.46,Default,,0,0,0,,Ереуіл
Dialogue: 0,0:15:42.72,0:15:44.51,Default,,0,0,0,,Я тебя в пирожки закатаю!
Dialogue: 0,0:15:44.79,0:15:45.94,Default,,0,0,0,,Теме
Dialogue: 0,0:15:46.24,0:15:47.97,Default,,0,0,0,,Блять сені, бейбақ.
Dialogue: 0,0:15:48.15,0:15:50.13,Default,,0,0,0,,Бұл жігіттер соңына дейін
Dialogue: 0,0:15:50.63,0:15:52.97,Default,,0,0,0,,Тоқтаңдар, бәрің, араласпаңдар.
Dialogue: 0,0:15:54.28,0:15:55.20,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:16:00.72,0:16:02.90,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:07.27,0:16:09.32,Default,,0,0,0,,Мен жасадым, Айми-сан.
Dialogue: 0,0:16:09.32,0:16:11.51,Default,,0,0,0,,Мияби
Dialogue: 0,0:16:12.26,0:16:13.03,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:16.39,0:16:18.75,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:16:28.00,0:16:29.90,Default,,0,0,0,,Ра... Арашико-сан жедел жәрдем
Dialogue: 0,0:16:34.32,0:16:36.89,Default,,0,0,0,,Неліктен, неге бұлай?
Dialogue: 0,0:16:37.48,0:16:39.08,Default,,0,0,0,,Мен сіріңке ойнағым келді.
Dialogue: 0,0:16:39.50,0:16:42.45,Default,,0,0,0,,Бейсболды қан төкпей дұрыс ойнағым келді.
Dialogue: 0,0:16:47.81,0:16:50.06,Default,,0,0,0,,Күтілгендей, өлім болды...
Dialogue: 0,0:16:50.06,0:16:51.15,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:16:52.28,0:16:53.76,Default,,0,0,0,,Не айттыңыз...
Dialogue: 0,0:16:53.76,0:16:55.28,Default,,0,0,0,,Дұрыс, мен өлген жоқпын.
Dialogue: 0,0:16:55.35,0:16:56.04,Default,,0,0,0,,Эй
Dialogue: 0,0:16:56.31,0:16:57.25,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:16:57.25,0:16:58.54,Default,,0,0,0,,Оның өлгеніне жол жоқ
Dialogue: 0,0:16:58.70,0:17:01.09,Default,,0,0,0,,Угаки мырза, орындыққа қайта оралайық.
Dialogue: 0,0:17:01.09,0:17:03.21,Default,,0,0,0,,Жүр, кеттік, Вупер-кун.
Dialogue: 0,0:17:03.96,0:17:05.08,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:17:05.30,0:17:07.29,Default,,0,0,0,,Иә, өйткені мен осылай дедім.
Dialogue: 0,0:17:07.48,0:17:09.95,Default,,0,0,0,,Ия, ойынды жалғастыруға болады.
Dialogue: 0,0:17:09.95,0:17:12.35,Default,,0,0,0,,О, сен Ониажға барғың келе ме?
Dialogue: 0,0:17:12.84,0:17:14.56,Default,,0,0,0,,Олай болса, тез қайта бастаймыз.
Dialogue: 0,0:17:14.63,0:17:16.05,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:17:19.91,0:17:22.89,Default,,0,0,0,,Бұл режиссердің рухы зор.
Dialogue: 0,0:17:23.12,0:17:25.13,Default,,0,0,0,,Мен бұрышты өзгерткеніңізді қалаймын.
Dialogue: 0,0:17:26.52,0:17:27.14,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:17:27.65,0:17:30.08,Default,,0,0,0,,Иә, осы матчты аяқтаймыз.
Dialogue: 0,0:17:30.46,0:17:32.07,Default,,0,0,0,,Екіден екі шықты
Dialogue: 0,0:17:37.86,0:17:38.74,Default,,0,0,0,,Өлі доп
Dialogue: 0,0:17:38.89,0:17:40.46,Default,,0,0,0,,Сенің мысың лас.
Dialogue: 0,0:17:40.63,0:17:41.67,Default,,0,0,0,,Шулы
Dialogue: 0,0:17:41.77,0:17:43.17,Default,,0,0,0,,Мені қос, Элле.
Dialogue: 0,0:17:44.79,0:17:46.24,Default,,0,0,0,,Әртүрлі заттар болды.
Dialogue: 0,0:17:46.46,0:17:47.85,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:17:48.22,0:17:50.76,Default,,0,0,0,,Вуперстегі адамдар да байсалды болды.
Dialogue: 0,0:17:51.17,0:17:54.52,Default,,0,0,0,,Біз керемет нәрсеге қол жеткізуге тырысатынымызға сенімдімін.
Dialogue: 0,0:17:54.88,0:17:56.25,Default,,0,0,0,,Сөзсіз жеңіске жетейік
Dialogue: 0,0:17:56.54,0:17:57.40,Default,,0,0,0,,Мұқият
Dialogue: 0,0:17:57.53,0:17:59.27,Default,,0,0,0,,Мұқият
Dialogue: 0,0:18:15.06,0:18:16.17,Default,,0,0,0,,Жақсы доп.
Dialogue: 0,0:18:18.12,0:18:18.81,Default,,0,0,0,,Элле мырза
Dialogue: 0,0:18:19.16,0:18:21.54,Default,,0,0,0,,Біздің ниетімізді көрсетіңіз
Dialogue: 0,0:18:21.80,0:18:31.55,Default,,0,0,0,,Kattobase Айқай...
Dialogue: 0,0:18:31.89,0:18:34.07,Default,,0,0,0,,Кешіріңіз, бірақ мен жеңіле алмаймын.
Dialogue: 0,0:18:34.85,0:18:36.42,Default,,0,0,0,,Біз де ұтыла алмаймыз
Dialogue: 0,0:18:37.07,0:18:40.95,Default,,0,0,0,,Бұл матчтан тыс қызметшілер үшін болашақ болуы керек.
Dialogue: 0,0:18:43.87,0:18:45.18,Default,,0,0,0,,Анықталған
Dialogue: 0,0:18:54.35,0:18:55.35,Default,,0,0,0,,Қамыр бітеді
Dialogue: 0,0:18:55.89,0:18:56.76,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:18:57.52,0:18:58.20,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:59.84,0:19:01.58,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:19:01.58,0:19:02.97,Default,,0,0,0,,Шаа
Dialogue: 0,0:19:08.83,0:19:11.49,Default,,0,0,0,,Қарғыс атсын мына шошқаларды.
Dialogue: 0,0:19:11.60,0:19:13.16,Default,,0,0,0,,А, мен жеңілдім.
Dialogue: 0,0:19:13.60,0:19:14.20,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:15.18,0:19:16.57,Default,,0,0,0,,Бұл жақсы сәйкестік болды.
Dialogue: 0,0:19:52.19,0:19:56.01,Default,,0,0,0,,Нерула-чан, біз жақсы ойын ойнадық.
Dialogue: 0,0:20:02.34,0:20:03.77,Default,,0,0,0,,Арашико кәрі
Dialogue: 0,0:20:05.55,0:20:06.32,Default,,0,0,0,,Узуко-сан
Dialogue: 0,0:20:06.89,0:20:08.05,Default,,0,0,0,,Сіз оны тірі қалдырдыңыз.
Dialogue: 0,0:20:08.52,0:20:09.87,Default,,0,0,0,,Рұқсатсыз өлтірмеңіз
Dialogue: 0,0:20:10.51,0:20:12.67,Default,,0,0,0,,Мен оны іздедім, бірақ таба алмадым.
Dialogue: 0,0:20:13.30,0:20:16.52,Default,,0,0,0,,Арашико Мен Акихабара шыңына жеттім.
Dialogue: 0,0:20:17.10,0:20:18.78,Default,,0,0,0,,Менің қазіргі атым Наги.
Dialogue: 0,0:20:19.12,0:20:19.81,Default,,0,0,0,,Наги?
Dialogue: 0,0:20:20.40,0:20:22.05,Default,,0,0,0,,...
Dialogue: 0,0:20:22.51,0:20:25.61,Default,,0,0,0,,Аа, егер Мичио-сан мені қазір көрсе,
Dialogue: 0,0:20:25.83,0:20:27.37,Default,,0,0,0,,Сіз не айтар едіңіз?
Dialogue: 0,0:20:28.85,0:20:30.12,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:30.67,0:20:32.59,Default,,0,0,0,,Өзім үшін, Мичио...
Dialogue: 0,0:20:32.81,0:20:36.26,Default,,0,0,0,,Осы оқиға болмай тұрып, мылтықты қолыма алсам ғой.
Dialogue: 0,0:20:37.82,0:20:41.07,Default,,0,0,0,,Мен Мэйдрианның қызыл жарғанақ әйелін өлтірген жоқпын.
Dialogue: 0,0:20:41.75,0:20:42.52,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:43.48,0:20:45.88,Default,,0,0,0,,Сол тәтті Мичионы өлтірді.
Dialogue: 0,0:20:47.32,0:20:50.14,Default,,0,0,0,,Бұл қол тек кетчуппен сурет салуға арналған ба?
Dialogue: 0,0:20:50.71,0:20:51.61,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:20:55.43,0:20:57.74,Default,,0,0,0,,Арашико-сан, жиналыс басталады.
Dialogue: 0,0:20:58.24,0:20:58.73,Default,,0,0,0,,Иә
Dialogue: 0,0:21:00.49,0:21:02.26,Default,,0,0,0,,Топ үшін күрес
Dialogue: 0,0:21:03.24,0:21:05.67,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз, Акихабарада сізге орын жоқ.
Dialogue: 0,0:21:06.93,0:21:09.61,Default,,0,0,0,,Мен енді Мо Мо туралы қуанатын жаста емеспін.
Dialogue: 0,0:21:13.54,0:21:14.79,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:21:14.95,0:21:17.38,Default,,0,0,0,,Иә, ескі әріптес.
Dialogue: 0,0:21:17.81,0:21:19.74,Default,,0,0,0,,Бұл люкс киімдер.
Dialogue: 0,0:21:22.48,0:21:24.78,Default,,0,0,0,,Угаки дүниеден өтіп кеткен.
Dialogue: 0,0:21:25.54,0:21:29.13,Default,,0,0,0,,Жақсы, қаскүнем тамаша жұмыс жасады.
Dialogue: 0,0:21:29.43,0:21:32.27,Default,,0,0,0,,Енді барлық кедергілер жойылды, солай ма?
Dialogue: 0,0:21:33.59,0:21:35.32,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:21:37.37,0:21:39.95,Default,,0,0,0,,Қайта ашылуымен құттықтаймыз
Dialogue: 0,0:21:40.03,0:21:42.63,Default,,0,0,0,,Дүкеннің тез арада қайта ашылатынына сене алмаймын.
Dialogue: 0,0:21:42.63,0:21:45.27,Default,,0,0,0,,Олар қалпына келтіруге көмектесті.
Dialogue: 0,0:21:46.57,0:21:49.34,Default,,0,0,0,,Мен Нерула-чанға жақында сау екенімді көрсеткім келеді.
Dialogue: 0,0:21:49.80,0:21:51.79,Default,,0,0,0,,Мен Икейкетонтонда бар күшімді саламын.
Dialogue: 0,0:21:52.05,0:21:53.97,Default,,0,0,0,,Икейкетонтон
Dialogue: 0,0:21:59.51,0:22:01.41,Default,,0,0,0,,Топ үшін күрес
Dialogue: 0,0:22:03.47,0:22:06.21,Default,,0,0,0,,Егер сіз мұны істей алмасаңыз, Акихабарада сізге орын жоқ.
Dialogue: 0,0:22:07.71,0:22:13.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
