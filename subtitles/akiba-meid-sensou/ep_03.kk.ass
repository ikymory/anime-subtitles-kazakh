Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.37,0:00:07.36,Default,,0,0,0,,Арашико-сан...
Dialogue: 0,0:01:40.88,0:01:41.41,Default,,0,0,0,,Жоғары
Dialogue: 0,0:01:43.15,0:01:44.72,Default,,0,0,0,,Сандар жоқ
Dialogue: 0,0:01:46.23,0:01:47.77,Default,,0,0,0,,Оны сатқаныңызды айтыңыз
Dialogue: 0,0:01:48.61,0:01:49.99,Default,,0,0,0,,Кидзима есімді адамға
Dialogue: 0,0:01:51.99,0:01:53.39,Default,,0,0,0,,Машита осылай деді.
Dialogue: 0,0:02:04.38,0:02:05.88,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:02:07.47,0:02:09.37,Default,,0,0,0,,Егер сізге бұл ұнаса...
Dialogue: 0,0:02:10.73,0:02:12.81,Default,,0,0,0,,Менің шашым мазасыз ба?
Dialogue: 0,0:02:16.00,0:02:18.79,Default,,0,0,0,,Сізге қайсысы ұнайды
Dialogue: 0,0:02:19.55,0:02:20.64,Default,,0,0,0,,Қарыз алу
Dialogue: 0,0:02:20.80,0:02:22.76,Default,,0,0,0,,Жоқ, мен беремін.
Dialogue: 0,0:02:23.97,0:02:25.11,Default,,0,0,0,,Біз сізден ақы аламыз
Dialogue: 0,0:02:27.19,0:02:29.13,Default,,0,0,0,,Нүктеге дейін
Dialogue: 0,0:02:31.23,0:02:32.92,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:02:33.96,0:02:36.19,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:02:36.63,0:02:37.55,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:02:37.96,0:02:39.78,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,0:02:40.75,0:02:43.98,Default,,0,0,0,,Қарапайым халықпен араласпауыңызды өтінемін.
Dialogue: 0,0:02:44.41,0:02:47.13,Default,,0,0,0,,Уау, қызметші парақшалар таратты.
Dialogue: 0,0:02:47.13,0:02:48.36,Default,,0,0,0,,Сізді өлтіруі мүмкін
Dialogue: 0,0:02:50.25,0:02:53.99,Default,,0,0,0,,Грейс-Тан лас қалада
Dialogue: 0,0:02:53.99,0:02:56.08,Default,,0,0,0,,Бұл қандай адамдар?
Dialogue: 0,0:02:56.23,0:02:58.06,Default,,0,0,0,,Фигуралық компаниялардың адамдары
Dialogue: 0,0:02:58.57,0:03:01.70,Default,,0,0,0,,Қымбат бағадағы фигураларды сату арқылы назар аударып отырғаны айтылады.
Dialogue: 0,0:03:02.35,0:03:03.95,Default,,0,0,0,,Маған манекенді көрсет
Dialogue: 0,0:03:05.71,0:03:07.80,Default,,0,0,0,,О, керемет жұмыс.
Dialogue: 0,0:03:07.80,0:03:09.70,Default,,0,0,0,,Әуесқойлар ажырата алмайды.
Dialogue: 0,0:03:10.60,0:03:12.55,Default,,0,0,0,,Қымбат бағаға сатамын.
Dialogue: 0,0:03:13.26,0:03:15.75,Default,,0,0,0,,Грейс-тан, жарайды.
Dialogue: 0,0:03:15.75,0:03:18.47,Default,,0,0,0,,Сізге ешкімнің қол тигізуіне жол бермеңіз.
Dialogue: 0,0:03:18.79,0:03:20.74,Default,,0,0,0,,Көп араласпаған дұрыс
Dialogue: 0,0:03:23.22,0:03:24.54,Default,,0,0,0,,Әке шын мәнінде дәрігер емес
Dialogue: 0,0:03:25.15,0:03:26.69,Default,,0,0,0,,Сізбен кездесу
Dialogue: 0,0:03:27.47,0:03:28.85,Default,,0,0,0,,Толығырақ
Dialogue: 0,0:03:33.59,0:03:35.87,Default,,0,0,0,,Мен қызметші сияқты қорықпаймын.
Dialogue: 0,0:03:36.28,0:03:39.03,Default,,0,0,0,,Мен Teme және т.б. дүкенін сатып алмақшымын.
Dialogue: 0,0:03:39.79,0:03:41.09,Default,,0,0,0,,Қызметші сияқты ма?
Dialogue: 0,0:03:44.34,0:03:45.89,Default,,0,0,0,,Қызметші қолын көтергісі келе ме?
Dialogue: 0,0:03:46.90,0:03:48.55,Default,,0,0,0,,Себебі мен қызметшімін.
Dialogue: 0,0:03:48.55,0:03:49.04,Default,,0,0,0,,Не?
Dialogue: 0,0:03:49.64,0:03:51.20,Default,,0,0,0,,Ол Ақибаның күңі болғанша
Dialogue: 0,0:03:51.60,0:03:54.46,Default,,0,0,0,,Сынға ұшыраған кезде кері шегіне алмаймын.
Dialogue: 0,0:03:55.34,0:03:56.98,Default,,0,0,0,,Қызметші сүйкімді
Dialogue: 0,0:03:57.50,0:03:59.68,Default,,0,0,0,,Сіз қызметші болмауыңыз керек.
Dialogue: 0,0:04:00.29,0:04:03.15,Default,,0,0,0,,Бұл гайжин Тайра-санның хабаршысы ма?
Dialogue: 0,0:04:03.92,0:04:05.37,Default,,0,0,0,,Машита сені алып кетеді
Dialogue: 0,0:04:07.54,0:04:09.65,Default,,0,0,0,,Мен сені қызметші ретінде танымаймын.
Dialogue: 0,0:04:16.42,0:04:18.19,Default,,0,0,0,,Ра... Арашико-сан
Dialogue: 0,0:04:22.82,0:04:25.00,Default,,0,0,0,,Маған сіздің түріңіз ұнайды.
Dialogue: 0,0:04:25.44,0:04:29.33,Default,,0,0,0,,Охире-чан ақшаны әрең қайтаратын жағдайға тап болды.
Dialogue: 0,0:04:32.43,0:04:34.01,Default,,0,0,0,,Сіз көп қиындық тудырдыңыз.
Dialogue: 0,0:04:34.16,0:04:37.52,Default,,0,0,0,,Маған қандай жұмыс берілсе де, шағым айта алмаймын.
Dialogue: 0,0:04:37.52,0:04:38.05,Default,,0,0,0,,Иә
Dialogue: 0,0:04:40.86,0:04:42.30,Default,,0,0,0,,Енді жұмыс туралы сөйлесейік...
Dialogue: 0,0:04:42.30,0:04:44.42,Default,,0,0,0,,Неге су ішпейсің, бейбақ?
Dialogue: 0,0:04:44.55,0:04:46.39,Default,,0,0,0,,Менің ішім тоқ деп ойлаймын.
Dialogue: 0,0:04:46.73,0:04:49.83,Default,,0,0,0,,Мен сені Мерлион сияқты жарып жіберемін, бейбақ.
Dialogue: 0,0:04:50.15,0:04:53.48,Default,,0,0,0,,Менің айтайын дегенім, сенің денең әдемі.
Dialogue: 0,0:04:53.97,0:04:54.52,Default,,0,0,0,,Менеджер
Dialogue: 0,0:04:54.79,0:04:55.78,Default,,0,0,0,,Мен 100 пайыз дәлдікпен анықтай аламын
Dialogue: 0,0:04:55.98,0:04:59.13,Default,,0,0,0,,Оның лайықты жұмысы бар деп үміттенемін.
Dialogue: 0,0:04:59.60,0:05:00.91,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:05:01.16,0:05:03.07,Default,,0,0,0,,Бұл бәрібір қауіпті жұмыс.
Dialogue: 0,0:05:03.55,0:05:05.55,Default,,0,0,0,,Ал, уайымдама.
Dialogue: 0,0:05:06.20,0:05:09.58,Default,,0,0,0,,Дүкендегі адамдарды қорғай алмасаң, дүкен меңгерушісі болудың не керегі бар?
Dialogue: 0,0:05:12.63,0:05:13.59,Default,,0,0,0,,Соңында...
Dialogue: 0,0:05:14.81,0:05:16.12,Default,,0,0,0,,Тоңазытқыштағы жұмыртқалар
Dialogue: 0,0:05:16.64,0:05:19.47,Default,,0,0,0,,Оның мерзімі өтіп кеткен, бірақ бәрібір жақсы.
Dialogue: 0,0:05:29.78,0:05:31.63,Default,,0,0,0,,Бұл Арашико-сан.
Dialogue: 0,0:05:31.92,0:05:33.25,Default,,0,0,0,,Мен сайттамын
Dialogue: 0,0:05:33.83,0:05:34.95,Default,,0,0,0,,Біз де барамыз.
Dialogue: 0,0:05:35.79,0:05:39.54,Default,,0,0,0,,Ертең басып алу үшін мен қарсы бағытта Мансейбашыдан өтемін.
Dialogue: 0,0:05:40.52,0:05:42.50,Default,,0,0,0,,Мен жұмысты қабылдадым.
Dialogue: 0,0:05:43.39,0:05:46.28,Default,,0,0,0,,Өйткені дүкенді қорғайтын – дүкен меңгерушісі.
Dialogue: 0,0:05:46.59,0:05:48.16,Default,,0,0,0,,Жел соқты
Dialogue: 0,0:05:48.78,0:05:50.30,Default,,0,0,0,,Арашико да дайын.
Dialogue: 0,0:05:50.48,0:05:52.44,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:05:52.79,0:05:55.40,Default,,0,0,0,,«Акиба Фува Фува тәтті клубы»
Dialogue: 0,0:05:56.64,0:05:57.80,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:58.12,0:06:00.31,Default,,0,0,0,,Сіздің жұмысыңыз жанды орындау ма?
Dialogue: 0,0:06:00.39,0:06:03.72,Default,,0,0,0,,Әй, қанымды қайнатып, етімді билейтін жанды шоу.
Dialogue: 0,0:06:11.16,0:06:11.85,Default,,0,0,0,,Өл
Dialogue: 0,0:06:14.84,0:06:17.43,Default,,0,0,0,,Ей, мен қанша бәс тігемін деп ойлайсың?
Dialogue: 0,0:06:18.39,0:06:19.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:19.76,0:06:23.11,Default,,0,0,0,,...
Dialogue: 0,0:06:26.70,0:06:28.59,Default,,0,0,0,,Ня Екінші құрметпен
Dialogue: 0,0:06:30.84,0:06:31.75,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:06:32.00,0:06:33.56,Default,,0,0,0,,Оның шығатынына сенімдісіз бе?
Dialogue: 0,0:06:34.15,0:06:35.76,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,0:06:35.76,0:06:38.04,Default,,0,0,0,,Ондай қызметші мұндайды жасайды
Dialogue: 0,0:06:38.54,0:06:41.80,Default,,0,0,0,,Қызметшілер дүкен үшін көп жұмыс істейді.
Dialogue: 0,0:06:44.06,0:06:47.22,Default,,0,0,0,,Баннен Арашико 3-ші раундта нокаутпен жеңілді
Dialogue: 0,0:06:47.57,0:06:49.47,Default,,0,0,0,,Сөзсіз айтқандай
Dialogue: 0,0:06:50.13,0:06:51.06,Default,,0,0,0,,Күлсалғыш
Dialogue: 0,0:06:51.47,0:06:51.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:53.13,0:06:54.61,Default,,0,0,0,,Тыныс алу техникасын үйреніп жатырмын.
Dialogue: 0,0:06:56.64,0:06:57.51,Default,,0,0,0,,Атцу
Dialogue: 0,0:07:00.99,0:07:04.75,Default,,0,0,0,,Егер сіз көзіңізді көзді патчпен жапқыңыз келмесе, мұны жақсы жасаңыз.
Dialogue: 0,0:07:05.04,0:07:09.03,Default,,0,0,0,,Тайра мырза, Кижима сізге фигураларды көрсетуге келеді.
Dialogue: 0,0:07:09.39,0:07:10.17,Default,,0,0,0,,Сәйкестік?
Dialogue: 0,0:07:10.17,0:07:11.54,Default,,0,0,0,,Әй, дауысыңды көтер!
Dialogue: 0,0:07:11.82,0:07:14.87,Default,,0,0,0,,Сіз әдейі жеңіліп, жекпе-жек ақшасын алғыңыз келе ме?
Dialogue: 0,0:07:15.09,0:07:17.39,Default,,0,0,0,,Сонымен қатар, бұл сіз жеңімпазды немесе жеңілгенді білесіз дегенді білдірмейді.
Dialogue: 0,0:07:17.58,0:07:19.58,Default,,0,0,0,,Жауға бәс тігу арқылы көп ақша табуға болады.
Dialogue: 0,0:07:19.84,0:07:22.30,Default,,0,0,0,,Жоқ, сен нағыз данышпансың, менеджер.
Dialogue: 0,0:07:25.97,0:07:28.35,Default,,0,0,0,,Жаңа тұлға Чемпионның қарсыласы ма?
Dialogue: 0,0:07:29.28,0:07:30.44,Default,,0,0,0,,Бұл қорқынышты сезім
Dialogue: 0,0:07:31.36,0:07:33.24,Default,,0,0,0,,Арашико қызметші екен.
Dialogue: 0,0:07:34.64,0:07:39.44,Default,,0,0,0,,Бірақ «Таза сүтті Масами» жұқа қолымен жеңілмеген абсолютті чемпион.
Dialogue: 0,0:07:39.86,0:07:43.38,Default,,0,0,0,,Біз бұл турнирді қатардағы үш жеңіспен аяқтадық.
Dialogue: 0,0:07:45.34,0:07:47.15,Default,,0,0,0,,Дөрекі болады, мына жігіт
Dialogue: 0,0:07:47.15,0:07:49.59,Default,,0,0,0,,Мен де бүгін дүбірлетемін.
Dialogue: 0,0:07:47.91,0:07:50.04,Default,,0,0,0,,Сонымен... абсолютті чемпион?
Dialogue: 0,0:07:50.61,0:07:51.53,Default,,0,0,0,,Бұл адам?
Dialogue: 0,0:07:58.84,0:08:01.78,Default,,0,0,0,,Тайра мырза шынымен бақытты екен.
Dialogue: 0,0:08:01.97,0:08:04.99,Default,,0,0,0,,Ең алдымен, оны нарықта пайда болмайтын асыл тасқа айналдырыңыз.
Dialogue: 0,0:08:04.99,0:08:07.32,Default,,0,0,0,,Менің үйіме жақында келді.
Dialogue: 0,0:08:07.58,0:08:08.54,Default,,0,0,0,,Грейс-тан
Dialogue: 0,0:08:09.25,0:08:10.63,Default,,0,0,0,,Грейс Иномата
Dialogue: 0,0:08:11.25,0:08:14.05,Default,,0,0,0,,«Аңыз жауынгер Нобуаки» анимесінде пайда болады
Dialogue: 0,0:08:14.36,0:08:16.74,Default,,0,0,0,,Ол менің де сүйікті кейіпкерім.
Dialogue: 0,0:08:17.88,0:08:22.58,Default,,0,0,0,,Әйгілі Хакугаку Нобуакидің бастауыш сынып оқушысы кезінде өсуін қолдайды
Dialogue: 0,0:08:23.14,0:08:28.19,Default,,0,0,0,,Бала кезімде оның бірбеткейлігіне тәнті болдым.
Dialogue: 0,0:08:29.00,0:08:33.35,Default,,0,0,0,,Дегенмен, оны қосалқы кейіпкерлер арасында қосалқы кейіпкер деп айтуға болады.
Dialogue: 0,0:08:34.09,0:08:36.83,Default,,0,0,0,,Біріншіден, цифрлардың өндіріс көлемі аз болды.
Dialogue: 0,0:08:37.37,0:08:40.79,Default,,0,0,0,,Оның тапшылық құнына байланысты баға да өсті
Dialogue: 0,0:08:40.97,0:08:44.04,Default,,0,0,0,,10 миллион белгісінен оңай асып түседі
Dialogue: 0,0:08:44.26,0:08:45.89,Default,,0,0,0,,Мен саған қанша қаласаң да беремін.
Dialogue: 0,0:08:46.55,0:08:48.88,Default,,0,0,0,,Себебі мен оған тәнті болдым
Dialogue: 0,0:08:49.13,0:08:51.73,Default,,0,0,0,,Біз осындай жұлдызды ойыншыларды шығара алдық.
Dialogue: 0,0:09:00.03,0:09:00.86,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:09:01.50,0:09:02.11,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:09:02.35,0:09:05.04,Default,,0,0,0,,Нанана... Сіз не ұтып жатырсыз?
Dialogue: 0,0:09:05.15,0:09:06.03,Default,,0,0,0,,Бұл жұқа сызық болды.
Dialogue: 0,0:09:06.03,0:09:08.54,Default,,0,0,0,,Және 1 ланд бір соққы КО
Dialogue: 0,0:09:08.54,0:09:09.40,Default,,0,0,0,,Бұл жұқа сызық болды.
Dialogue: 0,0:09:09.40,0:09:10.59,Default,,0,0,0,,Бұл жұқа сызық емес
Dialogue: 0,0:09:10.59,0:09:13.20,Default,,0,0,0,,Сіз үшінші раундта жеңілетініңізді бірнеше рет айттыңыз.
Dialogue: 0,0:09:13.52,0:09:15.24,Default,,0,0,0,,Мен оны сынап көрдім және білдім
Dialogue: 0,0:09:15.84,0:09:17.92,Default,,0,0,0,,Мен бұрыштарды қия алмайтын сияқтымын.
Dialogue: 0,0:09:18.23,0:09:20.29,Default,,0,0,0,,Өйткені мен олай өмір сүрген емеспін.
Dialogue: 0,0:09:21.16,0:09:25.61,Default,,0,0,0,,Әй, сен қарсыласыңмен тіл табыса алмадың ба?
Dialogue: 0,0:09:26.07,0:09:30.05,Default,,0,0,0,,Қабілет әлемінде жұлдыз жасау қиын.
Dialogue: 0,0:09:30.68,0:09:33.26,Default,,0,0,0,,Енді Грейс-танның ақысын төлейік...
Dialogue: 0,0:09:37.11,0:09:38.50,Default,,0,0,0,,О... иесі
Dialogue: 0,0:09:38.74,0:09:40.98,Default,,0,0,0,,Бұл бәрібір бірдей нәрсе.
Dialogue: 0,0:09:41.68,0:09:43.19,Default,,0,0,0,,Маған шошқаларды әкел
Dialogue: 0,0:09:45.41,0:09:47.20,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:48.44,0:09:51.90,Default,,0,0,0,,Мен сізден біздің не істегенімізді түсінесіз бе деп сұраймын.
Dialogue: 0,0:09:51.90,0:09:53.41,Default,,0,0,0,,Менің арманым бар
Dialogue: 0,0:09:53.93,0:09:56.11,Default,,0,0,0,,Гавайидегі коттеджде әдемі ер адамдармен айналаңыз
Dialogue: 0,0:09:56.11,0:09:57.75,Default,,0,0,0,,Мен жұмыс істемей өмір сүргім келеді
Dialogue: 0,0:09:57.96,0:09:59.82,Default,,0,0,0,,Сондықтан маған мүмкіндік беріңізші
Dialogue: 0,0:10:00.17,0:10:02.45,Default,,0,0,0,,Мен Арасикоға финалға шығуға көмектесемін.
Dialogue: 0,0:10:02.45,0:10:04.21,Default,,0,0,0,,Ол қазірдің өзінде күшейіп келеді
Dialogue: 0,0:10:05.21,0:10:07.07,Default,,0,0,0,,Осы жігіт жеңсе не болады?
Dialogue: 0,0:10:07.07,0:10:10.03,Default,,0,0,0,,Көрермендер Арасиконың жеңісіне күмәнданбаған кезде
Dialogue: 0,0:10:10.29,0:10:12.02,Default,,0,0,0,,Арашико финалда жеңіліп қалсын
Dialogue: 0,0:10:12.28,0:10:14.57,Default,,0,0,0,,Сол сәтте сіздің ойыншыңыз жұлдыз.
Dialogue: 0,0:10:14.57,0:10:17.10,Default,,0,0,0,,Жұлдызша жасауға көмектесейін
Dialogue: 0,0:10:17.63,0:10:18.77,Default,,0,0,0,,Сәйкестікті түзете аласыз.
Dialogue: 0,0:10:19.04,0:10:19.67,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:10:19.91,0:10:21.20,Default,,0,0,0,,Мен сәйкестікті түзеткім келеді.
Dialogue: 0,0:10:21.42,0:10:21.92,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:10:22.10,0:10:24.01,Default,,0,0,0,,Финалда жеңілу мен түсінемін.
Dialogue: 0,0:10:24.35,0:10:25.10,Default,,0,0,0,,Баста
Dialogue: 0,0:10:25.10,0:10:26.61,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:26.72,0:10:29.09,Default,,0,0,0,,Менің Арасиком да осылай мотивацияланған.
Dialogue: 0,0:10:31.36,0:10:32.42,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:32.58,0:10:33.37,Default,,0,0,0,,Немесе мен мәңгі осы жерде қалсам, ол мазалайды деп отырсың ба?
Dialogue: 0,0:10:37.16,0:10:40.08,Default,,0,0,0,,Қызметші болып, күлімсіреу де мүмкін емес ақаулы өнім.
Dialogue: 0,0:10:40.48,0:10:42.31,Default,,0,0,0,,Әскери дағдылары бар.
Dialogue: 0,0:10:42.84,0:10:45.92,Default,,0,0,0,,Әлгі қарғыс атқан әйел ессіз кетсе де, сен жеңе алмайсың.
Dialogue: 0,0:10:46.69,0:10:48.00,Default,,0,0,0,,Ол қызметші болған, солай ма?
Dialogue: 0,0:10:48.80,0:10:50.63,Default,,0,0,0,,Жаңа ғана қызметші болып киінген
Dialogue: 0,0:10:51.22,0:10:53.22,Default,,0,0,0,,Сіз де, мен де қызметші емеспіз.
Dialogue: 0,0:10:53.40,0:10:54.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:54.51,0:10:58.15,Default,,0,0,0,,Кез келген форма киген адам қызметші болуға құқылы.
Dialogue: 0,0:10:58.95,0:11:02.23,Default,,0,0,0,,Қызметші болу-болмау өз еркіңізде.
Dialogue: 0,0:11:04.56,0:11:06.73,Default,,0,0,0,,Мен сіздің жоспарыңызбен бірге барамын.
Dialogue: 0,0:11:07.15,0:11:08.01,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:11:08.44,0:11:11.89,Default,,0,0,0,,Сол денені көлікке тұраққа тастаңыз.
Dialogue: 0,0:11:12.32,0:11:13.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:19.46,0:11:21.79,Default,,0,0,0,,Неге жалаңашсың?
Dialogue: 0,0:11:22.19,0:11:22.90,Default,,0,0,0,,Шынайылық
Dialogue: 0,0:11:41.59,0:11:43.25,Default,,0,0,0,,Сіз әлі де ұрысып жатырсыз ба?
Dialogue: 0,0:11:43.64,0:11:46.09,Default,,0,0,0,,Бұл ең алдымен менің кінәм.
Dialogue: 0,0:11:46.09,0:11:50.17,Default,,0,0,0,,Мансейбаши көпірімен кері бағытта өтіп, ертеңге қарай
Dialogue: 0,0:11:50.17,0:11:52.00,Default,,0,0,0,,Сіз тағы бірдеңе жоспарлап отырсыз ба?
Dialogue: 0,0:11:52.15,0:11:54.28,Default,,0,0,0,,1-бөлім ертеңге
Dialogue: 0,0:11:55.26,0:11:55.95,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:11:57.09,0:11:58.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:58.37,0:12:00.51,Default,,0,0,0,,Сіз маған мүшелерімді кепілге қойып қарызға бересіз бе?
Dialogue: 0,0:12:00.51,0:12:01.39,Default,,0,0,0,,Мүшелер?
Dialogue: 0,0:12:01.51,0:12:02.70,Default,,0,0,0,,Жеңіске жету дұрыс па?
Dialogue: 0,0:12:02.94,0:12:05.66,Default,,0,0,0,,Жеңілсең де, ішіңнің жартысымен өмір сүретін сияқтысың.
Dialogue: 0,0:12:05.66,0:12:08.71,Default,,0,0,0,,Әйтеуір, тегін жалға алатын сияқтысың.
Dialogue: 0,0:12:08.97,0:12:10.84,Default,,0,0,0,,Асқазан мен өкпенің жиынтығын алуға болады ма?
Dialogue: 0,0:12:11.31,0:12:15.63,Default,,0,0,0,,Мен қазір аңыздың басталуына куә болып отырмын.
Dialogue: 0,0:12:15.93,0:12:18.43,Default,,0,0,0,,Жаңа жұлдыз туды, мынау
Dialogue: 0,0:12:20.77,0:12:23.19,Default,,0,0,0,,Сәйкестік үшін күрес
Dialogue: 0,0:12:23.40,0:12:24.93,Default,,0,0,0,,Сізге қолдау көрсетуден басқа амалымыз жоқ.
Dialogue: 0,0:12:25.18,0:12:26.84,Default,,0,0,0,,Арашико да барын салып жатыр.
Dialogue: 0,0:12:37.18,0:12:38.08,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:12:38.08,0:12:38.95,Default,,0,0,0,,Тайра мырза
Dialogue: 0,0:12:39.16,0:12:41.28,Default,,0,0,0,,Сіз менің президентімді білмейсіз бе?
Dialogue: 0,0:12:41.28,0:12:44.06,Default,,0,0,0,,Сен маған қоңырау шалғаннан бері мен жоқпын.
Dialogue: 0,0:12:44.34,0:12:46.54,Default,,0,0,0,,Мен мұнда емеспін.
Dialogue: 0,0:12:46.90,0:12:48.37,Default,,0,0,0,,Бұл бейнебақылау камерасына түсірілген.
Dialogue: 0,0:12:49.51,0:12:50.44,Default,,0,0,0,,Президент
Dialogue: 0,0:12:51.19,0:12:53.00,Default,,0,0,0,,Сол әйелді жасаймыз ба?
Dialogue: 0,0:12:53.28,0:12:55.58,Default,,0,0,0,,Өйткені ол сәйкестікке әсер етеді
Dialogue: 0,0:12:55.99,0:12:57.87,Default,,0,0,0,,Оны бізге қалдырыңыз
Dialogue: 0,0:12:58.85,0:13:01.70,Default,,0,0,0,,Өкінішіңді өшірейін.
Dialogue: 0,0:13:02.29,0:13:03.69,Default,,0,0,0,,Соңғы сақинада
Dialogue: 0,0:13:06.39,0:13:08.27,Default,,0,0,0,,Өлгендермен сөйлеспе
Dialogue: 0,0:13:08.53,0:13:12.57,Default,,0,0,0,,Маннен Арашико фигурасын ұрлағаны үшін өліңіз.
Dialogue: 0,0:13:13.27,0:13:15.76,Default,,0,0,0,,Мен Зояға оны өлтіруді айттым.
Dialogue: 0,0:13:16.02,0:13:16.36,Default,,0,0,0,,Иә
Dialogue: 0,0:13:16.66,0:13:19.78,Default,,0,0,0,,Алайда, Маннен Арашико иесімен кездескісі келеді.
Dialogue: 0,0:13:20.37,0:13:22.27,Default,,0,0,0,,Сізде бергіңіз келетін нәрсе бар ма?
Dialogue: 0,0:13:23.47,0:13:24.80,Default,,0,0,0,,Тұз себіңіз
Dialogue: 0,0:13:38.19,0:13:41.80,Default,,0,0,0,,Қызметші болу не болмау өз еркіңізде.
Dialogue: 0,0:13:44.70,0:13:46.81,Default,,0,0,0,,GO пайда болғанда, оны орындаңыз.
Dialogue: 0,0:13:50.53,0:13:53.67,Default,,0,0,0,,Тыңда, сол қателерді қайталау – маймыл.
Dialogue: 0,0:13:53.90,0:13:55.17,Default,,0,0,0,,Есептегіштерді қоспаңыз
Dialogue: 0,0:13:55.17,0:13:56.96,Default,,0,0,0,,Адал соғу
Dialogue: 0,0:13:56.96,0:13:58.08,Default,,0,0,0,,Сіз жеңілдіңіз
Dialogue: 0,0:13:58.16,0:13:59.51,Default,,0,0,0,,Сөзсіз жоғалтыңыз
Dialogue: 0,0:13:59.86,0:14:00.96,Default,,0,0,0,,Қанша айналым?
Dialogue: 0,0:14:01.23,0:14:02.05,Default,,0,0,0,,12 айналым
Dialogue: 0,0:14:02.05,0:14:03.69,Default,,0,0,0,,Иә, бара аламын.
Dialogue: 0,0:14:03.69,0:14:05.00,Default,,0,0,0,,Сіз жоғалтуыңыз мүмкін
Dialogue: 0,0:14:05.00,0:14:06.92,Default,,0,0,0,,Ей, сеніммен жүр.
Dialogue: 0,0:14:07.05,0:14:07.38,Default,,0,0,0,,Иә
Dialogue: 0,0:14:09.68,0:14:11.08,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:14:11.44,0:14:14.03,Default,,0,0,0,,Үлкен өлшемді жаңадан келгендер арасындағы финалдық матч
Dialogue: 0,0:14:14.03,0:14:17.46,Default,,0,0,0,,12 раунд жалпы, мен жындымын
Dialogue: 0,0:14:18.08,0:14:21.05,Default,,0,0,0,,Баннен Арашиконың түсіру рейтингі өте қолайлы, бірақ
Dialogue: 0,0:14:21.05,0:14:22.82,Default,,0,0,0,,Менің ойымша, бұл бір қалыпты өтеді.
Dialogue: 0,0:14:23.42,0:14:27.06,Default,,0,0,0,,Чикусо Қанша ішек болса да, ол ешқашан жетпейді.
Dialogue: 0,0:14:27.71,0:14:29.20,Default,,0,0,0,,Дүкен үшін жеңіліс
Dialogue: 0,0:14:29.85,0:14:30.81,Default,,0,0,0,,Дүкен үшін…
Dialogue: 0,0:14:42.47,0:14:43.40,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:44.45,0:14:46.14,Default,,0,0,0,,Мен соққыны көре алмадым.
Dialogue: 0,0:14:46.91,0:14:49.04,Default,,0,0,0,,Сіз бұл шабуылды қабылдай бересіз бе?
Dialogue: 0,0:14:51.52,0:14:52.91,Default,,0,0,0,,Сіз қолыңызды тиюді жоспарлап отырсыз ба?
Dialogue: 0,0:14:57.23,0:14:59.25,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:14:59.25,0:15:00.89,Default,,0,0,0,,Мен ертең көре аламын
Dialogue: 0,0:15:00.89,0:15:02.92,Default,,0,0,0,,Соңына дейін осылай жүреміз бе?
Dialogue: 0,0:15:02.92,0:15:04.93,Default,,0,0,0,,Бұл мүмкін емес, 11 раунд.
Dialogue: 0,0:15:05.92,0:15:06.95,Default,,0,0,0,,Ол әйел...
Dialogue: 0,0:15:07.28,0:15:09.13,Default,,0,0,0,,GO шықты Жасаңыз
Dialogue: 0,0:15:09.41,0:15:10.00,Default,,0,0,0,,Хорошо́
Dialogue: 0,0:15:18.23,0:15:19.01,Default,,0,0,0,,Бастың артқы жағы?
Dialogue: 0,0:15:19.71,0:15:20.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:20.30,0:15:22.24,Default,,0,0,0,,Эй... Бұл Чин Чин.
Dialogue: 0,0:15:22.24,0:15:23.47,Default,,0,0,0,,Жоқ, бұл Чин емес.
Dialogue: 0,0:15:28.56,0:15:29.87,Default,,0,0,0,,Сәлем төреші
Dialogue: 0,0:15:31.36,0:15:32.21,Default,,0,0,0,,Білсін
Dialogue: 0,0:15:36.57,0:15:37.34,Default,,0,0,0,,Арашико
Dialogue: 0,0:15:42.80,0:15:44.90,Default,,0,0,0,,Сіз жай ғана бірдеңе жасауға тырыстыңыз ба?
Dialogue: 0,0:15:45.44,0:15:45.83,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:46.28,0:15:47.44,Default,,0,0,0,,Егер сіз қазір тоқтатсаңыз
Dialogue: 0,0:15:47.61,0:15:49.43,Default,,0,0,0,,Ол мені өлтіруге келеді.
Dialogue: 0,0:15:49.64,0:15:50.35,Default,,0,0,0,,Келген жоқ
Dialogue: 0,0:15:50.51,0:15:51.65,Default,,0,0,0,,Арашико кете алады
Dialogue: 0,0:15:51.93,0:15:53.43,Default,,0,0,0,,Мен Гавайи жақындап келе жатқандай сезінемін.
Dialogue: 0,0:15:53.64,0:15:57.60,Default,,0,0,0,,Арашико-сан дереу ақша үшін өлтірілмекші.
Dialogue: 0,0:15:57.91,0:16:00.71,Default,,0,0,0,,Жарайды, маған жетпейді.
Dialogue: 0,0:16:01.68,0:16:04.70,Default,,0,0,0,,Жел соғады, Вайкикидің желі
Dialogue: 0,0:16:18.50,0:16:19.42,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:16:23.32,0:16:25.88,Default,,0,0,0,,Сырт келбеті сондай лас қызметші қыз?
Dialogue: 0,0:16:26.40,0:16:28.13,Default,,0,0,0,,Мен мұқият қызметшімін.
Dialogue: 0,0:16:28.55,0:16:31.10,Default,,0,0,0,,Дүкеніңіздегі барлық қызметшілер сәтсіздікке ұшырады ма?
Dialogue: 0,0:16:31.45,0:16:31.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:33.18,0:16:38.36,Default,,0,0,0,,Сені күң санайтындар да баяғы сорақылар.
Dialogue: 0,0:16:52.48,0:16:53.38,Default,,0,0,0,,Ол әйел...
Dialogue: 0,0:16:53.79,0:16:55.97,Default,,0,0,0,,Лалала... Арашико?
Dialogue: 0,0:16:56.17,0:16:57.01,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:16:57.01,0:16:58.83,Default,,0,0,0,,Бірдей қателерді қайталау
Dialogue: 0,0:16:59.39,0:17:00.71,Default,,0,0,0,,Сәлем, Окачимачи мырза?
Dialogue: 0,0:17:01.39,0:17:01.98,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:01.98,0:17:06.21,Default,,0,0,0,,Арашико Арашико Арашико О
Dialogue: 0,0:17:02.77,0:17:03.60,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:17:04.07,0:17:06.76,Default,,0,0,0,,Кешіріңіз, шаш байлау...
Dialogue: 0,0:17:07.09,0:17:09.04,Default,,0,0,0,,Пошеткадағы ауыстыру
Dialogue: 0,0:17:09.53,0:17:10.64,Default,,0,0,0,,Менде бар
Dialogue: 0,0:17:14.06,0:17:14.90,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:15.40,0:17:16.08,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:20.16,0:17:20.61,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:21.78,0:17:22.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:26.89,0:17:28.27,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:17:28.72,0:17:31.05,Default,,0,0,0,,Дүкен маңдайшасына түкіру
Dialogue: 0,0:17:31.59,0:17:33.07,Default,,0,0,0,,Мен үндемей тұра алмаймын
Dialogue: 0,0:17:36.03,0:17:37.24,Default,,0,0,0,,Өйткені мен қызметшімін
Dialogue: 0,0:17:55.38,0:17:56.60,Default,,0,0,0,,Әртүрлі әңгіме
Dialogue: 0,0:17:56.87,0:17:58.64,Default,,0,0,0,,Қарғыс атқыр шошқалар.
Dialogue: 0,0:17:58.64,0:17:59.76,Default,,0,0,0,,Строгейм, жарылып-жар-жар болып кетуі тиіс еді—
Dialogue: 0,0:18:00.02,0:18:01.48,Default,,0,0,0,,Ұйқы безі Ұйқы безі
Dialogue: 0,0:18:02.57,0:18:04.48,Default,,0,0,0,,Жоғал, Арашико.
Dialogue: 0,0:18:05.57,0:18:06.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:07.68,0:18:10.21,Default,,0,0,0,,Мынаны сен қызметші деп атайсың ба?
Dialogue: 0,0:18:36.59,0:18:37.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:42.54,0:18:43.86,Default,,0,0,0,,Күлесің бе?
Dialogue: 0,0:18:47.71,0:18:48.44,Default,,0,0,0,,Но я…
Dialogue: 0,0:18:50.02,0:18:50.65,Default,,0,0,0,,Я же…
Dialogue: 0,0:18:52.86,0:18:53.70,Default,,0,0,0,,Сізге жақсы көрінеді
Dialogue: 0,0:18:53.70,0:18:54.36,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:18:56.47,0:18:58.65,Default,,0,0,0,,Қандай сүйкімді қыз.
Dialogue: 0,0:18:59.11,0:19:01.32,Default,,0,0,0,,Сіз қызметші бола алмайсыз.
Dialogue: 0,0:19:02.32,0:19:04.75,Default,,0,0,0,,Мен күле алмаймын
Dialogue: 0,0:19:07.29,0:19:08.55,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:19:09.06,0:19:11.76,Default,,0,0,0,,Сіз сүйкімді емессіз
Dialogue: 0,0:19:13.08,0:19:15.26,Default,,0,0,0,,Жоқ, бұл сүйкімді.
Dialogue: 0,0:19:16.02,0:19:21.22,Default,,0,0,0,,Әсіресе бүгін мен Нагоми-сан сыйлаған галстук тағып жүрмін.
Dialogue: 0,0:19:29.29,0:19:32.71,Default,,0,0,0,,Мен бұл адамға қарсы жеңсем, мені мойындайды ма?
Dialogue: 0,0:19:33.70,0:19:37.75,Default,,0,0,0,,Егер сіз өзіңізді осы адам сияқты сүйкімді деп атасаңыз...
Dialogue: 0,0:19:40.73,0:19:41.84,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:19:49.99,0:19:50.96,Default,,0,0,0,,Арашико-сан...
Dialogue: 0,0:19:53.03,0:19:54.19,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:19:54.59,0:19:55.97,Default,,0,0,0,,Демді ішке тартып тамашалаңыздар
Dialogue: 0,0:20:06.79,0:20:10.11,Default,,0,0,0,,Арашико-сан сүйкімді Десунэ
Dialogue: 0,0:20:11.68,0:20:12.62,Default,,0,0,0,,Сіз де
Dialogue: 0,0:20:21.69,0:20:23.58,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:20:26.16,0:20:26.58,Default,,0,0,0,,No
Dialogue: 0,0:20:33.41,0:20:36.40,Default,,0,0,0,,Ұйқы безі көкбауыр
Dialogue: 0,0:20:37.02,0:20:38.22,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:20:38.37,0:20:39.63,Default,,0,0,0,,Тірі қайтып оралма
Dialogue: 0,0:20:40.38,0:20:42.57,Default,,0,0,0,,Дәлізде осындай жазба ілінді.
Dialogue: 0,0:20:43.24,0:20:48.02,Default,,0,0,0,,«Тайра мырза, бізге келген мәйіт туралы сізге айтайын дегенім бар».
Dialogue: 0,0:20:48.30,0:20:50.96,Default,,0,0,0,,Президент осында болды.
Dialogue: 0,0:20:51.29,0:20:53.39,Default,,0,0,0,,Оны өлтірген Теме болды.
Dialogue: 0,0:20:58.26,0:21:00.03,Default,,0,0,0,,Ағзаларыңызды саттыңыз ба?
Dialogue: 0,0:21:00.55,0:21:03.76,Default,,0,0,0,,Ұйқы безі жай ғана безендіру.
Dialogue: 0,0:21:04.90,0:21:07.43,Default,,0,0,0,,Әлгі Кижима жігіті?
Dialogue: 0,0:21:07.43,0:21:09.42,Default,,0,0,0,,Ол қымбат фигуралардан ақша тауып отырды, солай ма?
Dialogue: 0,0:21:09.62,0:21:11.79,Default,,0,0,0,,А... Иә, солай көрінеді.
Dialogue: 0,0:21:12.77,0:21:14.42,Default,,0,0,0,,Бұл сатылмайды.
Dialogue: 0,0:21:15.78,0:21:17.58,Default,,0,0,0,,Сүйек қалдықтары
Dialogue: 0,0:21:17.73,0:21:21.38,Default,,0,0,0,,Соңында құқық бұзушы Охире-чан қалды.
Dialogue: 0,0:21:21.51,0:21:24.70,Default,,0,0,0,,Мүшелерімнен айырылмағаныма қуаныштымын.
Dialogue: 0,0:21:24.80,0:21:26.56,Default,,0,0,0,,Мұңайсаң да ертең келмейді
Dialogue: 0,0:21:26.96,0:21:29.68,Default,,0,0,0,,Тауды жеңу бірқалыпты қадамнан басталады
Dialogue: 0,0:21:29.91,0:21:32.11,Default,,0,0,0,,Алдымен мен күш қосуға тырыстым.
Dialogue: 0,0:21:34.12,0:21:37.61,Default,,0,0,0,,Мен Зоямын, бүгіннен бастап еңбектенемін.
Dialogue: 0,0:21:37.79,0:21:40.86,Default,,0,0,0,,Сүйкімді қызметші болу үшін бар күшіңізді салыңыз
Dialogue: 0,0:21:41.33,0:21:42.62,Default,,0,0,0,,Кеше...
Dialogue: 0,0:21:42.84,0:21:44.24,Default,,0,0,0,,Кейіпкер тым өзгерген.
Dialogue: 0,0:21:44.57,0:21:46.67,Default,,0,0,0,,Бұл менің шынайы өлімім
Dialogue: 0,0:21:47.53,0:21:49.90,Default,,0,0,0,,Шетелдік көмекшінің пайда болуы
Dialogue: 0,0:21:49.90,0:21:51.32,Default,,0,0,0,,Тайра қайтыс болды
Dialogue: 0,0:21:51.32,0:21:53.17,Default,,0,0,0,,Бұзбай тегін алыңыз
Dialogue: 0,0:21:53.81,0:21:56.48,Default,,0,0,0,,Ақырында, интернационалдандыру сәтті болды!
Dialogue: 0,0:22:08.23,0:22:09.01,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:22:10.51,0:22:16.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
