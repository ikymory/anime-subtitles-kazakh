Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.07,0:00:04.73,Default,,0,0,0,,1999 Акихабараның қызметші өнеркәсібі
Dialogue: 0,0:00:05.16,0:00:08.23,Default,,0,0,0,,Екі үлкен топ пайда болады: Кедамоноленд және Мэйдриан
Dialogue: 0,0:00:08.74,0:00:11.19,Default,,0,0,0,,Күштер бақталастық жағдайында болды.
Dialogue: 0,0:00:12.19,0:00:14.74,Default,,0,0,0,,Соңғы дүкендер арасында қақтығыстар болғанымен,
Dialogue: 0,0:00:14.92,0:00:17.37,Default,,0,0,0,,Көрінетін тыныштық сақталды.
Dialogue: 0,0:00:17.74,0:00:23.38,Default,,0,0,0,,Алайда 15 жыл бұрын жанжал үшін жазасын өтеп жатқан Маннен Арашико түрмеден босатылды.
Dialogue: 0,0:00:24.00,0:00:25.16,Default,,0,0,0,,Қызметшіге оралу
Dialogue: 0,0:00:26.03,0:00:27.47,Default,,0,0,0,,Арашиконың қайтып келген бірінші күнінен
Dialogue: 0,0:00:27.76,0:00:30.43,Default,,0,0,0,,Жау тобының қызметші кафесін жойыңыз
Dialogue: 0,0:00:30.89,0:00:32.34,Default,,0,0,0,,Казино және астыртын күрес клубтары
Dialogue: 0,0:00:32.77,0:00:35.27,Default,,0,0,0,,Аматсуса да осындай дүкендерде айналысты.
Dialogue: 0,0:00:36.02,0:00:38.02,Default,,0,0,0,,Құбылмалы атмосферада
Dialogue: 0,0:00:38.48,0:00:40.46,Default,,0,0,0,,Майдрианның көтерілуінің қозғаушы күші
Dialogue: 0,0:00:40.98,0:00:44.94,Default,,0,0,0,,«Қызыл супернова» деп аталатын қызметші қыз Акибаға қайтып келеді
Dialogue: 0,0:00:49.61,0:00:51.01,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:51.25,0:00:51.76,Default,,0,0,0,,О
Dialogue: 0,0:01:04.35,0:01:06.75,Default,,0,0,0,,Шабаның самалын сезейік
Dialogue: 0,0:02:48.67,0:02:50.73,Default,,0,0,0,,Манами, сені қайта көргеніме қуаныштымын.
Dialogue: 0,0:02:53.09,0:02:54.61,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:02:54.91,0:02:56.62,Default,,0,0,0,,Угаки – заманауи тұлға.
Dialogue: 0,0:02:56.82,0:02:59.22,Default,,0,0,0,,Енді мен үшін жұмыс істе.
Dialogue: 0,0:03:00.24,0:03:01.92,Default,,0,0,0,,Акиба үлкен жарылыс
Dialogue: 0,0:03:01.92,0:03:03.97,Default,,0,0,0,,Менің ойымша, бәрі жақсы болып жатыр.
Dialogue: 0,0:03:04.17,0:03:06.89,Default,,0,0,0,,Мен өкіл болғаннан бері сатылым екі есе өсті.
Dialogue: 0,0:03:06.89,0:03:09.47,Default,,0,0,0,,Дүкендердің саны Кедамоноға жақындап қалды.
Dialogue: 0,0:03:10.20,0:03:13.30,Default,,0,0,0,,Чукичукицуки-чан мен мына құбыжық жоқ сияқты.
Dialogue: 0,0:03:13.52,0:03:14.99,Default,,0,0,0,,Олар жоқ.
Dialogue: 0,0:03:15.16,0:03:16.37,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:03:16.62,0:03:18.58,Default,,0,0,0,,Оның мінез-құлқы тым нашар болды.
Dialogue: 0,0:03:18.58,0:03:20.56,Default,,0,0,0,,Жыртқыш аңның астынан езілген
Dialogue: 0,0:03:20.56,0:03:22.35,Default,,0,0,0,,Жоқ, мен өкінемін.
Dialogue: 0,0:03:22.60,0:03:25.35,Default,,0,0,0,,Қарашы, Айми, мынаны тастап, тамақ іш.
Dialogue: 0,0:03:25.93,0:03:29.82,Default,,0,0,0,,Енді чакалармен, яппалармен және жарғанаттармен серуендейтін уақыт емес.
Dialogue: 0,0:03:32.48,0:03:36.40,Default,,0,0,0,,Үйімнен жағымсыз иіс шығып, тамақ ішіп отырған осы жеті жылда мен не істедім?
Dialogue: 0,0:03:36.40,0:03:37.60,Default,,0,0,0,,Жарайды, Айми
Dialogue: 0,0:03:37.79,0:03:39.49,Default,,0,0,0,,Мен екінші өкілмін
Dialogue: 0,0:03:39.49,0:03:40.77,Default,,0,0,0,,Сіз кадрсыз.
Dialogue: 0,0:03:40.77,0:03:41.68,Default,,0,0,0,,Өз ұстанымыңызды біліңіз
Dialogue: 0,0:03:41.68,0:03:43.86,Default,,0,0,0,,Кішкентай шабақ
Dialogue: 0,0:03:43.86,0:03:46.50,Default,,0,0,0,,Мейдриан жалап дегенді түсінбейсің бе?
Dialogue: 0,0:03:46.50,0:03:47.73,Default,,0,0,0,,Бұл ескі.
Dialogue: 0,0:03:48.69,0:03:53.31,Default,,0,0,0,,Мазалағаның жақсы болған соң, неге өзіңді қызметші дейсің?
Dialogue: 0,0:03:58.06,0:04:00.51,Default,,0,0,0,,Күңші жалап кетсе, бітті.
Dialogue: 0,0:04:00.51,0:04:02.81,Default,,0,0,0,,Ой... Сабыр ет, Манами.
Dialogue: 0,0:04:03.00,0:04:04.70,Default,,0,0,0,,Өкінбейсіз бе?
Dialogue: 0,0:04:04.70,0:04:06.66,Default,,0,0,0,,Қызметші қыздың ұрып-соғуы ұят.
Dialogue: 0,0:04:06.66,0:04:09.11,Default,,0,0,0,,Дұрыс... Дұрыс.
Dialogue: 0,0:04:09.11,0:04:11.44,Default,,0,0,0,,Маған мәліметтерді айтып беріңізші.
Dialogue: 0,0:04:11.44,0:04:14.19,Default,,0,0,0,,Оны аңдардың ішінде кім жасады?
Dialogue: 0,0:04:14.19,0:04:15.65,Default,,0,0,0,,Та... тонта тонна
Dialogue: 0,0:04:15.65,0:04:17.74,Default,,0,0,0,,Дұрыс айтасың, Айми-сан.
Dialogue: 0,0:04:19.19,0:04:20.40,Default,,0,0,0,,Мұқият?
Dialogue: 0,0:04:25.30,0:04:26.11,Default,,0,0,0,,Айми
Dialogue: 0,0:04:28.46,0:04:31.50,Default,,0,0,0,,Қызыл супернова қайтып келді ме?
Dialogue: 0,0:04:31.69,0:04:36.39,Default,,0,0,0,,Олар бір желідегі жоғары сапалы дүкен болып табылатын Maid Sheep-ті жою мүмкін емес.
Dialogue: 0,0:04:36.39,0:04:37.65,Default,,0,0,0,,бір нүкте.
Dialogue: 0,0:04:37.65,0:04:39.53,Default,,0,0,0,,Жоқ, бастапқыда екінші жағы...
Dialogue: 0,0:04:39.53,0:04:40.35,Default,,0,0,0,,Тағы бір нүкте
Dialogue: 0,0:04:40.54,0:04:43.37,Default,,0,0,0,,Сондай-ақ Майдриандық Чукичукицуки-чанның жаншылуына қатысты.
Dialogue: 0,0:04:43.52,0:04:45.13,Default,,0,0,0,,Бізге шағым келіп түсті.
Dialogue: 0,0:04:45.92,0:04:47.23,Default,,0,0,0,,Қазір ме?
Dialogue: 0,0:04:47.23,0:04:49.35,Default,,0,0,0,,Ұсақталғанында ешқандай айырмашылық жоқ.
Dialogue: 0,0:04:49.35,0:04:51.69,Default,,0,0,0,,Бұл форс-мажорлық жағдай ма?
Dialogue: 0,0:04:51.69,0:04:54.04,Default,,0,0,0,,Шошқалар шынымен аң ба?
Dialogue: 0,0:04:54.04,0:04:56.37,Default,,0,0,0,,Өтінемін... хайуан болуға рұқсат етіңізші.
Dialogue: 0,0:04:56.37,0:04:59.22,Default,,0,0,0,,Топқа үлес қосқанда ғана хайуан боласың.
Dialogue: 0,0:05:00.06,0:05:02.05,Default,,0,0,0,,Чуки Чуки Цуки-чанды жаншып тастау оқиғасы
Dialogue: 0,0:05:02.43,0:05:04.28,Default,,0,0,0,,Мэйдрианмен сөйлесіңіз.
Dialogue: 0,0:05:04.59,0:05:05.87,Default,,0,0,0,,Мен осылай айтамын.
Dialogue: 0,0:05:06.42,0:05:10.67,Default,,0,0,0,,Біздің негізгі топтармен қарым-қатынасымыз туралы не айтасыз?
Dialogue: 0,0:05:10.67,0:05:14.04,Default,,0,0,0,,Олай болмаса, шошқалар Акихабарадан жойылады.
Dialogue: 0,0:05:32.85,0:05:33.78,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:38.27,0:05:39.02,Default,,0,0,0,,Сыра
Dialogue: 0,0:05:39.15,0:05:41.72,Default,,0,0,0,,Және соя соусы рамен және катсудон
Dialogue: 0,0:05:43.38,0:05:44.65,Default,,0,0,0,,Құрдас ретінде көрінеді
Dialogue: 0,0:05:45.48,0:05:46.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:46.29,0:05:47.21,Default,,0,0,0,,Иә
Dialogue: 0,0:05:47.52,0:05:50.31,Default,,0,0,0,,Мен бүгін тамақ жеуге келдім.
Dialogue: 0,0:05:50.91,0:05:51.96,Default,,0,0,0,,Екі кесе?
Dialogue: 0,0:05:53.52,0:05:56.23,Default,,0,0,0,,Менің ойымша, Когаана дүкені әлі де сонда.
Dialogue: 0,0:05:56.62,0:06:00.35,Default,,0,0,0,,Қазіргі балалар мұны түсінбейді.
Dialogue: 0,0:06:00.81,0:06:05.13,Default,,0,0,0,,Бұл рамен әлі де бар болғандықтан, мен Акибада аман қала аламын.
Dialogue: 0,0:06:05.79,0:06:08.26,Default,,0,0,0,,Әпке, сіз айтасыз.
Dialogue: 0,0:06:13.76,0:06:14.65,Default,,0,0,0,,Эренді және өздерін көрсетуден басқа амалы қалмаған басқаларды құтқарған адам –
Dialogue: 0,0:06:16.83,0:06:20.19,Default,,0,0,0,,Бәрі жаңа болса жақсы болар еді.
Dialogue: 0,0:06:20.56,0:06:23.66,Default,,0,0,0,,Кейбір нәрселерді өзгертпеу керек.
Dialogue: 0,0:06:24.52,0:06:25.74,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:26.54,0:06:26.89,Default,,0,0,0,,Иә
Dialogue: 0,0:06:30.01,0:06:30.87,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:35.58,0:06:37.21,Default,,0,0,0,,Сондықтан олар қауіпті дейді
Dialogue: 0,0:06:37.34,0:06:38.29,Default,,0,0,0,,Шынымен
Dialogue: 0,0:06:41.33,0:06:43.10,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:06:43.10,0:06:44.96,Default,,0,0,0,,үшін қышиды.
Dialogue: 0,0:06:45.34,0:06:49.18,Default,,0,0,0,,Біздің сериалдағы Қызыл супернова деп аталатын адам қайтып оралғаннан бері.
Dialogue: 0,0:06:49.18,0:06:50.52,Default,,0,0,0,,Өйткені саясат өзгерді
Dialogue: 0,0:06:51.52,0:06:55.55,Default,,0,0,0,,Акиба Үлкен Жарылысын жүзеге асыру үшін жолымызға кедергі келтіретін кез келген нәрсені жою керек.
Dialogue: 0,0:06:56.25,0:06:59.11,Default,,0,0,0,,Сізге Кедамонолендпен күресу керек болуы мүмкін
Dialogue: 0,0:06:59.42,0:07:00.20,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:07:00.88,0:07:03.57,Default,,0,0,0,,Мен Нерула-чанға жақындағым келеді.
Dialogue: 0,0:07:04.88,0:07:05.48,Default,,0,0,0,,Нагоми
Dialogue: 0,0:07:06.07,0:07:07.40,Default,,0,0,0,,Мұқият жинаңыз
Dialogue: 0,0:07:08.39,0:07:09.04,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:07:09.23,0:07:12.31,Default,,0,0,0,,Иә, мен «Invasion Cafe Desu Toron» фильміндегі Нерула-чанмын.
Dialogue: 0,0:07:12.60,0:07:13.96,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:07:15.51,0:07:17.01,Default,,0,0,0,,Мен Тон Токо Тонның менеджерімін.
Dialogue: 0,0:07:17.22,0:07:17.97,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:07:18.34,0:07:19.27,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:07:20.89,0:07:21.81,Default,,0,0,0,,Нагоми Кеттік
Dialogue: 0,0:07:22.38,0:07:23.03,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.24,0:07:23.90,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:24.91,0:07:28.93,Default,,0,0,0,,Сонымен, мен Мэйдрианмен жалғыз айналысуға қалдым.
Dialogue: 0,0:07:28.93,0:07:30.05,Default,,0,0,0,,Қалай?
Dialogue: 0,0:07:30.48,0:07:33.00,Default,,0,0,0,,Қарапайым тілмен айтқанда, мен өлетін едім.
Dialogue: 0,0:07:33.91,0:07:36.68,Default,,0,0,0,,Сонда бізді Кедамонолендте тастап кетті ме?
Dialogue: 0,0:07:36.68,0:07:37.77,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:07:37.94,0:07:40.19,Default,,0,0,0,,5 миллион қой алып қашайық
Dialogue: 0,0:07:40.19,0:07:42.80,Default,,0,0,0,,Сіз қашып құтыла алмайсыз
Dialogue: 0,0:07:42.96,0:07:45.97,Default,,0,0,0,,Сонымен, сіз бұл ақшаны Мэйдрианға кешірім сұрау үшін жұмсағыңыз келе ме?
Dialogue: 0,0:07:45.97,0:07:47.90,Default,,0,0,0,,5 миллион жеткіліксіз.
Dialogue: 0,0:07:48.09,0:07:51.50,Default,,0,0,0,,Мұнда Кедамоноленд деген үлкен топ бар.
Dialogue: 0,0:07:52.38,0:07:53.94,Default,,0,0,0,,Жоғарғы допты алыңыз
Dialogue: 0,0:07:54.19,0:07:55.27,Default,,0,0,0,,Деснеге қастандық
Dialogue: 0,0:07:55.52,0:07:56.42,Default,,0,0,0,,Шынайы өлім
Dialogue: 0,0:07:56.51,0:07:58.12,Default,,0,0,0,,Топтың жоғарғы жағы
Dialogue: 0,0:07:58.24,0:07:59.67,Default,,0,0,0,,Сіздің күзетіңіз қатаң емес пе?
Dialogue: 0,0:07:59.67,0:08:02.92,Default,,0,0,0,,Алдымен Майдрианның басшысы кім?
Dialogue: 0,0:08:03.26,0:08:05.01,Default,,0,0,0,,Қызыл супернова
Dialogue: 0,0:08:05.28,0:08:06.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:06.28,0:08:08.42,Default,,0,0,0,,Әлгі адам қайтып келді
Dialogue: 0,0:08:08.93,0:08:12.12,Default,,0,0,0,,үшін шын жүректен кешірім сұраса, сені кешіретініне сенімдімін.
Dialogue: 0,0:08:12.12,0:08:16.35,Default,,0,0,0,,Сіз мұндай жылы ойдың іске аспайтынын білесіз ғой, солай ма?
Dialogue: 0,0:08:16.48,0:08:18.83,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:08:18.83,0:08:19.70,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:08:19.83,0:08:22.25,Default,,0,0,0,,Сонда да зорлық-зомбылықты ұнатпайсыз, солай ма?
Dialogue: 0,0:08:22.70,0:08:27.42,Default,,0,0,0,,Бірақ күресе алмайтын біреу сізді қорғап өлуі мүмкін.
Dialogue: 0,0:08:29.88,0:08:31.07,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:31.31,0:08:33.28,Default,,0,0,0,,Маған Мэйдриан туралы негізгі ақпаратты беріңізші
Dialogue: 0,0:08:34.10,0:08:35.53,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:08:35.89,0:08:37.10,Default,,0,0,0,,А, ол бұзылды.
Dialogue: 0,0:08:37.10,0:08:38.83,Default,,0,0,0,,Маған айтқаныңыз жақсы болды.
Dialogue: 0,0:08:43.38,0:08:44.62,Default,,0,0,0,,Нагоми Не болды?
Dialogue: 0,0:08:45.14,0:08:47.78,Default,,0,0,0,,Біз шынымен де күресуіміз керек пе?
Dialogue: 0,0:08:48.58,0:08:51.61,Default,,0,0,0,,Мен достарыммен ұрысқым келмейді
Dialogue: 0,0:08:51.92,0:08:53.09,Default,,0,0,0,,Достар…
Dialogue: 0,0:08:53.68,0:08:54.71,Default,,0,0,0,,Мына бала?
Dialogue: 0,0:08:55.20,0:08:58.02,Default,,0,0,0,,Түсіндім, ұрысқың келмейді.
Dialogue: 0,0:08:58.49,0:08:59.89,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:01.09,0:09:02.60,Default,,0,0,0,,Екеуміз апалы-сіңлілі болсақ жақсы емес пе?
Dialogue: 0,0:09:03.08,0:09:06.12,Default,,0,0,0,,Апалы-сіңлілер апалы-сіңлілі байланыс па?
Dialogue: 0,0:09:06.12,0:09:09.96,Default,,0,0,0,,Дұрыс, қызметшілер бір-біріне ант беріп, аты-жөндерін алмастырады.
Dialogue: 0,0:09:10.17,0:09:13.07,Default,,0,0,0,,Бірақ Нерула-чан Майдриан тобынан.
Dialogue: 0,0:09:13.07,0:09:17.02,Default,,0,0,0,,Әрине, мен оны тек өкілден мақұлдауды сұрай алмаймын.
Dialogue: 0,0:09:17.24,0:09:20.83,Default,,0,0,0,,Қызметшілер үшін әпкелік қарым-қатынас өте маңызды екенін білесіз.
Dialogue: 0,0:09:20.83,0:09:22.53,Default,,0,0,0,,Әпкелік байланыс?
Dialogue: 0,0:09:22.81,0:09:25.71,Default,,0,0,0,,Осы дүкенде мен нагоми ата-анасымын.
Dialogue: 0,0:09:25.84,0:09:27.76,Default,,0,0,0,,Мен куәгер ретінде де бәрін жасаймын.
Dialogue: 0,0:09:28.00,0:09:30.60,Default,,0,0,0,,Нерула-чан, сен мені қабылдайсың ба?
Dialogue: 0,0:09:30.60,0:09:32.84,Default,,0,0,0,,Маған берші, біз доспыз, солай ма?
Dialogue: 0,0:09:35.25,0:09:36.13,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:09:37.04,0:09:41.43,Default,,0,0,0,,Басқа тектен шыққан күңмен апалы-сіңлілі болу қауіпті.
Dialogue: 0,0:09:44.70,0:09:49.40,Default,,0,0,0,,Менің тәжірибемнен апалылық абсолютті емес.
Dialogue: 0,0:09:50.41,0:09:52.43,Default,,0,0,0,,Арасиконың да әпкесі болды ма?
Dialogue: 0,0:09:52.89,0:09:53.95,Default,,0,0,0,,Иә, баяғыда
Dialogue: 0,0:09:54.53,0:09:56.62,Default,,0,0,0,,Дәл осы уақытта мен жұмыс істеген дүкенде.
Dialogue: 0,0:09:56.93,0:09:58.21,Default,,0,0,0,,Ол тамаша қызметші болды.
Dialogue: 0,0:09:59.20,0:10:01.17,Default,,0,0,0,,Арашико менің әпкем шығар.
Dialogue: 0,0:10:01.42,0:10:02.72,Default,,0,0,0,,Неліктен қарсылық білдіресіз?
Dialogue: 0,0:10:02.72,0:10:06.41,Default,,0,0,0,,Мичио-сан шешкен саясат тек қорғаныс.
Dialogue: 0,0:10:06.72,0:10:09.42,Default,,0,0,0,,Өз бетімен шығу бұл принципке қайшы.
Dialogue: 0,0:10:09.42,0:10:12.31,Default,,0,0,0,,Бұл дүкенді қорғау Мичионы қорғауды білдіреді.
Dialogue: 0,0:10:12.53,0:10:14.68,Default,,0,0,0,,Сол үшін күресуіміз керек
Dialogue: 0,0:10:14.68,0:10:15.64,Default,,0,0,0,,Мен келіспеймін.
Dialogue: 0,0:10:22.33,0:10:24.57,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:10:25.74,0:10:27.92,Default,,0,0,0,,Арашико қарсылық білдіре ме?
Dialogue: 0,0:10:28.32,0:10:31.17,Default,,0,0,0,,Тонтокотон Майдрианға дұшпандық танытады.
Dialogue: 0,0:10:31.63,0:10:35.53,Default,,0,0,0,,Нерула-санның Нагоми-санға шабуылы сияқты бірдеңе болмайтынына кепілдік жоқ.
Dialogue: 0,0:10:36.33,0:10:39.92,Default,,0,0,0,,Сонда да мен Нерула жағындамын.
Dialogue: 0,0:10:43.81,0:10:44.77,Default,,0,0,0,,Нагоми-чан
Dialogue: 0,0:10:45.17,0:10:46.52,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:10:47.91,0:10:50.49,Default,,0,0,0,,Ух...
Dialogue: 0,0:10:51.36,0:10:53.84,Default,,0,0,0,,...
Dialogue: 0,0:10:54.95,0:10:55.76,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:55.76,0:10:57.21,Default,,0,0,0,,Десең де…
Dialogue: 0,0:10:57.81,0:11:00.10,Default,,0,0,0,,Мен және Нагоми-чан әр түрлі серияданбыз.
Dialogue: 0,0:11:00.10,0:11:01.87,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:11:04.72,0:11:05.80,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:11:06.39,0:11:07.92,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:11:08.08,0:11:11.07,Default,,0,0,0,,Мен Неруламен әпке болып, мәңгілік дос болғым келеді.
Dialogue: 0,0:11:18.31,0:11:21.09,Default,,0,0,0,,Мен үлкен әпке боламын.
Dialogue: 0,0:11:22.21,0:11:24.51,Default,,0,0,0,,Нагоми-чанмен апалы-сіңлілі болу
Dialogue: 0,0:11:24.95,0:11:28.68,Default,,0,0,0,,Жақсы, мен сізді қабылдамауы мүмкін деп ойладым.
Dialogue: 0,0:11:28.68,0:11:32.78,Default,,0,0,0,,Жоғарғы басшылық не ойласа да, мен алға қарай ұмтыламын.
Dialogue: 0,0:11:37.33,0:11:38.66,Default,,0,0,0,,Эренді және өздерін көрсетуден басқа амалы қалмаған басқаларды құтқарған адам –
Dialogue: 0,0:11:55.64,0:11:57.11,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:11:57.66,0:11:59.28,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:11:59.45,0:12:03.64,Default,,0,0,0,,Екі әпкенің қарым-қатынасы ұзақ жылдарға жалғаса берсін.
Dialogue: 0,0:12:04.99,0:12:06.62,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:12:15.92,0:12:17.36,Default,,0,0,0,,Рамен өседі
Dialogue: 0,0:12:17.56,0:12:18.01,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.03,0:12:21.86,Default,,0,0,0,,Сен генерал болуға үйреніп қалғансың.
Dialogue: 0,0:12:22.47,0:12:23.46,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:12:23.74,0:12:25.66,Default,,0,0,0,,Нагоми-чан, өтінемін, шар сиу алыңыз
Dialogue: 0,0:12:27.41,0:12:29.02,Default,,0,0,0,,Нерула-чан, жұмыртқа алыңыз.
Dialogue: 0,0:12:32.87,0:12:35.71,Default,,0,0,0,,Шошқа қорасын үнемі жойыңыз
Dialogue: 0,0:12:36.02,0:12:37.75,Default,,0,0,0,,Оны зорлықпен қолданыңыз
Dialogue: 0,0:12:38.73,0:12:41.91,Default,,0,0,0,,Әй, айтар сөзің болса, айт.
Dialogue: 0,0:12:42.28,0:12:44.69,Default,,0,0,0,,Бұл сіздің осында болған кездегідей емес.
Dialogue: 0,0:12:44.69,0:12:46.47,Default,,0,0,0,,Қазіргідей жақсы.
Dialogue: 0,0:12:46.47,0:12:48.79,Default,,0,0,0,,Аңдардан жақсы қашықтықты сақтай білдіңіз.
Dialogue: 0,0:12:48.95,0:12:52.46,Default,,0,0,0,,...
Dialogue: 0,0:12:52.62,0:12:53.81,Default,,0,0,0,,Қаласаңыз ше?
Dialogue: 0,0:12:54.08,0:12:58.39,Default,,0,0,0,,Чуки Чуки Цуки-чан езілгеннен кейін үнсіз қалған әлжуаз бөтен адам сияқты.
Dialogue: 0,0:12:58.39,0:13:00.51,Default,,0,0,0,,Сіздің ойыңызша, Акиба Үлкен жарылыс болуы мүмкін бе?
Dialogue: 0,0:13:00.71,0:13:03.44,Default,,0,0,0,,Акиба Үлкен жарылыс дегеніміз не?
Dialogue: 0,0:13:10.04,0:13:11.90,Default,,0,0,0,,Бұл Акиба Үлкен жарылыс
Dialogue: 0,0:13:11.90,0:13:14.98,Default,,0,0,0,,Егер сіз Мэйдрианға барып, бұл туралы білмесеңіз.
Dialogue: 0,0:13:14.98,0:13:19.43,Default,,0,0,0,,Мейдриан - Акихабарадан тыс басқыншы.
Dialogue: 0,0:13:19.43,0:13:22.85,Default,,0,0,0,,Жылы күң тыныштық теңізіне батады.
Dialogue: 0,0:13:25.46,0:13:30.52,Default,,0,0,0,,Дүкеніңіздегі шошқаларды өлтіргеннен кейін, олар сізге импланттарды береді.
Dialogue: 0,0:13:37.99,0:13:41.78,Default,,0,0,0,,Біздің апалы-сіңлілі екеніміз Нагоми апалы екенімізді білдіреді.
Dialogue: 0,0:13:41.78,0:13:44.41,Default,,0,0,0,,Басқаша айтқанда, менің баламмен бірдей.
Dialogue: 0,0:13:44.76,0:13:46.64,Default,,0,0,0,,Келесі жолы бізге қонаққа келейік.
Dialogue: 0,0:13:46.64,0:13:48.50,Default,,0,0,0,,Бұл қазір қауіпті.
Dialogue: 0,0:13:48.50,0:13:50.81,Default,,0,0,0,,Мен жай ғана келіп көңіл көтеруіңізді сұраймын.
Dialogue: 0,0:13:51.04,0:13:53.28,Default,,0,0,0,,Мен бұл туралы көп айтқым келеді.
Dialogue: 0,0:13:53.46,0:13:55.34,Default,,0,0,0,,Нерула-чанның дүкені туралы.
Dialogue: 0,0:13:55.34,0:13:57.28,Default,,0,0,0,,Мэйдриан туралы бірдеңе.
Dialogue: 0,0:13:57.28,0:13:58.15,Default,,0,0,0,,Менеджер?
Dialogue: 0,0:13:58.32,0:14:01.15,Default,,0,0,0,,Апалы-сіңлілердің келісімшартты пайдалануы мүмкін емес
Dialogue: 0,0:14:01.15,0:14:03.14,Default,,0,0,0,,Бұл жалғыз жол
Dialogue: 0,0:14:03.14,0:14:05.55,Default,,0,0,0,,Мен оқиғаны мүлдем көре алмаймын.
Dialogue: 0,0:14:05.55,0:14:06.41,Default,,0,0,0,,Шпион Десне
Dialogue: 0,0:14:07.74,0:14:10.89,Default,,0,0,0,,Мен Мэйдриан өкілі туралы білгім келеді.
Dialogue: 0,0:14:10.89,0:14:14.71,Default,,0,0,0,,Қараңдаршы, Мейдриан мен сардина мен кит сияқты біздің арамызда айырмашылық бар.
Dialogue: 0,0:14:14.71,0:14:16.30,Default,,0,0,0,,Ақпарат маңызды, солай ма?
Dialogue: 0,0:14:16.95,0:14:18.20,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:14:18.67,0:14:20.51,Default,,0,0,0,,Бұл адам ретінде біртүрлі емес пе?
Dialogue: 0,0:14:20.51,0:14:23.06,Default,,0,0,0,,Осылай кете берсек, бәрімізді өлтіретінімізді білемін.
Dialogue: 0,0:14:23.32,0:14:25.96,Default,,0,0,0,,Мен Нагомидің ата-анасы сияқтымын.
Dialogue: 0,0:14:26.18,0:14:28.06,Default,,0,0,0,,Ата-анаңа мейірімді бол.
Dialogue: 0,0:14:28.28,0:14:31.18,Default,,0,0,0,,Шынында да, бұл жалғыз серпіліс болуы мүмкін.
Dialogue: 0,0:14:31.18,0:14:33.01,Default,,0,0,0,,Бұл жағдай.
Dialogue: 0,0:14:33.01,0:14:34.44,Default,,0,0,0,,SPY өлімге байланысты
Dialogue: 0,0:14:34.63,0:14:37.15,Default,,0,0,0,,Нагоми, өтінемін
Dialogue: 0,0:14:37.15,0:14:38.19,Default,,0,0,0,,Адам кім болса да, тек реакцияның өзі
Dialogue: 0,0:14:38.66,0:14:41.65,Default,,0,0,0,,Қазір менің қызметші ретіндегі мақтанышымның сыналатын кезі.
Dialogue: 0,0:14:42.10,0:14:45.46,Default,,0,0,0,,Мейдриан ретінде әрқайсысың не істеу керек болса, соны істе.
Dialogue: 0,0:14:46.01,0:14:49.09,Default,,0,0,0,,Аңдар басып қалған Чукичуки Цукичанның оқиғасы
Dialogue: 0,0:14:49.29,0:14:50.45,Default,,0,0,0,,Шошқаны өлтіріңіз
Dialogue: 0,0:14:50.89,0:14:53.96,Default,,0,0,0,,Әлемге Акибадан тыс тірі формалардың өркениеттік күшін көрсету.
Dialogue: 0,0:14:54.19,0:14:57.10,Default,,0,0,0,,Мұны Акихабарадан аңдарды қуып шығу үшін тірек ретінде пайдаланыңыз.
Dialogue: 0,0:14:57.40,0:14:58.91,Default,,0,0,0,,Әлемдер соғысы жақын
Dialogue: 0,0:15:08.24,0:15:11.10,Default,,0,0,0,,Бұл айда біздің жұлдызды жемістер жәрмеңкесі.
Dialogue: 0,0:15:11.77,0:15:13.25,Default,,0,0,0,,Дәмді көрінеді.
Dialogue: 0,0:15:13.40,0:15:15.48,Default,,0,0,0,,Учиха Мутегитонтеги оқиғасы
Dialogue: 0,0:15:16.35,0:15:17.48,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:15:19.62,0:15:22.37,Default,,0,0,0,,Білесіз бе, келесі жолы менің дүкеніме келіңіз...
Dialogue: 0,0:15:23.50,0:15:24.32,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:24.32,0:15:26.67,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:15:27.66,0:15:28.21,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:15:31.21,0:15:32.76,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:44.67,0:15:47.18,Default,,0,0,0,,Бұл оның орнына бізді нысанаға алғанын білдіре ме?
Dialogue: 0,0:15:47.59,0:15:50.84,Default,,0,0,0,,Бізді талқандап, жаппай соғыс ашпақ болдыңыз ба?
Dialogue: 0,0:15:51.05,0:15:52.53,Default,,0,0,0,,Маңызды ақпарат
Dialogue: 0,0:15:52.53,0:15:55.06,Default,,0,0,0,,Онсыз ол біржақты болар еді
Dialogue: 0,0:15:55.06,0:15:57.08,Default,,0,0,0,,Шынымды айтсам, мен риза емеспін.
Dialogue: 0,0:15:57.08,0:15:58.56,Default,,0,0,0,,SPY-ге рахмет
Dialogue: 0,0:15:58.56,0:16:01.22,Default,,0,0,0,,Нагоми Рахмет саған, перзент қызы
Dialogue: 0,0:16:01.22,0:16:02.73,Default,,0,0,0,,Мен ештеңе істеген жоқпын
Dialogue: 0,0:16:03.28,0:16:04.67,Default,,0,0,0,,Дайын бол.
Dialogue: 0,0:16:06.24,0:16:07.78,Default,,0,0,0,,Айми-санның декосуке
Dialogue: 0,0:16:10.49,0:16:14.57,Default,,0,0,0,,Не болса да, мен өкілдің міндетін атқарушы болып тағайындалдым.
Dialogue: 0,0:16:14.57,0:16:16.29,Default,,0,0,0,,Сәлемдесуіңізді өтінемін.
Dialogue: 0,0:16:16.79,0:16:17.38,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:16:17.85,0:16:21.21,Default,,0,0,0,,Жақында Кедамонолендпен көңіл көтеретініңді естідім, солай ма?
Dialogue: 0,0:16:21.81,0:16:24.20,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:16:24.20,0:16:26.61,Default,,0,0,0,,Жоқ, кеңес болды.
Dialogue: 0,0:16:27.20,0:16:31.64,Default,,0,0,0,,Полиция тергеу жүргізбесе, азаматтар ашуланады.
Dialogue: 0,0:16:32.16,0:16:35.68,Default,,0,0,0,,Бірақ Мэйдриан мырзаның мінезі өте жақсы.
Dialogue: 0,0:16:36.08,0:16:38.75,Default,,0,0,0,,Детектив-сан, біз де қайтып келдік.
Dialogue: 0,0:16:38.75,0:16:42.06,Default,,0,0,0,,Мен Шоуа-дори немесе Электр Таунының шығуын білмеймін.
Dialogue: 0,0:16:42.53,0:16:45.73,Default,,0,0,0,,Нұсқауларыңыз үшін рахмет.
Dialogue: 0,0:17:00.90,0:17:03.55,Default,,0,0,0,,Ақшаны ысырап ету, бірақ қайда ағып кетті?
Dialogue: 0,0:17:03.73,0:17:05.91,Default,,0,0,0,,Жоғалған егеуқұйрықты табыңыз.
Dialogue: 0,0:17:06.20,0:17:06.82,Default,,0,0,0,,Иә
Dialogue: 0,0:17:07.31,0:17:11.10,Default,,0,0,0,,Айтпақшы, кеше Майдрианның штабына полиция келген сияқты.
Dialogue: 0,0:17:11.73,0:17:12.89,Default,,0,0,0,,Сонда сізге енді шабуыл жасалмайды ма?
Dialogue: 0,0:17:12.96,0:17:14.34,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:17:14.67,0:17:16.77,Default,,0,0,0,,Мен әлі біразға дейін жеңілдене алмаймын.
Dialogue: 0,0:17:17.43,0:17:19.34,Default,,0,0,0,,Ешқашан жалғыз болма
Dialogue: 0,0:17:19.92,0:17:23.68,Default,,0,0,0,,Мен Неруламен жазбаны алған күннен бастап хабарласа алмадым.
Dialogue: 0,0:17:24.11,0:17:27.28,Default,,0,0,0,,Сен... сенің жақсы болатыныңа сенімдімін. Сен мықты баласың.
Dialogue: 0,0:17:27.28,0:17:29.32,Default,,0,0,0,,Мен адамдарға көзім жеткендіктен айта аламын.
Dialogue: 0,0:17:29.81,0:17:32.99,Default,,0,0,0,,Нагоми-сан Нерула-санды тапқысы келеді ме?
Dialogue: 0,0:17:33.69,0:17:35.69,Default,,0,0,0,,Қолымнан келгенін істегім келеді.
Dialogue: 0,0:17:36.10,0:17:38.44,Default,,0,0,0,,Ал, мен ертең сенімен серуендеймін.
Dialogue: 0,0:17:39.33,0:17:41.46,Default,,0,0,0,,Енді мені нысанаға алып жатыр,
Dialogue: 0,0:17:41.76,0:17:42.90,Default,,0,0,0,,Қырағылық қажет
Dialogue: 0,0:17:44.11,0:17:44.80,Default,,0,0,0,,Иә
Dialogue: 0,0:17:47.83,0:17:49.52,Default,,0,0,0,,Мен бұл жігіт екеніне сенімдімін.
Dialogue: 0,0:17:52.48,0:17:53.69,Default,,0,0,0,,Шиго Сентона
Dialogue: 0,0:17:54.22,0:17:55.40,Default,,0,0,0,,Қазірдің өзінде қуғында
Dialogue: 0,0:18:00.40,0:18:03.03,Default,,0,0,0,,Нерула-чан бүгін де болған жоқ.
Dialogue: 0,0:18:03.39,0:18:05.43,Default,,0,0,0,,Нагоми-сан, сен соңғы уақытта ұйықтадың ба?
Dialogue: 0,0:18:05.72,0:18:07.21,Default,,0,0,0,,Жоқ, мен уайымдап тұрмын.
Dialogue: 0,0:18:07.84,0:18:08.53,Default,,0,0,0,,Ал сендерге келсек, капитан Леви міндетті түрде
Dialogue: 0,0:18:09.57,0:18:10.82,Default,,0,0,0,,Ол қауіпсіз.
Dialogue: 0,0:18:11.08,0:18:12.86,Default,,0,0,0,,Нерула-чанды кездестірдіңіз бе?
Dialogue: 0,0:18:13.08,0:18:13.78,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:14.26,0:18:15.83,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:18:26.80,0:18:27.56,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:18:28.16,0:18:29.76,Default,,0,0,0,,Нагоми-чан, неге?
Dialogue: 0,0:18:31.86,0:18:33.59,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:18:35.27,0:18:37.15,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:18:39.26,0:18:40.95,Default,,0,0,0,,Сіз мені іздеп жүрсіз.
Dialogue: 0,0:18:41.51,0:18:43.24,Default,,0,0,0,,Себебі мен Мэйдрианға опасыздық жасадым
Dialogue: 0,0:18:43.77,0:18:45.21,Default,,0,0,0,,Бұл менің кінәм бе?
Dialogue: 0,0:18:45.21,0:18:48.28,Default,,0,0,0,,Жоқ, мен мұны істегім келді.
Dialogue: 0,0:18:49.44,0:18:51.56,Default,,0,0,0,,Мен сенің жүзіңді көргеніме қуаныштымын.
Dialogue: 0,0:18:51.56,0:18:52.73,Default,,0,0,0,,Соңғысы...
Dialogue: 0,0:18:53.08,0:18:55.88,Default,,0,0,0,,Мен қызметшіге жабысамын
Dialogue: 0,0:18:57.71,0:18:59.22,Default,,0,0,0,,Ал егер
Dialogue: 0,0:18:59.38,0:19:01.79,Default,,0,0,0,,Шошқалармен қыдырудың не керегі бар?
Dialogue: 0,0:19:04.82,0:19:06.17,Default,,0,0,0,,Шағын әңгіме
Dialogue: 0,0:19:06.51,0:19:10.08,Default,,0,0,0,,Өз бетіңізше не істеу керектігін білесіз бе?
Dialogue: 0,0:19:10.25,0:19:12.76,Default,,0,0,0,,Шошқа етін піскеннен кейін сараңдық танытып
Dialogue: 0,0:19:13.77,0:19:15.07,Default,,0,0,0,,Кеджиме қоса беріледі
Dialogue: 0,0:19:15.47,0:19:16.82,Default,,0,0,0,,Нагоми-сан, кеттік.
Dialogue: 0,0:19:16.82,0:19:18.11,Default,,0,0,0,,Kejime дегеніміз не?
Dialogue: 0,0:19:18.25,0:19:20.24,Default,,0,0,0,,Бұл Мэйдриан мәселесі
Dialogue: 0,0:19:21.44,0:19:24.09,Default,,0,0,0,,Бұл мен рамен дүкенінде танысқан қыз.
Dialogue: 0,0:19:24.46,0:19:27.48,Default,,0,0,0,,Ұят болды, жақсы араласып кеттік деп ойладым.
Dialogue: 0,0:19:27.66,0:19:29.23,Default,,0,0,0,,Мен де өзімді аяймын.
Dialogue: 0,0:19:29.61,0:19:31.73,Default,,0,0,0,,Бұл да байланыстың бір түрі.
Dialogue: 0,0:19:31.92,0:19:34.61,Default,,0,0,0,,Мен Кедамоно жерін түгел қиратамын.
Dialogue: 0,0:19:41.50,0:19:42.47,Default,,0,0,0,,Теме
Dialogue: 0,0:19:42.47,0:19:45.42,Default,,0,0,0,,Сен мұны Яппа үшін кім алып кететінін білесің бе?
Dialogue: 0,0:19:45.65,0:19:46.96,Default,,0,0,0,,Қызыл супернова
Dialogue: 0,0:19:47.74,0:19:49.02,Default,,0,0,0,,Маған өлуге рұқсат етіңіз
Dialogue: 0,0:19:50.87,0:19:54.03,Default,,0,0,0,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,0:19:56.70,0:19:58.09,Default,,0,0,0,,Мияби Қолыңды шығарма
Dialogue: 0,0:20:05.12,0:20:07.21,Default,,0,0,0,,Мені қашанға дейін ұстайсың?
Dialogue: 0,0:20:11.97,0:20:12.86,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:20:12.98,0:20:13.63,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:20:19.84,0:20:20.98,Default,,0,0,0,,өлтіру
Dialogue: 0,0:20:22.42,0:20:24.62,Default,,0,0,0,,Taigiiyacchano
Dialogue: 0,0:20:24.98,0:20:26.97,Default,,0,0,0,,Арашико-сан, Нерула-чанға көмектес
Dialogue: 0,0:20:27.17,0:20:28.79,Default,,0,0,0,,Бұл мәселе сонда.
Dialogue: 0,0:20:28.79,0:20:30.62,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, Нерула-чан...
Dialogue: 0,0:20:30.85,0:20:32.56,Default,,0,0,0,,Мынау Ақибаның күңі.
Dialogue: 0,0:20:32.73,0:20:34.77,Default,,0,0,0,,Нерула-сан да дайындалды.
Dialogue: 0,0:20:34.77,0:20:36.35,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:36.70,0:20:38.83,Default,,0,0,0,,Нерула-чан менің әпкем
Dialogue: 0,0:20:39.88,0:20:42.19,Default,,0,0,0,,Осы сөздердің өзі жеткілікті.
Dialogue: 0,0:20:50.30,0:20:54.00,Default,,0,0,0,,Сатқындардың барар жері тозақ.
Dialogue: 0,0:20:57.44,0:20:59.20,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:57.66,0:20:58.32,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:21:09.44,0:21:10.20,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:21:11.69,0:21:12.32,Default,,0,0,0,,Нерула-чан
Dialogue: 0,0:21:14.47,0:21:14.96,Default,,0,0,0,,Өтірік
Dialogue: 0,0:21:15.57,0:21:16.72,Default,,0,0,0,,Өтірік жоқ
Dialogue: 0,0:21:17.33,0:21:20.29,Default,,0,0,0,,Енді араласу орынсыз емес пе?
Dialogue: 0,0:21:23.50,0:21:24.56,Default,,0,0,0,,Оны түсіріңіз
Dialogue: 0,0:21:25.36,0:21:27.34,Default,,0,0,0,,Мен жылаудан басқа ештеңе істей алмаймын.
Dialogue: 0,0:21:27.34,0:21:29.51,Default,,0,0,0,,Би шынымен қызметші ме?
Dialogue: 0,0:21:31.02,0:21:32.92,Default,,0,0,0,,Аймидің декосуке
Dialogue: 0,0:21:34.27,0:21:36.22,Default,,0,0,0,,Бүгін емес
Dialogue: 0,0:21:36.22,0:21:40.37,Default,,0,0,0,,Ұмытпа, соғыс басталғалы жатыр.
Dialogue: 0,0:21:43.37,0:21:45.28,Default,,0,0,0,,Не істеймін, тоқтай алмаймын
Dialogue: 0,0:21:45.72,0:21:46.91,Default,,0,0,0,,Нагоми-чан
Dialogue: 0,0:21:49.28,0:21:52.37,Default,,0,0,0,,Қатысқаным үшін кешірім сұраймыз.
Dialogue: 0,0:21:52.86,0:21:54.51,Default,,0,0,0,,Мұндай жерде дүкен ашу—
Dialogue: 0,0:21:54.90,0:21:55.71,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:21:57.66,0:22:02.28,Default,,0,0,0,,Мен біраз өмір сүргенімді қалаймын
Dialogue: 0,0:22:08.96,0:22:12.88,Default,,0,0,0,,Өзіңіздей болыңыз
Dialogue: 0,0:22:16.42,0:22:19.69,Default,,0,0,0,,Қызметші ретінде...
Dialogue: 0,0:22:20.42,0:22:22.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:24.41,0:22:30.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
