Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.78,0:00:02.54,Default,,0,0,0,,Басында, басында
Dialogue: 0,0:00:02.69,0:00:05.99,Default,,0,0,0,,Импульстің жоғарылауы, жүректің қозуы
Dialogue: 0,0:00:06.65,0:00:08.75,Default,,0,0,0,,Жапонияның бірінші қызметшісі «Омоэ»
Dialogue: 0,0:00:09.36,0:00:12.70,Default,,0,0,0,,Таптық жүйе әлі де күшті болған Мэйдзи дәуірінің басында
Dialogue: 0,0:00:12.99,0:00:16.70,Default,,0,0,0,,Барлық тұтынушыларға бірдей қызмет көрсетіңіз.
Dialogue: 0,0:00:16.97,0:00:20.87,Default,,0,0,0,,Акихабанохара халқын зорлық-зомбылық пен моемен баурап алды
Dialogue: 0,0:00:21.67,0:00:22.73,Default,,0,0,0,,Омое қайтыс болғаннан кейін
Dialogue: 0,0:00:23.06,0:00:27.82,Default,,0,0,0,,Оны құрметтеу үшін «Омоэ-сама Нобори» фестивалі өтті.
Dialogue: 0,0:00:28.26,0:00:30.70,Default,,0,0,0,,Қызметшілер өздерінің беделіне қауіп төндіреді
Dialogue: 0,0:00:30.87,0:00:33.50,Default,,0,0,0,,Бұл сіз шыңға таласатын жекпе-жек фестивалі.
Dialogue: 0,0:02:06.05,0:02:08.98,Default,,0,0,0,,Сіз ақша тауып жатқан сияқтысыз, ханым.
Dialogue: 0,0:02:09.17,0:02:10.30,Default,,0,0,0,,Бас айналу
Dialogue: 0,0:02:10.30,0:02:12.78,Default,,0,0,0,,Бірақ мен де жаман өсек естідім.
Dialogue: 0,0:02:12.95,0:02:15.74,Default,,0,0,0,,Сіздің әпкеңіздің дүкені тұтынушыларды тартуға тырысады деп естідім.
Dialogue: 0,0:02:16.49,0:02:19.18,Default,,0,0,0,,Жоқ, әрине мен Құматанға сенбеймін.
Dialogue: 0,0:02:19.43,0:02:22.11,Default,,0,0,0,,Бірақ бұл Наги-саманың құлағына жетсе
Dialogue: 0,0:02:22.11,0:02:24.45,Default,,0,0,0,,Мен мысықты тұлыпқа айналдырамын.
Dialogue: 0,0:02:24.45,0:02:25.82,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:02:26.01,0:02:29.37,Default,,0,0,0,,Қалың қабығын аршып, шамисен жасаймын.
Dialogue: 0,0:02:37.68,0:02:38.44,Default,,0,0,0,,Отырыңыз
Dialogue: 0,0:02:38.70,0:02:39.13,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:02:41.27,0:02:43.01,Default,,0,0,0,,Биылғы Акиба қыз фестивалі
Dialogue: 0,0:02:43.58,0:02:46.48,Default,,0,0,0,,Бұл тек Kedamonoland тобы ұйымдастыратын ерекше оқиға.
Dialogue: 0,0:02:46.95,0:02:49.41,Default,,0,0,0,,Енді көзді ашатын жат планеталықтар жоқ.
Dialogue: 0,0:02:49.41,0:02:53.77,Default,,0,0,0,,Бұл фестивальді бір топ басқаратын Акихабара тарихында бірінші рет.
Dialogue: 0,0:02:54.20,0:02:56.29,Default,,0,0,0,,Иә, әсіресе Омое-сама өрмелеу
Dialogue: 0,0:02:56.62,0:02:58.40,Default,,0,0,0,,Орнатуды мұқият басқарыңыз
Dialogue: 0,0:02:58.70,0:03:01.96,Default,,0,0,0,,Наги-саманың тікелей басқаратын дүкені «Гираги арыстаны» жеңеді.
Dialogue: 0,0:03:02.17,0:03:04.29,Default,,0,0,0,,Біз мұны барлық дүкендерге айтып отырмыз
Dialogue: 0,0:03:04.75,0:03:05.79,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:03:06.14,0:03:09.77,Default,,0,0,0,,Акихабарадағы аңдардың абсолютті экожүйесін көрсету
Dialogue: 0,0:03:11.46,0:03:12.80,Default,,0,0,0,,Керемет
Dialogue: 0,0:03:13.23,0:03:14.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:14.56,0:03:17.75,Default,,0,0,0,,Құрметті Омое, фестиваль соңында бәріміз жоғары көтерілдік.
Dialogue: 0,0:03:17.75,0:03:19.01,Default,,0,0,0,,Миссия аяқталды
Dialogue: 0,0:03:19.20,0:03:22.43,Default,,0,0,0,,Бұл төбелес фестивалі, онда қызметшілер бір-бірін тепкілейді.
Dialogue: 0,0:03:22.90,0:03:23.93,Default,,0,0,0,,Ұрыс...
Dialogue: 0,0:03:23.93,0:03:26.60,Default,,0,0,0,,Жеңімпаз қыз келесі жылы Мое-сама болады.
Dialogue: 0,0:03:26.76,0:03:29.50,Default,,0,0,0,,Егер бұл орын алса, топ ішінде сізге ұнамды болады.
Dialogue: 0,0:03:29.50,0:03:30.70,Default,,0,0,0,,Дүкен танымал бола бастайды
Dialogue: 0,0:03:31.41,0:03:33.08,Default,,0,0,0,,Олай болса барымызды салайық.
Dialogue: 0,0:03:33.08,0:03:33.82,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:03:34.43,0:03:37.97,Default,,0,0,0,,Omoe-sama Nobori үшін бастапқы тапсырыс - дүңгіршектерді сату тәртібі.
Dialogue: 0,0:03:38.29,0:03:41.45,Default,,0,0,0,,Өткен жылы ол басталмай тұрып шешілді.
Dialogue: 0,0:03:41.74,0:03:43.93,Default,,0,0,0,,Бірақ егер сіз өзіңіздің азық-түлік дүкеніңізді сатуға тырыссаңыз ...
Dialogue: 0,0:03:44.87,0:03:47.59,Default,,0,0,0,,Мен шошқаның иісі бар деп ойладым, бірақ шошқа бар.
Dialogue: 0,0:03:47.81,0:03:49.08,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:03:50.27,0:03:52.47,Default,,0,0,0,,Қандай шошқа, сөйлеме.
Dialogue: 0,0:03:52.47,0:03:55.71,Default,,0,0,0,,Соңғы кездері олар шошқа етін шошқа етімен бірге жейтін сияқты.
Dialogue: 0,0:03:55.94,0:03:57.81,Default,,0,0,0,,Чошиге мініп бара жатқан сияқты.
Dialogue: 0,0:03:58.05,0:03:59.43,Default,,0,0,0,,Үш Құдайханымды адам қолымен ластау—
Dialogue: 0,0:03:59.65,0:04:03.46,Default,,0,0,0,,Бір-екі мықты күң кіргенін қате түсіндім.
Dialogue: 0,0:04:03.46,0:04:04.52,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:04:04.52,0:04:05.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:05.70,0:04:08.56,Default,,0,0,0,,Сіз шошқалар әрқашан төменгі жағында боласыз.
Dialogue: 0,0:04:08.56,0:04:11.35,Default,,0,0,0,,Сіз басқа аффилиирленген дүкендермен дауласа аласыз.
Dialogue: 0,0:04:11.57,0:04:13.53,Default,,0,0,0,,Тек хайуандық иерархияны қорғаңыз.
Dialogue: 0,0:04:16.74,0:04:17.67,Default,,0,0,0,,Окачимачи мырза
Dialogue: 0,0:04:18.18,0:04:19.30,Default,,0,0,0,,Су Су
Dialogue: 0,0:04:20.91,0:04:22.39,Default,,0,0,0,,Сіз қорқынышты істер жасайсыз.
Dialogue: 0,0:04:23.04,0:04:25.72,Default,,0,0,0,,Астыңғы қызметші дәмхананың тағдыры қандай?
Dialogue: 0,0:04:25.72,0:04:29.37,Default,,0,0,0,,Мен тек фестивальдерде аффилирленген дүкендердің қызметшілерін кездестіремін.
Dialogue: 0,0:04:29.37,0:04:32.09,Default,,0,0,0,,Жыл сайын мен осы сәтте айқайлаймын.
Dialogue: 0,0:04:32.30,0:04:34.67,Default,,0,0,0,,Бізге не істеу керектігін айта беретіндей емес.
Dialogue: 0,0:04:35.02,0:04:37.83,Default,,0,0,0,,Жоғарыдағы дүкенге қарсы шығудың қажеті жоқ.
Dialogue: 0,0:04:37.83,0:04:38.85,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:38.85,0:04:41.43,Default,,0,0,0,,Ал сіз қанды қақтығыстарды ұнатпайсыз.
Dialogue: 0,0:04:41.65,0:04:43.68,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:04:43.98,0:04:46.83,Default,,0,0,0,,Енді шатырды бітіріп, Арашикоға және басқаларға көмектесуге оралыңыз.
Dialogue: 0,0:04:47.69,0:04:49.86,Default,,0,0,0,,Бұл биылғы фестивальге арналған нұсқаулық
Dialogue: 0,0:04:50.51,0:04:51.99,Default,,0,0,0,,Мұқият оқып шығыңыз
Dialogue: 0,0:04:52.63,0:04:53.48,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:04:53.88,0:04:56.27,Default,,0,0,0,,Биыл ерекше мереке
Dialogue: 0,0:04:56.81,0:04:58.82,Default,,0,0,0,,Барлық элементтерді сөзбен оқу
Dialogue: 0,0:04:59.08,0:05:01.77,Default,,0,0,0,,Шошқа қорасындағы барлық қызметшілерге беру керек.
Dialogue: 0,0:05:01.77,0:05:02.69,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:05:08.76,0:05:09.73,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:10.18,0:05:12.60,Default,,0,0,0,,Тіпті шошқаның кішкентай миы да түсінеді...
Dialogue: 0,0:05:14.72,0:05:15.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:18.71,0:05:19.77,Default,,0,0,0,,Чисса
Dialogue: 0,0:05:20.06,0:05:20.72,Default,,0,0,0,,Менеджер?
Dialogue: 0,0:05:21.61,0:05:22.71,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:05:23.75,0:05:24.61,Default,,0,0,0,,Шошқаның аяғы?
Dialogue: 0,0:05:24.94,0:05:26.47,Default,,0,0,0,,Өткен жылы бұл түсті торай болды.
Dialogue: 0,0:05:26.80,0:05:28.04,Default,,0,0,0,,Жағалы торай?
Dialogue: 0,0:05:28.16,0:05:29.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:29.35,0:05:32.48,Default,,0,0,0,,Фестиваль болса, мұз, алма кәмпит, т.б. қырынуға болады...
Dialogue: 0,0:05:32.48,0:05:34.66,Default,,0,0,0,,Мұндай нәрсені жоғарыдағы дүкен алады.
Dialogue: 0,0:05:34.91,0:05:36.79,Default,,0,0,0,,Ол түбіне қайтып оралмайды
Dialogue: 0,0:05:36.79,0:05:37.98,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:38.24,0:05:41.56,Default,,0,0,0,,Жақсы, себебі ол коллагенге толы.
Dialogue: 0,0:05:42.24,0:05:44.06,Default,,0,0,0,,Түбі қай жерде?
Dialogue: 0,0:05:45.59,0:05:47.81,Default,,0,0,0,,Топтарда «мо-мое иерархиясы» бар ма?
Dialogue: 0,0:05:48.19,0:05:50.95,Default,,0,0,0,,Олардың ішінде біз ең төменміз.
Dialogue: 0,0:05:51.45,0:05:53.53,Default,,0,0,0,,Біз неге төменміз?
Dialogue: 0,0:05:53.82,0:05:54.83,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:55.31,0:05:58.70,Default,,0,0,0,,Орта мектептің кесірінен қолым кір болды, отоши-чан көп болды.
Dialogue: 0,0:05:58.81,0:06:02.34,Default,,0,0,0,,Үлкен қызметшімен әпкесі бар дүкен
Dialogue: 0,0:06:02.52,0:06:04.56,Default,,0,0,0,,Бәрі біткенше, ол төменде.
Dialogue: 0,0:06:04.70,0:06:05.38,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:06.21,0:06:07.54,Default,,0,0,0,,Мен оның қалай жұмыс істейтінін түсінемін.
Dialogue: 0,0:06:07.91,0:06:08.74,Default,,0,0,0,,Төменгі…
Dialogue: 0,0:06:08.74,0:06:10.21,Default,,0,0,0,,Мен енді бұл туралы айтуды тоқтатпаймын.
Dialogue: 0,0:06:10.21,0:06:11.73,Default,,0,0,0,,Менің көңіл-күйім түсіп кетті.
Dialogue: 0,0:06:11.85,0:06:15.07,Default,,0,0,0,,Иә, фестиваль кезінде шыдамдылық таныту керек.
Dialogue: 0,0:06:15.07,0:06:16.69,Default,,0,0,0,,Ендеше, сабырлы бол, сабырлы бол.
Dialogue: 0,0:06:17.28,0:06:20.00,Default,,0,0,0,,Зоя Бос картон қораптарды бүктеп, біріктіріңіз.
Dialogue: 0,0:06:20.20,0:06:20.56,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.28,0:06:23.57,Default,,0,0,0,,И раз.
Dialogue: 0,0:06:25.07,0:06:26.78,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:06:27.00,0:06:28.50,Default,,0,0,0,,Жеңілсек те
Dialogue: 0,0:06:28.90,0:06:29.83,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:30.21,0:06:33.45,Default,,0,0,0,,Арыстан толық жеңіске дайындалды
Dialogue: 0,0:06:33.45,0:06:35.42,Default,,0,0,0,,Наги-сама — уайымдаушы.
Dialogue: 0,0:06:35.84,0:06:37.59,Default,,0,0,0,,Біз аңдардың патшасымыз
Dialogue: 0,0:06:37.92,0:06:40.42,Default,,0,0,0,,Сізде ондай нәрсе болмаса да, сіз шыңға жетесіз.
Dialogue: 0,0:06:41.73,0:06:42.94,Default,,0,0,0,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:06:43.42,0:06:45.26,Default,,0,0,0,,Сіздің жеңісіңіз айнымас
Dialogue: 0,0:06:45.69,0:06:47.83,Default,,0,0,0,,Бұл жай ғана формальдылық.
Dialogue: 0,0:06:48.02,0:06:51.97,Default,,0,0,0,,Наги-самаға айт, мен саған әдемі жеңіс көрсетемін.
Dialogue: 0,0:06:52.80,0:06:55.16,Default,,0,0,0,,Мо Мо Гаон
Dialogue: 0,0:06:55.96,0:06:58.24,Default,,0,0,0,,«Гао» Итадакимасу
Dialogue: 0,0:07:01.75,0:07:02.60,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:07:02.60,0:07:03.37,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:04.39,0:07:05.32,Default,,0,0,0,,Жарайсың Дэмоно
Dialogue: 0,0:07:05.48,0:07:08.00,Default,,0,0,0,,Бұл нұсқаулық мәселесінің соңғы растауы.
Dialogue: 0,0:07:08.44,0:07:10.20,Default,,0,0,0,,Сіз оны дұрыс бөлістіңіз деп үміттенемін.
Dialogue: 0,0:07:10.20,0:07:11.73,Default,,0,0,0,,сондай-ақ... әрине
Dialogue: 0,0:07:11.91,0:07:14.51,Default,,0,0,0,,Нұсқаулықтың мазмұнын бұзсаңыз
Dialogue: 0,0:07:14.51,0:07:16.14,Default,,0,0,0,,Мұның бәрі оқшаулауға қатысты.
Dialogue: 0,0:07:16.88,0:07:18.00,Default,,0,0,0,,Кез келген мәселе
Dialogue: 0,0:07:18.47,0:07:19.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:23.52,0:07:25.55,Default,,0,0,0,,Қауіпті қауіпті нұсқаулық
Dialogue: 0,0:07:25.89,0:07:27.90,Default,,0,0,0,,Менің ойымша, бұл осы жерде...
Dialogue: 0,0:07:28.77,0:07:31.01,Default,,0,0,0,,Болды, солай ма?
Dialogue: 0,0:07:31.89,0:07:32.89,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:07:32.89,0:07:34.64,Default,,0,0,0,,Кешегі күннен бастап жақсарту.
Dialogue: 0,0:07:35.94,0:07:37.02,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:37.45,0:07:38.45,Default,,0,0,0,,Нагоми-сан?
Dialogue: 0,0:07:38.45,0:07:40.40,Default,,0,0,0,,Бұл ерекше фестиваль.
Dialogue: 0,0:07:40.66,0:07:42.37,Default,,0,0,0,,Ұстау ысырап
Dialogue: 0,0:07:42.54,0:07:46.16,Default,,0,0,0,,Көп шеберді қуантсам қызық болар еді, сенімдімін.
Dialogue: 0,0:07:46.43,0:07:48.19,Default,,0,0,0,,Сіз таңертеңнен бері істеп жатырсыз.
Dialogue: 0,0:07:48.35,0:07:48.87,Default,,0,0,0,,Иә
Dialogue: 0,0:07:50.70,0:07:52.91,Default,,0,0,0,,Бетіңіз лас, оны кейінірек сүртіңіз.
Dialogue: 0,0:07:53.11,0:07:55.78,Default,,0,0,0,,Ал, фестивальден ләззат алу керек, солай ма?
Dialogue: 0,0:07:55.78,0:07:57.99,Default,,0,0,0,,Мен де сүйкімді болғым келеді
Dialogue: 0,0:07:58.28,0:08:00.16,Default,,0,0,0,,Иә, барымызды салайық.
Dialogue: 0,0:08:01.84,0:08:02.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:03.08,0:08:05.55,Default,,0,0,0,,Жоқ, мен дүкен менеджерін таба алмаймын.
Dialogue: 0,0:08:07.42,0:08:08.22,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:08.63,0:08:10.60,Default,,0,0,0,,Сен бар ма, жоқ па, бәрібір.
Dialogue: 0,0:08:10.80,0:08:12.31,Default,,0,0,0,,Дайындық
Dialogue: 0,0:08:14.71,0:08:16.40,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:08:16.84,0:08:20.36,Default,,0,0,0,,Әлгі жігіттер үрейленіп жатса керек, мен қазір жоқпын.
Dialogue: 0,0:08:22.54,0:08:25.86,Default,,0,0,0,,Енді қош келдіңіз...
Dialogue: 0,0:08:26.12,0:08:29.32,Default,,0,0,0,,Шеберлер, ханымдар, көп адамдар, көп адамдар кезекте
Dialogue: 0,0:08:29.32,0:08:31.02,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:31.32,0:08:34.84,Default,,0,0,0,,Егер Акихабарадағы барлық қызметші кафелері бүгін осында болса,
Dialogue: 0,0:08:35.06,0:08:38.67,Default,,0,0,0,,Әрбір дүңгіршек, әр кезең, Модың көк төбесі, қолыңнан бәрі келеді
Dialogue: 0,0:08:38.67,0:08:41.51,Default,,0,0,0,,Moe Moe фестивалі, ол Моенің бәрін қамтиды
Dialogue: 0,0:08:42.32,0:08:45.55,Default,,0,0,0,,Акиба қыз фестивалі басталды.
Dialogue: 0,0:08:48.69,0:08:54.90,Default,,0,0,0,,Мо, Мо, толқу Мо, Мо, толқу...
Dialogue: 0,0:08:58.65,0:08:59.25,Default,,0,0,0,,Шошқаның аяғы?
Dialogue: 0,0:09:00.08,0:09:01.14,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:09:01.39,0:09:03.05,Default,,0,0,0,,Сол дәретхана...
Dialogue: 0,0:09:03.05,0:09:04.74,Default,,0,0,0,,Жуынатын бөлмеде болсаңыз, сол жаққа барыңыз.
Dialogue: 0,0:09:05.30,0:09:06.19,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:06.60,0:09:09.04,Default,,0,0,0,,Біз дәретхана ақпарат орталығындамыз.
Dialogue: 0,0:09:09.31,0:09:10.93,Default,,0,0,0,,Бұл неше рет болды?
Dialogue: 0,0:09:11.02,0:09:12.35,Default,,0,0,0,,Бұл 26-шы рет.
Dialogue: 0,0:09:15.06,0:09:17.78,Default,,0,0,0,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:09:18.52,0:09:20.56,Default,,0,0,0,,Мен Арашиконы жақсы көремін
Dialogue: 0,0:09:21.50,0:09:22.21,Default,,0,0,0,,Шошқа табандары
Dialogue: 0,0:09:23.26,0:09:25.17,Default,,0,0,0,,Екі жануарға орап алсаңыз да.
Dialogue: 0,0:09:25.73,0:09:26.62,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:09:29.59,0:09:32.34,Default,,0,0,0,,Бұл адам Арасиконың жанкүйері екені сөзсіз.
Dialogue: 0,0:09:32.34,0:09:34.39,Default,,0,0,0,,Соңғы кездері дүкенге жиі келетін болдыңыз.
Dialogue: 0,0:09:34.72,0:09:36.96,Default,,0,0,0,,Бұл менің есімде, өйткені ол өте ерекше.
Dialogue: 0,0:09:43.86,0:09:45.59,Default,,0,0,0,,Мен дүкенге тағы барамын.
Dialogue: 0,0:09:46.68,0:09:49.45,Default,,0,0,0,,Біз сенің шошқа қорасына оралуыңды асыға күтеміз.
Dialogue: 0,0:09:52.07,0:09:54.40,Default,,0,0,0,,Арашико-сан, ештеңе алма, Деска
Dialogue: 0,0:09:55.17,0:09:56.87,Default,,0,0,0,,Иә, желеңді
Dialogue: 0,0:09:57.08,0:09:58.79,Default,,0,0,0,,Десне, шошқаның сүйікті тағамы
Dialogue: 0,0:10:00.92,0:10:02.28,Default,,0,0,0,,Бұл шошқаның табаны ма?
Dialogue: 0,0:10:02.85,0:10:05.71,Default,,0,0,0,,Мен көремін. Бірінші рет шайнау сезімі.
Dialogue: 0,0:10:06.15,0:10:07.96,Default,,0,0,0,,Келгеніңізге қуаныштымын.
Dialogue: 0,0:10:08.21,0:10:10.05,Default,,0,0,0,,Өткізілетін орынға қараңыз.
Dialogue: 0,0:10:10.21,0:10:13.01,Default,,0,0,0,,Мен оны картаға қарасам да таба алмай, берілмек болдым.
Dialogue: 0,0:10:13.19,0:10:15.21,Default,,0,0,0,,Маған көрсете аласыз ба?
Dialogue: 0,0:10:15.93,0:10:16.82,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:10:18.91,0:10:19.58,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:19.90,0:10:21.11,Default,,0,0,0,,Мүмкін бұл солай ма?
Dialogue: 0,0:10:21.89,0:10:23.92,Default,,0,0,0,,Бұл дәретхананы білдіреді
Dialogue: 0,0:10:24.13,0:10:26.44,Default,,0,0,0,,Сондықтан мені дәретхана туралы көп сұрады.
Dialogue: 0,0:10:26.85,0:10:29.00,Default,,0,0,0,,Өңдеу барған сайын салғырттық танытуда.
Dialogue: 0,0:10:29.00,0:10:31.07,Default,,0,0,0,,Ешкім келмейтіні таңқаларлық емес.
Dialogue: 0,0:10:31.90,0:10:33.32,Default,,0,0,0,,Күткеннен кейін де келмесең
Dialogue: 0,0:10:34.18,0:10:35.38,Default,,0,0,0,,Мен осы жерден кетемін.
Dialogue: 0,0:10:41.44,0:10:44.20,Default,,0,0,0,,Бұл көп шошқаның аяғы, бу.
Dialogue: 0,0:10:44.20,0:10:46.82,Default,,0,0,0,,Жаңа кесілген шошқа табаны, бу.
Dialogue: 0,0:10:46.96,0:10:48.35,Default,,0,0,0,,Дәмді бу
Dialogue: 0,0:10:48.35,0:10:49.70,Default,,0,0,0,,Шошқаның аяғы
Dialogue: 0,0:10:49.70,0:10:52.09,Default,,0,0,0,,Бұл көп шошқаның аяғы.
Dialogue: 0,0:10:53.81,0:10:54.99,Default,,0,0,0,,Менің шошқаның аяғы
Dialogue: 0,0:11:03.05,0:11:03.70,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:11:04.38,0:11:05.04,Default,,0,0,0,,Нагоми
Dialogue: 0,0:11:07.48,0:11:09.28,Default,,0,0,0,,Шошқа меңгерушісі қайда?
Dialogue: 0,0:11:12.93,0:11:15.06,Default,,0,0,0,,Шынымды айтсам, сенің өмірің сұмдық.
Dialogue: 0,0:11:16.22,0:11:18.19,Default,,0,0,0,,Сіз не істесеңіз де, ол жұмыс істемейді.
Dialogue: 0,0:11:19.12,0:11:22.62,Default,,0,0,0,,Мен туылғаннан бері маған ешқашан жақсылық болған емес.
Dialogue: 0,0:11:23.14,0:11:24.26,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:11:24.50,0:11:27.88,Default,,0,0,0,,Олар сенсіз де жақсы болады.
Dialogue: 0,0:11:28.12,0:11:29.54,Default,,0,0,0,,Сен маған керек емессің
Dialogue: 0,0:11:30.25,0:11:31.39,Default,,0,0,0,,(үшін төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:11:31.61,0:11:34.68,Default,,0,0,0,,Негізі сені ешкім іздеп келмейді.
Dialogue: 0,0:11:34.93,0:11:35.93,Default,,0,0,0,,Қаш!
Dialogue: 0,0:11:37.29,0:11:38.35,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:39.04,0:11:41.19,Default,,0,0,0,,Бір балық ұстасам қашуым керек пе?
Dialogue: 0,0:11:43.00,0:11:45.07,Default,,0,0,0,,Дүкен меңгерушісі қайда?
Dialogue: 0,0:11:45.40,0:11:46.37,Default,,0,0,0,,Сонымен, неге қарғыс энергиясы кешігіп жатыр?
Dialogue: 0,0:11:46.73,0:11:47.73,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:11:47.91,0:11:51.39,Default,,0,0,0,,Мына ақымақ шошқа анау-мынау ақымақ.
Dialogue: 0,0:11:51.74,0:11:52.78,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:11:53.07,0:11:54.96,Default,,0,0,0,,Құлағыңыздың тесігіне шошқаның аяғын жабыстырыңыз
Dialogue: 0,0:11:54.96,0:11:56.81,Default,,0,0,0,,Маған азу тістер ызылдап тұр деп сен айттың ба?
Dialogue: 0,0:11:57.34,0:11:58.01,Default,,0,0,0,,Зоя
Dialogue: 0,0:11:58.10,0:11:59.74,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:11:59.99,0:12:01.97,Default,,0,0,0,,Я им всем сейчас точно покупал.
Dialogue: 0,0:12:01.97,0:12:03.23,Default,,0,0,0,,Әзірше күтіңіз
Dialogue: 0,0:12:05.00,0:12:05.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:06.92,0:12:08.60,Default,,0,0,0,,Мына шошқа ақылды екен
Dialogue: 0,0:12:08.78,0:12:10.88,Default,,0,0,0,,Мен Мо Мо иерархиясын түсінемін.
Dialogue: 0,0:12:11.50,0:12:12.60,Default,,0,0,0,,Юмэчи-сан…
Dialogue: 0,0:12:13.07,0:12:14.85,Default,,0,0,0,,үшінна қолдар.
Dialogue: 0,0:12:15.43,0:12:16.49,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:12:17.83,0:12:18.58,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:12:18.80,0:12:19.65,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:12:19.83,0:12:21.58,Default,,0,0,0,,Мен мұны өз бетімше жасадым.
Dialogue: 0,0:12:22.15,0:12:24.27,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:12:24.50,0:12:27.27,Default,,0,0,0,,Сен неге мақтаншақ болып жерде отырсың?
Dialogue: 0,0:12:28.05,0:12:28.56,Default,,0,0,0,,Айтат
Dialogue: 0,0:12:28.90,0:12:30.52,Default,,0,0,0,,Ей, балалар, тез орындаңдар.
Dialogue: 0,0:12:31.12,0:12:31.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:32.43,0:12:33.54,Default,,0,0,0,,Юмэчи-сан, №.
Dialogue: 0,0:12:33.54,0:12:34.15,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:12:39.38,0:12:40.99,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:12:42.97,0:12:44.83,Default,,0,0,0,,Тұяқ іздерін қалдырыңыз
Dialogue: 0,0:12:45.36,0:12:47.94,Default,,0,0,0,,Бұл сіздің позицияңызды есте сақтауға көмектеседі.
Dialogue: 0,0:12:48.15,0:12:50.37,Default,,0,0,0,,Шошқа қорасын енді ешқашан тастамаңыз.
Dialogue: 0,0:12:50.48,0:12:53.85,Default,,0,0,0,,Шошқа мұрындарын жерге тигізіп, жай ғана жорғалауы керек.
Dialogue: 0,0:12:53.85,0:12:56.97,Default,,0,0,0,,Егер мұны істесеңіз, анда-санда трюфельдерді де таба аласыз.
Dialogue: 0,0:13:00.73,0:13:01.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:02.59,0:13:04.55,Default,,0,0,0,,Себебі мен қажетсіз нәрсе жасадым.
Dialogue: 0,0:13:06.83,0:13:08.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:08.45,0:13:10.77,Default,,0,0,0,,Қозғалсаң, бұл жолы жаншылып кетесің.
Dialogue: 0,0:13:11.11,0:13:12.34,Default,,0,0,0,,Сабырдан басқа амалым жоқ.
Dialogue: 0,0:13:12.69,0:13:14.76,Default,,0,0,0,,Жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,0:13:16.03,0:13:18.42,Default,,0,0,0,,Неліктен Тонто Тон төменгі жағында?
Dialogue: 0,0:13:19.35,0:13:21.45,Default,,0,0,0,,Сіздердің бәріңіз де ең жақсы қызметшілерсіздер
Dialogue: 0,0:13:22.42,0:13:23.93,Default,,0,0,0,,Ең жақсы қызметші?
Dialogue: 0,0:13:25.54,0:13:27.06,Default,,0,0,0,,Арашико-сан дұрыс айтады.
Dialogue: 0,0:13:27.86,0:13:30.39,Default,,0,0,0,,Юмэчи жақсы жағынан адам болудан бас тартты.
Dialogue: 0,0:13:30.62,0:13:33.27,Default,,0,0,0,,Шипон-сан Агегепада жақсы көңіл-күйде.
Dialogue: 0,0:13:33.51,0:13:35.84,Default,,0,0,0,,Зояның аузының бұрыштары бұрынғыдан жоғары көтерілген.
Dialogue: 0,0:13:36.18,0:13:39.63,Default,,0,0,0,,Арашико кетчуппен сурет салуда әлдеқайда жақсырақ.
Dialogue: 0,0:13:40.03,0:13:42.35,Default,,0,0,0,,Окачимачи мырза нағыз панда
Dialogue: 0,0:13:42.91,0:13:44.85,Default,,0,0,0,,Бәрің де тамаша қызметшісіңдер.
Dialogue: 0,0:13:45.38,0:13:47.06,Default,,0,0,0,,Дәлелдейік
Dialogue: 0,0:13:47.37,0:13:48.77,Default,,0,0,0,,Деска қалай алады
Dialogue: 0,0:13:49.23,0:13:53.06,Default,,0,0,0,,Шошқаның аяғы не үшін керек?
Dialogue: 0,0:13:54.73,0:14:01.08,Default,,0,0,0,,Мо, Мо, толқу Мо, Мо, толқу...
Dialogue: 0,0:14:04.21,0:14:06.78,Default,,0,0,0,,Бұл келушілердің ең көп саны.
Dialogue: 0,0:14:07.18,0:14:08.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:09.15,0:14:13.89,Default,,0,0,0,,Топқа үлес қосқан күңдер байлыққа, атаққа, билікке ие болады.
Dialogue: 0,0:14:14.27,0:14:18.00,Default,,0,0,0,,Үлес қоса алмайтын қызметшілер мысал ретінде төменге ығыстырылады.
Dialogue: 0,0:14:18.24,0:14:18.57,Default,,0,0,0,,Иә
Dialogue: 0,0:14:19.27,0:14:21.85,Default,,0,0,0,,Күңдерге мое-мое иерархиясын енгізу арқылы.
Dialogue: 0,0:14:22.29,0:14:24.07,Default,,0,0,0,,Мен топқа үлес қостым.
Dialogue: 0,0:14:24.43,0:14:27.47,Default,,0,0,0,,Демек, Кедамоланд тобының экожүйесі абсолютті
Dialogue: 0,0:14:27.80,0:14:29.90,Default,,0,0,0,,Кедамоланд тобы ғана емес
Dialogue: 0,0:14:30.44,0:14:35.10,Default,,0,0,0,,Бұл Акихабараның өзі адамның ашкөздігімен қоректеніп өсетін аң.
Dialogue: 0,0:14:35.66,0:14:39.16,Default,,0,0,0,,Бүгін мен Акихабараның шыңы екенімді дәлелдеймін.
Dialogue: 0,0:14:44.90,0:14:47.53,Default,,0,0,0,,Аңдар патшасы Акиба патшасы
Dialogue: 0,0:14:48.25,0:14:49.05,Default,,0,0,0,,Гаогао
Dialogue: 0,0:14:49.05,0:14:50.08,Default,,0,0,0,,Осы жылы тағы да жеңіңіз
Dialogue: 0,0:14:50.62,0:14:52.68,Default,,0,0,0,,Нұсқаулықтың мазмұнын түсіндім.
Dialogue: 0,0:14:53.23,0:14:56.68,Default,,0,0,0,,Өлі қызумен айналысып, соңында арыстан жеңсін
Dialogue: 0,0:14:56.94,0:15:00.48,Default,,0,0,0,,Әй, бір қадамды да жіберіп алсам, жаншылып қалармын деп ойладым.
Dialogue: 0,0:15:00.76,0:15:03.53,Default,,0,0,0,,Момо-чан, биыл бірінші орынға ие бол.
Dialogue: 0,0:15:04.68,0:15:06.21,Default,,0,0,0,,Абсолютті жеңіс режимі
Dialogue: 0,0:15:06.54,0:15:07.72,Default,,0,0,0,,Мо
Dialogue: 0,0:15:07.96,0:15:09.18,Default,,0,0,0,,Ең жақсы мияулаңыз
Dialogue: 0,0:15:09.61,0:15:10.60,Default,,0,0,0,,Аю
Dialogue: 0,0:15:15.74,0:15:16.81,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:15:17.23,0:15:18.73,Default,,0,0,0,,Иә, жеңейік
Dialogue: 0,0:15:18.73,0:15:19.04,Default,,0,0,0,,Иә
Dialogue: 0,0:15:19.19,0:15:20.04,Default,,0,0,0,,Бірінші болып Айс Фриз!
Dialogue: 0,0:15:20.04,0:15:22.06,Default,,0,0,0,,Мен сізге биыл басқа нәрсе көрсетемін
Dialogue: 0,0:15:23.00,0:15:24.83,Default,,0,0,0,,Шошқаның ниеті қандай екенін көрсетемін.
Dialogue: 0,0:15:25.41,0:15:25.99,Default,,0,0,0,,Мұқият
Dialogue: 0,0:15:26.38,0:15:27.90,Default,,0,0,0,,Мұқият
Dialogue: 0,0:15:28.97,0:15:30.78,Default,,0,0,0,,Келіңіз, ұстаз, ханым.
Dialogue: 0,0:15:30.99,0:15:33.83,Default,,0,0,0,,Тамағымдағы сүйектер ұнтақ болып кеткенше қолдау көрсеткендеріңізге рахмет.
Dialogue: 0,0:15:34.12,0:15:35.68,Default,,0,0,0,,Сіз жүгіре бастағаннан кейін тоқтай алмайсыз.
Dialogue: 0,0:15:35.86,0:15:39.14,Default,,0,0,0,,Мо, Мо, бәрі жекпе-жек фестивалі болады
Dialogue: 0,0:15:39.55,0:15:40.75,Default,,0,0,0,,Негізгі оқиға
Dialogue: 0,0:15:41.05,0:15:43.63,Default,,0,0,0,,«Омоэ-сама өрмелеуді» бастайтын кез келді
Dialogue: 0,0:15:45.37,0:15:46.57,Default,,0,0,0,,Мо Мо...
Dialogue: 0,0:15:53.96,0:15:54.68,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:15:54.68,0:15:55.85,Default,,0,0,0,,Жарқыраған арыстан
Dialogue: 0,0:15:57.30,0:15:58.86,Default,,0,0,0,,Сіз әлі қозғала алмайсыз ба?
Dialogue: 0,0:15:59.14,0:16:00.93,Default,,0,0,0,,Іске қосу сигналы берілді.
Dialogue: 0,0:16:01.54,0:16:03.38,Default,,0,0,0,,Ешқашан тыныш күтпеңіз
Dialogue: 0,0:16:04.53,0:16:05.29,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:16:05.29,0:16:06.40,Default,,0,0,0,,Осы жерден жүріңіз
Dialogue: 0,0:16:07.88,0:16:08.30,Default,,0,0,0,,Эй
Dialogue: 0,0:16:08.30,0:16:09.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.53,0:16:10.73,Default,,0,0,0,,Сіз нұсқаулықты оқыдыңыз ба?
Dialogue: 0,0:16:10.73,0:16:13.33,Default,,0,0,0,,Сіз экожүйе туралы ойлайсыз ба?
Dialogue: 0,0:16:18.46,0:16:19.90,Default,,0,0,0,,Тонтоко Кита
Dialogue: 0,0:16:20.34,0:16:22.50,Default,,0,0,0,,Икейкетонтон
Dialogue: 0,0:16:22.76,0:16:24.07,Default,,0,0,0,,Бұл мен көрмеген дүкен.
Dialogue: 0,0:16:24.26,0:16:25.00,Default,,0,0,0,,Шошқа?
Dialogue: 0,0:16:25.89,0:16:26.85,Default,,0,0,0,,Шынымен осындай нәрсені киесің бе?
Dialogue: 0,0:16:26.85,0:16:27.88,Default,,0,0,0,,Неліктен шошқалар...
Dialogue: 0,0:16:28.50,0:16:30.46,Default,,0,0,0,,Экожүйені қорғауымыз керек пе?
Dialogue: 0,0:16:45.10,0:16:46.00,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:16:46.00,0:16:47.53,Default,,0,0,0,,Нұсқауларды орындаңыз
Dialogue: 0,0:16:47.53,0:16:48.67,Default,,0,0,0,,Шошқа
Dialogue: 0,0:16:51.63,0:16:53.05,Default,,0,0,0,,Қайда... сонша алыста
Dialogue: 0,0:16:53.05,0:16:54.70,Default,,0,0,0,,Бұл бағыныштылық па?
Dialogue: 0,0:16:56.78,0:16:58.27,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:16:58.75,0:17:00.39,Default,,0,0,0,,Арыстанның жеңісі айнымас.
Dialogue: 0,0:17:05.51,0:17:06.74,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:10.65,0:17:12.30,Default,,0,0,0,,Жоғарыға дерлік
Dialogue: 0,0:17:15.19,0:17:18.48,Default,,0,0,0,,Мұндай жерге шошқаның келуі мүмкін емес.
Dialogue: 0,0:17:19.41,0:17:20.81,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:17:20.98,0:17:22.89,Default,,0,0,0,,Сіз Teme және т.б. оқыған жоқсыз ба?
Dialogue: 0,0:17:22.89,0:17:24.22,Default,,0,0,0,,Атмосфераны оқи аласыз ба?
Dialogue: 0,0:17:24.22,0:17:26.12,Default,,0,0,0,,Жоқ, жоқ, олай емес.
Dialogue: 0,0:17:26.12,0:17:28.03,Default,,0,0,0,,Қандай тәртіпсіздік
Dialogue: 0,0:17:28.56,0:17:29.15,Default,,0,0,0,,Юмэчи
Dialogue: 0,0:17:29.36,0:17:30.12,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:17:32.67,0:17:33.75,Default,,0,0,0,,Тіпті шошқалар...
Dialogue: 0,0:17:34.75,0:17:37.98,Default,,0,0,0,,Тіптен шошқалар да өрмелеп шығады.
Dialogue: 0,0:17:39.28,0:17:41.33,Default,,0,0,0,,Өте шулы.
Dialogue: 0,0:17:41.92,0:17:44.25,Default,,0,0,0,,Юмэчи
Dialogue: 0,0:17:46.52,0:17:47.96,Default,,0,0,0,,Арыстан күткендей
Dialogue: 0,0:17:48.65,0:17:49.47,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:17:50.26,0:17:51.41,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:17:54.09,0:17:55.18,Default,,0,0,0,,Кел, кел, кел!
Dialogue: 0,0:17:55.65,0:17:56.93,Default,,0,0,0,,Бірінші ит
Dialogue: 0,0:18:12.92,0:18:13.69,Default,,0,0,0,,Нагоми?
Dialogue: 0,0:18:14.37,0:18:15.46,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:18:18.34,0:18:18.97,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:18:23.90,0:18:24.92,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:18:27.44,0:18:28.17,Default,,0,0,0,,Нагоми?
Dialogue: 0,0:18:30.92,0:18:32.96,Default,,0,0,0,,Жаман сөз айтпа.
Dialogue: 0,0:18:32.96,0:18:35.18,Default,,0,0,0,,Түсіндім, өтінемін
Dialogue: 0,0:18:35.35,0:18:36.79,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:18:36.79,0:18:37.89,Default,,0,0,0,,Мен лосось ойнаймын.
Dialogue: 0,0:18:53.99,0:18:55.15,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:19:00.38,0:19:02.16,Default,,0,0,0,,Жай ғана құла
Dialogue: 0,0:19:06.13,0:19:09.32,Default,,0,0,0,,Шошқаның түбінде, тіпті шошқаның табанында да сатуға болмайды.
Dialogue: 0,0:19:11.70,0:19:13.93,Default,,0,0,0,,Бір шошқа тепкі, күткеніңізге рахмет, бу.
Dialogue: 0,0:19:14.35,0:19:15.38,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:19:18.28,0:19:19.12,Default,,0,0,0,,Сондықтан бұдан былай бұндай жағдай қайталанбасын десек?
Dialogue: 0,0:19:26.93,0:19:27.65,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:19:29.22,0:19:31.69,Default,,0,0,0,,Қош келдіңіз, Нагоми-сан.
Dialogue: 0,0:19:32.64,0:19:34.42,Default,,0,0,0,,Теме, қарғыс атқыр шошқа.
Dialogue: 0,0:19:41.91,0:19:42.45,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:19:42.65,0:19:43.24,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:19:43.47,0:19:44.08,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:19:44.34,0:19:45.21,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:19:45.42,0:19:46.29,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:19:51.16,0:19:52.75,Default,,0,0,0,,Экожүйе бұзылады
Dialogue: 0,0:19:52.91,0:19:53.97,Default,,0,0,0,,Бітті.
Dialogue: 0,0:20:06.12,0:20:08.31,Default,,0,0,0,,Сізбен кездесу
Dialogue: 0,0:20:08.78,0:20:11.14,Default,,0,0,0,,Нүктеге дейін
Dialogue: 0,0:20:12.29,0:20:13.46,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:20:13.46,0:20:15.07,Default,,0,0,0,,Теппенді шошқа ұстап алды.
Dialogue: 0,0:20:15.31,0:20:16.81,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:20:28.37,0:20:31.16,Default,,0,0,0,,Шошқалар экожүйенің шыңы ма?
Dialogue: 0,0:20:37.31,0:20:40.27,Default,,0,0,0,,Рахмет Рахмет
Dialogue: 0,0:20:40.68,0:20:43.85,Default,,0,0,0,,Омоэ-сама альпинизм жүлдесінің уақыты келді.
Dialogue: 0,0:20:43.85,0:20:45.57,Default,,0,0,0,,Омое-сама болған қызметші
Dialogue: 0,0:20:45.57,0:20:49.44,Default,,0,0,0,,Келесі жылы мен Акихабараның қызметшілерінің шыңы боламын деп үміттенемін.
Dialogue: 0,0:20:49.85,0:20:53.41,Default,,0,0,0,,Ұстаз, қызыңызды қонақжайлықпен қарсы аламыз.
Dialogue: 0,0:20:53.79,0:20:57.61,Default,,0,0,0,,Омоэ-сама деген атаққа ие болатын жүргізуші
Dialogue: 0,0:20:56.69,0:20:57.61,Default,,0,0,0,,Не болды? Егер айтатын сөзің болса, мен тыңдап тұрмын
Dialogue: 0,0:20:58.26,0:21:01.03,Default,,0,0,0,,Kedamoland тобының Наги өкілі
Dialogue: 0,0:21:05.53,0:21:06.52,Default,,0,0,0,,Өкіл?
Dialogue: 0,0:21:09.43,0:21:10.62,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:21:10.62,0:21:12.38,Default,,0,0,0,,Сізді өкіл жояды
Dialogue: 0,0:21:12.81,0:21:14.50,Default,,0,0,0,,Бұл таңқаларлық нәтиже.
Dialogue: 0,0:21:14.92,0:21:16.50,Default,,0,0,0,,Мен болашаққа үмітпен қараймын.
Dialogue: 0,0:21:20.30,0:21:21.55,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:21.55,0:21:23.58,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:21:23.58,0:21:25.79,Default,,0,0,0,,Жасайық, келесі жолы барайық.
Dialogue: 0,0:21:26.32,0:21:28.56,Default,,0,0,0,,Бүгін Омое-сама болған қызметші
Dialogue: 0,0:21:28.86,0:21:31.24,Default,,0,0,0,,Біз бұл құрметке шынымен лайықпыз ба?
Dialogue: 0,0:21:31.66,0:21:34.25,Default,,0,0,0,,Жақында дәлелденеді
Dialogue: 0,0:21:35.60,0:21:36.33,Default,,0,0,0,,Әңгімелеу
Dialogue: 0,0:21:37.40,0:21:37.90,Default,,0,0,0,,Иә
Dialogue: 0,0:21:39.18,0:21:40.15,Default,,0,0,0,,Ал...
Dialogue: 0,0:21:40.97,0:21:43.04,Default,,0,0,0,,Бұл өте босаңсытады.
Dialogue: 0,0:21:43.22,0:21:45.04,Default,,0,0,0,,Шебер ханым
Dialogue: 0,0:21:45.04,0:21:47.17,Default,,0,0,0,,Мен сенің шошқа қорасына қайта оралуыңды асыға күтемін.
Dialogue: 0,0:21:50.77,0:21:52.47,Default,,0,0,0,,Дұрыс, менің қызметшім.
Dialogue: 0,0:21:52.47,0:21:54.36,Default,,0,0,0,,Қазір сөз сөйлеп тұрған адам менің
Dialogue: 0,0:21:54.36,0:21:55.88,Default,,0,0,0,,Мен сені өсірдім
Dialogue: 0,0:21:57.38,0:22:03.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
