Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:45.86,0:01:47.02,Default,,0,0,0,,Әпке, қараңызшы.
Dialogue: 0,0:01:47.24,0:01:48.35,Default,,0,0,0,,Тонтотонсу
Dialogue: 0,0:01:48.48,0:01:49.10,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:49.31,0:01:51.42,Default,,0,0,0,,Баннен Арашико қосылды деген қауесет бар.
Dialogue: 0,0:01:52.18,0:01:54.00,Default,,0,0,0,,Ол 15 жыл бұрын қамауға алынған ба?
Dialogue: 0,0:01:54.40,0:01:55.88,Default,,0,0,0,,Акиба, қайтып келдің бе?
Dialogue: 0,0:01:55.99,0:01:58.14,Default,,0,0,0,,Иә, жаңа қызметші ретінде.
Dialogue: 0,0:01:58.56,0:02:00.04,Default,,0,0,0,,Маннен Арашико қосылғаннан кейін
Dialogue: 0,0:02:00.32,0:02:02.30,Default,,0,0,0,,Олар мына жерде, бірде-бір нәрсені ұсақтап жүр.
Dialogue: 0,0:02:02.83,0:02:04.61,Default,,0,0,0,,Жекпе-жек тобының жарқыраған жұлдызы?
Dialogue: 0,0:02:12.91,0:02:14.33,Default,,0,0,0,,Аң
Dialogue: 0,0:02:14.88,0:02:15.71,Default,,0,0,0,,Назар аударыңыз
Dialogue: 0,0:02:16.02,0:02:18.54,Default,,0,0,0,,Kedamoland тобының мақсаты қандай?
Dialogue: 0,0:02:18.54,0:02:20.33,Default,,0,0,0,,Акихабараны біріктіру
Dialogue: 0,0:02:20.55,0:02:22.48,Default,,0,0,0,,Мен қазір айтатын үш дүкен, жоғары көтеріл.
Dialogue: 0,0:02:22.96,0:02:24.21,Default,,0,0,0,,«Ину Соконкон кафесі»
Dialogue: 0,0:02:24.61,0:02:24.90,Default,,0,0,0,,Иә
Dialogue: 0,0:02:25.44,0:02:26.68,Default,,0,0,0,,«Адал майдог»
Dialogue: 0,0:02:27.04,0:02:27.44,Default,,0,0,0,,Иә
Dialogue: 0,0:02:27.84,0:02:29.13,Default,,0,0,0,,«Тонтокотон қызметшісі кафесі»
Dialogue: 0,0:02:29.78,0:02:30.26,Default,,0,0,0,,Иә
Dialogue: 0,0:02:32.50,0:02:35.68,Default,,0,0,0,,Топ қызметшісіне үш нәрсе керек.
Dialogue: 0,0:02:36.05,0:02:38.60,Default,,0,0,0,,Бір нәрсе үшін күресуге болады
Dialogue: 0,0:02:38.89,0:02:40.60,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:02:40.84,0:02:43.39,Default,,0,0,0,,Бір нәрсе: ақшаны көму
Dialogue: 0,0:02:43.98,0:02:45.08,Default,,0,0,0,,Жылы сөздеріңізге рахмет
Dialogue: 0,0:02:45.75,0:02:48.61,Default,,0,0,0,,Ал ең қажетті нәрсе...
Dialogue: 0,0:02:52.36,0:02:52.84,Default,,0,0,0,,Неге...
Dialogue: 0,0:02:53.30,0:02:57.04,Default,,0,0,0,,Охире-чанның ақша жымқыруы Айналмайды деп ойладың ба?
Dialogue: 0,0:03:01.34,0:03:03.17,Default,,0,0,0,,Мен сотқа қатысамын.
Dialogue: 0,0:03:04.07,0:03:06.00,Default,,0,0,0,,Ең қажетті
Dialogue: 0,0:03:08.22,0:03:09.21,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:09.96,0:03:12.14,Default,,0,0,0,,Топтық адалдық
Dialogue: 0,0:03:12.88,0:03:14.80,Default,,0,0,0,,Осы үш тармақты қамтамасыз ету
Dialogue: 0,0:03:14.93,0:03:17.51,Default,,0,0,0,,Біз әр дүкенге жаттықтырушылар жібереміз.
Dialogue: 0,0:03:18.25,0:03:19.26,Default,,0,0,0,,Эй шошқалар
Dialogue: 0,0:03:19.77,0:03:21.97,Default,,0,0,0,,Сіз бұл дүкенге не қажет екенін білесіз бе?
Dialogue: 0,0:03:22.29,0:03:22.95,Default,,0,0,0,,Нори?
Dialogue: 0,0:03:23.10,0:03:24.11,Default,,0,0,0,,Қулық
Dialogue: 0,0:03:24.26,0:03:25.54,Default,,0,0,0,,Бұл мейірімділік пе?
Dialogue: 0,0:03:25.89,0:03:26.88,Default,,0,0,0,,Сенім
Dialogue: 0,0:03:27.08,0:03:28.77,Default,,0,0,0,,Тамаша дүкен менеджері Деска
Dialogue: 0,0:03:28.77,0:03:31.13,Default,,0,0,0,,Соңғы кездері қызметші болып көп жұмыс істемеймін.
Dialogue: 0,0:03:33.05,0:03:34.45,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:03:34.73,0:03:38.44,Default,,0,0,0,,Мен Акихабараға келгеннен бері қызметші қыздай көп істеген жоқпын.
Dialogue: 0,0:03:38.74,0:03:41.97,Default,,0,0,0,,-де топ жаттықтырушыны жібереді.
Dialogue: 0,0:03:41.97,0:03:42.62,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:03:43.68,0:03:45.36,Default,,0,0,0,,Жаттықтырушы дегеніміз не?
Dialogue: 0,0:03:47.24,0:03:49.15,Default,,0,0,0,,Қызметші білім беру маманы
Dialogue: 0,0:03:50.68,0:03:54.75,Default,,0,0,0,,Сол жын үйреткен күңдердің көбі жойылады дейді.
Dialogue: 0,0:03:56.34,0:03:58.10,Default,,0,0,0,,Ол құлдырай ма?
Dialogue: 0,0:03:58.30,0:04:00.99,Default,,0,0,0,,Жаттықтырушы келгенде мен бар күшімді саламын.
Dialogue: 0,0:04:00.99,0:04:02.11,Default,,0,0,0,,Әрқашан қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:04:06.59,0:04:08.48,Default,,0,0,0,,Шошқа қорасына қош келдіңіз.
Dialogue: 0,0:04:10.42,0:04:13.49,Default,,0,0,0,,Қожайынның шошқа қорасына қайтып оралатын жері ме?
Dialogue: 0,0:04:14.61,0:04:17.07,Default,,0,0,0,,Жоқ, бұл параметрлерде.
Dialogue: 0,0:04:17.57,0:04:19.93,Default,,0,0,0,,Бұл қызметші-дәмхана, бірақ шошқа лашығы сияқты...
Dialogue: 0,0:04:19.93,0:04:21.18,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:04:21.70,0:04:22.66,Default,,0,0,0,,Не?
Dialogue: 0,0:04:24.21,0:04:26.38,Default,,0,0,0,,Бұл топ жіберген Сано.
Dialogue: 0,0:04:27.06,0:04:28.58,Default,,0,0,0,,үшін орындалмады
Dialogue: 0,0:04:28.85,0:04:31.59,Default,,0,0,0,,Дүкен лас, әшекейлері сапасыз.
Dialogue: 0,0:04:31.91,0:04:33.53,Default,,0,0,0,,Эйске сүйену
Dialogue: 0,0:04:33.63,0:04:36.46,Default,,0,0,0,,Эйс сонымен қатар тұрақты адамдарға жылы тұтынушыларға қызмет көрсетті.
Dialogue: 0,0:04:36.79,0:04:39.72,Default,,0,0,0,,Қалғандардың бәрі бос басымен ызылдап жатыр.
Dialogue: 0,0:04:40.09,0:04:42.50,Default,,0,0,0,,Ең бастысы, топқа деген адалдық жоқ.
Dialogue: 0,0:04:42.82,0:04:44.72,Default,,0,0,0,,Ең нашар қызметші
Dialogue: 0,0:04:45.67,0:04:48.08,Default,,0,0,0,,Пайдасыз қызметшілерді қайта оқытыңыз
Dialogue: 0,0:04:48.44,0:04:49.60,Default,,0,0,0,,Окадамоно
Dialogue: 0,0:04:50.08,0:04:52.56,Default,,0,0,0,,Оқытудың болашағы жоқ қызметшілер қуылады.
Dialogue: 0,0:04:52.83,0:04:54.19,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:04:54.60,0:04:57.19,Default,,0,0,0,,Аңдарды үйретуде сәтсіздік жоқ.
Dialogue: 0,0:04:59.42,0:05:01.24,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз
Dialogue: 0,0:05:01.44,0:05:02.81,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:05:03.80,0:05:05.85,Default,,0,0,0,,Мен сені ертеңнен бастап жаттықтырамын.
Dialogue: 0,0:05:06.46,0:05:09.08,Default,,0,0,0,,Егер сіз бір апта ішінде сынақтан өте алсаңыз
Dialogue: 0,0:05:09.29,0:05:11.36,Default,,0,0,0,,Мәселе жоқ деп жоғары қарай хабарлаңыз
Dialogue: 0,0:05:11.58,0:05:13.42,Default,,0,0,0,,Бұл сынақ па?
Dialogue: 0,0:05:13.65,0:05:16.92,Default,,0,0,0,,Әр адам әрқайсысы 100 000 иен таба алады.
Dialogue: 0,0:05:17.14,0:05:18.24,Default,,0,0,0,,Балалар
Dialogue: 0,0:05:18.39,0:05:21.28,Default,,0,0,0,,Мейірімді Сано-сан маған соңғы мүмкіндік берді.
Dialogue: 0,0:05:21.51,0:05:22.81,Default,,0,0,0,,Көңіл-күйімізді көтерейік
Dialogue: 0,0:05:22.81,0:05:23.27,Default,,0,0,0,,Эй
Dialogue: 0,0:05:23.46,0:05:23.99,Default,,0,0,0,,Иә
Dialogue: 0,0:05:24.49,0:05:25.83,Default,,0,0,0,,Сізді қудалау.
Dialogue: 0,0:05:26.02,0:05:26.72,Default,,0,0,0,,Панда да
Dialogue: 0,0:05:27.90,0:05:28.97,Default,,0,0,0,,Бұл шексіз артықшылыққа айналар еді.
Dialogue: 0,0:05:29.40,0:05:32.80,Default,,0,0,0,,Сіздің қатысуыңыз қызметшілерге кері әсер етеді.
Dialogue: 0,0:05:33.28,0:05:34.31,Default,,0,0,0,,Шіріген апельсиндер...
Dialogue: 0,0:05:34.49,0:05:36.23,Default,,0,0,0,,Жоқ, бұл ауру шошқа.
Dialogue: 0,0:05:36.53,0:05:39.11,Default,,0,0,0,,Мен сау шошқамын.
Dialogue: 0,0:05:39.31,0:05:41.12,Default,,0,0,0,,Бұл менің мейірімділігім
Dialogue: 0,0:05:41.29,0:05:44.20,Default,,0,0,0,,Немесе сіз экскомпрессияның орнына оқшауланғыңыз келе ме?
Dialogue: 0,0:05:44.20,0:05:45.75,Default,,0,0,0,,Ал... жай ғана оқшаулау...
Dialogue: 0,0:05:45.75,0:05:46.39,Default,,0,0,0,,Шығу
Dialogue: 0,0:05:46.87,0:05:47.28,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.22,0:05:53.18,Default,,0,0,0,,Менеджер
Dialogue: 0,0:05:53.63,0:05:57.52,Default,,0,0,0,,Бүгіннен бастап мені Кедамоланд тобының бір бөлігі деп ойлаңыз.
Dialogue: 0,0:05:57.92,0:05:59.47,Default,,0,0,0,,Ертең таңғы 5-те тұр
Dialogue: 0,0:05:59.67,0:06:00.31,Default,,0,0,0,,Бар болғаны
Dialogue: 0,0:06:05.70,0:06:07.90,Default,,0,0,0,,Нагоми-сан, оянатын кез келді.
Dialogue: 0,0:06:09.57,0:06:11.73,Default,,0,0,0,,Бұл соншалықты сүйкімді емес.
Dialogue: 0,0:06:12.62,0:06:13.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:17.32,0:06:18.54,Default,,0,0,0,,Оянатын уақыт келді
Dialogue: 0,0:06:20.00,0:06:20.30,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.50,0:06:23.11,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:06:24.11,0:06:25.79,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:06:25.79,0:06:26.97,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,0:06:27.10,0:06:28.59,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:06:28.59,0:06:29.87,Default,,0,0,0,,Мен сізді естімеймін.
Dialogue: 0,0:06:32.11,0:06:34.87,Default,,0,0,0,,Баранбаран тағы бір рет
Dialogue: 0,0:06:35.16,0:06:35.88,Default,,0,0,0,,Иә
Dialogue: 0,0:06:36.03,0:06:37.66,Default,,0,0,0,,Жауап: «Жарайды Дамоно»
Dialogue: 0,0:06:37.66,0:06:39.00,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:06:39.35,0:06:41.45,Default,,0,0,0,,Мен мұны сыза алдым.
Dialogue: 0,0:06:41.99,0:06:43.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:43.68,0:06:45.14,Default,,0,0,0,,Эй... бұл мысық.
Dialogue: 0,0:06:46.15,0:06:47.19,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:06:47.58,0:06:48.76,Default,,0,0,0,,Моттайнай
Dialogue: 0,0:06:48.76,0:06:50.87,Default,,0,0,0,,Олай деп ойласаң, дұрыс сыз.
Dialogue: 0,0:06:51.12,0:06:53.02,Default,,0,0,0,,Омлет күрішіне жаным ашиды.
Dialogue: 0,0:06:54.05,0:06:55.52,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:06:56.24,0:06:57.84,Default,,0,0,0,,Тонтондық сусын жинағы
Dialogue: 0,0:06:58.03,0:06:58.96,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:59.28,0:07:00.25,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:01.73,0:07:02.45,Default,,0,0,0,,Эй
Dialogue: 0,0:07:02.67,0:07:03.11,Default,,0,0,0,,Иә
Dialogue: 0,0:07:03.23,0:07:05.27,Default,,0,0,0,,Сіздің басыңыз орамжапырақ па?
Dialogue: 0,0:07:05.27,0:07:08.37,Default,,0,0,0,,Ұстаздың өзі сондай тәтті болса, денсаулығына зиян.
Dialogue: 0,0:07:08.61,0:07:09.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:09.78,0:07:11.63,Default,,0,0,0,,Көбірек су қосыңыз.
Dialogue: 0,0:07:11.83,0:07:13.75,Default,,0,0,0,,Бірақ құны...
Dialogue: 0,0:07:14.03,0:07:16.50,Default,,0,0,0,,Сіз бірден ақша табасыз.
Dialogue: 0,0:07:19.10,0:07:21.67,Default,,0,0,0,,Бір-біріңіздің қате деп ойлайтын нәрселеріңізді көрсетіңіз
Dialogue: 0,0:07:22.72,0:07:25.94,Default,,0,0,0,,Мен ештеңе туралы ойламаймын, сондықтан ештеңе шықпайды.
Dialogue: 0,0:07:26.24,0:07:27.74,Default,,0,0,0,,Ал, меннен бір.
Dialogue: 0,0:07:27.74,0:07:28.18,Default,,0,0,0,,Шипон
Dialogue: 0,0:07:29.35,0:07:30.81,Default,,0,0,0,,Бұл қандай макияж?
Dialogue: 0,0:07:31.15,0:07:33.31,Default,,0,0,0,,Kedamoland тобына жарамсыз
Dialogue: 0,0:07:34.39,0:07:36.14,Default,,0,0,0,,Маған макияж жасауға рұқсат етіңіз...
Dialogue: 0,0:07:37.43,0:07:40.02,Default,,0,0,0,,Бұл дүкен Kedamoland тобының бөлігі болып табылады.
Dialogue: 0,0:07:40.26,0:07:43.61,Default,,0,0,0,,Қазір кім екеніңді өзгертпесең, мен емтиханды тапсырмаймын.
Dialogue: 0,0:07:48.32,0:07:49.56,Default,,0,0,0,,Нему
Dialogue: 0,0:07:49.56,0:07:51.50,Default,,0,0,0,,Бұл әлі жалғасып жатыр ма?
Dialogue: 0,0:07:53.60,0:07:55.11,Default,,0,0,0,,Жоқ... бұл не?
Dialogue: 0,0:07:55.67,0:07:58.50,Default,,0,0,0,,Бұны оюға бір апта уақытыңыз бар.
Dialogue: 0,0:08:00.78,0:08:02.09,Default,,0,0,0,,Тым мағынасыз
Dialogue: 0,0:08:02.88,0:08:03.95,Default,,0,0,0,,болды
Dialogue: 0,0:08:03.95,0:08:06.26,Default,,0,0,0,,Ұйқы уақыты қысқарады.
Dialogue: 0,0:08:13.15,0:08:15.01,Default,,0,0,0,,Жарықты өшіре аламын ба?
Dialogue: 0,0:08:16.00,0:08:20.01,Default,,0,0,0,,Арашико-сан, қызметшілер топтарда жұмыс істей ме?
Dialogue: 0,0:08:20.74,0:08:22.48,Default,,0,0,0,,Бұл да маңызды
Dialogue: 0,0:08:23.74,0:08:24.54,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:08:30.03,0:08:31.79,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:08:32.73,0:08:34.19,Default,,0,0,0,,Бамбук бар.
Dialogue: 0,0:08:34.54,0:08:35.23,Default,,0,0,0,,Сіз тамақ ішесіз бе?
Dialogue: 0,0:08:36.72,0:08:39.55,Default,,0,0,0,,Дұрыс, бұл адам.
Dialogue: 0,0:08:45.81,0:08:48.26,Default,,0,0,0,,Бұл уақыт таңғы жиын болуы керек.
Dialogue: 0,0:08:48.88,0:08:50.64,Default,,0,0,0,,Біз сізге бойкот жариялаймыз!
Dialogue: 0,0:08:51.15,0:08:52.86,Default,,0,0,0,,Топтан шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:08:53.28,0:08:55.40,Default,,0,0,0,,Мен жаттықтырушыны ауыстырғым келеді.
Dialogue: 0,0:08:55.78,0:08:59.03,Default,,0,0,0,,Жануармен үйлеспей жаттығудан өту тиімсіз болар еді.
Dialogue: 0,0:08:59.65,0:09:02.06,Default,,0,0,0,,Барлық өкілеттіктер маған берілген.
Dialogue: 0,0:09:02.26,0:09:04.00,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:04.00,0:09:09.29,Default,,0,0,0,,Бойкот Бойкот…
Dialogue: 0,0:09:10.60,0:09:11.58,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:09:13.01,0:09:16.62,Default,,0,0,0,,Түсіндім, мен сендерге арналған деп ойладым.
Dialogue: 0,0:09:17.10,0:09:19.02,Default,,0,0,0,,Мен өз әрекетімде қателік жібердім деп ойлаймын.
Dialogue: 0,0:09:20.49,0:09:21.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:21.56,0:09:23.60,Default,,0,0,0,,Кю... Сіз кенеттен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:09:23.97,0:09:26.60,Default,,0,0,0,,Соңында әрқайсыңызбен жеке сөйлесуге рұқсат етіңіз.
Dialogue: 0,0:09:27.61,0:09:30.72,Default,,0,0,0,,Егер мені әлі де қуып жібергің келсе, мен бағынамын.
Dialogue: 0,0:09:31.86,0:09:32.70,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:09:33.01,0:09:35.72,Default,,0,0,0,,Ал, жай ғана әңгіме.
Dialogue: 0,0:09:44.22,0:09:46.66,Default,,0,0,0,,Жоқ... Қызық, не айтып тұрсыз?
Dialogue: 0,0:09:51.44,0:09:55.20,Default,,0,0,0,,Нагоми Кедамоланд тобының ғимаратына қараңыз
Dialogue: 0,0:10:01.09,0:10:01.64,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:10:02.06,0:10:03.58,Default,,0,0,0,,О... бұл үлкен.
Dialogue: 0,0:10:04.15,0:10:06.56,Default,,0,0,0,,Топ пен қызметші арасындағы қарым-қатынас қандай екенін білесің бе?
Dialogue: 0,0:10:07.41,0:10:08.88,Default,,0,0,0,,Мен... онша жақсы емес
Dialogue: 0,0:10:09.32,0:10:10.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:31.29,0:10:33.12,Default,,0,0,0,,Жоқ... жоқ мен өлемін
Dialogue: 0,0:10:33.12,0:10:36.32,Default,,0,0,0,,Жарайды, өлсем де бұл қолды жібермеймін.
Dialogue: 0,0:10:36.32,0:10:38.62,Default,,0,0,0,,Жоқ, тартыңыз.
Dialogue: 0,0:10:39.03,0:10:42.86,Default,,0,0,0,,Бұл қол топ пен қызметші арасындағы қарым-қатынастың өзі.
Dialogue: 0,0:10:43.30,0:10:44.10,Default,,0,0,0,,Олар бүгін сағат 13:00-де жариялануы тиіс еді
Dialogue: 0,0:10:44.10,0:10:46.19,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:10:46.19,0:10:47.29,Default,,0,0,0,,Сіздің жауабыңыз басқаша.
Dialogue: 0,0:10:47.63,0:10:50.30,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:10:50.66,0:10:52.87,Default,,0,0,0,,Дамоно
Dialogue: 0,0:10:58.69,0:10:59.67,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:11:00.62,0:11:01.56,Default,,0,0,0,,Олар бүгін сағат 13:00-де жариялануы тиіс еді
Dialogue: 0,0:11:03.09,0:11:03.69,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.98,0:11:05.14,Default,,0,0,0,,Сіз не білдіңіз?
Dialogue: 0,0:11:05.52,0:11:07.02,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:07.16,0:11:08.69,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:11:09.03,0:11:10.64,Default,,0,0,0,,Бұл қол – топ
Dialogue: 0,0:11:11.15,0:11:13.54,Default,,0,0,0,,Қызметші қанша зардап шексе де қорға
Dialogue: 0,0:11:16.79,0:11:20.24,Default,,0,0,0,,Ал қызметші Охире-чанды бұрып жібереді.
Dialogue: 0,0:11:21.12,0:11:23.77,Default,,0,0,0,,Бұл қанға байланысты қарым-қатынас.
Dialogue: 0,0:11:24.41,0:11:26.99,Default,,0,0,0,,бұл... Иә Иә
Dialogue: 0,0:11:27.42,0:11:30.13,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:11:36.10,0:11:37.75,Default,,0,0,0,,А, мені тастап кетті.
Dialogue: 0,0:11:38.39,0:11:39.28,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:11:39.70,0:11:40.97,Default,,0,0,0,,Шынымен тітіркендіргіш
Dialogue: 0,0:11:45.89,0:11:46.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:47.36,0:11:51.28,Default,,0,0,0,,Сано мырзаның айтып отырғаны таң қаларлықтай орынды.
Dialogue: 0,0:11:52.43,0:11:54.40,Default,,0,0,0,,Мүмкін ол жаман адам емес шығар.
Dialogue: 0,0:11:54.96,0:11:57.95,Default,,0,0,0,,Мен де бір рет дұрыс оқытқым келеді.
Dialogue: 0,0:11:59.26,0:12:01.03,Default,,0,0,0,,Мен оны қуып жіберемін.
Dialogue: 0,0:12:01.36,0:12:04.50,Default,,0,0,0,,Бұл шамамен бір апта. Сіз көріңіз.
Dialogue: 0,0:12:05.78,0:12:06.82,Default,,0,0,0,,Арашико
Dialogue: 0,0:12:07.48,0:12:09.34,Default,,0,0,0,,үшін тәжірибе ме?
Dialogue: 0,0:12:10.58,0:12:11.38,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:12:15.97,0:12:17.88,Default,,0,0,0,,Мұнда тауық күріш өртенеді.
Dialogue: 0,0:12:17.88,0:12:19.12,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:12:19.38,0:12:20.85,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:12:21.07,0:12:22.39,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:12:22.72,0:12:24.02,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:24.17,0:12:25.49,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:25.81,0:12:27.89,Default,,0,0,0,,Бүгінгі жұмысқа қалай қарайсыз?
Dialogue: 0,0:12:28.29,0:12:30.40,Default,,0,0,0,,Топты бағалау жұмысы
Dialogue: 0,0:12:30.57,0:12:34.65,Default,,0,0,0,,Юмэчи Юмэчи…
Dialogue: 0,0:12:31.11,0:12:35.07,Default,,0,0,0,,Иә Иә…
Dialogue: 0,0:12:35.21,0:12:37.95,Default,,0,0,0,,Юмечи 100 000 иен Охире-чан, қажырлы еңбегіңіз үшін рахмет
Dialogue: 0,0:12:37.95,0:12:39.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:40.81,0:12:41.81,Default,,0,0,0,,Алған әсерлерің қандай?
Dialogue: 0,0:12:41.95,0:12:44.49,Default,,0,0,0,,Мен Kedamoland тобына үлес қоса алатыныма қуаныштымын
Dialogue: 0,0:12:45.57,0:12:47.80,Default,,0,0,0,,Көңілге бой алдырма, сен эйссің.
Dialogue: 0,0:12:47.93,0:12:49.57,Default,,0,0,0,,Сіз көбірек бұрылыстар жасай аласыз.
Dialogue: 0,0:12:49.57,0:12:50.50,Default,,0,0,0,,Көбірек бұраңыз
Dialogue: 0,0:12:50.81,0:12:53.92,Default,,0,0,0,,Жарайды, барлығымыз тұтынушыларға қызмет көрсетуге назар аударайық.
Dialogue: 0,0:12:54.35,0:12:55.42,Default,,0,0,0,,Жарайсың Дэмоно
Dialogue: 0,0:12:56.20,0:12:57.13,Default,,0,0,0,,Басқа жерде
Dialogue: 0,0:12:57.13,0:12:57.79,Default,,0,0,0,,Иә
Dialogue: 0,0:12:58.00,0:12:58.98,Default,,0,0,0,,Жарайсың Зоя
Dialogue: 0,0:12:59.20,0:13:01.17,Default,,0,0,0,,Нагоми-санның итерілуі әлсіз болды
Dialogue: 0,0:13:01.25,0:13:03.99,Default,,0,0,0,,Өйткені шебер бұйырмай кетіп қалды.
Dialogue: 0,0:13:04.30,0:13:07.27,Default,,0,0,0,,Көрсеткеніңізге рахмет, Зоя.
Dialogue: 0,0:13:07.52,0:13:09.39,Default,,0,0,0,,Сано Сенсей Итадакимасу
Dialogue: 0,0:13:10.12,0:13:11.62,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:13:19.75,0:13:20.85,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:21.20,0:13:22.12,Default,,0,0,0,,Басқа жерде
Dialogue: 0,0:13:25.37,0:13:28.28,Default,,0,0,0,,Шипон бүгінгі тәжірибеге де саботаж жасады.
Dialogue: 0,0:13:28.52,0:13:32.08,Default,,0,0,0,,Мен Шипон тобына деген адалдықты сезбеймін.
Dialogue: 0,0:13:32.28,0:13:34.04,Default,,0,0,0,,Mi… барлығына
Dialogue: 0,0:13:38.30,0:13:39.49,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:13:39.49,0:13:42.57,Default,,0,0,0,,Охире-чанға жұмыс істеу қуанышын түсінемін.
Dialogue: 0,0:13:42.57,0:13:44.85,Default,,0,0,0,,Мен ертеңнен бастап топ үшін бар күшімді саламын.
Dialogue: 0,0:13:49.85,0:13:54.12,Default,,0,0,0,,Рахмет, Сано мырза...
Dialogue: 0,0:14:01.32,0:14:02.46,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:05.85,0:14:06.70,Default,,0,0,0,,Ол қашқын.
Dialogue: 0,0:14:07.15,0:14:08.22,Default,,0,0,0,,Түсіру
Dialogue: 0,0:14:13.55,0:14:14.14,Default,,0,0,0,,Өтірік
Dialogue: 0,0:14:19.20,0:14:20.96,Default,,0,0,0,,Шипон
Dialogue: 0,0:14:21.14,0:14:22.99,Default,,0,0,0,,Шық!
Dialogue: 0,0:14:23.15,0:14:25.91,Default,,0,0,0,,Әр адам қателеседі.
Dialogue: 0,0:14:26.65,0:14:28.20,Default,,0,0,0,,Шипон
Dialogue: 0,0:14:30.06,0:14:31.74,Default,,0,0,0,,Аш, тез аш.
Dialogue: 0,0:14:34.32,0:14:35.07,Default,,0,0,0,,Арашико
Dialogue: 0,0:14:44.02,0:14:45.82,Default,,0,0,0,,Осы жерден сыртқа шығуға болады.
Dialogue: 0,0:14:46.52,0:14:47.78,Default,,0,0,0,,Мен... бәрібір.
Dialogue: 0,0:14:48.49,0:14:49.92,Default,,0,0,0,,Шипон мырза қаласа
Dialogue: 0,0:14:51.44,0:14:52.12,Default,,0,0,0,,Арашико
Dialogue: 0,0:14:52.75,0:14:54.58,Default,,0,0,0,,Мен осы жерде қызметші болып жұмыс істеуді жалғастырамын.
Dialogue: 0,0:14:55.46,0:14:57.92,Default,,0,0,0,,Мен жай ғана осы дүкенді қорғағым келеді.
Dialogue: 0,0:14:59.33,0:15:00.38,Default,,0,0,0,,Шипон мырза
Dialogue: 0,0:15:01.27,0:15:02.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.76,0:15:06.69,Default,,0,0,0,,Әйтеуір басталған қызметші
Dialogue: 0,0:15:07.95,0:15:10.14,Default,,0,0,0,,Оған дейін ештеңе болған жоқ.
Dialogue: 0,0:15:12.08,0:15:14.30,Default,,0,0,0,,Неліктен қызметші болуды жалғастырдыңыз?
Dialogue: 0,0:15:17.55,0:15:20.40,Default,,0,0,0,,Аа, мен қызметші болып қызық болдым.
Dialogue: 0,0:15:23.65,0:15:24.42,Default,,0,0,0,,Ашылды
Dialogue: 0,0:15:27.02,0:15:28.41,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:15:29.33,0:15:32.01,Default,,0,0,0,,Ол бұрынғы Тонтокотодан өзгеше.
Dialogue: 0,0:15:44.07,0:15:44.70,Default,,0,0,0,,Арашико
Dialogue: 0,0:15:45.63,0:15:48.71,Default,,0,0,0,,А, мен әлі де қызметші болғым келеді.
Dialogue: 0,0:15:54.57,0:15:55.16,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:15:55.53,0:15:56.90,Default,,0,0,0,,Сүйкімді өлім
Dialogue: 0,0:15:58.71,0:16:01.83,Default,,0,0,0,,Бүгіннен бастап, топ үшін барынша еңбектеніңіз.
Dialogue: 0,0:16:03.14,0:16:05.99,Default,,0,0,0,,Мынау сүйкімді және сізге жақсырақ жарасады.
Dialogue: 0,0:16:06.74,0:16:07.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:08.74,0:16:10.49,Default,,0,0,0,,Ерінбе, таңғы жиын.
Dialogue: 0,0:16:10.76,0:16:12.04,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:16:23.09,0:16:24.82,Default,,0,0,0,,Охири-чан - 100 000 иен.
Dialogue: 0,0:16:30.07,0:16:31.39,Default,,0,0,0,,Осылай күттіріп қойдыңдар.
Dialogue: 0,0:16:33.53,0:16:34.75,Default,,0,0,0,,Жарайсың Дэмоно
Dialogue: 0,0:16:43.04,0:16:45.90,Default,,0,0,0,,Енді тренингтің соңғы нәтижелерін жариялаймыз.
Dialogue: 0,0:16:46.27,0:16:46.70,Default,,0,0,0,,Иә
Dialogue: 0,0:16:47.19,0:16:49.55,Default,,0,0,0,,Балалар сендер ең нашар қызметшілерсіңдер.
Dialogue: 0,0:16:49.83,0:16:50.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:50.66,0:16:54.58,Default,,0,0,0,,оның басы қырыққабат. Ол құқық бұзушы және оңай босатады.
Dialogue: 0,0:16:54.71,0:16:56.70,Default,,0,0,0,,Ол ең нашар қызметші.
Dialogue: 0,0:16:57.02,0:16:57.60,Default,,0,0,0,,Иә
Dialogue: 0,0:16:58.95,0:17:00.94,Default,,0,0,0,,Бірақ бұл ең жақсысы
Dialogue: 0,0:17:02.43,0:17:03.75,Default,,0,0,0,,үшін өтті
Dialogue: 0,0:17:04.88,0:17:05.58,Default,,0,0,0,,Иә
Dialogue: 0,0:17:08.37,0:17:09.93,Default,,0,0,0,,Қызметші оңай жыламасын.
Dialogue: 0,0:17:10.31,0:17:11.78,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,0:17:12.90,0:17:13.49,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:17:13.96,0:17:17.64,Default,,0,0,0,,Бүгіннен бастап біз бәріміз жасаған осыны қараңыз және оны күн сайын есте сақтаймыз.
Dialogue: 0,0:17:18.03,0:17:20.72,Default,,0,0,0,,Егер сіз Кедамоланд тобының қызметшісі болсаңыз
Dialogue: 0,0:17:22.04,0:17:23.75,Default,,0,0,0,,Жарайды Дэмоно
Dialogue: 0,0:17:32.91,0:17:34.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:35.27,0:17:38.01,Default,,0,0,0,,Рахмет, Сано мырза.
Dialogue: 0,0:17:39.82,0:17:42.69,Default,,0,0,0,,Окачимачи мырза, сіз шаршадыңыз.
Dialogue: 0,0:17:43.38,0:17:44.91,Default,,0,0,0,,Мен де шаршадым.
Dialogue: 0,0:17:45.71,0:17:48.30,Default,,0,0,0,,Мен қатты ұйықтап жатырмын.
Dialogue: 0,0:17:48.91,0:17:50.03,Default,,0,0,0,,Менің ұйқым келіп тұр
Dialogue: 0,0:17:50.95,0:17:54.21,Default,,0,0,0,,Бірақ мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:17:54.77,0:17:58.47,Default,,0,0,0,,Олар жеткілікті ақша таппағандықтан, мен үнемі ашуланамын.
Dialogue: 0,0:17:59.51,0:18:01.15,Default,,0,0,0,,Барған сайын тітіркеніп барамын.
Dialogue: 0,0:18:04.05,0:18:06.08,Default,,0,0,0,,Ауру шошқаның кезегі.
Dialogue: 0,0:18:06.69,0:18:09.62,Default,,0,0,0,,Ұстаз, өтінемін.
Dialogue: 0,0:18:09.92,0:18:12.82,Default,,0,0,0,,Юмэчи-саннан жеңілгім келмейді.
Dialogue: 0,0:18:13.68,0:18:14.09,Default,,0,0,0,,Иә
Dialogue: 0,0:18:14.09,0:18:16.16,Default,,0,0,0,,Оны тікелей эфирге жіберіңіз.
Dialogue: 0,0:18:16.53,0:18:18.26,Default,,0,0,0,,Бұл Шипон.
Dialogue: 0,0:18:18.55,0:18:21.08,Default,,0,0,0,,Машита Иткидің алдында серуендейді.
Dialogue: 0,0:18:21.47,0:18:23.59,Default,,0,0,0,,Юмэчи-сан, бозарып кеткен сияқтысың.
Dialogue: 0,0:18:23.91,0:18:25.28,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,0:18:25.79,0:18:29.26,Default,,0,0,0,,Охире-чан үшін көп нәрсені қысқартуға тура келеді.
Dialogue: 0,0:18:31.50,0:18:34.01,Default,,0,0,0,,Теме және т.б. Бұл жөнінде уайымдамаңыз.
Dialogue: 0,0:18:34.28,0:18:35.30,Default,,0,0,0,,Менеджер?
Dialogue: 0,0:18:35.38,0:18:36.35,Default,,0,0,0,,Шипон мырза?
Dialogue: 0,0:18:36.81,0:18:40.02,Default,,0,0,0,,Бұл дүкен менің дүкенім.
Dialogue: 0,0:18:40.48,0:18:43.29,Default,,0,0,0,,Мен сені қуып шыққаныма өкінемін
Dialogue: 0,0:18:44.69,0:18:46.69,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:47.60,0:18:49.40,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:18:53.45,0:18:54.43,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:18:55.38,0:18:56.62,Default,,0,0,0,,Арашико-сан?
Dialogue: 0,0:19:00.62,0:19:02.96,Default,,0,0,0,,Рахмет Арашико
Dialogue: 0,0:19:03.10,0:19:04.93,Default,,0,0,0,,Арашико-сан Го Раншин Деска
Dialogue: 0,0:19:05.11,0:19:06.08,Default,,0,0,0,,Нагоми аялдамасы
Dialogue: 0,0:19:06.26,0:19:06.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.05,0:19:16.88,Default,,0,0,0,,Шипон мырза
Dialogue: 0,0:19:17.90,0:19:18.81,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:19:20.27,0:19:21.81,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:22.03,0:19:23.29,Default,,0,0,0,,Мұны істеуді тоқтатыңыз.
Dialogue: 0,0:19:23.58,0:19:26.59,Default,,0,0,0,,Сано мырзамен арамыздағы байланыс осы.
Dialogue: 0,0:19:26.59,0:19:29.22,Default,,0,0,0,,Неліктен біз қызметші болып жұмыс істейміз?
Dialogue: 0,0:19:29.45,0:19:30.85,Default,,0,0,0,,Бұл топқа арналған, солай ма?
Dialogue: 0,0:19:30.85,0:19:32.09,Default,,0,0,0,,Чигесшо
Dialogue: 0,0:19:35.02,0:19:37.21,Default,,0,0,0,,Тіпті мына шіріген Акибада
Dialogue: 0,0:19:37.49,0:19:40.20,Default,,0,0,0,,Өзімді қызық сезінетін сәттер болады.
Dialogue: 0,0:19:42.61,0:19:45.13,Default,,0,0,0,,Шошқалар
Dialogue: 0,0:19:45.57,0:19:50.04,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:19:57.17,0:20:01.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:20.23,0:20:21.47,Default,,0,0,0,,Неліктен пандалар?
Dialogue: 0,0:20:22.90,0:20:24.12,Default,,0,0,0,,Окачимачи мырза
Dialogue: 0,0:20:24.45,0:20:26.25,Default,,0,0,0,,Иә, бұл бамбук.
Dialogue: 0,0:20:26.47,0:20:29.27,Default,,0,0,0,,Менеджер, сіз парфетті қайтадан рұқсатсыз жедіңіз.
Dialogue: 0,0:20:29.48,0:20:31.11,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:20:31.11,0:20:32.42,Default,,0,0,0,,Мен үшін де Итадакимашита
Dialogue: 0,0:20:32.68,0:20:33.59,Default,,0,0,0,,Зоя да?
Dialogue: 0,0:20:34.00,0:20:36.22,Default,,0,0,0,,Не болды? Ол қалыпты жағдайға оралды.
Dialogue: 0,0:20:36.49,0:20:38.09,Default,,0,0,0,,Кіру және шығу
Dialogue: 0,0:20:38.70,0:20:40.05,Default,,0,0,0,,Түсіндіріңіз.
Dialogue: 0,0:20:41.17,0:20:42.78,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:20:43.03,0:20:44.11,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:20:44.11,0:20:45.50,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:20:45.50,0:20:47.15,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:47.30,0:20:49.38,Default,,0,0,0,,Басқа шеберлер де бар, сондықтан...
Dialogue: 0,0:20:49.38,0:20:50.12,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:20:50.34,0:20:52.21,Default,,0,0,0,,Мына ұсқынсыз макияждың несі бар?
Dialogue: 0,0:20:52.50,0:20:53.65,Default,,0,0,0,,Бұл маған сәйкес келмейді.
Dialogue: 0,0:20:55.55,0:20:58.69,Default,,0,0,0,,А, бұл макияж ең күшті және ең жақсы
Dialogue: 0,0:20:58.92,0:21:00.23,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:21:00.68,0:21:02.30,Default,,0,0,0,,Сано мырза, сіз тым көп айтасыз.
Dialogue: 0,0:21:02.59,0:21:05.96,Default,,0,0,0,,Ұстаз осында, сондықтан тыныш болыңыз.
Dialogue: 0,0:21:06.08,0:21:09.29,Default,,0,0,0,,Сано-сан, Шипон-санды ұрма.
Dialogue: 0,0:21:11.15,0:21:13.29,Default,,0,0,0,,Сондай-ақ... бұл енді жақсы емес, мына жігіттер.
Dialogue: 0,0:21:14.00,0:21:16.67,Default,,0,0,0,,Аңдарды үйретуде сәтсіздік жоқ.
Dialogue: 0,0:21:17.76,0:21:19.72,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз
Dialogue: 0,0:21:20.36,0:21:22.60,Default,,0,0,0,,Мен жауаптымын
Dialogue: 0,0:21:22.95,0:21:23.83,Default,,0,0,0,,Экскоммуникация…
Dialogue: 0,0:21:23.83,0:21:25.58,Default,,0,0,0,,No Оқшаулау?
Dialogue: 0,0:21:31.29,0:21:33.69,Default,,0,0,0,,Қош келдіңіз, жас ханым.
Dialogue: 0,0:21:45.26,0:21:47.57,Default,,0,0,0,,Бұл том-хане
Dialogue: 0,0:21:49.92,0:21:50.87,Default,,0,0,0,,Нагоми
Dialogue: 0,0:21:51.16,0:21:51.77,Default,,0,0,0,,Иә
Dialogue: 0,0:21:52.65,0:21:54.34,Default,,0,0,0,,Қолдарыңызды көтеріңіз.
Dialogue: 0,0:21:55.43,0:21:56.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:57.80,0:21:59.68,Default,,0,0,0,,Бейбіт Нагоми 17 жаста
Dialogue: 0,0:21:59.96,0:22:02.00,Default,,0,0,0,,Қызметші болып өсті
Dialogue: 0,0:22:04.40,0:22:07.54,Default,,0,0,0,,Шипон-сан, қызметші болу қызық.
Dialogue: 0,0:22:08.13,0:22:09.41,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:10.91,0:22:16.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
