Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:00.64,0:00:02.16,Dial-JP,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 1,0:00:03.65,0:00:04.49,Dial-JP,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 1,0:00:06.09,0:00:06.86,Dial-JP,,0,0,0,,Нагоми-сан
Dialogue: 1,0:00:07.30,0:00:08.36,Dial-JP,,0,0,0,,қазіргі уақытта қарғысқа ұшыраған эмбрионмен бірге әлі де сонда қамалып отыр –
Dialogue: 1,0:00:08.36,0:00:10.87,Dial-JP,,0,0,0,,Яда яда яда Мен батып бара жатырмын
Dialogue: 1,0:00:11.04,0:00:12.62,Dial-JP,,0,0,0,,Арашико-сан!
Dialogue: 1,0:01:44.27,0:01:46.63,Dial-JP,,0,0,0,,«Шошқа еті лотереясын» қайтадан ұтасыз ба?
Dialogue: 1,0:01:47.05,0:01:48.74,Dial-JP,,0,0,0,,Юмэчи тосынсыйы
Dialogue: 1,0:01:48.74,0:01:50.57,Dial-JP,,0,0,0,,Бір нәрсе
Dialogue: 1,0:01:50.57,0:01:54.51,Dial-JP,,0,0,0,,Жалғыз гүл жасағаннан жақсы
Dialogue: 1,0:01:54.73,0:01:58.36,Dial-JP,,0,0,0,,Екі адам жасаса, ақша табады
Dialogue: 1,0:01:58.36,0:02:02.33,Dial-JP,,0,0,0,,Бұл менің қызметші жолым
Dialogue: 1,0:02:02.33,0:02:04.48,Dial-JP,,0,0,0,,Беттанко Беттанко
Dialogue: 1,0:02:04.48,0:02:06.30,Dial-JP,,0,0,0,,Иә, екі.
Dialogue: 1,0:02:06.30,0:02:07.08,Dial-JP,,0,0,0,,Ум...
Dialogue: 1,0:02:07.82,0:02:09.32,Dial-JP,,0,0,0,,Енді тоқтаймыз ба?
Dialogue: 1,0:02:09.32,0:02:09.91,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:02:09.91,0:02:11.61,Dial-JP,,0,0,0,,Бұл ән менің кернеуімді төмендетеді.
Dialogue: 1,0:02:12.45,0:02:14.31,Dial-JP,,0,0,0,,Беттанко Беттанко
Dialogue: 1,0:02:14.31,0:02:15.42,Dial-JP,,0,0,0,,Ән айтуда
Dialogue: 1,0:02:15.42,0:02:17.65,Dial-JP,,0,0,0,,Менеджер Сізде қанша үстел қалды?
Dialogue: 1,0:02:18.16,0:02:20.21,Dial-JP,,0,0,0,,Бірліктің бағасы 0,5 иен болғандықтан...
Dialogue: 1,0:02:20.35,0:02:21.45,Dial-JP,,0,0,0,,Шамамен миллион дана?
Dialogue: 1,0:02:21.45,0:02:21.79,Dial-JP,,0,0,0,,Ия...
Dialogue: 1,0:02:22.15,0:02:23.94,Dial-JP,,0,0,0,,Жарайды, жарайды
Dialogue: 1,0:02:23.94,0:02:26.11,Dial-JP,,0,0,0,,Оны 5 адамға бөлсеңіз, әр адамға 200 000 дана беріледі.
Dialogue: 1,0:02:26.29,0:02:28.36,Dial-JP,,0,0,0,,Нагоми де дүкеннен бас тартқысы келмейді.
Dialogue: 1,0:02:29.36,0:02:33.37,Dial-JP,,0,0,0,,Егер мен мерзімі өткен 500 000 иенді осы айдың соңына дейін төлей алмасам
Dialogue: 1,0:02:33.54,0:02:34.93,Dial-JP,,0,0,0,,Біздің дүкен жабық сияқты.
Dialogue: 1,0:02:35.64,0:02:38.22,Dial-JP,,0,0,0,,Иә, кері санақ басталды.
Dialogue: 1,0:02:38.43,0:02:39.51,Dial-JP,,0,0,0,,Енді бәрі таусылды
Dialogue: 1,0:02:39.51,0:02:42.64,Dial-JP,,0,0,0,,Саусақтарыңызды жоғары жылдамдықпен жылжыту ғана қалды.
Dialogue: 1,0:02:43.12,0:02:44.28,Dial-JP,,0,0,0,,1 миллион дана қалды
Dialogue: 1,0:02:44.28,0:02:45.91,Dial-JP,,0,0,0,,Өлемін деген ниетпен жасанды гүлдер жасау
Dialogue: 1,0:02:46.12,0:02:48.42,Dial-JP,,0,0,0,,Саджи лақтырылды.
Dialogue: 1,0:02:48.42,0:02:49.90,Dial-JP,,0,0,0,,Саджи лақтырудың несі айып?
Dialogue: 1,0:02:54.62,0:02:56.17,Dial-JP,,0,0,0,,Сіз парақшаны ауыстырдыңыз ба?
Dialogue: 1,0:02:56.98,0:02:59.41,Dial-JP,,0,0,0,,Атмосфера бұрынғыдан сәл өзгеше.
Dialogue: 1,0:02:59.78,0:03:02.33,Dial-JP,,0,0,0,,Мм... Мен сия сатып алмаймын.
Dialogue: 1,0:03:02.99,0:03:06.62,Dial-JP,,0,0,0,,Сондықтан сияны барынша үнемдеу үшін басып шығарамын.
Dialogue: 1,0:03:08.21,0:03:10.76,Dial-JP,,0,0,0,,Ал... бұл ерекше.
Dialogue: 1,0:03:11.16,0:03:12.14,Dial-JP,,0,0,0,,Рахмет
Dialogue: 1,0:03:12.48,0:03:14.21,Dial-JP,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 1,0:03:14.40,0:03:15.64,Dial-JP,,0,0,0,,Иә, бұл не?
Dialogue: 1,0:03:16.13,0:03:19.40,Dial-JP,,0,0,0,,Дүкенге ақшаны қалай кіргіземін деп ойлаймын.
Dialogue: 1,0:03:20.07,0:03:21.28,Dial-JP,,0,0,0,,Бұл дұрыс.
Dialogue: 1,0:03:21.72,0:03:23.56,Dial-JP,,0,0,0,,Бұл оқиға емес пе?
Dialogue: 1,0:03:23.97,0:03:24.71,Dial-JP,,0,0,0,,Оқиға?
Dialogue: 1,0:03:24.90,0:03:27.61,Dial-JP,,0,0,0,,Ертең менің үйімде «Космо Мелос күні».
Dialogue: 1,0:03:27.61,0:03:29.55,Dial-JP,,0,0,0,,Келесі апта «Кафка Үлкен жарылыс аптасы»
Dialogue: 1,0:03:29.79,0:03:32.25,Dial-JP,,0,0,0,,Өйткені, оқиғалар тұтынушыларды оңай тартады.
Dialogue: 1,0:03:33.31,0:03:34.79,Dial-JP,,0,0,0,,Көңілді сияқты
Dialogue: 1,0:03:35.21,0:03:37.93,Dial-JP,,0,0,0,,Егер бұл стандарт болса, туған күн оқиғасы болар ма еді?
Dialogue: 1,0:03:38.21,0:03:39.24,Dial-JP,,0,0,0,,Туған күн?
Dialogue: 1,0:03:39.61,0:03:42.42,Dial-JP,,0,0,0,,Нагоми дүкені Kedamoland тобына кіреді.
Dialogue: 1,0:03:42.69,0:03:45.71,Dial-JP,,0,0,0,,Сіз еншілес дүкендерден көмек ала аласыз.
Dialogue: 1,0:03:46.53,0:03:48.04,Dial-JP,,0,0,0,,Туған күн оқиғасы?
Dialogue: 1,0:03:48.24,0:03:48.75,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:03:49.07,0:03:50.98,Dial-JP,,0,0,0,,Жақында туған күніңіз бар ма?
Dialogue: 1,0:03:51.15,0:03:53.46,Dial-JP,,0,0,0,,Мен саған туған күнімді айтқым келмейді.
Dialogue: 1,0:03:53.65,0:03:56.28,Dial-JP,,0,0,0,,Бұл уақытта ешкім тумайды.
Dialogue: 1,0:03:56.75,0:03:59.64,Dial-JP,,0,0,0,,Мен ертең 36-ға толамын.
Dialogue: 1,0:04:00.12,0:04:02.32,Dial-JP,,0,0,0,,Ертең? Мажуке
Dialogue: 1,0:04:02.32,0:04:04.39,Dial-JP,,0,0,0,,Арашико-санның туған күні Аряшитака
Dialogue: 1,0:04:05.27,0:04:06.34,Dial-JP,,0,0,0,,Ақша жоқ
Dialogue: 1,0:04:06.34,0:04:08.47,Dial-JP,,0,0,0,,Бюджетіңізді емес, басыңызды пайдаланыңыз
Dialogue: 1,0:04:08.69,0:04:09.35,Dial-JP,,0,0,0,,Керемет, Арашико.
Dialogue: 1,0:04:10.14,0:04:10.96,Dial-JP,,0,0,0,,Түсінікті
Dialogue: 1,0:04:11.62,0:04:12.87,Dial-JP,,0,0,0,,Мен саған көмектесемін
Dialogue: 1,0:04:15.66,0:04:16.56,Dial-JP,,0,0,0,,Хой Мэши
Dialogue: 1,0:04:17.83,0:04:19.30,Dial-JP,,0,0,0,,Тағы да солай
Dialogue: 1,0:04:19.30,0:04:20.14,Dial-JP,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 1,0:04:20.14,0:04:21.92,Dial-JP,,0,0,0,,Дәмі үшін ризамын.
Dialogue: 1,0:04:22.22,0:04:23.07,Dial-JP,,0,0,0,,Ика Шипон
Dialogue: 1,0:04:23.36,0:04:26.00,Dial-JP2,,0,0,0,,Соғыс кезінде асқабақтың жапырақтары мен сабағын қайнатқан...
Dialogue: 1,0:04:24.57,0:04:26.00,Dial-JP,,0,0,0,,Арашико мен Нагоми
Dialogue: 1,0:04:26.61,0:04:28.33,Dial-JP,,0,0,0,,Бізде іс-шара жиналысы болып жатыр.
Dialogue: 1,0:04:29.25,0:04:30.69,Dial-JP,,0,0,0,,Мен оны уақытында орындаймын ба?
Dialogue: 1,0:04:31.52,0:04:34.38,Dial-JP,,0,0,0,,Мен флайерді өзінше ойлауға тырыстым.
Dialogue: 1,0:04:34.84,0:04:36.76,Dial-JP,,0,0,0,,Керемет, көрсетіңізші.
Dialogue: 1,0:04:39.84,0:04:41.83,Dial-JP,,0,0,0,,Менің ойымша, бұл аздап әсер етпейді
Dialogue: 1,0:04:41.83,0:04:43.63,Dial-JP,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 1,0:04:44.00,0:04:45.97,Dial-JP,,0,0,0,,Мен де бағдарлама туралы ойландым.
Dialogue: 1,0:04:48.37,0:04:51.10,Dial-JP,,0,0,0,,"Чинчироринді" қайда қосу керектігін шеше алмай жүрмін.
Dialogue: 1,0:04:51.37,0:04:53.06,Dial-JP,,0,0,0,,Чи… Чин Чин…
Dialogue: 1,0:04:53.97,0:04:55.91,Dial-JP,,0,0,0,,Мен үшін әлі ерте
Dialogue: 1,0:04:55.91,0:04:57.73,Dial-JP,,0,0,0,,Бұл мені қызықтырмайды дегенді білдірмейді.
Dialogue: 1,0:04:57.90,0:04:59.28,Dial-JP,,0,0,0,,Жас ерекшелігі бойынша.
Dialogue: 1,0:04:59.28,0:05:01.66,Dial-JP,,0,0,0,,Сүйектерді ойнағанда жас маңызды ма?
Dialogue: 1,0:05:02.82,0:05:05.83,Dial-JP,,0,0,0,,Тотото... Әйтеуір, менің қолымнан мұндай көп нәрсе келмейді.
Dialogue: 1,0:05:05.98,0:05:07.23,Dial-JP,,0,0,0,,Бұл қиын ба?
Dialogue: 1,0:05:07.62,0:05:08.58,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:05:12.80,0:05:16.34,Dial-JP,,0,0,0,,Ендеше, бірге тағы біраз қорытындылайық.
Dialogue: 1,0:05:16.72,0:05:17.61,Dial-JP,,0,0,0,,Тексеру
Dialogue: 1,0:05:18.90,0:05:19.44,Dial-JP,,0,0,0,,Ум...
Dialogue: 1,0:05:20.53,0:05:22.01,Dial-JP,,0,0,0,,Қарсы болмасаңыз.
Dialogue: 1,0:05:22.28,0:05:25.11,Dial-JP,,0,0,0,,Арашико-санға торт дайындағыңыз келе ме?
Dialogue: 1,0:05:25.56,0:05:27.51,Dial-JP,,0,0,0,,Бұл арзан, сондықтан мен қарсы емеспін.
Dialogue: 1,0:05:30.38,0:05:32.86,Dial-JP,,0,0,0,,Мен қуырылған бұршақ өскіндерін жеуге тырыссам да.
Dialogue: 1,0:05:32.86,0:05:34.27,Dial-JP,,0,0,0,,Осыншама ақшаны қайдан аласыз?
Dialogue: 1,0:05:34.72,0:05:37.57,Dial-JP,,0,0,0,,Сонымен... Бірақ егер туған күн оқиғасы қызықтырақ болса
Dialogue: 1,0:05:37.99,0:05:38.96,Dial-JP,,0,0,0,,Бұл қызықты ма?
Dialogue: 1,0:05:43.04,0:05:44.40,Dial-JP,,0,0,0,,Бұл қызықты
Dialogue: 1,0:05:44.40,0:05:47.30,Dial-JP,,0,0,0,,Арашико мерекесіне кім келеді?
Dialogue: 1,0:05:47.76,0:05:49.12,Dial-JP,,0,0,0,,Маған бәрібір
Dialogue: 1,0:05:49.36,0:05:52.08,Dial-JP,,0,0,0,,Қожайынымды мазаламаңыз.
Dialogue: 1,0:05:52.77,0:05:53.63,Dial-JP,,0,0,0,,Тітіркендіргіш пе?
Dialogue: 1,0:05:53.87,0:05:55.96,Dial-JP,,0,0,0,,Мен асыраушымын
Dialogue: 1,0:05:56.07,0:05:59.84,Dial-JP,,0,0,0,,Қожайынымды қорғау дүкеннің аман қалуына әкеледі.
Dialogue: 1,0:06:00.07,0:06:01.36,Dial-JP,,0,0,0,,Дұрыс, менеджер.
Dialogue: 1,0:06:01.36,0:06:03.54,Dial-JP,,0,0,0,,Дұрыс айтасың, Юмэчи-сама.
Dialogue: 1,0:06:04.92,0:06:08.79,Dial-JP,,0,0,0,,Егер бұл тобыр қызметшісінің туған күні болса, бұрышта үндемеңіз.
Dialogue: 1,0:06:08.79,0:06:09.37,Dial-JP,,0,0,0,,Моб?
Dialogue: 1,0:06:09.78,0:06:10.81,Dial-JP,,0,0,0,,Сәлем Юмэчи-сан
Dialogue: 1,0:06:10.81,0:06:12.41,Dial-JP,,0,0,0,,Дамаре Саншита
Dialogue: 1,0:06:12.41,0:06:15.20,Dial-JP,,0,0,0,,Жасағым келсе, екеуің емін-еркін істей аласыңдар.
Dialogue: 1,0:06:15.20,0:06:16.58,Dial-JP,,0,0,0,,Толық емес жұмыс уақытында
Dialogue: 1,0:06:16.86,0:06:18.78,Dial-JP,,0,0,0,,Айтқанымды істедім, Юмечи-сама.
Dialogue: 1,0:06:19.12,0:06:20.12,Dial-JP,,0,0,0,,Бұл...
Dialogue: 1,0:06:20.87,0:06:24.59,Dial-JP,,0,0,0,,Жүріңдер, шошқалар, түскі ас уақыты келді.
Dialogue: 1,0:06:27.56,0:06:28.54,Dial-JP,,0,0,0,,Мажуке
Dialogue: 1,0:06:29.80,0:06:31.27,Dial-JP,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 1,0:06:42.60,0:06:43.22,Dial-JP,,0,0,0,,Арашико-сан?
Dialogue: 1,0:06:44.76,0:06:45.93,Dial-JP,,0,0,0,,Сіз ояусыз ба?
Dialogue: 1,0:06:46.54,0:06:49.35,Dial-JP,,0,0,0,,Иә, ертеңгі күн үшін алаңдаймын.
Dialogue: 1,0:06:50.18,0:06:51.69,Dial-JP,,0,0,0,,Сіз мұны көптен бері істеп жүрсіз бе?
Dialogue: 1,0:06:52.14,0:06:55.03,Dial-JP,,0,0,0,,Мен әшекейлеуді аяқтаймын деп ойладым.
Dialogue: 1,0:06:55.68,0:06:57.80,Dial-JP,,0,0,0,,Ри... Бұл шедевр.
Dialogue: 1,0:06:58.42,0:07:00.00,Dial-JP,,0,0,0,,Саған да көмектесейін бе?
Dialogue: 1,0:07:00.47,0:07:01.61,Dial-JP,,0,0,0,,Рахмет
Dialogue: 1,0:07:02.13,0:07:03.96,Dial-JP,,0,0,0,,Бірақ бәрі бітті.
Dialogue: 1,0:07:04.89,0:07:05.83,Dial-JP,,0,0,0,,Солай ма?
Dialogue: 1,0:07:12.78,0:07:16.50,Dial-JP,,0,0,0,,Бронды қалай жасауға болады?
Dialogue: 1,0:07:17.69,0:07:20.71,Dial-JP,,0,0,0,,Сіз еншілес дүкендермен жұмыс істей аласыз.
Dialogue: 1,0:07:22.56,0:07:23.30,Dial-JP,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 1,0:07:30.77,0:07:32.13,Dial-JP,,0,0,0,,Кеттік...
Dialogue: 1,0:07:35.86,0:07:36.73,Dial-JP,,0,0,0,,Фуварин
Dialogue: 1,0:07:37.12,0:07:39.06,Dial-JP,,0,0,0,,Қош келдіңіз, жас ханым.
Dialogue: 1,0:07:39.75,0:07:40.84,Dial-JP,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 1,0:07:41.14,0:07:44.86,Dial-JP,,0,0,0,,Біз қызметші дәмханасымен байланыстымыз.
Dialogue: 1,0:07:44.86,0:07:46.75,Dial-JP,,0,0,0,,Сен доссың.
Dialogue: 1,0:07:46.75,0:07:47.62,Dial-JP,,0,0,0,,Иә... Иә.
Dialogue: 1,0:07:48.13,0:07:52.18,Dial-JP,,0,0,0,,Кешкі сағат 18:00-де басталатын іс-шара бар, мен парақшаларды тарата аласыз ба деп ойладым.
Dialogue: 1,0:07:52.57,0:07:53.49,Dial-JP,,0,0,0,,Каоруко-сан
Dialogue: 1,0:07:54.11,0:07:56.00,Dial-JP,,0,0,0,,Әрине, жақсы.
Dialogue: 1,0:07:56.86,0:07:58.04,Dial-JP,,0,0,0,,Рахмет
Dialogue: 1,0:07:58.04,0:08:00.57,Dial-JP,,0,0,0,,Дұрыс, қазір бізде жұмыс күші жетіспейді.
Dialogue: 1,0:08:00.86,0:08:03.98,Dial-JP,,0,0,0,,Кішкене көмек алсаңыз жақсы болар еді.
Dialogue: 1,0:08:03.98,0:08:05.07,Dial-JP,,0,0,0,,Бірлесіп күресу
Dialogue: 1,0:08:05.30,0:08:06.25,Dial-JP,,0,0,0,,Сәлем Арашико-сан
Dialogue: 1,0:08:06.48,0:08:07.84,Dial-JP,,0,0,0,,Егер бұл сізге қолайлы болса
Dialogue: 1,0:08:08.05,0:08:08.90,Dial-JP,,0,0,0,,Мен?
Dialogue: 1,0:08:09.49,0:08:10.80,Dial-JP,,0,0,0,,Шибуи
Dialogue: 1,0:08:11.63,0:08:13.68,Dial-JP,,0,0,0,,Бұл жанды.
Dialogue: 1,0:08:13.96,0:08:14.41,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:08:14.70,0:08:18.76,Dial-JP,,0,0,0,,Егер осы шеберлердің бір бөлігі болса да үйлеріне қайтып бара жатқанда тоқтап қалса,
Dialogue: 1,0:08:20.95,0:08:21.88,Dial-JP,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 1,0:08:22.33,0:08:25.28,Dial-JP,,0,0,0,,Біз қызметші кафенің әуесқойларымыз.
Dialogue: 1,0:08:26.13,0:08:27.64,Dial-JP,,0,0,0,,Туған күн оқиғасы?
Dialogue: 1,0:08:27.95,0:08:28.47,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:08:28.82,0:08:31.51,Dial-JP,,0,0,0,,Бүгін Арасико-санның туған күні.
Dialogue: 1,0:08:31.75,0:08:33.58,Dial-JP,,0,0,0,,18:00-де басталатын іс-шара бар.
Dialogue: 1,0:08:33.58,0:08:34.68,Dial-JP,,0,0,0,,Егер сіз тоқтай алсаңыз ...
Dialogue: 1,0:08:35.83,0:08:36.81,Dial-JP,,0,0,0,,Солай сияқты.
Dialogue: 1,0:08:36.81,0:08:39.97,Dial-JP,,0,0,0,,Ой, біздің туған күніміз бір.
Dialogue: 1,0:08:40.70,0:08:43.66,Dial-JP,,0,0,0,,Бүгін менің туған күнім.
Dialogue: 1,0:08:43.66,0:08:46.50,Dial-JP,,0,0,0,,Менің туған күнім сондай тамаша қызметшімен бірдей.
Dialogue: 1,0:08:46.50,0:08:47.76,Dial-JP,,0,0,0,,Каоруко бақытты
Dialogue: 1,0:08:47.90,0:08:48.64,Dial-JP,,0,0,0,,Фуварин
Dialogue: 1,0:08:49.68,0:08:51.71,Dial-JP,,0,0,0,,Құттықтаймыз Каоруко-чан
Dialogue: 1,0:08:51.71,0:08:53.45,Dial-JP,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 1,0:08:54.58,0:08:56.59,Dial-JP,,0,0,0,,Солай ма?
Dialogue: 1,0:08:56.79,0:08:58.52,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:08:58.95,0:09:01.15,Dial-JP,,0,0,0,,Арашико-сан, сен нешедесің?
Dialogue: 1,0:09:01.56,0:09:02.86,Dial-JP,,0,0,0,,Менің жасым 36-да
Dialogue: 1,0:09:03.03,0:09:04.59,Dial-JP,,0,0,0,,36 жаста?
Dialogue: 1,0:09:04.87,0:09:06.05,Dial-JP,,0,0,0,,Бала өгіз жолбарыс…
Dialogue: 1,0:09:06.18,0:09:08.80,Dial-JP,,0,0,0,,Керемет Менің 15 үздіктерім
Dialogue: 1,0:09:09.03,0:09:10.36,Dial-JP,,0,0,0,,Сіз үлкен ардагерсіз.
Dialogue: 1,0:09:10.80,0:09:13.37,Dial-JP,,0,0,0,,36 жастағы қызметші қыз керемет
Dialogue: 1,0:09:13.56,0:09:15.03,Dial-JP,,0,0,0,,Бұл майлы.
Dialogue: 1,0:09:18.40,0:09:19.91,Dial-JP,,0,0,0,,Мен сені ашуландырдым ба?
Dialogue: 1,0:09:20.36,0:09:21.48,Dial-JP,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 1,0:09:21.95,0:09:25.67,Dial-JP,,0,0,0,,Мен жастың қызметші болуға ешқандай қатысы жоқ деп есептеймін.
Dialogue: 1,0:09:26.24,0:09:30.06,Dial-JP,,0,0,0,,Кешіріңіз, Каоруко, мен дәл қазір тыңдамадым.
Dialogue: 1,0:09:30.43,0:09:31.93,Dial-JP,,0,0,0,,Кеттік, Арашико-сан.
Dialogue: 1,0:09:32.29,0:09:33.94,Dial-JP,,0,0,0,,О, сен үйдесің бе?
Dialogue: 1,0:09:34.47,0:09:36.64,Dial-JP,,0,0,0,,Мен парақшаларды таратуым керек пе?
Dialogue: 1,0:09:37.06,0:09:39.68,Dial-JP,,0,0,0,,Бұл ақ-қара Cascus парақшасы
Dialogue: 1,0:09:41.57,0:09:42.16,Dial-JP,,0,0,0,,Бұл...
Dialogue: 1,0:09:42.99,0:09:43.79,Dial-JP,,0,0,0,,Жекелік
Dialogue: 1,0:09:44.47,0:09:46.29,Dial-JP,,0,0,0,,Бұл әлсіз тұлға.
Dialogue: 1,0:09:46.62,0:09:47.47,Dial-JP,,0,0,0,,Жарайды.
Dialogue: 1,0:09:47.84,0:09:52.32,Dial-JP,,0,0,0,,Менің ойымша, бұл Арашиконың қажырлы еңбегін жеткізетін тамаша парақша.
Dialogue: 1,0:09:54.02,0:09:55.56,Dial-JP,,0,0,0,,Кешіріңіз.
Dialogue: 1,0:10:01.71,0:10:04.04,Dial-JP,,0,0,0,,Кешіріңіз, бұл менің кінәм.
Dialogue: 1,0:10:04.44,0:10:06.82,Dial-JP,,0,0,0,,Жоқ, мен бақытты болдым.
Dialogue: 1,0:10:08.02,0:10:10.86,Dial-JP,,0,0,0,,Өзіңізге рахмет
Dialogue: 1,0:10:12.98,0:10:16.66,Dial-JP,,0,0,0,,Негізі, мен Арашико ашуланып, зорлық-зомбылыққа ұшырайды деп қорқамын.
Dialogue: 1,0:10:16.66,0:10:18.12,Dial-JP,,0,0,0,,Мен қорықтым.
Dialogue: 1,0:10:18.49,0:10:21.41,Dial-JP,,0,0,0,,Мен өзіме ашуланбаймын.
Dialogue: 1,0:10:22.68,0:10:27.44,Dial-JP,,0,0,0,,Дүкенде мені қорлағанда ғана аздап эмоцияға беремін.
Dialogue: 1,0:10:28.24,0:10:29.20,Dial-JP,,0,0,0,,Дүкен...
Dialogue: 1,0:10:31.25,0:10:36.32,Dial-JP,,0,0,0,,Менің ойымша, бұл соншалықты маңызды емес.
Dialogue: 1,0:10:37.24,0:10:38.66,Dial-JP,,0,0,0,,Барлығы да суық.
Dialogue: 1,0:10:39.42,0:10:42.58,Dial-JP,,0,0,0,,Ал мен төбелескенді ұнатпаймын...
Dialogue: 1,0:10:43.06,0:10:46.07,Dial-JP,,0,0,0,,Мен күңдердің төбелесетінін білемін.
Dialogue: 1,0:10:49.63,0:10:52.20,Dial-JP,,0,0,0,,Қақтығыс күшейіп жатқан бүгінгі Акибада
Dialogue: 1,0:10:52.20,0:10:55.41,Dial-JP,,0,0,0,,Мен зорлық-зомбылықты сақтау қиын деп ойлаймын.
Dialogue: 1,0:10:55.55,0:10:59.23,Dial-JP,,0,0,0,,Арашико-сан, егер сіз де қызметші болып тұруды жоспарласаңыз.
Dialogue: 1,0:10:59.40,0:11:01.92,Dial-JP,,0,0,0,,Сіз қаруды алуға да дайын болуыңыз керек.
Dialogue: 1,0:11:07.03,0:11:09.25,Dial-JP,,0,0,0,,Сіз жанжалдарды ұнатпайсыз.
Dialogue: 1,0:11:13.29,0:11:15.08,Dial-JP,,0,0,0,,Бұл жақсы.
Dialogue: 1,0:11:22.08,0:11:23.32,Dial-JP,,0,0,0,,Мен білдім
Dialogue: 1,0:11:23.94,0:11:26.64,Dial-JP,,0,0,0,,Ұрыспасаң, жоғалтатын нәрсең бар.
Dialogue: 1,0:11:28.25,0:11:29.17,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:11:34.38,0:11:35.63,Dial-JP,,0,0,0,,Не... не?
Dialogue: 1,0:11:36.20,0:11:37.21,Dial-JP,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 1,0:11:37.40,0:11:40.60,Dial-JP,,0,0,0,,Шошқа күтуші қызға жол берме.
Dialogue: 1,0:11:56.06,0:11:59.43,Dial-JP,,0,0,0,,Еншілес дүкендер арасындағы дауларға тыйым салу керек.
Dialogue: 1,0:12:01.07,0:12:02.99,Dial-JP,,0,0,0,,Мен аздап ренжідім.
Dialogue: 1,0:12:03.38,0:12:05.55,Dial-JP,,0,0,0,,Мен сенімен біраз уақыт араласа аламын ба деп ойлаймын.
Dialogue: 1,0:12:06.02,0:12:06.77,Dial-JP,,0,0,0,,Фуварин
Dialogue: 1,0:12:23.87,0:12:25.98,Dial-JP,,0,0,0,,Мен оны қалдыра алмаймын.
Dialogue: 1,0:12:25.98,0:12:27.64,Dial-JP,,0,0,0,,Туған күніңмен
Dialogue: 1,0:12:27.93,0:12:28.85,Dial-JP,,0,0,0,,Арашико-чан
Dialogue: 1,0:12:29.89,0:12:31.21,Dial-JP,,0,0,0,,Сіз нені айтасыз?
Dialogue: 1,0:12:31.81,0:12:35.28,Dial-JP,,0,0,0,,Өйткені Арашико-чанмен туған күніміз бір.
Dialogue: 1,0:12:35.52,0:12:37.20,Dial-JP,,0,0,0,,Бұл... сіздің туған күніңіз бе?
Dialogue: 1,0:12:37.51,0:12:39.03,Dial-JP,,0,0,0,,Сонымен...
Dialogue: 1,0:12:39.29,0:12:43.16,Dial-JP,,0,0,0,,Бүгін осы Акихабарада менің туған күнімнен басқа балалар жоқ.
Dialogue: 1,0:12:43.65,0:12:44.87,Dial-JP,,0,0,0,,Бұл сізге қажет емес пе?
Dialogue: 1,0:12:45.22,0:12:46.97,Dial-JP,,0,0,0,,Барлығы мейірімді болды.
Dialogue: 1,0:12:47.29,0:12:49.07,Dial-JP,,0,0,0,,Туған күні бірдей болған балалар
Dialogue: 1,0:12:49.44,0:12:52.84,Dial-JP,,0,0,0,,Барлығы сабын көпіршіктері сияқты атылып, жоғалып кетті.
Dialogue: 1,0:12:53.25,0:12:56.71,Dial-JP,,0,0,0,,Бұл оны өлтіргеніңді білдіре ме?
Dialogue: 1,0:12:57.14,0:12:58.00,Dial-JP,,0,0,0,,Фуварин
Dialogue: 1,0:12:59.22,0:13:01.31,Dial-JP,,0,0,0,,Бастау уақыты жақындап қалды.
Dialogue: 1,0:13:02.20,0:13:04.79,Dial-JP,,0,0,0,,Сіз оқиғаның кешкі сағат 6-да болғанын айттыңыз.
Dialogue: 1,0:13:05.70,0:13:06.81,Dial-JP,,0,0,0,,Қорықпа.
Dialogue: 1,0:13:07.02,0:13:09.94,Dial-JP,,0,0,0,,Туған күн осында өтеді.
Dialogue: 1,0:13:13.60,0:13:14.27,Dial-JP,,0,0,0,,Қан?
Dialogue: 1,0:13:14.56,0:13:16.80,Dial-JP,,0,0,0,,Менің туған күніме сыйлық
Dialogue: 1,0:13:17.00,0:13:20.78,Dial-JP,,0,0,0,,Керемет, туған күн мен қайтыс болған күн бірдей
Dialogue: 1,0:13:21.04,0:13:23.41,Dial-JP,,0,0,0,,Менің туған күнім 2 сәуір.
Dialogue: 1,0:13:24.14,0:13:25.20,Dial-JP,,0,0,0,,Сонда не?
Dialogue: 1,0:13:25.20,0:13:28.28,Dial-JP,,0,0,0,,Менің туған күнім мен қайтыс болған күнім бірдей емес
Dialogue: 1,0:13:30.19,0:13:31.09,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:13:32.17,0:13:35.68,Dial-JP,,0,0,0,,Қой арманда, тыныштықта демал.
Dialogue: 1,0:13:38.96,0:13:40.20,Dial-JP,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 1,0:13:42.24,0:13:43.55,Dial-JP,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 1,0:13:44.86,0:13:45.56,Dial-JP,,0,0,0,,Nagomi-san
Dialogue: 1,0:13:46.00,0:13:47.06,Dial-JP,,0,0,0,,қазіргі уақытта қарғысқа ұшыраған эмбрионмен бірге әлі де сонда қамалып отыр –
Dialogue: 1,0:13:47.24,0:13:49.56,Dial-JP,,0,0,0,,Яда яда яда Мен суға батып бара жатырмын
Dialogue: 1,0:13:49.56,0:13:51.27,Dial-JP,,0,0,0,,Arashiko-san
Dialogue: 1,0:13:52.95,0:13:53.57,Dial-JP,,0,0,0,,Tomato?
Dialogue: 1,0:13:54.11,0:13:55.68,Dial-JP,,0,0,0,,Бұл қызанақ шырыны.
Dialogue: 1,0:13:55.96,0:13:57.37,Dial-JP,,0,0,0,,Жақсы
Dialogue: 1,0:13:58.42,0:13:59.45,Dial-JP,,0,0,0,,Сізге не ұнайды?
Dialogue: 1,0:14:00.57,0:14:03.07,Dial-JP,,0,0,0,,Жыл
Dialogue: 1,0:14:05.44,0:14:07.80,Dial-JP,,0,0,0,,Бұл мен сенімді жұмыс.
Dialogue: 1,0:14:07.80,0:14:09.26,Dial-JP,,0,0,0,,Орал жарқырап тұр
Dialogue: 1,0:14:09.26,0:14:11.27,Dial-JP,,0,0,0,,Мен не істеуім керек?
Dialogue: 1,0:14:11.27,0:14:13.08,Dial-JP,,0,0,0,,Бұл шынымен генерал ма?
Dialogue: 1,0:14:13.38,0:14:14.60,Dial-JP,,0,0,0,,Бұл оған арналған.
Dialogue: 1,0:14:14.90,0:14:16.42,Dial-JP,,0,0,0,,Керемет тойлаңыз.
Dialogue: 1,0:14:18.18,0:14:19.92,Dial-JP,,0,0,0,,Сонымен, сіз торт сатып алдыңыз ба?
Dialogue: 1,0:14:20.04,0:14:22.84,Dial-JP,,0,0,0,,Сондықтан бұршақтың өскіндерін қуырып кеседі.
Dialogue: 1,0:14:22.99,0:14:26.00,Dial-JP,,0,0,0,,Бақытымызға орай, өкінішке орай, әлі шеберлер жоқ.
Dialogue: 1,0:14:26.32,0:14:28.35,Dial-JP,,0,0,0,,Мен асығыс тортты тығып, дайындаймын.
Dialogue: 1,0:14:28.83,0:14:32.66,Dial-JP,,0,0,0,,Шынымды айтсам, Юмэчидің нашар әрекеті бәрінің де көңілін қалдырды деп ойлаймын.
Dialogue: 1,0:14:32.83,0:14:35.21,Dial-JP,,0,0,0,,Мен... Саркастикалық пьесаларды орындау қиын.
Dialogue: 1,0:14:35.21,0:14:35.94,Dial-JP,,0,0,0,,Қалай болғанда да
Dialogue: 1,0:14:36.27,0:14:39.52,Dial-JP,,0,0,0,,Арашиконың туған күніне арналған тосынсый Мен оны міндетті түрде сәтті орындаймын
Dialogue: 1,0:14:39.92,0:14:40.44,Dial-JP,,0,0,0,,Зоя
Dialogue: 1,0:14:40.77,0:14:41.15,Dial-JP,,0,0,0,,Жоғары
Dialogue: 1,0:14:42.82,0:14:45.65,Dial-JP,,0,0,0,,Адамды таң қалдырған үлкен жетістік
Dialogue: 1,0:14:45.65,0:14:46.66,Dial-JP,,0,0,0,,Эден академиясының нәтижелері.
Dialogue: 1,0:14:50.72,0:14:52.02,Dial-JP,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 1,0:14:54.62,0:14:55.96,Dial-JP,,0,0,0,,Мен жасадым, қайттым.
Dialogue: 1,0:14:56.43,0:14:57.49,Dial-JP,,0,0,0,,Мен қайтуға мүмкіндік алдым.
Dialogue: 1,0:15:01.70,0:15:04.17,Dial-JP,,0,0,0,,Біз өлеміз бе?
Dialogue: 1,0:15:04.77,0:15:06.95,Dial-JP,,0,0,0,,Бұлай жалғаса берсе, солай болады.
Dialogue: 1,0:15:08.32,0:15:12.16,Dial-JP,,0,0,0,,Мен әрқашан қызметші болғым келетін.
Dialogue: 1,0:15:13.41,0:15:16.80,Dial-JP,,0,0,0,,Мен мұны істей аламын ба деп уайымдадым.
Dialogue: 1,0:15:17.35,0:15:18.52,Dial-JP,,0,0,0,,Жұмысқа қабылдау…
Dialogue: 1,0:15:19.36,0:15:22.08,Dial-JP,,0,0,0,,Мен қай жерде қателестім?
Dialogue: 1,0:15:23.86,0:15:24.96,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:15:26.47,0:15:30.71,Dial-JP,,0,0,0,,36 жыл бұрын бүгін туғаныма болмаса
Dialogue: 1,0:15:31.16,0:15:32.04,Dial-JP,,0,0,0,,Мұндай нәрсе
Dialogue: 1,0:15:32.29,0:15:34.99,Dial-JP,,0,0,0,,Бүгін Арашико дүниеге келген маңызды күн емес пе?
Dialogue: 1,0:15:35.41,0:15:37.90,Dial-JP,,0,0,0,,Өзіңізді жоққа шығаратын сөздерді айтпаңыз
Dialogue: 1,0:15:38.95,0:15:41.09,Dial-JP,,0,0,0,,Бұл мен үшін бос сөз
Dialogue: 1,0:15:43.00,0:15:46.40,Dial-JP,,0,0,0,,Өткен жылға дейін дуалдың ішінде болдым.
Dialogue: 1,0:15:47.10,0:15:49.00,Dial-JP,,0,0,0,,Туған күннің қызығы туралы айту
Dialogue: 1,0:15:49.40,0:15:52.37,Dial-JP,,0,0,0,,Тек пончик пен кафе ау лайт берілді.
Dialogue: 1,0:15:53.09,0:15:54.13,Dial-JP,,0,0,0,,Шарбақ ішінде?
Dialogue: 1,0:15:54.44,0:15:54.81,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:15:55.50,0:15:59.04,Dial-JP,,0,0,0,,Сондықтан биылғы туған күнді асыға күттім.
Dialogue: 1,0:15:59.64,0:16:00.90,Dial-JP,,0,0,0,,Барыңыз... Қоршау...
Dialogue: 1,0:16:01.33,0:16:02.14,Dial-JP,,0,0,0,,Сол «қоршау»?
Dialogue: 1,0:16:02.50,0:16:02.82,Dial-JP,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 1,0:16:03.85,0:16:04.99,Dial-JP,,0,0,0,,Сонымен... солай
Dialogue: 1,0:16:05.64,0:16:07.58,Dial-JP,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 1,0:16:09.92,0:16:12.41,Dial-JP,,0,0,0,,Кешіріңіз, бұл менің кінәм.
Dialogue: 1,0:16:12.48,0:16:14.18,Dial-JP,,0,0,0,,Жоқ, керісінше.
Dialogue: 1,0:16:14.80,0:16:17.57,Dial-JP,,0,0,0,,Нагоми-санмен болған оқиға туралы ойланғанда
Dialogue: 1,0:16:17.94,0:16:19.46,Dial-JP,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 1,0:16:20.26,0:16:22.00,Dial-JP,,0,0,0,,Мен дүкенге кездейсоқ қосылдым.
Dialogue: 1,0:16:22.92,0:16:26.08,Dial-JP,,0,0,0,,Келе алғаныма өте қуаныштымын.
Dialogue: 1,0:16:27.91,0:16:28.86,Dial-JP,,0,0,0,,Арашико-сан...
Dialogue: 1,0:16:30.15,0:16:31.04,Dial-JP,,0,0,0,,Жарайды
Dialogue: 1,0:16:31.80,0:16:33.89,Dial-JP,,0,0,0,,Барлығы оны іздеп жатыр.
Dialogue: 1,0:16:35.86,0:16:37.55,Dial-JP,,0,0,0,,Бұл дұрыс емес.
Dialogue: 1,0:16:43.57,0:16:46.06,Dial-JP,,0,0,0,,Қайырлы кеш, бұл Маннен Арашико.
Dialogue: 1,0:16:48.70,0:16:49.62,Dial-JP,,0,0,0,,баяу
Dialogue: 1,0:16:49.62,0:16:52.41,Dial-JP,,0,0,0,,Мұнайды қайда сатып жатырсыңдар, шошқалар?
Dialogue: 1,0:16:52.41,0:16:55.07,Dial-JP,,0,0,0,,Біздің іс-шараға кешігіп келу туралы не айтасыз?
Dialogue: 1,0:16:55.07,0:16:58.10,Dial-JP,,0,0,0,,Осылай қайтып келмесең, менің көңілім қатты қалады.
Dialogue: 1,0:16:58.28,0:17:00.25,Dial-JP,,0,0,0,,Торт ысырап болды
Dialogue: 1,0:17:01.60,0:17:03.88,Dial-JP,,0,0,0,,Сонымен... осылай болады.
Dialogue: 1,0:17:03.88,0:17:04.25,Dial-JP,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 1,0:17:04.25,0:17:07.16,Dial-JP,,0,0,0,,Мен сені мұндай нәрсе үшін ешқашан кешірмеймін.
Dialogue: 1,0:17:07.92,0:17:08.51,Dial-JP,,0,0,0,,келді
Dialogue: 1,0:17:10.28,0:17:12.14,Dial-JP,,0,0,0,,Бұл түсініксіз, Окачимачи мырза.
Dialogue: 1,0:17:12.14,0:17:14.44,Dial-JP,,0,0,0,,Эй, мен Арашико мен Нагомиді көрмедім.
Dialogue: 1,0:17:17.20,0:17:18.17,Dial-JP,,0,0,0,,Бұл...
Dialogue: 1,0:17:21.06,0:17:22.50,Dial-JP,,0,0,0,,Сия сатып алғыңыз келе ме?
Dialogue: 1,0:17:25.28,0:17:27.46,Dial-JP,,0,0,0,,Құттықтаймыз Каоруко-чан
Dialogue: 1,0:17:27.46,0:17:29.28,Dial-JP,,0,0,0,,Туған күніңмен
Dialogue: 1,0:17:29.51,0:17:30.85,Dial-JP,,0,0,0,,Рахмет
Dialogue: 1,0:17:31.57,0:17:33.33,Dial-JP,,0,0,0,,Рахмет сізге Фуварин
Dialogue: 1,0:17:37.34,0:17:38.60,Dial-JP,,0,0,0,,С…
Dialogue: 1,0:17:39.24,0:17:41.25,Dial-JP,,0,0,0,,Нагоми-сан, аузыңды биік ұста
Dialogue: 1,0:17:41.60,0:17:42.34,Dial-JP,,0,0,0,,Орындау
Dialogue: 1,0:17:45.35,0:17:46.63,Dial-JP,,0,0,0,,Мен оны саған беремін
Dialogue: 1,0:17:49.13,0:17:50.44,Dial-JP,,0,0,0,,Ра... Арашико-сан
Dialogue: 1,0:17:50.74,0:17:52.05,Dial-JP,,0,0,0,,Оны өзіңіз ішіңіз
Dialogue: 1,0:17:52.96,0:17:53.76,Dial-JP,,0,0,0,,Бұл мүмкін емес.
Dialogue: 1,0:17:55.12,0:17:59.04,Dial-JP,,0,0,0,,Арашико-сан, мен жай ғана өтірік айттым.
Dialogue: 1,0:17:59.46,0:18:02.84,Dial-JP,,0,0,0,,Мен де қызметші болғаныма қуаныштымын.
Dialogue: 1,0:18:02.84,0:18:05.40,Dial-JP,,0,0,0,,Барлығын салғаныма қуаныштымын.
Dialogue: 1,0:18:08.29,0:18:09.07,Dial-JP,,0,0,0,,Нагоми-сан
Dialogue: 1,0:18:09.78,0:18:10.67,Dial-JP,,0,0,0,,Нагоми-сан
Dialogue: 1,0:18:13.21,0:18:16.28,Dial-JP,,0,0,0,,Каоруко-сан, бүгінгі сатылым жаңа рекорд.
Dialogue: 1,0:18:16.61,0:18:19.48,Dial-JP,,0,0,0,,Әрине менің туған күнім.
Dialogue: 1,0:18:21.73,0:18:24.54,Dial-JP,,0,0,0,,Сіз жындысыз ба? Бұл еншілес дүкен.
Dialogue: 1,0:18:24.54,0:18:25.44,Dial-JP,,0,0,0,,Сіз білесіз бе?
Dialogue: 1,0:18:25.62,0:18:28.12,Dial-JP,,0,0,0,,Бұл жерде тосын сый бар.
Dialogue: 1,0:18:28.64,0:18:29.38,Dial-JP,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 1,0:18:30.47,0:18:32.84,Dial-JP,,0,0,0,,Менің сия сатып алатын ақшам жоқ.
Dialogue: 1,0:18:33.50,0:18:35.78,Dial-JP,,0,0,0,,Арашико мен басқаларды шығарыңыз!
Dialogue: 1,0:18:35.78,0:18:37.60,Dial-JP,,0,0,0,,Сіз тортты бүлдіргіңіз келе ме?
Dialogue: 1,0:18:38.12,0:18:39.37,Dial-JP,,0,0,0,,Шошқалар
Dialogue: 1,0:18:39.83,0:18:41.81,Dial-JP,,0,0,0,,Сіз фаршқа айналдырғыңыз келетін сияқтысыз.
Dialogue: 1,0:18:41.81,0:18:44.54,Dial-JP,,0,0,0,,Ой, мынау әбестік.
Dialogue: 1,0:18:44.54,0:18:47.56,Dial-JP,,0,0,0,,Бұршақ өскіндерін қуырған күндерім босқа кетпейді.
Dialogue: 1,0:18:47.78,0:18:49.94,Dial-JP,,0,0,0,,Маған дәл сызықты ұстануға рұқсат етіңіз
Dialogue: 1,0:18:50.40,0:18:54.51,Dial-JP,,0,0,0,,Егер сіз шошқамен аралассаңыз не болады?
Dialogue: 1,0:19:01.70,0:19:04.48,Dial-JP,,0,0,0,,Қызанақтар ойнағысы келеді
Dialogue: 1,0:19:06.76,0:19:08.64,Dial-JP,,0,0,0,,Өйткені ол сүйкімді
Dialogue: 1,0:19:18.30,0:19:20.48,Dial-JP,,0,0,0,,Нагоми-сан Нагоми-сан
Dialogue: 1,0:19:24.66,0:19:25.30,Dial-JP,,0,0,0,,Нагоми
Dialogue: 1,0:19:25.30,0:19:26.13,Dial-JP,,0,0,0,,Арашико-сан
Dialogue: 1,0:19:26.96,0:19:28.38,Dial-JP,,0,0,0,,Сен тірісің, мен үйге барамын.
Dialogue: 1,0:19:28.66,0:19:30.73,Dial-JP,,0,0,0,,Мені осы қиыншылықтың бәрін бастан өткерме.
Dialogue: 1,0:19:31.20,0:19:32.46,Dial-JP,,0,0,0,,Өлім тез көтеріледі
Dialogue: 1,0:19:32.76,0:19:34.30,Dial-JP,,0,0,0,,Эмма! Рэй!
Dialogue: 1,0:19:36.73,0:19:38.61,Dial-JP,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 1,0:19:38.82,0:19:40.41,Dial-JP,,0,0,0,,Нагоми-сан, жақсысың ба?
Dialogue: 1,0:19:40.56,0:19:41.34,Dial-JP,,0,0,0,,Нагоми-сан
Dialogue: 1,0:19:43.59,0:19:45.63,Dial-JP,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 1,0:19:46.21,0:19:47.86,Dial-JP,,0,0,0,,Мен мұны білмедім.
Dialogue: 1,0:19:48.14,0:19:49.98,Dial-JP,,0,0,0,,Кінәлі осы жігіттер.
Dialogue: 1,0:19:50.14,0:19:53.34,Dial-JP,,0,0,0,,Ой... бітті, балалар.
Dialogue: 1,0:19:54.08,0:19:57.83,Dial-JP,,0,0,0,,Ке...Кедамоноланд тобы ауыздарын ашпайды
Dialogue: 1,0:19:58.55,0:20:02.10,Dial-JP,,0,0,0,,Дүкенің жойылып, табиғатта өлесің, шошқалар.
Dialogue: 1,0:20:02.29,0:20:03.42,Dial-JP,,0,0,0,,Араласпаңыз
Dialogue: 1,0:20:03.55,0:20:06.31,Dial-JP,,0,0,0,,Арасико мен басқаларды бірінші кезекте ұрлаған сен шығарсың.
Dialogue: 1,0:20:06.58,0:20:08.23,Dial-JP,,0,0,0,,Мен және қызметші
Dialogue: 1,0:20:08.69,0:20:11.97,Dial-JP,,0,0,0,,Топ үшін қайсысы құндырақ деп ойлайсыз?
Dialogue: 1,0:20:12.94,0:20:15.15,Dial-JP,,0,0,0,,Осындай касукасу әйелі
Dialogue: 1,0:20:15.35,0:20:17.95,Dial-JP,,0,0,0,,Ол қызметші болып біткенін айтты.
Dialogue: 1,0:20:18.24,0:20:20.27,Dial-JP,,0,0,0,,Мен топқа керекпін
Dialogue: 1,0:20:20.58,0:20:22.88,Dial-JP,,0,0,0,,Мен тұтынушыларды шақыра алмаймын.
Dialogue: 1,0:20:31.91,0:20:33.81,Dial-JP,,0,0,0,,Каскус деген кім?
Dialogue: 1,0:20:33.81,0:20:36.93,Dial-JP,,0,0,0,,Менің дүкенімде бірде-бір тұтынушы жоқ.
Dialogue: 1,0:20:40.85,0:20:43.80,Dial-JP,,0,0,0,,Туған күнің құтты болсын
Dialogue: 1,0:20:54.10,0:20:57.70,Dial-JP,,0,0,0,,Мен қызметші қыздың оқиға туралы айтатынына сене алар емеспін.
Dialogue: 1,0:20:58.51,0:20:59.60,Dial-JP,,0,0,0,,Кешіріңіз
Dialogue: 1,0:20:59.81,0:21:01.20,Dial-JP,,0,0,0,,Жоқ, мен...
Dialogue: 1,0:21:01.20,0:21:03.79,Dial-JP,,0,0,0,,Кешірім сұрағың келсе, алдымен дүкен менеджеріне бару керек.
Dialogue: 1,0:21:03.79,0:21:07.32,Dial-JP,,0,0,0,,Соңында мен іс-шараны өзім басқардым.
Dialogue: 1,0:21:09.76,0:21:11.25,Dial-JP,,0,0,0,,Ерте кірген өлім
Dialogue: 1,0:21:16.93,0:21:17.76,Dial-JP,,0,0,0,,Электр...
Dialogue: 1,0:21:18.52,0:21:22.10,Dial-JP,,0,0,0,,Туған күнің құтты болсын
Dialogue: 1,0:21:22.55,0:21:25.47,Dial-JP,,0,0,0,,Туған күнің құтты болсын
Dialogue: 1,0:21:26.31,0:21:30.48,Dial-JP,,0,0,0,,Туған күніңмен құрметті Ранко-сан
Dialogue: 1,0:21:31.00,0:21:34.72,Dial-JP,,0,0,0,,Туған күнің құтты болсын
Dialogue: 1,0:21:35.62,0:21:37.57,Dial-JP,,0,0,0,,36-ға толуыңызбен құттықтаймыз
Dialogue: 1,0:21:39.47,0:21:40.33,Dial-JP,,0,0,0,,Барлығы...
Dialogue: 1,0:21:40.60,0:21:42.61,Dial-JP,,0,0,0,,Нагоми неге жылап жатыр?
Dialogue: 1,0:21:42.61,0:21:44.78,Dial-JP,,0,0,0,,Жоқ... Мен жыламаймын.
Dialogue: 1,0:21:46.24,0:21:47.71,Dial-JP,,0,0,0,,Кішкентай өлім
Dialogue: 1,0:21:49.40,0:21:50.02,Dial-JP,,0,0,0,,Эй
Dialogue: 1,0:21:50.50,0:21:51.17,Dial-JP,,0,0,0,,Колла
Dialogue: 1,0:21:53.06,0:21:54.68,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:21:54.68,0:21:55.63,Dial-JP,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 1,0:21:55.77,0:21:57.48,Dial-JP,,0,0,0,,Оны жесең, ішіңнен шығар.
Dialogue: 1,0:21:57.48,0:21:59.26,Dial-JP,,0,0,0,,Мен тамақ жеген жоқпын.
Dialogue: 1,0:21:58.76,0:21:59.59,Dial-JP2,,0,0,0,,Ақымақ болма.
Dialogue: 1,0:22:01.31,0:22:02.64,Dial-JP,,0,0,0,,Бұл күні бірінші рет
Dialogue: 1,0:22:03.16,0:22:06.11,Dial-JP,,0,0,0,,Осы қалада маңызды адамдар
Dialogue: 1,0:22:08.83,0:22:09.98,Dial-JP,,0,0,0,,Орындалды
Dialogue: 1,0:22:53.67,0:22:55.66,Dial-JP,,0,0,0,,Додо... Бұл не болды?
Dialogue: 1,0:22:57.15,0:23:00.02,Dial-JP,,0,0,0,,Жоқ, ақша қайдан келеді деп сұрамаймын.
Dialogue: 1,0:23:00.27,0:23:02.69,Dial-JP,,0,0,0,,Өйткені, ақша дүниені айналдырады.
Dialogue: 1,0:23:02.90,0:23:04.88,Dial-JP,,0,0,0,,Бұл жақсы, бұл өте жақсы.
Dialogue: 1,0:23:05.06,0:23:06.47,Dial-JP,,0,0,0,,Өйткені мен оны ешқашан қайтармаймын
Dialogue: 1,0:23:06.80,0:23:09.12,Dial-JP,,0,0,0,,Өте жақсы Панда сияқты тамаша
Dialogue: 1,0:23:09.12,0:23:10.37,Dial-JP,,0,0,0,,Мен Уэноға бара аламын.
Dialogue: 1,0:23:10.84,0:23:13.36,Dial-JP,,0,0,0,,Окачимачи-сан қазірдің өзінде Уэно.
Dialogue: 1,0:23:14.63,0:23:17.39,Dial-JP,,0,0,0,,Жалғыз қызметші қойдың сатудан түскен түсімдері
Dialogue: 1,0:23:17.54,0:23:18.62,Dial-JP,,0,0,0,,Қызметші қой?
Dialogue: 1,0:23:19.10,0:23:20.38,Dial-JP,,0,0,0,,Сәлем Суймасен
Dialogue: 1,0:23:20.78,0:23:22.78,Dial-JP,,0,0,0,,Машита күң қойды жаншып жатыр
Dialogue: 0,0:23:24.28,0:23:30.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
