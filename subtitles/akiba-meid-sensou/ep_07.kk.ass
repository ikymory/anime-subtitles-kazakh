Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:31.13,0:01:35.05,Default,,0,0,0,,Мэйдриан қызыл супернова Аймидің қайтып келуін пайдаланады.
Dialogue: 0,0:01:35.36,0:01:37.50,Default,,0,0,0,,Тонто-Конға шабуылды жоспарлау
Dialogue: 0,0:01:38.20,0:01:40.87,Default,,0,0,0,,Алайда ішкі ескертуге байланысты полиция араласты.
Dialogue: 0,0:01:41.84,0:01:45.59,Default,,0,0,0,,Ашуланған Манами оған хабар берген сатқынды әшкереледі.
Dialogue: 0,0:01:46.41,0:01:51.10,Default,,0,0,0,,Бұл қызметшімен апалы-сіңлілі қарым-қатынас жасаған Нерула болатын.
Dialogue: 0,0:01:52.10,0:01:53.98,Default,,0,0,0,,Манами Нерураны атып өлтіреді
Dialogue: 0,0:01:54.44,0:01:55.89,Default,,0,0,0,,Апаның құшағында
Dialogue: 0,0:01:56.03,0:01:57.77,Default,,0,0,0,,Нерула өмірінен айырылды
Dialogue: 0,0:02:11.73,0:02:14.36,Default,,0,0,0,,Акиба қызметшісін ату оқиғасынан бері бір апта
Dialogue: 0,0:02:14.90,0:02:18.36,Default,,0,0,0,,Акихабара полиция бөлімшесіне қызметші әйел келіп, кісі өлтіргенін мойындады.
Dialogue: 0,0:02:18.79,0:02:22.26,Default,,0,0,0,,Өзін тапсырған адам жәбірленуші жұмыс істеген дүкеннің меңгерушісі болып шықты.
Dialogue: 0,0:02:22.40,0:02:23.64,Default,,0,0,0,,Акихабара полиция бөлімшесіне сәйкес
Dialogue: 0,0:02:23.77,0:02:26.53,Default,,0,0,0,,Күдікті «жәбірленушіден ғалам жоғалып кетті» деген сөздер айтты
Dialogue: 0,0:02:26.53,0:02:28.53,Default,,0,0,0,,Түсінбейтін сөздер мен әрекеттерді қайталап жасау.
Dialogue: 0,0:02:28.67,0:02:31.71,Default,,0,0,0,,Біз психиатриялық бағалау мақсатында тергеуді жалғастырудамыз.
Dialogue: 0,0:02:32.04,0:02:33.70,Default,,0,0,0,,Тағы бір апта?
Dialogue: 0,0:02:33.93,0:02:37.51,Default,,0,0,0,,Арашико-сан қанға боялған Нагоми-санды үйге әкелгенде.
Dialogue: 0,0:02:37.51,0:02:38.63,Default,,0,0,0,,Таң қалды Машита.
Dialogue: 0,0:02:38.83,0:02:41.87,Default,,0,0,0,,Майдриан халқы оңай шегінді.
Dialogue: 0,0:02:42.11,0:02:42.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:43.18,0:02:44.01,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:02:44.33,0:02:47.02,Default,,0,0,0,,Бірақ мен олардың шабуылға келетініне сенімдімін.
Dialogue: 0,0:02:47.46,0:02:49.06,Default,,0,0,0,,Бүгін де сергек болу үшін бар күшімізді салайық.
Dialogue: 0,0:02:49.69,0:02:51.94,Default,,0,0,0,,Нагоми Қызық, ол қайтып келмейді ме?
Dialogue: 0,0:02:52.57,0:02:53.56,Default,,0,0,0,,Жақсысың деп үміттенемін.
Dialogue: 0,0:02:54.72,0:02:58.23,Default,,0,0,0,,Бәріңіз, Нагоми бүгін де еңбек демалысында деп үміттенемін.
Dialogue: 0,0:03:00.15,0:03:02.08,Default,,0,0,0,,Арашико бәрібір
Dialogue: 0,0:03:02.28,0:03:05.12,Default,,0,0,0,,Мен тек өзіме қажет нәрсені істеймін.
Dialogue: 0,0:03:08.15,0:03:10.11,Default,,0,0,0,,Манами-сан қайтып келді.
Dialogue: 0,0:03:10.55,0:03:13.08,Default,,0,0,0,,Біз Аймидің соңына дейін барамыз.
Dialogue: 0,0:03:13.38,0:03:14.29,Default,,0,0,0,,Мен сізге еремін
Dialogue: 0,0:03:14.29,0:03:15.48,Default,,0,0,0,,Әлемнің шетіне дейін
Dialogue: 0,0:03:15.69,0:03:18.47,Default,,0,0,0,,Саны азайды, бірақ бәрі жақсы қызметшілер.
Dialogue: 0,0:03:18.65,0:03:22.48,Default,,0,0,0,,Нурии балалар, шошқаны жаншып, алақан тобына қосылайық.
Dialogue: 0,0:03:22.84,0:03:24.33,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:03:25.30,0:03:26.13,Default,,0,0,0,,Атцу
Dialogue: 0,0:03:26.29,0:03:30.55,Default,,0,0,0,,Угаки: Мейдрианның ішегін рұқсатсыз жұлып алмақ болған кім?
Dialogue: 0,0:03:30.55,0:03:33.40,Default,,0,0,0,,Мен бұрынғы ағамның айтқанын орындадым.
Dialogue: 0,0:03:34.17,0:03:37.18,Default,,0,0,0,,Қабырғаға кіргеннен кейін алдыңғы буын өзгерді.
Dialogue: 0,0:03:37.36,0:03:39.55,Default,,0,0,0,,Биліктен ақша артық екенін түсіндім.
Dialogue: 0,0:03:39.55,0:03:40.70,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,0:03:40.92,0:03:42.36,Default,,0,0,0,,Мен білетін алдыңғы буын
Dialogue: 0,0:03:42.36,0:03:45.29,Default,,0,0,0,,Ол Чукитуки-чанның қолына түскен соң үндемейтін адам.
Dialogue: 0,0:03:46.17,0:03:48.95,Default,,0,0,0,,Бұл рас, солай емес пе?
Dialogue: 0,0:03:49.19,0:03:52.55,Default,,0,0,0,,Сенің шындығың мен біздің ақиқатымыз бөлек.
Dialogue: 0,0:04:00.10,0:04:01.46,Default,,0,0,0,,Кешіріңіз Бу
Dialogue: 0,0:04:01.94,0:04:03.76,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:04:04.89,0:04:06.25,Default,,0,0,0,,Сізбен кездесу
Dialogue: 0,0:04:07.33,0:04:08.45,Default,,0,0,0,,Мұқият болыңыз
Dialogue: 0,0:04:09.28,0:04:10.46,Default,,0,0,0,,Сізбен кездесу
Dialogue: 0,0:04:11.34,0:04:12.62,Default,,0,0,0,,Бұл үшін өлуге тура келеді
Dialogue: 0,0:04:22.25,0:04:23.75,Default,,0,0,0,,Мен ниндзямын
Dialogue: 0,0:04:23.91,0:04:27.51,Default,,0,0,0,,Gozaru жеңілдік купоны
Dialogue: 0,0:04:29.73,0:04:30.46,Default,,0,0,0,,Нагоми-сан
Dialogue: 0,0:04:31.78,0:04:35.19,Default,,0,0,0,,Мен нагоми емеспін.
Dialogue: 0,0:04:35.99,0:04:39.01,Default,,0,0,0,,Дөрекі шай жақсы. Нинин
Dialogue: 0,0:04:41.46,0:04:44.31,Default,,0,0,0,,Мен Нагоми-сан деген қызметшіні білемін.
Dialogue: 0,0:04:44.78,0:04:47.06,Default,,0,0,0,,Мен оның қайда бара жатқанын білмегендіктен уайымдадым.
Dialogue: 0,0:04:47.62,0:04:49.99,Default,,0,0,0,,Мен олардың бірге бақытты өмір сүретініне сенімдімін.
Dialogue: 0,0:04:50.36,0:04:53.44,Default,,0,0,0,,Нагоми-чанға қызметші болмапты.
Dialogue: 0,0:04:55.54,0:04:58.89,Default,,0,0,0,,Неліктен Нагоми қызметші болуға шешім қабылдады?
Dialogue: 0,0:04:59.34,0:05:03.81,Default,,0,0,0,,Жарайды... Менің ойымша, бұл қызметшілер сүйкімді болғандықтан шығар.
Dialogue: 0,0:05:04.08,0:05:06.39,Default,,0,0,0,,Сонымен, қызметшіден көңілің қалды ма?
Dialogue: 0,0:05:06.61,0:05:08.38,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:05:09.78,0:05:12.15,Default,,0,0,0,,Сіз өзіңізді жек көргеніңізге сенімдімін.
Dialogue: 0,0:05:13.62,0:05:15.37,Default,,0,0,0,,Ниндзялар не істейді?
Dialogue: 0,0:05:16.20,0:05:17.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:17.18,0:05:20.49,Default,,0,0,0,,Құнай лақтыру, шурикен лақтыру, түтін бомбасын лақтыру
Dialogue: 0,0:05:21.16,0:05:22.18,Default,,0,0,0,,Бұзылу
Dialogue: 0,0:05:22.65,0:05:24.05,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:05:24.43,0:05:26.93,Default,,0,0,0,,Бұл қызық. Ниндзялар - ең жақсы.
Dialogue: 0,0:05:27.12,0:05:29.58,Default,,0,0,0,,Егер сіз ниндзюцумен айналысқан болсаңыз және ниндзя болсаңыз
Dialogue: 0,0:05:29.58,0:05:32.99,Default,,0,0,0,,Қару алып, жұдырықпен ұратын қызметшілерге қарағанда, бұл қауіпсіз.
Dialogue: 0,0:05:33.23,0:05:36.09,Default,,0,0,0,,Ниндзя болу өте қызық...
Dialogue: 0,0:05:37.15,0:05:39.49,Default,,0,0,0,,Бұл... қызық болды...
Dialogue: 0,0:05:41.56,0:05:43.49,Default,,0,0,0,,Бұл қызық болуы мүмкін емес пе?
Dialogue: 0,0:05:44.00,0:05:47.64,Default,,0,0,0,,Мен... Мен шын мәнінде ниндзя болғым келмейді.
Dialogue: 0,0:05:48.33,0:05:49.85,Default,,0,0,0,,Бірақ мен енді мұны істей алмаймын.
Dialogue: 0,0:05:50.30,0:05:52.75,Default,,0,0,0,,Маңызды нәрсе болса да, мен әрқашан басқаларға сенемін.
Dialogue: 0,0:05:53.12,0:05:54.76,Default,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:05:55.72,0:05:57.52,Default,,0,0,0,,Сонымен Нерула-чан...
Dialogue: 0,0:05:58.62,0:06:02.62,Default,,0,0,0,,Мен ешкімнің өлгенін қаламаймын, өйткені мен ештеңе істей алмаймын.
Dialogue: 0,0:06:03.40,0:06:05.97,Default,,0,0,0,,Сондықтан мен енді қызметші бола алмаймын.
Dialogue: 0,0:06:12.16,0:06:16.19,Default,,0,0,0,,Сондықтан мен Нагомидің қызметші болғанын қалаймын.
Dialogue: 0,0:06:17.42,0:06:20.40,Default,,0,0,0,,Мен Арашико-санның не айтып тұрғанын мүлде түсінбеймін.
Dialogue: 0,0:06:21.01,0:06:21.79,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:22.36,0:06:25.91,Default,,0,0,0,,Қалай болғанда да, мен қазір қарапайым ниндзямын.
Dialogue: 0,0:06:26.17,0:06:28.17,Default,,0,0,0,,Делонды көру үшін осы жерді басыңыз
Dialogue: 0,0:06:29.29,0:06:32.16,Default,,0,0,0,,Нининнин…
Dialogue: 0,0:06:38.98,0:06:40.42,Default,,0,0,0,,Мен Нагоми-санды таптым
Dialogue: 0,0:06:41.22,0:06:41.77,Default,,0,0,0,,Қайда
Dialogue: 0,0:06:42.21,0:06:43.96,Default,,0,0,0,,Мен осы қалада ниндзя болдым
Dialogue: 0,0:06:43.96,0:06:45.81,Default,,0,0,0,,Ниндзя танымал
Dialogue: 0,0:06:45.81,0:06:47.48,Default,,0,0,0,,Сіз әлі Акихабарадасыз ба?
Dialogue: 0,0:06:47.48,0:06:48.75,Default,,0,0,0,,Білсең, өлтіресің.
Dialogue: 0,0:06:48.75,0:06:50.42,Default,,0,0,0,,Неге мені қайтармадың?
Dialogue: 0,0:06:50.65,0:06:53.31,Default,,0,0,0,,Өйткені ол қызметші емес, ниндзя болатын.
Dialogue: 0,0:06:53.31,0:06:55.05,Default,,0,0,0,,Менеджер, біз не істеуіміз керек?
Dialogue: 0,0:06:55.05,0:06:56.78,Default,,0,0,0,,Сізде әлі тіркелу қалды, солай ма?
Dialogue: 0,0:06:56.78,0:06:58.67,Default,,0,0,0,,Ол қайтып келуі мүмкін.
Dialogue: 0,0:06:58.67,0:06:59.82,Default,,0,0,0,,Өйткені мен ниндзямын
Dialogue: 0,0:06:59.82,0:07:00.77,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:07:00.77,0:07:01.69,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:07:07.21,0:07:08.32,Default,,0,0,0,,Нагоми-чан
Dialogue: 0,0:07:09.08,0:07:11.83,Default,,0,0,0,,Қызметші ретінде...
Dialogue: 0,0:07:18.40,0:07:19.91,Default,,0,0,0,,Содан кейін, әртүрлі әскери заттар.
Dialogue: 0,0:07:21.42,0:07:22.10,Default,,0,0,0,,Нагонин
Dialogue: 0,0:07:22.10,0:07:24.18,Default,,0,0,0,,Бұл менің бірінші кездесуім.
Dialogue: 0,0:07:31.81,0:07:35.61,Default,,0,0,0,,Құрметті мырза, ұсынғаныңыз үшін рахмет.
Dialogue: 0,0:07:36.01,0:07:38.69,Default,,0,0,0,,Менің атым Нагонин.
Dialogue: 0,0:07:39.31,0:07:40.73,Default,,0,0,0,,Нагоми-чан шынымен
Dialogue: 0,0:07:41.63,0:07:42.18,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:42.18,0:07:43.72,Default,,0,0,0,,Олар өте көп болды.
Dialogue: 0,0:07:43.72,0:07:44.87,Default,,0,0,0,,Егер бұл дұрыс емес адам болса...
Dialogue: 0,0:07:44.87,0:07:47.30,Default,,0,0,0,,Біз Нерула-чанның жанкүйерлеріміз.
Dialogue: 0,0:07:47.30,0:07:50.52,Default,,0,0,0,,Тотокотонның Арашико-саны туралы қызметші маған айтып берді.
Dialogue: 0,0:07:50.67,0:07:52.80,Default,,0,0,0,,Нагоми-чан әлемнен жасырынып жүр.
Dialogue: 0,0:07:52.80,0:07:54.06,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:07:54.06,0:07:55.85,Default,,0,0,0,,Нагоми-чанға бір нәрсе бергім келеді.
Dialogue: 0,0:07:56.29,0:07:57.03,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:07:58.85,0:07:59.85,Default,,0,0,0,,Нерула-чан...
Dialogue: 0,0:08:02.39,0:08:03.56,Default,,0,0,0,,Мен сені жылатайын деп отырған жоқпын
Dialogue: 0,0:08:03.78,0:08:05.19,Default,,0,0,0,,'Oishi-kun' деп жазыптаушы
Dialogue: 0,0:08:05.42,0:08:07.34,Default,,0,0,0,,Өйткені, бұл Нагоми-чан.
Dialogue: 0,0:08:08.18,0:08:09.51,Default,,0,0,0,,Сен де неге жылайсың?
Dialogue: 0,0:08:09.73,0:08:13.83,Default,,0,0,0,,Мен іздеп жүрген қызметші бірінші рет өліп жатыр.
Dialogue: 0,0:08:13.83,0:08:15.62,Default,,0,0,0,,Бұл да менмін.
Dialogue: 0,0:08:16.05,0:08:18.78,Default,,0,0,0,,Итеруші өлгенде солай болады.
Dialogue: 0,0:08:18.97,0:08:22.19,Default,,0,0,0,,Нерула-чан, ол өте жақсы қызметші еді.
Dialogue: 0,0:08:22.40,0:08:24.99,Default,,0,0,0,,Менің ойымша, бұл мағынасы бар
Dialogue: 0,0:08:26.65,0:08:29.45,Default,,0,0,0,,Жақсы айттыңыз, жүріңіз.
Dialogue: 0,0:08:29.45,0:08:30.70,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:08:32.50,0:08:34.99,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:08:38.71,0:08:40.46,Default,,0,0,0,,Әрі қарай жалғастырыңыз.
Dialogue: 0,0:08:43.49,0:08:45.85,Default,,0,0,0,,Мен үшін, Нерула-чан...
Dialogue: 0,0:08:46.18,0:08:48.02,Default,,0,0,0,,Мен... мен өлдім.
Dialogue: 0,0:08:48.30,0:08:49.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:49.81,0:08:51.82,Default,,0,0,0,,'Oishi-kun' деп жазыптаушы
Dialogue: 0,0:08:50.67,0:08:52.41,Default,,0,0,0,,Өтінемін, олай айтпаңыз.
Dialogue: 0,0:08:52.73,0:08:55.60,Default,,0,0,0,,Біз Нагоми-чанды кінәлауға келген жоқпыз.
Dialogue: 0,0:08:55.87,0:08:59.23,Default,,0,0,0,,Нерула-чан, сен бізбен Нагоми-чан туралы жиі айтасың.
Dialogue: 0,0:08:59.62,0:09:02.36,Default,,0,0,0,,Нагоми-чан жақсы қызметші болады.
Dialogue: 0,0:09:03.34,0:09:06.86,Default,,0,0,0,,Акибаның күңдерін ауыстыратын Нагоми-чан болады.
Dialogue: 0,0:09:07.55,0:09:08.34,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:09:09.11,0:09:10.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:11.01,0:09:13.42,Default,,0,0,0,,Осыны ұстаңыз, Нагоми-чан.
Dialogue: 0,0:09:38.99,0:09:39.79,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:09:44.16,0:09:46.13,Default,,0,0,0,,Неге дүкенге қайтып бармайсың?
Dialogue: 0,0:09:46.72,0:09:50.12,Default,,0,0,0,,Егер мен қазір қайтып оралсам, мен сені тек ұстап тұрамын.
Dialogue: 0,0:09:51.91,0:09:54.54,Default,,0,0,0,,Бұл оған өкінішті болды.
Dialogue: 0,0:09:54.85,0:09:57.90,Default,,0,0,0,,Мен Нерула-чанға не бере аламын?
Dialogue: 0,0:09:59.38,0:10:02.12,Default,,0,0,0,,Мен көп жылдар бойы Акихабарада рамен дүкенін басқарып келемін.
Dialogue: 0,0:10:02.40,0:10:04.98,Default,,0,0,0,,Тұтынушылар бірдей дәмді бағалайды.
Dialogue: 0,0:10:05.71,0:10:09.80,Default,,0,0,0,,Дегенмен, раменнің дәмі біршама өзгерді.
Dialogue: 0,0:10:10.12,0:10:13.75,Default,,0,0,0,,Бір қалыпта қалу үшін кейде өзгертуге тура келеді.
Dialogue: 0,0:10:14.36,0:10:16.33,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:10:17.89,0:10:19.59,Default,,0,0,0,,Анау, анау, анау жеткізу...
Dialogue: 0,0:10:19.59,0:10:20.35,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:10:30.66,0:10:33.79,Default,,0,0,0,,Бір қалыпта қалу үшін біз өзгеруіміз керек
Dialogue: 0,0:10:43.34,0:10:46.22,Default,,0,0,0,,Ниширо көп келді.
Dialogue: 0,0:10:46.22,0:10:47.82,Default,,0,0,0,,барлығы 17 адам
Dialogue: 0,0:10:48.13,0:10:49.32,Default,,0,0,0,,Барып жаңалық айтайық.
Dialogue: 0,0:10:49.77,0:10:51.32,Default,,0,0,0,,Сіз майданнан келдіңіз бе?
Dialogue: 0,0:10:51.32,0:10:53.20,Default,,0,0,0,,Сан біздікінен екі есе көп.
Dialogue: 0,0:10:53.20,0:10:54.13,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:10:54.13,0:10:56.74,Default,,0,0,0,,Тырнағымды жаңа ғана ауыстырсам да, қатты өліп жатырмын.
Dialogue: 0,0:10:56.74,0:10:59.14,Default,,0,0,0,,Бұл мен әлі қолданбаған шыбық.
Dialogue: 0,0:11:03.93,0:11:07.11,Default,,0,0,0,,Ей, шошқа аулауға барсақ қайтеді?
Dialogue: 0,0:11:13.59,0:11:14.38,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:11:14.75,0:11:16.19,Default,,0,0,0,,Терезенің төменгі жағы жабылған
Dialogue: 0,0:11:16.54,0:11:18.13,Default,,0,0,0,,Шошқалар қашып құтыла алмайды
Dialogue: 0,0:11:18.37,0:11:20.91,Default,,0,0,0,,Бұл жалғыз кіреберіс пе?
Dialogue: 0,0:11:28.26,0:11:29.13,Default,,0,0,0,,Оны атамаңыз.
Dialogue: 0,0:11:30.56,0:11:31.71,Default,,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:11:32.95,0:11:34.44,Default,,0,0,0,,Күте тұрыңыз, Гораа
Dialogue: 0,0:11:39.72,0:11:40.30,Default,,0,0,0,,Менеджер
Dialogue: 0,0:11:44.47,0:11:45.70,Default,,0,0,0,,Сөйлессең түсінесің.
Dialogue: 0,0:11:45.89,0:11:47.38,Default,,0,0,0,,Мылтықты қойып, сөйлесейік.
Dialogue: 0,0:11:49.03,0:11:51.36,Default,,0,0,0,,Ей, біз сені кепілде ұстап отырмыз.
Dialogue: 0,0:11:53.70,0:11:56.61,Default,,0,0,0,,Кепілге алынған адамды түсінудің қандай да бір жолы бар ма?
Dialogue: 0,0:11:58.55,0:12:00.69,Default,,0,0,0,,Жоғарыға шығыңыз.
Dialogue: 0,0:12:00.79,0:12:01.24,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.21,0:12:21.82,Default,,0,0,0,,Егер мен бір оқ атсам, 100 оқ қайтарылады.
Dialogue: 0,0:12:21.82,0:12:22.58,Default,,0,0,0,,Он ату.
Dialogue: 0,0:12:22.58,0:12:24.35,Default,,0,0,0,,Маған бәрібір, өл, өл
Dialogue: 0,0:12:27.95,0:12:28.75,Default,,0,0,0,,Сырттан
Dialogue: 0,0:12:29.26,0:12:30.92,Default,,0,0,0,,Аңдар үшін қосымша болуы мүмкін.
Dialogue: 0,0:12:31.27,0:12:32.04,Default,,0,0,0,,Келіңдер, көріңдер, балалар.
Dialogue: 0,0:12:32.18,0:12:32.86,Default,,0,0,0,,Иә
Dialogue: 0,0:12:38.61,0:12:40.20,Default,,0,0,0,,Мұнда ешкім жоқ, солай ма?
Dialogue: 0,0:12:40.62,0:12:43.16,Default,,0,0,0,,Егер күшейткіштер келсе, біз қаптағы тышқан боламыз.
Dialogue: 0,0:12:43.43,0:12:43.97,Default,,0,0,0,,Сауатты болыңыз
Dialogue: 0,0:12:44.28,0:12:44.77,Default,,0,0,0,,Иә
Dialogue: 0,0:12:47.82,0:12:50.75,Default,,0,0,0,,Кішкентай трюктерді доғарыңдар, шошқалар.
Dialogue: 0,0:12:51.10,0:12:52.15,Default,,0,0,0,,Шық!
Dialogue: 0,0:12:52.30,0:12:54.75,Default,,0,0,0,,Маған оңай көрінетіндей өлуге рұқсат етіңіз.
Dialogue: 0,0:12:55.04,0:12:57.15,Default,,0,0,0,,Кешіріңіз, үшінші қабат бұзылды.
Dialogue: 0,0:12:57.15,0:12:58.38,Default,,0,0,0,,Қысқышпен шабуылға ұшырау
Dialogue: 0,0:12:58.63,0:13:00.83,Default,,0,0,0,,Юмичи-сан, мен арнайы шабуыл жасаймын.
Dialogue: 0,0:13:01.10,0:13:03.46,Default,,0,0,0,,Осы мүмкіндікті пайдаланып, жаудың басынан соққы беріңіз.
Dialogue: 0,0:13:04.16,0:13:04.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:05.03,0:13:06.09,Default,,0,0,0,,Атыс күші әртүрлі
Dialogue: 0,0:13:06.43,0:13:08.17,Default,,0,0,0,,Менде бар оқпен өзімді қауіпсіз сезінбеймін.
Dialogue: 0,0:13:08.17,0:13:09.77,Default,,0,0,0,,Қазір кетсең, өлесің.
Dialogue: 0,0:13:09.99,0:13:12.64,Default,,0,0,0,,Бұл дүкен қорғалғанша, ешқандай проблема жоқ.
Dialogue: 0,0:13:13.07,0:13:13.69,Default,,0,0,0,,Арашико
Dialogue: 0,0:13:22.54,0:13:23.21,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:38.34,0:13:39.44,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:13:39.44,0:13:39.94,Default,,0,0,0,,Ниндзя
Dialogue: 0,0:13:39.94,0:13:40.64,Default,,0,0,0,,Ниндзя?
Dialogue: 0,0:13:40.64,0:13:41.39,Default,,0,0,0,,Ниндзя
Dialogue: 0,0:13:41.39,0:13:42.64,Default,,0,0,0,,Манами, мен ниндзямын.
Dialogue: 0,0:13:42.64,0:13:44.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:44.58,0:13:47.47,Default,,0,0,0,,Мен ниндзя емеспін, мен қызметшімін.
Dialogue: 0,0:13:49.39,0:13:50.77,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:13:54.99,0:13:55.44,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:14:01.49,0:14:03.93,Default,,0,0,0,,Арашико-сан, мен әлі де қызметші болғым келеді.
Dialogue: 0,0:14:04.33,0:14:05.38,Default,,0,0,0,,Мен енді қашпаймын
Dialogue: 0,0:14:05.38,0:14:06.49,Default,,0,0,0,,Бұл туралы кейінірек
Dialogue: 0,0:14:12.19,0:14:14.38,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:14:15.04,0:14:15.79,Default,,0,0,0,,Өл
Dialogue: 0,0:14:18.13,0:14:19.59,Default,,0,0,0,,Әтеш
Dialogue: 0,0:14:26.32,0:14:29.18,Default,,0,0,0,,Билесең, мен сені өлтіремін.
Dialogue: 0,0:14:29.58,0:14:31.27,Default,,0,0,0,,Мен енді ешкімнің мені өлтіруіне жол бермеймін
Dialogue: 0,0:14:32.01,0:14:34.69,Default,,0,0,0,,Мен Акибада тұрамын
Dialogue: 0,0:14:43.77,0:14:44.74,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:14:44.74,0:14:45.97,Default,,0,0,0,,А, Шира да барады.
Dialogue: 0,0:14:50.20,0:14:51.50,Default,,0,0,0,,Получа́й!
Dialogue: 0,0:15:03.17,0:15:04.35,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:04.35,0:15:05.47,Default,,0,0,0,,Айми-сан
Dialogue: 0,0:15:05.77,0:15:06.86,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:15:07.05,0:15:08.75,Default,,0,0,0,,Сіз мұнда картоп тарта аласыз ба?
Dialogue: 0,0:15:08.75,0:15:11.78,Default,,0,0,0,,Айми-сансыз Майдриан не болады?
Dialogue: 0,0:15:11.78,0:15:12.80,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:15:13.94,0:15:15.64,Default,,0,0,0,,Менен қашпа
Dialogue: 0,0:15:15.77,0:15:17.13,Default,,0,0,0,,Балалар, бара беріңдер.
Dialogue: 0,0:15:22.31,0:15:23.46,Default,,0,0,0,,Нагомиге барыңыз
Dialogue: 0,0:15:23.92,0:15:25.34,Default,,0,0,0,,Сіз оны шешесіз, солай ма?
Dialogue: 0,0:15:27.50,0:15:28.75,Default,,0,0,0,,Арашико-сан да
Dialogue: 0,0:15:29.36,0:15:30.60,Default,,0,0,0,,...
Dialogue: 0,0:15:30.78,0:15:31.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:44.78,0:15:47.67,Default,,0,0,0,,Дабо оны өлтіреді.
Dialogue: 0,0:15:47.67,0:15:48.86,Default,,0,0,0,,Күшейтуге шақыру
Dialogue: 0,0:15:49.31,0:15:53.06,Default,,0,0,0,,Бізге қосымша күштер жетсе, біз бұл соғысты жеңе аламыз.
Dialogue: 0,0:15:54.26,0:15:56.46,Default,,0,0,0,,Сен қазір не туралы айтып тұрсың, Угаки?
Dialogue: 0,0:15:56.66,0:15:58.78,Default,,0,0,0,,Соғыс басталып та кетті
Dialogue: 0,0:15:58.91,0:16:00.66,Default,,0,0,0,,Қамқор болмаңыз
Dialogue: 0,0:16:00.82,0:16:03.32,Default,,0,0,0,,Жәндіктер бірін-бірі өз бетінше жаншуы керек.
Dialogue: 0,0:16:03.62,0:16:05.74,Default,,0,0,0,,Біз енді араласпаймыз
Dialogue: 0,0:16:05.99,0:16:07.70,Default,,0,0,0,,Сіз аңға айналасыз.
Dialogue: 0,0:16:08.41,0:16:09.47,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:09.64,0:16:13.69,Default,,0,0,0,,Бөтен планеталықтар Акихабарада аңдармен қоян-қолтық өмір сүреді.
Dialogue: 0,0:16:13.69,0:16:14.89,Default,,0,0,0,,Бұл біріктіру.
Dialogue: 0,0:16:15.10,0:16:19.15,Default,,0,0,0,,Сонымен жұлдыздар қақпасынан өткен соң бір-бірімізді түсіндік.
Dialogue: 0,0:16:19.69,0:16:22.32,Default,,0,0,0,,Манами, барлығы үшін рахмет
Dialogue: 0,0:16:22.57,0:16:24.65,Default,,0,0,0,,Тым болмаса тыныш өл.
Dialogue: 0,0:16:33.61,0:16:34.03,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:16:34.31,0:16:35.86,Default,,0,0,0,,Кешіріңіз, Айми-сан.
Dialogue: 0,0:16:36.31,0:16:38.31,Default,,0,0,0,,Сен шынымен де пайдасызсың ба?
Dialogue: 0,0:16:38.69,0:16:39.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:44.91,0:16:46.82,Default,,0,0,0,,Иә, маған ұнайды.
Dialogue: 0,0:16:48.06,0:16:48.68,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:48.86,0:16:50.42,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:17:22.36,0:17:25.30,Default,,0,0,0,,Кішкентай қыз, сіз мәселені шешуге келдіңіз бе?
Dialogue: 0,0:17:25.66,0:17:27.85,Default,,0,0,0,,Мен сені кешіре алмаймын
Dialogue: 0,0:17:28.18,0:17:31.43,Default,,0,0,0,,Егер ол табылса, сіз не істер едіңіз? Өлтіре ме?
Dialogue: 0,0:17:33.00,0:17:34.39,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:17:34.54,0:17:36.91,Default,,0,0,0,,Жас келіншек қызметші емес.
Dialogue: 0,0:17:37.22,0:17:38.41,Default,,0,0,0,,Мен қызметшімін
Dialogue: 0,0:17:38.71,0:17:39.91,Default,,0,0,0,,Ниндзя Яруга
Dialogue: 0,0:17:40.14,0:17:40.75,Default,,0,0,0,,Мен қызметшімін
Dialogue: 0,0:17:40.98,0:17:43.46,Default,,0,0,0,,Сол жерде аңырап тұрған қызметші ме?
Dialogue: 0,0:17:46.29,0:17:47.02,Default,,0,0,0,,Арашико-сан
Dialogue: 0,0:17:47.30,0:17:50.59,Default,,0,0,0,,Егер сіз бұл адамды тірі қалдырсаңыз, ол сізге қайта-қайта шабуыл жасайды.
Dialogue: 0,0:17:51.83,0:17:54.00,Default,,0,0,0,,Йовакаттонну
Dialogue: 0,0:17:55.83,0:17:56.84,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:59.05,0:18:00.99,Default,,0,0,0,,Нагоми-сан, кетші.
Dialogue: 0,0:18:00.99,0:18:01.82,Default,,0,0,0,,Соқпаңыз
Dialogue: 0,0:18:02.11,0:18:04.27,Default,,0,0,0,,Мен сені қорғауға тырысамын.
Dialogue: 0,0:18:04.27,0:18:06.24,Default,,0,0,0,,Мені сынға алды
Dialogue: 0,0:18:06.24,0:18:07.00,Default,,0,0,0,,Жолдан кетіңіз
Dialogue: 0,0:18:08.74,0:18:10.91,Default,,0,0,0,,Жарқанат пен чакамен бес минут
Dialogue: 0,0:18:11.02,0:18:12.61,Default,,0,0,0,,Тездетіп, шарларыңызды жіберіңіз.
Dialogue: 0,0:18:13.21,0:18:14.98,Default,,0,0,0,,Сонша ұрысқың келе ме?
Dialogue: 0,0:18:15.31,0:18:17.36,Default,,0,0,0,,Қызметшілер ұрысады, солай ма?
Dialogue: 0,0:18:17.68,0:18:19.18,Default,,0,0,0,,Бұл қызметші емес.
Dialogue: 0,0:18:19.86,0:18:21.33,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:21.33,0:18:24.63,Default,,0,0,0,,Күң өмірде ұят болғанша, өлгенде гүлдегенді артық көреді.
Dialogue: 0,0:18:24.84,0:18:27.67,Default,,0,0,0,,Сен өлсең күйеуің де қайғыр еді.
Dialogue: 0,0:18:28.03,0:18:30.88,Default,,0,0,0,,Тіпті рамен өзгереді, сондықтан қызметшілер де өзгереді.
Dialogue: 0,0:18:31.15,0:18:33.91,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін.
Dialogue: 0,0:18:33.91,0:18:36.51,Default,,0,0,0,,Қай қарындас тозақта жылайды?
Dialogue: 0,0:18:36.78,0:18:39.89,Default,,0,0,0,,Нерула-чан маған сол қалпымда қалуымды айтты.
Dialogue: 0,0:18:40.45,0:18:42.59,Default,,0,0,0,,Онда сені өлтірудің қажеті жоқ.
Dialogue: 0,0:18:42.59,0:18:43.82,Default,,0,0,0,,Дохетаре
Dialogue: 0,0:18:43.96,0:18:46.22,Default,,0,0,0,,Сіз жай ғана доптар үшін жарыса алмайсыз.
Dialogue: 0,0:18:46.49,0:18:47.74,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:18:48.36,0:18:49.54,Default,,0,0,0,,Бірақ өлтірме
Dialogue: 0,0:18:49.94,0:18:51.65,Default,,0,0,0,,Мен сондай қызметші боламын
Dialogue: 0,0:18:52.96,0:18:56.32,Default,,0,0,0,,Жастардың айтысатын уақыты аяқталды.
Dialogue: 0,0:19:01.58,0:19:03.65,Default,,0,0,0,,Өмір сүр, өлтірме
Dialogue: 0,0:19:03.76,0:19:06.92,Default,,0,0,0,,Егер сіз де қызметші болсаңыз, Моге көңіл бөліңіз!
Dialogue: 0,0:19:06.92,0:19:08.98,Default,,0,0,0,,Егер сіз билеп жатсаңыз, сіз ниндзясыз.
Dialogue: 0,0:19:08.98,0:19:11.88,Default,,0,0,0,,Неліктен ниндзя бұлай айта алмайды?
Dialogue: 0,0:19:12.04,0:19:13.50,Default,,0,0,0,,Мен қызметшімін
Dialogue: 0,0:19:13.70,0:19:15.68,Default,,0,0,0,,Мо Мо Кюн
Dialogue: 0,0:19:30.85,0:19:32.94,Default,,0,0,0,,Янекоячано
Dialogue: 0,0:19:33.18,0:19:34.84,Default,,0,0,0,,Шошқа аулау аяқталды
Dialogue: 0,0:19:36.42,0:19:37.99,Default,,0,0,0,,Ғарышқа оралу
Dialogue: 0,0:19:49.65,0:19:54.05,Default,,0,0,0,,Нерула-чаннан ұялмай, өзімнің күңім боламын.
Dialogue: 0,0:19:55.64,0:19:57.68,Default,,0,0,0,,Қош келдіңіз, Нагоми-сан.
Dialogue: 0,0:19:59.96,0:20:01.40,Default,,0,0,0,,Әлі де бу
Dialogue: 0,0:20:09.90,0:20:12.04,Default,,0,0,0,,Аң иісі бар иіс
Dialogue: 0,0:20:12.44,0:20:14.94,Default,,0,0,0,,Угаки Жағаңды көре алмаймын.
Dialogue: 0,0:20:16.01,0:20:18.34,Default,,0,0,0,,Енді маған менсінбе.
Dialogue: 0,0:20:18.91,0:20:22.50,Default,,0,0,0,,Мылтықыңды дайын тұрсаң, қалтырап қалсаң мен саған қамқор болмаймын.
Dialogue: 0,0:20:22.64,0:20:24.70,Default,,0,0,0,,Мені сынай беруге болмайды.
Dialogue: 0,0:20:25.70,0:20:28.46,Default,,0,0,0,,Енді қызметші болып сөйлеспе.
Dialogue: 0,0:20:29.63,0:20:32.88,Default,,0,0,0,,Жұлдызды жадыға айналыңыз
Dialogue: 0,0:20:47.78,0:20:50.00,Default,,0,0,0,,Қатты ауырады
Dialogue: 0,0:20:50.65,0:20:53.86,Default,,0,0,0,,Тірі қалудың өзі ауырады
Dialogue: 0,0:21:04.77,0:21:05.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:06.96,0:21:09.19,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Угаки-сан.
Dialogue: 0,0:21:14.26,0:21:18.30,Default,,0,0,0,,Осылайша, Аймидің Мэйдриан штаб-пәтерін басып алуымен
Dialogue: 0,0:21:18.47,0:21:22.10,Default,,0,0,0,,Кедамоланд тобына қарсы күрес жоспары сәтсіз аяқталды.
Dialogue: 0,0:21:23.03,0:21:27.00,Default,,0,0,0,,Майдриан тобын біріктіруге қарсы шыққан фракция бөлді.
Dialogue: 0,0:21:27.19,0:21:31.05,Default,,0,0,0,,Екінші өкіл Угаки тізгінді қайтадан алады.
Dialogue: 0,0:21:31.56,0:21:34.45,Default,,0,0,0,,Бірақ сұңқарларынан айырылған Мейдриан,
Dialogue: 0,0:21:34.64,0:21:38.70,Default,,0,0,0,,Кедамоноландтың талаптарын толық орындаудан басқа амал жоқ.
Dialogue: 0,0:21:39.01,0:21:42.04,Default,,0,0,0,,Угакидің теңдердің бірігуі туралы жоспары сәтсіз аяқталды
Dialogue: 0,0:21:42.44,0:21:47.33,Default,,0,0,0,,Нәтижесінде Кедамоноленд Мейдрианды тұтастай жұтатын абсорбциялық типті біріктіруге айналады.
Dialogue: 0,0:21:47.67,0:21:50.46,Default,,0,0,0,,Мэйдриан тобы іс жүзінде жоғалып кетті.
Dialogue: 0,0:21:51.59,0:21:56.49,Default,,0,0,0,,Осыдан кейін Қызыл супернова деп аталған Манамидің қайда екенін ешкім білмейді.
Dialogue: 0,0:21:58.36,0:22:04.07,Default,,0,0,0,,Ал Акихабара Кедамоланд тобының ең мықтысы болу дәуіріне енді.
Dialogue: 0,0:22:06.18,0:22:08.60,Default,,0,0,0,,Тұтас қуыру керек болатын заттар
Dialogue: 0,0:22:10.10,0:22:16.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
