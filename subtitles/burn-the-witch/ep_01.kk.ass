Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.97,0:00:18.10,Default,,0,0,0,,Ертегілер боқтық, солай ма?
Dialogue: 0,0:00:18.81,0:00:21.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:21.73,0:00:24.81,Default,,0,0,0,,Қыз сиқырланып, ханшайымға айналады.
Dialogue: 0,0:00:24.89,0:00:26.98,Default,,0,0,0,,Таза киіммен киіну
Dialogue: 0,0:00:27.06,0:00:29.07,Default,,0,0,0,,Әдемі еркектерді таңдағандай кейіп таныту және таңдалу
Dialogue: 0,0:00:29.86,0:00:31.32,Default,,0,0,0,,Сонымен қатар, сиқырды орта жолда бұзуға болады.
Dialogue: 0,0:00:31.40,0:00:33.07,Default,,0,0,0,,Бұл Нинни. (Нинни) Ақсақ емес пе?
Dialogue: 0,0:00:34.24,0:00:37.32,Default,,0,0,0,,Бірақ бәрі ханшайымдарды жақсы көретінін айтады.
Dialogue: 0,0:00:38.03,0:00:41.58,Default,,0,0,0,,Сіз байсалдысыз ба? Сиқырды ортасында шешуге болады
Dialogue: 0,0:00:42.37,0:00:46.83,Default,,0,0,0,,Мен уәдемді бұздым, сондықтан көмектесе алмаймын ба? Уақыт өтіп кеткендіктен мен ештеңе істей алмаймын ба?
Dialogue: 0,0:00:47.33,0:00:48.84,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:00:50.21,0:00:52.51,Default,,0,0,0,,Балалар, бәрің ақымақсыңдар.
Dialogue: 0,0:00:52.59,0:00:56.55,Default,,0,0,0,,Сиқырды бұзудың нақты себебін ешкім білмейді.
Dialogue: 0,0:00:57.47,0:00:59.10,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:59.68,0:01:00.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:02.81,0:01:03.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:05.23,0:01:06.60,Default,,0,0,0,,О, күте тұрыңыз... Нинни!
Dialogue: 0,0:01:06.69,0:01:09.06,Default,,0,0,0,,Қарғыс атсын, бұл не ақымақ жарқыл?
Dialogue: 0,0:01:22.20,0:01:23.79,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:25.12,0:01:25.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:26.21,0:01:27.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.17,0:01:30.29,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:01:31.21,0:01:33.71,Default,,0,0,0,,Сиқырды ақымақтар ғана қолданса
Dialogue: 0,0:01:35.22,0:01:38.80,Default,,0,0,0,,Маған сиқырлы жағы ұнайды.
Dialogue: 0,0:01:45.18,0:01:47.64,Default,,0,0,0,,Саусақ ұшы, дауыс ұшы
Dialogue: 0,0:01:48.44,0:01:50.27,Default,,0,0,0,,Кекші Джоның темір кілті
Dialogue: 0,0:01:50.36,0:01:53.02,Default,,0,0,0,,Бес құлыппен және үш шынжырмен үнсіздік
Dialogue: 0,0:01:53.11,0:01:55.28,Default,,0,0,0,,Сыбызғы үнімен көзіңді соқыр қыл
Dialogue: 0,0:01:55.36,0:01:56.78,Default,,0,0,0,,（）
Dialogue: 0,0:01:58.99,0:01:59.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:03.12,0:02:04.91,Default,,0,0,0,,Сиқырды қолданбаңыз
Dialogue: 0,0:02:04.99,0:02:08.37,Default,,0,0,0,,Сиқырлы сезімталдықтың арқасында мүйіз гүлдейді.
Dialogue: 0,0:02:12.88,0:02:14.00,Default,,0,0,0,,Көк ұшқын!
Dialogue: 0,0:02:18.30,0:02:18.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:23.68,0:02:25.56,Default,,0,0,0,,Сиқырлы сан 44 (Қырық төрт)
Dialogue: 0,0:02:25.64,0:02:26.72,Default,,0,0,0,,Жарқыл бампер!
Dialogue: 0,0:02:32.06,0:02:34.98,Default,,0,0,0,,Бұл қайнаған арқа.
Dialogue: 0,0:02:36.73,0:02:38.15,Default,,0,0,0,,А класындағы егін!
Dialogue: 0,0:02:38.24,0:02:41.36,Default,,0,0,0,,Мен уақытында үлгермесем, не істер едің?
Dialogue: 0,0:02:42.32,0:02:46.62,Default,,0,0,0,,Сізге өте кешіккен адамның сізге бірдеңе айтуының мағынасы жоқ.
Dialogue: 0,0:02:46.70,0:02:47.95,Default,,0,0,0,,Нинни-чан
Dialogue: 0,0:02:49.96,0:02:53.13,Default,,0,0,0,,Мен саған айттым ғой, үлкендеріңді «чан» деп атама!
Dialogue: 0,0:02:53.21,0:02:54.59,Default,,0,0,0,,Ниха!
Dialogue: 0,0:02:56.55,0:02:58.09,Default,,0,0,0,,Нинни-чан мен туралы.
Dialogue: 0,0:02:58.17,0:02:59.30,Default,,0,0,0,,Егер сіз мені «Нэру-чан» деп атасаңыз
Dialogue: 0,0:02:59.38,0:03:00.68,Default,,0,0,0,,Тоқтасаң жақсы болады.
Dialogue: 0,0:03:00.76,0:03:02.64,Default,,0,0,0,,Неге, менің кішілерім?
Dialogue: 0,0:03:02.72,0:03:04.43,Default,,0,0,0,,«Чан» қосуды сұрайсыз ба?
Dialogue: 0,0:03:05.93,0:03:09.68,Default,,0,0,0,,Айдаһар ойдан шығарылған жаратылыс
Dialogue: 0,0:03:10.18,0:03:14.44,Default,,0,0,0,,Бірақ шын мәнінде ол ойдан шығарылған да, тірі де емес.
Dialogue: 0,0:03:15.27,0:03:16.48,Default,,0,0,0,,Баяғыдан
Dialogue: 0,0:03:16.57,0:03:21.24,Default,,0,0,0,,Лондондағы барлық өлімнің 72%
Dialogue: 0,0:03:21.32,0:03:25.24,Default,,0,0,0,,Айдаһар деп аталатын біртүрлі тіршілік иесі қатысады.
Dialogue: 0,0:03:26.03,0:03:27.62,Default,,0,0,0,,Лондонның елтаңбасында
Dialogue: 0,0:03:27.70,0:03:31.41,Default,,0,0,0,,Сондықтан оған үлкен айдаһар сызылған.
Dialogue: 0,0:03:32.50,0:03:35.38,Default,,0,0,0,,Қаһарлы айдаһар адамдарға зиянын тигізеді
Dialogue: 0,0:03:35.46,0:03:36.71,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:03:36.79,0:03:38.38,Default,,0,0,0,,Оның алдын алу үшін
Dialogue: 0,0:03:38.46,0:03:40.67,Default,,0,0,0,,Айдаһарды басқару қажет
Dialogue: 0,0:03:41.17,0:03:46.18,Default,,0,0,0,,Фронт Лондон тұрғындары айдаһарларды көре алмайды.
Dialogue: 0,0:03:47.35,0:03:50.77,Default,,0,0,0,,Сіз мұны Лондонның кері жағында жасай аласыз...
Dialogue: 0,0:03:52.48,0:03:56.98,Default,,0,0,0,,Лондонның артына осы қаланың тұрғындары ғана тараған.
Dialogue: 0,0:03:58.23,0:04:02.57,Default,,0,0,0,,Демек, айдаһарларды қорғау және басқару болып табылады
Dialogue: 0,0:04:02.65,0:04:06.07,Default,,0,0,0,,Бұл сол қала тұрғындарының жұмысына айналды.
Dialogue: 0,0:04:07.28,0:04:08.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.70,0:04:10.75,Default,,0,0,0,,Бір күні үлкен жігіт мені қағып кетті.
Dialogue: 0,0:04:10.83,0:04:12.37,Default,,0,0,0,,Ол әлі түзетілмеген.
Dialogue: 0,0:04:12.46,0:04:13.83,Default,,0,0,0,,Дасса!
Dialogue: 0,0:04:13.92,0:04:16.00,Default,,0,0,0,,Шектеу дегенді білмейсіңдер ғой…
Dialogue: 0,0:04:16.63,0:04:19.75,Default,,0,0,0,,Мен мониторды орнатуға басымдық бердім...
Dialogue: 0,0:04:20.46,0:04:21.55,Default,,0,0,0,,Менің айтайын дегенім, сіз де.
Dialogue: 0,0:04:21.63,0:04:23.93,Default,,0,0,0,,Неліктен сіз комбинация жұмысын өзіңіз алып жатырсыз?
Dialogue: 0,0:04:24.01,0:04:25.97,Default,,0,0,0,,Себебі Нинни-чан кешігіп келді.
Dialogue: 0,0:04:26.05,0:04:27.64,Default,,0,0,0,,Сізге күтуге тура келеді, солай ма?
Dialogue: 0,0:04:28.43,0:04:29.60,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:30.85,0:04:34.44,Default,,0,0,0,,Егер сіз оны жалғыз алсаңыз, сыйлықты өзіңізге аласыз.
Dialogue: 0,0:04:34.52,0:04:37.36,Default,,0,0,0,,Қараңдар! Нағыз ниет сол.
Dialogue: 0,0:04:37.86,0:04:39.32,Default,,0,0,0,,Нинни Лондонның алдыңғы жағында
Dialogue: 0,0:04:39.40,0:04:41.03,Default,,0,0,0,,Себебі мен көп ақша табамын
Dialogue: 0,0:04:41.11,0:04:43.65,Default,,0,0,0,,Қалағаныңызша ақша айырбастауға болады, солай ма?
Dialogue: 0,0:04:44.78,0:04:47.41,Default,,0,0,0,,Менің мақтанышым бұған жол бермейді!
Dialogue: 0,0:04:47.49,0:04:49.83,Default,,0,0,0,,Сіздің айтып тұрғаныңыз осы емес пе?
Dialogue: 0,0:04:50.74,0:04:54.41,Default,,0,0,0,,Иә? Жетістік ұпайлары жойылады
Dialogue: 0,0:04:55.54,0:04:58.38,Default,,0,0,0,,Ешкім білмесін деп гүлдеген гүлдерді тердім.
Dialogue: 0,0:04:58.46,0:05:01.38,Default,,0,0,0,,Уши! Мен сондамын
Dialogue: 0,0:05:01.88,0:05:03.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:03.63,0:05:07.30,Default,,0,0,0,,Бұл шешілді, себебі соңғы қосу жұмыс істеді, солай ма?
Dialogue: 0,0:05:07.39,0:05:10.14,Default,,0,0,0,,Соның арқасында сұралған зат қауіпсіз болды.
Dialogue: 0,0:05:11.01,0:05:12.81,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:05:12.89,0:05:16.31,Default,,0,0,0,,Мұны жасамаңыз. Рұқсатсыз суретке түссеңіз, қайтадан ашуланасыз.
Dialogue: 0,0:05:16.81,0:05:18.06,Default,,0,0,0,,Айтайын дегенім, сен! (Қызметкерлер) Ах...
Dialogue: 0,0:05:18.15,0:05:21.77,Default,,0,0,0,,Не, сен Батбэк гүлдерін рұқсатсыз теріп жүрсің бе?
Dialogue: 0,0:05:21.86,0:05:23.57,Default,,0,0,0,,Басқа таңдау жоқ, солай ма?
Dialogue: 0,0:05:24.19,0:05:27.82,Default,,0,0,0,,Гүлдер сатқанша гүлдесе, құны төмендейді.
Dialogue: 0,0:05:28.41,0:05:30.16,Default,,0,0,0,,Бұл клиент үшін.
Dialogue: 0,0:05:31.20,0:05:35.83,Default,,0,0,0,,Қараңызшы, бұл әдемі емес пе? Оған қол тигізу жақсы
Dialogue: 0,0:05:35.91,0:05:37.71,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:05:37.79,0:05:39.63,Default,,0,0,0,,Жоқ... Маған керегі жоқ!
Dialogue: 0,0:05:39.71,0:05:42.75,Default,,0,0,0,,Шалбар Miseteee~ (2 адам) Иә?
Dialogue: 0,0:05:43.30,0:05:46.42,Default,,0,0,0,,Шалбар Misete~
Dialogue: 0,0:05:46.92,0:05:50.35,Default,,0,0,0,,Эй...Оши-чан!
Dialogue: 0,0:05:50.43,0:05:52.72,Default,,0,0,0,,Бұл не? (Б жұмысшы) Қараңғы айдаһар ма?
Dialogue: 0,0:05:53.47,0:05:55.64,Default,,0,0,0,,Қаланың қақ ортасында осылай ма?
Dialogue: 0,0:05:55.73,0:05:57.98,Default,,0,0,0,,Жоқ... бұл Балго!
Dialogue: 0,0:05:58.06,0:06:00.73,Default,,0,0,0,,Боқ~ Тағы Барго?
Dialogue: 0,0:06:00.81,0:06:04.86,Default,,0,0,0,,Осуши-чан, сабыр ет~!
Dialogue: 0,0:06:05.65,0:06:10.99,Default,,0,0,0,,Сен сүйкімдісің, сен сүйкімдісің, сондықтан сәл тынышталшы~
Dialogue: 0,0:06:12.95,0:06:14.24,Default,,0,0,0,,Балго және Осшиджан
Dialogue: 0,0:06:14.87,0:06:16.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:16.54,0:06:18.92,Default,,0,0,0,,Сен, бірдеңе істе.
Dialogue: 0,0:06:19.00,0:06:20.08,Default,,0,0,0,,Сіз әкімшісіз бе?
Dialogue: 0,0:06:20.58,0:06:23.67,Default,,0,0,0,,Біз әкімшілерміз.
Dialogue: 0,0:06:23.75,0:06:25.88,Default,,0,0,0,,Сіз орта мектепте оқисыз ба?
Dialogue: 0,0:06:25.96,0:06:28.88,Default,,0,0,0,,Жарайды, солай емес пе?
Dialogue: 0,0:06:29.84,0:06:31.30,Default,,0,0,0,,Адам күліп тұр
Dialogue: 0,0:06:31.80,0:06:33.01,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:06:34.26,0:06:35.56,Default,,0,0,0,,Мен кафе латте
Dialogue: 0,0:06:35.64,0:06:38.85,Default,,0,0,0,,Маған ақша берсең, түймені басамын.
Dialogue: 0,0:06:40.02,0:06:42.61,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:06:42.69,0:06:45.27,Default,,0,0,0,,Осылай қалсаң, Барго-кун, өлесің, солай ма?
Dialogue: 0,0:06:45.36,0:06:48.90,Default,,0,0,0,,Барго-кунды үйде қорғауымыз керек.
Dialogue: 0,0:06:48.99,0:06:50.91,Default,,0,0,0,,Өзіңізге мұқият болыңыз!
Dialogue: 0,0:06:51.61,0:06:54.70,Default,,0,0,0,,Айдаһарды иеленуді басқару дегеніміз не?
Dialogue: 0,0:06:54.78,0:06:58.54,Default,,0,0,0,,Бас кеңсе өзі түсінбейтін нәрселерді таңуды ғана қаламайды.
Dialogue: 0,0:06:59.50,0:07:03.29,Default,,0,0,0,,Жұмыс істеп жүріп, 24 сағат бойы қамқорлық жасадым.
Dialogue: 0,0:07:03.38,0:07:07.26,Default,,0,0,0,,Өйткені мен жалақы немесе өнімділік ұпайларын алмаймын.
Dialogue: 0,0:07:07.76,0:07:10.68,Default,,0,0,0,,Ондай нәрсе...
Dialogue: 0,0:07:10.76,0:07:12.93,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:07:13.76,0:07:15.89,Default,,0,0,0,,Тиісті органдардан рұқсат алу
Dialogue: 0,0:07:15.97,0:07:20.02,Default,,0,0,0,,Сіз қосымша ақы мен ерекше жетістіктерге ие боласыз.
Dialogue: 0,0:07:20.10,0:07:21.14,Default,,0,0,0,,Ал мына бағана бар.
Dialogue: 0,0:07:21.23,0:07:22.81,Default,,0,0,0,,Ихихихи…
Dialogue: 0,0:07:22.90,0:07:26.07,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен істеймін!
Dialogue: 0,0:07:27.28,0:07:28.90,Default,,0,0,0,,Ниха кеттік
Dialogue: 0,0:07:29.40,0:07:31.57,Default,,0,0,0,,Сіз ақша үшін келдіңіз.
Dialogue: 0,0:07:31.65,0:07:33.41,Default,,0,0,0,,Мен жетістіктеріме байланыстымын.
Dialogue: 0,0:07:33.91,0:07:37.29,Default,,0,0,0,,Мұның бәрі әлеуметтік әділеттілік туралы!
Dialogue: 0,0:07:39.16,0:07:40.20,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:41.50,0:07:45.67,Default,,0,0,0,,Ең болмағанда ғимараттың алдындағы адам бірінші айқайлауы керек.
Dialogue: 0,0:07:46.17,0:07:48.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:48.75,0:07:51.17,Default,,0,0,0,,О, о... ой!
Dialogue: 0,0:07:51.26,0:07:53.30,Default,,0,0,0,,Уа... (Ер Б) Не?
Dialogue: 0,0:07:53.38,0:07:55.85,Default,,0,0,0,,Осуши-чан!
Dialogue: 0,0:07:55.93,0:07:57.10,Default,,0,0,0,,Иә? (Әйел) Не?
Dialogue: 0,0:07:57.18,0:08:00.18,Default,,0,0,0,,Әкем солай айтса...
Dialogue: 0,0:08:00.68,0:08:01.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:01.77,0:08:05.10,Default,,0,0,0,,Сен жақсы қызсың, Осуши-чан.
Dialogue: 0,0:08:06.15,0:08:08.69,Default,,0,0,0,,Бұл шулы.
Dialogue: 0,0:08:08.77,0:08:12.49,Default,,0,0,0,,Дұрыс, тіпті айдаһарлар да шабады.
Dialogue: 0,0:08:13.07,0:08:14.78,Default,,0,0,0,,Берекелі емес нәрсені айтпа.
Dialogue: 0,0:08:14.86,0:08:16.70,Default,,0,0,0,,Мұқият тазалаңыз
Dialogue: 0,0:08:16.78,0:08:17.99,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:18.08,0:08:21.62,Default,,0,0,0,,Уау! Аз ғана~
Dialogue: 0,0:08:22.29,0:08:24.21,Default,,0,0,0,,Уау, аа, а...
Dialogue: 0,0:08:24.29,0:08:26.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:26.08,0:08:28.13,Default,,0,0,0,,Варго Сен ақымақ!
Dialogue: 0,0:08:28.21,0:08:31.26,Default,,0,0,0,,Мұнда келме!
Dialogue: 0,0:08:31.34,0:08:32.97,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:33.05,0:08:33.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:34.43,0:08:37.64,Default,,0,0,0,,О, бұл өте керемет мұржа сыпырғыш.
Dialogue: 0,0:08:38.76,0:08:41.14,Default,,0,0,0,,Кешіріңіз! Мен шынымен кешірім сұраймын
Dialogue: 0,0:08:41.22,0:08:42.98,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:08:43.06,0:08:43.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.35,0:08:45.14,Default,,0,0,0,,О...
Dialogue: 0,0:08:45.23,0:08:48.77,Default,,0,0,0,,Ақымақ! Жарақатыңыз туралы ештеңе айтпаңыз.
Dialogue: 0,0:08:48.86,0:08:52.61,Default,,0,0,0,,Егер сізге айдаһармен байланыста деген айып қойылса, не істер едіңіз?
Dialogue: 0,0:08:52.69,0:08:53.49,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:08:53.57,0:08:54.65,Default,,0,0,0,,Wing Bind штаб-пәтері
Dialogue: 0,0:08:54.74,0:08:57.24,Default,,0,0,0,,Дәл сол жерде! Сонымен...
Dialogue: 0,0:08:57.74,0:09:00.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:04.33,0:09:05.62,Default,,0,0,0,,Ноэру-чан
Dialogue: 0,0:09:06.62,0:09:08.25,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,0:09:08.33,0:09:11.05,Default,,0,0,0,,Саған көмектесетін менмін, ақымақ.
Dialogue: 0,0:09:11.96,0:09:16.26,Default,,0,0,0,,Жарайды, жарайды, сабыр етші, Осуши-чан.
Dialogue: 0,0:09:18.68,0:09:19.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.64,0:09:21.01,Default,,0,0,0,,Мен тынышталдым.
Dialogue: 0,0:09:21.51,0:09:24.27,Default,,0,0,0,,Сен Осшиге не істедің?
Dialogue: 0,0:09:24.35,0:09:27.69,Default,,0,0,0,,Ештеңе емес. Мен кәдімгі серуендеп бара жатқан едім, кенет...
Dialogue: 0,0:09:27.77,0:09:30.90,Default,,0,0,0,,Ах... Рахмет, бақсылар.
Dialogue: 0,0:09:31.40,0:09:34.82,Default,,0,0,0,,Айтпақшы, әлгі мұржа...
Dialogue: 0,0:09:35.32,0:09:38.70,Default,,0,0,0,,Мұржаларды жөндеу Dragon Insurance компаниясымен жабылады.
Dialogue: 0,0:09:39.37,0:09:40.45,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:09:41.03,0:09:43.12,Default,,0,0,0,,Айдаһармен байланыста болдыңыз ба?
Dialogue: 0,0:09:43.74,0:09:46.33,Default,,0,0,0,,Мен... Менде жоқ! ештене етпейді!
Dialogue: 0,0:09:46.41,0:09:48.42,Default,,0,0,0,,Ниха инспекциясы!
Dialogue: 0,0:09:48.92,0:09:49.58,Default,,0,0,0,,Иә
Dialogue: 0,0:09:51.54,0:09:52.67,Default,,0,0,0,,Мені жалауыңызды өтінемін
Dialogue: 0,0:09:54.09,0:09:54.80,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:55.30,0:09:57.84,Default,,0,0,0,,Айдаһарды ұстасаңыз не болады?
Dialogue: 0,0:09:59.43,0:10:01.60,Default,,0,0,0,,Айдаһарларды да, азаматтарды да қорғау
Dialogue: 0,0:10:02.31,0:10:06.81,Default,,0,0,0,,1609 жылғы Айдаһармен байланысқа тыйым салу туралы заңға сәйкес
Dialogue: 0,0:10:07.31,0:10:09.23,Default,,0,0,0,,Тәртіп бұзушылар 100 жылға бас бостандығынан айырылады
Dialogue: 0,0:10:10.06,0:10:10.98,Default,,0,0,0,,Немесе...
Dialogue: 0,0:10:12.23,0:10:13.19,Default,,0,0,0,,Өлім жазасы
Dialogue: 0,0:10:13.69,0:10:14.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.65,0:10:15.69,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:10:17.70,0:10:20.20,Default,,0,0,0,,Бұл қалыпты мән (Нинни) Иә.
Dialogue: 0,0:10:21.32,0:10:22.62,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:10:22.70,0:10:24.12,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:24.20,0:10:25.66,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:10:25.75,0:10:27.12,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:10:27.20,0:10:28.75,Default,,0,0,0,,Кім кінәлі болды?
Dialogue: 0,0:10:28.83,0:10:30.17,Default,,0,0,0,,Осы дүрбелеңде қал!
Dialogue: 0,0:10:30.25,0:10:31.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:31.38,0:10:33.13,Default,,0,0,0,,Сіз не ойлап отырсыз? ол аурады!
Dialogue: 0,0:10:33.75,0:10:35.09,Default,,0,0,0,,Жалпы айтқанда, неге?
Dialogue: 0,0:10:35.17,0:10:37.38,Default,,0,0,0,,Мен сыртқа шығу үшін қоршау жағасын тақпаймын!
Dialogue: 0,0:10:37.47,0:10:40.59,Default,,0,0,0,,Өгізге тиіп, соқпайтын азаматтар
Dialogue: 0,0:10:40.68,0:10:44.14,Default,,0,0,0,,Айдаһардың иелігіндегі жалғыз адам сенсің! Түсінесіз бе?
Dialogue: 0,0:10:45.18,0:10:48.35,Default,,0,0,0,,Жоқ, мен оны кидім. Ол жыртылды!
Dialogue: 0,0:10:48.43,0:10:51.40,Default,,0,0,0,,Мен серуендеп келе жатып, кенеттен бойымда дөңес өскенін байқадым...
Dialogue: 0,0:10:52.90,0:10:55.69,Default,,0,0,0,,Ештеңе жасамасаңыз да, шынымен қанат алдыңыз ба?
Dialogue: 0,0:10:55.78,0:10:57.15,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:10:57.23,0:10:58.74,Default,,0,0,0,,Қайда?
Dialogue: 0,0:10:59.53,0:11:01.91,Default,,0,0,0,,Не? Қайда...
Dialogue: 0,0:11:02.91,0:11:04.41,Default,,0,0,0,,Есте сақтаңыз
Dialogue: 0,0:11:06.08,0:11:08.16,Default,,0,0,0,,Осуши-чан нені түкірді?
Dialogue: 0,0:11:08.66,0:11:11.87,Default,,0,0,0,,Барго-сан Осуши-чанның жылағанына қашан еліктеді?
Dialogue: 0,0:11:12.38,0:11:17.17,Default,,0,0,0,,Варго мырза түшкіргенде немесе Варго мырза күлгенде...
Dialogue: 0,0:11:17.96,0:11:19.05,Default,,0,0,0,,Бұл көп
Dialogue: 0,0:11:19.72,0:11:20.76,Default,,0,0,0,,Немесе...
Dialogue: 0,0:11:21.93,0:11:24.51,Default,,0,0,0,,Барго мырзаға қауіп төнген кезде.
Dialogue: 0,0:11:26.68,0:11:27.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:29.23,0:11:30.35,Default,,0,0,0,,Ай…
Dialogue: 0,0:11:32.10,0:11:34.06,Default,,0,0,0,,Өйткені Варго мырзаны айдаһар иеленіп алған.
Dialogue: 0,0:11:34.15,0:11:37.07,Default,,0,0,0,,Айдаһарларды күшті шақыра алатын сияқты.
Dialogue: 0,0:11:38.15,0:11:40.15,Default,,0,0,0,,Әзірше танымал емес жерге барыңыз
Dialogue: 0,0:11:40.24,0:11:41.78,Default,,0,0,0,,Өтінемін, Осуши-чанмен қашыңыз.
Dialogue: 0,0:11:41.86,0:11:43.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:44.37,0:11:45.83,Default,,0,0,0,,Нинни-чан тосқауыл таспасы
Dialogue: 0,0:11:46.41,0:11:47.20,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:11:48.41,0:11:50.33,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:51.54,0:11:53.21,Default,,0,0,0,,Онда бұл қандай фильм?
Dialogue: 0,0:11:53.29,0:11:55.17,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:11:55.25,0:11:57.25,Default,,0,0,0,,Сиқырлы сан 04 (Нөл төрт)
Dialogue: 0,0:11:57.75,0:11:59.05,Default,,0,0,0,,Стамбол
Dialogue: 0,0:12:04.18,0:12:05.43,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:12:05.51,0:12:06.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.14,0:12:10.64,Default,,0,0,0,,Жоқ, бұл тосқауыл қоюды білдіреді!
Dialogue: 0,0:12:11.14,0:12:12.69,Default,,0,0,0,,Өрттен құлаған шіркеу ішінде екі тонналық жүк көлігі мен мотоцикл болған
Dialogue: 0,0:12:13.23,0:12:16.81,Default,,0,0,0,,Әй, бастық, мен бір айдаһарды бағындырдым.
Dialogue: 0,0:12:16.90,0:12:19.02,Default,,0,0,0,,Қосымша өтемақы сұраймыз
Dialogue: 0,0:12:20.07,0:12:22.03,Default,,0,0,0,,Айдаһарды сақтандыру! (2 адам) А...
Dialogue: 0,0:12:23.99,0:12:27.32,Default,,0,0,0,,Жоқ, бұл біздің кінәміз емес.
Dialogue: 0,0:12:28.33,0:12:30.58,Default,,0,0,0,,Өтінемін, жалынбаңыз, бұл әдепсіз.
Dialogue: 0,0:12:30.66,0:12:34.00,Default,,0,0,0,,Сонда сіз айдаһардың нәсілін білмейсіз бе?
Dialogue: 0,0:12:34.50,0:12:36.21,Default,,0,0,0,,Иә, дұрыс айтасың.
Dialogue: 0,0:12:36.92,0:12:39.21,Default,,0,0,0,,Бір қарағанда оның қандай айдаһар екенін білмедім.
Dialogue: 0,0:12:41.71,0:12:45.84,Default,,0,0,0,,Ол қатты толқып кеткендіктен, мен оның аузын жабу үшін оны соққымен ұрдым.
Dialogue: 0,0:12:45.93,0:12:46.72,Default,,0,0,0,,Ниха!
Dialogue: 0,0:12:51.35,0:12:52.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:06.11,0:13:07.41,Default,,0,0,0,,Жарық сөнеді
Dialogue: 0,0:13:13.16,0:13:14.08,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:13:15.71,0:13:17.96,Default,,0,0,0,,Мен әзірге қашықтықты сақтаймын, білемін.
Dialogue: 0,0:13:29.80,0:13:31.97,Default,,0,0,0,,Әй, егер осы уақытқа дейін келсең...
Dialogue: 0,0:13:32.06,0:13:35.77,Default,,0,0,0,,Сіз тіпті дұрыс есеп бере алмайсыз.
Dialogue: 0,0:13:35.85,0:13:37.48,Default,,0,0,0,,Нинни-чан бұрын! (Нинни) Иә?
Dialogue: 0,0:13:37.56,0:13:39.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:41.44,0:13:41.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:47.57,0:13:50.83,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:13:52.74,0:13:56.46,Default,,0,0,0,,Рутерфорд көшесінің төтенше жағдайдағы айдаһар тізбегі!
Dialogue: 0,0:13:57.58,0:13:58.83,Default,,0,0,0,,Қараңғы Айдаһар
Dialogue: 0,0:14:03.34,0:14:04.71,Default,,0,0,0,,О... Иә?
Dialogue: 0,0:14:17.89,0:14:20.90,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:14:20.98,0:14:23.32,Default,,0,0,0,,Лондонның кері нұсқасынан BBC
Dialogue: 0,0:14:23.40,0:14:24.44,Default,,0,0,0,,Ескерту
Dialogue: 0,0:14:25.73,0:14:31.16,Default,,0,0,0,,Қараңғы Айдаһар туралы ескертуге байланысты Рутерфорд көшесі айдаһармен байланыстырылды.
Dialogue: 0,0:14:32.53,0:14:34.08,Default,,0,0,0,,Жарайды... (Қоғамдық ақпарат хабары) Маңайдағылардың бәрі
Dialogue: 0,0:14:34.74,0:14:37.29,Default,,0,0,0,,Тез арада эвакуациялаңыз
Dialogue: 0,0:14:38.25,0:14:41.08,Default,,0,0,0,,Жауап - Қанатты байлау.
Dialogue: 0,0:14:41.58,0:14:43.09,Default,,0,0,0,,Мен әрқашан солай ойлаймын
Dialogue: 0,0:14:43.17,0:14:47.09,Default,,0,0,0,,Мынау «Қанат байлау» соны айтпайсың ба?
Dialogue: 0,0:14:47.17,0:14:48.42,Default,,0,0,0,,Сіз ренжімейсіз бе?
Dialogue: 0,0:14:48.92,0:14:51.51,Default,,0,0,0,,Ашуланба. Бұл менің жұмысым.
Dialogue: 0,0:14:52.01,0:14:52.89,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:53.51,0:14:55.89,Default,,0,0,0,,Өзіміз айтсақ жарайды.
Dialogue: 0,0:14:55.97,0:14:58.77,Default,,0,0,0,,BBC не дейді
Dialogue: 0,0:15:00.06,0:15:02.61,Default,,0,0,0,,Басшы Айдаһар тізбегі аяқталды.
Dialogue: 0,0:15:02.69,0:15:04.40,Default,,0,0,0,,Тактикалық жасақтан (Саберс) басқаруды сұрайтын кез келді...
Dialogue: 0,0:15:05.27,0:15:07.78,Default,,0,0,0,,Иә? Ноэру-чан? Эй...
Dialogue: 0,0:15:07.86,0:15:08.99,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:15:09.07,0:15:10.90,Default,,0,0,0,,Міне, мен күткен реакция.
Dialogue: 0,0:15:10.99,0:15:13.07,Default,,0,0,0,,Хехе, мына жол
Dialogue: 0,0:15:13.16,0:15:15.62,Default,,0,0,0,,Саберлерге несие беруге ынтаңыз бар ма?
Dialogue: 0,0:15:17.49,0:15:19.33,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:15:19.91,0:15:23.92,Default,,0,0,0,,Бұл біздің кадрлар бөліміне өз күшімізді көрсету мүмкіндігіміз.
Dialogue: 0,0:15:24.00,0:15:28.67,Default,,0,0,0,,Біздің Пиперлердің жұмысы - айдаһарларды бағу және жинау.
Dialogue: 0,0:15:28.76,0:15:30.88,Default,,0,0,0,,Саған күш керек емес... (Нинни) Сол үшін айтып тұрсың.
Dialogue: 0,0:15:33.43,0:15:36.43,Default,,0,0,0,,Мен Саберлерге қосылғым келеді!
Dialogue: 0,0:15:39.52,0:15:42.10,Default,,0,0,0,,Мен қосылғым келмейді.
Dialogue: 0,0:15:43.81,0:15:44.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:48.48,0:15:49.40,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,0:15:55.87,0:15:56.74,Default,,0,0,0,,Ол таяққа тиді
Dialogue: 0,0:15:57.24,0:15:58.29,Default,,0,0,0,,Қап…
Dialogue: 0,0:15:59.91,0:16:02.92,Default,,0,0,0,,Сиқырлы сан 28 (жиырма сегіз) Жаңбырлы дөңгелек!
Dialogue: 0,0:16:13.93,0:16:16.60,Default,,0,0,0,,Маған көмектесші~ Кун...
Dialogue: 0,0:16:18.93,0:16:19.97,Default,,0,0,0,,Варго мырза...
Dialogue: 0,0:16:21.18,0:16:22.85,Default,,0,0,0,,（）
Dialogue: 0,0:16:24.73,0:16:26.81,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:16:28.69,0:16:30.44,Default,,0,0,0,,Сиқырлы сан 75 (жетпіс бес)
Dialogue: 0,0:16:31.15,0:16:32.57,Default,,0,0,0,,Гитлинг тәжі!
Dialogue: 0,0:16:38.83,0:16:41.70,Default,,0,0,0,,Сәлем! Бұл үлкен мәселе, солай емес пе?
Dialogue: 0,0:16:42.45,0:16:43.71,Default,,0,0,0,,Неше жыл болды?
Dialogue: 0,0:16:43.79,0:16:45.00,Default,,0,0,0,,100 жыл!
Dialogue: 0,0:16:45.08,0:16:47.21,Default,,0,0,0,,96 жыл (Бруно) Әй?
Dialogue: 0,0:16:47.88,0:16:49.59,Default,,0,0,0,,100-ге жуық!
Dialogue: 0,0:16:50.30,0:16:53.59,Default,,0,0,0,,Лондонды 100 жылда алғаш рет кері айналдыру
Dialogue: 0,0:16:54.09,0:16:56.47,Default,,0,0,0,,Мен қараңғы айдаһардың басып кіруіне рұқсат бердім.
Dialogue: 0,0:16:56.97,0:16:59.18,Default,,0,0,0,,Бұл үлкен мәселе емес!
Dialogue: 0,0:16:59.68,0:17:01.52,Default,,0,0,0,,Әй, дұрыс кел!
Dialogue: 0,0:17:02.10,0:17:03.81,Default,,0,0,0,,Ей, сағыз шайнама!
Dialogue: 0,0:17:04.85,0:17:07.27,Default,,0,0,0,,Бұл жігіт үнемі үндемейді емес пе?
Dialogue: 0,0:17:07.35,0:17:10.27,Default,,0,0,0,,Қатты ашуланған мен ғана ма? а?
Dialogue: 0,0:17:10.77,0:17:12.74,Default,,0,0,0,,Мен сөйледім
Dialogue: 0,0:17:12.82,0:17:13.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:14.28,0:17:16.82,Default,,0,0,0,,Тыңдаңыз, менің айтып отырғаным бәрібір.
Dialogue: 0,0:17:16.91,0:17:19.45,Default,,0,0,0,,Бұл бейбақ, Баргоны жабайылыққа жіберудің мәні неде?
Dialogue: 0,0:17:19.53,0:17:21.33,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:17:22.20,0:17:24.66,Default,,0,0,0,,Сіз қалай ойлайсыз? Қасқыр қарт
Dialogue: 0,0:17:26.67,0:17:28.08,Default,,0,0,0,,Тіпті біздің отрядта да
Dialogue: 0,0:17:28.17,0:17:31.46,Default,,0,0,0,,Айдаһардың қолына түскеніне бір ай болды.
Dialogue: 0,0:17:31.55,0:17:35.05,Default,,0,0,0,,Бұл талай рет көтерілген тақырып.
Dialogue: 0,0:17:35.97,0:17:39.18,Default,,0,0,0,,Біздің бөлімшенің әрекетсіздігінен туындаған жағдай
Dialogue: 0,0:17:39.80,0:17:42.43,Default,,0,0,0,,Біз мұны назардан тыс қалдыра алмаймыз
Dialogue: 0,0:17:44.22,0:17:48.90,Default,,0,0,0,,Айдаһарға ие барго саябақтарына бағыну процедурасын бастаңыз.
Dialogue: 0,0:17:50.11,0:17:51.36,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:51.94,0:17:52.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:52.94,0:17:59.91,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:04.83,0:18:06.83,Default,,0,0,0,,♪～
Dialogue: 0,0:19:30.16,0:19:32.17,Default,,0,0,0,,～♪
Dialogue: 0,0:19:46.89,0:19:48.31,Default,,0,0,0,,Ах...
