Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:33.42,0:02:35.37,Default,,0,0,0,,Ха-ха-а...
Dialogue: 0,0:02:35.37,0:02:37.35,Default,,0,0,0,,Хаа хааа...
Dialogue: 0,0:02:37.35,0:02:39.36,Default,,0,0,0,,Ах... сен
Dialogue: 0,0:02:39.36,0:02:41.36,Default,,0,0,0,,Ю-чан...
Dialogue: 0,0:02:41.36,0:02:43.36,Default,,0,0,0,,Сіз не істеп жатырсыз? Ах
Dialogue: 0,0:02:43.36,0:02:46.36,Default,,0,0,0,,Тезірек Юды өлтір!
Dialogue: 0,0:02:46.36,0:02:48.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.36,0:02:50.37,Default,,0,0,0,,Асығыңыз! Ах
Dialogue: 0,0:02:50.37,0:02:52.37,Default,,0,0,0,,Уф, бірақ...
Dialogue: 0,0:02:52.37,0:02:54.37,Default,,0,0,0,,Тк, бля!
Dialogue: 0,0:03:03.36,0:03:05.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:05.37,0:03:07.37,Default,,0,0,0,,Ой, мен шынында да шын атымды айтып жібердім бе?
Dialogue: 0,0:03:10.37,0:03:12.36,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:03:12.36,0:03:14.36,Default,,0,0,0,,Ей, неге мені өлтірмедің? иә?
Dialogue: 0,0:03:14.36,0:03:16.36,Default,,0,0,0,,А... О, жоқ.
Dialogue: 0,0:03:16.36,0:03:18.36,Default,,0,0,0,,Ахх...
Dialogue: 0,0:03:18.36,0:03:20.36,Default,,0,0,0,,Ой, ой... ой... ой
Dialogue: 0,0:03:20.36,0:03:22.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:22.37,0:03:25.37,Default,,0,0,0,,Хмф, бұл туралы алаңдамаңыз.
Dialogue: 0,0:03:25.37,0:03:27.37,Default,,0,0,0,,Тек алға қара, балам.
Dialogue: 0,0:03:27.37,0:03:29.36,Default,,0,0,0,,Бұл ұрыс алаңы.
Dialogue: 0,0:03:29.36,0:03:32.36,Default,,0,0,0,,А... Бака Ю, не істеп жатырсың?
Dialogue: 0,0:03:32.36,0:03:34.36,Default,,0,0,0,,Мен оны дәл қазір өлтіре алар едім.
Dialogue: 0,0:03:34.36,0:03:37.36,Default,,0,0,0,,Неліктен жын сиқырын іске қоспадыңыз?
Dialogue: 0,0:03:37.36,0:03:40.37,Default,,0,0,0,,Ю-кун, не болды?
Dialogue: 0,0:03:40.37,0:03:43.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:43.37,0:03:45.37,Default,,0,0,0,,Ю-сан
Dialogue: 0,0:03:45.37,0:03:47.36,Default,,0,0,0,,Мика...
Dialogue: 0,0:03:47.36,0:03:49.36,Default,,0,0,0,,Менің отбасым...
Dialogue: 0,0:03:52.36,0:03:54.36,Default,,0,0,0,,Вампирдің ішінде
Dialogue: 0,0:03:54.36,0:03:57.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.37,0:04:00.37,Default,,0,0,0,,Эй, сен Микасың ба?
Dialogue: 0,0:04:04.36,0:04:07.36,Default,,0,0,0,,Ах
Dialogue: 0,0:04:07.36,0:04:09.36,Default,,0,0,0,,Мика Ах
Dialogue: 0,0:04:09.36,0:04:12.37,Default,,0,0,0,,Мика
Dialogue: 0,0:04:12.37,0:04:15.37,Default,,0,0,0,,Хмм... Бұл шынымен Мика.
Dialogue: 0,0:04:15.37,0:04:19.37,Default,,0,0,0,,Ахх... Ю-чан
Dialogue: 0,0:04:19.37,0:04:21.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:21.36,0:04:24.36,Default,,0,0,0,,Бұл сүйкімді көзқарастың мәні неде?
Dialogue: 0,0:04:24.36,0:04:26.36,Default,,0,0,0,,Ностальгиялық Юичиро Хякуя
Dialogue: 0,0:04:26.36,0:04:29.37,Default,,0,0,0,,Сондықтан сіз бұл туралы ерекше болдыңыз.
Dialogue: 0,0:04:29.37,0:04:32.37,Default,,0,0,0,,Бірақ күтпеген тағдырлы кездесу
Dialogue: 0,0:04:32.37,0:04:35.37,Default,,0,0,0,,Мен жылағым келеді
Dialogue: 0,0:04:35.37,0:04:37.37,Default,,0,0,0,,Сонда біз не істейміз?
Dialogue: 0,0:04:37.37,0:04:40.36,Default,,0,0,0,,Ю-чанды адамдар қолданатын шығар.
Dialogue: 0,0:04:40.36,0:04:42.36,Default,,0,0,0,,Әрине сақтаңыз
Dialogue: 0,0:04:42.36,0:04:45.36,Default,,0,0,0,,Ұсқынсыз адамдардың қолынан
Dialogue: 0,0:04:45.36,0:04:47.37,Default,,0,0,0,,О
Dialogue: 0,0:04:47.37,0:04:49.37,Default,,0,0,0,,Бірақ ол да адам.
Dialogue: 0,0:04:49.37,0:04:52.37,Default,,0,0,0,,Адамдар ешқашан бізге қосылмайды.
Dialogue: 0,0:04:52.37,0:04:54.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:54.37,0:04:56.36,Default,,0,0,0,,Иә
Dialogue: 0,0:04:56.36,0:04:59.36,Default,,0,0,0,,Олай болса, Крулдың саған істегенін істе.
Dialogue: 0,0:04:59.36,0:05:02.37,Default,,0,0,0,,Мен Ю-чанды вампирге айналдырамын.
Dialogue: 0,0:05:02.37,0:05:04.37,Default,,0,0,0,,Уф
Dialogue: 0,0:05:06.37,0:05:10.37,Default,,0,0,0,,Ю-чанға тиіссең, мен сені өлтіремін.
Dialogue: 0,0:05:10.37,0:05:12.38,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:05:12.38,0:05:16.36,Default,,0,0,0,,Мен әдеттен тыс қызып кеттім.
Dialogue: 0,0:05:16.36,0:05:20.37,Default,,0,0,0,,Олай болса, мен саған қол ұшын соза аламын ба?
Dialogue: 0,0:05:20.37,0:05:24.37,Default,,0,0,0,,Басқа адамдарға келетін болсақ, мен оларды тоқтатамын.
Dialogue: 0,0:05:24.37,0:05:27.37,Default,,0,0,0,,Сен менің асыл ханшайымымсың
Dialogue: 0,0:05:27.37,0:05:29.37,Default,,0,0,0,,Барып алып кет.
Dialogue: 0,0:05:31.36,0:05:34.36,Default,,0,0,0,,Ю-чан, менің достарым бар.
Dialogue: 0,0:05:34.36,0:05:36.37,Default,,0,0,0,,​​Сен сондай мейірімдісің.
Dialogue: 0,0:05:36.37,0:05:38.37,Default,,0,0,0,,Бірақ сол себепті
Dialogue: 0,0:05:38.37,0:05:42.37,Default,,0,0,0,,Сіз тым мейірімді болғандықтан алданып қалдыңыз.
Dialogue: 0,0:05:42.37,0:05:44.37,Default,,0,0,0,,Адамдар
Dialogue: 0,0:05:44.37,0:05:46.38,Default,,0,0,0,,Достарына қулық жасап жүргендер
Dialogue: 0,0:05:46.38,0:05:48.36,Default,,0,0,0,,Ол өте ашкөз.
Dialogue: 0,0:05:48.36,0:05:50.36,Default,,0,0,0,,Ю-чан
Dialogue: 0,0:05:55.37,0:05:57.37,Default,,0,0,0,,Фуфу
Dialogue: 0,0:05:59.37,0:06:02.38,Default,,0,0,0,,Енді мұны істегіңіз келе ме?
Dialogue: 0,0:06:02.38,0:06:04.38,Default,,0,0,0,,Ю-чаннан басқа адамдар
Dialogue: 0,0:06:04.38,0:06:07.36,Default,,0,0,0,,Олардың барлығын өлтірейік
Dialogue: 0,0:06:07.36,0:06:10.37,Default,,0,0,0,,Маған қоңырау шалғаныңызды естідім.
Dialogue: 0,0:06:10.37,0:06:12.37,Default,,0,0,0,,Жетінші ата
Dialogue: 0,0:06:12.37,0:06:15.37,Default,,0,0,0,,О, мистер Кроули?
Dialogue: 0,0:06:15.37,0:06:17.37,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:06:17.37,0:06:20.38,Default,,0,0,0,,Ол... кішкене айналма жолмен жүрді.
Dialogue: 0,0:06:20.38,0:06:23.36,Default,,0,0,0,,Қызықты немесе жылы нәрсе бар ма?
Dialogue: 0,0:06:23.36,0:06:25.36,Default,,0,0,0,,Иә
Dialogue: 0,0:06:25.36,0:06:27.37,Default,,0,0,0,,Бірақ егер сіз осында болсаңыз
Dialogue: 0,0:06:27.37,0:06:29.37,Default,,0,0,0,,Бұл қазірдің өзінде ойын жинағы.
Dialogue: 0,0:06:29.37,0:06:32.37,Default,,0,0,0,,Жарайды, оларды мал етейік.
Dialogue: 0,0:06:32.37,0:06:34.37,Default,,0,0,0,,Өлтірме, тірідей қолға түсір
Dialogue: 0,0:06:34.37,0:06:37.38,Default,,0,0,0,,Вампирді жою блогын үйге келтіру жобасы
Dialogue: 0,0:06:37.38,0:06:39.36,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:06:39.36,0:06:42.37,Default,,0,0,0,,Шіркін, тектілер тағы көбейді.
Dialogue: 0,0:06:42.37,0:06:44.37,Default,,0,0,0,,Қазір аяқталды.
Dialogue: 0,0:06:44.37,0:06:47.37,Default,,0,0,0,,Барлық мүшелерді шығару жүйесі!
Dialogue: 0,0:06:47.37,0:06:49.37,Default,,0,0,0,,Ах
Dialogue: 0,0:06:49.37,0:06:52.38,Default,,0,0,0,,Бір минут күтіңіз, Мика сонда.
Dialogue: 0,0:06:52.38,0:06:54.38,Default,,0,0,0,,Менің отбасым осында
Dialogue: 0,0:06:54.38,0:06:56.38,Default,,0,0,0,,Демек, бас тарту дегеніміз...
Dialogue: 0,0:06:56.38,0:06:59.37,Default,,0,0,0,,Демек, бұл жерде барлығын союға болмайды дейсіз бе?
Dialogue: 0,0:06:59.37,0:07:01.37,Default,,0,0,0,,Ю-кун га
Dialogue: 0,0:07:03.37,0:07:06.37,Default,,0,0,0,,Иә Юу-сан
Dialogue: 0,0:07:06.37,0:07:08.37,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:07:10.38,0:07:12.38,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,0:07:12.38,0:07:15.38,Default,,0,0,0,,Құрылымды сақтай отырып, екінші қорғаныс сызығына шегініңіз
Dialogue: 0,0:07:18.37,0:07:20.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:20.37,0:07:22.37,Default,,0,0,0,,Мен сенің қашуыңа жол бермеймін.
Dialogue: 0,0:07:22.37,0:07:25.37,Default,,0,0,0,,Жайылма, сен...
Dialogue: 0,0:07:25.37,0:07:28.38,Default,,0,0,0,,Ах
Dialogue: 0,0:07:28.38,0:07:30.38,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:07:30.38,0:07:32.37,Default,,0,0,0,,Не істеп жатырсың, Ю?
Dialogue: 0,0:07:32.37,0:07:34.37,Default,,0,0,0,,Сен, сен!
Dialogue: 0,0:07:38.37,0:07:41.37,Default,,0,0,0,,Сен барып қарап кел.
Dialogue: 0,0:07:41.37,0:07:43.38,Default,,0,0,0,,Иә! Ю-сан
Dialogue: 0,0:07:43.38,0:07:46.38,Default,,0,0,0,,The shitty kid
Dialogue: 0,0:07:46.38,0:07:48.36,Default,,0,0,0,,Подполковник Ну
Dialogue: 0,0:07:48.36,0:07:51.37,Default,,0,0,0,,О, жоқ! Айя?
Dialogue: 0,0:07:51.37,0:07:53.37,Default,,0,0,0,,Бірақ сен әлі жассың
Dialogue: 0,0:07:55.37,0:07:58.37,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:07:58.37,0:08:00.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.38,0:08:02.38,Default,,0,0,0,,Арыстан да
Dialogue: 0,0:08:02.38,0:08:05.38,Default,,0,0,0,,Егер жарақат алсаң, қылыштың сызығы түтіккен болады.
Dialogue: 0,0:08:05.38,0:08:07.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:07.37,0:08:09.37,Default,,0,0,0,,Гленн мырза! Ах
Dialogue: 0,0:08:09.37,0:08:11.37,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:08:16.38,0:08:18.38,Default,,0,0,0,,Джама Ах
Dialogue: 0,0:08:20.38,0:08:22.38,Default,,0,0,0,,Иә, күттім.
Dialogue: 0,0:08:27.37,0:08:29.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:29.37,0:08:31.37,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,0:08:31.37,0:08:33.37,Default,,0,0,0,,Ол да сол бетті жасайды.
Dialogue: 0,0:08:35.38,0:08:37.38,Default,,0,0,0,,Миджу-сан
Dialogue: 0,0:08:37.38,0:08:39.38,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,0:08:39.38,0:08:43.37,Default,,0,0,0,,Қандай жағдай болмасын сені жібермейтін сияқты.
Dialogue: 0,0:08:43.37,0:08:45.37,Default,,0,0,0,,Одан құтылудан басқа амалымыз қалмайды.
Dialogue: 0,0:08:45.37,0:08:47.37,Default,,0,0,0,,Айтуға оңай.
Dialogue: 0,0:08:47.37,0:08:50.38,Default,,0,0,0,,Егер мен мұны істей алсам, мен соншалықты қиындыққа тап болмас едім.
Dialogue: 0,0:08:50.38,0:08:52.38,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:08:52.38,0:08:54.38,Default,,0,0,0,,Мал болудан басқа амалдарың жоқ.
Dialogue: 0,0:08:54.38,0:08:56.38,Default,,0,0,0,,Қарғыс атқыр, бұл солай.
Dialogue: 0,0:09:00.37,0:09:03.37,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:09:06.38,0:09:09.38,Default,,0,0,0,,Ахххх
Dialogue: 0,0:09:09.38,0:09:11.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.38,0:09:16.37,Default,,0,0,0,,Концентрат, уф.
Dialogue: 0,0:09:16.37,0:09:18.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:18.37,0:09:21.37,Default,,0,0,0,,Сіз не істеп жатырсыз? Тіке тұрыңыз... Кешіріңіз.
Dialogue: 0,0:09:21.37,0:09:23.37,Default,,0,0,0,,Біз қайтадан кездестік. Ах!
Dialogue: 0,0:09:28.38,0:09:31.38,Default,,0,0,0,,Мен сені бұл жолы жібермеймін
Dialogue: 0,0:09:31.38,0:09:33.37,Default,,0,0,0,,Қаа! Ах...
Dialogue: 0,0:09:33.37,0:09:35.37,Default,,0,0,0,,Ах... Қарғыс атсын...
Dialogue: 0,0:09:35.37,0:09:37.37,Default,,0,0,0,,Гленн!
Dialogue: 0,0:09:37.37,0:09:39.38,Default,,0,0,0,,Ei
Dialogue: 0,0:09:39.38,0:09:41.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:41.38,0:09:43.38,Default,,0,0,0,,Артында! Ха
Dialogue: 0,0:09:43.38,0:09:45.38,Default,,0,0,0,,Ах
Dialogue: 0,0:09:45.38,0:09:47.38,Default,,0,0,0,,Алдымен сізден дәм татайық
Dialogue: 0,0:09:47.38,0:09:49.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:52.37,0:09:55.37,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:09:57.38,0:10:00.38,Default,,0,0,0,,Аға, бұлай ашуланба.
Dialogue: 0,0:10:02.38,0:10:05.38,Default,,0,0,0,,Бұл сүйкімді әзіл емес пе?
Dialogue: 0,0:10:05.38,0:10:07.37,Default,,0,0,0,,Мика
Dialogue: 0,0:10:07.37,0:10:09.37,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:10:09.37,0:10:11.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.37,0:10:14.38,Default,,0,0,0,,Юу-чан, бәрін таста да, менімен бірге қаш
Dialogue: 0,0:10:14.38,0:10:17.38,Default,,0,0,0,,Иә? Қашып кету дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:17.38,0:10:20.38,Default,,0,0,0,,Неліктен сіз бұл вампирмен біргесіз?
Dialogue: 0,0:10:20.38,0:10:22.38,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:10:22.38,0:10:24.37,Default,,0,0,0,,Уф
Dialogue: 0,0:10:24.37,0:10:26.37,Default,,0,0,0,,Ю-сан
Dialogue: 0,0:10:26.37,0:10:29.38,Default,,0,0,0,,Уф, сіз басқа жаққа қарай алмайсыз.
Dialogue: 0,0:10:29.38,0:10:31.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:33.38,0:10:35.38,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,0:10:35.38,0:10:37.38,Default,,0,0,0,,Ақымақ болма, Мика.
Dialogue: 0,0:10:37.38,0:10:39.39,Default,,0,0,0,,Не болып жатқанын түсіндіріңіз.
Dialogue: 0,0:10:39.39,0:10:41.37,Default,,0,0,0,,Ю-чан ол жерде болмауы керек.
Dialogue: 0,0:10:41.37,0:10:43.37,Default,,0,0,0,,Адамдар пайдаланады
Dialogue: 0,0:10:43.37,0:10:45.37,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:45.37,0:10:47.38,Default,,0,0,0,,Жарайды, бір секундқа тоқтаңыз.
Dialogue: 0,0:10:47.38,0:10:49.38,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:10:53.38,0:10:55.38,Default,,0,0,0,,«Адамдар пайдаланады»?
Dialogue: 0,0:10:55.38,0:10:57.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:57.39,0:10:59.39,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:15.39,0:11:17.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:17.39,0:11:20.39,Default,,0,0,0,,Сен енді адам емессің бе?
Dialogue: 0,0:11:20.39,0:11:23.40,Default,,0,0,0,,А, бұл менің кінәм бе?
Dialogue: 0,0:11:23.40,0:11:25.40,Default,,0,0,0,,Өйткені мен қашып кеттім
Dialogue: 0,0:11:25.40,0:11:27.40,Default,,0,0,0,,Жоқ, Ю-чан жаман емес.
Dialogue: 0,0:11:27.40,0:11:29.40,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:11:29.40,0:11:32.40,Default,,0,0,0,,Жарайды, кеттік. Бұл жерде қауіпті.
Dialogue: 0,0:11:36.39,0:11:40.40,Default,,0,0,0,,Ю-чан өтінемін
Dialogue: 0,0:11:40.40,0:11:43.40,Default,,0,0,0,,А, мен алмаймын, Мика.
Dialogue: 0,0:11:43.40,0:11:46.40,Default,,0,0,0,,Мен бара алмаймын, достарым
Dialogue: 0,0:11:46.40,0:11:48.39,Default,,0,0,0,,Жоқ, бұл дос емес.
Dialogue: 0,0:11:48.39,0:11:50.39,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:11:50.39,0:11:54.39,Default,,0,0,0,,Ю-чан, адамдар сені пайдаланып жатыр...
Dialogue: 0,0:11:54.39,0:11:56.40,Default,,0,0,0,,Шиноа-сан ха
Dialogue: 0,0:11:56.40,0:11:59.40,Default,,0,0,0,,Ha
Dialogue: 0,0:11:59.40,0:12:01.40,Default,,0,0,0,,Йотаро мен оның серіктері Каирға келді
Dialogue: 0,0:12:01.40,0:12:03.40,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:12:03.40,0:12:05.39,Default,,0,0,0,,Шиноа! Ах
Dialogue: 0,0:12:05.39,0:12:08.39,Default,,0,0,0,,Өтінемін, Ю-чан, артыңа қарама.
Dialogue: 0,0:12:08.39,0:12:11.39,Default,,0,0,0,,Артымда ештеңе жоқ, артымда ештеңе жоқ.
Dialogue: 0,0:12:11.39,0:12:13.40,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:12:13.40,0:12:15.40,Default,,0,0,0,,Ах
Dialogue: 0,0:12:15.40,0:12:17.40,Default,,0,0,0,,Жібер!
Dialogue: 0,0:12:17.40,0:12:20.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.40,0:12:22.39,Default,,0,0,0,,Ю-чан
Dialogue: 0,0:12:22.39,0:12:25.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:25.39,0:12:27.39,Default,,0,0,0,,Жібер
Dialogue: 0,0:12:27.39,0:12:29.39,Default,,0,0,0,,Барма, Ю-чан
Dialogue: 0,0:12:29.39,0:12:31.40,Default,,0,0,0,,Жібер!
Dialogue: 0,0:12:31.40,0:12:33.40,Default,,0,0,0,,Барма.
Dialogue: 0,0:12:33.40,0:12:36.40,Default,,0,0,0,,Олар жай ғана сізді пайдаланып қалуға тырысуда.
Dialogue: 0,0:12:36.40,0:12:39.40,Default,,0,0,0,,​​О, жоқ!
Dialogue: 0,0:12:39.40,0:12:41.39,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:41.39,0:12:45.39,Default,,0,0,0,,Менімен бірге барайық, Ю-чан
Dialogue: 0,0:12:45.39,0:12:47.40,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:12:47.40,0:12:51.40,Default,,0,0,0,,Шу!
Dialogue: 0,0:12:51.40,0:12:53.40,Default,,0,0,0,,Ha
Dialogue: 0,0:12:53.40,0:12:55.40,Default,,0,0,0,,Кукуку… Юу-сан
Dialogue: 0,0:12:55.40,0:12:57.39,Default,,0,0,0,,Қашу…
Dialogue: 0,0:12:57.39,0:13:00.39,Default,,0,0,0,,Әй, мал сөйлемейді.
Dialogue: 0,0:13:00.39,0:13:02.39,Default,,0,0,0,,Тоқтатыңыз, тоқтатыңыз.
Dialogue: 0,0:13:02.39,0:13:05.39,Default,,0,0,0,,Бұл енді мүмкін емес, Ю-чан, бас тарт.
Dialogue: 0,0:13:09.40,0:13:11.40,Default,,0,0,0,,Хааа аа
Dialogue: 0,0:13:14.39,0:13:16.39,Default,,0,0,0,,Ах
Dialogue: 0,0:13:16.39,0:13:18.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:18.39,0:13:23.40,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:13:23.40,0:13:25.40,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:13:25.40,0:13:27.40,Default,,0,0,0,,Ааа аа
Dialogue: 0,0:13:27.40,0:13:29.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:29.40,0:13:31.40,Default,,0,0,0,,Ю-чан
Dialogue: 0,0:13:36.39,0:13:38.39,Default,,0,0,0,,Ах
Dialogue: 0,0:13:40.40,0:13:42.40,Default,,0,0,0,,Ha
Dialogue: 0,0:13:59.40,0:14:01.40,Default,,0,0,0,,Эй Асурамару
Dialogue: 0,0:14:01.40,0:14:03.41,Default,,0,0,0,,Хмм, не?
Dialogue: 0,0:14:03.41,0:14:05.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:05.41,0:14:08.39,Default,,0,0,0,,Мені басып алмақшысың ба?
Dialogue: 0,0:14:08.39,0:14:12.40,Default,,0,0,0,,Жоқ, мен ештеңе істеген жоқпын.
Dialogue: 0,0:14:12.40,0:14:14.40,Default,,0,0,0,,Бірақ бұл мәселе.
Dialogue: 0,0:14:14.40,0:14:17.40,Default,,0,0,0,,Әй? Мен ешқашан бұл мен болады деп ойламадым
Dialogue: 0,0:14:17.40,0:14:20.41,Default,,0,0,0,,Жынға түскен адамдар құбыжық сияқты.
Dialogue: 0,0:14:20.41,0:14:23.39,Default,,0,0,0,,Мен ешқашан қорқатынымды білмедім.
Dialogue: 0,0:14:23.39,0:14:25.39,Default,,0,0,0,,Мына аспанға қарашы
Dialogue: 0,0:14:25.39,0:14:28.40,Default,,0,0,0,,Қарғыс атқан дүниені нұрландырғандай
Dialogue: 0,0:14:28.40,0:14:30.40,Default,,0,0,0,,Төбе ашыла бастады.
Dialogue: 0,0:14:30.40,0:14:32.40,Default,,0,0,0,,Эй Ю
Dialogue: 0,0:14:32.40,0:14:34.40,Default,,0,0,0,,Мика дұрыс айтады.
Dialogue: 0,0:14:34.40,0:14:36.40,Default,,0,0,0,,Егер әлі уақыт болса
Dialogue: 0,0:14:36.40,0:14:39.41,Default,,0,0,0,,Екеумізге де адамнан қашқанымыз жақсы.
Dialogue: 0,0:14:39.41,0:14:42.39,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:14:42.39,0:14:45.40,Default,,0,0,0,,Мен жалғыз бола алмаймын... Уф
Dialogue: 0,0:14:45.40,0:14:47.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:01.40,0:15:03.40,Default,,0,0,0,,Тым кеш сияқты
Dialogue: 0,0:15:10.41,0:15:13.41,Default,,0,0,0,,Сіздің адам емес бөлігіңіз жабайы бола бастайды
Dialogue: 0,0:15:15.39,0:15:17.40,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:15:17.40,0:15:19.40,Default,,0,0,0,,Ах
Dialogue: 0,0:15:19.40,0:15:21.40,Default,,0,0,0,,(Шыңғыр) Увааах! (Арбалар) Эйк!
Dialogue: 0,0:15:21.40,0:15:25.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:25.40,0:15:28.41,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:15:28.41,0:15:30.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:30.41,0:15:33.39,Default,,0,0,0,,Уууууу... ах
Dialogue: 0,0:15:33.39,0:15:35.40,Default,,0,0,0,,Хехехе басталды
Dialogue: 0,0:15:35.40,0:15:38.40,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:15:38.40,0:15:41.40,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:15:41.40,0:15:45.41,Default,,0,0,0,,Уау, уау!
Dialogue: 0,0:15:45.41,0:15:48.41,Default,,0,0,0,,Өйткені, адамдар - Ю-чан.
Dialogue: 0,0:15:50.40,0:15:52.40,Default,,0,0,0,,Жоқ, Ю-чан
Dialogue: 0,0:15:52.40,0:15:54.40,Default,,0,0,0,,Менімен...
Dialogue: 0,0:16:06.39,0:16:08.40,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:16:08.40,0:16:10.40,Default,,0,0,0,,Ах
Dialogue: 0,0:16:11.40,0:16:13.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.41,0:16:24.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:24.40,0:16:27.40,Default,,0,0,0,,Ең алдымен солай болды...
Dialogue: 0,0:16:29.40,0:16:31.40,Default,,0,0,0,,Уф
Dialogue: 0,0:16:33.40,0:16:35.40,Default,,0,0,0,,А, а?
Dialogue: 0,0:16:38.41,0:16:40.41,Default,,0,0,0,,Хью
Dialogue: 0,0:16:46.40,0:16:48.40,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:16:48.40,0:16:50.41,Default,,0,0,0,,О
Dialogue: 0,0:16:50.41,0:16:52.41,Default,,0,0,0,,Бұл белгіде көрсетілмеген ғой, иә?
Dialogue: 0,0:17:04.40,0:17:06.40,Default,,0,0,0,,Ю-чан
Dialogue: 0,0:17:06.40,0:17:08.41,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:17:08.41,0:17:10.41,Default,,0,0,0,,Менің киімім лас.
Dialogue: 0,0:17:16.40,0:17:18.40,Default,,0,0,0,,Уф уау
Dialogue: 0,0:17:18.40,0:17:20.40,Default,,0,0,0,,На
Dialogue: 0,0:17:39.40,0:17:42.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:42.41,0:17:44.41,Default,,0,0,0,,Ha
Dialogue: 0,0:17:44.41,0:17:46.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:48.41,0:17:50.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:54.40,0:17:57.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:57.41,0:18:01.41,Default,,0,0,0,,Адамдар қорқынышты құбыжықтар жасайды.
Dialogue: 0,0:18:01.41,0:18:03.41,Default,,0,0,0,,Біз не істеуіміз керек? Ферид-кун аа...
Dialogue: 0,0:18:03.41,0:18:07.40,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:18:07.40,0:18:09.40,Default,,0,0,0,,Келіңіздер, бұл не деп ойлаймын.
Dialogue: 0,0:18:13.40,0:18:17.41,Default,,0,0,0,,Сіздердің көпшілігіңіз адам эксперименттерін жақсы меңгересіздер, солай емес пе?
Dialogue: 0,0:18:17.41,0:18:20.41,Default,,0,0,0,,Әй, бұл шексіз тілек
Dialogue: 0,0:18:20.41,0:18:22.41,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:18:26.40,0:18:28.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.40,0:18:30.41,Default,,0,0,0,,Менің атым Ая Цуидзи
Dialogue: 0,0:18:30.41,0:18:33.41,Default,,0,0,0,,Шынымды айтсам, мен қорқамын.
Dialogue: 0,0:18:33.41,0:18:37.41,Default,,0,0,0,,Оның үстіне сіз оны үнемі басқара алмайсыз.
Dialogue: 0,0:18:37.41,0:18:39.41,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:42.40,0:18:44.40,Default,,0,0,0,,Ууу цу цу цуцу...
Dialogue: 0,0:18:44.40,0:18:46.40,Default,,0,0,0,,Цуцу... күнәкар
Dialogue: 0,0:18:46.40,0:18:48.41,Default,,0,0,0,,Күнәһар
Dialogue: 0,0:18:48.41,0:18:51.41,Default,,0,0,0,,Барлығы, барлығы, барлығы, барлығын өлтіріңіз.
Dialogue: 0,0:18:51.41,0:18:53.41,Default,,0,0,0,,Ha
Dialogue: 0,0:18:53.41,0:18:55.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:55.41,0:18:57.42,Default,,0,0,0,,Шиноа Ха
Dialogue: 0,0:18:57.42,0:19:00.40,Default,,0,0,0,,Егер сіз бірдеңе жасасаңыз, қазіргі Ю қайта оралуы мүмкін.
Dialogue: 0,0:19:00.40,0:19:02.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:06.41,0:19:08.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:11.41,0:19:13.41,Default,,0,0,0,,Ах
Dialogue: 0,0:19:18.40,0:19:21.41,Default,,0,0,0,,Уф... аа
Dialogue: 0,0:19:21.41,0:19:24.41,Default,,0,0,0,,Ах
Dialogue: 0,0:19:24.41,0:19:27.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:27.41,0:19:29.41,Default,,0,0,0,,Жоқ, Ю-чан
Dialogue: 0,0:19:29.41,0:19:31.41,Default,,0,0,0,,Адамдарды өлтіріңіз
Dialogue: 0,0:19:34.40,0:19:37.41,Default,,0,0,0,,А... сен...
Dialogue: 0,0:19:37.41,0:19:39.41,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:39.41,0:19:41.41,Default,,0,0,0,,Үніңді жап, адам.
Dialogue: 0,0:19:41.41,0:19:44.41,Default,,0,0,0,,Сіз Ю-чанды пайдаланып жатырсыз!
Dialogue: 0,0:19:44.41,0:19:46.41,Default,,0,0,0,,Құт
Dialogue: 0,0:19:46.41,0:19:50.42,Default,,0,0,0,,Ей, жара жазылмайды.
Dialogue: 0,0:19:50.42,0:19:53.40,Default,,0,0,0,,Барлығы... оларды өлтіріңіз.
Dialogue: 0,0:19:53.40,0:19:56.41,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:19:56.41,0:19:58.41,Default,,0,0,0,,Ах... Шиноа!
Dialogue: 0,0:19:58.41,0:20:00.41,Default,,0,0,0,,А, тезірек.
Dialogue: 0,0:20:00.41,0:20:02.41,Default,,0,0,0,,Барлығы өледі.
Dialogue: 0,0:20:02.41,0:20:04.41,Default,,0,0,0,,Шиноа!
Dialogue: 0,0:20:09.40,0:20:11.40,Default,,0,0,0,,Дат
Dialogue: 0,0:20:13.41,0:20:15.41,Default,,0,0,0,,Ю... Ю-сан, өтінемін.
Dialogue: 0,0:20:15.41,0:20:18.41,Default,,0,0,0,,Өздеріңізге оралыңыз.
Dialogue: 0,0:20:18.41,0:20:21.42,Default,,0,0,0,,Ю-чанға кір қолдарыңды тигізбе!
Dialogue: 0,0:20:21.42,0:20:25.40,Default,,0,0,0,,Ю-сан! Ааа!
Dialogue: 0,0:20:25.40,0:20:27.41,Default,,0,0,0,,Ааа!
Dialogue: 0,0:20:27.41,0:20:29.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:29.41,0:20:31.41,Default,,0,0,0,,Уау, уау...
Dialogue: 0,0:20:31.41,0:20:34.41,Default,,0,0,0,,Уау! Хаха өтінемін
Dialogue: 0,0:20:34.41,0:20:37.42,Default,,0,0,0,,Ю-сан! Апыр-ай!
Dialogue: 0,0:20:37.42,0:20:39.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:39.42,0:20:41.42,Default,,0,0,0,,Ю-сан!
Dialogue: 0,0:20:47.41,0:20:51.41,Default,,0,0,0,,Уф
Dialogue: 0,0:20:51.41,0:20:53.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:57.42,0:21:00.42,Default,,0,0,0,,Ю-сан? Ю-сан!
Dialogue: 0,0:21:06.41,0:21:09.41,Default,,0,0,0,,Ю-сан…
Dialogue: 0,0:21:09.41,0:21:14.42,Default,,0,0,0,,Адамдар...
Dialogue: 0,0:21:14.42,0:21:16.42,Default,,0,0,0,,Смоуки, кет мұнан!
Dialogue: 0,0:21:16.42,0:21:19.41,Default,,0,0,0,,Бұл керемет туынды.
Dialogue: 0,0:21:19.41,0:21:21.41,Default,,0,0,0,,Бұл – менің қолжазбам.
Dialogue: 0,0:21:21.41,0:21:24.41,Default,,0,0,0,,Бірақ нәтиже болмады.
Dialogue: 0,0:21:24.41,0:21:26.41,Default,,0,0,0,,Жоқ, ол шықты.
Dialogue: 0,0:21:26.41,0:21:30.42,Default,,0,0,0,,Біз тек уақытты ұтып жатырмыз.
Dialogue: 0,0:21:30.42,0:21:32.42,Default,,0,0,0,,Ах
Dialogue: 0,0:21:38.41,0:21:40.41,Default,,0,0,0,,Ой, мен білдім
Dialogue: 0,0:21:40.41,0:21:42.41,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,0:21:42.41,0:21:44.42,Default,,0,0,0,,Жауды еніп өтіңіз
Dialogue: 0,0:21:44.42,0:21:46.42,Default,,0,0,0,,Бяккомару
Dialogue: 0,0:21:46.42,0:21:49.42,Default,,0,0,0,,А, Гленнді ұрмаңыз.
Dialogue: 0,0:21:49.42,0:21:51.42,Default,,0,0,0,,Зудон
Dialogue: 0,0:21:55.41,0:21:57.41,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:22:01.42,0:22:03.42,Default,,0,0,0,,Иә
Dialogue: 0,0:22:03.42,0:22:05.42,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:22:05.42,0:22:08.42,Default,,0,0,0,,Егер оның кеңесі болмаса, мен өліп қалуым мүмкін еді.
Dialogue: 0,0:22:19.42,0:22:21.42,Default,,0,0,0,,Мынау
Dialogue: 0,0:22:23.42,0:22:26.41,Default,,0,0,0,,Филиал отбасының мазақтары үшін жақсы.
Dialogue: 0,0:22:26.41,0:22:29.41,Default,,0,0,0,,Подполковник Ичиноза...
Dialogue: 0,0:22:29.41,0:22:33.41,Default,,0,0,0,,Қалғанын Хиираги отбасы алады.
Dialogue: 0,0:22:33.41,0:22:37.42,Default,,0,0,0,,Барайық, асылдарды тірідей қолға түсірейік.
Dialogue: 0,0:22:37.42,0:22:41.42,Default,,0,0,0,,Адамдарға, Жапон императорлық жындар армиясына
Dialogue: 0,0:22:41.42,0:22:44.41,Default,,0,0,0,,Бізге, Хийраги отбасына қарсы шыққандар не болады?
Dialogue: 0,0:22:44.41,0:22:47.41,Default,,0,0,0,,Сүйегімнің өзегіне дейін есіме түсіруім керек.
Dialogue: 0,0:22:50.35,0:22:52.35,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:22:53.85,0:22:58.85,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
