Dialogue: 0,1:50:31.95,1:50:35.96,Default,,0,0,0,,♬ Мен болашақты көре аламын
Dialogue: 0,1:50:35.96,1:50:38.96,Default,,0,0,0,,♬ Сіздің көзіңізде
Dialogue: 0,1:50:38.96,1:50:42.97,Default,,0,0,0,,♬ Аспанның көгілдірлігі
Dialogue: 0,1:50:42.97,1:50:48.97,Default,,0,0,0,,♬ Ол пайда болған сайын
Dialogue: 0,1:50:48.97,1:50:54.98,Default,,0,0,0,,♬ Аспанда нөлдік жойғыш ұшады
Dialogue: 0,1:50:54.98,1:50:59.92,Default,,0,0,0,,♬ Алыстан
Dialogue: 0,1:50:59.92,1:51:02.92,Default,,0,0,0,,♬ Біз осындамыз
Dialogue: 0,1:51:02.92,1:51:06.92,Default,,0,0,0,,♬ Кездесуіңіз мүмкін
Dialogue: 0,1:51:06.92,1:51:10.93,Default,,0,0,0,,♬ Міндетті түрде шешілді
Dialogue: 0,1:51:10.93,1:51:16.93,Default,,0,0,0,,♬ Махаббат туралы мыңдаған естеліктер
Dialogue: 0,1:51:16.93,1:51:22.94,Default,,0,0,0,,♬ Соған қарай жүрейік
Dialogue: 0,1:51:22.94,1:51:31.95,Default,,0,0,0,,♬ Мен сені мәңгілікке қорғаймын
Dialogue: 0,1:51:31.95,1:51:37.95,Default,,0,0,0,,♬ Біздің тарихымыз басталады
Dialogue: 0,1:51:37.95,1:51:41.96,Default,,0,0,0,,♬ О, тағдыр
Dialogue: 0,1:51:41.96,1:51:44.96,Default,,0,0,0,,♬ Осы жерден
Dialogue: 0,1:51:44.96,1:51:47.96,Default,,0,0,0,,♬ Қайда?
Dialogue: 0,1:51:47.96,1:51:53.97,Default,,0,0,0,,♬ Кеттік
Dialogue: 0,1:51:53.97,1:51:56.97,Default,,0,0,0,,♬ Бұлттарға сызылған
Dialogue: 0,1:51:56.97,1:52:00.91,Default,,0,0,0,,♬ Ақ уәде
