Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.10,0:00:10.44,Default,,0,0,0,,Жоғары көтерілу
Dialogue: 0,0:00:22.08,0:00:23.08,Default,,0,0,0,,Не?
Dialogue: 0,0:00:23.72,0:00:24.94,Default,,0,0,0,,раушан
Dialogue: 0,0:00:29.10,0:00:30.26,Default,,0,0,0,,Отшашу
Dialogue: 0,0:00:31.96,0:00:32.82,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:00:34.10,0:00:35.08,Default,,0,0,0,,алыс
Dialogue: 0,0:00:39.90,0:00:40.92,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:02:25.64,0:02:27.08,Default,,0,0,0,,Кім білсін? Мүмкін мені өлі дене деп ойлаған шығар.
Dialogue: 0,0:02:28.08,0:02:30.34,Default,,0,0,0,,Сіз де қарақшылардың бірісіз бе?
Dialogue: 0,0:02:30.34,0:02:34.94,Default,,0,0,0,,Мен сол баламен бірге саудада адасып қалдым.
Dialogue: 0,0:02:34.94,0:02:36.96,Default,,0,0,0,,Ал, ертерек отшашу туралы не айтасыз?
Dialogue: 0,0:02:37.50,0:02:40.02,Default,,0,0,0,,Серіктеріңізге осы кеменің орналасқан жерін айтыңыз.
Dialogue: 0,0:02:40.02,0:02:41.30,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:41.60,0:02:44.60,Default,,0,0,0,,Оларды келмей тұрып, тез өлтіріңіз.
Dialogue: 0,0:02:44.61,0:02:45.70,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:45.70,0:02:48.44,Default,,0,0,0,,Мен қолыммен, мойныммен және т.б.
Dialogue: 0,0:02:48.44,0:02:50.78,Default,,0,0,0,,Жүніс – тек Жүніс
Dialogue: 0,0:02:57.66,0:02:59.18,Default,,0,0,0,,Тоқта
Dialogue: 0,0:03:09.60,0:03:11.60,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:12.56,0:03:14.48,Default,,0,0,0,,Бір нәрсені жөнелту деген нені білдіреді?
Dialogue: 0,0:03:14.48,0:03:15.98,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:03:15.98,0:03:16.96,Default,,0,0,0,,Еха
Dialogue: 0,0:03:16.96,0:03:18.88,Default,,0,0,0,,О, сен
Dialogue: 0,0:03:18.88,0:03:21.52,Default,,0,0,0,,Ол осы уақытқа дейін көптеген кемелерді суға батырды.
Dialogue: 0,0:03:21.52,0:03:23.70,Default,,0,0,0,,Ұшатын қарақшы
Dialogue: 0,0:03:23.92,0:03:28.20,Default,,0,0,0,,Бұндай нәрселерге тым жақындамаған дұрыс.
Dialogue: 0,0:03:28.62,0:03:30.28,Default,,0,0,0,,Өлтіру
Dialogue: 0,0:03:32.80,0:03:37.42,Default,,0,0,0,,Мен оған зиян келтірген саған көмектесе алмаймын.
Dialogue: 0,0:03:37.42,0:03:40.56,Default,,0,0,0,,Мен әулие емеспін.
Dialogue: 0,0:03:49.90,0:03:52.36,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:03:55.78,0:04:00.52,Default,,0,0,0,,Өйткені, Джэ-хада айдаһардың күші бар.
Dialogue: 0,0:04:00.72,0:04:02.42,Default,,0,0,0,,Керемет күш
Dialogue: 0,0:04:03.30,0:04:06.52,Default,,0,0,0,,айырбас ретінде мен...
Dialogue: 0,0:04:09.22,0:04:11.76,Default,,0,0,0,,Юн Юн
Dialogue: 0,0:04:11.76,0:04:12.90,Default,,0,0,0,,Жүніс
Dialogue: 0,0:04:12.90,0:04:14.20,Default,,0,0,0,,Юн
Dialogue: 0,0:04:15.38,0:04:18.12,Default,,0,0,0,,Жүніс, сен жылап тұрсың ба?
Dialogue: 0,0:04:18.72,0:04:20.42,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:04:22.94,0:04:24.32,Default,,0,0,0,,Жүніс
Dialogue: 0,0:04:24.58,0:04:26.60,Default,,0,0,0,,Сізге көп соққы болды.
Dialogue: 0,0:04:27.92,0:04:29.00,Default,,0,0,0,,Юн
Dialogue: 0,0:04:30.60,0:04:33.26,Default,,0,0,0,,Тірі екеніңізге қуаныштымын.
Dialogue: 0,0:04:34.68,0:04:38.68,Default,,0,0,0,,Жүніс мүсәпір емес пе?
Dialogue: 0,0:04:40.26,0:04:41.70,Default,,0,0,0,,Бақылау мүмкін емес
Dialogue: 0,0:04:42.38,0:04:45.68,Default,,0,0,0,,Мен Йонаны қорғай алмаймын
Dialogue: 0,0:04:46.92,0:04:49.82,Default,,0,0,0,,Мен Юнның арқасында жетістікке жеттім.
Dialogue: 0,0:04:50.62,0:04:53.30,Default,,0,0,0,,Юн сөзсіз данышпан.
Dialogue: 0,0:04:54.48,0:04:57.42,Default,,0,0,0,,Мен данышпан емеспін
Dialogue: 0,0:04:58.30,0:05:00.98,Default,,0,0,0,,Таңғажайып нәрсе – Жүніс.
Dialogue: 0,0:05:02.22,0:05:04.16,Default,,0,0,0,,Біз мұны жасадық!
Dialogue: 0,0:05:07.90,0:05:09.30,Default,,0,0,0,,бірақ бұл қауіпті.
Dialogue: 0,0:05:12.84,0:05:13.92,Default,,0,0,0,,Жалдамалы
Dialogue: 0,0:05:17.84,0:05:18.86,Default,,0,0,0,,Йона Чан
Dialogue: 0,0:05:25.56,0:05:26.76,Default,,0,0,0,,Шина
Dialogue: 0,0:05:32.28,0:05:33.46,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:05:35.84,0:05:37.66,Default,,0,0,0,,Шин-ах та келді.
Dialogue: 0,0:05:38.76,0:05:40.70,Default,,0,0,0,,Мен найзағай аңы келе жатыр деп ойладым.
Dialogue: 0,0:05:43.16,0:05:45.80,Default,,0,0,0,,Хаку маңызды күш болып табылады.
Dialogue: 0,0:05:45.80,0:05:49.65,Default,,0,0,0,,Мұнда ұша алатын мен, түнде көретін Шин-ах келді.
Dialogue: 0,0:05:52.64,0:05:53.78,Default,,0,0,0,,Отшашу
Dialogue: 0,0:05:56.16,0:05:57.20,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:05:58.60,0:05:59.66,Default,,0,0,0,,алыс
Dialogue: 0,0:06:03.28,0:06:04.48,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:06:05.63,0:06:06.68,Default,,0,0,0,,Иеха
Dialogue: 0,0:06:06.68,0:06:07.80,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:11.04,0:06:13.21,Default,,0,0,0,,Мидорю шаршады.
Dialogue: 0,0:06:13.21,0:06:14.39,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:16.32,0:06:19.50,Default,,0,0,0,,Тек қызды құшақтап ұшпа
Dialogue: 0,0:06:21.60,0:06:27.56,Default,,0,0,0,,Екеуі осында бар күшімен келгісі келетініне сенімдімін.
Dialogue: 0,0:06:28.68,0:06:31.16,Default,,0,0,0,,Ақ жылан, сен не істеп жатырсың?
Dialogue: 0,0:06:31.16,0:06:34.06,Default,,0,0,0,,Баяулатқан сенсің.
Dialogue: 0,0:06:34.06,0:06:36.20,Default,,0,0,0,,Бұл соншалықты ұйқышыл
Dialogue: 0,0:06:36.20,0:06:38.40,Default,,0,0,0,,Өлтірмеуге тырысу
Dialogue: 0,0:06:42.86,0:06:46.76,Default,,0,0,0,,Иә, бұл сіздің айуандық қаруыңыз емес.
Dialogue: 0,0:06:46.76,0:06:49.32,Default,,0,0,0,,Бірақ ол оны кеспейді.
Dialogue: 0,0:06:52.98,0:06:58.18,Default,,0,0,0,,Сенің ыңғайсыз екеніңді білемін, бірақ осында қалатын болсаң, жұмысыңды дұрыс істе.
Dialogue: 0,0:06:58.56,0:07:01.76,Default,,0,0,0,,Осылай жасасаң, қолың жынды болады.
Dialogue: 0,0:07:02.46,0:07:03.75,Default,,0,0,0,,Бұлай етпеңіз, кемпір
Dialogue: 0,0:07:07.18,0:07:11.23,Default,,0,0,0,,Менің достарымның арасында тек сен ғана денсаулықсың.
Dialogue: 0,0:07:12.36,0:07:15.22,Default,,0,0,0,,Капитан - ең жігерлі.
Dialogue: 0,0:07:15.74,0:07:19.04,Default,,0,0,0,,Жаудың күші екі еседен астамға қысқарды.
Dialogue: 0,0:07:19.04,0:07:21.98,Default,,0,0,0,,Енді Кумжиді сыртқа сүйреңіз
Dialogue: 0,0:07:22.80,0:07:25.84,Default,,0,0,0,,Бұл шайқас сіз Кумжиді ұрсаңыз аяқталады.
Dialogue: 0,0:07:27.04,0:07:28.32,Default,,0,0,0,,Егер сіз мұны істей алсаңыз
Dialogue: 0,0:07:28.32,0:07:31.76,Default,,0,0,0,,Сол қызға көмектес, оны қызықтыр, қалағаныңды істе.
Dialogue: 0,0:07:31.76,0:07:32.98,Default,,0,0,0,,әуре
Dialogue: 0,0:07:32.98,0:07:34.70,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:07:34.70,0:07:37.28,Default,,0,0,0,,Біз ханшайымның адал қызметшілеріміз
Dialogue: 0,0:07:37.28,0:07:38.68,Default,,0,0,0,,Бұл да жақсы болуы мүмкін.
Dialogue: 0,0:07:38.68,0:07:39.80,Default,,0,0,0,,Хаку
Dialogue: 0,0:07:39.80,0:07:40.89,Default,,0,0,0,,бірақ бұл қауіпті.
Dialogue: 0,0:07:44.02,0:07:45.50,Default,,0,0,0,,Мен қызып кеттім
Dialogue: 0,0:07:45.50,0:07:46.72,Default,,0,0,0,,№.
Dialogue: 0,0:08:18.64,0:08:20.24,Default,,0,0,0,,Джеха, жақсысың ба?
Dialogue: 0,0:08:20.70,0:08:23.76,Default,,0,0,0,,Қалған екі кемені суға батырсақ, ұтамыз.
Dialogue: 0,0:08:36.58,0:08:37.60,Default,,0,0,0,,Иеха
Dialogue: 0,0:08:45.22,0:08:48.02,Default,,0,0,0,,Жаныңыздағы кемедегі жалдамалылармен қиналып жатырсыз.
Dialogue: 0,0:08:48.46,0:08:50.22,Default,,0,0,0,,Кумжи қайда?
Dialogue: 0,0:08:50.22,0:08:53.09,Default,,0,0,0,,Өнімнің жанында екеніңізге күмән жоқ.
Dialogue: 0,0:08:53.09,0:08:54.24,Default,,0,0,0,,Жақын жерде
Dialogue: 0,0:08:55.20,0:08:57.10,Default,,0,0,0,,Егер бұл кеме болмаса
Dialogue: 0,0:09:02.08,0:09:05.36,Default,,0,0,0,,Бұл кемедегі жалдамалылардың саны әдеттен тыс.
Dialogue: 0,0:09:11.50,0:09:15.70,Default,,0,0,0,,Геумжи мырза, тіпті төртінші жалдамалы бөлімше де жойылды.
Dialogue: 0,0:09:15.70,0:09:19.10,Default,,0,0,0,,Қарақшылардың көпшілігі де қозғала алмайтын сияқты.
Dialogue: 0,0:09:19.10,0:09:23.44,Default,,0,0,0,,Құбыжықтай жігіттер кемелерді бірінен соң бірі суға батыруда...
Dialogue: 0,0:09:23.44,0:09:25.10,Default,,0,0,0,,Өнімдер...
Dialogue: 0,0:09:25.60,0:09:27.06,Default,,0,0,0,,Не?
Dialogue: 0,0:09:27.26,0:09:32.54,Default,,0,0,0,,Сауда кемелерін де қарақшылар басып алады
Dialogue: 0,0:09:33.40,0:09:35.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:35.48,0:09:37.82,Default,,0,0,0,,Қыздарды сатудан алыс
Dialogue: 0,0:09:37.82,0:09:41.16,Default,,0,0,0,,Сондықтан оны кепілге ала алмадың.
Dialogue: 0,0:09:41.16,0:09:42.58,Default,,0,0,0,,Иә
Dialogue: 0,0:09:45.00,0:09:48.06,Default,,0,0,0,,Ку Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:09:48.06,0:09:52.20,Default,,0,0,0,,Өнімнің ішіндегі біреу қарақшыларды басқарған сияқты.
Dialogue: 0,0:09:52.20,0:09:54.90,Default,,0,0,0,,Маған бір сәтте шабуыл жасалған сияқты.
Dialogue: 0,0:09:54.90,0:09:56.92,Default,,0,0,0,,Өнімнің ішінде
Dialogue: 0,0:09:58.28,0:09:59.82,Default,,0,0,0,,Сол қыз.
Dialogue: 0,0:10:00.32,0:10:01.96,Default,,0,0,0,,Шашым қатты қатайып қалады, сондықтан шомылғым келмейді.
Dialogue: 0,0:10:01.96,0:10:06.28,Default,,0,0,0,,Бірақ мен ол қызды ойымнан шығара алмаймын.
Dialogue: 0,0:10:07.36,0:10:11.18,Default,,0,0,0,,Әлгі қыз бірдеңе істеген болуы керек.
Dialogue: 0,0:10:11.70,0:10:14.68,Default,,0,0,0,,Бізде де жалдамалылар бар.
Dialogue: 0,0:10:14.68,0:10:18.90,Default,,0,0,0,,Қанша берілсең де, құбыжықтардың күші шексіз.
Dialogue: 0,0:10:20.02,0:10:24.06,Default,,0,0,0,,Жалғыз нәрсе - бұл кеме.
Dialogue: 0,0:10:24.06,0:10:25.22,Default,,0,0,0,,Кумжи мырза
Dialogue: 0,0:10:25.22,0:10:28.16,Default,,0,0,0,,Жүк баспалдағын кемеден алыңыз
Dialogue: 0,0:10:28.16,0:10:30.64,Default,,0,0,0,,Бұл жерден бас тартқан дұрыс.
Dialogue: 0,0:10:33.16,0:10:34.50,Default,,0,0,0,,Маған
Dialogue: 0,0:10:34.88,0:10:39.53,Default,,0,0,0,,Сіз бұл Янкумджиге кемені тастап, қашуды айтып жатырсыз.
Dialogue: 0,0:10:41.28,0:10:44.40,Default,,0,0,0,,Ауа мырзасы болғанға дейін жиырма жыл
Dialogue: 0,0:10:44.40,0:10:46.66,Default,,0,0,0,,Лорд болғанына он жыл
Dialogue: 0,0:10:46.98,0:10:50.94,Default,,0,0,0,,Біз 30 жыл ішінде осы уақытқа дейін не құрдық
Dialogue: 0,0:10:50.94,0:10:54.74,Default,,0,0,0,,Қарт қарт пен жас қыз бастаған қарақшылар
Dialogue: 0,0:10:54.74,0:10:58.06,Default,,0,0,0,,Бір түнде ғана жойылады дейді.
Dialogue: 0,0:10:58.06,0:11:00.20,Default,,0,0,0,,О, мені кешір.
Dialogue: 0,0:11:10.22,0:11:12.84,Default,,0,0,0,,Оны лақтыр, бұл тышқан.
Dialogue: 0,0:11:34.24,0:11:35.78,Default,,0,0,0,,Джеха Шина
Dialogue: 0,0:11:35.78,0:11:37.29,Default,,0,0,0,,Сол кеме.
Dialogue: 0,0:11:37.29,0:11:40.36,Default,,0,0,0,,Кумуджи сол кемеде бір жерде болуы керек.
Dialogue: 0,0:11:41.64,0:11:42.74,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:11:51.86,0:11:54.20,Default,,0,0,0,,Йона, маған көмектес
Dialogue: 0,0:11:55.88,0:11:56.88,Default,,0,0,0,,Жүніс
Dialogue: 0,0:12:07.32,0:12:08.46,Default,,0,0,0,,Иеха
Dialogue: 0,0:12:09.44,0:12:12.12,Default,,0,0,0,,Гюмджи артқы жағындағы жасырын бөлмеде.
Dialogue: 0,0:12:12.12,0:12:15.52,Default,,0,0,0,,Не, мен бірінші болған жоқпын ба?
Dialogue: 0,0:12:17.02,0:12:19.24,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:12:41.82,0:12:43.70,Default,,0,0,0,,Кумжи рұқсаты
Dialogue: 0,0:12:48.82,0:12:52.26,Default,,0,0,0,,Ақшаға қалағаныңызша жалдамалы жалдауға болады.
Dialogue: 0,0:12:53.36,0:12:54.80,Default,,0,0,0,,Қарақшылар
Dialogue: 0,0:12:54.80,0:12:57.04,Default,,0,0,0,,Үйге оралып, қайта топтаңыз.
Dialogue: 0,0:12:57.04,0:13:00.13,Default,,0,0,0,,Мен сені тағы да жұлып аламын.
Dialogue: 0,0:13:01.36,0:13:03.74,Default,,0,0,0,,Айтайын, қайықшы.
Dialogue: 0,0:13:04.18,0:13:06.32,Default,,0,0,0,,Нағыз билік кім?
Dialogue: 0,0:13:06.32,0:13:14.38,Default,,0,0,0,,Мен ұяттан қорықпай кез келген лас жолмен өзін қорғай алатын адам туралы айтып отырмын.
Dialogue: 0,0:13:14.38,0:13:20.64,Default,,0,0,0,,Осы Янкумджи тірі болғанша, шайқас жеңілмейді.
Dialogue: 0,0:13:20.64,0:13:25.70,Default,,0,0,0,,Қарақшылар тізерлеп жатып ақша тауып жатыр.
Dialogue: 0,0:13:31.80,0:13:35.98,Default,,0,0,0,,Қол астындағыларды тастап қашу әдемі емес.
Dialogue: 0,0:13:38.40,0:13:40.70,Default,,0,0,0,,Лорд Геумжи, ол келе жатыр.
Dialogue: 0,0:13:43.92,0:13:47.50,Default,,0,0,0,,Бұл адам Аспан Айдаһары деген қауесет пе?
Dialogue: 0,0:13:47.50,0:13:49.36,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:13:51.76,0:13:56.04,Default,,0,0,0,,Мен оны бір рет атып түсіргім келген.
Dialogue: 0,0:13:59.84,0:14:01.32,Default,,0,0,0,,Бұл тәтті
Dialogue: 0,0:14:21.38,0:14:24.62,Default,,0,0,0,,Қалай ойлайсың, аспандағы айдаһар?
Dialogue: 0,0:14:24.62,0:14:27.46,Default,,0,0,0,,Теңізге құласаң, енді ұша алмайсың.
Dialogue: 0,0:14:35.30,0:14:38.68,Default,,0,0,0,,Бұл кісі өлтіру ниеті қандай?
Dialogue: 0,0:14:40.00,0:14:42.96,Default,,0,0,0,,Біреу мені көздеп тұр
Dialogue: 0,0:14:45.24,0:14:46.38,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:14:52.32,0:14:54.52,Default,,0,0,0,,Қызыл...шаш
Dialogue: 0,0:14:55.58,0:14:56.66,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:57.66,0:15:00.18,Default,,0,0,0,,Мен неге сонша қорқамын?
Dialogue: 0,0:15:01.38,0:15:04.58,Default,,0,0,0,,Сол кішкентай қыз сияқты
Dialogue: 0,0:15:07.72,0:15:09.78,Default,,0,0,0,,Бір рет I
Dialogue: 0,0:15:10.28,0:15:12.06,Default,,0,0,0,,Хирю сарайында
Dialogue: 0,0:15:12.06,0:15:15.94,Default,,0,0,0,,Мен де сен сияқты қызыл шашты көрдім.
Dialogue: 0,0:15:16.44,0:15:17.72,Default,,0,0,0,,Бір сәтке
Dialogue: 0,0:15:17.72,0:15:22.84,Default,,0,0,0,,Шашы алыстан күн сәулесіне шағылысатын әйелді қалай атайды?
Dialogue: 0,0:15:24.84,0:15:26.56,Default,,0,0,0,,Йона ханшайым
Dialogue: 0,0:15:27.50,0:15:28.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:29.58,0:15:30.74,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:15:31.82,0:15:37.26,Default,,0,0,0,,Ақыр соңында...сіз... Йона ханшайымсыз
Dialogue: 0,0:16:23.36,0:16:24.60,Default,,0,0,0,,Әке
Dialogue: 0,0:16:47.24,0:16:49.84,Default,,0,0,0,,Капитан капитан Джиган
Dialogue: 0,0:16:50.20,0:16:53.30,Default,,0,0,0,,Кумжиге жебе тиіп, теңізге кетеді
Dialogue: 0,0:16:55.68,0:16:58.38,Default,,0,0,0,,Түн атты.
Dialogue: 0,0:17:01.20,0:17:04.04,Default,,0,0,0,,Бұл шынымен де аяқталды.
Dialogue: 0,0:17:04.04,0:17:07.02,Default,,0,0,0,,Балалар, осынау берекелі күні
Dialogue: 0,0:17:08.80,0:17:10.40,Default,,0,0,0,,Бірақ иә.
Dialogue: 0,0:17:10.40,0:17:13.60,Default,,0,0,0,,Біз түні бойы ұрыстық.
Dialogue: 0,0:17:14.74,0:17:16.46,Default,,0,0,0,,Бұл жайсыз.
Dialogue: 0,0:17:16.46,0:17:18.78,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:17:18.78,0:17:20.84,Default,,0,0,0,,Иә капитан
Dialogue: 0,0:17:21.28,0:17:26.36,Default,,0,0,0,,Оянсаң, жай ғана балықшы боласың.
Dialogue: 0,0:17:31.56,0:17:33.30,Default,,0,0,0,,Мен Аваға қайтамын.
Dialogue: 0,0:17:42.20,0:17:43.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:49.02,0:17:51.34,Default,,0,0,0,,Амансыңдар деп үміттенемін, ханшайым.
Dialogue: 0,0:17:51.34,0:17:55.04,Default,,0,0,0,,Балалар сендер бір сызат та ғажапсыңдар.
Dialogue: 0,0:17:55.04,0:17:55.98,Default,,0,0,0,,Сүйкімді емес
Dialogue: 0,0:17:55.98,0:17:57.71,Default,,0,0,0,,Сіздердің кімдер
Dialogue: 0,0:18:07.36,0:18:09.08,Default,,0,0,0,,Тынышталыңдар, сирек кездесетін аңдар.
Dialogue: 0,0:18:09.40,0:18:10.62,Default,,0,0,0,,Өйткені бұл қиындық тудырады
Dialogue: 0,0:18:11.26,0:18:13.82,Default,,0,0,0,,Көптеген адамдар
Dialogue: 0,0:18:13.82,0:18:16.90,Default,,0,0,0,,Ол Кумжимен түні бойы төбелесті.
Dialogue: 0,0:18:17.46,0:18:19.18,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:20.08,0:18:22.14,Default,,0,0,0,,Балалар, менің сендерге көмектесетінім табиғи нәрсе.
Dialogue: 0,0:18:22.14,0:18:25.78,Default,,0,0,0,,Жоқ, мен сені қорғаймын деп тағдырыма ергенше.
Dialogue: 0,0:18:25.78,0:18:27.30,Default,,0,0,0,,Айтпақшы, сіздің атыңыз
Dialogue: 0,0:18:27.30,0:18:28.37,Default,,0,0,0,,Иеха
Dialogue: 0,0:18:28.37,0:18:33.30,Default,,0,0,0,,Ауа жұтып жатқандай түсініксіз сөйлеме...
Dialogue: 0,0:18:33.30,0:18:36.26,Default,,0,0,0,,Біз ештеңе істей алмаймыз
Dialogue: 0,0:18:36.26,0:18:37.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:38.40,0:18:41.18,Default,,0,0,0,,Юрий өз өмірін қатерге тігіп, маған қол ұшын берді.
Dialogue: 0,0:18:41.46,0:18:42.44,Default,,0,0,0,,Лина
Dialogue: 0,0:18:42.76,0:18:48.38,Default,,0,0,0,,Юрий Менің атым шын мәнінде...
Dialogue: 0,0:18:51.86,0:18:55.74,Default,,0,0,0,,Юри сияқты адамдар бар болса, Ава жақсы болады.
Dialogue: 0,0:18:57.10,0:18:59.26,Default,,0,0,0,,Рахмет сізге Лина
Dialogue: 0,0:18:59.26,0:19:01.18,Default,,0,0,0,,Сонымен
Dialogue: 0,0:19:01.18,0:19:03.48,Default,,0,0,0,,Барлығына алғыс айтыңыз.
Dialogue: 0,0:19:03.48,0:19:06.16,Default,,0,0,0,,Сізге алғысымызды айта алмаймыз...
Dialogue: 0,0:19:06.16,0:19:09.48,Default,,0,0,0,,Қарақшылар талап ететін сыйақы қымбат.
Dialogue: 0,0:19:10.96,0:19:17.60,Default,,0,0,0,,Сіз және мен, бұл қаладағы барлық адамдарға мас болу үшін сусын.
Dialogue: 0,0:19:17.63,0:19:19.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:20.58,0:19:21.92,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:19:22.56,0:19:23.78,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:24.12,0:19:25.68,Default,,0,0,0,,Барлығы ауыр жарақат алды.
Dialogue: 0,0:19:25.68,0:19:27.28,Default,,0,0,0,,Мен алдымен онымен айналысуым керек.
Dialogue: 0,0:19:27.28,0:19:29.76,Default,,0,0,0,,Бозу Тамақ, жеңіл тағамдар дайында
Dialogue: 0,0:19:29.76,0:19:31.20,Default,,0,0,0,,Мен әйелмін бе?
Dialogue: 0,0:19:31.20,0:19:32.26,Default,,0,0,0,,Қосымша жәрдемақылар...
Dialogue: 0,0:19:32.26,0:19:33.62,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:19:33.62,0:19:38.22,Default,,0,0,0,,Жеңіс күні қарақшылардың қимылы, олар құлағанша ішіп, жабайы жүру.
Dialogue: 0,0:19:38.22,0:19:39.65,Default,,0,0,0,,Әлі таң
Dialogue: 0,0:19:40.02,0:19:42.12,Default,,0,0,0,,Қарқынды, солай емес пе?
Dialogue: 0,0:19:42.12,0:19:43.46,Default,,0,0,0,,Райджуға мінбе
Dialogue: 0,0:19:43.46,0:19:46.06,Default,,0,0,0,,Банкет? Бұл ностальгия.
Dialogue: 0,0:19:46.06,0:19:50.82,Default,,0,0,0,,Менің туған күнім фестивалінде жыл сайын барлығы айдаһар биін билейтін.
Dialogue: 0,0:19:51.16,0:19:52.91,Default,,0,0,0,,Майко мен ойыншылар қайда?
Dialogue: 0,0:19:53.76,0:19:55.73,Default,,0,0,0,,Ән айтудан және актерлік өнерден ләззат алыңыз.
Dialogue: 0,0:19:55.84,0:19:57.56,Default,,0,0,0,,Ауызыңды жап, бай.
Dialogue: 0,0:19:57.56,0:19:59.57,Default,,0,0,0,,Соңғы жебеге айналғанша...
Dialogue: 0,0:20:00.90,0:20:02.78,Default,,0,0,0,,Пукю Шинаны жеме
Dialogue: 0,0:20:04.22,0:20:05.88,Default,,0,0,0,,Оған көмектесу мүмкін емес, Юнкун.
Dialogue: 0,0:20:05.88,0:20:07.30,Default,,0,0,0,,Бүгінгі күн ерекше
Dialogue: 0,0:20:08.34,0:20:11.32,Default,,0,0,0,,Жеңіс, тамаша емес пе?
Dialogue: 0,0:20:11.32,0:20:15.26,Default,,0,0,0,,Аваның таза және әдемі порты және сұлу қыздар
Dialogue: 0,0:20:15.26,0:20:19.30,Default,,0,0,0,,Ал осы күнді тойлауда мына әдемі қызметші
Dialogue: 0,0:20:20.02,0:20:20.96,Default,,0,0,0,,Мен оны шешіп аламын.
Dialogue: 0,0:20:20.96,0:20:22.29,Default,,0,0,0,,Ән емес пе?
Dialogue: 0,0:20:22.29,0:20:23.40,Default,,0,0,0,,Шығармашылықты бұзушы
Dialogue: 0,0:20:23.40,0:20:24.22,Default,,0,0,0,,Мен оны шешіп аламын
Dialogue: 0,0:20:24.22,0:20:26.54,Default,,0,0,0,,Қолымнан келгенше қансырап жатырмын.
Dialogue: 0,0:20:26.54,0:20:28.04,Default,,0,0,0,,Біржола құрып кету
Dialogue: 0,0:20:28.44,0:20:30.52,Default,,0,0,0,,Бала, сен әлі жеңіл тамақ жедің бе?
Dialogue: 0,0:20:30.52,0:20:32.14,Default,,0,0,0,,Мен білмеймін, ақымақ.
Dialogue: 0,0:20:32.14,0:20:33.30,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:20:33.30,0:20:34.92,Default,,0,0,0,,Алкоголь келді
Dialogue: 0,0:20:55.00,0:20:56.18,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:20:57.32,0:21:01.00,Default,,0,0,0,,Бұл шайқас баяғыда болған сияқты.
Dialogue: 0,0:21:02.46,0:21:07.96,Default,,0,0,0,,Мен осы қаланың тұрғындарына көмектесе аламын ба деп ойлаймын.
Dialogue: 0,0:21:09.36,0:21:10.60,Default,,0,0,0,,Әке
Dialogue: 0,0:21:11.26,0:21:16.22,Default,,0,0,0,,Мен аздап күшейдім бе?
Dialogue: 0,0:21:18.46,0:21:21.06,Default,,0,0,0,,Артық кетсең, бәрі уайымдайды.
Dialogue: 0,0:21:22.10,0:21:23.16,Default,,0,0,0,,Мен қайтуым керек
Dialogue: 0,0:21:27.54,0:21:29.35,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:31.50,0:21:34.06,Default,,0,0,0,,Көңіл салмайтын менмін
Dialogue: 0,0:23:26.50,0:23:30.12,Default,,0,0,0,,Мен әлі өле алмаймын.
Dialogue: 0,0:23:30.32,0:23:33.42,Default,,0,0,0,,Өйткені менің бір ісім бар
Dialogue: 0,0:23:34.16,0:23:37.62,Default,,0,0,0,,Келесі жолы «Таң таңындағы Йона» 23-бөлім
Dialogue: 0,0:23:37.62,0:23:39.50,Default,,0,0,0,,Ант беру таңы
Dialogue: 0,0:23:41.00,0:23:46.00,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
