Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.67,0:00:10.16,Default,,0,0,0,,Ыңғайлы
Dialogue: 0,0:00:11.23,0:00:13.90,Default,,0,0,0,,Ақырында көптен күткен патша пайда болды
Dialogue: 0,0:00:14.54,0:00:18.07,Default,,0,0,0,,Менің отбасымның ертеден келе жатқан аңсаған тілегі
Dialogue: 0,0:00:18.96,0:00:21.54,Default,,0,0,0,,Ақ айдаһар ауылында қалғандар
Dialogue: 0,0:00:22.38,0:00:26.30,Default,,0,0,0,,Мен патшаны міндетті түрде қорғаймын
Dialogue: 0,0:00:27.45,0:00:28.90,Default,,0,0,0,,Ақ жылан
Dialogue: 0,0:00:29.38,0:00:32.12,Default,,0,0,0,,Сіз бұл бейтаныс сапардан шаршаған болуыңыз керек.
Dialogue: 0,0:00:32.12,0:00:35.76,Default,,0,0,0,,Тағы да ақ жылан десең, тамағыңды кесемін.
Dialogue: 0,0:00:36.23,0:00:38.14,Default,,0,0,0,,Мұның бәрі сізді шаршатады ма?
Dialogue: 0,0:00:38.14,0:00:42.14,Default,,0,0,0,,Жоқ, ауылды сағынатын кез келді деп ойлаймын.
Dialogue: 0,0:00:42.14,0:00:45.37,Default,,0,0,0,,Сіз не айтасыз? Ханшайым мені қалады.
Dialogue: 0,0:00:45.37,0:00:48.38,Default,,0,0,0,,Егер бірдеңе болса, мені қорғаңыз.
Dialogue: 0,0:00:48.38,0:00:51.29,Default,,0,0,0,,Қораптағы бала төбелесе ала ма?
Dialogue: 0,0:00:52.34,0:00:53.59,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:00:54.03,0:00:57.25,Default,,0,0,0,,Екеуміз бұдан былай бірге саяхаттаймыз, қиындыққа тап болма.
Dialogue: 0,0:00:57.54,0:01:00.12,Default,,0,0,0,,Кешіріңіз, ханшайым.
Dialogue: 0,0:01:00.12,0:01:04.49,Default,,0,0,0,,Хаку Киджа бірінші рет сыртқа шығып, қобалжуға толы, сондықтан мен оны қорламаймын.
Dialogue: 0,0:01:04.49,0:01:05.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:05.96,0:01:09.12,Default,,0,0,0,,Киджа Хаку бұзақысы хобби, сондықтан маған бәрібір
Dialogue: 0,0:01:10.30,0:01:11.45,Default,,0,0,0,,Хобби
Dialogue: 0,0:01:11.67,0:01:13.78,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:01:13.78,0:01:15.32,Default,,0,0,0,,Иә
Dialogue: 0,0:02:56.12,0:02:59.10,Default,,0,0,0,,Киджа Сіз басқа айдаһарлардың барын сезе аласыз, солай ма?
Dialogue: 0,0:02:59.10,0:03:01.92,Default,,0,0,0,,Юнды айттың әрине.
Dialogue: 0,0:03:02.21,0:03:05.92,Default,,0,0,0,,Ақылдың көзін ұштайтын болсаң, оның бар екенін сезінесің.
Dialogue: 0,0:03:05.92,0:03:08.36,Default,,0,0,0,,Ал, кім жақын екенін айт.
Dialogue: 0,0:03:08.36,0:03:09.58,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:03:16.36,0:03:20.40,Default,,0,0,0,,Өзімді ең жақын сезінетін адамым – Сейрю.
Dialogue: 0,0:03:21.58,0:03:23.70,Default,,0,0,0,,Мен кімнің барын білемін
Dialogue: 0,0:03:23.70,0:03:24.83,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:03:24.83,0:03:26.54,Default,,0,0,0,,That's right.
Dialogue: 0,0:03:27.63,0:03:30.25,Default,,0,0,0,,Екінші жақ ештеңе істемейді.
Dialogue: 0,0:03:31.83,0:03:34.43,Default,,0,0,0,,Орналасқан жері тамаша нобай.
Dialogue: 0,0:03:34.43,0:03:35.87,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:03:35.87,0:03:37.83,Default,,0,0,0,,Барлығыңыз маған еріңіздер.
Dialogue: 0,0:03:37.83,0:03:38.85,Default,,0,0,0,,Мен уайымдап тұрмын
Dialogue: 0,0:03:38.85,0:03:42.38,Default,,0,0,0,,Өмірінде бірінші рет көшеге шыққан адамның соңынан еру мені алаңдатады.
Dialogue: 0,0:03:42.38,0:03:45.21,Default,,0,0,0,,Мен сыртқа шықпай-ақ сыртқы әлем туралы білемін.
Dialogue: 0,0:03:45.21,0:03:48.91,Default,,0,0,0,,Менің отбасым ақпарат жинау үшін әртүрлі жерлерге ұшып келді.
Dialogue: 0,0:03:51.78,0:03:52.78,Default,,0,0,0,,Кижа
Dialogue: 0,0:03:58.54,0:04:00.85,Default,,0,0,0,,Бұл қандай заттар?
Dialogue: 0,0:04:00.85,0:04:04.10,Default,,0,0,0,,Мұндай жерде тұруға кімнің рұқсаты бар?
Dialogue: 0,0:04:04.10,0:04:05.85,Default,,0,0,0,,Күтіңіз, тоқтаңыз.
Dialogue: 0,0:04:05.85,0:04:06.92,Default,,0,0,0,,Әрі қарай
Dialogue: 0,0:04:08.11,0:04:14.75,Default,,0,0,0,,Жоқ, келме.
Dialogue: 0,0:04:11.50,0:04:14.90,Default,,0,0,0,,Хакурю-сама, соңында тыныш жүр.
Dialogue: 0,0:04:17.73,0:04:20.85,Default,,0,0,0,,Мен әлі күнге дейін өзімді жорғалап жүргендей сезінемін.
Dialogue: 0,0:04:20.85,0:04:23.56,Default,,0,0,0,,Айдаһар Құдай жәндіктерден әлсіз, солай ма?
Dialogue: 0,0:04:23.56,0:04:28.13,Default,,0,0,0,,Жоқ, мен жай ғана қытырлақ заттарды ұнатпаймын.
Dialogue: 0,0:04:28.13,0:04:32.87,Default,,0,0,0,,Құдіретім асқақ, Ақ айдаһар берген құдайдың құдіреті.
Dialogue: 0,0:04:32.87,0:04:34.83,Default,,0,0,0,,Қарапайым халықтықі деп ойлаймын.
Dialogue: 0,0:04:34.83,0:04:36.59,Default,,0,0,0,,Онда да
Dialogue: 0,0:04:37.87,0:04:39.83,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:04:39.83,0:04:43.58,Default,,0,0,0,,Шаң басқан ескі күштердің пайдасы жоқ.
Dialogue: 0,0:04:43.58,0:04:46.63,Default,,0,0,0,,Олай болса, неге осында көрмеске?
Dialogue: 0,0:04:50.23,0:04:51.92,Default,,0,0,0,,Ханшайым, жасырын
Dialogue: 0,0:04:51.92,0:04:53.05,Default,,0,0,0,,Хаку
Dialogue: 0,0:04:53.63,0:04:55.05,Default,,0,0,0,,Не болды, Кижа?
Dialogue: 0,0:04:55.05,0:04:56.32,Default,,0,0,0,,Біреу келе жатыр
Dialogue: 0,0:04:56.32,0:04:57.85,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:57.85,0:05:00.03,Default,,0,0,0,,Бұл өте көп сан.
Dialogue: 0,0:05:00.03,0:05:02.63,Default,,0,0,0,,Бұл қадамдар онша классикалық емес.
Dialogue: 0,0:05:02.63,0:05:06.52,Default,,0,0,0,,Олай емес, біз отты елде көршіміз.
Dialogue: 0,0:05:06.52,0:05:08.16,Default,,0,0,0,,От руы жау ма?
Dialogue: 0,0:05:08.16,0:05:10.58,Default,,0,0,0,,Олар дерлік жау.
Dialogue: 0,0:05:10.58,0:05:14.18,Default,,0,0,0,,Иә, Хаку, садақты қолдануға болады.
Dialogue: 0,0:05:14.18,0:05:17.33,Default,,0,0,0,,Мұғалім рұқсат бермейді. Өтінемін жасырыңыз.
Dialogue: 0,0:05:18.83,0:05:20.14,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:05:25.65,0:05:28.69,Default,,0,0,0,,Ей, мына жерде олжа бар.
Dialogue: 0,0:05:28.69,0:05:31.98,Default,,0,0,0,,Не? Сізде көп нәрсе жоқ сияқты.
Dialogue: 0,0:05:31.98,0:05:33.92,Default,,0,0,0,,Қандай қарақшы?
Dialogue: 0,0:05:33.92,0:05:35.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:35.43,0:05:39.16,Default,,0,0,0,,Шынында да, ол жерде екі әйел бар.
Dialogue: 0,0:05:40.25,0:05:41.90,Default,,0,0,0,,Ол әдемі бала.
Dialogue: 0,0:05:41.90,0:05:46.96,Default,,0,0,0,,Мына жігіт әдемі киінген, сататын түрі бар.
Dialogue: 0,0:05:46.96,0:05:50.72,Default,,0,0,0,,Эй, менің ойымша, сіз оны әзірше кесуге қарсы емессіз.
Dialogue: 0,0:05:50.72,0:05:52.80,Default,,0,0,0,,Жасырсаң да бәрібір.
Dialogue: 0,0:05:52.80,0:05:54.45,Default,,0,0,0,,Кім
Dialogue: 0,0:05:55.36,0:05:57.83,Default,,0,0,0,,Неге дірілдеп тұрсың, аға?
Dialogue: 0,0:05:57.83,0:06:02.29,Default,,0,0,0,,Уайымдама, егер сен тыныш болсаң мен сені өлтірмеймін.
Dialogue: 0,0:06:03.90,0:06:05.32,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:06:05.72,0:06:09.87,Default,,0,0,0,,Білмеймін, бірақ оның қолдары ыстық болғандықтан, қайнап жатқан сияқты.
Dialogue: 0,0:06:10.43,0:06:11.96,Default,,0,0,0,,Не деген ақымақтық
Dialogue: 0,0:06:15.16,0:06:17.83,Default,,0,0,0,,Абайсызда ұстамаған дұрыс.
Dialogue: 0,0:06:19.43,0:06:21.07,Default,,0,0,0,,Мыңдаған жылдар
Dialogue: 0,0:06:21.07,0:06:24.90,Default,,0,0,0,,Мен тіпті өз иесін қорғауды күткен бұл күшті басқара алмаймын.
Dialogue: 0,0:06:28.81,0:06:31.13,Default,,0,0,0,,Бұл қандай қол?
Dialogue: 0,0:06:31.36,0:06:34.30,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Ақ Айдаһардың қолы
Dialogue: 0,0:06:42.98,0:06:44.35,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:06:47.98,0:06:50.35,Default,,0,0,0,,Бұл айдаһардың тырнақтарының күші
Dialogue: 0,0:06:51.25,0:06:53.69,Default,,0,0,0,,Менің түріме сәйкес келмейді
Dialogue: 0,0:06:53.69,0:06:56.31,Default,,0,0,0,,Әлі де жеткіліксіз
Dialogue: 0,0:06:56.78,0:07:02.16,Default,,0,0,0,,Сонымен, Хаку, мен сені ханшайымның бұйрығы бойынша қорғаймын ба?
Dialogue: 0,0:07:02.16,0:07:03.74,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:05.92,0:07:07.37,Default,,0,0,0,,Мен уақытында келемін
Dialogue: 0,0:07:07.70,0:07:09.59,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:07:17.63,0:07:20.51,Default,,0,0,0,,Не, бұл жігіт қалыпты емес.
Dialogue: 0,0:07:20.51,0:07:26.44,Default,,0,0,0,,Кешіріңіз, тек сол ақ жылан қалыпты емес.
Dialogue: 0,0:07:28.65,0:07:31.24,Default,,0,0,0,,Сен қайда көздеп тұрсың, Ақ жылан?
Dialogue: 0,0:07:31.78,0:07:35.81,Default,,0,0,0,,Мен саған тағы да Ақ жылан десең, тамағыңды кесетінімді айттым.
Dialogue: 0,0:07:35.81,0:07:38.82,Default,,0,0,0,,Бұл туралы алаңдамаңыз, бұл хобби.
Dialogue: 0,0:07:39.07,0:07:43.70,Default,,0,0,0,,Бірақ бұл аздап тым қызықты, ол тым байқалады.
Dialogue: 0,0:07:44.61,0:07:50.52,Default,,0,0,0,,Ханшайымды қорғау – ең үлкен қуаныш, сол ұлы семсердің жолын кесетін сенсің.
Dialogue: 0,0:07:52.36,0:07:54.96,Default,,0,0,0,,Төрт айдаһар бір ойлы.
Dialogue: 0,0:07:54.96,0:07:58.70,Default,,0,0,0,,Онда неге ханшайымды қорғайсың?
Dialogue: 0,0:07:59.81,0:08:02.63,Default,,0,0,0,,Жаңа кездескен адамға бересің бе, ақымақ?
Dialogue: 0,0:08:03.50,0:08:05.12,Default,,0,0,0,,Бұл ақымақ
Dialogue: 0,0:08:05.12,0:08:06.30,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:08:09.63,0:08:14.34,Default,,0,0,0,,Мен бұл жігітті күшсіз адам деп ойладым, бірақ ол қаншалықты күшті?
Dialogue: 0,0:08:14.76,0:08:18.98,Default,,0,0,0,,Мен мұны мойындауды жек көремін, бірақ оның күші айдаһардың қолымен тең дерлік.
Dialogue: 0,0:08:18.98,0:08:21.63,Default,,0,0,0,,Олар біртүрлі Абсолютті біртүрлі
Dialogue: 0,0:08:21.63,0:08:24.14,Default,,0,0,0,,Менің ойымша, Кижа бұл дүниеден емес.
Dialogue: 0,0:08:24.14,0:08:27.12,Default,,0,0,0,,Райджу да адамдық шеберлік емес, ол жылдамдық.
Dialogue: 0,0:08:29.72,0:08:31.14,Default,,0,0,0,,Мен көмектескім келеді
Dialogue: 0,0:08:31.94,0:08:33.79,Default,,0,0,0,,Хаку не деді?
Dialogue: 0,0:08:34.32,0:08:35.47,Default,,0,0,0,,Шыдамдылық
Dialogue: 0,0:08:35.47,0:08:38.23,Default,,0,0,0,,Бірақ сіз мұны айтқан кезде жаттығу жасадыңыз деп ойлаймын.
Dialogue: 0,0:08:42.36,0:08:44.16,Default,,0,0,0,,Менің есептеулерім бойынша
Dialogue: 0,0:08:44.16,0:08:48.35,Default,,0,0,0,,Егер сіз дәл қазір осы қашықтықта ұшып бара жатсаңыз, бұл Райджуны арт жағынан көздеген адам.
Dialogue: 0,0:08:48.98,0:08:50.76,Default,,0,0,0,,Кішкене жоғары
Dialogue: 0,0:08:52.05,0:08:53.14,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:08:55.92,0:08:57.10,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:08:57.10,0:08:59.96,Default,,0,0,0,,Юн керемет. Ол Хакудан жақсырақ сабақ береді.
Dialogue: 0,0:08:59.96,0:09:04.30,Default,,0,0,0,,Оның адам екенін анықтауға болады, бірақ сіз болсаңыз, ол жақсы нәтиже бермейді.
Dialogue: 0,0:09:05.67,0:09:08.02,Default,,0,0,0,,Тыныш болыңыздар, ханымдар.
Dialogue: 0,0:09:08.02,0:09:10.58,Default,,0,0,0,,Мен сені кепілге аламын.
Dialogue: 0,0:09:17.72,0:09:19.23,Default,,0,0,0,,Ханшайым аман ба?
Dialogue: 0,0:09:19.83,0:09:21.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:21.36,0:09:22.55,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:09:23.85,0:09:26.03,Default,,0,0,0,,Бәрі бітті
Dialogue: 0,0:09:26.63,0:09:28.70,Default,,0,0,0,,Сіз қанша адамды жеңдіңіз?
Dialogue: 0,0:09:29.63,0:09:30.92,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:09:30.92,0:09:32.83,Default,,0,0,0,,Менің жасым 28-де
Dialogue: 0,0:09:32.83,0:09:34.14,Default,,0,0,0,,Менің жасым 40-та
Dialogue: 0,0:09:34.14,0:09:35.36,Default,,0,0,0,,Өтірік
Dialogue: 0,0:09:35.36,0:09:39.52,Default,,0,0,0,,Есіңде жоқ деп айтпадың ба? Ондай адам көп емес...
Dialogue: 0,0:09:44.54,0:09:47.36,Default,,0,0,0,,Кия жарайды
Dialogue: 0,0:09:48.34,0:09:52.03,Default,,0,0,0,,Иә, бұл аздап зорлық-зомбылық болды.
Dialogue: 0,0:09:52.03,0:09:56.92,Default,,0,0,0,,Мен сізге күрделірек жекпе-жекті көрсетуім керек еді.
Dialogue: 0,0:09:56.92,0:10:00.03,Default,,0,0,0,,Жоқ, менің ойымша, бұл жақсы.
Dialogue: 0,0:10:00.03,0:10:03.85,Default,,0,0,0,,Ақ Айдаһар Құдайының қанды шайқасы
Dialogue: 0,0:10:04.09,0:10:05.67,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:10:05.67,0:10:10.02,Default,,0,0,0,,Мен сарайда болғанымда, менің артымнан шындап ілесетін ешкім болмады.
Dialogue: 0,0:10:10.38,0:10:12.56,Default,,0,0,0,,Бір рет жиналайық... иә?
Dialogue: 0,0:10:13.30,0:10:14.36,Default,,0,0,0,,Хаку
Dialogue: 0,0:10:14.90,0:10:15.96,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:10:15.96,0:10:17.23,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:10:17.74,0:10:20.52,Default,,0,0,0,,Ақымақ, жарасы ашық.
Dialogue: 0,0:10:21.54,0:10:23.85,Default,,0,0,0,,Жара іс жүзінде жазылмаған.
Dialogue: 0,0:10:23.85,0:10:26.92,Default,,0,0,0,,Ылғалды, бірақ тозған.
Dialogue: 0,0:10:27.47,0:10:30.43,Default,,0,0,0,,Осындай денемен мұндай қозғалыс
Dialogue: 0,0:10:30.43,0:10:34.54,Default,,0,0,0,,Мен бұл адамның құбыжық екеніне сенбеймін бе?
Dialogue: 0,0:10:34.54,0:10:37.00,Default,,0,0,0,,Менің сізге айтқанымды қаламайсыз деп ойлаймын.
Dialogue: 0,0:10:38.30,0:10:40.32,Default,,0,0,0,,Күн батып барады.
Dialogue: 0,0:10:40.32,0:10:42.58,Default,,0,0,0,,Мен ұйықтайтын жер табуым керек.
Dialogue: 0,0:10:43.72,0:10:45.43,Default,,0,0,0,,Бұл жерде қонақ үй бар ма?
Dialogue: 0,0:10:45.43,0:10:47.07,Default,,0,0,0,,Бұл кемпингке саяхат.
Dialogue: 0,0:10:47.07,0:10:48.14,Default,,0,0,0,,Кемпинг
Dialogue: 0,0:10:48.78,0:10:50.70,Default,,0,0,0,,Міне сонша ыстық
Dialogue: 0,0:10:50.70,0:10:53.75,Default,,0,0,0,,Хакурю-сама, соңында мұқият қадағалаңыз.
Dialogue: 0,0:10:55.27,0:10:57.83,Default,,0,0,0,,Не істеп жатырсың, ханшайым?
Dialogue: 0,0:10:57.83,0:11:01.65,Default,,0,0,0,,Өйткені Хаку қозғала алмайды. Мен оны алып жүруім керек.
Dialogue: 0,0:11:02.72,0:11:04.34,Default,,0,0,0,,Кижа керемет
Dialogue: 0,0:11:04.34,0:11:08.47,Default,,0,0,0,,Айдаһардың қолы қарапайым адамның қолынан ондаған есе күшті.
Dialogue: 0,0:11:11.27,0:11:14.08,Default,,0,0,0,,Жоқ, тек менің оң қолым.
Dialogue: 0,0:11:20.25,0:11:22.70,Default,,0,0,0,,Жарайды, мына кісі.
Dialogue: 0,0:11:24.30,0:11:26.89,Default,,0,0,0,,Энхаку күшті
Dialogue: 0,0:11:27.56,0:11:33.98,Default,,0,0,0,,Сондықтан маған әзірге тек қорғану керек, бірақ бір күні мен сені қорғағым келеді.
Dialogue: 0,0:11:34.32,0:11:37.47,Default,,0,0,0,,Ханшайым осы уақыт бойы сарайда болса да, ол әлі де күшті.
Dialogue: 0,0:11:37.47,0:11:39.14,Default,,0,0,0,,Менің күшім жетпейді
Dialogue: 0,0:11:39.14,0:11:42.45,Default,,0,0,0,,Бірақ ол қарақшыларға қатты ренжіген жоқ.
Dialogue: 0,0:11:43.12,0:11:44.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:44.56,0:11:50.99,Default,,0,0,0,,Мен қарақшылардан қорықпаймын. Мен үшін сол түннен асқан қорқынышты ештеңе жоқ.
Dialogue: 0,0:11:54.50,0:11:56.12,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:11:57.32,0:11:58.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:01.16,0:12:06.92,Default,,0,0,0,,Бұл хирю патшасын қорғау үшін берілген ақ айдаһар қаны үшін бе?
Dialogue: 0,0:12:07.67,0:12:09.70,Default,,0,0,0,,Мен сізді қолдағым келеді
Dialogue: 0,0:12:09.70,0:12:14.96,Default,,0,0,0,,Күшті болуға тырысамын, әлсіреген арқам жылайтын сияқты
Dialogue: 0,0:12:19.52,0:12:20.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:20.87,0:12:23.25,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:12:23.25,0:12:28.25,Default,,0,0,0,,Кешкі ас Бұл бұрын тау жолында өсіп тұрған шөп емес пе?
Dialogue: 0,0:12:28.25,0:12:31.98,Default,,0,0,0,,Бұл арамшөп емес, дұрыс жеуге болатын жабайы көкөніс.
Dialogue: 0,0:12:31.98,0:12:34.56,Default,,0,0,0,,Мен жәндіктерді таныстырмағаныма ризамын.
Dialogue: 0,0:12:34.56,0:12:37.52,Default,,0,0,0,,Жәндіктер Сіз жәндіктерді жейсіз бе?
Dialogue: 0,0:12:37.52,0:12:39.38,Default,,0,0,0,,Жәндіктер қоректік пе?
Dialogue: 0,0:12:40.07,0:12:43.32,Default,,0,0,0,,Ханшайымның мұндай тамаққа жарай ма?
Dialogue: 0,0:12:43.32,0:12:47.54,Default,,0,0,0,,Мен әлі жәндіктерді жей алмаймын, бірақ үйреніп келемін.
Dialogue: 0,0:12:47.54,0:12:49.38,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,0:12:49.38,0:12:52.51,Default,,0,0,0,,Менің оны жек көруге уақытым болмады.
Dialogue: 0,0:12:52.51,0:12:56.73,Default,,0,0,0,,Бірақ Юн келгеннен кейін тамақ әлдеқайда жақсы болды.
Dialogue: 0,0:12:56.73,0:12:59.90,Default,,0,0,0,,Хакумен болған уақыт өте қорқынышты болды.
Dialogue: 0,0:12:59.90,0:13:02.30,Default,,0,0,0,,Ой, сен неге жылайсың?
Dialogue: 0,0:13:03.16,0:13:06.23,Default,,0,0,0,,Ханшайым, өте қатал сапар
Dialogue: 0,0:13:06.23,0:13:08.47,Default,,0,0,0,,Менің тамағым қандай?
Dialogue: 0,0:13:08.47,0:13:10.38,Default,,0,0,0,,Хаку, сен ояндың.
Dialogue: 0,0:13:10.38,0:13:12.36,Default,,0,0,0,,Мен оны елемеу мүмкін емес.
Dialogue: 0,0:13:12.36,0:13:13.62,Default,,0,0,0,,Жарасы жақсы
Dialogue: 0,0:13:13.62,0:13:16.25,Default,,0,0,0,,Шрам дегеніміз не?
Dialogue: 0,0:13:16.25,0:13:18.65,Default,,0,0,0,,Оның орнына менің тамағым ше?
Dialogue: 0,0:13:18.65,0:13:21.12,Default,,0,0,0,,Тамақ Не болды?
Dialogue: 0,0:13:21.12,0:13:23.23,Default,,0,0,0,,Ах, қарным ашты.
Dialogue: 0,0:13:23.23,0:13:25.54,Default,,0,0,0,,Сіз одан аулақ бола бастадыңыз, солай емес пе?
Dialogue: 0,0:13:25.54,0:13:28.88,Default,,0,0,0,,Денемді қозғалта аламын ба? Мен сені тамақтандырайын ба?
Dialogue: 0,0:13:30.67,0:13:32.41,Default,,0,0,0,,Иә, ауызыңды аш.
Dialogue: 0,0:13:34.63,0:13:37.81,Default,,0,0,0,,Ханшайым, мұндай үй шаруалары менікі.
Dialogue: 0,0:13:37.81,0:13:40.25,Default,,0,0,0,,Ақ жылан, маған кедергі жасама.
Dialogue: 0,0:13:40.25,0:13:43.01,Default,,0,0,0,,Ханшайымнан сені тамақтандыруын сұрау – ақымақтық.
Dialogue: 0,0:13:43.01,0:13:47.12,Default,,0,0,0,,Енді тамақ ішіп болған соң, бұл Сейрюдің орны.
Dialogue: 0,0:13:47.12,0:13:49.67,Default,,0,0,0,,Киджа Көк айдаһардың белгісі
Dialogue: 0,0:13:49.67,0:13:51.65,Default,,0,0,0,,Мен арғы жағында не бар екенін әрең білемін
Dialogue: 0,0:13:51.65,0:13:54.16,Default,,0,0,0,,Иә, қолайсыздық үшін кешіріңіз.
Dialogue: 0,0:13:54.76,0:13:59.21,Default,,0,0,0,,Көк айдаһардың ақ айдаһардай ауылы бар ма? Әлде бір адам ба?
Dialogue: 0,0:13:59.61,0:14:02.03,Default,,0,0,0,,Мен мұны шынымен түсінбеймін.
Dialogue: 0,0:14:02.03,0:14:04.90,Default,,0,0,0,,Әр жердегі отандастарымыздың мәліметі
Dialogue: 0,0:14:04.90,0:14:09.61,Default,,0,0,0,,Ертеде Жер тайпасының жерінде Көк Айдаһар руы тығылып өмір сүрген сияқты.
Dialogue: 0,0:14:09.61,0:14:11.94,Default,,0,0,0,,Бірақ бір күні Сақайда
Dialogue: 0,0:14:11.94,0:14:17.14,Default,,0,0,0,,Сейіру ауылы кенет жоғалып, отбасы да хабарсыз кетті.
Dialogue: 0,0:14:18.16,0:14:21.94,Default,,0,0,0,,Жоғалып кетті, бірақ бұл жойылу емес деп ойлаймын.
Dialogue: 0,0:14:23.25,0:14:27.36,Default,,0,0,0,,Көзімді жұмсам, көк айдаһардың жүрек соғысын анық сезінемін.
Dialogue: 0,0:14:28.21,0:14:31.23,Default,,0,0,0,,Икс Хакурюден басқаның бәрі қозғалып жатқанын айтты.
Dialogue: 0,0:14:31.23,0:14:35.72,Default,,0,0,0,,Сейіру әулеті басқа ауылға көшіп кеткен болар.
Dialogue: 0,0:14:36.23,0:14:40.25,Default,,0,0,0,,Киджа шығыс-солтүстік-шығыс От тайпасының жерін көрсетеді
Dialogue: 0,0:14:40.25,0:14:43.83,Default,,0,0,0,,Сонда ауыл болуы мүмкін жер Роккашо болар еді.
Dialogue: 0,0:14:43.83,0:14:46.01,Default,,0,0,0,,Юн, сен сонда болдың ба?
Dialogue: 0,0:14:46.01,0:14:47.92,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:14:47.92,0:14:51.76,Default,,0,0,0,,Бұл жерде Сайка но Миякодан кейінгі ең үлкен қала бар.
Dialogue: 0,0:14:51.76,0:14:56.23,Default,,0,0,0,,Бұл көпес топтарының келіп-кететін жолы, төрелердің сарайлары.
Dialogue: 0,0:14:56.23,0:14:59.72,Default,,0,0,0,,Көзге көрінбейтін және өтпейтін жерге келгенде,
Dialogue: 0,0:14:59.72,0:15:02.01,Default,,0,0,0,,Ол шамамен алты орынға дейін тарылды.
Dialogue: 0,0:15:02.01,0:15:05.77,Default,,0,0,0,,Керемет, Юн шынымен бәрін біледі.
Dialogue: 0,0:15:05.77,0:15:09.82,Default,,0,0,0,,Маған ұл баладай қарама. Бір ғана айырмашылық бар.
Dialogue: 0,0:15:09.82,0:15:11.87,Default,,0,0,0,,Жарайды, бейбақтар.
Dialogue: 0,0:15:11.87,0:15:16.90,Default,,0,0,0,,Мен ертең көк айдаһарды іздей бастаймын, демалыңыз.
Dialogue: 0,0:15:16.90,0:15:19.05,Default,,0,0,0,,Қайырлы түн, солай ма? Мұнда.
Dialogue: 0,0:15:19.56,0:15:21.41,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:15:20.97,0:15:22.30,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:15:21.65,0:15:23.18,Default,,0,0,0,,Ақ жылан
Dialogue: 0,0:15:30.84,0:15:33.05,Default,,0,0,0,,Таз
Dialogue: 0,0:15:33.83,0:15:36.47,Default,,0,0,0,,Киджа Әдемі жүзге ие болу қиын
Dialogue: 0,0:15:37.30,0:15:39.41,Default,,0,0,0,,Көрінбейтін жерлер
Dialogue: 0,0:15:39.41,0:15:41.46,Default,,0,0,0,,Эй, сенің арқаңда қате бар.
Dialogue: 0,0:15:42.27,0:15:45.18,Default,,0,0,0,,Киджа, күт, бұл Хакудің өтірігі.
Dialogue: 0,0:15:45.18,0:15:48.23,Default,,0,0,0,,Тыныш болыңдар, көңілді аңдар.
Dialogue: 0,0:15:48.81,0:15:52.14,Default,,0,0,0,,Жарайды, мен қазір адам ауылына кіремін.
Dialogue: 0,0:15:52.14,0:15:55.56,Default,,0,0,0,,Бұл Өрт тайпасының жері, сондықтан ол ерекшеленбейді.
Dialogue: 0,0:15:55.56,0:15:57.43,Default,,0,0,0,,Иә
Dialogue: 0,0:15:58.94,0:16:00.45,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:16:03.65,0:16:04.96,Default,,0,0,0,,Кижа
Dialogue: 0,0:16:06.76,0:16:08.14,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:16:08.14,0:16:10.76,Default,,0,0,0,,Бұл оңай емес, солай ма?
Dialogue: 0,0:16:10.76,0:16:12.90,Default,,0,0,0,,Сонда келесі қадам осы жерден 10 миль...
Dialogue: 0,0:16:12.90,0:16:14.98,Default,,0,0,0,,Күте тұрыңыз, бұл жақсы емес.
Dialogue: 0,0:16:14.98,0:16:18.01,Default,,0,0,0,,От руының әскери полигоны ретінде қызмет етті.
Dialogue: 0,0:16:18.87,0:16:20.34,Default,,0,0,0,,Міне, міне.
Dialogue: 0,0:16:20.34,0:16:22.29,Default,,0,0,0,,Жақында әзірленді
Dialogue: 0,0:16:23.23,0:16:25.32,Default,,0,0,0,,Мен сонда барғанымда қорқынышты болды.
Dialogue: 0,0:16:25.32,0:16:27.43,Default,,0,0,0,,Кижа, не болды?
Dialogue: 0,0:16:27.43,0:16:28.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:28.72,0:16:29.96,Default,,0,0,0,,Шешілді
Dialogue: 0,0:16:29.96,0:16:33.07,Default,,0,0,0,,Бұл біраз серуендеу, бірақ мен оны үш ықтимал орынға қысқарттым.
Dialogue: 0,0:16:33.07,0:16:34.98,Default,,0,0,0,,Ол жерде ауыл бар шығар.
Dialogue: 0,0:16:34.98,0:16:36.25,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:16:36.25,0:16:38.41,Default,,0,0,0,,Таңқаларлық егжей-тегжейлі Раиджу
Dialogue: 0,0:16:38.41,0:16:40.85,Default,,0,0,0,,Әйтеуір генерал болған.
Dialogue: 0,0:16:40.85,0:16:44.50,Default,,0,0,0,,Олар әр тайпаның әскеріндегі өзгерістерге сезімтал.
Dialogue: 0,0:16:44.50,0:16:45.90,Default,,0,0,0,,Келесі жолы айтыңыз
Dialogue: 0,0:16:45.90,0:16:47.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:47.72,0:16:49.17,Default,,0,0,0,,Онда барайық.
Dialogue: 0,0:16:56.87,0:16:58.07,Default,,0,0,0,,Кижа
Dialogue: 0,0:16:59.54,0:17:01.05,Default,,0,0,0,,Мұнда да жоқ
Dialogue: 0,0:17:04.92,0:17:06.07,Default,,0,0,0,,Мұнда да
Dialogue: 0,0:17:12.61,0:17:14.52,Default,,0,0,0,,Киджа Доу
Dialogue: 0,0:17:17.65,0:17:19.78,Default,,0,0,0,,Бұл да жақсы емес пе?
Dialogue: 0,0:17:21.14,0:17:23.16,Default,,0,0,0,,Соңында екінші жағынан
Dialogue: 0,0:17:23.16,0:17:25.18,Default,,0,0,0,,Сол жерде кездескенше
Dialogue: 0,0:17:25.18,0:17:28.74,Default,,0,0,0,,Біртүрлі екен, мен ол жерлерге бардым.
Dialogue: 0,0:17:28.74,0:17:32.50,Default,,0,0,0,,Менің ойымша, Сейрю шекарадан өткен жоқ.
Dialogue: 0,0:17:32.50,0:17:35.18,Default,,0,0,0,,Мұрның біткен болуы керек, Ақ жылан.
Dialogue: 0,0:17:35.18,0:17:37.72,Default,,0,0,0,,Бұл тек мұрынмен иіскеу емес.
Dialogue: 0,0:17:38.78,0:17:42.22,Default,,0,0,0,,Ханшайым, аяғың ауырды ма?
Dialogue: 0,0:17:42.67,0:17:45.54,Default,,0,0,0,,Жарайды, мен аздап шаршадым.
Dialogue: 0,0:17:46.63,0:17:47.74,Default,,0,0,0,,…бізді ажырата алмайды!
Dialogue: 0,0:17:51.41,0:17:53.52,Default,,0,0,0,,Дәмді Бұл не?
Dialogue: 0,0:17:53.52,0:17:57.10,Default,,0,0,0,,Бива жеміс шарабы: Шаршағандықтан айығу үшін ішіңіз.
Dialogue: 0,0:17:57.10,0:18:00.49,Default,,0,0,0,,Мен сенің аяғыңа трефель кигіземін, сондықтан бүгін сенің демалыс күнің.
Dialogue: 0,0:18:00.49,0:18:03.38,Default,,0,0,0,,Юн керемет және білімді.
Dialogue: 0,0:18:07.81,0:18:12.04,Default,,0,0,0,,Мұндай жерде қалай ұйықтауға болады?
Dialogue: 0,0:18:13.90,0:18:15.85,Default,,0,0,0,,Барлығы шаршады.
Dialogue: 0,0:18:15.85,0:18:20.94,Default,,0,0,0,,Көп күн бойы тығылып, айналма жолдармен жүре бердім.
Dialogue: 0,0:18:20.94,0:18:26.05,Default,,0,0,0,,Төрт айдаһардың қайда екенін анық сезе алсам ғой.
Dialogue: 0,0:18:26.05,0:18:29.76,Default,,0,0,0,,Ханшайымды шаршатудың қажеті жоқ.
Dialogue: 0,0:18:29.76,0:18:33.06,Default,,0,0,0,,Хаку мен Юнның білімі мен даналығына арқа сүйеуден басқа амалым жоқ.
Dialogue: 0,0:18:34.92,0:18:36.10,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:18:36.72,0:18:40.65,Default,,0,0,0,,Көк айдаһар, айдаһар қанды ағайын
Dialogue: 0,0:18:40.65,0:18:42.41,Default,,0,0,0,,Мен сізге қоңырау шалып тұрмын.
Dialogue: 0,0:18:42.41,0:18:45.07,Default,,0,0,0,,Мәңгі, мәңгі...
Dialogue: 0,0:18:45.07,0:18:48.50,Default,,0,0,0,,Раббымыз бізді іздеп жатыр.
Dialogue: 0,0:18:48.50,0:18:51.41,Default,,0,0,0,,Ол да сонда күтіп тұрған шығар.
Dialogue: 0,0:18:51.41,0:18:53.74,Default,,0,0,0,,Ол патшаны аңсаса керек.
Dialogue: 0,0:18:59.43,0:19:01.65,Default,,0,0,0,,Сіз қанша уақыт ұйықтадыңыз?
Dialogue: 0,0:19:03.98,0:19:05.05,Default,,0,0,0,,Не?
Dialogue: 0,0:19:11.07,0:19:12.18,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:19:16.15,0:19:17.52,Default,,0,0,0,,Түн ортасында осылай
Dialogue: 0,0:19:17.52,0:19:18.76,Default,,0,0,0,,Ханшайым...
Dialogue: 0,0:19:19.70,0:19:20.78,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:19:21.74,0:19:24.03,Default,,0,0,0,,Ханшайым қай уақыттан бері садақ киді?
Dialogue: 0,0:19:24.03,0:19:27.10,Default,,0,0,0,,Уақытым болса, сені кездестірмес бұрын да.
Dialogue: 0,0:19:27.10,0:19:29.05,Default,,0,0,0,,Ең жоғары уақытта түнде 200 бөтелке
Dialogue: 0,0:19:29.05,0:19:29.76,Default,,0,0,0,,200...
Dialogue: 0,0:19:29.76,0:19:31.12,Default,,0,0,0,,Дауыс бермеңіз
Dialogue: 0,0:19:33.58,0:19:35.70,Default,,0,0,0,,Неліктен мұндай абайсыздық?
Dialogue: 0,0:19:35.70,0:19:38.92,Default,,0,0,0,,Мен осында болғандықтан, жекпе-жек өнерінің қажеті жоқ.
Dialogue: 0,0:19:39.54,0:19:43.16,Default,,0,0,0,,Мен осында болғандықтан, ханшайым, сізге ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:19:44.10,0:19:47.54,Default,,0,0,0,,Бірақ ханшайым дәрменсіз болғаны үшін өзін кешірмейді.
Dialogue: 0,0:19:48.32,0:19:51.36,Default,,0,0,0,,Әкесі өлтіріліп, қамалдан қашып кетті.
Dialogue: 0,0:19:51.36,0:19:54.16,Default,,0,0,0,,Сонда да осы дүниеде аман қалу үшін
Dialogue: 0,0:19:54.16,0:19:57.18,Default,,0,0,0,,Өздігімнен ешнәрсе істей алмағаным үшін ұяламын.
Dialogue: 0,0:19:57.18,0:19:59.52,Default,,0,0,0,,Не істеу керектігімен күресу
Dialogue: 0,0:19:59.52,0:20:03.12,Default,,0,0,0,,Ханшайымды қарумен тоқтатпайсың ба?
Dialogue: 0,0:20:03.85,0:20:05.87,Default,,0,0,0,,Мен сенің төбелескеніңді қаламаймын.
Dialogue: 0,0:20:06.70,0:20:10.16,Default,,0,0,0,,Бірақ, өкінішке орай, мен де оны көргім келеді.
Dialogue: 0,0:20:10.83,0:20:14.04,Default,,0,0,0,,Күрестің адам тәрізді бейнесі
Dialogue: 0,0:20:20.45,0:20:23.07,Default,,0,0,0,,Мұндай жәндіктер т.б. Жәндіктер т.б.
Dialogue: 0,0:20:25.12,0:20:29.72,Default,,0,0,0,,Мен көмектескім келетін адамға көмектескім келеді
Dialogue: 0,0:20:30.54,0:20:35.48,Default,,0,0,0,,Дәл қазір мені қорғап жатыр, бірақ бір күні мен сені қорғағым келеді.
Dialogue: 0,0:20:37.54,0:20:39.65,Default,,0,0,0,,Ол кісіде де солай.
Dialogue: 0,0:20:49.03,0:20:52.92,Default,,0,0,0,,Жарайды, бүгін мен сені мойныңнан ұстаймын, көк айдаһар.
Dialogue: 0,0:20:54.27,0:20:56.79,Default,,0,0,0,,Кижа Мен бүгін ұйықтай алдым.
Dialogue: 0,0:20:56.79,0:20:59.01,Default,,0,0,0,,Е, а, анау
Dialogue: 0,0:20:59.01,0:21:00.43,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:21:00.43,0:21:04.54,Default,,0,0,0,,Мен жабайы табиғатта лагерьде демалуға дағдыланбағандықтан, көптен бері демалмаған сияқты болдым.
Dialogue: 0,0:21:04.54,0:21:06.07,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:21:06.07,0:21:09.65,Default,,0,0,0,,Киджа сау болмаса, жол жүрмейді.
Dialogue: 0,0:21:11.43,0:21:12.76,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:21:13.41,0:21:17.05,Default,,0,0,0,,Менің пайдасы бар ма?
Dialogue: 0,0:21:17.56,0:21:21.14,Default,,0,0,0,,Әрине, Кижаның орнын басатын ешкім жоқ.
Dialogue: 0,0:21:24.45,0:21:27.18,Default,,0,0,0,,Не, жүрегім ауырды?
Dialogue: 0,0:21:27.18,0:21:30.50,Default,,0,0,0,,Айдаһардың қаны тағы да қозып бара жатқан шығар?
Dialogue: 0,0:21:30.96,0:21:32.10,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:32.10,0:21:33.18,Default,,0,0,0,,Юн
Dialogue: 0,0:21:33.18,0:21:36.14,Default,,0,0,0,,Бұл Сеирю но Сато. Бұл соқыр жер еді.
Dialogue: 0,0:21:36.14,0:21:40.50,Default,,0,0,0,,Мен ол жерде ешкім тұра алмайды деп ойладым, бірақ олар сонда болды.
Dialogue: 0,0:21:41.05,0:21:42.81,Default,,0,0,0,,Шекара шекарасы
Dialogue: 0,0:21:43.27,0:21:45.14,Default,,0,0,0,,Сол жартасты тауда.
Dialogue: 0,0:21:51.01,0:21:54.05,Default,,0,0,0,,Мына жерде көк айдаһар бар
Dialogue: 0,0:23:28.36,0:23:33.56,Default,,0,0,0,,Қараңғыда ұстаған қолым сондай жұмсақ әрі жылы еді.
Dialogue: 0,0:23:35.36,0:23:39.07,Default,,0,0,0,,Келесі жолы «Таң таңындағы Йона» 12-бөлім
Dialogue: 0,0:23:39.07,0:23:40.85,Default,,0,0,0,,Көзі байланған айдаһар
Dialogue: 0,0:23:42.35,0:23:47.35,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
