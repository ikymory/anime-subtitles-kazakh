Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.75,0:00:14.88,Default,,0,0,0,,Кастлевания
Dialogue: 0,0:00:24.14,0:00:28.06,Default,,0,0,0,,Белмонт отбасы сияқты ескі отбасылар...
Dialogue: 0,0:00:28.19,0:00:32.40,Default,,0,0,0,,Билікті пайдаланып, өз еркімен соғысты бастау
Dialogue: 0,0:00:33.11,0:00:34.65,Default,,0,0,0,,Кім кесіндіні алады?
Dialogue: 0,0:00:34.78,0:00:35.78,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:00:35.91,0:00:36.91,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:00:37.37,0:00:41.41,Default,,0,0,0,,Біз ақымақ жандармыз.
Dialogue: 0,0:00:42.20,0:00:43.54,Default,,0,0,0,,Сіз қай жерде дүниеге келдіңіз?
Dialogue: 0,0:00:43.79,0:00:45.62,Default,,0,0,0,,Ол сенің апаң.
Dialogue: 0,0:00:45.71,0:00:49.25,Default,,0,0,0,,Боқтан туғанбыз
Dialogue: 0,0:00:49.38,0:00:52.26,Default,,0,0,0,,Сен түкке тұрғысыз адамсың.
Dialogue: 0,0:00:52.92,0:00:56.63,Default,,0,0,0,,Тек аман қалу үшін күн сайын жұмыс істе
Dialogue: 0,0:00:56.76,0:01:01.14,Default,,0,0,0,,Бүкіл бай боқ кеңестер тамақ пен киім-кешек қамын ойламауы үшін.
Dialogue: 0,0:01:01.51,0:01:03.89,Default,,0,0,0,,Құлмен бірдей.
Dialogue: 0,0:01:04.43,0:01:08.40,Default,,0,0,0,,Мені үлкен қарт отбасылар иландырады.
Dialogue: 0,0:01:08.56,0:01:11.11,Default,,0,0,0,,Сыра ішуге бола ма?
Dialogue: 0,0:01:11.27,0:01:13.82,Default,,0,0,0,,Мен өзімді байқай бастағандай сезінемін.
Dialogue: 0,0:01:14.07,0:01:17.53,Default,,0,0,0,,Маған бәрібір, бірақ сенің ақшаң бар ма?
Dialogue: 0,0:01:30.88,0:01:31.63,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:32.50,0:01:33.96,Default,,0,0,0,,Кеудедегі белгі ше?
Dialogue: 0,0:01:35.13,0:01:36.38,Default,,0,0,0,,Бұл жай ғана көйлек
Dialogue: 0,0:01:36.80,0:01:38.64,Default,,0,0,0,,Тағы бір сусын
Dialogue: 0,0:01:38.89,0:01:43.10,Default,,0,0,0,,Сау болсаң далада ұйықтау салқын.
Dialogue: 0,0:01:43.47,0:01:45.27,Default,,0,0,0,,Бұл елтаңба, солай ма?
Dialogue: 0,0:01:46.02,0:01:47.27,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:01:47.56,0:01:48.85,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:01:49.02,0:01:51.86,Default,,0,0,0,,Бір ішіп болған соң кетем.
Dialogue: 0,0:01:51.98,0:01:54.28,Default,,0,0,0,,Бұл Белмонт отбасының елтаңбасы.
Dialogue: 0,0:01:54.48,0:01:55.53,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:01:56.19,0:01:58.40,Default,,0,0,0,,Қараңызшы, бұл ақша.
Dialogue: 0,0:01:59.16,0:02:01.32,Default,,0,0,0,,Эй, бұл Белмонт, солай ма?
Dialogue: 0,0:02:01.78,0:02:05.37,Default,,0,0,0,,Ол Белмонт отбасынан, солай ма?
Dialogue: 0,0:02:05.79,0:02:08.83,Default,,0,0,0,,Мен оларды ешқашан кездестірмедім
Dialogue: 0,0:02:09.08,0:02:10.08,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:02:10.25,0:02:14.50,Default,,0,0,0,,Бәріне Белмонт кінәлі.
Dialogue: 0,0:02:15.00,0:02:17.34,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:02:17.76,0:02:19.38,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:02:19.63,0:02:21.85,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:02:22.14,0:02:23.39,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:02:23.81,0:02:29.27,Default,,0,0,0,,Белмонт құбыжықтарды басқару үшін қара сиқырды қолданды.
Dialogue: 0,0:02:29.73,0:02:32.40,Default,,0,0,0,,Мен құбыжықпен соғыстым
Dialogue: 0,0:02:33.36,0:02:34.36,Default,,0,0,0,,Мен осылай естідім.
Dialogue: 0,0:02:34.94,0:02:37.24,Default,,0,0,0,,Бұл жай ғана көйлек
Dialogue: 0,0:02:37.49,0:02:41.36,Default,,0,0,0,,Белмонт отбасы шіркеуден шығарылды.
Dialogue: 0,0:02:41.66,0:02:45.95,Default,,0,0,0,,Жерінен қуылып, жерінен айырылғандар...
Dialogue: 0,0:02:46.04,0:02:48.50,Default,,0,0,0,,Өйткені олар шайтандар.
Dialogue: 0,0:02:48.71,0:02:49.71,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:02:49.96,0:02:53.33,Default,,0,0,0,,Енді бұл Дракула әлемі.
Dialogue: 0,0:02:53.54,0:02:55.71,Default,,0,0,0,,Кім кінәлі?
Dialogue: 0,0:02:55.80,0:02:57.51,Default,,0,0,0,,Мен емес
Dialogue: 0,0:02:57.80,0:03:00.38,Default,,0,0,0,,Белмондоның ізімен
Dialogue: 0,0:03:00.51,0:03:03.89,Default,,0,0,0,,Уоллахияда қара магия тарады
Dialogue: 0,0:03:04.39,0:03:07.64,Default,,0,0,0,,Кім кінәлі екені анық
Dialogue: 0,0:03:08.98,0:03:11.23,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:03:11.35,0:03:13.77,Default,,0,0,0,,Ол қазір жоғалады
Dialogue: 0,0:03:14.11,0:03:17.15,Default,,0,0,0,,Өзіңізбен бірге құбыжықтар әкелуді жоспарлап отырсыз ба?
Dialogue: 0,0:03:17.32,0:03:20.24,Default,,0,0,0,,Зәр шығаруға және ұйықтауға орын табыңыз
Dialogue: 0,0:03:20.53,0:03:22.74,Default,,0,0,0,,Мен сені еденде ұйықтауға рұқсат етемін.
Dialogue: 0,0:03:22.99,0:03:24.74,Default,,0,0,0,,Күрек жоқ.
Dialogue: 0,0:03:27.87,0:03:28.83,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:03:29.83,0:03:32.58,Default,,0,0,0,,Егер сіз мойындасаңыз, өзіңізді тез сезінесіз.
Dialogue: 0,0:03:33.21,0:03:34.21,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:03:34.42,0:03:36.21,Default,,0,0,0,,Назареттік Иса
Dialogue: 0,0:03:36.63,0:03:37.50,Default,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:03:37.75,0:03:40.76,Default,,0,0,0,,Менде қанжар мен қамшы бар...
Dialogue: 0,0:03:42.59,0:03:43.59,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:03:44.39,0:03:45.76,Default,,0,0,0,,Тревор Белмонт
Dialogue: 0,0:03:46.05,0:03:49.89,Default,,0,0,0,,Белмонт отбасының соңғы мүшесі.
Dialogue: 0,0:03:49.97,0:03:51.14,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:03:52.02,0:03:52.94,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:00.03,0:04:00.86,Default,,0,0,0,,Эй!
Dialogue: 0,0:04:05.41,0:04:07.16,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:04:20.46,0:04:23.30,Default,,0,0,0,,Егер сізге ұнаса...
Dialogue: 0,0:04:23.63,0:04:25.97,Default,,0,0,0,,Мен вампирлермен де соғыстым...
Dialogue: 0,0:04:30.10,0:04:30.97,Default,,0,0,0,,Жаса!
Dialogue: 0,0:04:37.11,0:04:40.40,Default,,0,0,0,,Таманы жайына қалдыр.
Dialogue: 0,0:04:52.95,0:04:54.75,Default,,0,0,0,,Мен Тревор Белмонтпын
Dialogue: 0,0:04:55.25,0:04:58.63,Default,,0,0,0,,Мен ешқашан адамдардан да, құбыжықтардан да жеңілген емеспін.
Dialogue: 0,0:05:03.84,0:05:04.84,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:05:14.68,0:05:15.85,Default,,0,0,0,,Тейе
Dialogue: 0,0:05:23.99,0:05:25.03,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:05:25.86,0:05:27.91,Default,,0,0,0,,Блять!
Dialogue: 0,0:05:29.32,0:05:31.16,Default,,0,0,0,,Есегіңнен қан кет
Dialogue: 0,0:05:31.24,0:05:32.70,Default,,0,0,0,,〝Grecit 24km〞
Dialogue: 0,0:05:32.70,0:05:35.87,Default,,0,0,0,,〝Grecit 24km〞
Dialogue: 0,0:05:32.70,0:05:35.87,Default,,0,0,0,,Олардың әрқайсысы жоғалып кетті.
Dialogue: 0,0:05:35.87,0:05:37.46,Default,,0,0,0,,〝Grecit 24km〞
Dialogue: 0,0:05:59.73,0:06:01.02,Default,,0,0,0,,Грешит?
Dialogue: 0,0:06:02.11,0:06:05.03,Default,,0,0,0,,Осы уақыттан кейін сіз біраз уақыт тамақ іше алмайсыз.
Dialogue: 0,0:06:05.74,0:06:08.78,Default,,0,0,0,,Келесі қала 60 километрден астам жерде.
Dialogue: 0,0:06:38.35,0:06:39.60,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:06:43.69,0:06:45.40,Default,,0,0,0,,Егер сіз кіре алмасаңыз...
Dialogue: 0,0:06:45.90,0:06:47.90,Default,,0,0,0,,Тіпті шыға алмаймын
Dialogue: 0,0:06:50.07,0:06:53.49,Default,,0,0,0,,Менің таңғы асымды бұзғың келмеді.
Dialogue: 0,0:07:26.98,0:07:31.03,Default,,0,0,0,,Боқтықты шығаратын болсаң, тым болмаса маған ескерту бер.
Dialogue: 0,0:07:38.20,0:07:42.33,Default,,0,0,0,,Тамақ алу үшін кәріз арқылы өтетінімді ешқашан ойламадым.
Dialogue: 0,0:07:43.00,0:07:44.38,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:09:22.68,0:09:24.35,Default,,0,0,0,,Бір данамен не сатып алуға болады?
Dialogue: 0,0:09:24.60,0:09:25.98,Default,,0,0,0,,Кептірілген ешкі еті
Dialogue: 0,0:09:26.73,0:09:28.40,Default,,0,0,0,,Сенің жүзіңді бірінші рет көріп тұрмын.
Dialogue: 0,0:09:28.48,0:09:29.94,Default,,0,0,0,,Саяхаттау
Dialogue: 0,0:09:30.19,0:09:31.73,Default,,0,0,0,,Маған ет сат
Dialogue: 0,0:09:31.90,0:09:33.61,Default,,0,0,0,,Қаладан тез кет
Dialogue: 0,0:09:34.11,0:09:36.03,Default,,0,0,0,,Ыңғайсыз жағдайға ұқсайды.
Dialogue: 0,0:09:36.45,0:09:37.82,Default,,0,0,0,,Қорғаныс ұйымы туралы не деуге болады?
Dialogue: 0,0:09:38.32,0:09:39.45,Default,,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:09:39.66,0:09:41.95,Default,,0,0,0,,Ертегіші бар.
Dialogue: 0,0:09:42.03,0:09:46.46,Default,,0,0,0,,Жындардан құтылудың жолы бар.
Dialogue: 0,0:10:06.73,0:10:09.98,Default,,0,0,0,,«Ұйқыдағы жауынгер» туралы аңыз.
Dialogue: 0,0:10:10.40,0:10:15.78,Default,,0,0,0,,Жүздеген жылдар бұрынғы батыр, қазір катакомбада ұйықтап жатыр.
Dialogue: 0,0:10:16.57,0:10:17.53,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:10:17.65,0:10:19.99,Default,,0,0,0,,Қажет болған жағдайда
Dialogue: 0,0:10:20.36,0:10:21.82,Default,,0,0,0,,Қайта тірілетініңізге сенімдімін
Dialogue: 0,0:10:21.91,0:10:22.83,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:23.37,0:10:24.20,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:24.45,0:10:28.04,Default,,0,0,0,,Бірақ жаңа епископ мұны мүлдем жоққа шығарады.
Dialogue: 0,0:10:28.25,0:10:33.17,Default,,0,0,0,,Ақылсыз сөз айтсаң, көзге түсесің.
Dialogue: 0,0:10:33.46,0:10:34.67,Default,,0,0,0,,Мұндай жағдайлар бола ма?
Dialogue: 0,0:10:35.13,0:10:39.18,Default,,0,0,0,,Жауынгердің көрінбеуіне әңгімеші кінәлі шығар.
Dialogue: 0,0:10:39.26,0:10:44.18,Default,,0,0,0,,Бізге қарсы тұра алмай, әр түнде құбыжықтар шабуыл жасайды.
Dialogue: 0,0:10:44.56,0:10:46.72,Default,,0,0,0,,Оны сіз үшін епископ шешеді.
Dialogue: 0,0:10:46.85,0:10:51.27,Default,,0,0,0,,Бұл қала тозақтай жақсы.
Dialogue: 0,0:10:51.65,0:10:54.23,Default,,0,0,0,,Бірақ егер бәрі епископтың соңынан еретін болса...
Dialogue: 0,0:10:54.32,0:10:58.40,Default,,0,0,0,,Тәртіп міндетті түрде қалпына келтіріледі.
Dialogue: 0,0:11:13.58,0:11:14.71,Default,,0,0,0,,Мен сізге ескерттім.
Dialogue: 0,0:11:15.17,0:11:17.13,Default,,0,0,0,,Білмеймін деме
Dialogue: 0,0:11:17.25,0:11:19.22,Default,,0,0,0,,Сіз мені тыңдамайсыз.
Dialogue: 0,0:11:19.30,0:11:21.38,Default,,0,0,0,,Сіз жауап беруге тырысып жатырсыз ба?
Dialogue: 0,0:11:21.63,0:11:23.72,Default,,0,0,0,,Жоқ, мені тыңдауларыңызды қалаймын.
Dialogue: 0,0:11:24.35,0:11:28.39,Default,,0,0,0,,Апаттың себебі біз емес екені анық.
Dialogue: 0,0:11:28.56,0:11:30.35,Default,,0,0,0,,Қатыспаңыз
Dialogue: 0,0:11:30.43,0:11:32.31,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:11:32.77,0:11:37.78,Default,,0,0,0,,Мен, діни қызметкер, көре алмайтын нәрсені сен көре аламын деп ойлайсың ба?
Dialogue: 0,0:11:37.90,0:11:39.49,Default,,0,0,0,,Сиқырдың күшімен?
Dialogue: 0,0:11:39.86,0:11:41.70,Default,,0,0,0,,Сиқыр жоқ
Dialogue: 0,0:11:41.99,0:11:44.16,Default,,0,0,0,,Мен қалаға көмектескім келеді.
Dialogue: 0,0:11:44.24,0:11:48.95,Default,,0,0,0,,Лас әңгімешілер шайтанды тартады
Dialogue: 0,0:11:49.08,0:11:53.04,Default,,0,0,0,,Достарыңды ертіп күн батқанша кетіңдер дедім.
Dialogue: 0,0:11:53.87,0:11:56.75,Default,,0,0,0,,Бірақ күн шығып жатыр
Dialogue: 0,0:11:57.25,0:12:00.17,Default,,0,0,0,,Жақсы ғибадат ет, қария.
Dialogue: 0,0:12:05.18,0:12:08.97,Default,,0,0,0,,Қартты өлтіру қорқынышты жеңілдетеді ме?
Dialogue: 0,0:12:09.31,0:12:12.85,Default,,0,0,0,,Мен білмеймін, бірақ мен өзімді жақсы сезінетін шығармын.
Dialogue: 0,0:12:25.82,0:12:27.03,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:12:27.41,0:12:28.53,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:12:28.83,0:12:31.62,Default,,0,0,0,,Мен тек таяқты алуға тырыстым.
Dialogue: 0,0:12:31.79,0:12:33.37,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:12:33.54,0:12:35.58,Default,,0,0,0,,Дін болғанымен, аузы жаман.
Dialogue: 0,0:12:36.13,0:12:37.79,Default,,0,0,0,,Тез дәрігерге барыңыз.
Dialogue: 0,0:12:37.88,0:12:39.50,Default,,0,0,0,,Мені өлтір
Dialogue: 0,0:12:39.80,0:12:42.76,Default,,0,0,0,,Мен діни қызметкерлерді жек көремін.
Dialogue: 0,0:12:42.84,0:12:45.59,Default,,0,0,0,,Әзіл емес, жек көремін.
Dialogue: 0,0:12:45.80,0:12:48.26,Default,,0,0,0,,Ендеше кетіңіз.
Dialogue: 0,0:12:48.47,0:12:50.10,Default,,0,0,0,,Тез өлтіріңіз
Dialogue: 0,0:12:50.31,0:12:52.52,Default,,0,0,0,,Бұл апат болады.
Dialogue: 0,0:12:57.90,0:13:01.48,Default,,0,0,0,,Сіз діни қызметкер болсаңыз да, сізде қызықты нәрселер бар.
Dialogue: 0,0:13:01.73,0:13:03.40,Default,,0,0,0,,Ұрының пышағы?
Dialogue: 0,0:13:04.45,0:13:09.03,Default,,0,0,0,,Соңғы кездері қолдарым көмескіленді, бірақ ішуді қойдым.
Dialogue: 0,0:13:09.33,0:13:10.66,Default,,0,0,0,,Сіз зардап шегесіз
Dialogue: 0,0:13:39.31,0:13:42.11,Default,,0,0,0,,Ер адамдарыңызбен шіркеуге оралыңыз.
Dialogue: 0,0:13:42.53,0:13:45.86,Default,,0,0,0,,Қарт пен оның достарын жайына қалдыр.
Dialogue: 0,0:13:50.12,0:13:53.49,Default,,0,0,0,,Зорлық-зомбылық қажет емес еді
Dialogue: 0,0:13:54.29,0:13:57.46,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:13:58.46,0:14:01.21,Default,,0,0,0,,Ол аға Кодориай ертегіші.
Dialogue: 0,0:14:01.46,0:14:06.22,Default,,0,0,0,,Мейірімділігіңіз бен байсалды мінез-құлқыңыз үшін рахмет.
Dialogue: 0,0:14:06.42,0:14:08.51,Default,,0,0,0,,Жарайсыз, ақсақал.
Dialogue: 0,0:14:08.97,0:14:11.10,Default,,0,0,0,,Мен сені лагерьге дейін ертіп барсам болады ма?
Dialogue: 0,0:14:11.26,0:14:14.85,Default,,0,0,0,,Біз қалада тұрамыз.
Dialogue: 0,0:14:15.14,0:14:19.31,Default,,0,0,0,,Бірақ мен сізді уақытша баспанаға жіберуге қуаныштымын.
Dialogue: 0,0:14:22.19,0:14:23.27,Default,,0,0,0,,Қанша адам?
Dialogue: 0,0:14:23.48,0:14:27.57,Default,,0,0,0,,11 адам, бірақ рас болса 12 адам болуы керек.
Dialogue: 0,0:14:28.36,0:14:30.53,Default,,0,0,0,,Бір адам жоғалып кетті.
Dialogue: 0,0:14:32.70,0:14:34.24,Default,,0,0,0,,Бұл үй
Dialogue: 0,0:14:34.70,0:14:38.41,Default,,0,0,0,,Ішке кіріп, достарыңызбен танысыңыз.
Dialogue: 0,0:14:41.83,0:14:44.34,Default,,0,0,0,,Ақсақал мен уайымдадым.
Dialogue: 0,0:14:44.55,0:14:46.84,Default,,0,0,0,,Көшеге шығуға әлі ерте
Dialogue: 0,0:14:46.92,0:14:51.22,Default,,0,0,0,,Қала тұрғындары көмекке мұқтаж
Dialogue: 0,0:14:52.30,0:14:55.47,Default,,0,0,0,,Христиан дін қызметкерімен кездесті
Dialogue: 0,0:14:55.56,0:14:56.85,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:14:57.10,0:14:58.73,Default,,0,0,0,,Ол маған көмектесті
Dialogue: 0,0:14:59.31,0:15:02.15,Default,,0,0,0,,Ыңғайсыз жағдай болып шықты.
Dialogue: 0,0:15:02.40,0:15:03.52,Default,,0,0,0,,Қалай болғанда да, әдеттегідей—
Dialogue: 0,0:15:03.69,0:15:07.03,Default,,0,0,0,,Мен оны өлтіре алмадым, өйткені оның қолы түсіп қалды.
Dialogue: 0,0:15:07.19,0:15:09.19,Default,,0,0,0,,Сіз күш қолдандыңыз ба?
Dialogue: 0,0:15:10.49,0:15:14.87,Default,,0,0,0,,Жастар сөзден гөрі іс-әрекетті жоғары бағалайды.
Dialogue: 0,0:15:14.99,0:15:18.70,Default,,0,0,0,,Сөз қолдану – ертегішінің мамандығы.
Dialogue: 0,0:15:18.95,0:15:20.16,Default,,0,0,0,,Сіз бізді білесіз бе?
Dialogue: 0,0:15:20.29,0:15:25.21,Default,,0,0,0,,Біз бір-бірімізді ұрпақтан бері білеміз, бірақ әкем бір кездері менімен соғысқан.
Dialogue: 0,0:15:25.29,0:15:27.25,Default,,0,0,0,,Ертегішілер төбелеседі, т.б.
Dialogue: 0,0:15:27.46,0:15:32.22,Default,,0,0,0,,Әкем ауызша тарихты жазып келуімді өтінді.
Dialogue: 0,0:15:32.89,0:15:37.14,Default,,0,0,0,,Біз бұл жағынан өте консервативтіміз.
Dialogue: 0,0:15:37.26,0:15:40.81,Default,,0,0,0,,Тарих тірі, бірақ қағаз өлі.
Dialogue: 0,0:15:41.31,0:15:42.56,Default,,0,0,0,,Тіпті тамақ?
Dialogue: 0,0:15:42.69,0:15:44.52,Default,,0,0,0,,Мен сусындарды жақсы көремін.
Dialogue: 0,0:15:44.77,0:15:46.69,Default,,0,0,0,,Су әкел
Dialogue: 0,0:15:47.07,0:15:49.65,Default,,0,0,0,,Мен одан аулақ боламын...
Dialogue: 0,0:15:50.19,0:15:52.57,Default,,0,0,0,,Неліктен мұнда тұрасың?
Dialogue: 0,0:15:53.16,0:15:57.24,Default,,0,0,0,,Ертегішілер керек жерде, керек уақытта өмір сүреді.
Dialogue: 0,0:15:57.41,0:16:01.71,Default,,0,0,0,,Олар кезбе адамдар болуы керек, бірақ олар көптен бері осында.
Dialogue: 0,0:16:02.00,0:16:03.21,Default,,0,0,0,,Акихабарадан кет, түсіндің бе?!
Dialogue: 0,0:16:03.33,0:16:05.96,Default,,0,0,0,,Шабуылға себеп болды деген қауесет естідім.
Dialogue: 0,0:16:06.09,0:16:09.34,Default,,0,0,0,,Шіркеу қала тұрғындарын шабыттандырады
Dialogue: 0,0:16:09.42,0:16:11.88,Default,,0,0,0,,Фактілерден назарын аудару
Dialogue: 0,0:16:12.13,0:16:16.14,Default,,0,0,0,,Дүниедегі құбыжықтардың пайда болуына шіркеу жауапты.
Dialogue: 0,0:16:16.22,0:16:17.39,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:17.51,0:16:20.68,Default,,0,0,0,,1 жыл бұрын Ертегіші куә болды
Dialogue: 0,0:16:20.93,0:16:24.65,Default,,0,0,0,,Шіркеу Дракуланың әйелін өртеп жіберді.
Dialogue: 0,0:16:24.77,0:16:25.77,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:16:26.36,0:16:28.19,Default,,0,0,0,,Өзіңнің жалғыз сатылатын жерің – жастығың екенін көрсеткің келе ме? Енді жас емессің ғой
Dialogue: 0,0:16:28.82,0:16:30.61,Default,,0,0,0,,Сұраққа жауап бермеу
Dialogue: 0,0:16:38.33,0:16:43.62,Default,,0,0,0,,Грешиттегі тәртіп құлдырайды, адамдар емделмейді немесе көмек көрсетілмейді.
Dialogue: 0,0:16:44.16,0:16:48.71,Default,,0,0,0,,Ертегішілер адамдарды қиыншылықта жалғыз қалдырмауы керек.
Dialogue: 0,0:16:49.63,0:16:51.21,Default,,0,0,0,,Демек, тағы бір Кира пайда болды.
Dialogue: 0,0:16:51.38,0:16:53.05,Default,,0,0,0,,Маған бәрін айтып беріңізші?
Dialogue: 0,0:16:55.30,0:16:58.89,Default,,0,0,0,,Ертегішілерден қалған ескі әңгіме бар.
Dialogue: 0,0:16:59.10,0:17:00.76,Default,,0,0,0,,Аңызға айналған дерлік
Dialogue: 0,0:17:00.89,0:17:02.14,Default,,0,0,0,,Маған ертегілер ұнайды.
Dialogue: 0,0:17:02.56,0:17:06.06,Default,,0,0,0,,Құтқарушы Грешиттің астында ұйықтап жатыр.
Dialogue: 0,0:17:06.44,0:17:09.69,Default,,0,0,0,,Батыр оянады...
Dialogue: 0,0:17:09.98,0:17:13.15,Default,,0,0,0,,Жерге қараңғылық келді, құтқарылатын уақыт келді.
Dialogue: 0,0:17:13.36,0:17:14.65,Default,,0,0,0,,Қазірдің өзінде тыңдалды
Dialogue: 0,0:17:15.15,0:17:18.57,Default,,0,0,0,,Бұл «Ұйқыдағы жауынгер» деп аталатын жергілікті аңыз.
Dialogue: 0,0:17:18.74,0:17:21.45,Default,,0,0,0,,Ыңғайлы әңгіме сияқты.
Dialogue: 0,0:17:21.70,0:17:24.29,Default,,0,0,0,,Біз туралы не білесіз?
Dialogue: 0,0:17:24.62,0:17:26.12,Default,,0,0,0,,Мен Белмонтпын
Dialogue: 0,0:17:27.17,0:17:33.63,Default,,0,0,0,,Саяхат кезінде білім мен тарихты жинайсың.
Dialogue: 0,0:17:34.26,0:17:39.72,Default,,0,0,0,,Белгісіз білімге ие болып, сиқырды қолданатындар бар дейді.
Dialogue: 0,0:17:39.89,0:17:42.93,Default,,0,0,0,,Белмонт отбасы жойылған жоқ па?
Dialogue: 0,0:17:43.18,0:17:48.60,Default,,0,0,0,,Ата қонысы өртеніп, жер аударылды.
Dialogue: 0,0:17:48.85,0:17:50.94,Default,,0,0,0,,Сиқырдың бар екенін білесің бе?
Dialogue: 0,0:17:51.61,0:17:55.61,Default,,0,0,0,,Онда бұл міндетті түрде өткен тарих емес.
Dialogue: 0,0:17:55.94,0:17:58.41,Default,,0,0,0,,(азаматтардың қошемет шапалақтары)
Dialogue: 0,0:17:59.20,0:18:04.50,Default,,0,0,0,,Сиқыршылардың білуі бойынша уақыт абсолютті емес.
Dialogue: 0,0:18:05.16,0:18:08.62,Default,,0,0,0,,Болашақтың оқиғалары айтылуы мүмкін
Dialogue: 0,0:18:08.75,0:18:12.59,Default,,0,0,0,,Сіз жер астында ұйықтап жатқан құтқарушыға сенесіз...
Dialogue: 0,0:18:13.13,0:18:14.46,Default,,0,0,0,,Сіз күтіп тұрсыз ба?
Dialogue: 0,0:18:14.67,0:18:16.59,Default,,0,0,0,,Бір серік іздеуге шығады.
Dialogue: 0,0:18:16.76,0:18:19.22,Default,,0,0,0,,Ал жоқ па?
Dialogue: 0,0:18:19.30,0:18:20.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:20.93,0:18:25.14,Default,,0,0,0,,Мен шіркеудің батыс жағындағы катакомбаларға бардым, бірақ...
Dialogue: 0,0:18:25.52,0:18:26.85,Default,,0,0,0,,Қайтып келмейді
Dialogue: 0,0:18:27.10,0:18:29.39,Default,,0,0,0,,Қаладағы маңызды адамдармен сөйлесуім керек пе?
Dialogue: 0,0:18:29.48,0:18:31.69,Default,,0,0,0,,Бірінші шабуылда қаза тапты
Dialogue: 0,0:18:32.36,0:18:34.86,Default,,0,0,0,,Біздің ізденісіміз қиыншылықтардан өтуде.
Dialogue: 0,0:18:35.61,0:18:38.32,Default,,0,0,0,,Айтпақшы, қандай жоспарларыңыз бар?
Dialogue: 0,0:18:38.70,0:18:42.91,Default,,0,0,0,,Тамақ пен ішімдік тауып, әрі қарай жүріңіз.
Dialogue: 0,0:18:43.08,0:18:43.83,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:18:43.91,0:18:48.50,Default,,0,0,0,,Мүмкін мен биік ағашқа шығып, шоуды тамашалайтын шығармын.
Dialogue: 0,0:18:49.33,0:18:52.71,Default,,0,0,0,,Жақсы адамдар қатыгездікпен өледі
Dialogue: 0,0:18:53.21,0:18:55.05,Default,,0,0,0,,Сізді аямайсыз ба?
Dialogue: 0,0:18:55.30,0:18:57.42,Default,,0,0,0,,Шіркеу мұны қалайды
Dialogue: 0,0:18:58.01,0:19:02.68,Default,,0,0,0,,Құбыжық тек менің отбасым ғана қарсы тұра алды.
Dialogue: 0,0:19:03.22,0:19:06.60,Default,,0,0,0,,Олар өз бетінше күрескісі келді.
Dialogue: 0,0:19:06.68,0:19:11.31,Default,,0,0,0,,Оны Уоллахия халқы таңдаған жоқ.
Dialogue: 0,0:19:11.48,0:19:15.07,Default,,0,0,0,,Жаман адамдар билікке жетсін...
Dialogue: 0,0:19:15.19,0:19:18.15,Default,,0,0,0,,Жұрт үнсіз қарап тұрды.
Dialogue: 0,0:19:18.74,0:19:20.28,Default,,0,0,0,,Таңдау болды
Dialogue: 0,0:19:20.45,0:19:26.03,Default,,0,0,0,,Биік ағашқа өрмелеп, біздің өлгенімізді бақылаңыз.
Dialogue: 0,0:19:26.16,0:19:27.41,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:19:28.04,0:19:31.04,Default,,0,0,0,,Қаладан шығып, оңтүстікке қарай жүріңіз.
Dialogue: 0,0:19:31.17,0:19:32.75,Default,,0,0,0,,Ақсақалдың немересі...
Dialogue: 0,0:19:33.08,0:19:34.04,Default,,0,0,0,,айтады
Dialogue: 0,0:19:34.13,0:19:36.50,Default,,0,0,0,,Хабарсыз кеткен ақсақалдың немересі.
Dialogue: 0,0:19:37.05,0:19:41.97,Default,,0,0,0,,Жерлеусіз кете алмаймын.
Dialogue: 0,0:19:42.59,0:19:45.26,Default,,0,0,0,,Мен қаладағы адамдар үшін тұрамын.
Dialogue: 0,0:19:45.47,0:19:47.43,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:19:48.06,0:19:51.10,Default,,0,0,0,,Бірақ үмітсіз емес...
Dialogue: 0,0:19:51.23,0:19:55.23,Default,,0,0,0,,Жақсылық үшін ғана өлме...
Dialogue: 0,0:19:55.44,0:19:57.32,Default,,0,0,0,,Немеремнің мәйіті үшін бе?
Dialogue: 0,0:19:58.69,0:20:00.57,Default,,0,0,0,,Олай деуге болады
Dialogue: 0,0:20:07.45,0:20:11.75,Default,,0,0,0,,Немеремді тапсаң, кетесің бе?
Dialogue: 0,0:20:12.37,0:20:13.83,Default,,0,0,0,,Қала сыртында күтіңіз
Dialogue: 0,0:20:14.00,0:20:19.09,Default,,0,0,0,,Халық көмегі қала толығымен жойылғаннан кейін ғана келеді.
Dialogue: 0,0:20:19.17,0:20:20.26,Default,,0,0,0,,Неге іздеп жүрсіз?
Dialogue: 0,0:20:21.76,0:20:25.59,Default,,0,0,0,,Жақсы адамдар сізге шабуыл жасау үшін келеді.
Dialogue: 0,0:20:26.39,0:20:30.60,Default,,0,0,0,,Мен бүгін таңертең базарда геноцид жоспары бар екенін естідім.
Dialogue: 0,0:20:30.77,0:20:32.94,Default,,0,0,0,,Сұрақтарға жауап бермеу
Dialogue: 0,0:20:33.06,0:20:37.73,Default,,0,0,0,,Мен сенің туылғаның үшін қудалаудың қандай екенін түсінемін.
Dialogue: 0,0:20:38.02,0:20:40.61,Default,,0,0,0,,Немеремді тапсам...
Dialogue: 0,0:20:41.40,0:20:43.65,Default,,0,0,0,,Кеш батқанда қаладан шығасың ба?
Dialogue: 0,0:20:44.66,0:20:47.45,Default,,0,0,0,,Егер бұл іздеу шарты болса -
Dialogue: 0,0:20:48.45,0:20:49.28,Default,,0,0,0,,Келісемін
Dialogue: 0,0:20:53.21,0:20:54.29,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:20:54.96,0:20:57.46,Default,,0,0,0,,Сыртқа шықпаңыз
Dialogue: 0,0:20:57.58,0:20:59.46,Default,,0,0,0,,Мен осы үйдемін
Dialogue: 0,0:20:59.80,0:21:00.80,Default,,0,0,0,,Белмонт
Dialogue: 0,0:21:02.05,0:21:04.72,Default,,0,0,0,,Біз қорқатынымыз өлім емес
Dialogue: 0,0:21:05.51,0:21:08.80,Default,,0,0,0,,Барыңды бермей өмір сүру
Dialogue: 0,0:21:10.47,0:21:11.64,Default,,0,0,0,,Қызық емес
