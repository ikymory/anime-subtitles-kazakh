Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.55,0:00:14.84,Default,,0,0,0,,Кастлевания
Dialogue: 0,0:00:29.94,0:00:30.78,Default,,0,0,0,,Өте үлкен
Dialogue: 0,0:00:31.19,0:00:32.32,Default,,0,0,0,,Сиқыр!
Dialogue: 0,0:00:32.40,0:00:33.19,Default,,0,0,0,,Сиқыршылар
Dialogue: 0,0:00:33.28,0:00:34.20,Default,,0,0,0,,Сиқыр!
Dialogue: 0,0:01:00.39,0:01:03.10,Default,,0,0,0,,Бұл кім? Ертегіші өлді ме?
Dialogue: 0,0:01:05.60,0:01:07.19,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:01:08.73,0:01:12.48,Default,,0,0,0,,Тезірек оны күн батқанша өлтіріңіз.
Dialogue: 0,0:01:12.94,0:01:14.07,Default,,0,0,0,,Күн –
Dialogue: 0,0:01:14.78,0:01:17.11,Default,,0,0,0,,Қазірдің өзінде батып кетті
Dialogue: 0,0:01:30.54,0:01:33.38,Default,,0,0,0,,Алланың үйіне кіруге жол жоқ.
Dialogue: 0,0:01:34.51,0:01:37.38,Default,,0,0,0,,Бұл жерде Құдай жоқ
Dialogue: 0,0:01:38.13,0:01:40.72,Default,,0,0,0,,Бұл бос ғимарат.
Dialogue: 0,0:01:44.77,0:01:47.69,Default,,0,0,0,,Құдай әрбір қауымда бар
Dialogue: 0,0:01:48.27,0:01:51.44,Default,,0,0,0,,Құдайдың сүйіспеншілігі шексіз емес
Dialogue: 0,0:01:51.69,0:01:53.86,Default,,0,0,0,,Біз туралы...
Dialogue: 0,0:01:54.78,0:01:57.65,Default,,0,0,0,,Мен сені сүймеймін
Dialogue: 0,0:01:58.24,0:02:02.95,Default,,0,0,0,,Мен Құдайдың әмірлерін орындадым және өмірімді соларға арнадым.
Dialogue: 0,0:02:03.58,0:02:07.79,Default,,0,0,0,,Сенің әрекетіңнен Құдайдың өзі жиіркенеді.
Dialogue: 0,0:02:07.87,0:02:11.21,Default,,0,0,0,,Мен Грешит епископымын.
Dialogue: 0,0:02:11.58,0:02:15.21,Default,,0,0,0,,Біздің пайда болу себебімізді Құдай біледі.
Dialogue: 0,0:02:15.67,0:02:18.34,Default,,0,0,0,,Мұның бәрі сіздің жауапкершілігіңіз.
Dialogue: 0,0:02:18.55,0:02:19.84,Default,,0,0,0,,Ол әйел бақсы
Dialogue: 0,0:02:20.43,0:02:23.56,Default,,0,0,0,,Сіз шіркеуде жатсыз ба?
Dialogue: 0,0:02:24.14,0:02:26.93,Default,,0,0,0,,Құдай мені тастап кетеді деген мағына бар.
Dialogue: 0,0:02:27.52,0:02:29.64,Default,,0,0,0,,Бірақ біз қарыздармыз.
Dialogue: 0,0:02:29.73,0:02:30.65,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:02:31.48,0:02:33.61,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:02:34.82,0:02:37.94,Default,,0,0,0,,Ол мені жерге шақырды.
Dialogue: 0,0:02:42.45,0:02:46.04,Default,,0,0,0,,Мен сені сүйіп көрейін
Dialogue: 0,0:03:35.00,0:03:36.38,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:04:12.21,0:04:13.16,Default,,0,0,0,,Бұл бақсы.
Dialogue: 0,0:04:13.71,0:04:15.96,Default,,0,0,0,,Жоқ, әңгімеші.
Dialogue: 0,0:04:16.08,0:04:17.59,Default,,0,0,0,,Мен сиқырды қолдансам да...
Dialogue: 0,0:04:17.67,0:04:20.26,Default,,0,0,0,,Шайтанға қызмет етпеу
Dialogue: 0,0:04:34.64,0:04:36.56,Default,,0,0,0,,Сіз сиқырды жасырдыңыз.
Dialogue: 0,0:04:36.65,0:04:37.98,Default,,0,0,0,,Сұралмады
Dialogue: 0,0:04:38.06,0:04:43.44,Default,,0,0,0,,Катакомбаға не үшін барғаныңызды енді білдім.
Dialogue: 0,0:04:43.99,0:04:45.15,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:04:45.57,0:04:47.45,Default,,0,0,0,,Саған сенбеймін-
Dialogue: 0,0:04:47.70,0:04:49.20,Default,,0,0,0,,Мен өзім күресемін
Dialogue: 0,0:04:49.70,0:04:50.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:52.87,0:04:53.87,Default,,0,0,0,,Сіз
Dialogue: 0,0:04:55.00,0:04:57.13,Default,,0,0,0,,Мені тез өлтір
Dialogue: 0,0:04:57.29,0:04:58.17,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:58.58,0:05:01.80,Default,,0,0,0,,Сен екеуміз ғана күресейік
Dialogue: 0,0:05:02.42,0:05:05.26,Default,,0,0,0,,Бұйрық бергенде сенімді болыңыз.
Dialogue: 0,0:05:05.34,0:05:08.68,Default,,0,0,0,,Кісі өлтіруге жазықсыз адамдарды тарту
Dialogue: 0,0:05:09.18,0:05:10.93,Default,,0,0,0,,Бірақ жалғыз?
Dialogue: 0,0:05:11.31,0:05:12.43,Default,,0,0,0,,Сашимен жекпе-жек
Dialogue: 0,0:05:13.43,0:05:15.35,Default,,0,0,0,,Сізде қару бар.
Dialogue: 0,0:05:15.85,0:05:21.36,Default,,0,0,0,,Қала тұрғындарының алдында қылышыңды суырып көрдің бе?
Dialogue: 0,0:05:24.19,0:05:27.86,Default,,0,0,0,,Сен ұзын қылышсың, мен қысқа қылышпын.
Dialogue: 0,0:05:28.28,0:05:29.20,Default,,0,0,0,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:05:31.37,0:05:32.70,Default,,0,0,0,,Жүр.
Dialogue: 0,0:05:33.45,0:05:37.04,Default,,0,0,0,,Бүгін таңертең қарт адамды азаптадың.
Dialogue: 0,0:05:39.75,0:05:45.42,Default,,0,0,0,,Ертегішілер туралы, Еш ойланбастан өтірік айтады.
Dialogue: 0,0:05:45.67,0:05:47.84,Default,,0,0,0,,Құбыжықты әкелді
Dialogue: 0,0:05:47.93,0:05:49.26,Default,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,0:05:49.55,0:05:54.22,Default,,0,0,0,,Олар қаладағы адамдарға көмектесу үшін қалды.
Dialogue: 0,0:05:54.43,0:05:58.39,Default,,0,0,0,,Құбыжық сол епископтың арқасында пайда болды.
Dialogue: 0,0:05:58.60,0:06:03.44,Default,,0,0,0,,Барлығы қорғансыз әйелді өлтіруден басталды.
Dialogue: 0,0:06:03.65,0:06:05.74,Default,,0,0,0,,Сіз бәрін өлтіруші етесіз бе?
Dialogue: 0,0:06:06.24,0:06:09.36,Default,,0,0,0,,Мұндағы жалғыз кінәсіз адам...
Dialogue: 0,0:06:10.66,0:06:11.62,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:06:28.93,0:06:30.51,Default,,0,0,0,,Құбыжықтар келе жатыр
Dialogue: 0,0:06:39.60,0:06:42.65,Default,,0,0,0,,Шаршының артқы жағына өтіңіз.
Dialogue: 0,0:06:44.65,0:06:47.19,Default,,0,0,0,,Найза ұстағандар алға жылжиды
Dialogue: 0,0:06:47.69,0:06:49.61,Default,,0,0,0,,Сонымен... неге?
Dialogue: 0,0:06:49.90,0:06:52.95,Default,,0,0,0,,Мен ғана күресуді біледі
Dialogue: 0,0:06:53.07,0:06:57.66,Default,,0,0,0,,Ұзын қарулары барлар алға шықсын.
Dialogue: 0,0:06:57.87,0:07:00.92,Default,,0,0,0,,Алдыңғы қатарда 6 адам, артқы қатарда 6 адам
Dialogue: 0,0:07:01.08,0:07:03.42,Default,,0,0,0,,Өзіңізді ұстаңыз
Dialogue: 0,0:07:03.75,0:07:04.92,Default,,0,0,0,,Діни қызметкерді қажет етеді
Dialogue: 0,0:07:05.00,0:07:07.59,Default,,0,0,0,,Шіркеу ресми түрде тағайындайды
Dialogue: 0,0:07:11.05,0:07:14.93,Default,,0,0,0,,Қолыңызды жинап, жақын жердегі құдықтан су алыңыз.
Dialogue: 0,0:07:15.01,0:07:18.18,Default,,0,0,0,,Құбыжықтың күшін қасиетті сумен әлсіретіңіз
Dialogue: 0,0:07:18.47,0:07:19.23,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:07:19.31,0:07:20.10,Default,,0,0,0,,Шифр
Dialogue: 0,0:07:20.18,0:07:20.77,Default,,0,0,0,,Не?
Dialogue: 0,0:07:20.85,0:07:26.27,Default,,0,0,0,,Қабырға жасап, жауды майданнан келетіндей бағыттағым келеді.
Dialogue: 0,0:07:26.36,0:07:27.69,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:07:27.82,0:07:28.99,Default,,0,0,0,,Мұз туралы не деуге болады?
Dialogue: 0,0:07:29.11,0:07:31.65,Default,,0,0,0,,Оттан жақсы
Dialogue: 0,0:07:31.86,0:07:35.53,Default,,0,0,0,,Қолыңнан келген тұздың бәрін маған әкел.
Dialogue: 0,0:07:38.91,0:07:43.33,Default,,0,0,0,,Қолында қаруы бар тұзды жағады.
Dialogue: 0,0:07:43.42,0:07:44.29,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,0:08:00.18,0:08:01.56,Default,,0,0,0,,Шифр қабырғасы
Dialogue: 0,0:08:18.03,0:08:21.87,Default,,0,0,0,,Олар лайықты қасиетті су жасаған сияқты.
Dialogue: 0,0:08:22.66,0:08:25.58,Default,,0,0,0,,Найза отряды 4 қадам алға жылжиды.
Dialogue: 0,0:08:27.04,0:08:29.46,Default,,0,0,0,,Құбыжықтың қашу жолын кесіңіз
Dialogue: 0,0:08:33.88,0:08:35.64,Default,,0,0,0,,Найзаны жоғары көтеріп, артқы қатар
Dialogue: 0,0:08:36.51,0:08:37.64,Default,,0,0,0,,Кесу
Dialogue: 0,0:08:40.26,0:08:42.56,Default,,0,0,0,,Шайтанды тұзбен өлтіруге болады
Dialogue: 0,0:08:42.68,0:08:44.98,Default,,0,0,0,,Барлығын оқыт
Dialogue: 0,0:08:58.57,0:09:02.12,Default,,0,0,0,,Жындармен күресу үшін бағышталған қамшы.
Dialogue: 0,0:09:02.37,0:09:03.66,Default,,0,0,0,,Қылыш жасағы!
Dialogue: 0,0:09:27.56,0:09:29.69,Default,,0,0,0,,Біздің достарымыз көп.
Dialogue: 0,0:09:29.86,0:09:32.78,Default,,0,0,0,,Тозақтан шыққан әскер
Dialogue: 0,0:10:18.70,0:10:20.70,Default,,0,0,0,,Бұл катакомбалар.
Dialogue: 0,0:10:22.33,0:10:24.99,Default,,0,0,0,,Өткен жолғыға қарағанда тереңірек жер сияқты.
Dialogue: 0,0:11:52.83,0:11:54.29,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:12:54.27,0:12:55.44,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,0:13:21.34,0:13:22.84,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:13:22.92,0:13:26.22,Default,,0,0,0,,Грешитте жер астында жатқан құтқарушы.
Dialogue: 0,0:13:26.51,0:13:28.89,Default,,0,0,0,,Адамзатты Дракуладан құтқарыңыз
Dialogue: 0,0:13:29.80,0:13:33.81,Default,,0,0,0,,Сіз де аңызға айналған құтқарушыны іздеп жүрсіз бе?
Dialogue: 0,0:13:34.23,0:13:35.64,Default,,0,0,0,,Шұңқырға түсіп кетті
Dialogue: 0,0:13:36.31,0:13:39.65,Default,,0,0,0,,Дракула құбыжықтарды пайдаланады...
Dialogue: 0,0:13:39.73,0:13:42.86,Default,,0,0,0,,Сіз адамдарды жоймақшысыз ба?
Dialogue: 0,0:13:43.15,0:13:45.69,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,0:13:46.03,0:13:49.70,Default,,0,0,0,,Егер Дракула құбыжықты босатып жіберсе...
Dialogue: 0,0:13:49.95,0:13:51.87,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:13:52.37,0:13:53.95,Default,,0,0,0,,Бірақ бұл басқа сұрақ.
Dialogue: 0,0:13:54.04,0:13:54.87,Default,,0,0,0,,О
Dialogue: 0,0:13:55.16,0:14:01.38,Default,,0,0,0,,Егер сіз ұйықтап жатқан құтқарушы туралы айтып жатсаңыз, менің ойымша, бұл сізді емес.
Dialogue: 0,0:14:01.50,0:14:02.67,Default,,0,0,0,,Белмонт!
Dialogue: 0,0:14:03.05,0:14:04.63,Default,,0,0,0,,Мен нақты тұлғаны білемін.
Dialogue: 0,0:14:05.76,0:14:07.13,Default,,0,0,0,,Менің шынайы тұлғам қандай?
Dialogue: 0,0:14:08.34,0:14:09.47,Default,,0,0,0,,Вампир
Dialogue: 0,0:14:14.64,0:14:20.44,Default,,0,0,0,,Біз Дракуланы өлтірген адамға қарсы тұрамыз ба?
Dialogue: 0,0:14:20.73,0:14:23.61,Default,,0,0,0,,Әлде Дракуланың өзі ме?
Dialogue: 0,0:14:24.19,0:14:25.90,Default,,0,0,0,,Мен Дракула болсам ше?
Dialogue: 0,0:14:26.28,0:14:29.45,Default,,0,0,0,,Маған тісіңді көрсет
Dialogue: 0,0:14:29.57,0:14:32.62,Default,,0,0,0,,Сізді Белмонт деп атаған.
Dialogue: 0,0:14:32.95,0:14:35.12,Default,,0,0,0,,Мен Тревор Белмонтпын
Dialogue: 0,0:14:35.24,0:14:37.45,Default,,0,0,0,,Отбасының соңғы тірі қалғаны
Dialogue: 0,0:14:37.91,0:14:41.00,Default,,0,0,0,,Менің отбасым ұрпақтар бойы құбыжықтармен күресіп келеді.
Dialogue: 0,0:14:43.04,0:14:44.42,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:14:46.09,0:14:47.97,Default,,0,0,0,,Мен вампирлерді өлтірдім
Dialogue: 0,0:14:48.26,0:14:51.72,Default,,0,0,0,,Бұл жақсылар мені жек көретін болды.
Dialogue: 0,0:14:52.26,0:14:55.56,Default,,0,0,0,,Дракула қазір адамдарды өлтіріп жатыр.
Dialogue: 0,0:14:56.68,0:14:58.68,Default,,0,0,0,,Сіз бірдеңе жасағыңыз келе ме?
Dialogue: 0,0:15:00.69,0:15:03.94,Default,,0,0,0,,Шынымды айтсам, бәрібір.
Dialogue: 0,0:15:04.90,0:15:05.90,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:15:07.19,0:15:10.36,Default,,0,0,0,,Мен геноцидті тоқтатқым келеді.
Dialogue: 0,0:15:12.70,0:15:13.87,Default,,0,0,0,,(Норияки) Ах! (Джозеф) Хмм?
Dialogue: 0,0:15:14.66,0:15:17.95,Default,,0,0,0,,Енді мен сені өлтіруім керек.
Dialogue: 0,0:15:18.20,0:15:21.08,Default,,0,0,0,,Біз күткен
Dialogue: 0,0:15:21.54,0:15:24.04,Default,,0,0,0,,Бұл жігіт вампир...
Dialogue: 0,0:15:24.17,0:15:27.13,Default,,0,0,0,,Мен жүздеген жылдар бойы ұйықтаған сияқты емеспін.
Dialogue: 0,0:15:27.30,0:15:29.42,Default,,0,0,0,,Маған сенің сөйлегенің ұнамайды.
Dialogue: 0,0:15:29.63,0:15:34.05,Default,,0,0,0,,Бұл ескі ғимарат болғанымен, ол әлі де қолданыста және жұмыс істеп тұр.
Dialogue: 0,0:15:34.14,0:15:35.97,Default,,0,0,0,,Эй вампир
Dialogue: 0,0:15:36.26,0:15:40.10,Default,,0,0,0,,Қанша ұйықтағаныңызды айтыңыз
Dialogue: 0,0:15:40.89,0:15:42.39,Default,,0,0,0,,Қазір қай жыл?
Dialogue: 0,0:15:42.94,0:15:44.48,Default,,0,0,0,,1476
Dialogue: 0,0:15:44.61,0:15:46.19,Default,,0,0,0,,Бір жылға жуық
Dialogue: 0,0:15:46.57,0:15:47.44,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:47.52,0:15:50.32,Default,,0,0,0,,Ал егер бұл құтқарушы болса...
Dialogue: 0,0:15:50.44,0:15:54.66,Default,,0,0,0,,Жақсы ұйықтау үшін тұзақ құрмаңыз
Dialogue: 0,0:15:54.95,0:15:56.66,Default,,0,0,0,,Бұл төсек - саркофаг...
Dialogue: 0,0:15:56.83,0:15:58.45,Default,,0,0,0,,Тұзақтың мақсаты басқа.
Dialogue: 0,0:15:58.58,0:16:00.54,Default,,0,0,0,,Қауіпке ұшырау
Dialogue: 0,0:16:00.79,0:16:04.54,Default,,0,0,0,,Менің саған шабуыл жасау ойым жоқ еді.
Dialogue: 0,0:16:04.67,0:16:06.71,Default,,0,0,0,,Бұл да миссия сезімі ме?
Dialogue: 0,0:16:07.84,0:16:10.63,Default,,0,0,0,,Мен отбасымның жұмысын аяқтағым келеді.
Dialogue: 0,0:16:11.09,0:16:13.13,Default,,0,0,0,,Адамды қорғау
Dialogue: 0,0:16:14.09,0:16:15.55,Default,,0,0,0,,Мен сені өлтіруім керек пе?
Dialogue: 0,0:16:15.76,0:16:17.01,Default,,0,0,0,,Сіз істей аламын деп ойлайсыз ба?
Dialogue: 0,0:16:17.18,0:16:21.43,Default,,0,0,0,,Мүмкін бұл нағыз Белмонт отбасы болса мүмкін.
Dialogue: 0,0:16:26.52,0:16:27.86,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:16:28.02,0:16:29.69,Default,,0,0,0,,Белмонт, тоқтат.
Dialogue: 0,0:16:29.98,0:16:32.44,Default,,0,0,0,,Мұны ұшатын вампирге айт
Dialogue: 0,0:16:32.61,0:16:35.91,Default,,0,0,0,,Аузыңды ашсаң, арсыз адамсың.
Dialogue: 0,0:16:47.50,0:16:48.67,Default,,0,0,0,,Тез тұрыңыз
Dialogue: 0,0:16:52.76,0:16:54.55,Default,,0,0,0,,Жоқ, Белмонт.
Dialogue: 0,0:16:54.63,0:16:56.22,Default,,0,0,0,,Құтқарушы емес
Dialogue: 0,0:16:56.43,0:17:00.10,Default,,0,0,0,,Дракула сарайын кез келген жерге жылжытуға болады.
Dialogue: 0,0:17:00.26,0:17:02.64,Default,,0,0,0,,Бұл жер дәл осындай.
Dialogue: 0,0:17:04.02,0:17:06.10,Default,,0,0,0,,Дракула неге ұқсайды?
Dialogue: 0,0:17:06.23,0:17:11.40,Default,,0,0,0,,Білмеймін, бірақ сенің азуың бар еді, саркофагта ұйықтадың.
Dialogue: 0,0:18:20.39,0:18:22.89,Default,,0,0,0,,Бар төбелеске ұқсамайды.
Dialogue: 0,0:18:23.10,0:18:24.10,Default,,0,0,0,,Сапа жоқ.
Dialogue: 0,0:18:56.80,0:18:59.76,Default,,0,0,0,,Құдайға соңғы рет дұға еткіңіз келе ме?
Dialogue: 0,0:19:01.84,0:19:02.76,Default,,0,0,0,,О
Dialogue: 0,0:19:03.68,0:19:04.68,Default,,0,0,0,,Капыпа
Dialogue: 0,0:19:05.43,0:19:08.73,Default,,0,0,0,,Курткаңызды вампирдің ішкі мүшелерімен ластамаңыз
Dialogue: 0,0:19:09.14,0:19:09.98,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:19:14.36,0:19:16.53,Default,,0,0,0,,Тамағыңызды тістей алады
Dialogue: 0,0:19:16.86,0:19:19.95,Default,,0,0,0,,Мен мұны істесем де, қолым тоқтамайды.
Dialogue: 0,0:19:20.45,0:19:22.11,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:19:22.49,0:19:23.87,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:19:24.66,0:19:27.20,Default,,0,0,0,,Мақсат - сені өлтіру.
Dialogue: 0,0:19:28.04,0:19:30.62,Default,,0,0,0,,Аман қалсаң, қарғысқа ұшырайсың
Dialogue: 0,0:19:37.71,0:19:40.88,Default,,0,0,0,,Мен оны тістеп алғанша, күлге айналдырамын.
Dialogue: 0,0:19:41.55,0:19:43.72,Default,,0,0,0,,Мен аңызға айналған құтқарушымын ба?
Dialogue: 0,0:19:43.89,0:19:47.10,Default,,0,0,0,,Мен солай ойладым, бірақ ол құтқарушы.
Dialogue: 0,0:19:47.81,0:19:49.39,Default,,0,0,0,,Ертегіші сиқыршы?
Dialogue: 0,0:19:49.47,0:19:50.35,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:19:50.56,0:19:53.56,Default,,0,0,0,,Менің мақсатым да адамдарды қорғау.
Dialogue: 0,0:19:55.81,0:19:56.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:57.32,0:20:00.49,Default,,0,0,0,,Вампир аңшысы және сиқыршы
Dialogue: 0,0:20:01.86,0:20:02.70,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:20:04.53,0:20:06.33,Default,,0,0,0,,Мен Адриан Тепеспін
Dialogue: 0,0:20:07.03,0:20:09.16,Default,,0,0,0,,Алукард деп те аталады
Dialogue: 0,0:20:10.37,0:20:13.50,Default,,0,0,0,,Ол Дракула Влад Тепестің ұлы.
Dialogue: 0,0:20:14.17,0:20:17.75,Default,,0,0,0,,Грешиттің жертөлесінде бір жылға жуық ұйықтау.
Dialogue: 0,0:20:18.09,0:20:22.97,Default,,0,0,0,,Ол әкесін тоқтатпақ болғанда алған жарасын емдеп жатты.
Dialogue: 0,0:20:24.09,0:20:25.68,Default,,0,0,0,,Сіз ұйықтап жатқан жауынгерсіз бе?
Dialogue: 0,0:20:26.09,0:20:27.47,Default,,0,0,0,,Мен ертегіні білемін.
Dialogue: 0,0:20:27.97,0:20:32.02,Default,,0,0,0,,Менің ойымша, болашақ оқиғалар аңызға айналды.
Dialogue: 0,0:20:32.39,0:20:33.77,Default,,0,0,0,,Оқиға неден тұрады?
Dialogue: 0,0:20:34.48,0:20:35.60,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:20:36.06,0:20:39.36,Default,,0,0,0,,Аңшы мен данышпан жауынгерді табады.
Dialogue: 0,0:20:40.28,0:20:41.74,Default,,0,0,0,,Мен тыңдамаймын.
Dialogue: 0,0:20:42.11,0:20:45.28,Default,,0,0,0,,Сол үшін де атаң сені ұстады.
Dialogue: 0,0:20:45.95,0:20:47.74,Default,,0,0,0,,Мен ертегішілерді жек көремін.
Dialogue: 0,0:20:56.29,0:20:57.83,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:20:58.42,0:21:00.59,Default,,0,0,0,,Аңшы мен данышпанмен
Dialogue: 0,0:21:01.13,0:21:03.13,Default,,0,0,0,,Уоллахияны сақтаңыз
Dialogue: 0,0:21:04.05,0:21:06.89,Default,,0,0,0,,Дүние үшін әкемді жеңемін.
Dialogue: 0,0:21:07.80,0:21:08.85,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:11.68,0:21:13.81,Default,,0,0,0,,Менің анам мұны қалайды.
Dialogue: 0,0:21:15.73,0:21:20.52,Default,,0,0,0,,Түптеп келгенде, біз ата-баба тілегіне қарсы шыға алмаймыз.
Dialogue: 0,0:21:21.65,0:21:25.36,Default,,0,0,0,,Дракуланы жеңу үшін күш бересіз бе?
Dialogue: 0,0:21:26.99,0:21:29.70,Default,,0,0,0,,Әкесі өлуі керек
Dialogue: 0,0:21:30.83,0:21:31.83,Default,,0,0,0,,Үш адам-
Dialogue: 0,0:21:33.50,0:21:34.87,Default,,0,0,0,,Әкемді жеңейік
Dialogue: 0,0:22:40.19,0:22:41.36,Default,,0,0,0,,Жапон субтитрлері Харука Игучи
Dialogue: 0,0:22:42.86,0:22:48.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory