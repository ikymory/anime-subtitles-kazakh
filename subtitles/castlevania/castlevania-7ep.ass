Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.34,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:01:35.51,0:01:37.38,Default,,0,0,0,,Баспалдақ құлады.
Dialogue: 0,0:01:37.97,0:01:40.51,Default,,0,0,0,,Өрмелеудің жалғыз жолы - арқанмен.
Dialogue: 0,0:01:41.26,0:01:42.47,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:45.35,0:01:46.18,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:01:47.73,0:01:49.44,Default,,0,0,0,,Бұл жігіт қиыншылықта.
Dialogue: 0,0:01:57.49,0:01:59.49,Default,,0,0,0,,Маған арқан керек емес
Dialogue: 0,0:02:02.49,0:02:03.74,Default,,0,0,0,,Барайық
Dialogue: 0,0:03:29.25,0:03:34.08,Default,,0,0,0,,Мен құнды кітаптарды еріген мұзбен бүлдіргім келмейді.
Dialogue: 0,0:03:34.25,0:03:36.79,Default,,0,0,0,,Мен тым кеш сияқты сезінемін
Dialogue: 0,0:03:37.25,0:03:39.01,Default,,0,0,0,,Әлде... бұзылып қалған ба?
Dialogue: 0,0:03:43.43,0:03:44.93,Default,,0,0,0,,Бұл тамаша болды.
Dialogue: 0,0:03:45.05,0:03:46.72,Default,,0,0,0,,Ой~!
Dialogue: 0,0:03:47.10,0:03:50.60,Default,,0,0,0,,Шынайы өмірде көргенде өте әсерлі.
Dialogue: 0,0:03:51.60,0:03:53.02,Default,,0,0,0,,Мен кереметпін бе?
Dialogue: 0,0:03:53.77,0:03:55.10,Default,,0,0,0,,Бұл ең жақсы
Dialogue: 0,0:03:55.69,0:03:58.82,Default,,0,0,0,,Алукард Сіз дайынсыз ба?
Dialogue: 0,0:03:59.73,0:04:00.78,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:02.53,0:04:04.53,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:04:41.99,0:04:46.61,Default,,0,0,0,,Cipher және мен қолдау көрсетсек, Алукард шабуыл жасайды.
Dialogue: 0,0:04:47.16,0:04:47.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:52.29,0:04:53.16,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:44.87,0:09:46.12,Default,,0,0,0,,Менің ұлым...
Dialogue: 0,0:09:47.12,0:09:48.62,Default,,0,0,0,,Осы сарайдың ішінде?
Dialogue: 0,0:09:49.29,0:09:53.63,Default,,0,0,0,,Сиқыршы әйел мен аңшы да бірге.
Dialogue: 0,0:09:55.80,0:09:56.97,Default,,0,0,0,,Оқуға
Dialogue: 0,0:09:59.80,0:10:03.56,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:10:04.31,0:10:08.14,Default,,0,0,0,,Сіз өзіңіздің шектеулі өміріңізден бас тартасыз ба?
Dialogue: 0,0:10:08.73,0:10:12.73,Default,,0,0,0,,Өз талантың мен біліміңді қорғау
Dialogue: 0,0:10:12.90,0:10:14.19,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:14.61,0:10:19.95,Default,,0,0,0,,Мен жын балқытушымын, ал сен даналықтың кристалысың.
Dialogue: 0,0:10:21.74,0:10:24.62,Default,,0,0,0,,Сен ең жақсысың, Ысқақ.
Dialogue: 0,0:10:25.33,0:10:27.08,Default,,0,0,0,,Сенің жаның бар
Dialogue: 0,0:10:27.91,0:10:30.83,Default,,0,0,0,,Болашақ дүниеде сол жан...
Dialogue: 0,0:10:31.00,0:10:34.42,Default,,0,0,0,,Жалықтыратын білімнен әлдеқайда маңызды
Dialogue: 0,0:10:35.25,0:10:39.59,Default,,0,0,0,,Мен үшін жаныңды қисаң босқа кетеді.
Dialogue: 0,0:10:40.34,0:10:44.47,Default,,0,0,0,,Өміріңіздің қалай аяқталатынын өзіңіз шешесіз.
Dialogue: 0,0:10:46.68,0:10:49.69,Default,,0,0,0,,Өкінішке орай, бұл менің шешімім.
Dialogue: 0,0:10:59.36,0:11:02.11,Default,,0,0,0,,Жоқ, Дракула-сама.
Dialogue: 0,0:11:02.78,0:11:04.53,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:11:32.02,0:11:33.19,Default,,0,0,0,,Әке.
Dialogue: 0,0:11:34.90,0:11:36.02,Default,,0,0,0,,Ұлы
Dialogue: 0,0:11:38.23,0:11:40.03,Default,,0,0,0,,Соғыс аяқталды
Dialogue: 0,0:11:42.07,0:11:43.95,Default,,0,0,0,,Сіз шешесіз бе?
Dialogue: 0,0:11:45.87,0:11:49.58,Default,,0,0,0,,Ананың атымен соғыс аяқталады
Dialogue: 0,0:11:49.83,0:11:53.00,Default,,0,0,0,,Оның атымен шайқас жалғасуда
Dialogue: 0,0:11:53.67,0:11:56.29,Default,,0,0,0,,Мен әкемнің қалағанын істеуіне жол бермеймін.
Dialogue: 0,0:11:57.42,0:11:59.05,Default,,0,0,0,,Мен де қайғырдым...
Dialogue: 0,0:12:00.09,0:12:02.43,Default,,0,0,0,,Геноцидке жол берілмейді
Dialogue: 0,0:12:03.68,0:12:05.51,Default,,0,0,0,,Сіз мені тоқтата алмайсыз
Dialogue: 0,0:12:07.43,0:12:09.68,Default,,0,0,0,,Мен бұл жолы жалғыз емеспін
Dialogue: 0,0:13:00.82,0:13:02.61,Default,,0,0,0,,Шебер
Dialogue: 0,0:13:10.83,0:13:11.66,Default,,0,0,0,,Шифр
Dialogue: 0,0:13:15.75,0:13:18.29,Default,,0,0,0,,Сіз Белмонтсыз.
Dialogue: 0,0:13:22.88,0:13:24.92,Default,,0,0,0,,Сіздің кланыңыз аяқталды.
Dialogue: 0,0:14:51.01,0:14:55.85,Default,,0,0,0,,Morning Star қолданбасын пайдалану қиын.
Dialogue: 0,0:14:56.56,0:14:59.77,Default,,0,0,0,,Бірақ мен басқа вампирлер сияқты емеспін.
Dialogue: 0,0:14:59.94,0:15:03.31,Default,,0,0,0,,Адамның сиқырымен өлтірілмейді
Dialogue: 0,0:15:03.69,0:15:07.07,Default,,0,0,0,,Мен Дракула Влад Тепеспін
Dialogue: 0,0:15:07.23,0:15:09.11,Default,,0,0,0,,Өтінемін, мені қазір кешіріңіз.
Dialogue: 0,0:17:05.39,0:17:07.44,Default,,0,0,0,,Мені қазықпен пышақтайсың ба?
Dialogue: 0,0:17:07.81,0:17:09.06,Default,,0,0,0,,Эрен Еагерррррррр!!
Dialogue: 0,0:17:09.23,0:17:10.27,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:17:10.48,0:17:13.99,Default,,0,0,0,,Әкем мені өлтіре алмайды.
Dialogue: 0,0:17:14.90,0:17:16.95,Default,,0,0,0,,Мен қазірдің өзінде тастағым келсе де
Dialogue: 0,0:17:17.07,0:17:18.24,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:17:19.70,0:17:22.41,Default,,0,0,0,,Анаңмен бірге өлдің
Dialogue: 0,0:17:23.08,0:17:27.08,Default,,0,0,0,,Бұл соғыс суицид туралы ұзақ жазба ғана.
Dialogue: 0,0:17:31.55,0:17:35.34,Default,,0,0,0,,Сонда ол жүрекке жетпейді.
Dialogue: 0,0:17:42.77,0:17:44.89,Default,,0,0,0,,Жоғарыдан шу шықты.
Dialogue: 0,0:19:26.45,0:19:28.04,Default,,0,0,0,,Сіздің бөлмеңіз?
Dialogue: 0,0:20:00.24,0:20:01.53,Default,,0,0,0,,Менің балам
Dialogue: 0,0:20:03.16,0:20:04.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:05.74,0:20:07.74,Default,,0,0,0,,Баламды өлтірмекші болу
Dialogue: 0,0:20:13.21,0:20:16.59,Default,,0,0,0,,Лиза, мен ұлымды өлтіре жаздадым.
Dialogue: 0,0:20:18.09,0:20:22.55,Default,,0,0,0,,Екеуміз бөлмеміздің қабырғаларын бояп, ойыншықтар жасадық.
Dialogue: 0,0:20:23.59,0:20:25.89,Default,,0,0,0,,Ол біздің баламыз.
Dialogue: 0,0:20:37.40,0:20:40.11,Default,,0,0,0,,Сіз қалдырған ең жақсы сыйлық...
Dialogue: 0,0:20:40.61,0:20:42.57,Default,,0,0,0,,Мені өлтірмекші болды
Dialogue: 0,0:20:46.78,0:20:48.62,Default,,0,0,0,,Мен өлдім
Dialogue: 0,0:21:14.31,0:21:14.98,Default,,0,0,0,,Ұлы
Dialogue: 0,0:21:16.06,0:21:17.15,Default,,0,0,0,,Әке.
Dialogue: 0,0:22:22.84,0:22:25.21,Default,,0,0,0,,Алукард, артқа тұрыңыз.
Dialogue: 0,0:22:26.30,0:22:27.92,Default,,0,0,0,,Мен сізге соңғы соққыны беремін
Dialogue: 0,0:23:29.74,0:23:32.61,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:23:32.86,0:23:34.12,Default,,0,0,0,,Алукард
Dialogue: 0,0:23:35.24,0:23:37.41,Default,,0,0,0,,Сіз оны жеңдіңіз бе?
Dialogue: 0,0:23:39.96,0:23:41.08,Default,,0,0,0,,О
Dialogue: 0,0:23:44.29,0:23:45.29,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:23:47.63,0:23:48.63,Default,,0,0,0,,Әкемді өлтірді
Dialogue: 0,0:23:49.80,0:23:51.97,Default,,0,0,0,,Біз соғысты аяқтадық.
Dialogue: 0,0:23:52.93,0:23:54.59,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:23:57.06,0:24:01.10,Default,,0,0,0,,Иә, сіз көп адамның өмірін сақтап қалдыңыз.
Dialogue: 0,0:24:03.48,0:24:06.77,Default,,0,0,0,,Бірақ әкеңнің қайтыс болғанына қайғырсаң да болады.
Dialogue: 0,0:24:13.16,0:24:15.74,Default,,0,0,0,,Әкем баяғыда қайтыс болды.
Dialogue: 0,0:27:10.54,0:27:13.34,Default,,0,0,0,,Жапон субтитрлері Канако Миядзаки
Dialogue: 0,0:27:14.84,0:27:20.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory