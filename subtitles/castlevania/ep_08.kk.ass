Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.29,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:01:15.95,0:01:18.36,Default,,0,0,0,,Құлып – быт-шыт.
Dialogue: 0,0:01:31.25,0:01:34.63,Default,,0,0,0,,Мен Грешитте көрген машинаға ұқсайды
Dialogue: 0,0:01:34.96,0:01:37.68,Default,,0,0,0,,Оны әкесінен үйренсе керек.
Dialogue: 0,0:01:39.68,0:01:41.35,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:01:42.01,0:01:43.77,Default,,0,0,0,,Бұл ғылым
Dialogue: 0,0:01:43.93,0:01:48.39,Default,,0,0,0,,Менің достарым да шындықты түсіне алмады.
Dialogue: 0,0:01:48.65,0:01:50.77,Default,,0,0,0,,Мен ойлағандай сынық емес.
Dialogue: 0,0:01:51.40,0:01:54.15,Default,,0,0,0,,Жоғарыда айтылған шағын бөлмеден басқа.
Dialogue: 0,0:01:54.23,0:01:57.53,Default,,0,0,0,,Қамалды басқаратын машина бөлмесі.
Dialogue: 0,0:01:57.86,0:02:00.24,Default,,0,0,0,,Қызық, бұл қалай жұмыс істейді?
Dialogue: 0,0:02:01.20,0:02:03.83,Default,,0,0,0,,Енді қозғала алмайды
Dialogue: 0,0:02:04.83,0:02:06.37,Default,,0,0,0,,Сіз оны еріттіңіз.
Dialogue: 0,0:02:06.50,0:02:08.12,Default,,0,0,0,,Мен емес
Dialogue: 0,0:02:08.50,0:02:11.42,Default,,0,0,0,,Мен оның сиқырға қарсы тұрғанына сенімдімін.
Dialogue: 0,0:02:20.84,0:02:23.43,Default,,0,0,0,,Ол не істейді?
Dialogue: 0,0:02:23.51,0:02:25.18,Default,,0,0,0,,Менің жоспарларым бар еді.
Dialogue: 0,0:02:27.18,0:02:28.98,Default,,0,0,0,,Грешитке қайта оралу
Dialogue: 0,0:02:30.19,0:02:31.86,Default,,0,0,0,,Бөлмеге оралу-
Dialogue: 0,0:02:32.40,0:02:33.69,Default,,0,0,0,,Мен ұйықтайын деп ойладым.
Dialogue: 0,0:02:34.77,0:02:35.86,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:02:36.61,0:02:38.36,Default,,0,0,0,,Барлығын артта қалдыру
Dialogue: 0,0:02:39.70,0:02:41.45,Default,,0,0,0,,Кету мүмкін емес
Dialogue: 0,0:02:41.87,0:02:45.79,Default,,0,0,0,,Кітапхана, зерттеу материалдары, білім, бәрі.
Dialogue: 0,0:02:46.24,0:02:48.62,Default,,0,0,0,,Оны тастап кетсем не болады?
Dialogue: 0,0:02:50.54,0:02:52.21,Default,,0,0,0,,Артта қалуға болмайды
Dialogue: 0,0:02:53.21,0:02:55.25,Default,,0,0,0,,Тек ұрланған
Dialogue: 0,0:02:59.38,0:03:00.30,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:01.38,0:03:03.14,Default,,0,0,0,,Мынаны менің қабірім ет
Dialogue: 0,0:03:05.05,0:03:06.01,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:07.56,0:03:08.68,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:03:09.64,0:03:10.48,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:03:11.06,0:03:12.65,Default,,0,0,0,,Құлыптарды жылжыту мүмкін емес.
Dialogue: 0,0:03:12.98,0:03:14.11,Default,,0,0,0,,Шифр оны бұзды
Dialogue: 0,0:03:14.23,0:03:15.65,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:03:15.73,0:03:16.94,Default,,0,0,0,,Белгілі бір мағынада сынған
Dialogue: 0,0:03:17.07,0:03:18.57,Default,,0,0,0,,Бұлай жасамаңыз
Dialogue: 0,0:03:18.65,0:03:20.40,Default,,0,0,0,,Сіз менімен келісесіз бе?
Dialogue: 0,0:03:20.49,0:03:21.32,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:22.28,0:03:23.78,Default,,0,0,0,,Құлып қозғалмайды
Dialogue: 0,0:03:24.32,0:03:25.24,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:03:26.41,0:03:29.16,Default,,0,0,0,,Біздің үйдің дәл үстінде
Dialogue: 0,0:03:29.41,0:03:32.42,Default,,0,0,0,,Ол үйге қалағаныңызша кіре аласыз.
Dialogue: 0,0:03:34.25,0:03:37.67,Default,,0,0,0,,Бұл сарайда әкеңнің білімі...
Dialogue: 0,0:03:38.50,0:03:42.72,Default,,0,0,0,,Төмендегі үй анамның отбасынан шыққан білімге толы.
Dialogue: 0,0:03:43.59,0:03:46.35,Default,,0,0,0,,«Жоғары және төмен бірдей болады»
Dialogue: 0,0:03:47.26,0:03:49.52,Default,,0,0,0,,Сізде бұл екеуі бар.
Dialogue: 0,0:03:49.97,0:03:51.23,Default,,0,0,0,,Жалғастыруыңызды өтінеміз.
Dialogue: 0,0:03:53.52,0:03:54.77,Default,,0,0,0,,тіпті ол өзі де білмейтін Титантарға қатысты бір құпия жатыр дейді.
Dialogue: 0,0:03:54.85,0:03:59.11,Default,,0,0,0,,Еш құрметсіз жартылай вампир бейбақ.
Dialogue: 0,0:03:59.48,0:04:01.69,Default,,0,0,0,,Мен саған үйімді беремін
Dialogue: 0,0:04:02.78,0:04:05.82,Default,,0,0,0,,Бұл қамалмен бірге ол сіздің үйіңіз.
Dialogue: 0,0:04:06.16,0:04:07.28,Default,,0,0,0,,Мола емес —
Dialogue: 0,0:04:08.62,0:04:10.37,Default,,0,0,0,,Соңғы иеленуші болыңыз
Dialogue: 0,0:04:12.00,0:04:14.37,Default,,0,0,0,,Үйіңді бересің бе?
Dialogue: 0,0:04:15.33,0:04:16.46,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:04:17.29,0:04:20.26,Default,,0,0,0,,Мен өскен үй және сенің үйің.
Dialogue: 0,0:04:20.46,0:04:23.80,Default,,0,0,0,,Өтінемін, мені қорғап, маған пайдалы бол.
Dialogue: 0,0:04:24.47,0:04:28.30,Default,,0,0,0,,Бұл қорқыныш үйіне айналғаннан жақсы.
Dialogue: 0,0:05:14.89,0:05:16.44,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:05:16.52,0:05:18.27,Default,,0,0,0,,Менің сөйлескім келмейді.
Dialogue: 0,0:05:24.49,0:05:27.07,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:05:29.45,0:05:32.20,Default,,0,0,0,,Сіз шөлдеген сияқтысыз.
Dialogue: 0,0:05:33.91,0:05:36.25,Default,,0,0,0,,Оның бәрін ішпеңіз
Dialogue: 0,0:05:37.79,0:05:39.92,Default,,0,0,0,,Уайымдамаңыз, барлығына жетеді.
Dialogue: 0,0:05:40.38,0:05:44.09,Default,,0,0,0,,Маңызды емес, маңыздысы біздікі.
Dialogue: 0,0:05:46.05,0:05:49.05,Default,,0,0,0,,Мен оны ішкеннен кейін де жеткілікті
Dialogue: 0,0:05:49.80,0:05:52.01,Default,,0,0,0,,Бәрі біздікі.
Dialogue: 0,0:05:52.56,0:05:53.51,Default,,0,0,0,,О
Dialogue: 0,0:05:54.64,0:05:56.23,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:05:57.31,0:05:59.52,Default,,0,0,0,,Балалар сендер әрқашан осындайсыңдар.
Dialogue: 0,0:06:00.48,0:06:04.48,Default,,0,0,0,,Бұл жігіт айдаладан келген сыйлық сияқты.
Dialogue: 0,0:06:05.94,0:06:09.11,Default,,0,0,0,,Мен оны байлап, сүйреп апарамын.
Dialogue: 0,0:06:09.24,0:06:10.87,Default,,0,0,0,,Жақсы сатылуы мүмкін
Dialogue: 0,0:06:11.74,0:06:15.24,Default,,0,0,0,,Жол бойы аш болмасаң.
Dialogue: 0,0:06:16.41,0:06:18.92,Default,,0,0,0,,Жақсырақ сөздер бар ма?
Dialogue: 0,0:06:19.08,0:06:23.92,Default,,0,0,0,,Оазистегі су ішу Басқалармен осылай амандасасыңдар ма?
Dialogue: 0,0:06:24.30,0:06:25.55,Default,,0,0,0,,Оны «ол» деп атаңыз
Dialogue: 0,0:06:25.63,0:06:29.26,Default,,0,0,0,,«сатамын» немесе «же» дейсіз бе?
Dialogue: 0,0:06:31.97,0:06:33.97,Default,,0,0,0,,Сен түкке тұрғысызсың
Dialogue: 0,0:06:34.47,0:06:37.02,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:37.68,0:06:42.23,Default,,0,0,0,,Жол жиегінен тауып алған боқ сияқтысың.
Dialogue: 0,0:06:42.44,0:06:45.44,Default,,0,0,0,,Не істесем де өз еркім.
Dialogue: 0,0:06:46.15,0:06:48.19,Default,,0,0,0,,Маңыздысы – біз ғана.
Dialogue: 0,0:06:48.28,0:06:51.53,Default,,0,0,0,,Сіз жай ғана етсіз
Dialogue: 0,0:06:53.03,0:06:54.45,Default,,0,0,0,,Адам емес пе?
Dialogue: 0,0:06:55.16,0:06:57.45,Default,,0,0,0,,Бұл сөзсіз адам.
Dialogue: 0,0:06:57.54,0:07:00.58,Default,,0,0,0,,Бұлақ суын зерттеуші.
Dialogue: 0,0:07:01.87,0:07:03.38,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:07:05.55,0:07:06.75,Default,,0,0,0,,Ах… Ааах…
Dialogue: 0,0:09:26.98,0:09:30.31,Default,,0,0,0,,Су ішуге тоқтаған сайын...
Dialogue: 0,0:09:30.44,0:09:33.11,Default,,0,0,0,,Менің қоқыспен айналысатын уақытым жоқ.
Dialogue: 0,0:09:34.99,0:09:37.57,Default,,0,0,0,,Ал мен балқытушымын.
Dialogue: 0,0:09:38.36,0:09:40.12,Default,,0,0,0,,Мазалама
Dialogue: 0,0:09:43.79,0:09:46.75,Default,,0,0,0,,Әскері де болуы мүмкін
Dialogue: 0,0:09:49.63,0:09:52.46,Default,,0,0,0,,Мен өз әскерімді қалаймын.
Dialogue: 0,0:10:58.36,0:11:02.53,Default,,0,0,0,,Осы қызықты топқа көбірек адамдарды қосамыз ба?
Dialogue: 0,0:11:26.72,0:11:28.89,Default,,0,0,0,,Мен достарыммен кездескім келеді
Dialogue: 0,0:11:29.39,0:11:32.60,Default,,0,0,0,,Бұл тәжірибені әңгімеде айту керек.
Dialogue: 0,0:11:33.27,0:11:35.44,Default,,0,0,0,,Бірақ бұл аяқталғаннан кейін...
Dialogue: 0,0:11:35.90,0:11:36.94,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:11:37.61,0:11:39.94,Default,,0,0,0,,Сіз достарыңызбен саяхаттап жүрсіз, солай ма?
Dialogue: 0,0:11:40.44,0:11:42.28,Default,,0,0,0,,Ескі өмірге оралу
Dialogue: 0,0:11:45.45,0:11:47.03,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:48.91,0:11:52.71,Default,,0,0,0,,Мен сені кездестіргеннен бері өзімді тірі сезінемін.
Dialogue: 0,0:11:52.92,0:11:56.25,Default,,0,0,0,,Грешитте біз құбыжықтармен күресеміз...
Dialogue: 0,0:11:56.42,0:11:59.17,Default,,0,0,0,,Аргешті шабуылдан қорғады
Dialogue: 0,0:11:59.26,0:12:03.47,Default,,0,0,0,,Жасырын кітапханадан мен ескі сиқырды таптым.
Dialogue: 0,0:12:03.84,0:12:06.01,Default,,0,0,0,,Жұмбақ машинамен жұмыс істейтін қамал.
Dialogue: 0,0:12:06.10,0:12:08.93,Default,,0,0,0,,Мен оны өз қолыммен ұстап алар едім.
Dialogue: 0,0:12:09.01,0:12:11.93,Default,,0,0,0,,Қамал Белмонт үйінің үстінде.
Dialogue: 0,0:12:12.27,0:12:13.85,Default,,0,0,0,,Тоқтауға себеп жоқ
Dialogue: 0,0:12:15.44,0:12:16.36,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:12:17.36,0:12:21.57,Default,,0,0,0,,Дракула әскерінің бір бөлігі Брайлада.
Dialogue: 0,0:12:21.78,0:12:23.86,Default,,0,0,0,,Құбыжық мойынсұнғыш бола ма?
Dialogue: 0,0:12:23.95,0:12:25.41,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:12:25.61,0:12:27.03,Default,,0,0,0,,Шіркеу туралы не деуге болады?
Dialogue: 0,0:12:27.28,0:12:29.95,Default,,0,0,0,,Сіз бұл азғындықты көрдіңіз, солай ма?
Dialogue: 0,0:12:30.12,0:12:33.58,Default,,0,0,0,,Егер жағдай нашарласа ше?
Dialogue: 0,0:12:33.79,0:12:35.92,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:12:36.13,0:12:39.00,Default,,0,0,0,,Бұл енді тоқтай алмайтынымды білдіреді.
Dialogue: 0,0:12:39.30,0:12:40.55,Default,,0,0,0,,Мен жұмыстан кеткім келмейді
Dialogue: 0,0:12:40.96,0:12:42.67,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:42.80,0:12:45.05,Default,,0,0,0,,Біз не істейміз
Dialogue: 0,0:12:45.38,0:12:47.01,Default,,0,0,0,,Бұл да сізге арналған
Dialogue: 0,0:12:47.39,0:12:48.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:51.06,0:12:53.98,Default,,0,0,0,,Сіз мұны ненің негізінде айттыңыз?
Dialogue: 0,0:12:54.31,0:12:59.23,Default,,0,0,0,,Біз кездескен кезде зәр, қан, сыра болып қалдың.
Dialogue: 0,0:12:59.40,0:13:01.78,Default,,0,0,0,,Менің құбыжықты жеңуім де кездейсоқ болды.
Dialogue: 0,0:13:01.86,0:13:04.20,Default,,0,0,0,,Себебі менің қолым жақсы.
Dialogue: 0,0:13:04.28,0:13:09.24,Default,,0,0,0,,Оған қоса, ол кетер алдында сусын сұрады.
Dialogue: 0,0:13:09.33,0:13:11.04,Default,,0,0,0,,Неліктен бұл...
Dialogue: 0,0:13:11.54,0:13:15.16,Default,,0,0,0,,Қысқа уақыт ішінде біз...
Dialogue: 0,0:13:15.37,0:13:18.75,Default,,0,0,0,,Өзіңді тауып өстің
Dialogue: 0,0:13:19.00,0:13:22.13,Default,,0,0,0,,Бүгін мен бірінші рет үлкендермен сөйлестім.
Dialogue: 0,0:13:23.17,0:13:25.34,Default,,0,0,0,,Бұрынғыдан әлдеқайда жақсы
Dialogue: 0,0:13:25.67,0:13:27.38,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,0:13:28.68,0:13:31.60,Default,,0,0,0,,Өйткені мен өз миссиямды орындап жатырмын.
Dialogue: 0,0:13:31.85,0:13:33.47,Default,,0,0,0,,Бұл біртүрлі айту, бірақ...
Dialogue: 0,0:13:33.56,0:13:37.69,Default,,0,0,0,,Осы ең нашар жағдайдың арқасында сіз есейдіңіз.
Dialogue: 0,0:13:38.23,0:13:39.98,Default,,0,0,0,,Соңына дейін орындайық
Dialogue: 0,0:13:40.77,0:13:41.94,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:13:42.19,0:13:43.40,Default,,0,0,0,,Сізбен?
Dialogue: 0,0:13:43.69,0:13:46.82,Default,,0,0,0,,Менің әдемі серіктесім бол
Dialogue: 0,0:13:46.90,0:13:49.03,Default,,0,0,0,,Бұл тұмар болуы мүмкін.
Dialogue: 0,0:13:49.11,0:13:53.74,Default,,0,0,0,,Үндемей қалсаң, бәрі оны аю деп ойлап, сені тамақтандырады.
Dialogue: 0,0:13:55.91,0:13:56.87,Default,,0,0,0,,Шифр
Dialogue: 0,0:13:57.71,0:13:59.04,Default,,0,0,0,,Не?
Dialogue: 0,0:14:01.25,0:14:03.84,Default,,0,0,0,,Ауылды аралауға рұқсат етіңіз...
Dialogue: 0,0:14:03.92,0:14:06.30,Default,,0,0,0,,Менің қиындыққа тап болғанымды қалайсың ба?
Dialogue: 0,0:14:06.47,0:14:09.76,Default,,0,0,0,,Ал мен үшін болса ше?
Dialogue: 0,0:14:11.05,0:14:14.06,Default,,0,0,0,,Мені мұқият тыңда
Dialogue: 0,0:14:14.56,0:14:17.43,Default,,0,0,0,,Мен сенің қасымда болғаныңды қалаймын
Dialogue: 0,0:14:17.56,0:14:19.98,Default,,0,0,0,,Мен сенімен шытырман оқиғаға барғым келеді
Dialogue: 0,0:14:21.27,0:14:24.57,Default,,0,0,0,,Соңғы күндері өзімді тірі сезіндім.
Dialogue: 0,0:14:26.15,0:14:27.44,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:14:28.57,0:14:31.41,Default,,0,0,0,,Сіз мен дос деп атай алатын адамсыз.
Dialogue: 0,0:14:34.91,0:14:36.45,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:14:40.79,0:14:42.59,Default,,0,0,0,,Басқа баратын жер жоқ
Dialogue: 0,0:14:43.75,0:14:45.42,Default,,0,0,0,,Сіз бірге бола алатын адам
Dialogue: 0,0:14:48.42,0:14:49.38,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:54.81,0:14:56.10,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:14:57.18,0:14:59.10,Default,,0,0,0,,Егер мен жолдасымды тапсам...
Dialogue: 0,0:14:59.27,0:15:01.19,Default,,0,0,0,,Мен Брайлаға барамын.
Dialogue: 0,0:15:04.52,0:15:06.86,Default,,0,0,0,,Бірақ әзірге сәл ғана...
Dialogue: 0,0:15:07.28,0:15:09.11,Default,,0,0,0,,Осы жерде болайық
Dialogue: 0,0:15:28.13,0:15:30.13,Default,,0,0,0,,Күн әлі батқан жоқ па?
Dialogue: 0,0:15:30.84,0:15:31.84,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:15:33.14,0:15:35.05,Default,,0,0,0,,Мүлдем жиіркенішті
Dialogue: 0,0:15:35.80,0:15:37.56,Default,,0,0,0,,Қала тұрғындары қайда?
Dialogue: 0,0:15:38.18,0:15:39.64,Default,,0,0,0,,Маған жақындама
Dialogue: 0,0:15:40.31,0:15:42.98,Default,,0,0,0,,Үйінділерден бірдеңе іздеу
Dialogue: 0,0:15:43.31,0:15:46.40,Default,,0,0,0,,Адамдар ең алыстағы үйге оралды.
Dialogue: 0,0:15:46.86,0:15:48.69,Default,,0,0,0,,Сіз біз туралы білесіз бе?
Dialogue: 0,0:15:49.90,0:15:50.82,Default,,0,0,0,,Әрине.
Dialogue: 0,0:15:52.24,0:15:56.08,Default,,0,0,0,,Барлығы қоршаулар жасап, қазықтарды қайрап жатыр.
Dialogue: 0,0:15:56.66,0:15:59.20,Default,,0,0,0,,Бұған да көмектесу мүмкін емес.
Dialogue: 0,0:16:04.83,0:16:07.92,Default,,0,0,0,,Сонда сен мені пышақтап өлтірмексің бе?
Dialogue: 0,0:16:11.42,0:16:13.09,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:16:13.68,0:16:16.05,Default,,0,0,0,,Мен от жағуды ойладым.
Dialogue: 0,0:16:17.01,0:16:18.14,Default,,0,0,0,,Күн суытатын сияқты.
Dialogue: 0,0:16:19.39,0:16:21.06,Default,,0,0,0,,Мен бүгін кешке шығамын
Dialogue: 0,0:16:21.60,0:16:23.69,Default,,0,0,0,,От сізге жарамайды
Dialogue: 0,0:16:24.10,0:16:26.36,Default,,0,0,0,,Сіз суықты сезбейсіз бе?
Dialogue: 0,0:16:54.88,0:16:55.97,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:16:56.64,0:17:00.31,Default,,0,0,0,,Мен Штирияға қайтуды ойлап жүрмін.
Dialogue: 0,0:17:00.56,0:17:04.48,Default,,0,0,0,,Мұндағы әскерлерімнің көпшілігі де кетіп қалды.
Dialogue: 0,0:17:05.48,0:17:09.27,Default,,0,0,0,,Қамал қалай қозғалып, қалай жоғалып кетті?
Dialogue: 0,0:17:09.40,0:17:12.57,Default,,0,0,0,,Мен бұл туралы күні бойы ойладым, бірақ мен оны түсіне алмаймын.
Dialogue: 0,0:17:14.61,0:17:16.66,Default,,0,0,0,,Нені түсінбедіңіз?
Dialogue: 0,0:17:16.74,0:17:19.12,Default,,0,0,0,,Қамалға сиқыр жасалды.
Dialogue: 0,0:17:19.41,0:17:24.25,Default,,0,0,0,,Қамалдағы машиналар бұл сиқырға қарсы тұрып, төбелесті...
Dialogue: 0,0:17:24.75,0:17:26.00,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:17:29.79,0:17:31.25,Default,,0,0,0,,Дракула қауіпсіз бе?
Dialogue: 0,0:17:31.34,0:17:32.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:32.42,0:17:34.88,Default,,0,0,0,,Мен сарайды айнадан қарадым.
Dialogue: 0,0:17:35.17,0:17:36.68,Default,,0,0,0,,Сенімді емеспін, солай ма?
Dialogue: 0,0:17:36.84,0:17:40.10,Default,,0,0,0,,Дракула шынымен де өлді.
Dialogue: 0,0:17:43.27,0:17:44.64,Default,,0,0,0,,Жаман жаңалық?
Dialogue: 0,0:17:44.77,0:17:46.19,Default,,0,0,0,,Әрине.
Dialogue: 0,0:17:47.06,0:17:48.60,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:17:48.77,0:17:50.06,Default,,0,0,0,,Тұру
Dialogue: 0,0:17:57.32,0:17:58.16,Default,,0,0,0,,Гектор
Dialogue: 0,0:17:59.20,0:18:00.87,Default,,0,0,0,,Сіз қорқынышты көрінесіз.
Dialogue: 0,0:18:02.66,0:18:03.37,Default,,0,0,0,,О
Dialogue: 0,0:18:03.79,0:18:04.91,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:18:05.29,0:18:06.75,Default,,0,0,0,,Біз
Dialogue: 0,0:18:12.80,0:18:14.51,Default,,0,0,0,,Кармилла, сен не істейсің?
Dialogue: 0,0:18:16.13,0:18:18.01,Default,,0,0,0,,Штирия дегенге қайта келу
Dialogue: 0,0:18:18.30,0:18:21.51,Default,,0,0,0,,Көп әскер өліп, адамдар әлсіреп барады.
Dialogue: 0,0:18:21.64,0:18:24.64,Default,,0,0,0,,Вампирлер арасындағы күш қатынасы да бұзылды.
Dialogue: 0,0:18:24.81,0:18:27.06,Default,,0,0,0,,Бұл мен үшін мүмкіндік
Dialogue: 0,0:18:27.52,0:18:29.48,Default,,0,0,0,,Мен өз күшімді қайта алғым келеді
Dialogue: 0,0:18:29.56,0:18:32.06,Default,,0,0,0,,Маған құбыжық керек
Dialogue: 0,0:18:32.15,0:18:34.23,Default,,0,0,0,,Сіз өңдеушісіз, солай ма?
Dialogue: 0,0:18:34.32,0:18:36.44,Default,,0,0,0,,Құбыжықты жасаңыз
Dialogue: 0,0:18:36.53,0:18:37.49,Default,,0,0,0,,Білсін
Dialogue: 0,0:18:56.84,0:18:57.97,Default,,0,0,0,,Тұр
Dialogue: 0,0:19:28.87,0:19:30.83,Default,,0,0,0,,Сен менің үй жануарымсың
Dialogue: 0,0:19:31.04,0:19:33.29,Default,,0,0,0,,Тазартушының үй жануары
Dialogue: 0,0:19:54.61,0:19:55.77,Default,,0,0,0,,Жақсы қыз.
Dialogue: 0,0:19:59.23,0:20:00.36,Default,,0,0,0,,Штирияға
Dialogue: 0,0:21:11.31,0:21:12.98,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:21:18.48,0:21:19.61,Default,,0,0,0,,Сен де
Dialogue: 0,0:21:20.32,0:21:23.15,Default,,0,0,0,,Сол ақымаққа ерінбе.
Dialogue: 0,0:21:23.49,0:21:24.53,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:21:29.32,0:21:32.16,Default,,0,0,0,,Мен сені қандай да бір дәрежеде кешіремін.
Dialogue: 0,0:21:32.33,0:21:33.33,Default,,0,0,0,,Белгілі бір дәрежеде?
Dialogue: 0,0:21:49.05,0:21:49.97,Default,,0,0,0,,Эден қақпасынан өткен бірінші сынып оқушылары
Dialogue: 0,0:21:50.22,0:21:51.31,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:22:32.05,0:22:34.43,Default,,0,0,0,,Вернандес пен Белмонт
Dialogue: 0,0:22:36.06,0:22:37.64,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:22:38.23,0:22:39.23,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:22:40.06,0:22:42.90,Default,,0,0,0,,«Вернандес пен Бельмондо»
Dialogue: 0,0:22:43.23,0:22:44.48,Default,,0,0,0,,Біздің әңгіме
Dialogue: 0,0:22:45.32,0:22:46.74,Default,,0,0,0,,Ол аңызға айналады
Dialogue: 0,0:22:47.11,0:22:50.16,Default,,0,0,0,,Менің атым бірінші емес пе?
Dialogue: 0,0:22:51.24,0:22:52.62,Default,,0,0,0,,Әрине, мен бірінші барамын.
Dialogue: 0,0:22:53.08,0:22:54.79,Default,,0,0,0,,Сіз жаттықтырушысыз
Dialogue: 0,0:22:57.25,0:22:59.79,Default,,0,0,0,,Бұл менің рөлім бе?
Dialogue: 0,0:23:00.25,0:23:01.17,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:23:02.79,0:23:03.75,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:24:34.05,0:24:36.09,Default,,0,0,0,,Менің әкем де солай сезінді ме?
Dialogue: 0,0:24:38.72,0:24:41.60,Default,,0,0,0,,Анам осы сарайға барғанша
Dialogue: 0,0:28:09.52,0:28:12.39,Default,,0,0,0,,Жапон субтитрлері Шинхачи Ямаучи
Dialogue: 0,0:28:13.89,0:28:19.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory