Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.71,0:00:14.84,Default,,0,0,0,,Кастлевания
Dialogue: 0,0:01:25.41,0:01:26.46,Default,,0,0,0,,Бұл жаңа.
Dialogue: 0,0:01:33.59,0:01:35.05,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:01:43.14,0:01:44.14,Default,,0,0,0,,жылы
Dialogue: 0,0:01:45.27,0:01:46.27,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:01:51.69,0:01:52.94,Default,,0,0,0,,Мен оны естимін.
Dialogue: 0,0:01:54.48,0:01:57.74,Default,,0,0,0,,Қаруымыз бар, көңіл-күйіміз нашар.
Dialogue: 0,0:01:58.82,0:02:01.24,Default,,0,0,0,,Кедергі жасамағаныңыз жөн.
Dialogue: 0,0:02:09.00,0:02:10.71,Default,,0,0,0,,Мен өз рефлекстерімді мақтан тұтамын.
Dialogue: 0,0:02:51.21,0:02:54.59,Default,,0,0,0,,Ертегіші мүсіні немесе...
Dialogue: 0,0:03:09.27,0:03:10.39,Default,,0,0,0,,Циклоптар
Dialogue: 0,0:03:17.61,0:03:19.11,Default,,0,0,0,,Бұл тастайтын циклоптар.
Dialogue: 0,0:03:19.61,0:03:21.49,Default,,0,0,0,,Мен оны кітаптан көрдім...
Dialogue: 0,0:03:22.07,0:03:23.91,Default,,0,0,0,,Мен жақында твиттер жазбадым.
Dialogue: 0,0:03:50.31,0:03:51.10,Default,,0,0,0,,Эй
Dialogue: 0,0:03:52.27,0:03:54.27,Default,,0,0,0,,Бұл өлімге әкелетін жарақат.
Dialogue: 0,0:03:55.19,0:03:56.61,Default,,0,0,0,,Сен ақымақ бейбақ.
Dialogue: 0,0:04:01.44,0:04:02.28,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:04:43.74,0:04:44.74,Default,,0,0,0,,Немересі?
Dialogue: 0,0:04:48.12,0:04:49.83,Default,,0,0,0,,Мен сенің тоқтағаныңды қалаймын.
Dialogue: 0,0:04:50.87,0:04:51.62,Default,,0,0,0,,Не?
Dialogue: 0,0:04:52.08,0:04:54.46,Default,,0,0,0,,Әйелді ер адамша киінуге мәжбүрлеу
Dialogue: 0,0:04:54.71,0:04:57.04,Default,,0,0,0,,Сіздің сапарыңыздағы қауіпсіздігіңіз үшін.
Dialogue: 0,0:04:57.29,0:04:58.54,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:04:58.88,0:05:00.50,Default,,0,0,0,,Циклоптар
Dialogue: 0,0:05:01.25,0:05:05.68,Default,,0,0,0,,Мен сені тасқа айналдырдым және сенің қорқынышыңды тамақтандырдым.
Dialogue: 0,0:05:06.63,0:05:09.26,Default,,0,0,0,,Мені баспалдақ ретінде пайдаландың ба?
Dialogue: 0,0:05:09.35,0:05:10.35,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:10.47,0:05:11.51,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:11.64,0:05:12.56,Default,,0,0,0,,Не?
Dialogue: 0,0:05:12.64,0:05:14.02,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:15.02,0:05:16.52,Default,,0,0,0,,Қария үшін-
Dialogue: 0,0:05:16.73,0:05:21.69,Default,,0,0,0,,Мен сенің мәйітіңді тауып алып, әңгімешіге бермек болдым.
Dialogue: 0,0:05:21.90,0:05:24.49,Default,,0,0,0,,Ұйқыдағы жауынгер әлі жер астында...
Dialogue: 0,0:05:24.94,0:05:26.99,Default,,0,0,0,,Жауынгерлер жоқ
Dialogue: 0,0:05:27.49,0:05:30.87,Default,,0,0,0,,Циклоп күтіп тұрды.
Dialogue: 0,0:05:31.20,0:05:36.58,Default,,0,0,0,,Жақсы мінезді әңгімешіге тұзақ.
Dialogue: 0,0:05:36.87,0:05:38.88,Default,,0,0,0,,Құбыжық қабірді күзетіп тұрды
Dialogue: 0,0:05:38.96,0:05:40.75,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:05:41.42,0:05:46.42,Default,,0,0,0,,Қалаға қайтып, қарияны тыныштандырыңыз.
Dialogue: 0,0:05:46.63,0:05:48.26,Default,,0,0,0,,Мен өлдім бе?
Dialogue: 0,0:05:48.51,0:05:49.89,Default,,0,0,0,,Бір мағынада бұл дұрыс.
Dialogue: 0,0:05:50.01,0:05:53.68,Default,,0,0,0,,Циклоп – мен үшін де күшті жау.
Dialogue: 0,0:05:54.22,0:05:55.60,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:57.19,0:05:58.94,Default,,0,0,0,,Тревор Белмонт
Dialogue: 0,0:05:59.19,0:06:01.69,Default,,0,0,0,,Құбыжықтармен күресетін отбасы, солай ма?
Dialogue: 0,0:06:01.77,0:06:03.36,Default,,0,0,0,,Тәжірибенің болмауына байланысты.
Dialogue: 0,0:06:03.57,0:06:07.82,Default,,0,0,0,,Әйтеуір, жерге қайта барып, қарияны қарсы ал.
Dialogue: 0,0:06:08.74,0:06:09.74,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:06:10.57,0:06:11.57,Default,,0,0,0,,Мен Шифрмын
Dialogue: 0,0:06:11.66,0:06:12.95,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:06:41.56,0:06:42.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:44.19,0:06:45.19,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:46.69,0:06:48.86,Default,,0,0,0,,Іздеу сәтсіз аяқталды.
Dialogue: 0,0:06:48.95,0:06:51.70,Default,,0,0,0,,Мен қалай білейін, иә?
Dialogue: 0,0:06:52.62,0:06:55.12,Default,,0,0,0,,Менің ойымша, жауынгерлер жоқ.
Dialogue: 0,0:06:55.41,0:06:57.62,Default,,0,0,0,,Бұл аңыз болып бүркенген қақпан.
Dialogue: 0,0:06:58.25,0:07:03.13,Default,,0,0,0,,Оны орнатқан адам табытта жатқан шығар...
Dialogue: 0,0:07:03.71,0:07:06.13,Default,,0,0,0,,Жәбірленушіге күлу
Dialogue: 0,0:07:06.21,0:07:11.80,Default,,0,0,0,,Мүмкін бұл жер құбыжық қорғайтындай маңызды шығар.
Dialogue: 0,0:07:12.14,0:07:15.81,Default,,0,0,0,,Сіздің құтқарушыңыз жоқ.
Dialogue: 0,0:07:16.26,0:07:18.10,Default,,0,0,0,,Неліктен мұны айта аласыз?
Dialogue: 0,0:07:18.72,0:07:21.81,Default,,0,0,0,,Ертегішілер білімді ұрпақтан-ұрпаққа жеткізеді...
Dialogue: 0,0:07:22.69,0:07:25.65,Default,,0,0,0,,Белмонт отбасына да солай.
Dialogue: 0,0:07:26.52,0:07:29.15,Default,,0,0,0,,Жер астында көргендеріңіз есіңізде ме?
Dialogue: 0,0:07:31.11,0:07:33.32,Default,,0,0,0,,Металл түтік арқылы ағып жатқан ыстық сұйықтық
Dialogue: 0,0:07:33.87,0:07:35.99,Default,,0,0,0,,Автоматты түрде қосылатын шамдар
Dialogue: 0,0:07:36.12,0:07:40.33,Default,,0,0,0,,Дәл менің арғы атам жазғандай.
Dialogue: 0,0:07:41.16,0:07:45.46,Default,,0,0,0,,Бұл Дракула сарайы туралы сипаттамамен бірдей болды.
Dialogue: 0,0:07:46.17,0:07:49.42,Default,,0,0,0,,Қандай болса да, ол құтқарушы емес.
Dialogue: 0,0:07:50.67,0:07:52.09,Default,,0,0,0,,Шешімді маған қалдырыңыз
Dialogue: 0,0:07:52.26,0:07:54.09,Default,,0,0,0,,Бұл... күте тұрыңыз.
Dialogue: 0,0:07:54.18,0:07:58.10,Default,,0,0,0,,Сіз бізбен қаласыз ба?
Dialogue: 0,0:07:58.31,0:08:01.06,Default,,0,0,0,,Менің жақсылығымды қайтаруыңды қалаймын.
Dialogue: 0,0:08:01.27,0:08:03.19,Default,,0,0,0,,Бүгін түнде қаладан кетесіз бе?
Dialogue: 0,0:08:03.77,0:08:07.15,Default,,0,0,0,,Иә, бірақ оған дейін ғана.
Dialogue: 0,0:08:07.36,0:08:10.19,Default,,0,0,0,,Жарайды, мен қайтамын.
Dialogue: 0,0:08:11.15,0:08:12.86,Default,,0,0,0,,Рахмет ретінде сыра жақсырақ.
Dialogue: 0,0:08:14.86,0:08:17.78,Default,,0,0,0,,Мен сенің зәріңді ішейін.
Dialogue: 0,0:08:17.87,0:08:19.20,Default,,0,0,0,,Шифр
Dialogue: 0,0:08:19.79,0:08:21.08,Default,,0,0,0,,Бұл құтқарушы.
Dialogue: 0,0:08:21.20,0:08:22.50,Default,,0,0,0,,Дөрекі адам
Dialogue: 0,0:08:30.92,0:08:32.30,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:32.38,0:08:36.97,Default,,0,0,0,,Мен қолымды дұрыс ұстай алмаймын, сондықтан пышақ сырғып кетуі мүмкін.
Dialogue: 0,0:08:37.80,0:08:42.10,Default,,0,0,0,,Грешит епископы «Мен сенімен кездескім келеді» дейді.
Dialogue: 0,0:08:45.44,0:08:49.36,Default,,0,0,0,,Маған шіркеуге кіруге рұқсат жоқ.
Dialogue: 0,0:08:50.07,0:08:53.40,Default,,0,0,0,,Епископ ерекшелік беретін сияқты.
Dialogue: 0,0:08:55.03,0:08:56.95,Default,,0,0,0,,Қалжыңдауды доғарайық
Dialogue: 0,0:08:57.16,0:09:02.70,Default,,0,0,0,,Олар сені қорқытып, алып кеткісі келетін сияқты, бірақ сен қуып шықтың.
Dialogue: 0,0:09:03.50,0:09:05.21,Default,,0,0,0,,Епископ-
Dialogue: 0,0:09:05.29,0:09:09.09,Default,,0,0,0,,«Егер біреуді қуып шығарса да...»
Dialogue: 0,0:09:09.21,0:09:13.59,Default,,0,0,0,,«Біз шіркеудің шақыруына жауап беруге міндеттіміз».
Dialogue: 0,0:09:15.55,0:09:17.34,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:09:18.68,0:09:24.06,Default,,0,0,0,,Мені шіркеуге апарсаң, өрт болып жатса...
Dialogue: 0,0:09:24.52,0:09:25.60,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:10:09.90,0:10:12.15,Default,,0,0,0,,Мен Грешит епископымын.
Dialogue: 0,0:10:13.57,0:10:15.44,Default,,0,0,0,,Ол жергілікті емес.
Dialogue: 0,0:10:16.24,0:10:17.11,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:17.53,0:10:22.49,Default,,0,0,0,,Бұрынғы Турговиште, архиепископқа жақын
Dialogue: 0,0:10:23.28,0:10:24.79,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:10:24.87,0:10:28.79,Default,,0,0,0,,Мен айқайлап қашып жатқан жоқпын.
Dialogue: 0,0:10:29.75,0:10:30.75,Default,,0,0,0,,Сізден?
Dialogue: 0,0:10:31.13,0:10:35.38,Default,,0,0,0,,Түнде пайда болатын құбыжықтардан.
Dialogue: 0,0:10:35.59,0:10:37.59,Default,,0,0,0,,Мен қаланы құтқару үшін келдім.
Dialogue: 0,0:10:37.84,0:10:40.22,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:10:40.43,0:10:44.18,Default,,0,0,0,,Мен сізге сұрақ қою үшін қоңырау шалдым.
Dialogue: 0,0:10:44.26,0:10:45.97,Default,,0,0,0,,Жауап бермеу
Dialogue: 0,0:10:46.14,0:10:47.89,Default,,0,0,0,,Міне, Рим жерінде —
Dialogue: 0,0:10:48.02,0:10:51.19,Default,,0,0,0,,Қала тұрғындарын қалай құтқарасыз?
Dialogue: 0,0:10:51.27,0:10:52.69,Default,,0,0,0,,Ертегішіні өлтіру керек пе?
Dialogue: 0,0:10:52.90,0:10:55.86,Default,,0,0,0,,Ертегішілер өз бетінше жасайды.
Dialogue: 0,0:10:56.28,0:10:59.03,Default,,0,0,0,,Адам Құдайсыз өмір сүре алмайды
Dialogue: 0,0:10:59.70,0:11:02.07,Default,,0,0,0,,Әсіресе осындай қиын жағдайда.
Dialogue: 0,0:11:02.49,0:11:07.37,Default,,0,0,0,,Құбыжықтарға адамдардың имансыздығы себеп дейсіз бе?
Dialogue: 0,0:11:07.91,0:11:09.16,Default,,0,0,0,,Турговиште?
Dialogue: 0,0:11:10.33,0:11:14.54,Default,,0,0,0,,Архиепископтың белгілі бір қызығушылығы бар...
Dialogue: 0,0:11:14.67,0:11:21.01,Default,,0,0,0,,Маған бұл қала мен князьдықты қорғауға кедергі болып көрінді.
Dialogue: 0,0:11:21.22,0:11:24.80,Default,,0,0,0,,Мен бұл қалаға Дракула пайда болғанға дейін келдім.
Dialogue: 0,0:11:25.39,0:11:29.77,Default,,0,0,0,,Діни қызметкерлердің тәртібіне қатысты архиепископпен қақтығыс
Dialogue: 0,0:11:29.85,0:11:33.10,Default,,0,0,0,,Дракуланың әйелін өртеп жіберді.
Dialogue: 0,0:11:33.23,0:11:35.61,Default,,0,0,0,,Мен жауапты болдым
Dialogue: 0,0:11:35.98,0:11:38.03,Default,,0,0,0,,Бұл әйел бақсы
Dialogue: 0,0:11:38.28,0:11:42.45,Default,,0,0,0,,Оның шайтанмен сөйлескеніне еш күмән жоқ.
Dialogue: 0,0:11:43.07,0:11:44.78,Default,,0,0,0,,Үйленген.
Dialogue: 0,0:11:44.99,0:11:45.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:46.62,0:11:48.41,Default,,0,0,0,,Мені де жазалайсың ба?
Dialogue: 0,0:11:48.54,0:11:49.75,Default,,0,0,0,,Мен бір нәрсеге сенімдімін: полиция араласқан күнде де өзімді қорғай аламын.
Dialogue: 0,0:11:50.41,0:11:52.04,Default,,0,0,0,,Менің сыйлығым бар
Dialogue: 0,0:11:52.75,0:11:54.83,Default,,0,0,0,,Сіздің өміріңіз, Белмонт.
Dialogue: 0,0:11:55.33,0:11:57.29,Default,,0,0,0,,Оны алыңыз да кетіңіз
Dialogue: 0,0:11:58.13,0:12:03.30,Default,,0,0,0,,Бүгін түнде ертегіші жазаланып, қалаға тыныштық оралады.
Dialogue: 0,0:12:03.76,0:12:09.35,Default,,0,0,0,,Сондықтан Грешиттің жанын қорғау үшін...
Dialogue: 0,0:12:09.43,0:12:14.02,Default,,0,0,0,,Біз қуғын-сүргінге ұшыраған бидғатшылардың жүруіне жол бере алмаймыз.
Dialogue: 0,0:12:14.15,0:12:17.82,Default,,0,0,0,,Сенің тіршілігің бәрін жоя алады.
Dialogue: 0,0:12:18.61,0:12:19.94,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:12:20.73,0:12:22.70,Default,,0,0,0,,Сіз шынымен сенесіз.
Dialogue: 0,0:12:22.99,0:12:26.16,Default,,0,0,0,,Біз Грешиттен түн батқанша кетуіміз керек.
Dialogue: 0,0:12:26.28,0:12:28.66,Default,,0,0,0,,Таңды енді ешқашан көрмейсің
Dialogue: 0,0:12:28.78,0:12:30.45,Default,,0,0,0,,Менің не айтқым келгенін түсіндіңіз бе?
Dialogue: 0,0:12:31.20,0:12:34.54,Default,,0,0,0,,Сіз менің көмекшілеріме күш көрсеттіңіз.
Dialogue: 0,0:12:34.62,0:12:39.63,Default,,0,0,0,,Белмонт отбасы Құдайға қарсы күнә жасады.
Dialogue: 0,0:12:40.13,0:12:44.38,Default,,0,0,0,,Бірақ мен қаладан шығу үшін күн батқанша күтемін.
Dialogue: 0,0:12:44.59,0:12:46.76,Default,,0,0,0,,Қылмыс жасалмаған
Dialogue: 0,0:12:47.09,0:12:51.43,Default,,0,0,0,,Мен князьдықты қорғауға тырыстым, бірақ біржақты сынға ұшырадым...
Dialogue: 0,0:12:51.52,0:12:57.48,Default,,0,0,0,,Белмонт отбасы Құдайдың ілімдерін түсінбеді.
Dialogue: 0,0:12:57.61,0:13:01.65,Default,,0,0,0,,Бұл қаланың халқы маған және Құдайға тиесілі.
Dialogue: 0,0:13:01.78,0:13:05.49,Default,,0,0,0,,Алланың атымен маған ересіңдер
Dialogue: 0,0:13:06.07,0:13:10.66,Default,,0,0,0,,Таң атқанша ертегішілер қаладан жойылады.
Dialogue: 0,0:13:10.78,0:13:14.08,Default,,0,0,0,,Сіз кетуді немесе өлуді таңдай аласыз.
Dialogue: 0,0:13:15.66,0:13:16.92,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:13:18.67,0:13:19.71,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:21.50,0:13:23.21,Default,,0,0,0,,Менің айтқанымды орындасаң...
Dialogue: 0,0:13:24.09,0:13:28.59,Default,,0,0,0,,Біз шіркеуден шығаруды талқылай аламыз.
Dialogue: 0,0:13:30.47,0:13:33.56,Default,,0,0,0,,Ренжімеңіз, бірақ сіз епископсыз.
Dialogue: 0,0:13:34.06,0:13:37.85,Default,,0,0,0,,Шығаруды жоғары деңгей шешеді.
Dialogue: 0,0:13:40.06,0:13:42.40,Default,,0,0,0,,Турговиште аяқталды.
Dialogue: 0,0:13:43.03,0:13:46.11,Default,,0,0,0,,Басқа ірі қалалар да жоғалады.
Dialogue: 0,0:13:46.49,0:13:50.53,Default,,0,0,0,,Гресит Уоллахияның соңғы қаласы болды
Dialogue: 0,0:13:51.24,0:13:53.24,Default,,0,0,0,,Шын мәнінде, мен...
Dialogue: 0,0:13:54.20,0:13:57.54,Default,,0,0,0,,Шіркеудің жоғарғы басшысы бол
Dialogue: 0,0:14:02.17,0:14:03.92,Default,,0,0,0,,Тревор осында
Dialogue: 0,0:14:04.84,0:14:05.71,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:14:06.22,0:14:08.22,Default,,0,0,0,,Сен өлесің.
Dialogue: 0,0:14:08.88,0:14:09.80,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:14:10.22,0:14:12.39,Default,,0,0,0,,Бұл қаланың епископы -
Dialogue: 0,0:14:12.47,0:14:14.47,Default,,0,0,0,,Сіз не айтасыз...
Dialogue: 0,0:14:15.14,0:14:16.89,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:14:17.56,0:14:21.56,Default,,0,0,0,,Мен жаңа дүниенің адасушылықтарына батып кеттім.
Dialogue: 0,0:14:21.65,0:14:24.48,Default,,0,0,0,,Халыққа қаланы құтқаруға бұйрық бер.
Dialogue: 0,0:14:24.57,0:14:27.90,Default,,0,0,0,,Мен сені жыртып тастаймын.
Dialogue: 0,0:14:29.53,0:14:30.36,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:14:30.45,0:14:31.95,Default,,0,0,0,,Күн батқанға дейін
Dialogue: 0,0:14:32.83,0:14:37.20,Default,,0,0,0,,Мен сені келесі құбыжық келгенше өлтіремін.
Dialogue: 0,0:14:37.41,0:14:39.96,Default,,0,0,0,,Егер біз аман қалсақ ше?
Dialogue: 0,0:14:40.08,0:14:44.84,Default,,0,0,0,,Қалай болғанда да, құбыжық келеді және сізді тағы да айыптайды.
Dialogue: 0,0:14:46.01,0:14:51.59,Default,,0,0,0,,Адамдарды құрдымға апаратын өтірік қуып, қашу.
Dialogue: 0,0:14:52.43,0:14:54.22,Default,,0,0,0,,Ертегіші сияқты емес
Dialogue: 0,0:14:54.60,0:14:56.27,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:14:56.52,0:14:58.98,Default,,0,0,0,,Согуван да Белмондода
Dialogue: 0,0:14:59.27,0:15:02.81,Default,,0,0,0,,Қалай болғанда да, қазір қаладан кет.
Dialogue: 0,0:15:03.02,0:15:06.61,Default,,0,0,0,,Біз құтқарылуға мұқтаж адамдарды тастап кете алмаймыз.
Dialogue: 0,0:15:06.73,0:15:10.15,Default,,0,0,0,,Бұл адамдар сізді кінәлап отыр.
Dialogue: 0,0:15:10.28,0:15:13.03,Default,,0,0,0,,Шіркеудің адасқандығынан.
Dialogue: 0,0:15:14.28,0:15:17.83,Default,,0,0,0,,Мен қате түсініп қаша алмаймын.
Dialogue: 0,0:15:18.16,0:15:20.83,Default,,0,0,0,,Белмонт отбасы не деді?
Dialogue: 0,0:15:21.00,0:15:24.88,Default,,0,0,0,,«Адамдық емес күшке араласу және зұлымдыққа түсу-»
Dialogue: 0,0:15:25.00,0:15:26.92,Default,,0,0,0,,«Мен Құдайды қорладым»
Dialogue: 0,0:15:27.30,0:15:32.51,Default,,0,0,0,,«Адамзатқа апат әкелу және жындармен жүру»
Dialogue: 0,0:15:33.01,0:15:35.22,Default,,0,0,0,,Балалар, онымен қалай күрестіңдер?
Dialogue: 0,0:15:36.14,0:15:37.47,Default,,0,0,0,,Мен қашып жатқан жоқпын
Dialogue: 0,0:15:37.77,0:15:40.68,Default,,0,0,0,,Сонда біз қайда бара жатырмыз?
Dialogue: 0,0:15:41.31,0:15:43.06,Default,,0,0,0,,Оның мақсаты бар ма?
Dialogue: 0,0:15:43.44,0:15:44.98,Default,,0,0,0,,Сіз мені қорқақ дейсіз бе?
Dialogue: 0,0:15:45.11,0:15:45.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:46.65,0:15:49.36,Default,,0,0,0,,Сіз жеңілдіңіз
Dialogue: 0,0:15:49.90,0:15:53.11,Default,,0,0,0,,Ол бір рет шайқасты, бірақ жеңілгенін мойындады.
Dialogue: 0,0:15:53.32,0:15:54.74,Default,,0,0,0,,Менің таңдауым болмады.
Dialogue: 0,0:15:54.99,0:15:57.62,Default,,0,0,0,,Бізде таңдау бар
Dialogue: 0,0:15:57.91,0:16:01.41,Default,,0,0,0,,Осы ұлы елде жинақталған даналық...
Dialogue: 0,0:16:01.79,0:16:04.50,Default,,0,0,0,,Мен оны қару ретінде қолданып, ұрысамын
Dialogue: 0,0:16:04.63,0:16:05.67,Default,,0,0,0,,Мен жеңілемін
Dialogue: 0,0:16:05.75,0:16:07.38,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:16:07.84,0:16:12.68,Default,,0,0,0,,Бірақ, кем дегенде, бұл біреудің жүрегіне ұнауы мүмкін.
Dialogue: 0,0:16:12.93,0:16:15.22,Default,,0,0,0,,Алда бұдан да үлкен шайқас күтіп тұр.
Dialogue: 0,0:16:15.34,0:16:17.26,Default,,0,0,0,,Дракула әскерімен?
Dialogue: 0,0:16:17.43,0:16:18.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:19.35,0:16:21.56,Default,,0,0,0,,Бұл адамзат үшін күрес.
Dialogue: 0,0:16:22.02,0:16:25.73,Default,,0,0,0,,Жындының адасушылықтарына еріп...
Dialogue: 0,0:16:25.85,0:16:28.61,Default,,0,0,0,,Бір-бірін өлтіретін адамдар ма?
Dialogue: 0,0:16:29.02,0:16:35.11,Default,,0,0,0,,Тозақ елшілері бізді жойып жіберуі табиғи нәрсе болуы мүмкін.
Dialogue: 0,0:16:35.66,0:16:41.00,Default,,0,0,0,,Енді тұрып, өз міндеттеріңді орындайтын уақыт.
Dialogue: 0,0:16:41.54,0:16:42.75,Default,,0,0,0,,Қазір барыңыз
Dialogue: 0,0:16:48.13,0:16:48.71,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:50.38,0:16:51.63,Default,,0,0,0,,Бұл жерден кет.
Dialogue: 0,0:16:52.51,0:16:54.30,Default,,0,0,0,,Қазір
Dialogue: 0,0:18:12.04,0:18:13.80,Default,,0,0,0,,Ертегіші қайда?
Dialogue: 0,0:18:14.96,0:18:16.97,Default,,0,0,0,,Қауіпсіз жерге қашып кетті
Dialogue: 0,0:18:17.76,0:18:19.47,Default,,0,0,0,,Мына жігіт қозғалды.
Dialogue: 0,0:18:19.72,0:18:21.89,Default,,0,0,0,,Шайтанды қорғаймыз ба?
Dialogue: 0,0:18:22.05,0:18:23.18,Default,,0,0,0,,Беру
Dialogue: 0,0:18:27.27,0:18:28.56,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:18:29.90,0:18:30.85,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:18:31.40,0:18:32.40,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:18:33.48,0:18:35.48,Default,,0,0,0,,Ертегіші бермейді
Dialogue: 0,0:18:35.94,0:18:39.45,Default,,0,0,0,,Мен саған ешкімді өлтіруге рұқсат бермеймін.
Dialogue: 0,0:18:40.61,0:18:44.49,Default,,0,0,0,,Қаланы құтқару үшін маған ертегіні беріңіз.
Dialogue: 0,0:18:44.62,0:18:46.50,Default,,0,0,0,,Бұл қала бітті
Dialogue: 0,0:18:46.70,0:18:49.67,Default,,0,0,0,,Сен осында келгелі бері.
Dialogue: 0,0:18:50.50,0:18:51.50,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:18:52.46,0:18:54.67,Default,,0,0,0,,Бізге қарсы тұрасың ба?
Dialogue: 0,0:18:54.80,0:18:56.88,Default,,0,0,0,,Халықты көндіре аласыз ба?
Dialogue: 0,0:18:56.96,0:18:59.80,Default,,0,0,0,,Қаңғыбас қара сиқыршы емес...
Dialogue: 0,0:18:59.88,0:19:03.93,Default,,0,0,0,,Құдайға қызмет ететін діни қызметкер шабуылға себеп болды ма?
Dialogue: 0,0:19:04.10,0:19:04.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:04.85,0:19:07.18,Default,,0,0,0,,Сыртқы түріңізге қараңыз
Dialogue: 0,0:19:07.60,0:19:11.40,Default,,0,0,0,,Сенің көзің жартылай ашық екен.
Dialogue: 0,0:19:12.15,0:19:15.07,Default,,0,0,0,,Қарсылық танытқаннан не пайда?
Dialogue: 0,0:19:16.44,0:19:18.19,Default,,0,0,0,,Ештеңе алынған жоқ
Dialogue: 0,0:19:18.74,0:19:20.99,Default,,0,0,0,,Сонда сен бекер өлесің бе?
Dialogue: 0,0:19:21.49,0:19:23.32,Default,,0,0,0,,Бейтаныс адамға?
Dialogue: 0,0:19:23.62,0:19:27.37,Default,,0,0,0,,Мен сіз туралы білмеймін, бірақ мәселе сонда ма?
Dialogue: 0,0:19:28.16,0:19:32.33,Default,,0,0,0,,Менің отбасымды бидғатшы деп атаса да, жәбір көрген...
Dialogue: 0,0:19:32.42,0:19:36.21,Default,,0,0,0,,Елі үшін соғысып, жанын қиды.
Dialogue: 0,0:19:37.42,0:19:42.05,Default,,0,0,0,,Біз Уоллахия мен оның халқы үшін күресеміз.
Dialogue: 0,0:19:42.89,0:19:46.39,Default,,0,0,0,,Оларды жеке танисың ба, білмейсің бе, маңызды емес.
Dialogue: 0,0:19:47.39,0:19:49.89,Default,,0,0,0,,Қорқыныштысы өлу емес.
Dialogue: 0,0:19:51.39,0:19:53.94,Default,,0,0,0,,Орнынан тұру мүмкіндігін жіберіп алды
Dialogue: 0,0:19:55.61,0:19:59.90,Default,,0,0,0,,Мен Тревор, Белмонт отбасының мүшесімін.
Dialogue: 0,0:20:01.07,0:20:04.49,Default,,0,0,0,,Ешқашан өлуден қорықпа
Dialogue: 0,0:20:05.95,0:20:06.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:59.65,0:22:00.48,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:23:16.47,0:23:17.64,Default,,0,0,0,,Жапон субтитрлері Харука Игучи
Dialogue: 0,0:23:19.14,0:23:25.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory