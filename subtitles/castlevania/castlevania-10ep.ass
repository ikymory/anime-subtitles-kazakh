Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.75,0:00:09.20,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:27.08,0:00:28.41,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:01:03.00,0:01:05.16,Default,,0,0,0,,Сізге жалынудың орнына
Dialogue: 0,0:01:05.58,0:01:09.16,Default,,0,0,0,,Сол сиқыршы әйелмен тұруды таңда
Dialogue: 0,0:01:09.25,0:01:12.33,Default,,0,0,0,,Ұйықтап жатқанда көз алмамды жеп қойса да
Dialogue: 0,0:01:19.62,0:01:22.62,Default,,0,0,0,,Сіз тым көп уақытты жалғыз өткіздіңіз бе?
Dialogue: 0,0:02:00.91,0:02:04.04,Default,,0,0,0,,Жою – ақыры, тазарту жоқ.
Dialogue: 0,0:02:04.45,0:02:07.58,Default,,0,0,0,,Адамдарды өлтіріңіз, бірақ қаланы артта қалдырыңыз.
Dialogue: 0,0:02:07.70,0:02:09.00,Default,,0,0,0,,Барлығына айтыңыз
Dialogue: 0,0:02:12.29,0:02:16.04,Default,,0,0,0,,Ол ақырында жаңа тұрғындарға толы болады.
Dialogue: 0,0:02:16.75,0:02:21.16,Default,,0,0,0,,Немесе бүкіл қала ескерткішке айналуы мүмкін.
Dialogue: 0,0:02:26.50,0:02:31.29,Default,,0,0,0,,Сол адамның мәңгілік ұйқыға кеткенін қалау.
Dialogue: 0,0:02:32.70,0:02:35.20,Default,,0,0,0,,Қандай тамаша түн
Dialogue: 0,0:02:43.16,0:02:44.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:45.29,0:02:49.50,Default,,0,0,0,,Мүмкін ол жол тозаққа апаратын шығар.
Dialogue: 0,0:02:49.66,0:02:51.04,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:02:51.12,0:02:56.37,Default,,0,0,0,,Мен сізге Богемия патшасымен өткен қорқынышты түнім туралы айтқым келеді.
Dialogue: 0,0:02:56.45,0:02:58.16,Default,,0,0,0,,Менің қазір уақытым жоқ
Dialogue: 0,0:02:58.37,0:02:59.91,Default,,0,0,0,,Оны жабуға бола ма?
Dialogue: 0,0:03:01.04,0:03:04.83,Default,,0,0,0,,Бұл оңай емес, бірақ тырысайық.
Dialogue: 0,0:03:37.20,0:03:39.58,Default,,0,0,0,,Шифр, арқаңды маған қалдыр
Dialogue: 0,0:03:40.50,0:03:41.62,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:06:24.25,0:06:26.08,Default,,0,0,0,,Неліктен құлап кетпейді?
Dialogue: 0,0:06:26.50,0:06:30.75,Default,,0,0,0,,Ол өз тұрғындарының жан күшіне толы.
Dialogue: 0,0:06:31.12,0:06:33.75,Default,,0,0,0,,Мені бірнеше рет өлтіру керек пе?
Dialogue: 0,0:06:34.25,0:06:36.83,Default,,0,0,0,,Ауылдағы түндер де қызық.
Dialogue: 0,0:07:18.58,0:07:20.50,Default,,0,0,0,,Сара сен ақымақсың
Dialogue: 0,0:07:26.25,0:07:28.20,Default,,0,0,0,,Мен өте өкінемін...
Dialogue: 0,0:07:33.79,0:07:35.95,Default,,0,0,0,,Сіз мұны жасадыңыз. Өте жақсы.
Dialogue: 0,0:07:39.04,0:07:43.75,Default,,0,0,0,,Бірақ сен жеңілдің, менің адамдарым сені қоршап жатыр.
Dialogue: 0,0:07:44.20,0:07:47.45,Default,,0,0,0,,Сізді сақтау мүмкін емес. Жіберу.
Dialogue: 0,0:07:49.33,0:07:50.33,Default,,0,0,0,,Сара
Dialogue: 0,0:07:51.29,0:07:54.70,Default,,0,0,0,,Арттағы орман арқылы өтіп, жолдың бұрылысынан оңға бұрылыңыз.
Dialogue: 0,0:07:54.79,0:07:59.41,Default,,0,0,0,,Ағыстың арғы жағындағы алма ағашына барыңыз.
Dialogue: 0,0:07:59.87,0:08:01.95,Default,,0,0,0,,Одан құтылуға болады
Dialogue: 0,0:08:02.04,0:08:05.45,Default,,0,0,0,,Мұны неге үйретесіз?
Dialogue: 0,0:08:06.58,0:08:08.12,Default,,0,0,0,,Бірақ қазіргі тепе-теңдік қашан бұзылатынын біз білмейміз
Dialogue: 0,0:08:08.20,0:08:12.58,Default,,0,0,0,,Сіз ең жақсы көшбасшы болған сияқтысыз.
Dialogue: 0,0:08:13.91,0:08:15.58,Default,,0,0,0,,Қаш, Сара.
Dialogue: 0,0:10:11.25,0:10:14.25,Default,,0,0,0,,Мен оны бұдан былай ұстай алмаймын
Dialogue: 0,0:10:14.41,0:10:15.41,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:15.87,0:10:17.08,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:10:22.29,0:10:26.00,Default,,0,0,0,,Мақсат - Дракуланы қайта тірілту.
Dialogue: 0,0:10:26.08,0:10:29.62,Default,,0,0,0,,Ол үшін барлық өлім мен қорқыныш?
Dialogue: 0,0:10:30.66,0:10:33.29,Default,,0,0,0,,Түсіндім, сенің күшің...
Dialogue: 0,0:10:33.37,0:10:37.91,Default,,0,0,0,,Ол бүкіл қаланың жандарының күшін біріктірді.
Dialogue: 0,0:10:38.00,0:10:40.95,Default,,0,0,0,,Мен дәлізді басқара алмаймын, бірақ...
Dialogue: 0,0:10:41.33,0:10:43.16,Default,,0,0,0,,Қараңыз, қаншама Ято-ра бар
Dialogue: 0,0:10:43.95,0:10:48.04,Default,,0,0,0,,Артымнан еріп, күшіңді көрсет, құбыжық.
Dialogue: 0,0:10:49.00,0:10:50.58,Default,,0,0,0,,Сіз шынымен сиқыршысыз ба?
Dialogue: 0,0:11:02.95,0:11:04.12,Default,,0,0,0,,Сіздің күшіңіз!
Dialogue: 0,0:11:14.00,0:11:16.08,Default,,0,0,0,,Белмонтты өлтіріңіз!
Dialogue: 0,0:11:48.54,0:11:50.83,Default,,0,0,0,,Мен дәлізді жабамын.
Dialogue: 0,0:11:50.91,0:11:52.83,Default,,0,0,0,,Қазір қашыңыз
Dialogue: 0,0:11:53.54,0:11:54.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:55.58,0:11:57.16,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:11:57.83,0:12:00.12,Default,,0,0,0,,Бір күні тағы кездесейік
Dialogue: 0,0:12:13.08,0:12:14.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:15.04,0:12:16.29,Default,,0,0,0,,Өтірікші ит
Dialogue: 0,0:12:16.37,0:12:17.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:17.08,0:12:20.50,Default,,0,0,0,,Жоқ, мен басқалармен біргемін.
Dialogue: 0,0:12:20.58,0:12:22.58,Default,,0,0,0,,Әркім шындықты жасырады
Dialogue: 0,0:12:22.75,0:12:25.83,Default,,0,0,0,,Бізге ешкім көмектеспейді
Dialogue: 0,0:12:25.91,0:12:28.20,Default,,0,0,0,,Қамалды жылжытайық
Dialogue: 0,0:12:28.29,0:12:32.70,Default,,0,0,0,,Құпияларыңызды ашып, сол күш-қуатты ел құруға жұмсаңыз.
Dialogue: 0,0:12:33.04,0:12:34.75,Default,,0,0,0,,Мен бәрін берсем де
Dialogue: 0,0:12:34.83,0:12:37.41,Default,,0,0,0,,Бұл өтірік. Бұлай емес.
Dialogue: 0,0:12:38.50,0:12:41.70,Default,,0,0,0,,Жолда да мені алдап жүре бердім.
Dialogue: 0,0:12:42.75,0:12:45.50,Default,,0,0,0,,Саған не сенуім керек?
Dialogue: 0,0:12:46.70,0:12:48.41,Default,,0,0,0,,Шынайы болуға барынша тырыстым.
Dialogue: 0,0:12:49.12,0:12:52.50,Default,,0,0,0,,Сиқырды үйретпе, сарайларды жылжытпа
Dialogue: 0,0:12:52.58,0:12:54.04,Default,,0,0,0,,Мен бәріңмен біргемін.
Dialogue: 0,0:12:54.33,0:12:55.33,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:12:55.66,0:12:57.66,Default,,0,0,0,,Бұл ауырған болуы керек.
Dialogue: 0,0:12:58.33,0:13:01.12,Default,,0,0,0,,Бірақ әлем қауіп төндірмейді
Dialogue: 0,0:13:02.08,0:13:04.95,Default,,0,0,0,,Мен де сенің жауың емеспін.
Dialogue: 0,0:13:06.83,0:13:08.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:11.25,0:13:12.83,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:13:31.29,0:13:34.37,Default,,0,0,0,,Әкем сиқырлы қаруды жек көретін, бірақ...
Dialogue: 0,0:13:36.66,0:13:38.83,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:13:54.29,0:13:56.04,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:14:36.75,0:14:38.62,Default,,0,0,0,,Мен Сараны өлтірдім.
Dialogue: 0,0:14:38.79,0:14:40.04,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:14:46.50,0:14:51.45,Default,,0,0,0,,Арттағы орман арқылы өтіп, жолдың бұрылысынан оңға бұрылыңыз.
Dialogue: 0,0:14:52.79,0:14:54.20,Default,,0,0,0,,Ол одан да жоғары.
Dialogue: 0,0:14:55.58,0:14:57.20,Default,,0,0,0,,Маған пышақты беріңіз
Dialogue: 0,0:14:57.79,0:14:58.66,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:14:59.25,0:15:03.83,Default,,0,0,0,,Алдымен тозаққа барыңыз және оның келуін күтіңіз.
Dialogue: 0,0:15:04.04,0:15:07.25,Default,,0,0,0,,Мен сені тағы да өлтіремін.
Dialogue: 0,0:15:16.33,0:15:18.66,Default,,0,0,0,,Менің үйімді өртеп жібер
Dialogue: 0,0:17:00.29,0:17:01.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:02.58,0:17:03.70,Default,,0,0,0,,Бұл тұзақ па?
Dialogue: 0,0:17:05.83,0:17:07.66,Default,,0,0,0,,Көп рет қолданылған
Dialogue: 0,0:17:07.95,0:17:10.25,Default,,0,0,0,,Анау кішкентай сүйек ше?
Dialogue: 0,0:17:11.04,0:17:12.25,Default,,0,0,0,,Бұл жануар ма?
Dialogue: 0,0:17:28.29,0:17:30.37,Default,,0,0,0,,«Үйді өртеп жібер»
Dialogue: 0,0:17:30.70,0:17:35.83,Default,,0,0,0,,Қалған үйді өртеп жіберуім керек пе?
Dialogue: 0,0:17:36.08,0:17:38.20,Default,,0,0,0,,Осыны қалайды
Dialogue: 0,0:17:38.50,0:17:39.75,Default,,0,0,0,,Әзірге-
Dialogue: 0,0:17:40.41,0:17:41.45,Default,,0,0,0,,Кірейік.
Dialogue: 0,0:17:54.00,0:17:56.79,Default,,0,0,0,,Маған бұл бөлме қызық.
Dialogue: 0,0:17:56.95,0:17:58.50,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:17:58.70,0:18:00.04,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:18:00.25,0:18:02.37,Default,,0,0,0,,Ол жақсы дайындалған адам болатын.
Dialogue: 0,0:18:02.66,0:18:06.25,Default,,0,0,0,,Пайдалы нәрсе болуы мүмкін
Dialogue: 0,0:18:24.62,0:18:28.25,Default,,0,0,0,,Мұнда әрқайсысы үлкен мәселе.
Dialogue: 0,0:18:28.79,0:18:33.00,Default,,0,0,0,,Егіннің зақымдануы, ауру және жоғалған балалар
Dialogue: 0,0:18:33.33,0:18:36.54,Default,,0,0,0,,Көшбасшы болу қиыншылыққа толы.
Dialogue: 0,0:18:37.29,0:18:39.16,Default,,0,0,0,,Бұл көңілді болуы мүмкін
Dialogue: 0,0:18:39.79,0:18:42.00,Default,,0,0,0,,Шұңқырда киімнің бір бөлігі бар.
Dialogue: 0,0:18:42.95,0:18:44.50,Default,,0,0,0,,Ұсақ сүйектер де
Dialogue: 0,0:18:44.83,0:18:45.83,Default,,0,0,0,,О
Dialogue: 0,0:18:46.41,0:18:49.12,Default,,0,0,0,,«Сара өлтірілді»
Dialogue: 0,0:18:49.87,0:18:50.95,Default,,0,0,0,,О
Dialogue: 0,0:18:51.83,0:18:53.41,Default,,0,0,0,,Бұл оның тұзағы, солай емес пе?
Dialogue: 0,0:18:55.08,0:18:56.95,Default,,0,0,0,,Адамдарды соттау...
Dialogue: 0,0:18:57.50,0:18:59.91,Default,,0,0,0,,Ол айтып отырған «қызық» болды ма?
Dialogue: 0,0:19:38.91,0:19:41.83,Default,,0,0,0,,Мен қазір осы жерден кеткім келеді.
Dialogue: 0,0:19:43.25,0:19:44.91,Default,,0,0,0,,Демек, мұнда Бағана болған екен ғой?
Dialogue: 0,0:19:56.91,0:19:58.83,Default,,0,0,0,,Морана – данышпан
Dialogue: 0,0:19:58.91,0:20:01.20,Default,,0,0,0,,Оны ойлап тапқан менмін.
Dialogue: 0,0:20:01.54,0:20:03.25,Default,,0,0,0,,Тоқта, Стрига.
Dialogue: 0,0:20:04.25,0:20:06.87,Default,,0,0,0,,«Морана – данышпан» деңіз
Dialogue: 0,0:20:07.75,0:20:10.12,Default,,0,0,0,,Мен өнертапқышпын
Dialogue: 0,0:20:10.25,0:20:14.16,Default,,0,0,0,,Сіздің идеяларыңыз әрқашан осылай көрінеді.
Dialogue: 0,0:20:14.25,0:20:17.41,Default,,0,0,0,,«Балықты ұрып, от жағамыз».
Dialogue: 0,0:20:18.12,0:20:21.58,Default,,0,0,0,,Морана болмаса, ол мағынасыз болып қала береді.
Dialogue: 0,0:20:22.16,0:20:23.83,Default,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 0,0:20:23.91,0:20:26.54,Default,,0,0,0,,Ол да біледі.
Dialogue: 0,0:20:26.62,0:20:28.62,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:20:29.00,0:20:30.45,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:20:30.54,0:20:32.87,Default,,0,0,0,,Сіз қалай сенімді бола аласыз?
Dialogue: 0,0:20:32.95,0:20:34.41,Default,,0,0,0,,Өйткені ол данышпан
Dialogue: 0,0:20:35.20,0:20:38.12,Default,,0,0,0,,Бәрі де данышпан, сабыр ет.
Dialogue: 0,0:20:38.66,0:20:40.95,Default,,0,0,0,,Ол кісіні мұнда неге әкелдің?
Dialogue: 0,0:20:41.16,0:20:45.79,Default,,0,0,0,,Бұл төрт адамға арналған бөлме, тіпті менің қарамағындағыларды да кіргізбейді.
Dialogue: 0,0:20:48.25,0:20:50.79,Default,,0,0,0,,Мен өз күшімді алған адамым
Dialogue: 0,0:20:51.75,0:20:53.95,Default,,0,0,0,,Қатысу керек
Dialogue: 0,0:20:54.20,0:20:55.25,Default,,0,0,0,,Ууух!
Dialogue: 0,0:20:55.75,0:20:56.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:57.00,0:21:01.66,Default,,0,0,0,,Маған оны құлыптағы сиқыршылардың бірі жасады.
Dialogue: 0,0:21:01.79,0:21:03.79,Default,,0,0,0,,Мен де одан кітап алдым.
Dialogue: 0,0:21:04.79,0:21:08.25,Default,,0,0,0,,Әлгі темір ұстасы? Батыл таңдау
Dialogue: 0,0:21:08.66,0:21:12.25,Default,,0,0,0,,Стриганың сауыттарын балқытқаны үшін жаза ретінде...
Dialogue: 0,0:21:12.33,0:21:16.95,Default,,0,0,0,,Рождество кезінде күн сәулесінің әсері
Dialogue: 0,0:21:17.12,0:21:20.62,Default,,0,0,0,,Сүйікті қария, тіпті сол толғақтары да.
Dialogue: 0,0:21:21.16,0:21:22.37,Default,,0,0,0,,Бағыну сақинасы
Dialogue: 0,0:21:22.83,0:21:27.95,Default,,0,0,0,,Мен оны Гекторға ант бергенде бердім.
Dialogue: 0,0:21:28.04,0:21:29.54,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:21:29.62,0:21:32.29,Default,,0,0,0,,Иә, жыныстық қатынас кезінде.
Dialogue: 0,0:21:33.29,0:21:38.25,Default,,0,0,0,,Өздеріңіз білетіндей, ол адал құбыжықтарды иіскейді.
Dialogue: 0,0:21:38.33,0:21:43.37,Default,,0,0,0,,Бірақ оның өзі сақинаның күшімен менің бақылауымда.
Dialogue: 0,0:21:43.45,0:21:46.29,Default,,0,0,0,,Оның соңынан ерген құбыжықтар...
Dialogue: 0,0:21:46.37,0:21:50.41,Default,,0,0,0,,Ол да маған адал, адал болуға ант берген адамға.
Dialogue: 0,0:21:51.79,0:21:53.08,Default,,0,0,0,,Сол сақина
Dialogue: 0,0:21:54.04,0:21:58.50,Default,,0,0,0,,Оны киіп алсаң, құбыжықтар ойына келгенін істейді.
Dialogue: 0,0:21:59.33,0:22:03.00,Default,,0,0,0,,Гектор бүлік шығарса немесе қашып кетсе...
Dialogue: 0,0:22:03.08,0:22:05.70,Default,,0,0,0,,Сақина қатты ауырсынуды тудырады
Dialogue: 0,0:22:05.95,0:22:09.04,Default,,0,0,0,,Ауырғаным сонша, өлгім келеді.
Dialogue: 0,0:22:09.29,0:22:10.41,Default,,0,0,0,,Есеп шешілді
Dialogue: 0,0:22:12.20,0:22:13.91,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:22:15.45,0:22:19.66,Default,,0,0,0,,Оның орнына оған баспана беріңіз.
Dialogue: 0,0:22:20.20,0:22:21.75,Default,,0,0,0,,Үйіңіз жақсы болсын.
Dialogue: 0,0:22:22.58,0:22:27.75,Default,,0,0,0,,Қамалдағы қалыпты өмір мен еркіндікке кепілдік беру
Dialogue: 0,0:22:28.37,0:22:30.25,Default,,0,0,0,,Мен келіспеймін.
Dialogue: 0,0:22:30.33,0:22:31.37,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:22:31.75,0:22:33.75,Default,,0,0,0,,Марапаттар қажет
Dialogue: 0,0:22:33.83,0:22:37.29,Default,,0,0,0,,Ыңғайлы және қауіпсіз күнделікті өмірді қамтамасыз ету
Dialogue: 0,0:22:39.45,0:22:40.66,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:22:41.58,0:22:43.37,Default,,0,0,0,,Мен маңызды әңгіменің ортасындамын.
Dialogue: 0,0:22:43.83,0:22:47.16,Default,,0,0,0,,Морана және Стрига көмегімен өңдеуді басқарыңыз
Dialogue: 0,0:22:47.29,0:22:49.95,Default,,0,0,0,,Кармилла да ымыраға келді.
Dialogue: 0,0:22:53.62,0:22:56.83,Default,,0,0,0,,Ленор данышпан болды
Dialogue: 0,0:22:57.66,0:23:01.54,Default,,0,0,0,,Барлығы оның қолында болды ма?
Dialogue: 0,0:23:02.29,0:23:03.91,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:23:04.58,0:23:06.50,Default,,0,0,0,,Мұны қалай сақтауға батылыңыз бар?
Dialogue: 0,0:23:07.04,0:23:08.33,Default,,0,0,0,,Кармилла?
Dialogue: 0,0:23:09.08,0:23:11.45,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен түсінемін.
Dialogue: 0,0:23:11.58,0:23:14.00,Default,,0,0,0,,Сізге де үлкен төсек керек
Dialogue: 0,0:23:14.41,0:23:18.04,Default,,0,0,0,,Ол жыныстық қатынаста жақсы, мен оны жаттықтырғым келеді.
Dialogue: 0,0:23:18.33,0:23:20.20,Default,,0,0,0,,Мені тастап кетіңізші.
Dialogue: 0,0:23:20.29,0:23:21.29,Default,,0,0,0,,Қазір барыңыз
Dialogue: 0,0:23:21.37,0:23:23.87,Default,,0,0,0,,Бұл пайдасыз ақпарат.
Dialogue: 0,0:23:24.37,0:23:26.08,Default,,0,0,0,,Білу керек пе?
Dialogue: 0,0:23:37.00,0:23:39.37,Default,,0,0,0,,Жарайсың, мені алдадың.
Dialogue: 0,0:23:41.58,0:23:43.58,Default,,0,0,0,,Сіз қате түсіндіңіз.
Dialogue: 0,0:23:44.41,0:23:46.62,Default,,0,0,0,,Мені құл етті
Dialogue: 0,0:23:47.54,0:23:49.08,Default,,0,0,0,,Жою
Dialogue: 0,0:23:50.66,0:23:53.20,Default,,0,0,0,,Мен сені құтқардым.
Dialogue: 0,0:23:53.66,0:23:56.37,Default,,0,0,0,,Мен де сенің қалағаныңды бердім.
Dialogue: 0,0:23:59.33,0:24:01.37,Default,,0,0,0,,Сіз үй жануарысыз
Dialogue: 0,0:24:28.95,0:24:31.33,Default,,0,0,0,,Нәтиже ең нашар болды.
Dialogue: 0,0:24:32.41,0:24:33.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:38.08,0:24:41.25,Default,,0,0,0,,Біз сенің өміріңді бірге өткіздік.
Dialogue: 0,0:24:42.12,0:24:44.58,Default,,0,0,0,,Сізге шытырман оқиғалар мен жеңістерге толы күндер тілейміз.
Dialogue: 0,0:24:45.00,0:24:46.33,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:24:47.12,0:24:49.37,Default,,0,0,0,,Менің өмірім
Dialogue: 0,0:25:23.83,0:25:24.83,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:25.25,0:25:27.95,Default,,0,0,0,,Маңдайша қажет болды.
Dialogue: 0,0:25:28.83,0:25:32.25,Default,,0,0,0,,«Кет, сен өлесің, үмітіңді үз».
Dialogue: 0,0:25:33.66,0:25:34.95,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:25:49.37,0:25:51.20,Default,,0,0,0,,Сіз оны пайдалана алатын сияқтысыз.
Dialogue: 0,0:25:52.58,0:25:54.20,Default,,0,0,0,,Марқұм әкем үшін
Dialogue: 0,0:27:34.95,0:27:37.00,Default,,0,0,0,,Жапон субтитрлері Акико Вакасуги
Dialogue: 0,0:27:38.50,0:27:44.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory