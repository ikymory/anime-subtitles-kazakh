Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.50,0:00:06.71,Default,,0,0,0,,Сәлем! балалар не істеп жатырсыңдар
Dialogue: 0,0:00:06.79,0:00:08.13,Default,,0,0,0,,Артқа бұрылыңыз
Dialogue: 0,0:00:08.21,0:00:10.63,Default,,0,0,0,,Сіз байсалдысыз ба, Мононобе мырза?
Dialogue: 0,0:00:10.71,0:00:13.38,Default,,0,0,0,,Британдық жалдамалы сарбаз Йохейден сұрауға қалай батылы бардыңыз?
Dialogue: 0,0:00:13.88,0:00:15.89,Default,,0,0,0,,Біз Курото Куротоға көмектесеміз!
Dialogue: 0,0:00:26.02,0:00:27.56,Default,,0,0,0,,Шимура Шимура Канеда Канеда!
Dialogue: 0,0:00:27.65,0:00:28.86,Default,,0,0,0,,Асықпа!
Dialogue: 0,0:00:28.94,0:00:30.69,Default,,0,0,0,,Тек сендер болсаңдар да қайтыңдар.
Dialogue: 0,0:00:30.78,0:00:33.65,Default,,0,0,0,,Кем дегенде, сыртқы қабырға!
Dialogue: 0,0:00:42.45,0:00:43.87,Default,,0,0,0,,Егер сіз бүкіл ұшақты соқсаңыз...
Dialogue: 0,0:00:43.96,0:00:45.79,Default,,0,0,0,,Күткендей сол қалың қабырға...
Dialogue: 0,0:00:45.87,0:00:47.25,Default,,0,0,0,,өту керек
Dialogue: 0,0:00:47.33,0:00:48.38,Default,,0,0,0,,Ах
Dialogue: 0,0:00:48.46,0:00:50.59,Default,,0,0,0,,Ю... бұл басқарылатын ракета!
Dialogue: 0,0:00:51.42,0:00:52.84,Default,,0,0,0,,Не!
Dialogue: 0,0:00:55.68,0:00:56.80,Default,,0,0,0,,(Байланыс шуы)
Dialogue: 0,0:00:56.89,0:00:59.55,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:01:05.81,0:01:08.86,Default,,0,0,0,,Бұл Абашілі концлагерінің деректері.
Dialogue: 0,0:01:08.94,0:01:12.44,Default,,0,0,0,,Менің ойымша, бұл ұнамсыз бейне, бірақ мен екеуің бір қараңдар деп ойлаймын.
Dialogue: 0,0:01:13.15,0:01:14.36,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:01:14.44,0:01:17.11,Default,,0,0,0,,Мен ағамнан кейін қараймын.
Dialogue: 0,0:01:17.20,0:01:20.62,Default,,0,0,0,,Бірақ лагерьде керемет қорғаныс бар.
Dialogue: 0,0:01:20.70,0:01:23.24,Default,,0,0,0,,Бұл ақпарат өте пайдалы болып көрінеді.
Dialogue: 0,0:01:23.33,0:01:25.12,Default,,0,0,0,,Эй, кел! иә?
Dialogue: 0,0:01:25.21,0:01:27.37,Default,,0,0,0,,Бұл не дейді?
Dialogue: 0,0:01:27.46,0:01:28.50,Default,,0,0,0,,Эномото мырза және т.б
Dialogue: 0,0:01:28.58,0:01:30.67,Default,,0,0,0,,Мен саған қызмет ету үшін өлген жоқпын...
Dialogue: 0,0:01:30.75,0:01:34.21,Default,,0,0,0,,Сонымен, сен жылап, мұңайсаң, олар қуана ма?
Dialogue: 0,0:01:34.30,0:01:37.59,Default,,0,0,0,,Операция сәтті болуы үшін бұл бейнені пайдаланған дұрыс.
Dialogue: 0,0:01:37.68,0:01:39.72,Default,,0,0,0,,Бұл олардың жерлеу рәсімі емес пе?
Dialogue: 0,0:01:39.80,0:01:40.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:40.72,0:01:41.93,Default,,0,0,0,,Сіз ұрыс таңдайсыз ба?
Dialogue: 0,0:01:40.72,0:01:42.26,Default,,0,0,0,,Сұраныс дегеніміз не?
Dialogue: 0,0:01:42.01,0:01:42.89,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:01:42.35,0:01:44.89,Default,,0,0,0,,Түрмеде отырған Кенсей Курото және
Dialogue: 0,0:01:42.97,0:01:44.89,Default,,0,0,0,,Эй, мына жаққа бұрыл! Эй, міне!
Dialogue: 0,0:01:44.97,0:01:47.14,Default,,0,0,0,,Мүшелердің құтқару ынтымақтастығын елемеңіз!
Dialogue: 0,0:01:47.23,0:01:48.35,Default,,0,0,0,,Сонымен... бұл жақсы.
Dialogue: 0,0:01:47.23,0:01:49.19,Default,,0,0,0,,Сәлем! Ах, мен ашуланып қалдым
Dialogue: 0,0:01:48.44,0:01:50.11,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:01:49.27,0:01:51.02,Default,,0,0,0,,Жүр, қазір істейік.
Dialogue: 0,0:01:50.19,0:01:51.02,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:01:51.11,0:01:52.94,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:01:51.77,0:01:54.69,Default,,0,0,0,,Мен де қате айттым, кешіріңіз.
Dialogue: 0,0:01:54.78,0:01:56.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:56.86,0:01:58.36,Default,,0,0,0,,Түсінсеңіз жақсы.
Dialogue: 0,0:01:58.45,0:01:59.91,Default,,0,0,0,,Сен өте ақымақсың
Dialogue: 0,0:01:59.99,0:02:02.24,Default,,0,0,0,,Шулы болған жақсы емес пе?
Dialogue: 0,0:02:02.74,0:02:04.62,Default,,0,0,0,,Ой, бұл не (ит)?
Dialogue: 0,0:02:04.70,0:02:06.79,Default,,0,0,0,,Ей, уау, суық!
Dialogue: 0,0:02:06.87,0:02:07.96,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:02:08.04,0:02:10.04,Default,,0,0,0,,Не істеп жатырсың, аға?
Dialogue: 0,0:02:10.13,0:02:12.71,Default,,0,0,0,,Мен бұл өте лас нәрсені жудым.
Dialogue: 0,0:02:12.79,0:02:14.50,Default,,0,0,0,,Дәл мен сенен көзімді алғанда
Dialogue: 0,0:02:14.59,0:02:15.76,Default,,0,0,0,,...
Dialogue: 0,0:02:15.84,0:02:17.09,Default,,0,0,0,,О, сүйкімді
Dialogue: 0,0:02:17.17,0:02:18.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:18.63,0:02:19.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:19.63,0:02:21.43,Default,,0,0,0,,Не? сәл
Dialogue: 0,0:02:21.51,0:02:22.64,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:22.72,0:02:24.22,Default,,0,0,0,,Жоқ, себебі...
Dialogue: 0,0:02:24.31,0:02:25.43,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:02:25.52,0:02:28.06,Default,,0,0,0,,Сіздің денеңіз әдемі.
Dialogue: 0,0:02:28.14,0:02:30.90,Default,,0,0,0,,Оның үстіне оның мазохистік жағы тағы да тартымды.
Dialogue: 0,0:02:30.98,0:02:32.94,Default,,0,0,0,,Бұл Йоко Йоко-сан.
Dialogue: 0,0:02:33.02,0:02:35.36,Default,,0,0,0,,Тым аз шиеленіс.
Dialogue: 0,0:02:35.44,0:02:39.61,Default,,0,0,0,,Бұл операция - Жеті жарқыраған жұлдыз шоғырының Шичикосейданының аман қалуы үшін шешуші шайқас.
Dialogue: 0,0:02:39.70,0:02:42.20,Default,,0,0,0,,Балалар, сендер де абай болыңдар.
Dialogue: 0,0:02:42.28,0:02:43.45,Default,,0,0,0,,О!
Dialogue: 0,0:02:44.33,0:02:47.04,Default,,0,0,0,,Сен неге басшысың!
Dialogue: 0,0:02:48.04,0:02:53.04,Default,,0,0,0,,♪～
Dialogue: 0,0:04:13.87,0:04:17.92,Default,,0,0,0,,～♪
Dialogue: 0,0:04:19.34,0:04:20.92,Default,,0,0,0,,Кенсей Курото...
Dialogue: 0,0:04:21.01,0:04:24.22,Default,,0,0,0,,Жапония азат ету фронтының бұрынғы гвардия капитаны
Dialogue: 0,0:04:24.30,0:04:27.93,Default,,0,0,0,,Бұрынғы феодал император Сумераги Джугоны қорғауға жауапты
Dialogue: 0,0:04:28.01,0:04:29.35,Default,,0,0,0,,Саппоро оқиғасынан кейін
Dialogue: 0,0:04:29.43,0:04:33.56,Default,,0,0,0,,«Жеті жұлдыз кластері» террористік ұйымының жетекшісі ретінде әрекет етеді.
Dialogue: 0,0:04:33.64,0:04:36.02,Default,,0,0,0,,Оның орындалуы жақындайды
Dialogue: 0,0:04:36.10,0:04:38.11,Default,,0,0,0,,Он бірлер шу шығарып жатқан сияқты.
Dialogue: 0,0:04:38.19,0:04:40.82,Default,,0,0,0,,Кішкентай шыбындар ғана ұшады.
Dialogue: 0,0:04:40.90,0:04:43.70,Default,,0,0,0,,Арнольд мырза, Шварц рыцарлары,
Dialogue: 0,0:04:43.78,0:04:46.41,Default,,0,0,0,,Бару үшін жолдан шығудың қажеті жоқ.
Dialogue: 0,0:04:46.49,0:04:48.07,Default,,0,0,0,,Құрметті басшы
Dialogue: 0,0:04:48.16,0:04:49.74,Default,,0,0,0,,Ноланд фон Люнеберг
Dialogue: 0,0:04:49.83,0:04:51.16,Default,,0,0,0,,Бұйрық болса
Dialogue: 0,0:04:51.24,0:04:53.20,Default,,0,0,0,,Кез келген жерден кету
Dialogue: 0,0:04:53.29,0:04:54.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.25,0:04:57.25,Default,,0,0,0,,Бұл лагерьдің қорғанысы өтпейді.
Dialogue: 0,0:04:57.33,0:05:00.13,Default,,0,0,0,,Біздің күшімізге сенсең де,
Dialogue: 0,0:05:00.21,0:05:02.51,Default,,0,0,0,,Жауабын естігіңіз келсе
Dialogue: 0,0:05:02.59,0:05:04.63,Default,,0,0,0,,Ноланд мырзадан тікелей сұраңыз.
Dialogue: 0,0:05:05.26,0:05:06.88,Default,,0,0,0,,Шынымен
Dialogue: 0,0:05:06.97,0:05:08.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:08.09,0:05:10.47,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:10.56,0:05:11.93,Default,,0,0,0,,Директор айтқандай
Dialogue: 0,0:05:12.02,0:05:15.81,Default,,0,0,0,,Менің көрінуіміз өте сақтық сияқты.
Dialogue: 0,0:05:15.89,0:05:18.40,Default,,0,0,0,,Кирквейн командасының жеңілгенін ұмыттыңыз ба?
Dialogue: 0,0:05:19.02,0:05:21.52,Default,,0,0,0,,Сіз Нанашидің жалдамалысысыз ба?
Dialogue: 0,0:05:21.61,0:05:24.78,Default,,0,0,0,,Террористерге көмектесу мүмкіндігі
Dialogue: 0,0:05:24.86,0:05:27.11,Default,,0,0,0,,Сақ болған жөн
Dialogue: 0,0:05:27.20,0:05:28.57,Default,,0,0,0,,Га
Dialogue: 0,0:05:28.66,0:05:31.78,Default,,0,0,0,,Мен мұны қалаймын.
Dialogue: 0,0:05:32.54,0:05:35.08,Default,,0,0,0,,НеоБританияны азғыратындар
Dialogue: 0,0:05:35.16,0:05:37.54,Default,,0,0,0,,Мен бәрін жоямын
Dialogue: 0,0:05:41.75,0:05:43.42,Default,,0,0,0,,Дәмді
Dialogue: 0,0:05:43.50,0:05:45.51,Default,,0,0,0,,Биейден алынған лаванда шайы.
Dialogue: 0,0:05:45.59,0:05:46.63,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:05:46.72,0:05:48.18,Default,,0,0,0,,Құрметті Кэтрин, иә?
Dialogue: 0,0:05:49.01,0:05:50.68,Default,,0,0,0,,Бұл Ноланд мырзаның хабарламасы.
Dialogue: 0,0:05:50.76,0:05:52.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:53.10,0:05:55.93,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:56.56,0:05:57.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:57.64,0:06:00.40,Default,,0,0,0,,Император Сакуяның лагерьде болуы
Dialogue: 0,0:06:00.48,0:06:02.61,Default,,0,0,0,,Мен Жеті жарқыраған жұлдыз шоғырына айтқан жоқпын.
Dialogue: 0,0:06:02.69,0:06:04.44,Default,,0,0,0,,Бұл қажет емес ақпарат.
Dialogue: 0,0:06:05.03,0:06:06.53,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:06:06.61,0:06:08.24,Default,,0,0,0,,Лагерьлер туралы не деуге болады?
Dialogue: 0,0:06:08.32,0:06:09.28,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:06:09.86,0:06:11.41,Default,,0,0,0,,Нағыз қамал
Dialogue: 0,0:06:11.49,0:06:13.08,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:06:13.70,0:06:15.83,Default,,0,0,0,,Мен ағамнан қолынан келгеннің бәрін істеуін сұрауым керек.
Dialogue: 0,0:06:15.91,0:06:17.33,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:06:18.16,0:06:20.58,Default,,0,0,0,,Біз Сумераги Сакуяға көмектесеміз.
Dialogue: 0,0:06:21.17,0:06:22.67,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:22.75,0:06:23.71,Default,,0,0,0,,О
Dialogue: 0,0:06:24.46,0:06:25.63,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:06:25.71,0:06:27.76,Default,,0,0,0,,Мен осы уақытқа дейін дайындалдым.
Dialogue: 0,0:06:29.05,0:06:33.14,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:06:34.85,0:06:36.27,Default,,0,0,0,,Жарайды, кешір.
Dialogue: 0,0:06:36.35,0:06:37.56,Default,,0,0,0,,Роза?
Dialogue: 0,0:06:38.14,0:06:40.60,Default,,0,0,0,,Жеті жұлдыз шоғырының халқына
Dialogue: 0,0:06:40.69,0:06:44.15,Default,,0,0,0,,Мен лагерьге басып кіріп, нұсқау беретінімді айттым.
Dialogue: 0,0:06:44.23,0:06:46.07,Default,,0,0,0,,Жоқ, күту керек.
Dialogue: 0,0:06:46.15,0:06:48.82,Default,,0,0,0,,Сіз кіру кезінде G-ге төтеп бере алмайсыз.
Dialogue: 0,0:06:48.90,0:06:50.86,Default,,0,0,0,,Мен мұны ертерек айтқан жоқпын ба?
Dialogue: 0,0:06:50.95,0:06:53.07,Default,,0,0,0,,Мен бұл күнге дайындалдым.
Dialogue: 0,0:06:53.16,0:06:56.79,Default,,0,0,0,,Майданға шығып нұсқау бермесем, жақсы емес.
Dialogue: 0,0:06:56.87,0:06:57.87,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:05.13,0:07:06.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:06.84,0:07:08.80,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,0:07:12.01,0:07:13.30,Default,,0,0,0,,Бір үлкен трейлер
Dialogue: 0,0:07:13.39,0:07:15.68,Default,,0,0,0,,Сізге қарай келе жатыр
Dialogue: 0,0:07:15.76,0:07:18.10,Default,,0,0,0,,Егер ол ауқымға жетсе, оны атып тастаңыз.
Dialogue: 0,0:07:18.18,0:07:19.89,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:22.06,0:07:23.23,Default,,0,0,0,,Мақсатқа жетті
Dialogue: 0,0:07:23.31,0:07:24.48,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:24.56,0:07:25.94,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:30.53,0:07:32.11,Default,,0,0,0,,Жоғары жылу көзінің тәсілі
Dialogue: 0,0:07:32.20,0:07:33.57,Default,,0,0,0,,Я...
Dialogue: 0,0:07:33.66,0:07:35.91,Default,,0,0,0,,Ұстау жүйесін іске қосу
Dialogue: 0,0:07:39.37,0:07:41.37,Default,,0,0,0,,Алға!
Dialogue: 0,0:07:46.09,0:07:46.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:51.72,0:07:52.97,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:53.51,0:07:55.43,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:07:55.51,0:07:57.76,Default,,0,0,0,,Мақсат осы жерден алыс
Dialogue: 0,0:07:57.85,0:08:00.52,Default,,0,0,0,,Хахахаха бұл не?
Dialogue: 0,0:08:00.60,0:08:03.90,Default,,0,0,0,,Жарайды, бұл көз ауыртады, оны атып таста.
Dialogue: 0,0:08:07.57,0:08:08.57,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:08.65,0:08:09.90,Default,,0,0,0,,(Рам) Балс. (Субару) Ах…
Dialogue: 0,0:08:18.20,0:08:19.24,Default,,0,0,0,,Уф
Dialogue: 0,0:08:21.91,0:08:22.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:32.01,0:08:34.63,Default,,0,0,0,,Бір түнгі түн үйге басып кіреді.
Dialogue: 0,0:08:34.72,0:08:35.55,Default,,0,0,0,,Не!
Dialogue: 0,0:08:35.64,0:08:37.18,Default,,0,0,0,,Дабылды шұғыл көтеріңіз!
Dialogue: 0,0:08:37.26,0:08:38.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:39.76,0:08:40.77,Default,,0,0,0,,Эй
Dialogue: 0,0:08:42.18,0:08:43.31,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:43.39,0:08:44.89,Default,,0,0,0,,Раушанды оят
Dialogue: 0,0:08:45.48,0:08:47.36,Default,,0,0,0,,Сол жігіт Юхамонды пайдаланып, қасақана ұрлықтар жасап жүрген
Dialogue: 0,0:08:49.36,0:08:50.36,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:50.44,0:08:51.90,Default,,0,0,0,,Ах
Dialogue: 0,0:08:51.98,0:08:53.95,Default,,0,0,0,,Жақсы, жақсысың ба?
Dialogue: 0,0:08:54.65,0:08:56.86,Default,,0,0,0,,Иә, абай боламын
Dialogue: 0,0:08:57.91,0:08:59.87,Default,,0,0,0,,Лагерьге еніп кетті
Dialogue: 0,0:08:59.95,0:09:02.87,Default,,0,0,0,,Енді біз сыртқы қабырғаны көрсетілген жерде қиратамыз.
Dialogue: 0,0:09:02.95,0:09:04.58,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:09:04.66,0:09:07.04,Default,,0,0,0,,Жарайды, лагерьге барайық.
Dialogue: 0,0:09:07.12,0:09:07.96,Default,,0,0,0,,Бұл жолы——
Dialogue: 0,0:09:08.04,0:09:10.25,Default,,0,0,0,,Көшбасшыны қайтарайық!
Dialogue: 0,0:09:11.30,0:09:13.34,Default,,0,0,0,,А... мінекей.
Dialogue: 0,0:09:13.42,0:09:14.63,Default,,0,0,0,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:09:14.72,0:09:16.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:16.13,0:09:19.18,Default,,0,0,0,,Оның орнына нұсқауларды орындаңыз, ағайын.
Dialogue: 0,0:09:19.26,0:09:22.10,Default,,0,0,0,,Мен білемін, маған қалдырыңыз.
Dialogue: 0,0:09:23.56,0:09:24.64,Default,,0,0,0,,Арнольд мырза
Dialogue: 0,0:09:24.73,0:09:26.27,Default,,0,0,0,,Сіз келген сияқтысыз.
Dialogue: 0,0:09:26.94,0:09:30.19,Default,,0,0,0,,Босқа кетпегеніне қуаныштымын.
Dialogue: 0,0:09:30.27,0:09:32.44,Default,,0,0,0,,Жау ұшағына жақындап келе жатқан кошмар отряды
Dialogue: 0,0:09:32.53,0:09:34.15,Default,,0,0,0,,Сырттан алты ұшақ жақындап келеді.
Dialogue: 0,0:09:34.82,0:09:37.78,Default,,0,0,0,,А... бұл қалай болды?
Dialogue: 0,0:09:37.86,0:09:39.41,Default,,0,0,0,,Күшейткіштерден де сұрыптауды сұраңыз!
Dialogue: 0,0:09:39.49,0:09:41.45,Default,,0,0,0,,Бұлай шықпасаң жақсы.
Dialogue: 0,0:09:41.53,0:09:42.91,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,0:09:44.79,0:09:47.79,Default,,0,0,0,,Бұлай болмайды.
Dialogue: 0,0:09:50.17,0:09:51.25,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:09:51.34,0:09:54.26,Default,,0,0,0,,Барлық тұтқындарды босату
Dialogue: 0,0:09:57.97,0:09:59.05,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:10:01.05,0:10:02.97,Default,,0,0,0,,Не?
Dialogue: 0,0:10:03.06,0:10:04.52,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:04.60,0:10:06.60,Default,,0,0,0,,Эй, мынау!
Dialogue: 0,0:10:10.15,0:10:12.44,Default,,0,0,0,,Мен оны шынымен аштым.
Dialogue: 0,0:10:12.52,0:10:16.49,Default,,0,0,0,,Бұл екеуі осы уақытқа дейін жете ала ма?
Dialogue: 0,0:10:16.57,0:10:17.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:18.32,0:10:21.41,Default,,0,0,0,,Ендігі кезекте бар күшімізді саламыз.
Dialogue: 0,0:10:24.62,0:10:25.49,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:10:25.58,0:10:27.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:30.88,0:10:32.25,Default,,0,0,0,,Ах
Dialogue: 0,0:10:38.13,0:10:39.30,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:10:39.38,0:10:40.80,Default,,0,0,0,,Сакура
Dialogue: 0,0:10:42.72,0:10:44.10,Default,,0,0,0,,Ha
Dialogue: 0,0:10:47.81,0:10:49.69,Default,,0,0,0,,Құрметті Сакуя
Dialogue: 0,0:10:55.78,0:10:57.49,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:10:57.57,0:10:59.24,Default,,0,0,0,,Біз ақыры кездестік
Dialogue: 0,0:10:59.32,0:11:01.70,Default,,0,0,0,,Мен де сенімен танысқым келді.
Dialogue: 0,0:11:05.70,0:11:07.16,Default,,0,0,0,,Сакура!
Dialogue: 0,0:11:08.91,0:11:10.62,Default,,0,0,0,,Неге! Бұл...
Dialogue: 0,0:11:10.71,0:11:13.08,Default,,0,0,0,,Менің орнымда рұқсатсыз бірдеңе істе!
Dialogue: 0,0:11:14.59,0:11:17.21,Default,,0,0,0,,Мен Сакуя-саманың көлеңкелі жауынгерімін.
Dialogue: 0,0:11:17.30,0:11:18.55,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:18.63,0:11:21.38,Default,,0,0,0,,Неліктен мұндай орын?
Dialogue: 0,0:11:21.47,0:11:23.43,Default,,0,0,0,,Сакуя-сама қауіп төнсе...
Dialogue: 0,0:11:23.51,0:11:26.56,Default,,0,0,0,,Досыңа көмектесуге келгеннің несі жаман?
Dialogue: 0,0:11:26.64,0:11:30.60,Default,,0,0,0,,Тіпті Сакура да маған көмектесуге келді.
Dialogue: 0,0:11:40.44,0:11:42.45,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:42.53,0:11:44.37,Default,,0,0,0,,Мырза! сурет?
Dialogue: 0,0:11:45.12,0:11:46.95,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:11:47.03,0:11:49.37,Default,,0,0,0,,Жүр, тез үйге қайт.
Dialogue: 0,0:11:56.21,0:11:57.71,Default,,0,0,0,,Ha
Dialogue: 0,0:12:02.17,0:12:05.09,Default,,0,0,0,,Хехе, әдеттегідей.
Dialogue: 0,0:12:05.80,0:12:07.76,Default,,0,0,0,,Рахмет мырза
Dialogue: 0,0:12:07.85,0:12:08.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:10.43,0:12:11.39,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:11.48,0:12:12.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:12.77,0:12:15.52,Default,,0,0,0,,Жарайды, ол мен жағында.
Dialogue: 0,0:12:15.60,0:12:18.02,Default,,0,0,0,,Маған штабтан хабарлама келді.
Dialogue: 0,0:12:18.11,0:12:20.23,Default,,0,0,0,,Тасымалдау үшін император Сакуя
Dialogue: 0,0:12:20.32,0:12:23.03,Default,,0,0,0,,Вайссритер ақ патшайымы——
Dialogue: 0,0:12:23.11,0:12:24.41,Default,,0,0,0,,сэр Кэтрин Савасула (ысырма дыбысы)
Dialogue: 0,0:12:24.49,0:12:27.16,Default,,0,0,0,,Ол бізге қарай келе жатыр дейді.
Dialogue: 0,0:12:25.20,0:12:27.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:27.24,0:12:30.24,Default,,0,0,0,,Не, вице патшайым?
Dialogue: 0,0:12:30.33,0:12:33.71,Default,,0,0,0,,Сакура Мәліметтерді кейін түсіндіремін.
Dialogue: 0,0:12:33.79,0:12:35.67,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:12:37.63,0:12:39.17,Default,,0,0,0,,О, керемет!
Dialogue: 0,0:12:39.25,0:12:43.30,Default,,0,0,0,,Маған айтқан жерде жаудың түндері көп болды.
Dialogue: 0,0:12:45.59,0:12:46.89,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:12:46.97,0:12:49.01,Default,,0,0,0,,Бірден барайық!
Dialogue: 0,0:12:55.31,0:12:57.35,Default,,0,0,0,,Жақсы өткен сияқты.
Dialogue: 0,0:12:57.44,0:12:58.69,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:12:59.61,0:13:00.86,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:13:00.94,0:13:03.44,Default,,0,0,0,,Өйткені оларда осындай немқұрайлы қауіпсіздік бар.
Dialogue: 0,0:13:03.53,0:13:05.57,Default,,0,0,0,,Оны террористер ұрлайды немесе бір нәрсе.
Dialogue: 0,0:13:06.53,0:13:09.66,Default,,0,0,0,,Өзіңізден басқа барлық ұшақтарды жау ұшағы деп есептеңіз.
Dialogue: 0,0:13:10.41,0:13:11.99,Default,,0,0,0,,Жою!
Dialogue: 0,0:13:12.08,0:13:13.95,Default,,0,0,0,,Иса менің Ием!
Dialogue: 0,0:13:17.00,0:13:18.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:22.88,0:13:24.17,Default,,0,0,0,,Бұлай жалғаса берсе, біз жойыламыз!
Dialogue: 0,0:13:24.26,0:13:26.09,Default,,0,0,0,,Бірге жұмыс жасап, кезектесіп отыруымыз керек.
Dialogue: 0,0:13:26.18,0:13:27.47,Default,,0,0,0,,Ах
Dialogue: 0,0:13:27.55,0:13:29.55,Default,,0,0,0,,Кешіктің, ескі модель!
Dialogue: 0,0:13:32.97,0:13:34.43,Default,,0,0,0,,Кя!
Dialogue: 0,0:13:35.06,0:13:37.48,Default,,0,0,0,,Ерекшеліктер мүлдем басқа
Dialogue: 0,0:13:37.56,0:13:39.52,Default,,0,0,0,,Харука, қаш!
Dialogue: 0,0:13:44.82,0:13:48.20,Default,,0,0,0,,Пойнт Бравоға қосылып, капитан Куротоны алып кетейік.
Dialogue: 0,0:13:52.62,0:13:53.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:09.97,0:14:11.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.22,0:14:17.14,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген ұшақ.
Dialogue: 0,0:14:17.23,0:14:19.52,Default,,0,0,0,,Сатқын жалдамалы?
Dialogue: 0,0:14:19.60,0:14:22.82,Default,,0,0,0,,Әлде бұл Қара рыцарьлардың ақшасы ма?
Dialogue: 0,0:14:23.94,0:14:25.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:26.36,0:14:27.90,Default,,0,0,0,,Тезірек, Сакура!
Dialogue: 0,0:14:29.03,0:14:31.12,Default,,0,0,0,,Өйткені, сэр бізбен бірге!
Dialogue: 0,0:14:31.20,0:14:33.83,Default,,0,0,0,,Менің әлі істейтін істерім бар.
Dialogue: 0,0:14:33.91,0:14:36.16,Default,,0,0,0,,Ах
Dialogue: 0,0:14:38.66,0:14:39.67,Default,,0,0,0,,Кя!
Dialogue: 0,0:14:39.75,0:14:41.92,Default,,0,0,0,,Уф... Сакура, әзірше тығыл!
Dialogue: 0,0:14:42.96,0:14:45.38,Default,,0,0,0,,Жоқ, жоқ, жоқ~!
Dialogue: 0,0:14:45.46,0:14:46.84,Default,,0,0,0,,Королеваның орынбасары
Dialogue: 0,0:14:47.46,0:14:49.72,Default,,0,0,0,,Тіпті Он бір патшалық тағының мұрагері.
Dialogue: 0,0:14:49.80,0:14:52.64,Default,,0,0,0,,Сіз мені өзіңізбен бірге ала алмайсыз!
Dialogue: 0,0:14:53.51,0:14:55.89,Default,,0,0,0,,Бұл сізді тоқтату үшін болса да
Dialogue: 0,0:14:56.52,0:14:59.77,Default,,0,0,0,,Жақсылап демалыңыз, кішкентай шабақ.
Dialogue: 0,0:14:59.85,0:15:01.69,Default,,0,0,0,,А, әп-сәтте?
Dialogue: 0,0:15:03.40,0:15:04.86,Default,,0,0,0,,Кя!
Dialogue: 0,0:15:04.94,0:15:05.82,Default,,0,0,0,,Сакура!
Dialogue: 0,0:15:05.90,0:15:10.78,Default,,0,0,0,,Зорлық көрсеткен балалар жазаланады.
Dialogue: 0,0:15:10.86,0:15:11.74,Default,,0,0,0,,Ах
Dialogue: 0,0:15:13.20,0:15:15.28,Default,,0,0,0,,Жұмыс орындалды!
Dialogue: 0,0:15:16.87,0:15:17.70,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:17.79,0:15:19.20,Default,,0,0,0,,Мырза!
Dialogue: 0,0:15:19.29,0:15:20.79,Default,,0,0,0,,Сакура!
Dialogue: 0,0:15:20.87,0:15:23.58,Default,,0,0,0,,Сакура!
Dialogue: 0,0:15:28.46,0:15:29.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:32.68,0:15:35.64,Default,,0,0,0,,Мен сені құтқара алар едім.
Dialogue: 0,0:15:35.72,0:15:37.06,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:42.48,0:15:44.48,Default,,0,0,0,,Әлі берілмеңіз
Dialogue: 0,0:15:46.77,0:15:50.11,Default,,0,0,0,,Келесі жолы мен міндетті түрде сәтсіздікке ұшырамаймын!
Dialogue: 0,0:15:59.33,0:16:02.33,Default,,0,0,0,,Қарғыс атсын... Біраз уақыттан кейін арнайы машина аламын.
Dialogue: 0,0:16:02.41,0:16:03.96,Default,,0,0,0,,Ах-кун
Dialogue: 0,0:16:04.04,0:16:08.21,Default,,0,0,0,,Ханшайымды жинап болдық, үйге бірге қайтайық.
Dialogue: 0,0:16:08.30,0:16:11.34,Default,,0,0,0,,Лорд Ноланд, тезірек оралыңыз.
Dialogue: 0,0:16:11.42,0:16:12.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:12.88,0:16:14.97,Default,,0,0,0,,Бірақ менің алдымда түнгі түн
Dialogue: 0,0:16:15.05,0:16:16.64,Default,,0,0,0,,Мен оны жеңемін
Dialogue: 0,0:16:16.72,0:16:18.97,Default,,0,0,0,,Бұл Нанаши тәрізді жалдамалы
Dialogue: 0,0:16:19.06,0:16:20.85,Default,,0,0,0,,Көптеген жауынгерлер қаза тапты.
Dialogue: 0,0:16:20.93,0:16:23.31,Default,,0,0,0,,Оны атып түсірген бойда біз сізге қосыламыз.
Dialogue: 0,0:16:23.39,0:16:26.23,Default,,0,0,0,,Сіз бұрынғыдай ақылдысыз.
Dialogue: 0,0:16:26.94,0:16:29.78,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:31.57,0:16:32.99,Default,,0,0,0,,Орындалу?
Dialogue: 0,0:16:33.07,0:16:35.16,Default,,0,0,0,,Куротоға біраз уақыт болды
Dialogue: 0,0:16:35.24,0:16:36.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.41,0:16:38.87,Default,,0,0,0,,Әкеңнің көмекшісі болып қызмет ет
Dialogue: 0,0:16:38.95,0:16:43.41,Default,,0,0,0,,Әкем тұтқынға түскен соң, мені құтқару үшін көп еңбек етті.
Dialogue: 0,0:16:44.00,0:16:45.83,Default,,0,0,0,,Сізге шын жүректен алғыс айтамын.
Dialogue: 0,0:16:46.42,0:16:47.29,Default,,0,0,0,,Сакуя-сама!
Dialogue: 0,0:16:48.21,0:16:49.96,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:16:50.59,0:16:52.80,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет
Dialogue: 0,0:16:53.59,0:16:55.38,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:16:56.14,0:16:58.30,Default,,0,0,0,,Бұл жолы Жаңа Британиядан
Dialogue: 0,0:16:58.39,0:17:01.85,Default,,0,0,0,,Сакура екеуміз бұл жерді қайтарамыз.
Dialogue: 0,0:17:04.10,0:17:05.31,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:17:08.23,0:17:10.36,Default,,0,0,0,,Бірақ бұл қандай қозғалыс?
Dialogue: 0,0:17:10.94,0:17:13.32,Default,,0,0,0,,Мен сізді біраз уақыт бұрын қоршап алсам да, сіз одан аулақ бола аласыз.
Dialogue: 0,0:17:16.49,0:17:18.91,Default,,0,0,0,,Тек өмірлік маңызды нүктелерді көздеңіз?
Dialogue: 0,0:17:18.99,0:17:20.03,Default,,0,0,0,,Бұл қозғалыс...
Dialogue: 0,0:17:21.16,0:17:22.29,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:17:27.88,0:17:31.71,Default,,0,0,0,,Уууу!
Dialogue: 0,0:17:32.71,0:17:34.63,Default,,0,0,0,,Монобе мырза, менің оқтарым бітті.
Dialogue: 0,0:17:34.72,0:17:36.55,Default,,0,0,0,,Миура Миура өзгерді!
Dialogue: 0,0:17:37.43,0:17:40.22,Default,,0,0,0,,Мұндай стратегия ұзаққа созылмайды.
Dialogue: 0,0:17:40.30,0:17:41.56,Default,,0,0,0,,Сізде әлі раушан бар ма?
Dialogue: 0,0:17:41.64,0:17:43.31,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба? Мононобе
Dialogue: 0,0:17:43.39,0:17:45.73,Default,,0,0,0,,Ха (Ода) Бұл дауыс!
Dialogue: 0,0:17:45.81,0:17:48.73,Default,,0,0,0,,Мен сізді тыңдаймын, Курото мырза.
Dialogue: 0,0:17:48.81,0:17:52.48,Default,,0,0,0,,Жарайды, мен команданы осы жерден аламын.
Dialogue: 0,0:17:53.65,0:17:57.28,Default,,0,0,0,,Альфа маршруты арқылы кездесу нүктесіне барыңыз.
Dialogue: 0,0:17:57.36,0:17:58.36,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:17:59.36,0:18:00.82,Default,,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:18:00.91,0:18:03.79,Default,,0,0,0,,Император Сакуяны қайтарып алу әрекеті сәтсіз аяқталды.
Dialogue: 0,0:18:03.87,0:18:04.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:05.04,0:18:07.92,Default,,0,0,0,,Мен Эйнбергті төмен бағаладым.
Dialogue: 0,0:18:08.46,0:18:09.96,Default,,0,0,0,,Ол жақтағы жағдай қалай?
Dialogue: 0,0:18:10.04,0:18:12.42,Default,,0,0,0,,Аа, жақында бітеді.
Dialogue: 0,0:18:12.50,0:18:14.63,Default,,0,0,0,,Бұл қандай ұшақ?
Dialogue: 0,0:18:18.84,0:18:21.89,Default,,0,0,0,,Оны мінген адам - ​​Эш Феникс.
Dialogue: 0,0:18:21.97,0:18:22.81,Default,,0,0,0,,Жауап!
Dialogue: 0,0:18:26.93,0:18:29.73,Default,,0,0,0,,Бұл тек сенсің, Арнольд.
Dialogue: 0,0:18:29.81,0:18:34.19,Default,,0,0,0,,Қанды қараңғы шабуылдар мен қастандықтарда ғана табысқа жеткен адам.
Dialogue: 0,0:18:34.27,0:18:37.19,Default,,0,0,0,,Мен оның террорист болып аман қалғанына сене алмаймын.
Dialogue: 0,0:18:38.07,0:18:42.32,Default,,0,0,0,,Ағам үшін болса, мен жүре беремін.
Dialogue: 0,0:18:43.03,0:18:44.41,Default,,0,0,0,,Інісі?
Dialogue: 0,0:18:44.99,0:18:48.33,Default,,0,0,0,,Жарайды, өлейін.
Dialogue: 0,0:18:48.41,0:18:51.83,Default,,0,0,0,,Тоқта, сен мені жеңе алмайсың.
Dialogue: 0,0:18:51.92,0:18:54.50,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:19:03.14,0:19:05.10,Default,,0,0,0,,Тәтті, бітті.
Dialogue: 0,0:19:13.81,0:19:15.82,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:19:15.90,0:19:20.65,Default,,0,0,0,,Менің қалқаным жақындағанның бәрін қорғайды.
Dialogue: 0,0:19:20.74,0:19:25.99,Default,,0,0,0,,Сен сияқты қорқақ та бұл қабырғаны бұза алмайды.
Dialogue: 0,0:19:26.08,0:19:28.08,Default,,0,0,0,,Куккук... хаха...
Dialogue: 0,0:19:28.16,0:19:30.29,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:19:30.37,0:19:34.59,Default,,0,0,0,,Оны жасауға бола ма? менің қорқынышты арманым темірдей
Dialogue: 0,0:19:35.67,0:19:36.84,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:37.67,0:19:39.26,Default,,0,0,0,,алынбайтын қабырға
Dialogue: 0,0:19:43.72,0:19:45.55,Default,,0,0,0,,Еніп алайық
Dialogue: 0,0:19:49.52,0:19:50.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:50.43,0:19:51.85,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:19:54.61,0:19:55.73,Default,,0,0,0,,Қылыш!
Dialogue: 0,0:20:01.61,0:20:04.82,Default,,0,0,0,,Не, бұл орбита қалыпты емес пе?
Dialogue: 0,0:20:10.12,0:20:12.46,Default,,0,0,0,,Сіз заттарға тез сенесіз.
Dialogue: 0,0:20:12.54,0:20:14.88,Default,,0,0,0,,Егер сіз өзіңіздің дағдыларыңызға көбірек сенсеңіз
Dialogue: 0,0:20:14.96,0:20:17.29,Default,,0,0,0,,Бұлай болмаған шығар.
Dialogue: 0,0:20:18.71,0:20:21.38,Default,,0,0,0,,Бұл шынымен де соңы!
Dialogue: 0,0:20:21.47,0:20:23.18,Default,,0,0,0,,Гаха!
Dialogue: 0,0:20:24.89,0:20:25.89,Default,,0,0,0,,А...
Dialogue: 0,0:20:27.47,0:20:30.02,Default,,0,0,0,,Мен өлемін бе?
Dialogue: 0,0:20:32.39,0:20:34.94,Default,,0,0,0,,Күлді Феникс
Dialogue: 0,0:20:36.02,0:20:38.44,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:20:55.83,0:20:58.88,Default,,0,0,0,,Курото мырза, сіз ішіп отырсыз ба?
Dialogue: 0,0:20:58.96,0:20:59.96,Default,,0,0,0,,Сіз!
Dialogue: 0,0:21:00.59,0:21:02.97,Default,,0,0,0,,Ауыр сөз айтпа.
Dialogue: 0,0:21:03.05,0:21:04.47,Default,,0,0,0,,Жақсы жұмыс~
Dialogue: 0,0:21:04.55,0:21:07.05,Default,,0,0,0,,Сіздің сөзіңіз ауыр емес пе? (Шинширо) Харука да жақсы жұмыс жасады.
Dialogue: 0,0:21:07.14,0:21:10.14,Default,,0,0,0,,Енді Хоккайдодағы жағдай өзгереді.
Dialogue: 0,0:21:10.22,0:21:12.85,Default,,0,0,0,,Үш Эйнбергті жоғалтты.
Dialogue: 0,0:21:12.93,0:21:14.18,Default,,0,0,0,,Кенсей Куротоның қайта тірілуі
Dialogue: 0,0:21:14.27,0:21:17.15,Default,,0,0,0,,Қарсылық импульсі өседі
Dialogue: 0,0:21:17.23,0:21:20.07,Default,,0,0,0,,Нео Британия дүрбелеңде болуы керек.
Dialogue: 0,0:21:20.15,0:21:22.82,Default,,0,0,0,,Император Сакуяны қайда апарды?
Dialogue: 0,0:21:22.90,0:21:25.07,Default,,0,0,0,,Нео-Британия үкіметінің кеңсесі
Dialogue: 0,0:21:25.15,0:21:27.24,Default,,0,0,0,,Бұл астана және жаудың штабы.
Dialogue: 0,0:21:28.03,0:21:30.24,Default,,0,0,0,,Келесі жолы бұл жолы болмайды.
Dialogue: 0,0:21:31.33,0:21:32.33,Default,,0,0,0,,О
Dialogue: 0,0:21:33.29,0:21:34.50,Default,,0,0,0,,Сәлем, аға.
Dialogue: 0,0:21:36.54,0:21:38.71,Default,,0,0,0,,Сіз үшін маңызды біреу...
Dialogue: 0,0:21:39.92,0:21:41.30,Default,,0,0,0,,Кім?
Dialogue: 0,0:21:43.80,0:21:44.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:52.89,0:21:54.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:55.93,0:21:57.35,Default,,0,0,0,,Міне, келеді!
Dialogue: 0,0:21:58.15,0:21:59.94,Default,,0,0,0,,Бір ғана адам
Dialogue: 0,0:22:01.86,0:22:04.48,Default,,0,0,0,,Бұл сен екенсің, Роза.
Dialogue: 0,0:22:04.57,0:22:07.11,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:22:09.11,0:22:12.78,Default,,0,0,0,,Аздап салқындап барады. Мен бірінші қайтамын.
Dialogue: 0,0:22:12.87,0:22:13.99,Default,,0,0,0,,Иә
Dialogue: 0,0:22:15.58,0:22:18.00,Default,,0,0,0,,Сакураға көмектессең бәрі бітеді.
Dialogue: 0,0:22:19.42,0:22:21.38,Default,,0,0,0,,Барлығы аяқталғанда...
Dialogue: 0,0:22:22.21,0:22:23.84,Default,,0,0,0,,Әкенің жауы
Dialogue: 0,0:22:25.30,0:22:27.01,Default,,0,0,0,,сені өлтіреді
Dialogue: 0,0:22:28.84,0:22:30.51,Default,,0,0,0,,Күлді Феникс
Dialogue: 0,0:22:30.59,0:22:35.60,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.47,0:24:00.48,Default,,0,0,0,,～♪
Dialogue: 0,0:24:01.98,0:24:07.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory