Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.51,0:00:17.39,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:19.01,0:00:21.39,Default,,0,0,0,,Себебін әлі естіген жоқпын.
Dialogue: 0,0:00:21.47,0:00:24.98,Default,,0,0,0,,Біз Geass фрагменттерін іздейміз.
Dialogue: 0,0:00:25.06,0:00:28.57,Default,,0,0,0,,Бірақ неге ол қызға Гиссті бердіңіз?
Dialogue: 0,0:00:29.52,0:00:31.03,Default,,0,0,0,,Бұл қалжың ба?
Dialogue: 0,0:00:31.11,0:00:35.20,Default,,0,0,0,,Әлде ол Кагуя Кагуяның қандас туысы болғандықтан ба?
Dialogue: 0,0:00:35.28,0:00:36.61,Default,,0,0,0,,Саана
Dialogue: 0,0:00:36.70,0:00:38.24,Default,,0,0,0,,Иә
Dialogue: 0,0:00:38.32,0:00:42.25,Default,,0,0,0,,Бірақ сіз енді араласқыңыз келмейді, солай ма?
Dialogue: 0,0:00:42.95,0:00:43.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:44.83,0:00:49.63,Default,,0,0,0,,Өйткені біз әлем ережелерінен тыспыз.
Dialogue: 0,0:00:51.84,0:00:53.38,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:59.05,0:01:04.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:24.89,0:02:28.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:30.52,0:02:32.31,Default,,0,0,0,,Сакуя-саманың анасы——
Dialogue: 0,0:02:32.40,0:02:34.19,Default,,0,0,0,,Шерри мен Британия
Dialogue: 0,0:02:34.27,0:02:38.44,Default,,0,0,0,,Мен 98-ші император Чарльздың бірінші баласымын.
Dialogue: 0,0:02:39.03,0:02:41.74,Default,,0,0,0,,Чарльз таққа отырғанға дейін
Dialogue: 0,0:02:41.82,0:02:43.66,Default,,0,0,0,,Өйткені ол үйленген
Dialogue: 0,0:02:43.74,0:02:46.29,Default,,0,0,0,,Ол император тағына отыру құқығынан бас тартты.
Dialogue: 0,0:02:47.16,0:02:48.66,Default,,0,0,0,,Бірақ осылай
Dialogue: 0,0:02:48.75,0:02:51.75,Default,,0,0,0,,Сакуя-сама – патша әулетінің заңды ұрпағы...
Dialogue: 0,0:02:53.25,0:02:54.29,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:02:54.88,0:02:57.26,Default,,0,0,0,,Сумераги шумераги Сакуя император болса
Dialogue: 0,0:02:57.34,0:03:00.93,Default,,0,0,0,,Біртұтас ұлт үкіметі Кагурая мен қандас туыстарымыз туралы ойлайды.
Dialogue: 0,0:03:01.01,0:03:02.68,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:03:03.47,0:03:07.31,Default,,0,0,0,,Үшінші азат ету операциясы одан да алыс болады.
Dialogue: 0,0:03:07.39,0:03:08.93,Default,,0,0,0,,Командир Корнелия
Dialogue: 0,0:03:09.98,0:03:12.73,Default,,0,0,0,,Қара рыцарьларға оралғаныма үш ай болды.
Dialogue: 0,0:03:12.81,0:03:15.19,Default,,0,0,0,,Мені олай атауға әлі үйренбегенмін.
Dialogue: 0,0:03:15.90,0:03:17.57,Default,,0,0,0,,Мен көңілсіз сезінемін.
Dialogue: 0,0:03:18.44,0:03:21.20,Default,,0,0,0,,Бірінші және екінші азат ету операциялары кезінде
Dialogue: 0,0:03:21.28,0:03:24.03,Default,,0,0,0,,Егер Туду-сан мен бас қолбасшы Корнелия сонда болса
Dialogue: 0,0:03:24.12,0:03:26.33,Default,,0,0,0,,Жеңілу өте оңай
Dialogue: 0,0:03:26.41,0:03:28.41,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:03:28.49,0:03:30.54,Default,,0,0,0,,Ситумпаның қабырғалары берік.
Dialogue: 0,0:03:30.62,0:03:33.37,Default,,0,0,0,,Норланд фон Люнеберг де керемет
Dialogue: 0,0:03:33.46,0:03:35.59,Default,,0,0,0,,Бәрінен бұрын Дамокл бар
Dialogue: 0,0:03:35.67,0:03:38.21,Default,,0,0,0,,Онда Фрейя орнатылған.
Dialogue: 0,0:03:38.71,0:03:41.09,Default,,0,0,0,,Оңай жеңетін қарсылас емес
Dialogue: 0,0:03:42.63,0:03:46.35,Default,,0,0,0,,Әрине, мен мұны істеймін деп жатқандықтан, жеңілуге ниетім жоқ.
Dialogue: 0,0:03:46.93,0:03:51.14,Default,,0,0,0,,Тек растау үшін император болған адам шынымен де Қагемуша, солай емес пе?
Dialogue: 0,0:03:51.23,0:03:52.44,Default,,0,0,0,,Иә
Dialogue: 0,0:03:52.98,0:03:55.27,Default,,0,0,0,,Сакуя-сама өзінің шынайы болмысын жасырады.
Dialogue: 0,0:03:55.36,0:03:58.23,Default,,0,0,0,,Біз Курото Курото ұйымымен бірге жұмыс істейміз.
Dialogue: 0,0:03:58.32,0:04:00.36,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:04:00.44,0:04:02.24,Default,,0,0,0,,Бюджет белгіленді.
Dialogue: 0,0:04:02.32,0:04:05.37,Default,,0,0,0,,Екінші колоннаны дайындаңыз.
Dialogue: 0,0:04:05.45,0:04:06.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:08.58,0:04:10.70,Default,,0,0,0,,Бұл Шерри апаның қаны ма?
Dialogue: 0,0:04:11.41,0:04:14.37,Default,,0,0,0,,Бұл менің жиенімнің немқұрайлылығы.
Dialogue: 0,0:04:19.96,0:04:22.76,Default,,0,0,0,,Кішкентай қыз кенеттен император болды...
Dialogue: 0,0:04:22.84,0:04:25.30,Default,,0,0,0,,Оның үстіне ол он бір жарымда.
Dialogue: 0,0:04:25.39,0:04:26.51,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:26.59,0:04:28.81,Default,,0,0,0,,Бірақ нағыз күш – Ноланд мырза.
Dialogue: 0,0:04:28.89,0:04:30.27,Default,,0,0,0,,Сіз оны әлі де ұстайсыз ба?
Dialogue: 0,0:04:30.35,0:04:32.98,Default,,0,0,0,,Мен түсіндім, сонда сіз сенімді бола аласыз.
Dialogue: 0,0:04:34.02,0:04:37.27,Default,,0,0,0,,Мен қателескен жоқпын, солай ма?
Dialogue: 0,0:04:37.36,0:04:38.36,Default,,0,0,0,,Мырза...
Dialogue: 0,0:04:39.77,0:04:41.73,Default,,0,0,0,,Егер мен император болсам
Dialogue: 0,0:04:42.32,0:04:43.82,Default,,0,0,0,,Жапон халқының игілігі үшін, аз болса да
Dialogue: 0,0:04:43.90,0:04:45.99,Default,,0,0,0,,Саясат мүмкін болуы мүмкін
Dialogue: 0,0:04:46.99,0:04:50.62,Default,,0,0,0,,Мүмкін біз НеоБританияның бағытын аздап болса да өзгерте аламыз.
Dialogue: 0,0:04:50.70,0:04:54.41,Default,,0,0,0,,Нағыз император Сакуя осылай ойлайды деп ойладым...
Dialogue: 0,0:04:54.50,0:04:57.38,Default,,0,0,0,,Менің ойымша, Сакура император болуға келісім берді.
Dialogue: 0,0:04:57.46,0:05:01.71,Default,,0,0,0,,Нақтырақ айтсам, мұны мені Ноланд жасады деп ойлаймын.
Dialogue: 0,0:05:01.80,0:05:03.84,Default,,0,0,0,,Бірақ осылайша
Dialogue: 0,0:05:03.92,0:05:06.88,Default,,0,0,0,,Иә, бұл қиын.
Dialogue: 0,0:05:06.97,0:05:11.64,Default,,0,0,0,,Екінші адам - ​​бейбіт келіссөздер миссиясын мәйіт ретінде қайтарған адам.
Dialogue: 0,0:05:11.72,0:05:14.52,Default,,0,0,0,,Іштен өзгертуге тым көп уақыт кетеді.
Dialogue: 0,0:05:14.60,0:05:17.94,Default,,0,0,0,,Осы уақыт ішінде қанша құрбандық шалылады?
Dialogue: 0,0:05:19.23,0:05:20.73,Default,,0,0,0,,Мен күресемін
Dialogue: 0,0:05:20.82,0:05:23.11,Default,,0,0,0,,Соғыс және оны қайтарыңыз
Dialogue: 0,0:05:23.19,0:05:26.53,Default,,0,0,0,,Бұл жер және Сакура
Dialogue: 0,0:05:27.11,0:05:28.20,Default,,0,0,0,,Иә
Dialogue: 0,0:05:28.87,0:05:30.83,Default,,0,0,0,,Тағы да айтыңыз! иә?
Dialogue: 0,0:05:31.70,0:05:34.62,Default,,0,0,0,,Осы уақытқа дейін Сакуя-саманың қайда екенін білмедім.
Dialogue: 0,0:05:34.70,0:05:36.71,Default,,0,0,0,,Кенеттен шығып, император болу?
Dialogue: 0,0:05:36.79,0:05:39.75,Default,,0,0,0,,Сіз Британдық адам болдыңыз ба?
Dialogue: 0,0:05:39.83,0:05:41.59,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:05:41.67,0:05:45.34,Default,,0,0,0,,Өйткені менің де жарты британдық қаным бар.
Dialogue: 0,0:05:45.42,0:05:47.76,Default,,0,0,0,,Барлығы ұмыта қойған жоқ.
Dialogue: 0,0:05:47.84,0:05:51.80,Default,,0,0,0,,Қиыр Шығыстағы оқиға кезінде Джуго-сама бұл аймақта ешқандай зақым болмағанына көз жеткізді.
Dialogue: 0,0:05:51.89,0:05:53.35,Default,,0,0,0,,Табанды келіссөздер жүргізілді
Dialogue: 0,0:05:53.43,0:05:55.64,Default,,0,0,0,,Британия басқарған кезде
Dialogue: 0,0:05:55.73,0:05:58.39,Default,,0,0,0,,Шерри бірінші болып оны ерекше әкімшілік аймаққа айналдырды.
Dialogue: 0,0:05:58.48,0:06:00.56,Default,,0,0,0,,Жапон халқын қорғады
Dialogue: 0,0:06:00.65,0:06:02.61,Default,,0,0,0,,Олай болса... (Вакуи) Мен уайымдап тұрмын!
Dialogue: 0,0:06:02.69,0:06:04.53,Default,,0,0,0,,Біз шайқаспаймыз ба?
Dialogue: 0,0:06:04.61,0:06:08.07,Default,,0,0,0,,Әлде мен Сакуя-самамен күресуім керек пе?
Dialogue: 0,0:06:08.15,0:06:09.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:09.36,0:06:12.66,Default,,0,0,0,,Айтшы, мен сенен өтінемін.
Dialogue: 0,0:06:17.62,0:06:20.79,Default,,0,0,0,,Бұл рас, менің есімде ештеңе жоқ!
Dialogue: 0,0:06:20.88,0:06:25.05,Default,,0,0,0,,Мен оянсам, ұяшықтың құлпы ашылған.
Dialogue: 0,0:06:25.13,0:06:26.80,Default,,0,0,0,,Тіпті мен түсінбеймін...
Dialogue: 0,0:06:26.88,0:06:29.09,Default,,0,0,0,,Бірақ бақылау камерасынан түсірілген бейнелер
Dialogue: 0,0:06:29.18,0:06:32.97,Default,,0,0,0,,Құлыпты ашу үшін орын қалды.
Dialogue: 0,0:06:33.05,0:06:34.68,Default,,0,0,0,,Оған сеніңіз!
Dialogue: 0,0:06:34.76,0:06:36.97,Default,,0,0,0,,Мен ештеңе істеп жатқан жоқпын
Dialogue: 0,0:06:37.06,0:06:38.89,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:41.40,0:06:44.15,Default,,0,0,0,,Құрметті Кристоф, уақыт таяп қалды.
Dialogue: 0,0:06:44.23,0:06:47.11,Default,,0,0,0,,Жақсы жақсылық мені жайына қалдыр
Dialogue: 0,0:06:47.19,0:06:48.03,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:06:48.11,0:06:49.82,Default,,0,0,0,,Қалдықтарды аулау және т.б.
Dialogue: 0,0:06:49.90,0:06:52.49,Default,,0,0,0,,Мұны Дивок баласына берсін.
Dialogue: 0,0:06:52.57,0:06:55.62,Default,,0,0,0,,Ол шынымен де ұнайтын сияқты.
Dialogue: 0,0:06:57.41,0:06:59.66,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:04.59,0:07:05.42,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:05.50,0:07:07.88,Default,,0,0,0,,Нео Британия қарғыс атсын!
Dialogue: 0,0:07:07.96,0:07:09.09,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:09.17,0:07:10.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:10.09,0:07:12.14,Default,,0,0,0,,Кездесу нүктесіне жеткенше осылай жүре беріңіз!
Dialogue: 0,0:07:12.22,0:07:13.05,Default,,0,0,0,,О!
Dialogue: 0,0:07:22.56,0:07:24.11,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:07:25.86,0:07:29.86,Default,,0,0,0,,Қарсылық бүршіктерін толығымен талқандауды жоспарлап отырмыз ба?
Dialogue: 0,0:07:34.74,0:07:37.74,Default,,0,0,0,,Әй, эй, тез қаш.
Dialogue: 0,0:07:37.83,0:07:40.29,Default,,0,0,0,,Әйтпесе...
Dialogue: 0,0:07:40.37,0:07:42.17,Default,,0,0,0,,Сен мені өлтіресің!
Dialogue: 0,0:07:49.88,0:07:52.18,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол жақта қандай?
Dialogue: 0,0:07:52.26,0:07:55.43,Default,,0,0,0,,Бізде бәрі жақсы, біз тынышпыз.
Dialogue: 0,0:07:55.51,0:07:58.51,Default,,0,0,0,,Бірақ үкіметтің ішінде бұл тәртіпсіздік.
Dialogue: 0,0:07:58.60,0:08:01.73,Default,,0,0,0,,Әскери фракцияның бір уыс адамы
Dialogue: 0,0:08:01.81,0:08:04.02,Default,,0,0,0,,Өйткені ақпаратты соңғы минутқа дейін жасырдым.
Dialogue: 0,0:08:04.10,0:08:06.36,Default,,0,0,0,,Тек онымен күресу хаос тудырады.
Dialogue: 0,0:08:06.44,0:08:08.32,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:08:08.40,0:08:10.40,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:08:10.49,0:08:12.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:12.49,0:08:14.99,Default,,0,0,0,,Біраз абдырап қалған сияқтысың.
Dialogue: 0,0:08:15.07,0:08:16.66,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:08:16.74,0:08:18.12,Default,,0,0,0,,Сіз
Dialogue: 0,0:08:18.20,0:08:19.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.04,0:08:24.42,Default,,0,0,0,,Ал, көзіңді жұм.
Dialogue: 0,0:08:24.50,0:08:25.71,Default,,0,0,0,,Иә
Dialogue: 0,0:08:25.79,0:08:27.04,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:27.13,0:08:29.17,Default,,0,0,0,,Ня~
Dialogue: 0,0:08:33.17,0:08:35.01,Default,,0,0,0,,Роза, уақыт келді.
Dialogue: 0,0:08:35.59,0:08:37.09,Default,,0,0,0,,Кездесу басталғалы жатыр.
Dialogue: 0,0:08:37.18,0:08:38.43,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,0:08:42.64,0:08:45.81,Default,,0,0,0,,Мен өзіме ұнайтын адамды таптым
Dialogue: 0,0:08:47.10,0:08:48.56,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:08:50.94,0:08:52.61,Default,,0,0,0,,Есеп алынды
Dialogue: 0,0:08:53.11,0:08:55.53,Default,,0,0,0,,Солтүстік Қасқыр армиясы және Шығыс таңының Акацуки бригадасы
Dialogue: 0,0:08:55.61,0:08:57.95,Default,,0,0,0,,Оған Жаңа Британия шабуыл жасаған сияқты.
Dialogue: 0,0:08:58.57,0:09:01.70,Default,,0,0,0,,Қарт Ивамото мен Томоми мырза аман-есен қашып кеткен сияқты.
Dialogue: 0,0:09:01.79,0:09:03.70,Default,,0,0,0,,Қалған күш төмендетілді
Dialogue: 0,0:09:03.79,0:09:07.46,Default,,0,0,0,,Сіз осындай жағдайда необританиялық әскермен соғыспақсыз ба?
Dialogue: 0,0:09:07.54,0:09:08.83,Default,,0,0,0,,Сакуя-самамен...
Dialogue: 0,0:09:08.92,0:09:11.55,Default,,0,0,0,,Бұл туралы меннен бір нәрсе.
Dialogue: 0,0:09:12.55,0:09:14.80,Default,,0,0,0,,Жақында Сакуя Сумераги
Dialogue: 0,0:09:14.88,0:09:17.80,Default,,0,0,0,,Абашири лагерінде қамауда отырғаны белгілі болды.
Dialogue: 0,0:09:17.89,0:09:19.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.68,0:09:25.77,Default,,0,0,0,,Курото-сан тұтқынға алынғанда вице-королева болды, солай ма?
Dialogue: 0,0:09:25.85,0:09:27.69,Default,,0,0,0,,Мен қызығып, қарап шықтым.
Dialogue: 0,0:09:27.77,0:09:30.11,Default,,0,0,0,,Қоғамдық жазбалар жоқ
Dialogue: 0,0:09:30.19,0:09:33.53,Default,,0,0,0,,Аполлонның шайқас деректерінде не қалды...
Dialogue: 0,0:09:34.40,0:09:35.24,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:09:35.32,0:09:36.99,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:09:37.07,0:09:39.45,Default,,0,0,0,,Тіпті кейбірінің қалғанына қуаныштымын.
Dialogue: 0,0:09:39.53,0:09:40.41,Default,,0,0,0,,Басқаша айтқанда?
Dialogue: 0,0:09:41.03,0:09:44.25,Default,,0,0,0,,Император Сакуяны Абашири түрмеге қамады.
Dialogue: 0,0:09:44.33,0:09:47.29,Default,,0,0,0,,Белгілі бір себептермен мемлекеттік мекемеге ауыстырылды
Dialogue: 0,0:09:47.37,0:09:50.75,Default,,0,0,0,,Бұрынғы император Чарис де өлтірілді деген күдікке ілінген.
Dialogue: 0,0:09:51.79,0:09:56.55,Default,,0,0,0,,Жүрек жеткіліксіздігі бар дейді, бірақ бұл рас па?
Dialogue: 0,0:09:57.30,0:10:01.10,Default,,0,0,0,,Бұл Чарис Ноландтың қуыршағы екені белгілі әңгіме.
Dialogue: 0,0:10:01.18,0:10:03.93,Default,,0,0,0,,Бұл жолы тек басы ауыстырылды.
Dialogue: 0,0:10:04.02,0:10:06.52,Default,,0,0,0,,Қысқасы, император Сакуя
Dialogue: 0,0:10:06.60,0:10:10.02,Default,,0,0,0,,Оны Ноланд айла-шарғы жасап жатыр деп ойлау орынды.
Dialogue: 0,0:10:10.69,0:10:11.90,Default,,0,0,0,,Қателік жасамаңыз
Dialogue: 0,0:10:11.98,0:10:14.57,Default,,0,0,0,,Жау Сакуя емес, Император.
Dialogue: 0,0:10:14.65,0:10:17.65,Default,,0,0,0,,Ноланд және оның соңынан ерген необританиялық әскер.
Dialogue: 0,0:10:17.74,0:10:20.57,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:10:20.66,0:10:23.33,Default,,0,0,0,,Жау – Ноланд пен НеоБритания!
Dialogue: 0,0:10:23.41,0:10:25.41,Default,,0,0,0,,Осыны айтқанда мен жеңілдеп қаламын.
Dialogue: 0,0:10:25.49,0:10:27.62,Default,,0,0,0,,Мен де! Иә
Dialogue: 0,0:10:27.71,0:10:30.21,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:10:30.29,0:10:32.88,Default,,0,0,0,,Толқынның ортасында бір жақсы жаңалық бар.
Dialogue: 0,0:10:33.79,0:10:36.13,Default,,0,0,0,,Конвойлардың екінші тобы келе жатыр.
Dialogue: 0,0:10:36.21,0:10:38.63,Default,,0,0,0,,О...!
Dialogue: 0,0:11:12.42,0:11:15.17,Default,,0,0,0,,Мәртебеліге берген уәдесін орындамады
Dialogue: 0,0:11:16.05,0:11:18.05,Default,,0,0,0,,Мен оны аяқтай алмаймын.
Dialogue: 0,0:11:18.13,0:11:20.51,Default,,0,0,0,,Мәртебелі бар болғаны 10 жаста еді.
Dialogue: 0,0:11:25.22,0:11:27.31,Default,,0,0,0,,Міне, мұнда
Dialogue: 0,0:11:27.39,0:11:30.81,Default,,0,0,0,,Тезірек, кеме жақында келеді.
Dialogue: 0,0:11:31.44,0:11:34.11,Default,,0,0,0,,Эй, Харука мұнда емес пе?
Dialogue: 0,0:11:34.19,0:11:37.07,Default,,0,0,0,,Біз атуға жаттығатын сияқтымыз.
Dialogue: 0,0:11:37.94,0:11:41.99,Default,,0,0,0,,Атудағы әлсіздігін жеңіп, көбірек үлес қосқысы келеді.
Dialogue: 0,0:11:42.07,0:11:43.99,Default,,0,0,0,,Төбелестен басқа
Dialogue: 0,0:11:44.07,0:11:46.03,Default,,0,0,0,,Мен өз үлесімді қоса аламын.
Dialogue: 0,0:11:46.12,0:11:48.62,Default,,0,0,0,,А... Меніңше, сіз анда-санда ақылға қонымды нәрселерді айтасыз.
Dialogue: 0,0:11:48.70,0:11:50.12,Default,,0,0,0,,Әй, әлгі жігіт!
Dialogue: 0,0:11:50.20,0:11:51.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:51.41,0:11:54.38,Default,,0,0,0,,Сіз ace ұшағын ұшқыңыз келгендіктен жаттығу жасап жатырсыз, солай ма?
Dialogue: 0,0:11:54.46,0:11:58.00,Default,,0,0,0,,Сол Nightmare керемет болды.
Dialogue: 0,0:11:58.09,0:12:01.34,Default,,0,0,0,,Куу~ Жүр!
Dialogue: 0,0:12:01.42,0:12:04.43,Default,,0,0,0,,Түсіндім, жарайды, қолыңнан келгенін істе.
Dialogue: 0,0:12:04.51,0:12:07.85,Default,,0,0,0,,Шынымды айтсам, мен капитан Курото мінгенін қалаймын.
Dialogue: 0,0:12:07.93,0:12:10.68,Default,,0,0,0,,Жапония азат ету майданының соғыс тарихы қандай?
Dialogue: 0,0:12:10.77,0:12:13.77,Default,,0,0,0,,Бұл керемет болған сияқты.
Dialogue: 0,0:12:13.85,0:12:17.98,Default,,0,0,0,,Атап айтқанда, найзаны жақсы ұстайтын басқа ешкім болмады.
Dialogue: 0,0:12:18.07,0:12:20.07,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:12:20.15,0:12:21.19,Default,,0,0,0,,Кеме келе жатыр
Dialogue: 0,0:12:21.28,0:12:23.45,Default,,0,0,0,,Қайда келе жатырсың?
Dialogue: 0,0:12:24.61,0:12:25.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.58,0:12:29.91,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:29.99,0:12:31.50,Default,,0,0,0,,Сүңгуір қайық?
Dialogue: 0,0:12:32.12,0:12:35.88,Default,,0,0,0,,Бұл тасымалдау үшін өзгертілген үлкен сүңгуір қайық.
Dialogue: 0,0:12:35.96,0:12:39.38,Default,,0,0,0,,Тез апармасаң, кешігіп қаласың.
Dialogue: 0,0:12:47.47,0:12:50.22,Default,,0,0,0,,Қара рыцарьлар Хачинохе Хачинохе базалық байланысы
Dialogue: 0,0:12:50.31,0:12:52.27,Default,,0,0,0,,Бұл екінші лейтенант Минато Сакай.
Dialogue: 0,0:12:52.35,0:12:55.60,Default,,0,0,0,,Мен көлік кемесін қорғау үшін еріп жүрдім.
Dialogue: 0,0:12:57.48,0:12:58.31,Default,,0,0,0,,Және
Dialogue: 0,0:12:59.02,0:13:01.40,Default,,0,0,0,,Сондай-ақ осы адамның күзетшісі қызметін атқарыңыз.
Dialogue: 0,0:13:01.48,0:13:05.15,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Нина Эйнштейнмін.
Dialogue: 0,0:13:10.45,0:13:13.50,Default,,0,0,0,,Бұл біздің зертхана әзірлеген ——
Dialogue: 0,0:13:13.58,0:13:16.96,Default,,0,0,0,,Жаңа Freya Eliminator
Dialogue: 0,0:13:17.04,0:13:20.29,Default,,0,0,0,,Бастапқы модель шамамен 19 секундта жарылды.
Dialogue: 0,0:13:20.38,0:13:23.76,Default,,0,0,0,,Бағдарламаға далалық экологиялық деректер енгізілуі керек.
Dialogue: 0,0:13:23.84,0:13:27.13,Default,,0,0,0,,Оны енгізе алсаңыз да, орындау уақыты 0,04 үтір нөл секунд.
Dialogue: 0,0:13:27.22,0:13:30.72,Default,,0,0,0,,Соғыс оқпанын тікелей Фрейяға тигізу керек дейді.
Dialogue: 0,0:13:30.81,0:13:32.60,Default,,0,0,0,,Ауыр жағдайлар болды
Dialogue: 0,0:13:33.27,0:13:37.31,Default,,0,0,0,,Дегенмен, жаңа үлгіде бірінші қосқышты іске қосу кезінде бір уақытта қоссаңыз,
Dialogue: 0,0:13:37.39,0:13:39.86,Default,,0,0,0,,Өріс ортасының деректері автоматты түрде енгізіледі.
Dialogue: 0,0:13:39.94,0:13:41.98,Default,,0,0,0,,Жарылыс кезіндегі 100 метр тиімді диапазон ішінде
Dialogue: 0,0:13:42.07,0:13:43.11,Default,,0,0,0,,Егер Фрея сонда болса
Dialogue: 0,0:13:43.19,0:13:45.32,Default,,0,0,0,,Өшіруге болады
Dialogue: 0,0:13:46.24,0:13:49.24,Default,,0,0,0,,Мен оны осы уақытқа дейін жеңілдете алдым, бірақ...
Dialogue: 0,0:13:49.32,0:13:51.33,Default,,0,0,0,,Жеңілдету…
Dialogue: 0,0:13:51.41,0:13:54.25,Default,,0,0,0,,Фрея да жоғары жылдамдықпен ұшып келеді, солай ма?
Dialogue: 0,0:13:54.33,0:13:57.00,Default,,0,0,0,,Оны қадағалап, 100 метрге жетіңіз.
Dialogue: 0,0:13:57.08,0:13:59.58,Default,,0,0,0,,Менің ойымша, бұл өте қиын тапсырма.
Dialogue: 0,0:13:59.67,0:14:01.09,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:01.17,0:14:03.13,Default,,0,0,0,,Сіз мұны істей аласыз ба? Аға
Dialogue: 0,0:14:03.21,0:14:04.17,Default,,0,0,0,,Кира ісі әлі шешілмей тұр.
Dialogue: 0,0:14:04.88,0:14:07.80,Default,,0,0,0,,Егер траекторияны болжап, нысана нүктесін анықтай алсақ
Dialogue: 0,0:14:07.88,0:14:09.80,Default,,0,0,0,,Сәттілік деңгейі артады
Dialogue: 0,0:14:09.89,0:14:12.56,Default,,0,0,0,,0,04 үтір нөл секундына қарағанда әлдеқайда оңай
Dialogue: 0,0:14:12.64,0:14:15.31,Default,,0,0,0,,Сіз де солай болуыңыз мүмкін.
Dialogue: 0,0:14:15.39,0:14:18.14,Default,,0,0,0,,Фрейяны мен жасадым
Dialogue: 0,0:14:18.73,0:14:23.15,Default,,0,0,0,,Сол кезде мен реакциялардың дәл мен есептегендей шыққанын көргенде ұнайтынмын.
Dialogue: 0,0:14:23.23,0:14:27.07,Default,,0,0,0,,Мен не болатынын білмедім.
Dialogue: 0,0:14:27.78,0:14:32.20,Default,,0,0,0,,Нәтижесінде миллиондаған адамдар қайтыс болды
Dialogue: 0,0:14:32.28,0:14:34.49,Default,,0,0,0,,Мен Фрейяны тоқтатқым келеді!
Dialogue: 0,0:14:35.08,0:14:37.08,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:14:38.08,0:14:39.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:40.25,0:14:43.04,Default,,0,0,0,,Бұл доктор Эйнштейннің бөлмесі.
Dialogue: 0,0:14:43.63,0:14:45.63,Default,,0,0,0,,Сақай мырзамен бір бөлмеде тұру
Dialogue: 0,0:14:45.71,0:14:48.76,Default,,0,0,0,,Өкініштісі, бізде бөлмелер жеткіліксіз.
Dialogue: 0,0:14:48.84,0:14:49.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:50.59,0:14:52.09,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:14:52.18,0:14:53.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.10,0:14:56.52,Default,,0,0,0,,Дәрігердің сөзіне бәрі де әсер еткендей болды.
Dialogue: 0,0:14:56.60,0:14:58.98,Default,,0,0,0,,Сезімі аралас адамдар бар екеніне сенімдімін.
Dialogue: 0,0:14:59.73,0:15:02.48,Default,,0,0,0,,Сіз британдықсыз, солай ма?
Dialogue: 0,0:15:02.56,0:15:05.11,Default,,0,0,0,,Неліктен қарсылыққа көмектесу керек?
Dialogue: 0,0:15:05.19,0:15:07.82,Default,,0,0,0,,Дәрігер не дейді?
Dialogue: 0,0:15:07.90,0:15:11.11,Default,,0,0,0,,Хоккайдоға тәуекелге барған адам
Dialogue: 0,0:15:11.20,0:15:12.78,Default,,0,0,0,,Бірақ иә.
Dialogue: 0,0:15:12.87,0:15:16.58,Default,,0,0,0,,Бұл қарапайым нәрсе, бірақ менің ойымша, бұл мен қорғағым келетін нәрсе болғандықтан.
Dialogue: 0,0:15:17.58,0:15:18.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.96,0:15:21.87,Default,,0,0,0,,Кешіріңіз, доктор.
Dialogue: 0,0:15:21.96,0:15:22.79,Default,,0,0,0,,Раушан
Dialogue: 0,0:15:22.88,0:15:24.34,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:24.42,0:15:26.13,Default,,0,0,0,,Бөлмеден шықпаңыз.
Dialogue: 0,0:15:26.21,0:15:27.96,Default,,0,0,0,,Себебі мен оны қатты ынталандырғым келмейді
Dialogue: 0,0:15:28.05,0:15:30.34,Default,,0,0,0,,Иә, Сақай мырза, өтінемін.
Dialogue: 0,0:15:30.42,0:15:31.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:33.76,0:15:35.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:35.35,0:15:36.81,Default,,0,0,0,,(Сора) Хмм… (Жибрил) Угх… Хехехе…
Dialogue: 0,0:15:36.89,0:15:39.06,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:15:39.14,0:15:41.73,Default,,0,0,0,,Біраз уақыт болды, Курото.
Dialogue: 0,0:15:41.81,0:15:44.06,Default,,0,0,0,,Көптен бері көрмегелі, Ивамото қарт
Dialogue: 0,0:15:44.15,0:15:48.15,Default,,0,0,0,,Балалар бізді не үшін жинағандарыңды білемін.
Dialogue: 0,0:15:48.23,0:15:52.32,Default,,0,0,0,,Солтүстік Қасқыр армиясы мен Шығыс Таң бригадасы қазірдің өзінде өте қиын жағдайда.
Dialogue: 0,0:15:52.40,0:15:55.32,Default,,0,0,0,,Олардың сізді өз бақылауына қоюға тырысатынына сенімдісіз бе?
Dialogue: 0,0:15:55.41,0:15:57.33,Default,,0,0,0,,Олай емес
Dialogue: 0,0:15:57.41,0:15:59.58,Default,,0,0,0,,Британияға қарсы тұратын ұйымдар
Dialogue: 0,0:15:59.66,0:16:03.00,Default,,0,0,0,,Қайталанатын шабуылдарға байланысты тіршілікке қауіп төніп тұр.
Dialogue: 0,0:16:03.08,0:16:04.88,Default,,0,0,0,,Енді бірігетін уақыт
Dialogue: 0,0:16:04.96,0:16:07.50,Default,,0,0,0,,Бірге жұмыс жасайтын уақыт келді деп ойлаймыз.
Dialogue: 0,0:16:07.59,0:16:09.46,Default,,0,0,0,,Ыңғайлы сөздерді қолданыңыз!
Dialogue: 0,0:16:09.55,0:16:11.84,Default,,0,0,0,,Ынтымақтаса алсаңыз
Dialogue: 0,0:16:12.59,0:16:14.09,Default,,0,0,0,,Осы ұшақпен
Dialogue: 0,0:16:14.18,0:16:17.43,Default,,0,0,0,,Қару Біз сізге оқ-дәрі береміз.
Dialogue: 0,0:16:17.51,0:16:19.14,Default,,0,0,0,,О!
Dialogue: 0,0:16:22.39,0:16:24.65,Default,,0,0,0,,Көбінесе бұл көп сандар
Dialogue: 0,0:16:24.73,0:16:27.19,Default,,0,0,0,,Қара рыцарлардан
Dialogue: 0,0:16:27.27,0:16:30.36,Default,,0,0,0,,Біз оны өз жолымызбен әкелдік.
Dialogue: 0,0:16:30.44,0:16:31.57,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:16:31.65,0:16:35.36,Default,,0,0,0,,Мен саған мынаны беремін, сондықтан сен бізге еріңдер.
Dialogue: 0,0:16:35.45,0:16:36.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:36.87,0:16:38.87,Default,,0,0,0,,Егер сізде ондай ниет болмаса да
Dialogue: 0,0:16:38.95,0:16:41.45,Default,,0,0,0,,Өзімді қарыздар сезінсем, ол да солай!
Dialogue: 0,0:16:41.54,0:16:43.91,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:16:44.00,0:16:46.50,Default,,0,0,0,,Мен Томикунмен сөйлестім.
Dialogue: 0,0:16:46.58,0:16:51.17,Default,,0,0,0,,Стратегияны жоспарлау мен команданы үшеумізден тұратын топ орындаймыз.
Dialogue: 0,0:16:51.76,0:16:52.84,Default,,0,0,0,,Коллегиялық жүйе?
Dialogue: 0,0:16:52.92,0:16:55.34,Default,,0,0,0,,Содан кейін төтенше жағдайда жылдамдық
Dialogue: 0,0:16:55.43,0:16:56.97,Default,,0,0,0,,Мен мұны түсінемін
Dialogue: 0,0:16:57.05,0:17:00.81,Default,,0,0,0,,Бұл шарт орындалмаса, ынтымақтастық туралы сөз болмайды.
Dialogue: 0,0:17:02.18,0:17:04.77,Default,,0,0,0,,Өйткені, біз үш күшті бір күшке біріктіруге тырысамыз.
Dialogue: 0,0:17:04.85,0:17:06.15,Default,,0,0,0,,Бұл мүмкін емес емес пе?
Dialogue: 0,0:17:06.23,0:17:07.52,Default,,0,0,0,,Бұл іске араласпа.
Dialogue: 0,0:17:07.60,0:17:09.86,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:17:09.94,0:17:12.28,Default,,0,0,0,,Барлық ересектер...
Dialogue: 0,0:17:12.99,0:17:14.78,Default,,0,0,0,,Балалар сендер ақымақсыңдар ма?
Dialogue: 0,0:17:14.86,0:17:15.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:15.95,0:17:18.32,Default,,0,0,0,,Сәлем! Аузыңды бақ, балам!
Dialogue: 0,0:17:18.41,0:17:22.41,Default,,0,0,0,,Біріншіден, мен британдықтарға сенім артқанымыз ұнамайды.
Dialogue: 0,0:17:22.49,0:17:25.66,Default,,0,0,0,,Жапон халқының ерік-жігері мен мақтанышын ұмыттық па?
Dialogue: 0,0:17:26.25,0:17:28.29,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:17:28.38,0:17:29.79,Default,,0,0,0,,Мен керісінше естимін.
Dialogue: 0,0:17:29.88,0:17:32.00,Default,,0,0,0,,Балалар бүгін мұнда не үшін келдіңдер?
Dialogue: 0,0:17:32.59,0:17:34.51,Default,,0,0,0,,Оны өзіміз де білдік.
Dialogue: 0,0:17:34.59,0:17:37.97,Default,,0,0,0,,Егер біз қазіргідей қалсақ, біз өте кедей боламыз және біздің болашағымыз жоқ.
Dialogue: 0,0:17:38.05,0:17:39.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:39.26,0:17:43.39,Default,,0,0,0,,Дегенмен мен сіздің сезімдеріңізді түсінемін.
Dialogue: 0,0:17:43.47,0:17:44.52,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:17:45.18,0:17:47.39,Default,,0,0,0,,Альянс туралы не деуге болады?
Dialogue: 0,0:17:47.98,0:17:49.52,Default,,0,0,0,,Альянс туралы не деуге болады?
Dialogue: 0,0:17:49.61,0:17:53.19,Default,,0,0,0,,Иә, мұндағы адамдардың бір мақсаты бар.
Dialogue: 0,0:17:53.28,0:17:56.07,Default,,0,0,0,,Жапонияны Жаңа Британиядан қайтарып алу
Dialogue: 0,0:17:56.15,0:17:58.45,Default,,0,0,0,,Осы мақсатта бірігіп жұмыс істейтін одақтас күштер.
Dialogue: 0,0:17:58.53,0:18:01.58,Default,,0,0,0,,Бұйрық тізбегінің біркелкі болмағаны жаман.
Dialogue: 0,0:18:01.66,0:18:03.87,Default,,0,0,0,,Мен Курото мырзадан бас қолбасшы болуды өтінемін.
Dialogue: 0,0:18:03.95,0:18:07.83,Default,,0,0,0,,Бірақ іс жүзінде қарт Ивамото Солтүстік Қасқырлар армиясын басқарды.
Dialogue: 0,0:18:07.92,0:18:10.25,Default,,0,0,0,,Томи-сан Шығыс таң бригадасын басқарды.
Dialogue: 0,0:18:10.33,0:18:12.96,Default,,0,0,0,,Әрқайсысына бір бірлік ретінде пәрмен беріңіз.
Dialogue: 0,0:18:13.05,0:18:16.01,Default,,0,0,0,,Осы арқылы біз Қара рыцарлардан керек-жарақ ала аламыз.
Dialogue: 0,0:18:16.09,0:18:18.68,Default,,0,0,0,,Ұйымның өмір сүруі де сақталады.
Dialogue: 0,0:18:18.76,0:18:20.76,Default,,0,0,0,,Менің ойымша, бұл жаман нәрсе емес пе?
Dialogue: 0,0:18:20.84,0:18:22.05,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:22.14,0:18:23.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:23.72,0:18:25.14,Default,,0,0,0,,қарастырайық
Dialogue: 0,0:18:33.77,0:18:36.19,Default,,0,0,0,,Сіз террористердің қашып кетуіне жол бердіңіз бе?
Dialogue: 0,0:18:36.28,0:18:38.45,Default,,0,0,0,,Ха! кесте бойынша
Dialogue: 0,0:18:38.53,0:18:41.37,Default,,0,0,0,,Жақсы, қалағаныңды істе.
Dialogue: 0,0:18:42.37,0:18:46.83,Default,,0,0,0,,Мен Ноланд мырзаның көңілінен шығатын нәтижелерге сенімді боламын.
Dialogue: 0,0:18:46.91,0:18:48.66,Default,,0,0,0,,Оны көтерейік
Dialogue: 0,0:18:57.97,0:18:59.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:00.80,0:19:02.64,Default,,0,0,0,,Сіз бұл сағатта не істеп жатырсыз?
Dialogue: 0,0:19:02.72,0:19:04.47,Default,,0,0,0,,Ноланд мырзаның хабарламасы
Dialogue: 0,0:19:04.56,0:19:06.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.31,0:19:11.35,Default,,0,0,0,,О
Dialogue: 0,0:19:11.44,0:19:13.27,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.36,0:19:15.52,Default,,0,0,0,,Менің бағаларым онша жақсы емес.
Dialogue: 0,0:19:15.61,0:19:18.90,Default,,0,0,0,,Жабдық пен тактиканы өзгертсеңіз, бірден күшейесіз.
Dialogue: 0,0:19:18.99,0:19:21.78,Default,,0,0,0,,Бұл күтілгеннен көп болуы мүмкін
Dialogue: 0,0:19:21.86,0:19:23.37,Default,,0,0,0,,Роза?
Dialogue: 0,0:19:23.45,0:19:28.20,Default,,0,0,0,,Осы мәселеге қатысты бұрын мен альянсқа ресми түрде кіремін деген жауап алдым.
Dialogue: 0,0:19:28.29,0:19:29.37,Default,,0,0,0,,Түсіңіз.
Dialogue: 0,0:19:29.45,0:19:30.91,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:32.12,0:19:34.21,Default,,0,0,0,,Мен сізден тұрақты қолдау күтемін.
Dialogue: 0,0:19:34.29,0:19:35.88,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:19:38.84,0:19:40.05,Default,,0,0,0,,Егер мен эйс болсам
Dialogue: 0,0:19:40.13,0:19:42.30,Default,,0,0,0,,Тек нұсқауларды орындаңыз.
Dialogue: 0,0:19:42.38,0:19:44.26,Default,,0,0,0,,Мен үйренсем ғой.
Dialogue: 0,0:19:44.34,0:19:45.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.68,0:19:48.06,Default,,0,0,0,,Ace машинасының қарулануы артты, солай ма?
Dialogue: 0,0:19:48.14,0:19:51.14,Default,,0,0,0,,О! Сіз оны жақсы байқадыңыз.
Dialogue: 0,0:19:51.23,0:19:52.06,Default,,0,0,0,,Бұл кошмар...
Dialogue: 0,0:19:52.14,0:19:55.27,Default,,0,0,0,,Мен оны жақын шайқас үшін арнайы әзірледім.
Dialogue: 0,0:19:55.36,0:19:57.69,Default,,0,0,0,,Курото мырзадан сұраңыз.
Dialogue: 0,0:19:58.44,0:19:59.28,Default,,0,0,0,,Харука
Dialogue: 0,0:20:00.57,0:20:02.53,Default,,0,0,0,,Сіз Хотаруки Кейсетсуға мінетін боласыз.
Dialogue: 0,0:20:02.61,0:20:03.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:03.82,0:20:07.37,Default,,0,0,0,,Мен сіздің соғыс тарихыңыз бен деректеріңізді егжей-тегжейлі қарастырдым.
Dialogue: 0,0:20:07.45,0:20:10.62,Default,,0,0,0,,Сабырлы пайымдау және лезде шабуыл сезімі
Dialogue: 0,0:20:11.21,0:20:13.17,Default,,0,0,0,,Менің ағамдай жақсы болмаса да.
Dialogue: 0,0:20:13.25,0:20:15.58,Default,,0,0,0,,Мен қайсысын таңдасам да, бұл өте керемет болды.
Dialogue: 0,0:20:16.42,0:20:20.46,Default,,0,0,0,,Осы уақытқа дейін Акацуки өзінің физикалық мүмкіндіктеріне толық жауап бере алмады.
Dialogue: 0,0:20:20.55,0:20:23.43,Default,,0,0,0,,Өрт сөндірушілер Харуканың қозғалуын жеңілдетеді.
Dialogue: 0,0:20:23.51,0:20:24.93,Default,,0,0,0,,Өйткені ол теңшелген
Dialogue: 0,0:20:25.01,0:20:27.97,Default,,0,0,0,,Ал, бұл жолы мен оны сізге қалдырамын...
Dialogue: 0,0:20:28.06,0:20:29.93,Default,,0,0,0,,Көбірек мұңайған дұрыс.
Dialogue: 0,0:20:30.02,0:20:31.48,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:20:31.56,0:20:33.64,Default,,0,0,0,,О...
Dialogue: 0,0:20:34.31,0:20:35.56,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:20:35.65,0:20:38.07,Default,,0,0,0,,Тіпті Эйнберг жігіттері де жеңілмейді.
Dialogue: 0,0:20:38.86,0:20:42.69,Default,,0,0,0,,Харука-чан, сен «Жеті жарқыраған жұлдыз» Шичико Сейданның эйсесің.
Dialogue: 0,0:20:42.78,0:20:43.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:44.40,0:20:45.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:45.32,0:20:47.74,Default,,0,0,0,,Жарайды... маған қалдырыңыз.
Dialogue: 0,0:20:48.91,0:20:50.41,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:20:50.49,0:20:52.16,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:20:52.25,0:20:53.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:53.16,0:20:55.29,Default,,0,0,0,,Нео Британия туралы қазір жаңалықтарда хабарлануда.
Dialogue: 0,0:20:55.37,0:20:58.42,Default,,0,0,0,,Саппоро геттосындағы жапон халқын жою жоспары.
Dialogue: 0,0:20:58.50,0:20:59.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.05,0:21:03.38,Default,,0,0,0,,Ұзақ уақыт бойы Саппоро геттосы
Dialogue: 0,0:21:03.47,0:21:06.93,Default,,0,0,0,,Көптеген лаңкестердің жасырынып жүргені туралы ақпарат болды.
Dialogue: 0,0:21:07.01,0:21:08.64,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:21:08.72,0:21:10.26,Default,,0,0,0,,Біз Хакодатедеміз
Dialogue: 0,0:21:10.35,0:21:13.64,Default,,0,0,0,,Сонымен бізде Фрейджа бар
Dialogue: 0,0:21:13.73,0:21:17.44,Default,,0,0,0,,Саппоро геттосын толығымен жою
Dialogue: 0,0:21:17.52,0:21:19.98,Default,,0,0,0,,Барлық көлік желілерін әскерилер жауып тастады
Dialogue: 0,0:21:20.07,0:21:23.49,Default,,0,0,0,,Маңайдағы британдықтар дереу эвакуациялануы керек.
Dialogue: 0,0:21:23.57,0:21:25.82,Default,,0,0,0,,Он бір адамға қашуға рұқсат етілмейді!
Dialogue: 0,0:21:26.66,0:21:29.24,Default,,0,0,0,,Шешім 24 сағаттан кейін қабылданады.
Dialogue: 0,0:21:30.24,0:21:31.91,Default,,0,0,0,,24 сағаттан кейін
Dialogue: 0,0:21:31.99,0:21:33.12,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:21:37.17,0:21:38.63,Default,,0,0,0,,Қалқымалы жүйені іске қосу
Dialogue: 0,0:21:39.25,0:21:40.59,Default,,0,0,0,,Құлыптан босатылған
Dialogue: 0,0:21:41.13,0:21:42.17,Default,,0,0,0,,Қақпа ашық
Dialogue: 0,0:21:43.30,0:21:44.72,Default,,0,0,0,,ұшыруға дайындық аяқталды
Dialogue: 0,0:21:45.92,0:21:48.09,Default,,0,0,0,,Дамокл ұшады!
Dialogue: 0,0:22:05.82,0:22:07.11,Default,,0,0,0,,Саппоро геттосын сол күйінде қалдырыңыз.
Dialogue: 0,0:22:07.20,0:22:08.45,Default,,0,0,0,,Сіз мені тастап кетуді жоспарлайсыз ба?
Dialogue: 0,0:22:08.53,0:22:11.83,Default,,0,0,0,,Сол үшін Дамоклмен ұрысып жатырсың ба?
Dialogue: 0,0:22:11.91,0:22:12.95,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:22:13.04,0:22:13.87,Default,,0,0,0,,Ах
Dialogue: 0,0:22:13.95,0:22:16.04,Default,,0,0,0,,Необританияны қалай жеңуге болады
Dialogue: 0,0:22:16.12,0:22:18.92,Default,,0,0,0,,Ақырында Дамоклді жаулап алудан басқа амал қалмады.
Dialogue: 0,0:22:19.00,0:22:21.50,Default,,0,0,0,,Уақыт ертерек келді.
Dialogue: 0,0:22:21.59,0:22:24.71,Default,,0,0,0,,Бізде жаңа Eliminator бар.
Dialogue: 0,0:22:24.80,0:22:26.21,Default,,0,0,0,,Дамокл...
Dialogue: 0,0:22:28.26,0:22:30.14,Default,,0,0,0,,Біз оны тоқтатамыз!
Dialogue: 0,0:22:31.01,0:22:36.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.89,0:24:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory