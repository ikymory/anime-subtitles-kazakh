Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:03.92,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:00:04.00,0:00:05.29,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:00:05.38,0:00:07.67,Default,,0,0,0,,Неліктен Қагемүшаға еліктеу керек?
Dialogue: 0,0:00:09.34,0:00:11.42,Default,,0,0,0,,Натальямен әңгіме...
Dialogue: 0,0:00:11.51,0:00:13.13,Default,,0,0,0,,Бұл Сакуя-сама туралы.
Dialogue: 0,0:00:13.22,0:00:14.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:15.01,0:00:15.93,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:18.30,0:00:20.52,Default,,0,0,0,,Қатал болғаным үшін кешіріңіз.
Dialogue: 0,0:00:21.14,0:00:24.77,Default,,0,0,0,,Бұл Жаратқан Иеге мойынсұну әрекеті.
Dialogue: 0,0:00:25.69,0:00:26.98,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:00:27.48,0:00:29.40,Default,,0,0,0,,Лорд Шерридің сері.
Dialogue: 0,0:00:32.32,0:00:34.07,Default,,0,0,0,,Мен өлгеннен кейін де
Dialogue: 0,0:00:34.15,0:00:37.53,Default,,0,0,0,,Менің жүрегімде адалдық ант.
Dialogue: 0,0:00:37.62,0:00:41.24,Default,,0,0,0,,Сакуя-сама да солай.
Dialogue: 0,0:00:41.33,0:00:44.54,Default,,0,0,0,,Егер сіздің әрекеттеріңіз Сакуя-саманы қорғау болса.
Dialogue: 0,0:00:46.37,0:00:48.84,Default,,0,0,0,,Ынтымақтастыққа дайын
Dialogue: 0,0:00:58.93,0:01:03.43,Default,,0,0,0,,Мен Джуго Сумерагиді өлтірдім...
Dialogue: 0,0:01:04.18,0:01:06.94,Default,,0,0,0,,Сіз император Джугоны өлтірген жоқсыз.
Dialogue: 0,0:01:07.52,0:01:09.65,Default,,0,0,0,,Күлді Феникс...
Dialogue: 0,0:01:09.73,0:01:12.90,Default,,0,0,0,,Мен оның тарихын зерттедім деп ойладым.
Dialogue: 0,0:01:15.15,0:01:16.70,Default,,0,0,0,,Толығырақ ақпарат осында
Dialogue: 0,0:01:16.78,0:01:18.32,Default,,0,0,0,,алу керек
Dialogue: 0,0:01:18.95,0:01:21.41,Default,,0,0,0,,Егер мәселенің ақиқаттығын немесе жалғандығын анықтамайынша
Dialogue: 0,0:01:22.12,0:01:23.75,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:29.25,0:01:31.50,Default,,0,0,0,,Император Сакуя бұйрық береді
Dialogue: 0,0:01:31.59,0:01:34.55,Default,,0,0,0,,Эш Феникс туралы қандай мәліметтерді білесіз?
Dialogue: 0,0:01:34.63,0:01:37.26,Default,,0,0,0,,Маған бәрін толық айтып бер
Dialogue: 0,0:01:39.01,0:01:44.02,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.85,0:03:08.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.73,0:03:12.90,Default,,0,0,0,,Келесі! Мунемори Ода Мунемори жалған шайқас басталады
Dialogue: 0,0:03:12.98,0:03:13.90,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:03:13.98,0:03:15.90,Default,,0,0,0,,Күл, еркін жүріңізші.
Dialogue: 0,0:03:15.98,0:03:17.32,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:19.65,0:03:21.57,Default,,0,0,0,,Екi топқа бөлiнiп, оларды бұрыштаймыз.
Dialogue: 0,0:03:21.65,0:03:22.74,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:23.66,0:03:24.95,Default,,0,0,0,,Мунемори!
Dialogue: 0,0:03:25.03,0:03:27.08,Default,,0,0,0,,Жарайды, маған соққы тиген жоқ.
Dialogue: 0,0:03:27.16,0:03:29.12,Default,,0,0,0,,Жақын орманнан атылды.
Dialogue: 0,0:03:29.20,0:03:30.29,Default,,0,0,0,,Барлығын бірден толтырыңыз
Dialogue: 0,0:03:30.37,0:03:31.62,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:03:31.71,0:03:33.92,Default,,0,0,0,,А, қашықтан ба?
Dialogue: 0,0:03:34.00,0:03:35.71,Default,,0,0,0,,Міне, бұл тұзақ.
Dialogue: 0,0:03:35.79,0:03:37.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:37.88,0:03:39.63,Default,,0,0,0,,Мунемори Ода соқты
Dialogue: 0,0:03:40.26,0:03:42.63,Default,,0,0,0,,Тек жедел ақпаратпен әрекет ету жақсы емес.
Dialogue: 0,0:03:42.72,0:03:45.60,Default,,0,0,0,,Егер жалған шайқас болмаса, екеуі де өліп кетуі мүмкін еді.
Dialogue: 0,0:03:46.93,0:03:47.76,Default,,0,0,0,,Келесі!
Dialogue: 0,0:03:47.85,0:03:49.39,Default,,0,0,0,,Ұйымдастыруыңызды сұраймыз.
Dialogue: 0,0:03:49.47,0:03:50.85,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.48,0:03:54.02,Default,,0,0,0,,Енді осы жылдамдықты ұстаныңыз.
Dialogue: 0,0:03:57.32,0:03:59.48,Default,,0,0,0,,Эш пен оның інісі Николь
Dialogue: 0,0:03:59.57,0:04:01.15,Default,,0,0,0,,Британ империясы кезінде
Dialogue: 0,0:04:01.24,0:04:04.95,Default,,0,0,0,,Мен соғыста ата-анамнан айырылған соғыс жетім едім.
Dialogue: 0,0:04:07.41,0:04:09.95,Default,,0,0,0,,Күл - өте жігерлі бала.
Dialogue: 0,0:04:10.04,0:04:14.04,Default,,0,0,0,,Кіші балаларды үнемі жетектеп жүретін аға болды.
Dialogue: 0,0:04:14.12,0:04:15.17,Default,,0,0,0,,Екінші жағынан, Николь
Dialogue: 0,0:04:15.25,0:04:18.46,Default,,0,0,0,,Мен әлсіз денеммен тудым.
Dialogue: 0,0:04:18.54,0:04:22.55,Default,,0,0,0,,Сол баланың күлкісі маған үнемі қуат беріп тұратын.
Dialogue: 0,0:04:23.05,0:04:26.09,Default,,0,0,0,,Үш жылдан кейін Vogue жүйесін енгізумен
Dialogue: 0,0:04:26.18,0:04:30.10,Default,,0,0,0,,Екеуін лорд Люнеберг қабылдады.
Dialogue: 0,0:04:30.18,0:04:31.47,Default,,0,0,0,,Vogue жүйесі?
Dialogue: 0,0:04:31.56,0:04:33.85,Default,,0,0,0,,Ауқатты топтағы ересектер
Dialogue: 0,0:04:33.94,0:04:38.44,Default,,0,0,0,,Бұл соғыс жетімдерін тәрбиелеуге міндетті болатын уақытша жүйе.
Dialogue: 0,0:04:38.52,0:04:41.03,Default,,0,0,0,,Сонымен мен Ноландқа бардым.
Dialogue: 0,0:04:43.49,0:04:45.61,Default,,0,0,0,,Жарайсыңдар, бәрің жақсысыңдар деп үміттенемін.
Dialogue: 0,0:04:45.70,0:04:46.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:46.61,0:04:48.37,Default,,0,0,0,,Барма!
Dialogue: 0,0:04:48.45,0:04:49.62,Default,,0,0,0,,Мұнда Ruby
Dialogue: 0,0:04:49.70,0:04:50.83,Default,,0,0,0,,Екі адам қиындыққа тап болады...
Dialogue: 0,0:04:50.91,0:04:52.20,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:52.29,0:04:55.92,Default,,0,0,0,,Мен Эш пен Никольмен қоштасқым келмейді!
Dialogue: 0,0:04:56.00,0:04:57.54,Default,,0,0,0,,Бұл қоштасу емес
Dialogue: 0,0:04:57.63,0:04:58.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.92,0:05:02.21,Default,,0,0,0,,Біз бәріміз бір отбасымыз, сондықтан бір-бірімізді қайта көреміз.
Dialogue: 0,0:05:02.30,0:05:03.59,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:04.72,0:05:07.01,Default,,0,0,0,,Мен мұны сізге уәдемнің дәлелі ретінде беремін.
Dialogue: 0,0:05:07.09,0:05:08.26,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:05:09.80,0:05:11.35,Default,,0,0,0,,Уәде…
Dialogue: 0,0:05:11.43,0:05:13.10,Default,,0,0,0,,Мен де уәде беремін
Dialogue: 0,0:05:14.10,0:05:15.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:15.23,0:05:16.60,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:05:20.77,0:05:21.77,Default,,0,0,0,,Люнеберг отбасында
Dialogue: 0,0:05:21.86,0:05:23.65,Default,,0,0,0,,Екі адамның өмірі
Dialogue: 0,0:05:23.74,0:05:26.32,Default,,0,0,0,,Мен оны босаңсытпайды деп естідім.
Dialogue: 0,0:05:27.49,0:05:29.32,Default,,0,0,0,,Бар, Николь.
Dialogue: 0,0:05:29.41,0:05:30.53,Default,,0,0,0,,Иә
Dialogue: 0,0:05:40.25,0:05:41.79,Default,,0,0,0,,Бұл қиын ба? Николь
Dialogue: 0,0:05:42.96,0:05:45.38,Default,,0,0,0,,Егер сіз оны пайдалана алмасаңыз, сізге қажет емес.
Dialogue: 0,0:05:45.47,0:05:48.63,Default,,0,0,0,,Ағасын қалдыр, іні қалды.
Dialogue: 0,0:05:48.72,0:05:49.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:49.72,0:05:50.76,Default,,0,0,0,,О... мен
Dialogue: 0,0:05:50.85,0:05:52.93,Default,,0,0,0,,Николь үшін пайдалы
Dialogue: 0,0:05:53.01,0:05:54.02,Default,,0,0,0,,Мен бәрін істеймін!
Dialogue: 0,0:05:54.10,0:05:56.48,Default,,0,0,0,,Сондықтан маған сенімен бірге тұруға рұқсат етіңіз.
Dialogue: 0,0:05:56.56,0:05:57.73,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:59.10,0:05:59.94,Default,,0,0,0,,(Найзалардың соқтығысқан дыбысы)
Dialogue: 0,0:06:03.40,0:06:04.73,Default,,0,0,0,,бұрышта
Dialogue: 0,0:06:04.82,0:06:06.78,Default,,0,0,0,,Бұл менің жеңісім!
Dialogue: 0,0:06:06.86,0:06:08.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.28,0:06:09.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:09.36,0:06:10.37,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:06:10.45,0:06:11.87,Default,,0,0,0,,Харука соқты.
Dialogue: 0,0:06:12.74,0:06:14.74,Default,,0,0,0,,Сіз шабуылдарыңызда импульсивтісіз.
Dialogue: 0,0:06:14.83,0:06:16.08,Default,,0,0,0,,Тым көп қалдықтар
Dialogue: 0,0:06:16.16,0:06:19.58,Default,,0,0,0,,Ұрыс даласында ең аз уақыт жоғалту да өлімге әкелуі мүмкін.
Dialogue: 0,0:06:20.17,0:06:23.92,Default,,0,0,0,,Ең аз қозғалыспен жауды аяқтау үшін саналы болыңыз.
Dialogue: 0,0:06:24.00,0:06:25.00,Default,,0,0,0,,(пышақ соғу дыбысы)
Dialogue: 0,0:06:25.09,0:06:26.46,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:06:26.55,0:06:29.34,Default,,0,0,0,,Уф! Ха!
Dialogue: 0,0:06:30.01,0:06:30.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:32.14,0:06:33.18,Default,,0,0,0,,А... Аа!
Dialogue: 0,0:06:33.26,0:06:35.01,Default,,0,0,0,,Уау... Куха!
Dialogue: 0,0:06:35.10,0:06:38.35,Default,,0,0,0,,Сіздің қозғалыстарыңыз тым ысырап.
Dialogue: 0,0:06:38.43,0:06:42.94,Default,,0,0,0,,Адам денесінің өмірлік маңызды бөлігіндегі бір кесу сізді өлтіруі мүмкін.
Dialogue: 0,0:06:43.02,0:06:45.69,Default,,0,0,0,,Қарсыласты аз қозғалыспен өлтіріңіз
Dialogue: 0,0:06:45.78,0:06:47.94,Default,,0,0,0,,Енді аяқталды.
Dialogue: 0,0:06:48.53,0:06:50.28,Default,,0,0,0,,Мен неге балаға қарауым керек...
Dialogue: 0,0:06:50.36,0:06:51.20,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:51.28,0:06:52.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.45,0:06:55.49,Default,,0,0,0,,Сонда да... Менің қолымнан келеді.
Dialogue: 0,0:06:55.58,0:06:56.58,Default,,0,0,0,,(сыдырманың көтерілу дыбысы)
Dialogue: 0,0:06:57.16,0:06:58.66,Default,,0,0,0,,Сіз Ноланд мырзасыз.
Dialogue: 0,0:06:58.75,0:07:00.71,Default,,0,0,0,,Бұл менің сүйікті ме, білмеймін
Dialogue: 0,0:07:00.79,0:07:02.50,Default,,0,0,0,,Ұрыс даласында ерлік көрсету
Dialogue: 0,0:07:02.58,0:07:06.05,Default,,0,0,0,,Бұл менмін, Арнольд Ленк.
Dialogue: 0,0:07:06.13,0:07:06.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:10.05,0:07:11.34,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:11.43,0:07:12.30,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:12.39,0:07:15.05,Default,,0,0,0,,Бұл кез келген рыцарьдікіне ұқсамайтын жекпе-жек стилі.
Dialogue: 0,0:07:15.14,0:07:17.60,Default,,0,0,0,,Бұл жеткіліксіз.
Dialogue: 0,0:07:17.68,0:07:19.48,Default,,0,0,0,,Өлтіруші машина ретінде
Dialogue: 0,0:07:20.10,0:07:22.65,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:07:26.02,0:07:28.28,Default,,0,0,0,,Тағы да? Мен енді істей алмаймын...
Dialogue: 0,0:07:28.36,0:07:30.86,Default,,0,0,0,,Мен бір нәрсені дұрыс түсінбеймін бе?
Dialogue: 0,0:07:30.95,0:07:33.24,Default,,0,0,0,,Сіздің таңдауыңыз жоқ.
Dialogue: 0,0:07:33.32,0:07:35.49,Default,,0,0,0,,Жауап беретін бір ғана сөз бар
Dialogue: 0,0:07:36.53,0:07:38.41,Default,,0,0,0,,Тек "Түсінікті"
Dialogue: 0,0:07:41.21,0:07:44.17,Default,,0,0,0,,Егер сіз қиын нәрсеге тап болсаңыз
Dialogue: 0,0:07:44.25,0:07:46.00,Default,,0,0,0,,Өз жүрегіңді өлтір
Dialogue: 0,0:07:47.09,0:07:50.09,Default,,0,0,0,,Сонда сіз ештеңе сезбейсіз
Dialogue: 0,0:07:53.22,0:07:54.55,Default,,0,0,0,,Сол кезде Аш
Dialogue: 0,0:07:54.64,0:07:57.72,Default,,0,0,0,,Лорд Люнебергке ыңғайсыз адамдар
Dialogue: 0,0:07:57.81,0:08:00.31,Default,,0,0,0,,Бірінен соң бірі қастандықпен өлтірілген сияқты.
Dialogue: 0,0:08:01.35,0:08:03.52,Default,,0,0,0,,Аш өзінің жетістіктері үшін танылды.
Dialogue: 0,0:08:03.60,0:08:07.44,Default,,0,0,0,,Әскери қызметте жоғары дәрежеге көтерілді.
Dialogue: 0,0:08:09.73,0:08:10.74,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:08:10.82,0:08:14.03,Default,,0,0,0,,Мен ұзақ уақыттан кейін сізбен бірге болғаныма қуаныштымын.
Dialogue: 0,0:08:14.11,0:08:15.99,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:14.66,0:08:19.49,Default,,0,0,0,,Өткен күні дәрігер менің физикалық күшімнің жақсарғанын айтты...
Dialogue: 0,0:08:16.07,0:08:17.95,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:18.03,0:08:20.12,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:20.20,0:08:22.16,Default,,0,0,0,,Жүрегіңді өлтір... ағайын?
Dialogue: 0,0:08:22.25,0:08:23.46,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:24.29,0:08:26.13,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:26.21,0:08:27.38,Default,,0,0,0,,Жүрегіңді өлтір...
Dialogue: 0,0:08:27.46,0:08:28.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.50,0:08:29.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:29.96,0:08:32.88,Default,,0,0,0,,Тек ағамның көңілін қалдыр.
Dialogue: 0,0:08:33.88,0:08:35.47,Default,,0,0,0,,Жарайды, Николь.
Dialogue: 0,0:08:36.51,0:08:37.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:39.14,0:08:40.01,Default,,0,0,0,,Ноланд мырзадан
Dialogue: 0,0:08:40.10,0:08:40.93,Default,,0,0,0,,Бұл әріп
Dialogue: 0,0:08:42.64,0:08:43.60,Default,,0,0,0,,(Пышақ қағу дыбысы)
Dialogue: 0,0:08:43.68,0:08:44.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:47.77,0:08:48.77,Default,,0,0,0,,Кім?
Dialogue: 0,0:08:48.86,0:08:49.98,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:08:50.07,0:08:50.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:51.07,0:08:51.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:53.03,0:08:54.45,Default,,0,0,0,,Рубин?
Dialogue: 0,0:08:54.53,0:08:55.45,Default,,0,0,0,,Күл…
Dialogue: 0,0:08:56.03,0:08:57.20,Default,,0,0,0,,Аға?
Dialogue: 0,0:08:57.28,0:08:59.62,Default,,0,0,0,,Бітім, мұндай кездесу...
Dialogue: 0,0:08:59.70,0:09:01.12,Default,,0,0,0,,Мен қаламадым
Dialogue: 0,0:09:01.20,0:09:02.62,Default,,0,0,0,,Ха! (мылтық)
Dialogue: 0,0:09:02.70,0:09:04.46,Default,,0,0,0,,Уф... (құлап кеткен дыбыс)
Dialogue: 0,0:09:06.29,0:09:08.00,Default,,0,0,0,,Кешіріңіз Ruby
Dialogue: 0,0:09:08.08,0:09:11.50,Default,,0,0,0,,Бірақ бұл біздің өмір сүруіміз үшін.
Dialogue: 0,0:09:12.21,0:09:14.26,Default,,0,0,0,,Николь Неге...
Dialogue: 0,0:09:14.34,0:09:16.05,Default,,0,0,0,,Әй, мылтық дыбысын естімедің бе?
Dialogue: 0,0:09:16.13,0:09:17.09,Default,,0,0,0,,Аулада
Dialogue: 0,0:09:17.18,0:09:18.55,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:09:25.81,0:09:27.44,Default,,0,0,0,,Оны соққымен орындаңыз
Dialogue: 0,0:09:28.02,0:09:30.06,Default,,0,0,0,,Тазалау қиын болды.
Dialogue: 0,0:09:30.15,0:09:33.15,Default,,0,0,0,,Бұл сәтсіздікке ұқсай ма?
Dialogue: 0,0:09:36.40,0:09:39.87,Default,,0,0,0,,Қате бар деген хабарлама алдым.
Dialogue: 0,0:09:39.95,0:09:42.62,Default,,0,0,0,,Мен ескі танысымды кездестіріп, қате жібердім.
Dialogue: 0,0:09:42.70,0:09:43.79,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:43.87,0:09:47.21,Default,,0,0,0,,Мен жай ғана ағама көмектесіп, оны ұстап қалдым.
Dialogue: 0,0:09:47.29,0:09:50.88,Default,,0,0,0,,Мен араласпағанымда, ағам үлгерер еді.
Dialogue: 0,0:09:50.96,0:09:52.13,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:09:52.71,0:09:55.84,Default,,0,0,0,,Ағам үнемі қамқорлық жасайды.
Dialogue: 0,0:09:55.92,0:09:59.43,Default,,0,0,0,,Ойым мен денем тозса да, шегіне жеттім.
Dialogue: 0,0:09:59.51,0:10:01.14,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:10:01.22,0:10:02.56,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:02.64,0:10:04.27,Default,,0,0,0,,Мен болмасам, ағам...
Dialogue: 0,0:10:04.35,0:10:06.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:07.98,0:10:10.40,Default,,0,0,0,,Тілегіңді орындаймын
Dialogue: 0,0:10:11.65,0:10:13.65,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:10:16.99,0:10:18.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:18.57,0:10:21.12,Default,,0,0,0,,Бұл аздап артық емес пе?
Dialogue: 0,0:10:21.20,0:10:22.74,Default,,0,0,0,,Басынан керексіз бала.
Dialogue: 0,0:10:23.66,0:10:26.12,Default,,0,0,0,,Оны қалдырудың пайдасы жоқ.
Dialogue: 0,0:10:24.16,0:10:26.12,Default,,0,0,0,,өлтіру
Dialogue: 0,0:10:26.20,0:10:27.58,Default,,0,0,0,,өлтіру
Dialogue: 0,0:10:27.66,0:10:29.08,Default,,0,0,0,,Өлтір, өлтір...
Dialogue: 0,0:10:30.92,0:10:32.50,Default,,0,0,0,,Уф... тоқтат.
Dialogue: 0,0:10:32.59,0:10:34.42,Default,,0,0,0,,Тек көп денелер болады. Өлтір, өлтір...
Dialogue: 0,0:10:34.50,0:10:38.67,Default,,0,0,0,,Иесімнің атынан осы уақытқа дейін көрсеткен мейірімділігіңіз үшін алғысымды білдіремін.
Dialogue: 0,0:10:38.76,0:10:40.47,Default,,0,0,0,,Аштың жазасы туралы ...
Dialogue: 0,0:10:41.18,0:10:42.89,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:10:42.97,0:10:45.89,Default,,0,0,0,,Ко... Los...
Dialogue: 0,0:10:54.48,0:10:55.98,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:10:56.07,0:10:58.65,Default,,0,0,0,,Сөйлесетін адам келді.
Dialogue: 0,0:10:58.74,0:11:00.45,Default,,0,0,0,,Өте жас!
Dialogue: 0,0:11:00.53,0:11:04.03,Default,,0,0,0,,Сенің мұнда қамалғаның көп ақша ұрлағаныңды білдіре ме?
Dialogue: 0,0:11:04.12,0:11:06.79,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:11:06.87,0:11:09.87,Default,,0,0,0,,Менің атым Ко Джуго
Dialogue: 0,0:11:09.96,0:11:11.29,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:11:16.00,0:11:17.84,Default,,0,0,0,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:11:17.92,0:11:21.13,Default,,0,0,0,,Жұмысымды көбейтпе дедім ғой!
Dialogue: 0,0:11:21.22,0:11:24.39,Default,,0,0,0,,Ттттттттттттттттттттт... қазірдің өзінде!
Dialogue: 0,0:11:24.47,0:11:25.72,Default,,0,0,0,,Иә
Dialogue: 0,0:11:26.31,0:11:27.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:29.89,0:11:32.40,Default,,0,0,0,,Сіз мені тағы да ашуландырған сияқтысыз.
Dialogue: 0,0:11:32.48,0:11:33.48,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.56,0:11:36.61,Default,,0,0,0,,Сіз Сакуя-саманың әкесісіз.
Dialogue: 0,0:11:36.69,0:11:39.74,Default,,0,0,0,,Джуго-самаға ұқсамасаң, бәлеге қаласың.
Dialogue: 0,0:11:39.82,0:11:44.24,Default,,0,0,0,,Жай безендіру емес, император сияқты әрекет етуді жалғастырыңыз.
Dialogue: 0,0:11:44.32,0:11:48.24,Default,,0,0,0,,Бұл Сакуя-саманы қорғауға әкеледі.
Dialogue: 0,0:11:48.33,0:11:49.37,Default,,0,0,0,,Иә
Dialogue: 0,0:11:51.16,0:11:52.12,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:52.21,0:11:55.79,Default,,0,0,0,,Қараңғы жұмыс орнындағы гүлдерге сүйсініңіз
Dialogue: 0,0:11:55.88,0:11:57.84,Default,,0,0,0,,Бұл жақсы хобби.
Dialogue: 0,0:11:57.92,0:11:59.26,Default,,0,0,0,,Не?
Dialogue: 0,0:11:59.34,0:12:02.34,Default,,0,0,0,,Сіз Эш-баланың қайда бара жатқанын білесіз бе?
Dialogue: 0,0:12:02.43,0:12:04.64,Default,,0,0,0,,Неліктен өзіңіз анықтамасқа?
Dialogue: 0,0:12:05.18,0:12:09.39,Default,,0,0,0,,Негізі қазір қуып жүрген адамға қатысты сияқты.
Dialogue: 0,0:12:09.47,0:12:15.10,Default,,0,0,0,,Менің ойымша, жас ханым мен Эш бала бір мекемеден.
Dialogue: 0,0:12:15.19,0:12:16.31,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:12:16.40,0:12:17.44,Default,,0,0,0,,Мен мұны істегім келмейді, бірақ
Dialogue: 0,0:12:17.52,0:12:19.57,Default,,0,0,0,,Аздап өрескел түрде
Dialogue: 0,0:12:19.65,0:12:22.07,Default,,0,0,0,,Менің ойымша, мен оны қарап шығуым керек...
Dialogue: 0,0:12:22.15,0:12:23.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.70,0:12:27.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:27.95,0:12:31.62,Default,,0,0,0,,Жапон тағамдарын жеуге жарамайсыз ба?
Dialogue: 0,0:12:32.29,0:12:33.29,Default,,0,0,0,,Күзетші
Dialogue: 0,0:12:33.37,0:12:36.25,Default,,0,0,0,,10 күннен бері тамақ ішкен жоқ.
Dialogue: 0,0:12:36.33,0:12:39.25,Default,,0,0,0,,Сіз мені ойлап жапондық тағамға ауыстыңыз.
Dialogue: 0,0:12:39.34,0:12:41.67,Default,,0,0,0,,Батыс тағамдарына қайта ораласыз ба?
Dialogue: 0,0:12:41.76,0:12:44.18,Default,,0,0,0,,Ха! Мен оны жоғарыдан көбейтуге тырысамын
Dialogue: 0,0:12:44.26,0:12:47.18,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:12:48.30,0:12:51.14,Default,,0,0,0,,Күніне бір мезгіл сорпамен күн көре алмайсың.
Dialogue: 0,0:12:51.22,0:12:52.93,Default,,0,0,0,,Маған қара
Dialogue: 0,0:12:53.02,0:12:56.10,Default,,0,0,0,,Бұл жағдайда да тәбетім төмендемейді.
Dialogue: 0,0:12:56.19,0:13:00.07,Default,,0,0,0,,Мүмкін, жаттығудың аздығынан, менің түрмеге түскеннен гөрі салмағым ауыр.
Dialogue: 0,0:13:00.15,0:13:02.61,Default,,0,0,0,,Жас кезімде сендей сымбатты едім.
Dialogue: 0,0:13:02.69,0:13:06.57,Default,,0,0,0,,«Әкем бір кездері салқын еді» деп шағымданады қызым.
Dialogue: 0,0:13:06.66,0:13:09.74,Default,,0,0,0,,Хе... Кейде сізге ұнайтын нәрсе бар ма?
Dialogue: 0,0:13:09.83,0:13:10.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:10.74,0:13:12.12,Default,,0,0,0,,Нико…
Dialogue: 0,0:13:15.50,0:13:17.42,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:13:17.50,0:13:21.92,Default,,0,0,0,,Күзетші, кофе дайындаңыз.
Dialogue: 0,0:13:22.00,0:13:25.59,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:27.30,0:13:29.60,Default,,0,0,0,,Сіздің орындауыңыз расталды.
Dialogue: 0,0:13:29.68,0:13:32.60,Default,,0,0,0,,Толық күндер кейінірек хабарланады.
Dialogue: 0,0:13:34.31,0:13:35.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:35.56,0:13:38.10,Default,,0,0,0,,Бізге өлім жазасы болмайтынын айтты.
Dialogue: 0,0:13:38.19,0:13:39.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:39.15,0:13:44.44,Default,,0,0,0,,Мен жоғалып кетсем, таққа әлі жас Чарис отырады.
Dialogue: 0,0:13:44.53,0:13:46.40,Default,,0,0,0,,Бұл Ноланд туралы.
Dialogue: 0,0:13:46.49,0:13:47.74,Default,,0,0,0,,Артынан жүріңіз.
Dialogue: 0,0:13:47.82,0:13:50.37,Default,,0,0,0,,Менің ойымша, олар қуыршақты жағымсыз күйге айналдырғысы келеді.
Dialogue: 0,0:13:50.45,0:13:51.49,Default,,0,0,0,,Сен
Dialogue: 0,0:13:51.58,0:13:54.37,Default,,0,0,0,,Мұндай жерде ешкім өлмеуі керек.
Dialogue: 0,0:13:54.45,0:13:55.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:55.83,0:13:59.96,Default,,0,0,0,,Бірақ орындау күші жойылмайды.
Dialogue: 0,0:14:00.04,0:14:02.63,Default,,0,0,0,,Мен өлуден қорықпаймын, бірақ
Dialogue: 0,0:14:02.71,0:14:06.84,Default,,0,0,0,,Сүйген қызымды енді көрмеймін деген ойдың өзі ауырады.
Dialogue: 0,0:14:07.97,0:14:09.47,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:14:10.05,0:14:12.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:12.30,0:14:14.14,Default,,0,0,0,,Мен жылауымды тоқтата алмаймын
Dialogue: 0,0:14:14.81,0:14:17.06,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:14:17.14,0:14:18.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.35,0:14:21.19,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:14:22.82,0:14:24.23,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:14:24.94,0:14:26.44,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:27.24,0:14:29.82,Default,,0,0,0,,Маған хабарлай аласыз ба?
Dialogue: 0,0:14:29.91,0:14:31.45,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:14:31.53,0:14:32.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.08,0:14:35.83,Default,,0,0,0,,Содан кейін Күл
Dialogue: 0,0:14:35.91,0:14:39.00,Default,,0,0,0,,Мен өзім туралы айта бастадым.
Dialogue: 0,0:14:39.08,0:14:43.25,Default,,0,0,0,,Сіз дәл қазір эмоционалды қолдауды жоғалттыңыз.
Dialogue: 0,0:14:43.34,0:14:46.67,Default,,0,0,0,,Содан кейін қайтадан өзіңізге ұнайтын нәрсені табыңыз.
Dialogue: 0,0:14:47.80,0:14:48.92,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:14:49.01,0:14:50.34,Default,,0,0,0,,О
Dialogue: 0,0:14:50.43,0:14:53.68,Default,,0,0,0,,Ол сізге күш беруі керек.
Dialogue: 0,0:14:54.93,0:14:56.43,Default,,0,0,0,,Мен оны таба аламын ба деп ойлаймын...
Dialogue: 0,0:14:57.02,0:14:58.56,Default,,0,0,0,,Маған ұнайтын нәрсе
Dialogue: 0,0:14:59.64,0:15:01.81,Default,,0,0,0,,А, мен оны табамын.
Dialogue: 0,0:15:02.40,0:15:03.69,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:15:06.28,0:15:08.82,Default,,0,0,0,,Сол Джуго-сан
Dialogue: 0,0:15:08.90,0:15:11.16,Default,,0,0,0,,Сізге не ұнамайды?
Dialogue: 0,0:15:11.24,0:15:12.41,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:12.49,0:15:15.87,Default,,0,0,0,,Сізге не ұнамайды...?
Dialogue: 0,0:15:15.95,0:15:16.79,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:15:16.87,0:15:19.29,Default,,0,0,0,,Дегенмен, сізге ұнайтын нәрселердің рейтингі бар.
Dialogue: 0,0:15:19.37,0:15:21.92,Default,,0,0,0,,Қазіргі нөмірі бірінші қызым Сақуя.
Dialogue: 0,0:15:22.00,0:15:23.42,Default,,0,0,0,,Ең төменгі дәреже –...
Dialogue: 0,0:15:23.50,0:15:25.00,Default,,0,0,0,,Мүмкін Ноланд
Dialogue: 0,0:15:25.09,0:15:28.67,Default,,0,0,0,,Ой, жаман сөз айтсаң, сөйлеміңді тездетеді.
Dialogue: 0,0:15:28.76,0:15:31.01,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:15:31.09,0:15:34.22,Default,,0,0,0,,Егер асырап алушы Норланд болмаса.
Dialogue: 0,0:15:34.30,0:15:35.55,Default,,0,0,0,,Егер сіз болсаңыз, мен сенімдімін...
Dialogue: 0,0:15:35.64,0:15:38.39,Default,,0,0,0,,А, онда сіз мұны қазір жасай аласыз.
Dialogue: 0,0:15:38.47,0:15:39.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.39,0:15:43.06,Default,,0,0,0,,Менің қызымды алсаң, менің ұлым боласың.
Dialogue: 0,0:15:43.15,0:15:44.56,Default,,0,0,0,,Иә! (Джумару) Жоқ...
Dialogue: 0,0:15:44.65,0:15:45.90,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:15:45.98,0:15:47.48,Default,,0,0,0,,Мен бұрынғы мәлімдемемнен бас тартамын!
Dialogue: 0,0:15:47.57,0:15:49.19,Default,,0,0,0,,Сакуя тұрмысқа шықпайды!
Dialogue: 0,0:15:49.28,0:15:50.90,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:15:49.28,0:15:52.24,Default,,0,0,0,,Көзім қара болса, мен мұны ешқашан істемеймін.
Dialogue: 0,0:15:50.99,0:15:52.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:52.32,0:15:54.03,Default,,0,0,0,,Иә
Dialogue: 0,0:15:52.82,0:15:55.12,Default,,0,0,0,,Джугоның қызы сүйкімді ме?
Dialogue: 0,0:15:55.20,0:15:58.49,Default,,0,0,0,,Ал, несі сүйкімді? Не сүйкімді емес?
Dialogue: 0,0:15:58.58,0:16:00.45,Default,,0,0,0,,Бұл сөзсіз сүйкімді.
Dialogue: 0,0:16:00.54,0:16:02.00,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:16:02.08,0:16:04.25,Default,,0,0,0,,Менің қызым үшін алаңдайсың ба?
Dialogue: 0,0:16:04.33,0:16:05.71,Default,,0,0,0,,А, жоқ, солай...
Dialogue: 0,0:16:05.79,0:16:06.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:06.71,0:16:07.80,Default,,0,0,0,,Иә
Dialogue: 0,0:16:06.71,0:16:09.38,Default,,0,0,0,,Көздерің қара болса, бұл...
Dialogue: 0,0:16:09.96,0:16:11.17,Default,,0,0,0,,Джуго мырза
Dialogue: 0,0:16:11.26,0:16:14.76,Default,,0,0,0,,Сіздің өліміңіз ертең орындалады.
Dialogue: 0,0:16:14.84,0:16:16.60,Default,,0,0,0,,Кенеттен...
Dialogue: 0,0:16:16.68,0:16:18.26,Default,,0,0,0,,Лорд Джугоны қайтарып алуды мақсат ету
Dialogue: 0,0:16:18.35,0:16:21.06,Default,,0,0,0,,Куро Курото мен Кенсей Кенсей бастаған лаңкестер бір мезгілде көтеріліс жасайды.
Dialogue: 0,0:16:21.14,0:16:24.10,Default,,0,0,0,,Жауапкершілік Шигемори мырзаға жүктеледі.
Dialogue: 0,0:16:24.19,0:16:27.02,Default,,0,0,0,,Қарсыласу күштерін көрсете білді.
Dialogue: 0,0:16:27.11,0:16:29.73,Default,,0,0,0,,Сонда мен таусылдым ба?
Dialogue: 0,0:16:29.82,0:16:32.99,Default,,0,0,0,,Сіз менің әйелім мен қызымды құтқардыңыз.
Dialogue: 0,0:16:33.07,0:16:35.28,Default,,0,0,0,,Ол қайырымды адамның өліп кетуі мүмкін емес.
Dialogue: 0,0:16:34.07,0:16:35.28,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:16:35.86,0:16:37.37,Default,,0,0,0,,Егер мен қашып кетсем
Dialogue: 0,0:16:37.45,0:16:40.66,Default,,0,0,0,,Бұл Neo Britannia-мен үйкеліс тудырады.
Dialogue: 0,0:16:40.74,0:16:43.75,Default,,0,0,0,,Жапон халқына қарсы бұдан әрі қысым күшеюі мүмкін.
Dialogue: 0,0:16:43.83,0:16:45.04,Default,,0,0,0,,Қызымызды не істейміз?
Dialogue: 0,0:16:45.12,0:16:46.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:46.08,0:16:49.92,Default,,0,0,0,,Өлсең қызыңды жем болады.
Dialogue: 0,0:16:50.00,0:16:52.51,Default,,0,0,0,,Әйтеуір мен саған және қызыңа көмектесемін.
Dialogue: 0,0:16:52.59,0:16:54.38,Default,,0,0,0,,Маған сеніңіз!
Dialogue: 0,0:16:54.47,0:16:55.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:57.22,0:16:59.01,Default,,0,0,0,,Олай болса мен саған қалдырамын.
Dialogue: 0,0:16:59.10,0:17:00.97,Default,,0,0,0,,Бұл өмір
Dialogue: 0,0:17:05.06,0:17:07.40,Default,,0,0,0,,Маған қайтадан тексеруге рұқсат етіңіз.
Dialogue: 0,0:17:07.48,0:17:10.52,Default,,0,0,0,,Ол қызымды шынымен қорғайды.
Dialogue: 0,0:17:10.61,0:17:13.57,Default,,0,0,0,,Мен ешқашан уәдемді бұзған емеспін.
Dialogue: 0,0:17:13.65,0:17:16.66,Default,,0,0,0,,Мемлекеттік мекемелердің айналасындағы адамдар үйқамақта деп естідім.
Dialogue: 0,0:17:16.74,0:17:18.49,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:18.57,0:17:21.66,Default,,0,0,0,,Бұл бала император Сакуя.
Dialogue: 0,0:17:25.41,0:17:26.42,Default,,0,0,0,,алдында
Dialogue: 0,0:17:26.50,0:17:27.42,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:28.08,0:17:29.25,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:17:29.33,0:17:31.21,Default,,0,0,0,,Ноланд мырза күткендей
Dialogue: 0,0:17:31.30,0:17:34.92,Default,,0,0,0,,Орындау орындалса әрекет болады деп оқыдым.
Dialogue: 0,0:17:36.38,0:17:37.22,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:37.30,0:17:39.85,Default,,0,0,0,,Ара ұясы болып, шығуға бет алыңыз.
Dialogue: 0,0:17:39.93,0:17:40.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:40.93,0:17:42.01,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:43.02,0:17:44.85,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:17:44.93,0:17:45.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.85,0:17:47.35,Default,,0,0,0,,Император Джуго!
Dialogue: 0,0:17:47.44,0:17:52.11,Default,,0,0,0,,Ноланд мырза қашып кеткен жағдайда сізді атып өлтіруді бұйырды.
Dialogue: 0,0:17:52.19,0:17:53.53,Default,,0,0,0,,Міне, басталды — басымызбен…
Dialogue: 0,0:17:53.61,0:17:56.74,Default,,0,0,0,,Жоқ, мен қашып құтыла алмаймын.
Dialogue: 0,0:17:56.82,0:17:58.24,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:58.32,0:18:01.62,Default,,0,0,0,,Маған сенің аман қалуың керек.
Dialogue: 0,0:18:01.70,0:18:03.74,Default,,0,0,0,,Ха... Сізде әу бастан осындай ниет бар еді...
Dialogue: 0,0:18:03.83,0:18:06.62,Default,,0,0,0,,Сіз ешқашан уәдеңізді бұзбағаныңызды айттыңыз.
Dialogue: 0,0:18:06.71,0:18:09.12,Default,,0,0,0,,Олай болса сол уәдені орында.
Dialogue: 0,0:18:10.08,0:18:11.09,Default,,0,0,0,,Go Ash.
Dialogue: 0,0:18:11.75,0:18:14.34,Default,,0,0,0,,Барып қызымды қорға!
Dialogue: 0,0:18:15.96,0:18:17.88,Default,,0,0,0,,Екінші нысанды құлыптау
Dialogue: 0,0:18:18.88,0:18:20.14,Default,,0,0,0,,Ату (мылтық)
Dialogue: 0,0:18:24.39,0:18:25.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:26.52,0:18:28.27,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:18:29.94,0:18:33.90,Default,,0,0,0,,Сен ертең өлім жазасына кесіледі, сондықтан ерте өлгің келе ме?
Dialogue: 0,0:18:33.98,0:18:35.98,Default,,0,0,0,,Көп уақыт алғаным үшін кешіріңіз.
Dialogue: 0,0:18:36.57,0:18:38.61,Default,,0,0,0,,1-ші мақсатты құлыптау
Dialogue: 0,0:18:39.45,0:18:40.36,Default,,0,0,0,,Түсіру
Dialogue: 0,0:18:40.45,0:18:43.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:43.78,0:18:46.66,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:18:46.75,0:18:47.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:47.66,0:18:50.29,Default,,0,0,0,,Ол дворян үшін қатал.
Dialogue: 0,0:18:50.83,0:18:53.54,Default,,0,0,0,,Осындай кезде ол қарғысқа айналады.
Dialogue: 0,0:18:54.92,0:18:57.63,Default,,0,0,0,,Маған оңай өлуге рұқсат бере аласыз ба...
Dialogue: 0,0:18:58.42,0:18:59.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:03.89,0:19:05.93,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:19:06.01,0:19:09.43,Default,,0,0,0,,Баланы лақтыруға бұйрық берілді.
Dialogue: 0,0:19:10.06,0:19:12.81,Default,,0,0,0,,Жауапкершілік болмайды.
Dialogue: 0,0:19:17.36,0:19:18.78,Default,,0,0,0,,Неге...
Dialogue: 0,0:19:19.82,0:19:21.36,Default,,0,0,0,,Неге...
Dialogue: 0,0:19:24.12,0:19:25.41,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:19:27.95,0:19:29.41,Default,,0,0,0,,Джуго-сама
Dialogue: 0,0:19:29.50,0:19:33.17,Default,,0,0,0,,Ол күлді құтқару үшін құрбан болды.
Dialogue: 0,0:19:34.33,0:19:35.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:36.04,0:19:37.92,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:19:39.09,0:19:40.47,Default,,0,0,0,,Ол жақын жерде құлады ма?
Dialogue: 0,0:19:40.55,0:19:41.38,Default,,0,0,0,,Ах
Dialogue: 0,0:19:41.47,0:19:43.14,Default,,0,0,0,,Күл!
Dialogue: 0,0:19:43.22,0:19:46.39,Default,,0,0,0,,Суланба, ішке кір.
Dialogue: 0,0:19:49.02,0:19:49.98,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:19:50.56,0:19:52.44,Default,,0,0,0,,Мұның бәрі жаман.
Dialogue: 0,0:19:54.40,0:19:56.61,Default,,0,0,0,,Мен өлуім керек еді
Dialogue: 0,0:19:57.52,0:19:58.78,Default,,0,0,0,,Күл?
Dialogue: 0,0:20:02.70,0:20:03.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:04.45,0:20:06.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:06.91,0:20:08.16,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:20:09.24,0:20:11.41,Default,,0,0,0,,Император Джуго
Dialogue: 0,0:20:11.50,0:20:13.33,Default,,0,0,0,,Өлтірілді!
Dialogue: 0,0:20:16.59,0:20:17.88,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:18.46,0:20:20.84,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:20:22.72,0:20:24.72,Default,,0,0,0,,Ол адамның асылы...
Dialogue: 0,0:20:26.85,0:20:28.68,Default,,0,0,0,,Менің інімнің орнына
Dialogue: 0,0:20:30.10,0:20:31.56,Default,,0,0,0,,Қолдану...
Dialogue: 0,0:20:40.44,0:20:41.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:41.36,0:20:42.99,Default,,0,0,0,,Сіз... аа
Dialogue: 0,0:20:46.66,0:20:48.49,Default,,0,0,0,,Император Сакуя бұйрық береді
Dialogue: 0,0:20:49.24,0:20:51.70,Default,,0,0,0,,«Сіздің ең маңызды адамыңыз ретінде»
Dialogue: 0,0:20:52.29,0:20:54.12,Default,,0,0,0,,Мені қорға!
Dialogue: 0,0:21:02.13,0:21:05.22,Default,,0,0,0,,Геастың қажеті жоқ еді.
Dialogue: 0,0:21:06.01,0:21:08.89,Default,,0,0,0,,Күл мені қорғамақ болды.
Dialogue: 0,0:21:10.68,0:21:12.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:12.52,0:21:14.89,Default,,0,0,0,,Мен өзімді енді раушан деп айта алмаймын.
Dialogue: 0,0:21:15.56,0:21:17.48,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:21:17.56,0:21:20.44,Default,,0,0,0,,Егер сіз қозғалысты бақылап, оған қарсы тұрсаңыз, джекпотқа қол жеткізесіз.
Dialogue: 0,0:21:20.52,0:21:22.44,Default,,0,0,0,,Ой, ысырап, ысырап
Dialogue: 0,0:21:22.53,0:21:24.95,Default,,0,0,0,,Геасқа қарсылық көрсетілді.
Dialogue: 0,0:21:25.03,0:21:26.11,Default,,0,0,0,,Ha
Dialogue: 0,0:21:26.20,0:21:27.11,Default,,0,0,0,,Қыз бала…
Dialogue: 0,0:21:27.86,0:21:31.03,Default,,0,0,0,,Сіз қалада Геассты абайсызда пайдаландыңыз.
Dialogue: 0,0:21:31.95,0:21:34.58,Default,,0,0,0,,Сіздердің арқаларыңызда мен жас ханыммен қосылдым.
Dialogue: 0,0:21:34.66,0:21:37.79,Default,,0,0,0,,Көп нәрсе анық болды
Dialogue: 0,0:21:37.87,0:21:41.09,Default,,0,0,0,,Жүр, мен сені менімен бірге апарамын.
Dialogue: 0,0:21:41.17,0:21:43.38,Default,,0,0,0,,Император Сакуя
Dialogue: 0,0:21:46.51,0:21:47.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.30,0:21:50.51,Default,,0,0,0,,Бұл не? сендер жігіттер
Dialogue: 0,0:21:50.60,0:21:52.60,Default,,0,0,0,,Сіз террористтерге көмектесіп жатырсыз.
Dialogue: 0,0:21:52.68,0:21:54.93,Default,,0,0,0,,Наталья Люксембург
Dialogue: 0,0:21:55.02,0:21:57.81,Default,,0,0,0,,Мемлекетке опасыздық жасады деген күдікпен ұсталды
Dialogue: 0,0:21:59.65,0:22:00.48,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:22:00.56,0:22:02.07,Default,,0,0,0,,Жаудың зымыранмен шабуылы
Dialogue: 0,0:22:02.15,0:22:04.40,Default,,0,0,0,,Мүше орналасқан жер деректері
Dialogue: 0,0:22:04.48,0:22:06.03,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:22:06.11,0:22:07.74,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:22:07.82,0:22:10.07,Default,,0,0,0,,Күл Феникс!
Dialogue: 0,0:22:10.16,0:22:11.87,Default,,0,0,0,,Кездесу кешінің уақыты келді.
Dialogue: 0,0:22:11.95,0:22:15.75,Default,,0,0,0,,Мен сенің жексұрындығыңды көрсетемін.
Dialogue: 0,0:22:15.83,0:22:17.71,Default,,0,0,0,,Жақсы, Ах-кун
Dialogue: 0,0:22:17.79,0:22:19.04,Default,,0,0,0,,Өзгеріс алсаңыз
Dialogue: 0,0:22:19.12,0:22:21.71,Default,,0,0,0,,Қатты бөлшектерді алып тастап, өзіңізді жақсы сезінесіз.
Dialogue: 0,0:22:27.80,0:22:30.93,Default,,0,0,0,,Олай болса, бастайық па, жас ханым?
