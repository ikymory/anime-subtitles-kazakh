Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.46,0:00:07.17,Default,,0,0,0,,Нала-самаға жеке желіні ашыңыз.
Dialogue: 0,0:00:07.25,0:00:08.29,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:08.38,0:00:09.88,Default,,0,0,0,,Ашық
Dialogue: 0,0:00:11.13,0:00:12.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:12.59,0:00:14.51,Default,,0,0,0,,Бастапқыда бұл мен емес едім.
Dialogue: 0,0:00:14.59,0:00:17.93,Default,,0,0,0,,Шварц патшайымы ретінде сіз жауапты болуыңыз керек.
Dialogue: 0,0:00:18.89,0:00:22.14,Default,,0,0,0,,Уайымдамаңыз, бұл Ноланд мырзаның нұсқауы.
Dialogue: 0,0:00:22.23,0:00:25.65,Default,,0,0,0,,Біздің бөлімше жаудың құрлықтағы күштерін басуға арналған.
Dialogue: 0,0:00:25.73,0:00:29.02,Default,,0,0,0,,Бұл маған Дамоклді басқаруға назар аударуға мүмкіндік береді.
Dialogue: 0,0:00:29.11,0:00:31.65,Default,,0,0,0,,Саппоро геттосындағы он бірлерді жоюдың мақсаты
Dialogue: 0,0:00:31.74,0:00:33.86,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:00:35.11,0:00:36.53,Default,,0,0,0,,Жою?
Dialogue: 0,0:00:36.61,0:00:38.37,Default,,0,0,0,,Қарусыздар ма?
Dialogue: 0,0:00:40.45,0:00:41.87,Default,,0,0,0,,Жау туралы ақпарат алынды.
Dialogue: 0,0:00:42.66,0:00:45.79,Default,,0,0,0,,Дамоклдың Саппороға 18:00-де келу уақыты
Dialogue: 0,0:00:45.87,0:00:49.13,Default,,0,0,0,,Құрлық әскерлері мен Дамоклдың инфильтрациялық күштері шабуыл жасайды.
Dialogue: 0,0:00:49.21,0:00:53.05,Default,,0,0,0,,Екі жау бірлігі бар: Нала Вон және Дивок Мерте.
Dialogue: 0,0:00:53.13,0:00:56.05,Default,,0,0,0,,Жаулардың саны туралы мәліметтерді құжаттан қараңыз.
Dialogue: 0,0:00:56.13,0:00:59.10,Default,,0,0,0,,Тіпті екінші бірліктің өзі бізден жақсырақ.
Dialogue: 0,0:00:59.18,0:01:02.22,Default,,0,0,0,,Бұл бүкіл необританиялық армиямен бетпе-бет келгеннен жақсы, солай ма?
Dialogue: 0,0:01:02.31,0:01:03.52,Default,,0,0,0,,Әрине
Dialogue: 0,0:01:03.60,0:01:05.14,Default,,0,0,0,,Бұл ақпаратты қалай алуға болады?
Dialogue: 0,0:01:05.77,0:01:08.98,Default,,0,0,0,,Әрқашан серіктесіңіз дайын болсын
Dialogue: 0,0:01:09.06,0:01:12.40,Default,,0,0,0,,Ақпарат бойынша, Дамоклдың күзетшісі - Дивок.
Dialogue: 0,0:01:12.48,0:01:15.11,Default,,0,0,0,,Құрлықтағы ұрыс бөлімі - Нала.
Dialogue: 0,0:01:15.20,0:01:17.20,Default,,0,0,0,,Мен Нараның серіктесі боламын.
Dialogue: 0,0:01:17.28,0:01:19.03,Default,,0,0,0,,Ол күшті
Dialogue: 0,0:01:19.12,0:01:21.45,Default,,0,0,0,,Ағаның бұдан да маңызды миссиясы бар.
Dialogue: 0,0:01:22.54,0:01:25.54,Default,,0,0,0,,Толық ұйымдастыру үшін Курото Курото және басқалармен кеңесіңіз.
Dialogue: 0,0:01:25.62,0:01:27.46,Default,,0,0,0,,Әр бөлім басшысына кейінірек жіберемін.
Dialogue: 0,0:01:28.21,0:01:32.05,Default,,0,0,0,,Кәне, жапондықтарды Жаңа Британияның құрсауынан құтқарайық.
Dialogue: 0,0:01:32.67,0:01:34.51,Default,,0,0,0,,Батыр бол!
Dialogue: 0,0:01:36.01,0:01:41.01,Default,,0,0,0,,♪～
Dialogue: 0,0:03:01.84,0:03:05.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:08.18,0:03:09.39,Default,,0,0,0,,Фрейяда 3 соққы қалды.
Dialogue: 0,0:03:09.48,0:03:11.02,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:03:11.10,0:03:15.52,Default,,0,0,0,,Иә, Фрейя арнайы жабдықсыз жасалмайды.
Dialogue: 0,0:03:16.23,0:03:17.90,Default,,0,0,0,,Біз не жасадық
Dialogue: 0,0:03:17.98,0:03:21.11,Default,,0,0,0,,Сол кезде жоғары мәртебелі Шнайзел бәрін алды.
Dialogue: 0,0:03:21.20,0:03:24.95,Default,,0,0,0,,Мен сол кездегі жазбаларды талай рет тексеріп, қайта растадым.
Dialogue: 0,0:03:25.87,0:03:27.83,Default,,0,0,0,,Бұл 3 кадрдан аз болуы мүмкін
Dialogue: 0,0:03:27.91,0:03:29.25,Default,,0,0,0,,Менің ойымша, көп емес.
Dialogue: 0,0:03:29.33,0:03:30.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:30.87,0:03:34.29,Default,,0,0,0,,Сақай Сақай, Куротоға және басқаларға жоспарлағандай баратыныңды айт.
Dialogue: 0,0:03:34.38,0:03:35.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:35.84,0:03:36.75,Default,,0,0,0,,Раушан
Dialogue: 0,0:03:36.84,0:03:37.67,Default,,0,0,0,,Ах
Dialogue: 0,0:03:40.67,0:03:42.76,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:03:42.84,0:03:45.22,Default,,0,0,0,,Мен көлік компаниясымын.
Dialogue: 0,0:03:45.30,0:03:47.47,Default,,0,0,0,,Ішіндегі британдықтарды шығарыңыз...
Dialogue: 0,0:03:47.56,0:03:48.56,Default,,0,0,0,,Әскери қызметкерлердің өтініші бойынша...
Dialogue: 0,0:03:48.64,0:03:51.14,Default,,0,0,0,,Осы нүктеден тыс барлық қозғалысқа тыйым салынады.
Dialogue: 0,0:03:51.23,0:03:52.64,Default,,0,0,0,,Артқа бұрылыңыз
Dialogue: 0,0:03:52.73,0:03:54.65,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:03:56.81,0:03:58.82,Default,,0,0,0,,Жапондарды құтқару
Dialogue: 0,0:03:59.48,0:04:01.53,Default,,0,0,0,,Роузбен ынтымақтасу
Dialogue: 0,0:04:04.70,0:04:06.07,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:06.66,0:04:08.49,Default,,0,0,0,,Ол да сіздің әріптестеріңіздің бірі ме?
Dialogue: 0,0:04:08.58,0:04:10.41,Default,,0,0,0,,Өйткені біз әдетте бір-бірімізді көрмейміз
Dialogue: 0,0:04:10.50,0:04:13.16,Default,,0,0,0,,Осындай кезде бізге құпия сөз қажет болады.
Dialogue: 0,0:04:13.87,0:04:16.38,Default,,0,0,0,,Бұл сіз реттеп жатқан нәрсе ме?
Dialogue: 0,0:04:16.46,0:04:18.38,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:04:18.46,0:04:20.51,Default,,0,0,0,,Енді арттағы жауынгерлерге.
Dialogue: 0,0:04:20.59,0:04:23.38,Default,,0,0,0,,Мен сізден жапондықтарды эвакуациялауда ынтымақтасуыңызды сұрауым керек пе?
Dialogue: 0,0:04:25.18,0:04:26.22,Default,,0,0,0,,Ноланд!
Dialogue: 0,0:04:26.30,0:04:29.60,Default,,0,0,0,,Саппоро геттосын жою мағынасыз.
Dialogue: 0,0:04:29.68,0:04:31.22,Default,,0,0,0,,Қазір тоқтатыңыз
Dialogue: 0,0:04:31.31,0:04:34.39,Default,,0,0,0,,Сіз мені сол үшін шақырдыңыз ба?
Dialogue: 0,0:04:34.48,0:04:36.69,Default,,0,0,0,,Террористерді жою туралы айту
Dialogue: 0,0:04:36.77,0:04:38.15,Default,,0,0,0,,Сіздің атыңыз сақталады.
Dialogue: 0,0:04:38.23,0:04:41.28,Default,,0,0,0,,Бірақ бұл жазықсыз адамдар құрбан болса.
Dialogue: 0,0:04:41.36,0:04:43.74,Default,,0,0,0,,Халықаралық қауымдастықтың сынының нысанасына айналу
Dialogue: 0,0:04:44.36,0:04:45.57,Default,,0,0,0,,Олай болса, бұл елдің болашағы...
Dialogue: 0,0:04:45.66,0:04:47.91,Default,,0,0,0,,Біз сіздің пікірлеріңізді естідік.
Dialogue: 0,0:04:47.99,0:04:49.33,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:49.91,0:04:52.08,Default,,0,0,0,,Күте тұрыңыз, сөйлесетін нәрсе бар... (Есіктің ашылған дыбысы)
Dialogue: 0,0:04:53.29,0:04:54.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:56.83,0:05:00.75,Default,,0,0,0,,Менде ешқандай билік жоқ.
Dialogue: 0,0:05:02.05,0:05:03.26,Default,,0,0,0,,Қазір——
Dialogue: 0,0:05:04.05,0:05:05.93,Default,,0,0,0,,Менің қолымнан келетіні - дұға ету...
Dialogue: 0,0:05:08.22,0:05:10.76,Default,,0,0,0,,Сыртқы камера Саппоро геттосын түсірді
Dialogue: 0,0:05:10.85,0:05:13.14,Default,,0,0,0,,Жылу көзінің көптеген реакциялары расталды
Dialogue: 0,0:05:13.22,0:05:14.56,Default,,0,0,0,,Мәліметтерді тасымалдау
Dialogue: 0,0:05:15.94,0:05:16.77,Default,,0,0,0,,Иә
Dialogue: 0,0:05:16.85,0:05:20.98,Default,,0,0,0,,Мен сіздерді біржолата жойып жіберемін.
Dialogue: 0,0:05:21.07,0:05:22.57,Default,,0,0,0,,Атысуға дайын!
Dialogue: 0,0:05:22.65,0:05:25.28,Default,,0,0,0,,Қарсылас ауқымынан тыс кезде үзіліс
Dialogue: 0,0:05:25.86,0:05:28.24,Default,,0,0,0,,Blaze жарықты жартылай ашу
Dialogue: 0,0:05:29.91,0:05:31.62,Default,,0,0,0,,Жауды іздеу аяқталды
Dialogue: 0,0:05:32.20,0:05:35.04,Default,,0,0,0,,Blaze Luminous Жартылай ашылған
Dialogue: 0,0:05:35.12,0:05:37.04,Default,,0,0,0,,Жаппай шабуылға дайындық
Dialogue: 0,0:05:37.12,0:05:38.92,Default,,0,0,0,,Страфе отрядының күту режимі
Dialogue: 0,0:05:45.42,0:05:47.05,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:05:47.13,0:05:48.51,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:05:54.85,0:05:56.73,Default,,0,0,0,,Ат, ат!
Dialogue: 0,0:05:56.81,0:05:59.40,Default,,0,0,0,,Бос болғанша соғуды жалғастырыңыз.
Dialogue: 0,0:06:03.11,0:06:04.61,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:04.69,0:06:06.11,Default,,0,0,0,,Шығу тобын түсіріңіз.
Dialogue: 0,0:06:06.19,0:06:07.74,Default,,0,0,0,,Blaze Luminous Reployment!
Dialogue: 0,0:06:07.82,0:06:09.20,Default,,0,0,0,,Blaze жарықты қайта орналастыру
Dialogue: 0,0:06:11.24,0:06:14.45,Default,,0,0,0,,Жарайды, бұл шегіну.
Dialogue: 0,0:06:14.54,0:06:17.08,Default,,0,0,0,,Нала-сама, жалғастырыңыз.
Dialogue: 0,0:06:17.16,0:06:19.50,Default,,0,0,0,,Түсіндім, мен егеуқұйрықтарды аулаймын.
Dialogue: 0,0:06:19.58,0:06:21.63,Default,,0,0,0,,Одан әрі отшашуларға жол бермеңіз!
Dialogue: 0,0:06:21.71,0:06:23.38,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:06:35.18,0:06:38.06,Default,,0,0,0,,Жау әскерлері ілгерілеу сызығынан шығады.
Dialogue: 0,0:06:38.14,0:06:40.69,Default,,0,0,0,,Жарайды, Дамоклді жылжытуды жалғастырыңыз.
Dialogue: 0,0:06:40.77,0:06:42.52,Default,,0,0,0,,Қозғалысты жалғастыру
Dialogue: 0,0:06:42.61,0:06:45.90,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, күн батқанша аяқталады.
Dialogue: 0,0:06:45.98,0:06:48.24,Default,,0,0,0,,Артынан келе жатқан ұшақ (ескерту дыбысы)
Dialogue: 0,0:06:48.32,0:06:49.95,Default,,0,0,0,,№6!
Dialogue: 0,0:06:52.41,0:06:55.24,Default,,0,0,0,,Солтүстік қасқыр моль армиясы төмендегі әскерлерді тартты.
Dialogue: 0,0:06:55.33,0:06:58.25,Default,,0,0,0,,Енді негізгі қоршауға шабуыл жасайық!
Dialogue: 0,0:06:58.33,0:07:01.96,Default,,0,0,0,,Ғұнға жақындағанда не істей аласың?
Dialogue: 0,0:07:02.04,0:07:03.67,Default,,0,0,0,,Қара рыцарьлар
Dialogue: 0,0:07:03.75,0:07:07.13,Default,,0,0,0,,Жаңа Freya Eliminator аяқталды.
Dialogue: 0,0:07:07.21,0:07:09.59,Default,,0,0,0,,Blaze Luminous-қа қарсы шаралар бірдей!
Dialogue: 0,0:07:12.59,0:07:14.01,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:07:16.89,0:07:18.68,Default,,0,0,0,,Жалынды жарық жартылай сөнді
Dialogue: 0,0:07:18.77,0:07:20.10,Default,,0,0,0,,Қайта орналастыруға дейін 2 секунд
Dialogue: 0,0:07:22.15,0:07:23.81,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:07:22.15,0:07:25.48,Default,,0,0,0,,Жау бөлімі қалқанның ішіне кірді
Dialogue: 0,0:07:25.57,0:07:27.15,Default,,0,0,0,,Nightmare кадрын шығарыңыз
Dialogue: 0,0:07:27.23,0:07:28.86,Default,,0,0,0,,Зиянкестерді жою
Dialogue: 0,0:07:28.94,0:07:30.24,Default,,0,0,0,,Мен де келемін!
Dialogue: 0,0:07:31.40,0:07:32.74,Default,,0,0,0,,Қайталап айтамын,
Dialogue: 0,0:07:32.82,0:07:35.20,Default,,0,0,0,,Төрт қалқыманың үшеуін жою керек.
Dialogue: 0,0:07:35.28,0:07:37.83,Default,,0,0,0,,Биікке қашып, бас тартты
Dialogue: 0,0:07:37.91,0:07:40.37,Default,,0,0,0,,Броньжарғыш бомбаларды орнату Міндетті түрде орындаңыз.
Dialogue: 0,0:07:41.16,0:07:42.04,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:07:42.12,0:07:44.79,Default,,0,0,0,,Мен Дамоклді басып алуды жоспарлаймын.
Dialogue: 0,0:07:45.42,0:07:47.75,Default,,0,0,0,,Харука-чан - ішкі басып алудың жалғасы.
Dialogue: 0,0:07:47.84,0:07:49.21,Default,,0,0,0,,Барлығына қолдау көрсетіңіздер
Dialogue: 0,0:07:49.30,0:07:50.13,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:50.21,0:07:52.76,Default,,0,0,0,,Содан кейін операция басталады!
Dialogue: 0,0:07:52.84,0:07:54.09,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:07:57.97,0:07:59.64,Default,,0,0,0,,Рахмет саған Харука-чан
Dialogue: 0,0:08:05.19,0:08:07.52,Default,,0,0,0,,Енді...
Dialogue: 0,0:08:16.07,0:08:17.20,Default,,0,0,0,,Накахаши Накахаши!
Dialogue: 0,0:08:17.28,0:08:20.62,Default,,0,0,0,,Уф... Бұл қарқынмен біз жойылудан құтыла алмаймыз.
Dialogue: 0,0:08:20.70,0:08:23.12,Default,,0,0,0,,Барлығы тарап, шегінсін!
Dialogue: 0,0:08:23.83,0:08:25.00,Default,,0,0,0,,ақымақ
Dialogue: 0,0:08:25.08,0:08:27.50,Default,,0,0,0,,Бастапқыда шағын болған әскерлерді тарату, т.б.
Dialogue: 0,0:08:27.59,0:08:29.92,Default,,0,0,0,,Тек біздің олжамыз болу үшін
Dialogue: 0,0:08:37.76,0:08:39.89,Default,,0,0,0,,Арх! Удо Удо...
Dialogue: 0,0:08:39.97,0:08:40.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:51.28,0:08:52.65,Default,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,0:08:52.74,0:08:54.57,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:08:55.32,0:08:58.03,Default,,0,0,0,,Солтүстік Қасқыр армиясын қауіпсіз аймаққа шығарыңыз.
Dialogue: 0,0:08:58.12,0:09:00.62,Default,,0,0,0,,Осы жерден өзімізге байланысты.
Dialogue: 0,0:09:00.70,0:09:02.08,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:09:02.58,0:09:03.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.25,0:09:06.33,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:09:06.42,0:09:08.08,Default,,0,0,0,,Уууу!
Dialogue: 0,0:09:12.30,0:09:14.63,Default,,0,0,0,,Чарли зеңбірегі жөнелтілді
Dialogue: 0,0:09:16.51,0:09:17.55,Default,,0,0,0,,Түсіру
Dialogue: 0,0:09:19.01,0:09:21.35,Default,,0,0,0,,Mononobe Monobe командасы, тікелей Delta Point-ке барыңыз.
Dialogue: 0,0:09:21.97,0:09:22.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:23.43,0:09:24.35,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:09:26.39,0:09:28.31,Default,,0,0,0,,Delta Point Armor-breaking Bomb
Dialogue: 0,0:09:28.40,0:09:29.31,Default,,0,0,0,,Детонация
Dialogue: 0,0:09:30.52,0:09:33.32,Default,,0,0,0,,Мунемори командасын Альфа нүктесіне апарыңыз.
Dialogue: 0,0:09:35.74,0:09:38.24,Default,,0,0,0,,Құрметті Нала, бізді жау әскерлері итермелеп жатыр.
Dialogue: 0,0:09:38.95,0:09:42.20,Default,,0,0,0,,Дүрбелең емес! Артқы әскерлерді қолдауға жіберіңіз
Dialogue: 0,0:09:42.29,0:09:44.20,Default,,0,0,0,,Біріктіргеннен кейін ұрыс сызығын артқа итеріңіз
Dialogue: 0,0:09:44.29,0:09:45.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:45.75,0:09:48.12,Default,,0,0,0,,Сіз одақтасыңыздың жаман қимылдарын жақсыға айналдырдыңыз ба?
Dialogue: 0,0:09:48.21,0:09:50.29,Default,,0,0,0,,Мұны істеу қиын.
Dialogue: 0,0:09:50.38,0:09:51.38,Default,,0,0,0,,Синдзо
Dialogue: 0,0:09:51.46,0:09:54.05,Default,,0,0,0,,Дамоклдың орнату жағдайы қандай?
Dialogue: 0,0:09:54.13,0:09:56.92,Default,,0,0,0,,Ichiban Third Wing орнату аяқталды
Dialogue: 0,0:09:57.01,0:09:59.14,Default,,0,0,0,,Екінші қанат жойылды
Dialogue: 0,0:09:59.80,0:10:02.81,Default,,0,0,0,,Төртінші қанат Қазіргі уақытта орнатылуда
Dialogue: 0,0:10:02.89,0:10:05.77,Default,,0,0,0,,Осыдан кейін, жай ғана Томи мырзаны орнатыңыз және сіз аяқтадыңыз...
Dialogue: 0,0:10:06.35,0:10:07.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:07.98,0:10:10.15,Default,,0,0,0,,Ей, лас маймылдар
Dialogue: 0,0:10:10.23,0:10:12.27,Default,,0,0,0,,Дамоклға кіру және т.б.
Dialogue: 0,0:10:12.36,0:10:13.98,Default,,0,0,0,,Қылмыс
Dialogue: 0,0:10:14.07,0:10:16.11,Default,,0,0,0,,Өмірмен өтеңіз!
Dialogue: 0,0:10:16.99,0:10:19.66,Default,,0,0,0,,Ғұн Жау генералы қандай?
Dialogue: 0,0:10:19.74,0:10:22.41,Default,,0,0,0,,Қарғыс атсын... Рахмет!
Dialogue: 0,0:10:23.74,0:10:24.66,Default,,0,0,0,,Артқы есік
Dialogue: 0,0:10:25.37,0:10:27.54,Default,,0,0,0,,Жақсы, Фрейя...
Dialogue: 0,0:10:28.25,0:10:30.04,Default,,0,0,0,,Жүктер саны 2... (Есік қағу дыбысы)
Dialogue: 0,0:10:30.12,0:10:32.04,Default,,0,0,0,,Әй (Солдат) Әй, аш!
Dialogue: 0,0:10:34.71,0:10:35.76,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:35.84,0:10:38.34,Default,,0,0,0,,Сіз не істеп жатырсыз? Мәжбүрлі пәрменді тоқтатыңыз!
Dialogue: 0,0:10:38.42,0:10:40.38,Default,,0,0,0,,Навигацияға кедергі келтірілді
Dialogue: 0,0:10:40.47,0:10:42.89,Default,,0,0,0,,Бұл биіктікті одан әрі арттырмау үшін.
Dialogue: 0,0:10:42.97,0:10:45.14,Default,,0,0,0,,Мұндай бұйрық шығарылған жоқ!
Dialogue: 0,0:10:45.22,0:10:47.98,Default,,0,0,0,,Мен алған тапсырыстар абсолютті.
Dialogue: 0,0:10:48.06,0:10:48.89,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:48.98,0:10:50.06,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:48.98,0:10:52.94,Default,,0,0,0,,Өзін күдікті ұстаған адам, тіпті одақтас болса да, дереу өлтірілсін.
Dialogue: 0,0:10:53.02,0:10:54.77,Default,,0,0,0,,Тоқтамағандарды ат.
Dialogue: 0,0:10:54.86,0:10:56.82,Default,,0,0,0,,Бұл Ноланд мырзаның сөздері.
Dialogue: 0,0:10:58.32,0:10:59.24,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:59.32,0:11:00.40,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:00.49,0:11:03.74,Default,,0,0,0,,Енді Дамоклді іштен алудың жолы жоқ.
Dialogue: 0,0:11:06.49,0:11:09.04,Default,,0,0,0,,Уа... кетті!
Dialogue: 0,0:11:09.71,0:11:10.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:10.96,0:11:13.79,Default,,0,0,0,,Тек басы ғана сызылған ба?
Dialogue: 0,0:11:14.92,0:11:16.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:16.55,0:11:18.46,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:19.34,0:11:21.01,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:11:21.09,0:11:22.68,Default,,0,0,0,,Жоғал... (Соққы дыбысы)
Dialogue: 0,0:11:25.30,0:11:27.31,Default,,0,0,0,,Кеш бақылағаным үшін кешірім сұраймыз
Dialogue: 0,0:11:27.39,0:11:29.31,Default,,0,0,0,,Бұл мен үшін.
Dialogue: 0,0:11:30.43,0:11:32.27,Default,,0,0,0,,Бұл жаңа үлгі ме?
Dialogue: 0,0:11:32.35,0:11:36.02,Default,,0,0,0,,Маймыл не мінсе де, нәтиже бірдей!
Dialogue: 0,0:11:39.19,0:11:40.44,Default,,0,0,0,,Ийда…
Dialogue: 0,0:11:41.32,0:11:42.57,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:11:54.79,0:11:57.38,Default,,0,0,0,,Ол қалағаныңызша жұмыс істейді
Dialogue: 0,0:11:58.59,0:12:00.46,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:12:07.60,0:12:09.93,Default,,0,0,0,,Тәтті... шіркін.
Dialogue: 0,0:12:10.02,0:12:11.48,Default,,0,0,0,,Құрметті Дивок
Dialogue: 0,0:12:10.64,0:12:11.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.56,0:12:13.73,Default,,0,0,0,,Фрейя әсер ету ауқымына кірді.
Dialogue: 0,0:12:13.81,0:12:15.86,Default,,0,0,0,,Жарайды, ұшыруға дайындалыңыз.
Dialogue: 0,0:12:15.94,0:12:17.06,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:18.82,0:12:21.07,Default,,0,0,0,,Жаудың бастығы қашып кетті. Оның артынан қуғың келе ме?
Dialogue: 0,0:12:21.15,0:12:24.03,Default,,0,0,0,,Күте тұрыңыз, Курото мырза, жаудың қимылдары ше?
Dialogue: 0,0:12:24.61,0:12:26.53,Default,,0,0,0,,Бірден алдыңғы жағынан сурет сала бастады
Dialogue: 0,0:12:27.24,0:12:28.83,Default,,0,0,0,,Фрейя осында ма?
Dialogue: 0,0:12:28.91,0:12:31.20,Default,,0,0,0,,Күтілетін уақыттан ертерек
Dialogue: 0,0:12:31.29,0:12:32.83,Default,,0,0,0,,Мен бәрібір өз қимылымды тежеуім керек.
Dialogue: 0,0:12:32.91,0:12:35.79,Default,,0,0,0,,Ичибан №3 Қанат Жарылысқа дайындық
Dialogue: 0,0:12:35.88,0:12:37.33,Default,,0,0,0,,Жарылысқа дайындық Енгізу
Dialogue: 0,0:12:37.92,0:12:42.21,Default,,0,0,0,,Харука бөлімі, Азума бөлімі және Ичибан 3-ші қанат бөлімі дереу эвакуацияланады.
Dialogue: 0,0:12:42.30,0:12:43.51,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:43.59,0:12:45.51,Default,,0,0,0,,Фрейя қалай дайындалуда?
Dialogue: 0,0:12:45.59,0:12:48.14,Default,,0,0,0,,Сынилік шегінен асып кетті. Кез келген уақытта жұмыстан шығаруға болады.
Dialogue: 0,0:12:48.22,0:12:50.31,Default,,0,0,0,,Ағымдағы әсер қандай?
Dialogue: 0,0:12:50.39,0:12:52.02,Default,,0,0,0,,Шамамен 20 пайыз
Dialogue: 0,0:12:52.10,0:12:54.06,Default,,0,0,0,,Маймыл араласты, бірақ
Dialogue: 0,0:12:54.14,0:12:56.23,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:12:56.31,0:12:57.94,Default,,0,0,0,,Курото мырза, жарайды.
Dialogue: 0,0:12:58.02,0:13:00.27,Default,,0,0,0,,Құрыш сындыратын бомбаның жарылысы!
Dialogue: 0,0:13:00.36,0:13:01.28,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:13:03.28,0:13:04.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:04.24,0:13:05.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:05.65,0:13:08.45,Default,,0,0,0,,Жарылыс салдарынан қалқымалы алдыңғы және артқы қанаттар жұмысын тоқтатты
Dialogue: 0,0:13:08.53,0:13:10.53,Default,,0,0,0,,Ағымдағы жалпы өнім 50%
Dialogue: 0,0:13:10.62,0:13:13.87,Default,,0,0,0,,Сол және оң қанат қуатын 150%-ға арттырыңыз.
Dialogue: 0,0:13:13.95,0:13:14.96,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:15.04,0:13:17.46,Default,,0,0,0,,Содан кейін Фрейя ұшырылады
Dialogue: 0,0:13:17.54,0:13:19.46,Default,,0,0,0,,Максималды әсерге қол жеткізу мүмкін болмаса да
Dialogue: 0,0:13:19.54,0:13:22.30,Default,,0,0,0,,Тағы бір ату бар. Маған бәрі бір. Ат!
Dialogue: 0,0:13:22.88,0:13:24.34,Default,,0,0,0,,Freya ұшыру
Dialogue: 0,0:13:25.84,0:13:27.34,Default,,0,0,0,,Ах (Нина) Ах
Dialogue: 0,0:13:28.14,0:13:30.05,Default,,0,0,0,,Бауырым, мен сол жаққа бет алдым!
Dialogue: 0,0:13:32.18,0:13:33.56,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:13:51.95,0:13:53.20,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:13:53.29,0:13:56.62,Default,,0,0,0,,Жоқ, әлі біреуі қалды.
Dialogue: 0,0:13:59.08,0:14:00.00,Default,,0,0,0,,Нина
Dialogue: 0,0:14:00.08,0:14:03.25,Default,,0,0,0,,Freya Eliminator дайындаңыз.
Dialogue: 0,0:14:03.34,0:14:04.38,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:04.96,0:14:08.09,Default,,0,0,0,,Шынымды айтсам, мен оны уақытында орындайтыныма сенімді емеспін...
Dialogue: 0,0:14:10.09,0:14:11.80,Default,,0,0,0,,Фрейяны дайында!
Dialogue: 0,0:14:11.89,0:14:14.14,Default,,0,0,0,,Фрейя бастайды
Dialogue: 0,0:14:14.22,0:14:18.48,Default,,0,0,0,,Бұл жолы мен сені дәл ортаға лақтырамын.
Dialogue: 0,0:14:19.23,0:14:21.48,Default,,0,0,0,,Фрейяның талдау деректері енді қол жетімді.
Dialogue: 0,0:14:21.56,0:14:24.98,Default,,0,0,0,,Бір типті жағдайда, егер ол Ишикари өзенінің арғы жағындағы Ишикари өзені арқылы іске қосылса ——
Dialogue: 0,0:14:25.07,0:14:27.49,Default,,0,0,0,,70
Dialogue: 0,0:14:27.57,0:14:31.07,Default,,0,0,0,,...
Dialogue: 0,0:14:31.16,0:14:34.03,Default,,0,0,0,,Мононобе Ивамото бөлімшесі Эбетсу қаласына орналасады
Dialogue: 0,0:14:34.12,0:14:34.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:35.08,0:14:36.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:36.79,0:14:39.04,Default,,0,0,0,,Қашықтық бізге қиын.
Dialogue: 0,0:14:39.12,0:14:40.42,Default,,0,0,0,,Біз ше?
Dialogue: 0,0:14:40.50,0:14:42.63,Default,,0,0,0,,Құрлық әскерлеріне еріңіз.
Dialogue: 0,0:14:42.71,0:14:43.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:45.75,0:14:48.38,Default,,0,0,0,,…
Dialogue: 0,0:14:49.26,0:14:51.34,Default,,0,0,0,,...
Dialogue: 0,0:14:54.97,0:14:56.97,Default,,0,0,0,,Аа, Томи мырза?
Dialogue: 0,0:14:57.06,0:14:58.81,Default,,0,0,0,,Қалқыманы жойыңыз!
Dialogue: 0,0:14:58.89,0:14:59.73,Default,,0,0,0,,Не?
Dialogue: 0,0:15:00.52,0:15:01.98,Default,,0,0,0,,VTOL жабдықтары мен жабдықтары
Dialogue: 0,0:15:02.06,0:15:05.19,Default,,0,0,0,,Біз оны артта қалдырған қар гүлдері мен сауыт бомбаларымен басқара аламыз.
Dialogue: 0,0:15:05.27,0:15:06.40,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:15:06.48,0:15:08.24,Default,,0,0,0,,Мен бұл тым көп екенін білемін!
Dialogue: 0,0:15:08.32,0:15:12.70,Default,,0,0,0,,Бірақ күресе алмаған батырдың өмірде құны жоқ!
Dialogue: 0,0:15:12.78,0:15:15.58,Default,,0,0,0,,Қарсыластың VTOL ұшағы тез жақындап келеді
Dialogue: 0,0:15:15.66,0:15:18.37,Default,,0,0,0,,Ғұн жалынының жарқырауы
Dialogue: 0,0:15:18.45,0:15:20.37,Default,,0,0,0,,Біз қазір ұшу үшін энергияны пайдаланып жатырмыз.
Dialogue: 0,0:15:20.46,0:15:21.33,Default,,0,0,0,,Кеңейту мүмкін емес
Dialogue: 0,0:15:21.42,0:15:22.42,Default,,0,0,0,,Ауыстыру!
Dialogue: 0,0:15:22.50,0:15:23.75,Default,,0,0,0,,Уақытында емес ауысу
Dialogue: 0,0:15:23.83,0:15:24.71,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:28.96,0:15:30.93,Default,,0,0,0,,...
Dialogue: 0,0:15:31.01,0:15:34.89,Default,,0,0,0,,Томи мырзаның сигналы жоғалды.
Dialogue: 0,0:15:34.97,0:15:36.39,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:15:40.48,0:15:42.69,Default,,0,0,0,,Қалқымалы сол қанат жұмысын тоқтатты!
Dialogue: 0,0:15:40.48,0:15:45.61,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:15:42.77,0:15:45.61,Default,,0,0,0,,Навигация жылдамдығы 25%-ға дейін төмендетілді
Dialogue: 0,0:15:45.69,0:15:47.27,Default,,0,0,0,,Жалынды жарық генераторы
Dialogue: 0,0:15:47.36,0:15:48.44,Default,,0,0,0,,Жауап жоқ!
Dialogue: 0,0:15:48.53,0:15:50.44,Default,,0,0,0,,Фрейя сыншылдыққа жетті.
Dialogue: 0,0:15:50.53,0:15:51.74,Default,,0,0,0,,Кез келген уақытта атуға болады
Dialogue: 0,0:15:51.82,0:15:53.99,Default,,0,0,0,,Жоқ, әлі жоқ!
Dialogue: 0,0:15:54.07,0:15:57.12,Default,,0,0,0,,Келесісі Саппороның ортасында болуы керек.
Dialogue: 0,0:15:57.20,0:15:58.49,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:59.70,0:16:01.54,Default,,0,0,0,,Төтенше жағдайда...
Dialogue: 0,0:16:04.08,0:16:06.71,Default,,0,0,0,,Жақында соңғы қорғаныс шебі болады.
Dialogue: 0,0:16:06.79,0:16:10.17,Default,,0,0,0,,Раушан дамоклдарын жою керек.
Dialogue: 0,0:16:10.26,0:16:12.93,Default,,0,0,0,,Иә, мен оны алу үшін жоспарды тастадым.
Dialogue: 0,0:16:13.01,0:16:15.43,Default,,0,0,0,,Тағы бір Фрейя қалды.
Dialogue: 0,0:16:15.51,0:16:17.35,Default,,0,0,0,,Мен де сізге қосыламын.
Dialogue: 0,0:16:17.43,0:16:19.64,Default,,0,0,0,,Шварц патшайымы келді.
Dialogue: 0,0:16:19.72,0:16:21.27,Default,,0,0,0,,Ода отрядының жолын кесу
Dialogue: 0,0:16:21.35,0:16:22.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:22.27,0:16:24.77,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:16:31.74,0:16:34.82,Default,,0,0,0,,Түрлі-түсті экипаж үшін біз жақсы жұмыс істеп жатырмыз... Ах!
Dialogue: 0,0:16:46.96,0:16:48.63,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:16:48.71,0:16:51.26,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:16:51.34,0:16:56.05,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін.
Dialogue: 0,0:16:57.18,0:16:59.72,Default,,0,0,0,,Иә
Dialogue: 0,0:17:05.48,0:17:07.81,Default,,0,0,0,,Дамокл Исикари өзенінен өтеді
Dialogue: 0,0:17:07.90,0:17:09.77,Default,,0,0,0,,Нысананың төменгі жағы Үлкен зиян
Dialogue: 0,0:17:09.86,0:17:11.94,Default,,0,0,0,,Фрейя атуы мүмкін емес сияқты
Dialogue: 0,0:17:12.03,0:17:17.03,Default,,0,0,0,,Жарайды, Ода Мунемори командасы Шин-Ишикари көпірінен Эбетсуға дейін баруы керек.
Dialogue: 0,0:17:17.11,0:17:18.57,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:18.66,0:17:20.62,Default,,0,0,0,,Сіз өсекші жалдамалысыз ба?
Dialogue: 0,0:17:20.70,0:17:23.20,Default,,0,0,0,,Ол Гран мен Арнольдты істегенін айтты!
Dialogue: 0,0:17:28.25,0:17:30.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:37.43,0:17:39.89,Default,,0,0,0,,Ха... сол қозғалыс
Dialogue: 0,0:17:39.97,0:17:42.01,Default,,0,0,0,,Мен бұл ұшақта кім болғанына сене алмадым...
Dialogue: 0,0:17:42.10,0:17:44.06,Default,,0,0,0,,Нала-сама, жау әскерлері артта келе жатыр!
Dialogue: 0,0:17:45.93,0:17:48.15,Default,,0,0,0,,Дамоклға кірген әскерлерге ұқсайды.
Dialogue: 0,0:17:48.23,0:17:50.31,Default,,0,0,0,,Егер бұлай жалғаса берсе, сіз қысылып қаласыз.
Dialogue: 0,0:17:51.57,0:17:53.61,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:17:53.69,0:17:55.15,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:17:55.24,0:17:56.95,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:17:58.57,0:17:59.57,Default,,0,0,0,,Шегіну?
Dialogue: 0,0:18:00.16,0:18:01.37,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:01.45,0:18:02.99,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:18:03.08,0:18:04.87,Default,,0,0,0,,Өз тапсырмаңызды тез орындаңыз...
Dialogue: 0,0:18:04.95,0:18:06.37,Default,,0,0,0,,Рөл?
Dialogue: 0,0:18:06.46,0:18:08.29,Default,,0,0,0,,Операция сәтсіз аяқталды
Dialogue: 0,0:18:08.37,0:18:10.67,Default,,0,0,0,,Бұдан әрі ұрысудың қажеті жоқ.
Dialogue: 0,0:18:11.34,0:18:12.54,Default,,0,0,0,,Сәтсіздік?
Dialogue: 0,0:18:12.63,0:18:15.46,Default,,0,0,0,,Өлім алдында тұрған Дамоклді Фрея да пайдалана алмайды.
Dialogue: 0,0:18:15.55,0:18:17.51,Default,,0,0,0,,Менің әскерлерімді құрбан етуімді қалайсың ба?
Dialogue: 0,0:18:17.59,0:18:18.51,Default,,0,0,0,,Джонатанды өлтіру үшін Дио қолданған өлімге әкелетін қабілет.
Dialogue: 0,0:18:18.59,0:18:19.80,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:19.89,0:18:22.47,Default,,0,0,0,,Йо Нара-чан
Dialogue: 0,0:18:22.55,0:18:23.56,Default,,0,0,0,,Ах
Dialogue: 0,0:18:25.14,0:18:27.18,Default,,0,0,0,,Тамақтанып алайықшы, иә? \h
Dialogue: 0,0:18:27.27,0:18:30.02,Default,,0,0,0,,Ақымақ! Ақымақ! Ақымақ!
Dialogue: 0,0:18:30.60,0:18:33.40,Default,,0,0,0,,Нууууу...
Dialogue: 0,0:18:33.48,0:18:35.32,Default,,0,0,0,,Куу…
Dialogue: 0,0:18:35.86,0:18:39.36,Default,,0,0,0,,Қарсыластың құрлықтағы әскерлері шығарылды...
Dialogue: 0,0:18:39.45,0:18:40.45,Default,,0,0,0,,Модель! Модель! Менің не болып жатқанын түсіндірші!
Dialogue: 0,0:18:40.53,0:18:42.37,Default,,0,0,0,,Мен мұны жеңдім, Курото мырза.
Dialogue: 0,0:18:42.45,0:18:45.70,Default,,0,0,0,,Ха... Оны бірден бағалауға әлі ерте.
Dialogue: 0,0:18:45.79,0:18:46.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:46.95,0:18:50.12,Default,,0,0,0,,Дамоклдан Жоғары жылдамдықпен ұшатын заттар бар!
Dialogue: 0,0:18:50.21,0:18:51.63,Default,,0,0,0,,Баратын жер...
Dialogue: 0,0:18:51.71,0:18:53.38,Default,,0,0,0,,Саппоро геттосы
Dialogue: 0,0:18:55.13,0:18:56.84,Default,,0,0,0,,Сіз қоқыс жібересіз
Dialogue: 0,0:18:56.92,0:19:00.22,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, мен жеңіліс үшін жауапты боламын.
Dialogue: 0,0:19:01.09,0:19:04.72,Default,,0,0,0,,Лорд Ноланд қол астындағылардың сәтсіздікке ұшырағанын кешірмейді.
Dialogue: 0,0:19:04.81,0:19:07.68,Default,,0,0,0,,Онда мен сені өзіммен бірге алып кетемін!
Dialogue: 0,0:19:07.77,0:19:10.35,Default,,0,0,0,,Жау Nightmare Фрейяны ұстап тұр.
Dialogue: 0,0:19:10.44,0:19:11.27,Default,,0,0,0,,Не?
Dialogue: 0,0:19:11.35,0:19:12.73,Default,,0,0,0,,Ату керек пе?
Dialogue: 0,0:19:12.81,0:19:13.65,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:13.73,0:19:15.82,Default,,0,0,0,,Фрейя критикалық массаға жетті.
Dialogue: 0,0:19:15.90,0:19:17.61,Default,,0,0,0,,Егер дұрыс емес ынталандырса, ол жарылып кетеді!
Dialogue: 0,0:19:17.69,0:19:18.99,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:19:19.07,0:19:20.32,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:19:21.36,0:19:22.49,Default,,0,0,0,,Сен
Dialogue: 0,0:19:22.99,0:19:24.66,Default,,0,0,0,,Мұны тоқтатайық
Dialogue: 0,0:19:24.74,0:19:27.16,Default,,0,0,0,,Аполлон мен Артемидаға әлі уақыт бар.
Dialogue: 0,0:19:27.24,0:19:29.75,Default,,0,0,0,,Түсіндім, егер бұл Ортегея болса.
Dialogue: 0,0:19:29.83,0:19:31.00,Default,,0,0,0,,Бірақ Freya Eliminator...
Dialogue: 0,0:19:31.08,0:19:32.25,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:32.33,0:19:33.96,Default,,0,0,0,,әкелінді
Dialogue: 0,0:19:34.04,0:19:35.00,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:19:35.09,0:19:37.34,Default,,0,0,0,,Бақылауды ағаңызға қалдырыңыз.
Dialogue: 0,0:19:37.42,0:19:39.92,Default,,0,0,0,,Аа, маған қалдырыңыз.
Dialogue: 0,0:19:40.01,0:19:42.89,Default,,0,0,0,,Иә? Сіз не істемексіз?
Dialogue: 0,0:19:45.30,0:19:46.43,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:20:11.58,0:20:14.71,Default,,0,0,0,,ZiZi-Ortegia-мен сәтті қондыру
Dialogue: 0,0:20:18.71,0:20:20.01,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:20:21.34,0:20:22.93,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:20:25.47,0:20:27.35,Default,,0,0,0,,Мм...!
Dialogue: 0,0:20:33.39,0:20:35.23,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:39.86,0:20:42.15,Default,,0,0,0,,Қоқыс!
Dialogue: 0,0:20:42.24,0:20:43.45,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:20:58.25,0:21:02.26,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу
Dialogue: 0,0:21:10.72,0:21:12.14,Default,,0,0,0,,Фрейя жоғалып кетеді
Dialogue: 0,0:21:12.22,0:21:17.15,Default,,0,0,0,,(Топ мүшелерінің қошеметтері)
Dialogue: 0,0:21:22.32,0:21:23.40,Default,,0,0,0,,Я...
Dialogue: 0,0:21:24.70,0:21:25.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:31.37,0:21:32.24,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:21:33.58,0:21:34.50,Default,,0,0,0,,Не!?
Dialogue: 0,0:21:34.58,0:21:35.62,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:21:41.84,0:21:46.09,Default,,0,0,0,,Мен бұл соңғы кадрды осылай қолданамын деп ешқашан ойламадым...
Dialogue: 0,0:21:46.17,0:21:47.34,Default,,0,0,0,,Цк
Dialogue: 0,0:21:48.64,0:21:53.10,Default,,0,0,0,,Бұл олардың қабір белгісі болу үшін тым жарқыраған.
Dialogue: 0,0:21:54.22,0:21:56.44,Default,,0,0,0,,Бұл жер асты әлемінен келген кәдесый.
Dialogue: 0,0:21:57.85,0:21:59.27,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:22:01.36,0:22:03.28,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:22:03.36,0:22:06.45,Default,,0,0,0,,Неліктен сіз Дамоклді тастамақ болдыңыз?
Dialogue: 0,0:22:07.36,0:22:08.74,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:22:12.78,0:22:14.58,Default,,0,0,0,,Ол өзіне иелік етіп тұрған Триту рухын тесіп өтті
Dialogue: 0,0:22:14.66,0:22:16.46,Default,,0,0,0,,Бұл жағдай...
Dialogue: 0,0:22:17.08,0:22:18.62,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:22:20.38,0:22:23.75,Default,,0,0,0,,Дамокл бізге келді...
Dialogue: 0,0:22:25.71,0:22:28.47,Default,,0,0,0,,Құлап жатыр... келе жатыр...
Dialogue: 0,0:22:31.01,0:22:36.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:55.89,0:24:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory