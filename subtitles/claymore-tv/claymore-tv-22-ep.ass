Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.99,0:00:03.88,Default - Copy,Rigardo,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:00:04.53,0:00:05.38,Default - Copy,Rigardo,0,0,0,,отбасы құру
Dialogue: 0,0:00:05.99,0:00:06.89,Default - Copy,Rigardo,0,0,0,,Үш
Dialogue: 0,0:00:07.50,0:00:08.39,Default - Copy,Rigardo,0,0,0,,Төрт
Dialogue: 0,0:00:09.03,0:00:09.82,Default - Copy,Rigardo,0,0,0,,Бес
Dialogue: 0,0:00:10.33,0:00:12.27,Default - Copy,Rigardo,0,0,0,,Бес мықты адам
Dialogue: 0,0:00:13.07,0:00:17.87,Default - Copy,Rigardo,0,0,0,,Бұл бес адам жеке мүшелерді шайқасқа апара ма?
Dialogue: 0,0:00:19.87,0:00:21.11,Default - Copy,Easley,0,0,0,,Жын емес
Dialogue: 0,0:00:21.48,0:00:22.91,Default - Copy,Easley,0,0,0,,Оянған адам.
Dialogue: 0,0:00:23.34,0:00:25.28,Default - Copy,Easley,0,0,0,,Адамдар қандай болды
Dialogue: 0,0:00:29.15,0:00:30.55,Default - Copy,Miria,0,0,0,,Тым көп
Dialogue: 0,0:00:31.49,0:00:32.69,Default - Copy,Miria,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:00:39.53,0:00:41.90,Default - Copy,Helen,0,0,0,,А, қайда бардың?
Dialogue: 0,0:00:42.83,0:00:44.00,Default - Copy,Miria,0,0,0,,Не?
Dialogue: 0,0:00:44.00,0:00:45.03,Default - Copy,Clare,0,0,0,,бірдеңе
Dialogue: 0,0:00:46.03,0:00:49.50,Default - Copy,Clare,0,0,0,,Бір қорқынышты нәрсе келе жатыр.
Dialogue: 0,0:00:53.24,0:00:54.28,Default - Copy,Miria,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:00:56.54,0:00:59.38,Default - Copy,Miria,0,0,0,,Бұл Ригардо
Dialogue: 0,0:01:00.48,0:01:02.32,Default - Copy,Miria,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:01:03.05,0:01:04.12,Default - Copy,Miria,0,0,0,,Ригалдо
Dialogue: 0,0:01:07.76,0:01:09.36,Default - Copy,Helen,0,0,0,,Вероника
Dialogue: 0,0:01:11.06,0:01:12.56,Default - Copy,Deneve,0,0,0,,Артыңызда, капитан.
Dialogue: 0,0:01:16.13,0:01:17.67,Default - Copy,Rigardo,0,0,0,,Ол үлкен мәселе.
Dialogue: 0,0:01:18.47,0:01:19.20,Default - Copy,Rigardo,0,0,0,,Бірақ
Dialogue: 0,0:02:11.39,0:02:13.19,Default - Copy,Rigardo,0,0,0,,Маған артқа шегінуге рұқсат етіңіз.
Dialogue: 0,0:02:13.69,0:02:15.92,Default - Copy,Rigardo,0,0,0,,Мені ұсақ шабақтар қызықтырмайды.
Dialogue: 0,0:04:29.35,0:04:30.32,Default - Copy,Clare,0,0,0,,өлтіру
Dialogue: 0,0:04:31.12,0:04:32.15,Default - Copy,Clare,0,0,0,,Э? Қайда?
Dialogue: 0,0:04:34.09,0:04:36.76,Default - Copy,Rigardo,0,0,0,,Ол жақсы сөйлейді.
Dialogue: 0,0:04:44.00,0:04:46.67,Default - Copy,Rigardo,0,0,0,,Кешіріңіз, бірақ мен сізді өлуге рұқсат етемін.
Dialogue: 0,0:04:57.68,0:04:59.51,Default - Copy,Miria,0,0,0,,Клэр Денев
Dialogue: 0,0:04:59.51,0:05:00.48,Default - Copy,Helen,0,0,0,,Артқа қалыңыз.
Dialogue: 0,0:05:00.78,0:05:02.81,Default - Copy,Helen,0,0,0,,Оның нысанасы сенсің, Мирия.
Dialogue: 0,0:05:03.35,0:05:04.95,Default - Copy,Helen,0,0,0,,Барлығы жеңілді
Dialogue: 0,0:05:04.95,0:05:06.39,Default - Copy,Helen,0,0,0,,Барлық капитандар.
Dialogue: 0,0:05:06.85,0:05:08.12,Default - Copy,Helen,0,0,0,,Қарғыс атсын
Dialogue: 0,0:05:08.62,0:05:12.22,Default - Copy,Helen,0,0,0,,Мен сені кешірмеймін, тек сені ғана.
Dialogue: 0,0:05:12.22,0:05:14.03,Default - Copy,Helen,0,0,0,,Мен сенің өлуге жол бермеймін.
Dialogue: 0,0:05:25.70,0:05:26.94,Default - Copy,Clare,0,0,0,,Деневтен аулақ болыңыз
Dialogue: 0,0:05:29.37,0:05:30.31,Default - Copy,Deneve,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:37.58,0:05:38.92,Default - Copy,Rigardo,0,0,0,,Хо
Dialogue: 0,0:05:39.48,0:05:41.75,Default - Copy,Rigardo,0,0,0,,Ол дана адам.
Dialogue: 0,0:05:42.52,0:05:44.22,Default - Copy,Rigardo,0,0,0,,Көрінетін
Dialogue: 0,0:05:44.22,0:05:48.56,Default - Copy,Rigardo,0,0,0,,Мен сеземін деп айту дұрысырақ па?
Dialogue: 0,0:05:50.33,0:05:51.93,Default - Copy,Clare,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:05:52.66,0:05:53.93,Default - Copy,Clare,0,0,0,,Э? Қайда?
Dialogue: 0,0:06:18.52,0:06:19.63,Default - Copy,Priscilla,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:06:19.99,0:06:21.53,Default - Copy,Priscilla,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:21.53,0:06:22.93,Default - Copy,Priscilla,0,0,0,,Үлкен аға
Dialogue: 0,0:06:23.96,0:06:25.83,Default - Copy,Priscilla,0,0,0,,Үлкен әпке
Dialogue: 0,0:06:33.17,0:06:34.31,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:06:35.57,0:06:37.64,Default - Copy,Easley,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:06:43.58,0:06:46.02,Default - Copy,Easley,0,0,0,,Өйткені ол қайғылы болады.
Dialogue: 0,0:06:48.39,0:06:51.42,Default - Copy,Easley,0,0,0,,Бұлай таң қалудың қажеті жоқ.
Dialogue: 0,0:06:51.99,0:06:55.36,Default - Copy,Easley,0,0,0,,Ол үшін бұл қалыпты жағдай.
Dialogue: 0,0:06:59.60,0:07:01.60,Default - Copy,Easley,0,0,0,,Тамақ ішпей өмір сүре алмайсың
Dialogue: 0,0:07:02.80,0:07:08.07,Default - Copy,Easley,0,0,0,,Ол үшін бұл жай ғана адам болды.
Dialogue: 0,0:07:09.51,0:07:10.41,Default - Copy,Raki,0,0,0,,Бірақ
Dialogue: 0,0:07:12.38,0:07:14.48,Default - Copy,Easley,0,0,0,,Ол бала оянған адам.
Dialogue: 0,0:07:14.91,0:07:16.28,Default - Copy,Easley,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:07:17.75,0:07:19.65,Default - Copy,Raki,0,0,0,,Бұл Присцилла
Dialogue: 0,0:07:20.79,0:07:23.56,Default - Copy,Raki,0,0,0,,Прискила осыны қалайды ма?
Dialogue: 0,0:07:26.02,0:07:28.33,Default - Copy,Easley,0,0,0,,Мен оны да білмеймін.
Dialogue: 0,0:07:28.79,0:07:32.80,Default - Copy,Easley,0,0,0,,Бірақ бір жерде шайқаста ол өзінің шегінен шықты.
Dialogue: 0,0:07:34.00,0:07:36.50,Default - Copy,Easley,0,0,0,,Бұл балшықтардың тағдыры.
Dialogue: 0,0:07:36.50,0:07:39.37,Default - Copy,Raki,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:07:39.37,0:07:40.97,Default - Copy,Raki,0,0,0,,Қазір Клеймор деген не?
Dialogue: 0,0:07:41.54,0:07:42.24,Default - Copy,Easley,0,0,0,,Иә
Dialogue: 0,0:07:42.94,0:07:46.41,Default - Copy,Easley,0,0,0,,Оянған адамдар Клеймордың нәтижесі.
Dialogue: 0,0:07:50.15,0:07:51.18,Default - Copy,Raki,0,0,0,,Олай болса
Dialogue: 0,0:07:52.08,0:07:57.39,Default - Copy,Raki,0,0,0,,Присцилла әке, шеше және ағасына айтты.
Dialogue: 0,0:07:58.82,0:08:02.43,Default - Copy,Easley,0,0,0,,Адам болған кездегі естелік шығар.
Dialogue: 0,0:08:04.76,0:08:05.96,Default - Copy,Raki,0,0,0,,Адамдарға
Dialogue: 0,0:08:06.57,0:08:09.40,Default - Copy,Raki,0,0,0,,Прискила адам болып қайта орала алмайды ма?
Dialogue: 0,0:08:10.57,0:08:11.67,Default - Copy,Easley,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:08:15.04,0:08:18.11,Default - Copy,Easley,0,0,0,,Бұған қайта оралудың қажеті жоқ.
Dialogue: 0,0:08:19.75,0:08:21.98,Default - Copy,Raki,0,0,0,,Бірақ Прискила
Dialogue: 0,0:08:31.06,0:08:34.86,Default - Copy,Easley,0,0,0,,Мен оның дәл қазір қандай түс көріп жатқанын білмеймін.
Dialogue: 0,0:08:36.40,0:08:39.36,Default - Copy,Easley,0,0,0,,Оның тағдыры осылай болды.
Dialogue: 0,0:08:39.93,0:08:43.30,Default - Copy,Easley,0,0,0,,Сен де, менің де қолымнан ештеңе келмейді.
Dialogue: 0,0:08:50.68,0:08:52.74,Default - Copy,Easley,0,0,0,,Мен біраз уақыттан кейін осы жерден кетемін.
Dialogue: 0,0:08:53.65,0:08:56.28,Default - Copy,Easley,0,0,0,,Оған дейін жақсылап демалыңыз.
Dialogue: 0,0:08:58.78,0:09:02.12,Default - Copy,Raki,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:03.16,0:09:05.69,Default - Copy,Easley,0,0,0,,Біраз уақыттан кейін түсінесіз.
Dialogue: 0,0:09:05.69,0:09:07.13,Default - Copy,Easley,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,0:09:14.17,0:09:15.10,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:09:24.74,0:09:26.88,Default - Copy,Rigardo,0,0,0,,Ол ешқашан үйренбейтін адам.
Dialogue: 0,0:09:26.88,0:09:30.32,Default - Copy,Rigardo,0,0,0,,Тек абайсызда ішке кіру ештеңеге әкелмейді.
Dialogue: 0,0:09:35.82,0:09:36.62,Default - Copy,Clare,0,0,0,,Милия
Dialogue: 0,0:09:41.06,0:09:41.96,Default - Copy,Helen,0,0,0,,Жарайды
Dialogue: 0,0:09:42.36,0:09:43.76,Default - Copy,Rigardo,0,0,0,,Мен көремін.
Dialogue: 0,0:09:44.30,0:09:45.73,Default - Copy,Rigardo,0,0,0,,Бұл иллюзия ма?
Dialogue: 0,0:09:51.40,0:09:53.74,Default - Copy,Rigardo,0,0,0,,Капитанға тән жақсы қимыл.
Dialogue: 0,0:10:05.42,0:10:06.59,Default - Copy,Deneve,0,0,0,,Жоқ, Клэр.
Dialogue: 0,0:10:06.59,0:10:08.12,Default - Copy,Deneve,0,0,0,,Оны Мирияға қалдырыңыз.
Dialogue: 0,0:10:15.19,0:10:16.06,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:10:21.30,0:10:22.30,Default - Copy,Clare,0,0,0,,Денев
Dialogue: 0,0:10:23.10,0:10:24.24,Default - Copy,Clare,0,0,0,,Наранция Гилго 1984 жылы, Арыстан белгісінің астында дүниеге келген
Dialogue: 0,0:10:26.77,0:10:28.27,Default - Copy,Helen,0,0,0,,Денев Денев
Dialogue: 0,0:10:29.44,0:10:30.24,Default - Copy,Deneve,0,0,0,,Ақымақ
Dialogue: 0,0:10:31.21,0:10:32.41,Default - Copy,Deneve,0,0,0,,Өкінішті
Dialogue: 0,0:10:32.94,0:10:34.35,Default - Copy,Helen,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:10:34.35,0:10:35.18,Default - Copy,Helen,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:10:35.18,0:10:37.18,Default - Copy,Helen,0,0,0,,Жай ғана берілмеңіз
Dialogue: 0,0:10:42.25,0:10:43.59,Default - Copy,Deneve,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:10:44.19,0:10:46.63,Default - Copy,Deneve,0,0,0,,Милия мен Клэрге көмекке кел.
Dialogue: 0,0:10:47.06,0:10:48.96,Default - Copy,Deneve,0,0,0,,Ол екеуі өлмесін.
Dialogue: 0,0:10:49.36,0:10:50.40,Default - Copy,Helen,0,0,0,,Денев
Dialogue: 0,0:10:51.20,0:10:54.57,Default - Copy,Deneve,0,0,0,,Осы екеуі бұл шайқастың кілті.
Dialogue: 0,0:10:55.47,0:10:57.44,Default - Copy,Deneve,0,0,0,,Ұрыс нәтижесін шешу
Dialogue: 0,0:10:57.44,0:10:58.87,Default - Copy,Helen,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:10:58.87,0:11:01.87,Default - Copy,Helen,0,0,0,,Сондықтан сол жерде қалып, жараларыңызды емдеңіз.
Dialogue: 0,0:11:01.87,0:11:02.77,Default - Copy,Helen,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:11:11.48,0:11:13.85,Default - Copy,Deneve,0,0,0,,Қозғалмай отырыңыз.
Dialogue: 0,0:11:16.12,0:11:17.59,Default - Copy,Deneve,0,0,0,,Титанның денесіне киінген адам
Dialogue: 0,0:11:18.56,0:11:21.26,Default - Copy,Deneve,0,0,0,,15 саны мұны естіп шошып кетті.
Dialogue: 0,0:11:23.23,0:11:25.73,Default - Copy,Deneve,0,0,0,,«Жалғыз қобалжыма» дегеннің мәні неде?
Dialogue: 0,0:11:27.10,0:11:31.54,Default - Copy,Deneve,0,0,0,,Неліктен сенің достарың бар?
Dialogue: 0,0:11:38.88,0:11:43.11,Default - Copy,Deneve,0,0,0,,Undine-ны қорғаудан алыс,
Dialogue: 0,0:11:43.92,0:11:49.22,Default - Copy,Deneve,0,0,0,,Ол жау сізге зиян тигізе де алмайды.
Dialogue: 0,0:11:53.99,0:11:55.43,Default - Copy,Rigardo,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:11:56.49,0:11:57.73,Default - Copy,Helen,0,0,0,,Ақымақ
Dialogue: 0,0:11:57.73,0:12:00.30,Default - Copy,Helen,0,0,0,,Бұлай оған жақындай да алмайсың.
Dialogue: 0,0:12:04.44,0:12:05.50,Default - Copy,Clare,0,0,0,,Ол тез.
Dialogue: 0,0:12:05.80,0:12:09.51,Default - Copy,Clare,0,0,0,,Әлгі адам Мирияның иллюзиясына оңай ереді.
Dialogue: 0,0:12:10.11,0:12:14.31,Default - Copy,Clare,0,0,0,,Жоқ, Мирия әйтеуір оған ілесіп жүр ме?
Dialogue: 0,0:12:17.25,0:12:18.78,Default - Copy,Clare,0,0,0,,Жоқ, тым кеш.
Dialogue: 0,0:12:19.58,0:12:22.52,Default - Copy,Clare,0,0,0,,Менің денем неге сонша баяу?
Dialogue: 0,0:12:36.67,0:12:38.57,Default - Copy,Easley,0,0,0,,Бұл сіздің еркіндігіңіз
Dialogue: 0,0:12:38.57,0:12:39.80,Default - Copy,Easley,0,0,0,,Бұдан былай
Dialogue: 0,0:12:41.64,0:12:42.54,Default - Copy,Easley,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:12:54.29,0:12:57.39,Default - Copy,Easley,0,0,0,,Енді сол жерден өтсек
Dialogue: 0,0:12:57.39,0:12:58.52,Default - Copy,Easley,0,0,0,,Тырнақтарыңды қадалама.
Dialogue: 0,0:13:20.35,0:13:21.85,Default - Copy,Rigardo,0,0,0,,Не болды?
Dialogue: 0,0:13:21.85,0:13:23.78,Default - Copy,Rigardo,0,0,0,,Қозғалыс баяулады.
Dialogue: 0,0:13:24.15,0:13:26.15,Default - Copy,Rigardo,0,0,0,,Бұл шектеуге жақын ба?
Dialogue: 0,0:13:34.33,0:13:37.10,Default - Copy,Rigardo,0,0,0,,Сіз әлі де бара аласыз ба?
Dialogue: 0,0:13:45.77,0:13:48.27,Default - Copy,Rigardo,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:13:58.55,0:14:02.59,Default - Copy,Rigardo,0,0,0,,Одан толық құтылу мүмкін болмай қалды ма?
Dialogue: 0,0:14:04.06,0:14:05.52,Default - Copy,Rigardo,0,0,0,,Өте жаман.
Dialogue: 0,0:14:05.92,0:14:08.09,Default - Copy,Rigardo,0,0,0,,Аяқтауға жақын
Dialogue: 0,0:14:10.56,0:14:12.43,Default - Copy,Rigardo,0,0,0,,Кішкентай шабақтардың келуіне жол бермеңіз
Dialogue: 0,0:14:12.93,0:14:14.37,Default - Copy,Rigardo,0,0,0,,Қозуды жоғалту
Dialogue: 0,0:14:22.57,0:14:23.61,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:14:28.18,0:14:29.25,Default - Copy,Clare,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:29.25,0:14:30.28,Default - Copy,Clare,0,0,0,,Бұлай емес
Dialogue: 0,0:14:31.72,0:14:33.02,Default - Copy,Clare,0,0,0,,Жылдамырақ
Dialogue: 0,0:14:33.55,0:14:34.55,Default - Copy,Clare,0,0,0,,Түпнұсқа
Dialogue: 0,0:14:47.23,0:14:49.47,Default - Copy,civilian1,0,0,0,,Эй, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:49.47,0:14:51.34,Default - Copy,civilian1,0,0,0,,Ары қарай жүрме
Dialogue: 0,0:14:51.34,0:14:52.60,Default - Copy,Raki,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:14:52.60,0:14:54.61,Default - Copy,civilian1,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:14:54.61,0:14:56.61,Default - Copy,civilian1,0,0,0,,Бұл сенің мұндай жерде болатын уақыт емес.
Dialogue: 0,0:14:56.61,0:14:57.54,Default - Copy,civilian1,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:14:57.54,0:14:59.18,Default - Copy,Raki,0,0,0,,Қаш
Dialogue: 0,0:14:59.18,0:15:01.08,Default - Copy,civilian1,0,0,0,,Жын болуы керек
Dialogue: 0,0:15:01.08,0:15:03.05,Default - Copy,civilian1,0,0,0,,Олар көптеп пайда болды.
Dialogue: 0,0:15:03.48,0:15:05.52,Default - Copy,Easley,0,0,0,,Келген жақтан
Dialogue: 0,0:15:05.52,0:15:06.62,Default - Copy,Easley,0,0,0,,Бұл Пиета.
Dialogue: 0,0:15:07.55,0:15:09.92,Default - Copy,civilian1,0,0,0,,Клеймор да шайқаса алады.
Dialogue: 0,0:15:09.92,0:15:13.73,Default - Copy,civilian1,0,0,0,,Жоқ, жындардың саны аман қалуы мүмкін емес.
Dialogue: 0,0:15:13.73,0:15:14.59,Default - Copy,civilian1,0,0,0,,Иә.
Dialogue: 0,0:15:14.59,0:15:15.79,Default - Copy,civilian1,0,0,0,,Сіз де қашыңыз.
Dialogue: 0,0:15:15.79,0:15:16.86,Default - Copy,civilian1,0,0,0,,жүрегі жұмсақ жандар әлі де басқаларға көмектеседі ғой, иә?
Dialogue: 0,0:15:16.86,0:15:18.96,Default - Copy,civilian1,0,0,0,,Мен барлық адамдарды ең төменгі санға дейін жұмылдырамын.
Dialogue: 0,0:15:18.96,0:15:20.70,Default - Copy,civilian1,0,0,0,,Тым көп болса жарамайды
Dialogue: 0,0:15:21.80,0:15:23.00,Default - Copy,Raki,0,0,0,,Ең төменгі сан
Dialogue: 0,0:15:23.57,0:15:24.90,Default - Copy,Raki,0,0,0,,Бұл рас
Dialogue: 0,0:15:24.90,0:15:26.37,Default - Copy,civilian1,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:15:26.37,0:15:28.17,Default - Copy,civilian1,0,0,0,,Ендеше тез қашайық.
Dialogue: 0,0:15:33.08,0:15:34.08,Default - Copy,Raki,0,0,0,,Бұл Клэр.
Dialogue: 0,0:15:34.81,0:15:35.98,Default - Copy,Raki,0,0,0,,Клэр осында.
Dialogue: 0,0:15:50.16,0:15:54.23,Default - Copy,Clare,0,0,0,,Зақым келтіру кезінде тым көп сиқырлы күш қолданылды
Dialogue: 0,0:15:54.23,0:15:58.77,Default - Copy,Clare,0,0,0,,Мен бұл қобалжуды өзім тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:15:59.90,0:16:03.64,Default - Copy,Clare,0,0,0,,Демек, біз адам ретінде саналы болсақ,
Dialogue: 0,0:16:03.64,0:16:05.94,Default - Copy,Clare,0,0,0,,Өз өмірін қию
Dialogue: 0,0:16:09.08,0:16:10.82,Default - Copy,Raki,0,0,0,,Сол кезде мен оны тоқтатпасам
Dialogue: 0,0:16:11.62,0:16:12.75,Default - Copy,Raki,0,0,0,,Тіпті Клэр
Dialogue: 0,0:16:16.19,0:16:17.26,Default - Copy,Priscilla,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:16:17.62,0:16:18.72,Default - Copy,Priscilla,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:16:19.19,0:16:20.56,Default - Copy,Priscilla,0,0,0,,Үлкен аға
Dialogue: 0,0:16:21.63,0:16:23.43,Default - Copy,Priscilla,0,0,0,,Үлкен әпке
Dialogue: 0,0:16:29.00,0:16:29.87,Default - Copy,Easley,0,0,0,,Раки
Dialogue: 0,0:16:32.10,0:16:33.94,Default - Copy,Easley,0,0,0,,Күшсіздік - күнә
Dialogue: 0,0:16:41.05,0:16:42.41,Default - Copy,Clare,0,0,0,,Рақидан сұра
Dialogue: 0,0:16:42.85,0:16:43.98,Default - Copy,Clare,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:16:44.25,0:16:45.28,Default - Copy,Clare,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:16:45.68,0:16:46.85,Default - Copy,Clare,0,0,0,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:16:46.85,0:16:48.75,Default - Copy,Clare,0,0,0,,Мен адам санасынан хабардармын.
Dialogue: 0,0:16:55.16,0:16:55.86,Default - Copy,Raki,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:56.46,0:16:59.23,Default - Copy,Raki,0,0,0,,Мен енді жеңілгім келмейді
Dialogue: 0,0:17:22.35,0:17:24.12,Default - Copy,Easley,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:17:24.79,0:17:28.13,Default - Copy,Easley,0,0,0,,Жүр, біз де барайық.
Dialogue: 0,0:17:40.44,0:17:43.27,Default - Copy,Rigardo,0,0,0,,Егер сіз өтірік айтқыңыз келсе
Dialogue: 0,0:17:43.27,0:17:44.78,Default - Copy,Rigardo,0,0,0,,Өшірілген.
Dialogue: 0,0:17:57.39,0:18:01.36,Default - Copy,Rigardo,0,0,0,,Бұл жолы елес емес сияқты.
Dialogue: 0,0:18:03.19,0:18:04.43,Default - Copy,Clare,0,0,0,,Милия
Dialogue: 0,0:18:19.01,0:18:21.08,Default - Copy,Rigardo,0,0,0,,Оның басын кесіңіз
Dialogue: 0,0:18:21.61,0:18:22.95,Default - Copy,Rigardo,0,0,0,,Бітті
Dialogue: 0,0:18:32.29,0:18:33.19,Default - Copy,Clare,0,0,0,,Ақымақ
Dialogue: 0,0:18:34.06,0:18:35.76,Default - Copy,Clare,0,0,0,,Неліктен менің денем
Dialogue: 0,0:18:36.43,0:18:37.76,Default - Copy,Clare,0,0,0,,Өте баяу
Dialogue: 0,0:18:39.43,0:18:40.40,Default - Copy,Clare,0,0,0,,Ақымақ
Dialogue: 0,0:18:44.14,0:18:45.37,Default - Copy,Clare,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:18:45.77,0:18:47.44,Default - Copy,Clare,0,0,0,,Мен өлмеймін
Dialogue: 0,0:18:47.44,0:18:50.51,Default - Copy,Clare,0,0,0,,Мен міндетті түрде өмір сүремін және сенімен қайта қауышамын.
Dialogue: 0,0:18:51.58,0:18:53.48,Default - Copy,Clare,0,0,0,,Сондықтан Рақи да өлмейді.
Dialogue: 0,0:18:54.11,0:18:55.81,Default - Copy,Clare,0,0,0,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:18:56.18,0:18:58.05,Default - Copy,Clare,0,0,0,,Оған дейін аман қаласыз.
Dialogue: 0,0:18:59.02,0:19:00.12,Default - Copy,Clare,0,0,0,,Бұл уәде.
Dialogue: 0,0:19:02.45,0:19:04.12,Default - Copy,Raki,0,0,0,,(Дон) Дегенмен, сыртта бәрі де соншалықты алып, иә?
Dialogue: 0,0:19:04.12,0:19:05.26,Default - Copy,Raki,0,0,0,,Мен сенімен тірі кездесемін
Dialogue: 0,0:19:06.46,0:19:08.83,Default - Copy,Raki,0,0,0,,Сонымен, бұл жолы
Dialogue: 0,0:19:09.39,0:19:10.76,Default - Copy,Raki,0,0,0,,Мен оны қорғаймын
Dialogue: 0,0:19:25.81,0:19:26.84,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:46.56,0:19:48.47,Default - Copy,Clare,0,0,0,,Мен жылдамырақ болсам
Dialogue: 0,0:19:49.43,0:19:51.50,Default - Copy,Clare,0,0,0,,Ген де, флора да сақталды.
Dialogue: 0,0:19:53.30,0:19:54.67,Default - Copy,Clare,0,0,0,,Мен тағы
Dialogue: 0,0:19:56.81,0:19:58.11,Default - Copy,Clare,0,0,0,,Мен тағы
Dialogue: 0,0:19:58.98,0:19:59.74,Default - Copy,Clare,0,0,0,,Қосымша
Dialogue: 0,0:20:00.48,0:20:01.18,Default - Copy,Clare,0,0,0,,Қосымша
Dialogue: 0,0:20:01.95,0:20:02.78,Default - Copy,Clare,0,0,0,,Қосымша
Dialogue: 0,0:20:03.38,0:20:04.25,Default - Copy,Clare,0,0,0,,Қосымша
Dialogue: 0,0:20:05.78,0:20:07.32,Default - Copy,Clare,0,0,0,,Қосымша
Dialogue: 0,0:20:09.55,0:20:13.36,Default - Copy,Clare,0,0,0,,Мен көбірек
Dialogue: 0,0:20:35.55,0:20:36.68,Default - Copy,Rigardo,0,0,0,,Не?
Dialogue: 0,0:20:37.15,0:20:37.98,Default - Copy,Rigardo,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:21:02.17,0:21:05.71,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Толып жатқан мұң
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Толып жатқан құштарлық
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Арыстанның ақыруы
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory