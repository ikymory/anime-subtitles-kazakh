Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.62,0:00:09.32,Default - Copy,Yoma,0,0,0,,ақымақ
Dialogue: 0,0:00:09.92,0:00:11.06,Default - Copy,Yoma,0,0,0,,Не?
Dialogue: 0,0:00:11.62,0:00:13.83,Default - Copy,Yoma,0,0,0,,Бұл не?
Dialogue: 0,0:01:38.44,0:01:40.51,Default - Copy,man1,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:01:40.51,0:01:42.51,Default - Copy,man2,0,0,0,,Мен жынның ештеңе істеуіне жол бермедім.
Dialogue: 0,0:01:42.98,0:01:44.92,Default - Copy,man3,0,0,0,,Бұл балшық па?
Dialogue: 0,0:01:47.65,0:01:48.95,Default - Copy,man4,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:01:49.52,0:01:51.49,Default - Copy,man4,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:01:51.49,0:01:52.96,Default - Copy,man4,0,0,0,,Бұл өтемақы
Dialogue: 0,0:01:52.96,0:01:53.59,Default - Copy,Teresa,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:01:55.13,0:01:58.10,Default - Copy,Teresa,0,0,0,,Қара киінген күдікті адам кейінірек алып кетуге келеді.
Dialogue: 0,0:01:58.63,0:02:00.47,Default - Copy,Teresa,0,0,0,,Мен оны оған беремін.
Dialogue: 0,0:02:00.80,0:02:02.77,Default - Copy,man4,0,0,0,,Бұл жалғыз мүмкіндік емес
Dialogue: 0,0:02:02.77,0:02:06.67,Default - Copy,man4,0,0,0,,Байқаусызда дұрыс емес адамға беріп жіберсеңіз
Dialogue: 0,0:02:06.67,0:02:07.94,Default - Copy,Teresa,0,0,0,,Маған бәрібір
Dialogue: 0,0:02:08.34,0:02:12.31,Default - Copy,Teresa,0,0,0,,Егер сіз мұны жасасаңыз, ол жай ғана төлем болмаған сияқты қарастырылады.
Dialogue: 0,0:02:12.31,0:02:16.72,Default - Copy,Teresa,0,0,0,,Бұдан былай бұл ауылда қанша жын пайда болып, көмек сұраса да,
Dialogue: 0,0:02:16.72,0:02:18.85,Default - Copy,Teresa,0,0,0,,Біз оған жауап бермейміз.
Dialogue: 0,0:02:19.32,0:02:21.09,Default - Copy,Teresa,0,0,0,,Абайлаңыз.
Dialogue: 0,0:02:21.59,0:02:24.62,Default - Copy,Teresa,0,0,0,,Төлеуге құлықсыз ауылдар
Dialogue: 0,0:02:25.06,0:02:28.09,Default - Copy,Teresa,0,0,0,,Көптеген құбыжықтар жойылды
Dialogue: 0,0:02:28.66,0:02:31.10,Default - Copy,Teresa,0,0,0,,Мен мұны көп естимін.
Dialogue: 0,0:02:31.56,0:02:32.50,Default - Copy,man4,0,0,0,,Төлеу
Dialogue: 0,0:02:32.50,0:02:35.13,Default - Copy,man4,0,0,0,,Біз төлейтініміз күмәнсіз.
Dialogue: 0,0:02:35.73,0:02:36.64,Default - Copy,Teresa,0,0,0,,Иә.
Dialogue: 0,0:02:37.67,0:02:39.97,Default - Copy,Teresa,0,0,0,,Бұл дана таңдау
Dialogue: 0,0:02:47.08,0:02:51.85,Default - Copy,Orsay,0,0,0,,Бұл біз жындарды жіберіп жатқан сияқты.
Dialogue: 0,0:02:51.85,0:02:54.39,Default - Copy,Teresa,0,0,0,,Келесі пәрмен, Orce?
Dialogue: 0,0:02:55.82,0:02:58.36,Default - Copy,Orsay,0,0,0,,Бұл жерден батысқа қарай екі күн жүру керек.
Dialogue: 0,0:02:58.36,0:02:59.86,Default - Copy,Orsay,0,0,0,,Бұл О қаласы.
Dialogue: 0,0:03:00.43,0:03:01.99,Default - Copy,Teresa,0,0,0,,Басқа ақпарат бар ма?
Dialogue: 0,0:03:01.99,0:03:03.16,Default - Copy,Orsay,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:03:03.16,0:03:04.86,Default - Copy,Teresa,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:03:05.23,0:03:07.83,Default - Copy,Orsay,0,0,0,,Қанша болса да, қандай жағдай болса да.
Dialogue: 0,0:03:07.83,0:03:08.87,Default - Copy,Orsay,0,0,0,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:03:09.67,0:03:11.90,Default - Copy,Orsay,0,0,0,,Жынды тауып өлтір
Dialogue: 0,0:03:12.24,0:03:13.71,Default - Copy,Orsay,0,0,0,,Осымен
Dialogue: 0,0:03:13.71,0:03:15.74,Default - Copy,Teresa,0,0,0,,Түсіндім бастық
Dialogue: 0,0:03:21.08,0:03:24.82,Default - Copy,Orsay,0,0,0,,Ұйым жасаған жартылай адам, жартылай жын
Dialogue: 0,0:03:24.82,0:03:28.99,Default - Copy,Orsay,0,0,0,,Тереза, 77-ші кезеңдегі 182-ші жауынгер
Dialogue: 0,0:03:29.62,0:03:32.22,Default - Copy,Orsay,0,0,0,,Қандай жынмен күрессең де
Dialogue: 0,0:03:32.22,0:03:34.69,Default - Copy,Orsay,0,0,0,,Сиқырлы күш жібермей өлтіріңіз
Dialogue: 0,0:03:35.13,0:03:38.83,Default - Copy,Orsay,0,0,0,,Сондықтан оның жүзі көріксіз болып, бұрмаланбады.
Dialogue: 0,0:03:38.83,0:03:42.87,Default - Copy,Orsay,0,0,0,,Қуыршақтай жүзі бар жындарды шауып тастайтын сурет
Dialogue: 0,0:03:42.87,0:03:45.87,Default - Copy,Orsay,0,0,0,,Ол сәл жымиып тұрған сияқты екенін айтады.
Dialogue: 0,0:03:46.81,0:03:50.88,Default - Copy,Orsay,0,0,0,,Оның аты Тереза ​​Смайлз болды.
Dialogue: 0,0:03:51.38,0:03:55.15,Default - Copy,Orsay,0,0,0,,Клеймор деп аталатындардың ішіндегі ең күшті әйел.
Dialogue: 0,0:03:56.72,0:04:00.15,Default - Copy,Orsay,0,0,0,,Жоқ, ең күшті әйел емес.
Dialogue: 0,0:04:00.59,0:04:03.46,Default - Copy,Orsay,0,0,0,,Бұл ең күшті құбыжық.
Dialogue: 0,0:04:22.91,0:04:23.58,Default - Copy,man1,0,0,0,,Клеймор
Dialogue: 0,0:04:32.48,0:04:34.09,Default - Copy,Teresa,0,0,0,,Бірінші
Dialogue: 0,0:04:36.32,0:04:37.59,Default - Copy,man2,0,0,0,,Не?
Dialogue: 0,0:04:37.59,0:04:38.99,Default - Copy,man2,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:42.16,0:04:43.16,Default - Copy,Teresa,0,0,0,,Екінші жануар
Dialogue: 0,0:04:46.06,0:04:47.17,Default - Copy,man3,0,0,0,,Кісі өлтіруші
Dialogue: 0,0:04:47.17,0:04:49.40,Default - Copy,man3,0,0,0,,Клеймор адамдарды өлтіріп жатыр.
Dialogue: 0,0:04:49.80,0:04:51.04,Default - Copy,Teresa,0,0,0,,Үшінші жануар
Dialogue: 0,0:04:57.94,0:04:59.44,Default - Copy,man4,0,0,0,,Мен жындымын
Dialogue: 0,0:05:01.65,0:05:02.95,Default - Copy,Teresa,0,0,0,,Төртінші жануар
Dialogue: 0,0:05:19.80,0:05:21.70,Default - Copy,Teresa,0,0,0,,Кеш болды, солай емес пе?
Dialogue: 0,0:05:22.03,0:05:24.67,Default - Copy,Teresa,0,0,0,,Мені көрген сәттен бастап
Dialogue: 0,0:05:24.67,0:05:27.34,Default - Copy,Teresa,0,0,0,,Сіз барлық сиқырлы күштеріңізбен дайындалуыңыз керек.
Dialogue: 0,0:05:27.34,0:05:28.41,Default - Copy,Teresa,0,0,0,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:05:39.32,0:05:42.09,Default - Copy,Teresa,0,0,0,,Қалай тырыссаң да, мағынасыз.
Dialogue: 0,0:05:46.59,0:05:48.09,Default - Copy,Teresa,0,0,0,,Мәйіт
Dialogue: 0,0:05:48.09,0:05:49.09,Default - Copy,girl,0,0,0,,Барлығы
Dialogue: 0,0:05:49.09,0:05:50.43,Default - Copy,man5,0,0,0,,Жынға
Dialogue: 0,0:05:51.76,0:05:53.27,Default - Copy,Teresa,0,0,0,,Бұл бақытты қала
Dialogue: 0,0:05:53.87,0:05:57.44,Default - Copy,Teresa,0,0,0,,Мен жеті жынның осылай отырғанына сене алар емеспін.
Dialogue: 0,0:05:59.00,0:05:59.94,Default - Copy,Teresa,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:05:59.94,0:06:03.78,Default - Copy,Teresa,0,0,0,,Мен қаланың сыртынан сезіндім, жеті адам болса керек.
Dialogue: 0,0:06:04.14,0:06:06.21,Default - Copy,Teresa,0,0,0,,Қанша жануарды өлтірдің?
Dialogue: 0,0:06:06.78,0:06:07.95,Default - Copy,Teresa,0,0,0,,отбасы құру
Dialogue: 0,0:06:07.95,0:06:09.08,Default - Copy,Teresa,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:06:09.62,0:06:10.68,Default - Copy,Teresa,0,0,0,,Үш
Dialogue: 0,0:06:11.32,0:06:11.95,Default - Copy,Teresa,0,0,0,,Төрт
Dialogue: 0,0:06:12.95,0:06:13.89,Default - Copy,Teresa,0,0,0,,Бес
Dialogue: 0,0:06:14.49,0:06:15.69,Default - Copy,Teresa,0,0,0,,6
Dialogue: 0,0:06:15.69,0:06:16.62,Default - Copy,Teresa,0,0,0,,Бұл
Dialogue: 0,0:06:17.39,0:06:18.82,Default - Copy,Teresa,0,0,0,,Бір балық жетіспейді
Dialogue: 0,0:06:19.69,0:06:22.19,Default - Copy,Teresa,0,0,0,,Бір жерде
Dialogue: 0,0:06:22.89,0:06:24.40,Default - Copy,Teresa,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:06:24.40,0:06:25.86,Default - Copy,Teresa,0,0,0,,Табылмады
Dialogue: 0,0:06:25.86,0:06:27.13,Default - Copy,Teresa,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:29.57,0:06:31.14,Default - Copy,Teresa,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:06:35.17,0:06:38.11,Default - Copy,Teresa,0,0,0,,Сонда сіз балаңызды қалқан ретінде пайдаланғыңыз келе ме?
Dialogue: 0,0:06:41.01,0:06:42.08,Default - Copy,Teresa,0,0,0,,Бұл тәтті
Dialogue: 0,0:07:11.18,0:07:12.94,Default - Copy,Teresa,0,0,0,,Боқ, жиіркенішті
Dialogue: 0,0:07:19.05,0:07:21.59,Default - Copy,Teresa,0,0,0,,Бұл ең тыныштандыратын нәрсе ме?
Dialogue: 0,0:07:28.89,0:07:29.96,Default - Copy,man1,0,0,0,,Құрметті Тереза
Dialogue: 0,0:07:30.86,0:07:35.47,Default - Copy,man1,0,0,0,,Міне, бұл сенің жын-шайтанды жойғаның үшін сыйлығың.
Dialogue: 0,0:07:35.80,0:07:38.54,Default - Copy,Teresa,0,0,0,,Кейінірек қара киім киген адам келеді.
Dialogue: 0,0:07:38.54,0:07:39.81,Default - Copy,Teresa,0,0,0,,Оған беріңіз.
Dialogue: 0,0:07:48.28,0:07:49.25,Default - Copy,man2,0,0,0,,Эй
Dialogue: 0,0:07:49.78,0:07:51.02,Default - Copy,man2,0,0,0,,Ә? Мүмкін емес! Не болып жатыр?!
Dialogue: 0,0:07:55.45,0:07:57.16,Default - Copy,Teresa,0,0,0,,Бұл не?
Dialogue: 0,0:07:57.59,0:08:00.76,Default - Copy,Teresa,0,0,0,,Есімде болса, соңғы рет өлтірген жынның баласы еді.
Dialogue: 0,0:08:01.33,0:08:04.16,Default - Copy,Teresa,0,0,0,,Өлтірген әкең үшін кек алғың келе ме?
Dialogue: 0,0:08:04.16,0:08:05.10,Default - Copy,man1,0,0,0,,Жоқ
Dialogue: 0,0:08:05.10,0:08:08.50,Default - Copy,man1,0,0,0,,Сондықтан бұл бала бұл қаладан емес.
Dialogue: 0,0:08:08.80,0:08:13.27,Default - Copy,man1,0,0,0,,Оның үстіне өлтірілген жынмен ата-ана мен бала қарым-қатынасы болмаған сияқты.
Dialogue: 0,0:08:13.87,0:08:15.17,Default - Copy,Teresa,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:08:15.17,0:08:18.51,Default - Copy,man1,0,0,0,,Мен сөйлей алмайтындықтан анық білмеймін.
Dialogue: 0,0:08:18.51,0:08:22.11,Default - Copy,man1,0,0,0,,Қыз ол кісінің жын екенін біледі.
Dialogue: 0,0:08:22.11,0:08:25.18,Default - Copy,man1,0,0,0,,Жын оны күшпен айдап әкетті.
Dialogue: 0,0:08:25.18,0:08:28.19,Default - Copy,man1,0,0,0,,Мен бұл қалаға кездейсоқ келдім бе деп ойлаймын.
Dialogue: 0,0:08:28.19,0:08:31.19,Default - Copy,Teresa,0,0,0,,Сіз сөйлей алмасаңыз да, мұны қайдан білесіз?
Dialogue: 0,0:08:31.79,0:08:32.79,Default - Copy,man1,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:08:33.19,0:08:38.06,Default - Copy,man1,0,0,0,,Лайокороның денесінде зорлық-зомбылықтан қалған сансыз тыртықтар болды.
Dialogue: 0,0:08:38.53,0:08:39.50,Default - Copy,Teresa,0,0,0,,Мен көремін.
Dialogue: 0,0:08:39.80,0:08:42.20,Default - Copy,Teresa,0,0,0,,Сонда бұл құбыжықтың ойыншығы болды ма?
Dialogue: 0,0:08:42.60,0:08:46.54,Default - Copy,Teresa,0,0,0,,Мен сенің құтқарушыңмын деп ойлаймын.
Dialogue: 0,0:08:46.91,0:08:48.14,Default - Copy,Teresa,0,0,0,,Бірақ бұл жаман.
Dialogue: 0,0:08:48.94,0:08:51.48,Default - Copy,Teresa,0,0,0,,Мен сені құтқармадым
Dialogue: 0,0:08:51.98,0:08:54.58,Default - Copy,Teresa,0,0,0,,Мен жаңа ғана жұмыс үшін жын өлтірдім.
Dialogue: 0,0:08:55.11,0:08:56.55,Default - Copy,Teresa,0,0,0,,Тамаша!
Dialogue: 0,0:09:00.55,0:09:02.09,Default - Copy,Teresa,0,0,0,,Қандай еліктеу?
Dialogue: 0,0:09:07.43,0:09:09.13,Default - Copy,Teresa,0,0,0,,Сағынышқа бой алдырмаңдар деймін.
Dialogue: 0,0:09:09.83,0:09:12.80,Default - Copy,Teresa,0,0,0,,Мен сіз ойлағандай құтқарушы емеспін
Dialogue: 0,0:09:14.87,0:09:16.64,Default - Copy,Teresa,0,0,0,,Бұл не?
Dialogue: 0,0:09:16.94,0:09:18.44,Default - Copy,Teresa,0,0,0,,Сен жындысың ба?
Dialogue: 0,0:09:18.44,0:09:19.37,Default - Copy,man1,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:09:19.74,0:09:22.81,Default - Copy,man1,0,0,0,,Жын-шайтандар мені ұзақ уақыт езгендіктен ғана.
Dialogue: 0,0:09:22.81,0:09:26.95,Default - Copy,man1,0,0,0,,Мен сені қатты жақсы көруім керек еді, тіпті сөйлей алмаймын.
Dialogue: 0,0:09:28.28,0:09:29.18,Default - Copy,Teresa,0,0,0,,Эй
Dialogue: 0,0:09:29.78,0:09:32.92,Default - Copy,Teresa,0,0,0,,Егер сіз тағы бір қадам жақындасаңыз, мен сізді бұл жолы қатты соққыға аламын.
Dialogue: 0,0:09:32.92,0:09:35.39,Default - Copy,Teresa,0,0,0,,Мен саңырау емеспін.
Dialogue: 0,0:09:35.72,0:09:37.42,Default - Copy,man2,0,0,0,,Сені өлтіреді, анау бала.
Dialogue: 0,0:09:37.76,0:09:39.36,Default - Copy,man3,0,0,0,,Біреу маған көмектесуін өтінемін
Dialogue: 0,0:09:39.36,0:09:40.26,Default - Copy,man4,0,0,0,,Ақымақ болма.
Dialogue: 0,0:09:40.26,0:09:41.93,Default - Copy,man4,0,0,0,,Қатысқаным үшін кешірім сұраймын.
Dialogue: 0,0:09:41.93,0:09:43.40,Default - Copy,man5,0,0,0,,Себебі мен саған көмектестім
Dialogue: 0,0:09:43.40,0:09:45.53,Default - Copy,man5,0,0,0,,Саған қарайтын ешкім жоқ.
Dialogue: 0,0:09:45.53,0:09:48.07,Default - Copy,man6,0,0,0,,Сізге жын әкелген қыз.
Dialogue: 0,0:09:48.07,0:09:50.67,Default - Copy,man6,0,0,0,,Ешкім тепкілеп өлтіреді деп шағымданбайды.
Dialogue: 0,0:09:57.48,0:09:59.44,Default - Copy,Teresa,0,0,0,,Оны қызықсыз етіңіз
Dialogue: 0,0:10:00.38,0:10:03.25,Default - Copy,Teresa,0,0,0,,Соңғысы сұралғаннан басқаша болып көрінеді.
Dialogue: 0,0:10:03.25,0:10:04.55,Default - Copy,Teresa,0,0,0,,Мен сізге қызмет етемін.
Dialogue: 0,0:10:06.72,0:10:07.82,Default - Copy,Teresa,0,0,0,,Жақсы, онда
Dialogue: 0,0:10:07.82,0:10:09.65,Default - Copy,Teresa,0,0,0,,Бұл қала қосулы
Dialogue: 0,0:10:33.45,0:10:36.82,Default - Copy,Teresa,0,0,0,,Мен сізді осы уақытқа дейін жеткізген физикалық күшіңіз үшін мақтаймын.
Dialogue: 0,0:10:36.82,0:10:39.08,Default - Copy,Teresa,0,0,0,,Маған ерген ұнамайды.
Dialogue: 0,0:10:39.78,0:10:40.99,Default - Copy,Teresa,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:10:41.35,0:10:43.89,Default - Copy,Teresa,0,0,0,,Мен жаңа ғана жұмыс үшін құбыжықты өлтірдім.
Dialogue: 0,0:10:43.89,0:10:46.09,Default - Copy,Teresa,0,0,0,,Мен сені сен үшін өлтірген жоқпын.
Dialogue: 0,0:10:46.69,0:10:49.33,Default - Copy,Teresa,0,0,0,,Сүйгені ренжітеді.
Dialogue: 0,0:10:50.20,0:10:54.23,Default - Copy,Teresa,0,0,0,,Неге мені қазір бермейсің?
Dialogue: 0,0:11:01.54,0:11:02.34,Default - Copy,Teresa,0,0,0,,Жын
Dialogue: 0,0:11:02.77,0:11:04.68,Default - Copy,Teresa,0,0,0,,Ақымақ рух сияқты
Dialogue: 0,0:11:09.08,0:11:10.25,Default - Copy,Teresa,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:11:15.42,0:11:16.15,Default - Copy,Teresa,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:11:19.32,0:11:20.46,Default - Copy,bandit1,0,0,0,,Клеймор
Dialogue: 0,0:11:20.46,0:11:22.13,Default - Copy,bandit2,0,0,0,,Күміс көзді бақсы?
Dialogue: 0,0:11:22.13,0:11:23.50,Default - Copy,Teresa,0,0,0,,Ұры?
Dialogue: 0,0:11:24.66,0:11:27.17,Default - Copy,Teresa,0,0,0,,Кешіріңіз, бірақ қабылданатын ештеңе жоқ.
Dialogue: 0,0:11:27.87,0:11:29.94,Default - Copy,Teresa,0,0,0,,Мына кісіні тез емде.
Dialogue: 0,0:11:30.34,0:11:32.14,Default - Copy,Teresa,0,0,0,,Осылай жүре берсең, өміріңнен айырыласың.
Dialogue: 0,0:11:32.97,0:11:36.51,Default - Copy,leader,0,0,0,,Ол өз өмірін жоғалтса ыңғайсыз ба?
Dialogue: 0,0:11:37.64,0:11:42.15,Default - Copy,leader,0,0,0,,Мен мұндай жерде күміс көзді сиқыршыны кездестіремін деп ойламадым.
Dialogue: 0,0:11:42.55,0:11:45.38,Default - Copy,leader,0,0,0,,Оның үстіне ол көрнекті әйел.
Dialogue: 0,0:11:46.05,0:11:49.85,Default - Copy,bandit3,0,0,0,,Басы Қарсылас сол күміс көзді өлтіруші.
Dialogue: 0,0:11:49.85,0:11:51.72,Default - Copy,bandit3,0,0,0,,Мұндай қауіпті адам
Dialogue: 0,0:11:51.72,0:11:53.29,Default - Copy,leader,0,0,0,,Маған бәрібір
Dialogue: 0,0:11:53.29,0:11:55.39,Default - Copy,leader,0,0,0,,Мен мұны бұрын естігенмін.
Dialogue: 0,0:11:56.33,0:12:00.43,Default - Copy,leader,0,0,0,,Клейморс адамдарды өлтіре алмайды.
Dialogue: 0,0:12:01.03,0:12:03.27,Default - Copy,leader,0,0,0,,Оның үстіне бұл темір тұлпар.
Dialogue: 0,0:12:03.27,0:12:07.87,Default - Copy,leader,0,0,0,,Ешбір себеп немесе апатқа жол берілмейді.
Dialogue: 0,0:12:08.21,0:12:11.61,Default - Copy,leader,0,0,0,,Ұстамды бұзсаң, серіктерің басыңды кесіп алады.
Dialogue: 0,0:12:12.38,0:12:15.18,Default - Copy,leader,0,0,0,,Жартылай адам, жартылай жын
Dialogue: 0,0:12:15.18,0:12:17.82,Default - Copy,leader,0,0,0,,Жиренетін және қорқатындардың
Dialogue: 0,0:12:17.82,0:12:22.95,Default - Copy,leader,0,0,0,,Бұл, былайша айтқанда, біреудің жағында екеніңді дәлелдейтін бірден-бір және ең үлкен дәлел.
Dialogue: 0,0:12:23.39,0:12:24.56,Default - Copy,bandit4,0,0,0,,Бір айдан кейін
Dialogue: 0,0:12:24.56,0:12:27.53,Default - Copy,bandit5,0,0,0,,Олай болса, қорқуымызға негіз жоқ.
Dialogue: 0,0:12:27.53,0:12:30.93,Default - Copy,bandit4,0,0,0,,Олар нысанаға түсуден қорқуы керек.
Dialogue: 0,0:12:31.96,0:12:33.80,Default - Copy,bandit4,0,0,0,,Сен жақсы әйел емессің бе?
Dialogue: 0,0:12:33.80,0:12:35.17,Default - Copy,bandit4,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:12:42.41,0:12:45.08,Default - Copy,Teresa,0,0,0,,Сіз осылай ойлайсыз ба?
Dialogue: 0,0:12:45.68,0:12:49.15,Default - Copy,Teresa,0,0,0,,Маған әу бастан осылай айтсаң, менде қарсылық болмас еді.
Dialogue: 0,0:12:54.09,0:12:57.66,Default - Copy,Teresa,0,0,0,,Егер сіз осындай денеге жарассаңыз, менімен не қаласаңыз, соны істеймін.
Dialogue: 0,0:13:00.23,0:13:04.36,Default - Copy,Teresa,0,0,0,,Бұл сіз Клеймор деп атайтын біздің денеміз.
Dialogue: 0,0:13:05.50,0:13:07.67,Default - Copy,Teresa,0,0,0,,Егер сізге ұнаса, сіз өзіңізге ұнайтын нәрсені жасай аласыз.
Dialogue: 0,0:13:09.30,0:13:10.24,Default - Copy,bandit5,0,0,0,,Наурузе
Dialogue: 0,0:13:10.24,0:13:11.07,Default - Copy,bandit5,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:14.14,0:13:15.01,Default - Copy,leader,0,0,0,,Кеттік
Dialogue: 0,0:13:16.07,0:13:17.94,Default - Copy,leader,0,0,0,,Біреу Ригтің денесін қолдауы керек.
Dialogue: 0,0:13:18.94,0:13:19.98,Default - Copy,bandit6,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:13:19.98,0:13:20.91,Default - Copy,Rig,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:20.91,0:13:22.81,Default - Copy,Rig,0,0,0,,Есіңде болсын, құбыжық.
Dialogue: 0,0:13:26.18,0:13:27.62,Default - Copy,Teresa,0,0,0,,Сен де жоғалып кетесің
Dialogue: 0,0:13:27.92,0:13:28.75,Default - Copy,Teresa,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:13:30.32,0:13:33.89,Default - Copy,Teresa,0,0,0,,Өйткені, құбыжықтар балаларды қорғай алмайды.
Dialogue: 0,0:13:37.10,0:13:38.50,Default - Copy,Teresa,0,0,0,,Енді менің артымнан ерме
Dialogue: 0,0:13:58.28,0:14:00.39,Default - Copy,Teresa,0,0,0,,Ол менің артымнан жиі жүреді.
Dialogue: 0,0:14:00.95,0:14:04.62,Default - Copy,Teresa,0,0,0,,Бірақ бұл өз шегіне жетуге жақын.
Dialogue: 0,0:14:14.67,0:14:17.87,Default - Copy,Teresa,0,0,0,,Кешіріңіз, бірақ мен сізбен мәңгілік айналыса алмаймын.
Dialogue: 0,0:14:18.70,0:14:19.77,Default - Copy,Teresa,0,0,0,,Ендігіде Дио менің денеме не істесе де—
Dialogue: 0,0:14:47.97,0:14:51.10,Default - Copy,Teresa,0,0,0,,Жарайды, есіңді жоғалтсаң, менімен келе алмайсың.
Dialogue: 0,0:14:52.04,0:14:54.41,Default - Copy,Teresa,0,0,0,,Бұл қуудың соңы.
Dialogue: 0,0:14:54.81,0:14:57.64,Default - Copy,Teresa,0,0,0,,Неге менің артымнан бұлай жүрмексің?
Dialogue: 0,0:15:09.32,0:15:10.42,Default - Copy,Teresa,0,0,0,,Ақымақ
Dialogue: 0,0:15:10.99,0:15:13.79,Default - Copy,Teresa,0,0,0,,Егер мен осыдан өлсем, бұл менің кінәм бола ма?
Dialogue: 0,0:15:14.33,0:15:16.56,Default - Copy,Teresa,0,0,0,,Бұрынғы ұры да көрді.
Dialogue: 0,0:15:19.13,0:15:21.43,Default - Copy,Teresa,0,0,0,,Ол мүлдем тітіркендіргіш.
Dialogue: 0,0:15:32.31,0:15:34.28,Default - Copy,Teresa,0,0,0,,Ояусың ба, балақай?
Dialogue: 0,0:15:35.65,0:15:37.32,Default - Copy,Teresa,0,0,0,,Бұл әзірге ауыз су.
Dialogue: 0,0:15:37.85,0:15:41.99,Default - Copy,Teresa,0,0,0,,Ол жерден құлап, есінен танып қалған қыздан гөрі сусыз қызға ұқсайды.
Dialogue: 0,0:15:45.69,0:15:48.06,Default - Copy,Teresa,0,0,0,,Ал сен сасықсың.
Dialogue: 0,0:15:48.73,0:15:51.40,Default - Copy,Teresa,0,0,0,,Ол қалада денеңді де жуа алмадың ба?
Dialogue: 0,0:15:52.06,0:15:54.90,Default - Copy,Teresa,0,0,0,,Жынның қаны суға шомылғандай иіс шығарады.
Dialogue: 0,0:15:55.70,0:15:57.47,Default - Copy,Teresa,0,0,0,,Киіміңізді және денеңізді жақсылап жуыңыз.
Dialogue: 0,0:16:01.94,0:16:03.21,Default - Copy,Teresa,0,0,0,,Мен көремін.
Dialogue: 0,0:16:03.71,0:16:08.38,Default - Copy,Teresa,0,0,0,,Қала тұрғындары жын әкелген жас қыздан шошып кетті.
Dialogue: 0,0:16:08.38,0:16:11.22,Default - Copy,Teresa,0,0,0,,Мен тіпті денемді де жуған жоқпын.
Dialogue: 0,0:16:11.72,0:16:18.22,Default - Copy,Teresa,0,0,0,,Тіпті жын-перілер қалдырған тыртықтар да тұрғындар үшін қорқынышты нысан болып табылады.
Dialogue: 0,0:16:20.56,0:16:21.76,Default - Copy,Teresa,0,0,0,,Жейтін бірдеңе бар
Dialogue: 0,0:16:22.33,0:16:23.90,Default - Copy,Teresa,0,0,0,,Аш болсаң, же.
Dialogue: 0,0:16:30.94,0:16:33.91,Default - Copy,Teresa,0,0,0,,Мен үй жануарларын ұстай бастағандай болдым.
Dialogue: 0,0:16:36.41,0:16:38.38,Default - Copy,Teresa,0,0,0,,Не болды?
Dialogue: 0,0:16:44.82,0:16:46.45,Default - Copy,Teresa,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:46.45,0:16:47.95,Default - Copy,Teresa,0,0,0,,Мұның бәрі сіз үшін.
Dialogue: 0,0:16:47.95,0:16:49.42,Default - Copy,Teresa,0,0,0,,Уайымдамай тамақтаныңыз
Dialogue: 0,0:16:51.42,0:16:52.89,Default - Copy,Teresa,0,0,0,,Бұл рас
Dialogue: 0,0:16:53.26,0:16:56.83,Default - Copy,Teresa,0,0,0,,Қалай ойлайсың, мен сені ұстай аламын ба?
Dialogue: 0,0:17:00.67,0:17:04.17,Default - Copy,Teresa,0,0,0,,Маа, үй жануарынан жақсырақ сияқты.
Dialogue: 0,0:17:06.14,0:17:10.17,Default - Copy,Teresa,0,0,0,,Әзірше мен сені келесі қалаға апарамын.
Dialogue: 0,0:17:10.88,0:17:15.18,Default - Copy,Teresa,0,0,0,,Мен сені осылай тастап кетсем, сен өліп, мені кінәлайтын шығарсың.
Dialogue: 0,0:17:18.18,0:17:20.25,Default - Copy,Teresa,0,0,0,,Ендеше бүгін тыныш ұйықтаңыз.
Dialogue: 0,0:17:20.89,0:17:23.19,Default - Copy,Teresa,0,0,0,,Соңғы уақытта жақсы ұйықтамадың.
Dialogue: 0,0:17:24.32,0:17:25.69,Default - Copy,Teresa,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:17:26.36,0:17:28.66,Default - Copy,Teresa,0,0,0,,Сіз ұйықтап жатқанда ол жоғалып кетпейді.
Dialogue: 0,0:17:39.64,0:17:41.31,Default - Copy,Teresa,0,0,0,,Мен саған таңғы ас әкелдім.
Dialogue: 0,0:17:41.91,0:17:42.64,Default - Copy,Teresa,0,0,0,,Тамақ ішеді
Dialogue: 0,0:17:44.38,0:17:46.84,Default - Copy,Teresa,0,0,0,,Адамдар өте қиын.
Dialogue: 0,0:17:47.55,0:17:50.55,Default - Copy,Teresa,0,0,0,,Өйткені мен күніне екі-үш рет тамақтанамын.
Dialogue: 0,0:17:52.25,0:17:52.85,Default - Copy,Teresa,0,0,0,,Эй
Dialogue: 0,0:17:53.48,0:17:54.32,Default - Copy,Teresa,0,0,0,,Не?
Dialogue: 0,0:17:56.99,0:17:58.12,Default - Copy,Teresa,0,0,0,,О... дұрыс.
Dialogue: 0,0:17:58.59,0:18:02.06,Default - Copy,Teresa,0,0,0,,Айттым ғой, мен ұйықтап жатқанда ол жоғалып кетпейді.
Dialogue: 0,0:18:02.59,0:18:05.86,Default - Copy,Teresa,0,0,0,,Мен өтірік айтпаймын және керегі де жоқ.
Dialogue: 0,0:18:06.33,0:18:08.60,Default - Copy,Teresa,0,0,0,,Сондықтан менің сөзіме сеніңіз
Dialogue: 0,0:18:08.60,0:18:09.47,Default - Copy,Teresa,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:18:15.11,0:18:18.04,Default - Copy,Teresa,0,0,0,,Мен неге осылай күлуім керек?
Dialogue: 0,0:18:58.05,0:18:59.05,Default - Copy,Teresa,0,0,0,,Абайлаңыз
Dialogue: 0,0:18:59.05,0:19:00.45,Default - Copy,Teresa,0,0,0,,Табаны нәзік.
Dialogue: 0,0:19:12.76,0:19:15.70,Default - Copy,Teresa,0,0,0,,Тамақ ішкеннен кейін балшық сияқты ұйықтайсыз ба?
Dialogue: 0,0:19:16.93,0:19:18.17,Default - Copy,Teresa,0,0,0,,Таңқаларлық емес
Dialogue: 0,0:19:18.80,0:19:21.51,Default - Copy,Teresa,0,0,0,,Бала ілесе алатындай жылдам емес
Dialogue: 0,0:19:22.31,0:19:23.71,Default - Copy,Teresa,0,0,0,,Маған жиі жазылыңыз
Dialogue: 0,0:19:24.24,0:19:25.54,Default - Copy,Teresa,0,0,0,,Бұл біртүрлі нәрсе.
Dialogue: 0,0:19:25.98,0:19:28.25,Default - Copy,Teresa,0,0,0,,Менің соңынан еру үшін неге сонша әрекет етесің?
Dialogue: 0,0:19:28.95,0:19:34.69,Default - Copy,Teresa,0,0,0,,Мен үмітсіз жабысып жатырмын деп ойлаймын, өйткені менде сенім артатын ешкім жоқ.
Dialogue: 0,0:19:35.02,0:19:41.19,Default - Copy,Teresa,0,0,0,,Менен басқа жабысатын ешкімі жоқ бұл жігітке ғана өкінішті.
Dialogue: 0,0:19:41.96,0:19:43.93,Default - Copy,Teresa,0,0,0,,Адамды таңдауда қателестің.
Dialogue: 0,0:19:45.20,0:19:51.20,Default - Copy,Teresa,0,0,0,,Егер мен ең болмағанда кәдімгі адамға жабыссам, мен одан да лайықты жерде ұйықтар едім.
Dialogue: 0,0:19:52.60,0:19:56.81,Default - Copy,Teresa,0,0,0,,Өйткені, мен саған ештеңе істей алмаймын.
Dialogue: 0,0:20:03.11,0:20:04.88,Default - Copy,Teresa,0,0,0,,Эй, дайынсың ба?
Dialogue: 0,0:20:05.25,0:20:05.88,Default - Copy,Teresa,0,0,0,,Кеттік
Dialogue: 0,0:20:09.15,0:20:11.02,Default - Copy,Teresa,0,0,0,,Мен сенің атыңды білмеймін.
Dialogue: 0,0:20:11.56,0:20:14.39,Default - Copy,Teresa,0,0,0,,Мұнда мәңгі болу ыңғайсыз.
Dialogue: 0,0:20:17.20,0:20:19.23,Default - Copy,Teresa,0,0,0,,Жарайды, өзіңізді қатты итермеңіз.
Dialogue: 0,0:20:19.86,0:20:22.77,Default - Copy,Teresa,0,0,0,,Мен де кейіпкерлерді дұрыс жаза алмайтын сияқтымын.
Dialogue: 0,0:20:23.94,0:20:26.44,Default - Copy,Teresa,0,0,0,,Мен оны қолданамын, сондықтан оны өз бетімше қосамын.
Dialogue: 0,0:20:27.21,0:20:28.94,Default - Copy,Teresa,0,0,0,,That's right.
Dialogue: 0,0:20:32.64,0:20:33.38,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:20:34.05,0:20:35.61,Default - Copy,Teresa,0,0,0,,Клэр ше?
Dialogue: 0,0:20:42.22,0:20:43.22,Default - Copy,Teresa,0,0,0,,Не?
Dialogue: 0,0:20:43.96,0:20:46.39,Default - Copy,Teresa,0,0,0,,Бұл шынымен сіздің атыңыз ба?
Dialogue: 0,0:20:49.76,0:20:51.53,Default - Copy,Teresa,0,0,0,,Бұл рас па?
Dialogue: 0,0:20:51.53,0:20:52.90,Default - Copy,Teresa,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:20:54.20,0:20:58.90,Default - Copy,Teresa,0,0,0,,Сұлу, таза, махаббатқа толы егіз құдайлардың аты.
Dialogue: 0,0:21:00.81,0:21:03.51,Default - Copy,Teresa,0,0,0,,Айтпақшы, басқа аты Тереза.
Dialogue: 0,0:21:03.51,0:21:04.68,Default - Copy,Teresa,0,0,0,,Бұл менің атым.
Dialogue: 0,0:21:05.88,0:21:09.35,Default - Copy,Teresa,0,0,0,,Осылай өсірер деген үмітпен қойылған есім болса керек.
Dialogue: 0,0:21:11.62,0:21:14.02,Default - Copy,Teresa,0,0,0,,Екеумізді де ата-анамыз жақсы көретін.
Dialogue: 0,0:21:15.72,0:21:16.49,Default - Copy,Teresa,0,0,0,,Жылама
Dialogue: 0,0:21:17.72,0:21:21.43,Default - Copy,Teresa,0,0,0,,Қайтыс болған әке-шешемнің сезімі сол есімде мәңгі сақталады.
Dialogue: 0,0:21:22.59,0:21:24.60,Default - Copy,Teresa,0,0,0,,Олай болса, кеттік, Клэр.
Dialogue: 0,0:22:40.40,0:22:42.77,Default - Copy,,0,0,0,,Жалғыз жан әйел
Dialogue: 0,0:22:42.77,0:22:44.71,Default - Copy,,0,0,0,,Жалғыз жан қыз
Dialogue: 0,0:22:46.21,0:22:52.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory