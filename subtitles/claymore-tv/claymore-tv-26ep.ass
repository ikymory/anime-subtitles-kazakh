Dialogue: 0,0:12:23.25,0:12:24.15,Default - Copy,Jeane,0,0,0,,Артыңа шегін!
Dialogue: 0,0:12:24.75,0:12:26.38,Default - Copy,Jeane,0,0,0,,Сіз мұны істей аласыз
Dialogue: 0,0:12:27.48,0:12:29.12,Default - Copy,Jeane,0,0,0,,Сол кездегідей
Dialogue: 0,0:12:29.44,0:12:31.46,Default - Copy,Jeane,0,0,0,,Жындарды реттеңіз
Dialogue: 0,0:12:32.64,0:12:37.04,Default - Copy,Jeane,0,0,0,,Олай жасасаң, жындарыңды қайтарамын.
Dialogue: 0,0:12:39.13,0:12:40.94,Default - Copy,Jeane,0,0,0,,Бір рет жасалды.
Dialogue: 0,0:12:41.58,0:12:43.26,Default - Copy,Jeane,0,0,0,,Мен мұны міндетті түрде қайталай аламын
Dialogue: 0,0:12:43.26,0:12:44.78,Default - Copy,Clare,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:12:45.28,0:12:47.32,Default - Copy,Clare,0,0,0,,Егер сіз мұны жасасаңыз, сіз
Dialogue: 0,0:12:48.00,0:12:49.04,Default - Copy,Clare,0,0,0,,Босатыңыз
Dialogue: 0,0:12:49.48,0:12:50.62,Default - Copy,Clare,0,0,0,,Жараларды емдеу
Dialogue: 0,0:12:51.23,0:12:52.25,Default - Copy,Clare,0,0,0,,Әлі уақытында
Dialogue: 0,0:12:52.68,0:12:54.04,Default - Copy,Jeane,0,0,0,,Клэр
Dialogue: 0,0:12:54.40,0:12:57.00,Default - Copy,Jeane,0,0,0,,Бұл қазірдің өзінде өлімге әкелетін жарақат.
Dialogue: 0,0:12:58.12,0:12:59.38,Default - Copy,Jeane,0,0,0,,Түсінесің бе?
Dialogue: 0,0:13:00.42,0:13:02.21,Default - Copy,Jeane,0,0,0,,Кем дегенде соңында
Dialogue: 0,0:13:02.81,0:13:07.16,Default - Copy,Jeane,0,0,0,,Қалған өмірімді сен үшін өткізуге рұқсат ет.
Dialogue: 0,0:13:07.16,0:13:09.29,Default - Copy,Clare,0,0,0,,Ген
Dialogue: 0,0:13:09.66,0:13:11.18,Default - Copy,Jeane,0,0,0,,Кеттік, Клэр.
Dialogue: 0,0:13:11.18,0:13:12.48,Default - Copy,Jeane,0,0,0,,Көңіл-күйлеріңізді сәйкестендіріңіз
Dialogue: 0,0:13:18.80,0:13:20.78,Default - Copy,Clare,0,0,0,,Ген, тоқтат.
Dialogue: 0,0:13:21.28,0:13:23.36,Default - Copy,Clare,0,0,0,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:13:24.07,0:13:25.89,Default - Copy,Clare,0,0,0,,Сіз маған ешқандай жақсылық қарызсыз.
Dialogue: 0,0:13:26.54,0:13:29.34,Default - Copy,Clare,0,0,0,,Сіздің өміріңіз сіздікі.
Dialogue: 0,0:13:29.34,0:13:30.88,Default - Copy,Jeane,0,0,0,,Клэр, концентрат.
Dialogue: 0,0:13:31.28,0:13:32.34,Default - Copy,Clare,0,0,0,,Йосе
Dialogue: 0,0:13:32.34,0:13:33.47,Default - Copy,Clare,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:13:33.47,0:13:34.54,Default - Copy,Jeane,0,0,0,,Клэр
Dialogue: 0,0:13:35.36,0:13:36.26,Default - Copy,Clare,0,0,0,,Тоқта!
Dialogue: 0,0:13:37.28,0:13:41.21,Default - Copy,Clare,0,0,0,,Мен адам болып қайта оралсам да, менің өмірімнен еш пайда жоқ.
Dialogue: 0,0:13:42.01,0:13:44.34,Default - Copy,Clare,0,0,0,,Присцилланы жеңе алмасаңыз
Dialogue: 0,0:13:44.34,0:13:45.76,Default - Copy,Clare,0,0,0,,Біз өлерміз
Dialogue: 0,0:13:45.76,0:13:46.70,Default - Copy,Jeane,0,0,0,,Клэр
Dialogue: 0,0:13:48.38,0:13:51.40,Default - Copy,Jeane,0,0,0,,Өмірдің мәнін кейінірек таба аласыз.
Dialogue: 0,0:13:52.24,0:13:53.34,Default - Copy,Jeane,0,0,0,,Тек ұмытпа
Dialogue: 0,0:13:53.79,0:13:57.01,Default - Copy,Jeane,0,0,0,,Сенің өмір сүргеніңді қалайтын адамдар бар.
Dialogue: 0,0:13:57.68,0:14:01.06,Default - Copy,Jeane,0,0,0,,Сізге деген сезімі бар адамдар бар.
Dialogue: 0,0:14:07.75,0:14:10.58,Default - Copy,Jeane,0,0,0,,Ал мен солардың бірімін.
Dialogue: 0,0:14:11.02,0:14:12.32,Default - Copy,Clare,0,0,0,,Ген
Dialogue: 0,0:14:14.80,0:14:16.62,Default - Copy,Jeane,0,0,0,,Тікелей Клэр
Dialogue: 0,0:14:18.30,0:14:20.37,Default - Copy,Jeane,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:21.48,0:14:22.26,Default - Copy,Clare,0,0,0,,Ген
Dialogue: 0,0:14:22.66,0:14:23.86,Default - Copy,Clare,0,0,0,,Ген
Dialogue: 0,0:14:55.32,0:14:58.63,Default - Copy,Clare,0,0,0,,Джин, сен неге?
Dialogue: 0,0:15:06.01,0:15:08.67,Default - Copy,Clare,0,0,0,,Ген гені
Dialogue: 0,0:15:20.17,0:15:22.65,Default - Copy,Easley,0,0,0,,Бұл өте қызықты көрініс болды.
Dialogue: 0,0:15:23.77,0:15:24.66,Default - Copy,Raki,0,0,0,,Сіз
Dialogue: 0,0:15:25.14,0:15:26.92,Default - Copy,Miria,0,0,0,,Солтүстік Исли?
Dialogue: 0,0:15:29.30,0:15:31.18,Default - Copy,Easley,0,0,0,,Тұрақсыз бала
Dialogue: 0,0:15:31.18,0:15:33.40,Default - Copy,Easley,0,0,0,,Мен әлі жібергім келмейді.
Dialogue: 0,0:15:33.88,0:15:35.35,Default - Copy,Easley,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:15:40.41,0:15:44.38,Default - Copy,Easley,0,0,0,,Мен күткендей, бұл балалардың шайқасынан қанықпын.
Dialogue: 0,0:15:45.03,0:15:48.85,Default - Copy,Easley,0,0,0,,Бұдан артық істеу этикаға жатпайды.
Dialogue: 0,0:15:49.58,0:15:51.38,Default - Copy,Easley,0,0,0,,Солай емес пе?
Dialogue: 0,0:15:53.72,0:15:55.86,Default - Copy,Easley,0,0,0,,Әзірше осы.
Dialogue: 0,0:15:56.84,0:15:59.76,Default - Copy,Easley,0,0,0,,Рақы Кездесетін кезіміз болады.
Dialogue: 0,0:15:59.76,0:16:02.25,Default - Copy,Easley,0,0,0,,Қылыш шеберлігін шыңдау
Dialogue: 0,0:16:05.77,0:16:10.19,Default - Copy,Miria,0,0,0,,Бұл басым жындық қуат дегеніміз не?
Dialogue: 0,0:16:10.72,0:16:12.50,Default - Copy,Deneve,0,0,0,,Солтүстік Исли?
Dialogue: 0,0:16:13.18,0:16:15.51,Default - Copy,Helen,0,0,0,,Шүкір, бәрі құбыжықтар туралы.
Dialogue: 0,0:16:16.14,0:16:18.44,Default - Copy,Miria,0,0,0,,Аа, бұл солай.
Dialogue: 0,0:16:18.90,0:16:20.24,Default - Copy,Miria,0,0,0,,Бұл тозақ.
Dialogue: 0,0:16:37.14,0:16:38.13,Default - Copy,Rubel,0,0,0,,Не болды?
Dialogue: 0,0:16:39.76,0:16:44.05,Default - Copy,Galatea,0,0,0,,Присцилладан басқа солтүстіктен Исли де келді.
Dialogue: 0,0:16:44.74,0:16:47.32,Default - Copy,Galatea,0,0,0,,Қосымша түсініктеме қажет емес.
Dialogue: 0,0:16:47.86,0:16:49.06,Default - Copy,Rubel,0,0,0,,Дегенмен, қанша рет шайқассақ та, сен меннен әлсізсің.
Dialogue: 0,0:16:50.62,0:16:52.05,Default - Copy,Galatea,0,0,0,,Мен ешбір елес энергияны сезбеймін.
Dialogue: 0,0:16:52.52,0:16:54.53,Default - Copy,Galatea,0,0,0,,Менің айта алатыным осы ғана
Dialogue: 0,0:16:55.22,0:16:57.99,Default - Copy,Galatea,0,0,0,,Егер сізді қызықтыратын болсаңыз, оны тексеріп көріңіз.
Dialogue: 0,0:16:58.46,0:16:59.38,Default - Copy,Rubel,0,0,0,,That's right.
Dialogue: 0,0:17:00.10,0:17:01.16,Default - Copy,Rubel,0,0,0,,Мұны істейік
Dialogue: 0,0:17:03.38,0:17:04.90,Default - Copy,Rubel,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:17:05.58,0:17:07.09,Default - Copy,Rubel,0,0,0,,Солай ма?
Dialogue: 0,0:17:07.58,0:17:10.59,Default - Copy,Rubel,0,0,0,,Біз де осы соғыстың зардаптарын жоюымыз керек.
Dialogue: 0,0:17:14.56,0:17:17.56,Default - Copy,Jeane,0,0,0,,Тірі қалуыңызды көрсетіңіз, Клэр.
Dialogue: 0,0:17:26.68,0:17:28.76,Default - Copy,Helen,0,0,0,,Клэр, жақсысың ба?
Dialogue: 0,0:17:29.20,0:17:32.28,Default - Copy,Helen,0,0,0,,Жанынан айырылғандай көрінді.
Dialogue: 0,0:17:34.24,0:17:36.37,Default - Copy,Miria,0,0,0,,Сіз жүре бастайсыз ба, тоқтайсыз ба
Dialogue: 0,0:17:36.37,0:17:38.12,Default - Copy,Miria,0,0,0,,Оны Клэр шешеді.
Dialogue: 0,0:17:38.71,0:17:41.31,Default - Copy,Miria,0,0,0,,Бұл бізге араласу емес.
Dialogue: 0,0:17:41.31,0:17:42.30,Default - Copy,Deneve,0,0,0,,О
Dialogue: 0,0:17:42.30,0:17:43.53,Default - Copy,Helen,0,0,0,,Жақсы.
Dialogue: 0,0:17:44.73,0:17:46.03,Default - Copy,Miria,0,0,0,,Осы жерден бөлінейік
Dialogue: 0,0:17:47.51,0:17:48.73,Default - Copy,Deneve,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:48.73,0:17:51.16,Default - Copy,Helen,0,0,0,,Не, енді не істеуіміз керек?
Dialogue: 0,0:17:52.96,0:17:55.91,Default - Copy,Deneve,0,0,0,,Жерлеу шайқасы әлі аяқталған жоқ.
Dialogue: 0,0:17:55.91,0:17:57.29,Default - Copy,Deneve,0,0,0,,Ұйымнан шығу
Dialogue: 0,0:17:57.29,0:17:59.04,Default - Copy,Deneve,0,0,0,,Сол мақсат үшін күш жинаңыз
Dialogue: 0,0:17:59.66,0:18:01.80,Default - Copy,Miria,0,0,0,,Мен де осындай жолмен жүрмін.
Dialogue: 0,0:18:01.80,0:18:05.31,Default - Copy,Miria,0,0,0,,Ұйым туралы әлі толық білмеймін.
Dialogue: 0,0:18:05.87,0:18:08.70,Default - Copy,Miria,0,0,0,,Әзірше көпшілікпен араласып, мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:18:09.78,0:18:10.96,Default - Copy,Helen,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:18:11.43,0:18:13.65,Default - Copy,Deneve,0,0,0,,Хелен, сен не істейсің?
Dialogue: 0,0:18:13.95,0:18:17.80,Default - Copy,Helen,0,0,0,,Осы оқиғадан кейін ұйымға қайтып келгім келмейді.
Dialogue: 0,0:18:18.19,0:18:19.68,Default - Copy,Helen,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:20.31,0:18:22.40,Default - Copy,Deneve,0,0,0,,Онда менімен келесің бе?
Dialogue: 0,0:18:22.40,0:18:26.67,Default - Copy,Helen,0,0,0,,Жалғыз қылыш шеберлігін шыңдау қиын.
Dialogue: 0,0:18:26.67,0:18:28.31,Default - Copy,Helen,0,0,0,,Сіз мұны қарсыласыңызға қарсы жасай аласыз.
Dialogue: 0,0:18:31.18,0:18:33.14,Default - Copy,Miria,0,0,0,,Бұл тағы бір қоштасу.
Dialogue: 0,0:18:36.46,0:18:37.90,Default - Copy,Miria,0,0,0,,Бір күні емес
Dialogue: 0,0:18:38.64,0:18:39.89,Default - Copy,Miria,0,0,0,,Сөзсіз кездесейік
Dialogue: 0,0:18:40.18,0:18:40.82,Default - Copy,Deneve,0,0,0,,О
Dialogue: 0,0:18:41.90,0:18:43.18,Default - Copy,Helen,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:46.06,0:18:47.14,Default - Copy,Helen,0,0,0,,Ол жігіт те
Dialogue: 0,0:18:57.38,0:18:58.36,Default - Copy,Jeane,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:18:59.34,0:19:02.37,Default - Copy,Jeane,0,0,0,,Сенің өмір сүргеніңді қалайтын адамдар бар екенін есте сақта.
Dialogue: 0,0:19:04.02,0:19:07.02,Default - Copy,Jeane,0,0,0,,Сізге деген сезімі бар адамдар бар.
Dialogue: 0,0:19:09.20,0:19:11.26,Default - Copy,Jeane,0,0,0,,Тікелей Клэр
Dialogue: 0,0:19:20.28,0:19:21.23,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:21.82,0:19:24.46,Default - Copy,Clare,0,0,0,,Кешіріңіз, мен оны бірден таба алмадым.
Dialogue: 0,0:19:25.44,0:19:26.86,Default - Copy,Clare,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:19:26.86,0:19:27.94,Default - Copy,Clare,0,0,0,,Бұл қиын болған болуы керек
Dialogue: 0,0:19:30.46,0:19:33.22,Default - Copy,Clare,0,0,0,,Ұйымға қайта оралу ойым жоқ.
Dialogue: 0,0:19:34.60,0:19:38.21,Default - Copy,Clare,0,0,0,,Бұдан былай бұл сапар сенікінен де қиынырақ болады.
Dialogue: 0,0:19:39.08,0:19:40.46,Default - Copy,Clare,0,0,0,,Сіз менің артымнан келесіз бе?
Dialogue: 0,0:19:43.50,0:19:44.78,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:46.28,0:19:50.56,Default - Copy,Raki,0,0,0,,Мен Клэрмен мәңгі бірге болдым.
Dialogue: 0,0:19:50.94,0:19:52.12,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:55.18,0:19:56.00,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:20:41.02,0:20:41.88,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:20:42.84,0:20:44.12,Default - Copy,Clare,0,0,0,,Мен тірімін
Dialogue: 0,0:20:45.56,0:20:48.08,Default - Copy,Clare,0,0,0,,«Бұл жақсы» дейсіз бе?
Dialogue: 0,0:21:08.22,0:21:11.82,Default - Copy,Teresa,0,0,0,,Басқалар арасында адам сияқты өмір сүр
Dialogue: 0,0:21:12.64,0:21:13.48,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:21:14.98,0:21:20.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory