Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.03,0:00:16.36,Default - Copy,Yoma,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:00:16.36,0:00:18.85,Default - Copy,Yoma,0,0,0,,Бұл балшық па?
Dialogue: 0,0:00:24.59,0:00:25.61,Default - Copy,Raki,0,0,0,,Мүмкін емес.
Dialogue: 0,0:00:25.61,0:00:27.55,Default - Copy,Raki,0,0,0,,Жындар жақын арада жойылады.
Dialogue: 0,0:00:27.55,0:00:28.73,Default - Copy,Raki,0,0,0,,Аяқтағанша жасырыңыз
Dialogue: 0,0:00:28.73,0:00:29.49,Default - Copy,lady,0,0,0,,Қараңыз
Dialogue: 0,0:00:37.24,0:00:38.46,Default - Copy,Clare,0,0,0,,Ұшу түрі?
Dialogue: 0,0:01:12.77,0:01:14.05,Default - Copy,Clare,0,0,0,,Орындалған жұмыс
Dialogue: 0,0:01:14.71,0:01:17.53,Default - Copy,Clare,0,0,0,,Ақшаны кейін жинауға келетін адамға беріңіз.
Dialogue: 0,0:01:29.74,0:01:30.77,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:01:31.06,0:01:34.24,Default - Copy,Raki,0,0,0,,Аздап ақша алған дұрыс.
Dialogue: 0,0:01:34.58,0:01:38.13,Default - Copy,Clare,0,0,0,,Ұйым мүшелерін жинау үшін ақша қарастырылған
Dialogue: 0,0:01:39.41,0:01:41.16,Default - Copy,Clare,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:01:41.16,0:01:42.22,Default - Copy,Raki,0,0,0,,Жоқ
Dialogue: 0,0:01:42.22,0:01:44.69,Default - Copy,Raki,0,0,0,,Бірақ бірдеңе бола қалса, мен қиыншылыққа тап болар едім.
Dialogue: 0,0:01:44.69,0:01:47.39,Default - Copy,Raki,0,0,0,,Тіпті Клэрдің киімі де жыртық.
Dialogue: 0,0:01:47.39,0:01:50.37,Default - Copy,Clare,0,0,0,,Айзай тезірек жеткізсін.
Dialogue: 0,0:01:50.37,0:01:52.64,Default - Copy,Clare,0,0,0,,Ақша керек кезде де
Dialogue: 0,0:01:54.99,0:01:58.14,Default - Copy,Raki,0,0,0,,Клэр және басқалары біреудің жұмысында.
Dialogue: 0,0:01:59.19,0:02:01.86,Default - Copy,Clare,0,0,0,,Бала кезінен сонда
Dialogue: 0,0:02:02.28,0:02:03.54,Default - Copy,Raki,0,0,0,,Балалық шақта
Dialogue: 0,0:02:03.82,0:02:07.27,Default - Copy,Clare,0,0,0,,Жартысы жын, жартысы адам денесі
Dialogue: 0,0:02:07.78,0:02:12.78,Default - Copy,Clare,0,0,0,,Жарты адам, жартылай жын денеге айналған сәттен бастап білдіреді.
Dialogue: 0,0:02:13.64,0:02:15.87,Default - Copy,Raki,0,0,0,,Клеймор - жартылай жын
Dialogue: 0,0:02:17.76,0:02:19.49,Default - Copy,Raki,0,0,0,,Саз да жарты жын
Dialogue: 0,0:02:20.66,0:02:23.76,Default - Copy,Raki,0,0,0,,Бірақ екінші жартысы адам
Dialogue: 0,0:02:26.34,0:02:27.88,Default - Copy,Raki,0,0,0,,Жартылай адам, жартылай жын
Dialogue: 0,0:03:41.44,0:03:42.31,Default - Copy,Clare,0,0,0,,Не?
Dialogue: 0,0:03:42.74,0:03:44.12,Default - Copy,Clare,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:03:44.12,0:03:47.56,Default - Copy,Raki,0,0,0,,Иә, өйткені мен таңертеңнен бері ештеңе жеген жоқпын.
Dialogue: 0,0:03:47.94,0:03:49.41,Default - Copy,Raki,0,0,0,,Балшық азаймайды
Dialogue: 0,0:03:59.83,0:04:01.43,Default - Copy,Clare,0,0,0,,Жақсы ма?
Dialogue: 0,0:04:13.51,0:04:15.17,Default - Copy,Raki,0,0,0,,Иә, менің ойымша, ол күйіп кетті.
Dialogue: 0,0:04:17.39,0:04:18.79,Default - Copy,Raki,0,0,0,,Иә Клэр
Dialogue: 0,0:04:21.43,0:04:23.92,Default - Copy,Raki,0,0,0,,Жақсы емес, бірақ дәмді көрінеді.
Dialogue: 0,0:04:26.97,0:04:28.02,Default - Copy,Raki,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:04:46.19,0:04:47.87,Default - Copy,Raki,0,0,0,,Мүмкін бұл жаман болды
Dialogue: 0,0:04:48.41,0:04:50.22,Default - Copy,Clare,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:04:50.82,0:04:52.88,Default - Copy,Clare,0,0,0,,Бұл маған жетеді
Dialogue: 0,0:04:53.17,0:04:54.65,Default - Copy,Raki,0,0,0,,Жетеді
Dialogue: 0,0:04:55.09,0:04:56.88,Default - Copy,Raki,0,0,0,,Мен аздап тамақ ішсем де.
Dialogue: 0,0:04:57.58,0:04:59.41,Default - Copy,Clare,0,0,0,,Конституциямыз
Dialogue: 0,0:05:00.03,0:05:04.12,Default - Copy,Clare,0,0,0,,Шамамен екі күнде бір рет тамақты аз мөлшерде жеу жеткілікті.
Dialogue: 0,0:05:04.49,0:05:08.29,Default - Copy,Clare,0,0,0,,Бір аптаға жуық тамақ ішпеуге болады.
Dialogue: 0,0:05:08.56,0:05:09.53,Default - Copy,Raki,0,0,0,,Дұрыс.
Dialogue: 0,0:05:10.36,0:05:14.46,Default - Copy,Clare,0,0,0,,Сенің осылай тамақтанып жатқаныңды көргенде сергітеді.
Dialogue: 0,0:05:14.83,0:05:16.91,Default - Copy,Clare,0,0,0,,Мен аздап қызғаншақпын
Dialogue: 0,0:05:16.91,0:05:19.54,Default - Copy,Raki,0,0,0,,Жоқ, мен шынымен аш емеспін.
Dialogue: 0,0:05:20.16,0:05:23.52,Default - Copy,Clare,0,0,0,,Бәлкім, адамдар да солай шығар.
Dialogue: 0,0:05:25.30,0:05:28.53,Default - Copy,Raki,0,0,0,,Клэр қалай Клеймор болды?
Dialogue: 0,0:05:29.01,0:05:31.99,Default - Copy,Clare,0,0,0,,Бұл шешімді жас кезімде өзім қабылдадым.
Dialogue: 0,0:05:33.35,0:05:34.71,Default - Copy,Raki,0,0,0,,Адам болу қиын
Dialogue: 0,0:05:35.10,0:05:35.79,Default - Copy,Clare,0,0,0,,О
Dialogue: 0,0:05:36.73,0:05:38.25,Default - Copy,Raki,0,0,0,,Сонымен не?
Dialogue: 0,0:05:42.16,0:05:44.56,Default - Copy,Raki,0,0,0,,Мен көп тыңдамауым керек еді.
Dialogue: 0,0:05:45.27,0:05:48.07,Default - Copy,Raki,0,0,0,,Сіздің отбасыңыз немесе достарыңыз жоқ сияқты.
Dialogue: 0,0:05:57.53,0:05:59.78,Default - Copy,Raki,0,0,0,,Бұл қандай белгі?
Dialogue: 0,0:06:00.40,0:06:03.58,Default - Copy,Clare,0,0,0,,Бізге тапсырма берілгенде
Dialogue: 0,0:06:03.58,0:06:05.78,Default - Copy,Clare,0,0,0,,Әрқайсысы жеке мөр алады
Dialogue: 0,0:06:06.43,0:06:09.70,Default - Copy,Clare,0,0,0,,Бұл біздің атымызды білдіреді
Dialogue: 0,0:06:09.70,0:06:11.48,Default - Copy,Clare,0,0,0,,Бұл сәйкестендіру белгісі.
Dialogue: 0,0:06:11.78,0:06:14.13,Default - Copy,Raki,0,0,0,,Бұл Клэрдің белгісі ме?
Dialogue: 0,0:06:20.64,0:06:21.87,Default - Copy,Raki,0,0,0,,Э… иә, мен жақсымын
Dialogue: 0,0:06:21.87,0:06:23.27,Default - Copy,Clare,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:06:27.84,0:06:28.85,Default - Copy,Raki,0,0,0,,Бұл науа ма?
Dialogue: 0,0:06:36.31,0:06:37.13,Default - Copy,Rubel,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:06:39.68,0:06:41.28,Default - Copy,Rubel,0,0,0,,Ол маскүнем.
Dialogue: 0,0:06:41.62,0:06:43.71,Default - Copy,Rubel,0,0,0,,Неліктен мұндай баланы өзіңізбен бірге ала аласыз?
Dialogue: 0,0:06:44.27,0:06:46.26,Default - Copy,Rubel,0,0,0,,Бұл тек сіздің жұмысыңызға кедергі болады.
Dialogue: 0,0:06:46.73,0:06:48.31,Default - Copy,Clare,0,0,0,,Тек аспазшы.
Dialogue: 0,0:06:48.71,0:06:49.98,Default - Copy,Clare,0,0,0,,Кедергі жасамау
Dialogue: 0,0:06:49.98,0:06:51.53,Default - Copy,Rubel,0,0,0,,Ас әзірлеу?
Dialogue: 0,0:06:52.03,0:06:54.50,Default - Copy,Rubel,0,0,0,,Даусыңыз адам сияқты.
Dialogue: 0,0:06:55.68,0:07:00.00,Default - Copy,Rubel,0,0,0,,Сіз сол баламен өткен өміріңізді анықтадыңыз ба?
Dialogue: 0,0:07:00.45,0:07:01.95,Default - Copy,Rubel,0,0,0,,Бұл сентименталды.
Dialogue: 0,0:07:01.95,0:07:04.23,Default - Copy,Clare,0,0,0,,Жаңа киім әкелдің бе?
Dialogue: 0,0:07:12.77,0:07:13.95,Default - Copy,Rubel,0,0,0,,Жарайды, төмен түсірейік.
Dialogue: 0,0:07:20.93,0:07:22.68,Default - Copy,Rubel,0,0,0,,Бұл абайсызда болды.
Dialogue: 0,0:07:24.92,0:07:26.90,Default - Copy,Rubel,0,0,0,,Жара жабылса да
Dialogue: 0,0:07:27.24,0:07:31.80,Default - Copy,Rubel,0,0,0,,Ваннаға түсіп қалсаң, өзің де өлетініңді ұмытпа.
Dialogue: 0,0:07:32.72,0:07:34.60,Default - Copy,Rubel,0,0,0,,Екіншісі де жақсы.
Dialogue: 0,0:07:35.08,0:07:37.56,Default - Copy,Rubel,0,0,0,,Оны сол күйінде қалдыру дұрыс.
Dialogue: 0,0:07:40.93,0:07:42.68,Default - Copy,Rubel,0,0,0,,Дене
Dialogue: 0,0:07:42.68,0:07:45.28,Default - Copy,Rubel,0,0,0,,Маған әлгі бала оны көрсе не ойлайды екен
Dialogue: 0,0:07:46.77,0:07:49.30,Default - Copy,Rubel,0,0,0,,Маскүнемдігіңізді қалыпты жағдайда ұстаңыз.
Dialogue: 0,0:07:49.30,0:07:52.49,Default - Copy,Rubel,0,0,0,,Сезіміңнен қиналған сенсің.
Dialogue: 0,0:07:54.01,0:07:55.92,Default - Copy,Rubel,0,0,0,,Иә
Dialogue: 0,0:07:55.92,0:07:57.76,Default - Copy,Rubel,0,0,0,,Менің жанымда ұстайтын бірдеңе бар еді.
Dialogue: 0,0:08:02.16,0:08:03.74,Default - Copy,Clare,0,0,0,,Қара кітап
Dialogue: 0,0:08:04.16,0:08:05.30,Default - Copy,Clare,0,0,0,,Дұрыс емес шығар
Dialogue: 0,0:08:05.30,0:08:06.74,Default - Copy,Clare,0,0,0,,Мен мұнымен болады деп күтпедім.
Dialogue: 0,0:08:08.35,0:08:10.57,Default - Copy,Rubel,0,0,0,,Мазмұнын өзіңіз тексеріңіз
Dialogue: 0,0:08:17.45,0:08:18.60,Default - Copy,Clare,0,0,0,,Неліктен жер бетінде?
Dialogue: 0,0:08:27.67,0:08:29.43,Default - Copy,Raki,0,0,0,,Сіз кешігіп қалдыңыз, Клэр.
Dialogue: 0,0:08:29.43,0:08:30.72,Default - Copy,Raki,0,0,0,,Бұл үлкенірек пе?
Dialogue: 0,0:08:37.21,0:08:38.14,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:08:41.67,0:08:42.48,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:08:42.91,0:08:44.11,Default - Copy,Raki,0,0,0,,Не болды?
Dialogue: 0,0:08:47.66,0:08:51.40,Default - Copy,Raki,0,0,0,,Білесің бе, мен қалған етті ұсақталған ет еттім.
Dialogue: 0,0:08:51.40,0:08:52.85,Default - Copy,Raki,0,0,0,,Оны жегіңіз келсе, маған хабарлаңыз.
Dialogue: 0,0:09:00.62,0:09:01.57,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:09:01.57,0:09:03.30,Default - Copy,Clare,0,0,0,,Ертең Шиелеге барамыз
Dialogue: 0,0:09:03.66,0:09:05.86,Default - Copy,Clare,0,0,0,,Мен ерте тұрамын, сондықтан оны есте сақтаңыз.
Dialogue: 0,0:09:42.75,0:09:43.87,Default - Copy,Elena,0,0,0,,Ал Кира
Dialogue: 0,0:09:44.49,0:09:47.07,Default - Copy,Elena,0,0,0,,Егер сіз мұны істесеңіз, бәрі жақсы болады
Dialogue: 0,0:10:31.26,0:10:32.51,Default - Copy,villagerA,0,0,0,,Сәлем
Dialogue: 0,0:10:32.51,0:10:35.02,Default - Copy,villagerB,0,0,0,,Бұл күміс көзді бақсы емес пе?
Dialogue: 0,0:10:40.92,0:10:42.98,Default - Copy,villagerC,0,0,0,,Менің ауылымнан сұрадың ба?
Dialogue: 0,0:10:42.98,0:10:44.20,Default - Copy,villagerD,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:44.20,0:10:47.02,Default - Copy,villagerD,0,0,0,,Ешкімге жындар шабуыл жасамайды.
Dialogue: 0,0:10:47.02,0:10:48.46,Default - Copy,villagerE,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:48.46,0:10:49.90,Default - Copy,villagerE,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:49.90,0:10:51.18,Default - Copy,villagerC,0,0,0,,Біз біраз дауластық
Dialogue: 0,0:10:51.18,0:10:53.82,Default - Copy,villagerC,0,0,0,,Менің ойымша, сіз біраз уақыт қалуды жоспарлап отырған жоқсыз.
Dialogue: 0,0:10:55.33,0:10:56.45,Default - Copy,Raki,0,0,0,,Бұл не?
Dialogue: 0,0:10:56.77,0:11:00.55,Default - Copy,Raki,0,0,0,,Жындар келгенде, менің Клэр мен басқалардан сұраудан басқа амалым жоқ.
Dialogue: 0,0:11:07.07,0:11:09.05,Default - Copy,owner,0,0,0,,Қош келдіңіз
Dialogue: 0,0:11:10.44,0:11:11.79,Default - Copy,Clare,0,0,0,,Бөлме бар ма?
Dialogue: 0,0:11:11.79,0:11:13.92,Default - Copy,owner,0,0,0,,Бұл
Dialogue: 0,0:11:13.92,0:11:15.40,Default - Copy,Clare,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:11:15.40,0:11:17.17,Default - Copy,Clare,0,0,0,,Бұл бала түнеп жатқан жалғыз бала.
Dialogue: 0,0:11:17.17,0:11:19.16,Default - Copy,Raki,0,0,0,,Неліктен?
Dialogue: 0,0:11:19.16,0:11:22.15,Default - Copy,Clare,0,0,0,,Мен жұмысымды аяқтағанша осында күтіңіз.
Dialogue: 0,0:11:24.32,0:11:25.30,Default - Copy,Raki,0,0,0,,Мен де барамын
Dialogue: 0,0:11:26.99,0:11:28.49,Default - Copy,Clare,0,0,0,,Міндетті түрде қайтып келеді
Dialogue: 0,0:11:29.72,0:11:33.67,Default - Copy,owner,0,0,0,,Ымм, бұл ауылда да жын пайда болды ма?
Dialogue: 0,0:11:33.67,0:11:36.79,Default - Copy,Clare,0,0,0,,Жоқ, бұл жерде жындар жоқ.
Dialogue: 0,0:11:37.10,0:11:38.05,Default - Copy,Clare,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:11:39.27,0:11:41.55,Default - Copy,Raki,0,0,0,,Жындарды өлтірмейсің бе?
Dialogue: 0,0:11:42.13,0:11:43.17,Default - Copy,Clare,0,0,0,,Жоқ
Dialogue: 0,0:11:43.17,0:11:45.45,Default - Copy,Raki,0,0,0,,Сонда бұл менмін.
Dialogue: 0,0:11:45.85,0:11:47.06,Default - Copy,Clare,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:11:47.89,0:11:50.49,Default - Copy,owner,0,0,0,,Жындар бар ғой.
Dialogue: 0,0:11:50.49,0:11:52.02,Default - Copy,owner,0,0,0,,Иә, қазір ойлап қарасам
Dialogue: 0,0:11:52.02,0:11:54.55,Default - Copy,owner,0,0,0,,Бірнеше күн бұрын тағы бір балшық болды.
Dialogue: 0,0:11:56.32,0:11:58.07,Default - Copy,Clare,0,0,0,,Шиеле тауын көрдіңіз бе?
Dialogue: 0,0:11:58.07,0:11:59.60,Default - Copy,owner,0,0,0,,Иә. .
Dialogue: 0,0:12:00.49,0:12:01.68,Default - Copy,Clare,0,0,0,,Қазір оралу
Dialogue: 0,0:12:07.04,0:12:08.42,Default - Copy,owner,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:12:09.13,0:12:10.18,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:12:11.66,0:12:12.98,Default - Copy,???,0,0,0,,монах
Dialogue: 0,0:12:12.98,0:12:16.60,Default - Copy,???,0,0,0,,Клеймормен бірге болсаңыз да, сіз ештеңе білмейтін сияқтысыз.
Dialogue: 0,0:12:18.02,0:12:23.19,Default - Copy,???,0,0,0,,Мүмкін сіз Клэрмордың жартылай адам, жартылай жын екенін білмейсіз бе?
Dialogue: 0,0:12:24.00,0:12:25.66,Default - Copy,Raki,0,0,0,,Мен білемін.
Dialogue: 0,0:12:26.09,0:12:28.98,Default - Copy,Raki,0,0,0,,Бірақ Клэр құбыжық емес.
Dialogue: 0,0:12:30.20,0:12:35.21,Default - Copy,???,0,0,0,,Олардың денесінде жынның қаны мен еті бар.
Dialogue: 0,0:12:35.64,0:12:37.27,Default - Copy,Raki,0,0,0,,Жынның қаны мен еті
Dialogue: 0,0:12:37.27,0:12:41.22,Default - Copy,???,0,0,0,,Жартылай адам, жартылай жын.
Dialogue: 0,0:12:41.85,0:12:45.53,Default - Copy,???,0,0,0,,Оны жындармен күресу үшін белгілі бір ұйым құрған.
Dialogue: 0,0:12:46.22,0:12:50.46,Default - Copy,???,0,0,0,,Алайда, неге екені белгісіз, тек әйелдер ғана жетістікке жеткен сияқты.
Dialogue: 0,0:12:51.94,0:12:54.46,Default - Copy,???,0,0,0,,Қасымда болсаң, білуің керек.
Dialogue: 0,0:12:55.25,0:12:59.70,Default - Copy,Raki,0,0,0,,Сонымен Клэймор бастапқыда адам болған ба?
Dialogue: 0,0:12:59.70,0:13:01.02,Default - Copy,???,0,0,0,,Саана
Dialogue: 0,0:13:01.02,0:13:03.45,Default - Copy,???,0,0,0,,Мен бұл бөлікті түсінбеймін.
Dialogue: 0,0:13:03.45,0:13:06.04,Default - Copy,Raki,0,0,0,,Жынның қаны мен етін қалай қосасыз?
Dialogue: 0,0:13:06.04,0:13:07.94,Default - Copy,???,0,0,0,,Мен мұны да білмеймін.
Dialogue: 0,0:13:08.54,0:13:09.77,Default - Copy,???,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:13:09.77,0:13:15.66,Default - Copy,???,0,0,0,,Клейморлар денелеріндегі жын-шайтанның күшін басу үшін адамдық ерік-жігерін пайдаланады.
Dialogue: 0,0:13:16.25,0:13:19.08,Default - Copy,???,0,0,0,,Сондықтан адам терісін киюге болады
Dialogue: 0,0:13:19.08,0:13:25.38,Default - Copy,???,0,0,0,,Бұл адамдар үшін ең жақсы құрал, олар осы уақытқа дейін жындармен күресу мүмкін емес.
Dialogue: 0,0:13:25.82,0:13:27.47,Default - Copy,Raki,0,0,0,,Ең жақсы құралдар
Dialogue: 0,0:13:27.47,0:13:28.43,Default - Copy,???,0,0,0,,Бірақ
Dialogue: 0,0:13:28.43,0:13:31.05,Default - Copy,???,0,0,0,,Бір ғана мәселе болды.
Dialogue: 0,0:13:32.51,0:13:36.05,Default - Copy,???,0,0,0,,Жартылай адам, жартылай жын ақырында жынға айналады.
Dialogue: 0,0:13:37.81,0:13:39.71,Default - Copy,???,0,0,0,,Жындардың күшін қолданыңыз
Dialogue: 0,0:13:39.71,0:13:42.45,Default - Copy,???,0,0,0,,Сіз өзіңіздің жын қабілеттеріңізді көбірек пайдалансаңыз
Dialogue: 0,0:13:42.45,0:13:45.04,Default - Copy,???,0,0,0,,Оның денесі жынның денесіне жақындай түседі.
Dialogue: 0,0:13:47.40,0:13:50.10,Default - Copy,???,0,0,0,,Ал мен өзімді ұстай алмадым
Dialogue: 0,0:13:50.10,0:13:54.10,Default - Copy,???,0,0,0,,Жынға айналғандарды ұйым жоғалтады.
Dialogue: 0,0:13:57.40,0:13:59.32,Default - Copy,Raki,0,0,0,,бірақ газ бітті, қабырғаға өре алмаймыз.
Dialogue: 0,0:14:00.42,0:14:02.01,Default - Copy,Raki,0,0,0,,Клэр жынға айналады
Dialogue: 0,0:14:02.34,0:14:03.56,Default - Copy,Raki,0,0,0,,Бұл өтірік
Dialogue: 0,0:14:03.56,0:14:04.75,Default - Copy,Raki,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:47.10,0:14:48.06,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:14:53.11,0:14:54.55,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:14:54.96,0:14:56.78,Default - Copy,Clare,0,0,0,,Мен саған күте тұр дедім.
Dialogue: 0,0:14:57.08,0:14:57.97,Default - Copy,Raki,0,0,0,,Бұл өтірік
Dialogue: 0,0:14:58.61,0:15:00.54,Default - Copy,Raki,0,0,0,,Сіз құбыжыққа айналып жатқан жоқсыз ғой?
Dialogue: 0,0:15:00.94,0:15:03.29,Default - Copy,Raki,0,0,0,,Клэр жынға айналмайды.
Dialogue: 0,0:15:04.36,0:15:07.44,Default - Copy,Clare,0,0,0,,Не естігеніңізді білмеймін, бірақ қате түсінбеңіз.
Dialogue: 0,0:15:07.88,0:15:10.13,Default - Copy,Clare,0,0,0,,Ешкім жынға айналған жоқ.
Dialogue: 0,0:15:10.88,0:15:11.63,Default - Copy,Clare,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:15:15.00,0:15:17.72,Default - Copy,Clare,0,0,0,,Тек шегіне жеткендер бар.
Dialogue: 0,0:15:22.39,0:15:26.01,Default - Copy,owner,0,0,0,,Мен бірнеше күн бұрын басқа Клейморды көрдім.
Dialogue: 0,0:15:27.27,0:15:29.41,Default - Copy,Raki,0,0,0,,Тағы бір Клеймор
Dialogue: 0,0:15:29.41,0:15:30.66,Default - Copy,Clare,0,0,0,,О
Dialogue: 0,0:15:30.66,0:15:32.09,Default - Copy,Clare,0,0,0,,Мен өлтіремін
Dialogue: 0,0:15:32.09,0:15:33.43,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:15:33.43,0:15:34.62,Default - Copy,Raki,0,0,0,,Достар арасында
Dialogue: 0,0:15:35.57,0:15:36.92,Default - Copy,Clare,0,0,0,,Қара кітап
Dialogue: 0,0:15:36.92,0:15:37.92,Default - Copy,Raki,0,0,0,,Қара кітап
Dialogue: 0,0:15:39.75,0:15:40.57,Default - Copy,Raki,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:15:42.92,0:15:48.32,Default - Copy,Clare,0,0,0,,Әрқайсымыздың қылышымызда қара кітап бар.
Dialogue: 0,0:15:52.97,0:15:59.21,Default - Copy,Clare,0,0,0,,Шайқас болған сайын болатын адам санасы мен жын санасы арасындағы қайшылық.
Dialogue: 0,0:16:02.51,0:16:06.06,Default - Copy,Clare,0,0,0,,Біз сананың шегін жақын арада үйренеміз.
Dialogue: 0,0:16:07.38,0:16:10.79,Default - Copy,Clare,0,0,0,,Жынға айналатыныңызға өзіңізді сендіріңіз
Dialogue: 0,0:16:13.91,0:16:15.05,Default - Copy,Clare,0,0,0,,Сол кезде
Dialogue: 0,0:16:15.48,0:16:20.32,Default - Copy,Clare,0,0,0,,Біз адам болып өлгіміз келеді.
Dialogue: 0,0:16:21.19,0:16:22.78,Default - Copy,Clare,0,0,0,,Ал біз
Dialogue: 0,0:16:23.16,0:16:26.94,Default - Copy,Clare,0,0,0,,Қара кітапты ең көп өлтіргіңіз келетін адамға беріңіз
Dialogue: 0,0:16:32.18,0:16:36.05,Default - Copy,Raki,0,0,0,,Сонымен, Клэрге қара кітапты кім берді?
Dialogue: 0,0:16:38.63,0:16:42.18,Default - Copy,Clare,0,0,0,,Ол менімен бір уақытта ұйымға қосылды.
Dialogue: 0,0:16:57.71,0:17:00.27,Default - Copy,Clare,0,0,0,,Қиын кезімізде бір-бірімізді жұбататынбыз.
Dialogue: 0,0:17:04.61,0:17:09.07,Default - Copy,Clare,0,0,0,,Жартылай адам, жартылай жын болсам да, қатты қиналсам да.
Dialogue: 0,0:17:09.71,0:17:12.12,Default - Copy,Clare,0,0,0,,Бір-бірімізді құшақтап алсақ, көретін едік
Dialogue: 0,0:17:19.10,0:17:19.99,Default - Copy,Elena,0,0,0,,Ал Кира
Dialogue: 0,0:17:21.75,0:17:24.83,Default - Copy,Elena,0,0,0,,Егер сіз мұны істесеңіз, бәрі жақсы болады.
Dialogue: 0,0:17:44.39,0:17:46.72,Default - Copy,Elena,0,0,0,,Көптен бері көрмегелі, Клэр
Dialogue: 0,0:17:47.61,0:17:48.47,Default - Copy,Clare,0,0,0,,Елена
Dialogue: 0,0:17:52.28,0:17:53.58,Default - Copy,Clare,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,0:17:54.42,0:17:56.11,Default - Copy,Clare,0,0,0,,Дәл сол кездегідей.
Dialogue: 0,0:17:56.84,0:17:58.57,Default - Copy,Elena,0,0,0,,Сіз өзіңізді тым қатты итермелеп жатырсыз.
Dialogue: 0,0:17:58.57,0:18:00.45,Default - Copy,Elena,0,0,0,,Себебі мен сенімен кездесіп тұрмын
Dialogue: 0,0:18:01.72,0:18:03.52,Default - Copy,Elena,0,0,0,,Көп уақыт өтті
Dialogue: 0,0:18:03.52,0:18:05.97,Default - Copy,Elena,0,0,0,,Кеше сияқты
Dialogue: 0,0:18:06.73,0:18:09.35,Default - Copy,Elena,0,0,0,,Ол азапты нәрселерге толы болуы керек, бірақ
Dialogue: 0,0:18:09.35,0:18:13.78,Default - Copy,Elena,0,0,0,,Неге екені белгісіз, қазір мен сенімен бірге өткізген қызықты кездерді ғана есіме аламын.
Dialogue: 0,0:18:15.59,0:18:18.41,Default - Copy,Elena,0,0,0,,Мен жұмысқа сізден кеш кіріссем де.
Dialogue: 0,0:18:18.41,0:18:20.72,Default - Copy,Elena,0,0,0,,Сенен бұрын өлетініме сене алар емеспін.
Dialogue: 0,0:18:21.30,0:18:23.71,Default - Copy,Elena,0,0,0,,Мен жалқаумын.
Dialogue: 0,0:18:27.51,0:18:29.91,Default - Copy,Elena,0,0,0,,Егер сіз жынның күшін алсаңыз
Dialogue: 0,0:18:29.91,0:18:31.78,Default - Copy,Elena,0,0,0,,Мен күштірек бола аламын деп ойладым
Dialogue: 0,0:18:33.41,0:18:34.47,Default - Copy,Elena,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:18:38.91,0:18:41.32,Default - Copy,Elena,0,0,0,,Жындардың күшін пайдаланудан да артық
Dialogue: 0,0:18:41.68,0:18:45.71,Default - Copy,Elena,0,0,0,,Мен адам ретінде мықты болуым керек еді.
Dialogue: 0,0:18:49.51,0:18:50.03,Default - Copy,Raki,0,0,0,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:18:50.67,0:18:51.93,Default - Copy,Raki,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:18:52.87,0:18:53.78,Default - Copy,Elena,0,0,0,,Сонымен
Dialogue: 0,0:18:54.57,0:18:55.49,Default - Copy,Elena,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:18:56.41,0:18:57.61,Default - Copy,Elena,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:18:58.21,0:19:01.94,Default - Copy,Elena,0,0,0,,Менде адамның жүрегі болғанша
Dialogue: 0,0:19:07.89,0:19:09.34,Default - Copy,Raki,0,0,0,,Жоқ, Клэр.
Dialogue: 0,0:19:09.34,0:19:10.67,Default - Copy,Raki,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:19:10.91,0:19:12.56,Default - Copy,Raki,0,0,0,,Жоқ, сіз мұны істей алмайсыз.
Dialogue: 0,0:19:21.59,0:19:22.73,Default - Copy,Elena,0,0,0,,Клэр
Dialogue: 0,0:19:25.22,0:19:26.18,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:42.47,0:19:43.47,Default - Copy,Raki,0,0,0,,Клэр!
Dialogue: 0,0:19:56.14,0:19:58.81,Default - Copy,Elena,0,0,0,,Рахмет сізге Клэр
Dialogue: 0,0:20:00.83,0:20:04.10,Default - Copy,Elena,0,0,0,,Енді сіз адам болып өмір сүре аласыз
Dialogue: 0,0:20:28.28,0:20:29.78,Default - Copy,Clare,0,0,0,,Елена деген кім?
Dialogue: 0,0:20:30.88,0:20:33.19,Default - Copy,Clare,0,0,0,,Мен ұйымға шамамен бір уақытта қосылдым.
Dialogue: 0,0:20:34.78,0:20:37.28,Default - Copy,Clare,0,0,0,,Қиын кезімізде бір-бірімізді жұбататынбыз.
Dialogue: 0,0:20:38.99,0:20:43.50,Default - Copy,Clare,0,0,0,,Жартылай адам, жартылай жын болсам да, қатты қиналсам да.
Dialogue: 0,0:20:44.13,0:20:46.75,Default - Copy,Clare,0,0,0,,Бір-бірімізді құшақтап алсақ, көретін едік.
Dialogue: 0,0:20:47.65,0:20:48.77,Default - Copy,Clare,0,0,0,,Содан кейін
Dialogue: 0,0:20:49.48,0:20:52.51,Default - Copy,Clare,0,0,0,,Ұйымға жастай келген мен үшін
Dialogue: 0,0:20:52.86,0:20:55.77,Default - Copy,Clare,0,0,0,,Менің өмірімде жалғыз досым болды
Dialogue: 0,0:20:57.70,0:20:58.97,Default - Copy,Raki,0,0,0,,Неліктен?
Dialogue: 0,0:21:00.00,0:21:04.52,Default - Copy,Raki,0,0,0,,Неліктен жындармен күресіп жатырсың, бұл өте ауыр болса?
Dialogue: 0,0:21:06.58,0:21:07.89,Default - Copy,Raki,0,0,0,,Неліктен?
Dialogue: 0,0:21:11.13,0:21:12.26,Default - Copy,Clare,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:21:13.19,0:21:15.66,Default - Copy,Clare,0,0,0,,Өйткені бұл біздің өмір сүру себебіміз.
Dialogue: 0,0:22:41.00,0:22:43.31,Default - Copy,,0,0,0,,Қараңғы түнде зұлымдық жасырады
Dialogue: 0,0:22:43.31,0:22:46.18,Default - Copy,,0,0,0,,Түнді де жұтқан терең қараңғылық
Dialogue: 0,0:22:47.68,0:22:53.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory