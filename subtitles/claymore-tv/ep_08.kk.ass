Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.71,0:00:07.79,Default - Copy,Priscilla,0,0,0,,Түсінікті
Dialogue: 0,0:00:08.22,0:00:09.21,Default - Copy,Priscilla,0,0,0,,Жеңіліс
Dialogue: 0,0:00:09.92,0:00:13.23,Default - Copy,Priscilla,0,0,0,,Біз ұйымымызды бұзатын кез келген адамға шыдай алмаймыз.
Dialogue: 0,0:00:13.93,0:00:15.63,Default - Copy,Priscilla,0,0,0,,Кешіріңіз, Тереза.
Dialogue: 0,0:00:16.20,0:00:18.87,Default - Copy,Priscilla,0,0,0,,Мүмкін болса, мен жеке-жеке күрескенді қалар едім.
Dialogue: 0,0:00:19.30,0:00:22.23,Default - Copy,Priscilla,0,0,0,,Бірақ бәріне сен кінәлісің.
Dialogue: 0,0:01:33.19,0:01:33.93,Default - Copy,Priscilla,0,0,0,,Кеттік
Dialogue: 0,0:02:25.61,0:02:26.35,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:02:39.87,0:02:41.16,Default - Copy,Prisciila,0,0,0,,Бұл
Dialogue: 0,0:02:42.83,0:02:44.10,Default - Copy,Prisciila,0,0,0,,Айрин
Dialogue: 0,0:03:34.68,0:03:35.36,Default - Copy,Prisciila,0,0,0,,Айрин
Dialogue: 0,0:03:36.22,0:03:38.25,Default - Copy,Prisciila,0,0,0,,Айрин, жақсысың ба?
Dialogue: 0,0:03:38.25,0:03:39.36,Default - Copy,Prisciila,0,0,0,,Айрин
Dialogue: 0,0:03:40.54,0:03:42.02,Default - Copy,Irene,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:03:42.59,0:03:43.09,Default - Copy,Irene,0,0,0,,Уууууууу!!
Dialogue: 0,0:03:43.59,0:03:44.93,Default - Copy,Priscilla,0,0,0,,. . .
Dialogue: 0,0:03:44.93,0:03:45.93,Default - Copy,Irene,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:03:46.59,0:03:49.53,Default - Copy,Irene,0,0,0,,Сіз өз мүмкіндігіңізше күресуіңіз керек.
Dialogue: 0,0:03:51.67,0:03:53.07,Default - Copy,Irene,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:03:53.74,0:03:56.88,Default - Copy,Irene,0,0,0,,Терезаның басын бар күшіңізбен алуыңыз керек.
Dialogue: 0,0:03:58.14,0:03:58.97,Default - Copy,Priscilla,0,0,0,,Иә
Dialogue: 0,0:04:03.38,0:04:04.48,Default - Copy,Irene,0,0,0,,Келесі шайқас!
Dialogue: 0,0:04:05.25,0:04:11.62,Default - Copy,Irene,0,0,0,,Мен бұл төртеуі Терезаға қалай да жақындай алады деп ойладым.
Dialogue: 0,0:04:17.09,0:04:18.13,Default - Copy,Irene,0,0,0,,Ол сондай адам.
Dialogue: 0,0:04:20.46,0:04:25.20,Default - Copy,Irene,0,0,0,,Мен Терезаны әлі де бағаламадым деп ойлайсыз ба?
Dialogue: 0,0:04:30.64,0:04:31.45,Default - Copy,Irene,0,0,0,,Жігіт
Dialogue: 0,0:04:33.07,0:04:38.41,Default - Copy,Irene,0,0,0,,Ол әлі өзінің сиқырлы күшін босатқан жоқ.
Dialogue: 0,0:04:43.18,0:04:44.02,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:04:44.99,0:04:45.73,Default - Copy,Teresa,0,0,0,,Клэр
Dialogue: 0,0:04:46.52,0:04:48.59,Default - Copy,Teresa,0,0,0,,Қонақ үйге қайтып, заттарыңызды жинаңыз.
Dialogue: 0,0:04:49.12,0:04:51.73,Default - Copy,Teresa,0,0,0,,Қалаға енді қиындық тудырмайды.
Dialogue: 0,0:04:51.73,0:04:53.46,Default - Copy,Teresa,0,0,0,,Эрен...
Dialogue: 0,0:04:53.46,0:04:53.93,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:04:57.17,0:04:58.37,Default - Copy,Teresa,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:05:12.78,0:05:14.22,Default - Copy,Irene,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:05:14.22,0:05:15.52,Default - Copy,Irene,0,0,0,,Бұл анық болды ма?
Dialogue: 0,0:05:16.75,0:05:21.26,Default - Copy,Irene,0,0,0,,Ол Присцилланың өз қабілетінен асып түсетін қабілеттерге ие болатынын білді.
Dialogue: 0,0:05:23.93,0:05:27.36,Default - Copy,Irene,0,0,0,,Мен келесі бүршіктердің барлығын дәл осы жерден кесіп тастаймын.
Dialogue: 0,0:05:29.40,0:05:31.47,Default - Copy,Irene,0,0,0,,Қорқыныштысы Терезаның күлкісі
Dialogue: 0,0:05:32.55,0:05:38.44,Default - Copy,Irene,0,0,0,,Осыдан кейін қанша ұрысып қалғанымыз маңызды емес, біз оны қозғалмайтындай етіп жарақаттадық.
Dialogue: 0,0:05:39.15,0:05:46.31,Default - Copy,Irene,0,0,0,,Қозғалуы керек жалғыз Присцилла күшті күштің алдында қорқыныштан қозғала алмайды.
Dialogue: 0,0:05:51.39,0:05:54.16,Default - Copy,Priscilla,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:05:56.02,0:05:57.23,Default - Copy,Priscilla,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:05:57.89,0:05:59.43,Default - Copy,Priscilla,0,0,0,,Қарғыс атқан ұрық метаморфозға ұшыраған жағдайда—
Dialogue: 0,0:05:59.83,0:06:01.04,Default - Copy,Priscilla,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:06:02.03,0:06:03.53,Default - Copy,Priscilla,0,0,0,,Маған біреу көмектес
Dialogue: 0,0:06:04.53,0:06:05.80,Default - Copy,Priscilla,0,0,0,,Маған көмектес
Dialogue: 0,0:06:06.83,0:06:09.34,Default - Copy,Priscilla,0,0,0,,Папа, өтінемін, папа.
Dialogue: 0,0:06:09.97,0:06:11.04,Default - Copy,Priscilla,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:06:19.65,0:06:21.85,Default - Copy,Teresa,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:06:22.35,0:06:24.72,Default - Copy,Teresa,0,0,0,,Мен оның бетіне қадала алмаймын.
Dialogue: 0,0:06:25.29,0:06:26.39,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:06:28.22,0:06:29.56,Default - Copy,Clare,0,0,0,,Мен әкелдім.
Dialogue: 0,0:06:29.56,0:06:32.13,Default - Copy,Clare,0,0,0,,Терезаның беліне тағылғаны да дұрыс.
Dialogue: 0,0:06:33.19,0:06:35.33,Default - Copy,Teresa,0,0,0,,Соны да әкелуге қиналдың ба?
Dialogue: 0,0:06:35.96,0:06:37.27,Default - Copy,Teresa,0,0,0,,Бұл ауыр болар еді
Dialogue: 0,0:06:37.27,0:06:39.17,Default - Copy,Clare,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:06:43.04,0:06:44.88,Default - Copy,Teresa,0,0,0,,Қалағаныңызша келіңіз
Dialogue: 0,0:06:45.44,0:06:47.68,Default - Copy,Teresa,0,0,0,,Мен оны әр жолы кесіп тастаймын
Dialogue: 0,0:07:03.22,0:07:05.67,Default - Copy,Teresa,0,0,0,,Кешіріңіз, бірақ мен сізге қиындық туғыздым.
Dialogue: 0,0:07:16.90,0:07:18.47,Default - Copy,Irene,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:07:19.11,0:07:21.38,Default - Copy,Irene,0,0,0,,Тереза мейірімділік танытады деп ойлау.
Dialogue: 0,0:07:22.24,0:07:25.31,Default - Copy,Irene,0,0,0,,Бұрын ойланбастан басын кесіп алатын.
Dialogue: 0,0:07:28.02,0:07:32.03,Default - Copy,Irene,0,0,0,,Қалай болғанда да, біздің үмітіміз байланысты.
Dialogue: 0,0:07:34.26,0:07:35.12,Default - Copy,Irene,0,0,0,,Жылама
Dialogue: 0,0:07:35.49,0:07:37.03,Default - Copy,Irene,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:07:37.33,0:07:38.40,Default - Copy,Irene,0,0,0,,Бұдан былай
Dialogue: 0,0:07:40.53,0:07:41.13,Default - Copy,Priscilla,0,0,0,,Жоқ
Dialogue: 0,0:07:42.80,0:07:43.63,Default - Copy,Priscilla,0,0,0,,Өткізіп алмау керек
Dialogue: 0,0:07:44.07,0:07:45.17,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:45.87,0:07:47.54,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:47.97,0:07:49.37,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:50.54,0:07:52.21,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:52.84,0:07:54.41,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:55.44,0:07:56.84,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:07:58.05,0:07:59.38,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:08:00.11,0:08:01.38,Default - Copy,Priscilla,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:08:00.58,0:08:01.38,Default - Copy,Irene,0,0,0,,Прискила
Dialogue: 0,0:08:07.12,0:08:09.42,Default - Copy,Priscilla,0,0,0,,Қанішер болғанына қарамастан
Dialogue: 0,0:08:09.42,0:08:10.69,Default - Copy,Priscilla,0,0,0,,Жаман адам болғанымен
Dialogue: 0,0:08:11.13,0:08:13.63,Default - Copy,Priscilla,0,0,0,,Ұйым ережесін бұзғанына қарамастан
Dialogue: 0,0:08:14.16,0:08:15.16,Default - Copy,Irene,0,0,0,,Тоқта
Dialogue: 0,0:08:15.16,0:08:18.13,Default - Copy,Irene,0,0,0,,Қазір күрессең де, Терезаны жеңе алмайсың.
Dialogue: 0,0:08:21.10,0:08:22.18,Default - Copy,Irene,0,0,0,,Прискила
Dialogue: 0,0:08:22.18,0:08:23.94,Default - Copy,Noel,0,0,0,,Кусо Гаки
Dialogue: 0,0:08:23.94,0:08:25.91,Default - Copy,Noel,0,0,0,,Басына қан жүгіреді
Dialogue: 0,0:08:26.98,0:08:28.11,Default - Copy,Irene,0,0,0,,Бұл абайсызда болды.
Dialogue: 0,0:08:28.74,0:08:31.28,Default - Copy,Irene,0,0,0,,Мен өз мүмкіндігіме тым көп көңіл бөлдім, бірақ
Dialogue: 0,0:08:31.88,0:08:33.72,Default - Copy,Irene,0,0,0,,Ол әлі бала еді
Dialogue: 0,0:08:35.08,0:08:35.93,Default - Copy,Irene,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:08:35.93,0:08:37.22,Default - Copy,Irene,0,0,0,,Ноэль София
Dialogue: 0,0:08:37.55,0:08:38.12,Default - Copy,Sophia,0,0,0,,Иә
Dialogue: 0,0:08:38.59,0:08:39.26,Default - Copy,Irene,0,0,0,,Мен сені қуамын
Dialogue: 0,0:08:39.72,0:08:43.50,Default - Copy,Irene,0,0,0,,Ол өзінің сыну нүктесін әлі де білмейді.
Dialogue: 0,0:09:07.62,0:09:08.75,Default - Copy,Teresa,0,0,0,,Тоқта.
Dialogue: 0,0:09:09.35,0:09:13.02,Default - Copy,Teresa,0,0,0,,Бұл кезеңде қанша тырыссаң да, мені жеңе алмайсың.
Dialogue: 0,0:09:21.10,0:09:22.90,Default - Copy,Teresa,0,0,0,,Оны қалдырыңыз.
Dialogue: 0,0:09:22.90,0:09:27.00,Default - Copy,Teresa,0,0,0,,Егер сіз бірден тым көп сиқырлы күш жіберсеңіз, қайтып орала алмайсыз.
Dialogue: 0,0:09:28.04,0:09:33.61,Default - Copy,Teresa,0,0,0,,Біз үшін жартылай адам және жартылай жындар, сиқырлы күшіміздің 10%-ын босатқанда көзіміздің түсі өзгереді.
Dialogue: 0,0:09:34.01,0:09:36.14,Default - Copy,Teresa,0,0,0,,Отыз пайыз және бет ерекшеліктері
Dialogue: 0,0:09:36.48,0:09:39.38,Default - Copy,Teresa,0,0,0,,Тіпті дене 50% өзгереді
Dialogue: 0,0:09:40.65,0:09:44.99,Default - Copy,Teresa,0,0,0,,Ал 80%-дан асса, қайтып орала алмайсың.
Dialogue: 0,0:09:45.59,0:09:49.52,Default - Copy,Teresa,0,0,0,,Сіз қазірдің өзінде 70% жоғары болуыңыз керек
Dialogue: 0,0:09:49.52,0:09:52.09,Default - Copy,Priscilla,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:09:58.00,0:09:59.80,Default - Copy,Priscilla,0,0,0,,Қанішер болғанына қарамастан
Dialogue: 0,0:09:59.80,0:10:02.17,Default - Copy,Priscilla,0,0,0,,Қанішер болғанына қарамастан
Dialogue: 0,0:10:06.92,0:10:12.92,Default - Copy,Teresa,0,0,0,,Сиқырлы қуатты босату шегі Ұрыста нені біртіндеп үйренесіз
Dialogue: 0,0:10:13.68,0:10:17.45,Default - Copy,Teresa,0,0,0,,Сізде тәжірибе ұпайлары жеткіліксіз.
Dialogue: 0,0:10:17.45,0:10:18.75,Default - Copy,Priscilla,0,0,0,,Үндетпе
Dialogue: 0,0:10:25.29,0:10:28.53,Default - Copy,Teresa,0,0,0,,Менің бүкіл денемнен үлкен көлемдегі жындық энергия атқылап жатыр.
Dialogue: 0,0:10:28.53,0:10:29.93,Default - Copy,Teresa,0,0,0,,Сіз ағынды мүлдем көре алмайсыз
Dialogue: 0,0:10:35.21,0:10:36.67,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:10:42.31,0:10:43.14,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:10:48.52,0:10:51.15,Default - Copy,Priscilla,0,0,0,,Әкеңді өлтірдің.
Dialogue: 0,0:10:51.15,0:10:52.62,Default - Copy,Priscilla,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:10:52.62,0:10:54.29,Default - Copy,Priscilla,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:10:54.29,0:10:56.31,Default - Copy,Priscilla,0,0,0,,өлтіру
Dialogue: 0,0:10:56.31,0:10:58.53,Default - Copy,Priscilla,0,0,0,,өлтіру
Dialogue: 0,0:11:00.23,0:11:02.80,Default - Copy,Teresa,0,0,0,,Сіз шатасып кете бастадыңыз ба?
Dialogue: 0,0:11:04.40,0:11:07.11,Default - Copy,Teresa,0,0,0,,Уақытымыз аз сияқты.
Dialogue: 0,0:11:08.10,0:11:11.61,Default - Copy,Teresa,0,0,0,,Көптен бері бірдеңені шындап істей алмай жүрмін
Dialogue: 0,0:11:32.89,0:11:33.59,Default - Copy,Noel,0,0,0,,Джо
Dialogue: 0,0:11:33.59,0:11:35.00,Default - Copy,Noel,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:11:35.30,0:11:38.10,Default - Copy,Noel,0,0,0,,Бұл екі ақымақ үлкен жындар қандай?
Dialogue: 0,0:11:38.60,0:11:39.50,Default - Copy,Sophia,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:11:39.83,0:11:44.34,Default - Copy,Sophia,0,0,0,,Осы екі құбыжыққа қарсы не істей аласың?
Dialogue: 0,0:11:44.91,0:11:48.11,Default - Copy,Irene,0,0,0,,Екі рух теңдессіз үлкен.
Dialogue: 0,0:11:48.11,0:11:48.88,Default - Copy,Irene,0,0,0,,Бірақ
Dialogue: 0,0:11:49.28,0:11:50.11,Default - Copy,Sophia,0,0,0,,Не?
Dialogue: 0,0:11:51.25,0:11:54.25,Default - Copy,Irene,0,0,0,,Біреуі екіншісінен әлдеқайда асып түседі.
Dialogue: 0,0:11:56.32,0:11:57.09,Default - Copy,Irene,0,0,0,,Қайсысы?
Dialogue: 0,0:12:11.27,0:12:12.37,Default - Copy,Noel,0,0,0,,Не?
Dialogue: 0,0:12:13.23,0:12:15.80,Default - Copy,Noel,0,0,0,,Бұл Присцилла ма?
Dialogue: 0,0:12:22.14,0:12:23.85,Default - Copy,Sophia,0,0,0,,Айрин
Dialogue: 0,0:12:23.85,0:12:26.81,Default - Copy,Irene,0,0,0,,Жоқ, біз әлі шектен асқан жоқпыз.
Dialogue: 0,0:12:27.25,0:12:31.22,Default - Copy,Irene,0,0,0,,Егер сіз оны қазір тоқтатсаңыз, оны қандай да бір жолмен адамдарға қайтара аласыз.
Dialogue: 0,0:12:32.09,0:12:34.39,Default - Copy,Irene,0,0,0,,Бірақ бұл не?
Dialogue: 0,0:12:35.16,0:12:39.63,Default - Copy,Irene,0,0,0,,Мұндай құдіретті күшті кім тоқтата алады?
Dialogue: 0,0:13:08.16,0:13:09.52,Default - Copy,Irene,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:13:10.33,0:13:12.53,Default - Copy,Irene,0,0,0,,Сол ақымақ үлкен Прискиланың күші
Dialogue: 0,0:13:13.53,0:13:17.97,Default - Copy,Irene,0,0,0,,Оны көздің түсін өзгертетін сиқырлы күш шығару арқылы жеңуге болады.
Dialogue: 0,0:13:20.54,0:13:25.67,Default - Copy,Irene,0,0,0,,Бұл өзінің сиқырлы күшін босатқан Терезаның шынайы күші ме?
Dialogue: 0,0:13:28.01,0:13:28.91,Default - Copy,Clare,0,0,0,,Тереза
Dialogue: 0,0:13:37.75,0:13:40.19,Default - Copy,Teresa,0,0,0,,Басқалар сізді естіп тұрғанша сөйлеңіз
Dialogue: 0,0:13:40.92,0:13:42.46,Default - Copy,Teresa,0,0,0,,Енді сіз білесіз
Dialogue: 0,0:13:43.06,0:13:45.66,Default - Copy,Teresa,0,0,0,,Жынды тез басып, адам кейпіне оралу
Dialogue: 0,0:13:48.13,0:13:49.67,Default - Copy,Teresa,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:13:50.60,0:13:52.80,Default - Copy,Teresa,0,0,0,,Бір рет қайтып орала алмасаң, тым кеш.
Dialogue: 0,0:13:57.11,0:13:58.27,Default - Copy,Priscilla,0,0,0,,Әке
Dialogue: 0,0:13:58.67,0:14:00.78,Default - Copy,Priscilla,0,0,0,,Маған әкемді қайтарыңыз
Dialogue: 0,0:14:03.28,0:14:06.51,Default - Copy,Priscilla,0,0,0,,Ол сондай мейірімді әке еді.
Dialogue: 0,0:14:07.55,0:14:10.72,Default - Copy,Priscilla,0,0,0,,Әкемді жақсы көрсем де
Dialogue: 0,0:14:10.72,0:14:12.52,Default - Copy,Priscilla,0,0,0,,Мен оны жедім.
Dialogue: 0,0:14:13.76,0:14:16.39,Default - Copy,Priscilla,0,0,0,,Менің алдымда
Dialogue: 0,0:14:16.39,0:14:21.00,Default - Copy,Priscilla,0,0,0,,Барлығының ішкі мүшелерін жедім.
Dialogue: 0,0:14:23.43,0:14:24.17,Default - Copy,Irene,0,0,0,,(Серо) Бастамас бұрын мен бұл жай ғана әуесқой деңгейде болады деп уайымдадым—
Dialogue: 0,0:14:29.34,0:14:32.31,Default - Copy,Priscilla,0,0,0,,Сондықтан мен оны өлтірдім.
Dialogue: 0,0:14:32.31,0:14:35.01,Default - Copy,Priscilla,0,0,0,,Әпкемді жеп жатқанда
Dialogue: 0,0:14:35.01,0:14:39.51,Default - Copy,Priscilla,0,0,0,,Мен әкемнің басын кесіп алдым
Dialogue: 0,0:14:52.59,0:14:55.60,Default - Copy,Irene,0,0,0,,Сыну нүктесінен тыс
Dialogue: 0,0:15:08.84,0:15:11.91,Default - Copy,Priscilla,0,0,0,,Мен қайтпаймын
Dialogue: 0,0:15:13.15,0:15:14.65,Default - Copy,Priscilla,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:15:15.72,0:15:17.12,Default - Copy,Priscilla,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:15:18.09,0:15:24.03,Default - Copy,Priscilla,0,0,0,,Мен жын болғым келмейді.
Dialogue: 0,0:15:24.56,0:15:25.29,Default - Copy,Irene,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:26.13,0:15:28.06,Default - Copy,Irene,0,0,0,,Жынға айналу ғана қалды.
Dialogue: 0,0:15:30.06,0:15:31.67,Default - Copy,Priscilla,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:15:31.67,0:15:33.23,Default - Copy,Priscilla,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:15:34.54,0:15:36.64,Default - Copy,Priscilla,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:15:38.71,0:15:39.64,Default - Copy,Teresa,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:15:40.24,0:15:43.35,Default - Copy,Teresa,0,0,0,,Мен сізге енді көмектесе алмаймын
Dialogue: 0,0:15:44.31,0:15:50.59,Default - Copy,Teresa,0,0,0,,Менің қолымнан келгені – жынға айналмай тұрып, басыңды кесіп тастау.
Dialogue: 0,0:16:07.04,0:16:08.44,Default - Copy,Priscilla,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:16:08.77,0:16:10.04,Default - Copy,Priscilla,0,0,0,,Достар...?
Dialogue: 0,0:16:10.91,0:16:16.64,Default - Copy,Priscilla,0,0,0,,Менде әлі адам жүрегі бар
Dialogue: 0,0:16:16.64,0:16:17.58,Default - Copy,Teresa,0,0,0,,Түсіндім
Dialogue: 0,0:16:18.61,0:16:20.85,Default - Copy,Teresa,0,0,0,,Мен сені қиналмай өлуге рұқсат етемін.
Dialogue: 0,0:16:39.93,0:16:40.74,Default - Copy,Clare,0,0,0,,Теле
Dialogue: 0,0:16:41.31,0:16:41.97,Default - Copy,Clare,0,0,0,,С
Dialogue: 0,0:17:02.06,0:17:03.73,Default - Copy,Noel,0,0,0,,Бұл не?
Dialogue: 0,0:17:04.46,0:17:10.57,Default - Copy,Irene,0,0,0,,Ол адам жыннан, адамнан мүлде басқа тіршілік иесінен асып түсті.
Dialogue: 0,0:17:12.17,0:17:13.40,Default - Copy,Irene,0,0,0,,Оянды
Dialogue: 0,0:17:25.05,0:17:26.68,Default - Copy,Priscilla,0,0,0,,Не?
Dialogue: 0,0:17:27.08,0:17:31.19,Default - Copy,Priscilla,0,0,0,,Ешқашан ештеңені ұстап тұрудың қажеті болмады.
Dialogue: 0,0:17:31.92,0:17:37.13,Default - Copy,Priscilla,0,0,0,,Мен оның соншалықты жақсы сезінгеніне сене алар емеспін
Dialogue: 0,0:17:44.37,0:17:46.37,Default - Copy,Irene,0,0,0,,құбыжық
Dialogue: 0,0:17:52.07,0:17:55.25,Default - Copy,Prisiclla,0,0,0,,Мен ішкі ағзаларды жегім келеді
Dialogue: 0,0:18:03.08,0:18:05.92,Default - Copy,Prisiclla,0,0,0,,Ішегі тірідей шығарылды
Dialogue: 0,0:18:05.92,0:18:09.96,Default - Copy,Prisiclla,0,0,0,,Қаныма сіңген бетіммен
Dialogue: 0,0:18:11.03,0:18:13.59,Default - Copy,Prisiclla,0,0,0,,Бір кесек ет қалмады
Dialogue: 0,0:18:14.10,0:18:17.93,Default - Copy,Prisiclla,0,0,0,,Мен барлық ішімдіктердің дәмін татқым келеді.
Dialogue: 0,0:18:27.08,0:18:27.91,Default - Copy,Prisiclla,0,0,0,,О.
Dialogue: 0,0:18:28.28,0:18:29.38,Default - Copy,Prisiclla,0,0,0,,Айрин
Dialogue: 0,0:18:30.51,0:18:32.05,Default - Copy,Prisiclla,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:18:32.38,0:18:34.62,Default - Copy,Prisiclla,0,0,0,,Менің сол қолым жоқ.
Dialogue: 0,0:18:39.05,0:18:39.79,Default - Copy,Prisiclla,0,0,0,,О.
Dialogue: 0,0:18:40.56,0:18:42.36,Default - Copy,Prisiclla,0,0,0,,Эй-эй, эй-эй
Dialogue: 0,0:18:42.96,0:18:44.29,Default - Copy,Prisiclla,0,0,0,,Сид?
Dialogue: 0,0:18:44.86,0:18:49.06,Default - Copy,Prisiclla,0,0,0,,Өз заттарыңызға қамқорлық жасаңыз
Dialogue: 0,0:18:58.17,0:19:00.18,Default - Copy,Irene,0,0,0,,Ноэль София
Dialogue: 0,0:19:01.71,0:19:03.01,Default - Copy,Priscilla,0,0,0,,Не?
Dialogue: 0,0:19:03.38,0:19:06.85,Default - Copy,Priscilla,0,0,0,,Бәрің мені өлтіруді жоспарлап отырсыңдар.
Dialogue: 0,0:19:11.55,0:19:15.42,Default - Copy,Priscilla,0,0,0,,Бірақ мүмкін емес шығар
Dialogue: 0,0:19:29.47,0:19:33.54,Default - Copy,Priscilla,0,0,0,,Қозғалғаным сонша, қарным ашты.
Dialogue: 0,0:19:34.78,0:19:37.91,Default - Copy,Priscilla,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:22:41.51,0:22:43.74,Default - Copy,,0,0,0,,Уақыт өтеді, уақыт толады
Dialogue: 0,0:22:44.18,0:22:46.51,Default - Copy,,0,0,0,,Қыз қылышты ұстады
Dialogue: 0,0:22:48.01,0:22:54.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory