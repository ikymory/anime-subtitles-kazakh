Dialogue: 1,0:00:02.38,0:00:05.79,OP-JP-1,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 1,0:00:05.83,0:00:08.87,OP-JP-1,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 1,0:00:08.91,0:00:12.61,OP-JP-1,,0,0,0,,Әрқашан жан-тәніңізбен ойнаңыз
Dialogue: 1,0:00:12.70,0:00:16.26,OP-JP-1,,0,0,0,,Көбірек ләззат ал, қыз.
Dialogue: 1,0:00:16.29,0:00:19.35,OP-JP-1,,0,0,0,,Ешкім байқамауы үшін
Dialogue: 1,0:00:19.59,0:00:23.15,OP-JP-1,,0,0,0,,Кеттік, Himouto Life
Dialogue: 1,0:00:28.46,0:00:31.70,OP-JP-1,,0,0,0,,Сүйікті сорғыш қақпағы
Dialogue: 1,0:00:31.75,0:00:34.99,OP-JP-1,,0,0,0,,Мен де бүгін өте жалқаумын.
Dialogue: 1,0:00:35.14,0:00:38.41,OP-JP-1,,0,0,0,,Қолымда менің сүйікті картоп чипсы
Dialogue: 1,0:00:38.53,0:00:41.70,OP-JP-1,,0,0,0,,Компьютерге қарап отырайық
Dialogue: 1,0:00:42.22,0:00:45.50,OP-JP-1,,0,0,0,,Тұрсаң, пион болады. Егер сіз отырсаңыз, сізде пион болады.
Dialogue: 1,0:00:45.63,0:00:49.13,OP-JP-1,,0,0,0,,Лилия гүліндей жүру
Dialogue: 1,0:00:49.25,0:00:52.46,OP-JP-1,,0,0,0,,Барлығы қызғанатын тамаша JK
Dialogue: 1,0:00:52.62,0:00:56.11,OP-JP-1,,0,0,0,,Қараңдаршы, кіре берістен өтсең, түрленесің.
Dialogue: 1,0:00:56.14,0:00:59.25,OP-JP-1,,0,0,0,,Жүр, гутара алайық.
Dialogue: 1,0:00:59.51,0:01:03.06,OP-JP-1,,0,0,0,,Кез келген уақытта тамақтану мен ұйықтаудың үштік комбинациясы.
Dialogue: 1,0:01:03.19,0:01:06.94,OP-JP-1,,0,0,0,,Ойындар әрқашан менің досым болды
Dialogue: 1,0:01:06.99,0:01:10.06,OP-JP-1,,0,0,0,,Менің ағам қатал, бірақ
Dialogue: 1,0:01:10.15,0:01:14.43,OP-JP-1,,0,0,0,,Сіз мені кешіретініңізге сенімдімін.
Dialogue: 1,0:01:14.49,0:01:19.34,OP-JP-1,,0,0,0,,Өзімшіл болу сүюге қарама-қарсы.
Dialogue: 1,0:01:19.34,0:01:22.39,OP-JP-1,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 1,0:01:22.47,0:01:25.89,OP-JP-1,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 1,0:01:27.63,0:01:29.05,OP-JP-1,,0,0,0,,Сәлем, соңы
Dialogue: 0,0:00:02.38,0:00:05.79,OP-JP-2,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 0,0:00:05.83,0:00:08.87,OP-JP-2,,0,0,0,,УМР УМР Бұл УМА емес, УМАРУ.
Dialogue: 0,0:00:08.91,0:00:12.61,OP-JP-2,,0,0,0,,Әрқашан жан-тәніңізбен ойнаңыз
Dialogue: 0,0:00:12.70,0:00:16.26,OP-JP-2,,0,0,0,,Көбірек ләззат ал, қыз.
Dialogue: 0,0:00:16.29,0:00:19.35,OP-JP-2,,0,0,0,,Ешкім байқамауы үшін
Dialogue: 0,0:00:19.59,0:00:23.15,OP-JP-2,,0,0,0,,Жүрейік Химоно апа өмір
Dialogue: 0,0:00:28.46,0:00:31.70,OP-JP-2,,0,0,0,,Сүйікті капюшон
Dialogue: 0,0:00:31.75,0:00:34.99,OP-JP-2,,0,0,0,,Мен де бүгін өте жалқаумын.
Dialogue: 0,0:00:35.14,0:00:38.41,OP-JP-2,,0,0,0,,Қолымда менің сүйікті картоп чипсы
Dialogue: 0,0:00:38.53,0:00:41.70,OP-JP-2,,0,0,0,,Компьютерге қарап отырайық
Dialogue: 0,0:00:42.22,0:00:45.50,OP-JP-2,,0,0,0,,Тұрсаң, пион болады. Сіз отырсаңыз, сізде пион болады.
Dialogue: 0,0:00:45.63,0:00:49.13,OP-JP-2,,0,0,0,,Жүру фигурасы лалагүл гүлі
Dialogue: 0,0:00:49.25,0:00:52.46,OP-JP-2,,0,0,0,,Барлығы қызғанатын мінсіз орта мектеп қызы
Dialogue: 0,0:00:52.62,0:00:56.11,OP-JP-2,,0,0,0,,Қараңдаршы, кіре берістен өтсең, түрленесің.
Dialogue: 0,0:00:56.14,0:00:59.25,OP-JP-2,,0,0,0,,Жүр, гутара ішейік.
Dialogue: 0,0:00:59.51,0:01:03.06,OP-JP-2,,0,0,0,,Кез келген уақытта тамақтану мен ұйықтаудың үштік комбинациясы.
Dialogue: 0,0:01:03.19,0:01:06.94,OP-JP-2,,0,0,0,,Ойындар әрқашан менің досым болды
Dialogue: 0,0:01:06.99,0:01:10.06,OP-JP-2,,0,0,0,,Менің ағам қатал, бірақ
Dialogue: 0,0:01:10.15,0:01:14.43,OP-JP-2,,0,0,0,,Сіз мені кешіретініңізге сенімдімін.
Dialogue: 0,0:01:14.49,0:01:19.34,OP-JP-2,,0,0,0,,Өзімшіл болу сүюге қарама-қарсы.
Dialogue: 0,0:01:19.34,0:01:22.39,OP-JP-2,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 0,0:01:22.47,0:01:25.89,OP-JP-2,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 0,0:01:27.63,0:01:29.05,OP-JP-2,,0,0,0,,Сәлем, соңы
Dialogue: 0,0:22:31.49,0:22:34.67,ED-JP,,0,0,0,,Әрқашан жанымда күліп тұрады
Dialogue: 0,0:22:34.67,0:22:37.17,ED-JP,,0,0,0,,Жылулықты сезіну
Dialogue: 0,0:22:37.59,0:22:44.01,ED-JP,,0,0,0,,Сондай жұмсақ уақыт
Dialogue: 0,0:22:45.57,0:22:49.05,ED-JP,,0,0,0,,Алыста жүрсем де түсінемін
Dialogue: 0,0:22:49.21,0:22:51.45,ED-JP,,0,0,0,,Бұзық көздер
Dialogue: 0,0:22:51.81,0:22:59.33,ED-JP,,0,0,0,,Сол кездейсоқ күндерді қабылдау
Dialogue: 0,0:22:59.33,0:23:01.53,ED-JP,,0,0,0,,Күтпеген атау
Dialogue: 0,0:23:02.63,0:23:04.53,ED-JP,,0,0,0,,Мен қоңырау шалып көрдім
Dialogue: 0,0:23:04.87,0:23:06.03,ED-JP,,0,0,0,,Мен жартылай ұйықтап жатырмын
Dialogue: 0,0:23:06.17,0:23:09.15,ED-JP,,0,0,0,,Адал сезімдер
Dialogue: 0,0:23:09.59,0:23:13.21,ED-JP,,0,0,0,,Мен сізге айта аламын ба?
Dialogue: 0,0:23:13.21,0:23:14.23,ED-JP,,0,0,0,,Рахмет
Dialogue: 0,0:23:14.29,0:23:16.11,ED-JP,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:23:16.11,0:23:21.27,ED-JP,,0,0,0,,Әрқашан жүзіңізден нұрлы күлкі кетпесін
Dialogue: 0,0:23:21.27,0:23:26.21,ED-JP,,0,0,0,,Жаяу мезгілі – асыл қазына
Dialogue: 0,0:23:27.59,0:23:33.07,ED-JP,,0,0,0,,Мен қашаннан бері ересек болған күнді армандаймын?
Dialogue: 0,0:23:33.07,0:23:40.63,ED-JP,,0,0,0,,Әзірше мен сенің жаныңда ұйықтайын.
Dialogue: 1,0:01:52.60,0:01:54.40,SUB-JPO,,0,0,0,,Умару-чан, не болды?
Dialogue: 1,0:01:55.58,0:01:57.90,SUB-JPO,,0,0,0,,Кешіріңіз, кеттік, Эбина-чан.
Dialogue: 1,0:02:20.46,0:02:21.96,SUB-JPO,,0,0,0,,Бұл менеджер
Dialogue: 1,0:02:23.80,0:02:25.12,SUB-JPO,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 1,0:02:26.52,0:02:28.56,SUB-JPO,,0,0,0,,"UMR"
Dialogue: 1,0:02:29.86,0:02:33.12,SUB-JPO,,0,0,0,,Әрекет, атыс, жекпе-жек және музыкалық ойындар
Dialogue: 1,0:02:33.42,0:02:36.02,SUB-JPO,,0,0,0,,Жанрына қарамастан барлық ойын түрлерін бағындырыңыз
Dialogue: 1,0:02:36.02,0:02:40.18,SUB-JPO,,0,0,0,,Сонымен қатар, оның тырна ойындарына қатысты данышпан сезімі бар.
Dialogue: 1,0:02:40.18,0:02:42.96,SUB-JPO,,0,0,0,,Кез келген жүлдені бір тиынмен ұрлауға болады.
Dialogue: 1,0:02:42.96,0:02:45.14,SUB-JPO,,0,0,0,,Осы дүкендегі ең қауіпті ойыншы
Dialogue: 1,0:02:45.14,0:02:47.68,SUB-JPO,,0,0,0,,Бұл «UMR»
Dialogue: 1,0:02:51.04,0:02:55.86,SUB-JPO,,0,0,0,,Бүгін ғана келген «Фукиген Нянкоро» қуыршағын байқадыңыз ба?
Dialogue: 1,0:02:56.32,0:02:59.14,SUB-JPO,,0,0,0,,Егер оның көп мөлшері алынып тасталса, бұл проблема болар еді.
Dialogue: 1,0:03:00.12,0:03:01.32,SUB-JPO,,0,0,0,,Қателер жоқ
Dialogue: 1,0:03:01.62,0:03:02.30,SUB-JPO,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 1,0:03:02.68,0:03:07.78,SUB-JPO,,0,0,0,,Бұл стендтегі жүлделер оңай алынбауы үшін орналастырылған.
Dialogue: 1,0:03:11.70,0:03:12.70,SUB-JPO,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 1,0:03:15.50,0:03:17.98,SUB-JPO,,0,0,0,,Ах, бұл «тег ілгегі»
Dialogue: 1,0:03:18.52,0:03:20.86,SUB-JPO,,0,0,0,,Тұлыпқа жапсырма ілу амалдары
Dialogue: 1,0:03:21.18,0:03:23.30,SUB-JPO,,0,0,0,,Үшеуі де бірден алынды.
Dialogue: 1,0:03:28.34,0:03:30.74,SUB-JPO,,0,0,0,,Сізді тағы бір кадрда алып кетесіз.
Dialogue: 1,0:03:30.74,0:03:32.36,SUB-JPO,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 1,0:03:33.14,0:03:35.72,SUB-JPO,,0,0,0,,Бұл сақиналарға бағытталған қораптың түрі.
Dialogue: 1,0:03:36.38,0:03:41.14,SUB-JPO,,0,0,0,,Қолдың күшін шегіне дейін әлсіретіп, кем дегенде 15 рет қозғалтпаса, ол құламайды.
Dialogue: 1,0:03:41.32,0:03:43.12,SUB-JPO,,0,0,0,,Мен көремін.
Dialogue: 1,0:03:49.46,0:03:51.90,SUB-JPO,,0,0,0,,Не?
Dialogue: 1,0:03:52.32,0:03:54.10,SUB-JPO,,0,0,0,,Бұл көтеріліп жатқан жоқ па?
Dialogue: 1,0:03:54.28,0:03:55.78,SUB-JPO,,0,0,0,,Бұл жолы мен оны пышақтап алдым
Dialogue: 1,0:03:55.78,0:03:59.46,SUB-JPO,,0,0,0,,Қолды қораптағы кішкене саңылауға салудың жетілдірілген техникасы
Dialogue: 1,0:04:07.90,0:04:08.56,SUB-JPO,,0,0,0,,Бұл
Dialogue: 1,0:04:09.76,0:04:11.58,SUB-JPO,,0,0,0,,Мен қалаған жүлде жоқ.
Dialogue: 1,0:04:12.04,0:04:13.32,SUB-JPO,,0,0,0,,Маған бере аласыз ба?
Dialogue: 1,0:04:15.90,0:04:17.96,SUB-JPO,,0,0,0,,немесе сүйкімді
Dialogue: 1,0:04:18.88,0:04:21.06,SUB-JPO,,0,0,0,,Э-э… ал 16:42-де ол Токио станциясының платформасында өлі күйінде табылды
Dialogue: 1,0:04:22.96,0:04:24.20,SUB-JPO,,0,0,0,,Мен білемін.
Dialogue: 1,0:04:25.00,0:04:28.54,SUB-JPO,,0,0,0,,Қаншалықты әдемі болсаң да, мен сені енді бір кадрда алып кетуге жол бермеймін.
Dialogue: 1,0:04:29.34,0:04:32.16,SUB-JPO,,0,0,0,,Білемін, мен де кәсіпқоймын.
Dialogue: 1,0:04:32.52,0:04:33.86,SUB-JPO,,0,0,0,,Жын параметрлерімен өтіңіз
Dialogue: 1,0:04:40.78,0:04:44.74,SUB-JPO,,0,0,0,,Бұл Ниагара тамшысы
Dialogue: 1,0:04:47.26,0:04:49.84,SUB-JPO,,0,0,0,,Тұлыптар үйіндісінің ауырлық центрін бұзу арқылы
Dialogue: 1,0:04:49.84,0:04:52.60,SUB-JPO,,0,0,0,,Ниагара сарқырамасы сияқты
Dialogue: 1,0:04:52.60,0:04:54.80,SUB-JPO,,0,0,0,,Түсіндірмеңіз, қарсы шара қолданыңыз
Сіз оны
Dialogue: 1,0:04:54.80,0:04:56.92,SUB-JPO,,0,0,0,,Кешіріңіз
Dialogue: 1,0:04:59.00,0:05:01.34,SUB-JPO,,0,0,0,,-де қайтадан алдыңыз ба?
Dialogue: 1,0:05:01.82,0:05:05.28,SUB-JPO,,0,0,0,,Мектептен қайтып келе жатып, аркаданың алдында тұрдым да, кенеттен келдім.
Dialogue: 1,0:05:05.80,0:05:08.36,SUB-JPO,,0,0,0,,Сол аркада да әрқашан апат.
Dialogue: 1,0:05:08.86,0:05:11.20,SUB-JPO,,0,0,0,,Менің айтайын дегенім, сізге бұл көп қажет емес.
Dialogue: 1,0:05:11.20,0:05:13.12,SUB-JPO,,0,0,0,,Олардың түсі әртүрлі.
Dialogue: 1,0:05:13.48,0:05:16.30,SUB-JPO,,0,0,0,,Сізді көргеніме қуаныштымын, Нянкоро.
Dialogue: 1,0:05:17.90,0:05:19.38,SUB-JPO,,0,0,0,,Ма Икка
Dialogue: 1,0:05:20.50,0:05:22.94,SUB-JPO,,0,0,0,,Бірақ сіз тұлыптарды жақсы көресіз.
Dialogue: 1,0:05:24.04,0:05:26.54,SUB-JPO,,0,0,0,,Умару Сағат 12 болып қалды. Мен ұйықтаймын.
Dialogue: 1,0:05:27.62,0:05:29.54,SUB-JPO,,0,0,0,,Мен түнгі аниме көргім келеді
Dialogue: 1,0:05:29.54,0:05:30.70,SUB-JPO,,0,0,0,,Сіз жазып жатырсыз, солай ма?
Dialogue: 1,0:05:52.00,0:05:54.26,SUB-JPO,,0,0,0,,Умару, мектепке баратын уақыт аз қалды.
Dialogue: 1,0:05:55.82,0:05:58.22,SUB-JPO,,0,0,0,,Мен әлі де жатқым келеді
Dialogue: 1,0:05:58.22,0:06:01.16,SUB-JPO,,0,0,0,,Қараңдаршы, бүгінгі дене шынықтыру сабағы теннис.
Dialogue: 1,0:06:01.16,0:06:03.30,SUB-JPO,,0,0,0,,Менің қозғалғым келмейді
Dialogue: 1,0:06:08.84,0:06:11.40,SUB-JPO,,0,0,0,,Умару-чан, теннис киімі де саған жарасады.
Dialogue: 1,0:06:11.74,0:06:13.28,SUB-JPO,,0,0,0,,Хе-хе-хе…
Dialogue: 1,0:06:14.40,0:06:18.64,SUB-JPO,,0,0,0,,Мен шаршадым, үйге барғым келеді, онлайн ойындар ойнағым келеді
Dialogue: 1,0:06:21.26,0:06:24.96,SUB-JPO,,0,0,0,,Мен теннис туралы тек аниме мен мангадан білемін.
Dialogue: 1,0:06:33.46,0:06:36.54,SUB-JPO,,0,0,0,,Допқа үйренуден бастайық.
Dialogue: 1,0:06:41.68,0:06:43.86,SUB-JPO,,0,0,0,,Бұл оңай және қызықты болуы мүмкін
Dialogue: 1,0:06:44.46,0:06:45.28,SUB-JPO,,0,0,0,,Умару-сан
Dialogue: 1,0:06:47.68,0:06:49.22,SUB-JPO,,0,0,0,,Тачибана-сан
Dialogue: 1,0:06:49.52,0:06:51.72,SUB-JPO,,0,0,0,,Мен сенің менімен жарысқаныңды қалаймын.
Dialogue: 1,0:06:51.90,0:06:53.96,SUB-JPO,,0,0,0,,Мен теннисте жеңіле алмаймын.
Dialogue: 1,0:06:54.88,0:06:58.42,SUB-JPO,,0,0,0,,Жоқ, бірақ пальто көп емес.
Dialogue: 1,0:06:58.76,0:07:02.68,SUB-JPO,,0,0,0,,Уайымдама, менде бір пальто бар.
Dialogue: 1,0:07:05.88,0:07:06.84,SUB-JPO,,0,0,0,,Не
Dialogue: 1,0:07:06.84,0:07:08.84,SUB-JPO,,0,0,0,,Умару-чан матч өткізіп жатыр.
Dialogue: 1,0:07:11.22,0:07:13.68,SUB-JPO,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 1,0:07:15.24,0:07:20.58,SUB-JPO,,0,0,0,,Мм, мен теннис ойнай алмаймын, бірақ бәрі жақсы деп ойлаймын.
Dialogue: 1,0:07:21.10,0:07:22.60,SUB-JPO,,0,0,0,,Уайымдамаңыз.
Dialogue: 1,0:07:22.60,0:07:26.14,SUB-JPO,,0,0,0,,Мен барлық сервистер мен барлық соққыларға жауапты боламын.
Dialogue: 1,0:07:29.06,0:07:30.30,SUB-JPO,,0,0,0,,Ойынның басталуы
Dialogue: 1,0:07:32.16,0:07:34.54,SUB-JPO,,0,0,0,,Галереялар өте көп.
Dialogue: 1,0:07:35.02,0:07:36.90,SUB-JPO,,0,0,0,,Бос сіріңке жақсы.
Dialogue: 1,0:07:36.90,0:07:41.34,SUB-JPO,,0,0,0,,Умару-сан, бүгін мен ең жақсы боламын және саған көрсетемін.
Dialogue: 1,0:07:42.86,0:07:44.52,SUB-JPO,,0,0,0,,Мен барамын
Dialogue: 1,0:07:46.04,0:07:48.40,SUB-JPO,,0,0,0,,Canzone Silfin Smash
Dialogue: 1,0:07:51.64,0:07:53.60,SUB-JPO,,0,0,0,,Керемет қызмет
Dialogue: 1,0:07:53.60,0:07:54.70,SUB-JPO,,0,0,0,,Бұл кәсіби жарыс.
Dialogue: 1,0:07:54.70,0:07:56.90,SUB-JPO,,0,0,0,,Дәлірек айтсақ, өзіңіздің атыңыз жазылған техникаларыңызды жасаңыз.
Dialogue: 1,0:07:57.78,0:07:59.34,SUB-JPO,,0,0,0,,Мүлдем бос емес
Dialogue: 1,0:07:59.72,0:08:01.34,SUB-JPO,,0,0,0,,Мынадай нәрсе
Dialogue: 1,0:08:10.18,0:08:12.30,SUB-JPO,,0,0,0,,Сіз нені айтасыз?
Dialogue: 1,0:08:13.78,0:08:15.92,SUB-JPO,,0,0,0,,Silfin Ebina командасына қызмет етіңіз
Dialogue: 1,0:08:16.84,0:08:20.02,SUB-JPO,,0,0,0,,Бо Допты көтеріп, соғу керек.
Dialogue: 1,0:08:23.92,0:08:26.72,SUB-JPO,,0,0,0,,Эбихара мырза, сіз неге көзіңізді жұмып отырсыз?
Dialogue: 1,0:08:26.72,0:08:29.80,SUB-JPO,,0,0,0,,Кешіріңіз, бұл Эбина.
Dialogue: 1,0:08:30.34,0:08:32.46,SUB-JPO,,0,0,0,,Эбина-чан, қиын сияқты.
Dialogue: 1,0:08:34.72,0:08:37.00,SUB-JPO,,0,0,0,,Умару Кири командасына қызмет етіңіз
Dialogue: 1,0:08:38.08,0:08:40.58,SUB-JPO,,0,0,0,,Эбина-чан, көзіңді жұму қауіпті.
Dialogue: 1,0:08:40.82,0:08:42.30,SUB-JPO,,0,0,0,,Оны әлсіз қызмет етіңіз
Dialogue: 1,0:08:44.84,0:08:46.42,SUB-JPO,,0,0,0,,Мен түсіндім.
Dialogue: 1,0:08:47.34,0:08:48.26,SUB-JPO,,0,0,0,,...
Dialogue: 1,0:08:50.08,0:08:52.48,SUB-JPO,,0,0,0,,Сильфин мырза, жақсысыз ба?
Dialogue: 1,0:08:52.74,0:08:55.18,SUB-JPO,,0,0,0,,Уайымдамаңыз.
Dialogue: 1,0:08:58.44,0:08:59.38,SUB-JPO,,0,0,0,,...
Dialogue: 1,0:09:00.96,0:09:02.68,SUB-JPO,,0,0,0,,Неліктен алысқа бардың?
Dialogue: 1,0:09:03.62,0:09:05.46,SUB-JPO,,0,0,0,,Сол Сильфин-сан
Dialogue: 1,0:09:05.80,0:09:07.52,SUB-JPO,,0,0,0,,Жарайды.
Dialogue: 1,0:09:08.10,0:09:11.20,SUB-JPO,,0,0,0,,Умару-сан күткендей, сіздің қызметіңіз керемет.
Dialogue: 1,0:09:11.20,0:09:14.38,SUB-JPO,,0,0,0,,Міне, мен үшін де жекпе-жек құнды.
Dialogue: 1,0:09:14.64,0:09:16.84,SUB-JPO,,0,0,0,,Енді шайқас басталады.
Dialogue: 1,0:09:23.28,0:09:25.08,SUB-JPO,,0,0,0,,Бос сіріңке жақсы.
Dialogue: 1,0:09:25.66,0:09:26.86,SUB-JPO,,0,0,0,,...
Dialogue: 1,0:09:33.04,0:09:35.60,SUB-JPO,,0,0,0,,Canzone Silfin Smash
Dialogue: 1,0:09:38.96,0:09:40.14,SUB-JPO,,0,0,0,,Мен қорғаймын
Dialogue: 1,0:09:40.50,0:09:41.70,SUB-JPO,,0,0,0,,Мен Кири Чанды жақсы көремін
Dialogue: 1,0:09:44.60,0:09:45.48,SUB-JPO,,0,0,0,,Эбимори мырза
Dialogue: 1,0:09:45.48,0:09:46.70,SUB-JPO,,0,0,0,,Бұл Эбина
Dialogue: 1,0:09:46.94,0:09:48.48,SUB-JPO,,0,0,0,,Sylphin Smash
Dialogue: 1,0:09:48.70,0:09:49.84,SUB-JPO,,0,0,0,,Кири-чан
Dialogue: 1,0:09:51.64,0:09:52.92,SUB-JPO,,0,0,0,,Эбикура мырза
Dialogue: 1,0:09:52.92,0:09:53.86,SUB-JPO,,0,0,0,,Бұл Эбина
Dialogue: 1,0:10:08.42,0:10:09.22,SUB-JPO,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 1,0:10:09.94,0:10:12.14,SUB-JPO,,0,0,0,,Жоқ, мен қозғала алмаймын.
Dialogue: 1,0:10:17.16,0:10:18.24,SUB-JPO,,0,0,0,,Тайхэй Сенпай
Dialogue: 1,0:10:18.72,0:10:22.94,SUB-JPO,,0,0,0,,Күні кеше Еуропадағы ағамның үйіне барып, кәдесыйлар сатып алдым.
Dialogue: 1,0:10:23.84,0:10:26.78,SUB-JPO,,0,0,0,,Иә, бұл өте жаман.
Dialogue: 1,0:10:27.48,0:10:29.88,SUB-JPO,,0,0,0,,Мен ағама ұнайтын нәрсені кездестірдім, сондықтан мен шештім
Dialogue: 1,0:10:31.20,0:10:32.98,SUB-JPO,,0,0,0,,Рахмет сізге Алекс
Dialogue: 1,0:10:33.52,0:10:35.86,SUB-JPO,,0,0,0,,Оны бағалаңыз.
Dialogue: 1,0:10:42.56,0:10:44.48,SUB-JPO,,0,0,0,,Бұл басы қозғалатын мысық мүсіні сияқты.
Dialogue: 1,0:10:44.88,0:10:47.88,SUB-JPO,,0,0,0,,Оның керамикаға ұқсауы сүйкімді емес деп ойлаймын.
Dialogue: 1,0:10:47.88,0:10:51.50,SUB-JPO,,0,0,0,,Әрбір бұйымды басқа елдің шебері жасаған деп айтылды.
Dialogue: 1,0:10:52.28,0:10:56.52,SUB-JPO,,0,0,0,,Бірақ мен өзім сабақ берген кіші сыныптан сыйлық алған емеспін.
Dialogue: 1,0:10:56.52,0:10:58.60,SUB-JPO,,0,0,0,,Мен өте эмоционалды сезінемін.
Dialogue: 1,0:10:58.90,0:11:00.90,SUB-JPO,,0,0,0,,Танысқаныма қуаныштымын, мен Алекспін.
Dialogue: 1,0:11:01.20,0:11:04.10,SUB-JPO,,0,0,0,,Ақырында ол адам сіздің бастығыңызға айналады.
Dialogue: 1,0:11:05.10,0:11:07.78,SUB-JPO,,0,0,0,,Тайхэй-кун, бұл басқаша.
Dialogue: 1,0:11:12.78,0:11:14.78,SUB-JPO,,0,0,0,,Оны осында сақтаңыз, бірақ жоймаңыз.
Dialogue: 1,0:11:15.06,0:11:17.36,SUB-JPO,,0,0,0,,Бұл сүйкімді емес, сондықтан мен оған тиіспеймін.
Dialogue: 1,0:11:25.74,0:11:28.32,SUB-JPO,,0,0,0,,Жабайы Хамзабуро пайда болды.
Dialogue: 1,0:11:28.32,0:11:31.12,SUB-JPO,,0,0,0,,Металл Нянкос Мен сені таңдаймын
Dialogue: 1,0:11:31.12,0:11:33.36,SUB-JPO,,0,0,0,,Металл Нянкостың «басыңды шайқауы»
Dialogue: 1,0:11:36.02,0:11:38.76,SUB-JPO,,0,0,0,,Хамзабуроның қорғаныс күші айтарлықтай төмендеді.
Dialogue: 1,0:11:38.76,0:11:42.48,SUB-JPO,,0,0,0,,Хам Сабуроның өмірі төмен. Оны алу мүмкіндігі.
Dialogue: 1,0:11:42.48,0:11:45.24,SUB-JPO,,0,0,0,,Ау, ауырып тұр
Dialogue: 1,0:11:50.46,0:11:54.06,SUB-JPO,,0,0,0,,Металл Нянкос әлсіз
Dialogue: 1,0:11:57.14,0:11:59.28,SUB-JPO,,0,0,0,,Қазір ондай нәрсені жасайтын уақыт емес.
Dialogue: 1,0:11:59.28,0:12:01.32,SUB-JPO,,0,0,0,,Ағам ұрсады
Dialogue: 1,0:12:01.32,0:12:03.96,SUB-JPO,,0,0,0,,Бұзбаңдар деп көп айттым.
Dialogue: 1,0:12:03.96,0:12:07.22,SUB-JPO,,0,0,0,,Затына мән бермейтін адамнан ештеңе сатып алмаймын.
Dialogue: 1,0:12:12.06,0:12:14.40,SUB-JPO,,0,0,0,,Жөндеу жұмыстары қазір басталады.
Dialogue: 1,0:12:15.44,0:12:18.96,SUB-JPO,,0,0,0,,Бұл анықталған кезде ұрысу - уәде етілген және белгілі болашақ.
Dialogue: 1,0:12:19.60,0:12:23.98,SUB-JPO,,0,0,0,,Бұны болдырмаудың жалғыз жолы - оның жойылғанын жою.
Dialogue: 1,0:12:26.56,0:12:28.86,SUB-JPO,,0,0,0,,Умарудың өнердегі деңгейі – 5
Dialogue: 1,0:12:29.46,0:12:34.26,SUB-JPO,,0,0,0,,Умару себеп пен салдарды басқару үшін қолдарын пайдаланады және оған ұрыспайтын болашақты алады.
Dialogue: 1,0:12:36.38,0:12:39.90,SUB-JPO,,0,0,0,,Бұл мойын қозғалысы жүйесі «Akabeko» сияқты.
Dialogue: 1,0:12:40.32,0:12:43.66,SUB-JPO,,0,0,0,,Сынған жерді күшті желіммен бекітіңіз.
Dialogue: 1,0:12:43.66,0:12:45.94,SUB-JPO,,0,0,0,,Буындарды замазкамен толтырыңыз
Dialogue: 1,0:12:46.48,0:12:49.20,SUB-JPO,,0,0,0,,Құрғақ жерде тегістеуішпен өңдеу
Dialogue: 1,0:12:50.46,0:12:54.80,SUB-JPO,,0,0,0,,Винтаж дәмін бұзбау үшін бояу жанасуға сәйкес келеді.
Dialogue: 1,0:12:56.54,0:12:58.62,SUB-JPO,,0,0,0,,Бас жарақаты ауыр.
Dialogue: 1,0:12:58.82,0:13:01.50,SUB-JPO,,0,0,0,,Бұл жерде толық сызат жасаған дұрыс.
Dialogue: 1,0:13:08.10,0:13:11.24,SUB-JPO,,0,0,0,,Бет есімде жоқ...
Dialogue: 1,0:13:11.96,0:13:14.80,SUB-JPO,,0,0,0,,Бұл әлдеқашан көне.
Dialogue: 1,0:13:14.80,0:13:18.22,SUB-JPO,,0,0,0,,Менің ойымша, ол аздап сүйкімді көрінді.
Dialogue: 1,0:13:18.84,0:13:21.70,SUB-JPO,,0,0,0,,Умарудың жады қайта жаңғырды
Dialogue: 1,0:13:31.46,0:13:33.12,SUB-JPO,,0,0,0,,басқа.
Dialogue: 1,0:13:34.90,0:13:37.66,SUB-JPO,,0,0,0,,Еріксіз тағы бір бет пайда болады
Dialogue: 1,0:13:37.66,0:13:41.58,SUB-JPO,,0,0,0,,Ағам қайтып келгенше, мен мұны істеуім керек.
Dialogue: 1,0:13:46.10,0:13:47.14,SUB-JPO,,0,0,0,,Кешіріңіз
Dialogue: 1,0:13:47.64,0:13:50.04,SUB-JPO,,0,0,0,,Ол бұзылып, қайта салынды.
Dialogue: 1,0:13:50.94,0:13:51.48,SUB-JPO,,0,0,0,,Иә
Dialogue: 1,0:13:52.50,0:13:54.24,SUB-JPO,,0,0,0,,Жарайды, бұзғаныңыз жақсы болды.
Dialogue: 1,0:13:55.12,0:13:57.62,SUB-JPO,,0,0,0,,Егер сіз кінәлі деп есептеп, дұрыстап кешірім сұрасаңыз, ашуланбайсыз.
Dialogue: 1,0:13:57.86,0:13:59.54,SUB-JPO,,0,0,0,,Үлкен аға
Dialogue: 1,0:14:01.00,0:14:02.14,SUB-JPO,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 1,0:14:02.60,0:14:03.68,SUB-JPO,,0,0,0,,Дәл солай, ақымақ
Dialogue: 1,0:14:04.76,0:14:08.14,SUB-JPO,,0,0,0,,Мұны жасыру үшін қандай құралдарды қолдандың? Сіз оны қалай сатып алдыңыз?
Dialogue: 1,0:14:09.16,0:14:13.08,SUB-JPO,,0,0,0,,Ал, үй орталығында... картамен...
Dialogue: 1,0:14:13.40,0:14:16.00,SUB-JPO,,0,0,0,,Менің PIN кодын қайдан білесіз?
Dialogue: 1,0:14:24.44,0:14:26.44,SUB-JPO,,0,0,0,,Эй, қабылда, жоқ.
Dialogue: 1,0:14:27.14,0:14:29.52,SUB-JPO,,0,0,0,,Міне!
Dialogue: 1,0:14:34.76,0:14:38.58,SUB-JPO,,0,0,0,,Өйткені, 5-комбодағы сілтеме әлі тәтті.
Dialogue: 1,0:14:38.92,0:14:41.50,SUB-JPO,,0,0,0,,Үлгіні қайта қарастырайық
Dialogue: 1,0:14:42.14,0:14:43.16,SUB-JPO,,0,0,0,,Мен үйдемін
Dialogue: 1,0:14:44.52,0:14:45.56,SUB-JPO,,0,0,0,,Ойын турнирі?
Dialogue: 1,0:14:46.12,0:14:50.50,SUB-JPO,,0,0,0,,Біз аркадада жекпе-жек турнирін өткізіп жатырмыз, онда бұрын рок-қағаз-қайшы турнирі болған.
Dialogue: 1,0:14:50.74,0:14:53.88,SUB-JPO,,0,0,0,,А, иә, бірге барайық, ағайын.
Dialogue: 1,0:15:00.58,0:15:04.20,SUB-JPO,,0,0,0,,Жарайды, Умару тіркеледі, сондықтан осында қалуға болады.
Dialogue: 1,0:15:04.36,0:15:05.52,SUB-JPO,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 1,0:15:08.08,0:15:09.72,SUB-JPO,,0,0,0,,Бұл Тайхей-сенпай емес пе?
Dialogue: 1,0:15:11.30,0:15:12.28,SUB-JPO,,0,0,0,,Алекс
Dialogue: 1,0:15:12.54,0:15:16.76,SUB-JPO,,0,0,0,,Біздің компаниядан тыс жерде және осындай жерде кездесуіміз әдеттен тыс.
Dialogue: 1,0:15:16.76,0:15:19.68,SUB-JPO,,0,0,0,,Иә, мен бүгін апама еріп жүрдім.
Dialogue: 1,0:15:20.10,0:15:22.10,SUB-JPO,,0,0,0,,Бұл біртүрлі кездейсоқтық. Мен де...
Dialogue: 1,0:15:29.26,0:15:32.86,SUB-JPO,,0,0,0,,Ханымдар мен мырзалар, бүгінгі күнге қош келдіңіздер.
Dialogue: 1,0:15:33.36,0:15:36.36,SUB-JPO,,0,0,0,,Бұдан былай «Sube 4» нөмірі бірінші шешуші матч…
Dialogue: 1,0:15:38.28,0:15:39.68,SUB-JPO,,0,0,0,,Жасау
Dialogue: 1,0:15:43.96,0:15:46.96,SUB-JPO,,0,0,0,,Уау... кенет атмосфера пайда болды...
Dialogue: 1,0:15:46.96,0:15:49.18,SUB-JPO,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 1,0:15:50.08,0:15:53.06,SUB-JPO,,0,0,0,,“Sube4” – бүкіл әлемде өте танымал жекпе-жек ойыны.
Dialogue: 1,0:15:53.22,0:15:56.68,SUB-JPO,,0,0,0,,Рейтингтік шайқас бүкіл Жапониядағы аркадаларда өтті.
Dialogue: 1,0:15:57.96,0:16:01.84,SUB-JPO,,0,0,0,,Бұл турнирге бүкіл ел бойынша аркадаларда бірінші орын алған үздік ойыншылар ғана жиналады.
Dialogue: 1,0:16:02.12,0:16:04.82,SUB-JPO,,0,0,0,,Бұл нағыз мықты жекпе-жек ойыншысын анықтауға арналған турнир.
Dialogue: 1,0:16:05.68,0:16:09.74,SUB-JPO,,0,0,0,,Бұл барлық жауынгерлік ойын жанкүйерлері асыға күткен турнир.
Dialogue: 1,0:16:10.20,0:16:11.80,SUB-JPO,,0,0,0,,Эй...эй
Dialogue: 1,0:16:13.08,0:16:14.98,SUB-JPO,,0,0,0,,Енді оларды көрсетейік.
Dialogue: 1,0:16:14.98,0:16:19.64,SUB-JPO,,0,0,0,,Еліміздегі ең бәсекеге қабілетті аймақ болған біздің дүкенді жеңіп алған чемпион
Dialogue: 1,0:16:25.38,0:16:28.04,SUB-JPO,,0,0,0,,UMR
Dialogue: 1,0:16:30.14,0:16:31.86,SUB-JPO,,0,0,0,,Осы дүкеннің патшасынан күткендей
Dialogue: 1,0:16:32.32,0:16:33.72,SUB-JPO,,0,0,0,,Аура басқаша.
Dialogue: 1,0:16:34.48,0:16:36.22,SUB-JPO,,0,0,0,,Дұрыс... дұрыс.
Мен бұл туралы
Dialogue: 1,0:16:37.40,0:16:39.86,SUB-JPO,,0,0,0,,Умару Ол шынымен де күшті болды ма?
Dialogue: 1,0:16:40.22,0:16:43.56,SUB-JPO,,0,0,0,,Әрі қарай еліміздің түкпір-түкпірінен келген қаһарлы жауынгерлерді таныстырамыз.
Dialogue: 1,0:16:46.94,0:16:51.58,SUB-JPO,,0,0,0,,UZR
Dialogue: 1,0:16:51.82,0:16:54.57,SUB-JPO,,0,0,0,,Біз жат планеталықтармыз
Dialogue: 1,0:16:55.92,0:16:59.98,SUB-JPO,,0,0,0,,JNB
Dialogue: 1,0:17:05.76,0:17:10.48,SUB-JPO,,0,0,0,,DDT
Dialogue: 1,0:17:12.74,0:17:17.90,SUB-JPO,,0,0,0,,Кіші орта мектеп оқушысының белсенді ойыншысы C.H.J.
Dialogue: 1,0:17:18.80,0:17:24.92,SUB-JPO,,0,0,0,,Негізгі кәсібі манга суретшісі С.К.Х.
Dialogue: 1,0:17:28.68,0:17:32.14,SUB-JPO,,0,0,0,,Керемет. Олардың барлығы ойын әлемінде әйгілі және қатал.
Dialogue: 1,0:17:32.52,0:17:34.72,SUB-JPO,,0,0,0,,Бұл оңай болмауы мүмкін.
Dialogue: 1,0:17:35.78,0:17:39.24,SUB-JPO,,0,0,0,,Соңында осы турнирдің қара тұлпары
Dialogue: 1,0:17:40.54,0:17:43.72,SUB-JPO,,0,0,0,,Іріктеу турнирінде шектен тыс ұпай жинаған ойыншы
Dialogue: 1,0:17:44.58,0:17:50.56,SUB-JPO,,0,0,0,,１ TSF
Dialogue: 1,0:18:01.34,0:18:05.32,SUB-JPO,,0,0,0,,UMR бірінші раундының жеңімпазы
Dialogue: 1,0:18:10.34,0:18:11.20,SUB-JPO,,0,0,0,,Неліктен?
Dialogue: 1,0:18:11.54,0:18:14.94,SUB-JPO,,0,0,0,,Менің сыныбымдағы Тачибана мырза ойын турниріне не үшін барады?
Dialogue: 1,0:18:15.60,0:18:19.32,SUB-JPO,,0,0,0,,Ойланып қарасам, түрлі турнирлерге қатысып жүргеніңізді естіген шығармын.
Dialogue: 1,0:18:20.16,0:18:22.08,SUB-JPO,,0,0,0,,Мен оны үйден әкелдім.
Dialogue: 1,0:18:22.90,0:18:24.78,SUB-JPO,,0,0,0,,Мен сенің ойындарды жақсы көретініңді білмедім.
Dialogue: 1,0:18:25.14,0:18:27.42,SUB-JPO,,0,0,0,,Умару мұны білмейді деп үміттенемін.
Dialogue: 1,0:18:28.50,0:18:29.94,SUB-JPO,,0,0,0,,Сильфинкик
Dialogue: 1,0:18:30.16,0:18:31.46,SUB-JPO,,0,0,0,,Гибсон
Dialogue: 1,0:18:33.10,0:18:33.70,SUB-JPO,,0,0,0,,Эй, эй
Dialogue: 1,0:18:33.70,0:18:37.00,SUB-JPO,,0,0,0,,Бұл Тачибана Сильфинфордтың жеңісі.
Dialogue: 1,0:18:37.68,0:18:39.58,SUB-JPO,,0,0,0,,Мм, TSF мырза
Dialogue: 1,0:18:40.36,0:18:43.56,SUB-JPO,,0,0,0,,Мүмкін болса, бетперде киіп, шын атыңызды қолданбауыңызды қалаймын...
Dialogue: 1,0:18:44.64,0:18:46.50,SUB-JPO,,0,0,0,,Менің жеке ақпаратым тарап кетті.
Dialogue: 1,0:18:48.32,0:18:50.58,SUB-JPO,,0,0,0,,Енді финал
Dialogue: 1,0:18:51.34,0:18:53.84,SUB-JPO,,0,0,0,,Жекпе-жек ойындары тез өтеді.
Dialogue: 1,0:18:54.82,0:18:57.44,SUB-JPO,,0,0,0,,Ең мықты ойыншы анықталды
Dialogue: 1,0:18:58.00,0:19:02.30,SUB-JPO,,0,0,0,,T.S.F және U.M.R.
Dialogue: 1,0:19:03.00,0:19:04.96,SUB-JPO,,0,0,0,,Танысқаныма қуаныштымын, UMR
Dialogue: 1,0:19:04.96,0:19:07.86,SUB-JPO,,0,0,0,,Мен Тачибана Сильфинфордпын.
Dialogue: 1,0:19:07.86,0:19:10.34,SUB-JPO,,0,0,0,,Сондықтан бетперде киіп, шын атыңызды қолданбаңыз.
Dialogue: 1,0:19:10.96,0:19:12.74,SUB-JPO,,0,0,0,,Жақсы, мен білмедім.
Dialogue: 1,0:19:16.54,0:19:19.88,SUB-JPO,,0,0,0,,Бұл Көлденең Sylphinky
Dialogue: 1,0:19:21.72,0:19:24.22,SUB-JPO,,0,0,0,,TSF Кенеттен үлкен қозғалыс
Dialogue: 1,0:19:27.24,0:19:29.84,SUB-JPO,,0,0,0,,UMR Бұны жылдам болдырмаңыз
Dialogue: 1,0:19:29.84,0:19:31.92,SUB-JPO,,0,0,0,,Бұл жоғары деңгейдегі шайқас.
Dialogue: 1,0:19:32.90,0:19:36.44,SUB-JPO,,0,0,0,,Кенеттен вакуумдық супер өлтіру командасын жоғары қиындықпен орындайды.
Dialogue: 1,0:19:36.44,0:19:39.20,SUB-JPO,,0,0,0,,Егер сіз оған шынымен құмар болмасаңыз, бұл мүмкін емес.
Dialogue: 1,0:19:39.20,0:19:40.94,SUB-JPO,,0,0,0,,Сіз мұны жақсы болдыңыз.
Dialogue: 1,0:19:40.94,0:19:44.50,SUB-JPO,,0,0,0,,Бірақ секіргеніңіз сіздің күзетіңіздің ашық екенін білдіреді.
Dialogue: 1,0:19:44.50,0:19:46.72,SUB-JPO,,0,0,0,,TSF үздіксіз комбо
Dialogue: 1,0:19:46.72,0:19:50.16,SUB-JPO,,0,0,0,,Бірақ UMR мұның бәрін блоктайды
Dialogue: 1,0:19:50.16,0:19:50.98,SUB-JPO,,0,0,0,,Мұнда
Dialogue: 1,0:19:51.34,0:19:53.16,SUB-JPO,,0,0,0,,UMR комбинациясы
Dialogue: 1,0:19:56.04,0:19:58.22,SUB-JPO,,0,0,0,,5 комбо маған ұнады.
Dialogue: 1,0:19:58.96,0:20:02.94,SUB-JPO,,0,0,0,,Өйткені, 5-ші комбинациядағы байланыс әлі тәтті.
Dialogue: 1,0:20:03.60,0:20:05.10,SUB-JPO,,0,0,0,,О... оқылып жатыр.
Dialogue: 1,0:20:07.50,0:20:11.72,SUB-JPO,,0,0,0,,Ой, UMR комбо бұдан былай TSF арқылы анықталмайды.
Dialogue: 1,0:20:11.72,0:20:13.50,SUB-JPO,,0,0,0,,Бұл ойын болды ма?
Dialogue: 1,0:20:14.86,0:20:16.38,SUB-JPO,,0,0,0,,Мен не істеуім керек? Мен жеңілемін.
Dialogue: 1,0:20:19.20,0:20:23.42,SUB-JPO,,0,0,0,,Ағама күшімді көрсеткім келді.
Dialogue: 1,0:20:24.52,0:20:26.46,SUB-JPO,,0,0,0,,UMR қозғалысы тоқтатылды
Dialogue: 1,0:20:26.46,0:20:29.20,SUB-JPO,,0,0,0,,TSF Бұл тамаша мүмкіндік
Dialogue: 1,0:20:29.74,0:20:32.54,SUB-JPO,,0,0,0,,Матч кезінде сыртқа қарау жақсы емес.
Dialogue: 1,0:20:32.54,0:20:34.62,SUB-JPO,,0,0,0,,Жер бетінде не көрдің...
Dialogue: 1,0:20:36.24,0:20:38.00,SUB-JPO,,0,0,0,,Шудокеен
Dialogue: 1,0:20:39.98,0:20:43.56,SUB-JPO,,0,0,0,,Ой, бұл жолы TSF тоқтады.
Dialogue: 1,0:20:49.50,0:20:54.60,SUB-JPO,,0,0,0,,１ TSF
Dialogue: 1,0:20:55.62,0:20:58.26,SUB-JPO,,0,0,0,,Мен қате жасадым.
Dialogue: 1,0:20:58.56,0:21:00.52,SUB-JPO,,0,0,0,,Бұл ұят.
Dialogue: 1,0:21:03.30,0:21:04.22,SUB-JPO,,0,0,0,,Иә?
Dialogue: 1,0:21:05.04,0:21:08.66,SUB-JPO,,0,0,0,,Е...м, жеңімпаз...
Dialogue: 1,0:21:09.98,0:21:12.36,SUB-JPO,,0,0,0,,UMR
Dialogue: 1,0:21:12.70,0:21:18.26,SUB-JPO,,0,0,0,,UMR UMR UMR
Dialogue: 1,0:21:18.26,0:21:18.98,SUB-JPO,,0,0,0,,Эй
Dialogue: 1,0:21:18.98,0:21:22.00,SUB-JPO,,0,0,0,,UMR UMR UMR
Dialogue: 1,0:21:22.00,0:21:23.16,SUB-JPO,,0,0,0,,Алекс
Dialogue: 1,0:21:41.82,0:21:45.70,SUB-JPO,,0,0,0,,Сильфин мырза, сіз кеше үйге кенеттен келгенде не болды деп ойлаймын.
Dialogue: 1,0:21:46.32,0:21:47.18,SUB-JPO,,0,0,0,,Умару-сан
Dialogue: 1,0:21:48.16,0:21:49.62,SUB-JPO,,0,0,0,,Не...не?
Dialogue: 1,0:21:49.84,0:21:51.78,SUB-JPO,,0,0,0,,Бүгін академиялық сынақ.
Dialogue: 1,0:21:52.00,0:21:54.76,SUB-JPO,,0,0,0,,Бұл Сильфин бірінші орынды алады.
Dialogue: 1,0:21:58.70,0:22:00.76,SUB-JPO,,0,0,0,,Сильфин әрқашан солай.
Dialogue: 1,0:22:01.10,0:22:03.78,SUB-JPO,,0,0,0,,Түрлі турнирлер өтіп жатқан сияқты.
Dialogue: 1,0:22:03.78,0:22:05.66,SUB-JPO,,0,0,0,,Сіз жай ғана ерекшеленгіңіз келмейді ме?
Dialogue: 1,0:22:09.40,0:22:11.28,SUB-JPO,,0,0,0,,Мен олай ойламаймын.
Dialogue: 1,0:22:11.60,0:22:14.56,SUB-JPO,,0,0,0,,Мен бірінші орындамын.
Dialogue: 1,0:23:47.56,0:23:50.90,UP-JPO,,0,0,0,,Енді 15 секундтық ескерту уақыты келді, UMR-san.
Dialogue: 1,0:23:50.90,0:23:53.00,UP-JPO,,0,0,0,,Бұл қисынсыз, TSF-san.
Dialogue: 1,0:23:53.20,0:23:55.16,UP-JPO,,0,0,0,,10 секундтан аз уақыт қалды.
Dialogue: 1,0:23:55.16,0:23:57.68,UP-JPO,,0,0,0,,Олай болса келесі жолы қайталап көрейік.
Dialogue: 1,0:23:57.68,0:23:59.74,UP-JPO,,0,0,0,,Уау, бұл жақсы алдын ала қарау.
Dialogue: 0,0:24:01.24,0:24:07.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
