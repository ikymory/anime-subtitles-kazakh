Dialogue: 1,0:00:02.41,0:00:05.82,OP-JP-1,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 1,0:00:05.86,0:00:08.90,OP-JP-1,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 1,0:00:08.94,0:00:12.64,OP-JP-1,,0,0,0,,Әрқашан жан-тәніңізбен ойнаңыз
Dialogue: 1,0:00:12.73,0:00:16.29,OP-JP-1,,0,0,0,,Көбірек ләззат ал, қыз.
Dialogue: 1,0:00:16.32,0:00:19.38,OP-JP-1,,0,0,0,,Ешкім байқамауы үшін
Dialogue: 1,0:00:19.62,0:00:23.18,OP-JP-1,,0,0,0,,Кеттік, Himouto Life
Dialogue: 1,0:00:28.49,0:00:31.73,OP-JP-1,,0,0,0,,Сүйікті сорғыш қақпағы
Dialogue: 1,0:00:31.78,0:00:35.02,OP-JP-1,,0,0,0,,Мен де бүгін өте жалқаумын.
Dialogue: 1,0:00:35.17,0:00:38.44,OP-JP-1,,0,0,0,,Қолымда менің сүйікті картоп чипсы
Dialogue: 1,0:00:38.56,0:00:41.73,OP-JP-1,,0,0,0,,Компьютерге қарап отырайық
Dialogue: 1,0:00:42.25,0:00:45.53,OP-JP-1,,0,0,0,,Тұрсаң, пион болады. Егер сіз отырсаңыз, сізде пион болады.
Dialogue: 1,0:00:45.66,0:00:49.16,OP-JP-1,,0,0,0,,Лилия гүліндей жүру
Dialogue: 1,0:00:49.28,0:00:52.49,OP-JP-1,,0,0,0,,Барлығы қызғанатын тамаша JK
Dialogue: 1,0:00:52.65,0:00:56.14,OP-JP-1,,0,0,0,,Қараңдаршы, кіре берістен өтсең, түрленесің.
Dialogue: 1,0:00:56.17,0:00:59.28,OP-JP-1,,0,0,0,,Жүр, гутара алайық.
Dialogue: 1,0:00:59.54,0:01:03.09,OP-JP-1,,0,0,0,,Кез келген уақытта тамақтану мен ұйықтаудың үштік комбинациясы.
Dialogue: 1,0:01:03.22,0:01:06.97,OP-JP-1,,0,0,0,,Ойындар әрқашан менің досым болды
Dialogue: 1,0:01:07.02,0:01:10.09,OP-JP-1,,0,0,0,,Менің ағам қатал, бірақ
Dialogue: 1,0:01:10.18,0:01:14.46,OP-JP-1,,0,0,0,,Сіз мені кешіретініңізге сенімдімін.
Dialogue: 1,0:01:14.52,0:01:19.37,OP-JP-1,,0,0,0,,Өзімшіл болу сүюге қарама-қарсы.
Dialogue: 1,0:01:19.37,0:01:22.42,OP-JP-1,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 1,0:01:22.50,0:01:25.92,OP-JP-1,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 1,0:01:27.66,0:01:29.08,OP-JP-1,,0,0,0,,Сәлем, соңы
Dialogue: 0,0:00:02.41,0:00:05.82,OP-JP-2,,0,0,0,,УМР УМР Бұл UMA емес, УМАРУ.
Dialogue: 0,0:00:05.86,0:00:08.90,OP-JP-2,,0,0,0,,УМР УМР Бұл УМА емес, УМАРУ.
Dialogue: 0,0:00:08.94,0:00:12.64,OP-JP-2,,0,0,0,,Әрқашан жан-тәніңізбен ойнаңыз
Dialogue: 0,0:00:12.73,0:00:16.29,OP-JP-2,,0,0,0,,Көбірек ләззат ал, қыз.
Dialogue: 0,0:00:16.32,0:00:19.38,OP-JP-2,,0,0,0,,Ешкім байқамауы үшін
Dialogue: 0,0:00:19.62,0:00:23.18,OP-JP-2,,0,0,0,,Жүрейік Химоно апа өмір
Dialogue: 0,0:00:28.49,0:00:31.73,OP-JP-2,,0,0,0,,Сүйікті капюшон
Dialogue: 0,0:00:31.78,0:00:35.02,OP-JP-2,,0,0,0,,Мен де бүгін өте жалқаумын.
Dialogue: 0,0:00:35.17,0:00:38.44,OP-JP-2,,0,0,0,,Қолымда менің сүйікті картоп чипсы
Dialogue: 0,0:00:38.56,0:00:41.73,OP-JP-2,,0,0,0,,Компьютерге қарап отырайық
Dialogue: 0,0:00:42.25,0:00:45.53,OP-JP-2,,0,0,0,,Тұрсаң, пион болады. Сіз отырсаңыз, сізде пион болады.
Dialogue: 0,0:00:45.66,0:00:49.16,OP-JP-2,,0,0,0,,Жүру фигурасы лалагүл гүлі
Dialogue: 0,0:00:49.28,0:00:52.49,OP-JP-2,,0,0,0,,Барлығы қызғанатын мінсіз орта мектеп қызы
Dialogue: 0,0:00:52.65,0:00:56.14,OP-JP-2,,0,0,0,,Қараңдаршы, кіре берістен өтсең, түрленесің.
Dialogue: 0,0:00:56.17,0:00:59.28,OP-JP-2,,0,0,0,,Жүр, гутара ішейік.
Dialogue: 0,0:00:59.54,0:01:03.09,OP-JP-2,,0,0,0,,Кез келген уақытта тамақтану мен ұйықтаудың үштік комбинациясы.
Dialogue: 0,0:01:03.22,0:01:06.97,OP-JP-2,,0,0,0,,Ойындар әрқашан менің досым болды
Dialogue: 0,0:01:07.02,0:01:10.09,OP-JP-2,,0,0,0,,Менің ағам қатал, бірақ
Dialogue: 0,0:01:10.18,0:01:14.46,OP-JP-2,,0,0,0,,Сіз мені кешіретініңізге сенімдімін.
Dialogue: 0,0:01:14.52,0:01:19.37,OP-JP-2,,0,0,0,,Өзімшіл болу сүюге қарама-қарсы.
Dialogue: 0,0:01:19.37,0:01:22.42,OP-JP-2,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 0,0:01:22.50,0:01:25.92,OP-JP-2,,0,0,0,,UMR UMR Бұл UMA емес, бұл УМАРУ.
Dialogue: 0,0:01:27.66,0:01:29.08,OP-JP-2,,0,0,0,,Сәлем, соңы
Dialogue: 0,0:22:31.72,0:22:34.90,ED-JP,,0,0,0,,Әрқашан жанымда күліп тұрады
Dialogue: 0,0:22:34.90,0:22:37.40,ED-JP,,0,0,0,,Жылулықты сезіну
Dialogue: 0,0:22:37.82,0:22:44.24,ED-JP,,0,0,0,,Сондай жұмсақ уақыт
Dialogue: 0,0:22:45.80,0:22:49.28,ED-JP,,0,0,0,,Алыста жүрсем де түсінемін
Dialogue: 0,0:22:49.44,0:22:51.68,ED-JP,,0,0,0,,Бұзық көздер
Dialogue: 0,0:22:52.04,0:22:59.56,ED-JP,,0,0,0,,Сол кездейсоқ күндерді қабылдау
Dialogue: 0,0:22:59.56,0:23:01.76,ED-JP,,0,0,0,,Күтпеген атау
Dialogue: 0,0:23:02.86,0:23:04.76,ED-JP,,0,0,0,,Мен қоңырау шалып көрдім
Dialogue: 0,0:23:05.10,0:23:06.26,ED-JP,,0,0,0,,Мен жартылай ұйықтап жатырмын
Dialogue: 0,0:23:06.40,0:23:09.38,ED-JP,,0,0,0,,Адал сезімдер
Dialogue: 0,0:23:09.82,0:23:13.44,ED-JP,,0,0,0,,Мен сізге айта аламын ба?
Dialogue: 0,0:23:13.44,0:23:14.46,ED-JP,,0,0,0,,Рахмет
Dialogue: 0,0:23:14.52,0:23:16.34,ED-JP,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:23:16.34,0:23:21.50,ED-JP,,0,0,0,,Әрқашан жүзіңізден нұрлы күлкі кетпесін
Dialogue: 0,0:23:21.50,0:23:26.44,ED-JP,,0,0,0,,Жаяу мезгілі – асыл қазына
Dialogue: 0,0:23:27.82,0:23:33.30,ED-JP,,0,0,0,,Мен қашаннан бері ересек болған күнді армандаймын?
Dialogue: 0,0:23:33.30,0:23:40.86,ED-JP,,0,0,0,,Әзірше мен сенің жаныңда ұйықтайын.
Dialogue: 0,0:01:38.82,0:01:40.48,SUB-JPO,,0,0,0,,Бүгін де қиын болды.
Dialogue: 0,0:01:43.38,0:01:46.20,SUB-JPO,,0,0,0,,Бірақ қазір қиын болады, солай емес пе?
Dialogue: 0,0:01:48.06,0:01:51.44,SUB-JPO,,0,0,0,,Жақсы жұмыс, аға. Барып, тамақ дайындаңыз.
Dialogue: 0,0:01:55.44,0:01:56.32,SUB-JPO,,0,0,0,,Мен үйдемін
Dialogue: 0,0:01:59.52,0:02:01.20,SUB-JPO,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:02:01.42,0:02:04.62,SUB-JPO,,0,0,0,,Жоқ, бәрі Умару-чанды керемет дейді.
Dialogue: 0,0:02:07.56,0:02:08.36,SUB-JPO,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:02:10.14,0:02:10.84,SUB-JPO,,0,0,0,,Үлкен аға
Dialogue: 0,0:02:11.44,0:02:13.52,SUB-JPO,,0,0,0,,О, не болды?
Dialogue: 0,0:02:13.52,0:02:16.16,SUB-JPO,,0,0,0,,Жоқ, бұл әдеттегідей емес.
Dialogue: 0,0:02:16.52,0:02:18.30,SUB-JPO,,0,0,0,,Жоқ, әдетте
Dialogue: 0,0:02:20.00,0:02:22.68,SUB-JPO,,0,0,0,,Эбина-чан қонаққа келеді, сәлем айтыңыз.
Dialogue: 0,0:02:23.24,0:02:24.46,SUB-JPO,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:02:25.36,0:02:27.14,SUB-JPO,,0,0,0,,Кешіріңіз, Эбина-чан
Dialogue: 0,0:02:28.66,0:02:32.92,SUB-JPO,,0,0,0,,Алайда, Умарудың үйіне адамдарды кіргізуі сирек кездеседі.
Dialogue: 0,0:02:36.10,0:02:39.14,SUB-JPO,,0,0,0,,Қайырлы кеш, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:02:45.92,0:02:48.26,SUB-JPO,,0,0,0,,Бұл не? Бөлме таза.
Dialogue: 0,0:02:48.82,0:02:50.80,SUB-JPO,,0,0,0,,Мен Эбина-чанмен сабақ өткіздім.
Dialogue: 0,0:02:54.14,0:02:56.74,SUB-JPO,,0,0,0,,Нана Эбина сол пәтерден
Dialogue: 0,0:02:57.12,0:02:58.52,SUB-JPO,,0,0,0,,Умарудың сыныптасы
Dialogue: 0,0:02:59.28,0:03:01.60,SUB-JPO,,0,0,0,,Умарумен дос болғаныңыз үшін рахмет.
Dialogue: 0,0:03:12.36,0:03:15.30,SUB-JPO,,0,0,0,,Поштаға тапсырыс беретін картон жәшіктердің үлкен көлемі тазартылды.
Dialogue: 0,0:03:16.30,0:03:18.66,SUB-JPO,,0,0,0,,Умару, сен оны тазаладың ба?
Dialogue: 0,0:03:19.46,0:03:21.38,SUB-JPO,,0,0,0,,Мынау қиын Умару
Dialogue: 0,0:03:24.50,0:03:25.22,SUB-JPO,,0,0,0,,Эбина-чан
Dialogue: 0,0:03:25.30,0:03:26.10,SUB-JPO,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:03:27.96,0:03:30.74,SUB-JPO,,0,0,0,,Эбина-чан, кез келген уақытта бізге келіңіз.
Dialogue: 0,0:03:31.10,0:03:33.38,SUB-JPO,,0,0,0,,иә иә
Dialogue: 0,0:03:34.38,0:03:38.12,SUB-JPO,,0,0,0,,Осы баламен Умару өзінің тәуелсіздігін сақтай алады.
Dialogue: 0,0:03:38.82,0:03:41.22,SUB-JPO,,0,0,0,,О, аға
Dialogue: 0,0:03:42.68,0:03:43.96,SUB-JPO,,0,0,0,,Мен кола ішкім келеді
Dialogue: 0,0:03:50.42,0:03:52.22,SUB-JPO,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:03:52.34,0:03:54.14,SUB-JPO,,0,0,0,,Мен тіпті кешкі ас іштім.
Dialogue: 0,0:03:54.46,0:03:55.80,SUB-JPO,,0,0,0,,Кез келген уақытта қайта келіңіз.
Dialogue: 0,0:03:56.58,0:03:57.94,SUB-JPO,,0,0,0,,Кездескенше, Эбина-чан
Dialogue: 0,0:04:08.76,0:04:11.62,SUB-JPO,,0,0,0,,Ұстаудан кейінгі кокс қайтымсыз
Dialogue: 0,0:04:12.14,0:04:13.62,SUB-JPO,,0,0,0,,Шайтанның дәмі
Dialogue: 0,0:04:25.82,0:04:27.82,SUB-JPO,,0,0,0,,О, мен ашуландым.
Dialogue: 0,0:04:30.36,0:04:31.60,SUB-JPO,,0,0,0,,Бір кесе құйып, ішіңіз.
Dialogue: 0,0:04:32.48,0:04:35.02,SUB-JPO,,0,0,0,,Сондай-ақ, мен бүгін такояки тағамдарын сатып алдым.
Dialogue: 0,0:04:35.74,0:04:38.28,SUB-JPO,,0,0,0,,Taco suna Yay!
Dialogue: 0,0:04:39.26,0:04:42.12,SUB-JPO,,0,0,0,,Мен бүгін жинап жатыр едім, ештеңе айтпа.
Dialogue: 0,0:04:43.18,0:04:46.04,SUB-JPO,,0,0,0,,Бұл сізге өз бетінше қозғалуды бастау мүмкіндігі болуы мүмкін.
Dialogue: 0,0:04:49.94,0:04:53.96,SUB-JPO,,0,0,0,,Умару Мен шомыламын, сосын такосна ішемін.
Dialogue: 0,0:04:57.64,0:05:00.96,SUB-JPO,,0,0,0,,Әй, аға, бұл васаби хош иісі бар.
Dialogue: 0,0:05:00.96,0:05:03.18,SUB-JPO,,0,0,0,,Умару Мен васаби жемеймін
Dialogue: 0,0:05:04.22,0:05:06.54,SUB-JPO,,0,0,0,,Умару осында
Dialogue: 0,0:05:06.54,0:05:09.36,SUB-JPO,,0,0,0,,Не, Умару – ашулы?
Dialogue: 0,0:05:12.82,0:05:14.02,SUB-JPO,,0,0,0,,Аға
Dialogue: 0,0:05:14.96,0:05:20.94,SUB-JPO,,0,0,0,,Өйткені Умару-чанның ағасы мейірімді, аға.
Dialogue: 0,0:05:23.24,0:05:24.82,SUB-JPO,,0,0,0,,Сіз қаншалықты ашулысыз?
Dialogue: 0,0:05:24.86,0:05:26.00,SUB-JPO,,0,0,0,,Сіз ашуланасыз.
Dialogue: 0,0:05:34.66,0:05:37.42,SUB-JPO,,0,0,0,,Таңертеңге дейін тағы да онлайн ойындар ойнадым.
Dialogue: 0,0:05:37.96,0:05:40.88,SUB-JPO,,0,0,0,,Таңертеңгілік болғандықтан айналада адам көп емес.
Dialogue: 0,0:05:41.26,0:05:44.12,SUB-JPO,,0,0,0,,Ничиа Асатиме дейін менің бос уақытым жоқ.
Dialogue: 0,0:05:46.08,0:05:48.72,SUB-JPO,,0,0,0,,Әзірше мен таңертең кокс ішемін.
Dialogue: 0,0:05:53.84,0:05:55.76,SUB-JPO,,0,0,0,,Не болды?
Dialogue: 0,0:06:01.72,0:06:03.34,SUB-JPO,,0,0,0,,Бақытты көрінеді
Dialogue: 0,0:06:04.08,0:06:07.86,SUB-JPO,,0,0,0,,Соңғы кездері үйге мумия болып қайтатындықтан болар.
Dialogue: 0,0:06:08.72,0:06:11.24,SUB-JPO,,0,0,0,,Демалыс болмағанына көп болды, ұйықтап жатырмын.
Dialogue: 0,0:06:11.62,0:06:14.20,SUB-JPO,,0,0,0,,Үлкен аға да шаршады.
Dialogue: 0,0:06:18.92,0:06:21.56,SUB-JPO,,0,0,0,,Үлкен аға жұмысқа барады.
Dialogue: 0,0:06:27.60,0:06:29.60,SUB-JPO,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:06:30.22,0:06:31.40,SUB-JPO,,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:06:33.62,0:06:35.72,SUB-JPO,,0,0,0,,Осы сағатта неге ояусың?
Dialogue: 0,0:06:36.08,0:06:37.80,SUB-JPO,,0,0,0,,Умару түні бойы
Dialogue: 0,0:06:38.36,0:06:39.46,SUB-JPO,,0,0,0,,Кел, ағайын.
Dialogue: 0,0:06:39.46,0:06:43.12,SUB-JPO,,0,0,0,,Әзірге бұл Умару мен Поп-нның Никиясаға дейін кездесуі.
Dialogue: 0,0:06:43.12,0:06:45.04,SUB-JPO,,0,0,0,,Идиот, мен ұйықтайын деп жатырмын.
Dialogue: 0,0:06:45.64,0:06:49.44,SUB-JPO,,0,0,0,,Оян, үлкен аға қызуы
Dialogue: 0,0:06:49.44,0:06:51.06,SUB-JPO,,0,0,0,,Уф
Dialogue: 0,0:06:53.90,0:06:56.98,SUB-JPO,,0,0,0,,Жұмыстан шаршадым.
Dialogue: 0,0:06:58.12,0:07:01.26,SUB-JPO,,0,0,0,,Бұл тіпті жекпе-жекті қиындататын салмақты бет.
Dialogue: 0,0:07:01.98,0:07:05.26,SUB-JPO,,0,0,0,,Ешқандай ерекшеліктер жоқ, сондықтан ұйықтап ал.
Dialogue: 0,0:07:05.60,0:07:06.64,SUB-JPO,,0,0,0,,Рахмет
Dialogue: 0,0:07:07.26,0:07:10.46,SUB-JPO,,0,0,0,,Мен мұның неге жаман көрінетінін білмеймін.
Dialogue: 0,0:07:11.14,0:07:13.30,SUB-JPO,,0,0,0,,Шамамен 30 минут ұйықтау керек.
Dialogue: 0,0:07:13.30,0:07:16.66,SUB-JPO,,0,0,0,,Жасөспірімдердің ұйықтау уақытының стандарттары
Dialogue: 0,0:07:17.62,0:07:21.66,SUB-JPO,,0,0,0,,Сабыр ет, мен әлі ұйықтаған жоқпын.
Dialogue: 0,0:07:21.66,0:07:23.70,SUB-JPO,,0,0,0,,Тіпті Умару ұйықтап жатқан жоқ.
Dialogue: 0,0:07:23.70,0:07:25.90,SUB-JPO,,0,0,0,,Онда сіз де ұйықтауыңыз керек.
Dialogue: 0,0:07:25.90,0:07:27.92,SUB-JPO,,0,0,0,,Өйткені Никияса
Dialogue: 0,0:07:31.38,0:07:33.68,SUB-JPO,,0,0,0,,Қайырлы түн, аға.
Dialogue: 0,0:07:35.86,0:07:37.22,SUB-JPO,,0,0,0,,Нашар түсінеді
Dialogue: 0,0:07:39.22,0:07:42.88,SUB-JPO,,0,0,0,,Не, не істеп жатырсың? Сіз Бәссіз.
Dialogue: 0,0:07:45.24,0:07:49.24,SUB-JPO,,0,0,0,,Бұл сыртқы жүздің алдында аңғал ағаның жатуы мүмкін емес.
Dialogue: 0,0:07:49.24,0:07:52.32,SUB-JPO,,0,0,0,,Үлкен ағаның Умарумен ойнаудан басқа амалы жоқ.
Dialogue: 0,0:07:52.50,0:07:55.32,SUB-JPO,,0,0,0,,Кел, аға, ойлан.
Dialogue: 0,0:08:00.40,0:08:03.28,SUB-JPO,,0,0,0,,Менің ойымша, ол бірдеңе жоспарлап отыр еді, бірақ ол қалыпты ұйықтады.
Dialogue: 0,0:08:07.54,0:08:11.12,SUB-JPO,,0,0,0,,Түсіндім, соңғы кездері жалғыз ойыншы ойындарын ойнап жүрмін.
Dialogue: 0,0:08:14.00,0:08:15.78,SUB-JPO,,0,0,0,,Бүгін бірге ойнаймыз ба?
Dialogue: 0,0:08:20.96,0:08:23.46,SUB-JPO,,0,0,0,,Бұған дейін мен де аздап істеймін.
Dialogue: 0,0:08:28.00,0:08:29.84,SUB-JPO,,0,0,0,,Неге сенің ағаң ұйықтап жатыр?
Dialogue: 0,0:08:30.08,0:08:32.66,SUB-JPO,,0,0,0,,Никиаса және 5-ші күн аяқталды.
Dialogue: 0,0:08:32.66,0:08:34.36,SUB-JPO,,0,0,0,,Жоқ, бұл менің кінәм бе?
Dialogue: 0,0:08:43.40,0:08:45.88,SUB-JPO,,0,0,0,,Қаласаңыз, өтінемін.
Dialogue: 0,0:08:47.02,0:08:48.62,SUB-JPO,,0,0,0,,Иә, қаласаңыз.
Dialogue: 0,0:08:52.06,0:08:53.42,SUB-JPO,,0,0,0,,Сүйкімді
Dialogue: 0,0:08:59.58,0:09:04.50,SUB-JPO,,0,0,0,,Неколамбус супер үлкен толтырылған ойыншықтар байқауы
Dialogue: 0,0:09:06.74,0:09:07.46,SUB-JPO,,0,0,0,,Мен үйдемін
Dialogue: 0,0:09:09.86,0:09:12.50,SUB-JPO,,0,0,0,,Үлкен аға, бұл қиын.
Dialogue: 0,0:09:12.72,0:09:14.38,SUB-JPO,,0,0,0,,Не болды?
Dialogue: 0,0:09:18.28,0:09:20.98,SUB-JPO,,0,0,0,,Жүр, кеттік, ағайын.
Dialogue: 0,0:09:21.60,0:09:23.94,SUB-JPO,,0,0,0,,Умару Мен қиын болады деп ойламадым.
Dialogue: 0,0:09:24.54,0:09:26.32,SUB-JPO,,0,0,0,,Иә, мен оны міндетті түрде аламын.
Dialogue: 0,0:09:27.18,0:09:29.82,SUB-JPO,,0,0,0,,О, мұның саған несі қиын?
Dialogue: 0,0:09:29.82,0:09:32.28,SUB-JPO,,0,0,0,,Мен мереке күндері жұмыс істеуден бас тарттым.
Dialogue: 0,0:09:32.66,0:09:35.98,SUB-JPO,,0,0,0,,Жарайды, аға, демалу маңызды.
Dialogue: 0,0:09:36.28,0:09:38.40,SUB-JPO,,0,0,0,,Көбінесе бұл сізге қажет емес.
Dialogue: 0,0:09:38.66,0:09:39.86,SUB-JPO,,0,0,0,,Жалғыз болған дұрыс
Dialogue: 0,0:09:40.88,0:09:42.90,SUB-JPO,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:44.38,0:09:47.06,SUB-JPO,,0,0,0,,Умару Мен ағаммен ойнағым келді.
Dialogue: 0,0:09:49.70,0:09:52.78,SUB-JPO,,0,0,0,,Үлкен аға, үнемі еңбек ету керек.
Dialogue: 0,0:09:53.08,0:09:57.56,SUB-JPO,,0,0,0,,Сондықтан мен мұндай әрекетке бармасам, ол бір күн демалмас еді деп ойладым.
Dialogue: 0,0:10:00.74,0:10:04.70,SUB-JPO,,0,0,0,,Иә, мен жұмысқа тым көп көңіл бөлгеніме сенімдімін.
Dialogue: 0,0:10:04.94,0:10:07.44,SUB-JPO,,0,0,0,,Соңғы кезде Умаруға мән бермеген шығар.
Dialogue: 0,0:10:07.72,0:10:10.64,SUB-JPO,,0,0,0,,Жарайды, мереке демалуға арналған.
Dialogue: 0,0:10:11.90,0:10:16.04,SUB-JPO,,0,0,0,,Уайымдама, Умару, мен былай тұрсам да тас-қағаз-қайшыға шебермін.
Dialogue: 0,0:10:16.44,0:10:18.16,SUB-JPO,,0,0,0,,Үйде болуға әлі де ерте емес пе?
Dialogue: 0,0:10:20.38,0:10:23.80,SUB-JPO,,0,0,0,,Мұнда тас-қағаз-қайшы турниріне билеттер таратылуда.
Dialogue: 0,0:10:23.96,0:10:26.14,SUB-JPO,,0,0,0,,Кезек күтіңіз.
Dialogue: 0,0:10:26.92,0:10:29.02,SUB-JPO,,0,0,0,,О, бұл жігіт
Dialogue: 0,0:10:29.90,0:10:35.06,SUB-JPO,,0,0,0,,Олай болса, Умару оңтүстік шығыс дүкеніне барады, сондықтан солтүстік шығыс дүкеніне барыңыз.
Dialogue: 0,0:10:37.92,0:10:38.92,SUB-JPO,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:10:41.08,0:10:44.02,SUB-JPO,,0,0,0,,Жеңіске жету мүмкіндігіңізді аз да болса арттыру үшін маған қоңырау шалыңыз
Dialogue: 0,0:10:44.02,0:10:46.56,SUB-JPO,,0,0,0,,Оның үстіне мен басқа дүкенге бардым.
Dialogue: 0,0:10:48.60,0:10:50.66,SUB-JPO,,0,0,0,,Мен ағаммен ойнағым келді.
Dialogue: 0,0:10:51.44,0:10:54.92,SUB-JPO,,0,0,0,,Жақсы болса, екі алам деп мені алдадың ба?
Dialogue: 0,0:10:57.40,0:10:58.90,SUB-JPO,,0,0,0,,Барлығыңызға сәлем.
Dialogue: 0,0:10:58.90,0:11:02.38,SUB-JPO,,0,0,0,,Содан кейін тас, қағаз, қайшы турнирі басталады.
Dialogue: 0,0:11:02.76,0:11:04.58,SUB-JPO,,0,0,0,,Әпкеңмен тас, қағаз, қайшы ойнау
Dialogue: 0,0:11:04.58,0:11:07.16,SUB-JPO,,0,0,0,,Сахнаға тек жеңімпаздар келулеріңізді сұраймыз.
Dialogue: 0,0:11:07.16,0:11:10.14,SUB-JPO,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:11:10.36,0:11:11.22,SUB-JPO,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:11:11.86,0:11:14.12,SUB-JPO,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:11:15.82,0:11:19.40,SUB-JPO,,0,0,0,,Енді тас-қағаз-қайшы турнирінің финалы аяқталды.
Dialogue: 0,0:11:19.40,0:11:20.90,SUB-JPO,,0,0,0,,Мен жеңіп, аман қалдым.
Dialogue: 0,0:11:21.34,0:11:26.20,SUB-JPO,,0,0,0,,Бұл көзілдірік киген жігіт пен мына жас келіншектің жеке-жеке төбелесі.
Dialogue: 0,0:11:26.66,0:11:28.18,SUB-JPO,,0,0,0,,Бұл Эбина-чан
Dialogue: 0,0:11:32.16,0:11:34.46,SUB-JPO,,0,0,0,,О, ағайын
Dialogue: 0,0:11:37.34,0:11:39.60,SUB-JPO,,0,0,0,,Жүріңдер, екеуің, кеттік.
Dialogue: 0,0:11:41.06,0:11:42.96,SUB-JPO,,0,0,0,,Джанкин
Dialogue: 0,0:11:46.40,0:11:49.60,SUB-JPO,,0,0,0,,Ағаң тас-қағаз-қайшыға шебер.
Dialogue: 0,0:11:50.04,0:11:54.66,SUB-JPO,,0,0,0,,Жоқ, егер сіз психологиялық соққыны алсаңыз, жеңу оңайырақ сияқты.
Dialogue: 0,0:11:57.04,0:12:00.58,SUB-JPO,,0,0,0,,Бұл жаман. Мүмкін, Эбина-чан мұны шынымен де қалаған шығар.
Dialogue: 0,0:12:01.88,0:12:05.00,SUB-JPO,,0,0,0,,Қызық, бұл толған кезде ойнауды қиындатады ма?
Dialogue: 0,0:12:05.96,0:12:07.30,SUB-JPO,,0,0,0,,Ебина-чан бұл
Dialogue: 0,0:12:08.50,0:12:09.12,SUB-JPO,,0,0,0,,Мен оны саған беремін
Dialogue: 0,0:12:09.82,0:12:12.74,SUB-JPO,,0,0,0,,Әпкемнің достарының мені ұрып-соғуына жол бергені үшін өзімді жаман сезінемін.
Dialogue: 0,0:12:12.74,0:12:15.10,SUB-JPO,,0,0,0,,Жоқ...жоқ, жақсы.
Dialogue: 0,0:12:15.70,0:12:17.24,SUB-JPO,,0,0,0,,Сіз мұны шынымен қаладыңыз, солай емес пе?
Dialogue: 0,0:12:17.74,0:12:21.08,SUB-JPO,,0,0,0,,Осыны маған да Эбина-чан берсе, мен бақытты болар едім.
Dialogue: 0,0:12:21.92,0:12:26.06,SUB-JPO,,0,0,0,,Ах... рахмет
Dialogue: 0,0:12:29.76,0:12:32.32,SUB-JPO,,0,0,0,,А...көп рахмет.
Dialogue: 0,0:12:32.50,0:12:33.80,SUB-JPO,,0,0,0,,Жоқ, кездескенше.
Dialogue: 0,0:12:41.48,0:12:44.42,SUB-JPO,,0,0,0,,У... Умару қашаннан бері?
Dialogue: 0,0:12:44.76,0:12:46.34,SUB-JPO,,0,0,0,,Бұл дүкеннен.
Dialogue: 0,0:12:46.80,0:12:50.16,SUB-JPO,,0,0,0,,Мен бірден жеңіліп қалдым, сондықтан солтүстік шығыс дүкеніне бардым.
Dialogue: 0,0:12:52.72,0:12:54.74,SUB-JPO,,0,0,0,,Неге оны Эбина-чанға бересің?
Dialogue: 0,0:12:54.74,0:12:57.50,SUB-JPO,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін. Әлеуметтік көзілдірік.
Dialogue: 0,0:12:58.38,0:13:02.00,SUB-JPO,,0,0,0,,Эй...Мен саған келдім.
Dialogue: 0,0:13:02.70,0:13:05.52,SUB-JPO,,0,0,0,,Умару үшін мүлде емес
Dialogue: 0,0:13:05.52,0:13:07.30,SUB-JPO,,0,0,0,,Жоқ... тоқтатыңыз.
Dialogue: 0,0:13:09.10,0:13:13.74,SUB-JPO,,0,0,0,,Бауырым, күткендей... мейірімдісің.
Dialogue: 0,0:13:16.90,0:13:18.20,SUB-JPO,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:13:22.42,0:13:26.74,SUB-JPO,,0,0,0,,Соңында мен онлайн аукционда алып Неколамбты алдым.
Dialogue: 0,0:13:27.62,0:13:28.78,SUB-JPO,,0,0,0,,Оған иелік ету
Dialogue: 0,0:13:35.68,0:13:38.70,SUB-JPO,,0,0,0,,Бауырым, Saigono Fantasy 15 сатып ал.
Dialogue: 0,0:13:39.04,0:13:41.70,SUB-JPO,,0,0,0,,Жоқ, мен Рюкюді бір күні сатып алдым.
Dialogue: 0,0:13:48.66,0:13:52.82,SUB-JPO,,0,0,0,,Умару Мен бүгін ойын емес, ингредиенттер сатып аламын.
Dialogue: 0,0:13:53.22,0:13:55.28,SUB-JPO,,0,0,0,,Білемін, аға.
Dialogue: 0,0:13:55.86,0:13:58.24,SUB-JPO,,0,0,0,,Олай болса, маған неге сонша күте қарап тұрсың?
Dialogue: 0,0:13:59.96,0:14:01.82,SUB-JPO,,0,0,0,,Өйткені ағамды итеру оңай емес.
Dialogue: 0,0:14:01.82,0:14:04.34,SUB-JPO,,0,0,0,,Жұрттың көзінше илесең, сатып алады.
Dialogue: 0,0:14:04.90,0:14:08.00,SUB-JPO,,0,0,0,,Көпшіліктің көзінше ұрып-соғып жатса да сатып алмауға тырысу керек.
Dialogue: 0,0:14:14.02,0:14:15.80,SUB-JPO,,0,0,0,,Жарайды, осындай нәрсе.
Dialogue: 0,0:14:16.82,0:14:18.70,SUB-JPO,,0,0,0,,Жақында ойын дүкеніне келеді
Dialogue: 0,0:14:20.90,0:14:22.28,SUB-JPO,,0,0,0,,Бұл Эбина-чан
Dialogue: 0,0:14:22.76,0:14:24.04,SUB-JPO,,0,0,0,,(Сора) Ах… Ах, сонда бәрі түсінікті—күн сәулесінде жүруге болатыны да сондықтан екен.
Dialogue: 0,0:14:25.10,0:14:27.46,SUB-JPO,,0,0,0,,Сәлеметсіз бе, аға.
Dialogue: 0,0:14:29.18,0:14:30.14,SUB-JPO,,0,0,0,,Омарун
Dialogue: 0,0:14:30.82,0:14:32.52,SUB-JPO,,0,0,0,,Бұл Эбина-чан
Dialogue: 0,0:14:32.76,0:14:34.48,SUB-JPO,,0,0,0,,Қандай кездейсоқтық. Шопинг па?
Dialogue: 0,0:14:34.72,0:14:37.98,SUB-JPO,,0,0,0,,Иә, мен әрқашан осында ингредиенттер сатып алу үшін келемін.
Dialogue: 0,0:14:38.26,0:14:39.98,SUB-JPO,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:14:40.40,0:14:42.34,SUB-JPO,,0,0,0,,Әдеттегідей тек сырты...
Dialogue: 0,0:14:42.82,0:14:43.54,SUB-JPO,,0,0,0,,Иә.
Dialogue: 0,0:14:48.18,0:14:51.84,SUB-JPO,,0,0,0,,Жарайды ма? Бұл мереке болады.
Dialogue: 0,0:14:52.06,0:14:54.04,SUB-JPO,,0,0,0,,Иә, түскі уақыт.
Dialogue: 0,0:14:54.24,0:14:56.56,SUB-JPO,,0,0,0,,Олай болса сөзіңізді қабыл алыңыз.
Dialogue: 0,0:15:00.38,0:15:03.38,SUB-JPO,,0,0,0,,Уау, бәрі дәмді көрінеді
Dialogue: 0,0:15:04.40,0:15:07.48,SUB-JPO,,0,0,0,,Ебина-чанның алдында ойын сұрай алмайсың.
Dialogue: 0,0:15:07.96,0:15:10.18,SUB-JPO,,0,0,0,,Сізге көбірек шыдамдылық қажет.
Dialogue: 0,0:15:11.86,0:15:14.18,SUB-JPO,,0,0,0,,Бауырым, сіз паллиативтік әдістерді қолданасыз.
Dialogue: 0,0:15:14.72,0:15:17.36,SUB-JPO,,0,0,0,,Ебина-чанның алдында илей алмаймын.
Dialogue: 0,0:15:19.12,0:15:20.32,SUB-JPO,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:15:21.76,0:15:23.48,SUB-JPO,,0,0,0,,Жоғарыдағылар сәйкес пе?
Dialogue: 0,0:15:23.92,0:15:24.50,SUB-JPO,,0,0,0,,Иә
Dialogue: 0,0:15:28.20,0:15:31.54,SUB-JPO,,0,0,0,,Отбасылық мейрамханаға бірінші рет баруым.
Dialogue: 0,0:15:32.46,0:15:34.12,SUB-JPO,,0,0,0,,Сіз сыртта көп тамақтанбайсыз ба?
Dialogue: 0,0:15:34.48,0:15:36.80,SUB-JPO,,0,0,0,,Менің туған жерім Акитада да бар.
Dialogue: 0,0:15:37.12,0:15:38.36,SUB-JPO,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:39.14,0:15:41.14,SUB-JPO,,0,0,0,,Негізі мен үйде жасаймын.
Dialogue: 0,0:15:42.52,0:15:44.54,SUB-JPO,,0,0,0,,Жалғыз тұрсаң да тамаша.
Dialogue: 0,0:15:45.08,0:15:46.20,SUB-JPO,,0,0,0,,Сәлем Умару
Dialogue: 0,0:15:48.32,0:15:51.58,SUB-JPO,,0,0,0,,Үлкен аға, мен сіздің омлет күрішіңізге кетчуп саламын.
Dialogue: 0,0:15:52.82,0:15:53.38,SUB-JPO,,0,0,0,,О
Dialogue: 0,0:15:56.16,0:15:56.74,SUB-JPO,,0,0,0,,Иә
Dialogue: 0,0:16:01.44,0:16:04.44,SUB-JPO,,0,0,0,,Ойын ойыны
Dialogue: 0,0:16:08.34,0:16:12.42,SUB-JPO,,0,0,0,,Бұл тәрелке кішкентай болса да, сүйкімді.
Dialogue: 0,0:16:13.54,0:16:15.32,SUB-JPO,,0,0,0,,Оны теңіз қабығына салыңыз.
Dialogue: 0,0:16:15.32,0:16:17.56,SUB-JPO,,0,0,0,,Ойын ойыны
Dialogue: 0,0:16:17.56,0:16:19.34,SUB-JPO,,0,0,0,,Ойын ойыны
Dialogue: 0,0:16:19.80,0:16:21.76,SUB-JPO,,0,0,0,,Неге мені елемейсің, аға?
Dialogue: 0,0:16:21.76,0:16:23.00,SUB-JPO,,0,0,0,,Ойын
Dialogue: 0,0:16:23.74,0:16:27.78,SUB-JPO,,0,0,0,,Мен ұялдым, мен ештеңе білмеймін
Dialogue: 0,0:16:29.14,0:16:30.96,SUB-JPO,,0,0,0,,Егер бұл бірінші рет болса, көмектесу мүмкін емес.
Dialogue: 0,0:16:35.46,0:16:37.50,SUB-JPO,,0,0,0,,Үлкен аға, а
Dialogue: 0,0:16:37.92,0:16:40.50,SUB-JPO,,0,0,0,,Жүр, Эбина-чан, күн суытпай тұрып.
Dialogue: 0,0:16:40.84,0:16:42.40,SUB-JPO,,0,0,0,,Итадакимасу
Dialogue: 0,0:16:48.06,0:16:50.38,SUB-JPO,,0,0,0,,Үлкен ағаның көзілдірікті елемейтін ақымақ
Dialogue: 0,0:16:50.38,0:16:51.94,SUB-JPO,,0,0,0,,Асығыңыз және ойынды сатып алыңыз.
Dialogue: 0,0:16:51.94,0:16:52.62,SUB-JPO,,0,0,0,,Көзіңіз көрмейді ме? Есіктің жазуын оқи алмайсыз ба?
Dialogue: 0,0:16:52.98,0:16:54.66,SUB-JPO,,0,0,0,,Сатып алу
Dialogue: 0,0:16:56.56,0:16:57.26,SUB-JPO,,0,0,0,,Босатыңыз
Dialogue: 0,0:16:57.84,0:16:59.62,SUB-JPO,,0,0,0,,Сатып алу және сатып алу
Dialogue: 0,0:16:59.62,0:17:02.94,SUB-JPO,,0,0,0,,Сатып ал, сатып ал, сатып ал, сатып ал.
Dialogue: 0,0:17:03.72,0:17:06.20,SUB-JPO,,0,0,0,,Бауырым, тез сатып ал.
Dialogue: 0,0:17:06.22,0:17:07.98,SUB-JPO,,0,0,0,,Тоқта!
Dialogue: 0,0:17:10.28,0:17:11.94,SUB-JPO,,0,0,0,,Ойын ойыны ойын ойыны
Dialogue: 0,0:17:12.00,0:17:13.61,UP-JPO,,0,0,0,,Ойын ойыны ойын ойыны
Dialogue: 0,0:17:13.68,0:17:16.06,UP-JPO,,0,0,0,,Ойын ойыны ойын ойыны
Dialogue: 0,0:17:12.88,0:17:14.32,SUB-JPO,,0,0,0,,Амансың ба?
Dialogue: 0,0:17:14.60,0:17:16.02,SUB-JPO,,0,0,0,,Ебина-чанның алдында.
Dialogue: 0,0:17:17.96,0:17:19.24,SUB-JPO,,0,0,0,,Омарун
Dialogue: 0,0:17:20.92,0:17:21.86,SUB-JPO,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:17:33.24,0:17:36.44,SUB-JPO,,0,0,0,,Unmena қалалық мейрамханасы
Dialogue: 0,0:17:40.40,0:17:43.50,SUB-JPO,,0,0,0,,Кешіріңіз, бұл өте дәмді.
Dialogue: 0,0:17:44.06,0:17:44.80,SUB-JPO,,0,0,0,,Акита диалектісі
Dialogue: 0,0:17:46.66,0:17:48.42,SUB-JPO,,0,0,0,,Мен... құтқарылдым.
Dialogue: 0,0:17:56.14,0:17:58.14,SUB-JPO,,0,0,0,,Умару-чан, бұл керемет болды.
Dialogue: 0,0:18:10.48,0:18:12.02,SUB-JPO,,0,0,0,,Қайырлы таң Эбина-чан
Dialogue: 0,0:18:12.80,0:18:14.48,SUB-JPO,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:18:15.46,0:18:18.14,SUB-JPO,,0,0,0,,Бүгін де менімен біргесің бе? Біз жақсы доспыз.
Dialogue: 0,0:18:21.34,0:18:22.76,SUB-JPO,,0,0,0,,Умару, тез тамақтан
Dialogue: 0,0:18:23.22,0:18:24.62,SUB-JPO,,0,0,0,,Эбина-чан күтіп тұр.
Dialogue: 0,0:18:29.20,0:18:34.46,SUB-JPO,,0,0,0,,Бәрі жақсы. Отбасыммен Токиода бірнеше рет болдық.
Dialogue: 0,0:18:35.14,0:18:37.50,SUB-JPO,,0,0,0,,Нана жалғыз болса, барма.
Dialogue: 0,0:18:37.98,0:18:40.32,SUB-JPO,,0,0,0,,Саяхаттау мен өмір сүрудің айырмашылығы бар.
Dialogue: 0,0:18:40.80,0:18:45.16,SUB-JPO,,0,0,0,,Мен қазір Токиодағы мектепке бара алмаймын.
Dialogue: 0,0:18:49.70,0:18:50.48,SUB-JPO,,0,0,0,,Қайта толтырыңыз
Dialogue: 0,0:18:50.98,0:18:52.40,SUB-JPO,,0,0,0,,Мен әлі де жеймін.
Dialogue: 0,0:18:58.90,0:19:01.12,SUB-JPO,,0,0,0,,Нана тым сабырлы.
Dialogue: 0,0:19:01.66,0:19:03.56,SUB-JPO,,0,0,0,,Бұл елдік нәрсе емес пе?
Dialogue: 0,0:19:04.68,0:19:06.40,SUB-JPO,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:19:07.90,0:19:10.58,SUB-JPO,,0,0,0,,Стандартты жапон тілін дұрыс үйрене бастаңыз.
Dialogue: 0,0:19:10.94,0:19:14.04,SUB-JPO,,0,0,0,,Мен Eon Mall дүкенінен сәнді киімдерді де сатып алдым.
Dialogue: 0,0:19:14.46,0:19:16.32,SUB-JPO,,0,0,0,,Ештеңеге алаңдамаңыз
Dialogue: 0,0:19:24.18,0:19:26.82,SUB-JPO,,0,0,0,,Адамдар неге маған осылай қарайды?
Dialogue: 0,0:19:28.14,0:19:29.54,SUB-JPO,,0,0,0,,Ки...Оның бәрі менің қиялым Бұл менің қиялым
Dialogue: 0,0:19:29.90,0:19:31.98,SUB-JPO,,0,0,0,,Мен қобалжығандықтан солай ойлаймын.
Dialogue: 0,0:19:32.36,0:19:34.10,SUB-JPO,,0,0,0,,Әрине
Dialogue: 0,0:19:35.18,0:19:38.36,SUB-JPO,,0,0,0,,Жоқ, бірақ диалект тым табиғи болса...
Dialogue: 0,0:19:39.02,0:19:40.52,SUB-JPO,,0,0,0,,Кофе алғыңыз келе ме?
Dialogue: 0,0:19:40.80,0:19:42.00,SUB-JPO,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:19:43.30,0:19:44.00,SUB-JPO,,0,0,0,,Өтінемін
Dialogue: 0,0:19:45.34,0:19:47.38,SUB-JPO,,0,0,0,,Ах... рахмет
Dialogue: 0,0:19:54.18,0:19:55.60,SUB-JPO,,0,0,0,,Ғажайып адам
Dialogue: 0,0:19:56.00,0:19:58.92,SUB-JPO,,0,0,0,,Бірақ...бірақ мен айналама қарамай жүруім керек.
Dialogue: 0,0:20:05.14,0:20:05.82,SUB-JPO,,0,0,0,,Бұл
Dialogue: 0,0:20:06.28,0:20:09.22,SUB-JPO,,0,0,0,,Не...сіз? Бұл ақылсыз
Dialogue: 0,0:20:09.76,0:20:11.94,SUB-JPO,,0,0,0,,Менің ойымша, киім де біртүрлі емес.
Dialogue: 0,0:20:12.52,0:20:16.40,SUB-JPO,,0,0,0,,Диалекті де жоқ, сөйлеу де жоқ.
Dialogue: 0,0:20:16.76,0:20:19.28,SUB-JPO,,0,0,0,,Ой, анау қыздың кеудесі үлкен екен.
Dialogue: 0,0:20:22.94,0:20:23.62,SUB-JPO,,0,0,0,,Бұл
Dialogue: 0,0:20:24.34,0:20:29.08,SUB-JPO,,0,0,0,,Мені Акитадан Токиоға дейін көп адам көрді.
Dialogue: 0,0:20:31.94,0:20:32.74,SUB-JPO,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:20:34.12,0:20:37.88,SUB-JPO,,0,0,0,,Менің көзіме ешкім қарамайды
Dialogue: 0,0:20:58.10,0:20:58.86,SUB-JPO,,0,0,0,,Сәлем
Dialogue: 0,0:21:04.98,0:21:07.82,SUB-JPO,,0,0,0,,Менің алғашқы көзім...
Dialogue: 0,0:21:11.00,0:21:11.48,SUB-JPO,,0,0,0,,Ум...
Dialogue: 0,0:21:13.34,0:21:18.48,SUB-JPO,,0,0,0,,Мм, кешіріңіз, мен... мен бүгін ғана көшіп келдім.
Dialogue: 0,0:21:19.64,0:21:20.48,SUB-JPO,,0,0,0,,Солай ма?
Dialogue: 0,0:21:20.76,0:21:23.32,SUB-JPO,,0,0,0,,Бұл 201-нің кір қабаты. Танысқаныма қуаныштымын.
Dialogue: 0,0:21:23.56,0:21:25.98,SUB-JPO,,0,0,0,,Бұл 101-дегі Эбина.
Dialogue: 0,0:21:27.00,0:21:29.72,SUB-JPO,,0,0,0,,Егер бірдеңе түсінбесеңіз, сұраңыз.
Dialogue: 0,0:21:35.58,0:21:36.18,SUB-JPO,,0,0,0,,Иә
Dialogue: 0,0:21:38.32,0:21:39.46,SUB-JPO,,0,0,0,,Бауырым...
Dialogue: 0,0:21:40.08,0:21:42.98,SUB-JPO,,0,0,0,,Менің ағам сонда болғандықтан, мен...
Dialogue: 0,0:21:43.70,0:21:45.12,SUB-JPO,,0,0,0,,Қайырлы таң Эбина-чан
Dialogue: 0,0:21:46.10,0:21:47.46,SUB-JPO,,0,0,0,,Қайырлы таң Умару-чан
Dialogue: 0,0:21:47.90,0:21:48.52,SUB-JPO,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:49.34,0:21:50.94,SUB-JPO,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:21:51.24,0:21:55.20,SUB-JPO,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:21:57.58,0:21:58.56,SUB-JPO,,0,0,0,,Мен кешігіп келемін
Dialogue: 0,0:21:58.56,0:21:59.92,SUB-JPO,,0,0,0,,Ебина-чан кеттік
Dialogue: 0,0:22:02.46,0:22:05.78,SUB-JPO,,0,0,0,,Кешіріңіз, аға...
Dialogue: 0,0:22:05.98,0:22:07.24,SUB-JPO,,0,0,0,,Эбина-чан
Dialogue: 0,0:22:11.68,0:22:14.12,SUB-JPO,,0,0,0,,Күте тұрыңыз, Умару-чан
Dialogue: 0,0:23:47.68,0:23:49.30,SUB-JPO,,0,0,0,,Бұл сәйкес Неколамб.
Dialogue: 0,0:23:49.30,0:23:51.80,SUB-JPO,,0,0,0,,Иә, қатар тізілгенде ағайынды болып көрінеді.
Dialogue: 0,0:23:51.80,0:23:55.14,SUB-JPO,,0,0,0,,Сосын, сен бірінші келгендіктен, Ебинаны аға деп ойлаймын.
Dialogue: 0,0:23:55.14,0:23:58.22,SUB-JPO,,0,0,0,,Мен ағама солай жасадым...
Dialogue: 0,0:23:59.78,0:24:00.82,SUB-JPO,,0,0,0,,Не істедің! ?
Dialogue: 0,0:24:02.32,0:24:08.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
