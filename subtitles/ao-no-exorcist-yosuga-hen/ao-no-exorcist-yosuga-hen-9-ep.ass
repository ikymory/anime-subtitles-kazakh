Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.67,Default,,0,0,0,,♪～
Dialogue: 0,0:01:27.25,0:01:29.25,Default,,0,0,0,,～♪
Dialogue: 0,0:01:33.46,0:01:34.88,Default,,0,0,0,,Шайтан…
Dialogue: 0,0:01:36.17,0:01:38.72,Default,,0,0,0,,Мен таптым, Юрий.
Dialogue: 0,0:01:38.80,0:01:40.64,Default,,0,0,0,,Широ!
Dialogue: 0,0:01:41.26,0:01:42.31,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:42.39,0:01:44.52,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:01:45.10,0:01:47.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:47.64,0:01:50.52,Default,,0,0,0,,Юри, осыны меңзеп тұрсың ба?
Dialogue: 0,0:01:50.61,0:01:54.23,Default,,0,0,0,,Сен арам сатқын!
Dialogue: 0,0:01:55.07,0:01:58.20,Default,,0,0,0,,Сізбен бірге бола алмағаным үшін кешіріңіз.
Dialogue: 0,0:01:59.20,0:02:00.74,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:02:01.24,0:02:03.16,Default,,0,0,0,,Бірақ қараңыз
Dialogue: 0,0:02:03.66,0:02:06.08,Default,,0,0,0,,Бұл сен және менің балам
Dialogue: 0,0:02:06.87,0:02:10.50,Default,,0,0,0,,Сіз әке болдыңыз.
Dialogue: 0,0:02:12.59,0:02:15.09,Default,,0,0,0,,Не? сол кесек ет
Dialogue: 0,0:02:17.42,0:02:18.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:19.43,0:02:23.68,Default,,0,0,0,,Әй... Бұл менің ішімді қоса ма?
Dialogue: 0,0:02:23.76,0:02:25.72,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:02:26.31,0:02:29.31,Default,,0,0,0,,Менің қалағаным сенсің
Dialogue: 0,0:02:29.39,0:02:30.56,Default,,0,0,0,,Широ!
Dialogue: 0,0:02:30.65,0:02:32.52,Default,,0,0,0,,-Сәлем... -Маған берші!
Dialogue: 0,0:02:32.61,0:02:34.69,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:02:35.86,0:02:36.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:36.44,0:02:39.49,Default,,0,0,0,,Маған сол денені беріңіз!
Dialogue: 0,0:02:41.07,0:02:43.78,Default,,0,0,0,,А... хахахаха
Dialogue: 0,0:02:43.87,0:02:45.74,Default,,0,0,0,,Басқалар сияқты емес
Dialogue: 0,0:02:45.83,0:02:48.12,Default,,0,0,0,,Бұл бірқалыпты емес.
Dialogue: 0,0:02:48.62,0:02:51.29,Default,,0,0,0,,Әлі есімде
Dialogue: 0,0:02:51.79,0:02:53.13,Default,,0,0,0,,А? Апыр-ай!
Dialogue: 0,0:02:54.75,0:02:57.55,Default,,0,0,0,,Ол кезде мен шынымен түсінбейтінмін.
Dialogue: 0,0:02:57.63,0:02:59.59,Default,,0,0,0,,Енді мен білемін
Dialogue: 0,0:03:00.22,0:03:04.22,Default,,0,0,0,,Мен әрқашан адам болғым келді.
Dialogue: 0,0:03:04.72,0:03:06.93,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:03:07.43,0:03:11.27,Default,,0,0,0,,Бұл Юрий көрген фосфорлы жалын болуы мүмкін бе?
Dialogue: 0,0:03:11.35,0:03:15.27,Default,,0,0,0,,Іс осылай жалғаса берсе, Юрийге қауіп төнеді.
Dialogue: 0,0:03:15.36,0:03:17.90,Default,,0,0,0,,Тек фосфорлы от емес
Dialogue: 0,0:03:17.98,0:03:20.65,Default,,0,0,0,,Баланы таң қалдырды.
Dialogue: 0,0:03:21.32,0:03:24.37,Default,,0,0,0,,Жасай бер, Окумура!
Dialogue: 0,0:03:24.87,0:03:29.00,Default,,0,0,0,,Фуууууууууууууууу...
Dialogue: 0,0:03:32.37,0:03:33.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:34.50,0:03:37.17,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:03:40.17,0:03:42.47,Default,,0,0,0,,Бірақ сәтсіз аяқталды
Dialogue: 0,0:03:42.97,0:03:44.93,Default,,0,0,0,,Ю… Ри…
Dialogue: 0,0:03:45.01,0:03:45.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.05,0:03:47.85,Default,,0,0,0,,Қарт кісінің басын кескен
Dialogue: 0,0:03:47.93,0:03:49.93,Default,,0,0,0,,Бұл үлкен соққы болды.
Dialogue: 0,0:03:50.02,0:03:51.89,Default,,0,0,0,,Ештеңе есімде жоқ
Dialogue: 0,0:03:51.98,0:03:54.56,Default,,0,0,0,,Қарт пен қарт қаңбақтың мазасын алуы
Dialogue: 0,0:03:54.65,0:03:57.69,Default,,0,0,0,,Менің күш-қуатымды қайтару үшін біраз уақыт қажет болды.
Dialogue: 0,0:03:57.77,0:04:02.99,Default,,0,0,0,,Хе хи хи Алғашында жақсы жүрмейді.
Dialogue: 0,0:04:03.07,0:04:04.70,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:04:06.03,0:04:07.16,Default,,0,0,0,,Нико-чан
Dialogue: 0,0:04:08.45,0:04:09.45,Default,,0,0,0,,Обаба
Dialogue: 0,0:04:11.66,0:04:12.66,Default,,0,0,0,,Ок-чан...
Dialogue: 0,0:04:13.67,0:04:17.96,Default,,0,0,0,,Хахаха, енді ойлап қарасам, бұл да сәтсіздік болды.
Dialogue: 0,0:04:18.84,0:04:21.97,Default,,0,0,0,,Барлығы сізге жету үшін
Dialogue: 0,0:04:23.01,0:04:25.30,Default,,0,0,0,,Мен сен болғым келеді
Dialogue: 0,0:04:25.80,0:04:28.55,Default,,0,0,0,,Юри жақсы көретін саған
Dialogue: 0,0:04:29.06,0:04:31.68,Default,,0,0,0,,Мен сені қызғанамын
Dialogue: 0,0:04:31.77,0:04:32.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:32.43,0:04:35.69,Default,,0,0,0,,қызғаныш, өкініш
Dialogue: 0,0:04:35.77,0:04:39.36,Default,,0,0,0,,Лилияны ал!
Dialogue: 0,0:04:39.44,0:04:40.98,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:04:41.07,0:04:42.82,Default,,0,0,0,,Сіз де, солай ма?
Dialogue: 0,0:04:42.90,0:04:46.49,Default,,0,0,0,,Хи хи хи... сен екеуміз бірдейміз
Dialogue: 0,0:04:46.57,0:04:47.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:47.20,0:04:49.12,Default,,0,0,0,,Мойындаңыз!
Dialogue: 0,0:04:51.45,0:04:56.21,Default,,0,0,0,,Біз бірдейміз
Dialogue: 0,0:05:04.09,0:05:05.01,Default,,0,0,0,,Широ!
Dialogue: 0,0:05:15.48,0:05:19.44,Default,,0,0,0,,А, бұл тітіркендіргіш.
Dialogue: 0,0:05:22.44,0:05:23.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:23.86,0:05:25.82,Default,,0,0,0,,Әй... ол жынданып кеткен болуы керек.
Dialogue: 0,0:05:25.90,0:05:27.49,Default,,0,0,0,,Кім...
Dialogue: 0,0:05:27.57,0:05:29.07,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:30.66,0:05:34.58,Default,,0,0,0,,Өзгелер сияқты құсап жүрсің бе!
Dialogue: 0,0:05:34.66,0:05:35.83,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:38.12,0:05:40.67,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:05:41.29,0:05:44.09,Default,,0,0,0,,Бұл жігіт жасады!
Dialogue: 0,0:05:44.17,0:05:47.05,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:05:47.63,0:05:49.64,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:52.72,0:05:54.68,Default,,0,0,0,,Жоқ… жоқ…
Dialogue: 0,0:05:55.18,0:05:58.31,Default,,0,0,0,,Жоқ! Широ!
Dialogue: 0,0:05:58.39,0:06:01.40,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,0:06:02.19,0:06:04.11,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
Dialogue: 0,0:06:05.19,0:06:06.99,Default,,0,0,0,,Гохо Гехо...
Dialogue: 0,0:06:07.07,0:06:08.53,Default,,0,0,0,,Ю… Юрий
Dialogue: 0,0:06:09.03,0:06:11.95,Default,,0,0,0,,Ми... қара хи хи хи
Dialogue: 0,0:06:14.62,0:06:20.79,Default,,0,0,0,,Әй... мен саған... ұнаған адамға айналдым.
Dialogue: 0,0:06:27.88,0:06:30.47,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз бақытты болуыңыз керек.
Dialogue: 0,0:06:30.97,0:06:33.05,Default,,0,0,0,,Бұл саған, мен сені жақсы көремін.
Dialogue: 0,0:06:37.02,0:06:38.18,Default,,0,0,0,,Бақытты емес
Dialogue: 0,0:06:38.27,0:06:39.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:41.02,0:06:43.48,Default,,0,0,0,,Сіз өзіңізсіз.
Dialogue: 0,0:06:44.52,0:06:48.15,Default,,0,0,0,,Жараның ауыруы және өлім қорқынышы
Dialogue: 0,0:06:48.69,0:06:52.20,Default,,0,0,0,,Жалғыздықтың жалғыздығын білесің ғой, солай ма?
Dialogue: 0,0:06:53.12,0:06:55.95,Default,,0,0,0,,Бірақ сен неге адамдарды ренжітесің?
Dialogue: 0,0:06:56.04,0:06:57.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:57.45,0:06:59.04,Default,,0,0,0,,Білсем де!
Dialogue: 0,0:06:59.12,0:07:01.87,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:07:01.96,0:07:04.46,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:04.54,0:07:06.09,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:07:06.17,0:07:07.63,Default,,0,0,0,,Сіз қан жоғалтудан өлесіз.
Dialogue: 0,0:07:10.84,0:07:11.88,Default,,0,0,0,,...Орындаңыз
Dialogue: 0,0:07:11.97,0:07:16.14,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:16.72,0:07:18.43,Default,,0,0,0,,Мен сөйлесуім керек
Dialogue: 0,0:07:20.77,0:07:22.19,Default,,0,0,0,,...se
Dialogue: 0,0:07:23.40,0:07:24.94,Default,,0,0,0,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:07:25.02,0:07:25.90,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:07:25.98,0:07:28.44,Default,,0,0,0,,Мен сені сүйсем де
Dialogue: 0,0:07:29.61,0:07:30.99,Default,,0,0,0,,Шайтан оны тоқтатады
Dialogue: 0,0:07:31.07,0:07:32.57,Default,,0,0,0,,Неліктен оны қайтармасқа?
Dialogue: 0,0:07:32.66,0:07:35.20,Default,,0,0,0,,Махаббатты қайтар!
Dialogue: 0,0:07:35.28,0:07:37.99,Default,,0,0,0,,Уф, ах… Кеменің орнын анықтау үшін.
Dialogue: 0,0:07:38.87,0:07:42.29,Default,,0,0,0,,сенікі махаббат емес!
Dialogue: 0,0:07:42.37,0:07:43.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:52.18,0:07:53.89,Default,,0,0,0,,Гяаа! Уф...
Dialogue: 0,0:07:53.97,0:07:57.14,Default,,0,0,0,,Уф, гохо! Уф...
Dialogue: 0,0:07:57.22,0:07:59.47,Default,,0,0,0,,Гах, не... гах!
Dialogue: 0,0:07:59.56,0:08:03.06,Default,,0,0,0,,Юрий... Мен сені өлтіруге жол бермеймін.
Dialogue: 0,0:08:03.56,0:08:05.23,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:08:05.31,0:08:06.86,Default,,0,0,0,,Гехо…
Dialogue: 0,0:08:08.40,0:08:11.19,Default,,0,0,0,,Сіз оны ұрлаудан басқа ештеңе істей алмайсыз ба?
Dialogue: 0,0:08:11.28,0:08:12.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:12.53,0:08:15.53,Default,,0,0,0,,Бұл Теменің шегі.
Dialogue: 0,0:08:15.62,0:08:17.53,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:08:17.62,0:08:18.91,Default,,0,0,0,,«Неге мен — теңіз офицері — әскердің орнына?»
Dialogue: 0,0:08:24.25,0:08:25.42,Default,,0,0,0,,Широ!
Dialogue: 0,0:08:26.79,0:08:28.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:28.29,0:08:29.17,Default,,0,0,0,,Е...
Dialogue: 0,0:08:29.25,0:08:31.71,Default,,0,0,0,,Сен одан да қауіптісің.
Dialogue: 0,0:08:31.80,0:08:34.51,Default,,0,0,0,,Бұдан былай босанғаннан кейінгі кезеңді тездетемін.
Dialogue: 0,0:08:35.26,0:08:36.55,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:08:37.05,0:08:37.60,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:08:37.68,0:08:38.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.68,0:08:39.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:39.64,0:08:42.52,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:08:43.02,0:08:44.39,Default,,0,0,0,,Ба-ка
Dialogue: 0,0:08:44.89,0:08:48.11,Default,,0,0,0,,Мұндай құбыжық үшін өлуге қарсы ма?
Dialogue: 0,0:08:48.61,0:08:51.78,Default,,0,0,0,,Мен эликсир экспериментінде сыналатын болдым.
Dialogue: 0,0:08:52.28,0:08:54.65,Default,,0,0,0,,Қалпына келтіру қалыпты адамдарға қарағанда жылдамырақ
Dialogue: 0,0:08:55.86,0:09:00.03,Default,,0,0,0,,Таза кессең, бір сағатта жабысатынын білемін.
Dialogue: 0,0:09:00.53,0:09:02.58,Default,,0,0,0,,Бірақ абайсызда болыңыз
Dialogue: 0,0:09:02.66,0:09:03.66,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:09:03.75,0:09:07.08,Default,,0,0,0,,Осы уақытқа дейін жасасаңыз да, сіз оны әлі де қуа алмайсыз.
Dialogue: 0,0:09:07.58,0:09:09.79,Default,,0,0,0,,Мен ерте ме, кеш пе қайтамын.
Dialogue: 0,0:09:10.29,0:09:12.00,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:09:12.51,0:09:13.71,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:13.80,0:09:15.68,Default,,0,0,0,,Бұл Шемихаза
Dialogue: 0,0:09:16.30,0:09:18.22,Default,,0,0,0,,Не? А... солай ма?
Dialogue: 0,0:09:18.30,0:09:20.55,Default,,0,0,0,,Сізге сәттілік.
Dialogue: 0,0:09:20.64,0:09:24.35,Default,,0,0,0,,Шемихазаның императорлық энергиясы жасушаның белсендірілуіне ықпал етеді.
Dialogue: 0,0:09:24.98,0:09:27.60,Default,,0,0,0,,А... жара жабылып қалды.
Dialogue: 0,0:09:27.69,0:09:31.52,Default,,0,0,0,,Бүгін түнде менен басқа үш данышпан ауыр жараланды.
Dialogue: 0,0:09:31.61,0:09:35.74,Default,,0,0,0,,Төрт Ұлы Қасиетті Рыцарлар (Арканттар) Көптеген діни қызметкерлер мен жын шығарушылар
Dialogue: 0,0:09:35.82,0:09:38.82,Default,,0,0,0,,Көгілдір отта қаза тапты
Dialogue: 0,0:09:39.82,0:09:41.28,Default,,0,0,0,,Юрий Егин
Dialogue: 0,0:09:41.37,0:09:46.37,Default,,0,0,0,,Мұның бәрі шайтанның сіздің денеңізді іздеуінің нәтижесі.
Dialogue: 0,0:09:47.75,0:09:53.00,Default,,0,0,0,,Осы орасан зор шығынды ескере отырып, сізден эксорцист ретінде әрекет етуіңізді сұраймын.
Dialogue: 0,0:09:53.09,0:09:56.67,Default,,0,0,0,,Шайтанның ілтипатын үзу үшін сенің өлгеніңді қалаймын.
Dialogue: 0,0:09:56.76,0:09:57.68,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:00.26,0:10:01.35,Default,,0,0,0,,Балалар...
Dialogue: 0,0:10:02.14,0:10:07.10,Default,,0,0,0,,Шайтанның ықыласына бөленген кез келген адамды өлтірген дұрыс.
Dialogue: 0,0:10:08.06,0:10:12.11,Default,,0,0,0,,Жын шығарудың сиқырын анықтағанша, оған қамқорлық жасаудан басқа амалымыз жоқ.
Dialogue: 0,0:10:13.44,0:10:15.40,Default,,0,0,0,,Мені құрметпен қабыл алыңыздар.
Dialogue: 0,0:10:15.48,0:10:15.99,Default,,0,0,0,,Га
Dialogue: 0,0:10:16.57,0:10:17.57,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:18.24,0:10:19.24,Default,,0,0,0,,Сіз араласқыңыз келе ме?
Dialogue: 0,0:10:19.32,0:10:20.99,Default,,0,0,0,,Бұл жігіттің кінәсі жоқ
Dialogue: 0,0:10:21.07,0:10:22.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.58,0:10:24.95,Default,,0,0,0,,Бұл күнә туралы емес
Dialogue: 0,0:10:25.04,0:10:27.12,Default,,0,0,0,,Біз фактілер туралы айтып отырмыз.
Dialogue: 0,0:10:27.20,0:10:28.08,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:28.16,0:10:30.25,Default,,0,0,0,,-(А қызметші) Григорийдің алдында тұрмын. -(Қызметші Б) Не болып жатыр?
Dialogue: 0,0:10:32.63,0:10:33.38,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:33.46,0:10:34.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.42,0:10:36.01,Default,,0,0,0,,Мен үшін уайымдама — тез арада көліктен шық
Dialogue: 0,0:10:36.09,0:10:38.80,Default,,0,0,0,,Григорийдің өзіне мылтық сілтеді.
Dialogue: 0,0:10:38.88,0:10:40.76,Default,,0,0,0,,Сіз не істеп жатқаныңызды білесіз бе?
Dialogue: 0,0:10:41.76,0:10:42.89,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:10:44.76,0:10:46.27,Default,,0,0,0,,Мен сенің өлуіңе жол бермеймін
Dialogue: 0,0:10:51.81,0:10:52.98,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:10:53.06,0:10:56.36,Default,,0,0,0,,Сіз сатқындыққа лайықсыз!
Dialogue: 0,0:10:58.44,0:11:00.70,Default,,0,0,0,,Осы кілтпен есікті ашыңыз
Dialogue: 0,0:11:02.37,0:11:03.66,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:11:05.12,0:11:05.95,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:09.41,0:11:13.08,Default,,0,0,0,,Енді неге бәрін көрмейсің?
Dialogue: 0,0:11:18.88,0:11:21.01,Default,,0,0,0,,- (Қызметші А) Кешіріңіз - Жақсы.
Dialogue: 0,0:11:21.93,0:11:23.26,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:11:23.76,0:11:25.97,Default,,0,0,0,,Енді әлі де істеу керек.
Dialogue: 0,0:11:26.06,0:11:27.81,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:11:28.31,0:11:29.43,Default,,0,0,0,,Және...
Dialogue: 0,0:11:30.69,0:11:33.85,Default,,0,0,0,,Мүмкін бұл қыз әлдеқашан...
Dialogue: 0,0:11:39.65,0:11:40.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.44,0:11:43.16,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:43.24,0:11:44.78,Default,,0,0,0,,Өте жақын!
Dialogue: 0,0:11:44.87,0:11:45.87,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:46.49,0:11:48.45,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:11:48.54,0:11:49.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:49.70,0:11:50.87,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:11:51.37,0:11:54.63,Default,,0,0,0,,Бұл баяғыда жабылған Рыцарь труппасының филиалы.
Dialogue: 0,0:11:55.13,0:11:57.63,Default,,0,0,0,,Жақын жерде Yeti қарауыл мұнарасы бар.
Dialogue: 0,0:11:57.71,0:12:00.21,Default,,0,0,0,,Олар оны қайта өңдеп, жасырынуға айналдырды.
Dialogue: 0,0:12:03.68,0:12:05.68,Default,,0,0,0,,Қарлы боран басылғанда көшейік.
Dialogue: 0,0:12:06.18,0:12:08.89,Default,,0,0,0,,Бұл құпия жер, сондықтан біраз уақыт білмейсіз.
Dialogue: 0,0:12:08.97,0:12:10.85,Default,,0,0,0,,Мен сенің жасырынған жеріңді жақсы көремін.
Dialogue: 0,0:12:11.56,0:12:14.31,Default,,0,0,0,,А... қатты шулама, жарай ма?
Dialogue: 0,0:12:14.40,0:12:15.98,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:12:16.06,0:12:17.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:17.15,0:12:18.65,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:12:19.15,0:12:20.57,Default,,0,0,0,,-(Бала Юкио) Фуэ... -Ой.
Dialogue: 0,0:12:20.65,0:12:22.07,Default,,0,0,0,,(егіздердің жылауы)
Dialogue: 0,0:12:22.15,0:12:25.36,Default,,0,0,0,,Уау! Екеуміз бірге жылай бастадық.
Dialogue: 0,0:12:25.45,0:12:28.20,Default,,0,0,0,,-Ах... -(Широ) Егіздерден күткендей, синхрондалған иә?
Dialogue: 0,0:12:28.28,0:12:29.95,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:12:30.04,0:12:32.29,Default,,0,0,0,,Мен киетін нәрсе іздеймін.
Dialogue: 0,0:12:32.37,0:12:34.87,Default,,0,0,0,,Айналадағы заттарды отын ретінде пайдаланып, от жағыңыз.
Dialogue: 0,0:12:34.96,0:12:36.46,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:12:36.54,0:12:38.63,Default,,0,0,0,,(егіздердің жылауы)
Dialogue: 0,0:12:38.71,0:12:40.55,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:12:40.63,0:12:43.30,Default,,0,0,0,,Біз сіздің есімдеріңізді шешуіміз керек.
Dialogue: 0,0:12:43.84,0:12:44.63,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.72,0:12:45.84,Default,,0,0,0,,Эй
Dialogue: 0,0:12:46.47,0:12:48.51,Default,,0,0,0,,Бір қап тәттілер болды.
Dialogue: 0,0:12:48.60,0:12:50.22,Default,,0,0,0,,Менің киімім жақсы емес... Әй?
Dialogue: 0,0:12:51.14,0:12:52.39,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:12:54.02,0:12:55.48,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:55.56,0:12:56.65,Default,,0,0,0,,Сүт бездері
Dialogue: 0,0:12:56.73,0:12:57.65,Default,,0,0,0,,Оппа...
Dialogue: 0,0:12:57.73,0:13:00.07,Default,,0,0,0,,Мен қазір киімімде темекі шегіп жатырмын.
Dialogue: 0,0:13:00.15,0:13:02.19,Default,,0,0,0,,Шынайы ма? Содан кейін көбірек жеңіз.
Dialogue: 0,0:13:04.78,0:13:08.24,Default,,0,0,0,,Мен бұл балалардың есімдерін ойладым.
Dialogue: 0,0:13:08.32,0:13:10.24,Default,,0,0,0,,Бұл бала керемет дүниеге келген.
Dialogue: 0,0:13:10.33,0:13:12.66,Default,,0,0,0,,Фосфор отынан «фосфор».
Dialogue: 0,0:13:12.75,0:13:13.66,Default,,0,0,0,,Манма
Dialogue: 0,0:13:13.75,0:13:15.41,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:13:15.50,0:13:18.17,Default,,0,0,0,,Ал мына кішкентай бала
Dialogue: 0,0:13:18.25,0:13:20.67,Default,,0,0,0,,Юкиодан «Юкио».
Dialogue: 0,0:13:20.75,0:13:22.21,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:13:22.30,0:13:23.46,Default,,0,0,0,,Неге екен?
Dialogue: 0,0:13:24.05,0:13:25.05,Default,,0,0,0,,А...
Dialogue: 0,0:13:25.13,0:13:28.97,Default,,0,0,0,,Фосфор жақсы, бірақ Юкио қайдан пайда болды?
Dialogue: 0,0:13:29.05,0:13:30.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:30.89,0:13:33.64,Default,,0,0,0,,Аа, сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:13:33.72,0:13:35.18,Default,,0,0,0,,Мен қалжыңдамаймын!
Dialogue: 0,0:13:35.27,0:13:38.52,Default,,0,0,0,,Юкио жылы және күшті адам.
Dialogue: 0,0:13:38.60,0:13:39.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.02,0:13:42.23,Default,,0,0,0,,Одан гөрі мүлде жемейсің.
Dialogue: 0,0:13:42.32,0:13:45.07,Default,,0,0,0,,Оны саған берген менмін.
Dialogue: 0,0:13:45.15,0:13:48.11,Default,,0,0,0,,Бұл рас, Широ, сен әрқашан қатыгезсің.
Dialogue: 0,0:13:48.20,0:13:50.87,Default,,0,0,0,,Иә, мен сізге қарыздармын.
Dialogue: 0,0:13:50.95,0:13:53.12,Default,,0,0,0,,Хехе арамдық деген сөз
Dialogue: 0,0:13:55.62,0:13:56.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:57.08,0:14:00.92,Default,,0,0,0,,Қарлы боран айтарлықтай әлсіреді. Мен бақылау мұнарасын көріп тұрмын.
Dialogue: 0,0:14:01.42,0:14:05.26,Default,,0,0,0,,Жасырынбада электр қуаты, су және азық-түлік қоймасы бар, бұл оны қауіпсіз етеді.
Dialogue: 0,0:14:05.34,0:14:06.97,Default,,0,0,0,,Баратын болсаң, қазір.
Dialogue: 0,0:14:07.05,0:14:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.97,0:14:09.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:09.39,0:14:10.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.93,0:14:11.76,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:12.26,0:14:14.89,Default,,0,0,0,,Кешіріңіз... Мен сәл жеңілдеп қалдым.
Dialogue: 0,0:14:16.23,0:14:17.48,Default,,0,0,0,,Смақ!
Dialogue: 0,0:14:19.90,0:14:21.15,Default,,0,0,0,,Бәрін тоқтатайық
Dialogue: 0,0:14:21.65,0:14:22.65,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:23.48,0:14:25.48,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:14:25.57,0:14:26.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:26.49,0:14:27.74,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:28.86,0:14:31.12,Default,,0,0,0,,Сонымен... дұрыс.
Dialogue: 0,0:14:32.62,0:14:34.99,Default,,0,0,0,,Жаяу жүруге назар аударыңыз
Dialogue: 0,0:14:35.08,0:14:35.62,Default,,0,0,0,,Иә
Dialogue: 0,0:14:36.62,0:14:40.33,Default,,0,0,0,,(Широ мен Юрийдің ауыр тыныс алуы)
Dialogue: 0,0:14:40.42,0:14:45.00,Default,,0,0,0,,Шіркін, қар жаумағанда 15 минут қана жететін еді.
Dialogue: 0,0:14:45.50,0:14:47.63,Default,,0,0,0,,Yeti жоқ па?
Dialogue: 0,0:14:48.13,0:14:50.05,Default,,0,0,0,,Өшіп кеткен сияқты
Dialogue: 0,0:14:50.55,0:14:54.05,Default,,0,0,0,,Сондықтан застава да, қарауыл мұнарасы да жабылды.
Dialogue: 0,0:14:55.06,0:14:59.89,Default,,0,0,0,,Біз жасырынған жерге жеткенде, ха... не істеуіміз керек?
Dialogue: 0,0:15:01.15,0:15:05.19,Default,,0,0,0,,Хм, мен біраз уақыт жасырынып, не болатынын көремін.
Dialogue: 0,0:15:05.90,0:15:09.57,Default,,0,0,0,,Осы уақытта келесі жасырынатын жерді іздеңіз.
Dialogue: 0,0:15:11.41,0:15:16.33,Default,,0,0,0,,Кешіріңіз, мен Широны қашқынға айналдырдым.
Dialogue: 0,0:15:16.41,0:15:19.79,Default,,0,0,0,,Хмм, өте сергітеді.
Dialogue: 0,0:15:20.66,0:15:23.75,Default,,0,0,0,,Өйткені мен әрқашан еркін болғым келді
Dialogue: 0,0:15:24.71,0:15:26.84,Default,,0,0,0,,Мен мұны ертерек істеуім керек еді.
Dialogue: 0,0:15:32.18,0:15:34.93,Default,,0,0,0,,Осы жолы бірге өмір сүрейік
Dialogue: 0,0:15:35.01,0:15:35.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:36.72,0:15:39.98,Default,,0,0,0,,Мен әкені, сен ананы ойнайсың.
Dialogue: 0,0:15:40.56,0:15:42.06,Default,,0,0,0,,Көңілді сияқты, солай ма?
Dialogue: 0,0:15:47.90,0:15:48.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:55.20,0:15:57.24,Default,,0,0,0,,Иә... жақсы
Dialogue: 0,0:15:57.95,0:16:01.50,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:01.58,0:16:03.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:04.17,0:16:04.83,Default,,0,0,0,,Лилия!
Dialogue: 0,0:16:04.92,0:16:06.34,Default,,0,0,0,,Әй...
Dialogue: 0,0:16:07.92,0:16:08.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:12.22,0:16:15.18,Default,,0,0,0,,Менің күшім... кетті.
Dialogue: 0,0:16:21.27,0:16:24.19,Default,,0,0,0,,Широ менің арқамда
Dialogue: 0,0:16:26.65,0:16:29.65,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:16:29.73,0:16:33.15,Default,,0,0,0,,Хехе... Мен де Шура-чанға телефон соғым келеді.
Dialogue: 0,0:16:33.95,0:16:35.61,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:16:35.70,0:16:38.45,Default,,0,0,0,,Ал ол мені өзінің күйеуі деп ойлайды.
Dialogue: 0,0:16:38.53,0:16:40.41,Default,,0,0,0,,Иа... хех
Dialogue: 0,0:16:41.20,0:16:45.33,Default,,0,0,0,,Менің әке болғаным әділетсіздік емес пе?
Dialogue: 0,0:16:45.42,0:16:47.84,Default,,0,0,0,,Мен не істеуім керек? Бұл сергітеді.
Dialogue: 0,0:16:52.13,0:16:54.80,Default,,0,0,0,,Көктем келгенде, бұршақ тастаймыз
Dialogue: 0,0:16:54.88,0:16:56.55,Default,,0,0,0,,Широ - жын
Dialogue: 0,0:16:56.64,0:16:57.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:59.10,0:17:03.35,Default,,0,0,0,,Шие гүлдегенде мен оларды көргім келеді.
Dialogue: 0,0:17:06.06,0:17:08.52,Default,,0,0,0,,Жазда теңізге шомылу
Dialogue: 0,0:17:09.02,0:17:12.32,Default,,0,0,0,,Отшашуды тамашалап қарбыз жеу
Dialogue: 0,0:17:15.86,0:17:20.03,Default,,0,0,0,,Күзде мен көп дәмді тағам жеймін.
Dialogue: 0,0:17:20.53,0:17:24.20,Default,,0,0,0,,Маған жылы футонда ұйықтауға рұқсат етіңіз
Dialogue: 0,0:17:27.29,0:17:32.50,Default,,0,0,0,,Бізде әрқашан қыста туған күн кеші болады.
Dialogue: 0,0:17:36.47,0:17:42.85,Default,,0,0,0,,Широ, оның әкесі ретінде әрекет етіңіз.
Dialogue: 0,0:17:44.02,0:17:47.14,Default,,0,0,0,,Сосын бір күні
Dialogue: 0,0:17:47.69,0:17:52.69,Default,,0,0,0,,Өйткені ол нағыз әке болды.
Dialogue: 0,0:17:55.82,0:17:57.11,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:58.24,0:18:01.78,Default,,0,0,0,,Жарайды, сен осында болғанша, әйтеуір...
Dialogue: 0,0:18:05.20,0:18:07.54,Default,,0,0,0,,Юрий... Эй!
Dialogue: 0,0:18:07.62,0:18:09.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:09.12,0:18:11.04,Default,,0,0,0,,Жақындасың, берік бол!
Dialogue: 0,0:18:11.92,0:18:18.05,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:18:20.47,0:18:21.47,Default,,0,0,0,,Фосфор
Dialogue: 0,0:18:23.68,0:18:25.06,Default,,0,0,0,,Юкио
Dialogue: 0,0:18:26.48,0:18:30.48,Default,,0,0,0,,Ағайындар, жақсы араласыңдар.
Dialogue: 0,0:18:47.58,0:18:48.62,Default,,0,0,0,,(қолдың құлаған дыбысы)
Dialogue: 0,0:18:49.87,0:18:51.54,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:18:52.21,0:18:53.50,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:18:53.59,0:18:54.55,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:56.34,0:18:57.26,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:18:58.01,0:19:00.22,Default,,0,0,0,,Әлі де жылы
Dialogue: 0,0:19:01.51,0:19:04.01,Default,,0,0,0,,Өтінемін... өтінемін.
Dialogue: 0,0:19:05.06,0:19:08.27,Default,,0,0,0,,Біз алғаш танысқаннан бері...
Dialogue: 0,0:19:08.35,0:19:09.89,Default,,0,0,0,,Мен де сені жақсы көремін!
Dialogue: 0,0:19:20.61,0:19:23.78,Default,,0,0,0,,Эй... тыңдап тұрсың ба?
Dialogue: 0,0:19:31.00,0:19:32.04,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:34.08,0:19:36.88,Default,,0,0,0,,Мен сені енді естімеймін
Dialogue: 0,0:19:41.55,0:19:44.26,Default,,0,0,0,,Сіз дәл қазір күлдіңіз
Dialogue: 0,0:19:45.64,0:19:46.97,Default,,0,0,0,,Артық емес
Dialogue: 0,0:19:51.77,0:19:57.69,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:19:58.78,0:20:02.49,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:20:03.86,0:20:06.91,Default,,0,0,0,,Неліктен көбірек...
Dialogue: 0,0:20:08.29,0:20:10.04,Default,,0,0,0,,Тіпті мен...
Dialogue: 0,0:20:11.25,0:20:13.08,Default,,0,0,0,,Бәріне менің кінәм
Dialogue: 0,0:20:13.96,0:20:15.63,Default,,0,0,0,,Мен!
Dialogue: 0,0:20:18.30,0:20:25.30,Default,,0,0,0,,(егіздердің жылауы)
Dialogue: 0,0:20:26.05,0:20:28.47,Default,,0,0,0,,Куу… Куууу…
Dialogue: 0,0:20:28.56,0:20:33.48,Default,,0,0,0,,(Егіздердің жылауы)
Dialogue: 0,0:20:39.57,0:20:42.49,Default,,0,0,0,,(егіздердің жылауы)
Dialogue: 0,0:20:42.57,0:20:44.07,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:54.00,0:20:54.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.08,0:20:58.00,Default,,0,0,0,,…
Dialogue: 0,0:20:59.17,0:21:00.25,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:21:00.34,0:21:03.76,Default,,0,0,0,,Ха... аман қалдың.
Dialogue: 0,0:21:05.13,0:21:05.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:10.06,0:21:10.97,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:21:12.60,0:21:14.89,Default,,0,0,0,,Гохо Гехохо…
Dialogue: 0,0:21:15.39,0:21:21.44,Default,,0,0,0,,(егіздердің жылауы)
Dialogue: 0,0:21:21.53,0:21:22.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:23.94,0:21:25.86,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:21:26.78,0:21:28.78,Default,,0,0,0,,Осылай өл
Dialogue: 0,0:21:32.74,0:21:35.37,Default,,0,0,0,,Мен мейірімдірек бола алар едім.
Dialogue: 0,0:21:36.33,0:21:38.25,Default,,0,0,0,,Мен сені қорғай алар едім.
Dialogue: 0,0:21:40.09,0:21:42.34,Default,,0,0,0,,Өлді
Dialogue: 0,0:21:44.34,0:21:46.30,Default,,0,0,0,,Құбыжықтарға күлме
Dialogue: 0,0:21:47.47,0:21:50.18,Default,,0,0,0,,Мен ең жаман қоқыстан артық емеспін.
Dialogue: 0,0:21:53.39,0:21:56.69,Default,,0,0,0,,Басқа ештеңе жоқ...
Dialogue: 0,0:21:58.60,0:22:00.73,Default,,0,0,0,,Мен мотивация ала алмаймын
Dialogue: 0,0:22:05.90,0:22:07.90,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.41,0:23:35.41,Default,,0,0,0,,～♪
