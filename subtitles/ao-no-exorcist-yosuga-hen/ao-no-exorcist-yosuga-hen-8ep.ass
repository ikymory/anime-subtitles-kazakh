Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.37,0:00:04.37,Default,,0,0,0,,♪～
Dialogue: 0,0:01:27.42,0:01:29.42,Default,,0,0,0,,～♪
Dialogue: 0,0:01:36.13,0:01:38.80,Default,,0,0,0,,Көк түн басталады
Dialogue: 0,0:01:48.35,0:01:53.15,Default,,0,0,0,,Ю… Ри…
Dialogue: 0,0:01:56.32,0:02:01.20,Default,,0,0,0,,Әке... Қандай фигура.
Dialogue: 0,0:02:02.08,0:02:04.95,Default,,0,0,0,,А... Юрий?
Dialogue: 0,0:02:05.04,0:02:08.29,Default,,0,0,0,,Біреу бар ма? Бұл қайда?
Dialogue: 0,0:02:09.71,0:02:10.79,Default,,0,0,0,,Лилия…
Dialogue: 0,0:02:12.46,0:02:14.84,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:02:16.26,0:02:17.30,Default,,0,0,0,,Лилия
Dialogue: 0,0:02:18.38,0:02:24.06,Default,,0,0,0,,Юрий... неге мені тастап кеттің?
Dialogue: 0,0:02:25.14,0:02:29.44,Default,,0,0,0,,Үлкен күшке ие болудан болатын ауырсыну
Dialogue: 0,0:02:30.77,0:02:36.07,Default,,0,0,0,,Затқа жабысудың азабы
Dialogue: 0,0:02:36.57,0:02:38.07,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:02:39.32,0:02:42.07,Default,,0,0,0,,Дәл мен сияқты
Dialogue: 0,0:02:42.57,0:02:46.12,Default,,0,0,0,,Сіз менің қасымда боламын дедіңіз.
Dialogue: 0,0:02:48.12,0:02:49.00,Default,,0,0,0,,Лилия…
Dialogue: 0,0:02:50.62,0:02:54.59,Default,,0,0,0,,Маған тек сен керек
Dialogue: 0,0:02:55.63,0:02:58.72,Default,,0,0,0,,Жоқ... Маған ештеңе керек емес.
Dialogue: 0,0:02:59.80,0:03:02.72,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:03:09.56,0:03:10.85,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:03:10.94,0:03:14.15,Default,,0,0,0,,Гуаа!
Dialogue: 0,0:03:15.36,0:03:18.90,Default,,0,0,0,,Арх! Кәне!
Dialogue: 0,0:03:18.99,0:03:23.11,Default,,0,0,0,,Неге, Юрий! неге!
Dialogue: 0,0:03:23.20,0:03:27.12,Default,,0,0,0,,Сен маған опасыздық жасадың, Юрий!
Dialogue: 0,0:03:27.20,0:03:30.12,Default,,0,0,0,,Мен сені өлтіремін! Бұл инба...
Dialogue: 0,0:03:30.21,0:03:31.25,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:31.75,0:03:34.25,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:03:34.33,0:03:37.13,Default,,0,0,0,,А... Мен келдім!
Dialogue: 0,0:03:37.21,0:03:38.63,Default,,0,0,0,,Дене…
Dialogue: 0,0:03:39.13,0:03:42.30,Default,,0,0,0,,Ах! Менің денем!
Dialogue: 0,0:03:42.38,0:03:45.30,Default,,0,0,0,,- Дене! Дене, дене, дене... - Иә.
Dialogue: 0,0:03:46.85,0:03:49.10,Default,,0,0,0,,Дәл мен сияқты
Dialogue: 0,0:03:52.94,0:03:53.85,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:57.27,0:03:58.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:01.44,0:04:03.11,Default,,0,0,0,,Сол бейбақ...
Dialogue: 0,0:04:03.20,0:04:05.62,Default,,0,0,0,,Дене! дене! дене! дене!
Dialogue: 0,0:04:05.70,0:04:08.53,Default,,0,0,0,,Бұрынғы көк жарқыл не болды...
Dialogue: 0,0:04:08.62,0:04:10.41,Default,,0,0,0,,Кез келген жағдайда рыцарь тобына хабарласыңыз.
Dialogue: 0,0:04:10.50,0:04:11.58,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:04:11.66,0:04:14.75,Default,,0,0,0,,Кәне, бәріміз, ұйықтау уақыты келді.
Dialogue: 0,0:04:14.83,0:04:15.75,Default,,0,0,0,,Төсекке асығыңыз
Dialogue: 0,0:04:15.83,0:04:17.17,Default,,0,0,0,,- (Балалар) Иә? - (Аббат) Уф...
Dialogue: 0,0:04:17.25,0:04:18.42,Default,,0,0,0,,Аббат?
Dialogue: 0,0:04:18.50,0:04:20.25,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:04:20.34,0:04:21.51,Default,,0,0,0,,Аббат!
Dialogue: 0,0:04:21.59,0:04:23.01,Default,,0,0,0,,Дене! дене!
Dialogue: 0,0:04:23.09,0:04:24.97,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:04:25.05,0:04:26.34,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:04:26.43,0:04:30.10,Default,,0,0,0,,Уф... бұл Құдайдың жазасы.
Dialogue: 0,0:04:30.18,0:04:33.14,Default,,0,0,0,,Директор Эминеску, қашыңыз!
Dialogue: 0,0:04:33.23,0:04:34.60,Default,,0,0,0,,- (Зерттеуші) Иә? - Тағы біраз
Dialogue: 0,0:04:34.69,0:04:36.44,Default,,0,0,0,,Тағы да
Dialogue: 0,0:04:38.02,0:04:40.53,Default,,0,0,0,,-Майхаэла, жақсысың ба? -Иә.
Dialogue: 0,0:04:40.61,0:04:43.70,Default,,0,0,0,,(Зерттеушінің айқайы)
Dialogue: 0,0:04:45.03,0:04:45.70,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,0:04:45.78,0:04:47.12,Default,,0,0,0,,Дене Дене Дене!
Dialogue: 0,0:04:48.20,0:04:49.95,Default,,0,0,0,,- Уф! -Аа...
Dialogue: 0,0:04:50.03,0:04:52.33,Default,,0,0,0,,-Ааа! -Игорь!
Dialogue: 0,0:04:53.62,0:04:54.71,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:04:54.79,0:04:56.58,Default,,0,0,0,,- Мен үшін алаңдамай қаш - маған ұнамайды!
Dialogue: 0,0:04:56.67,0:04:58.33,Default,,0,0,0,,Келме!
Dialogue: 0,0:04:58.42,0:04:59.84,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:04:59.92,0:05:02.34,Default,,0,0,0,,Әке! Эй, не болып жатыр?
Dialogue: 0,0:05:02.42,0:05:04.09,Default,,0,0,0,,Маған біреу өрт сөндіргіш әкелсін!
Dialogue: 0,0:05:04.17,0:05:06.34,Default,,0,0,0,,Ей, маған құрмет керек.
Dialogue: 0,0:05:06.43,0:05:08.09,Default,,0,0,0,,Бір нәрсені тез істе!
Dialogue: 0,0:05:08.18,0:05:09.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.39,0:05:13.93,Default,,0,0,0,,Негізгі үйде бірдеңе шу болып жатыр ма?
Dialogue: 0,0:05:14.02,0:05:15.69,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:05:15.77,0:05:17.77,Default,,0,0,0,,Дүние дірілдеп тұр
Dialogue: 0,0:05:17.85,0:05:19.69,Default,,0,0,0,,Дене Дене Дене Дене Дене Денесі…
Dialogue: 0,0:05:22.48,0:05:23.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:23.74,0:05:24.32,Default,,0,0,0,,Әке!
Dialogue: 0,0:05:24.90,0:05:25.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:25.99,0:05:29.07,Default,,0,0,0,,Бобобо…боаа…
Dialogue: 0,0:05:29.16,0:05:32.83,Default,,0,0,0,,Дазума... Ааа...
Dialogue: 0,0:05:33.41,0:05:35.37,Default,,0,0,0,,Дарума мырза, өтінемін, қашыңыз.
Dialogue: 0,0:05:35.46,0:05:37.79,Default,,0,0,0,,...
Dialogue: 0,0:05:40.21,0:05:42.17,Default,,0,0,0,,Бобобо…
Dialogue: 0,0:05:42.25,0:05:45.09,Default,,0,0,0,,А... ау, суық.
Dialogue: 0,0:05:45.17,0:05:49.18,Default,,0,0,0,,Суық болса да денем... күйеді.
Dialogue: 0,0:05:49.26,0:05:51.30,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:05:51.39,0:05:52.51,Default,,0,0,0,,Некожо!
Dialogue: 0,0:05:54.39,0:05:57.94,Default,,0,0,0,,Мұны сізге барлық белгілер айтты ма?
Dialogue: 0,0:05:58.90,0:06:00.31,Default,,0,0,0,,Фуджимото-кун!
Dialogue: 0,0:06:01.31,0:06:02.86,Default,,0,0,0,,Иә, Вакамака
Dialogue: 0,0:06:03.36,0:06:06.03,Default,,0,0,0,,Храмдар отбасын аман-есен тау етегіне көшіру.
Dialogue: 0,0:06:06.11,0:06:07.07,Default,,0,0,0,,Жауап!
Dialogue: 0,0:06:07.15,0:06:07.78,Default,,0,0,0,,Хакузо
Dialogue: 0,0:06:07.86,0:06:08.86,Default,,0,0,0,,Иә
Dialogue: 0,0:06:08.95,0:06:11.12,Default,,0,0,0,,үшінна басшылық ету керек.
Dialogue: 0,0:06:11.20,0:06:13.20,Default,,0,0,0,,Түнгі жынның қасиетін ашу
Dialogue: 0,0:06:13.28,0:06:14.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:17.25,0:06:18.25,Default,,0,0,0,,Әкеңіз ше?
Dialogue: 0,0:06:18.33,0:06:20.29,Default,,0,0,0,,Дарума-самаға көмекке оралу
Dialogue: 0,0:06:20.37,0:06:21.54,Default,,0,0,0,,үшіннан сұраңыз!
Dialogue: 0,0:06:21.63,0:06:23.17,Default,,0,0,0,,Әке, аман болыңыз!
Dialogue: 0,0:06:23.96,0:06:25.09,Default,,0,0,0,,Аға
Dialogue: 0,0:06:26.13,0:06:27.76,Default,,0,0,0,,(Нишикидің айқайы)
Dialogue: 0,0:06:27.84,0:06:30.93,Default,,0,0,0,,Ана... Анашым!
Dialogue: 0,0:06:31.01,0:06:34.01,Default,,0,0,0,,Мен қазір Вакамаканың соңынан таудан төмен түсемін.
Dialogue: 0,0:06:34.97,0:06:35.89,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:06:35.97,0:06:38.14,Default,,0,0,0,,- (Джузо) Иә - (Кинзо) Оңай жеңіс!
Dialogue: 0,0:06:38.23,0:06:39.02,Default,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:06:39.10,0:06:41.35,Default,,0,0,0,,Жарайсыңдар балалар.
Dialogue: 0,0:06:43.73,0:06:47.40,Default,,0,0,0,,Жарайды, Ику-нии сені қорғайды.
Dialogue: 0,0:06:53.87,0:06:55.62,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:06:55.70,0:06:58.08,Default,,0,0,0,,Ко-чан, менің иығымнан ұста
Dialogue: 0,0:06:58.16,0:06:59.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:59.12,0:07:03.08,Default,,0,0,0,,Торако-сама, жоқ, ха...
Dialogue: 0,0:07:03.17,0:07:05.34,Default,,0,0,0,,Ко-чан мен оның баласына бірдеңе болса ше?
Dialogue: 0,0:07:05.42,0:07:07.51,Default,,0,0,0,,Некоджо-сан саған ұрысады.
Dialogue: 0,0:07:07.59,0:07:09.05,Default,,0,0,0,,Ах~ Уау
Dialogue: 0,0:07:09.76,0:07:12.43,Default,,0,0,0,,Қараңдар, Рюуши де солай істеуі керек.
Dialogue: 0,0:07:12.51,0:07:13.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:13.97,0:07:15.30,Default,,0,0,0,,(Нишикидің айқайы)
Dialogue: 0,0:07:15.39,0:07:17.81,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:17.89,0:07:20.02,Default,,0,0,0,,Менің аяғым ауырды~
Dialogue: 0,0:07:20.10,0:07:21.52,Default,,0,0,0,,Синдо…
Dialogue: 0,0:07:21.60,0:07:22.56,Default,,0,0,0,,үшінна сәттілік!
Dialogue: 0,0:07:24.15,0:07:25.40,Default,,0,0,0,,(Сима сәбидің жылауы)
Dialogue: 0,0:07:25.48,0:07:27.90,Default,,0,0,0,,Рензо Йошиёши
Dialogue: 0,0:07:28.40,0:07:31.61,Default,,0,0,0,,Өтінемін, мен бәріне бір рет үзіліс беруім керек.
Dialogue: 0,0:07:31.70,0:07:32.99,Default,,0,0,0,,Көңілсіз болмаңыз!
Dialogue: 0,0:07:33.07,0:07:35.87,Default,,0,0,0,,Ең алдымен таудан тезірек түсу керек.
Dialogue: 0,0:07:35.95,0:07:37.37,Default,,0,0,0,,Жарқыраған жеті монах
Dialogue: 0,0:07:37.45,0:07:39.25,Default,,0,0,0,,- (Вакамака С) Көк жалын! -(Вакамака және т.б.) Ах...
Dialogue: 0,0:07:39.33,0:07:41.16,Default,,0,0,0,,(Кіші орта мектеп оқушыларының айқайы)
Dialogue: 0,0:07:43.29,0:07:44.54,Default,,0,0,0,,- (Вакамака В) Уф! -(Вакамака А) Ахх...
Dialogue: 0,0:07:46.04,0:07:48.80,Default,,0,0,0,,Ааа!
Dialogue: 0,0:07:50.51,0:07:51.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:51.47,0:07:55.09,Default,,0,0,0,,Арсыз брат... Дааа!
Dialogue: 0,0:07:58.31,0:08:00.48,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:08:00.56,0:08:02.52,Default,,0,0,0,,Уф! Хаа...
Dialogue: 0,0:08:02.60,0:08:03.48,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:08:03.56,0:08:04.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:05.98,0:08:06.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:07.15,0:08:07.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.65,0:08:11.03,Default,,0,0,0,,Найза-ни~!
Dialogue: 0,0:08:11.74,0:08:15.66,Default,,0,0,0,,(культ мүшелерінің айқайы)
Dialogue: 0,0:08:15.74,0:08:19.04,Default,,0,0,0,,Елдің түкпір-түкпірінен жындардың зорлық-зомбылыққа айналғаны туралы хабарлар!
Dialogue: 0,0:08:19.12,0:08:21.91,Default,,0,0,0,,Менің танысымды басқару қиын менің басымнан бірінші рет болып тұр!
Dialogue: 0,0:08:22.00,0:08:25.79,Default,,0,0,0,,Ібілістің сәби өлтіруіне қатысы бар ма?
Dialogue: 0,0:08:25.88,0:08:27.50,Default,,0,0,0,,Немесе мүмкін емес...
Dialogue: 0,0:08:29.13,0:08:30.42,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:08:30.50,0:08:31.42,Default,,0,0,0,,Құрметті Альмаһир!
Dialogue: 0,0:08:31.51,0:08:33.42,Default,,0,0,0,,-Гррр... -(Қызметшілер) Эй!
Dialogue: 0,0:08:34.05,0:08:34.93,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:08:35.01,0:08:36.89,Default,,0,0,0,,Лорд Азазель!
Dialogue: 0,0:08:36.97,0:08:37.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:37.97,0:08:40.68,Default,,0,0,0,,Мен... Маған жақындама!
Dialogue: 0,0:08:40.77,0:08:42.23,Default,,0,0,0,,Руин No!
Dialogue: 0,0:08:42.31,0:08:43.43,Default,,0,0,0,,Оссеола, мені жібер!
Dialogue: 0,0:08:43.52,0:08:45.35,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:08:45.44,0:08:46.48,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:08:46.56,0:08:48.98,Default,,0,0,0,,Шайтанның күштеп иеленуі мүмкін
Dialogue: 0,0:08:49.48,0:08:50.86,Default,,0,0,0,,(Гран Торино) Өкінішті. Мұндай ұсақ-түйекке тіпті реакция бере алмасаң—
Dialogue: 0,0:08:51.48,0:08:52.40,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:52.49,0:08:53.61,Default,,0,0,0,,Лорд Шемихаза!
Dialogue: 0,0:08:54.40,0:08:56.45,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:08:56.53,0:08:59.91,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:08:59.99,0:09:01.37,Default,,0,0,0,,Мен шыдадым...
Dialogue: 0,0:09:01.45,0:09:02.66,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:02.75,0:09:06.62,Default,,0,0,0,,Шайтан ыдыс іздеп адасып кете бастады.
Dialogue: 0,0:09:06.71,0:09:07.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.79,0:09:09.54,Default,,0,0,0,,-Илья-ха... Иә!
Dialogue: 0,0:09:09.63,0:09:11.67,Default,,0,0,0,,Шиемиді баспанаға апарыңыз
Dialogue: 0,0:09:11.75,0:09:12.88,Default,,0,0,0,,Иә
Dialogue: 0,0:09:12.96,0:09:15.63,Default,,0,0,0,,Құрсақтағы балаңызға ешнәрсе болғанына жол бермеңіз.
Dialogue: 0,0:09:15.72,0:09:16.63,Default,,0,0,0,,Ана?
Dialogue: 0,0:09:18.26,0:09:20.81,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:09:23.98,0:09:27.02,Default,,0,0,0,,Ууу...
Dialogue: 0,0:09:27.10,0:09:28.27,Default,,0,0,0,,Гяаааа!
Dialogue: 0,0:09:28.35,0:09:30.52,Default,,0,0,0,,Уау! Гах!
Dialogue: 0,0:09:30.61,0:09:32.94,Default,,0,0,0,,Әнші рыцарь жарамсыз. Шегіну.
Dialogue: 0,0:09:33.03,0:09:33.78,Default,,0,0,0,,Қасиетті Рыцарь!
Dialogue: 0,0:09:33.86,0:09:36.78,Default,,0,0,0,,Медицина рыцарлары (дәрігерлер) Юрий Егинді алып шығуға тырысады.
Dialogue: 0,0:09:36.86,0:09:38.91,Default,,0,0,0,,Цк, осы қарбалас уақытта.
Dialogue: 0,0:09:38.99,0:09:41.99,Default,,0,0,0,,Тоқта, ішіңде әлі бір балық қалды.
Dialogue: 0,0:09:42.08,0:09:43.79,Default,,0,0,0,,Егер қайшылық болса...
Dialogue: 0,0:09:44.41,0:09:45.37,Default,,0,0,0,,Га
Dialogue: 0,0:09:47.25,0:09:49.96,Default,,0,0,0,,Қасиетті рыцарьлардың төрт ұлы рыцарлары (арканттар) шайқасқа дайындалуда
Dialogue: 0,0:09:51.71,0:09:54.55,Default,,0,0,0,,Мына бала мен оның құрсағындағы бала жәй ғана адам!
Dialogue: 0,0:09:54.63,0:09:56.30,Default,,0,0,0,,Мен операция жасаймын.
Dialogue: 0,0:09:56.38,0:09:57.80,Default,,0,0,0,,Дәлел жоқ!
Dialogue: 0,0:09:57.88,0:10:00.30,Default,,0,0,0,,Екі баланы да өлтіруді бұйырды.
Dialogue: 0,0:10:00.39,0:10:02.56,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, ана денесі...
Dialogue: 0,0:10:02.64,0:10:04.68,Default,,0,0,0,,Уақыт – уақыт.
Dialogue: 0,0:10:04.77,0:10:06.56,Default,,0,0,0,,Бала өлсе, проблема жоқ
Dialogue: 0,0:10:06.64,0:10:07.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:07.48,0:10:10.15,Default,,0,0,0,,Жоқ, сен өлім алдында тұрған жоқсың ба?
Dialogue: 0,0:10:10.65,0:10:13.07,Default,,0,0,0,,Мен оны өлтірсем, тезірек болар еді.
Dialogue: 0,0:10:13.15,0:10:14.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:15.69,0:10:18.74,Default,,0,0,0,,Жоқ... адасып қалдыңыз ба?
Dialogue: 0,0:10:18.82,0:10:21.32,Default,,0,0,0,,Балалар, салқындап, аяққа тұрыңдар!
Dialogue: 0,0:10:22.16,0:10:24.49,Default,,0,0,0,,Егинді өлтіру туралы бұйрық әлі берілген жоқ.
Dialogue: 0,0:10:24.58,0:10:26.58,Default,,0,0,0,,Келесі жылжытқанда міндетті түрде ату керек.
Dialogue: 0,0:10:26.66,0:10:28.75,Default,,0,0,0,,- (Қасиетті Рыцарьлар)... бұл сатқындық! -(Нагатомо) Жоқ!
Dialogue: 0,0:10:28.83,0:10:31.42,Default,,0,0,0,,Діни қызметкер үш данышпанның бұйрығын орындайды.
Dialogue: 0,0:10:31.50,0:10:32.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:32.17,0:10:36.59,Default,,0,0,0,,Юрий, сен мені естисің бе? Осы қарқынмен сіз өлтіресіз.
Dialogue: 0,0:10:36.67,0:10:38.17,Default,,0,0,0,,Өмір сүргің келсе, туа бер
Dialogue: 0,0:10:38.67,0:10:39.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:40.63,0:10:43.85,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:10:43.93,0:10:48.02,Default,,0,0,0,,Мен жай ғана демалып жатыр едім...
Dialogue: 0,0:10:48.10,0:10:48.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:49.27,0:10:52.36,Default,,0,0,0,,Гііііі! Жиііі!
Dialogue: 0,0:10:54.19,0:10:57.94,Default,,0,0,0,,Та…
Dialogue: 0,0:11:01.70,0:11:05.16,Default,,0,0,0,,Тизона Колада
Dialogue: 0,0:11:07.20,0:11:08.91,Default,,0,0,0,,Elmode
Dialogue: 0,0:11:11.92,0:11:12.83,Default,,0,0,0,,Гинтра!
Dialogue: 0,0:11:12.92,0:11:14.29,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:16.46,0:11:19.72,Default,,0,0,0,,Гаа! Гаа!
Dialogue: 0,0:11:19.80,0:11:21.34,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:21.43,0:11:24.85,Default,,0,0,0,,Ки-ии
Dialogue: 0,0:11:28.18,0:11:29.93,Default,,0,0,0,,tsk chocomakato епті
Dialogue: 0,0:11:30.89,0:11:33.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:33.10,0:11:35.36,Default,,0,0,0,,Ааа!
Dialogue: 0,0:11:35.44,0:11:37.36,Default,,0,0,0,,Жарайды, енді.
Dialogue: 0,0:11:37.44,0:11:40.90,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,0:11:41.70,0:11:42.86,Default,,0,0,0,,Туған!
Dialogue: 0,0:11:43.99,0:11:47.95,Default,,0,0,0,,(Лилияның ауыр тыныс алуы)
Dialogue: 0,0:11:48.04,0:11:48.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:50.29,0:11:51.58,Default,,0,0,0,,Бірінші айқай...
Dialogue: 0,0:11:53.21,0:11:56.13,Default,,0,0,0,,Асфиксия жағдайында. NICU орналасқан емдеу бөлмесіне барыңыз.
Dialogue: 0,0:11:56.21,0:11:57.92,Default,,0,0,0,,Асығыңыз, әйтпесе тым кеш
Dialogue: 0,0:11:58.00,0:11:58.88,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:58.96,0:12:02.51,Default,,0,0,0,,Менің сол аш аруақты жаттығу алаңынан шығаруға шамам жоқ.
Dialogue: 0,0:12:03.01,0:12:06.39,Default,,0,0,0,,Шайтанның баласының ізі бар-жоғын тексереміз.
Dialogue: 0,0:12:06.47,0:12:07.64,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:12:07.72,0:12:09.14,Default,,0,0,0,,- (Қасиетті Рыцарлар) Маған беріңіз! - (медициналық инженер Найт А) Ой, тоқта...
Dialogue: 0,0:12:09.22,0:12:10.18,Default,,0,0,0,,Хун
Dialogue: 0,0:12:10.27,0:12:13.02,Default,,0,0,0,,Хаха, мүлде қозғалмайды.
Dialogue: 0,0:12:13.10,0:12:15.02,Default,,0,0,0,,Жарайды, сіз оны ынталандыруға тырысыңыз.
Dialogue: 0,0:12:15.10,0:12:15.65,Default,,0,0,0,,Иә
Dialogue: 0,0:12:17.11,0:12:17.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:17.98,0:12:19.78,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:12:19.86,0:12:21.74,Default,,0,0,0,,Иә, жауап жоқ
Dialogue: 0,0:12:21.82,0:12:23.61,Default,,0,0,0,,Көздің түсін тексеріңіз
Dialogue: 0,0:12:23.70,0:12:26.53,Default,,0,0,0,,Көк түспен жанса, ол да шайтанның баласы.
Dialogue: 0,0:12:26.62,0:12:27.53,Default,,0,0,0,,Га
Dialogue: 0,0:12:30.37,0:12:33.21,Default,,0,0,0,,Оң көз жасыл, қалыпты
Dialogue: 0,0:12:33.29,0:12:36.54,Default,,0,0,0,,Тоқта... өлесің.
Dialogue: 0,0:12:37.13,0:12:38.63,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:12:40.34,0:12:42.26,Default,,0,0,0,,Мен жаңартамын
Dialogue: 0,0:12:43.05,0:12:45.59,Default,,0,0,0,,Сонымен бала...
Dialogue: 0,0:12:46.09,0:12:47.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:47.72,0:12:49.14,Default,,0,0,0,,Ууууу~
Dialogue: 0,0:12:51.43,0:12:53.56,Default,,0,0,0,,Угяаа!
Dialogue: 0,0:12:59.06,0:13:00.69,Default,,0,0,0,,Ха... алшақтық!
Dialogue: 0,0:13:01.28,0:13:01.86,Default,,0,0,0,,Инд өзені дельта аймағында орналасқан—
Dialogue: 0,0:13:01.94,0:13:04.20,Default,,0,0,0,,Тоқтатылды! Қазір болды!
Dialogue: 0,0:13:04.70,0:13:06.36,Default,,0,0,0,,Жарайсың Локсли
Dialogue: 0,0:13:07.74,0:13:08.74,Default,,0,0,0,,Сіздің тынысыңыз ше?
Dialogue: 0,0:13:11.49,0:13:13.04,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:13:14.12,0:13:14.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:14.71,0:13:16.37,Default,,0,0,0,,(Бала Юкионың жылағаны)
Dialogue: 0,0:13:16.46,0:13:17.71,Default,,0,0,0,,Мен жандандым!
Dialogue: 0,0:13:17.79,0:13:18.88,Default,,0,0,0,,О...
Dialogue: 0,0:13:18.96,0:13:23.13,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:13:24.26,0:13:25.59,Default,,0,0,0,,Сіз мені ұстағыңыз келе ме?
Dialogue: 0,0:13:25.67,0:13:28.43,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:29.22,0:13:34.48,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:13:39.77,0:13:40.65,Default,,0,0,0,,Тизона
Dialogue: 0,0:13:40.73,0:13:43.28,Default,,0,0,0,,Максима Фуэго Энкелей!
Dialogue: 0,0:13:49.62,0:13:50.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:51.62,0:13:53.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:08.68,0:14:10.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:10.89,0:14:12.10,Default,,0,0,0,,Куу…
Dialogue: 0,0:14:14.06,0:14:14.77,Default,,0,0,0,,Цк
Dialogue: 0,0:14:14.85,0:14:17.69,Default,,0,0,0,,Сен қазір көрінесің бе, қарғыс атқыр сайқымазақ?
Dialogue: 0,0:14:17.77,0:14:18.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.56,0:14:22.65,Default,,0,0,0,,Палладион жойылды. «Көгілдір найзағай» операциясы сәтсіз аяқталды.
Dialogue: 0,0:14:23.98,0:14:26.78,Default,,0,0,0,,Мен оны осы жерден шешемін.
Dialogue: 0,0:14:26.86,0:14:29.61,Default,,0,0,0,,Дәрігерлер, сіз енді жауапты емессіз.
Dialogue: 0,0:14:29.70,0:14:30.82,Default,,0,0,0,,Шегіну
Dialogue: 0,0:14:30.91,0:14:31.91,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:14:32.78,0:14:34.91,Default,,0,0,0,,Бұл менің көзқарасым бойынша айтылған сөз.
Dialogue: 0,0:14:35.58,0:14:37.08,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:37.58,0:14:39.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:40.83,0:14:41.67,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:14:41.75,0:14:43.92,Default,,0,0,0,,Мен сене алмадым!
Dialogue: 0,0:14:44.50,0:14:45.50,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:14:45.59,0:14:48.30,Default,,0,0,0,,Енді... не істейсің?
Dialogue: 0,0:14:48.38,0:14:49.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:49.84,0:14:50.80,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:52.22,0:14:53.93,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:59.39,0:15:02.06,Default,,0,0,0,,Тіпті Паладиннің отын қылышымен (Тисона)
Dialogue: 0,0:15:02.15,0:15:04.82,Default,,0,0,0,,Шайтанның баласының жүрегін жою мүмкін емес.
Dialogue: 0,0:15:05.73,0:15:08.15,Default,,0,0,0,,Егер ол адам екеуміз тікелей текетіресіп қалсақ,
Dialogue: 0,0:15:08.24,0:15:11.82,Default,,0,0,0,,Оның қазіргіден де үлкен апат болатыны сөзсіз.
Dialogue: 0,0:15:13.07,0:15:13.82,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:15:14.58,0:15:16.49,Default,,0,0,0,,Егер бұл қылыш...
Dialogue: 0,0:15:18.91,0:15:21.75,Default,,0,0,0,,Иесі оның бос екенін айтты.
Dialogue: 0,0:15:21.83,0:15:23.33,Default,,0,0,0,,Сондықтан бұл жақсы.
Dialogue: 0,0:15:23.42,0:15:27.84,Default,,0,0,0,,Негізі, бұл қылышты мен шамамен 150 жыл бұрын жасағанмын.
Dialogue: 0,0:15:27.92,0:15:30.05,Default,,0,0,0,,Жас монахқа не берілді
Dialogue: 0,0:15:30.13,0:15:30.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.05,0:15:32.22,Default,,0,0,0,,Сену
Dialogue: 0,0:15:32.30,0:15:34.18,Default,,0,0,0,,...
Dialogue: 0,0:15:35.35,0:15:37.26,Default,,0,0,0,,Шайтанның баласын бәрібір қалай жеңуге болады?
Dialogue: 0,0:15:37.35,0:15:38.77,Default,,0,0,0,,Ешкім түсінбейді
Dialogue: 0,0:15:38.85,0:15:41.35,Default,,0,0,0,,Бізге қолымыздан келгенін тырысу ғана қалды.
Dialogue: 0,0:15:41.44,0:15:44.61,Default,,0,0,0,,Уу-у-у-у-у-у
Dialogue: 0,0:15:44.69,0:15:46.11,Default,,0,0,0,,- (Широ) Барыңыз - (Куробе/Киодо) Ха!
Dialogue: 0,0:15:46.19,0:15:48.57,Default,,0,0,0,,- (Широ) Ең жоғары сапалы қорғаныс құралдарын киіңіз - (Нагатомо) Ха!
Dialogue: 0,0:15:51.24,0:15:54.87,Default,,0,0,0,,Ақиқатпен Гард, әділдікпен төсбелгі
Dialogue: 0,0:15:54.95,0:15:58.45,Default,,0,0,0,,Намаз – дулыға, иман – қалқан
Dialogue: 0,0:15:58.95,0:16:00.50,Default,,0,0,0,,Рухтың қылышын алыңыз
Dialogue: 0,0:16:02.75,0:16:03.83,Default,,0,0,0,,Широ
Dialogue: 0,0:16:05.08,0:16:06.50,Default,,0,0,0,,Ұрыспас
Dialogue: 0,0:16:06.59,0:16:07.59,Default,,0,0,0,,Чи…
Dialogue: 0,0:16:08.09,0:16:12.26,Default,,0,0,0,,Ол бізді де, өзін де қорғап жүрген шығар.
Dialogue: 0,0:16:13.18,0:16:16.76,Default,,0,0,0,,Бізді жайына қалдыр, бәрі қашады.
Dialogue: 0,0:16:17.51,0:16:18.64,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:16:28.11,0:16:29.11,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:34.11,0:16:36.37,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:16:40.62,0:16:42.91,Default,,0,0,0,,Сәлем! Қаптама да маңызды.
Dialogue: 0,0:16:43.00,0:16:43.79,Default,,0,0,0,,Гааах!
Dialogue: 0,0:16:49.88,0:16:53.05,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:17:02.89,0:17:03.73,Default,,0,0,0,,Угят
Dialogue: 0,0:17:03.81,0:17:05.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:06.52,0:17:08.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:08.90,0:17:09.90,Default,,0,0,0,,Жігіт!
Dialogue: 0,0:17:11.40,0:17:12.69,Default,,0,0,0,,Жиі!
Dialogue: 0,0:17:14.57,0:17:15.49,Default,,0,0,0,,Широ!
Dialogue: 0,0:17:18.74,0:17:21.20,Default,,0,0,0,,Зеукун Преке Заурер
Dialogue: 0,0:17:21.70,0:17:24.00,Default,,0,0,0,,Керкейс Плутон
Dialogue: 0,0:17:24.50,0:17:25.96,Default,,0,0,0,,Еуропа Эвдора
Dialogue: 0,0:17:29.84,0:17:31.00,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:31.59,0:17:36.76,Default,,0,0,0,,Теңіз құдайы Санзенхиме-мияға дұға ет
Dialogue: 0,0:17:37.34,0:17:39.18,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:39.93,0:17:40.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:40.51,0:17:43.39,Default,,0,0,0,,Гуу...
Dialogue: 0,0:17:43.47,0:17:45.56,Default,,0,0,0,,Гейееее!
Dialogue: 0,0:17:47.10,0:17:47.60,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:17:47.69,0:17:49.94,Default,,0,0,0,,Ұлы Су Рухының су түрмесі (Oceanides Carcel)!
Dialogue: 0,0:18:00.32,0:18:03.70,Default,,0,0,0,,Шыңырау...
Dialogue: 0,0:18:13.30,0:18:15.71,Default,,0,0,0,,Шыңырау...
Dialogue: 0,0:18:15.80,0:18:18.72,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:18:20.34,0:18:22.97,Default,,0,0,0,,Өл!
Dialogue: 0,0:18:34.40,0:18:35.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:44.08,0:18:46.79,Default,,0,0,0,,Бала, ұйықтай бер!
Dialogue: 0,0:18:46.87,0:18:49.96,Default,,0,0,0,,Горуаа!
Dialogue: 0,0:18:50.04,0:18:50.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.29,0:18:54.71,Default,,0,0,0,,Не?
Dialogue: 0,0:18:56.51,0:18:59.30,Default,,0,0,0,,Жүрек... қылышқа
Dialogue: 0,0:19:00.55,0:19:02.09,Default,,0,0,0,,Ой
Dialogue: 0,0:19:04.81,0:19:05.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:06.01,0:19:09.10,Default,,0,0,0,,Бұл қылыш барлық жерде есіктің бір түрі.
Dialogue: 0,0:19:11.85,0:19:15.65,Default,,0,0,0,,Тұтқаны бос орынға апарады, ал қабық есікке айналады.
Dialogue: 0,0:19:15.73,0:19:17.19,Default,,0,0,0,,Екі заттың бірге болуы арқылы
Dialogue: 0,0:19:17.28,0:19:20.45,Default,,0,0,0,,Ібіліс тозақта мөрленуі мүмкін.
Dialogue: 0,0:19:20.53,0:19:23.53,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:19:23.62,0:19:24.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:25.08,0:19:27.41,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:27.49,0:19:28.75,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:19:28.83,0:19:30.91,Default,,0,0,0,,Жүректі мөрлеу арқылы
Dialogue: 0,0:19:31.00,0:19:33.92,Default,,0,0,0,,Сіз жындық болмысыңыздан ажырап қалған сияқтысыз.
Dialogue: 0,0:19:34.42,0:19:36.13,Default,,0,0,0,,Бұл сіздің адам болғаныңызды білдіре ме?
Dialogue: 0,0:19:36.21,0:19:37.09,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:37.17,0:19:41.01,Default,,0,0,0,,Бұл сәбидің әрі адам, әрі жын екендігі
Dialogue: 0,0:19:41.09,0:19:42.01,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:19:43.05,0:19:45.64,Default,,0,0,0,,Олай болса, қазір тыныш жатқанда мені өлтір...
Dialogue: 0,0:19:45.72,0:19:47.39,Default,,0,0,0,,Тіпті өлтіргеннен кейін де...
Dialogue: 0,0:19:48.81,0:19:52.19,Default,,0,0,0,,Жүрек жойылмайынша, ол жанданады
Dialogue: 0,0:19:52.27,0:19:56.40,Default,,0,0,0,,Оның үстіне мөр тек мөр, ол мәңгілік емес.
Dialogue: 0,0:19:57.07,0:20:03.74,Default,,0,0,0,,Қазіргі уақытта мәйітті жартылай түрмеге қамап, жоюды жалғастыру жалғыз нұсқа.
Dialogue: 0,0:20:04.24,0:20:07.16,Default,,0,0,0,,Бірақ біз де адамбыз.
Dialogue: 0,0:20:07.66,0:20:13.17,Default,,0,0,0,,Егер адам өз денесін бұзатын болса, ол қандай тұлға болып қалыптасады?
Dialogue: 0,0:20:14.79,0:20:18.34,Default,,0,0,0,,Екінші Шайтанды немесе Люциферді дүниеге әкелгіңіз келе ме?
Dialogue: 0,0:20:18.42,0:20:21.01,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:20:22.59,0:20:24.30,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:25.93,0:20:30.18,Default,,0,0,0,,Мұның алдын алу үшін...
Dialogue: 0,0:20:33.39,0:20:36.61,Default,,0,0,0,,Оны анасының құшағына қайтарған дұрыс.
Dialogue: 0,0:20:36.69,0:20:40.61,Default,,0,0,0,,Ах... Лорд Ферес...
Dialogue: 0,0:20:41.65,0:20:43.49,Default,,0,0,0,,(Лилидің айқайы)
Dialogue: 0,0:20:44.20,0:20:45.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:45.95,0:20:48.62,Default,,0,0,0,,(Лилидің айқайы)
Dialogue: 0,0:20:48.70,0:20:52.37,Default,,0,0,0,,Маған алғыс айтуды доғарыңыз.
Dialogue: 0,0:20:52.45,0:20:53.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:53.62,0:20:54.79,Default,,0,0,0,,Жаңа қол келе жатыр.
Dialogue: 0,0:20:55.50,0:20:57.96,Default,,0,0,0,,- (Қасиетті рыцарлар) Ооо! -Ааа!
Dialogue: 0,0:20:58.04,0:20:59.59,Default,,0,0,0,,Көк жалын
Dialogue: 0,0:20:59.67,0:21:01.84,Default,,0,0,0,,Жүрек мөрленген жоқ па?
Dialogue: 0,0:21:01.92,0:21:04.13,Default,,0,0,0,,Бұл сәбидің ісі емес
Dialogue: 0,0:21:04.22,0:21:04.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.80,0:21:07.55,Default,,0,0,0,,Гррр… Уау!
Dialogue: 0,0:21:07.64,0:21:08.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:08.30,0:21:09.89,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:21:09.97,0:21:12.93,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:21:13.02,0:21:14.89,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:21:14.98,0:21:15.89,Default,,0,0,0,,Паладин!
Dialogue: 0,0:21:15.98,0:21:19.44,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,0:21:19.94,0:21:24.40,Default,,0,0,0,,Ах... Ото... Әке...
Dialogue: 0,0:21:26.82,0:21:27.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:36.54,0:21:40.42,Default,,0,0,0,,А? Бұл Моцуна
Dialogue: 0,0:21:41.09,0:21:41.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.71,0:21:44.97,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:21:45.05,0:21:47.72,Default,,0,0,0,,Хи хи хи хи!
Dialogue: 0,0:21:47.80,0:21:51.18,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:21:53.02,0:21:53.93,Default,,0,0,0,,Шайтан…
Dialogue: 0,0:21:54.02,0:21:59.44,Default,,0,0,0,,Мен таптым, Юрий!
Dialogue: 0,0:21:59.94,0:22:04.23,Default,,0,0,0,,Широ!
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.41,0:23:35.41,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.91,0:23:42.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
