Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:00:31.07,0:00:34.07,Default,,0,0,0,,Фуфуфуфуфуфуфу Бұл қандай нәрсе?
Dialogue: 0,0:00:39.08,0:00:41.49,Default,,0,0,0,,Нобита-сан, сен тым алданып бара жатырсың.
Dialogue: 0,0:00:41.83,0:00:43.46,Default,,0,0,0,,Сіз қалай ойлайсыз? бұл менің шеберлігім
Dialogue: 0,0:00:43.96,0:00:46.17,Default,,0,0,0,,Нобита-кун, келесі метеориттер тобы.
Dialogue: 0,0:00:46.46,0:00:47.88,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:00:48.38,0:00:49.34,Default,,0,0,0,,Уф… гүрс…
Dialogue: 0,0:00:50.04,0:00:51.59,Default,,0,0,0,,Уф аххх
Dialogue: 0,0:00:52.55,0:00:53.47,Default,,0,0,0,,Әй
Dialogue: 0,0:00:54.30,0:00:55.68,Default,,0,0,0,,Соқтығыс!
Dialogue: 0,0:00:57.47,0:00:59.14,Default,,0,0,0,,Салқын
Dialogue: 0,0:01:03.14,0:01:04.27,Default,,0,0,0,,Уау
Dialogue: 0,0:01:09.31,0:01:10.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:10.65,0:01:13.57,Default,,0,0,0,,Нобита-сан, мен бітті деп ойладым.
Dialogue: 0,0:01:16.03,0:01:17.91,Default,,0,0,0,,Сен қолыңнан келгеннің бәрін жасадың, Нобита-кун.
Dialogue: 0,0:01:21.16,0:01:23.54,Default,,0,0,0,,Жарайды, бәріміз бірден барайық.
Dialogue: 0,0:01:23.79,0:01:24.54,Default,,0,0,0,,Уау
Dialogue: 0,0:01:28.58,0:01:29.42,Default,,0,0,0,,Уау
Dialogue: 0,0:01:29.88,0:01:30.92,Default,,0,0,0,,Ах
Dialogue: 0,0:01:38.05,0:01:40.64,Default,,0,0,0,,Нобита-кун, одан әрі тиіп кетсең, бітті.
Dialogue: 0,0:01:40.76,0:01:42.26,Default,,0,0,0,,180 градусқа бұрылу!
Dialogue: 0,0:01:42.43,0:01:43.43,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:45.48,0:01:46.56,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:01:48.27,0:01:49.27,Default,,0,0,0,,Әй
Dialogue: 0,0:01:52.86,0:01:55.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:55.32,0:01:57.15,Default,,0,0,0,,Додододо… Дораемон
Dialogue: 0,0:01:57.53,0:01:59.99,Default,,0,0,0,,Басқару таяқшасы жұмыс істемейді.
Dialogue: 0,0:02:00.28,0:02:02.37,Default,,0,0,0,,Нобита-кун! Нобита-сан!
Dialogue: 0,0:02:05.37,0:02:07.58,Default,,0,0,0,,Вааах!
Dialogue: 0,0:02:12.67,0:02:14.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:16.09,0:02:17.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:25.97,0:02:28.23,Default,,0,0,0,,Ойын аяқталды ма?
Dialogue: 0,0:02:28.35,0:02:31.56,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:02:35.23,0:02:36.78,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:02:40.99,0:02:41.82,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:02:42.32,0:02:44.70,Default,,0,0,0,,Шизука-чан да соққыға жығылды ма?
Dialogue: 0,0:02:45.45,0:02:47.83,Default,,0,0,0,,Сондықтан мен және Сунео
Dialogue: 0,0:02:47.95,0:02:49.79,Default,,0,0,0,,Мақсатқа жету
Dialogue: 0,0:02:50.21,0:02:53.17,Default,,0,0,0,,Білесің бе, арт жақтан тосын шабуыл – жасырын.
Dialogue: 0,0:02:53.29,0:02:55.25,Default,,0,0,0,,Не істесең де, тек жеңу керек.
Dialogue: 0,0:02:55.42,0:02:57.46,Default,,0,0,0,,Міне солай.
Dialogue: 0,0:03:00.68,0:03:02.18,Default,,0,0,0,,Өте көңілсіз!
Dialogue: 0,0:03:02.30,0:03:04.68,Default,,0,0,0,,Бұл ойын аздап қиын болды.
Dialogue: 0,0:03:04.80,0:03:05.68,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:05.81,0:03:08.27,Default,,0,0,0,,Сондықтан мен де қиын дедім.
Dialogue: 0,0:03:08.77,0:03:10.35,Default,,0,0,0,,Нобита-кун әрқашан...
Dialogue: 0,0:03:10.48,0:03:12.73,Default,,0,0,0,,Өйткені мен Сунео-кунмен бәсекелесуге тырысамын.
Dialogue: 0,0:03:12.90,0:03:16.27,Default,,0,0,0,,Өйткені, өйткені! Мен онымен мақтанбаймын.
Dialogue: 0,0:03:17.15,0:03:19.11,Default,,0,0,0,,Ғарышқа саяхат?
Dialogue: 0,0:03:19.57,0:03:23.11,Default,,0,0,0,,Иә, оны менің туған күніме әкем сатып алды.
Dialogue: 0,0:03:23.87,0:03:25.33,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:03:25.87,0:03:29.50,Default,,0,0,0,,Енді мен бір-екі ғарыш сапарын жасауым керек...
Dialogue: 0,0:03:29.62,0:03:31.83,Default,,0,0,0,,Күлетін уақыт келеді.
Dialogue: 0,0:03:31.96,0:03:35.34,Default,,0,0,0,,Әлемнің көзқарасы бойынша Жер – жай бұршақ.
Dialogue: 0,0:03:35.79,0:03:40.30,Default,,0,0,0,,Бірақ ғарыштан көрінетін Жер өте әдемі болуы керек.
Dialogue: 0,0:03:40.67,0:03:44.59,Default,,0,0,0,,Қаласаңыз, әкеңізден барлығының сыбағасын сұрай аласыз. Сіз қалай ойлайсыз?
Dialogue: 0,0:03:44.72,0:03:45.51,Default,,0,0,0,,Е! Шынымен бе?
Dialogue: 0,0:03:45.64,0:03:47.47,Default,,0,0,0,,Ей, жүрек досы (Нобита) Яй!
Dialogue: 0,0:03:47.60,0:03:50.27,Default,,0,0,0,,Дегенмен, Нобитаға рұқсат етілмейді.
Dialogue: 0,0:03:50.48,0:03:52.19,Default,,0,0,0,,Е! неге?
Dialogue: 0,0:03:52.77,0:03:55.77,Default,,0,0,0,,Мен сізге айтамын, міну үшін біраз жаттығу керек.
Dialogue: 0,0:03:55.90,0:03:59.15,Default,,0,0,0,,Қозғалыс жүйкелері баяу, әлсіз Нобитаға бұл мүмкін емес.
Dialogue: 0,0:03:59.28,0:04:00.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.03,0:04:05.57,Default,,0,0,0,,Өйткені, сенде мен сияқты физикалық күш пен батылдық болуы керек.
Dialogue: 0,0:04:05.70,0:04:07.33,Default,,0,0,0,,Сонымен, сіз қашан кетесіз?
Dialogue: 0,0:04:07.83,0:04:09.49,Default,,0,0,0,,Ертең? Келесі күн?
Dialogue: 0,0:04:09.62,0:04:12.71,Default,,0,0,0,,Бұлай тез жүруге мүмкіндік жоқ.
Dialogue: 0,0:04:12.91,0:04:14.54,Default,,0,0,0,,21 ғасырдың басынан бастап
Dialogue: 0,0:04:14.71,0:04:17.50,Default,,0,0,0,,Хахахаха не?
Dialogue: 0,0:04:17.96,0:04:19.05,Default,,0,0,0,,Мен Дораемоннан сұрадым...
Dialogue: 0,0:04:19.17,0:04:21.80,Default,,0,0,0,,Мен сені дәл қазір ғарышқа апарайын.
Dialogue: 0,0:04:21.92,0:04:22.63,Default,,0,0,0,,...
Dialogue: 0,0:04:22.76,0:04:24.68,Default,,0,0,0,,О, менің қымбатты досым
Dialogue: 0,0:04:24.84,0:04:28.14,Default,,0,0,0,,Эй, мен де Пападан Ноби Чанның сыбағасын сұраймын. Эй.
Dialogue: 0,0:04:28.26,0:04:30.35,Default,,0,0,0,,Уухоу ухуфуфуфу
Dialogue: 0,0:04:30.85,0:04:33.43,Default,,0,0,0,,Сондықтан біз бұл ойынды шығардық
Dialogue: 0,0:04:33.94,0:04:37.90,Default,,0,0,0,,Ойын әп-сәтте бітсе қызықсыз.
Dialogue: 0,0:04:43.95,0:04:46.41,Default,,0,0,0,,Джан, біз мақсатқа жақындадық.
Dialogue: 0,0:04:46.57,0:04:48.45,Default,,0,0,0,,О, мен жеңіле алмаймын!
Dialogue: 0,0:04:48.70,0:04:50.37,Default,,0,0,0,,Уау! (Сунео) Джан!
Dialogue: 0,0:04:50.49,0:04:51.62,Default,,0,0,0,,Уау
Dialogue: 0,0:04:51.87,0:04:55.00,Default,,0,0,0,,Міне... Мен не болып жатқанын басқара алмаймын ба?
Dialogue: 0,0:04:55.21,0:04:57.38,Default,,0,0,0,,Уааааааааааааай
Dialogue: 0,0:04:57.50,0:05:00.00,Default,,0,0,0,,Вааах!
Dialogue: 0,0:05:06.30,0:05:09.47,Default,,0,0,0,,Сунео Сунео!
Dialogue: 0,0:05:10.43,0:05:11.93,Default,,0,0,0,,Жааан!
Dialogue: 0,0:05:12.06,0:05:14.18,Default,,0,0,0,,Сунео, жақсысың ба?
Dialogue: 0,0:05:15.10,0:05:16.39,Default,,0,0,0,,Итааа
Dialogue: 0,0:05:16.89,0:05:18.65,Default,,0,0,0,,Мен шығамын.
Dialogue: 0,0:05:18.77,0:05:21.73,Default,,0,0,0,,Соққы тисе, шыға алмайсың ба?
Dialogue: 0,0:05:21.86,0:05:26.53,Default,,0,0,0,,Мүмкін... біз ойынның құрсауында қалған шығармыз.
Dialogue: 0,0:05:26.65,0:05:28.36,Default,,0,0,0,,Солай... (Сунео) А...
Dialogue: 0,0:05:28.95,0:05:33.83,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:05:34.50,0:05:40.50,Default,,0,0,0,,♪〜
Dialogue: 0,0:06:40.81,0:06:46.82,Default,,0,0,0,,〜♪
Dialogue: 0,0:06:58.45,0:07:03.13,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:05.63,0:07:07.67,Default,,0,0,0,,Керемет, бұл тірі ағаш.
Dialogue: 0,0:07:08.01,0:07:11.55,Default,,0,0,0,,Rumble Rumble
Dialogue: 0,0:07:17.72,0:07:20.60,Default,,0,0,0,,Табиғи топырақ қаншама
Dialogue: 0,0:07:21.14,0:07:24.69,Default,,0,0,0,,Ақырында біз өмір сүретін планетаны таптық.
Dialogue: 0,0:07:29.19,0:07:31.53,Default,,0,0,0,,Келіңіздер, осы ғаламшардағы тіршілік иелеріне қараңыздар.
Dialogue: 0,0:07:31.65,0:07:33.24,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:37.33,0:07:40.20,Default,,0,0,0,,Одашики ғарыш кемесі!
Dialogue: 0,0:07:41.00,0:07:42.08,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:07:42.21,0:07:45.54,Default,,0,0,0,,Бөлмеңізде өзіңізді ғарыш кемесінің ішінде жүргендей сезінесіз.
Dialogue: 0,0:07:45.71,0:07:47.55,Default,,0,0,0,,Әй, бұл қызық көрінеді.
Dialogue: 0,0:07:48.13,0:07:51.47,Default,,0,0,0,,Оны ай мен жердің арасына қоямыз.Жарайды.
Dialogue: 0,0:07:52.30,0:07:53.18,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:07:54.84,0:07:56.26,Default,,0,0,0,,Хм, не болады?
Dialogue: 0,0:07:56.39,0:07:58.10,Default,,0,0,0,,О, о? (Нобита) А-а-а-а-а-а
Dialogue: 0,0:07:58.22,0:07:58.85,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:07:59.22,0:08:01.06,Default,,0,0,0,,Бұл салмақсыз. Апыр-ай! Ааа!
Dialogue: 0,0:08:01.18,0:08:02.39,Default,,0,0,0,,Уау, иә
Dialogue: 0,0:08:03.31,0:08:05.27,Default,,0,0,0,,Мен оны басқара алмаймын
Dialogue: 0,0:08:05.44,0:08:06.40,Default,,0,0,0,,Оған тез үйреніп кетесің
Dialogue: 0,0:08:06.52,0:08:08.15,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:08:08.77,0:08:10.07,Default,,0,0,0,,Иә, күте тұрыңыз.
Dialogue: 0,0:08:10.23,0:08:11.69,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:08:12.20,0:08:15.66,Default,,0,0,0,,Мен үйреніп қалдым. Бұл қызық.
Dialogue: 0,0:08:15.78,0:08:17.78,Default,,0,0,0,,Аа, қайсысы жақсы екенін білмеймін.
Dialogue: 0,0:08:17.91,0:08:18.91,Default,,0,0,0,,Рас
Dialogue: 0,0:08:19.08,0:08:22.58,Default,,0,0,0,,Ауырлық күші жоқ, сондықтан үстіңгі де, астыңғы да жоқ.
Dialogue: 0,0:08:22.71,0:08:24.58,Default,,0,0,0,,Эй, сен сыртқа шыққың келе ме?
Dialogue: 0,0:08:24.87,0:08:27.04,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ! Әй, Тотто
Dialogue: 0,0:08:27.84,0:08:31.13,Default,,0,0,0,,Дәл қазір бұл бөлменің іші ғарыш кемесімен бірдей.
Dialogue: 0,0:08:31.26,0:08:34.97,Default,,0,0,0,,Терезені ашсаңыз, ауамен бірге бәрі де сорылады.
Dialogue: 0,0:08:35.22,0:08:37.51,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:08:37.64,0:08:40.39,Default,,0,0,0,,Эй, бұл әдемі нәрсе ме?
Dialogue: 0,0:08:40.52,0:08:43.02,Default,,0,0,0,,Әй, бұл сенің жартылай ішкен шырын емес пе?
Dialogue: 0,0:08:43.68,0:08:45.73,Default,,0,0,0,,Сабын көпіршігі сияқты
Dialogue: 0,0:08:49.44,0:08:53.11,Default,,0,0,0,,Нобита-сан, тоқта, ол сенің киіміңе кіріп кетеді.
Dialogue: 0,0:08:53.82,0:08:54.99,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:56.49,0:08:58.37,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:08:58.49,0:08:59.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:59.45,0:09:02.33,Default,,0,0,0,,Мұндағы фарт зымыранмен бірдей күшке ие.
Dialogue: 0,0:09:02.66,0:09:04.12,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:09:04.33,0:09:07.50,Default,,0,0,0,,Ноби-чан, сәл тынышырақ ойнаңызшы.
Dialogue: 0,0:09:11.71,0:09:13.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:13.63,0:09:15.13,Default,,0,0,0,,Уау (Нобита) Уау
Dialogue: 0,0:09:15.42,0:09:16.43,Default,,0,0,0,,Нобита-кун аахх
Dialogue: 0,0:09:16.55,0:09:17.22,Default,,0,0,0,,Уау
Dialogue: 0,0:09:18.01,0:09:20.14,Default,,0,0,0,,Ноби-чан қарбызы
Dialogue: 0,0:09:20.26,0:09:22.22,Default,,0,0,0,,А, аа!
Dialogue: 0,0:09:22.35,0:09:23.47,Default,,0,0,0,,Бұл ананың дауысы!
Dialogue: 0,0:09:23.77,0:09:26.35,Default,,0,0,0,,Бүкіл үй ғарыш кемесінің ішінде.
Dialogue: 0,0:09:26.64,0:09:29.73,Default,,0,0,0,,Әй, әйтеуір... әйтеуір!
Dialogue: 0,0:09:29.86,0:09:30.82,Default,,0,0,0,,Анашым!
Dialogue: 0,0:09:31.23,0:09:32.57,Default,,0,0,0,,Уау
Dialogue: 0,0:09:32.98,0:09:34.36,Default,,0,0,0,,Вау!
Dialogue: 0,0:09:34.74,0:09:37.45,Default,,0,0,0,,Уууу
Dialogue: 0,0:09:37.91,0:09:40.74,Default,,0,0,0,,Ахх (Нобита) Уау!
Dialogue: 0,0:09:44.29,0:09:46.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:47.33,0:09:49.54,Default,,0,0,0,,Біз оны тоқтату үшін бірдеңе істеуіміз керек.
Dialogue: 0,0:09:51.46,0:09:52.42,Default,,0,0,0,,Уууу
Dialogue: 0,0:09:53.67,0:09:54.67,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:09:58.55,0:09:59.43,Default,,0,0,0,,Уау
Dialogue: 0,0:10:12.48,0:10:14.90,Default,,0,0,0,,Нобита!
Dialogue: 0,0:10:16.74,0:10:19.91,Default,,0,0,0,,Барлық оғаш еркеліктерді жасап, оларды дереу тазалаңыз.
Dialogue: 0,0:10:20.28,0:10:21.32,Default,,0,0,0,,Иә
Dialogue: 0,0:10:22.03,0:10:24.37,Default,,0,0,0,,Осымен айналысып жатқанда, қажет емес нәрселерді сұрыптаңыз.
Dialogue: 0,0:10:24.49,0:10:25.37,Default,,0,0,0,,Иә
Dialogue: 0,0:10:29.37,0:10:33.79,Default,,0,0,0,,О, манга, бос пластикалық үлгі қораптары, т.б.
Dialogue: 0,0:11:10.25,0:11:11.33,Default,,0,0,0,,Хааа
Dialogue: 0,0:11:11.50,0:11:12.38,Default,,0,0,0,,Міне
Dialogue: 0,0:11:12.54,0:11:13.79,Default,,0,0,0,,Мен мұны ақырында орындадым.
Dialogue: 0,0:11:14.00,0:11:15.88,Default,,0,0,0,,Бұл үлкен тазалау болды.
Dialogue: 0,0:11:16.25,0:11:18.51,Default,,0,0,0,,А... Әй, Такеши мырза мен басқалары ше?
Dialogue: 0,0:11:18.88,0:11:21.43,Default,,0,0,0,,Жоқ, біз әлі ойындамыз.
Dialogue: 0,0:11:21.80,0:11:25.26,Default,,0,0,0,,Иә? Nono... Нобита-кунның Star Crash ойыны қайда?
Dialogue: 0,0:11:25.39,0:11:27.14,Default,,0,0,0,,Е, мен оны бір жерге қойдым.
Dialogue: 0,0:11:27.26,0:11:28.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:28.93,0:11:30.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:36.82,0:11:37.94,Default,,0,0,0,,Анашым!
Dialogue: 0,0:11:39.40,0:11:43.53,Default,,0,0,0,,Анашым, сіз мына ғаламның суреті бар қорапты білмейсіз бе?
Dialogue: 0,0:11:44.12,0:11:48.04,Default,,0,0,0,,Ах, пластикалық үлгілердің қорабы. Сосын қоқыспен бірге лақтырып жібердім.
Dialogue: 0,0:11:48.33,0:11:49.41,Default,,0,0,0,,Эх!
Dialogue: 0,0:11:49.54,0:11:50.29,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:11:50.54,0:11:53.00,Default,,0,0,0,,Сонымен қатар, сіз өз бөлмеңізді жинап үлгердіңіз бе?
Dialogue: 0,0:11:53.46,0:11:55.75,Default,,0,0,0,,Джан Сунео
Dialogue: 0,0:11:59.30,0:12:00.13,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:12:00.26,0:12:01.88,Default,,0,0,0,,Толығырақ іздейік
Dialogue: 0,0:12:06.35,0:12:10.85,Default,,0,0,0,,Оның болмауы мүмкін емес. Мен оны міндетті түрде шығардым.
Dialogue: 0,0:12:11.18,0:12:12.39,Default,,0,0,0,,Қайтадан іздеп көрейік Иә.
Dialogue: 0,0:12:12.52,0:12:15.94,Default,,0,0,0,,Екеуің де! Сіз әлі бөлмеңізді жинаған жоқсыз.
Dialogue: 0,0:12:20.11,0:12:21.36,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:12:21.69,0:12:24.11,Default,,0,0,0,,Таке-сан мен Сунео-санға не болады?
Dialogue: 0,0:12:25.11,0:12:28.45,Default,,0,0,0,,Ол ойын аяқталғаннан кейін пайда болуы керек.
Dialogue: 0,0:12:33.21,0:12:36.33,Default,,0,0,0,,Күткендей, екеуі де үйге келмеді.
Dialogue: 0,0:12:36.79,0:12:38.67,Default,,0,0,0,,Хмм... біртүрлі.
Dialogue: 0,0:12:38.84,0:12:40.80,Default,,0,0,0,,Сіз мақсатқа жеттіңіз бе?
Dialogue: 0,0:12:40.92,0:12:45.26,Default,,0,0,0,,Ойын аяқталуы керек, бірақ хмм.
Dialogue: 0,0:12:46.26,0:12:50.60,Default,,0,0,0,,Ол механикалық ақауға байланысты ойында тұрып қалған болуы мүмкін.
Dialogue: 0,0:12:50.89,0:12:54.02,Default,,0,0,0,,Бірақ бұл ойын қоқыстан жоғалып кетті.
Dialogue: 0,0:12:54.44,0:12:56.10,Default,,0,0,0,,Бұл біздің кінәміз
Dialogue: 0,0:12:56.23,0:12:59.48,Default,,0,0,0,,Иә... Ахх, тым кеш болуы мүмкін.
Dialogue: 0,0:13:00.23,0:13:03.53,Default,,0,0,0,,А, дұрыс, кеш камера!
Dialogue: 0,0:13:04.07,0:13:06.86,Default,,0,0,0,,Осындай уақытта суретке түсіру арқылы не істеу керек?
Dialogue: 0,0:13:06.99,0:13:10.20,Default,,0,0,0,,Бұл камера уақытты кері түсіреді.
Dialogue: 0,0:13:10.33,0:13:12.95,Default,,0,0,0,,Мысалы, оны 4 сағат бұрын орнатыңыз...
Dialogue: 0,0:13:16.79,0:13:19.59,Default,,0,0,0,,Аа, Нобита-кун ырылдаған кезде.
Dialogue: 0,0:13:20.17,0:13:23.51,Default,,0,0,0,,Содан терезе сынып, ойын ұшып кетті.
Dialogue: 0,0:13:24.05,0:13:26.09,Default,,0,0,0,,Анам оны тазалады...
Dialogue: 0,0:13:33.72,0:13:35.64,Default,,0,0,0,,Бұл анам! менде ойын бар
Dialogue: 0,0:13:36.52,0:13:37.90,Default,,0,0,0,,Қоқыс төгетін жерге барайық
Dialogue: 0,0:13:38.02,0:13:40.19,Default,,0,0,0,,Суретте ойынды алған адам болуы керек.
Dialogue: 0,0:13:42.65,0:13:43.98,Default,,0,0,0,,Әлі ойнайтын ойын бар
Dialogue: 0,0:13:45.82,0:13:46.90,Default,,0,0,0,,Тағы да бар
Dialogue: 0,0:13:49.16,0:13:50.20,Default,,0,0,0,,Тағы да бар.
Dialogue: 0,0:13:54.29,0:13:55.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.12,0:13:58.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:58.17,0:14:00.33,Default,,0,0,0,,Біртүрлі жарық ойынды алып жүреді
Dialogue: 0,0:14:01.09,0:14:03.38,Default,,0,0,0,,Ол осы бағытта ұшып бара жатты.
Dialogue: 0,0:14:04.09,0:14:05.38,Default,,0,0,0,,Мен баратын жерімде артымнан жүр
Dialogue: 0,0:14:05.55,0:14:06.55,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.76,0:14:12.51,Default,,0,0,0,,Мен бұл бұрышқа бұрылдым.
Dialogue: 0,0:14:16.43,0:14:18.02,Default,,0,0,0,,Мектеп бағыты.
Dialogue: 0,0:14:21.11,0:14:23.07,Default,,0,0,0,,Мектептің артына кеткен сияқты.
Dialogue: 0,0:14:23.23,0:14:24.48,Default,,0,0,0,,Артқы тауда емес пе?
Dialogue: 0,0:14:25.32,0:14:27.28,Default,,0,0,0,,Артқы тауға шықтым!
Dialogue: 0,0:14:27.40,0:14:28.70,Default,,0,0,0,,Тезірек (Нобита) Иә.
Dialogue: 0,0:14:28.99,0:14:30.57,Default,,0,0,0,,Иә Takecopter
Dialogue: 0,0:14:40.88,0:14:42.46,Default,,0,0,0,,Тау етегіне қарай
Dialogue: 0,0:14:50.97,0:14:51.84,Default,,0,0,0,,Жааан!
Dialogue: 0,0:14:52.09,0:14:53.72,Default,,0,0,0,,Жааан!
Dialogue: 0,0:14:54.01,0:14:55.22,Default,,0,0,0,,Сунео-сан!
Dialogue: 0,0:14:55.56,0:14:57.27,Default,,0,0,0,,Қайдасың!
Dialogue: 0,0:14:59.64,0:15:01.69,Default,,0,0,0,,Менің ойымша, бұл жерде жоғалып кетті.
Dialogue: 0,0:15:07.94,0:15:09.53,Default,,0,0,0,,Уау... Нобита-кун
Dialogue: 0,0:15:09.74,0:15:10.65,Default,,0,0,0,,Не болды? Ах
Dialogue: 0,0:15:10.91,0:15:11.78,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:15:12.28,0:15:13.53,Default,,0,0,0,,НЛО?
Dialogue: 0,0:15:15.20,0:15:16.83,Default,,0,0,0,,Джан мен Сунео...
Dialogue: 0,0:15:16.95,0:15:19.16,Default,,0,0,0,,Мені НЛО ұрлап кетті.
Dialogue: 0,0:15:19.29,0:15:22.12,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:15:22.46,0:15:25.25,Default,,0,0,0,,келтірілген зиян үшін кешірім сұраймын. Эй
Dialogue: 0,0:15:25.38,0:15:28.09,Default,,0,0,0,,Дораэмон, одан гөрі оның артынан қуайық.
Dialogue: 0,0:15:28.21,0:15:29.30,Default,,0,0,0,,А, Нобита-кун, күте тұр.
Dialogue: 0,0:15:29.42,0:15:30.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:30.47,0:15:32.55,Default,,0,0,0,,Takecopter көмегімен бұл мүмкін емес.
Dialogue: 0,0:15:32.97,0:15:36.47,Default,,0,0,0,,НЛО қай планетадан шыққанын білмейсіз.
Dialogue: 0,0:15:36.97,0:15:39.39,Default,,0,0,0,,Бұл жағдайда зымыранды тез жіберіңіз.
Dialogue: 0,0:15:39.52,0:15:42.98,Default,,0,0,0,,Оңай жасама, Ғалам кең.
Dialogue: 0,0:15:43.60,0:15:46.15,Default,,0,0,0,,Жер галактикасымен бірдей...
Dialogue: 0,0:15:46.27,0:15:50.36,Default,,0,0,0,,Бұл ғаламда 100 миллионнан шамамен 10 000 есе көп.
Dialogue: 0,0:15:50.82,0:15:54.95,Default,,0,0,0,,Мен оларды бір-бірлеп іздесем, өмірімнің соңына дейін болса да таба алмас едім.
Dialogue: 0,0:15:55.20,0:15:56.83,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:15:56.95,0:15:57.99,Default,,0,0,0,,А... (Нобита) А?
Dialogue: 0,0:15:58.62,0:15:59.66,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:16:04.12,0:16:05.13,Default,,0,0,0,,Бұл тас па?
Dialogue: 0,0:16:05.38,0:16:08.63,Default,,0,0,0,,Бұл әдемі емес, жұлдыздың бір бөлігіне ұқсайды
Dialogue: 0,0:16:09.38,0:16:10.76,Default,,0,0,0,,Көрейін
Dialogue: 0,0:16:11.38,0:16:13.72,Default,,0,0,0,,Иә? Бұл жер тас емес
Dialogue: 0,0:16:14.09,0:16:16.26,Default,,0,0,0,,Нобита-кун, бұл үлкен жаңалық.
Dialogue: 0,0:16:16.39,0:16:20.18,Default,,0,0,0,,Мұны UFO экипажының мүшесі жоғалтқан сияқты.
Dialogue: 0,0:16:20.72,0:16:22.39,Default,,0,0,0,,Егер сізде бұл болса, сіз бәрін жасай аласыз.
Dialogue: 0,0:16:22.52,0:16:24.14,Default,,0,0,0,,Шынымен бе? (Нобита) Біз не істейміз?
Dialogue: 0,0:16:24.90,0:16:27.44,Default,,0,0,0,,Ғарыштық құтқару кемесі!
Dialogue: 0,0:16:28.02,0:16:31.11,Default,,0,0,0,,Егер сіз бұл тасты анықтау блогына орнатсаңыз...
Dialogue: 0,0:16:31.24,0:16:34.41,Default,,0,0,0,,Ол сені осы тас болған ғаламның соңына дейін қуады.
Dialogue: 0,0:16:34.99,0:16:37.66,Default,,0,0,0,,Кеттік! Эй, қазір кетейік
Dialogue: 0,0:16:37.78,0:16:38.87,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:16:39.41,0:16:42.83,Default,,0,0,0,,Бірақ ғарыш өте қауіпті жер, солай ма?
Dialogue: 0,0:16:43.37,0:16:45.96,Default,,0,0,0,,Білемін, бірақ екеуіңді жалғыз қалдыра алмаймын.
Dialogue: 0,0:16:46.08,0:16:46.79,Default,,0,0,0,,Иә
Dialogue: 0,0:16:47.08,0:16:49.21,Default,,0,0,0,,Жарайды, бірден кетейік!
Dialogue: 0,0:16:50.67,0:16:52.09,Default,,0,0,0,,Иә
Dialogue: 0,0:16:55.84,0:16:57.09,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:16:57.43,0:16:58.22,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:58.35,0:16:59.60,Default,,0,0,0,,Кету!
Dialogue: 0,0:17:34.47,0:17:39.14,Default,,0,0,0,,Vivi Жақында бұрылыс шегіне жетеді Vivi жақында бұрылу шегіне жетеді
Dialogue: 0,0:18:00.74,0:18:03.37,Default,,0,0,0,,Бұрылыстың соңы Vivi
Dialogue: 0,0:18:04.04,0:18:06.08,Default,,0,0,0,,Хмм, бұл не?
Dialogue: 0,0:18:06.79,0:18:08.87,Default,,0,0,0,,Виви оғаш дауыл
Dialogue: 0,0:18:10.58,0:18:12.42,Default,,0,0,0,,Вааах!
Dialogue: 0,0:18:31.06,0:18:32.52,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:18:33.02,0:18:33.98,Default,,0,0,0,,Иә? (Сунео) Ой...
Dialogue: 0,0:18:34.11,0:18:35.98,Default,,0,0,0,,Та... Бұл мені құтқарды! (Сунео) Ия!
Dialogue: 0,0:18:36.11,0:18:37.99,Default,,0,0,0,,Мен сыртқа шыға алдым.
Dialogue: 0,0:18:38.20,0:18:40.16,Default,,0,0,0,,Ах (Сунео) Иә?
Dialogue: 0,0:18:41.45,0:18:43.99,Default,,0,0,0,,Эй, бұл Нобитаның бөлмесі емес.
Dialogue: 0,0:18:44.70,0:18:46.66,Default,,0,0,0,,Кейбір зауыт қоймасы?
Dialogue: 0,0:18:47.41,0:18:48.96,Default,,0,0,0,,Әй, ана жақтағы есік емес пе?
Dialogue: 0,0:18:51.71,0:18:53.04,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:18:53.17,0:18:55.34,Default,,0,0,0,,Сырттан құлыптаулы ма?
Dialogue: 0,0:18:55.46,0:18:57.76,Default,,0,0,0,,Жоқ, мен қозғалмаймын.
Dialogue: 0,0:18:58.22,0:19:00.80,Default,,0,0,0,,Бұл фантастикалық фильм сияқты
Dialogue: 0,0:19:00.93,0:19:01.89,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:19:02.39,0:19:03.64,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:19:08.31,0:19:10.56,Default,,0,0,0,,Ах, у... (Сунео) Ах!
Dialogue: 0,0:19:11.40,0:19:14.11,Default,,0,0,0,,Ой, біз әлі ойындамыз
Dialogue: 0,0:19:16.65,0:19:21.49,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:32.50,0:19:35.71,Default,,0,0,0,,Сіз әлі де аралық кеңістіктесіз.
Dialogue: 0,0:19:35.92,0:19:37.80,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:19:37.92,0:19:40.88,Default,,0,0,0,,Бұл шексіз алыс ғаламға келгендей.
Dialogue: 0,0:19:46.81,0:19:48.52,Default,,0,0,0,,Сіз бұрылыстан өткен сияқтысыз.
Dialogue: 0,0:19:48.81,0:19:51.56,Default,,0,0,0,,Тас жатқан жерге жақындадым.
Dialogue: 0,0:19:51.69,0:19:54.35,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:20:00.74,0:20:02.28,Default,,0,0,0,,Не… не болды? Дораемон
Dialogue: 0,0:20:02.40,0:20:06.37,Default,,0,0,0,,Иондық дауылда шыққан шығар.
Dialogue: 0,0:20:06.49,0:20:07.37,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:20:12.50,0:20:14.21,Default,,0,0,0,,Бұл мен фотода көрген НЛО.
Dialogue: 0,0:20:15.92,0:20:20.38,Default,,0,0,0,,Бұл Джан мен Сунеоның сонда екенін білдіреді.
Dialogue: 0,0:20:24.47,0:20:25.93,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:20:26.05,0:20:28.97,Default,,0,0,0,,Қозғалтқыш зақымдалған (Нобита) Уау!
Dialogue: 0,0:20:29.35,0:20:31.31,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:31.43,0:20:34.31,Default,,0,0,0,,Мен... Уақыт матамен жөндеймін.
Dialogue: 0,0:20:34.69,0:20:38.77,Default,,0,0,0,,Ғарыш дәмі... Крем өскіні... Бүріккіш түрі!
Dialogue: 0,0:20:40.44,0:20:43.74,Default,,0,0,0,,Егер сіз мұны қолдансаңыз, сіз ғарыш костюмін киесіз.
Dialogue: 0,0:20:46.37,0:20:51.12,Default,,0,0,0,,Ауа жойылғандықтан, есікті ашсаңыз да, оның сорылып кетуіне алаңдамайсыз.
Dialogue: 0,0:20:51.83,0:20:53.58,Default,,0,0,0,,Дора-чан, абай бол
Dialogue: 0,0:20:53.71,0:20:54.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:55.37,0:20:57.83,Default,,0,0,0,,Уау... бұл қорқынышты
Dialogue: 0,0:20:58.63,0:21:00.46,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:21:04.63,0:21:07.84,Default,,0,0,0,,Фурошики уақыты!
Dialogue: 0,0:21:08.47,0:21:09.81,Default,,0,0,0,,Уау
Dialogue: 0,0:21:09.93,0:21:12.10,Default,,0,0,0,,Фурошика уақыты!
Dialogue: 0,0:21:13.18,0:21:14.98,Default,,0,0,0,,Дорэмон, жақсысың ба?
Dialogue: 0,0:21:16.48,0:21:18.19,Default,,0,0,0,,Қайықты тастап, қашыңыз
Dialogue: 0,0:21:18.31,0:21:19.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:19.65,0:21:21.61,Default,,0,0,0,,НЛО-ға жіберу
Dialogue: 0,0:21:25.65,0:21:26.57,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:21:27.11,0:21:28.07,Default,,0,0,0,,Иә
Dialogue: 0,0:21:29.12,0:21:29.91,Default,,0,0,0,,Уау
Dialogue: 0,0:21:30.78,0:21:32.45,Default,,0,0,0,,Уау
Dialogue: 0,0:21:33.08,0:21:34.16,Default,,0,0,0,,Уау
Dialogue: 0,0:21:34.37,0:21:35.25,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:21:35.41,0:21:40.04,Default,,0,0,0,,Жарайды, қорқынышты ғарыш кемесімен ойнағанда не істесең соны істе.
Dialogue: 0,0:21:40.17,0:21:43.01,Default,,0,0,0,,Бұл нағыз ғалам.
Dialogue: 0,0:21:43.34,0:21:45.09,Default,,0,0,0,,Кішкене ғана, бар күшіңді сал!
Dialogue: 0,0:21:45.22,0:21:48.51,Default,,0,0,0,,Ой! (ысықтың дыбысы)
Dialogue: 0,0:21:49.26,0:21:50.43,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:21:50.72,0:21:51.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:52.39,0:21:55.18,Default,,0,0,0,,Мен мұндай жерлерде жиі ысылып қаламын.
Dialogue: 0,0:21:55.35,0:21:57.31,Default,,0,0,0,,Тезірек ішке кірейік.
Dialogue: 0,0:21:57.77,0:22:00.02,Default,,0,0,0,,Құрсаудан өтіңіз!
Dialogue: 0,0:22:02.07,0:22:04.15,Default,,0,0,0,,Бұл жер қоймаға ұқсайды.
Dialogue: 0,0:22:04.61,0:22:06.49,Default,,0,0,0,,Менің ойымша, ол жерде ешкім жоқ
Dialogue: 0,0:22:06.95,0:22:07.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:08.41,0:22:11.45,Default,,0,0,0,,Абайлаңыз, біз қандай жат планеталықтар екенін білмейміз.
Dialogue: 0,0:22:17.62,0:22:19.12,Default,,0,0,0,,Иә? Гайя!
Dialogue: 0,0:22:19.25,0:22:21.00,Default,,0,0,0,,Гаар! (Нобита) Ах!
Dialogue: 0,0:22:22.21,0:22:24.88,Default,,0,0,0,,Ух... бұл дауыс
Dialogue: 0,0:22:25.09,0:22:25.96,Default,,0,0,0,,Дораемон
Dialogue: 0,0:22:26.42,0:22:27.80,Default,,0,0,0,,Джан Сунео-сан
Dialogue: 0,0:22:27.92,0:22:30.76,Default,,0,0,0,,Жан құрбым, аман болғаныңа қуанамын.
Dialogue: 0,0:22:32.64,0:22:35.14,Default,,0,0,0,,Айтпақшы, бұл қай жер?
Dialogue: 0,0:22:35.27,0:22:37.73,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм.
Dialogue: 0,0:22:37.98,0:22:38.98,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:22:39.19,0:22:40.60,Default,,0,0,0,,Не! (Сунео) Ах!
Dialogue: 0,0:22:40.73,0:22:42.77,Default,,0,0,0,,НЛО ұрлап кетті ме?
Dialogue: 0,0:22:42.90,0:22:45.28,Default,,0,0,0,,Сонымен, бұл нағыз ғалам ба?
Dialogue: 0,0:22:50.11,0:22:52.62,Default,,0,0,0,,Қалай дұрыс емес бағытты таңдауға болады?
Dialogue: 0,0:22:52.74,0:22:53.53,Default,,0,0,0,,Пыр
Dialogue: 0,0:22:53.74,0:22:56.08,Default,,0,0,0,,Мен қателескен жоқпын Виви
Dialogue: 0,0:22:56.29,0:22:59.25,Default,,0,0,0,,Бүйірден шыққанда, мінеки!
Dialogue: 0,0:22:59.79,0:23:02.71,Default,,0,0,0,,Қалай болғанда да, мен осы жерден өтпейінше, бағытты білмеймін.
Dialogue: 0,0:23:03.67,0:23:05.13,Default,,0,0,0,,шуылдау
Dialogue: 0,0:23:05.80,0:23:08.22,Default,,0,0,0,,Көмекші тізбектің қуаты максималды тербеліс
Dialogue: 0,0:23:10.34,0:23:12.39,Default,,0,0,0,,Горо горо бастаңыз!
Dialogue: 0,0:23:22.81,0:23:24.44,Default,,0,0,0,,Виви күшке толы
Dialogue: 0,0:23:24.56,0:23:25.48,Default,,0,0,0,,Дерлік
Dialogue: 0,0:23:37.04,0:23:38.66,Default,,0,0,0,,Горогоро! Алақай!
Dialogue: 0,0:23:44.29,0:23:46.42,Default,,0,0,0,,Біз жаңа ғана иондық дауылдан өткен сияқтымыз.
Dialogue: 0,0:23:47.09,0:23:50.34,Default,,0,0,0,,Маған қызық, сіз бұл қоқыстарды қанша жерге апарасыз?
Dialogue: 0,0:23:50.88,0:23:54.80,Default,,0,0,0,,Қалай болғанда да, мен сіздің Жерге оралуыңыз үшін келіссөздер жүргізуге тырысамын.
Dialogue: 0,0:23:55.10,0:23:59.06,Default,,0,0,0,,Эй, бұл НЛО қандай бөтен планета?
Dialogue: 0,0:23:59.35,0:24:01.81,Default,,0,0,0,,Ол жылтыр және кішкентай болды.
Dialogue: 0,0:24:02.02,0:24:03.40,Default,,0,0,0,,Жарқырап тұр ма?
Dialogue: 0,0:24:03.52,0:24:05.19,Default,,0,0,0,,Сіз бөтен адамсыз ба?
Dialogue: 0,0:24:05.40,0:24:07.02,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:24:07.44,0:24:09.86,Default,,0,0,0,,Нағыз адам бет-әлпетіне ұқсас бөтен болуы мүмкін
Dialogue: 0,0:24:10.36,0:24:12.49,Default,,0,0,0,,Тоқта, Сунео-сан.
Dialogue: 0,0:24:12.61,0:24:14.53,Default,,0,0,0,,Дұрыс, бұл бөтен түлкі.
Dialogue: 0,0:24:14.66,0:24:15.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:15.66,0:24:18.91,Default,,0,0,0,,Қалай болғанда да, сөйлессең, бірдеңе болады.
Dialogue: 0,0:24:19.16,0:24:20.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:24:20.87,0:24:22.50,Default,,0,0,0,,Қиындық тудырғаным үшін кешір.
Dialogue: 0,0:24:22.96,0:24:24.08,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:24:30.17,0:24:33.47,Default,,0,0,0,,Менің ойымша, бұл шынымен де ғажайып бөтен планеталық емес.
Dialogue: 0,0:24:33.59,0:24:34.51,Default,,0,0,0,,Уф
Dialogue: 0,0:24:34.63,0:24:36.18,Default,,0,0,0,,Сіз не істеп жатырсыз? (Сунео) Не?
Dialogue: 0,0:24:36.60,0:24:38.18,Default,,0,0,0,,Сіз мені ұрмайсыз.
Dialogue: 0,0:24:38.31,0:24:40.10,Default,,0,0,0,,Бобобо... бұл мен емес~
Dialogue: 0,0:24:40.22,0:24:41.68,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:24:44.19,0:24:45.94,Default,,0,0,0,,Ой, балалар не істеп жатырсыңдар?
Dialogue: 0,0:24:46.23,0:24:50.32,Default,,0,0,0,,А... біз... бұл ұзақ әңгіме, бірақ...
Dialogue: 0,0:24:51.23,0:24:53.36,Default,,0,0,0,,Біз Ғарыш бала рыцарларымыз
Dialogue: 0,0:24:54.11,0:24:56.32,Default,,0,0,0,,Біздің кеменің мақсаты қандай?
Dialogue: 0,0:24:56.87,0:24:58.78,Default,,0,0,0,,«Не керек?» деген сөз жоқ.
Dialogue: 0,0:24:59.24,0:25:01.75,Default,,0,0,0,,Горо Горо
Dialogue: 0,0:25:01.91,0:25:03.54,Default,,0,0,0,,Иә? (Сунео) Сонымен... дұрыс.
Dialogue: 0,0:25:03.66,0:25:05.67,Default,,0,0,0,,Мүмкін сені рұқсатсыз әкелген шығар?
Dialogue: 0,0:25:05.79,0:25:09.17,Default,,0,0,0,,Бибі Бибі Бибіні бізге әкелгенім есімде жоқ.
Dialogue: 0,0:25:09.67,0:25:12.67,Default,,0,0,0,,Сіз кемеге рұқсатсыз мінгеніңіз үшін қамауға алынады.
Dialogue: 0,0:25:13.01,0:25:14.01,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:25:14.13,0:25:15.55,Default,,0,0,0,,Оны жабық ұстаңыз!
Dialogue: 0,0:25:15.68,0:25:17.14,Default,,0,0,0,,Горогоро
Dialogue: 0,0:25:17.26,0:25:21.18,Default,,0,0,0,,Мен саған олай істеуге рұқсат бермеймін...
Dialogue: 0,0:25:21.77,0:25:23.06,Default,,0,0,0,,Горо Горо
Dialogue: 0,0:25:23.18,0:25:25.23,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:25:25.35,0:25:26.98,Default,,0,0,0,,Джан
Dialogue: 0,0:25:27.35,0:25:29.98,Default,,0,0,0,,Қарсылық көрсетпеген дұрыс сияқты.
Dialogue: 0,0:25:35.11,0:25:38.11,Default,,0,0,0,,Әй, мені бұл жерден алып кет, мен сені бұрқыратамын.
Dialogue: 0,0:25:38.24,0:25:39.78,Default,,0,0,0,,Оны ашыңыз! Эй Эй
Dialogue: 0,0:25:40.49,0:25:43.91,Default,,0,0,0,,Олармен дұрыс сөйлессем, адамдар түсінетін сияқты.
Dialogue: 0,0:25:44.08,0:25:45.58,Default,,0,0,0,,Өтетін құрсаулар туралы не деуге болады?
Dialogue: 0,0:25:45.71,0:25:47.37,Default,,0,0,0,,Бұл алынды (Нобита) Ах...
Dialogue: 0,0:25:48.38,0:25:51.34,Default,,0,0,0,,Бұл варвар нәсіл қайдан шыққан?
Dialogue: 0,0:25:52.05,0:25:53.13,Default,,0,0,0,,Гогогогоро
Dialogue: 0,0:25:53.26,0:25:55.34,Default,,0,0,0,,Жарайды, тез үйге қайтайық.
Dialogue: 0,0:25:59.39,0:26:01.68,Default,,0,0,0,,Лиан қатты қорқады
Dialogue: 0,0:26:02.35,0:26:03.31,Default,,0,0,0,,Не болды журнал
Dialogue: 0,0:26:03.43,0:26:06.10,Default,,0,0,0,,Warp навигациялық жабдықтың ақаулары
Dialogue: 0,0:26:06.23,0:26:08.35,Default,,0,0,0,,Не! Гороро
Dialogue: 0,0:26:09.77,0:26:12.65,Default,,0,0,0,,Бұрынғы оғаш дауылдың әсері
Dialogue: 0,0:26:12.82,0:26:13.98,Default,,0,0,0,,Фрейя
Dialogue: 0,0:26:14.90,0:26:17.57,Default,,0,0,0,,Қонуға болатын жақын маңдағы жұлдыздарды өлшеңіз.
Dialogue: 0,0:26:18.28,0:26:20.28,Default,,0,0,0,,Цуруми сериясы S-56
Dialogue: 0,0:26:22.24,0:26:23.54,Default,,0,0,0,,Зерттелмеген жұлдыздар бар.
Dialogue: 0,0:26:23.95,0:26:25.75,Default,,0,0,0,,Жарайды, сонда түзетейік.
Dialogue: 0,0:26:25.87,0:26:27.50,Default,,0,0,0,,Горороро Горороро
Dialogue: 0,0:26:37.38,0:26:40.09,Default,,0,0,0,,Бұл... әдемі жұлдыз.
Dialogue: 0,0:26:41.30,0:26:43.43,Default,,0,0,0,,Жасыл желекке толы болса жақсы болар еді.
Dialogue: 0,0:26:48.89,0:26:51.23,Default,,0,0,0,,Жарайды, түсейік. Жарайсың Биби.
Dialogue: 0,0:26:51.35,0:26:52.77,Default,,0,0,0,,Фрея, атмосфераны тексеріңіз.
Dialogue: 0,0:26:53.44,0:26:54.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:26:57.94,0:27:01.70,Default,,0,0,0,,Патина газы 95% Бір тамшы су жоқ
Dialogue: 0,0:27:02.95,0:27:04.28,Default,,0,0,0,,Бір кесек мыс.
Dialogue: 0,0:27:21.38,0:27:23.64,Default,,0,0,0,,Мен бір планетаға келдім
Dialogue: 0,0:27:23.76,0:27:24.80,Default,,0,0,0,,Бұл қай жұлдыз?
Dialogue: 0,0:27:25.10,0:27:26.77,Default,,0,0,0,,Мен қайда екенін білмеймін
Dialogue: 0,0:27:27.10,0:27:30.31,Default,,0,0,0,,Әй, маған бәрібір, есікті аш.
Dialogue: 0,0:27:30.44,0:27:34.19,Default,,0,0,0,,Есікті кез келген жерде, кез келген жерде ашыңыз... а
Dialogue: 0,0:27:34.36,0:27:35.48,Default,,0,0,0,,Ах! (Нобита/Шидзука) Ах!
Dialogue: 0,0:27:35.61,0:27:36.61,Default,,0,0,0,,Хахахаха Ишишииши
Dialogue: 0,0:27:36.73,0:27:38.53,Default,,0,0,0,,Дораемон, сен әкелдің, солай ма?
Dialogue: 0,0:27:38.65,0:27:42.74,Default,,0,0,0,,Иә, иә, иә, әрине есік барлық жерде!
Dialogue: 0,0:27:42.86,0:27:44.62,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:27:45.37,0:27:48.66,Default,,0,0,0,,Мен өзіме не болғанын мүлде ұмыттым.
Dialogue: 0,0:27:48.79,0:27:50.58,Default,,0,0,0,,Біз қайда ораламыз?
Dialogue: 0,0:27:51.04,0:27:53.21,Default,,0,0,0,,Жер кеніші
Dialogue: 0,0:27:53.33,0:27:54.54,Default,,0,0,0,,Боку-нчи (Нобита)-н...
Dialogue: 0,0:27:55.04,0:27:57.05,Default,,0,0,0,,Ендеше, оны бос орынға айналдырайық.
Dialogue: 0,0:27:57.17,0:27:58.17,Default,,0,0,0,,Келісіңіз
Dialogue: 0,0:27:58.30,0:28:00.05,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:28:00.59,0:28:02.80,Default,,0,0,0,,Мен нағыз ғаламға келсем де...
Dialogue: 0,0:28:02.93,0:28:04.47,Default,,0,0,0,,Сіз шытырман оқиғасыз үйге барасыз ба?
Dialogue: 0,0:28:05.01,0:28:08.85,Default,,0,0,0,,Шытырман оқиға жеткілікті, эй Джан.
Dialogue: 0,0:28:08.97,0:28:11.10,Default,,0,0,0,,Жоқ, Нобита дұрыс айтады.
Dialogue: 0,0:28:11.23,0:28:12.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:12.52,0:28:14.31,Default,,0,0,0,,Бұл жерде аяқталуға әлі ерте
Dialogue: 0,0:28:14.69,0:28:18.23,Default,,0,0,0,,Дораемон, мына ғаламшарға қарап үйге қайтайық.
Dialogue: 0,0:28:18.36,0:28:21.28,Default,,0,0,0,,Бірақ мен барлығына бұдан былай қауіп төндірмеймін...
Dialogue: 0,0:28:21.69,0:28:25.28,Default,,0,0,0,,Бірдеңе болып қалса, үйге есік алдында баруға болады.
Dialogue: 0,0:28:25.41,0:28:26.20,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:28:26.70,0:28:29.66,Default,,0,0,0,,Кішкене болса да жақсы шығар.
Dialogue: 0,0:28:35.54,0:28:37.71,Default,,0,0,0,,Журнал Жөндеу жұмыстары қалай жүріп жатыр?
Dialogue: 0,0:28:37.84,0:28:41.84,Default,,0,0,0,,Хм... жоқ, Виви мүлде сынған.
Dialogue: 0,0:28:41.97,0:28:46.14,Default,,0,0,0,,Егер сіз бұрмалау навигациясы құрылғысын пайдалана алмасаңыз, қайта оралу үшін біраз уақыт қажет.
Dialogue: 0,0:28:46.72,0:28:48.64,Default,,0,0,0,,ызылдау
Dialogue: 0,0:28:48.97,0:28:51.43,Default,,0,0,0,,Оны түзетуге біраз уақыт қажет сияқты.
Dialogue: 0,0:28:51.64,0:28:54.60,Default,,0,0,0,,Бұл тергеу қиыншылыққа толы.
Dialogue: 0,0:28:56.10,0:29:00.19,Default,,0,0,0,,Ұшып кеткеннен кейін көп ұзамай менің байланыс құрылғым істен шығып, ешқандай деректерді жібере алмадым.
Dialogue: 0,0:29:00.73,0:29:03.07,Default,,0,0,0,,Біртүрлі зиянкестер араласады
Dialogue: 0,0:29:04.11,0:29:05.36,Default,,0,0,0,,Кеме бұзылды
Dialogue: 0,0:29:06.61,0:29:09.49,Default,,0,0,0,,Мүмкін бұл «Құдай ағашының жемісін» түсіргенім үшін бе?
Dialogue: 0,0:29:09.62,0:29:13.16,Default,,0,0,0,,Не! Сіз «Құдай ағашының жемісін» түсірдіңіз бе?
Dialogue: 0,0:29:13.29,0:29:15.37,Default,,0,0,0,,Мұндай маңызды нәрсе қайда?
Dialogue: 0,0:29:15.50,0:29:18.54,Default,,0,0,0,,Мен... Менің ойымша, бұл MS-3 (Үш) сол планета шығар.
Dialogue: 0,0:29:18.71,0:29:19.84,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:29:20.13,0:29:22.46,Default,,0,0,0,,Бірақ бұл жұлдыз керемет.
Dialogue: 0,0:29:22.59,0:29:23.67,Default,,0,0,0,,Алдамаңыз
Dialogue: 0,0:29:24.05,0:29:28.68,Default,,0,0,0,,Өсімдік те, топырақ та ғажап. Эй, кел, тексеріп көр.
Dialogue: 0,0:29:30.81,0:29:32.89,Default,,0,0,0,,Бұл табиғаттың сұлулығы
Dialogue: 0,0:29:33.43,0:29:37.19,Default,,0,0,0,,Неге екені белгісіз, мұны көргенде мен өзімді жайбарақат сезінемін.
Dialogue: 0,0:29:38.15,0:29:41.86,Default,,0,0,0,,Өсімдіктерге келгенде Лианның көздерінің түсі өзгереді.
Dialogue: 0,0:29:42.73,0:29:43.94,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:29:45.28,0:29:47.28,Default,,0,0,0,,Бұл өсімдік жапырақ жасушасы.
Dialogue: 0,0:29:47.82,0:29:49.45,Default,,0,0,0,,Керемет!
Dialogue: 0,0:29:49.82,0:29:52.45,Default,,0,0,0,,Аа, ол қозғалды. Ол тірі.
Dialogue: 0,0:29:52.58,0:29:56.00,Default,,0,0,0,,Иә, ол біздің жасанды ағаштан мүлдем басқаша.
Dialogue: 0,0:29:57.00,0:30:00.46,Default,,0,0,0,,Табиғи топырағы, шөптері, ағаштары бар планетада өмір сүргім келеді.
Dialogue: 0,0:30:00.59,0:30:02.71,Default,,0,0,0,,Анам үнемі солай айтатын емес пе?
Dialogue: 0,0:30:02.84,0:30:06.51,Default,,0,0,0,,Жарайды, мен бұл туралы бірдеңе жасайтыныма сенімдімін.
Dialogue: 0,0:30:07.18,0:30:08.76,Default,,0,0,0,,Фрейяға рахмет
Dialogue: 0,0:30:09.76,0:30:12.01,Default,,0,0,0,,Ғарыш жегіш!
Dialogue: 0,0:30:12.56,0:30:15.10,Default,,0,0,0,,Гиперкеңістікті жеп, саңылау ашыңыз—
Dialogue: 0,0:30:15.68,0:30:17.98,Default,,0,0,0,,Бұл шынжыр табанды робот.
Dialogue: 0,0:30:18.10,0:30:21.65,Default,,0,0,0,,Қалай болғанда да, мен сізге ғарыш кремін себемін.
Dialogue: 0,0:30:24.90,0:30:27.15,Default,,0,0,0,,Еңбегіңізге рахмет, Жегіш-күн.
Dialogue: 0,0:30:27.28,0:30:29.86,Default,,0,0,0,,Кәне, бәрің, дайынсыңдар ма?
Dialogue: 0,0:30:29.99,0:30:31.07,Default,,0,0,0,,Оу!
Dialogue: 0,0:30:31.28,0:30:33.91,Default,,0,0,0,,Ғарышқа барайық!
Dialogue: 0,0:30:34.04,0:30:38.50,Default,,0,0,0,,♪ Мен осындай бірдеңе істей алсам ғой.
Dialogue: 0,0:30:38.62,0:30:42.54,Default,,0,0,0,,♪ Мұндай армандар өте көп...
Dialogue: 0,0:30:46.71,0:30:48.68,Default,,0,0,0,,Бұл шығу (Нобита) Уау!
Dialogue: 0,0:30:49.01,0:30:50.97,Default,,0,0,0,,Ақыры сыртқа шыға алдым.
Dialogue: 0,0:30:51.09,0:30:52.55,Default,,0,0,0,,Сол жерде НЛО
Dialogue: 0,0:30:53.05,0:30:55.85,Default,,0,0,0,,Аз уақыт үшін рахмет!
Dialogue: 0,0:30:55.97,0:30:58.94,Default,,0,0,0,,Біз бұл планетаны зерттейміз.
Dialogue: 0,0:30:59.06,0:31:05.82,Default,,0,0,0,,♪ Аспан тіпті қалтаңда да кеңейеді~
Dialogue: 0,0:31:07.28,0:31:08.90,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:31:09.32,0:31:11.41,Default,,0,0,0,,Құбыжық болса да шық.
Dialogue: 0,0:31:11.82,0:31:14.37,Default,,0,0,0,,Шынымен шықса не істейсің?
Dialogue: 0,0:31:14.49,0:31:17.41,Default,,0,0,0,,Жарайды... онда мен Дораэмонды сұраймын.
Dialogue: 0,0:31:17.54,0:31:20.12,Default,,0,0,0,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:31:20.25,0:31:22.21,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:31:23.71,0:31:25.59,Default,,0,0,0,,Қаш!
Dialogue: 0,0:31:26.84,0:31:28.80,Default,,0,0,0,,Әзірге НЛО-ға оралайық.
Dialogue: 0,0:31:31.68,0:31:33.80,Default,,0,0,0,,Тезірек, Нобита-кун!
Dialogue: 0,0:31:33.93,0:31:35.18,Default,,0,0,0,,Хаа…
Dialogue: 0,0:31:35.31,0:31:36.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:37.89,0:31:39.81,Default,,0,0,0,,Бұл гиперкеңістіктегі бұрылыс. Бұл қауіпті!
Dialogue: 0,0:31:39.93,0:31:41.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:45.73,0:31:47.57,Default,,0,0,0,,Бұл металл өрмекші.
Dialogue: 0,0:31:48.03,0:31:49.28,Default,,0,0,0,,Менің ойымша, ол қайтыс болды.
Dialogue: 0,0:31:51.70,0:31:52.86,Default,,0,0,0,,Тірі!
Dialogue: 0,0:31:53.03,0:31:54.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:55.16,0:31:57.87,Default,,0,0,0,,Дорэмон, қаруды алып кел.
Dialogue: 0,0:31:57.99,0:32:01.08,Default,,0,0,0,,Қолымдағы қарумен сені тыңдайтын мен емеспін.
Dialogue: 0,0:32:01.21,0:32:04.13,Default,,0,0,0,,Уау, уау
Dialogue: 0,0:32:04.67,0:32:07.42,Default,,0,0,0,,Додо... Дораэмон Додо... Кез келген есік!
Dialogue: 0,0:32:07.55,0:32:10.09,Default,,0,0,0,,Ол қайда? (Нобита) Тез, асығыңыз.
Dialogue: 0,0:32:13.13,0:32:15.89,Default,,0,0,0,,шықты! Барлық жерде есіктер!
Dialogue: 0,0:32:16.01,0:32:18.01,Default,,0,0,0,,Тез, тез Нобита-кунның бөлмесіне бар.
Dialogue: 0,0:32:18.22,0:32:19.39,Default,,0,0,0,,Уау
Dialogue: 0,0:32:19.52,0:32:20.85,Default,,0,0,0,,Менің бөлмем емес
Dialogue: 0,0:32:20.98,0:32:22.02,Default,,0,0,0,,Осы ойынды қазір тоқтатайық
Dialogue: 0,0:32:22.44,0:32:24.40,Default,,0,0,0,,Бұл... бұл ақымақтық.
Dialogue: 0,0:32:27.07,0:32:28.36,Default,,0,0,0,,Уау
Dialogue: 0,0:32:28.78,0:32:29.65,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:32:29.78,0:32:31.32,Default,,0,0,0,,Уау
Dialogue: 0,0:32:32.86,0:32:34.74,Default,,0,0,0,,Уау! Иә Takecopter
Dialogue: 0,0:32:36.07,0:32:37.83,Default,,0,0,0,,Қаш! (Нобита) Уау!
Dialogue: 0,0:32:46.96,0:32:48.42,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:32:48.54,0:32:50.25,Default,,0,0,0,,Бұл қорқынышты өрмекші.
Dialogue: 0,0:32:50.59,0:32:55.22,Default,,0,0,0,,Металл жіптерін бөліп, металды балқытатын улы сұйықтық бар.
Dialogue: 0,0:32:55.84,0:32:58.68,Default,,0,0,0,,Неліктен есікті барлық жерде пайдалана алмадыңыз?
Dialogue: 0,0:32:59.18,0:33:02.93,Default,,0,0,0,,Бәлкім, есік өте алмайтындай алысқа келген шығарсың.
Dialogue: 0,0:33:03.14,0:33:05.73,Default,,0,0,0,,Ех! Сонда мен үйге қалай жетемін?
Dialogue: 0,0:33:05.85,0:33:09.65,Default,,0,0,0,,Өйткені, бізде сол НЛО Жерге барудан басқа амал жоқ.
Dialogue: 0,0:33:10.32,0:33:13.61,Default,,0,0,0,,Жоқ! Металл өрмекшілер НЛО-ға шабуыл жасайды
Dialogue: 0,0:33:14.11,0:33:15.82,Default,,0,0,0,,Тез қайтайық (4 адам) Иә.
Dialogue: 0,0:33:18.95,0:33:20.12,Default,,0,0,0,,Уау, уау, мен оны білдім
Dialogue: 0,0:33:25.87,0:33:27.96,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:33:28.08,0:33:29.54,Default,,0,0,0,,Не істеуім керек, Виви?
Dialogue: 0,0:33:29.88,0:33:32.17,Default,,0,0,0,,Бұл қиын. Бұлай жалғаса берсе, НЛО еріп кетеді.
Dialogue: 0,0:33:32.30,0:33:33.76,Default,,0,0,0,,Бір нәрсені тез істе!
Dialogue: 0,0:33:33.88,0:33:38.01,Default,,0,0,0,,Дұрыс, бізде жақсы нәрсе бар, Хамелунчармера!
Dialogue: 0,0:33:38.22,0:33:39.55,Default,,0,0,0,,Сіз бұл флейтада ойнаған кезде—
Dialogue: 0,0:33:39.68,0:33:43.27,Default,,0,0,0,,Барлығы сыбызғыға арбалып, соңынан ерді...
Dialogue: 0,0:33:43.39,0:33:44.93,Default,,0,0,0,,Олар қайтып келмейді дейді...
Dialogue: 0,0:33:45.31,0:33:48.15,Default,,0,0,0,,Мен кейінірек түсіндіремін, тезірек.
Dialogue: 0,0:33:48.27,0:33:49.56,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:33:49.81,0:33:55.82,Default,,0,0,0,,（）
Dialogue: 0,0:33:59.87,0:34:01.66,Default,,0,0,0,,Ештеңе өзгерген жоқ.
Dialogue: 0,0:34:01.99,0:34:04.00,Default,,0,0,0,,Дыбыстың кішкентай болғаны соншалық, сіз оны ести алмайсыз, солай ма?
Dialogue: 0,0:34:04.70,0:34:06.25,Default,,0,0,0,,Маған Дораэмон Big Light беріңіз
Dialogue: 0,0:34:06.37,0:34:07.75,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:34:07.92,0:34:09.67,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,0:34:10.46,0:34:13.21,Default,,0,0,0,,Уау (3 адам) Уау
Dialogue: 0,0:34:13.34,0:34:15.26,Default,,0,0,0,,Мұны сөзсіз естисіз.
Dialogue: 0,0:34:15.38,0:34:16.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:16.84,0:34:18.38,Default,,0,0,0,,Бір нәрсе болса, жақындайық.
Dialogue: 0,0:34:18.51,0:34:19.47,Default,,0,0,0,,Жарайды
Dialogue: 0,0:34:24.06,0:34:25.89,Default,,0,0,0,,Лиан Аспанға қара!
Dialogue: 0,0:34:26.18,0:34:29.19,Default,,0,0,0,,Иә? Бұл балалар далаға қашан шықты?
Dialogue: 0,0:34:29.31,0:34:31.44,Default,,0,0,0,,Ал скафандрсыз Бибі
Dialogue: 0,0:34:32.27,0:34:33.86,Default,,0,0,0,,Мен сақтықты түсіре алмаймын.
Dialogue: 0,0:34:34.53,0:34:35.99,Default,,0,0,0,,Джанның үрлеуі
Dialogue: 0,0:34:36.19,0:34:37.70,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:34:38.32,0:34:40.03,Default,,0,0,0,,（）
Dialogue: 0,0:34:40.03,0:34:41.82,Default,,0,0,0,,（）
Dialogue: 0,0:34:40.03,0:34:41.82,Default,,0,0,0,,Уау
Dialogue: 0,0:34:41.82,0:34:43.74,Default,,0,0,0,,（）
Dialogue: 0,0:34:46.91,0:34:48.25,Default,,0,0,0,,Уау
Dialogue: 0,0:34:51.83,0:34:52.67,Default,,0,0,0,,Ах
Dialogue: 0,0:34:57.76,0:35:00.89,Default,,0,0,0,,Бәрің қараңдар, мен тау жаққа қашып барамын.
Dialogue: 0,0:35:01.01,0:35:04.01,Default,,0,0,0,,Құтылдым, қайтпаймын.
Dialogue: 0,0:35:04.14,0:35:07.02,Default,,0,0,0,,Уау, ғажайып дыбыс, Джиан күткендей
Dialogue: 0,0:35:07.64,0:35:09.10,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,0:35:15.23,0:35:16.98,Default,,0,0,0,,Виви құтқарылды
Dialogue: 0,0:35:17.36,0:35:19.24,Default,,0,0,0,,Олар сені қуып жіберді ме?
Dialogue: 0,0:35:19.40,0:35:21.03,Default,,0,0,0,,Горолаго
Dialogue: 0,0:35:23.24,0:35:25.45,Default,,0,0,0,,Материалды түрлендіргіш!
Dialogue: 0,0:35:26.04,0:35:28.66,Default,,0,0,0,,Енді өрмекші жібекті жүнге айналдырайық.
Dialogue: 0,0:35:29.08,0:35:30.00,Default,,0,0,0,,Иірілген жіп үшін?
Dialogue: 0,0:35:30.16,0:35:31.50,Default,,0,0,0,,Иә, қараңызшы.
Dialogue: 0,0:35:46.64,0:35:48.39,Default,,0,0,0,,Уау (Сунео) Бұл рас.
Dialogue: 0,0:35:48.72,0:35:51.98,Default,,0,0,0,,Мен жіпке айналдым. Хехе, өте жақсы сезім.
Dialogue: 0,0:35:52.10,0:35:53.35,Default,,0,0,0,,Бұл дыбыс өшіргіш емес пе?
Dialogue: 0,0:35:54.15,0:35:55.36,Default,,0,0,0,,Хаха!
Dialogue: 0,0:35:56.32,0:35:57.15,Default,,0,0,0,,Уау
Dialogue: 0,0:35:58.90,0:36:01.15,Default,,0,0,0,,Сенде қандай тылсым күш бар.
Dialogue: 0,0:36:01.45,0:36:04.28,Default,,0,0,0,,Бұл балалар жаман нәсіл емес, Виви.
Dialogue: 0,0:36:04.45,0:36:07.49,Default,,0,0,0,,Мен солай ойлаймын. Мен аздап уайымдап тұрмын.
Dialogue: 0,0:36:07.66,0:36:08.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:36:08.79,0:36:11.41,Default,,0,0,0,,Жоқ, дәл солай сезіледі.
Dialogue: 0,0:36:14.96,0:36:18.92,Default,,0,0,0,,Көмегің үшін рахмет. Барлығыңызға ризамын.
Dialogue: 0,0:36:19.38,0:36:22.30,Default,,0,0,0,,Біз сізді тағы да кемемізге шақырамыз.
Dialogue: 0,0:36:22.43,0:36:23.59,Default,,0,0,0,,Уау, бұл жақсы болды.
Dialogue: 0,0:36:23.72,0:36:25.39,Default,,0,0,0,,Бұл қандай да бір жолмен жүзеге асады.
Dialogue: 0,0:36:26.18,0:36:28.22,Default,,0,0,0,,Осының ішінде болды ма?
Dialogue: 0,0:36:29.27,0:36:32.23,Default,,0,0,0,,Өйткені мен осы қоқыстарды жинаймын...
Dialogue: 0,0:36:32.64,0:36:33.90,Default,,0,0,0,,Міне осылай болады
Dialogue: 0,0:36:34.02,0:36:36.77,Default,,0,0,0,,Тіпті қоқыс та тамаша зерттеу материалы болып табылады.
Dialogue: 0,0:36:37.11,0:36:39.48,Default,,0,0,0,,Қалаусыз заттар менікі
Dialogue: 0,0:36:39.61,0:36:40.28,Default,,0,0,0,,Уау
Dialogue: 0,0:36:40.40,0:36:43.57,Default,,0,0,0,,Одан гөрі мені тезірек Жерге қайтаруыңызды өтінемін.
Dialogue: 0,0:36:43.70,0:36:46.16,Default,,0,0,0,,Бізді рұқсатсыз әкелді.
Dialogue: 0,0:36:46.66,0:36:50.66,Default,,0,0,0,,Мен қиындыққа тап болдым. Шындығында, бұрмалау құрылғысы істен шықты.
Dialogue: 0,0:36:50.91,0:36:52.21,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:36:52.33,0:36:54.62,Default,,0,0,0,,Жерге иілусіз орала алмаймыз ба?
Dialogue: 0,0:36:55.08,0:36:56.96,Default,,0,0,0,,Үйге бара алмайтын сияқтымын...
Dialogue: 0,0:36:57.67,0:37:01.59,Default,,0,0,0,,Бибибибибибибибибибибибибибибибибибибибибибибибибиби, ол шамамен 108 миллион жылды алады
Dialogue: 0,0:37:01.84,0:37:03.51,Default,,0,0,0,,100 миллион жыл!
Dialogue: 0,0:37:03.63,0:37:05.18,Default,,0,0,0,,Дорэмон, бірдеңе істе
Dialogue: 0,0:37:05.30,0:37:07.89,Default,,0,0,0,,Уақыт матасы жоқ, құтқару қайығы жоқ
Dialogue: 0,0:37:08.30,0:37:10.10,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:37:10.22,0:37:11.35,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:37:12.27,0:37:13.81,Default,,0,0,0,,Үйге жетудің жолы бар.
Dialogue: 0,0:37:14.10,0:37:15.02,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:37:15.69,0:37:17.98,Default,,0,0,0,,Оларды Галактикалық дрифтер флотына апарыңыз.
Dialogue: 0,0:37:18.61,0:37:20.23,Default,,0,0,0,,Галактикалық дрейф флоты?
Dialogue: 0,0:37:20.36,0:37:21.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:37:21.82,0:37:23.82,Default,,0,0,0,,Бұл біз үйге баратын жер
Dialogue: 0,0:37:23.95,0:37:27.28,Default,,0,0,0,,Біз сен сияқты жұлдыздарда өмір сүрмейміз.
Dialogue: 0,0:37:27.95,0:37:30.33,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:37:30.45,0:37:32.04,Default,,0,0,0,,Маған журнал жадын көрсетіңіз.
Dialogue: 0,0:37:32.29,0:37:33.08,Default,,0,0,0,,Бибі
Dialogue: 0,0:37:36.17,0:37:40.21,Default,,0,0,0,,300 жыл бұрын ата-бабаларымыз жұлдыздарды тастап кеткен.
Dialogue: 0,0:37:40.59,0:37:43.17,Default,,0,0,0,,Жұлдыздардан бас тарттыңыз ба? Неге олай...
Dialogue: 0,0:37:43.46,0:37:45.26,Default,,0,0,0,,Өйткені мен енді ол жерде тұра алмаймын
Dialogue: 0,0:37:46.80,0:37:50.81,Default,,0,0,0,,Шамадан тыс дамыған материалдық өркениет қоршаған ортаның бұзылуына әкеледі.
Dialogue: 0,0:37:51.01,0:37:54.43,Default,,0,0,0,,Табиғи жүйені бұзу арқылы өсімдіктер қурап қалады.
Dialogue: 0,0:37:54.64,0:37:57.81,Default,,0,0,0,,Тыныс алу аппаратынсыз шығуға болмайтынын түсінгенде—
Dialogue: 0,0:37:58.19,0:38:00.56,Default,,0,0,0,,Өлім жұлдызына айналдым
Dialogue: 0,0:38:05.61,0:38:10.24,Default,,0,0,0,,(Еркектердің жөтелі)
Dialogue: 0,0:38:11.37,0:38:12.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:36.23,0:38:40.27,Default,,0,0,0,,300 жылдан бері жасыл желекке толы идеалды планетаны іздеуде
Dialogue: 0,0:38:40.81,0:38:45.03,Default,,0,0,0,,Біз шексіз кең ғаламды аралап шықтық.
Dialogue: 0,0:38:47.03,0:38:51.03,Default,,0,0,0,,Жолда жұлдыздары да жоғалған адамдар жиналды...
Dialogue: 0,0:38:51.24,0:38:53.45,Default,,0,0,0,,Ол галактикалық дрейф флотына айналды.
Dialogue: 0,0:38:54.58,0:38:57.58,Default,,0,0,0,,Біз, жаңа ұрпақ, ғарыш кемесінің ішінде туылғанбыз...
Dialogue: 0,0:38:57.71,0:39:02.04,Default,,0,0,0,,Біз болашақ үй планетамызды іздеу үшін тергеу тобын ұйымдастырдық.
Dialogue: 0,0:39:02.25,0:39:05.05,Default,,0,0,0,,Бұл ғарыштық бала рыцарьлары.
Dialogue: 0,0:39:05.42,0:39:07.01,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:39:07.21,0:39:10.26,Default,,0,0,0,,Төртеумізді Күн жүйесіне жібердік.
Dialogue: 0,0:39:10.59,0:39:15.18,Default,,0,0,0,,Содан кейін тамаша MS-3 Жер деп аталатын планетаны ашты.
Dialogue: 0,0:39:15.60,0:39:18.77,Default,,0,0,0,,«Мен оны таптым»... Жер – біздің планетамыз.
Dialogue: 0,0:39:18.89,0:39:20.14,Default,,0,0,0,,Балалар мен сендерге бермеймін.
Dialogue: 0,0:39:20.39,0:39:22.65,Default,,0,0,0,,Әрине, менің басып кіру ниетім жоқ.
Dialogue: 0,0:39:22.77,0:39:26.48,Default,,0,0,0,,Біздің мақсатымыз – келіссөздер арқылы бейбіт көші-қон.
Dialogue: 0,0:39:26.61,0:39:29.82,Default,,0,0,0,,Бұл да ерте заманнан бері келе жатқан ілім.
Dialogue: 0,0:39:29.95,0:39:33.41,Default,,0,0,0,,Мен флотқа қайтамын, кемені жөндеп, сені бірден жіберемін.
Dialogue: 0,0:39:33.53,0:39:34.91,Default,,0,0,0,,Жақсы рахмет
Dialogue: 0,0:39:35.03,0:39:35.79,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:39:35.99,0:39:37.70,Default,,0,0,0,,Мен Дораемонмын
Dialogue: 0,0:39:37.83,0:39:40.21,Default,,0,0,0,,Деректер робот журналы vivi
Dialogue: 0,0:39:40.58,0:39:41.75,Default,,0,0,0,,Нобита Ноби
Dialogue: 0,0:39:41.87,0:39:43.00,Default,,0,0,0,,I Лиан
Dialogue: 0,0:39:43.13,0:39:44.84,Default,,0,0,0,,Шизука Минамото
Dialogue: 0,0:39:45.00,0:39:47.76,Default,,0,0,0,,Сәлем, мен Фрейя.
Dialogue: 0,0:39:48.30,0:39:49.84,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:39:49.97,0:39:52.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:39:52.13,0:39:54.51,Default,,0,0,0,,Қой, қой!
Dialogue: 0,0:39:54.64,0:39:58.27,Default,,0,0,0,,Хахахаха, бұл шуылдаған достық сәлемдесу.
Dialogue: 0,0:39:58.39,0:39:59.89,Default,,0,0,0,,Горо Гого
Dialogue: 0,0:40:00.02,0:40:01.52,Default,,0,0,0,,Енді нақты орналасқан жеріне қара.
Dialogue: 0,0:40:01.89,0:40:04.40,Default,,0,0,0,,Ұшуға біраз уақыт кетеді.
Dialogue: 0,0:40:04.52,0:40:07.15,Default,,0,0,0,,Кешіріңіз, бірақ сіз осында демала аласыз ба?
Dialogue: 0,0:40:07.27,0:40:09.44,Default,,0,0,0,,Иә, мен мұны істеймін.
Dialogue: 0,0:40:09.61,0:40:11.78,Default,,0,0,0,,Мен қатты шаршадым.
Dialogue: 0,0:40:11.90,0:40:14.87,Default,,0,0,0,,Дұрыс, мен түнде жерді тастадым.
Dialogue: 0,0:40:15.83,0:40:19.70,Default,,0,0,0,,Фрея Бұл кемеде монша жоқ.
Dialogue: 0,0:40:19.91,0:40:21.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:40:21.16,0:40:22.37,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:40:26.50,0:40:28.25,Default,,0,0,0,,О, ыстық су жоқ.
Dialogue: 0,0:40:28.38,0:40:29.80,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:40:29.92,0:40:32.38,Default,,0,0,0,,Оны менен басқа ешкім көп қолданбайды.
Dialogue: 0,0:40:32.51,0:40:34.22,Default,,0,0,0,,Менде кішкене қулық бар.
Dialogue: 0,0:40:34.39,0:40:35.26,Default,,0,0,0,,Ei
Dialogue: 0,0:40:36.30,0:40:38.56,Default,,0,0,0,,Не?
Dialogue: 0,0:40:44.52,0:40:47.61,Default,,0,0,0,,О, тіпті іште дем алуға болады.
Dialogue: 0,0:40:52.86,0:40:54.78,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:40:55.07,0:40:56.53,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:40:58.20,0:41:01.91,Default,,0,0,0,,Мен Лианға күнде кір деп айтамын, бірақ ол тыңдамайды.
Dialogue: 0,0:41:02.41,0:41:05.08,Default,,0,0,0,,Сіз және Линна өте жақынсыз.
Dialogue: 0,0:41:05.21,0:41:07.63,Default,,0,0,0,,Ал... олай емес.
Dialogue: 0,0:41:07.96,0:41:09.17,Default,,0,0,0,,Жай ғана дос
Dialogue: 0,0:41:10.00,0:41:14.09,Default,,0,0,0,,Бірақ егер бұл Лианды бақытты етсе, онда мен...
Dialogue: 0,0:41:14.51,0:41:15.59,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:41:46.67,0:41:52.59,Default,,0,0,0,,Командир, MS-3 Жер деректері келді.
Dialogue: 0,0:41:53.17,0:41:57.93,Default,,0,0,0,,Егеуқұйрықтарды жасырып жіберу уақытты босқа өткізбеген сияқты.
Dialogue: 0,0:41:58.14,0:42:01.93,Default,,0,0,0,,Жер идеалды планета болып көрінеді.
Dialogue: 0,0:42:02.31,0:42:05.10,Default,,0,0,0,,Бұл ұзақ жол болды
Dialogue: 0,0:42:05.43,0:42:08.90,Default,,0,0,0,,Бірақ бұған дейін әлі де мәселе бар.
Dialogue: 0,0:42:10.69,0:42:14.99,Default,,0,0,0,,Мен білемін Айтпақшы, жұмыс қаншалықты алыс?
Dialogue: 0,0:42:16.99,0:42:18.91,Default,,0,0,0,,Бір дем алайық.
Dialogue: 0,0:42:19.95,0:42:23.74,Default,,0,0,0,,Біз сізге күткеніңізге сәйкес келетін нәтижелерді міндетті түрде көрсетеміз.
Dialogue: 0,0:42:25.50,0:42:28.71,Default,,0,0,0,,Мен оны асыға күтемін, Моа.
Dialogue: 0,0:42:37.17,0:42:38.68,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:42:39.68,0:42:42.30,Default,,0,0,0,,Менің адал қызметшілерім
Dialogue: 0,0:42:43.56,0:42:49.60,Default,,0,0,0,,Жұлдызымызды алу үшін оны тезірек аяқтауымыз керек.
Dialogue: 0,0:42:49.98,0:42:51.52,Default,,0,0,0,,Оу!
Dialogue: 0,0:43:02.74,0:43:06.62,Default,,0,0,0,,Мен жөндеуге көмектесемін дедім, бірақ әлі ұйықтап жатырмын.
Dialogue: 0,0:43:06.75,0:43:09.42,Default,,0,0,0,,Роботтың ұйықтап жатқаны біртүрлі.
Dialogue: 0,0:43:09.96,0:43:12.13,Default,,0,0,0,,Бұл чипті ауыстырып, ашуланыңыз.
Dialogue: 0,0:43:12.33,0:43:15.21,Default,,0,0,0,,Уақыт матасы болса ғой
Dialogue: 0,0:43:15.38,0:43:18.42,Default,,0,0,0,,Жер роботтарында біртүрлі құралдар бар.
Dialogue: 0,0:43:18.88,0:43:22.22,Default,,0,0,0,,Өйткені мен болашақ Жердің роботымын.
Dialogue: 0,0:43:22.51,0:43:25.10,Default,,0,0,0,,Басқаша айтқанда, қазір тоқтаңыз...
Dialogue: 0,0:43:25.22,0:43:27.18,Default,,0,0,0,,Енді не маңызды... Иә?
Dialogue: 0,0:43:27.31,0:43:29.18,Default,,0,0,0,,Уау
Dialogue: 0,0:43:29.31,0:43:32.65,Default,,0,0,0,,Виви Мен тамақты жақсы жей алмаймын Виви
Dialogue: 0,0:43:33.06,0:43:37.23,Default,,0,0,0,,Бибибибибибибибибибибибибибибибибибибибибибибибибибибибибибибибибибибиби
Dialogue: 0,0:43:38.32,0:43:42.24,Default,,0,0,0,,Мм, мм, мм... Иә, Дотазуна!
Dialogue: 0,0:43:42.45,0:43:45.74,Default,,0,0,0,,Иә Қалай Иә Қалай Иә Қалай Иә Қалай Uh
Dialogue: 0,0:43:45.95,0:43:47.29,Default,,0,0,0,,Не болса да.
Dialogue: 0,0:43:47.79,0:43:49.41,Default,,0,0,0,,«Мен Дораемонды жей аламын деп ойлаймын»?
Dialogue: 0,0:43:49.54,0:43:51.79,Default,,0,0,0,,А... асығыңыз! (Сунео) Иә.
Dialogue: 0,0:43:52.21,0:43:53.42,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:43:54.63,0:43:55.79,Default,,0,0,0,,Ах
Dialogue: 0,0:43:55.92,0:43:57.67,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:43:58.01,0:44:01.13,Default,,0,0,0,,Бұл өте тыныш. Әркім оны мініп көруі керек.
Dialogue: 0,0:44:01.43,0:44:03.55,Default,,0,0,0,,Не? Мені қорқытпа.
Dialogue: 0,0:44:03.68,0:44:05.18,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:44:05.55,0:44:08.06,Default,,0,0,0,,Рианға ат салайық.
Dialogue: 0,0:44:09.18,0:44:10.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Жол жүру ыңғайлылығы
Dialogue: 0,0:44:11.06,0:44:12.81,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:44:12.94,0:44:15.69,Default,,0,0,0,,Балалар, сендерде жұмбақ күштер бар, солай емес пе?
Dialogue: 0,0:44:16.19,0:44:17.73,Default,,0,0,0,,Дораемонға рахмет
Dialogue: 0,0:44:17.90,0:44:20.94,Default,,0,0,0,,Бұл біртүрлі, Виви. Бұл қандай қулық, Виви?
Dialogue: 0,0:44:21.07,0:44:24.07,Default,,0,0,0,,Уау
Dialogue: 0,0:44:24.20,0:44:27.03,Default,,0,0,0,,(Лианның айқайы)
Dialogue: 0,0:44:27.16,0:44:29.58,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:44:30.29,0:44:32.08,Default,,0,0,0,,Уа, уах, қолыма шатасып кетті.
Dialogue: 0,0:44:32.33,0:44:33.37,Default,,0,0,0,,Лианға қауіп төніп тұр!
Dialogue: 0,0:44:37.42,0:44:39.51,Default,,0,0,0,,(Лианның айқайы)
Dialogue: 0,0:44:39.84,0:44:40.96,Default,,0,0,0,,Лиан!
Dialogue: 0,0:44:41.72,0:44:43.93,Default,,0,0,0,,Әй, Нобита-кун! (Нобита) Жақсысың ба?
Dialogue: 0,0:44:44.05,0:44:46.39,Default,,0,0,0,,Әй, жартас!
Dialogue: 0,0:44:46.97,0:44:49.52,Default,,0,0,0,,Уф (Нобита) Тоқта!
Dialogue: 0,0:45:02.74,0:45:04.78,Default,,0,0,0,,Ха, бұл қауіпті болды.
Dialogue: 0,0:45:04.95,0:45:08.45,Default,,0,0,0,,Мені құтқарғаныңыз үшін рахмет. Нобита-кун өте батыл.
Dialogue: 0,0:45:08.78,0:45:10.45,Default,,0,0,0,,Сонымен... Мен солай ойлаймын.
Dialogue: 0,0:45:10.58,0:45:13.96,Default,,0,0,0,,Маған бұлай бірінші рет біреу айтты.
Dialogue: 0,0:45:14.08,0:45:16.00,Default,,0,0,0,,Нобита-кун Лянбиби
Dialogue: 0,0:45:16.13,0:45:17.88,Default,,0,0,0,,Амансың ба? Жақсы
Dialogue: 0,0:45:18.00,0:45:19.92,Default,,0,0,0,,Нобита керемет!
Dialogue: 0,0:45:21.30,0:45:22.92,Default,,0,0,0,,Ұшуға дайындық Жарайды
Dialogue: 0,0:45:23.30,0:45:23.92,Default,,0,0,0,,Бибі
Dialogue: 0,0:45:27.30,0:45:29.26,Default,,0,0,0,,Горо Горо Горо
Dialogue: 0,0:45:29.89,0:45:31.47,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:45:31.64,0:45:34.52,Default,,0,0,0,,Жоқ, мен жіпті алуды ұмытып кетіппін.
Dialogue: 0,0:45:34.64,0:45:37.65,Default,,0,0,0,,Жарайды. Оның кетуге еш қатысы жоқ деп ойлаймын.
Dialogue: 0,0:45:37.77,0:45:38.77,Default,,0,0,0,,Жақсы
Dialogue: 0,0:45:39.11,0:45:40.23,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,0:46:01.55,0:46:03.67,Default,,0,0,0,,Конвойға баратын кез келді.
Dialogue: 0,0:46:03.88,0:46:06.13,Default,,0,0,0,,Бірақ мен бұрмалау навигациясын пайдалана алмаймын...
Dialogue: 0,0:46:06.43,0:46:09.64,Default,,0,0,0,,Қозғалтқышты жол бойындағы жұлдызға қоюымыз керек.
Dialogue: 0,0:46:09.76,0:46:11.60,Default,,0,0,0,,Конвойға жету үшін уақыт қажет.
Dialogue: 0,0:46:12.10,0:46:14.06,Default,,0,0,0,,Не, солай ма?
Dialogue: 0,0:46:14.18,0:46:17.06,Default,,0,0,0,,Джиан 100 миллион жыл алғаннан жақсы.
Dialogue: 0,0:46:17.19,0:46:20.65,Default,,0,0,0,,Дұрыс. (Барлығы күледі)
Dialogue: 0,0:46:20.77,0:46:24.53,Default,,0,0,0,,Жұлдыз табылса, хабарлаймын. Оған дейін демалсам ше?
Dialogue: 0,0:46:24.94,0:46:25.94,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:46:35.54,0:46:37.83,Default,,0,0,0,,Жұлдыздар көп болса да...
Dialogue: 0,0:46:37.96,0:46:40.92,Default,,0,0,0,,Тірі организмдер өмір сүретін планеталар жоқ.
Dialogue: 0,0:46:41.21,0:46:45.09,Default,,0,0,0,,Флоттағы адамдар 300 жыл бойы іздеген.
Dialogue: 0,0:46:46.13,0:46:48.43,Default,,0,0,0,,Біз планетамызды жарып жібермейінше —
Dialogue: 0,0:46:48.55,0:46:50.76,Default,,0,0,0,,Жалғыз қалған бабалар кінәлі!
Dialogue: 0,0:46:51.26,0:46:52.80,Default,,0,0,0,,А, жер сілкінісі
Dialogue: 0,0:46:52.93,0:46:56.23,Default,,0,0,0,,Жоқ, біз НЛО ішіндеміз.
Dialogue: 0,0:46:56.35,0:46:57.56,Default,,0,0,0,,Уау (Нобита) Қызық, не болды?
Dialogue: 0,0:46:57.81,0:46:59.19,Default,,0,0,0,,Журнал Бұл не!
Dialogue: 0,0:46:59.48,0:47:01.61,Default,,0,0,0,,Бұл қозғалтқыштың ақауы емес.
Dialogue: 0,0:47:02.11,0:47:03.86,Default,,0,0,0,,күлкі
Dialogue: 0,0:47:04.07,0:47:06.07,Default,,0,0,0,,Лиан, сен жолдан адасың.
Dialogue: 0,0:47:09.61,0:47:10.99,Default,,0,0,0,,Бір нәрсеге тартылу
Dialogue: 0,0:47:11.45,0:47:13.45,Default,,0,0,0,,Фрейя, себебін табыңыз.
Dialogue: 0,0:47:13.66,0:47:14.70,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:47:15.33,0:47:16.58,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:47:16.75,0:47:17.83,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:47:18.21,0:47:20.79,Default,,0,0,0,,Ах, бір жарық жыл қашықтықта қара тесік бар.
Dialogue: 0,0:47:20.96,0:47:21.88,Default,,0,0,0,,Эх!
Dialogue: 0,0:47:22.00,0:47:23.50,Default,,0,0,0,,Қара тесік дегеніміз...
Dialogue: 0,0:47:23.63,0:47:25.80,Default,,0,0,0,,Бөрене қозғалтқышы толық қуатта!
Dialogue: 0,0:47:26.00,0:47:26.80,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:47:42.40,0:47:45.02,Default,,0,0,0,,Бибі бибі қалыпқа келді
Dialogue: 0,0:47:45.23,0:47:47.53,Default,,0,0,0,,Жақсы (бәріне) Банзай
Dialogue: 0,0:47:47.78,0:47:49.11,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:47:52.03,0:47:55.62,Default,,0,0,0,,Ха, бұл қауіпті болды. Егер мен сәл жақынырақ болсам...
Dialogue: 0,0:47:55.74,0:47:58.04,Default,,0,0,0,,Мен сорып, қайтып оралмадым.
Dialogue: 0,0:48:01.83,0:48:03.04,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:48:03.17,0:48:04.59,Default,,0,0,0,,қорқынышты
Dialogue: 0,0:48:04.71,0:48:07.05,Default,,0,0,0,,Ерте қонатын жұлдызды іздейік.
Dialogue: 0,0:48:07.84,0:48:10.01,Default,,0,0,0,,Қозғалтқышқа көп күш түсірген сияқты.
Dialogue: 0,0:48:14.64,0:48:17.31,Default,,0,0,0,,Мен қара тесікті көргім келді.
Dialogue: 0,0:48:17.43,0:48:18.77,Default,,0,0,0,,Не туралы айтып тұрсың!
Dialogue: 0,0:48:18.89,0:48:21.94,Default,,0,0,0,,Көрген жеріңе барсаң, сорғалап, қайтып бара алмайсың.
Dialogue: 0,0:48:22.44,0:48:25.81,Default,,0,0,0,,Ол бәрін, тіпті айналасындағы жұлдыздарды да жұтады.
Dialogue: 0,0:48:25.94,0:48:27.11,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:48:27.23,0:48:28.86,Default,,0,0,0,,Ах
Dialogue: 0,0:48:29.61,0:48:30.86,Default,,0,0,0,,Ал сен сахна артында не істеп жүрсің өзің!
Dialogue: 0,0:48:31.19,0:48:34.78,Default,,0,0,0,,Өкінішті-ақ, менің ішім дәл қазір қара құрдым сияқты.
Dialogue: 0,0:48:34.99,0:48:37.70,Default,,0,0,0,,Егер сіз әлдеқашан алып болсаңыз
Dialogue: 0,0:48:42.54,0:48:45.17,Default,,0,0,0,,Қонатын жұлдыз таппай жүрмін.
Dialogue: 0,0:48:46.79,0:48:50.09,Default,,0,0,0,,Лиан Мен сәл ауытқыдым, бірақ таптым.
Dialogue: 0,0:48:50.59,0:48:53.59,Default,,0,0,0,,Энергияны ескерсек, соғұрлым тезірек жақсы
Dialogue: 0,0:48:54.13,0:48:55.80,Default,,0,0,0,,Жарайды, сонда шешеміз.
Dialogue: 0,0:48:56.55,0:48:57.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:08.90,0:49:10.86,Default,,0,0,0,,Бұл өте тұман журнал
Dialogue: 0,0:49:11.03,0:49:13.82,Default,,0,0,0,,Біртүрлі Виви радары... Ааа...
Dialogue: 0,0:49:15.49,0:49:16.16,Default,,0,0,0,,Уау Горо
Dialogue: 0,0:49:18.16,0:49:20.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:38.01,0:49:40.31,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:49:40.76,0:49:41.81,Default,,0,0,0,,Дораемон ах
Dialogue: 0,0:49:41.93,0:49:43.02,Default,,0,0,0,,Шизука-чан?
Dialogue: 0,0:49:43.14,0:49:44.77,Default,,0,0,0,,Барлығына! (Сунео/Джиан) Иә?
Dialogue: 0,0:49:45.35,0:49:47.44,Default,,0,0,0,,Мен бір планетаға келдім
Dialogue: 0,0:49:47.56,0:49:50.02,Default,,0,0,0,,Иә? Люк ашық.
Dialogue: 0,0:49:50.23,0:49:52.15,Default,,0,0,0,,Лиан мен басқалары бірінші түсті.
Dialogue: 0,0:49:52.73,0:49:54.57,Default,,0,0,0,,Біз де сыртқа шығайық.
Dialogue: 0,0:49:54.70,0:49:56.15,Default,,0,0,0,,Ух... иә (Нобита) иә
Dialogue: 0,0:50:02.08,0:50:04.83,Default,,0,0,0,,Бұл тұман. (Нобита) Эй, мына иіс.
Dialogue: 0,0:50:05.04,0:50:06.71,Default,,0,0,0,,Артқы таудағы ағаш сияқты
Dialogue: 0,0:50:06.83,0:50:08.38,Default,,0,0,0,,Хаха мүмкін емес
Dialogue: 0,0:50:08.71,0:50:10.04,Default,,0,0,0,,Лиан!
Dialogue: 0,0:50:10.17,0:50:12.42,Default,,0,0,0,,Тұман сейілгенде, бұл Жер болуы мүмкін.
Dialogue: 0,0:50:12.59,0:50:14.63,Default,,0,0,0,,Джан, олай қалжыңдама.
Dialogue: 0,0:50:14.76,0:50:15.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:16.30,0:50:18.14,Default,,0,0,0,,Аа, қазір күн ашық.
Dialogue: 0,0:50:18.72,0:50:20.64,Default,,0,0,0,,Уау
Dialogue: 0,0:50:20.76,0:50:22.35,Default,,0,0,0,,Эй... қалжыңдап тұрсың ба?
Dialogue: 0,0:50:22.47,0:50:23.64,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:50:24.10,0:50:25.31,Default,,0,0,0,,Бұл артқы тау!
Dialogue: 0,0:50:25.52,0:50:27.23,Default,,0,0,0,,Сіз Жерге оралдыңыз, солай емес пе?
Dialogue: 0,0:50:27.39,0:50:29.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:50:29.35,0:50:31.48,Default,,0,0,0,,Анашым! Мен үйдемін
Dialogue: 0,0:50:31.61,0:50:34.11,Default,,0,0,0,,Иә! Ия
Dialogue: 0,0:50:35.03,0:50:35.90,Default,,0,0,0,,Содан кейін кездескенше.
Dialogue: 0,0:50:36.07,0:50:38.20,Default,,0,0,0,,Қош бол, қызық болды.
Dialogue: 0,0:50:38.32,0:50:39.53,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:50:40.20,0:50:43.41,Default,,0,0,0,,Риан да бірдеңе айтса екен.
Dialogue: 0,0:50:43.87,0:50:45.91,Default,,0,0,0,,Сен мені қорқытқың келмеді ме?
Dialogue: 0,0:50:46.04,0:50:47.08,Default,,0,0,0,,Ах
Dialogue: 0,0:50:47.21,0:50:49.25,Default,,0,0,0,,Се... Сенсей
Dialogue: 0,0:50:49.79,0:50:52.71,Default,,0,0,0,,Ноби-кун, иә, мен өткен күні тест тапсырдым.
Dialogue: 0,0:50:53.25,0:50:54.46,Default,,0,0,0,,Тест?
Dialogue: 0,0:50:54.59,0:50:57.17,Default,,0,0,0,,Иә! 100 ұпай?
Dialogue: 0,0:50:57.63,0:51:00.59,Default,,0,0,0,,Мұны жақсы оқуға ынталандыру ретінде пайдаланыңыз.
Dialogue: 0,0:51:00.72,0:51:03.14,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:51:03.35,0:51:04.97,Default,,0,0,0,,Бұл керемет, Нобита-кун.
Dialogue: 0,0:51:05.10,0:51:06.98,Default,,0,0,0,,Уф, бұл арман шығар.
Dialogue: 0,0:51:07.10,0:51:09.39,Default,,0,0,0,,Түс таңбалау машинасын шығарамыз ба?
Dialogue: 0,0:51:09.52,0:51:12.27,Default,,0,0,0,,Жарайды, тезірек анама көрсетейік.
Dialogue: 0,0:51:12.40,0:51:13.86,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:51:14.02,0:51:14.98,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:51:15.44,0:51:16.69,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:16.90,0:51:19.74,Default,,0,0,0,,Үйге бірнеше күн келмедім, анам ренжіді.
Dialogue: 0,0:51:19.86,0:51:21.11,Default,,0,0,0,,Амал жоқ, о
Dialogue: 0,0:51:21.24,0:51:23.53,Default,,0,0,0,,Мама, мен уайымдадым.
Dialogue: 0,0:51:23.66,0:51:25.12,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:51:25.24,0:51:26.91,Default,,0,0,0,,Әке, сіз үйдесіз бе?
Dialogue: 0,0:51:27.04,0:51:28.21,Default,,0,0,0,,Бүгін асықпай ойнайық
Dialogue: 0,0:51:28.33,0:51:29.79,Default,,0,0,0,,Иә! Ухуху
Dialogue: 0,0:51:30.50,0:51:31.96,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:51:32.58,0:51:34.09,Default,,0,0,0,,Дора-чан - Дораяки
Dialogue: 0,0:51:34.21,0:51:35.96,Default,,0,0,0,,Иә! Ухуху
Dialogue: 0,0:51:36.09,0:51:37.88,Default,,0,0,0,,Хехе, мен аламын.
Dialogue: 0,0:51:38.09,0:51:39.47,Default,,0,0,0,,Ой!
Dialogue: 0,0:51:39.59,0:51:41.64,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:51:42.26,0:51:47.10,Default,,0,0,0,,Ха, мен Жерден шыққанда қолыма алған тасты мүлдем ұмыттым.
Dialogue: 0,0:51:47.64,0:51:49.56,Default,,0,0,0,,Сәлем анашым... Уф
Dialogue: 0,0:51:49.77,0:51:51.52,Default,,0,0,0,,Не? Ноби-чан
Dialogue: 0,0:51:51.85,0:51:52.94,Default,,0,0,0,,До-до-до-дора-дора…
Dialogue: 0,0:51:53.02,0:51:54.86,Default,,0,0,0,,Не болды? Нобита
Dialogue: 0,0:51:54.98,0:51:57.32,Default,,0,0,0,,Уақыт келді (Нобита) Ах!
Dialogue: 0,0:51:57.48,0:52:00.28,Default,,0,0,0,,Көп тамақтаныңыз, әрине.
Dialogue: 0,0:52:01.03,0:52:02.66,Default,,0,0,0,,Жоқ, Дораемон!
Dialogue: 0,0:52:03.70,0:52:04.91,Default,,0,0,0,,Ноби-чан ах...
Dialogue: 0,0:52:05.24,0:52:06.95,Default,,0,0,0,,Не... не істеп жатырсың!
Dialogue: 0,0:52:11.79,0:52:14.17,Default,,0,0,0,,Дораемон, бұл Жер емес.
Dialogue: 0,0:52:14.29,0:52:17.42,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл әдеттегі бос жер емес.
Dialogue: 0,0:52:17.67,0:52:19.97,Default,,0,0,0,,Сізді оятқаным үшін кешіріңіз!
Dialogue: 0,0:52:20.42,0:52:23.13,Default,,0,0,0,,Иә? Аа, бұл қайда?
Dialogue: 0,0:52:23.26,0:52:24.80,Default,,0,0,0,,Менде аян болды
Dialogue: 0,0:52:24.93,0:52:26.56,Default,,0,0,0,,Дора-чан (Нобита) Ах
Dialogue: 0,0:52:26.68,0:52:27.76,Default,,0,0,0,,Нобита (Нобита) қашып кет!
Dialogue: 0,0:52:27.89,0:52:28.77,Default,,0,0,0,,Уау
Dialogue: 0,0:52:28.89,0:52:30.39,Default,,0,0,0,,Мен барлығын тезірек оятуым керек.
Dialogue: 0,0:52:30.52,0:52:32.27,Default,,0,0,0,,Мен білемін, мм, мм...
Dialogue: 0,0:52:32.44,0:52:35.52,Default,,0,0,0,,Алыстағы дабыл!
Dialogue: 0,0:52:35.65,0:52:37.69,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:52:38.07,0:52:39.65,Default,,0,0,0,,Менің атым Ая Цуидзи
Dialogue: 0,0:52:39.86,0:52:41.70,Default,,0,0,0,,Иә? Ах, гах!
Dialogue: 0,0:52:42.15,0:52:45.53,Default,,0,0,0,,Хмм... Аа, бәрі жақсы ма?
Dialogue: 0,0:52:45.66,0:52:47.20,Default,,0,0,0,,Жырылдау…
Dialogue: 0,0:52:47.41,0:52:49.12,Default,,0,0,0,,Сіз есін жоғалттыңыз ба?
Dialogue: 0,0:52:51.66,0:52:54.25,Default,,0,0,0,,О, маған көмектес!
Dialogue: 0,0:52:54.75,0:52:56.63,Default,,0,0,0,,Ах... Нобита-кун
Dialogue: 0,0:52:57.13,0:52:59.96,Default,,0,0,0,,Нобита-кун және басқалар Журнал! Пыр!
Dialogue: 0,0:53:01.13,0:53:02.63,Default,,0,0,0,,Әй, люк жабық!
Dialogue: 0,0:53:02.76,0:53:04.43,Default,,0,0,0,,Лиан Люкті ашыңыз!
Dialogue: 0,0:53:04.55,0:53:06.14,Default,,0,0,0,,Уау
Dialogue: 0,0:53:06.30,0:53:07.47,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:53:07.76,0:53:08.93,Default,,0,0,0,,Лиан!
Dialogue: 0,0:53:09.31,0:53:11.02,Default,,0,0,0,,Ашу
Dialogue: 0,0:53:11.14,0:53:12.02,Default,,0,0,0,,Жерлеуші
Dialogue: 0,0:53:12.35,0:53:14.14,Default,,0,0,0,,Журнал Неліктен ашылмайды?
Dialogue: 0,0:53:14.27,0:53:16.69,Default,,0,0,0,,Хмм, бұл біртүрлі, бұзылған.
Dialogue: 0,0:53:16.81,0:53:17.90,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:53:18.73,0:53:20.36,Default,,0,0,0,,Ашу
Dialogue: 0,0:53:20.61,0:53:22.78,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:53:23.15,0:53:24.82,Default,,0,0,0,,Уау
Dialogue: 0,0:53:25.86,0:53:27.91,Default,,0,0,0,,Асығыңыз, ішке асығыңыз!
Dialogue: 0,0:53:28.03,0:53:29.70,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:53:29.83,0:53:32.16,Default,,0,0,0,,Ахх, уау, не!
Dialogue: 0,0:53:32.54,0:53:33.91,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:53:34.04,0:53:35.87,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:53:36.25,0:53:37.79,Default,,0,0,0,,Уууу
Dialogue: 0,0:53:38.13,0:53:39.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:39.75,0:53:41.59,Default,,0,0,0,,Уау, маған көмектес!
Dialogue: 0,0:53:47.05,0:53:48.22,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:53:49.72,0:53:50.93,Default,,0,0,0,,Әй, Шизука-сан!
Dialogue: 0,0:53:51.26,0:53:52.93,Default,,0,0,0,,Мықты болыңыз Фрейжа
Dialogue: 0,0:53:53.31,0:53:54.43,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:53:54.56,0:53:55.73,Default,,0,0,0,,Ішке асығыңыз!
Dialogue: 0,0:53:56.02,0:53:56.90,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:53:57.60,0:53:59.36,Default,,0,0,0,,Ұшу журналы!
Dialogue: 0,0:54:07.66,0:54:09.20,Default,,0,0,0,,Иллюзиондық жұлдыз?
Dialogue: 0,0:54:09.78,0:54:13.62,Default,,0,0,0,,Жерге оралу тілегіңізді түсіндіңіз.
Dialogue: 0,0:54:13.87,0:54:15.41,Default,,0,0,0,,Бұл жай ғана елес болды
Dialogue: 0,0:54:15.66,0:54:17.87,Default,,0,0,0,,Бұл жай ғана иллюзия болса, жақсы болды!
Dialogue: 0,0:54:18.00,0:54:21.34,Default,,0,0,0,,Мен енді мұндай ғаламды қаламаймын, мама!
Dialogue: 0,0:54:21.46,0:54:22.88,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:54:23.55,0:54:24.67,Default,,0,0,0,,Хааа
Dialogue: 0,0:54:32.72,0:54:33.68,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:54:34.31,0:54:37.81,Default,,0,0,0,,Мен анама тірі кезінде жұлдыз табуға көмектескім келді.
Dialogue: 0,0:54:38.48,0:54:41.86,Default,,0,0,0,,Бірақ Галактикалық Дрифтер Флоты, барлығы үшін—
Dialogue: 0,0:54:42.27,0:54:43.36,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:54:44.11,0:54:46.90,Default,,0,0,0,,Виви флоттың орбитасына шыққалы тұр.
Dialogue: 0,0:54:47.53,0:54:49.03,Default,,0,0,0,,Лог мырза, Фрейя ше?
Dialogue: 0,0:54:49.20,0:54:50.37,Default,,0,0,0,,Гороронрон
Dialogue: 0,0:54:50.74,0:54:53.37,Default,,0,0,0,,«Бұл көршілес радар бөлмесі емес пе?»
Dialogue: 0,0:54:53.54,0:54:54.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:00.58,0:55:02.71,Default,,0,0,0,,Фрейя Ха, не?
Dialogue: 0,0:55:03.13,0:55:05.42,Default,,0,0,0,,Маған ертерек көмектескен сен едің.
Dialogue: 0,0:55:06.09,0:55:07.38,Default,,0,0,0,,Рахмет айтқым келді.
Dialogue: 0,0:55:07.76,0:55:09.30,Default,,0,0,0,,Жарайды, рахмет.
Dialogue: 0,0:55:09.80,0:55:12.01,Default,,0,0,0,,Бірақ... Мен қазір бос емеспін.
Dialogue: 0,0:55:12.14,0:55:14.18,Default,,0,0,0,,Ах, Фрейя...
Dialogue: 0,0:55:14.93,0:55:18.31,Default,,0,0,0,,Сіз бірден үйге бара аласыз. Ол үшін 100 миллион жыл қажет емес, солай ма?
Dialogue: 0,0:55:18.44,0:55:19.85,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:55:19.98,0:55:21.69,Default,,0,0,0,,Ах, Шизука-чан, не болды?
Dialogue: 0,0:55:21.98,0:55:23.65,Default,,0,0,0,,Біртүрлі Фрейя
Dialogue: 0,0:55:23.77,0:55:25.03,Default,,0,0,0,,Уау
Dialogue: 0,0:55:25.15,0:55:26.40,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:55:26.53,0:55:27.86,Default,,0,0,0,,Тағы бір оқиға?
Dialogue: 0,0:55:28.61,0:55:29.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:55:29.86,0:55:31.91,Default,,0,0,0,,Егер кеме бағыттан тыс болса
Dialogue: 0,0:55:32.03,0:55:33.99,Default,,0,0,0,,Бұл ұшқыш қатесі емес пе?
Dialogue: 0,0:55:34.12,0:55:35.45,Default,,0,0,0,,Кешіріңіз Бибі
Dialogue: 0,0:55:35.66,0:55:38.33,Default,,0,0,0,,Не болды? Кеме қозғалысы тоқтаған кезде
Dialogue: 0,0:55:38.46,0:55:41.25,Default,,0,0,0,,Неге! А, бұл не?
Dialogue: 0,0:55:49.30,0:55:51.55,Default,,0,0,0,,Бұл ғарыш кемесінің зиратындай.
Dialogue: 0,0:55:52.30,0:55:53.43,Default,,0,0,0,,Ой...
Dialogue: 0,0:55:53.60,0:55:55.97,Default,,0,0,0,,Уау
Dialogue: 0,0:55:58.14,0:56:02.40,Default,,0,0,0,,Жылдам энергия төмендейді Бұл Vivi рудасының тіршілік формасы
Dialogue: 0,0:56:02.77,0:56:05.40,Default,,0,0,0,,Ол кеменің энергиясымен қоректенеді.
Dialogue: 0,0:56:06.07,0:56:08.86,Default,,0,0,0,,А-а... Мені езіліп кететін сияқтымын!
Dialogue: 0,0:56:10.99,0:56:13.07,Default,,0,0,0,,Көріп тұрмын, мұндағы кемелер...
Dialogue: 0,0:56:13.20,0:56:15.78,Default,,0,0,0,,Осы жігіттер бәрімізді қырып тастады.
Dialogue: 0,0:56:16.03,0:56:17.04,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:56:17.16,0:56:19.12,Default,,0,0,0,,Қозғалтқыш тоқтады
Dialogue: 0,0:56:19.25,0:56:20.91,Default,,0,0,0,,Менің энергиям таусылды.
Dialogue: 0,0:56:21.04,0:56:22.29,Default,,0,0,0,,(Барлығының таңданған дауысы)
Dialogue: 0,0:56:34.89,0:56:36.14,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:56:36.47,0:56:37.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:56:37.97,0:56:40.77,Default,,0,0,0,,Виви жаңа энергия көзін тапты
Dialogue: 0,0:56:40.89,0:56:41.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:56:42.06,0:56:43.06,Default,,0,0,0,,Бибі ракетасы
Dialogue: 0,0:56:43.48,0:56:44.56,Default,,0,0,0,,Зымыран?
Dialogue: 0,0:56:48.98,0:56:50.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:56:51.03,0:56:53.57,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:56:54.74,0:56:55.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:55.99,0:56:57.70,Default,,0,0,0,,Енді қашайық.
Dialogue: 0,0:56:57.83,0:56:59.95,Default,,0,0,0,,Жоқ, менде қуат таусылды.
Dialogue: 0,0:57:00.25,0:57:02.21,Default,,0,0,0,,Зымыран жер бетінде қайдан келді?
Dialogue: 0,0:57:02.37,0:57:05.25,Default,,0,0,0,,Уайымдама, біз сені жетелейміз.
Dialogue: 0,0:57:05.71,0:57:07.54,Default,,0,0,0,,Бұл кім? Уау
Dialogue: 0,0:57:08.25,0:57:10.21,Default,,0,0,0,,Бұл қандай кеме?
Dialogue: 0,0:57:14.72,0:57:16.76,Default,,0,0,0,,Сен мені қайда апармақшысың!
Dialogue: 0,0:57:17.30,0:57:19.26,Default,,0,0,0,,Менің артымнан үнсіз жүр.
Dialogue: 0,0:57:21.98,0:57:24.35,Default,,0,0,0,,Барлық кемелерде тіршілік белгілері жоқ.
Dialogue: 0,0:57:24.48,0:57:26.65,Default,,0,0,0,,Оны біреу басқарып отыр.
Dialogue: 0,0:57:27.40,0:57:30.36,Default,,0,0,0,,Сіз флотқа бармайынша, Жерге орала алмайсыз, солай ма?
Dialogue: 0,0:57:30.48,0:57:32.61,Default,,0,0,0,,Дораемон, біз не істеуіміз керек?
Dialogue: 0,0:57:32.74,0:57:34.95,Default,,0,0,0,,Біздің қолымыздан келетіні – күту және көру.
Dialogue: 0,0:57:39.91,0:57:41.91,Default,,0,0,0,,Бұл қандай планета?
Dialogue: 0,0:57:43.83,0:57:45.75,Default,,0,0,0,,Лиан Бұл жер не деген жер...
Dialogue: 0,0:57:46.17,0:57:47.38,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:58:03.68,0:58:05.73,Default,,0,0,0,,Қандай ұлы қамал.
Dialogue: 0,0:58:19.87,0:58:21.91,Default,,0,0,0,,Сізді қайта көргеніме қуаныштымын, Лиан.
Dialogue: 0,0:58:22.04,0:58:22.87,Default,,0,0,0,,Ха…
Dialogue: 0,0:58:22.99,0:58:27.54,Default,,0,0,0,,Жарайсыңдар, таңдаулы рыцарьлар, өздеріңнің тамаша жұлдыздарыңды таптыңдар.
Dialogue: 0,0:58:27.75,0:58:28.96,Default,,0,0,0,,Командир!
Dialogue: 0,0:58:30.88,0:58:33.67,Default,,0,0,0,,Неліктен мұндай жерде? Бұл қай жер?
Dialogue: 0,0:58:34.21,0:58:37.13,Default,,0,0,0,,Бұл Тәуелсіздік армиясының алдыңғы шептегі базасы.
Dialogue: 0,0:58:37.59,0:58:39.14,Default,,0,0,0,,Тәуелсіз армия?
Dialogue: 0,0:58:39.30,0:58:42.64,Default,,0,0,0,,Галактикалық дрифтер флотының азаматтары үшін —
Dialogue: 0,0:58:42.93,0:58:46.06,Default,,0,0,0,,Ана планетасын иемденген асыл әскер.
Dialogue: 0,0:58:46.52,0:58:48.06,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:58:48.48,0:58:50.65,Default,,0,0,0,,Балалар, сендер тергеуге шыққан соң...
Dialogue: 0,0:58:50.90,0:58:53.36,Default,,0,0,0,,Командир ұйымдастырылды.
Dialogue: 0,0:58:53.48,0:58:54.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:55.03,0:58:57.11,Default,,0,0,0,,Сіз ілімді ұмыттыңыз ба!
Dialogue: 0,0:58:57.24,0:59:01.32,Default,,0,0,0,,Біз ешбір жағдайда күшпен басып кіруге болмайды!
Dialogue: 0,0:59:01.70,0:59:04.20,Default,,0,0,0,,Бұл ілім бе? Мені күлдірмеңіз
Dialogue: 0,0:59:04.33,0:59:05.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:05.79,0:59:08.21,Default,,0,0,0,,300 жыл кезгеннен кейін—
Dialogue: 0,0:59:08.33,0:59:11.75,Default,,0,0,0,,Ақырында біз идеалды планетаны, Жерді таптық па?
Dialogue: 0,0:59:12.50,0:59:14.17,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:59:14.63,0:59:17.63,Default,,0,0,0,,Мен сонда жасырған егеуқұйрық маған хабарлады.
Dialogue: 0,0:59:17.92,0:59:19.72,Default,,0,0,0,,Егеуқұйрық! Қай жерде?
Dialogue: 0,0:59:19.84,0:59:22.10,Default,,0,0,0,,Егеуқұйрық дегеніміз не? Бибі тыңшы.
Dialogue: 0,0:59:22.60,0:59:24.85,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Фрейя.
Dialogue: 0,0:59:25.27,0:59:26.89,Default,,0,0,0,,Не? Ха…
Dialogue: 0,0:59:28.23,0:59:29.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:30.60,0:59:32.73,Default,,0,0,0,,Эй... Сіз қалжыңдап тұрсыз ба, Фрейя?
Dialogue: 0,0:59:32.86,0:59:35.61,Default,,0,0,0,,Коммуникатор бұзылғандықтан.
Dialogue: 0,0:59:36.15,0:59:38.57,Default,,0,0,0,,Кешіріңіз, мен бұздым.
Dialogue: 0,0:59:39.07,0:59:40.78,Default,,0,0,0,,Не болса да
Dialogue: 0,0:59:40.95,0:59:43.66,Default,,0,0,0,,Тәуелсіздік армиясының қозғалыстары белгілі болғанын қаламадым.
Dialogue: 0,0:59:43.91,0:59:45.95,Default,,0,0,0,,Себебі сіз ынтымақтасасыз деп ойламаймын.
Dialogue: 0,0:59:46.24,0:59:46.95,Default,,0,0,0,,Ах
Dialogue: 0,0:59:47.75,0:59:48.91,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:59:49.16,0:59:52.63,Default,,0,0,0,,Мен люк ашылмайды деп ойламаппын.
Dialogue: 0,0:59:52.75,0:59:55.21,Default,,0,0,0,,Бұл менмін (барлығы) Не?
Dialogue: 0,0:59:55.96,0:59:58.42,Default,,0,0,0,,Сіз жұмбақ күштерді пайдалана аласыз.
Dialogue: 0,0:59:59.05,1:00:03.76,Default,,0,0,0,,Жердегілер тек жолға түседі. Бұл Лиан үшін.
Dialogue: 0,1:00:04.35,1:00:05.60,Default,,0,0,0,,Фрейя!
Dialogue: 0,1:00:05.72,1:00:08.64,Default,,0,0,0,,Бірақ сен маған көмектестің
Dialogue: 0,1:00:09.64,1:00:13.35,Default,,0,0,0,,Мені кеме зиратына апарып, осында әкелген...
Dialogue: 0,1:00:13.86,1:00:15.23,Default,,0,0,0,,Иә, бұл жақсырақ...
Dialogue: 0,1:00:15.48,1:00:16.73,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,1:00:17.65,1:00:18.99,Default,,0,0,0,,Лиан үшін...
Dialogue: 0,1:00:19.61,1:00:21.86,Default,,0,0,0,,Бұл жеткілікті, Фрейя.
Dialogue: 0,1:00:23.24,1:00:24.41,Default,,0,0,0,,Фрейя
Dialogue: 0,1:00:25.03,1:00:29.29,Default,,0,0,0,,Командир! Жер Жер тұрғындарына тиесілі
Dialogue: 0,1:00:30.00,1:00:31.66,Default,,0,0,0,,Тағы да ойланыңыз!
Dialogue: 0,1:00:32.21,1:00:33.75,Default,,0,0,0,,Сен әлі де солай айтып тұрсың ба, Лиан?
Dialogue: 0,1:00:34.46,1:00:36.38,Default,,0,0,0,,Мына адамдарды түрмеге тастаңыз!
Dialogue: 0,1:00:36.50,1:00:38.38,Default,,0,0,0,,Командир, сіз не істеп жатырсыз?
Dialogue: 0,1:00:39.17,1:00:42.05,Default,,0,0,0,,Командир, қайта қарастырыңыз.
Dialogue: 0,1:00:42.84,1:00:43.72,Default,,0,0,0,,Лиан!
Dialogue: 0,1:00:43.84,1:00:46.93,Default,,0,0,0,,Фрейя, мұнда кел!
Dialogue: 0,1:00:47.56,1:00:50.48,Default,,0,0,0,,Әке, қайта ойланыңызшы!
Dialogue: 0,1:00:51.14,1:00:53.14,Default,,0,0,0,,Әке!
Dialogue: 0,1:01:03.36,1:01:04.70,Default,,0,0,0,,«Әке» деген не?
Dialogue: 0,1:01:05.70,1:01:06.87,Default,,0,0,0,,Сол командир...
Dialogue: 0,1:01:06.99,1:01:10.41,Default,,0,0,0,,Қолбасшы Либерт - Лианның әкесі Виви.
Dialogue: 0,1:01:10.70,1:01:12.08,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,1:01:12.21,1:01:13.79,Default,,0,0,0,,Барлығыңыз, мені кешіріңіздер.
Dialogue: 0,1:01:13.96,1:01:16.29,Default,,0,0,0,,Лианнан кешірім сұрамайтын Виви
Dialogue: 0,1:01:17.25,1:01:20.80,Default,,0,0,0,,Осыдан кейін Моа пайда болды, әкем және басқалары...
Dialogue: 0,1:01:20.92,1:01:22.34,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,1:01:22.88,1:01:23.93,Default,,0,0,0,,«Артық» деген не?
Dialogue: 0,1:01:24.09,1:01:26.72,Default,,0,0,0,,Виви, командирдің жанындағы жігіт
Dialogue: 0,1:01:26.84,1:01:28.76,Default,,0,0,0,,Ол Анголмуа деп аталады.
Dialogue: 0,1:01:28.89,1:01:30.35,Default,,0,0,0,,Анголмуа?
Dialogue: 0,1:01:30.47,1:01:33.35,Default,,0,0,0,,Жоқ... Нострадамустың пайғамбарлықтарында кездеседі.
Dialogue: 0,1:01:33.48,1:01:36.02,Default,,0,0,0,,Бұл жерді құртатын ұлы патшаның аты емес пе?
Dialogue: 0,1:01:36.44,1:01:37.27,Default,,0,0,0,,Не!
Dialogue: 0,1:01:37.40,1:01:40.73,Default,,0,0,0,,Бірақ Дораемон 22 ғасырдан шыққан.
Dialogue: 0,1:01:40.86,1:01:43.82,Default,,0,0,0,,Білмеймін, болашақ өзгеруі мүмкін.
Dialogue: 0,1:01:43.95,1:01:44.65,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:01:44.95,1:01:47.78,Default,,0,0,0,,Қалай болғанда да, егер жағдай осылай жалғаса берсе, Жерге қауіп төнеді!
Dialogue: 0,1:01:48.20,1:01:51.16,Default,,0,0,0,,Әйтеуір осы жерден қашып, колоннаға барайық.
Dialogue: 0,1:01:51.29,1:01:52.87,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,1:01:54.16,1:01:56.33,Default,,0,0,0,,Сүңгуір қайық!
Dialogue: 0,1:01:56.67,1:01:58.21,Default,,0,0,0,,Уау
Dialogue: 0,1:01:58.54,1:02:00.25,Default,,0,0,0,,Сүңгуір қайық емес
Dialogue: 0,1:02:00.38,1:02:04.13,Default,,0,0,0,,Бұл сүңгуір қайық, өйткені ол жер астында жүреді.
Dialogue: 0,1:02:04.88,1:02:07.22,Default,,0,0,0,,Сізді тапсаңыз, қиын болады. Асықшы.
Dialogue: 0,1:02:07.34,1:02:08.64,Default,,0,0,0,,Иә (Сунео) Кеттік.
Dialogue: 0,1:02:24.07,1:02:26.86,Default,,0,0,0,,Аналық кемеге журнал Кеменің энергиясы қандай?
Dialogue: 0,1:02:26.99,1:02:29.24,Default,,0,0,0,,Мүмкін бұл аналық орбитаға жақын болуы мүмкін.
Dialogue: 0,1:02:29.37,1:02:32.41,Default,,0,0,0,,Егер сіз жай ғана қашқыңыз келсе, апаттық отынды пайдаланыңыз.
Dialogue: 0,1:02:41.38,1:02:43.55,Default,,0,0,0,,Иә? Уау
Dialogue: 0,1:02:45.80,1:02:46.63,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,1:02:48.72,1:02:50.01,Default,,0,0,0,,Джан! Пыр!
Dialogue: 0,1:02:50.89,1:02:53.01,Default,,0,0,0,,Уф! Өте ыстық
Dialogue: 0,1:02:53.14,1:02:53.97,Default,,0,0,0,,Ах
Dialogue: 0,1:02:54.10,1:02:55.10,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:55.35,1:02:56.48,Default,,0,0,0,,Уау
Dialogue: 0,1:02:56.60,1:02:57.85,Default,,0,0,0,,Ах
Dialogue: 0,1:02:59.73,1:03:00.77,Default,,0,0,0,,Ha
Dialogue: 0,1:03:03.78,1:03:04.48,Default,,0,0,0,,Фрейя
Dialogue: 0,1:03:04.98,1:03:05.94,Default,,0,0,0,,Тез қашыңыз
Dialogue: 0,1:03:06.24,1:03:07.15,Default,,0,0,0,,Жерлеуші!
Dialogue: 0,1:03:08.24,1:03:09.28,Default,,0,0,0,,Уф
Dialogue: 0,1:03:09.74,1:03:12.91,Default,,0,0,0,,Фрея, тез менімен жүр!
Dialogue: 0,1:03:15.50,1:03:16.50,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:03:17.00,1:03:18.16,Default,,0,0,0,,Фрейя!
Dialogue: 0,1:03:37.18,1:03:39.44,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:40.31,1:03:42.69,Default,,0,0,0,,Журнал маневр жасауда жақсы.
Dialogue: 0,1:03:42.81,1:03:46.32,Default,,0,0,0,,Соған қарамастан Виви Лианнан жеңіледі.
Dialogue: 0,1:03:46.44,1:03:47.40,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:03:48.07,1:03:49.95,Default,,0,0,0,,Жаңа достармен таныстыру
Dialogue: 0,1:03:50.28,1:03:51.57,Default,,0,0,0,,Не? иә?
Dialogue: 0,1:03:51.78,1:03:53.41,Default,,0,0,0,,Жаңа серіктес?
Dialogue: 0,1:03:54.24,1:03:55.58,Default,,0,0,0,,Бұл Фрейя.
Dialogue: 0,1:03:58.00,1:04:00.25,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,1:04:00.62,1:04:02.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:04.17,1:04:07.51,Default,,0,0,0,,Ештеңе емес, сенің мен жағында болатыныңа сенімді едім.
Dialogue: 0,1:04:07.63,1:04:08.55,Default,,0,0,0,,Иә
Dialogue: 0,1:04:08.67,1:04:11.93,Default,,0,0,0,,Жаңа достар шақырылады. Эй, Горо-чан.
Dialogue: 0,1:04:12.05,1:04:13.97,Default,,0,0,0,,Горо Горо Горо
Dialogue: 0,1:04:14.35,1:04:17.52,Default,,0,0,0,,Жарайды, Фрейя, флотқа хабарласыңыз.
Dialogue: 0,1:04:18.06,1:04:18.85,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:19.89,1:04:21.14,Default,,0,0,0,,Бөренелер траекториясы дегеніміз не?
Dialogue: 0,1:04:21.27,1:04:22.44,Default,,0,0,0,,Жарайды Бибі
Dialogue: 0,1:04:30.40,1:04:31.95,Default,,0,0,0,,Неден қаштың?
Dialogue: 0,1:04:32.49,1:04:34.91,Default,,0,0,0,,Мен саған бұлай қашып кетуіме жол берме дедім.
Dialogue: 0,1:04:35.07,1:04:36.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:04:37.62,1:04:39.95,Default,,0,0,0,,Бірақ сол жұмбақ құралмен...
Dialogue: 0,1:04:40.08,1:04:41.37,Default,,0,0,0,,Либерт
Dialogue: 0,1:04:41.50,1:04:44.67,Default,,0,0,0,,Сол жердегілерді флотқа жіберу жаман болар еді.
Dialogue: 0,1:04:44.79,1:04:47.50,Default,,0,0,0,,Та... Оны дереу ұстаңыз! Оны қу!
Dialogue: 0,1:04:47.63,1:04:48.59,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:49.80,1:04:53.38,Default,,0,0,0,,Фрейяның жігіті маған опасыздық жасады.
Dialogue: 0,1:05:01.23,1:05:03.69,Default,,0,0,0,,Лиан, артымнан бірдеңе келе жатыр.
Dialogue: 0,1:05:04.27,1:05:05.15,Default,,0,0,0,,Ұшқышсыз кеме!
Dialogue: 0,1:05:05.61,1:05:07.94,Default,,0,0,0,,Журнал Қуатты қосу және шығу
Dialogue: 0,1:05:08.07,1:05:11.11,Default,,0,0,0,,Бұл мүмкін емес, Бибі, жанармайым таусылды.
Dialogue: 0,1:05:17.37,1:05:19.49,Default,,0,0,0,,Фрея Флот әлі бар ма?
Dialogue: 0,1:05:20.04,1:05:21.62,Default,,0,0,0,,Ол жақын жерде болуы керек.
Dialogue: 0,1:05:23.21,1:05:25.58,Default,,0,0,0,,Әй, бұл Тәуелсіздік армиясының тұтқын кемесі!
Dialogue: 0,1:05:25.71,1:05:27.21,Default,,0,0,0,,Ах
Dialogue: 0,1:05:30.42,1:05:32.84,Default,,0,0,0,,Мен қашып құтылсам да
Dialogue: 0,1:05:32.97,1:05:35.09,Default,,0,0,0,,Біз қайтадан ораламыз ба?
Dialogue: 0,1:05:35.55,1:05:36.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:40.14,1:05:41.64,Default,,0,0,0,,Ол қашып кеткен сияқты
Dialogue: 0,1:05:41.77,1:05:44.23,Default,,0,0,0,,Бірақ бұл қандай жарық?
Dialogue: 0,1:05:44.39,1:05:46.40,Default,,0,0,0,,Горо сақталды!
Dialogue: 0,1:05:51.86,1:05:53.32,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,1:05:53.44,1:05:55.24,Default,,0,0,0,,Конвой маған көмектесті.
Dialogue: 0,1:05:55.36,1:05:56.61,Default,,0,0,0,,Ятта Би
Dialogue: 0,1:05:57.32,1:05:58.78,Default,,0,0,0,,Бұл аналық кеме!
Dialogue: 0,1:05:58.91,1:06:01.37,Default,,0,0,0,,Керемет (Нобита) Тым таңқаларлық
Dialogue: 0,1:06:59.05,1:07:01.72,Default,,0,0,0,,Еңбегіңіз үшін рахмет, MSK Boy Knights
Dialogue: 0,1:07:01.85,1:07:03.89,Default,,0,0,0,,Кеңеске асығыңыз.
Dialogue: 0,1:07:04.56,1:07:08.85,Default,,0,0,0,,Қош келдіңіздер MS-3 Жер тұрғындары, біз сіздерді қош келдіңіздер.
Dialogue: 0,1:07:09.40,1:07:11.56,Default,,0,0,0,,Сіз біз туралы білетін сияқтысыз.
Dialogue: 0,1:07:11.73,1:07:14.03,Default,,0,0,0,,Мен сізге оның мәнін айттым.
Dialogue: 0,1:07:14.19,1:07:14.82,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,1:07:21.12,1:07:24.62,Default,,0,0,0,,Кеңес отырысында не болғанын бізге келіп айтып беруіңізді қалаймын.
Dialogue: 0,1:07:25.08,1:07:27.41,Default,,0,0,0,,Әрине бұл жер үшін.
Dialogue: 0,1:07:27.54,1:07:30.54,Default,,0,0,0,,Мүмкін Моа Жерді жаулап алғанға дейін
Dialogue: 0,1:07:30.67,1:07:33.92,Default,,0,0,0,,Олар аналық кемені күшпен басқару стратегиясын іске қосады.
Dialogue: 0,1:07:34.09,1:07:37.47,Default,,0,0,0,,Мен әкемнің көш басында тұрғанына сенбеймін.
Dialogue: 0,1:07:38.17,1:07:40.97,Default,,0,0,0,,Анголмуа деген кім?
Dialogue: 0,1:07:46.22,1:07:48.85,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,1:07:49.19,1:07:52.35,Default,,0,0,0,,Ғарыш кемесінің ішінде осындай үлкен қала бар.
Dialogue: 0,1:07:52.81,1:07:54.44,Default,,0,0,0,,Халық саны қанша?
Dialogue: 0,1:07:55.27,1:07:57.40,Default,,0,0,0,,Шамамен 10 миллион адам
Dialogue: 0,1:07:57.69,1:08:00.86,Default,,0,0,0,,Лагуна планетасы ғана емес, 300 жыл бойы —
Dialogue: 0,1:08:00.99,1:08:05.24,Default,,0,0,0,,Горогоро сияқты Бибидің де басқа планеталардың тұрғындары көп.
Dialogue: 0,1:08:05.37,1:08:07.58,Default,,0,0,0,,Бұл кеңес орналасқан федералды ғимарат.
Dialogue: 0,1:08:13.25,1:08:16.34,Default,,0,0,0,,Галактикалық дрейф флотына қош келдіңіз
Dialogue: 0,1:08:17.05,1:08:20.59,Default,,0,0,0,,Бәрің де жердің батыл ұлдарысыңдар ма?
Dialogue: 0,1:08:20.72,1:08:23.64,Default,,0,0,0,,Мен Кеңес төрағасы Мазуламын.
Dialogue: 0,1:08:23.93,1:08:26.89,Default,,0,0,0,,Лиан, мен саған бір оқиғаны айтып берейін.
Dialogue: 0,1:08:27.01,1:08:27.85,Default,,0,0,0,,Иә
Dialogue: 0,1:08:27.97,1:08:30.14,Default,,0,0,0,,Жер бетіндегі барлық адамдар, өтінемін.
Dialogue: 0,1:08:30.52,1:08:31.44,Default,,0,0,0,,Иә
Dialogue: 0,1:08:32.44,1:08:35.65,Default,,0,0,0,,Тәуелсіз армия күшпен флотты бақылауға алды.
Dialogue: 0,1:08:35.77,1:08:39.36,Default,,0,0,0,,Олар сондай-ақ өздерінің планетасына, Жерге басып кіруге тырысуда.
Dialogue: 0,1:08:39.69,1:08:42.40,Default,,0,0,0,,О, құдай, Либерт командир.
Dialogue: 0,1:08:42.61,1:08:45.83,Default,,0,0,0,,Моа-хан келген соң, мен бірдеңе дұрыс емес деп ойладым.
Dialogue: 0,1:08:46.28,1:08:47.91,Default,,0,0,0,,Сенің қашудан басқа амалың жоқ.
Dialogue: 0,1:08:48.04,1:08:50.37,Default,,0,0,0,,Сіз маған флоттан бас тартуды айтасыз ба?
Dialogue: 0,1:08:50.58,1:08:52.83,Default,,0,0,0,,Бұл жағдайда күресуден басқа амалымыз жоқ.
Dialogue: 0,1:08:53.17,1:08:55.84,Default,,0,0,0,,Амал жоқ, біз қалай күресуді білмейміз.
Dialogue: 0,1:08:55.96,1:08:58.30,Default,,0,0,0,,Жоқ, бұлай айтатын уақыт емес.
Dialogue: 0,1:08:58.42,1:09:02.22,Default,,0,0,0,,300 жылдық тарихта бірде-бір шайқас болған емес.
Dialogue: 0,1:09:02.51,1:09:05.97,Default,,0,0,0,,Болашақта ілім үзілмейтін шығар.
Dialogue: 0,1:09:06.10,1:09:09.60,Default,,0,0,0,,(Кеңес мүшелерінің бір-бірімен айтысқан дауысы)
Dialogue: 0,1:09:10.02,1:09:12.64,Default,,0,0,0,,Барлығы, кешіктіруге уақыт жоқ.
Dialogue: 0,1:09:13.10,1:09:14.77,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:09:14.90,1:09:18.57,Default,,0,0,0,,Киелі жерде Құдайдан тәлім алайық
Dialogue: 0,1:09:18.98,1:09:21.28,Default,,0,0,0,,Құдай дегеніміз не?
Dialogue: 0,1:09:21.40,1:09:23.57,Default,,0,0,0,,Сіз «қасиетті жер» дедіңіз
Dialogue: 0,1:09:23.78,1:09:27.70,Default,,0,0,0,,(Кеңес мүшелерінің бір-бірімен сөз таластыратын дауыстары)
Dialogue: 0,1:09:28.41,1:09:32.83,Default,,0,0,0,,Қасиетті жер - бұл кемедегі табиғаты бар жалғыз орын.
Dialogue: 0,1:09:33.12,1:09:35.42,Default,,0,0,0,,Құдай бар, солай ма?
Dialogue: 0,1:09:35.54,1:09:40.17,Default,,0,0,0,,Көшбасшымыз және тіршілік көзі
Dialogue: 0,1:09:40.30,1:09:42.01,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,1:09:42.63,1:09:45.47,Default,,0,0,0,,Бұл адам емес. Бұл біздің Құдайымыз.
Dialogue: 0,1:09:46.09,1:09:47.60,Default,,0,0,0,,«Yggd ағашы»
Dialogue: 0,1:10:04.90,1:10:09.78,Default,,0,0,0,,300 жыл бұрын, біздің ата-бабаларымыз Лагуна планетасын тастап кеткенде—
Dialogue: 0,1:10:10.08,1:10:15.33,Default,,0,0,0,,Бала үйінділердің арасынан бір уыс топырақ пен жарқыраған ағаш тапты.
Dialogue: 0,1:10:16.04,1:10:18.92,Default,,0,0,0,,Бұл ағашты кемеге мұқият әкелді, содан кейін...
Dialogue: 0,1:10:19.13,1:10:21.59,Default,,0,0,0,,Мені бәрінің қолдары көтерді.
Dialogue: 0,1:10:23.17,1:10:25.76,Default,,0,0,0,,Осы Yggd ағашынан бастап—
Dialogue: 0,1:10:25.88,1:10:27.97,Default,,0,0,0,,Мен көп нәрсені үйрендім.
Dialogue: 0,1:10:28.76,1:10:33.14,Default,,0,0,0,,Құдай енді біздің орталық фигурамыз.
Dialogue: 0,1:10:33.97,1:10:37.31,Default,,0,0,0,,Қайғылы, ауыртпалық немесе күмәнді нәрсе болса...
Dialogue: 0,1:10:37.44,1:10:40.11,Default,,0,0,0,,Киелі ағаштың жемісін түртіп, ілімін сұрау.
Dialogue: 0,1:10:40.56,1:10:41.82,Default,,0,0,0,,Мына пішін
Dialogue: 0,1:10:42.90,1:10:43.78,Default,,0,0,0,,Осымен бірдей
Dialogue: 0,1:10:44.11,1:10:46.40,Default,,0,0,0,,Тәңір ағашының жемісі! қайда?
Dialogue: 0,1:10:46.53,1:10:49.87,Default,,0,0,0,,Ол бәрің Жерден ұшып кеткеннен кейін сонда болды.
Dialogue: 0,1:10:50.99,1:10:53.45,Default,,0,0,0,,Бұл ағаштың жемісі ме?
Dialogue: 0,1:10:57.16,1:11:01.59,Default,,0,0,0,,Бұл жеміс Йггдо ағашының жанынан тек ұл рыцарьларға беріледі.
Dialogue: 0,1:11:02.29,1:11:05.51,Default,,0,0,0,,Біз флоттан шықсақ та, ол бізді әрқашан қорғайды.
Dialogue: 0,1:11:06.01,1:11:07.47,Default,,0,0,0,,Тұмар сияқты.
Dialogue: 0,1:11:09.76,1:11:13.60,Default,,0,0,0,,Дұрыс, мен иллюзиялы планетада ояндым...
Dialogue: 0,1:11:14.01,1:11:15.81,Default,,0,0,0,,Бұл амулет маған көмектесті.
Dialogue: 0,1:11:16.39,1:11:19.19,Default,,0,0,0,,Лиан, мен оны саған қайтарамын, енді түсірме.
Dialogue: 0,1:11:20.27,1:11:22.27,Default,,0,0,0,,Рахмет сізге Нобита-кун
Dialogue: 0,1:11:27.86,1:11:31.28,Default,,0,0,0,,Жүр, Лиан, маған Yggd ағашы туралы айт.
Dialogue: 0,1:11:31.41,1:11:32.32,Default,,0,0,0,,Иә
Dialogue: 0,1:11:39.21,1:11:40.58,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:11:44.63,1:11:45.42,Default,,0,0,0,,Лиан
Dialogue: 0,1:11:46.13,1:11:47.01,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:11:47.55,1:11:50.26,Default,,0,0,0,,Бір ғажайыппен Лианның қайтыс болған анасы...
Dialogue: 0,1:11:50.38,1:11:51.72,Default,,0,0,0,,Эх!
Dialogue: 0,1:11:51.89,1:11:53.60,Default,,0,0,0,,Лианның анасы қайтыс болды ма?
Dialogue: 0,1:11:54.05,1:11:56.10,Default,,0,0,0,,Лианна әлі жас болған кезде
Dialogue: 0,1:11:56.81,1:11:58.81,Default,,0,0,0,,Ана, әке...
Dialogue: 0,1:11:58.93,1:11:59.77,Default,,0,0,0,,Алайда Қара өлімші тек дәптерге қол тигізгендерге ғана көрінеді.
Dialogue: 0,1:12:00.52,1:12:02.06,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:12:02.98,1:12:05.36,Default,,0,0,0,,Сізде бір ғана іс бар
Dialogue: 0,1:12:05.48,1:12:06.78,Default,,0,0,0,,Моаны жеңу
Dialogue: 0,1:12:07.03,1:12:07.74,Default,,0,0,0,,Көбірек?
Dialogue: 0,1:12:08.61,1:12:11.20,Default,,0,0,0,,Әкемді басқарып отырған Моаны жеңіңіз.
Dialogue: 0,1:12:11.99,1:12:14.95,Default,,0,0,0,,Моаның ақыл-ойды басқаруға мүмкіндік беретін табиғаттан тыс күштері бар.
Dialogue: 0,1:12:15.58,1:12:20.12,Default,,0,0,0,,Конвойдан бірнеше адамды манипуляциялау арқылы тәуелсіз әскер құрды.
Dialogue: 0,1:12:21.08,1:12:24.13,Default,,0,0,0,,Моа жеңілсе, тәуелсіздік армиясы күйреді.
Dialogue: 0,1:12:24.67,1:12:26.13,Default,,0,0,0,,Бейбітшілік қайта оралады
Dialogue: 0,1:12:26.59,1:12:30.05,Default,,0,0,0,,Осындай күшпен Моаға қарсы тұра аласың ба?
Dialogue: 0,1:12:30.72,1:12:33.22,Default,,0,0,0,,Жарайды, айналаңа қара.
Dialogue: 0,1:12:33.43,1:12:34.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:34.64,1:12:37.60,Default,,0,0,0,,Сені жақсы көретін және саған сенетіндер
Dialogue: 0,1:12:37.93,1:12:41.69,Default,,0,0,0,,Ең бастысы, менің сенім арта алатын жаңа достарым бар.
Dialogue: 0,1:12:42.19,1:12:43.69,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:12:43.81,1:12:48.36,Default,,0,0,0,,Қасиетті ағаштың жемісімен бірге, Мен сені мәңгі бақылаймын.
Dialogue: 0,1:12:48.94,1:12:51.45,Default,,0,0,0,,Ендеше ойланбастан жалғастырыңыз.
Dialogue: 0,1:12:51.65,1:12:52.28,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:12:52.86,1:12:53.74,Default,,0,0,0,,Анашым!
Dialogue: 0,1:12:54.28,1:12:56.87,Default,,0,0,0,,Еш ойланбастан жалғастырыңыз
Dialogue: 0,1:12:59.24,1:13:01.58,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:13:04.04,1:13:07.42,Default,,0,0,0,,Жер тұрғындары мен Гайя халқы қосылды ма?
Dialogue: 0,1:13:08.13,1:13:10.96,Default,,0,0,0,,Командир, біз тез шешім қабылдауымыз керек.
Dialogue: 0,1:13:11.55,1:13:13.59,Default,,0,0,0,,Либерт Сіз неден тартынасыз?
Dialogue: 0,1:13:13.72,1:13:15.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:13:15.97,1:13:17.64,Default,,0,0,0,,Жауынгерлік корпустың кетуі
Dialogue: 0,1:13:18.22,1:13:21.02,Default,,0,0,0,,Гаяға жан-жақты шабуыл жасаңыз!
Dialogue: 0,1:13:29.23,1:13:31.40,Default,,0,0,0,,Не?
Dialogue: 0,1:13:32.19,1:13:33.90,Default,,0,0,0,,Тәуелсіздік армиясының жауынгерлері—
Dialogue: 0,1:13:34.03,1:13:37.24,Default,,0,0,0,,Олар бізге қарай көптеп келе жатқан сияқты.
Dialogue: 0,1:13:37.37,1:13:38.74,Default,,0,0,0,,Ақыры келді ме?
Dialogue: 0,1:13:38.87,1:13:40.41,Default,,0,0,0,,Дораэмон (барлығы) Иә.
Dialogue: 0,1:13:40.70,1:13:43.41,Default,,0,0,0,,Барып, Лиан Моаны жеңейік.
Dialogue: 0,1:13:43.91,1:13:44.75,Default,,0,0,0,,Иә
Dialogue: 0,1:13:45.75,1:13:49.17,Default,,0,0,0,,Ана, мен тыныштықты қалпына келтіретінімізге сенімдімін.
Dialogue: 0,1:13:56.51,1:13:59.39,Default,,0,0,0,,Барлық Space Boy Knights кетуі керек.
Dialogue: 0,1:13:59.60,1:14:00.97,Default,,0,0,0,,«Ғарыш бала рыцарлары» ойынын қайталаңыз...
Dialogue: 0,1:14:01.06,1:14:02.77,Default,,0,0,0,,Сәттілік Лиан
Dialogue: 0,1:14:03.23,1:14:04.89,Default,,0,0,0,,Біз де көмектесе аламыз
Dialogue: 0,1:14:05.02,1:14:05.64,Default,,0,0,0,,Рахмет
Dialogue: 0,1:14:06.10,1:14:07.73,Default,,0,0,0,,Журнал Жанармай ше?
Dialogue: 0,1:14:07.86,1:14:09.31,Default,,0,0,0,,Биви көп
Dialogue: 0,1:14:09.98,1:14:11.44,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,1:14:11.57,1:14:12.82,Default,,0,0,0,,Горогоро (Сунео) Иә.
Dialogue: 0,1:14:13.49,1:14:15.99,Default,,0,0,0,,Дорэмон, біз де шығайық.
Dialogue: 0,1:14:16.11,1:14:18.28,Default,,0,0,0,,Иә, біз Жерді қорғауымыз керек.
Dialogue: 0,1:14:18.66,1:14:20.03,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:14:20.16,1:14:21.20,Default,,0,0,0,,Дора-чан?
Dialogue: 0,1:14:22.12,1:14:24.00,Default,,0,0,0,,Фрейяға рахмет
Dialogue: 0,1:14:24.20,1:14:27.62,Default,,0,0,0,,Ойындағы ғарыш кемесінде төбелесейік.
Dialogue: 0,1:14:27.75,1:14:28.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:28.83,1:14:30.96,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,1:14:31.09,1:14:32.63,Default,,0,0,0,,Фрейя иә?
Dialogue: 0,1:14:33.76,1:14:35.17,Default,,0,0,0,,Лианды қорғаңыз.
Dialogue: 0,1:14:35.92,1:14:36.59,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,1:14:37.18,1:14:39.93,Default,,0,0,0,,Ойынды ашып, сыртқа шығыңыз
Dialogue: 0,1:15:08.87,1:15:10.42,Default,,0,0,0,,Бәрің мені ести аласыңдар ма?
Dialogue: 0,1:15:10.96,1:15:11.67,Default,,0,0,0,,Мүмкін...
Dialogue: 0,1:15:12.09,1:15:14.59,Default,,0,0,0,,Тыңдаңыз, бұл ойын емес.
Dialogue: 0,1:15:15.09,1:15:16.05,Default,,0,0,0,,Білсем де
Dialogue: 0,1:15:16.63,1:15:18.47,Default,,0,0,0,,Жерді қорғау
Dialogue: 0,1:15:30.35,1:15:31.73,Default,,0,0,0,,Міне! Бибі
Dialogue: 0,1:15:31.86,1:15:32.52,Default,,0,0,0,,Жер шары
Dialogue: 0,1:15:32.65,1:15:33.98,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,1:15:44.54,1:15:46.20,Default,,0,0,0,,Radar мүмкін емес Return!
Dialogue: 0,1:15:46.41,1:15:47.16,Default,,0,0,0,,Кук
Dialogue: 0,1:15:49.37,1:15:50.12,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:50.62,1:15:52.13,Default,,0,0,0,,Жеңілген демалыс
Dialogue: 0,1:15:55.05,1:15:56.80,Default,,0,0,0,,Мен Нобитаға жеңіле алмаймын
Dialogue: 0,1:15:57.88,1:15:59.59,Default,,0,0,0,,Оң жақтан соққы алды
Dialogue: 0,1:16:03.39,1:16:04.93,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,1:16:13.31,1:16:14.48,Default,,0,0,0,,Жоқ, шектеу жоқ.
Dialogue: 0,1:16:14.94,1:16:17.53,Default,,0,0,0,,Лиан: Базадағы басқару мұнарасын жойған дұрыс.
Dialogue: 0,1:16:17.65,1:16:19.90,Default,,0,0,0,,Түсіндім! Нобита-кун, маған көмектес
Dialogue: 0,1:16:20.49,1:16:22.11,Default,,0,0,0,,Түсіндім, Дораемон
Dialogue: 0,1:16:22.53,1:16:24.62,Default,,0,0,0,,Аа, мен мұны байқамадым.
Dialogue: 0,1:16:24.74,1:16:28.41,Default,,0,0,0,,Шизука-чан Сунео-кун Джиан қолдау сұрайды
Dialogue: 0,1:16:28.54,1:16:30.08,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,1:16:30.50,1:16:31.71,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,1:16:44.09,1:16:45.01,Default,,0,0,0,,Міне!
Dialogue: 0,1:16:49.02,1:16:50.98,Default,,0,0,0,,Мен ғарыш кремін жағып жатырмын, бірақ...
Dialogue: 0,1:16:51.10,1:16:53.69,Default,,0,0,0,,Гравитация аз, сондықтан абай болыңыз.
Dialogue: 0,1:16:53.90,1:16:54.86,Default,,0,0,0,,Барайық (Нобита) Иә.
Dialogue: 0,1:16:54.98,1:16:56.11,Default,,0,0,0,,Мен ерекшелене аламын деп ойламаймын—
Dialogue: 0,1:16:56.23,1:16:58.61,Default,,0,0,0,,Йо, хой, хойт, уши
Dialogue: 0,1:16:59.69,1:17:01.57,Default,,0,0,0,,Жақын жерден қарасаң үлкен көрінеді.
Dialogue: 0,1:17:01.90,1:17:04.62,Default,,0,0,0,,Кішкене ғана істесем сынбайтын сияқты.
Dialogue: 0,1:17:04.95,1:17:07.08,Default,,0,0,0,,Иә, мұны қолданайық.
Dialogue: 0,1:17:07.58,1:17:09.33,Default,,0,0,0,,Нендрон!
Dialogue: 0,1:17:10.00,1:17:12.21,Default,,0,0,0,,Мұны кез келген нәрсеге себіңіз...
Dialogue: 0,1:17:12.33,1:17:14.71,Default,,0,0,0,,Саз сияқты ақсап қалады
Dialogue: 0,1:17:14.83,1:17:16.50,Default,,0,0,0,,Қараңызшы, уау.
Dialogue: 0,1:17:16.75,1:17:18.00,Default,,0,0,0,,Қане оны орап алайық
Dialogue: 0,1:17:18.13,1:17:20.42,Default,,0,0,0,,Енді сіз оны пайдалана алмайсыз.
Dialogue: 0,1:17:24.89,1:17:28.10,Default,,0,0,0,,Не болып жатыр? Жау кемесі қозғалысты тоқтатты
Dialogue: 0,1:17:28.22,1:17:30.14,Default,,0,0,0,,Нобита мен оның достары сәтті болды.
Dialogue: 0,1:17:30.52,1:17:31.89,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:17:32.39,1:17:35.27,Default,,0,0,0,,Не! Басқару тірегі зақымдалды ма?
Dialogue: 0,1:17:35.56,1:17:39.15,Default,,0,0,0,,Жөндеу мүмкін емес Шабуыл қайығы жойылды
Dialogue: 0,1:17:39.32,1:17:43.82,Default,,0,0,0,,Куу... Тағы да сол жердегілердің ісі ме?
Dialogue: 0,1:17:44.03,1:17:46.95,Default,,0,0,0,,Егер бұл орын алса, біз Гаяға мінеміз.
Dialogue: 0,1:17:47.41,1:17:50.41,Default,,0,0,0,,Басқару бөлмесін басып алыңыз.
Dialogue: 0,1:17:50.66,1:17:51.62,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:52.12,1:17:53.62,Default,,0,0,0,,Либерт
Dialogue: 0,1:17:54.25,1:17:56.08,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:17:56.67,1:17:57.96,Default,,0,0,0,,Дұрыс. (Нобита) Иә.
Dialogue: 0,1:17:58.09,1:17:59.67,Default,,0,0,0,,Олар бір-біріне ұқсамайды, иә?
Dialogue: 0,1:17:59.80,1:18:02.76,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,1:18:09.51,1:18:11.26,Default,,0,0,0,,Лиан Горо
Dialogue: 0,1:18:26.74,1:18:27.95,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:18:28.07,1:18:29.57,Default,,0,0,0,,Нанана... қалай болғанда да
Dialogue: 0,1:18:29.74,1:18:31.20,Default,,0,0,0,,Фрейя ше?
Dialogue: 0,1:18:31.33,1:18:32.49,Default,,0,0,0,,Ах, Фрейя.
Dialogue: 0,1:18:33.20,1:18:34.04,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,1:18:34.83,1:18:38.29,Default,,0,0,0,,Лиан Моа осы бекіністе Гайяға мінуге ниетті.
Dialogue: 0,1:18:38.50,1:18:40.25,Default,,0,0,0,,Сонымен, сіз мұны мініп жүрсіз бе?
Dialogue: 0,1:18:40.38,1:18:41.00,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,1:18:41.42,1:18:43.38,Default,,0,0,0,,ішке кірейік. Жақсы!
Dialogue: 0,1:18:43.63,1:18:45.97,Default,,0,0,0,,Нобита-кун, кеттік (Нобита) Е, уау.
Dialogue: 0,1:18:50.22,1:18:52.06,Default,,0,0,0,,Йошо (Нобита) Йо
Dialogue: 0,1:18:52.76,1:18:55.18,Default,,0,0,0,,Құрсаудан өтіңіз!
Dialogue: 0,1:18:55.56,1:18:58.02,Default,,0,0,0,,Енді ішке асығыңыз. (Нобита) Иә, уау.
Dialogue: 0,1:18:58.48,1:18:59.56,Default,,0,0,0,,Уау
Dialogue: 0,1:19:00.90,1:19:01.61,Default,,0,0,0,,Жарайды
Dialogue: 0,1:19:02.02,1:19:03.57,Default,,0,0,0,,Мен командалық бөлме осында екеніне сенімдімін.
Dialogue: 0,1:19:03.86,1:19:04.82,Default,,0,0,0,,Кеттік
Dialogue: 0,1:19:08.99,1:19:10.53,Default,,0,0,0,,Біз де бортқа отырайық.
Dialogue: 0,1:19:10.66,1:19:12.33,Default,,0,0,0,,Жарайды журнал, кеттік.
Dialogue: 0,1:19:12.45,1:19:13.58,Default,,0,0,0,,Вивиді түсіндім
Dialogue: 0,1:19:17.16,1:19:18.83,Default,,0,0,0,,Уау аааа
Dialogue: 0,1:19:19.00,1:19:21.54,Default,,0,0,0,,А, мен саған жақындай да алмаймын.
Dialogue: 0,1:19:21.88,1:19:24.96,Default,,0,0,0,,Ақымақтар, сендер менің қарсыласым емессіңдер.
Dialogue: 0,1:19:25.34,1:19:27.42,Default,,0,0,0,,1 минутта қосылыңыз
Dialogue: 0,1:19:28.26,1:19:31.93,Default,,0,0,0,,Либерт Гайаның барлық мүмкіндіктері сіздің қолыңызда—
Dialogue: 0,1:19:32.05,1:19:34.85,Default,,0,0,0,,Азаматтарды басқаратын кез келді
Dialogue: 0,1:19:35.93,1:19:37.85,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін, Моа!
Dialogue: 0,1:19:38.23,1:19:39.39,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:19:39.52,1:19:40.56,Default,,0,0,0,,Риан... Риан
Dialogue: 0,1:19:40.73,1:19:44.02,Default,,0,0,0,,Әке, мені Моаның психикалық күші басқарады.
Dialogue: 0,1:19:44.86,1:19:48.15,Default,,0,0,0,,Лиан 300 жыл бойы Гайяның азаматтары
Dialogue: 0,1:19:48.28,1:19:51.41,Default,,0,0,0,,Біз жұлдыз анамыз Жерді қанша уақыт күттік?
Dialogue: 0,1:19:52.12,1:19:55.91,Default,,0,0,0,,Қолымызға қару алып, жерлестерімізбен бірге тұратын кез келді.
Dialogue: 0,1:19:56.50,1:19:57.33,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:19:57.83,1:19:59.79,Default,,0,0,0,,Лиан, мұнда кел.
Dialogue: 0,1:20:00.58,1:20:01.46,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:20:01.67,1:20:03.04,Default,,0,0,0,,Лиан! Лиан!
Dialogue: 0,1:20:06.92,1:20:10.01,Default,,0,0,0,,Порт жағынан жақындап келе жатқан НЛО порт жағынан жақындап келеді
Dialogue: 0,1:20:10.84,1:20:14.26,Default,,0,0,0,,Контактіден 30 секунд бұрын диспетчерлік пунктке қарай жылжу!
Dialogue: 0,1:20:18.43,1:20:20.31,Default,,0,0,0,,Лиан сізге!
Dialogue: 0,1:20:20.73,1:20:22.31,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,1:20:23.61,1:20:25.07,Default,,0,0,0,,Га Құдайдың ағаш жемісі
Dialogue: 0,1:20:25.40,1:20:26.07,Default,,0,0,0,,Ха!
Dialogue: 0,1:20:26.57,1:20:29.03,Default,,0,0,0,,Либерт Оларды атып өлтіріңіз.
Dialogue: 0,1:20:30.78,1:20:31.74,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:20:32.41,1:20:33.24,Default,,0,0,0,,Түсіру
Dialogue: 0,1:20:33.66,1:20:34.87,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,1:20:35.12,1:20:36.83,Default,,0,0,0,,Gaia қосылымы басталды
Dialogue: 0,1:20:42.83,1:20:45.71,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,1:20:46.63,1:20:48.00,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,1:20:50.80,1:20:52.63,Default,,0,0,0,,Либерт, тез ат!
Dialogue: 0,1:20:54.43,1:20:56.81,Default,,0,0,0,,Ху (Тәуелсіз армияның солдаты) Ах!
Dialogue: 0,1:20:57.89,1:20:58.81,Default,,0,0,0,,Уау (Нобита) Ах
Dialogue: 0,1:20:59.56,1:21:01.18,Default,,0,0,0,,Құрметті Либерт
Dialogue: 0,1:21:01.56,1:21:02.73,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,1:21:03.06,1:21:07.82,Default,,0,0,0,,Ах! Ааа аааа
Dialogue: 0,1:21:08.32,1:21:09.32,Default,,0,0,0,,Ах
Dialogue: 0,1:21:09.44,1:21:12.49,Default,,0,0,0,,Ах, а... а...
Dialogue: 0,1:21:17.70,1:21:18.49,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:21:19.29,1:21:20.04,Default,,0,0,0,,Лиан
Dialogue: 0,1:21:21.37,1:21:22.37,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,1:21:22.91,1:21:23.92,Default,,0,0,0,,Лиан
Dialogue: 0,1:21:26.25,1:21:27.88,Default,,0,0,0,,Жақсы, иә.
Dialogue: 0,1:21:28.17,1:21:32.01,Default,,0,0,0,,Моаның табиғаттан тыс күштері Лианның әкесіне деген сезіміне де әсер етеді.
Dialogue: 0,1:21:32.13,1:21:33.80,Default,,0,0,0,,Мен оған сәйкес келе алмадым.
Dialogue: 0,1:21:34.34,1:21:37.64,Default,,0,0,0,,Лиан, кешіріңіз, әкемді кешіріңіз.
Dialogue: 0,1:21:37.80,1:21:38.76,Default,,0,0,0,,Әке.
Dialogue: 0,1:21:39.14,1:21:40.68,Default,,0,0,0,,Рахмет сізге Фрейя
Dialogue: 0,1:21:41.43,1:21:42.68,Default,,0,0,0,,Жақсы
Dialogue: 0,1:21:43.31,1:21:46.10,Default,,0,0,0,,Командир Либерт, біз не істеп жатырмыз...
Dialogue: 0,1:21:46.65,1:21:48.69,Default,,0,0,0,,Мені мына жігіт айдап жүрді.
Dialogue: 0,1:21:48.82,1:21:50.32,Default,,0,0,0,,Толығырақ! (Бақылаушылар) О...
Dialogue: 0,1:21:54.45,1:21:55.91,Default,,0,0,0,,Дораемон, иә?
Dialogue: 0,1:21:56.32,1:21:57.28,Default,,0,0,0,,Нобита Риан
Dialogue: 0,1:21:57.41,1:21:58.83,Default,,0,0,0,,Горо!
Dialogue: 0,1:21:59.03,1:22:00.24,Default,,0,0,0,,Жаным, амансың ба?
Dialogue: 0,1:22:00.70,1:22:01.91,Default,,0,0,0,,Моа қайда?
Dialogue: 0,1:22:02.04,1:22:03.79,Default,,0,0,0,,Лиан оны жеңді.
Dialogue: 0,1:22:03.91,1:22:05.92,Default,,0,0,0,,Бұл рас па? Жақсы
Dialogue: 0,1:22:06.04,1:22:08.25,Default,,0,0,0,,Сонымен Жер құтқарылды ма?
Dialogue: 0,1:22:08.38,1:22:09.00,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:09.13,1:22:11.21,Default,,0,0,0,,Иә! Нобита-кун
Dialogue: 0,1:22:11.84,1:22:13.38,Default,,0,0,0,,Сізге жақсы, Лиан.
Dialogue: 0,1:22:13.51,1:22:17.14,Default,,0,0,0,,Мен Лианнан естідім. Сізге көп рахмет, Дора-чан.
Dialogue: 0,1:22:17.39,1:22:20.26,Default,,0,0,0,,Дора-чан... Мен Дораемонмын.
Dialogue: 0,1:22:20.39,1:22:24.60,Default,,0,0,0,,Біз ештеңе істемедік. Бұл Лианның батылдығының жеңісі.
Dialogue: 0,1:22:24.94,1:22:27.69,Default,,0,0,0,,Лиан Моа деген кім?
Dialogue: 0,1:22:27.85,1:22:29.23,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,1:22:30.40,1:22:31.90,Default,,0,0,0,,B… Бұл робот болды ма?
Dialogue: 0,1:22:32.03,1:22:34.40,Default,,0,0,0,,Бұл өте қарапайым робот.
Dialogue: 0,1:22:34.90,1:22:36.57,Default,,0,0,0,,Бұл қабық тәрізді
Dialogue: 0,1:22:36.70,1:22:39.87,Default,,0,0,0,,Бұл жігіттің табиғаттан тыс күштері бар екені қызық.
Dialogue: 0,1:22:39.99,1:22:41.37,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:41.70,1:22:42.62,Default,,0,0,0,,Не болды?
Dialogue: 0,1:22:42.74,1:22:45.25,Default,,0,0,0,,Гаяның орбитасы бекініс планетасына қарай бет алды.
Dialogue: 0,1:22:45.79,1:22:47.17,Default,,0,0,0,,Бақыланбайтын
Dialogue: 0,1:22:47.29,1:22:48.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:48.38,1:22:50.67,Default,,0,0,0,,Қосылу кезінде ақау болған шығар.
Dialogue: 0,1:22:51.38,1:22:53.17,Default,,0,0,0,,Гаяға дереу хабарласыңыз.
Dialogue: 0,1:22:57.09,1:22:59.09,Default,,0,0,0,,Бұлай жалғаса берсе, біз планетаға соғылатын боламыз.
Dialogue: 0,1:22:59.39,1:23:01.05,Default,,0,0,0,,Дорэмон, бірдеңе істейік
Dialogue: 0,1:23:01.18,1:23:02.56,Default,,0,0,0,,Бірдеңе болды...
Dialogue: 0,1:23:03.01,1:23:04.72,Default,,0,0,0,,Сіз оны қалай да айналып өте алмайсыз ба?
Dialogue: 0,1:23:05.06,1:23:06.69,Default,,0,0,0,,Дұрыс, Хирари Жадағай.
Dialogue: 0,1:23:07.14,1:23:09.10,Default,,0,0,0,,Иә, жасап көрейік.
Dialogue: 0,1:23:11.77,1:23:14.86,Default,,0,0,0,,А, жоқ, ол қозғалмайтын планеталарда жұмыс істемейді.
Dialogue: 0,1:23:14.99,1:23:16.44,Default,,0,0,0,,Мен қозғалып келе жатқан Гаядан жалтарсам ше?
Dialogue: 0,1:23:16.57,1:23:17.45,Default,,0,0,0,,Иә
Dialogue: 0,1:23:18.15,1:23:21.41,Default,,0,0,0,,А, жоқ, желбіреп тұрған плащ тым кішкентай.
Dialogue: 0,1:23:21.53,1:23:22.95,Default,,0,0,0,,Үлкен жарықпен оны үлкейтіңіз
Dialogue: 0,1:23:23.08,1:23:24.08,Default,,0,0,0,,Иә
Dialogue: 0,1:23:24.79,1:23:28.25,Default,,0,0,0,,А, жоқ, бір үлкен шамның күші жетпейді.
Dialogue: 0,1:23:28.37,1:23:30.00,Default,,0,0,0,,Отын айналарын көптеп жасайық
Dialogue: 0,1:23:30.33,1:23:32.50,Default,,0,0,0,,Нобита-кун Саетеру
Dialogue: 0,1:23:42.10,1:23:43.35,Default,,0,0,0,,Олай болса, келіскендей.
Dialogue: 0,1:23:43.47,1:23:45.39,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,1:23:47.35,1:23:48.77,Default,,0,0,0,,Үлкен жарық!
Dialogue: 0,1:23:48.89,1:23:50.48,Default,,0,0,0,,Бұл... (Нобита) Ешқандай түсіндірместен асығыңыз!
Dialogue: 0,1:23:50.60,1:23:52.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:23:58.65,1:24:00.78,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз
Dialogue: 0,1:24:04.12,1:24:06.20,Default,,0,0,0,,Әр адамда үлкен жарық бар
Dialogue: 0,1:24:06.62,1:24:10.08,Default,,0,0,0,,Мен белгі бергенде, олардың бәрі бірден плащты соқты.
Dialogue: 0,1:24:10.29,1:24:14.00,Default,,0,0,0,,Топтық жұмыс маңызды! Барайық!
Dialogue: 0,1:24:19.59,1:24:21.38,Default,,0,0,0,,Командир Осымен!
Dialogue: 0,1:24:21.80,1:24:25.31,Default,,0,0,0,,Тарих небәрі 300 жылдан кейін аяқтала ма?
Dialogue: 0,1:24:38.99,1:24:40.61,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,1:24:41.03,1:24:41.82,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:24:42.11,1:24:43.03,Default,,0,0,0,,О
Dialogue: 0,1:24:43.36,1:24:44.28,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,1:24:47.04,1:24:48.41,Default,,0,0,0,,Қазір! (Нобита) Үлкен!
Dialogue: 0,1:24:48.54,1:24:50.08,Default,,0,0,0,,Жарық!
Dialogue: 0,1:24:51.92,1:24:54.29,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,1:25:03.68,1:25:05.85,Default,,0,0,0,,Командир Біз соқтығысудан аман қалдық!
Dialogue: 0,1:25:06.26,1:25:07.35,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,1:25:07.60,1:25:09.22,Default,,0,0,0,,Жөндеу жұмыстарын дереу бастайық
Dialogue: 0,1:25:09.35,1:25:10.31,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:15.06,1:25:17.40,Default,,0,0,0,,Жарайсыңдар бәріңе!
Dialogue: 0,1:25:23.82,1:25:25.20,Default,,0,0,0,,Сунео Джиан
Dialogue: 0,1:25:25.32,1:25:26.57,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,1:25:26.91,1:25:28.79,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің бақылауым
Dialogue: 0,1:25:28.91,1:25:30.62,Default,,0,0,0,,Хмм, тамаша!
Dialogue: 0,1:25:31.54,1:25:33.29,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:25:33.46,1:25:34.54,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,1:25:35.29,1:25:37.92,Default,,0,0,0,,Бұрыш құрылғысы түзетілгеннен кейін оны Жерге жіберейік.
Dialogue: 0,1:25:38.21,1:25:39.63,Default,,0,0,0,,О! (шу)
Dialogue: 0,1:25:39.88,1:25:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:42.59,1:25:46.30,Default,,0,0,0,,Фрея, мен саған барлық қоқыстарды алып шығуды айттым.
Dialogue: 0,1:25:46.43,1:25:47.76,Default,,0,0,0,,Бұл қоқыс емес.
Dialogue: 0,1:25:48.30,1:25:50.06,Default,,0,0,0,,Әркім, жер туралы естеліктер
Dialogue: 0,1:25:51.81,1:25:53.69,Default,,0,0,0,,Өйткені біз қоштасып жатырмыз ғой, солай ма?
Dialogue: 0,1:25:54.19,1:25:55.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:56.23,1:25:58.02,Default,,0,0,0,,Шыу!
Dialogue: 0,1:25:58.48,1:25:59.98,Default,,0,0,0,,Ой, не?
Dialogue: 0,1:26:00.28,1:26:01.19,Default,,0,0,0,,Қосымша
Dialogue: 0,1:26:01.32,1:26:03.03,Default,,0,0,0,,Уау
Dialogue: 0,1:26:04.07,1:26:06.03,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:26:06.70,1:26:07.91,Default,,0,0,0,,(Анголмуа айқайы)
Dialogue: 0,1:26:08.62,1:26:12.25,Default,,0,0,0,,Жоқ, менің денемде тым көп, мен оны шығара алмаймын.
Dialogue: 0,1:26:12.37,1:26:15.37,Default,,0,0,0,,Жарайсың, Качинкачин жарық!
Dialogue: 0,1:26:15.58,1:26:17.58,Default,,0,0,0,,Мен сізді басуға мәжбүр етемін
Dialogue: 0,1:26:18.46,1:26:19.96,Default,,0,0,0,,Ой
Dialogue: 0,1:26:20.50,1:26:22.17,Default,,0,0,0,,Бұл көп пе?
Dialogue: 0,1:26:22.30,1:26:23.97,Default,,0,0,0,,Бұл робот емес еді.
Dialogue: 0,1:26:24.38,1:26:27.64,Default,,0,0,0,,Иә, Моаның өзіндік пішіні жоқ.
Dialogue: 0,1:26:27.84,1:26:30.64,Default,,0,0,0,,Бұл жігіт роботтың ішінде болған болуы керек.
Dialogue: 0,1:26:30.89,1:26:32.52,Default,,0,0,0,,Мұнымен не істеуіміз керек?
Dialogue: 0,1:26:32.64,1:26:34.27,Default,,0,0,0,,5 минуттан кейін қалыпты жағдайға оралу
Dialogue: 0,1:26:34.39,1:26:36.10,Default,,0,0,0,,Е! Сонымен—
Dialogue: 0,1:26:36.52,1:26:39.27,Default,,0,0,0,,Кеңістік үшін ұшатын тег!
Dialogue: 0,1:26:39.81,1:26:41.40,Default,,0,0,0,,Жеткізу мекенжайы...
Dialogue: 0,1:26:41.94,1:26:43.94,Default,,0,0,0,,Жеткізу мекенжайы қайда?
Dialogue: 0,1:26:44.53,1:26:47.86,Default,,0,0,0,,Уфуфуфуфуфу қара дыры
Dialogue: 0,1:26:55.41,1:26:57.54,Default,,0,0,0,,Моа деген не болды?
Dialogue: 0,1:26:57.67,1:27:02.84,Default,,0,0,0,,Бәлкім, бұл әркімнің жүрегіндегі зұлымдық массасы шығар.
Dialogue: 0,1:27:04.92,1:27:08.68,Default,,0,0,0,,Баршаңызға, мен тағы да мәлімдеймін
Dialogue: 0,1:27:09.72,1:27:12.72,Default,,0,0,0,,Біз Yggd ағашының ілімдерін ұстанамыз—
Dialogue: 0,1:27:13.06,1:27:17.39,Default,,0,0,0,,Ешбір жағдайда жұлдыздарға күшпен көшуге жол берілмейді.
Dialogue: 0,1:27:18.39,1:27:23.07,Default,,0,0,0,,Біз бейбіт қоныс аударатын планетаны іздеп саяхатымызды жалғастырамыз.
Dialogue: 0,1:27:23.52,1:27:26.11,Default,,0,0,0,,Әлемнің бір жерінде, сөзсіз...
Dialogue: 0,1:27:26.24,1:27:29.11,Default,,0,0,0,,Менің үйге қоңырау шалуымды күтіп тұрған бір жұлдыз болуы керек.
Dialogue: 0,1:27:30.24,1:27:35.83,Default,,0,0,0,,Біздің саяхатымыз – болашаққа деген үмітке саяхат.
Dialogue: 0,1:27:57.85,1:28:00.35,Default,,0,0,0,,Мына әдемі жерді қорға
Dialogue: 0,1:28:00.85,1:28:03.73,Default,,0,0,0,,Лагуна планетасының трагедиясының қайталануын болдырмау үшін
Dialogue: 0,1:28:04.36,1:28:06.19,Default,,0,0,0,,Иә, мен бар күшімді саламын.
Dialogue: 0,1:28:06.32,1:28:08.90,Default,,0,0,0,,Мен де істеймін. (Сунео) Маған қалдырыңыз.
Dialogue: 0,1:28:09.03,1:28:11.11,Default,,0,0,0,,Қош бол Лиан, аман-саусың деп үміттенемін.
Dialogue: 0,1:28:11.57,1:28:14.12,Default,,0,0,0,,Керемет жұлдызды табатыныңызға сенімдімін
Dialogue: 0,1:28:14.66,1:28:18.25,Default,,0,0,0,,Сіз оны табатыныңызға сенімдімін
Dialogue: 0,1:28:18.41,1:28:21.12,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:28:29.05,1:28:30.72,Default,,0,0,0,,Сіз Жерге оралдыңыз, солай емес пе?
Dialogue: 0,1:28:30.84,1:28:31.59,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:28:31.72,1:28:32.76,Default,,0,0,0,,Иә (Нобита) Иә!
Dialogue: 0,1:28:33.01,1:28:34.85,Default,,0,0,0,,Үйдемін!
Dialogue: 0,1:28:35.39,1:28:36.81,Default,,0,0,0,,Содан кейін кездескенше.
Dialogue: 0,1:28:36.93,1:28:38.85,Default,,0,0,0,,Қош бол, қызық болды.
Dialogue: 0,1:28:39.06,1:28:40.18,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,1:28:40.35,1:28:42.73,Default,,0,0,0,,Бұл тағы бір иллюзияшыл жұлдыз болды.
Dialogue: 0,1:28:43.06,1:28:45.48,Default,,0,0,0,,Е, мүмкін емес.
Dialogue: 0,1:28:45.65,1:28:47.57,Default,,0,0,0,,Қолдану... Sensei
Dialogue: 0,1:28:48.15,1:28:51.03,Default,,0,0,0,,Ноби-кун Иә, мен өткен күні тест тапсырдым.
Dialogue: 0,1:28:51.70,1:28:53.61,Default,,0,0,0,,Тест? Эх!
Dialogue: 0,1:28:53.74,1:28:55.62,Default,,0,0,0,,Қайталау… 0 ұпай!
Dialogue: 0,1:28:55.78,1:28:57.24,Default,,0,0,0,,Жақсы
Dialogue: 0,1:28:57.37,1:28:58.75,Default,,0,0,0,,Уау, ия (Нобита) Бұл иллюзия емес.
Dialogue: 0,1:28:58.87,1:29:00.33,Default,,0,0,0,,Сізге жақсы (мұғалім)
Dialogue: 0,1:29:00.46,1:29:01.58,Default,,0,0,0,,«Жақсы» деген не болды?
Dialogue: 0,1:29:01.75,1:29:03.21,Default,,0,0,0,,Мен білемін, білемін
Dialogue: 0,1:29:03.33,1:29:05.75,Default,,0,0,0,,Мен қазір қуаныштымын.
Dialogue: 0,1:29:05.88,1:29:07.38,Default,,0,0,0,,Эй!
Dialogue: 0,1:29:11.63,1:29:17.64,Default,,0,0,0,,♪〜
Dialogue: 0,1:32:34.13,1:32:40.13,Default,,0,0,0,,〜♪
