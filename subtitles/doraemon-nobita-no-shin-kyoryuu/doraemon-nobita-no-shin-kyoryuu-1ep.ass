Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.57,0:00:43.54,Default,,0,0,0,,(қатты аяқ дыбыстары)
Dialogue: 0,0:00:52.17,0:00:54.80,Default,,0,0,0,,Уау! Бұл Аламосавр!
Dialogue: 0,0:00:54.88,0:00:57.55,Default,,0,0,0,,Птеранодон ұшып келеді!
Dialogue: 0,0:00:57.64,0:01:00.31,Default,,0,0,0,,Қараңдар, Спинозавр.
Dialogue: 0,0:01:00.81,0:01:04.23,Default,,0,0,0,,У~хаха тамаша~!
Dialogue: 0,0:01:05.60,0:01:06.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:07.81,0:01:09.65,Default,,0,0,0,,Бұл трицератопс!
Dialogue: 0,0:01:11.73,0:01:13.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:13.69,0:01:15.99,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:01:17.36,0:01:18.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:20.20,0:01:21.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:21.99,0:01:23.75,Default,,0,0,0,,Тететете…
Dialogue: 0,0:01:23.83,0:01:25.58,Default,,0,0,0,,Сіздің қолыңызға не болды?
Dialogue: 0,0:01:26.83,0:01:29.75,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:01:30.75,0:01:31.80,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:01:31.88,0:01:35.01,Default,,0,0,0,,Тиранозавр~?
Dialogue: 0,0:01:35.09,0:01:36.51,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:01:36.59,0:01:39.34,Default,,0,0,0,,Дододо... Дораемон!
Dialogue: 0,0:01:40.26,0:01:42.22,Default,,0,0,0,,Қонақтарымызға...
Dialogue: 0,0:01:43.43,0:01:45.18,Default,,0,0,0,,Бұл ағаға не болды?
Dialogue: 0,0:01:45.27,0:01:47.52,Default,,0,0,0,,Хехе, мен сәл таң қалдым.
Dialogue: 0,0:01:47.60,0:01:49.44,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:01:49.52,0:01:53.90,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:01:53.98,0:01:56.65,Default,,0,0,0,,Қойылым арнайы көрме залында өтеді.
Dialogue: 0,0:01:56.74,0:01:59.03,Default,,0,0,0,,Нобита-сан, жақсысың ба?
Dialogue: 0,0:01:59.11,0:02:02.24,Default,,0,0,0,,Эй Нобита, сен неден қорқасың?
Dialogue: 0,0:02:02.33,0:02:05.25,Default,,0,0,0,,Нағыз динозаврлар болуы мүмкін емес!
Dialogue: 0,0:02:05.33,0:02:07.00,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:02:07.08,0:02:09.37,Default,,0,0,0,,Сіз мұны түсінбейсіз!
Dialogue: 0,0:02:09.46,0:02:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:10.58,0:02:13.50,Default,,0,0,0,,Иә? Сіз не айттыңыз?
Dialogue: 0,0:02:13.59,0:02:18.38,Default,,0,0,0,,Бұл дүниеде әлі де динозаврлар болуы мүмкін!
Dialogue: 0,0:02:18.47,0:02:21.05,Default,,0,0,0,,Сәлем Ноби Чан
Dialogue: 0,0:02:21.14,0:02:25.93,Default,,0,0,0,,Динозаврлар 66 миллион жыл бұрын жойылып кеткен.
Dialogue: 0,0:02:26.02,0:02:28.23,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:02:28.31,0:02:33.19,Default,,0,0,0,,Жерге үлкен метеорит түсіп, ол жойылды.
Dialogue: 0,0:02:34.48,0:02:36.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:36.40,0:02:37.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:40.91,0:02:43.62,Default,,0,0,0,,Сода өте сергітеді!
Dialogue: 0,0:02:47.91,0:02:50.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:50.12,0:02:51.71,Default,,0,0,0,,Мен… солай болар деп ойлаймын…
Dialogue: 0,0:02:56.30,0:02:57.96,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:02:58.05,0:03:00.18,Default,,0,0,0,,Бұл Элазмосавр!
Dialogue: 0,0:03:00.26,0:03:01.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.43,0:03:10.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.28,0:03:26.41,Default,,0,0,0,,Ах
Dialogue: 0,0:03:27.99,0:03:30.62,Default,,0,0,0,,Нобита-сан (Нобита) А... Иә!
Dialogue: 0,0:03:36.92,0:03:39.46,Default,,0,0,0,,Иә! Хмм...
Dialogue: 0,0:03:39.55,0:03:41.22,Default,,0,0,0,,Иә? (Сунео) Иә?
Dialogue: 0,0:03:44.47,0:03:46.68,Default,,0,0,0,,Кейбір (Динозавр дәрігері) қайсысы бар?
Dialogue: 0,0:03:46.76,0:03:48.31,Default,,0,0,0,,Міне.
Dialogue: 0,0:03:48.39,0:03:51.14,Default,,0,0,0,,Әй, бұл қосжақпа сүйек.
Dialogue: 0,0:03:51.23,0:03:52.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:52.73,0:03:55.02,Default,,0,0,0,,Керемет Джан! Маған көрсет
Dialogue: 0,0:03:55.10,0:03:57.44,Default,,0,0,0,,Сіз тапқан кез келген қазбаны үйге апара аласыз.
Dialogue: 0,0:03:58.23,0:03:59.23,Default,,0,0,0,,Соңғы бес жылда
Dialogue: 0,0:03:59.32,0:04:03.11,Default,,0,0,0,,Жапонияда динозаврдың қалдықтары бірінен соң бірі табылуда.
Dialogue: 0,0:04:03.20,0:04:06.41,Default,,0,0,0,,Жапония динозаврлар патшалығы болуы мүмкін.
Dialogue: 0,0:04:06.49,0:04:08.49,Default,,0,0,0,,Ху (Нобита) Ах!
Dialogue: 0,0:04:08.58,0:04:11.83,Default,,0,0,0,,Мм, бұл динозавр қазбалары, солай ма?
Dialogue: 0,0:04:12.50,0:04:13.96,Default,,0,0,0,,Уа, бұл керемет!
Dialogue: 0,0:04:14.04,0:04:16.17,Default,,0,0,0,,Иә? (Динозавр дәрігері) Айнымас динозавр...
Dialogue: 0,0:04:16.25,0:04:17.17,Default,,0,0,0,,Өтірік
Dialogue: 0,0:04:17.25,0:04:19.34,Default,,0,0,0,,Сіз оны басып кеткен болуыңыз мүмкін. Бұл жай ғана тас.
Dialogue: 0,0:04:19.42,0:04:20.88,Default,,0,0,0,,Зуко!
Dialogue: 0,0:04:22.05,0:04:26.34,Default,,0,0,0,,Нобита динозаврдың қазбасын таба алмайды.
Dialogue: 0,0:04:26.43,0:04:29.35,Default,,0,0,0,,Сіз иттің нәжісін таба аласыз!
Dialogue: 0,0:04:29.43,0:04:30.89,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:30.97,0:04:33.23,Default,,0,0,0,,Бұл қазба тәрізді!
Dialogue: 0,0:04:34.31,0:04:35.98,Default,,0,0,0,,Мен мәлімдеймін!
Dialogue: 0,0:04:36.48,0:04:40.32,Default,,0,0,0,,Біз қазбаны емес, тірі динозаврды табамыз!
Dialogue: 0,0:04:40.40,0:04:41.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:41.94,0:04:44.03,Default,,0,0,0,,Ху... Нобита-сан...
Dialogue: 0,0:04:48.07,0:04:49.37,Default,,0,0,0,,Иә, бұрылды
Dialogue: 0,0:04:49.45,0:04:53.04,Default,,0,0,0,,Егер мен оны таба алмасам ше?
Dialogue: 0,0:04:53.12,0:04:54.91,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:04:55.00,0:04:56.12,Default,,0,0,0,,Мен…
Dialogue: 0,0:04:56.21,0:04:59.09,Default,,0,0,0,,Жержаңғақты көзіммен шайнаймын!
Dialogue: 0,0:05:00.09,0:05:02.76,Default,,0,0,0,,Гуфуфуфуфу гахахаха
Dialogue: 0,0:05:02.84,0:05:04.30,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:05:04.97,0:05:06.63,Default,,0,0,0,,А, мен оны асыға күтемін!
Dialogue: 0,0:05:06.72,0:05:09.39,Default,,0,0,0,,Олар тіпті бейне дәлелдемелерді де алды!
Dialogue: 0,0:05:09.47,0:05:10.72,Default,,0,0,0,,Осындай күйде Рух толқындарына шоғырлана алмаймын
Dialogue: 0,0:05:10.81,0:05:14.02,Default,,0,0,0,,Міндетті түрде тірі динозаврды тауып, оларға ғашық болыңыз...
Dialogue: 0,0:05:14.10,0:05:16.35,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:05:16.98,0:05:18.06,Default,,0,0,0,,Әлемде
Dialogue: 0,0:05:18.15,0:05:21.77,Default,,0,0,0,,Әлі ашылмаған көптеген динозаврлар бар.
Dialogue: 0,0:05:21.86,0:05:25.57,Default,,0,0,0,,Ол эволюция процесінде болуы керек, бірақ ол әлі табылған жоқ.
Dialogue: 0,0:05:25.65,0:05:27.03,Default,,0,0,0,,Гахун
Dialogue: 0,0:05:27.78,0:05:29.28,Default,,0,0,0,,Сіз —
Dialogue: 0,0:05:29.37,0:05:30.58,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:32.37,0:05:35.29,Default,,0,0,0,,Осы жетіспейтін сілтемені толтыратын жаңа динозавр
Dialogue: 0,0:05:35.37,0:05:39.04,Default,,0,0,0,,Мүмкін тауып аларсыңдар.
Dialogue: 0,0:05:41.09,0:05:43.38,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:05:43.46,0:05:44.67,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:05:44.76,0:05:48.26,Default,,0,0,0,,Ол сіздің атыңызға динозаврға айналуы мүмкін.
Dialogue: 0,0:05:52.56,0:05:54.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:54.97,0:05:56.31,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:00.31,0:06:01.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:01.27,0:06:02.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:03.02,0:06:05.07,Default,,0,0,0,,Уфуфу Ахаха!
Dialogue: 0,0:06:05.15,0:06:06.65,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:06:07.36,0:06:09.07,Default,,0,0,0,,Дораемон Дораемон!
Dialogue: 0,0:06:09.16,0:06:10.53,Default,,0,0,0,,Дораемон Дораемон Дораемон
Dialogue: 0,0:06:10.62,0:06:12.58,Default,,0,0,0,,Дораемон Дораемон!
Dialogue: 0,0:06:15.91,0:06:17.71,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:06:17.79,0:06:20.88,Default,,0,0,0,,Уау, уау, ә...
Dialogue: 0,0:06:20.96,0:06:22.54,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:06:23.92,0:06:24.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:48.00,0:07:50.59,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:07:50.67,0:07:52.59,Default,,0,0,0,,Динозавр жұмыртқасы?
Dialogue: 0,0:07:52.68,0:07:54.30,Default,,0,0,0,,Да~хахаха!
Dialogue: 0,0:07:54.39,0:07:56.05,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:56.14,0:07:59.06,Default,,0,0,0,,Таза немесе қарапайым!
Dialogue: 0,0:07:59.14,0:08:02.06,Default,,0,0,0,,Қайтарыңыз! бұл өлшемді пішін
Dialogue: 0,0:08:02.14,0:08:04.98,Default,,0,0,0,,Қайдан қарасаңыз да, бұл динозавр жұмыртқасы!
Dialogue: 0,0:08:05.06,0:08:06.90,Default,,0,0,0,,Міне, сол тазалық
Dialogue: 0,0:08:06.98,0:08:09.90,Default,,0,0,0,,Сізде жақсы нәрсе - сізде жақсы.
Dialogue: 0,0:08:09.98,0:08:12.20,Default,,0,0,0,,Бірақ.
Dialogue: 0,0:08:12.28,0:08:15.11,Default,,0,0,0,,Оның динозавр жұмыртқасы екенін қайдан білуге ​​болады?
Dialogue: 0,0:08:15.20,0:08:17.12,Default,,0,0,0,,Бұл жай ғана тас болуы мүмкін.
Dialogue: 0,0:08:17.74,0:08:20.58,Default,,0,0,0,,Қазба болса да, көне ағаштың жемісі шығар...
Dialogue: 0,0:08:20.66,0:08:22.91,Default,,0,0,0,,Бұл Науман пілінің тезегі болуы мүмкін.
Dialogue: 0,0:08:23.00,0:08:25.17,Default,,0,0,0,,Біртүрлі нәрсе айтыңыз
Dialogue: 0,0:08:25.75,0:08:26.58,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:08:26.67,0:08:30.00,Default,,0,0,0,,Растау үшін «Уақыт Фурошики» шығарыңыз!
Dialogue: 0,0:08:30.09,0:08:31.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:31.38,0:08:34.05,Default,,0,0,0,,Егер сіз оны «уақыт фурошикіне» орап, уақытты кері айналдырсаңыз
Dialogue: 0,0:08:34.13,0:08:37.51,Default,,0,0,0,,Сіз бұл динозавр жұмыртқасы екенін айта аласыз!
Dialogue: 0,0:08:37.60,0:08:38.97,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:08:39.06,0:08:42.77,Default,,0,0,0,,Егер ол шынымен динозавр жұмыртқасы болып шықса, не істер едің?
Dialogue: 0,0:08:42.85,0:08:45.19,Default,,0,0,0,,Мен оны көтеремін!
Dialogue: 0,0:08:45.77,0:08:48.23,Default,,0,0,0,,Нобита-кун мұны істей алмайды.
Dialogue: 0,0:08:48.31,0:08:49.73,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:49.82,0:08:51.78,Default,,0,0,0,,Тірі заттарды өсіру деген нені білдіреді?
Dialogue: 0,0:08:51.86,0:08:54.45,Default,,0,0,0,,Бұл сіз ойлағандай оңай емес.
Dialogue: 0,0:08:55.15,0:08:58.62,Default,,0,0,0,,Ал динозаврлар жойылып кеткен әлемде оларды қалай өсіруге болады?
Dialogue: 0,0:08:58.70,0:09:00.70,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:09:00.79,0:09:03.79,Default,,0,0,0,,Мен мұндай арман сияқты нәрсені ойластырмас бұрын
Dialogue: 0,0:09:03.87,0:09:06.25,Default,,0,0,0,,Мен өзіме қамқорлық жасай алғым келеді...
Dialogue: 0,0:09:06.33,0:09:07.46,Default,,0,0,0,,Футто!
Dialogue: 0,0:09:07.54,0:09:08.29,Default,,0,0,0,,А, маған дораякиімді қайтар!
Dialogue: 0,0:09:08.29,0:09:09.71,Default,,0,0,0,,А, маған дораякиімді қайтар!
Dialogue: 0,0:09:08.29,0:09:09.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:09.79,0:09:11.25,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:09:11.34,0:09:15.42,Default,,0,0,0,,Дораемонның да динозавр жұмыртқасы екеніне сенесіз бе?
Dialogue: 0,0:09:15.51,0:09:17.59,Default,,0,0,0,,Жоқ... жоқ...
Dialogue: 0,0:09:17.68,0:09:20.55,Default,,0,0,0,,Маған сенбесеңіз, «Тайме Фурошикиді» беріңіз!
Dialogue: 0,0:09:20.64,0:09:23.22,Default,,0,0,0,,Бұл бәрібір тезекке айналады.
Dialogue: 0,0:09:23.85,0:09:24.89,Default,,0,0,0,,Я...
Dialogue: 0,0:09:25.85,0:09:27.23,Default,,0,0,0,,Ntt…
Dialogue: 0,0:09:27.31,0:09:29.73,Default,,0,0,0,,«Уақыт Фурошики»!
Dialogue: 0,0:09:35.15,0:09:36.20,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:09:37.32,0:09:40.20,Default,,0,0,0,,Хмм... мм? (сағат дыбысы)
Dialogue: 0,0:09:40.87,0:09:42.33,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:42.41,0:09:44.16,Default,,0,0,0,,Мен күте алмаймын!
Dialogue: 0,0:09:44.25,0:09:46.75,Default,,0,0,0,,Бұл трицератоптар ма? Брахиозавр?
Dialogue: 0,0:09:46.83,0:09:48.42,Default,,0,0,0,,Тіпті Науман пілінің тезегі
Dialogue: 0,0:09:48.50,0:09:51.21,Default,,0,0,0,,Мүмкін бұл Тиранозавр рекс болуы мүмкін
Dialogue: 0,0:09:51.29,0:09:54.30,Default,,0,0,0,,Анашым! Бүгін кешкі асқа не бар?
Dialogue: 0,0:09:56.72,0:09:58.01,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:09:58.09,0:09:59.34,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:09:59.43,0:10:00.85,Default,,0,0,0,,Әй, ыстық.
Dialogue: 0,0:10:00.93,0:10:04.56,Default,,0,0,0,,(Сағат дыбысы)
Dialogue: 0,0:10:13.07,0:10:14.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:16.57,0:10:19.57,Default,,0,0,0,,Иә? ештеңе өзгерген жоқ
Dialogue: 0,0:10:21.53,0:10:24.62,Default,,0,0,0,,Бәлкім, бұл тас болған шығар.
Dialogue: 0,0:10:24.70,0:10:27.62,Default,,0,0,0,,Нобита-кун да дұрыс ұйықтайды.
Dialogue: 0,0:10:27.71,0:10:29.62,Default,,0,0,0,,Қайырлы түн (Нобита) Иә
Dialogue: 0,0:10:29.71,0:10:31.50,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:10:32.59,0:10:33.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:40.76,0:10:42.97,Default,,0,0,0,,(Жақсы ызылдау)
Dialogue: 0,0:10:55.11,0:10:56.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:02.91,0:11:05.70,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:11:11.46,0:11:13.63,Default,,0,0,0,,Нобита, оян.
Dialogue: 0,0:11:13.71,0:11:16.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:17.17,0:11:21.30,Default,,0,0,0,,Хмм, қытықтайды, Дораемон
Dialogue: 0,0:11:22.68,0:11:23.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:23.89,0:11:25.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.06,0:11:30.18,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:11:31.10,0:11:31.94,Default,,0,0,0,,Көзілдірік Көзілдірік…
Dialogue: 0,0:11:33.52,0:11:36.15,Default,,0,0,0,,Не болды, Нобита-кун?
Dialogue: 0,0:11:36.23,0:11:37.90,Default,,0,0,0,,Хмм... иә!
Dialogue: 0,0:11:46.53,0:11:48.29,Default,,0,0,0,,Агага...
Dialogue: 0,0:11:49.37,0:11:50.83,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:11:50.91,0:11:53.96,Default,,0,0,0,,Жоқ, оның динозавр екені әлі шешілген жоқ...
Dialogue: 0,0:11:55.67,0:11:56.88,Default,,0,0,0,,Туылды!
Dialogue: 0,0:11:56.96,0:11:58.55,Default,,0,0,0,,Ыстық суды қайнату керек!
Dialogue: 0,0:11:58.63,0:12:00.63,Default,,0,0,0,,Жедел жәрдем жедел жәрдем! ммм...
Dialogue: 0,0:12:00.72,0:12:02.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:02.38,0:12:04.59,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:12:05.51,0:12:06.93,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:12:07.01,0:12:08.22,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:12:09.10,0:12:10.77,Default,,0,0,0,,Уау, уау, ах, иә.
Dialogue: 0,0:12:14.44,0:12:15.56,Default,,0,0,0,,Му~!
Dialogue: 0,0:12:15.65,0:12:18.23,Default,,0,0,0,,Меу... Мия~!
Dialogue: 0,0:12:22.24,0:12:23.24,Default,,0,0,0,,Динозаврлар!
Dialogue: 0,0:12:23.32,0:12:25.91,Default,,0,0,0,,Му~ Му~
Dialogue: 0,0:12:26.32,0:12:27.20,Default,,0,0,0,,Mu…
Dialogue: 0,0:12:27.28,0:12:28.37,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:12:29.91,0:12:32.62,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:12:32.71,0:12:33.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.33,0:12:38.17,Default,,0,0,0,,Иә? (Нобита) А...
Dialogue: 0,0:12:42.26,0:12:44.43,Default,,0,0,0,,Ах... Дораемон
Dialogue: 0,0:12:47.09,0:12:49.01,Default,,0,0,0,,Кю… Кю~
Dialogue: 0,0:12:49.10,0:12:49.93,Default,,0,0,0,,Cu?
Dialogue: 0,0:12:50.93,0:12:51.93,Default,,0,0,0,,Кю~
Dialogue: 0,0:12:52.02,0:12:53.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:55.35,0:12:57.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:58.81,0:12:59.98,Default,,0,0,0,,Cu…
Dialogue: 0,0:13:00.07,0:13:01.40,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:13:01.48,0:13:03.11,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:13:07.24,0:13:08.20,Default,,0,0,0,,О, егіздер
Dialogue: 0,0:13:08.28,0:13:11.04,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:13:11.12,0:13:12.83,Default,,0,0,0,,«Уақыт Фурошикиге» рахмет
Dialogue: 0,0:13:12.91,0:13:16.04,Default,,0,0,0,,Жұмыртқа ішінде динозавр егіздері өсті.
Dialogue: 0,0:13:16.12,0:13:17.42,Default,,0,0,0,,Му~!
Dialogue: 0,0:13:17.50,0:13:20.04,Default,,0,0,0,,Бұл аздап қауіпті.
Dialogue: 0,0:13:20.13,0:13:22.76,Default,,0,0,0,,Уау, мен қазірдің өзінде жүрмін
Dialogue: 0,0:13:22.84,0:13:25.38,Default,,0,0,0,,Хмм... бұл бала шықпайды.
Dialogue: 0,0:13:26.47,0:13:28.05,Default,,0,0,0,,Cu…
Dialogue: 0,0:13:29.55,0:13:31.06,Default,,0,0,0,,Ах
Dialogue: 0,0:13:31.76,0:13:32.81,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:32.89,0:13:34.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:34.48,0:13:36.52,Default,,0,0,0,,Кю... Кю?
Dialogue: 0,0:13:37.14,0:13:40.73,Default,,0,0,0,,Қара, қорықпа, шық.
Dialogue: 0,0:13:40.82,0:13:42.15,Default,,0,0,0,,Cu…
Dialogue: 0,0:13:42.65,0:13:44.19,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:13:44.28,0:13:46.07,Default,,0,0,0,,Кю Кю…
Dialogue: 0,0:13:46.15,0:13:47.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:51.74,0:13:53.74,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:13:55.58,0:13:57.67,Default,,0,0,0,,Өте жылы
Dialogue: 0,0:13:57.75,0:13:59.12,Default,,0,0,0,,Кю~!
Dialogue: 0,0:14:00.13,0:14:01.25,Default,,0,0,0,,Кю~?
Dialogue: 0,0:14:01.34,0:14:04.88,Default,,0,0,0,,Түсіндім, сенің атың Кю!
Dialogue: 0,0:14:05.51,0:14:06.76,Default,,0,0,0,,Кю~?
Dialogue: 0,0:14:06.84,0:14:08.34,Default,,0,0,0,,Кю~!
Dialogue: 0,0:14:09.39,0:14:10.34,Default,,0,0,0,,Му...
Dialogue: 0,0:14:10.43,0:14:12.64,Default,,0,0,0,,Ал сен Мусың
Dialogue: 0,0:14:13.31,0:14:15.06,Default,,0,0,0,,Кью және му?
Dialogue: 0,0:14:15.14,0:14:16.27,Default,,0,0,0,,Вата! (Нобита) Қараңдар!
Dialogue: 0,0:14:16.35,0:14:19.77,Default,,0,0,0,,Кішкентай қанаттар өсіп жатыр! Сондай сүйкімді
Dialogue: 0,0:14:19.85,0:14:22.27,Default,,0,0,0,,Ол қандай динозавр?
Dialogue: 0,0:14:22.36,0:14:25.23,Default,,0,0,0,,Білейік...
Dialogue: 0,0:14:25.32,0:14:27.99,Default,,0,0,0,,«Әлемнің толық энциклопедиясы»!
Dialogue: 0,0:14:28.53,0:14:30.28,Default,,0,0,0,,Қанатты динозаврлар туралы айту
Dialogue: 0,0:14:30.36,0:14:33.58,Default,,0,0,0,,Дейоних пен дромеозавр...
Dialogue: 0,0:14:33.66,0:14:36.37,Default,,0,0,0,,Хмм, бұл емес. А, бұл да басқа.
Dialogue: 0,0:14:36.45,0:14:38.25,Default,,0,0,0,,Ал, жақсы... Иә?
Dialogue: 0,0:14:39.42,0:14:40.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:42.00,0:14:44.55,Default,,0,0,0,,Мұндай динозавр жоқ.
Dialogue: 0,0:14:44.63,0:14:45.46,Default,,0,0,0,,Кю~?
Dialogue: 0,0:14:46.09,0:14:48.42,Default,,0,0,0,,Бұл динозаврдың жаңа түрі болуы керек!
Dialogue: 0,0:14:48.51,0:14:50.43,Default,,0,0,0,,Олай болса, бұл тамаша жаңалық!
Dialogue: 0,0:14:51.05,0:14:54.14,Default,,0,0,0,,Новисаврдың атын қою! Уухаха!
Dialogue: 0,0:14:54.22,0:14:57.68,Default,,0,0,0,,Бірақ Нобита-кун, біз оны осында ұстай алмаймыз.
Dialogue: 0,0:14:57.77,0:15:01.69,Default,,0,0,0,,Егер анам немесе басқа біреу білсе, сіз үлкен қиындыққа тап боласыз.
Dialogue: 0,0:15:03.40,0:15:05.40,Default,,0,0,0,,Жоқ! Мен оны сақтағым келеді
Dialogue: 0,0:15:06.07,0:15:08.69,Default,,0,0,0,,Джан мен Сунеоны өсіріңіз
Dialogue: 0,0:15:08.78,0:15:10.57,Default,,0,0,0,,Оларды айқайлатыңыз!
Dialogue: 0,0:15:10.65,0:15:15.03,Default,,0,0,0,,Өтінемін, Дораемон, тағы да, жарай ма?
Dialogue: 0,0:15:15.12,0:15:17.20,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:15:17.29,0:15:18.70,Default,,0,0,0,,С… Сүйкімді
Dialogue: 0,0:15:18.79,0:15:21.46,Default,,0,0,0,,Көрдіңіз бе? Жақсы емес пе?
Dialogue: 0,0:15:21.54,0:15:23.96,Default,,0,0,0,,Әй... мен есейгенше!
Dialogue: 0,0:15:24.04,0:15:25.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:25.09,0:15:26.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:26.46,0:15:29.59,Default,,0,0,0,,Құрметпен Cue! Му!
Dialogue: 0,0:15:29.67,0:15:30.80,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:30.88,0:15:32.18,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:15:32.26,0:15:34.22,Default,,0,0,0,,Му~!
Dialogue: 0,0:15:38.68,0:15:40.89,Default,,0,0,0,,Ас бергеніңізге рахмет... Ах
Dialogue: 0,0:15:40.98,0:15:43.85,Default,,0,0,0,,Тез жейсің, не болды?
Dialogue: 0,0:15:43.94,0:15:45.69,Default,,0,0,0,,Иә әке, рахмет
Dialogue: 0,0:15:45.77,0:15:48.07,Default,,0,0,0,,Ноби-чан, сен жасыл бұрышты қалдырдың.
Dialogue: 0,0:15:48.15,0:15:49.36,Default,,0,0,0,,Мен оны жедім~
Dialogue: 0,0:15:49.44,0:15:52.20,Default,,0,0,0,,Анашым, мен де мисо сорпасынан тағы бір көмек аламын!
Dialogue: 0,0:15:52.28,0:15:53.41,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:55.03,0:15:57.53,Default,,0,0,0,,О, мен оны күткендей қалдырамын!
Dialogue: 0,0:15:58.24,0:15:59.83,Default,,0,0,0,,Таңдаушы болмаңыз!
Dialogue: 0,0:15:59.91,0:16:01.71,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет! (есік жабылған дыбыс)
Dialogue: 0,0:16:01.79,0:16:03.00,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:16:03.08,0:16:06.54,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:16:06.63,0:16:07.71,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:08.42,0:16:09.92,Default,,0,0,0,,Хмф
Dialogue: 0,0:16:11.26,0:16:13.88,Default,,0,0,0,,Му~! Му~
Dialogue: 0,0:16:13.97,0:16:16.64,Default,,0,0,0,,Сіздің қарныңыз ашты ма? Тамақ
Dialogue: 0,0:16:17.14,0:16:18.43,Default,,0,0,0,,Му~!
Dialogue: 0,0:16:19.01,0:16:20.56,Default,,0,0,0,,Жедім!
Dialogue: 0,0:16:20.64,0:16:21.98,Default,,0,0,0,,Қараңдар, сен де көрсет.
Dialogue: 0,0:16:22.81,0:16:23.64,Default,,0,0,0,,Cu?
Dialogue: 0,0:16:23.73,0:16:25.23,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:16:25.31,0:16:26.31,Default,,0,0,0,,Кю!
Dialogue: 0,0:16:26.40,0:16:28.23,Default,,0,0,0,,Иә? Тамақ ішпейсің бе?
Dialogue: 0,0:16:28.32,0:16:30.03,Default,,0,0,0,,Дәмді болса да
Dialogue: 0,0:16:30.11,0:16:32.44,Default,,0,0,0,,Сонда... Иә!
Dialogue: 0,0:16:32.53,0:16:34.24,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:16:34.32,0:16:35.82,Default,,0,0,0,,Кю! (Му) Му~!
Dialogue: 0,0:16:35.91,0:16:38.28,Default,,0,0,0,,Му жесе де...
Dialogue: 0,0:16:38.87,0:16:40.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:41.16,0:16:42.25,Default,,0,0,0,,Кю! (Му) Му~!
Dialogue: 0,0:16:43.04,0:16:44.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:44.50,0:16:45.67,Default,,0,0,0,,Кю! (Му) Му~!
Dialogue: 0,0:16:45.75,0:16:46.67,Default,,0,0,0,,Иә (көрсеткіш) белгі!
Dialogue: 0,0:16:46.75,0:16:47.58,Default,,0,0,0,,Му~!
Dialogue: 0,0:16:47.67,0:16:48.96,Default,,0,0,0,,Кю! (Му) Му~!
Dialogue: 0,0:16:47.67,0:16:48.96,Default,,0,0,0,,Иә
Dialogue: 0,0:16:49.04,0:16:50.09,Default,,0,0,0,,Кю! (Му) Му~!
Dialogue: 0,0:16:49.04,0:16:50.09,Default,,0,0,0,,Иә
Dialogue: 0,0:16:50.17,0:16:51.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:51.38,0:16:54.01,Default,,0,0,0,,Тапсырма! Маған дұрыс тамақтану керек
Dialogue: 0,0:16:54.09,0:16:55.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:55.84,0:16:58.47,Default,,0,0,0,,Му жейді, бірақ Кю жемейді.
Dialogue: 0,0:16:58.55,0:17:00.51,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:17:00.60,0:17:02.27,Default,,0,0,0,,Шықыр! О, тәңірім
Dialogue: 0,0:17:02.35,0:17:04.35,Default,,0,0,0,,Мен енді білмеймін
Dialogue: 0,0:17:04.85,0:17:05.85,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:17:05.94,0:17:09.11,Default,,0,0,0,,Оны өсіргім келетінін айтқан Нобита болды ғой?
Dialogue: 0,0:17:09.19,0:17:10.36,Default,,0,0,0,,Кю~
Dialogue: 0,0:17:10.44,0:17:12.86,Default,,0,0,0,,Олар ұқсас.
Dialogue: 0,0:17:13.53,0:17:15.28,Default,,0,0,0,,Кім және кім?
Dialogue: 0,0:17:15.36,0:17:18.66,Default,,0,0,0,,Нобита-кун мен үшін ата-ана сияқты.
Dialogue: 0,0:17:18.74,0:17:21.20,Default,,0,0,0,,Бұл туралы ойланыңыз.
Dialogue: 0,0:17:24.66,0:17:27.37,Default,,0,0,0,,Динозаврлар немен қоректенеді?
Dialogue: 0,0:17:27.46,0:17:29.96,Default,,0,0,0,,Сіз қайда тұрдыңыз?
Dialogue: 0,0:17:30.04,0:17:31.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:32.55,0:17:33.59,Default,,0,0,0,,О
Dialogue: 0,0:17:33.67,0:17:35.97,Default,,0,0,0,,Бұл өсімдік қалдықтары.
Dialogue: 0,0:17:36.05,0:17:38.59,Default,,0,0,0,,Уау, өте әдемі! (Нобита) Бұл!
Dialogue: 0,0:17:39.18,0:17:40.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:40.14,0:17:43.02,Default,,0,0,0,,Маған динозаврларды қалай өсіру керектігін айтыңызшы!
Dialogue: 0,0:17:43.10,0:17:44.64,Default,,0,0,0,,Қалай көтеру керек?
Dialogue: 0,0:17:44.73,0:17:48.27,Default,,0,0,0,,Сен қандай ұяда жатасың? Сіз қандай тағам жейсіз?
Dialogue: 0,0:17:49.90,0:17:51.27,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:51.36,0:17:54.99,Default,,0,0,0,,Динозаврларға жыртқыштар да, өсімдік жегіштер де жатады.
Dialogue: 0,0:17:55.07,0:17:56.86,Default,,0,0,0,,Бұл динозавр қандай болды?
Dialogue: 0,0:17:56.95,0:17:59.74,Default,,0,0,0,,Бұл сіздің қандай өмір салтын ұстанатыныңызға байланысты.
Dialogue: 0,0:17:59.82,0:18:02.24,Default,,0,0,0,,Мысалы... Мм.
Dialogue: 0,0:18:02.33,0:18:04.29,Default,,0,0,0,,Бұл кесірткеге ұқсайды...
Dialogue: 0,0:18:04.37,0:18:05.95,Default,,0,0,0,,Қанаттары болса ше?
Dialogue: 0,0:18:06.04,0:18:11.17,Default,,0,0,0,,О! Ендеше кесірткелер мен құстардың немен қоректенетінін білейік.
Dialogue: 0,0:18:11.25,0:18:13.92,Default,,0,0,0,,Сіз таудасыз ба, әлде теңіз жағасындасыз ба?
Dialogue: 0,0:18:14.00,0:18:16.67,Default,,0,0,0,,Сонымен біздің жейтін тағамымыз да әртүрлі...
Dialogue: 0,0:18:16.76,0:18:19.64,Default,,0,0,0,,Түсіндім, бұл қауырсынды динозавр.
Dialogue: 0,0:18:20.47,0:18:23.60,Default,,0,0,0,,Нобита Дора-чан, кешкі ас іш
Dialogue: 0,0:18:24.43,0:18:26.64,Default,,0,0,0,,Бүгін тунец сашими?
Dialogue: 0,0:18:26.73,0:18:29.35,Default,,0,0,0,,Оның дәмі жақсы болды, сондықтан мен бақытты болдым.
Dialogue: 0,0:18:29.44,0:18:30.90,Default,,0,0,0,,Бұл Нобитаның сүйікті тағамы.
Dialogue: 0,0:18:30.98,0:18:32.73,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:18:33.69,0:18:35.78,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:18:39.66,0:18:40.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:43.03,0:18:44.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:45.91,0:18:47.58,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:18:47.66,0:18:48.71,Default,,0,0,0,,Cu?
Dialogue: 0,0:18:48.79,0:18:49.83,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:18:49.92,0:18:50.79,Default,,0,0,0,,Кю~?
Dialogue: 0,0:18:51.92,0:18:52.75,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:18:52.84,0:18:54.04,Default,,0,0,0,,Кю~
Dialogue: 0,0:18:54.13,0:18:56.21,Default,,0,0,0,,Дәмді екен, келіңдер.
Dialogue: 0,0:18:56.30,0:18:57.76,Default,,0,0,0,,Кю~
Dialogue: 0,0:19:01.26,0:19:02.51,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:19:02.59,0:19:03.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:04.05,0:19:05.76,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:19:06.43,0:19:08.48,Default,,0,0,0,,Иә (му) му~!
Dialogue: 0,0:19:10.44,0:19:12.48,Default,,0,0,0,,Кю~
Dialogue: 0,0:19:12.56,0:19:14.02,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:14.90,0:19:16.65,Default,,0,0,0,,Ах
Dialogue: 0,0:19:16.73,0:19:18.11,Default,,0,0,0,,Кю~
Dialogue: 0,0:19:22.16,0:19:23.37,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:19:24.24,0:19:25.24,Default,,0,0,0,,Жедім!
Dialogue: 0,0:19:25.33,0:19:26.58,Default,,0,0,0,,Кю~ Кю~!
Dialogue: 0,0:19:26.66,0:19:28.37,Default,,0,0,0,,Жарайды, жарайды, иә.
Dialogue: 0,0:19:28.45,0:19:31.04,Default,,0,0,0,,Көрдім, дәмді екен.
Dialogue: 0,0:19:31.12,0:19:32.37,Default,,0,0,0,,Кю~! (шайнау дыбысы)
Dialogue: 0,0:19:33.04,0:19:35.59,Default,,0,0,0,,Ита~! Керемет
Dialogue: 0,0:19:35.67,0:19:36.92,Default,,0,0,0,,Itatata...
Dialogue: 0,0:19:37.00,0:19:39.67,Default,,0,0,0,,Кезекте тұрсаңыз...
Dialogue: 0,0:19:39.76,0:19:42.84,Default,,0,0,0,,...
Dialogue: 0,0:19:44.55,0:19:46.01,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:52.81,0:19:56.32,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:19:59.07,0:20:00.36,Default,,0,0,0,,Кю…
Dialogue: 0,0:20:01.11,0:20:02.32,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:20:03.03,0:20:05.66,Default,,0,0,0,,Сықырлау...
Dialogue: 0,0:20:08.41,0:20:09.45,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:20:11.12,0:20:12.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:12.12,0:20:14.12,Default,,0,0,0,,Cu...
Dialogue: 0,0:20:14.88,0:20:17.00,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:20:17.09,0:20:18.30,Default,,0,0,0,,Кю~
Dialogue: 0,0:20:20.26,0:20:21.80,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:20:22.88,0:20:24.13,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:20:29.47,0:20:30.89,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:20:34.65,0:20:36.90,Default,,0,0,0,,Сен... Саған не болды сонша кеш?
Dialogue: 0,0:20:36.98,0:20:39.90,Default,,0,0,0,,Динозавр ауруларын қалай емдейсіз?
Dialogue: 0,0:20:39.98,0:20:42.11,Default,,0,0,0,,Иә? (Нобита) Өтінемін!
Dialogue: 0,0:20:42.19,0:20:44.66,Default,,0,0,0,,Жоқ... а
Dialogue: 0,0:20:49.33,0:20:50.29,Default,,0,0,0,,Кю~
Dialogue: 0,0:20:50.37,0:20:52.20,Default,,0,0,0,,«Дәрігер сөмкесінде» қаралғаным үшін
Dialogue: 0,0:20:52.29,0:20:54.58,Default,,0,0,0,,Жақсырақ болады деп ойлаймын...
Dialogue: 0,0:20:54.67,0:20:56.04,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:58.25,0:20:59.71,Default,,0,0,0,,Кю~
Dialogue: 0,0:21:01.05,0:21:02.88,Default,,0,0,0,,Сіз ұйықтап қалған сияқтысыз.
Dialogue: 0,0:21:02.97,0:21:05.59,Default,,0,0,0,,Жүр, Нобита-кун, қазір ұйықтау керек.
Dialogue: 0,0:21:05.68,0:21:06.68,Default,,0,0,0,,Иә
Dialogue: 0,0:21:12.31,0:21:14.35,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:15.85,0:21:17.48,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:21:18.11,0:21:19.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:24.03,0:21:24.90,Default,,0,0,0,,Кезек
Dialogue: 0,0:21:27.49,0:21:28.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:29.87,0:21:30.87,Default,,0,0,0,,Кезек?
Dialogue: 0,0:21:32.58,0:21:34.33,Default,,0,0,0,,Кю~
Dialogue: 0,0:21:36.79,0:21:38.29,Default,,0,0,0,,Я...
Dialogue: 0,0:21:39.00,0:21:42.00,Default,,0,0,0,,Кеттік! (Күйе) Кілт~ Кілт~!
Dialogue: 0,0:21:42.09,0:21:44.97,Default,,0,0,0,,Кілт~ Кілт~! (Мия) Мия~ Мия~!
Dialogue: 0,0:21:47.76,0:21:49.55,Default,,0,0,0,,Чикоку Чикоку…
Dialogue: 0,0:21:50.18,0:21:52.76,Default,,0,0,0,,Ноби! Қазір қандай уақыт деп ойлайсыз?
Dialogue: 0,0:21:53.39,0:21:55.31,Default,,0,0,0,,Дәлізде тұр! (Нобита) Иә!
Dialogue: 0,0:21:55.39,0:21:56.48,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:56.56,0:21:58.40,Default,,0,0,0,,Ямада (Ямада) Иә.
Dialogue: 0,0:21:58.48,0:21:59.98,Default,,0,0,0,,Кавамура (Кавамура) Иә.
Dialogue: 0,0:22:00.06,0:22:01.69,Default,,0,0,0,,Декисуги (Декисуги) Иә
Dialogue: 0,0:22:01.77,0:22:02.98,Default,,0,0,0,,Ноби
Dialogue: 0,0:22:03.07,0:22:05.90,Default,,0,0,0,,Ноби? Нобита Ноби!
Dialogue: 0,0:22:05.99,0:22:08.57,Default,,0,0,0,,Эй, сен мені шақырып тұрсың!
Dialogue: 0,0:22:08.66,0:22:09.74,Default,,0,0,0,,...Таку қазірдің өзінде
Dialogue: 0,0:22:09.82,0:22:10.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:10.74,0:22:14.12,Default,,0,0,0,,Иә! (Мұғалім) Кешегі сынақты қайтар
Dialogue: 0,0:22:14.20,0:22:15.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:15.16,0:22:16.96,Default,,0,0,0,,0 ұпай емес!
Dialogue: 0,0:22:17.04,0:22:19.37,Default,,0,0,0,,3 ұпайға қуанатын адам бар ма?
Dialogue: 0,0:22:19.46,0:22:20.29,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:22:22.54,0:22:25.80,Default,,0,0,0,,Жарайды, мені тартыңыз.
Dialogue: 0,0:22:26.59,0:22:28.68,Default,,0,0,0,,Сәттілік Ноби (студенттер) хахахаха
Dialogue: 0,0:22:28.76,0:22:30.43,Default,,0,0,0,,Сәттілік Нобита-сан
Dialogue: 0,0:22:30.51,0:22:31.51,Default,,0,0,0,,Қараңызшы, тағы бір рет (Нобита)!
Dialogue: 0,0:22:32.14,0:22:33.56,Default,,0,0,0,,Жарайды! (Нобита) Гугугу...
Dialogue: 0,0:22:33.64,0:22:35.10,Default,,0,0,0,,Бар
Dialogue: 0,0:22:35.81,0:22:36.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:37.02,0:22:38.69,Default,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:22:39.94,0:22:41.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:41.77,0:22:43.61,Default,,0,0,0,,Ал, Нобита осында.
Dialogue: 0,0:22:43.69,0:22:45.36,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:22:45.44,0:22:47.69,Default,,0,0,0,,Мен өзімді сенімді сезінемін.
Dialogue: 0,0:22:47.78,0:22:49.32,Default,,0,0,0,,Шынында да
Dialogue: 0,0:22:49.40,0:22:51.24,Default,,0,0,0,,Нхуфуфуфу
Dialogue: 0,0:22:52.62,0:22:53.58,Default,,0,0,0,,Хунда!
Dialogue: 0,0:22:53.66,0:22:55.54,Default,,0,0,0,,Өскен Кью мен Муға қараңдар
Dialogue: 0,0:22:55.62,0:22:57.83,Default,,0,0,0,,Кейін айқайлаймын деп уайымдамаңыз!
Dialogue: 0,0:22:59.37,0:23:00.37,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:23:00.46,0:23:02.17,Default,,0,0,0,,Тапсырма! Му!
Dialogue: 0,0:23:02.25,0:23:03.50,Default,,0,0,0,,Муму...
Dialogue: 0,0:23:03.59,0:23:05.38,Default,,0,0,0,,Му~!
Dialogue: 0,0:23:05.46,0:23:07.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:08.42,0:23:10.63,Default,,0,0,0,,Меу~ Мия~! Қайтадан қош келдіңіз
Dialogue: 0,0:23:10.72,0:23:12.72,Default,,0,0,0,,Енді Му ұшпады ма?
Dialogue: 0,0:23:12.80,0:23:15.72,Default,,0,0,0,,Дұрыс! Мен де таң қалдым.
Dialogue: 0,0:23:15.81,0:23:17.72,Default,,0,0,0,,Сықырлау!
Dialogue: 0,0:23:17.81,0:23:19.68,Default,,0,0,0,,Кілт~ Кілт~!
Dialogue: 0,0:23:19.77,0:23:22.52,Default,,0,0,0,,Тапсырма да! Кіші де
Dialogue: 0,0:23:22.60,0:23:24.19,Default,,0,0,0,,Кю~!
Dialogue: 0,0:23:25.52,0:23:26.82,Default,,0,0,0,,Кю... Кю~!
Dialogue: 0,0:23:26.90,0:23:28.94,Default,,0,0,0,,Кю… кю…
Dialogue: 0,0:23:29.57,0:23:30.57,Default,,0,0,0,,Cu…
Dialogue: 0,0:23:31.07,0:23:33.45,Default,,0,0,0,,Кюууу…
Dialogue: 0,0:23:34.07,0:23:36.08,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:23:36.16,0:23:37.49,Default,,0,0,0,,Кю~!
Dialogue: 0,0:23:37.58,0:23:39.25,Default,,0,0,0,,Бірақ бұл түсініксіз болды.
Dialogue: 0,0:23:39.33,0:23:40.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:40.25,0:23:43.17,Default,,0,0,0,,Егер ұшса, мен оны енді өз бөлмемде ұстай алмаймын.
Dialogue: 0,0:23:43.25,0:23:46.42,Default,,0,0,0,,Анам бұл туралы біледі.
Dialogue: 0,0:23:46.50,0:23:47.42,Default,,0,0,0,,Му...
Dialogue: 0,0:23:47.50,0:23:50.67,Default,,0,0,0,,Міне! Бірдеңе істей алмайсың ба?
Dialogue: 0,0:23:50.76,0:23:51.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:51.88,0:23:53.55,Default,,0,0,0,,Иә! Ал...
Dialogue: 0,0:23:53.64,0:23:55.18,Default,,0,0,0,,Ниотто~!
Dialogue: 0,0:23:55.26,0:23:58.31,Default,,0,0,0,,«Асылдандыруға арналған диорамалық жиынтық»!
Dialogue: 0,0:23:58.39,0:24:02.85,Default,,0,0,0,,Бұл жануарларды, жәндіктерді және т.б. ұстауға арналған диорама.
Dialogue: 0,0:24:02.94,0:24:03.77,Default,,0,0,0,,Диорама?
Dialogue: 0,0:24:03.85,0:24:06.65,Default,,0,0,0,,Алдымен жер бедерін анықта
Dialogue: 0,0:24:06.73,0:24:09.48,Default,,0,0,0,,Хмм... Менің ойымша, бұл осындай нәрсе.
Dialogue: 0,0:24:10.44,0:24:11.36,Default,,0,0,0,,Сонда бұл
Dialogue: 0,0:24:11.45,0:24:14.95,Default,,0,0,0,,«Лездік миниатюралық өндіріс камерасын» пайдалансаңыз...
Dialogue: 0,0:24:17.37,0:24:19.70,Default,,0,0,0,,Кез келген нәрсені бөліктерге бөлуге болады.
Dialogue: 0,0:24:19.79,0:24:21.87,Default,,0,0,0,,Мазмұнды еркін реттей аласыз
Dialogue: 0,0:24:21.96,0:24:23.50,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:24:23.58,0:24:25.88,Default,,0,0,0,,Бірақ мұнымен мен табыламын.
Dialogue: 0,0:24:25.96,0:24:26.79,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:24:26.88,0:24:29.21,Default,,0,0,0,,Мұнда өлшемді реттеу тұтқасы бар.
Dialogue: 0,0:24:29.30,0:24:31.55,Default,,0,0,0,,Бос өлшем
Dialogue: 0,0:24:31.63,0:24:34.26,Default,,0,0,0,,Егер сіз оны «Small Light» көмегімен кішірек еткіңіз келсе...
Dialogue: 0,0:24:36.30,0:24:38.18,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:24:38.26,0:24:40.81,Default,,0,0,0,,Хахахаха хехехе!
Dialogue: 0,0:24:41.68,0:24:43.27,Default,,0,0,0,,Хирои!
Dialogue: 0,0:24:43.35,0:24:44.73,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:24:44.81,0:24:47.69,Default,,0,0,0,,Бұл жерден сені ешкім таба алмайды!
Dialogue: 0,0:24:49.69,0:24:52.82,Default,,0,0,0,,Жарайды, мен шештім! мұнда тек біз үшін
Dialogue: 0,0:24:52.90,0:24:54.65,Default,,0,0,0,,Жаңазавр жерін жасайық!
Dialogue: 0,0:24:54.74,0:24:57.62,Default,,0,0,0,,Кю~ Кю~ (Мью) Мью~!
Dialogue: 0,0:24:57.70,0:25:00.33,Default,,0,0,0,,Yaho! Хаха хехе
Dialogue: 0,0:25:01.58,0:25:02.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:10.42,0:25:11.42,Default,,0,0,0,,Ммм
Dialogue: 0,0:25:12.34,0:25:13.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:20.51,0:25:21.97,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:25:23.35,0:25:25.23,Default,,0,0,0,,Уф... жоқ! Қайтадан бастаңыз
Dialogue: 0,0:25:25.31,0:25:27.73,Default,,0,0,0,,Му! (Күйе) Сықырлау...
Dialogue: 0,0:25:34.99,0:25:36.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:36.24,0:25:37.91,Default,,0,0,0,,Өйткені ол шулы!
Dialogue: 0,0:25:37.99,0:25:40.91,Default,,0,0,0,,Аха... хехехехе
Dialogue: 0,0:25:40.99,0:25:42.41,Default,,0,0,0,,Кю~? (Му) Му~?
Dialogue: 0,0:25:43.20,0:25:44.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:45.25,0:25:46.83,Default,,0,0,0,,Иә! Уау...
Dialogue: 0,0:25:48.50,0:25:49.83,Default,,0,0,0,,Йотто~
Dialogue: 0,0:25:54.30,0:25:56.55,Default,,0,0,0,,Мм, міне?
Dialogue: 0,0:25:58.68,0:26:00.30,Default,,0,0,0,,Ах ха ха!
Dialogue: 0,0:26:05.06,0:26:06.60,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:26:10.90,0:26:12.32,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:26:18.70,0:26:20.74,Default,,0,0,0,,Арифметика Бұл мәселе болды.
Dialogue: 0,0:26:20.82,0:26:23.08,Default,,0,0,0,,Бұл өте қиын болды.
Dialogue: 0,0:26:25.62,0:26:26.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:28.33,0:26:30.71,Default,,0,0,0,,Хмф! Қарғыс атқыр...
Dialogue: 0,0:26:30.79,0:26:33.67,Default,,0,0,0,,Гугг... Ууууу...
Dialogue: 0,0:26:33.75,0:26:35.26,Default,,0,0,0,,Мерзімі аяқталуға дәл соңғы сәтте болса да—
Dialogue: 0,0:26:38.01,0:26:39.84,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:26:40.51,0:26:42.51,Default,,0,0,0,,Сіз динозаврды таптыңыз ба?
Dialogue: 0,0:26:42.60,0:26:44.68,Default,,0,0,0,,Төңкеріп жаттығудан да артық
Dialogue: 0,0:26:44.76,0:26:48.06,Default,,0,0,0,,Жержаңғақты көзбен шайнап жату жақсы емес пе?
Dialogue: 0,0:26:48.73,0:26:50.77,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:26:51.48,0:26:53.15,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:26:53.23,0:26:57.28,Default,,0,0,0,,Менің қолымнан мұндай нәрсе келмейтіні мені алаңдатпайды.
Dialogue: 0,0:26:59.65,0:27:00.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:01.32,0:27:03.33,Default,,0,0,0,,Бұл қауіпсіз аймақ
Dialogue: 0,0:27:03.41,0:27:05.20,Default,,0,0,0,,Мен де!
Dialogue: 0,0:27:05.29,0:27:07.62,Default,,0,0,0,,Уау, мінеки!
Dialogue: 0,0:27:16.67,0:27:17.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:18.51,0:27:19.76,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:27:21.01,0:27:22.76,Default,,0,0,0,,Сонымен... орындалды!
Dialogue: 0,0:27:23.80,0:27:26.26,Default,,0,0,0,,Меу-мәу-мәу...мәу~!
Dialogue: 0,0:27:27.02,0:27:29.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:27:31.81,0:27:33.10,Default,,0,0,0,,Му~?
Dialogue: 0,0:27:33.19,0:27:36.32,Default,,0,0,0,,Керемет! (Му) Му~!
Dialogue: 0,0:27:36.48,0:27:40.07,Default,,0,0,0,,Әй, мен саған бәрібір көк аспанның астында ұшуға рұқсат еткім келеді.
Dialogue: 0,0:27:40.15,0:27:41.20,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:27:41.82,0:27:45.37,Default,,0,0,0,,Бұл диорамада ауа райын бақылау функциясы бар.
Dialogue: 0,0:27:45.45,0:27:47.16,Default,,0,0,0,,Мысалы... (түйменің басылған дыбысы)
Dialogue: 0,0:27:49.20,0:27:50.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:51.12,0:27:52.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:52.71,0:27:54.08,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:27:57.17,0:27:58.05,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:28:00.05,0:28:01.51,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:28:01.59,0:28:03.26,Default,,0,0,0,,Ммммм...
Dialogue: 0,0:28:06.05,0:28:07.97,Default,,0,0,0,,Әй! Меуме~!
Dialogue: 0,0:28:08.06,0:28:10.43,Default,,0,0,0,,Енді кезек.
Dialogue: 0,0:28:10.52,0:28:12.73,Default,,0,0,0,,Cu...
Dialogue: 0,0:28:12.81,0:28:13.90,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:28:13.98,0:28:15.40,Default,,0,0,0,,Слайд?
Dialogue: 0,0:28:15.48,0:28:18.27,Default,,0,0,0,,Менің ойымша, бұл маған ұшуды жаттықтыруға көмектеседі деп ойладым.
Dialogue: 0,0:28:18.36,0:28:19.61,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:28:19.69,0:28:22.07,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:28:22.86,0:28:24.07,Default,,0,0,0,,Кю~
Dialogue: 0,0:28:24.16,0:28:25.28,Default,,0,0,0,,Cu…
Dialogue: 0,0:28:25.37,0:28:29.24,Default,,0,0,0,,Меу-мәу-мәу!
Dialogue: 0,0:28:29.33,0:28:30.95,Default,,0,0,0,,Кю~
Dialogue: 0,0:28:31.04,0:28:32.62,Default,,0,0,0,,Кюуру
Dialogue: 0,0:28:32.71,0:28:33.71,Default,,0,0,0,,Бұйра
Dialogue: 0,0:28:33.79,0:28:35.29,Default,,0,0,0,,Кю~!
Dialogue: 0,0:28:35.38,0:28:36.33,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:28:37.50,0:28:39.30,Default,,0,0,0,,Кю! Шырылдаған...
Dialogue: 0,0:28:39.38,0:28:40.67,Default,,0,0,0,,Жігіт…
Dialogue: 0,0:28:40.76,0:28:42.13,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:28:42.22,0:28:43.30,Default,,0,0,0,,Кю~
Dialogue: 0,0:28:43.38,0:28:45.22,Default,,0,0,0,,Қайталап көрейік
Dialogue: 0,0:28:45.30,0:28:48.14,Default,,0,0,0,,Тәжірибе жасасаңыз, Мью сияқты ұша аласыз.
Dialogue: 0,0:28:48.22,0:28:49.60,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:28:49.68,0:28:51.14,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:28:51.22,0:28:53.64,Default,,0,0,0,,Жоқ, бір ғана сәтсіздік!
Dialogue: 0,0:28:53.73,0:28:56.56,Default,,0,0,0,,Егер солай болса, сіз ешқашан тамақ ала алмайсыз!
Dialogue: 0,0:28:56.65,0:28:58.57,Default,,0,0,0,,Нобита-кун осылай дейді?
Dialogue: 0,0:28:58.65,0:29:00.32,Default,,0,0,0,,Бұл шулы белгі ме?
Dialogue: 0,0:29:00.40,0:29:01.48,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:29:01.57,0:29:02.78,Default,,0,0,0,,Иә? Айя!
Dialogue: 0,0:29:05.41,0:29:06.87,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:29:06.95,0:29:09.91,Default,,0,0,0,,Сізде бұл бар болғандықтан, жарайды деп жатқан сияқтысыз.
Dialogue: 0,0:29:09.99,0:29:11.87,Default,,0,0,0,,Мо~ (му) му~!
Dialogue: 0,0:29:11.95,0:29:14.33,Default,,0,0,0,,Бірақ Кью неге ұша алмайды?
Dialogue: 0,0:29:14.41,0:29:16.33,Default,,0,0,0,,Бір-біріне ұқсағанымен...
Dialogue: 0,0:29:16.42,0:29:19.29,Default,,0,0,0,,Ойлап қарасам, Му құйрығы ұзын болса да.
Dialogue: 0,0:29:19.38,0:29:22.21,Default,,0,0,0,,Кьюдің құйрығы өте қысқа.
Dialogue: 0,0:29:22.30,0:29:23.76,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:29:25.80,0:29:27.01,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:29:27.09,0:29:30.05,Default,,0,0,0,,Q му-дан әлдеқайда аз.
Dialogue: 0,0:29:30.56,0:29:32.68,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:29:32.77,0:29:34.89,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,0:29:36.81,0:29:37.85,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:29:39.27,0:29:41.69,Default,,0,0,0,,Сіз қазірдің өзінде көп өстіңіз.
Dialogue: 0,0:29:41.77,0:29:43.61,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:29:43.69,0:29:45.32,Default,,0,0,0,,Роджер!
Dialogue: 0,0:29:49.82,0:29:52.16,Default,,0,0,0,,Нобита-сан, сіздің маңызды миссияңыз қандай?
Dialogue: 0,0:29:52.24,0:29:53.87,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:29:53.95,0:29:56.33,Default,,0,0,0,,Өйткені біз динозаврларды таба алмадық
Dialogue: 0,0:29:56.41,0:29:58.63,Default,,0,0,0,,Уәде етілгендей көзі бар жержаңғақ...
Dialogue: 0,0:29:59.29,0:30:01.04,Default,,0,0,0,,Маған көрсетейін...
Dialogue: 0,0:30:01.13,0:30:02.09,Default,,0,0,0,,Әлде?
Dialogue: 0,0:30:02.17,0:30:04.13,Default,,0,0,0,,(масштабтау дыбысы)
Dialogue: 0,0:30:04.92,0:30:06.97,Default,,0,0,0,,Не? Бұл не? Бұл не?
Dialogue: 0,0:30:07.05,0:30:08.89,Default,,0,0,0,,Бұл не? (Күйе) Сілтеме?
Dialogue: 0,0:30:08.97,0:30:11.05,Default,,0,0,0,,Меу-мәу-мәу!
Dialogue: 0,0:30:11.14,0:30:12.97,Default,,0,0,0,,Міне осы ма Диоға адалдық ант еткен себебі?
Dialogue: 0,0:30:13.06,0:30:14.06,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:30:16.10,0:30:19.19,Default,,0,0,0,,Шынайы! (Му) Му~?
Dialogue: 0,0:30:19.81,0:30:21.69,Default,,0,0,0,,Мынаның майы дәмдірек!
Dialogue: 0,0:30:21.77,0:30:24.19,Default,,0,0,0,,Ей, дос болу деген осы!
Dialogue: 0,0:30:24.28,0:30:27.86,Default,,0,0,0,,Бобобо... Мен жай ғана тері мен сүйекпін...
Dialogue: 0,0:30:27.95,0:30:29.66,Default,,0,0,0,,Жержаңғақ жеу
Dialogue: 0,0:30:30.62,0:30:32.24,Default,,0,0,0,,Му~! Кя~
Dialogue: 0,0:30:32.33,0:30:34.49,Default,,0,0,0,,Нобита-сан, бұл не?
Dialogue: 0,0:30:34.58,0:30:38.37,Default,,0,0,0,,Мен тапқан жаңа динозавр - Новисавр!
Dialogue: 0,0:30:38.46,0:30:40.79,Default,,0,0,0,,Бұл Q, яғни Мью.
Dialogue: 0,0:30:40.88,0:30:42.88,Default,,0,0,0,,Кю~ (Нобита) Жарайды.
Dialogue: 0,0:30:42.96,0:30:44.96,Default,,0,0,0,,Үшеуің де менің достарымсыңдар.
Dialogue: 0,0:30:45.05,0:30:46.84,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:30:46.92,0:30:48.68,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:30:48.76,0:30:51.64,Default,,0,0,0,,Тапсырма~! (Му) Му~!
Dialogue: 0,0:30:51.72,0:30:54.47,Default,,0,0,0,,Ой, бұл не шу?
Dialogue: 0,0:30:56.89,0:30:58.43,Default,,0,0,0,,Нобита?
Dialogue: 0,0:31:01.90,0:31:03.11,Default,,0,0,0,,Бұл жаман ана!
Dialogue: 0,0:31:03.19,0:31:04.27,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:31:04.36,0:31:05.44,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:31:05.53,0:31:06.99,Default,,0,0,0,,«Кішкентай жарық»!
Dialogue: 0,0:31:07.07,0:31:09.07,Default,,0,0,0,,А... Иә? Шегіртке кәмпит?
Dialogue: 0,0:31:09.15,0:31:10.45,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:31:10.53,0:31:12.53,Default,,0,0,0,,Бәрі жақсы, асығыңыз!
Dialogue: 0,0:31:12.62,0:31:13.62,Default,,0,0,0,,Міне!
Dialogue: 0,0:31:13.70,0:31:15.24,Default,,0,0,0,,«Ғарышқа саяхат қарындаш»!
Dialogue: 0,0:31:15.99,0:31:18.16,Default,,0,0,0,,Мына қызыл қарындашпен нені айналдырдым
Dialogue: 0,0:31:18.25,0:31:20.33,Default,,0,0,0,,Ақ қарындашпен қоршалған аймақта...
Dialogue: 0,0:31:20.42,0:31:22.21,Default,,0,0,0,,Жақсы түсініктеме! Эх...
Dialogue: 0,0:31:23.29,0:31:24.67,Default,,0,0,0,,Нобита?
Dialogue: 0,0:31:24.75,0:31:26.30,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:31:26.38,0:31:28.38,Default,,0,0,0,,Тототото…
Dialogue: 0,0:31:31.84,0:31:33.22,Default,,0,0,0,,Тотото…
Dialogue: 0,0:31:37.10,0:31:38.85,Default,,0,0,0,,Нобита!
Dialogue: 0,0:31:38.93,0:31:39.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:40.06,0:31:42.31,Default,,0,0,0,,Сәлеметсіз бе апа
Dialogue: 0,0:31:42.40,0:31:43.94,Default,,0,0,0,,Бүгін де әдемі көрінесің.
Dialogue: 0,0:31:44.02,0:31:46.40,Default,,0,0,0,,Соңғы уақытта мен дірілдеген дыбысты естіп жүрмін.
Dialogue: 0,0:31:46.48,0:31:49.07,Default,,0,0,0,,Тоңазытқыштағы тағамның таусылуы
Dialogue: 0,0:31:49.15,0:31:51.82,Default,,0,0,0,,Сізде ит пен мысық жоқ деп ойлаймын.
Dialogue: 0,0:31:51.91,0:31:54.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:54.41,0:31:57.49,Default,,0,0,0,,Мен ит пен мысықтың иесі емеспін деп ант етемін!
Dialogue: 0,0:31:57.58,0:31:58.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:31:58.49,0:32:00.00,Default,,0,0,0,,Нгунгу…
Dialogue: 0,0:32:00.08,0:32:01.12,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:32:03.21,0:32:05.59,Default,,0,0,0,,А, а, а... (Мысық) Мияу!
Dialogue: 0,0:32:05.67,0:32:07.42,Default,,0,0,0,,Біртүрлі
Dialogue: 0,0:32:08.84,0:32:10.05,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:32:10.13,0:32:12.88,Default,,0,0,0,,Егер мен сізге шынымен үй жануарлары динозаврым бар екенін айтсам.
Dialogue: 0,0:32:12.97,0:32:14.55,Default,,0,0,0,,Бұл сіздің арқаңызды жоғалтады.
Dialogue: 0,0:32:14.64,0:32:17.01,Default,,0,0,0,,Кя~! Ол кетті!
Dialogue: 0,0:32:18.77,0:32:20.98,Default,,0,0,0,,Анашым! Бұл динозавр ма?
Dialogue: 0,0:32:21.06,0:32:23.94,Default,,0,0,0,,Рас, қалай қарасаң да динозавр.
Dialogue: 0,0:32:24.02,0:32:26.90,Default,,0,0,0,,Do... Дораэмон Иә!
Dialogue: 0,0:32:27.77,0:32:29.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:29.78,0:32:31.65,Default,,0,0,0,,Кю~ (му)му? Му~!
Dialogue: 0,0:32:31.74,0:32:33.32,Default,,0,0,0,,Әй, кетті!
Dialogue: 0,0:32:33.40,0:32:35.07,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:32:39.66,0:32:40.95,Default,,0,0,0,,Му~ (Нобита) Иә
Dialogue: 0,0:32:41.04,0:32:42.04,Default,,0,0,0,,Му~!
Dialogue: 0,0:32:42.12,0:32:44.46,Default,,0,0,0,,Келесіде Кю (Кю) Кю~!
Dialogue: 0,0:32:46.29,0:32:48.71,Default,,0,0,0,,Екеуі де үлкен болып өсті.
Dialogue: 0,0:32:48.80,0:32:51.05,Default,,0,0,0,,Кю~! (Му) Му~!
Dialogue: 0,0:32:51.13,0:32:52.55,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:32:52.63,0:32:55.51,Default,,0,0,0,,Қазіргі заманда оларды өсіру мүмкін емес.
Dialogue: 0,0:32:55.59,0:32:58.47,Default,,0,0,0,,Му менен үлкенірек.
Dialogue: 0,0:32:59.14,0:33:00.72,Default,,0,0,0,,Тіпті осы балалар үшін
Dialogue: 0,0:33:00.81,0:33:03.73,Default,,0,0,0,,Достармен бірге тұрған дұрыс емес пе?
Dialogue: 0,0:33:03.81,0:33:05.06,Default,,0,0,0,,Мью~
Dialogue: 0,0:33:05.14,0:33:07.23,Default,,0,0,0,,Бірақ сен мені қайда апармақсың?
Dialogue: 0,0:33:07.31,0:33:10.19,Default,,0,0,0,,Бұл динозаврлар болған дәуір, солай ма?
Dialogue: 0,0:33:10.27,0:33:12.90,Default,,0,0,0,,«Уақыт Фурошикиге» жұмсалған уақыттан кері есептеу
Dialogue: 0,0:33:12.99,0:33:14.70,Default,,0,0,0,,Кейінгі бор
Dialogue: 0,0:33:14.78,0:33:16.49,Default,,0,0,0,,«Уақыт машинасымен» сол дәуірге саяхат
Dialogue: 0,0:33:16.57,0:33:18.74,Default,,0,0,0,,Қ және Мьюді достарына қайтарайық.
Dialogue: 0,0:33:18.83,0:33:20.37,Default,,0,0,0,,Жоқ! Ах...
Dialogue: 0,0:33:20.99,0:33:22.87,Default,,0,0,0,,Мен оны мүлдем жек көремін!
Dialogue: 0,0:33:22.95,0:33:23.83,Default,,0,0,0,,Cu?
Dialogue: 0,0:33:23.91,0:33:25.50,Default,,0,0,0,,Нобита-сан (Сунео) Ах...
Dialogue: 0,0:33:25.58,0:33:26.71,Default,,0,0,0,,Му~?
Dialogue: 0,0:33:26.79,0:33:29.50,Default,,0,0,0,,Нобита-кун, мен қоштасу қиын екенін білемін.
Dialogue: 0,0:33:29.59,0:33:31.96,Default,,0,0,0,,Біз мәңгі бірге бола алмаймыз
Dialogue: 0,0:33:32.05,0:33:35.30,Default,,0,0,0,,Бұл олар болмауы керек әлем.
Dialogue: 0,0:33:35.38,0:33:38.68,Default,,0,0,0,,Бірақ кезек ұша алмайды!
Dialogue: 0,0:33:38.76,0:33:42.93,Default,,0,0,0,,Динозаврлар дәуіріне оралсақ, аман қалмайтын шығармыз!
Dialogue: 0,0:33:43.02,0:33:44.14,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:33:44.89,0:33:46.44,Default,,0,0,0,,Кю~
Dialogue: 0,0:33:46.52,0:33:48.15,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:33:48.23,0:33:50.11,Default,,0,0,0,,Кук (кью) Кю... Кю~?
Dialogue: 0,0:33:50.19,0:33:52.86,Default,,0,0,0,,Бірақ бұл ережелер.
Dialogue: 0,0:33:52.94,0:33:55.49,Default,,0,0,0,,Біз тарихты өзгертпеуіміз керек.
Dialogue: 0,0:33:55.57,0:33:58.61,Default,,0,0,0,,Ал бір достардың арасында өссең
Dialogue: 0,0:33:58.70,0:34:01.53,Default,,0,0,0,,Сенің де ұшатыныңа сенімдімін.
Dialogue: 0,0:34:01.62,0:34:03.45,Default,,0,0,0,,Сондықтан Нобита-кун...
Dialogue: 0,0:34:03.54,0:34:05.50,Default,,0,0,0,,Cu? Куә~
Dialogue: 0,0:34:07.29,0:34:09.38,Default,,0,0,0,,Ертең, ертең, екеуміз ғана.
Dialogue: 0,0:34:09.46,0:34:12.42,Default,,0,0,0,,Кью мен Муны бор кезеңіне қайтарайық.
Dialogue: 0,0:34:12.50,0:34:15.26,Default,,0,0,0,,Жүр, кеш болды, үйге қайтайық.
Dialogue: 0,0:34:15.34,0:34:16.47,Default,,0,0,0,,Кю~
Dialogue: 0,0:34:17.18,0:34:18.18,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:34:28.48,0:34:29.48,Default,,0,0,0,,Cu?
Dialogue: 0,0:34:29.56,0:34:30.98,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:34:31.06,0:34:32.94,Default,,0,0,0,,Соншалықты
Dialogue: 0,0:34:42.87,0:34:44.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:44.91,0:34:46.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:49.04,0:34:49.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:49.96,0:34:51.42,Default,,0,0,0,,Иә
Dialogue: 0,0:34:53.63,0:34:55.55,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:35:15.57,0:35:19.28,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:35:23.28,0:35:24.99,Default,,0,0,0,,Сықырлау!
Dialogue: 0,0:35:25.66,0:35:27.12,Default,,0,0,0,,Му~!
Dialogue: 0,0:35:27.20,0:35:29.46,Default,,0,0,0,,Му~! (Нобита) Дәмді, дәмді!
Dialogue: 0,0:35:30.16,0:35:31.79,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,0:35:33.29,0:35:34.59,Default,,0,0,0,,Кю~?
Dialogue: 0,0:35:34.67,0:35:36.84,Default,,0,0,0,,Кю~ (му) му~?
Dialogue: 0,0:35:36.92,0:35:38.26,Default,,0,0,0,,Кью және му
Dialogue: 0,0:35:38.34,0:35:41.55,Default,,0,0,0,,Өзімшілдігімнің кесірінен жұмыртқадан шығардым.
Dialogue: 0,0:35:41.63,0:35:44.22,Default,,0,0,0,,Мен бұл балаларды қорғауым керек.
Dialogue: 0,0:35:46.56,0:35:48.31,Default,,0,0,0,,Бор кезеңіне барайық!
Dialogue: 0,0:35:48.39,0:35:50.06,Default,,0,0,0,,Кью мен Мьюдің достарын табайық!
Dialogue: 0,0:35:50.14,0:35:51.77,Default,,0,0,0,,Ахаха
Dialogue: 0,0:35:52.48,0:35:53.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:53.90,0:35:55.27,Default,,0,0,0,,Нобита!
Dialogue: 0,0:35:55.36,0:35:56.65,Default,,0,0,0,,Иә? (Күйе) Сілтеме?
Dialogue: 0,0:35:58.61,0:35:59.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:59.53,0:36:02.61,Default,,0,0,0,,Джан Сунео Шизука-чан
Dialogue: 0,0:36:02.70,0:36:03.91,Default,,0,0,0,,Сол жақшалар...
Dialogue: 0,0:36:03.99,0:36:06.95,Default,,0,0,0,,Сіз бәрібір бор кезеңіне баруды жоспарлап отырсыз!
Dialogue: 0,0:36:07.03,0:36:08.91,Default,,0,0,0,,Сіз бізді артта қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:36:08.91,0:36:09.75,Default,,0,0,0,,Сіз бізді артта қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:36:08.91,0:36:09.75,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:36:09.83,0:36:11.66,Default,,0,0,0,,Менің де барғым келеді!
Dialogue: 0,0:36:11.75,0:36:13.96,Default,,0,0,0,,Егер мен көмектесе алатын бірдеңе болса, айтыңызшы.
Dialogue: 0,0:36:15.29,0:36:16.96,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:36:17.67,0:36:18.96,Default,,0,0,0,,үшінна!
Dialogue: 0,0:36:26.10,0:36:28.14,Default,,0,0,0,,үшінң дайынсыңдар ма?
Dialogue: 0,0:36:28.22,0:36:29.60,Default,,0,0,0,,Әрине!
Dialogue: 0,0:36:29.68,0:36:30.93,Default,,0,0,0,,О!
Dialogue: 0,0:36:31.02,0:36:32.94,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр.
Dialogue: 0,0:36:33.69,0:36:35.19,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:36:35.27,0:36:37.19,Default,,0,0,0,,Бор кезеңіне!
Dialogue: 0,0:36:37.27,0:36:38.69,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,0:36:38.77,0:36:39.65,Default,,0,0,0,,Му~!
Dialogue: 0,0:36:40.40,0:36:41.99,Default,,0,0,0,,Қозғалтқышты іске қосыңыз!
Dialogue: 0,0:36:42.07,0:36:44.53,Default,,0,0,0,,Батарея заряды 1200%!
Dialogue: 0,0:36:44.61,0:36:47.62,Default,,0,0,0,,Кеңістік-уақыт навигациялық жүйесі үшін түсінікті!
Dialogue: 0,0:36:48.70,0:36:50.37,Default,,0,0,0,,Git! Уф...
Dialogue: 0,0:36:52.66,0:36:57.21,Default,,0,0,0,,Баратын жері - 66 миллион жыл бұрын бор дәуіріндегі Жапония!
Dialogue: 0,0:36:57.29,0:36:59.50,Default,,0,0,0,,үшінңыз, мықтап ұстаңыздар!
Dialogue: 0,0:37:03.42,0:37:06.47,Default,,0,0,0,,Дорэмон, сен қазір қайдасың?
Dialogue: 0,0:37:06.55,0:37:08.47,Default,,0,0,0,,Шамамен 6000 жыл бұрын
Dialogue: 0,0:37:08.55,0:37:09.81,Default,,0,0,0,,6000 жыл?
Dialogue: 0,0:37:09.89,0:37:13.64,Default,,0,0,0,,Бұл Ніл өзені алабында Мысыр өркениеті өркендеген кез.
Dialogue: 0,0:37:13.73,0:37:15.06,Default,,0,0,0,,А, мен білемін!
Dialogue: 0,0:37:15.14,0:37:16.73,Default,,0,0,0,,Адам ұрпағы дүниеге келді
Dialogue: 0,0:37:16.81,0:37:18.98,Default,,0,0,0,,Шамамен 2,5 миллион жыл бұрын
Dialogue: 0,0:37:19.07,0:37:20.98,Default,,0,0,0,,Ал біз қазір бет алған бор кезеңі
Dialogue: 0,0:37:21.07,0:37:23.36,Default,,0,0,0,,60 миллионнан астам жыл бұрын
Dialogue: 0,0:37:23.44,0:37:26.16,Default,,0,0,0,,Бұл қашықтық шамамен 10 000 есе көп.
Dialogue: 0,0:37:26.24,0:37:28.03,Default,,0,0,0,,10 000 рет...
Dialogue: 0,0:37:29.12,0:37:31.24,Default,,0,0,0,,Сол жерде тағы біраз күтіңіз.
Dialogue: 0,0:37:31.33,0:37:34.29,Default,,0,0,0,,Кю~! (Му) Му~!
Dialogue: 0,0:37:34.37,0:37:35.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:35.83,0:37:38.21,Default,,0,0,0,,Ой... (ескерту дыбысы)
Dialogue: 0,0:37:38.29,0:37:40.92,Default,,0,0,0,,Ол кейде шайқалады, сондықтан қатты ұстаңыз!
Dialogue: 0,0:37:50.64,0:37:52.97,Default,,0,0,0,,Дораемон Бұл бор кезеңі ме?
Dialogue: 0,0:37:53.06,0:37:57.48,Default,,0,0,0,,Иә, мен 66 миллион жыл өткенге оралдым.
Dialogue: 0,0:37:57.56,0:37:58.94,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:37:59.02,0:38:00.52,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,0:38:00.61,0:38:03.28,Default,,0,0,0,,Біз кіргелі тұрған бор кезеңінде температура әртүрлі болады.
Dialogue: 0,0:38:03.36,0:38:07.03,Default,,0,0,0,,Ең бастысы, оттегінің концентрациясы біздің заманымыздан өзгеше.
Dialogue: 0,0:38:07.11,0:38:08.41,Default,,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:38:09.12,0:38:11.37,Default,,0,0,0,,...
Dialogue: 0,0:38:11.45,0:38:16.21,Default,,0,0,0,,Бұл киім суға, желге және суыққа төзімді.
Dialogue: 0,0:38:16.29,0:38:19.75,Default,,0,0,0,,Ол сіздің денеңізді қоршаған ортаның әртүрлі өзгерістерінен қорғайды.
Dialogue: 0,0:38:19.83,0:38:21.84,Default,,0,0,0,,Хехе, оның атмосферасы бар емес пе?
Dialogue: 0,0:38:21.92,0:38:23.34,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:38:25.42,0:38:27.47,Default,,0,0,0,,Хехе, онда кеттік!
Dialogue: 0,0:38:28.63,0:38:29.84,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:38:29.93,0:38:30.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:38:35.10,0:38:36.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:36.48,0:38:37.73,Default,,0,0,0,,Йотто!
Dialogue: 0,0:38:38.89,0:38:39.90,Default,,0,0,0,,Хмм
Dialogue: 0,0:38:40.65,0:38:41.61,Default,,0,0,0,,Әй
Dialogue: 0,0:38:43.23,0:38:46.40,Default,,0,0,0,,Уау...
Dialogue: 0,0:38:52.58,0:38:55.70,Default,,0,0,0,,Бұл бор кезеңіндегі Жапония...
Dialogue: 0,0:38:59.29,0:39:01.21,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:39:01.29,0:39:02.54,Default,,0,0,0,,Му~?
Dialogue: 0,0:39:02.63,0:39:04.63,Default,,0,0,0,,Кю~ (му) му~
Dialogue: 0,0:39:04.71,0:39:06.67,Default,,0,0,0,,Бұл сіздің туған қалаңыз!
Dialogue: 0,0:39:08.01,0:39:09.34,Default,,0,0,0,,Кю~
Dialogue: 0,0:39:09.93,0:39:11.14,Default,,0,0,0,,Cu…
Dialogue: 0,0:39:11.22,0:39:13.55,Default,,0,0,0,,Тапсырма~! (Нобита) Не болды?
Dialogue: 0,0:39:13.64,0:39:16.85,Default,,0,0,0,,Енді бір-бірімізді ажыратып алмауымыз керек...
Dialogue: 0,0:39:17.85,0:39:19.81,Default,,0,0,0,,«Бұл бандана қайда?»
Dialogue: 0,0:39:19.89,0:39:23.02,Default,,0,0,0,,Мына банданы мойныңызға осылай ораңыз.
Dialogue: 0,0:39:23.11,0:39:25.65,Default,,0,0,0,,Бұл түйме таратқышқа айналады
Dialogue: 0,0:39:25.73,0:39:28.07,Default,,0,0,0,,Карта болу үшін кеңейтіңіз
Dialogue: 0,0:39:28.57,0:39:31.28,Default,,0,0,0,,Енді сіз әрқашан бір-біріңіздің орналасқан жерін біле аласыз
Dialogue: 0,0:39:31.36,0:39:32.78,Default,,0,0,0,,Хмф
Dialogue: 0,0:39:33.41,0:39:34.74,Default,,0,0,0,,О, Құдай-ай, сен қатты жалықтырасың!
Dialogue: 0,0:39:34.83,0:39:36.37,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:39:36.45,0:39:37.54,Default,,0,0,0,,Му~
Dialogue: 0,0:39:37.62,0:39:39.66,Default,,0,0,0,,Сіз де Му ойнағыңыз келеді, солай ма?
Dialogue: 0,0:39:39.75,0:39:41.21,Default,,0,0,0,,Сәйкестенеміз.
Dialogue: 0,0:39:41.29,0:39:42.88,Default,,0,0,0,,Сондай-ақ кезекте
Dialogue: 0,0:39:43.79,0:39:45.17,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:39:45.25,0:39:46.75,Default,,0,0,0,,Му~! (Күйе) Кілт~!
Dialogue: 0,0:39:46.84,0:39:47.67,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:39:47.76,0:39:51.01,Default,,0,0,0,,Олай болса, Кю мен Мьюдің достарын тауып алайық!
Dialogue: 0,0:39:51.09,0:39:53.97,Default,,0,0,0,,Хехехехе мен бірінші тауып аламын!
Dialogue: 0,0:39:54.05,0:39:56.51,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:39:56.60,0:39:58.31,Default,,0,0,0,,Кю~ (Нобита) Иә?
Dialogue: 0,0:39:58.39,0:40:00.98,Default,,0,0,0,,Кю Кюру Кю…
Dialogue: 0,0:40:02.31,0:40:05.19,Default,,0,0,0,,Кю… Кю~
Dialogue: 0,0:40:05.82,0:40:07.65,Default,,0,0,0,,Хм хехе
Dialogue: 0,0:40:08.78,0:40:10.03,Default,,0,0,0,,Кю~
Dialogue: 0,0:40:21.00,0:40:24.54,Default,,0,0,0,,Динозаврлар еш жерде жоқ деп ойлаймын.
Dialogue: 0,0:40:24.63,0:40:28.17,Default,,0,0,0,,Ақымақ, Джан, бұл Жапония.
Dialogue: 0,0:40:28.25,0:40:30.67,Default,,0,0,0,,Үлкен динозаврлар жоқ...
Dialogue: 0,0:40:30.76,0:40:32.97,Default,,0,0,0,,Қарғыс атсын... Не болды, Джан?
Dialogue: 0,0:40:33.05,0:40:34.18,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:40:34.26,0:40:35.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:40:37.10,0:40:38.18,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:40:38.26,0:40:39.97,Default,,0,0,0,,А, күте тұр, Джан!
Dialogue: 0,0:40:40.06,0:40:42.48,Default,,0,0,0,,Тототото…
Dialogue: 0,0:40:43.31,0:40:44.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:44.77,0:40:47.06,Default,,0,0,0,,Ааах…
Dialogue: 0,0:40:47.15,0:40:48.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:56.45,0:40:58.08,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:40:58.16,0:41:00.16,Default,,0,0,0,,Стегозавр?
Dialogue: 0,0:41:00.24,0:41:01.79,Default,,0,0,0,,Шынайы!
Dialogue: 0,0:41:01.87,0:41:03.71,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:41:03.79,0:41:05.17,Default,,0,0,0,,Өйткені ол шөпқоректі динозавр
Dialogue: 0,0:41:05.25,0:41:07.38,Default,,0,0,0,,Тым жақындамасаңыз, жақсы боласыз.
Dialogue: 0,0:41:07.46,0:41:11.34,Default,,0,0,0,,Нақтырақ айтсақ, бұл стегозаврлар тұқымдасының мүшесі.
Dialogue: 0,0:41:11.42,0:41:13.13,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:41:13.22,0:41:16.64,Default,,0,0,0,,Жапонияда да көптеген динозаврлар өмір сүрген!
Dialogue: 0,0:41:16.72,0:41:19.51,Default,,0,0,0,,Ah-re? Бірақ бір нәрсе басқаша.
Dialogue: 0,0:41:19.60,0:41:20.93,Default,,0,0,0,,Не?
Dialogue: 0,0:41:21.02,0:41:24.23,Default,,0,0,0,,Стегозавр юра дәуірінің динозавры емес пе еді?
Dialogue: 0,0:41:24.31,0:41:25.90,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:41:25.98,0:41:29.77,Default,,0,0,0,,Шынында да, Стегозавр юра дәуіріндегі динозавр.
Dialogue: 0,0:41:29.86,0:41:33.36,Default,,0,0,0,,Олай болса, бұл жер бор кезеңіне дейін 100 млн.
Dialogue: 0,0:41:33.44,0:41:35.78,Default,,0,0,0,,Юра кезеңі деп аталар еді.
Dialogue: 0,0:41:35.86,0:41:37.28,Default,,0,0,0,,100 миллион жыл?
Dialogue: 0,0:41:37.36,0:41:39.33,Default,,0,0,0,,Бірақ олай болмауы керек...
Dialogue: 0,0:41:39.41,0:41:40.49,Default,,0,0,0,,Мүмкін!
Dialogue: 0,0:41:40.58,0:41:43.45,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:41:48.33,0:41:51.50,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:41:56.55,0:42:00.05,Default,,0,0,0,,Бұл аллозавр емес пе? юра дәуірінде өмір сүрген
Dialogue: 0,0:42:00.14,0:42:02.39,Default,,0,0,0,,Қате болма, бұл бор кезеңі емес.
Dialogue: 0,0:42:02.47,0:42:03.77,Default,,0,0,0,,Бұл юра кезеңі!
Dialogue: 0,0:42:03.85,0:42:05.43,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:42:05.52,0:42:06.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:42:06.44,0:42:09.81,Default,,0,0,0,,«Уақыт машинасының» тағайындалған орны ауыстырылған болуы мүмкін.
Dialogue: 0,0:42:09.90,0:42:10.73,Default,,0,0,0,,Е!
Dialogue: 0,0:42:10.81,0:42:12.11,Default,,0,0,0,,Не істеп жатырсың, Нобита?
Dialogue: 0,0:42:12.19,0:42:13.28,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:42:30.92,0:42:32.59,Default,,0,0,0,,Ааах…
Dialogue: 0,0:42:32.67,0:42:36.38,Default,,0,0,0,,«Уақыт машинасына» толық жылдамдықпен өтіңіз!
Dialogue: 0,0:42:36.92,0:42:37.93,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:42:40.89,0:42:42.55,Default,,0,0,0,,Нобита Асығыңыз!
Dialogue: 0,0:42:43.97,0:42:45.22,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:42:47.06,0:42:48.89,Default,,0,0,0,,Ооо!
Dialogue: 0,0:42:50.31,0:42:51.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:53.69,0:42:54.86,Default,,0,0,0,,Ах
Dialogue: 0,0:42:54.94,0:42:57.82,Default,,0,0,0,,Кілт~ Кілт~!
Dialogue: 0,0:42:58.36,0:42:59.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:03.41,0:43:04.70,Default,,0,0,0,,Нигеро!
Dialogue: 0,0:43:11.38,0:43:12.79,Default,,0,0,0,,Нобита Асығыңыз!
Dialogue: 0,0:43:12.88,0:43:13.71,Default,,0,0,0,,Му~!
Dialogue: 0,0:43:13.79,0:43:15.88,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:43:17.76,0:43:19.30,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:43:31.02,0:43:32.86,Default,,0,0,0,,Сіз бор дәуіріне бардыңыз ба?
Dialogue: 0,0:43:33.44,0:43:35.82,Default,,0,0,0,,Доктор Джилмен (бағынушы) Хамен байланысыңыз
Dialogue: 0,0:43:35.90,0:43:37.53,Default,,0,0,0,,Кіші ~ Нобита-кун
Dialogue: 0,0:43:37.61,0:43:38.99,Default,,0,0,0,,«Диорамалық жиынтық» дегеніміз не?
Dialogue: 0,0:43:39.07,0:43:40.40,Default,,0,0,0,,Мен оны тастадым.
Dialogue: 0,0:43:40.49,0:43:42.82,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:43:46.83,0:43:49.20,Default,,0,0,0,,Мен бұл жолы қателеспеймін деп ойлаймын.
Dialogue: 0,0:43:49.29,0:43:50.58,Default,,0,0,0,,Хмм.
Dialogue: 0,0:43:50.66,0:43:53.25,Default,,0,0,0,,Бұл, әрине, бор кезеңіндегі Жапония.
Dialogue: 0,0:43:53.33,0:43:55.59,Default,,0,0,0,,Мью~ (күш) Кю~?
Dialogue: 0,0:43:56.09,0:43:58.01,Default,,0,0,0,,Му~! (Күйе) Кілт...
Dialogue: 0,0:43:58.88,0:44:00.13,Default,,0,0,0,,Кю~
Dialogue: 0,0:44:00.22,0:44:01.97,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:44:04.05,0:44:05.93,Default,,0,0,0,,Му~! (үшін) Уау!
Dialogue: 0,0:44:08.56,0:44:09.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:44:09.98,0:44:11.60,Default,,0,0,0,,​​Керемет тамаша!
Dialogue: 0,0:44:11.69,0:44:14.40,Default,,0,0,0,,Дораемон, бұл міндетті түрде осында!
Dialogue: 0,0:44:14.48,0:44:17.86,Default,,0,0,0,,Нобита-кун мен Шизука-чан Q мен Мьюге қамқорлық жасайды
Dialogue: 0,0:44:17.94,0:44:19.28,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:44:19.36,0:44:21.36,Default,,0,0,0,,Кәне, Мючан.
Dialogue: 0,0:44:21.45,0:44:23.41,Default,,0,0,0,,Хехехе~ Хехехе
Dialogue: 0,0:44:23.49,0:44:25.74,Default,,0,0,0,,Хахаха! (Күйе) Кілт... Кілт~!
Dialogue: 0,0:44:25.82,0:44:27.33,Default,,0,0,0,,Му~!
Dialogue: 0,0:44:30.41,0:44:33.33,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:44:33.42,0:44:35.63,Default,,0,0,0,,Бұл бор кезеңіндегі Жапония!
Dialogue: 0,0:44:35.71,0:44:38.80,Default,,0,0,0,,Дәлірек айтсақ, жапон архипелагы қалыптаспаған.
Dialogue: 0,0:44:38.88,0:44:41.97,Default,,0,0,0,,Қазіргі уақытта ол әлі де үлкен континенттің бөлігі.
Dialogue: 0,0:44:42.05,0:44:44.34,Default,,0,0,0,,Мына жаққа қара! О!
Dialogue: 0,0:44:51.02,0:44:52.35,Default,,0,0,0,,Керемет!
Dialogue: 0,0:44:52.43,0:44:54.73,Default,,0,0,0,,Бұл нағыз Аламозавр!
Dialogue: 0,0:44:55.35,0:44:57.73,Default,,0,0,0,,Қандай үлкен!
Dialogue: 0,0:44:59.98,0:45:01.03,Default,,0,0,0,,Онда!
Dialogue: 0,0:45:21.55,0:45:24.55,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:45:25.80,0:45:26.72,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:45:26.80,0:45:29.01,Default,,0,0,0,,Динозаврлар патшалығы!
Dialogue: 0,0:45:29.81,0:45:33.23,Default,,0,0,0,,Бұл Q мен Мьюдің туған қаласы...
Dialogue: 0,0:45:33.31,0:45:34.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:45:34.73,0:45:37.10,Default,,0,0,0,,Кюкю… Кюкю…
Dialogue: 0,0:45:37.19,0:45:39.65,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:45:39.73,0:45:41.19,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:45:41.28,0:45:43.82,Default,,0,0,0,,Қараңдар, ұшуды үйреніңдер! Ұшуды үйреніңіз!
Dialogue: 0,0:45:43.90,0:45:46.20,Default,,0,0,0,,Сықырлау...
Dialogue: 0,0:45:46.28,0:45:48.78,Default,,0,0,0,,Кью - құс емес, ендеше кеттік.
Dialogue: 0,0:45:48.87,0:45:51.20,Default,,0,0,0,,Шырылдау... (Нобита) Кешіріңіз, кешіріңіз!
Dialogue: 0,0:45:51.29,0:45:53.33,Default,,0,0,0,,Кю... Кю~!
Dialogue: 0,0:45:54.00,0:45:55.87,Default,,0,0,0,,Му~! (Күйе) Кілт~!
Dialogue: 0,0:45:55.96,0:45:57.00,Default,,0,0,0,,Тіпті осында!
Dialogue: 0,0:45:57.08,0:45:59.38,Default,,0,0,0,,Түсіндің бе? Амал жоқ
Dialogue: 0,0:46:07.09,0:46:09.22,Default,,0,0,0,,Әдемі көл
Dialogue: 0,0:46:10.05,0:46:11.81,Default,,0,0,0,,Осы жерден іздеп көрейік
Dialogue: 0,0:46:12.56,0:46:14.93,Default,,0,0,0,,Динозаврлар еш жерде жоқ.
Dialogue: 0,0:46:15.02,0:46:17.27,Default,,0,0,0,,Ол жойылып кетті ме?
Dialogue: 0,0:46:17.35,0:46:18.90,Default,,0,0,0,,Му~!
Dialogue: 0,0:46:18.98,0:46:19.94,Default,,0,0,0,,Кю~
Dialogue: 0,0:46:20.02,0:46:21.36,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:46:21.44,0:46:22.52,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:46:22.61,0:46:26.03,Default,,0,0,0,,Тек осы жаңа динозаврдың мекендеу ортасы туралы деректері жоқ.
Dialogue: 0,0:46:26.11,0:46:28.57,Default,,0,0,0,,Анықтамалар бар ма?
Dialogue: 0,0:46:28.66,0:46:29.49,Default,,0,0,0,,О!
Dialogue: 0,0:46:30.78,0:46:33.16,Default,,0,0,0,,Иә! ммм...
Dialogue: 0,0:46:33.79,0:46:36.12,Default,,0,0,0,,«Из мөрі»!
Dialogue: 0,0:46:36.21,0:46:37.83,Default,,0,0,0,,«Из мөрі»?
Dialogue: 0,0:46:37.92,0:46:39.29,Default,,0,0,0,,Кью, келіңдер.
Dialogue: 0,0:46:39.37,0:46:40.54,Default,,0,0,0,,Кю~?
Dialogue: 0,0:46:40.63,0:46:42.09,Default,,0,0,0,,Маған аяғыңызды беріңіз.
Dialogue: 0,0:46:42.17,0:46:44.42,Default,,0,0,0,,...
Dialogue: 0,0:46:47.88,0:46:49.26,Default,,0,0,0,,Йотто!
Dialogue: 0,0:46:49.34,0:46:51.72,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:46:54.93,0:46:55.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:56.93,0:46:58.19,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:46:58.27,0:47:00.10,Default,,0,0,0,,Уа, бұл не?
Dialogue: 0,0:47:00.19,0:47:01.19,Default,,0,0,0,,Ой!
Dialogue: 0,0:47:01.27,0:47:02.52,Default,,0,0,0,,Бұл із!
Dialogue: 0,0:47:02.61,0:47:04.78,Default,,0,0,0,,Осылайша, жерге мөр басылғанда
Dialogue: 0,0:47:04.86,0:47:07.74,Default,,0,0,0,,Бірдей пішіндегі іздер жарқырай бастайды
Dialogue: 0,0:47:07.82,0:47:09.57,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:47:09.66,0:47:11.78,Default,,0,0,0,,Мен осында болдым ғой!
Dialogue: 0,0:47:11.87,0:47:14.83,Default,,0,0,0,,Қараңыз! үшін бір бағытта жүреді
Dialogue: 0,0:47:14.91,0:47:17.75,Default,,0,0,0,,Олар топпен саяхаттауы керек.
Dialogue: 0,0:47:17.83,0:47:19.54,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:47:19.62,0:47:21.29,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:47:27.21,0:47:29.30,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:47:30.43,0:47:32.05,Default,,0,0,0,,үшін…
Dialogue: 0,0:47:32.14,0:47:34.14,Default,,0,0,0,,үшінна дейін!
Dialogue: 0,0:47:34.85,0:47:37.31,Default,,0,0,0,,Тотто! Тото…
Dialogue: 0,0:47:38.85,0:47:39.85,Default,,0,0,0,,Сан!
Dialogue: 0,0:47:41.27,0:47:42.48,Default,,0,0,0,,Тототото!
Dialogue: 0,0:47:45.40,0:47:46.82,Default,,0,0,0,,Хмм?
Dialogue: 0,0:47:46.90,0:47:49.03,Default,,0,0,0,,Тототото! Тотто…
Dialogue: 0,0:47:50.57,0:47:52.16,Default,,0,0,0,,Кімге…
Dialogue: 0,0:47:52.74,0:47:54.45,Default,,0,0,0,,Дораэмон Бұл не?
Dialogue: 0,0:47:54.53,0:47:55.95,Default,,0,0,0,,«Жұмыртқа зерттеушісі»
Dialogue: 0,0:47:56.03,0:47:58.45,Default,,0,0,0,,Олар сіздің іздеріңізді табады.
Dialogue: 0,0:47:58.54,0:47:59.87,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:47:59.96,0:48:01.50,Default,,0,0,0,,Сосын мен сұрадым.
Dialogue: 0,0:48:01.58,0:48:03.21,Default,,0,0,0,,Iccho~!
Dialogue: 0,0:48:10.72,0:48:11.76,Default,,0,0,0,,Мью~
Dialogue: 0,0:48:11.84,0:48:13.30,Default,,0,0,0,,Му?
Dialogue: 0,0:48:13.39,0:48:14.80,Default,,0,0,0,,Оны жеме
Dialogue: 0,0:48:14.89,0:48:15.72,Default,,0,0,0,,Му~?
Dialogue: 0,0:48:17.06,0:48:19.39,Default,,0,0,0,,Тоттотото... таа!
Dialogue: 0,0:48:19.47,0:48:21.69,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:48:21.77,0:48:24.40,Default,,0,0,0,,Шағымданба, қуа берейік!
Dialogue: 0,0:48:24.48,0:48:26.73,Default,,0,0,0,,Жоқ, күн батқанда қауіпті.
Dialogue: 0,0:48:26.82,0:48:28.86,Default,,0,0,0,,Бүгін осында лагерь жасайық!
Dialogue: 0,0:48:33.41,0:48:34.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:34.91,0:48:36.62,Default,,0,0,0,,«Кемпинг шары»!
Dialogue: 0,0:48:36.70,0:48:38.74,Default,,0,0,0,,Бүгін түнде осында ұйықтайық
Dialogue: 0,0:48:38.83,0:48:40.66,Default,,0,0,0,,Са осы жерде
Dialogue: 0,0:48:41.20,0:48:42.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:43.71,0:48:46.13,Default,,0,0,0,,үшінна арналған бөлме бар, сондықтан өзіңізге ұнайтынын таңдаңыз.
Dialogue: 0,0:48:46.21,0:48:47.67,Default,,0,0,0,,Иә! Мен мұнда!
Dialogue: 0,0:48:47.75,0:48:48.75,Default,,0,0,0,,А, жасырын!
Dialogue: 0,0:48:48.84,0:48:49.67,Default,,0,0,0,,Үлпілдек!
Dialogue: 0,0:48:50.51,0:48:51.97,Default,,0,0,0,,Охохо!
Dialogue: 0,0:48:52.05,0:48:53.22,Default,,0,0,0,,Керемет!
Dialogue: 0,0:48:53.30,0:48:54.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:55.26,0:48:57.55,Default,,0,0,0,,Жақсы сезінемін! (Сунео) Бұл тамаша!
Dialogue: 0,0:48:57.64,0:48:58.97,Default,,0,0,0,,Әрі қарай…
Dialogue: 0,0:49:00.72,0:49:02.10,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:49:02.18,0:49:04.14,Default,,0,0,0,,Егер ол осылай көтерілсе
Dialogue: 0,0:49:04.23,0:49:06.06,Default,,0,0,0,,Жабайы аңдардан қорықпайды!
Dialogue: 0,0:49:07.11,0:49:09.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:09.19,0:49:10.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:10.11,0:49:12.74,Default,,0,0,0,,Уфуфуфу керемет!
Dialogue: 0,0:49:12.82,0:49:15.03,Default,,0,0,0,,Кю Кю…
Dialogue: 0,0:49:15.61,0:49:17.45,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:49:18.66,0:49:19.70,Default,,0,0,0,,Cu…
Dialogue: 0,0:49:20.33,0:49:21.95,Default,,0,0,0,,Кю~!
Dialogue: 0,0:49:22.50,0:49:24.54,Default,,0,0,0,,Кю~
Dialogue: 0,0:49:35.51,0:49:36.59,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:49:36.68,0:49:38.26,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:49:38.35,0:49:42.10,Default,,0,0,0,,Біздің жасымыз 66 миллион жыл.
Dialogue: 0,0:49:43.68,0:49:44.73,Default,,0,0,0,,Иә
Dialogue: 0,0:49:46.81,0:49:50.19,Default,,0,0,0,,Ха~ Атқан жұлдыз қандай
Dialogue: 0,0:49:50.27,0:49:51.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:59.45,0:50:01.41,Default,,0,0,0,,Осы дәуірдегі маймылдар?
Dialogue: 0,0:50:01.49,0:50:03.79,Default,,0,0,0,,Егер олар сонда болса, біртүрлі болмас па еді?
Dialogue: 0,0:50:03.87,0:50:05.71,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:50:06.42,0:50:09.79,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:50:09.88,0:50:11.84,Default,,0,0,0,,Кю~
Dialogue: 0,0:50:13.88,0:50:18.22,Default,,0,0,0,,(тыныш ызылдау)
Dialogue: 0,0:50:26.27,0:50:28.19,Default,,0,0,0,,Иә, әрине мен сені қадағалаймын.
Dialogue: 0,0:50:28.81,0:50:30.73,Default,,0,0,0,,Мен білемін. Не істеу керек?
Dialogue: 0,0:50:30.81,0:50:32.11,Default,,0,0,0,,Түсіру?
Dialogue: 0,0:50:32.90,0:50:34.61,Default,,0,0,0,,Бақылауды тағы да жалғастырыңыз.
Dialogue: 0,0:50:34.69,0:50:35.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:50:41.83,0:50:44.20,Default,,0,0,0,,Өйткені, бұл жаңа динозавр...
Dialogue: 0,0:50:47.08,0:50:48.87,Default,,0,0,0,,Неге...
Dialogue: 0,0:50:52.38,0:50:53.59,Default,,0,0,0,,«Жұмыртқа зерттеушілерінен»
Dialogue: 0,0:50:53.67,0:50:55.88,Default,,0,0,0,,Із туралы ақпарат келіп жатыр
Dialogue: 0,0:50:55.96,0:50:59.09,Default,,0,0,0,,Сен қайда бара жатырсың?
Dialogue: 0,0:50:59.18,0:51:01.09,Default,,0,0,0,,Бәрібір кеттік!
Dialogue: 0,0:51:01.18,0:51:03.56,Default,,0,0,0,,Жарайсыңдар, бәрің, бөлінбеулерің керек!
Dialogue: 0,0:51:04.18,0:51:05.47,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:51:05.56,0:51:07.27,Default,,0,0,0,,Тапсырма~! (Нобита) Жарайды!
Dialogue: 0,0:51:12.61,0:51:15.44,Default,,0,0,0,,Сіз шынымен де осындай жерге бардыңыз ба?
Dialogue: 0,0:51:15.53,0:51:17.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:17.82,0:51:18.70,Default,,0,0,0,,Му?
Dialogue: 0,0:51:18.78,0:51:20.41,Default,,0,0,0,,Cu? Шықыр!
Dialogue: 0,0:51:20.49,0:51:21.82,Default,,0,0,0,,Кю~ Кю~!
Dialogue: 0,0:51:21.91,0:51:23.16,Default,,0,0,0,,Не болды
Dialogue: 0,0:51:23.24,0:51:25.16,Default,,0,0,0,,Кілт~ Кілт~! (Нобита) Иә?
Dialogue: 0,0:51:26.50,0:51:29.21,Default,,0,0,0,,(Птеранодон айқайы)
Dialogue: 0,0:51:30.50,0:51:31.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:51:31.63,0:51:33.38,Default,,0,0,0,,Дораэмон артта!
Dialogue: 0,0:51:33.46,0:51:34.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:34.50,0:51:35.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:35.42,0:51:37.59,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:51:37.67,0:51:39.47,Default,,0,0,0,,П... Птеранодон!
Dialogue: 0,0:51:39.55,0:51:41.80,Default,,0,0,0,,Нашар! Бұл олардың ұясы!
Dialogue: 0,0:51:41.89,0:51:45.56,Default,,0,0,0,,үшінңыз, бар жылдамдықпен жүгіріңіздер! Ла ла ла ла ла...
Dialogue: 0,0:51:45.64,0:51:46.85,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:51:47.64,0:51:49.02,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:51:49.10,0:51:50.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:52.19,0:51:54.44,Default,,0,0,0,,Олар бізді жейтін болды ма?
Dialogue: 0,0:51:54.52,0:51:56.73,Default,,0,0,0,,Сәлем! Бұл әлдеқайда дәмді ...
Dialogue: 0,0:51:56.82,0:51:59.19,Default,,0,0,0,,Дос болу деген осы ма?
Dialogue: 0,0:51:59.28,0:52:01.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:01.70,0:52:03.20,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:52:03.28,0:52:05.66,Default,,0,0,0,,О... Иә?
Dialogue: 0,0:52:05.74,0:52:08.29,Default,,0,0,0,,Жоқ... жоқ, сен бізді қорқыту үшін келген жоқсың.
Dialogue: 0,0:52:08.37,0:52:11.08,Default,,0,0,0,,Бір нәрседен қорқып, үрейленіп тұрғандай...
Dialogue: 0,0:52:11.16,0:52:13.83,Default,,0,0,0,,үшінна! Төмендегі орманды паналайық.
Dialogue: 0,0:52:28.47,0:52:30.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:33.81,0:52:35.36,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:52:35.44,0:52:37.11,Default,,0,0,0,,Кю~! (Нобита) Тапсырма!
Dialogue: 0,0:52:38.40,0:52:40.69,Default,,0,0,0,,Кілт~ Кілт~!
Dialogue: 0,0:52:40.78,0:52:43.28,Default,,0,0,0,,Дораемон Аяқ іздері бар!
Dialogue: 0,0:52:43.36,0:52:45.78,Default,,0,0,0,,Бұл рас... Иә?
Dialogue: 0,0:52:47.37,0:52:49.62,Default,,0,0,0,,Әй, «Жұмыртқа зерттеушілері»!
Dialogue: 0,0:52:49.70,0:52:52.75,Default,,0,0,0,,Хамф, іздер алда жалғасады ма?
Dialogue: 0,0:52:52.83,0:52:54.50,Default,,0,0,0,,Гокуро-сама
Dialogue: 0,0:52:55.25,0:52:57.04,Default,,0,0,0,,Нуньюнюнюн…
Dialogue: 0,0:52:57.13,0:52:59.38,Default,,0,0,0,,Оны жеме (му)му~?
Dialogue: 0,0:53:00.51,0:53:01.88,Default,,0,0,0,,үшін сақ болыңыз
Dialogue: 0,0:53:01.97,0:53:03.97,Default,,0,0,0,,Мен қандай динозаврлар бар екенін білмеймін.
Dialogue: 0,0:53:04.05,0:53:05.09,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:53:05.18,0:53:07.93,Default,,0,0,0,,Дора-чан, мені қорқытпа.
Dialogue: 0,0:53:08.01,0:53:11.56,Default,,0,0,0,,Сіз маған төтенше жағдайда көмектесесіз, солай ма?
Dialogue: 0,0:53:12.68,0:53:13.52,Default,,0,0,0,,(айқай)
Dialogue: 0,0:53:13.60,0:53:15.27,Default,,0,0,0,,Уау! (Күйе) Кілт...
Dialogue: 0,0:53:15.35,0:53:16.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:16.35,0:53:18.19,Default,,0,0,0,,Кім келсе де...
Dialogue: 0,0:53:18.27,0:53:20.73,Default,,0,0,0,,Мен сені үрлеймін
Dialogue: 0,0:53:20.82,0:53:21.99,Default,,0,0,0,,Ах! Эй!
Dialogue: 0,0:53:26.91,0:53:28.45,Default,,0,0,0,,Ла ла ла ла...
Dialogue: 0,0:53:28.53,0:53:31.91,Default,,0,0,0,,Жоқ! Егеуқұйрықтар қорқынышты! Егеуқұйрықтар қорқынышты!
Dialogue: 0,0:53:32.00,0:53:35.29,Default,,0,0,0,,Ахахха Енді мені қорқытпа
Dialogue: 0,0:53:35.37,0:53:39.04,Default,,0,0,0,,Бұл дәуірде де егеуқұйрық сияқты жануарлар болған.
Dialogue: 0,0:53:39.13,0:53:40.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:40.38,0:53:41.84,Default,,0,0,0,,Джиан Сіздің қарныңыз ашты ма?
Dialogue: 0,0:53:41.92,0:53:43.72,Default,,0,0,0,,Е, мен емеспін.
Dialogue: 0,0:53:44.30,0:53:45.30,Default,,0,0,0,,Сіз сағыз жейсіз бе?
Dialogue: 0,0:53:45.38,0:53:47.09,Default,,0,0,0,,Демек бұл мен емес
Dialogue: 0,0:53:45.38,0:53:47.09,Default,,0,0,0,,Тететете…
Dialogue: 0,0:53:47.18,0:53:48.68,Default,,0,0,0,,Қолдарыңа не болды?
Dialogue: 0,0:53:48.76,0:53:50.18,Default,,0,0,0,,Тетете…
Dialogue: 0,0:53:50.26,0:53:52.89,Default,,0,0,0,,Тиранозавр!
Dialogue: 0,0:54:05.90,0:54:08.03,Default,,0,0,0,,Кю~ Кю~
Dialogue: 0,0:54:08.11,0:54:09.41,Default,,0,0,0,,Cu…
Dialogue: 0,0:54:09.49,0:54:10.74,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:54:12.83,0:54:13.95,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:54:15.00,0:54:17.42,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:54:18.12,0:54:19.46,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:54:19.54,0:54:21.25,Default,,0,0,0,,Тототото…
Dialogue: 0,0:54:21.34,0:54:23.59,Default,,0,0,0,,«Момотаро маркалы тары тұшпара»!
Dialogue: 0,0:54:23.67,0:54:26.05,Default,,0,0,0,,...Бұл ақылсыз!
Dialogue: 0,0:54:26.13,0:54:27.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:27.76,0:54:29.18,Default,,0,0,0,,Му~ Уау!
Dialogue: 0,0:54:30.14,0:54:32.39,Default,,0,0,0,,Оны жеме! (Му) Му~?
Dialogue: 0,0:54:32.47,0:54:35.18,Default,,0,0,0,,А, бірдеңе бар ма екен...
Dialogue: 0,0:54:35.27,0:54:36.10,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:54:36.94,0:54:38.56,Default,,0,0,0,,«Дос шоколады»!
Dialogue: 0,0:54:38.65,0:54:40.86,Default,,0,0,0,,Шоколад осындай уақытта...
Dialogue: 0,0:54:40.94,0:54:41.77,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:54:41.86,0:54:45.78,Default,,0,0,0,,Осы шоколадты екіге бөліп, бір-бірімізді жесек...
Dialogue: 0,0:54:48.53,0:54:51.91,Default,,0,0,0,,Сіз басқа тіршілік иесімен дос бола аласыз!
Dialogue: 0,0:54:51.99,0:54:53.08,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:54:54.20,0:54:55.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:59.46,0:55:01.17,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:55:02.71,0:55:05.09,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:55:05.17,0:55:08.38,Default,,0,0,0,,Не? Мен енот ит емеспін!
Dialogue: 0,0:55:08.47,0:55:09.47,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:55:09.55,0:55:10.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:11.26,0:55:12.97,Default,,0,0,0,,О, менің...
Dialogue: 0,0:55:14.10,0:55:15.81,Default,,0,0,0,,Мен оның әлі де болғанына сенімдімін.
Dialogue: 0,0:55:15.89,0:55:16.73,Default,,0,0,0,,Біреу!
Dialogue: 0,0:55:20.52,0:55:25.11,Default,,0,0,0,,Егер солай болса, маған қалдырыңыз!
Dialogue: 0,0:55:32.16,0:55:33.53,Default,,0,0,0,,Жарық, жарық!
Dialogue: 0,0:55:33.62,0:55:37.00,Default,,0,0,0,,Не? Ой... не болып жатыр?
Dialogue: 0,0:55:38.04,0:55:41.46,Default,,0,0,0,,Нанана... Не істеп жатырсың! Эй, сөйлесейік
Dialogue: 0,0:55:41.54,0:55:43.04,Default,,0,0,0,,Ах! Гол!
Dialogue: 0,0:55:43.13,0:55:45.67,Default,,0,0,0,,Уау! Ittetete…
Dialogue: 0,0:55:45.75,0:55:48.92,Default,,0,0,0,,Түсіндім, сенің атың Гол!
Dialogue: 0,0:55:49.01,0:55:50.51,Default,,0,0,0,,Горл!
Dialogue: 0,0:55:50.59,0:55:52.26,Default,,0,0,0,,Жарайсың Джан!
Dialogue: 0,0:55:52.34,0:55:53.47,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:55:53.55,0:55:55.39,Default,,0,0,0,,Бәріміз сөйлесейік
Dialogue: 0,0:55:55.47,0:55:57.64,Default,,0,0,0,,Менің жан серігім, Гол!
Dialogue: 0,0:55:57.72,0:55:59.43,Default,,0,0,0,,Керемет, Джан!
Dialogue: 0,0:55:59.52,0:56:02.31,Default,,0,0,0,,Біз «дос шоколадын» бөлісу арқылы дос болған кезде
Dialogue: 0,0:56:02.40,0:56:06.36,Default,,0,0,0,,Қарсыластың сипаттамалары мен қабілеттері тек бір сағатқа көшіріледі.
Dialogue: 0,0:56:06.44,0:56:09.28,Default,,0,0,0,,Егер сіз динозаврлармен достассаңыз, олар сізді қорқытпайды.
Dialogue: 0,0:56:09.36,0:56:11.82,Default,,0,0,0,,Мүмкін сіз Му-чанның достарын табуға көмектесе аласыз ба?
Dialogue: 0,0:56:11.91,0:56:13.70,Default,,0,0,0,,Бұл жақсы идея!
Dialogue: 0,0:56:13.78,0:56:14.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:14.74,0:56:17.79,Default,,0,0,0,,Жақсы! үшінмыз сүйікті динозаврларымызбен достасайық!
Dialogue: 0,0:56:17.87,0:56:19.20,Default,,0,0,0,,Иә! Керемет
Dialogue: 0,0:56:19.29,0:56:21.83,Default,,0,0,0,,Динозавр-чан Динозавр-чан
Dialogue: 0,0:56:21.92,0:56:23.33,Default,,0,0,0,,Ал... Ах!
Dialogue: 0,0:56:25.71,0:56:26.80,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:56:26.88,0:56:28.51,Default,,0,0,0,,Уау
Dialogue: 0,0:56:28.59,0:56:30.55,Default,,0,0,0,,Мен Му-чанмын
Dialogue: 0,0:56:30.63,0:56:31.76,Default,,0,0,0,,Му~!
Dialogue: 0,0:56:35.26,0:56:37.85,Default,,0,0,0,,Уау, дәл Мю-чан сияқты!
Dialogue: 0,0:56:37.93,0:56:39.89,Default,,0,0,0,,Му~!
Dialogue: 0,0:56:42.19,0:56:44.31,Default,,0,0,0,,Кю... Кю?
Dialogue: 0,0:56:44.40,0:56:48.02,Default,,0,0,0,,Егер менімен жақсы болсаң, сен менімен дос боласың ба?
Dialogue: 0,0:56:48.78,0:56:50.49,Default,,0,0,0,,Кю~!
Dialogue: 0,0:56:50.57,0:56:53.49,Default,,0,0,0,,Мау! Уау ахаха
Dialogue: 0,0:56:54.74,0:56:56.37,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:56:56.45,0:56:58.16,Default,,0,0,0,,Біз де! (Күйе) Кілт~!
Dialogue: 0,0:56:59.95,0:57:01.54,Default,,0,0,0,,Кілтке алайық
Dialogue: 0,0:57:01.62,0:57:02.66,Default,,0,0,0,,Кю~!
Dialogue: 0,0:57:02.75,0:57:05.00,Default,,0,0,0,,Міне! (Күйе) Кілт~!
Dialogue: 0,0:57:05.08,0:57:06.79,Default,,0,0,0,,Ахх...
Dialogue: 0,0:57:07.59,0:57:09.50,Default,,0,0,0,,...
Dialogue: 0,0:57:09.59,0:57:11.51,Default,,0,0,0,,Ахахаха (Нобита) Ах!
Dialogue: 0,0:57:11.59,0:57:15.47,Default,,0,0,0,,Ұша алмайтын кью және Нобита бірге өте жақсы көрінеді.
Dialogue: 0,0:57:15.55,0:57:17.64,Default,,0,0,0,,Трицератопс!
Dialogue: 0,0:57:17.72,0:57:20.68,Default,,0,0,0,,Оның бір мүйізі бар, сондықтан ол топтың мүшесі.
Dialogue: 0,0:57:20.77,0:57:22.35,Default,,0,0,0,,Ол жоғарғы деп аталады.
Dialogue: 0,0:57:22.43,0:57:24.52,Default,,0,0,0,,Уау, танысқаныма қуаныштымын Топ
Dialogue: 0,0:57:24.60,0:57:26.23,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:57:26.31,0:57:27.19,Default,,0,0,0,,Голут
Dialogue: 0,0:57:27.27,0:57:30.65,Default,,0,0,0,,Міне! Достың досы – жынды!
Dialogue: 0,0:57:30.73,0:57:33.11,Default,,0,0,0,,Гол… Гол~
Dialogue: 0,0:57:33.19,0:57:34.90,Default,,0,0,0,,Cu...
Dialogue: 0,0:57:34.99,0:57:36.82,Default,,0,0,0,,Жарайсыз ба?
Dialogue: 0,0:57:36.91,0:57:38.16,Default,,0,0,0,,Кю!
Dialogue: 0,0:57:38.24,0:57:40.99,Default,,0,0,0,,Мен бір күні ұшатыныма сенімдімін
Dialogue: 0,0:57:41.08,0:57:43.25,Default,,0,0,0,,Мен сияқты біреу айтса да...
Dialogue: 0,0:57:43.33,0:57:44.29,Default,,0,0,0,,Кю~!
Dialogue: 0,0:57:44.87,0:57:47.29,Default,,0,0,0,,Жарайсыңдар бәріміз кетейік!
Dialogue: 0,0:57:47.38,0:57:52.38,Default,,0,0,0,,♪～
Dialogue: 0,0:58:03.73,0:58:04.77,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:58:07.15,0:58:09.73,Default,,0,0,0,,(Нобитаның толқыған дауысы)
Dialogue: 0,0:58:11.27,0:58:13.94,Default,,0,0,0,,Иә! Ахаха
Dialogue: 0,0:58:14.03,0:58:15.28,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:58:16.74,0:58:18.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:18.41,0:58:19.91,Default,,0,0,0,,Вахаха
Dialogue: 0,0:58:19.99,0:58:21.08,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:59:17.76,0:59:22.76,Default,,0,0,0,,～♪
Dialogue: 0,0:59:22.85,0:59:24.06,Default,,0,0,0,,Бұл теңіз.
Dialogue: 0,0:59:24.60,0:59:27.56,Default,,0,0,0,,Іздері... жоғалып кетті.
Dialogue: 0,0:59:27.64,0:59:29.48,Default,,0,0,0,,(Капитан Еггтің дауысы)
Dialogue: 0,0:59:30.23,0:59:31.65,Default,,0,0,0,,Көптеген іздер!
Dialogue: 0,0:59:31.73,0:59:33.69,Default,,0,0,0,,үшін, Гокуро-сама
Dialogue: 0,0:59:33.77,0:59:35.02,Default,,0,0,0,,портототтот
Dialogue: 0,0:59:35.11,0:59:36.69,Default,,0,0,0,,Тортоттотто…
Dialogue: 0,0:59:36.78,0:59:39.65,Default,,0,0,0,,Аяқ ізі осы жерде аяқталса керек.
Dialogue: 0,0:59:39.74,0:59:41.95,Default,,0,0,0,,Қызық, қайда бардың?
Dialogue: 0,0:59:42.03,0:59:44.37,Default,,0,0,0,,Ол теңізге құлады ма?
Dialogue: 0,0:59:44.45,0:59:46.49,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:59:46.58,0:59:48.58,Default,,0,0,0,,Олардың осында екеніне сенімдімін.
Dialogue: 0,0:59:48.66,0:59:51.33,Default,,0,0,0,,Жарайды! Олай болса, бөлініп, іздейік!
Dialogue: 0,0:59:51.42,0:59:53.54,Default,,0,0,0,,Жоқ, бөліну қауіпті!
Dialogue: 0,0:59:53.63,0:59:56.63,Default,,0,0,0,,Дора-чан, сен уайымдап тұрсың ба?
Dialogue: 0,0:59:56.71,0:59:59.38,Default,,0,0,0,,Бізде Гол және Топ бар.
Dialogue: 0,0:59:59.47,1:00:00.72,Default,,0,0,0,,Гол… Жоғарғы…
Dialogue: 0,1:00:01.43,1:00:02.51,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:00:02.59,1:00:04.22,Default,,0,0,0,,Өте сақ болыңыз.
Dialogue: 0,1:00:04.30,1:00:06.51,Default,,0,0,0,,Егер әсер жойылса, мұны істей алмайсыз.
Dialogue: 0,1:00:06.60,1:00:07.43,Default,,0,0,0,,О!
Dialogue: 0,1:00:08.06,1:00:11.02,Default,,0,0,0,,Бандана арқылы бір-біріміздің орындарын тексерейік
Dialogue: 0,1:00:11.10,1:00:12.65,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:00:13.77,1:00:15.06,Default,,0,0,0,,Біз де
Dialogue: 0,1:00:15.15,1:00:16.11,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:21.20,1:00:23.57,Default,,0,0,0,,Жа... Джиан Бұл...
Dialogue: 0,1:00:23.66,1:00:25.58,Default,,0,0,0,,Олардың барлығы динозавр сүйектері ме?
Dialogue: 0,1:00:25.66,1:00:28.29,Default,,0,0,0,,Әй, сен неге қайтып келмейсің?
Dialogue: 0,1:00:28.37,1:00:30.50,Default,,0,0,0,,Неден қорқасың?
Dialogue: 0,1:00:30.58,1:00:32.08,Default,,0,0,0,,Ой! Ой...
Dialogue: 0,1:00:32.17,1:00:33.96,Default,,0,0,0,,Бұл не, Голға дейін!
Dialogue: 0,1:00:34.04,1:00:36.71,Default,,0,0,0,,Топ та бір нәрседен қорқатын сияқты.
Dialogue: 0,1:00:36.79,1:00:40.59,Default,,0,0,0,,Оның үстіне мені біраз уақыттан бері біреу бақылап тұрғандай...
Dialogue: 0,1:00:40.67,1:00:41.67,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:51.81,1:00:53.81,Default,,0,0,0,,（）
Dialogue: 0,1:00:54.40,1:00:56.31,Default,,0,0,0,,Көрдіңіз бе? Джан
Dialogue: 0,1:00:56.40,1:00:57.90,Default,,0,0,0,,Қуып жіберейік
Dialogue: 0,1:00:57.98,1:00:59.61,Default,,0,0,0,,（）
Dialogue: 0,1:01:05.91,1:01:08.12,Default,,0,0,0,,Кеттік (Сунео) Ух... Иә.
Dialogue: 0,1:01:09.58,1:01:10.58,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:11.33,1:01:13.41,Default,,0,0,0,,Гол және Топ осында күтіңіз.
Dialogue: 0,1:01:13.50,1:01:15.04,Default,,0,0,0,,Гол Гол Гол
Dialogue: 0,1:01:15.12,1:01:17.34,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:01:17.92,1:01:20.00,Default,,0,0,0,,Мен жақында ораламын
Dialogue: 0,1:01:23.67,1:01:24.55,Default,,0,0,0,,Иә...
Dialogue: 0,1:01:24.63,1:01:28.68,Default,,0,0,0,,Бала барлау тобы жіберілді! Менімен жүріңіз, Күлгін отряд
Dialogue: 0,1:01:29.43,1:01:30.97,Default,,0,0,0,,Күлгін мүше?
Dialogue: 0,1:01:32.02,1:01:33.85,Default,,0,0,0,,Гол… Жоғарғы…
Dialogue: 0,1:01:34.77,1:01:35.94,Default,,0,0,0,,Жоғарғы? Гол?
Dialogue: 0,1:01:39.23,1:01:42.36,Default,,0,0,0,,Гах... Тох!
Dialogue: 0,1:01:45.70,1:01:47.32,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,1:01:47.95,1:01:51.29,Default,,0,0,0,,Бор дәуірінде мұндай жер бар деп ойламаппын.
Dialogue: 0,1:01:51.37,1:01:52.87,Default,,0,0,0,,Динозаврларды аулау
Dialogue: 0,1:01:52.95,1:01:55.00,Default,,0,0,0,,Қымбат бағаға сататын жаман адамдар бар.
Dialogue: 0,1:01:55.08,1:01:57.54,Default,,0,0,0,,Мен оны Дораемоннан естідім...
Dialogue: 0,1:01:57.63,1:01:59.92,Default,,0,0,0,,Жарайды, бірге анықтайық.
Dialogue: 0,1:02:00.00,1:02:01.25,Default,,0,0,0,,Кеттік, Күлгін!
Dialogue: 0,1:02:01.34,1:02:04.47,Default,,0,0,0,,Мен күлгін болсам, Джиан деген не?
Dialogue: 0,1:02:04.55,1:02:06.72,Default,,0,0,0,,Көшбасшыны Қызыл деп шешті, солай ма?
Dialogue: 0,1:02:06.80,1:02:07.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:08.59,1:02:10.14,Default,,0,0,0,,Бұл қызғылт сары... Ах!
Dialogue: 0,1:02:10.22,1:02:11.47,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:11.56,1:02:13.81,Default,,0,0,0,,Мені енді қызғылт сары деп атама
Dialogue: 0,1:02:13.89,1:02:16.10,Default,,0,0,0,,Иә Қызыл... Ах.
Dialogue: 0,1:02:17.06,1:02:19.98,Default,,0,0,0,,Әй, қара! Бұл
Dialogue: 0,1:02:20.06,1:02:22.19,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,1:02:22.28,1:02:24.69,Default,,0,0,0,,Кью мен Мьюге ұқсайды!
Dialogue: 0,1:02:25.32,1:02:26.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:26.49,1:02:29.37,Default,,0,0,0,,Міне болды! Мен сені қуамын
Dialogue: 0,1:02:29.45,1:02:31.91,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,1:02:33.49,1:02:35.04,Default,,0,0,0,,（）
Dialogue: 0,1:02:37.79,1:02:39.63,Default,,0,0,0,,(сақинаны басқару дыбысы)
Dialogue: 0,1:02:44.30,1:02:45.92,Default,,0,0,0,,Бұл маймыл ғой.
Dialogue: 0,1:02:46.01,1:02:47.59,Default,,0,0,0,,Жарайды, күлгін түс.
Dialogue: 0,1:02:47.68,1:02:49.43,Default,,0,0,0,,Иә! Неге мен?
Dialogue: 0,1:02:50.14,1:02:51.89,Default,,0,0,0,,Капитан, Ред, осында...
Dialogue: 0,1:02:51.97,1:02:55.85,Default,,0,0,0,,Барлау - төмен жұмыс! Күлгін түске өтіңіз
Dialogue: 0,1:02:55.93,1:02:57.69,Default,,0,0,0,,Жоқ, қызыл түс... күлгін!
Dialogue: 0,1:02:57.77,1:02:59.69,Default,,0,0,0,,Қызыл! күлгін!
Dialogue: 0,1:02:59.77,1:03:00.94,Default,,0,0,0,,Аздап шулы
Dialogue: 0,1:03:01.44,1:03:02.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:02.44,1:03:03.32,Default,,0,0,0,,(айқай)
Dialogue: 0,1:03:03.40,1:03:05.53,Default,,0,0,0,,Апельсин~!
Dialogue: 0,1:03:08.86,1:03:10.41,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:13.78,1:03:15.75,Default,,0,0,0,,Ахххх...
Dialogue: 0,1:03:17.21,1:03:20.63,Default,,0,0,0,,Анашым! (Сунео) Анашым!
Dialogue: 0,1:03:21.13,1:03:22.75,Default,,0,0,0,,(лазерлік дыбыс)
Dialogue: 0,1:03:23.42,1:03:25.09,Default,,0,0,0,,Е... Ха! (Сунео) Иә?
Dialogue: 0,1:03:25.17,1:03:27.05,Default,,0,0,0,,Мүлдем
Dialogue: 0,1:03:28.09,1:03:30.55,Default,,0,0,0,,Қандай батыл жорық!
Dialogue: 0,1:03:30.64,1:03:32.35,Default,,0,0,0,,Маймыл сөйледі!
Dialogue: 0,1:03:32.43,1:03:34.47,Default,,0,0,0,,Сонымен... сіз маған көмектестіңіз.
Dialogue: 0,1:03:34.56,1:03:36.31,Default,,0,0,0,,Жартылай дұрыс
Dialogue: 0,1:03:36.39,1:03:37.60,Default,,0,0,0,,(сақинаны басқару дыбысы)
Dialogue: 0,1:03:38.60,1:03:40.98,Default,,0,0,0,,Ааах…
Dialogue: 0,1:03:44.82,1:03:46.90,Default,,0,0,0,,Сәлем... адам?
Dialogue: 0,1:03:46.98,1:03:49.45,Default,,0,0,0,,Бірақ екінші жартысы дұрыс емес.
Dialogue: 0,1:03:49.53,1:03:50.99,Default,,0,0,0,,Эй!
Dialogue: 0,1:03:52.24,1:03:53.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:58.33,1:03:59.91,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:04:03.84,1:04:04.84,Default,,0,0,0,,Иә...
Dialogue: 0,1:04:06.21,1:04:09.67,Default,,0,0,0,,Өйткені, барлық іздер теңізге жоғалып кетті.
Dialogue: 0,1:04:09.76,1:04:10.97,Default,,0,0,0,,Дора-чан! иә?
Dialogue: 0,1:04:11.59,1:04:13.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:04:13.22,1:04:14.85,Default,,0,0,0,,Бір нәрсенің ізі?
Dialogue: 0,1:04:14.93,1:04:17.68,Default,,0,0,0,,Жоқ... Олай болса, тым үлкен.
Dialogue: 0,1:04:18.47,1:04:20.43,Default,,0,0,0,,Меу Меу~!
Dialogue: 0,1:04:20.52,1:04:21.89,Default,,0,0,0,,Не болды, Мю Чан?
Dialogue: 0,1:04:22.69,1:04:25.19,Default,,0,0,0,,Кю… Кю~ (Нобита) Кю
Dialogue: 0,1:04:25.77,1:04:26.77,Default,,0,0,0,,Уау
Dialogue: 0,1:04:27.90,1:04:29.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:33.82,1:04:36.70,Default,,0,0,0,,Дододо... Дораемон үлкен!
Dialogue: 0,1:04:37.49,1:04:39.16,Default,,0,0,0,,(айқай)
Dialogue: 0,1:04:40.87,1:04:43.12,Default,,0,0,0,,үшінмыз «Такекоптермен» ұшайық!
Dialogue: 0,1:04:43.88,1:04:44.88,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:04:47.92,1:04:50.26,Default,,0,0,0,,Меу меу~!
Dialogue: 0,1:04:51.51,1:04:53.59,Default,,0,0,0,,Кю~… Кю
Dialogue: 0,1:04:58.93,1:05:00.68,Default,,0,0,0,,(айқай)
Dialogue: 0,1:05:01.35,1:05:02.89,Default,,0,0,0,,Кю-чан! (Нобита) Ұш!
Dialogue: 0,1:05:02.98,1:05:04.65,Default,,0,0,0,,Ұш, белгі!
Dialogue: 0,1:05:06.90,1:05:07.94,Default,,0,0,0,,Кю~
Dialogue: 0,1:05:08.02,1:05:09.32,Default,,0,0,0,,Ұш!
Dialogue: 0,1:05:09.40,1:05:10.28,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:05:10.99,1:05:13.11,Default,,0,0,0,,Кю… Кю…
Dialogue: 0,1:05:13.20,1:05:16.37,Default,,0,0,0,,Кюууу!
Dialogue: 0,1:05:16.45,1:05:17.91,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:05:21.54,1:05:24.00,Default,,0,0,0,,Ол ұшты! Сиқыр ұшты
Dialogue: 0,1:05:24.08,1:05:26.08,Default,,0,0,0,,Кюкю~ Кюкю…
Dialogue: 0,1:05:26.83,1:05:27.84,Default,,0,0,0,,Сықырлау?
Dialogue: 0,1:05:28.63,1:05:29.50,Default,,0,0,0,,Cu?
Dialogue: 0,1:05:30.92,1:05:32.51,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:05:32.59,1:05:34.97,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,1:05:36.59,1:05:37.97,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:05:38.76,1:05:40.81,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:05:40.89,1:05:41.81,Default,,0,0,0,,Әй!
Dialogue: 0,1:05:42.43,1:05:44.10,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:44.19,1:05:45.02,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:45.10,1:05:46.02,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:05:46.10,1:05:47.23,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,1:05:47.31,1:05:49.94,Default,,0,0,0,,Уаа!
Dialogue: 0,1:05:55.28,1:06:00.28,Default,,0,0,0,,(Нобитаның қиналған дауысы)
Dialogue: 0,1:06:06.04,1:06:08.50,Default,,0,0,0,,Мм... Мм!
Dialogue: 0,1:06:08.58,1:06:09.75,Default,,0,0,0,,Әй!
Dialogue: 0,1:06:11.67,1:06:12.96,Default,,0,0,0,,Кезек…
Dialogue: 0,1:06:16.09,1:06:17.76,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,1:06:36.49,1:06:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:39.66,1:06:41.74,Default,,0,0,0,,Кезек? (плезиозавр) Пи~!
Dialogue: 0,1:06:42.49,1:06:44.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:49.00,1:06:50.17,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,1:07:19.16,1:07:22.32,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:07:29.67,1:07:31.29,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:07:31.38,1:07:32.54,Default,,0,0,0,,Шығар!
Dialogue: 0,1:07:33.21,1:07:36.51,Default,,0,0,0,,Сәлеметсіз бе! Бұл жерден кетіңіз!
Dialogue: 0,1:07:36.59,1:07:39.01,Default,,0,0,0,,Бұл кеме қайда бағыт алады?
Dialogue: 0,1:07:39.09,1:07:41.09,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,1:07:41.64,1:07:42.55,Default,,0,0,0,,О!
Dialogue: 0,1:07:43.10,1:07:44.51,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:07:44.60,1:07:46.14,Default,,0,0,0,,Амансың ба? Джан
Dialogue: 0,1:07:46.22,1:07:47.98,Default,,0,0,0,,Қарғыс атсын, жоқ!
Dialogue: 0,1:07:48.06,1:07:52.44,Default,,0,0,0,,Осындай өткір жиектермен, менің ойымша, кілтті сындыра аламын ...
Dialogue: 0,1:07:52.52,1:07:53.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:54.44,1:07:57.15,Default,,0,0,0,,Хехехе, сен солай істедің.
Dialogue: 0,1:07:57.23,1:07:59.57,Default,,0,0,0,,Менің қымбатты досым!
Dialogue: 0,1:08:00.65,1:08:02.95,Default,,0,0,0,,Бұл Нобита-кун екеніне күмәнім жоқ.
Dialogue: 0,1:08:03.03,1:08:05.49,Default,,0,0,0,,Оны мұхит ағысы алып кеткен болуы керек.
Dialogue: 0,1:08:05.58,1:08:08.41,Default,,0,0,0,,Дора-чан, Нобита-сан қауіпсіз емес пе?
Dialogue: 0,1:08:08.50,1:08:12.12,Default,,0,0,0,,«Explorer Set» сізді қорғауы керек...
Dialogue: 0,1:08:12.21,1:08:13.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:14.04,1:08:15.38,Default,,0,0,0,,Нобита-сан…
Dialogue: 0,1:08:16.25,1:08:17.25,Default,,0,0,0,,Хмм
Dialogue: 0,1:08:30.48,1:08:31.77,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:08:33.40,1:08:35.23,Default,,0,0,0,,Ол жақсы бала.
Dialogue: 0,1:08:36.07,1:08:37.48,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:08:41.07,1:08:42.32,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,1:08:42.40,1:08:45.03,Default,,0,0,0,,Біз қалай құтқарылдық?
Dialogue: 0,1:08:46.33,1:08:47.66,Default,,0,0,0,,Ах
Dialogue: 0,1:08:49.33,1:08:51.37,Default,,0,0,0,,Сіз көтеріле аласыз ба? (Күйе) Кілт~!
Dialogue: 0,1:08:56.92,1:08:57.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:59.80,1:09:00.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:02.34,1:09:03.80,Default,,0,0,0,,Ах
Dialogue: 0,1:09:08.31,1:09:09.93,Default,,0,0,0,,Ах... (Күйе) Кіл~
Dialogue: 0,1:09:10.02,1:09:11.43,Default,,0,0,0,,Кю~
Dialogue: 0,1:09:11.52,1:09:13.52,Default,,0,0,0,,Нобита!
Dialogue: 0,1:09:14.14,1:09:15.35,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:09:15.44,1:09:17.94,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:09:18.02,1:09:19.32,Default,,0,0,0,,Нобита-сан! (Нобита) Уф!
Dialogue: 0,1:09:19.40,1:09:20.69,Default,,0,0,0,,Шизука-чан...
Dialogue: 0,1:09:20.78,1:09:22.65,Default,,0,0,0,,Себебі мен уайымдадым!
Dialogue: 0,1:09:23.61,1:09:25.82,Default,,0,0,0,,Өте жақсы
Dialogue: 0,1:09:25.91,1:09:27.83,Default,,0,0,0,,Бірақ бұл арал қандай...
Dialogue: 0,1:09:27.91,1:09:30.83,Default,,0,0,0,,Енді Кю мен Мьюге ұқсайтын динозавр бар!
Dialogue: 0,1:09:30.91,1:09:32.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:32.08,1:09:35.29,Default,,0,0,0,,Олай болса бұл жаңа динозавр...
Dialogue: 0,1:09:38.13,1:09:39.34,Default,,0,0,0,,Ыстық...
Dialogue: 0,1:09:42.76,1:09:44.26,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:09:45.22,1:09:48.64,Default,,0,0,0,,Олар да сол аралға келген сияқты.
Dialogue: 0,1:09:49.18,1:09:50.60,Default,,0,0,0,,Өте жақсы
Dialogue: 0,1:09:50.68,1:09:52.60,Default,,0,0,0,,Бұл бос нәрсе.
Dialogue: 0,1:09:52.68,1:09:55.98,Default,,0,0,0,,Бұл арал Жер үшін шешуші орын.
Dialogue: 0,1:09:56.06,1:09:58.31,Default,,0,0,0,,Егер оларға бірдеңе болса...
Dialogue: 0,1:09:58.40,1:10:00.77,Default,,0,0,0,,Бұл айнаға не болды?
Dialogue: 0,1:10:00.86,1:10:04.49,Default,,0,0,0,,Олардың екеуі қамауға алынды.
Dialogue: 0,1:10:04.57,1:10:06.70,Default,,0,0,0,,Тез қашайық
Dialogue: 0,1:10:06.78,1:10:08.91,Default,,0,0,0,,Жеңілмей үйге баруым керек пе?
Dialogue: 0,1:10:08.99,1:10:11.20,Default,,0,0,0,,Бірақ ол неге арал болды?
Dialogue: 0,1:10:12.58,1:10:15.50,Default,,0,0,0,,Жаңа динозаврлар тақ және әлсіз.
Dialogue: 0,1:10:15.58,1:10:17.63,Default,,0,0,0,,Көшпелі өмір сүруге мәжбүр
Dialogue: 0,1:10:17.71,1:10:20.75,Default,,0,0,0,,Ол ақыры теңіз жағасындағы жартастың бұрышына ілінген болуы керек.
Dialogue: 0,1:10:20.84,1:10:23.38,Default,,0,0,0,,Ол жерден аралға қарай сырғанау
Dialogue: 0,1:10:23.46,1:10:26.22,Default,,0,0,0,,өзінің өркендеуіне қол жеткізді
Dialogue: 0,1:10:27.18,1:10:30.89,Default,,0,0,0,,Сонда да жұмбақтарға толы арал...
Dialogue: 0,1:10:36.06,1:10:37.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:43.07,1:10:46.20,Default,,0,0,0,,Уау, артқа дейін жалғасады.
Dialogue: 0,1:10:47.07,1:10:48.99,Default,,0,0,0,,А, реплика, күте тұрыңыз!
Dialogue: 0,1:10:49.07,1:10:50.24,Default,,0,0,0,,Кю~!
Dialogue: 0,1:10:50.91,1:10:52.99,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,1:10:53.08,1:10:54.20,Default,,0,0,0,,Енді...
Dialogue: 0,1:10:54.29,1:10:56.16,Default,,0,0,0,,Қуып келейік! иә!
Dialogue: 0,1:10:56.25,1:10:57.33,Default,,0,0,0,,Хаха...
Dialogue: 0,1:11:05.34,1:11:06.76,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:08.26,1:11:10.18,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:11:10.97,1:11:14.72,Default,,0,0,0,,(Жаңа динозаврлардың дыбыстары)
Dialogue: 0,1:11:14.81,1:11:16.60,Default,,0,0,0,,Мью~
Dialogue: 0,1:11:17.23,1:11:18.31,Default,,0,0,0,,Му~!
Dialogue: 0,1:11:18.39,1:11:19.90,Default,,0,0,0,,Мю-чан!
Dialogue: 0,1:11:19.98,1:11:21.27,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,1:11:21.90,1:11:23.23,Default,,0,0,0,,Тапсырма!
Dialogue: 0,1:11:23.32,1:11:24.94,Default,,0,0,0,,Cu...
Dialogue: 0,1:11:28.53,1:11:30.32,Default,,0,0,0,,Хахаха ахаха
Dialogue: 0,1:11:30.91,1:11:31.99,Default,,0,0,0,,Хаха
Dialogue: 0,1:11:32.99,1:11:38.00,Default,,0,0,0,,(Жаңа динозаврлардың дыбыстары)
Dialogue: 0,1:11:45.05,1:11:46.21,Default,,0,0,0,,Му~!
Dialogue: 0,1:11:54.81,1:11:55.97,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:12:05.07,1:12:05.90,Default,,0,0,0,,Кю~!
Dialogue: 0,1:12:07.15,1:12:08.40,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:12:22.71,1:12:25.09,Default,,0,0,0,,Уау...
Dialogue: 0,1:12:26.71,1:12:28.05,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,1:12:28.13,1:12:29.51,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,1:12:29.59,1:12:32.51,Default,,0,0,0,,Мю-чан, біз жақсы араласып кеттік!
Dialogue: 0,1:12:33.55,1:12:35.22,Default,,0,0,0,,Му~!
Dialogue: 0,1:12:35.30,1:12:36.93,Default,,0,0,0,,Кю~
Dialogue: 0,1:12:37.68,1:12:39.14,Default,,0,0,0,,...
Dialogue: 0,1:12:39.22,1:12:40.18,Default,,0,0,0,,Cu?
Dialogue: 0,1:12:42.85,1:12:45.40,Default,,0,0,0,,Кью, мен сенің досыңмын.
Dialogue: 0,1:12:47.11,1:12:48.19,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:12:52.20,1:12:53.45,Default,,0,0,0,,Кю~
Dialogue: 0,1:12:54.20,1:12:55.07,Default,,0,0,0,,Кю~
Dialogue: 0,1:12:55.16,1:12:56.99,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:13:02.83,1:13:06.46,Default,,0,0,0,,Сықырлау? Сықырлау...
Dialogue: 0,1:13:06.54,1:13:09.17,Default,,0,0,0,,Жоқ! Батарея бітті ме?
Dialogue: 0,1:13:09.25,1:13:10.88,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:13:10.96,1:13:13.68,Default,,0,0,0,,Кю! Шырылдаған...
Dialogue: 0,1:13:13.76,1:13:14.93,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:13:15.01,1:13:15.97,Default,,0,0,0,,Гю…
Dialogue: 0,1:13:16.60,1:13:17.97,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:13:18.93,1:13:20.43,Default,,0,0,0,,Кю~ (Нобита) Хаа
Dialogue: 0,1:13:20.52,1:13:22.14,Default,,0,0,0,,Иә? (Күйе) Кіші~?
Dialogue: 0,1:13:22.23,1:13:23.06,Default,,0,0,0,,Кю!
Dialogue: 0,1:13:26.65,1:13:27.98,Default,,0,0,0,,Му~
Dialogue: 0,1:13:28.07,1:13:29.27,Default,,0,0,0,,Му~!
Dialogue: 0,1:13:30.73,1:13:32.15,Default,,0,0,0,,Cu...
Dialogue: 0,1:13:40.58,1:13:41.75,Default,,0,0,0,,Cu...
Dialogue: 0,1:13:42.29,1:13:43.46,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:13:43.54,1:13:44.37,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:13:44.46,1:13:45.83,Default,,0,0,0,,(Жаңа динозаврдың үруі)
Dialogue: 0,1:13:46.42,1:13:47.29,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:13:47.38,1:13:49.17,Default,,0,0,0,,(Жаңа динозаврдың үруі)
Dialogue: 0,1:13:49.25,1:13:51.00,Default,,0,0,0,,Му~!
Dialogue: 0,1:13:51.09,1:13:53.63,Default,,0,0,0,,(Жаңа динозаврдың үруі)
Dialogue: 0,1:13:53.72,1:13:55.09,Default,,0,0,0,,Кю~
Dialogue: 0,1:13:56.05,1:13:56.93,Default,,0,0,0,,(Жаңа динозаврдың үруі)
Dialogue: 0,1:13:57.01,1:13:57.89,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:14:04.60,1:14:05.73,Default,,0,0,0,,Кю…
Dialogue: 0,1:14:05.81,1:14:06.94,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:07.02,1:14:08.11,Default,,0,0,0,,Ха!
Dialogue: 0,1:14:08.73,1:14:09.86,Default,,0,0,0,,Тапсырма!
Dialogue: 0,1:14:11.94,1:14:13.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:13.61,1:14:15.07,Default,,0,0,0,,Әй!
Dialogue: 0,1:14:15.78,1:14:17.24,Default,,0,0,0,,Тоқта, Мю-чан!
Dialogue: 0,1:14:19.16,1:14:20.45,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:14:23.12,1:14:24.41,Default,,0,0,0,,Cu?
Dialogue: 0,1:14:25.12,1:14:26.50,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,1:14:26.58,1:14:28.38,Default,,0,0,0,,Біркелкі белгі...
Dialogue: 0,1:14:29.13,1:14:30.84,Default,,0,0,0,,Біз доспыз!
Dialogue: 0,1:14:31.96,1:14:33.42,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:14:34.47,1:14:35.55,Default,,0,0,0,,Бұл...
Dialogue: 0,1:14:35.63,1:14:37.51,Default,,0,0,0,,Сіз ұша алмайсыз ба?
Dialogue: 0,1:14:37.59,1:14:38.72,Default,,0,0,0,,Кю…
Dialogue: 0,1:14:39.47,1:14:41.68,Default,,0,0,0,,Кішкентай болғандықтан ба?
Dialogue: 0,1:14:42.51,1:14:44.39,Default,,0,0,0,,Құйрық қысқа болғандықтан ба?
Dialogue: 0,1:14:44.47,1:14:45.98,Default,,0,0,0,,Cu...
Dialogue: 0,1:14:46.06,1:14:47.23,Default,,0,0,0,,Кю~!
Dialogue: 0,1:14:48.27,1:14:50.36,Default,,0,0,0,,Онда мен міндетті түрде боламын
Dialogue: 0,1:14:50.98,1:14:53.32,Default,,0,0,0,,Кезек ұшсын!
Dialogue: 0,1:14:54.36,1:14:55.86,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,1:15:02.16,1:15:04.24,Default,,0,0,0,,Deep Impact осында дерлік
Dialogue: 0,1:15:04.87,1:15:07.21,Default,,0,0,0,,Біз бұл балалардың барлығын тез арада қамтамасыз етуіміз керек.
Dialogue: 0,1:15:08.46,1:15:10.92,Default,,0,0,0,,үшін өлуі мүмкін.
Dialogue: 0,1:15:12.00,1:15:13.38,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,1:15:14.84,1:15:17.09,Default,,0,0,0,,Тағы біраз күте аласыз ба?
Dialogue: 0,1:15:18.05,1:15:21.47,Default,,0,0,0,,Бұл жаңа динозавр бұрынғылардан біршама ерекшеленетіні сөзсіз.
Dialogue: 0,1:15:21.55,1:15:24.06,Default,,0,0,0,,Ал сол жұмбақ арал туралы.
Dialogue: 0,1:15:24.93,1:15:26.93,Default,,0,0,0,,Жақында жеке басын анықтайтын сияқтымыз.
Dialogue: 0,1:15:27.02,1:15:28.02,Default,,0,0,0,,Ягами
Dialogue: 0,1:15:28.69,1:15:29.77,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:15:29.85,1:15:32.77,Default,,0,0,0,,Алайда 2 сағаттан аз уақыт кетсе, біз кемеге мінеміз.
Dialogue: 0,1:15:32.86,1:15:34.02,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:15:34.90,1:15:36.49,Default,,0,0,0,,Өл, қарт жезөкше!
Dialogue: 0,1:15:38.78,1:15:41.41,Default,,0,0,0,,Тағы бір рет қорықпа!
Dialogue: 0,1:15:41.49,1:15:43.12,Default,,0,0,0,,Кю… Кю…
Dialogue: 0,1:15:43.20,1:15:44.49,Default,,0,0,0,,Кю... Кю!
Dialogue: 0,1:15:44.58,1:15:47.66,Default,,0,0,0,,Сықыр... Сықыр!
Dialogue: 0,1:15:49.46,1:15:50.54,Default,,0,0,0,,Кю~
Dialogue: 0,1:15:50.62,1:15:52.79,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,1:15:52.88,1:15:54.25,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:15:54.92,1:15:55.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:15:56.05,1:15:57.71,Default,,0,0,0,,Му және басқа достар
Dialogue: 0,1:15:57.80,1:16:00.22,Default,,0,0,0,,Қолдарыңды олай қозғамаңдар!
Dialogue: 0,1:16:00.30,1:16:01.47,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,1:16:01.55,1:16:02.43,Default,,0,0,0,,Cu…
Dialogue: 0,1:16:02.51,1:16:04.39,Default,,0,0,0,,Кю... кю!
Dialogue: 0,1:16:04.47,1:16:06.43,Default,,0,0,0,,Күй... күй
Dialogue: 0,1:16:07.68,1:16:09.56,Default,,0,0,0,,Сықыр... Сықыр!
Dialogue: 0,1:16:11.44,1:16:12.73,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:16:13.36,1:16:14.23,Default,,0,0,0,,Кю!
Dialogue: 0,1:16:14.31,1:16:15.52,Default,,0,0,0,,Кю!
Dialogue: 0,1:16:16.57,1:16:19.19,Default,,0,0,0,,Олай емес! неге жасай алмайсың
Dialogue: 0,1:16:19.28,1:16:21.11,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:16:21.20,1:16:24.24,Default,,0,0,0,,үшін ұша алады, сондықтан Кью де ұша алуы керек.
Dialogue: 0,1:16:24.32,1:16:25.70,Default,,0,0,0,,Жүр, қолыңнан келгеннің бәрін істе... (кеңес) Сықыр!
Dialogue: 0,1:16:25.78,1:16:26.74,Default,,0,0,0,,Бұл!
Dialogue: 0,1:16:27.83,1:16:29.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:30.71,1:16:32.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:32.50,1:16:33.33,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:34.00,1:16:35.29,Default,,0,0,0,,Cu...
Dialogue: 0,1:16:36.25,1:16:37.50,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:16:38.13,1:16:39.97,Default,,0,0,0,,Кю~! (Нобита) А
Dialogue: 0,1:16:40.97,1:16:42.18,Default,,0,0,0,,Тапсырма!
Dialogue: 0,1:16:44.55,1:16:45.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:16:46.93,1:16:48.39,Default,,0,0,0,,Идиот!
Dialogue: 0,1:16:49.60,1:16:51.35,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:16:51.44,1:16:54.10,Default,,0,0,0,,Ах... хмм аа...
Dialogue: 0,1:17:04.28,1:17:06.37,Default,,0,0,0,,Бұрын не болды?
Dialogue: 0,1:17:07.24,1:17:09.58,Default,,0,0,0,,Кью осы дүниеде өмір сүруі үшін
Dialogue: 0,1:17:09.66,1:17:11.66,Default,,0,0,0,,Ұша алмасаң жақсы емес
Dialogue: 0,1:17:13.62,1:17:16.34,Default,,0,0,0,,Мен сияқты біреу айтса да.
Dialogue: 0,1:17:16.42,1:17:20.30,Default,,0,0,0,,Мен жүгіре алмаймын, тест тапсыра алмаймын, тұра алмаймын...
Dialogue: 0,1:17:20.76,1:17:21.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:22.01,1:17:23.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:24.89,1:17:27.26,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:17:27.35,1:17:30.27,Default,,0,0,0,,Нобита-сан қайғы мен қайғыны түсінеді.
Dialogue: 0,1:17:30.35,1:17:33.52,Default,,0,0,0,,Мен сізге көмектесе аламын.
Dialogue: 0,1:17:34.02,1:17:36.48,Default,,0,0,0,,Маған мұндай Нобита-сан ұнайды.
Dialogue: 0,1:17:36.56,1:17:37.69,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:40.98,1:17:44.61,Default,,0,0,0,,Кю-чан, мен міндетті түрде Нобита-санды күтемін.
Dialogue: 0,1:17:44.70,1:17:46.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:46.11,1:17:47.28,Default,,0,0,0,,Хмм...
Dialogue: 0,1:17:48.49,1:17:49.49,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:51.04,1:17:53.00,Default,,0,0,0,,Рахмет, Шизука-чан!
Dialogue: 0,1:17:53.62,1:17:55.25,Default,,0,0,0,,Иә
Dialogue: 0,1:17:55.96,1:17:57.83,Default,,0,0,0,,«Анықтама таяқшасы»…
Dialogue: 0,1:17:58.46,1:17:59.46,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:18:05.18,1:18:06.18,Default,,0,0,0,,Кезек
Dialogue: 0,1:18:13.35,1:18:14.48,Default,,0,0,0,,(сақинаны басқару дыбысы)
Dialogue: 0,1:18:17.02,1:18:18.40,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:18.48,1:18:19.98,Default,,0,0,0,,Пуха~!
Dialogue: 0,1:18:20.77,1:18:22.57,Default,,0,0,0,,Біз аралға қонған сияқтымыз.
Dialogue: 0,1:18:22.65,1:18:24.65,Default,,0,0,0,,Енді қашайық, Джан.
Dialogue: 0,1:18:24.74,1:18:25.57,Default,,0,0,0,,Джиан?
Dialogue: 0,1:18:28.20,1:18:29.45,Default,,0,0,0,,Кел, Күлгін!
Dialogue: 0,1:18:29.99,1:18:31.54,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,1:18:32.45,1:18:33.87,Default,,0,0,0,,Мынаны қара!
Dialogue: 0,1:18:33.95,1:18:37.17,Default,,0,0,0,,Ей, онда олар зерттеуші емес, ұры.
Dialogue: 0,1:18:37.25,1:18:38.25,Default,,0,0,0,,Оинго-Боинго бауырлары!
Dialogue: 0,1:18:38.75,1:18:40.84,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,1:18:40.92,1:18:42.00,Default,,0,0,0,,Хмм... бұл.
Dialogue: 0,1:18:42.67,1:18:44.92,Default,,0,0,0,,Бұл аралдың картасы ма?
Dialogue: 0,1:18:45.01,1:18:47.22,Default,,0,0,0,,Мен бірдеңе көргендей болдым...
Dialogue: 0,1:18:47.30,1:18:49.72,Default,,0,0,0,,Хмм.
Dialogue: 0,1:18:49.80,1:18:52.35,Default,,0,0,0,,Ха... Ах!
Dialogue: 0,1:18:52.43,1:18:54.68,Default,,0,0,0,,Мен бұл аралды күтпедім...
Dialogue: 0,1:18:55.31,1:18:58.15,Default,,0,0,0,,Мен сізге тез арада хабарлауым керек!
Dialogue: 0,1:19:00.11,1:19:01.61,Default,,0,0,0,,Ой!
Dialogue: 0,1:19:02.32,1:19:04.94,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:19:10.91,1:19:13.24,Default,,0,0,0,,Кюккю…кю~
Dialogue: 0,1:19:14.83,1:19:16.37,Default,,0,0,0,,Кю... күй~
Dialogue: 0,1:19:23.67,1:19:24.67,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:19:24.76,1:19:27.67,Default,,0,0,0,,Сықырлау сықырлау... сықырлау
Dialogue: 0,1:19:27.76,1:19:29.05,Default,,0,0,0,,Кю~
Dialogue: 0,1:19:29.13,1:19:30.72,Default,,0,0,0,,Cu...
Dialogue: 0,1:19:30.80,1:19:33.31,Default,,0,0,0,,Ittete ~
Dialogue: 0,1:19:34.10,1:19:35.27,Default,,0,0,0,,Салқын
Dialogue: 0,1:19:37.35,1:19:40.40,Default,,0,0,0,,Иә! Гррр... Ууу
Dialogue: 0,1:19:40.48,1:19:41.86,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,1:19:43.73,1:19:44.82,Default,,0,0,0,,Кю~
Dialogue: 0,1:19:46.90,1:19:47.78,Default,,0,0,0,,Кю~
Dialogue: 0,1:19:49.11,1:19:51.16,Default,,0,0,0,,Гррр... аааа
Dialogue: 0,1:19:54.16,1:19:55.24,Default,,0,0,0,,Кю~
Dialogue: 0,1:19:57.79,1:19:58.62,Default,,0,0,0,,...
Dialogue: 0,1:19:59.46,1:20:00.33,Default,,0,0,0,,Әй!
Dialogue: 0,1:20:00.83,1:20:01.79,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:20:02.83,1:20:03.92,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:20:04.00,1:20:05.00,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:05.92,1:20:08.92,Default,,0,0,0,,Ха ха ха... (кью) cyu~kyu~…
Dialogue: 0,1:20:11.68,1:20:13.43,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:20:13.51,1:20:15.56,Default,,0,0,0,,Кю… Кю~
Dialogue: 0,1:20:16.39,1:20:19.10,Default,,0,0,0,,Ертерек сұмдық айтқаным үшін кешіріңіз.
Dialogue: 0,1:20:19.18,1:20:21.52,Default,,0,0,0,,Тіпті менің қолымнан ештеңе келмейді...
Dialogue: 0,1:20:21.60,1:20:22.77,Default,,0,0,0,,Кю~
Dialogue: 0,1:20:22.85,1:20:26.86,Default,,0,0,0,,Бір күні менің де орнымнан тұрар.
Dialogue: 0,1:20:26.94,1:20:28.24,Default,,0,0,0,,Сонымен, кезек...
Dialogue: 0,1:20:28.32,1:20:30.74,Default,,0,0,0,,Кезектен де бас тартпаңыз
Dialogue: 0,1:20:30.82,1:20:32.16,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:20:34.87,1:20:37.24,Default,,0,0,0,,Екеумізге ғана уәде!
Dialogue: 0,1:20:38.33,1:20:39.66,Default,,0,0,0,,Кю~!
Dialogue: 0,1:20:42.04,1:20:43.54,Default,,0,0,0,,Кю... Кю?
Dialogue: 0,1:20:44.25,1:20:45.63,Default,,0,0,0,,Кю~!
Dialogue: 0,1:20:45.71,1:20:47.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:00.14,1:21:01.52,Default,,0,0,0,,Ах... (дәлел) белгі~
Dialogue: 0,1:21:01.60,1:21:04.44,Default,,0,0,0,,Ағын... жұлдыздар?
Dialogue: 0,1:21:13.78,1:21:16.03,Default,,0,0,0,,Дора-чан, қазір...
Dialogue: 0,1:21:16.12,1:21:18.29,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,1:21:19.04,1:21:20.04,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:35.51,1:21:36.89,Default,,0,0,0,,Тапсырма~! (Нобита) Тапсырма!
Dialogue: 0,1:21:37.47,1:21:41.56,Default,,0,0,0,,(Жаңа динозаврлардың айқайы)
Dialogue: 0,1:21:52.57,1:21:54.28,Default,,0,0,0,,Дора-чан, бұл...
Dialogue: 0,1:21:54.36,1:21:56.57,Default,,0,0,0,,Уф, мен сондай ақымақпын!
Dialogue: 0,1:21:56.66,1:21:59.03,Default,,0,0,0,,Мен мұны байқамағаныма сене алар емеспін!
Dialogue: 0,1:21:59.12,1:22:00.70,Default,,0,0,0,,Дораемон! (Сунео) Шизука-чан!
Dialogue: 0,1:22:00.79,1:22:02.66,Default,,0,0,0,,Джан! Сунео мырза!
Dialogue: 0,1:22:02.75,1:22:04.58,Default,,0,0,0,,Аман-есен аяқталды!
Dialogue: 0,1:22:04.66,1:22:07.17,Default,,0,0,0,,Оның орнына не болып жатыр?
Dialogue: 0,1:22:07.25,1:22:08.67,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,1:22:11.80,1:22:13.59,Default,,0,0,0,,Нобита!
Dialogue: 0,1:22:15.76,1:22:16.89,Default,,0,0,0,,үшінна!
Dialogue: 0,1:22:16.97,1:22:19.72,Default,,0,0,0,,Дораемон, жер бетінде не болып жатыр?
Dialogue: 0,1:22:21.93,1:22:25.35,Default,,0,0,0,,Осыдан тура 66 миллион жыл бұрын
Dialogue: 0,1:22:25.44,1:22:27.23,Default,,0,0,0,,Ха... Мен мұны білдім!
Dialogue: 0,1:22:27.31,1:22:29.48,Default,,0,0,0,,Сонда бұл шынымен метеорит пе еді?
Dialogue: 0,1:22:29.56,1:22:30.57,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,1:22:30.65,1:22:34.24,Default,,0,0,0,,Мексикадағы Юкатан түбегіне метеорит құлады.
Dialogue: 0,1:22:34.32,1:22:37.53,Default,,0,0,0,,Жоғары ұшқан шаң бүкіл жерді қамтиды.
Dialogue: 0,1:22:37.61,1:22:39.82,Default,,0,0,0,,Сонымен не болады?
Dialogue: 0,1:22:40.28,1:22:42.20,Default,,0,0,0,,Мұнда бәрі жақсы, солай ма?
Dialogue: 0,1:22:42.29,1:22:45.37,Default,,0,0,0,,Мексика алыс
Dialogue: 0,1:22:45.46,1:22:46.50,Default,,0,0,0,,Жоқ
Dialogue: 0,1:22:47.79,1:22:51.25,Default,,0,0,0,,Алып метеориттің соғуынан пайда болған шаң
Dialogue: 0,1:22:51.34,1:22:54.92,Default,,0,0,0,,Ыстық желмен жер шарына таралады
Dialogue: 0,1:22:55.01,1:22:57.63,Default,,0,0,0,,Жерді өрте!
Dialogue: 0,1:23:02.14,1:23:05.18,Default,,0,0,0,,Осыдан кейін бұлттар күнді жауып тұрды
Dialogue: 0,1:23:05.27,1:23:07.02,Default,,0,0,0,,Температура төмендегенде...
Dialogue: 0,1:23:08.06,1:23:09.56,Default,,0,0,0,,Динозаврлар...
Dialogue: 0,1:23:09.65,1:23:10.65,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:14.73,1:23:16.74,Default,,0,0,0,,Кю~? (Му) Му~!
Dialogue: 0,1:23:18.24,1:23:19.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:23:19.16,1:23:21.37,Default,,0,0,0,,Мұның осылай аяқталуы мүмкін бе?
Dialogue: 0,1:23:21.45,1:23:24.29,Default,,0,0,0,,Бірақ Дораэмон бұл туралы бірдеңе жасайды, солай ма?
Dialogue: 0,1:23:24.37,1:23:25.45,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,1:23:25.54,1:23:27.75,Default,,0,0,0,,Кешіріңіз Нобита-кун
Dialogue: 0,1:23:27.83,1:23:30.63,Default,,0,0,0,,Сіз тарихты өзгерте алмайсыз.
Dialogue: 0,1:23:30.71,1:23:32.96,Default,,0,0,0,,Уау! Нобита-кун... Ах!
Dialogue: 0,1:23:33.04,1:23:35.80,Default,,0,0,0,,Нобита-сан, тоқтат! (Сунео) Нобита...
Dialogue: 0,1:23:35.88,1:23:38.22,Default,,0,0,0,,Жоқ! Сіз не істемексіз?
Dialogue: 0,1:23:38.93,1:23:40.09,Default,,0,0,0,,Міне!
Dialogue: 0,1:23:40.18,1:23:41.80,Default,,0,0,0,,Бұл «қарсы сағат»!
Dialogue: 0,1:23:41.89,1:23:43.10,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,1:23:43.18,1:23:45.27,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,1:23:45.35,1:23:46.81,Default,,0,0,0,,Дора-чан!
Dialogue: 0,1:23:48.31,1:23:51.60,Default,,0,0,0,,Енді біз уақытты кері бұрып, метеоритті ғарышқа қайтара аламыз!
Dialogue: 0,1:23:52.23,1:23:54.07,Default,,0,0,0,,Нобита-кун, жоқ!
Dialogue: 0,1:23:54.15,1:23:55.57,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,1:23:56.69,1:23:57.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:00.53,1:24:03.45,Default,,0,0,0,,Та… Уақыт патрульі!
Dialogue: 0,1:24:03.53,1:24:05.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:05.16,1:24:07.66,Default,,0,0,0,,Енді екі жаңа динозаврды қойыңыз.
Dialogue: 0,1:24:07.75,1:24:09.25,Default,,0,0,0,,Мына кемеге келіңіз.
Dialogue: 0,1:24:09.91,1:24:12.96,Default,,0,0,0,,Әйтпесе кеңістіктегі қылмыс үшін қамауға алу
Dialogue: 0,1:24:13.04,1:24:15.42,Default,,0,0,0,,Қамау? (Жарқанат жылауы)
Dialogue: 0,1:24:16.09,1:24:18.30,Default,,0,0,0,,Әй, Джан! Апыр-ай!
Dialogue: 0,1:24:18.38,1:24:19.42,Default,,0,0,0,,...Бұл дегеніміз
Dialogue: 0,1:24:19.51,1:24:22.09,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,1:24:22.72,1:24:25.72,Default,,0,0,0,,Бұл дәуірде мен тарихи өзгерістерді бақылап отырамын...
Dialogue: 0,1:24:25.81,1:24:28.22,Default,,0,0,0,,Сәлем! Кью мен Мьюге көмектесу
Dialogue: 0,1:24:28.31,1:24:29.39,Default,,0,0,0,,Сіз алмайсыз ба?
Dialogue: 0,1:24:31.10,1:24:34.27,Default,,0,0,0,,Маған да динозаврлар ұнайды және оларды зерттеуді жалғастырдым.
Dialogue: 0,1:24:34.36,1:24:36.44,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,1:24:36.52,1:24:39.86,Default,,0,0,0,,Бірақ кешіріңіз, мен мұны істей алмаймын.
Dialogue: 0,1:24:40.53,1:24:42.82,Default,,0,0,0,,Бұл өте жаман!
Dialogue: 0,1:24:42.91,1:24:45.33,Default,,0,0,0,,Тарихты өзгертуге рұқсат етілмейді
Dialogue: 0,1:24:45.41,1:24:48.79,Default,,0,0,0,,Метеоритті тоқтатсақ, сіз де, біз де.
Dialogue: 0,1:24:48.87,1:24:50.29,Default,,0,0,0,,Тумайды
Dialogue: 0,1:24:50.37,1:24:52.00,Default,,0,0,0,,Бұл...
Dialogue: 0,1:24:52.08,1:24:55.00,Default,,0,0,0,,Динозаврлар өліп, сүтқоректілер өркендеді.
Dialogue: 0,1:24:55.09,1:24:57.05,Default,,0,0,0,,Нәтижесінде бізде адамдар бар.
Dialogue: 0,1:24:57.13,1:24:58.71,Default,,0,0,0,,Мені тастап кетуге қалай дәтің бар!
Dialogue: 0,1:24:59.34,1:25:01.17,Default,,0,0,0,,Менің қолымнан келмейді!
Dialogue: 0,1:25:01.26,1:25:02.18,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:25:02.26,1:25:06.22,Default,,0,0,0,,Уақытты кері қайтарыңыз Метеоритті ғарышқа қайтарыңыз!
Dialogue: 0,1:25:06.97,1:25:08.85,Default,,0,0,0,,Жоқ! Нобита!
Dialogue: 0,1:25:08.93,1:25:10.10,Default,,0,0,0,,Оны қорғаңыз!
Dialogue: 0,1:25:12.89,1:25:15.06,Default,,0,0,0,,Ах у... а
Dialogue: 0,1:25:15.90,1:25:17.27,Default,,0,0,0,,Уау! иә?
Dialogue: 0,1:25:18.82,1:25:19.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:19.73,1:25:22.03,Default,,0,0,0,,Енді тыныш бол (Нобита) Тоқта!
Dialogue: 0,1:25:22.11,1:25:24.78,Default,,0,0,0,,Қауіпсіз! (Нобита) Q және Mew қорғау.
Dialogue: 0,1:25:24.86,1:25:26.20,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:25:26.28,1:25:27.45,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:25:27.53,1:25:29.54,Default,,0,0,0,,Жоқ... Мынау не жігіт...
Dialogue: 0,1:25:29.62,1:25:30.91,Default,,0,0,0,,Мау!
Dialogue: 0,1:25:31.00,1:25:32.21,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,1:25:32.71,1:25:34.58,Default,,0,0,0,,Шықыр! Шықыр!
Dialogue: 0,1:25:35.50,1:25:37.04,Default,,0,0,0,,(Жақындау)
Dialogue: 0,1:25:37.13,1:25:38.59,Default,,0,0,0,,Мен саған көмектесемін!
Dialogue: 0,1:25:38.67,1:25:40.92,Default,,0,0,0,,Мен Нобита-кунның тұтқындалуына жол бермеймін!
Dialogue: 0,1:25:41.01,1:25:44.18,Default,,0,0,0,,Нобита-сан жай ғана Q мен Мьюді қорғағысы келеді!
Dialogue: 0,1:25:44.26,1:25:45.26,Default,,0,0,0,,Мама!
Dialogue: 0,1:25:45.97,1:25:48.60,Default,,0,0,0,,Ыстық ауаның келуіне санаулы сағаттар ғана қалды.
Dialogue: 0,1:25:48.68,1:25:49.97,Default,,0,0,0,,үшінн алып кетіңіз!
Dialogue: 0,1:25:51.39,1:25:52.93,Default,,0,0,0,,Күте тұрыңыз! (Отряд мүшелері) Иә?
Dialogue: 0,1:25:54.48,1:25:56.65,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,1:25:57.27,1:26:00.61,Default,,0,0,0,,Уайымдама, Джил! Бәрі де күйіп-жанып кетеді!
Dialogue: 0,1:26:01.23,1:26:02.86,Default,,0,0,0,,Гюу!
Dialogue: 0,1:26:02.94,1:26:04.57,Default,,0,0,0,,Шықыр! (Солдат) А...
Dialogue: 0,1:26:04.65,1:26:06.57,Default,,0,0,0,,Сықырлау... иә?
Dialogue: 0,1:26:07.57,1:26:09.53,Default,,0,0,0,,Кю~?
Dialogue: 0,1:26:09.62,1:26:12.00,Default,,0,0,0,,Ооо!
Dialogue: 0,1:26:12.08,1:26:13.37,Default,,0,0,0,,Ой! (Натали) Не?
Dialogue: 0,1:26:14.25,1:26:15.50,Default,,0,0,0,,Ах, а... (электрондық дыбыс)
Dialogue: 0,1:26:17.17,1:26:19.04,Default,,0,0,0,,О...
Dialogue: 0,1:26:19.13,1:26:21.21,Default,,0,0,0,,Мына баланы шешіңіз!
Dialogue: 0,1:26:21.30,1:26:23.51,Default,,0,0,0,,Оларға мүлдем тиіспеңіз!
Dialogue: 0,1:26:23.59,1:26:25.26,Default,,0,0,0,,Не болып жатыр, Джил!
Dialogue: 0,1:26:26.18,1:26:27.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:27.84,1:26:28.97,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:26:29.55,1:26:31.10,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,1:26:31.18,1:26:33.81,Default,,0,0,0,,Біз оларға тиісе алмаймыз.
Dialogue: 0,1:26:33.89,1:26:37.44,Default,,0,0,0,,Тарихтың туып жатқанын көрейік!
Dialogue: 0,1:26:40.73,1:26:44.07,Default,,0,0,0,,Time Patrol жігіттері сізге жақындамайды.
Dialogue: 0,1:26:44.15,1:26:46.03,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:26:46.11,1:26:48.62,Default,,0,0,0,,Бұл адам чек картасын пайдаланды
Dialogue: 0,1:26:48.70,1:26:52.37,Default,,0,0,0,,Өзгерістерді енгізсеңіз, тарих өзгеретін жағдайларға әрекет жасаңыз.
Dialogue: 0,1:26:52.45,1:26:55.96,Default,,0,0,0,,Кю-чан мен Нобита-санға реакцияңыз дегенді қалай түсінесіз?
Dialogue: 0,1:26:56.04,1:26:57.21,Default,,0,0,0,,Хмм.
Dialogue: 0,1:26:57.29,1:26:59.50,Default,,0,0,0,,Сондай қарапайым өмірдің суретіне ұқсайтын бала
Dialogue: 0,1:26:59.58,1:27:02.00,Default,,0,0,0,,Бұл тарихты өзгертпейді деп ойлаймын...
Dialogue: 0,1:27:02.09,1:27:03.46,Default,,0,0,0,,Бұл жаман болды!
Dialogue: 0,1:27:03.55,1:27:06.88,Default,,0,0,0,,Бірақ Нобита ертерек өте жақсы болды!
Dialogue: 0,1:27:06.97,1:27:08.72,Default,,0,0,0,,Жоқ, мен шарасызмын...
Dialogue: 0,1:27:08.80,1:27:10.89,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,1:27:10.97,1:27:13.60,Default,,0,0,0,,Әрине, динозаврларға көмектес!
Dialogue: 0,1:27:13.68,1:27:15.31,Default,,0,0,0,,Бірақ қалай…
Dialogue: 0,1:27:15.39,1:27:16.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:16.43,1:27:18.14,Default,,0,0,0,,Міне...
Dialogue: 0,1:27:18.23,1:27:19.52,Default,,0,0,0,,Сәлем Джан
Dialogue: 0,1:27:19.60,1:27:21.98,Default,,0,0,0,,О! Біз, ұлдар экспедициясы,
Dialogue: 0,1:27:22.07,1:27:24.48,Default,,0,0,0,,Мен керемет жаңалық аштым!
Dialogue: 0,1:27:24.57,1:27:27.07,Default,,0,0,0,,Көру – сену
Dialogue: 0,1:27:28.91,1:27:30.53,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:27:30.62,1:27:33.33,Default,,0,0,0,,Сол тау бір нәрсеге ұқсамайды ма?
Dialogue: 0,1:27:33.41,1:27:35.29,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:27:35.37,1:27:37.37,Default,,0,0,0,,Ах! Мен ойладым
Dialogue: 0,1:27:37.46,1:27:39.79,Default,,0,0,0,,Бұл слайдқа ұқсайды.
Dialogue: 0,1:27:39.87,1:27:41.13,Default,,0,0,0,,Бұл туралы айтатын болсақ!
Dialogue: 0,1:27:41.83,1:27:43.29,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,1:27:43.38,1:27:44.92,Default,,0,0,0,,Темір тор?
Dialogue: 0,1:27:45.00,1:27:45.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:46.42,1:27:47.51,Default,,0,0,0,,Бұл...
Dialogue: 0,1:27:47.59,1:27:49.18,Default,,0,0,0,,Шинадан секіру!
Dialogue: 0,1:27:49.84,1:27:51.59,Default,,0,0,0,,Бұл тауда үш тесік бар!
Dialogue: 0,1:27:51.68,1:27:52.72,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,1:27:52.80,1:27:54.51,Default,,0,0,0,,Бұл бос жердегі саз құбыр!
Dialogue: 0,1:27:55.93,1:27:57.48,Default,,0,0,0,,Олай болса...
Dialogue: 0,1:28:08.28,1:28:09.65,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,1:28:09.74,1:28:12.45,Default,,0,0,0,,Бұл жердің...
Dialogue: 0,1:28:13.28,1:28:15.54,Default,,0,0,0,,Новисавр елі!
Dialogue: 0,1:28:17.00,1:28:18.58,Default,,0,0,0,,«Ноби Ину»
Dialogue: 0,1:28:18.66,1:28:20.67,Default,,0,0,0,,Бұл Нобитаның қолжазбасы екені сөзсіз.
Dialogue: 0,1:28:20.75,1:28:23.21,Default,,0,0,0,,Ұя джунглидегі спорт залы болды.
Dialogue: 0,1:28:23.29,1:28:24.13,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:28:24.96,1:28:28.63,Default,,0,0,0,,Юрада түсірілген диораманың өлшемін реттеу функциясы бұзылған.
Dialogue: 0,1:28:28.72,1:28:31.80,Default,,0,0,0,,Оның көлемі 100 миллион жылдан астам өсті!
Dialogue: 0,1:28:34.14,1:28:36.68,Default,,0,0,0,,Және көптеген жылдар бойы
Dialogue: 0,1:28:36.76,1:28:39.18,Default,,0,0,0,,Табиғи аралға айналды.
Dialogue: 0,1:28:39.27,1:28:40.27,Default,,0,0,0,,Міне!
Dialogue: 0,1:28:40.35,1:28:45.02,Default,,0,0,0,,Егер бұл арал диорамалық жиынтық болса, онда ауа райын реттеу функциясы бар.
Dialogue: 0,1:28:45.11,1:28:47.90,Default,,0,0,0,,Ол динозаврларды сыртқы ортадан қорғауы керек.
Dialogue: 0,1:28:47.98,1:28:49.07,Default,,0,0,0,,Керемет! (Нобита) Бірақ
Dialogue: 0,1:28:49.15,1:28:51.07,Default,,0,0,0,,Арал сыртындағы динозаврлар ше?
Dialogue: 0,1:28:51.15,1:28:52.41,Default,,0,0,0,,Бұл...
Dialogue: 0,1:28:52.49,1:28:54.62,Default,,0,0,0,,Эй, біз оны пайдалана аламыз ба?
Dialogue: 0,1:28:54.70,1:28:56.99,Default,,0,0,0,,Мен Кю-чан мен Мю-чанды жылжыттым...
Dialogue: 0,1:28:57.08,1:28:58.66,Default,,0,0,0,,Бұл қол болды!
Dialogue: 0,1:28:58.75,1:28:59.79,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:28:59.87,1:29:01.25,Default,,0,0,0,,Бұл «ғарышқа саяхатқа арналған қарындаш»!
Dialogue: 0,1:29:01.33,1:29:02.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:02.29,1:29:05.08,Default,,0,0,0,,Джан Сунео Шизука-чан Мю
Dialogue: 0,1:29:05.17,1:29:07.25,Default,,0,0,0,,Сіз аралдан құрлыққа барасыз
Dialogue: 0,1:29:07.34,1:29:09.38,Default,,0,0,0,,Бір жерге мүмкіндігінше көп динозавр жинаңыз.
Dialogue: 0,1:29:09.46,1:29:11.42,Default,,0,0,0,,Оны қызыл түсті қарындашпен дөңгелектеңіз.
Dialogue: 0,1:29:11.51,1:29:13.22,Default,,0,0,0,,Нобита-кун, Q және I
Dialogue: 0,1:29:13.30,1:29:16.14,Default,,0,0,0,,Бұл аралды ақ түсті қарындаштармен қоршаңыз!
Dialogue: 0,1:29:16.76,1:29:18.60,Default,,0,0,0,,Айналуды аяқтаған кезде түймені басыңыз
Dialogue: 0,1:29:18.68,1:29:21.85,Default,,0,0,0,,Динозаврларды сырттан осы аралға жылжытыңыз!
Dialogue: 0,1:29:23.31,1:29:24.90,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:24.98,1:29:26.31,Default,,0,0,0,,Керемет!
Dialogue: 0,1:29:26.94,1:29:29.03,Default,,0,0,0,,Енді сіз барлығына көмектесе аласыз!
Dialogue: 0,1:29:29.11,1:29:32.20,Default,,0,0,0,,Жақсы~ Кью Mew!
Dialogue: 0,1:29:32.86,1:29:33.99,Default,,0,0,0,,Тапсырма~! (Му) Му~!
Dialogue: 0,1:29:34.70,1:29:36.20,Default,,0,0,0,,Бірақ менің уақытым жоқ
Dialogue: 0,1:29:36.28,1:29:40.04,Default,,0,0,0,,Ыстық ауа келмей тұрып орындайық. Бұл қауіпті, бірақ...
Dialogue: 0,1:29:40.12,1:29:43.29,Default,,0,0,0,,Бірақ! Әлі үміт бар
Dialogue: 0,1:29:43.37,1:29:46.00,Default,,0,0,0,,Жарайды, жасайық (Сунео) Иә.
Dialogue: 0,1:29:46.08,1:29:48.21,Default,,0,0,0,,Иә! (Му) Му~!
Dialogue: 0,1:29:48.84,1:29:51.67,Default,,0,0,0,,Жақсы! Динозаврларды құтқару миссиясы басталады!
Dialogue: 0,1:29:52.30,1:29:53.72,Default,,0,0,0,,О!
Dialogue: 0,1:29:55.22,1:29:57.18,Default,,0,0,0,,Сіз күдікті әрекет етіп жатырсыз.
Dialogue: 0,1:29:57.68,1:29:59.85,Default,,0,0,0,,Бірдеңе болса жауапкершілікті өз мойныма аламын ба?
Dialogue: 0,1:30:00.47,1:30:02.48,Default,,0,0,0,,Тірі табиғат тарихына арналған
Dialogue: 0,1:30:02.56,1:30:05.14,Default,,0,0,0,,Бұл шешуші сәт болуы мүмкін
Dialogue: 0,1:30:05.23,1:30:07.06,Default,,0,0,0,,Тағы сәл күте аласыз ба?
Dialogue: 0,1:30:09.15,1:30:10.44,Default,,0,0,0,,Бір сағат.
Dialogue: 0,1:30:11.19,1:30:13.69,Default,,0,0,0,,Уақыты келгенде мен оларды алып кетемін.
Dialogue: 0,1:30:13.78,1:30:14.74,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:30:23.70,1:30:25.04,Default,,0,0,0,,Біз де!
Dialogue: 0,1:30:25.12,1:30:26.00,Default,,0,0,0,,Иә!
Dialogue: 0,1:30:27.46,1:30:28.96,Default,,0,0,0,,Кезек, осында күт.
Dialogue: 0,1:30:29.04,1:30:30.34,Default,,0,0,0,,Кю... Кю~!
Dialogue: 0,1:30:30.42,1:30:32.67,Default,,0,0,0,,"Баспропеллер" енді жоқ
Dialogue: 0,1:30:32.76,1:30:34.22,Default,,0,0,0,,Кю~
Dialogue: 0,1:30:36.76,1:30:40.85,Default,,0,0,0,,Уайымдамаңыз, сіз міндетті түрде кезекпен ұша аласыз!
Dialogue: 0,1:30:40.93,1:30:42.22,Default,,0,0,0,,Сіз уәде бердіңіз, солай ма?
Dialogue: 0,1:30:42.31,1:30:43.72,Default,,0,0,0,,Кеттік, Нобита-кун!
Dialogue: 0,1:30:43.81,1:30:44.77,Default,,0,0,0,,Иә!
Dialogue: 0,1:30:49.56,1:30:50.86,Default,,0,0,0,,Кю~
Dialogue: 0,1:30:50.94,1:30:51.94,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:30:56.15,1:30:57.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:02.74,1:31:04.95,Default,,0,0,0,,Бүкіл аралды қоршаңыз!
Dialogue: 0,1:31:05.04,1:31:06.29,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:06.37,1:31:08.08,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:31:08.75,1:31:10.54,Default,,0,0,0,,О, ау... Уау!
Dialogue: 0,1:31:10.63,1:31:13.34,Default,,0,0,0,,Бұл ол! (Нобита) Неге келдің?
Dialogue: 0,1:31:14.09,1:31:15.51,Default,,0,0,0,,(айқай)
Dialogue: 0,1:31:15.59,1:31:17.88,Default,,0,0,0,,Иә? Мен бардым...
Dialogue: 0,1:31:17.97,1:31:20.09,Default,,0,0,0,,Ах! үшінның ұясы сонда!
Dialogue: 0,1:31:20.18,1:31:22.39,Default,,0,0,0,,Нобита-кун жалғастырғысы келеді!
Dialogue: 0,1:31:22.47,1:31:23.47,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:31:26.81,1:31:28.44,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:31:29.69,1:31:31.31,Default,,0,0,0,,Доқан! Ілгері жүру!
Dialogue: 0,1:31:32.48,1:31:34.40,Default,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,1:31:35.44,1:31:37.65,Default,,0,0,0,,Үлкен! Ол жігіт...
Dialogue: 0,1:31:37.74,1:31:38.99,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,1:31:39.07,1:31:40.91,Default,,0,0,0,,Ха!
Dialogue: 0,1:31:40.99,1:31:41.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:31:46.33,1:31:48.46,Default,,0,0,0,,А... осында.
Dialogue: 0,1:31:50.83,1:31:51.67,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:31:54.46,1:31:56.38,Default,,0,0,0,,Хаха...
Dialogue: 0,1:31:56.46,1:32:00.26,Default,,0,0,0,,Шизука-чан, мұнда мүмкіндігінше үлкен шеңбер сызыңыз!
Dialogue: 0,1:32:00.34,1:32:02.68,Default,,0,0,0,,Мен және Сунео динозаврларды әкеліп жатырмыз!
Dialogue: 0,1:32:02.76,1:32:03.76,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,1:32:03.85,1:32:04.85,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,1:32:05.47,1:32:06.77,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:32:06.85,1:32:09.14,Default,,0,0,0,,Міне, динозаврларды жойған ыстық жел!
Dialogue: 0,1:32:09.23,1:32:10.81,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:32:10.90,1:32:13.56,Default,,0,0,0,,(жұмыртқа экспедициясының дауысы)
Dialogue: 0,1:32:13.65,1:32:15.86,Default,,0,0,0,,Чулчуру…
Dialogue: 0,1:32:17.15,1:32:19.74,Default,,0,0,0,,Причу... Кя~!
Dialogue: 0,1:32:19.82,1:32:21.78,Default,,0,0,0,,«Жұмыртқа зерттеушілері»!
Dialogue: 0,1:32:21.86,1:32:23.78,Default,,0,0,0,,Мына балалар сізге көмектессін.
Dialogue: 0,1:32:23.87,1:32:25.03,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:32:25.12,1:32:26.33,Default,,0,0,0,,Притч…
Dialogue: 0,1:32:26.41,1:32:28.08,Default,,0,0,0,,Му~!
Dialogue: 0,1:32:28.16,1:32:29.58,Default,,0,0,0,,Оны жеме!
Dialogue: 0,1:32:29.66,1:32:34.38,Default,,0,0,0,,Бірақ мен динозаврлардың мені тыңдауына қалай ықпал ете аламын?
Dialogue: 0,1:32:34.46,1:32:36.59,Default,,0,0,0,,Бәрі бітті, Джан.
Dialogue: 0,1:32:36.67,1:32:37.92,Default,,0,0,0,,О, мінеки!
Dialogue: 0,1:32:38.01,1:32:39.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:40.01,1:32:42.39,Default,,0,0,0,,Гол! (Сунео) Жоғары!
Dialogue: 0,1:32:42.97,1:32:44.39,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:32:44.47,1:32:47.06,Default,,0,0,0,,Келдің, қымбатты досым!
Dialogue: 0,1:32:47.14,1:32:49.31,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:32:49.39,1:32:51.85,Default,,0,0,0,,Гол-чан! Топ-чан!
Dialogue: 0,1:32:52.52,1:32:55.36,Default,,0,0,0,,Адамдар сізді тыңдамаса да...
Dialogue: 0,1:32:55.44,1:32:58.36,Default,,0,0,0,,Достарым айту керек болса, мен тыңдаймын!
Dialogue: 0,1:32:59.94,1:33:02.41,Default,,0,0,0,,«Әуе зеңбірегі»! Не?!
Dialogue: 0,1:33:03.49,1:33:05.99,Default,,0,0,0,,(айқай)
Dialogue: 0,1:33:06.08,1:33:08.29,Default,,0,0,0,,А... осылай!
Dialogue: 0,1:33:11.12,1:33:13.67,Default,,0,0,0,,Иә! Егер сіз оны «Small Light» көмегімен кішірейтсеңіз...
Dialogue: 0,1:33:14.29,1:33:16.13,Default,,0,0,0,,«Кішкентай жарық»…
Dialogue: 0,1:33:16.21,1:33:19.09,Default,,0,0,0,,Барлық шегіртке кәмпиттері... Уау!
Dialogue: 0,1:33:20.09,1:33:22.68,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:33:22.76,1:33:23.80,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:33:23.88,1:33:24.76,Default,,0,0,0,,Бұлбу!
Dialogue: 0,1:33:24.84,1:33:25.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:26.05,1:33:27.93,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:33:28.01,1:33:29.14,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:30.81,1:33:31.93,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,1:33:32.02,1:33:33.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:33.27,1:33:34.15,Default,,0,0,0,,Ха!
Dialogue: 0,1:33:37.94,1:33:40.07,Default,,0,0,0,,Кю… Кю~
Dialogue: 0,1:33:42.07,1:33:43.03,Default,,0,0,0,,Cu…
Dialogue: 0,1:33:43.11,1:33:44.28,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,1:33:45.07,1:33:46.70,Default,,0,0,0,,Тапсырма!
Dialogue: 0,1:33:48.45,1:33:49.62,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,1:33:52.00,1:33:55.17,Default,,0,0,0,,Кю… Кю~ Кю~!
Dialogue: 0,1:33:55.92,1:33:56.96,Default,,0,0,0,,Нигеро!
Dialogue: 0,1:33:58.00,1:33:59.80,Default,,0,0,0,,...
Dialogue: 0,1:33:59.88,1:34:01.13,Default,,0,0,0,,Кю~!
Dialogue: 0,1:34:01.67,1:34:03.01,Default,,0,0,0,,Кю~!
Dialogue: 0,1:34:03.09,1:34:05.55,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:34:06.93,1:34:07.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:08.05,1:34:09.81,Default,,0,0,0,,Екі бетке жиырма минут деді ме? Дұрыс естімеген шығармын?
Dialogue: 0,1:34:10.97,1:34:13.27,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:34:13.35,1:34:15.06,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:34:15.14,1:34:17.10,Default,,0,0,0,,Уау! Хмм
Dialogue: 0,1:34:24.15,1:34:27.03,Default,,0,0,0,,То... Нагете Кью
Dialogue: 0,1:34:27.62,1:34:29.83,Default,,0,0,0,,Кю~ Кю…
Dialogue: 0,1:34:30.33,1:34:31.49,Default,,0,0,0,,Кю... күй!
Dialogue: 0,1:34:31.58,1:34:34.33,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,1:34:43.26,1:34:46.38,Default,,0,0,0,,Осы жолмен! Мұнда кел, нигеро
Dialogue: 0,1:34:46.47,1:34:48.43,Default,,0,0,0,,Қараңызшы, бұл осылай!
Dialogue: 0,1:34:49.43,1:34:51.31,Default,,0,0,0,,үшінңыз, осы жаққа келіңіздер!
Dialogue: 0,1:34:51.39,1:34:53.18,Default,,0,0,0,,Дүрбелең емес!
Dialogue: 0,1:35:02.23,1:35:03.69,Default,,0,0,0,,Му~!
Dialogue: 0,1:35:11.37,1:35:12.95,Default,,0,0,0,,Дайын!
Dialogue: 0,1:35:13.04,1:35:14.62,Default,,0,0,0,,Уф! (Мия) Мия~
Dialogue: 0,1:35:14.70,1:35:15.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:35:18.58,1:35:21.21,Default,,0,0,0,,Өтінемін! сәл артық
Dialogue: 0,1:35:24.88,1:35:26.80,Default,,0,0,0,,Сіз маған әлі де оны көруді айтып жатырсыз ба?
Dialogue: 0,1:35:26.88,1:35:29.43,Default,,0,0,0,,Бұлай жалғаса берсе, олардың өміріне қауіп төнеді!
Dialogue: 0,1:35:29.51,1:35:32.72,Default,,0,0,0,,Тағы біраз... тағы да
Dialogue: 0,1:35:32.81,1:35:34.39,Default,,0,0,0,,Кү…
Dialogue: 0,1:35:34.47,1:35:35.68,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:37.10,1:35:38.39,Default,,0,0,0,,Кезек…
Dialogue: 0,1:35:44.07,1:35:45.07,Default,,0,0,0,,Кю~
Dialogue: 0,1:35:45.61,1:35:46.65,Default,,0,0,0,,...
Dialogue: 0,1:35:47.49,1:35:50.36,Default,,0,0,0,,Енді реплика кезегі.
Dialogue: 0,1:35:52.91,1:35:55.29,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:35:59.92,1:36:01.00,Default,,0,0,0,,Кю~
Dialogue: 0,1:36:02.75,1:36:03.71,Default,,0,0,0,,...
Dialogue: 0,1:36:08.38,1:36:10.63,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,1:36:10.72,1:36:12.60,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,1:36:12.68,1:36:14.64,Default,,0,0,0,,Қауіпті! араласу
Dialogue: 0,1:36:14.72,1:36:18.02,Default,,0,0,0,,Күте тұрыңыз! Мына жаңа динозаврды қараңыз.
Dialogue: 0,1:36:18.73,1:36:22.10,Default,,0,0,0,,Кюуу!
Dialogue: 0,1:36:22.86,1:36:23.98,Default,,0,0,0,,Кю~
Dialogue: 0,1:36:24.06,1:36:25.32,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:36:27.74,1:36:28.86,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:36:28.94,1:36:31.61,Default,,0,0,0,,Кю… Кю~
Dialogue: 0,1:36:31.70,1:36:32.78,Default,,0,0,0,,Кю... Кю~!
Dialogue: 0,1:36:32.87,1:36:33.70,Default,,0,0,0,,Cu…
Dialogue: 0,1:36:34.33,1:36:35.66,Default,,0,0,0,,Шықыр! Ky…
Dialogue: 0,1:36:37.75,1:36:39.62,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:36:39.71,1:36:40.87,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:36:41.67,1:36:45.29,Default,,0,0,0,,Кюуу!
Dialogue: 0,1:36:45.38,1:36:46.67,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:36:51.09,1:36:52.05,Default,,0,0,0,,Кю…
Dialogue: 0,1:36:53.68,1:36:55.26,Default,,0,0,0,,Кю~!
Dialogue: 0,1:36:53.68,1:36:55.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:36:55.35,1:36:56.89,Default,,0,0,0,,Му және басқа достар да
Dialogue: 0,1:36:56.97,1:36:59.27,Default,,0,0,0,,Қолдарыңды олай қозғамаңдар!
Dialogue: 0,1:36:59.35,1:37:01.23,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:37:01.31,1:37:03.90,Default,,0,0,0,,Шықыр! Сықырлау...
Dialogue: 0,1:37:05.36,1:37:07.19,Default,,0,0,0,,Сықырлау... Сықырлау...
Dialogue: 0,1:37:07.27,1:37:08.69,Default,,0,0,0,,Жігіт…
Dialogue: 0,1:37:08.78,1:37:11.36,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,1:37:11.45,1:37:14.32,Default,,0,0,0,,Тәжірибе жасасаңыз, Мью сияқты ұша аласыз.
Dialogue: 0,1:37:15.82,1:37:17.16,Default,,0,0,0,,Кю~!
Dialogue: 0,1:37:18.16,1:37:20.54,Default,,0,0,0,,Сіз ұша аласыз
Dialogue: 0,1:37:21.16,1:37:23.75,Default,,0,0,0,,Мен міндетті түрде...
Dialogue: 0,1:37:23.83,1:37:25.04,Default,,0,0,0,,Мен де бір күні
Dialogue: 0,1:37:25.13,1:37:27.75,Default,,0,0,0,,Тұра алатыныңызды көрсетіңіз
Dialogue: 0,1:37:27.84,1:37:29.21,Default,,0,0,0,,Сонымен, кезек...
Dialogue: 0,1:37:30.17,1:37:32.22,Default,,0,0,0,,Кезектен де бас тартпаңыз
Dialogue: 0,1:37:33.30,1:37:35.18,Default,,0,0,0,,Ки... Кюу
Dialogue: 0,1:37:36.39,1:37:37.22,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:37:38.51,1:37:41.77,Default,,0,0,0,,Кюуууу~
Dialogue: 0,1:37:41.85,1:37:44.19,Default,,0,0,0,,Кюуу~
Dialogue: 0,1:37:44.27,1:37:45.23,Default,,0,0,0,,Кю~!
Dialogue: 0,1:37:52.36,1:37:53.45,Default,,0,0,0,,Кю…
Dialogue: 0,1:37:53.53,1:37:54.53,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:37:58.24,1:38:01.12,Default,,0,0,0,,Кюуу...
Dialogue: 0,1:38:01.20,1:38:02.45,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:38:05.92,1:38:06.79,Default,,0,0,0,,Ұш!
Dialogue: 0,1:38:06.88,1:38:12.76,Default,,0,0,0,,Кюуу!
Dialogue: 0,1:38:12.84,1:38:14.17,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:38:15.63,1:38:18.80,Default,,0,0,0,,Кюууу!
Dialogue: 0,1:38:18.89,1:38:20.31,Default,,0,0,0,,Сықырлау
Dialogue: 0,1:38:20.39,1:38:22.22,Default,,0,0,0,,Кю... Кю~!
Dialogue: 0,1:38:22.31,1:38:24.69,Default,,0,0,0,,Ұш! Ұш!
Dialogue: 0,1:38:25.77,1:38:26.73,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:38:28.44,1:38:29.65,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:38:29.73,1:38:32.19,Default,,0,0,0,,Барыңыз, жетіңіз!
Dialogue: 0,1:38:32.28,1:38:33.78,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:38:34.86,1:38:36.16,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:38:36.24,1:38:38.91,Default,,0,0,0,,Ұш, белгі!
Dialogue: 0,1:38:38.99,1:38:41.12,Default,,0,0,0,,Кю... күй
Dialogue: 0,1:38:46.54,1:38:47.83,Default,,0,0,0,,Кю~?
Dialogue: 0,1:38:47.92,1:38:50.42,Default,,0,0,0,,Сіздің атыңыз Кю!
Dialogue: 0,1:38:52.25,1:38:55.13,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:38:59.05,1:39:00.35,Default,,0,0,0,,Сықырлау...
Dialogue: 0,1:39:10.94,1:39:12.61,Default,,0,0,0,,Ол ұшты!
Dialogue: 0,1:39:12.69,1:39:14.82,Default,,0,0,0,,Тапсырма! Ұшу...
Dialogue: 0,1:39:15.49,1:39:16.40,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,1:39:22.66,1:39:23.54,Default,,0,0,0,,Шықыр!
Dialogue: 0,1:39:25.87,1:39:29.25,Default,,0,0,0,,Кю... Кю? Сықырлау
Dialogue: 0,1:39:29.33,1:39:30.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:31.17,1:39:33.13,Default,,0,0,0,,Ой, бұл таңқаларлық!
Dialogue: 0,1:39:33.21,1:39:35.09,Default,,0,0,0,,Кілт~ Кілт~!
Dialogue: 0,1:39:35.17,1:39:38.38,Default,,0,0,0,,Ұша алар едің... Ұша алар едің!
Dialogue: 0,1:39:38.47,1:39:39.64,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:39:40.22,1:39:41.05,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:41.14,1:39:43.01,Default,,0,0,0,,А, бұл ол!
Dialogue: 0,1:39:43.10,1:39:44.52,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:39:44.60,1:39:47.56,Default,,0,0,0,,Хмм... Иә? Мұнда...
Dialogue: 0,1:39:47.64,1:39:48.48,Default,,0,0,0,,Не!
Dialogue: 0,1:39:49.48,1:39:51.73,Default,,0,0,0,,Нобита-кун ше? (Нобита) Дораемон!
Dialogue: 0,1:39:51.81,1:39:53.94,Default,,0,0,0,,Нобита-кун Кью!
Dialogue: 0,1:39:54.02,1:39:56.40,Default,,0,0,0,,Қараңдар! Бұл жолы...
Dialogue: 0,1:39:56.49,1:39:58.57,Default,,0,0,0,,«Шегіртке кәмпит»!
Dialogue: 0,1:39:58.65,1:39:59.61,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,1:40:00.66,1:40:03.33,Default,,0,0,0,,Нобита-кун, түзу жүр!
Dialogue: 0,1:40:03.41,1:40:05.04,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:40:05.12,1:40:07.25,Default,,0,0,0,,«Кішкентай жарық»!
Dialogue: 0,1:40:10.04,1:40:11.92,Default,,0,0,0,,(айқай)
Dialogue: 0,1:40:12.00,1:40:13.54,Default,,0,0,0,,(айқай)
Dialogue: 0,1:40:14.63,1:40:16.26,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,1:40:16.34,1:40:18.26,Default,,0,0,0,,Жарайсың Дораемон!
Dialogue: 0,1:40:18.34,1:40:20.97,Default,,0,0,0,,Нобита-кун, бізде уақыт жоқ! қарындашты шығарыңыз
Dialogue: 0,1:40:21.05,1:40:23.18,Default,,0,0,0,,Не? Бұл?
Dialogue: 0,1:40:25.51,1:40:27.85,Default,,0,0,0,,Ааа... тек сұрау ғана қалды.
Dialogue: 0,1:40:29.23,1:40:30.27,Default,,0,0,0,,Тапсырма!
Dialogue: 0,1:40:30.85,1:40:31.81,Default,,0,0,0,,Тапсырма~!
Dialogue: 0,1:40:32.94,1:40:35.52,Default,,0,0,0,,Тек алға!
Dialogue: 0,1:40:35.61,1:40:36.90,Default,,0,0,0,,Ұшты...
Dialogue: 0,1:40:36.98,1:40:40.49,Default,,0,0,0,,Ол ұшты! Бұл эволюция сәті
Dialogue: 0,1:40:40.57,1:40:42.41,Default,,0,0,0,,Сол ыңғайсыз қозғалыс
Dialogue: 0,1:40:42.49,1:40:44.70,Default,,0,0,0,,Қанаттарын қағудың белгісі болды ма?
Dialogue: 0,1:40:44.78,1:40:48.25,Default,,0,0,0,,Динозаврлар сырғанау арқылы қанаттарын қағуды үйренді.
Dialogue: 0,1:40:48.33,1:40:50.41,Default,,0,0,0,,Құс болуға алғашқы қадам жасау
Dialogue: 0,1:40:50.50,1:40:55.17,Default,,0,0,0,,Біз эволюцияның сол сәтіне жаңа ғана куә болдық!
Dialogue: 0,1:40:55.79,1:40:57.59,Default,,0,0,0,,Олар жойылып кетпейді
Dialogue: 0,1:40:57.67,1:41:00.42,Default,,0,0,0,,Құсқа айналып, өмірін жалғастыр
Dialogue: 0,1:41:00.51,1:41:02.84,Default,,0,0,0,,Әлгі бала осында
Dialogue: 0,1:41:02.93,1:41:05.85,Default,,0,0,0,,Егер біз сол жаңа динозаврды қорғауға тырыспасақ...
Dialogue: 0,1:41:05.93,1:41:09.81,Default,,0,0,0,,Жердің тарихы басқаша болуы мүмкін
Dialogue: 0,1:41:10.48,1:41:11.56,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:41:11.64,1:41:13.48,Default,,0,0,0,,Такеши-сан! Сунео мырза!
Dialogue: 0,1:41:13.56,1:41:15.02,Default,,0,0,0,,Мен олардың көпшілігін жинадым!
Dialogue: 0,1:41:15.11,1:41:16.86,Default,,0,0,0,,Сіз әлі Дораемоннан естідіңіз бе?
Dialogue: 0,1:41:16.94,1:41:19.74,Default,,0,0,0,,(Қабылданған дыбыс)
Dialogue: 0,1:41:19.82,1:41:21.28,Default,,0,0,0,,Сәлеметсіз бе, Дора-чан?
Dialogue: 0,1:41:21.36,1:41:22.74,Default,,0,0,0,,Шизука-чан, сен ше?
Dialogue: 0,1:41:22.82,1:41:23.70,Default,,0,0,0,,Дайындық жақсы!
Dialogue: 0,1:41:23.78,1:41:25.07,Default,,0,0,0,,Асығыңыз! (Сунео) Сен жанып өлесің!
Dialogue: 0,1:41:25.16,1:41:26.99,Default,,0,0,0,,Жақсы! Жарайды, кеттік
Dialogue: 0,1:41:27.66,1:41:28.58,Default,,0,0,0,,５！
Dialogue: 0,1:41:30.87,1:41:32.79,Default,,0,0,0,,Кью Сәттілік! (Күйе) Кілт~!
Dialogue: 0,1:41:33.42,1:41:34.46,Default,,0,0,0,,４！
Dialogue: 0,1:41:39.05,1:41:40.05,Default,,0,0,0,,３！
Dialogue: 0,1:41:41.22,1:41:43.09,Default,,0,0,0,,Енді қарындаштар жоқ... 2!
Dialogue: 0,1:41:43.18,1:41:44.59,Default,,0,0,0,,Кю~! (Нобита) Ах!
Dialogue: 0,1:41:46.39,1:41:47.47,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,1:41:48.10,1:41:49.14,Default,,0,0,0,,１！
Dialogue: 0,1:41:49.85,1:41:51.27,Default,,0,0,0,,...
Dialogue: 0,1:41:52.18,1:41:53.39,Default,,0,0,0,,Нөл!
Dialogue: 0,1:42:14.29,1:42:18.92,Default,,0,0,0,,(динозавр дыбыстары)
Dialogue: 0,1:42:20.71,1:42:22.59,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,1:42:31.31,1:42:37.06,Default,,0,0,0,,♪～
Dialogue: 0,1:42:48.82,1:42:53.00,Default,,0,0,0,,Меу~ (кескін) белгі? Кю~!
Dialogue: 0,1:42:53.08,1:42:55.00,Default,,0,0,0,,Му~
Dialogue: 0,1:42:55.58,1:42:56.96,Default,,0,0,0,,Му~
Dialogue: 0,1:42:58.75,1:43:02.09,Default,,0,0,0,,Нобита-кун, қоштасуымыз керек пе?
Dialogue: 0,1:43:02.17,1:43:04.30,Default,,0,0,0,,Иә, қоштасқаннан кейін
Dialogue: 0,1:43:04.38,1:43:06.22,Default,,0,0,0,,Ажырасу оны тек қиындатады.
Dialogue: 0,1:43:08.14,1:43:10.05,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,1:43:10.14,1:43:13.10,Default,,0,0,0,,Үйге қайтайық! Біздің заманға
Dialogue: 0,1:43:16.14,1:43:18.81,Default,,0,0,0,,Гол, Гол! Жоғары!
Dialogue: 0,1:43:18.90,1:43:21.06,Default,,0,0,0,,Гол! Сау болыңыз
Dialogue: 0,1:43:21.15,1:43:23.28,Default,,0,0,0,,Біз әрқашан дос боламыз!
Dialogue: 0,1:43:23.36,1:43:25.28,Default,,0,0,0,,Рахмет Жоғары…
Dialogue: 0,1:43:29.20,1:43:30.62,Default,,0,0,0,,«Бастап көріп, не боларын көрейік» дегендей. Хмм…
Dialogue: 0,1:43:30.70,1:43:32.20,Default,,0,0,0,,Біз бірден жойылып кетер едік.
Dialogue: 0,1:43:33.54,1:43:34.95,Default,,0,0,0,,Кю~!
Dialogue: 0,1:43:35.04,1:43:36.41,Default,,0,0,0,,Ха!
Dialogue: 0,1:43:38.46,1:43:39.71,Default,,0,0,0,,Кю~!
Dialogue: 0,1:43:39.79,1:43:41.21,Default,,0,0,0,,Му~!
Dialogue: 0,1:43:42.71,1:43:45.05,Default,,0,0,0,,Келме! Келме
Dialogue: 0,1:43:45.13,1:43:46.76,Default,,0,0,0,,Му? (Күйе) Сілтеме?
Dialogue: 0,1:43:47.55,1:43:51.05,Default,,0,0,0,,Балалар сендер осында тұрасыңдар.
Dialogue: 0,1:43:52.60,1:43:54.97,Default,,0,0,0,,Мен сенің аман болатыныңа сенімдімін.
Dialogue: 0,1:43:55.52,1:43:57.94,Default,,0,0,0,,Өйткені мен сенемін!
Dialogue: 0,1:43:59.69,1:44:01.90,Default,,0,0,0,,(Жаңа динозаврлардың дыбыстары)
Dialogue: 0,1:44:09.32,1:44:10.49,Default,,0,0,0,,Кю…
Dialogue: 0,1:44:11.91,1:44:12.74,Default,,0,0,0,,Cu…
Dialogue: 0,1:44:20.37,1:44:22.33,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:44:22.42,1:44:24.21,Default,,0,0,0,,Қош бол, Му-чан!
Dialogue: 0,1:44:24.29,1:44:25.71,Default,,0,0,0,,Сен өте тәртіпсізсің.
Dialogue: 0,1:44:25.80,1:44:29.26,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,1:44:31.39,1:44:34.10,Default,,0,0,0,,Хаха...
Dialogue: 0,1:44:38.10,1:44:39.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:44:45.90,1:44:47.65,Default,,0,0,0,,Тағы бір күні
Dialogue: 0,1:44:47.73,1:44:49.90,Default,,0,0,0,,Бір жерде міндетті түрде кездесейік!
Dialogue: 0,1:44:51.99,1:44:53.82,Default,,0,0,0,,Басқаларға қамқорлық жасау
Dialogue: 0,1:44:54.45,1:44:59.00,Default,,0,0,0,,Мұндай эмоциялар тек адамдарда ғана дамыған қабілет болуы мүмкін.
Dialogue: 0,1:44:59.08,1:45:02.08,Default,,0,0,0,,Динозаврлардың ұшу үшін қанаттары пайда болғаны сияқты.
Dialogue: 0,1:45:02.87,1:45:07.09,Default,,0,0,0,,Адамдарда көптеген сезімдер пайда болды
Dialogue: 0,1:45:07.17,1:45:10.38,Default,,0,0,0,,Мен оларға қарасам солай ойлаймын.
Dialogue: 0,1:45:18.72,1:45:21.02,Default,,0,0,0,,Меу! (Күйе) Кілт!
Dialogue: 0,1:45:21.02,1:45:24.40,Default,,0,0,0,,Мау! (Күйе) Кілт!
Dialogue: 0,1:45:21.02,1:45:24.40,Default,,0,0,0,,～♪
Dialogue: 0,1:45:24.40,1:45:26.02,Default,,0,0,0,,～♪
Dialogue: 0,1:45:26.15,1:45:28.11,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,1:45:28.19,1:45:30.94,Default,,0,0,0,,(көкөністерді кесу дыбысы)
Dialogue: 0,1:45:33.49,1:45:34.66,Default,,0,0,0,,Нобита
Dialogue: 0,1:45:34.74,1:45:37.16,Default,,0,0,0,,Жазғы демалыс деп мәңгі ұйықтама
Dialogue: 0,1:45:37.24,1:45:38.95,Default,,0,0,0,,Оян!
Dialogue: 0,1:45:39.70,1:45:41.16,Default,,0,0,0,,Хмм... Йотто
Dialogue: 0,1:45:50.01,1:45:51.17,Default,,0,0,0,,Хехе
Dialogue: 0,1:45:59.43,1:46:02.73,Default,,0,0,0,,Иә! Кукукуку…
Dialogue: 0,1:46:03.64,1:46:05.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:09.48,1:46:13.82,Default,,0,0,0,,Иә! Куку куку куку…
Dialogue: 0,1:46:14.99,1:46:15.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:46:16.53,1:46:17.82,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:18.49,1:46:19.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:22.20,1:46:23.62,Default,,0,0,0,,Дайын
Dialogue: 0,1:46:24.16,1:46:29.17,Default,,0,0,0,,(Құстардың қанаттарын қағу)
Dialogue: 0,1:46:31.88,1:46:36.89,Default,,0,0,0,,♪～
Dialogue: 0,1:50:00.26,1:50:05.26,Default,,0,0,0,,～♪
