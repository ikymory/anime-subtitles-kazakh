Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Жаяу жүргіңіз келе ме?
Dialogue: 0,0:00:05.81,0:00:08.54,Default,,0,0,0,,Жылы және көңілді жерге
Dialogue: 0,0:00:09.05,0:00:11.37,Default,,0,0,0,,Сіз мұны істегіңіз келеді, солай ма?
Dialogue: 0,0:00:13.09,0:00:13.86,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:15.01,0:00:17.02,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:00:34.90,0:00:40.34,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:00:40.48,0:00:45.91,Default,,0,0,0,,Көптеген жылы күн бассейндері пайда болды.
Dialogue: 0,0:00:46.04,0:00:51.19,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:00:51.33,0:00:58.49,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:00:58.95,0:01:06.79,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:01:06.79,0:01:12.64,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:01:12.78,0:01:20.46,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:01:20.58,0:01:27.08,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:01:27.37,0:01:29.89,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:01:29.49,0:01:31.91,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:01:31.51,0:01:33.97,Default,,0,0,0,,Тек бір ғана
Dialogue: 0,0:01:33.57,0:01:36.66,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:01:36.26,0:01:40.87,Default,,0,0,0,,Мен саған жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:01:40.37,0:01:45.68,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын
Dialogue: 0,0:01:51.04,0:01:52.61,Default,,0,0,0,,Әй, ана, мына жерге қара.
Dialogue: 0,0:01:52.63,0:01:53.25,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:01:53.35,0:01:54.50,Default,,0,0,0,,Hey hey itteba
Dialogue: 0,0:01:54.64,0:01:55.21,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:01:55.33,0:01:55.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.35,0:01:58.00,Default,,0,0,0,,Не?
Dialogue: 0,0:01:58.41,0:01:59.21,Default,,0,0,0,,Ойнату
Dialogue: 0,0:02:00.59,0:02:02.58,Default,,0,0,0,,Санаэ-санмен не істеп жатырсың?
Dialogue: 0,0:02:03.41,0:02:04.54,Default,,0,0,0,,Read the book
Dialogue: 0,0:02:04.93,0:02:06.19,Default,,0,0,0,,Сіз оны әкелесіз бе?
Dialogue: 0,0:02:08.82,0:02:10.13,Default,,0,0,0,,Қарт деген не?
Dialogue: 0,0:02:10.34,0:02:11.15,Default,,0,0,0,,Бейсбол
Dialogue: 0,0:02:11.68,0:02:12.46,Default,,0,0,0,,Бейсбол?
Dialogue: 0,0:02:12.71,0:02:14.25,Default,,0,0,0,,Yes, look
Dialogue: 0,0:02:18.97,0:02:19.61,Default,,0,0,0,,Komada
Dialogue: 0,0:02:20.21,0:02:21.44,Default,,0,0,0,,Impersonation?
Dialogue: 0,0:02:22.85,0:02:23.94,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:02:23.94,0:02:25.02,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:02:26.80,0:02:27.78,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:02:28.70,0:02:30.95,Default,,0,0,0,,Қарт маған не үйретіп жатыр екен...
Dialogue: 0,0:02:32.48,0:02:36.11,Default,,0,0,0,,Анашым, анашым, мені тыңда.
Dialogue: 0,0:02:36.29,0:02:37.99,Default,,0,0,0,,Жүр, дұрыс отыр.
Dialogue: 0,0:02:38.10,0:02:40.87,Default,,0,0,0,,Hey mama mama!
Dialogue: 0,0:02:40.96,0:02:43.06,Default,,0,0,0,,Үндемесең ұяласың.
Dialogue: 0,0:02:43.16,0:02:44.64,Default,,0,0,0,,Мама мені тыңдамайды.
Dialogue: 0,0:02:44.66,0:02:45.28,Default,,0,0,0,,Ой!
Dialogue: 0,0:02:46.01,0:02:47.95,Default,,0,0,0,,Читтаа, айналаңды да ойла!
Dialogue: 0,0:02:48.61,0:02:49.29,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:02:49.49,0:02:51.60,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:02:52.70,0:02:53.39,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:58.60,0:02:59.51,Default,,0,0,0,,Shio?
Dialogue: 0,0:03:01.47,0:03:03.31,Default,,0,0,0,,Where did he go?
Dialogue: 0,0:03:07.03,0:03:08.12,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:03:09.11,0:03:12.29,Default,,0,0,0,,Егер сіз ваннаға баратын болсаңыз, бірдеңе айтыңыз және кетіңіз.
Dialogue: 0,0:03:14.00,0:03:14.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:18.22,0:03:19.45,Default,,0,0,0,,Сіз жылап жібердіңіз бе?
Dialogue: 0,0:03:22.04,0:03:23.35,Default,,0,0,0,,Don't lie
Dialogue: 0,0:03:24.37,0:03:25.66,Default,,0,0,0,,Don't cry
Dialogue: 0,0:03:26.51,0:03:27.21,Default,,0,0,0,,Кім?
Dialogue: 0,0:03:27.73,0:03:28.81,Default,,0,0,0,,Sanae-san
Dialogue: 0,0:03:29.30,0:03:32.44,Default,,0,0,0,,Шынымды айтсам, бұл адам таңқаларлық қатаң.
Dialogue: 0,0:03:33.05,0:03:35.69,Default,,0,0,0,,Бірақ жылауға болатын жерлер бар.
Dialogue: 0,0:03:37.38,0:03:38.16,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:03:42.95,0:03:43.86,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:03:44.87,0:03:48.64,Default,,0,0,0,,Ешкім байқамай ваннада жылай беруге болады.
Dialogue: 0,0:03:49.90,0:03:52.63,Default,,0,0,0,,Қалаған кезде жылауға болмайды ма?
Dialogue: 0,0:03:53.70,0:03:55.82,Default,,0,0,0,,Қазір жылағаныңыз жөн.
Dialogue: 0,0:03:56.86,0:03:59.17,Default,,0,0,0,,Жылағым келсе де жылай алмаймын
Dialogue: 0,0:03:59.68,0:04:02.01,Default,,0,0,0,,Өскенде сенде көп болады.
Dialogue: 0,0:04:16.67,0:04:17.21,Default,,0,0,0,,Эй
Dialogue: 0,0:04:18.09,0:04:19.26,Default,,0,0,0,,Сізде ойыншықтар бар ма?
Dialogue: 0,0:04:20.41,0:04:22.31,Default,,0,0,0,,Бірдеңені таңда, мен оны саған сатып аламын.
Dialogue: 0,0:04:22.45,0:04:22.95,Default,,0,0,0,,Иә
Dialogue: 0,0:04:31.59,0:04:32.10,Default,,0,0,0,,Эй
Dialogue: 0,0:04:33.22,0:04:34.51,Default,,0,0,0,,How about this?
Dialogue: 0,0:04:36.19,0:04:36.89,Default,,0,0,0,,Иә
Dialogue: 0,0:04:41.87,0:04:43.04,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:04:44.18,0:04:44.77,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:45.29,0:04:48.84,Default,,0,0,0,,Қыздарға арналған ойыншықтар жақсы емес пе?
Dialogue: 0,0:04:50.24,0:04:51.16,Default,,0,0,0,,Пингвиндер жұмағы
Dialogue: 0,0:04:52.07,0:04:53.01,Default,,0,0,0,,Маған бұл ұнайды
Dialogue: 0,0:04:53.62,0:04:56.22,Default,,0,0,0,,Сіздің де әдеттен тыс хоббиіңіз бар.
Dialogue: 0,0:04:57.26,0:04:58.79,Default,,0,0,0,,Жоқ, онымен ойнаңыз.
Dialogue: 0,0:04:59.05,0:04:59.75,Default,,0,0,0,,Иә
Dialogue: 0,0:05:02.26,0:05:04.78,Default,,0,0,0,,Жазғы демалысыңызды қызықты өткізіп жатырсыз ба?
Dialogue: 0,0:05:05.61,0:05:08.68,Default,,0,0,0,,Солай емес пе? Бұл екеуміз ғана.
Dialogue: 0,0:05:17.26,0:05:18.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:19.14,0:05:20.00,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:05:21.16,0:05:22.46,Default,,0,0,0,,Үлкенірек
Dialogue: 0,0:05:23.51,0:05:25.29,Default,,0,0,0,,Қараңғы, абай болыңыз
Dialogue: 0,0:05:25.42,0:05:25.96,Default,,0,0,0,,Иә
Dialogue: 0,0:05:35.91,0:05:36.94,Default,,0,0,0,,Оны өзім жасадым
Dialogue: 0,0:05:37.39,0:05:38.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:41.80,0:05:43.04,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:05:43.22,0:05:44.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:47.13,0:05:49.04,Default,,0,0,0,,Бұл отты, сен оны білесің, солай ма?
Dialogue: 0,0:05:49.86,0:05:51.12,Default,,0,0,0,,Бірінші рет көрдім
Dialogue: 0,0:05:51.50,0:05:53.25,Default,,0,0,0,,Бұл баяу ма?
Dialogue: 0,0:05:59.70,0:06:00.42,Default,,0,0,0,,Не?
Dialogue: 0,0:06:00.56,0:06:01.41,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:01.87,0:06:03.68,Default,,0,0,0,,Бетіңізде бірдеңе бар ма?
Dialogue: 0,0:06:03.80,0:06:04.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:05.08,0:06:07.70,Default,,0,0,0,,Онда олай адамдардың бетіне қарама.
Dialogue: 0,0:06:10.88,0:06:12.23,Default,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:06:12.51,0:06:14.28,Default,,0,0,0,,Айтарыңыз бар, солай ма?
Dialogue: 0,0:06:15.78,0:06:16.50,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:06:16.96,0:06:18.97,Default,,0,0,0,,Менен әлі қорқасың ба?
Dialogue: 0,0:06:20.69,0:06:22.10,Default,,0,0,0,,Жарайды, айтшы.
Dialogue: 0,0:06:22.72,0:06:24.69,Default,,0,0,0,,Мен енді айқайламаймын
Dialogue: 0,0:06:25.67,0:06:26.44,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.36,0:06:30.21,Default,,0,0,0,,Маған ана туралы айтып бер
Dialogue: 0,0:06:32.66,0:06:33.99,Default,,0,0,0,,Санае-саннан сұраңыз
Dialogue: 0,0:06:34.17,0:06:36.41,Default,,0,0,0,,Сұрасам да айтпайды.
Dialogue: 0,0:06:37.24,0:06:38.51,Default,,0,0,0,,Менен естідің бе?
Dialogue: 0,0:06:40.67,0:06:42.16,Default,,0,0,0,,Санае-саннан сұраңыз
Dialogue: 0,0:06:42.16,0:06:44.69,Default,,0,0,0,,Себебі сен менімен сөйлеспедің
Dialogue: 0,0:07:06.63,0:07:07.39,Default,,0,0,0,,Шио
Dialogue: 0,0:07:08.39,0:07:09.35,Default,,0,0,0,,Ұйықтап қалмаңыз
Dialogue: 0,0:07:09.94,0:07:10.70,Default,,0,0,0,,Иә
Dialogue: 0,0:07:11.72,0:07:14.52,Default,,0,0,0,,Қараңдар, бас киімдеріңді дұрыстап киіңдер.
Dialogue: 0,0:07:15.02,0:07:17.68,Default,,0,0,0,,Бүгін көп жүруім керек.
Dialogue: 0,0:07:20.91,0:07:21.58,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:07:21.79,0:07:22.30,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.39,0:07:40.34,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:43.07,0:07:44.27,Default,,0,0,0,,Жақынырақ қарағыңыз келе ме?
Dialogue: 0,0:07:44.52,0:07:45.28,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,0:07:45.54,0:07:46.19,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:47.04,0:07:48.37,Default,,0,0,0,,Эй, аяғыңды аш.
Dialogue: 0,0:07:53.10,0:07:54.21,Default,,0,0,0,,Сіз өте жеңілсіз.
Dialogue: 0,0:07:54.81,0:07:55.52,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:59.51,0:08:00.41,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:08:01.23,0:08:02.95,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:08:10.73,0:08:12.55,Default,,0,0,0,,Алысқа бармаңыз.
Dialogue: 0,0:08:13.69,0:08:16.37,Default,,0,0,0,,Келгеніңізге қуаныштысыз ба?
Dialogue: 0,0:08:33.48,0:08:34.62,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:35.65,0:08:36.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:38.36,0:08:39.18,Default,,0,0,0,,Не?
Dialogue: 0,0:08:40.82,0:08:41.77,Default,,0,0,0,,Робот
Dialogue: 0,0:08:44.92,0:08:46.20,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:08:46.97,0:08:49.71,Default,,0,0,0,,Бұл сіз ойнаған нәрсе еді, солай ма?
Dialogue: 0,0:08:49.92,0:08:50.55,Default,,0,0,0,,Иә
Dialogue: 0,0:08:51.01,0:08:54.91,Default,,0,0,0,,Мен сонша жүгірмесем де біртүрлі.
Dialogue: 0,0:08:56.41,0:08:58.13,Default,,0,0,0,,Ушио Берейік
Dialogue: 0,0:08:58.68,0:09:01.47,Default,,0,0,0,,Үйге қайтып бара жатқанда бірдей сатып алуға болады, солай ма?
Dialogue: 0,0:09:02.63,0:09:03.99,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:09:04.06,0:09:06.11,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені біреуі жоқ.
Dialogue: 0,0:09:08.92,0:09:10.66,Default,,0,0,0,,Сіз қыңырсыз.
Dialogue: 0,0:09:35.07,0:09:35.81,Default,,0,0,0,,Шио
Dialogue: 0,0:09:37.03,0:09:39.42,Default,,0,0,0,,I'm going this far.
Dialogue: 0,0:09:39.56,0:09:40.77,Default,,0,0,0,,Don't move from here
Dialogue: 0,0:09:40.96,0:09:41.68,Default,,0,0,0,,Иә
Dialogue: 0,0:09:50.41,0:09:51.26,Default,,0,0,0,,Не?
Dialogue: 0,0:09:51.76,0:09:52.71,Default,,0,0,0,,есімде
Dialogue: 0,0:10:08.68,0:10:11.36,Default,,0,0,0,,Tomoya Okazaki, right?
Dialogue: 0,0:10:14.36,0:10:15.49,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:10:15.94,0:10:17.89,Default,,0,0,0,,Мм... сен мені танисың ба?
Dialogue: 0,0:10:18.51,0:10:20.73,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:10:21.50,0:10:24.17,Default,,0,0,0,,Менің атым Фумино Оказаки.
Dialogue: 0,0:10:25.12,0:10:26.01,Default,,0,0,0,,Оказаки…
Dialogue: 0,0:10:26.34,0:10:30.82,Default,,0,0,0,,Сіздің әкеңіз Наоюки Оказакидің анасы.
Dialogue: 0,0:10:35.28,0:10:38.81,Default,,0,0,0,,Маған Кога мырза деген адамнан хабар келді.
Dialogue: 0,0:10:39.44,0:10:42.35,Default,,0,0,0,,If I'm here, you'll be here.
Dialogue: 0,0:10:43.08,0:10:44.30,Default,,0,0,0,,Сіз Санасыз ба?
Dialogue: 0,0:10:45.93,0:10:47.76,Default,,0,0,0,,Ол үлкейді.
Dialogue: 0,0:10:48.24,0:10:50.15,Default,,0,0,0,,Біз бұрын кездестірдік пе?
Dialogue: 0,0:10:51.89,0:10:54.55,Default,,0,0,0,,Кішкентай кезіңде осы жерде
Dialogue: 0,0:10:55.53,0:10:59.70,Default,,0,0,0,,Бұл сіздің анаңыз Ацуко қайтыс болғаннан кейін болды.
Dialogue: 0,0:11:02.93,0:11:06.99,Default,,0,0,0,,Наоюки әлі күнге дейін күнәларын өтеуге тырысып жатыр ма?
Dialogue: 0,0:11:07.88,0:11:11.63,Default,,0,0,0,,Жоқ, ол түрмеден шығып, үйіне қайтуы керек еді.
Dialogue: 0,0:11:12.01,0:11:14.19,Default,,0,0,0,,Сіз өзіңізді қорқынышты сезінген болуыңыз керек.
Dialogue: 0,0:11:15.06,0:11:15.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:19.26,0:11:22.66,Default,,0,0,0,,Мен бұрын ондай ақымақ бала емес едім.
Dialogue: 0,0:11:23.55,0:11:26.37,Default,,0,0,0,,Ацуко да, Наоюки де студент болған.
Dialogue: 0,0:11:26.56,0:11:29.31,Default,,0,0,0,,Менің айналамдағы адамдар некеге қарсы болды.
Dialogue: 0,0:11:30.01,0:11:32.38,Default,,0,0,0,,Наоюки орта мектепті тастап кетті
Dialogue: 0,0:11:32.55,0:11:35.68,Default,,0,0,0,,Екеуміз шағын пәтерде тұра бастадық...
Dialogue: 0,0:11:36.91,0:11:39.91,Default,,0,0,0,,Бірақ ол бақытты көрінді.
Dialogue: 0,0:11:41.45,0:11:44.56,Default,,0,0,0,,Жақындарыңызды қорғай отырып, өз бетіңізше өмір сүріңіз
Dialogue: 0,0:11:45.21,0:11:48.03,Default,,0,0,0,,Осының өзі баланы бақытты еткен болуы керек.
Dialogue: 0,0:11:49.35,0:11:53.49,Default,,0,0,0,,Ақырында, Ацуко-сан сені ішімен алып жүреді.
Dialogue: 0,0:11:54.29,0:11:59.37,Default,,0,0,0,,Кішкентай батада тудың.
Dialogue: 0,0:12:03.85,0:12:08.75,Default,,0,0,0,,Бірақ бұл бақыт ұзаққа бармады.
Dialogue: 0,0:12:10.10,0:12:12.65,Default,,0,0,0,,Ацуко апаттан қайтыс болды.
Dialogue: 0,0:12:14.39,0:12:16.04,Default,,0,0,0,,Сол бала үшін
Dialogue: 0,0:12:16.54,0:12:20.18,Default,,0,0,0,,Оңаша алмайтын қайғылы оқиға болды.
Dialogue: 0,0:12:23.25,0:12:27.98,Default,,0,0,0,,Бірақ мен әлі үмітімді үзе алмадым.
Dialogue: 0,0:12:34.11,0:12:35.03,Default,,0,0,0,,Томоя-сан
Dialogue: 0,0:12:36.11,0:12:39.35,Default,,0,0,0,,Өйткені сен әлі жас кезіңде қалдың.
Dialogue: 0,0:12:40.76,0:12:44.11,Default,,0,0,0,,Мен бұл баланы өз қолыммен өсіремін.
Dialogue: 0,0:12:46.38,0:12:49.68,Default,,0,0,0,,Сіз бұл жерден сол күні кетесіз
Dialogue: 0,0:12:49.73,0:12:52.93,Default,,0,0,0,,Ол Наоюкимен қол ұстасып жүрді.
Dialogue: 0,0:12:53.79,0:12:55.20,Default,,0,0,0,,Алайда, осы жағдайда біз әлі де кісі өлтірулердің қалай жасалып жатқанын білмейміз.
Dialogue: 0,0:12:55.95,0:12:58.00,Default,,0,0,0,,Сол жерден басталған күндер
Dialogue: 0,0:12:58.31,0:13:02.05,Default,,0,0,0,,Бұл баланың өміріндегі ең қиын кезең болды.
Dialogue: 0,0:13:02.59,0:13:06.49,Default,,0,0,0,,Жұмысымнан қайта-қайта қуылып, бір жерден екінші жерге көштім.
Dialogue: 0,0:13:07.10,0:13:10.37,Default,,0,0,0,,Сонда да мен сені жіберген жоқпын
Dialogue: 0,0:13:11.94,0:13:16.21,Default,,0,0,0,,Қолыңыздағы аз ақшаға ойыншықтар сатып алып, тәттілер жеңіз.
Dialogue: 0,0:13:17.31,0:13:22.14,Default,,0,0,0,,Менің барлық сәттілік пен табысқа жету мүмкіндігімнің есебінен.
Dialogue: 0,0:13:23.83,0:13:28.50,Default,,0,0,0,,Ол кейде қатал немесе дөрекі болуы мүмкін.
Dialogue: 0,0:13:29.43,0:13:33.78,Default,,0,0,0,,Бірақ мұның бәрі сені аман-есен өсіру үшін болды.
Dialogue: 0,0:13:35.63,0:13:37.79,Default,,0,0,0,,Наоюки үшін
Dialogue: 0,0:13:38.42,0:13:41.72,Default,,0,0,0,,Өте қиын өмір болған сияқты.
Dialogue: 0,0:13:42.61,0:13:47.24,Default,,0,0,0,,Жұмыстың қиындығынан алаңдау үшін ішімдікке сүйене бастадым.
Dialogue: 0,0:13:47.87,0:13:50.91,Default,,0,0,0,,Естуімше, кейде мас болып, зорлық-зомбылық жасайтын.
Dialogue: 0,0:13:51.83,0:13:56.51,Default,,0,0,0,,Сонда да ол сенімен тұруды таңдады.
Dialogue: 0,0:13:58.67,0:14:04.97,Default,,0,0,0,,Ал сіз өз өміріңізді өзіңіз шеше алатын жасқа жеткенде
Dialogue: 0,0:14:05.45,0:14:08.02,Default,,0,0,0,,Наоюки бәрін жоғалтты
Dialogue: 0,0:14:09.25,0:14:13.56,Default,,0,0,0,,Еңбек, сенім, сәттілік, достар, бәрі.
Dialogue: 0,0:14:15.74,0:14:19.84,Default,,0,0,0,,Сіз қазір Наоюки сияқты жағдайға тап болған сияқтысыз.
Dialogue: 0,0:14:21.17,0:14:22.61,Default,,0,0,0,,Бұл ауырады.
Dialogue: 0,0:14:23.45,0:14:28.54,Default,,0,0,0,,Бірақ мен сізге осы оқиғаны айтқым келгені сондықтан.
Dialogue: 0,0:14:29.06,0:14:33.17,Default,,0,0,0,,Наоюкидің қандай әке болғанын білгім келеді.
Dialogue: 0,0:14:37.31,0:14:39.99,Default,,0,0,0,,Адамдар маған тәттілерді жиі сатып алатын.
Dialogue: 0,0:14:40.96,0:14:43.78,Default,,0,0,0,,Қол ұстасып қыдырайық...
Dialogue: 0,0:14:45.42,0:14:47.36,Default,,0,0,0,,Мен неге ұмыттым деп ойлаймын
Dialogue: 0,0:14:48.61,0:14:53.27,Default,,0,0,0,,Томоя-сан, Наоюки жаман әке болды деп ойлайсың ба?
Dialogue: 0,0:14:54.99,0:14:55.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:56.85,0:14:59.65,Default,,0,0,0,,Мен әлдеқайда нашар адаммын.
Dialogue: 0,0:15:00.34,0:15:04.09,Default,,0,0,0,,Мен сол күні әкем тұрған жерде тұрмын.
Dialogue: 0,0:15:05.40,0:15:10.84,Default,,0,0,0,,Бірақ қазір мен әлсіз және аяныштымын.
Dialogue: 0,0:15:13.43,0:15:15.04,Default,,0,0,0,,Сол балаға да қатысты.
Dialogue: 0,0:15:15.95,0:15:18.71,Default,,0,0,0,,Әлсіз, аянышты, ебедейсіз...
Dialogue: 0,0:15:20.55,0:15:24.83,Default,,0,0,0,,Сонда да мен сен үшін қолымнан келгеннің бәрін жасадым, балам.
Dialogue: 0,0:15:26.76,0:15:30.68,Default,,0,0,0,,Сол баламен мақтанғым келеді.
Dialogue: 0,0:15:31.32,0:15:34.24,Default,,0,0,0,,Адам болған соң менде кемшіліктер болды, бірақ
Dialogue: 0,0:15:35.18,0:15:38.30,Default,,0,0,0,,Ол керемет әке болды.
Dialogue: 0,0:15:40.43,0:15:41.19,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:15:43.65,0:15:44.48,Default,,0,0,0,,Жоспар
Dialogue: 0,0:15:45.70,0:15:47.22,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:15:49.46,0:15:51.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:55.03,0:15:56.85,Default,,0,0,0,,Жоқ, мен жеңілдеп қалдым.
Dialogue: 0,0:16:04.80,0:16:05.59,Default,,0,0,0,,Томоя-сан
Dialogue: 0,0:16:06.21,0:16:08.36,Default,,0,0,0,,Әлгі бала тым қатты тырысты.
Dialogue: 0,0:16:09.71,0:16:12.04,Default,,0,0,0,,Демалыс уақыты келді.
Dialogue: 0,0:16:13.01,0:16:15.10,Default,,0,0,0,,Наоюкиге айтыңыз
Dialogue: 0,0:16:15.60,0:16:17.62,Default,,0,0,0,,Мен сенің қайтып келгеніңді қалаймын.
Dialogue: 0,0:16:19.34,0:16:23.27,Default,,0,0,0,,Мен ол баланы осы елде күтемін.
Dialogue: 0,0:16:30.71,0:16:31.24,Default,,0,0,0,,Шио
Dialogue: 0,0:16:32.93,0:16:33.98,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:16:36.13,0:16:37.43,Default,,0,0,0,,Бұл сіздің...
Dialogue: 0,0:16:38.13,0:16:39.63,Default,,0,0,0,,Иә, бұл Ушио.
Dialogue: 0,0:16:47.51,0:16:49.24,Default,,0,0,0,,Сіз көптен бері іздеп жүрсіз бе?
Dialogue: 0,0:16:49.44,0:16:50.11,Default,,0,0,0,,Иә
Dialogue: 0,0:16:51.38,0:16:52.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:00.53,0:17:01.24,Default,,0,0,0,,Шио
Dialogue: 0,0:17:02.44,0:17:03.72,Default,,0,0,0,,Сол робот
Dialogue: 0,0:17:04.46,0:17:05.86,Default,,0,0,0,,Табылмауы мүмкін
Dialogue: 0,0:17:06.60,0:17:07.76,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:17:08.44,0:17:11.58,Default,,0,0,0,,Сондықтан мен қайтадан жаңасын сатып аламын.
Dialogue: 0,0:17:15.13,0:17:18.22,Default,,0,0,0,,Бір ғана.
Dialogue: 0,0:17:19.24,0:17:21.44,Default,,0,0,0,,Олар дүкенде көп сатты.
Dialogue: 0,0:17:23.52,0:17:26.96,Default,,0,0,0,,Өйткені сен оны таңдап, маған сатып алдың.
Dialogue: 0,0:17:30.12,0:17:32.81,Default,,0,0,0,,Әкем алғаш рет...
Dialogue: 0,0:17:39.04,0:17:39.70,Default,,0,0,0,,Шио
Dialogue: 0,0:17:41.37,0:17:42.45,Default,,0,0,0,,Сіз жалғыз болдыңыз ба?
Dialogue: 0,0:17:43.42,0:17:44.04,Default,,0,0,0,,Иә
Dialogue: 0,0:17:45.38,0:17:48.63,Default,,0,0,0,,Мен сияқты адаммен саяхаттау ұнады ма?
Dialogue: 0,0:17:48.83,0:17:49.37,Default,,0,0,0,,Иә
Dialogue: 0,0:17:51.93,0:17:52.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:53.95,0:17:54.75,Default,,0,0,0,,Шио
Dialogue: 0,0:17:55.56,0:17:58.71,Default,,0,0,0,,Мен сенің жаныңда тұра аламын ба?
Dialogue: 0,0:17:59.69,0:18:04.06,Default,,0,0,0,,Мен көптен бері жаман әке болдым.
Dialogue: 0,0:18:05.46,0:18:08.51,Default,,0,0,0,,Бұдан былай мен Ушио үшін бар күшімді саламын.
Dialogue: 0,0:18:09.30,0:18:12.24,Default,,0,0,0,,Сонда мен сенің жаныңда тұра аламын ба?
Dialogue: 0,0:18:13.62,0:18:14.31,Default,,0,0,0,,Иә
Dialogue: 0,0:18:15.14,0:18:15.97,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:18:16.47,0:18:17.60,Default,,0,0,0,,Мен сенің қалғаныңды қалаймын
Dialogue: 0,0:18:19.53,0:18:20.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:21.66,0:18:25.94,Default,,0,0,0,,Бірақ мен бүгін маңызды нәрсені жоғалтқаным үшін мұңайып отырмын.
Dialogue: 0,0:18:28.18,0:18:29.06,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:18:30.67,0:18:31.81,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:18:36.49,0:18:37.80,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:18:39.07,0:18:42.38,Default,,0,0,0,,Мен ұстануым керек пе?
Dialogue: 0,0:18:44.12,0:18:46.28,Default,,0,0,0,,Санае айтты
Dialogue: 0,0:18:47.48,0:18:49.00,Default,,0,0,0,,Жылауға бола ма?
Dialogue: 0,0:18:49.70,0:18:50.94,Default,,0,0,0,,Дәретхана?
Dialogue: 0,0:18:52.27,0:18:54.67,Default,,0,0,0,,Тіпті әкемнің кеудесінде
Dialogue: 0,0:18:57.70,0:18:58.27,Default,,0,0,0,,Иә
Dialogue: 0,0:19:00.22,0:19:00.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:18.96,0:19:19.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:22.02,0:19:22.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:25.42,0:19:26.32,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:19:40.63,0:19:41.68,Default,,0,0,0,,Сәлем Шио
Dialogue: 0,0:19:43.31,0:19:45.33,Default,,0,0,0,,Анамның әңгімесін тыңдағың келе ме?
Dialogue: 0,0:19:46.37,0:19:47.09,Default,,0,0,0,,Иә
Dialogue: 0,0:19:47.67,0:19:49.43,Default,,0,0,0,,Жарайды, онда мұнда кел.
Dialogue: 0,0:19:58.78,0:19:59.93,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:02.76,0:20:06.55,Default,,0,0,0,,Анам үнемі жылайтын.
Dialogue: 0,0:20:07.21,0:20:08.70,Default,,0,0,0,,Тіпті біз алғаш кездескен кезде де
Dialogue: 0,0:20:09.22,0:20:11.12,Default,,0,0,0,,Сенімсіз, әлсіз
Dialogue: 0,0:20:11.51,0:20:14.50,Default,,0,0,0,,Мен мектеп баурайының түбінде тұрдым.
Dialogue: 0,0:20:15.71,0:20:18.92,Default,,0,0,0,,Ендеше ол еңістің түбінде не деді деп ойлайсыңдар?
Dialogue: 0,0:20:20.01,0:20:22.24,Default,,0,0,0,,Көзіңді жұмып, «Анпан» деп айт.
Dialogue: 0,0:20:23.51,0:20:25.32,Default,,0,0,0,,Бұл менің анамның әдеті еді.
Dialogue: 0,0:20:25.96,0:20:27.83,Default,,0,0,0,,Нені жегіңіз келетінін дауыстап айтыңыз
Dialogue: 0,0:20:27.88,0:20:29.92,Default,,0,0,0,,Сондықтан мен батылдығымды жинаймын
Dialogue: 0,0:20:30.85,0:20:34.40,Default,,0,0,0,,Ол кезде Сана жұмыстан қолы босамайтын.
Dialogue: 0,0:20:34.69,0:20:36.98,Default,,0,0,0,,Менің бенто жасауға уақытым болмады.
Dialogue: 0,0:20:38.05,0:20:40.42,Default,,0,0,0,,Егер мен өзімді мәжбүрлейтін болсам, мен бірдеңе істей алатынмын.
Dialogue: 0,0:20:40.61,0:20:42.68,Default,,0,0,0,,Анам құлықсызырақ болған сияқты.
Dialogue: 0,0:20:43.31,0:20:45.62,Default,,0,0,0,,Менің анам осындай адам болған.
Dialogue: 0,0:20:46.41,0:20:47.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:53.87,0:20:55.42,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:56.43,0:20:58.79,Default,,0,0,0,,Сонымен, анашым...
Dialogue: 0,0:21:07.31,0:21:07.98,Default,,0,0,0,,Нағиса
Dialogue: 0,0:21:09.57,0:21:10.19,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:21:14.37,0:21:15.16,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:21:20.38,0:21:21.05,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:21:24.21,0:21:25.93,Default,,0,0,0,,Сізге не болды?
Dialogue: 0,0:21:27.33,0:21:31.67,Default,,0,0,0,,Кешіріңіз, бұл маған анамды еске түсірді.
Dialogue: 0,0:21:37.46,0:21:39.24,Default,,0,0,0,,Жарайды, ертегіні жалғастырайық.
Dialogue: 0,0:21:40.64,0:21:44.00,Default,,0,0,0,,Анам сол кезде театрмен айналысқысы келетін.
Dialogue: 0,0:21:44.21,0:21:46.61,Default,,0,0,0,,Нагиса мен таптым
Dialogue: 0,0:21:44.61,0:21:45.99,Default,,0,0,0,,Сіз театрды түсінесіз бе?
Dialogue: 0,0:21:48.17,0:21:49.34,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:21:51.25,0:21:53.54,Default,,0,0,0,,Мен нені ғана қорғай аламын
Dialogue: 0,0:21:54.97,0:21:58.26,Default,,0,0,0,,Мен ғана қорғай алатын орны толмас зат
Dialogue: 0,0:22:04.54,0:22:05.22,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:22:06.56,0:22:07.93,Default,,0,0,0,,Бұл жерде болды
Dialogue: 0,0:22:18.67,0:22:25.89,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.19,0:22:32.82,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.70,0:22:41.03,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.36,0:22:48.22,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.31,0:22:55.49,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.70,0:23:03.95,Default,,0,0,0,,Бір өзгеріссіз қалатын нәрсені іздеңіз
Dialogue: 0,0:23:04.44,0:23:11.65,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.80,0:23:19.46,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.46,0:23:26.70,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:26.98,0:23:34.33,Default,,0,0,0,,Сол күнгі сөздерді антқа өзгертіңіз
Dialogue: 0,0:23:34.44,0:23:39.18,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:43.09,0:23:44.15,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:23:44.64,0:23:45.79,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:23:46.97,0:23:50.87,Default,,0,0,0,,Өлі балыққа қарап тұрған жігіт қайта тірілді.
Dialogue: 0,0:23:51.58,0:23:53.94,Default,,0,0,0,,Сізге де Dango Big Family ұнайды ма?
Dialogue: 0,0:23:54.16,0:23:58.16,Default,,0,0,0,,Сана-сан бұл ананың иісі деді.
Dialogue: 0,0:24:08.06,0:24:08.84,Default,,0,0,0,,Мен үйдемін
