Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Шио
Dialogue: 0,0:00:07.09,0:00:10.03,Default,,0,0,0,,Бұл сен туылғанға дейінгі оқиға.
Dialogue: 0,0:00:11.06,0:00:16.02,Default,,0,0,0,,Анам мен әкем алғаш рет мен орта мектепте жоғары сыныпта оқып жүрген кезімде сөйлесті.
Dialogue: 0,0:00:16.07,0:00:18.08,Default,,0,0,0,,Сіз бірінші рет кездестіңіз бе?
Dialogue: 0,0:00:19.01,0:00:22.05,Default,,0,0,0,,Аа, біз әлі бір-біріміздің атын да білмедік.
Dialogue: 0,0:00:29.07,0:00:30.05,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:00:31.02,0:00:32.01,Default,,0,0,0,,Анпан
Dialogue: 0,0:00:33.09,0:00:36.00,Default,,0,0,0,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:00:36.08,0:00:39.06,Default,,0,0,0,,Маған бұл өте ұнайды.
Dialogue: 0,0:00:40.00,0:00:41.06,Default,,0,0,0,,Бірақ ештеңе...
Dialogue: 0,0:00:41.09,0:00:43.09,Default,,0,0,0,,Мен өзгермей тұра алмаймын
Dialogue: 0,0:00:51.04,0:00:54.07,Default,,0,0,0,,Барлық қызықты және қуанышты нәрселер...
Dialogue: 0,0:00:56.00,0:00:58.04,Default,,0,0,0,,Барлығы өзгермейді.
Dialogue: 0,0:00:58.07,0:01:01.06,Default,,0,0,0,,Сіз бұл жерді әлі де жақсы көре аласыз ба?
Dialogue: 0,0:01:03.05,0:01:04.07,Default,,0,0,0,,Тек оны табыңыз.
Dialogue: 0,0:01:16.09,0:01:20.09,Default,,0,0,0,,Тек келесі қызықты нәрсені немесе сізді бақытты ететін нәрсені табыңыз.
Dialogue: 0,0:01:23.09,0:01:25.02,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:01:53.09,0:01:59.03,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:01:59.04,0:02:04.09,Default,,0,0,0,,Көптеген жылы күн бассейндері пайда болды.
Dialogue: 0,0:02:05.00,0:02:10.01,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:02:10.03,0:02:17.04,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:02:17.09,0:02:25.07,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:02:25.07,0:02:31.06,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:02:31.07,0:02:39.04,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:02:39.05,0:02:46.00,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:02:46.03,0:02:48.08,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:02:48.04,0:02:50.09,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:02:50.05,0:02:52.09,Default,,0,0,0,,Тек бір ғана
Dialogue: 0,0:02:52.05,0:02:55.06,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:02:55.02,0:02:59.08,Default,,0,0,0,,Мен саған жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:02:59.03,0:03:04.06,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын
Dialogue: 0,0:03:11.03,0:03:14.05,Default,,0,0,0,,Әкелеріміз осылай танысқан.
Dialogue: 0,0:03:16.02,0:03:19.06,Default,,0,0,0,,Анам басқа оқушылардан бір жас үлкен болатын.
Dialogue: 0,0:03:24.08,0:03:26.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:27.01,0:03:30.05,Default,,0,0,0,,Неге мұндай жерде түскі асты жалғыз ішесің?
Dialogue: 0,0:03:31.07,0:03:34.06,Default,,0,0,0,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:03:35.05,0:03:37.00,Default,,0,0,0,,Жоқ, айтайық...
Dialogue: 0,0:03:37.01,0:03:39.08,Default,,0,0,0,,Маған өте ұнайды.
Dialogue: 0,0:03:39.09,0:03:43.07,Default,,0,0,0,,Бұрын сөйлесетін адамдарым, жақсы дос болатын мұғалімдерім болды.
Dialogue: 0,0:03:43.09,0:03:45.03,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:03:45.07,0:03:46.08,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:03:47.06,0:03:52.00,Default,,0,0,0,,Өткен жылы мектептен ұзақ үзіліс алдым.
Dialogue: 0,0:03:52.01,0:03:53.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:54.00,0:03:54.50,Default,,0,0,0,,Бұл көшірме болды ма?
Dialogue: 0,0:03:55.06,0:03:57.09,Default,,0,0,0,,Иә, ол көшірілді.
Dialogue: 0,0:04:01.03,0:04:04.02,Default,,0,0,0,,Мен білетіндердің барлығы мектеп бітірді
Dialogue: 0,0:04:04.03,0:04:07.01,Default,,0,0,0,,Менің қазіргі мектебімде мен танымайтын адамдар көп...
Dialogue: 0,0:04:07.06,0:04:10.04,Default,,0,0,0,,Мен өзімді Таро Урашима сияқты сезіндім
Dialogue: 0,0:04:19.02,0:04:21.05,Default,,0,0,0,,Әкем мектепте шеттетілген.
Dialogue: 0,0:04:33.08,0:04:36.04,Default,,0,0,0,,Бірақ мен анаммен кездескеннен кейін
Dialogue: 0,0:04:36.07,0:04:39.08,Default,,0,0,0,,Бірте-бірте көп нәрсе өзгере бастады.
Dialogue: 0,0:04:43.00,0:04:45.01,Default,,0,0,0,,Анам спектакль қоймақшы болды.
Dialogue: 0,0:04:46.00,0:04:50.01,Default,,0,0,0,,Бірақ алдымен мектептегі драма үйірмесін қайта жандандыруым керек болды.
Dialogue: 0,0:04:50.07,0:04:52.08,Default,,0,0,0,,Әкем саған да көмектесті, солай ма?
Dialogue: 0,0:04:53.01,0:04:53.51,Default,,0,0,0,,Иә
Dialogue: 0,0:04:54.02,0:04:58.03,Default,,0,0,0,,Анамның еңбек еткені сонша, мен оны жалғыз қалдыра алмадым.
Dialogue: 0,0:05:02.05,0:05:06.01,Default,,0,0,0,,Сол кезден бастап мамам Данго отбасын жақсы көрді.
Dialogue: 0,0:05:07.00,0:05:09.02,Default,,0,0,0,,Ушио мен де сені жақсы көремін, солай ма?
Dialogue: 0,0:05:09.05,0:05:10.04,Default,,0,0,0,,Ұнады
Dialogue: 0,0:05:13.05,0:05:15.06,Default,,0,0,0,,Анам жалғыз жаттығады.
Dialogue: 0,0:05:16.04,0:05:18.00,Default,,0,0,0,,Мен көргім келген пьеса болды.
Dialogue: 0,0:05:21.09,0:05:24.05,Default,,0,0,0,,Мен сені алып кетейін бе?
Dialogue: 0,0:05:26.09,0:05:30.03,Default,,0,0,0,,Бұл қаладағы тілектер орындалатын орын
Dialogue: 0,0:05:33.02,0:05:35.01,Default,,0,0,0,,Содан кейін достар жиыны басталды.
Dialogue: 0,0:05:35.07,0:05:38.09,Default,,0,0,0,,Біріншіден, маған көмектескен адам Энн Фудзибаяши болды.
Dialogue: 0,0:05:39.03,0:05:42.02,Default,,0,0,0,,Сіз білесіз бе? Мен сенің балабақшаңның тәрбиешісімін.
Dialogue: 0,0:05:45.09,0:05:48.02,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:05:48.03,0:05:51.05,Default,,0,0,0,,Өйткені, мен сенімен кездесіп жатқан жоқпын.
Dialogue: 0,0:05:52.02,0:05:53.07,Default,,0,0,0,,Ал Муку бар...
Dialogue: 0,0:05:53.07,0:05:55.01,Default,,0,0,0,,Күтіңіз, күтіңіз, күтіңіз
Dialogue: 0,0:05:55.02,0:05:55.52,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:05:56.09,0:06:02.01,Default,,0,0,0,,Жарайды, ол бала, сондықтан мен оның мұндай нәрсеге неге қызығатынын түсінемін.
Dialogue: 0,0:06:02.06,0:06:05.05,Default,,0,0,0,,Содан кейін оның сіңлісі Фудзибаяши Рю
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Ол әкемнің сыныбының президенті болды.
Dialogue: 0,0:06:08.04,0:06:10.00,Default,,0,0,0,,(The Bow and Arrow енді жоқ)
Dialogue: 0,0:06:10.03,0:06:12.01,Default,,0,0,0,,Мен де мұқият тыңдаймын.
Dialogue: 0,0:06:12.01,0:06:14.09,Default,,0,0,0,,Ол драма үйірмесіне ұқсай бастады.
Dialogue: 0,0:06:15.00,0:06:18.06,Default,,0,0,0,,Қыздар генетикалық деңгейде болжауды ұнатады.
Dialogue: 0,0:06:19.01,0:06:22.02,Default,,0,0,0,,Мектептегі ең ақылды қыз да бізге қосылды.
Dialogue: 0,0:06:22.09,0:06:24.02,Default,,0,0,0,,Котоми Ичиноза
Dialogue: 0,0:06:25.00,0:06:27.09,Default,,0,0,0,,Негізі ол әкемнің бала кезден досы болған.
Dialogue: 0,0:06:28.08,0:06:29.08,Default,,0,0,0,,Сиқырлы…
Dialogue: 0,0:06:31.00,0:06:32.06,Default,,0,0,0,,Басқа да көптеген адамдар болды.
Dialogue: 0,0:06:33.04,0:06:35.06,Default,,0,0,0,,Томойо Сакагами, екінші курс студенті
Dialogue: 0,0:06:37.08,0:06:39.08,Default,,0,0,0,,Жол жалғасуда
Dialogue: 0,0:06:39.09,0:06:42.04,Default,,0,0,0,,Қолымыздан келгеннің бәрін бірге жасайық, бұл уәде.
Dialogue: 0,0:06:45.01,0:06:46.08,Default,,0,0,0,,Жатақханадағы анасы Мисае Сагара
Dialogue: 0,0:06:48.02,0:06:53.04,Default,,0,0,0,,Сондай-ақ, үнемі анықтамалық бөлмеде болатын және маған кеңес беретін Юкин Миядзава.
Dialogue: 0,0:06:54.04,0:06:58.00,Default,,0,0,0,,Миядзава маған осы қалада өткен аңыздарды айтып берді.
Dialogue: 0,0:06:59.01,0:07:02.05,Default,,0,0,0,,Бақытты адамға нұр шары пайда болады
Dialogue: 0,0:07:03.05,0:07:07.00,Default,,0,0,0,,Алсаң тілегің орындалады дейді.
Dialogue: 0,0:07:09.06,0:07:11.03,Default,,0,0,0,,Юхэй ағай ше?
Dialogue: 0,0:07:11.05,0:07:13.07,Default,,0,0,0,,Иә, ол сонда болды.
Dialogue: 0,0:07:14.01,0:07:17.00,Default,,0,0,0,,Бұл ер адамдар ойнайтын махаббат деп аталатын ойын
Dialogue: 0,0:07:17.07,0:07:21.02,Default,,0,0,0,,Менің ойымша, бұл баланың махаббат ойыны.
Dialogue: 0,0:07:23.04,0:07:25.04,Default,,0,0,0,,Оны футбол клубына қайтару
Dialogue: 0,0:07:25.08,0:07:28.03,Default,,0,0,0,,Сіз сіңліңіз Мэймен қатты жұмыс істеп көрдіңіз бе?
Dialogue: 0,0:07:30.02,0:07:31.05,Default,,0,0,0,,Егер ол үшін болмаса
Dialogue: 0,0:07:31.07,0:07:36.00,Default,,0,0,0,,Мүмкін әкем анамды кездестірмей тұрып мектепті тастап кеткен болар.
Dialogue: 0,0:07:43.02,0:07:45.01,Default,,0,0,0,,Жолдарымыз алшақ болғанымен
Dialogue: 0,0:07:45.04,0:07:47.02,Default,,0,0,0,,Әлі де анда-санда бас қосып тұрамыз.
Dialogue: 0,0:07:47.08,0:07:50.05,Default,,0,0,0,,Осы жаңа жылда да барлығы менің үйіме келді.
Dialogue: 0,0:07:50.07,0:07:52.01,Default,,0,0,0,,Сіздің де есіңізде
Dialogue: 0,0:07:56.03,0:07:59.06,Default,,0,0,0,,Драма үйірмесі жанданғанға дейін көп оқиғалар болды.
Dialogue: 0,0:08:00.01,0:08:04.03,Default,,0,0,0,,Мысалы, Юсуке Йошино мен Кимиконың үйлену тойы.
Dialogue: 0,0:08:06.07,0:08:09.08,Default,,0,0,0,,Кимиконың ауруханаға түскен қарындасы болды.
Dialogue: 0,0:08:10.06,0:08:12.04,Default,,0,0,0,,Бұл сіздің досыңыз Фуко-чан.
Dialogue: 0,0:08:15.08,0:08:16.09,Default,,0,0,0,,Клуб мүшелері ғана емес
Dialogue: 0,0:08:17.02,0:08:20.03,Default,,0,0,0,,Маған да қамқор болатын мұғалімді табу керек болды.
Dialogue: 0,0:08:21.00,0:08:24.04,Default,,0,0,0,,Хор клубымен Юкимура-сенсэйге қатысты дау болды.
Dialogue: 0,0:08:24.07,0:08:26.05,Default,,0,0,0,,Хорды сендіру
Dialogue: 0,0:08:26.07,0:08:29.01,Default,,0,0,0,,Мен бір рет баскетбол клубына қатысып көрдім.
Dialogue: 0,0:08:31.09,0:08:35.05,Default,,0,0,0,,Соңында Анзу, Сунохара және т.б.
Dialogue: 0,0:08:36.03,0:08:37.08,Default,,0,0,0,,Әртүрлі адамдар көмектесті
Dialogue: 0,0:08:38.02,0:08:41.05,Default,,0,0,0,,Драма үйірмесі ақыры өз жұмысын қайта бастады.
Dialogue: 0,0:08:42.03,0:08:46.01,Default,,0,0,0,,Бұл жолы мәселе әкемнің өзінен шықты.
Dialogue: 0,0:08:46.01,0:08:49.02,Default,,0,0,0,,Әке, ұйықтағың келсе, жату керек.
Dialogue: 0,0:08:50.01,0:08:51.03,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:08:54.02,0:08:59.04,Default,,0,0,0,,Бұл Томояға тағы да қиындық туғыза ма?
Dialogue: 0,0:09:00.09,0:09:05.08,Default,,0,0,0,,Ол кезде әкем мен әкем онша жақын емес еді.
Dialogue: 0,0:09:07.00,0:09:10.04,Default,,0,0,0,,Мен үйден шығып, анамның үйінде тұрдым.
Dialogue: 0,0:09:13.00,0:09:14.09,Default,,0,0,0,,Қош бол, әке
Dialogue: 0,0:09:20.02,0:09:23.00,Default,,0,0,0,,Менің наным...
Dialogue: 0,0:09:23.01,0:09:24.04,Default,,0,0,0,,Сәл күте тұрыңыз...
Dialogue: 0,0:09:24.05,0:09:27.07,Default,,0,0,0,,Оның сатылмай қалуы заңды еді.
Dialogue: 0,0:09:26.08,0:09:29.00,Default,,0,0,0,,Мына анада бала бар ма?
Dialogue: 0,0:09:29.03,0:09:31.09,Default,,0,0,0,,Әкесі әдепті болар деп үміттенемін.
Dialogue: 0,0:09:32.00,0:09:32.50,Default,,0,0,0,,Эй
Dialogue: 0,0:09:33.05,0:09:34.03,Default,,0,0,0,,Не?
Dialogue: 0,0:09:35.06,0:09:38.00,Default,,0,0,0,,Сіз мен айтпауым керек нәрсені айттыңыз.
Dialogue: 0,0:09:38.09,0:09:41.05,Default,,0,0,0,,Санаэ-сан мен Аккиді түсіндірудің қажеті жоқ.
Dialogue: 0,0:09:42.07,0:09:46.03,Default,,0,0,0,,Аккидің өтініші бойынша бәріміз бірге бейсбол ойнадық.
Dialogue: 0,0:09:47.09,0:09:53.01,Default,,0,0,0,,Сана да, Акки де әкесін үйлеріне басынан қарсы алды.
Dialogue: 0,0:09:54.06,0:09:59.00,Default,,0,0,0,,Әкем отбасы дегеннің не екенін түсінбеді.
Dialogue: 0,0:09:59.03,0:10:01.04,Default,,0,0,0,,Басында біраз абдырап қалдым.
Dialogue: 0,0:10:02.03,0:10:06.09,Default,,0,0,0,,Бірақ Санаэ-сан мен Акки мені абайсызда бақылап тұрды.
Dialogue: 0,0:10:08.09,0:10:12.06,Default,,0,0,0,,Анам әлсіреп, кейде қызуы көтеріліп, төсек тартып жатты.
Dialogue: 0,0:10:13.04,0:10:18.02,Default,,0,0,0,,Санаэ-сан мен Акки анасын қатты бағалайтын.
Dialogue: 0,0:10:19.01,0:10:22.08,Default,,0,0,0,,Шындық қашанда қатал.
Dialogue: 0,0:10:27.02,0:10:28.08,Default,,0,0,0,,Мектеп мерекесі жақындап қалды
Dialogue: 0,0:10:29.04,0:10:33.07,Default,,0,0,0,,Әкелер спектакльді нақты көрсетуге қызу дайындықты бастады.
Dialogue: 0,0:10:37.07,0:10:41.02,Default,,0,0,0,,Алайда соңғы сәтте күтпеген мәселе туындады.
Dialogue: 0,0:10:43.03,0:10:44.03,Default,,0,0,0,,Бұл фото...
Dialogue: 0,0:10:45.06,0:10:48.02,Default,,0,0,0,,Ескі альбомдар мен күнделіктер шықты...
Dialogue: 0,0:10:48.07,0:10:51.08,Default,,0,0,0,,Оказаки мырза, мен білмедім.
Dialogue: 0,0:10:52.03,0:10:54.06,Default,,0,0,0,,Әкем ойнайтын.
Dialogue: 0,0:10:56.06,0:10:58.07,Default,,0,0,0,,Бірақ мен үшін...
Dialogue: 0,0:10:59.02,0:11:01.04,Default,,0,0,0,,Екеуіміздің де өз арманымыз бар...
Dialogue: 0,0:11:12.00,0:11:13.04,Default,,0,0,0,,Жоқ, шымылдықты түсірейік.
Dialogue: 0,0:11:19.03,0:11:22.09,Default,,0,0,0,,Армандарың орындалсын, Нағиса!
Dialogue: 0,0:11:25.04,0:11:26.01,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:26.01,0:11:26.51,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,0:11:27.00,0:11:28.00,Default,,0,0,0,,Нағиса
Dialogue: 0,0:11:29.03,0:11:31.00,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:31.07,0:11:33.07,Default,,0,0,0,,Баланың арманы – ата-ананың арманы.
Dialogue: 0,0:11:34.00,0:11:35.05,Default,,0,0,0,,Тек оны жүзеге асыру керек.
Dialogue: 0,0:11:36.00,0:11:39.03,Default,,0,0,0,,Біз сіздің армандарыңызды орындауыңызды армандаймыз.
Dialogue: 0,0:11:39.08,0:11:42.00,Default,,0,0,0,,Біз арманымыздан бас тартқан жоқпыз.
Dialogue: 0,0:11:42.04,0:11:44.09,Default,,0,0,0,,Біз өз арманымызды сіздің арманыңызға айналдырдық
Dialogue: 0,0:11:45.04,0:11:47.07,Default,,0,0,0,,Ата-ана осындай.
Dialogue: 0,0:11:47.08,0:11:50.03,Default,,0,0,0,,Отбасы деген осындай.
Dialogue: 0,0:11:50.08,0:11:53.01,Default,,0,0,0,,Сол күннен бері...
Dialogue: 0,0:11:53.09,0:11:55.04,Default,,0,0,0,,Нан пісіріп жатқанда...
Dialogue: 0,0:11:56.04,0:11:59.07,Default,,0,0,0,,Біз өмірімізді осыны аңсаумен өткізіп келеміз.
Dialogue: 0,0:12:00.03,0:12:03.05,Default,,0,0,0,,Егер сіз мұнда сәтсіздікке ұшырасаңыз, біз депрессияға түсеміз.
Dialogue: 0,0:12:03.05,0:12:04.07,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:05.00,0:12:08.02,Default,,0,0,0,,Бұл үлкен жауапкершілік!
Dialogue: 0,0:12:26.06,0:12:27.04,Default,,0,0,0,,Сіз...
Dialogue: 0,0:12:28.07,0:12:30.09,Default,,0,0,0,,Мен сені алып кетейін бе?
Dialogue: 0,0:12:33.05,0:12:36.08,Default,,0,0,0,,Осы қаладағы тілектер орындалатын орын
Dialogue: 0,0:12:37.08,0:12:39.06,Default,,0,0,0,,Мені де өзіңмен бірге ала кет, Нағиса.
Dialogue: 0,0:12:40.05,0:12:41.04,Default,,0,0,0,,Біз...
Dialogue: 0,0:12:46.09,0:12:48.07,Default,,0,0,0,,Сахналық қойылым үлкен табысқа жетті.
Dialogue: 0,0:12:49.02,0:12:50.09,Default,,0,0,0,,Әңгіме не туралы болды?
Dialogue: 0,0:12:51.04,0:12:53.09,Default,,0,0,0,,Бұл біткен дүниеде өмір сүретін қыз туралы әңгіме.
Dialogue: 0,0:12:55.06,0:12:58.03,Default,,0,0,0,,Мен әңгіменің атын да, авторын да білмеймін.
Dialogue: 0,0:12:58.09,0:13:00.07,Default,,0,0,0,,Оқиға да, соңы да жұмбақ.
Dialogue: 0,0:13:01.08,0:13:03.05,Default,,0,0,0,,Анам кішкентай кезінде
Dialogue: 0,0:13:03.05,0:13:07.00,Default,,0,0,0,,Ол бұл біреу айтып берген оқиға болуы мүмкін деді.
Dialogue: 0,0:13:08.01,0:13:09.01,Default,,0,0,0,,Қызығы сол,
Dialogue: 0,0:13:09.04,0:13:12.03,Default,,0,0,0,,Әкем де бұл оқиғаны есіне түсіретін сияқты.
Dialogue: 0,0:13:12.09,0:13:14.05,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:17.04,0:13:19.04,Default,,0,0,0,,Ал ана мен әке
Dialogue: 0,0:13:20.00,0:13:25.00,Default,,0,0,0,,Содан бастап біз мәңгі бірге жүруге уәде бердік.
Dialogue: 0,0:13:35.00,0:13:37.04,Default,,0,0,0,,Мен оқуды бітірмес бұрын бір қорқынышты оқиға болды.
Dialogue: 0,0:13:38.04,0:13:41.09,Default,,0,0,0,,Анам ауырып, оқуды бітіре алмай қалды.
Dialogue: 0,0:13:42.08,0:13:44.05,Default,,0,0,0,,Әкем де шошып кетті.
Dialogue: 0,0:13:53.04,0:13:56.03,Default,,0,0,0,,Жылды да қайталауым керек еді ғой.
Dialogue: 0,0:13:59.00,0:13:59.50,Default,,0,0,0,,Томоя-кун
Dialogue: 0,0:14:03.02,0:14:06.00,Default,,0,0,0,,Осындай нәрсеге байланысты тоқтап қалсаң жақсы емес.
Dialogue: 0,0:14:06.05,0:14:09.01,Default,,0,0,0,,Егер алға жылжам десең, алға жылжу керек.
Dialogue: 0,0:14:09.08,0:14:11.07,Default,,0,0,0,,Томоя, жалғастырыңыз.
Dialogue: 0,0:14:36.01,0:14:38.01,Default,,0,0,0,,Оқуды бітіргеннен кейін біраз уақыттан кейін
Dialogue: 0,0:14:38.04,0:14:41.00,Default,,0,0,0,,Папа Сана мен Аккиге көмектесті.
Dialogue: 0,0:14:45.02,0:14:49.00,Default,,0,0,0,,Бірақ мен мұны мәңгі жасай алмайтынымды білдім.
Dialogue: 0,0:14:50.01,0:14:52.02,Default,,0,0,0,,Сондықтан мен Йошино мырзадан жақсылық сұрадым.
Dialogue: 0,0:14:52.06,0:14:55.03,Default,,0,0,0,,Мен электрмен жұмыс істейтін компанияда жұмыс істеуді шештім.
Dialogue: 0,0:14:57.00,0:15:00.02,Default,,0,0,0,,Әрине, менде алғашында көптеген сәтсіздіктер болды.
Dialogue: 0,0:15:00.07,0:15:03.06,Default,,0,0,0,,Менің бұрынғы әкем оны жек көретін шығар.
Dialogue: 0,0:15:04.06,0:15:07.03,Default,,0,0,0,,Бірақ мен қалай болса да жалғастыра алдым.
Dialogue: 0,0:15:07.07,0:15:09.03,Default,,0,0,0,,Анамның қолдауына рахмет
Dialogue: 0,0:15:09.07,0:15:13.07,Default,,0,0,0,,Йошино мырзаға және компаниядағы адамдарға әкеме көмектескені үшін рахмет.
Dialogue: 0,0:15:16.06,0:15:19.02,Default,,0,0,0,,Анам да көп жұмыс істеп, мектепке баруды жалғастырды.
Dialogue: 0,0:15:20.07,0:15:21.04,Default,,0,0,0,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,0:15:24.07,0:15:29.00,Default,,0,0,0,,Осы кезде әкем үлкен компанияға көшіп жатыр деген әңгіме болды.
Dialogue: 0,0:15:30.03,0:15:33.05,Default,,0,0,0,,Бірақ әртүрлі себептермен нәтиже болмады.
Dialogue: 0,0:15:39.06,0:15:44.01,Default,,0,0,0,,Әкемнің қолын созайын деп жатқанда қолдау көрсеткен ана болды.
Dialogue: 0,0:15:45.06,0:15:48.01,Default,,0,0,0,,Сол кезде мен анама ұсыныс жасадым
Dialogue: 0,0:15:53.02,0:15:56.00,Default,,0,0,0,,Бірақ біз бірден үйленбедік.
Dialogue: 0,0:15:57.01,0:16:01.06,Default,,0,0,0,,Анам қайтадан ауырып, бітіру рәсіміне қатыса алмады.
Dialogue: 0,0:16:06.04,0:16:10.05,Default,,0,0,0,,Бірақ бәрі жиналып, анама диплом тапсыру рәсімін өткізді.
Dialogue: 0,0:16:11.09,0:16:15.02,Default,,0,0,0,,Анам мен әкем көп ұзамай үйленді.
Dialogue: 0,0:16:22.03,0:16:24.00,Default,,0,0,0,,Әкелер ерлі-зайыптылар болды
Dialogue: 0,0:16:24.04,0:16:27.02,Default,,0,0,0,,Содан кейін ананың құрсағында сәби дүниеге келді.
Dialogue: 0,0:16:28.04,0:16:30.04,Default,,0,0,0,,Шио, бұл сен туралы.
Dialogue: 0,0:16:35.03,0:16:37.04,Default,,0,0,0,,Бірақ анамның күші жетпеді.
Dialogue: 0,0:16:38.07,0:16:41.00,Default,,0,0,0,,Сен дүниеге келгенше қиын болды.
Dialogue: 0,0:16:45.07,0:16:50.08,Default,,0,0,0,,Дәрігер маған босану кезінде кейбір қауіптер болатынын айтты.
Dialogue: 0,0:16:51.06,0:16:53.09,Default,,0,0,0,,Мен Нағисаға әлі айтқан жоқпын.
Dialogue: 0,0:16:54.02,0:16:56.06,Default,,0,0,0,,Маған ғана айтты
Dialogue: 0,0:16:58.00,0:17:00.02,Default,,0,0,0,,Мазасыздықтан депрессияға ұшыраған әкеме.
Dialogue: 0,0:17:00.08,0:17:03.02,Default,,0,0,0,,Ақки маған өткен оқиғаны айтып берді.
Dialogue: 0,0:17:04.07,0:17:08.04,Default,,0,0,0,,Ауыр дертке шалдыққан анамды жасыл орап алды...
Dialogue: 0,0:17:10.03,0:17:13.05,Default,,0,0,0,,Мен білмей тұрып, анам аман қалды.
Dialogue: 0,0:17:14.08,0:17:15.09,Default,,0,0,0,,Бұл оқиға.
Dialogue: 0,0:17:19.05,0:17:21.04,Default,,0,0,0,,Шио?
Dialogue: 0,0:17:22.07,0:17:23.09,Default,,0,0,0,,Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:17:26.09,0:17:28.08,Default,,0,0,0,,Менің біртүрлі есте сақтау қабілетім бар
Dialogue: 0,0:17:29.08,0:17:31.08,Default,,0,0,0,,Мен Ушиоға әлі айтқан жоқпын.
Dialogue: 0,0:17:32.02,0:17:34.05,Default,,0,0,0,,Ол бір рет туылған.
Dialogue: 0,0:17:36.01,0:17:37.07,Default,,0,0,0,,Сол жадта
Dialogue: 0,0:17:38.01,0:17:41.06,Default,,0,0,0,,Нагиса Ушио дүниеге келгенде қайтыс болды.
Dialogue: 0,0:17:51.07,0:17:55.02,Default,,0,0,0,,Мен Кога отбасынан Ушиоға қамқорлық жасауды өтіндім.
Dialogue: 0,0:17:55.06,0:17:56.09,Default,,0,0,0,,Жалғыз өмір сүрді
Dialogue: 0,0:18:02.02,0:18:04.03,Default,,0,0,0,,Ал Ушио бес жаста болған жаз
Dialogue: 0,0:18:08.05,0:18:11.01,Default,,0,0,0,,Тура Санае жоспарлағандай саяхаттау
Dialogue: 0,0:18:11.06,0:18:13.05,Default,,0,0,0,,Соңғы баратын жерде...
Dialogue: 0,0:18:21.09,0:18:25.02,Default,,0,0,0,,Әже маған көп ертегі айтып берді.
Dialogue: 0,0:18:26.04,0:18:29.02,Default,,0,0,0,,Мен жаңа ғана Ушиомен сөйлескен сияқтымын.
Dialogue: 0,0:18:30.09,0:18:34.03,Default,,0,0,0,,Бұл мен туылғанға дейін болған оқиға.
Dialogue: 0,0:18:40.07,0:18:43.02,Default,,0,0,0,,Қазір әкем анасына оралды.
Dialogue: 0,0:18:44.06,0:18:48.01,Default,,0,0,0,,Бір күні Шионы қайта көрейін деп ойлаймын.
Dialogue: 0,0:18:53.04,0:18:56.00,Default,,0,0,0,,Ал біз бірге тұра бастадық.
Dialogue: 0,0:18:57.07,0:19:00.02,Default,,0,0,0,,Шио балабақшасының тәрбиешісі Анзу болатын.
Dialogue: 0,0:19:04.06,0:19:06.06,Default,,0,0,0,,Усио да Фукомен дос болды.
Dialogue: 0,0:19:08.04,0:19:11.00,Default,,0,0,0,,Барлығы бір қалыпты жүріп жатты.
Dialogue: 0,0:19:12.07,0:19:13.04,Default,,0,0,0,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,0:19:16.00,0:19:17.02,Default,,0,0,0,,Не болды? Шио
Dialogue: 0,0:19:18.03,0:19:19.03,Default,,0,0,0,,Пи
Dialogue: 0,0:19:19.06,0:19:21.04,Default,,0,0,0,,Мен мұны жалғыз жасай алмадым
Dialogue: 0,0:19:21.07,0:19:22.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:26.07,0:19:27.08,Default,,0,0,0,,Не болды, Ушио?
Dialogue: 0,0:19:31.08,0:19:34.02,Default,,0,0,0,,Мен жаман түс көргендей болдым.
Dialogue: 0,0:19:36.07,0:19:39.00,Default,,0,0,0,,Әрине Шионың жағдайы жақсы.
Dialogue: 0,0:19:39.03,0:19:41.01,Default,,0,0,0,,Менде ешқашан ауыр ауру болған емес.
Dialogue: 0,0:19:43.05,0:19:46.00,Default,,0,0,0,,Бірақ сол дүниенің толқыны
Dialogue: 0,0:19:46.03,0:19:49.00,Default,,0,0,0,,Мен дәл осылай тұра алмадым.
Dialogue: 0,0:20:06.04,0:20:08.08,Default,,0,0,0,,Содан бірдеңе болды
Dialogue: 0,0:20:18.04,0:20:21.03,Default,,0,0,0,,Оянсам, дәл алдымда Нағиса тұр.
Dialogue: 0,0:20:22.05,0:20:25.06,Default,,0,0,0,,Мен бес жыл бұрын Ушио дүниеге келген күнге оралдым.
Dialogue: 0,0:20:26.07,0:20:28.00,Default,,0,0,0,,Бұл біртүрлі әңгіме.
Dialogue: 0,0:20:42.09,0:20:46.05,Default,,0,0,0,,Бірақ бұл шынымен де болды деп ойлаймын.
Dialogue: 0,0:21:03.06,0:21:05.06,Default,,0,0,0,,Нағиса екеуміз осы қалада таныстық
Dialogue: 0,0:21:06.02,0:21:08.00,Default,,0,0,0,,Шио осы қалада дүниеге келген
Dialogue: 0,0:21:09.04,0:21:11.05,Default,,0,0,0,,Мен бұл қалада көптеген адамдарды кездестірдім.
Dialogue: 0,0:21:11.09,0:21:14.06,Default,,0,0,0,,Мен бұл қалада көп тәжірибе алдым.
Dialogue: 0,0:21:16.08,0:21:21.02,Default,,0,0,0,,Біз көп адамдармен бір-бірімізге қолдау көрсетіп, өмірімізді жалғастырамыз.
Dialogue: 0,0:21:22.05,0:21:23.04,Default,,0,0,0,,Осы қалада
Dialogue: 0,0:21:36.01,0:21:37.09,Default,,0,0,0,,Фуко Шио
Dialogue: 0,0:21:38.03,0:21:39.04,Default,,0,0,0,,Мен суық тиіп қаламын.
Dialogue: 0,0:21:39.08,0:21:41.00,Default,,0,0,0,,Оянатын уақыт келді
Dialogue: 0,0:21:53.07,0:21:54.09,Default,,0,0,0,,Шио-чан
Dialogue: 0,0:21:55.02,0:21:56.02,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:21:56.05,0:21:57.07,Default,,0,0,0,,Фу-чан
Dialogue: 0,0:21:58.05,0:22:00.03,Default,,0,0,0,,Тезірек үйге қайтайық
Dialogue: 0,0:22:00.09,0:22:02.00,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:22:18.07,0:22:25.09,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.02,0:22:32.08,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.07,0:22:41.00,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.04,0:22:48.02,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.03,0:22:55.05,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.07,0:23:03.09,Default,,0,0,0,,Бір өзгеріссіз қалатын затты табыңыз
Dialogue: 0,0:23:04.04,0:23:11.06,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.08,0:23:19.05,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.05,0:23:26.07,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:27.00,0:23:34.03,Default,,0,0,0,,Сол күнгі сөздерді ант етіп өзгертіңіз
Dialogue: 0,0:23:34.04,0:23:39.02,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.52,0:23:45.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
