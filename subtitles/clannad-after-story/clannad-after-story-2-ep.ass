Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Біз ғимараттан шықтық.
Dialogue: 0,0:00:08.03,0:00:10.03,Default,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,0:00:12.01,0:00:14.06,Default,,0,0,0,,Сіз үйге бара алмайсыз.
Dialogue: 0,0:00:16.01,0:00:18.07,Default,,0,0,0,,Бұл біткен дүние
Dialogue: 0,0:00:19.04,0:00:21.05,Default,,0,0,0,,Бізден басқа ешкім жоқ
Dialogue: 0,0:00:22.07,0:00:26.07,Default,,0,0,0,,Біз өмір сүруге көмектесетін керексіз заттарды іздедік.
Dialogue: 0,0:00:28.01,0:00:32.03,Default,,0,0,0,,Олар да өмірге өз құралдарын табуы керек.
Dialogue: 0,0:00:35.05,0:00:38.04,Default,,0,0,0,,Мынаны да, мынаны да алайық.
Dialogue: 0,0:01:40.06,0:01:41.06,Default,,0,0,0,,Бұл қорқынышты болды ма?
Dialogue: 0,0:01:45.09,0:01:47.04,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:01:50.06,0:01:51.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:00.06,0:02:01.07,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:02:05.02,0:02:07.01,Default,,0,0,0,,Жұмсақ иіс шықты.
Dialogue: 0,0:02:28.00,0:02:33.04,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:02:33.06,0:02:39.00,Default,,0,0,0,,Күннің жылы дақтары көп болды.
Dialogue: 0,0:02:39.01,0:02:44.03,Default,,0,0,0,,Бұл жерде мен ғана мейірімдімін. Мен ғана мейірімдімін.
Dialogue: 0,0:02:44.04,0:02:51.06,Default,,0,0,0,,Жылулық туралы ойлану
Dialogue: 0,0:02:52.01,0:02:59.09,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:02:59.09,0:03:05.07,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:03:05.09,0:03:13.06,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:03:13.07,0:03:20.02,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:03:20.05,0:03:23.00,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:03:22.06,0:03:25.00,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:03:24.06,0:03:27.01,Default,,0,0,0,,Тек бір ғана
Dialogue: 0,0:03:26.07,0:03:29.08,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:03:29.04,0:03:34.00,Default,,0,0,0,,Мен сендерге жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:03:33.05,0:03:38.08,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын.
Dialogue: 0,0:03:46.00,0:03:47.09,Default,,0,0,0,,Бүгін тағы да мектеп асханасында түскі ас ішіп отырсыз ба?
Dialogue: 0,0:03:48.03,0:03:50.07,Default,,0,0,0,,Сіз жаңа ғана келдіңіз.
Dialogue: 0,0:03:50.07,0:03:51.03,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.07,0:03:53.09,Default,,0,0,0,,Сөйлеу алдында дұрыс тербеліңіз
Dialogue: 0,0:03:54.01,0:03:55.08,Default,,0,0,0,,Әйтпесе, іс бұзылады.
Dialogue: 0,0:03:59.03,0:04:01.07,Default,,0,0,0,,Жарайды, қайталап көрейік.
Dialogue: 0,0:04:03.01,0:04:04.09,Default,,0,0,0,,Сәлем Оказаки Сәлем.
Dialogue: 0,0:04:05.04,0:04:07.01,Default,,0,0,0,,Бүгін тағы да мектеп асханасында түскі ас ішіп жатырсыз ба?
Dialogue: 0,0:04:08.03,0:04:09.06,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:04:09.09,0:04:10.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.01,0:04:13.03,Default,,0,0,0,,Сіз үшін тым сергітеді
Dialogue: 0,0:04:13.05,0:04:15.08,Default,,0,0,0,,Кейіпкерлердің әртүрлі болғаны сонша, маған ұнамай қалды.
Dialogue: 0,0:04:15.08,0:04:17.04,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:04:17.05,0:04:20.05,Default,,0,0,0,,Сөйлемнің соңына әрқашан «және дәретхана орындықтарының қақпағын» қосыңыз.
Dialogue: 0,0:04:20.08,0:04:24.03,Default,,0,0,0,,Осылай жасасаң, балғындық өшіп, өзіңе ұқсайсың.
Dialogue: 0,0:04:26.09,0:04:27.08,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:04:28.04,0:04:30.02,Default,,0,0,0,,Маған ұнаса, мен мұны істеймін ...
Dialogue: 0,0:04:33.02,0:04:37.02,Default,,0,0,0,,А, Мей тағы да Нагиса-чанмен қалды ма?
Dialogue: 0,0:04:37.06,0:04:39.08,Default,,0,0,0,,Мен бұған мүлдем қарсы емеспін.
Dialogue: 0,0:04:40.00,0:04:42.02,Default,,0,0,0,,Себебі Мэй Чанды бәрі жақсы көреді
Dialogue: 0,0:04:43.02,0:04:47.03,Default,,0,0,0,,Ол ұсыныстан бас тарту үшін үйіне және мектебіне телефон соққанға ұқсайды.
Dialogue: 0,0:04:47.07,0:04:49.09,Default,,0,0,0,,Мен сені уайымдаймын.
Dialogue: 0,0:04:50.01,0:04:50.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.03,0:04:53.07,Default,,0,0,0,,Үлкен аға, үшінші курстың екінші семестрі.
Dialogue: 0,0:04:53.07,0:04:55.07,Default,,0,0,0,,Мен әлі мансап жолымды шешкен жоқпын.
Dialogue: 0,0:04:56.04,0:04:58.09,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, мен үйге бара алмаймын.
Dialogue: 0,0:04:59.03,0:05:03.01,Default,,0,0,0,,Мэй Чан әңгімені кейінірек тыңдағысы келетінін айтты.
Dialogue: 0,0:05:03.03,0:05:08.03,Default,,0,0,0,,Сунохара мырза, сіздің болашақ мақсаттарыңыз немесе орындағыңыз келетін істеріңіз бар ма?
Dialogue: 0,0:05:09.05,0:05:11.06,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:05:12.00,0:05:13.07,Default,,0,0,0,,Өйткені жоғары оқу орнына түсу мүмкін емес
Dialogue: 0,0:05:13.08,0:05:16.09,Default,,0,0,0,,Жұмысқа орналасып, дұрыс жұмыс істе
Dialogue: 0,0:05:19.02,0:05:22.08,Default,,0,0,0,,Менің де бір ғашығым болса ғой.
Dialogue: 0,0:05:22.09,0:05:25.02,Default,,0,0,0,,Менің әпкемнің де жеңіл боларына сенімдімін.
Dialogue: 0,0:05:26.00,0:05:26.50,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:05:28.08,0:05:34.02,Default,,0,0,0,,Басқаша айтқанда, сізге болашақты уәде еткен сүйіктіңіз бар деп болжасаңыз болғаны.
Dialogue: 0,0:05:34.03,0:05:36.06,Default,,0,0,0,,Сонда Мэй Чан өзін еркін сезінеді.
Dialogue: 0,0:05:36.08,0:05:38.07,Default,,0,0,0,,Өтірік айту жақсы емес деп ойлаймын.
Dialogue: 0,0:05:38.08,0:05:41.02,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:05:41.03,0:05:45.01,Default,,0,0,0,,Мен саған айтамын, сен онша ұсқынсыз емессің.
Dialogue: 0,0:05:45.03,0:05:48.07,Default,,0,0,0,,Сәби жүзі бар, аналық инстинкті қытықтайтын түрі.
Dialogue: 0,0:05:48.09,0:05:51.00,Default,,0,0,0,,Мектебіміздегі ең жақсы сәби жүзі
Dialogue: 0,0:05:51.02,0:05:52.07,Default,,0,0,0,,Бала Сунохара
Dialogue: 0,0:05:53.04,0:05:54.08,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:05:55.03,0:05:56.06,Default,,0,0,0,,Тіпті жалған дос қыз
Dialogue: 0,0:05:56.06,0:06:00.01,Default,,0,0,0,,Бұл шын мәнінде танысуды бастауға мүмкіндік болуы мүмкін.
Dialogue: 0,0:06:00.02,0:06:02.05,Default,,0,0,0,,О, Оказаки сиқыры?
Dialogue: 0,0:06:02.07,0:06:05.00,Default,,0,0,0,,Мен қандай да бір түрде ынталы сезінемін.
Dialogue: 0,0:06:06.02,0:06:09.09,Default,,0,0,0,,Томоя-кун, сен жай ғана көңіл көтеріп жатқан жоқсың ба?
Dialogue: 0,0:06:10.03,0:06:12.02,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:06:12.02,0:06:13.06,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:06:13.06,0:06:16.06,Default,,0,0,0,,Айтқаныңызды бірден тыңдайтын сияқты, тыныш қыз.
Dialogue: 0,0:06:16.06,0:06:18.07,Default,,0,0,0,,Сіз шынымен де оған лайықсыз, солай емес пе?
Dialogue: 0,0:06:18.08,0:06:20.06,Default,,0,0,0,,Аа, мен дәл таптым.
Dialogue: 0,0:06:22.03,0:06:25.02,Default,,0,0,0,,Міне! Бір минут күте тұрыңыз, сіз одан сұрап жатырсыз ба?
Dialogue: 0,0:06:31.05,0:06:33.06,Default,,0,0,0,,Сіз соншалықты таң қалмас едіңіз, солай ма?
Dialogue: 0,0:06:33.07,0:06:36.01,Default,,0,0,0,,Жәй сыңай таныту, жай кейіптеу~
Dialogue: 0,0:06:36.01,0:06:38.08,Default,,0,0,0,,Егер қолыңнан келмесе, бас тартуға болады.
Dialogue: 0,0:06:39.02,0:06:43.02,Default,,0,0,0,,Сіз бұл қандай жігіт екенін жақсы білесіз.
Dialogue: 0,0:06:43.09,0:06:45.05,Default,,0,0,0,,Мүмкін емес Бұл мүмкін емес
Dialogue: 0,0:06:45.05,0:06:47.07,Default,,0,0,0,,Бұл мен үшін тым ауыр
Dialogue: 0,0:06:48.03,0:06:50.08,Default,,0,0,0,,Мен бұл туралы ойлаған сайын ыңғайсызданамын.
Dialogue: 0,0:06:51.08,0:06:52.06,Default,,0,0,0,,…
Dialogue: 0,0:06:54.02,0:06:56.03,Default,,0,0,0,,Муку-чан, өтінемін, жылама.
Dialogue: 0,0:06:58.09,0:07:03.00,Default,,0,0,0,,Мен мұндай нәрселерді көргенде, өзімді одан сайын күштеп алғым келеді.
Dialogue: 0,0:07:03.06,0:07:05.09,Default,,0,0,0,,Сіз осындай нәрселерді айтып жатырсыз ...
Dialogue: 0,0:07:16.01,0:07:17.04,Default,,0,0,0,,Амансың ба? Муку
Dialogue: 0,0:07:17.04,0:07:18.04,Default,,0,0,0,,Сізді қорлады ма?
Dialogue: 0,0:07:19.02,0:07:22.00,Default,,0,0,0,,Жарайды, олай емес.
Dialogue: 0,0:07:22.01,0:07:25.06,Default,,0,0,0,,Балалар, менің сүйкімді әпкемді не істедіңдер?
Dialogue: 0,0:07:27.00,0:07:28.06,Default,,0,0,0,,Бұл түсінбеушілік, Ан Чан.
Dialogue: 0,0:07:29.01,0:07:32.04,Default,,0,0,0,,Негізі Суохара мырзаның жалған ғашығы бар еді...
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,Осы жолы Анзудан сұрауым керек пе?
Dialogue: 0,0:07:35.05,0:07:38.01,Default,,0,0,0,,Сіз ешқашан келісесіз деп ойлаймын.
Dialogue: 0,0:07:38.03,0:07:40.04,Default,,0,0,0,,Оның осындай мінезі бар...
Dialogue: 0,0:07:40.04,0:07:42.04,Default,,0,0,0,,Ол қатыгез және тез ашуланады.
Dialogue: 0,0:07:42.04,0:07:45.04,Default,,0,0,0,,Ақылға сыймайтын сөздер айтып, мені жұмыс ретінде пайдаланады.
Dialogue: 0,0:07:45.04,0:07:47.07,Default,,0,0,0,,Сіз оны мүмкіндігінше қатты ести аласыз, солай ма?
Dialogue: 0,0:07:49.01,0:07:50.06,Default,,0,0,0,,Қайта айтайын ба?
Dialogue: 0,0:07:50.09,0:07:52.03,Default,,0,0,0,,Айтып алсаң, сауап.
Dialogue: 0,0:07:52.04,0:07:56.00,Default,,0,0,0,,Қолымды тамағыңнан төмен түсіріп, дауыс байламыңды жұлып аламын.
Dialogue: 0,0:07:56.00,0:07:57.07,Default,,0,0,0,,...
Dialogue: 0,0:07:58.05,0:07:59.08,Default,,0,0,0,,Сіз кешірім сұрадыңыз!
Dialogue: 0,0:08:01.02,0:08:04.02,Default,,0,0,0,,Кешірім сұраған бетте бірдеңе дұрыс емес.
Dialogue: 0,0:08:06.01,0:08:07.01,Default,,0,0,0,,Жүр, Мұку.
Dialogue: 0,0:08:07.01,0:08:09.00,Default,,0,0,0,,Менің қасымда болсаң, мен сені ақымақ ұстаймын.
Dialogue: 0,0:08:09.01,0:08:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:08:13.04,0:08:16.05,Default,,0,0,0,,Неліктен еркектерде мұндай нәзіктік болмайды?
Dialogue: 0,0:08:16.07,0:08:17.07,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:08:21.00,0:08:24.05,Default,,0,0,0,,Сунохара мырза, сіз жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:08:24.06,0:08:25.06,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:08:25.07,0:08:30.01,Default,,0,0,0,,Студент қыздар оны қорлаған кезде бұл жігіт ең көп жарқырайды.
Dialogue: 0,0:08:30.01,0:08:32.02,Default,,0,0,0,,Жаңылыстыратын сөздерді айтпа
Dialogue: 0,0:08:32.09,0:08:35.08,Default,,0,0,0,,Бірақ Фудзибаяши мен Анзу екеуі де сәтсіздікке ұшыраса.
Dialogue: 0,0:08:36.00,0:08:38.04,Default,,0,0,0,,Тағы кім қабылдауға дайын болуы мүмкін...
Dialogue: 0,0:08:42.01,0:08:45.03,Default,,0,0,0,,Неліктен Томойо-саннан сұрамасқа?
Dialogue: 0,0:08:45.09,0:08:46.06,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:08:46.08,0:08:51.03,Default,,0,0,0,,Менің ойымша, ол әдемі, қамқор және тамаша адам.
Dialogue: 0,0:08:51.06,0:08:53.02,Default,,0,0,0,,Оны тоқтатқан дұрыс.
Dialogue: 0,0:08:53.02,0:08:54.06,Default,,0,0,0,,Мына жігіт те қорқады.
Dialogue: 0,0:08:54.06,0:08:57.07,Default,,0,0,0,,Кім шошып кетті?
Dialogue: 0,0:08:57.08,0:08:59.04,Default,,0,0,0,,Тағы бір «би» бар
Dialogue: 0,0:08:59.08,0:09:02.02,Default,,0,0,0,,Әзірше терең дем алып, тынышталыңыз.
Dialogue: 0,0:09:06.04,0:09:08.00,Default,,0,0,0,,Жарайды, мен жақсы бала туамын.
Dialogue: 0,0:09:08.02,0:09:10.05,Default,,0,0,0,,Сунохара мырза, мен абдырап қалдым.
Dialogue: 0,0:09:10.07,0:09:14.06,Default,,0,0,0,,Ойлап қарасаңыз, ол жігіт екеуміз тағдырлас бақталас едік.
Dialogue: 0,0:09:15.02,0:09:17.07,Default,,0,0,0,,Бетпе-бет кездескенде ылғи ұрысатынбыз.
Dialogue: 0,0:09:21.08,0:09:22.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:22.07,0:09:24.07,Default,,0,0,0,,Сіз әдеттен тыс уайымдап жатқан сияқтысыз.
Dialogue: 0,0:09:24.09,0:09:27.03,Default,,0,0,0,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:09:28.05,0:09:29.09,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:09:31.07,0:09:32.05,Default,,0,0,0,,Бірақ білесің бе—
Dialogue: 0,0:09:34.09,0:09:38.09,Default,,0,0,0,,Менен басқа ешкім сені өлтіргенін көргім келмейді.
Dialogue: 0,0:09:43.00,0:09:45.03,Default,,0,0,0,,Бір-бірінің қабілетін танитын адамдар
Dialogue: 0,0:09:45.04,0:09:49.01,Default,,0,0,0,,Ішімізде жылы сезімге бөленеміз.
Dialogue: 0,0:09:49.01,0:09:50.03,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:09:50.09,0:09:52.05,Default,,0,0,0,,Сондықтан мен барамын
Dialogue: 0,0:09:56.01,0:09:58.05,Default,,0,0,0,,Шайдың ащысы – танин деп аталатын зат.
Dialogue: 0,0:09:58.07,0:10:02.08,Default,,0,0,0,,Мен оны кетіру үшін ас содасын жиі қолданамын, бірақ егер...
Dialogue: 0,0:10:06.08,0:10:09.00,Default,,0,0,0,,Олай болмаса, сірке суы жақсы болар еді деп ойлаймын.
Dialogue: 0,0:10:09.01,0:10:10.05,Default,,0,0,0,,Оны елемеңіз!
Dialogue: 0,0:10:10.07,0:10:13.02,Default,,0,0,0,,Сакагами мырза, сіз бұл адамды танисыз ба?
Dialogue: 0,0:10:13.04,0:10:14.05,Default,,0,0,0,,Алыс болыңыз
Dialogue: 0,0:10:14.06,0:10:16.02,Default,,0,0,0,,Көзге тию қауіпті
Dialogue: 0,0:10:17.00,0:10:19.01,Default,,0,0,0,,Адамдарды хайуан деп атама!
Dialogue: 0,0:10:19.02,0:10:22.02,Default,,0,0,0,,Томойо-сан, мені тыңдашы.
Dialogue: 0,0:10:22.07,0:10:26.03,Default,,0,0,0,,Кога мырза, кеше бейсбол қызықты болды.
Dialogue: 0,0:10:27.02,0:10:30.03,Default,,0,0,0,,Иә, Томойо-сан жақсы болды.
Dialogue: 0,0:10:31.07,0:10:34.05,Default,,0,0,0,,Мен сені бірінші рет Кога-сан деп атадым.
Dialogue: 0,0:10:35.02,0:10:36.04,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:10:36.05,0:10:39.01,Default,,0,0,0,,Әрине, мен бақыттымын.
Dialogue: 0,0:10:39.01,0:10:41.08,Default,,0,0,0,,Екеумізді ғана қуанта алмайсыз ба?
Dialogue: 0,0:10:41.08,0:10:43.08,Default,,0,0,0,,Не, сен әлі осындасың ба?
Dialogue: 0,0:10:44.01,0:10:47.05,Default,,0,0,0,,Менің сізден бір жақсылығым бар сияқты. Оны тыңдай аласыз ба?
Dialogue: 0,0:10:49.04,0:10:54.00,Default,,0,0,0,,Балалар, сендер менен үнемі жақсылық сұрайсыңдар.
Dialogue: 0,0:10:55.08,0:10:58.00,Default,,0,0,0,,Мен қазір уайымдап тұрмын.
Dialogue: 0,0:10:58.05,0:11:01.03,Default,,0,0,0,,Бұл әдеттегі ауа-райы сияқты ма?
Dialogue: 0,0:11:01.06,0:11:04.00,Default,,0,0,0,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:11:04.00,0:11:05.06,Default,,0,0,0,,Олай болса, мүлде жоқ.
Dialogue: 0,0:11:05.06,0:11:06.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:06.07,0:11:10.02,Default,,0,0,0,,«Сені менен басқа ешкім өлтіргенін көргім келмейді!» деп айт.
Dialogue: 0,0:11:10.02,0:11:11.02,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:11:11.02,0:11:12.09,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:11:12.09,0:11:15.04,Default,,0,0,0,,Айтыңызшы, әңгіме өрбімейді.
Dialogue: 0,0:11:18.00,0:11:22.01,Default,,0,0,0,,Сенің менен басқа ешкім өлтіргенін көргім келмейді.
Dialogue: 0,0:11:22.09,0:11:24.04,Default,,0,0,0,,Кім өлтіріледі?
Dialogue: 0,0:11:24.07,0:11:25.09,Default,,0,0,0,,Неліктен мұнда...
Dialogue: 0,0:11:27.03,0:11:30.00,Default,,0,0,0,,Ұрыс таңдағыңыз келсе, айтыңыз.
Dialogue: 0,0:11:30.05,0:11:33.07,Default,,0,0,0,,Олай болса, Кога Оказаки мырза
Dialogue: 0,0:11:35.06,0:11:36.09,Default,,0,0,0,,Өте керемет~
Dialogue: 0,0:11:36.09,0:11:38.05,Default,,0,0,0,,Сакагами мырза күткендей
Dialogue: 0,0:11:41.04,0:11:43.09,Default,,0,0,0,,Түсіндім, мен саған көмектесемін.
Dialogue: 0,0:11:44.00,0:11:46.09,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен. Котоми-чан мейірімді
Dialogue: 0,0:11:47.01,0:11:50.00,Default,,0,0,0,,Мен досыма көмектескім келеді.
Dialogue: 0,0:11:50.01,0:11:52.06,Default,,0,0,0,,Маған не істеу керектігін айтқым келеді.
Dialogue: 0,0:11:53.00,0:11:54.05,Default,,0,0,0,,Егер сіз кездесіп жүрсеңіз
Dialogue: 0,0:11:54.06,0:11:58.04,Default,,0,0,0,,Менің ойымша, біз бірге ойнаймыз және әр түрлі қызықты нәрселер жасаймыз.
Dialogue: 0,0:11:58.06,0:11:59.05,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:11:59.09,0:12:00.09,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:01.09,0:12:02.09,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:12:05.08,0:12:08.04,Default,,0,0,0,,Өйткені сіз ақымақ нәрсе айтасыз
Dialogue: 0,0:12:08.07,0:12:11.02,Default,,0,0,0,,Скрипка Жаңа ғана жөндеген жоқсың ба?
Dialogue: 0,0:12:11.03,0:12:14.04,Default,,0,0,0,,Иә, мен бұрынғыдан да жақсы дыбыс шығара аламын.
Dialogue: 0,0:12:14.04,0:12:16.09,Default,,0,0,0,,Дәлірек айтсақ, ол қосылды, солай ма?
Dialogue: 0,0:12:18.08,0:12:21.00,Default,,0,0,0,,Сунохара мырза, жақсысыз ба?
Dialogue: 0,0:12:21.01,0:12:23.08,Default,,0,0,0,,Мен ОК ала алсам да.
Dialogue: 0,0:12:24.02,0:12:27.05,Default,,0,0,0,,Менің бұл дыбысқа шыдауға батылым жетпейді.
Dialogue: 0,0:12:27.09,0:12:29.00,Default,,0,0,0,,Көңіліңізді түсірмеңіз
Dialogue: 0,0:12:29.00,0:12:31.02,Default,,0,0,0,,Әлі де үміт бар
Dialogue: 0,0:12:32.01,0:12:33.04,Default,,0,0,0,,Миязава сонда ма?
Dialogue: 0,0:12:34.05,0:12:39.01,Default,,0,0,0,,Оказаки мырза, Кога мырза және Суохара мырза, біраз уақыт өтті.
Dialogue: 0,0:12:39.03,0:12:42.02,Default,,0,0,0,,Иә, біраз уақыт болды, Миадзава-сан.
Dialogue: 0,0:12:42.03,0:12:43.05,Default,,0,0,0,,Юкине-чан?
Dialogue: 0,0:12:44.00,0:12:47.05,Default,,0,0,0,,Менің айтқанымды тыңдайтыныңызға сенімдімін.
Dialogue: 0,0:12:48.09,0:12:51.01,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:52.04,0:12:54.03,Default,,0,0,0,,Бұл жалған қыз ба?
Dialogue: 0,0:12:54.03,0:12:56.05,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:12:56.05,0:12:58.02,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:12:58.03,0:13:00.06,Default,,0,0,0,,Мен сені дұрыс жолға саламын.
Dialogue: 0,0:13:00.09,0:13:01.06,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:13:01.09,0:13:02.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:03.00,0:13:04.09,Default,,0,0,0,,Сіз мұны біраз уақыттан бері сұрап жатырсыз.
Dialogue: 0,0:13:06.03,0:13:07.07,Default,,0,0,0,,Біздің Юки-ниге
Dialogue: 0,0:13:07.07,0:13:10.08,Default,,0,0,0,,Сіз маған өте батыл жақсылық сұрайсыз, солай емес пе?
Dialogue: 0,0:13:10.08,0:13:12.00,Default,,0,0,0,,О? Кола!
Dialogue: 0,0:13:13.04,0:13:14.09,Default,,0,0,0,,Біздің Юки, солай ма?
Dialogue: 0,0:13:15.02,0:13:17.01,Default,,0,0,0,,Миязава мырза, бұл кім?
Dialogue: 0,0:13:17.01,0:13:22.05,Default,,0,0,0,,Бұл менің тұтынушым. Белгілі бір жағдайға байланысты осында жасырынып жүрдім.
Dialogue: 0,0:13:22.05,0:13:24.00,Default,,0,0,0,,Түсінікті айтайын
Dialogue: 0,0:13:24.01,0:13:26.03,Default,,0,0,0,,Юки-ниге қиындық тудырсаңыз
Dialogue: 0,0:13:26.04,0:13:28.00,Default,,0,0,0,,Біз үндемейміз
Dialogue: 0,0:13:28.03,0:13:28.53,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:13:33.04,0:13:36.02,Default,,0,0,0,,А, жоқ, мен өзімді әшкереледім.
Dialogue: 0,0:13:38.04,0:13:40.09,Default,,0,0,0,,Эй Юки, егер саған бірдеңе керек болса, маған хабарлас.
Dialogue: 0,0:13:41.02,0:13:42.06,Default,,0,0,0,,Мен сол жерде боламын.
Dialogue: 0,0:13:43.06,0:13:45.05,Default,,0,0,0,,Әлі сыртқа шықпаңыз.
Dialogue: 0,0:13:45.06,0:13:46.08,Default,,0,0,0,,Жасырын болуы керек
Dialogue: 0,0:13:47.00,0:13:49.00,Default,,0,0,0,,Кешіріңіз, бұл мен де.
Dialogue: 0,0:13:53.01,0:13:55.02,Default,,0,0,0,,Енді не болды?
Dialogue: 0,0:13:55.05,0:13:58.04,Default,,0,0,0,,Оған да бір ақау бар сияқты.
Dialogue: 0,0:14:02.00,0:14:04.05,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:14:04.07,0:14:07.08,Default,,0,0,0,,Мен кешкі ас әзірлеуге көмектесуім керек, сондықтан
Dialogue: 0,0:14:08.02,0:14:10.08,Default,,0,0,0,,Сәттілік, Сунохара-сан.
Dialogue: 0,0:14:14.08,0:14:17.01,Default,,0,0,0,,Қолымнан келгеннің бәрін істе десең де,
Dialogue: 0,0:14:18.03,0:14:21.06,Default,,0,0,0,,Біріншіден, оны тегін сұрау өте жақсы болды.
Dialogue: 0,0:14:21.09,0:14:23.06,Default,,0,0,0,,Сыйлық берейік
Dialogue: 0,0:14:23.08,0:14:25.08,Default,,0,0,0,,Иә? Менде ақша жоқ
Dialogue: 0,0:14:26.01,0:14:27.06,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:14:27.06,0:14:30.08,Default,,0,0,0,,Сенің сүйкімділігің мені бәрібір саған ғашық етеді, солай ма?
Dialogue: 0,0:14:30.08,0:14:33.00,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:14:33.04,0:14:35.03,Default,,0,0,0,,Алдымен басқа адамға жағымпаздану.
Dialogue: 0,0:14:35.04,0:14:38.08,Default,,0,0,0,,Сондай-ақ бұл күндері қыздар жасырын.
Dialogue: 0,0:14:38.08,0:14:40.06,Default,,0,0,0,,Мен бұл туралы жеңілдеп қалдым.
Dialogue: 0,0:14:41.01,0:14:43.02,Default,,0,0,0,,Соңында топтық психологияны қолдану
Dialogue: 0,0:14:43.03,0:14:45.05,Default,,0,0,0,,Барлығының не істеп жатқанын белгілеңіз
Dialogue: 0,0:14:46.07,0:14:47.04,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:47.07,0:14:48.08,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:14:48.09,0:14:50.01,Default,,0,0,0,,Сәлем құрбым
Dialogue: 0,0:14:50.02,0:14:51.03,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:14:51.04,0:14:52.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.00,0:14:56.04,Default,,0,0,0,,Қазір боссың ба? Мен тек менің әңгімемді тыңдауларыңызды қалаймын.
Dialogue: 0,0:14:56.04,0:14:59.07,Default,,0,0,0,,Шын мәнінде, кейбір жақсы толық емес жұмыс уақыты бар.
Dialogue: 0,0:14:59.09,0:15:02.02,Default,,0,0,0,,Мм, мен асығып тұрмын.
Dialogue: 0,0:15:02.06,0:15:04.06,Default,,0,0,0,,Мен сенің атыңды айтпаймын.
Dialogue: 0,0:15:04.06,0:15:07.06,Default,,0,0,0,,Сондай-ақ, мен сенің ата-анаңа да құпия хат беремін.
Dialogue: 0,0:15:07.06,0:15:11.00,Default,,0,0,0,,Жарайды, барлығы бірдей әрекеттермен айналысады.
Dialogue: 0,0:15:12.04,0:15:15.01,Default,,0,0,0,,Бұл күдікті барлаушы сияқты.
Dialogue: 0,0:15:15.09,0:15:16.06,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:17.07,0:15:19.04,Default,,0,0,0,,Ах, Санае-сан
Dialogue: 0,0:15:20.01,0:15:22.07,Default,,0,0,0,,Сізде қиындық бар ма?
Dialogue: 0,0:15:25.01,0:15:28.08,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:15:30.08,0:15:32.05,Default,,0,0,0,,Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:15:33.00,0:15:36.02,Default,,0,0,0,,Бұл Мэйдің ағасынан басқа ешкімге емес.
Dialogue: 0,0:15:36.04,0:15:39.00,Default,,0,0,0,,Мен сізге бір пайдасын тигізсем, қуанар едім.
Dialogue: 0,0:15:39.02,0:15:41.04,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:15:42.03,0:15:45.06,Default,,0,0,0,,Оказаки: Ол кісі Нагиса-чанның әпкесі.
Dialogue: 0,0:15:45.07,0:15:46.08,Default,,0,0,0,,Әпке?
Dialogue: 0,0:15:47.01,0:15:49.09,Default,,0,0,0,,А, сен кеше солай айттың.
Dialogue: 0,0:15:50.00,0:15:52.09,Default,,0,0,0,,Яби Нагиса-чанның әпкесі күткендей
Dialogue: 0,0:15:53.01,0:15:55.08,Default,,0,0,0,,Мұқият қарасаңыз, ол шынымен әдемі.
Dialogue: 0,0:15:56.02,0:15:58.05,Default,,0,0,0,,Бұл күлкілі, сондықтан мен сізді адастыруға рұқсат етіңіз.
Dialogue: 0,0:15:59.06,0:16:00.05,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:01.02,0:16:02.09,Default,,0,0,0,,Маған жақсы ма?
Dialogue: 0,0:16:03.04,0:16:04.06,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:16:04.07,0:16:06.03,Default,,0,0,0,,Бірақ Санаэ-сан
Dialogue: 0,0:16:06.04,0:16:09.01,Default,,0,0,0,,Оның жалған дос қыз екенін бірден білмейсің бе?
Dialogue: 0,0:16:09.04,0:16:12.02,Default,,0,0,0,,Жарайды, бетпердесін киемін.
Dialogue: 0,0:16:13.02,0:16:15.03,Default,,0,0,0,,Сонымен, Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:16:15.05,0:16:18.00,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:16:23.06,0:16:25.05,Default,,0,0,0,,Сіздің ағаңыздың қызы бар ма?
Dialogue: 0,0:16:25.09,0:16:28.00,Default,,0,0,0,,Бір-біріне болашақты уәде еткен ғашықтар
Dialogue: 0,0:16:28.03,0:16:30.07,Default,,0,0,0,,Ол керемет әдемі және берік.
Dialogue: 0,0:16:32.07,0:16:36.03,Default,,0,0,0,,Мен де жай өмір сүріп жатқан жоқпын.
Dialogue: 0,0:16:36.06,0:16:40.01,Default,,0,0,0,,Мен ересектік баспалдақтарымен бір-бірлеп көтерілемін.
Dialogue: 0,0:16:40.06,0:16:41.05,Default,,0,0,0,,Маған танысуға рұқсат етіңіз
Dialogue: 0,0:16:43.00,0:16:44.08,Default,,0,0,0,,Мені де таныстырыңыз
Dialogue: 0,0:16:45.01,0:16:49.05,Default,,0,0,0,,Мен сіңілім ретінде ағамның қандай адамға тұрмысқа шығатынын білгім келеді.
Dialogue: 0,0:16:49.08,0:16:53.01,Default,,0,0,0,,Жарайды, мен одан жоспарлары туралы сұраймын.
Dialogue: 0,0:17:00.00,0:17:03.06,Default,,0,0,0,,Драма үйірмесі әртүрлі костюмдер дайындайды, солай ма?
Dialogue: 0,0:17:03.09,0:17:05.08,Default,,0,0,0,,Мен Мэй Чанмен келесі күні кездесемін.
Dialogue: 0,0:17:06.01,0:17:08.08,Default,,0,0,0,,Ертең датаға репетиция.
Dialogue: 0,0:17:09.00,0:17:10.07,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:17:11.08,0:17:14.03,Default,,0,0,0,,Менің сезімдерім аралас
Dialogue: 0,0:17:14.07,0:17:18.02,Default,,0,0,0,,Менің анам – менің сыныптасымның сүйіктісі.
Dialogue: 0,0:17:19.04,0:17:20.08,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:17:21.02,0:17:23.08,Default,,0,0,0,,Сунохараның жігіті қалықтап келеді.
Dialogue: 0,0:17:24.00,0:17:27.02,Default,,0,0,0,,Менің ойымша Санаэ-сан Нағисаның үлкен әпкесі.
Dialogue: 0,0:17:28.02,0:17:31.09,Default,,0,0,0,,Сіз өзіңіздің әпкеңізсіз бе? Сізге көп рахмет
Dialogue: 0,0:17:31.09,0:17:33.08,Default,,0,0,0,,Жоқ, мен сені мақтап тұрған жоқпын.
Dialogue: 0,0:17:34.02,0:17:39.01,Default,,0,0,0,,Анашым, бәлкім, қайта ойлану керек шығар?
Dialogue: 0,0:17:42.00,0:17:46.04,Default,,0,0,0,,Мен Сунохара мырзаға бейсбол ойнаған кезімізден бері қызығатынмын.
Dialogue: 0,0:17:47.00,0:17:49.06,Default,,0,0,0,,Бір қарағанда ебедейсіз және сәтсіздіктерге толы болып көрінеді, бірақ
Dialogue: 0,0:17:49.09,0:17:52.05,Default,,0,0,0,,Шынымен де мейірімді бала емес пе?
Dialogue: 0,0:17:53.00,0:17:57.06,Default,,0,0,0,,Мүмкіндік болса, іс дұрыс бағытта жүретініне сенімдімін.
Dialogue: 0,0:17:59.05,0:18:02.05,Default,,0,0,0,,Мен сізге көмектескім келеді.
Dialogue: 0,0:18:03.00,0:18:08.06,Default,,0,0,0,,Жарайды, анаң айтса, мен ынтымақтасамын.
Dialogue: 0,0:18:09.00,0:18:11.05,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:18:12.00,0:18:13.02,Default,,0,0,0,,Тек бір нәрсені тексеріңіз
Dialogue: 0,0:18:13.07,0:18:16.07,Default,,0,0,0,,Қарт туралы үндеме, жарай ма?
Dialogue: 0,0:18:17.00,0:18:18.02,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:19.09,0:18:22.01,Default,,0,0,0,,Сана басқаларға көмектесуге тырысса да,
Dialogue: 0,0:18:22.05,0:18:24.08,Default,,0,0,0,,Қарт адам туралы болғандықтан, ол жынды болып барады.
Dialogue: 0,0:18:24.09,0:18:27.06,Default,,0,0,0,,Ол Сунохараны ұрып-соғуы мүмкін.
Dialogue: 0,0:18:29.04,0:18:33.00,Default,,0,0,0,,Бұл Сунохараның қауіпсіздігінің құпиясы.
Dialogue: 0,0:18:39.03,0:18:42.04,Default,,0,0,0,,Сунохара мырза, мен қатты қобалжыдым.
Dialogue: 0,0:18:42.05,0:18:44.08,Default,,0,0,0,,Қандай жиіркенішті көрініс.
Dialogue: 0,0:18:45.05,0:18:46.08,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:48.08,0:18:52.07,Default,,0,0,0,,Мен Томояның да анасын ұната бастағанына сене алмадым...
Dialogue: 0,0:18:53.01,0:18:55.07,Default,,0,0,0,,Ақымақ, не айтасың?
Dialogue: 0,0:18:57.00,0:18:57.50,Default,,0,0,0,,Ум...
Dialogue: 0,0:18:58.02,0:18:58.52,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.02,0:19:03.00,Default,,0,0,0,,Ғашық болсаң да, сені Сунохара-кун деп айту біртүрлі.
Dialogue: 0,0:19:03.02,0:19:05.02,Default,,0,0,0,,Мен сені Йохэй-кун деп атаймын.
Dialogue: 0,0:19:05.04,0:19:07.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:08.09,0:19:10.01,Default,,0,0,0,,Йохай-кун
Dialogue: 0,0:19:11.00,0:19:12.07,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:19:16.00,0:19:18.07,Default,,0,0,0,,Яби, маған бұл Йохэй-кун екенін айтты.
Dialogue: 0,0:19:20.02,0:19:22.06,Default,,0,0,0,,Алдымен қатарласып жүрейік.
Dialogue: 0,0:19:23.03,0:19:23.53,Default,,0,0,0,,Иә
Dialogue: 0,0:19:29.09,0:19:32.00,Default,,0,0,0,,Сіз жақындай аласыз.
Dialogue: 0,0:19:32.06,0:19:34.02,Default,,0,0,0,,Олар ғашықтар.
Dialogue: 0,0:19:38.02,0:19:40.05,Default,,0,0,0,,Яби, жақсы иіс шықты.
Dialogue: 0,0:19:41.04,0:19:44.04,Default,,0,0,0,,Олай болса, жеңіл заттарды қосамыз.
Dialogue: 0,0:19:46.05,0:19:48.07,Default,,0,0,0,,Яби, тым жұмсақ.
Dialogue: 0,0:19:48.08,0:19:50.04,Default,,0,0,0,,Әр кезде келіп есеп бермеңіз.
Dialogue: 0,0:19:53.09,0:19:56.09,Default,,0,0,0,,Біз дұрыс бағытта келе жатырмыз ба?
Dialogue: 0,0:19:57.02,0:19:59.08,Default,,0,0,0,,Мен күрделімін.
Dialogue: 0,0:20:06.04,0:20:07.06,Default,,0,0,0,,Және сол күні
Dialogue: 0,0:20:09.01,0:20:11.01,Default,,0,0,0,,Сунохара мырза осында.
Dialogue: 0,0:20:11.03,0:20:14.00,Default,,0,0,0,,Мэй-чан, артынан қоңырау шалып көріңіз.
Dialogue: 0,0:20:14.03,0:20:16.08,Default,,0,0,0,,Оны ол деп ойласаңыз, таң қаласыз.
Dialogue: 0,0:20:19.00,0:20:21.03,Default,,0,0,0,,Олай болса, мен байқап көрейін.
Dialogue: 0,0:20:25.00,0:20:26.02,Default,,0,0,0,,Күттіңіз бе?
Dialogue: 0,0:20:27.02,0:20:30.00,Default,,0,0,0,,Жоқ, мен жаңа ғана келдім.
Dialogue: 0,0:20:30.00,0:20:30.50,Default,,0,0,0,,Мей!
Dialogue: 0,0:20:31.09,0:20:34.02,Default,,0,0,0,,Сунохара мырза, мына бос банка ше?
Dialogue: 0,0:20:35.05,0:20:36.06,Default,,0,0,0,,Бұл да стратегия
Dialogue: 0,0:20:37.01,0:20:39.03,Default,,0,0,0,,Ол келіп, мұны көреді.
Dialogue: 0,0:20:39.08,0:20:40.05,Default,,0,0,0,,Мен осындамын, Коичи.
Dialogue: 0,0:20:41.02,0:20:46.02,Default,,0,0,0,,Сунохара мырза, сіз осынша уақыт күттіңіз.
Dialogue: 0,0:20:49.07,0:20:51.01,Default,,0,0,0,,Міне, осылай болады.
Dialogue: 0,0:20:51.04,0:20:53.08,Default,,0,0,0,,Сіз шынымен де оған лайықсыз, солай емес пе?
Dialogue: 0,0:20:53.09,0:20:56.08,Default,,0,0,0,,Бұл ер адамдар ойнайтын махаббат деп аталатын ойын
Dialogue: 0,0:20:57.05,0:21:01.00,Default,,0,0,0,,Менің ойымша, бұл баланың махаббат ойыны.
Dialogue: 0,0:21:01.00,0:21:02.07,Default,,0,0,0,,Себебі мағынасы басқа.
Dialogue: 0,0:21:03.02,0:21:06.00,Default,,0,0,0,,Ябей мен көп іштім, енді дәретханаға баруым керек.
Dialogue: 0,0:21:12.06,0:21:15.06,Default,,0,0,0,,Ынтымағы жоқ болса, әуре болады емес пе?
Dialogue: 0,0:21:16.01,0:21:18.04,Default,,0,0,0,,Дұрыс, оны тазалап көрейік.
Dialogue: 0,0:21:18.08,0:21:19.03,Default,,0,0,0,,Иә
Dialogue: 0,0:21:23.05,0:21:25.04,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:21:26.00,0:21:27.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:27.02,0:21:27.52,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:21:36.08,0:21:38.01,Default,,0,0,0,,Бұл өте...
Dialogue: 0,0:21:38.06,0:21:41.04,Default,,0,0,0,,Томоя-кун, сенің бетің қызарып кеткен жоқ па?
Dialogue: 0,0:21:44.04,0:21:45.09,Default,,0,0,0,,Сергіту ~
Dialogue: 0,0:21:46.07,0:21:47.07,Default,,0,0,0,,Йохай-кун
Dialogue: 0,0:21:50.03,0:21:52.04,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз?
Dialogue: 0,0:21:52.07,0:21:55.07,Default,,0,0,0,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:21:53.00,0:21:55.07,Default,,0,0,0,,Жоқ, мен мұнда жаңа келдім.
Dialogue: 0,0:22:02.08,0:22:05.01,Default,,0,0,0,,Бұл адам менің ағамның қызы
Dialogue: 0,0:22:18.07,0:22:25.09,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.02,0:22:32.08,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.07,0:22:41.00,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.04,0:22:48.02,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.03,0:22:55.05,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.07,0:23:03.09,Default,,0,0,0,,Бір өзгеріссіз қалатын нәрсені іздеңіз
Dialogue: 0,0:23:04.04,0:23:11.06,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.08,0:23:19.05,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.05,0:23:26.07,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:27.00,0:23:34.03,Default,,0,0,0,,Сол күнгі сөздерді антқа өзгертіңіз
Dialogue: 0,0:23:34.04,0:23:39.02,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.03,0:23:43.00,Default,,0,0,0,,Сіздің ағаңыз да үлкендердің сүйіспеншілігіне ие болады деп үміттенемін.
Dialogue: 0,0:23:43.08,0:23:45.03,Default,,0,0,0,,Мей Бір минут күте тұрыңыз.
Dialogue: 0,0:23:45.06,0:23:49.08,Default,,0,0,0,,Аа... Бірақ маған Санае-саннан қоңырау шалу керек.
Dialogue: 0,0:23:50.03,0:23:52.02,Default,,0,0,0,,Бірақ махаббат тегін, солай емес пе?
Dialogue: 0,0:23:54.07,0:23:55.07,Default,,0,0,0,,Бір минут.
Dialogue: 0,0:23:56.57,0:24:01.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
