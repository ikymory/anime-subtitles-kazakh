Dialogue: 0,0:02:28.05,0:02:33.49,*Default,NTP,0000,0000,0000,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:02:33.63,0:02:39.06,*Default,NTP,0000,0000,0000,,Күннің жылы дақтары көп болды.
Dialogue: 1,0:02:39.19,0:02:44.34,*Default,NTP,0000,0000,0000,,Бұл жерде мен ғана мейірімдімін.
Dialogue: 1,0:02:44.48,0:02:51.64,*Default,NTP,0000,0000,0000,,Жылулық туралы ойлану
Dialogue: 0,0:02:39.19,0:02:44.34,*Default,NTP,0000,0000,0000,,Мен ғана мейірімдімін.
Dialogue: 0,0:02:44.48,0:02:51.64,*Default,NTP,0000,0000,0000,,Жылулық туралы ойлану
Dialogue: 0,0:02:52.10,0:02:59.94,*Default,NTP,0000,0000,0000,,Тек сен, тек сен
Dialogue: 0,0:02:59.94,0:03:05.79,*Default,NTP,0000,0000,0000,,Мен сені сүйдім
Dialogue: 0,0:03:05.93,0:03:13.61,*Default,NTP,0000,0000,0000,,Жел көзімді бұлдыратады
Dialogue: 0,0:03:13.73,0:03:20.23,*Default,NTP,0000,0000,0000,,Ол алыс болады
Dialogue: 0,0:03:20.52,0:03:23.04,*Default,NTP,0000,0000,0000,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:03:22.64,0:03:25.06,*Default,NTP,0000,0000,0000,,Бәрі өзгерсе де
Dialogue: 0,0:03:24.66,0:03:27.12,*Default,NTP,0000,0000,0000,,Тек бір ғана
Dialogue: 0,0:03:26.72,0:03:29.81,*Default,NTP,0000,0000,0000,,Қарапайым болса да
Dialogue: 0,0:03:29.41,0:03:34.02,*Default,NTP,0000,0000,0000,,Мен сендерге жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:03:33.52,0:03:38.83,*Default,NTP,0000,0000,0000,,Мен сені мәңгілікке қорғаймын.
Dialogue: 0,0:22:18.71,0:22:25.93,*Default,NTP,0000,0000,0000,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.23,0:22:32.86,*Default,NTP,0000,0000,0000,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.74,0:22:41.07,*Default,NTP,0000,0000,0000,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.40,0:22:48.26,*Default,NTP,0000,0000,0000,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.35,0:22:55.53,*Default,NTP,0000,0000,0000,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.74,0:23:03.99,*Default,NTP,0000,0000,0000,,Бір өзгеріссіз қалатын нәрсені іздеңіз
Dialogue: 0,0:23:04.48,0:23:11.69,*Default,NTP,0000,0000,0000,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.84,0:23:19.50,*Default,NTP,0000,0000,0000,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.50,0:23:26.74,*Default,NTP,0000,0000,0000,,Қазір де жаңғырық
Dialogue: 0,0:23:27.02,0:23:34.37,*Default,NTP,0000,0000,0000,,Сол күнгі сөздерді антқа өзгертіңіз
Dialogue: 0,0:23:34.48,0:23:39.22,*Default,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:00:02.94,0:00:05.92,*Default,NTP,0000,0000,0000,,Біз ғимараттан шықтық.
Dialogue: 0,0:00:08.32,0:00:10.35,*Default,NTP,0000,0000,0000,,Алысқа бармаңыз
Dialogue: 0,0:00:12.17,0:00:14.60,*Default,NTP,0000,0000,0000,,Сіз үйге бара алмайсыз.
Dialogue: 0,0:00:16.19,0:00:18.70,*Default,NTP,0000,0000,0000,,Бұл біткен дүние
Dialogue: 0,0:00:19.45,0:00:21.55,*Default,NTP,0000,0000,0000,,Бізден басқа ешкім жоқ
Dialogue: 0,0:00:22.79,0:00:26.78,*Default,NTP,0000,0000,0000,,Біз өмір сүруге көмектесетін керексіз заттарды іздедік.
Dialogue: 0,0:00:28.16,0:00:32.37,*Default,NTP,0000,0000,0000,,Олар да өмірге өз құралдарын табуы керек.
Dialogue: 0,0:00:35.52,0:00:38.49,*Default,NTP,0000,0000,0000,,Мынаны да, мынаны да алайық.
Dialogue: 0,0:01:40.65,0:01:41.61,*Default,NTP,0000,0000,0000,,Бұл қорқынышты болды ма?
Dialogue: 0,0:01:45.92,0:01:47.41,*Default,NTP,0000,0000,0000,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:01:50.60,0:01:51.41,*Default,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:02:00.67,0:02:01.75,*Default,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:02:05.27,0:02:07.18,*Default,NTP,0000,0000,0000,,Жұмсақ иіс шықты.
Dialogue: 0,0:03:46.02,0:03:47.93,*Default,NTP,0000,0000,0000,,Бүгін тағы да мектеп асханасында түскі ас ішіп отырсыз ба?
Dialogue: 0,0:03:48.35,0:03:50.71,*Default,NTP,0000,0000,0000,,Сіз жаңа ғана келдіңіз.
Dialogue: 0,0:03:50.78,0:03:51.31,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:51.74,0:03:53.93,*Default,NTP,0000,0000,0000,,Сөйлеу алдында дұрыс тербеліңіз
Dialogue: 0,0:03:54.19,0:03:55.82,*Default,NTP,0000,0000,0000,,Әйтпесе, іс бұзылады.
Dialogue: 0,0:03:59.30,0:04:01.77,*Default,NTP,0000,0000,0000,,Жарайды, қайталап көрейік.
Dialogue: 0,0:04:03.15,0:04:04.98,*Default,NTP,0000,0000,0000,,Сәлем Оказаки Сәлем.
Dialogue: 0,0:04:05.40,0:04:07.10,*Default,NTP,0000,0000,0000,,Бүгін тағы да мектеп асханасында түскі ас ішіп жатырсыз ба?
Dialogue: 0,0:04:08.39,0:04:09.68,*Default,NTP,0000,0000,0000,,Бұл сергітеді.
Dialogue: 0,0:04:09.94,0:04:10.50,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:04:11.14,0:04:13.32,*Default,NTP,0000,0000,0000,,Сіз үшін тым сергітеді
Dialogue: 0,0:04:13.58,0:04:15.87,*Default,NTP,0000,0000,0000,,Кейіпкерлердің әртүрлі болғаны сонша, маған ұнамай қалды.
Dialogue: 0,0:04:15.89,0:04:17.45,*Default,NTP,0000,0000,0000,,Сонымен не істеуім керек?
Dialogue: 0,0:04:17.58,0:04:20.52,*Default,NTP,0000,0000,0000,,Сөйлемнің соңына әрқашан «және дәретхана орындықтарының қақпағын» қосыңыз.
Dialogue: 0,0:04:20.88,0:04:24.30,*Default,NTP,0000,0000,0000,,Осылай жасасаң, балғындық өшіп, өзіңе ұқсайсың.
Dialogue: 0,0:04:26.93,0:04:27.87,*Default,NTP,0000,0000,0000,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:04:28.43,0:04:30.24,*Default,NTP,0000,0000,0000,,Маған ұнаса, мен мұны істеймін ...
Dialogue: 0,0:04:33.26,0:04:37.28,*Default,NTP,0000,0000,0000,,А, Мей тағы да Нагиса-чанмен қалды ма?
Dialogue: 0,0:04:37.69,0:04:39.86,*Default,NTP,0000,0000,0000,,Мен бұған мүлдем қарсы емеспін.
Dialogue: 0,0:04:40.05,0:04:42.20,*Default,NTP,0000,0000,0000,,Себебі Мэй Чанды бәрі жақсы көреді
Dialogue: 0,0:04:43.26,0:04:47.37,*Default,NTP,0000,0000,0000,,Ол ұсыныстан бас тарту үшін үйіне және мектебіне телефон соққанға ұқсайды.
Dialogue: 0,0:04:47.73,0:04:49.95,*Default,NTP,0000,0000,0000,,Мен сені уайымдаймын.
Dialogue: 0,0:04:50.13,0:04:50.71,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:04:51.33,0:04:53.76,*Default,NTP,0000,0000,0000,,Үлкен аға, үшінші курстың екінші семестрі.
Dialogue: 0,0:04:53.76,0:04:55.76,*Default,NTP,0000,0000,0000,,Мен әлі мансап жолымды шешкен жоқпын.
Dialogue: 0,0:04:56.44,0:04:58.93,*Default,NTP,0000,0000,0000,,Егер жағдай осылай жалғаса берсе, мен үйге бара алмаймын.
Dialogue: 0,0:04:59.31,0:05:03.12,*Default,NTP,0000,0000,0000,,Мэй Чан әңгімені кейінірек тыңдағысы келетінін айтты.
Dialogue: 0,0:05:03.32,0:05:08.33,*Default,NTP,0000,0000,0000,,Сунохара мырза, сіздің болашақ мақсаттарыңыз немесе орындағыңыз келетін істеріңіз бар ма?
Dialogue: 0,0:05:09.56,0:05:11.66,*Default,NTP,0000,0000,0000,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:05:12.05,0:05:13.77,*Default,NTP,0000,0000,0000,,Өйткені жоғары оқу орнына түсу мүмкін емес
Dialogue: 0,0:05:13.85,0:05:16.95,*Default,NTP,0000,0000,0000,,Жұмысқа орналасып, дұрыс жұмыс істе
Dialogue: 0,0:05:19.25,0:05:22.83,*Default,NTP,0000,0000,0000,,Менің де бір ғашығым болса ғой.
Dialogue: 0,0:05:22.90,0:05:25.26,*Default,NTP,0000,0000,0000,,Менің әпкемнің де жеңіл боларына сенімдімін.
Dialogue: 0,0:05:26.04,0:05:26.84,*Default,NTP,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:05:28.88,0:05:34.26,*Default,NTP,0000,0000,0000,,Басқаша айтқанда, сізге болашақты уәде еткен сүйіктіңіз бар деп болжасаңыз болғаны.
Dialogue: 0,0:05:34.34,0:05:36.64,*Default,NTP,0000,0000,0000,,Сонда Мэй Чан өзін еркін сезінеді.
Dialogue: 0,0:05:36.87,0:05:38.77,*Default,NTP,0000,0000,0000,,Өтірік айту жақсы емес деп ойлаймын.
Dialogue: 0,0:05:38.81,0:05:41.21,*Default,NTP,0000,0000,0000,,Бұл жұмыс істей ме?
Dialogue: 0,0:05:41.38,0:05:45.14,*Default,NTP,0000,0000,0000,,Мен саған айтамын, сен онша ұсқынсыз емессің.
Dialogue: 0,0:05:45.35,0:05:48.79,*Default,NTP,0000,0000,0000,,Сәби жүзі бар, аналық инстинкті қытықтайтын түрі.
Dialogue: 0,0:05:48.96,0:05:51.04,*Default,NTP,0000,0000,0000,,Мектебіміздегі ең жақсы сәби жүзі
Dialogue: 0,0:05:51.21,0:05:52.71,*Default,NTP,0000,0000,0000,,Бала Сунохара
Dialogue: 0,0:05:53.44,0:05:54.87,*Default,NTP,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:05:55.30,0:05:56.64,*Default,NTP,0000,0000,0000,,Тіпті жалған дос қыз
Dialogue: 0,0:05:56.66,0:06:00.19,*Default,NTP,0000,0000,0000,,Бұл шын мәнінде танысуды бастауға мүмкіндік болуы мүмкін.
Dialogue: 0,0:06:00.23,0:06:02.56,*Default,NTP,0000,0000,0000,,О, Оказаки сиқыры?
Dialogue: 0,0:06:02.74,0:06:05.07,*Default,NTP,0000,0000,0000,,Мен қандай да бір түрде ынталы сезінемін.
Dialogue: 0,0:06:06.29,0:06:09.95,*Default,NTP,0000,0000,0000,,Томоя-кун, сен жай ғана көңіл көтеріп жатқан жоқсың ба?
Dialogue: 0,0:06:10.31,0:06:12.25,*Default,NTP,0000,0000,0000,,Мүлде жоқ.
Dialogue: 0,0:06:12.29,0:06:13.66,*Default,NTP,0000,0000,0000,,Біреу бар ма?
Dialogue: 0,0:06:13.66,0:06:16.63,*Default,NTP,0000,0000,0000,,Айтқаныңызды бірден тыңдайтын сияқты, тыныш қыз.
Dialogue: 0,0:06:16.67,0:06:18.77,*Default,NTP,0000,0000,0000,,Сіз шынымен де оған лайықсыз, солай емес пе?
Dialogue: 0,0:06:18.81,0:06:20.69,*Default,NTP,0000,0000,0000,,Аа, мен дәл таптым.
Dialogue: 0,0:06:22.33,0:06:22.95,*Default,NTP,0000,0000,0000,,Міне!
Dialogue: 0,0:06:22.99,0:06:25.25,*Default,NTP,0000,0000,0000,,Бір минут күте тұрыңыз, сіз одан сұрап жатырсыз ба?
Dialogue: 0,0:06:31.54,0:06:33.67,*Default,NTP,0000,0000,0000,,Сіз соншалықты таң қалмас едіңіз, солай ма?
Dialogue: 0,0:06:33.74,0:06:36.16,*Default,NTP,0000,0000,0000,,Жәй сыңай таныту, жай кейіптеу~
Dialogue: 0,0:06:36.16,0:06:38.86,*Default,NTP,0000,0000,0000,,Егер қолыңнан келмесе, бас тартуға болады.
Dialogue: 0,0:06:39.24,0:06:43.21,*Default,NTP,0000,0000,0000,,Сіз бұл қандай жігіт екенін жақсы білесіз.
Dialogue: 0,0:06:43.98,0:06:45.50,*Default,NTP,0000,0000,0000,,Мүмкін емес Бұл мүмкін емес
Dialogue: 0,0:06:45.54,0:06:47.71,*Default,NTP,0000,0000,0000,,Бұл мен үшін тым ауыр
Dialogue: 0,0:06:48.31,0:06:50.87,*Default,NTP,0000,0000,0000,,Мен бұл туралы ойлаған сайын ыңғайсызданамын.
Dialogue: 0,0:06:51.80,0:06:52.68,*Default,NTP,0000,0000,0000,,…
Dialogue: 0,0:06:54.21,0:06:56.33,*Default,NTP,0000,0000,0000,,Муку-чан, өтінемін, жылама.
Dialogue: 0,0:06:58.91,0:07:03.05,*Default,NTP,0000,0000,0000,,Мен мұндай нәрселерді көргенде, өзімді одан сайын күштеп алғым келеді.
Dialogue: 0,0:07:03.60,0:07:05.95,*Default,NTP,0000,0000,0000,,Сіз осындай нәрселерді айтып жатырсыз ...
Dialogue: 0,0:07:16.19,0:07:17.40,*Default,NTP,0000,0000,0000,,Амансың ба? Муку
Dialogue: 0,0:07:17.44,0:07:18.47,*Default,NTP,0000,0000,0000,,Сізді қорлады ма?
Dialogue: 0,0:07:19.29,0:07:22.06,*Default,NTP,0000,0000,0000,,Жарайды, олай емес.
Dialogue: 0,0:07:22.10,0:07:25.64,*Default,NTP,0000,0000,0000,,Балалар, менің сүйкімді әпкемді не істедіңдер?
Dialogue: 0,0:07:27.09,0:07:28.65,*Default,NTP,0000,0000,0000,,Бұл түсінбеушілік, Ан Чан.
Dialogue: 0,0:07:29.13,0:07:32.41,*Default,NTP,0000,0000,0000,,Негізі Суохара мырзаның жалған ғашығы бар еді...
Dialogue: 0,0:07:32.81,0:07:34.82,*Default,NTP,0000,0000,0000,,Осы жолы Анзудан сұрауым керек пе?
Dialogue: 0,0:07:35.59,0:07:38.17,*Default,NTP,0000,0000,0000,,Сіз ешқашан келісесіз деп ойлаймын.
Dialogue: 0,0:07:38.39,0:07:40.40,*Default,NTP,0000,0000,0000,,Оның осындай мінезі бар...
Dialogue: 0,0:07:40.48,0:07:42.42,*Default,NTP,0000,0000,0000,,Ол қатыгез және тез ашуланады.
Dialogue: 0,0:07:42.48,0:07:45.40,*Default,NTP,0000,0000,0000,,Ақылға сыймайтын сөздер айтып, мені жұмыс ретінде пайдаланады.
Dialogue: 0,0:07:45.44,0:07:47.75,*Default,NTP,0000,0000,0000,,Сіз оны мүмкіндігінше қатты ести аласыз, солай ма?
Dialogue: 0,0:07:49.18,0:07:50.63,*Default,NTP,0000,0000,0000,,Қайта айтайын ба?
Dialogue: 0,0:07:50.98,0:07:52.36,*Default,NTP,0000,0000,0000,,Айтып алсаң, сауап.
Dialogue: 0,0:07:52.46,0:07:56.05,*Default,NTP,0000,0000,0000,,Қолымды тамағыңнан төмен түсіріп, дауыс байламыңды жұлып аламын.
Dialogue: 0,0:07:56.09,0:07:57.76,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:58.52,0:07:59.87,*Default,NTP,0000,0000,0000,,Сіз кешірім сұрадыңыз!
Dialogue: 0,0:08:01.21,0:08:04.25,*Default,NTP,0000,0000,0000,,Кешірім сұраған бетте бірдеңе дұрыс емес.
Dialogue: 0,0:08:06.15,0:08:07.17,*Default,NTP,0000,0000,0000,,Жүр, Мұку.
Dialogue: 0,0:08:07.19,0:08:09.01,*Default,NTP,0000,0000,0000,,Менің қасымда болсаң, мен сені ақымақ ұстаймын.
Dialogue: 0,0:08:09.18,0:08:10.17,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:13.47,0:08:16.55,*Default,NTP,0000,0000,0000,,Неліктен еркектерде мұндай нәзіктік болмайды?
Dialogue: 0,0:08:16.75,0:08:17.78,*Default,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:08:21.01,0:08:24.51,*Default,NTP,0000,0000,0000,,Сунохара мырза, сіз жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:08:24.68,0:08:25.63,*Default,NTP,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:08:25.77,0:08:30.10,*Default,NTP,0000,0000,0000,,Студент қыздар оны қорлаған кезде бұл жігіт ең көп жарқырайды.
Dialogue: 0,0:08:30.14,0:08:32.20,*Default,NTP,0000,0000,0000,,Жаңылыстыратын сөздерді айтпа
Dialogue: 0,0:08:32.99,0:08:35.86,*Default,NTP,0000,0000,0000,,Бірақ Фудзибаяши мен Анзу екеуі де сәтсіздікке ұшыраса.
Dialogue: 0,0:08:36.00,0:08:38.44,*Default,NTP,0000,0000,0000,,Тағы кім қабылдауға дайын болуы мүмкін...
Dialogue: 0,0:08:42.17,0:08:45.39,*Default,NTP,0000,0000,0000,,Неліктен Томойо-саннан сұрамасқа?
Dialogue: 0,0:08:45.98,0:08:46.61,*Default,NTP,0000,0000,0000,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:08:46.83,0:08:51.37,*Default,NTP,0000,0000,0000,,Менің ойымша, ол әдемі, қамқор және тамаша адам.
Dialogue: 0,0:08:51.60,0:08:53.27,*Default,NTP,0000,0000,0000,,Оны тоқтатқан дұрыс.
Dialogue: 0,0:08:53.29,0:08:54.65,*Default,NTP,0000,0000,0000,,Мына жігіт те қорқады.
Dialogue: 0,0:08:54.69,0:08:57.74,*Default,NTP,0000,0000,0000,,Кім шошып кетті?
Dialogue: 0,0:08:57.81,0:08:59.42,*Default,NTP,0000,0000,0000,,Тағы бір «би» бар
Dialogue: 0,0:08:59.86,0:09:02.23,*Default,NTP,0000,0000,0000,,Әзірше терең дем алып, тынышталыңыз.
Dialogue: 0,0:09:06.49,0:09:08.02,*Default,NTP,0000,0000,0000,,Жарайды, мен жақсы бала туамын.
Dialogue: 0,0:09:08.25,0:09:10.58,*Default,NTP,0000,0000,0000,,Сунохара мырза, мен абдырап қалдым.
Dialogue: 0,0:09:10.79,0:09:14.62,*Default,NTP,0000,0000,0000,,Ойлап қарасаңыз, ол жігіт екеуміз тағдырлас бақталас едік.
Dialogue: 0,0:09:15.20,0:09:17.72,*Default,NTP,0000,0000,0000,,Бетпе-бет кездескенде ылғи ұрысатынбыз.
Dialogue: 0,0:09:21.81,0:09:22.50,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:22.75,0:09:24.71,*Default,NTP,0000,0000,0000,,Сіз әдеттен тыс уайымдап жатқан сияқтысыз.
Dialogue: 0,0:09:24.94,0:09:27.34,*Default,NTP,0000,0000,0000,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:09:28.57,0:09:29.98,*Default,NTP,0000,0000,0000,,Бұл да дұрыс.
Dialogue: 0,0:09:31.75,0:09:32.55,*Default,NTP,0000,0000,0000,,Бірақ білесің бе—
Dialogue: 0,0:09:34.99,0:09:38.94,*Default,NTP,0000,0000,0000,,Менен басқа ешкім сені өлтіргенін көргім келмейді.
Dialogue: 0,0:09:43.01,0:09:45.35,*Default,NTP,0000,0000,0000,,Бір-бірінің қабілетін танитын адамдар
Dialogue: 0,0:09:45.48,0:09:49.10,*Default,NTP,0000,0000,0000,,Ішімізде жылы сезімге бөленеміз.
Dialogue: 0,0:09:49.15,0:09:50.36,*Default,NTP,0000,0000,0000,,Мен таң қалдым
Dialogue: 0,0:09:50.96,0:09:52.57,*Default,NTP,0000,0000,0000,,Сондықтан мен барамын
Dialogue: 0,0:09:56.12,0:09:58.59,*Default,NTP,0000,0000,0000,,Шайдың ащысы – танин деп аталатын зат.
Dialogue: 0,0:09:58.79,0:10:02.85,*Default,NTP,0000,0000,0000,,Мен оны кетіру үшін ас содасын жиі қолданамын, бірақ егер...
Dialogue: 0,0:10:06.84,0:10:09.04,*Default,NTP,0000,0000,0000,,Олай болмаса, сірке суы жақсы болар еді деп ойлаймын.
Dialogue: 0,0:10:09.12,0:10:10.58,*Default,NTP,0000,0000,0000,,Оны елемеңіз!
Dialogue: 0,0:10:10.70,0:10:13.26,*Default,NTP,0000,0000,0000,,Сакагами мырза, сіз бұл адамды танисыз ба?
Dialogue: 0,0:10:13.46,0:10:14.57,*Default,NTP,0000,0000,0000,,Алыс болыңыз
Dialogue: 0,0:10:14.61,0:10:16.21,*Default,NTP,0000,0000,0000,,Көзге тию қауіпті
Dialogue: 0,0:10:17.03,0:10:19.19,*Default,NTP,0000,0000,0000,,Адамдарды хайуан деп атама!
Dialogue: 0,0:10:19.29,0:10:22.20,*Default,NTP,0000,0000,0000,,Томойо-сан, мені тыңдашы.
Dialogue: 0,0:10:22.71,0:10:26.39,*Default,NTP,0000,0000,0000,,Кога мырза, кеше бейсбол қызықты болды.
Dialogue: 0,0:10:27.24,0:10:30.35,*Default,NTP,0000,0000,0000,,Иә, Томойо-сан жақсы болды.
Dialogue: 0,0:10:31.70,0:10:34.57,*Default,NTP,0000,0000,0000,,Мен сені бірінші рет Кога-сан деп атадым.
Dialogue: 0,0:10:35.22,0:10:36.41,*Default,NTP,0000,0000,0000,,Қарсысыз ба?
Dialogue: 0,0:10:36.58,0:10:39.14,*Default,NTP,0000,0000,0000,,Әрине, мен бақыттымын.
Dialogue: 0,0:10:39.19,0:10:41.80,*Default,NTP,0000,0000,0000,,Екеумізді ғана қуанта алмайсыз ба?
Dialogue: 0,0:10:41.85,0:10:43.89,*Default,NTP,0000,0000,0000,,Не, сен әлі осындасың ба?
Dialogue: 0,0:10:44.14,0:10:47.54,*Default,NTP,0000,0000,0000,,Менің сізден бір жақсылығым бар сияқты. Оны тыңдай аласыз ба?
Dialogue: 0,0:10:49.44,0:10:54.07,*Default,NTP,0000,0000,0000,,Балалар, сендер менен үнемі жақсылық сұрайсыңдар.
Dialogue: 0,0:10:55.86,0:10:58.09,*Default,NTP,0000,0000,0000,,Мен қазір уайымдап тұрмын.
Dialogue: 0,0:10:58.56,0:11:01.30,*Default,NTP,0000,0000,0000,,Бұл әдеттегі ауа-райы сияқты ма?
Dialogue: 0,0:11:01.61,0:11:04.03,*Default,NTP,0000,0000,0000,,Хмф, оның сізге қатысы жоқ.
Dialogue: 0,0:11:04.07,0:11:05.63,*Default,NTP,0000,0000,0000,,Олай болса, мүлде жоқ.
Dialogue: 0,0:11:05.67,0:11:06.53,*Default,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:06.71,0:11:10.20,*Default,NTP,0000,0000,0000,,«Сені менен басқа ешкім өлтіргенін көргім келмейді!» деп айт.
Dialogue: 0,0:11:10.24,0:11:11.20,*Default,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:11:11.23,0:11:12.92,*Default,NTP,0000,0000,0000,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:11:12.96,0:11:15.46,*Default,NTP,0000,0000,0000,,Айтыңызшы, әңгіме өрбімейді.
Dialogue: 0,0:11:18.05,0:11:22.18,*Default,NTP,0000,0000,0000,,Сенің менен басқа ешкім өлтіргенін көргім келмейді.
Dialogue: 0,0:11:22.93,0:11:24.49,*Default,NTP,0000,0000,0000,,Кім өлтіріледі?
Dialogue: 0,0:11:24.78,0:11:25.98,*Default,NTP,0000,0000,0000,,Неліктен мұнда...
Dialogue: 0,0:11:27.39,0:11:30.05,*Default,NTP,0000,0000,0000,,Ұрыс таңдағыңыз келсе, айтыңыз.
Dialogue: 0,0:11:30.55,0:11:33.76,*Default,NTP,0000,0000,0000,,Олай болса, Кога Оказаки мырза
Dialogue: 0,0:11:35.68,0:11:36.92,*Default,NTP,0000,0000,0000,,Өте керемет~
Dialogue: 0,0:11:36.99,0:11:38.57,*Default,NTP,0000,0000,0000,,Сакагами мырза күткендей
Dialogue: 0,0:11:41.48,0:11:43.94,*Default,NTP,0000,0000,0000,,Түсіндім, мен саған көмектесемін.
Dialogue: 0,0:11:44.00,0:11:44.60,*Default,NTP,0000,0000,0000,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:11:44.82,0:11:46.90,*Default,NTP,0000,0000,0000,,Котоми-чан мейірімді
Dialogue: 0,0:11:47.15,0:11:50.01,*Default,NTP,0000,0000,0000,,Мен досыма көмектескім келеді.
Dialogue: 0,0:11:50.18,0:11:52.69,*Default,NTP,0000,0000,0000,,Маған не істеу керектігін айтқым келеді.
Dialogue: 0,0:11:53.03,0:11:54.57,*Default,NTP,0000,0000,0000,,Егер сіз кездесіп жүрсеңіз
Dialogue: 0,0:11:54.61,0:11:58.44,*Default,NTP,0000,0000,0000,,Менің ойымша, біз бірге ойнаймыз және әр түрлі қызықты нәрселер жасаймыз.
Dialogue: 0,0:11:58.64,0:11:59.52,*Default,NTP,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:11:59.90,0:12:00.97,*Default,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:12:01.99,0:12:02.96,*Default,NTP,0000,0000,0000,,Бұл не деген сөз өзі?
Dialogue: 0,0:12:05.86,0:12:08.40,*Default,NTP,0000,0000,0000,,Өйткені сіз ақымақ нәрсе айтасыз
Dialogue: 0,0:12:08.70,0:12:11.29,*Default,NTP,0000,0000,0000,,Скрипка Жаңа ғана жөндеген жоқсың ба?
Dialogue: 0,0:12:11.33,0:12:14.44,*Default,NTP,0000,0000,0000,,Иә, мен бұрынғыдан да жақсы дыбыс шығара аламын.
Dialogue: 0,0:12:14.46,0:12:16.91,*Default,NTP,0000,0000,0000,,Дәлірек айтсақ, ол қосылды, солай ма?
Dialogue: 0,0:12:18.85,0:12:21.05,*Default,NTP,0000,0000,0000,,Сунохара мырза, жақсысыз ба?
Dialogue: 0,0:12:21.19,0:12:23.80,*Default,NTP,0000,0000,0000,,Мен ОК ала алсам да.
Dialogue: 0,0:12:24.24,0:12:27.56,*Default,NTP,0000,0000,0000,,Менің бұл дыбысқа шыдауға батылым жетпейді.
Dialogue: 0,0:12:27.99,0:12:29.04,*Default,NTP,0000,0000,0000,,Көңіліңізді түсірмеңіз
Dialogue: 0,0:12:29.08,0:12:31.27,*Default,NTP,0000,0000,0000,,Әлі де үміт бар
Dialogue: 0,0:12:32.17,0:12:33.43,*Default,NTP,0000,0000,0000,,Миязава сонда ма?
Dialogue: 0,0:12:34.56,0:12:39.10,*Default,NTP,0000,0000,0000,,Оказаки мырза, Кога мырза және Суохара мырза, біраз уақыт өтті.
Dialogue: 0,0:12:39.33,0:12:42.28,*Default,NTP,0000,0000,0000,,Иә, біраз уақыт болды, Миадзава-сан.
Dialogue: 0,0:12:42.32,0:12:43.52,*Default,NTP,0000,0000,0000,,Юкине-чан?
Dialogue: 0,0:12:44.00,0:12:47.51,*Default,NTP,0000,0000,0000,,Менің айтқанымды тыңдайтыныңызға сенімдімін.
Dialogue: 0,0:12:48.93,0:12:51.18,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:52.43,0:12:54.30,*Default,NTP,0000,0000,0000,,Бұл жалған қыз ба?
Dialogue: 0,0:12:54.36,0:12:56.50,*Default,NTP,0000,0000,0000,,Бұл қиын сияқты.
Dialogue: 0,0:12:56.59,0:12:58.24,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес
Dialogue: 0,0:12:58.30,0:13:00.67,*Default,NTP,0000,0000,0000,,Мен сені дұрыс жолға саламын.
Dialogue: 0,0:13:00.92,0:13:01.66,*Default,NTP,0000,0000,0000,,«Сенім артамын.»
Dialogue: 0,0:13:01.95,0:13:02.47,*Default,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:13:03.08,0:13:04.90,*Default,NTP,0000,0000,0000,,Сіз мұны біраз уақыттан бері сұрап жатырсыз.
Dialogue: 0,0:13:06.36,0:13:07.76,*Default,NTP,0000,0000,0000,,Біздің Юки-ниге
Dialogue: 0,0:13:07.76,0:13:10.81,*Default,NTP,0000,0000,0000,,Сіз маған өте батыл жақсылық сұрайсыз, солай емес пе?
Dialogue: 0,0:13:10.82,0:13:12.08,*Default,NTP,0000,0000,0000,,О? Кола!
Dialogue: 0,0:13:13.49,0:13:14.93,*Default,NTP,0000,0000,0000,,Біздің Юки, солай ма?
Dialogue: 0,0:13:15.25,0:13:17.15,*Default,NTP,0000,0000,0000,,Миязава мырза, бұл кім?
Dialogue: 0,0:13:17.19,0:13:22.55,*Default,NTP,0000,0000,0000,,Бұл менің тұтынушым. Белгілі бір жағдайға байланысты осында жасырынып жүрдім.
Dialogue: 0,0:13:22.59,0:13:24.07,*Default,NTP,0000,0000,0000,,Түсінікті айтайын
Dialogue: 0,0:13:24.16,0:13:26.32,*Default,NTP,0000,0000,0000,,Юки-ниге қиындық тудырсаңыз
Dialogue: 0,0:13:26.42,0:13:28.07,*Default,NTP,0000,0000,0000,,Біз үндемейміз
Dialogue: 0,0:13:28.32,0:13:28.98,*Default,NTP,0000,0000,0000,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:13:33.46,0:13:36.28,*Default,NTP,0000,0000,0000,,А, жоқ, мен өзімді әшкереледім.
Dialogue: 0,0:13:38.43,0:13:40.98,*Default,NTP,0000,0000,0000,,Эй Юки, егер саған бірдеңе керек болса, маған хабарлас.
Dialogue: 0,0:13:41.22,0:13:42.69,*Default,NTP,0000,0000,0000,,Мен сол жерде боламын.
Dialogue: 0,0:13:43.66,0:13:45.59,*Default,NTP,0000,0000,0000,,Әлі сыртқа шықпаңыз.
Dialogue: 0,0:13:45.63,0:13:46.82,*Default,NTP,0000,0000,0000,,Жасырын болуы керек
Dialogue: 0,0:13:47.05,0:13:49.03,*Default,NTP,0000,0000,0000,,Кешіріңіз, бұл мен де.
Dialogue: 0,0:13:53.15,0:13:55.24,*Default,NTP,0000,0000,0000,,Енді не болды?
Dialogue: 0,0:13:55.58,0:13:58.45,*Default,NTP,0000,0000,0000,,Оған да бір ақау бар сияқты.
Dialogue: 0,0:14:02.07,0:14:04.52,*Default,NTP,0000,0000,0000,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:14:04.78,0:14:07.84,*Default,NTP,0000,0000,0000,,Мен кешкі ас әзірлеуге көмектесуім керек, сондықтан
Dialogue: 0,0:14:08.25,0:14:10.85,*Default,NTP,0000,0000,0000,,Сәттілік, Сунохара-сан.
Dialogue: 0,0:14:14.89,0:14:17.16,*Default,NTP,0000,0000,0000,,Қолымнан келгеннің бәрін істе десең де,
Dialogue: 0,0:14:18.34,0:14:21.69,*Default,NTP,0000,0000,0000,,Біріншіден, оны тегін сұрау өте жақсы болды.
Dialogue: 0,0:14:21.97,0:14:23.62,*Default,NTP,0000,0000,0000,,Сыйлық берейік
Dialogue: 0,0:14:23.82,0:14:25.87,*Default,NTP,0000,0000,0000,,Иә? Менде ақша жоқ
Dialogue: 0,0:14:26.13,0:14:27.63,*Default,NTP,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:14:27.65,0:14:30.80,*Default,NTP,0000,0000,0000,,Сенің сүйкімділігің мені бәрібір саған ғашық етеді, солай ма?
Dialogue: 0,0:14:30.88,0:14:33.09,*Default,NTP,0000,0000,0000,,О, жақсы.
Dialogue: 0,0:14:33.42,0:14:35.31,*Default,NTP,0000,0000,0000,,Алдымен басқа адамға жағымпаздану.
Dialogue: 0,0:14:35.48,0:14:38.81,*Default,NTP,0000,0000,0000,,Сондай-ақ бұл күндері қыздар жасырын.
Dialogue: 0,0:14:38.85,0:14:40.66,*Default,NTP,0000,0000,0000,,Мен бұл туралы жеңілдеп қалдым.
Dialogue: 0,0:14:41.17,0:14:43.23,*Default,NTP,0000,0000,0000,,Соңында топтық психологияны қолдану
Dialogue: 0,0:14:43.35,0:14:45.57,*Default,NTP,0000,0000,0000,,Барлығының не істеп жатқанын белгілеңіз
Dialogue: 0,0:14:46.76,0:14:47.49,*Default,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:47.72,0:14:48.80,*Default,NTP,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,0:14:48.93,0:14:50.11,*Default,NTP,0000,0000,0000,,Сәлем құрбым
Dialogue: 0,0:14:50.21,0:14:51.30,*Default,NTP,0000,0000,0000,,Өте сүйкімді
Dialogue: 0,0:14:51.45,0:14:52.03,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:14:53.09,0:14:56.43,*Default,NTP,0000,0000,0000,,Қазір боссың ба? Мен тек менің әңгімемді тыңдауларыңызды қалаймын.
Dialogue: 0,0:14:56.48,0:14:59.72,*Default,NTP,0000,0000,0000,,Шын мәнінде, кейбір жақсы толық емес жұмыс уақыты бар.
Dialogue: 0,0:14:59.90,0:15:02.21,*Default,NTP,0000,0000,0000,,Мм, мен асығып тұрмын.
Dialogue: 0,0:15:02.66,0:15:04.64,*Default,NTP,0000,0000,0000,,Мен сенің атыңды айтпаймын.
Dialogue: 0,0:15:04.68,0:15:07.65,*Default,NTP,0000,0000,0000,,Сондай-ақ, мен сенің ата-анаңа да құпия хат беремін.
Dialogue: 0,0:15:07.65,0:15:11.09,*Default,NTP,0000,0000,0000,,Жарайды, барлығы бірдей әрекеттермен айналысады.
Dialogue: 0,0:15:12.45,0:15:15.12,*Default,NTP,0000,0000,0000,,Бұл күдікті барлаушы сияқты.
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,---C---
Dialogue: 0,0:15:15.92,0:15:16.63,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:15:17.72,0:15:19.43,*Default,NTP,0000,0000,0000,,Ах, Санае-сан
Dialogue: 0,0:15:20.12,0:15:22.73,*Default,NTP,0000,0000,0000,,Сізде қиындық бар ма?
Dialogue: 0,0:15:25.17,0:15:28.85,*Default,NTP,0000,0000,0000,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:15:30.83,0:15:32.57,*Default,NTP,0000,0000,0000,,Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:15:33.03,0:15:36.28,*Default,NTP,0000,0000,0000,,Бұл Мэйдің ағасынан басқа ешкімге емес.
Dialogue: 0,0:15:36.46,0:15:39.00,*Default,NTP,0000,0000,0000,,Мен сізге бір пайдасын тигізсем, қуанар едім.
Dialogue: 0,0:15:39.21,0:15:41.41,*Default,NTP,0000,0000,0000,,Сәл күте тұрыңыз.
Dialogue: 0,0:15:42.30,0:15:45.62,*Default,NTP,0000,0000,0000,,Оказаки: Ол кісі Нагиса-чанның әпкесі.
Dialogue: 0,0:15:45.75,0:15:46.85,*Default,NTP,0000,0000,0000,,Әпке?
Dialogue: 0,0:15:47.15,0:15:49.91,*Default,NTP,0000,0000,0000,,А, сен кеше солай айттың.
Dialogue: 0,0:15:50.08,0:15:52.93,*Default,NTP,0000,0000,0000,,Яби Нагиса-чанның әпкесі күткендей
Dialogue: 0,0:15:53.14,0:15:55.80,*Default,NTP,0000,0000,0000,,Мұқият қарасаңыз, ол шынымен әдемі.
Dialogue: 0,0:15:56.26,0:15:58.53,*Default,NTP,0000,0000,0000,,Бұл күлкілі, сондықтан мен сізді адастыруға рұқсат етіңіз.
Dialogue: 0,0:15:59.67,0:16:00.55,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:16:01.24,0:16:02.98,*Default,NTP,0000,0000,0000,,Маған жақсы ма?
Dialogue: 0,0:16:03.43,0:16:04.67,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,0:16:04.79,0:16:06.32,*Default,NTP,0000,0000,0000,,Бірақ Санаэ-сан
Dialogue: 0,0:16:06.43,0:16:09.14,*Default,NTP,0000,0000,0000,,Оның жалған дос қыз екенін бірден білмейсің бе?
Dialogue: 0,0:16:09.46,0:16:12.22,*Default,NTP,0000,0000,0000,,Жарайды, бетпердесін киемін.
Dialogue: 0,0:16:13.25,0:16:15.31,*Default,NTP,0000,0000,0000,,Сонымен, Санаэ-сан, шын айтасың ба?
Dialogue: 0,0:16:15.54,0:16:18.00,*Default,NTP,0000,0000,0000,,Цуки… Цуки…
Dialogue: 0,0:16:23.67,0:16:25.52,*Default,NTP,0000,0000,0000,,Сіздің ағаңыздың қызы бар ма?
Dialogue: 0,0:16:25.90,0:16:28.08,*Default,NTP,0000,0000,0000,,Бір-біріне болашақты уәде еткен ғашықтар
Dialogue: 0,0:16:28.39,0:16:30.71,*Default,NTP,0000,0000,0000,,Ол керемет әдемі және берік.
Dialogue: 0,0:16:32.70,0:16:36.36,*Default,NTP,0000,0000,0000,,Мен де жай өмір сүріп жатқан жоқпын.
Dialogue: 0,0:16:36.65,0:16:40.11,*Default,NTP,0000,0000,0000,,Мен ересектік баспалдақтарымен бір-бірлеп көтерілемін.
Dialogue: 0,0:16:40.63,0:16:41.59,*Default,NTP,0000,0000,0000,,Маған танысуға рұқсат етіңіз
Dialogue: 0,0:16:43.07,0:16:44.84,*Default,NTP,0000,0000,0000,,Мені де таныстырыңыз
Dialogue: 0,0:16:45.10,0:16:49.59,*Default,NTP,0000,0000,0000,,Мен сіңілім ретінде ағамның қандай адамға тұрмысқа шығатынын білгім келеді.
Dialogue: 0,0:16:49.82,0:16:53.12,*Default,NTP,0000,0000,0000,,Жарайды, мен одан жоспарлары туралы сұраймын.
Dialogue: 0,0:17:00.06,0:17:03.63,*Default,NTP,0000,0000,0000,,Драма үйірмесі әртүрлі костюмдер дайындайды, солай ма?
Dialogue: 0,0:17:03.96,0:17:05.86,*Default,NTP,0000,0000,0000,,Мен Мэй Чанмен келесі күні кездесемін.
Dialogue: 0,0:17:06.14,0:17:08.85,*Default,NTP,0000,0000,0000,,Ертең датаға репетиция.
Dialogue: 0,0:17:09.08,0:17:10.73,*Default,NTP,0000,0000,0000,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:17:11.89,0:17:14.30,*Default,NTP,0000,0000,0000,,Менің сезімдерім аралас
Dialogue: 0,0:17:14.78,0:17:18.20,*Default,NTP,0000,0000,0000,,Менің анам – менің сыныптасымның сүйіктісі.
Dialogue: 0,0:17:19.45,0:17:20.87,*Default,NTP,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:17:21.24,0:17:23.89,*Default,NTP,0000,0000,0000,,Сунохараның жігіті қалықтап келеді.
Dialogue: 0,0:17:24.01,0:17:27.24,*Default,NTP,0000,0000,0000,,Менің ойымша Санаэ-сан Нағисаның үлкен әпкесі.
Dialogue: 0,0:17:28.25,0:17:31.91,*Default,NTP,0000,0000,0000,,Сіз өзіңіздің әпкеңізсіз бе? Сізге көп рахмет
Dialogue: 0,0:17:31.96,0:17:33.86,*Default,NTP,0000,0000,0000,,Жоқ, мен сені мақтап тұрған жоқпын.
Dialogue: 0,0:17:34.24,0:17:39.18,*Default,NTP,0000,0000,0000,,Анашым, бәлкім, қайта ойлану керек шығар?
Dialogue: 0,0:17:42.01,0:17:46.43,*Default,NTP,0000,0000,0000,,Мен Сунохара мырзаға бейсбол ойнаған кезімізден бері қызығатынмын.
Dialogue: 0,0:17:47.08,0:17:49.64,*Default,NTP,0000,0000,0000,,Бір қарағанда ебедейсіз және сәтсіздіктерге толы болып көрінеді, бірақ
Dialogue: 0,0:17:49.91,0:17:52.58,*Default,NTP,0000,0000,0000,,Шынымен де мейірімді бала емес пе?
Dialogue: 0,0:17:53.07,0:17:57.67,*Default,NTP,0000,0000,0000,,Мүмкіндік болса, іс дұрыс бағытта жүретініне сенімдімін.
Dialogue: 0,0:17:59.50,0:18:02.56,*Default,NTP,0000,0000,0000,,Мен сізге көмектескім келеді.
Dialogue: 0,0:18:03.05,0:18:08.66,*Default,NTP,0000,0000,0000,,Жарайды, анаң айтса, мен ынтымақтасамын.
Dialogue: 0,0:18:09.02,0:18:11.58,*Default,NTP,0000,0000,0000,,Иә, көп рахмет.
Dialogue: 0,0:18:12.06,0:18:13.28,*Default,NTP,0000,0000,0000,,Тек бір нәрсені тексеріңіз
Dialogue: 0,0:18:13.73,0:18:16.76,*Default,NTP,0000,0000,0000,,Қарт туралы үндеме, жарай ма?
Dialogue: 0,0:18:17.04,0:18:18.23,*Default,NTP,0000,0000,0000,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:19.98,0:18:22.12,*Default,NTP,0000,0000,0000,,Сана басқаларға көмектесуге тырысса да,
Dialogue: 0,0:18:22.50,0:18:24.84,*Default,NTP,0000,0000,0000,,Қарт адам туралы болғандықтан, ол жынды болып барады.
Dialogue: 0,0:18:24.95,0:18:27.65,*Default,NTP,0000,0000,0000,,Ол Сунохараны ұрып-соғуы мүмкін.
Dialogue: 0,0:18:29.47,0:18:33.08,*Default,NTP,0000,0000,0000,,Бұл Сунохараның қауіпсіздігінің құпиясы.
Dialogue: 0,0:18:39.31,0:18:42.41,*Default,NTP,0000,0000,0000,,Сунохара мырза, мен қатты қобалжыдым.
Dialogue: 0,0:18:42.58,0:18:44.80,*Default,NTP,0000,0000,0000,,Қандай жиіркенішті көрініс.
Dialogue: 0,0:18:45.50,0:18:46.89,*Default,NTP,0000,0000,0000,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:18:48.81,0:18:52.70,*Default,NTP,0000,0000,0000,,Мен Томояның да анасын ұната бастағанына сене алмадым...
Dialogue: 0,0:18:53.14,0:18:55.79,*Default,NTP,0000,0000,0000,,Ақымақ, не айтасың?
Dialogue: 0,0:18:57.04,0:18:57.88,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:18:58.28,0:18:58.82,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:59.24,0:19:03.08,*Default,NTP,0000,0000,0000,,Ғашық болсаң да, сені Сунохара-кун деп айту біртүрлі.
Dialogue: 0,0:19:03.28,0:19:05.29,*Default,NTP,0000,0000,0000,,Мен сені Йохэй-кун деп атаймын.
Dialogue: 0,0:19:05.41,0:19:07.67,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:19:08.95,0:19:10.13,*Default,NTP,0000,0000,0000,,Йохай-кун
Dialogue: 0,0:19:11.01,0:19:12.70,*Default,NTP,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:19:16.03,0:19:18.71,*Default,NTP,0000,0000,0000,,Яби, маған бұл Йохэй-кун екенін айтты.
Dialogue: 0,0:19:20.24,0:19:22.69,*Default,NTP,0000,0000,0000,,Алдымен қатарласып жүрейік.
Dialogue: 0,0:19:23.30,0:19:23.83,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:29.98,0:19:32.08,*Default,NTP,0000,0000,0000,,Сіз жақындай аласыз.
Dialogue: 0,0:19:32.66,0:19:34.27,*Default,NTP,0000,0000,0000,,Олар ғашықтар.
Dialogue: 0,0:19:38.27,0:19:40.52,*Default,NTP,0000,0000,0000,,Яби, жақсы иіс шықты.
Dialogue: 0,0:19:41.47,0:19:44.47,*Default,NTP,0000,0000,0000,,Олай болса, жеңіл заттарды қосамыз.
Dialogue: 0,0:19:46.56,0:19:48.79,*Default,NTP,0000,0000,0000,,Яби, тым жұмсақ.
Dialogue: 0,0:19:48.80,0:19:50.49,*Default,NTP,0000,0000,0000,,Әр кезде келіп есеп бермеңіз.
Dialogue: 0,0:19:53.93,0:19:56.96,*Default,NTP,0000,0000,0000,,Біз дұрыс бағытта келе жатырмыз ба?
Dialogue: 0,0:19:57.25,0:19:59.85,*Default,NTP,0000,0000,0000,,Мен күрделімін.
Dialogue: 0,0:20:06.40,0:20:07.63,*Default,NTP,0000,0000,0000,,Және сол күні
Dialogue: 0,0:20:09.14,0:20:11.17,*Default,NTP,0000,0000,0000,,Сунохара мырза осында.
Dialogue: 0,0:20:11.35,0:20:14.01,*Default,NTP,0000,0000,0000,,Мэй-чан, артынан қоңырау шалып көріңіз.
Dialogue: 0,0:20:14.35,0:20:16.80,*Default,NTP,0000,0000,0000,,Оны ол деп ойласаңыз, таң қаласыз.
Dialogue: 0,0:20:19.09,0:20:21.38,*Default,NTP,0000,0000,0000,,Олай болса, мен байқап көрейін.
Dialogue: 0,0:20:25.02,0:20:26.23,*Default,NTP,0000,0000,0000,,Күттіңіз бе?
Dialogue: 0,0:20:27.28,0:20:30.07,*Default,NTP,0000,0000,0000,,Жоқ, мен жаңа ғана келдім.
Dialogue: 0,0:20:30.07,0:20:30.73,*Default,NTP,0000,0000,0000,,Мей!
Dialogue: 0,0:20:31.91,0:20:34.24,*Default,NTP,0000,0000,0000,,Сунохара мырза, мына бос банка ше?
Dialogue: 0,0:20:35.52,0:20:36.62,*Default,NTP,0000,0000,0000,,Бұл да стратегия
Dialogue: 0,0:20:37.17,0:20:39.31,*Default,NTP,0000,0000,0000,,Ол келіп, мұны көреді.
Dialogue: 0,0:20:39.81,0:20:40.54,*Default,NTP,0000,0000,0000,,Мен осындамын, Коичи.
Dialogue: 0,0:20:41.25,0:20:46.23,*Default,NTP,0000,0000,0000,,Сунохара мырза, сіз осынша уақыт күттіңіз.
Dialogue: 0,0:20:49.76,0:20:51.17,*Default,NTP,0000,0000,0000,,Міне, осылай болады.
Dialogue: 0,0:20:51.41,0:20:53.80,*Default,NTP,0000,0000,0000,,Сіз шынымен де оған лайықсыз, солай емес пе?
Dialogue: 0,0:20:53.96,0:20:56.89,*Default,NTP,0000,0000,0000,,Бұл ер адамдар ойнайтын махаббат деп аталатын ойын
Dialogue: 0,0:20:57.57,0:21:01.01,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл баланың махаббат ойыны.
Dialogue: 0,0:21:01.05,0:21:02.72,*Default,NTP,0000,0000,0000,,Себебі мағынасы басқа.
Dialogue: 0,0:21:03.28,0:21:06.01,*Default,NTP,0000,0000,0000,,Ябей мен көп іштім, енді дәретханаға баруым керек.
Dialogue: 0,0:21:12.65,0:21:15.62,*Default,NTP,0000,0000,0000,,Ынтымағы жоқ болса, әуре болады емес пе?
Dialogue: 0,0:21:16.12,0:21:18.40,*Default,NTP,0000,0000,0000,,Дұрыс, оны тазалап көрейік.
Dialogue: 0,0:21:18.81,0:21:19.38,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:23.58,0:21:25.49,*Default,NTP,0000,0000,0000,,Мен де саған көмектесемін.
Dialogue: 0,0:21:26.04,0:21:27.15,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:21:27.21,0:21:27.98,*Default,NTP,0000,0000,0000,,Мен көптен бері өлі болсам да
Dialogue: 0,0:21:36.81,0:21:38.16,*Default,NTP,0000,0000,0000,,Бұл өте...
Dialogue: 0,0:21:38.61,0:21:41.49,*Default,NTP,0000,0000,0000,,Томоя-кун, сенің бетің қызарып кеткен жоқ па?
Dialogue: 0,0:21:44.48,0:21:45.90,*Default,NTP,0000,0000,0000,,Сергіту ~
Dialogue: 0,0:21:46.77,0:21:47.71,*Default,NTP,0000,0000,0000,,Йохай-кун
Dialogue: 0,0:21:50.39,0:21:52.41,*Default,NTP,0000,0000,0000,,Сізді күткенім үшін кешіріңіз?
Dialogue: 0,0:21:52.73,0:21:55.75,*Default,NTP,0000,0000,0000,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:21:53.06,0:21:55.75,*Default,NTP,0000,0000,0000,,Жоқ, мен мұнда жаңа келдім.
Dialogue: 0,0:22:02.84,0:22:05.13,*Default,NTP,0000,0000,0000,,Бұл адам менің ағамның қызы
Dialogue: 0,0:23:40.32,0:23:43.09,*Default,NTP,0000,0000,0000,,Сіздің ағаңыз да үлкендердің сүйіспеншілігіне ие болады деп үміттенемін.
Dialogue: 0,0:23:43.85,0:23:45.33,*Default,NTP,0000,0000,0000,,Мей Бір минут күте тұрыңыз.
Dialogue: 0,0:23:45.65,0:23:49.83,*Default,NTP,0000,0000,0000,,Аа... Бірақ маған Санае-саннан қоңырау шалу керек.
Dialogue: 0,0:23:50.39,0:23:52.24,*Default,NTP,0000,0000,0000,,Бірақ махаббат тегін, солай емес пе?
Dialogue: 0,0:23:54.71,0:23:55.76,*Default,NTP,0000,0000,0000,,Бір минут.
Dialogue: 0,0:23:57.26,0:24:03.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory