Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:53.90,0:01:59.34,*Default,NTP,0000,0000,0000,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:01:59.48,0:02:04.91,*Default,NTP,0000,0000,0000,,Көптеген жылы күн бассейндері пайда болды.
Dialogue: 0,0:02:05.04,0:02:10.19,*Default,NTP,0000,0000,0000,,Мен ғана мейірімдімін.
Dialogue: 0,0:02:10.33,0:02:17.49,*Default,NTP,0000,0000,0000,,Жылылықты еске түсіру
Dialogue: 0,0:02:17.95,0:02:25.79,*Default,NTP,0000,0000,0000,,Тек сен, тек сен
Dialogue: 0,0:02:25.79,0:02:31.64,*Default,NTP,0000,0000,0000,,Мен сені сүйдім
Dialogue: 0,0:02:31.78,0:02:39.46,*Default,NTP,0000,0000,0000,,Жел көзімді бұлдыратады
Dialogue: 0,0:02:39.58,0:02:46.08,*Default,NTP,0000,0000,0000,,Ол алыс болады
Dialogue: 0,0:02:46.37,0:02:48.89,*Default,NTP,0000,0000,0000,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:02:48.49,0:02:50.91,*Default,NTP,0000,0000,0000,,Бәрі өзгерсе де
Dialogue: 0,0:02:50.51,0:02:52.97,*Default,NTP,0000,0000,0000,,Тек бір ғана
Dialogue: 0,0:02:52.57,0:02:55.66,*Default,NTP,0000,0000,0000,,Қарапайым болса да
Dialogue: 0,0:02:55.26,0:02:59.87,*Default,NTP,0000,0000,0000,,Мен саған жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:02:59.37,0:03:04.68,*Default,NTP,0000,0000,0000,,Мен сені мәңгілікке қорғаймын
Dialogue: 0,0:22:18.71,0:22:25.93,*Default,NTP,0000,0000,0000,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.23,0:22:32.86,*Default,NTP,0000,0000,0000,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.74,0:22:41.07,*Default,NTP,0000,0000,0000,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.40,0:22:48.26,*Default,NTP,0000,0000,0000,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.35,0:22:55.53,*Default,NTP,0000,0000,0000,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.74,0:23:03.99,*Default,NTP,0000,0000,0000,,Бір өзгеріссіз қалатын затты табыңыз
Dialogue: 0,0:23:04.48,0:23:11.69,*Default,NTP,0000,0000,0000,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.84,0:23:19.50,*Default,NTP,0000,0000,0000,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.50,0:23:26.74,*Default,NTP,0000,0000,0000,,Қазір де жаңғырық
Dialogue: 0,0:23:27.02,0:23:34.37,*Default,NTP,0000,0000,0000,,Сол күнгі сөздерді ант етіп өзгертіңіз
Dialogue: 0,0:23:34.48,0:23:39.22,*Default,NTP,0000,0000,0000,,Мен барамын
Dialogue: 0,0:00:02.25,0:00:02.89,*Default,NTP,0000,0000,0000,,Шио
Dialogue: 0,0:00:03.59,0:00:06.48,*Default,NTP,0000,0000,0000,,Бұл сен туылмай тұрып...
Dialogue: 0,0:00:07.95,0:00:10.35,*Default,NTP,0000,0000,0000,,Бұл сен туылғанға дейінгі оқиға.
Dialogue: 0,0:00:11.65,0:00:16.25,*Default,NTP,0000,0000,0000,,Анам мен әкем алғаш рет мен орта мектепте жоғары сыныпта оқып жүрген кезімде сөйлесті.
Dialogue: 0,0:00:16.75,0:00:18.87,*Default,NTP,0000,0000,0000,,Сіз бірінші рет кездестіңіз бе?
Dialogue: 0,0:00:19.15,0:00:22.59,*Default,NTP,0000,0000,0000,,Аа, біз әлі бір-біріміздің атын да білмедік.
Dialogue: 0,0:00:29.77,0:00:30.57,*Default,NTP,0000,0000,0000,,Иә, иә...
Dialogue: 0,0:00:31.25,0:00:32.11,*Default,NTP,0000,0000,0000,,Анпан
Dialogue: 0,0:00:33.96,0:00:36.08,*Default,NTP,0000,0000,0000,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:00:36.81,0:00:39.62,*Default,NTP,0000,0000,0000,,Маған бұл өте ұнайды.
Dialogue: 0,0:00:40.05,0:00:41.66,*Default,NTP,0000,0000,0000,,Бірақ ештеңе...
Dialogue: 0,0:00:41.92,0:00:43.92,*Default,NTP,0000,0000,0000,,Мен өзгермей тұра алмаймын
Dialogue: 0,0:00:51.48,0:00:54.73,*Default,NTP,0000,0000,0000,,Барлық қызықты және қуанышты нәрселер...
Dialogue: 0,0:00:56.01,0:00:58.40,*Default,NTP,0000,0000,0000,,Барлығы өзгермейді.
Dialogue: 0,0:00:58.72,0:01:01.65,*Default,NTP,0000,0000,0000,,Сіз бұл жерді әлі де жақсы көре аласыз ба?
Dialogue: 0,0:01:03.51,0:01:04.74,*Default,NTP,0000,0000,0000,,Тек оны табыңыз.
Dialogue: 0,0:01:16.93,0:01:20.93,*Default,NTP,0000,0000,0000,,Тек келесі қызықты нәрсені немесе сізді бақытты ететін нәрсені табыңыз.
Dialogue: 0,0:01:23.94,0:01:25.25,*Default,NTP,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:03:11.36,0:03:14.53,*Default,NTP,0000,0000,0000,,Әкелеріміз осылай танысқан.
Dialogue: 0,0:03:16.28,0:03:19.67,*Default,NTP,0000,0000,0000,,Анам басқа оқушылардан бір жас үлкен болатын.
Dialogue: 0,0:03:24.82,0:03:26.97,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:27.15,0:03:30.50,*Default,NTP,0000,0000,0000,,Неге мұндай жерде түскі асты жалғыз ішесің?
Dialogue: 0,0:03:31.76,0:03:34.66,*Default,NTP,0000,0000,0000,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:03:35.57,0:03:37.06,*Default,NTP,0000,0000,0000,,Жоқ, айтайық...
Dialogue: 0,0:03:37.10,0:03:39.85,*Default,NTP,0000,0000,0000,,Маған өте ұнайды.
Dialogue: 0,0:03:39.90,0:03:43.73,*Default,NTP,0000,0000,0000,,Бұрын сөйлесетін адамдарым, жақсы дос болатын мұғалімдерім болды.
Dialogue: 0,0:03:43.91,0:03:45.39,*Default,NTP,0000,0000,0000,,Бірақ қазір...
Dialogue: 0,0:03:45.73,0:03:46.87,*Default,NTP,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:03:47.66,0:03:52.02,*Default,NTP,0000,0000,0000,,Өткен жылы мектептен ұзақ үзіліс алдым.
Dialogue: 0,0:03:52.13,0:03:53.13,*Default,NTP,0000,0000,0000,,Сонымен...
Dialogue: 0,0:03:54.00,0:03:54.92,*Default,NTP,0000,0000,0000,,Бұл көшірме болды ма?
Dialogue: 0,0:03:55.63,0:03:57.90,*Default,NTP,0000,0000,0000,,Иә, ол көшірілді.
Dialogue: 0,0:04:01.39,0:04:04.25,*Default,NTP,0000,0000,0000,,Мен білетіндердің барлығы мектеп бітірді
Dialogue: 0,0:04:04.37,0:04:07.14,*Default,NTP,0000,0000,0000,,Менің қазіргі мектебімде мен танымайтын адамдар көп...
Dialogue: 0,0:04:07.66,0:04:10.46,*Default,NTP,0000,0000,0000,,Мен өзімді Таро Урашима сияқты сезіндім
Dialogue: 0,0:04:19.23,0:04:21.53,*Default,NTP,0000,0000,0000,,Әкем мектепте шеттетілген.
Dialogue: 0,0:04:33.82,0:04:36.44,*Default,NTP,0000,0000,0000,,Бірақ мен анаммен кездескеннен кейін
Dialogue: 0,0:04:36.79,0:04:39.80,*Default,NTP,0000,0000,0000,,Бірте-бірте көп нәрсе өзгере бастады.
Dialogue: 0,0:04:43.00,0:04:45.11,*Default,NTP,0000,0000,0000,,Анам спектакль қоймақшы болды.
Dialogue: 0,0:04:46.08,0:04:50.18,*Default,NTP,0000,0000,0000,,Бірақ алдымен мектептегі драма үйірмесін қайта жандандыруым керек болды.
Dialogue: 0,0:04:50.74,0:04:52.86,*Default,NTP,0000,0000,0000,,Әкем саған да көмектесті, солай ма?
Dialogue: 0,0:04:53.14,0:04:53.68,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:54.22,0:04:58.36,*Default,NTP,0000,0000,0000,,Анамның еңбек еткені сонша, мен оны жалғыз қалдыра алмадым.
Dialogue: 0,0:05:02.51,0:05:06.12,*Default,NTP,0000,0000,0000,,Сол кезден бастап мамам Данго отбасын жақсы көрді.
Dialogue: 0,0:05:07.08,0:05:09.21,*Default,NTP,0000,0000,0000,,Ушио мен де сені жақсы көремін, солай ма?
Dialogue: 0,0:05:09.51,0:05:10.41,*Default,NTP,0000,0000,0000,,Ұнады
Dialogue: 0,0:05:13.58,0:05:15.62,*Default,NTP,0000,0000,0000,,Анам жалғыз жаттығады.
Dialogue: 0,0:05:16.40,0:05:18.08,*Default,NTP,0000,0000,0000,,Мен көргім келген пьеса болды.
Dialogue: 0,0:05:21.97,0:05:24.52,*Default,NTP,0000,0000,0000,,Мен сені алып кетейін бе?
Dialogue: 0,0:05:26.90,0:05:30.38,*Default,NTP,0000,0000,0000,,Бұл қаладағы тілектер орындалатын орын
Dialogue: 0,0:05:33.20,0:05:35.11,*Default,NTP,0000,0000,0000,,Содан кейін достар жиыны басталды.
Dialogue: 0,0:05:35.77,0:05:38.91,*Default,NTP,0000,0000,0000,,Біріншіден, маған көмектескен адам Энн Фудзибаяши болды.
Dialogue: 0,0:05:39.39,0:05:42.22,*Default,NTP,0000,0000,0000,,Сіз білесіз бе? Мен сенің балабақшаңның тәрбиешісімін.
Dialogue: 0,0:05:45.94,0:05:48.26,*Default,NTP,0000,0000,0000,,Жоқ, мен...
Dialogue: 0,0:05:48.34,0:05:51.51,*Default,NTP,0000,0000,0000,,Өйткені, мен сенімен кездесіп жатқан жоқпын.
Dialogue: 0,0:05:52.21,0:05:53.71,*Default,NTP,0000,0000,0000,,Ал Муку бар...
Dialogue: 0,0:05:53.75,0:05:55.17,*Default,NTP,0000,0000,0000,,Күтіңіз, күтіңіз, күтіңіз
Dialogue: 0,0:05:55.27,0:05:55.99,*Default,NTP,0000,0000,0000,,Тыңдаңыз!
Dialogue: 0,0:05:56.97,0:06:02.15,*Default,NTP,0000,0000,0000,,Жарайды, ол бала, сондықтан мен оның мұндай нәрсеге неге қызығатынын түсінемін.
Dialogue: 0,0:06:02.69,0:06:05.51,*Default,NTP,0000,0000,0000,,Содан кейін оның сіңлісі Фудзибаяши Рю
Dialogue: 0,0:06:06.07,0:06:08.04,*Default,NTP,0000,0000,0000,,Ол әкемнің сыныбының президенті болды.
Dialogue: 0,0:06:08.49,0:06:10.05,*Default,NTP,0000,0000,0000,,(The Bow and Arrow енді жоқ)
Dialogue: 0,0:06:10.30,0:06:12.13,*Default,NTP,0000,0000,0000,,Мен де мұқият тыңдаймын.
Dialogue: 0,0:06:12.17,0:06:14.95,*Default,NTP,0000,0000,0000,,Ол драма үйірмесіне ұқсай бастады.
Dialogue: 0,0:06:15.06,0:06:18.62,*Default,NTP,0000,0000,0000,,Қыздар генетикалық деңгейде болжауды ұнатады.
Dialogue: 0,0:06:19.11,0:06:22.28,*Default,NTP,0000,0000,0000,,Мектептегі ең ақылды қыз да бізге қосылды.
Dialogue: 0,0:06:22.96,0:06:24.20,*Default,NTP,0000,0000,0000,,Котоми Ичиноза
Dialogue: 0,0:06:25.09,0:06:27.94,*Default,NTP,0000,0000,0000,,Негізі ол әкемнің бала кезден досы болған.
Dialogue: 0,0:06:28.87,0:06:29.89,*Default,NTP,0000,0000,0000,,Сиқырлы…
Dialogue: 0,0:06:31.05,0:06:32.65,*Default,NTP,0000,0000,0000,,Басқа да көптеген адамдар болды.
Dialogue: 0,0:06:33.42,0:06:35.64,*Default,NTP,0000,0000,0000,,Томойо Сакагами, екінші курс студенті
Dialogue: 0,0:06:37.88,0:06:39.80,*Default,NTP,0000,0000,0000,,Жол жалғасуда
Dialogue: 0,0:06:39.93,0:06:42.46,*Default,NTP,0000,0000,0000,,Қолымыздан келгеннің бәрін бірге жасайық, бұл уәде.
Dialogue: 0,0:06:45.12,0:06:46.89,*Default,NTP,0000,0000,0000,,Жатақханадағы анасы Мисае Сагара
Dialogue: 0,0:06:48.22,0:06:53.44,*Default,NTP,0000,0000,0000,,Сондай-ақ, үнемі анықтамалық бөлмеде болатын және маған кеңес беретін Юкин Миядзава.
Dialogue: 0,0:06:54.48,0:06:58.09,*Default,NTP,0000,0000,0000,,Миядзава маған осы қалада өткен аңыздарды айтып берді.
Dialogue: 0,0:06:59.19,0:07:02.56,*Default,NTP,0000,0000,0000,,Бақытты адамға нұр шары пайда болады
Dialogue: 0,0:07:03.53,0:07:07.02,*Default,NTP,0000,0000,0000,,Алсаң тілегің орындалады дейді.
Dialogue: 0,0:07:09.68,0:07:11.34,*Default,NTP,0000,0000,0000,,Юхэй ағай ше?
Dialogue: 0,0:07:11.53,0:07:13.76,*Default,NTP,0000,0000,0000,,Иә, ол сонда болды.
Dialogue: 0,0:07:14.14,0:07:17.06,*Default,NTP,0000,0000,0000,,Бұл ер адамдар ойнайтын махаббат деп аталатын ойын
Dialogue: 0,0:07:17.77,0:07:21.21,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл баланың махаббат ойыны.
Dialogue: 0,0:07:23.49,0:07:25.44,*Default,NTP,0000,0000,0000,,Оны футбол клубына қайтару
Dialogue: 0,0:07:25.83,0:07:28.39,*Default,NTP,0000,0000,0000,,Сіз сіңліңіз Мэймен қатты жұмыс істеп көрдіңіз бе?
Dialogue: 0,0:07:30.25,0:07:31.50,*Default,NTP,0000,0000,0000,,Егер ол үшін болмаса
Dialogue: 0,0:07:31.70,0:07:36.02,*Default,NTP,0000,0000,0000,,Мүмкін әкем анамды кездестірмей тұрып мектепті тастап кеткен болар.
Dialogue: 0,0:07:43.22,0:07:45.13,*Default,NTP,0000,0000,0000,,Жолдарымыз алшақ болғанымен
Dialogue: 0,0:07:45.45,0:07:47.20,*Default,NTP,0000,0000,0000,,Әлі де анда-санда бас қосып тұрамыз.
Dialogue: 0,0:07:47.83,0:07:50.54,*Default,NTP,0000,0000,0000,,Осы жаңа жылда да барлығы менің үйіме келді.
Dialogue: 0,0:07:50.77,0:07:52.19,*Default,NTP,0000,0000,0000,,Сіздің де есіңізде
Dialogue: 0,0:07:56.33,0:07:59.64,*Default,NTP,0000,0000,0000,,Драма үйірмесі жанданғанға дейін көп оқиғалар болды.
Dialogue: 0,0:08:00.19,0:08:04.31,*Default,NTP,0000,0000,0000,,Мысалы, Юсуке Йошино мен Кимиконың үйлену тойы.
Dialogue: 0,0:08:06.76,0:08:09.80,*Default,NTP,0000,0000,0000,,Кимиконың ауруханаға түскен қарындасы болды.
Dialogue: 0,0:08:10.62,0:08:12.47,*Default,NTP,0000,0000,0000,,Бұл сіздің досыңыз Фуко-чан.
Dialogue: 0,0:08:15.83,0:08:16.95,*Default,NTP,0000,0000,0000,,Клуб мүшелері ғана емес
Dialogue: 0,0:08:17.21,0:08:20.33,*Default,NTP,0000,0000,0000,,Маған да қамқор болатын мұғалімді табу керек болды.
Dialogue: 0,0:08:21.00,0:08:24.49,*Default,NTP,0000,0000,0000,,Хор клубымен Юкимура-сенсэйге қатысты дау болды.
Dialogue: 0,0:08:24.76,0:08:26.53,*Default,NTP,0000,0000,0000,,Хорды сендіру
Dialogue: 0,0:08:26.77,0:08:29.14,*Default,NTP,0000,0000,0000,,Мен бір рет баскетбол клубына қатысып көрдім.
Dialogue: 0,0:08:31.96,0:08:35.51,*Default,NTP,0000,0000,0000,,Соңында Анзу, Сунохара және т.б.
Dialogue: 0,0:08:36.39,0:08:37.84,*Default,NTP,0000,0000,0000,,Әртүрлі адамдар көмектесті
Dialogue: 0,0:08:38.29,0:08:41.55,*Default,NTP,0000,0000,0000,,Драма үйірмесі ақыры өз жұмысын қайта бастады.
Dialogue: 0,0:08:42.39,0:08:46.10,*Default,NTP,0000,0000,0000,,Бұл жолы мәселе әкемнің өзінен шықты.
Dialogue: 0,0:08:46.14,0:08:49.22,*Default,NTP,0000,0000,0000,,Әке, ұйықтағың келсе, жату керек.
Dialogue: 0,0:08:50.16,0:08:51.38,*Default,NTP,0000,0000,0000,,Сәлем әке
Dialogue: 0,0:08:54.23,0:08:59.43,*Default,NTP,0000,0000,0000,,Бұл Томояға тағы да қиындық туғыза ма?
Dialogue: 0,0:09:00.96,0:09:05.82,*Default,NTP,0000,0000,0000,,Ол кезде әкем мен әкем онша жақын емес еді.
Dialogue: 0,0:09:07.00,0:09:10.41,*Default,NTP,0000,0000,0000,,Мен үйден шығып, анамның үйінде тұрдым.
Dialogue: 0,0:09:13.08,0:09:14.98,*Default,NTP,0000,0000,0000,,Қош бол, әке
Dialogue: 0,0:09:20.26,0:09:23.07,*Default,NTP,0000,0000,0000,,Менің наным...
Dialogue: 0,0:09:23.11,0:09:24.45,*Default,NTP,0000,0000,0000,,Сәл күте тұрыңыз...
Dialogue: 0,0:09:24.55,0:09:27.76,*Default,NTP,0000,0000,0000,,Оның сатылмай қалуы заңды еді.
Dialogue: 0,0:09:26.81,0:09:29.08,*Default,NTP,0000,0000,0000,,Мына анада бала бар ма?
Dialogue: 0,0:09:29.36,0:09:31.97,*Default,NTP,0000,0000,0000,,Әкесі әдепті болар деп үміттенемін.
Dialogue: 0,0:09:32.01,0:09:32.67,*Default,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:09:33.54,0:09:34.33,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:09:35.67,0:09:38.06,*Default,NTP,0000,0000,0000,,Сіз мен айтпауым керек нәрсені айттыңыз.
Dialogue: 0,0:09:38.93,0:09:41.55,*Default,NTP,0000,0000,0000,,Санаэ-сан мен Аккиді түсіндірудің қажеті жоқ.
Dialogue: 0,0:09:42.78,0:09:46.31,*Default,NTP,0000,0000,0000,,Аккидің өтініші бойынша бәріміз бірге бейсбол ойнадық.
Dialogue: 0,0:09:47.93,0:09:53.12,*Default,NTP,0000,0000,0000,,Сана да, Акки де әкесін үйлеріне басынан қарсы алды.
Dialogue: 0,0:09:54.66,0:09:59.04,*Default,NTP,0000,0000,0000,,Әкем отбасы дегеннің не екенін түсінбеді.
Dialogue: 0,0:09:59.33,0:10:01.42,*Default,NTP,0000,0000,0000,,Басында біраз абдырап қалдым.
Dialogue: 0,0:10:02.36,0:10:06.90,*Default,NTP,0000,0000,0000,,Бірақ Санаэ-сан мен Акки мені абайсызда бақылап тұрды.
Dialogue: 0,0:10:08.98,0:10:12.67,*Default,NTP,0000,0000,0000,,Анам әлсіреп, кейде қызуы көтеріліп, төсек тартып жатты.
Dialogue: 0,0:10:13.47,0:10:18.22,*Default,NTP,0000,0000,0000,,Санаэ-сан мен Акки анасын қатты бағалайтын.
Dialogue: 0,0:10:19.12,0:10:22.84,*Default,NTP,0000,0000,0000,,Шындық қашанда қатал.
Dialogue: 0,0:10:27.23,0:10:28.82,*Default,NTP,0000,0000,0000,,Мектеп мерекесі жақындап қалды
Dialogue: 0,0:10:29.41,0:10:33.77,*Default,NTP,0000,0000,0000,,Әкелер спектакльді нақты көрсетуге қызу дайындықты бастады.
Dialogue: 0,0:10:37.72,0:10:41.23,*Default,NTP,0000,0000,0000,,Алайда соңғы сәтте күтпеген мәселе туындады.
Dialogue: 0,0:10:43.37,0:10:44.33,*Default,NTP,0000,0000,0000,,Бұл фото...
Dialogue: 0,0:10:45.63,0:10:48.24,*Default,NTP,0000,0000,0000,,Ескі альбомдар мен күнделіктер шықты...
Dialogue: 0,0:10:48.73,0:10:51.84,*Default,NTP,0000,0000,0000,,Оказаки мырза, мен білмедім.
Dialogue: 0,0:10:52.37,0:10:54.67,*Default,NTP,0000,0000,0000,,Әкем ойнайтын.
Dialogue: 0,0:10:56.69,0:10:58.73,*Default,NTP,0000,0000,0000,,Бірақ мен үшін...
Dialogue: 0,0:10:59.20,0:11:01.42,*Default,NTP,0000,0000,0000,,Екеуіміздің де өз арманымыз бар...
Dialogue: 0,0:11:12.07,0:11:13.46,*Default,NTP,0000,0000,0000,,Жоқ, шымылдықты түсірейік.
Dialogue: 0,0:11:19.35,0:11:22.94,*Default,NTP,0000,0000,0000,,Армандарың орындалсын, Нағиса!
Dialogue: 0,0:11:25.47,0:11:26.12,*Default,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:26.16,0:11:26.84,*Default,NTP,0000,0000,0000,,Бұл да тағдыр ма?
Dialogue: 0,0:11:27.07,0:11:28.05,*Default,NTP,0000,0000,0000,,Нағиса
Dialogue: 0,0:11:29.31,0:11:31.05,*Default,NTP,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:11:31.72,0:11:33.78,*Default,NTP,0000,0000,0000,,Баланың арманы – ата-ананың арманы.
Dialogue: 0,0:11:34.03,0:11:35.55,*Default,NTP,0000,0000,0000,,Тек оны жүзеге асыру керек.
Dialogue: 0,0:11:36.00,0:11:39.35,*Default,NTP,0000,0000,0000,,Біз сіздің армандарыңызды орындауыңызды армандаймыз.
Dialogue: 0,0:11:39.86,0:11:42.07,*Default,NTP,0000,0000,0000,,Біз арманымыздан бас тартқан жоқпыз.
Dialogue: 0,0:11:42.43,0:11:44.99,*Default,NTP,0000,0000,0000,,Біз өз арманымызды сіздің арманыңызға айналдырдық
Dialogue: 0,0:11:45.48,0:11:47.72,*Default,NTP,0000,0000,0000,,Ата-ана осындай.
Dialogue: 0,0:11:47.83,0:11:50.39,*Default,NTP,0000,0000,0000,,Отбасы деген осындай.
Dialogue: 0,0:11:50.86,0:11:53.14,*Default,NTP,0000,0000,0000,,Сол күннен бері...
Dialogue: 0,0:11:53.90,0:11:55.42,*Default,NTP,0000,0000,0000,,Нан пісіріп жатқанда...
Dialogue: 0,0:11:56.49,0:11:59.77,*Default,NTP,0000,0000,0000,,Біз өмірімізді осыны аңсаумен өткізіп келеміз.
Dialogue: 0,0:12:00.34,0:12:03.52,*Default,NTP,0000,0000,0000,,Егер сіз мұнда сәтсіздікке ұшырасаңыз, біз депрессияға түсеміз.
Dialogue: 0,0:12:03.58,0:12:04.77,*Default,NTP,0000,0000,0000,,Эй!
Dialogue: 0,0:12:05.02,0:12:08.22,*Default,NTP,0000,0000,0000,,Бұл үлкен жауапкершілік!
Dialogue: 0,0:12:26.66,0:12:27.48,*Default,NTP,0000,0000,0000,,Сіз...
Dialogue: 0,0:12:28.70,0:12:30.92,*Default,NTP,0000,0000,0000,,Мен сені алып кетейін бе?
Dialogue: 0,0:12:33.57,0:12:36.87,*Default,NTP,0000,0000,0000,,Осы қаладағы тілектер орындалатын орын
Dialogue: 0,0:12:37.82,0:12:39.60,*Default,NTP,0000,0000,0000,,Мені де өзіңмен бірге ала кет, Нағиса.
Dialogue: 0,0:12:40.59,0:12:41.44,*Default,NTP,0000,0000,0000,,Біз...
Dialogue: 0,0:12:46.95,0:12:48.72,*Default,NTP,0000,0000,0000,,Сахналық қойылым үлкен табысқа жетті.
Dialogue: 0,0:12:49.28,0:12:50.95,*Default,NTP,0000,0000,0000,,Әңгіме не туралы болды?
Dialogue: 0,0:12:51.44,0:12:53.97,*Default,NTP,0000,0000,0000,,Бұл біткен дүниеде өмір сүретін қыз туралы әңгіме.
Dialogue: 0,0:12:55.63,0:12:58.39,*Default,NTP,0000,0000,0000,,Мен әңгіменің атын да, авторын да білмеймін.
Dialogue: 0,0:12:58.91,0:13:00.78,*Default,NTP,0000,0000,0000,,Оқиға да, соңы да жұмбақ.
Dialogue: 0,0:13:01.88,0:13:03.50,*Default,NTP,0000,0000,0000,,Анам кішкентай кезінде
Dialogue: 0,0:13:03.50,0:13:07.04,*Default,NTP,0000,0000,0000,,Ол бұл біреу айтып берген оқиға болуы мүмкін деді.
Dialogue: 0,0:13:08.10,0:13:09.13,*Default,NTP,0000,0000,0000,,Қызығы сол,
Dialogue: 0,0:13:09.48,0:13:12.38,*Default,NTP,0000,0000,0000,,Әкем де бұл оқиғаны есіне түсіретін сияқты.
Dialogue: 0,0:13:12.97,0:13:14.52,*Default,NTP,0000,0000,0000,,Хмм.
Dialogue: 0,0:13:17.40,0:13:19.49,*Default,NTP,0000,0000,0000,,Ал ана мен әке
Dialogue: 0,0:13:20.02,0:13:25.01,*Default,NTP,0000,0000,0000,,Содан бастап біз мәңгі бірге жүруге уәде бердік.
Dialogue: 0,0:13:35.03,0:13:37.45,*Default,NTP,0000,0000,0000,,Мен оқуды бітірмес бұрын бір қорқынышты оқиға болды.
Dialogue: 0,0:13:38.47,0:13:41.90,*Default,NTP,0000,0000,0000,,Анам ауырып, оқуды бітіре алмай қалды.
Dialogue: 0,0:13:42.87,0:13:44.56,*Default,NTP,0000,0000,0000,,Әкем де шошып кетті.
Dialogue: 0,0:13:53.47,0:13:56.32,*Default,NTP,0000,0000,0000,,Жылды да қайталауым керек еді ғой.
Dialogue: 0,0:13:59.00,0:13:59.89,*Default,NTP,0000,0000,0000,,Томоя-кун
Dialogue: 0,0:14:03.23,0:14:06.00,*Default,NTP,0000,0000,0000,,Осындай нәрсеге байланысты тоқтап қалсаң жақсы емес.
Dialogue: 0,0:14:06.57,0:14:09.15,*Default,NTP,0000,0000,0000,,Егер алға жылжам десең, алға жылжу керек.
Dialogue: 0,0:14:09.87,0:14:11.77,*Default,NTP,0000,0000,0000,,Томоя, жалғастырыңыз.
Dialogue: 0,0:14:36.19,0:14:38.19,*Default,NTP,0000,0000,0000,,Оқуды бітіргеннен кейін біраз уақыттан кейін
Dialogue: 0,0:14:38.44,0:14:41.03,*Default,NTP,0000,0000,0000,,Папа Сана мен Аккиге көмектесті.
Dialogue: 0,0:14:45.25,0:14:49.00,*Default,NTP,0000,0000,0000,,Бірақ мен мұны мәңгі жасай алмайтынымды білдім.
Dialogue: 0,0:14:50.13,0:14:52.20,*Default,NTP,0000,0000,0000,,Сондықтан мен Йошино мырзадан жақсылық сұрадым.
Dialogue: 0,0:14:52.63,0:14:55.32,*Default,NTP,0000,0000,0000,,Мен электрмен жұмыс істейтін компанияда жұмыс істеуді шештім.
Dialogue: 0,0:14:57.03,0:15:00.20,*Default,NTP,0000,0000,0000,,Әрине, менде алғашында көптеген сәтсіздіктер болды.
Dialogue: 0,0:15:00.78,0:15:03.66,*Default,NTP,0000,0000,0000,,Менің бұрынғы әкем оны жек көретін шығар.
Dialogue: 0,0:15:04.66,0:15:07.34,*Default,NTP,0000,0000,0000,,Бірақ мен қалай болса да жалғастыра алдым.
Dialogue: 0,0:15:07.74,0:15:09.38,*Default,NTP,0000,0000,0000,,Анамның қолдауына рахмет
Dialogue: 0,0:15:09.77,0:15:13.75,*Default,NTP,0000,0000,0000,,Йошино мырзаға және компаниядағы адамдарға әкеме көмектескені үшін рахмет.
Dialogue: 0,0:15:16.64,0:15:19.27,*Default,NTP,0000,0000,0000,,Анам да көп жұмыс істеп, мектепке баруды жалғастырды.
Dialogue: 0,0:15:20.75,0:15:21.45,*Default,NTP,0000,0000,0000,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,0:15:24.71,0:15:29.08,*Default,NTP,0000,0000,0000,,Осы кезде әкем үлкен компанияға көшіп жатыр деген әңгіме болды.
Dialogue: 0,0:15:30.32,0:15:33.57,*Default,NTP,0000,0000,0000,,Бірақ әртүрлі себептермен нәтиже болмады.
Dialogue: 0,0:15:39.65,0:15:44.16,*Default,NTP,0000,0000,0000,,Әкемнің қолын созайын деп жатқанда қолдау көрсеткен ана болды.
Dialogue: 0,0:15:45.68,0:15:48.15,*Default,NTP,0000,0000,0000,,Сол кезде мен анама ұсыныс жасадым
Dialogue: 0,0:15:53.27,0:15:56.04,*Default,NTP,0000,0000,0000,,Бірақ біз бірден үйленбедік.
Dialogue: 0,0:15:57.13,0:16:01.61,*Default,NTP,0000,0000,0000,,Анам қайтадан ауырып, бітіру рәсіміне қатыса алмады.
Dialogue: 0,0:16:06.42,0:16:10.53,*Default,NTP,0000,0000,0000,,Бірақ бәрі жиналып, анама диплом тапсыру рәсімін өткізді.
Dialogue: 0,0:16:11.94,0:16:15.28,*Default,NTP,0000,0000,0000,,Анам мен әкем көп ұзамай үйленді.
Dialogue: 0,0:16:22.33,0:16:24.03,*Default,NTP,0000,0000,0000,,Әкелер ерлі-зайыптылар болды
Dialogue: 0,0:16:24.44,0:16:27.21,*Default,NTP,0000,0000,0000,,Содан кейін ананың құрсағында сәби дүниеге келді.
Dialogue: 0,0:16:28.41,0:16:30.42,*Default,NTP,0000,0000,0000,,Шио, бұл сен туралы.
Dialogue: 0,0:16:35.39,0:16:37.48,*Default,NTP,0000,0000,0000,,Бірақ анамның күші жетпеді.
Dialogue: 0,0:16:38.79,0:16:41.07,*Default,NTP,0000,0000,0000,,Сен дүниеге келгенше қиын болды.
Dialogue: 0,0:16:45.74,0:16:50.81,*Default,NTP,0000,0000,0000,,Дәрігер маған босану кезінде кейбір қауіптер болатынын айтты.
Dialogue: 0,0:16:51.66,0:16:53.98,*Default,NTP,0000,0000,0000,,Мен Нағисаға әлі айтқан жоқпын.
Dialogue: 0,0:16:54.20,0:16:56.68,*Default,NTP,0000,0000,0000,,Маған ғана айтты
Dialogue: 0,0:16:58.03,0:17:00.27,*Default,NTP,0000,0000,0000,,Мазасыздықтан депрессияға ұшыраған әкеме.
Dialogue: 0,0:17:00.88,0:17:03.24,*Default,NTP,0000,0000,0000,,Ақки маған өткен оқиғаны айтып берді.
Dialogue: 0,0:17:04.74,0:17:08.45,*Default,NTP,0000,0000,0000,,Ауыр дертке шалдыққан анамды жасыл орап алды...
Dialogue: 0,0:17:10.34,0:17:13.51,*Default,NTP,0000,0000,0000,,Мен білмей тұрып, анам аман қалды.
Dialogue: 0,0:17:14.85,0:17:15.95,*Default,NTP,0000,0000,0000,,Бұл оқиға.
Dialogue: 0,0:17:19.55,0:17:20.17,*Default,NTP,0000,0000,0000,,Шио?
Dialogue: 0,0:17:20.77,0:17:21.40,*Default,NTP,0000,0000,0000,,Шио?
Dialogue: 0,0:17:22.73,0:17:23.97,*Default,NTP,0000,0000,0000,,Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:17:26.90,0:17:28.81,*Default,NTP,0000,0000,0000,,Менің біртүрлі есте сақтау қабілетім бар
Dialogue: 0,0:17:29.88,0:17:31.81,*Default,NTP,0000,0000,0000,,Мен Ушиоға әлі айтқан жоқпын.
Dialogue: 0,0:17:32.28,0:17:34.53,*Default,NTP,0000,0000,0000,,Ол бір рет туылған.
Dialogue: 0,0:17:36.17,0:17:37.72,*Default,NTP,0000,0000,0000,,Сол жадта
Dialogue: 0,0:17:38.10,0:17:41.61,*Default,NTP,0000,0000,0000,,Нагиса Ушио дүниеге келгенде қайтыс болды.
Dialogue: 0,0:17:51.72,0:17:55.22,*Default,NTP,0000,0000,0000,,Мен Кога отбасынан Ушиоға қамқорлық жасауды өтіндім.
Dialogue: 0,0:17:55.63,0:17:56.99,*Default,NTP,0000,0000,0000,,Жалғыз өмір сүрді
Dialogue: 0,0:18:02.28,0:18:04.30,*Default,NTP,0000,0000,0000,,Ал Ушио бес жаста болған жаз
Dialogue: 0,0:18:08.51,0:18:11.12,*Default,NTP,0000,0000,0000,,Тура Санае жоспарлағандай саяхаттау
Dialogue: 0,0:18:11.69,0:18:13.54,*Default,NTP,0000,0000,0000,,Соңғы баратын жерде...
Dialogue: 0,0:18:21.97,0:18:25.20,*Default,NTP,0000,0000,0000,,Әже маған көп ертегі айтып берді.
Dialogue: 0,0:18:26.46,0:18:29.23,*Default,NTP,0000,0000,0000,,Мен жаңа ғана Ушиомен сөйлескен сияқтымын.
Dialogue: 0,0:18:30.97,0:18:34.39,*Default,NTP,0000,0000,0000,,Бұл мен туылғанға дейін болған оқиға.
Dialogue: 0,0:18:40.71,0:18:43.26,*Default,NTP,0000,0000,0000,,Қазір әкем анасына оралды.
Dialogue: 0,0:18:44.65,0:18:48.17,*Default,NTP,0000,0000,0000,,Бір күні Шионы қайта көрейін деп ойлаймын.
Dialogue: 0,0:18:53.49,0:18:56.09,*Default,NTP,0000,0000,0000,,Ал біз бірге тұра бастадық.
Dialogue: 0,0:18:57.77,0:19:00.20,*Default,NTP,0000,0000,0000,,Шио балабақшасының тәрбиешісі Анзу болатын.
Dialogue: 0,0:19:04.67,0:19:06.68,*Default,NTP,0000,0000,0000,,Усио да Фукомен дос болды.
Dialogue: 0,0:19:08.43,0:19:11.02,*Default,NTP,0000,0000,0000,,Барлығы бір қалыпты жүріп жатты.
Dialogue: 0,0:19:12.70,0:19:13.43,*Default,NTP,0000,0000,0000,,Жылдам, ЖоЖоны әкел!
Dialogue: 0,0:19:16.00,0:19:17.28,*Default,NTP,0000,0000,0000,,Не болды? Шио
Dialogue: 0,0:19:18.34,0:19:19.34,*Default,NTP,0000,0000,0000,,Пи
Dialogue: 0,0:19:19.66,0:19:21.44,*Default,NTP,0000,0000,0000,,Мен мұны жалғыз жасай алмадым
Dialogue: 0,0:19:21.78,0:19:22.39,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:19:26.75,0:19:27.84,*Default,NTP,0000,0000,0000,,Не болды, Ушио?
Dialogue: 0,0:19:31.87,0:19:34.22,*Default,NTP,0000,0000,0000,,Мен жаман түс көргендей болдым.
Dialogue: 0,0:19:36.74,0:19:39.01,*Default,NTP,0000,0000,0000,,Әрине Шионың жағдайы жақсы.
Dialogue: 0,0:19:39.37,0:19:41.13,*Default,NTP,0000,0000,0000,,Менде ешқашан ауыр ауру болған емес.
Dialogue: 0,0:19:43.52,0:19:46.07,*Default,NTP,0000,0000,0000,,Бірақ сол дүниенің толқыны
Dialogue: 0,0:19:46.35,0:19:49.05,*Default,NTP,0000,0000,0000,,Мен дәл осылай тұра алмадым.
Dialogue: 0,0:20:06.44,0:20:08.85,*Default,NTP,0000,0000,0000,,Содан бірдеңе болды
Dialogue: 0,0:20:18.43,0:20:21.33,*Default,NTP,0000,0000,0000,,Оянсам, дәл алдымда Нағиса тұр.
Dialogue: 0,0:20:22.53,0:20:25.62,*Default,NTP,0000,0000,0000,,Мен бес жыл бұрын Ушио дүниеге келген күнге оралдым.
Dialogue: 0,0:20:26.70,0:20:28.05,*Default,NTP,0000,0000,0000,,Бұл біртүрлі әңгіме.
Dialogue: 0,0:20:42.97,0:20:46.53,*Default,NTP,0000,0000,0000,,Бірақ бұл шынымен де болды деп ойлаймын.
Dialogue: 0,0:21:03.65,0:21:05.62,*Default,NTP,0000,0000,0000,,Нағиса екеуміз осы қалада таныстық
Dialogue: 0,0:21:06.27,0:21:08.03,*Default,NTP,0000,0000,0000,,Шио осы қалада дүниеге келген
Dialogue: 0,0:21:09.44,0:21:11.52,*Default,NTP,0000,0000,0000,,Мен бұл қалада көптеген адамдарды кездестірдім.
Dialogue: 0,0:21:11.99,0:21:14.66,*Default,NTP,0000,0000,0000,,Мен бұл қалада көп тәжірибе алдым.
Dialogue: 0,0:21:16.84,0:21:21.24,*Default,NTP,0000,0000,0000,,Біз көп адамдармен бір-бірімізге қолдау көрсетіп, өмірімізді жалғастырамыз.
Dialogue: 0,0:21:22.54,0:21:23.42,*Default,NTP,0000,0000,0000,,Осы қалада
Dialogue: 0,0:21:36.14,0:21:37.95,*Default,NTP,0000,0000,0000,,Фуко Шио
Dialogue: 0,0:21:38.39,0:21:39.44,*Default,NTP,0000,0000,0000,,Мен суық тиіп қаламын.
Dialogue: 0,0:21:39.81,0:21:41.08,*Default,NTP,0000,0000,0000,,Оянатын уақыт келді
Dialogue: 0,0:21:53.71,0:21:54.92,*Default,NTP,0000,0000,0000,,Шио-чан
Dialogue: 0,0:21:55.28,0:21:56.26,*Default,NTP,0000,0000,0000,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:21:56.56,0:21:57.79,*Default,NTP,0000,0000,0000,,Фу-чан
Dialogue: 0,0:21:58.52,0:22:00.33,*Default,NTP,0000,0000,0000,,Тезірек үйге қайтайық
Dialogue: 0,0:22:00.94,0:22:02.02,*Default,NTP,0000,0000,0000,,О, өтінемін, мені өлтірме
Dialogue: 0,0:23:40.72,0:23:46.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory