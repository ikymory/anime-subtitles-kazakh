Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.36,0:00:16.70,Default,,0,0,0,,Нагиса-сан сияқты.
Dialogue: 0,0:00:19.98,0:00:22.54,Default,,0,0,0,,Өкінішке орай, мен себебін білмеймін.
Dialogue: 0,0:00:23.24,0:00:27.35,Default,,0,0,0,,Дегенмен, Нағиса-сан сияқты мен де солай ете беретін шығармын...
Dialogue: 0,0:00:29.36,0:00:30.55,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:00:31.43,0:00:33.83,Default,,0,0,0,,Мен сондай жігерлі болсам да.
Dialogue: 0,0:00:40.08,0:00:41.90,Default,,0,0,0,,Демек, бұл менмін
Dialogue: 0,0:00:57.30,0:00:57.99,Default,,0,0,0,,Томоя
Dialogue: 0,0:01:00.02,0:01:02.14,Default,,0,0,0,,Бұл жігіттің әкесі кім?
Dialogue: 0,0:01:03.77,0:01:04.68,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:01:05.07,0:01:07.49,Default,,0,0,0,,Сонда сен мықты болуың керек.
Dialogue: 0,0:01:29.83,0:01:35.27,Default,,0,0,0,,Сен ғана өткен төбеден түсіп келе жатқанда
Dialogue: 0,0:01:35.41,0:01:40.84,Default,,0,0,0,,Көптеген жылы күн бассейндері пайда болды.
Dialogue: 0,0:01:40.97,0:01:46.12,Default,,0,0,0,,Мен ғана мейірімдімін.
Dialogue: 0,0:01:46.26,0:01:53.42,Default,,0,0,0,,Жылылықты еске түсіру
Dialogue: 0,0:01:53.88,0:02:01.72,Default,,0,0,0,,Тек сен, тек сен
Dialogue: 0,0:02:01.72,0:02:07.57,Default,,0,0,0,,Мен сені сүйдім
Dialogue: 0,0:02:07.71,0:02:15.39,Default,,0,0,0,,Жел көзімді бұлдыратады
Dialogue: 0,0:02:15.51,0:02:22.01,Default,,0,0,0,,Ол алыс болады
Dialogue: 0,0:02:22.30,0:02:24.82,Default,,0,0,0,,Мен сені мәңгі есте сақтаймын
Dialogue: 0,0:02:24.42,0:02:26.84,Default,,0,0,0,,Бәрі өзгерсе де
Dialogue: 0,0:02:26.44,0:02:28.90,Default,,0,0,0,,Тек бір ғана
Dialogue: 0,0:02:28.50,0:02:31.59,Default,,0,0,0,,Қарапайым болса да
Dialogue: 0,0:02:31.19,0:02:35.80,Default,,0,0,0,,Мен саған жарқыраған бір нәрсені көрсетемін
Dialogue: 0,0:02:35.30,0:02:40.61,Default,,0,0,0,,Мен сені мәңгілікке қорғаймын
Dialogue: 0,0:02:49.09,0:02:52.29,Default,,0,0,0,,Жақсысың ба? суық емес пе?
Dialogue: 0,0:02:53.41,0:02:56.36,Default,,0,0,0,,Қуыршақ ретінде мен суықты сезбеймін.
Dialogue: 0,0:02:57.13,0:03:00.76,Default,,0,0,0,,Бірақ оның қолдары суық болуы керек.
Dialogue: 0,0:03:02.00,0:03:04.75,Default,,0,0,0,,Мен де сезбесем де
Dialogue: 0,0:03:07.30,0:03:10.12,Default,,0,0,0,,Жақында дүние ағарады
Dialogue: 0,0:03:11.08,0:03:12.82,Default,,0,0,0,,Мен аздап асығуым керек.
Dialogue: 0,0:03:28.26,0:03:29.48,Default,,0,0,0,,Спорт күні?
Dialogue: 0,0:03:29.97,0:03:30.58,Default,,0,0,0,,О
Dialogue: 0,0:03:33.22,0:03:35.10,Default,,0,0,0,,Әке, сіз жүгірмейсіз бе?
Dialogue: 0,0:03:35.89,0:03:38.53,Default,,0,0,0,,Бүгін күні бойы сенің жаныңда боламын.
Dialogue: 0,0:03:39.16,0:03:40.33,Default,,0,0,0,,Акки ше?
Dialogue: 0,0:03:40.43,0:03:42.19,Default,,0,0,0,,Мүмкін қария жүгірер
Dialogue: 0,0:03:42.55,0:03:44.17,Default,,0,0,0,,Екі якорь демалғанда
Dialogue: 0,0:03:44.25,0:03:46.37,Default,,0,0,0,,Ауыстырушы табу қиын болады.
Dialogue: 0,0:03:50.00,0:03:52.67,Default,,0,0,0,,Папа, Аккиді ұр.
Dialogue: 0,0:03:54.27,0:03:56.11,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,0:03:56.60,0:03:58.09,Default,,0,0,0,,Біраз көңілсіз
Dialogue: 0,0:03:58.44,0:04:00.44,Default,,0,0,0,,Сіз мен жақтасыз.
Dialogue: 0,0:04:01.16,0:04:01.86,Default,,0,0,0,,Иә
Dialogue: 0,0:04:02.35,0:04:06.76,Default,,0,0,0,,Мен де сенің жаныңдамын. Мен сені қандай жағдай болса да қорғаймын.
Dialogue: 0,0:04:08.44,0:04:08.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.15,0:04:13.86,Default,,0,0,0,,Ұйқыңыз келді ме?
Dialogue: 0,0:04:13.96,0:04:14.58,Default,,0,0,0,,Иә
Dialogue: 0,0:04:15.47,0:04:18.06,Default,,0,0,0,,Уайымдама, мен ешқайда кетпеймін.
Dialogue: 0,0:04:18.36,0:04:18.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:24.37,0:04:26.33,Default,,0,0,0,,Бір апта Екі апта
Dialogue: 0,0:04:27.40,0:04:29.16,Default,,0,0,0,,Бір ай өтті
Dialogue: 0,0:04:29.54,0:04:31.24,Default,,0,0,0,,Мұхиттың қызуы басылмады.
Dialogue: 0,0:04:32.40,0:04:36.17,Default,,0,0,0,,Мен балабақшаға бара алмадым, тіпті бөлмемнен де шыға алмадым.
Dialogue: 0,0:04:37.35,0:04:38.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:40.55,0:04:44.37,Default,,0,0,0,,Өз басым Оказаки-кунның отставкаға кеткенін қаламаймын.
Dialogue: 0,0:04:44.55,0:04:47.41,Default,,0,0,0,,Әртүрлі жағдайлар бар сияқты.
Dialogue: 0,0:04:56.22,0:04:57.37,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:05:00.94,0:05:03.62,Default,,0,0,0,,Санаэ-сан мен қарт мені тоқтатты.
Dialogue: 0,0:05:04.14,0:05:06.63,Default,,0,0,0,,Бірақ мен Ушионың қасында болғым келді.
Dialogue: 0,0:05:07.36,0:05:08.65,Default,,0,0,0,,Сізде жинақ бар ма?
Dialogue: 0,0:05:08.83,0:05:12.10,Default,,0,0,0,,Мен оның оқуына ақша жинап жүрдім.
Dialogue: 0,0:05:12.48,0:05:13.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:14.65,0:05:16.02,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:17.63,0:05:19.84,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:05:26.65,0:05:28.61,Default,,0,0,0,,Ал, жоғалтпа.
Dialogue: 0,0:05:32.24,0:05:33.16,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:05:33.65,0:05:37.50,Default,,0,0,0,,Дәлелді себеп бар ма? Ертеңнен бастап жұмысыңыз қиын болады.
Dialogue: 0,0:05:37.61,0:05:38.45,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:05:40.82,0:05:43.26,Default,,0,0,0,,Оның орнына маған жүргізушіңізді беріңіз.
Dialogue: 0,0:05:43.77,0:05:45.40,Default,,0,0,0,,Қайтып келгенде қайтарамын.
Dialogue: 0,0:05:46.71,0:05:51.55,Default,,0,0,0,,Шио Чан жақсы болған кезде қайтып кел. Оған дейін қарызға аламын.
Dialogue: 0,0:06:13.59,0:06:15.66,Default,,0,0,0,,Мен оны абайлап қолданамын.
Dialogue: 0,0:06:21.36,0:06:23.07,Default,,0,0,0,,Ушио үнемі үйде болатын.
Dialogue: 0,0:06:23.88,0:06:26.75,Default,,0,0,0,,Мен ауруханаға жатқызу туралы ойладым, бірақ соңында одан бас тарттым.
Dialogue: 0,0:06:27.45,0:06:31.86,Default,,0,0,0,,Емдеуді білмейінше, ауруханада жатудың қажеті жоқ.
Dialogue: 0,0:06:32.86,0:06:36.17,Default,,0,0,0,,Бәрінен де Ушио үйде болғысы келді.
Dialogue: 0,0:06:36.81,0:06:39.16,Default,,0,0,0,,Пижамалар Мен оларды жаңасына ауыстырамын деп ойлаймын.
Dialogue: 0,0:06:39.35,0:06:39.90,Default,,0,0,0,,Иә
Dialogue: 0,0:06:42.17,0:06:46.02,Default,,0,0,0,,Сізге тұрудың қажеті жоқ. Әке саған өзгеруге көмектеседі.
Dialogue: 0,0:06:47.17,0:06:48.80,Default,,0,0,0,,Жалғыз орындауға болады
Dialogue: 0,0:07:00.80,0:07:03.71,Default,,0,0,0,,Дәл қазір жалғыз қолыңнан келмесе де, жарайды.
Dialogue: 0,0:07:04.56,0:07:05.26,Default,,0,0,0,,Иә
Dialogue: 0,0:07:06.21,0:07:08.76,Default,,0,0,0,,Ушио енді өз бетімен киім ауыстыра алмайды.
Dialogue: 0,0:07:09.44,0:07:10.73,Default,,0,0,0,,Мен әжетханаға да бара алмаймын.
Dialogue: 0,0:07:11.29,0:07:13.57,Default,,0,0,0,,Мен тек жұмсақ тамақ жей аламын.
Dialogue: 0,0:07:15.50,0:07:19.75,Default,,0,0,0,,Бейбіт күнделікті өмір ешқашан оралмайды ма?
Dialogue: 0,0:07:28.16,0:07:30.41,Default,,0,0,0,,Ушио Сіз қалаған нәрсе бар ма?
Dialogue: 0,0:07:32.39,0:07:35.22,Default,,0,0,0,,Егер сізде бірдеңе болса, маған хабарлаңыз. Ойыншық болсын, тәтті болсын.
Dialogue: 0,0:07:35.22,0:07:37.01,Default,,0,0,0,,Мен саған кез келген нәрсені сатып аламын.
Dialogue: 0,0:07:41.15,0:07:42.34,Default,,0,0,0,,Мен саяхаттағым келеді
Dialogue: 0,0:07:43.22,0:07:43.94,Default,,0,0,0,,Саяхаттау?
Dialogue: 0,0:07:44.26,0:07:46.37,Default,,0,0,0,,Мен әкеммен тағы да саяхаттағым келеді.
Dialogue: 0,0:07:47.68,0:07:50.03,Default,,0,0,0,,Бұл қызық емес еді, солай ма?
Dialogue: 0,0:07:50.31,0:07:52.88,Default,,0,0,0,,Әкемнің көңіл-күйі бұзылып, айғайлай бастады.
Dialogue: 0,0:07:54.07,0:07:57.81,Default,,0,0,0,,Көңілді болды, мен қайтадан саяхаттағым келеді
Dialogue: 0,0:07:58.73,0:08:02.00,Default,,0,0,0,,Әкеммен пойызда
Dialogue: 0,0:08:03.83,0:08:05.10,Default,,0,0,0,,Сау боласыз деп үміттенемін.
Dialogue: 0,0:08:07.40,0:08:08.77,Default,,0,0,0,,Мен мұны қазір істегім келеді
Dialogue: 0,0:08:10.64,0:08:14.43,Default,,0,0,0,,Шио, мені мәжбүрлеп әкемді ұятқа қалдырма.
Dialogue: 0,0:08:15.04,0:08:15.80,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.14,0:08:21.22,Default,,0,0,0,,Жалғыз қызы...
Dialogue: 0,0:08:21.70,0:08:24.92,Default,,0,0,0,,Менің бір тілегімді тыңдай алмайсың ба?
Dialogue: 0,0:08:26.49,0:08:27.26,Default,,0,0,0,,Нағиса
Dialogue: 0,0:08:27.98,0:08:29.20,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:29.87,0:08:32.61,Default,,0,0,0,,Сіз осындай уақытта осында болсаңыз ғой...
Dialogue: 0,0:08:37.52,0:08:38.39,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:39.03,0:08:40.35,Default,,0,0,0,,Біздің отбасымыз
Dialogue: 0,0:08:40.75,0:08:43.40,Default,,0,0,0,,Сіз бұл қаламен ойнап жүрсіз бе?
Dialogue: 0,0:08:44.22,0:08:46.19,Default,,0,0,0,,Бұзықтық бақыт сыйлау
Dialogue: 0,0:08:46.54,0:08:48.38,Default,,0,0,0,,Оны оңай алып кетуге болады
Dialogue: 0,0:08:52.00,0:08:52.71,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:08:54.21,0:08:56.06,Default,,0,0,0,,Мен Ушионы міндетті түрде құтқарамын.
Dialogue: 0,0:08:57.10,0:08:58.37,Default,,0,0,0,,Тек Ушио...
Dialogue: 0,0:09:02.13,0:09:03.48,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:04.23,0:09:05.32,Default,,0,0,0,,(Субару) Жарайды! (Жастар тобының жетекшісі) Жарайды!
Dialogue: 0,0:09:06.16,0:09:06.74,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:09:14.13,0:09:14.79,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:09:19.10,0:09:20.29,Default,,0,0,0,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:09:20.80,0:09:22.51,Default,,0,0,0,,Қыңыр болма.
Dialogue: 0,0:09:22.60,0:09:25.19,Default,,0,0,0,,Жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:09:25.35,0:09:28.40,Default,,0,0,0,,Менде әлі де жинақ бар, сондықтан мен біраз уақытқа жетемін.
Dialogue: 0,0:09:28.52,0:09:30.49,Default,,0,0,0,,Өтірік болса, мен сені жазалаймын.
Dialogue: 0,0:09:30.53,0:09:31.59,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:09:33.16,0:09:34.64,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:09:36.56,0:09:37.95,Default,,0,0,0,,Адам – жұлдыз
Dialogue: 0,0:09:37.95,0:09:40.29,Default,,0,0,0,,Қорғау керек нәрселер бар
Dialogue: 0,0:09:40.86,0:09:41.54,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:09:43.55,0:09:46.67,Default,,0,0,0,,Білемін, егер шынымен нашарлап кетсе айтамын.
Dialogue: 0,0:10:11.26,0:10:11.84,Default,,0,0,0,,Сіз темекі шегесіз бе?
Dialogue: 0,0:10:13.13,0:10:14.94,Default,,0,0,0,,Жоқ, мен кеттім.
Dialogue: 0,0:10:16.24,0:10:17.50,Default,,0,0,0,,Бұл дана.
Dialogue: 0,0:10:20.45,0:10:20.95,Default,,0,0,0,,Эй
Dialogue: 0,0:10:23.10,0:10:27.65,Default,,0,0,0,,Адамдар бұл аурухананы осы жердегі табиғат есебінен салған.
Dialogue: 0,0:10:28.00,0:10:31.30,Default,,0,0,0,,Қызық, олар енді нені құрбан етеді?
Dialogue: 0,0:10:34.02,0:10:36.87,Default,,0,0,0,,Қала сыртындағы төбе кесілді.
Dialogue: 0,0:10:37.60,0:10:40.00,Default,,0,0,0,,Шамасы, сауда үйі салынады.
Dialogue: 0,0:10:40.59,0:10:44.03,Default,,0,0,0,,Бұл тұрғындар үшін жақсы нәрсе, өйткені бұл ыңғайлы болады.
Dialogue: 0,0:10:45.92,0:10:47.03,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:10:48.24,0:10:51.96,Default,,0,0,0,,Өліп бара жатқан Нағисаны осында әкелгеннен бері.
Dialogue: 0,0:10:52.45,0:10:54.95,Default,,0,0,0,,Қызық, жағажай осы қалашықпен байланысты ма?
Dialogue: 0,0:10:55.77,0:10:58.32,Default,,0,0,0,,Ал Ушио, жағажайдың баласы...
Dialogue: 0,0:11:01.64,0:11:03.11,Default,,0,0,0,,Өзгеретін заттар
Dialogue: 0,0:11:03.42,0:11:05.38,Default,,0,0,0,,Сыртқы көріністі өзгерту
Dialogue: 0,0:11:05.94,0:11:08.46,Default,,0,0,0,,Қалаға азап болмай ма?
Dialogue: 0,0:11:12.02,0:11:14.44,Default,,0,0,0,,Оның ауырсынуға қатысы жоқ, солай ма?
Dialogue: 0,0:11:16.39,0:11:18.83,Default,,0,0,0,,«Ой, ол өзгереді.»
Dialogue: 0,0:11:19.32,0:11:21.24,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:11:22.36,0:11:26.84,Default,,0,0,0,,Өлім өзгеретін нәрселердің бірі ғана болса.
Dialogue: 0,0:11:27.77,0:11:30.63,Default,,0,0,0,,Менің ойымша, біз мұны да қабылдауымыз керек.
Dialogue: 0,0:11:31.48,0:11:35.78,Default,,0,0,0,,Адамдар мұны ұнатпайтындықтан аурухана салады.
Dialogue: 0,0:11:53.31,0:11:56.82,Default,,0,0,0,,Бұл қалаға және оның тұрғындарына сәттілік
Dialogue: 0,0:12:46.09,0:12:47.47,Default,,0,0,0,,Сіз шөлдедіңіз бе?
Dialogue: 0,0:12:48.07,0:12:49.10,Default,,0,0,0,,Су ішкіңіз келе ме?
Dialogue: 0,0:13:00.23,0:13:02.40,Default,,0,0,0,,Суық, ақырын ішіңіз.
Dialogue: 0,0:13:02.61,0:13:05.08,Default,,0,0,0,,Бірден ішсең, асқазаныңды ашады.
Dialogue: 0,0:13:13.90,0:13:14.92,Default,,0,0,0,,Дәмді
Dialogue: 0,0:13:15.52,0:13:16.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:16.65,0:13:17.45,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:22.76,0:13:24.23,Default,,0,0,0,,Саяхат Менің барғым келеді
Dialogue: 0,0:13:24.90,0:13:27.63,Default,,0,0,0,,А, мен сауығып кеткен соң.
Dialogue: 0,0:13:28.93,0:13:29.86,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,0:13:30.42,0:13:32.34,Default,,0,0,0,,Сол гүл бақшасына тағы барамыз ба?
Dialogue: 0,0:13:32.83,0:13:35.43,Default,,0,0,0,,Бірақ қазір солтүстікке барсаң салқын.
Dialogue: 0,0:13:35.77,0:13:36.69,Default,,0,0,0,,Оңтүстікке барамыз ба?
Dialogue: 0,0:13:37.34,0:13:40.95,Default,,0,0,0,,Жылы, ауасы таза жерде
Dialogue: 0,0:13:41.31,0:13:41.98,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:13:42.06,0:13:43.52,Default,,0,0,0,,Мен қазір барғым келеді
Dialogue: 0,0:13:46.85,0:13:48.20,Default,,0,0,0,,Емдеуден кейін
Dialogue: 0,0:13:48.27,0:13:49.77,Default,,0,0,0,,Сіз мұны талай рет айттыңыз.
Dialogue: 0,0:13:50.59,0:13:53.12,Default,,0,0,0,,Енді мен қазір барғым келеді
Dialogue: 0,0:13:53.24,0:13:54.65,Default,,0,0,0,,Гүл бақшасы
Dialogue: 0,0:13:55.27,0:13:56.09,Default,,0,0,0,,Шио
Dialogue: 0,0:13:57.41,0:13:59.12,Default,,0,0,0,,Қазір немесе ешқашан
Dialogue: 0,0:14:00.85,0:14:03.13,Default,,0,0,0,,Мен әкеммен барғым келеді.
Dialogue: 0,0:14:15.04,0:14:16.45,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:14:17.35,0:14:19.54,Default,,0,0,0,,Мен сенің қалағаныңды істеймін.
Dialogue: 0,0:14:20.16,0:14:20.74,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.77,0:14:25.00,Default,,0,0,0,,Бірақ ауырып қалсаңыз, шындықты айтыңыз.
Dialogue: 0,0:14:25.19,0:14:25.92,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.30,0:14:27.97,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:33.58,0:14:34.63,Default,,0,0,0,,Мен сені арқама салып алып жүремін
Dialogue: 0,0:14:35.57,0:14:36.12,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:38.01,0:14:39.42,Default,,0,0,0,,Жалғыз жүру
Dialogue: 0,0:14:39.52,0:14:40.90,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:14:43.45,0:14:45.48,Default,,0,0,0,,Мен әкеммен бірге қыдырғым келеді
Dialogue: 0,0:14:45.52,0:14:46.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:46.83,0:14:49.53,Default,,0,0,0,,Олай болса, қолымыздан келгенше бірге жүрейік.
Dialogue: 0,0:14:50.10,0:14:50.60,Default,,0,0,0,,Иә
Dialogue: 0,0:14:51.59,0:14:52.49,Default,,0,0,0,,Өте шебер екенсің ғой?
Dialogue: 0,0:14:52.98,0:14:54.90,Default,,0,0,0,,Осы жолы қызықты саяхат жасайық
Dialogue: 0,0:14:56.35,0:14:57.58,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:15:11.18,0:15:12.52,Default,,0,0,0,,Амансың ба? Шио
Dialogue: 0,0:15:12.92,0:15:13.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:14.00,0:15:17.16,Default,,0,0,0,,Егер шынымен ауырып қалсаңыз, жай ғана айтыңыз.
Dialogue: 0,0:15:17.88,0:15:19.69,Default,,0,0,0,,Мен дәрігерге барамын.
Dialogue: 0,0:15:19.99,0:15:20.50,Default,,0,0,0,,Иә
Dialogue: 0,0:15:44.33,0:15:46.37,Default,,0,0,0,,Ушио қазірдің өзінде...
Dialogue: 0,0:16:01.23,0:16:01.99,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:16:16.42,0:16:18.62,Default,,0,0,0,,Сізге қар ұнайды ма?
Dialogue: 0,0:16:19.00,0:16:19.64,Default,,0,0,0,,Иә
Dialogue: 0,0:16:20.96,0:16:22.49,Default,,0,0,0,,Сізге де әке ұнайды ма?
Dialogue: 0,0:16:23.27,0:16:24.19,Default,,0,0,0,,Әке...
Dialogue: 0,0:16:27.03,0:16:29.14,Default,,0,0,0,,О, мен де сені жақсы көремін, әке.
Dialogue: 0,0:16:31.32,0:16:32.64,Default,,0,0,0,,Сіз жүре аласыз ба? Шио
Dialogue: 0,0:16:33.03,0:16:34.23,Default,,0,0,0,,Кішкене демалайық па?
Dialogue: 0,0:16:34.67,0:16:35.45,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:36.39,0:16:38.87,Default,,0,0,0,,Жаңбыр жаумай тұрып машинаңызды алыңыз
Dialogue: 0,0:16:39.28,0:16:40.24,Default,,0,0,0,,Мен сені арқама салып алып жүремін
Dialogue: 0,0:16:41.07,0:16:41.69,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:17:33.86,0:17:34.47,Default,,0,0,0,,Шио
Dialogue: 0,0:17:49.37,0:17:50.16,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:17:50.57,0:17:52.33,Default,,0,0,0,,Шио не болды?
Dialogue: 0,0:17:53.13,0:17:54.91,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:17:55.55,0:17:57.39,Default,,0,0,0,,Сіз пойыздасыз ба?
Dialogue: 0,0:17:59.04,0:18:01.78,Default,,0,0,0,,Аа, мен пойызда отырмын.
Dialogue: 0,0:18:02.96,0:18:05.68,Default,,0,0,0,,Қараңғы түн бе?
Dialogue: 0,0:18:06.18,0:18:08.87,Default,,0,0,0,,Иә, түн ортасы.
Dialogue: 0,0:18:09.89,0:18:10.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:11.98,0:18:13.01,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:18:14.32,0:18:15.59,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:18:15.87,0:18:16.55,Default,,0,0,0,,О
Dialogue: 0,0:18:18.59,0:18:20.93,Default,,0,0,0,,Әкем де мұхитты жақсы көреді.
Dialogue: 0,0:18:33.95,0:18:34.46,Default,,0,0,0,,Ушио…
Dialogue: 0,0:18:34.96,0:18:35.81,Default,,0,0,0,,Шио?
Dialogue: 0,0:18:40.56,0:18:42.31,Default,,0,0,0,,Шио!
Dialogue: 0,0:19:00.05,0:19:00.98,Default,,0,0,0,,жақында жолымыз қиылысар.
Dialogue: 0,0:19:01.59,0:19:02.88,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:19:03.61,0:19:04.50,Default,,0,0,0,,Нағиса
Dialogue: 0,0:19:05.98,0:19:07.52,Default,,0,0,0,,Ушиоға көмектесіңізші
Dialogue: 0,0:19:10.31,0:19:11.36,Default,,0,0,0,,Нагиса!
Dialogue: 0,0:19:14.03,0:19:17.06,Default,,0,0,0,,Біреу, біреу, Шио!
Dialogue: 0,0:19:19.60,0:19:20.31,Default,,0,0,0,,Нағиса...
Dialogue: 0,0:19:55.92,0:19:57.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:11.72,0:20:14.38,Default,,0,0,0,,Оған жету үшін тағы қанша қадам қажет?
Dialogue: 0,0:20:15.28,0:20:18.20,Default,,0,0,0,,Біз бір қадам жақындадық па?
Dialogue: 0,0:20:19.22,0:20:24.57,Default,,0,0,0,,Әлде біз әлі де шексіз жүруіміз керек пе?
Dialogue: 0,0:20:53.20,0:20:54.83,Default,,0,0,0,,Мен бұл қаланы жек көремін
Dialogue: 0,0:20:58.12,0:21:00.92,Default,,0,0,0,,Өйткені бұл мен ұмытқым келетін естеліктерге толы жер.
Dialogue: 0,0:21:05.11,0:21:08.43,Default,,0,0,0,,Күнделікті мектепке барыңыз және достарыңызбен араласыңыз
Dialogue: 0,0:21:08.98,0:21:10.96,Default,,0,0,0,,Мен оралғым келмейтін үйге оралу
Dialogue: 0,0:21:12.46,0:21:16.52,Default,,0,0,0,,Осылай жүре берсек, бір күні бірдеңе өзгерер ме екен?
Dialogue: 0,0:21:18.09,0:21:20.27,Default,,0,0,0,,Зат өзгеретін күн бола ма?
Dialogue: 0,0:21:31.10,0:21:32.07,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:21:32.38,0:21:33.35,Default,,0,0,0,,Анпан
Dialogue: 0,0:21:35.36,0:21:37.69,Default,,0,0,0,,Сізге бұл мектеп ұнай ма?
Dialogue: 0,0:21:40.59,0:21:43.11,Default,,0,0,0,,Маған бұл өте ұнайды.
Dialogue: 0,0:21:43.42,0:21:44.84,Default,,0,0,0,,Бірақ ештеңе...
Dialogue: 0,0:21:44.88,0:21:47.02,Default,,0,0,0,,Мен өзгермей тұра алмаймын
Dialogue: 0,0:21:51.01,0:21:52.56,Default,,0,0,0,,Осы жерге қоңырау шалсаңыз
Dialogue: 0,0:21:52.89,0:21:55.47,Default,,0,0,0,,Нағиса екеуміз танысып, кездесе бастадық.
Dialogue: 0,0:21:56.69,0:21:57.49,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:58.09,0:22:00.34,Default,,0,0,0,,Олай етпеген дұрыс емес пе еді?
Dialogue: 0,0:22:01.29,0:22:02.94,Default,,0,0,0,,Ешқашан кездеспегеніміз жақсы...
Dialogue: 0,0:22:18.60,0:22:25.82,Default,,0,0,0,,Мен өтіп бара жатқан бұлттарға қарап тұрдым
Dialogue: 0,0:22:26.12,0:22:32.75,Default,,0,0,0,,Аспан түсінің өзгергенін сезіндім
Dialogue: 0,0:22:33.63,0:22:40.96,Default,,0,0,0,,Тоқтаған біз, түсіндік
Dialogue: 0,0:22:41.29,0:22:48.15,Default,,0,0,0,,Өзгермелі дүние иірген ән
Dialogue: 0,0:22:48.24,0:22:55.42,Default,,0,0,0,,Саусақтарын созып тартқандай
Dialogue: 0,0:22:55.63,0:23:03.88,Default,,0,0,0,,Бір өзгеріссіз қалатын затты табыңыз
Dialogue: 0,0:23:04.37,0:23:11.58,Default,,0,0,0,,Сіз ұстаған қолыңыздағы шам
Dialogue: 0,0:23:11.73,0:23:19.39,Default,,0,0,0,,Ертеңге апаратын шағын бағдаршам
Dialogue: 0,0:23:19.39,0:23:26.63,Default,,0,0,0,,Қазір де жаңғырық
Dialogue: 0,0:23:26.91,0:23:34.26,Default,,0,0,0,,Сол күнгі сөздерді ант етіп өзгертіңіз
Dialogue: 0,0:23:34.37,0:23:39.11,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:40.61,0:23:45.61,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
