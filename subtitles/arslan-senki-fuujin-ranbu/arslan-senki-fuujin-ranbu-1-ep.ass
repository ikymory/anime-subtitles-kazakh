Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.38,0:00:07.34,Default,,0,0,0,,Менің атым Хилмес
Dialogue: 0,0:00:07.46,0:00:10.05,Default,,0,0,0,,Әкесінің аты Осро
Dialogue: 0,0:00:10.26,0:00:12.84,Default,,0,0,0,,Парстың заңды патшасы –
Dialogue: 0,0:00:12.97,0:00:14.76,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:00:18.10,0:00:19.68,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:00:20.47,0:00:25.69,Default,,0,0,0,,Мен сені ақылды адам деп ойладым, Хилмес.
Dialogue: 0,0:00:26.27,0:00:30.32,Default,,0,0,0,,Менің жеке тұлғамды ашу қателік болған жоқ деп ойлаймын.
Dialogue: 0,0:00:30.44,0:00:32.19,Default,,0,0,0,,Жақсы жәндік адам
Dialogue: 0,0:00:32.82,0:00:34.70,Default,,0,0,0,,Әулие Мануэль сарайында —
Dialogue: 0,0:00:34.82,0:00:38.20,Default,,0,0,0,,Арсланмен және оның достарымен қылыш айқастырған жоқ па?
Dialogue: 0,0:00:38.99,0:00:42.41,Default,,0,0,0,,Сол кішкентай зиянкес тозақ дәмін тату үшін...
Dialogue: 0,0:00:42.83,0:00:44.83,Default,,0,0,0,,Мен сенің күшіңді алуға келдім.
Dialogue: 0,0:00:45.75,0:00:46.92,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:48.29,0:00:51.09,Default,,0,0,0,,Рукнабад қазына қылыш
Dialogue: 0,0:00:51.30,0:00:52.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:53.05,0:00:56.09,Default,,0,0,0,,Батыр патша Кай Хосроның қылышы
Dialogue: 0,0:00:56.22,0:00:58.39,Default,,0,0,0,,Ол бар ма?
Dialogue: 0,0:00:58.72,0:01:01.97,Default,,0,0,0,,Парс жерін және патша билігін қорғаңыз...
Dialogue: 0,0:01:02.22,0:01:04.18,Default,,0,0,0,,Құдайлардың сыйлықтары
Dialogue: 0,0:01:04.56,0:01:07.31,Default,,0,0,0,,Ең бастысы, патша билігінің белгісі
Dialogue: 0,0:01:07.44,0:01:08.69,Default,,0,0,0,,Қай жерде екенін айтыңызшы!
Dialogue: 0,0:01:09.44,0:01:14.44,Default,,0,0,0,,Егер сіз шынымен Кай Хосроудың ұрпағы болсаңыз...
Dialogue: 0,0:01:14.57,0:01:16.45,Default,,0,0,0,,Мен оны аламын деп ойлаймын.
Dialogue: 0,0:01:16.74,0:01:18.03,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:01:18.16,0:01:21.41,Default,,0,0,0,,Оны алып, дәлелдеп көрейік.
Dialogue: 0,0:01:25.62,0:01:30.63,Default,,0,0,0,,(Тұран сарбаздарының айқайы)
Dialogue: 0,0:01:44.85,0:01:46.43,Default,,0,0,0,,(Солдаттардың ыңылдауы)
Dialogue: 0,0:01:46.81,0:01:48.10,Default,,0,0,0,,Мықты болыңыз! (Импульсті солдат) Уф
Dialogue: 0,0:01:50.19,0:01:51.61,Default,,0,0,0,,(Тұран сарбаздарының айқайы)
Dialogue: 0,0:01:52.07,0:01:53.11,Default,,0,0,0,,Боқ (пульс солдат) Уф
Dialogue: 0,0:01:57.49,0:01:58.57,Default,,0,0,0,,Уау! (Тұран жауынгері) Уф.
Dialogue: 0,0:02:03.20,0:02:04.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:09.29,0:02:12.34,Default,,0,0,0,,Пешавар бекінісі, ол алынбайды делінді.
Dialogue: 0,0:02:12.46,0:02:13.96,Default,,0,0,0,,Бүгінге дейін.
Dialogue: 0,0:02:14.09,0:02:15.30,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:02:15.42,0:02:18.51,Default,,0,0,0,,(Ұжымдық ұрыс айқайы)
Dialogue: 0,0:02:19.34,0:02:20.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:21.05,0:02:24.01,Default,,0,0,0,,Луситаниямен шайқаста мен әлсіз екенімізді білдім.
Dialogue: 0,0:02:24.47,0:02:26.02,Default,,0,0,0,,Ей, зерделілер
Dialogue: 0,0:02:26.56,0:02:30.65,Default,,0,0,0,,Патша астанасын зұлым культ алып кетті, мен жасырынып тұрдым.
Dialogue: 0,0:02:30.77,0:02:31.69,Default,,0,0,0,,Ешқандай ескертулер жоқ
Dialogue: 0,0:02:32.02,0:02:34.77,Default,,0,0,0,,Біз Тұран оның бәрін алып кетеміз!
Dialogue: 0,0:02:34.90,0:02:36.82,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:02:38.19,0:02:39.32,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:02:47.75,0:02:49.37,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:03:07.02,0:03:08.89,Default,,0,0,0,,Яшасин!
Dialogue: 0,0:03:09.43,0:03:14.44,Default,,0,0,0,,♪～
Dialogue: 0,0:04:32.60,0:04:37.61,Default,,0,0,0,,～♪
Dialogue: 0,0:04:42.99,0:04:47.99,Default,,0,0,0,,Сен оған тек құрал ғана болдың…
Dialogue: 0,0:04:57.42,0:04:58.58,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:05:12.06,0:05:13.02,Default,,0,0,0,,Мәртебелі Арслан
Dialogue: 0,0:05:13.31,0:05:14.52,Default,,0,0,0,,Мәртебелі (пульс солдат) Мәртебелі.
Dialogue: 0,0:05:14.98,0:05:15.81,Default,,0,0,0,,Бүгінгі күнге дейін жақсы.
Dialogue: 0,0:05:15.94,0:05:17.56,Default,,0,0,0,,Қорғалған Пешавар
Dialogue: 0,0:05:17.69,0:05:18.98,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:05:19.11,0:05:20.90,Default,,0,0,0,,Сәлем! (Дарюн) Хмф!
Dialogue: 0,0:05:21.11,0:05:22.48,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:22.94,0:05:24.32,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,0:05:24.44,0:05:26.24,Default,,0,0,0,,Уа (Дарюн) Хмф!
Dialogue: 0,0:05:26.74,0:05:29.24,Default,,0,0,0,,Сәлем! Ха! (Тұран жауынгері) Уау!
Dialogue: 0,0:05:30.16,0:05:33.79,Default,,0,0,0,,Сол қара халат, Пульстің Дарюн сенсің.
Dialogue: 0,0:05:33.91,0:05:35.08,Default,,0,0,0,,Шынында да
Dialogue: 0,0:05:35.20,0:05:37.46,Default,,0,0,0,,Менің атым Ілтеріш ханзада
Dialogue: 0,0:05:37.58,0:05:40.88,Default,,0,0,0,,Бүгінге дейін менің көптеген жерлестерім сенің қолыңнан қаза тапты.
Dialogue: 0,0:05:41.00,0:05:43.76,Default,,0,0,0,,Ұмытқан күнім болған емес!
Dialogue: 0,0:05:43.88,0:05:45.80,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ...
Dialogue: 0,0:05:45.92,0:05:49.64,Default,,0,0,0,,Егер сіз өлтірілсеңіз, басқалардың алдында міндеттеме болмас еді.
Dialogue: 0,0:05:49.76,0:05:51.51,Default,,0,0,0,,Мен сені осында өлтіруге жол бере алмаймын!
Dialogue: 0,0:05:52.10,0:05:54.43,Default,,0,0,0,,Ха! Сәлем! Сәлем!
Dialogue: 0,0:06:01.81,0:06:03.82,Default,,0,0,0,,Басқа елдердің бақытсыздығын пайдаланып...
Dialogue: 0,0:06:03.94,0:06:05.86,Default,,0,0,0,,Анонимді соғысты бастау дегеніміз не?
Dialogue: 0,0:06:05.99,0:06:08.99,Default,,0,0,0,,«Шөптің чемпионы» Тұран мұны естігенде таң қалады!
Dialogue: 0,0:06:09.32,0:06:10.16,Default,,0,0,0,,Уау
Dialogue: 0,0:06:10.45,0:06:11.99,Default,,0,0,0,,Иә! (Тұран жауынгері) Гуаа!
Dialogue: 0,0:06:12.91,0:06:14.66,Default,,0,0,0,,Иә! (Тұран жауынгері) Уау!
Dialogue: 0,0:06:15.16,0:06:16.29,Default,,0,0,0,,Бастапқы қамалға оралу...
Dialogue: 0,0:06:16.41,0:06:18.12,Default,,0,0,0,,Мен артқа бұрылуыма тура келді...
Dialogue: 0,0:06:18.25,0:06:19.92,Default,,0,0,0,,Сіз не үшін жібердіңіз?
Dialogue: 0,0:06:20.21,0:06:22.09,Default,,0,0,0,,Мен маған шабуыл жасайтынын білдім...
Dialogue: 0,0:06:22.21,0:06:24.25,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын!
Dialogue: 0,0:06:24.38,0:06:27.51,Default,,0,0,0,,Мүлдем... Маған ұнамайды, Нарсус.
Dialogue: 0,0:06:27.80,0:06:30.59,Default,,0,0,0,,Әскердің орта жолда қайтарылғаны өкінішті...
Dialogue: 0,0:06:30.72,0:06:33.10,Default,,0,0,0,,Бірақ мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,0:06:33.22,0:06:35.85,Default,,0,0,0,,Луситания жалғыз жау емес.
Dialogue: 0,0:06:36.14,0:06:39.23,Default,,0,0,0,,Иә, Нарсус-саманың үкімі дұрыс болды.
Dialogue: 0,0:06:39.35,0:06:41.10,Default,,0,0,0,,Жарайсың, Нарсус...
Dialogue: 0,0:06:46.07,0:06:47.65,Default,,0,0,0,,(Тұран сарбаздарының айқайы)
Dialogue: 0,0:06:48.57,0:06:50.70,Default,,0,0,0,,Тұран жауынгерлері
Dialogue: 0,0:06:50.82,0:06:53.95,Default,,0,0,0,,Сіз сенетін күн құдайының қорғауы...
Dialogue: 0,0:06:54.08,0:06:56.49,Default,,0,0,0,,Оны енді жоқ нәрсе деп ойлаңыз!
Dialogue: 0,0:06:56.79,0:07:00.67,Default,,0,0,0,,(Солдаттардың ұрыс айқайы)
Dialogue: 0,0:07:01.17,0:07:04.13,Default,,0,0,0,,Қарғыс атқыр, бұл қысқышпен шабуыл емес пе?
Dialogue: 0,0:07:04.25,0:07:06.46,Default,,0,0,0,,Сізге кім хабарлады? (Тұран жауынгері) Уау!
Dialogue: 0,0:07:08.46,0:07:11.30,Default,,0,0,0,,Оны естімегеніме біраз болды.
Dialogue: 0,0:07:11.43,0:07:14.26,Default,,0,0,0,,Мен де бүгін өзімді ұстай алмаймын!
Dialogue: 0,0:07:14.93,0:07:16.85,Default,,0,0,0,,Ха! (Талхан) Әй, әй, ә!
Dialogue: 0,0:07:19.10,0:07:20.94,Default,,0,0,0,,Қараңдар! (Тұран жауынгері) Уау!
Dialogue: 0,0:07:21.06,0:07:23.02,Default,,0,0,0,,Иә? Пульс офицері ме?
Dialogue: 0,0:07:23.48,0:07:25.77,Default,,0,0,0,,Мен бұл басты алдым!
Dialogue: 0,0:07:28.03,0:07:29.40,Default,,0,0,0,,Иә! (Құбад) Ой...
Dialogue: 0,0:07:31.74,0:07:33.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:34.49,0:07:35.70,Default,,0,0,0,,Англсидегідей, шынында да шикі, шексіз бостандық болды.
Dialogue: 0,0:07:35.83,0:07:37.33,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:07:37.99,0:07:39.25,Default,,0,0,0,,Лорд Кубард
Dialogue: 0,0:07:39.37,0:07:40.91,Default,,0,0,0,,Ұрыс даласында көңіл көтеру, т.б.
Dialogue: 0,0:07:41.04,0:07:42.58,Default,,0,0,0,,Сіз тым абайсыз ба?
Dialogue: 0,0:07:43.00,0:07:45.46,Default,,0,0,0,,Құбад? Мен ол туралы естідім
Dialogue: 0,0:07:45.59,0:07:47.71,Default,,0,0,0,,Марзбаан: «Ура Кубард»!
Dialogue: 0,0:07:48.09,0:07:51.34,Default,,0,0,0,,Жарайды, олардың аты бірдей.
Dialogue: 0,0:07:51.47,0:07:53.97,Default,,0,0,0,,Бұл жай ғана Құбад болуы мүмкін...!
Dialogue: 0,0:07:54.09,0:07:54.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:55.51,0:07:57.64,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:07:57.97,0:08:00.68,Default,,0,0,0,,Қарғыс атсын... Ханзада, сіз қолайсыз жағдайдасыз.
Dialogue: 0,0:08:00.81,0:08:02.56,Default,,0,0,0,,Енді біз лагерьге оралып, қайта құруымыз керек.
Dialogue: 0,0:08:03.10,0:08:07.65,Default,,0,0,0,,Маған қарашы... Анау надан Пульс адамдар!
Dialogue: 0,0:08:08.07,0:08:10.40,Default,,0,0,0,,Жабу! (Тұран жауынгері) Уақытша шегініс!
Dialogue: 0,0:08:14.82,0:08:17.53,Default,,0,0,0,,Мәртебелі, мен уақытында үлгердім.
Dialogue: 0,0:08:17.66,0:08:19.87,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:08:20.95,0:08:24.54,Default,,0,0,0,,Луситания елдің бай тамырына ұмтылған жалғыз ел емес.
Dialogue: 0,0:08:25.37,0:08:28.09,Default,,0,0,0,,Солтүстіктегі көшпелі Тұран елі...
Dialogue: 0,0:08:28.21,0:08:31.17,Default,,0,0,0,,Олар Пешавар фортына басып кірді.
Dialogue: 0,0:08:31.76,0:08:34.13,Default,,0,0,0,,Пешавардан бір ай бұрын кеткен.
Dialogue: 0,0:08:34.26,0:08:36.14,Default,,0,0,0,,Ақырында, король астанасы Экбатананың жартысы...
Dialogue: 0,0:08:36.26,0:08:38.51,Default,,0,0,0,,Арслан мен оның достары...
Dialogue: 0,0:08:39.14,0:08:41.22,Default,,0,0,0,,Шегінуге мәжбүр
Dialogue: 0,0:08:42.10,0:08:46.15,Default,,0,0,0,,Импульстік күнтізбенің 321 маусымындағы уақытта
Dialogue: 0,0:08:47.10,0:08:48.77,Default,,0,0,0,,тақ мұрагері Арсланға-
Dialogue: 0,0:08:48.90,0:08:52.11,Default,,0,0,0,,Одан да үлкен сынақ болғалы тұр еді.
Dialogue: 0,0:08:55.70,0:08:59.28,Default,,0,0,0,,Жоғары мәртебелі Арслан, сізді қайта көргеніме қуаныштымын.
Dialogue: 0,0:09:00.12,0:09:03.04,Default,,0,0,0,,Біз қайтқанша бұл жерді жақсы қорғадың.
Dialogue: 0,0:09:03.79,0:09:05.62,Default,,0,0,0,,Моттайнай сөздер
Dialogue: 0,0:09:05.75,0:09:08.29,Default,,0,0,0,,Пешавар бекінісі - шекараның негізгі тасы
Dialogue: 0,0:09:08.92,0:09:10.71,Default,,0,0,0,,Егер біз мұны жоғалтсақ...
Dialogue: 0,0:09:10.84,0:09:14.55,Default,,0,0,0,,Патша астанасын қайтарып ала алсақ та, оның мәні жоқ болар еді.
Dialogue: 0,0:09:15.13,0:09:19.05,Default,,0,0,0,,Бірақ Король Раджендрадан қосымша күштер әлі келген жоқ.
Dialogue: 0,0:09:19.76,0:09:22.06,Default,,0,0,0,,Бұрын Тұранмен одақтас едік, бірақ...
Dialogue: 0,0:09:22.18,0:09:24.06,Default,,0,0,0,,Қазір жағдай басқаша.
Dialogue: 0,0:09:24.64,0:09:26.89,Default,,0,0,0,,Маған шабуыл туралы хабарланды.
Dialogue: 0,0:09:27.14,0:09:28.85,Default,,0,0,0,,Енді ханзада Арсланның қауіпсіздігі үшін.
Dialogue: 0,0:09:28.98,0:09:30.69,Default,,0,0,0,,Дұға етейік
Dialogue: 0,0:09:31.07,0:09:33.53,Default,,0,0,0,,Екі әскер бірге құлады.
Dialogue: 0,0:09:33.65,0:09:36.32,Default,,0,0,0,,Сындулла құдайларына сиынған болуы керек.
Dialogue: 0,0:09:36.74,0:09:38.95,Default,,0,0,0,,Тамақ іше алмайтын адам...
Dialogue: 0,0:09:39.28,0:09:40.62,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:09:40.74,0:09:41.95,Default,,0,0,0,,Тұран әскерінің жағдайы қалай?
Dialogue: 0,0:09:42.41,0:09:46.21,Default,,0,0,0,,Олар батысқа қарай шамамен 1 Фарсангты қайта топтастырды.
Dialogue: 0,0:09:46.79,0:09:49.00,Default,,0,0,0,,Сіз шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:09:49.13,0:09:50.79,Default,,0,0,0,,Жылқышы Тұран...
Dialogue: 0,0:09:50.92,0:09:53.09,Default,,0,0,0,,Өте батыл темпераментіне байланысты...
Dialogue: 0,0:09:53.21,0:09:55.97,Default,,0,0,0,,Оларды жеңілгенін мойындату қиын болуы керек.
Dialogue: 0,0:09:56.38,0:10:01.22,Default,,0,0,0,,А, бірақ біз тезірек астанаға баруымыз керек.
Dialogue: 0,0:10:01.72,0:10:04.22,Default,,0,0,0,,Нарсус, маған даналығыңды бер.
Dialogue: 0,0:10:11.98,0:10:13.86,Default,,0,0,0,,Сен осындасың ба, Нарсус?
Dialogue: 0,0:10:13.98,0:10:16.36,Default,,0,0,0,,Елам мені іздеді.
Dialogue: 0,0:10:17.07,0:10:21.49,Default,,0,0,0,,Раджендра жіберген әскер ақыры шекараға жеткен сияқты.
Dialogue: 0,0:10:21.62,0:10:24.04,Default,,0,0,0,,Бірақ олар күтіп, не болатынын көретін сияқты.
Dialogue: 0,0:10:24.16,0:10:27.71,Default,,0,0,0,,Раджендраға ұқсайды.
Dialogue: 0,0:10:28.91,0:10:31.71,Default,,0,0,0,,Не болды? Сіз не ойладыңыз?
Dialogue: 0,0:10:32.29,0:10:35.17,Default,,0,0,0,,Негізінде, король астанасының жағдайы мені алаңдатады.
Dialogue: 0,0:10:35.30,0:10:36.38,Default,,0,0,0,,Уг!?
Dialogue: 0,0:10:36.51,0:10:40.09,Default,,0,0,0,,Біздің әскердің шегініп кетуіне де әуре болған жоқ.
Dialogue: 0,0:10:40.22,0:10:41.39,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:10:42.14,0:10:44.93,Default,,0,0,0,,Ол шебердің жоспарынан сақ болған болуы керек.
Dialogue: 0,0:10:45.06,0:10:45.89,Default,,0,0,0,,Бұл жақсы болар еді...
Dialogue: 0,0:10:47.14,0:10:48.89,Default,,0,0,0,,Басқа себеп бар ма?
Dialogue: 0,0:10:49.73,0:10:52.19,Default,,0,0,0,,Бізге белгісіз жерде...
Dialogue: 0,0:10:52.31,0:10:55.02,Default,,0,0,0,,Біртүрлі нәрсе болуы мүмкін.
Dialogue: 0,0:10:55.36,0:10:57.23,Default,,0,0,0,,...
Dialogue: 0,0:10:57.36,0:10:59.45,Default,,0,0,0,,Оны тасымалдау қиын болуы мүмкін
Dialogue: 0,0:10:59.82,0:11:04.08,Default,,0,0,0,,Өйткені, өнер адамдары күнделікті істерге араласпауы керек.
Dialogue: 0,0:11:04.20,0:11:08.66,Default,,0,0,0,,Мен жұмысты тез аяқтап, көркем сурет әлеміне оралғым келеді.
Dialogue: 0,0:11:08.79,0:11:11.33,Default,,0,0,0,,Суреттер туралы не айта аламын?
Dialogue: 0,0:11:12.50,0:11:14.50,Default,,0,0,0,,Олар жақын арада шабуыл жасамайды...
Dialogue: 0,0:11:14.63,0:11:16.92,Default,,0,0,0,,Лорд Нарсус осылай деді.
Dialogue: 0,0:11:17.05,0:11:18.96,Default,,0,0,0,,Бүгін демалыңыз.
Dialogue: 0,0:11:19.09,0:11:21.47,Default,,0,0,0,,А, мен ұйықтай алмай тұрған сияқтымын.
Dialogue: 0,0:11:22.09,0:11:23.59,Default,,0,0,0,,Бірақ төтенше жағдайда...
Dialogue: 0,0:11:23.72,0:11:26.31,Default,,0,0,0,,Мен шыдамдылықты қалпына келтіруім керек
Dialogue: 0,0:11:26.43,0:11:28.35,Default,,0,0,0,,Пешаварға қайту туралы шешім қабылдағаннан кейін...
Dialogue: 0,0:11:28.64,0:11:31.02,Default,,0,0,0,,Сіз мүлдем ұйықтаған жоқсыз, солай ма?
Dialogue: 0,0:11:31.14,0:11:32.06,Default,,0,0,0,,Акихабарадан кет, түсіндің бе?!
Dialogue: 0,0:11:32.73,0:11:34.69,Default,,0,0,0,,Мен солай деп ойладым.
Dialogue: 0,0:11:35.31,0:11:37.07,Default,,0,0,0,,Элам күткендей.
Dialogue: 0,0:11:37.65,0:11:40.82,Default,,0,0,0,,Егер біздің қожайынның маңызды ісі болса, біз қиындыққа тап боламыз.
Dialogue: 0,0:11:41.28,0:11:42.49,Default,,0,0,0,,Мықты болыңыз.
Dialogue: 0,0:11:42.61,0:11:45.32,Default,,0,0,0,,А... Иә, кешіріңіз.
Dialogue: 0,0:11:49.20,0:11:50.75,Default,,0,0,0,,Сәлем, Элам?
Dialogue: 0,0:11:51.83,0:11:54.25,Default,,0,0,0,,Егер Гиев осындай уақытта осында болса...
Dialogue: 0,0:11:54.38,0:11:57.25,Default,,0,0,0,,Көңілді тақпақ айтып, көңіліңді аудардың ба?
Dialogue: 0,0:11:57.80,0:12:00.34,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:12:00.71,0:12:03.01,Default,,0,0,0,,Осы күндері қайда саяхаттап жүрсің деп ойлаймын.
Dialogue: 0,0:12:03.55,0:12:05.55,Default,,0,0,0,,...
Dialogue: 0,0:12:05.85,0:12:09.64,Default,,0,0,0,,Бұл біз ешқашан елестетпеген жер.
Dialogue: 0,0:12:09.77,0:12:11.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:19.44,0:12:21.90,Default,,0,0,0,,Бұл мүлдем шатастырады.
Dialogue: 0,0:12:22.03,0:12:25.32,Default,,0,0,0,,Мен оның жүзін көрмегеніме үш күн болды.
Dialogue: 0,0:12:25.45,0:12:27.07,Default,,0,0,0,,Байқаусызда бір ұсқынсыз әйелді кездестіріп қалдым...
Dialogue: 0,0:12:27.20,0:12:29.08,Default,,0,0,0,,Әдемі әйелмен елес болса ше?
Dialogue: 0,0:12:29.20,0:12:32.41,Default,,0,0,0,,Ата-бабаңды аяйсың ба?
Dialogue: 0,0:12:33.37,0:12:34.83,Default,,0,0,0,,Хатена
Dialogue: 0,0:12:34.96,0:12:39.67,Default,,0,0,0,,Ешбір жақсы адам ешқашан жын-шайтан тауына жақындамауы керек.
Dialogue: 0,0:12:40.09,0:12:45.30,Default,,0,0,0,,Жоғары мәртебелі Арслан үшін келген меннен басқа.
Dialogue: 0,0:12:52.22,0:12:56.23,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:13:03.11,0:13:04.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.32,0:13:06.11,Default,,0,0,0,,Лорд күміс маскасы табылды!
Dialogue: 0,0:13:06.24,0:13:09.83,Default,,0,0,0,,О Кай Хосроудың мазары
Dialogue: 0,0:13:09.95,0:13:12.66,Default,,0,0,0,,Импульс туралы аңыз шындық болды ма?
Dialogue: 0,0:13:28.55,0:13:30.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:30.18,0:13:33.10,Default,,0,0,0,,Біз қабір тонаушы ұры емеспіз.
Dialogue: 0,0:13:33.22,0:13:36.52,Default,,0,0,0,,Мұның бәрі Парстың дұрыс корольдік тегін қорғау үшін.
Dialogue: 0,0:13:36.64,0:13:40.56,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:13:42.82,0:13:45.40,Default,,0,0,0,,Қазыналы қылыштан басқа ештеңеге қол тигізбе
Dialogue: 0,0:13:45.53,0:13:49.16,Default,,0,0,0,,Ешқашан Батырлар Патшасына тіл тигізбе.
Dialogue: 0,0:14:25.69,0:14:27.19,Default,,0,0,0,,Менің ата-бабам
Dialogue: 0,0:14:27.70,0:14:30.95,Default,,0,0,0,,Ұлы негізін қалаушы Кай Хосроу
Dialogue: 0,0:14:31.07,0:14:36.29,Default,,0,0,0,,Ерлігіңді берші ұрпағым.
Dialogue: 0,0:14:44.50,0:14:47.92,Default,,0,0,0,,Бұл бағалы қылыш Рукнабад
Dialogue: 0,0:14:48.72,0:14:50.93,Default,,0,0,0,,Бұл кімде бар ...
Dialogue: 0,0:14:51.05,0:14:51.89,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:53.01,0:14:54.93,Default,,0,0,0,,Хмф, егер сіз бірдеңе ойласаңыз ...
Dialogue: 0,0:14:55.26,0:14:58.27,Default,,0,0,0,,Күміс маскалы залдың мақсаты қабірлерді тонау ма?
Dialogue: 0,0:14:58.39,0:15:00.60,Default,,0,0,0,,Адамдар құлағысы келмейді.
Dialogue: 0,0:15:00.94,0:15:02.27,Default,,0,0,0,,Уау (Солдат Хилмс) Уау
Dialogue: 0,0:15:02.52,0:15:05.65,Default,,0,0,0,,Хебо музыканты... мен қоңырау шалмасам, кіріп келеді...
Dialogue: 0,0:15:06.19,0:15:09.57,Default,,0,0,0,,Өзіңізді жоқтау үшін ән ойнауды жоспарлап отырсыз ба?
Dialogue: 0,0:15:12.49,0:15:15.70,Default,,0,0,0,,Мүмкін болса, кесенені ластағым келмейді, тез кет.
Dialogue: 0,0:15:15.83,0:15:17.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:20.04,0:15:23.67,Default,,0,0,0,,Оны лайықсыз адамдардың қолына тастай алмаймыз.
Dialogue: 0,0:15:24.21,0:15:27.55,Default,,0,0,0,,Хм, мен жоғары қарай ұмтылдым.
Dialogue: 0,0:15:27.67,0:15:30.80,Default,,0,0,0,,Мұның не екенін білетін сияқтысыз!
Dialogue: 0,0:15:31.93,0:15:33.80,Default,,0,0,0,,Мен де, мен әр түрлі жерлерді араладым...
Dialogue: 0,0:15:33.93,0:15:37.68,Default,,0,0,0,,Мен оның қай жерде екенін анықтаған болсам да...
Dialogue: 0,0:15:38.02,0:15:40.06,Default,,0,0,0,,Мен орынды жақсы таптым.
Dialogue: 0,0:15:40.18,0:15:42.60,Default,,0,0,0,,Күміс маскалы аға!
Dialogue: 0,0:15:42.90,0:15:45.69,Default,,0,0,0,,Бұл жерде өлу сенің тағдырың!
Dialogue: 0,0:15:45.81,0:15:46.90,Default,,0,0,0,,Бұл мәселе
Dialogue: 0,0:15:47.02,0:15:49.78,Default,,0,0,0,,Өлтірсең, өмір сүре алмайсың, солай ма?
Dialogue: 0,0:15:50.19,0:15:51.86,Default,,0,0,0,,Дүниелік сөздер!
Dialogue: 0,0:15:55.87,0:15:57.62,Default,,0,0,0,,Ха... Уау!
Dialogue: 0,0:16:07.92,0:16:08.80,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:16:09.25,0:16:11.92,Default,,0,0,0,,Мен үшін антиквариат
Dialogue: 0,0:16:12.05,0:16:16.01,Default,,0,0,0,,Бірақ мұндай нәрсе де биліктің символы болуы керек.
Dialogue: 0,0:16:16.14,0:16:18.64,Default,,0,0,0,,Егер мен тағының дәлелін алатын болсам...
Dialogue: 0,0:16:18.76,0:16:21.06,Default,,0,0,0,,Бұл Арслан мәртебелі.
Dialogue: 0,0:16:21.39,0:16:22.56,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:16:23.06,0:16:24.35,Default,,0,0,0,,Қарғыс атқыр... күте тұрыңыз!
Dialogue: 0,0:16:24.48,0:16:27.56,Default,,0,0,0,,Бұл жоғары мәртебелі Хилмске тиесілі!
Dialogue: 0,0:16:27.69,0:16:30.61,Default,,0,0,0,,Иә! (Беру) Уау~ Жоқ.
Dialogue: 0,0:16:30.73,0:16:33.15,Default,,0,0,0,,Уау... Жарайды!
Dialogue: 0,0:16:33.28,0:16:35.24,Default,,0,0,0,,Иә? Не? Мынау
Dialogue: 0,0:16:36.20,0:16:37.62,Default,,0,0,0,,Бар!
Dialogue: 0,0:16:39.95,0:16:41.37,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:16:44.00,0:16:45.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:46.63,0:16:48.09,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:16:48.88,0:16:51.01,Default,,0,0,0,,Аһ... Ах!
Dialogue: 0,0:16:51.67,0:16:54.59,Default,,0,0,0,,Қарғыс атсын... Балалар, қазыналы қылышты жинап алыңдар.
Dialogue: 0,0:16:54.72,0:16:55.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:56.47,0:16:57.30,Default,,0,0,0,,Танжиро! Сақ бол!
Dialogue: 0,0:16:58.18,0:17:00.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:03.93,0:17:05.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:05.48,0:17:06.69,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:06.81,0:17:08.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:11.44,0:17:12.74,Default,,0,0,0,,Не? Балалар сендер
Dialogue: 0,0:17:12.86,0:17:14.49,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:17:15.15,0:17:17.87,Default,,0,0,0,,Эй, олай емес сияқты.
Dialogue: 0,0:17:17.99,0:17:20.08,Default,,0,0,0,,Зандер Рукнабадтан бас тартпа!
Dialogue: 0,0:17:20.20,0:17:22.24,Default,,0,0,0,,А... сен кімсің!?
Dialogue: 0,0:17:24.46,0:17:25.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:25.96,0:17:27.25,Default,,0,0,0,,Қасиетті рыцарьлар
Dialogue: 0,0:17:29.54,0:17:32.63,Default,,0,0,0,,Бодан қосымшасы?
Dialogue: 0,0:17:34.42,0:17:38.51,Default,,0,0,0,,Құдай-ау... күрделі бірдеңе шықты.
Dialogue: 0,0:17:39.09,0:17:43.68,Default,,0,0,0,,Осы сияқты көп нәрсе бірден орын алса, бұл аздап басым.
Dialogue: 0,0:17:44.77,0:17:46.27,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:49.90,0:17:51.82,Default,,0,0,0,,Әулие Мануэль сарайының құлауы туралы хабарды алғаннан кейін...
Dialogue: 0,0:17:51.94,0:17:53.03,Default,,0,0,0,,Бірнеше күннен кейін -
Dialogue: 0,0:17:53.40,0:17:58.03,Default,,0,0,0,,Герцог Гискар алғаш рет король Андрагорға келді.
Dialogue: 0,0:17:58.36,0:18:01.91,Default,,0,0,0,,Міне, оның шынайы болмысын ашқан күміс маска.
Dialogue: 0,0:18:02.03,0:18:05.16,Default,,0,0,0,,Бұл Хильмстің шынайы ниетін анықтау болды.
Dialogue: 0,0:18:05.62,0:18:07.16,Default,,0,0,0,,Король Андрагор.
Dialogue: 0,0:18:08.04,0:18:09.96,Default,,0,0,0,,Бірінші рет кездесу
Dialogue: 0,0:18:10.08,0:18:13.67,Default,,0,0,0,,Мен герцог Гискардпын, Луситания патшасының ағасымын.
Dialogue: 0,0:18:14.92,0:18:16.05,Default,,0,0,0,,Ван аға?
Dialogue: 0,0:18:16.88,0:18:20.80,Default,,0,0,0,,Луситания корольдік отбасының менімен қандай ісі бар?
Dialogue: 0,0:18:22.14,0:18:25.43,Default,,0,0,0,,Мен сенен жиен туралы бірдеңе сұрайын деп едім.
Dialogue: 0,0:18:25.56,0:18:28.31,Default,,0,0,0,,Марқұм Осрос ағаңның жетім баласы.
Dialogue: 0,0:18:28.81,0:18:31.15,Default,,0,0,0,,Оның аты Хилмес болатын.
Dialogue: 0,0:18:32.06,0:18:34.23,Default,,0,0,0,,Хилмс қайтыс болды
Dialogue: 0,0:18:34.36,0:18:37.15,Default,,0,0,0,,Хохо Қызық нәрсе айтыңыз
Dialogue: 0,0:18:37.28,0:18:39.36,Default,,0,0,0,,Атропатена шайқасында...
Dialogue: 0,0:18:39.49,0:18:42.70,Default,,0,0,0,,Жіпті тартып тұрған күміс маска кім?
Dialogue: 0,0:18:43.24,0:18:47.29,Default,,0,0,0,,Біртүрлі күміс маска киген адам өзін таныстырғанда...
Dialogue: 0,0:18:47.41,0:18:52.75,Default,,0,0,0,,Оның шынайылығын тексеруді білесіз бе?
Dialogue: 0,0:18:52.88,0:18:58.09,Default,,0,0,0,,Міне, сол адамның шын мәнінде не айтқысы келгенін білу үшін келдім.
Dialogue: 0,0:18:58.72,0:19:01.72,Default,,0,0,0,,Екеуіңнің араларыңда не болды?
Dialogue: 0,0:19:01.84,0:19:06.47,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:19:06.60,0:19:10.60,Default,,0,0,0,,Иә? (Андрагор III) Кукукукуку…
Dialogue: 0,0:19:11.19,0:19:12.60,Default,,0,0,0,,Хмм!
Dialogue: 0,0:19:15.15,0:19:16.98,Default,,0,0,0,,Нуо! (Жискард) Ах!
Dialogue: 0,0:19:21.36,0:19:22.20,Default,,0,0,0,,Уау
Dialogue: 0,0:19:23.07,0:19:27.20,Default,,0,0,0,,Бұл Навадай ұлтындағы құлдар ойлап тапқан темір тізбек техникасы.
Dialogue: 0,0:19:27.54,0:19:29.71,Default,,0,0,0,,О... сен құбыжықсың ба?
Dialogue: 0,0:19:29.83,0:19:32.25,Default,,0,0,0,,Осыншама күшті қайда жасырдың?
Dialogue: 0,0:19:32.62,0:19:35.84,Default,,0,0,0,,Темірдің алтынға қарағанда тоттануы
Dialogue: 0,0:19:35.96,0:19:40.01,Default,,0,0,0,,Тер мен сорпа жарты жыл бойы бір жерге сіңсе...
Dialogue: 0,0:19:40.13,0:19:43.43,Default,,0,0,0,,Ақырында жыртылу оңай болады (Джискар) Ахххххх
Dialogue: 0,0:19:44.80,0:19:46.93,Default,,0,0,0,,Рабу...
Dialogue: 0,0:19:47.76,0:19:51.98,Default,,0,0,0,,Мен сені өлтірмеймін, сен маңызды барымтасың.
Dialogue: 0,0:19:52.10,0:19:56.15,Default,,0,0,0,,Менің және патшайымның қауіпсіздігі сізге байланысты.
Dialogue: 0,0:19:56.27,0:19:59.15,Default,,0,0,0,,Қарғыс атсын... (Андрагор III) Фухахаха...
Dialogue: 0,0:19:59.28,0:20:04.16,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:20:07.28,0:20:08.58,Default,,0,0,0,,Сіз босқынсыз ба?
Dialogue: 0,0:20:08.70,0:20:11.33,Default,,0,0,0,,Біз рұқсат етілмеген адамдардың өтуіне жол бермейміз.
Dialogue: 0,0:20:11.46,0:20:12.66,Default,,0,0,0,,Хмм (күзетші) Ах.
Dialogue: 0,0:20:13.17,0:20:15.46,Default,,0,0,0,,Граф Балкасионға қызмет ететін рыцарь шәкірті.
Dialogue: 0,0:20:15.58,0:20:16.84,Default,,0,0,0,,Бұл Этуиль.
Dialogue: 0,0:20:16.96,0:20:20.30,Default,,0,0,0,,Әулие Мануэль сарайындағы шайқастан жаралыларды қорғады.
Dialogue: 0,0:20:20.42,0:20:22.01,Default,,0,0,0,,Қамалға кіруге рұқсат сұраңыз
Dialogue: 0,0:20:22.38,0:20:25.43,Default,,0,0,0,,Ал... күте тұрыңыз, мен бірден растауды аламын.
Dialogue: 0,0:20:25.55,0:20:26.51,Default,,0,0,0,,Хун
Dialogue: 0,0:20:27.93,0:20:30.89,Default,,0,0,0,,Біз де жеттік, Екбатана.
Dialogue: 0,0:20:34.27,0:20:37.23,Default,,0,0,0,,Басқаша айтқанда, олар бізді қуып жібереді.
Dialogue: 0,0:20:37.81,0:20:40.86,Default,,0,0,0,,Осы уақытқа дейін сенімен бірге жүру жауапсыздық емес пе?
Dialogue: 0,0:20:40.98,0:20:44.11,Default,,0,0,0,,Кешіріңіз... бірақ қайтудан басқа амалым жоқ.
Dialogue: 0,0:20:44.70,0:20:45.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:46.20,0:20:48.83,Default,,0,0,0,,Жаудың шабуылына ұшыраған қол астындағыларды құтқаруға бару...
Dialogue: 0,0:20:48.95,0:20:50.62,Default,,0,0,0,,Лорд ретінде бұл табиғи нәрсе.
Dialogue: 0,0:20:50.99,0:20:53.12,Default,,0,0,0,,Ах... (Этуа) Қазір барыңыз.
Dialogue: 0,0:20:53.25,0:20:55.62,Default,,0,0,0,,Этуа... Рахмет
Dialogue: 0,0:20:57.08,0:20:58.63,Default,,0,0,0,,Міндетті түрде тірі оралыңыз
Dialogue: 0,0:20:59.25,0:21:02.84,Default,,0,0,0,,Кәпірлер өлсеңдер, тозаққа түсесіңдер.
Dialogue: 0,0:21:02.97,0:21:04.13,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.18,0:21:10.14,Default,,0,0,0,,О... не болды?
Dialogue: 0,0:21:11.06,0:21:14.18,Default,,0,0,0,,Бұл патша астанасы Экбатана ма?
Dialogue: 0,0:21:15.31,0:21:18.40,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:21:34.08,0:21:35.96,Default,,0,0,0,,Сау болып көрінгеніңізге қуаныштымын.
Dialogue: 0,0:21:37.08,0:21:40.88,Default,,0,0,0,,Тахамин, менің әйелім.
Dialogue: 0,0:21:41.80,0:21:45.55,Default,,0,0,0,,Мен сені алып кеткеніме қанша жыл болды?
Dialogue: 0,0:21:45.67,0:21:50.47,Default,,0,0,0,,Осы уақыт ішінде сен мені ешқашан сүймегенсің.
Dialogue: 0,0:21:50.76,0:21:56.18,Default,,0,0,0,,Жүрегіңді жапсаң ашылатынын білмейтін әйел.
Dialogue: 0,0:21:56.60,0:22:01.48,Default,,0,0,0,,Мен баламды жақсы көрдім.
Dialogue: 0,0:22:01.98,0:22:05.74,Default,,0,0,0,,Ананың баласын жақсы көруі табиғи нәрсе.
Dialogue: 0,0:22:07.95,0:22:11.78,Default,,0,0,0,,Балам... Баламды қайтар.
Dialogue: 0,0:22:11.91,0:22:12.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:12.91,0:22:16.08,Default,,0,0,0,,Алып кеткен баламды маған қайтар!
Dialogue: 0,0:22:19.33,0:22:21.46,Default,,0,0,0,,(Азраилдың айқайы)
Dialogue: 0,0:22:22.63,0:22:25.21,Default,,0,0,0,,О, не болды? Азраил
Dialogue: 0,0:22:27.17,0:22:31.76,Default,,0,0,0,,Біз бұл жанжалды тез арада шешіп, Экбатанаға баруымыз керек.
Dialogue: 0,0:22:33.31,0:22:35.14,Default,,0,0,0,,Король астанасындағы оқиға
Dialogue: 0,0:22:36.48,0:22:41.10,Default,,0,0,0,,Халықтың басына аптап ыстықтың мезгілі келді.
Dialogue: 0,0:22:42.98,0:22:47.99,Default,,0,0,0,,♪～
Dialogue: 0,0:24:07.90,0:24:12.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:14.32,0:24:16.70,Default,,0,0,0,,Колонизаторларды ату...
Dialogue: 0,0:24:16.99,0:24:19.24,Default,,0,0,0,,Арслан Тұрандықтарға қарсы...
Dialogue: 0,0:24:19.37,0:24:21.58,Default,,0,0,0,,Мен қатты ашуландым.
Dialogue: 0,0:24:21.71,0:24:22.87,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:24:24.54,0:24:27.54,Default,,0,0,0,,Бала патша болады
Dialogue: 0,0:24:29.04,0:24:35.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory