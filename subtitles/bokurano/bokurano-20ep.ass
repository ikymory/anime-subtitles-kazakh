Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:06.42,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.54,0:01:29.75,Default,,0,0,0,,～♪
Dialogue: 0,0:01:39.05,0:01:41.35,Default,,0,0,0,,Бұл кім? Бұл жігіттер
Dialogue: 0,0:01:42.26,0:01:43.81,Default,,0,0,0,,«Сызғыш»?
Dialogue: 0,0:01:44.85,0:01:47.81,Default,,0,0,0,,Тым алыс және тым үлкен
Dialogue: 0,0:01:48.44,0:01:51.27,Default,,0,0,0,,Сіз оларды жеңе алмайсыз
Dialogue: 0,0:01:59.28,0:02:00.82,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:02:00.95,0:02:05.87,Default,,0,0,0,,үшін ақ киініп, тізіліп, бізге қарап тұрды.
Dialogue: 0,0:02:06.58,0:02:09.21,Default,,0,0,0,,Ал сен маған күлдің
Dialogue: 0,0:02:09.67,0:02:10.88,Default,,0,0,0,,Жазылмаған
Dialogue: 0,0:02:11.29,0:02:15.13,Default,,0,0,0,,Неліктен? Көргендеріңді қайта жасай алмадыңдар ма?
Dialogue: 0,0:02:16.05,0:02:20.22,Default,,0,0,0,,Сіздің ойларыңыз Зиерс шайқасын ұйымдастырады.
Dialogue: 0,0:02:20.34,0:02:22.14,Default,,0,0,0,,Сіз оған кіргеніңізге сенімдімін.
Dialogue: 0,0:02:27.10,0:02:29.69,Default,,0,0,0,,Әлемнің бір жеріндегі орталық жүйеде...
Dialogue: 0,0:02:29.81,0:02:33.52,Default,,0,0,0,,Қол жеткізу бағдарламасы Жерге салынған.
Dialogue: 0,0:02:34.65,0:02:38.61,Default,,0,0,0,,Бағдарлама шынымен сіздің чипке көшірілді.
Dialogue: 0,0:02:38.74,0:02:41.03,Default,,0,0,0,,Ол когнитивтік зертхананың осы жүйесіне көшірілді.
Dialogue: 0,0:02:41.99,0:02:45.54,Default,,0,0,0,,Мен қазір сол жұмбақ тіршілікке қол жеткізуге тырысамын.
Dialogue: 0,0:02:46.08,0:02:47.04,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:02:48.50,0:02:50.12,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:50.25,0:02:53.50,Default,,0,0,0,,Мені үнемі қабылдамады және қатаң күзетеді.
Dialogue: 0,0:02:53.63,0:02:57.84,Default,,0,0,0,,Сондықтан сіз көрген суреттер жазылмады.
Dialogue: 0,0:02:58.76,0:03:00.93,Default,,0,0,0,,Менің ойымша, бұл оларға жетпейді.
Dialogue: 0,0:03:02.05,0:03:04.93,Default,,0,0,0,,Егер мен оған қол жеткізе алсам, келісім-шартыңыздан бас тарта аламын.
Dialogue: 0,0:03:05.18,0:03:08.06,Default,,0,0,0,,Мен мұны істей аламын деп ойладым, мама...
Dialogue: 0,0:03:08.18,0:03:09.60,Default,,0,0,0,,Пәтуа жоқ
Dialogue: 0,0:03:14.65,0:03:17.28,Default,,0,0,0,,Сіз, мен сіздің келісім-шартыңыз болмағанына сенімдімін.
Dialogue: 0,0:03:17.73,0:03:20.86,Default,,0,0,0,,Ол саған білгенінің бәрін айтып береді.
Dialogue: 0,0:03:21.24,0:03:23.53,Default,,0,0,0,,Шартты бұзу мүмкін емес.
Dialogue: 0,0:03:23.66,0:03:26.70,Default,,0,0,0,,Бұл шайқастан қашып құтылу мүмкін емес.
Dialogue: 0,0:03:26.83,0:03:28.58,Default,,0,0,0,,Мұны ненің негізінде айта аласыз?
Dialogue: 0,0:03:29.83,0:03:31.25,Default,,0,0,0,,Себебі мен оны көрдім
Dialogue: 0,0:03:31.37,0:03:34.08,Default,,0,0,0,,Көптеген балалар соғысып өлді.
Dialogue: 0,0:03:35.79,0:03:37.05,Default,,0,0,0,,Сіз не істейсіз...
Dialogue: 0,0:03:37.17,0:03:39.92,Default,,0,0,0,,Оны тікелей көру жылдамырақ болар еді
Dialogue: 0,0:03:41.97,0:03:44.80,Default,,0,0,0,,А... сен қандайсың?
Dialogue: 0,0:03:45.68,0:03:49.97,Default,,0,0,0,,Уайымдамаңыз, бұл менің планетамда қалыпты жағдай.
Dialogue: 0,0:03:51.48,0:03:53.27,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:03:56.65,0:03:58.90,Default,,0,0,0,,Өйткені, бұл басынан бастап.
Dialogue: 0,0:04:04.95,0:04:06.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:06.24,0:04:08.70,Default,,0,0,0,,Мен өскен жер...
Dialogue: 0,0:04:08.83,0:04:12.66,Default,,0,0,0,,Бұл «Болашақ даму семинары» атты оқу-жаттығу жиынынан болды.
Dialogue: 0,0:04:13.25,0:04:16.04,Default,,0,0,0,,Ойын? (Инструктордың көмекшісі) Иә.
Dialogue: 0,0:04:16.17,0:04:19.96,Default,,0,0,0,,Бұл үлкен роботқа мініп, 15 жаумен күресетін ойын.
Dialogue: 0,0:04:20.26,0:04:23.72,Default,,0,0,0,,Жасайық! Бұл шынымен қызықты көрінеді
Dialogue: 0,0:04:23.84,0:04:27.64,Default,,0,0,0,,Тура 15 адам, аға мен де.
Dialogue: 0,0:04:27.97,0:04:29.81,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:04:29.93,0:04:31.85,Default,,0,0,0,,Сіз мұны істей аласыз, иә?
Dialogue: 0,0:04:32.02,0:04:34.60,Default,,0,0,0,,Мен де істеймін! Сіз жасай аласыз!
Dialogue: 0,0:04:35.02,0:04:37.61,Default,,0,0,0,,Ха... Қолымнан келмейді.
Dialogue: 0,0:04:37.73,0:04:40.53,Default,,0,0,0,,Кешіріңіз, бұл жігіт жақсы ма?
Dialogue: 0,0:04:42.24,0:04:43.24,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:43.53,0:04:46.61,Default,,0,0,0,,Соңында келісім-шартқа қол қоя алмадым.
Dialogue: 0,0:04:47.32,0:04:49.91,Default,,0,0,0,,16-шы қосымша мүше ретінде -
Dialogue: 0,0:04:50.03,0:04:52.41,Default,,0,0,0,,Мен ағамның соңынан ердім.
Dialogue: 0,0:04:53.16,0:04:57.92,Default,,0,0,0,,Содан кейін ол біздің алдымызда пайда болды
Dialogue: 0,0:05:02.46,0:05:06.68,Default,,0,0,0,,Нұсқаушы ағай бізге қалай күресуді үйретеді...
Dialogue: 0,0:05:07.30,0:05:10.43,Default,,0,0,0,,Бір жерде жоғалып кетті
Dialogue: 0,0:05:10.76,0:05:12.18,Default,,0,0,0,,Онда...
Dialogue: 0,0:05:13.22,0:05:16.89,Default,,0,0,0,,Бұл тұлып адамның өмірлік күшімен жұмыс істейді.
Dialogue: 0,0:05:17.31,0:05:19.31,Default,,0,0,0,,Ух... бұл өтірік болар еді.
Dialogue: 0,0:05:19.73,0:05:23.40,Default,,0,0,0,,Бұдан былай мәліметтерді көрсетудің қажеті жоқ.
Dialogue: 0,0:05:24.44,0:05:29.41,Default,,0,0,0,,Жеңіске жете бергенде, бірінен соң бірі өлдік.
Dialogue: 0,0:05:29.95,0:05:32.08,Default,,0,0,0,,Осы арада ағам...
Dialogue: 0,0:05:32.87,0:05:34.91,Default,,0,0,0,,Мен сені алып келдім (Қара Коэмуши) Иә?
Dialogue: 0,0:05:35.50,0:05:38.12,Default,,0,0,0,,Мен сенен мұны сұраған жоқпын.
Dialogue: 0,0:05:38.58,0:05:42.84,Default,,0,0,0,,Бірақ сіз бос емессіз, солай емес пе? Мен сізге бұл жағынан көп көмектесе аламын.
Dialogue: 0,0:05:44.09,0:05:46.30,Default,,0,0,0,,Ей, қашпа!
Dialogue: 0,0:05:46.59,0:05:49.39,Default,,0,0,0,,Таңдасаң, шайқасып өл.
Dialogue: 0,0:05:49.51,0:05:51.97,Default,,0,0,0,,Тоқта! иә?
Dialogue: 0,0:05:53.01,0:05:56.48,Default,,0,0,0,,Жетер, Йоко-чан қарап тұр.
Dialogue: 0,0:05:57.39,0:05:58.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:59.98,0:06:00.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:02.61,0:06:03.65,Default,,0,0,0,,Ай жарығы қайтадан жарқыраған сәтте дейік
Dialogue: 0,0:06:03.78,0:06:07.20,Default,,0,0,0,,Иә! Келесі кезекте осы комитеттің төрағасы болсын.
Dialogue: 0,0:06:07.57,0:06:08.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:09.11,0:06:13.87,Default,,0,0,0,,Саған мұндай әйелдердің мұрындары тамшылап өлгені ұнайды, солай емес пе? Эй?
Dialogue: 0,0:06:13.99,0:06:17.62,Default,,0,0,0,,Сіздің де мінезіңіз өте жақсы.
Dialogue: 0,0:06:17.91,0:06:22.00,Default,,0,0,0,,Бұл жаман емес хахаха...
Dialogue: 0,0:06:22.13,0:06:24.34,Default,,0,0,0,,Менің ойымша, бұл шарасыз әрекет.
Dialogue: 0,0:06:24.46,0:06:27.47,Default,,0,0,0,,Тірі қалу үшін мен өзімді қандай кейіп танытқаныма мән бермедім.
Dialogue: 0,0:06:27.97,0:06:28.84,Default,,0,0,0,,О! (тепкі дыбыс)
Dialogue: 0,0:06:30.05,0:06:32.93,Default,,0,0,0,,Осы күш-жігердің бәрі нәтиже берді ме, білмеймін.
Dialogue: 0,0:06:33.05,0:06:37.81,Default,,0,0,0,,Менің ағам соңғы шайқасқа дейін аман қалды.
Dialogue: 0,0:06:38.10,0:06:38.94,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:39.27,0:06:42.23,Default,,0,0,0,,Кенет екінің бірі...
Dialogue: 0,0:06:42.36,0:06:44.52,Default,,0,0,0,,Ұрысты біреудің қолына алуын сұраңыз
Dialogue: 0,0:06:44.69,0:06:46.36,Default,,0,0,0,,Не? (Төраға) Бересіз бе?
Dialogue: 0,0:06:46.98,0:06:48.15,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:06:48.28,0:06:52.78,Default,,0,0,0,,Басқа жерге барып, ұшқыштарды жинап, олармен келісім-шарт жаса.
Dialogue: 0,0:06:52.91,0:06:54.37,Default,,0,0,0,,Оның орнына...
Dialogue: 0,0:06:54.83,0:07:00.87,Default,,0,0,0,,Өз үлесіңізді орындағаныңыз үшін сол адамның өмірін сақтап қалыңыз.
Dialogue: 0,0:07:01.04,0:07:04.92,Default,,0,0,0,,Не? Мен бұрын-соңды мұндай ештеңе жасаған емеспін ...
Dialogue: 0,0:07:05.59,0:07:07.05,Default,,0,0,0,,Мен сізге айта алмаймын.
Dialogue: 0,0:07:07.55,0:07:12.55,Default,,0,0,0,,Бұл шайқаста аман қалудың жалғыз жолы.
Dialogue: 0,0:07:12.72,0:07:15.47,Default,,0,0,0,,Иә! иә! Сонда мен...
Dialogue: 0,0:07:15.60,0:07:17.93,Default,,0,0,0,,...Рахмет.
Dialogue: 0,0:07:18.22,0:07:20.18,Default,,0,0,0,,Иә? (Төраға) Мен... Мен?
Dialogue: 0,0:07:20.31,0:07:23.73,Default,,0,0,0,,Күте тұрыңыз... бұл аздап қатал әзіл.
Dialogue: 0,0:07:24.27,0:07:26.40,Default,,0,0,0,,Мен әзілдерді ұнатпаймын.
Dialogue: 0,0:07:27.48,0:07:28.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.24,0:07:32.32,Default,,0,0,0,,Мен мұндай боларын ойламаппын.
Dialogue: 0,0:07:34.16,0:07:35.78,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:35.91,0:07:37.49,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:07:37.62,0:07:42.00,Default,,0,0,0,,Яғни, финалдық шайқаста жеңсе.
Dialogue: 0,0:07:42.12,0:07:45.08,Default,,0,0,0,,Ақымақ болма. (Төраға) А?
Dialogue: 0,0:07:45.21,0:07:49.05,Default,,0,0,0,,Ақымақ болма! Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:07:49.76,0:07:52.26,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:07:52.38,0:07:54.09,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:54.22,0:07:56.55,Default,,0,0,0,,Ешқандай ұрыс-керіс жоқ!
Dialogue: 0,0:07:56.68,0:07:58.93,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:59.06,0:08:01.89,Default,,0,0,0,,Қиямет! Өл!
Dialogue: 0,0:08:03.23,0:08:06.56,Default,,0,0,0,,Бәрің өліңдер! (жылау)
Dialogue: 0,0:08:06.69,0:08:08.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:09.07,0:08:12.07,Default,,0,0,0,,Мен сізді жақсы түсінемін.
Dialogue: 0,0:08:12.20,0:08:17.12,Default,,0,0,0,,Егер біз шайқаста жеңіске жетсек, біз сізге назар аударамыз.
Dialogue: 0,0:08:17.53,0:08:19.29,Default,,0,0,0,,Хо... шынымен бе?
Dialogue: 0,0:08:19.41,0:08:21.62,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:08:21.75,0:08:26.58,Default,,0,0,0,,Мен... Түсіндім, сосын барымды саламын.
Dialogue: 0,0:08:27.17,0:08:30.42,Default,,0,0,0,,Және соңғы шайқас күні
Dialogue: 0,0:08:31.13,0:08:34.59,Default,,0,0,0,,Иә! Сіз жеңдіңіз! Мен жеңдім!
Dialogue: 0,0:08:34.76,0:08:36.59,Default,,0,0,0,,Мен аман қалдым!
Dialogue: 0,0:08:36.89,0:08:37.72,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:08:37.85,0:08:40.35,Default,,0,0,0,,А... Иә? (Қара Коэмуши) Не?
Dialogue: 0,0:08:40.85,0:08:42.93,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:08:43.56,0:08:44.94,Default,,0,0,0,,Бұл не нәрсе...
Dialogue: 0,0:08:45.23,0:08:48.40,Default,,0,0,0,,Өтінемін, қазірден бастап менің орнымды алыңыз.
Dialogue: 0,0:08:48.52,0:08:51.32,Default,,0,0,0,,Осыны меңзеп тұрсыз ба?
Dialogue: 0,0:08:51.44,0:08:53.03,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:08:53.15,0:08:56.86,Default,,0,0,0,,Әрине! Оны бізге сеніммен қалдырыңыз!
Dialogue: 0,0:08:56.99,0:08:59.95,Default,,0,0,0,,Мен мұны қатты соққымен жасаймын!
Dialogue: 0,0:09:00.58,0:09:04.21,Default,,0,0,0,,Осы сұмдық ойынмен қаншалықты ақымақ болу керек?
Dialogue: 0,0:09:05.25,0:09:08.71,Default,,0,0,0,,Коэмуши шынымен Йоконың ағасы болды ма?
Dialogue: 0,0:09:10.00,0:09:11.42,Default,,0,0,0,,Осыдан кейін бірден-
Dialogue: 0,0:09:12.09,0:09:14.76,Default,,0,0,0,,Ағасы мен комитет төрағасы...
Dialogue: 0,0:09:14.88,0:09:16.68,Default,,0,0,0,,Келесі Жерге бет алды
Dialogue: 0,0:09:17.34,0:09:18.76,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:22.27,0:09:25.43,Default,,0,0,0,,Йоко-чан, сенің ата-анаң жоқ, солай ма?
Dialogue: 0,0:09:26.35,0:09:28.23,Default,,0,0,0,,Маған келмейсің бе?
Dialogue: 0,0:09:29.86,0:09:31.94,Default,,0,0,0,,Ширу-кун қазірдің өзінде...
Dialogue: 0,0:09:33.44,0:09:37.57,Default,,0,0,0,,Сонда да ол менің жалғыз ағам.
Dialogue: 0,0:09:37.99,0:09:39.32,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:39.99,0:09:42.95,Default,,0,0,0,,Олай болса, қош бол.
Dialogue: 0,0:09:45.25,0:09:48.67,Default,,0,0,0,,Кешіріңіз, мен ғана оралдым.
Dialogue: 0,0:10:04.81,0:10:06.14,Default,,0,0,0,,Осыдан кейін...
Dialogue: 0,0:10:06.27,0:10:10.73,Default,,0,0,0,,Мен ағаммен бірге шайқасқа жетекшілік еттім.
Dialogue: 0,0:10:11.19,0:10:16.94,Default,,0,0,0,,Соңында, жекпе-жекті басқару үшін олардың арасынан біреуді таңдаңыз.
Dialogue: 0,0:10:17.65,0:10:21.49,Default,,0,0,0,,Тіпті келесі Жерде немесе одан кейінгі Жерде
Dialogue: 0,0:10:22.12,0:10:24.79,Default,,0,0,0,,Мен бір нәрсені қайта-қайта қайталай бердім.
Dialogue: 0,0:10:25.24,0:10:26.70,Default,,0,0,0,,Тіпті жоғалтсаңыз да-
Dialogue: 0,0:10:26.83,0:10:31.25,Default,,0,0,0,,Маған күресті жалғастыру үшін тағы бір жаңа робот берілді.
Dialogue: 0,0:10:31.79,0:10:35.21,Default,,0,0,0,,Жерде неше рет болды?
Dialogue: 0,0:10:35.88,0:10:39.30,Default,,0,0,0,,Мен бәрі білетін адаммен таныстым.
Dialogue: 0,0:10:49.35,0:10:52.06,Default,,0,0,0,,Кокопелли... (Секи) Сіз білесіз бе?
Dialogue: 0,0:10:53.52,0:10:56.69,Default,,0,0,0,,Бізді келісімге келтірген ол.
Dialogue: 0,0:10:56.94,0:10:59.49,Default,,0,0,0,,Не? Ол...
Dialogue: 0,0:11:00.91,0:11:04.08,Default,,0,0,0,,Біз оны Фуэфуки-сенсей деп атадық.
Dialogue: 0,0:11:04.78,0:11:06.70,Default,,0,0,0,,«Кокопелли» дегеніміз не?
Dialogue: 0,0:11:06.83,0:11:10.58,Default,,0,0,0,,Жерге жеміс әкелетін рух туралы.
Dialogue: 0,0:11:11.42,0:11:16.17,Default,,0,0,0,,Сіз бұл туралы сабақты елемей жатып айттыңыз ба?
Dialogue: 0,0:11:18.38,0:11:21.93,Default,,0,0,0,,Робот тренажер?
Dialogue: 0,0:11:22.26,0:11:26.60,Default,,0,0,0,,Жақсы... Жақсы Қызық көрінеді.
Dialogue: 0,0:11:26.72,0:11:29.43,Default,,0,0,0,,Мұғалім, жасай аламыз ба?
Dialogue: 0,0:11:30.23,0:11:33.69,Default,,0,0,0,,Иә? Иә, солай істейік
Dialogue: 0,0:11:34.31,0:11:37.02,Default,,0,0,0,,Сәлем бәріңе! Өтінемін, жиналыңыз!
Dialogue: 0,0:11:37.15,0:11:38.65,Default,,0,0,0,,Сол күні-
Dialogue: 0,0:11:38.78,0:11:43.95,Default,,0,0,0,,Бұл мен ауысқан студент ретінде түскен мектепте тегін зерттеу күні болды.
Dialogue: 0,0:11:44.74,0:11:47.91,Default,,0,0,0,,Орналасқан жері – қала шетіндегі ғылыми-техникалық мұражай.
Dialogue: 0,0:11:48.66,0:11:52.04,Default,,0,0,0,,Көрме бөлмесіндегі робот тренажерының алдында
Dialogue: 0,0:11:52.16,0:11:53.71,Default,,0,0,0,,Келісімшарт тақтасын орналастыру
Dialogue: 0,0:11:54.58,0:11:57.09,Default,,0,0,0,,Және әдеттегідей-
Dialogue: 0,0:11:57.21,0:12:02.01,Default,,0,0,0,,Біз ұшқышқа қол қою үшін алдыңғы Жерден аман қалған адамдармен жұмыс жасадық.
Dialogue: 0,0:12:02.68,0:12:05.59,Default,,0,0,0,,Бұл жер бетінде, менің сыныптастарым
Dialogue: 0,0:12:06.22,0:12:09.52,Default,,0,0,0,,Әдеттегіден сәл өзгеше болатын жалғыз нәрсе болды
Dialogue: 0,0:12:09.64,0:12:14.56,Default,,0,0,0,,Олардың ішінде мұғалімнің жалғыз қызы Юу болды.
Dialogue: 0,0:12:14.98,0:12:18.90,Default,,0,0,0,,Не болды? (Y/N) Маған бұл ұнамайтын сияқты.
Dialogue: 0,0:12:19.02,0:12:22.15,Default,,0,0,0,,Хахахаха... Ю қорқақ екен.
Dialogue: 0,0:12:22.28,0:12:26.45,Default,,0,0,0,,Бұл жай ғана ойын, уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:26.99,0:12:28.28,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:12:30.12,0:12:31.33,Default,,0,0,0,,Иә
Dialogue: 0,0:12:32.87,0:12:34.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:35.83,0:12:36.67,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:12:38.50,0:12:41.13,Default,,0,0,0,,Жүрегім жарылып кетердей болды.
Dialogue: 0,0:12:42.92,0:12:46.68,Default,,0,0,0,,Ю Чан менің досым болды
Dialogue: 0,0:12:48.43,0:12:51.77,Default,,0,0,0,,Көп ұзамай барлығы байқады
Dialogue: 0,0:12:52.27,0:12:55.10,Default,,0,0,0,,Үлкен мәселеге араласу
Dialogue: 0,0:13:00.73,0:13:02.19,Default,,0,0,0,,Ал мұғалім...
Dialogue: 0,0:13:03.07,0:13:05.15,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:13:05.57,0:13:09.41,Default,,0,0,0,,А, мен де келісім-шарт жасағым келеді...
Dialogue: 0,0:13:10.20,0:13:14.16,Default,,0,0,0,,Оның орнына сіз балалардың келісім-шарттарын босатасыз ба?
Dialogue: 0,0:13:14.50,0:13:20.67,Default,,0,0,0,,«Менің қызымның келісімшарты», солай ма? Қалғандары басқа адамдар.
Dialogue: 0,0:13:21.25,0:13:22.34,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:22.80,0:13:27.18,Default,,0,0,0,,Жарайды, мен сенің орнына біреуді таңдауға рұқсат етемін.
Dialogue: 0,0:13:28.22,0:13:31.22,Default,,0,0,0,,Қайсысын таңдауым керек? Эй
Dialogue: 0,0:13:33.39,0:13:37.65,Default,,0,0,0,,Соңында мұғалім Ю Чанды таңдамады.
Dialogue: 0,0:13:37.98,0:13:38.90,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:39.06,0:13:41.11,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:41.73,0:13:44.07,Default,,0,0,0,,Кез келген жерде жарақат бар ма? (Тамаша) Иә
Dialogue: 0,0:13:44.36,0:13:46.11,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:13:46.24,0:13:49.95,Default,,0,0,0,,Бұл жолы күшті көрінді, сондықтан өте жақсы болды.
Dialogue: 0,0:13:50.74,0:13:54.83,Default,,0,0,0,,Менің ең жақын досым қайтыс болды. Сен солай айтасың...
Dialogue: 0,0:13:54.95,0:14:00.63,Default,,0,0,0,,Иә... бұл өкінішті, бірақ баланың жолы болмады.
Dialogue: 0,0:14:01.21,0:14:06.13,Default,,0,0,0,,Иә, балаларының жауын алғылары келетін ата-аналар бар екеніне сенімдімін.
Dialogue: 0,0:14:06.67,0:14:10.39,Default,,0,0,0,,Неліктен келесі жерлеу рәсімінде адамдарды келісімшартқа қол қоюға шақыруға тырыспасқа?
Dialogue: 0,0:14:10.51,0:14:11.47,Default,,0,0,0,,А...
Dialogue: 0,0:14:12.35,0:14:13.35,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:14:13.47,0:14:19.06,Default,,0,0,0,,Сіз одан да көп аш болған шығарсыз. Мен Юға ұнайтын нәрсені жасадым.
Dialogue: 0,0:14:19.19,0:14:20.40,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:14:25.11,0:14:30.45,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:30.91,0:14:32.83,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:14:34.99,0:14:37.45,Default,,0,0,0,,Мұғалім жақсы жұмыс жасады деп ойлаймын.
Dialogue: 0,0:14:37.79,0:14:38.96,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «үшін Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:14:39.16,0:14:43.59,Default,,0,0,0,,Студенттерді құтқару үшін саясаткерлердің көмегін алуға тырысу
Dialogue: 0,0:14:43.84,0:14:46.51,Default,,0,0,0,,А... өтінемін!
Dialogue: 0,0:14:46.63,0:14:48.55,Default,,0,0,0,,Бірақ соңында...
Dialogue: 0,0:14:49.43,0:14:53.26,Default,,0,0,0,,Ю Чан мен мұғалімнен басқасының бәрі қайтыс болды.
Dialogue: 0,0:14:54.56,0:14:55.97,Default,,0,0,0,,Енді таңдаңыз.
Dialogue: 0,0:14:56.81,0:15:00.06,Default,,0,0,0,,Соғыс және өлу және мұрагер болу және тірі қалу
Dialogue: 0,0:15:00.19,0:15:01.73,Default,,0,0,0,,Қайсысы қайсысы?
Dialogue: 0,0:15:03.40,0:15:06.32,Default,,0,0,0,,Екеуі де маған... рұқсат етіңіз.
Dialogue: 0,0:15:06.48,0:15:08.32,Default,,0,0,0,,Әке?
Dialogue: 0,0:15:08.69,0:15:12.32,Default,,0,0,0,,Сен ақымақсың ба? Менің ойымша, бұл жақсы емес.
Dialogue: 0,0:15:12.91,0:15:16.16,Default,,0,0,0,,Өтінемін! Мен қызымның да істегенін қаламаймын!
Dialogue: 0,0:15:16.74,0:15:18.95,Default,,0,0,0,,Өзімшіл болма!
Dialogue: 0,0:15:19.08,0:15:22.50,Default,,0,0,0,,Соңғы шайқастан кейін сіз өлесіз.
Dialogue: 0,0:15:22.63,0:15:24.88,Default,,0,0,0,,Мен қалай иемденемін?
Dialogue: 0,0:15:25.00,0:15:28.17,Default,,0,0,0,,Бірінші қолға ал... Иә?
Dialogue: 0,0:15:29.09,0:15:33.80,Default,,0,0,0,,Алдымен өз қолыңызды алыңыз, содан кейін соңғы шайқаста болыңыз.
Dialogue: 0,0:15:34.09,0:15:36.76,Default,,0,0,0,,Жоқ... сен аузыңды жап!
Dialogue: 0,0:15:36.89,0:15:38.56,Default,,0,0,0,,Өтінемін, ағайын!
Dialogue: 0,0:15:39.60,0:15:40.68,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:15:43.23,0:15:44.27,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:15:45.94,0:15:47.11,Default,,0,0,0,,Тексеру...
Dialogue: 0,0:15:48.07,0:15:50.40,Default,,0,0,0,,Өйткені бұл уақыт ерекше
Dialogue: 0,0:15:50.74,0:15:55.45,Default,,0,0,0,,Міне, мен және менің ұстазым осы жерге келдік.
Dialogue: 0,0:15:55.57,0:15:58.24,Default,,0,0,0,,Ах! ше?
Dialogue: 0,0:15:58.37,0:16:00.37,Default,,0,0,0,,Оны кім қойды?
Dialogue: 0,0:16:00.83,0:16:05.04,Default,,0,0,0,,Кінәлі сезіммен адасып қалдым.
Dialogue: 0,0:16:05.79,0:16:06.63,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:16:06.88,0:16:08.05,Default,,0,0,0,,Йоко Мачи…
Dialogue: 0,0:16:08.30,0:16:12.09,Default,,0,0,0,,Мен де келісімшартқа отыруым керек деп ойлаймын.
Dialogue: 0,0:16:12.88,0:16:14.09,Default,,0,0,0,,Қарашы, Кана-чан
Dialogue: 0,0:16:14.84,0:16:17.93,Default,,0,0,0,,Сіз қандай қосымша күш қостыңыз?
Dialogue: 0,0:16:18.06,0:16:20.39,Default,,0,0,0,,Адамдар жеткіліксіз!
Dialogue: 0,0:16:20.52,0:16:22.10,Default,,0,0,0,,Уф…
Dialogue: 0,0:16:22.43,0:16:25.23,Default,,0,0,0,,Ух... Ой...
Dialogue: 0,0:16:25.35,0:16:27.23,Default,,0,0,0,,Па… Папа (Пипер) Ха…
Dialogue: 0,0:16:28.11,0:16:29.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.78,0:16:33.07,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:16:33.78,0:16:35.20,Default,,0,0,0,,Ю… Ю!
Dialogue: 0,0:16:35.74,0:16:38.37,Default,,0,0,0,,Себебі сіз бұрыштарды кесіп аласыз.
Dialogue: 0,0:16:38.78,0:16:40.74,Default,,0,0,0,,Ннн…
Dialogue: 0,0:16:40.91,0:16:42.54,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:16:42.75,0:16:45.08,Default,,0,0,0,,Ха... Онии-чан, доғар енді!
Dialogue: 0,0:16:45.75,0:16:49.75,Default,,0,0,0,,Шулы! Сізде қандай келісімшарт болды?
Dialogue: 0,0:16:50.13,0:16:53.80,Default,,0,0,0,,Мен де күресу керек шығар деп ойладым.
Dialogue: 0,0:16:54.22,0:16:59.43,Default,,0,0,0,,Келісім-шартты жазбадым, сен менімен жақсысың.
Dialogue: 0,0:17:01.22,0:17:02.43,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:17:04.44,0:17:07.77,Default,,0,0,0,,Әке! Әке! Әке!
Dialogue: 0,0:17:11.11,0:17:12.94,Default,,0,0,0,,Иә... Иә?
Dialogue: 0,0:17:13.61,0:17:15.95,Default,,0,0,0,,Уф... міне келдік.
Dialogue: 0,0:17:33.17,0:17:37.18,Default,,0,0,0,,Ха... не... не? Бұл әзіл ме?
Dialogue: 0,0:17:37.30,0:17:39.55,Default,,0,0,0,,Мен сізге қоңырау шалу үшін қиналдым.
Dialogue: 0,0:17:39.68,0:17:42.43,Default,,0,0,0,,Қызыңыздың өліміне мұқият қараңыз.
Dialogue: 0,0:17:42.81,0:17:44.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:50.65,0:17:53.15,Default,,0,0,0,,(Юдың айқайы)
Dialogue: 0,0:18:06.12,0:18:08.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:12.21,0:18:13.42,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:18:21.47,0:18:22.68,Default,,0,0,0,,Өл!
Dialogue: 0,0:18:22.85,0:18:23.85,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:18:23.97,0:18:28.02,Default,,0,0,0,,Өл! Өлме! Өлме!
Dialogue: 0,0:18:28.19,0:18:29.39,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:19:08.10,0:19:11.15,Default,,0,0,0,,Сіз (құбыршы) А...
Dialogue: 0,0:19:18.65,0:19:22.36,Default,,0,0,0,,Юудың орнына барайық (Пайпер) Иә?
Dialogue: 0,0:19:23.66,0:19:24.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:25.41,0:19:27.12,Default,,0,0,0,,бұл... жібер!
Dialogue: 0,0:19:28.66,0:19:30.04,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:19:30.71,0:19:33.75,Default,,0,0,0,,Сендер бірге барайық
Dialogue: 0,0:19:34.25,0:19:36.84,Default,,0,0,0,,Жоқ! Менің өлгім келмейді!
Dialogue: 0,0:19:36.96,0:19:38.63,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:19:39.67,0:19:43.59,Default,,0,0,0,,Хехехе... Мен өлгім келмейді.
Dialogue: 0,0:19:44.26,0:19:47.43,Default,,0,0,0,,Сіз дәрменсіз маймыл екеніңізді мойындайсыз ба?
Dialogue: 0,0:19:48.43,0:19:50.02,Default,,0,0,0,,А, мен оны мойындаймын.
Dialogue: 0,0:19:50.56,0:19:54.61,Default,,0,0,0,,Мен өлуді де таңдай алмаймын, бұл ойындағы пешка
Dialogue: 0,0:19:56.27,0:19:59.19,Default,,0,0,0,,Менің білетінім осы ғана
Dialogue: 0,0:19:59.48,0:20:00.90,Default,,0,0,0,,Сіз тым көп сөйлейсіз
Dialogue: 0,0:20:01.11,0:20:01.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:03.28,0:20:04.16,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:20:04.62,0:20:08.99,Default,,0,0,0,,Аа, маймылдардың әрекеті сондай біртүрлі.
Dialogue: 0,0:20:09.12,0:20:13.67,Default,,0,0,0,,Мен сіздің бастапқыда адам болғаныңызды білмеймін, бірақ бұл ең сорақысы.
Dialogue: 0,0:20:14.21,0:20:18.09,Default,,0,0,0,,Йошикава, сен өлсең де әдемісің.
Dialogue: 0,0:20:18.88,0:20:19.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:20.46,0:20:22.72,Default,,0,0,0,,Ах... Канджи
Dialogue: 0,0:20:24.09,0:20:25.30,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,0:20:26.60,0:20:30.31,Default,,0,0,0,,Канджи! Бұл сәл көбірек болды ...
Dialogue: 0,0:20:30.43,0:20:31.48,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,0:20:31.85,0:20:35.65,Default,,0,0,0,,Хахаха... Енді ананың қалжыңы ма?
Dialogue: 0,0:20:35.77,0:20:38.32,Default,,0,0,0,,Йошикава мен саған жақсы нәрсе айтайын.
Dialogue: 0,0:20:38.44,0:20:42.57,Default,,0,0,0,,Ол жігіт сіздің ақпаратыңызды мемлекеттік органдарға беріп жатқан.
Dialogue: 0,0:20:42.69,0:20:46.32,Default,,0,0,0,,Не? Бұл өтірік емес пе? (Йосикава) Жоқ!
Dialogue: 0,0:20:46.45,0:20:50.83,Default,,0,0,0,,Ол Комоданың әкесін қаржы әлемінің нысанаға алғанын да білді.
Dialogue: 0,0:20:50.95,0:20:53.75,Default,,0,0,0,,Бұл өтірік! Мен жаңа ғана ақпарат алдым
Dialogue: 0,0:20:54.21,0:20:55.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.88,0:21:00.96,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:21:01.42,0:21:04.01,Default,,0,0,0,,Аа… Канджи
Dialogue: 0,0:21:08.80,0:21:09.85,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:21:10.68,0:21:13.85,Default,,0,0,0,,Тойохару Хасегава мырза Біріккен Ұлттар Ұйымының Конференциясында-
Dialogue: 0,0:21:13.98,0:21:15.77,Default,,0,0,0,,Ұшқышсыз қаруға қойылған шектеулерді алып тастау
Dialogue: 0,0:21:15.89,0:21:18.77,Default,,0,0,0,,Түсіну сұрап сөз сөйледім.
Dialogue: 0,0:21:19.48,0:21:23.03,Default,,0,0,0,,Бұған жауап ретінде Қытай мен Ресей қолдау білдірді.
Dialogue: 0,0:21:23.15,0:21:25.20,Default,,0,0,0,,Америка өз көзқарасын сақтап қалды
Dialogue: 0,0:21:25.32,0:21:28.37,Default,,0,0,0,,Жапония көндіруге тырысатын сияқты
Dialogue: 0,0:21:31.41,0:21:36.42,Default,,0,0,0,,♪～
Dialogue: 0,0:22:55.74,0:22:59.96,Default,,0,0,0,,～♪
Dialogue: 0,0:23:01.88,0:23:04.59,Default,,0,0,0,,Неге екені белгісіз, Окитенрудың алдынан жау шықты.
Dialogue: 0,0:23:06.09,0:23:09.01,Default,,0,0,0,,Анаңыз қайта жасаған Жер бағдарламасының сыры неде?
Dialogue: 0,0:23:09.67,0:23:12.43,Default,,0,0,0,,Келесі жолы «Біздің» «Ақиқат»
Dialogue: 0,0:23:13.14,0:23:15.89,Default,,0,0,0,,Біз енді алданбаймыз
Dialogue: 0,0:23:17.39,0:23:23.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
