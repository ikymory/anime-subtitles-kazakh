Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.02,0:00:26.52,Default,,0,0,0,,«Ескерту»
Dialogue: 0,0:00:26.65,0:00:31.11,Default,,0,0,0,,«Бүгін түнгі сағат 12-де осы мұражайдағы ең қымбат қазына...»
Dialogue: 0,0:00:31.23,0:00:32.90,Default,,0,0,0,,«Мен келіп аламын».
Dialogue: 0,0:00:33.49,0:00:35.70,Default,,0,0,0,,«Елес ұры Арсен Люпин»
Dialogue: 0,0:00:37.95,0:00:40.12,Default,,0,0,0,,Хмм... Люпин.
Dialogue: 0,0:00:40.54,0:00:42.83,Default,,0,0,0,,Ең қымбат қазына?
Dialogue: 0,0:00:42.95,0:00:46.33,Default,,0,0,0,,Бұл елес қазына «Богемияның билейтін иті» ме?
Dialogue: 0,0:00:46.46,0:00:51.88,Default,,0,0,0,,Әлде үшінші көрме бөлмесіндегі «Шайтанның аяқ қысымы массажы» шедеврі ме?
Dialogue: 0,0:00:52.01,0:00:53.97,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:00:55.34,0:00:57.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:57.64,0:00:59.60,Default,,0,0,0,,Уау! (Еркек) Жоқ!
Dialogue: 0,0:00:59.72,0:01:02.43,Default,,0,0,0,,Ол үшінші көрме бөлмесінде! Асығыңыз!
Dialogue: 0,0:01:02.93,0:01:05.52,Default,,0,0,0,,Маған қашып кетуге жол берме! Бар!
Dialogue: 0,0:01:09.44,0:01:11.61,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:01:12.53,0:01:16.32,Default,,0,0,0,,Хехехе... хехехе
Dialogue: 0,0:01:16.45,0:01:18.11,Default,,0,0,0,,Міне! Ол кім?
Dialogue: 0,0:01:18.24,0:01:20.16,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:01:20.95,0:01:24.12,Default,,0,0,0,,Ұлы детектив Шерлок Нобита!
Dialogue: 0,0:01:24.33,0:01:26.46,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:01:26.58,0:01:27.87,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:01:28.42,0:01:29.71,Default,,0,0,0,,Иә? Ой...
Dialogue: 0,0:01:29.83,0:01:32.17,Default,,0,0,0,,Ааа... аааа!
Dialogue: 0,0:01:33.46,0:01:37.18,Default,,0,0,0,,Күте тұрыңыз... Лу... Люпин... Люпин!
Dialogue: 0,0:01:37.26,0:01:41.14,Default,,0,0,0,,Күте тұрыңыз! Люпин! Ха ха ха!
Dialogue: 0,0:01:41.22,0:01:45.02,Default,,0,0,0,,Нобита, сен Холмс болғың келе ме?
Dialogue: 0,0:01:45.14,0:01:48.73,Default,,0,0,0,,А, кешегі фильм? Бұл қызық болды, солай емес пе?
Dialogue: 0,0:01:48.85,0:01:50.11,Default,,0,0,0,,Көрдім.
Dialogue: 0,0:01:50.23,0:01:52.86,Default,,0,0,0,,«Люпин Холмсқа қарсы Ошиши Камен», солай ма?
Dialogue: 0,0:01:52.98,0:01:55.19,Default,,0,0,0,,Керемет болды, Холмс.
Dialogue: 0,0:01:55.19,0:01:55.74,Default,,0,0,0,,Керемет болды, Холмс.
Dialogue: 0,0:01:55.19,0:01:55.74,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:01:55.74,0:01:55.86,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:01:55.86,0:01:56.74,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:01:55.86,0:01:56.74,Default,,0,0,0,,Мен де сондай болсам ғой
Dialogue: 0,0:01:56.74,0:01:57.57,Default,,0,0,0,,Мен де сондай болсам ғой
Dialogue: 0,0:01:57.70,0:02:02.83,Default,,0,0,0,,Иа, мүмкін емес, мүмкін емес, мұндай данышпандық шегерімдерді жасауға мүмкіндік жоқ.
Dialogue: 0,0:02:02.91,0:02:07.21,Default,,0,0,0,,Сол ақымақ детективтің рөлі Нобита үшін өте жақсы.
Dialogue: 0,0:02:07.33,0:02:10.04,Default,,0,0,0,,«Күдікті...» Не? (күлкі)
Dialogue: 0,0:02:10.13,0:02:11.96,Default,,0,0,0,,Уау, сіз сызықтан шығып кеттіңіз!
Dialogue: 0,0:02:12.09,0:02:14.50,Default,,0,0,0,,Кууууууууууууууууу...
Dialogue: 0,0:02:12.09,0:02:14.50,Default,,0,0,0,,Холмс мүмкін емес, мүмкін емес.
Dialogue: 0,0:02:17.13,0:02:20.68,Default,,0,0,0,,Дораякиді көп жегенім сонша, ұйқым келді.
Dialogue: 0,0:02:20.80,0:02:22.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:24.26,0:02:26.18,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:02:26.27,0:02:30.15,Default,,0,0,0,,Дораэмон Дораэмон Дораэмон Дораэмон!
Dialogue: 0,0:02:37.49,0:02:38.65,Default,,0,0,0,,Дораемон...
Dialogue: 0,0:02:39.03,0:02:42.62,Default,,0,0,0,,Иә? Не, сен сонда емессің бе?
Dialogue: 0,0:02:44.66,0:02:48.33,Default,,0,0,0,,Уау! Нашар 0 ұпай тесті
Dialogue: 0,0:02:48.45,0:02:51.54,Default,,0,0,0,,Хмм... не? Бұл
Dialogue: 0,0:02:52.25,0:02:54.17,Default,,0,0,0,,Ｄ？ Ｘ？
Dialogue: 0,0:02:54.29,0:02:55.75,Default,,0,0,0,,Ноби-чан?
Dialogue: 0,0:02:55.84,0:03:00.26,Default,,0,0,0,,Уф... Не істеуім керек? Не істеуім керек? Сынақ... Уф
Dialogue: 0,0:03:00.51,0:03:01.93,Default,,0,0,0,,Нобита
Dialogue: 0,0:03:02.01,0:03:03.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:03.85,0:03:07.14,Default,,0,0,0,,Сырттан қайтқанда қолыңызды жуып, шайыңыз.
Dialogue: 0,0:03:07.27,0:03:09.56,Default,,0,0,0,,Сіз әрқашан осылай айтасыз, солай ма?
Dialogue: 0,0:03:09.68,0:03:12.48,Default,,0,0,0,,Мен... Дәл қазір ойлап жүр едім.
Dialogue: 0,0:03:12.60,0:03:14.40,Default,,0,0,0,,Ресми құжаттарды жариялаған екен.
Dialogue: 0,0:03:14.48,0:03:16.65,Default,,0,0,0,,Сіз міндетті түрде ұмыттыңыз.
Dialogue: 0,0:03:24.57,0:03:29.20,Default,,0,0,0,,Мама... Қытықтап қалды... Мама...
Dialogue: 0,0:03:31.50,0:03:35.38,Default,,0,0,0,,Эхе... Мии-чан, солай...
Dialogue: 0,0:03:35.50,0:03:36.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:47.22,0:03:48.93,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:03:49.06,0:03:53.14,Default,,0,0,0,,Жоқ! жоқ! Жоқ, жоқ, жоқ, қоңырау жоқ!
Dialogue: 0,0:03:53.27,0:03:55.98,Default,,0,0,0,,Қоңырау ұрланды!
Dialogue: 0,0:03:56.11,0:03:58.98,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:03:59.07,0:04:01.40,Default,,0,0,0,,Нобита!
Dialogue: 0,0:04:08.03,0:04:14.04,Default,,0,0,0,,♪～
Dialogue: 0,0:04:25.89,0:04:27.72,Default,,0,0,0,,Takecopter
Dialogue: 0,0:04:41.44,0:04:43.36,Default,,0,0,0,,Кез келген жердегі есік
Dialogue: 0,0:05:11.51,0:05:17.52,Default,,0,0,0,,～♪
Dialogue: 0,0:05:18.23,0:05:21.77,Default,,0,0,0,,Мен шкафта гиперкеңістік тесігін көрдім.
Dialogue: 0,0:05:21.90,0:05:23.94,Default,,0,0,0,,Сол жерден жаңа
Dialogue: 0,0:05:24.07,0:05:26.90,Default,,0,0,0,,Гиперкеңістік болашақтан келе ме?
Dialogue: 0,0:05:27.24,0:05:30.16,Default,,0,0,0,,Мүмкін білмеймін
Dialogue: 0,0:05:30.28,0:05:32.91,Default,,0,0,0,,Бірақ сол қоңыраулар ше?
Dialogue: 0,0:05:33.04,0:05:34.62,Default,,0,0,0,,«Қоңырау» дегеніміз не?
Dialogue: 0,0:05:34.75,0:05:38.00,Default,,0,0,0,,Бұл мен үшін маңызды қоңырау!
Dialogue: 0,0:05:38.12,0:05:40.54,Default,,0,0,0,,Себебі ол сынған, солай ма?
Dialogue: 0,0:05:40.67,0:05:43.96,Default,,0,0,0,,Мысықтарды жинау функциясы жұмыс істемейді немесе бір нәрсе...
Dialogue: 0,0:05:44.09,0:05:46.76,Default,,0,0,0,,Хмм... Мен оны бірнеше жыл бұрын жөндедім.
Dialogue: 0,0:05:46.88,0:05:51.22,Default,,0,0,0,,22-ғасырға қайтып келгенде, мен оны жөндеуге жібердім.
Dialogue: 0,0:05:51.64,0:05:56.31,Default,,0,0,0,,Иә? Мұндай жаңасын сатып алу арзанырақ
Dialogue: 0,0:05:56.43,0:05:59.02,Default,,0,0,0,,Жөндеу құны осы сомадан бес есе көп болады.
Dialogue: 0,0:05:59.15,0:06:00.90,Default,,0,0,0,,Иә? Бес рет?
Dialogue: 0,0:06:01.15,0:06:06.11,Default,,0,0,0,,Модельдер ескі және жаңалары көп.
Dialogue: 0,0:06:06.24,0:06:10.41,Default,,0,0,0,,Сонымен... Бірақ бұл маңызды естеліктердің қоңырауы.
Dialogue: 0,0:06:10.53,0:06:12.41,Default,,0,0,0,,Түзетіңізші!
Dialogue: 0,0:06:12.53,0:06:16.66,Default,,0,0,0,,Иә? Егер сіз соншалықты көп айтсаңыз ...
Dialogue: 0,0:06:17.21,0:06:20.83,Default,,0,0,0,,Хмм, бұл неге соншалықты маңызды?
Dialogue: 0,0:06:20.96,0:06:24.92,Default,,0,0,0,,Бұл... бұл... жарайды.
Dialogue: 0,0:06:25.51,0:06:29.97,Default,,0,0,0,,Бірақ оның басқа адамдар үшін құндылығы жоқ.
Dialogue: 0,0:06:30.43,0:06:32.39,Default,,0,0,0,,Бірақ неге жер бетінде...
Dialogue: 0,0:06:32.51,0:06:34.60,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:06:34.68,0:06:37.06,Default,,0,0,0,,Оның орнына басқа нәрсе киюім керек пе?
Dialogue: 0,0:06:37.18,0:06:38.48,Default,,0,0,0,,Ауыстыру?
Dialogue: 0,0:06:38.60,0:06:40.98,Default,,0,0,0,,Уау! Хехехехе...
Dialogue: 0,0:06:41.56,0:06:43.44,Default,,0,0,0,,Kisekae камерасы
Dialogue: 0,0:06:43.52,0:06:45.48,Default,,0,0,0,,Иә, иә, күл, күл
Dialogue: 0,0:06:45.61,0:06:46.65,Default,,0,0,0,,Ехе ехе...
Dialogue: 0,0:06:46.73,0:06:48.03,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:06:48.15,0:06:49.57,Default,,0,0,0,,Уфу эхехе (ысырма дыбысы)
Dialogue: 0,0:06:50.28,0:06:51.91,Default,,0,0,0,,Рождестволық қоңыраулар
Dialogue: 0,0:06:52.03,0:06:54.58,Default,,0,0,0,,Сәлем! Бұл маусымнан тыс
Dialogue: 0,0:06:55.03,0:06:57.25,Default,,0,0,0,,Олай болса мынау ғибадатхана қоңырауы.
Dialogue: 0,0:06:57.37,0:06:59.29,Default,,0,0,0,,Хмм... табынба!
Dialogue: 0,0:06:59.50,0:07:01.42,Default,,0,0,0,,Сонда бұл банан.
Dialogue: 0,0:07:01.54,0:07:03.00,Default,,0,0,0,,Тіпті қоңырау да емес
Dialogue: 0,0:07:03.13,0:07:04.34,Default,,0,0,0,,Пісірілген жұмыртқа
Dialogue: 0,0:07:04.46,0:07:05.92,Default,,0,0,0,,Түсініктемелерде ақау
Dialogue: 0,0:07:06.05,0:07:06.88,Default,,0,0,0,,Балапан
Dialogue: 0,0:07:07.00,0:07:08.76,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:07:08.88,0:07:10.43,Default,,0,0,0,,Элизабеттің түсі
Dialogue: 0,0:07:10.55,0:07:11.76,Default,,0,0,0,,Эй
Dialogue: 0,0:07:12.01,0:07:14.76,Default,,0,0,0,,Бұл жай ғана сары емес!
Dialogue: 0,0:07:14.89,0:07:17.27,Default,,0,0,0,,Маған ұнамайды, егер бұл қоңырау болмаса!
Dialogue: 0,0:07:17.39,0:07:20.35,Default,,0,0,0,,Мүлдем жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:07:20.48,0:07:22.02,Default,,0,0,0,,Қазірдің өзінде! Мияу мияу...
Dialogue: 0,0:07:22.15,0:07:23.69,Default,,0,0,0,,Дораемон...
Dialogue: 0,0:07:24.31,0:07:26.48,Default,,0,0,0,,Не, сен мысыққа ұқсайсың ба?
Dialogue: 0,0:07:26.69,0:07:29.69,Default,,0,0,0,,А, дұрыс! Эй Дораемон
Dialogue: 0,0:07:30.07,0:07:33.07,Default,,0,0,0,,Детектив болу үшін құралдарыңыз жоқ па?
Dialogue: 0,0:07:33.20,0:07:34.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.62,0:07:38.37,Default,,0,0,0,,Шерлок Холмс жинағы!
Dialogue: 0,0:07:38.45,0:07:42.58,Default,,0,0,0,,Уау, керемет! Бұл фильмде көргеніңіз сияқты!
Dialogue: 0,0:07:42.96,0:07:46.29,Default,,0,0,0,,Осының көмегімен кез келген адам тамаша детектив бола алады.
Dialogue: 0,0:07:46.42,0:07:50.05,Default,,0,0,0,,Уау! Детектив Нобита!
Dialogue: 0,0:07:50.17,0:07:52.38,Default,,0,0,0,,Салқын
Dialogue: 0,0:07:52.51,0:07:55.80,Default,,0,0,0,,Жарайды, қоңырауымды ұрлаған қылмыскерді табайық.
Dialogue: 0,0:07:55.93,0:07:58.56,Default,,0,0,0,,Ең алдымен... түзу құбыр
Dialogue: 0,0:07:58.68,0:08:03.27,Default,,0,0,0,,Осы құбырды үрлегенде шар шығып, қылмыскердің басынан асып түседі.
Dialogue: 0,0:08:04.06,0:08:05.40,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:08:06.06,0:08:06.86,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:08:06.98,0:08:11.24,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:08:11.61,0:08:13.49,Default,,0,0,0,,Пхуха... хаа ха...
Dialogue: 0,0:08:13.61,0:08:15.41,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:08:15.53,0:08:17.74,Default,,0,0,0,,Иә? Ах, кептеліп қалды
Dialogue: 0,0:08:17.87,0:08:19.20,Default,,0,0,0,,Зуко
Dialogue: 0,0:08:19.37,0:08:23.66,Default,,0,0,0,,Бұл қылмыскердің бағытына түсетін радар таяқшасы.
Dialogue: 0,0:08:23.96,0:08:27.63,Default,,0,0,0,,Жарайды, қайсысы кінәлі?
Dialogue: 0,0:08:31.05,0:08:32.30,Default,,0,0,0,,Мен құламаймын.
Dialogue: 0,0:08:32.42,0:08:34.09,Default,,0,0,0,,Сіз құламайсыз.
Dialogue: 0,0:08:34.55,0:08:37.47,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:08:37.60,0:08:38.76,Default,,0,0,0,,құлады
Dialogue: 0,0:08:39.10,0:08:43.94,Default,,0,0,0,,Жағдайы жақсы емес сияқты, себебі бұл мен арзан бағамен сатып алғанмын.
Dialogue: 0,0:08:44.06,0:08:46.65,Default,,0,0,0,,Енді болжап көрейік, түкірікті сипап көрейік...
Dialogue: 0,0:08:46.77,0:08:49.86,Default,,0,0,0,,Менің ақыл-ойым тезірек және менің шегерімдерім жақсарады.
Dialogue: 0,0:08:49.98,0:08:51.78,Default,,0,0,0,,Жарайды, бұл жолы.
Dialogue: 0,0:08:54.57,0:08:56.07,Default,,0,0,0,,Нобибибеан!
Dialogue: 0,0:08:56.41,0:08:57.99,Default,,0,0,0,,Менде бір идея болды!
Dialogue: 0,0:08:58.53,0:09:00.45,Default,,0,0,0,,Кінәлі - Қулықшы Ұры DX
Dialogue: 0,0:09:00.58,0:09:03.20,Default,,0,0,0,,Кайто DX... деген кім?
Dialogue: 0,0:09:03.33,0:09:05.16,Default,,0,0,0,,Иә? Мен түсінбеймін
Dialogue: 0,0:09:05.29,0:09:08.46,Default,,0,0,0,,Зуко... Бұл жай ғана аты ма?
Dialogue: 0,0:09:08.54,0:09:12.21,Default,,0,0,0,,Бірақ елес ұрыға түскені ғажап!
Dialogue: 0,0:09:12.34,0:09:15.93,Default,,0,0,0,,Мен не істеуім керек? Ол Люпин сияқты ұлы ұры болуы мүмкін.
Dialogue: 0,0:09:16.59,0:09:19.10,Default,,0,0,0,,Детективтерге алдын ала түсінік беруге тыйым салынады.
Dialogue: 0,0:09:19.22,0:09:20.05,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:09:20.18,0:09:23.39,Default,,0,0,0,,Бұл бастауыш, мистер Холмс.
Dialogue: 0,0:09:23.60,0:09:25.81,Default,,0,0,0,,Соңында, анықтамалық линза
Dialogue: 0,0:09:26.23,0:09:29.11,Default,,0,0,0,,Оны қараған кезде сізге түсінік беретін суретті көресіз.
Dialogue: 0,0:09:29.23,0:09:30.82,Default,,0,0,0,,А, бірдеңе шықты.
Dialogue: 0,0:09:32.40,0:09:34.53,Default,,0,0,0,,Мм... міне!
Dialogue: 0,0:09:34.65,0:09:35.74,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:09:37.91,0:09:42.03,Default,,0,0,0,,Бұл 22 ғасырдағы «құпия құралдар мұражайы».
Dialogue: 0,0:09:42.16,0:09:44.29,Default,,0,0,0,,Құпия құралдар мұражайы (музей)?
Dialogue: 0,0:09:44.41,0:09:49.21,Default,,0,0,0,,Менің қалтамда көптеген құпия құралдар бар, солай ма?
Dialogue: 0,0:09:49.33,0:09:52.71,Default,,0,0,0,,Мұндай құралдардың ең алғашқы түрінен соңғы түрлеріне дейін.
Dialogue: 0,0:09:52.84,0:09:57.34,Default,,0,0,0,,Бұл бәрі бар ғажайып мұражай.
Dialogue: 0,0:09:57.47,0:10:00.30,Default,,0,0,0,,Бұл Дораемонның қоңырауы бар дегенді білдіре ме?
Dialogue: 0,0:10:00.43,0:10:04.68,Default,,0,0,0,,Анықтамалық линза бұзылмаса, солай болады.
Dialogue: 0,0:10:04.77,0:10:09.23,Default,,0,0,0,,А, мен Дорамидің шақыруы бар екенін айтқанына сенімдімін.
Dialogue: 0,0:10:09.52,0:10:11.02,Default,,0,0,0,,Хмм... (Қоңырау үні)
Dialogue: 0,0:10:11.77,0:10:14.44,Default,,0,0,0,,Бұлай алысқа барудың қажеті жоқ...
Dialogue: 0,0:10:14.57,0:10:17.82,Default,,0,0,0,,Мен саған болашақ әмбебап дүкеннен жаңасын сатып аламын.
Dialogue: 0,0:10:17.95,0:10:22.37,Default,,0,0,0,,Жоқ, жоқ! Мен бұл қоңырау болғанын қаламаймын!
Dialogue: 0,0:10:22.49,0:10:24.74,Default,,0,0,0,,Сен неге бұл қоңырауға ерекше көңіл бөлесің?
Dialogue: 0,0:10:24.87,0:10:30.17,Default,,0,0,0,,А... Мен... Бұл... Жақсы, солай емес пе?
Dialogue: 0,0:10:30.25,0:10:34.92,Default,,0,0,0,,Мен ештеңе істей алмаймын, өйткені ол бәрібір жабылмайды.
Dialogue: 0,0:10:35.05,0:10:36.96,Default,,0,0,0,,Ле… лимон?
Dialogue: 0,0:10:37.09,0:10:39.68,Default,,0,0,0,,Ендеше сары болса жақсы...
Dialogue: 0,0:10:40.18,0:10:41.76,Default,,0,0,0,,Иә, бұл шақыру
Dialogue: 0,0:10:41.89,0:10:43.35,Default,,0,0,0,,Ах! Не... уф...
Dialogue: 0,0:10:44.43,0:10:46.97,Default,,0,0,0,,Мұны алу өте қиын болды.
Dialogue: 0,0:10:47.10,0:10:48.89,Default,,0,0,0,,Мен оны саған тегін бере алмаймын.
Dialogue: 0,0:10:49.02,0:10:52.44,Default,,0,0,0,,Жарайды, мен саған келесі жолы 10 кесе қауын нан әкелемін.
Dialogue: 0,0:10:52.56,0:10:54.40,Default,,0,0,0,,20 дана! мен...
Dialogue: 0,0:10:54.52,0:10:57.53,Default,,0,0,0,,Мен әкелемін... 20 дана.
Dialogue: 0,0:10:57.65,0:11:00.32,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:11:00.61,0:11:03.03,Default,,0,0,0,,Бұл бір карта 5 адамға дейін сыяды.
Dialogue: 0,0:11:03.12,0:11:05.58,Default,,0,0,0,,Е, онда Дорами-чан менімен бірге болады...
Dialogue: 0,0:11:05.70,0:11:09.25,Default,,0,0,0,,Бүгін емес. Кешке қауын нан сатылымға шығады.
Dialogue: 0,0:11:09.66,0:11:11.83,Default,,0,0,0,,Олай болса Шизука-чанды шақырайық.
Dialogue: 0,0:11:11.96,0:11:14.42,Default,,0,0,0,,Дораемон, есікті кез келген жерден аш.
Dialogue: 0,0:11:14.54,0:11:18.26,Default,,0,0,0,,Тез, тез, тез, тез!
Dialogue: 0,0:11:18.38,0:11:20.34,Default,,0,0,0,,О... (Нобита) Шизука-чан
Dialogue: 0,0:11:20.47,0:11:21.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:21.47,0:11:23.84,Default,,0,0,0,,О, Нобита, сенде не бар?
Dialogue: 0,0:11:23.97,0:11:25.60,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:11:25.72,0:11:27.22,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:27.93,0:11:29.98,Default,,0,0,0,,Ал, солай ма?
Dialogue: 0,0:11:30.06,0:11:31.48,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:11:31.60,0:11:34.44,Default,,0,0,0,,Біз де қол ұшын созбаймыз.
Dialogue: 0,0:11:34.52,0:11:35.86,Default,,0,0,0,,Сәлем? Сунео
Dialogue: 0,0:11:35.98,0:11:40.15,Default,,0,0,0,,Дұрыс, бәріміз мұражайға барып, қоңырауды іздейік.
Dialogue: 0,0:11:40.28,0:11:43.24,Default,,0,0,0,,Мен жәй ғана мұражайға барғым келетіндей сезінемін.
Dialogue: 0,0:11:43.36,0:11:45.41,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:11:45.49,0:11:46.87,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:11:53.21,0:11:54.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:56.88,0:11:59.76,Default,,0,0,0,,Уа (бәрі) Уау!
Dialogue: 0,0:12:04.80,0:12:07.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.60,0:12:14.10,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:12:14.23,0:12:16.81,Default,,0,0,0,,Шақыру машинаға айналды!
Dialogue: 0,0:12:16.90,0:12:19.23,Default,,0,0,0,,Керемет! Дораемон!
Dialogue: 0,0:12:19.36,0:12:21.49,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:12:21.61,0:12:23.24,Default,,0,0,0,,Дораемон?
Dialogue: 0,0:12:23.82,0:12:25.16,Default,,0,0,0,,Сәлем Дорами-чан
Dialogue: 0,0:12:25.28,0:12:28.45,Default,,0,0,0,,Дораэмон біраз уақыттан бері біртүрлі болды.
Dialogue: 0,0:12:28.53,0:12:31.54,Default,,0,0,0,,Мияу мияу (Нобита) Мысық сияқты бірдеңе...
Dialogue: 0,0:12:31.66,0:12:34.17,Default,,0,0,0,,Хмм, бұл қаңғыбас мысыққа айналды.
Dialogue: 0,0:12:34.46,0:12:36.38,Default,,0,0,0,,Иә? Қаңғыбас мысық?
Dialogue: 0,0:12:36.50,0:12:38.71,Default,,0,0,0,,Егер сіз қоңырауды шешіп, оны жай қалдырсаңыз ...
Dialogue: 0,0:12:38.84,0:12:40.25,Default,,0,0,0,,Мен мысыққа айналып бара жатырмын
Dialogue: 0,0:12:40.38,0:12:42.13,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:12:42.63,0:12:45.22,Default,,0,0,0,,Не істесең де бәрібір, Қоңырауды бассаң тынышталады.
Dialogue: 0,0:12:45.34,0:12:47.34,Default,,0,0,0,,Мен бұл қоңырау емес екеніне сене алар емеспін.
Dialogue: 0,0:12:47.72,0:12:50.31,Default,,0,0,0,,Сіз неге соншалықты ерекшесіз?
Dialogue: 0,0:12:50.43,0:12:54.81,Default,,0,0,0,,Хмм, анау қоңырау... Бірдеңе болды ма?
Dialogue: 0,0:12:54.94,0:12:56.56,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:12:56.65,0:12:58.56,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:12:58.69,0:13:01.03,Default,,0,0,0,,Ух... иә! (Сунео) Менің шашым...
Dialogue: 0,0:13:01.11,0:13:03.57,Default,,0,0,0,,Мұражайға көлік жөнелтіледі
Dialogue: 0,0:13:03.69,0:13:05.49,Default,,0,0,0,,Ол сөйледі! Ооо
Dialogue: 0,0:13:05.57,0:13:06.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:06.70,0:13:09.12,Default,,0,0,0,,Бұл қауіпті, сондықтан дұрыс отырыңыз.
Dialogue: 0,0:13:09.91,0:13:11.91,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:11.99,0:13:14.37,Default,,0,0,0,,Қауын Танысқаныма қуаныштымын!
Dialogue: 0,0:13:14.87,0:13:16.46,Default,,0,0,0,,Уа... аа!
Dialogue: 0,0:13:18.04,0:13:20.67,Default,,0,0,0,,Гиперкеңістікке кіру
Dialogue: 0,0:13:21.75,0:13:22.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:23.17,0:13:24.88,Default,,0,0,0,,Уау
Dialogue: 0,0:13:30.76,0:13:32.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:32.31,0:13:35.02,Default,,0,0,0,,Бұл 22 ғасыр! Уау
Dialogue: 0,0:13:35.35,0:13:38.23,Default,,0,0,0,,Жамандық көрме, жамандық естіме, Осару Мұқай
Dialogue: 0,0:13:38.48,0:13:41.19,Default,,0,0,0,,Барлығыңыз алға қараңыздар.
Dialogue: 0,0:13:41.90,0:13:44.36,Default,,0,0,0,,Уау! Не? Бұл
Dialogue: 0,0:13:44.49,0:13:49.45,Default,,0,0,0,,Аралдың жоғарғы жағында Құпия құралдар мұражайы қалқып тұр.
Dialogue: 0,0:13:49.87,0:13:52.79,Default,,0,0,0,,Сол аралға дүние жүзінің түкпір-түкпірінен адамдар жиналды.
Dialogue: 0,0:13:52.91,0:13:55.37,Default,,0,0,0,,Құрал жасаушылардың тұратын жері
Dialogue: 0,0:13:55.50,0:13:58.33,Default,,0,0,0,,Оны тек аралдан алуға болатын сияқты.
Dialogue: 0,0:13:58.46,0:14:01.71,Default,,0,0,0,,Барлық материалдар мен техника бар.
Dialogue: 0,0:14:01.84,0:14:07.42,Default,,0,0,0,,Барлығы таңғажайып құралдарды жасау үшін күні-түні ізденіс үстінде.
Dialogue: 0,0:14:17.48,0:14:18.31,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:14:28.86,0:14:30.66,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:14:30.78,0:14:32.62,Default,,0,0,0,,(Сунео мен оның достарының күлкісі)
Dialogue: 0,0:14:39.75,0:14:41.25,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:14:42.38,0:14:44.21,Default,,0,0,0,,Мияу! Няго!
Dialogue: 0,0:14:44.30,0:14:45.75,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:14:45.88,0:14:47.34,Default,,0,0,0,,Мысыққа ұқсайды!
Dialogue: 0,0:14:55.81,0:14:56.81,Default,,0,0,0,,Иә? Курт!
Dialogue: 0,0:14:56.93,0:14:57.93,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:58.43,0:15:01.15,Default,,0,0,0,,Ой... Аа, директор, сәлем.
Dialogue: 0,0:15:01.23,0:15:02.77,Default,,0,0,0,,«сәлем» емес
Dialogue: 0,0:15:02.90,0:15:07.07,Default,,0,0,0,,Сіз гид міндеттеріңізден бас тартып, жер бетінде қайда жүрдіңіз?
Dialogue: 0,0:15:07.19,0:15:08.90,Default,,0,0,0,,Ал... (Сунео) Иә?
Dialogue: 0,0:15:09.03,0:15:11.82,Default,,0,0,0,,Міне...
Dialogue: 0,0:15:11.91,0:15:16.16,Default,,0,0,0,,Оның орнына, директор, біз жаңа құпия құрал жасадық.
Dialogue: 0,0:15:16.29,0:15:20.25,Default,,0,0,0,,Хмм? Қалай болғанда да, бұл жай ғана тағы бір жаман құрал емес пе?
Dialogue: 0,0:15:20.37,0:15:22.12,Default,,0,0,0,,Бұл жолы керемет.
Dialogue: 0,0:15:22.25,0:15:24.67,Default,,0,0,0,,Мен оны мұражайларға сенімді түрде ұсына аламын...
Dialogue: 0,0:15:25.75,0:15:27.13,Default,,0,0,0,,Бұл Крукук!
Dialogue: 0,0:15:27.38,0:15:28.42,Default,,0,0,0,,Құрукук?
Dialogue: 0,0:15:28.55,0:15:29.76,Default,,0,0,0,,«Ұш!» деңіз.
Dialogue: 0,0:15:29.88,0:15:32.59,Default,,0,0,0,,Аспанда ұшақ сияқты жылдам ұшуға мүмкіндік беретін құрал.
Dialogue: 0,0:15:32.72,0:15:35.10,Default,,0,0,0,,Жүріңдер, киіңдер, киіңдер (Сүйеді) Ой... Ой...
Dialogue: 0,0:15:35.43,0:15:36.76,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:15:36.89,0:15:39.81,Default,,0,0,0,,Онда... Ұш!
Dialogue: 0,0:15:39.89,0:15:43.60,Default,,0,0,0,,(Күркүктің айқайы)
Dialogue: 0,0:15:43.73,0:15:44.77,Default,,0,0,0,,Ой
Dialogue: 0,0:15:44.90,0:15:46.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:46.73,0:15:50.24,Default,,0,0,0,,Әй, тоқпақ! Тоқта... тоқта, тоқта
Dialogue: 0,0:15:50.36,0:15:51.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:51.28,0:15:53.82,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:54.32,0:15:55.99,Default,,0,0,0,,Әке... Амансың ба? Директор
Dialogue: 0,0:15:56.12,0:15:58.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.58,0:16:00.70,Default,,0,0,0,,Геппоко Хеппоко!
Dialogue: 0,0:16:00.83,0:16:03.17,Default,,0,0,0,,Күлме! Не? Сіз жігіттер!
Dialogue: 0,0:16:03.29,0:16:06.17,Default,,0,0,0,,О? А... шақыру
Dialogue: 0,0:16:06.54,0:16:10.80,Default,,0,0,0,,Жоқ, жоқ, сіз тұтынушы болдыңыз ба? Кешіріңіз.
Dialogue: 0,0:16:10.92,0:16:13.68,Default,,0,0,0,,Менің атым – Фикс, куратор.
Dialogue: 0,0:16:14.18,0:16:16.97,Default,,0,0,0,,Құпия құралдар мұражайына қош келдіңіз (музей)
Dialogue: 0,0:16:17.10,0:16:19.47,Default,,0,0,0,,Шақыруды көрейік.
Dialogue: 0,0:16:19.60,0:16:21.48,Default,,0,0,0,,Хмм... Бұл Дорэмон-сама, солай емес пе?
Dialogue: 0,0:16:21.60,0:16:22.35,Default,,0,0,0,,Иә
Dialogue: 0,0:16:22.48,0:16:25.56,Default,,0,0,0,,Курт, мен саған айналаны көрсетейін.
Dialogue: 0,0:16:25.65,0:16:29.44,Default,,0,0,0,,Иә? Сондықтан... бірақ мен Құрукукту іздеуім керек...
Dialogue: 0,0:16:29.57,0:16:31.99,Default,,0,0,0,,Маған бұл ақымақ құрал бәрібір!
Dialogue: 0,0:16:32.11,0:16:36.37,Default,,0,0,0,,Құралдарыңыз мұражайда көрсетілетін күн ешқашан келмейді!
Dialogue: 0,0:16:36.91,0:16:39.87,Default,,0,0,0,,Басыңызды қалдырыңыз және басшылық ретінде жұмысыңызға шоғырланыңыз!
Dialogue: 0,0:16:41.16,0:16:43.62,Default,,0,0,0,,Гид формасы... аа...
Dialogue: 0,0:16:45.42,0:16:46.54,Default,,0,0,0,,Өзін-өзі таныстыру
Dialogue: 0,0:16:46.63,0:16:49.21,Default,,0,0,0,,Ах, мен гид болып толық емес жұмыс күніммен жұмыс істеймін.
Dialogue: 0,0:16:49.34,0:16:51.76,Default,,0,0,0,,Сәлеметсіз бе, мен Курт Хартманмын.
Dialogue: 0,0:16:51.96,0:16:53.09,Default,,0,0,0,,Мен Нобитамын.
Dialogue: 0,0:16:53.22,0:16:54.34,Default,,0,0,0,,Тыныш
Dialogue: 0,0:16:54.47,0:16:55.51,Default,,0,0,0,,Бұл Сунео.
Dialogue: 0,0:16:55.63,0:16:57.72,Default,,0,0,0,,Мен Джанмын
Dialogue: 0,0:16:58.01,0:17:03.14,Default,,0,0,0,,Директор: Негізі біз мұражайға бірдеңе іздеп келдік.
Dialogue: 0,0:17:03.27,0:17:04.44,Default,,0,0,0,,Не іздеп жүрсіз?
Dialogue: 0,0:17:04.52,0:17:07.69,Default,,0,0,0,,Менің қоңырауымды біреу ұрлап кетті...
Dialogue: 0,0:17:07.81,0:17:11.32,Default,,0,0,0,,Мен Шерлок Холмстың осы жинағын зерттедім...
Dialogue: 0,0:17:11.44,0:17:14.40,Default,,0,0,0,,Қулықшы Ұры DX деген атауға ие болды.
Dialogue: 0,0:17:14.49,0:17:17.11,Default,,0,0,0,,Қа... Қулықшы Ұры DX! ?
Dialogue: 0,0:17:17.24,0:17:18.62,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:18.70,0:17:21.79,Default,,0,0,0,,Мен өткен күні бұл мұражай туралы ештеңе білмеймін...
Dialogue: 0,0:17:21.91,0:17:23.95,Default,,0,0,0,,Ол мені өлтірді.
Dialogue: 0,0:17:24.08,0:17:25.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.16,0:17:28.08,Default,,0,0,0,,Жарық ғимараттағы үлкен шам ұрланған.
Dialogue: 0,0:17:28.17,0:17:29.79,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:17:29.92,0:17:33.55,Default,,0,0,0,,Көптеген полиция қызметкерлерін соққымен шабу
Dialogue: 0,0:17:33.67,0:17:37.22,Default,,0,0,0,,Тіпті көрінбейтін жылдамдықпен
Dialogue: 0,0:17:37.34,0:17:41.60,Default,,0,0,0,,Уау, керемет болды. Бұл не болды... аа...
Dialogue: 0,0:17:44.52,0:17:46.77,Default,,0,0,0,,Неліктен үлкен құқық алынды?
Dialogue: 0,0:17:46.89,0:17:50.27,Default,,0,0,0,,Мен бұл туралы білмеймін. Мен әлі де тергеу үстіндемін.
Dialogue: 0,0:17:50.40,0:17:54.78,Default,,0,0,0,,Үлкен жарық пен Сузуда жалпы ештеңе жоқ.
Dialogue: 0,0:17:55.15,0:17:59.99,Default,,0,0,0,,Ум, анықтамалық объектив бұл жерде қоңырау бар екенін айтады.
Dialogue: 0,0:18:00.07,0:18:02.41,Default,,0,0,0,,Хмм, егер ерекше нәрсе болса...
Dialogue: 0,0:18:02.53,0:18:05.29,Default,,0,0,0,,Қауіпсіздік жүйесі жауап беруі керек еді.
Dialogue: 0,0:18:05.91,0:18:08.29,Default,,0,0,0,,Жарайды, тексеріп көрейік.
Dialogue: 0,0:18:08.42,0:18:10.58,Default,,0,0,0,,Келе жатқанда бәріңіз қиындыққа тап болдыңыздар...
Dialogue: 0,0:18:10.71,0:18:14.25,Default,,0,0,0,,Қоңырауды іздеу кезінде мұражайды тамашалаңыз.
Dialogue: 0,0:18:14.76,0:18:16.26,Default,,0,0,0,,Курт, мен оны сұрадым.
Dialogue: 0,0:18:16.38,0:18:17.67,Default,,0,0,0,,Иә
Dialogue: 0,0:18:19.18,0:18:20.39,Default,,0,0,0,,Кіріңіз, кіріңіз.
Dialogue: 0,0:18:20.51,0:18:22.30,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:22.43,0:18:24.93,Default,,0,0,0,,Оны ысырап етпеңіз!
Dialogue: 0,0:18:25.06,0:18:28.10,Default,,0,0,0,,Хехехе мынау кіреберіс.
Dialogue: 0,0:18:28.23,0:18:31.94,Default,,0,0,0,,Сол үлкен нәрсе есте қалатын бірінші құпия құрал.
Dialogue: 0,0:18:32.06,0:18:33.65,Default,,0,0,0,,Ерте үлгі кез келген жерде есік
Dialogue: 0,0:18:33.77,0:18:35.44,Default,,0,0,0,,Бұл бірінші мәселе ме?
Dialogue: 0,0:18:35.57,0:18:37.69,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:37.82,0:18:40.66,Default,,0,0,0,,Өткеннен қалған бірнеше есік бар...
Dialogue: 0,0:18:40.78,0:18:43.87,Default,,0,0,0,,...
Dialogue: 0,0:18:43.99,0:18:45.62,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:18:46.41,0:18:47.75,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:47.87,0:18:50.29,Default,,0,0,0,,Оны ысырап етпеңіз!
Dialogue: 0,0:18:50.42,0:18:52.33,Default,,0,0,0,,Әй, бұл кім?
Dialogue: 0,0:18:52.46,0:18:55.05,Default,,0,0,0,,Ах... ол адам...
Dialogue: 0,0:18:55.30,0:18:57.84,Default,,0,0,0,,―
Dialogue: 0,0:18:57.97,0:19:00.93,Default,,0,0,0,,Құпия құралдарда үлкен жетістіктерге жеткен ғалым.
Dialogue: 0,0:19:01.01,0:19:02.43,Default,,0,0,0,,Бұл доктор Хартман.
Dialogue: 0,0:19:02.55,0:19:04.18,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:19:04.26,0:19:08.60,Default,,0,0,0,,･
Dialogue: 0,0:19:08.73,0:19:12.56,Default,,0,0,0,,...
Dialogue: 0,0:19:12.69,0:19:13.56,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:19:13.90,0:19:16.44,Default,,0,0,0,,―
Dialogue: 0,0:19:16.57,0:19:19.99,Default,,0,0,0,,...
Dialogue: 0,0:19:20.11,0:19:21.45,Default,,0,0,0,,Геппоко Хеппоко!
Dialogue: 0,0:19:21.53,0:19:24.74,Default,,0,0,0,,Мен... мен де! Бір күні мен керемет нәрсе ойлап табамын ...
Dialogue: 0,0:19:24.87,0:19:28.66,Default,,0,0,0,,()
Dialogue: 0,0:19:31.75,0:19:33.96,Default,,0,0,0,,Уау! не? қазірдің өзінде!
Dialogue: 0,0:19:34.38,0:19:35.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:35.79,0:19:36.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:36.96,0:19:39.09,Default,,0,0,0,,...
Dialogue: 0,0:19:39.21,0:19:40.42,Default,,0,0,0,,Оны жеме!
Dialogue: 0,0:19:40.55,0:19:41.88,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:19:42.01,0:19:45.72,Default,,0,0,0,,Уф... уф... уф...
Dialogue: 0,0:19:46.22,0:19:48.39,Default,,0,0,0,,Хмм? О?
Dialogue: 0,0:19:48.85,0:19:50.52,Default,,0,0,0,,Ішке бірдеңе кіріп кетті.
Dialogue: 0,0:19:50.64,0:19:52.23,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:19:52.35,0:19:54.65,Default,,0,0,0,,Курт Бұл не? Бұл
Dialogue: 0,0:19:54.77,0:19:59.07,Default,,0,0,0,,Бұл таратқыш. Мұражайдың іші өте үлкен.
Dialogue: 0,0:19:59.19,0:20:02.91,Default,,0,0,0,,１
Dialogue: 0,0:20:02.99,0:20:04.66,Default,,0,0,0,,Иә? (Сунео) Сонда... жәбірленуші ме?
Dialogue: 0,0:20:04.78,0:20:07.33,Default,,0,0,0,,―
Dialogue: 0,0:20:07.45,0:20:10.04,Default,,0,0,0,,...
Dialogue: 0,0:20:10.16,0:20:11.33,Default,,0,0,0,,Мен қалтырап кеттім...
Dialogue: 0,0:20:11.41,0:20:14.63,Default,,0,0,0,,...
Dialogue: 0,0:20:14.75,0:20:17.54,Default,,0,0,0,,Кімнің қайда екенін нақты біліңіз
Dialogue: 0,0:20:17.67,0:20:19.42,Default,,0,0,0,,Уа, апельсин мен бе?
Dialogue: 0,0:20:19.55,0:20:21.01,Default,,0,0,0,,Сары-жасыл - мен!
Dialogue: 0,0:20:21.13,0:20:22.76,Default,,0,0,0,,Ақ курт па?
Dialogue: 0,0:20:22.84,0:20:25.34,Default,,0,0,0,,Дұрыс, менің жетекшілік ұстанымым.
Dialogue: 0,0:20:25.47,0:20:27.97,Default,,0,0,0,,А, есік ашылады.
Dialogue: 0,0:20:28.43,0:20:29.31,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:20:29.43,0:20:30.97,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:20:39.02,0:20:40.90,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:41.28,0:20:44.57,Default,,0,0,0,,Уау... ахххх
Dialogue: 0,0:20:47.57,0:20:50.70,Default,,0,0,0,,О... уау!
Dialogue: 0,0:20:50.83,0:20:52.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:57.13,0:20:58.67,Default,,0,0,0,,Бұл робот залы
Dialogue: 0,0:20:58.79,0:21:01.00,Default,,0,0,0,,...
Dialogue: 0,0:21:04.97,0:21:06.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:06.39,0:21:07.72,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:07.80,0:21:10.72,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:21:10.85,0:21:11.93,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:13.23,0:21:15.81,Default,,0,0,0,,Титаник роботы! Хаха
Dialogue: 0,0:21:15.94,0:21:18.15,Default,,0,0,0,,Кеттік! Хахаха...
Dialogue: 0,0:21:18.40,0:21:20.61,Default,,0,0,0,,Дораэмон тез!
Dialogue: 0,0:21:20.73,0:21:22.86,Default,,0,0,0,,Ал, хехехе
Dialogue: 0,0:21:23.49,0:21:25.45,Default,,0,0,0,,Бұл ағаш кесуші фонтан.
Dialogue: 0,0:21:25.57,0:21:27.03,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:30.87,0:21:32.54,Default,,0,0,0,,Нені тастадың?
Dialogue: 0,0:21:32.66,0:21:35.54,Default,,0,0,0,,...
Dialogue: 0,0:21:35.66,0:21:38.54,Default,,0,0,0,,...
Dialogue: 0,0:21:38.83,0:21:40.04,Default,,0,0,0,,Кәдімгі
Dialogue: 0,0:21:40.17,0:21:41.96,Default,,0,0,0,,Бұл шыншыл.
Dialogue: 0,0:21:42.09,0:21:45.34,Default,,0,0,0,,...
Dialogue: 0,0:21:45.47,0:21:46.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:46.63,0:21:48.01,Default,,0,0,0,,Уау, маған көмектес!
Dialogue: 0,0:21:48.39,0:21:49.97,Default,,0,0,0,,Уау! Өте ыстық
Dialogue: 0,0:21:50.10,0:21:51.47,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:21:55.39,0:21:59.73,Default,,0,0,0,,Уау! Ах, аа!
Dialogue: 0,0:22:00.48,0:22:02.98,Default,,0,0,0,,Оны баспаңыз (барлығы) Уау!
Dialogue: 0,0:22:03.69,0:22:05.53,Default,,0,0,0,,…  （）…
Dialogue: 0,0:22:05.65,0:22:06.61,Default,,0,0,0,,Не?
Dialogue: 0,0:22:06.74,0:22:08.82,Default,,0,0,0,,...
Dialogue: 0,0:22:09.03,0:22:10.49,Default,,0,0,0,,Не? мұнда
Dialogue: 0,0:22:10.62,0:22:13.29,Default,,0,0,0,,Сіз кенеттен аралға бұрылдыңыз ба?
Dialogue: 0,0:22:14.12,0:22:17.21,Default,,0,0,0,,―
Dialogue: 0,0:22:17.33,0:22:19.08,Default,,0,0,0,,Бұл бірге ойнауға болатын бұрыш.
Dialogue: 0,0:22:21.59,0:22:22.59,Default,,0,0,0,,О
Dialogue: 0,0:22:23.09,0:22:25.21,Default,,0,0,0,,（）
Dialogue: 0,0:22:25.34,0:22:26.55,Default,,0,0,0,,Қараңызшы (Нобита) Иә?
Dialogue: 0,0:22:26.63,0:22:28.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз маған ұқсайсыз, солай ма?
Dialogue: 0,0:22:29.05,0:22:30.26,Default,,0,0,0,,（）
Dialogue: 0,0:22:30.39,0:22:31.30,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:22:31.43,0:22:35.06,Default,,0,0,0,,...
Dialogue: 0,0:22:35.18,0:22:37.43,Default,,0,0,0,,...
Dialogue: 0,0:22:37.77,0:22:40.40,Default,,0,0,0,,...
Dialogue: 0,0:22:40.40,0:22:41.73,Default,,0,0,0,,...
Dialogue: 0,0:22:40.40,0:22:41.73,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:41.73,0:22:41.86,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:41.86,0:22:43.57,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:41.86,0:22:43.57,Default,,0,0,0,,Иә? Бұл қоңырау!
Dialogue: 0,0:22:43.57,0:22:43.69,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:43.69,0:22:44.36,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:43.69,0:22:44.36,Default,,0,0,0,,（） …
Dialogue: 0,0:22:44.36,0:22:45.86,Default,,0,0,0,,（） …
Dialogue: 0,0:22:45.98,0:22:46.86,Default,,0,0,0,,Уау! бұл!
Dialogue: 0,0:22:48.57,0:22:49.91,Default,,0,0,0,,Ио... Ахаха
Dialogue: 0,0:22:50.24,0:22:55.08,Default,,0,0,0,,...
Dialogue: 0,0:22:55.16,0:22:56.33,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:22:56.45,0:22:58.83,Default,,0,0,0,,々
Dialogue: 0,0:22:58.96,0:23:01.96,Default,,0,0,0,,Тағы бір қоңырау? Бұл түсініксіз.
Dialogue: 0,0:23:02.08,0:23:04.29,Default,,0,0,0,,Сіз де алтын балық аулауға барасыз ба?
Dialogue: 0,0:23:04.42,0:23:07.09,Default,,0,0,0,,Бұл алтын балық емес, қабығы жұмсақ тасбақа роботы
Dialogue: 0,0:23:07.21,0:23:09.05,Default,,0,0,0,,Роботты қолдау?
Dialogue: 0,0:23:10.63,0:23:13.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:13.64,0:23:15.47,Default,,0,0,0,,Робот балық аулауды қолдайсыз ба?
Dialogue: 0,0:23:15.60,0:23:17.31,Default,,0,0,0,,Эй, балалар, сендер де көргілерің келе ме?
Dialogue: 0,0:23:17.43,0:23:18.73,Default,,0,0,0,,Уау, мен жасаймын!
Dialogue: 0,0:23:22.60,0:23:25.07,Default,,0,0,0,,Бұл балықты кім бірінші ұстай алатынын байқау.
Dialogue: 0,0:23:25.19,0:23:27.82,Default,,0,0,0,,Жарайды, мен жеңілемін деп ойлаймын.
Dialogue: 0,0:23:27.94,0:23:29.53,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:23:30.24,0:23:34.99,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:23:35.08,0:23:37.20,Default,,0,0,0,,Уа... а, міне келді!
Dialogue: 0,0:23:38.45,0:23:40.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:40.33,0:23:42.87,Default,,0,0,0,,(Тасбақаның айқайы)
Dialogue: 0,0:23:43.08,0:23:45.34,Default,,0,0,0,,А... уау
Dialogue: 0,0:23:46.84,0:23:48.59,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:23:49.01,0:23:51.34,Default,,0,0,0,,Ах! Жұмсақ қабықты тасбақа Неліктен? Жұмсақ қабықты тасбақа! ?
Dialogue: 0,0:23:51.47,0:23:53.34,Default,,0,0,0,,Неге, қабығы жұмсақ тасбақа! ? Неге, жұмсақ қабықты тасбақа! ?
Dialogue: 0,0:23:53.43,0:23:55.80,Default,,0,0,0,,Угиджи... Уау!
Dialogue: 0,0:23:55.93,0:23:57.14,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:23:57.26,0:23:59.98,Default,,0,0,0,,Сәлем! Қалтаңнан шық!
Dialogue: 0,0:24:00.10,0:24:01.31,Default,,0,0,0,,Айта
Dialogue: 0,0:24:02.10,0:24:04.27,Default,,0,0,0,,Ха ха ха Маған іші ұнады.
Dialogue: 0,0:24:04.40,0:24:06.02,Default,,0,0,0,,Оны біраз уақыт ұстаңыз
Dialogue: 0,0:24:06.11,0:24:10.15,Default,,0,0,0,,Уф, мен қалтамды пайдалана алмаймын.
Dialogue: 0,0:24:10.28,0:24:11.70,Default,,0,0,0,,Сәлем! (Нобита) Иә?
Dialogue: 0,0:24:11.99,0:24:13.49,Default,,0,0,0,,Сәлем Курт!
Dialogue: 0,0:24:13.61,0:24:15.41,Default,,0,0,0,,Әй, екеуі.
Dialogue: 0,0:24:15.53,0:24:16.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:25.46,0:24:28.59,Default,,0,0,0,,Бұл күзетші роботтар орналасқан тор.
Dialogue: 0,0:24:28.71,0:24:29.88,Default,,0,0,0,,Күзетші Робо?
Dialogue: 0,0:24:30.01,0:24:34.01,Default,,0,0,0,,Бұл қауіпті робот, бірақ ол қазір қауіпсіз, өйткені ол қозғалмайды.
Dialogue: 0,0:24:38.60,0:24:39.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:40.06,0:24:41.18,Default,,0,0,0,,Тынш! Керемет
Dialogue: 0,0:24:41.31,0:24:43.23,Default,,0,0,0,,Бұл қауіпті көрінеді.
Dialogue: 0,0:24:44.94,0:24:46.94,Default,,0,0,0,,Бұл ерте типтегі патрульдік робот.
Dialogue: 0,0:24:47.52,0:24:50.40,Default,,0,0,0,,Мұражай да алғашында осымен күзетілді, бірақ...
Dialogue: 0,0:24:51.07,0:24:54.86,Default,,0,0,0,,Ол енді қолданылмайды, себебі оның шабуыл күші тым жоғары және қауіпті.
Dialogue: 0,0:24:55.16,0:24:57.87,Default,,0,0,0,,Ух... түсіндім. (Нобита) Жарайды, жарайды.
Dialogue: 0,0:24:58.28,0:25:00.62,Default,,0,0,0,,Бұл қазіргі патрульдік робот.
Dialogue: 0,0:25:00.74,0:25:04.54,Default,,0,0,0,,Бұл көрмеге бір ғана күзетші Робо қалды.
Dialogue: 0,0:25:04.87,0:25:06.00,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:25:06.12,0:25:07.92,Default,,0,0,0,,Ей, ерте кетейік.
Dialogue: 0,0:25:08.04,0:25:10.25,Default,,0,0,0,,Не, Сунео, қорқып тұрсың ба?
Dialogue: 0,0:25:10.50,0:25:13.34,Default,,0,0,0,,Бебе... Қорқатын ештеңе жоқ.
Dialogue: 0,0:25:13.47,0:25:14.97,Default,,0,0,0,,Ол дұрыс қосылған.
Dialogue: 0,0:25:15.09,0:25:16.51,Default,,0,0,0,,Міне!
Dialogue: 0,0:25:16.64,0:25:17.72,Default,,0,0,0,,Гяаа! Ахаха!
Dialogue: 0,0:25:18.05,0:25:20.43,Default,,0,0,0,,Жүр, мен саған келесі сарайды көрсетемін.
Dialogue: 0,0:25:20.51,0:25:22.60,Default,,0,0,0,,Эй Сунео, қорқып тұрсың ба?
Dialogue: 0,0:25:22.72,0:25:23.89,Default,,0,0,0,,Мен қорықпаймын.
Dialogue: 0,0:25:28.23,0:25:30.90,Default,,0,0,0,,Хехе...
Dialogue: 0,0:25:31.44,0:25:35.32,Default,,0,0,0,,Тағы төрт... Тағы төртеуі қалды.
Dialogue: 0,0:25:36.53,0:25:39.12,Default,,0,0,0,,Келесі сарайға барар алдында осыны жеп қойыңыз.
Dialogue: 0,0:25:39.37,0:25:40.87,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:25:40.99,0:25:42.33,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:43.16,0:25:46.25,Default,,0,0,0,,Олай болса келесі зал...
Dialogue: 0,0:25:47.54,0:25:48.79,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:25:49.33,0:25:51.00,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:25:51.71,0:25:53.96,Default,,0,0,0,,Құлаған кезде өте сақ болыңыз.
Dialogue: 0,0:25:54.09,0:25:55.38,Default,,0,0,0,,Құлау?
Dialogue: 0,0:25:55.51,0:25:58.26,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,0:25:58.39,0:26:02.14,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:26:02.93,0:26:05.64,Default,,0,0,0,,Уау! Хахаха дәмді дәмді
Dialogue: 0,0:26:05.73,0:26:08.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:13.02,0:26:15.78,Default,,0,0,0,,Уау...
Dialogue: 0,0:26:16.57,0:26:18.15,Default,,0,0,0,,Бұл ғарыш мұражайы.
Dialogue: 0,0:26:18.28,0:26:19.41,Default,,0,0,0,,Ғарыш мұражайы!
Dialogue: 0,0:26:19.53,0:26:20.82,Default,,0,0,0,,Керемет!
Dialogue: 0,0:26:21.12,0:26:22.78,Default,,0,0,0,,Сонымен сіз бұрын не жедіңіз?
Dialogue: 0,0:26:22.91,0:26:24.66,Default,,0,0,0,,Жеуге болатын ғарыштық костюм
Dialogue: 0,0:26:24.79,0:26:28.79,Default,,0,0,0,,Тамақтану арқылы сіз скафандр киген күйде боласыз.
Dialogue: 0,0:26:28.92,0:26:31.08,Default,,0,0,0,,Кеттік (Нобита) Хахаха
Dialogue: 0,0:26:34.88,0:26:37.38,Default,,0,0,0,,О! Мен де солай істеуім керек!
Dialogue: 0,0:26:37.51,0:26:39.01,Default,,0,0,0,,А... о... а!
Dialogue: 0,0:26:39.13,0:26:41.09,Default,,0,0,0,,Жоқ, қозғалма!
Dialogue: 0,0:26:41.68,0:26:43.22,Default,,0,0,0,,Хехе, не? Бұл
Dialogue: 0,0:26:43.60,0:26:46.93,Default,,0,0,0,,Бұл жұлдыздың өмірін көруге арналған құрал.
Dialogue: 0,0:26:47.77,0:26:50.77,Default,,0,0,0,,Мысалы, күннің өмірі
Dialogue: 0,0:26:50.90,0:26:55.28,Default,,0,0,0,,Күн шамамен 5 миллиард жыл бұрын дүниеге келген.
Dialogue: 0,0:26:55.73,0:26:58.03,Default,,0,0,0,,Бұл қазіргі күй
Dialogue: 0,0:26:58.49,0:27:01.57,Default,,0,0,0,,Күн бұдан былай кеңейе береді...
Dialogue: 0,0:27:01.70,0:27:05.62,Default,,0,0,0,,Шамамен 6 миллиард жылдан кейін ол қызыл алыпқа айналады.
Dialogue: 0,0:27:05.74,0:27:07.16,Default,,0,0,0,,Сонымен... Деки
Dialogue: 0,0:27:07.37,0:27:08.96,Default,,0,0,0,,... Мен жұтылып кетем!
Dialogue: 0,0:27:09.08,0:27:11.12,Default,,0,0,0,,Қаш! (Барлығы) Уау!
Dialogue: 0,0:27:11.21,0:27:15.59,Default,,0,0,0,,♪～
Dialogue: 0,0:28:07.35,0:28:12.35,Default,,0,0,0,,～♪
Dialogue: 0,0:28:12.94,0:28:15.86,Default,,0,0,0,,Хехе...
Dialogue: 0,0:28:15.98,0:28:18.73,Default,,0,0,0,,Модельдеу тамаша.
Dialogue: 0,0:28:19.15,0:28:22.74,Default,,0,0,0,,Қалғаны... хехехе...
Dialogue: 0,0:28:22.86,0:28:25.16,Default,,0,0,0,,Гувахахаха!
Dialogue: 0,0:28:25.28,0:28:27.08,Default,,0,0,0,,Ата! (Пеплар) Эй!
Dialogue: 0,0:28:27.45,0:28:28.87,Default,,0,0,0,,А... ха... иә?
Dialogue: 0,0:28:28.99,0:28:30.87,Default,,0,0,0,,Уау, сондай бейберекет
Dialogue: 0,0:28:31.00,0:28:32.12,Default,,0,0,0,,Ааа...
Dialogue: 0,0:28:32.58,0:28:34.00,Default,,0,0,0,,Күріш пен шай қай уақытта?
Dialogue: 0,0:28:34.12,0:28:37.29,Default,,0,0,0,,Мен сізге үстелді жинаңыз деп айтып тұрмын.
Dialogue: 0,0:28:37.42,0:28:39.67,Default,,0,0,0,,Ол қазірдің өзінде тар.
Dialogue: 0,0:28:39.80,0:28:41.63,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:28:41.92,0:28:43.05,Default,,0,0,0,,Дайын!
Dialogue: 0,0:28:43.17,0:28:44.55,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:28:44.68,0:28:46.76,Default,,0,0,0,,О, бұл дәмді көрінеді.
Dialogue: 0,0:28:46.89,0:28:50.31,Default,,0,0,0,,Дұрыс? Дұрыс па? Бүгін бұл тәтті картоп торты
Dialogue: 0,0:28:50.43,0:28:53.81,Default,,0,0,0,,Мен тәтті картоп алдым, хехе.
Dialogue: 0,0:28:54.27,0:28:55.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:28:55.73,0:28:57.40,Default,,0,0,0,,Уау
Dialogue: 0,0:28:57.52,0:29:00.86,Default,,0,0,0,,Қайсысы жоғары немесе төмен екенін білмеймін.
Dialogue: 0,0:29:02.28,0:29:03.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:03.74,0:29:07.99,Default,,0,0,0,,Бұл бәрінің мұражайы.
Dialogue: 0,0:29:08.12,0:29:09.33,Default,,0,0,0,,Күрсін
Dialogue: 0,0:29:09.87,0:29:12.29,Default,,0,0,0,,(Зімбірдің дауысы)
Dialogue: 0,0:29:12.41,0:29:15.42,Default,,0,0,0,,Эй, Курт ше? Қайда бардың?
Dialogue: 0,0:29:15.54,0:29:18.13,Default,,0,0,0,,Әй, бәрі сарайда.
Dialogue: 0,0:29:18.67,0:29:20.04,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:29:20.13,0:29:21.38,Default,,0,0,0,,Әй... (Нобита) А, мынау.
Dialogue: 0,0:29:21.50,0:29:23.80,Default,,0,0,0,,Әуе қарындаш! Сәлем
Dialogue: 0,0:29:23.88,0:29:27.89,Default,,0,0,0,,А, Курт? Шай уақыты келді, не істеуіміз керек?
Dialogue: 0,0:29:28.01,0:29:29.68,Default,,0,0,0,,Әрине барамын, күте тұрыңыз.
Dialogue: 0,0:29:29.80,0:29:31.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:29:31.43,0:29:32.68,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:29:32.81,0:29:34.48,Default,,0,0,0,,Уау
Dialogue: 0,0:29:34.60,0:29:36.23,Default,,0,0,0,,Ах... барлығы (бәрі) Иә?
Dialogue: 0,0:29:36.35,0:29:38.77,Default,,0,0,0,,Мен бір сәт ваннаға барамын.
Dialogue: 0,0:29:38.90,0:29:40.73,Default,,0,0,0,,Осы сарайдың ішінде ойнау
Dialogue: 0,0:29:40.86,0:29:42.03,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:29:42.15,0:29:43.82,Default,,0,0,0,,Ей, ана жаққа барайық.
Dialogue: 0,0:29:53.62,0:29:56.75,Default,,0,0,0,,«Бұдан былай Райт Холлға кіруге болмайды»?
Dialogue: 0,0:29:57.04,0:29:58.71,Default,,0,0,0,,Жарық залы дегеніміз не?
Dialogue: 0,0:29:58.83,0:30:02.17,Default,,0,0,0,,Үлкен шамды DX ұрлады.
Dialogue: 0,0:30:02.30,0:30:03.88,Default,,0,0,0,,Йоккорасе (барлығы) Уау!
Dialogue: 0,0:30:04.01,0:30:07.38,Default,,0,0,0,,Нува! Не? Не? Сен кімсің?
Dialogue: 0,0:30:07.51,0:30:11.22,Default,,0,0,0,,Ағай, жоқ, мұнда кіруге болмайды.
Dialogue: 0,0:30:11.35,0:30:13.56,Default,,0,0,0,,Ха... Идиот! (Нобита) Хмм?
Dialogue: 0,0:30:13.68,0:30:15.52,Default,,0,0,0,,Мен полиция қызметкерімін.
Dialogue: 0,0:30:15.64,0:30:17.27,Default,,0,0,0,,О, детектив?
Dialogue: 0,0:30:17.73,0:30:21.23,Default,,0,0,0,,Иә, бұл инспектор қыша.
Dialogue: 0,0:30:30.20,0:30:32.53,Default,,0,0,0,,Ууууууууууууууууууууууу
Dialogue: 0,0:30:36.79,0:30:38.46,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:30:39.21,0:30:40.96,Default,,0,0,0,,Ахххххх...
Dialogue: 0,0:30:41.08,0:30:42.71,Default,,0,0,0,,Ааа! Кешіріңіз кешіріңіз
Dialogue: 0,0:30:42.84,0:30:44.25,Default,,0,0,0,,Қайтадан орындау
Dialogue: 0,0:30:44.38,0:30:48.68,Default,,0,0,0,,Дәлірек айтсақ, доктор, мына есікті сыртқа ашатын етіп өзгертейік.
Dialogue: 0,0:30:48.80,0:30:51.43,Default,,0,0,0,,О! сен сондай ақылдысың
Dialogue: 0,0:30:51.89,0:30:54.60,Default,,0,0,0,,Не? DX қоңырау соғады ма?
Dialogue: 0,0:30:54.85,0:30:57.89,Default,,0,0,0,,Қызықты. Бұл рас па?
Dialogue: 0,0:30:58.02,0:31:01.81,Default,,0,0,0,,Бұл рас! DX туралы ақпарат алу үшін-
Dialogue: 0,0:31:01.94,0:31:03.77,Default,,0,0,0,,Мен осы мұражайға келдім.
Dialogue: 0,0:31:03.90,0:31:06.53,Default,,0,0,0,,Егер бірдеңе тапсаңыз, маған хабарлаңыз.
Dialogue: 0,0:31:06.65,0:31:08.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:08.44,0:31:10.36,Default,,0,0,0,,Маған айта аласыз...
Dialogue: 0,0:31:10.49,0:31:12.95,Default,,0,0,0,,Мен оның DX-ке қатысы бар-жоғын білмеймін.
Dialogue: 0,0:31:13.07,0:31:13.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:14.16,0:31:17.70,Default,,0,0,0,,Шындығында, мұражай қызметкерлерімен сұхбатында...
Dialogue: 0,0:31:17.83,0:31:20.29,Default,,0,0,0,,Мен біртүрлі өсек естідім.
Dialogue: 0,0:31:20.42,0:31:21.42,Default,,0,0,0,,Әрине, бірге барайық.
Dialogue: 0,0:31:21.54,0:31:23.96,Default,,0,0,0,,Хмм, бұл мұражайда...
Dialogue: 0,0:31:24.09,0:31:25.71,Default,,0,0,0,,Онда құбыжық тұрады...
Dialogue: 0,0:31:25.84,0:31:30.13,Default,,0,0,0,,Ол адам әртүрлі заттарды ұрлайды.
Dialogue: 0,0:31:30.26,0:31:32.59,Default,,0,0,0,,Құбыжық? Бұл елес ұры емес пе?
Dialogue: 0,0:31:33.18,0:31:36.51,Default,,0,0,0,,Ұлпалар, т.б. (әйел) Түскі асқа алған салатым.
Dialogue: 0,0:31:36.64,0:31:41.23,Default,,0,0,0,,Алынған нәрсе маңызды емес еді, бірақ қорқынышты болды.
Dialogue: 0,0:31:41.35,0:31:42.31,Default,,0,0,0,,Эй?
Dialogue: 0,0:31:42.40,0:31:45.19,Default,,0,0,0,,Әлгі құбыжық картоп алса да, кішкентай болмас еді! Сөз тіркесі!
Dialogue: 0,0:31:45.65,0:31:49.49,Default,,0,0,0,,Ойлап қарасам, бөлмедегі шай мен қант...
Dialogue: 0,0:31:49.61,0:31:51.91,Default,,0,0,0,,Мен анда-санда азайып бара жатқандай сезінемін ...
Dialogue: 0,0:31:52.20,0:31:55.78,Default,,0,0,0,,Түн ортасында патрульдеу кезінде бір дауыс естідім.
Dialogue: 0,0:31:55.91,0:31:57.62,Default,,0,0,0,,Бұл адамның дауысы еді.
Dialogue: 0,0:31:57.91,0:32:00.37,Default,,0,0,0,,Ешкім болмауы керек табиғат залынан...
Dialogue: 0,0:32:00.50,0:32:04.46,Default,,0,0,0,,«Бұл да басқа, бұл да басқа»
Dialogue: 0,0:32:04.58,0:32:06.79,Default,,0,0,0,,Есікті ашқанда...
Dialogue: 0,0:32:06.92,0:32:10.42,Default,,0,0,0,,Ешкім! (Әйелдердің айқайы)
Dialogue: 0,0:32:10.55,0:32:16.18,Default,,0,0,0,,Біз бұл адамның DX-тің өзі ме, әлде оның еш қатысы жоқ па екенін зерттеп жатырмыз.
Dialogue: 0,0:32:16.64,0:32:21.48,Default,,0,0,0,,Бұл мұражай туралы бірдеңе бар...
Dialogue: 0,0:32:21.60,0:32:24.69,Default,,0,0,0,,Біртүрлі иіс бар.
Dialogue: 0,0:32:25.81,0:32:27.65,Default,,0,0,0,,Сіз де жазаланбайсыз.
Dialogue: 0,0:32:27.77,0:32:31.32,Default,,0,0,0,,Егер сіз әлсіреп жатқанда ұсталсаңыз, директор сізге тағы ұрысады.
Dialogue: 0,0:32:31.74,0:32:35.03,Default,,0,0,0,,Уайымдама, мен саған біраз қалдырамын...
Dialogue: 0,0:32:35.16,0:32:37.16,Default,,0,0,0,,Сәлем! (Пеплар) Болды... Мен істеймін.
Dialogue: 0,0:32:37.49,0:32:41.16,Default,,0,0,0,,Өйткені мен оны зімбірмен жегім келеді.
Dialogue: 0,0:32:41.37,0:32:42.54,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:32:42.66,0:32:44.33,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:32:44.46,0:32:45.79,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:32:45.92,0:32:47.84,Default,,0,0,0,,Эмилияны құтқарғың келеді деп айтқан жоқсың.
Dialogue: 0,0:32:50.05,0:32:52.59,Default,,0,0,0,,Дәмді! (Зімбір) Дұрыс па? Дұрыс па?
Dialogue: 0,0:32:52.72,0:32:57.01,Default,,0,0,0,,Осындай тапшы ингредиенттерден соншалықты дәмді нәрсені қалай жасауға болады?
Dialogue: 0,0:32:57.14,0:32:59.22,Default,,0,0,0,,Зімбір – данышпан
Dialogue: 0,0:32:59.31,0:33:00.39,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:33:00.52,0:33:02.43,Default,,0,0,0,,Сонда да кең.
Dialogue: 0,0:33:02.73,0:33:03.94,Default,,0,0,0,,Иётто
Dialogue: 0,0:33:04.06,0:33:05.48,Default,,0,0,0,,Кел, Сунео! (Сунео) Иә!
Dialogue: 0,0:33:05.94,0:33:08.94,Default,,0,0,0,,Қабырғаның қаншалықты алыс екенін барып көрейік.
Dialogue: 0,0:33:09.02,0:33:11.90,Default,,0,0,0,,Оның кеңдігі сонша, шетіне дейін баруға мүмкіндік жоқ.
Dialogue: 0,0:33:11.99,0:33:14.86,Default,,0,0,0,,(Джан мен Сунеоның күлкісі)
Dialogue: 0,0:33:15.45,0:33:17.16,Default,,0,0,0,,Уау (Сунео) Ахахха!
Dialogue: 0,0:33:17.28,0:33:20.87,Default,,0,0,0,,О... О, не... Иә!
Dialogue: 0,0:33:21.49,0:33:23.87,Default,,0,0,0,,Сонымен... үлкен адам бар!
Dialogue: 0,0:33:24.21,0:33:25.58,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:33:25.71,0:33:28.29,Default,,0,0,0,,Біз кішірейіп бара жатырмыз!
Dialogue: 0,0:33:28.58,0:33:32.26,Default,,0,0,0,,Келесі тексеру - Гулливер туннелі Марк II (екі)
Dialogue: 0,0:33:32.38,0:33:34.26,Default,,0,0,0,,Бұл мені кішкентай етті!
Dialogue: 0,0:33:34.55,0:33:36.72,Default,,0,0,0,,Каругару қолғаптарын кию
Dialogue: 0,0:33:36.80,0:33:38.97,Default,,0,0,0,,Сеено... (Жұмысшылар) Е, иә...
Dialogue: 0,0:33:39.10,0:33:41.18,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:33:41.47,0:33:44.39,Default,,0,0,0,,Міне, кішкентай болып қалатын адам!
Dialogue: 0,0:33:44.48,0:33:46.56,Default,,0,0,0,,Назар аударыңыз Сәлем!
Dialogue: 0,0:33:46.69,0:33:48.10,Default,,0,0,0,,О, а, а...
Dialogue: 0,0:33:48.19,0:33:51.15,Default,,0,0,0,,А... күте тұрыңыз...
Dialogue: 0,0:33:51.65,0:33:54.74,Default,,0,0,0,,Мен не істеуім керек? Мен қайтып бара алмаймын.
Dialogue: 0,0:33:54.86,0:33:58.36,Default,,0,0,0,,Әзірге бәрімізге оралайық!
Dialogue: 0,0:33:58.49,0:34:00.32,Default,,0,0,0,,Неліктен бұлай болады!
Dialogue: 0,0:34:00.62,0:34:02.70,Default,,0,0,0,,О, бәрің тыңдаңдар.
Dialogue: 0,0:34:04.16,0:34:07.54,Default,,0,0,0,,Үшеуміз үйдегі қаржыны қысқартып, күн көреміз деп аянбай еңбек еттік.
Dialogue: 0,0:34:07.67,0:34:11.42,Default,,0,0,0,,Пеплер металл өндіретін машина, ақырында...
Dialogue: 0,0:34:11.54,0:34:13.38,Default,,0,0,0,,Аяқтауға жақын!
Dialogue: 0,0:34:13.46,0:34:16.59,Default,,0,0,0,,Уау! Дон Дон Дон Дон Пафф!
Dialogue: 0,0:34:16.72,0:34:18.63,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:34:18.76,0:34:19.68,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:34:19.80,0:34:23.10,Default,,0,0,0,,Бұл аяқталғаннан кейін біз ақырында...
Dialogue: 0,0:34:23.22,0:34:25.81,Default,,0,0,0,,Металл металын жасауға болады.
Dialogue: 0,0:34:25.89,0:34:27.77,Default,,0,0,0,,Доктор Пеплер…
Dialogue: 0,0:34:27.89,0:34:32.98,Default,,0,0,0,,Доктор Хартман жасаған толық металл, әрине, тамаша металл.
Dialogue: 0,0:34:33.40,0:34:36.40,Default,,0,0,0,,Бірақ толық металдың көзі болып табылатын металл ...
Dialogue: 0,0:34:36.53,0:34:39.32,Default,,0,0,0,,Жер бетінде олардың саны азайып барады.
Dialogue: 0,0:34:39.45,0:34:41.82,Default,,0,0,0,,Ақырында, сіз тіпті құпия құралдарды жасай аласыз.
Dialogue: 0,0:34:41.95,0:34:43.49,Default,,0,0,0,,Бұл мүмкін болмайды
Dialogue: 0,0:34:43.83,0:34:46.37,Default,,0,0,0,,Бірақ! Егер сізде бұл машина болса ...
Dialogue: 0,0:34:46.50,0:34:50.21,Default,,0,0,0,,Темір болсын, алюминий болсын, тіпті толық металл...
Dialogue: 0,0:34:50.33,0:34:53.80,Default,,0,0,0,,Кез келген затты металға айналдыруға болады дейді.
Dialogue: 0,0:34:53.92,0:34:56.76,Default,,0,0,0,,Бұл керемет машина!
Dialogue: 0,0:34:56.88,0:34:59.43,Default,,0,0,0,,Уау! Паф!
Dialogue: 0,0:34:59.80,0:35:02.76,Default,,0,0,0,,Сонда сізге енді ресурстар туралы алаңдамайсыз...
Dialogue: 0,0:35:02.89,0:35:05.39,Default,,0,0,0,,Құпия құралдар дами береді.
Dialogue: 0,0:35:05.52,0:35:08.94,Default,,0,0,0,,Иә! Ал бұл данышпанның аты...
Dialogue: 0,0:35:09.06,0:35:11.35,Default,,0,0,0,,Тарихта мәңгі қалады
Dialogue: 0,0:35:11.48,0:35:12.36,Default,,0,0,0,,Хахаха
Dialogue: 0,0:35:12.48,0:35:15.94,Default,,0,0,0,,Ештеңе қалмады, одан да жаман.
Dialogue: 0,0:35:16.44,0:35:19.03,Default,,0,0,0,,Қоңырау... Қоңырау... Қоңырау
Dialogue: 0,0:35:19.40,0:35:20.57,Default,,0,0,0,,Жааан!
Dialogue: 0,0:35:20.70,0:35:22.49,Default,,0,0,0,,Сунео-сан!
Dialogue: 0,0:35:22.62,0:35:25.28,Default,,0,0,0,,Таратқыш бар, олай емес.
Dialogue: 0,0:35:25.95,0:35:28.96,Default,,0,0,0,,Уау! (Сунео) Ух... Иттеттете...
Dialogue: 0,0:35:29.08,0:35:30.83,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:35:31.33,0:35:33.29,Default,,0,0,0,,Мен жат жерде қалдым.
Dialogue: 0,0:35:33.42,0:35:36.50,Default,,0,0,0,,Мен тазалаймын, тазалаймын
Dialogue: 0,0:35:36.63,0:35:39.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:39.51,0:35:42.26,Default,,0,0,0,,Мен тазалаймын Мен тазалаймын
Dialogue: 0,0:35:42.47,0:35:44.35,Default,,0,0,0,,Уау! Уф! Мен!
Dialogue: 0,0:35:44.60,0:35:45.85,Default,,0,0,0,,Мен тазалаймын
Dialogue: 0,0:35:45.93,0:35:48.98,Default,,0,0,0,,Бұл тұйыққа тірелді!
Dialogue: 0,0:35:50.98,0:35:53.52,Default,,0,0,0,,Мен тазалаймын, тазалаймын
Dialogue: 0,0:35:54.02,0:35:56.57,Default,,0,0,0,,Итата... Та... Мен құтқарылдым.
Dialogue: 0,0:35:56.69,0:36:00.15,Default,,0,0,0,,Ауыр! Бұл жерден тез кет! қазірдің өзінде!
Dialogue: 0,0:36:00.95,0:36:04.12,Default,,0,0,0,,Уф... Мен тағы да бейтаныс жерге тап болдым.
Dialogue: 0,0:36:04.82,0:36:06.83,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,0:36:06.95,0:36:09.08,Default,,0,0,0,,Джан, тез кетейік.
Dialogue: 0,0:36:09.87,0:36:12.08,Default,,0,0,0,,Уау... О, жоқ...
Dialogue: 0,0:36:12.21,0:36:13.04,Default,,0,0,0,,Уахя
Dialogue: 0,0:36:15.38,0:36:20.30,Default,,0,0,0,,Сонымен... Сонымен... Сонымен... Бұл шықты!
Dialogue: 0,0:36:20.76,0:36:22.18,Default,,0,0,0,,Жааан!
Dialogue: 0,0:36:22.30,0:36:25.68,Default,,0,0,0,,Эй, оның орнына Сузуды іздейік.
Dialogue: 0,0:36:25.80,0:36:26.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:28.47,0:36:29.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:36:29.85,0:36:32.14,Default,,0,0,0,,А, бірдеңе жарқырап кетті!
Dialogue: 0,0:36:33.31,0:36:34.85,Default,,0,0,0,,Не? Сіз таптыңыз ба?
Dialogue: 0,0:36:34.98,0:36:37.61,Default,,0,0,0,,Білмеймін, бірақ бірдеңе болып жатқан сияқты.
Dialogue: 0,0:36:39.19,0:36:41.78,Default,,0,0,0,,Ооо... Хмм! Сонымен... мен оған көмектесе алмаймын!
Dialogue: 0,0:36:41.90,0:36:43.82,Default,,0,0,0,,Иә? Мм...мияу
Dialogue: 0,0:36:43.95,0:36:45.91,Default,,0,0,0,,Мияу мияу! мияу!
Dialogue: 0,0:36:46.03,0:36:49.08,Default,,0,0,0,,Жақсы, жақсы, ммм!
Dialogue: 0,0:36:49.29,0:36:52.00,Default,,0,0,0,,Уау! Мен қолымды аламын. Мен оны аламын.
Dialogue: 0,0:36:53.29,0:36:56.63,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:36:57.13,0:36:59.75,Default,,0,0,0,,Ей Зімбір, менің сүтім бітті.
Dialogue: 0,0:36:59.88,0:37:02.97,Default,,0,0,0,,Иә? Енді мен ештеңе істей алмаймын
Dialogue: 0,0:37:03.26,0:37:04.34,Default,,0,0,0,,Күте тұрыңыз, мен сізге алып беремін.
Dialogue: 0,0:37:04.34,0:37:05.43,Default,,0,0,0,,Күте тұрыңыз, мен сізге алып беремін.
Dialogue: 0,0:37:04.34,0:37:05.43,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:37:05.51,0:37:06.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:07.05,0:37:09.26,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,0:37:09.47,0:37:11.22,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,0:37:11.35,0:37:12.48,Default,,0,0,0,,Dowa! Уф
Dialogue: 0,0:37:13.10,0:37:14.89,Default,,0,0,0,,Ух...тат...
Dialogue: 0,0:37:15.02,0:37:16.44,Default,,0,0,0,,Қайда? Бұл жерде жақсы ма?
Dialogue: 0,0:37:17.90,0:37:18.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:18.86,0:37:20.27,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:37:22.03,0:37:24.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:25.03,0:37:27.95,Default,,0,0,0,,Сәлем Курт! Сіздің клиенттеріңіз жертөлеге келеді!
Dialogue: 0,0:37:29.58,0:37:32.12,Default,,0,0,0,,Уау! ? иә!
Dialogue: 0,0:37:32.20,0:37:35.33,Default,,0,0,0,,Уау! Ей... бәрі бөтен жерде!
Dialogue: 0,0:37:35.41,0:37:36.92,Default,,0,0,0,,Уф... (Зімбір) Бұл жақсы емес!
Dialogue: 0,0:37:37.04,0:37:38.83,Default,,0,0,0,,Мына жерде! Уф...
Dialogue: 0,0:37:39.17,0:37:40.54,Default,,0,0,0,,Шынында да, мұздату шабуылын тойтарудың жалғыз жолы осы…
Dialogue: 0,0:37:40.67,0:37:43.46,Default,,0,0,0,,Бұл мұражайдағы құбыжық болуы мүмкін бе?
Dialogue: 0,0:37:43.59,0:37:45.84,Default,,0,0,0,,Әйтеуір... (Нобита) Қыз болды ма?
Dialogue: 0,0:37:45.97,0:37:47.80,Default,,0,0,0,,(шу)
Dialogue: 0,0:37:47.93,0:37:49.51,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:37:51.06,0:37:55.81,Default,,0,0,0,,Бұрынғы костюмдегі, бұл мұражайдағы құбыжық болуы мүмкін бе?
Dialogue: 0,0:37:56.02,0:37:59.90,Default,,0,0,0,,Құбыжық? Бұл Кайто DX болуы мүмкін.
Dialogue: 0,0:38:00.02,0:38:02.48,Default,,0,0,0,,Немесе олар бір адам шығар.
Dialogue: 0,0:38:02.61,0:38:03.44,Default,,0,0,0,,Тыныш
Dialogue: 0,0:38:03.73,0:38:05.61,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:38:06.28,0:38:07.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:07.57,0:38:10.91,Default,,0,0,0,,Фуфуфуфу… Фуфуфу…
Dialogue: 0,0:38:11.03,0:38:12.62,Default,,0,0,0,,Бар
Dialogue: 0,0:38:13.29,0:38:18.17,Default,,0,0,0,,Тағы төрт... Тағы төрт, хехехе
Dialogue: 0,0:38:18.29,0:38:22.59,Default,,0,0,0,,Ух... аа... фуго...
Dialogue: 0,0:38:22.71,0:38:26.34,Default,,0,0,0,,Ух... ха... ха... (Сунео) А... Ах, Джан!
Dialogue: 0,0:38:26.42,0:38:28.30,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:38:28.97,0:38:30.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:33.10,0:38:35.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:35.47,0:38:38.89,Default,,0,0,0,,Мұндай жерде шынымен де Хамон мұғалімі бар ма?
Dialogue: 0,0:38:40.60,0:38:42.40,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:38:42.86,0:38:45.36,Default,,0,0,0,,Бұл кім? Онда біреу бар ма?
Dialogue: 0,0:38:47.45,0:38:48.53,Default,,0,0,0,,Немесе мен мәңгі осы жерде қалсам, ол мазалайды деп отырсың ба?
Dialogue: 0,0:38:48.99,0:38:51.28,Default,,0,0,0,,(егеуқұйрықтың дыбысына еліктеу)
Dialogue: 0,0:38:51.41,0:38:54.20,Default,,0,0,0,,А... Бұл не, егеуқұйрық?
Dialogue: 0,0:38:54.70,0:38:56.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:56.83,0:38:58.33,Default,,0,0,0,,Уау! (2 адам) Уау!
Dialogue: 0,0:38:58.79,0:38:59.87,Default,,0,0,0,,Не, не?
Dialogue: 0,0:39:00.00,0:39:01.79,Default,,0,0,0,,Дабыл қаққан сияқты.
Dialogue: 0,0:39:02.71,0:39:06.51,Default,,0,0,0,,Не... не! ? Жер астында зиянкес бар ма? Ахх
Dialogue: 0,0:39:06.84,0:39:08.34,Default,,0,0,0,,Не... не істеуім керек, Дораемон?
Dialogue: 0,0:39:08.47,0:39:09.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:10.59,0:39:13.68,Default,,0,0,0,,Сен мұнда не істеп жүрсің! Мұнда кіруге тыйым салынады!
Dialogue: 0,0:39:13.97,0:39:15.51,Default,,0,0,0,,Директор Фикс!
Dialogue: 0,0:39:15.64,0:39:17.14,Default,,0,0,0,,Сіз...
Dialogue: 0,0:39:18.27,0:39:19.89,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:39:20.14,0:39:21.52,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:39:21.65,0:39:24.61,Default,,0,0,0,,Кешіріңіз, директор, мен адасып қалдым.
Dialogue: 0,0:39:24.86,0:39:26.82,Default,,0,0,0,,Куртқа не болды?
Dialogue: 0,0:39:27.19,0:39:29.78,Default,,0,0,0,,Сіз қайтадан әлсіреп жатырсыз ба?
Dialogue: 0,0:39:29.86,0:39:33.95,Default,,0,0,0,,Бұл не, директор? Бұл машина
Dialogue: 0,0:39:34.08,0:39:35.24,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:39:35.74,0:39:39.46,Default,,0,0,0,,Бұл күннің өмірін жаңғырту құралы.
Dialogue: 0,0:39:39.58,0:39:42.04,Default,,0,0,0,,Күн энергиясын өндіретін машинаның прототипі
Dialogue: 0,0:39:42.17,0:39:44.04,Default,,0,0,0,,Күн шығаратын машина?
Dialogue: 0,0:39:44.17,0:39:46.75,Default,,0,0,0,,Барлық жерде есікті жасаған доктор Хартманмен...
Dialogue: 0,0:39:46.88,0:39:49.72,Default,,0,0,0,,Оның бірлескен зерттеушісі доктор Пеплер...
Dialogue: 0,0:39:49.84,0:39:52.39,Default,,0,0,0,,Біз мұны бірге әзірледік.
Dialogue: 0,0:39:52.80,0:39:56.10,Default,,0,0,0,,Бірақ оның дамуы барысында доктор Пеплер...
Dialogue: 0,0:39:56.22,0:39:59.43,Default,,0,0,0,,Мен өрескел қателік жібердім.
Dialogue: 0,0:39:59.56,0:40:01.77,Default,,0,0,0,,Хартман мырза, сіз кофе ішкіңіз келе ме?
Dialogue: 0,0:40:01.89,0:40:03.90,Default,,0,0,0,,А, рахмет (Пеплар) Иә.
Dialogue: 0,0:40:04.94,0:40:06.07,Default,,0,0,0,,Бұл жүйкеңе тиіп тұр ма? Егер ашуланатын батылың болса, ашулан да.
Dialogue: 0,0:40:07.61,0:40:12.32,Default,,0,0,0,,Доктор Пеплердің үлкен қателігінен жасанды күн бақылаудан шыға бастады.
Dialogue: 0,0:40:12.45,0:40:15.66,Default,,0,0,0,,Жоқ, мен енді уақыт осін басқара алмаймын.
Dialogue: 0,0:40:15.78,0:40:17.91,Default,,0,0,0,,Осылай жалғаса берсе, қызыл алып жұлдызға айналады...
Dialogue: 0,0:40:18.04,0:40:21.16,Default,,0,0,0,,Ғылыми-зерттеу институты ғана емес, тіпті бұл арал да еріп кетеді!
Dialogue: 0,0:40:21.29,0:40:22.87,Default,,0,0,0,,Аһ... Ах!
Dialogue: 0,0:40:24.67,0:40:26.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:26.50,0:40:30.46,Default,,0,0,0,,Бақытымызға орай, доктор Гартманның емінің арқасында күн гигантқа айналды.
Dialogue: 0,0:40:30.59,0:40:34.97,Default,,0,0,0,,Біз ілгерілеуді уақытша болса да тоқтата алдық.
Dialogue: 0,0:40:35.09,0:40:38.51,Default,,0,0,0,,Алайда оқиғаның артында кінәлі болған доктор Пеплер...
Dialogue: 0,0:40:38.64,0:40:41.02,Default,,0,0,0,,Оның құрал жасаушы лицензиясынан айырылды.
Dialogue: 0,0:40:41.23,0:40:41.68,Default,,0,0,0,,Маған бұл аралда өмір бойына тыйым салынды.
Dialogue: 0,0:40:41.68,0:40:44.56,Default,,0,0,0,,Маған бұл аралда өмір бойына тыйым салынды.
Dialogue: 0,0:40:41.68,0:40:44.56,Default,,0,0,0,,Пеплер мырза, өтінемін, кетпеңіз!
Dialogue: 0,0:40:44.56,0:40:44.69,Default,,0,0,0,,Маған бұл аралда өмір бойына тыйым салынды.
Dialogue: 0,0:40:44.69,0:40:45.15,Default,,0,0,0,,Маған бұл аралда өмір бойына тыйым салынды.
Dialogue: 0,0:40:44.69,0:40:45.15,Default,,0,0,0,,Пеплар!
Dialogue: 0,0:40:45.15,0:40:46.48,Default,,0,0,0,,Пеплер!
Dialogue: 0,0:40:46.86,0:40:49.07,Default,,0,0,0,,Содан кейін доктор Хартман...
Dialogue: 0,0:40:49.19,0:40:52.78,Default,,0,0,0,,―
Dialogue: 0,0:40:52.90,0:40:57.83,Default,,0,0,0,,Біз оны зерттеп, жетілдірдік және Full Metal әзірледік.
Dialogue: 0,0:40:58.24,0:41:02.58,Default,,0,0,0,,Ол сол толық металмен тамаша блок жүйесін жасады.
Dialogue: 0,0:41:02.71,0:41:07.67,Default,,0,0,0,,...
Dialogue: 0,0:41:08.54,0:41:09.80,Default,,0,0,0,,Толық металл болғандықтан...
Dialogue: 0,0:41:09.92,0:41:12.63,Default,,0,0,0,,―
Dialogue: 0,0:41:12.76,0:41:18.39,Default,,0,0,0,,々
Dialogue: 0,0:41:18.76,0:41:19.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:19.76,0:41:22.85,Default,,0,0,0,,...
Dialogue: 0,0:41:22.98,0:41:26.06,Default,,0,0,0,,…
Dialogue: 0,0:41:28.73,0:41:30.94,Default,,0,0,0,,Хмм... А, суық тиіп қалдың ба?
Dialogue: 0,0:41:31.07,0:41:33.03,Default,,0,0,0,,Әйтеуір суық тимеймін
Dialogue: 0,0:41:33.15,0:41:34.28,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:41:34.78,0:41:35.74,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:41:36.11,0:41:39.49,Default,,0,0,0,,Тұтынушыларды жалғыз қалдырған кезде қайда бардыңыз?
Dialogue: 0,0:41:39.62,0:41:42.70,Default,,0,0,0,,…  …
Dialogue: 0,0:41:42.79,0:41:43.00,Default,,0,0,0,,А... иә?
Dialogue: 0,0:41:43.00,0:41:45.92,Default,,0,0,0,,А... иә?
Dialogue: 0,0:41:43.00,0:41:45.92,Default,,0,0,0,,…
Dialogue: 0,0:41:46.17,0:41:47.58,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:41:47.71,0:41:49.92,Default,,0,0,0,,А, мен шықтым.
Dialogue: 0,0:41:50.71,0:41:52.30,Default,,0,0,0,,...
Dialogue: 0,0:41:52.42,0:41:53.96,Default,,0,0,0,,О, бәріңе!
Dialogue: 0,0:41:54.09,0:41:56.68,Default,,0,0,0,,Не болды? Мен сондай кішкентай болып қалдым
Dialogue: 0,0:41:57.05,0:41:59.43,Default,,0,0,0,,…  …
Dialogue: 0,0:41:59.55,0:42:03.10,Default,,0,0,0,,…
Dialogue: 0,0:42:03.22,0:42:04.89,Default,,0,0,0,,Этюдтарымыз да бар! Қателікке орын жоқ!—
Dialogue: 0,0:42:05.02,0:42:06.60,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:06.89,0:42:09.27,Default,,0,0,0,,Ах, у... бұл...
Dialogue: 0,0:42:09.61,0:42:13.82,Default,,0,0,0,,А, менің ойымша, ол Гулливердің туннеліне кірді.
Dialogue: 0,0:42:13.94,0:42:16.70,Default,,0,0,0,,Өкінішке орай, мен оны кезекті тексеруге жібердім...
Dialogue: 0,0:42:16.82,0:42:18.78,Default,,0,0,0,,Мен біраз уақыт оралмаймын.
Dialogue: 0,0:42:18.91,0:42:21.41,Default,,0,0,0,,...
Dialogue: 0,0:42:21.53,0:42:23.79,Default,,0,0,0,,…
Dialogue: 0,0:42:24.83,0:42:28.08,Default,,0,0,0,,...
Dialogue: 0,0:42:28.58,0:42:31.54,Default,,0,0,0,,Уф, жоқ, мұнда жұмсақ қабығы бар тасбақа роботы тұрады.
Dialogue: 0,0:42:31.67,0:42:33.75,Default,,0,0,0,,Мен қалтамды пайдалана алмаймын.
Dialogue: 0,0:42:33.88,0:42:34.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:34.80,0:42:37.30,Default,,0,0,0,,...
Dialogue: 0,0:42:37.63,0:42:40.93,Default,,0,0,0,,―
Dialogue: 0,0:42:41.05,0:42:42.76,Default,,0,0,0,,Дораэмон Жоқ, жоқ!
Dialogue: 0,0:42:42.85,0:42:44.22,Default,,0,0,0,,Тохохо…
Dialogue: 0,0:42:44.35,0:42:46.56,Default,,0,0,0,,Көңіліңді көтер, Дораемон
Dialogue: 0,0:42:46.68,0:42:50.52,Default,,0,0,0,,―
Dialogue: 0,0:42:50.65,0:42:53.32,Default,,0,0,0,,...
Dialogue: 0,0:42:53.44,0:42:55.99,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:42:56.07,0:42:57.61,Default,,0,0,0,,(Жабылатын музыка)
Dialogue: 0,0:42:57.74,0:43:00.07,Default,,0,0,0,,Аа, жабылатын уақыт.
Dialogue: 0,0:43:00.20,0:43:03.45,Default,,0,0,0,,Иә? Бірақ менің қоңырауым әлі сол жерде...
Dialogue: 0,0:43:03.58,0:43:08.00,Default,,0,0,0,,Аа, қоңыраулар туралы айтсам, мен мұражайдың қауіпсіздік жүйесіне қарадым.
Dialogue: 0,0:43:08.12,0:43:09.08,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:43:09.21,0:43:11.29,Default,,0,0,0,,Қалыпты ештеңе болған жоқ.
Dialogue: 0,0:43:11.42,0:43:12.42,Default,,0,0,0,,Бұл...
Dialogue: 0,0:43:12.54,0:43:16.38,Default,,0,0,0,,Бірақ бұл жүйе оны анықтамауы үшін DX туралы.
Dialogue: 0,0:43:16.46,0:43:19.51,Default,,0,0,0,,Мүмкін бұл қандай да бір манипуляция шығар.
Dialogue: 0,0:43:20.13,0:43:23.93,Default,,0,0,0,,Қалай болғанда да, ол қазір жабық. Ертең тағы келіңізші.
Dialogue: 0,0:43:24.05,0:43:26.18,Default,,0,0,0,,А, мен үйге баруым керек.
Dialogue: 0,0:43:26.31,0:43:27.52,Default,,0,0,0,,Менің де үй тапсырмасы бар.
Dialogue: 0,0:43:27.64,0:43:30.98,Default,,0,0,0,,Жоқ, жоқ! Қоңырауды таппайынша үйге бармаймын!
Dialogue: 0,0:43:31.40,0:43:36.98,Default,,0,0,0,,Жарайды. Сол шақырумен оралсаңыз, кеткен уақытқа оралуға болады.
Dialogue: 0,0:43:37.11,0:43:38.69,Default,,0,0,0,,Шынымен бе? (Қызық) Иә.
Dialogue: 0,0:43:39.32,0:43:41.86,Default,,0,0,0,,Сонда сіз қалағаныңызша қанша күн ойнай аласыз!
Dialogue: 0,0:43:41.99,0:43:44.37,Default,,0,0,0,,Қоңырауды іздеу (Нобита) Хехе
Dialogue: 0,0:43:44.45,0:43:47.62,Default,,0,0,0,,(Курттың күлкісі)
Dialogue: 0,0:43:47.75,0:43:51.42,Default,,0,0,0,,А, мұражай қонақүйі толығымен брондалған.
Dialogue: 0,0:43:51.54,0:43:54.42,Default,,0,0,0,,Курт, маған сіздің үйіңізде қалуға рұқсат етіңіз.
Dialogue: 0,0:43:54.54,0:43:58.30,Default,,0,0,0,,Иә... о, жоқ, мен Джинжермен кешкі ас іштім...
Dialogue: 0,0:43:58.42,0:43:59.30,Default,,0,0,0,,Не?
Dialogue: 0,0:43:59.42,0:44:01.84,Default,,0,0,0,,О... жоқ, бұл ештеңе емес!
Dialogue: 0,0:44:01.93,0:44:04.85,Default,,0,0,0,,Хаха...
Dialogue: 0,0:44:06.93,0:44:08.85,Default,,0,0,0,,(айқай)
Dialogue: 0,0:44:09.18,0:44:11.52,Default,,0,0,0,,Әй, Құрукук!
Dialogue: 0,0:44:11.60,0:44:14.98,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:44:17.27,0:44:19.40,Default,,0,0,0,,Иә? Мұражайдағы құбыжық?
Dialogue: 0,0:44:19.53,0:44:20.94,Default,,0,0,0,,Иә, мен көрдім.
Dialogue: 0,0:44:21.07,0:44:22.24,Default,,0,0,0,,Оны біз де көрдік.
Dialogue: 0,0:44:22.36,0:44:24.37,Default,,0,0,0,,Қабырғада кенет есік пайда болды.
Dialogue: 0,0:44:24.49,0:44:25.95,Default,,0,0,0,,Бір қыз шықты
Dialogue: 0,0:44:26.08,0:44:26.95,Default,,0,0,0,,Саған тағы біраз көрсеткім келетін, бірақ…
Dialogue: 0,0:44:27.08,0:44:29.33,Default,,0,0,0,,Біздің көргеніміз костюм киген адам.
Dialogue: 0,0:44:29.45,0:44:32.46,Default,,0,0,0,,О (Нобита) Біз қыздар едік.
Dialogue: 0,0:44:32.54,0:44:35.54,Default,,0,0,0,,Ал... құбыжық жай ғана өсек.
Dialogue: 0,0:44:35.67,0:44:37.71,Default,,0,0,0,,Оны кімнен естіді? Мұндай нәрсе
Dialogue: 0,0:44:37.84,0:44:39.38,Default,,0,0,0,,Жоқ, мен оны міндетті түрде көрдім.
Dialogue: 0,0:44:39.51,0:44:42.72,Default,,0,0,0,,Хаха, адасып қалған басқа тұтынушы болуы керек.
Dialogue: 0,0:44:42.84,0:44:43.84,Default,,0,0,0,,Менің ойымша, солай ма?
Dialogue: 0,0:44:43.97,0:44:45.55,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:44:45.64,0:44:47.01,Default,,0,0,0,,Хахаха (Сунео) Хмм...
Dialogue: 0,0:44:47.14,0:44:50.22,Default,,0,0,0,,Сонда біз оны көрдік...
Dialogue: 0,0:44:50.35,0:44:52.14,Default,,0,0,0,,Джан?
Dialogue: 0,0:44:52.27,0:44:55.27,Default,,0,0,0,,Директор туралы үндемеу жақсы.
Dialogue: 0,0:44:55.40,0:44:56.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:44:56.73,0:44:59.86,Default,,0,0,0,,Мен Курттың директорға қалай қосылғанын білмеймін...
Dialogue: 0,0:44:59.98,0:45:02.44,Default,,0,0,0,,Дос болсақ, бұл қауіпті емес пе еді?
Dialogue: 0,0:45:02.53,0:45:04.82,Default,,0,0,0,,А... Түсіндім... Түсіндім.
Dialogue: 0,0:45:04.95,0:45:06.74,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:45:06.82,0:45:10.33,Default,,0,0,0,,Жоқ, бәрібір, бұл мұражайда күдікті нәрсе бар.
Dialogue: 0,0:45:10.45,0:45:13.62,Default,,0,0,0,,Дұрыс... Менің ойымша.
Dialogue: 0,0:45:16.83,0:45:18.59,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:45:19.29,0:45:21.84,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:45:23.67,0:45:25.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:25.76,0:45:27.80,Default,,0,0,0,,Мұның бәрін Курт жасады ма?
Dialogue: 0,0:45:27.93,0:45:31.81,Default,,0,0,0,,Иә, олардың бәрі менің құралдарым, дүниеде жалғыз.
Dialogue: 0,0:45:32.43,0:45:35.94,Default,,0,0,0,,Бізді бастапқы өлшемімізге қайтаратын құрал жоқ па?
Dialogue: 0,0:45:36.02,0:45:39.27,Default,,0,0,0,,Хмм, меніңше...
Dialogue: 0,0:45:39.94,0:45:42.78,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:45:42.90,0:45:44.28,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:45:44.61,0:45:45.95,Default,,0,0,0,,Үлкен жарық?
Dialogue: 0,0:45:46.07,0:45:48.62,Default,,0,0,0,,өзгертілді...
Dialogue: 0,0:45:49.03,0:45:50.62,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:45:50.74,0:45:52.70,Default,,0,0,0,,Иә? Не? бұл!
Dialogue: 0,0:45:52.83,0:45:55.83,Default,,0,0,0,,Ооо... Ооо Айтата
Dialogue: 0,0:45:55.96,0:45:57.12,Default,,0,0,0,,Не...
Dialogue: 0,0:45:57.21,0:45:59.29,Default,,0,0,0,,Айтата... Уф...
Dialogue: 0,0:45:59.42,0:46:02.75,Default,,0,0,0,,А... Оғаштың ұлғайып бара жатқанын көріп таң қалдым.
Dialogue: 0,0:46:02.88,0:46:03.88,Default,,0,0,0,,Биккури жарығы
Dialogue: 0,0:46:04.01,0:46:05.63,Default,,0,0,0,,Зуко!
Dialogue: 0,0:46:06.26,0:46:07.59,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:46:07.68,0:46:10.51,Default,,0,0,0,,Хмм... кешіріңіз! Мен оны қазір шығарамын
Dialogue: 0,0:46:11.31,0:46:12.76,Default,,0,0,0,,Dowa!
Dialogue: 0,0:46:12.85,0:46:14.18,Default,,0,0,0,,Ух... (попонның айқайы)
Dialogue: 0,0:46:14.31,0:46:17.69,Default,,0,0,0,,Хаха, кел, Попон, қытық.
Dialogue: 0,0:46:17.77,0:46:20.31,Default,,0,0,0,,Эй хехехе ахахха
Dialogue: 0,0:46:20.44,0:46:23.61,Default,,0,0,0,,Попон, бүгін бізге қонақ келді.
Dialogue: 0,0:46:24.28,0:46:26.61,Default,,0,0,0,,Өте сүйкімді! Сенің атың Попон Чан ба?
Dialogue: 0,0:46:26.74,0:46:27.53,Default,,0,0,0,,(попон айқай)
Dialogue: 0,0:46:27.65,0:46:29.82,Default,,0,0,0,,Хехе, үнемі серпілу...
Dialogue: 0,0:46:29.95,0:46:32.37,Default,,0,0,0,,Менің артымнан кел, попон.
Dialogue: 0,0:46:33.04,0:46:34.37,Default,,0,0,0,,Өйткені сіз тым табандысыз.
Dialogue: 0,0:46:34.50,0:46:37.33,Default,,0,0,0,,Мен сыртқа шыққанда, мен оны сонда ойнауға рұқсат еттім...
Dialogue: 0,0:46:37.46,0:46:41.04,Default,,0,0,0,,Соған қарамастан мен кейде тайып тұрып, артыңыздан мұражайға дейін барамын.
Dialogue: 0,0:46:41.17,0:46:42.67,Default,,0,0,0,,Аха хахаха
Dialogue: 0,0:46:43.21,0:46:45.05,Default,,0,0,0,,Бұл баланы да Курт жасады ма?
Dialogue: 0,0:46:45.17,0:46:47.34,Default,,0,0,0,,Жақсы (Нобита) Керемет!
Dialogue: 0,0:46:47.76,0:46:50.34,Default,,0,0,0,,Мен арзан емес нәрсені жасап жатқаныма сене алар емеспін.
Dialogue: 0,0:46:50.43,0:46:52.55,Default,,0,0,0,,Ух... Иә, Эхехе
Dialogue: 0,0:46:52.64,0:46:54.56,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:46:54.68,0:46:56.73,Default,,0,0,0,,Тағы бір сәтсіздік!
Dialogue: 0,0:46:57.35,0:47:00.85,Default,,0,0,0,,Қазірдің өзінде! Бұл... Бұл... Бұл...
Dialogue: 0,0:47:00.98,0:47:03.02,Default,,0,0,0,,Құт, осылай!
Dialogue: 0,0:47:07.28,0:47:08.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:11.20,0:47:12.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:47:14.37,0:47:16.87,Default,,0,0,0,,(попон айқай)
Dialogue: 0,0:47:17.20,0:47:20.67,Default,,0,0,0,,А... Мен... Біртүрлі нәрсе болды.
Dialogue: 0,0:47:22.38,0:47:24.88,Default,,0,0,0,,Хахаха Ахаха!
Dialogue: 0,0:47:25.38,0:47:28.42,Default,,0,0,0,,Бұл балада да Full Metal деген нәрсе бар ма?
Dialogue: 0,0:47:28.55,0:47:33.47,Default,,0,0,0,,Жоқ, Толық металды тек лицензиясы бар шеберлер ғана пайдалана алады.
Dialogue: 0,0:47:33.60,0:47:36.43,Default,,0,0,0,,Сондықтан ол менің жинағымда жоқ.
Dialogue: 0,0:47:37.02,0:47:39.10,Default,,0,0,0,,Бұл не? Шаңсорғыш?
Dialogue: 0,0:47:39.23,0:47:41.35,Default,,0,0,0,,Иә Гипер шаңсорғыш
Dialogue: 0,0:47:41.48,0:47:44.69,Default,,0,0,0,,Ішінде бәрін сорып алатын шағын қара тесік бар.
Dialogue: 0,0:47:44.94,0:47:47.40,Default,,0,0,0,,Қара тесік? таңқаларлық!
Dialogue: 0,0:47:47.53,0:47:50.40,Default,,0,0,0,,Жоқ, бұл тым күшті...
Dialogue: 0,0:47:50.49,0:47:53.62,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:47:53.70,0:47:56.99,Default,,0,0,0,,Ахх... Уау... Ахх!
Dialogue: 0,0:47:57.12,0:47:58.45,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:47:58.58,0:47:59.83,Default,,0,0,0,,Ах! Woohoo (қосқышты басқан дыбыс)
Dialogue: 0,0:47:59.91,0:48:01.62,Default,,0,0,0,,Жыныстық қатынас! Қарама!
Dialogue: 0,0:48:01.75,0:48:05.54,Default,,0,0,0,,Мияу, мияу, маған енді ұнамайды!
Dialogue: 0,0:48:06.00,0:48:09.01,Default,,0,0,0,,Маған енді ұнамайды! Уайымдама!
Dialogue: 0,0:48:09.38,0:48:13.30,Default,,0,0,0,,Неліктен бұл бөліктер май ыдысынан шығып жатыр?
Dialogue: 0,0:48:13.51,0:48:16.43,Default,,0,0,0,,Мен жинай алмасам, мына заттарды тастаймын.
Dialogue: 0,0:48:16.56,0:48:19.27,Default,,0,0,0,,Даа! Міне... бұл жақсы емес!
Dialogue: 0,0:48:19.89,0:48:22.19,Default,,0,0,0,,Бұл... Мен бұған ымыраға келе алмаймын!
Dialogue: 0,0:48:22.31,0:48:25.52,Default,,0,0,0,,Металл құйып, әлем халқын...
Dialogue: 0,0:48:25.65,0:48:28.48,Default,,0,0,0,,Доктор Хартманды қайтарайық!
Dialogue: 0,0:48:28.94,0:48:30.90,Default,,0,0,0,,Неліктен салқын болуға тырысасыз?
Dialogue: 0,0:48:31.03,0:48:33.61,Default,,0,0,0,,Сіз бұлай айтқанда, ол доктор Хартманмен...
Dialogue: 0,0:48:33.74,0:48:37.28,Default,,0,0,0,,Біз шынымен жақсы дос болғанымызды білемін.
Dialogue: 0,0:48:37.41,0:48:40.66,Default,,0,0,0,,Жоқ... жоқ! Біз бәсекелеспіз!
Dialogue: 0,0:48:40.79,0:48:43.33,Default,,0,0,0,,Олар ең басты бәсекелестер болды!
Dialogue: 0,0:48:43.46,0:48:44.83,Default,,0,0,0,,Сіздің қарсыласыңыз қандай?
Dialogue: 0,0:48:44.96,0:48:48.88,Default,,0,0,0,,Ата мен доктор Гартман, ай және жұмсақ қабықты тасбақа.
Dialogue: 0,0:48:49.00,0:48:50.80,Default,,0,0,0,,Ақылсыз сөздер айтпа!
Dialogue: 0,0:48:51.21,0:48:54.26,Default,,0,0,0,,Әлемдегі адамдар тек Гартманды ғана бағалайды...
Dialogue: 0,0:48:54.38,0:48:56.72,Default,,0,0,0,,Ол жасаған Full Metal бастапқыда...
Dialogue: 0,0:48:56.85,0:49:00.22,Default,,0,0,0,,Мен тудырған қашқан күннен жаратылған.
Dialogue: 0,0:49:00.52,0:49:02.68,Default,,0,0,0,,Бастапқыда, менің несием ретінде...
Dialogue: 0,0:49:02.81,0:49:05.94,Default,,0,0,0,,Маған мақтау қиын болмауы керек!
Dialogue: 0,0:49:06.06,0:49:08.94,Default,,0,0,0,,Бұл басқаша, мүлдем басқа.
Dialogue: 0,0:49:09.57,0:49:13.65,Default,,0,0,0,,Иә! В сортты үстелге арналған тартпа
Dialogue: 0,0:49:13.95,0:49:16.16,Default,,0,0,0,,В сыныбы? В сыныбы...
Dialogue: 0,0:49:16.28,0:49:19.87,Default,,0,0,0,,Сізге қандай В класындағы дәмді тағамды жегіңіз келетінін айтыңыз, сонда олар сіз қалаған нәрсені жасайды.
Dialogue: 0,0:49:19.95,0:49:22.91,Default,,0,0,0,,Жарайды, менден бастайық.
Dialogue: 0,0:49:23.04,0:49:24.08,Default,,0,0,0,,Тұздыққа арналған котлет ыдысы
Dialogue: 0,0:49:25.25,0:49:27.29,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:49:28.71,0:49:31.25,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:49:31.55,0:49:34.34,Default,,0,0,0,,А, онда мен ананас гамбургерін аламын!
Dialogue: 0,0:49:35.76,0:49:38.35,Default,,0,0,0,,Уау! (Сиыр мен тауық қарға)
Dialogue: 0,0:49:42.35,0:49:44.27,Default,,0,0,0,,А... а...
Dialogue: 0,0:49:44.39,0:49:48.36,Default,,0,0,0,,Ал...кейде ингредиенттер сол күйінде шығады.
Dialogue: 0,0:49:48.48,0:49:49.86,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:49:49.98,0:49:51.73,Default,,0,0,0,,Ақыр соңында, бұл да бейшара!
Dialogue: 0,0:49:52.15,0:49:54.24,Default,,0,0,0,,Иә? кінә?
Dialogue: 0,0:49:54.36,0:49:56.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:56.53,0:49:59.24,Default,,0,0,0,,О (Сунео) Уау... Иә?
Dialogue: 0,0:50:00.91,0:50:03.04,Default,,0,0,0,,Тек мазмұны жоғалып кетті
Dialogue: 0,0:50:03.16,0:50:04.37,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:50:04.50,0:50:08.54,Default,,0,0,0,,Хм... Накамисуитол деген құрал бар ғой, солай ма?
Dialogue: 0,0:50:08.63,0:50:13.42,Default,,0,0,0,,Ах, бұл тек мазмұнды сорып алып, оны басқа орынға тасымалдайтын құрал.
Dialogue: 0,0:50:13.55,0:50:15.63,Default,,0,0,0,,Иә, оны жақсартыңыз...
Dialogue: 0,0:50:15.76,0:50:19.68,Default,,0,0,0,,Мен мазмұнды екі есе көбейтетін құрал жасауға тырыстым, бірақ...
Dialogue: 0,0:50:20.10,0:50:23.06,Default,,0,0,0,,Белгілі бір себептермен попон құрылды...
Dialogue: 0,0:50:23.18,0:50:25.85,Default,,0,0,0,,Қандай да бір себептермен ол мазмұнды өшіретін функцияға айналды.
Dialogue: 0,0:50:25.85,0:50:27.02,Default,,0,0,0,,Қандай да бір себептермен ол мазмұнды өшіретін функцияға айналды.
Dialogue: 0,0:50:27.39,0:50:30.48,Default,,0,0,0,,Ал... бұл мүлдем пайдасыз функция.
Dialogue: 0,0:50:30.61,0:50:33.44,Default,,0,0,0,,Не? Өйткені, бұл жігіт те жалпақ бас па?
Dialogue: 0,0:50:33.82,0:50:36.36,Default,,0,0,0,,Хехе ашулы ашулы
Dialogue: 0,0:50:36.49,0:50:38.45,Default,,0,0,0,,Ах... а
Dialogue: 0,0:50:39.91,0:50:43.62,Default,,0,0,0,,А, міне! Маған кацудонды қайтар!
Dialogue: 0,0:50:53.46,0:50:55.80,Default,,0,0,0,,Уау! Сенімен бәрі жақсы ма?
Dialogue: 0,0:50:55.92,0:50:59.89,Default,,0,0,0,,Тым көп тамақ ішкенде солай болады. Күте тұрыңыз, мен оны жөндеймін.
Dialogue: 0,0:51:00.55,0:51:03.01,Default,,0,0,0,,Барлығы кешкі асты бірінші ішеді.
Dialogue: 0,0:51:04.01,0:51:05.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:14.48,0:51:17.32,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:51:23.95,0:51:25.95,Default,,0,0,0,,Бұл мен әлі...
Dialogue: 0,0:51:26.08,0:51:30.12,Default,,0,0,0,,Мен жаңа ғана Нобитаның орнына келген едім.
Dialogue: 0,0:51:30.25,0:51:32.21,Default,,0,0,0,,Бұл менмін, бірақ бұл сізді мазалады ма?
Dialogue: 0,0:51:32.33,0:51:33.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:33.54,0:51:36.00,Default,,0,0,0,,Біз болашақ әлемненбіз.
Dialogue: 0,0:51:36.13,0:51:37.84,Default,,0,0,0,,Танысқаныма қуаныштымын, ата
Dialogue: 0,0:51:38.67,0:51:39.84,Default,,0,0,0,,Ата?
Dialogue: 0,0:51:40.26,0:51:42.55,Default,,0,0,0,,Өйткені атам ештеңе істей алмайды...
Dialogue: 0,0:51:42.68,0:51:45.56,Default,,0,0,0,,Біздің ұрпағымыз шынымен де қиыншылықта.
Dialogue: 0,0:51:45.85,0:51:48.52,Default,,0,0,0,,Бірақ бәрібір. Бүгіннен бастап, Дораэмон...
Dialogue: 0,0:51:48.64,0:51:51.52,Default,,0,0,0,,Мен атамды қатты жаттықтырамын.
Dialogue: 0,0:51:52.10,0:51:53.02,Default,,0,0,0,,Йойшо (Нобита) Ах!
Dialogue: 0,0:51:53.15,0:51:56.73,Default,,0,0,0,,Байыптырақ болыңыз, сіз тіпті допты осылай ұстай алмайсыз ба?
Dialogue: 0,0:51:57.11,0:52:00.90,Default,,0,0,0,,Қатты тырыссаң да, мүмкін емес нәрсені істей алмайсың! Мен қазір үйге барамын!
Dialogue: 0,0:52:01.03,0:52:03.49,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:52:04.07,0:52:04.66,Default,,0,0,0,,Мен мүлде оқи алмаймын және спортпен айналыса алмаймын.
Dialogue: 0,0:52:04.66,0:52:07.54,Default,,0,0,0,,Мен мүлде оқи алмаймын және спортпен айналыса алмаймын.
Dialogue: 0,0:52:04.66,0:52:07.54,Default,,0,0,0,,Жоқ, жоқ, о... Мен үйге барамын!
Dialogue: 0,0:52:07.54,0:52:07.66,Default,,0,0,0,,Жоқ, жоқ, о... Мен үйге барамын!
Dialogue: 0,0:52:07.66,0:52:09.87,Default,,0,0,0,,Жоқ, жоқ, о... Мен үйге барамын!
Dialogue: 0,0:52:07.66,0:52:09.87,Default,,0,0,0,,Не керек, сенің жігерің жоқ...
Dialogue: 0,0:52:09.87,0:52:10.00,Default,,0,0,0,,Жоқ, жоқ, о... Мен үйге барамын!
Dialogue: 0,0:52:10.00,0:52:10.75,Default,,0,0,0,,Жоқ, жоқ, о... Мен үйге барамын!
Dialogue: 0,0:52:10.00,0:52:10.75,Default,,0,0,0,,Сізде ерекше қасиеттер жоқ па?
Dialogue: 0,0:52:10.75,0:52:13.21,Default,,0,0,0,,Сізде ерекше қасиеттер жоқ па?
Dialogue: 0,0:52:13.33,0:52:15.29,Default,,0,0,0,,Бұл қаншалықты жаман?
Dialogue: 0,0:52:15.42,0:52:19.88,Default,,0,0,0,,Ууууууу... Мен бәрібір жаман адаммын!
Dialogue: 0,0:52:20.01,0:52:23.43,Default,,0,0,0,,Сіз не істесеңіз де, ол жұмыс істемейді! Мені жіберіңіз, мен үйге барамын!
Dialogue: 0,0:52:23.55,0:52:26.60,Default,,0,0,0,,Сәлем! Мынау... (Нобита) Тоқта!
Dialogue: 0,0:52:26.72,0:52:27.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:31.94,0:52:33.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:36.40,0:52:38.44,Default,,0,0,0,,Қоңырау...
Dialogue: 0,0:52:44.11,0:52:47.08,Default,,0,0,0,,Ей, мүмкін емес, жетеді.
Dialogue: 0,0:52:47.49,0:52:51.50,Default,,0,0,0,,Бас тартыңыз, мен жаңасын аламын.
Dialogue: 0,0:52:51.62,0:52:54.58,Default,,0,0,0,,Мына жерде құлап қалды, мен оны табатыныма сенімдімін.
Dialogue: 0,0:52:55.08,0:52:56.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:56.38,0:53:00.59,Default,,0,0,0,,Неліктен мұндай нәрседе көп жұмыс істеу керек?
Dialogue: 0,0:53:03.22,0:53:07.76,Default,,0,0,0,,Қазір үйге бармасаң, анаң ұрсады.
Dialogue: 0,0:53:07.89,0:53:09.89,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,0:53:09.97,0:53:13.44,Default,,0,0,0,,Жетер, бас тартамыз ба?
Dialogue: 0,0:53:15.90,0:53:17.19,Default,,0,0,0,,Эй?
Dialogue: 0,0:53:20.44,0:53:23.36,Default,,0,0,0,,Дораемон... Кешіріңіз
Dialogue: 0,0:53:24.82,0:53:26.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:53:26.16,0:53:29.28,Default,,0,0,0,,Сол кезде мен түсіндім.
Dialogue: 0,0:53:29.41,0:53:31.49,Default,,0,0,0,,Мен оны жаман жақтарға толы деп ойладым.
Dialogue: 0,0:53:31.62,0:53:33.12,Default,,0,0,0,,Нобита-
Dialogue: 0,0:53:33.25,0:53:35.75,Default,,0,0,0,,Бір ғана жақсы нәрсе
Dialogue: 0,0:53:35.83,0:53:37.17,Default,,0,0,0,,Бір... аа...
Dialogue: 0,0:53:40.84,0:53:41.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:42.26,0:53:43.97,Default,,0,0,0,,Қоңырау!
Dialogue: 0,0:53:46.30,0:53:48.43,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:53:49.97,0:53:52.72,Default,,0,0,0,,Куфуфуфуфуфу…
Dialogue: 0,0:53:52.85,0:53:55.73,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:53:55.85,0:53:58.90,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:53:59.02,0:54:02.32,Default,,0,0,0,,Ал екеуміз қатты күлдік...
Dialogue: 0,0:54:02.44,0:54:07.28,Default,,0,0,0,,Сол кезде мен Нобита-кунмен дос болып кеткендей болдым.
Dialogue: 0,0:54:07.41,0:54:09.82,Default,,0,0,0,,Мен осылай сезіндім
Dialogue: 0,0:54:12.16,0:54:13.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:14.04,0:54:17.08,Default,,0,0,0,,Мм... сиыс...
Dialogue: 0,0:54:19.46,0:54:20.71,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:54:26.17,0:54:28.47,Default,,0,0,0,,Бұл ондай емес.
Dialogue: 0,0:54:28.59,0:54:32.97,Default,,0,0,0,,Нобита-кун қазір ұмытып кеткен болуы керек.
Dialogue: 0,0:54:35.39,0:54:37.94,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:54:38.06,0:54:39.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:40.56,0:54:42.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:43.82,0:54:44.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:47.11,0:54:49.99,Default,,0,0,0,,Попон қалай жасалды?
Dialogue: 0,0:54:50.12,0:54:51.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:54:51.78,0:54:54.33,Default,,0,0,0,,Хахаха, тоқтат.
Dialogue: 0,0:54:54.66,0:54:56.75,Default,,0,0,0,,Жақсы, ол түзетілді.
Dialogue: 0,0:54:56.87,0:54:57.91,Default,,0,0,0,,Нобита
Dialogue: 0,0:54:58.04,0:55:00.75,Default,,0,0,0,,Содан бері оны жөндеп жатырсыз ба?
Dialogue: 0,0:55:00.96,0:55:04.00,Default,,0,0,0,,Аа... Жаңа ғана көңілім көтеріліп қалды.
Dialogue: 0,0:55:04.13,0:55:06.97,Default,,0,0,0,,Мен мұны білмей тұрып, жиі таң болады.
Dialogue: 0,0:55:07.05,0:55:09.26,Default,,0,0,0,,Я, сен маған қатты ұнайсың.
Dialogue: 0,0:55:09.38,0:55:12.18,Default,,0,0,0,,Мен қызғаншақпын, иә?
Dialogue: 0,0:55:12.26,0:55:16.27,Default,,0,0,0,,Мен де сондай бір нәрсеге құмар болатынымды қалаймын.
Dialogue: 0,0:55:16.39,0:55:19.56,Default,,0,0,0,,Не істесем де, жарты жолда жалықтым...
Dialogue: 0,0:55:19.69,0:55:23.69,Default,,0,0,0,,Бұл жақсы емес, бұл да жақсы емес, мұнда ерекше ештеңе жоқ.
Dialogue: 0,0:55:23.77,0:55:28.07,Default,,0,0,0,,Хехе, бұл дұрыс емес, мен оны түсінбеймін.
Dialogue: 0,0:55:28.61,0:55:32.07,Default,,0,0,0,,Мен Нобитаның бірдеңе ұсынатынына сенімдімін.
Dialogue: 0,0:55:32.20,0:55:33.45,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:55:33.58,0:55:35.74,Default,,0,0,0,,(Дораэмон мен Нобитаның күлкісі)
Dialogue: 0,0:55:35.87,0:55:40.33,Default,,0,0,0,,Сен шынымен де дәрменсіз адамсың.
Dialogue: 0,0:55:40.75,0:55:42.17,Default,,0,0,0,,…Ал екеуі ше?
Dialogue: 0,0:55:42.29,0:55:44.21,Default,,0,0,0,,Менің шеберім
Dialogue: 0,0:55:44.34,0:55:45.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:45.42,0:55:47.26,Default,,0,0,0,,Маған қожайыным айтты
Dialogue: 0,0:55:47.38,0:55:50.09,Default,,0,0,0,,«Еңбегі жоқ адам болмайды».
Dialogue: 0,0:55:50.22,0:55:51.72,Default,,0,0,0,,Мастер?
Dialogue: 0,0:55:51.84,0:55:53.76,Default,,0,0,0,,Менің құрал жасау мұғалімі
Dialogue: 0,0:55:54.26,0:55:58.52,Default,,0,0,0,,Құрал жасаушы үшін ең маңыздысы не, Курт?
Dialogue: 0,0:55:58.64,0:56:01.27,Default,,0,0,0,,Құралдар жасағанды ​​ұнатады.
Dialogue: 0,0:56:01.64,0:56:06.48,Default,,0,0,0,,Қанша рет сәтсіздікке ұшырағаныңыз маңызды емес, оны сізді мазақ ететіндерге қалдырыңыз.
Dialogue: 0,0:56:06.78,0:56:10.57,Default,,0,0,0,,Мен сені сүйемін деген сезім мен бас тартпайтыным...
Dialogue: 0,0:56:10.70,0:56:13.66,Default,,0,0,0,,Бұл сенің ең жақсы жерің, Курт.
Dialogue: 0,0:56:13.78,0:56:15.45,Default,,0,0,0,,Иә, доктор!
Dialogue: 0,0:56:15.91,0:56:17.74,Default,,0,0,0,,Тек сол адам
Dialogue: 0,0:56:17.87,0:56:21.41,Default,,0,0,0,,Менде де жақсы қасиеттер бар деп айтатын адам
Dialogue: 0,0:56:21.50,0:56:24.88,Default,,0,0,0,,Хехе, мен міндетті түрде аспап шебері боламын!
Dialogue: 0,0:56:25.00,0:56:27.92,Default,,0,0,0,,Бір күні ол мұражайға қойылады.
Dialogue: 0,0:56:28.05,0:56:30.22,Default,,0,0,0,,Мен керемет құралдар жасаймын!
Dialogue: 0,0:56:30.34,0:56:33.76,Default,,0,0,0,,Ахаха, бұл керемет. Мен Курттың қолынан келетініне сенімдімін.
Dialogue: 0,0:56:33.89,0:56:37.22,Default,,0,0,0,,Иә! (Курт пен Нобитаның күлкісі)
Dialogue: 0,0:56:38.64,0:56:41.10,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:56:41.77,0:56:44.23,Default,,0,0,0,,Кешіріңіз, өтуге рұқсат етіңіз.
Dialogue: 0,0:56:44.35,0:56:47.15,Default,,0,0,0,,Иә? «Уақытша жабық»?
Dialogue: 0,0:56:47.27,0:56:48.48,Default,,0,0,0,,Неліктен кенеттен...
Dialogue: 0,0:56:49.44,0:56:51.44,Default,,0,0,0,,Кеңсеге барайық (Нобита) Иә.
Dialogue: 0,0:56:53.91,0:56:55.49,Default,,0,0,0,,Иә? Хабарлама?
Dialogue: 0,0:56:56.16,0:56:59.41,Default,,0,0,0,,Иә, ол бүгін таңертең келді.
Dialogue: 0,0:57:01.54,0:57:03.04,Default,,0,0,0,,Бүгін түсте -
Dialogue: 0,0:57:03.16,0:57:06.17,Default,,0,0,0,,Мен сізге маңызды құпия құрал алуға келдім.
Dialogue: 0,0:57:06.50,0:57:08.80,Default,,0,0,0,,Қулықшы Ұры DX
Dialogue: 0,0:57:09.67,0:57:11.63,Default,,0,0,0,,Яғни...
Dialogue: 0,0:57:13.42,0:57:15.51,Default,,0,0,0,,Хмм?
Dialogue: 0,0:57:15.64,0:57:18.14,Default,,0,0,0,,Үлкен жарықпен бірдей.
Dialogue: 0,0:57:18.26,0:57:20.01,Default,,0,0,0,,Инспектор Қыша
Dialogue: 0,0:57:20.68,0:57:21.72,Default,,0,0,0,,О
Dialogue: 0,0:57:21.93,0:57:23.39,Default,,0,0,0,,Дәл солай ма?
Dialogue: 0,0:57:23.52,0:57:27.94,Default,,0,0,0,,Өткен аптада мен Кайто DX-тен осындай хабарлама алдым...
Dialogue: 0,0:57:28.06,0:57:30.32,Default,,0,0,0,,Болжағандай, ол ұрланған.
Dialogue: 0,0:57:30.44,0:57:33.90,Default,,0,0,0,,Бірақ менің жағдайымда мен ешқашан хабарлама алған жоқпын.
Dialogue: 0,0:57:34.45,0:57:37.37,Default,,0,0,0,,Иә? Ойлап қарасам, бұл белгі...
Dialogue: 0,0:57:42.33,0:57:43.66,Default,,0,0,0,,О... міне, солай!
Dialogue: 0,0:57:43.79,0:57:45.58,Default,,0,0,0,,Бұл қашан келді?
Dialogue: 0,0:57:45.71,0:57:47.83,Default,,0,0,0,,Мен шынымен түсінбеймін...
Dialogue: 0,0:57:48.75,0:57:49.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:50.09,0:57:53.42,Default,,0,0,0,,Сіз Дораэмонның қоңырауын 5 минуттан кейін аласыз.
Dialogue: 0,0:57:53.55,0:57:55.76,Default,,0,0,0,,Қулықшы Ұры DX
Dialogue: 0,0:57:56.55,0:57:57.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:58.01,0:58:01.06,Default,,0,0,0,,«DX» «люкс» деп оқылады.
Dialogue: 0,0:58:01.18,0:58:02.43,Default,,0,0,0,,Зуко!
Dialogue: 0,0:58:03.39,0:58:05.06,Default,,0,0,0,,Ух... иә... Мен мұны білдім...
Dialogue: 0,0:58:05.19,0:58:08.56,Default,,0,0,0,,Менің қоңырауымды ұрлаған адам да Қулықшы Ұры DX болды.
Dialogue: 0,0:58:08.69,0:58:13.15,Default,,0,0,0,,Бұл дегеніміз, егер сіз DX-ті ұстасаңыз, Suzu да оралады.
Dialogue: 0,0:58:13.28,0:58:16.36,Default,,0,0,0,,Иә! Қоңырауымды қайтару үшін...
Dialogue: 0,0:58:16.49,0:58:18.62,Default,,0,0,0,,Тергеумен ынтымақтасуыңызды сұраймыз.
Dialogue: 0,0:58:18.74,0:58:23.62,Default,,0,0,0,,Okay, let this Sherlock Нобита catch DX.
Dialogue: 0,0:58:23.75,0:58:28.08,Default,,0,0,0,,Clue Lens Қулықшы Ұры DX келесі мақсатты көздейді?
Dialogue: 0,0:58:30.71,0:58:34.21,Default,,0,0,0,,шықты! Мақсат - сарай!
Dialogue: 0,0:58:34.34,0:58:38.97,Default,,0,0,0,,Бұл біртүрлі. Бұл анықтама объективтегі табиғи мұражайды көрсетеді.
Dialogue: 0,0:58:39.05,0:58:40.18,Default,,0,0,0,,Иә? (Қызық) А...
Dialogue: 0,0:58:40.26,0:58:42.97,Default,,0,0,0,,Аа, мен мұнда өзімді жақсы сезінбеймін.
Dialogue: 0,0:58:43.10,0:58:44.89,Default,,0,0,0,,Өйткені, бұл Дораэмонның құралы.
Dialogue: 0,0:58:45.02,0:58:46.68,Default,,0,0,0,,Хмм, бұл дөрекі!\NIn
Dialogue: 0,0:58:46.81,0:58:50.19,Default,,0,0,0,,, біз сол екі ғимаратқа тоқталамыз.
Dialogue: 0,0:58:50.31,0:58:53.53,Default,,0,0,0,,Қалған ғимараттардың бәріне де күзетшілер қояйық.
Dialogue: 0,0:58:53.65,0:58:54.44,Default,,0,0,0,,Иә
Dialogue: 0,0:58:54.53,0:58:56.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:02.03,0:59:03.91,Default,,0,0,0,,Сол жаққа барыңыз (полиция қызметкерлері) Иә.
Dialogue: 0,0:59:14.46,0:59:17.47,Default,,0,0,0,,Ендеше табиғат мұражайын тамашалайық.
Dialogue: 0,0:59:17.59,0:59:18.93,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:59:19.01,0:59:21.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:22.01,0:59:25.10,Default,,0,0,0,,Ах... Мм, мен ваннадамын.
Dialogue: 0,0:59:25.39,0:59:27.56,Default,,0,0,0,,Алдымен әжетханаға барыңыз!
Dialogue: 0,0:59:27.64,0:59:30.48,Default,,0,0,0,,Мен қобалжыдым... Бірден келемін!
Dialogue: 0,0:59:30.60,0:59:31.77,Default,,0,0,0,,Геппоко!
Dialogue: 0,0:59:37.61,0:59:39.32,Default,,0,0,0,,Мен кешігіп қалдым. Кешіріңіз.
Dialogue: 0,0:59:42.74,0:59:44.16,Default,,0,0,0,,Олай болса, рахмет.
Dialogue: 0,0:59:44.28,0:59:45.62,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:59:48.29,0:59:50.29,Default,,0,0,0,,Қазір! Уақытында алдым
Dialogue: 0,0:59:50.42,0:59:51.37,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:59:52.46,0:59:54.17,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:59:58.17,0:59:59.72,Default,,0,0,0,,1 минут қалды
Dialogue: 0,1:00:00.55,1:00:03.34,Default,,0,0,0,,Директор... қайтып келмейді.
Dialogue: 0,1:00:03.47,1:00:04.43,Default,,0,0,0,,Иә
Dialogue: 0,1:00:10.98,1:00:14.98,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:00:23.91,1:00:25.70,Default,,0,0,0,,Ах (қыша) А?
Dialogue: 0,1:00:25.83,1:00:27.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:27.20,1:00:28.70,Default,,0,0,0,,Та... Эвакуациялаңыз!
Dialogue: 0,1:00:29.16,1:00:33.12,Default,,0,0,0,,Шыу!
Dialogue: 0,1:00:33.42,1:00:35.25,Default,,0,0,0,,Тезірек жасырын!
Dialogue: 0,1:00:35.67,1:00:39.76,Default,,0,0,0,,Ей, жындар бұршақтың сыртында, олардың барлығын лақтыруды жоспарлап отырсың ба?
Dialogue: 0,1:00:42.05,1:00:43.43,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:43.64,1:00:44.93,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:00:47.14,1:00:48.43,Default,,0,0,0,,Ешкім келмейді.
Dialogue: 0,1:00:48.56,1:00:50.89,Default,,0,0,0,,Менің ойымша, бұл басқа сарай болды.
Dialogue: 0,1:00:51.64,1:00:53.31,Default,,0,0,0,,Ой...
Dialogue: 0,1:00:53.44,1:00:54.81,Default,,0,0,0,,Инспектор Қыша
Dialogue: 0,1:00:54.94,1:00:56.73,Default,,0,0,0,,Бұл қиын! Бұл табиғат мұражайы!
Dialogue: 0,1:00:56.86,1:00:58.86,Default,,0,0,0,,А... не болды? (Қыша) Не?
Dialogue: 0,1:00:59.23,1:01:00.94,Default,,0,0,0,,Жарықтандыруды тексеріңіз
Dialogue: 0,1:01:01.07,1:01:03.11,Default,,0,0,0,,Бұл... Инспектор!
Dialogue: 0,1:01:03.24,1:01:06.07,Default,,0,0,0,,Осындай жерге күңгірттенетін шам орнатылған.
Dialogue: 0,1:01:06.20,1:01:08.24,Default,,0,0,0,,Не! ? Ха... тез жүгір!
Dialogue: 0,1:01:08.37,1:01:11.66,Default,,0,0,0,,Фухахаха... (Нобита) Уау! Уф...
Dialogue: 0,1:01:11.75,1:01:15.42,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,1:01:15.50,1:01:17.63,Default,,0,0,0,,Бұл Қулықшы Ұры DX!
Dialogue: 0,1:01:18.92,1:01:21.59,Default,,0,0,0,,Идиот! Сонда табиғат мұражайы дегеніміз не?
Dialogue: 0,1:01:21.88,1:01:24.84,Default,,0,0,0,,Бұл Қулықшы Ұры DX
Dialogue: 0,1:01:24.97,1:01:26.30,Default,,0,0,0,,Зиянкес
Dialogue: 0,1:01:26.39,1:01:28.01,Default,,0,0,0,,Қанша адам келдіңдер? Төртеу ме?
Dialogue: 0,1:01:28.14,1:01:30.43,Default,,0,0,0,,Бүріккіш типті арман пистолет!
Dialogue: 0,1:01:32.27,1:01:35.52,Default,,0,0,0,,(Патоббол есінеу)
Dialogue: 0,1:01:37.27,1:01:39.02,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,1:01:39.15,1:01:43.74,Default,,0,0,0,,Болжам бойынша мен маңызды құпия құралды алуға келдім.
Dialogue: 0,1:01:45.20,1:01:48.12,Default,,0,0,0,,Фантом ұры DX сарайда пайда болды, бәрі...
Dialogue: 0,1:01:48.20,1:01:50.08,Default,,0,0,0,,Асығыңыз! DX қашып кетуіне жол бермеңіз!
Dialogue: 0,1:01:50.79,1:01:51.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:52.25,1:01:54.66,Default,,0,0,0,,Мұндай жерде шынымен де Хамон мұғалімі бар ма?
Dialogue: 0,1:01:55.21,1:01:56.87,Default,,0,0,0,,Бір-бірден, кезекпен—
Dialogue: 0,1:01:57.08,1:01:59.84,Default,,0,0,0,,Сенің зәулім үйге бармау үшін бәрі бұрмаланған.
Dialogue: 0,1:01:59.92,1:02:02.34,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,1:02:02.67,1:02:04.38,Default,,0,0,0,,Тез! маған қоңырауымды қайтар
Dialogue: 0,1:02:04.51,1:02:05.30,Default,,0,0,0,,Бум!
Dialogue: 0,1:02:05.55,1:02:08.09,Default,,0,0,0,,Оны тікелей тиіп, жарып жіберген сол сым емес еді
Dialogue: 0,1:02:08.18,1:02:09.14,Default,,0,0,0,,Бум!
Dialogue: 0,1:02:09.43,1:02:12.39,Default,,0,0,0,,Фухаха фухаха фухахаха!
Dialogue: 0,1:02:12.52,1:02:14.81,Default,,0,0,0,,Жоқ, шабуыл жұмыс істемейді.
Dialogue: 0,1:02:15.18,1:02:17.27,Default,,0,0,0,,Ах... (қыша) Қулықшы Ұры DX
Dialogue: 0,1:02:17.69,1:02:18.98,Default,,0,0,0,,Менімен жарыс
Dialogue: 0,1:02:19.06,1:02:21.44,Default,,0,0,0,,Қызық
Dialogue: 0,1:02:27.82,1:02:29.16,Default,,0,0,0,,Зымыран лақтыру
Dialogue: 0,1:02:29.24,1:02:30.99,Default,,0,0,0,,Хирари плащы
Dialogue: 0,1:02:33.45,1:02:35.66,Default,,0,0,0,,Toumei Cloak (Қулықшы Ұры DX) және Ушимегане
Dialogue: 0,1:02:36.00,1:02:37.75,Default,,0,0,0,,Гишин Анки (Қулықшы Ұры DX) Сунаон
Dialogue: 0,1:02:37.83,1:02:39.88,Default,,0,0,0,,Сенімділік дулығасы (Қулықшы Ұры DX) Confidence Wobble машинасы
Dialogue: 0,1:02:39.96,1:02:41.84,Default,,0,0,0,,Magic Ass (Қулықшы Ұры DX) Сиқырлы асқазан
Dialogue: 0,1:02:41.96,1:02:43.13,Default,,0,0,0,,Айко қолғап (Қулықшы Ұры DX) Қолды қайтару
Dialogue: 0,1:02:43.25,1:02:44.71,Default,,0,0,0,,Фуджин фанаты (Қулықшы Ұры DX) Basho фанаты
Dialogue: 0,1:02:44.92,1:02:47.30,Default,,0,0,0,,Бұл... сұмдық шайқас.
Dialogue: 0,1:02:47.43,1:02:49.47,Default,,0,0,0,,Өзіңді тым мақтаншақ сезінбе.
Dialogue: 0,1:02:49.68,1:02:51.85,Default,,0,0,0,,(Екі адам тынысы тарылды)
Dialogue: 0,1:02:51.93,1:02:54.60,Default,,0,0,0,,Қуатты Ultra Super Deluxe планшеттері!
Dialogue: 0,1:02:54.85,1:02:56.06,Default,,0,0,0,,Дожибан!
Dialogue: 0,1:02:56.31,1:02:58.90,Default,,0,0,0,,Қарғыс атсын! Мен жеңе алмаймын!
Dialogue: 0,1:02:59.27,1:03:02.11,Default,,0,0,0,,Иә, егер бұл орын алса, күшіңізді жұмсаңыз!
Dialogue: 0,1:03:02.73,1:03:05.07,Default,,0,0,0,,Келіңіздер, DX корпусы!
Dialogue: 0,1:03:08.24,1:03:10.36,Default,,0,0,0,,Бұл... бұл коробашия!
Dialogue: 0,1:03:11.66,1:03:13.79,Default,,0,0,0,,Уау! О, Нобита-кун!
Dialogue: 0,1:03:14.24,1:03:17.21,Default,,0,0,0,,Ол DX бағыныңқысы ретінде өзгертілген.
Dialogue: 0,1:03:17.33,1:03:18.16,Default,,0,0,0,,Бум!
Dialogue: 0,1:03:20.46,1:03:21.54,Default,,0,0,0,,Даа!
Dialogue: 0,1:03:21.67,1:03:23.34,Default,,0,0,0,,Кяах! Апыр-ай!
Dialogue: 0,1:03:26.13,1:03:27.51,Default,,0,0,0,,Ей! (Сунео) Бум!
Dialogue: 0,1:03:27.63,1:03:29.51,Default,,0,0,0,,Ах! (Сунео) Уау! Ахх...
Dialogue: 0,1:03:29.63,1:03:32.47,Default,,0,0,0,,Эй... у... а?
Dialogue: 0,1:03:32.93,1:03:33.89,Default,,0,0,0,,Гяа!
Dialogue: 0,1:03:34.01,1:03:36.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:36.27,1:03:38.39,Default,,0,0,0,,Джан! Хехехе
Dialogue: 0,1:03:39.06,1:03:40.27,Default,,0,0,0,,Сунео, осылай!
Dialogue: 0,1:03:40.39,1:03:42.27,Default,,0,0,0,,Иә! Әйте…
Dialogue: 0,1:03:42.40,1:03:45.86,Default,,0,0,0,,Ух... Атақты қылыш Дэнкомару Тория!
Dialogue: 0,1:03:46.23,1:03:47.15,Default,,0,0,0,,Эй!
Dialogue: 0,1:03:48.82,1:03:50.82,Default,,0,0,0,,Балицу! Балицу! Балицу!
Dialogue: 0,1:03:51.16,1:03:52.53,Default,,0,0,0,,Нуу…
Dialogue: 0,1:03:52.62,1:03:54.28,Default,,0,0,0,,Иә! Тат! Ха!
Dialogue: 0,1:03:54.41,1:03:57.75,Default,,0,0,0,,Уау... Уау! Аяя…
Dialogue: 0,1:03:57.83,1:04:00.41,Default,,0,0,0,,О, мынаны пайдалан! Апыр-ай!
Dialogue: 0,1:04:00.62,1:04:02.04,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:02.46,1:04:03.54,Default,,0,0,0,,Хмм.
Dialogue: 0,1:04:09.05,1:04:10.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:10.97,1:04:12.97,Default,,0,0,0,,Сіз түсірген су мылтығы...
Dialogue: 0,1:04:13.09,1:04:14.76,Default,,0,0,0,,Су мылтығы... (Бәйбіше) Су мылтығы...
Dialogue: 0,1:04:14.89,1:04:16.14,Default,,0,0,0,,Бұл ма?
Dialogue: 0,1:04:16.22,1:04:19.35,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:04:21.56,1:04:24.06,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:04:24.27,1:04:28.28,Default,,0,0,0,,Уау! Ах! (Құдайлардың күлкісі)
Dialogue: 0,1:04:28.36,1:04:35.32,Default,,0,0,0,,(Қулықшы Ұры DX күлкісі)
Dialogue: 0,1:04:37.54,1:04:41.62,Default,,0,0,0,,Жарайсыңдар, қойылым аяқталды.
Dialogue: 0,1:04:43.92,1:04:45.04,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:04:45.71,1:04:48.13,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:48.80,1:04:50.34,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:04:50.42,1:04:54.09,Default,,0,0,0,,Ал... күте тұрыңыз! Менің қоңырауым! О, жоқ! Ах...
Dialogue: 0,1:04:54.18,1:04:56.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:02.56,1:05:04.65,Default,,0,0,0,,Жәндіктер дабылы да зақымдалған сияқты.
Dialogue: 0,1:05:04.77,1:05:06.11,Default,,0,0,0,,Не?
Dialogue: 0,1:05:07.57,1:05:10.11,Default,,0,0,0,,Қарғыс атсын... иә?
Dialogue: 0,1:05:14.11,1:05:15.78,Default,,0,0,0,,Они бұршақтардың сыртында
Dialogue: 0,1:05:16.41,1:05:19.49,Default,,0,0,0,,Мен мұнда келгенде...
Dialogue: 0,1:05:19.70,1:05:21.04,Default,,0,0,0,,Инспектор! (Қыша) О
Dialogue: 0,1:05:21.16,1:05:22.62,Default,,0,0,0,,Фельмиррорға да шабуыл жасалған сияқты.
Dialogue: 0,1:05:22.75,1:05:24.71,Default,,0,0,0,,Қарғыс атсын... (бәрі) Иә?
Dialogue: 0,1:05:25.50,1:05:26.67,Default,,0,0,0,,Немесе... Директор
Dialogue: 0,1:05:26.75,1:05:28.84,Default,,0,0,0,,Ха... ха...
Dialogue: 0,1:05:29.67,1:05:31.63,Default,,0,0,0,,Амансың ба? (Қызық) Ой
Dialogue: 0,1:05:31.76,1:05:32.97,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,1:05:33.09,1:05:36.84,Default,,0,0,0,,Жоқ, мен табиғат мұражайына барған бойда жын бұршақ сыртында екен.
Dialogue: 0,1:05:36.93,1:05:39.01,Default,,0,0,0,,Сыртта шабуыл жасау
Dialogue: 0,1:05:39.14,1:05:40.31,Default,,0,0,0,,Иә
Dialogue: 0,1:05:41.06,1:05:42.68,Default,,0,0,0,,Табиғат мұражайына не болды?
Dialogue: 0,1:05:42.81,1:05:47.65,Default,,0,0,0,,Ештеңе ұрланбаған сияқты, барлығын қуып жіберген.
Dialogue: 0,1:05:47.77,1:05:51.61,Default,,0,0,0,,Не! ? Не болып жатыр?
Dialogue: 0,1:05:51.73,1:05:56.49,Default,,0,0,0,,Ммм, табиғат мұражайына шабуыл жасаудың мақсаты қандай?
Dialogue: 0,1:05:56.61,1:05:58.24,Default,,0,0,0,,А, мен түсінбеймін.
Dialogue: 0,1:05:58.32,1:05:59.74,Default,,0,0,0,,Жарайды
Dialogue: 0,1:05:59.87,1:06:04.00,Default,,0,0,0,,Шерлок Нобита бұл істі дереу шешсін.
Dialogue: 0,1:06:04.62,1:06:06.00,Default,,0,0,0,,Түзу құбыр!
Dialogue: 0,1:06:06.33,1:06:07.58,Default,,0,0,0,,...себебі ол бітеліп қалған
Dialogue: 0,1:06:07.71,1:06:08.58,Default,,0,0,0,,Зуко
Dialogue: 0,1:06:08.92,1:06:10.96,Default,,0,0,0,,Анықтамалық линза!
Dialogue: 0,1:06:11.38,1:06:13.55,Default,,0,0,0,,Маған Қулықшы Ұры DX туралы түсінік беріңіз
Dialogue: 0,1:06:14.88,1:06:16.09,Default,,0,0,0,,Хмм?
Dialogue: 0,1:06:16.22,1:06:17.76,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,1:06:17.89,1:06:19.97,Default,,0,0,0,,Есік айналады
Dialogue: 0,1:06:20.72,1:06:22.93,Default,,0,0,0,,Есік айналып тұр ма?
Dialogue: 0,1:06:23.06,1:06:25.18,Default,,0,0,0,,Айналу...
Dialogue: 0,1:06:25.31,1:06:27.65,Default,,0,0,0,,Хмм.
Dialogue: 0,1:06:28.31,1:06:29.48,Default,,0,0,0,,өту!
Dialogue: 0,1:06:29.81,1:06:32.73,Default,,0,0,0,,Маған түсінуге жеңілірек кеңес беріңізші.
Dialogue: 0,1:06:32.86,1:06:36.20,Default,,0,0,0,,Инспектор, не ұрланды?
Dialogue: 0,1:06:36.45,1:06:39.99,Default,,0,0,0,,Иә, жанармай айнасы жәндіктер туралы дабыл.
Dialogue: 0,1:06:40.12,1:06:44.04,Default,,0,0,0,,Жағымсыз қосқыш. Көмек берудің төрт жолы.
Dialogue: 0,1:06:44.12,1:06:48.75,Default,,0,0,0,,Ал Үлкен Жарық пен Дора-чанның қоңырауы... Барлығы 6.
Dialogue: 0,1:06:49.79,1:06:52.71,Default,,0,0,0,,Мына алтауды неге ұрладың?
Dialogue: 0,1:06:52.84,1:06:56.13,Default,,0,0,0,,Қандай да бір себептермен... ортақ нәрсе болуы керек.
Dialogue: 0,1:06:56.26,1:06:57.93,Default,,0,0,0,,О
Dialogue: 0,1:06:58.05,1:06:59.76,Default,,0,0,0,,Жарайды анықтамалық линза
Dialogue: 0,1:06:59.89,1:07:03.43,Default,,0,0,0,,Алты ортақ нүкте Бұл жолы маған түсінікті кеңес беріңізші.
Dialogue: 0,1:07:05.10,1:07:07.94,Default,,0,0,0,,Хмм? Не? Бұл
Dialogue: 0,1:07:08.73,1:07:11.81,Default,,0,0,0,,Бұл... құпия құралдарды жөндеу шеберханасы.
Dialogue: 0,1:07:11.94,1:07:12.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:13.23,1:07:18.07,Default,,0,0,0,,Жарайды, енді жұмбақ баланың түкірігін сипап өтсең, ойың ашылады.
Dialogue: 0,1:07:20.74,1:07:22.28,Default,,0,0,0,,Нобибибеан!
Dialogue: 0,1:07:22.62,1:07:24.24,Default,,0,0,0,,Менде бір идея болды!
Dialogue: 0,1:07:24.70,1:07:29.25,Default,,0,0,0,,Директор, ұрланған құпия құралдың жөндеуге жіберілген күнін анықтаңыз.
Dialogue: 0,1:07:29.37,1:07:30.88,Default,,0,0,0,,А, жақсы
Dialogue: 0,1:07:32.46,1:07:36.38,Default,,0,0,0,,Хмм? Бұл... қараңызшы
Dialogue: 0,1:07:36.51,1:07:40.97,Default,,0,0,0,,Барлық ұрланған заттар сол күні жөндеу шеберханасына қайтарылды.
Dialogue: 0,1:07:41.22,1:07:42.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:42.14,1:07:46.60,Default,,0,0,0,,Ойланып қарасам, менің қоңырауым да сол күні жөндеуге жіберілді.
Dialogue: 0,1:07:46.72,1:07:49.60,Default,,0,0,0,,Бұл зауыт… Бұл күн…
Dialogue: 0,1:07:49.73,1:07:51.98,Default,,0,0,0,,Бұл доктор Пеплердің қамауға алынған күні.
Dialogue: 0,1:07:52.06,1:07:53.15,Default,,0,0,0,,Ах... (Нобита және т.б.) Иә?
Dialogue: 0,1:07:53.90,1:07:57.36,Default,,0,0,0,,Осы аралдан қуылуы керек болған доктор Пеплер...
Dialogue: 0,1:07:57.49,1:08:00.15,Default,,0,0,0,,Мен оның аралға қайтып бара жатқаны туралы ақпарат алдым.
Dialogue: 0,1:08:00.95,1:08:04.78,Default,,0,0,0,,Тергеуден кейін мен демалыс күні осы зауытқа жасырын кіріп бара жатқанымды көрдім...
Dialogue: 0,1:08:04.91,1:08:07.08,Default,,0,0,0,,Ол тұтқынға алынды.
Dialogue: 0,1:08:07.54,1:08:12.04,Default,,0,0,0,,Ол қандай да бір оғаш құрылғы жасап жатыр еді, бірақ ол тәркіленді...
Dialogue: 0,1:08:12.17,1:08:16.05,Default,,0,0,0,,Көп ұзамай ол тағы да шығарылды...
Dialogue: 0,1:08:16.17,1:08:21.51,Default,,0,0,0,,Сол кезде менің қоңырауыма және қалған бесеуіне бірдеңе жасағаныңызға сенімдімін.
Dialogue: 0,1:08:21.63,1:08:25.43,Default,,0,0,0,,Менің ойымша, доктор Пеплер мен Қулықшы Ұры DX арасында қандай да бір қарым-қатынас бар.
Dialogue: 0,1:08:25.55,1:08:27.60,Default,,0,0,0,,Иә, мен сенімдімін.
Dialogue: 0,1:08:28.10,1:08:32.02,Default,,0,0,0,,Мен мұны істей алмаймын. Мен Пепплерді қайта қарастырамын.
Dialogue: 0,1:08:32.52,1:08:34.52,Default,,0,0,0,,Мен... Мен де қараймын.
Dialogue: 0,1:08:34.77,1:08:35.94,Default,,0,0,0,,Жарайды, біз...
Dialogue: 0,1:08:36.07,1:08:38.40,Default,,0,0,0,,Доктор Пеплердің тұрған жерін табайық.
Dialogue: 0,1:08:38.53,1:08:43.20,Default,,0,0,0,,Бұл радар таяқшасы. Доктор Пеплер қайда?
Dialogue: 0,1:08:47.74,1:08:48.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:48.74,1:08:50.62,Default,,0,0,0,,Ол құламайды.
Dialogue: 0,1:08:50.75,1:08:53.54,Default,,0,0,0,,Хахаха бұл да бұзылған шығар.
Dialogue: 0,1:08:53.67,1:08:56.17,Default,,0,0,0,,Бір минут күтіңіз, бұл болуы мүмкін бе?
Dialogue: 0,1:08:58.84,1:09:00.51,Default,,0,0,0,,Менің ойымша, бұл сіз айтып отырған нәрсе.
Dialogue: 0,1:09:00.63,1:09:02.05,Default,,0,0,0,,Иә? Амал жоқ
Dialogue: 0,1:09:02.34,1:09:04.47,Default,,0,0,0,,Жоқ, таңқаларлық, солай болуы мүмкін.
Dialogue: 0,1:09:04.59,1:09:05.80,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:07.35,1:09:09.52,Default,,0,0,0,,Ах... (Нобита) Уау!
Dialogue: 0,1:09:09.60,1:09:11.68,Default,,0,0,0,,Мияу мияу о хахаха
Dialogue: 0,1:09:11.81,1:09:14.02,Default,,0,0,0,,Шизука-чан құтқарып жатыр!
Dialogue: 0,1:09:14.69,1:09:16.56,Default,,0,0,0,,Кеттік
Dialogue: 0,1:09:16.94,1:09:18.77,Default,,0,0,0,,А... күте тұрыңыз... бұл қауіпті.
Dialogue: 0,1:09:18.90,1:09:22.19,Default,,0,0,0,,Шизука Нобитаға қарағанда Холмсқа көбірек ұқсауы мүмкін.
Dialogue: 0,1:09:22.32,1:09:25.32,Default,,0,0,0,,Мен... Расында мен де байқадым.
Dialogue: 0,1:09:25.82,1:09:28.03,Default,,0,0,0,,Әй?
Dialogue: 0,1:09:28.12,1:09:31.00,Default,,0,0,0,,Попон
Dialogue: 0,1:09:31.20,1:09:32.71,Default,,0,0,0,,Сіз жасырынып шықтыңыз ба?
Dialogue: 0,1:09:33.25,1:09:35.71,Default,,0,0,0,,Попон, келмеу керек.
Dialogue: 0,1:09:37.08,1:09:40.71,Default,,0,0,0,,(айқай)
Dialogue: 0,1:09:40.84,1:09:43.01,Default,,0,0,0,,О? не болды?
Dialogue: 0,1:09:43.13,1:09:48.76,Default,,0,0,0,,Ахаха, бұған көмектесу мүмкін емес. Мүмкін қыз жақсы болар ма еді?
Dialogue: 0,1:09:49.18,1:09:51.39,Default,,0,0,0,,Енді әрі қарай жүрейік.
Dialogue: 0,1:09:56.77,1:09:58.19,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:09:58.56,1:09:59.69,Default,,0,0,0,,Зиянкес
Dialogue: 0,1:09:59.82,1:10:01.90,Default,,0,0,0,,Иә, шулы бейбақ.
Dialogue: 0,1:10:02.69,1:10:05.15,Default,,0,0,0,,Жарайды, сол нүктені қайтадан зерттеп көрейік.
Dialogue: 0,1:10:05.28,1:10:06.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:10:06.24,1:10:08.41,Default,,0,0,0,,Осы арада...
Dialogue: 0,1:10:08.78,1:10:11.29,Default,,0,0,0,,Осы жігіттің жұмбағын шештік делік?
Dialogue: 0,1:10:11.79,1:10:14.04,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:10:15.04,1:10:19.13,Default,,0,0,0,,Хмф, егер келе алсаңыз, келіңіз!
Dialogue: 0,1:10:19.92,1:10:20.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:21.13,1:10:23.34,Default,,0,0,0,,Жоқ! Сіз тұзаққа түсесіз!
Dialogue: 0,1:10:26.68,1:10:28.80,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:29.01,1:10:30.30,Default,,0,0,0,,Горгонның басы
Dialogue: 0,1:10:30.43,1:10:33.27,Default,,0,0,0,,Көзіңнен шыққан сәулеге соқса, тасқа айналасың!
Dialogue: 0,1:10:36.10,1:10:38.19,Default,,0,0,0,,Және... ұша алады ма! ?
Dialogue: 0,1:10:43.07,1:10:43.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:45.15,1:10:47.03,Default,,0,0,0,,Попон-чан!
Dialogue: 0,1:10:48.86,1:10:49.95,Default,,0,0,0,,Кел, Попон!
Dialogue: 0,1:10:52.58,1:10:53.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:53.91,1:10:55.66,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:10:55.91,1:10:57.83,Default,,0,0,0,,Попон! Уф...
Dialogue: 0,1:10:57.96,1:10:58.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:11:02.21,1:11:03.55,Default,,0,0,0,,Әрең қауіпсіз
Dialogue: 0,1:11:04.46,1:11:07.26,Default,,0,0,0,,Күрсін... Ештеңе жетіспейді. О...
Dialogue: 0,1:11:07.68,1:11:09.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:09.93,1:11:11.35,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:11:13.06,1:11:14.47,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:14.60,1:11:16.18,Default,,0,0,0,,Дораэмон қандай да бір құрал!
Dialogue: 0,1:11:16.31,1:11:17.56,Default,,0,0,0,,Бірақ бұл жерде!
Dialogue: 0,1:11:17.69,1:11:19.19,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:11:20.65,1:11:22.11,Default,,0,0,0,,Бірақ мен осылай айналып тұрғанда, қызығы сол, ойым да жұмыс істей бастайды
Dialogue: 0,1:11:22.19,1:11:24.28,Default,,0,0,0,,Дұрыс! қазірдің өзінде!
Dialogue: 0,1:11:24.57,1:11:26.69,Default,,0,0,0,,Жарайды
Dialogue: 0,1:11:29.41,1:11:31.07,Default,,0,0,0,,Бұл! сәуле!
Dialogue: 0,1:11:31.16,1:11:36.00,Default,,0,0,0,,(Горгонның мойыны)
Dialogue: 0,1:11:36.79,1:11:40.42,Default,,0,0,0,,(Горгонның мойын ыңылдауы)
Dialogue: 0,1:11:45.38,1:11:47.59,Default,,0,0,0,,Шизука-чан өте жақсы
Dialogue: 0,1:11:47.72,1:11:50.38,Default,,0,0,0,,Ах... (барлығы) Ах...
Dialogue: 0,1:11:54.35,1:11:55.85,Default,,0,0,0,,(айқай)
Dialogue: 0,1:11:55.93,1:11:58.56,Default,,0,0,0,,Жақсы, иә.
Dialogue: 0,1:11:58.68,1:12:01.85,Default,,0,0,0,,Геппоко мүлдем көмектеспеді.
Dialogue: 0,1:12:01.94,1:12:05.07,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:12:05.19,1:12:09.74,Default,,0,0,0,,А, эй, қарашы, менің ойымша, біз сол жерден кете аламыз.
Dialogue: 0,1:12:10.15,1:12:11.66,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:12:11.78,1:12:13.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:13.20,1:12:15.62,Default,,0,0,0,,О... міне, болды.
Dialogue: 0,1:12:19.29,1:12:20.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:20.33,1:12:23.58,Default,,0,0,0,,Бұл Курттікі... Курт
Dialogue: 0,1:12:24.08,1:12:25.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:25.59,1:12:27.17,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,1:12:27.59,1:12:29.21,Default,,0,0,0,,Хмм…
Dialogue: 0,1:12:29.34,1:12:32.01,Default,,0,0,0,,Жоғалған затты қайтару спрейі
Dialogue: 0,1:12:32.43,1:12:36.51,Default,,0,0,0,,Мені бастапқы иесіне апарыңыз. Жақсы.
Dialogue: 0,1:12:39.89,1:12:41.35,Default,,0,0,0,,Бұл жолдың бұрылысы
Dialogue: 0,1:12:41.48,1:12:43.77,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,1:12:43.90,1:12:44.90,Default,,0,0,0,,А...
Dialogue: 0,1:12:44.98,1:12:46.36,Default,,0,0,0,,Осымен
Dialogue: 0,1:12:46.90,1:12:48.78,Default,,0,0,0,,Ах... Қулықшы Ұры DX!
Dialogue: 0,1:12:49.11,1:12:49.49,Default,,0,0,0,,Бұл өте ақымақ... Бұл...
Dialogue: 0,1:12:49.49,1:12:51.70,Default,,0,0,0,,Бұл өте ақымақ... Бұл...
Dialogue: 0,1:12:49.49,1:12:51.70,Default,,0,0,0,,Мен сені бұл жерден ары қарай жібермеймін.
Dialogue: 0,1:12:51.70,1:12:51.82,Default,,0,0,0,,Бұл өте ақымақ... Бұл...
Dialogue: 0,1:12:51.82,1:12:52.49,Default,,0,0,0,,Бұл өте ақымақ... Бұл...
Dialogue: 0,1:12:51.82,1:12:52.49,Default,,0,0,0,,Не!
Dialogue: 0,1:12:53.86,1:12:57.95,Default,,0,0,0,,Кайто DX Мен сіздің жеке басыңызды білдім.
Dialogue: 0,1:12:58.08,1:12:58.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:00.87,1:13:02.66,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:13:03.25,1:13:07.29,Default,,0,0,0,,Қулықшы Ұры DX Оның шынайы тұлғасы...
Dialogue: 0,1:13:07.84,1:13:10.13,Default,,0,0,0,,Тікелей! Бұл директор Фикс!
Dialogue: 0,1:13:10.21,1:13:11.59,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:13:11.72,1:13:13.88,Default,,0,0,0,,Сене сені сөккенде себептерін түсіндіремін.
Dialogue: 0,1:13:14.01,1:13:16.55,Default,,0,0,0,,Нана... неге! Әрине директор.
Dialogue: 0,1:13:16.68,1:13:19.10,Default,,0,0,0,,Дұрыс, куратор күдікті!
Dialogue: 0,1:13:19.60,1:13:23.56,Default,,0,0,0,,№ DX-тің шынайы идентификациясы...
Dialogue: 0,1:13:27.27,1:13:28.36,Default,,0,0,0,,Бұл Курт!
Dialogue: 0,1:13:28.48,1:13:30.19,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:13:30.32,1:13:32.99,Default,,0,0,0,,...Курт осында, солай ма?
Dialogue: 0,1:13:33.11,1:13:35.66,Default,,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,1:13:35.74,1:13:38.41,Default,,0,0,0,,Мырзалар, есіңізде болсын
Dialogue: 0,1:13:38.83,1:13:41.66,Default,,0,0,0,,Анықтамалық линза арқылы көрсетілген кеңестер
Dialogue: 0,1:13:42.04,1:13:44.58,Default,,0,0,0,,А, айналатын есік.
Dialogue: 0,1:13:44.71,1:13:47.54,Default,,0,0,0,,Жоқ, бұл есік емес, бұл есік.
Dialogue: 0,1:13:47.67,1:13:49.13,Default,,0,0,0,,Айналмалы есік...
Dialogue: 0,1:13:49.46,1:13:50.67,Default,,0,0,0,,Басқаша айтқанда, «Куруто»
Dialogue: 0,1:13:50.80,1:13:52.21,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:13:52.34,1:13:55.34,Default,,0,0,0,,Бұл ақымақ, шынымен де ақымақ.
Dialogue: 0,1:13:55.59,1:13:58.51,Default,,0,0,0,,Попонның да көзқарасы біртүрлі болды.
Dialogue: 0,1:13:59.10,1:14:02.27,Default,,0,0,0,,Мен сені алдымен Куртқа секірерсің деп ойладым.
Dialogue: 0,1:14:03.14,1:14:06.69,Default,,0,0,0,,Жарайды... бұл Шидзука-чанға ұнағаны ғой, солай ма?
Dialogue: 0,1:14:06.77,1:14:10.86,Default,,0,0,0,,Ең бастысы, бұл ең сенімді дәлел!
Dialogue: 0,1:14:10.94,1:14:12.11,Default,,0,0,0,,Ах! Ха...
Dialogue: 0,1:14:13.24,1:14:15.45,Default,,0,0,0,,Курт оны ертерек тастады.
Dialogue: 0,1:14:15.57,1:14:19.49,Default,,0,0,0,,Барлығының қайда екенін көрсететін осы мониторды мұқият қарап шығуыңызды қалаймын.
Dialogue: 0,1:14:19.62,1:14:20.99,Default,,0,0,0,,Ах
Dialogue: 0,1:14:21.12,1:14:23.79,Default,,0,0,0,,Курттың екі ақ шеңбері бар!
Dialogue: 0,1:14:23.87,1:14:25.41,Default,,0,0,0,,А... а...
Dialogue: 0,1:14:25.54,1:14:28.96,Default,,0,0,0,,Иә, бұл бір ғана жауапты көрсетеді.
Dialogue: 0,1:14:29.08,1:14:30.21,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:31.13,1:14:32.92,Default,,0,0,0,,Бұл Курттың шынайы тұлғасы қандай...?
Dialogue: 0,1:14:35.17,1:14:36.59,Default,,0,0,0,,Міне!
Dialogue: 0,1:14:40.05,1:14:41.97,Default,,0,0,0,,Роботты көшіру!
Dialogue: 0,1:14:43.02,1:14:45.23,Default,,0,0,0,,Курт Неге?
Dialogue: 0,1:14:45.35,1:14:47.69,Default,,0,0,0,,Мен... Мен Курт емеспін.
Dialogue: 0,1:14:48.52,1:14:53.40,Default,,0,0,0,,Дораемонның қоңырауын алған кінәлі Курт болды...
Dialogue: 0,1:14:53.65,1:14:56.49,Default,,0,0,0,,Ух... аа... а
Dialogue: 0,1:15:02.49,1:15:03.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:04.70,1:15:07.66,Default,,0,0,0,,(айқай)
Dialogue: 0,1:15:07.79,1:15:09.75,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,1:15:10.25,1:15:14.05,Default,,0,0,0,,Неліктен Курт DX болды?
Dialogue: 0,1:15:14.17,1:15:18.34,Default,,0,0,0,,Бұл менің қожайынымның арманын орындау.
Dialogue: 0,1:15:18.47,1:15:20.22,Default,,0,0,0,,Курттың мұғалімі?
Dialogue: 0,1:15:20.55,1:15:24.64,Default,,0,0,0,,Бір күні мұражайдан жасырын үзінді тауып алдым.
Dialogue: 0,1:15:24.72,1:15:26.60,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:15:28.14,1:15:29.14,Default,,0,0,0,,А... ә?
Dialogue: 0,1:15:30.19,1:15:32.02,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:32.69,1:15:36.07,Default,,0,0,0,,Итта тата... Не... Не? Міне
Dialogue: 0,1:15:36.32,1:15:38.11,Default,,0,0,0,,Келіңіздер... Та! уф ахх
Dialogue: 0,1:15:38.24,1:15:39.66,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:15:40.36,1:15:45.24,Default,,0,0,0,,Иттете... Сен несің! Қайдан кірдің!
Dialogue: 0,1:15:45.70,1:15:47.54,Default,,0,0,0,,Не болып жатыр? Не болды?
Dialogue: 0,1:15:47.66,1:15:51.00,Default,,0,0,0,,Ах! Тамаша, таптым
Dialogue: 0,1:15:51.12,1:15:54.46,Default,,0,0,0,,Мен осындай түсінікті жерде кіре-шығу жасаймын!
Dialogue: 0,1:15:54.59,1:15:55.71,Default,,0,0,0,,Бұл жағдайда не істеуіміз керек?
Dialogue: 0,1:15:55.84,1:15:59.22,Default,,0,0,0,,Доктор Пеплер сіздің ұстазыңыз болды ма?
Dialogue: 0,1:15:59.34,1:16:03.01,Default,,0,0,0,,Көп ұзамай мен дәрігерден құрал жасауды үйрендім...
Dialogue: 0,1:16:03.14,1:16:05.68,Default,,0,0,0,,Мен дәрігердің жұмысына көмектесе бастадым.
Dialogue: 0,1:16:06.01,1:16:09.89,Default,,0,0,0,,Дәрігер ұзақ уақыт бойы металды металды зерттеді.
Dialogue: 0,1:16:10.19,1:16:11.60,Default,,0,0,0,,Пеплер металы?
Dialogue: 0,1:16:11.73,1:16:16.19,Default,,0,0,0,,Бұл қалған толық металды алмастыра алатын жаңа металл.
Dialogue: 0,1:16:16.57,1:16:20.53,Default,,0,0,0,,Дәрігер жасырын құрал жөндеу шеберханасына кірмейді...
Dialogue: 0,1:16:20.65,1:16:23.87,Default,,0,0,0,,Бөлшектерді қырып алу және жабдықты пайдалану кезінде...
Dialogue: 0,1:16:23.95,1:16:25.87,Default,,0,0,0,,Олар құрылғылар жасауды жалғастырған көрінеді.
Dialogue: 0,1:16:25.99,1:16:27.33,Default,,0,0,0,,Жақсы, жақсы, жақсы.
Dialogue: 0,1:16:27.41,1:16:29.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:29.16,1:16:33.25,Default,,0,0,0,,Бірақ сол күні полиция мені ақыры ұстады...
Dialogue: 0,1:16:33.54,1:16:39.67,Default,,0,0,0,,Иә, қарғыс атсын, мен мұнда ұсталсам, бұл жігітті де тәркілейді.
Dialogue: 0,1:16:39.80,1:16:43.18,Default,,0,0,0,,Кем дегенде осы микрочип
Dialogue: 0,1:16:48.22,1:16:49.35,Default,,0,0,0,,Міне, сіз!
Dialogue: 0,1:16:49.85,1:16:51.10,Default,,0,0,0,,Ха... (полиция қызметкері) Тезірек!
Dialogue: 0,1:16:51.23,1:16:53.44,Default,,0,0,0,,Міне осылай. (Полиция қызметкері) Айналыңыз.
Dialogue: 0,1:16:54.19,1:16:57.77,Default,,0,0,0,,Менің қоңырауым сонда болды ма?
Dialogue: 0,1:16:57.86,1:17:00.15,Default,,0,0,0,,Ол кезде менің жасырғаным...
Dialogue: 0,1:17:00.28,1:17:04.36,Default,,0,0,0,,Құрал-саймандардың көпшілігі осы мұражайға жөндеуге жіберілген.
Dialogue: 0,1:17:05.70,1:17:09.83,Default,,0,0,0,,Біз бұл микрочипті еш нәрсеге қарамастан қайтаруымыз керек.
Dialogue: 0,1:17:09.91,1:17:11.58,Default,,0,0,0,,Ия, істе, істе!
Dialogue: 0,1:17:11.71,1:17:12.66,Default,,0,0,0,,...бұл ақымақтық
Dialogue: 0,1:17:12.79,1:17:15.79,Default,,0,0,0,,Мұражайдан ұрлық жасау мүмкін емес.
Dialogue: 0,1:17:15.92,1:17:17.34,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,1:17:17.79,1:17:20.46,Default,,0,0,0,,Бұл сіздің ақымақ құралдарыңызбен мүмкін емес.
Dialogue: 0,1:17:20.59,1:17:22.84,Default,,0,0,0,,Бұл сөзсіз мүмкін!
Dialogue: 0,1:17:24.30,1:17:27.60,Default,,0,0,0,,Мен доктордан кеңес алып жатқанда.
Dialogue: 0,1:17:27.72,1:17:30.52,Default,,0,0,0,,Мен фантом ұры DX костюмін жасадым
Dialogue: 0,1:17:32.89,1:17:36.15,Default,,0,0,0,,Уау... хахаха
Dialogue: 0,1:17:36.27,1:17:38.27,Default,,0,0,0,,Мұны жасырын түрде жасамаңыз.
Dialogue: 0,1:17:38.40,1:17:41.32,Default,,0,0,0,,Өйткені сіз елес ұрылар туралы ойласаңыз, бұл ескерту, солай емес пе?
Dialogue: 0,1:17:41.44,1:17:43.45,Default,,0,0,0,,Күрсін... Хе... Хе!
Dialogue: 0,1:17:47.49,1:17:50.91,Default,,0,0,0,,О! Бұл керемет Курт!
Dialogue: 0,1:17:51.24,1:17:53.87,Default,,0,0,0,,​​Бұл нені білдіреді?
Dialogue: 0,1:17:54.00,1:17:55.83,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,1:17:55.96,1:18:00.38,Default,,0,0,0,,Сонымен куратордың күдікті әрекеті ше? Бұл не болды?
Dialogue: 0,1:18:00.75,1:18:03.55,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,1:18:04.05,1:18:05.55,Default,,0,0,0,,Бұл сіздің пайдалануыңыз үшін!
Dialogue: 0,1:18:05.63,1:18:07.97,Default,,0,0,0,,Уау! (Қыша) Жұмбақ бол!
Dialogue: 0,1:18:08.39,1:18:13.98,Default,,0,0,0,,Директор Фикс, мен табиғат мұражайына шабуыл жасаған кінәлі сіз деп ешқашан ойламадым.
Dialogue: 0,1:18:14.10,1:18:16.94,Default,,0,0,0,,Бұл қандай да бір қателік!
Dialogue: 0,1:18:17.23,1:18:19.65,Default,,0,0,0,,Хехехе…
Dialogue: 0,1:18:19.98,1:18:23.40,Default,,0,0,0,,Идиот! Мен бәрін жинауым керек еді... Ой.
Dialogue: 0,1:18:23.61,1:18:26.03,Default,,0,0,0,,Жоқ... бұл мен емес!
Dialogue: 0,1:18:26.15,1:18:28.78,Default,,0,0,0,,Сіз әлі де телефон тұтқасын қоясыз ба? Шынымды айтсам, радиотолқындар!
Dialogue: 0,1:18:28.91,1:18:29.83,Default,,0,0,0,,Уаааа
Dialogue: 0,1:18:31.08,1:18:34.54,Default,,0,0,0,,Уф, мен жасадым!
Dialogue: 0,1:18:35.00,1:18:39.42,Default,,0,0,0,,Хмм, неге бұлай істегеніңізді түсіндіре аласыз ба?
Dialogue: 0,1:18:39.54,1:18:44.55,Default,,0,0,0,,Іс жүзінде... шын мәнінде...
Dialogue: 0,1:18:44.63,1:18:46.97,Default,,0,0,0,,Ха! ? Хесокури! ?
Dialogue: 0,1:18:47.22,1:18:49.55,Default,,0,0,0,,Иә, куратор...
Dialogue: 0,1:18:49.68,1:18:53.35,Default,,0,0,0,,Табиғат мұражайындағы құпия құралдардың арасына тығылған қарын...
Dialogue: 0,1:18:53.47,1:18:57.44,Default,,0,0,0,,Мен мұны жасадым, себебі DX мені алып кетеді деп қорықтым.
Dialogue: 0,1:18:57.52,1:19:01.90,Default,,0,0,0,,Ух... бұл жарты жыл бұрын болды.
Dialogue: 0,1:19:02.02,1:19:03.15,Default,,0,0,0,,(гүл шайнайтын дыбыс)
Dialogue: 0,1:19:03.61,1:19:08.03,Default,,0,0,0,,Ммм! Менің ішімде көп ақша бар
Dialogue: 0,1:19:08.16,1:19:10.32,Default,,0,0,0,,Оны қайда жасыруым керек?
Dialogue: 0,1:19:10.45,1:19:13.79,Default,,0,0,0,,Мм... Шөп шабатын балық
Dialogue: 0,1:19:14.49,1:19:16.46,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:16.58,1:19:19.62,Default,,0,0,0,,Кез келген нәрсеге арналған банка жасау машинасы
Dialogue: 0,1:19:24.05,1:19:25.80,Default,,0,0,0,,Нихехехе…
Dialogue: 0,1:19:26.21,1:19:30.18,Default,,0,0,0,,PIN нөмірі – “132109”
Dialogue: 0,1:19:30.30,1:19:35.31,Default,,0,0,0,,〝･････ 〞
Dialogue: 0,1:19:36.60,1:19:40.56,Default,,0,0,0,,Жарайды, мұнымен сені ешкім таба алмайды.
Dialogue: 0,1:19:40.69,1:19:43.44,Default,,0,0,0,,Әй... (хатшы) Директор, кездесу уақыты келді.
Dialogue: 0,1:19:43.57,1:19:46.32,Default,,0,0,0,,Иә, мен қазір барамын.
Dialogue: 0,1:19:50.45,1:19:53.58,Default,,0,0,0,,Иә? Ха... у... хехе
Dialogue: 0,1:19:54.16,1:19:57.20,Default,,0,0,0,,Шәй, шай.
Dialogue: 0,1:19:58.16,1:20:00.75,Default,,0,0,0,,Хахаха, мұражайдағы құбыжық...
Dialogue: 0,1:20:00.87,1:20:03.42,Default,,0,0,0,,Әңгіме болып жатқан бала ма?
Dialogue: 0,1:20:03.54,1:20:05.42,Default,,0,0,0,,Эххехе…
Dialogue: 0,1:20:07.17,1:20:09.42,Default,,0,0,0,,Оны дайын етіп қойыңыз.
Dialogue: 0,1:20:11.51,1:20:12.68,Default,,0,0,0,,Көзге тию
Dialogue: 0,1:20:14.35,1:20:17.85,Default,,0,0,0,,Сол кезде партада тұрған жұмыртқалайтын шам...
Dialogue: 0,1:20:17.97,1:20:20.02,Default,,0,0,0,,Мен оны тастап кеткен сияқтымын.
Dialogue: 0,1:20:25.86,1:20:27.44,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,1:20:27.57,1:20:28.65,Default,,0,0,0,,Уау! Иә?
Dialogue: 0,1:20:29.15,1:20:31.61,Default,,0,0,0,,Нана Нана... Бұл не?!
Dialogue: 0,1:20:31.86,1:20:34.07,Default,,0,0,0,,Не?
Dialogue: 0,1:20:34.20,1:20:38.75,Default,,0,0,0,,Иә, дәл солай. Табиғат орталығындағы шөп шабу үшін осы жігіттерді пайдалануымыз керек.
Dialogue: 0,1:20:38.87,1:20:39.96,Default,,0,0,0,,Иә! Жоқ... жоқ, сәл ғана
Dialogue: 0,1:20:40.08,1:20:42.83,Default,,0,0,0,,Олардың кейбіреулері менікі!
Dialogue: 0,1:20:44.96,1:20:48.34,Default,,0,0,0,,Содан бастап түн ортасында куратор...
Dialogue: 0,1:20:48.46,1:20:51.93,Default,,0,0,0,,Мұражайдың бақылау жүйесін небәрі үш минутта өшіруге болады.
Dialogue: 0,1:20:52.05,1:20:54.93,Default,,0,0,0,,Табиғат мұражайына жасырын кіріп, көгалдағы балықты жеу.
Dialogue: 0,1:20:55.05,1:20:58.10,Default,,0,0,0,,Мен бірінен соң бірін тергедім.
Dialogue: 0,1:20:58.89,1:21:02.77,Default,,0,0,0,,132109 Бұл да басқа.
Dialogue: 0,1:21:03.27,1:21:05.48,Default,,0,0,0,,Барлығын білгіңіз келетініне сенімдісіз бе?
Dialogue: 0,1:21:05.61,1:21:07.23,Default,,0,0,0,,Сізде батыл бар, иә.
Dialogue: 0,1:21:07.32,1:21:12.20,Default,,0,0,0,,Қалған төртеуін зерттемек болғанымда, DX хабарламасын алдым...
Dialogue: 0,1:21:12.32,1:21:14.95,Default,,0,0,0,,Мен сізге маңызды құпия құрал алуға келдім.
Dialogue: 0,1:21:15.53,1:21:17.91,Default,,0,0,0,,Мұнда табиғат мұражайы көрсетілген.
Dialogue: 0,1:21:18.24,1:21:22.04,Default,,0,0,0,,Біреу іші бар балықты ұстап алған жағдайда...
Dialogue: 0,1:21:22.16,1:21:24.58,Default,,0,0,0,,Мен төзгісіз қобалжып тұрмын...
Dialogue: 0,1:21:24.67,1:21:26.67,Default,,0,0,0,,Уау! (Қыша) Та... Эвакуациялаңыз!
Dialogue: 0,1:21:26.75,1:21:28.63,Default,,0,0,0,,Шыу!
Dialogue: 0,1:21:29.09,1:21:33.47,Default,,0,0,0,,Сөйтіп олар барлығын сыртқа бұршақпен лақтырып,...
Dialogue: 0,1:21:33.59,1:21:36.93,Default,,0,0,0,,Соңғы төртеуін зерттеу үшін осы мүмкіндікті пайдаландыңыз ба?
Dialogue: 0,1:21:37.22,1:21:39.93,Default,,0,0,0,,Дұрыс! Мен мұны ақырында жасадым!
Dialogue: 0,1:21:40.56,1:21:43.44,Default,,0,0,0,,Қайтып келді, ішім!
Dialogue: 0,1:21:43.56,1:21:46.77,Default,,0,0,0,,А... А, жақсы екен.
Dialogue: 0,1:21:46.98,1:21:49.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:21:49.23,1:21:51.74,Default,,0,0,0,,Мен күдіктеніп, ақша жоғалттым.
Dialogue: 0,1:21:51.86,1:21:53.65,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:53.78,1:21:58.37,Default,,0,0,0,,Сонда да мен түсінбейтін тағы бір нәрсе бар.
Dialogue: 0,1:21:58.49,1:22:02.62,Default,,0,0,0,,Курт-сан, сенің орнына көшіруші робот қашан келді?
Dialogue: 0,1:22:02.75,1:22:04.66,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,1:22:04.92,1:22:08.13,Default,,0,0,0,,А... Мм, мен жуынатын бөлмеге бара жатырмын.
Dialogue: 0,1:22:08.21,1:22:09.29,Default,,0,0,0,,Қазір оралыңыз!
Dialogue: 0,1:22:09.42,1:22:10.34,Default,,0,0,0,,Геппоко!
Dialogue: 0,1:22:11.17,1:22:12.80,Default,,0,0,0,,Мен кешігіп қалдым. Кешіріңіз. Кешіріңіз.
Dialogue: 0,1:22:18.80,1:22:20.31,Default,,0,0,0,,Олай болса, рахмет.
Dialogue: 0,1:22:20.43,1:22:21.47,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:22:25.56,1:22:28.15,Default,,0,0,0,,Уау (Пеплар) Хмм.
Dialogue: 0,1:22:28.23,1:22:29.11,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,1:22:29.19,1:22:33.28,Default,,0,0,0,,Ол кезде көшіруші робот болды ма?
Dialogue: 0,1:22:33.40,1:22:35.99,Default,,0,0,0,,Фухахаха... (Нобита) Уау! Уф...
Dialogue: 0,1:22:36.07,1:22:38.74,Default,,0,0,0,,Барлығы жақсы өтті.
Dialogue: 0,1:22:38.82,1:22:42.49,Default,,0,0,0,,Енді доктор Пеплердің арманы ақыры орындалады.
Dialogue: 0,1:22:42.87,1:22:44.20,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:22:44.33,1:22:45.50,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:22:46.08,1:22:48.00,Default,,0,0,0,,Мен енді тоқтай алмаймын!
Dialogue: 0,1:22:48.33,1:22:49.33,Default,,0,0,0,,Уф! Ахх
Dialogue: 0,1:22:49.46,1:22:50.67,Default,,0,0,0,,Курт!
Dialogue: 0,1:22:59.14,1:23:00.97,Default,,0,0,0,,Курто!
Dialogue: 0,1:23:02.85,1:23:03.85,Default,,0,0,0,,Ei
Dialogue: 0,1:23:05.60,1:23:07.73,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:23:07.85,1:23:11.19,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:11.31,1:23:13.69,Default,,0,0,0,,Уф, уф... (Сунео) Уф, уф...
Dialogue: 0,1:23:13.82,1:23:15.11,Default,,0,0,0,,Ух... а...
Dialogue: 0,1:23:15.24,1:23:16.49,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:23:16.57,1:23:17.99,Default,,0,0,0,,Джан!
Dialogue: 0,1:23:18.11,1:23:19.20,Default,,0,0,0,,Сунео!
Dialogue: 0,1:23:19.70,1:23:22.33,Default,,0,0,0,,Жарайды! Есікті аша алатыныңызды қараңыз!
Dialogue: 0,1:23:22.83,1:23:25.91,Default,,0,0,0,,Мына жерде доктор Пеплер бар.
Dialogue: 0,1:23:27.62,1:23:30.67,Default,,0,0,0,,Дәрігер! Нобита мен оның достары жақын жерде!
Dialogue: 0,1:23:30.79,1:23:33.71,Default,,0,0,0,,Мен түсіндім, бұл қазір маңызды!
Dialogue: 0,1:23:34.00,1:23:38.84,Default,,0,0,0,,Соны бассаң... уф... есік ашылады! Уф...
Dialogue: 0,1:23:38.93,1:23:41.05,Default,,0,0,0,,А... а...
Dialogue: 0,1:23:41.43,1:23:44.22,Default,,0,0,0,,Дааааа! Апыр-ай!
Dialogue: 0,1:23:44.51,1:23:46.18,Default,,0,0,0,,Сунео! (Сунео) Ах!
Dialogue: 0,1:23:46.43,1:23:49.64,Default,,0,0,0,,Уау! Вачи... уф...
Dialogue: 0,1:23:50.44,1:23:52.56,Default,,0,0,0,,Та...рахмет.
Dialogue: 0,1:23:52.69,1:23:54.11,Default,,0,0,0,,Иә (Сунео) Иә?
Dialogue: 0,1:23:54.52,1:23:57.07,Default,,0,0,0,,Бұл... үлкен жарық!
Dialogue: 0,1:23:57.53,1:23:59.45,Default,,0,0,0,,Дораэмон, кейбір құралдар...
Dialogue: 0,1:23:59.57,1:24:02.78,Default,,0,0,0,,Ха! (Нобита) Бірақ жұмсақ қабығы бар тасбақа роботы бар!
Dialogue: 0,1:24:03.03,1:24:06.75,Default,,0,0,0,,Егер біз осылай жасасақ...
Dialogue: 0,1:24:06.87,1:24:08.00,Default,,0,0,0,,Уф... аааа
Dialogue: 0,1:24:08.37,1:24:14.42,Default,,0,0,0,,Уау! О... Хаха... Ухаха!
Dialogue: 0,1:24:14.88,1:24:18.63,Default,,0,0,0,,Тағы бір нәрсе, Зімбір, оны қайтар.
Dialogue: 0,1:24:18.76,1:24:21.34,Default,,0,0,0,,Иә? Маған ұнады
Dialogue: 0,1:24:27.27,1:24:29.31,Default,,0,0,0,,Джан! (Нобита) Қалыптыға оралдың ба?
Dialogue: 0,1:24:29.43,1:24:31.73,Default,,0,0,0,,Сунеоның жетістігі (Сунео) Ахаха
Dialogue: 0,1:24:33.52,1:24:35.02,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:24:35.15,1:24:37.53,Default,,0,0,0,,Менің қоңырауым!
Dialogue: 0,1:24:41.49,1:24:44.37,Default,,0,0,0,,А... аа... біраз...
Dialogue: 0,1:24:44.45,1:24:46.53,Default,,0,0,0,,Хехе...
Dialogue: 0,1:24:46.66,1:24:49.45,Default,,0,0,0,,Енді сізде барлық бөліктер бар!
Dialogue: 0,1:24:49.70,1:24:55.46,Default,,0,0,0,,Сіз де осы дүниенің өзгеретін сәтін көре аласыз!
Dialogue: 0,1:25:02.13,1:25:07.35,Default,,0,0,0,,(Мүлдір күлкі)
Dialogue: 0,1:25:07.47,1:25:09.97,Default,,0,0,0,,Бұл ақыры басталды!
Dialogue: 0,1:25:10.10,1:25:13.48,Default,,0,0,0,,Біріншіден, бұл мұражайдағы барлық толық металдар...
Dialogue: 0,1:25:13.60,1:25:16.11,Default,,0,0,0,,Мен оны Peppler Metal деп өзгертемін!
Dialogue: 0,1:25:16.19,1:25:19.07,Default,,0,0,0,,Хахахаха! (Барлығы) Ах...
Dialogue: 0,1:25:19.57,1:25:22.03,Default,,0,0,0,,Әй, не? Не? ше?
Dialogue: 0,1:25:22.49,1:25:24.53,Default,,0,0,0,,Сәлем...құпия құрал...
Dialogue: 0,1:25:24.66,1:25:26.78,Default,,0,0,0,,(Гран Торино) Өкінішті. Мұндай ұсақ-түйекке тіпті реакция бере алмасаң—
Dialogue: 0,1:25:29.04,1:25:33.33,Default,,0,0,0,,Мұқаба... аа... хаха
Dialogue: 0,1:25:33.46,1:25:36.38,Default,,0,0,0,,Иә? Не... не! ?
Dialogue: 0,1:25:36.46,1:25:37.42,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,1:25:37.54,1:25:38.84,Default,,0,0,0,,Көшірудің 90 пайызы аяқталған сәтте—
Dialogue: 0,1:25:39.25,1:25:41.01,Default,,0,0,0,,Құпия құрал...
Dialogue: 0,1:25:41.13,1:25:42.55,Default,,0,0,0,,жоғалады
Dialogue: 0,1:25:46.26,1:25:49.01,Default,,0,0,0,,Менің қоңырауым! Ах... аа...
Dialogue: 0,1:25:49.14,1:25:50.22,Default,,0,0,0,,Ах! иә?
Dialogue: 0,1:25:50.64,1:25:52.56,Default,,0,0,0,,Шерлок Холмс та қойылды!
Dialogue: 0,1:25:52.68,1:25:53.94,Default,,0,0,0,,Таратқыш
Dialogue: 0,1:25:54.23,1:25:56.15,Default,,0,0,0,,Бұл... бұл не?
Dialogue: 0,1:25:56.23,1:25:59.11,Default,,0,0,0,,Уа, не болып жатыр?
Dialogue: 0,1:26:06.41,1:26:10.74,Default,,0,0,0,,Идиот... Неге бұлай болып жатыр?
Dialogue: 0,1:26:10.95,1:26:13.75,Default,,0,0,0,,Не болды?
Dialogue: 0,1:26:14.16,1:26:17.29,Default,,0,0,0,,Толық металл... жоғалып кетті.
Dialogue: 0,1:26:17.42,1:26:18.21,Default,,0,0,0,,Е...
Dialogue: 0,1:26:18.29,1:26:23.17,Default,,0,0,0,,Мұражайдағы барлық металдар жоғалып кетті!
Dialogue: 0,1:26:23.42,1:26:24.88,Default,,0,0,0,,Не?!
Dialogue: 0,1:26:24.97,1:26:26.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:26.55,1:26:29.89,Default,,0,0,0,,Жоқ! Жұмсақ қабығы бар тасбақа роботы жоғалып кетті!
Dialogue: 0,1:26:30.01,1:26:31.89,Default,,0,0,0,,Сонымен, басқа құралдар ше?
Dialogue: 0,1:26:32.02,1:26:34.52,Default,,0,0,0,,Қалғанның бәрі қоқыс.
Dialogue: 0,1:26:34.64,1:26:37.73,Default,,0,0,0,,Барлық құпия құралдар жоғалып кетті.
Dialogue: 0,1:26:37.85,1:26:39.40,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,1:26:39.48,1:26:42.82,Default,,0,0,0,,О... құдай-ау
Dialogue: 0,1:26:42.94,1:26:45.57,Default,,0,0,0,,Бұл тағы да сәтсіздік...
Dialogue: 0,1:26:45.65,1:26:46.74,Default,,0,0,0,,Ой
Dialogue: 0,1:26:46.86,1:26:48.03,Default,,0,0,0,,Не... не?
Dialogue: 0,1:26:48.11,1:26:51.95,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:26:53.66,1:26:54.41,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:54.50,1:26:57.92,Default,,0,0,0,,Эй... бұл не болып жатыр?
Dialogue: 0,1:26:58.17,1:27:00.04,Default,,0,0,0,,Күн шығаратын машина!
Dialogue: 0,1:27:00.17,1:27:01.59,Default,,0,0,0,,Ах (Кездейсiн) А...
Dialogue: 0,1:27:02.00,1:27:03.09,Default,,0,0,0,,Курт
Dialogue: 0,1:27:03.67,1:27:05.30,Default,,0,0,0,,Әй, әлгі жігіт!
Dialogue: 0,1:27:05.38,1:27:07.38,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:27:07.51,1:27:08.47,Default,,0,0,0,,Пеплер! (Пеплар) Уф...
Dialogue: 0,1:27:08.84,1:27:11.64,Default,,0,0,0,,Сіз осындай жерде қамауға алындыңыз...
Dialogue: 0,1:27:11.76,1:27:12.97,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:27:13.72,1:27:16.43,Default,,0,0,0,,Қазір олай айтатын уақыт емес.
Dialogue: 0,1:27:17.31,1:27:21.11,Default,,0,0,0,,Күн шығаратын машина басқарудан шыға бастады.
Dialogue: 0,1:27:21.23,1:27:23.02,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:27:23.11,1:27:24.94,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,1:27:25.07,1:27:28.49,Default,,0,0,0,,Доктор Хартман жасаған толық металды нығыздау құрылғысы...
Dialogue: 0,1:27:28.57,1:27:31.91,Default,,0,0,0,,Жарығымыздан айырылдық.
Dialogue: 0,1:27:32.03,1:27:34.20,Default,,0,0,0,,Сол кездегідей.
Dialogue: 0,1:27:34.74,1:27:39.42,Default,,0,0,0,,Жасанды күннің уақыт осі бұрмаланып, жылдам қозғалуда.
Dialogue: 0,1:27:39.87,1:27:45.42,Default,,0,0,0,,Бұлай жалғаса берсе, күн кеңейіп, қызыл алып жұлдызға айналады.
Dialogue: 0,1:27:45.55,1:27:48.34,Default,,0,0,0,,Жерді ерітіп жіберер еді
Dialogue: 0,1:27:48.47,1:27:50.93,Default,,0,0,0,,Бірнеше сағаттан кейін
Dialogue: 0,1:27:53.55,1:27:55.72,Default,,0,0,0,,Қозғалысты қалай тоқтатуға болады?
Dialogue: 0,1:27:55.85,1:27:59.48,Default,,0,0,0,,Сол кезде мұны тоқтатқан Хартман болды.
Dialogue: 0,1:27:59.60,1:28:01.44,Default,,0,0,0,,Тек оның қолынан келеді
Dialogue: 0,1:28:01.56,1:28:03.77,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,1:28:04.19,1:28:08.65,Default,,0,0,0,,Мен тағы да осындай ақымақтық жасадым.
Dialogue: 0,1:28:08.78,1:28:13.53,Default,,0,0,0,,Неге десеңіз, мен үмітсіз, түкке тұрғысыз ғалыммын.
Dialogue: 0,1:28:15.62,1:28:16.70,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,1:28:17.04,1:28:18.25,Default,,0,0,0,,Курт?
Dialogue: 0,1:28:21.08,1:28:23.17,Default,,0,0,0,,Дәрігер, мен істеймін.
Dialogue: 0,1:28:23.25,1:28:24.54,Default,,0,0,0,,Иә? (Пеплар) Иә?
Dialogue: 0,1:28:25.46,1:28:28.30,Default,,0,0,0,,Күн шығаратын машинаны тоқтатамын!
Dialogue: 0,1:28:28.55,1:28:29.63,Default,,0,0,0,,Курт
Dialogue: 0,1:28:30.13,1:28:32.51,Default,,0,0,0,,Дәрігер жаман ғалым емес!
Dialogue: 0,1:28:33.22,1:28:36.01,Default,,0,0,0,,Дәрігер мұны маған бұрын да айтқан.
Dialogue: 0,1:28:36.14,1:28:39.98,Default,,0,0,0,,Менің жақсы жағым – сәтсіздікке ұшырасам да берілмеймін.
Dialogue: 0,1:28:40.35,1:28:44.77,Default,,0,0,0,,Дәрігерлер де солай. Олар бас тартуда нашар, жеңілгенді жек көреді...
Dialogue: 0,1:28:44.90,1:28:48.19,Default,,0,0,0,,Дәрігерлердің жақсы жағы - олар өздеріне тым сенімді.
Dialogue: 0,1:28:48.65,1:28:52.36,Default,,0,0,0,,Атамнан ұтыла алмаймын деп, тынбай еңбек ететін бір дәрігер болған...
Dialogue: 0,1:28:52.49,1:28:54.03,Default,,0,0,0,,Маған ұнады!
Dialogue: 0,1:28:54.99,1:28:58.45,Default,,0,0,0,,Дәрігер атама-
Dialogue: 0,1:28:58.58,1:29:02.00,Default,,0,0,0,,Доктор Хартманнан жеңілген дұрыс па?
Dialogue: 0,1:29:02.87,1:29:04.88,Default,,0,0,0,,Осылай бітсе жарай ма?
Dialogue: 0,1:29:04.96,1:29:07.46,Default,,0,0,0,,Ха...Курт...
Dialogue: 0,1:29:11.38,1:29:13.80,Default,,0,0,0,,Жоқ, мен жеңілмеймін.
Dialogue: 0,1:29:15.35,1:29:18.89,Default,,0,0,0,,Мен ешқашан берілмеймін
Dialogue: 0,1:29:19.02,1:29:20.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:20.81,1:29:23.23,Default,,0,0,0,,Peppler машинасын кері айналдырыңыз.
Dialogue: 0,1:29:23.35,1:29:27.02,Default,,0,0,0,,Толық металды қалпына келтіре алатынымызды көрейік! Хмф
Dialogue: 0,1:29:27.11,1:29:28.61,Default,,0,0,0,,Дәрігер!
Dialogue: 0,1:29:28.73,1:29:30.03,Default,,0,0,0,,Курт!
Dialogue: 0,1:29:30.23,1:29:31.49,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,1:29:31.61,1:29:32.95,Default,,0,0,0,,Мен де! мен де
Dialogue: 0,1:29:33.07,1:29:34.53,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,1:29:34.66,1:29:36.62,Default,,0,0,0,,Сонымен... солай сияқты.
Dialogue: 0,1:29:36.70,1:29:40.04,Default,,0,0,0,,Жарайды, бәріміз күннің кеңеюін тоқтатайық.
Dialogue: 0,1:29:40.16,1:29:41.20,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:29:41.33,1:29:42.58,Default,,0,0,0,,Директор мен инспектор-
Dialogue: 0,1:29:42.83,1:29:45.37,Default,,0,0,0,,Ғимаратта қалғандарды эвакуациялаңыз!
Dialogue: 0,1:29:45.75,1:29:47.67,Default,,0,0,0,,Дұрыс! (Қыша) Тезірек!
Dialogue: 0,1:29:47.96,1:29:49.92,Default,,0,0,0,,Курт мен мұны сұрадым!
Dialogue: 0,1:29:50.05,1:29:51.13,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:53.67,1:29:55.30,Default,,0,0,0,,Әй... иә?
Dialogue: 0,1:29:56.14,1:29:59.60,Default,,0,0,0,,Уа... Хееее!
Dialogue: 0,1:29:59.72,1:30:00.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:02.18,1:30:04.48,Default,,0,0,0,,Эй... шықты!
Dialogue: 0,1:30:04.56,1:30:07.90,Default,,0,0,0,,Қалай болғанда да, күнді әйтеуір кішірейтуіміз керек.
Dialogue: 0,1:30:07.98,1:30:11.36,Default,,0,0,0,,Менің құралдарым толық металды пайдаланбайды, сондықтан олар жоғалып кеткен жоқ!
Dialogue: 0,1:30:12.15,1:30:13.82,Default,,0,0,0,,О! Қарғыс атқыр...
Dialogue: 0,1:30:17.37,1:30:19.49,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:30:19.58,1:30:20.91,Default,,0,0,0,,Міне!
Dialogue: 0,1:30:31.71,1:30:34.72,Default,,0,0,0,,Жоқ, мен мүлдем шыдай алмаймын.
Dialogue: 0,1:30:34.97,1:30:38.18,Default,,0,0,0,,Күн энергия шары іспеттес.
Dialogue: 0,1:30:38.30,1:30:40.14,Default,,0,0,0,,Судың мағынасы жоқ...
Dialogue: 0,1:30:40.26,1:30:42.81,Default,,0,0,0,,Аа, дұрыс! Ха
Dialogue: 0,1:30:42.93,1:30:44.10,Default,,0,0,0,,Ах... чо чо о
Dialogue: 0,1:30:44.23,1:30:45.81,Default,,0,0,0,,Гипер шаңсорғыш!
Dialogue: 0,1:30:45.94,1:30:49.19,Default,,0,0,0,,Шағын қара тесік күнді сорып алуы мүмкін.
Dialogue: 0,1:30:49.31,1:30:50.57,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:30:50.69,1:30:52.73,Default,,0,0,0,,Кейбір прототиптер болуы керек.
Dialogue: 0,1:30:52.98,1:30:56.24,Default,,0,0,0,,Жарайды, бөлініп, күнге дем алайық!
Dialogue: 0,1:30:56.36,1:30:57.28,Default,,0,0,0,,Ой
Dialogue: 0,1:30:57.41,1:30:58.95,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:02.74,1:31:04.54,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:04.83,1:31:06.50,Default,,0,0,0,,Мияу мияу
Dialogue: 0,1:31:06.62,1:31:08.04,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:08.12,1:31:10.25,Default,,0,0,0,,Га... Бұл күзетші робот!
Dialogue: 0,1:31:10.63,1:31:12.50,Default,,0,0,0,,Зиянкестерді анықтау және жою
Dialogue: 0,1:31:12.63,1:31:14.71,Default,,0,0,0,,Уау! (Сунео) Неге, неге!
Dialogue: 0,1:31:15.13,1:31:18.18,Default,,0,0,0,,Толық металл тізбек жоғалып кетті және жабайы жұмыс істейді!
Dialogue: 0,1:31:19.01,1:31:20.14,Default,,0,0,0,,Міне!
Dialogue: 0,1:31:22.85,1:31:26.06,Default,,0,0,0,,Нобита-кун, күзетші роботтар туралы бірдеңе жасайық!
Dialogue: 0,1:31:26.18,1:31:27.06,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,1:31:27.14,1:31:28.77,Default,,0,0,0,,Барлығы күнді сұрайды!
Dialogue: 0,1:31:28.90,1:31:29.77,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,1:31:29.98,1:31:32.73,Default,,0,0,0,,Бірдеңе істе... қалай! ?
Dialogue: 0,1:31:33.23,1:31:34.44,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:34.78,1:31:36.40,Default,,0,0,0,,Хмм!
Dialogue: 0,1:31:37.07,1:31:37.86,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:41.07,1:31:43.03,Default,,0,0,0,,Ыстық! (Сунео) Атчи Атчи
Dialogue: 0,1:31:43.12,1:31:44.49,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,1:31:53.17,1:31:54.75,Default,,0,0,0,,Зиянкестерді жою
Dialogue: 0,1:31:57.34,1:31:59.38,Default,,0,0,0,,Ой! Апыр-ай!
Dialogue: 0,1:31:59.88,1:32:02.39,Default,,0,0,0,,Уау! Апыр-ай! Мияу мияу
Dialogue: 0,1:32:02.51,1:32:03.85,Default,,0,0,0,,Мияу... О, ау!
Dialogue: 0,1:32:13.23,1:32:14.73,Default,,0,0,0,,Ата, асығыңыз!
Dialogue: 0,1:32:14.86,1:32:15.78,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:32:15.86,1:32:17.49,Default,,0,0,0,,Зиянкестерді жою
Dialogue: 0,1:32:17.90,1:32:20.07,Default,,0,0,0,,Дораемон, мынаны пайдалан!
Dialogue: 0,1:32:20.15,1:32:21.03,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:23.78,1:32:24.83,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,1:32:24.95,1:32:26.91,Default,,0,0,0,,О? Уа... хо... ха...
Dialogue: 0,1:32:35.25,1:32:36.38,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:32:37.17,1:32:40.09,Default,,0,0,0,,Фантом ұры Дракс келді!
Dialogue: 0,1:32:41.01,1:32:43.59,Default,,0,0,0,,Дракс! ?
Dialogue: 0,1:32:43.80,1:32:45.43,Default,,0,0,0,,Ескерту!
Dialogue: 0,1:32:46.85,1:32:50.10,Default,,0,0,0,,Мен сені 3 минут ішінде жеңемін!
Dialogue: 0,1:32:50.39,1:32:52.31,Default,,0,0,0,,Алдын ала хабарлау жақсы, сондықтан асығыңыз!
Dialogue: 0,1:32:52.60,1:32:54.52,Default,,0,0,0,,Міне осылай жұмыс істейді!
Dialogue: 0,1:32:55.11,1:32:56.23,Default,,0,0,0,,Уф... Ха!
Dialogue: 0,1:32:58.61,1:33:00.40,Default,,0,0,0,,Ха! Тат! Ха! Алақай!
Dialogue: 0,1:33:00.53,1:33:03.11,Default,,0,0,0,,Уау... Иә!
Dialogue: 0,1:33:03.99,1:33:05.32,Default,,0,0,0,,Тах... гах...
Dialogue: 0,1:33:05.70,1:33:08.33,Default,,0,0,0,,Сәлем! Бір таңғажайып нәрсе болғалы тұр.
Dialogue: 0,1:33:08.45,1:33:09.79,Default,,0,0,0,,Уф... мына жігіт!
Dialogue: 0,1:33:11.33,1:33:12.54,Default,,0,0,0,,Ха!
Dialogue: 0,1:33:14.08,1:33:18.17,Default,,0,0,0,,Уф... күзетші роботтың артында жад картасы бар!
Dialogue: 0,1:33:18.25,1:33:20.88,Default,,0,0,0,,Егер сіз бұл затты алып тастасаңыз, ол қозғалысын тоқтатуы керек!
Dialogue: 0,1:33:21.84,1:33:22.93,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:33:25.64,1:33:26.51,Default,,0,0,0,,Ха!
Dialogue: 0,1:33:27.56,1:33:29.43,Default,,0,0,0,,Ха! Уау...
Dialogue: 0,1:33:29.52,1:33:32.89,Default,,0,0,0,,Уау! Ой... ой... ой...
Dialogue: 0,1:33:33.35,1:33:35.10,Default,,0,0,0,,О! Уф...
Dialogue: 0,1:33:38.15,1:33:40.90,Default,,0,0,0,,Уф... Уау! Ха!
Dialogue: 0,1:33:41.03,1:33:43.20,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:33:44.32,1:33:48.12,Default,,0,0,0,,Уф, мен сенің арқаңда жүре алмаймын... Ха!
Dialogue: 0,1:33:48.37,1:33:50.75,Default,,0,0,0,,Бірдеңе жетіспейді ме? Ах
Dialogue: 0,1:33:50.87,1:33:52.29,Default,,0,0,0,,Құрукук...
Dialogue: 0,1:33:52.41,1:33:53.91,Default,,0,0,0,,Нобита! (Нобита) Иә?
Dialogue: 0,1:33:54.33,1:33:57.38,Default,,0,0,0,,Сіз мұны пайдалана аласыз. Жіпті сөмкеңізден шығарыңыз!
Dialogue: 0,1:33:57.50,1:33:58.54,Default,,0,0,0,,Не? тез!
Dialogue: 0,1:33:58.67,1:34:00.00,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,1:34:01.96,1:34:04.88,Default,,0,0,0,,Ах! Ха! Уф...
Dialogue: 0,1:34:04.97,1:34:07.30,Default,,0,0,0,,Kurukuk Fly!
Dialogue: 0,1:34:07.39,1:34:09.01,Default,,0,0,0,,(Круктың айқайы)
Dialogue: 0,1:34:10.81,1:34:11.93,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:34:12.39,1:34:14.60,Default,,0,0,0,,Ах! Тааа!
Dialogue: 0,1:34:14.69,1:34:15.56,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:21.53,1:34:23.90,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:34:29.49,1:34:30.83,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,1:34:31.08,1:34:32.83,Default,,0,0,0,,Бірақ басқару панелі...
Dialogue: 0,1:34:32.95,1:34:33.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:34.46,1:34:36.00,Default,,0,0,0,,Ғайза, солай...
Dialogue: 0,1:34:36.71,1:34:37.75,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:34:41.71,1:34:44.22,Default,,0,0,0,,Менің гипершаңсорғышым қызып кетті.
Dialogue: 0,1:34:44.55,1:34:46.93,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,1:34:47.05,1:34:49.18,Default,,0,0,0,,Жоқ, бітті!
Dialogue: 0,1:34:49.55,1:34:52.39,Default,,0,0,0,,Осындай кезде менде дедукция әдісі болса ғой...
Dialogue: 0,1:34:52.89,1:34:57.52,Default,,0,0,0,,Мен жақсы идея бар екеніне сенімдімін...жақсы идея...
Dialogue: 0,1:34:58.23,1:34:59.23,Default,,0,0,0,,Ах
Dialogue: 0,1:35:01.32,1:35:03.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:03.57,1:35:05.49,Default,,0,0,0,,Курт! иә?
Dialogue: 0,1:35:05.61,1:35:08.07,Default,,0,0,0,,Бұл попон! Попон қолданыңыз!
Dialogue: 0,1:35:08.20,1:35:10.41,Default,,0,0,0,,Ха... Түсіндім!
Dialogue: 0,1:35:10.78,1:35:12.62,Default,,0,0,0,,Попон! (айқай)
Dialogue: 0,1:35:13.91,1:35:16.12,Default,,0,0,0,,Күнді же!
Dialogue: 0,1:35:16.25,1:35:18.33,Default,,0,0,0,,(айқай)
Dialogue: 0,1:35:19.83,1:35:21.75,Default,,0,0,0,,Попон! Попон-чан!
Dialogue: 0,1:35:22.00,1:35:23.13,Default,,0,0,0,,Попон!
Dialogue: 0,1:35:23.21,1:35:25.88,Default,,0,0,0,,(айқай)
Dialogue: 0,1:35:26.13,1:35:27.09,Default,,0,0,0,,Моги мырза шынымен де әсерлі адам, білесің бе
Dialogue: 0,1:35:27.22,1:35:28.22,Default,,0,0,0,,Попон-чан!
Dialogue: 0,1:35:28.34,1:35:30.34,Default,,0,0,0,,Попон Сәттілік! жалғастыра бер!
Dialogue: 0,1:35:30.43,1:35:33.31,Default,,0,0,0,,(Барлығы қолдайды)
Dialogue: 0,1:35:33.39,1:35:36.27,Default,,0,0,0,,Жоғалтпа! Іске сәт!
Dialogue: 0,1:35:36.35,1:35:39.48,Default,,0,0,0,,Сәттілік! Попон!
Dialogue: 0,1:35:39.60,1:35:43.65,Default,,0,0,0,,(айқай)
Dialogue: 0,1:35:51.03,1:35:53.91,Default,,0,0,0,,Иә! Жақсы!
Dialogue: 0,1:35:54.95,1:35:56.83,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,1:35:56.91,1:35:59.79,Default,,0,0,0,,Мен құтқарылдым деп ойладым!
Dialogue: 0,1:36:04.25,1:36:05.80,Default,,0,0,0,,Иә! (Зімбір) Ия!
Dialogue: 0,1:36:05.88,1:36:07.51,Default,,0,0,0,,Онда ештеңе жоқ. Екі жағы да бос.
Dialogue: 0,1:36:07.80,1:36:10.13,Default,,0,0,0,,Уау! (Зімбір) Уау...
Dialogue: 0,1:36:10.26,1:36:12.85,Default,,0,0,0,,Қуаныңыз, Full Metal қайта оралды!
Dialogue: 0,1:36:12.97,1:36:14.97,Default,,0,0,0,,Қазір айтсаң да!
Dialogue: 0,1:36:15.18,1:36:18.93,Default,,0,0,0,,Ха! Сіз құпия құралдарды пайдалана аласыз! Хаха
Dialogue: 0,1:36:19.98,1:36:23.52,Default,,0,0,0,,Даа! Жұмсақ қабықты тасбақа роботы да оралды!
Dialogue: 0,1:36:23.65,1:36:26.32,Default,,0,0,0,,О? бұл!
Dialogue: 0,1:36:27.53,1:36:29.53,Default,,0,0,0,,Қалпына келтіру сәулесі!
Dialogue: 0,1:36:29.78,1:36:31.74,Default,,0,0,0,,Таңқаларлық жарық!
Dialogue: 0,1:36:33.20,1:36:34.45,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:36:34.53,1:36:36.16,Default,,0,0,0,,Хмм!
Dialogue: 0,1:36:43.92,1:36:45.71,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:36:46.46,1:36:49.47,Default,,0,0,0,,Фуфуфу (Сунео) Иә!
Dialogue: 0,1:36:49.59,1:36:53.34,Default,,0,0,0,,Уау! (Барлығы күледі)
Dialogue: 0,1:36:54.22,1:36:56.47,Default,,0,0,0,,А... сәл.
Dialogue: 0,1:36:56.93,1:37:00.52,Default,,0,0,0,,Ах... Ах, анау...
Dialogue: 0,1:37:02.48,1:37:04.48,Default,,0,0,0,,Менің қоңырауым
Dialogue: 0,1:37:20.29,1:37:22.87,Default,,0,0,0,,Дораемон болды!
Dialogue: 0,1:37:23.21,1:37:24.96,Default,,0,0,0,,Иә, оның жартысы ғана, бірақ а!
Dialogue: 0,1:37:25.08,1:37:27.67,Default,,0,0,0,,Шынымен бе? Жақсы
Dialogue: 0,1:37:27.80,1:37:31.05,Default,,0,0,0,,Кешіріңіз, Дораемон, мен енді ұры болмаймын.
Dialogue: 0,1:37:31.51,1:37:35.05,Default,,0,0,0,,Мен DX алған заттарды да қайтарамын.
Dialogue: 0,1:37:35.14,1:37:39.47,Default,,0,0,0,,Иә, Сузу қайтып келгенше, мен үшін жақсы.
Dialogue: 0,1:37:39.60,1:37:41.64,Default,,0,0,0,,Енді екінші жартысын іздеп көрейік.
Dialogue: 0,1:37:41.77,1:37:42.43,Default,,0,0,0,,Иә
Dialogue: 0,1:37:43.19,1:37:45.65,Default,,0,0,0,,Пеплер, қайда кеттің?
Dialogue: 0,1:37:45.77,1:37:48.23,Default,,0,0,0,,Қулықшы Ұры DX сол жігіт болуы керек!
Dialogue: 0,1:37:48.57,1:37:53.24,Default,,0,0,0,,Мұражайдағы құбыжық ол болуы керек!
Dialogue: 0,1:37:53.36,1:37:56.41,Default,,0,0,0,,Пеплер! Мен оны міндетті түрде табамын!
Dialogue: 0,1:37:56.70,1:37:59.24,Default,,0,0,0,,Мойынды жуып, күт!
Dialogue: 0,1:37:59.66,1:38:04.37,Default,,0,0,0,,Эй, сіздің генахоко жүйеңіз оны анықтай ала ма?
Dialogue: 0,1:38:04.50,1:38:07.54,Default,,0,0,0,,Мен берілмеймін. Бір күні мен сенімдімін ...
Dialogue: 0,1:38:07.67,1:38:10.80,Default,,0,0,0,,Толық Peppler Metal!
Dialogue: 0,1:38:10.92,1:38:12.72,Default,,0,0,0,,Гахахахаха!
Dialogue: 0,1:38:12.84,1:38:17.05,Default,,0,0,0,,Ата, мен бір күні дүниені құртатындай сезінемін.
Dialogue: 0,1:38:18.47,1:38:19.64,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,1:38:19.76,1:38:22.35,Default,,0,0,0,,Мен шаршадым, үйге қайтайық.
Dialogue: 0,1:38:22.43,1:38:26.81,Default,,0,0,0,,Мүлдем жоқ! Қоңырауды таппайынша үйге бармаймын!
Dialogue: 0,1:38:27.10,1:38:29.27,Default,,0,0,0,,Дұрыс іздеңіз! (Нобита) Әй...
Dialogue: 0,1:38:29.69,1:38:34.78,Default,,0,0,0,,Аға, сен неге бұл қоңырауға ерекше көңіл бөлесің?
Dialogue: 0,1:38:35.20,1:38:38.53,Default,,0,0,0,,Иә? Ааааа!
Dialogue: 0,1:38:39.58,1:38:41.08,Default,,0,0,0,,Уф... та...
Dialogue: 0,1:38:41.20,1:38:42.95,Default,,0,0,0,,Бұл! Иә?
Dialogue: 0,1:38:43.50,1:38:47.04,Default,,0,0,0,,Міне болды! Ахахха
Dialogue: 0,1:38:47.17,1:38:49.84,Default,,0,0,0,,Осындай жерде... а
Dialogue: 0,1:38:50.25,1:38:52.84,Default,,0,0,0,,Хахаха, осындай жерде!
Dialogue: 0,1:38:52.96,1:38:58.30,Default,,0,0,0,,(Дораэмон мен Нобитаның күлкісі)
Dialogue: 0,1:38:58.43,1:39:00.93,Default,,0,0,0,,Эй...ха...
Dialogue: 0,1:39:01.97,1:39:04.22,Default,,0,0,0,,Рахмет сізге Нобита-кун
Dialogue: 0,1:39:04.35,1:39:06.39,Default,,0,0,0,,Мен мұны өмір бойы сақтаймын.
Dialogue: 0,1:39:06.52,1:39:08.94,Default,,0,0,0,,Не? Сіз асыра айтып жатырсыз.
Dialogue: 0,1:39:09.31,1:39:13.11,Default,,0,0,0,,Хехехе, соның арқасында түсіндім.
Dialogue: 0,1:39:13.23,1:39:17.07,Default,,0,0,0,,Нобита сабақ оқи алмайды немесе жаттығу жасай алмайды.
Dialogue: 0,1:39:17.20,1:39:20.62,Default,,0,0,0,,Оның жігері жоқ, ештеңе істей алмайды...
Dialogue: 0,1:39:20.74,1:39:22.49,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,1:39:22.62,1:39:24.66,Default,,0,0,0,,…Ал екеуі ше?
Dialogue: 0,1:39:25.20,1:39:28.37,Default,,0,0,0,,Бірақ сен жақсы жігітсің.
Dialogue: 0,1:39:28.96,1:39:30.29,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:39:30.83,1:39:34.34,Default,,0,0,0,,Эхехе... Ахаха хехехе
Dialogue: 0,1:39:34.42,1:39:36.63,Default,,0,0,0,,Рахмет сізге Нобита-кун
Dialogue: 0,1:39:36.76,1:39:41.01,Default,,0,0,0,,Иә (екі адам күледі)
Dialogue: 0,1:39:42.89,1:39:44.56,Default,,0,0,0,,Дораемон...
Dialogue: 0,1:39:45.06,1:39:48.81,Default,,0,0,0,,Бұл менің есімде.
Dialogue: 0,1:39:53.69,1:39:55.69,Default,,0,0,0,,Дораемон сонда!
Dialogue: 0,1:39:55.82,1:39:58.57,Default,,0,0,0,,Иә! Қай жерде?
Dialogue: 0,1:39:58.70,1:40:01.70,Default,,0,0,0,,Қайда? Қай жерде болды?
Dialogue: 0,1:40:01.95,1:40:05.54,Default,,0,0,0,,Хе... менің аяқ киімімде!
Dialogue: 0,1:40:05.66,1:40:06.87,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:40:07.25,1:40:08.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:09.83,1:40:12.84,Default,,0,0,0,,Нобита-кун...хехе
Dialogue: 0,1:40:13.17,1:40:14.80,Default,,0,0,0,,Ахахаха
Dialogue: 0,1:40:15.09,1:40:17.05,Default,,0,0,0,,Ах... Эхехе
Dialogue: 0,1:40:20.59,1:40:21.47,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:40:21.47,1:40:22.43,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:40:21.47,1:40:22.43,Default,,0,0,0,,♪～
Dialogue: 0,1:40:22.43,1:40:27.47,Default,,0,0,0,,♪～
Dialogue: 0,1:43:33.04,1:43:39.04,Default,,0,0,0,,～♪
