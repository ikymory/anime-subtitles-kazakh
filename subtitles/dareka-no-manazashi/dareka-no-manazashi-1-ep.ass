Dialogue: 0,0:00:08.23,0:00:12.25,Jp,,0000,0000,0000,,Бауды құтқарушы сым сияқты мықтап ұстаңыз.
Dialogue: 0,0:00:12.68,0:00:14.10,Jp,,0000,0000,0000,,А-чан тұр
Dialogue: 0,0:00:15.26,0:00:18.62,Jp,,0000,0000,0000,,Мен біреудің мақтанатын соңғы мәртебесін тексергім келмейді.
Dialogue: 0,0:00:18.82,0:00:22.63,Jp,,0000,0000,0000,,Терезе әйнегінен шаршаған өзімді көргенді де жек көремін.
Dialogue: 0,0:00:23.07,0:00:25.51,Jp,,0000,0000,0000,,А-чан көзін жұмып отыр.
Dialogue: 0,0:00:27.92,0:00:31.62,Jp,,0000,0000,0000,,Тым көп күш түсіргеннен қызыл болып кеткен оң қолымды сол қолыма ауыстырдым.
Dialogue: 0,0:00:31.74,0:00:33.59,Jp,,0000,0000,0000,,Оң қолыңызға қайта ауысыңыз.
Dialogue: 0,0:00:33.69,0:00:37.04,Jp,,0000,0000,0000,,Ақырында мен бауды екі қолмен ұстаймын.
Dialogue: 0,0:00:38.52,0:00:42.11,Jp,,0000,0000,0000,,А-чан түсетін станция әлі алыс.
Dialogue: 0,0:00:50.95,0:00:53.03,jp_ontop,,0000,0000,0000,,Биылғы жылы Әулие Валентин күні...
Dialogue: 0,0:00:54.23,0:00:55.77,Jp,,0000,0000,0000,,суық суық суық
Dialogue: 0,0:01:09.30,0:01:10.24,Jp,,0000,0000,0000,,Әкем
Dialogue: 0,0:01:10.78,0:01:11.62,Jp,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:01:12.70,0:01:14.89,Jp,,0000,0000,0000,,Менде бәрі жақсы, менде бәрі жақсы.
Dialogue: 0,0:01:15.55,0:01:17.34,Jp,,0000,0000,0000,,Ал А-чан өтірік айтады.
Dialogue: 0,0:01:17.34,0:01:20.51,jp_ontop,,0000,0000,0000,,Сіз маған жиі есеп беруді айтасыз.
Dialogue: 0,0:01:20.62,0:01:21.82,jp_ontop,,0000,0000,0000,,Сіз жай тыңдап тұрсыз ба?
Dialogue: 0,0:01:17.95,0:01:20.63,Jp,,0000,0000,0000,,Бүгін де менеджер мені көп ұрысты.
Dialogue: 0,0:01:20.89,0:01:22.66,Jp,,0000,0000,0000,,Әкем мен Ми-сан
Dialogue: 0,0:01:22.97,0:01:24.19,Jp,,0000,0000,0000,,О, менде бәрі жақсы.
Dialogue: 0,0:01:24.19,0:01:25.52,Jp,,0000,0000,0000,,Екеуі де жақсы.
Dialogue: 0,0:01:25.78,0:01:27.27,Jp,,0000,0000,0000,,Менің әкем де өтірік айтты.
Dialogue: 0,0:01:27.57,0:01:30.38,jp_ontop,,0000,0000,0000,,Мен сізден жиі хабарлауыңызды сұраймын.
Dialogue: 0,0:01:28.43,0:01:30.44,Jp,,0000,0000,0000,,Жұмыста бастығым маған айқайлады.
Dialogue: 0,0:01:30.87,0:01:34.40,Jp,,0000,0000,0000,,Менің мысығым Ми қартайды, біраздан бері төсек тартып жатыр.
Dialogue: 0,0:01:34.73,0:01:37.26,Jp,,0000,0000,0000,,Мен жұмысқа жақын жерде болдым.
Dialogue: 0,0:01:37.60,0:01:40.23,Jp,,0000,0000,0000,,Тамақ ішпегеніме біраз болды.
Dialogue: 0,0:01:42.34,0:01:45.92,Jp,,0000,0000,0000,,Кешіріңіз, мен бүгін жұмыстамын.
Dialogue: 0,0:01:47.07,0:01:51.69,Jp,,0000,0000,0000,,Ах-чан енді ата-анасымен тамақтанатын жаста емес сияқты.
Dialogue: 0,0:01:55.21,0:01:56.58,Jp,,0000,0000,0000,,Сәбіз мырза
Dialogue: 0,0:01:56.82,0:01:58.24,Jp,,0000,0000,0000,,Сакуранбо-сан
Dialogue: 0,0:01:58.57,0:01:59.92,jp_ontop,,0000,0000,0000,,Шиитаке саңырауқұлағы мырза
Dialogue: 0,0:01:59.45,0:02:00.99,Jp,,0000,0000,0000,,Ая, бұл тамақ.
Dialogue: 0,0:02:00.99,0:02:01.99,Jp,,0000,0000,0000,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:02:02.47,0:02:04.95,Jp,,0000,0000,0000,,Не істесең де, не көрсең де
Dialogue: 0,0:02:05.12,0:02:07.97,Jp,,0000,0000,0000,,Сен әрқашан бақытты қыз едің.
Dialogue: 0,0:02:08.75,0:02:13.24,Jp,,0000,0000,0000,,Жүгіру, тамақтану, әңгімелесу, ән айту
Dialogue: 0,0:02:13.38,0:02:15.41,Jp,,0000,0000,0000,,Барлығы қуанышқа толы болды.
Dialogue: 0,0:02:13.44,0:02:16.93,jp_ontop,,0000,0000,0000,,Гамбургер Сашими еті картоп
Dialogue: 0,0:02:17.26,0:02:19.99,Jp,,0000,0000,0000,,Анамның жұмысы қызып барады.
Dialogue: 0,0:02:20.10,0:02:23.24,Jp,,0000,0000,0000,,Мен әкеммен көбірек уақыт өткізе бастадым.
Dialogue: 0,0:02:23.29,0:02:27.63,jp_ontop,,0000,0000,0000,,Мына қыз бұл қызды жақсы көреді, сондықтан олар үйленді.
Dialogue: 0,0:02:24.59,0:02:26.38,Jp,,0000,0000,0000,,Жалғыз болып көрінетіндер үшін
Dialogue: 0,0:02:26.38,0:02:29.52,Jp,,0000,0000,0000,,Дәл осы кезде әкем Ми-санды алып келді.
Dialogue: 0,0:02:29.59,0:02:31.84,jp_ontop,,0000,0000,0000,,Ми-сан, күт, күт.
Dialogue: 0,0:02:32.01,0:02:33.17,jp_ontop,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:02:29.61,0:02:31.79,Jp,,0000,0000,0000,,Екеуі көп ұзамай жақсы дос болды
Dialogue: 0,0:02:33.48,0:02:35.84,Jp,,0000,0000,0000,,Ақырында форма киетін жасқа жететін боласың.
Dialogue: 0,0:02:36.00,0:02:41.44,Jp,,0000,0000,0000,,Бірте-бірте қуанышымның көп бөлігі отбасынан шықты.
Dialogue: 0,0:02:41.91,0:02:43.92,jp_ontop,,0000,0000,0000,,Мен сонда тағы барғым келеді.
Dialogue: 0,0:02:43.95,0:02:45.24,jp_ontop,,0000,0000,0000,,Омлет дәмді болды, солай емес пе?
Dialogue: 0,0:02:42.72,0:02:45.16,Jp,,0000,0000,0000,,Әкенің қатысуы бірте-бірте азаяды
Dialogue: 0,0:02:45.33,0:02:46.66,jp_ontop,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:02:46.91,0:02:48.53,jp_ontop,,0000,0000,0000,,Кешірім сұраудың мәні жоқ.
Dialogue: 0,0:02:45.24,0:02:50.67,Jp,,0000,0000,0000,,Соңында сіз оның қарапайымдылығын менсінбей бастайсыз.
Dialogue: 0,0:02:54.82,0:02:56.77,Jp,,0000,0000,0000,,Әкем үшін, тіпті бұл
Dialogue: 0,0:02:56.85,0:02:59.67,Jp,,0000,0000,0000,,Қызымның өскеніне қуансам да.
Dialogue: 0,0:03:00.30,0:03:04.29,Jp,,0000,0000,0000,,Бірақ сонымен бірге әкемді қанша жалғыздықта қалдырдым?
Dialogue: 0,0:03:04.67,0:03:06.35,Jp,,0000,0000,0000,,Сіз ешқашан елестете алмайсыз
Dialogue: 0,0:03:08.04,0:03:10.19,Jp,,0000,0000,0000,,Жұмысқа орналасып, үйден кету
Dialogue: 0,0:03:10.19,0:03:12.68,Jp,,0000,0000,0000,,Көптен күткен өміріңізді жалғыз бастай аласыз.
Dialogue: 0,0:03:12.68,0:03:15.66,Jp,,0000,0000,0000,,Ал енді мен жалғыз баруым керек.
Dialogue: 0,0:03:15.81,0:03:17.36,Jp,,0000,0000,0000,,Сіз шарасызсыз
Dialogue: 0,0:03:19.21,0:03:22.39,Jp,,0000,0000,0000,,Көптен кемпір атансам да.
Dialogue: 0,0:03:22.58,0:03:25.78,Jp,,0000,0000,0000,,Мен сізде болған кездердің бәрі есімде.
Dialogue: 0,0:03:27.24,0:03:28.34,Jp,,0000,0000,0000,,Егер ол орындалса
Dialogue: 0,0:03:28.34,0:03:32.77,Jp,,0000,0000,0000,,Мен сені соңғы рет көргім келді.
Dialogue: 0,0:03:40.87,0:03:42.34,Jp,,0000,0000,0000,,Әкем
Dialogue: 0,0:03:42.34,0:03:44.72,Jp,,0000,0000,0000,,Тағы не?
Dialogue: 0,0:03:46.37,0:03:47.76,Jp,,0000,0000,0000,,Өтірік
Dialogue: 0,0:04:00.04,0:04:01.68,Jp,,0000,0000,0000,,Иә, бәрібір
Dialogue: 0,0:04:02.43,0:04:04.64,Jp,,0000,0000,0000,,Мама, сіз де өзіңізді күтіңіз.
Dialogue: 0,0:04:05.32,0:04:06.04,Jp,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:08.32,0:04:09.36,Jp,,0000,0000,0000,,Кел, әке
Dialogue: 0,0:04:11.09,0:04:13.09,Jp,,0000,0000,0000,,Басқа кім өлсе де
Dialogue: 0,0:04:13.09,0:04:15.20,Jp,,0000,0000,0000,,Мен бұлай қайғырудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:04:15.92,0:04:18.13,Jp,,0000,0000,0000,,Бұл біртүрлі нәрсе ме?
Dialogue: 0,0:04:21.14,0:04:22.52,Jp,,0000,0000,0000,,Бұл таңқаларлық емес.
Dialogue: 0,0:04:22.92,0:04:25.34,Jp,,0000,0000,0000,,Ми-сан...біз отбасы болдық.
Dialogue: 0,0:04:36.79,0:04:40.26,Jp,,0000,0000,0000,,Сіз ұмытқан нәрселер көп.
Dialogue: 0,0:04:41.48,0:04:45.05,Jp,,0000,0000,0000,,Сол күні әкем «Мен Ах-чанды қорғауым керек» деп ант берді.
Dialogue: 0,0:04:45.70,0:04:47.58,Jp,,0000,0000,0000,,Ах-чан бұл шешімді қабылдады.
Dialogue: 0,0:04:48.22,0:04:50.73,Jp,,0000,0000,0000,,«Мен әкемді қорғауым керек»
Dialogue: 0,0:04:52.15,0:04:55.81,Jp,,0000,0000,0000,,Достарым мен ата-анам туралы жаман сөйлеп қатты толқыдым
Dialogue: 0,0:04:56.17,0:04:59.72,Jp,,0000,0000,0000,,Мен өзімді кінәлі сезінгендіктен, әкеме алғаш рет кешкі ас әзірледім.
Dialogue: 0,0:05:01.10,0:05:03.63,Jp,,0000,0000,0000,,Сіздің жалғыз түніңіз
Dialogue: 0,0:05:03.86,0:05:06.97,Jp,,0000,0000,0000,,Екеуміз де жалғыздықтан аздап жыладық
Dialogue: 0,0:05:07.74,0:05:11.00,Jp,,0000,0000,0000,,Мен жұмыс бабымен жақын маңдағы станцияда болып, қызымды шақырған кезде.
Dialogue: 0,0:05:11.04,0:05:14.82,Jp,,0000,0000,0000,,Негізі әкем екі сәнді түскі ас қорапшасын сатып алды.
Dialogue: 0,0:05:14.93,0:05:17.46,Jp,,0000,0000,0000,,Қоңырау пәтерден жасалды.
Dialogue: 0,0:05:19.72,0:05:22.14,Jp,,0000,0000,0000,,Мен сіздің тағамды бірінші рет жасап көрдім.
Dialogue: 0,0:05:22.17,0:05:23.64,Jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:24.08,0:05:25.27,Jp,,0000,0000,0000,,Екінші рет.
Dialogue: 0,0:05:27.31,0:05:30.06,Jp,,0000,0000,0000,,Кеше мен Ми-санды армандадым.
Dialogue: 0,0:05:30.06,0:05:31.36,Jp,,0000,0000,0000,,Әкем де көрді.
Dialogue: 0,0:05:31.36,0:05:32.32,Jp,,0000,0000,0000,,Иә
Dialogue: 0,0:05:32.48,0:05:34.99,Jp,,0000,0000,0000,,Мен көп нәрсені есіме түсірдім.
Dialogue: 0,0:05:35.26,0:05:37.17,Jp,,0000,0000,0000,,Мен де көп нәрсені есіме түсірдім.
Dialogue: 0,0:05:37.24,0:05:38.25,Jp,,0000,0000,0000,,(Балалардың шуы)
Dialogue: 0,0:05:38.58,0:05:41.79,Jp,,0000,0000,0000,,А-чан кішкентай кезінде қасының арасында әжім болмаған.
Dialogue: 0,0:05:41.79,0:05:43.05,Jp,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:43.17,0:05:45.95,Jp,,0000,0000,0000,,Әкемнің әжімге толы екенін айтқанын қаламаймын.
Dialogue: 0,0:05:59.52,0:06:00.62,Jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:06:00.84,0:06:03.86,Jp,,0000,0000,0000,,Мен сенің әкеңнің жаңа құрбысын көруге келдім.
Dialogue: 0,0:06:04.02,0:06:05.99,Jp,,0000,0000,0000,,Кяаааааааааааааааааааааааааааааа
Dialogue: 0,0:06:05.99,0:06:07.82,Jp,,0000,0000,0000,,Аяның кішкентай кезіндегідей.
Dialogue: 0,0:06:07.89,0:06:09.62,Jp,,0000,0000,0000,,Ол сәл үлкенірек болды, солай ма?
Dialogue: 0,0:06:10.15,0:06:11.69,Jp,,0000,0000,0000,,Әй, бұл менің анам емес.
Dialogue: 0,0:06:12.19,0:06:13.32,Jp,,0000,0000,0000,,Иә
Dialogue: 0,0:06:13.85,0:06:17.42,Jp,,0000,0000,0000,,Сонда да бақыт дұрыс жалғаса береді.
Dialogue: 0,0:06:17.56,0:06:20.39,Jp,,0000,0000,0000,,Сіз білесіз
Dialogue: 0,0:04:26.54,0:04:32.68,Song_jp,,0000,0000,0000,,«Болды» кіріспе әні
Dialogue: 0,0:04:34.02,0:04:36.86,Song_jp,,0000,0000,0000,,Төгілген болуы керек көз жасы
Dialogue: 0,0:04:37.39,0:04:41.86,Song_jp,,0000,0000,0000,,Сіз үшін оны сүртетін біреу бар.
Dialogue: 0,0:04:48.20,0:04:51.34,Song_jp,,0000,0000,0000,,Қанша қиын болса да
Dialogue: 0,0:04:51.60,0:04:56.14,Song_jp,,0000,0000,0000,,Мені біреу бақылап тұр.
Dialogue: 0,0:05:01.78,0:05:06.82,Song_jp,,0000,0000,0000,,Ақыл не үшін бар?
Dialogue: 0,0:05:08.95,0:05:14.43,Song_jp,,0000,0000,0000,,Жалғыз өзің түсіне алмайсың
Dialogue: 0,0:05:15.59,0:05:19.13,Song_jp,,0000,0000,0000,,Мен бұл туралы білемін.
Dialogue: 0,0:05:20.90,0:05:23.70,Song_jp,,0000,0000,0000,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:05:24.17,0:05:34.65,Song_jp,,0000,0000,0000,,Мен күткеннен ұзағырақ жолды таңдаймын, бірақ
Dialogue: 0,0:05:35.28,0:05:38.38,Song_jp,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:05:42.22,0:05:45.46,Song_jp,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:05:47.29,0:05:50.53,Song_jp,,0000,0000,0000,,Сізді қолдайды
Dialogue: 0,0:05:50.70,0:05:55.20,Song_jp,,0000,0000,0000,,Қарау сонда
Dialogue: 0,0:00:08.23,0:00:12.25,CN,,0000,0000,0000,,Nyodong ұрлау құтқару арқанының жалпы жіпті ұстағыш ілулі сақинасы
Dialogue: 0,0:00:12.68,0:00:14.10,CN,,0000,0000,0000,,Наридегі шағын станция
Dialogue: 0,0:00:15.26,0:00:18.62,CN,,0000,0000,0000,,Ақылсыз сұрау
Dialogue: 0,0:00:18.82,0:00:22.63,CN,,0000,0000,0000,,Машинада шағылысқан шаршаған және төзгісіз өзін
Dialogue: 0,0:00:23.07,0:00:25.51,CN,,0000,0000,0000,,Кішкентай, ақшыл топырақ, үстіңгі қабақ
Dialogue: 0,0:00:27.92,0:00:31.62,CN,,0000,0000,0000,,Оң қол сол қолмен ауыстырылады
Dialogue: 0,0:00:31.74,0:00:33.59,CN,,0000,0000,0000,,Тағы да оң қол
Dialogue: 0,0:00:33.69,0:00:37.04,CN,,0000,0000,0000,,Екі қолды ілулі сақина
Dialogue: 0,0:00:38.52,0:00:42.11,CN,,0000,0000,0000,,Вокзалдан аз ғана қашықтық
Dialogue: 0,0:00:40.15,0:00:41.62,Title,,0000,0000,0000,,Белгілі
Dialogue: 0,0:00:40.15,0:00:41.62,Title,,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:00:40.15,0:00:41.62,Title,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:00:40.15,0:00:41.62,Title,,0000,0000,0000,,Шығыс Патшалығының астанасы – Баррингтон
Dialogue: 0,0:00:40.15,0:00:41.62,Title,,0000,0000,0000,,Жарық
Dialogue: 0,0:00:41.62,0:00:44.36,Title,,0000,0000,0000,,Белгілі
Dialogue: 0,0:00:41.62,0:00:44.36,Title,,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:00:41.62,0:00:44.36,Title,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:00:41.62,0:00:44.36,Title,,0000,0000,0000,,Шығыс Патшалығының астанасы – Баррингтон
Dialogue: 0,0:00:41.62,0:00:44.36,Title,,0000,0000,0000,,Жарық
Dialogue: 0,0:00:50.95,0:00:53.03,cn_ontop,,0000,0000,0000,,Биыл...
Dialogue: 0,0:00:54.23,0:00:55.77,CN,,0000,0000,0000,,Суық сүйгіш Суық сүйгіш Суық сүйгіш
Dialogue: 0,0:01:07.95,0:01:08.65,CN,,0000,0000,0000,,Сүйісу
Dialogue: 0,0:01:07.95,0:01:08.65,CN,,0000,0000,0000,,Еске салғыш
Dialogue: 0,0:01:09.30,0:01:10.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:10.78,0:01:11.62,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:01:12.70,0:01:14.89,CN,,0000,0000,0000,,Мен мұны өте жақсы білемін.
Dialogue: 0,0:01:15.55,0:01:17.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:17.34,0:01:20.51,cn_ontop,,0000,0000,0000,,Біз әрқашан мыналарға назар аударуымыз керек екенін ескеріңіз
Dialogue: 0,0:01:20.62,0:01:21.82,cn_ontop,,0000,0000,0000,,Сіз осындасыз ба?
Dialogue: 0,0:01:17.95,0:01:20.63,CN,,0000,0000,0000,,Бұл мақаланың тақырыбы аяқталды.
Dialogue: 0,0:01:20.89,0:01:22.66,CN,,0000,0000,0000,,Кішкентай сыйлық алғыңыз келе ме?
Dialogue: 0,0:01:22.97,0:01:24.19,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:24.19,0:01:25.52,CN,,0000,0000,0000,,Екеумізге ұнайтын нәрсе
Dialogue: 0,0:01:25.78,0:01:27.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:27.57,0:01:30.38,cn_ontop,,0000,0000,0000,,Бізде әрқашан күшті жаттығулар кестесі бар екенін ескеріңіз
Dialogue: 0,0:01:28.43,0:01:30.44,CN,,0000,0000,0000,,Басшының пікірін талқылау
Dialogue: 0,0:01:30.87,0:01:34.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:34.73,0:01:37.26,CN,,0000,0000,0000,,Мен сіздің тұрғылықты жеріңіздің маңында жұмысты аяқтадым.
Dialogue: 0,0:01:37.60,0:01:40.23,CN,,0000,0000,0000,,Тамақты ойлап табудың қажеті жоқ.
Dialogue: 0,0:01:42.34,0:01:45.92,CN,,0000,0000,0000,,Мен қазір компаниядамын.
Dialogue: 0,0:01:47.07,0:01:51.69,CN,,0000,0000,0000,,Балалардың балалық шағының шағын суреті
Dialogue: 0,0:01:55.21,0:01:56.58,CN,,0000,0000,0000,,Ху Мубо мырза
Dialogue: 0,0:01:56.82,0:01:58.24,CN,,0000,0000,0000,,Хакумомо мырза
Dialogue: 0,0:01:58.57,0:01:59.92,cn_ontop,,0000,0000,0000,,Косу мырза
Dialogue: 0,0:01:59.45,0:02:00.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:00.99,0:02:01.99,CN,,0000,0000,0000,,(＠⌒⌒＠)
Dialogue: 0,0:02:02.47,0:02:04.95,CN,,0000,0000,0000,,Сізге оны көруге рұқсат жоқ.
Dialogue: 0,0:02:05.12,0:02:07.97,CN,,0000,0000,0000,,Тегінде жүрген қыз
Dialogue: 0,0:02:08.75,0:02:13.24,CN,,0000,0000,0000,,Жүру, ішу, сөйлеу, ән айту
Dialogue: 0,0:02:13.38,0:02:15.41,CN,,0000,0000,0000,,Бақытқа толық қанағаттанған
Dialogue: 0,0:02:13.44,0:02:16.93,cn_ontop,,0000,0000,0000,,...
Dialogue: 0,0:02:17.26,0:02:19.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:20.10,0:02:23.24,CN,,0000,0000,0000,,Германияда қанша уақыт тұрдыңыз?
Dialogue: 0,0:02:23.29,0:02:27.63,cn_ontop,,0000,0000,0000,,Басқа ләззаттар
Dialogue: 0,0:02:24.59,0:02:26.38,CN,,0000,0000,0000,,Ол кезде сен жалғыз едің.
Dialogue: 0,0:02:26.38,0:02:29.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:29.59,0:02:31.84,cn_ontop,,0000,0000,0000,,Кому және т.б. т.б.
Dialogue: 0,0:02:32.01,0:02:33.17,cn_ontop,,0000,0000,0000,,және т.б.
Dialogue: 0,0:02:29.61,0:02:31.79,CN,,0000,0000,0000,,Екі адам табысқа жетті, жақсы дос.
Dialogue: 0,0:02:33.48,0:02:35.84,CN,,0000,0000,0000,,Келген кезде мектеп формасын кию керек.
Dialogue: 0,0:02:36.00,0:02:41.44,CN,,0000,0000,0000,,Тәкаппар ел, Көптің қуанышы өз сыртқы дүниесінен, Үйде жоқ.
Dialogue: 0,0:02:41.91,0:02:43.92,cn_ontop,,0000,0000,0000,,...
Dialogue: 0,0:02:43.95,0:02:45.24,cn_ontop,,0000,0000,0000,,Наридің қуырылған жұмыртқа кітабы
Dialogue: 0,0:02:42.72,0:02:45.16,CN,,0000,0000,0000,,Әкенің болуы да осы күштің қосылуына себеп болады
Dialogue: 0,0:02:45.33,0:02:46.66,cn_ontop,,0000,0000,0000,,Саған деген терең сезімім бар.
Dialogue: 0,0:02:46.91,0:02:48.53,cn_ontop,,0000,0000,0000,,Мичиакияның өлімі
Dialogue: 0,0:02:45.24,0:02:50.67,CN,,0000,0000,0000,,Әңгіменің соңында
Dialogue: 0,0:02:54.82,0:02:56.77,CN,,0000,0000,0000,,Дегенмен, бұл тривиальды жағдай.
Dialogue: 0,0:02:56.85,0:02:59.67,CN,,0000,0000,0000,,Әйелдің өсуін көргенде әйелдің өсуі
Dialogue: 0,0:03:00.30,0:03:04.29,CN,,0000,0000,0000,,Сонымен қатар мен өзімді аздап жалғыз сезінемін, ренжідім.
Dialogue: 0,0:03:04.67,0:03:06.35,CN,,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:03:08.04,0:03:10.19,CN,,0000,0000,0000,,Өнеркәсіптік әрекет мүмкіндігі Сіздің үйге кететін қақпа
Dialogue: 0,0:03:10.19,0:03:12.68,CN,,0000,0000,0000,,Ұзақ мерзімді тәуелсіз өмір
Dialogue: 0,0:03:12.68,0:03:15.66,CN,,0000,0000,0000,,Бірегей өмірдің соңында келді
Dialogue: 0,0:03:15.81,0:03:17.36,CN,,0000,0000,0000,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:03:19.21,0:03:22.39,CN,,0000,0000,0000,,Менің дүниеге келгеніме көп уақыт болды.
Dialogue: 0,0:03:22.58,0:03:25.78,CN,,0000,0000,0000,,Дегенмен мен жолдың басы мен соңын жазып алдым.
Dialogue: 0,0:03:27.24,0:03:28.34,CN,,0000,0000,0000,,Жас кезінде қиялдап, жүзеге асыруға болады.
Dialogue: 0,0:03:28.34,0:03:32.77,CN,,0000,0000,0000,,Ойларым, өткен жолы сені тағы көрдім
Dialogue: 0,0:03:40.87,0:03:42.34,CN,,0000,0000,0000,,Әке?
Dialogue: 0,0:03:42.34,0:03:44.72,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:03:46.37,0:03:47.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:00.04,0:04:01.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:02.43,0:04:04.64,CN,,0000,0000,0000,,Назар аударуды қажет ететін дене массажы
Dialogue: 0,0:04:05.32,0:04:06.04,CN,,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:04:08.32,0:04:09.36,CN,,0000,0000,0000,,Менің әкем – мен
Dialogue: 0,0:04:11.09,0:04:13.09,CN,,0000,0000,0000,,Тікелей өкіл - басқа адамның өлімі.
Dialogue: 0,0:04:13.09,0:04:15.20,CN,,0000,0000,0000,,Жауапсыздық сезімі жеткен кезде де
Dialogue: 0,0:04:15.92,0:04:18.13,CN,,0000,0000,0000,,Біртүрлі және қызық.
Dialogue: 0,0:04:21.14,0:04:22.52,CN,,0000,0000,0000,,Кайкай Кайкай 3
Dialogue: 0,0:04:22.92,0:04:25.34,CN,,0000,0000,0000,,Осының арқасында мен өз отбасымның мүшесімін.
Dialogue: 0,0:04:36.79,0:04:40.26,CN,,0000,0000,0000,,Ұмытуға себеп болатын жағдайлар
Dialogue: 0,0:04:41.48,0:04:45.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:45.70,0:04:47.58,CN,,0000,0000,0000,,Шағын қорытынды
Dialogue: 0,0:04:48.22,0:04:50.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:52.15,0:04:55.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:56.17,0:04:59.72,CN,,0000,0000,0000,,Өзіңізді кінәлі сезіну
Dialogue: 0,0:05:01.10,0:05:03.63,CN,,0000,0000,0000,,Өз өміріңді бастаған алғашқы түн
Dialogue: 0,0:05:03.86,0:05:06.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:07.74,0:05:11.00,CN,,0000,0000,0000,,Жүргізушінің жұмысы аяқталғаннан кейін жақын маңдағы автостанцияда.
Dialogue: 0,0:05:11.04,0:05:14.82,CN,,0000,0000,0000,,Өйткені, сіз жоғары сапалы жәрдемақы сатып ала аласыз.
Dialogue: 0,0:05:11.19,0:05:14.89,CN,,0000,0000,0000,,Гинза суши мейрамханасы
Dialogue: 0,0:05:14.93,0:05:17.46,CN,,0000,0000,0000,,Егер сіз қоғамдық доменде болсаңыз, бізге қоңырау шалыңыз.
Dialogue: 0,0:05:19.72,0:05:22.14,CN,,0000,0000,0000,,Бұл сіздің бірінші тағамыңыз.
Dialogue: 0,0:05:22.17,0:05:23.64,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:05:24.08,0:05:25.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:27.31,0:05:30.06,CN,,0000,0000,0000,,Мен кеше түнде түс көрдім
Dialogue: 0,0:05:30.06,0:05:31.36,CN,,0000,0000,0000,,Менің арманым орындалды
Dialogue: 0,0:05:31.36,0:05:32.32,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:05:32.48,0:05:34.99,CN,,0000,0000,0000,,Осыдан кейін көп нәрсе есіме түсті.
Dialogue: 0,0:05:35.26,0:05:37.17,CN,,0000,0000,0000,,Мен де
Dialogue: 0,0:05:37.24,0:05:38.25,CN,,0000,0000,0000,,Салыстыру?
Dialogue: 0,0:05:38.58,0:05:41.79,CN,,0000,0000,0000,,Әжімделуі мүмкін қастар туралы қысқаша мәлімет
Dialogue: 0,0:05:41.79,0:05:43.05,CN,,0000,0000,0000,,Әңгімелер кітабы
Dialogue: 0,0:05:43.17,0:05:45.95,CN,,0000,0000,0000,,Әкемнің әңгімесі
Dialogue: 0,0:05:59.52,0:06:00.62,CN,,0000,0000,0000,,Мен тағы келдім
Dialogue: 0,0:06:00.84,0:06:03.86,CN,,0000,0000,0000,,Келесі кездескенше.
Dialogue: 0,0:06:04.02,0:06:05.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:05.99,0:06:07.82,CN,,0000,0000,0000,,Қысқа аяқты мүсін
Dialogue: 0,0:06:07.89,0:06:09.62,CN,,0000,0000,0000,,Габи Даиичи екінші нүкте
Dialogue: 0,0:06:10.15,0:06:11.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:12.19,0:06:13.32,CN,,0000,0000,0000,,Нұсқаулық 3: Аралдағы дискетаны алғаннан кейін он бес минут ішінде кемеге оралуыңыз керек.
Dialogue: 0,0:06:13.86,0:06:17.43,CN,,0000,0000,0000,,Елші осында келе салысымен, бақыт әлі сақталады.
Dialogue: 0,0:06:17.56,0:06:20.39,CN,,0000,0000,0000,,Бұл бір нүкте.
Dialogue: 0,0:06:19.36,0:06:20.76,Title,,0000,0000,0000,,Ғаламдық сәт
Dialogue: 0,0:06:20.76,0:06:23.06,Title,,0000,0000,0000,,Ғаламдық сәт
Dialogue: 0,0:06:39.51,0:06:44.93,CN,,0000,0000,0000,,Құдайдың субтитр жұбы
Dialogue: 0,0:06:39.51,0:06:45.08,CN,,0000,0000,0000,,Жапон және кейінгі жапондық кезең: Күміс тұт Аударма және түзету: Йе Лу
Dialogue: 0,0:06:39.51,0:06:45.05,Jp,,0000,0000,0000,,Қытай-жапон қос тілі
Dialogue: 0,0:06:46.58,0:06:52.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
