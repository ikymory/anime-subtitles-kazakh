Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.51,0:00:18.51,Default,,0,0,0,,♪~
Dialogue: 0,0:01:42.89,0:01:44.89,Default,,0,0,0,,~♪
Dialogue: 0,0:02:03.28,0:02:04.58,Default,,0,0,0,,(балтаның соғылған дыбысы)
Dialogue: 0,0:02:10.17,0:02:10.92,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:02:13.09,0:02:14.25,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:02:27.14,0:02:27.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.60,0:02:32.90,Default,,0,0,0,,(балтаның соғылған дыбысы)
Dialogue: 0,0:02:34.15,0:02:35.32,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:02:36.73,0:02:38.57,Default,,0,0,0,,Аа... Аа! ‬
Dialogue: 0,0:02:40.45,0:02:42.28,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:02:42.78,0:02:44.83,Default,,0,0,0,,(Эйнар Торфинннн) Жоқ! ‬
Dialogue: 0,0:02:47.91,0:02:49.08,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:51.92,0:02:55.50,Default,,0,0,0,,(2 адам) Ха ха ха ха...
Dialogue: 0,0:02:56.46,0:02:57.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:59.92,0:03:02.09,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:03:02.18,0:03:07.14,Default,,0,0,0,,Соңғысы аяқталды! ‬
Dialogue: 0,0:03:10.77,0:03:12.10,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:12.19,0:03:17.23,Default,,0,0,0,,(Эйнар мен Торфинннннің күлкісі)
Dialogue: 0,0:03:19.61,0:03:22.24,Default,,0,0,0,,Жоқ, мен сенбеймін.
Dialogue: 0,0:03:23.16,0:03:25.66,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз.
Dialogue: 0,0:03:25.74,0:03:28.79,Default,,0,0,0,,Екеуміз орманды далаға айналдырдық.
Dialogue: 0,0:03:29.29,0:03:33.83,Default,,0,0,0,,О, үш жылдан астам уақыт кетті...
Dialogue: 0,0:03:34.96,0:03:38.59,Default,,0,0,0,,Осы жердің бәрі біздікі болса ғой
Dialogue: 0,0:03:38.67,0:03:42.76,Default,,0,0,0,,Хаха, құлдар көтере алмайтын жері.
Dialogue: 0,0:03:45.80,0:03:47.56,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:03:48.64,0:03:50.10,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,0:03:51.14,0:03:55.36,Default,,0,0,0,,А, кеше маған Пател мырза айтты.
Dialogue: 0,0:03:56.94,0:04:03.11,Default,,0,0,0,,Осы тазартылған жерден келесі өнім бізге еркіндігімізді сатып алады.
Dialogue: 0,0:04:03.91,0:04:06.24,Default,,0,0,0,,Біраз балық аулайтын сияқты.
Dialogue: 0,0:04:08.16,0:04:09.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:12.50,0:04:17.50,Default,,0,0,0,,Эйнар не істейді? Мен бос кезде
Dialogue: 0,0:04:18.88,0:04:21.76,Default,,0,0,0,,Иә? Мен не істерімді білмеймін
Dialogue: 0,0:04:22.26,0:04:25.43,Default,,0,0,0,,Туған жеріме барсам да, отбасым жоқ.
Dialogue: 0,0:04:26.59,0:04:28.01,Default,,0,0,0,,Және...
Dialogue: 0,0:04:29.56,0:04:31.47,Default,,0,0,0,,Арнейз мырза туралы айтып отырсыз ба?
Dialogue: 0,0:04:32.23,0:04:34.89,Default,,0,0,0,,Хмм... Мен өзімді жайсыз сезінемін.
Dialogue: 0,0:04:37.40,0:04:40.65,Default,,0,0,0,,Арнейз мырзаның да еркін болғанын қалаймын.
Dialogue: 0,0:04:41.32,0:04:45.91,Default,,0,0,0,,Мен мұны істесем, өзімді одан да көңілді сезінемін...
Dialogue: 0,0:04:47.95,0:04:52.12,Default,,0,0,0,,Күйеуінің оны жіберуге ниеті жоқ.
Dialogue: 0,0:04:55.54,0:04:57.58,Default,,0,0,0,,Сіз ше? Торфинннн
Dialogue: 0,0:04:58.21,0:05:01.00,Default,,0,0,0,,Сіз Исландияға қайтып барасыз ба? ‬
Dialogue: 0,0:05:01.50,0:05:02.30,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:05:03.01,0:05:07.09,Default,,0,0,0,,Иә, менің ойымша... мүмкін.
Dialogue: 0,0:05:07.72,0:05:11.51,Default,,0,0,0,,Не? Ей, сіз өзіңізді бей-жай сезінесіз.
Dialogue: 0,0:05:11.60,0:05:12.89,Default,,0,0,0,,Біз бір-бірімізді жоққа шығарамыз.
Dialogue: 0,0:05:12.97,0:05:16.60,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:05:17.94,0:05:21.48,Default,,0,0,0,,Аға, бұл біртүрлі.
Dialogue: 0,0:05:22.44,0:05:26.95,Default,,0,0,0,,Бостандық жақындағанда, бұл жер.
Dialogue: 0,0:05:38.71,0:05:41.75,Default,,0,0,0,,Мен бір нәрсені байқап көргім келеді...
Dialogue: 0,0:05:44.38,0:05:46.55,Default,,0,0,0,,Аа~ Не? ‬
Dialogue: 0,0:05:47.09,0:05:49.18,Default,,0,0,0,,Иә... жоқ...
Dialogue: 0,0:05:49.64,0:05:52.39,Default,,0,0,0,,Көп нәрсе әлі анық емес.
Dialogue: 0,0:05:58.98,0:06:01.77,Default,,0,0,0,,Сіз қалай ойлайсыз? Эйнар
Dialogue: 0,0:06:04.53,0:06:11.28,Default,,0,0,0,,Дүниеден соғыс пен құлдықты жою мүмкін емес пе?
Dialogue: 0,0:06:26.63,0:06:30.89,Default,,0,0,0,,Иә... бұл арман сияқты.
Dialogue: 0,0:06:38.94,0:06:43.06,Default,,0,0,0,,О! Ақыры соңғысын жеңдім.
Dialogue: 0,0:06:43.56,0:06:45.86,Default,,0,0,0,,Жарайсыңдар, екеуің де.
Dialogue: 0,0:06:46.44,0:06:47.65,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:06:48.11,0:06:52.70,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жер егіс алдында тегістелуі мүмкін бе? ‬
Dialogue: 0,0:06:52.78,0:06:55.20,Default,,0,0,0,,Иә, мүмкін асығыңыз.
Dialogue: 0,0:06:55.95,0:06:59.50,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:07:00.00,0:07:02.83,Default,,0,0,0,,Жарайды, аздап берейік.
Dialogue: 0,0:07:04.17,0:07:09.05,Default,,0,0,0,,Тұқым себілген бойда екеуің боссыңдар.
Dialogue: 0,0:07:10.72,0:07:15.01,Default,,0,0,0,,Жақсы жұмыс Торфинннн Эйнар
Dialogue: 0,0:07:18.77,0:07:19.93,Default,,0,0,0,,(2 адам) А...
Dialogue: 0,0:07:20.85,0:07:25.48,Default,,0,0,0,,Иә? Не? Өте бақытты көрінбейді
Dialogue: 0,0:07:25.57,0:07:28.15,Default,,0,0,0,,Ах! А... жоқ, жоқ! ‬
Dialogue: 0,0:07:28.94,0:07:30.90,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:07:30.99,0:07:31.65,Default,,0,0,0,,‪‬
Dialogue: 0,0:07:31.74,0:07:34.32,Default,,0,0,0,,Сәлем, Торфинннн! Мен мұны ақырында жасадым! ‬
Dialogue: 0,0:07:34.41,0:07:35.95,Default,,0,0,0,,Иә... Иә! ‬
Dialogue: 0,0:07:36.03,0:07:38.62,Default,,0,0,0,,Уау! Жоқ, кешіріңіз
Dialogue: 0,0:07:39.08,0:07:40.79,Default,,0,0,0,,Қуануға әлі ерте
Dialogue: 0,0:07:40.87,0:07:41.79,Default,,0,0,0,,(2 адам) Иә? ‬
Dialogue: 0,0:07:41.87,0:07:45.92,Default,,0,0,0,,Ресмиліктер мен қайтып келгенше күтуге тура келеді.
Dialogue: 0,0:07:46.00,0:07:48.34,Default,,0,0,0,,А, сіз шығасыз ба? ‬
Dialogue: 0,0:07:48.42,0:07:49.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:49.59,0:07:53.05,Default,,0,0,0,,А, айтпақшы, балалар үлкен адамды танымайсыңдар ма? ‬
Dialogue: 0,0:07:53.76,0:07:55.97,Default,,0,0,0,,Мен мұнда емеспін, бірақ...
Dialogue: 0,0:07:56.64,0:08:00.93,Default,,0,0,0,,Бұл дала болған шығар.
Dialogue: 0,0:08:01.56,0:08:06.15,Default,,0,0,0,,Жарайсыңдар, сендер де істей аласыңдар. Үлкен кісіні кездестірсеңіз, хабарлаңыз.
Dialogue: 0,0:08:07.32,0:08:13.78,Default,,0,0,0,,Мен Джеллингтегі Король сарайында Мәртебелі Король Харальдпен кездесуге бара жатырмын.
Dialogue: 0,0:08:14.78,0:08:18.28,Default,,0,0,0,,Бірақ, мен тұқым себілгенше қайтамын.
Dialogue: 0,0:08:18.37,0:08:21.66,Default,,0,0,0,,Осы уақытқа дейін жерді тегістеуді аяқтаңыз.
Dialogue: 0,0:08:21.75,0:08:22.66,Default,,0,0,0,,(Торфинннн Эйнар) Иә! ‬
Dialogue: 0,0:08:24.54,0:08:26.92,Default,,0,0,0,,Қош келдіңіз! ‬
Dialogue: 0,0:08:28.38,0:08:30.34,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.17,0:08:34.42,Default,,0,0,0,,Балалар, сендер еркін боласыңдар
Dialogue: 0,0:08:34.51,0:08:37.97,Default,,0,0,0,,Сіз менің орнымда қызмет етуді жалғастырғыңыз келе ме? ‬
Dialogue: 0,0:08:38.55,0:08:42.18,Default,,0,0,0,,Сіздей еңбекқорларды қабыл алыңыздар.
Dialogue: 0,0:08:43.85,0:08:46.31,Default,,0,0,0,,Ойланып көрші.
Dialogue: 0,0:09:25.98,0:09:29.86,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:09:48.79,0:09:50.54,Default,,0,0,0,,‪‬
Dialogue: 0,0:09:50.63,0:09:52.71,Default,,0,0,0,,Кешіріңіз, Мәртебелі.
Dialogue: 0,0:09:54.05,0:09:57.26,Default,,0,0,0,,Кеме жақында Джеллингке жетеді.
Dialogue: 0,0:09:58.18,0:10:01.47,Default,,0,0,0,,Ояныңыз, Мәртебелі Канут
Dialogue: 0,0:10:46.81,0:10:48.39,Default,,0,0,0,,Мәртебелі Канут
Dialogue: 0,0:10:48.48,0:10:50.98,Default,,0,0,0,,Осындай жерлерде...
Dialogue: 0,0:10:51.06,0:10:54.40,Default,,0,0,0,,Жылқы жақында дайын болады. Кабинада күтіңіз.
Dialogue: 0,0:10:54.86,0:10:56.23,Default,,0,0,0,,(Cnut) Бұл жақсы.
Dialogue: 0,0:10:57.57,0:11:01.28,Default,,0,0,0,,Үйге келмегеніме көп болды. Мен желді сезгім келеді.
Dialogue: 0,0:11:04.12,0:11:05.41,Default,,0,0,0,,Мәртебелі Канут
Dialogue: 0,0:11:08.83,0:11:12.79,Default,,0,0,0,,Англиядан аман-есен оралуыңызбен құттықтаймыз.
Dialogue: 0,0:11:12.88,0:11:17.38,Default,,0,0,0,,(Кнут) Мм, Қасқыр, сенің ағаң патшаның денсаулығы қалай? ‬
Dialogue: 0,0:11:17.46,0:11:18.46,Default,,0,0,0,,Га
Dialogue: 0,0:11:18.96,0:11:22.59,Default,,0,0,0,,Мәртебелі Харальдтың денсаулығы жақсы емес.
Dialogue: 0,0:11:23.09,0:11:25.64,Default,,0,0,0,,Соңғы бір айда менің ауруым одан әрі өршіп кетті.
Dialogue: 0,0:11:25.72,0:11:30.06,Default,,0,0,0,,Ол қазірдің өзінде сөйлей алмайды.
Dialogue: 0,0:11:31.64,0:11:32.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:33.48,0:11:35.02,Default,,0,0,0,,Қанша? ‬
Dialogue: 0,0:11:35.86,0:11:38.23,Default,,0,0,0,,Қамқоршы не дейді
Dialogue: 0,0:11:38.73,0:11:41.53,Default,,0,0,0,,Соңғы бірнеше күн тау асуы болды...
Dialogue: 0,0:11:42.03,0:11:42.78,Default,,0,0,0,,(Бала) Міне! ‬
Dialogue: 0,0:11:43.66,0:11:44.66,Default,,0,0,0,,(Кут) Түсіндім.
Dialogue: 0,0:11:45.16,0:11:48.04,Default,,0,0,0,,Менің атымнан сізге келу үлкен мәртебе болды.
Dialogue: 0,0:11:48.12,0:11:48.79,Default,,0,0,0,,Га
Dialogue: 0,0:11:51.25,0:11:53.54,Default,,0,0,0,,(Бала) О! (Бала) Ия! ‬
Dialogue: 0,0:11:53.62,0:11:55.75,Default,,0,0,0,,(Бала) Ите... (Бала) Мен тағы да жеңдім! ‬
Dialogue: 0,0:11:55.84,0:11:57.71,Default,,0,0,0,,(Кут) Сол доп ойыны...
Dialogue: 0,0:11:58.71,0:12:02.93,Default,,0,0,0,,Бала кезімде ұлы мәртебелі аға осыған шебер еді.
Dialogue: 0,0:12:06.68,0:12:10.27,Default,,0,0,0,,Ол кейде менімен ойнайтын.
Dialogue: 0,0:12:14.98,0:12:17.19,Default,,0,0,0,,(Кнут) Бауырым, ұр, ұр! ‬
Dialogue: 0,0:12:18.32,0:12:22.57,Default,,0,0,0,,Хаха Жарайды, допқа мұқият қара, Кнут.
Dialogue: 0,0:12:23.32,0:12:26.91,Default,,0,0,0,,(Кнут) Қамалдағы адамдар келесі патша кім болатыны үшін таласып жатыр.
Dialogue: 0,0:12:26.99,0:12:30.29,Default,,0,0,0,,Ұлы мәртебелі патша ағам екеуміздің арамызда жанжал болды.
Dialogue: 0,0:12:30.95,0:12:35.29,Default,,0,0,0,,Мәртебелі мырзаның өзі мұндай істерге мән бермеді.
Dialogue: 0,0:12:36.08,0:12:36.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:38.00,0:12:38.96,Default,,0,0,0,,Міне! ‬
Dialogue: 0,0:12:39.46,0:12:40.92,Default,,0,0,0,,(Кут) А...
Dialogue: 0,0:12:41.46,0:12:43.51,Default,,0,0,0,,Уау! Апыр-ай! Уф! ‬
Dialogue: 0,0:12:43.59,0:12:46.14,Default,,0,0,0,,Уа, мәртебелі! ‬
Dialogue: 0,0:12:46.22,0:12:47.18,Default,,0,0,0,,Рагнар
Dialogue: 0,0:12:51.35,0:12:52.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:53.35,0:12:54.89,Default,,0,0,0,,О! ‬
Dialogue: 0,0:12:56.48,0:12:57.69,Default,,0,0,0,,(Кут) Жарайды.
Dialogue: 0,0:12:58.15,0:12:59.36,Default,,0,0,0,,О, құдай! ‬
Dialogue: 0,0:13:00.86,0:13:04.57,Default,,0,0,0,,Не? Ол сен ойлағаннан да қатал.
Dialogue: 0,0:13:05.11,0:13:08.53,Default,,0,0,0,,Жалпы айтқанда, сіз де аздап қорғансыз.
Dialogue: 0,0:13:08.62,0:13:09.24,Default,,0,0,0,,Тағы біраз...
Dialogue: 0,0:13:09.33,0:13:10.95,Default,,0,0,0,,Жарайсың! ‬
Dialogue: 0,0:13:11.54,0:13:12.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:14.83,0:13:18.79,Default,,0,0,0,,Мәртебеліңіз күткендей, сіз шынымен зардап шектіңіз бе? ‬
Dialogue: 0,0:13:18.88,0:13:21.34,Default,,0,0,0,,(Кнут) Иә, рахмет Рагнар.
Dialogue: 0,0:13:22.46,0:13:25.42,Default,,0,0,0,,Мен көп киім кигендіктен қозғалу қиын.
Dialogue: 0,0:13:25.51,0:13:28.01,Default,,0,0,0,,Ал ыстық. Мен оны шешіп аламын ба? ‬
Dialogue: 0,0:13:28.09,0:13:29.51,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,0:13:30.18,0:13:33.35,Default,,0,0,0,,Жауынгерлер дайын болуы керек
Dialogue: 0,0:13:33.43,0:13:34.06,Default,,0,0,0,,(Кнут) Хэхехе
Dialogue: 0,0:13:34.14,0:13:36.52,Default,,0,0,0,,Тыңдап отырсыз ба, Мәртебелі?
Dialogue: 0,0:13:36.60,0:13:38.52,Default,,0,0,0,,Кез келген уақытта...
Dialogue: 0,0:13:38.60,0:13:42.15,Default,,0,0,0,,(Кнут) Ол күшті және мейірімді еді.
Dialogue: 0,0:13:45.36,0:13:49.37,Default,,0,0,0,,Менің ағам ұлы мәртебелі патша маған көп көмектесті.
Dialogue: 0,0:13:50.87,0:13:52.87,Default,,0,0,0,,Мен ризашылығымды білдіруім керек.
Dialogue: 0,0:13:54.83,0:13:56.16,Default,,0,0,0,,(Бала) Міне! (Бала) Ия! ‬
Dialogue: 0,0:13:56.25,0:13:57.50,Default,,0,0,0,,(Бала) Уау! ‬
Dialogue: 0,0:14:06.97,0:14:07.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:12.43,0:14:15.14,Default,,0,0,0,,Ей, балалар, басқа жерде ойнаңдар! ‬
Dialogue: 0,0:14:15.72,0:14:17.23,Default,,0,0,0,,(Балалар) Кешіріңіз.
Dialogue: 0,0:14:25.03,0:14:26.99,Default,,0,0,0,,(Бала) Тым алыс ұшып бара жатырсың, Аста.
Dialogue: 0,0:14:27.49,0:14:31.03,Default,,0,0,0,,Балалар қарапайым...
Dialogue: 0,0:14:31.53,0:14:32.03,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:14:32.95,0:14:34.91,Default,,0,0,0,,Қалай болды? Мәртебелі
Dialogue: 0,0:14:40.62,0:14:41.96,Default,,0,0,0,,(Кнут) Мен көмектесе алмаймын.
Dialogue: 0,0:14:47.34,0:14:49.88,Default,,0,0,0,,(Әңгімелеу) Свеннің екі ұлы
Dialogue: 0,0:14:50.34,0:14:54.43,Default,,0,0,0,,Олардың әрқайсысы өз іздерін әкелерінен мұра етті.
Dialogue: 0,0:14:55.56,0:14:58.23,Default,,0,0,0,,Менің ағам Харальд Данияға кетті.
Dialogue: 0,0:14:58.68,0:15:01.81,Default,,0,0,0,,Оның ағасы Канут Англияны басып алды.
Dialogue: 0,0:15:02.27,0:15:05.15,Default,,0,0,0,,Қарым-қатынас жақсы болды
Dialogue: 0,0:15:07.23,0:15:10.28,Default,,0,0,0,,Кнуттың Англияны жаулап алуы туралы
Dialogue: 0,0:15:10.36,0:15:13.95,Default,,0,0,0,,Оның ағасы Харальд оған үлкен флотты, т.б.
Dialogue: 0,0:15:14.03,0:15:17.04,Default,,0,0,0,,Оны белсенді түрде қолдады.
Dialogue: 0,0:15:17.87,0:15:19.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:20.16,0:15:27.05,Default,,0,0,0,,Канут Англия королі ретінде таққа отырғаннан кейін көп ұзамай Харальд ауырып қалады.
Dialogue: 0,0:15:28.38,0:15:31.80,Default,,0,0,0,,Харальдтың заңды балалары болған жоқ.
Dialogue: 0,0:15:33.14,0:15:36.10,Default,,0,0,0,,А... Кнут аға! ‬
Dialogue: 0,0:15:36.18,0:15:39.68,Default,,0,0,0,,Жақсы! Сіз шынымен Джеллингке келдіңіз бе?
Dialogue: 0,0:15:40.18,0:15:42.90,Default,,0,0,0,,Мені Мәртебелі, Эстриз деп атаңыз.
Dialogue: 0,0:15:42.98,0:15:45.86,Default,,0,0,0,,Бұл кенет, мен таң қалдым.
Dialogue: 0,0:15:48.65,0:15:52.66,Default,,0,0,0,,Көптен бері көрмегелі, король Харальд
Dialogue: 0,0:15:57.53,0:16:02.21,Default,,0,0,0,,Харальд аға, Кнут бауырлас бізге қонаққа келді.
Dialogue: 0,0:16:02.83,0:16:04.63,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:16:05.33,0:16:08.13,Default,,0,0,0,,Жақсы, өзіңізді оятуға мәжбүрлемеңіз.
Dialogue: 0,0:16:08.21,0:16:10.05,Default,,0,0,0,,Біраз уақыт тұрыңыз
Dialogue: 0,0:16:10.55,0:16:14.05,Default,,0,0,0,,Мәртебелі әңгімеге ықылас білдіретін уақытты таңдайық.
Dialogue: 0,0:16:16.26,0:16:18.60,Default,,0,0,0,,Cnut…
Dialogue: 0,0:16:28.02,0:16:31.53,Default,,0,0,0,,(Кнут) Король Харальд Канут
Dialogue: 0,0:16:33.65,0:16:35.95,Default,,0,0,0,,Тыныш демалып алыңыз.
Dialogue: 0,0:16:37.07,0:16:41.04,Default,,0,0,0,,Менің патшалық туралы уайымым жоқ.
Dialogue: 0,0:16:44.83,0:16:48.54,Default,,0,0,0,,Мен сені күттім...
Dialogue: 0,0:16:50.38,0:16:52.30,Default,,0,0,0,,Сізге...
Dialogue: 0,0:16:55.88,0:17:01.56,Default,,0,0,0,,Мен сізге Данияны беремін...
Dialogue: 0,0:17:01.64,0:17:03.31,Default,,0,0,0,,(Барлығы) О! ‬
Dialogue: 0,0:17:08.35,0:17:11.90,Default,,0,0,0,,Сіз маған қорқынышты нәрсе айтып тұрсыз, Король Харальд.
Dialogue: 0,0:17:12.40,0:17:14.32,Default,,0,0,0,,Тезірек сауығып кетіңіз
Dialogue: 0,0:17:14.40,0:17:17.24,Default,,0,0,0,,Қайтадан доптармен ойнап көңіл көтерейік.
Dialogue: 0,0:17:18.28,0:17:21.83,Default,,0,0,0,,(Свен) Бұл үлкен мәселе, Кнут.
Dialogue: 0,0:17:22.49,0:17:27.46,Default,,0,0,0,,Ең дұрысы мұндай өтірік бейкүнә жүзбен айтылады.
Dialogue: 0,0:17:29.13,0:17:31.55,Default,,0,0,0,,А... Бауырым? ‬
Dialogue: 0,0:17:33.17,0:17:37.26,Default,,0,0,0,,Сіз уланған адамға барасыз ба?
Dialogue: 0,0:17:37.34,0:17:39.64,Default,,0,0,0,,Не деген фарс.
Dialogue: 0,0:17:39.72,0:17:45.48,Default,,0,0,0,,Сонымен, сіз нақты нені орындамақсыз?
Dialogue: 0,0:17:46.60,0:17:50.86,Default,,0,0,0,,Харальд сізге мейірімді болды.
Dialogue: 0,0:17:50.94,0:17:53.94,Default,,0,0,0,,Неліктен бізге өлтіру керек? ‬
Dialogue: 0,0:17:54.44,0:17:58.45,Default,,0,0,0,,Біз әлемді бірге билей аламыз.
Dialogue: 0,0:17:59.70,0:18:03.37,Default,,0,0,0,,Корольдік жұмақ үшін емес.
Dialogue: 0,0:18:04.16,0:18:08.83,Default,,0,0,0,,Амбиция жүрегіңде тұрады
Dialogue: 0,0:18:09.33,0:18:15.09,Default,,0,0,0,,Менің Солтүстік теңіз императоры болу амбициясы жоқ.
Dialogue: 0,0:18:18.55,0:18:21.43,Default,,0,0,0,,Бұл қарғыс
Dialogue: 0,0:18:21.51,0:18:24.77,Default,,0,0,0,,Бұл тәждің қарғысы.
Dialogue: 0,0:18:26.18,0:18:29.19,Default,,0,0,0,,Қашып кете алмаймын
Dialogue: 0,0:18:30.60,0:18:35.19,Default,,0,0,0,,Сіз Дания мен Англиясыз ба?
Dialogue: 0,0:18:35.90,0:18:39.20,Default,,0,0,0,,Екі тәж кию
Dialogue: 0,0:18:39.70,0:18:44.37,Default,,0,0,0,,Менен екі есе азап шегесің.
Dialogue: 0,0:18:45.54,0:18:49.58,Default,,0,0,0,,Хухаха... Аххахаха! ‬
Dialogue: 0,0:18:49.67,0:18:51.88,Default,,0,0,0,,Хухахаха! ‬
Dialogue: 0,0:18:52.46,0:18:53.13,Default,,0,0,0,,Бауырым! ‬
Dialogue: 0,0:19:00.88,0:19:03.72,Default,,0,0,0,,Не болды? Мен кенеттен абдырап қалдым...
Dialogue: 0,0:19:04.22,0:19:06.22,Default,,0,0,0,,Сіздің ағаңыз да ауырып жатыр ма? ‬
Dialogue: 0,0:19:16.61,0:19:20.24,Default,,0,0,0,,(Кнут) Бұл маңызды емес, бұл жай ғана бас айналу.
Dialogue: 0,0:19:24.49,0:19:26.16,Default,,0,0,0,,Жататын жерді дайында.
Dialogue: 0,0:19:26.24,0:19:29.00,Default,,0,0,0,,Мәртебелі Кануте саяхаттан шаршады.
Dialogue: 0,0:19:57.73,0:19:58.86,Default,,0,0,0,,‪‬
Dialogue: 0,0:20:00.03,0:20:01.15,Default,,0,0,0,,(Cnut) Не? ‬
Dialogue: 0,0:20:01.24,0:20:02.95,Default,,0,0,0,,(Қызметші) Лорд Эстриздің бұйрығымен.
Dialogue: 0,0:20:03.03,0:20:05.03,Default,,0,0,0,,Мен саған сусын әкелдім.
Dialogue: 0,0:20:07.12,0:20:08.70,Default,,0,0,0,,Қай жерде? ‬
Dialogue: 0,0:20:09.45,0:20:12.58,Default,,0,0,0,,(қызметші) Иә? Не дейсіз...
Dialogue: 0,0:20:15.13,0:20:18.09,Default,,0,0,0,,Маған керек емес, шөлдеген жоқпын
Dialogue: 0,0:20:19.59,0:20:24.84,Default,,0,0,0,,(Свен) Уудан қорқасың, өйткені оны өзің пайдаланасың.
Dialogue: 0,0:20:25.80,0:20:28.39,Default,,0,0,0,,Ноу? canute
Dialogue: 0,0:20:33.73,0:20:38.36,Default,,0,0,0,,Күннің ортасында көріну үшін бұл аздап артық еркелік.
Dialogue: 0,0:20:38.44,0:20:39.69,Default,,0,0,0,,Король Свен
Dialogue: 0,0:20:40.28,0:20:43.86,Default,,0,0,0,,Мені күндіз де көрсең
Dialogue: 0,0:20:43.95,0:20:48.20,Default,,0,0,0,,Қарғыс өзінің шарықтау шегіне жетеді.
Dialogue: 0,0:20:49.37,0:20:50.83,Default,,0,0,0,,(Қызметші) Монолог? ‬
Dialogue: 0,0:20:51.54,0:20:52.83,Default,,0,0,0,,(Кнут) Сен сонда қанша уақыт боласың?
Dialogue: 0,0:20:52.91,0:20:55.33,Default,,0,0,0,,(қызметші) Уф! (Кнут) Саған ештеңе жоқ. Кетіңіз.
Dialogue: 0,0:20:55.42,0:20:57.38,Default,,0,0,0,,А... иә! ‬
Dialogue: 0,0:21:00.46,0:21:04.55,Default,,0,0,0,,(Кнут) Жұмақ құрылысы ұлтты біріктіруге негізделген.
Dialogue: 0,0:21:05.05,0:21:08.93,Default,,0,0,0,,Екі патшаның болуы – апаттың рецепті.
Dialogue: 0,0:21:09.60,0:21:12.35,Default,,0,0,0,,Король Харальдтың өлімі қажет
Dialogue: 0,0:21:14.27,0:21:16.06,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:21:16.56,0:21:18.86,Default,,0,0,0,,Неге...
Dialogue: 0,0:21:19.44,0:21:24.86,Default,,0,0,0,,Сіз толыққанды патша сияқты ойлай бастаған жоқсыз ба?
Dialogue: 0,0:21:24.95,0:21:26.11,Default,,0,0,0,,Cnut
Dialogue: 0,0:21:28.95,0:21:31.95,Default,,0,0,0,,(Кнут) Ха... хех хе хе.
Dialogue: 0,0:21:32.04,0:21:34.20,Default,,0,0,0,,(Свен) Неге күлесің? ‬
Dialogue: 0,0:21:35.41,0:21:41.38,Default,,0,0,0,,Свен патша, мен сені бір кездері жек көріп, өліміңді тілеп едім.
Dialogue: 0,0:21:42.05,0:21:43.76,Default,,0,0,0,,Бірақ қазір ше?
Dialogue: 0,0:21:44.97,0:21:49.80,Default,,0,0,0,,Шынымды айтсам жалғыз адам сенсің.
Dialogue: 0,0:21:52.26,0:21:54.35,Default,,0,0,0,,Келіңіздер, жарасайық
Dialogue: 0,0:21:57.02,0:22:00.19,Default,,0,0,0,,Қарғыс атқан адамдар бірге
Dialogue: 0,0:22:02.90,0:22:04.99,Default,,0,0,0,,(Свен) Хехехе...
Dialogue: 0,0:22:13.66,0:22:15.91,Default,,0,0,0,,Бауырым, қайталап көріңіз! ‬
Dialogue: 0,0:22:16.66,0:22:17.58,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:22:17.66,0:22:19.92,Default,,0,0,0,,Хахаха жарайды
Dialogue: 0,0:22:20.00,0:22:21.08,Default,,0,0,0,,Хахаха
Dialogue: 0,0:22:22.17,0:22:23.75,Default,,0,0,0,,Кеттік, Кнут.
Dialogue: 0,0:22:23.84,0:22:24.67,Default,,0,0,0,,(Cnut) Иә! ‬
Dialogue: 0,0:22:25.17,0:22:26.30,Default,,0,0,0,,(Свен) Харальд
Dialogue: 0,0:22:30.43,0:22:33.26,Default,,0,0,0,,Бұл әскери кеңес, сен де кел.
Dialogue: 0,0:22:34.56,0:22:35.97,Default,,0,0,0,,Иә, әке.
Dialogue: 0,0:22:38.31,0:22:39.85,Default,,0,0,0,,Кешіріңіз, Кнут.
Dialogue: 0,0:22:40.52,0:22:41.94,Default,,0,0,0,,Кейінірек жалғастырылады
Dialogue: 0,0:22:44.44,0:22:46.19,Default,,0,0,0,,Рахмет, аға.
Dialogue: 0,0:23:03.34,0:23:06.09,Default,,0,0,0,,Күшті бол, Кнут.
Dialogue: 0,0:23:08.05,0:23:10.88,Default,,0,0,0,,Менен де, әкемнен де артық.
Dialogue: 0,0:23:12.47,0:23:13.30,Default,,0,0,0,,Жақсы ма? ‬
Dialogue: 0,0:23:16.93,0:23:17.89,Default,,0,0,0,,Иә
Dialogue: 0,0:23:38.33,0:23:42.46,Default,,0,0,0,,Келіңіздер, Мәртебелі! Мен сенің келесі қарсыласыңмын.
Dialogue: 0,0:23:42.54,0:23:44.75,Default,,0,0,0,,(Кнут) А, сен Рагнарды жасай аласың ба? ‬
Dialogue: 0,0:23:44.84,0:23:46.67,Default,,0,0,0,,Бұл сұмдық! ‬
Dialogue: 0,0:23:46.75,0:23:48.67,Default,,0,0,0,,Бұл Рагнар бұрын болған
Dialogue: 0,0:23:48.76,0:23:52.34,Default,,0,0,0,,Тоған жанындағы Грибблсти қорқады...
Dialogue: 0,0:23:59.93,0:24:03.56,Default,,0,0,0,,Хмф... осындай нәрсе ме?
Dialogue: 0,0:24:06.94,0:24:09.03,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:24:16.53,0:24:18.54,Default,,0,0,0,,♪~
Dialogue: 0,0:25:43.58,0:25:45.58,Default,,0,0,0,,~♪
Dialogue: 0,0:25:47.08,0:25:52.08,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
