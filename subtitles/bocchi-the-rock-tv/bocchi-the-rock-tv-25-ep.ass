Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.95,0:00:03.95,Default,,0,0,0,,Жасырынбақ ойнайтын адам
Dialogue: 0,0:00:00.95,0:00:03.95,Default,,0,0,0,,Мына саусақты тоқтат!
Dialogue: 0,0:00:03.95,0:00:09.96,Default,,0,0,0,,《Жалғыз: I
Dialogue: 0,0:00:03.95,0:00:09.96,Default,,0,0,0,,Қызық, сол саусаққа тоқтаған дұрыс па?
Dialogue: 0,0:00:09.96,0:00:13.13,Default,,0,0,0,,Мен бұл туралы ойлағанымда,
Dialogue: 0,0:00:09.96,0:00:13.13,Default,,0,0,0,,Пойыздан қалып қойды➡︎
Dialogue: 0,0:00:13.13,0:00:17.46,Default,,0,0,0,,Жалғыз бала екенімді түсінгенде
Dialogue: 0,0:00:17.46,0:00:22.47,Default,,0,0,0,,Экскурсияда мұғаліммен бірге
Dialogue: 0,0:00:17.46,0:00:22.47,Default,,0,0,0,,Біз гарнирлерді түскі ас қораптарына ауыстырдық➡︎
Dialogue: 0,0:00:22.47,0:00:25.47,Default,,0,0,0,,Жалғыз бала》
Dialogue: 0,0:00:25.47,0:00:27.81,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:00:27.81,0:00:29.81,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:29.81,0:00:33.65,Default,,0,0,0,,《Мен үйірме жұмыстарына қатыспаймын және сабақтан кейін бірден үйге қайтамын》
Dialogue: 0,0:00:33.65,0:00:35.65,Default,,0,0,0,,(Қабылданған дыбыс)
Dialogue: 0,0:00:35.65,0:00:40.82,Default,,0,0,0,,《Смартфоныма ата-анамнан келген хабарлама ма?
Dialogue: 0,0:00:35.65,0:00:40.82,Default,,0,0,0,,Тек купон туралы хабарлама
Dialogue: 0,0:00:40.82,0:00:46.83,Default,,0,0,0,,Бұл мен, Хитори Гото, орта мектептің 1 курс оқушысы
Dialogue: 0,0:00:46.83,0:00:49.50,Default,,0,0,0,,Мен кейде ойлаймын
Dialogue: 0,0:00:49.50,0:00:52.33,Default,,0,0,0,,Менің ойымша, бұл дұрыс па?
Dialogue: 0,0:00:52.33,0:00:56.67,Default,,0,0,0,,Бірақ мен айтпас бұрын
Dialogue: 0,0:00:52.33,0:00:56.67,Default,,0,0,0,,Сіз "Ах"➡︎ айтасыз
Dialogue: 0,0:00:56.67,0:00:58.67,Default,,0,0,0,,Мен де көз тиюге жақсы емеспін.
Dialogue: 0,0:00:58.67,0:01:02.44,Default,,0,0,0,,THE･ｷｬ々
Dialogue: 0,0:00:58.67,0:01:02.44,Default,,0,0,0,,Бойыңызға қарай...》
Dialogue: 0,0:01:02.44,0:01:06.78,Default,,0,0,0,,Сіз мұны көріп тұрсыз ба?
Dialogue: 0,0:01:02.44,0:01:06.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:06.78,0:01:11.45,Default,,0,0,0,,Студент кезімде, Сынып бұрышында
Dialogue: 0,0:01:06.78,0:01:11.45,Default,,0,0,0,,Ол кітап оқып отырғандай кейіп танытты.
Dialogue: 0,0:01:11.45,0:01:13.45,Default,,0,0,0,,📺Менің достарым жоқ
Dialogue: 0,0:01:11.45,0:01:13.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:13.45,0:01:18.29,Default,,0,0,0,,📺Енді жастар туралы.
Dialogue: 0,0:01:13.45,0:01:18.29,Default,,0,0,0,,Бұл өте танымал топқа айналды.
Dialogue: 0,0:01:18.29,0:01:21.63,Default,,0,0,0,,Ал, жолақ қараңғыда да жарқырайды.
Dialogue: 0,0:01:21.63,0:01:23.96,Default,,0,0,0,,📺Дұрыс~
Dialogue: 0,0:01:23.96,0:01:29.47,Default,,0,0,0,,📺Тыңдаңыз.
Dialogue: 0,0:01:23.96,0:01:29.47,Default,,0,0,0,,In-Storms ішіндегі ``Триггер''
Dialogue: 0,0:01:29.47,0:01:33.97,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:01:33.97,0:01:35.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:35.98,0:01:38.14,Default,,0,0,0,,Әке, гитараңызды маған беріңізші.
Dialogue: 0,0:01:38.14,0:01:40.15,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:40.15,0:01:42.98,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:01:42.98,0:01:46.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:42.98,0:01:46.98,Default,,0,0,0,,Ақырында мен гитараға қызығамын...
Dialogue: 0,0:01:48.99,0:01:52.66,Default,,0,0,0,,《Банды жинағаннан кейін
Dialogue: 0,0:01:48.99,0:01:52.66,Default,,0,0,0,,Тіпті мен сияқты адамдарға➡︎
Dialogue: 0,0:01:52.66,0:01:55.36,Default,,0,0,0,,Мүмкін жарқырайтын шығар? 》
Dialogue: 0,0:01:58.50,0:02:00.50,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:02:03.27,0:02:05.77,Default,,0,0,0,,(Тынысы тарылған дыбыс)
Dialogue: 0,0:02:05.77,0:02:08.27,Default,,0,0,0,,Ахх...
Dialogue: 0,0:02:08.27,0:02:11.61,Default,,0,0,0,,《Мен шештім! Гитарада жақсырақ болыңыз!
Dialogue: 0,0:02:11.61,0:02:14.11,Default,,0,0,0,,Мектепте топ құрдық...》
Dialogue: 0,0:02:14.11,0:02:17.28,Default,,0,0,0,,E A G…
Dialogue: 0,0:02:17.28,0:02:19.98,Default,,0,0,0,,Неліктен ағылшын тілі кенеттен пайда болды?
Dialogue: 0,0:02:23.46,0:02:26.29,Default,,0,0,0,,《Сонымен біз мектеп фестивалінде өнер көрсеттік➡︎
Dialogue: 0,0:02:26.29,0:02:29.59,Default,,0,0,0,,Барлығы мені қолдайды.
Dialogue: 0,0:02:50.98,0:02:52.98,Default,,0,0,0,,Эй... Эй?
Dialogue: 0,0:04:24.95,0:04:28.63,Default,,0,0,0,,♬︎(Гитара)
Dialogue: 0,0:04:28.63,0:04:34.96,Default,,0,0,0,,《Халық алдында өнер көрсете білу
Dialogue: 0,0:04:28.63,0:04:34.96,Default,,0,0,0,,Күн сайын 6 сағат жаттығу нәтижесінде...
Dialogue: 0,0:04:34.96,0:04:38.97,Default,,0,0,0,,Мен мұны білмей тұрып, орта мектеп бітті》
Dialogue: 0,0:04:38.97,0:04:41.80,Default,,0,0,0,,Мен тікелей эфирге бара алмадым
Dialogue: 0,0:04:38.97,0:04:41.80,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:04:41.80,0:04:44.81,Default,,0,0,0,,Жиналмаған
Dialogue: 0,0:04:41.80,0:04:44.81,Default,,0,0,0,,Топ мүшелері!
Dialogue: 0,0:04:44.81,0:04:48.31,Default,,0,0,0,,Ешбір дос таба алмадым.
Dialogue: 0,0:04:44.81,0:04:48.31,Default,,0,0,0,,3 жыл!
Dialogue: 0,0:04:48.31,0:04:50.58,Default,,0,0,0,,Орта мектеп – бұл...
Dialogue: 0,0:04:50.58,0:04:55.92,Default,,0,0,0,,Орта мектепке жеткенде
Dialogue: 0,0:04:50.58,0:04:55.92,Default,,0,0,0,,Мен міндетті түрде топта ойнаймын!
Dialogue: 0,0:04:55.92,0:04:59.76,Default,,0,0,0,,《Мен шешкен орта мектеп өмірі
Dialogue: 0,0:04:55.92,0:04:59.76,Default,,0,0,0,,Оның басталғанына бір ай болды
Dialogue: 0,0:04:59.76,0:05:02.59,Default,,0,0,0,,Гитара – менің жүрегімнің тынығатын жалғыз жері
Dialogue: 0,0:05:02.59,0:05:08.60,Default,,0,0,0,,Мен жалғыз болуға бір қадам қалдым.
Dialogue: 0,0:05:08.60,0:05:13.60,Default,,0,0,0,,Әннің сөзі мен шығармасы өзімдікі
Dialogue: 0,0:05:08.60,0:05:13.60,Default,,0,0,0,,Махаббатпен шкафтан...
Dialogue: 0,0:05:13.60,0:05:15.61,Default,,0,0,0,,Түн ортасында➡︎
Dialogue: 0,0:05:15.61,0:05:19.11,Default,,0,0,0,,Менің түкті түпнұсқа әніммен
Dialogue: 0,0:05:15.61,0:05:19.11,Default,,0,0,0,,Маңайыңызда қиындық тудырмас бұрын➡︎
Dialogue: 0,0:05:19.11,0:05:22.28,Default,,0,0,0,,Танымал топтардың кавер бейнелері
Dialogue: 0,0:05:19.11,0:05:22.28,Default,,0,0,0,,Жаңарту керек
Dialogue: 0,0:05:22.28,0:05:25.78,Default,,0,0,0,,Әкем мені жігерлендірді
Dialogue: 0,0:05:22.28,0:05:25.78,Default,,0,0,0,,Гитара батыры➡︎ атымен
Dialogue: 0,0:05:25.78,0:05:28.95,Default,,0,0,0,,Оны ойнап жатқан бейнеңізді жүктеп салыңыз.
Dialogue: 0,0:05:25.78,0:05:28.95,Default,,0,0,0,,Біраз уақыт өтті...》
Dialogue: 0,0:05:28.95,0:05:33.62,Default,,0,0,0,,Алдыңғы бейне
Dialogue: 0,0:05:28.95,0:05:33.62,Default,,0,0,0,,Мұндай пікірлер қазірдің өзінде бар.
Dialogue: 0,0:05:33.62,0:05:38.13,Default,,0,0,0,,《Hehehehe…
Dialogue: 0,0:05:33.62,0:05:38.13,Default,,0,0,0,,Соңғы уақытта ол өте көп қаралды ➡︎
Dialogue: 0,0:05:38.13,0:05:40.13,Default,,0,0,0,,Адамдар мұны жақсы дейді.
Dialogue: 0,0:05:40.13,0:05:43.13,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:40.13,0:05:43.13,Default,,0,0,0,,Шындық қиын болса да жақсы
Dialogue: 0,0:05:43.13,0:05:46.64,Default,,0,0,0,,Желіде маған жауап беретін адамдар бар.
Dialogue: 0,0:05:43.13,0:05:46.64,Default,,0,0,0,,Көп.
Dialogue: 0,0:05:46.64,0:05:49.81,Default,,0,0,0,,Мұндағы мен сияқты
Dialogue: 0,0:05:46.64,0:05:49.81,Default,,0,0,0,,Тереңде жатқан коммунизм көп...》
Dialogue: 0,0:05:49.81,0:05:51.74,Default,,0,0,0,,Бұл ән топта
Dialogue: 0,0:05:49.81,0:05:51.74,Default,,0,0,0,,Мен оны мектеп фестивалінде ойнадым...
Dialogue: 0,0:05:51.74,0:05:53.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:55.75,0:05:58.25,Default,,0,0,0,,《Мен де күш салдым.
Dialogue: 0,0:05:58.25,0:06:01.25,Default,,0,0,0,,Ықшам дискіні алып, үстелге қойыңыз...》
Dialogue: 0,0:06:01.25,0:06:03.25,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:03.25,0:06:05.25,Default,,0,0,0,,《Топтың тауарларымен шағымдану...》
Dialogue: 0,0:06:05.25,0:06:07.26,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:07.26,0:06:09.26,Default,,0,0,0,,《Түскі ас сұрау әні...》
Dialogue: 0,0:06:09.26,0:06:13.10,Default,,0,0,0,,(([Спикер] Келесі ән
Dialogue: 0,0:06:09.26,0:06:13.10,Default,,0,0,0,,Бұл Гото мырзаның өтініші, 2А сыныбы))
Dialogue: 0,0:06:13.10,0:06:16.10,Default,,0,0,0,,《Сол кезде танымал болған десметалдарды тарат...》
Dialogue: 0,0:06:16.10,0:06:19.94,Default,,0,0,0,,(([Денеші] Бас сүйегіңізді жарыңыз
Dialogue: 0,0:06:16.10,0:06:19.94,Default,,0,0,0,,Уау! ))
Dialogue: 0,0:06:19.94,0:06:21.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:19.94,0:06:21.94,Default,,0,0,0,,Кун Кун
Dialogue: 0,0:06:21.94,0:06:23.94,Default,,0,0,0,,《Флешбэк~!
Dialogue: 0,0:06:23.94,0:06:26.11,Default,,0,0,0,,Ұмыт, ұмыт! 》
Dialogue: 0,0:06:26.11,0:06:28.11,Default,,0,0,0,,Сенде ондайға батылың жетпейді ғой
Dialogue: 0,0:06:33.28,0:06:35.58,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:06:43.63,0:06:47.33,Default,,0,0,0,,《Ой, анау қол бар еді! 》
Dialogue: 0,0:06:59.58,0:07:04.25,Default,,0,0,0,,《Тамаша~!
Dialogue: 0,0:06:59.58,0:07:04.25,Default,,0,0,0,,Бірден топ қызы
Dialogue: 0,0:07:04.25,0:07:07.95,Default,,0,0,0,,Мен өзімді қарапайым адам емес сияқты сезінемін.
Dialogue: 0,0:07:04.25,0:07:07.95,Default,,0,0,0,,Керемет қатысу》
Dialogue: 0,0:07:09.92,0:07:14.09,Default,,0,0,0,,《Бұл сөзсіз біреу
Dialogue: 0,0:07:09.92,0:07:14.09,Default,,0,0,0,,Ол сізбен сөйлесуі керек.
Dialogue: 0,0:07:14.09,0:07:18.09,Default,,0,0,0,,Биылғы мектеп фестивалі қызу болмақ! 》
Dialogue: 0,0:07:32.94,0:07:35.11,Default,,0,0,0,,Сол себепті әлгі кішкентай бөксе...
Dialogue: 0,0:07:35.11,0:07:37.11,Default,,0,0,0,,Келесі жылжымалы сынып?
Dialogue: 0,0:07:35.11,0:07:37.11,Default,,0,0,0,,Ғылыми кабинет В
Dialogue: 0,0:07:37.11,0:07:39.28,Default,,0,0,0,,Осыдан кейін караоке жасайық.
Dialogue: 0,0:07:39.28,0:07:41.98,Default,,0,0,0,,А, бұл жақсы.
Dialogue: 0,0:07:39.28,0:07:41.98,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:46.46,0:07:48.46,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:51.39,0:07:54.40,Default,,0,0,0,,《Түн ортасында бақылаудан шығып қалдың ба?
Dialogue: 0,0:07:54.40,0:07:57.73,Default,,0,0,0,,Түсіну оңай
Dialogue: 0,0:07:54.40,0:07:57.73,Default,,0,0,0,,Топ қызды сезінсе де
Dialogue: 0,0:07:57.73,0:08:00.57,Default,,0,0,0,,А, сен менімен сөйлесуге дәті жоқсың.
Dialogue: 0,0:07:57.73,0:08:00.57,Default,,0,0,0,,Мүмкіндік...
Dialogue: 0,0:08:00.57,0:08:02.91,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:08:00.57,0:08:02.91,Default,,0,0,0,,Менде психикалық бұзылыс болады! 》
Dialogue: 0,0:08:02.91,0:08:04.91,Default,,0,0,0,,Уау! Қараңдар, қараңдар!
Dialogue: 0,0:08:04.91,0:08:07.74,Default,,0,0,0,,《Егер қазір күлкің келсе
Dialogue: 0,0:08:04.91,0:08:07.74,Default,,0,0,0,,Психикалық бұзылудан алыс ➡︎
Dialogue: 0,0:08:07.74,0:08:09.75,Default,,0,0,0,,Ол жоғалады! 》
Dialogue: 0,0:08:09.75,0:08:12.75,Default,,0,0,0,,Уау, өте сүйкімді екен, күлгеніме еріксіз
Dialogue: 0,0:08:12.75,0:08:15.08,Default,,0,0,0,,Гитара?
Dialogue: 0,0:08:12.75,0:08:15.08,Default,,0,0,0,,Емделді ~
Dialogue: 0,0:08:15.08,0:08:17.92,Default,,0,0,0,,Эй, Кита-чан... Кита-чан?
Dialogue: 0,0:08:17.92,0:08:21.02,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз. Не?
Dialogue: 0,0:08:24.93,0:08:26.93,Default,,0,0,0,,《Жоқ, түсіндім.
Dialogue: 0,0:08:26.93,0:08:30.23,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:08:26.93,0:08:30.23,Default,,0,0,0,,Іс жақсы болмайды.
Dialogue: 0,0:08:32.77,0:08:37.11,Default,,0,0,0,,《Осында жиналған адамдар
Dialogue: 0,0:08:32.77,0:08:37.11,Default,,0,0,0,,Сіз де мен сияқты жалғыз сезінесіз.
Dialogue: 0,0:08:37.11,0:08:39.11,Default,,0,0,0,,Ол адам отбасынан бөлінуі керек...》
Dialogue: 0,0:08:39.11,0:08:41.28,Default,,0,0,0,,Папа!
Dialogue: 0,0:08:39.11,0:08:41.28,Default,,0,0,0,,《Аа!?》
Dialogue: 0,0:08:41.28,0:08:44.78,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:08:41.28,0:08:44.78,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:08:44.78,0:08:47.78,Default,,0,0,0,,Сіз тамақ ішесіз бе?
Dialogue: 0,0:08:44.78,0:08:47.78,Default,,0,0,0,,《Тамаша отбасылық кездесу!
Dialogue: 0,0:08:47.78,0:08:51.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:47.78,0:08:51.48,Default,,0,0,0,,Мен сияқты екеніңді айт》
Dialogue: 0,0:08:53.39,0:08:57.39,Default,,0,0,0,,《Ааа, тіркелген пайдаланушылар саны 30 000-нан асады.
Dialogue: 0,0:08:57.39,0:09:01.56,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:57.39,0:09:01.56,Default,,0,0,0,,Менің жалғыз орным – интернет
Dialogue: 0,0:09:01.56,0:09:05.40,Default,,0,0,0,,Мен енді мектепке барғым келмейді.
Dialogue: 0,0:09:05.40,0:09:07.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:07.40,0:09:11.41,Default,,0,0,0,,Гитара!
Dialogue: 0,0:09:11.41,0:09:14.41,Default,,0,0,0,,Уф…
Dialogue: 0,0:09:11.41,0:09:14.41,Default,,0,0,0,,Бұл гитара, солай ма? Сіз оны ойнай аласыз ба?
Dialogue: 0,0:09:14.41,0:09:16.58,Default,,0,0,0,,Ааа аа...
Dialogue: 0,0:09:16.58,0:09:18.58,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:09:18.58,0:09:21.25,Default,,0,0,0,,《Сөйлескенімізге тым көп болды.
Dialogue: 0,0:09:18.58,0:09:21.25,Default,,0,0,0,,Дауыс…》
Dialogue: 0,0:09:21.25,0:09:23.25,Default,,0,0,0,,Кешіріңіз кенеттен.
Dialogue: 0,0:09:23.25,0:09:26.59,Default,,0,0,0,,Мен, Койка Иджичи, Шимокитазава орта мектебінде 2 курс
Dialogue: 0,0:09:26.59,0:09:30.26,Default,,0,0,0,,Ах, Хитори Гото
Dialogue: 0,0:09:26.59,0:09:30.26,Default,,0,0,0,,Мен Шука орта мектебінің бірінші курс студентімін.
Dialogue: 0,0:09:30.26,0:09:33.10,Default,,0,0,0,,Айтпақшы, Хитори-чан...
Dialogue: 0,0:09:30.26,0:09:33.10,Default,,0,0,0,,《Кенет атыңды шақырды! 》
Dialogue: 0,0:09:33.10,0:09:35.10,Default,,0,0,0,,Гитара Сіз қанша уақыт ойнай аласыз?
Dialogue: 0,0:09:35.10,0:09:38.27,Default,,0,0,0,,А, бұл туралы.
Dialogue: 0,0:09:35.10,0:09:38.27,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:09:38.27,0:09:41.10,Default,,0,0,0,,Білесіз бе, менде қазір біраз мәселе бар➡︎
Dialogue: 0,0:09:41.10,0:09:43.11,Default,,0,0,0,,Бұл мүмкін емес болса, бәрі жақсы.
Dialogue: 0,0:09:43.11,0:09:45.27,Default,,0,0,0,,Менде бәрі жақсы, бірақ менде қиындық бар...
Dialogue: 0,0:09:45.27,0:09:47.28,Default,,0,0,0,,《Мүлдем проблема жоқ! 》
Dialogue: 0,0:09:47.28,0:09:49.78,Default,,0,0,0,,Иә, батыл айтайық!
Dialogue: 0,0:09:49.78,0:09:52.45,Default,,0,0,0,,Өтінемін! Менің тобыммен➡︎
Dialogue: 0,0:09:52.45,0:09:55.28,Default,,0,0,0,,Тек бүгін
Dialogue: 0,0:09:52.45,0:09:55.28,Default,,0,0,0,,Маған тірек гитара бере аласыз ба?
Dialogue: 0,0:09:55.28,0:09:57.29,Default,,0,0,0,,《Топ? 》
Dialogue: 0,0:09:57.29,0:10:00.96,Default,,0,0,0,,Тікелей эфирге шығуға жақын болса да
Dialogue: 0,0:09:57.29,0:10:00.96,Default,,0,0,0,,Менің гитарашым кенет ойнауды тоқтатты!
Dialogue: 0,0:10:00.96,0:10:03.46,Default,,0,0,0,,Егер сіз белгілі бір дәрежеде ойнай алсаңыз ...
Dialogue: 0,0:10:00.96,0:10:03.46,Default,,0,0,0,,《Бұдан былай!? Тірі!?》
Dialogue: 0,0:10:03.46,0:10:05.46,Default,,0,0,0,,Не?
Dialogue: 0,0:10:05.46,0:10:07.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:07.46,0:10:10.47,Default,,0,0,0,,《Е~! 》
Dialogue: 0,0:10:10.47,0:10:12.97,Default,,0,0,0,,Рахмет! Бірден тірі үйге барыңыз!
Dialogue: 0,0:10:12.97,0:10:14.97,Default,,0,0,0,,《Мен әлі ештеңе айтқан жоқпын! 》
Dialogue: 0,0:10:17.95,0:10:19.96,Default,,0,0,0,,《Келді》
Dialogue: 0,0:10:19.96,0:10:23.29,Default,,0,0,0,,Хитори-чан Шимокитаға жиі келе ме?
Dialogue: 0,0:10:19.96,0:10:23.29,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:10:23.29,0:10:27.30,Default,,0,0,0,,《Осындай даралыққа толы
Dialogue: 0,0:10:23.29,0:10:27.30,Default,,0,0,0,,Сәнді қалаға келуге мүмкіндігім жоқ.
Dialogue: 0,0:10:27.30,0:10:31.30,Default,,0,0,0,,Тұрғын үй дерлік осында
Dialogue: 0,0:10:31.30,0:10:33.64,Default,,0,0,0,,《Ниджика-чан сәнді.
Dialogue: 0,0:10:33.64,0:10:36.14,Default,,0,0,0,,Топ қызы осылай сезінеді.
Dialogue: 0,0:10:36.14,0:10:38.64,Default,,0,0,0,,Онымен салыстырғанда мен тәтті картоппын➡︎
Dialogue: 0,0:10:38.64,0:10:41.14,Default,,0,0,0,,Аюлар таңғажайып, арқалары бүгілген...
Dialogue: 0,0:10:41.14,0:10:43.48,Default,,0,0,0,,А, мен көгерген иіс шығармын?
Dialogue: 0,0:10:43.48,0:10:45.48,Default,,0,0,0,,Өйткені ол әрқашан шкафта...
Dialogue: 0,0:10:45.48,0:10:47.98,Default,,0,0,0,,Жоқ, көбелектің иісі бар.
Dialogue: 0,0:10:47.98,0:10:52.09,Default,,0,0,0,,Шынында да өте сүйкімді екен.
Dialogue: 0,0:10:47.98,0:10:52.09,Default,,0,0,0,,Нижика-чанның иісі өте жақсы
Dialogue: 0,0:10:52.09,0:10:55.26,Default,,0,0,0,,Болуы керек
Dialogue: 0,0:10:52.09,0:10:55.26,Default,,0,0,0,,Бұл мектеп оқушысының иісі》
Dialogue: 0,0:10:55.26,0:10:57.76,Default,,0,0,0,,Сіз жылдам жүресіз бе?
Dialogue: 0,0:10:55.26,0:10:57.76,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:10:57.76,0:11:01.93,Default,,0,0,0,,Бүгін орындалатын жанды үй
Dialogue: 0,0:10:57.76,0:11:01.93,Default,,0,0,0,,Жұлдызды деп аталады...
Dialogue: 0,0:11:01.93,0:11:04.60,Default,,0,0,0,,《Мен өнер көрсететін жанды үй...
Dialogue: 0,0:11:04.60,0:11:06.77,Default,,0,0,0,,Бір нәрсеге ұқсайды
Dialogue: 0,0:11:06.77,0:11:08.94,Default,,0,0,0,,Менің жүрегім қатты ауырады.
Dialogue: 0,0:11:08.94,0:11:11.44,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:11:11.44,0:11:13.54,Default,,0,0,0,,Мен сонда толық емес жұмыс күніммен жұмыс істедім...
Dialogue: 0,0:11:15.61,0:11:18.95,Default,,0,0,0,,Хитори-чан
Dialogue: 0,0:11:15.61,0:11:18.95,Default,,0,0,0,,Сіз шын мәнінде біршама жаттығу жасай аласыз ба?
Dialogue: 0,0:11:18.95,0:11:21.62,Default,,0,0,0,,Жоқ, тек доджбол➡︎
Dialogue: 0,0:11:21.62,0:11:23.79,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:11:21.62,0:11:23.79,Default,,0,0,0,,Мен соңына дейін қалдым
Dialogue: 0,0:11:23.79,0:11:25.79,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:25.79,0:11:28.46,Default,,0,0,0,,《Мен тірі үйде өнер көрсеттім...
Dialogue: 0,0:11:28.46,0:11:31.79,Default,,0,0,0,,А... жоқ, мен өзімді қазір әлсіз сезінемін.
Dialogue: 0,0:11:31.79,0:11:35.46,Default,,0,0,0,,Операция ертеңгі күні таңертең өтеді.
Dialogue: 0,0:11:31.79,0:11:35.46,Default,,0,0,0,,Тікелей эфирде мектеп фестивалі мен күн сайын өз қиялымда жасадым...
Dialogue: 0,0:11:35.46,0:11:39.80,Default,,0,0,0,,Ал бірінші адам
Dialogue: 0,0:11:35.46,0:11:39.80,Default,,0,0,0,,ZEPP Super Arena! 》
Dialogue: 0,0:11:39.80,0:11:43.47,Default,,0,0,0,,((Аудитория: Жалғыз! Жалғыз!
Dialogue: 0,0:11:39.80,0:11:43.47,Default,,0,0,0,,Жалғыз! ))
Dialogue: 0,0:11:43.47,0:11:47.14,Default,,0,0,0,,Мен Будоканды жерлеген әйелмін...
Dialogue: 0,0:11:43.47,0:11:47.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.14,0:11:49.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:47.14,0:11:49.81,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:11:49.81,0:11:53.25,Default,,0,0,0,,《Мен қате адамнан сұрадым.
Dialogue: 0,0:11:49.81,0:11:53.25,Default,,0,0,0,,Сіз олай ойламайсыз деп үміттенемін...》
Dialogue: 0,0:11:53.25,0:11:55.58,Default,,0,0,0,,《Мен қате адамнан сұрадым ба? 》
Dialogue: 0,0:11:55.58,0:12:00.09,Default,,0,0,0,,келді! Міне~
Dialogue: 0,0:12:00.09,0:12:02.93,Default,,0,0,0,,《Мақай? 》
Dialogue: 0,0:12:02.93,0:12:05.43,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:12:07.93,0:12:13.77,Default,,0,0,0,,《Алғашқы өмір сүретін үй Бұл қараңғылық пен қысымшылық сезім...
Dialogue: 0,0:12:13.77,0:12:15.77,Default,,0,0,0,,О, сабыр ет~》
Dialogue: 0,0:12:15.77,0:12:17.77,Default,,0,0,0,,Хитори-чан жақсы ма?
Dialogue: 0,0:12:17.77,0:12:19.78,Default,,0,0,0,,Менің үйім...
Dialogue: 0,0:12:17.77,0:12:19.78,Default,,0,0,0,,Жоқ!?
Dialogue: 0,0:12:19.78,0:12:22.11,Default,,0,0,0,,Бұл мен бүгін бірге өнер көрсететін топ.
Dialogue: 0,0:12:22.11,0:12:24.78,Default,,0,0,0,,《Топ сөзсіз.
Dialogue: 0,0:12:22.11,0:12:24.78,Default,,0,0,0,,Қорқынышты бейне бар➡︎
Dialogue: 0,0:12:24.78,0:12:26.78,Default,,0,0,0,,Өйткені, бұл үнділердің жиналысы.
Dialogue: 0,0:12:26.78,0:12:30.12,Default,,0,0,0,,Көлеңке адамдары Көлеңкелер тобы!
Dialogue: 0,0:12:26.78,0:12:30.12,Default,,0,0,0,,Барлығы мен сияқты...》
Dialogue: 0,0:12:30.12,0:12:32.62,Default,,0,0,0,,Ондағы адам ПА.
Dialogue: 0,0:12:32.62,0:12:34.62,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:34.62,0:12:37.46,Default,,0,0,0,,Сізді ашуландырғаным үшін кешіріңіз.
Dialogue: 0,0:12:34.62,0:12:37.46,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:12:37.46,0:12:40.46,Default,,0,0,0,,Мен ақырында оралдым
Dialogue: 0,0:12:37.46,0:12:40.46,Default,,0,0,0,,Уа Рау!
Dialogue: 0,0:12:40.46,0:12:43.13,Default,,0,0,0,,Бұл бала Гото Хитори-чан
Dialogue: 0,0:12:43.13,0:12:47.14,Default,,0,0,0,,Саябақта керемет түрде гитарист болды.
Dialogue: 0,0:12:43.13,0:12:47.14,Default,,0,0,0,,Я~
Dialogue: 0,0:12:47.14,0:12:49.47,Default,,0,0,0,,《Қорқасың ба? Маған қарап тұрсың ба? 》
Dialogue: 0,0:12:49.47,0:12:51.91,Default,,0,0,0,,Бұл бала базалық Рио Ямада.
Dialogue: 0,0:12:51.91,0:12:54.74,Default,,0,0,0,,Бұл Гото Хитори.
Dialogue: 0,0:12:51.91,0:12:54.74,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:12:54.74,0:12:57.41,Default,,0,0,0,,Е, эй... жарайды.
Dialogue: 0,0:12:57.41,0:12:59.42,Default,,0,0,0,,Райо өз ойын жеткізуде қиналады.
Dialogue: 0,0:12:59.42,0:13:01.58,Default,,0,0,0,,Мені оғаш десең, мен бақыттымын.
Dialogue: 0,0:13:01.58,0:13:04.25,Default,,0,0,0,,Мен бақытты емеспін
Dialogue: 0,0:13:01.58,0:13:04.25,Default,,0,0,0,,《Бақытты көрінеді》
Dialogue: 0,0:13:04.25,0:13:06.42,Default,,0,0,0,,Енді ойлап қарасам, дүкен меңгерушісі...
Dialogue: 0,0:13:04.25,0:13:06.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.42,0:13:08.76,Default,,0,0,0,,Уақыттың соңына дейін жаттығу
Dialogue: 0,0:13:08.76,0:13:11.59,Default,,0,0,0,,Сондай-ақ, Нижика мұны өз бетімен жасады.
Dialogue: 0,0:13:08.76,0:13:11.59,Default,,0,0,0,,Тірі үйден шығу➡︎
Dialogue: 0,0:13:11.59,0:13:14.43,Default,,0,0,0,,Мен ашуланып дүкен аралауға шықтым.
Dialogue: 0,0:13:11.59,0:13:14.43,Default,,0,0,0,,Сәлем! Солай!?
Dialogue: 0,0:13:14.43,0:13:16.60,Default,,0,0,0,,Қайтпас бұрын студияға барайық!
Dialogue: 0,0:13:16.60,0:13:19.94,Default,,0,0,0,,Хитори-чанға да қара!
Dialogue: 0,0:13:19.94,0:13:21.94,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:13:21.94,0:13:24.11,Default,,0,0,0,,《Шындық қорқынышты...
Dialogue: 0,0:13:24.11,0:13:29.45,Default,,0,0,0,,Бірақ қызық нәрсе болғалы тұр.
Dialogue: 0,0:13:24.11,0:13:29.45,Default,,0,0,0,,Мен көп күткен сияқтымын》
Dialogue: 0,0:13:29.45,0:13:33.12,Default,,0,0,0,,Бұл бүгінгі жиынтық тізім және ұпай
Dialogue: 0,0:13:33.12,0:13:35.62,Default,,0,0,0,,Әй, бұл топ мүшесі...
Dialogue: 0,0:13:35.62,0:13:37.62,Default,,0,0,0,,Барлығы солай!
Dialogue: 0,0:13:37.62,0:13:40.29,Default,,0,0,0,,Біз бұл жолы жылдам топпыз!
Dialogue: 0,0:13:40.29,0:13:43.29,Default,,0,0,0,,《Иә, мен бұл әнді орындай аламын.
Dialogue: 0,0:13:43.29,0:13:46.80,Default,,0,0,0,,Бірақ вокал жоқ.
Dialogue: 0,0:13:43.29,0:13:46.80,Default,,0,0,0,,Мен ойнауға бар күшімді салуым керек...
Dialogue: 0,0:13:46.80,0:13:50.73,Default,,0,0,0,,Мен гитарада жақсы ойнайтын сияқтымын, сондықтан мен оны істей аламын.
Dialogue: 0,0:13:46.80,0:13:50.73,Default,,0,0,0,,Сіз мұны істей аласыз! 》
Dialogue: 0,0:13:50.73,0:13:53.07,Default,,0,0,0,,Хун хун хун хун хун хун...
Dialogue: 0,0:13:53.07,0:13:55.07,Default,,0,0,0,,Горилла?
Dialogue: 0,0:13:57.07,0:14:00.08,Default,,0,0,0,,《Қойылымды тыңдасаң, екеуің де таң қалуларың мүмкін.
Dialogue: 0,0:14:00.08,0:14:04.75,Default,,0,0,0,,Интернетте бұл өте оңай болғандықтан...
Dialogue: 0,0:14:00.08,0:14:04.75,Default,,0,0,0,,Жоқ, салыстырмалы түрде жақсы беделге ие.
Dialogue: 0,0:14:04.75,0:14:07.42,Default,,0,0,0,,30 000 тіркелген пайдаланушылар бар.
Dialogue: 0,0:14:07.42,0:14:09.75,Default,,0,0,0,,Жарайды, мен істеймін! 》
Dialogue: 0,0:14:09.75,0:14:13.76,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:09.75,0:14:13.76,Default,,0,0,0,,(барабан таяқшаларының саны)
Dialogue: 0,0:14:13.76,0:14:19.96,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:14:26.60,0:14:28.94,Default,,0,0,0,,Мен бұған жақсы емеспін.
Dialogue: 0,0:14:26.60,0:14:28.94,Default,,0,0,0,,А!?
Dialogue: 0,0:14:28.94,0:14:32.44,Default,,0,0,0,,《Не не үшін!?
Dialogue: 0,0:14:28.94,0:14:32.44,Default,,0,0,0,,Мен гитара кейіпкері болсам да!?
Dialogue: 0,0:14:32.44,0:14:34.61,Default,,0,0,0,,30 000 тіркелген пайдаланушы болса да!?》
Dialogue: 0,0:14:34.61,0:14:36.61,Default,,0,0,0,,Түсіндірейін!
Dialogue: 0,0:14:34.61,0:14:36.61,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:14:36.61,0:14:39.28,Default,,0,0,0,,Топ нағыз адам
Dialogue: 0,0:14:36.61,0:14:39.28,Default,,0,0,0,,Тыныс алуды үйлестіру➡︎
Dialogue: 0,0:14:39.28,0:14:42.12,Default,,0,0,0,,Өте маңызды
Dialogue: 0,0:14:39.28,0:14:42.12,Default,,0,0,0,,Комми синдромы бар бір адам ➡︎
Dialogue: 0,0:14:42.12,0:14:45.79,Default,,0,0,0,,Өйткені мен сенің көзіңе де қарай алмаймын
Dialogue: 0,0:14:42.12,0:14:45.79,Default,,0,0,0,,Толтыратын спектакль көрсетіңіз!
Dialogue: 0,0:14:45.79,0:14:47.79,Default,,0,0,0,,Тіпті ең жақсы жеке ойыншы болсаңыз да➡︎
Dialogue: 0,0:14:47.79,0:14:49.79,Default,,0,0,0,,Топтарға келетін болсақ
Dialogue: 0,0:14:47.79,0:14:49.79,Default,,0,0,0,,Мидинкодан төмен
Dialogue: 0,0:14:49.79,0:14:51.73,Default,,0,0,0,,Ең әлсіз бол!
Dialogue: 0,0:14:51.73,0:14:54.23,Default,,0,0,0,,Сәлеметсіз бе, бұл Планктон Гото.
Dialogue: 0,0:14:54.23,0:14:56.90,Default,,0,0,0,,Біреу сәтсіз комедияға ұқсайды
Dialogue: 0,0:14:54.23,0:14:56.90,Default,,0,0,0,,шықты!
Dialogue: 0,0:14:56.90,0:14:59.40,Default,,0,0,0,,《Осылайша
Dialogue: 0,0:14:56.90,0:14:59.40,Default,,0,0,0,,Гото Хитори күлге айналады➡︎
Dialogue: 0,0:14:59.40,0:15:02.70,Default,,0,0,0,,Мен енді ешқашан гитара алмаймын
Dialogue: 0,0:14:59.40,0:15:02.70,Default,,0,0,0,,Жоқ...》
Dialogue: 0,0:15:09.08,0:15:11.08,Default,,0,0,0,,Миди... Чо Чо Чо Чо!
Dialogue: 0,0:15:11.08,0:15:14.25,Default,,0,0,0,,Эй, шық!
Dialogue: 0,0:15:11.08,0:15:14.25,Default,,0,0,0,,Нақты спектакль басталғалы жатыр!
Dialogue: 0,0:15:14.25,0:15:16.25,Default,,0,0,0,,Я я я Күткендей, мен мұны істей алмаймын!
Dialogue: 0,0:15:16.25,0:15:18.92,Default,,0,0,0,,Мен ештеңе істей алмаймын, бұл импровизацияланған топ.
Dialogue: 0,0:15:18.92,0:15:21.09,Default,,0,0,0,,Мен де онша жақсы емеспін!
Dialogue: 0,0:15:21.09,0:15:24.09,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:15:21.09,0:15:24.09,Default,,0,0,0,,Хе хе хе хе хе...
Dialogue: 0,0:15:24.09,0:15:27.60,Default,,0,0,0,,Әзірге осы жағын қараңыз.
Dialogue: 0,0:15:24.09,0:15:27.60,Default,,0,0,0,,Шындықтан қашпа!
Dialogue: 0,0:15:27.60,0:15:32.60,Default,,0,0,0,,Ах, тіпті MC
Dialogue: 0,0:15:27.60,0:15:32.60,Default,,0,0,0,,Бұл мүлдем пайдалы емес.
Dialogue: 0,0:15:32.60,0:15:36.27,Default,,0,0,0,,Ахахха Өміріммен
Dialogue: 0,0:15:32.60,0:15:36.27,Default,,0,0,0,,Тіпті галактикалық түсірілімде де...
Dialogue: 0,0:15:36.27,0:15:39.28,Default,,0,0,0,,Топтың атын есте сақтаңыз.
Dialogue: 0,0:15:36.27,0:15:39.28,Default,,0,0,0,,Үйге бара алуыңыз керек...
Dialogue: 0,0:15:39.28,0:15:41.78,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:39.28,0:15:41.78,Default,,0,0,0,,Тым тас!
Dialogue: 0,0:15:41.78,0:15:46.78,Default,,0,0,0,,Жарайды. Бір адам ренжісе
Dialogue: 0,0:15:41.78,0:15:46.78,Default,,0,0,0,,Мен оны негізге түсіремін.
Dialogue: 0,0:15:46.78,0:15:50.55,Default,,0,0,0,,Негіз
Dialogue: 0,0:15:46.78,0:15:50.55,Default,,0,0,0,,Бұл керемет естіледі ме?
Dialogue: 0,0:15:50.55,0:15:53.39,Default,,0,0,0,,Қан төгу де тас.
Dialogue: 0,0:15:50.55,0:15:53.39,Default,,0,0,0,,Өйткені бұл құлып
Dialogue: 0,0:15:53.39,0:15:55.56,Default,,0,0,0,,Құлыптау тым көп!
Dialogue: 0,0:15:55.56,0:15:59.90,Default,,0,0,0,,Ал сен менің тобымды көруге келесің.
Dialogue: 0,0:15:55.56,0:15:59.90,Default,,0,0,0,,Мүмкін бұл менің достарым шығар.
Dialogue: 0,0:15:59.90,0:16:03.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.90,0:16:03.40,Default,,0,0,0,,Менің жалғыз досым - Ниджик.
Dialogue: 0,0:16:03.40,0:16:06.07,Default,,0,0,0,,Қарапайым орта мектеп оқушысына
Dialogue: 0,0:16:03.40,0:16:06.07,Default,,0,0,0,,Жақсы өнімділік және аяқтар➡︎
Dialogue: 0,0:16:06.07,0:16:09.91,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:16:06.07,0:16:09.91,Default,,0,0,0,,《Шабыс тудыруы мүмкін ескертулер》
Dialogue: 0,0:16:09.91,0:16:12.58,Default,,0,0,0,,Сәлем! Сондықтан уайымдамаңыз!
Dialogue: 0,0:16:12.58,0:16:14.74,Default,,0,0,0,,Бұлай деп айтылса да
Dialogue: 0,0:16:14.74,0:16:17.75,Default,,0,0,0,,Мен түсіндім, бірақ
Dialogue: 0,0:16:14.74,0:16:17.75,Default,,0,0,0,,Өйткені Рау қалыпты емес.
Dialogue: 0,0:16:17.75,0:16:21.42,Default,,0,0,0,,Е... Эхехехе
Dialogue: 0,0:16:17.75,0:16:21.42,Default,,0,0,0,,Жоқ, қуанба, қуанба.
Dialogue: 0,0:16:21.42,0:16:23.59,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:23.59,0:16:27.09,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:16:23.59,0:16:27.09,Default,,0,0,0,,Оны мәжбүрлемеңіз
Dialogue: 0,0:16:27.09,0:16:30.59,Default,,0,0,0,,Дұрыс, мұндай орынсыз өтініш сұрағаным үшін кешірім сұраймын.
Dialogue: 0,0:16:30.59,0:16:32.76,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:16:32.76,0:16:37.27,Default,,0,0,0,,Аа, мен шынымен бақытты болдым.
Dialogue: 0,0:16:32.76,0:16:37.27,Default,,0,0,0,,Шақыру
Dialogue: 0,0:16:37.27,0:16:40.44,Default,,0,0,0,,Топ мәңгілік
Dialogue: 0,0:16:37.27,0:16:40.44,Default,,0,0,0,,Мен оны жинағым келгендіктен...
Dialogue: 0,0:16:40.44,0:16:43.44,Default,,0,0,0,,Бірақ біз мүшелерді жинай алмадық.
Dialogue: 0,0:16:43.44,0:16:45.94,Default,,0,0,0,,Әдетте
Dialogue: 0,0:16:43.44,0:16:45.94,Default,,0,0,0,,Интернетте жарияланған кавер әндер...
Dialogue: 0,0:16:45.94,0:16:47.94,Default,,0,0,0,,Сіз әдетте не ойнайсыз?
Dialogue: 0,0:16:47.94,0:16:51.05,Default,,0,0,0,,A. Ол құрылған кезде.
Dialogue: 0,0:16:47.94,0:16:51.05,Default,,0,0,0,,Дереу жауап беруге дайын болыңыз➡︎
Dialogue: 0,0:16:51.05,0:16:54.05,Default,,0,0,0,,Соңғы жылдары ең көп сатылған топ әндері қандай?
Dialogue: 0,0:16:51.05,0:16:54.05,Default,,0,0,0,,туралы...
Dialogue: 0,0:16:54.05,0:16:56.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:54.05,0:16:56.39,Default,,0,0,0,,Жоқ, мүлде емес
Dialogue: 0,0:16:56.39,0:16:58.89,Default,,0,0,0,,Соңында былай шықты...
Dialogue: 0,0:16:58.89,0:17:02.56,Default,,0,0,0,,Өйткені, мен үшін
Dialogue: 0,0:16:58.89,0:17:02.56,Default,,0,0,0,,Біреумен топ құру...
Dialogue: 0,0:17:02.56,0:17:05.23,Default,,0,0,0,,Тек ең көп сатылатын мұқабалар...
Dialogue: 0,0:17:05.23,0:17:08.40,Default,,0,0,0,,Ол гитара кейіпкеріне ұқсайды.
Dialogue: 0,0:17:05.23,0:17:08.40,Default,,0,0,0,,білесің бе?
Dialogue: 0,0:17:08.40,0:17:10.90,Default,,0,0,0,,《Гитара батыры...
Dialogue: 0,0:17:10.90,0:17:12.90,Default,,0,0,0,,А, мен!?》
Dialogue: 0,0:17:12.90,0:17:15.24,Default,,0,0,0,,Егер сіз білмесеңіз, мен сізге URL мекенжайын кейінірек жіберемін.
Dialogue: 0,0:17:15.24,0:17:17.74,Default,,0,0,0,,Өйткені бұл өте жақсы
Dialogue: 0,0:17:15.24,0:17:17.74,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:17:17.74,0:17:19.74,Default,,0,0,0,,《Ең жоғары… Ең жоғары…》
Dialogue: 0,0:17:19.74,0:17:22.58,Default,,0,0,0,,Мен де ұсынамын
Dialogue: 0,0:17:19.74,0:17:22.58,Default,,0,0,0,,Өйткені ол ➡︎ көтеріле береді
Dialogue: 0,0:17:22.58,0:17:24.91,Default,,0,0,0,,Мен оны бұрын көргенмін.
Dialogue: 0,0:17:22.58,0:17:24.91,Default,,0,0,0,,Бұл өте жақсы болды
Dialogue: 0,0:17:24.91,0:17:27.75,Default,,0,0,0,,Эй!?
Dialogue: 0,0:17:24.91,0:17:27.75,Default,,0,0,0,,Атау сезімі аздап ауырады
Dialogue: 0,0:17:27.75,0:17:29.75,Default,,0,0,0,,《Ауырып жатыр ма!?》
Dialogue: 0,0:17:29.75,0:17:33.26,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:17:29.75,0:17:33.26,Default,,0,0,0,,Менде де жаңа хабарландырулар қосылды!
Dialogue: 0,0:17:33.26,0:17:35.59,Default,,0,0,0,,Мен бір күні бірге ойнағым келеді~
Dialogue: 0,0:17:35.59,0:17:37.59,Default,,0,0,0,,《Мен мұны жасадым》
Dialogue: 0,0:17:37.59,0:17:40.93,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:37.59,0:17:40.93,Default,,0,0,0,,Менің айтқым келгені➡︎
Dialogue: 0,0:17:40.93,0:17:42.93,Default,,0,0,0,,Кейбір адамдар жақсы және танымал➡︎
Dialogue: 0,0:17:42.93,0:17:46.27,Default,,0,0,0,,Біз оны көрмеген кезде
Dialogue: 0,0:17:42.93,0:17:46.27,Default,,0,0,0,,Көп көп ➡︎
Dialogue: 0,0:17:46.27,0:17:48.60,Default,,0,0,0,,Мен сені гитарада ойнап жүр деп ойладым.
Dialogue: 0,0:17:48.60,0:17:50.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.60,0:17:50.71,Default,,0,0,0,,Оны кейінірек тексеріңіз!
Dialogue: 0,0:17:50.71,0:17:52.71,Default,,0,0,0,,Бейнені көргенде түсінесіз!
Dialogue: 0,0:17:54.71,0:17:56.71,Default,,0,0,0,,《Нақты әлемдегі адамдар➡︎
Dialogue: 0,0:17:56.71,0:18:00.41,Default,,0,0,0,,Мені ешкім ойламайды
Dialogue: 0,0:17:56.71,0:18:00.41,Default,,0,0,0,,Мен сізді қызықтырмайды деп ойладым》
Dialogue: 0,0:18:02.38,0:18:05.55,Default,,0,0,0,,Бүгінгі күн жақсы болмағандықтан
Dialogue: 0,0:18:02.38,0:18:05.55,Default,,0,0,0,,Өз тобыңнан бас тартуға әлі ерте!
Dialogue: 0,0:18:05.55,0:18:09.06,Default,,0,0,0,,Мүмкін біз жындымыз.
Dialogue: 0,0:18:05.55,0:18:09.06,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:18:09.06,0:18:11.06,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:18:11.06,0:18:14.73,Default,,0,0,0,,《Бірақ сондай мейірімді адам
Dialogue: 0,0:18:11.06,0:18:14.73,Default,,0,0,0,,Мені үнемі бақылағаныңыз үшін рахмет➡︎
Dialogue: 0,0:18:14.73,0:18:16.73,Default,,0,0,0,,Біреу мені шақырды》
Dialogue: 0,0:18:16.73,0:18:18.73,Default,,0,0,0,,А, мен тұрдым.
Dialogue: 0,0:18:18.73,0:18:22.24,Default,,0,0,0,,《Мұндай керемет
Dialogue: 0,0:18:18.73,0:18:22.24,Default,,0,0,0,,Бұл ешқашан болмайтын шығар
Dialogue: 0,0:18:22.24,0:18:25.07,Default,,0,0,0,,Оның босқа кетуіне жол берме! 》
Dialogue: 0,0:18:25.07,0:18:27.74,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:18:27.74,0:18:31.58,Default,,0,0,0,,Жер
Dialogue: 0,0:18:27.74,0:18:31.58,Default,,0,0,0,,Келгіңіз келді ме?
Dialogue: 0,0:18:31.58,0:18:34.25,Default,,0,0,0,,♬~
Dialogue: 0,0:18:31.58,0:18:34.25,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:18:34.25,0:18:37.75,Default,,0,0,0,,《Мен мұны өз басымнан білемін.
Dialogue: 0,0:18:34.25,0:18:37.75,Default,,0,0,0,,Бірақ бәрібір қорқынышты
Dialogue: 0,0:18:37.75,0:18:40.26,Default,,0,0,0,,Тұтынушының көзқарасы
Dialogue: 0,0:18:37.75,0:18:40.26,Default,,0,0,0,,Оған шыдай алмаймын...》
Dialogue: 0,0:18:40.26,0:18:44.26,Default,,0,0,0,,Егер сіз қорқатын болсаңыз
Dialogue: 0,0:18:40.26,0:18:44.26,Default,,0,0,0,,Осыны енгізіп ойнасам ше?
Dialogue: 0,0:18:44.26,0:18:48.43,Default,,0,0,0,,Иә Мен әдетте ойнайтын орта
Dialogue: 0,0:18:44.26,0:18:48.43,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:18:48.43,0:18:51.03,Default,,0,0,0,,Сіз қайда тұрасыз?
Dialogue: 0,0:18:51.03,0:18:54.37,Default,,0,0,0,,Барлығыңызға сәлем!
Dialogue: 0,0:18:51.03,0:18:54.37,Default,,0,0,0,,Шимокитаны жандандырайық!
Dialogue: 0,0:18:54.37,0:18:56.37,Default,,0,0,0,,Мен біраз қобалжыдым.
Dialogue: 0,0:18:56.37,0:18:59.21,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:18:56.37,0:18:59.21,Default,,0,0,0,,Оны тікелей орындауда қалай енгізуім керек?
Dialogue: 0,0:18:59.21,0:19:01.88,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:18:59.21,0:19:01.88,Default,,0,0,0,,Мен сіздің шын атыңызды қолдана аламын ба?
Dialogue: 0,0:19:01.88,0:19:05.55,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:19:01.88,0:19:05.55,Default,,0,0,0,,Сонда лақап атыңыз жоқ па?
Dialogue: 0,0:19:05.55,0:19:08.88,Default,,0,0,0,,Шу Кіші орта мектепте
Dialogue: 0,0:19:05.55,0:19:08.88,Default,,0,0,0,,«Мм...» немесе «Сәлем»
Dialogue: 0,0:19:08.88,0:19:12.39,Default,,0,0,0,,Бұл лақап ат емес пе?
Dialogue: 0,0:19:08.88,0:19:12.39,Default,,0,0,0,,А-а, бір-бірімізді лақап атпен атайтынымыз сонша➡︎
Dialogue: 0,0:19:12.39,0:19:14.72,Default,,0,0,0,,Сізде жақын достық болды ма?
Dialogue: 0,0:19:14.72,0:19:18.89,Default,,0,0,0,,Жалғыз, жалғыз...
Dialogue: 0,0:19:14.72,0:19:18.89,Default,,0,0,0,,Бокчи-чан ше?
Dialogue: 0,0:19:18.89,0:19:21.06,Default,,0,0,0,,Уа, тағы бір нәзік жер.
Dialogue: 0,0:19:21.06,0:19:23.23,Default,,0,0,0,,Мен bobo bobo bocchiмін!
Dialogue: 0,0:19:23.23,0:19:25.90,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:19:23.23,0:19:25.90,Default,,0,0,0,,Бұл лақап атты бірінші рет қолдануым.
Dialogue: 0,0:19:25.90,0:19:28.24,Default,,0,0,0,,Уф, мен жылағым келеді.
Dialogue: 0,0:19:28.24,0:19:30.57,Default,,0,0,0,,А, топтың аты әлі
Dialogue: 0,0:19:28.24,0:19:30.57,Default,,0,0,0,,Мен тыңдамадым.
Dialogue: 0,0:19:30.57,0:19:32.91,Default,,0,0,0,,Уф
Dialogue: 0,0:19:30.57,0:19:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.91,0:19:36.25,Default,,0,0,0,,Бұл байланыстырушы жолақ.
Dialogue: 0,0:19:32.91,0:19:36.25,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:19:36.25,0:19:38.75,Default,,0,0,0,,Байланыстыру жолағы…
Dialogue: 0,0:19:38.75,0:19:40.75,Default,,0,0,0,,Байланыс жолағы?
Dialogue: 0,0:19:40.75,0:19:42.75,Default,,0,0,0,,Шедевр!
Dialogue: 0,0:19:42.75,0:19:44.75,Default,,0,0,0,,Күн суық, мен оны міндетті түрде ауыстырамын!
Dialogue: 0,0:19:44.75,0:19:46.76,Default,,0,0,0,,А, аа!
Dialogue: 0,0:19:44.75,0:19:46.76,Default,,0,0,0,,Неліктен? Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:19:46.76,0:19:48.76,Default,,0,0,0,,Иә
Dialogue: 0,0:19:46.76,0:19:48.76,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:48.76,0:19:51.59,Default,,0,0,0,,Топтың аты кейінірек келеді!
Dialogue: 0,0:19:48.76,0:19:51.59,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:19:51.59,0:19:54.43,Default,,0,0,0,,Ааа~
Dialogue: 0,0:19:51.59,0:19:54.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:54.43,0:19:58.27,Default,,0,0,0,,Егер сіз оны жақсы білмесеңіз де
Dialogue: 0,0:19:54.43,0:19:58.27,Default,,0,0,0,,Ойнап көңіл көтеруге тырысыңыз!
Dialogue: 0,0:19:58.27,0:20:01.27,Default,,0,0,0,,Дауысы керемет
Dialogue: 0,0:19:58.27,0:20:01.27,Default,,0,0,0,,Эмоциялар оңай айтылады
Dialogue: 0,0:20:01.27,0:20:03.61,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:20:03.61,0:20:06.78,Default,,0,0,0,,Технологияға ұмтылу
Dialogue: 0,0:20:03.61,0:20:06.78,Default,,0,0,0,,Келесі жолы өте жақсы!
Dialogue: 0,0:20:06.78,0:20:09.45,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.78,0:20:09.45,Default,,0,0,0,,《Келесі...》
Dialogue: 0,0:20:09.45,0:20:12.45,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:20:09.45,0:20:12.45,Default,,0,0,0,,Иә
Dialogue: 0,0:20:12.45,0:20:16.05,Default,,0,0,0,,《Мен... келесі жолы қарсы емеспін.》
Dialogue: 0,0:20:18.95,0:20:21.96,Default,,0,0,0,,Танысқаныма қуаныштымын! Бұл бірлік тобы!
Dialogue: 0,0:20:21.96,0:20:23.96,Default,,0,0,0,,Бүгін де бәрі
Dialogue: 0,0:20:21.96,0:20:23.96,Default,,0,0,0,,Сіз білетін әндер➡︎
Dialogue: 0,0:20:23.96,0:20:26.30,Default,,0,0,0,,Мен бірнеше ән ойнаймын, сондықтан оларды тыңдаңыз!
Dialogue: 0,0:20:26.30,0:20:28.30,Default,,0,0,0,,Иә? Бұл
Dialogue: 0,0:20:30.47,0:20:37.47,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:20:37.47,0:20:41.48,Default,,0,0,0,,《Кәдімгі қабілетімді көрсете алмадым.
Dialogue: 0,0:20:37.47,0:20:41.48,Default,,0,0,0,,Бұл ең нашар, бірақ...
Dialogue: 0,0:20:41.48,0:20:48.15,Default,,0,0,0,,Топ құрып, біреумен ойнау
Dialogue: 0,0:20:41.48,0:20:48.15,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:20:48.15,0:20:52.09,Default,,0,0,0,,Мен бүгін жарқырап тұрмын...
Dialogue: 0,0:20:52.09,0:20:56.79,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:20:52.09,0:20:56.79,Default,,0,0,0,,Шындығында, бұл менің өмірімдегі ең бақытсыз нәрсе болуы мүмкін! 》
Dialogue: 0,0:21:00.76,0:21:04.10,Default,,0,0,0,,Мен көп қателік жібердім!
Dialogue: 0,0:21:00.76,0:21:04.10,Default,,0,0,0,,MC сырғып кетті.
Dialogue: 0,0:21:04.10,0:21:06.10,Default,,0,0,0,,Эхе
Dialogue: 0,0:21:04.10,0:21:06.10,Default,,0,0,0,,Эй!! Сіздер қалайсыздар? Енді бәрі жақсы!!
Dialogue: 0,0:21:06.10,0:21:08.10,Default,,0,0,0,,Цуцу…
Dialogue: 0,0:21:06.10,0:21:08.10,Default,,0,0,0,,Не?
Dialogue: 0,0:21:08.10,0:21:12.11,Default,,0,0,0,,Цу цу цуцу…
Dialogue: 0,0:21:08.10,0:21:12.11,Default,,0,0,0,,Қандай қорқынышты!
Dialogue: 0,0:21:12.11,0:21:15.44,Default,,0,0,0,,Келесі тікелей эфирге дейін
Dialogue: 0,0:21:12.11,0:21:15.44,Default,,0,0,0,,Сыныптасыңа➡︎ сәлем бере алғанша
Dialogue: 0,0:21:15.44,0:21:18.11,Default,,0,0,0,,Бұл болады!
Dialogue: 0,0:21:15.44,0:21:18.11,Default,,0,0,0,,Қандай декларация?
Dialogue: 0,0:21:18.11,0:21:20.12,Default,,0,0,0,,Керемет өсу
Dialogue: 0,0:21:20.12,0:21:23.62,Default,,0,0,0,,Бірақ мен түсінемін!
Dialogue: 0,0:21:20.12,0:21:23.62,Default,,0,0,0,,Жарайды, қазір бастайық➡︎
Dialogue: 0,0:21:23.62,0:21:26.46,Default,,0,0,0,,Бокчи-чан сәлемдесу кеші және
Dialogue: 0,0:21:23.62,0:21:26.46,Default,,0,0,0,,Тікелей шолу сессиясы!
Dialogue: 0,0:21:26.46,0:21:29.96,Default,,0,0,0,,А, мен бүгін тым көп адаммен сөйлестім.
Dialogue: 0,0:21:26.46,0:21:29.96,Default,,0,0,0,,Мен шаршадым, үйге бара жатырмын
Dialogue: 0,0:21:29.96,0:21:31.96,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:21:29.96,0:21:31.96,Default,,0,0,0,,Кешіріңіз, мен ұйықтап жатырмын.
Dialogue: 0,0:21:31.96,0:21:33.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.96,0:21:33.96,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:33.96,0:21:35.96,Default,,0,0,0,,Ә!?
Dialogue: 0,0:21:38.80,0:21:41.00,Default,,0,0,0,,Ұйымшылдық Мүлде жоқ!
Dialogue: 0,0:21:49.31,0:21:51.25,Default,,0,0,0,,《Комми синдромын міндетті түрде түзетіңіз➡︎
Dialogue: 0,0:21:51.25,0:21:56.08,Default,,0,0,0,,Менің гитара кейіпкері ретіндегі күшім
Dialogue: 0,0:21:51.25,0:21:56.08,Default,,0,0,0,,Көрсету
Dialogue: 0,0:21:56.08,0:21:59.25,Default,,0,0,0,,Ниджика-чан Рю-сан...
Dialogue: 0,0:21:59.25,0:22:01.92,Default,,0,0,0,,Бірлік тобы үшін! 》
Dialogue: 0,0:22:01.92,0:22:03.92,Default,,0,0,0,,Су... Кешіріңіз, кешіріңіз!
Dialogue: 0,0:22:05.42,0:22:11.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
