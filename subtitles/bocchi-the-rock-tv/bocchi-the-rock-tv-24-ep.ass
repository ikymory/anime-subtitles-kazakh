Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.73,0:00:35.32,Default,,0,0,0,,♪ Мұның бәрі ауа райына байланысты.
Dialogue: 0,0:00:35.40,0:00:37.95,Default,,0,0,0,,♪ Бұл ыңғайсыздық пен шаршау
Dialogue: 0,0:00:38.03,0:00:42.16,Default,,0,0,0,,♪ Күн жасырын, бірақ белгісіз
Dialogue: 0,0:00:42.95,0:00:45.70,Default,,0,0,0,,♪ Толып жатқан пойыз дірілдеп тұр
Dialogue: 0,0:00:45.79,0:00:48.25,Default,,0,0,0,,♪ Бір-бірінен өтіп бара жатқан пойыз жартылай жүріс пойыз.
Dialogue: 0,0:00:48.33,0:00:53.42,Default,,0,0,0,,♪ Контурсыз бұлттың өрнегін іздеңіз
Dialogue: 0,0:00:53.50,0:00:56.22,Default,,0,0,0,,♪ «Автордың сезіміне жауап беріңіз».
Dialogue: 0,0:00:56.30,0:00:58.80,Default,,0,0,0,,♪ Дұрыс жауап қайсы? ‬
Dialogue: 0,0:00:59.39,0:01:03.81,Default,,0,0,0,,♪ Алдын ала белгіленген үйлесімділік сценарийінен шығу
Dialogue: 0,0:01:03.89,0:01:09.10,Default,,0,0,0,,♪ Қандай көгілдір бұлақ
Dialogue: 0,0:01:09.19,0:01:14.23,Default,,0,0,0,,♪ Бұл маған сәйкес келмейді
Dialogue: 0,0:01:14.32,0:01:19.61,Default,,0,0,0,,♪ Сонда да мен бұл сәттің бір-ақ рет болатынын білемін
Dialogue: 0,0:01:19.70,0:01:24.79,Default,,0,0,0,,♪ Құрамында өтпелілік бар
Dialogue: 0,0:01:24.87,0:01:27.54,Default,,0,0,0,,♪ Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:01:27.62,0:01:30.29,Default,,0,0,0,,♪ Бір күні өлгенше қанша рет болса да
Dialogue: 0,0:01:30.37,0:01:35.30,Default,,0,0,0,,♪ Осындай жағдай болса да, күлме.
Dialogue: 0,0:01:45.72,0:01:50.98,Default,,0,0,0,,♪ Мені жел ұшырып кететін сияқты
Dialogue: 0,0:01:51.06,0:01:56.11,Default,,0,0,0,,♪ Амалсыз тамақ ішу
Dialogue: 0,0:01:56.19,0:02:01.36,Default,,0,0,0,,♪ Кәдімгі қоңырау үні мен терезенің жанына үйілген шаң
Dialogue: 0,0:02:01.45,0:02:06.66,Default,,0,0,0,,♪ Тіпті сыныптың иісі де
Dialogue: 0,0:02:06.74,0:02:09.25,Default,,0,0,0,,♪ Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:02:09.33,0:02:11.79,Default,,0,0,0,,♪ Бір күні өлгенше қанша рет болса да
Dialogue: 0,0:02:11.87,0:02:17.30,Default,,0,0,0,,♪ Осындай жағдай болса да, күлме.
Dialogue: 0,0:02:37.07,0:02:38.86,Default,,0,0,0,,Рахмет! ‬
Dialogue: 0,0:02:38.94,0:02:41.45,Default,,0,0,0,,Бірінші ән «Ұмытпаймын»
Dialogue: 0,0:02:43.53,0:02:45.12,Default,,0,0,0,,Таңқаларлықтай қызықты
Dialogue: 0,0:02:45.20,0:02:46.58,Default,,0,0,0,,Кита-чан! ‬
Dialogue: 0,0:02:46.66,0:02:47.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:50.25,0:02:52.16,Default,,0,0,0,,Олай болса, келесі әннің алдында
Dialogue: 0,0:02:52.75,0:02:56.50,Default,,0,0,0,,Менің атым Койка Иджичи, аспалы байлаудың жетекшісі және барабаншы.
Dialogue: 0,0:02:58.80,0:03:00.76,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын! ‬
Dialogue: 0,0:03:00.84,0:03:02.30,Default,,0,0,0,,Көңілдің ба? ‬
Dialogue: 0,0:03:02.38,0:03:05.59,Default,,0,0,0,,Сіз қатты тырысып жатырсыз.
Dialogue: 0,0:03:05.68,0:03:07.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:07.10,0:03:09.18,Default,,0,0,0,,Бірақ Бокчи-чан...
Dialogue: 0,0:03:09.27,0:03:10.68,Default,,0,0,0,,Бассист Рио Ямада ше? ‬
Dialogue: 0,0:03:11.31,0:03:14.60,Default,,0,0,0,,MC кабельдік байланыстарды жалықтыратын сияқты.
Dialogue: 0,0:03:14.69,0:03:16.81,Default,,0,0,0,,«Қай ауыз?» деп таң қаламын.
Dialogue: 0,0:03:16.90,0:03:18.69,Default,,0,0,0,,Қызықты әңгімелер болғанша
Dialogue: 0,0:03:18.77,0:03:20.82,Default,,0,0,0,,Мен жай ғана тікелей эфирде хабарландырулар жасаймын~
Dialogue: 0,0:03:21.78,0:03:25.53,Default,,0,0,0,,Сонымен... Келесі тікелей эфирге әлі жоспарым жоқ.
Dialogue: 0,0:03:25.61,0:03:27.91,Default,,0,0,0,,Егер сізді қызықтыратын адам болса
Dialogue: 0,0:03:27.99,0:03:28.78,Default,,0,0,0,,Вокалист Кита Чан...
Dialogue: 0,0:03:28.87,0:03:29.99,Default,,0,0,0,,Кита-чан! ‬
Dialogue: 0,0:03:30.08,0:03:32.83,Default,,0,0,0,,Гитарист... Ах, Гото Хитори-чан.
Dialogue: 0,0:03:32.91,0:03:34.46,Default,,0,0,0,,Келесі жолы сәлемдесуіңізді өтінемін! ‬
Dialogue: 0,0:03:34.54,0:03:36.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:36.21,0:03:37.71,Default,,0,0,0,,Жалғыз! ‬
Dialogue: 0,0:03:38.54,0:03:40.80,Default,,0,0,0,,Олай болса, келесі әнге көшейік.
Dialogue: 0,0:03:40.88,0:03:41.88,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:03:42.67,0:03:44.09,Default,,0,0,0,,Енді тыңдаңыз.
Dialogue: 0,0:03:44.72,0:03:47.09,Default,,0,0,0,,Екінші ән «Шұлдыздар болып кетсең»
Dialogue: 0,0:03:49.81,0:03:50.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.08,0:04:18.50,Default,,0,0,0,,♪ Сағат 6-ға таяп қалды
Dialogue: 0,0:04:19.00,0:04:21.96,Default,,0,0,0,,♪ Бірінші жұлдыз қазірдің өзінде бар
Dialogue: 0,0:04:22.55,0:04:24.30,Default,,0,0,0,,♪ Көлеңкеге қадам басу
Dialogue: 0,0:04:24.38,0:04:30.43,Default,,0,0,0,,♪ Үйге бара жатқанда түнде жоғалып кеткім келеді
Dialogue: 0,0:04:31.47,0:04:33.02,Default,,0,0,0,,Бұл әлі біртүрлі
Dialogue: 0,0:04:34.73,0:04:37.19,Default,,0,0,0,,Күні кешеге дейін ештеңе болған жоқ.
Dialogue: 0,0:04:37.27,0:04:39.73,Default,,0,0,0,,1-ші және 2-ші жолдар әдеттен тыс күйде.
Dialogue: 0,0:04:40.31,0:04:47.24,Default,,0,0,0,,♪ «Жоқ, мен әрқашан жалғыз боламын».
Dialogue: 0,0:04:47.74,0:04:51.66,Default,,0,0,0,,♪ Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 0,0:04:51.74,0:04:52.66,Default,,0,0,0,,♪ Жұлдызды түн...
Dialogue: 0,0:04:52.74,0:04:54.41,Default,,0,0,0,,Бірінші жол! ‬
Dialogue: 0,0:04:54.50,0:04:58.04,Default,,0,0,0,,Нашар! Кем дегенде 2-ші жолды баптаңыз ...
Dialogue: 0,0:04:58.12,0:05:00.54,Default,,0,0,0,,Әй, қазық сынды! ‬
Dialogue: 0,0:05:00.63,0:05:03.34,Default,,0,0,0,,Бұл екінші жолды жарамсыз етеді.
Dialogue: 0,0:05:03.42,0:05:05.05,Default,,0,0,0,,Сіз мұнымен жалғыз бола алмайсыз.
Dialogue: 0,0:05:05.71,0:05:08.68,Default,,0,0,0,,Не істеуім керек... Жақында Соло келеді
Dialogue: 0,0:05:08.76,0:05:11.01,Default,,0,0,0,,Бағалы мектеп фестивалі тікелей эфирде
Dialogue: 0,0:05:11.10,0:05:13.64,Default,,0,0,0,,Жабдықтағы ақаулық салдарынан бұзылдым
Dialogue: 0,0:05:13.72,0:05:15.18,Default,,0,0,0,,Не істеуім керек? Мен не істеуім керек...
Dialogue: 0,0:05:15.27,0:05:16.68,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек? ‬
Dialogue: 0,0:05:16.77,0:05:21.11,Default,,0,0,0,,♪ Қанша тамсандырсам да
Dialogue: 0,0:05:24.61,0:05:28.15,Default,,0,0,0,,Кита-сан...Кездесуіміз болмаса да импровизация жасадым! ‬
Dialogue: 0,0:05:29.03,0:05:30.28,Default,,0,0,0,,Барлығына көрсетіңіз
Dialogue: 0,0:05:30.86,0:05:34.41,Default,,0,0,0,,Гото мырза шынымен керемет.
Dialogue: 0,0:05:39.00,0:05:40.75,Default,,0,0,0,,Бұл гитара не істеп жатыр? ‬
Dialogue: 0,0:05:40.83,0:05:43.04,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ бұл керемет! ‬
Dialogue: 0,0:05:43.13,0:05:46.92,Default,,0,0,0,,Сіз әдетте осы соңғы минутта тығырықтан шығу техникасын жасайсыз ба? ‬
Dialogue: 0,0:05:47.01,0:05:50.26,Default,,0,0,0,,Егер солай болса, сенің күйің жоқ болса, бәрібір.
Dialogue: 0,0:05:50.76,0:05:56.18,Default,,0,0,0,,♪ Алыста кездесіп қалдық
Dialogue: 0,0:05:58.68,0:06:04.11,Default,,0,0,0,,♪ Бұл карма болғандықтан, біз қайта-қайта кездесеміз.
Dialogue: 0,0:06:05.90,0:06:08.74,Default,,0,0,0,,♪ Бұлттардың арасындағы аралықта
Dialogue: 0,0:06:10.70,0:06:14.53,Default,,0,0,0,,♪ Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 0,0:06:14.62,0:06:18.83,Default,,0,0,0,,♪ Түнді жайып, аспанның суретін салайық
Dialogue: 0,0:06:19.58,0:06:26.38,Default,,0,0,0,,♪ Қараңғылықты нұрландыратын толық ай болмаса да
Dialogue: 0,0:06:26.46,0:06:30.26,Default,,0,0,0,,♪ Сондықтан мен бас қосып, шоқжұлдыз болғым келеді.
Dialogue: 0,0:06:30.34,0:06:34.55,Default,,0,0,0,,♪ Түрлі-түсті жарық шығаратын сияқты
Dialogue: 0,0:06:35.14,0:06:38.93,Default,,0,0,0,,♪ Қосылған сызықтарды аша алмаймын
Dialogue: 0,0:06:39.02,0:06:43.73,Default,,0,0,0,,♪ Қаншалықты тамсандыратын болсаң да
Dialogue: 0,0:07:27.44,0:07:30.03,Default,,0,0,0,,Ах~ Мм...
Dialogue: 0,0:07:30.11,0:07:33.86,Default,,0,0,0,,Негізі мен соңғы әнді жалғастырғалы жатырмын.
Dialogue: 0,0:07:34.91,0:07:36.95,Default,,0,0,0,,Осыны айтайын! ‬
Dialogue: 0,0:07:37.74,0:07:40.33,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет! ‬
Dialogue: 0,0:07:42.04,0:07:44.25,Default,,0,0,0,,Бұл күннің өмірі – әркімнің болашағы
Dialogue: 0,0:07:44.33,0:07:46.50,Default,,0,0,0,,Біз мақтанатын топ боламыз! ‬
Dialogue: 0,0:07:46.58,0:07:47.58,Default,,0,0,0,,Керемет! ‬
Dialogue: 0,0:07:47.67,0:07:49.17,Default,,0,0,0,,Будоканға барайық! ‬
Dialogue: 0,0:07:49.25,0:07:51.96,Default,,0,0,0,,Көмегің үшін көп рахмет! ‬
Dialogue: 0,0:07:52.05,0:07:53.34,Default,,0,0,0,,Ах, аха
Dialogue: 0,0:07:53.42,0:07:55.38,Default,,0,0,0,,Жіп үзілді, бірақ сен барыңды салдың! ‬
Dialogue: 0,0:07:55.47,0:07:56.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:56.22,0:08:00.10,Default,,0,0,0,,Қараңызшы, Гото мырза, мен бірдеңе айтуым керек.
Dialogue: 0,0:08:00.18,0:08:01.18,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:08:01.93,0:08:04.27,Default,,0,0,0,,Фуфу аа аа аа...
Dialogue: 0,0:08:04.35,0:08:05.73,Default,,0,0,0,,Коммунизм... Коммунизм бұл
Dialogue: 0,0:08:05.81,0:08:08.40,Default,,0,0,0,,Алдын ала сценарий дайындамайынша сөйлей алмаймын.
Dialogue: 0,0:08:09.19,0:08:11.40,Default,,0,0,0,,Егер біреу күтпеген жерден кейіп танытса...
Dialogue: 0,0:08:14.44,0:08:17.61,Default,,0,0,0,,Қызық бірдеңе Қызық бірдеңе...
Dialogue: 0,0:08:17.70,0:08:21.16,Default,,0,0,0,,Бірдеңе... қызық...
Dialogue: 0,0:08:21.24,0:08:22.24,Default,,0,0,0,,Гото мырза? ‬
Dialogue: 0,0:08:22.29,0:08:23.83,Default,,0,0,0,,Хехехе хехе
Dialogue: 0,0:08:25.54,0:08:26.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.54,0:08:27.83,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:08:28.71,0:08:29.33,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:08:29.42,0:08:30.29,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:08:30.38,0:08:31.38,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:08:44.73,0:08:45.73,Default,,0,0,0,,Кя~! Гото мырза! ‬
Dialogue: 0,0:08:45.81,0:08:47.19,Default,,0,0,0,,Бокчи-чан, жақсысың ба? ‬
Dialogue: 0,0:08:47.27,0:08:49.77,Default,,0,0,0,,Сіз аңызға айналған рок жұлдызысыз
Dialogue: 0,0:08:49.86,0:08:52.27,Default,,0,0,0,,Хахаха Ах, Бокчи-чан ең жақсы! ‬
Dialogue: 0,0:08:52.36,0:08:53.86,Default,,0,0,0,,Сәл уайымдаңыз! ‬
Dialogue: 0,0:08:53.94,0:08:54.99,Default,,0,0,0,,Бұл рас! ‬
Dialogue: 0,0:08:55.57,0:08:56.65,Default,,0,0,0,,Зембілді әкел! ‬
Dialogue: 0,0:08:56.74,0:08:58.66,Default,,0,0,0,,Жалғыз! Сенімен бәрі жақсы ма? ‬
Dialogue: 0,0:08:58.74,0:09:00.57,Default,,0,0,0,,Менің әпкем кешіріңіз.
Dialogue: 0,0:09:00.66,0:09:02.45,Default,,0,0,0,,Ах~ Жоқ, жоқ
Dialogue: 0,0:09:02.53,0:09:03.37,Default,,0,0,0,,Күшік
Dialogue: 0,0:09:03.45,0:09:04.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:05.41,0:09:07.41,Default,,0,0,0,,Бітті...
Dialogue: 0,0:09:12.34,0:09:15.59,Default,,0,0,0,,Гото мырза, жақсысыз ба? Сіз ояндыңыз ба? ‬
Dialogue: 0,0:09:17.34,0:09:18.51,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:09:19.22,0:09:20.68,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:09:20.76,0:09:22.97,Default,,0,0,0,,Жарақат үлкен мәселе болмаған сияқты.
Dialogue: 0,0:09:23.06,0:09:23.64,Default,,0,0,0,,Мм...
Dialogue: 0,0:09:23.72,0:09:24.77,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:24.85,0:09:28.19,Default,,0,0,0,,Бұзғаным үшін кешірім сұраймын.
Dialogue: 0,0:09:28.27,0:09:29.27,Default,,0,0,0,,Қандай керемет мүмкіндік...
Dialogue: 0,0:09:29.35,0:09:32.65,Default,,0,0,0,,Жоқ, қандай да бір себептермен бұл қызықтырақ болуы мүмкін.
Dialogue: 0,0:09:32.73,0:09:33.73,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:34.78,0:09:36.78,Default,,0,0,0,,Ах, Ниджика-чан және басқалары? ‬
Dialogue: 0,0:09:36.86,0:09:38.40,Default,,0,0,0,,Қазіргі уақытта тазалау
Dialogue: 0,0:09:38.49,0:09:41.74,Default,,0,0,0,,Гото мырза, егер жақсы болса, осыдан кейін ұшыруға барайық.
Dialogue: 0,0:09:41.82,0:09:43.83,Default,,0,0,0,,Бірақ бұл мүмкін емес болып көрінсе, келесі жолы әрекетті қайталаңыз.
Dialogue: 0,0:09:43.91,0:09:45.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:45.45,0:09:47.25,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:09:47.33,0:09:48.33,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:48.41,0:09:51.58,Default,,0,0,0,,Кита-сан, сен оны білмей тұрып жақсы болып кеттің.
Dialogue: 0,0:09:51.67,0:09:52.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:55.09,0:09:56.67,Default,,0,0,0,,Тек тірек.
Dialogue: 0,0:09:58.26,0:09:59.55,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:00.05,0:10:01.05,Default,,0,0,0,,I
Dialogue: 0,0:10:01.13,0:10:03.93,Default,,0,0,0,,Адамдарды қызықтыратындай орындау мүмкін емес.
Dialogue: 0,0:10:04.01,0:10:05.01,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:10:05.51,0:10:09.35,Default,,0,0,0,,Бірақ сіз бәрімен тіл табыса алатын сияқтысыз.
Dialogue: 0,0:10:10.44,0:10:13.44,Default,,0,0,0,,Мен гитарада көп жұмыс істеймін, сондықтан маған хабарлаңыз.
Dialogue: 0,0:10:13.94,0:10:15.32,Default,,0,0,0,,Өту...
Dialogue: 0,0:10:16.40,0:10:17.19,Default,,0,0,0,,Хитори-чан
Dialogue: 0,0:10:17.28,0:10:19.19,Default,,0,0,0,,А, ә... А, иә! ‬
Dialogue: 0,0:10:19.28,0:10:22.16,Default,,0,0,0,,Ендеше, әрі қарай жүрейік. Дайын болған кезде кел.
Dialogue: 0,0:10:22.24,0:10:23.53,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:10:24.83,0:10:26.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:37.46,0:10:41.55,Default,,0,0,0,,Мен Хитори-чанға қолдау көрсете аламын.
Dialogue: 0,0:10:42.38,0:10:42.97,Default,,0,0,0,,Қазір...
Dialogue: 0,0:10:43.05,0:10:47.22,Default,,0,0,0,,Launch Launch♪ Бокчи-чан, жақсысың ба?
Dialogue: 0,0:10:47.31,0:10:49.14,Default,,0,0,0,,Мәдени фестиваль аяқталды
Dialogue: 0,0:10:59.86,0:11:01.15,Default,,0,0,0,,Әй, сүңгуір.
Dialogue: 0,0:11:01.24,0:11:01.95,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:11:02.03,0:11:04.45,Default,,0,0,0,,О, рок жігіті ме?
Dialogue: 0,0:11:07.66,0:11:08.66,Default,,0,0,0,,Бір күні...
Dialogue: 0,0:11:09.66,0:11:12.16,Default,,0,0,0,,Бір күні мен орта мектепті тастаймын! ‬
Dialogue: 0,0:11:14.50,0:11:16.04,Default,,0,0,0,,Әке, кешіріңіз.
Dialogue: 0,0:11:17.75,0:11:20.63,Default,,0,0,0,,Сіздің әпкеңіз не істеп жатыр? Уф уф! ‬
Dialogue: 0,0:11:20.71,0:11:22.26,Default,,0,0,0,,Гитара әкемнен алынған
Dialogue: 0,0:11:22.34,0:11:24.43,Default,,0,0,0,,Мен оны тірі орындау кезінде бұздым.
Dialogue: 0,0:11:24.51,0:11:25.97,Default,,0,0,0,,Жоғары қара! ‬
Dialogue: 0,0:11:26.05,0:11:28.43,Default,,0,0,0,,Әке, мен мүлдем ашуланбаймын, жарай ма? ‬
Dialogue: 0,0:11:28.51,0:11:32.43,Default,,0,0,0,,Бұл жәй ғана сынған қазық, солай ма? Бұл туралы уайымдаудың қажеті жоқ
Dialogue: 0,0:11:32.52,0:11:33.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:33.35,0:11:35.65,Default,,0,0,0,,Ал сіз оны тірі орындау кезінде бұздыңыз ба?
Dialogue: 0,0:11:35.73,0:11:37.77,Default,,0,0,0,,Әкем толқып тұрған сияқты.
Dialogue: 0,0:11:37.86,0:11:38.73,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:11:38.82,0:11:42.11,Default,,0,0,0,,Олар қазір «тек жоюға арналған гитара» деп аталатын нәрсені сататын сияқты.
Dialogue: 0,0:11:42.19,0:11:43.74,Default,,0,0,0,,Мұны келесі тікелей эфирде орындаңыз.
Dialogue: 0,0:11:43.82,0:11:46.32,Default,,0,0,0,,Қызыңызды қай бағытқа апарғыңыз келеді...
Dialogue: 0,0:11:46.91,0:11:49.66,Default,,0,0,0,,Бұл да жақсы мүмкіндік, мен гитараммен жалғыз адаммын.
Dialogue: 0,0:11:49.74,0:11:51.08,Default,,0,0,0,,Неліктен оны сатып алмасқа? Ойнайық~
Dialogue: 0,0:11:51.16,0:11:53.58,Default,,0,0,0,,А, бұл керемет емес пе? Эй, әке.
Dialogue: 0,0:11:53.66,0:11:55.25,Default,,0,0,0,,Осы жолы қиналған кезде
Dialogue: 0,0:11:55.33,0:11:57.13,Default,,0,0,0,,Бірден жауап беру мүмкіндігі
Dialogue: 0,0:11:57.83,0:12:00.30,Default,,0,0,0,,Жоқ, бірақ менің толық емес жұмыс күнім бар.
Dialogue: 0,0:12:00.38,0:12:03.13,Default,,0,0,0,,Мұндай ақша тірі орындау квотасына байланысты жоғалады...
Dialogue: 0,0:12:03.22,0:12:04.47,Default,,0,0,0,,Жарайды! Ах...
Dialogue: 0,0:12:04.55,0:12:05.76,Default,,0,0,0,,Ақша бар! ‬
Dialogue: 0,0:12:05.84,0:12:07.01,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:12:07.51,0:12:11.77,Default,,0,0,0,,Нана... Не? Бұл үлкен ақша, әке, қара базар...
Dialogue: 0,0:12:11.85,0:12:12.35,Default,,0,0,0,,ше? ‬
Dialogue: 0,0:12:12.43,0:12:15.19,Default,,0,0,0,,Міне... Мен бұл қара ақшаны қабылдай алмаймын.
Dialogue: 0,0:12:15.27,0:12:17.23,Default,,0,0,0,,Біз соншалықты шұғыл емеспіз! ‬
Dialogue: 0,0:12:17.94,0:12:22.73,Default,,0,0,0,,Бұл бір адамның бейне жарнамадан түскен табысынан тапқан ақша.
Dialogue: 0,0:12:23.32,0:12:23.86,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:12:23.94,0:12:26.95,Default,,0,0,0,,Көрулердің белгілі бір санын алсаңыз, сізге ақы төленеді.
Dialogue: 0,0:12:27.45,0:12:28.20,Default,,0,0,0,,А...
Dialogue: 0,0:12:28.28,0:12:29.95,Default,,0,0,0,,Бейне сайтының тіркелгісі
Dialogue: 0,0:12:30.03,0:12:32.41,Default,,0,0,0,,Сіз бұл отбасылық ортақ екенін ұмытып қалдыңыз.
Dialogue: 0,0:12:33.20,0:12:34.96,Default,,0,0,0,,Содан кейін менің бейнем...
Dialogue: 0,0:12:35.04,0:12:37.96,Default,,0,0,0,,Әрине, мен білемін, Гитара батыры, солай ма? ‬
Dialogue: 0,0:12:38.71,0:12:40.29,Default,,0,0,0,,Көру саны айтарлықтай көп болды.
Dialogue: 0,0:12:40.38,0:12:43.13,Default,,0,0,0,,Әке, мен жасырын жарнама қостым.
Dialogue: 0,0:12:43.21,0:12:45.84,Default,,0,0,0,,Менің қызым өте дәмді! ‬
Dialogue: 0,0:12:46.59,0:12:50.10,Default,,0,0,0,,Бір күні маған осындай нәрсе керек шығар деп ойладым.
Dialogue: 0,0:12:50.68,0:12:52.14,Default,,0,0,0,,Жалғыз жаттығыңыз, бар күшіңізді салыңыз
Dialogue: 0,0:12:52.22,0:12:54.72,Default,,0,0,0,,Мен өзімнің орындау процесінің жақсарғанын және жақсырақ болғанын көре алдым.
Dialogue: 0,0:12:54.81,0:12:56.73,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:12:57.23,0:12:58.73,Default,,0,0,0,,Иә? анам
Dialogue: 0,0:12:58.81,0:12:59.81,Default,,0,0,0,,Иә
Dialogue: 0,0:13:00.15,0:13:02.94,Default,,0,0,0,,Мама, мен музыканы мүлдем түсінбеймін.
Dialogue: 0,0:13:03.02,0:13:05.19,Default,,0,0,0,,Мен сені жақсы деп ойладым.
Dialogue: 0,0:13:06.03,0:13:08.49,Default,,0,0,0,,Әке Ана...
Dialogue: 0,0:13:08.57,0:13:10.49,Default,,0,0,0,,Жақсы, пропорционалды түрде
Dialogue: 0,0:13:10.57,0:13:12.33,Default,,0,0,0,,Өтірік айтудың шебері болу процесі
Dialogue: 0,0:13:12.41,0:13:13.95,Default,,0,0,0,,Әке, мен мұңайып қалдым.
Dialogue: 0,0:13:14.04,0:13:15.25,Default,,0,0,0,,Құсу! ‬
Dialogue: 0,0:13:18.25,0:13:20.71,Default,,0,0,0,,300 000...
Dialogue: 0,0:13:21.25,0:13:25.13,Default,,0,0,0,,Мен мұндай күтпеген жерден күтпеген едім.
Dialogue: 0,0:13:26.21,0:13:30.18,Default,,0,0,0,,Егер сіз шамамен 100 000 тұратын гитара сатып алсаңыз, сізде 200 000 қалады...
Dialogue: 0,0:13:31.30,0:13:33.22,Default,,0,0,0,,Қалғанын квотаңызға қолдансаңыз,
Dialogue: 0,0:13:33.31,0:13:36.06,Default,,0,0,0,,Мен екі жылға жуық толық емес жұмыс күнінсіз тікелей эфирде орындай аламын! ‬
Dialogue: 0,0:13:36.14,0:13:38.98,Default,,0,0,0,,Жақсы! Толық емес жұмыс уақытын доғарайық! ‬
Dialogue: 0,0:13:42.19,0:13:45.32,Default,,0,0,0,,Бүгін Бокчи-чан үнемі жарқырап тұрады.
Dialogue: 0,0:13:45.40,0:13:47.94,Default,,0,0,0,,Көзіміз түйіскен сайын бас иеді.
Dialogue: 0,0:13:48.78,0:13:49.78,Default,,0,0,0,,Ах
Dialogue: 0,0:13:50.82,0:13:51.82,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:13:52.57,0:13:54.12,Default,,0,0,0,,Егер сіз толық емес жұмыс күнін тоқтата аламын деп ойласаңыз
Dialogue: 0,0:13:54.20,0:13:56.87,Default,,0,0,0,,Жұмбақ күш шексіз пайда болады! ‬
Dialogue: 0,0:13:57.62,0:13:59.92,Default,,0,0,0,,Дүкен менеджерімен сөйлесейік! ‬
Dialogue: 0,0:14:00.50,0:14:03.17,Default,,0,0,0,,Ахх! Супер супер Бокчи-чан? ‬
Dialogue: 0,0:14:03.25,0:14:05.09,Default,,0,0,0,,А? Толық емес жұмысыңыз қандай? ‬
Dialogue: 0,0:14:05.75,0:14:08.51,Default,,0,0,0,,А-а, мынау...
Dialogue: 0,0:14:08.59,0:14:12.26,Default,,0,0,0,,Мен жан-тәніммен жұмыс істеймін...
Dialogue: 0,0:14:12.34,0:14:14.39,Default,,0,0,0,,Неліктен айқындықтың кенеттен жариялануы? ‬
Dialogue: 0,0:14:14.47,0:14:18.10,Default,,0,0,0,,Толық емес жұмыс күнін тоқтатудың ең қиын бөлігі - шығу туралы шешім қабылдау.
Dialogue: 0,0:14:18.18,0:14:19.10,Default,,0,0,0,,Бэкре...
Dialogue: 0,0:14:19.18,0:14:21.31,Default,,0,0,0,,Жоқ, жоқ, менің мекенжайым құлыптаулы...
Dialogue: 0,0:14:21.39,0:14:23.61,Default,,0,0,0,,Бұл әркімге кедергі емес.
Dialogue: 0,0:14:23.69,0:14:26.86,Default,,0,0,0,,Бокчи-чан, сен бүгін музыкалық аспаптар дүкеніне барасың ба? ‬
Dialogue: 0,0:14:26.94,0:14:27.78,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:14:27.86,0:14:31.07,Default,,0,0,0,,Дүкен менеджеріне бірдеңе берсеңіз, оның жұмыстан шығуына рұқсат беруіңіз мүмкін.
Dialogue: 0,0:14:31.15,0:14:32.86,Default,,0,0,0,,Менде қазір көп ақша бар! ‬
Dialogue: 0,0:14:32.95,0:14:34.45,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:14:34.53,0:14:38.24,Default,,0,0,0,,Менеджердің қазір не қалайтынын айта аласыз ба? ‬
Dialogue: 0,0:14:38.33,0:14:39.83,Default,,0,0,0,,Бұл Бокчи Чан.
Dialogue: 0,0:14:40.33,0:14:43.38,Default,,0,0,0,,Менің әпкемнің туған күні жақындап қалды, мүмкін бұл сыйлық шығар? ‬
Dialogue: 0,0:14:43.96,0:14:44.96,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:14:45.38,0:14:46.38,Default,,0,0,0,,«Маған бұл қажет емес»
Dialogue: 0,0:14:46.42,0:14:47.25,Default,,0,0,0,,Уга
Dialogue: 0,0:14:47.34,0:14:48.09,Default,,0,0,0,,Бітті...
Dialogue: 0,0:14:48.17,0:14:49.09,Default,,0,0,0,,Мен Бокчимін
Dialogue: 0,0:14:49.17,0:14:50.92,Default,,0,0,0,,Дингволл мен Ле Фэйдің жаңа басы жоқ
Dialogue: 0,0:14:51.01,0:14:53.01,Default,,0,0,0,,Мен Darkglass күшейткіш басын алғым келеді.
Dialogue: 0,0:14:53.09,0:14:55.76,Default,,0,0,0,,Бәрің, мен музыкалық аспаптар дүкеніне барамын.
Dialogue: 0,0:14:55.85,0:14:57.26,Default,,0,0,0,,Кеттік! ‬
Dialogue: 0,0:14:57.35,0:14:59.27,Default,,0,0,0,,Қош келдіңіз, Бокчи-чан, сіз өте мейірімдісіз...
Dialogue: 0,0:15:00.35,0:15:02.60,Default,,0,0,0,,Бірақ мен тосын адаммын.
Dialogue: 0,0:15:02.69,0:15:03.69,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:15:05.81,0:15:08.86,Default,,0,0,0,,Музыкалық аспаптар дүкендеріне келетін болсақ, бұл сөзсіз Ochanomizu.
Dialogue: 0,0:15:08.94,0:15:10.44,Default,,0,0,0,,Сәлем, Хитори-чан
Dialogue: 0,0:15:10.53,0:15:13.45,Default,,0,0,0,,Неліктен музыкалық аспаптар дүкендері көп? ‬
Dialogue: 0,0:15:13.53,0:15:14.95,Default,,0,0,0,,Міне! ‬
Dialogue: 0,0:15:15.45,0:15:16.03,Default,,0,0,0,,Мэйдзи дәуірінде
Dialogue: 0,0:15:16.12,0:15:19.24,Default,,0,0,0,,Жапонияның ең көне кәсіби оркестрі құрылғаннан бері
Dialogue: 0,0:15:19.33,0:15:21.04,Default,,0,0,0,,Токиода музыкалық белсенділік өркендеуде.
Dialogue: 0,0:15:21.12,0:15:23.87,Default,,0,0,0,,Сол кезде Очаномизуда қазір бұрыннан қалыптасқан дүкен деп аталатын Шимокура музыкалық аспаптары құрылды.
Dialogue: 0,0:15:23.96,0:15:25.46,Default,,0,0,0,,Ишибаши музыкалық аспабы жасалды, мен қатты қуандым...
Dialogue: 0,0:15:25.54,0:15:27.67,Default,,0,0,0,,Мен бүгін қиналатын сияқтымын.
Dialogue: 0,0:15:28.34,0:15:30.76,Default,,0,0,0,,Кірейік! Өнімдердің жақсы таңдауы
Dialogue: 0,0:15:30.84,0:15:32.88,Default,,0,0,0,,Мен кіргім келмейді...
Dialogue: 0,0:15:33.43,0:15:36.85,Default,,0,0,0,,Мен шынымен онлайн тапсырыс беруді ойладым.
Dialogue: 0,0:15:36.93,0:15:41.06,Default,,0,0,0,,Интернет-сауда сайттары жақсы, бірақ таңдау жасамас бұрын оны сынап көрген дұрыс.
Dialogue: 0,0:15:41.14,0:15:42.23,Default,,0,0,0,,Иә
Dialogue: 0,0:15:43.06,0:15:45.15,Default,,0,0,0,,Музыкалық дүкеннің қызметкерлері қорқынышты сияқты.
Dialogue: 0,0:15:45.23,0:15:47.27,Default,,0,0,0,,Егер сізбен біреу сөйлессе...
Dialogue: 0,0:15:47.36,0:15:50.23,Default,,0,0,0,,Бұл гитараны таңдауда сіздің талғамыңыз керемет, солай емес пе? ‬
Dialogue: 0,0:15:50.32,0:15:50.94,Default,,0,0,0,,А...
Dialogue: 0,0:15:51.03,0:15:54.57,Default,,0,0,0,,Сіз батыс музыкасын тыңдайсыз ба? Әй, тыңдамайсың ба? Мен сені өлтіремін! ‬
Dialogue: 0,0:15:54.65,0:15:56.57,Default,,0,0,0,,А-а-а~
Dialogue: 0,0:15:56.66,0:15:58.87,Default,,0,0,0,,Мен... Құлаққапты тағып алып, қағып тұрғандай кейіп таныта аламын.
Dialogue: 0,0:15:58.95,0:16:00.33,Default,,0,0,0,,Ол сізбен сөйлеспеуі керек.
Dialogue: 0,0:16:03.29,0:16:04.21,Default,,0,0,0,,Те... Менеджер
Dialogue: 0,0:16:04.29,0:16:06.67,Default,,0,0,0,,Біздің дүкенге таңғажайып қыз келді! ‬
Dialogue: 0,0:16:06.75,0:16:08.59,Default,,0,0,0,,Металл жанкүйері болуы керек! ‬
Dialogue: 0,0:16:08.67,0:16:10.05,Default,,0,0,0,,Хаа ха... Тұтынушы! ‬
Dialogue: 0,0:16:10.13,0:16:12.26,Default,,0,0,0,,Егер сіз металға бағытталған гитара іздесеңіз, екінші қабатты қараңыз...
Dialogue: 0,0:16:12.34,0:16:13.34,Default,,0,0,0,,Oh, what? ‬
Dialogue: 0,0:16:14.09,0:16:16.55,Default,,0,0,0,,А, бұл бау сүйкімді! ‬
Dialogue: 0,0:16:16.63,0:16:19.43,Default,,0,0,0,,Бұл түс Кита-чанның гитарасына жарасады деп ойламайсыз ба? ‬
Dialogue: 0,0:16:20.81,0:16:24.35,Default,,0,0,0,,Уау~ Таңдаудың көптеген түрлері бар.
Dialogue: 0,0:16:24.43,0:16:26.52,Default,,0,0,0,,Оны сырға жасауым керек пе?
Dialogue: 0,0:16:26.60,0:16:27.52,Default,,0,0,0,,Бұл жақсы емес пе? ‬
Dialogue: 0,0:16:27.60,0:16:28.48,Default,,0,0,0,,Тұтынушы туралы не деуге болады?
Dialogue: 0,0:16:28.56,0:16:30.44,Default,,0,0,0,,Осыдан кейін қолдан жасалған дүкенге барғыңыз келе ме? ‬
Dialogue: 0,0:16:30.52,0:16:32.32,Default,,0,0,0,,А, мен жаңа ғана тексердім, бұл тұтынушы! ‬
Dialogue: 0,0:16:32.40,0:16:34.49,Default,,0,0,0,,Жақын жерде жақсы дәмхана да бар...
Dialogue: 0,0:16:35.07,0:16:36.24,Default,,0,0,0,,Музыкалық аспаптарды қараңыз.
Dialogue: 0,0:16:39.37,0:16:42.54,Default,,0,0,0,,Кешіріңіз, мен осы бассты ойнатып көрсем бола ма? ‬
Dialogue: 0,0:16:42.62,0:16:44.12,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:44.70,0:16:46.83,Default,,0,0,0,,Сенпай, тағы сатып алмақшысың ба? ‬
Dialogue: 0,0:16:46.92,0:16:47.92,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:47.96,0:16:50.42,Default,,0,0,0,,Мен оны жеңіл ойнағым келеді, өйткені мен аздап қызықпын.
Dialogue: 0,0:16:51.17,0:16:53.21,Default,,0,0,0,,А, мен сені шапалақтай аламын ба? ‬
Dialogue: 0,0:16:53.30,0:16:54.51,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:16:55.17,0:16:57.26,Default,,0,0,0,,Ах! Мүмкін емес! Бұл дегенмен
Dialogue: 0,0:16:58.84,0:17:00.09,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:17:01.14,0:17:02.26,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:03.85,0:17:06.10,Default,,0,0,0,,О~ Бұл керемет...
Dialogue: 0,0:17:06.18,0:17:09.10,Default,,0,0,0,,Жарайды... Мен оны кездейсоқ ойнадым...
Dialogue: 0,0:17:09.19,0:17:10.94,Default,,0,0,0,,Керемет жақсы басс
Dialogue: 0,0:17:11.44,0:17:13.73,Default,,0,0,0,,Сынақ кезінде байсалды және өзін-өзі ұстайтын жігіт! ‬
Dialogue: 0,0:17:13.82,0:17:15.32,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:17.15,0:17:18.82,Default,,0,0,0,,Не? Икуё? ‬
Dialogue: 0,0:17:18.90,0:17:20.20,Default,,0,0,0,,Бұл гитара сізді қызықтырады ма? ‬
Dialogue: 0,0:17:20.28,0:17:22.45,Default,,0,0,0,,Не? А, жоқ, олай емес...
Dialogue: 0,0:17:22.53,0:17:23.03,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:17:23.12,0:17:26.79,Default,,0,0,0,,Менде Рио-сенпайдан алған гитара бар.
Dialogue: 0,0:17:26.87,0:17:29.21,Default,,0,0,0,,Сізде қанша гитара болғаны маңызды емес.
Dialogue: 0,0:17:29.29,0:17:31.84,Default,,0,0,0,,Барлығы көңілді деп үміттенемін~
Dialogue: 0,0:17:33.13,0:17:33.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.92,0:17:37.80,Default,,0,0,0,,Бұл комикстерде жиі кездесетін барабаншының жалғыздық мәселесі ме?
Dialogue: 0,0:17:37.88,0:17:41.85,Default,,0,0,0,,Ах, мен де гитара мен басс сатып алуым керек сияқты...
Dialogue: 0,0:17:41.93,0:17:43.05,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:17:43.14,0:17:44.81,Default,,0,0,0,,Қалыпты ойнау үшін! ‬
Dialogue: 0,0:17:44.89,0:17:47.23,Default,,0,0,0,,Түсіндім, сен жалғыз болдың ба?
Dialogue: 0,0:17:47.31,0:17:49.06,Default,,0,0,0,,Келесі жолы барабан мамандандырылған дүкеніне барайық! ‬
Dialogue: 0,0:17:49.14,0:17:50.56,Default,,0,0,0,,Өйткені ол Акибада
Dialogue: 0,0:17:50.65,0:17:52.19,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:17:52.27,0:17:53.77,Default,,0,0,0,,YAMAHA мырза, бұл тамаша!
Dialogue: 0,0:17:53.86,0:17:54.48,Default,,0,0,0,,Ахии~! ‬
Dialogue: 0,0:17:54.57,0:17:56.36,Default,,0,0,0,,Бұл реттелетін спецификация.
Dialogue: 0,0:17:56.44,0:17:59.95,Default,,0,0,0,,Бұл қол жетімді гитара, бірақ бұл өте жақсы гитара.
Dialogue: 0,0:18:00.03,0:18:01.95,Default,,0,0,0,,А... Қарсы болмасаңыз, байқап көргіңіз келе ме? ‬
Dialogue: 0,0:18:02.03,0:18:03.32,Default,,0,0,0,,А, жоқ, м...
Dialogue: 0,0:18:03.41,0:18:05.08,Default,,0,0,0,,Егер бұл сіздің бірінші гитарыңыз болса
Dialogue: 0,0:18:05.16,0:18:08.16,Default,,0,0,0,,Қалқан мен шағын күшейткіштің де болғаны жақсы.
Dialogue: 0,0:18:08.25,0:18:09.29,Default,,0,0,0,,Ой...
Dialogue: 0,0:18:09.37,0:18:10.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:11.50,0:18:12.08,Default,,0,0,0,,Сатып алу...
Dialogue: 0,0:18:12.17,0:18:13.96,Default,,0,0,0,,Бокчи-чан, сізде бар, солай ма?
Dialogue: 0,0:18:14.04,0:18:17.09,Default,,0,0,0,,А, сен тәжірибелі адамсың! Кешіріңіз
Dialogue: 0,0:18:17.17,0:18:19.80,Default,,0,0,0,,А, жоқ, жарайды.
Dialogue: 0,0:18:19.88,0:18:22.59,Default,,0,0,0,,Бұл баланың гитарасы жақында сынып қалды.
Dialogue: 0,0:18:22.68,0:18:25.31,Default,,0,0,0,,Бүгін мен ауыстыратын машина іздеуге келдім.
Dialogue: 0,0:18:25.39,0:18:27.22,Default,,0,0,0,,Дұрыс па? Хитори-чан
Dialogue: 0,0:18:27.31,0:18:28.52,Default,,0,0,0,,An An
Dialogue: 0,0:18:29.02,0:18:30.60,Default,,0,0,0,,Бұл күндері тіпті студенттер
Dialogue: 0,0:18:30.69,0:18:33.40,Default,,0,0,0,,Бірнеше көшірмелері бар адамдар бар.
Dialogue: 0,0:18:33.48,0:18:35.44,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:18:35.52,0:18:38.19,Default,,0,0,0,,Сізге бұл гитара ұнай ма? Хитори-чан
Dialogue: 0,0:18:38.28,0:18:38.99,Default,,0,0,0,,Ан
Dialogue: 0,0:18:39.07,0:18:41.03,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:18:41.53,0:18:43.28,Default,,0,0,0,,Бұл гитара қолданылатын сияқты.
Dialogue: 0,0:18:43.36,0:18:44.82,Default,,0,0,0,,Дұрыс па? Хитори-чан
Dialogue: 0,0:18:44.91,0:18:46.62,Default,,0,0,0,,Рахмет! ‬
Dialogue: 0,0:18:46.70,0:18:49.20,Default,,0,0,0,,Мен вентрилокист қуыршақ сияқтымын
Dialogue: 0,0:18:49.29,0:18:51.54,Default,,0,0,0,,Мен сені жақында есейіп қалдым деп ойладым.
Dialogue: 0,0:18:51.62,0:18:53.12,Default,,0,0,0,,Бұл салада әлі көп жол бар.
Dialogue: 0,0:18:53.96,0:18:55.08,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:18:55.67,0:18:59.01,Default,,0,0,0,,Мен бұл гитараны тексердім және ұстадым.
Dialogue: 0,0:18:59.09,0:18:59.96,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:19:00.05,0:19:03.47,Default,,0,0,0,,Өте жақсы жасалған, маған да ұнайды.
Dialogue: 0,0:19:03.97,0:19:08.01,Default,,0,0,0,,Бұл гитараны тұтынушыларымыз таңдағанына қуаныштымын.
Dialogue: 0,0:19:09.31,0:19:11.43,Default,,0,0,0,,Сатып алғаныңыз үшін рахмет! ‬
Dialogue: 0,0:19:11.98,0:19:13.19,Default,,0,0,0,,А, а... иә? ‬
Dialogue: 0,0:19:13.27,0:19:14.44,Default,,0,0,0,,Рахмет! ‬
Dialogue: 0,0:19:14.52,0:19:16.86,Default,,0,0,0,,Тұтынушы? Мен гитараны ұмытып қалдым! ‬
Dialogue: 0,0:19:16.94,0:19:18.98,Default,,0,0,0,,Қанша оралғыңыз келді?
Dialogue: 0,0:19:20.24,0:19:21.24,Default,,0,0,0,,Иә
Dialogue: 0,0:19:21.49,0:19:24.36,Default,,0,0,0,,Дүкен менеджері: «Дүкенге тағы да келіңіз», - деді.
Dialogue: 0,0:19:24.45,0:19:27.03,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:19:27.12,0:19:29.29,Default,,0,0,0,,Жақсы гитара тапқаныңызға қуаныштымын.
Dialogue: 0,0:19:29.37,0:19:30.41,Default,,0,0,0,,Иә
Dialogue: 0,0:19:30.50,0:19:32.71,Default,,0,0,0,,Не істеу керек? Бірдеңе жеп, үйге қайтқыңыз келе ме? ‬
Dialogue: 0,0:19:32.79,0:19:33.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:33.75,0:19:35.12,Default,,0,0,0,,Бүгін таратылады, иә? ‬
Dialogue: 0,0:19:35.21,0:19:36.96,Default,,0,0,0,,Сізде бірдеңе бар ма? ‬
Dialogue: 0,0:19:37.04,0:19:39.63,Default,,0,0,0,,Бокчи Жақында гитарада ойнауды бастағыңыз келеді, солай емес пе? ‬
Dialogue: 0,0:19:39.71,0:19:40.71,Default,,0,0,0,,Ааа~
Dialogue: 0,0:19:40.76,0:19:41.34,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:19:41.42,0:19:44.84,Default,,0,0,0,,Қазірдің өзінде~ Екеуміз қайтадан бір-бірімізбен сөйлесіп жатқандай сезіне бастадым! ‬
Dialogue: 0,0:19:44.93,0:19:46.80,Default,,0,0,0,,Ал, тыныштал.
Dialogue: 0,0:19:46.89,0:19:50.06,Default,,0,0,0,,А, дұрыс! Енді студияны жалға ал.
Dialogue: 0,0:19:50.14,0:19:52.43,Default,,0,0,0,,Хитори-чанның гитарасын ашатын кеш ұйымдастырамыз ба? ‬
Dialogue: 0,0:19:52.52,0:19:54.39,Default,,0,0,0,,Жоқ, бұл біраз...
Dialogue: 0,0:19:54.48,0:19:56.85,Default,,0,0,0,,Ал, ертең бәріміз жаттығу жасаймыз.
Dialogue: 0,0:19:56.94,0:19:58.65,Default,,0,0,0,,Сол кезді асыға күтіңіз~
Dialogue: 0,0:19:58.73,0:20:00.11,Default,,0,0,0,,... иә
Dialogue: 0,0:20:00.19,0:20:02.28,Default,,0,0,0,,Мектеп мерекесі аяқталды.
Dialogue: 0,0:20:02.36,0:20:05.49,Default,,0,0,0,,Мен келесі тікелей эфир туралы және басқа нәрселер туралы ойлауым керек.
Dialogue: 0,0:20:05.57,0:20:06.61,Default,,0,0,0,,Дұрыс! ‬
Dialogue: 0,0:20:06.70,0:20:08.37,Default,,0,0,0,,Рёға да жаңа ән беріңізші! ‬
Dialogue: 0,0:20:08.45,0:20:10.45,Default,,0,0,0,,Мұның бәрі шабыт күтуде
Dialogue: 0,0:20:10.54,0:20:14.08,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:20:14.16,0:20:14.83,Default,,0,0,0,,Бірдеңе? ‬
Dialogue: 0,0:20:14.91,0:20:16.54,Default,,0,0,0,,Кита-чан
Dialogue: 0,0:20:16.62,0:20:19.38,Default,,0,0,0,,Риоға мұндай сөздерді кездейсоқ айтпа.
Dialogue: 0,0:20:19.46,0:20:20.80,Default,,0,0,0,,Хехе, олай болса бірден жасайық.
Dialogue: 0,0:20:20.88,0:20:22.13,Default,,0,0,0,,Өзіңізді сиыр етіне арналған тостағанмен сыйлаңыз
Dialogue: 0,0:20:23.51,0:20:25.17,Default,,0,0,0,,Үлкен әпке! ‬
Dialogue: 0,0:20:25.26,0:20:27.68,Default,,0,0,0,,Асықпасаң, кешігесің~
Dialogue: 0,0:20:28.59,0:20:30.10,Default,,0,0,0,,күрсіну~
Dialogue: 0,0:20:31.51,0:20:34.39,Default,,0,0,0,,Ух-хэ-хэ... тамаша
Dialogue: 0,0:20:36.19,0:20:37.19,Default,,0,0,0,,Ах
Dialogue: 0,0:20:37.48,0:20:38.19,Default,,0,0,0,,Ха! ‬
Dialogue: 0,0:20:38.27,0:20:41.69,Default,,0,0,0,,Ах... Кешіріңіз! Мен... мен де сені ұмытқан жоқпын! ‬
Dialogue: 0,0:20:41.77,0:20:43.23,Default,,0,0,0,,Ю... өтінемін, мені кешіріңіз! ‬
Dialogue: 0,0:20:43.74,0:20:45.95,Default,,0,0,0,,Әлгі бала тағы да... аа...
Dialogue: 0,0:20:46.03,0:20:47.03,Default,,0,0,0,,Кун
Dialogue: 0,0:20:53.91,0:20:55.16,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:23:41.58,0:23:43.83,Default,,0,0,0,,Бүгін сіздің де толық емес жұмысыңыз бар ма?
Dialogue: 0,0:23:47.13,0:23:48.25,Default,,0,0,0,,Сенкю!
Dialogue: 0,0:23:49.75,0:23:55.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory