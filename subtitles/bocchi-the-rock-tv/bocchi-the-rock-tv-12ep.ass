Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.93,0:00:07.06,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:00:22.71,0:00:25.29,Default,,0,0,0,,♪ Мұның бәрі ауа райына байланысты.
Dialogue: 0,0:00:25.37,0:00:27.92,Default,,0,0,0,,♪ Бұл ыңғайсыздық пен шаршау
Dialogue: 0,0:00:28.00,0:00:32.13,Default,,0,0,0,,♪ Күн жасырын, бірақ белгісіз
Dialogue: 0,0:00:32.92,0:00:35.68,Default,,0,0,0,,♪ Толып жатқан пойыз дірілдеп тұр
Dialogue: 0,0:00:35.76,0:00:38.22,Default,,0,0,0,,♪ Бір-бірінен өтіп бара жатқан пойыз жартылай жүріс пойыз.
Dialogue: 0,0:00:38.30,0:00:43.39,Default,,0,0,0,,♪ Контурсыз бұлттың өрнегін іздеңіз
Dialogue: 0,0:00:43.48,0:00:46.19,Default,,0,0,0,,♪ «Автордың сезіміне жауап беріңіз».
Dialogue: 0,0:00:46.27,0:00:48.77,Default,,0,0,0,,♪ Дұрыс жауап қайсы?
Dialogue: 0,0:00:49.36,0:00:53.78,Default,,0,0,0,,♪ Алдын ала белгіленген үйлесімділік сценарийінен шығу
Dialogue: 0,0:00:53.86,0:00:59.08,Default,,0,0,0,,♪ Қандай көгілдір бұлақ
Dialogue: 0,0:00:59.16,0:01:04.21,Default,,0,0,0,,♪ Бұл маған сәйкес келмейді
Dialogue: 0,0:01:04.29,0:01:09.59,Default,,0,0,0,,♪ Сонда да мен бұл сәттің бір-ақ рет болатынын білемін
Dialogue: 0,0:01:09.67,0:01:14.76,Default,,0,0,0,,♪ Өтпелілік бар
Dialogue: 0,0:01:14.84,0:01:17.51,Default,,0,0,0,,♪ Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:01:17.59,0:01:20.26,Default,,0,0,0,,♪ Бір күні өлгенше қанша рет болса да
Dialogue: 0,0:01:20.35,0:01:25.27,Default,,0,0,0,,♪ Осындай жағдай болса да күліп тұрмын.
Dialogue: 0,0:01:35.70,0:01:40.95,Default,,0,0,0,,♪ Мені жел ұшырып кететін сияқты
Dialogue: 0,0:01:41.03,0:01:46.08,Default,,0,0,0,,♪ Амалсыз тамақ ішу
Dialogue: 0,0:01:46.16,0:01:51.34,Default,,0,0,0,,♪ Кәдімгі қоңырау үні мен терезенің жанына үйілген шаң
Dialogue: 0,0:01:51.42,0:01:56.63,Default,,0,0,0,,♪ Тіпті сыныптың иісі де
Dialogue: 0,0:01:56.72,0:01:59.22,Default,,0,0,0,,♪ Мен сені ешқашан ұмытпаймын
Dialogue: 0,0:01:59.30,0:02:01.76,Default,,0,0,0,,♪ Бір күні өлгенше қанша рет болса да
Dialogue: 0,0:02:01.85,0:02:07.27,Default,,0,0,0,,♪ Осындай жағдай болса да, күлме.
Dialogue: 0,0:02:21.53,0:02:22.78,Default,,0,0,0,,(Орындау аяқталады)
Dialogue: 0,0:02:23.20,0:02:26.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:27.04,0:02:28.83,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:02:28.92,0:02:31.42,Default,,0,0,0,,Бірінші ән «Ұмытпаймын»
Dialogue: 0,0:02:33.50,0:02:35.09,Default,,0,0,0,,Таңқаларлықтай қызықты
Dialogue: 0,0:02:35.17,0:02:36.55,Default,,0,0,0,,Кита-чан!
Dialogue: 0,0:02:36.63,0:02:37.42,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:02:40.22,0:02:42.14,Default,,0,0,0,,Олай болса, келесі әннің алдында.
Dialogue: 0,0:02:42.72,0:02:46.47,Default,,0,0,0,,Менің атым Койка Иджичи, арқан байлау жетекшісі және барабаншы.
Dialogue: 0,0:02:46.56,0:02:48.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:48.77,0:02:50.73,Default,,0,0,0,,Барлықтарыңызбен танысқаныма қуаныштымын!
Dialogue: 0,0:02:50.81,0:02:52.27,Default,,0,0,0,,Көңілдісіз бе?
Dialogue: 0,0:02:52.36,0:02:55.57,Default,,0,0,0,,Сіз қатты тырысып жатырсыз.
Dialogue: 0,0:02:55.65,0:02:56.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:57.07,0:02:59.15,Default,,0,0,0,,Бірақ Бокчи-чан...
Dialogue: 0,0:02:59.24,0:03:00.66,Default,,0,0,0,,Бассист Рио Ямада (Хошика) дейді?
Dialogue: 0,0:03:01.28,0:03:04.58,Default,,0,0,0,,MC кабельдік байланыстарды жалықтыратын сияқты.
Dialogue: 0,0:03:04.66,0:03:06.79,Default,,0,0,0,,«Қай ауыз?» Мен таң қалдым.
Dialogue: 0,0:03:06.87,0:03:08.66,Default,,0,0,0,,Қызықты әңгімелер болғанша
Dialogue: 0,0:03:08.75,0:03:10.79,Default,,0,0,0,,Мен жай ғана тікелей эфирде хабарландырулар жасаймын~
Dialogue: 0,0:03:10.87,0:03:11.67,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:11.75,0:03:15.50,Default,,0,0,0,,Сонымен... Менің келесі тікелей эфирге әлі жоспарым жоқ.
Dialogue: 0,0:03:15.59,0:03:17.88,Default,,0,0,0,,Егер біреуді қызықтырса
Dialogue: 0,0:03:17.96,0:03:18.76,Default,,0,0,0,,Вокалист Кита Чан...
Dialogue: 0,0:03:18.84,0:03:19.97,Default,,0,0,0,,Кита-чан!
Dialogue: 0,0:03:20.05,0:03:22.80,Default,,0,0,0,,Гитарист... Ах, Гото Хитори-чан.
Dialogue: 0,0:03:22.89,0:03:24.43,Default,,0,0,0,,Келесі жолы сәлемдесуіңізді өтінемін!
Dialogue: 0,0:03:24.51,0:03:26.10,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:03:26.18,0:03:27.68,Default,,0,0,0,,Жалғыз!
Dialogue: 0,0:03:28.52,0:03:30.77,Default,,0,0,0,,Олай болса, келесі әнге көшейік.
Dialogue: 0,0:03:30.85,0:03:31.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:32.65,0:03:34.06,Default,,0,0,0,,Енді тыңдаңыз.
Dialogue: 0,0:03:34.69,0:03:37.07,Default,,0,0,0,,Екінші ән – «Шұлдыздар болсаң»
Dialogue: 0,0:03:39.78,0:03:40.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:45.37,0:03:50.04,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:04:05.05,0:04:08.47,Default,,0,0,0,,♪ Сағат 6-ға таяп қалды
Dialogue: 0,0:04:08.97,0:04:11.93,Default,,0,0,0,,♪ Бірінші жұлдыз қазірдің өзінде бар
Dialogue: 0,0:04:12.52,0:04:14.27,Default,,0,0,0,,♪ Көлеңкеге қадам басу
Dialogue: 0,0:04:14.35,0:04:20.40,Default,,0,0,0,,♪ Үйге бара жатқанда түнде жоғалып кеткім келеді
Dialogue: 0,0:04:21.44,0:04:22.99,Default,,0,0,0,,Бұл әлі біртүрлі
Dialogue: 0,0:04:24.70,0:04:27.16,Default,,0,0,0,,Күні кешеге дейін ештеңе болған жоқ.
Dialogue: 0,0:04:27.24,0:04:29.70,Default,,0,0,0,,1-ші және 2-ші жолдар әдеттен тыс күйде.
Dialogue: 0,0:04:30.29,0:04:37.21,Default,,0,0,0,,♪ «Жоқ, мен әрқашан жалғыз боламын».
Dialogue: 0,0:04:37.71,0:04:41.63,Default,,0,0,0,,♪ Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 0,0:04:41.71,0:04:42.63,Default,,0,0,0,,♪ Жұлдызды түн...
Dialogue: 0,0:04:42.72,0:04:44.38,Default,,0,0,0,,Бірінші жол!
Dialogue: 0,0:04:44.47,0:04:48.01,Default,,0,0,0,,Нашар! Кем дегенде 2-ші жолды баптаңыз ...
Dialogue: 0,0:04:48.10,0:04:50.51,Default,,0,0,0,,Әй, қазық сынды!
Dialogue: 0,0:04:50.60,0:04:53.31,Default,,0,0,0,,Бұл екінші жолды жарамсыз етеді.
Dialogue: 0,0:04:53.39,0:04:55.02,Default,,0,0,0,,Сіз мұнымен жалғыз бола алмайсыз.
Dialogue: 0,0:04:55.69,0:04:58.65,Default,,0,0,0,,Не істеуім керек... Жақында Соло келеді
Dialogue: 0,0:04:58.73,0:05:00.98,Default,,0,0,0,,Бағалы мектеп фестивалі тікелей эфирде
Dialogue: 0,0:05:01.07,0:05:03.61,Default,,0,0,0,,Менің құрал-жабдықтағы ақаулар
Dialogue: 0,0:05:03.69,0:05:05.15,Default,,0,0,0,,Не істеуім керек? Мен не істеуім керек...
Dialogue: 0,0:05:05.24,0:05:06.66,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:05:06.74,0:05:11.08,Default,,0,0,0,,♪ Қанша тамсандырсам да
Dialogue: 0,0:05:14.58,0:05:18.13,Default,,0,0,0,,Кита-сан...Кездесуіміз болмаса да импровизация жасадым!
Dialogue: 0,0:05:19.00,0:05:20.25,Default,,0,0,0,,Барлығына көрсетіңіз
Dialogue: 0,0:05:20.84,0:05:24.38,Default,,0,0,0,,Гото мырза шынымен керемет.
Dialogue: 0,0:05:25.34,0:05:28.89,Default,,0,0,0,,(Бір адамның жеке орындауы)
Dialogue: 0,0:05:28.97,0:05:30.72,Default,,0,0,0,,Бұл гитара не істеп тұр?
Dialogue: 0,0:05:30.81,0:05:33.02,Default,,0,0,0,,Мен оны шынымен түсінбеймін, бірақ бұл керемет!
Dialogue: 0,0:05:33.10,0:05:36.89,Default,,0,0,0,,Сіз әдетте осы соңғы минутта тығырықтан шығу техникасын жасайсыз ба?
Dialogue: 0,0:05:36.98,0:05:40.23,Default,,0,0,0,,Егер солай болса, оның үндеспейтіні маңызды емес.
Dialogue: 0,0:05:40.73,0:05:46.15,Default,,0,0,0,,♪ Алыста кездесіп қалдық
Dialogue: 0,0:05:48.66,0:05:54.08,Default,,0,0,0,,♪ Бұл карма болғандықтан, біз қайта-қайта кездесеміз.
Dialogue: 0,0:05:55.87,0:05:58.71,Default,,0,0,0,,♪ Бұлттардың арасындағы аралықта
Dialogue: 0,0:06:00.67,0:06:04.51,Default,,0,0,0,,♪ Сенімен жиналып, шоқжұлдыз болып кетсем
Dialogue: 0,0:06:04.59,0:06:08.80,Default,,0,0,0,,♪ Түнді жайып, аспанның суретін салайық
Dialogue: 0,0:06:09.55,0:06:16.35,Default,,0,0,0,,♪ Қараңғылықты нұрландыратын толық ай болмаса да
Dialogue: 0,0:06:16.43,0:06:20.23,Default,,0,0,0,,♪ Сол себепті мен де қосылып, шоқжұлдыз болғым келеді.
Dialogue: 0,0:06:20.31,0:06:24.53,Default,,0,0,0,,♪ Түрлі-түсті жарық шыққан сияқты
Dialogue: 0,0:06:25.11,0:06:28.90,Default,,0,0,0,,♪ Қосылған сызықтарды аша алмаймын
Dialogue: 0,0:06:28.99,0:06:33.70,Default,,0,0,0,,♪ Қаншалықты тамсандыратын болсаң да
Dialogue: 0,0:06:47.01,0:06:52.30,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:06:58.98,0:07:05.44,Default,,0,0,0,,(Жалғыз тыныс алу)
Dialogue: 0,0:07:17.41,0:07:20.00,Default,,0,0,0,,Ах~ Мм...
Dialogue: 0,0:07:20.08,0:07:23.83,Default,,0,0,0,,Негізі мен соңғы әнді жалғастырғалы жатырмын.
Dialogue: 0,0:07:24.88,0:07:26.92,Default,,0,0,0,,Осыны айтайын!
Dialogue: 0,0:07:27.71,0:07:30.30,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет!
Dialogue: 0,0:07:30.38,0:07:31.93,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:07:32.01,0:07:34.22,Default,,0,0,0,,Бұл күннің өмірі әркімнің болашағы
Dialogue: 0,0:07:34.30,0:07:36.47,Default,,0,0,0,,Біз мақтанатын топ боламыз!
Dialogue: 0,0:07:36.56,0:07:37.56,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:37.64,0:07:39.14,Default,,0,0,0,,Будоканға барайық!
Dialogue: 0,0:07:39.23,0:07:41.94,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:07:42.02,0:07:43.31,Default,,0,0,0,,Ах (Кита) Аха
Dialogue: 0,0:07:43.40,0:07:45.36,Default,,0,0,0,,Жіп үзілді, бірақ сен барыңды салдың!
Dialogue: 0,0:07:45.44,0:07:46.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.19,0:07:50.07,Default,,0,0,0,,Қараңызшы, Гото мырза, мен бірдеңе айтуым керек.
Dialogue: 0,0:07:50.15,0:07:50.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.90,0:07:54.24,Default,,0,0,0,,Фуфу аа аа аа уф...
Dialogue: 0,0:07:54.32,0:07:55.70,Default,,0,0,0,,Co… Коммунизм бұл
Dialogue: 0,0:07:55.78,0:07:58.37,Default,,0,0,0,,Алдын ала сценарий дайындамайынша сөйлей алмаймын.
Dialogue: 0,0:07:59.16,0:08:01.37,Default,,0,0,0,,Егер біреу күтпеген жерден кейіп танытса...
Dialogue: 0,0:08:01.46,0:08:04.33,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:08:04.42,0:08:07.59,Default,,0,0,0,,Қызық бірдеңе Қызық бірдеңе...
Dialogue: 0,0:08:07.67,0:08:11.13,Default,,0,0,0,,Бірдеңе... қызық...
Dialogue: 0,0:08:11.22,0:08:12.17,Default,,0,0,0,,Mr. Goto?
Dialogue: 0,0:08:12.26,0:08:13.80,Default,,0,0,0,,Хехехе хехе
Dialogue: 0,0:08:15.51,0:08:16.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.51,0:08:17.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.68,0:08:19.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.39,0:08:20.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:20.35,0:08:21.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:27.31,0:08:28.23,Default,,0,0,0,,(Сузуя) Адамдар әрдайым бір жерде өліп жатады ғой, иә?
Dialogue: 0,0:08:34.70,0:08:35.70,Default,,0,0,0,,Кя~! (Кита) Гото мырза!
Dialogue: 0,0:08:35.78,0:08:37.16,Default,,0,0,0,,Бокчи-чан, жақсысың ба?
Dialogue: 0,0:08:37.24,0:08:39.74,Default,,0,0,0,,Сіз аңызға айналған рок жұлдызысыз
Dialogue: 0,0:08:39.83,0:08:42.25,Default,,0,0,0,,Хахаха Ах, Бокчи-чан ең жақсы!
Dialogue: 0,0:08:42.33,0:08:43.83,Default,,0,0,0,,Сәл уайымдаңыз!
Dialogue: 0,0:08:43.91,0:08:44.96,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:08:45.54,0:08:46.63,Default,,0,0,0,,Зембілді әкел!
Dialogue: 0,0:08:46.71,0:08:48.63,Default,,0,0,0,,Жалғыз! Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:48.71,0:08:50.55,Default,,0,0,0,,Менің әпкем кешіріңіз.
Dialogue: 0,0:08:50.63,0:08:52.42,Default,,0,0,0,,Ах~ Жоқ, жоқ.
Dialogue: 0,0:08:52.51,0:08:53.34,Default,,0,0,0,,Күшік
Dialogue: 0,0:08:53.42,0:08:54.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.38,0:08:57.39,Default,,0,0,0,,Бітті...
Dialogue: 0,0:09:02.31,0:09:05.56,Default,,0,0,0,,Гото мырза, амансыз ба? Сіз ояндыңыз ба?
Dialogue: 0,0:09:07.31,0:09:08.48,Default,,0,0,0,,А... иә
Dialogue: 0,0:09:09.19,0:09:10.65,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:09:10.73,0:09:12.94,Default,,0,0,0,,Жарақат үлкен мәселе болмаған сияқты.
Dialogue: 0,0:09:13.03,0:09:13.61,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:13.69,0:09:14.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.82,0:09:18.16,Default,,0,0,0,,Бұзғаным үшін кешірім сұраймын.
Dialogue: 0,0:09:18.24,0:09:19.24,Default,,0,0,0,,Бұл жақсы нәрсе...
Dialogue: 0,0:09:19.33,0:09:22.62,Default,,0,0,0,,Жоқ, қандай да бір себептермен менің көңілім көтерілген болар.
Dialogue: 0,0:09:22.70,0:09:23.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:24.75,0:09:26.75,Default,,0,0,0,,Ах, Ниджика-чан және басқалары?
Dialogue: 0,0:09:26.83,0:09:28.38,Default,,0,0,0,,Қазіргі уақытта тазалау
Dialogue: 0,0:09:28.46,0:09:31.71,Default,,0,0,0,,Гото мырза, жақсы болса, осыдан кейін ұшыруға барайық.
Dialogue: 0,0:09:31.80,0:09:33.80,Default,,0,0,0,,Бірақ бұл мүмкін емес болып көрінсе, келесі жолы әрекетті қайталаңыз.
Dialogue: 0,0:09:33.88,0:09:35.34,Default,,0,0,0,,Камадо!
Dialogue: 0,0:09:35.42,0:09:37.22,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:09:37.30,0:09:37.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:38.39,0:09:41.56,Default,,0,0,0,,Кита-сан, сен оны білмей тұрып жақсы болып кеттің.
Dialogue: 0,0:09:41.64,0:09:42.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.06,0:09:46.64,Default,,0,0,0,,Тек тірек.
Dialogue: 0,0:09:48.23,0:09:49.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:50.02,0:09:51.02,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:09:51.11,0:09:53.90,Default,,0,0,0,,Мен адамдарды қызықтыратындай өнер көрсете алмаймын.
Dialogue: 0,0:09:53.98,0:09:54.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:55.49,0:09:59.32,Default,,0,0,0,,Бірақ сіз бәрімен тіл табыса алатын сияқтысыз.
Dialogue: 0,0:10:00.41,0:10:03.41,Default,,0,0,0,,Мен гитарада көп жұмыс істеймін, сондықтан маған хабарлаңыз.
Dialogue: 0,0:10:03.91,0:10:05.29,Default,,0,0,0,,Өту...
Dialogue: 0,0:10:06.37,0:10:07.16,Default,,0,0,0,,Хитори-чан
Dialogue: 0,0:10:07.25,0:10:09.17,Default,,0,0,0,,А, ә... А, иә!
Dialogue: 0,0:10:09.25,0:10:12.13,Default,,0,0,0,,Ендеше, әрі қарай жүрейік. Дайын болған кезде кел.
Dialogue: 0,0:10:12.21,0:10:13.50,Default,,0,0,0,,А... иә
Dialogue: 0,0:10:14.80,0:10:16.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.01,0:10:18.51,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:10:27.43,0:10:31.52,Default,,0,0,0,,Мен Хитори-чанға қолдау көрсете аламын.
Dialogue: 0,0:10:32.36,0:10:32.94,Default,,0,0,0,,Енді...
Dialogue: 0,0:10:33.02,0:10:37.19,Default,,0,0,0,,Launch Launch♪ (Нижика) Бокчи Чан жақсы ма?
Dialogue: 0,0:10:37.28,0:10:39.11,Default,,0,0,0,,Мәдени фестиваль аяқталды
Dialogue: 0,0:10:49.83,0:10:51.13,Default,,0,0,0,,А, сүңгуір.
Dialogue: 0,0:10:51.21,0:10:51.92,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:10:52.00,0:10:54.42,Default,,0,0,0,,О, рок жігіті ме?
Dialogue: 0,0:10:57.63,0:10:58.34,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:10:59.63,0:11:02.14,Default,,0,0,0,,Бір күні мен мектепті бітіремін!
Dialogue: 0,0:11:04.47,0:11:06.01,Default,,0,0,0,,Әке, кешіріңіз.
Dialogue: 0,0:11:06.10,0:11:07.64,Default,,0,0,0,,(Наокидің үрейленген дауысы)
Dialogue: 0,0:11:07.73,0:11:10.60,Default,,0,0,0,,Сіздің әпкеңіз не істеп жатыр? Уф уф!
Dialogue: 0,0:11:10.69,0:11:12.23,Default,,0,0,0,,Гитара әкемнен алынған
Dialogue: 0,0:11:12.31,0:11:14.40,Default,,0,0,0,,Мен оны тірі орындау кезінде бұздым.
Dialogue: 0,0:11:14.48,0:11:15.94,Default,,0,0,0,,Жоғары қара!
Dialogue: 0,0:11:16.02,0:11:18.40,Default,,0,0,0,,Әке, мен мүлдем ашуланбаймын, жарай ма?
Dialogue: 0,0:11:18.49,0:11:22.41,Default,,0,0,0,,Бұл жәй ғана сынған қазық, солай ма? Бұл туралы уайымдаудың қажеті жоқ
Dialogue: 0,0:11:22.49,0:11:23.24,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:23.32,0:11:25.62,Default,,0,0,0,,Ал сіз оны тірі орындау кезінде бұздыңыз ба?
Dialogue: 0,0:11:25.70,0:11:27.74,Default,,0,0,0,,Әкем толқыған сияқты.
Dialogue: 0,0:11:27.83,0:11:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.79,0:11:32.08,Default,,0,0,0,,Олар қазір «тек жоюға арналған гитара» деп аталатын нәрсені сататын сияқты.
Dialogue: 0,0:11:32.17,0:11:33.71,Default,,0,0,0,,Мұны келесі тікелей эфирде орындаңыз.
Dialogue: 0,0:11:33.79,0:11:36.30,Default,,0,0,0,,Қызыңызды қай бағытқа апарғыңыз келеді...
Dialogue: 0,0:11:36.88,0:11:39.63,Default,,0,0,0,,Бұл да жақсы мүмкіндік, мен гитараммен жалғыз адаммын.
Dialogue: 0,0:11:39.72,0:11:41.05,Default,,0,0,0,,Неліктен оны сатып алмасқа? Ойнайық~
Dialogue: 0,0:11:41.13,0:11:43.55,Default,,0,0,0,,Әй, бұл жақсы емес пе? Эй, әке.
Dialogue: 0,0:11:43.64,0:11:45.22,Default,,0,0,0,,Осындай қиыншылыққа тап болған кезде
Dialogue: 0,0:11:45.30,0:11:47.10,Default,,0,0,0,,Бірден жауап беру мүмкіндігі
Dialogue: 0,0:11:47.81,0:11:50.27,Default,,0,0,0,,Жоқ, бірақ менің толық емес жұмыс күнім бар.
Dialogue: 0,0:11:50.35,0:11:53.10,Default,,0,0,0,,Мұндай ақша тірі орындау квотасына байланысты жоғалады...
Dialogue: 0,0:11:53.19,0:11:54.44,Default,,0,0,0,,Жарайды! Ах...
Dialogue: 0,0:11:54.52,0:11:55.73,Default,,0,0,0,,Ақша бар!
Dialogue: 0,0:11:55.81,0:11:56.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:57.48,0:12:01.74,Default,,0,0,0,,Нана... Не? Бұл үлкен ақша, әке, қара базар...
Dialogue: 0,0:12:01.82,0:12:02.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.40,0:12:05.16,Default,,0,0,0,,Міне... Мен мұндай қара ақшаны қабылдай алмаймын.
Dialogue: 0,0:12:05.24,0:12:07.20,Default,,0,0,0,,Біз соншалықты шұғыл емеспіз!
Dialogue: 0,0:12:07.91,0:12:12.71,Default,,0,0,0,,Бұл бір адамның бейне жарнамасынан түскен табысы.
Dialogue: 0,0:12:13.29,0:12:13.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.92,0:12:16.92,Default,,0,0,0,,Көрулердің белгілі бір санын алсаңыз, сізге ақы төленеді.
Dialogue: 0,0:12:17.42,0:12:18.17,Default,,0,0,0,,А...
Dialogue: 0,0:12:18.25,0:12:19.92,Default,,0,0,0,,Бейне сайтының тіркелгісі
Dialogue: 0,0:12:20.01,0:12:22.38,Default,,0,0,0,,Сіз бұл отбасылық екенін ұмытып қалдыңыз.
Dialogue: 0,0:12:23.18,0:12:24.93,Default,,0,0,0,,Содан кейін менің бейнем...
Dialogue: 0,0:12:25.01,0:12:27.93,Default,,0,0,0,,Әрине, мен білемін, Гитара батыры, солай ма?
Dialogue: 0,0:12:28.68,0:12:30.27,Default,,0,0,0,,Қарау саны айтарлықтай көп болды.
Dialogue: 0,0:12:30.35,0:12:33.10,Default,,0,0,0,,Әке, мен жасырын жарнама қостым.
Dialogue: 0,0:12:33.19,0:12:35.81,Default,,0,0,0,,Менің қызым өте дәмді!
Dialogue: 0,0:12:36.56,0:12:40.07,Default,,0,0,0,,Бір күні маған осындай нәрсе керек шығар деп ойладым.
Dialogue: 0,0:12:40.65,0:12:42.11,Default,,0,0,0,,Жалғыз жаттығыңыз, бар күшіңізді салыңыз
Dialogue: 0,0:12:42.19,0:12:44.70,Default,,0,0,0,,Мен өзімнің орындау процесінің жақсарғанын және жақсырақ болғанын көре алдым.
Dialogue: 0,0:12:44.78,0:12:46.70,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:12:47.20,0:12:48.70,Default,,0,0,0,,Сәлем? анам
Dialogue: 0,0:12:48.78,0:12:49.37,Default,,0,0,0,,Иә
Dialogue: 0,0:12:50.12,0:12:52.91,Default,,0,0,0,,Мама, мен музыканы мүлдем түсінбеймін.
Dialogue: 0,0:12:53.00,0:12:55.17,Default,,0,0,0,,Мен сені жақсы деп ойладым.
Dialogue: 0,0:12:56.00,0:12:58.46,Default,,0,0,0,,Әке Ана...
Dialogue: 0,0:12:58.54,0:13:00.46,Default,,0,0,0,,Жақсы, пропорционалды түрде
Dialogue: 0,0:13:00.55,0:13:02.30,Default,,0,0,0,,Өтірік айтудың шебері болу процесі
Dialogue: 0,0:13:02.38,0:13:03.92,Default,,0,0,0,,Әке, мен мұңайып қалдым.
Dialogue: 0,0:13:04.01,0:13:05.22,Default,,0,0,0,,Құсу!
Dialogue: 0,0:13:08.22,0:13:10.68,Default,,0,0,0,,300 000...
Dialogue: 0,0:13:11.22,0:13:15.10,Default,,0,0,0,,Мен мұндай күтпеген жерден күтпеген едім.
Dialogue: 0,0:13:16.19,0:13:20.15,Default,,0,0,0,,Егер сіз шамамен 100 000 иенге гитара сатып алсаңыз, сізде 200 000 иен қалады...
Dialogue: 0,0:13:21.28,0:13:23.19,Default,,0,0,0,,Қалғанын квотаңызға қолдансаңыз,
Dialogue: 0,0:13:23.28,0:13:26.03,Default,,0,0,0,,Мен екі жылға жуық толық емес жұмыс күнінсіз тікелей эфирде орындай аламын!
Dialogue: 0,0:13:26.11,0:13:28.95,Default,,0,0,0,,Жақсы! Толық емес жұмыс уақытын доғарайық!
Dialogue: 0,0:13:32.16,0:13:35.29,Default,,0,0,0,,Бүгін Бокчи-чан үнемі жарқырап тұрады.
Dialogue: 0,0:13:35.37,0:13:37.92,Default,,0,0,0,,Көзіміз түйіскен сайын бас иеді.
Dialogue: 0,0:13:38.75,0:13:39.46,Default,,0,0,0,,Ах
Dialogue: 0,0:13:40.79,0:13:41.67,Default,,0,0,0,,Аха…
Dialogue: 0,0:13:42.55,0:13:44.09,Default,,0,0,0,,Егер сіз толық емес жұмыс күнін тоқтата аламын деп ойласаңыз
Dialogue: 0,0:13:44.17,0:13:46.84,Default,,0,0,0,,Жұмбақ күш шексіз пайда болады!
Dialogue: 0,0:13:47.59,0:13:49.89,Default,,0,0,0,,Дүкен менеджерімен сөйлесейік!
Dialogue: 0,0:13:50.47,0:13:53.14,Default,,0,0,0,,Ахх! (Кемпірқосақ жазы) Супер супер Бокчи-чан?
Dialogue: 0,0:13:53.22,0:13:55.06,Default,,0,0,0,,А? Толық емес жұмысыңыз қандай?
Dialogue: 0,0:13:55.73,0:13:58.48,Default,,0,0,0,,Ах, мм...
Dialogue: 0,0:13:58.56,0:14:02.23,Default,,0,0,0,,Мен жан-тәніммен жұмыс істеймін...
Dialogue: 0,0:14:02.32,0:14:04.36,Default,,0,0,0,,Неліктен айқындықтың кенеттен жариялануы?
Dialogue: 0,0:14:04.44,0:14:08.07,Default,,0,0,0,,Толық емес жұмыс күнін тоқтатудың ең қиын бөлігі - шығу туралы шешім қабылдау.
Dialogue: 0,0:14:08.16,0:14:09.07,Default,,0,0,0,,Бэкре...
Dialogue: 0,0:14:09.16,0:14:11.28,Default,,0,0,0,,Жоқ, жоқ, менің мекенжайым құлыптаулы...
Dialogue: 0,0:14:11.37,0:14:13.58,Default,,0,0,0,,Бұл барлығына жай ғана кедергі емес.
Dialogue: 0,0:14:13.66,0:14:16.83,Default,,0,0,0,,Бокчи-чан, сен бүгін музыкалық аспаптар дүкеніне барасың ба?
Dialogue: 0,0:14:16.91,0:14:17.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:17.83,0:14:21.04,Default,,0,0,0,,Дүкен менеджеріне бірдеңе берсеңіз, оның жұмыстан шығуына рұқсат беруіңіз мүмкін.
Dialogue: 0,0:14:21.13,0:14:22.84,Default,,0,0,0,,Менде қазір көп ақша бар!
Dialogue: 0,0:14:22.92,0:14:24.42,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:14:24.50,0:14:28.22,Default,,0,0,0,,Менеджердің қазір не қалайтынын айта аласыз ба?
Dialogue: 0,0:14:28.30,0:14:29.80,Default,,0,0,0,,Бұл Бокчи Чан.
Dialogue: 0,0:14:30.30,0:14:33.35,Default,,0,0,0,,Менің әпкемнің туған күні жақындап қалды, мүмкін бұл сыйлық шығар?
Dialogue: 0,0:14:33.93,0:14:34.60,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:14:35.35,0:14:36.31,Default,,0,0,0,,«Маған бұл қажет емес»
Dialogue: 0,0:14:36.39,0:14:37.23,Default,,0,0,0,,Ugaa
Dialogue: 0,0:14:37.31,0:14:38.06,Default,,0,0,0,,Бітті...
Dialogue: 0,0:14:38.14,0:14:39.06,Default,,0,0,0,,Мен Бокчимін
Dialogue: 0,0:14:39.14,0:14:40.90,Default,,0,0,0,,Дингволл мен Ле Фэйдің жаңа басы жоқ
Dialogue: 0,0:14:40.98,0:14:42.98,Default,,0,0,0,,Мен Darkglass күшейткіш басын алғым келеді.
Dialogue: 0,0:14:43.07,0:14:45.73,Default,,0,0,0,,Бәрің, мен музыкалық аспаптар дүкеніне барамын.
Dialogue: 0,0:14:45.82,0:14:47.24,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:47.32,0:14:49.24,Default,,0,0,0,,Қош келдіңіз (Хошика) Бокчи-чан, сіз өте мейірімдісіз...
Dialogue: 0,0:14:50.32,0:14:52.57,Default,,0,0,0,,Бірақ мен тосын адаммын.
Dialogue: 0,0:14:52.66,0:14:53.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.79,0:14:58.83,Default,,0,0,0,,Музыкалық аспаптар дүкендеріне келетін болсақ, бұл сөзсіз Ochanomizu.
Dialogue: 0,0:14:58.91,0:15:00.42,Default,,0,0,0,,Сәлем, Хитори-чан
Dialogue: 0,0:15:00.50,0:15:03.42,Default,,0,0,0,,Неліктен музыкалық аспаптар дүкендері көп?
Dialogue: 0,0:15:03.50,0:15:04.92,Default,,0,0,0,,Олар келеді—тіпті менің есігімнің алдына дейін.
Dialogue: 0,0:15:05.42,0:15:06.00,Default,,0,0,0,,Мэйдзи дәуірінде
Dialogue: 0,0:15:06.09,0:15:09.22,Default,,0,0,0,,Жапонияның ең көне кәсіби оркестрі құрылғаннан бері
Dialogue: 0,0:15:09.30,0:15:11.01,Default,,0,0,0,,Токиода музыкалық белсенділік өркендеуде.
Dialogue: 0,0:15:11.09,0:15:13.85,Default,,0,0,0,,Сол кезде Очаномизуда қазір бұрыннан қалыптасқан дүкен деп аталатын Шимокура музыкалық аспаптары құрылды.
Dialogue: 0,0:15:13.93,0:15:15.43,Default,,0,0,0,,Ишибаши музыкалық аспабы жасалды, мен қатты қуандым...
Dialogue: 0,0:15:15.51,0:15:17.64,Default,,0,0,0,,Мен бүгін қиналатын сияқтымын.
Dialogue: 0,0:15:18.31,0:15:20.73,Default,,0,0,0,,Кірейік! Өнімдердің жақсы таңдауы
Dialogue: 0,0:15:20.81,0:15:22.85,Default,,0,0,0,,Мен кіргім келмейді...
Dialogue: 0,0:15:23.40,0:15:26.82,Default,,0,0,0,,Мен шынымен онлайн тапсырыс беруді ойладым.
Dialogue: 0,0:15:26.90,0:15:31.03,Default,,0,0,0,,Интернет-сауда сайттары жақсы, бірақ таңдау жасамас бұрын оны сынап көрген дұрыс.
Dialogue: 0,0:15:31.11,0:15:32.20,Default,,0,0,0,,Иә
Dialogue: 0,0:15:33.03,0:15:35.12,Default,,0,0,0,,Музыкалық дүкен қызметкерлері қорқынышты сияқты.
Dialogue: 0,0:15:35.20,0:15:37.24,Default,,0,0,0,,Егер сізбен біреу сөйлессе...
Dialogue: 0,0:15:37.33,0:15:40.21,Default,,0,0,0,,Бұл гитараны таңдауда сіздің талғамыңыз керемет, солай емес пе?
Dialogue: 0,0:15:40.29,0:15:40.91,Default,,0,0,0,,А...
Dialogue: 0,0:15:41.00,0:15:44.54,Default,,0,0,0,,Сіз батыс музыкасын тыңдайсыз ба? Әй, тыңдамайсың ба? Мен сені өлтіремін!
Dialogue: 0,0:15:44.63,0:15:46.55,Default,,0,0,0,,А-а-а~
Dialogue: 0,0:15:46.63,0:15:48.84,Default,,0,0,0,,Мен... Құлаққапты тағып алып, қағып тұрғандай кейіп таныта аламын.
Dialogue: 0,0:15:48.92,0:15:50.30,Default,,0,0,0,,Ол сізбен сөйлеспеуі керек.
Dialogue: 0,0:15:53.26,0:15:54.18,Default,,0,0,0,,Те... Менеджер
Dialogue: 0,0:15:54.26,0:15:56.64,Default,,0,0,0,,Біздің дүкенге таңғажайып қыз келді!
Dialogue: 0,0:15:56.72,0:15:58.56,Default,,0,0,0,,Қатты металл желдеткіш болуы керек!
Dialogue: 0,0:15:58.64,0:16:00.02,Default,,0,0,0,,Ха ха ха... (Сатушы) Тұтынушы!
Dialogue: 0,0:16:00.10,0:16:02.23,Default,,0,0,0,,Егер сіз металға бағытталған гитара іздесеңіз, екінші қабатты қараңыз...
Dialogue: 0,0:16:02.31,0:16:02.81,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:16:04.06,0:16:06.52,Default,,0,0,0,,Мына бау сүйкімді!
Dialogue: 0,0:16:06.61,0:16:09.40,Default,,0,0,0,,Бұл түс Кита-чанның гитарасына сай емес пе?
Dialogue: 0,0:16:10.78,0:16:14.32,Default,,0,0,0,,Уау~ Таңдаудың көптеген түрлері бар.
Dialogue: 0,0:16:14.41,0:16:16.49,Default,,0,0,0,,Оны сырға жасауым керек пе?
Dialogue: 0,0:16:16.58,0:16:17.49,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:16:17.58,0:16:18.45,Default,,0,0,0,,Тұтынушыға не болады?
Dialogue: 0,0:16:18.54,0:16:20.41,Default,,0,0,0,,Осыдан кейін қолдан жасалған дүкенге барғыңыз келе ме?
Dialogue: 0,0:16:20.50,0:16:22.29,Default,,0,0,0,,Аа, мен оны жаңа ғана қарап шықтым және (қызметші) бұл клиент~!
Dialogue: 0,0:16:22.37,0:16:24.46,Default,,0,0,0,,Жақын жерде жақсы дәмхана бар...
Dialogue: 0,0:16:25.04,0:16:26.21,Default,,0,0,0,,Музыкалық аспаптар Қараңызшы!
Dialogue: 0,0:16:29.34,0:16:32.51,Default,,0,0,0,,Кешіріңіз, бұл бассты сынап көру мүмкін бе?
Dialogue: 0,0:16:32.59,0:16:34.09,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:34.68,0:16:36.80,Default,,0,0,0,,Сенпай, қайта сатып алмақшысың ба?
Dialogue: 0,0:16:36.89,0:16:37.85,Default,,0,0,0,,Бөлек
Dialogue: 0,0:16:37.93,0:16:40.39,Default,,0,0,0,,Мен оны жеңіл ойнағым келеді, өйткені мен аздап қызықпын.
Dialogue: 0,0:16:41.14,0:16:43.19,Default,,0,0,0,,А, мен сені шапалақтай аламын ба?
Dialogue: 0,0:16:43.27,0:16:44.48,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:16:45.15,0:16:47.23,Default,,0,0,0,,Ах! Мүмкін емес! Бұл дегенмен
Dialogue: 0,0:16:47.31,0:16:48.73,Default,,0,0,0,,(Бас орындау)
Dialogue: 0,0:16:48.82,0:16:50.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:51.11,0:16:52.24,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:16:53.82,0:16:56.07,Default,,0,0,0,,О~ Бұл керемет...
Dialogue: 0,0:16:56.16,0:16:59.08,Default,,0,0,0,,Жарайды... Мен оны кездейсоқ ойнадым...
Dialogue: 0,0:16:59.16,0:17:00.91,Default,,0,0,0,,Керемет жақсы басс
Dialogue: 0,0:17:01.41,0:17:03.71,Default,,0,0,0,,Сынақ кезінде байсалды және өзін-өзі ұстайтын жігіт!
Dialogue: 0,0:17:03.79,0:17:05.29,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:07.13,0:17:08.79,Default,,0,0,0,,Не? Икуё (Кита) Иә?
Dialogue: 0,0:17:08.88,0:17:10.17,Default,,0,0,0,,Бұл гитара сізді қызықтырады ма?
Dialogue: 0,0:17:10.25,0:17:12.42,Default,,0,0,0,,Не? А, жоқ, олай емес...
Dialogue: 0,0:17:12.51,0:17:13.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.09,0:17:16.76,Default,,0,0,0,,Менде Рио-сенпайдан алған гитара бар.
Dialogue: 0,0:17:16.84,0:17:19.18,Default,,0,0,0,,Сізде қанша гитара болғаны маңызды емес.
Dialogue: 0,0:17:19.26,0:17:21.81,Default,,0,0,0,,Барлығы көңілді деп үміттенемін~
Dialogue: 0,0:17:23.10,0:17:23.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:23.89,0:17:27.77,Default,,0,0,0,,Бұл комикстерде жиі кездесетін барабаншының жалғыздық мәселесі ме?
Dialogue: 0,0:17:27.85,0:17:31.82,Default,,0,0,0,,А, мен де гитара мен бас гитара сатып алуым керек сияқты...
Dialogue: 0,0:17:31.90,0:17:33.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.11,0:17:34.78,Default,,0,0,0,,Қалыпты ойнау үшін!
Dialogue: 0,0:17:34.86,0:17:37.20,Default,,0,0,0,,Түсіндім, жалғыз болдыңыз ба?
Dialogue: 0,0:17:37.28,0:17:39.03,Default,,0,0,0,,Келесі жолы барабан мамандандырылған дүкеніне барайық!
Dialogue: 0,0:17:39.12,0:17:40.53,Default,,0,0,0,,Өйткені ол Акибада
Dialogue: 0,0:17:40.62,0:17:42.16,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:17:42.24,0:17:43.75,Default,,0,0,0,,YAMAHA мырза, бұл тамаша!
Dialogue: 0,0:17:43.83,0:17:44.45,Default,,0,0,0,,Ахии~!
Dialogue: 0,0:17:44.54,0:17:46.33,Default,,0,0,0,,Бұл реттелетін спецификация.
Dialogue: 0,0:17:46.41,0:17:49.92,Default,,0,0,0,,Бұл қол жетімді гитара, бірақ бұл керемет гитара.
Dialogue: 0,0:17:50.00,0:17:51.92,Default,,0,0,0,,Ах... Қарсы болмасаңыз, қолданып көргіңіз келе ме?
Dialogue: 0,0:17:52.00,0:17:53.30,Default,,0,0,0,,А, жоқ, мм...
Dialogue: 0,0:17:53.38,0:17:55.05,Default,,0,0,0,,Егер бұл сіздің бірінші гитарыңыз болса
Dialogue: 0,0:17:55.13,0:17:58.13,Default,,0,0,0,,Қалқан мен шағын күшейткіштің де болғаны жақсы.
Dialogue: 0,0:17:58.22,0:17:59.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:59.34,0:18:00.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:01.47,0:18:02.06,Default,,0,0,0,,Сатып алу...
Dialogue: 0,0:18:02.14,0:18:03.93,Default,,0,0,0,,Бокчи-чан, сізде бар, солай ма?
Dialogue: 0,0:18:04.02,0:18:07.06,Default,,0,0,0,,А, сен тәжірибелі адамсың! Кешіріңіз
Dialogue: 0,0:18:07.14,0:18:09.77,Default,,0,0,0,,А, жоқ, бәрі жақсы.
Dialogue: 0,0:18:09.86,0:18:12.57,Default,,0,0,0,,Бұл баланың гитарасы жақында сынып қалды.
Dialogue: 0,0:18:12.65,0:18:15.28,Default,,0,0,0,,Бүгін мен ауыстыратын машина іздеуге келдім.
Dialogue: 0,0:18:15.36,0:18:17.20,Default,,0,0,0,,Дұрыс? Хитори-чан
Dialogue: 0,0:18:17.28,0:18:18.49,Default,,0,0,0,,An An
Dialogue: 0,0:18:18.99,0:18:20.57,Default,,0,0,0,,Бұл күндері тіпті студенттер
Dialogue: 0,0:18:20.66,0:18:23.37,Default,,0,0,0,,Бірнеше көшірмелері бар адамдар бар.
Dialogue: 0,0:18:23.45,0:18:25.41,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:18:25.50,0:18:28.16,Default,,0,0,0,,Сізге бұл гитара ұнай ма? Хитори-чан
Dialogue: 0,0:18:28.25,0:18:28.96,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:18:29.04,0:18:31.00,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:18:31.50,0:18:33.25,Default,,0,0,0,,Бұл гитара қолданылатын сияқты.
Dialogue: 0,0:18:33.34,0:18:34.80,Default,,0,0,0,,Дұрыс па? Хитори-чан
Dialogue: 0,0:18:34.88,0:18:36.59,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:36.67,0:18:39.18,Default,,0,0,0,,Мен вентрилокист қуыршақ сияқтымын
Dialogue: 0,0:18:39.26,0:18:41.51,Default,,0,0,0,,Мен сені жақында есейіп қалдым деп ойладым.
Dialogue: 0,0:18:41.60,0:18:43.10,Default,,0,0,0,,Бұл салада әлі көп жол бар.
Dialogue: 0,0:18:43.93,0:18:45.06,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:18:45.64,0:18:48.98,Default,,0,0,0,,Мен бұл гитараны тексердім және ұстадым.
Dialogue: 0,0:18:49.06,0:18:49.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.02,0:18:53.44,Default,,0,0,0,,Өте жақсы жасалған, маған да ұнайды.
Dialogue: 0,0:18:53.94,0:18:57.99,Default,,0,0,0,,Бұл гитараны тұтынушыларымыз таңдағанына қуаныштымын.
Dialogue: 0,0:18:59.28,0:19:01.41,Default,,0,0,0,,Сатып алғаныңыз үшін рахмет!
Dialogue: 0,0:19:01.95,0:19:03.16,Default,,0,0,0,,А, а... (Нижика және т.б.) Иә?
Dialogue: 0,0:19:03.24,0:19:04.41,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:19:04.49,0:19:06.83,Default,,0,0,0,,Тұтынушы? Мен гитараны ұмытып қалдым!
Dialogue: 0,0:19:06.91,0:19:08.96,Default,,0,0,0,,Сіз қанша оралғыңыз келді?
Dialogue: 0,0:19:10.21,0:19:10.96,Default,,0,0,0,,Иә
Dialogue: 0,0:19:11.46,0:19:14.34,Default,,0,0,0,,Дүкен менеджері: «Дүкенге қайта келіңіз», - деді.
Dialogue: 0,0:19:14.42,0:19:17.01,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:19:17.09,0:19:19.26,Default,,0,0,0,,Жақсы гитара тапқаныңызға қуаныштымын.
Dialogue: 0,0:19:19.34,0:19:20.38,Default,,0,0,0,,Иә
Dialogue: 0,0:19:20.47,0:19:22.68,Default,,0,0,0,,Не істеу керек? Бірдеңе жеп, үйге қайтқыңыз келе ме?
Dialogue: 0,0:19:22.76,0:19:23.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:23.72,0:19:25.10,Default,,0,0,0,,Бүгін таратылады (Нижика) Иә?
Dialogue: 0,0:19:25.18,0:19:26.93,Default,,0,0,0,,Сізде бірдеңе бар ма?
Dialogue: 0,0:19:27.02,0:19:29.60,Default,,0,0,0,,Бокчи Жақын арада гитарада ойнауды бастағыңыз келеді, солай ма?
Dialogue: 0,0:19:29.68,0:19:30.64,Default,,0,0,0,,Ах (Кемпірқосақ жаз) Ah~
Dialogue: 0,0:19:30.73,0:19:31.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:31.39,0:19:34.81,Default,,0,0,0,,Қазірдің өзінде~ Екеуміз қайтадан бір-бірімізбен сөйлесіп жатқандай сезіне бастадым!
Dialogue: 0,0:19:34.90,0:19:36.78,Default,,0,0,0,,Жарайды, тынышталыңыз.
Dialogue: 0,0:19:36.86,0:19:40.03,Default,,0,0,0,,А, дұрыс! Енді студияны жалға ал.
Dialogue: 0,0:19:40.11,0:19:42.41,Default,,0,0,0,,Хитори-чанның гитарасын ашатын кеш ұйымдастырамыз ба?
Dialogue: 0,0:19:42.49,0:19:44.37,Default,,0,0,0,,Жоқ, бұл біраз...
Dialogue: 0,0:19:44.45,0:19:46.83,Default,,0,0,0,,Ал, ертең бәріміз жаттығу жасаймыз.
Dialogue: 0,0:19:46.91,0:19:48.62,Default,,0,0,0,,Сол уақытты асыға күтіңіз~
Dialogue: 0,0:19:48.70,0:19:50.08,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:19:50.16,0:19:52.25,Default,,0,0,0,,Мектеп мерекесі аяқталды.
Dialogue: 0,0:19:52.33,0:19:55.46,Default,,0,0,0,,Мен келесі тікелей эфир туралы және басқа нәрселер туралы ойлауым керек.
Dialogue: 0,0:19:55.54,0:19:56.59,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:19:56.67,0:19:58.34,Default,,0,0,0,,Рё, маған жаңа ән беріңізші!
Dialogue: 0,0:19:58.42,0:20:00.42,Default,,0,0,0,,Мұның бәрі шабыт күтуде
Dialogue: 0,0:20:00.51,0:20:04.05,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:20:04.14,0:20:04.80,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:20:04.89,0:20:06.51,Default,,0,0,0,,Кита-чан
Dialogue: 0,0:20:06.60,0:20:09.35,Default,,0,0,0,,Риоға мұндай сөздерді кездейсоқ айтпа.
Dialogue: 0,0:20:09.43,0:20:10.77,Default,,0,0,0,,Хехе, олай болса бірден жасайық.
Dialogue: 0,0:20:10.85,0:20:12.10,Default,,0,0,0,,Өзіңізді сиыр етіне арналған ыдыспен сыйлаңыз
Dialogue: 0,0:20:13.48,0:20:15.15,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:20:15.23,0:20:17.65,Default,,0,0,0,,Асықпасаң, кешігіп қаласың~
Dialogue: 0,0:20:18.57,0:20:20.07,Default,,0,0,0,,Хааа~
Dialogue: 0,0:20:21.49,0:20:24.36,Default,,0,0,0,,Ух-хэ-хэ... тамаша
Dialogue: 0,0:20:26.16,0:20:26.66,Default,,0,0,0,,Ах
Dialogue: 0,0:20:27.45,0:20:28.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:28.24,0:20:31.66,Default,,0,0,0,,Ах... Кешіріңіз! Мен... мен де сені ұмытқан жоқпын!
Dialogue: 0,0:20:31.75,0:20:33.21,Default,,0,0,0,,Ю... өтінемін, мені кешіріңіз!
Dialogue: 0,0:20:33.71,0:20:35.92,Default,,0,0,0,,Әлгі қыз тағы... (Наоки) Ах...
Dialogue: 0,0:20:36.00,0:20:36.88,Default,,0,0,0,,Coon
Dialogue: 0,0:20:43.88,0:20:45.14,Default,,0,0,0,,I'm going
Dialogue: 0,0:20:45.22,0:20:48.47,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:20:51.73,0:20:53.73,Default,,0,0,0,,♪~
Dialogue: 0,0:23:19.62,0:23:21.62,Default,,0,0,0,,~♪
