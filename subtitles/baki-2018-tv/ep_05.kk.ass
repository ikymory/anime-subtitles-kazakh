Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.17,0:00:18.18,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.76,0:01:44.93,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:00.70,0:02:01.78,Default,,0,0,0,,Баки-кун
Dialogue: 0,0:02:02.91,0:02:08.46,Default,,0,0,0,,Стадионның дәлізінде сен маған не істегенсің деп ойлаймын.
Dialogue: 0,0:02:09.75,0:02:13.59,Default,,0,0,0,,Жақында ең үлкен турнирдің екінші кезеңі басталады!
Dialogue: 0,0:02:15.92,0:02:16.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:19.30,0:02:20.47,Default,,0,0,0,,Козуэ-чан
Dialogue: 0,0:02:21.64,0:02:24.60,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:02:26.77,0:02:30.35,Default,,0,0,0,,Әрбір бала өмірінде бір рет болса да армандайды.
Dialogue: 0,0:02:30.48,0:02:32.65,Default,,0,0,0,,«Жер бетіндегі ең күшті адам»
Dialogue: 0,0:02:33.27,0:02:35.78,Default,,0,0,0,,Бұл қаншалықты құнды?
Dialogue: 0,0:02:35.90,0:02:38.57,Default,,0,0,0,,Спортшылардың шарасыз күресіп жатқанын көру
Dialogue: 0,0:02:38.70,0:02:40.36,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:02:41.20,0:02:43.45,Default,,0,0,0,,Бірақ сендер түсінбейсіңдер
Dialogue: 0,0:02:43.87,0:02:46.74,Default,,0,0,0,,Өздігінен жарақат алған әрбір ойыншыға
Dialogue: 0,0:02:46.83,0:02:49.00,Default,,0,0,0,,Менің ата-анам Менің әйелім
Dialogue: 0,0:02:49.16,0:02:51.17,Default,,0,0,0,,Балалар, ғашықтар
Dialogue: 0,0:02:51.25,0:02:52.88,Default,,0,0,0,,Сіздің досыңыз болуы керек.
Dialogue: 0,0:02:53.71,0:02:56.63,Default,,0,0,0,,Ең көп зардап шегетін ойыншылар емес шығар.
Dialogue: 0,0:02:56.80,0:02:58.59,Default,,0,0,0,,Олар болуы мүмкін
Dialogue: 0,0:02:59.51,0:03:03.14,Default,,0,0,0,,Бұл туралы ойладың ба, Баки-кун?
Dialogue: 0,0:03:07.43,0:03:09.39,Default,,0,0,0,,«Тақтадағы бұл қозғалыс»
Dialogue: 0,0:03:10.52,0:03:12.19,Default,,0,0,0,,Бұл шоги сөзі...
Dialogue: 0,0:03:12.31,0:03:13.40,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:13.52,0:03:14.65,Default,,0,0,0,,Кенже
Dialogue: 0,0:03:15.15,0:03:16.40,Default,,0,0,0,,Сұраққа тура жауап беріңіз...
Dialogue: 0,0:03:17.11,0:03:17.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.58,0:03:33.54,Default,,0,0,0,,Мүмкін мен өлетін шығармын
Dialogue: 0,0:03:34.79,0:03:38.25,Default,,0,0,0,,Алайда, осы процестен өткеннен кейін,
Dialogue: 0,0:03:38.59,0:03:40.63,Default,,0,0,0,,Мүмкіндіктер сізге қарсы ма, жоқ па
Dialogue: 0,0:03:41.17,0:03:43.89,Default,,0,0,0,,Бұл жағдайда бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,0:03:45.51,0:03:47.76,Default,,0,0,0,,Елеусіз 17 жыл
Dialogue: 0,0:03:48.35,0:03:50.56,Default,,0,0,0,,Бұл менің өмірімнің жалғыз жолы
Dialogue: 0,0:03:54.02,0:03:55.15,Default,,0,0,0,,Әрқашан...
Dialogue: 0,0:03:56.27,0:03:58.19,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:04:03.32,0:04:05.57,Default,,0,0,0,,Мұндай нәрсе қалай болды?
Dialogue: 0,0:04:06.20,0:04:08.24,Default,,0,0,0,,«Мүмкін мен өлетін шығармын».
Dialogue: 0,0:04:08.58,0:04:10.91,Default,,0,0,0,,Бакикун осылай деді де мені құшақтап алды.
Dialogue: 0,0:04:11.75,0:04:15.50,Default,,0,0,0,,Осындай ерекше жағдайда не болды...
Dialogue: 0,0:04:18.34,0:04:19.17,Default,,0,0,0,,Ах
Dialogue: 0,0:04:19.25,0:04:22.47,Default,,0,0,0,,Бұл жағдай ерекше болғандықтан болған жоқ.
Dialogue: 0,0:04:23.17,0:04:24.09,Default,,0,0,0,,Сен…
Dialogue: 0,0:04:24.80,0:04:29.06,Default,,0,0,0,,Ол анамнан басқаға деген сезімдерім болған қарама-қарсы жыныстағы бірінші адам.
Dialogue: 0,0:04:29.39,0:04:30.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.05,0:05:06.47,Default,,0,0,0,,Хихи~
Dialogue: 0,0:05:06.55,0:05:07.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:11.47,0:05:12.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.61,0:05:23.15,Default,,0,0,0,,Фуфуфу~!
Dialogue: 0,0:05:23.53,0:05:24.36,Default,,0,0,0,,Гуу!
Dialogue: 0,0:05:32.79,0:05:35.75,Default,,0,0,0,,Өте тыныш.
Dialogue: 0,0:05:37.37,0:05:38.21,Default,,0,0,0,,О
Dialogue: 0,0:05:40.38,0:05:45.30,Default,,0,0,0,,Сіз болдыңыз ба? Хехе, мен сондай бақыттымын.
Dialogue: 0,0:05:45.42,0:05:48.18,Default,,0,0,0,,Сіз мұндай нәрсеге шеберсіз.
Dialogue: 0,0:05:49.09,0:05:53.18,Default,,0,0,0,,Білім деуге болатын ештеңе алған жоқпын.
Dialogue: 0,0:05:53.31,0:05:56.18,Default,,0,0,0,,Менің түсінгенім осы.
Dialogue: 0,0:05:56.77,0:05:58.14,Default,,0,0,0,,Сіз жас сияқтысыз.
Dialogue: 0,0:05:58.23,0:06:03.19,Default,,0,0,0,,Сол бес адамның ішінде маған ең жақын адам сенсің.
Dialogue: 0,0:06:05.44,0:06:07.95,Default,,0,0,0,,Аа, солай, егер солай десең...
Dialogue: 0,0:06:08.07,0:06:09.53,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:06:19.29,0:06:21.33,Default,,0,0,0,,Ашуланба.
Dialogue: 0,0:06:21.46,0:06:23.96,Default,,0,0,0,,Қозғалысты бірінші жасаған мен болдым.
Dialogue: 0,0:06:24.38,0:06:28.22,Default,,0,0,0,,Бұл ең болмағанда бір тосын шабуыл жасаудың дұрыс екенін білдіре ме?
Dialogue: 0,0:06:30.59,0:06:31.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.60,0:06:36.43,Default,,0,0,0,,О!
Dialogue: 0,0:06:36.93,0:06:42.98,Default,,0,0,0,,(матаның жыртылған дыбысы)
Dialogue: 0,0:06:58.83,0:07:01.46,Default,,0,0,0,,Құмар ойыншы Ханаяма отбасы Патриархтың артқы жағында
Dialogue: 0,0:07:01.58,0:07:05.21,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан ою: «Кякутачи»
Dialogue: 0,0:07:06.38,0:07:10.13,Default,,0,0,0,,Ханаяма отбасының негізін қалаушы Якичи Ханаяма бар болғаны бала болған.
Dialogue: 0,0:07:10.26,0:07:15.43,Default,,0,0,0,,Якичиді үйіне шабуыл жасаған ұрылар тобынан қорғаған аты жоқ рыцарь қонақ.
Dialogue: 0,0:07:16.31,0:07:19.48,Default,,0,0,0,,Ол Якичиді арқасында ұстап тұрған ғибадатхананың қоңырауын көтеріп қайтыс болды.
Dialogue: 0,0:07:19.60,0:07:22.60,Default,,0,0,0,,Сол бейнені беруді жалғастыратын оюлар
Dialogue: 0,0:07:23.31,0:07:24.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:26.23,0:07:28.48,Default,,0,0,0,,«Қызық тұлға» емес
Dialogue: 0,0:07:29.03,0:07:32.28,Default,,0,0,0,,Не айтып тұрсың, екінші ұрпақ!
Dialogue: 0,0:07:34.03,0:07:35.66,Default,,0,0,0,,Толық емес
Dialogue: 0,0:07:37.37,0:07:39.12,Default,,0,0,0,,
Dialogue: 0,0:07:41.71,0:07:42.92,Default,,0,0,0,,Не?
Dialogue: 0,0:07:43.29,0:07:48.05,Default,,0,0,0,,Алдыңғы ұрпақты жаулап алған Томизава-кайға екінші ұрпақ қосылды дейсіз бе?
Dialogue: 0,0:07:52.47,0:07:53.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.43,0:07:57.10,Default,,0,0,0,,(Жастардың айқайы)
Dialogue: 0,0:08:07.23,0:08:08.69,Default,,0,0,0,,Ni, екінші ұрпақ!
Dialogue: 0,0:08:10.23,0:08:11.82,Default,,0,0,0,,Менің ойымша, бұл жақсы орындалды.
Dialogue: 0,0:08:12.53,0:08:14.82,Default,,0,0,0,,Қысылмаңыз.
Dialogue: 0,0:08:15.16,0:08:17.03,Default,,0,0,0,,«Қызық тұлға» емес
Dialogue: 0,0:08:18.03,0:08:19.49,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:08:19.62,0:08:24.08,Default,,0,0,0,,Каору Ханаяма аяқтаған нағыз «рыцарьлық стенд».
Dialogue: 0,0:08:25.96,0:08:27.84,Default,,0,0,0,,Әдемі
Dialogue: 0,0:08:28.79,0:08:30.84,Default,,0,0,0,,Хе хи!
Dialogue: 0,0:08:32.38,0:08:33.22,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:08:35.80,0:08:36.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:42.06,0:08:43.06,Default,,0,0,0,,Даа!
Dialogue: 0,0:08:46.85,0:08:47.94,Default,,0,0,0,,Хи хи
Dialogue: 0,0:08:50.69,0:08:52.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:53.07,0:08:54.95,Default,,0,0,0,,Эй эй эй эй эйя!
Dialogue: 0,0:08:56.70,0:08:58.91,Default,,0,0,0,,Иә! Эй!
Dialogue: 0,0:08:58.99,0:08:59.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.66,0:09:03.45,Default,,0,0,0,,Сәлем! сәуле! Уф... бұл!
Dialogue: 0,0:09:04.75,0:09:05.96,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:09:10.88,0:09:11.71,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:09:11.88,0:09:12.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:14.76,0:09:16.59,Default,,0,0,0,,Куу~
Dialogue: 0,0:09:21.10,0:09:22.72,Default,,0,0,0,,Босозоку арнайы шабуыл тобының жетекшісі
Dialogue: 0,0:09:23.60,0:09:25.48,Default,,0,0,0,,Жекпе-жек өнеріне әуесқой болса да
Dialogue: 0,0:09:25.60,0:09:29.56,Default,,0,0,0,,Ең үлкен турнирдің екінші раундында жеңіске жету
Dialogue: 0,0:09:30.40,0:09:32.53,Default,,0,0,0,,Ханаяманы құрметтеңіз
Dialogue: 0,0:09:33.48,0:09:36.82,Default,,0,0,0,,Апалар, жарқырап тұрған дүниелер бітті.
Dialogue: 0,0:09:37.61,0:09:38.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:40.12,0:09:42.24,Default,,0,0,0,,Ештеңе етпейді, жай ғана қоныстаныңыз!
Dialogue: 0,0:09:42.49,0:09:43.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:44.00,0:09:46.71,Default,,0,0,0,,А... аа, жоқ, кешіріңіз.
Dialogue: 0,0:09:51.29,0:09:56.55,Default,,0,0,0,,Қазір де, бұрын да Гонта ер адам үнемі жалаң қолын пайдаланған.
Dialogue: 0,0:09:57.05,0:09:58.18,Default,,0,0,0,,Эй?
Dialogue: 0,0:09:58.30,0:10:00.60,Default,,0,0,0,,О... сіздің сөздеріңіз.
Dialogue: 0,0:10:01.55,0:10:04.81,Default,,0,0,0,,Әділ ойнасаң да, жеңілсең бітті ғой, солай ма?
Dialogue: 0,0:10:04.97,0:10:07.94,Default,,0,0,0,,Біз сіздей күшті болмасақ та, өзімізді итермелеп жатырмыз.
Dialogue: 0,0:10:08.02,0:10:08.85,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:10:09.65,0:10:10.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.98,0:10:14.23,Default,,0,0,0,,Менің жыныстық тамырым жойылды.
Dialogue: 0,0:10:15.32,0:10:17.99,Default,,0,0,0,,Қарыздың жоқтығы жеңіс әкеледі
Dialogue: 0,0:10:19.61,0:10:23.03,Default,,0,0,0,,Мен бұл жекпе-жекте ештеңе қарыз емеспін.
Dialogue: 0,0:10:23.16,0:10:25.83,Default,,0,0,0,,Сол мақтаныш, сол мақтаныш
Dialogue: 0,0:10:25.95,0:10:29.00,Default,,0,0,0,,Күшті жұдырығыңызға шақырыңыз және жеңіске шақырыңыз!
Dialogue: 0,0:10:29.67,0:10:31.38,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:31.79,0:10:33.79,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:10:34.17,0:10:35.55,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:35.84,0:10:37.01,Default,,0,0,0,,О-ши
Dialogue: 0,0:10:37.47,0:10:40.76,Default,,0,0,0,,Енді мен түсіндім, бұл жақсы сәйкестік.
Dialogue: 0,0:10:40.97,0:10:42.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.43,0:10:48.27,Default,,0,0,0,,Хи хи хи~♪ (сүйрелі орындық дыбысы)
Dialogue: 0,0:10:49.31,0:10:50.77,Default,,0,0,0,,Хи хи хи хи♪
Dialogue: 0,0:10:54.15,0:10:56.03,Default,,0,0,0,,Хи хи хи~ Хаа~!
Dialogue: 0,0:10:58.99,0:11:00.57,Default,,0,0,0,,Адамға... емес!
Dialogue: 0,0:11:00.70,0:11:03.91,Default,,0,0,0,,Жейде киген құбыжық пен белдемше төбелеседі.
Dialogue: 0,0:11:08.75,0:11:11.79,Default,,0,0,0,,Әй, сен ояусың ба, бала?
Dialogue: 0,0:11:15.17,0:11:17.80,Default,,0,0,0,,Дайынсың, балақай.
Dialogue: 0,0:11:23.22,0:11:25.72,Default,,0,0,0,,Сіз бір соққыға бәс тігуге дайынсыз ба?
Dialogue: 0,0:11:26.72,0:11:30.98,Default,,0,0,0,,Кешіріңіз, балам, оны қолданбаңыз.
Dialogue: 0,0:11:32.19,0:11:35.19,Default,,0,0,0,,Менің не айтып тұрғанымды түсіндің бе, бала?
Dialogue: 0,0:11:37.61,0:11:39.90,Default,,0,0,0,,Мен үшін қаруды қолдану
Dialogue: 0,0:11:39.99,0:11:43.95,Default,,0,0,0,,Керісінше, бұл сіздің басқа адамға көңіл бөлетініңізді білдіреді.
Dialogue: 0,0:11:48.37,0:11:53.37,Default,,0,0,0,,Мен таң қалдым, балам. Сіз де сол күйдесіз.
Dialogue: 0,0:11:54.13,0:11:58.92,Default,,0,0,0,,Жапонияда «Құдайдың қолы» деген каратэші болған сияқты.
Dialogue: 0,0:11:59.13,0:12:01.22,Default,,0,0,0,,Менікі аңыз емес
Dialogue: 0,0:12:02.38,0:12:04.97,Default,,0,0,0,,Қол-аяғым, балам.
Dialogue: 0,0:12:05.18,0:12:08.47,Default,,0,0,0,,Сіз шынымен Құдайды құртып жатырсыз ба?
Dialogue: 0,0:12:30.08,0:12:32.62,Default,,0,0,0,,Жөндеу жұмыстарының ізі ме?
Dialogue: 0,0:12:33.37,0:12:36.29,Default,,0,0,0,,Ол бірдеңені жасырып тұрғандай...
Dialogue: 0,0:12:39.30,0:12:41.01,Default,,0,0,0,,Ой... ой... ой!
Dialogue: 0,0:12:45.63,0:12:47.26,Default,,0,0,0,,Иса
Dialogue: 0,0:12:53.48,0:12:55.52,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:12:55.64,0:13:01.86,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:13:10.58,0:13:11.41,Default,,0,0,0,,Станция!
Dialogue: 0,0:13:12.62,0:13:14.37,Default,,0,0,0,,Станция шұғыл!
Dialogue: 0,0:13:15.04,0:13:17.29,Default,,0,0,0,,Маған дереу ақпарат беріңізші!
Dialogue: 0,0:13:17.79,0:13:20.67,Default,,0,0,0,,Мемлекет жойылады!
Dialogue: 0,0:13:23.01,0:13:26.18,Default,,0,0,0,,Менің «апноэ сериясы»
Dialogue: 0,0:13:26.34,0:13:30.39,Default,,0,0,0,,Балаға толық соққы бере аласыз ба?
Dialogue: 0,0:13:30.93,0:13:32.43,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:13:43.82,0:13:44.69,Default,,0,0,0,,Хехе…
Dialogue: 0,0:13:45.78,0:13:48.07,Default,,0,0,0,,Ха~ Хаха~ Ха~!
Dialogue: 0,0:13:51.53,0:13:55.91,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:13:56.04,0:13:59.54,Default,,0,0,0,,Асығыңыз! Болат жақтау айқайлай бастады!
Dialogue: 0,0:13:59.67,0:14:00.75,Default,,0,0,0,,Нұсқауларды күтпеңіз!
Dialogue: 0,0:14:00.88,0:14:03.05,Default,,0,0,0,,Дайын болған соң, дереу өзіңізді байлаңыз!
Dialogue: 0,0:14:03.17,0:14:04.42,Default,,0,0,0,,Раджа!
Dialogue: 0,0:14:04.80,0:14:07.68,Default,,0,0,0,,Уау! Сәлем~!
Dialogue: 0,0:14:10.97,0:14:12.30,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:15.85,0:14:17.14,Default,,0,0,0,,Қосылды!
Dialogue: 0,0:14:17.27,0:14:18.60,Default,,0,0,0,,Бұл да!
Dialogue: 0,0:14:18.98,0:14:19.81,Default,,0,0,0,,Ku~!
Dialogue: 0,0:14:20.69,0:14:21.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:35.12,0:14:36.83,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:14:37.04,0:14:38.83,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:14:38.96,0:14:41.33,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:41.79,0:14:44.00,Default,,0,0,0,,Мырзалар, рахмет
Dialogue: 0,0:14:44.21,0:14:49.34,Default,,0,0,0,,Бір мағынада бұл соғыстан гөрі ұлттық қорғаныс операциясы болуы мүмкін.
Dialogue: 0,0:14:50.68,0:14:53.97,Default,,0,0,0,,Сенсіз мақтаншақ теңіз жаяу әскері
Dialogue: 0,0:14:54.26,0:14:57.02,Default,,0,0,0,,Бәйбіше құлап кете жаздады
Dialogue: 0,0:14:58.64,0:15:00.31,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:15:04.44,0:15:08.32,Default,,0,0,0,,Ешқандай қару қолданбайтын қандай құбыжық?
Dialogue: 0,0:15:14.20,0:15:17.83,Default,,0,0,0,,Не дейсің, балам, бір сәт үзіліс те жоқ па?
Dialogue: 0,0:15:17.95,0:15:20.00,Default,,0,0,0,,Бұл үздіксіз апноэ!
Dialogue: 0,0:15:20.62,0:15:23.25,Default,,0,0,0,,Қарсы шабуылға уақыт жоқ!
Dialogue: 0,0:15:26.42,0:15:28.21,Default,,0,0,0,,«Апноэ сериясы»
Dialogue: 0,0:15:28.34,0:15:31.63,Default,,0,0,0,,Ол жақсы дайындалған спортшылардың анаэробты жаттығуларына да қатысты.
Dialogue: 0,0:15:31.76,0:15:33.64,Default,,0,0,0,,Өте жоғары шабуыл
Dialogue: 0,0:15:34.55,0:15:37.18,Default,,0,0,0,,Спортшылар оттегісіз жүгіруді айтты
Dialogue: 0,0:15:37.31,0:15:40.27,Default,,0,0,0,,Бірақ олар да дем алады.
Dialogue: 0,0:15:40.85,0:15:45.69,Default,,0,0,0,,Боксшының жоғары жылдамдықтағы соққысы болса да, қатарынан соққылар арасында бір сәт тыныс алыңыз.
Dialogue: 0,0:15:46.40,0:15:48.90,Default,,0,0,0,,Егер сіз дем алмасаңыз, шабуыл ұзаққа созылмайды.
Dialogue: 0,0:15:49.03,0:15:51.65,Default,,0,0,0,,Бірақ бұл тыныс алу уақыты
Dialogue: 0,0:15:52.32,0:15:55.66,Default,,0,0,0,,Аздап алшақтық қарсы шабуыл жасау мүмкіндігін тудырады
Dialogue: 0,0:15:56.45,0:15:57.87,Default,,0,0,0,,Бірақ ерекшеліктер
Dialogue: 0,0:15:58.54,0:16:02.00,Default,,0,0,0,,Мүлдем тыныс алмай 5 минут жаттығу жасай алады
Dialogue: 0,0:16:02.62,0:16:06.75,Default,,0,0,0,,Қарсы шабуылға бір сәтке де мүмкіндік бермейтін Spec-тің «апноэ сериясы».
Dialogue: 0,0:16:07.67,0:16:12.38,Default,,0,0,0,,Қарсылас мәйітке айналғанша соққылар тоқтамайды.
Dialogue: 0,0:16:16.51,0:16:18.89,Default,,0,0,0,,Нухахахаха!
Dialogue: 0,0:16:19.01,0:16:23.48,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:16:25.15,0:16:25.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:28.61,0:16:30.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:35.45,0:16:38.66,Default,,0,0,0,,Мен бұл жекпе-жекте ештеңе қарыз емеспін.
Dialogue: 0,0:16:38.78,0:16:43.08,Default,,0,0,0,,Жеңіске жеткізетін сол шешім, өзіне деген сенімділік!
Dialogue: 0,0:16:44.12,0:16:45.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:45.25,0:16:51.26,Default,,0,0,0,,(Аңқылдау)
Dialogue: 0,0:16:54.43,0:16:56.26,Default,,0,0,0,,Сіз не қарап отырсыз
Dialogue: 0,0:16:56.39,0:17:01.43,Default,,0,0,0,,Толық қаруланған жабдықты елордалық полиция департаментінің терроризмге қарсы жұмыс тобы ресми түрде қабылдаған.
Dialogue: 0,0:17:02.56,0:17:06.85,Default,,0,0,0,,20 мүше елдегі барлық префектуралардан таңдалады.
Dialogue: 0,0:17:07.77,0:17:12.32,Default,,0,0,0,,Бойы 178 см немесе одан жоғары Салмағы 80 кг немесе одан жоғары
Dialogue: 0,0:17:13.19,0:17:17.53,Default,,0,0,0,,400 күндік арнайы дайындық кезеңінде 80 кг-ды бұзғандар болады
Dialogue: 0,0:17:17.66,0:17:20.32,Default,,0,0,0,,Бастапқы бірлікке оралуға мәжбүр
Dialogue: 0,0:17:21.49,0:17:24.20,Default,,0,0,0,,Арнайы FRP-ден жасалған жылжымалы шлем
Dialogue: 0,0:17:24.33,0:17:26.33,Default,,0,0,0,,Тұрақты қызметкерлермен салыстырғанда.
Dialogue: 0,0:17:26.46,0:17:28.46,Default,,0,0,0,,Салмағының үштен біріне
Dialogue: 0,0:17:28.58,0:17:32.84,Default,,0,0,0,,Біз күштің 5 есе күшті екендігі туралы эксперименттік есептерді растадық.
Dialogue: 0,0:17:33.55,0:17:36.68,Default,,0,0,0,,Арматураланған акрил беті тапанша сынақтарынан өтеді
Dialogue: 0,0:17:36.80,0:17:41.97,Default,,0,0,0,,Алдыңғы соққылар мен лақтырулардан жарақаттанудың алдын алады
Dialogue: 0,0:17:42.39,0:17:46.77,Default,,0,0,0,,Мойынды жабатын гипс соққылар кезінде бастың кез келген қозғалысын болдырмайды.
Dialogue: 0,0:17:46.89,0:17:48.98,Default,,0,0,0,,Мидың зақымдалуын тежейді
Dialogue: 0,0:17:49.98,0:17:51.11,Default,,0,0,0,,Білек легатосы
Dialogue: 0,0:17:52.07,0:17:53.48,Default,,0,0,0,,Аяқ легатосы
Dialogue: 0,0:17:53.86,0:17:56.32,Default,,0,0,0,,Барлығы төзімділік сынақтарынан өтті
Dialogue: 0,0:17:56.45,0:18:01.24,Default,,0,0,0,,Дененің әртүрлі бөліктеріндегі маңызды нүктелер де ұқсас материалдармен қорғалған.
Dialogue: 0,0:18:02.12,0:18:04.29,Default,,0,0,0,,Соңғы үлгідегі соқпалы снарядты ұшыру қондырғысы
Dialogue: 0,0:18:04.41,0:18:07.96,Default,,0,0,0,,6 ұңғылы сфералық болат оқ 800г қолданылған
Dialogue: 0,0:18:08.08,0:18:11.38,Default,,0,0,0,,Бастапқы жылдамдығы 47 метр стандартты жабдық болып табылады
Dialogue: 0,0:18:11.88,0:18:14.46,Default,,0,0,0,,Қарапайым тілмен айтқанда, күш
Dialogue: 0,0:18:14.59,0:18:16.34,Default,,0,0,0,,Жоғарғы лиганың оқ лайнері
Dialogue: 0,0:18:16.47,0:18:19.51,Default,,0,0,0,,Жақын қашықтықтан соққы алғанын елестету жақсы...
Dialogue: 0,0:18:19.84,0:18:20.68,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:18:21.39,0:18:25.18,Default,,0,0,0,,Мәселе мынада, мұндай алғыс білдіретін алты мүше болса да,
Dialogue: 0,0:18:25.35,0:18:28.98,Default,,0,0,0,,Шындық мынада, біз тек бір адамды басқара алмадық.
Dialogue: 0,0:18:29.10,0:18:29.94,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:30.52,0:18:33.52,Default,,0,0,0,,Оның үшінші рет шығуы.
Dialogue: 0,0:18:34.11,0:18:36.90,Default,,0,0,0,,Үйдегідей, қалаған уақытта кете аласыз.
Dialogue: 0,0:18:37.03,0:18:38.65,Default,,0,0,0,,Қалаған кезде оралыңыз
Dialogue: 0,0:18:38.82,0:18:42.66,Default,,0,0,0,,
Dialogue: 0,0:18:42.99,0:18:43.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:44.37,0:18:47.62,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:18:48.16,0:18:51.42,Default,,0,0,0,,Әлемге әйгілі елордалық полиция басқармасының уақытша ұстау изоляторы?
Dialogue: 0,0:18:51.54,0:18:52.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.38,0:18:54.88,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,0:18:55.00,0:18:57.38,Default,,0,0,0,,Терроризмге қарсы жұмыс тобы Арнайы ОМОН
Dialogue: 0,0:18:57.46,0:19:00.55,Default,,0,0,0,,Ерекшеліктерге қарсы қалай өнер көрсеттіңіз?
Dialogue: 0,0:19:00.80,0:19:01.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:01.72,0:19:02.55,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:22.91,0:19:24.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:34.00,0:19:36.71,Default,,0,0,0,,Болат оқ жаудырды!
Dialogue: 0,0:19:39.42,0:19:41.38,Default,,0,0,0,,Мәселе жоқ...
Dialogue: 0,0:19:46.72,0:19:50.77,Default,,0,0,0,,Егер ол қайтадан оралса ше?
Dialogue: 0,0:19:51.89,0:19:55.02,Default,,0,0,0,,Ауыр қарумен жауап беруден басқа амалымыз жоқ.
Dialogue: 0,0:19:55.23,0:19:58.73,Default,,0,0,0,,(Аңқылдау)
Dialogue: 0,0:20:00.32,0:20:01.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:01.74,0:20:04.11,Default,,0,0,0,,Жоқ, кешірім сұрау керек адам – менмін... Сіздің жомарт қамқорлығыңызға сөз таба алмай тұрмын.
Dialogue: 0,0:20:04.62,0:20:08.87,Default,,0,0,0,,Екеуміз жабысып қалғандықтан—
Dialogue: 0,0:20:09.87,0:20:12.83,Default,,0,0,0,,Қандай соққы.
Dialogue: 0,0:20:13.46,0:20:14.37,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:17.25,0:20:18.88,Default,,0,0,0,,О... О!
Dialogue: 0,0:20:19.71,0:20:23.63,Default,,0,0,0,,Сол кезде Каору Ханаяма Құдайдан асып түсті.
Dialogue: 0,0:20:26.26,0:20:27.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:27.18,0:20:28.89,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:20:30.18,0:20:31.14,Default,,0,0,0,,Гуа!
Dialogue: 0,0:20:43.24,0:20:44.57,Default,,0,0,0,,Сіз әлі де істеп жатырсыз ба?
Dialogue: 0,0:20:45.49,0:20:50.54,Default,,0,0,0,,Ех, қуатқа толы... Хе хе.
Dialogue: 0,0:20:52.29,0:20:55.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:02.30,0:21:03.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:04.68,0:21:06.18,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:21:06.51,0:21:08.68,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:21:09.47,0:21:10.31,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:21:10.72,0:21:12.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:20.94,0:21:21.98,Default,,0,0,0,,Гухе
Dialogue: 0,0:21:23.28,0:21:24.82,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:21:25.61,0:21:29.57,Default,,0,0,0,,Енді жоқ... Тоқта...
Dialogue: 0,0:21:29.87,0:21:30.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:34.79,0:21:37.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:37.58,0:21:39.96,Default,,0,0,0,,(атылған мылтық дыбысы)
Dialogue: 0,0:21:40.13,0:21:42.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:43.05,0:21:49.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:06.09,0:23:12.09,Default,,0,0,0,,~♪
Dialogue: 0,0:23:13.59,0:23:19.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory