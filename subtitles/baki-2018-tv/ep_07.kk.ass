Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.97,0:00:17.97,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,~♪
Dialogue: 0,0:01:47.10,0:01:47.94,Default,,0,0,0,,Ах
Dialogue: 0,0:01:51.65,0:01:52.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:52.65,0:01:55.69,Default,,0,0,0,,(Оқушылардың үрейлі дауыстары)
Dialogue: 0,0:01:59.11,0:02:00.57,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:02:07.21,0:02:09.21,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,0:02:09.71,0:02:12.71,Default,,0,0,0,,Мен әлі жас болсам да, алаңда төбелеспей тұра алмаймын.
Dialogue: 0,0:02:13.25,0:02:16.51,Default,,0,0,0,,Жеке күрестердің айырмашылығын түсінемін.
Dialogue: 0,0:02:20.18,0:02:21.64,Default,,0,0,0,,Ах! (Әйел) Эй...
Dialogue: 0,0:02:25.06,0:02:26.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:27.43,0:02:31.56,Default,,0,0,0,,Мұндай жерлерде қолдануға болатын көптеген нәрселер бар.
Dialogue: 0,0:02:32.19,0:02:33.02,Default,,0,0,0,,Хаа~
Dialogue: 0,0:02:36.36,0:02:37.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:45.16,0:02:45.99,Default,,0,0,0,,Иә
Dialogue: 0,0:02:47.37,0:02:48.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:51.83,0:02:52.67,Default,,0,0,0,,...!
Dialogue: 0,0:02:54.38,0:02:56.46,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:03:05.43,0:03:06.35,Default,,0,0,0,,Хаа~
Dialogue: 0,0:03:08.02,0:03:08.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:12.15,0:03:13.02,Default,,0,0,0,,Хаа~
Dialogue: 0,0:03:15.19,0:03:19.15,Default,,0,0,0,,Боқ, мектепке келгің келе ме? Қалыпты
Dialogue: 0,0:03:19.40,0:03:23.74,Default,,0,0,0,,Бұндай жерде сықырлай бастаса, бәрі таң қалады.
Dialogue: 0,0:03:24.16,0:03:27.37,Default,,0,0,0,,Тіпті мен әшкере болдым...
Dialogue: 0,0:03:27.66,0:03:28.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.83,0:03:33.00,Default,,0,0,0,,Ах (жаман) Иә?
Dialogue: 0,0:03:35.17,0:03:37.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:37.38,0:03:39.63,Default,,0,0,0,,Уа... сәлем
Dialogue: 0,0:03:43.72,0:03:47.72,Default,,0,0,0,,Маған бірдеңе дұрыс емес...
Dialogue: 0,0:03:48.22,0:03:49.77,Default,,0,0,0,,(Шөп шабу дыбысы)
Dialogue: 0,0:03:50.23,0:03:51.94,Default,,0,0,0,,Құрметті Гокуру
Dialogue: 0,0:03:52.23,0:03:53.31,Default,,0,0,0,,О~
Dialogue: 0,0:03:54.23,0:03:56.52,Default,,0,0,0,,Мен сыныпқа қайта бара алмаймын.
Dialogue: 0,0:03:56.69,0:03:57.52,Default,,0,0,0,,Ах
Dialogue: 0,0:03:57.65,0:03:58.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:02.95,0:04:04.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:07.28,0:04:08.49,Default,,0,0,0,,Ханма...
Dialogue: 0,0:04:10.33,0:04:13.54,Default,,0,0,0,,Баки мырза...
Dialogue: 0,0:04:15.63,0:04:16.75,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:24.84,0:04:27.18,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:04:34.19,0:04:37.31,Default,,0,0,0,,Мен мұны қорқақтық деп атамас едім.
Dialogue: 0,0:04:37.48,0:04:38.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:44.57,0:04:45.49,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:04:51.08,0:04:51.95,Default,,0,0,0,,Мырза, ол сіз бе едіңіз?
Dialogue: 0,0:04:53.29,0:04:56.67,Default,,0,0,0,,Ұшына жалғану керек болған үлкен орақ.
Dialogue: 0,0:04:59.29,0:05:00.59,Default,,0,0,0,,Көрінбейтін дерлік
Dialogue: 0,0:05:02.76,0:05:03.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:04.38,0:05:05.47,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:05:05.63,0:05:06.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:07.18,0:05:08.01,Default,,0,0,0,,Ei
Dialogue: 0,0:05:09.10,0:05:09.97,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:05:10.60,0:05:11.43,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:12.47,0:05:13.68,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:17.15,0:05:18.65,Default,,0,0,0,,Жақсы көздер
Dialogue: 0,0:05:19.06,0:05:22.32,Default,,0,0,0,,Бау немесе шынжыр арқылы қолданылатын қару
Dialogue: 0,0:05:22.44,0:05:25.15,Default,,0,0,0,,Ұштың жылдамдығы көзден асып түседі
Dialogue: 0,0:05:25.70,0:05:30.66,Default,,0,0,0,,Барлық қозғалыстар құйғыштың қолымен басқарылады.
Dialogue: 0,0:05:31.33,0:05:36.16,Default,,0,0,0,,Оператор сізге қарудың траекториясы туралы алдын ала хабарлайды.
Dialogue: 0,0:05:36.41,0:05:37.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:37.50,0:05:41.13,Default,,0,0,0,,Оны қалай пайдаланатыныңызға да байланысты... Бірақ...
Dialogue: 0,0:05:42.84,0:05:43.67,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:46.88,0:05:49.47,Default,,0,0,0,,Тағы ойнаймыз ба?
Dialogue: 0,0:05:55.93,0:05:57.60,Default,,0,0,0,,Бұрынғыдан жылдамырақ!
Dialogue: 0,0:06:03.82,0:06:04.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:05.53,0:06:06.36,Default,,0,0,0,,Ах
Dialogue: 0,0:06:06.49,0:06:07.32,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:08.28,0:06:09.86,Default,,0,0,0,,Уау... уау!
Dialogue: 0,0:06:12.49,0:06:13.33,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:06:14.24,0:06:15.87,Default,,0,0,0,,Ей! Хаха!
Dialogue: 0,0:06:24.34,0:06:25.63,Default,,0,0,0,,Ахх!
Dialogue: 0,0:06:25.76,0:06:26.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:30.22,0:06:31.26,Default,,0,0,0,,О~
Dialogue: 0,0:06:41.40,0:06:42.23,Default,,0,0,0,,Ах
Dialogue: 0,0:06:43.52,0:06:44.73,Default,,0,0,0,,Янаги (Янаги) А?
Dialogue: 0,0:06:47.86,0:06:48.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.82,0:06:50.36,Default,,0,0,0,,Ыстық су (тал) Уау
Dialogue: 0,0:06:50.82,0:06:51.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:00.67,0:07:03.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:06.92,0:07:07.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.88,0:07:09.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:11.88,0:07:12.80,Default,,0,0,0,,Суық...
Dialogue: 0,0:07:16.31,0:07:17.22,Default,,0,0,0,,Су?
Dialogue: 0,0:07:18.52,0:07:20.94,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:07:21.52,0:07:24.06,Default,,0,0,0,,О~хохохо
Dialogue: 0,0:07:24.19,0:07:26.44,Default,,0,0,0,,Чибетай Чибетай
Dialogue: 0,0:07:26.90,0:07:27.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:29.57,0:07:30.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:32.45,0:07:33.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:34.37,0:07:35.20,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:35.32,0:07:36.16,Default,,0,0,0,,Фугу...
Dialogue: 0,0:07:38.08,0:07:38.91,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:42.58,0:07:44.33,Default,,0,0,0,,О!
Dialogue: 0,0:07:45.67,0:07:46.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:46.63,0:07:51.42,Default,,0,0,0,,Хохо, мен пассивті болу үшін уақытында әрең жеттім.
Dialogue: 0,0:07:51.80,0:07:54.93,Default,,0,0,0,,Куку куку...
Dialogue: 0,0:07:55.60,0:08:00.64,Default,,0,0,0,,Янаги, қателеспейсің бе?
Dialogue: 0,0:08:03.85,0:08:04.69,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:06.48,0:08:12.57,Default,,0,0,0,,Жапония стоматологиялық қауымдастығының директоры Спорттық окклюзия докторы стоматология докторы
Dialogue: 0,0:08:13.20,0:08:16.12,Default,,0,0,0,,Мицуоми Хасегава 71 жаста
Dialogue: 0,0:08:16.78,0:08:21.04,Default,,0,0,0,,«Дене шынықтыру және тістеу күші» және басқа да көптеген еңбектердің авторы
Dialogue: 0,0:08:22.91,0:08:25.33,Default,,0,0,0,,Бұл қиын емес
Dialogue: 0,0:08:26.08,0:08:29.09,Default,,0,0,0,,Көріп көрсеңіз түсінесіз.
Dialogue: 0,0:08:30.00,0:08:33.42,Default,,0,0,0,,Аузыңызды ашып, иегіңізді бос ұстаңыз
Dialogue: 0,0:08:33.55,0:08:37.05,Default,,0,0,0,,Ауыр заттарды көтеріп көріңіз
Dialogue: 0,0:08:38.68,0:08:40.93,Default,,0,0,0,,Ешқашан көтерілмейді
Dialogue: 0,0:08:42.64,0:08:48.65,Default,,0,0,0,,Жоғары деңгейдегі физикалық қабілет пен тістеу күші тура пропорционалды.
Dialogue: 0,0:08:49.44,0:08:52.65,Default,,0,0,0,,Бұрынғы мыңдаған үздік спортшылардың тістері
Dialogue: 0,0:08:52.78,0:08:55.66,Default,,0,0,0,,Бұл тергеудің қорытындысы.
Dialogue: 0,0:08:56.99,0:09:01.54,Default,,0,0,0,,Бұл қалыптыдан бірнеше есе күшті болатын қатты шағуға байланысты болуы мүмкін.
Dialogue: 0,0:09:01.66,0:09:06.04,Default,,0,0,0,,Үздік спортшылардың артқы тістері бос.
Dialogue: 0,0:09:08.50,0:09:12.00,Default,,0,0,0,,Кімнің тістері ең үлкен?
Dialogue: 0,0:09:13.55,0:09:14.67,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:18.09,0:09:21.10,Default,,0,0,0,,Оны көрсету дұрыс па?
Dialogue: 0,0:09:24.43,0:09:26.39,Default,,0,0,0,,Бұл 2 жыл бұрын болды
Dialogue: 0,0:09:27.35,0:09:30.52,Default,,0,0,0,,Түрмеде жазасын өтеушілер үшін стоматологиялық тексеру
Dialogue: 0,0:09:30.65,0:09:34.15,Default,,0,0,0,,Бұл мен барған кездегі үлгі.
Dialogue: 0,0:09:35.36,0:09:37.11,Default,,0,0,0,,Сіз қарай аласыз ба?
Dialogue: 0,0:09:38.32,0:09:41.66,Default,,0,0,0,,Бұл қызыл иектің сызығы.
Dialogue: 0,0:09:42.45,0:09:44.16,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:09:44.45,0:09:48.83,Default,,0,0,0,,Артқы тістерім жоқ, тозған.
Dialogue: 0,0:09:49.88,0:09:52.38,Default,,0,0,0,,Мен мұндай мысалды білмеймін.
Dialogue: 0,0:09:52.75,0:09:57.01,Default,,0,0,0,,Бұған дайындықтың қандай деңгейі әкелді?
Dialogue: 0,0:09:58.72,0:10:04.14,Default,,0,0,0,,Жаттығудан гөрі өмір сүру тәсілі; адамның өмірінің өзі.
Dialogue: 0,0:10:04.35,0:10:09.48,Default,,0,0,0,,Менің ойымша, сіз оны қалыпты дайындық деңгейінде деп санауыңыз керек.
Dialogue: 0,0:10:11.61,0:10:13.40,Default,,0,0,0,,«Аспан жолы»
Dialogue: 0,0:10:13.73,0:10:19.32,Default,,0,0,0,,Менің есімде, ол осындай атаумен жекпе-жек өнерінің пайдаланушысы болған.
Dialogue: 0,0:10:20.99,0:10:23.08,Default,,0,0,0,,Тынш!
Dialogue: 0,0:10:25.95,0:10:26.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.39,0:10:47.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:49.98,0:10:51.44,Default,,0,0,0,,Ах, жарай берсін—
Dialogue: 0,0:10:55.73,0:10:56.57,Default,,0,0,0,,Иә
Dialogue: 0,0:11:01.70,0:11:03.07,Default,,0,0,0,,Міне, келдіңіз
Dialogue: 0,0:11:03.49,0:11:05.70,Default,,0,0,0,,Бұл мектеп.
Dialogue: 0,0:11:06.12,0:11:10.71,Default,,0,0,0,,Мектепке қара қаруды әкелуге бола ма?
Dialogue: 0,0:11:11.54,0:11:13.00,Default,,0,0,0,,Қараңғы қару?
Dialogue: 0,0:11:14.75,0:11:15.59,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.38,0:11:24.14,Default,,0,0,0,,Үндістанның жасырын қаруы Баг Наку
Dialogue: 0,0:11:25.10,0:11:29.23,Default,,0,0,0,,Сөзбе-сөз «жолбарыстың тырнағы» деп аударылады ма?
Dialogue: 0,0:11:29.81,0:11:31.60,Default,,0,0,0,,Жақсы ойыншық.
Dialogue: 0,0:11:32.35,0:11:33.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:34.44,0:11:36.57,Default,,0,0,0,,Тағы да ойнаймыз ба?
Dialogue: 0,0:11:37.78,0:11:39.74,Default,,0,0,0,,Янаги, сен...
Dialogue: 0,0:11:40.19,0:11:42.49,Default,,0,0,0,,Сіз батыл мінездісіз.
Dialogue: 0,0:11:42.99,0:11:43.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:45.03,0:11:47.74,Default,,0,0,0,,Мұнда екі адам керек.
Dialogue: 0,0:11:47.87,0:11:48.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:50.37,0:11:51.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.71,0:11:54.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:56.09,0:11:58.80,Default,,0,0,0,,Мен мұны қорқақ деп айтпас едім.
Dialogue: 0,0:11:59.59,0:12:01.26,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:12:02.05,0:12:03.59,Default,,0,0,0,,Қызықты
Dialogue: 0,0:12:06.39,0:12:07.22,Default,,0,0,0,,Га
Dialogue: 0,0:12:07.35,0:12:08.35,Default,,0,0,0,,Идиот! (Янаги) Уау!
Dialogue: 0,0:12:11.43,0:12:13.27,Default,,0,0,0,,Сәйкестенейік, Баки~!
Dialogue: 0,0:12:13.39,0:12:14.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:15.69,0:12:17.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:17.86,0:12:18.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:19.02,0:12:19.90,Default,,0,0,0,,О! (Янаги) Уау!
Dialogue: 0,0:12:20.99,0:12:21.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.24,0:12:26.57,Default,,0,0,0,,Фухахаха мен оны пассивті қабылдадым.
Dialogue: 0,0:12:26.91,0:12:28.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:28.83,0:12:30.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:31.50,0:12:33.25,Default,,0,0,0,,Алдыңғы қақпадағы жолбарыс
Dialogue: 0,0:12:34.21,0:12:38.54,Default,,0,0,0,,Артқы қақпадағы қасқыр, хи хи хи
Dialogue: 0,0:12:39.25,0:12:41.63,Default,,0,0,0,,Ең күшті тегтер командасын құрыңыз!
Dialogue: 0,0:12:42.17,0:12:45.47,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:12:46.51,0:12:48.30,Default,,0,0,0,,Залға кіріңіз
Dialogue: 0,0:12:48.93,0:12:53.48,Default,,0,0,0,,17 жасында Мылқау Шо-рюдың шыңына жеткенін естідім.
Dialogue: 0,0:12:53.98,0:12:57.35,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:12:57.69,0:12:58.90,Default,,0,0,0,,Иә! О...
Dialogue: 0,0:12:59.02,0:12:59.86,Default,,0,0,0,,Иә
Dialogue: 0,0:13:00.94,0:13:01.82,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:02.61,0:13:03.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:03.61,0:13:04.45,Default,,0,0,0,,Тыныш
Dialogue: 0,0:13:08.24,0:13:09.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:09.41,0:13:11.58,Default,,0,0,0,,Ұмытшақ
Dialogue: 0,0:13:12.12,0:13:14.16,Default,,0,0,0,,Хоря Кататаре Баки~!
Dialogue: 0,0:13:14.50,0:13:15.33,Default,,0,0,0,,Ах
Dialogue: 0,0:13:15.46,0:13:16.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:16.42,0:13:18.17,Default,,0,0,0,,Өте тәтті!
Dialogue: 0,0:13:24.92,0:13:27.01,Default,,0,0,0,,Иә! Шии!
Dialogue: 0,0:13:35.27,0:13:38.23,Default,,0,0,0,,Бақи мырза, бұл кісінің мамандығы
Dialogue: 0,0:13:38.35,0:13:41.52,Default,,0,0,0,,Бұл орақ немесе қара қару сияқты қару техникасы емес.
Dialogue: 0,0:13:41.65,0:13:42.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.15,0:13:46.40,Default,,0,0,0,,Адамдар бізді «улы тал» деп атайды.
Dialogue: 0,0:13:52.58,0:13:53.99,Default,,0,0,0,,«Аспан жолы»
Dialogue: 0,0:13:54.50,0:13:58.21,Default,,0,0,0,,Бұл жігіттің манипуляциялық техникасының аты.
Dialogue: 0,0:14:06.63,0:14:07.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:09.01,0:14:11.76,Default,,0,0,0,,Сізге сұрақ қоюға рұқсат етіңіз.
Dialogue: 0,0:14:12.26,0:14:16.73,Default,,0,0,0,,Жердегі ең күшті улы газ қандай?
Dialogue: 0,0:14:16.85,0:14:19.02,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:14:19.40,0:14:21.44,Default,,0,0,0,,Баки-сан, сақтығыңды түсірме!
Dialogue: 0,0:14:21.69,0:14:25.90,Default,,0,0,0,,Жердегі ең улы газ
Dialogue: 0,0:14:26.49,0:14:28.03,Default,,0,0,0,,Сау бол, Баки-сан!
Dialogue: 0,0:14:28.49,0:14:33.53,Default,,0,0,0,,Зарин де, көміртегі тотығы да улы болуы керек.
Dialogue: 0,0:14:34.62,0:14:38.66,Default,,0,0,0,,Сулы қышқыл газы да өлімге әкелуі мүмкін
Dialogue: 0,0:14:39.29,0:14:42.54,Default,,0,0,0,,Бұл позиция ма?
Dialogue: 0,0:14:42.79,0:14:46.59,Default,,0,0,0,,Бірақ бұл газдар сізді өлтіргенде
Dialogue: 0,0:14:48.01,0:14:49.13,Default,,0,0,0,,Адамдар...
Dialogue: 0,0:14:50.59,0:14:52.80,Default,,0,0,0,,Өте әлсіз...
Dialogue: 0,0:14:53.76,0:14:58.81,Default,,0,0,0,,Немесе жөтел немесе бас айналу.
Dialogue: 0,0:14:59.60,0:15:02.15,Default,,0,0,0,,Біртіндеп Біртіндеп...
Dialogue: 0,0:15:02.73,0:15:04.48,Default,,0,0,0,,Соқ!
Dialogue: 0,0:15:04.77,0:15:06.07,Default,,0,0,0,,Өлімге апару
Dialogue: 0,0:15:07.23,0:15:08.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.08,0:15:19.20,Default,,0,0,0,,Бұл оттегінің жетіспеушілігінен болатын неврологиялық ауру деп естідім.
Dialogue: 0,0:15:19.87,0:15:23.46,Default,,0,0,0,,Түрмедегі төбелестен болған деп естідім.
Dialogue: 0,0:15:23.92,0:15:25.59,Default,,0,0,0,,Мониторда қандай көрінеді?
Dialogue: 0,0:15:25.71,0:15:27.46,Default,,0,0,0,,Тыныштық бар сияқты.
Dialogue: 0,0:15:28.13,0:15:28.96,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:15:34.68,0:15:37.47,Default,,0,0,0,,Бірақ бұл өте үлкен.
Dialogue: 0,0:15:37.77,0:15:41.02,Default,,0,0,0,,Кереует де арнайы жасалған 3 кереует қатар қойылған.
Dialogue: 0,0:15:41.98,0:15:45.48,Default,,0,0,0,,Бұрынғы сумо балуаны Секиваке Китараши
Dialogue: 0,0:15:45.77,0:15:49.23,Default,,0,0,0,,Бұл кісі ұрыста жеңілді ме?
Dialogue: 0,0:15:49.74,0:15:50.78,Default,,0,0,0,,Баяндамада
Dialogue: 0,0:15:50.90,0:15:54.53,Default,,0,0,0,,Қарсылас жасы үштен біріне де толмаған кішкентай адам болды.
Dialogue: 0,0:15:55.57,0:15:57.08,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:15:57.62,0:16:00.41,Default,,0,0,0,,Ол қазір қашып жүр.
Dialogue: 0,0:16:00.58,0:16:02.54,Default,,0,0,0,,Бәрі, шашылыңдар!
Dialogue: 0,0:16:05.42,0:16:07.09,Default,,0,0,0,,Мен инені өткізе алмаймын.
Dialogue: 0,0:16:08.05,0:16:10.21,Default,,0,0,0,,Бұл жануар сияқты (масалардың қанаттарының дыбысы)
Dialogue: 0,0:16:11.72,0:16:12.55,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:13.38,0:16:15.26,Default,,0,0,0,,Уа... ау! (Нан!)
Dialogue: 0,0:16:17.81,0:16:20.14,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:16:23.31,0:16:24.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:25.23,0:16:26.06,Default,,0,0,0,,(Нан!)
Dialogue: 0,0:16:27.48,0:16:29.02,Default,,0,0,0,,Иә? (Дәрігер С) О...
Dialogue: 0,0:16:30.90,0:16:32.78,Default,,0,0,0,,Ku… gi…
Dialogue: 0,0:16:32.95,0:16:34.78,Default,,0,0,0,,Куу…
Dialogue: 0,0:16:34.95,0:16:38.28,Default,,0,0,0,,(Солтүстік Арашидің күшті дауысы)
Dialogue: 0,0:16:38.41,0:16:41.29,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:16:41.45,0:16:46.29,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:16:46.42,0:16:49.29,Default,,0,0,0,,Хэй~ Ах-ах~
Dialogue: 0,0:16:49.46,0:16:51.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:51.38,0:16:53.30,Default,,0,0,0,,Эй, сәлем!
Dialogue: 0,0:16:54.93,0:16:55.76,Default,,0,0,0,,(Нан!)
Dialogue: 0,0:17:05.06,0:17:06.94,Default,,0,0,0,,Жауабы оттегі
Dialogue: 0,0:17:07.48,0:17:10.57,Default,,0,0,0,,Мен білгенше, тым кеш болды.
Dialogue: 0,0:17:11.94,0:17:13.82,Default,,0,0,0,,Бұл «кудо»
Dialogue: 0,0:17:15.49,0:17:18.87,Default,,0,0,0,,«Улы тал» деп аталатын өлімге әкелетін у қалай аталады?
Dialogue: 0,0:17:19.49,0:17:22.66,Default,,0,0,0,,Біз темекі шегуді жалғастырамыз -
Dialogue: 0,0:17:22.79,0:17:28.29,Default,,0,0,0,,Ал мен дем алмай тұрған оттегі болды.
Dialogue: 0,0:17:28.92,0:17:30.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.13,0:17:33.80,Default,,0,0,0,,Жарты күн тұруға болмайды
Dialogue: 0,0:17:34.09,0:17:37.34,Default,,0,0,0,,Бұл бокстағы КО-дан өзгеше.
Dialogue: 0,0:17:38.89,0:17:41.35,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:17:41.97,0:17:47.10,Default,,0,0,0,,Жекпе-жек Бұл әдіс жекпе-жек ұғымынан мүлде бөлек.
Dialogue: 0,0:17:48.90,0:17:51.69,Default,,0,0,0,,Түсіндіру қажет сияқты.
Dialogue: 0,0:17:51.82,0:17:52.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.90,0:17:55.86,Default,,0,0,0,,Бұл жер асты әлемінен келген кәдесый.
Dialogue: 0,0:17:57.03,0:18:02.70,Default,,0,0,0,,Бізді қоршап тұрған атмосфера: 21% оттегі
Dialogue: 0,0:18:03.58,0:18:09.37,Default,,0,0,0,,Қатынас осы қатынастан төмен түскен сайын физикалық функция пропорционалды түрде төмендейді.
Dialogue: 0,0:18:10.04,0:18:14.38,Default,,0,0,0,,Бас айналу Қалтырау Жүрек айнуы Құсу
Dialogue: 0,0:18:15.01,0:18:16.72,Default,,0,0,0,,Және есінен тану
Dialogue: 0,0:18:18.13,0:18:23.89,Default,,0,0,0,,15%-дан төмен түссе де бұл белгілер пайда болады.
Dialogue: 0,0:18:24.31,0:18:27.81,Default,,0,0,0,,Бірақ сол әсер ету деңгейімен
Dialogue: 0,0:18:27.94,0:18:32.40,Default,,0,0,0,,Ұрыс бірден шешілетін шайқастарда қолдануға болмайды.
Dialogue: 0,0:18:33.27,0:18:34.90,Default,,0,0,0,,6 пайыз
Dialogue: 0,0:18:35.32,0:18:37.82,Default,,0,0,0,,Мән осы мәннен төмен болғанда
Dialogue: 0,0:18:37.95,0:18:41.91,Default,,0,0,0,,Адам бір рет ингаляциядан кейін есін жоғалтады
Dialogue: 0,0:18:43.08,0:18:44.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:44.87,0:18:46.91,Default,,0,0,0,,Құдайды таң қалдыру өнері
Dialogue: 0,0:18:47.70,0:18:50.83,Default,,0,0,0,,Мен тынысымды 5 минуттан артық ұстай аламын.
Dialogue: 0,0:18:50.96,0:18:52.92,Default,,0,0,0,,Адам жаратылған
Dialogue: 0,0:18:53.63,0:18:57.97,Default,,0,0,0,,Егер сіз оттегі мөлшері 6% немесе одан аз ауаны жұтсаңыз
Dialogue: 0,0:18:58.09,0:19:01.93,Default,,0,0,0,,Функционалдылықты бір рет жоғалту шындық
Dialogue: 0,0:19:02.59,0:19:07.35,Default,,0,0,0,,Дизайндағы анық қате мен оны ұстандым.
Dialogue: 0,0:19:09.48,0:19:10.81,Default,,0,0,0,,Мен оны бір нәрсеге айналдырдым.
Dialogue: 0,0:19:10.94,0:19:15.02,Default,,0,0,0,,Алақандағы атмосфера 6%-дан аз
Dialogue: 0,0:19:15.57,0:19:19.82,Default,,0,0,0,,Шыны ағаш бетон
Dialogue: 0,0:19:21.07,0:19:25.37,Default,,0,0,0,,Қайталанатын тәжірибелер мен материалдардың барлық түрлерімен жаттығулар
Dialogue: 0,0:19:26.79,0:19:31.46,Default,,0,0,0,,Соңында мен алақанда вакуум жасаймын.
Dialogue: 0,0:19:32.12,0:19:33.29,Default,,0,0,0,,О...
Dialogue: 0,0:19:34.71,0:19:36.04,Default,,0,0,0,,Осылай!
Dialogue: 0,0:19:37.09,0:19:38.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:39.09,0:19:40.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:45.43,0:19:48.10,Default,,0,0,0,,Бұл қол оны жасады.
Dialogue: 0,0:19:48.56,0:19:51.35,Default,,0,0,0,,Жердегі ең қауіпті улы газ
Dialogue: 0,0:19:52.10,0:19:55.36,Default,,0,0,0,,Зарин мен цианидті газ сәйкес келмейді.
Dialogue: 0,0:19:55.48,0:19:59.11,Default,,0,0,0,,Адамды бір деммен өлтіретін газ.
Dialogue: 0,0:20:00.53,0:20:01.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:01.95,0:20:06.62,Default,,0,0,0,,Мен түрмеде болу бақытына ие болдым.
Dialogue: 0,0:20:07.37,0:20:11.62,Default,,0,0,0,,Тұлға аралық пайдалану үшін қайта құру үшін тамаша орта
Dialogue: 0,0:20:12.29,0:20:17.50,Default,,0,0,0,,Жақында менің атыма «улы» сөзі қосылады.
Dialogue: 0,0:20:17.63,0:20:22.63,Default,,0,0,0,,
Dialogue: 0,0:20:23.30,0:20:26.72,Default,,0,0,0,,Сіз осындасыз ба? Бұл демалып жатыр
Dialogue: 0,0:20:27.76,0:20:29.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:29.81,0:20:35.02,Default,,0,0,0,,
Dialogue: 0,0:20:35.15,0:20:36.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:38.86,0:20:40.65,Default,,0,0,0,,Баки мырза
Dialogue: 0,0:20:40.82,0:20:41.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.61,0:20:44.66,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:45.07,0:20:46.70,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:20:46.82,0:20:47.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:59.04,0:21:05.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:22.09,0:22:28.09,Default,,0,0,0,,~♪
Dialogue: 0,0:22:29.59,0:22:35.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory