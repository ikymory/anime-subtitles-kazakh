Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.51,0:00:17.51,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:41.68,0:01:43.39,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:01:49.52,0:01:55.28,Default,,0,0,0,,Сіз Юдзиро Хаммер есімді адамды білесіз бе?
Dialogue: 0,0:01:55.40,0:01:58.11,Default,,0,0,0,,‎(Тілші) Әй! Огр…
Dialogue: 0,0:01:58.36,0:02:00.82,Default,,0,0,0,,Неліктен бұл атау?
Dialogue: 0,0:02:03.08,0:02:06.16,Default,,0,0,0,,‎(Тілші) Ол жеңіп алған алтын медалін түкке тұрғысыз деп санады.
Dialogue: 0,0:02:06.29,0:02:08.96,Default,,0,0,0,,‎Оны өзенге лақтырып, кәсіпқой болыңыз
Dialogue: 0,0:02:11.17,0:02:13.96,Default,,0,0,0,,Қарсыласыңызды қорлаумен қыздырыңыз
Dialogue: 0,0:02:14.25,0:02:16.46,Default,,0,0,0,,‎Бұрын-соңды болмаған өнімділік тәжірибесі
Dialogue: 0,0:02:17.26,0:02:19.59,Default,,0,0,0,,‎Бұқаралық ақпарат құралдарының орталық сахнасынан бастаңыз
Dialogue: 0,0:02:20.47,0:02:24.22,Default,,0,0,0,,‎Күннің соңында КО ескертеді және...
Dialogue: 0,0:02:24.76,0:02:26.35,Default,,0,0,0,,‎
Dialogue: 0,0:02:26.47,0:02:30.06,Default,,0,0,0,,‎(қуаныш)
Dialogue: 0,0:02:30.35,0:02:32.56,Default,,0,0,0,,(Тілші) Мұның бәрі орындалды.
Dialogue: 0,0:02:33.44,0:02:36.28,Default,,0,0,0,,‎Әскерге шақырудан жалтару атағын қайтарып алу
Dialogue: 0,0:02:36.57,0:02:40.66,Default,,0,0,0,,‎Қаралардың азаттық қозғалысының таққа ғажайып қайта оралуы
Dialogue: 0,0:02:41.45,0:02:44.24,Default,,0,0,0,,‎Ал үшінші рет тағына оралу
Dialogue: 0,0:02:45.45,0:02:48.54,Default,,0,0,0,,‎Спорт шекарасынан асатын аңыздар
Dialogue: 0,0:02:49.04,0:02:51.62,Default,,0,0,0,,‎Тірі кезінде «құдайға» айналған адам
Dialogue: 0,0:02:52.42,0:02:56.25,Default,,0,0,0,,Сол «құдайдың» аузынан адам сенгісіз адамның аты шықты...
Dialogue: 0,0:02:58.67,0:03:02.18,Default,,0,0,0,,‎Неге... ол кісінің аты кім?
Dialogue: 0,0:03:11.60,0:03:13.90,Default,,0,0,0,,1976
Dialogue: 0,0:03:14.73,0:03:17.53,Default,,0,0,0,,Мен Жапонияда болдым
Dialogue: 0,0:03:18.82,0:03:22.20,Default,,0,0,0,,‎(Тілші) Құдай ақырын сөйлей бастады.
Dialogue: 0,0:03:23.62,0:03:27.29,Default,,0,0,0,,‎ Жапондық кәсіпқой балуандарға қарсы ғасыр матчы
Dialogue: 0,0:03:28.62,0:03:32.58,Default,,0,0,0,,‎Антонио Икаримен аралас матчты жүзеге асыру
Dialogue: 0,0:03:33.88,0:03:37.42,Default,,0,0,0,,‎Алғашында мен бұл шоу-матчты тартымды деп ойладым.
Dialogue: 0,0:03:38.17,0:03:42.51,Default,,0,0,0,,Шындығында, бұл ешкімге кедергі келтірмейтін нағыз жекпе-жек сияқты естіледі.
Dialogue: 0,0:03:43.05,0:03:45.55,Default,,0,0,0,,Мен де шынайы болдым
Dialogue: 0,0:03:46.18,0:03:48.35,Default,,0,0,0,,‎(соққы дыбысы)
Dialogue: 0,0:03:49.35,0:03:52.81,Default,,0,0,0,,‎ Тақырып сәйкестігімен салыстырылатын жаттығу мәзірі
Dialogue: 0,0:04:04.24,0:04:07.66,Default,,0,0,0,,Түнгі жол жұмысы бұқаралық ақпарат құралдарынан алыс
Dialogue: 0,0:04:08.62,0:04:10.25,Default,,0,0,0,,Мүшелер әдеттегідей
Dialogue: 0,0:04:10.45,0:04:15.21,Default,,0,0,0,,Күшті спарринг серіктестері, оның ішінде болашақ әлем чемпиондары
Dialogue: 0,0:04:16.46,0:04:17.96,Default,,0,0,0,,10 минут өтті
Dialogue: 0,0:04:18.80,0:04:23.05,Default,,0,0,0,,Алдымен менің ақ нәсілді серіктесім Джон Стэндер жоғалып кетті.
Dialogue: 0,0:04:24.34,0:04:25.89,Default,,0,0,0,,15 минут өтті
Dialogue: 0,0:04:26.72,0:04:29.10,Default,,0,0,0,,Содан кейін Джек Леннон жоғалып кетті.
Dialogue: 0,0:04:30.31,0:04:32.35,Default,,0,0,0,,20 минут өтті
Dialogue: 0,0:04:35.90,0:04:36.73,Default,,0,0,0,,А
Dialogue: 0,0:04:37.48,0:04:38.86,Default,,0,0,0,,Мен біртүрлі нәрсені байқадым.
Dialogue: 0,0:04:38.98,0:04:39.82,Default,,0,0,0,,А
Dialogue: 0,0:04:44.90,0:04:46.45,Default,,0,0,0,,‎Ах, а…
Dialogue: 0,0:04:51.29,0:04:53.54,Default,,0,0,0,,‎Ауандардың иісі аумақты жайлады
Dialogue: 0,0:04:54.46,0:04:56.42,Default,,0,0,0,,Қаланың ортасында жүргенде
Dialogue: 0,0:04:56.58,0:05:01.17,Default,,0,0,0,,Мен достарыма жабайы аң шабуыл жасады деп қатты алаңдадым.
Dialogue: 0,0:05:01.30,0:05:02.55,Default,,0,0,0,,‎(аяқ дыбысына жақындау)
Dialogue: 0,0:05:02.67,0:05:04.09,Default,,0,0,0,,‎(Юдзиро) Чемпион Ах
Dialogue: 0,0:05:12.68,0:05:16.06,Default,,0,0,0,,‎Ол жерде жыртқыш аңнан да артық адам бар еді.
Dialogue: 0,0:05:17.40,0:05:20.98,Default,,0,0,0,,‎Ол кісі мені сырт келбетімен ғана түсіндірді.
Dialogue: 0,0:05:22.48,0:05:26.03,Default,,0,0,0,,Менің достарымды осы адам құртып жіберді.
Dialogue: 0,0:05:26.74,0:05:28.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:31.66,0:05:33.54,Default,,0,0,0,,‎(Юдзиро) Мен сенімен танысқым келді.
Dialogue: 0,0:05:34.87,0:05:37.54,Default,,0,0,0,,‎ Мен кімдермен бәсекелестім?
Dialogue: 0,0:05:37.92,0:05:40.13,Default,,0,0,0,,‎Мүлдем басқа қатысу
Dialogue: 0,0:05:43.30,0:05:47.55,Default,,0,0,0,,‎Тіпті рингте мен ешқашан сақамды көтермедім.
Dialogue: 0,0:05:48.13,0:05:50.76,Default,,0,0,0,,Мен бірінші рет күзетімді күшейттім...
Dialogue: 0,0:05:52.10,0:05:53.64,Default,,0,0,0,,‎Көбелек сияқты қалқыңыз
Dialogue: 0,0:05:57.94,0:05:59.85,Default,,0,0,0,,Ара сияқты шағу
Dialogue: 0,0:06:01.23,0:06:06.65,Default,,0,0,0,,‎1814 Англияда заманауи бокс пайда болғаннан кейін
Dialogue: 0,0:06:07.53,0:06:11.45,Default,,0,0,0,,‎Мен бірінші болып ешқандай сақтықты тактика ретінде қабылдадым.
Dialogue: 0,0:06:12.83,0:06:13.95,Default,,0,0,0,,‎«Қорғаныңызды көтермеңіз»
Dialogue: 0,0:06:15.24,0:06:17.83,Default,,0,0,0,,Қандай құбыжықпен кездессеңіз де
Dialogue: 0,0:06:18.83,0:06:23.13,Default,,0,0,0,,‎Ол кезде мен мен қарсыласымның арасында үлкен алшақтық болды.
Dialogue: 0,0:06:25.17,0:06:27.51,Default,,0,0,0,,Сіз түсінесіз деп үміттенемін...
Dialogue: 0,0:06:28.09,0:06:31.43,Default,,0,0,0,,Мен өзімнің сақамды көтеремін, оның маңыздылығы
Dialogue: 0,0:06:32.39,0:06:35.31,Default,,0,0,0,,‎Көшеде пайда болған адамға
Dialogue: 0,0:06:35.68,0:06:38.23,Default,,0,0,0,,Мен қауіпті сезіндім.
Dialogue: 0,0:06:41.98,0:06:42.81,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:06:44.07,0:06:47.99,Default,,0,0,0,,‎Кәсіпқой боксшы ретінде мен қателесуім мүмкін емес.
Dialogue: 0,0:06:50.03,0:06:53.99,Default,,0,0,0,,‎Бокс – бұл анық басқа жүйесі бар спектакль.
Dialogue: 0,0:06:56.45,0:06:57.87,Default,,0,0,0,,Сіз елестете аласыз ба?
Dialogue: 0,0:06:58.45,0:07:00.12,Default,,0,0,0,,‎Мен өмірімді арнаған технология...
Dialogue: 0,0:07:01.92,0:07:03.17,Default,,0,0,0,,‎Түрмеңіз
Dialogue: 0,0:07:07.09,0:07:09.09,Default,,0,0,0,,‎(Арайдың ауыр тыныс алуы)
Dialogue: 0,0:07:14.22,0:07:15.64,Default,,0,0,0,,Сіз не қалайсыз?
Dialogue: 0,0:07:16.26,0:07:18.27,Default,,0,0,0,,Сіздің сұранысыңыз қандай?
Dialogue: 0,0:07:19.64,0:07:20.48,Default,,0,0,0,,‎(Юдзиро) Хэхе
Dialogue: 0,0:07:22.60,0:07:23.90,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:07:24.56,0:07:28.15,Default,,0,0,0,,Сіздің нағыз мамандығыңыз бокс емес.
Dialogue: 0,0:07:29.15,0:07:30.53,Default,,0,0,0,,Сонымен қатар,
Dialogue: 0,0:07:31.28,0:07:35.53,Default,,0,0,0,,‎Сіздің мақсатыңыз ауыр салмақтағы әлем чемпионы емес еді.
Dialogue: 0,0:07:35.91,0:07:37.12,Default,,0,0,0,,Ух...
Dialogue: 0,0:07:39.54,0:07:42.54,Default,,0,0,0,,‎Неге... сіз солай ойлайсыз ба?
Dialogue: 0,0:07:43.42,0:07:44.50,Default,,0,0,0,,‎(Юдзиро) Нхуфуфу
Dialogue: 0,0:07:45.63,0:07:49.38,Default,,0,0,0,,(Юдзиро) Рингтегі қимыл-қозғалысыңа қарасаң анық көрінеді.
Dialogue: 0,0:07:49.76,0:07:51.42,Default,,0,0,0,,Бұл боксқа көбірек ұқсайды
Dialogue: 0,0:07:51.88,0:07:55.43,Default,,0,0,0,,‎Барлық бұрыштардан шабуылдардың барлық түрлерін болжау
Dialogue: 0,0:07:56.18,0:07:57.89,Default,,0,0,0,,‎Соғыс өнері деп аталатындар!
Dialogue: 0,0:08:00.39,0:08:01.23,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:08:03.06,0:08:09.40,Default,,0,0,0,,‎ Дүние жүзіндегі атақты жаттықтырушылар ешқашан елестетпеген...
Dialogue: 0,0:08:10.11,0:08:11.65,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:08:13.61,0:08:14.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:16.70,0:08:18.58,Default,,0,0,0,,Тіпті боксшы да емес —
Dialogue: 0,0:08:18.66,0:08:23.08,Default,,0,0,0,,‎Мен көшеде кездестірген азиаттық жігіт менің көз алдымнан көрінді.
Dialogue: 0,0:08:24.58,0:08:25.92,Default,,0,0,0,,‎(Юдзиро) Шамасы...
Dialogue: 0,0:08:26.54,0:08:28.79,Default,,0,0,0,,‎Енді нақты мәміле келді!
Dialogue: 0,0:08:29.88,0:08:31.30,Default,,0,0,0,,‎(Аллидің тынысы)
Dialogue: 0,0:08:51.48,0:08:52.61,Default,,0,0,0,,‎(Юдзиро) Ихихи
Dialogue: 0,0:09:10.34,0:09:11.17,Default,,0,0,0,,‎(Юдзиро) Хэхе
Dialogue: 0,0:09:11.84,0:09:12.80,Default,,0,0,0,,А
Dialogue: 0,0:09:14.51,0:09:16.34,Default,,0,0,0,,‎(Юдзиро) Жоқ~ Хахаха
Dialogue: 0,0:09:16.51,0:09:19.55,Default,,0,0,0,,‎Бұл бұрынғыдан мүлдем өзгеше, чемпион.
Dialogue: 0,0:09:20.01,0:09:24.23,Default,,0,0,0,,Нағыз жекпе-жек өнері! Бұл бокс емес
Dialogue: 0,0:09:25.69,0:09:27.52,Default,,0,0,0,,‎Punch Strike
Dialogue: 0,0:09:28.10,0:09:30.02,Default,,0,0,0,,Kick Grapple
Dialogue: 0,0:09:30.57,0:09:32.53,Default,,0,0,0,,‎Слеммен ұстау
Dialogue: 0,0:09:32.98,0:09:36.20,Default,,0,0,0,,‎Барлық жағдайлар үшін күресу әдістері
Dialogue: 0,0:09:37.28,0:09:38.53,Default,,0,0,0,,‎Егер мен оны айту керек болсам
Dialogue: 0,0:09:39.16,0:09:42.29,Default,,0,0,0,,‎Магомед Арай стиліндегі жекпе-жек өнері
Dialogue: 0,0:09:47.25,0:09:48.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:50.67,0:09:53.17,Default,,0,0,0,,Өкінішке орай, аяқталмады
Dialogue: 0,0:09:54.38,0:09:55.21,Default,,0,0,0,,‎Мм.
Dialogue: 0,0:09:57.01,0:10:00.60,Default,,0,0,0,,Әскери шақырудан мәжбүрлеп жалтарғаны үшін құқықтың күшін жою
Dialogue: 0,0:10:01.76,0:10:06.98,Default,,0,0,0,,‎Ол үш жарым жылдық үзіліс Арай-рю Кенпоның аяқталуына кедергі болды.
Dialogue: 0,0:10:10.77,0:10:11.61,Default,,0,0,0,,А...
Dialogue: 0,0:10:13.07,0:10:14.07,Default,,0,0,0,,Уау
Dialogue: 0,0:10:14.69,0:10:17.24,Default,,0,0,0,,‎Мм... Не?
Dialogue: 0,0:10:18.53,0:10:19.53,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:10:20.82,0:10:21.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:24.04,0:10:24.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:28.33,0:10:29.17,Default,,0,0,0,,Уф
Dialogue: 0,0:10:31.04,0:10:33.63,Default,,0,0,0,,Өйткені сол үш жарым жыл болды
Dialogue: 0,0:10:35.05,0:10:36.55,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:38.55,0:10:41.55,Default,,0,0,0,,‎Ауыр салмақтағы әлем чемпионы Махомед Алай
Dialogue: 0,0:10:42.72,0:10:44.35,Default,,0,0,0,,Мен сізді құрметтеймін
Dialogue: 0,0:10:44.89,0:10:45.72,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:10:49.10,0:10:53.11,Default,,0,0,0,,‎Анық... Мен сенен әлсізмін бе?
Dialogue: 0,0:10:54.44,0:10:58.11,Default,,0,0,0,,Сіз менен қарағанда әлсіз екеніңіз анық.
Dialogue: 0,0:10:59.28,0:11:01.24,Default,,0,0,0,,‎Ха ха ха…
Dialogue: 0,0:11:03.20,0:11:06.70,Default,,0,0,0,,‎(Юдзиро) Қара нәсілді кедейлерге арналған жүйеге қарсы күресті
Dialogue: 0,0:11:09.21,0:11:12.54,Default,,0,0,0,,зардап шеккен Вьетнам үшін ұлтпен күресті.
Dialogue: 0,0:11:13.88,0:11:17.30,Default,,0,0,0,,Барлық әлсіздердің атынан соғысқан
Dialogue: 0,0:11:18.59,0:11:19.42,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:20.17,0:11:22.30,Default,,0,0,0,,Күшсіздердің үміті!
Dialogue: 0,0:11:24.39,0:11:27.52,Default,,0,0,0,,‎Я, мен өзімді жаман сезінбеймін.
Dialogue: 0,0:11:28.27,0:11:32.10,Default,,0,0,0,,‎Мен өзімді жаман сезінбеймін, бірақ... көңілім қалды.
Dialogue: 0,0:11:32.65,0:11:37.27,Default,,0,0,0,,‎Сенің шамадан тыс күштілігің үшін және менің әлсіздігім үшін
Dialogue: 0,0:11:38.98,0:11:40.65,Default,,0,0,0,,Мен жеңілгенді жек көремін.
Dialogue: 0,0:11:50.16,0:11:52.96,Default,,0,0,0,,Күрес әрқашан үмітсіз болды.
Dialogue: 0,0:11:54.33,0:11:58.71,Default,,0,0,0,,‎Айналасы 40 см болатын жұдырықтары бар түрмеден шыққан чемпион
Dialogue: 0,0:11:59.05,0:12:01.26,Default,,0,0,0,,‎Оны «тарихтағы ең күшті» деп атаған.
Dialogue: 0,0:12:02.13,0:12:05.59,Default,,0,0,0,,‎Оны «регрессияның бұрандаларын бұрап шығарған адам» деп атаған.
Dialogue: 0,0:12:05.72,0:12:09.14,Default,,0,0,0,,‎Асығыс күші бар жас алтын жүлдегер
Dialogue: 0,0:12:10.22,0:12:12.60,Default,,0,0,0,,‎Екінші раундта оның иегін сындырып алған кезде
Dialogue: 0,0:12:12.73,0:12:15.23,Default,,0,0,0,,Мен бір рет соңғы раундқа дейін күрестім.
Dialogue: 0,0:12:16.11,0:12:18.36,Default,,0,0,0,,Пілдерді жеңе алатын соққысы бар.
Dialogue: 0,0:12:18.61,0:12:20.65,Default,,0,0,0,,‎Жас және күшті чемпион
Dialogue: 0,0:12:21.11,0:12:23.49,Default,,0,0,0,,‎Ол сондай-ақ «тарихтағы ең күшті» деп аталды.
Dialogue: 0,0:12:24.32,0:12:27.91,Default,,0,0,0,,Нәсілшілдік және ұлт
Dialogue: 0,0:12:28.33,0:12:30.62,Default,,0,0,0,,‎Оңай жау жоқ.
Dialogue: 0,0:12:31.91,0:12:34.33,Default,,0,0,0,,‎Ұлы нәрсе күресу шеберлігі емес.
Dialogue: 0,0:12:34.83,0:12:35.92,Default,,0,0,0,,‎Жүрек!
Dialogue: 0,0:12:36.42,0:12:41.13,Default,,0,0,0,,‎Ұлтқа қарсы болса да көнбейтін жүрегің сені ұлы етеді!
Dialogue: 0,0:12:43.88,0:12:46.34,Default,,0,0,0,,Сіздің арманыңыз қандай?
Dialogue: 0,0:12:48.30,0:12:49.43,Default,,0,0,0,,‎Қуат
Dialogue: 0,0:12:50.26,0:12:51.39,Default,,0,0,0,,Қанша?
Dialogue: 0,0:12:52.48,0:12:56.77,Default,,0,0,0,,‎Жер, осы планетадағы ең күшті нәрсе
Dialogue: 0,0:12:57.40,0:12:59.73,Default,,0,0,0,,Бұл күш дегенді білдіре ме?
Dialogue: 0,0:12:59.86,0:13:01.19,Default,,0,0,0,,Олай емес
Dialogue: 0,0:13:01.36,0:13:05.07,Default,,0,0,0,,‎Байлық пен билік онша күрделі емес.
Dialogue: 0,0:13:05.57,0:13:08.66,Default,,0,0,0,,Өте қарапайым физикалық ұрыс күші
Dialogue: 0,0:13:09.62,0:13:11.33,Default,,0,0,0,,‎Ұлы державалардың әскери күші жақсы емес!!!
Dialogue: 0,0:13:11.91,0:13:15.83,Default,,0,0,0,,Абсолютті жауынгерлік күш тек сіздің бес денеңізге негізделген!
Dialogue: 0,0:13:16.46,0:13:18.79,Default,,0,0,0,,А...
Dialogue: 0,0:13:20.17,0:13:21.80,Default,,0,0,0,,Осындай нәрселер...
Dialogue: 0,0:13:21.92,0:13:26.26,Default,,0,0,0,,‎Осындай нәрселерді шынайы ойлайтын адамның алдында тұру
Dialogue: 0,0:13:26.38,0:13:28.39,Default,,0,0,0,,Мен қатты шокпын...
Dialogue: 0,0:13:30.39,0:13:32.39,Default,,0,0,0,,Менің ұлыммен таныс болыңыз!
Dialogue: 0,0:13:33.64,0:13:35.23,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:13:41.61,0:13:42.65,Default,,0,0,0,,‎(Андо) Баки
Dialogue: 0,0:13:43.32,0:13:45.82,Default,,0,0,0,,Мен саған қарыздар боламын, Андо-сан.
Dialogue: 0,0:13:46.53,0:13:48.11,Default,,0,0,0,,‎(Әңгімелеу) Рейичи Андо
Dialogue: 0,0:13:48.70,0:13:52.33,Default,,0,0,0,,Хида тауларында жалғыз тұратын тау сақшысы.
Dialogue: 0,0:13:52.70,0:13:55.25,Default,,0,0,0,,‎Цуки но Рингуманы жалаң қолымен жеңген қаһарлы адам.
Dialogue: 0,0:13:55.79,0:13:58.75,Default,,0,0,0,,Мен Бақиды бала кезінен білемін.
Dialogue: 0,0:14:00.38,0:14:02.71,Default,,0,0,0,,‎Баки сен...
Dialogue: 0,0:14:03.75,0:14:05.80,Default,,0,0,0,,Мен аздап арықтадым.
Dialogue: 0,0:14:06.92,0:14:08.80,Default,,0,0,0,,Көйлегіңізді шешіңіз.
Dialogue: 0,0:14:11.85,0:14:12.68,Default,,0,0,0,,‎(Козуэ) Ах...
Dialogue: 0,0:14:29.70,0:14:30.53,Default,,0,0,0,,‎Мм.
Dialogue: 0,0:14:35.74,0:14:36.95,Default,,0,0,0,,Бұл улы...
Dialogue: 0,0:14:38.16,0:14:42.21,Default,,0,0,0,,‎Табиғи өнімдерден болатын табиғи уланулар
Dialogue: 0,0:14:42.88,0:14:43.84,Default,,0,0,0,,Және...
Dialogue: 0,0:14:44.67,0:14:46.42,Default,,0,0,0,,Ауруханада емдеу мүмкін емес
Dialogue: 0,0:14:49.68,0:14:51.34,Default,,0,0,0,,Онда отырыңыз.
Dialogue: 0,0:14:57.81,0:14:58.64,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:15:14.24,0:15:15.37,Default,,0,0,0,,Баяу…
Dialogue: 0,0:15:15.91,0:15:16.87,Default,,0,0,0,,‎Мм (Коузуэ) Ах.
Dialogue: 0,0:15:17.87,0:15:20.04,Default,,0,0,0,,(Андо) Шарды аулау кезінде.
Dialogue: 0,0:15:21.12,0:15:23.71,Default,,0,0,0,,Қалағаныңызша көп күн үзіліс жасасаңыз, жақсы.
Dialogue: 0,0:15:24.42,0:15:25.42,Default,,0,0,0,,‎(2 адам) А...
Dialogue: 0,0:15:26.80,0:15:27.63,Default,,0,0,0,,А
Dialogue: 0,0:15:28.96,0:15:31.43,Default,,0,0,0,,Андо-санға рахмет
Dialogue: 0,0:15:32.26,0:15:33.09,Default,,0,0,0,,‎(Козуэ) Уф...
Dialogue: 0,0:15:33.39,0:15:34.72,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:15:42.48,0:15:43.81,Default,,0,0,0,,Ауырды
Dialogue: 0,0:15:47.48,0:15:48.32,Default,,0,0,0,,А
Dialogue: 0,0:15:50.19,0:15:51.07,Default,,0,0,0,,‎Уһ…
Dialogue: 0,0:15:55.07,0:15:55.99,Default,,0,0,0,,Даа!
Dialogue: 0,0:15:56.66,0:15:57.66,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:15:57.79,0:15:58.66,Default,,0,0,0,,‎(Андо) Хаха
Dialogue: 0,0:15:58.79,0:16:00.37,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:16:21.06,0:16:24.56,Default,,0,0,0,,‎(жәндіктердің дыбысы)
Dialogue: 0,0:16:25.31,0:16:26.98,Default,,0,0,0,,‎Фу~
Dialogue: 0,0:16:35.11,0:16:36.37,Default,,0,0,0,,‎Бакио
Dialogue: 0,0:16:39.28,0:16:41.20,Default,,0,0,0,,‎Тым кеш
Dialogue: 0,0:16:45.33,0:16:46.92,Default,,0,0,0,,Менің балам
Dialogue: 0,0:16:50.92,0:16:54.88,Default,,0,0,0,,‎Дәлірек айтсақ, бұл менің... арманым.
Dialogue: 0,0:16:55.01,0:16:56.68,Default,,0,0,0,,‎(Арай кіші) Боо
Dialogue: 0,0:16:57.14,0:16:58.93,Default,,0,0,0,,Сіз айтқандай.
Dialogue: 0,0:17:00.47,0:17:03.81,Default,,0,0,0,,‎ Жекпе-жек стилін жетілдіруге тырыстым
Dialogue: 0,0:17:05.39,0:17:08.69,Default,,0,0,0,,‎Ол тек боксқа арналмаған.
Dialogue: 0,0:17:10.32,0:17:11.94,Default,,0,0,0,,‎(қуаныш)
Dialogue: 0,0:17:13.90,0:17:15.20,Default,,0,0,0,,‎(Арай кіші) Бу
Dialogue: 0,0:17:15.57,0:17:18.20,Default,,0,0,0,,‎Буу!
Dialogue: 0,0:17:19.32,0:17:20.95,Default,,0,0,0,,‎Толық еркін стиль
Dialogue: 0,0:17:21.41,0:17:22.29,Default,,0,0,0,,Соққы
Dialogue: 0,0:17:22.70,0:17:23.58,Default,,0,0,0,,Соғу
Dialogue: 0,0:17:24.20,0:17:25.04,Default,,0,0,0,,Грапл
Dialogue: 0,0:17:25.71,0:17:28.92,Default,,0,0,0,,‎Барлық жағдайларға бейімделе алатын жекпе-жек стилі
Dialogue: 0,0:17:30.25,0:17:32.84,Default,,0,0,0,,‎Менің қорғанысым үшін, мысалы, бөгеу және үйректеу
Dialogue: 0,0:17:32.96,0:17:34.97,Default,,0,0,0,,‎Азырақ жақын қашықтықтағы технология
Dialogue: 0,0:17:35.84,0:17:39.30,Default,,0,0,0,,‎Stepback және swayback жиі кездеседі
Dialogue: 0,0:17:39.93,0:17:43.47,Default,,0,0,0,,‎Бұл екі қорғаныс техникасы жалғыз соққылар емес.
Dialogue: 0,0:17:43.93,0:17:46.81,Default,,0,0,0,,Өйткені ол кез келген шабуылға жауап бере алады.
Dialogue: 0,0:17:47.94,0:17:48.85,Default,,0,0,0,,Алайда…
Dialogue: 0,0:17:49.94,0:17:53.73,Default,,0,0,0,,Әскерден жалтару салдарынан 3 жарым жылдық үзілістен кейін
Dialogue: 0,0:17:53.94,0:17:55.99,Default,,0,0,0,,Сіз аяқтарыңыздан айырылдыңыз
Dialogue: 0,0:17:56.95,0:17:59.49,Default,,0,0,0,,Киншасадағы шайқаспен ұсынылған
Dialogue: 0,0:17:59.91,0:18:04.79,Default,,0,0,0,,‎Блоктар мен арқан жұмысын толық пайдаланатын жекпе-жек стиліне айналу
Dialogue: 0,0:18:05.95,0:18:07.66,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:18:08.75,0:18:09.63,Default,,0,0,0,,Нәтижелер…
Dialogue: 0,0:18:10.42,0:18:14.84,Default,,0,0,0,,Менің іздеген стилім елес болып аяқталады
Dialogue: 0,0:18:15.59,0:18:17.17,Default,,0,0,0,,Сіз бұл үшін ұяласыз ба?
Dialogue: 0,0:18:18.34,0:18:19.30,Default,,0,0,0,,Ух...
Dialogue: 0,0:18:20.72,0:18:22.01,Default,,0,0,0,,Боу!
Dialogue: 0,0:18:23.89,0:18:24.77,Default,,0,0,0,,‎Fu bu bu
Dialogue: 0,0:18:25.85,0:18:26.68,Default,,0,0,0,,‎Хаа
Dialogue: 0,0:18:27.31,0:18:28.14,Default,,0,0,0,,Хо
Dialogue: 0,0:18:30.73,0:18:31.90,Default,,0,0,0,,‎Бубобубу…
Dialogue: 0,0:18:34.11,0:18:34.94,Default,,0,0,0,,Боу!
Dialogue: 0,0:18:36.28,0:18:37.49,Default,,0,0,0,,‎Бубобубу…
Dialogue: 0,0:18:42.87,0:18:43.70,Default,,0,0,0,,Боу!
Dialogue: 0,0:18:49.37,0:18:51.17,Default,,0,0,0,,&lrm;  …
Dialogue: 0,0:18:52.96,0:18:53.84,Default,,0,0,0,,Жылама!
Dialogue: 0,0:18:54.17,0:18:55.05,Default,,0,0,0,,Уф
Dialogue: 0,0:18:56.80,0:19:00.05,Default,,0,0,0,,Менің тұқымдарым дүние жүзіне шашылды
Dialogue: 0,0:19:00.51,0:19:04.05,Default,,0,0,0,,Біз балалармен жақсы дос болатын сияқтымыз
Dialogue: 0,0:19:05.72,0:19:07.39,Default,,0,0,0,,Бұл жақсы жекпе-жек болды
Dialogue: 0,0:19:09.48,0:19:11.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:15.65,0:19:17.44,Default,,0,0,0,,‎Ах, а...
Dialogue: 0,0:19:17.57,0:19:19.78,Default,,0,0,0,,Ух...
Dialogue: 0,0:19:24.16,0:19:27.45,Default,,0,0,0,,‎Ах ха ха ха
Dialogue: 0,0:19:27.62,0:19:29.45,Default,,0,0,0,,‎Біз келдік (Козуэ) хаха
Dialogue: 0,0:19:30.37,0:19:31.54,Default,,0,0,0,,‎(Козуэ) Ах...
Dialogue: 0,0:19:31.67,0:19:34.17,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:19:40.72,0:19:41.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:51.44,0:19:53.35,Default,,0,0,0,,‎4 жыл болды (Козуэ) А...
Dialogue: 0,0:19:55.81,0:19:57.52,Default,,0,0,0,,‎Пекин адамы?
Dialogue: 0,0:19:57.69,0:20:00.90,Default,,0,0,0,,‎Хахаха, бұл Жапония.
Dialogue: 0,0:20:04.11,0:20:09.83,Default,,0,0,0,,‎Бұл жерде біз берген уәде: «Мен енді ешқашан ешкімге жеңілмеймін»
Dialogue: 0,0:20:11.46,0:20:13.08,Default,,0,0,0,,Бүгінге дейін...
Dialogue: 0,0:20:14.50,0:20:16.25,Default,,0,0,0,,Сіз қанша рет ұтылдыңыз?
Dialogue: 0,0:20:17.38,0:20:18.80,Default,,0,0,0,,Ал енді...
Dialogue: 0,0:20:19.50,0:20:25.14,Default,,0,0,0,,Ең ауыр жеңіліске ұшырау туралы
Dialogue: 0,0:20:29.56,0:20:30.64,Default,,0,0,0,,‎ (Коузуэ) Ах.
Dialogue: 0,0:20:31.85,0:20:33.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:33.56,0:20:34.60,Default,,0,0,0,,‎Гобусата
Dialogue: 0,0:20:34.90,0:20:35.73,Default,,0,0,0,,А?
Dialogue: 0,0:20:36.69,0:20:38.90,Default,,0,0,0,,‎(Кузуэнің айқайы)
Dialogue: 0,0:20:41.36,0:20:43.32,Default,,0,0,0,,Ұмыттың ба, Қозуэ?
Dialogue: 0,0:20:43.86,0:20:46.62,Default,,0,0,0,,‎Ол ең үлкен турнирдің ойыншысы.
Dialogue: 0,0:20:46.74,0:20:47.66,Default,,0,0,0,,Е...
Dialogue: 0,0:20:48.66,0:20:50.16,Default,,0,0,0,,‎(Әңгімелеу) Яшазару кіші.
Dialogue: 0,0:20:50.58,0:20:54.41,Default,,0,0,0,,Ежелден Хида тауларында өмір сүрген жұмбақ ұлы маймыл.
Dialogue: 0,0:20:55.08,0:20:58.21,Default,,0,0,0,,Оның ата-анасын Юдзиро аяусыз өлтірді.
Dialogue: 0,0:20:58.46,0:21:03.55,Default,,0,0,0,,‎Ол жаудан кек алуға ант еткен Бақимен тіл табысады.
Dialogue: 0,0:21:05.84,0:21:07.43,Default,,0,0,0,,‎(Яшазару кіші) Гуруру…
Dialogue: 0,0:21:07.93,0:21:09.68,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:21:22.23,0:21:23.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.15,0:21:26.74,Default,,0,0,0,,‎Хмм, мен қонақпын.
Dialogue: 0,0:21:31.08,0:21:32.41,Default,,0,0,0,,Рецу-сан!
Dialogue: 0,0:21:32.91,0:21:34.33,Default,,0,0,0,,‎Неге келдің?
Dialogue: 0,0:21:35.00,0:21:37.83,Default,,0,0,0,,‎(Андо) Бұл мені алаңдатып отырғандықтан шығар.
Dialogue: 0,0:21:38.33,0:21:39.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:40.42,0:21:41.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:42.80,0:21:43.67,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:21:52.89,0:21:53.72,Default,,0,0,0,,Уф
Dialogue: 0,0:21:56.56,0:21:57.77,Default,,0,0,0,,‎Баки-кун!
Dialogue: 0,0:22:00.69,0:22:02.27,Default,,0,0,0,,‎(Ретсу) Қалғанын маған қалдыр.
Dialogue: 0,0:22:02.98,0:22:04.48,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:22:05.03,0:22:06.36,Default,,0,0,0,,‎(Козуэ) Эй! (Тікұшақ роторының дыбысы)
Dialogue: 0,0:22:06.49,0:22:07.53,Default,,0,0,0,,‎(Ретсу) Иә (Андо) Иә?
Dialogue: 0,0:22:07.65,0:22:08.49,Default,,0,0,0,,‎(Козуэ) Ах.
Dialogue: 0,0:22:12.45,0:22:13.33,Default,,0,0,0,,А...
Dialogue: 0,0:22:21.08,0:22:27.09,Default,,0,0,0,,‎♪〜
