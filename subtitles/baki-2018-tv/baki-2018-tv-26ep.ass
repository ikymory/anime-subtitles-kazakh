Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.30,0:00:17.30,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:46.81,0:01:48.90,Default,,0,0,0,,‎(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:01:57.82,0:01:59.16,Default,,0,0,0,,‎(Ван: қытай тілінде) Ван және келесі 4 адам
Dialogue: 0,0:02:00.99,0:02:01.91,Default,,0,0,0,,‎(Ретсу) Еңбегіңіз үшін рахмет!
Dialogue: 0,0:02:02.33,0:02:04.16,Default,,0,0,0,,Сіз естігеніңіздей.
Dialogue: 0,0:02:07.33,0:02:08.16,Default,,0,0,0,,‎(Козуэ) А...
Dialogue: 0,0:02:09.42,0:02:11.67,Default,,0,0,0,,‎(Андо) Козуэ-чан уайымдама
Dialogue: 0,0:02:12.21,0:02:16.42,Default,,0,0,0,,мырза. Реккайу Қытайдағы өте танымал адам.
Dialogue: 0,0:02:18.38,0:02:19.93,Default,,0,0,0,,‎(Токугава) Ах...
Dialogue: 0,0:02:20.09,0:02:20.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.76,0:02:23.01,Default,,0,0,0,,‎Нихао
Dialogue: 0,0:02:26.60,0:02:30.73,Default,,0,0,0,,‎Әртүрлі салаларда көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:02:30.90,0:02:32.69,Default,,0,0,0,,‎(Токугава) Ақылсыз сөздер айтпа
Dialogue: 0,0:02:33.27,0:02:35.94,Default,,0,0,0,,‎Бұл мен алғыс айтқым келеді.
Dialogue: 0,0:02:36.11,0:02:38.44,Default,,0,0,0,,Сіз жақсы ұсыныс жасадыңыз.
Dialogue: 0,0:02:39.24,0:02:41.45,Default,,0,0,0,,‎Мен сені құтқарамын... сөзсіз!
Dialogue: 0,0:02:41.78,0:02:44.28,Default,,0,0,0,,Ешқандай формальдылық қажет емес!
Dialogue: 0,0:02:44.45,0:02:46.95,Default,,0,0,0,,Қытайға ұшыңыз!
Dialogue: 0,0:03:04.80,0:03:07.47,Default,,0,0,0,,‎(Козуэ) Не... тозақ...?
Dialogue: 0,0:03:08.22,0:03:09.85,Default,,0,0,0,,Сіз қайда бара жатырсыз?
Dialogue: 0,0:03:20.24,0:03:23.49,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:03:26.08,0:03:26.99,Default,,0,0,0,,А...
Dialogue: 0,0:03:32.83,0:03:34.63,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:03:40.80,0:03:42.05,Default,,0,0,0,,А...
Dialogue: 0,0:03:48.26,0:03:51.56,Default,,0,0,0,,‎Бұл қайда?
Dialogue: 0,0:04:02.70,0:04:04.20,Default,,0,0,0,,Қытай мейрамханасы?
Dialogue: 0,0:04:06.74,0:04:07.58,Default,,0,0,0,,А...
Dialogue: 0,0:04:09.08,0:04:10.33,Default,,0,0,0,,‎(Бала) Ояусың ба?
Dialogue: 0,0:04:11.04,0:04:12.71,Default,,0,0,0,,Мен саған тамақ әкелдім.
Dialogue: 0,0:04:15.17,0:04:16.83,Default,,0,0,0,,‎Дәрілік тағамдар...
Dialogue: 0,0:04:17.46,0:04:20.09,Default,,0,0,0,,‎Мм... міне...?
Dialogue: 0,0:04:22.34,0:04:24.09,Default,,0,0,0,,‎(Лю) Сіз не айттыңыз?
Dialogue: 0,0:04:25.01,0:04:29.10,Default,,0,0,0,,Сол бала платформаға шыққанда...
Dialogue: 0,0:04:29.72,0:04:33.98,Default,,0,0,0,,‎Мен сізді мазақ ету немесе алдау ниетім жоқ.
Dialogue: 0,0:04:34.73,0:04:36.94,Default,,0,0,0,,Сол бала перронда тұр
Dialogue: 0,0:04:37.15,0:04:40.61,Default,,0,0,0,,‎Және ол мұны істеуге толық жарамды.
Dialogue: 0,0:04:41.11,0:04:43.07,Default,,0,0,0,,‎Жылдың соңы біткен жоқ.
Dialogue: 0,0:04:43.40,0:04:47.62,Default,,0,0,0,,‎Ал уланған бала?
Dialogue: 0,0:04:47.95,0:04:49.58,Default,,0,0,0,,‎Жылдың соңы біткен жоқ.
Dialogue: 0,0:04:50.33,0:04:53.12,Default,,0,0,0,,‎Уланған бала
Dialogue: 0,0:04:53.71,0:04:57.88,Default,,0,0,0,,‎Ол әлі де соған лайық.
Dialogue: 0,0:05:01.96,0:05:02.88,Default,,0,0,0,,‎(Лиу) Рецу...
Dialogue: 0,0:05:03.76,0:05:06.38,Default,,0,0,0,,‎Оны қалай дәлелдейсіз?
Dialogue: 0,0:05:10.89,0:05:12.72,Default,,0,0,0,,‎Дұрыс~
Dialogue: 0,0:05:12.89,0:05:14.14,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:05:14.98,0:05:16.35,Default,,0,0,0,,Мұндағы монах...
Dialogue: 0,0:05:17.06,0:05:19.61,Default,,0,0,0,,‎Сене алатын адаммен
Dialogue: 0,0:05:20.06,0:05:22.86,Default,,0,0,0,,Екеуміз кездескенде оның қандай болатынын көрейік.
Dialogue: 0,0:05:23.03,0:05:25.90,Default,,0,0,0,,‎
Dialogue: 0,0:05:26.57,0:05:27.66,Default,,0,0,0,,‎Рецуё
Dialogue: 0,0:05:28.36,0:05:29.20,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:05:29.78,0:05:31.95,Default,,0,0,0,,‎(Лиу) Ониши Жапонияда
Dialogue: 0,0:05:32.37,0:05:36.71,Default,,0,0,0,,‎17 жасар бала ес-түссіз күйде ұсталды
Dialogue: 0,0:05:37.08,0:05:39.67,Default,,0,0,0,,Мен бұл туралы естідім...
Dialogue: 0,0:05:41.17,0:05:42.42,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:05:43.00,0:05:45.67,Default,,0,0,0,,Иә, ол Баки Ханма.
Dialogue: 0,0:05:46.13,0:05:47.18,Default,,0,0,0,,‎(Жоғары шәкірт) Сол қыз...
Dialogue: 0,0:05:47.34,0:05:48.59,Default,,0,0,0,,‎(аға шәкірт) Жоқ...
Dialogue: 0,0:05:58.56,0:06:00.94,Default,,0,0,0,,‎Чжанға қоңырау шалыңыз
Dialogue: 0,0:06:01.44,0:06:02.36,Default,,0,0,0,,‎(аға шәкірт) Роши...
Dialogue: 0,0:06:02.52,0:06:04.19,Default,,0,0,0,,‎(Шәкірт) Чжан...?
Dialogue: 0,0:06:04.73,0:06:05.82,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:06:08.86,0:06:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:12.49,0:06:14.70,Default,,0,0,0,,Мұның ақылсыз екенін бәрі біледі.
Dialogue: 0,0:06:15.12,0:06:17.62,Default,,0,0,0,,‎Бірақ біз жеңуіміз керек
Dialogue: 0,0:06:18.54,0:06:19.96,Default,,0,0,0,,Чжанмен жекпе-жек.
Dialogue: 0,0:06:20.50,0:06:21.46,Default,,0,0,0,,‎Уһ…
Dialogue: 0,0:06:23.04,0:06:23.96,Default,,0,0,0,,‎Кузуэ…
Dialogue: 0,0:06:24.63,0:06:25.67,Default,,0,0,0,,А...
Dialogue: 0,0:06:26.59,0:06:28.42,Default,,0,0,0,,‎Рахмет~
Dialogue: 0,0:06:29.51,0:06:30.34,Default,,0,0,0,,...?
Dialogue: 0,0:06:36.72,0:06:41.48,Default,,0,0,0,,‎Рэцу-сан мені осылай ұрысуға болады деп ойлайды.
Dialogue: 0,0:06:42.11,0:06:43.48,Default,,0,0,0,,Қашпа
Dialogue: 0,0:06:44.07,0:06:45.48,Default,,0,0,0,,‎Ал егер сіз жеңсеңіз...
Dialogue: 0,0:06:47.07,0:06:48.15,Default,,0,0,0,,Си Си
Dialogue: 0,0:06:52.87,0:06:53.91,Default,,0,0,0,,‎(Әңгімелеу) Учива—
Dialogue: 0,0:06:54.41,0:06:57.75,Default,,0,0,0,,Құрал ретінде тек өз мүшелерін пайдаланады
Dialogue: 0,0:06:57.91,0:07:00.41,Default,,0,0,0,,‎Тау жыныстарын сыпыруды жалғастыруға жаттықтыру
Dialogue: 0,0:07:01.17,0:07:03.79,Default,,0,0,0,,‎Тек жақсы дайындалған жұдырығы барлар
Dialogue: 0,0:07:03.96,0:07:07.34,Default,,0,0,0,,Сіз тастарды шар тәрізді құлата аласыз.
Dialogue: 0,0:07:09.84,0:07:11.84,Default,,0,0,0,,‎Келесі теңіз патшасының кандидаты
Dialogue: 0,0:07:12.26,0:07:14.22,Default,,0,0,0,,‎Чжан Ян Ван пайда болады
Dialogue: 0,0:07:14.55,0:07:17.14,Default,,0,0,0,,‎(Чжан) Ол адам қайда?
Dialogue: 0,0:07:17.43,0:07:20.77,Default,,0,0,0,,‎(Монк) Енді бірінші матч алаңына қарай.
Dialogue: 0,0:07:21.48,0:07:22.60,Default,,0,0,0,,‎(Чжан) Мм!
Dialogue: 0,0:07:23.31,0:07:25.11,Default,,0,0,0,,‎Тегін емес!
Dialogue: 0,0:07:39.91,0:07:41.16,Default,,0,0,0,,‎(Чжан) Бұл бала...
Dialogue: 0,0:07:42.71,0:07:45.17,Default,,0,0,0,,Аңызға айналған платформаға өтіңіз...
Dialogue: 0,0:07:47.42,0:07:49.67,Default,,0,0,0,,‎Бұл қорлау болмаса ше?
Dialogue: 0,0:07:50.88,0:07:52.18,Default,,0,0,0,,Екеуі де Алдыңғы
Dialogue: 0,0:07:55.93,0:07:57.47,Default,,0,0,0,,‎(Чжан) Міне бітті.
Dialogue: 0,0:07:57.64,0:07:59.31,Default,,0,0,0,,Ешқандай тор немесе боқ болмайды.
Dialogue: 0,0:08:01.10,0:08:01.93,Default,,0,0,0,,‎(Козуэ) Ах...
Dialogue: 0,0:08:02.60,0:08:03.94,Default,,0,0,0,,бұл...
Dialogue: 0,0:08:04.69,0:08:05.56,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:08:05.98,0:08:07.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:07.57,0:08:08.82,Default,,0,0,0,,‎(Чжан) А...?
Dialogue: 0,0:08:09.98,0:08:10.82,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:08:11.49,0:08:12.32,Default,,0,0,0,,Doo!
Dialogue: 0,0:08:13.24,0:08:14.07,Default,,0,0,0,,‎(Чжан) Ах!
Dialogue: 0,0:08:14.57,0:08:16.03,Default,,0,0,0,,‎Ух... а?
Dialogue: 0,0:08:19.29,0:08:20.12,Default,,0,0,0,,А...?
Dialogue: 0,0:08:20.58,0:08:22.25,Default,,0,0,0,,‎Хехе!
Dialogue: 0,0:08:22.75,0:08:23.58,Default,,0,0,0,,Хехе!
Dialogue: 0,0:08:23.75,0:08:24.58,Default,,0,0,0,,А...
Dialogue: 0,0:08:27.04,0:08:28.09,Default,,0,0,0,,‎(монахтар) О!
Dialogue: 0,0:08:28.63,0:08:29.46,Default,,0,0,0,,‎(Retsu) Hmph
Dialogue: 0,0:08:30.17,0:08:31.13,Default,,0,0,0,,А...!
Dialogue: 0,0:08:32.17,0:08:33.01,Default,,0,0,0,,‎(Чжан) Шу
Dialogue: 0,0:08:33.59,0:08:39.35,Default,,0,0,0,,Не?
Dialogue: 0,0:08:40.89,0:08:42.31,Default,,0,0,0,,‎(монах) Чжанның жұдырығы...
Dialogue: 0,0:08:42.48,0:08:43.60,Default,,0,0,0,,‎(Монк) Дұрыс емес...
Dialogue: 0,0:08:45.10,0:08:46.35,Default,,0,0,0,,‎(монах) Жай ғана...
Dialogue: 0,0:08:48.56,0:08:49.44,Default,,0,0,0,,‎(Чжан) Хмм...!
Dialogue: 0,0:08:53.28,0:08:54.11,Default,,0,0,0,,‎Дей!
Dialogue: 0,0:08:54.78,0:08:55.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:55.78,0:08:56.61,Default,,0,0,0,,‎Nuo!
Dialogue: 0,0:08:57.87,0:08:59.49,Default,,0,0,0,,Иә? Ха! Ах...
Dialogue: 0,0:08:59.74,0:09:00.91,Default,,0,0,0,,‎Аа... иә...?
Dialogue: 0,0:09:01.83,0:09:03.96,Default,,0,0,0,,‎Мм! Хмм...
Dialogue: 0,0:09:05.46,0:09:08.13,Default,,0,0,0,,‎
Dialogue: 0,0:09:09.92,0:09:10.75,Default,,0,0,0,,‎(Чжан) А...?
Dialogue: 0,0:09:11.75,0:09:12.96,Default,,0,0,0,,‎Ааа...
Dialogue: 0,0:09:13.67,0:09:16.13,Default,,0,0,0,,‎
Dialogue: 0,0:09:16.80,0:09:17.64,Default,,0,0,0,,Ух...
Dialogue: 0,0:09:22.22,0:09:23.56,Default,,0,0,0,,А...
Dialogue: 0,0:09:25.06,0:09:25.89,Default,,0,0,0,,‎Фу…
Dialogue: 0,0:09:26.81,0:09:27.65,Default,,0,0,0,,‎(Чжан) бұл...!
Dialogue: 0,0:09:28.10,0:09:29.06,Default,,0,0,0,,‎Ku…
Dialogue: 0,0:09:29.73,0:09:31.07,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:09:32.32,0:09:33.15,Default,,0,0,0,,Роши
Dialogue: 0,0:09:33.86,0:09:36.65,Default,,0,0,0,,‎Бұл матчты жалғастырғыңыз келе ме?
Dialogue: 0,0:09:37.03,0:09:38.53,Default,,0,0,0,,‎(Чжан) Иә! ау
Dialogue: 0,0:09:41.03,0:09:42.29,Default,,0,0,0,,‎Уф... Күрсін...
Dialogue: 0,0:09:43.54,0:09:44.58,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:09:45.37,0:09:47.46,Default,,0,0,0,,‎Уф... Иә!
Dialogue: 0,0:09:47.62,0:09:48.46,Default,,0,0,0,,О...?
Dialogue: 0,0:09:52.46,0:09:55.30,Default,,0,0,0,,‎(монахтар) О...!
Dialogue: 0,0:09:58.38,0:09:59.22,Default,,0,0,0,,бұл...
Dialogue: 0,0:10:02.68,0:10:03.72,Default,,0,0,0,,Менің…
Dialogue: 0,0:10:04.97,0:10:05.81,Default,,0,0,0,,Сіз жеңілдіңіз.
Dialogue: 0,0:10:05.98,0:10:07.35,Default,,0,0,0,,‎(монахтар) О!
Dialogue: 0,0:10:07.52,0:10:08.35,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:10:09.27,0:10:10.73,Default,,0,0,0,,бұл...
Dialogue: 0,0:10:13.86,0:10:17.15,Default,,0,0,0,,‎(Әңгімелеу) Ханма Баки Дайотайсайға қатысу
Dialogue: 0,0:10:21.45,0:10:24.87,Default,,0,0,0,,‎(жәндіктердің дыбысы)
Dialogue: 0,0:10:27.87,0:10:29.37,Default,,0,0,0,,‎“Райтай”?
Dialogue: 0,0:10:30.67,0:10:32.63,Default,,0,0,0,,‎(Рецу) «Голдай» деп жазылған.
Dialogue: 0,0:10:35.13,0:10:38.92,Default,,0,0,0,,Қытай мен Тайваньда өткен жекпе-жек турнирлері
Dialogue: 0,0:10:39.38,0:10:42.51,Default,,0,0,0,,‎Бұл ойын алаңы қытай тілінде осылай аталады.
Dialogue: 0,0:10:43.05,0:10:44.64,Default,,0,0,0,,Сонымен... Бақи.
Dialogue: 0,0:10:46.14,0:10:48.35,Default,,0,0,0,,Сіз сол платформаға шығасыз.
Dialogue: 0,0:10:50.02,0:10:51.40,Default,,0,0,0,,Мен өлемін...
Dialogue: 0,0:10:51.81,0:10:54.07,Default,,0,0,0,,‎Оны жалғыз қалдырсаңыз, көмектеспейді!
Dialogue: 0,0:10:54.23,0:10:56.65,Default,,0,0,0,,Бұл аман қалу үшін күрес
Dialogue: 0,0:10:57.15,0:10:58.94,Default,,0,0,0,,‎Бірақ мен өлемін
Dialogue: 0,0:10:59.61,0:11:02.16,Default,,0,0,0,,Күресу тым көп.
Dialogue: 0,0:11:03.03,0:11:05.95,Default,,0,0,0,,Мен Козуэ-санның не айтқысы келгенін түсіндім.
Dialogue: 0,0:11:06.41,0:11:08.45,Default,,0,0,0,,Алайда, Қытай кең
Dialogue: 0,0:11:08.83,0:11:11.17,Default,,0,0,0,,‎Ал Қытайдың жекпе-жек өнері терең
Dialogue: 0,0:11:12.42,0:11:15.38,Default,,0,0,0,,Менің айтып отырғаным психология емес.
Dialogue: 0,0:11:15.88,0:11:20.17,Default,,0,0,0,,Күрес практикалық емдеу ретінде қажет
Dialogue: 0,0:11:21.30,0:11:23.18,Default,,0,0,0,,‎(Коузуэ) Ха... ой...
Dialogue: 0,0:11:24.72,0:11:29.18,Default,,0,0,0,,‎Ұлы Гыңдай Сай 100 жылда бір рет өткізіледі.
Dialogue: 0,0:11:30.60,0:11:32.19,Default,,0,0,0,,100 жыл?
Dialogue: 0,0:11:32.73,0:11:34.31,Default,,0,0,0,,Ежелгі Рим кезеңі
Dialogue: 0,0:11:34.90,0:11:38.44,Default,,0,0,0,,‎Көптеген адамдардың қолдауына ие болған аралас жекпе-жек —
Dialogue: 0,0:11:38.78,0:11:42.03,Default,,0,0,0,,Сіз панкратионның жойылғанын білесіз бе?
Dialogue: 0,0:11:42.20,0:11:43.03,Default,,0,0,0,,О
Dialogue: 0,0:11:43.20,0:11:44.45,Default,,0,0,0,,‎(Kzue) Панкратион?
Dialogue: 0,0:11:44.91,0:11:49.45,Default,,0,0,0,,Тарих кітаптарында көптеген дәлелді себептер келтірілген.
Dialogue: 0,0:11:49.58,0:11:51.54,Default,,0,0,0,,‎Бұл олай емес.
Dialogue: 0,0:11:52.04,0:11:53.92,Default,,0,0,0,,‎Бір ғана шындық бар
Dialogue: 0,0:11:56.25,0:11:59.30,Default,,0,0,0,,‎Жеңімпаз жергілікті римдік емес
Dialogue: 0,0:11:59.46,0:12:02.22,Default,,0,0,0,,‎Себебі біз қытайланып кеттік.
Dialogue: 0,0:12:03.88,0:12:07.64,Default,,0,0,0,,Панкратионның тарихы Қытай Кемпоға қарсы
Dialogue: 0,0:12:08.14,0:12:12.69,Default,,0,0,0,,‎Ли Хэ-Ванг, сол кездегі кунг-фу гурусы жауынгер ретінде жаттығуда.
Dialogue: 0,0:12:13.23,0:12:17.69,Default,,0,0,0,,Римдік Дрьясқа қарсы күрестен бастау алған.
Dialogue: 0,0:12:18.65,0:12:19.61,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:20.03,0:12:21.61,Default,,0,0,0,,‎Гухаа…
Dialogue: 0,0:12:22.11,0:12:23.70,Default,,0,0,0,,‎(Ретсу) Бұл жекпе-жекті мүмкіндік ретінде қабылдау
Dialogue: 0,0:12:24.11,0:12:29.12,Default,,0,0,0,,‎Қытай кемпошылары сол жолды бірінен соң бірі кесіп өтеді.
Dialogue: 0,0:12:30.74,0:12:32.62,Default,,0,0,0,,‎Кейде тәжірибесіз тәжірибеші
Dialogue: 0,0:12:32.79,0:12:37.25,Default,,0,0,0,,‎Тәзіле-бітімнен тайып, ащы кесе ішкен кездерім болды.
Dialogue: 0,0:12:37.92,0:12:39.88,Default,,0,0,0,,‎Біздің халқымыз бастапқыда болған
Dialogue: 0,0:12:40.30,0:12:43.63,Default,,0,0,0,,‎Тамақпен күресу және т.б.
Dialogue: 0,0:12:43.80,0:12:46.80,Default,,0,0,0,,‎Түйсікке негізделген нәрсені іздеуге деген табандылық
Dialogue: 0,0:12:46.97,0:12:49.26,Default,,0,0,0,,‎Басқа ұлт өкілдерінің үлгі алуына жол бермеңіз
Dialogue: 0,0:12:50.26,0:12:53.98,Default,,0,0,0,,‎Көп жылдық оқудан кейін
Dialogue: 0,0:12:54.48,0:12:55.64,Default,,0,0,0,,Соңында...
Dialogue: 0,0:12:55.81,0:12:57.73,Default,,0,0,0,,Римдіктерден ешқашан асып түспеді
Dialogue: 0,0:12:57.90,0:12:59.65,Default,,0,0,0,,Қабырғаға айналды
Dialogue: 0,0:13:01.15,0:13:02.94,Default,,0,0,0,,Мақтаншақ римдіктер
Dialogue: 0,0:13:03.11,0:13:07.20,Default,,0,0,0,,‎Біз кунг-фуды «Шығыс айдаһары» деп атаймыз және одан қорқамыз.
Dialogue: 0,0:13:07.78,0:13:11.16,Default,,0,0,0,,‎Сіздер «Жібек жолы» деп атайтын жол
Dialogue: 0,0:13:12.24,0:13:15.79,Default,,0,0,0,,«Айдаһар Лорд» деп аталды және оны жек көрді
Dialogue: 0,0:13:19.25,0:13:23.80,Default,,0,0,0,,‎Рим халқы жергілікті халықтың жеңіске жетуі мүмкін емес екенін түсінді.
Dialogue: 0,0:13:24.17,0:13:26.01,Default,,0,0,0,,Ақырында өз қолыммен
Dialogue: 0,0:13:26.18,0:13:29.55,Default,,0,0,0,,‎Панкратион тарихы жабылды.
Dialogue: 0,0:13:30.35,0:13:31.56,Default,,0,0,0,,А...
Dialogue: 0,0:13:31.97,0:13:32.97,Default,,0,0,0,,‎(Лю) бірақ
Dialogue: 0,0:13:33.14,0:13:38.31,Default,,0,0,0,,Қытайда тарих үзіліссіз жалғасуда.
Dialogue: 0,0:13:39.65,0:13:41.82,Default,,0,0,0,,Қытайдағы панкратион?
Dialogue: 0,0:13:42.57,0:13:45.03,Default,,0,0,0,,Нағыз теңіз патшасын анықтау —
Dialogue: 0,0:13:45.24,0:13:47.07,Default,,0,0,0,,Нағыз нәжіс
Dialogue: 0,0:13:48.28,0:13:50.07,Default,,0,0,0,,Нағыз теңіз патшасы?
Dialogue: 0,0:13:50.24,0:13:51.08,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:13:51.53,0:13:54.79,Default,,0,0,0,,Иә, мен Лю Кай патшамын.
Dialogue: 0,0:13:54.95,0:13:58.08,Default,,0,0,0,,‎Ал міне, Реккайо.
Dialogue: 0,0:14:00.13,0:14:03.84,Default,,0,0,0,,‎Бірнеше теңіз патшалары бүкіл Қытайға шашыраңқы болды
Dialogue: 0,0:14:04.21,0:14:07.84,Default,,0,0,0,,‎Ол теңіз патшалары теңіз патшасы болу үшін
Dialogue: 0,0:14:14.22,0:14:15.85,Default,,0,0,0,,‎Мұндай турнирде...
Dialogue: 0,0:14:17.39,0:14:18.85,Default,,0,0,0,,‎Бұл жағдайда...
Dialogue: 0,0:14:19.56,0:14:20.85,Default,,0,0,0,,бұл…
Dialogue: 0,0:14:21.31,0:14:24.78,Default,,0,0,0,,‎Хехехехе, шыққың келеді
Dialogue: 0,0:14:25.69,0:14:27.86,Default,,0,0,0,,‎Мен... шыққым келеді ме?
Dialogue: 0,0:14:30.82,0:14:33.87,Default,,0,0,0,,Ішке ашулы адам кірді
Dialogue: 0,0:14:35.79,0:14:36.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:37.79,0:14:38.62,Default,,0,0,0,,Иә
Dialogue: 0,0:14:38.96,0:14:40.88,Default,,0,0,0,,‎Ха! Мүмкін емес!
Dialogue: 0,0:14:57.14,0:14:58.60,Default,,0,0,0,,‎(Юдзиро) Гонконгқа ұшыңыз!
Dialogue: 0,0:14:58.81,0:14:59.64,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:15:01.77,0:15:05.65,Default,,0,0,0,,‎(Әңгімелеу) Юдзиро Ханма Дайгиотайсайға қатысады
Dialogue: 0,0:15:06.82,0:15:09.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:10.11,0:15:16.12,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:15:16.33,0:15:18.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:18.41,0:15:19.91,Default,,0,0,0,,Менің әкем келе жатыр ма?
Dialogue: 0,0:15:20.41,0:15:26.34,Default,,0,0,0,,Сіздің әкеңіздің «жер бетіндегі ең күшті жаратылыс» атағы
Dialogue: 0,0:15:26.71,0:15:30.26,Default,,0,0,0,,‎Бұл жерге Қытайға дейін жетті.
Dialogue: 0,0:15:30.84,0:15:33.43,Default,,0,0,0,,‎Біз теңіз патшасының атына бәс тігеміз
Dialogue: 0,0:15:33.59,0:15:37.43,Default,,0,0,0,,Мен Юдзиро Ханма мырзаны қарсы алғым келеді...
Dialogue: 0,0:15:38.56,0:15:39.68,Default,,0,0,0,,‎Рецуё
Dialogue: 0,0:15:40.23,0:15:45.19,Default,,0,0,0,,‎Маған Юдзиро мырзадан Жапонияда көрген әсеріңізді айта аласыз ба?
Dialogue: 0,0:15:45.86,0:15:47.61,Default,,0,0,0,,Соғысқа қатысуы
Dialogue: 0,0:15:47.98,0:15:53.70,Default,,0,0,0,,‎Қытай жекпе-жек өнерінің гүлденген тарихы, мүмкін бұрын-соңды болмаған оқиға
Dialogue: 0,0:15:55.37,0:15:58.62,Default,,0,0,0,,‎Бұл сұраққа жауап бермесе де
Dialogue: 0,0:15:58.79,0:16:02.71,Default,,0,0,0,,Бұл оның соншалықты қабілеті бар дегенді білдіре ме?
Dialogue: 0,0:16:03.33,0:16:04.17,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:16:04.33,0:16:05.71,Default,,0,0,0,,‎Уф... Уф
Dialogue: 0,0:16:07.38,0:16:08.63,Default,,0,0,0,,Мысалы
Dialogue: 0,0:16:09.38,0:16:13.93,Default,,0,0,0,,Қарулы күштердің ірі державалар шығарған заманауи қаруды қолдануына жауап ретінде
Dialogue: 0,0:16:14.47,0:16:16.10,Default,,0,0,0,,Біз Кемпо тәжірибешілері
Dialogue: 0,0:16:16.26,0:16:20.39,Default,,0,0,0,,Бұл қару ретінде тек жалаң қолмен ұрысқа ұқсайды.
Dialogue: 0,0:16:21.06,0:16:23.48,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:16:23.89,0:16:25.60,Default,,0,0,0,,‎Мынау
Dialogue: 0,0:16:25.77,0:16:29.73,Default,,0,0,0,,‎Сонда, әрине, нәтижені көре аласыз, солай ма?
Dialogue: 0,0:16:30.23,0:16:31.07,Default,,0,0,0,,Иә
Dialogue: 0,0:16:31.57,0:16:34.24,Default,,0,0,0,,‎Біздің қытайлық жекпе-жек өнерінің жарқын жеңісі.
Dialogue: 0,0:16:34.41,0:16:35.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:35.41,0:16:36.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:37.87,0:16:40.49,Default,,0,0,0,,‎(Лю) Түн кеш батты.
Dialogue: 0,0:16:42.12,0:16:43.25,Default,,0,0,0,,‎(Монк) Кешіріңіз.
Dialogue: 0,0:16:43.79,0:16:44.67,Default,,0,0,0,,‎Роши…
Dialogue: 0,0:16:49.63,0:16:50.92,Default,,0,0,0,,‎Не…
Dialogue: 0,0:16:51.42,0:16:53.51,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:16:54.05,0:16:57.01,Default,,0,0,0,,‎Бұл өте көңілді түн.
Dialogue: 0,0:17:01.64,0:17:03.77,Default,,0,0,0,,‎(Монк) Сәл күте тұрыңыз.
Dialogue: 0,0:17:03.93,0:17:06.27,Default,,0,0,0,,Жақында Дошу келеді.
Dialogue: 0,0:17:06.60,0:17:09.52,Default,,0,0,0,,‎(Арай кіші) Кешіріңіз, мен істей алмаймын дедім.
Dialogue: 0,0:17:09.98,0:17:11.78,Default,,0,0,0,,‎Бірақ күткендей.
Dialogue: 0,0:17:11.94,0:17:14.53,Default,,0,0,0,,‎Осындай уақытта да жауап бергеніңіз үшін рахмет.
Dialogue: 0,0:17:15.32,0:17:16.95,Default,,0,0,0,,‎(Лю) Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:17:20.62,0:17:22.04,Default,,0,0,0,,Үлкен
Dialogue: 0,0:17:24.71,0:17:25.54,Default,,0,0,0,,О
Dialogue: 0,0:17:26.33,0:17:31.63,Default,,0,0,0,,Шынында да, ол ұлы боксшы Магомед Алайға ұқсайды.
Dialogue: 0,0:17:32.30,0:17:34.76,Default,,0,0,0,,‎(Кіші Арай) 100 жылда бір рет болатын Ұлы Гингдай Сай
Dialogue: 0,0:17:35.09,0:17:39.39,Default,,0,0,0,,Қытай ұлты жоқ адамдар да қатыса алады деп естідім.
Dialogue: 0,0:17:39.60,0:17:41.56,Default,,0,0,0,,‎(Лю) Сіз айтқандай,
Dialogue: 0,0:17:42.22,0:17:43.06,Default,,0,0,0,,Тек...
Dialogue: 0,0:17:44.18,0:17:46.14,Default,,0,0,0,,‎Өз күшіңді көрсет...
Dialogue: 0,0:17:46.89,0:17:48.90,Default,,0,0,0,,Сіздің әкеңіз
Dialogue: 0,0:17:49.15,0:17:52.11,Default,,0,0,0,,‎Осы өмір жолында ашылуы
Dialogue: 0,0:17:52.40,0:17:55.03,Default,,0,0,0,,Сіз дәлелдеуді жалғастырғаныңыздай.
Dialogue: 0,0:17:55.19,0:17:56.32,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:18:09.75,0:18:11.59,Default,,0,0,0,,‎(Арай кіші) Иә! (Жоғары студент) Гуа!
Dialogue: 0,0:18:13.71,0:18:16.05,Default,,0,0,0,,‎(Жоғары шәкірт) Агаға...
Dialogue: 0,0:18:19.64,0:18:20.84,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:18:21.43,0:18:24.22,Default,,0,0,0,,Біреу қолғаптарыңызды шешіп бере ала ма?
Dialogue: 0,0:18:25.10,0:18:26.85,Default,,0,0,0,,‎
Dialogue: 0,0:18:27.23,0:18:31.73,Default,,0,0,0,,‎Егер Дайотайсай 30 жыл бұрын өткен болса
Dialogue: 0,0:18:31.90,0:18:35.86,Default,,0,0,0,,Мен сенің әкеңнің бізге қосылғанын қалайтын едім.
Dialogue: 0,0:18:36.36,0:18:40.16,Default,,0,0,0,,‎Бірақ сен әкеңнің көздегенісің.
Dialogue: 0,0:18:40.32,0:18:42.62,Default,,0,0,0,,Сіз оны аяқтаған сияқтысыз.
Dialogue: 0,0:18:44.08,0:18:46.37,Default,,0,0,0,,‎Магомед Арай стиліндегі жекпе-жек өнері
Dialogue: 0,0:18:48.21,0:18:49.62,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:18:51.71,0:18:55.88,Default,,0,0,0,,‎(Әңгімелеу) Кіші Махомед Аллай Дайгётай ойынына қатысады
Dialogue: 0,0:18:56.26,0:18:58.63,Default,,0,0,0,,‎Шош Шуш Шуш
Dialogue: 0,0:18:59.38,0:19:02.14,Default,,0,0,0,,‎Аа... уһ уһ
Dialogue: 0,0:19:04.51,0:19:06.39,Default,,0,0,0,,А...
Dialogue: 0,0:19:08.68,0:19:09.52,Default,,0,0,0,,А...
Dialogue: 0,0:19:10.94,0:19:13.65,Default,,0,0,0,,‎Хаа һаа…
Dialogue: 0,0:19:16.28,0:19:19.70,Default,,0,0,0,,‎Ооооооооооооооооооо...
Dialogue: 0,0:19:19.99,0:19:21.61,Default,,0,0,0,,‎Ха... уф...
Dialogue: 0,0:19:21.78,0:19:23.87,Default,,0,0,0,,‎Шош Шуш Шуш
Dialogue: 0,0:19:24.03,0:19:24.87,Default,,0,0,0,,‎(Коузуэ) Сәттілік
Dialogue: 0,0:19:25.28,0:19:26.12,Default,,0,0,0,,Хехе!
Dialogue: 0,0:19:27.12,0:19:27.95,Default,,0,0,0,,А...
Dialogue: 0,0:19:29.04,0:19:29.87,Default,,0,0,0,,Иә...?
Dialogue: 0,0:19:30.58,0:19:31.42,Default,,0,0,0,,Қазір…
Dialogue: 0,0:19:33.33,0:19:34.17,Default,,0,0,0,,‎Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:19:35.79,0:19:37.92,Default,,0,0,0,,‎Баки... қолыңнан келгеннің бәрін істе
Dialogue: 0,0:19:40.51,0:19:41.43,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:19:42.93,0:19:44.18,Default,,0,0,0,,Қатты тырыссаңыз да
Dialogue: 0,0:19:45.85,0:19:47.39,Default,,0,0,0,,Мен оны тоқтата алмаймын
Dialogue: 0,0:19:48.56,0:19:52.27,Default,,0,0,0,,Мен өлсем де күресемін
Dialogue: 0,0:19:52.94,0:19:54.48,Default,,0,0,0,,Дәл сол себепті
Dialogue: 0,0:19:54.98,0:19:57.11,Default,,0,0,0,,‎Әкеммен соғысу
Dialogue: 0,0:19:57.69,0:19:59.44,Default,,0,0,0,,Мен өмір сүрдім.
Dialogue: 0,0:20:03.32,0:20:06.16,Default,,0,0,0,,‎(Козуэ) Махаббат... тоқтау мүмкін емес
Dialogue: 0,0:20:19.71,0:20:22.59,Default,,0,0,0,,‎(қуаныш)
Dialogue: 0,0:20:23.63,0:20:25.84,Default,,0,0,0,,‎(Диктор) 100 жылдан кейін қайта кел!
Dialogue: 0,0:20:26.01,0:20:28.56,Default,,0,0,0,,‎Аспан денелерінің орнын білдіреді Он екі сары
Dialogue: 0,0:20:28.72,0:20:31.93,Default,,0,0,0,,‎Бір жыл айлармен бөлінген: он және екі ай
Dialogue: 0,0:20:32.10,0:20:36.73,Default,,0,0,0,,‎Он екі аспан, жер, күн, ай және сегіз бағытты қорғайтын құдайлар
Dialogue: 0,0:20:36.90,0:20:39.82,Default,,0,0,0,,Шакьямуниді қорғайтын құдайлар - он екі генерал
Dialogue: 0,0:20:39.98,0:20:42.61,Default,,0,0,0,,Мәсіхтің таңдаған шәкірттері, он екі елші
Dialogue: 0,0:20:43.45,0:20:48.12,Default,,0,0,0,,Отанын қорғайтын он екі жауынгер қазір осында!
Dialogue: 0,0:20:48.74,0:20:52.62,Default,,0,0,0,,‎Сосын үш адамды ушу министрлігі кенеттен соғысқа қатысуға рұқсат етті.
Dialogue: 0,0:20:53.87,0:20:56.88,Default,,0,0,0,,‎Магомед Алли Кіші Америка!
Dialogue: 0,0:20:58.38,0:21:00.38,Default,,0,0,0,,‎Юдзиро Ханма Жапония!
Dialogue: 0,0:21:01.76,0:21:04.88,Default,,0,0,0,,‎Баки Ханма Жапониядан!
Dialogue: 0,0:21:06.76,0:21:08.89,Default,,0,0,0,,‎(Әңгімелеу) Өлім жазасына кесілгендер кетіп қалды.
Dialogue: 0,0:21:09.51,0:21:12.64,Default,,0,0,0,,Бірақ у Бақидың денесінде қалды.
Dialogue: 0,0:21:13.35,0:21:16.90,Default,,0,0,0,,Мен осы Қытай жерінде өлім аузында жатқанда болдым.
Dialogue: 0,0:21:17.23,0:21:20.40,Default,,0,0,0,,Баки шынымен шайқаса ала ма?
Dialogue: 0,0:21:20.57,0:21:22.94,Default,,0,0,0,,№. Сіз аман қала аласыз ба?
Dialogue: 0,0:21:23.44,0:21:27.45,Default,,0,0,0,,Барлық жауаптар осы үлкен мұнарада болады.
Dialogue: 0,0:21:28.82,0:21:32.20,Default,,0,0,0,,‎(диктор) 16 ойыншыдан тұратын үлкен раунд
Dialogue: 0,0:21:32.37,0:21:35.62,Default,,0,0,0,,‎100 жылда бір рет өтетін бір күндік турнир
Dialogue: 0,0:21:35.79,0:21:38.67,Default,,0,0,0,,‎100 жылда бір рет керемет стрессті жеңілдету!
Dialogue: 0,0:21:38.83,0:21:40.42,Default,,0,0,0,,‎Ол өтеді!
Dialogue: 0,0:21:50.97,0:21:56.98,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:23:14.05,0:23:20.06,Default,,0,0,0,,‎〜♪
