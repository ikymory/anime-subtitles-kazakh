Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:12.01,0:00:18.01,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:33.67,0:01:39.68,Default,,0,0,0,,~♪
Dialogue: 0,0:01:42.97,0:01:44.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:44.18,0:01:49.31,Default,,0,0,0,,Бірінші байқағаным...
Dialogue: 0,0:01:49.48,0:01:51.40,Default,,0,0,0,,Не?
Dialogue: 0,0:01:52.07,0:01:54.15,Default,,0,0,0,,Олар жаман балалар болатын.
Dialogue: 0,0:01:54.23,0:01:56.65,Default,,0,0,0,,Неге қалтырап тұрсың?
Dialogue: 0,0:01:58.36,0:02:02.37,Default,,0,0,0,,Мен сол емханаға бара аламын ба?
Dialogue: 0,0:02:02.83,0:02:03.91,Default,,0,0,0,,Мен де
Dialogue: 0,0:02:03.99,0:02:05.29,Default,,0,0,0,,А, мен де
Dialogue: 0,0:02:05.37,0:02:07.58,Default,,0,0,0,,Мен денем дірілдеп тұрғандай сезінемін.
Dialogue: 0,0:02:07.66,0:02:09.08,Default,,0,0,0,,А, сен де?
Dialogue: 0,0:02:09.29,0:02:10.42,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:10.50,0:02:12.42,Default,,0,0,0,,Мен сыныпқа кіргеннен бері...
Dialogue: 0,0:02:12.50,0:02:14.42,Default,,0,0,0,,Бұл суық емес.
Dialogue: 0,0:02:14.50,0:02:17.84,Default,,0,0,0,,Денелері дірілдегендер қолдарын көтеріңдер.
Dialogue: 0,0:02:18.26,0:02:19.88,Default,,0,0,0,,
Dialogue: 0,0:02:19.97,0:02:21.09,Default,,0,0,0,,Иә
Dialogue: 0,0:02:21.18,0:02:22.76,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:02:23.64,0:02:26.77,Default,,0,0,0,,Жоқ... жұт
Dialogue: 0,0:02:27.68,0:02:29.48,Default,,0,0,0,,Бір адам қауіпсіз.
Dialogue: 0,0:02:31.40,0:02:32.81,Default,,0,0,0,,Мен ұйықтап жатырмын
Dialogue: 0,0:02:36.07,0:02:37.15,Default,,0,0,0,,Ханма?
Dialogue: 0,0:02:37.40,0:02:38.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.32,0:02:41.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:02:42.82,0:02:45.37,Default,,0,0,0,,Құқық бұзушы болып қалу таланты
Dialogue: 0,0:02:45.83,0:02:49.16,Default,,0,0,0,,Бұл жабайы әлемге өте ұқсас.
Dialogue: 0,0:02:49.71,0:02:53.84,Default,,0,0,0,,Біз де емеспіз. Біз тек сол үшін ғана құқық бұзушылар сияқты әрекет етіп жатқан жоқпыз.
Dialogue: 0,0:02:54.13,0:02:58.42,Default,,0,0,0,,Уайымдама, сен баспалдақтан құладың.
Dialogue: 0,0:02:58.76,0:03:01.09,Default,,0,0,0,,Бұл баспалдақтағы мүк жарасы ма?
Dialogue: 0,0:03:01.34,0:03:02.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:02.51,0:03:05.81,Default,,0,0,0,,Рё, қорқып тұрсың ба?
Dialogue: 0,0:03:05.89,0:03:08.06,Default,,0,0,0,,О? Сіз қорқасыз ба?
Dialogue: 0,0:03:08.14,0:03:10.89,Default,,0,0,0,,Біраздан бері дірілдеп тұрсың.
Dialogue: 0,0:03:11.10,0:03:12.85,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:13.27,0:03:14.65,Default,,0,0,0,,Жетеді
Dialogue: 0,0:03:16.27,0:03:19.44,Default,,0,0,0,,Бұл жігіт туралы жеткілікті.
Dialogue: 0,0:03:21.15,0:03:22.86,Default,,0,0,0,,Құқық бұзушы ретіндегі талант...
Dialogue: 0,0:03:23.66,0:03:26.78,Default,,0,0,0,,Жоқ Ұяшық оны көрді.
Dialogue: 0,0:03:27.70,0:03:29.33,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:03:30.79,0:03:32.54,Default,,0,0,0,,Қарсы болмасаң, барамын.
Dialogue: 0,0:03:36.17,0:03:40.59,Default,,0,0,0,,Бұрын-соңды кездеспеген өте сапасыз жарылғыш заттар
Dialogue: 0,0:03:41.47,0:03:42.76,Default,,0,0,0,,Бұл!
Dialogue: 0,0:03:43.97,0:03:47.43,Default,,0,0,0,,Сен... жоқ сен
Dialogue: 0,0:03:48.72,0:03:51.27,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:03:53.60,0:03:57.52,Default,,0,0,0,,Бұл туралы айту тіпті қызық емес.
Dialogue: 0,0:03:58.36,0:04:01.32,Default,,0,0,0,,Оған қарт адамдар араласпауы керек.
Dialogue: 0,0:04:02.49,0:04:05.87,Default,,0,0,0,,Қарсыласыңыздың күшін бірден байқаңыз.
Dialogue: 0,0:04:05.95,0:04:07.78,Default,,0,0,0,,Құқық бұзушы ретіндегі талант
Dialogue: 0,0:04:08.49,0:04:11.08,Default,,0,0,0,,Салауатты түрде ақаулы болуды жалғастырыңыз.
Dialogue: 0,0:04:11.58,0:04:13.25,Default,,0,0,0,,Егер кедергі болмаса
Dialogue: 0,0:04:13.33,0:04:15.83,Default,,0,0,0,,Мен саған ештеңе істемеймін.
Dialogue: 0,0:04:15.96,0:04:16.79,Default,,0,0,0,,Гүлп
Dialogue: 0,0:04:16.88,0:04:18.17,Default,,0,0,0,,Кейде болады
Dialogue: 0,0:04:18.25,0:04:21.13,Default,,0,0,0,,Күрестің күшінен маңыздырақ болуы мүмкін
Dialogue: 0,0:04:21.21,0:04:23.05,Default,,0,0,0,,Мен қорықтым!
Dialogue: 0,0:04:26.68,0:04:28.72,Default,,0,0,0,,Эй, эй! Бұл лимузин!
Dialogue: 0,0:04:28.81,0:04:29.64,Default,,0,0,0,,ЦРУ?
Dialogue: 0,0:04:33.81,0:04:36.44,Default,,0,0,0,,Токугава Зайбатсудың 13-ші буын басшысы
Dialogue: 0,0:04:37.94,0:04:41.78,Default,,0,0,0,,Жауынгерлік өнердің киелі орны жер асты аренасын басқарушы
Dialogue: 0,0:04:43.28,0:04:48.41,Default,,0,0,0,,Жекпе-жек өнеріне, жауынгерлерге деген терең білім мен сүйіспеншілік.
Dialogue: 0,0:04:49.16,0:04:51.45,Default,,0,0,0,,Сіз не істедіңіз? Сіз
Dialogue: 0,0:04:51.70,0:04:54.00,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:04:54.08,0:04:57.58,Default,,0,0,0,,Сіз білесіз бе? Сен, ол қандай адам?
Dialogue: 0,0:04:57.67,0:04:59.00,Default,,0,0,0,,Сіз білесіз бе...
Dialogue: 0,0:05:00.96,0:05:06.18,Default,,0,0,0,,Жоқ, мен директор болсам да, бұл кенеттен болды.
Dialogue: 0,0:05:06.59,0:05:10.68,Default,,0,0,0,,Токугава-саманың біздің мектепке келетініне сене алар емеспін.
Dialogue: 0,0:05:12.93,0:05:15.14,Default,,0,0,0,,Иә! чемпион
Dialogue: 0,0:05:15.56,0:05:17.65,Default,,0,0,0,,Чемпион емес, солай ма?
Dialogue: 0,0:05:17.73,0:05:19.31,Default,,0,0,0,,Нені айтып тұрсың, қария?
Dialogue: 0,0:05:20.11,0:05:22.19,Default,,0,0,0,,Бұлай ашуланба
Dialogue: 0,0:05:23.32,0:05:25.95,Default,,0,0,0,,Директор, оны шешіп бере аласыз ба?
Dialogue: 0,0:05:26.32,0:05:28.36,Default,,0,0,0,,Ха ха ха... иә
Dialogue: 0,0:05:28.99,0:05:29.87,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:30.87,0:05:33.12,Default,,0,0,0,,Жарақаттар туралы не деуге болады?
Dialogue: 0,0:05:33.20,0:05:36.08,Default,,0,0,0,,Гипс 2-3 күннен кейін жойылады...
Dialogue: 0,0:05:37.12,0:05:39.33,Default,,0,0,0,,Сен мұны сұрауға келген жоқсың.
Dialogue: 0,0:05:39.63,0:05:41.96,Default,,0,0,0,,Я... Кукукукукку
Dialogue: 0,0:05:44.51,0:05:47.55,Default,,0,0,0,,Сіз бұл не екенін білесіз бе? Баки
Dialogue: 0,0:05:48.05,0:05:50.64,Default,,0,0,0,,Йокан... олай емес.
Dialogue: 0,0:05:50.93,0:05:52.93,Default,,0,0,0,,Нитроглицерин
Dialogue: 0,0:05:53.01,0:05:55.14,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл жарылғыш зат.
Dialogue: 0,0:05:56.52,0:05:58.69,Default,,0,0,0,,Бұны жеме.
Dialogue: 0,0:05:59.31,0:06:03.19,Default,,0,0,0,,Глицеринді картоп енді осылай кристалданады
Dialogue: 0,0:06:03.27,0:06:06.28,Default,,0,0,0,,Осыдан 100 жыл бұрын қыздырылған ба, қатқан ба,
Dialogue: 0,0:06:06.36,0:06:09.91,Default,,0,0,0,,Бұл зат ешқашан кристалданбайтын сұйықтық болатын.
Dialogue: 0,0:06:10.07,0:06:10.91,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:10.99,0:06:13.91,Default,,0,0,0,,20 ғасырдың басы Венадан Лондонға дейін
Dialogue: 0,0:06:13.99,0:06:17.12,Default,,0,0,0,,Бұл глицериннің көп мөлшерін тасымалдау туралы.
Dialogue: 0,0:06:17.33,0:06:22.29,Default,,0,0,0,,Кездейсоқ Бискай шығанағы рекордтық дауыл соқты.
Dialogue: 0,0:06:22.88,0:06:27.55,Default,,0,0,0,,Глицеринді тасымалдап жатса да, азғантай дірілге жол берілмейді.
Dialogue: 0,0:06:28.51,0:06:31.64,Default,,0,0,0,,Қандай жағдай болмасын, кеме аман-есен жетті.
Dialogue: 0,0:06:31.89,0:06:36.14,Default,,0,0,0,,Теңізшілер тексеру үшін бөшкені ашуға асықты.
Dialogue: 0,0:06:36.39,0:06:38.64,Default,,0,0,0,,Онда не көрді
Dialogue: 0,0:06:39.64,0:06:41.35,Default,,0,0,0,,Бұрын көрмеген
Dialogue: 0,0:06:41.44,0:06:45.15,Default,,0,0,0,,Бұл әдемі кристалданған глицерин болды.
Dialogue: 0,0:06:45.65,0:06:48.57,Default,,0,0,0,,Алайда жағдай мұнымен бітпейді.
Dialogue: 0,0:06:49.24,0:06:52.28,Default,,0,0,0,,Сол күннен бастап дүниедегі барлық глицерин болады
Dialogue: 0,0:06:52.37,0:06:56.12,Default,,0,0,0,,Картоп бірінен соң бірі кристалдана бастады дейді.
Dialogue: 0,0:06:56.99,0:06:58.83,Default,,0,0,0,,«Синхрондылық»
Dialogue: 0,0:07:00.75,0:07:05.29,Default,,0,0,0,,Бір-бірімен байланыссыз және оқшауланған заттар мен организмдер
Dialogue: 0,0:07:05.38,0:07:10.34,Default,,0,0,0,,Сайып келгенде, идеялар жаһандық ауқымда бір мезгілде ұқсас өзгерістерді тудырады.
Dialogue: 0,0:07:10.84,0:07:13.34,Default,,0,0,0,,Мұндай құбылысты атаңыз
Dialogue: 0,0:07:14.72,0:07:18.39,Default,,0,0,0,,Соңғы бірнеше күнде Жапонияда...
Dialogue: 0,0:07:18.64,0:07:23.10,Default,,0,0,0,,Жоқ, Токиоға ақылсыз адамдар келіп қонды.
Dialogue: 0,0:07:26.02,0:07:28.65,Default,,0,0,0,,Ай!
Dialogue: 0,0:07:36.28,0:07:37.16,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:07:37.45,0:07:38.87,Default,,0,0,0,,Тым жақындамаңыз
Dialogue: 0,0:07:38.95,0:07:41.54,Default,,0,0,0,,Жақын қонуға 1 метр қашықтықты сақтаңыз
Dialogue: 0,0:07:41.62,0:07:44.29,Default,,0,0,0,,Қаруды қорғау құралдары босатылуы керек.
Dialogue: 0,0:07:44.58,0:07:47.42,Default,,0,0,0,,Оны үлкен, өте улы аң деп ойлаңыз!
Dialogue: 0,0:07:47.50,0:07:50.17,Default,,0,0,0,,Куу~ Маған бұл жай ғана ұнамады.
Dialogue: 0,0:07:50.26,0:07:52.01,Default,,0,0,0,,Менімен ешқашан сөйлеспе!
Dialogue: 0,0:07:54.09,0:07:54.93,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:08:01.48,0:08:02.35,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:08:10.15,0:08:11.24,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:12.90,0:08:15.16,Default,,0,0,0,,Түрме офицері Генри Келесі 5 адам
Dialogue: 0,0:08:15.41,0:08:19.74,Default,,0,0,0,,№777 тұтқынды тасымалдау аяқталды.
Dialogue: 0,0:08:19.87,0:08:20.75,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:08:35.30,0:08:36.80,Default,,0,0,0,,Дориан мырза
Dialogue: 0,0:08:37.80,0:08:39.64,Default,,0,0,0,,Айтатын сөздер қалды ма?
Dialogue: 0,0:08:41.81,0:08:42.64,Default,,0,0,0,,О!
Dialogue: 0,0:08:43.23,0:08:45.60,Default,,0,0,0,,Мен жеңіліс туралы білгім келеді
Dialogue: 0,0:08:53.03,0:08:53.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:54.24,0:08:57.70,Default,,0,0,0,,Ол кезде болмауы керек нәрсе болды.
Dialogue: 0,0:08:58.53,0:09:02.54,Default,,0,0,0,,(Дорианның ыңырсыуы)
Dialogue: 0,0:09:04.83,0:09:06.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:11.50,0:09:12.42,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:09:12.51,0:09:13.42,Default,,0,0,0,,Иә
Dialogue: 0,0:09:20.43,0:09:22.77,Default,,0,0,0,,Мемлекеттік заң 29-бап, 3-бөлім
Dialogue: 0,0:09:23.18,0:09:28.27,Default,,0,0,0,,Іліп болғаннан кейін ілу 10 минут бойы жалғасады.
Dialogue: 0,0:09:28.73,0:09:32.28,Default,,0,0,0,,Өлім туралы дәрігер растаған кезде орындалады
Dialogue: 0,0:09:45.62,0:09:46.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.58,0:09:49.42,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:09:49.96,0:09:50.79,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:51.04,0:09:52.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:56.63,0:09:57.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:03.76,0:10:05.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.48,0:10:17.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.70,0:10:20.74,Default,,0,0,0,,Әрқашан солай
Dialogue: 0,0:10:21.49,0:10:23.78,Default,,0,0,0,,Сіз әрқашан
Dialogue: 0,0:10:23.99,0:10:27.79,Default,,0,0,0,,Бұл сізге қызықсыз жеңіс әкеледі.
Dialogue: 0,0:10:31.13,0:10:32.46,Default,,0,0,0,,(кіргізіліп жатқан кілт дыбысы)
Dialogue: 0,0:10:33.84,0:10:34.71,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:10:37.55,0:10:38.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:42.76,0:10:43.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:48.89,0:10:55.52,Default,,0,0,0,,
Dialogue: 0,0:10:55.73,0:10:58.07,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:10:59.07,0:11:00.32,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:11:05.74,0:11:07.75,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:11:07.91,0:11:08.83,Default,,0,0,0,,Баки!
Dialogue: 0,0:11:09.33,0:11:11.54,Default,,0,0,0,,Мәселе осы жерден басталады.
Dialogue: 0,0:11:18.71,0:11:21.93,Default,,0,0,0,,Не? Жеңіліс туралы білгіңіз келе ме?
Dialogue: 0,0:11:22.59,0:11:25.30,Default,,0,0,0,,Ха, бұл сіздің соңғы сөздеріңіз бе?
Dialogue: 0,0:11:26.01,0:11:28.35,Default,,0,0,0,,Дойл мырза, сізге сұрақ қоюға рұқсат етіңіз.
Dialogue: 0,0:11:28.43,0:11:32.23,Default,,0,0,0,,Бұл аяқталу да сіз үшін жеңіс деп айтасыз ба?
Dialogue: 0,0:11:32.73,0:11:36.11,Default,,0,0,0,,Өміріңіздің соңғы сәттері осы жерден көрінеді
Dialogue: 0,0:11:36.19,0:11:38.98,Default,,0,0,0,,Ол жеңілген адамға ұқсайды.
Dialogue: 0,0:11:39.65,0:11:41.49,Default,,0,0,0,,Қалай болғанда да, өлім алдында
Dialogue: 0,0:11:41.57,0:11:43.49,Default,,0,0,0,,Бір сәтке болса да
Dialogue: 0,0:11:44.07,0:11:46.66,Default,,0,0,0,,Армандарыңыздың орындалғанын білесіз бе?
Dialogue: 0,0:11:46.74,0:11:49.08,Default,,0,0,0,,Ұнамаса да сезесің
Dialogue: 0,0:11:49.70,0:11:50.54,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:11:52.33,0:11:53.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:02.26,0:12:03.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:19.98,0:12:20.90,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:22.45,0:12:24.53,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:26.03,0:12:26.87,Default,,0,0,0,,Ах
Dialogue: 0,0:12:26.99,0:12:27.83,Default,,0,0,0,,Уау
Dialogue: 0,0:12:28.45,0:12:31.95,Default,,0,0,0,,Не болды? Төтенше жағдай бар.
Dialogue: 0,0:12:32.25,0:12:33.16,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:35.67,0:12:37.42,Default,,0,0,0,,Мылтығыңның суретін сал.
Dialogue: 0,0:12:38.17,0:12:40.42,Default,,0,0,0,,Заманауи қаруды белде қолдану
Dialogue: 0,0:12:40.50,0:12:42.59,Default,,0,0,0,,Мен рұқсат сұраймын.
Dialogue: 0,0:12:43.13,0:12:44.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.43,0:12:47.26,Default,,0,0,0,,Адамдар мен аңдардың мылтық кемістігі бар.
Dialogue: 0,0:12:47.34,0:12:49.10,Default,,0,0,0,,Бізге бірінші рет тең екендігіміз айтылады.
Dialogue: 0,0:12:49.93,0:12:52.68,Default,,0,0,0,,Сен екеуміздің күш айырмашылығымыз одан да көп.
Dialogue: 0,0:12:52.85,0:12:56.23,Default,,0,0,0,,Сондықтан мен мына көз байламды шешпеймін.
Dialogue: 0,0:12:56.35,0:12:57.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:58.73,0:12:59.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:13.29,0:13:17.37,Default,,0,0,0,,Егер қосқышты өшіруді тағы 10 секундқа кешіктірсем ше?
Dialogue: 0,0:13:18.92,0:13:20.96,Default,,0,0,0,,Менің тілегім орындалады
Dialogue: 0,0:13:21.67,0:13:22.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.89,0:13:32.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:36.81,0:13:37.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:38.56,0:13:41.52,Default,,0,0,0,,Мен сіздің соңғы хатыңызды алған кезде
Dialogue: 0,0:13:41.61,0:13:45.36,Default,,0,0,0,,Мен оның пайда болуын ешқашан күтпедім.
Dialogue: 0,0:13:45.82,0:13:48.07,Default,,0,0,0,,Және уақытында
Dialogue: 0,0:13:48.99,0:13:52.08,Default,,0,0,0,,Олай болса шығысқа қарай жүрейік.
Dialogue: 0,0:13:55.87,0:13:57.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:08.51,0:14:10.59,Default,,0,0,0,,Сіз осында көтерілдіңіз бе?
Dialogue: 0,0:14:12.01,0:14:14.81,Default,,0,0,0,,Салмағы 100 кг-нан асатын ер адам
Dialogue: 0,0:14:15.02,0:14:16.73,Default,,0,0,0,,Шығыңқы жерлер жоқ
Dialogue: 0,0:14:16.93,0:14:20.10,Default,,0,0,0,,100 метр тегіс металл қабырға
Dialogue: 0,0:14:20.98,0:14:22.86,Default,,0,0,0,,Мұнда Эванс түрмесінде
Dialogue: 0,0:14:22.94,0:14:25.28,Default,,0,0,0,,Бастапқыда құрлықаралық баллистикалық зымыран базасы
Dialogue: 0,0:14:25.36,0:14:26.32,Default,,0,0,0,,Өзгерістер
Dialogue: 0,0:14:27.19,0:14:28.65,Default,,0,0,0,,Бұл зымыран ұшыру порты да
Dialogue: 0,0:14:28.74,0:14:30.28,Default,,0,0,0,,Көптеген ұшыру эксперименттері және
Dialogue: 0,0:14:30.36,0:14:32.74,Default,,0,0,0,,Қатаң табиғи жағдайларға ұшыраған
Dialogue: 0,0:14:32.83,0:14:34.54,Default,,0,0,0,,Қабырға беті міндетті түрде емес
Dialogue: 0,0:14:34.62,0:14:36.66,Default,,0,0,0,,Тегіс емес
Dialogue: 0,0:14:37.33,0:14:40.08,Default,,0,0,0,,Аздап сызаттар Аздап тот басқан
Dialogue: 0,0:14:40.46,0:14:43.42,Default,,0,0,0,,Сен осындай нәрсеге жабысып тауға шықтың ба?
Dialogue: 0,0:14:43.50,0:14:46.09,Default,,0,0,0,,Бұл 100 метрлік тік қабырға!
Dialogue: 0,0:14:46.17,0:14:50.30,Default,,0,0,0,,Сикорскийдің физикалық қабілеттері ерекше.
Dialogue: 0,0:14:51.43,0:14:56.14,Default,,0,0,0,,Егер ол қылмыс жасамаса, біздің Ресей Республикасы
Dialogue: 0,0:14:56.22,0:14:58.64,Default,,0,0,0,,Неше алтын медаль әкелдің?
Dialogue: 0,0:15:00.31,0:15:02.81,Default,,0,0,0,,Егер сол Сикорский, немесе...
Dialogue: 0,0:15:03.65,0:15:05.15,Default,,0,0,0,,Оны дереу қадағалаңыз!
Dialogue: 0,0:15:05.23,0:15:06.90,Default,,0,0,0,,Асқақта тұрғаныңызға көз жеткізіңіз.
Dialogue: 0,0:15:07.40,0:15:10.20,Default,,0,0,0,,Директор: Мен алда бірдеңе бар екеніне сенімдімін...
Dialogue: 0,0:15:10.32,0:15:11.16,Default,,0,0,0,,О
Dialogue: 0,0:15:11.66,0:15:15.37,Default,,0,0,0,,Егер Сикорский сол жерге тоқтаған болса.
Dialogue: 0,0:15:15.45,0:15:16.37,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:15:17.20,0:15:18.79,Default,,0,0,0,,Гаренге қауіп төніп тұр
Dialogue: 0,0:15:22.88,0:15:26.00,Default,,0,0,0,,Директор Мына директорды қара!
Dialogue: 0,0:15:26.92,0:15:29.05,Default,,0,0,0,,Гален! Ресейдің батыры!
Dialogue: 0,0:15:29.84,0:15:32.43,Default,,0,0,0,,Ұлы орыс батыры!
Dialogue: 0,0:15:34.18,0:15:35.18,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:35.80,0:15:38.02,Default,,0,0,0,,Бұл күрес емес
Dialogue: 0,0:15:38.14,0:15:41.52,Default,,0,0,0,,Таза шайқаста Сикорскийді жеңу мүмкін емес.
Dialogue: 0,0:15:42.14,0:15:43.06,Default,,0,0,0,,Директор!
Dialogue: 0,0:15:43.19,0:15:45.06,Default,,0,0,0,,
Dialogue: 0,0:15:54.03,0:15:56.16,Default,,0,0,0,,Әлгі Гарен?
Dialogue: 0,0:15:57.41,0:15:59.04,Default,,0,0,0,,Тағы екі адам
Dialogue: 0,0:16:00.58,0:16:04.67,Default,,0,0,0,,Құрғақ қалам Жазушы қол сағаты
Dialogue: 0,0:16:04.75,0:16:08.38,Default,,0,0,0,,Ааа, мен құмар ойында көп ұтылған сияқтымын.
Dialogue: 0,0:16:08.46,0:16:09.76,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:16:09.84,0:16:11.38,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:16:11.47,0:16:13.38,Default,,0,0,0,,Галстук түйреуіштер мен манжеттер
Dialogue: 0,0:16:14.13,0:16:16.43,Default,,0,0,0,,Қылмыскер қаншалықты қатыгез болса да,
Dialogue: 0,0:16:16.51,0:16:21.10,Default,,0,0,0,,Якко-сан, ол тіпті тапаншаны өткізбейтін арнайы акрил торда.
Dialogue: 0,0:16:21.18,0:16:23.14,Default,,0,0,0,,Ал сен ұмытпайсың ба?
Dialogue: 0,0:16:23.27,0:16:25.73,Default,,0,0,0,,Мен каратэден қара белбеумін.
Dialogue: 0,0:16:26.77,0:16:27.61,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:28.40,0:16:32.44,Default,,0,0,0,,Бұл екі жыл бұрын Спекпен кездесуге келген кеңесші.
Dialogue: 0,0:16:32.70,0:16:33.53,Default,,0,0,0,,О!
Dialogue: 0,0:16:35.36,0:16:37.74,Default,,0,0,0,,Сұрақ қою кезінде Спек кенеттен қанмен жөтелді.
Dialogue: 0,0:16:37.83,0:16:39.37,Default,,0,0,0,,Ол жақындады
Dialogue: 0,0:16:39.74,0:16:41.95,Default,,0,0,0,,Әрине, акрил тақтасы арқылы
Dialogue: 0,0:16:42.41,0:16:47.21,Default,,0,0,0,,Біз дауыстап ескерткенше Спектің ойыны аяқталды.
Dialogue: 0,0:16:47.42,0:16:51.59,Default,,0,0,0,,Қан құсуының нақты себебі түскі асқа берілген орамжапырақ орамындағы кетчуп болды.
Dialogue: 0,0:16:52.05,0:16:56.22,Default,,0,0,0,,Кеңесшіні тағам науасын жеткізу тесігі арқылы ұстаңыз.
Dialogue: 0,0:16:56.30,0:16:58.14,Default,,0,0,0,,Тікелей соққы жарқылы
Dialogue: 0,0:16:58.80,0:17:00.22,Default,,0,0,0,,Сіз не көріп тұрсыз
Dialogue: 0,0:17:00.68,0:17:02.27,Default,,0,0,0,,Жеткізу портының кілті болып табылады
Dialogue: 0,0:17:02.35,0:17:05.02,Default,,0,0,0,,Қуысты өңдеу үшін қолданылатын көпірлерді өңдеу
Dialogue: 0,0:17:05.10,0:17:06.98,Default,,0,0,0,,Мен оны артқы жағынан аштым.
Dialogue: 0,0:17:07.31,0:17:09.57,Default,,0,0,0,,А, бұл манжеттер еді.
Dialogue: 0,0:17:11.23,0:17:13.82,Default,,0,0,0,,Қандай жағдай болмасын, белбеуіңізді де шешіңіз.
Dialogue: 0,0:17:13.90,0:17:16.24,Default,,0,0,0,,Дәлірек айтсақ, бұл табиғи дайындық.
Dialogue: 0,0:17:18.82,0:17:21.16,Default,,0,0,0,,Сіз жеткілікті білдіңіз.
Dialogue: 0,0:17:21.37,0:17:24.20,Default,,0,0,0,,Ешқашан акрил тақтасына жақындамаңыз
Dialogue: 0,0:17:24.29,0:17:27.58,Default,,0,0,0,,Барлық әңгімелер сізден сұрақтармен аяқталуы керек.
Dialogue: 0,0:17:30.79,0:17:34.67,Default,,0,0,0,,Ерекшеліктердегі сұрақтар мен арандатушылықтар, әрине, еленбейді.
Dialogue: 0,0:17:36.68,0:17:38.22,Default,,0,0,0,,Артқы жағында сол жақта.
Dialogue: 0,0:17:38.43,0:17:41.22,Default,,0,0,0,,Әңгімелесу кезінде ешқашан қабырғадан шықпаңыз
Dialogue: 0,0:17:42.01,0:17:44.52,Default,,0,0,0,,Айтпақшы, каратэден қара белбеу ше?
Dialogue: 0,0:17:44.60,0:17:46.02,Default,,0,0,0,,Шынында да, Лорд Розваал да сол ықтималдыққа алаңдаушылық білдірген еді.
Dialogue: 0,0:17:46.19,0:17:47.81,Default,,0,0,0,,Бұрынғы кеңесші болды
Dialogue: 0,0:17:47.90,0:17:50.06,Default,,0,0,0,,Ұлттық күрестен чемпион болған көрінеді.
Dialogue: 0,0:18:00.32,0:18:01.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:04.87,0:18:06.83,Default,,0,0,0,,Профессор Не?
Dialogue: 0,0:18:07.37,0:18:08.37,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:18:08.87,0:18:10.63,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:18:11.88,0:18:12.71,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:14.38,0:18:15.55,Default,,0,0,0,,Сөйлеңіз!
Dialogue: 0,0:18:17.88,0:18:19.18,Default,,0,0,0,,Сөйле!
Dialogue: 0,0:18:23.89,0:18:25.64,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:25.93,0:18:27.31,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:18:27.60,0:18:30.27,Default,,0,0,0,,Құрметті сақшылар, көмектеріңіз үшін рахмет.
Dialogue: 0,0:18:30.35,0:18:32.82,Default,,0,0,0,,Спек қазір Токиоға бара жатыр.
Dialogue: 0,0:18:33.19,0:18:34.23,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:34.82,0:18:35.82,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:18:36.19,0:18:38.15,Default,,0,0,0,,Түсіндісіңдер ме, күзетшілер?
Dialogue: 0,0:18:38.24,0:18:41.62,Default,,0,0,0,,Мен жеңіліп, кеткім келеді.
Dialogue: 0,0:18:41.74,0:18:42.57,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:44.08,0:18:46.95,Default,,0,0,0,,Оның тереңдігі 200 метр!
Dialogue: 0,0:18:48.12,0:18:49.79,Default,,0,0,0,,Спек шектен шығып кетті!
Dialogue: 0,0:18:49.87,0:18:51.92,Default,,0,0,0,,Шығу есігінің кілтін ашыңыз!
Dialogue: 0,0:18:52.00,0:18:54.04,Default,,0,0,0,,Кілт саңылауындағы деформацияланған металл бөлігі!
Dialogue: 0,0:18:54.13,0:18:56.46,Default,,0,0,0,,Иә, мен профессор Джимнің тісіне осылай қойдым.
Dialogue: 0,0:18:56.67,0:18:58.80,Default,,0,0,0,,Жер бетіне көтерілу мүмкін емес.
Dialogue: 0,0:18:59.09,0:19:00.97,Default,,0,0,0,,Шарасыз жүзуге шамамен 5 минут кетеді.
Dialogue: 0,0:19:01.05,0:19:03.85,Default,,0,0,0,,Олай жасасаң, 30 секундта өлесің.
Dialogue: 0,0:19:03.93,0:19:07.43,Default,,0,0,0,,Кез келген жағдайда дереу жағалау сызығының бақылау пунктіне хабарласыңыз!
Dialogue: 0,0:19:09.52,0:19:13.27,Default,,0,0,0,,Бұл өкінішті, сақшылар.
Dialogue: 0,0:19:14.02,0:19:19.57,Default,,0,0,0,,Мен саған әлі айтпаған нәрселерім бар.
Dialogue: 0,0:19:20.20,0:19:21.86,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:19:22.32,0:19:26.91,Default,,0,0,0,,5 минут бойы апноэ жаттығуларын орындау мүмкіндігі
Dialogue: 0,0:19:27.91,0:19:31.21,Default,,0,0,0,,Иә~ Иә
Dialogue: 0,0:19:33.08,0:19:35.71,Default,,0,0,0,,Оннан астам адам, олардың көпшілігі бірден қайтыс болды.
Dialogue: 0,0:19:35.79,0:19:36.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.59,0:19:41.68,Default,,0,0,0,,Басқа адам қанша тұтқын болса да, ол өлім жазасынан құтыла алмайды деп ойлаймын.
Dialogue: 0,0:19:42.13,0:19:46.56,Default,,0,0,0,,Сонда да оннан астам мықты тұтқындар болды...
Dialogue: 0,0:19:46.64,0:19:48.56,Default,,0,0,0,,Сіз жекпе-жек өнерінің қандай да бір түрін қолданасыз ба?
Dialogue: 0,0:19:48.64,0:19:52.69,Default,,0,0,0,,Жоқ, бұл «газ» сияқты.
Dialogue: 0,0:19:52.77,0:19:53.81,Default,,0,0,0,,Газ?
Dialogue: 0,0:19:53.90,0:19:58.11,Default,,0,0,0,,Мен улы газ немесе басқа да заттарды қолданған деп естідім.
Dialogue: 0,0:19:58.19,0:19:59.99,Default,,0,0,0,,Қалай?
Dialogue: 0,0:20:00.40,0:20:03.36,Default,,0,0,0,,Оның үстіне осындай кішкентай орта жастағы адам
Dialogue: 0,0:20:03.45,0:20:07.08,Default,,0,0,0,,Дене бітімі тіпті 160 см де емес сияқты.
Dialogue: 0,0:20:07.16,0:20:10.25,Default,,0,0,0,,Амансың ба? Осындай әйнекпен
Dialogue: 0,0:20:10.33,0:20:11.87,Default,,0,0,0,,Қорғаныс агенттігінен тапсырыс
Dialogue: 0,0:20:11.96,0:20:14.42,Default,,0,0,0,,Зымырандарды кері қайтаруға болатыны қызық.
Dialogue: 0,0:20:14.50,0:20:17.67,Default,,0,0,0,,Улы тал Рюко?
Dialogue: 0,0:20:22.84,0:20:23.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:24.43,0:20:25.72,Default,,0,0,0,,(Саяма) Ой! (Джунпей) Уф...
Dialogue: 0,0:20:26.01,0:20:27.39,Default,,0,0,0,,Уф, қозғалма!
Dialogue: 0,0:20:28.39,0:20:30.56,Default,,0,0,0,,Бір сұрақ қояйық
Dialogue: 0,0:20:32.98,0:20:37.27,Default,,0,0,0,,Осы планетадағы ең күшті улы газ
Dialogue: 0,0:20:37.36,0:20:38.69,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:20:39.23,0:20:40.28,Default,,0,0,0,,Мен саған айтамын, қозғалма!
Dialogue: 0,0:20:40.94,0:20:41.78,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:20:43.90,0:20:44.82,Default,,0,0,0,,Хахаха
Dialogue: 0,0:20:45.36,0:20:48.62,Default,,0,0,0,,Арнайы шыңдалған шыны арқылы тапаншаны көздеу
Dialogue: 0,0:20:48.70,0:20:50.41,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:20:52.75,0:20:55.79,Default,,0,0,0,,Дегенмен, мен үшін
Dialogue: 0,0:20:55.87,0:20:58.13,Default,,0,0,0,,Оның терезе әйнегінен айырмашылығы жоқ.
Dialogue: 0,0:20:59.04,0:20:59.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.96,0:21:01.63,Default,,0,0,0,,Мысалы, мұнда
Dialogue: 0,0:21:02.17,0:21:05.13,Default,,0,0,0,,Шыны зымырандардан секірсе де
Dialogue: 0,0:21:05.43,0:21:09.26,Default,,0,0,0,,Тек бір жерде төтенше вакуум жасаңыз
Dialogue: 0,0:21:09.35,0:21:11.14,Default,,0,0,0,,Қолдарыңызды шыныдан алыңыз!
Dialogue: 0,0:21:11.72,0:21:13.56,Default,,0,0,0,,Сонда бұл біртүрлі
Dialogue: 0,0:21:13.77,0:21:15.14,Default,,0,0,0,,Сәлем Янаги!
Dialogue: 0,0:21:15.23,0:21:17.40,Default,,0,0,0,,Терезе әйнегі сияқты...
Dialogue: 0,0:21:18.19,0:21:19.40,Default,,0,0,0,,Ах! (мылтық)
Dialogue: 0,0:21:20.73,0:21:21.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.86,0:21:22.86,Default,,0,0,0,,Эй
Dialogue: 0,0:21:24.99,0:21:26.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:27.36,0:21:28.87,Default,,0,0,0,,Енді сіз жеңе аласыз.
Dialogue: 0,0:21:30.41,0:21:32.37,Default,,0,0,0,,Қауіпсіздік құралдарын алып тастаңыз
Dialogue: 0,0:21:39.00,0:21:39.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:40.34,0:21:41.80,Default,,0,0,0,,Не? Ол кетті...
Dialogue: 0,0:21:42.59,0:21:46.05,Default,,0,0,0,,Ең күшті улы газ
Dialogue: 0,0:21:46.17,0:21:48.51,Default,,0,0,0,,Уф... Сәлем~
Dialogue: 0,0:21:48.59,0:21:49.43,Default,,0,0,0,,...
Dialogue: 0,0:21:50.97,0:21:52.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:53.52,0:21:55.43,Default,,0,0,0,,Шұғыл! төтенше жағдай!
Dialogue: 0,0:21:55.68,0:21:57.64,Default,,0,0,0,,Барлық қызметкерлер, жөнелтіңіз!
Dialogue: 0,0:21:57.77,0:22:00.06,Default,,0,0,0,,Барлық қызметкерлер, жөнелтіңіз!
Dialogue: 0,0:22:01.32,0:22:02.98,Default,,0,0,0,,Синхрондылық
Dialogue: 0,0:22:03.65,0:22:06.49,Default,,0,0,0,,Өлім жазасына кесілген бес тұтқын
Dialogue: 0,0:22:06.57,0:22:09.70,Default,,0,0,0,,Сол сөздерді қалдырып, Токиоға бет алдым.
Dialogue: 0,0:22:10.07,0:22:10.91,Default,,0,0,0,,Баки
Dialogue: 0,0:22:12.16,0:22:13.91,Default,,0,0,0,,Мағынасын біл!
Dialogue: 0,0:22:21.04,0:22:27.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:44.04,0:23:50.05,Default,,0,0,0,,~♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory