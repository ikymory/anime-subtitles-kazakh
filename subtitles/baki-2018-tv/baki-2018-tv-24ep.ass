Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,‎NETFLIX түпнұсқалық аниме
Dialogue: 0,0:00:11.38,0:00:17.39,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:50.77,0:01:52.32,Default,,0,0,0,,‎(Янаги) Хмм...
Dialogue: 0,0:01:53.73,0:01:56.36,Default,,0,0,0,,‎Мен сенімен бірінші рет кездесіп тұрмын.
Dialogue: 0,0:01:56.53,0:01:59.86,Default,,0,0,0,,Мен сіз туралы бірнеше рет өсек естідім.
Dialogue: 0,0:02:02.16,0:02:05.20,Default,,0,0,0,,‎Жапон қылышын сындыратын ұстау күші
Dialogue: 0,0:02:05.95,0:02:09.92,Default,,0,0,0,,‎Көптеген анекдоттар да сенуге тұрарлық
Dialogue: 0,0:02:10.71,0:02:13.59,Default,,0,0,0,,‎Жер бетіндегі ең күшті жаратылыс күткендей
Dialogue: 0,0:02:13.75,0:02:16.88,Default,,0,0,0,,‎(Юдзиро) Бұл маңызды емес.
Dialogue: 0,0:02:17.05,0:02:17.88,Default,,0,0,0,,‎(Штаб) Ух...
Dialogue: 0,0:02:18.47,0:02:20.26,Default,,0,0,0,,Менің айтып отырғаным
Dialogue: 0,0:02:20.43,0:02:23.47,Default,,0,0,0,,‎Бұл шайқас – сенің жеңілісің.
Dialogue: 0,0:02:23.64,0:02:27.39,Default,,0,0,0,,Сіз оны қабылдайсыз ба, жоқ па?
Dialogue: 0,0:02:27.56,0:02:28.39,Default,,0,0,0,,А...
Dialogue: 0,0:02:29.14,0:02:31.94,Default,,0,0,0,,‎Ух... Уф...
Dialogue: 0,0:02:33.23,0:02:34.27,Default,,0,0,0,,‎Ханма-сан
Dialogue: 0,0:02:34.44,0:02:35.28,Default,,0,0,0,,‎(Штаб) Иә?
Dialogue: 0,0:02:35.73,0:02:37.24,Default,,0,0,0,,‎(Янаги) Мен де, басқалар да мойындаймын—
Dialogue: 0,0:02:37.40,0:02:40.86,Default,,0,0,0,,Сізде «ең күшті» деген атақ бар, бірақ...
Dialogue: 0,0:02:43.87,0:02:46.58,Default,,0,0,0,,‎(Штаб) Айтпа... Өлтіреді!
Dialogue: 0,0:02:50.83,0:02:53.75,Default,,0,0,0,,Бұл ойынның жеңімпазы немесе жеңілгенін кім шешеді?
Dialogue: 0,0:02:53.92,0:02:55.55,Default,,0,0,0,,‎Сен емес
Dialogue: 0,0:03:01.63,0:03:04.55,Default,,0,0,0,,Юдзиро
Dialogue: 0,0:03:04.97,0:03:07.06,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:03:07.60,0:03:09.93,Default,,0,0,0,,‎(Юдзиро) Сіз мұны естідіңіз бе? Бас кеңсе?
Dialogue: 0,0:03:11.10,0:03:15.32,Default,,0,0,0,,Менің шешім қабылдауға құқығым жоқ...
Dialogue: 0,0:03:16.36,0:03:18.44,Default,,0,0,0,,Дұрыс айтасыз!
Dialogue: 0,0:03:18.82,0:03:19.74,Default,,0,0,0,,Кімге...?
Dialogue: 0,0:03:22.45,0:03:25.41,Default,,0,0,0,,(Юдзиро) Бұл ойын болса да, ереже жоқ.
Dialogue: 0,0:03:26.24,0:03:29.08,Default,,0,0,0,,Олай болса, ол қалай шешіледі?
Dialogue: 0,0:03:29.66,0:03:30.58,Default,,0,0,0,,А...
Dialogue: 0,0:03:33.46,0:03:36.54,Default,,0,0,0,,Екі тарап өз бетінше шешім қабылдай алады
Dialogue: 0,0:03:37.67,0:03:40.67,Default,,0,0,0,,‎Жеңілген адам Жеңілген адам
Dialogue: 0,0:03:40.84,0:03:42.93,Default,,0,0,0,,‎Әр адам шешуі керек
Dialogue: 0,0:03:44.43,0:03:46.10,Default,,0,0,0,,Аяқ арқылы тесілген
Dialogue: 0,0:03:46.89,0:03:48.89,Default,,0,0,0,,Қол кесілген
Dialogue: 0,0:03:50.68,0:03:52.39,Default,,0,0,0,,‎Тіпті жыртылған болса да
Dialogue: 0,0:03:52.60,0:03:55.65,Default,,0,0,0,,‎Егер жеңілген адам жеңілгенін мойындамаса
Dialogue: 0,0:03:55.81,0:03:57.36,Default,,0,0,0,,Орындалмаған.
Dialogue: 0,0:03:58.65,0:04:01.15,Default,,0,0,0,,‎Егер сіз сол жерде зиянсыз тұрсаңыз да
Dialogue: 0,0:04:01.32,0:04:03.86,Default,,0,0,0,,‎Егер адам жеңісін мойындамаса
Dialogue: 0,0:04:04.03,0:04:05.87,Default,,0,0,0,,Бұл есеп айырысу емес.
Dialogue: 0,0:04:06.49,0:04:07.37,Default,,0,0,0,,А...
Dialogue: 0,0:04:08.62,0:04:10.79,Default,,0,0,0,,Міне, солай шығар.
Dialogue: 0,0:04:11.00,0:04:12.37,Default,,0,0,0,,Сәлем, штаб?
Dialogue: 0,0:04:12.62,0:04:14.04,Default,,0,0,0,,Жоқ... а...
Dialogue: 0,0:04:16.25,0:04:18.38,Default,,0,0,0,,‎(Шибукава) Сондықтан қиын.
Dialogue: 0,0:04:18.54,0:04:19.38,Default,,0,0,0,,‎(Штаб) Иә?
Dialogue: 0,0:04:19.55,0:04:20.38,Default,,0,0,0,,‎(Янаги) Иә?
Dialogue: 0,0:04:21.38,0:04:25.01,Default,,0,0,0,,‎(Шибукава) Мен сондай құбыжық бар ма деп ойлаймын.
Dialogue: 0,0:04:26.30,0:04:28.39,Default,,0,0,0,,(Юдзиро) Сіз кешігіп қалдыңыз, қария.
Dialogue: 0,0:04:28.55,0:04:29.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.27,0:04:33.39,Default,,0,0,0,,Біткен сияқты.
Dialogue: 0,0:04:33.73,0:04:35.40,Default,,0,0,0,,‎(Янаги) Уф...
Dialogue: 0,0:04:36.19,0:04:39.40,Default,,0,0,0,,‎(Юдзиро) Ух~ Мен тым көп сөйледім.
Dialogue: 0,0:04:40.28,0:04:41.53,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:04:42.65,0:04:44.07,Default,,0,0,0,,‎(Юдзиро) Иә! (Янаги) О!
Dialogue: 0,0:04:45.41,0:04:49.28,Default,,0,0,0,,‎(Янаги) Угого... О...
Dialogue: 0,0:04:50.41,0:04:51.29,Default,,0,0,0,,А...
Dialogue: 0,0:05:02.26,0:05:07.39,Default,,0,0,0,,‎Сен берілмесең, менімен төбелесесің.
Dialogue: 0,0:05:10.18,0:05:13.39,Default,,0,0,0,,Мен мәселені өз бетімше шешуді шештім.
Dialogue: 0,0:05:16.44,0:05:19.31,Default,,0,0,0,,‎(толқындар дыбысы)
Dialogue: 0,0:05:39.33,0:05:40.50,Default,,0,0,0,,Ештеңе…
Dialogue: 0,0:05:43.76,0:05:45.05,Default,,0,0,0,,‎Көрінбейтін
Dialogue: 0,0:05:48.55,0:05:49.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:51.68,0:05:53.22,Default,,0,0,0,,Содан бері
Dialogue: 0,0:05:55.93,0:05:56.98,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:05:57.14,0:05:57.98,Default,,0,0,0,,А...
Dialogue: 0,0:06:00.69,0:06:02.07,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:06:02.32,0:06:06.40,Default,,0,0,0,,Қайырлы кеш! Мистер Дойл
Dialogue: 0,0:06:11.03,0:06:11.95,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:06:12.99,0:06:14.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:14.91,0:06:17.29,Default,,0,0,0,,‎Сендерге аң аулау үшін
Dialogue: 0,0:06:18.37,0:06:21.04,Default,,0,0,0,,Мен Токиоға толық тыныспен келдім ...
Dialogue: 0,0:06:21.58,0:06:24.00,Default,,0,0,0,,‎ дейін жақсы болды
Dialogue: 0,0:06:24.63,0:06:27.51,Default,,0,0,0,,‎Бірақ одан кейін не болатыны жақсы емес.
Dialogue: 0,0:06:32.55,0:06:33.39,Default,,0,0,0,,‎Күшік
Dialogue: 0,0:06:40.19,0:06:43.44,Default,,0,0,0,,Содан бері қанша уақыт өтті?
Dialogue: 0,0:06:45.65,0:06:48.32,Default,,0,0,0,,Бірде-бір адам ұсталған жоқ.
Dialogue: 0,0:06:49.45,0:06:50.61,Default,,0,0,0,,‎Hehe…
Dialogue: 0,0:06:51.07,0:06:51.91,Default,,0,0,0,,Сонымен...?
Dialogue: 0,0:06:53.24,0:06:55.91,Default,,0,0,0,,Олар мені ұстауға келді.
Dialogue: 0,0:06:58.96,0:07:00.50,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,0:07:01.08,0:07:03.04,Default,,0,0,0,,‎Егер бұл сіз жасай алатын нәрсе болса
Dialogue: 0,0:07:09.42,0:07:11.59,Default,,0,0,0,,Бірінші рет кездесу
Dialogue: 0,0:07:11.84,0:07:12.68,Default,,0,0,0,,Е...
Dialogue: 0,0:07:13.51,0:07:17.14,Default,,0,0,0,,Қашқын ұсталғалы жатыр
Dialogue: 0,0:07:17.52,0:07:18.35,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:07:19.31,0:07:21.69,Default,,0,0,0,,Сенің көзің көрмейтін сияқты.
Dialogue: 0,0:07:22.10,0:07:24.19,Default,,0,0,0,,‎Мүлдем көрінбейді
Dialogue: 0,0:07:24.48,0:07:26.27,Default,,0,0,0,,‎Хмм... Қарғыс атсын!
Dialogue: 0,0:07:26.57,0:07:27.44,Default,,0,0,0,,Kah!
Dialogue: 0,0:07:30.61,0:07:31.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:35.62,0:07:36.45,Default,,0,0,0,,А...
Dialogue: 0,0:07:36.95,0:07:37.79,Default,,0,0,0,,А...
Dialogue: 0,0:07:38.91,0:07:40.96,Default,,0,0,0,,‎Ол удың әсерінен.
Dialogue: 0,0:07:41.87,0:07:43.79,Default,,0,0,0,,‎Және өте улы
Dialogue: 0,0:07:44.96,0:07:45.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:46.88,0:07:47.80,Default,,0,0,0,,А...
Dialogue: 0,0:07:55.39,0:07:57.14,Default,,0,0,0,,‎(Әңгімелеу) «Мен жеңілгенді білгім келеді»
Dialogue: 0,0:08:00.77,0:08:05.02,Default,,0,0,0,,‎Мен де осыны қалаймын, мен сол екпіннің жетегінде жүрмін.
Dialogue: 0,0:08:05.23,0:08:07.61,Default,,0,0,0,,Осы шығыс елінде жиналғандар
Dialogue: 0,0:08:07.86,0:08:09.69,Default,,0,0,0,,Олардың тілегі орындалды
Dialogue: 0,0:08:26.46,0:08:30.46,Default,,0,0,0,,‎(толқындар дыбысы)
Dialogue: 0,0:08:34.80,0:08:35.97,Default,,0,0,0,,‎(Kzue) Атчичичичи
Dialogue: 0,0:08:36.14,0:08:36.97,Default,,0,0,0,,‎Оппа…
Dialogue: 0,0:08:39.64,0:08:40.47,Default,,0,0,0,,‎Баки-кун
Dialogue: 0,0:08:41.14,0:08:41.97,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:08:44.35,0:08:45.23,Default,,0,0,0,,А...
Dialogue: 0,0:08:48.61,0:08:51.48,Default,,0,0,0,,‎(Kouzue) Иә? Бір стақан дұрыс па?
Dialogue: 0,0:08:51.94,0:08:52.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:53.36,0:08:54.99,Default,,0,0,0,,Мен бірдеңе жей алмаймын.
Dialogue: 0,0:09:01.79,0:09:03.54,Default,,0,0,0,,Ауруханаға барайық
Dialogue: 0,0:09:04.08,0:09:06.25,Default,,0,0,0,,Сіз тамақ ішіп, ұйықтасаңыз, бәрі жақсы болады.
Dialogue: 0,0:09:06.42,0:09:07.50,Default,,0,0,0,,‎(Козуэ) Сіз тамақ жеген жоқсыз.
Dialogue: 0,0:09:09.42,0:09:10.50,Default,,0,0,0,,Сіз тамақ жеген жоқсыз!
Dialogue: 0,0:09:12.38,0:09:17.39,Default,,0,0,0,,‎(Козуэнің жылаған дауысы)
Dialogue: 0,0:09:19.47,0:09:21.01,Default,,0,0,0,,Сіз тамақ жеген жоқсыз.
Dialogue: 0,0:09:26.85,0:09:29.69,Default,,0,0,0,,‎Иә... Мен тамақ жеген жоқпын.
Dialogue: 0,0:09:34.11,0:09:37.53,Default,,0,0,0,,(доктор) Араластыру әдісі ғылыми емес.
Dialogue: 0,0:09:38.36,0:09:41.49,Default,,0,0,0,,‎Адам ағзасына кері әсері бойынша
Dialogue: 0,0:09:41.66,0:09:44.08,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:09:45.75,0:09:47.54,Default,,0,0,0,,‎Маған ингредиенттер тізімін көрсетіңіз.
Dialogue: 0,0:09:48.46,0:09:52.04,Default,,0,0,0,,‎Жоқ, мен оны көруге қарсы емеспін...
Dialogue: 0,0:09:56.34,0:10:00.51,Default,,0,0,0,,‎Пептидті аконитин аксин скополамин
Dialogue: 0,0:10:00.93,0:10:02.31,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:10:02.47,0:10:03.97,Default,,0,0,0,,‎Нейротоксин…
Dialogue: 0,0:10:04.14,0:10:06.48,Default,,0,0,0,,‎Бұл негізгі органикалық қосылыс.
Dialogue: 0,0:10:06.64,0:10:07.48,Default,,0,0,0,,О...
Dialogue: 0,0:10:07.73,0:10:11.61,Default,,0,0,0,,‎ Оны жай ғана түрту көру қабілетінің нашарлауына әкелуі мүмкін.
Dialogue: 0,0:10:11.90,0:10:13.57,Default,,0,0,0,,Сіз өте егжей-тегжейлісіз.
Dialogue: 0,0:10:15.11,0:10:19.57,Default,,0,0,0,,‎Егер мұндай нәрсе сіздің қаныңызға енсе, бұл күрделі мәселе.
Dialogue: 0,0:10:20.70,0:10:22.58,Default,,0,0,0,,Бұл ауыр жұмыс болды.
Dialogue: 0,0:10:24.20,0:10:25.58,Default,,0,0,0,,‎(Дәрігер) Бір нәрсе ме?
Dialogue: 0,0:10:26.75,0:10:27.58,Default,,0,0,0,,Е...
Dialogue: 0,0:10:28.12,0:10:29.33,Default,,0,0,0,,‎(Коузуэ) Аман болсын
Dialogue: 0,0:10:29.50,0:10:31.58,Default,,0,0,0,,‎Е... осылай ма?
Dialogue: 0,0:10:32.25,0:10:33.09,Default,,0,0,0,,А...!
Dialogue: 0,0:10:42.72,0:10:45.10,Default,,0,0,0,,‎Ха... Ах...
Dialogue: 0,0:10:45.85,0:10:47.39,Default,,0,0,0,,Аурухана!
Dialogue: 0,0:10:52.73,0:10:54.23,Default,,0,0,0,,‎(Кацуми) Ан? госпитализация?
Dialogue: 0,0:10:54.48,0:10:55.32,Default,,0,0,0,,‎(Шәкірт) Осунобу
Dialogue: 0,0:10:55.48,0:10:58.24,Default,,0,0,0,,Бұрынғы Момиджи Хо есімді адамнан.
Dialogue: 0,0:10:58.61,0:11:00.24,Default,,0,0,0,,‎(Retsu) Иә? Баки?
Dialogue: 0,0:11:01.07,0:11:02.28,Default,,0,0,0,,‎(Ханаяма) Түсіндім.
Dialogue: 0,0:11:02.57,0:11:04.24,Default,,0,0,0,,‎(Шибукава) Жарайды, түсіндім.
Dialogue: 0,0:11:04.74,0:11:06.04,Default,,0,0,0,,‎(Жалғыз жүру) Аурухана қайда?
Dialogue: 0,0:11:19.97,0:11:21.26,Default,,0,0,0,,‎(Кузуэ) Момижи-сан
Dialogue: 0,0:11:34.94,0:11:36.40,Default,,0,0,0,,‎(Күзгі жапырақтар) Козуэ-чан (Козуэ) А...
Dialogue: 0,0:11:37.11,0:11:37.94,Default,,0,0,0,,‎(Күзгі жапырақтар) Кішкене...
Dialogue: 0,0:11:44.24,0:11:45.28,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:11:45.91,0:11:48.24,Default,,0,0,0,,‎Бұл сіз қабылдауыңыз керек нәрсе.
Dialogue: 0,0:11:49.33,0:11:51.16,Default,,0,0,0,,Сіз маған көмектесе алмайсыз ба?
Dialogue: 0,0:11:59.00,0:12:00.55,Default,,0,0,0,,‎(Күзгі жапырақтар) Ашығын айтайық
Dialogue: 0,0:12:01.17,0:12:02.80,Default,,0,0,0,,‎(дірілдеген тыныс)
Dialogue: 0,0:12:03.38,0:12:05.22,Default,,0,0,0,,‎Қазір тірі болу...
Dialogue: 0,0:12:05.39,0:12:06.64,Default,,0,0,0,,Бұл ғажайып
Dialogue: 0,0:12:07.81,0:12:09.81,Default,,0,0,0,,А...
Dialogue: 0,0:12:12.48,0:12:15.31,Default,,0,0,0,,‎Хаа һаа…
Dialogue: 0,0:12:15.48,0:12:18.32,Default,,0,0,0,,‎Аа... Уф
Dialogue: 0,0:12:18.57,0:12:24.32,Default,,0,0,0,,‎Хаа ха... Уф
Dialogue: 0,0:12:25.45,0:12:32.46,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:12:33.00,0:12:33.83,Default,,0,0,0,,‎(Арай кіші) Мм...
Dialogue: 0,0:12:34.17,0:12:35.04,Default,,0,0,0,,‎(Козуэ) бұл...
Dialogue: 0,0:12:36.00,0:12:36.88,Default,,0,0,0,,Иә…
Dialogue: 0,0:12:39.34,0:12:41.30,Default,,0,0,0,,‎(Арай кіші) Мен сізге сұрақ қойғым келеді...
Dialogue: 0,0:12:42.72,0:12:45.09,Default,,0,0,0,,‎(Кузуэ) А... иә.
Dialogue: 0,0:12:49.05,0:12:50.85,Default,,0,0,0,,бұл…
Dialogue: 0,0:12:52.68,0:12:53.56,Default,,0,0,0,,‎(Арай кіші) Ах...
Dialogue: 0,0:12:56.65,0:12:58.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:58.44,0:13:01.07,Default,,0,0,0,,Қиындыққа ұшыраған кезде мен сені шақырдым.
Dialogue: 0,0:13:01.28,0:13:02.49,Default,,0,0,0,,‎(Козуэ) Жоқ…
Dialogue: 0,0:13:03.90,0:13:07.24,Default,,0,0,0,,‎Сіз үшін өте маңызды біреу
Dialogue: 0,0:13:08.03,0:13:09.99,Default,,0,0,0,,‎Ол сонда, солай емес пе?
Dialogue: 0,0:13:10.16,0:13:10.99,Default,,0,0,0,,А...
Dialogue: 0,0:13:12.54,0:13:14.16,Default,,0,0,0,,Ух...
Dialogue: 0,0:13:15.25,0:13:19.50,Default,,0,0,0,,‎Ууууууууу...
Dialogue: 0,0:13:20.34,0:13:21.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:24.63,0:13:26.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:26.47,0:13:29.97,Default,,0,0,0,,‎(Кіші Арай) Сіздің әдемі тілегіңіз
Dialogue: 0,0:13:30.47,0:13:31.51,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:13:32.10,0:13:34.77,Default,,0,0,0,,‎Бұл сіздің жақындарыңызға міндетті түрде жетеді.
Dialogue: 0,0:13:36.14,0:13:37.65,Default,,0,0,0,,Ух...
Dialogue: 0,0:13:38.94,0:13:42.78,Default,,0,0,0,,(Кіші Арай) Бұл мен сенетін Құдай.
Dialogue: 0,0:13:43.40,0:13:45.03,Default,,0,0,0,,Жақындарыңызды қорғаңыз
Dialogue: 0,0:13:45.19,0:13:46.03,Default,,0,0,0,,‎(Козуэ) Ах...
Dialogue: 0,0:13:47.66,0:13:49.57,Default,,0,0,0,,Көңіл-күйіңізді көтеріңіз
Dialogue: 0,0:13:51.28,0:13:52.28,Default,,0,0,0,,Мм...
Dialogue: 0,0:13:53.74,0:13:55.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:55.29,0:13:57.50,Default,,0,0,0,,Қазір маған қажет емес
Dialogue: 0,0:14:01.88,0:14:03.71,Default,,0,0,0,,‎(Козуэ) Не сұрағың келеді...
Dialogue: 0,0:14:04.30,0:14:05.13,Default,,0,0,0,,‎(Арай кіші) Ах!
Dialogue: 0,0:14:07.93,0:14:10.18,Default,,0,0,0,,Бұл Такебиру қайда?
Dialogue: 0,0:14:10.34,0:14:11.64,Default,,0,0,0,,‎Такебир…?
Dialogue: 0,0:14:15.47,0:14:17.23,Default,,0,0,0,,‎(Менеджер В) Бұл баяу.
Dialogue: 0,0:14:17.81,0:14:20.81,Default,,0,0,0,,Белгіленген уақыттан бері бір сағат өтті.
Dialogue: 0,0:14:21.36,0:14:24.32,Default,,0,0,0,,‎Дэйвтің серіктесі қазірдің өзінде ақылсыз
Dialogue: 0,0:14:24.65,0:14:26.78,Default,,0,0,0,,‎(Менеджер А) Дэйв, бүгін аяқтаймыз.
Dialogue: 0,0:14:26.94,0:14:28.32,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:14:29.07,0:14:31.53,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:14:31.70,0:14:34.20,Default,,0,0,0,,‎Бұл сіздің өміріңізде қанша рет болады деп ойлайсыз?
Dialogue: 0,0:14:35.04,0:14:38.83,Default,,0,0,0,,‎Бұл қандай да бір жолмен сәйкестіктен маңыздырақ.
Dialogue: 0,0:14:39.21,0:14:41.25,Default,,0,0,0,,‎(Менеджерлер) Ах...
Dialogue: 0,0:14:41.92,0:14:44.63,Default,,0,0,0,,(Менеджер А) Мен де көптен бері осы саладамын.
Dialogue: 0,0:14:44.80,0:14:47.34,Default,,0,0,0,,‎Менің ойымша, көптеген ойыншылар мұны біледі.
Dialogue: 0,0:14:47.63,0:14:50.76,Default,,0,0,0,,Кешіріңіз, бірақ мен мұндай ойыншыны естіген емеспін.
Dialogue: 0,0:14:50.93,0:14:52.34,Default,,0,0,0,,Ойыншы емес
Dialogue: 0,0:14:53.60,0:14:57.68,Default,,0,0,0,,‎Ол ойыншы болмаса да, мырза ерекше.
Dialogue: 0,0:14:58.23,0:14:59.85,Default,,0,0,0,,Ол ерекше жауынгер.
Dialogue: 0,0:15:00.02,0:15:01.35,Default,,0,0,0,,‎(Менеджерлер) Ах...
Dialogue: 0,0:15:02.69,0:15:06.40,Default,,0,0,0,,‎Сіз аты мен шындығы бойынша чемпионсыз, сондықтан айтасыз...
Dialogue: 0,0:15:07.07,0:15:08.36,Default,,0,0,0,,‎(Тренер) Мен сені әкелдім! (Менеджер А) О...?
Dialogue: 0,0:15:08.90,0:15:09.95,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:15:12.11,0:15:13.49,Default,,0,0,0,,‎(Арай кіші) Кешіріңіз, Дэйв.
Dialogue: 0,0:15:13.66,0:15:15.49,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:15:15.74,0:15:17.37,Default,,0,0,0,,А... бұл?
Dialogue: 0,0:15:19.00,0:15:21.87,Default,,0,0,0,,Қош келдіңіз мырза.
Dialogue: 0,0:15:22.58,0:15:25.63,Default,,0,0,0,,‎Мен сені кездестіретін күнді армандадым.
Dialogue: 0,0:15:26.25,0:15:29.09,Default,,0,0,0,,‎(Арай кіші) Жағдайың жақсы сияқты, Дэйв.
Dialogue: 0,0:15:29.26,0:15:31.76,Default,,0,0,0,,‎ Өйткені сіз рингке шықпайсыз.
Dialogue: 0,0:15:32.09,0:15:35.39,Default,,0,0,0,,‎(Менеджер А) А... Дэйв өз бетімен тізерлеп отырды.
Dialogue: 0,0:15:35.55,0:15:37.51,Default,,0,0,0,,‎Толықтай басады
Dialogue: 0,0:15:39.39,0:15:41.02,Default,,0,0,0,,‎Қазір киімімізді ауыстырайық.
Dialogue: 0,0:15:44.27,0:15:45.11,Default,,0,0,0,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:15:46.36,0:15:48.03,Default,,0,0,0,,‎(Есік жабылған дыбыс) ‎(Кіші Арай) Күткеніңізге рахмет.
Dialogue: 0,0:15:48.19,0:15:49.03,Default,,0,0,0,,‎(Менеджер А) А...?
Dialogue: 0,0:15:49.78,0:15:52.03,Default,,0,0,0,,‎Мм... бұл...
Dialogue: 0,0:16:02.83,0:16:05.00,Default,,0,0,0,,Неше унция бар?
Dialogue: 0,0:16:05.17,0:16:06.54,Default,,0,0,0,,‎18 унция.
Dialogue: 0,0:16:07.54,0:16:11.59,Default,,0,0,0,,Бұл менің жалаң қолымнан 100 есе қауіпті.
Dialogue: 0,0:16:13.80,0:16:15.01,Default,,0,0,0,,‎(Арай кіші) Бастаймыз ба?
Dialogue: 0,0:16:15.93,0:16:19.39,Default,,0,0,0,,Мен дөрекі болмас үшін сені өлтіремін деген ниетпен барамын.
Dialogue: 0,0:16:23.60,0:16:26.06,Default,,0,0,0,,‎(Күзгі жапырақтар) Токсин өлімге әкелетін дозадан әлдеқайда жоғары...
Dialogue: 0,0:16:26.44,0:16:27.27,Default,,0,0,0,,‎(Янаги) Хамф!
Dialogue: 0,0:16:28.40,0:16:30.78,Default,,0,0,0,,‎(Күзгі жапырақтар) Соққыдан талай рет соғылды.
Dialogue: 0,0:16:34.86,0:16:38.12,Default,,0,0,0,,‎Ол бастан кешкен ұрыстарда
Dialogue: 0,0:16:40.20,0:16:42.37,Default,,0,0,0,,‎Ең күшті жау шығар
Dialogue: 0,0:16:44.71,0:16:46.67,Default,,0,0,0,,‎Қазір маған тек дұға ету ғана қалды.
Dialogue: 0,0:16:48.67,0:16:50.09,Default,,0,0,0,,‎(Кокозуэ) Сен өлесің бе?
Dialogue: 0,0:16:50.71,0:16:52.55,Default,,0,0,0,,‎Баки-кун өледі ме?
Dialogue: 0,0:16:53.72,0:16:55.05,Default,,0,0,0,,Сіз өлесіз бе?
Dialogue: 0,0:17:10.32,0:17:12.69,Default,,0,0,0,,‎Шош Шуш Шуш
Dialogue: 0,0:17:13.32,0:17:14.99,Default,,0,0,0,,‎(Менеджер А) Шайқаста шыңдалған Дэйв
Dialogue: 0,0:17:15.15,0:17:18.99,Default,,0,0,0,,Бұл адамның өзі «меннен басқаша» екенін мойындайды.
Dialogue: 0,0:17:19.66,0:17:21.29,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:17:21.66,0:17:25.96,Default,,0,0,0,,‎Бұл әдемі адам сол құбыжық Дэйвпен қалай күреседі?
Dialogue: 0,0:17:41.97,0:17:43.18,Default,,0,0,0,,‎Nuo!
Dialogue: 0,0:17:43.93,0:17:44.85,Default,,0,0,0,,‎(Менеджер А) О!
Dialogue: 0,0:17:46.10,0:17:47.35,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:48.31,0:17:49.77,Default,,0,0,0,,Бокс?
Dialogue: 0,0:17:55.69,0:17:59.49,Default,,0,0,0,,‎(Менеджер A) Артқы позициядан, жоғары соққыға дәл уақытында
Dialogue: 0,0:18:00.12,0:18:02.49,Default,,0,0,0,,Қатты Дэйв бір оқпен ұшып кетті
Dialogue: 0,0:18:02.83,0:18:07.00,Default,,0,0,0,,‎Ноооо~!
Dialogue: 0,0:18:16.30,0:18:17.51,Default,,0,0,0,,‎(Дэйв ырылдап)
Dialogue: 0,0:18:17.88,0:18:20.51,Default,,0,0,0,,‎(Менеджер А) А... Дэйв ашуланды.
Dialogue: 0,0:18:20.80,0:18:24.01,Default,,0,0,0,,Осыдан кейін Дэйв қиындыққа тап болды.
Dialogue: 0,0:18:28.69,0:18:29.52,Default,,0,0,0,,‎Дей!
Dialogue: 0,0:18:30.40,0:18:31.31,Default,,0,0,0,,Тая!
Dialogue: 0,0:18:35.90,0:18:37.03,Default,,0,0,0,,О!
Dialogue: 0,0:18:39.15,0:18:40.03,Default,,0,0,0,,‎(Менеджер В) Шешім!
Dialogue: 0,0:18:40.99,0:18:42.03,Default,,0,0,0,,‎(Тренер) Жақсы уақыт
Dialogue: 0,0:18:50.25,0:18:51.67,Default,,0,0,0,,‎Куо…!
Dialogue: 0,0:19:04.64,0:19:05.56,Default,,0,0,0,,‎(Барлығы) Ах!
Dialogue: 0,0:19:10.39,0:19:12.52,Default,,0,0,0,,‎(Менеджер А) Бокс... Гу?
Dialogue: 0,0:19:13.44,0:19:14.31,Default,,0,0,0,,№
Dialogue: 0,0:19:14.94,0:19:17.11,Default,,0,0,0,,‎Бұл бокс емес
Dialogue: 0,0:19:17.40,0:19:19.53,Default,,0,0,0,,‎(Құстар әні)
Dialogue: 0,0:19:19.70,0:19:24.07,Default,,0,0,0,,‎(көліктің жүгіру дыбысы)
Dialogue: 0,0:19:24.24,0:19:26.54,Default,,0,0,0,,‎(Тілші) Бір жұдырықпен салынған байлық
Dialogue: 0,0:19:28.00,0:19:29.08,Default,,0,0,0,,‎Эй, эй...
Dialogue: 0,0:19:29.66,0:19:32.92,Default,,0,0,0,,Қақпадан неше минут өтті?
Dialogue: 0,0:19:33.08,0:19:35.84,Default,,0,0,0,,‎5 минут... жоқ, 10 минут... Иә?
Dialogue: 0,0:19:44.80,0:19:45.85,Default,,0,0,0,,‎(Батлер) Қош келдіңіз
Dialogue: 0,0:19:46.60,0:19:49.35,Default,,0,0,0,,‎Тамаша жапон журналисі!
Dialogue: 0,0:19:50.81,0:19:52.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:52.98,0:19:56.48,Default,,0,0,0,,‎Күйеуім мені біраз уақыттан бері күтіп жүр.
Dialogue: 0,0:19:56.69,0:19:58.98,Default,,0,0,0,,‎А... аа...
Dialogue: 0,0:19:59.57,0:20:00.82,Default,,0,0,0,,‎(Батлер) Мұнда басыңыз
Dialogue: 0,0:20:08.16,0:20:09.83,Default,,0,0,0,,‎Мм… Ммм…
Dialogue: 0,0:20:10.37,0:20:11.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.87,0:20:12.92,Default,,0,0,0,,А...
Dialogue: 0,0:20:17.04,0:20:18.59,Default,,0,0,0,,‎(Батлер) Мен сені осында әкелдім.
Dialogue: 0,0:20:19.84,0:20:20.92,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:20:22.34,0:20:24.97,Default,,0,0,0,,‎(Тілші) А... мына адам
Dialogue: 0,0:20:26.76,0:20:28.01,Default,,0,0,0,,20 ғасыр…
Dialogue: 0,0:20:28.35,0:20:30.02,Default,,0,0,0,,‎Ең үлкен…
Dialogue: 0,0:20:30.52,0:20:31.93,Default,,0,0,0,,Спортшы!
Dialogue: 0,0:20:36.02,0:20:37.19,Default,,0,0,0,,‎10 жыл…
Dialogue: 0,0:20:39.52,0:20:41.03,Default,,0,0,0,,‎10 жылдан астам
Dialogue: 0,0:20:41.57,0:20:43.07,Default,,0,0,0,,Көптен күткен
Dialogue: 0,0:20:43.24,0:20:44.07,Default,,0,0,0,,Сізге…
Dialogue: 0,0:20:44.70,0:20:46.20,Default,,0,0,0,,‎(Тілші) Осы сәт
Dialogue: 0,0:20:46.62,0:20:47.95,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:20:50.70,0:20:52.08,Default,,0,0,0,,мырза. Махомед
Dialogue: 0,0:20:52.62,0:20:54.04,Default,,0,0,0,,Сұхбатты бастаңыз
Dialogue: 0,0:20:54.96,0:20:56.54,Default,,0,0,0,,Сіз үшін...
Dialogue: 0,0:20:57.00,0:20:57.83,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:20:58.46,0:20:59.84,Default,,0,0,0,,‎(Тілші) Ең үлкен байлық және
Dialogue: 0,0:21:00.59,0:21:01.84,Default,,0,0,0,,‎Ең үлкен құрмет және
Dialogue: 0,0:21:02.42,0:21:04.84,Default,,0,0,0,,‎Ол ерекше құрметке ие болды.
Dialogue: 0,0:21:05.26,0:21:06.97,Default,,0,0,0,,Бокс дегеніміз не?
Dialogue: 0,0:21:11.64,0:21:13.85,Default,,0,0,0,,‎Аа... Мен дірілдеп қалдым.
Dialogue: 0,0:21:14.77,0:21:16.56,Default,,0,0,0,,‎Жапон…
Dialogue: 0,0:21:16.98,0:21:20.40,Default,,0,0,0,,‎Жапон... джана... тізімі.
Dialogue: 0,0:21:20.82,0:21:22.36,Default,,0,0,0,,А... Иә!
Dialogue: 0,0:21:23.90,0:21:29.32,Default,,0,0,0,,Юдзиро Хаммер есімді адамды білесіз бе?
Dialogue: 0,0:21:29.49,0:21:32.58,Default,,0,0,0,,‎(Тілші) Әй! Огр…
Dialogue: 0,0:21:32.74,0:21:35.04,Default,,0,0,0,,Неліктен бұл атау?
Dialogue: 0,0:21:36.25,0:21:37.12,Default,,0,0,0,,‎(Күзгі жапырақтар) Бұл не?
Dialogue: 0,0:21:37.75,0:21:40.09,Default,,0,0,0,,(Медбике) Жаңа ғана IV тамшысын тексеруге бардым...
Dialogue: 0,0:21:41.25,0:21:42.42,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:21:43.05,0:21:45.55,Default,,0,0,0,,(Медбике) Ханма Баки-кун... жоқ!
Dialogue: 0,0:21:48.51,0:21:50.64,Default,,0,0,0,,‎(Козуэ) Не істейсің? Эй...
Dialogue: 0,0:21:51.26,0:21:53.18,Default,,0,0,0,,Мұны істе!
Dialogue: 0,0:21:53.85,0:21:56.64,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:21:57.35,0:21:58.48,Default,,0,0,0,,Жетеді
Dialogue: 0,0:21:58.77,0:21:59.65,Default,,0,0,0,,‎(Козуэ) А...?
Dialogue: 0,0:21:59.86,0:22:00.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:02.36,0:22:04.07,Default,,0,0,0,,Бұл менің күресім
Dialogue: 0,0:22:08.66,0:22:10.70,Default,,0,0,0,,‎(Кіші Арай) Менің көңілім қалды.
Dialogue: 0,0:22:10.82,0:22:12.37,Default,,0,0,0,,мырза. Огр
Dialogue: 0,0:22:12.66,0:22:15.87,Default,,0,0,0,,Сіз үлкейдіңіз, кіші Махомед.
Dialogue: 0,0:22:16.96,0:22:19.50,Default,,0,0,0,,Сіздің ұлы әкеңіз қалай?
