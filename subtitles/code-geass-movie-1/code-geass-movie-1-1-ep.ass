Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.87,0:00:11.84,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:24.02,0:00:29.02,Default,,0,0,0,,Қасиетті Британ империясы 17-ші тақ мұрагері
Dialogue: 0,0:00:29.11,0:00:32.40,Default,,0,0,0,,Лелух ви Британия келеді
Dialogue: 0,0:00:33.86,0:00:35.32,Default,,0,0,0,,Императрица Марианна
Dialogue: 0,0:00:35.41,0:00:37.78,Default,,0,0,0,,Мен оның Британ сарайында өлтірілгенін естідім.
Dialogue: 0,0:00:37.87,0:00:42.00,Default,,0,0,0,,Бұл лаңкестердің кіруі оңай жер емес.
Dialogue: 0,0:00:42.08,0:00:43.54,Default,,0,0,0,,Сонда нағыз кінәлі кім?
Dialogue: 0,0:00:43.62,0:00:44.71,Default,,0,0,0,,Қорқынышты қорқынышты
Dialogue: 0,0:00:44.79,0:00:47.38,Default,,0,0,0,,Мұндай оқиғаларды зерттеу тіпті қорқынышты.
Dialogue: 0,0:00:47.46,0:00:50.00,Default,,0,0,0,,Бірақ анасы өлтірілсе де
Dialogue: 0,0:00:50.09,0:00:51.55,Default,,0,0,0,,Сіз беріксіз.
Dialogue: 0,0:00:51.63,0:00:54.09,Default,,0,0,0,,Бірақ Лелуш-саманың енді көзі жоқ.
Dialogue: 0,0:00:54.17,0:00:57.30,Default,,0,0,0,,Мені қолдаған Эшфорд отбасы да бітті.
Dialogue: 0,0:00:57.39,0:00:58.64,Default,,0,0,0,,Сіздің қарындасыңыз ханшайым ше?
Dialogue: 0,0:00:58.72,0:01:00.18,Default,,0,0,0,,Ол аяғына оқ тиген.
Dialogue: 0,0:01:00.26,0:01:01.64,Default,,0,0,0,,Соқырлық
Dialogue: 0,0:01:01.72,0:01:03.56,Default,,0,0,0,,Мен сізде психикалық ауру бар деп естідім?
Dialogue: 0,0:01:03.64,0:01:06.69,Default,,0,0,0,,Дәл сол нәрсе, саясатқа қолдануға болмайтын дене.
Dialogue: 0,0:01:07.56,0:01:10.61,Default,,0,0,0,,Мәртебелі император, менің анам жүкті.
Dialogue: 0,0:01:10.69,0:01:12.19,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:01:12.28,0:01:13.15,Default,,0,0,0,,Сонымен!?
Dialogue: 0,0:01:13.23,0:01:14.86,Default,,0,0,0,,Мұндайды айту
Dialogue: 0,0:01:14.94,0:01:18.28,Default,,0,0,0,,Сіз Британ императорымен аудиторияны сұрадыңыз ба?
Dialogue: 0,0:01:18.82,0:01:21.53,Default,,0,0,0,,Менің келесі адамға қамқорлық жасауға уақытым жоқ.
Dialogue: 0,0:01:21.62,0:01:22.45,Default,,0,0,0,,Әке!
Dialogue: 0,0:01:24.75,0:01:26.37,Default,,0,0,0,,Иә, Мәртебелі
Dialogue: 0,0:01:26.46,0:01:28.50,Default,,0,0,0,,Анамды неге қорғамадың?
Dialogue: 0,0:01:28.58,0:01:31.80,Default,,0,0,0,,Ол император, солай ма? Ол осы елдің ең ұлысы.
Dialogue: 0,0:01:31.88,0:01:34.13,Default,,0,0,0,,Кем дегенде ол Нанналлидің орнында бетін көрсетеді...
Dialogue: 0,0:01:34.21,0:01:36.26,Default,,0,0,0,,Әлсізге пайда жоқ
Dialogue: 0,0:01:36.34,0:01:37.72,Default,,0,0,0,,Әлсіз бе?
Dialogue: 0,0:01:37.80,0:01:40.30,Default,,0,0,0,,Императорлық отбасының бәрі осы.
Dialogue: 0,0:01:40.39,0:01:42.93,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:01:43.01,0:01:45.98,Default,,0,0,0,,Олай болса маған тағы мұрагер болу құқығының керегі жоқ!
Dialogue: 0,0:01:46.06,0:01:49.23,Default,,0,0,0,,Сізге табысқа жету немесе ұрысқа түсу үшін
Dialogue: 0,0:01:49.31,0:01:50.40,Default,,0,0,0,,Жетеді
Dialogue: 0,0:01:50.48,0:01:52.15,Default,,0,0,0,,Өлген
Dialogue: 0,0:01:52.57,0:01:56.36,Default,,0,0,0,,Сіз өз өміріңізді не үшін қатерге тіктіңіз?
Dialogue: 0,0:01:56.44,0:02:01.16,Default,,0,0,0,,Сол киімдер ше? Ал үй ше? Ал тамақ ше? Император тағына мұрагер болу құқығы туралы не деуге болады?
Dialogue: 0,0:02:01.24,0:02:03.03,Default,,0,0,0,,Саған бергенімнің бәрі
Dialogue: 0,0:02:03.12,0:02:07.25,Default,,0,0,0,,Соңында! Мен сені тірі деп айта алмаймын.
Dialogue: 0,0:02:07.33,0:02:09.75,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:02:09.83,0:02:12.17,Default,,0,0,0,,Сіз өлдіңіз. Сіздің құқығыңыз жоқ.
Dialogue: 0,0:02:12.25,0:02:14.55,Default,,0,0,0,,Нуналлимен Жапонияға барыңыз
Dialogue: 0,0:02:14.63,0:02:18.51,Default,,0,0,0,,Ханзада мен ханшайым - жақсы мәмілелер.
Dialogue: 0,0:02:19.05,0:02:23.10,Default,,0,0,0,,Сондағы премьер-министр, оның ұлы сізбен құрдас шығар.
Dialogue: 0,0:02:23.18,0:02:25.27,Default,,0,0,0,,Кейдж Лелуч
Dialogue: 0,0:02:25.35,0:02:28.18,Default,,0,0,0,,Императорлық отбасы ғана орындай алатын жауапкершілік бар.
Dialogue: 0,0:02:28.27,0:02:29.23,Default,,0,0,0,,Nunnally-мен
Dialogue: 0,0:02:29.31,0:02:32.77,Default,,0,0,0,,Қасиетті Британ империясының негізін салыңыз.
Dialogue: 0,0:02:32.86,0:02:36.28,Default,,0,0,0,,Әйтпесе, қайдасың?
Dialogue: 0,0:02:36.36,0:02:38.74,Default,,0,0,0,,Әлемнің ешбір жерінде кездеспейтіні белгілі.
Dialogue: 0,0:02:45.70,0:02:49.75,Default,,0,0,0,,Императорлық күнтізбе 2009 Қасиетті Британ империясы
Dialogue: 0,0:02:49.83,0:02:52.33,Default,,0,0,0,,Ханзада Лелух ви Британия және
Dialogue: 0,0:02:52.42,0:02:54.79,Default,,0,0,0,,Британиядағы Нунелли ханшайымы
Dialogue: 0,0:02:54.88,0:02:59.76,Default,,0,0,0,,Жапон премьер-министрі Гэнбу Куруругиге шетелде оқуды сылтауратып жіберді
Dialogue: 0,0:02:59.84,0:03:02.26,Default,,0,0,0,,Сәйкес кепіл болу
Dialogue: 0,0:03:09.48,0:03:14.48,Default,,0,0,0,,(Лелуштың ауыр тыныс алуы)
Dialogue: 0,0:03:23.99,0:03:27.24,Default,,0,0,0,,Қиыр Шығыстағы бейтарап аралдық мемлекет
Dialogue: 0,0:03:27.33,0:03:30.04,Default,,0,0,0,,Британия, әлемдегі жалғыз держава
Dialogue: 0,0:03:30.58,0:03:36.46,Default,,0,0,0,,Жапонияның жер асты байлығына байланысты екі ел арасында тамыры терең дипломатиялық қақтығыс болды.
Dialogue: 0,0:03:39.09,0:03:42.38,Default,,0,0,0,,Ханзада мен ханшайым болғанша, соғыс болмайды.
Dialogue: 0,0:03:42.47,0:03:45.35,Default,,0,0,0,,Осылай ойлаған адамдардың тілегі болды
Dialogue: 0,0:03:45.43,0:03:47.43,Default,,0,0,0,,Оңай сатқындық
Dialogue: 0,0:03:50.18,0:03:54.81,Default,,0,0,0,,Материктегі шешуші шайқаста британдық армия гуманоидты жауынгерлік броньды атты әскерді пайдаланды.
Dialogue: 0,0:03:54.90,0:03:58.15,Default,,0,0,0,,Нағыз шайқаста алғаш рет кошмар кадры енгізілді
Dialogue: 0,0:03:58.23,0:04:03.24,Default,,0,0,0,,Оның күші күткеннен де асып түсті, ал жапондық Отан қорғаныс шебі
Dialogue: 0,0:04:03.32,0:04:06.91,Default,,0,0,0,,Nightmare барлығын бұзды.
Dialogue: 0,0:04:07.95,0:04:09.70,Default,,0,0,0,,Жапония Империяның тәуелді аумағына айналады.
Dialogue: 0,0:04:09.79,0:04:14.75,Default,,0,0,0,,Еркіндіктен, құқықтан, ел атынан айырылған
Dialogue: 0,0:04:15.42,0:04:17.42,Default,,0,0,0,,«11-аудан»
Dialogue: 0,0:04:17.50,0:04:22.01,Default,,0,0,0,,Бұл сан жеңіліске ұшыраған Жапонияның жаңа атауы болды.
Dialogue: 0,0:04:26.30,0:04:27.14,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:04:27.22,0:04:28.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:28.43,0:04:30.60,Default,,0,0,0,,Созаку I...
Dialogue: 0,0:04:33.98,0:04:38.98,Default,,0,0,0,,♪~
Dialogue: 0,0:05:57.69,0:06:01.94,Default,,0,0,0,,~♪
Dialogue: 0,0:06:13.33,0:06:14.62,Default,,0,0,0,,Бұл A3 (Альфа Үш)
Dialogue: 0,0:06:14.70,0:06:17.62,Default,,0,0,0,,Мақсат D12-ден D14 (он төрт) енгізілді
Dialogue: 0,0:06:17.71,0:06:19.42,Default,,0,0,0,,80км/сағ жылдамдықпен қозғалу
Dialogue: 0,0:06:19.50,0:06:20.92,Default,,0,0,0,,ҚКП-ның әрбір қозғалысы
Dialogue: 0,0:06:21.00,0:06:23.50,Default,,0,0,0,,3 (үш) коды 5-қабаттан 2-қабатқа (екінші) дейін болады
Dialogue: 0,0:06:23.59,0:06:26.67,Default,,0,0,0,,Әрбір қозғалыс үшін нысана 2.8-де бекітілді.
Dialogue: 0,0:06:26.76,0:06:29.93,Default,,0,0,0,,Бұл өткен күні Осакада болған жарылыс туралы бейне.
Dialogue: 0,0:06:30.68,0:06:34.35,Default,,0,0,0,,Қазіргі уақытта «Жапония азат ету майданы» және «Самурай қаны» екі ұйымнан.
Dialogue: 0,0:06:34.43,0:06:36.27,Default,,0,0,0,,Жауапкершілік туралы мәлімдеме жасалды.
Dialogue: 0,0:06:35.31,0:06:36.27,Default,,0,0,0,,(ойын сағатының дыбысы)
Dialogue: 0,0:06:36.35,0:06:37.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:37.27,0:06:38.68,Default,,0,0,0,,Уақыт бітті
Dialogue: 0,0:06:38.77,0:06:42.61,Default,,0,0,0,,Осыдан кейін әр қозғалысты 20 секунд ішінде жасаңыз.
Dialogue: 0,0:06:42.69,0:06:43.94,Default,,0,0,0,,Соған ұқсайды
Dialogue: 0,0:06:44.02,0:06:46.15,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:06:46.69,0:06:47.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:47.61,0:06:50.74,Default,,0,0,0,,Иә? Агент келді ме деп ойлаймын.
Dialogue: 0,0:06:52.16,0:06:54.12,Default,,0,0,0,,Бұл маған көмектесті, хехехе...
Dialogue: 0,0:06:54.20,0:06:56.29,Default,,0,0,0,,Мектеп жақсы ма?
Dialogue: 0,0:06:56.74,0:06:58.87,Default,,0,0,0,,Сен кімсің, студентсің?
Dialogue: 0,0:06:59.41,0:07:01.79,Default,,0,0,0,,Хмф, сен кімсің, ақсүйек?
Dialogue: 0,0:07:03.04,0:07:06.05,Default,,0,0,0,,Жастардың уақыты көп.
Dialogue: 0,0:07:06.13,0:07:08.34,Default,,0,0,0,,Өкінетін уақыт
Dialogue: 0,0:07:08.42,0:07:09.34,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:07:09.42,0:07:11.76,Default,,0,0,0,,Лелуш Ламперуж
Dialogue: 0,0:07:11.84,0:07:15.01,Default,,0,0,0,,Ей ей, қанша тырыссаң да жеңе алмайсың.
Dialogue: 0,0:07:15.10,0:07:16.10,Default,,0,0,0,,Эй
Dialogue: 0,0:07:16.18,0:07:17.31,Default,,0,0,0,,Қарсылас
Dialogue: 0,0:07:17.39,0:07:20.89,Default,,0,0,0,,Келесі сабағыма уақтылы келу үшін осы жерден қанша минут кетуім керек?
Dialogue: 0,0:07:20.98,0:07:23.31,Default,,0,0,0,,Аа, егер сіз ұшсаңыз, шамамен 20 минут кетеді.
Dialogue: 0,0:07:23.40,0:07:25.44,Default,,0,0,0,,Олай болса, үйге бара жатқанда аман-есен жүріңіз.
Dialogue: 0,0:07:25.52,0:07:26.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.57,0:07:28.69,Default,,0,0,0,,Бұл небәрі 9 минутты алады
Dialogue: 0,0:07:29.24,0:07:30.70,Default,,0,0,0,,Мастер Жақында болған мәселе
Dialogue: 0,0:07:30.78,0:07:32.99,Default,,0,0,0,,Жарайды, бұл туралы сөйлесейік.
Dialogue: 0,0:07:33.07,0:07:34.32,Default,,0,0,0,,9 минут?
Dialogue: 0,0:07:34.95,0:07:37.20,Default,,0,0,0,,Бір қимылға 20 секунд кетеді.
Dialogue: 0,0:07:37.70,0:07:38.66,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:07:38.74,0:07:43.08,Default,,0,0,0,,Корольден? Фухахаха...
Dialogue: 0,0:07:43.17,0:07:44.29,Default,,0,0,0,,Иә
Dialogue: 0,0:07:46.04,0:07:48.50,Default,,0,0,0,,Ақыры, мен оны ұрлап үлгердім.
Dialogue: 0,0:07:48.92,0:07:52.51,Default,,0,0,0,,Өйткені Тамакидің жігіті Наотоның жоспарын орындамайды.
Dialogue: 0,0:07:54.55,0:07:56.60,Default,,0,0,0,,Аристократ Ең жақсы!
Dialogue: 0,0:07:56.68,0:07:59.64,Default,,0,0,0,,Менде мақтаныш бар, сондықтан мен жалақы алатыныма сенімдімін.
Dialogue: 0,0:07:59.72,0:08:02.06,Default,,0,0,0,,Оның үстіне 8 минут 32 секундтық жаңа рекорд!
Dialogue: 0,0:08:02.14,0:08:04.15,Default,,0,0,0,,Аристократтар жылы.
Dialogue: 0,0:08:04.23,0:08:06.06,Default,,0,0,0,,Бұл жай ғана артықшылыққа паразиттік.
Dialogue: 0,0:08:06.15,0:08:08.48,Default,,0,0,0,,Олай болса, 11 (он бір) санымен сынап көрейік пе?
Dialogue: 0,0:08:08.57,0:08:10.78,Default,,0,0,0,,Біз британдықтардан айырмашылығымыз... Иә?
Dialogue: 0,0:08:10.86,0:08:13.15,Default,,0,0,0,,Бұл қорқынышты, қатысы жоқ адамдарды қатыстырады.
Dialogue: 0,0:08:13.24,0:08:14.24,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:08:14.32,0:08:16.12,Default,,0,0,0,,Ол Камикадзе деп аталады.
Dialogue: 0,0:08:16.20,0:08:17.53,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:17.62,0:08:21.33,Default,,0,0,0,,Британ империясының үшінші ханзадасы Жоғары Мәртебелі Хловиспен баспасөз мәслихатын өткізу уақыты келді.
Dialogue: 0,0:08:23.46,0:08:25.08,Default,,0,0,0,,Құрметті императорлық субьектілер
Dialogue: 0,0:08:25.17,0:08:26.00,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:26.08,0:08:27.38,Default,,0,0,0,,Және, әрине
Dialogue: 0,0:08:27.46,0:08:30.92,Default,,0,0,0,,Бізбен жұмыс істейтін он бір адамның көпшілігі
Dialogue: 0,0:08:31.01,0:08:33.09,Default,,0,0,0,,Бұл он бір емес, жапондық.
Dialogue: 0,0:08:33.17,0:08:34.43,Default,,0,0,0,,Түсіндің бе!?
Dialogue: 0,0:08:34.51,0:08:38.10,Default,,0,0,0,,Менің жүрегім енді екіге бөлінген.
Dialogue: 0,0:08:38.18,0:08:40.77,Default,,0,0,0,,Қайғы мен ашудың жүрегінде
Dialogue: 0,0:08:41.22,0:08:44.64,Default,,0,0,0,,Алайда мен 11-аймаққа жауаптымын.
Dialogue: 0,0:08:44.73,0:08:46.94,Default,,0,0,0,,Біз терроризмге беріле алмаймыз
Dialogue: 0,0:08:47.02,0:08:49.86,Default,,0,0,0,,Өйткені бұл әділ жекпе-жек!
Dialogue: 0,0:08:49.94,0:08:51.86,Default,,0,0,0,,Әр адамның бақытын қорғау
Dialogue: 0,0:08:53.03,0:08:54.07,Default,,0,0,0,,Қазір бірінші көшіңіз.
Dialogue: 0,0:08:54.15,0:08:54.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.07,0:08:57.07,Default,,0,0,0,,Неліктен патшадан көшіп келдің?
Dialogue: 0,0:08:57.16,0:09:01.20,Default,,0,0,0,,Патша қимыл жасамаса, оның қол астындағылар ізіне түспейді, солай ма?
Dialogue: 0,0:09:01.29,0:09:02.33,Default,,0,0,0,,Осымен
Dialogue: 0,0:09:02.41,0:09:03.25,Default,,0,0,0,,Не?
Dialogue: 0,0:09:03.33,0:09:06.08,Default,,0,0,0,,Лелуш президент болғысы келеді ме?
Dialogue: 0,0:09:06.17,0:09:08.92,Default,,0,0,0,,Ахахахха сен не айтып тұрсың?
Dialogue: 0,0:09:08.21,0:09:09.50,Default,,0,0,0,,
Dialogue: 0,0:09:10.17,0:09:12.21,Default,,0,0,0,,Ой, не?!
Dialogue: 0,0:09:12.30,0:09:13.88,Default,,0,0,0,,Жынды сияқты жүгір!
Dialogue: 0,0:09:14.42,0:09:15.51,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:22.77,0:09:25.56,Default,,0,0,0,,Мм... бұл біздің кінәміз бе?
Dialogue: 0,0:09:25.64,0:09:26.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.56,0:09:27.48,Default,,0,0,0,,Бас кеңсеге
Dialogue: 0,0:09:27.56,0:09:29.61,Default,,0,0,0,,Мақсат - әлі әзірлену үстіндегі қараусыз қалған VO ғимараты...
Dialogue: 0,0:09:29.69,0:09:31.98,Default,,0,0,0,,Күте тұрыңыз, іс әскерилерге берілді.
Dialogue: 0,0:09:32.07,0:09:33.82,Default,,0,0,0,,Генерал Батлидің бақылауында.
Dialogue: 0,0:09:33.90,0:09:34.90,Default,,0,0,0,,Генералды?
Dialogue: 0,0:09:35.61,0:09:38.57,Default,,0,0,0,,Біз оны қалпына келтіруіміз керек... не болса да.
Dialogue: 0,0:09:38.66,0:09:40.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:41.08,0:09:42.16,Default,,0,0,0,,Не?
Dialogue: 0,0:09:42.24,0:09:43.41,Default,,0,0,0,,Сәлем Лелуч
Dialogue: 0,0:09:43.49,0:09:45.87,Default,,0,0,0,,Энергия желісі үзілген сияқты...
Dialogue: 0,0:09:45.96,0:09:47.79,Default,,0,0,0,,Ах... Эй, мынау...
Dialogue: 0,0:09:47.87,0:09:49.29,Default,,0,0,0,,Эй, міне, міне!
Dialogue: 0,0:09:49.38,0:09:50.67,Default,,0,0,0,,Уууу
Dialogue: 0,0:09:50.75,0:09:52.71,Default,,0,0,0,,Қасірет (әйел) Не? апат?
Dialogue: 0,0:09:52.80,0:09:54.21,Default,,0,0,0,,Сіз мас емессіз бе?
Dialogue: 0,0:09:54.30,0:09:55.46,Default,,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:09:55.55,0:09:58.22,Default,,0,0,0,,Эй, біреу маған көмектесші.
Dialogue: 0,0:09:57.38,0:09:58.22,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:58.30,0:10:01.14,Default,,0,0,0,,Хмф... бұл жігіт кім?
Dialogue: 0,0:10:01.22,0:10:02.22,Default,,0,0,0,,Tsk
Dialogue: 0,0:10:02.31,0:10:03.81,Default,,0,0,0,,Не? Эй, эй!
Dialogue: 0,0:10:04.68,0:10:06.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:08.69,0:10:11.02,Default,,0,0,0,,Ой! Студенттік құтқару тобы осында!
Dialogue: 0,0:10:11.11,0:10:13.19,Default,,0,0,0,,Неге полиция шақырмайсың?
Dialogue: 0,0:10:13.27,0:10:15.28,Default,,0,0,0,,Эй! Сенімен бәрі жақсы ма!?
Dialogue: 0,0:10:15.78,0:10:16.94,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:17.95,0:10:20.53,Default,,0,0,0,,Білесің бе, мен сенің тоқтағаныңды қалаймын.
Dialogue: 0,0:10:20.62,0:10:22.66,Default,,0,0,0,,Мағынасыз мақтаншақтық таныту
Dialogue: 0,0:10:22.74,0:10:24.62,Default,,0,0,0,,Мен сабаққа кешігіп барамын.
Dialogue: 0,0:10:26.58,0:10:28.54,Default,,0,0,0,,Нагата... Нагата!
Dialogue: 0,0:10:29.42,0:10:30.96,Default,,0,0,0,,Эй, сен мені естисің бе!?
Dialogue: 0,0:10:31.96,0:10:34.50,Default,,0,0,0,,) Мен... өзімді... таптым.
Dialogue: 0,0:10:34.59,0:10:35.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:35.59,0:10:37.55,Default,,0,0,0,,А... ол қайда?
Dialogue: 0,0:10:38.80,0:10:40.38,Default,,0,0,0,,Сіз сондасыз ба!?
Dialogue: 0,0:10:42.80,0:10:44.22,Default,,0,0,0,,Уау, ақымақ...
Dialogue: 0,0:10:44.31,0:10:46.47,Default,,0,0,0,,Әй, тоқта! Мен... Қарғыс атсын!
Dialogue: 0,0:10:47.27,0:10:49.73,Default,,0,0,0,,Мұны соққы және жүгіру деп те атайды ма?
Dialogue: 0,0:10:51.56,0:10:53.36,Default,,0,0,0,,Ішіне де баспалдақ қосыңыз.
Dialogue: 0,0:10:53.44,0:10:54.32,Default,,0,0,0,,Ескерту
Dialogue: 0,0:10:55.65,0:10:58.28,Default,,0,0,0,,Енді адвокат болуы мүмкін.
Dialogue: 0,0:10:58.36,0:11:00.20,Default,,0,0,0,,Дереу тоқтатыңыз
Dialogue: 0,0:11:01.28,0:11:03.45,Default,,0,0,0,,Келесі болжау Бірден тоқтатыңыз.
Dialogue: 0,0:11:03.53,0:11:05.41,Default,,0,0,0,,Тіпті әскерилер де шықты, біз не істеуіміз керек?
Dialogue: 0,0:11:05.99,0:11:07.83,Default,,0,0,0,,Мен осындамын, солай ма?
Dialogue: 0,0:11:10.04,0:11:13.42,Default,,0,0,0,,Сыртқа шығу қауіпті, бірдеңе қауіпті болып көрінеді.
Dialogue: 0,0:11:13.50,0:11:14.38,Default,,0,0,0,,Ұялы телефонда…
Dialogue: 0,0:11:14.46,0:11:15.96,Default,,0,0,0,,Ха! (есіктің ашылған дыбысы)
Dialogue: 0,0:11:17.46,0:11:19.34,Default,,0,0,0,,Мен Азабруттен метроға түсе аламын ба?
Dialogue: 0,0:11:19.84,0:11:21.93,Default,,0,0,0,,Карен Осы жерде қолданайық.
Dialogue: 0,0:11:22.01,0:11:23.76,Default,,0,0,0,,Бұл қырғын ба?
Dialogue: 0,0:11:23.84,0:11:26.01,Default,,0,0,0,,А... у... дұрыс.
Dialogue: 0,0:11:26.51,0:11:28.02,Default,,0,0,0,,Ол әйел...
Dialogue: 0,0:11:29.06,0:11:32.60,Default,,0,0,0,,Сен қайдасың, Лелуч? Мен мектепке баруым керек!
Dialogue: 0,0:11:32.69,0:11:34.73,Default,,0,0,0,,Мақсат концессиядан шығып, геттоға бет алады
Dialogue: 0,0:11:34.81,0:11:35.90,Default,,0,0,0,,Жарайды, қуыңыз.
Dialogue: 0,0:11:35.98,0:11:37.27,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,0:11:40.28,0:11:41.24,Default,,0,0,0,,Слэш Харкен!?
Dialogue: 0,0:11:43.99,0:11:44.87,Default,,0,0,0,,Қорқыныш!
Dialogue: 0,0:11:48.70,0:11:50.91,Default,,0,0,0,,Қат! Ол нағыз террорист емес пе?
Dialogue: 0,0:11:51.00,0:11:53.83,Default,,0,0,0,,Балалар сендер бұл жігіттің құдіретін жақсы білесіңдер, солай ма?
Dialogue: 0,0:11:57.71,0:12:00.42,Default,,0,0,0,,Балалар, артқа тұрыңдар, мен сендермен айналысамын.
Dialogue: 0,0:12:01.92,0:12:04.47,Default,,0,0,0,,Қайдан шыққанын білмеймін, бірақ
Dialogue: 0,0:12:04.55,0:12:06.97,Default,,0,0,0,,Ескі Глазгода бұл——
Dialogue: 0,0:12:07.05,0:12:09.39,Default,,0,0,0,,Сазерленд тоқтау мүмкін емес
Dialogue: 0,0:12:09.47,0:12:14.40,Default,,0,0,0,,Тақсырдың императорға деген сүйіспеншілігін түсіне алмайтын Он бірден де аз!
Dialogue: 0,0:12:15.86,0:12:17.36,Default,,0,0,0,,Карен! Тағы бір әрекет!
Dialogue: 0,0:12:17.82,0:12:19.48,Default,,0,0,0,,Бірге құлау жаман! Сен қашып кет!
Dialogue: 0,0:12:19.57,0:12:20.40,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:12:26.32,0:12:28.41,Default,,0,0,0,,Хмф, қарапайым жігіт.
Dialogue: 0,0:12:30.16,0:12:32.00,Default,,0,0,0,,Неге!? иә!
Dialogue: 0,0:12:32.08,0:12:33.41,Default,,0,0,0,,Пайдаланылған заттар!
Dialogue: 0,0:12:37.50,0:12:40.05,Default,,0,0,0,,О, сіз итермелеп жатырсыз.
Dialogue: 0,0:12:40.13,0:12:41.09,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:12:42.21,0:12:44.51,Default,,0,0,0,,Tsk, ұялы телефоныңыз ауқымнан тыс па?
Dialogue: 0,0:12:45.09,0:12:49.31,Default,,0,0,0,,Бұл қараңғылық пен жолдың жағдайы: Біз бұрынғы метро желісімен жүріп жатырмыз.
Dialogue: 0,0:12:49.39,0:12:51.56,Default,,0,0,0,,Баратын жер - кейбір гетто
Dialogue: 0,0:12:52.22,0:12:53.52,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:12:54.31,0:12:57.77,Default,,0,0,0,,Шарттар жойылды. Мен әскерилермен қорғалғанды жек көремін
Dialogue: 0,0:12:57.86,0:13:00.19,Default,,0,0,0,,Лаңкестің байланыс құралын кәдесый ретінде алу...
Dialogue: 0,0:13:01.65,0:13:02.99,Default,,0,0,0,,Аха!
Dialogue: 0,0:13:03.07,0:13:04.32,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:13:04.40,0:13:06.07,Default,,0,0,0,,Дұрыс түсіндің бе?
Dialogue: 0,0:13:06.16,0:13:07.32,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:13:07.41,0:13:08.91,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:13:08.99,0:13:10.79,Default,,0,0,0,,Генерал және князь Хловис
Dialogue: 0,0:13:10.87,0:13:14.25,Default,,0,0,0,,Мен құпия ұстаған нәрсені террористер ұрлап кетті.
Dialogue: 0,0:13:14.33,0:13:18.25,Default,,0,0,0,,Оны қайтару оңай, бірақ мен достарымды жинап, тазалағым келеді.
Dialogue: 0,0:13:18.33,0:13:21.21,Default,,0,0,0,,Егер сіз лаңкестерге суға түсуге рұқсат етсеңіз, олардың жасырынатын жерін таба аласыз.
Dialogue: 0,0:13:21.30,0:13:24.30,Default,,0,0,0,,Құттықтаймыз! Сіздің болжамыңыз джекпот
Dialogue: 0,0:13:24.38,0:13:26.76,Default,,0,0,0,,А, жоқ, мен бұл біртүрлі деп ойлаймын...
Dialogue: 0,0:13:26.84,0:13:28.05,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:13:28.14,0:13:30.26,Default,,0,0,0,,-де? Корреспондент ретінде не істегіңіз келеді?
Dialogue: 0,0:13:30.35,0:13:33.14,Default,,0,0,0,,Сонымен! Мен саған тазалауға көмектескім келеді!
Dialogue: 0,0:13:33.22,0:13:34.27,Default,,0,0,0,,Көмек керек пе?
Dialogue: 0,0:13:34.35,0:13:36.06,Default,,0,0,0,,Иә, деректерді алғым келеді.
Dialogue: 0,0:13:36.64,0:13:39.73,Default,,0,0,0,,Сонымен... не? Не ұрланған
Dialogue: 0,0:13:39.81,0:13:40.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:41.23,0:13:42.82,Default,,0,0,0,,Химиялық қару...
Dialogue: 0,0:13:42.90,0:13:45.11,Default,,0,0,0,,Басқаша айтқанда, бұл улы газ.
Dialogue: 0,0:13:48.45,0:13:51.41,Default,,0,0,0,,Террористер метрода тығылып жүр
Dialogue: 0,0:13:51.49,0:13:52.74,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:13:52.83,0:13:55.25,Default,,0,0,0,,Лаңкестер ұрлаған қаруды табу
Dialogue: 0,0:13:55.33,0:13:57.50,Default,,0,0,0,,Қоңырауды тапқан бойда жіберіңіз.
Dialogue: 0,0:13:57.58,0:14:00.75,Default,,0,0,0,,Біздің SS мақсатты қалпына келтірумен айналысады.
Dialogue: 0,0:14:00.84,0:14:03.25,Default,,0,0,0,,Сіз құрметті британдық болсаңыз да,
Dialogue: 0,0:14:03.34,0:14:04.80,Default,,0,0,0,,Бастапқыда он бір
Dialogue: 0,0:14:04.88,0:14:06.84,Default,,0,0,0,,Сол маймылдың иісін ажырат
Dialogue: 0,0:14:06.92,0:14:10.14,Default,,0,0,0,,Енді сіздің Британияға адалдығыңызды көрсету мүмкіндігіңіз бар.
Dialogue: 0,0:14:10.22,0:14:11.76,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,0:14:12.47,0:14:15.56,Default,,0,0,0,,U… uh… ku…
Dialogue: 0,0:14:16.81,0:14:18.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:20.44,0:14:21.86,Default,,0,0,0,,(шинаның айналу дыбысы)
Dialogue: 0,0:14:22.94,0:14:24.78,Default,,0,0,0,,Да… жоқ па?
Dialogue: 0,0:14:26.28,0:14:29.15,Default,,0,0,0,,Желдеткішті табыңыз...
Dialogue: 0,0:14:29.70,0:14:30.78,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:14:38.37,0:14:40.37,Default,,0,0,0,,404 мақсатты тапты
Dialogue: 0,0:14:40.46,0:14:42.25,Default,,0,0,0,,Жарайды, жинауға дайындал.
Dialogue: 0,0:14:49.55,0:14:51.64,Default,,0,0,0,,Гай!? Каха... уф...
Dialogue: 0,0:14:51.72,0:14:53.35,Default,,0,0,0,,Сіз әскери қызметкерсіз бе?
Dialogue: 0,0:14:54.01,0:14:55.26,Default,,0,0,0,,Өлтірме! бұдан көп
Dialogue: 0,0:14:55.35,0:14:56.43,Default,,0,0,0,,Күте тұрыңыз, мен...
Dialogue: 0,0:14:56.52,0:14:58.43,Default,,0,0,0,,Ал улы газ ше? (Лелуш) Не?!
Dialogue: 0,0:14:58.52,0:14:59.98,Default,,0,0,0,,Мен ақымақ болуға тырыссам да
Dialogue: 0,0:15:00.06,0:15:00.94,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:02.52,0:15:05.36,Default,,0,0,0,,Британия бұл улы газды бәрібір жасады, солай ма?
Dialogue: 0,0:15:05.86,0:15:07.78,Default,,0,0,0,,А... сен
Dialogue: 0,0:15:08.28,0:15:09.95,Default,,0,0,0,,Мені өлтірме?
Dialogue: 0,0:15:10.03,0:15:12.62,Default,,0,0,0,,Ондай жағдайда Британияны жоюдан басқа амалымыз жоқ.
Dialogue: 0,0:15:12.70,0:15:13.70,Default,,0,0,0,,Лелуч?
Dialogue: 0,0:15:14.74,0:15:16.74,Default,,0,0,0,,Бұл менмін, Сузаку.
Dialogue: 0,0:15:16.83,0:15:17.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:18.08,0:15:21.33,Default,,0,0,0,,Сіз... британдық сарбаз болдыңыз ба?
Dialogue: 0,0:15:21.42,0:15:23.46,Default,,0,0,0,,Ал сіз ше? Бұлай болмайды
Dialogue: 0,0:15:23.54,0:15:24.88,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:15:27.67,0:15:28.55,Default,,0,0,0,,Уг!?
Dialogue: 0,0:15:38.06,0:15:40.52,Default,,0,0,0,,Бұл улы газ емес пе?
Dialogue: 0,0:15:47.32,0:15:49.53,Default,,0,0,0,,Кешіріңіз, байланыс құрылғысы тіркемеде.
Dialogue: 0,0:15:49.61,0:15:52.07,Default,,0,0,0,,Керемет, сіз Глазго желісін пайдалана аласыз.
Dialogue: 0,0:15:52.15,0:15:53.20,Default,,0,0,0,,Одан да көп пе?
Dialogue: 0,0:15:53.86,0:15:56.78,Default,,0,0,0,,Иә, ақпарат бойынша бұл улы газ деп ойлаймын.
Dialogue: 0,0:15:56.87,0:15:57.87,Default,,0,0,0,,Нагата ше?
Dialogue: 0,0:15:57.95,0:16:01.12,Default,,0,0,0,,Мен сізбен байланыса алмасам, сіз қайдасыз?
Dialogue: 0,0:16:03.92,0:16:05.75,Default,,0,0,0,,Маған жауап бер, Созаку.
Dialogue: 0,0:16:05.83,0:16:07.92,Default,,0,0,0,,Улы газ? Бұл бала
Dialogue: 0,0:16:08.67,0:16:11.26,Default,,0,0,0,,Бірақ брифинг әрине
Dialogue: 0,0:16:12.26,0:16:13.55,Default,,0,0,0,,Ах
Dialogue: 0,0:16:14.05,0:16:14.97,Default,,0,0,0,,Мына маймыл!
Dialogue: 0,0:16:15.76,0:16:18.68,Default,,0,0,0,,Құрметті британдықтарға мұндай рұқсат берілмейді.
Dialogue: 0,0:16:18.76,0:16:19.85,Default,,0,0,0,,Бірақ бұл!
Dialogue: 0,0:16:19.93,0:16:21.52,Default,,0,0,0,,Мен улы газ деп естідім...
Dialogue: 0,0:16:21.60,0:16:23.52,Default,,0,0,0,,Қорғануға құқығы жоқ!
Dialogue: 0,0:16:26.15,0:16:30.03,Default,,0,0,0,,Бірақ оның еңбегін бағалап, оған мейірім көрсетейік.
Dialogue: 0,0:16:30.11,0:16:33.45,Default,,0,0,0,,Қатардағы Куруруги Енді лаңкесті атып таста.
Dialogue: 0,0:16:33.53,0:16:34.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.86,0:16:36.03,Default,,0,0,0,,Ол жоқ
Dialogue: 0,0:16:36.12,0:16:37.91,Default,,0,0,0,,Ол жай ғана азамат болып, жағдайға түсіп қалды.
Dialogue: 0,0:16:38.37,0:16:39.70,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:16:39.79,0:16:40.95,Default,,0,0,0,,Бұл тапсырыс!
Dialogue: 0,0:16:41.04,0:16:43.54,Default,,0,0,0,,Сіз Британияға адал болуға ант бергенсіз, солай ма?
Dialogue: 0,0:16:43.62,0:16:44.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:44.96,0:16:46.13,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:16:46.21,0:16:47.96,Default,,0,0,0,,Бірақ сіз алмайсыз.
Dialogue: 0,0:16:48.04,0:16:49.25,Default,,0,0,0,,Не?
Dialogue: 0,0:16:49.34,0:16:51.05,Default,,0,0,0,,Мен мұны өзім істемеймін
Dialogue: 0,0:16:51.59,0:16:54.80,Default,,0,0,0,,Азамат... оны атып тастағанды ұнатпайды.
Dialogue: 0,0:16:54.88,0:16:56.09,Default,,0,0,0,,Ха!? (мылтық)
Dialogue: 0,0:16:56.18,0:16:57.51,Default,,0,0,0,,Сузаку!
Dialogue: 0,0:16:58.60,0:17:02.52,Default,,0,0,0,,Сіз британдық студент сияқтысыз, бірақ жолыңыз жоқ.
Dialogue: 0,0:17:03.10,0:17:05.52,Default,,0,0,0,,Әйелді ұстағаннан кейін студентті өлтіріңіз
Dialogue: 0,0:17:05.60,0:17:07.48,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,0:17:08.02,0:17:10.73,Default,,0,0,0,,Британдық бейбақтар
Dialogue: 0,0:17:11.73,0:17:12.57,Default,,0,0,0,,Иә
Dialogue: 0,0:17:12.65,0:17:15.49,Default,,0,0,0,,Жапония аман болсын!
Dialogue: 0,0:17:15.57,0:17:17.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:19.28,0:17:22.24,Default,,0,0,0,,Сіз қашып үлгердіңіз бе!? Дегенмен, бұл SS!
Dialogue: 0,0:17:22.33,0:17:23.62,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:23.70,0:17:27.00,Default,,0,0,0,,Жарылыс толқыны дерлік жоғары қарай тарады, бірақ тау жыныстары...
Dialogue: 0,0:17:27.08,0:17:29.63,Default,,0,0,0,,Неге мен оны тек сендерге ғана үйреттім деп ойлайсыңдар!
Dialogue: 0,0:17:29.71,0:17:31.88,Default,,0,0,0,,Зерттеуді жалғастырыңыз!
Dialogue: 0,0:17:32.42,0:17:34.80,Default,,0,0,0,,Стратегия - келесі кезең.
Dialogue: 0,0:17:34.88,0:17:36.05,Default,,0,0,0,,Бірақ, Мәртебелі...
Dialogue: 0,0:17:36.63,0:17:38.51,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:17:38.59,0:17:43.56,Default,,0,0,0,,Егер бұл сырттан белгілі болса, мен мұрасыз қалуым мүмкін.
Dialogue: 0,0:17:44.10,0:17:47.39,Default,,0,0,0,,3-ші князь Кловис ретінде бұйрық
Dialogue: 0,0:17:47.48,0:17:50.31,Default,,0,0,0,,Синджуку геттосын жойыңыз!
Dialogue: 0,0:17:56.24,0:17:58.16,Default,,0,0,0,,Уау! Маған көмектесіңізші
Dialogue: 0,0:17:59.24,0:18:00.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:01.37,0:18:02.70,Default,,0,0,0,,Неліктен Британия...
Dialogue: 0,0:18:02.79,0:18:04.12,Default,,0,0,0,,Ата!
Dialogue: 0,0:18:04.66,0:18:06.29,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:18:07.04,0:18:09.37,Default,,0,0,0,,Қарсылас тіпті құрметті британдық.
Dialogue: 0,0:18:09.46,0:18:10.96,Default,,0,0,0,,Олар қабілетсіз қоқыс.
Dialogue: 0,0:18:11.04,0:18:13.42,Default,,0,0,0,,Әрқайсысын жойыңыз.
Dialogue: 0,0:18:13.96,0:18:15.26,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:18:15.34,0:18:16.34,Default,,0,0,0,,Директор Еремия
Dialogue: 0,0:18:16.42,0:18:19.13,Default,,0,0,0,,Генерал Батли менің 2-ші майдан армиясының қолбасшылығын алғанымды қалайды.
Dialogue: 0,0:18:19.22,0:18:21.14,Default,,0,0,0,,Мұнда қызметкер бар, солай ма?
Dialogue: 0,0:18:21.22,0:18:24.01,Default,,0,0,0,,Осы қымбат алдыңғы қатардан ләззат алыңыз!
Dialogue: 0,0:18:27.77,0:18:29.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:29.19,0:18:32.11,Default,,0,0,0,,(Лелуштың ауыр тыныс алуы)
Dialogue: 0,0:18:34.90,0:18:36.78,Default,,0,0,0,,Сіз қандайсыз!
Dialogue: 0,0:18:37.36,0:18:39.91,Default,,0,0,0,,Бұл әбігерге сен кінәлісің.
Dialogue: 0,0:18:39.99,0:18:41.45,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:41.53,0:18:43.78,Default,,0,0,0,,Сонымен қатар, Британия...
Dialogue: 0,0:18:43.87,0:18:46.62,Default,,0,0,0,,Британия тіпті Сузаку...
Dialogue: 0,0:18:48.62,0:18:50.17,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:18:50.25,0:18:52.04,Default,,0,0,0,,Майдан шебіне жіберілген сияқты.
Dialogue: 0,0:18:52.13,0:18:54.42,Default,,0,0,0,,Сіз өзіңізбен бірге Ланселотты алып келдіңіз бе?
Dialogue: 0,0:18:54.50,0:18:55.88,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:55.96,0:18:59.93,Default,,0,0,0,,Маңызды құрылғы жоқ деп ойлаймын.
Dialogue: 0,0:19:00.51,0:19:02.68,Default,,0,0,0,,Тыңдаңыз, сонда күтіңіз.
Dialogue: 0,0:19:05.93,0:19:06.85,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:19:06.93,0:19:08.77,Default,,0,0,0,,Тек он бір ғана бар сияқты.
Dialogue: 0,0:19:08.85,0:19:10.19,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:10.73,0:19:13.02,Default,,0,0,0,,Мына жерде, солай ма? шығудың бірі
Dialogue: 0,0:19:13.11,0:19:13.98,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.06,0:19:15.86,Default,,0,0,0,,Ескі қаланың картасы тексерілді.
Dialogue: 0,0:19:15.94,0:19:18.15,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:19:16.94,0:19:18.15,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:19:18.24,0:19:20.45,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:19:22.66,0:19:23.78,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:23.87,0:19:24.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:25.45,0:19:26.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.87,0:19:30.29,Default,,0,0,0,,Мен кесіп тастадым, Лулу жігіті.
Dialogue: 0,0:19:33.83,0:19:36.92,Default,,0,0,0,,Бұл террористтің соңғы сәттері үшін тамаша орын.
Dialogue: 0,0:19:37.00,0:19:38.17,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:19:38.26,0:19:41.09,Default,,0,0,0,,Жарайсыңдар, оқушыға жақсы жұмыс жасадыңдар.
Dialogue: 0,0:19:41.18,0:19:43.30,Default,,0,0,0,,Британдық күткендей.
Dialogue: 0,0:19:43.39,0:19:45.26,Default,,0,0,0,,Бірақ сіздің болашағыңыз
Dialogue: 0,0:19:45.35,0:19:46.68,Default,,0,0,0,,Енді бітті
Dialogue: 0,0:19:48.06,0:19:49.39,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,0:19:53.52,0:19:54.40,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:54.48,0:19:55.52,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:55.61,0:19:56.44,Default,,0,0,0,,Хун
Dialogue: 0,0:19:57.27,0:19:59.78,Default,,0,0,0,,Мен оны мүмкіндігінше тірі қалдырғым келді, бірақ...
Dialogue: 0,0:20:00.44,0:20:02.20,Default,,0,0,0,,Міне, мен жоғарыда хабарлаймын:
Dialogue: 0,0:20:02.78,0:20:07.28,Default,,0,0,0,,Біз, СС, лаңкестің жасырынған жерін тауып, жойдық.
Dialogue: 0,0:20:07.37,0:20:10.95,Default,,0,0,0,,Бірақ кепілге алынғандар өлтірілген болатын.
Dialogue: 0,0:20:11.04,0:20:13.46,Default,,0,0,0,,Сіз қалай ойлайсыз? студент
Dialogue: 0,0:20:13.54,0:20:15.04,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:20:15.63,0:20:17.88,Default,,0,0,0,,Созаку да, мына бала да...
Dialogue: 0,0:20:18.71,0:20:20.96,Default,,0,0,0,,Бұл аяқталады ма?
Dialogue: 0,0:20:21.05,0:20:23.76,Default,,0,0,0,,Мен де... Қолымнан ештеңе келмейді.
Dialogue: 0,0:20:26.68,0:20:29.60,Default,,0,0,0,,Оның біткенін қаламайсыз.
Dialogue: 0,0:20:30.56,0:20:31.52,Default,,0,0,0,,Не?
Dialogue: 0,0:20:31.60,0:20:34.77,Default,,0,0,0,,Сіздің өмір сүруге себеп бар сияқты.
Dialogue: 0,0:20:34.85,0:20:37.44,Default,,0,0,0,,Бұл бұрынғы әйел ме!? Мүмкін емес!
Dialogue: 0,0:20:37.52,0:20:40.15,Default,,0,0,0,,Сіз күшпен өмір сүре аласыз ба?
Dialogue: 0,0:20:41.07,0:20:42.53,Default,,0,0,0,,Бұл келісім-шарт
Dialogue: 0,0:20:43.07,0:20:44.36,Default,,0,0,0,,Күш берудің орнына
Dialogue: 0,0:20:44.45,0:20:48.03,Default,,0,0,0,,Менің бір ғана тілегім орындалсын.
Dialogue: 0,0:20:48.12,0:20:51.87,Default,,0,0,0,,Келісім-шарт жасасаңыз, адам әлемінде өмір сүре аласыз
Dialogue: 0,0:20:51.95,0:20:55.50,Default,,0,0,0,,Сіз басқа адамдарға қарағанда басқа логика бойынша өмір сүресіз.
Dialogue: 0,0:20:55.58,0:21:00.09,Default,,0,0,0,,Басқа уағыз, басқа уақыт, басқа өмір
Dialogue: 0,0:21:00.84,0:21:04.05,Default,,0,0,0,,Патшаның құдіреті сені жалғыз етеді
Dialogue: 0,0:21:04.13,0:21:06.43,Default,,0,0,0,,Егер сіз бұған дайын болсаңыз...
Dialogue: 0,0:21:08.26,0:21:09.51,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:09.60,0:21:12.14,Default,,0,0,0,,Сол келісім-шартты жасайық!
Dialogue: 0,0:21:17.52,0:21:18.73,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:21:18.81,0:21:19.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:20.48,0:21:23.15,Default,,0,0,0,,Британияны жек көретін британдықтар
Dialogue: 0,0:21:23.24,0:21:24.61,Default,,0,0,0,,Мен қалай өмір сүруім керек?
Dialogue: 0,0:21:24.70,0:21:26.86,Default,,0,0,0,,Сен сенушісің бе?
Dialogue: 0,0:21:26.95,0:21:27.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.86,0:21:30.33,Default,,0,0,0,,Не болды? Неге атпайсың?
Dialogue: 0,0:21:30.41,0:21:32.24,Default,,0,0,0,,Екінші адам – студент.
Dialogue: 0,0:21:32.33,0:21:34.29,Default,,0,0,0,,Әлде байқадыңыз ба?
Dialogue: 0,0:21:34.37,0:21:38.29,Default,,0,0,0,,Сіз атуға дайын адамдар ғана атуға тиіс.
Dialogue: 0,0:21:39.92,0:21:41.42,Default,,0,0,0,,Не?
Dialogue: 0,0:21:42.00,0:21:44.42,Default,,0,0,0,,Lelouch vi Britannia командалары
Dialogue: 0,0:21:44.51,0:21:46.34,Default,,0,0,0,,Балалар
Dialogue: 0,0:21:46.43,0:21:48.18,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:21:55.68,0:21:58.23,Default,,0,0,0,,Фухахахаха...
Dialogue: 0,0:21:58.31,0:22:00.06,Default,,0,0,0,,Иә Мәртебелі
Dialogue: 0,0:22:01.36,0:22:02.77,Default,,0,0,0,,Хэхе! (мылтық)
Dialogue: 0,0:22:02.86,0:22:04.15,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:22:04.23,0:22:06.15,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:22:11.20,0:22:12.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:15.41,0:22:16.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:18.62,0:22:20.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:22:32.80,0:22:34.56,Default,,0,0,0,,Неліктен СС...
Dialogue: 0,0:22:38.44,0:22:40.06,Default,,0,0,0,,Мұнда не болды!
Dialogue: 0,0:22:40.15,0:22:42.77,Default,,0,0,0,,Неліктен Британ студенттері осында?
Dialogue: 0,0:22:42.86,0:22:43.73,Default,,0,0,0,,Жауап!
Dialogue: 0,0:22:43.82,0:22:44.65,Default,,0,0,0,,Tsk
Dialogue: 0,0:22:46.40,0:22:47.57,Default,,0,0,0,,Жауап!
Dialogue: 0,0:22:48.74,0:22:49.86,Default,,0,0,0,,Сол жерден түсіңіз.
Dialogue: 0,0:22:49.95,0:22:51.41,Default,,0,0,0,,Енді
Dialogue: 0,0:22:51.49,0:22:52.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:52.70,0:22:55.08,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:22:55.74,0:22:57.83,Default,,0,0,0,,Мен көріп тұрмын Хун.
Dialogue: 0,0:22:57.91,0:22:59.75,Default,,0,0,0,,Өйткені, сіз оны тікелей көруіңіз керек.
Dialogue: 0,0:23:00.96,0:23:03.75,Default,,0,0,0,,Менің атым Алан Спейсер, ал әкем Маркес.
Dialogue: 0,0:23:03.84,0:23:05.38,Default,,0,0,0,,Маркиз туралы?
Dialogue: 0,0:23:05.46,0:23:07.80,Default,,0,0,0,,Ішкі қалтада жеке куәлік бар.
Dialogue: 0,0:23:07.88,0:23:10.47,Default,,0,0,0,,Тексергеннен кейін мен қорғауды сұрағым келеді.
Dialogue: 0,0:23:17.27,0:23:18.85,Default,,0,0,0,,Қолдарыңызды жоғары ұстаңыз
Dialogue: 0,0:23:18.93,0:23:20.77,Default,,0,0,0,,Мен сізге жеке куәлікті беремін.
Dialogue: 0,0:23:20.85,0:23:23.81,Default,,0,0,0,,Маған қорқынышты түсіңді бер
Dialogue: 0,0:23:32.61,0:23:37.45,Default,,0,0,0,,Жарайды, сандар XG2 (екі) - IG2 (екі) және D4 (төрт).
Dialogue: 0,0:23:38.50,0:23:39.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:23:42.62,0:23:43.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:44.33,0:23:46.96,Default,,0,0,0,,Мен не істеймін...
Dialogue: 0,0:23:49.46,0:23:50.84,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:23:50.92,0:23:51.76,Default,,0,0,0,,Ах!?
Dialogue: 0,0:23:52.63,0:23:55.72,Default,,0,0,0,,Сіз көкке баруды сағындыңыз ба, қатардағы Куруруги?
Dialogue: 0,0:23:55.80,0:23:56.97,Default,,0,0,0,,Ум... уф!
Dialogue: 0,0:23:57.47,0:23:58.43,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:23:58.52,0:24:01.06,Default,,0,0,0,,Иә? Әй, бұл әлі Шинджуку геттосы
Dialogue: 0,0:24:01.14,0:24:03.15,Default,,0,0,0,,Өйткені ол жоғары мәртебелі Хловистің жанында.
Dialogue: 0,0:24:03.23,0:24:05.52,Default,,0,0,0,,Бұл ең қауіпсіз жер.
Dialogue: 0,0:24:05.61,0:24:08.32,Default,,0,0,0,,Сузаку-кун, сені қорғаған осы болды.
Dialogue: 0,0:24:08.40,0:24:12.07,Default,,0,0,0,,Бұл оқтың қорғаныс костюмінің ішіне секіріп түсуіне жол бермеді.
Dialogue: 0,0:24:12.15,0:24:13.45,Default,,0,0,0,,Маңызды нәрсе бар ма?
Dialogue: 0,0:24:13.53,0:24:15.07,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:24:15.16,0:24:18.79,Default,,0,0,0,,Шамасы, Он бірде құдайлар заттарда тұрады деген сенім бар.
Dialogue: 0,0:24:18.87,0:24:19.91,Default,,0,0,0,,Осыған ұқсас нәрсе...
Dialogue: 0,0:24:20.00,0:24:21.58,Default,,0,0,0,,Сол Лулу...
Dialogue: 0,0:24:22.46,0:24:24.54,Default,,0,0,0,,Жағдайға не болды?
Dialogue: 0,0:24:24.62,0:24:26.25,Default,,0,0,0,,Улы газ тарап кеткен сияқты.
Dialogue: 0,0:24:26.84,0:24:29.25,Default,,0,0,0,,Он бір адам көп шығынға ұшырады.
Dialogue: 0,0:24:29.34,0:24:31.76,Default,,0,0,0,,Кінәлі әлі табылмаған сияқты.
Dialogue: 0,0:24:31.84,0:24:33.76,Default,,0,0,0,,Шынымен бе? Әлі емес...
Dialogue: 0,0:24:33.84,0:24:35.30,Default,,0,0,0,,Жеке Куруруги
Dialogue: 0,0:24:35.39,0:24:37.89,Default,,0,0,0,,Nightmare Frame міну тәжірибесі бар ма?
Dialogue: 0,0:24:37.97,0:24:39.76,Default,,0,0,0,,бірақ мен әлемді өзгерту үшін өзім кісі өлтірушіге айналар едім деп ойламаймын
Dialogue: 0,0:24:39.85,0:24:42.31,Default,,0,0,0,,Он бір тобының адамдары рыцарь бола алмайды.
Dialogue: 0,0:24:42.39,0:24:43.60,Default,,0,0,0,,Егер сіз бір бола алсаңыз, ол не болар еді?
Dialogue: 0,0:24:51.23,0:24:52.90,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:24:52.99,0:24:54.82,Default,,0,0,0,,Карен! Глазго әлі қозғала ма?
Dialogue: 0,0:24:54.91,0:24:55.74,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:24:56.28,0:25:00.04,Default,,0,0,0,,Мен алдамшы боламын, сондықтан Оги-сан мұндағы адамдарға қашып кетуге мүмкіндік береді.
Dialogue: 0,0:25:00.12,0:25:02.08,Default,,0,0,0,,Тек біз, қарсылық, қолға түседі.
Dialogue: 0,0:25:02.16,0:25:05.17,Default,,0,0,0,,Мен білемін! Бірақ егер мені осыншама қоршап алса...
Dialogue: 0,0:25:05.25,0:25:08.29,Default,,0,0,0,,(теледидар дыбысы)
Dialogue: 0,0:25:08.38,0:25:10.71,Default,,0,0,0,,Бұл сіздің аяғыңыздың күші жеткіліксіз болғандықтан, солай ма?
Dialogue: 0,0:25:10.80,0:25:13.01,Default,,0,0,0,,Жоқ, сіз салмақ қосқандықтан батып кетесіз дейді.
Dialogue: 0,0:25:13.09,0:25:14.13,Default,,0,0,0,,Бұл мен тамақ ішкендіктен емес.
Dialogue: 0,0:25:14.22,0:25:15.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:25:15.13,0:25:16.09,Default,,0,0,0,,Қос жаттығу
Dialogue: 0,0:25:15.55,0:25:17.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:16.18,0:25:17.47,Default,,0,0,0,,Сіз калорияларды тұтынып жатырсыз.
Dialogue: 0,0:25:17.55,0:25:19.18,Default,,0,0,0,,Көп жеме.
Dialogue: 0,0:25:19.89,0:25:22.10,Default,,0,0,0,,Лулу? Енді ше?
Dialogue: 0,0:25:22.18,0:25:23.60,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:25:23.68,0:25:25.44,Default,,0,0,0,,Егер сіз үнемі бос жүрсеңіз, сіз бағаны қайталайсыз...
Dialogue: 0,0:25:25.52,0:25:26.90,Default,,0,0,0,,Онда теледидар бар ма?
Dialogue: 0,0:25:26.98,0:25:27.90,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:25:28.61,0:25:30.19,Default,,0,0,0,,Кешіріңіз, бұл маңызды.
Dialogue: 0,0:25:30.27,0:25:31.36,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:25:31.44,0:25:33.49,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:25:33.57,0:25:35.45,Default,,0,0,0,,Кешіріңіз, оны қарызға алуға рұқсат етіңіз. (Қыз студент) Не?
Dialogue: 0,0:25:35.53,0:25:37.86,Default,,0,0,0,,Жаңалықтар. Синдзюкуда бірдеңе болып жатыр ма?
Dialogue: 0,0:25:37.95,0:25:40.12,Default,,0,0,0,,Жаңалықтар? Жақсы
Dialogue: 0,0:25:40.20,0:25:42.62,Default,,0,0,0,,Тек жол қозғалысын реттеу, басқа ештеңе...
Dialogue: 0,0:25:43.20,0:25:44.25,Default,,0,0,0,,Реттеудің себебі неде?
Dialogue: 0,0:25:44.33,0:25:46.54,Default,,0,0,0,,Білмеймін, ол ерекше пайда болған жоқ.
Dialogue: 0,0:25:47.12,0:25:48.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:25:48.33,0:25:51.92,Default,,0,0,0,,Сіз бәрі аяқталғаннан кейін әскерге қолайлы түрде есеп беруді жоспарлайсыз ба?
Dialogue: 0,0:25:53.17,0:25:56.42,Default,,0,0,0,,Эй, сен тағы бір қызық құмар ойын ойнап тұрсың ғой, солай ма?
Dialogue: 0,0:25:56.51,0:25:58.55,Default,,0,0,0,,Жоғарыда айтқанымдай, мұндай қауіп...
Dialogue: 0,0:25:58.64,0:26:00.60,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:26:00.68,0:26:04.06,Default,,0,0,0,,Әй, әпкеме үйге кеш келетінімді айтыңызшы.
Dialogue: 0,0:26:04.14,0:26:04.98,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:26:05.89,0:26:09.56,Default,,0,0,0,,Ақпарат құпия сақталатындықтан, қосымша күштерді ашық түрде шақыру қиын.
Dialogue: 0,0:26:09.65,0:26:12.65,Default,,0,0,0,,Басқаша айтқанда, бұл тақтадағы жалғыз бөлік.
Dialogue: 0,0:26:12.73,0:26:17.20,Default,,0,0,0,,Алайда мұндай қоршаудан жалғыз өту қиын.
Dialogue: 0,0:26:17.28,0:26:19.36,Default,,0,0,0,,Әскерилерден қорғауды сұрау қауіпті...
Dialogue: 0,0:26:24.54,0:26:26.87,Default,,0,0,0,,Маған қатысты қарызды қайтарғанымды қалайсыз ба?
Dialogue: 0,0:26:29.29,0:26:31.17,Default,,0,0,0,,Иә!? Бұл Глазго ма?
Dialogue: 0,0:26:36.63,0:26:38.30,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:26:38.38,0:26:40.05,Default,,0,0,0,,30 минут қалды!?
Dialogue: 0,0:26:40.14,0:26:41.39,Default,,0,0,0,,Батыстан шығу!
Dialogue: 0,0:26:41.47,0:26:43.81,Default,,0,0,0,,Батыс шығысқа өту үшін темір жолдарды пайдаланыңыз.
Dialogue: 0,0:26:43.89,0:26:46.14,Default,,0,0,0,,Бұл кім? сіз бұл кодты қайдан білесіз
Dialogue: 0,0:26:46.22,0:26:49.44,Default,,0,0,0,,Кім екенің маңызды емес, егер жеңгің келсе, маған сен.
Dialogue: 0,0:26:49.52,0:26:50.35,Default,,0,0,0,,Жеңіс пе?
Dialogue: 0,0:26:55.69,0:26:57.53,Default,,0,0,0,,Эй, енді не істеуім керек!?
Dialogue: 0,0:26:59.11,0:27:01.16,Default,,0,0,0,,Бейшара он бір
Dialogue: 0,0:27:01.24,0:27:04.28,Default,,0,0,0,,Тек қашу сізді аң аулауға мәжбүрлемейтін шығар.
Dialogue: 0,0:27:04.37,0:27:06.33,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:27:07.33,0:27:09.83,Default,,0,0,0,,Маған сенгендіктен, мен сені жеңуге мүмкіндік беремін.
Dialogue: 0,0:27:09.91,0:27:11.33,Default,,0,0,0,,Бұған өтіңіз
Dialogue: 0,0:27:11.42,0:27:12.79,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:27:13.79,0:27:16.13,Default,,0,0,0,,Бұл жұмыс істейді деп ойладыңыз ба?
Dialogue: 0,0:27:16.21,0:27:18.30,Default,,0,0,0,,Мұндай стратегия...
Dialogue: 0,0:27:18.38,0:27:19.67,Default,,0,0,0,,Сіз Глазгоға қарайсыз
Dialogue: 0,0:27:19.76,0:27:21.18,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,0:27:22.05,0:27:23.35,Default,,0,0,0,,Не!?
Dialogue: 0,0:27:26.31,0:27:28.27,Default,,0,0,0,,Бір-бірімен күресуге қалай болады?
Dialogue: 0,0:27:28.35,0:27:29.68,Default,,0,0,0,,Сіз қай бөлімшедесіз?
Dialogue: 0,0:27:29.77,0:27:30.73,Default,,0,0,0,,Жау – бір қарулы...
Dialogue: 0,0:27:31.94,0:27:33.56,Default,,0,0,0,,Жоқ! Террорист!?
Dialogue: 0,0:27:36.57,0:27:37.65,Default,,0,0,0,,Қарғыс атсын! Ки...
Dialogue: 0,0:27:37.73,0:27:38.78,Default,,0,0,0,,Сіз!
Dialogue: 0,0:27:38.86,0:27:40.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:40.82,0:27:42.16,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:27:51.41,0:27:52.75,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:27:52.83,0:27:55.13,Default,,0,0,0,,Бірақ Сазерленд қалайша...
Dialogue: 0,0:27:55.79,0:27:57.80,Default,,0,0,0,,Мм... қайда?
Dialogue: 0,0:27:57.88,0:28:00.97,Default,,0,0,0,,Сәлем, Карен, бұрынғы хабар қандай еді!?
Dialogue: 0,0:28:01.05,0:28:02.93,Default,,0,0,0,,Иә? Оугиге және басқаларға да?
Dialogue: 0,0:28:03.01,0:28:05.01,Default,,0,0,0,,Ах! Йошида және басқалармен де байланысқа шықты.
Dialogue: 0,0:28:05.10,0:28:06.81,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,0:28:06.89,0:28:07.97,Default,,0,0,0,,Сіз көшбасшысыз ба?
Dialogue: 0,0:28:08.06,0:28:09.22,Default,,0,0,0,,А? Ах...
Dialogue: 0,0:28:09.81,0:28:10.68,Default,,0,0,0,,Ол сонда тоқтайды——
Dialogue: 0,0:28:10.77,0:28:12.52,Default,,0,0,0,,Поезд жүктерін сыйлыққа беру
Dialogue: 0,0:28:12.60,0:28:14.15,Default,,0,0,0,,Бұл жеңіске жету құралы.
Dialogue: 0,0:28:15.11,0:28:17.82,Default,,0,0,0,,Егер сіз оны жеңу үшін пайдаланғыңыз келсе, оны менің бұйрығыма қойыңыз.
Dialogue: 0,0:28:19.44,0:28:20.69,Default,,0,0,0,,Бұл да осында!
Dialogue: 0,0:28:20.78,0:28:21.78,Default,,0,0,0,,Бұл да
Dialogue: 0,0:28:21.86,0:28:24.66,Default,,0,0,0,,Бұл таңқаларлық. Неге әңгімені тыңдамайсың?
Dialogue: 0,0:28:24.74,0:28:25.95,Default,,0,0,0,,Глазгодағы әйел
Dialogue: 0,0:28:26.03,0:28:26.91,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:28:26.99,0:28:28.20,Default,,0,0,0,,Сіз қандай болсаңыз, солай қаласыз.
Dialogue: 0,0:28:28.28,0:28:29.95,Default,,0,0,0,,Әуе кемесі кедергі жасауға жарамды.
Dialogue: 0,0:28:30.04,0:28:31.41,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:28:31.50,0:28:32.71,Default,,0,0,0,,Энергия толтырғыштар туралы не деуге болады?
Dialogue: 0,0:28:32.79,0:28:34.04,Default,,0,0,0,,15
Dialogue: 0,0:28:34.12,0:28:35.92,Default,,0,0,0,,Содан кейін оны жаңа бума ретінде сақтаңыз.
Dialogue: 0,0:28:36.00,0:28:38.29,Default,,0,0,0,,Келесі нұсқауларды 10 минуттан кейін алыңыз
Dialogue: 0,0:28:39.88,0:28:42.97,Default,,0,0,0,,Ха... таң қаларлықтай шаршатады.
Dialogue: 0,0:28:43.05,0:28:46.68,Default,,0,0,0,,Бірақ оны көру үшін сізге батылдық қажет.
Dialogue: 0,0:28:46.76,0:28:49.81,Default,,0,0,0,,Бұл сіздің өміріңізге қауіп төндіретін ойын!
Dialogue: 0,0:28:50.56,0:28:52.56,Default,,0,0,0,,Эй, сен өзіңнің жақсы екеніне сенімдісің бе?
Dialogue: 0,0:28:52.64,0:28:55.69,Default,,0,0,0,,IFF жойылды және бұл жаудың тұзағы.
Dialogue: 0,0:28:55.77,0:28:58.69,Default,,0,0,0,,Қарсы тарап соғыстың барлық аспектілерінде артықшылыққа ие.
Dialogue: 0,0:28:58.77,0:29:00.11,Default,,0,0,0,,Тұзақтардың қажеті жоқ.
Dialogue: 0,0:29:00.94,0:29:02.53,Default,,0,0,0,,Сіз де көрсетілген нүктелерге өтіңіз...
Dialogue: 0,0:29:02.61,0:29:04.24,Default,,0,0,0,,P1 Сіз оны жылжыта аласыз ба?
Dialogue: 0,0:29:04.32,0:29:06.87,Default,,0,0,0,,Негіздер бұрынғыдай қалуы керек.
Dialogue: 0,0:29:06.95,0:29:08.03,Default,,0,0,0,,Сіз кімсіз!?
Dialogue: 0,0:29:08.12,0:29:09.28,Default,,0,0,0,,Тек аты
Dialogue: 0,0:29:09.37,0:29:10.20,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:29:10.87,0:29:13.12,Default,,0,0,0,,Хабарламаларыңыз ұсталып қалса, не істеу керек
Dialogue: 0,0:29:13.20,0:29:16.75,Default,,0,0,0,,23 секундтан кейін жау Сазерленд сонда болады.
Dialogue: 0,0:29:16.83,0:29:18.13,Default,,0,0,0,,Екі жазықтық болуы мүмкін
Dialogue: 0,0:29:18.21,0:29:19.50,Default,,0,0,0,,Қабырға арқылы ату
Dialogue: 0,0:29:20.09,0:29:21.46,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:29:22.01,0:29:24.26,Default,,0,0,0,,Барлығың қаруларыңды тексеріңдер.
Dialogue: 0,0:29:24.34,0:29:25.97,Default,,0,0,0,,Сәлем! Шын айтасың ба?
Dialogue: 0,0:29:27.47,0:29:29.39,Default,,0,0,0,,Ｆ３１
Dialogue: 0,0:29:29.47,0:29:31.81,Default,,0,0,0,,Бұл бұрыс немесе маймылдың даналығы.
Dialogue: 0,0:29:31.89,0:29:33.93,Default,,0,0,0,,Ласлоудың командасы алға қарай жалғастыруда.
Dialogue: 0,0:29:34.02,0:29:35.77,Default,,0,0,0,,Тура Евген мен Валери.
Dialogue: 0,0:29:35.85,0:29:36.98,Default,,0,0,0,,Артынан ұру
Dialogue: 0,0:29:37.98,0:29:40.65,Default,,0,0,0,,3 2 1…
Dialogue: 0,0:29:40.73,0:29:41.65,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:29:43.28,0:29:44.36,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:29:46.65,0:29:48.95,Default,,0,0,0,,Лорд Евген мен лорд Валери екеуі де адасып қалды!
Dialogue: 0,0:29:49.03,0:29:50.87,Default,,0,0,0,,Иә?Ambuscade?
Dialogue: 0,0:29:51.70,0:29:55.54,Default,,0,0,0,,Хехехехе... Сәйкестендіру сигналдары екі жүзді қылыш.
Dialogue: 0,0:29:55.62,0:29:59.38,Default,,0,0,0,,Ал егер террористер менің нұсқауларымды орындаса.
Dialogue: 0,0:29:59.46,0:30:01.29,Default,,0,0,0,,Шарттар тазартылған сияқты.
Dialogue: 0,0:30:02.05,0:30:04.96,Default,,0,0,0,,P1 P4 (Төрт) P7 100 метр оңға жылжу.
Dialogue: 0,0:30:05.05,0:30:06.76,Default,,0,0,0,,Харкенді сағат 3-ке қарай қиғаш етіңіз
Dialogue: 0,0:30:07.26,0:30:08.97,Default,,0,0,0,,Жарайды, мына дауысқа еріңіз!
Dialogue: 0,0:30:09.05,0:30:11.43,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:30:11.51,0:30:12.76,Default,,0,0,0,,Әлі емес пе? P5
Dialogue: 0,0:30:12.85,0:30:14.39,Default,,0,0,0,,Мені біртүрлі есімдермен атама!
Dialogue: 0,0:30:15.56,0:30:17.52,Default,,0,0,0,,Жау көлеңкесі G28-ге көшіңіз
Dialogue: 0,0:30:17.60,0:30:20.15,Default,,0,0,0,,Ласлоудың отрядын бұрыңыз... жоқ, Глаубты бұрыңыз!
Dialogue: 0,0:30:20.23,0:30:23.32,Default,,0,0,0,,Әйтеуір... біздің әскери ұшағымыз террористке айналды ма?
Dialogue: 0,0:30:31.70,0:30:34.41,Default,,0,0,0,,Лорд Глаубтың қашуы Ұшақ жоғалды
Dialogue: 0,0:30:34.49,0:30:36.20,Default,,0,0,0,,Қандай қателік!
Dialogue: 0,0:30:36.29,0:30:37.54,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:30:37.62,0:30:39.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:30:39.25,0:30:41.08,Default,,0,0,0,,Не? Миссия кезінде!
Dialogue: 0,0:30:41.17,0:30:43.71,Default,,0,0,0,,Жоқ, арнайы жасақтың жетекші қаруының уақыты келді.
Dialogue: 0,0:30:43.80,0:30:45.63,Default,,0,0,0,,Қазір емес!
Dialogue: 0,0:30:46.88,0:30:48.72,Default,,0,0,0,,R2 (Екі) Анкерлік ұшыру
Dialogue: 0,0:30:50.43,0:30:51.55,Default,,0,0,0,,Ｂ７ ＵＮ
Dialogue: 0,0:30:53.05,0:30:55.14,Default,,0,0,0,,N тобы алға қарай жалғастырады.
Dialogue: 0,0:30:55.22,0:30:56.47,Default,,0,0,0,,Екі бетке жиырма минут деді ме? Дұрыс естімеген шығармын?
Dialogue: 0,0:30:56.56,0:30:58.60,Default,,0,0,0,,Ласлоу отрядының жауабы жоғалып кетті.
Dialogue: 0,0:30:58.69,0:31:01.35,Default,,0,0,0,,Қазір! Маған Квинси әскерлерін беріңіз!
Dialogue: 0,0:31:01.44,0:31:03.27,Default,,0,0,0,,Мәртебелі, содан кейін қоршау...
Dialogue: 0,0:31:03.86,0:31:07.19,Default,,0,0,0,,Енді жаудың бес мүмкіндігі бар.
Dialogue: 0,0:31:07.28,0:31:10.36,Default,,0,0,0,,Сіз өткен тесікке қорғаныс күшіңізді жібере аласыз.
Dialogue: 0,0:31:10.45,0:31:13.12,Default,,0,0,0,,Бір топ жаудың қазір осында екені анық.
Dialogue: 0,0:31:15.12,0:31:17.20,Default,,0,0,0,,Олар формацияны бұзады ма?
Dialogue: 0,0:31:17.29,0:31:19.91,Default,,0,0,0,,Не, сіз ең ақымақ қадам жасадыңыз ба?
Dialogue: 0,0:31:21.08,0:31:23.25,Default,,0,0,0,,Ｑ１
Dialogue: 0,0:31:23.33,0:31:25.09,Default,,0,0,0,,Ах, ескі қала
Dialogue: 0,0:31:25.17,0:31:27.42,Default,,0,0,0,,Жарайды, Бельц пен басқалары да кетсін!
Dialogue: 0,0:31:27.51,0:31:28.76,Default,,0,0,0,,Миссия №3 (үш)
Dialogue: 0,0:31:28.84,0:31:30.80,Default,,0,0,0,,Өзіңізді қоршай отырып, күштеріңізді шоғырландырыңыз!
Dialogue: 0,0:31:30.88,0:31:31.89,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:31:31.97,0:31:34.55,Default,,0,0,0,,Терроршылардың негізгі күштері орталықта
Dialogue: 0,0:31:35.18,0:31:36.26,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:31:36.35,0:31:37.43,Default,,0,0,0,,Иә
Dialogue: 0,0:31:47.32,0:31:48.94,Default,,0,0,0,,Не? Ешқандай жау жоқ!?
Dialogue: 0,0:31:49.03,0:31:51.03,Default,,0,0,0,,Енді тексеріңіз
Dialogue: 0,0:32:01.25,0:32:03.42,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:32:03.50,0:32:04.83,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:32:04.92,0:32:06.84,Default,,0,0,0,,Сіз мұны істей аласыз! Сіз жасай аласыз!
Dialogue: 0,0:32:06.92,0:32:08.76,Default,,0,0,0,,Британияны жеңу!
Dialogue: 0,0:32:10.76,0:32:12.09,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:32:12.18,0:32:14.76,Default,,0,0,0,,Мен кіммен күресіп жатырмын?
Dialogue: 0,0:32:14.84,0:32:15.72,Default,,0,0,0,,Ллойд!
Dialogue: 0,0:32:15.80,0:32:17.18,Default,,0,0,0,,А? Иә!
Dialogue: 0,0:32:17.26,0:32:20.60,Default,,0,0,0,,Сіз жеңе аласыз ба? Егер бұл сіздің ойыншығыңыз болса
Dialogue: 0,0:32:20.68,0:32:24.77,Default,,0,0,0,,Мәртебелі, мені Ланселот деп атаңыз.
Dialogue: 0,0:32:24.85,0:32:28.82,Default,,0,0,0,,Нұсқаулық қару Z01 (Z Zero One) Ланселот басталады.
Dialogue: 0,0:32:28.90,0:32:30.28,Default,,0,0,0,,Ланселот басталады
Dialogue: 0,0:32:31.15,0:32:32.28,Default,,0,0,0,,Люктің ашылуы
Dialogue: 0,0:32:32.36,0:32:34.86,Default,,0,0,0,,Z01 Lancelot іске қосудың күту режимі
Dialogue: 0,0:32:34.95,0:32:36.82,Default,,0,0,0,,Палитраны кеңейтуді бастаңыз
Dialogue: 0,0:32:36.91,0:32:38.16,Default,,0,0,0,,Нұсқаулық туралы не деуге болады?
Dialogue: 0,0:32:38.24,0:32:39.29,Default,,0,0,0,,Шамамен
Dialogue: 0,0:32:39.37,0:32:40.54,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:32:40.62,0:32:43.83,Default,,0,0,0,,Бұл тренажер болса да, тек жоғары сыныпта қолжетімді нәрселер бар.
Dialogue: 0,0:32:43.92,0:32:46.75,Default,,0,0,0,,Мм... бұрын айтқаным туралы.
Dialogue: 0,0:32:46.83,0:32:49.30,Default,,0,0,0,,Не? А, мүмкін
Dialogue: 0,0:32:49.38,0:32:51.34,Default,,0,0,0,,Мүмкіндік нөлге жақын.
Dialogue: 0,0:32:51.42,0:32:53.76,Default,,0,0,0,,Бірақ бұл нөл емес, солай ма?
Dialogue: 0,0:32:53.84,0:32:55.22,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:32:56.30,0:32:58.76,Default,,0,0,0,,Бірақ мен сенің ақылсыз нәрсе істегеніңді қаламаймын.
Dialogue: 0,0:32:58.85,0:33:02.18,Default,,0,0,0,,Жаңа жүйемен шығу функциясы жойылды.
Dialogue: 0,0:33:02.27,0:33:05.35,Default,,0,0,0,,Иә, түсінемін, Сесил мырза.
Dialogue: 0,0:33:07.11,0:33:08.61,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:33:09.40,0:33:13.07,Default,,0,0,0,,Иә, біз, арнайы диспетчерлік басшылықтың техникалық бөлімі——
Dialogue: 0,0:33:13.15,0:33:15.78,Default,,0,0,0,,Ланселот ұшқыш қаруының прототипі
Dialogue: 0,0:33:15.86,0:33:19.41,Default,,0,0,0,,Әлемдегі жалғыз 7-ші буын Nightmare кадры.
Dialogue: 0,0:33:20.08,0:33:23.66,Default,,0,0,0,,Ал, Сузаку-кун, қазір бастапқы іске қосуды бастайық.
Dialogue: 0,0:33:23.75,0:33:26.25,Default,,0,0,0,,20
Dialogue: 0,0:33:26.83,0:33:28.29,Default,,0,0,0,,Энергия толтырғышты орнату
Dialogue: 0,0:33:28.38,0:33:31.46,Default,,0,0,0,,Іске қосу алдындағы Қуат толтырғышының шығыс рейтингін тексеріңіз
Dialogue: 0,0:33:31.55,0:33:33.51,Default,,0,0,0,,Критикалық деңгейге жету үшін кернеу 30 секунд
Dialogue: 0,0:33:33.59,0:33:36.55,Default,,0,0,0,,Coreluminas Phase Transition Yggdrasil Drive Жақсы баптау
Dialogue: 0,0:33:36.63,0:33:38.47,Default,,0,0,0,,Құрылғыны орнату
Dialogue: 0,0:33:41.51,0:33:43.64,Default,,0,0,0,,Девайзердің Z01 жазбасын тексеріңіз
Dialogue: 0,0:33:44.23,0:33:45.81,Default,,0,0,0,,Жеке сәйкестендіру ақпаратын тіркеу аяқталды
Dialogue: 0,0:33:45.89,0:33:47.73,Default,,0,0,0,,Адам мен машина интерфейсін орнатуды растау
Dialogue: 0,0:33:48.60,0:33:50.90,Default,,0,0,0,,Кернеудің критикалық деңгейі Негізгі жүйені іске қосу
Dialogue: 0,0:33:51.48,0:33:52.82,Default,,0,0,0,,Құрылғыны орнату аяқталды
Dialogue: 0,0:33:52.90,0:33:54.78,Default,,0,0,0,,Әзірге деректер дұрыс...
Dialogue: 0,0:33:54.86,0:33:57.45,Default,,0,0,0,,Slash Harken тұтандырғышын іске қосу
Dialogue: 0,0:33:57.53,0:33:59.62,Default,,0,0,0,,резервтік тактикалық банк күйін бекіту
Dialogue: 0,0:34:05.04,0:34:05.87,Default,,0,0,0,,All System Go
Dialogue: 0,0:34:05.96,0:34:08.88,Default,,0,0,0,,Z01 Lancelot сұрыптауды күту режимі аяқталды
Dialogue: 0,0:34:09.38,0:34:11.79,Default,,0,0,0,,Lancelot ME Boost
Dialogue: 0,0:34:14.80,0:34:15.97,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,0:34:19.89,0:34:23.06,Default,,0,0,0,,Ахахаха Кенет дроссель болды!
Dialogue: 0,0:34:25.06,0:34:27.27,Default,,0,0,0,,Бұл нұсқаулыққа қарағанда жақсы.
Dialogue: 0,0:34:27.35,0:34:28.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:28.48,0:34:30.31,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:34:30.40,0:34:31.98,Default,,0,0,0,,Сазерлендке барайық... О!
Dialogue: 0,0:34:33.98,0:34:36.32,Default,,0,0,0,,Бұл В тобы. Жаудың көлеңкесін тексеріңіз!
Dialogue: 0,0:34:36.40,0:34:38.07,Default,,0,0,0,,Иә? Күшейткіштер?
Dialogue: 0,0:34:38.15,0:34:39.82,Default,,0,0,0,,Нақты ұрыс басқаша.
Dialogue: 0,0:34:39.91,0:34:40.95,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:34:41.03,0:34:43.95,Default,,0,0,0,,Барлығы қашып кетті, бірақ 4 ұшақ тез жоғалып кетті.
Dialogue: 0,0:34:44.04,0:34:44.87,Default,,0,0,0,,Қанша жау бар?
Dialogue: 0,0:34:44.95,0:34:46.25,Default,,0,0,0,,Бір ұшақ! Бір ұшақ!
Dialogue: 0,0:34:46.33,0:34:48.92,Default,,0,0,0,,Бұл жаңа үлгі емес пе? Бұл мен көрген бірінші түрі...
Dialogue: 0,0:34:49.00,0:34:50.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:50.67,0:34:51.88,Default,,0,0,0,,Әй, не болды!?
Dialogue: 0,0:35:00.64,0:35:02.05,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:35:03.68,0:35:05.64,Default,,0,0,0,,Не? Жанды оқтарды тойтарады!?
Dialogue: 0,0:35:05.72,0:35:07.06,Default,,0,0,0,,А, мен не істеуім керек?
Dialogue: 0,0:35:07.14,0:35:08.85,Default,,0,0,0,,Кимура!? Апыр-ай!
Dialogue: 0,0:35:08.94,0:35:11.27,Default,,0,0,0,,Цк, сен пайдасыз террористсің.
Dialogue: 0,0:35:11.35,0:35:14.07,Default,,0,0,0,,Егер сіз оны бір ғана бірлікпен итерсеңіз...
Dialogue: 0,0:35:17.65,0:35:18.95,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:35:22.82,0:35:26.08,Default,,0,0,0,,Жарайды, мен істей аламын! Осы Lancelot көмегімен сіз бәрін бірден жасай аласыз!
Dialogue: 0,0:35:26.16,0:35:28.33,Default,,0,0,0,,N4 (Төрт) N5 Тоқтау.
Dialogue: 0,0:35:28.41,0:35:29.96,Default,,0,0,0,,Келесі жасақтар келген кезде оларды қоршаңыз.
Dialogue: 0,0:35:30.04,0:35:30.92,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:35:37.00,0:35:38.84,Default,,0,0,0,,Мен оны тоқтата алмаймын!
Dialogue: 0,0:35:41.72,0:35:42.97,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:35:43.05,0:35:44.55,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,0:35:44.64,0:35:47.14,Default,,0,0,0,,Не? не болып жатыр?
Dialogue: 0,0:35:47.22,0:35:48.56,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:35:48.64,0:35:51.81,Default,,0,0,0,,Мен ағама қажетсіз қарыз болдым.
Dialogue: 0,0:35:51.89,0:35:53.31,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:35:57.36,0:35:58.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:59.69,0:36:01.70,Default,,0,0,0,,P1! Не болды!?
Dialogue: 0,0:36:02.20,0:36:05.12,Default,,0,0,0,,Расында бір ғана жау бар ма?
Dialogue: 0,0:36:11.91,0:36:14.13,Default,,0,0,0,,Егер мен барлық қорқынышты түстерді тоқтатсам
Dialogue: 0,0:36:14.21,0:36:15.67,Default,,0,0,0,,Шайқас аяқталды
Dialogue: 0,0:36:15.75,0:36:18.67,Default,,0,0,0,,Мен Лелуш пен сол баланы қандай жағдайда да құтқаруым керек...
Dialogue: 0,0:36:19.76,0:36:20.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:29.06,0:36:30.93,Default,,0,0,0,,Бұл жігіт! менің стратегиям
Dialogue: 0,0:36:32.19,0:36:33.56,Default,,0,0,0,,Сіз командирсіз!?
Dialogue: 0,0:36:35.31,0:36:37.69,Default,,0,0,0,,Жай ғана ұшқыш... Жарайсың!
Dialogue: 0,0:36:42.28,0:36:44.61,Default,,0,0,0,,Менің мұнда қашудан басқа амалым жоқ...
Dialogue: 0,0:36:45.49,0:36:46.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:49.04,0:36:49.91,Default,,0,0,0,,Куу…
Dialogue: 0,0:36:53.83,0:36:55.37,Default,,0,0,0,,Сәлем! Мен сенің қарызыңды қайтарамын!
Dialogue: 0,0:37:00.17,0:37:01.09,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:37:07.35,0:37:09.06,Default,,0,0,0,,Мен үйренуім керек
Dialogue: 0,0:37:09.14,0:37:10.81,Default,,0,0,0,,Адамдар нақты шайқастың кілті ме?
Dialogue: 0,0:37:10.89,0:37:11.93,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:37:20.86,0:37:22.61,Default,,0,0,0,,Бұл не құбыжық?
Dialogue: 0,0:37:24.61,0:37:27.37,Default,,0,0,0,,Ол қажетсіз зиян келтірді...
Dialogue: 0,0:37:27.45,0:37:28.70,Default,,0,0,0,,Ах
Dialogue: 0,0:37:28.78,0:37:30.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:33.12,0:37:33.96,Default,,0,0,0,,Қақпақ
Dialogue: 0,0:37:35.71,0:37:37.96,Default,,0,0,0,,Ұрыс кезінде біреуге көмектесу деген нені білдіреді?
Dialogue: 0,0:37:38.04,0:37:41.92,Default,,0,0,0,,Хмф, мен сізге қанша қаласаңыз, сонша тактикалық жеңістер беремін.
Dialogue: 0,0:37:42.00,0:37:43.05,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:37:46.72,0:37:48.51,Default,,0,0,0,,Иә? Адамдарға көмектесу?
Dialogue: 0,0:37:48.59,0:37:50.05,Default,,0,0,0,,сияқты...
Dialogue: 0,0:37:50.14,0:37:53.06,Default,,0,0,0,,Хмм, бұл біртүрлі.
Dialogue: 0,0:37:53.14,0:37:54.52,Default,,0,0,0,,А... а...
Dialogue: 0,0:37:55.39,0:37:56.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:56.60,0:37:57.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:58.06,0:37:59.98,Default,,0,0,0,,Жұмыс уақытына назар аударыңыз
Dialogue: 0,0:38:00.06,0:38:00.90,Default,,0,0,0,,Иә
Dialogue: 0,0:38:00.98,0:38:04.36,Default,,0,0,0,,Жақсы, ол ең жақсы бөлік.
Dialogue: 0,0:38:05.11,0:38:07.28,Default,,0,0,0,,ＩＤ
Dialogue: 0,0:38:07.36,0:38:09.74,Default,,0,0,0,,Бұл Мәртебелі Хловистің мінетін кемесі.
Dialogue: 0,0:38:09.82,0:38:13.41,Default,,0,0,0,,Тексеру ақыры жоспарланғандай жасалды.
Dialogue: 0,0:38:13.49,0:38:14.45,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:38:14.54,0:38:17.12,Default,,0,0,0,,А, мен сенің осы жерден өткеніңді қалаймын.
Dialogue: 0,0:38:17.92,0:38:19.54,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:38:21.04,0:38:24.13,Default,,0,0,0,,Бұл сіз Британияға қарсы шыққаныңыз үшін!
Dialogue: 0,0:38:24.21,0:38:26.63,Default,,0,0,0,,Не! Менімен бетпе-бет келуге батылы жетпеген адам!
Dialogue: 0,0:38:26.72,0:38:28.55,Default,,0,0,0,,Қанша адам өлді деп ойлайсың?
Dialogue: 0,0:38:28.63,0:38:31.89,Default,,0,0,0,,Шулы! Бұл жерде де мені ұстады және көп шабуыл жасады ...
Dialogue: 0,0:38:31.97,0:38:33.72,Default,,0,0,0,,Жылама!
Dialogue: 0,0:38:33.81,0:38:36.23,Default,,0,0,0,,Оги-сан, бұл кімнің дауысы?
Dialogue: 0,0:38:36.31,0:38:37.39,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:38:37.48,0:38:40.15,Default,,0,0,0,,Ол менің қоңырауларыма жауап бермейді, сондықтан ол өлген шығар?
Dialogue: 0,0:38:39.15,0:38:41.65,Default,,0,0,0,,(Банк қозғалтқышының дыбысы)
Dialogue: 0,0:38:40.73,0:38:41.65,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:38:41.73,0:38:42.90,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:38:44.53,0:38:45.65,Default,,0,0,0,,Дегенмен сен оның сыртқы түріне де, әрекетіне де мүлде ұқсамайсың—
Dialogue: 0,0:38:45.74,0:38:49.49,Default,,0,0,0,,Неге екенін түсінбейтін адамның соңынан ермей, улы газды қолдану керек еді!
Dialogue: 0,0:38:49.57,0:38:50.45,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:38:50.53,0:38:52.03,Default,,0,0,0,,Нагатаның ақымақ
Dialogue: 0,0:38:54.37,0:38:56.66,Default,,0,0,0,,Сіз осындай жерге қашып кеттіңіз бе?
Dialogue: 0,0:38:56.75,0:38:58.12,Default,,0,0,0,,Он бір
Dialogue: 0,0:38:58.21,0:38:59.79,Default,,0,0,0,,Түсіру әдісі Дайындық
Dialogue: 0,0:39:01.13,0:39:03.29,Default,,0,0,0,,А... аға!
Dialogue: 0,0:39:04.30,0:39:05.71,Default,,0,0,0,,Барлық әскерлерге хабарландыру!
Dialogue: 0,0:39:05.80,0:39:07.38,Default,,0,0,0,,Атысты дереу тоқтату
Dialogue: 0,0:39:07.47,0:39:08.30,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:39:08.38,0:39:09.47,Default,,0,0,0,,Татуласу?
Dialogue: 0,0:39:09.55,0:39:12.93,Default,,0,0,0,,11-аймақ Губернатор және үшінші князь
Dialogue: 0,0:39:13.01,0:39:16.14,Default,,0,0,0,,Кловис Ла Британия атындағы орден
Dialogue: 0,0:39:16.22,0:39:18.27,Default,,0,0,0,,Барлық күштер дереу атысты.
Dialogue: 0,0:39:18.85,0:39:21.81,Default,,0,0,0,,Бұдан әрі ұрысқа рұқсат етілмейді.
Dialogue: 0,0:39:23.44,0:39:24.61,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:39:24.69,0:39:26.65,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:39:26.73,0:39:29.82,Default,,0,0,0,,Енді не болады? Ән айтқыңыз келе ме?
Dialogue: 0,0:39:29.90,0:39:32.24,Default,,0,0,0,,Әлде шахмат серіктесі ме?
Dialogue: 0,0:39:32.32,0:39:33.62,Default,,0,0,0,,Бұл ностальгиялық.
Dialogue: 0,0:39:33.70,0:39:34.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:37.29,0:39:39.04,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:39:39.12,0:39:41.33,Default,,0,0,0,,Екі адам шахмат ойнады
Dialogue: 0,0:39:41.42,0:39:43.42,Default,,0,0,0,,Мен әрқашан жеңдім.
Dialogue: 0,0:39:43.50,0:39:44.71,Default,,0,0,0,,Не?
Dialogue: 0,0:39:44.79,0:39:47.46,Default,,0,0,0,,Қараңызшы, Овен сарайында...
Dialogue: 0,0:39:47.55,0:39:48.84,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:39:49.55,0:39:50.63,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:39:51.22,0:39:53.05,Default,,0,0,0,,Біраз уақыт болды, ағайын.
Dialogue: 0,0:39:53.14,0:39:54.22,Default,,0,0,0,,Уг!?
Dialogue: 0,0:39:54.30,0:39:57.43,Default,,0,0,0,,Марқұм императрица Марианна - балалардың үлкені.
Dialogue: 0,0:39:57.52,0:40:01.35,Default,,0,0,0,,Мен Лелух ви Британиямын, таққа 17-ші мұрагермін.
Dialogue: 0,0:40:01.44,0:40:02.85,Default,,0,0,0,,Лелуч?
Dialogue: 0,0:40:02.94,0:40:04.15,Default,,0,0,0,,Бірақ сіз...
Dialogue: 0,0:40:04.23,0:40:06.90,Default,,0,0,0,,Өлген болуы керек...?
Dialogue: 0,0:40:09.90,0:40:13.11,Default,,0,0,0,,Мен қайтып келдім, Мәртебелі.
Dialogue: 0,0:40:13.91,0:40:16.08,Default,,0,0,0,,Барлығын өзгерту үшін...
Dialogue: 0,0:40:23.46,0:40:25.50,Default,,0,0,0,,Уф, мен өте бақыттымын, Лелуч.
Dialogue: 0,0:40:25.58,0:40:28.25,Default,,0,0,0,,Жапон оккупациясында қайтыс болғанын естідім.
Dialogue: 0,0:40:28.84,0:40:30.55,Default,,0,0,0,,Nunnally не істеп жатыр?
Dialogue: 0,0:40:30.63,0:40:32.93,Default,,0,0,0,,Император тағының мұрагеріне келгенде
Dialogue: 0,0:40:33.01,0:40:34.39,Default,,0,0,0,,Тілің жақсы екен.
Dialogue: 0,0:40:36.89,0:40:40.43,Default,,0,0,0,,Біздің анамыз рыцарь болған, бірақ
Dialogue: 0,0:40:40.52,0:40:42.27,Default,,0,0,0,,Қарапайым халықтан
Dialogue: 0,0:40:42.35,0:40:43.81,Default,,0,0,0,,Басқа ханшайымдарға арналған
Dialogue: 0,0:40:43.89,0:40:46.86,Default,,0,0,0,,Бұл өте көзді ашқан болуы керек.
Dialogue: 0,0:40:46.94,0:40:49.61,Default,,0,0,0,,Сіз бе? лаңкестердің ісі болып көріну
Dialogue: 0,0:40:49.69,0:40:50.86,Default,,0,0,0,,Сенің анаңды кім өлтірді?
Dialogue: 0,0:40:50.94,0:40:53.11,Default,,0,0,0,,Мен емес Бұл мен емес!
Dialogue: 0,0:40:53.20,0:40:55.41,Default,,0,0,0,,Олай болса маған не білетініңді айт.
Dialogue: 0,0:40:55.49,0:40:58.33,Default,,0,0,0,,Менің алдымда ешкім өтірік айтпайды
Dialogue: 0,0:40:58.41,0:41:00.74,Default,,0,0,0,,Оны кім өлтірді?
Dialogue: 0,0:41:05.50,0:41:08.09,Default,,0,0,0,,Бізге сен сияқтылар керек емес.
Dialogue: 0,0:41:09.13,0:41:13.42,Default,,0,0,0,,Екінші князь Шнайзел және екінші ханшайым Корнелия
Dialogue: 0,0:41:13.51,0:41:15.09,Default,,0,0,0,,Олар біледі
Dialogue: 0,0:41:15.18,0:41:17.39,Default,,0,0,0,,Иә!? Олар ұйымдастырушылар ма?
Dialogue: 0,0:41:21.10,0:41:23.23,Default,,0,0,0,,Сіз соншалықты көп білмейсіз бе?
Dialogue: 0,0:41:24.14,0:41:26.02,Default,,0,0,0,,Не? Ах!?
Dialogue: 0,0:41:26.10,0:41:28.27,Default,,0,0,0,,Бұл шынымен мен емес! Мен мұны істеген жоқпын!
Dialogue: 0,0:41:28.36,0:41:30.36,Default,,0,0,0,,Мен саған тіпті рұқсат етпедім!
Dialogue: 0,0:41:30.44,0:41:31.86,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:41:32.53,0:41:33.99,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:41:34.95,0:41:38.82,Default,,0,0,0,,Ия, тоқта! Ол туған ағасы болса да, ол менің нағыз ағам!
Dialogue: 0,0:41:40.83,0:41:42.41,Default,,0,0,0,,Сәлем Лелуч!
Dialogue: 0,0:41:42.50,0:41:45.33,Default,,0,0,0,,Сіз дәл қазір ұйықтап жатқансыз, солай ма? Қолдарың тоқтап қалды.
Dialogue: 0,0:41:45.41,0:41:47.50,Default,,0,0,0,,Бұл үшін мені ренжітпеңіз.
Dialogue: 0,0:41:47.58,0:41:49.92,Default,,0,0,0,,Мені тастап кеткенің үшін сенің жазаң!
Dialogue: 0,0:41:50.00,0:41:52.42,Default,,0,0,0,,Иә, сіз кеше не істеп жүрсіз?
Dialogue: 0,0:41:52.51,0:41:53.51,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:41:53.59,0:41:54.84,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:41:54.92,0:41:57.13,Default,,0,0,0,,Әңгіменің жолдан шығып кетуіне жол берме!
Dialogue: 0,0:41:57.22,0:42:00.18,Default,,0,0,0,,Дәл қазір мен клуб іс-шараларының бюджетін қарап шығуды тез аяқтауым керек.
Dialogue: 0,0:42:00.26,0:42:02.01,Default,,0,0,0,,Бюджет еш жерде жоқ, солай ма?
Dialogue: 0,0:42:02.10,0:42:03.43,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:42:03.52,0:42:05.35,Default,,0,0,0,,Ат спорты үйірмесі шынымен ашулы!
Dialogue: 0,0:42:05.43,0:42:07.69,Default,,0,0,0,,Олар тағы да осында жүгіріп келді.
Dialogue: 0,0:42:07.77,0:42:12.11,Default,,0,0,0,,Әй... Қарсылас, сен де студенттік кеңестің мүшесісің ғой.
Dialogue: 0,0:42:12.19,0:42:16.20,Default,,0,0,0,,Тым болмаса бір күнді ертерек еске алсаңыз екен.
Dialogue: 0,0:42:16.28,0:42:19.32,Default,,0,0,0,,«Тағы бір күн кешігу» дұрыс жауап. Мен бас тартқым келеді.
Dialogue: 0,0:42:19.41,0:42:20.99,Default,,0,0,0,,Бұл қазірден бастап жақсы идея.
Dialogue: 0,0:42:21.08,0:42:22.37,Default,,0,0,0,,Ішім!
Dialogue: 0,0:42:23.54,0:42:26.04,Default,,0,0,0,,Бұл да «Ішек сиқыры» ма?
Dialogue: 0,0:42:26.12,0:42:29.63,Default,,0,0,0,,Иә, сіз көп жұмыс істегіңіз келеді.
Dialogue: 0,0:42:29.71,0:42:32.17,Default,,0,0,0,,Бұл жұмыс істемейді, мұндай жалған сиқыр
Dialogue: 0,0:42:32.25,0:42:34.84,Default,,0,0,0,,Төраға, мен қабылдаймын.
Dialogue: 0,0:42:34.92,0:42:36.76,Default,,0,0,0,,Иә, физикалық адамдардың шыншыл болғаны дұрыс.
Dialogue: 0,0:42:36.84,0:42:38.88,Default,,0,0,0,,Маған жаттығу жасап жатқаныңызды айтуыңыз керек.
Dialogue: 0,0:42:38.97,0:42:40.34,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:42:40.43,0:42:41.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:41.35,0:42:42.68,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:42:42.76,0:42:43.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:43.93,0:42:46.85,Default,,0,0,0,,Мен өткен күні қыздар жатақханасының жуынатын бөлмесін тексердім.
Dialogue: 0,0:42:46.93,0:42:49.52,Default,,0,0,0,,Маған үстіңгі және астыңғы арасындағы тепе-теңдік ұнайды.
Dialogue: 0,0:42:49.60,0:42:50.69,Default,,0,0,0,,Хохо
Dialogue: 0,0:42:50.77,0:42:53.36,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Хентай!
Dialogue: 0,0:42:57.36,0:42:59.82,Default,,0,0,0,,Азаматтық шенеуніктердің істегені жылы.
Dialogue: 0,0:42:59.91,0:43:01.53,Default,,0,0,0,,Сіз Батлиді айтасыз ба?
Dialogue: 0,0:43:01.62,0:43:05.12,Default,,0,0,0,,Кінәлі бұл соманы екі рет бұзды.
Dialogue: 0,0:43:05.20,0:43:07.20,Default,,0,0,0,,Мұндай жоспарлы тексеруде...
Dialogue: 0,0:43:07.29,0:43:09.00,Default,,0,0,0,,Марграв Еремия
Dialogue: 0,0:43:09.08,0:43:12.71,Default,,0,0,0,,Мәртебелі Хловис дүниеден озды, біз таза қандылар...
Dialogue: 0,0:43:12.79,0:43:16.71,Default,,0,0,0,,Мен сізге нұсқаулар беремін. Мен ішкі бөліктерді біріктіргенше күтіңіз.
Dialogue: 0,0:43:17.30,0:43:18.88,Default,,0,0,0,,Құрметті Карен, біраз уақыт өтті!
Dialogue: 0,0:43:18.97,0:43:20.13,Default,,0,0,0,,Денеңіз жақсы ма?
Dialogue: 0,0:43:20.22,0:43:22.39,Default,,0,0,0,,Софи-чан, мен уайымдадым.
Dialogue: 0,0:43:22.47,0:43:23.80,Default,,0,0,0,,Қазір жақсысың ба?
Dialogue: 0,0:43:23.89,0:43:26.72,Default,,0,0,0,,Иә, бірақ мен өзімді қатты итермелей алмаймын.
Dialogue: 0,0:43:31.60,0:43:34.44,Default,,0,0,0,,Егер сіз көп демалсаңыз, сіз басқаларға ілесе алмайсыз.
Dialogue: 0,0:43:34.52,0:43:37.53,Default,,0,0,0,,Лелуш-кун, сен не қарап тұрсың?
Dialogue: 0,0:43:37.61,0:43:39.11,Default,,0,0,0,,Сіз кездейсоқ ғашық болдыңыз ба?
Dialogue: 0,0:43:39.70,0:43:41.28,Default,,0,0,0,,Бұл сирек кездеседі.
Dialogue: 0,0:43:41.86,0:43:44.45,Default,,0,0,0,,Ол ашылу салтанатынан бері келмеді.
Dialogue: 0,0:43:45.03,0:43:46.79,Default,,0,0,0,,Карен Штадтфельдт
Dialogue: 0,0:43:46.87,0:43:47.95,Default,,0,0,0,,Онда!
Dialogue: 0,0:43:48.04,0:43:50.37,Default,,0,0,0,,Сіздің денеңіз әйтеуір әлсіреген сияқты.
Dialogue: 0,0:43:50.46,0:43:52.83,Default,,0,0,0,,Өткен оқу жылында да, кейде
Dialogue: 0,0:43:52.92,0:43:54.88,Default,,0,0,0,,Бірақ нәтиже керемет
Dialogue: 0,0:43:55.46,0:43:57.63,Default,,0,0,0,,Өйткені ол Штадтфельдтер отбасының қызы.
Dialogue: 0,0:43:57.71,0:44:00.59,Default,,0,0,0,,Ақшасы бар, мінезі жұмсақ.
Dialogue: 0,0:44:00.67,0:44:02.72,Default,,0,0,0,,Сіздің көзіңіз биік.
Dialogue: 0,0:44:02.80,0:44:06.35,Default,,0,0,0,,Бұл сәл тым қорап.
Dialogue: 0,0:44:06.93,0:44:08.77,Default,,0,0,0,,Ия... иә!
Dialogue: 0,0:44:08.85,0:44:10.35,Default,,0,0,0,,Ара! Ара!
Dialogue: 0,0:44:10.43,0:44:12.19,Default,,0,0,0,,Карен, жүгір!
Dialogue: 0,0:44:12.27,0:44:14.31,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:44:16.65,0:44:18.57,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:44:21.74,0:44:24.37,Default,,0,0,0,,Мен мұндай жерде ара бар екеніне сене алар емеспін...
Dialogue: 0,0:44:25.12,0:44:27.53,Default,,0,0,0,,Бұл да ара ұясы ма деп ойлаймын
Dialogue: 0,0:44:27.62,0:44:28.45,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:44:30.25,0:44:32.16,Default,,0,0,0,,А, бұл көңілсіз.
Dialogue: 0,0:44:32.25,0:44:35.38,Default,,0,0,0,,Мен оны ауыртпауым керек еді.
Dialogue: 0,0:44:35.96,0:44:38.05,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:44:38.13,0:44:39.84,Default,,0,0,0,,Жоқ! Сіз оны көрдіңіз бе?
Dialogue: 0,0:44:40.96,0:44:43.30,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:44:44.26,0:44:45.72,Default,,0,0,0,,Сұрақтарға жауап беріңіз
Dialogue: 0,0:44:51.56,0:44:52.64,Default,,0,0,0,,Иә
Dialogue: 0,0:44:53.23,0:44:56.02,Default,,0,0,0,,Кеше мен Синдзюкудағы Глазгода жүрдім.
Dialogue: 0,0:44:56.11,0:44:57.19,Default,,0,0,0,,Иә
Dialogue: 0,0:44:57.27,0:44:58.86,Default,,0,0,0,,Неліктен терроризм?
Dialogue: 0,0:44:58.94,0:45:00.94,Default,,0,0,0,,Өйткені мен жапонмын
Dialogue: 0,0:45:01.03,0:45:03.57,Default,,0,0,0,,Сондай-ақ онда Британияның жарты қаны бар.
Dialogue: 0,0:45:03.65,0:45:05.36,Default,,0,0,0,,Не? Жартысы?
Dialogue: 0,0:45:05.86,0:45:07.74,Default,,0,0,0,,Бірақ неге сонша?
Dialogue: 0,0:45:14.12,0:45:16.42,Default,,0,0,0,,Маған бірдеңе бар ма?
Dialogue: 0,0:45:16.50,0:45:19.09,Default,,0,0,0,,Жоқ, мен өз ісімді аяқтадым.
Dialogue: 0,0:45:19.67,0:45:21.76,Default,,0,0,0,,Иә, әр жағдайда.
Dialogue: 0,0:45:23.26,0:45:24.93,Default,,0,0,0,,Синдзюку туралы ештеңе айтпа
Dialogue: 0,0:45:25.01,0:45:28.05,Default,,0,0,0,,А... Синдзюку нені білдіреді?
Dialogue: 0,0:45:28.14,0:45:29.05,Default,,0,0,0,,Не!?
Dialogue: 0,0:45:29.14,0:45:30.64,Default,,0,0,0,,«Тек сол атты айту үшін ғана—»
Dialogue: 0,0:45:30.72,0:45:31.85,Default,,0,0,0,,Сыныпқа оралу
Dialogue: 0,0:45:31.93,0:45:34.44,Default,,0,0,0,,Менің сұрақтарыма жауап берсеңіз
Dialogue: 0,0:45:34.52,0:45:37.73,Default,,0,0,0,,Бұл жұмыс істемейді!? Бұл нені білдіреді?
Dialogue: 0,0:45:39.61,0:45:42.78,Default,,0,0,0,,Біз не істеуіміз керек? Бүгін де кеш болуы мүмкін...
Dialogue: 0,0:45:42.86,0:45:44.07,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:45:44.15,0:45:46.70,Default,,0,0,0,,Ол менімен кешкі ас ішетінін айтты.
Dialogue: 0,0:45:47.87,0:45:49.87,Default,,0,0,0,,Қараңызшы, бұл орындалды.
Dialogue: 0,0:45:49.95,0:45:51.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:57.04,0:45:58.88,Default,,0,0,0,,А, құс?
Dialogue: 0,0:45:58.96,0:46:00.50,Default,,0,0,0,,Иә, бұл Цуру.
Dialogue: 0,0:46:00.59,0:46:03.80,Default,,0,0,0,,Таңқаларлық, жапондықтар сондай епті.
Dialogue: 0,0:46:06.30,0:46:07.55,Default,,0,0,0,,Нуналли-сама?
Dialogue: 0,0:46:07.63,0:46:08.47,Default,,0,0,0,,Ах
Dialogue: 0,0:46:10.18,0:46:11.89,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:46:11.97,0:46:14.06,Default,,0,0,0,,Қайтадан қош келдіңіз, ағайын.
Dialogue: 0,0:46:14.14,0:46:15.60,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:46:16.19,0:46:19.02,Default,,0,0,0,,Мен үйдемін Нуналли Сакиоко
Dialogue: 0,0:46:19.61,0:46:23.86,Default,,0,0,0,,Баршаңыз білетіндей, барлық жоспарлар орындалмады.
Dialogue: 0,0:46:24.44,0:46:26.78,Default,,0,0,0,,Сондықтан бұл институтты жойыңыз
Dialogue: 0,0:46:26.86,0:46:28.20,Default,,0,0,0,,Иә!? Бірақ...
Dialogue: 0,0:46:28.28,0:46:30.07,Default,,0,0,0,,Наритаға орын дайындады
Dialogue: 0,0:46:30.16,0:46:31.45,Default,,0,0,0,,Барлығын жылжытыңыз
Dialogue: 0,0:46:31.53,0:46:33.16,Default,,0,0,0,,Жадым жоқ болса да
Dialogue: 0,0:46:33.24,0:46:37.37,Default,,0,0,0,,Мен және менің қызметкерлерім князь Хловистен кеткеніміз рас.
Dialogue: 0,0:46:37.96,0:46:41.42,Default,,0,0,0,,Мен өз еліме қайтарылып, жауапқа тартыламын.
Dialogue: 0,0:46:41.50,0:46:43.80,Default,,0,0,0,,Сол кезде Ұлы мәртебелі императордан жасырын түрде.
Dialogue: 0,0:46:43.88,0:46:47.22,Default,,0,0,0,,Бұл эксперимент жүргізіліп жатқаны белгілі болған кезде...
Dialogue: 0,0:46:47.30,0:46:50.30,Default,,0,0,0,,Түсіндім, мен дайындықты мүмкіндігінше тезірек жалғастырамын.
Dialogue: 0,0:46:50.39,0:46:52.47,Default,,0,0,0,,Дәл қазір, Сакиоко-санға.
Dialogue: 0,0:46:52.55,0:46:55.10,Default,,0,0,0,,Ол маған оригамиді үйретті.
Dialogue: 0,0:46:55.18,0:46:57.35,Default,,0,0,0,,Қағаз парағын көп рет бүктеп алсаңыз
Dialogue: 0,0:46:57.43,0:47:00.27,Default,,0,0,0,,Олар құстарға, кемелерге және басқа да нәрселерге айнала алады.
Dialogue: 0,0:47:01.90,0:47:06.19,Default,,0,0,0,,Аа, бұлай тез сөйлесудің қажеті жоқ.
Dialogue: 0,0:47:06.28,0:47:07.86,Default,,0,0,0,,Өйткені мен ешқайда бармаймын
Dialogue: 0,0:47:07.95,0:47:10.03,Default,,0,0,0,,Рахмет, ағайын.
Dialogue: 0,0:47:10.11,0:47:11.41,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:47:11.49,0:47:13.66,Default,,0,0,0,,Хехе, жақсы (Лелуч) Иә?
Dialogue: 0,0:47:13.74,0:47:17.37,Default,,0,0,0,,Бауырым, мен кеше түнде бір нәрседен қорықтым.
Dialogue: 0,0:47:17.45,0:47:21.04,Default,,0,0,0,,Шынымен бе? Кешіріңіз, менде ойланатын нәрсе бар.
Dialogue: 0,0:47:21.12,0:47:21.96,Default,,0,0,0,,Эй
Dialogue: 0,0:47:22.04,0:47:23.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:23.25,0:47:27.13,Default,,0,0,0,,Осы тырналардың 1000-ын бүктесең, тілегің орындалады дейді.
Dialogue: 0,0:47:27.21,0:47:30.01,Default,,0,0,0,,Ағаңа бірдеңе жасағың келсе...
Dialogue: 0,0:47:30.09,0:47:32.01,Default,,0,0,0,,Жоқ, мен үшін...
Dialogue: 0,0:47:32.09,0:47:34.30,Default,,0,0,0,,Nunnally туралы не деуге болады? Бірдеңе жоқ па?
Dialogue: 0,0:47:34.39,0:47:36.10,Default,,0,0,0,,Хмм.
Dialogue: 0,0:47:36.18,0:47:39.02,Default,,0,0,0,,Дүние мейірімді болсын
Dialogue: 0,0:47:39.10,0:47:42.81,Default,,0,0,0,,Бұл сіз көрген уақытта болатынына сенімдімін.
Dialogue: 0,0:47:42.90,0:47:44.40,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:47:44.48,0:47:45.48,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:47:46.69,0:47:50.70,Default,,0,0,0,,Иә, біздің болашақ таңдауымыз шектеулі.
Dialogue: 0,0:47:50.78,0:47:53.12,Default,,0,0,0,,Мен мұнда жасырынып жүрмін десем де.
Dialogue: 0,0:47:53.20,0:47:56.12,Default,,0,0,0,,Эшфордтар отбасы мені қашанға дейін қолдайды?
Dialogue: 0,0:47:56.70,0:48:00.41,Default,,0,0,0,,Менің тағдырым саяси құрал немесе қастандықтың жемі болу.
Dialogue: 0,0:48:01.12,0:48:05.75,Default,,0,0,0,,Біз тіпті Нуннелли де бақытты өмір сүре алатын әлем құруымыз керек.
Dialogue: 0,0:48:06.34,0:48:07.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:07.25,0:48:11.47,Default,,0,0,0,,Өткен күні мен Жапонияның қалай уәде беретінін білдім.
Dialogue: 0,0:48:11.55,0:48:15.60,Default,,0,0,0,,Өтірік айтсаң 1000 ине ішемін.
Dialogue: 0,0:48:15.68,0:48:17.81,Default,,0,0,0,,Мен саусағымды кесіп алдым!
Dialogue: 0,0:48:17.89,0:48:19.02,Default,,0,0,0,,Фуфу
Dialogue: 0,0:48:20.18,0:48:23.48,Default,,0,0,0,,Бұл қорқынышты. Мың ине жұтуым керек пе?
Dialogue: 0,0:48:23.56,0:48:27.52,Default,,0,0,0,,Иә, сондықтан өтірік айтпау керек.
Dialogue: 0,0:48:27.61,0:48:30.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз мектепке соңғы рет барғаныңызға біраз уақыт болды ма?
Dialogue: 0,0:48:30.24,0:48:31.45,Default,,0,0,0,,Тар
Dialogue: 0,0:48:31.53,0:48:33.99,Default,,0,0,0,,Кеше тарих сабағы болды.
Dialogue: 0,0:48:34.07,0:48:35.91,Default,,0,0,0,,Эй, сен сонда қайтуың керек...
Dialogue: 0,0:48:35.99,0:48:38.29,Default,,0,0,0,,Қазір әскер жоғары дайындықта.
Dialogue: 0,0:48:38.37,0:48:40.75,Default,,0,0,0,,Сол жерде біраз уақыт суытыңыз.
Dialogue: 0,0:48:40.83,0:48:42.75,Default,,0,0,0,,Бірақ бұл дауыс туралы ...
Dialogue: 0,0:48:42.83,0:48:44.83,Default,,0,0,0,,Тек дауыспен іздеу мүмкін емес.
Dialogue: 0,0:48:44.92,0:48:46.13,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:48:46.21,0:48:49.42,Default,,0,0,0,,Карен студент болса, Наото бақыттырақ болар еді.
Dialogue: 0,0:48:51.05,0:48:53.22,Default,,0,0,0,,Бірі - ақсүйектер білімі.
Dialogue: 0,0:48:53.30,0:48:57.30,Default,,0,0,0,,Адамдарды басқаруға анықтау және қарқынды оқыту және үйрету арқылы.
Dialogue: 0,0:48:57.39,0:48:58.56,Default,,0,0,0,,Жақсы билеушілерді дамыту
Dialogue: 0,0:48:58.64,0:49:00.93,Default,,0,0,0,,Олар ұқсас па?
Dialogue: 0,0:48:59.60,0:49:00.93,Default,,0,0,0,,Екінші нәрсе - жылдамдық.
Dialogue: 0,0:49:01.02,0:49:03.10,Default,,0,0,0,,Таңдалған адам ресурстарынан таңдалған——
Dialogue: 0,0:49:01.02,0:49:04.73,Default,,0,0,0,,Жоқ, мен дауыстарды есте сақтау қабілетіне сене алмаймын.
Dialogue: 0,0:49:03.23,0:49:04.73,Default,,0,0,0,,Аз адамдардан тұратын үкімет
Dialogue: 0,0:49:04.81,0:49:06.86,Default,,0,0,0,,Жылдам шешім қабылдауға мүмкіндік береді
Dialogue: 0,0:49:06.94,0:49:09.15,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:49:09.23,0:49:11.32,Default,,0,0,0,,Ұлы Елизавета I ұлы——
Dialogue: 0,0:49:11.40,0:49:13.74,Default,,0,0,0,,IX Генрихтің қосылуымен
Dialogue: 0,0:49:13.82,0:49:15.24,Default,,0,0,0,,Тюдорлар әулетінің беделі көтерілді.
Dialogue: 0,0:49:15.32,0:49:17.07,Default,,0,0,0,,Оны меңгеру керек дегенді білдіреді.
Dialogue: 0,0:49:15.32,0:49:18.08,Default,,0,0,0,,Мен берген жалғыз ақпарат «Шинджуку» болды.
Dialogue: 0,0:49:18.16,0:49:19.08,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:49:19.16,0:49:21.70,Default,,0,0,0,,Егер сіз менің шын тұлғамды білсеңіз...
Dialogue: 0,0:49:21.79,0:49:22.83,Default,,0,0,0,,Мүмкіндігінше тезірек...
Dialogue: 0,0:49:22.91,0:49:24.50,Default,,0,0,0,,Емделмеген жағдайда
Dialogue: 0,0:49:27.50,0:49:28.63,Default,,0,0,0,,Ғылыми-зерттеу институты ше?
Dialogue: 0,0:49:28.71,0:49:30.42,Default,,0,0,0,,Кеше түнде Наритаға
Dialogue: 0,0:49:30.50,0:49:32.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:49:32.55,0:49:34.51,Default,,0,0,0,,Кешіріңіз, Мәртебелі.
Dialogue: 0,0:49:40.93,0:49:42.06,Default,,0,0,0,,Генерал Батли
Dialogue: 0,0:49:42.14,0:49:42.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:49:43.06,0:49:46.40,Default,,0,0,0,,Таза қанды фракция оларға басшылық болатынын хабарлады.
Dialogue: 0,0:49:46.48,0:49:48.48,Default,,0,0,0,,Не? Сіз мемлекеттік төңкеріс жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:49:51.61,0:49:54.32,Default,,0,0,0,,Түсіндің бе!? Біздің шешіміміз
Dialogue: 0,0:49:54.40,0:49:56.24,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:49:56.32,0:49:58.12,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:49:58.20,0:50:00.70,Default,,0,0,0,,Әлі де осындай ақсақтық сылтаулар айтып жатыр...
Dialogue: 0,0:50:01.24,0:50:03.75,Default,,0,0,0,,Басқалардан сұраңыз! Егер бұл куәлік болса
Dialogue: 0,0:50:03.83,0:50:06.33,Default,,0,0,0,,Мен үшін маңызды ма? Бұл әдепсіз.
Dialogue: 0,0:50:06.42,0:50:07.33,Default,,0,0,0,,Сіз енді жоқсыз
Dialogue: 0,0:50:07.42,0:50:09.54,Default,,0,0,0,,Маған жоғары мәртебелі мырзаның қасында болуға рұқсат жоқ!
Dialogue: 0,0:50:10.17,0:50:12.30,Default,,0,0,0,,Мектеп ішінде мұндай орын болғанына сене алар емеспін...
Dialogue: 0,0:50:12.88,0:50:15.13,Default,,0,0,0,,Бұл тек студенттік кеңеске арналған клуб үйі.
Dialogue: 0,0:50:15.22,0:50:18.22,Default,,0,0,0,,Ол допты ұстауға жеткілікті кең етіп жасалды.
Dialogue: 0,0:50:18.30,0:50:20.68,Default,,0,0,0,,Олай болса әңгіме қандай?
Dialogue: 0,0:50:20.76,0:50:22.56,Default,,0,0,0,,Міне болды! Аа!?
Dialogue: 0,0:50:22.64,0:50:24.02,Default,,0,0,0,,Міне, келдіңіз!
Dialogue: 0,0:50:24.10,0:50:25.18,Default,,0,0,0,,Міне!?
Dialogue: 0,0:50:25.27,0:50:27.69,Default,,0,0,0,,А, солай! эксперименттік деректер
Dialogue: 0,0:50:27.77,0:50:30.11,Default,,0,0,0,,О, менің арқам ауырып тұр.
Dialogue: 0,0:50:30.77,0:50:31.94,Default,,0,0,0,,Сіз мұны таптыңыз ба?
Dialogue: 0,0:50:32.02,0:50:34.53,Default,,0,0,0,,Біз мұны да орындадық, енді бастайық.
Dialogue: 0,0:50:34.61,0:50:35.61,Default,,0,0,0,,О, бұл керемет!
Dialogue: 0,0:50:35.69,0:50:37.11,Default,,0,0,0,,Жарайсың, Миллей-сан
Dialogue: 0,0:50:37.20,0:50:40.24,Default,,0,0,0,,Хахахаха Сіз мені көбірек мақтауыңыз керек.
Dialogue: 0,0:50:40.32,0:50:42.66,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:50:42.74,0:50:45.50,Default,,0,0,0,,Мені осында әкелгеніңді білмедің бе?
Dialogue: 0,0:50:45.58,0:50:47.21,Default,,0,0,0,,Карен-сан, сіз студенттік кеңеске кіре аласыз.
Dialogue: 0,0:50:47.29,0:50:48.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:48.25,0:50:50.25,Default,,0,0,0,,Атам маған тапсырма берді.
Dialogue: 0,0:50:50.33,0:50:51.17,Default,,0,0,0,,Төрағаға?
Dialogue: 0,0:50:51.25,0:50:55.55,Default,,0,0,0,,Иә, менің ойымша, үйірме жұмыстарын қалыпты түрде орындау қиынға соғады, себебі физикалық мәселелер бар.
Dialogue: 0,0:50:56.13,0:50:59.22,Default,,0,0,0,,А, мен Мираймын, студенттік кеңестің төрағасымын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:50:59.30,0:51:02.14,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:51:02.22,0:51:03.93,Default,,0,0,0,,Мен Ривал, хатшымын.
Dialogue: 0,0:51:04.01,0:51:06.22,Default,,0,0,0,,Егер бірдеңе түсінбесеңіз, менен сұраңыз.
Dialogue: 0,0:51:06.31,0:51:07.23,Default,,0,0,0,,Бұл Ширли.
Dialogue: 0,0:51:07.31,0:51:09.77,Default,,0,0,0,,Мен де жүзу үйірмесінің мүшесімін, сондықтан маған қамқорлық жасаңыз.
Dialogue: 0,0:51:09.85,0:51:12.19,Default,,0,0,0,,Эй, мен Нинамын.
Dialogue: 0,0:51:12.27,0:51:14.19,Default,,0,0,0,,А, жоқ, бұл сен...
Dialogue: 0,0:51:14.27,0:51:16.28,Default,,0,0,0,,Сол Ширли
Dialogue: 0,0:51:16.36,0:51:18.86,Default,,0,0,0,,Кешіріңіз, бұл үстелде.
Dialogue: 0,0:51:18.95,0:51:20.45,Default,,0,0,0,,Нана-чанға рахмет
Dialogue: 0,0:51:20.53,0:51:21.91,Default,,0,0,0,,Саған еріксіз
Dialogue: 0,0:51:21.99,0:51:23.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:23.16,0:51:24.74,Default,,0,0,0,,Лелуштың әпкесі
Dialogue: 0,0:51:24.83,0:51:28.41,Default,,0,0,0,,Мен кіші мектеп оқушысымын, сондықтан мен студенттер кеңесінің мүшесі емеспін...
Dialogue: 0,0:51:28.50,0:51:30.71,Default,,0,0,0,,Жарайды, мен қауымдастырылған мүшемін.
Dialogue: 0,0:51:30.79,0:51:31.75,Default,,0,0,0,,Иә
Dialogue: 0,0:51:31.83,0:51:34.67,Default,,0,0,0,,Сізге көп рахмет, Карен.
Dialogue: 0,0:51:35.50,0:51:38.01,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:51:38.88,0:51:40.51,Default,,0,0,0,,Бұл төтенше жағдай туралы ескерту.
Dialogue: 0,0:51:40.59,0:51:43.26,Default,,0,0,0,,Губернатор Кловис жасырынып қалды.
Dialogue: 0,0:51:43.35,0:51:46.01,Default,,0,0,0,,Губернатор Кловис жасырынып қалды.
Dialogue: 0,0:51:46.10,0:51:49.94,Default,,0,0,0,,Консулдың орынбасары Джеремиа Готвальд Үкімет кеңсесінде өткізген –—
Dialogue: 0,0:51:50.02,0:51:51.65,Default,,0,0,0,,Баспасөз конференциясының егжей-тегжейлерін айтып беремін.
Dialogue: 0,0:51:52.27,0:51:54.65,Default,,0,0,0,,Мәртебелі Хловис қайтыс болды.
Dialogue: 0,0:51:54.73,0:51:56.02,Default,,0,0,0,,Бейбітшілік пен әділетті қорғау——
Dialogue: 0,0:51:56.11,0:51:58.07,Default,,0,0,0,,Террористерге қарсы күресте
Dialogue: 0,0:51:58.15,0:52:00.78,Default,,0,0,0,,Біз мұңды итереміз
Dialogue: 0,0:52:00.86,0:52:03.53,Default,,0,0,0,,Өзінің еркін орындауы керек
Dialogue: 0,0:52:03.62,0:52:06.83,Default,,0,0,0,,Жаңа ақпарат келді.
Dialogue: 0,0:52:06.91,0:52:09.50,Default,,0,0,0,,Қылмыскер қамауға алынды
Dialogue: 0,0:52:09.58,0:52:10.79,Default,,0,0,0,,Хабарландыруға сәйкес
Dialogue: 0,0:52:10.87,0:52:13.29,Default,,0,0,0,,Ұсталғандар құрметті британдықтар.
Dialogue: 0,0:52:13.96,0:52:15.71,Default,,0,0,0,,Қатардағы Сузаку Куруруги
Dialogue: 0,0:52:15.79,0:52:17.46,Default,,0,0,0,,Күдікті бұрынғы он бір...
Dialogue: 0,0:52:18.30,0:52:21.38,Default,,0,0,0,,Мына мылтық... оның не екенін білесің бе?
Dialogue: 0,0:52:21.47,0:52:23.05,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:52:23.72,0:52:26.30,Default,,0,0,0,,Ол князь Кловийді өлтіру үшін қолданылған.
Dialogue: 0,0:52:26.39,0:52:28.47,Default,,0,0,0,,Жол белгілері де расталды
Dialogue: 0,0:52:28.56,0:52:31.31,Default,,0,0,0,,Мен де зерттедім.
Dialogue: 0,0:52:31.39,0:52:35.40,Default,,0,0,0,,Сіз Жапонияның соңғы премьер-министрі және оның заңды баласы екеніңізді естідім.
Dialogue: 0,0:52:35.48,0:52:36.98,Default,,0,0,0,,Жеткілікті мотивация
Dialogue: 0,0:52:37.07,0:52:39.32,Default,,0,0,0,,Бұл қандай да бір қателік. Менде ондай мылтық жоқ...
Dialogue: 0,0:52:41.44,0:52:44.41,Default,,0,0,0,,Саусақ ізі анықталды.
Dialogue: 0,0:52:44.49,0:52:47.12,Default,,0,0,0,,Сіз сондай-ақ SS мүшесін өлтірді деп күдіктенесіз.
Dialogue: 0,0:52:47.20,0:52:48.37,Default,,0,0,0,,Оны мойындаңыз.
Dialogue: 0,0:52:48.45,0:52:49.74,Default,,0,0,0,,Енді он бірдің орнына
Dialogue: 0,0:52:49.83,0:52:52.33,Default,,0,0,0,,Сіз құрметті британдық ретінде бағаланасыз.
Dialogue: 0,0:52:52.41,0:52:54.96,Default,,0,0,0,,Мен... мен мұны істеген жоқпын!
Dialogue: 0,0:52:56.33,0:52:58.50,Default,,0,0,0,,Эй, бұл Созаку-сан...
Dialogue: 0,0:52:58.59,0:53:00.05,Default,,0,0,0,,Алдыңғы жаңалықтар
Dialogue: 0,0:53:00.13,0:53:03.01,Default,,0,0,0,,А... Созаку тірі еді.
Dialogue: 0,0:53:03.09,0:53:06.64,Default,,0,0,0,,Иә, соғыстан кейін бөлініп кеттік...
Dialogue: 0,0:53:07.22,0:53:08.72,Default,,0,0,0,,Тіпті біз...
Dialogue: 0,0:53:09.51,0:53:10.52,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:53:10.60,0:53:11.56,Default,,0,0,0,,Не?
Dialogue: 0,0:53:11.64,0:53:13.64,Default,,0,0,0,,Бұл өтірік Жаңалықтар
Dialogue: 0,0:53:13.73,0:53:15.19,Default,,0,0,0,,Гах! Ха, ха…
Dialogue: 0,0:53:15.27,0:53:17.61,Default,,0,0,0,,Созакудың мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,0:53:17.69,0:53:19.27,Default,,0,0,0,,Бұл қандай да бір қателік.
Dialogue: 0,0:53:19.36,0:53:21.53,Default,,0,0,0,,Иә... бұл дұрыс.
Dialogue: 0,0:53:21.61,0:53:23.82,Default,,0,0,0,,А, солай...
Dialogue: 0,0:53:24.49,0:53:26.49,Default,,0,0,0,,Қайырлы түн Нуннали
Dialogue: 0,0:53:26.99,0:53:30.54,Default,,0,0,0,,Ммм, маңызды бөліктер жоқ~
Dialogue: 0,0:53:30.62,0:53:32.08,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей алмайсыз ба?
Dialogue: 0,0:53:32.16,0:53:33.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:53:33.54,0:53:36.92,Default,,0,0,0,,Мен басқа ұшқыштарды жылжыта алмаймын, өйткені олардың байланыстары өте қатал.
Dialogue: 0,0:53:37.00,0:53:40.17,Default,,0,0,0,,Мен одан сұрасам да, мен онымен бірдей сандарды ала алмас едім...
Dialogue: 0,0:53:40.25,0:53:43.01,Default,,0,0,0,,Сонымен Созаку-кунды босату үшін...
Dialogue: 0,0:53:43.09,0:53:45.68,Default,,0,0,0,,Ол құрметті британдық, солай ма?
Dialogue: 0,0:53:45.76,0:53:49.89,Default,,0,0,0,,Генерал Батли құлағаннан бері армияны таза қанды топтар басқарды.
Dialogue: 0,0:53:50.51,0:53:53.56,Default,,0,0,0,,Иә? Сіз Синджукудан біреуден естідіңіз бе?
Dialogue: 0,0:53:54.64,0:53:58.31,Default,,0,0,0,,Хмм, мен Лелушты басқаша деп ойламаймын.
Dialogue: 0,0:53:58.40,0:54:00.07,Default,,0,0,0,,Әпкем туралы ойлағанда
Dialogue: 0,0:54:00.15,0:54:02.73,Default,,0,0,0,,Бұл Британияға қарсы әрекеттердің уақыты емес.
Dialogue: 0,0:54:02.82,0:54:04.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:54:04.24,0:54:07.03,Default,,0,0,0,,Сонда маған хабарласқан басқа біреу ме?
Dialogue: 0,0:54:07.11,0:54:08.11,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:54:08.20,0:54:10.66,Default,,0,0,0,,Сузаку Куруругиге көмектесуге ниетіңіз бар ма?
Dialogue: 0,0:54:10.74,0:54:11.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:11.91,0:54:16.71,Default,,0,0,0,,Куруругиге көмектессек, командамыз өсетіні рас.
Dialogue: 0,0:54:18.96,0:54:22.25,Default,,0,0,0,,Жоғары Мәртебелі мемориалдық бағдарлама жақсы өтті.
Dialogue: 0,0:54:22.34,0:54:24.21,Default,,0,0,0,,Бұл сізді қатты жылататын сияқты.
Dialogue: 0,0:54:24.30,0:54:27.72,Default,,0,0,0,,Мәртебелі, жұртшылық көз жасын қалайды.
Dialogue: 0,0:54:28.34,0:54:30.18,Default,,0,0,0,,Бұл теледидар дүкеніне тән идея.
Dialogue: 0,0:54:30.26,0:54:32.68,Default,,0,0,0,,Бірақ шеберлікті мойындайық.
Dialogue: 0,0:54:32.76,0:54:35.18,Default,,0,0,0,,Кем дегенде осыншама уақыт
Dialogue: 0,0:54:35.27,0:54:38.73,Default,,0,0,0,,Жоғары мәртебелі өлгенін алдын ала білгендейсіз.
Dialogue: 0,0:54:38.81,0:54:41.61,Default,,0,0,0,,Маңызды адамдарға арналған естелік бағдарламалар деп қорқамын
Dialogue: 0,0:54:41.69,0:54:43.78,Default,,0,0,0,,Әрқашан қолжетімді
Dialogue: 0,0:54:43.86,0:54:45.28,Default,,0,0,0,,Сізде де менікі бар ма?
Dialogue: 0,0:54:45.36,0:54:46.53,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:54:46.61,0:54:48.74,Default,,0,0,0,,Бұл тізімде Мәртебелі де болуы мүмкін.
Dialogue: 0,0:54:49.32,0:54:52.08,Default,,0,0,0,,Бұл оның осы уақытқа дейін рейтингсіз болғанын білдіре ме?
Dialogue: 0,0:54:52.16,0:54:53.33,Default,,0,0,0,,Адал
Dialogue: 0,0:54:53.91,0:54:55.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:54:55.54,0:54:57.04,Default,,0,0,0,,Әскерге барғың келе ме?
Dialogue: 0,0:54:57.12,0:54:58.62,Default,,0,0,0,,Баспасөз қызметкерлері жеткіліксіз
Dialogue: 0,0:54:58.71,0:55:01.92,Default,,0,0,0,,Мықты емес екенімді білемін, бірақ жасымда...
Dialogue: 0,0:55:02.00,0:55:04.34,Default,,0,0,0,,Коммерциялық хабар таратуды ұнатасыз ба?
Dialogue: 0,0:55:04.42,0:55:06.80,Default,,0,0,0,,Жарайды, мен сенен басқа жұмыс сұрайын деп едім.
Dialogue: 0,0:55:07.38,0:55:11.22,Default,,0,0,0,,Ертең түнде Сузаку Куруруги әскери сотқа беріледі.
Dialogue: 0,0:55:11.30,0:55:13.72,Default,,0,0,0,,Жол бойындағы патриот британдықтар
Dialogue: 0,0:55:13.81,0:55:15.02,Default,,0,0,0,,Жол көрсетейік
Dialogue: 0,0:55:15.56,0:55:17.56,Default,,0,0,0,,Бұл тез сөйлеуге көмектеседі.
Dialogue: 0,0:55:17.64,0:55:19.85,Default,,0,0,0,,Жолсерік енді өз беттерін анық көре алады.
Dialogue: 0,0:55:19.94,0:55:21.15,Default,,0,0,0,,Еремия сэр
Dialogue: 0,0:55:21.23,0:55:25.23,Default,,0,0,0,,Он бір адам қатардағы Куруругиді батыр деп санайды.
Dialogue: 0,0:55:25.32,0:55:27.36,Default,,0,0,0,,Кейбір топтар оны қайта басып алуды ойлауы мүмкін.
Dialogue: 0,0:55:27.44,0:55:30.16,Default,,0,0,0,,Сазерлендте өзім жолсерік боламын.\NЕгер
Dialogue: 0,0:55:30.24,0:55:31.99,Default,,0,0,0,,пайда болса...
Dialogue: 0,0:55:32.07,0:55:34.12,Default,,0,0,0,,Ол сені сол жерде өлтіреді.
Dialogue: 0,0:55:36.49,0:55:40.71,Default,,0,0,0,,Келесі аялдама – Окубо Оокубо
Dialogue: 0,0:55:42.00,0:55:42.88,Default,,0,0,0,,Я...
Dialogue: 0,0:55:42.96,0:55:44.42,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:55:44.50,0:55:45.34,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:55:48.38,0:55:51.13,Default,,0,0,0,,Саяхат бағыты бойынша оңға қара.
Dialogue: 0,0:55:51.22,0:55:52.68,Default,,0,0,0,,Ал Шинохара—
Dialogue: 0,0:55:53.47,0:55:55.06,Default,,0,0,0,,Бұл британдықтардың қаласы.
Dialogue: 0,0:55:55.64,0:55:59.64,Default,,0,0,0,,Біздің құрбандықтарымызға салынған қарақшылар қаласы
Dialogue: 0,0:55:59.73,0:56:01.44,Default,,0,0,0,,Сол жақ ше?
Dialogue: 0,0:56:01.98,0:56:03.52,Default,,0,0,0,,Бұл біздің қала
Dialogue: 0,0:56:04.11,0:56:07.32,Default,,0,0,0,,Британия сорып алған сығымдалған қоқыс қаласы
Dialogue: 0,0:56:07.40,0:56:09.24,Default,,0,0,0,,Жақсы жауап.
Dialogue: 0,0:56:09.32,0:56:11.95,Default,,0,0,0,,Енді бірінші көлікке келіңіз.
Dialogue: 0,0:56:21.50,0:56:23.33,Default,,0,0,0,,Сіз...?
Dialogue: 0,0:56:25.42,0:56:27.59,Default,,0,0,0,,Бұл тұзақ емес...
Dialogue: 0,0:56:31.38,0:56:33.13,Default,,0,0,0,,Эй, әлгі Синдзюку заты...
Dialogue: 0,0:56:33.22,0:56:34.72,Default,,0,0,0,,Атысты тоқтатуға бұйрық берген сен бе?
Dialogue: 0,0:56:34.80,0:56:37.18,Default,,0,0,0,,Сәлем! Бірдеңе айт
Dialogue: 0,0:56:39.18,0:56:40.23,Default,,0,0,0,,Уг!?
Dialogue: 0,0:56:40.31,0:56:43.14,Default,,0,0,0,,Сіз қалай ойлайсыз? Концессиялық тур туралы ойларыңыз қандай?
Dialogue: 0,0:56:43.23,0:56:44.31,Default,,0,0,0,,Тур?
Dialogue: 0,0:56:44.40,0:56:46.86,Default,,0,0,0,,Эй, сен осындай әзілкеш пе едің?
Dialogue: 0,0:56:47.40,0:56:49.90,Default,,0,0,0,,Адамдардың дұрыс түсінгенін қаладым.
Dialogue: 0,0:56:49.98,0:56:52.07,Default,,0,0,0,,Концессиялар мен геттолар
Dialogue: 0,0:56:52.15,0:56:55.45,Default,,0,0,0,,Әрине, біз бен Британия арасында айырмашылық бар.
Dialogue: 0,0:56:55.53,0:56:56.95,Default,,0,0,0,,Бұл үмітсіз айырмашылық.
Dialogue: 0,0:56:57.03,0:56:58.49,Default,,0,0,0,,Қарсылық ретінде...
Dialogue: 0,0:56:58.58,0:57:00.08,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:57:00.66,0:57:02.50,Default,,0,0,0,,Британияны терроризм жеңе алмайды.
Dialogue: 0,0:57:02.58,0:57:03.67,Default,,0,0,0,,Жеңіліс пе?
Dialogue: 0,0:57:03.75,0:57:06.79,Default,,0,0,0,,Терроризм – бұл балаларды қудалаудан басқа ештеңе емес.
Dialogue: 0,0:57:06.88,0:57:07.92,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:57:08.00,0:57:09.50,Default,,0,0,0,,Сіз біз баламыз дейсіз бе?
Dialogue: 0,0:57:09.59,0:57:12.97,Default,,0,0,0,,Жауды жаңылтпа. Жау британдық емес.
Dialogue: 0,0:57:13.05,0:57:14.59,Default,,0,0,0,,Бұл Британия!
Dialogue: 0,0:57:14.68,0:57:17.93,Default,,0,0,0,,Егер сіз мұны жасасаңыз, бұл соғыс. Азаматтарды тартпаңыз!
Dialogue: 0,0:57:18.01,0:57:20.52,Default,,0,0,0,,Дайын болыңыз! Әділдік жаса!
Dialogue: 0,0:57:21.68,0:57:23.02,Default,,0,0,0,,Хе... Ақымақ болма.
Dialogue: 0,0:57:23.10,0:57:24.94,Default,,0,0,0,,Сіз аузыңызбен кез келген нәрсені айта аласыз!
Dialogue: 0,0:57:25.52,0:57:28.48,Default,,0,0,0,,Бет-жүзін де көрсете алмайтын адамның сөзіне сене аласыз ба?
Dialogue: 0,0:57:28.57,0:57:30.19,Default,,0,0,0,,Иә! (Сугияма) Масканы шеш!
Dialogue: 0,0:57:30.28,0:57:32.94,Default,,0,0,0,,А, сен маған бетіңді көрсете аласың ба?
Dialogue: 0,0:57:33.03,0:57:34.99,Default,,0,0,0,,Жарайды, көрсетейін.
Dialogue: 0,0:57:36.32,0:57:39.99,Default,,0,0,0,,Дегенмен, менің көрсететінім - менің жүзім емес, менің күшім.
Dialogue: 0,0:57:40.08,0:57:42.54,Default,,0,0,0,,Егер сіз мүмкін емес нәрсені мүмкін ете алсаңыз
Dialogue: 0,0:57:42.62,0:57:45.37,Default,,0,0,0,,Сіз бұған сене аласыз ба?
Dialogue: 0,0:57:46.54,0:57:50.09,Default,,0,0,0,,Уақыт таяп қалды. Уақыт таяп қалды.
Dialogue: 0,0:57:50.17,0:57:53.51,Default,,0,0,0,,Қараңдаршы, жол жиегіне толып жатқан адамдар.
Dialogue: 0,0:57:53.59,0:57:55.34,Default,,0,0,0,,Барлығы күтіп отыр.
Dialogue: 0,0:57:55.43,0:57:57.30,Default,,0,0,0,,Ханзада Хловисті өлтірді деген күдікті
Dialogue: 0,0:57:57.39,0:57:59.97,Default,,0,0,0,,Құрметті британдық Сузаку Куруруги өтіп бара жатыр.
Dialogue: 0,0:58:00.05,0:58:01.39,Default,,0,0,0,,Бұрынғы он бірінші!
Dialogue: 0,0:58:01.47,0:58:04.43,Default,,0,0,0,,Мен осы сәтті күтіп отырмын.
Dialogue: 0,0:58:04.52,0:58:06.14,Default,,0,0,0,,№5 камера баяу.
Dialogue: 0,0:58:06.23,0:58:08.86,Default,,0,0,0,,Чарльз Топты реттеуді аяқтадыңыз ба?
Dialogue: 0,0:58:08.94,0:58:11.69,Default,,0,0,0,,А? студия? Мені күте тұрыңыз
Dialogue: 0,0:58:11.77,0:58:14.82,Default,,0,0,0,,Ештеңе итерілген жоқ. Барлығы ойлағандай өтті...
Dialogue: 0,0:58:14.90,0:58:16.28,Default,,0,0,0,,Кираның қабілеті бір адамда ғана емес, бірнеше адамда болуы мүмкін.
Dialogue: 0,0:58:16.36,0:58:17.95,Default,,0,0,0,,А, мен оны көріп тұрмын.
Dialogue: 0,0:58:18.03,0:58:19.24,Default,,0,0,0,,Күдікті Куруруги
Dialogue: 0,0:58:19.32,0:58:21.58,Default,,0,0,0,,Сузаку Куруруги жақында осында болады!
Dialogue: 0,0:58:21.66,0:58:23.24,Default,,0,0,0,,Ура
Dialogue: 0,0:58:23.79,0:58:27.25,Default,,0,0,0,,Хмф, осындай сәтті жарыс...Мен де сәтсіздікке ұшырадым.
Dialogue: 0,0:58:27.33,0:58:28.96,Default,,0,0,0,,Ешкім! (Еркек) Шүкір!
Dialogue: 0,0:58:29.04,0:58:30.04,Default,,0,0,0,,Он бір!
Dialogue: 0,0:58:30.13,0:58:31.38,Default,,0,0,0,,Мәртебелі Хловисті қайтарыңыз!
Dialogue: 0,0:58:31.46,0:58:32.42,Default,,0,0,0,,Бұл адам өлтіруші!
Dialogue: 0,0:58:33.92,0:58:37.05,Default,,0,0,0,,Өкпелі дауыс! Ашуланған дауыстар естіледі
Dialogue: 0,0:58:37.13,0:58:40.22,Default,,0,0,0,,Жоғары Мәртебелін қаншалықты жақсы көретінін дәлелдейтін дауыс.
Dialogue: 0,0:58:40.30,0:58:42.68,Default,,0,0,0,,Террористерді соттайтын әділдіктің үні!
Dialogue: 0,0:58:42.76,0:58:44.22,Default,,0,0,0,,Созаку мырза...
Dialogue: 0,0:58:46.48,0:58:50.02,Default,,0,0,0,,Марграв Еремияның өзі істі шешу үшін көп еңбек етті.
Dialogue: 0,0:58:50.10,0:58:52.44,Default,,0,0,0,,Консул орынбасарының міндетін атқарушы
Dialogue: 0,0:58:54.36,0:58:56.15,Default,,0,0,0,,(түсіндірме)
Dialogue: 0,0:58:57.40,0:59:00.32,Default,,0,0,0,,Мұны үш адаммен жасауға болмайды...
Dialogue: 0,0:59:01.95,0:59:03.70,Default,,0,0,0,,(түсіндірме)
Dialogue: 0,0:59:04.24,0:59:05.12,Default,,0,0,0,,Аа...
Dialogue: 0,0:59:06.41,0:59:08.75,Default,,0,0,0,,(түсіндірме)
Dialogue: 0,0:59:08.83,0:59:11.92,Default,,0,0,0,,Енді жүре бастадым, артқа бұрылудан басқа амалым жоқ.
Dialogue: 0,0:59:12.00,0:59:13.59,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:59:13.67,0:59:15.26,Default,,0,0,0,,Консулдың міндетін атқарушы Еремия
Dialogue: 0,0:59:15.34,0:59:16.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:59:16.30,0:59:18.76,Default,,0,0,0,,Үшінші көшеден негізгі жолға қарай келе жатқан көлік бар.
Dialogue: 0,0:59:18.84,0:59:20.76,Default,,0,0,0,,Мен оны нұсқау бойынша бақылаусыз қалдырдым, бірақ...
Dialogue: 0,0:59:20.84,0:59:22.68,Default,,0,0,0,,Сіздің ойыңызша бұл нысан террористтерге тиесілі ме?
Dialogue: 0,0:59:22.76,0:59:25.60,Default,,0,0,0,,Бұл князь Хловистің корольдік арбасы болатын.
Dialogue: 0,0:59:25.68,0:59:27.18,Default,,0,0,0,,Мәртебелі?
Dialogue: 0,0:59:27.27,0:59:29.10,Default,,0,0,0,,Сіз әзілкешсіз.
Dialogue: 0,0:59:29.19,0:59:31.73,Default,,0,0,0,,Маған бәрібір, өтсін.
Dialogue: 0,0:59:31.81,0:59:33.11,Default,,0,0,0,,Барлық күштер тоқтады!
Dialogue: 0,0:59:34.27,0:59:35.86,Default,,0,0,0,,Тоқтатылды! шынымен
Dialogue: 0,0:59:34.27,0:59:36.78,Default,,0,0,0,,О! Көлік қазір тоқтады
Dialogue: 0,0:59:35.94,0:59:37.65,Default,,0,0,0,,Хе! Тек кездейсоқ
Dialogue: 0,0:59:36.86,0:59:38.74,Default,,0,0,0,,Күдікті Куруругиді алып бара жатқан конвой
Dialogue: 0,0:59:37.74,0:59:41.95,Default,,0,0,0,,Бірақ Еремияның әрекеті өзін-өзі көрсетуге деген қатты ынтасын көрсетеді...
Dialogue: 0,0:59:38.82,0:59:40.86,Default,,0,0,0,,Топ енді тоқтады.
Dialogue: 0,0:59:40.95,0:59:42.87,Default,,0,0,0,,Бұл күтпеген жағдай
Dialogue: 0,0:59:42.03,0:59:42.87,Default,,0,0,0,,Кездейсоқ!
Dialogue: 0,0:59:43.45,0:59:44.91,Default,,0,0,0,,Осы жерде тоқтау дегеніміз
Dialogue: 0,0:59:44.99,0:59:46.04,Default,,0,0,0,,Жоспарланбаған
Dialogue: 0,0:59:46.12,0:59:48.12,Default,,0,0,0,,Бұл қандай да бір апат болды ма?
Dialogue: 0,0:59:48.20,0:59:51.08,Default,,0,0,0,,Бұл 5-тармақ. Сол жаққа қарай келе жатқан көлік бар!
Dialogue: 0,0:59:51.17,0:59:52.17,Default,,0,0,0,,Хун
Dialogue: 0,0:59:52.25,0:59:55.34,Default,,0,0,0,,Эй, бұл тек жоғары мәртебелі Хловиске арналған корольдік вагон.
Dialogue: 0,0:59:55.42,0:59:56.42,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:59:55.42,0:59:57.96,Default,,0,0,0,,Ақымақ бас...
Dialogue: 0,0:59:56.50,0:59:57.96,Default,,0,0,0,,Біз сол жаққа бара жатырмыз!
Dialogue: 0,0:59:58.05,1:00:00.01,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз? Ол жігіт...
Dialogue: 0,1:00:01.97,1:00:04.51,Default,,0,0,0,,Бұл өте үлкен мәселе...
Dialogue: 0,1:00:08.47,1:00:09.64,Default,,0,0,0,,Шық!
Dialogue: 0,1:00:09.73,1:00:12.56,Default,,0,0,0,,Мәртебелі патшалық арбаны қорлайтын, жеткізбейтін адам бар!
Dialogue: 0,1:00:15.23,1:00:16.82,Default,,0,0,0,,
Dialogue: 0,1:00:18.57,1:00:21.15,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,1:00:21.24,1:00:22.07,Default,,0,0,0,,Нөл?
Dialogue: 0,1:00:22.16,1:00:24.78,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,1:00:24.87,1:00:28.37,Default,,0,0,0,,Ол өзін Нөл деп атайды және колоннаның алдында тұр!
Dialogue: 0,1:00:28.45,1:00:29.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:00:29.87,1:00:30.71,Default,,0,0,0,,кейбір
Dialogue: 0,1:00:30.79,1:00:32.62,Default,,0,0,0,,Ол не істемекші!?
Dialogue: 0,1:00:30.79,1:00:32.62,Default,,0,0,0,,Бұл туысқан тұлға ма?
Dialogue: 0,1:00:33.29,1:00:36.34,Default,,0,0,0,,Мен дәл қазір жағдайды түсінбеймін.
Dialogue: 0,1:00:36.42,1:00:38.76,Default,,0,0,0,,Өзін Нөл деп атайтын адам кім?
Dialogue: 0,1:00:39.34,1:00:40.76,Default,,0,0,0,,Әзірге нөл...
Dialogue: 0,1:00:39.34,1:00:41.67,Default,,0,0,0,,Нөл... Сіз «ештеңе» дейсіз бе?
Dialogue: 0,1:00:40.84,1:00:42.22,Default,,0,0,0,,Код атын берген адам
Dialogue: 0,1:00:42.30,1:00:43.59,Default,,0,0,0,,жоқ
Dialogue: 0,1:00:42.30,1:00:44.01,Default,,0,0,0,,Он бір…?
Dialogue: 0,1:00:44.55,1:00:46.93,Default,,0,0,0,,Созаку... Қарызыңды өтеймін.
Dialogue: 0,1:00:47.01,1:00:48.93,Default,,0,0,0,,Жетеді, солай ма? нөл
Dialogue: 0,1:00:49.02,1:00:51.27,Default,,0,0,0,,Сіздің көрсету уақытыңыз аяқталды.
Dialogue: 0,1:00:54.23,1:00:55.44,Default,,0,0,0,,Ха! Керемет...
Dialogue: 0,1:00:57.94,1:01:01.28,Default,,0,0,0,,Енді алдымен масканы шешіп алайын.
Dialogue: 0,1:01:04.61,1:01:05.78,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,1:01:07.20,1:01:08.08,Default,,0,0,0,,Не!?
Dialogue: 0,1:01:08.16,1:01:09.54,Default,,0,0,0,,Сэр Жеремия Міне, солай!
Dialogue: 0,1:01:10.24,1:01:11.70,Default,,0,0,0,,Дұрыс, Еремия.
Dialogue: 0,1:01:12.21,1:01:16.13,Default,,0,0,0,,Ішінде не бар екенін көрмегендер үшін бұл улы газ капсуласы.
Dialogue: 0,1:01:16.21,1:01:17.09,Default,,0,0,0,,Жоқ! Яғни...
Dialogue: 0,1:01:17.17,1:01:18.46,Default,,0,0,0,,Уф! Керемет...
Dialogue: 0,1:01:18.54,1:01:20.92,Default,,0,0,0,,Барлығы теледидардың алдында, сіз оны көре аласыз ба?
Dialogue: 0,1:01:21.01,1:01:24.05,Default,,0,0,0,,Бұл машинаның бір түрі сияқты көрінеді, бірақ оның мақсаты белгісіз.
Dialogue: 0,1:01:24.13,1:01:26.97,Default,,0,0,0,,Террорист деп есептелген адамның мәлімдемесін күтеміз.
Dialogue: 0,1:01:27.05,1:01:28.64,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,1:01:29.22,1:01:30.56,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,1:01:30.64,1:01:33.85,Default,,0,0,0,,Мұндағы Британияның барлық азаматтары кепілге алынды.
Dialogue: 0,1:01:33.94,1:01:37.15,Default,,0,0,0,,Бұл да кепілге алынғандарға ескертпестен...
Dialogue: 0,1:01:38.06,1:01:39.73,Default,,0,0,0,,Мен түсіріп көрейін бе?
Dialogue: 0,1:01:39.82,1:01:42.28,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,1:01:40.94,1:01:42.65,Default,,0,0,0,,6-топ Дыбысты қабылда!
Dialogue: 0,1:01:42.36,1:01:44.82,Default,,0,0,0,,Сіз не болатынын білуіңіз керек.
Dialogue: 0,1:01:42.74,1:01:44.82,Default,,0,0,0,,Камера тікелей жақындауы керек.
Dialogue: 0,1:01:44.90,1:01:46.70,Default,,0,0,0,,Бірақ бұл әйтеуір қауіпті.
Dialogue: 0,1:01:46.78,1:01:48.83,Default,,0,0,0,,Tsk! Әуесқой!
Dialogue: 0,1:01:50.83,1:01:53.12,Default,,0,0,0,,Жарайды... Қандай өтінішіңіз бар?
Dialogue: 0,1:01:53.20,1:01:55.54,Default,,0,0,0,,Осы жігіт пен Сузаку Куруругиді алмастырайық.
Dialogue: 0,1:01:55.62,1:01:56.71,Default,,0,0,0,,Күлуді тоқтатыңыз!
Dialogue: 0,1:01:56.79,1:02:00.00,Default,,0,0,0,,Бұл адам ханзада Хловисті өлтірген сатқын.
Dialogue: 0,1:02:00.09,1:02:01.92,Default,,0,0,0,,Мен оны тапсыра алмаймын!
Dialogue: 0,1:02:02.00,1:02:05.09,Default,,0,0,0,,Жоқ, сен қателесесің, Еремия.
Dialogue: 0,1:02:05.17,1:02:06.84,Default,,0,0,0,,Бұл кінәлі емес
Dialogue: 0,1:02:07.43,1:02:08.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:09.18,1:02:10.51,Default,,0,0,0,,Хловисті кім өлтірді?
Dialogue: 0,1:02:12.01,1:02:12.97,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:02:13.06,1:02:14.14,Default,,0,0,0,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,1:02:14.23,1:02:15.52,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:02:15.60,1:02:16.69,Default,,0,0,0,,Хо
Dialogue: 0,1:02:16.77,1:02:18.73,Default,,0,0,0,,Жоқ! Ол нағыз кінәлі!
Dialogue: 0,1:02:18.81,1:02:21.27,Default,,0,0,0,,Ол өзін нағыз кінәлі деп алға тартты.
Dialogue: 0,1:02:21.36,1:02:24.53,Default,,0,0,0,,Енді тұтқынға алынған қатардағы Куруруги не болады?
Dialogue: 0,1:02:25.11,1:02:26.70,Default,,0,0,0,,Өте көп, қашып құтыла алмаймын!
Dialogue: 0,1:02:27.28,1:02:28.45,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,1:02:28.53,1:02:29.74,Default,,0,0,0,,Бір он бір
Dialogue: 0,1:02:29.82,1:02:32.99,Default,,0,0,0,,Көптеген бағалы британдықтардың өмірін сақтап қалуға болады.
Dialogue: 0,1:02:33.08,1:02:35.66,Default,,0,0,0,,Менің ойымша, бұл жаман мәміле емес.
Dialogue: 0,1:02:35.75,1:02:38.71,Default,,0,0,0,,Бұл жігіт! Сіз оқиғаны шоуға айналдыруды жоспарлап отырсыз ба?
Dialogue: 0,1:02:38.79,1:02:40.67,Default,,0,0,0,,Мына жігіт жынды екен!
Dialogue: 0,1:02:40.75,1:02:44.13,Default,,0,0,0,,Жоғары мәртебелі императордың корольдік арбасын жасырып, оны мазақ ету қылмысы үшін кешірім!
Dialogue: 0,1:02:45.17,1:02:48.30,Default,,0,0,0,,Жарайды ма?Мен апельсинді жариялаймын.
Dialogue: 0,1:02:49.22,1:02:50.64,Default,,0,0,0,,Не? «Апельсин»
Dialogue: 0,1:02:50.72,1:02:51.64,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,1:02:55.56,1:02:58.31,Default,,0,0,0,,Мен өлгенде жариялануы керек.
Dialogue: 0,1:02:58.39,1:03:00.44,Default,,0,0,0,,Бұның болғанын қаламасаңыз...
Dialogue: 0,1:03:00.52,1:03:03.07,Default,,0,0,0,,Не айтып тұрсың!? Сен не туралы айтып тұрсың!
Dialogue: 0,1:03:03.15,1:03:06.69,Default,,0,0,0,,Бізді елемеу үшін қолдан келгеннің бәрін істе, ол жігіт те.
Dialogue: 0,1:03:15.70,1:03:16.83,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:03:16.91,1:03:18.50,Default,,0,0,0,,Маған ер адамды беріңіз
Dialogue: 0,1:03:19.29,1:03:21.42,Default,,0,0,0,,Еремия сэр!? Енді ше...
Dialogue: 0,1:03:21.50,1:03:23.63,Default,,0,0,0,,Маған ер адамды беріңіз
Dialogue: 0,1:03:23.71,1:03:24.80,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:03:24.88,1:03:25.80,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:03:25.88,1:03:28.42,Default,,0,0,0,,Оны маған беріңіз! Ешкімге тиіспе!
Dialogue: 0,1:03:28.51,1:03:30.51,Default,,0,0,0,,Мұндай жоспар дегенді қалай түсінесіңдер?
Dialogue: 0,1:03:30.59,1:03:33.14,Default,,0,0,0,,Лорд Кюэлл! Бұл тапсырыс!
Dialogue: 0,1:03:33.22,1:03:35.93,Default,,0,0,0,,Мен бұл жерден не болғанын айта алмаймын.
Dialogue: 0,1:03:36.02,1:03:38.56,Default,,0,0,0,,Сузаку Куруругидің шектеулері алынып тасталған сияқты.
Dialogue: 0,1:03:38.64,1:03:41.56,Default,,0,0,0,,(Халықтың наразылық үні)
Dialogue: 0,1:03:41.65,1:03:43.31,Default,,0,0,0,,Бұған рұқсат етілген бе?
Dialogue: 0,1:03:45.61,1:03:47.40,Default,,0,0,0,,Сен неменесің... уф...
Dialogue: 0,1:03:46.36,1:03:47.40,Default,,0,0,0,,(ағымдағы дыбыс)
Dialogue: 0,1:03:47.49,1:03:50.57,Default,,0,0,0,,Дауысымды шығара алмайтын сияқтымын.
Dialogue: 0,1:03:54.99,1:03:57.33,Default,,0,0,0,,Қарғыс атқыр, егер біз оларды осында қашуға рұқсат етсек, біз жібереміз!
Dialogue: 0,1:03:58.04,1:03:59.21,Default,,0,0,0,,Нөлдік уақыт.
Dialogue: 0,1:03:59.29,1:04:01.04,Default,,0,0,0,,Жарайды, кейін айтамын.
Dialogue: 0,1:04:02.12,1:04:04.25,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:04:04.34,1:04:06.55,Default,,0,0,0,,Қорқақ он бірінші! Ахх...
Dialogue: 0,1:04:06.63,1:04:08.01,Default,,0,0,0,,Мырза Еремия, неге!?
Dialogue: 0,1:04:08.09,1:04:09.92,Default,,0,0,0,,Мен айттым ғой! Маған тимеңіз!
Dialogue: 0,1:04:10.01,1:04:12.22,Default,,0,0,0,,Фухахахахахаха...
Dialogue: 0,1:04:12.30,1:04:14.26,Default,,0,0,0,,Секірді!? Күткендей, достарым
Dialogue: 0,1:04:20.69,1:04:22.77,Default,,0,0,0,,Мен жасадым. Енді... уф...
Dialogue: 0,1:04:24.06,1:04:26.61,Default,,0,0,0,,Ақымақ! Қауіпсіздік желісінің ортасында...
Dialogue: 0,1:04:26.69,1:04:28.15,Default,,0,0,0,,Лорд Кьюэлл!
Dialogue: 0,1:04:28.23,1:04:30.40,Default,,0,0,0,,Менің бұйрықтарымды орындай алмайсыз ба?
Dialogue: 0,1:04:30.49,1:04:32.95,Default,,0,0,0,,Одан әрі әрекеттер жазаға тартылады.
Dialogue: 0,1:04:33.03,1:04:35.45,Default,,0,0,0,,Жақсы! Барлық қондырғылардың мұқият екеніне көз жеткізіңіз!
Dialogue: 0,1:04:35.53,1:04:37.87,Default,,0,0,0,,Оларды сағыну үшін бар күшіңізді салыңыз!
Dialogue: 0,1:04:43.12,1:04:45.50,Default,,0,0,0,,Мен оның маған көмектесетінін ешқашан ойламадым.
Dialogue: 0,1:04:45.59,1:04:47.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:04:47.30,1:04:48.42,Default,,0,0,0,,Күлкілі
Dialogue: 0,1:04:48.50,1:04:50.92,Default,,0,0,0,,Мұндай блеф неше рет жұмыс істейді?
Dialogue: 0,1:04:51.01,1:04:53.47,Default,,0,0,0,,Бірақ мен мойындауым керек (Тамаки) Иә?
Dialogue: 0,1:04:53.55,1:04:56.01,Default,,0,0,0,,Мұны одан басқа кім жасай алады?
Dialogue: 0,1:04:56.93,1:04:59.27,Default,,0,0,0,,Тіпті Жапонияны азат ету майданы да емес
Dialogue: 0,1:04:59.35,1:05:01.85,Default,,0,0,0,,Кем дегенде мен алмаймын.
Dialogue: 0,1:05:02.64,1:05:06.02,Default,,0,0,0,,Барлығы мүмкін емес деп ойлаған Британиямен соғыс...
Dialogue: 0,1:05:06.69,1:05:08.61,Default,,0,0,0,,Ол мұны істеуі мүмкін.
Dialogue: 0,1:05:08.69,1:05:09.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:11.03,1:05:14.07,Default,,0,0,0,,Сізге өте дөрекі қараған сияқты.
Dialogue: 0,1:05:14.16,1:05:16.24,Default,,0,0,0,,Сіз олардың не істеп жатқанын білесіз.
Dialogue: 0,1:05:17.07,1:05:18.99,Default,,0,0,0,,Британия шірік
Dialogue: 0,1:05:19.08,1:05:22.83,Default,,0,0,0,,Егер сіз әлемді өзгерткіңіз келсе, маған қосылыңыз.
Dialogue: 0,1:05:22.91,1:05:27.00,Default,,0,0,0,,Сіз... шынымен де Мәртебелі Хловисті өлтірдіңіз бе?
Dialogue: 0,1:05:27.08,1:05:28.54,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,1:05:28.63,1:05:31.30,Default,,0,0,0,,Сізге жау генералын өлтіру үшін себеп керек пе?
Dialogue: 0,1:05:32.01,1:05:34.76,Default,,0,0,0,,Улы газ ше? бейбіт тұрғындарды кепілге алады
Dialogue: 0,1:05:34.84,1:05:37.05,Default,,0,0,0,,Әрбір келіссөзде блюфинг сөзсіз.
Dialogue: 0,1:05:37.14,1:05:39.01,Default,,0,0,0,,Ақырында ешкім өлмеді
Dialogue: 0,1:05:39.10,1:05:40.51,Default,,0,0,0,,Нәтижелер!
Dialogue: 0,1:05:41.43,1:05:43.68,Default,,0,0,0,,Түсіндім, мен де солай ойладым...
Dialogue: 0,1:05:43.77,1:05:45.10,Default,,0,0,0,,Фу…
Dialogue: 0,1:05:45.19,1:05:47.19,Default,,0,0,0,,Маған кел
Dialogue: 0,1:05:47.27,1:05:50.11,Default,,0,0,0,,Британия сіздің қызметіңізге лайық емес ел.
Dialogue: 0,1:05:50.19,1:05:51.73,Default,,0,0,0,,Мүмкін солай шығар, бірақ...
Dialogue: 0,1:05:51.82,1:05:52.65,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:53.24,1:05:56.32,Default,,0,0,0,,Сондықтан мен бұл елдің қадіріне жетемін.
Dialogue: 0,1:05:56.41,1:05:57.82,Default,,0,0,0,,Британиядан
Dialogue: 0,1:05:57.91,1:05:58.74,Default,,0,0,0,,Өзгерту?
Dialogue: 0,1:05:59.45,1:06:01.79,Default,,0,0,0,,Оны дұрыс емес жолмен алудың салдары
Dialogue: 0,1:06:01.87,1:06:03.58,Default,,0,0,0,,Өйткені, менің ойымша, бұл оған тұрарлық емес
Dialogue: 0,1:06:03.66,1:06:05.41,Default,,0,0,0,,Күте тұрыңыз!Қайда бара жатырсың?
Dialogue: 0,1:06:05.50,1:06:07.54,Default,,0,0,0,,Әскери трибунал бір сағаттан кейін басталады.
Dialogue: 0,1:06:07.63,1:06:09.92,Default,,0,0,0,,Сіз ақымақсыз ба?
Dialogue: 0,1:06:10.00,1:06:12.96,Default,,0,0,0,,Бұл сот сізді қылмыскер ету үшін құрылған!
Dialogue: 0,1:06:13.05,1:06:15.13,Default,,0,0,0,,Прокурорлар, судьялар және қорғаушылар
Dialogue: 0,1:06:15.22,1:06:17.18,Default,,0,0,0,,Дегенмен, бұл ережелер.
Dialogue: 0,1:06:17.26,1:06:18.72,Default,,0,0,0,,Бірақ сен өлесің!
Dialogue: 0,1:06:18.80,1:06:19.64,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,1:06:19.72,1:06:21.26,Default,,0,0,0,,Сен ақымақсың!
Dialogue: 0,1:06:21.89,1:06:24.43,Default,,0,0,0,,Баяғыда достарым осылай айтатын.
Dialogue: 0,1:06:24.52,1:06:25.73,Default,,0,0,0,,«Сен ақымақ»
Dialogue: 0,1:06:25.81,1:06:26.77,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:26.85,1:06:29.02,Default,,0,0,0,,Бұл менің кінәм деп ойлаймын.
Dialogue: 0,1:06:29.11,1:06:33.23,Default,,0,0,0,,Мен сені ұстап алғым келеді, бірақ бұл жерде кек алу болуы мүмкін.
Dialogue: 0,1:06:33.32,1:06:36.90,Default,,0,0,0,,Мен бәрібір өлтіретін болсам, мен бәрі үшін өлгім келеді.
Dialogue: 0,1:06:37.41,1:06:39.20,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,1:06:39.28,1:06:41.03,Default,,0,0,0,,Маған көмектескеніңіз үшін
Dialogue: 0,1:06:43.95,1:06:45.71,Default,,0,0,0,,Иә, Күдікті Куруругиден.
Dialogue: 0,1:06:45.79,1:06:47.08,Default,,0,0,0,,Бізбен хабарласқан сияқты.
Dialogue: 0,1:06:47.16,1:06:49.50,Default,,0,0,0,,Менің ойымша, оны Zero шығарды деп ойлауға болады.
Dialogue: 0,1:06:49.58,1:06:51.96,Default,,0,0,0,,Бірақ бастапқы кісі өлтіру туралы айып
Dialogue: 0,1:06:52.04,1:06:54.30,Default,,0,0,0,,Негіз бұлыңғыр болды.
Dialogue: 0,1:06:54.38,1:06:57.51,Default,,0,0,0,,Қатардағы Куруруги Ақталу мүмкіндігі бар...
Dialogue: 0,1:06:57.59,1:06:58.76,Default,,0,0,0,,Жақсы
Dialogue: 0,1:06:58.84,1:07:00.59,Default,,0,0,0,,Заңды түсіндіру дегеніміз не?
Dialogue: 0,1:07:00.68,1:07:02.39,Default,,0,0,0,,Сакиоко-сан?
Dialogue: 0,1:07:05.68,1:07:06.98,Default,,0,0,0,,Аа...
Dialogue: 0,1:07:08.02,1:07:09.52,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:07:09.60,1:07:11.11,Default,,0,0,0,,Лелучқа қош келдіңіз
Dialogue: 0,1:07:11.69,1:07:13.23,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:07:13.32,1:07:15.32,Default,,0,0,0,,Қайтадан қош келдіңіз, ағайын.
Dialogue: 0,1:07:15.40,1:07:18.82,Default,,0,0,0,,Егер сіз солай көрінсеңіз, тамақты сыртта ішіп қойған шығарсыз?
Dialogue: 0,1:07:18.90,1:07:20.36,Default,,0,0,0,,Мен уайымдадым
Dialogue: 0,1:07:20.45,1:07:23.91,Default,,0,0,0,,Менің ойымша, ол Нөл деген адамның әбігеріне түсіп қалды.
Dialogue: 0,1:07:23.99,1:07:26.91,Default,,0,0,0,,Қоңырау шалдым, бірақ жете алмадым...
Dialogue: 0,1:07:28.58,1:07:32.04,Default,,0,0,0,,Аға? С.С. келе алды,
Dialogue: 0,1:07:32.13,1:07:34.09,Default,,0,0,0,,Ха! C.C.?
Dialogue: 0,1:07:34.17,1:07:38.63,Default,,0,0,0,,Хехехе, сен ерекше доссың. Бұл сіздің бас әріптеріңіз ғана.
Dialogue: 0,1:07:38.72,1:07:39.88,Default,,0,0,0,,О
Dialogue: 0,1:07:39.97,1:07:42.55,Default,,0,0,0,,Мүмкін ағаңның сүйіктісі шығар?
Dialogue: 0,1:07:42.64,1:07:43.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:43.64,1:07:45.89,Default,,0,0,0,,Бұл болашағы зор қарым-қатынас.
Dialogue: 0,1:07:45.97,1:07:46.81,Default,,0,0,0,,На
Dialogue: 0,1:07:46.89,1:07:49.98,Default,,0,0,0,,Болашақта... неке?
Dialogue: 0,1:07:50.06,1:07:51.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:07:51.40,1:07:53.65,Default,,0,0,0,,Менің айтайын дегенім бұл емес...
Dialogue: 0,1:07:53.73,1:07:56.03,Default,,0,0,0,,Сонымен... ол әзілдеді...
Dialogue: 0,1:07:56.11,1:07:57.07,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,1:07:58.69,1:07:59.99,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:08:01.07,1:08:03.20,Default,,0,0,0,,Сіз C.C.
Dialogue: 0,1:08:03.28,1:08:05.03,Default,,0,0,0,,Жоқ, сіз...
Dialogue: 0,1:08:05.12,1:08:06.41,Default,,0,0,0,,Өлу керек пе еді?
Dialogue: 0,1:08:08.33,1:08:11.67,Default,,0,0,0,,Сізге ұнады ма? Мен берген күш
Dialogue: 0,1:08:12.29,1:08:14.38,Default,,0,0,0,,Күткендей... сіз?
Dialogue: 0,1:08:14.96,1:08:16.21,Default,,0,0,0,,Сіз көңіліңізден шықпайсыз ба?
Dialogue: 0,1:08:16.30,1:08:18.17,Default,,0,0,0,,Жоқ, мен ризамын.
Dialogue: 0,1:08:18.26,1:08:21.84,Default,,0,0,0,,Сіз менің кестемді айтарлықтай алға жылжыттыңыз.
Dialogue: 0,1:08:21.93,1:08:23.14,Default,,0,0,0,,Кесте?
Dialogue: 0,1:08:23.84,1:08:26.51,Default,,0,0,0,,Британияны жою кестесі
Dialogue: 0,1:08:26.60,1:08:29.52,Default,,0,0,0,,Қозғалуға біраз уақыт кетеді деп ойладым.
Dialogue: 0,1:08:30.10,1:08:33.06,Default,,0,0,0,,Сіз оны бұза аласыз деп ойлайсыз ба? тек сол күш
Dialogue: 0,1:08:33.94,1:08:36.11,Default,,0,0,0,,Мен мұны онсыз да жасамақ болдым.
Dialogue: 0,1:08:37.57,1:08:40.40,Default,,0,0,0,,Күткендей ол қызық жігіт сияқты.
Dialogue: 0,1:08:40.99,1:08:43.20,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,1:08:43.28,1:08:44.53,Default,,0,0,0,,Сізді әскерилер қуып жүр ме?
Dialogue: 0,1:08:44.62,1:08:47.03,Default,,0,0,0,,Мені санаулы адамдар ғана біледі
Dialogue: 0,1:08:47.12,1:08:49.54,Default,,0,0,0,,Қалыпты жағдайда жасырыну жеткілікті.
Dialogue: 0,1:08:49.62,1:08:51.58,Default,,0,0,0,,Мен осында ілулі тұрамын.
Dialogue: 0,1:08:51.66,1:08:53.54,Default,,0,0,0,,Сәлем! Сіз түнде қалуды жоспарлайсыз ба?
Dialogue: 0,1:08:53.62,1:08:55.38,Default,,0,0,0,,Ер адамдар еденде ұйықтауы керек
Dialogue: 0,1:08:55.46,1:08:56.79,Default,,0,0,0,,Бұл емес.
Dialogue: 0,1:08:56.88,1:09:00.09,Default,,0,0,0,,Мен ұсталсам, сен де қиындыққа тап боласың, солай ма?
Dialogue: 0,1:09:00.17,1:09:01.92,Default,,0,0,0,,Бірге болу қауіптірек
Dialogue: 0,1:09:02.01,1:09:03.93,Default,,0,0,0,,Егер сіз лагерь жасасаңыз, сізге тура жол көрсетіледі.
Dialogue: 0,1:09:04.01,1:09:06.47,Default,,0,0,0,,Сізге ыңғайлы болу үшін емес, бізге ыңғайлы болу үшін...
Dialogue: 0,1:09:06.55,1:09:08.22,Default,,0,0,0,,Мен табанды болуды ұнатпаймын.
Dialogue: 0,1:09:08.31,1:09:09.81,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:10.68,1:09:12.77,Default,,0,0,0,,Ол шиеленісті сезбейтін жігіт.
Dialogue: 0,1:09:12.85,1:09:15.86,Default,,0,0,0,,Ең бірінші қалай аман қалдыңыз? Омыртқа деген не?
Dialogue: 0,1:09:15.94,1:09:18.19,Default,,0,0,0,,Сол кезде сіз айтқан келісімшарт...
Dialogue: 0,1:09:18.27,1:09:20.07,Default,,0,0,0,,Қайырлы түн Лелуч
Dialogue: 0,1:09:20.15,1:09:21.49,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:22.82,1:09:23.86,Default,,0,0,0,,R коды?
Dialogue: 0,1:09:23.95,1:09:24.78,Default,,0,0,0,,Иә
Dialogue: 0,1:09:24.86,1:09:29.49,Default,,0,0,0,,Мәртебелі Хловис пен генерал Батли оны Мәртебелі императорға ұсынбақ болды...
Dialogue: 0,1:09:29.58,1:09:30.62,Default,,0,0,0,,О
Dialogue: 0,1:09:30.70,1:09:34.08,Default,,0,0,0,,Олар улы газды жамылып тасымалдамақ болғаны осы ма?
Dialogue: 0,1:09:34.17,1:09:36.88,Default,,0,0,0,,Қызық, неге бірден ұсынбадың?
Dialogue: 0,1:09:36.96,1:09:41.01,Default,,0,0,0,,Ол ерекше күшке ие екенін айтып, білгісі келді.
Dialogue: 0,1:09:42.84,1:09:44.34,Default,,0,0,0,,Шнайзел мырза?
Dialogue: 0,1:09:44.43,1:09:45.84,Default,,0,0,0,,R коды дегеніміз не?
Dialogue: 0,1:09:45.93,1:09:48.18,Default,,0,0,0,,Ол Синджуку оқиғасында қайтыс болды.
Dialogue: 0,1:09:48.26,1:09:49.68,Default,,0,0,0,,Сонда Батли жалғыз таңдау.
Dialogue: 0,1:09:49.76,1:09:51.72,Default,,0,0,0,,Сіз білмеймін дейсіз бе?
Dialogue: 0,1:09:52.35,1:09:55.27,Default,,0,0,0,,Әй, апельсин деген не еді?
Dialogue: 0,1:09:56.35,1:09:58.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:58.19,1:09:59.52,Default,,0,0,0,,Не?
Dialogue: 0,1:09:59.61,1:10:02.19,Default,,0,0,0,,Мен ешкімнің сұрағына жауап бермесем де
Dialogue: 0,1:10:02.28,1:10:04.24,Default,,0,0,0,,Сіз маған сұрақтар қоясыз.
Dialogue: 0,1:10:04.32,1:10:06.86,Default,,0,0,0,,Жауап бергің келмесе, жауап берме.
Dialogue: 0,1:10:06.95,1:10:08.37,Default,,0,0,0,,Мен сияқты бол
Dialogue: 0,1:10:08.45,1:10:09.58,Default,,0,0,0,,Брандо мырза
Dialogue: 0,1:10:10.03,1:10:12.20,Default,,0,0,0,,Оны маған қалдыр, апельсин.
Dialogue: 0,1:10:12.29,1:10:15.87,Default,,0,0,0,,Бұл жай ғана... өздерін жолдас деп атағысы келетін адамдар.
Dialogue: 0,1:10:15.96,1:10:19.42,Default,,0,0,0,,Күмәннің тікенегі бізді оңай ажыратады.
Dialogue: 0,1:10:19.50,1:10:20.34,Default,,0,0,0,,Хун
Dialogue: 0,1:10:23.71,1:10:26.47,Default,,0,0,0,,Бүкіл әлем сені іздейді
Dialogue: 0,1:10:26.55,1:10:29.18,Default,,0,0,0,,Әлем сен үшін қозғалады
Dialogue: 0,1:10:29.26,1:10:32.64,Default,,0,0,0,,Лелуш Мұны көргіңіз келді ме?
Dialogue: 0,1:10:32.72,1:10:35.89,Default,,0,0,0,,Жоқ, бұл әбігер тек мақсатқа жетудің құралы.
Dialogue: 0,1:10:35.98,1:10:39.94,Default,,0,0,0,,Әлем одан да үлкен хаосқа ұшырайды.
Dialogue: 0,1:10:40.65,1:10:42.52,Default,,0,0,0,,Қатардағы Сузаку Куруруги
Dialogue: 0,1:10:42.61,1:10:48.32,Default,,0,0,0,,11-ші әскери аймақ Князь Кловисті өлтірді деген күдікке қатысты № 107 маңызды.
Dialogue: 0,1:10:48.41,1:10:51.16,Default,,0,0,0,,Айғақтардың жеткіліксіз болуына байланысты босату
Dialogue: 0,1:10:51.24,1:10:52.49,Default,,0,0,0,,(балға дыбысы)
Dialogue: 0,1:10:52.58,1:10:54.66,Default,,0,0,0,,Неге... кенеттен...
Dialogue: 0,1:10:54.75,1:10:57.33,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,1:10:57.41,1:10:58.62,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,1:10:58.71,1:11:00.46,Default,,0,0,0,,Иә!? Ах, аа!
Dialogue: 0,1:11:02.75,1:11:04.26,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:11:04.34,1:11:05.88,Default,,0,0,0,,Ах, кешіріңіз!
Dialogue: 0,1:11:05.97,1:11:08.05,Default,,0,0,0,,Мен астында ешкім жоқ деп ойладым...
Dialogue: 0,1:11:08.13,1:11:09.76,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:11:09.84,1:11:13.51,Default,,0,0,0,,Мен де жоғарыдан әйел түседі деп күтпедім.
Dialogue: 0,1:11:13.60,1:11:14.43,Default,,0,0,0,,Әй?
Dialogue: 0,1:11:14.52,1:11:16.68,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,1:11:17.94,1:11:20.10,Default,,0,0,0,,Иә! Бірдеңе дұрыс емес!
Dialogue: 0,1:11:21.98,1:11:23.48,Default,,0,0,0,,Мен кешігіп қалдым.
Dialogue: 0,1:11:23.57,1:11:25.82,Default,,0,0,0,,Сіз мені күтіп отырсыз деп үміттенемін.
Dialogue: 0,1:11:26.40,1:11:28.70,Default,,0,0,0,,Бірақ бұл шынымен босату ма?
Dialogue: 0,1:11:28.78,1:11:30.53,Default,,0,0,0,,Дәлелдер жеткіліксіз.
Dialogue: 0,1:11:30.61,1:11:33.08,Default,,0,0,0,,Нөл туралы көп нәрсе бар... Иә?
Dialogue: 0,1:11:33.78,1:11:34.99,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:11:35.08,1:11:36.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:37.75,1:11:39.04,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:11:39.12,1:11:40.12,Default,,0,0,0,,Оған
Dialogue: 0,1:11:40.21,1:11:43.34,Default,,0,0,0,,Мен мұнда күн сайын қабырғаны белгілеу үшін геас құйып тұрамын.
Dialogue: 0,1:11:43.42,1:11:44.55,Default,,0,0,0,,Геасс?
Dialogue: 0,1:11:44.63,1:11:46.09,Default,,0,0,0,,Бұл күш туралы.
Dialogue: 0,1:11:46.17,1:11:48.34,Default,,0,0,0,,Келісім-шарт жасаған кезде мұны естідіңіз бе?
Dialogue: 0,1:11:48.42,1:11:49.38,Default,,0,0,0,,Иә
Dialogue: 0,1:11:49.47,1:11:51.55,Default,,0,0,0,,Ұзақтық сынағы?
Dialogue: 0,1:11:52.05,1:11:54.39,Default,,0,0,0,,Біз қарудың ерекшеліктерін түсінуіміз керек емес пе?
Dialogue: 0,1:11:54.47,1:11:56.06,Default,,0,0,0,,Егер сіз де өзімшіл болсаңыз...
Dialogue: 0,1:11:56.14,1:11:58.10,Default,,0,0,0,,Бұл жұмыс істей ме? маған
Dialogue: 0,1:11:58.18,1:11:59.18,Default,,0,0,0,,Хмм...
Dialogue: 0,1:11:59.27,1:12:00.85,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,1:12:00.94,1:12:03.27,Default,,0,0,0,,Сіз және мен сыбайласпыз.
Dialogue: 0,1:12:03.36,1:12:06.36,Default,,0,0,0,,Бізге зиян тигізетін ештеңе жасамаңыз
Dialogue: 0,1:12:09.61,1:12:12.78,Default,,0,0,0,,Туған еліме осылай оралу...
Dialogue: 0,1:12:12.87,1:12:15.99,Default,,0,0,0,,Мен ол әйелге араласпауым керек еді.
Dialogue: 0,1:12:16.95,1:12:20.91,Default,,0,0,0,,Геассты қолдану үшін қарсыластың көзіне тура қарау керек.
Dialogue: 0,1:12:21.50,1:12:23.92,Default,,0,0,0,,Тиімді қашықтық шамамен 270 метр
Dialogue: 0,1:12:24.00,1:12:26.30,Default,,0,0,0,,Бір адамға бір рет қана пайдалануға болады
Dialogue: 0,1:12:26.38,1:12:29.92,Default,,0,0,0,,Сондай-ақ, Geass қолданбас бұрын және кейін және белсендіру кезінде.
Dialogue: 0,1:12:30.01,1:12:32.22,Default,,0,0,0,,Жадтың бұзылуы байқалады.
Dialogue: 0,1:12:32.30,1:12:35.64,Default,,0,0,0,,Бұл Гиастың миға араласуынан болды.
Dialogue: 0,1:12:35.72,1:12:37.85,Default,,0,0,0,,Ықтимал зақым
Dialogue: 0,1:12:37.93,1:12:40.68,Default,,0,0,0,,Егер бұл оптикалық ақпарат болса, шағылысу да мүмкін.
Dialogue: 0,1:12:40.77,1:12:44.10,Default,,0,0,0,,Мен осындай қысқа уақыт ішінде көп зерттеу жасадым.
Dialogue: 0,1:12:44.73,1:12:48.11,Default,,0,0,0,,Қарсылас – әлемнің үштен бірінен астамын алып жатқан империя.
Dialogue: 0,1:12:48.19,1:12:49.99,Default,,0,0,0,,Сіз ешқашан тым сақ бола алмайсыз
Dialogue: 0,1:12:50.07,1:12:54.03,Default,,0,0,0,,Он бірді былай қойғанда, сен британдықсың, солай ма?
Dialogue: 0,1:12:54.11,1:12:58.54,Default,,0,0,0,,Қарсылас тым үлкен және күшті, жай Геасспен күресу үшін.
Dialogue: 0,1:12:58.62,1:13:00.45,Default,,0,0,0,,Мықты болған жақсы ма?
Dialogue: 0,1:13:01.16,1:13:03.87,Default,,0,0,0,,Иә! Юффи оның Корольдік Мәртебелі ме?
Dialogue: 0,1:13:03.96,1:13:06.50,Default,,0,0,0,,Бұл... иә, өйткені SP?
Dialogue: 0,1:13:07.09,1:13:09.92,Default,,0,0,0,,Бұл жағдайда СП Сузаку-кун емес пе?
Dialogue: 0,1:13:10.01,1:13:12.17,Default,,0,0,0,,Эй, сен оны кездесу дейсің бе? Бұл
Dialogue: 0,1:13:12.26,1:13:15.01,Default,,0,0,0,,Міне! Себебі мен сенімен қалуымды өтінді
Dialogue: 0,1:13:15.09,1:13:17.76,Default,,0,0,0,,Созаку, қарашы, Неко-чан
Dialogue: 0,1:13:17.85,1:13:19.56,Default,,0,0,0,,Иә! Мен үйдемін!
Dialogue: 0,1:13:19.64,1:13:21.64,Default,,0,0,0,,Мен шынымен де білмедім.
Dialogue: 0,1:13:21.73,1:13:24.44,Default,,0,0,0,,Күні кешеге дейін студент едім.
Dialogue: 0,1:13:24.52,1:13:25.94,Default,,0,0,0,,Осы аймақтың жаңа губернаторы
Dialogue: 0,1:13:26.02,1:13:28.40,Default,,0,0,0,,Егер Мәртебелі Корнелия ханшайымы туралы шешім қабылданбаса.
Dialogue: 0,1:13:28.48,1:13:31.11,Default,,0,0,0,,Ол бүкіл уақыт бойы өз елінде болған болуы керек.
Dialogue: 0,1:13:31.82,1:13:33.07,Default,,0,0,0,,Юффи
Dialogue: 0,1:13:33.15,1:13:36.57,Default,,0,0,0,,Кемсіту олардың биологиялық апалы-сіңлі болған кезде ғана қажет.
Dialogue: 0,1:13:36.66,1:13:38.99,Default,,0,0,0,,Бұдан былай мен сізді лейтенант губернатор Евфемия деп атаймын.
Dialogue: 0,1:13:39.08,1:13:39.91,Default,,0,0,0,,Жақсы
Dialogue: 0,1:13:39.99,1:13:41.83,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,1:13:41.91,1:13:43.46,Default,,0,0,0,,Ей, бірдеңенің артына жасырын! Абдур сол қозғалысты қолданады.
Dialogue: 0,1:13:43.54,1:13:45.75,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:13:45.83,1:13:47.63,Default,,0,0,0,,Мемлекеттік кеңседе
Dialogue: 0,1:13:47.71,1:13:51.67,Default,,0,0,0,,Мәртебелі ханшайымды қарсы алуға дайындық жүргізілді...
Dialogue: 0,1:13:52.42,1:13:55.51,Default,,0,0,0,,жоқ, таң қалды
Dialogue: 0,1:13:55.59,1:13:57.59,Default,,0,0,0,,Бұзылған
Dialogue: 0,1:13:57.68,1:14:01.27,Default,,0,0,0,,Нөлге не болды! Империяның қол астындағы жауларын басып алыңыз!
Dialogue: 0,1:14:01.35,1:14:02.56,Default,,0,0,0,,Нөл!
Dialogue: 0,1:14:11.48,1:14:14.36,Default,,0,0,0,,Мәртебелі, денеңізді еліңізге қайтарады...
Dialogue: 0,1:14:14.99,1:14:17.82,Default,,0,0,0,,Мен жаңа ғана Хловиспен сөйлестім.
Dialogue: 0,1:14:17.91,1:14:19.12,Default,,0,0,0,,Га
Dialogue: 0,1:14:19.20,1:14:22.58,Default,,0,0,0,,Мен тезірек жоспар құруым керек.
Dialogue: 0,1:14:22.66,1:14:24.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:24.29,1:14:26.29,Default,,0,0,0,,Бүгінгі күні
Dialogue: 0,1:14:26.37,1:14:29.38,Default,,0,0,0,,Мен осы Эшфорд академиясына түсуге шешім қабылдадым.
Dialogue: 0,1:14:29.46,1:14:30.88,Default,,0,0,0,,Бұл Сузаку Куруруги.
Dialogue: 0,1:14:30.96,1:14:32.63,Default,,0,0,0,,
Dialogue: 0,1:14:32.71,1:14:33.92,Default,,0,0,0,,Неліктен он бір?
Dialogue: 0,1:14:34.01,1:14:36.47,Default,,0,0,0,,Ол күдікті болды, солай емес пе? Мәртебелі Хловис.
Dialogue: 0,1:14:36.55,1:14:38.09,Default,,0,0,0,,Мұғалім қателікпен ұсталғанын айтты.
Dialogue: 0,1:14:38.18,1:14:40.80,Default,,0,0,0,,Бірақ ол күдікті нәрсе болғандықтан қамауға алынды, солай ма?
Dialogue: 0,1:14:40.89,1:14:43.35,Default,,0,0,0,,Мен сіздің террорист емес екеніңізге сенімдімін.
Dialogue: 0,1:14:43.43,1:14:44.48,Default,,0,0,0,,Польнарефф, мен сені жеңе алмаймын.
Dialogue: 0,1:14:44.56,1:14:45.73,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,1:14:45.81,1:14:48.56,Default,,0,0,0,,Мектепте болса да, бұл жай ғана тексеру.
Dialogue: 0,1:14:48.65,1:14:49.90,Default,,0,0,0,,Он бір...
Dialogue: 0,1:14:49.98,1:14:51.82,Default,,0,0,0,,Құрметті британдық
Dialogue: 0,1:14:51.90,1:14:53.73,Default,,0,0,0,,Өйткені бұл бірдей нәрсе...
Dialogue: 0,1:14:53.82,1:14:55.90,Default,,0,0,0,,Тек қорқу жеткіліксіз
Dialogue: 0,1:14:55.99,1:14:57.49,Default,,0,0,0,,Онымен сөйлескенде ол қандай адам...
Dialogue: 0,1:14:57.57,1:14:58.61,Default,,0,0,0,,Ах
Dialogue: 0,1:14:58.70,1:15:00.99,Default,,0,0,0,,Сізде тым көп энергия бар.
Dialogue: 0,1:15:30.48,1:15:33.73,Default,,0,0,0,,Мен бұл белгіні 7 жылда алғаш рет қолдандым.
Dialogue: 0,1:15:33.82,1:15:35.73,Default,,0,0,0,,«Шатырда сөйлесейік»
Dialogue: 0,1:15:35.82,1:15:36.90,Default,,0,0,0,,О
Dialogue: 0,1:15:36.99,1:15:39.28,Default,,0,0,0,,Жеңілдендім... Аман-есен.
Dialogue: 0,1:15:39.86,1:15:41.78,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,1:15:41.87,1:15:44.41,Default,,0,0,0,,Сіз мені қорғауыңыз керек...
Dialogue: 0,1:15:44.99,1:15:47.96,Default,,0,0,0,,Мен жаңа ғана қарызымды қайтардым... 7 жыл бұрын
Dialogue: 0,1:15:50.62,1:15:53.54,Default,,0,0,0,,Ой, мына бала ше? Қараңызшы, капсула.
Dialogue: 0,1:15:54.13,1:15:57.05,Default,,0,0,0,,Қиын шайқаспен бөлінген...
Dialogue: 0,1:15:57.13,1:15:58.97,Default,,0,0,0,,Сіз мұны жақсы түсінбейсіз бе?
Dialogue: 0,1:15:59.05,1:16:03.89,Default,,0,0,0,,Жоқ, СС-тен басқа ешкім білмейтін сияқты.
Dialogue: 0,1:16:03.97,1:16:05.56,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:16:05.64,1:16:08.89,Default,,0,0,0,,Мен сені Лелуш деп атай аламын ба?
Dialogue: 0,1:16:08.98,1:16:12.40,Default,,0,0,0,,Алдыңғы мен жазбалар бойынша өлген деп айтылады.
Dialogue: 0,1:16:12.48,1:16:15.52,Default,,0,0,0,,Лелуш Ламперуж Қазір ол өзін осылай атайды.
Dialogue: 0,1:16:15.61,1:16:16.78,Default,,0,0,0,,Иә
Dialogue: 0,1:16:16.86,1:16:19.74,Default,,0,0,0,,Әскери соттармен не болды?
Dialogue: 0,1:16:19.82,1:16:21.53,Default,,0,0,0,,Сонымен қатар, мен осында тіркелдім.
Dialogue: 0,1:16:21.61,1:16:23.57,Default,,0,0,0,,Мен де таң қалдым.
Dialogue: 0,1:16:23.66,1:16:25.45,Default,,0,0,0,,Лелуш сонда болады деп ешқашан ойламадым.
Dialogue: 0,1:16:26.12,1:16:31.54,Default,,0,0,0,,Тергеудің дұрыс жүргізілгеніне көз жеткізген адам болды.
Dialogue: 0,1:16:31.62,1:16:35.17,Default,,0,0,0,,Егер адам 17 жаста болса, мектепке бару керек...
Dialogue: 0,1:16:38.88,1:16:40.05,Default,,0,0,0,,​​О?
Dialogue: 0,1:16:41.68,1:16:42.59,Default,,0,0,0,,Ах
Dialogue: 0,1:16:44.34,1:16:45.85,Default,,0,0,0,,Осылайша...
Dialogue: 0,1:16:47.72,1:16:49.35,Default,,0,0,0,,Жақсы
Dialogue: 0,1:16:49.43,1:16:52.60,Default,,0,0,0,,Менің ойымша, сіз қауіпсізсіз.
Dialogue: 0,1:16:53.15,1:16:55.98,Default,,0,0,0,,Біраз уақыт өтті, Нунналли.
Dialogue: 0,1:16:57.23,1:16:59.53,Default,,0,0,0,,Созаку-сан, сен бүгін түне аласың ба?
Dialogue: 0,1:17:00.11,1:17:02.86,Default,,0,0,0,,Созаку қазірдің өзінде осы мектептің оқушысы.
Dialogue: 0,1:17:02.95,1:17:04.53,Default,,0,0,0,,Сондықтан біз кез келген уақытта кездесе аламыз.
Dialogue: 0,1:17:04.62,1:17:05.74,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:17:05.82,1:17:09.45,Default,,0,0,0,,Менің әскери жұмысым бар, сондықтан мен оны күнде істей алмаймын.
Dialogue: 0,1:17:09.54,1:17:12.25,Default,,0,0,0,,Әскер... Жалғастырасыз ба?
Dialogue: 0,1:17:12.33,1:17:13.62,Default,,0,0,0,,Жарайды
Dialogue: 0,1:17:13.71,1:17:17.54,Default,,0,0,0,,Мені техникалық бөлімге көшіруді тапсырдым, сондықтан бұл қауіпті емес.
Dialogue: 0,1:17:17.63,1:17:20.05,Default,,0,0,0,,Түсінемін, инженерлік бөлімі?
Dialogue: 0,1:17:21.55,1:17:22.88,Default,,0,0,0,,О, мен саған көмектесемін.
Dialogue: 0,1:17:23.55,1:17:25.14,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,1:17:25.22,1:17:27.64,Default,,0,0,0,,Жеті жыл бұрынғыдай емес, мен жүргізушімін.
Dialogue: 0,1:17:30.14,1:17:32.60,Default,,0,0,0,,Сіз тыныш болдыңыз.
Dialogue: 0,1:17:32.68,1:17:34.23,Default,,0,0,0,,Сіз дөрекі болдыңыз
Dialogue: 0,1:17:34.31,1:17:35.90,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:17:38.94,1:17:40.48,Default,,0,0,0,,Мен саған бөлмеңде қал дедім.
Dialogue: 0,1:17:40.57,1:17:44.74,Default,,0,0,0,,Бұл адам мен Синджукуда кездестірген британдық сарбаз.
Dialogue: 0,1:17:44.82,1:17:45.66,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:17:45.74,1:17:47.53,Default,,0,0,0,,Оның жағдайы жақсы.
Dialogue: 0,1:17:47.99,1:17:48.83,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,1:17:48.91,1:17:49.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:50.16,1:17:52.54,Default,,0,0,0,,Достар... Не?
Dialogue: 0,1:18:05.63,1:18:08.14,Default,,0,0,0,,Қасиетті Британ империясы
Dialogue: 0,1:18:08.22,1:18:12.97,Default,,0,0,0,,Мәртебелі 98-ші және жалғыз императордың сөздері
Dialogue: 0,1:18:16.90,1:18:20.23,Default,,0,0,0,,Адамдар тең емес
Dialogue: 0,1:18:20.86,1:18:24.74,Default,,0,0,0,,Жылдам туылған, әдемі
Dialogue: 0,1:18:24.82,1:18:29.24,Default,,0,0,0,,Ата-анасы кедей, денесі ауырғандар
Dialogue: 0,1:18:29.32,1:18:34.91,Default,,0,0,0,,Әр адамның туған жері, өскен ортасы, таланты әр түрлі.
Dialogue: 0,1:18:35.00,1:18:38.17,Default,,0,0,0,,Иә, адамдарды кемсітуге арналған.
Dialogue: 0,1:18:38.25,1:18:43.55,Default,,0,0,0,,Сондықтан адамдар күресіп, жарысады, прогрестің туатын жері.
Dialogue: 0,1:18:43.63,1:18:46.17,Default,,0,0,0,,Жек көрушілік, қызғаныш, артықшылық кешені
Dialogue: 0,1:18:46.68,1:18:49.64,Default,,0,0,0,,Барлық жағымсыз эмоциялар энергия болып табылады
Dialogue: 0,1:18:49.72,1:18:51.60,Default,,0,0,0,,Теңсіздік жаман емес
Dialogue: 0,1:18:52.06,1:18:54.64,Default,,0,0,0,,Теңдік – жамандық
Dialogue: 0,1:18:54.73,1:18:57.52,Default,,0,0,0,,Құқықтары тең ЕО ше?
Dialogue: 0,1:18:57.60,1:19:00.65,Default,,0,0,0,,Ол танымал саясатқа түсті.
Dialogue: 0,1:19:00.73,1:19:04.48,Default,,0,0,0,,Байлықты тең еткен Қытай Федерациясы жалқауларға толы.
Dialogue: 0,1:19:04.57,1:19:08.07,Default,,0,0,0,,Бірақ менің Британиям ондай емес.
Dialogue: 0,1:19:08.16,1:19:11.91,Default,,0,0,0,,Конфликт, бәсеке, үнемі дамып отыратын
Dialogue: 0,1:19:11.99,1:19:17.58,Default,,0,0,0,,Болашаққа тек Британия ғана алға жылжуда.
Dialogue: 0,1:19:17.66,1:19:20.00,Default,,0,0,0,,Менің ұлым Хловистің өлімі
Dialogue: 0,1:19:20.08,1:19:23.71,Default,,0,0,0,,Британияның дамуын жалғастыруының дәлелі
Dialogue: 0,1:19:23.80,1:19:25.42,Default,,0,0,0,,Ұрыс!
Dialogue: 0,1:19:25.51,1:19:29.30,Default,,0,0,0,,Жарыс, ұрлау, иемдену, үстемдік ету
Dialogue: 0,1:19:29.38,1:19:32.93,Default,,0,0,0,,Соңында болашақ бар!
Dialogue: 0,1:19:33.01,1:19:36.98,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,1:19:37.06,1:19:39.10,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,1:19:39.19,1:19:41.06,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,1:19:41.15,1:19:43.19,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,1:19:52.12,1:19:55.20,Default,,0,0,0,,Лелуштың жауы...
Dialogue: 0,1:19:57.75,1:20:00.79,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,1:20:01.58,1:20:02.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:03.29,1:20:05.42,Default,,0,0,0,,Не болды?Ерте кіріңіз
Dialogue: 0,1:20:06.09,1:20:08.84,Default,,0,0,0,,Бұдан былай бұл біздің жасырынатын жеріміз.
Dialogue: 0,1:20:08.92,1:20:12.22,Default,,0,0,0,,Сіз бізбен бірлесесіз деп болжауға бола ма?
Dialogue: 0,1:20:12.30,1:20:14.43,Default,,0,0,0,,Аа, біз доспыз.
Dialogue: 0,1:20:14.51,1:20:16.35,Default,,0,0,0,,Керемет
Dialogue: 0,1:20:16.43,1:20:18.23,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,1:20:18.85,1:20:21.10,Default,,0,0,0,,Жер бетінде мұндай нәрсе қалай болуы мүмкін ...
Dialogue: 0,1:20:21.65,1:20:23.27,Default,,0,0,0,,Мен сұрағанымда ол маған берді.
Dialogue: 0,1:20:23.36,1:20:25.07,Default,,0,0,0,,Азғын ақсүйек
Dialogue: 0,1:20:25.15,1:20:27.40,Default,,0,0,0,,Сұрасаңыз да... бұл оңай.
Dialogue: 0,1:20:27.48,1:20:29.69,Default,,0,0,0,,Жарайды, мен аяғымды ұстай алмаймын.
Dialogue: 0,1:20:30.90,1:20:32.36,Default,,0,0,0,,Қызғылт сары оқиға...
Dialogue: 0,1:20:33.24,1:20:34.83,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,1:20:34.91,1:20:37.79,Default,,0,0,0,,Сузаку Куруруги тонау оқиғасы кезінде
Dialogue: 0,1:20:37.87,1:20:40.50,Default,,0,0,0,,Раббыңыз туралы естелік жоқ деген рас па?
Dialogue: 0,1:20:40.58,1:20:42.75,Default,,0,0,0,,Маған сенгеніңді қаламаймын.
Dialogue: 0,1:20:42.83,1:20:46.09,Default,,0,0,0,,Жоқ, мен Синджуку оқиғасы кезінде сол жерде болдым.
Dialogue: 0,1:20:46.17,1:20:48.26,Default,,0,0,0,,Есте сақтау қабілетінің жоғалуы
Dialogue: 0,1:20:48.34,1:20:49.17,Default,,0,0,0,,Не!?
Dialogue: 0,1:20:49.26,1:20:53.34,Default,,0,0,0,,Мен ес жиған кезде, Сазерленд менен алынған болатын.
Dialogue: 0,1:20:53.43,1:20:55.35,Default,,0,0,0,,Және есте сақтау қабілетін жоғалтудың алдында
Dialogue: 0,1:20:55.43,1:20:57.85,Default,,0,0,0,,Мен мектеп формасын киген баламен кездесіп тұрмын.
Dialogue: 0,1:20:57.93,1:20:59.60,Default,,0,0,0,,Бұл студент ше?
Dialogue: 0,1:20:59.68,1:21:01.39,Default,,0,0,0,,Бетіңізді есіме түсіре алмаймын.
Dialogue: 0,1:21:01.48,1:21:04.48,Default,,0,0,0,,Бірақ оны зерттеу керек пе?
Dialogue: 0,1:21:09.90,1:21:12.49,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,1:21:14.36,1:21:16.53,Default,,0,0,0,,Иә? Британдық...
Dialogue: 0,1:21:16.62,1:21:19.24,Default,,0,0,0,,Барлаушыға лайықты көрінеді.
Dialogue: 0,1:21:19.33,1:21:20.29,Default,,0,0,0,,Сіз адвокатсыз ба?
Dialogue: 0,1:21:20.37,1:21:23.71,Default,,0,0,0,,Бұл жақсы нәрсе. Нөлдің қарамағындағылар көбейіп бара жатқан сияқты.
Dialogue: 0,1:21:23.79,1:21:25.50,Default,,0,0,0,,Бұл мен ойлағаннан да оңай болды.
Dialogue: 0,1:21:26.08,1:21:29.80,Default,,0,0,0,,«Мен Британияны жек көремін, бірақ терроризм әдісімен келіспеймін».
Dialogue: 0,1:21:29.88,1:21:32.38,Default,,0,0,0,,Бұл он бір көпшіліктің пікірі.
Dialogue: 0,1:21:32.47,1:21:34.51,Default,,0,0,0,,Сонымен, он бір
Dialogue: 0,1:21:34.59,1:21:36.34,Default,,0,0,0,,Сіз нөлдік шешімді қолдайсыз ба?
Dialogue: 0,1:21:36.89,1:21:39.81,Default,,0,0,0,,Осының арқасында топта әрекет ету оңайырақ болды.
Dialogue: 0,1:21:39.89,1:21:43.44,Default,,0,0,0,,Халық тек режимге хабар бермесе, үлкен көмек болар еді.
Dialogue: 0,1:21:43.52,1:21:44.77,Default,,0,0,0,,Сондай-ақ Киото деген топ бар.
Dialogue: 0,1:21:44.85,1:21:47.31,Default,,0,0,0,,Ол Nightmare-ді айналдыратынын айтады.
Dialogue: 0,1:21:47.40,1:21:50.44,Default,,0,0,0,,Ақпараттық қамтамасыз ету де жеделдетілген қарқынмен өсуде.
Dialogue: 0,1:21:50.94,1:21:54.07,Default,,0,0,0,,Жапондықтар төбелеске қарсы әлсіз.
Dialogue: 0,1:21:54.15,1:21:56.49,Default,,0,0,0,,Егер біз растай алатын алшақтық жасай алсақ...
Dialogue: 0,1:21:56.57,1:21:58.53,Default,,0,0,0,,Сіз осы мақсат үшін «әділдік одақтасы»сыз ба?
Dialogue: 0,1:21:59.12,1:22:02.08,Default,,0,0,0,,Оны бәрі жақсы көреді, солай ма? Әділеттің одақтасы...
Dialogue: 0,1:22:02.16,1:22:06.04,Default,,0,0,0,,Хехехе, бұл әділдік одақтасының жүзі емес.
Dialogue: 0,1:22:06.67,1:22:07.83,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:22:07.92,1:22:10.05,Default,,0,0,0,,Мен төмендетілдім.
Dialogue: 0,1:22:10.13,1:22:11.76,Default,,0,0,0,,Дәл сіз сияқты.
Dialogue: 0,1:22:12.63,1:22:15.13,Default,,0,0,0,,Сондықтан мен сенің күшіңді қарызға алғым келеді.
Dialogue: 0,1:22:15.22,1:22:18.51,Default,,0,0,0,,Біз мұнымен бітпейміз, сіз де бітірмейсіз.
Dialogue: 0,1:22:18.60,1:22:20.06,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,1:22:20.14,1:22:22.02,Default,,0,0,0,,Нөлді тапқыңыз келмей ме?
Dialogue: 0,1:22:22.10,1:22:23.18,Default,,0,0,0,,Nu
Dialogue: 0,1:22:23.27,1:22:25.39,Default,,0,0,0,,Жеке Эшфорд академиясы
Dialogue: 0,1:22:25.48,1:22:27.77,Default,,0,0,0,,Мен сізден сол жердегі студент жігітті тергеуіңізді сұраймын.
Dialogue: 0,1:22:27.85,1:22:29.73,Default,,0,0,0,,Нөлдің серіктесі сияқты.
Dialogue: 0,1:22:30.32,1:22:31.73,Default,,0,0,0,,Біз әскери міндеттіміз
Dialogue: 0,1:22:31.82,1:22:34.53,Default,,0,0,0,,Мен Нарита тау жотасына баруым керек.
Dialogue: 0,1:22:34.61,1:22:35.45,Default,,0,0,0,,Бұл арада…
Dialogue: 0,1:22:35.53,1:22:36.95,Default,,0,0,0,,Нарита?
Dialogue: 0,1:22:37.03,1:22:41.16,Default,,0,0,0,,Жапон азаттық майданының штаб-пәтері сонда болуы мүмкін немесе болмауы мүмкін деген қауесет бар.
Dialogue: 0,1:22:41.24,1:22:43.29,Default,,0,0,0,,Тым кесілген болса да ескеру керек.
Dialogue: 0,1:22:43.95,1:22:45.91,Default,,0,0,0,,Сіз тым көп сатып алдыңыз.
Dialogue: 0,1:22:46.58,1:22:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:48.46,1:22:49.75,Default,,0,0,0,,Ле Ру?
Dialogue: 0,1:22:50.54,1:22:51.42,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:22:53.46,1:22:55.22,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:22:59.59,1:23:00.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:01.01,1:23:03.43,Default,,0,0,0,,Сізге бірдеңе керек пе, жас ханым?
Dialogue: 0,1:23:03.52,1:23:05.52,Default,,0,0,0,,А, жоқ, кешіріңіз.
Dialogue: 0,1:23:05.60,1:23:07.73,Default,,0,0,0,,Мен біреуді танимын деп ойладым.
Dialogue: 0,1:23:09.52,1:23:13.69,Default,,0,0,0,,Біртүрлі екен, үшінші рет...
Dialogue: 0,1:23:16.40,1:23:17.61,Default,,0,0,0,,Керемет!
Dialogue: 0,1:23:17.70,1:23:19.41,Default,,0,0,0,,Бұл Глазго ма?
Dialogue: 0,1:23:19.49,1:23:21.78,Default,,0,0,0,,«Бурай» Жапония өзгерткен.
Dialogue: 0,1:23:21.87,1:23:23.62,Default,,0,0,0,,Мен мұндайды бірінші рет көріп тұрмын.
Dialogue: 0,1:23:23.70,1:23:25.91,Default,,0,0,0,,Бұл топтың күші жоқ.
Dialogue: 0,1:23:26.00,1:23:27.91,Default,,0,0,0,,Қабылдау емтиханы да оңай болған жоқ.
Dialogue: 0,1:23:28.00,1:23:30.29,Default,,0,0,0,,Бұл біздің элитамыз дегенді білдіре ме? элита?
Dialogue: 0,1:23:30.38,1:23:32.17,Default,,0,0,0,,Ол жанып жатыр.
Dialogue: 0,1:23:32.25,1:23:34.75,Default,,0,0,0,,Киото халқына дейін
Dialogue: 0,1:23:34.84,1:23:37.51,Default,,0,0,0,,Бұл жапондықтардың тамаша түні
Dialogue: 0,1:23:37.59,1:23:38.97,Default,,0,0,0,,Гүрен 2-ші стиль
Dialogue: 0,1:23:39.05,1:23:40.30,Default,,0,0,0,,Сіз нұсқаулықты көрдіңіз бе?
Dialogue: 0,1:23:40.39,1:23:43.01,Default,,0,0,0,,Радиациялық толқындар, солай ма?Бұл тамаша қару
Dialogue: 0,1:23:43.10,1:23:45.06,Default,,0,0,0,,Хэ-хэ, мен өте қуаныштымын.
Dialogue: 0,1:23:45.56,1:23:49.69,Default,,0,0,0,,Бұл Киотоның ұлылары да бізді қара рыцарьлар деп танығанын білдіреді.
Dialogue: 0,1:23:49.77,1:23:51.10,Default,,0,0,0,,Сенпай! (Тамаки) Иә?
Dialogue: 0,1:23:51.19,1:23:52.98,Default,,0,0,0,,Бұл жабдықты қалай өңдеу керек...
Dialogue: 0,1:23:53.06,1:23:55.32,Default,,0,0,0,,Жарайды, мен қазір барамын. Бір минут күте тұрыңыз.
Dialogue: 0,1:23:55.40,1:23:57.74,Default,,0,0,0,,Оған көмектесу мүмкін емес, жаңадан келген.
Dialogue: 0,1:24:00.45,1:24:03.53,Default,,0,0,0,,Тамаки былай тұрсын, тіпті Иноуэ де, басқалары да қобалжыды.
Dialogue: 0,1:24:03.62,1:24:04.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:04.66,1:24:06.54,Default,,0,0,0,,Киотода бірнеше қарсылық бар
Dialogue: 0,1:24:06.62,1:24:08.20,Default,,0,0,0,,Сіздің қолдау көрсетіп жатқаныңызды естідім бе?
Dialogue: 0,1:24:08.29,1:24:11.33,Default,,0,0,0,,Иә, біз ақыры соған қосылдық...
Dialogue: 0,1:24:11.42,1:24:13.96,Default,,0,0,0,,Жоқ, сіз қателесесіз Карен.
Dialogue: 0,1:24:14.04,1:24:15.75,Default,,0,0,0,,Бұл жай ғана сынақ
Dialogue: 0,1:24:15.84,1:24:17.30,Default,,0,0,0,,Сіз солай ойласаңыз да
Dialogue: 0,1:24:17.38,1:24:18.67,Default,,0,0,0,,Бұл керемет
Dialogue: 0,1:24:18.76,1:24:20.13,Default,,0,0,0,,Бұл оң.
Dialogue: 0,1:24:20.76,1:24:21.72,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:23.01,1:24:23.85,Default,,0,0,0,,Бұл…
Dialogue: 0,1:24:24.47,1:24:26.72,Default,,0,0,0,,Екінші Гурен стилі сенікі, Карен.
Dialogue: 0,1:24:26.81,1:24:27.93,Default,,0,0,0,,Мен?
Dialogue: 0,1:24:28.02,1:24:29.73,Default,,0,0,0,,Бірақ қазір адамдар көбірек.
Dialogue: 0,1:24:29.81,1:24:32.27,Default,,0,0,0,,Ал егер сізде Гуреннің қорғаныс күші болса, онда сіз ...
Dialogue: 0,1:24:32.35,1:24:33.81,Default,,0,0,0,,Сіз ұшқышсыз
Dialogue: 0,1:24:33.90,1:24:38.53,Default,,0,0,0,,Мен командирмін, мен төбелесшілерімді қолданамын, бірақ сен менің ұрыстағы жалғыз тұлпарымсың.
Dialogue: 0,1:24:38.61,1:24:39.78,Default,,0,0,0,,Ах
Dialogue: 0,1:24:40.61,1:24:41.78,Default,,0,0,0,,Иә
Dialogue: 0,1:24:41.86,1:24:44.03,Default,,0,0,0,,Нөл, қарсы боласыз ба?
Dialogue: 0,1:24:44.12,1:24:46.03,Default,,0,0,0,,Біртүрлі ақпарат келді
Dialogue: 0,1:24:46.12,1:24:48.16,Default,,0,0,0,,Қосылғысы келетін британиялықтан.
Dialogue: 0,1:24:49.45,1:24:52.29,Default,,0,0,0,,Бізді арбау үшін тұзақ емес пе?
Dialogue: 0,1:24:52.37,1:24:56.71,Default,,0,0,0,,Артынан өткіңіз келсе де, бұл адамға абайсызда жақындау қауіпті.
Dialogue: 0,1:24:56.80,1:25:00.72,Default,,0,0,0,,Бірақ бұл елемеу үшін тым көп ақпарат. Не істеуім керек?
Dialogue: 0,1:25:01.30,1:25:03.01,Default,,0,0,0,,Мүмкін мен демалыс күндері жаяу серуендейтін шығармын.
Dialogue: 0,1:25:03.09,1:25:04.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:04.14,1:25:05.51,Default,,0,0,0,,Нарита тау жотасына дейін
Dialogue: 0,1:25:09.22,1:25:11.02,Default,,0,0,0,,5-бөлім Аномалия жоқ
Dialogue: 0,1:25:11.10,1:25:13.85,Default,,0,0,0,,Иә, келесі жоспарланған контакт 2 сағаттан кейін болады.
Dialogue: 0,1:25:14.73,1:25:16.82,Default,,0,0,0,,Ешқандай ауытқу болуы мүмкін емес.
Dialogue: 0,1:25:16.90,1:25:20.61,Default,,0,0,0,,Бұл біздің Жапонияны азат ету майданының ықпал ету аймағы.
Dialogue: 0,1:25:20.07,1:25:21.78,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:25:20.69,1:25:21.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:22.70,1:25:24.45,Default,,0,0,0,,Нөл!? Тынышталыңыз.
Dialogue: 0,1:25:24.53,1:25:25.78,Default,,0,0,0,,Мен жаңа ғана сөйлесуге келдім.
Dialogue: 0,1:25:26.41,1:25:29.74,Default,,0,0,0,,Барлық ауытқуларды елемеуге болады.
Dialogue: 0,1:25:35.75,1:25:36.96,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,1:25:37.04,1:25:38.42,Default,,0,0,0,,Ей, сенің кезегің.
Dialogue: 0,1:25:38.50,1:25:41.26,Default,,0,0,0,,Хаха, асықпа, мен әскери борыштымын.
Dialogue: 0,1:25:46.01,1:25:47.80,Default,,0,0,0,,Мен сигналды нөлден растадым.
Dialogue: 0,1:25:47.89,1:25:49.76,Default,,0,0,0,,々２
Dialogue: 0,1:25:51.85,1:25:53.52,Default,,0,0,0,,Әскери дайындық, солай ма?
Dialogue: 0,1:25:53.60,1:25:55.65,Default,,0,0,0,,Тек нөл басқа жерде ме?
Dialogue: 0,1:25:55.73,1:25:57.23,Default,,0,0,0,,Олар ыстық бұлақтарды қазбай ма?
Dialogue: 0,1:25:57.31,1:26:00.44,Default,,0,0,0,,А, мен бұл экскаватордың осы мақсатқа арналған екенін түсіндім.
Dialogue: 0,1:26:02.40,1:26:05.20,Default,,0,0,0,,Корнелия Күн де ​​келді.
Dialogue: 0,1:26:05.28,1:26:06.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:09.28,1:26:10.37,Default,,0,0,0,,Осы салада
Dialogue: 0,1:26:10.45,1:26:13.75,Default,,0,0,0,,Жапон азаттық майданының штаб-пәтері сонда болатыны анық.
Dialogue: 0,1:26:13.83,1:26:17.04,Default,,0,0,0,,Төрт батальон жеті бөлімге бөлініп, орналастырылды.
Dialogue: 0,1:26:17.13,1:26:21.21,Default,,0,0,0,,Губернатордың белгісін күткеннен кейін біз қоршауды тез тарылтып, оларды жойып жібердік.
Dialogue: 0,1:26:21.30,1:26:24.88,Default,,0,0,0,,Дұшпан қоршаудан тыс жерден шығады ма?
Dialogue: 0,1:26:24.97,1:26:26.72,Default,,0,0,0,,Иә? (Корнелия) Нөл?
Dialogue: 0,1:26:26.80,1:26:28.34,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,1:26:28.43,1:26:32.77,Default,,0,0,0,,Операция басталған бойда айналадағы жолдар мен тау жолдары жабылады.
Dialogue: 0,1:26:32.85,1:26:35.73,Default,,0,0,0,,Нашар көрсетсең, Югун да бар.
Dialogue: 0,1:26:35.81,1:26:37.81,Default,,0,0,0,,Бұл уақыт нөлдің соңы болады.
Dialogue: 0,1:26:38.81,1:26:41.44,Default,,0,0,0,,C.C. Сен мұндай жерде не істеп жүрсің?
Dialogue: 0,1:26:41.52,1:26:43.65,Default,,0,0,0,,Сіз мені қорғаймын дедіңіз.
Dialogue: 0,1:26:43.74,1:26:45.15,Default,,0,0,0,,Қамқоршы болып көріну!
Dialogue: 0,1:26:45.24,1:26:48.82,Default,,0,0,0,,Лелуш, сен неге Лелушсың?
Dialogue: 0,1:26:48.91,1:26:51.49,Default,,0,0,0,,Философия туралы айтуға уақытым жоқ.
Dialogue: 0,1:26:51.58,1:26:54.00,Default,,0,0,0,,Үйдің аты Ламперуж болып өзгертілді.
Dialogue: 0,1:26:54.08,1:26:57.21,Default,,0,0,0,,Бірақ Лелуш есімді адам қалды.
Dialogue: 0,1:26:58.00,1:27:00.38,Default,,0,0,0,,Бұл аңғалдық. Мен өткенді қоя алмаймын.
Dialogue: 0,1:27:00.46,1:27:02.67,Default,,0,0,0,,Сондықтан да С. тым алысқа барады.
Dialogue: 0,1:27:02.75,1:27:04.05,Default,,0,0,0,,Адам есімі емес
Dialogue: 0,1:27:10.60,1:27:14.43,Default,,0,0,0,,Лелуш Қардың неліктен ақ екенін білесіз бе?
Dialogue: 0,1:27:14.52,1:27:15.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:16.23,1:27:19.65,Default,,0,0,0,,Өйткені мен қандай түсті екенімді ұмытып қалдым
Dialogue: 0,1:27:20.52,1:27:22.19,Default,,0,0,0,,Губернатор, уақыт келді.
Dialogue: 0,1:27:22.27,1:27:24.32,Default,,0,0,0,,Жарайды, операцияны бастаңыз!
Dialogue: 0,1:27:26.74,1:27:28.49,Default,,0,0,0,,Жапония азат ету майданы…
Dialogue: 0,1:27:29.74,1:27:32.58,Default,,0,0,0,,Кейде артта қалғандар
Dialogue: 0,1:27:32.66,1:27:34.99,Default,,0,0,0,,Қайырымдылықты ұмытқандар
Dialogue: 0,1:27:35.08,1:27:38.83,Default,,0,0,0,,Қазір Махоробаның арманымен бірге ыдырап, жоғалатын кез.
Dialogue: 0,1:27:41.92,1:27:43.29,Default,,0,0,0,,Жау шабуылы!?
Dialogue: 0,1:27:43.38,1:27:44.46,Default,,0,0,0,,Британ әскері
Dialogue: 0,1:27:44.55,1:27:46.80,Default,,0,0,0,,Ол бүкіл Нарита тауларын қоршап жатыр.
Dialogue: 0,1:27:46.88,1:27:48.84,Default,,0,0,0,,Сан 100-ден асты!
Dialogue: 0,1:27:50.68,1:27:52.18,Default,,0,0,0,,Ол басталды.
Dialogue: 0,1:27:53.05,1:27:54.76,Default,,0,0,0,,Жай әзіл...
Dialogue: 0,1:27:54.85,1:27:56.68,Default,,0,0,0,,This is no joke, Zero!
Dialogue: 0,1:27:56.77,1:27:58.89,Default,,0,0,0,,Егер мұндай нәрсе келсе, бізді толығымен қоршап алар едік!
Dialogue: 0,1:27:58.98,1:28:00.14,Default,,0,0,0,,Үйге қайтар жолда!
Dialogue: 0,1:28:00.23,1:28:01.73,Default,,0,0,0,,Ол әлдеқашан құлыпталған.
Dialogue: 0,1:28:02.31,1:28:05.11,Default,,0,0,0,,Тірі қалудың жалғыз жолы - бұл жерде соғысу.
Dialogue: 0,1:28:05.19,1:28:07.19,Default,,0,0,0,,War... with Britannia?
Dialogue: 0,1:28:07.78,1:28:10.45,Default,,0,0,0,,Are you supposed to fight head-on?! Even though you're surrounded!
Dialogue: 0,1:28:10.53,1:28:12.62,Default,,0,0,0,,Оның үстіне қарсылас Корнелияның әскері
Dialogue: 0,1:28:12.70,1:28:14.74,Default,,0,0,0,,It's a bigger force than before.
Dialogue: 0,1:28:14.83,1:28:17.20,Default,,0,0,0,,Әй, мұнымен жеңсек, керемет болар еді.
Dialogue: 0,1:28:17.29,1:28:18.91,Default,,0,0,0,,Нөл!Қазір!
Dialogue: 0,1:28:19.00,1:28:20.08,Default,,0,0,0,,Тіпті Мәсіх
Dialogue: 0,1:28:20.16,1:28:22.63,Default,,0,0,0,,Ғажайып жасамасам, танымас едім.
Dialogue: 0,1:28:22.71,1:28:25.84,Default,,0,0,0,,Егер солай болса, бізге де ғажайып керек, солай ма?
Dialogue: 0,1:28:25.92,1:28:29.67,Default,,0,0,0,,Көрдіңіз бе, ғажайыптар арзанға сатылмайды.
Dialogue: 0,1:28:29.76,1:28:31.68,Default,,0,0,0,,Көшбасшы бола алмайсың ғой!
Dialogue: 0,1:28:31.76,1:28:32.64,Default,,0,0,0,,Менмін
Dialogue: 0,1:28:33.05,1:28:34.51,Default,,0,0,0,,Уф!
Dialogue: 0,1:28:37.97,1:28:38.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:38.89,1:28:40.39,Default,,0,0,0,,Қашу жолы әлдеқашан кесілген.
Dialogue: 0,1:28:40.48,1:28:43.52,Default,,0,0,0,,Менсіз жеңемін деп ойлайтын адам жақсы.
Dialogue: 0,1:28:43.60,1:28:45.02,Default,,0,0,0,,Мені атып таста
Dialogue: 0,1:28:46.19,1:28:48.03,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,1:28:50.53,1:28:52.57,Default,,0,0,0,,Себебі сен мені өз көшбасшың ретінде қарайсың
Dialogue: 0,1:28:52.66,1:28:54.49,Default,,0,0,0,,There are only two options
Dialogue: 0,1:28:54.57,1:28:58.16,Default,,0,0,0,,Менімен бірге өмір сүр немесе менімен бірге өл!
Dialogue: 0,1:28:58.24,1:29:00.66,Default,,0,0,0,,Жақын арада жау әскерлері пайда болуы керек.
Dialogue: 0,1:29:00.75,1:29:04.96,Default,,0,0,0,,Бұл ECCM кеңейтімі Арнаны α4 (Альфа төрт) желісіне қосыңыз
Dialogue: 0,1:29:05.04,1:29:07.34,Default,,0,0,0,,What did the enemy say?
Dialogue: 0,1:29:07.42,1:29:08.46,Default,,0,0,0,,Сіз сенімсізсіз бе?
Dialogue: 0,1:29:08.55,1:29:11.38,Default,,0,0,0,,О, тек Глазвег имитацияларынан сақ болыңыз.
Dialogue: 0,1:29:11.47,1:29:12.63,Default,,0,0,0,,Менің Ием Иса
Dialogue: 0,1:29:16.55,1:29:19.14,Default,,0,0,0,,Hou, was this mountain a fortress?
Dialogue: 0,1:29:19.22,1:29:20.93,Default,,0,0,0,,Мәртебелі, артқа шегініңіз.
Dialogue: 0,1:29:21.02,1:29:24.44,Default,,0,0,0,,Гилфорд, мені ол әйелдермен араластырма.
Dialogue: 0,1:29:25.98,1:29:26.98,Default,,0,0,0,,Мәртебелі Корнелия!
Dialogue: 0,1:29:27.07,1:29:28.69,Default,,0,0,0,,Жоқ! Корнелия!?
Dialogue: 0,1:29:28.78,1:29:30.40,Default,,0,0,0,,Don't be intimidated! генералдың басы
Dialogue: 0,1:29:30.49,1:29:31.69,Default,,0,0,0,,Елес!
Dialogue: 0,1:29:33.86,1:29:34.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:40.91,1:29:43.71,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен саған көмекке келемін.
Dialogue: 0,1:29:43.79,1:29:44.67,Default,,0,0,0,,Хехе
Dialogue: 0,1:29:44.75,1:29:47.09,Default,,0,0,0,,Come on, Cornelia is here.
Dialogue: 0,1:29:47.17,1:29:49.00,Default,,0,0,0,,Is there no one who will challenge me?
Dialogue: 0,1:29:49.09,1:29:51.38,Default,,0,0,0,,Не болды?мені сынап, жеңіңіз
Dialogue: 0,1:29:53.30,1:29:55.05,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,1:29:55.13,1:29:56.80,Default,,0,0,0,,Ah, you're the leader.
Dialogue: 0,1:29:57.47,1:29:59.81,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:30:03.06,1:30:04.35,Default,,0,0,0,,Тым осал
Dialogue: 0,1:30:04.44,1:30:06.81,Default,,0,0,0,,Бұл жерде жау күштері шоғырланған.
Dialogue: 0,1:30:06.90,1:30:08.52,Default,,0,0,0,,It might be a hit.
Dialogue: 0,1:30:08.61,1:30:09.82,Default,,0,0,0,,Тараңдар!
Dialogue: 0,1:30:12.65,1:30:15.24,Default,,0,0,0,,No, the second attack won't work either!
Dialogue: 0,1:30:17.74,1:30:19.83,Default,,0,0,0,,Is that... Dalton?
Dialogue: 0,1:30:19.91,1:30:22.16,Default,,0,0,0,,Was the enemy's base over there?
Dialogue: 0,1:30:22.25,1:30:24.50,Default,,0,0,0,,Жарайды, біз осында дайындаламыз.
Dialogue: 0,1:30:24.58,1:30:25.92,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,1:30:26.00,1:30:29.00,Default,,0,0,0,,Менің қарамағымдағылардан несие ұрлау хоббиім жоқ.
Dialogue: 0,1:30:29.09,1:30:31.25,Default,,0,0,0,,Запастағы әскерлерді Дальтон жағына жылжытыңыз.
Dialogue: 0,1:30:31.34,1:30:32.80,Default,,0,0,0,,Тағы да медальдар болады
Dialogue: 0,1:30:33.51,1:30:37.22,Default,,0,0,0,,Hmph, Корнелия күткендей, бұл логикалық құрам.
Dialogue: 0,1:30:42.64,1:30:45.81,Default,,0,0,0,,Запастағы әскерлер генерал Дальтонның қол астында жиналмай ма?
Dialogue: 0,1:30:45.89,1:30:47.44,Default,,0,0,0,,Иә, бірақ біздің команда
Dialogue: 0,1:30:47.52,1:30:49.69,Default,,0,0,0,,Губернатор Корнелияның артында дайындалыңыз.
Dialogue: 0,1:30:49.77,1:30:53.03,Default,,0,0,0,,Бұл артқы жағы!? Бұл сонымен қатар негізгі ұрыс алаңының шетінде!
Dialogue: 0,1:30:53.11,1:30:56.53,Default,,0,0,0,,Осындай жерде менің атымды өшіруімді қалай сұрауға болады?
Dialogue: 0,1:30:58.41,1:30:59.87,Default,,0,0,0,,Қобаши отрядының байланыс жоғалуы
Dialogue: 0,1:30:59.95,1:31:01.66,Default,,0,0,0,,Үшінші бөлім Жауап жоқ
Dialogue: 0,1:31:01.74,1:31:03.12,Default,,0,0,0,,Майор Табата соғыс кезінде қаза тапты
Dialogue: 0,1:31:03.20,1:31:04.75,Default,,0,0,0,,Курода мен Курата да жеңілді!
Dialogue: 0,1:31:04.83,1:31:06.25,Default,,0,0,0,,Сакамотоға не болды?
Dialogue: 0,1:31:06.33,1:31:07.92,Default,,0,0,0,,Іс...
Dialogue: 0,1:31:08.00,1:31:10.75,Default,,0,0,0,,Тодо болғанша, камикадзе соғады...
Dialogue: 0,1:31:10.84,1:31:13.46,Default,,0,0,0,,Ицукусима кереметі тағы да...
Dialogue: 0,1:31:16.30,1:31:18.47,Default,,0,0,0,,Бұл тым итермелеу емес пе?Тодо мырза
Dialogue: 0,1:31:18.55,1:31:20.72,Default,,0,0,0,,Асахина Чиба Бурай Кайға дайындалуда.
Dialogue: 0,1:31:20.80,1:31:21.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:21.72,1:31:23.89,Default,,0,0,0,,Мұны артыңыздағы Сенба Урабеге айтыңыз.
Dialogue: 0,1:31:23.97,1:31:26.02,Default,,0,0,0,,Нарита айналасындағы қозғалыс шектеулері
Dialogue: 0,1:31:26.10,1:31:28.02,Default,,0,0,0,,Істер басталып кетті!
Dialogue: 0,1:31:35.32,1:31:38.03,Default,,0,0,0,,11…
Dialogue: 0,1:31:38.11,1:31:39.57,Default,,0,0,0,,Бітті.
Dialogue: 0,1:31:39.66,1:31:42.12,Default,,0,0,0,,Жақсы! бәрі дайын
Dialogue: 0,1:31:42.20,1:31:44.70,Default,,0,0,0,,Қара рыцарьлар сұрыптауға дайын!
Dialogue: 0,1:31:45.87,1:31:47.21,Default,,0,0,0,,Шүкір, мен мұны істеуім керек.
Dialogue: 0,1:31:47.29,1:31:48.29,Default,,0,0,0,,Мен өле аламын ба?
Dialogue: 0,1:31:48.37,1:31:50.00,Default,,0,0,0,,Мен керемет жасаймын
Dialogue: 0,1:31:50.08,1:31:51.83,Default,,0,0,0,,Бізде нөл бар
Dialogue: 0,1:31:51.92,1:31:53.84,Default,,0,0,0,,Бұдан былай, менің Қара Рыцарларым
Dialogue: 0,1:31:53.92,1:31:57.17,Default,,0,0,0,,Таудың басынан британдық әскерге тосын шабуыл жасаңыз.
Dialogue: 0,1:31:57.26,1:31:59.09,Default,,0,0,0,,Менің нұсқауларымды орындаңыз
Dialogue: 0,1:31:59.18,1:32:01.14,Default,,0,0,0,,Бірден үшінші нүктеге қарай жүгіріңіз.
Dialogue: 0,1:32:01.22,1:32:05.47,Default,,0,0,0,,Операцияның мақсаты - Британияның екінші ханшайымы Корнелияны қорғау.
Dialogue: 0,1:32:06.06,1:32:08.48,Default,,0,0,0,,Гуреннің екінші түрі кіру жолын ашады.
Dialogue: 0,1:32:10.48,1:32:13.19,Default,,0,0,0,,Карен Өткізгіш электрод үшін 3 нөмірін пайдаланыңыз.
Dialogue: 0,1:32:13.27,1:32:14.40,Default,,0,0,0,,Сіз мұны бір соққымен шеше аласыз, солай ма?
Dialogue: 0,1:32:14.48,1:32:15.32,Default,,0,0,0,,Иә
Dialogue: 0,1:32:17.57,1:32:21.16,Default,,0,0,0,,Шығысты растау Сәулелену толқынының механизмі Төтенше жағдайды сақтау
Dialogue: 0,1:32:25.12,1:32:26.20,Default,,0,0,0,,Аа...
Dialogue: 0,1:32:26.29,1:32:27.58,Default,,0,0,0,,Құрыш жеңінің беріліс қорабы
Dialogue: 0,1:32:37.51,1:32:38.84,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:32:42.64,1:32:44.55,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:32:43.72,1:32:44.55,Default,,0,0,0,,Иә!
Dialogue: 0,1:32:55.65,1:32:57.07,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,1:32:57.82,1:32:59.24,Default,,0,0,0,,Әй, бұл жер сілкінісі ме?
Dialogue: 0,1:32:59.32,1:33:01.15,Default,,0,0,0,,Осындай кездер... Уау!
Dialogue: 0,1:33:01.24,1:33:02.41,Default,,0,0,0,,Не!?
Dialogue: 0,1:33:03.24,1:33:04.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:33:04.41,1:33:06.91,Default,,0,0,0,,Ақымақ! Осындай үлкен көшкін!
Dialogue: 0,1:33:06.99,1:33:07.95,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,1:33:08.04,1:33:10.04,Default,,0,0,0,,Алекс пен Далтонның отрядтары жойылды!
Dialogue: 0,1:33:10.12,1:33:12.16,Default,,0,0,0,,Өрмелеңіз! Биік жерге көшіңіз!
Dialogue: 0,1:33:12.25,1:33:13.46,Default,,0,0,0,,Жағдайды қалай түсінесіз?
Dialogue: 0,1:33:13.54,1:33:14.83,Default,,0,0,0,,Әлі қаралуда
Dialogue: 0,1:33:14.92,1:33:17.17,Default,,0,0,0,,Мәртебелі, артқа шегініңіз. Ол жерде қауіпті.
Dialogue: 0,1:33:20.59,1:33:22.01,Default,,0,0,0,,Уау!
Dialogue: 0,1:33:22.76,1:33:25.93,Default,,0,0,0,,Хмм, бұл мен күткеннен де жойқын күш.
Dialogue: 0,1:33:26.01,1:33:30.93,Default,,0,0,0,,Біз Корнелия отрядын оқшаулай алдық, бірақ сәл абай болу керек шығар.
Dialogue: 0,1:33:31.02,1:33:33.14,Default,,0,0,0,,Физика мұғалімі... жоқ
Dialogue: 0,1:33:33.23,1:33:36.06,Default,,0,0,0,,Нинадан маған, соның ішінде ықтималдық теориясын үйретуін сұрауым керек пе?
Dialogue: 0,1:33:36.65,1:33:38.77,Default,,0,0,0,,Таудың басынан расталған жаңа әскерлер
Dialogue: 0,1:33:38.86,1:33:41.15,Default,,0,0,0,,Кариус отряды тосқауыл қоюға бет алды.
Dialogue: 0,1:33:41.24,1:33:45.07,Default,,0,0,0,,Бұл Жапония азат ету майданы емес. Қарсылас «Нөл» тобы сияқты.
Dialogue: 0,1:33:45.16,1:33:46.57,Default,,0,0,0,,Не!? Сонымен...
Dialogue: 0,1:33:46.66,1:33:47.78,Default,,0,0,0,,Нөл!
Dialogue: 0,1:33:47.87,1:33:49.95,Default,,0,0,0,,Танысқаныма қуаныштымын, Нөл!
Dialogue: 0,1:33:50.04,1:33:52.33,Default,,0,0,0,,Еремия мырза, өз лауазымыңызды рұқсатсыз қалдырмаңыз!
Dialogue: 0,1:33:52.41,1:33:56.38,Default,,0,0,0,,Бұл төтенше жағдай. Табысты болғың келсе, маған жазыл!
Dialogue: 0,1:33:56.46,1:33:58.54,Default,,0,0,0,,Корнелияға арналған күшейтулер шектеулі.
Dialogue: 0,1:33:58.63,1:33:59.88,Default,,0,0,0,,Бірден алға!
Dialogue: 0,1:33:59.96,1:34:02.47,Default,,0,0,0,,О!Егер бұл орын алса, мен мұны істеймін!
Dialogue: 0,1:34:04.47,1:34:08.18,Default,,0,0,0,,Жарайсың ба? Біздің міндетіміз - нөлдерді артқы жағынан қорғау.
Dialogue: 0,1:34:08.26,1:34:09.10,Default,,0,0,0,,Ату!
Dialogue: 0,1:34:12.52,1:34:14.23,Default,,0,0,0,,Кариус тобы жойылды ма?
Dialogue: 0,1:34:14.31,1:34:18.69,Default,,0,0,0,,Чит, біз Нөлдің Корнелия Мәртебелімен байланысына дейін мәселені шешуіміз керек...
Dialogue: 0,1:34:18.77,1:34:20.07,Default,,0,0,0,,Еремия сэр
Dialogue: 0,1:34:20.15,1:34:22.36,Default,,0,0,0,,Виллетта? Келдің бе?
Dialogue: 0,1:34:22.94,1:34:25.28,Default,,0,0,0,,Артқы судың түзілуі және Гякуотоши
Dialogue: 0,1:34:25.36,1:34:28.20,Default,,0,0,0,,Мен классикалық тактиканың соншалықты тиімді екенін білмедім.
Dialogue: 0,1:34:28.28,1:34:29.53,Default,,0,0,0,,Нөл!
Dialogue: 0,1:34:33.33,1:34:34.75,Default,,0,0,0,,Нөл бар ма?
Dialogue: 0,1:34:34.83,1:34:38.42,Default,,0,0,0,,Сен сонда болсаң, менімен шайқас... Жеремия Годбалт!
Dialogue: 0,1:34:38.50,1:34:40.96,Default,,0,0,0,,Әй, біраз болды.
Dialogue: 0,1:34:41.05,1:34:42.92,Default,,0,0,0,,Сіз әлі де әскери қызметтесіз бе?
Dialogue: 0,1:34:43.01,1:34:46.76,Default,,0,0,0,,Бірақ дәл қазір саған уақытым жоқ.
Dialogue: 0,1:34:46.84,1:34:47.97,Default,,0,0,0,,Апельсин-кун
Dialogue: 0,1:34:48.05,1:34:50.60,Default,,0,0,0,,О! Ооооооооооооо...
Dialogue: 0,1:34:50.68,1:34:52.56,Default,,0,0,0,,Бұл қызғылт сары!?
Dialogue: 0,1:34:52.64,1:34:54.02,Default,,0,0,0,,Мен өлдім!
Dialogue: 0,1:34:56.14,1:34:57.48,Default,,0,0,0,,Нуха!?
Dialogue: 0,1:34:59.19,1:35:00.27,Default,,0,0,0,,Еремия мырза!
Dialogue: 0,1:35:00.36,1:35:03.11,Default,,0,0,0,,Маған тиіспе!Бұл менің дуэлім!
Dialogue: 0,1:35:03.19,1:35:04.15,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:35:04.24,1:35:06.53,Default,,0,0,0,,Бұл мен көрген қорқыныштың бірінші түрі.
Dialogue: 0,1:35:06.61,1:35:08.11,Default,,0,0,0,,Мен он бірді күтпедім...
Dialogue: 0,1:35:08.20,1:35:11.03,Default,,0,0,0,,Eleven стилінде мұндай техника бар ма?
Dialogue: 0,1:35:13.87,1:35:15.04,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,1:35:16.58,1:35:20.54,Default,,0,0,0,,Уф! Эй, бұл кім!? Бұл жігіт Кариустың бөлімшесін басқарады...
Dialogue: 0,1:35:20.63,1:35:21.96,Default,,0,0,0,,Британияны көрдіңіз бе?
Dialogue: 0,1:35:22.04,1:35:25.30,Default,,0,0,0,,Соңында! Мен сендермен тең жағдайда күресе аламын!
Dialogue: 0,1:35:25.38,1:35:28.43,Default,,0,0,0,,Бұл екінші гурен рәсімі біздің қарсы шабуылымыз.
Dialogue: 0,1:35:28.51,1:35:29.72,Default,,0,0,0,,Бұл бастама!
Dialogue: 0,1:35:29.80,1:35:32.01,Default,,0,0,0,,Оң қолға бірдеңе дұрыс емес.
Dialogue: 0,1:35:33.10,1:35:34.43,Default,,0,0,0,,Уақытыңызды алғанша!
Dialogue: 0,1:35:35.35,1:35:36.73,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,1:35:41.23,1:35:42.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:35:45.19,1:35:46.03,Default,,0,0,0,,Не!?
Dialogue: 0,1:35:53.62,1:35:55.49,Default,,0,0,0,,Бұл не!?
Dialogue: 0,1:35:55.58,1:35:57.12,Default,,0,0,0,,Еремия сэр, қашыңыз!
Dialogue: 0,1:35:57.20,1:35:59.54,Default,,0,0,0,,Сіз мұны істей аласыз ба? Нөл менің алдымда!
Dialogue: 0,1:36:00.25,1:36:02.13,Default,,0,0,0,,Нөл осында!
Dialogue: 0,1:36:03.00,1:36:05.09,Default,,0,0,0,,Қарғыс атсын, бұл автоматты!
Dialogue: 0,1:36:05.17,1:36:10.26,Default,,0,0,0,,Бұл әлі жұмыс істемейді, мен әлі нөлмін~
Dialogue: 0,1:36:20.23,1:36:22.27,Default,,0,0,0,,Еремия жеңілді ме?
Dialogue: 0,1:36:23.19,1:36:25.32,Default,,0,0,0,,Барлық шарттар жойылды.
Dialogue: 0,1:36:25.40,1:36:27.07,Default,,0,0,0,,Бөлшектердің барлығы орнатылған.
Dialogue: 0,1:36:27.15,1:36:29.99,Default,,0,0,0,,Қарсыластың негізгі базасын тексеру ғана қалды.
Dialogue: 0,1:36:30.53,1:36:31.57,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:32.07,1:36:33.49,Default,,0,0,0,,Біздің әскерге қандай зиян келді?
Dialogue: 0,1:36:33.57,1:36:35.91,Default,,0,0,0,,Сигнал қайтарымы 20%-дан аз
Dialogue: 0,1:36:35.99,1:36:37.29,Default,,0,0,0,,20%!?
Dialogue: 0,1:36:37.37,1:36:39.66,Default,,0,0,0,,Сонда командалар тізбегі орнатылмайды.
Dialogue: 0,1:36:39.75,1:36:43.13,Default,,0,0,0,,Бұл Марсоның бірлігі. Біз генерал Алекспен байланыса алмаймыз.
Dialogue: 0,1:36:43.21,1:36:45.09,Default,,0,0,0,,２…
Dialogue: 0,1:36:45.17,1:36:47.09,Default,,0,0,0,,Ллойд мырза, бұл не!?
Dialogue: 0,1:36:47.17,1:36:51.05,Default,,0,0,0,,Расталмағанымен, нөлдік топтың пайда болғаны туралы да ақпарат бар.
Dialogue: 0,1:36:51.13,1:36:52.26,Default,,0,0,0,,Нөл!?
Dialogue: 0,1:36:54.89,1:36:56.35,Default,,0,0,0,,Губернатор қауіпсіз бе?
Dialogue: 0,1:36:56.43,1:36:58.35,Default,,0,0,0,,Бұл ағынның сыртында, сондықтан ешқандай проблема жоқ.
Dialogue: 0,1:36:58.43,1:37:02.27,Default,,0,0,0,,Алайда, резервті жылжытқанда, ол дерлік оқшауланып қалды.
Dialogue: 0,1:37:02.35,1:37:04.56,Default,,0,0,0,,Не істеп жатырсың, Апельсин!?
Dialogue: 0,1:37:04.65,1:37:06.90,Default,,0,0,0,,Жарайды, Гүрен жоспарланған орнына барады.
Dialogue: 0,1:37:06.98,1:37:09.57,Default,,0,0,0,,Қалғандары осы жерден өтіп, Корнелияны көздейді.
Dialogue: 0,1:37:09.65,1:37:10.53,Default,,0,0,0,,Иә! (жанкүйер) Түсіндім!
Dialogue: 0,1:37:10.61,1:37:11.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:37:11.99,1:37:13.66,Default,,0,0,0,,Мен бұл жерді өлгенше қорғаймын.
Dialogue: 0,1:37:14.16,1:37:15.20,Default,,0,0,0,,Уау!?
Dialogue: 0,1:37:16.62,1:37:18.54,Default,,0,0,0,,Сугияма тірі ме?
Dialogue: 0,1:37:18.62,1:37:20.04,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,1:37:20.12,1:37:20.96,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:22.46,1:37:24.04,Default,,0,0,0,,Ууууууууууууу~
Dialogue: 0,1:37:24.12,1:37:25.54,Default,,0,0,0,,Қат! Жаса!
Dialogue: 0,1:37:25.63,1:37:27.55,Default,,0,0,0,,Таза қандылар ұстап тұр ма?
Dialogue: 0,1:37:27.63,1:37:29.17,Default,,0,0,0,,Иә, лорд Виллетаның басшылығымен...
Dialogue: 0,1:37:29.26,1:37:32.30,Default,,0,0,0,,Олай болса, губернатордың шегінетін уақыты келді.
Dialogue: 0,1:37:32.38,1:37:34.05,Default,,0,0,0,,Әуе күштерінің қолдауын күтіңіз (Эвфемия)!
Dialogue: 0,1:37:34.13,1:37:37.10,Default,,0,0,0,,Губернатордың артында бір нәрсе келе жатыр.
Dialogue: 0,1:37:37.18,1:37:38.93,Default,,0,0,0,,Әрбір машина дайын ба?
Dialogue: 0,1:37:39.01,1:37:39.85,Default,,0,0,0,,Иә
Dialogue: 0,1:37:39.93,1:37:41.81,Default,,0,0,0,,Жарайды, Бурай Кай, кел
Dialogue: 0,1:37:41.89,1:37:43.35,Default,,0,0,0,,Кету
Dialogue: 0,1:37:43.98,1:37:46.73,Default,,0,0,0,,Тыңдаңыздар, егер бұл көшкін жасанды болса.
Dialogue: 0,1:37:46.81,1:37:49.86,Default,,0,0,0,,Біз Корнелияны арқасынан ұруымыз керек.
Dialogue: 0,1:37:49.94,1:37:51.57,Default,,0,0,0,,Корнелияны түсіру
Dialogue: 0,1:37:51.65,1:37:54.24,Default,,0,0,0,,Енді 7 жыл бұрынғы қарызды қайтаратын кез!
Dialogue: 0,1:37:54.32,1:37:57.49,Default,,0,0,0,,Иә, төрт қасиетті қылышымыздың мақтанышы!
Dialogue: 0,1:37:57.58,1:37:58.70,Default,,0,0,0,,Не!
Dialogue: 0,1:37:59.20,1:38:00.79,Default,,0,0,0,,Мәртебесін қорға!
Dialogue: 0,1:38:05.12,1:38:06.46,Default,,0,0,0,,Оны қоршаңыз!
Dialogue: 0,1:38:06.54,1:38:08.29,Default,,0,0,0,,Жапонияны азат ету майданы!?
Dialogue: 0,1:38:08.92,1:38:10.38,Default,,0,0,0,,Slashing Siege
Dialogue: 0,1:38:10.46,1:38:11.51,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,1:38:13.59,1:38:15.51,Default,,0,0,0,,Мені жай ғана бәйбіше деп ойламаңыз.
Dialogue: 0,1:38:15.59,1:38:17.72,Default,,0,0,0,,Жеті жыл бұрын есімде.
Dialogue: 0,1:38:17.80,1:38:19.56,Default,,0,0,0,,Ол кездегіден басқаша.
Dialogue: 0,1:38:19.64,1:38:21.64,Default,,0,0,0,,Мұнда да қорқынышты түс бар.
Dialogue: 0,1:38:21.72,1:38:25.23,Default,,0,0,0,,Мәртебелі, мұны бізге қалдырыңыз және әзірге қалдырыңыз.
Dialogue: 0,1:38:27.02,1:38:29.40,Default,,0,0,0,,Жарайды, онда мен оны пайдаланамын.
Dialogue: 0,1:38:29.48,1:38:30.94,Default,,0,0,0,,Гилфорд (Гильфорд) Ха!
Dialogue: 0,1:38:31.03,1:38:33.78,Default,,0,0,0,,Пышақтарды кесіп өткеннен кейін 9-тармаққа келіңіз.
Dialogue: 0,1:38:33.86,1:38:35.24,Default,,0,0,0,,9…
Dialogue: 0,1:38:35.32,1:38:36.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:38:36.61,1:38:39.20,Default,,0,0,0,,Жақсы! Тек нөлді шегелеңіз!
Dialogue: 0,1:38:39.28,1:38:41.91,Default,,0,0,0,,Сәлем! Мен Кареннің қайтып келгенін қалаймын.
Dialogue: 0,1:38:41.99,1:38:45.12,Default,,0,0,0,,Жоқ! Орналасуды қазір өзгертсеңіз, стратегия бұзылады.
Dialogue: 0,1:38:45.71,1:38:47.08,Default,,0,0,0,,Бірақ бұл жаман.
Dialogue: 0,1:38:47.17,1:38:50.04,Default,,0,0,0,,Осы қарқынмен біз тіпті SS-пен күресуге тура келеді...
Dialogue: 0,1:38:50.13,1:38:52.84,Default,,0,0,0,,Нөл: Корнелияға төменнен шабуыл жасалды!
Dialogue: 0,1:38:52.92,1:38:54.67,Default,,0,0,0,,Не? Қай команда көшті?
Dialogue: 0,1:38:54.76,1:38:57.05,Default,,0,0,0,,Шамасы, бұл біз емес, азаттық майданы.
Dialogue: 0,1:38:57.13,1:39:01.26,Default,,0,0,0,,Хе, менің мақсатымды біреу оқыды ма... Бұл өте жақсы.
Dialogue: 0,1:39:01.35,1:39:04.02,Default,,0,0,0,,Сонда олар СС-ті тоқтата алуы керек!
Dialogue: 0,1:39:04.60,1:39:06.44,Default,,0,0,0,,Жоғары мәртебелі, генерал-майор! Кеш болды
Dialogue: 0,1:39:06.52,1:39:08.44,Default,,0,0,0,,Тодо, мен сені күттім.
Dialogue: 0,1:39:08.52,1:39:11.69,Default,,0,0,0,,Жоғары мәртебелі, барлық күштеріңізді осында орналастырыңыз.
Dialogue: 0,1:39:11.77,1:39:13.40,Default,,0,0,0,,Біз жеңе аламыз ба?оларға
Dialogue: 0,1:39:13.48,1:39:15.86,Default,,0,0,0,,Британияның негізгі күшін тоқтату арқылы жеңуге болады.
Dialogue: 0,1:39:15.95,1:39:17.95,Default,,0,0,0,,Енді сіздің мүмкіндігіңіз!
Dialogue: 0,1:39:18.03,1:39:19.82,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,1:39:19.91,1:39:21.91,Default,,0,0,0,,Сәлем! Осындай кездерде!
Dialogue: 0,1:39:21.99,1:39:22.95,Default,,0,0,0,,Сіз не істейсіз!?
Dialogue: 0,1:39:23.04,1:39:24.04,Default,,0,0,0,,Трансфер!
Dialogue: 0,1:39:24.12,1:39:26.87,Default,,0,0,0,,Қандай жағдай болмасын, мен губернатор Корнелиямен қосыламын.
Dialogue: 0,1:39:26.96,1:39:29.00,Default,,0,0,0,,Бірақ дұшпанның тірегі дәл көз алдымызда.
Dialogue: 0,1:39:29.08,1:39:31.92,Default,,0,0,0,,Сондай-ақ, артыңыздан шабуыл жасалса, сізге қатты зақым келеді.
Dialogue: 0,1:39:32.00,1:39:34.25,Default,,0,0,0,,Ақымақ! Егер сіз ханшайымыңызды жоғалтсаңыз
Dialogue: 0,1:39:34.34,1:39:36.59,Default,,0,0,0,,Бұл шайқастың өзі аяқталады!
Dialogue: 0,1:39:36.67,1:39:37.63,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,1:39:37.72,1:39:39.34,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:39:40.93,1:39:42.97,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,1:39:44.85,1:39:45.68,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,1:39:47.35,1:39:49.81,Default,,0,0,0,,Сіз не істейсіз, Корнелия командирі?
Dialogue: 0,1:39:49.90,1:39:52.90,Default,,0,0,0,,Нөл күткендей болса, ол әрекет жасауы керек еді.
Dialogue: 0,1:39:52.98,1:39:54.86,Default,,0,0,0,,Бұл жерде оған сенуден басқа амалым жоқ!
Dialogue: 0,1:39:55.44,1:39:57.36,Default,,0,0,0,,Не?Zero аударылды ма?
Dialogue: 0,1:39:57.44,1:40:00.78,Default,,0,0,0,,Иә, біз сізге қолдау көрсетуді жалғастырамыз.
Dialogue: 0,1:40:00.86,1:40:03.37,Default,,0,0,0,,Бұл нөлге ұқсайды!Орналасқан жеріңіз туралы ақпаратты жіберіңіз!
Dialogue: 0,1:40:03.45,1:40:04.79,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,1:40:04.87,1:40:07.08,Default,,0,0,0,,Бұл Нөлдердің болжамды бағыты.
Dialogue: 0,1:40:07.16,1:40:08.12,Default,,0,0,0,,Жаман!
Dialogue: 0,1:40:08.21,1:40:11.42,Default,,0,0,0,,Нөл тобы Тодо мен оның достарын тартуы керек жерде!
Dialogue: 0,1:40:11.50,1:40:13.63,Default,,0,0,0,,Мәртебелі Корнелия!
Dialogue: 0,1:40:14.67,1:40:17.26,Default,,0,0,0,,Мен сізді тыңдаймын, Гилфорд.
Dialogue: 0,1:40:18.38,1:40:20.01,Default,,0,0,0,,Лейтенант губернатор Эфемия
Dialogue: 0,1:40:20.09,1:40:22.34,Default,,0,0,0,,Осы G1-ге губернаторға кіруге рұқсат етіңіз ...
Dialogue: 0,1:40:22.43,1:40:23.35,Default,,0,0,0,,Жоқ
Dialogue: 0,1:40:23.43,1:40:24.35,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:40:24.43,1:40:26.47,Default,,0,0,0,,Бұл капитан Гилфордтың да қозғала алмайтынын білдіреді.
Dialogue: 0,1:40:26.56,1:40:28.10,Default,,0,0,0,,Губернатор Корнелияның бұйрықтары
Dialogue: 0,1:40:28.18,1:40:29.35,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:40:29.44,1:40:32.35,Default,,0,0,0,,Далалық аурухана да осында орналасқан.
Dialogue: 0,1:40:32.44,1:40:35.07,Default,,0,0,0,,Маңайдағы кейбір тұрғындар эвакуацияланды.
Dialogue: 0,1:40:35.15,1:40:38.65,Default,,0,0,0,,Ал бұл G1 негізі штабтың символы болып табылады.
Dialogue: 0,1:40:38.74,1:40:41.66,Default,,0,0,0,,«Ештеңеге қарамастан қозғалма» - губернатордың қатаң бұйрығы
Dialogue: 0,1:40:41.74,1:40:43.45,Default,,0,0,0,,Сондықтан... Сондықтан...
Dialogue: 0,1:40:44.91,1:40:49.46,Default,,0,0,0,,Сәлеметсіз бе, бұл арнайы диспетчерлік нұсқаулық технологиясы бөлімі.
Dialogue: 0,1:40:49.54,1:40:50.58,Default,,0,0,0,,Дөрекі!
Dialogue: 0,1:40:50.66,1:40:53.42,Default,,0,0,0,,Әскери қызметте жүрген тәртіпсіздер тыныш болсын!
Dialogue: 0,1:40:53.50,1:40:56.00,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,1:40:56.09,1:40:58.84,Default,,0,0,0,,Саған рахмет, мен қиыншылыққа ұшырадым. Менің ішім пысты.
Dialogue: 0,1:40:58.92,1:41:00.13,Default,,0,0,0,,Ах
Dialogue: 0,1:41:00.22,1:41:02.76,Default,,0,0,0,,Губернатордың орынбасары Эфемия, өтінемін.
Dialogue: 0,1:41:02.84,1:41:05.55,Default,,0,0,0,,Корреспондентке бұйрық беру
Dialogue: 0,1:41:05.64,1:41:06.56,Default,,0,0,0,,Корнелия!
Dialogue: 0,1:41:07.18,1:41:08.47,Default,,0,0,0,,Төменгі түр болудың алдында тұр!
Dialogue: 0,1:41:12.27,1:41:16.36,Default,,0,0,0,,Не? Бұл жай ғана арнайы машина сияқты емес...
Dialogue: 0,1:41:19.11,1:41:21.53,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба? Корнелия.
Dialogue: 0,1:41:21.61,1:41:23.32,Default,,0,0,0,,Қазірдің өзінде мат
Dialogue: 0,1:41:23.41,1:41:24.32,Default,,0,0,0,,Нөл!?
Dialogue: 0,1:41:24.41,1:41:27.24,Default,,0,0,0,,А, біз кездесуімізді тойлауымыз керек пе?
Dialogue: 0,1:41:27.33,1:41:31.50,Default,,0,0,0,,Бірақ бұған дейін бізге бағынуыңызды қалаймыз.
Dialogue: 0,1:41:31.58,1:41:33.58,Default,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді.
Dialogue: 0,1:41:35.04,1:41:37.34,Default,,0,0,0,,Айтпақшы, күшейтулер уақытында келмейді.
Dialogue: 0,1:41:37.42,1:41:40.38,Default,,0,0,0,,Бұл менің жеңісім, Корнелия.
Dialogue: 0,1:41:41.76,1:41:43.43,Default,,0,0,0,,Ақымақ немесе нөл
Dialogue: 0,1:41:43.51,1:41:44.59,Default,,0,0,0,,Тіпті бұл жігіт!
Dialogue: 0,1:41:45.18,1:41:48.18,Default,,0,0,0,,Бұл жігітті жеңгенше, шығудың жолы ашық болады!
Dialogue: 0,1:41:51.56,1:41:52.98,Default,,0,0,0,,Қандай епті жігіт!
Dialogue: 0,1:41:58.73,1:41:59.94,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:42:04.03,1:42:06.37,Default,,0,0,0,,Қорқақ!Артынан ату!
Dialogue: 0,1:42:06.45,1:42:10.62,Default,,0,0,0,,Сонымен, сіздің стратегияңыз қорқақ емес пе?
Dialogue: 0,1:42:13.25,1:42:16.67,Default,,0,0,0,,Қарғыс атқыр... Өзіңізді дайындамас бұрын қысқыш шабуыл деген не?
Dialogue: 0,1:42:16.75,1:42:19.59,Default,,0,0,0,,Енді мен ханшайымға бара алмаймын...
Dialogue: 0,1:42:20.92,1:42:21.80,Default,,0,0,0,,Вааах!
Dialogue: 0,1:42:25.38,1:42:27.85,Default,,0,0,0,,Подполковник Жаудың қосымша күштеріне соққы берілді.
Dialogue: 0,1:42:27.93,1:42:30.93,Default,,0,0,0,,Жарайды, айналмалы белсенді формацияға ауысыңыз.
Dialogue: 0,1:42:31.01,1:42:31.97,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,1:42:33.27,1:42:36.23,Default,,0,0,0,,Иә, егер жағдай осылай жалғаса берсе, Мәртебелі Корнелия...
Dialogue: 0,1:42:36.31,1:42:37.77,Default,,0,0,0,,Гилдфорд
Dialogue: 0,1:42:38.40,1:42:40.57,Default,,0,0,0,,Менің рыцарь Гилфорд.
Dialogue: 0,1:42:40.65,1:42:43.19,Default,,0,0,0,,Мен Юффиге Далтонмен көмектесуіңізді қалаймын.
Dialogue: 0,1:42:43.28,1:42:44.32,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,1:42:44.40,1:42:46.66,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,1:42:46.74,1:42:49.24,Default,,0,0,0,,Ханшайым ретінде мен тек соңына дейін күресемін!
Dialogue: 0,1:42:50.16,1:42:52.29,Default,,0,0,0,,Құрметті Корнелия!
Dialogue: 0,1:42:52.37,1:42:54.96,Default,,0,0,0,,Хун, қызықсыз таңдау...
Dialogue: 0,1:42:55.04,1:42:56.67,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:43:03.26,1:43:04.30,Default,,0,0,0,,Уау
Dialogue: 0,1:43:04.38,1:43:06.22,Default,,0,0,0,,Әдеттегідей тым әбігер болмаңыз
Dialogue: 0,1:43:06.30,1:43:09.43,Default,,0,0,0,,Валис арамыздағы кедергілерден қалай өте алады?
Dialogue: 0,1:43:12.85,1:43:13.72,Default,,0,0,0,,Губернатор
Dialogue: 0,1:43:13.81,1:43:16.31,Default,,0,0,0,,Амансың ба? Біз сізге көмекке келдік.
Dialogue: 0,1:43:16.39,1:43:18.81,Default,,0,0,0,,Корреспондент туралы не деуге болады? Кімнің рұқсатымен...
Dialogue: 0,1:43:18.90,1:43:21.19,Default,,0,0,0,,Ей, болмайды, бұл түнгі түн...
Dialogue: 0,1:43:21.27,1:43:23.36,Default,,0,0,0,,Ах, жаңа Британия.
Dialogue: 0,1:43:23.44,1:43:26.15,Default,,0,0,0,,Бұл тағы да сол жігіт...
Dialogue: 0,1:43:27.28,1:43:29.03,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:43:29.11,1:43:33.29,Default,,0,0,0,,Гуреннің екінші түрі үшін Широ Кабутоны жойыңыз. Бұл жігіттің серпінді күші кедергі.
Dialogue: 0,1:43:33.37,1:43:34.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:43:42.00,1:43:45.26,Default,,0,0,0,,Мен мұны сізге қалдырамын, мен нөлге жетемін!
Dialogue: 0,1:43:47.13,1:43:48.80,Default,,0,0,0,,Синдзюкудың қарызы осында!
Dialogue: 0,1:43:52.05,1:43:54.26,Default,,0,0,0,,Жоқ... ол Ланселот сияқты жылдам ма?
Dialogue: 0,1:43:56.81,1:43:58.14,Default,,0,0,0,,Осы жігітті жеңе алсам ғой!
Dialogue: 0,1:44:07.36,1:44:08.78,Default,,0,0,0,,Мұндай қару!
Dialogue: 0,1:44:18.37,1:44:19.21,Default,,0,0,0,,Тоқтады!?
Dialogue: 0,1:44:22.21,1:44:23.63,Default,,0,0,0,,Уау!
Dialogue: 0,1:44:29.88,1:44:31.39,Default,,0,0,0,,Эй, жақсысың ба!?
Dialogue: 0,1:44:31.47,1:44:32.59,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,1:44:32.68,1:44:34.51,Default,,0,0,0,,Оуги Гурен ше?
Dialogue: 0,1:44:34.60,1:44:36.56,Default,,0,0,0,,Менің оң қолым зақымдалған. Мен оны жөндеуім керек ...
Dialogue: 0,1:44:36.64,1:44:39.39,Default,,0,0,0,,Кууууууу... Мен тартамын!
Dialogue: 0,1:44:39.48,1:44:40.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:40.39,1:44:42.60,Default,,0,0,0,,Барлық әскерлерді қашу нүктесіне жылжытыңыз.
Dialogue: 0,1:44:42.69,1:44:45.57,Default,,0,0,0,,Әрі қарай тозған соғыс, шегіну болады.
Dialogue: 0,1:44:49.24,1:44:50.11,Default,,0,0,0,,Губернатор!
Dialogue: 0,1:44:50.20,1:44:51.36,Default,,0,0,0,,Сіз нөлді қууыңыз керек!
Dialogue: 0,1:44:51.45,1:44:52.28,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:44:52.36,1:44:54.49,Default,,0,0,0,,Сізде қуат толтырғыш таусылды. Бар!
Dialogue: 0,1:44:54.57,1:44:55.62,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,1:44:58.20,1:45:00.83,Default,,0,0,0,,Эй, сен кері тарта алатыныңа сенімдісің бе?
Dialogue: 0,1:45:00.91,1:45:03.58,Default,,0,0,0,,Жеңгеніміз рас, енді болмайды...
Dialogue: 0,1:45:03.67,1:45:07.38,Default,,0,0,0,,Сонда Жапонияны азат ету майданын алаяқ ретінде пайдаланып, қашудан басқа амалымыз жоқ па?
Dialogue: 0,1:45:07.96,1:45:09.80,Default,,0,0,0,,Мен бұлай айтқанды жек көремін, бірақ...
Dialogue: 0,1:45:10.38,1:45:13.80,Default,,0,0,0,,Ой, адам ойында пешка емес.
Dialogue: 0,1:45:14.72,1:45:17.51,Default,,0,0,0,,Тіпті Нөл бұл туралы ойламаған болар еді.
Dialogue: 0,1:45:17.60,1:45:20.48,Default,,0,0,0,,Олай болмаса, біз тек пешка болып қаламыз
Dialogue: 0,1:45:20.56,1:45:22.60,Default,,0,0,0,,Сіз қолданыласыз.
Dialogue: 0,1:45:22.69,1:45:23.81,Default,,0,0,0,,Бірақ бұл мүмкін емес
Dialogue: 0,1:45:24.44,1:45:27.27,Default,,0,0,0,,Оның Британияға деген ашуы шынайы.
Dialogue: 0,1:45:27.77,1:45:31.78,Default,,0,0,0,,Ашуды білетін адамдар қайғыны да білуі керек.
Dialogue: 0,1:45:34.03,1:45:35.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:36.12,1:45:37.83,Default,,0,0,0,,Корреспондентке
Dialogue: 0,1:45:37.91,1:45:40.54,Default,,0,0,0,,Нөлді тапты және енді оны қорғайды
Dialogue: 0,1:45:41.46,1:45:44.12,Default,,0,0,0,,Ха!? А... ол ше?
Dialogue: 0,1:45:44.71,1:45:46.67,Default,,0,0,0,,Жоқ Синджуку...
Dialogue: 0,1:45:46.75,1:45:47.79,Default,,0,0,0,,Капсула?
Dialogue: 0,1:45:47.88,1:45:51.01,Default,,0,0,0,,Тоқта, мына кісіге тиіспе.
Dialogue: 0,1:45:53.80,1:45:56.68,Default,,0,0,0,,Эй, сен не істеуді жоспарлап отырсың? Қарсылас - Nightmare.
Dialogue: 0,1:45:57.68,1:45:59.85,Default,,0,0,0,,Мен сенің өлгеніңді қаламас едім.
Dialogue: 0,1:45:59.93,1:46:03.10,Default,,0,0,0,,Жанама байланыс, бірақ тырысуға тұрарлық
Dialogue: 0,1:46:04.48,1:46:06.65,Default,,0,0,0,,Ха! А, а?
Dialogue: 0,1:46:16.53,1:46:17.41,Default,,0,0,0,,А...
Dialogue: 0,1:46:20.62,1:46:22.58,Default,,0,0,0,,Әке? Бұл өтірік...
Dialogue: 0,1:46:23.12,1:46:25.46,Default,,0,0,0,,Ол өлуі керек еді...
Dialogue: 0,1:46:28.92,1:46:31.38,Default,,0,0,0,,Эй, ұшқышта Геас болды ма?
Dialogue: 0,1:46:31.46,1:46:33.88,Default,,0,0,0,,Мен сізге таң қалдыратын суретті көрсетіп отырмын.
Dialogue: 0,1:46:33.97,1:46:36.05,Default,,0,0,0,,Мен не қарап тұрғанымды білмеймін.
Dialogue: 0,1:46:36.13,1:46:38.18,Default,,0,0,0,,Қазір қашып кеткен жөн.
Dialogue: 0,1:46:38.26,1:46:39.68,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,1:46:39.76,1:46:41.47,Default,,0,0,0,,Сізге әлі де қарыз
Dialogue: 0,1:46:42.60,1:46:44.73,Default,,0,0,0,,Ха! Енді тоқтат!
Dialogue: 0,1:46:44.81,1:46:45.94,Default,,0,0,0,,Уф
Dialogue: 0,1:46:46.52,1:46:48.19,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:46:55.78,1:46:58.49,Default,,0,0,0,,Не... бұрынғыдан өзгеше.
Dialogue: 0,1:47:06.04,1:47:07.37,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,1:47:07.58,1:47:09.54,Default,,0,0,0,,Тоқта...
Dialogue: 0,1:47:09.79,1:47:12.25,Default,,0,0,0,,Маған кірме
Dialogue: 0,1:47:12.34,1:47:13.80,Default,,0,0,0,,Тоқта
Dialogue: 0,1:47:14.26,1:47:15.55,Default,,0,0,0,,Неге...
Dialogue: 0,1:47:16.13,1:47:17.84,Default,,0,0,0,,Уф...
Dialogue: 0,1:47:18.64,1:47:20.51,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,1:47:20.60,1:47:22.35,Default,,0,0,0,,Ашылған…
Dialogue: 0,1:47:32.23,1:47:35.19,Default,,0,0,0,,Менің мұны істеуден басқа амалым болмады!
Dialogue: 0,1:47:44.16,1:47:45.08,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,1:47:45.16,1:47:46.00,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,1:47:50.88,1:47:51.96,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,1:47:52.04,1:47:53.30,Default,,0,0,0,,Ақымақ, қазір қаш!
Dialogue: 0,1:47:53.38,1:47:56.42,Default,,0,0,0,,Уф! Уф... С.С.!
Dialogue: 0,1:47:57.72,1:48:00.14,Default,,0,0,0,,Тез қаш!
Dialogue: 0,1:48:00.22,1:48:01.80,Default,,0,0,0,,Уф!
Dialogue: 0,1:48:02.89,1:48:04.76,Default,,0,0,0,,Мәртебелі!Мен қазір келемін!
Dialogue: 0,1:48:04.85,1:48:07.39,Default,,0,0,0,,Гилфорд, барлық әскерге айт.
Dialogue: 0,1:48:07.48,1:48:08.56,Default,,0,0,0,,Шығаруға дайындық
Dialogue: 0,1:48:08.64,1:48:09.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:09.56,1:48:13.23,Default,,0,0,0,,Енді біздің сарбаздарымыздың өмірін қатерге тігуге негіз жоқ.
Dialogue: 0,1:48:13.32,1:48:16.86,Default,,0,0,0,,Жауынгерлік күйді сақтай отырып, баяу шегініңіз
Dialogue: 0,1:48:18.11,1:48:21.95,Default,,0,0,0,,Мойындауымыз керек, бұл жолы жеңіліп қалдық.
Dialogue: 0,1:48:22.03,1:48:25.70,Default,,0,0,0,,Иә!
Dialogue: 0,1:48:25.79,1:48:27.08,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:48:27.16,1:48:29.41,Default,,0,0,0,,Британия тек Азаттық майданымен айналысады.
Dialogue: 0,1:48:29.50,1:48:30.67,Default,,0,0,0,,лоттар мен лоттар
Dialogue: 0,1:48:30.75,1:48:34.59,Default,,0,0,0,,А, әрине, біз құтылу үшін бос орын болды, бірақ...
Dialogue: 0,1:48:34.67,1:48:36.25,Default,,0,0,0,,Эй, Нөл туралы ше?
Dialogue: 0,1:48:36.84,1:48:38.47,Default,,0,0,0,,Мен Бураймен қосыла алмаймын...
Dialogue: 0,1:48:39.13,1:48:41.18,Default,,0,0,0,,Мен оның ұсталғанына сене алмадым...
Dialogue: 0,1:48:44.72,1:48:48.48,Default,,0,0,0,,Бұл әйел адам емес пе?
Dialogue: 0,1:48:48.56,1:48:50.89,Default,,0,0,0,,Жараның қалпына келу жылдамдығы әдеттен тыс.
Dialogue: 0,1:48:50.98,1:48:54.15,Default,,0,0,0,,Синдзюку міндетті түрде маңдайына оқ тиді...
Dialogue: 0,1:48:54.23,1:48:56.36,Default,,0,0,0,,Өйткені Хловис өз бетімен зерттеу жүргізді.
Dialogue: 0,1:48:56.44,1:48:58.69,Default,,0,0,0,,Оның Британияға еш қатысы болмауы керек, бірақ...
Dialogue: 0,1:48:58.78,1:49:00.53,Default,,0,0,0,,Өмірлік заттар адамдармен бірдей
Dialogue: 0,1:49:00.61,1:49:02.95,Default,,0,0,0,,Қан үлгісі кейінірек зерттеледі.
Dialogue: 0,1:49:03.03,1:49:05.28,Default,,0,0,0,,Жараны да суретке түсіру керек пе?
Dialogue: 0,1:49:05.78,1:49:06.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:09.91,1:49:10.75,Default,,0,0,0,,Не?
Dialogue: 0,1:49:15.34,1:49:16.75,Default,,0,0,0,,Ха!
Dialogue: 0,1:49:17.50,1:49:21.09,Default,,0,0,0,,Ақыры менің атымды атадың.
Dialogue: 0,1:49:21.17,1:49:24.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:49:26.85,1:49:29.93,Default,,0,0,0,,Соңында нөл түсірілмей қалады.
Dialogue: 0,1:49:30.02,1:49:33.60,Default,,0,0,0,,Жапон азаттық майданы қорғаныс шебін жоғары көтеріп келеді.
Dialogue: 0,1:49:33.69,1:49:35.19,Default,,0,0,0,,Мен оның ішінде адасып қалдым деп ойлаймын.
Dialogue: 0,1:49:35.27,1:49:38.44,Default,,0,0,0,,Маған ұнамайды. Мен әрқашан өзімді қорғау үшін бір нәрсені қалқан ретінде қолданамын.
Dialogue: 0,1:49:39.07,1:49:40.82,Default,,0,0,0,,Сонымен, Куруругиге не болды?
Dialogue: 0,1:49:40.90,1:49:42.28,Default,,0,0,0,,Ол жиналды.
Dialogue: 0,1:49:42.36,1:49:44.95,Default,,0,0,0,,Өйткені мен қуат толтырғыштың бітуін және тоқтағанын күттім.
Dialogue: 0,1:49:45.03,1:49:46.58,Default,,0,0,0,,Біраз уақыт қажет болды, бірақ
Dialogue: 0,1:49:46.66,1:49:47.99,Default,,0,0,0,,Күту дегенді қалай түсінесіңдер?
Dialogue: 0,1:49:48.08,1:49:49.33,Default,,0,0,0,,Бұл ұшақта ақау бар ма?
Dialogue: 0,1:49:49.41,1:49:53.54,Default,,0,0,0,,Мүмкін, өйткені ол бақылаудан шығып кеткен сияқты.
Dialogue: 0,1:49:53.62,1:49:56.25,Default,,0,0,0,,Бұл менің ағамның бөлімшесіне сәйкес келмейтін өрескел қателік.
Dialogue: 0,1:50:00.26,1:50:03.09,Default,,0,0,0,,Мен сынықтарды алып, жараны жудым.
Dialogue: 0,1:50:03.17,1:50:04.63,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,1:50:04.72,1:50:06.05,Default,,0,0,0,,Олардың тәрбиесіне байланысты
Dialogue: 0,1:50:06.14,1:50:08.97,Default,,0,0,0,,Сондықтан маған көмектесудің еш мәні жоқ еді.
Dialogue: 0,1:50:09.06,1:50:12.39,Default,,0,0,0,,Көңілсіз жерлерде сіз әрқашан мақтанышыңызды сақтайсыз
Dialogue: 0,1:50:12.48,1:50:13.52,Default,,0,0,0,,Уф
Dialogue: 0,1:50:14.64,1:50:16.86,Default,,0,0,0,,Сіздің арқаңызда мен жақсы нәрсе үйрендім.
Dialogue: 0,1:50:17.36,1:50:18.27,Default,,0,0,0,,Хун
Dialogue: 0,1:50:19.94,1:50:20.82,Default,,0,0,0,,Ха!
Dialogue: 0,1:50:20.90,1:50:22.69,Default,,0,0,0,,Бұл сіздің атыңыз ба?
Dialogue: 0,1:50:23.24,1:50:26.07,Default,,0,0,0,,Тыңдау - жағымсыз дәм.
Dialogue: 0,1:50:26.16,1:50:30.16,Default,,0,0,0,,Бұл жақсы есім емес пе? C.C.-ге қарағанда адамға әлдеқайда ұқсас.
Dialogue: 0,1:50:30.24,1:50:33.87,Default,,0,0,0,,Менде адамдық бар екені күлкілі...
Dialogue: 0,1:50:34.83,1:50:36.67,Default,,0,0,0,,Қалай болғанда да, мен...
Dialogue: 0,1:50:36.75,1:50:38.00,Default,,0,0,0,,Маған...
Dialogue: 0,1:50:38.08,1:50:39.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:39.71,1:50:41.84,Default,,0,0,0,,Мен бәрін ұмыттым...
Dialogue: 0,1:50:42.46,1:50:44.05,Default,,0,0,0,,Барлығы
Dialogue: 0,1:50:44.76,1:50:46.59,Default,,0,0,0,,Қазір есімнің қандай екенін білмеймін...
Dialogue: 0,1:50:47.22,1:50:49.10,Default,,0,0,0,,… …
Dialogue: 0,1:50:54.73,1:50:56.94,Default,,0,0,0,,Бұл жақсы мүмкіндік, сондықтан мен сізге айтайын.
Dialogue: 0,1:50:57.60,1:50:59.94,Default,,0,0,0,,Мм... Мен ертерек құтқарылдым.
Dialogue: 0,1:51:00.98,1:51:05.40,Default,,0,0,0,,Осы уақытқа дейін, сондай-ақ Геасс туралы
Dialogue: 0,1:51:05.99,1:51:07.07,Default,,0,0,0,,Сонымен
Dialogue: 0,1:51:08.70,1:51:10.49,Default,,0,0,0,,Мен мұны тек бір рет айтамын
Dialogue: 0,1:51:12.83,1:51:13.66,Default,,0,0,0,,Рахмет
Dialogue: 0,1:51:16.33,1:51:19.42,Default,,0,0,0,,Бірінші рет алғыс айтуым.
Dialogue: 0,1:51:20.75,1:51:23.34,Default,,0,0,0,,Енді алғысымды қайтарғанымды қалайсың ба?
Dialogue: 0,1:51:23.42,1:51:24.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:51:24.63,1:51:27.43,Default,,0,0,0,,Маған бұрынғыдай қайта қоңырау шалыңыз.
Dialogue: 0,1:51:27.51,1:51:28.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:51:28.55,1:51:30.35,Default,,0,0,0,,А, бұл есім?
Dialogue: 0,1:51:30.43,1:51:31.89,Default,,0,0,0,,Тек бір рет
Dialogue: 0,1:51:31.97,1:51:35.02,Default,,0,0,0,,Қадірлеңіз, мейірімді және шын жүректен болыңыз.
Dialogue: 0,1:51:37.35,1:51:38.77,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,1:51:48.28,1:51:49.78,Default,,0,0,0,,О, Құдай-ай, сен қатты жалықтырасың!
Dialogue: 0,1:51:49.86,1:51:52.45,Default,,0,0,0,,Жоқ, мүлде жоқ.
Dialogue: 0,1:51:52.53,1:51:56.16,Default,,0,0,0,,Мейірімділік, адалдық, жанашырлық жеткіліксіз
Dialogue: 0,1:51:56.25,1:52:00.08,Default,,0,0,0,,Айтылуы күмәнді, ең бастысы, оған жылулық жетіспейді.
Dialogue: 0,1:52:00.17,1:52:02.00,Default,,0,0,0,,Ол өзімшіл әйел.
Dialogue: 0,1:52:02.09,1:52:05.80,Default,,0,0,0,,Ал, мен C.C.
Dialogue: 0,1:52:12.68,1:52:15.01,Default,,0,0,0,,(Кенет тежеу дыбысы)
Dialogue: 0,1:52:15.10,1:52:17.35,Default,,0,0,0,,Tsk! Сіз қайтадан солдатсыз ба?
Dialogue: 0,1:52:17.43,1:52:20.06,Default,,0,0,0,,Бұл құрылғының құлағанын білдіреді.
Dialogue: 0,1:52:18.02,1:52:20.06,Default,,0,0,0,,
Dialogue: 0,1:52:20.77,1:52:22.98,Default,,0,0,0,,Бұл қызғылт сары емес.
Dialogue: 0,1:52:23.86,1:52:25.48,Default,,0,0,0,,Нөл
Dialogue: 0,1:52:33.87,1:52:35.37,Default,,0,0,0,,Біреу сені алып кетуге келген сияқты.
Dialogue: 0,1:52:36.62,1:52:39.96,Default,,0,0,0,,Нөл! Жарайды? Басқа мүшелер алдымен...
Dialogue: 0,1:52:40.04,1:52:41.62,Default,,0,0,0,,Ах... кім!?
Dialogue: 0,1:52:42.21,1:52:44.63,Default,,0,0,0,,О, уайымдама
Dialogue: 0,1:52:44.71,1:52:47.55,Default,,0,0,0,,Ол менің маңызды серігім.
Dialogue: 0,1:52:47.63,1:52:48.84,Default,,0,0,0,,А...
Dialogue: 0,1:52:57.64,1:53:00.27,Default,,0,0,0,,Жапон азаттық майданы жойылды
Dialogue: 0,1:53:00.35,1:53:04.06,Default,,0,0,0,,Корнелия күштерінің қайсысы сізге аман қалуға мүмкіндік бермейді...
Dialogue: 0,1:53:04.15,1:53:05.19,Default,,0,0,0,,Күтіңіз
Dialogue: 0,1:53:05.27,1:53:08.19,Default,,0,0,0,,Ол қашып жүрсе де, Тодо әлі тірі, жақсы.
Dialogue: 0,1:53:08.32,1:53:12.07,Default,,0,0,0,,Дегенмен Бурай Кайдың да адасып кеткенін естідім.
Dialogue: 0,1:53:12.16,1:53:14.12,Default,,0,0,0,,Енді үміт жоқ...
Dialogue: 0,1:53:14.20,1:53:16.70,Default,,0,0,0,,Иә, қаласаңыз.
Dialogue: 0,1:53:16.79,1:53:18.20,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,1:53:18.79,1:53:20.33,Default,,0,0,0,,Гурен 2-ші Шикиге де солай.
Dialogue: 0,1:53:20.41,1:53:24.50,Default,,0,0,0,,Сузаку Куруругиді құтқару оқиғасынан бері ол Нөлге әуес болған сияқты.
Dialogue: 0,1:53:26.42,1:53:31.17,Default,,0,0,0,,Жапон азаттық майданы губернатордың стратегиясымен жойылуға жақын қалды.
Dialogue: 0,1:53:31.26,1:53:34.14,Default,,0,0,0,,Қашып жүрген мүшелер бірінен соң бірі тұтқынға алынуда.
Dialogue: 0,1:53:34.72,1:53:35.97,Default,,0,0,0,,Бұл сарказм ба?
Dialogue: 0,1:53:36.05,1:53:38.56,Default,,0,0,0,,Біздің әскерді қалпына келтіру үшін қысым жасалуда.
Dialogue: 0,1:53:38.64,1:53:40.23,Default,,0,0,0,,А, жоқ, мен олай айтқым келген жоқ.
Dialogue: 0,1:53:40.31,1:53:41.81,Default,,0,0,0,,Бірінші кезекте, оккупациядан кейінгі саясат
Dialogue: 0,1:53:41.89,1:53:43.56,Default,,0,0,0,,Мен қателестім бе?
Dialogue: 0,1:53:43.65,1:53:47.90,Default,,0,0,0,,Неліктен 11-аудандағы метро желісі мен шахта оқпандары тасталды?
Dialogue: 0,1:53:47.98,1:53:51.53,Default,,0,0,0,,Геттода отбасы тізілімін басқару және әртүрлі меншік құқықтары бұлыңғыр болып қалады.
Dialogue: 0,1:53:51.61,1:53:54.20,Default,,0,0,0,,Үкіметке қарсы әрекеттің ошағы қараусыз қалды
Dialogue: 0,1:53:54.70,1:53:56.32,Default,,0,0,0,,Ал, метро
Dialogue: 0,1:53:56.41,1:53:59.08,Default,,0,0,0,,Еліміздің барлық жерінде дерлік таралған.
Dialogue: 0,1:53:59.16,1:54:01.66,Default,,0,0,0,,Концессиядан басқа кеңістікті толтыру үшін бюджет ...
Dialogue: 0,1:54:01.75,1:54:02.87,Default,,0,0,0,,Терроризм негіздері және
Dialogue: 0,1:54:02.96,1:54:05.21,Default,,0,0,0,,Бұл қашу жолы болатынын білсеңіз де!
Dialogue: 0,1:54:09.05,1:54:11.01,Default,,0,0,0,,Олар осында болуы керек...
Dialogue: 0,1:54:11.09,1:54:13.22,Default,,0,0,0,,Лелуш есімді оқушы
Dialogue: 0,1:54:13.30,1:54:14.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:54:14.30,1:54:16.51,Default,,0,0,0,,Мен материалдарды алғым келеді.
Dialogue: 0,1:54:16.59,1:54:18.97,Default,,0,0,0,,Мылтықты кімге бағыттап тұрсың?
Dialogue: 0,1:54:19.06,1:54:22.31,Default,,0,0,0,,Таза қанды фракциядан гөрі Нөлге мүше болған жақсы.
Dialogue: 0,1:54:22.39,1:54:24.10,Default,,0,0,0,,Қызықты деп ойладым.
Dialogue: 0,1:54:24.73,1:54:26.60,Default,,0,0,0,,Қарғыс атсын... Теледидар дүкені!
Dialogue: 0,1:54:26.69,1:54:28.11,Default,,0,0,0,,Сіз әлі Британиядансыз...
Dialogue: 0,1:54:28.19,1:54:29.57,Default,,0,0,0,,Уф...
Dialogue: 0,1:54:29.65,1:54:31.99,Default,,0,0,0,,(Теңізге құлау дыбысы)
Dialogue: 0,1:54:43.83,1:54:47.38,Default,,0,0,0,,Бұл сен бе? Олар қара рыцарьлар деп аталады
Dialogue: 0,1:54:47.46,1:54:50.84,Default,,0,0,0,,Иә, доктор Ракшата, Үндістанның әскери аймағынан.
Dialogue: 0,1:54:50.92,1:54:53.05,Default,,0,0,0,,Гурен 2 стилін кім қолданады?
Dialogue: 0,1:54:53.13,1:54:54.51,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,1:54:54.59,1:54:58.39,Default,,0,0,0,,Сіз өте жақсы деректер жинап жатқан сияқтысыз.
Dialogue: 0,1:54:58.93,1:55:01.64,Default,,0,0,0,,Рахмет ретінде мен сендерге қорғаныс костюмін дайындап қойдым.
Dialogue: 0,1:55:02.27,1:55:07.06,Default,,0,0,0,,Сондай-ақ, біз Үндістан тәуелсіздік алғанға дейін онымен ынтымақтасамыз.
Dialogue: 0,1:55:07.15,1:55:08.65,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:55:18.74,1:55:24.66,Default,,0,0,0,,Енді бетперде киген адам басқаратын ұйымды Киото мақұлдайтынын көрейік.
Dialogue: 0,1:55:24.75,1:55:27.96,Default,,0,0,0,,Нөл жапон емес деген қауесет бар.
Dialogue: 0,1:55:28.04,1:55:30.42,Default,,0,0,0,,Енді бұл туралы уайымдаудың еш пайдасы жоқ.
Dialogue: 0,1:55:30.50,1:55:35.55,Default,,0,0,0,,Мына қыранның алдында да бетпердеңді құпия сақтайсың ба, Нөл?
Dialogue: 0,1:55:35.63,1:55:37.30,Default,,0,0,0,,Мұның себебі бар
Dialogue: 0,1:55:37.38,1:55:38.93,Default,,0,0,0,,Алайда, Лорд Кирихара
Dialogue: 0,1:55:39.01,1:55:41.14,Default,,0,0,0,,Мен қарыздармын саған ғана көрсетемін.
Dialogue: 0,1:55:41.22,1:55:42.60,Default,,0,0,0,,Берешек?
Dialogue: 0,1:55:43.51,1:55:47.94,Default,,0,0,0,,Иә, сен менің апама мейірімді болдың.
Dialogue: 0,1:55:48.02,1:55:49.23,Default,,0,0,0,,Ием!
Dialogue: 0,1:55:49.31,1:55:50.90,Default,,0,0,0,,Рахмет
Dialogue: 0,1:55:53.07,1:55:57.95,Default,,0,0,0,,Сіздің жолыңыз бен Жапонияның жолы қаншалықты сәйкес келеді?
Dialogue: 0,1:55:58.45,1:56:00.78,Default,,0,0,0,,Мен мұны тірек ретінде пайдаланғым келеді.
Dialogue: 0,1:56:00.87,1:56:02.95,Default,,0,0,0,,Британияның әсер етпеген тірегі және
Dialogue: 0,1:56:03.03,1:56:04.70,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,1:56:05.50,1:56:06.45,Default,,0,0,0,,Желдеткіш
Dialogue: 0,1:56:06.54,1:56:07.58,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,1:56:07.66,1:56:11.46,Default,,0,0,0,,Нуши айтқандай, Нөл жапондық емес.
Dialogue: 0,1:56:11.54,1:56:12.63,Default,,0,0,0,,Не!
Dialogue: 0,1:56:12.71,1:56:16.05,Default,,0,0,0,,Бірақ ол Британияның жауы екені сөзсіз.
Dialogue: 0,1:56:16.59,1:56:18.09,Default,,0,0,0,,Нөлді ұстаныңыз
Dialogue: 0,1:56:18.17,1:56:20.76,Default,,0,0,0,,Бұл біздің Киотоның еркі.
Dialogue: 0,1:56:20.84,1:56:21.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:56:22.05,1:56:23.60,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:56:23.68,1:56:25.39,Default,,0,0,0,,Рахмет
Dialogue: 0,1:56:25.47,1:56:28.69,Default,,0,0,0,,Сондай-ақ Гуренді қамтамасыз еткен император Кагурая-денге 2
Dialogue: 0,1:56:28.77,1:56:30.31,Default,,0,0,0,,Маған өз сәлеміңізді білдіріңіз.
Dialogue: 0,1:56:31.60,1:56:35.15,Default,,0,0,0,,Наото: Нөл жапон емес сияқты.
Dialogue: 0,1:56:35.23,1:56:36.40,Default,,0,0,0,,Бірақ бәрі жақсы, солай ма?
Dialogue: 0,1:56:36.94,1:56:39.28,Default,,0,0,0,,Біз ұлтшыл емеспіз
Dialogue: 0,1:56:39.36,1:56:40.61,Default,,0,0,0,,Ах
Dialogue: 0,1:56:42.45,1:56:43.78,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,1:56:46.41,1:56:49.08,Default,,0,0,0,,Мықты болыңыз! Эй сен!
Dialogue: 0,1:56:49.16,1:56:50.04,Default,,0,0,0,,Уф...
Dialogue: 0,1:56:50.12,1:56:51.33,Default,,0,0,0,,Ах!? Ол тірі.
Dialogue: 0,1:56:51.42,1:56:54.38,Default,,0,0,0,,Сіз... Нөл...
Dialogue: 0,1:56:54.46,1:56:55.29,Default,,0,0,0,,Ах!?
Dialogue: 0,1:57:00.63,1:57:02.14,Default,,0,0,0,,Фу
Dialogue: 0,1:57:11.31,1:57:12.98,Default,,0,0,0,,Уф...
Dialogue: 0,1:57:13.06,1:57:14.56,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,1:57:15.06,1:57:16.15,Default,,0,0,0,,Иә...
Dialogue: 0,1:57:16.73,1:57:19.19,Default,,0,0,0,,Неліктен ол жерде жатты?
Dialogue: 0,1:57:19.99,1:57:21.11,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,1:57:21.20,1:57:22.66,Default,,0,0,0,,Мен?
Dialogue: 0,1:57:23.32,1:57:24.37,Default,,0,0,0,,Сол түнде толық ай болды
Dialogue: 0,1:57:24.45,1:57:25.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:57:25.45,1:57:26.74,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,1:57:27.33,1:57:29.37,Default,,0,0,0,,Сіздің есіңізде ме?
Dialogue: 0,1:57:29.95,1:57:31.87,Default,,0,0,0,,Нөл туралы ше!? Сіз...
Dialogue: 0,1:57:31.96,1:57:32.92,Default,,0,0,0,,Нөл дегеніміз не?
Dialogue: 0,1:57:33.00,1:57:34.42,Default,,0,0,0,,Жоқ! Қарғыс атсын!
Dialogue: 0,1:57:34.50,1:57:36.46,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,1:57:36.54,1:57:38.67,Default,,0,0,0,,Бұл жігіт маған опасыздық жасады...
Dialogue: 0,1:57:38.76,1:57:40.26,Default,,0,0,0,,Себебі мен түсінбеймін!
Dialogue: 0,1:57:40.34,1:57:41.38,Default,,0,0,0,,Уф!
Dialogue: 0,1:57:41.97,1:57:43.09,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,1:57:43.18,1:57:45.39,Default,,0,0,0,,Кешіріңіз, бұл...
Dialogue: 0,1:57:45.47,1:57:49.47,Default,,0,0,0,,Мен оны көзіммен жұмған күйде шешіп алдым, бірақ киіп жатырмын...
Dialogue: 0,1:57:49.56,1:57:53.23,Default,,0,0,0,,А, бірақ мен бөлмені жылытып қойдым, сондықтан бәрі жақсы деп ойлаймын...
Dialogue: 0,1:57:53.31,1:57:55.15,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,1:57:55.23,1:57:56.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:57:56.52,1:57:59.57,Default,,0,0,0,,Мені жақсы адам көтеріп алған сияқты.
Dialogue: 0,1:57:59.65,1:58:00.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:58:02.24,1:58:04.41,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,1:58:04.49,1:58:06.95,Default,,0,0,0,,Лулу қайтадан кетіп қалды.
Dialogue: 0,1:58:07.03,1:58:08.79,Default,,0,0,0,,Сәлем сен
Dialogue: 0,1:58:08.87,1:58:11.41,Default,,0,0,0,,Мұндай жерде жалғыз қалу қауіпті.
Dialogue: 0,1:58:11.50,1:58:13.33,Default,,0,0,0,,Таза үйге тез оралыңыз.
Dialogue: 0,1:58:13.41,1:58:14.50,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,1:58:14.58,1:58:16.83,Default,,0,0,0,,Иә, Тин үйіне бара алады.
Dialogue: 0,1:58:16.92,1:58:19.17,Default,,0,0,0,,Ей, мені қатты қорқытпа.
Dialogue: 0,1:58:19.25,1:58:20.38,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:58:20.46,1:58:24.05,Default,,0,0,0,,Қара рыцарлар осында болғанша, біз жеңілмейміз!
Dialogue: 0,1:58:24.13,1:58:29.14,Default,,0,0,0,,♪ «Нөл – біздің үмітіміз»
Dialogue: 0,1:59:52.26,1:59:54.47,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,1:59:54.56,1:59:55.47,Default,,0,0,0,,О
Dialogue: 0,1:59:56.10,1:59:57.48,Default,,0,0,0,,Британияның билігі
Dialogue: 0,1:59:57.56,2:00:00.90,Default,,0,0,0,,Нөл басқарған Қара рыцарьлардың күшімен жойылады
Dialogue: 0,2:00:01.86,2:00:04.94,Default,,0,0,0,,Қарсыластар өздерін рыцарьлар деп атайды деп күтпедім.
Dialogue: 0,2:00:05.03,2:00:08.07,Default,,0,0,0,,Жапон азаттық майданының тірі қалғандары жойылған кезде
Dialogue: 0,2:00:08.15,2:00:10.20,Default,,0,0,0,,Не болар екен деп ойладым.
Dialogue: 0,2:00:10.78,2:00:11.95,Default,,0,0,0,,Өшіру?
Dialogue: 0,2:00:13.28,2:00:14.99,Default,,0,0,0,,Мен адамдарды нашар естимін.
Dialogue: 0,2:00:15.08,2:00:18.87,Default,,0,0,0,,Үндістанның әскери аймағына өтуге тырысқандарды анықтады.
Dialogue: 0,2:00:18.96,2:00:21.38,Default,,0,0,0,,Британдық флотты қатыстыру?
Dialogue: 0,2:00:22.00,2:00:24.38,Default,,0,0,0,,Бір нәрсенің құндылығы бар ма?
Dialogue: 0,2:00:24.46,2:00:28.09,Default,,0,0,0,,Сіз басқа да көптеген қарсылықтарды жеңген сияқтысыз ба?
Dialogue: 0,2:00:28.17,2:00:30.47,Default,,0,0,0,,Қара рыцарьлар әділеттілікке ұмтылады
Dialogue: 0,2:00:30.55,2:00:33.30,Default,,0,0,0,,Бұл үшін Британия да, Қарсыласу да маңызды емес.
Dialogue: 0,2:00:34.64,2:00:37.85,Default,,0,0,0,,Әрине, мен жауынгерлік күш ретінде қолдана алатынымды пайдаланамын.
Dialogue: 0,2:00:37.93,2:00:39.35,Default,,0,0,0,,Тіпті Geass қолданбасын пайдалансаңыз да
Dialogue: 0,2:00:39.44,2:00:40.73,Default,,0,0,0,,Сіздің Geass
Dialogue: 0,2:00:40.81,2:00:43.94,Default,,0,0,0,,Абсолютті мойынсұну күші адамдардың еркін бұрмалайды.
Dialogue: 0,2:00:44.02,2:00:48.15,Default,,0,0,0,,Кейде бұл сіздің сенімдеріңіз бен өмірдегі мақсатыңызды жоғалтуы мүмкін.
Dialogue: 0,2:00:48.24,2:00:49.07,Default,,0,0,0,,Бұл...
Dialogue: 0,2:00:49.15,2:00:50.49,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,2:00:50.57,2:00:54.16,Default,,0,0,0,,Дегенмен, Nunnally бақытты өмір сүре алатын әлемді құру
Dialogue: 0,2:00:54.24,2:00:56.37,Default,,0,0,0,,барлығын ауыстырады
Dialogue: 0,2:00:56.45,2:00:58.83,Default,,0,0,0,,Мен бұл мақсатта сахна артында жүргенім жақсы.
Dialogue: 0,2:00:58.91,2:01:00.00,Default,,0,0,0,,Көлеңке?
Dialogue: 0,2:01:00.08,2:01:02.96,Default,,0,0,0,,Ал күндегі кім? Үстел ше?
Dialogue: 0,2:01:04.42,2:01:05.25,Default,,0,0,0,,Уф...
Dialogue: 0,2:01:05.34,2:01:07.42,Default,,0,0,0,,Не?
Dialogue: 0,2:01:07.51,2:01:08.59,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,2:01:08.67,2:01:11.97,Default,,0,0,0,,Бізге Хиросимадағы бір топ қоңырау шалып, олардың бізге қосылғысы келетінін айтты.
Dialogue: 0,2:01:12.05,2:01:13.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,2:01:13.09,2:01:15.85,Default,,0,0,0,,Менің қол астында болғың келсе, мен оны қабылдаймын.
Dialogue: 0,2:01:17.06,2:01:19.60,Default,,0,0,0,,Ал британдық сізбен кездескісі келеді.
Dialogue: 0,2:01:19.68,2:01:21.52,Default,,0,0,0,,Телеарнадан келген жігіт?
Dialogue: 0,2:01:21.60,2:01:23.60,Default,,0,0,0,,Жарайды, бұл пайдалы болады деп ойлаймын.
Dialogue: 0,2:01:23.69,2:01:25.31,Default,,0,0,0,,Сіз C.C. дедіңіз бе?
Dialogue: 0,2:01:25.40,2:01:27.57,Default,,0,0,0,,Сіз де Nightmare кадрын толығымен жаттықтырыңыз.
Dialogue: 0,2:01:27.65,2:01:29.19,Default,,0,0,0,,Мен таңғы астың ортасындамын.
Dialogue: 0,2:01:29.28,2:01:31.15,Default,,0,0,0,,Уф! Иә?
Dialogue: 0,2:01:31.78,2:01:32.91,Default,,0,0,0,,Хэхе…
Dialogue: 0,2:01:34.82,2:01:36.33,Default,,0,0,0,,Сегізаяқ мырза?
Dialogue: 0,2:01:36.41,2:01:38.37,Default,,0,0,0,,Ол әйел...
Dialogue: 0,2:01:38.45,2:01:39.70,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,2:01:39.79,2:01:41.37,Default,,0,0,0,,А, а, жоқ, бұл...
Dialogue: 0,2:01:41.46,2:01:43.42,Default,,0,0,0,,Мен тұтынушымын (жанкүйер) Иә?
Dialogue: 0,2:01:43.50,2:01:44.88,Default,,0,0,0,,Киотодан келген таныстыру хаты да бар.
Dialogue: 0,2:01:49.05,2:01:50.84,Default,,0,0,0,,Амал жоқ... Төрт қасиетті қылыштан?
Dialogue: 0,2:01:50.92,2:01:54.51,Default,,0,0,0,,Шынымды айтсам, сенің көмегіңді алғым келеді.
Dialogue: 0,2:01:54.59,2:01:56.30,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,2:01:56.89,2:01:59.02,Default,,0,0,0,,Подполковник Тодо тұтқынға алынды.
Dialogue: 0,2:01:59.10,2:02:02.44,Default,,0,0,0,,Бізге құтылу үшін бір адам құрбан болды...
Dialogue: 0,2:02:03.77,2:02:05.60,Default,,0,0,0,,Түсіндім, мен оны қабылдаймын.
Dialogue: 0,2:02:05.69,2:02:06.94,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,2:02:07.02,2:02:10.65,Default,,0,0,0,,Қара рыцарьлар - әділдіктің одақтастары. Таңқаларлық емес.
Dialogue: 0,2:02:12.28,2:02:13.36,Default,,0,0,0,,Ах!
Dialogue: 0,2:02:13.95,2:02:17.91,Default,,0,0,0,,Жинау әдісі - B13 (Он үш) Nightmare 18 бағыттан бөлінген
Dialogue: 0,2:02:17.99,2:02:19.66,Default,,0,0,0,,Оны Диетард шешуге рұқсат етіңіз.
Dialogue: 0,2:02:19.74,2:02:22.33,Default,,0,0,0,,Бізге қосылуды жоспарлап отырған мүшелерге хабарлаңыз.
Dialogue: 0,2:02:24.33,2:02:28.17,Default,,0,0,0,,Ия, мен Todo деген карта арғы жақтан келеді деп ойламаппын.
Dialogue: 0,2:02:28.25,2:02:31.21,Default,,0,0,0,,Иә, бұл тоғанда қыста мұз болады.
Dialogue: 0,2:02:31.30,2:02:34.13,Default,,0,0,0,,Коньки тепкенімде ағам ұрысты.
Dialogue: 0,2:02:34.22,2:02:36.93,Default,,0,0,0,,Эй, Куруруги храмында да бір адам бар еді.
Dialogue: 0,2:02:37.01,2:02:39.10,Default,,0,0,0,,Бұл шағын тоған, бірақ шаяндар жиі кездеседі...
Dialogue: 0,2:02:39.18,2:02:41.35,Default,,0,0,0,,А, шаянды ұста.
Dialogue: 0,2:02:41.43,2:02:43.93,Default,,0,0,0,,Сіз шаяндарды ұстай аласыз ба?
Dialogue: 0,2:02:44.02,2:02:47.15,Default,,0,0,0,,Бұл оңай. Тек бақаның аяқтарын жіпке бекітіңіз.
Dialogue: 0,2:02:47.23,2:02:48.56,Default,,0,0,0,,Иә? Бақа дегеніміз не?
Dialogue: 0,2:02:48.65,2:02:50.73,Default,,0,0,0,,Бұл «Қыршық жадағайдағы» бақа ма?
Dialogue: 0,2:02:50.82,2:02:54.11,Default,,0,0,0,,Дұрыс, Жапонияда бұл «керокерокеро».
Dialogue: 0,2:02:54.20,2:02:55.24,Default,,0,0,0,,Kero kero?
Dialogue: 0,2:02:55.86,2:02:58.07,Default,,0,0,0,,Іс жоспарға сай болса
Dialogue: 0,2:02:58.16,2:03:01.33,Default,,0,0,0,,Бір күні мен Нуналлидің қасында бола алмаймын.
Dialogue: 0,2:03:01.41,2:03:05.83,Default,,0,0,0,,Төтенше жағдайда маған Нуналлиді қорғайтын біреу керек.
Dialogue: 0,2:03:07.92,2:03:11.59,Default,,0,0,0,,Идеал - Нунналли сол адамның өмірінің мақсатына айналуы.
Dialogue: 0,2:03:11.67,2:03:12.88,Default,,0,0,0,,Егер Созаку...
Dialogue: 0,2:03:12.96,2:03:14.38,Default,,0,0,0,,Иә?не?
Dialogue: 0,2:03:14.47,2:03:15.59,Default,,0,0,0,,Созаку Шын мәнінде...
Dialogue: 0,2:03:15.67,2:03:17.18,Default,,0,0,0,,Сузаку-кун!
Dialogue: 0,2:03:19.05,2:03:20.76,Default,,0,0,0,,Ллойд мырзаның шұғыл істері бар.
Dialogue: 0,2:03:20.85,2:03:22.68,Default,,0,0,0,,Кім? әскери адам
Dialogue: 0,2:03:23.56,2:03:25.56,Default,,0,0,0,,Достар? иә
Dialogue: 0,2:03:26.14,2:03:28.65,Default,,0,0,0,,Кешіріңіз, бірақ маған бір сәтке Сузаку-кунды қарызға беріңізші.
Dialogue: 0,2:03:28.73,2:03:30.69,Default,,0,0,0,,Қош келдіңіз, Созаку-сан
Dialogue: 0,2:03:30.77,2:03:31.94,Default,,0,0,0,,Иә
Dialogue: 0,2:03:32.02,2:03:33.36,Default,,0,0,0,,Созаку! сурет?
Dialogue: 0,2:03:33.94,2:03:35.86,Default,,0,0,0,,Мен қайтып келгенде бір нәрсе туралы айтқым келеді.
Dialogue: 0,2:03:35.95,2:03:38.11,Default,,0,0,0,,Маңызды... Бұл маңызды оқиға.
Dialogue: 0,2:03:38.20,2:03:40.28,Default,,0,0,0,,Не? Бұл қорқынышты
Dialogue: 0,2:03:40.37,2:03:41.95,Default,,0,0,0,,Олай болса, кейінірек.
Dialogue: 0,2:03:42.70,2:03:45.33,Default,,0,0,0,,Созаку-сан, сен керексің.
Dialogue: 0,2:03:45.41,2:03:46.54,Default,,0,0,0,,Жақсы
Dialogue: 0,2:04:01.35,2:04:03.68,Default,,0,0,0,,Жазаны орындаушы өзгертілді.
Dialogue: 0,2:04:05.22,2:04:07.06,Default,,0,0,0,,Ордер офицері Сузаку Куруруги
Dialogue: 0,2:04:07.14,2:04:09.44,Default,,0,0,0,,Мен сізді білетініме қуаныштымын.
Dialogue: 0,2:04:10.31,2:04:11.86,Default,,0,0,0,,Не!?
Dialogue: 0,2:04:11.94,2:04:14.15,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,2:04:25.79,2:04:26.79,Default,,0,0,0,,Нөл…
Dialogue: 0,2:04:26.87,2:04:28.71,Default,,0,0,0,,Кагаширо Тодо
Dialogue: 0,2:04:28.79,2:04:33.25,Default,,0,0,0,,Жеті жыл бұрын соғыс кезінде Британияға қол тигізген жалғыз адам.
Dialogue: 0,2:04:33.34,2:04:35.13,Default,,0,0,0,,Ицукусимадағы керемет?
Dialogue: 0,2:04:35.21,2:04:37.76,Default,,0,0,0,,Сен де менен бір ғажайып тілейсің бе?
Dialogue: 0,2:04:37.84,2:04:39.72,Default,,0,0,0,,Бұл керемет емес
Dialogue: 0,2:04:39.80,2:04:42.97,Default,,0,0,0,,Ақпарат жинауға негізделген тактикалық табыс
Dialogue: 0,2:04:43.05,2:04:45.31,Default,,0,0,0,,Сондықтан мен сені қалаймын
Dialogue: 0,2:04:45.39,2:04:46.64,Default,,0,0,0,,Жетеді
Dialogue: 0,2:04:46.72,2:04:50.27,Default,,0,0,0,,Мен қожайын етіп тағайындаған генерал-майор Катасе қайтыс болды, мен де...
Dialogue: 0,2:04:50.35,2:04:52.10,Default,,0,0,0,,Көңілсіз болмаңыз! (Тодо) Не?
Dialogue: 0,2:04:52.73,2:04:54.65,Default,,0,0,0,,Жауапкершілікті өз мойныңызға алуыңыз керек
Dialogue: 0,2:04:55.27,2:04:56.98,Default,,0,0,0,,Ғажайыпқа жауапты!
Dialogue: 0,2:05:50.50,2:05:51.54,Default,,0,0,0,,Подполковник!
Dialogue: 0,2:05:51.62,2:05:53.21,Default,,0,0,0,,Қош келдіңіз, Тодо мырза
Dialogue: 0,2:05:53.29,2:05:55.71,Default,,0,0,0,,Бәріңе, мен сендерді көп қиындыққа ұшыраттым.
Dialogue: 0,2:05:55.79,2:05:57.13,Default,,0,0,0,,Бұл арзан
Dialogue: 0,2:05:58.55,2:05:59.71,Default,,0,0,0,,Нөлмен ынтымақтасу
Dialogue: 0,2:05:59.80,2:06:02.01,Default,,0,0,0,,Мен мұнда қалған әскерлерге шабуыл жасаймын.
Dialogue: 0,2:06:02.09,2:06:03.13,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,2:06:04.55,2:06:06.89,Default,,0,0,0,,Барлық шарттар енді тазартылды.
Dialogue: 0,2:06:06.97,2:06:09.01,Default,,0,0,0,,Мен де Нанналлидің рыцарын таңдадым, ал қалғандары...
Dialogue: 0,2:06:09.10,2:06:09.93,Default,,0,0,0,,Ха!
Dialogue: 0,2:06:13.73,2:06:15.73,Default,,0,0,0,,Ол не үшін мұнда?
Dialogue: 0,2:06:15.81,2:06:17.48,Default,,0,0,0,,Мынау
Dialogue: 0,2:06:17.57,2:06:20.11,Default,,0,0,0,,Қалған есептер өздігінен шықты.
Dialogue: 0,2:06:25.36,2:06:26.66,Default,,0,0,0,,Мен төбелесуге дағдыланғанмын.
Dialogue: 0,2:06:26.74,2:06:29.95,Default,,0,0,0,,О, бұл керемет емес пе? Жаудың жаңа түрі.
Dialogue: 0,2:06:30.04,2:06:30.91,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,2:06:31.00,2:06:33.50,Default,,0,0,0,,Нөл Ақ Кабутомен қиындыққа тап болды.
Dialogue: 0,2:06:33.58,2:06:34.75,Default,,0,0,0,,(Кёко) Қыз ба? (Юки) Ұл ба?
Dialogue: 0,2:06:34.83,2:06:36.17,Default,,0,0,0,,Хмм.
Dialogue: 0,2:06:36.71,2:06:39.71,Default,,0,0,0,,Нөл Бұл ұшақ туралы ақпарат бар ма?
Dialogue: 0,2:06:39.80,2:06:43.34,Default,,0,0,0,,Опциялар бар, бірақ мұнда менің нұсқауларымды орындаңыз.
Dialogue: 0,2:06:43.42,2:06:45.59,Default,,0,0,0,,Жарайды, мен мұны сізге қалдырамын.
Dialogue: 0,2:06:46.22,2:06:47.60,Default,,0,0,0,,Барлық ұшақтар, қашықтықты сақтаңыз.
Dialogue: 0,2:06:52.18,2:06:53.56,Default,,0,0,0,,Бірінші шабуыл алдыңғы жақтан.
Dialogue: 0,2:06:53.64,2:06:55.35,Default,,0,0,0,,Ешқашан жасандылық жасамаңыз
Dialogue: 0,2:06:57.56,2:06:58.65,Default,,0,0,0,,Жалтарған жағдайда
Dialogue: 0,2:06:58.73,2:07:01.15,Default,,0,0,0,,Келесі шабуылды болдырмау үшін дереу қозғалыңыз
Dialogue: 0,2:07:01.23,2:07:02.90,Default,,0,0,0,,Қозғалыс деректерін жүктеңіз
Dialogue: 0,2:07:03.69,2:07:05.03,Default,,0,0,0,,S57
Dialogue: 0,2:07:06.78,2:07:08.66,Default,,0,0,0,,Эй, мен шынымен келдім.
Dialogue: 0,2:07:11.37,2:07:13.87,Default,,0,0,0,,Иә, бұл жағдайда келесі әрекет орындалады
Dialogue: 0,2:07:13.95,2:07:15.96,Default,,0,0,0,,Артқы жағына дейінгі қашықтықты жасаңыз
Dialogue: 0,2:07:16.04,2:07:18.00,Default,,0,0,0,,Координаталар X23 (екі үш)
Dialogue: 0,2:07:18.08,2:07:20.42,Default,,0,0,0,,Енді тексеріңіз
Dialogue: 0,2:07:23.13,2:07:24.97,Default,,0,0,0,,Бұл не!? (Todo) Сіз оны оқыдыңыз ба!?
Dialogue: 0,2:07:25.05,2:07:26.88,Default,,0,0,0,,Үш қадам! Бірақ...
Dialogue: 0,2:07:31.47,2:07:34.06,Default,,0,0,0,,О, бұл жаман! Өйткені қашу блогы жоқ
Dialogue: 0,2:07:34.14,2:07:35.89,Default,,0,0,0,,Сіз оны әлі киген жоқсыз ба?
Dialogue: 0,2:07:43.15,2:07:43.98,Default,,0,0,0,,Уф!
Dialogue: 0,2:07:44.07,2:07:45.78,Default,,0,0,0,,Не!? Бұл өтірік...
Dialogue: 0,2:07:45.86,2:07:47.66,Default,,0,0,0,,Созаку-кун... бұл сен бе?!
Dialogue: 0,2:07:47.74,2:07:49.70,Default,,0,0,0,,Не? Иә...
Dialogue: 0,2:07:49.78,2:07:51.41,Default,,0,0,0,,Ха! нөл! Маған нұсқау беріңіз!
Dialogue: 0,2:07:51.99,2:07:54.45,Default,,0,0,0,,Маған келесі нұсқауларды беріңізші!нөл!
Dialogue: 0,2:07:55.00,2:07:57.25,Default,,0,0,0,,Осы уақытқа дейін бәрі...
Dialogue: 0,2:07:57.33,2:07:59.12,Default,,0,0,0,,Сузаку!
Dialogue: 0,2:07:59.88,2:08:01.59,Default,,0,0,0,,Жарайды, ол әлі де жұмыс істейді.
Dialogue: 0,2:08:05.71,2:08:07.22,Default,,0,0,0,,Кел, Созаку-кун!
Dialogue: 0,2:08:07.30,2:08:09.22,Default,,0,0,0,,Ха!? Тодо-сан!
Dialogue: 0,2:08:09.30,2:08:13.43,Default,,0,0,0,,Қарғыс атқыр... Тірі қалу үшін бұлшық еттеріңізді бүгу керек пе!?
Dialogue: 0,2:08:13.51,2:08:15.14,Default,,0,0,0,,Көңіліңіз қалды ма?
Dialogue: 0,2:08:15.22,2:08:17.77,Default,,0,0,0,,Содан кейін мені жоспарланғандай орындаңыз.
Dialogue: 0,2:08:18.69,2:08:22.48,Default,,0,0,0,,Неге... ондай жерде болмау керек.
Dialogue: 0,2:08:22.56,2:08:24.32,Default,,0,0,0,,Сіз Нуннеллидің қасындасыз...
Dialogue: 0,2:08:26.36,2:08:28.11,Default,,0,0,0,,Жеңіс немесе жеңілу
Dialogue: 0,2:08:28.20,2:08:31.07,Default,,0,0,0,,Барыңды бермейінше, ештеңе ұта алмайсың.
Dialogue: 0,2:08:31.16,2:08:33.74,Default,,0,0,0,,Бұл елдер мен жеке тұлғалар үшін бірдей.
Dialogue: 0,2:08:34.83,2:08:35.99,Default,,0,0,0,,Иә!
Dialogue: 0,2:08:38.50,2:08:41.83,Default,,0,0,0,,Нөл! Сіз оны ұстағыңыз келе ме? Әлде... нөл!?
Dialogue: 0,2:08:41.92,2:08:44.09,Default,,0,0,0,,Ақ қоңызды жойыңыз Жақсы.
Dialogue: 0,2:08:44.17,2:08:45.55,Default,,0,0,0,,Күте тұрыңыз! Нөлдік нұсқаулар!
Dialogue: 0,2:08:45.63,2:08:46.59,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,2:08:46.67,2:08:48.67,Default,,0,0,0,,Капитан Сенба Айналмалы жансыз құрам
Dialogue: 0,2:08:48.76,2:08:50.30,Default,,0,0,0,,Түсінікті! асылу!
Dialogue: 0,2:08:50.38,2:08:52.05,Default,,0,0,0,,Қарғыс атсын! Тоқта! қазір!
Dialogue: 0,2:08:52.14,2:08:55.89,Default,,0,0,0,,Жарайды. Жан-жақтан бір мезгілде шабуылдар. Сіз мұны айналып өте алмайсыз.
Dialogue: 0,2:08:56.77,2:08:58.93,Default,,0,0,0,,Ордер Куруруги Харкен Бостердің құлпы ашылды!
Dialogue: 0,2:08:59.02,2:09:01.10,Default,,0,0,0,,Құпия сөздер менің сүйікті!
Dialogue: 0,2:09:06.02,2:09:06.86,Default,,0,0,0,,Қарғыс атсын! (Чиба) Өтірік!
Dialogue: 0,2:09:06.94,2:09:08.07,Default,,0,0,0,,Міне!
Dialogue: 0,2:09:14.58,2:09:17.54,Default,,0,0,0,,Амансың ба!? (Сенба) Оның қызық күрес тәсілі бар.
Dialogue: 0,2:09:17.62,2:09:19.83,Default,,0,0,0,,Асахина! Солға бұрылыңыз! Бұл жолы...
Dialogue: 0,2:09:19.91,2:09:20.91,Default,,0,0,0,,Тоқта!
Dialogue: 0,2:09:21.00,2:09:22.08,Default,,0,0,0,,Ха!? Нөл?
Dialogue: 0,2:09:22.17,2:09:24.33,Default,,0,0,0,,Енді ұрыспа.
Dialogue: 0,2:09:24.42,2:09:28.01,Default,,0,0,0,,Мақсатқа 3-маршрутты қолдану арқылы қол жеткізілді (Үш)——
Dialogue: 0,2:09:28.59,2:09:30.38,Default,,0,0,0,,Дереу бас тарт!
Dialogue: 0,2:09:31.38,2:09:32.51,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,2:09:33.09,2:09:36.43,Default,,0,0,0,,Бір жақсысы, мен қалаған барлық карталарды алдым.
Dialogue: 0,2:09:36.51,2:09:39.10,Default,,0,0,0,,Майдан командирлері мен ардагерлері
Dialogue: 0,2:09:39.18,2:09:43.65,Default,,0,0,0,,Медиа индустриясының мүдделі тараптарын қадағалау сарапшыларына арналған қорқынышты дизайн
Dialogue: 0,2:09:43.73,2:09:46.57,Default,,0,0,0,,Ақ Кабутоның ұшқышы да анықталды.
Dialogue: 0,2:09:46.65,2:09:47.98,Default,,0,0,0,,Уф...
Dialogue: 0,2:09:49.11,2:09:51.20,Default,,0,0,0,,Әлде осы жерден тоқтауымыз керек пе?
Dialogue: 0,2:09:51.28,2:09:52.53,Default,,0,0,0,,Бұл...
Dialogue: 0,2:09:52.61,2:09:54.49,Default,,0,0,0,,Олай болса, бізде алға жылжудан басқа амал жоқ, солай ма?
Dialogue: 0,2:09:54.57,2:09:56.95,Default,,0,0,0,,Қарғыс атқыр... Созақудың өзіңе жау болғанын қалайсың ба?
Dialogue: 0,2:09:57.03,2:09:58.58,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,2:09:58.66,2:10:01.00,Default,,0,0,0,,Неліктен Geass қолданбасқа?
Dialogue: 0,2:10:01.08,2:10:02.29,Default,,0,0,0,,Оны өзіңізге бағынышты етіңіз...
Dialogue: 0,2:10:02.37,2:10:03.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,2:10:04.12,2:10:06.92,Default,,0,0,0,,Бұл... жоқ.
Dialogue: 0,2:10:10.01,2:10:11.72,Default,,0,0,0,,Аңғал болмаңыз
Dialogue: 0,2:10:12.34,2:10:15.80,Default,,0,0,0,,Әпкең үшін дүниені қирата бастадың.
Dialogue: 0,2:10:15.89,2:10:17.72,Default,,0,0,0,,Енді... (Лелуш) Мен білемін.
Dialogue: 0,2:10:18.31,2:10:21.43,Default,,0,0,0,,Атуға дайын адамдар ғана атуға рұқсат етілген.
Dialogue: 0,2:10:23.81,2:10:25.23,Default,,0,0,0,,Содан кейін шешіңіз.
Dialogue: 0,2:10:25.31,2:10:27.23,Default,,0,0,0,,Сіз шешесіз
Dialogue: 0,2:10:27.82,2:10:30.73,Default,,0,0,0,,Менің әпкем Нуналли ең маңыздысы ма?
Dialogue: 0,2:10:31.32,2:10:32.24,Default,,0,0,0,,Әлде…
Dialogue: 0,2:10:32.99,2:10:35.03,Default,,0,0,0,,Сіз достарыңызбен біргесіз бе?
Dialogue: 0,2:10:35.11,2:10:36.62,Default,,0,0,0,,Уааах! Ол өліп қалды!
Dialogue: 0,2:10:36.70,2:10:39.74,Default,,0,0,0,,Күшсіз болған кешегі күнге қайта алмаймын.
Dialogue: 0,2:10:41.91,2:10:42.75,Default,,0,0,0,,Сонымен
Dialogue: 0,2:10:42.83,2:10:47.84,Default,,0,0,0,,♪~
Dialogue: 0,2:14:06.74,2:14:11.75,Default,,0,0,0,,~♪
Dialogue: 0,2:14:13.25,2:14:19.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory