Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.96,0:00:48.97,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:00:48.97,0:00:50.97,Default,,0,0,0,,Жаңа ғана таратқан үлкен қағазда
Dialogue: 0,0:00:50.97,0:00:54.81,Default,,0,0,0,,Мен өскенде кім болғым келетінін салайын ба?
Dialogue: 0,0:00:54.81,0:00:56.97,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:00:56.97,0:00:59.48,Default,,0,0,0,,Ненің суретін салып жатырсың?
Dialogue: 0,0:00:59.48,0:01:02.48,Default,,0,0,0,,Уау! Сен жақсысың
Dialogue: 0,0:01:02.48,0:01:04.98,Default,,0,0,0,,Бірақ балық? (Харука) Иә
Dialogue: 0,0:01:04.98,0:01:07.99,Default,,0,0,0,,Өйткені мен еркін жүзгім келеді
Dialogue: 0,0:01:07.99,0:01:09.99,Default,,0,0,0,,Бостандық?
Dialogue: 0,0:01:09.99,0:01:16.26,Default,,0,0,0,,Иә, мен бол және еркін бол
Dialogue: 0,0:01:16.26,0:01:39.95,Default,,0,0,0,,～
Dialogue: 0,0:01:39.95,0:01:42.62,Default,,0,0,0,,Уау! Әдемі...
Dialogue: 0,0:01:42.62,0:01:45.79,Default,,0,0,0,,Олар бүгінде жұлдыздар көп дейді!
Dialogue: 0,0:01:45.79,0:01:49.79,Default,,0,0,0,,Дұрыс. (Нағиса) Әй! Бұл әдемі, солай емес пе?
Dialogue: 0,0:01:49.79,0:01:52.80,Default,,0,0,0,,Сәлем Мако-чан! Тілегіңіз бар ма?
Dialogue: 0,0:01:52.80,0:01:55.13,Default,,0,0,0,,Иә? Ал...
Dialogue: 0,0:01:55.13,0:02:00.30,Default,,0,0,0,,Мен алтын медаль аламын.
Dialogue: 0,0:02:00.30,0:02:02.31,Default,,0,0,0,,Ақша? (Рин) Ах!
Dialogue: 0,0:02:02.31,0:02:06.31,Default,,0,0,0,,Дүние жүзінің ғажайып жүзушілерімен күрес
Dialogue: 0,0:02:06.31,0:02:08.65,Default,,0,0,0,,Осылайша сіз жеңесіз!
Dialogue: 0,0:02:08.65,0:02:12.08,Default,,0,0,0,,Менің қазір арманым. Хехе!
Dialogue: 0,0:02:12.08,0:02:14.08,Default,,0,0,0,,Жарайсың, Рин Чан!
Dialogue: 0,0:02:14.08,0:02:16.09,Default,,0,0,0,,Рин керемет
Dialogue: 0,0:02:16.09,0:02:18.59,Default,,0,0,0,,Не қалайтыныңызды анық айтыңыз
Dialogue: 0,0:02:18.59,0:02:22.59,Default,,0,0,0,,Тіпті Макотоның да армандары бар, солай ма? Нағиса да!
Dialogue: 0,0:02:22.59,0:02:28.27,Default,,0,0,0,,Иә! Мен бәрімен мәңгі дос болғым келеді.
Dialogue: 0,0:02:28.27,0:02:32.60,Default,,0,0,0,,Қуанышқа кенеліп, барған сайын күліңіз
Dialogue: 0,0:02:32.60,0:02:34.61,Default,,0,0,0,,Мен жүзуді көңілді өткізгім келеді!
Dialogue: 0,0:02:34.61,0:02:38.61,Default,,0,0,0,,Сондықтан мен әлі де бірге жұлдыздарға қарай алатынымызға өте қуаныштымын!
Dialogue: 0,0:02:38.61,0:02:41.28,Default,,0,0,0,,Өйткені мен бәрін жақсы көремін. Ха!
Dialogue: 0,0:02:41.28,0:02:45.28,Default,,0,0,0,,Нағиса... Нағиса сияқты. Күшті.
Dialogue: 0,0:02:45.28,0:02:48.79,Default,,0,0,0,,Макото ше?
Dialogue: 0,0:02:48.79,0:02:52.12,Default,,0,0,0,,Менің де жүзгім келеді...
Dialogue: 0,0:02:52.12,0:02:54.63,Default,,0,0,0,,Өйткені, жүзу қызық.
Dialogue: 0,0:02:54.63,0:02:57.13,Default,,0,0,0,,Осылай барлығымен жүздестім.
Dialogue: 0,0:02:57.13,0:03:01.30,Default,,0,0,0,,Мен мұны нақты түсіндіре алмаймын, бірақ мен байланысты сезіндім...
Dialogue: 0,0:03:01.30,0:03:04.97,Default,,0,0,0,,Сондықтан әрі қарай не болатынын білмеймін.
Dialogue: 0,0:03:04.97,0:03:08.97,Default,,0,0,0,,Мен жүзуді жалғастырғым келеді. Мен Нағисамен біргемін.
Dialogue: 0,0:03:08.97,0:03:12.91,Default,,0,0,0,,Жарайды! Макотоның көмегімен сіз өзіңіз қалаған адам бола аласыз.
Dialogue: 0,0:03:12.91,0:03:15.25,Default,,0,0,0,,Рахмет Рин
Dialogue: 0,0:03:15.25,0:03:19.92,Default,,0,0,0,,Хару ше? Сіз де алтын медальға ұмтыласыз ба?
Dialogue: 0,0:03:19.92,0:03:22.92,Default,,0,0,0,,Медаль…｡ Дұрыс, Хару.
Dialogue: 0,0:03:22.92,0:03:26.42,Default,,0,0,0,,Біз әлемдегі ең жылдам жігітпен жарысамыз.
Dialogue: 0,0:03:26.42,0:03:28.93,Default,,0,0,0,,Бұл туралы ойлаудың өзі сізді толқытады емес пе?
Dialogue: 0,0:03:28.93,0:03:33.93,Default,,0,0,0,,Бұл ұзақ жол болуы мүмкін, мен білмеймін, бірақ мен көп жаттығамын.
Dialogue: 0,0:03:33.93,0:03:37.93,Default,,0,0,0,,Менімен бірге әлемге барайық, Хару!
Dialogue: 0,0:03:40.44,0:03:42.94,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:44.94,0:03:46.94,Default,,0,0,0,,Бұл кенеттен болды. (Сусуке) Иә?
Dialogue: 0,0:03:46.94,0:03:49.45,Default,,0,0,0,,Тасымалдау. (Сусуке) А...
Dialogue: 0,0:03:49.45,0:03:53.95,Default,,0,0,0,,Осындай уақытта мектептерді ауыстыру немесе бірге шомылғыңыз келетін адамды табу сияқты нәрселер бар.
Dialogue: 0,0:03:53.95,0:03:56.29,Default,,0,0,0,,Мен Ринді түсінбеймін.
Dialogue: 0,0:03:56.29,0:04:00.46,Default,,0,0,0,,Иә, бұл біраз ренжіді, бірақ ол жүзуді жалғастыра берсе.
Dialogue: 0,0:04:00.46,0:04:02.96,Default,,0,0,0,,Мен де ұтыла алмайтын сияқтымын.
Dialogue: 0,0:04:02.96,0:04:06.30,Default,,0,0,0,,Бұл бәсекелес пе? Бұл дұрыс
Dialogue: 0,0:04:06.30,0:04:11.47,Default,,0,0,0,,Мені қандай болашақ күтіп тұрғанын білмеймін, бірақ
Dialogue: 0,0:04:11.47,0:04:15.41,Default,,0,0,0,,Бізді қандай қиындықтар күтіп тұрса да
Dialogue: 0,0:04:15.41,0:04:20.41,Default,,0,0,0,,Мен өзіме сенемін және еңбектенемін.
Dialogue: 0,0:04:20.41,0:04:23.01,Default,,0,0,0,,Мен армандарымды ұстағым келеді. Хехехе!
Dialogue: 0,0:04:25.08,0:04:28.09,Default,,0,0,0,,Мен көремін. Сосуке күшті ғой, солай емес пе?
Dialogue: 0,0:04:28.09,0:04:30.75,Default,,0,0,0,,Әрине!
Dialogue: 0,0:04:30.75,0:04:36.59,Default,,0,0,0,,Мен жаңа командада болсам да, мен әрқашан нәтиже шығарамын.
Dialogue: 0,0:04:36.59,0:04:40.60,Default,,0,0,0,,《Икуя: Үлкен аға... Дүниені көбірек көру керек дегеніңіз не?
Dialogue: 0,0:04:40.60,0:04:42.60,Default,,0,0,0,,Мен жүзуді жек көремін.
Dialogue: 0,0:04:42.60,0:04:49.94,Default,,0,0,0,,Бірақ мен жүзуді жек көруім керек... мен неге жүзіп жүрмін? 》
Dialogue: 0,0:04:49.94,0:04:52.61,Default,,0,0,0,,Нашар. Мен ертең клубтық іс-шаралардан болмаймын.
Dialogue: 0,0:04:52.61,0:04:56.11,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейсіз. Икуямен тағы ұрысып жатырсың ба?
Dialogue: 0,0:04:56.11,0:05:00.95,Default,,0,0,0,,Russee! Сіз мені мәңгілікке қуа алмайсыз.
Dialogue: 0,0:05:00.95,0:05:03.45,Default,,0,0,0,,Ол үшін?
Dialogue: 0,0:05:03.45,0:05:06.95,Default,,0,0,0,,Сіз өзіңізді қызықтыратындай сезінесіз бе?
Dialogue: 0,0:05:08.96,0:05:15.57,Default,,0,0,0,,Нацуяның сезімін Икуяға да жеткізетін уақыт келеді.
Dialogue: 0,0:05:15.57,0:05:20.47,Default,,0,0,0,,Мен ініммен мақтанамын... Нао! Мен оны қазірдің өзінде кесіп тастаймын
Dialogue: 0,0:05:22.41,0:05:25.41,Default,,0,0,0,,Майкл Хайл Бұл керемет жүзу болды.
Dialogue: 0,0:05:25.41,0:05:29.41,Default,,0,0,0,,Жаттығу кезінде сіз әрқашан не туралы ойлайсыз?
Dialogue: 0,0:05:29.41,0:05:34.08,Default,,0,0,0,,Дұрыс... Жеңіс тек өзіне сенгеннің қолында.
Dialogue: 0,0:05:34.08,0:05:37.28,Default,,0,0,0,,Бұл менің сүйікті сөзім.
Dialogue: 0,0:05:44.60,0:05:46.76,Default,,0,0,0,,Сіз оны әдемі деп ойладыңыз ба?
Dialogue: 0,0:05:46.76,0:05:48.93,Default,,0,0,0,,Ах! Аға
Dialogue: 0,0:05:48.93,0:05:52.44,Default,,0,0,0,,Жоқ, мен оны кездейсоқ көрдім...
Dialogue: 0,0:05:52.44,0:05:56.77,Default,,0,0,0,,Рей... сіз тым көп ойлап отырсыз. Адал болыңыз.
Dialogue: 0,0:05:56.77,0:05:59.11,Default,,0,0,0,,Сіз мені қызғаншақ деп ойладыңыз ғой, солай ма?
Dialogue: 0,0:05:59.11,0:06:01.11,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:06:01.11,0:06:03.11,Default,,0,0,0,,Жалпы, мен жүзе алмаймын.
Dialogue: 0,0:06:03.11,0:06:06.12,Default,,0,0,0,,Енді мұны істей алмаймын дегеніңіз не?
Dialogue: 0,0:06:06.12,0:06:10.62,Default,,0,0,0,,Кішкене армандау жаман емес, Рей.
Dialogue: 0,0:06:10.62,0:06:13.12,Default,,0,0,0,,《Рей: Арман...》
Dialogue: 0,0:06:15.06,0:06:17.96,Default,,0,0,0,,《Менің болашағым》
Dialogue: 0,0:06:19.90,0:06:22.90,Default,,0,0,0,,《Мен болашақта》
Dialogue: 0,0:06:28.07,0:06:30.91,Default,,0,0,0,,《Менің арманым...》
Dialogue: 0,0:06:30.91,0:06:35.25,Default,,0,0,0,,Иә, бұл менің арманым мен тілегім.
Dialogue: 0,0:06:35.25,0:06:39.25,Default,,0,0,0,,Ертең осында. Жаңа студенттерге арналған сәлемдесу кеші...
Dialogue: 0,0:06:39.25,0:06:43.75,Default,,0,0,0,,Жарайды. Шығарып көрейік. Рей-чан!
Dialogue: 0,0:06:43.75,0:06:46.75,Default,,0,0,0,,Дұрыс айтасың, Нағиса-күн.
Dialogue: 0,0:10:44.46,0:10:46.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:46.46,0:10:48.97,Default,,0,0,0,,Нанасе! неге мұндасың?
Dialogue: 0,0:10:48.97,0:10:50.97,Default,,0,0,0,,Мен Кон мырзадан сұрадым
Dialogue: 0,0:10:50.97,0:10:52.97,Default,,0,0,0,,Жаттығудан үйге келе жатырсыз ба?
Dialogue: 0,0:10:52.97,0:10:55.97,Default,,0,0,0,,Ах. Сіз жаттықтырушысыз, солай ма?
Dialogue: 0,0:10:55.97,0:10:58.31,Default,,0,0,0,,Олай болса, бұл не?
Dialogue: 0,0:10:58.31,0:11:01.65,Default,,0,0,0,,Комикстің кезегін көргім келеді. Турнирге аз уақыт қалды.
Dialogue: 0,0:11:01.65,0:11:05.65,Default,,0,0,0,,Сіз тек еркін жүзесіз...
Dialogue: 0,0:11:05.65,0:11:08.65,Default,,0,0,0,,Тепе-теңдікті жоғалтуыңыз мүмкін.
Dialogue: 0,0:11:08.65,0:11:11.66,Default,,0,0,0,,Сіз бұған дайынсыз ба?
Dialogue: 0,0:11:11.66,0:11:17.09,Default,,0,0,0,,Мен әрқашан суға түскенде ғана қанағаттанатынмын.
Dialogue: 0,0:11:17.09,0:11:20.49,Default,,0,0,0,,Мен бұл жеткілікті деп ойладым.
Dialogue: 0,0:11:25.44,0:11:30.61,Default,,0,0,0,,Бірақ мен үнемі жалғыз болсам, бүгінгідей болмас едім.
Dialogue: 0,0:11:30.61,0:11:33.28,Default,,0,0,0,,Ха... артымнан жүр.
Dialogue: 0,0:11:33.28,0:11:38.95,Default,,0,0,0,,Мен бәрібір сізге тек негіздерді ғана үйрете аламын.
Dialogue: 0,0:11:38.95,0:11:42.95,Default,,0,0,0,,Рахмет. (Шығыс) Урусей
Dialogue: 0,0:11:42.95,0:11:49.96,Default,,0,0,0,,《Икуя: Мен одан да күшті болуым керек...
Dialogue: 0,0:11:49.96,0:11:53.96,Default,,0,0,0,,Мен Хару сияқтымын...》
Dialogue: 0,0:11:53.96,0:11:56.96,Default,,0,0,0,,Икуя... шынымен жақсысың ба?
Dialogue: 0,0:11:58.97,0:12:01.64,Default,,0,0,0,,Мен де әлі абдырап жүрмін.
Dialogue: 0,0:12:01.64,0:12:04.64,Default,,0,0,0,,Бірақ... бұл Икуяға арналған.
Dialogue: 0,0:12:04.64,0:12:07.64,Default,,0,0,0,,Икуя! Сенімен бәрі жақсы ма?
Dialogue: 0,0:12:07.64,0:12:11.15,Default,,0,0,0,,Жарайды... жарайды.
Dialogue: 0,0:12:11.15,0:12:13.58,Default,,0,0,0,,Мен керемет сөздер айтып жатырмын.
Dialogue: 0,0:12:13.58,0:12:17.59,Default,,0,0,0,,Менің ойымша, Нацуя мұнымен шындап бетпе-бет келетін кез келді.
Dialogue: 0,0:12:17.59,0:12:20.09,Default,,0,0,0,,Жүзу және Икуя
Dialogue: 0,0:12:20.09,0:12:24.09,Default,,0,0,0,,《Икуя: мен оны сол кезде көрдім》
Dialogue: 0,0:12:24.09,0:12:27.93,Default,,0,0,0,,Икуяның көмегімен Икуя өзі қалаған адам бола алады!
Dialogue: 0,0:12:27.93,0:12:30.93,Default,,0,0,0,,Икуя күшті
Dialogue: 0,0:12:30.93,0:12:33.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:36.44,0:12:39.44,Default,,0,0,0,,Оның ауа райына қатысы жоқ!
Dialogue: 0,0:12:41.95,0:12:44.45,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:44.45,0:12:48.45,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:12:48.45,0:12:51.45,Default,,0,0,0,,Мен де жақсы айта алмаймын.
Dialogue: 0,0:12:51.45,0:12:54.96,Default,,0,0,0,,Егер сіз Харумен бірге жүзсеңіз, түсінетініңізге сенімдімін.
Dialogue: 0,0:12:54.96,0:13:00.13,Default,,0,0,0,,Өйткені судағы Халдың ерекше сүйкімділігі бар.
Dialogue: 0,0:13:00.13,0:13:04.30,Default,,0,0,0,,Ақыры мен сенімен сөйлесуге тура келді. Жақсы жүрдің бе?
Dialogue: 0,0:13:04.30,0:13:06.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:08.64,0:13:12.08,Default,,0,0,0,,Мен Асахимен кездескеніме қуаныштымын. Икуя?
Dialogue: 0,0:13:12.08,0:13:15.25,Default,,0,0,0,,《Икуя: Мен күштірек болуым керек.
Dialogue: 0,0:13:15.25,0:13:19.75,Default,,0,0,0,,Мен ешкімге сенбеймін, жалғызбын...》
Dialogue: 0,0:13:23.25,0:13:25.76,Default,,0,0,0,,Хару!? Неге...
Dialogue: 0,0:13:25.76,0:13:29.76,Default,,0,0,0,,Өйткені мен мұны істемесем, сенімен бірге жүзе алмас едім.
Dialogue: 0,0:13:29.76,0:13:32.76,Default,,0,0,0,,Бәрін өз қолыңнан аламын деп айтпа.
Dialogue: 0,0:13:32.76,0:13:35.77,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:13:35.77,0:13:38.60,Default,,0,0,0,,Харука - жеке құрама?
Dialogue: 0,0:13:38.60,0:13:41.94,Default,,0,0,0,,Бұл жақсы сәйкестік болатын сияқты.
Dialogue: 0,0:13:41.94,0:13:46.94,Default,,0,0,0,,Енді... мен сіздерге арнайы тренингіміздің нәтижесін көрсетейін.
Dialogue: 0,0:13:46.94,0:13:50.45,Default,,0,0,0,,Бағаларыңызды алыңыз. (Электронды тапанша дыбысы)
Dialogue: 0,0:13:50.45,0:13:52.45,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:13:54.95,0:13:58.29,Default,,0,0,0,,Уау! Көбелек. Хару Керемет!
Dialogue: 0,0:13:58.29,0:14:00.79,Default,,0,0,0,,Бірақ Икуя...
Dialogue: 0,0:14:00.79,0:14:02.96,Default,,0,0,0,,Олай емес сияқты
Dialogue: 0,0:14:02.96,0:14:05.56,Default,,0,0,0,,Сумен соғысып жатқан сияқты.
Dialogue: 0,0:14:08.97,0:14:12.24,Default,,0,0,0,,Харука бұрылысы да аяқталуда.
Dialogue: 0,0:14:12.24,0:14:17.24,Default,,0,0,0,,Мен бұл оқиғаны бірінші рет жасап жатқаныма сене алар емеспін.
Dialogue: 0,0:14:17.24,0:14:21.24,Default,,0,0,0,,《Икуя: Хахаха... Неге мен қалағандай жүзе алмаймын?
Dialogue: 0,0:14:21.24,0:14:24.91,Default,,0,0,0,,Су ауыр
Dialogue: 0,0:14:24.91,0:14:29.92,Default,,0,0,0,,Ха ха ха…
Dialogue: 0,0:14:29.92,0:14:33.02,Default,,0,0,0,,А... Хару? 》
Dialogue: 0,0:14:35.09,0:14:38.43,Default,,0,0,0,,《Су дыбысы, еркін дыбыс
Dialogue: 0,0:14:38.43,0:14:43.93,Default,,0,0,0,,Өзіңізді ұстамаңыз немесе жылдамдыққа ие болмаңыз.
Dialogue: 0,0:14:43.93,0:14:46.93,Default,,0,0,0,,Осылай тегін болған дұрыс па? 》
Dialogue: 0,0:14:48.94,0:14:52.61,Default,,0,0,0,,《Хал содан бері өзгерген жоқ.
Dialogue: 0,0:14:52.61,0:14:55.61,Default,,0,0,0,,Өзгерген менмін.
Dialogue: 0,0:14:55.61,0:15:00.62,Default,,0,0,0,,Білмей жүрегімде саңылау жасадым...
Dialogue: 0,0:15:00.62,0:15:08.96,Default,,0,0,0,,Бірақ мен неге сонша жүзуді жалғастырғанымды түсіндім деп ойлаймын.
Dialogue: 0,0:15:08.96,0:15:13.23,Default,,0,0,0,,Жалғыз өмір сүру үшін күшті болмаңыз
Dialogue: 0,0:15:13.23,0:15:16.73,Default,,0,0,0,,Біреу үшін күшті болудың қажеті жоқ
Dialogue: 0,0:15:16.73,0:15:19.07,Default,,0,0,0,,Міне нағыз күш...
Dialogue: 0,0:15:19.07,0:15:24.57,Default,,0,0,0,,Оған қол жеткізу, әрине, нағыз еркіндік.
Dialogue: 0,0:15:24.57,0:15:27.41,Default,,0,0,0,,Су өзгерді
Dialogue: 0,0:15:27.41,0:15:30.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:32.92,0:15:36.52,Default,,0,0,0,,Икуя қайтып келді...
Dialogue: 0,0:15:42.59,0:15:46.99,Default,,0,0,0,,Екеуің~! Бар!
Dialogue: 0,0:15:54.94,0:15:57.77,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:57.77,0:16:00.28,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:16:00.28,0:16:02.48,Default,,0,0,0,,Хару!
Dialogue: 0,0:16:04.45,0:16:06.45,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:16:06.45,0:16:08.45,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:16:10.45,0:16:14.05,Default,,0,0,0,,Енді мен уәдемді орындай аламын.
Dialogue: 0,0:16:16.06,0:16:19.06,Default,,0,0,0,,Сен мені есіңе түсірдің.
Dialogue: 0,0:16:19.06,0:16:21.76,Default,,0,0,0,,Ұмытуға жол жоқ.
Dialogue: 0,0:16:26.24,0:16:28.57,Default,,0,0,0,,Хару…
Dialogue: 0,0:16:28.57,0:16:30.57,Default,,0,0,0,,Хару!
Dialogue: 0,0:16:30.57,0:16:36.08,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:16:36.08,0:16:39.28,Default,,0,0,0,,Қазір бәрі жақсы сияқты.
Dialogue: 0,0:16:41.25,0:16:44.25,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:16:48.76,0:16:52.76,Default,,0,0,0,,О! Ол сонда болды. (Икуя) Асахи. Макото
Dialogue: 0,0:16:52.76,0:16:55.77,Default,,0,0,0,,Сіз не туралы айттыңыз? иә?
Dialogue: 0,0:16:55.77,0:16:58.94,Default,,0,0,0,,Бұл оқу-жаттығу жиынының түнінде айтқан тілек туралы. Эй... Хару!
Dialogue: 0,0:16:58.94,0:17:01.94,Default,,0,0,0,,Не? Икуя! Сол оқиғаны айтып берейін.
Dialogue: 0,0:17:01.94,0:17:03.94,Default,,0,0,0,,Менің де естігім келеді!
Dialogue: 0,0:17:03.94,0:17:07.28,Default,,0,0,0,,Сол кезде мен тіледім
Dialogue: 0,0:17:07.28,0:17:09.78,Default,,0,0,0,,Мен Хару сияқты болғым келеді
Dialogue: 0,0:17:09.78,0:17:12.55,Default,,0,0,0,,Мен Хал сияқты батыр болғым келеді.
Dialogue: 0,0:17:12.55,0:17:14.55,Default,,0,0,0,,Батыр? Иә...
Dialogue: 0,0:17:14.55,0:17:19.72,Default,,0,0,0,,Батыр дегеніміз зұлымдықпен күрескен батырды емес, жұрттың бәрі қарап тұратын батырды білдіреді.
Dialogue: 0,0:17:19.72,0:17:22.73,Default,,0,0,0,,Біреу уайымдағанда немесе тоқтағанда
Dialogue: 0,0:17:22.73,0:17:24.73,Default,,0,0,0,,Көмектесетін адам
Dialogue: 0,0:17:24.73,0:17:26.73,Default,,0,0,0,,Не? ол
Dialogue: 0,0:17:26.73,0:17:29.73,Default,,0,0,0,,Хару ұялшақ. Ұялшақ емес.
Dialogue: 0,0:17:29.73,0:17:34.24,Default,,0,0,0,,Икуя тіпті біреудің кейіпкері болуы мүмкін.
Dialogue: 0,0:17:34.24,0:17:36.91,Default,,0,0,0,,Бұл рас... Бұл рас.
Dialogue: 0,0:17:36.91,0:17:39.91,Default,,0,0,0,,Мен оны Хару сияқты түсінбеймін!
Dialogue: 0,0:17:39.91,0:17:41.91,Default,,0,0,0,,Макото...
Dialogue: 0,0:17:41.91,0:17:47.08,Default,,0,0,0,,Батырлар өздерін батыр санамағандықтан батыр.
Dialogue: 0,0:17:47.08,0:17:50.09,Default,,0,0,0,,Ал мен оны жақсы қорытындылағанда...
Dialogue: 0,0:17:50.09,0:17:54.09,Default,,0,0,0,,Өзіңіз айтыңызшы? Ха! Жақында қайтамыз ба?
Dialogue: 0,0:17:54.09,0:17:56.09,Default,,0,0,0,,Әлі ойнайтын ойын бар.
Dialogue: 0,0:17:56.09,0:18:00.10,Default,,0,0,0,,Икуяның Шимогакудағы достарына айтары бар деп ойламайсың ба?
Dialogue: 0,0:18:00.10,0:18:02.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:02.10,0:18:04.10,Default,,0,0,0,,Кел, Икуя.
Dialogue: 0,0:18:07.60,0:18:11.77,Default,,0,0,0,,Сенде ондайға батылың жетпейді ғой
Dialogue: 0,0:18:11.77,0:18:14.04,Default,,0,0,0,,Бұл не болып жатыр өзі?
Dialogue: 0,0:18:14.04,0:18:17.55,Default,,0,0,0,,Күткендей, Икуя керемет.
Dialogue: 0,0:18:17.55,0:18:21.05,Default,,0,0,0,,Нақты орындау нәтиже береді.
Dialogue: 0,0:18:23.89,0:18:26.89,Default,,0,0,0,,Ауа-райы... деп ойладым
Dialogue: 0,0:18:26.89,0:18:31.56,Default,,0,0,0,,Мен эстафетаны қайтадан жүзгім келеді.
Dialogue: 0,0:18:31.56,0:18:34.23,Default,,0,0,0,,Нанасемен?
Dialogue: 0,0:18:34.23,0:18:38.57,Default,,0,0,0,,Жоқ! Олай емес...
Dialogue: 0,0:18:38.57,0:18:44.57,Default,,0,0,0,,Ойланып қарасам, мен Хиоримен ешқашан эстафеталық жарыста жүзіп көрмеппін.
Dialogue: 0,0:18:44.57,0:18:49.25,Default,,0,0,0,,Бірақ мен қазір басқаруды сәтті қолға алатындай сезінемін.
Dialogue: 0,0:18:49.25,0:18:51.75,Default,,0,0,0,,Жақсы күн болса...
Dialogue: 0,0:18:51.75,0:18:55.75,Default,,0,0,0,,Ей... Жүзейік, жақсы күн
Dialogue: 0,0:19:00.42,0:19:03.52,Default,,0,0,0,,Түсіндім, Икуя.
Dialogue: 0,0:19:07.60,0:19:12.54,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:19:12.54,0:19:16.54,Default,,0,0,0,,Бағаларыңызды алыңыз. (Электронды тапанша дыбысы)
Dialogue: 0,0:19:16.54,0:19:18.54,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:19:18.54,0:19:21.44,Default,,0,0,0,,Алға, ағайын!
Dialogue: 0,0:19:28.72,0:19:30.72,Default,,0,0,0,,Кирю жүр!
Dialogue: 0,0:19:33.72,0:19:36.56,Default,,0,0,0,,Асахи! Сіз кездейсоқ қобалжыдыңыз ба?
Dialogue: 0,0:19:36.56,0:19:40.56,Default,,0,0,0,,Хе! Мүмкін емес. Икуя қобалжыған адам емес пе?
Dialogue: 0,0:19:40.56,0:19:44.73,Default,,0,0,0,,Жарайды. Мен мұнда жаңа ғана айна алдында келдім.
Dialogue: 0,0:19:44.73,0:19:49.24,Default,,0,0,0,,Мен данышпанмын Мен данышпанмын
Dialogue: 0,0:19:49.24,0:19:52.24,Default,,0,0,0,,Жоқ! Теме... Алдамаңыз!
Dialogue: 0,0:19:56.58,0:19:58.58,Default,,0,0,0,,Шиина!
Dialogue: 0,0:19:58.58,0:20:00.58,Default,,0,0,0,,Киришима!
Dialogue: 0,0:20:07.59,0:20:09.99,Default,,0,0,0,,Достар...
Dialogue: 0,0:20:11.93,0:20:14.60,Default,,0,0,0,,Икуяға сену
Dialogue: 0,0:20:14.60,0:20:18.00,Default,,0,0,0,,Сен айтпасаң да сенемін
Dialogue: 0,0:20:21.44,0:20:23.94,Default,,0,0,0,,Жақсы ауа-райы!
Dialogue: 0,0:20:26.28,0:20:28.58,Default,,0,0,0,,Хару!
Dialogue: 0,0:20:35.45,0:20:41.45,Default,,0,0,0,,《Бұл... Нанасенің Икуя сезінген еркіндігі》
Dialogue: 0,0:20:43.46,0:20:48.97,Default,,0,0,0,,Макото: Егер сіз Харумен бірге жүзсеңіз, түсінетініңізге сенімдімін.
Dialogue: 0,0:20:48.97,0:20:52.97,Default,,0,0,0,,Сіз сәл жеңілірек жүзе білуіңіз керек.
Dialogue: 0,0:20:52.97,0:20:57.64,Default,,0,0,0,,《Шынымды айтсам суда...》
Dialogue: 0,0:20:57.64,0:21:00.31,Default,,0,0,0,,Жақсы ауа-райы!
Dialogue: 0,0:21:00.31,0:21:04.31,Default,,0,0,0,,Жақсы ауа-райы!
Dialogue: 0,0:21:06.32,0:21:09.32,Default,,0,0,0,,《Мен аздап түсіндім деп ойлаймын.
Dialogue: 0,0:21:09.32,0:21:15.26,Default,,0,0,0,,Нанасе мен Икуя туралы...》
Dialogue: 0,0:21:15.26,0:21:17.76,Default,,0,0,0,,Тоно жылдамдауда
Dialogue: 0,0:21:19.93,0:21:23.43,Default,,0,0,0,,Тоно! Жақсы ауа-райы!
Dialogue: 0,0:21:23.43,0:21:25.43,Default,,0,0,0,,Хару! Нанасе! Нанасе!
Dialogue: 0,0:21:33.78,0:21:39.12,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:39.12,0:21:42.12,Default,,0,0,0,,Бұл менің жоғалтуым.
Dialogue: 0,0:21:42.12,0:21:44.52,Default,,0,0,0,,Бос Хана
Dialogue: 0,0:21:47.12,0:21:49.52,Default,,0,0,0,,Икуя…
Dialogue: 0,0:21:51.96,0:21:56.96,Default,,0,0,0,,Хиори... Менімен бірге жүзгеніңіз үшін рахмет.
Dialogue: 0,0:21:58.97,0:22:01.97,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:22:01.97,0:22:03.97,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:22:08.64,0:22:11.91,Default,,0,0,0,,Бұл керемет, Нанасе-кун.
Dialogue: 0,0:22:11.91,0:22:14.41,Default,,0,0,0,,Өсуге орын бар. иә?
Dialogue: 0,0:22:16.42,0:22:18.92,Default,,0,0,0,,Бұл оның әлі де өзгеретінін білдіре ме?
Dialogue: 0,0:22:18.92,0:22:24.42,Default,,0,0,0,,Оның не болатынын көру қызықты болады.
Dialogue: 0,0:22:26.93,0:22:28.93,Default,,0,0,0,,Сәлем ауа-райы
Dialogue: 0,0:22:28.93,0:22:33.44,Default,,0,0,0,,Бұл менің балабақша кезімдегі оқиға.
Dialogue: 0,0:22:33.44,0:22:36.77,Default,,0,0,0,,Ол кезде мен жүзу мектебіне бардым.
Dialogue: 0,0:22:36.77,0:22:41.94,Default,,0,0,0,,Әрқашан жалғыз жүзетін бала болатын.
Dialogue: 0,0:22:41.94,0:22:45.95,Default,,0,0,0,,Мен ол қызбен дос болғым келеді.
Dialogue: 0,0:22:45.95,0:22:49.29,Default,,0,0,0,,Бірақ мен сенімен шынымен сөйлесе алмаймын.
Dialogue: 0,0:22:49.29,0:22:52.46,Default,,0,0,0,,Бір күні мен сенімен сөйлестім.
Dialogue: 0,0:22:52.46,0:22:57.29,Default,,0,0,0,,Сосын күлді.
Dialogue: 0,0:22:57.29,0:23:00.63,Default,,0,0,0,,Керемет күлімсіреп
Dialogue: 0,0:23:00.63,0:23:04.63,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:23:07.64,0:23:14.04,Default,,0,0,0,,Ол баланы... Икуяның күлкісі құтқарып қалғанына сенімдімін.
Dialogue: 0,0:23:16.25,0:23:20.75,Default,,0,0,0,,Ол бала үшін Икуя батыр еді.
Dialogue: 0,0:23:20.75,0:23:23.25,Default,,0,0,0,,Иә! үлкен аға
Dialogue: 0,0:23:23.25,0:23:26.26,Default,,0,0,0,,Иә! Құттықтаймыз
Dialogue: 0,0:23:26.26,0:23:28.26,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:28.26,0:23:30.93,Default,,0,0,0,,Кешіріңіз Икуя
Dialogue: 0,0:23:30.93,0:23:34.26,Default,,0,0,0,,Менің ағам неге кешірім сұрайды?
Dialogue: 0,0:23:34.26,0:23:37.77,Default,,0,0,0,,Дұрыс. Мен сізге алғыс айтуым керек.
Dialogue: 0,0:23:37.77,0:23:40.77,Default,,0,0,0,,Сіздің арқаңызда арманым орындалды. иә?
Dialogue: 0,0:23:40.77,0:23:44.27,Default,,0,0,0,,Менің арманым бір күні сенімен әлемде күресу.
Dialogue: 0,0:23:44.27,0:23:47.28,Default,,0,0,0,,Менің арманым – әлемнің ең жақсысы болу.
Dialogue: 0,0:23:47.28,0:23:49.28,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:23:49.28,0:23:53.28,Default,,0,0,0,,Сіз жылап жатырсыз ба? Баркер! Жылама
Dialogue: 0,0:23:58.79,0:24:01.29,Default,,0,0,0,,Сіз қызықсыз көрінесіз.
Dialogue: 0,0:24:01.29,0:24:06.96,Default,,0,0,0,,Жоқ, мен Икуяның бір жағын ғана көрдім.
Dialogue: 0,0:24:06.96,0:24:10.30,Default,,0,0,0,,Мм...｡ Ах, мен Такасуми Шигиномын
Dialogue: 0,0:24:10.30,0:24:13.24,Default,,0,0,0,,Эй, автобус шеңберіне бірге қосылғыларың келе ме?
Dialogue: 0,0:24:13.24,0:24:16.91,Default,,0,0,0,,Хахаха! Мен бұл туралы ойланамын
Dialogue: 0,0:24:16.91,0:24:35.91,Default,,0,0,0,,～
Dialogue: 0,0:24:38.59,0:24:41.26,Default,,0,0,0,,Сізбен кездесе бастағаным үшін кешіріңіз.
Dialogue: 0,0:24:41.26,0:24:43.27,Default,,0,0,0,,Жоқ, мен жай ғана
Dialogue: 0,0:24:43.27,0:24:46.27,Default,,0,0,0,,Мен жаңа жүзу сүлгісін алғым келді.
Dialogue: 0,0:24:48.60,0:24:51.61,Default,,0,0,0,,Тіпті тапиока қосылған ходжича латте!
Dialogue: 0,0:24:51.61,0:24:53.94,Default,,0,0,0,,Сіз де Хару ішіп көргіңіз келе ме?
Dialogue: 0,0:24:53.94,0:24:56.61,Default,,0,0,0,,Ах
Dialogue: 0,0:24:56.61,0:24:58.61,Default,,0,0,0,,Оның біртүрлі дәмі бар.
Dialogue: 0,0:24:58.61,0:25:01.62,Default,,0,0,0,,Токиода көп нәрсе бар.
Dialogue: 0,0:25:01.62,0:25:03.95,Default,,0,0,0,,Сіз тым көңілді болып жатырсыз. (Макото) Фуфуфу!
Dialogue: 0,0:25:03.95,0:25:05.96,Default,,0,0,0,,Ах! Хару бұл?
Dialogue: 0,0:25:05.96,0:25:08.96,Default,,0,0,0,,Егер есімде дұрыс болса, бұл скумбрия пюресі жинағы болуы керек...
Dialogue: 0,0:25:08.96,0:25:10.96,Default,,0,0,0,,Макото оны да жей ме?
Dialogue: 0,0:25:10.96,0:25:13.23,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:25:13.23,0:25:15.56,Default,,0,0,0,,Пулдың толық емес жұмыс күні қалай жұмыс істейді?
Dialogue: 0,0:25:15.56,0:25:19.24,Default,,0,0,0,,Иә... Барлығының атын еске түсіру әлі қиын.
Dialogue: 0,0:25:19.24,0:25:23.24,Default,,0,0,0,,Ах! Мисаки-кун, мен жасөспірімдер арасындағы турнирге қатысамын.
Dialogue: 0,0:25:23.24,0:25:25.24,Default,,0,0,0,,көремін. Иә.
Dialogue: 0,0:25:25.24,0:25:28.24,Default,,0,0,0,,Мен жеңілгім келмес үшін жаттығуды жалғастырамын
Dialogue: 0,0:25:28.24,0:25:30.94,Default,,0,0,0,,Шынымды айтсам, мен қарт Ринге қарап тұрғандай болдым.
Dialogue: 0,0:25:33.42,0:25:36.92,Default,,0,0,0,,Оқу-жаттығу лагері және соған ұқсас нәрселер... Мен шынымен бос емеспін, солай емес пе?
Dialogue: 0,0:25:36.92,0:25:39.26,Default,,0,0,0,,Макото да бос емес, солай ма?
Dialogue: 0,0:25:39.26,0:25:43.26,Default,,0,0,0,,Хахаха... Иә, мен тым көп лекция оқыған шығармын.
Dialogue: 0,0:25:43.26,0:25:45.93,Default,,0,0,0,,Университет студенті болу қиын.
Dialogue: 0,0:25:45.93,0:25:48.76,Default,,0,0,0,,Фуфуфуфу! Не болды?
Dialogue: 0,0:25:48.76,0:25:51.77,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:25:51.77,0:25:54.77,Default,,0,0,0,,Фуфуфуфу!
Dialogue: 0,0:25:54.77,0:25:57.27,Default,,0,0,0,,Жаттығу уақыты жақындап қалды.
Dialogue: 0,0:25:57.27,0:26:00.28,Default,,0,0,0,,Аа, дұрыс. Мен сізге қайта хабарласамын.
Dialogue: 0,0:26:00.28,0:26:03.28,Default,,0,0,0,,Иә, сәттілік!
Dialogue: 0,0:26:03.28,0:26:07.98,Default,,0,0,0,,Ах! Мен дәрісте пайдалану үшін кітапты сатып алуды ұмытып кетіппін.
Dialogue: 0,0:26:13.89,0:26:16.73,Default,,0,0,0,,Ах! Жақсы...
Dialogue: 0,0:26:16.73,0:26:18.73,Default,,0,0,0,,Әлі қалды... Иә?
Dialogue: 0,0:26:18.73,0:26:20.73,Default,,0,0,0,,Сусуке?
Dialogue: 0,0:26:20.73,0:26:22.73,Default,,0,0,0,,Макото?
Dialogue: 0,0:26:22.73,0:26:24.73,Default,,0,0,0,,Бұл жерде болды, солай емес пе?
Dialogue: 0,0:26:24.73,0:26:28.24,Default,,0,0,0,,Ах. Сіз қалай ойлайсыз? Токиоға үйреніп қалдыңыз ба?
Dialogue: 0,0:26:28.24,0:26:32.91,Default,,0,0,0,,Жоқ, мүлде емес. Пойыз бен вокзалдағы адамдар керемет...
Dialogue: 0,0:26:32.91,0:26:38.58,Default,,0,0,0,,Хехе, мен Куджиразуға орта мектепте келгенде, қайда барсам да таң қалдым.
Dialogue: 0,0:26:38.58,0:26:40.58,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:26:40.58,0:26:43.92,Default,,0,0,0,,Сусуке әрқашан сабырлы көрінеді.
Dialogue: 0,0:26:43.92,0:26:46.92,Default,,0,0,0,,Біраз таң қалдырады. Сіз мені қандай деп ойлайсыз?
Dialogue: 0,0:26:46.92,0:26:48.92,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:26:48.92,0:26:51.59,Default,,0,0,0,,Мектеп фестивалінде тіпті Макото да солай болды.
Dialogue: 0,0:26:51.59,0:26:56.27,Default,,0,0,0,,Мен оның таңғаларлық мінезі бар деп ойладым.
Dialogue: 0,0:26:56.27,0:26:59.77,Default,,0,0,0,,Әй... Мен мүлде таң қалмаймын!
Dialogue: 0,0:26:59.77,0:27:03.94,Default,,0,0,0,,Мен мұны қалдырамын.
Dialogue: 0,0:27:03.94,0:27:06.94,Default,,0,0,0,,Жабайы қызық болды, солай емес пе?
Dialogue: 0,0:27:06.94,0:27:10.94,Default,,0,0,0,,Аа, қазір ойласам да күліп жіберемін
Dialogue: 0,0:27:12.88,0:27:16.55,Default,,0,0,0,,Сусуке... оның жүзі біраз жарқырап кетті.
Dialogue: 0,0:27:16.55,0:27:20.55,Default,,0,0,0,,Негізі мен біраз уайымдадым.
Dialogue: 0,0:27:23.23,0:27:25.73,Default,,0,0,0,,Балалар мен сендерге ризамын.
Dialogue: 0,0:27:25.73,0:27:27.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:27.73,0:27:31.73,Default,,0,0,0,,Ол кезде мен ештеңе істей алмайтынмын.
Dialogue: 0,0:27:31.73,0:27:39.24,Default,,0,0,0,,Мен арманым орындалды деп ойладым, өйткені мен оған барымды бердім.
Dialogue: 0,0:27:39.24,0:27:44.58,Default,,0,0,0,,Бірақ сендермен қыдырған соң өзімді жеңіл сезінемін.
Dialogue: 0,0:27:44.58,0:27:52.76,Default,,0,0,0,,Мен Риннің неліктен эстафеталарға ерекше мән бергенін аздап түсіндім деп ойлаймын.
Dialogue: 0,0:27:52.76,0:27:57.76,Default,,0,0,0,,Эстафетаңызды көргендегі шынайы сезімдер
Dialogue: 0,0:28:00.43,0:28:05.43,Default,,0,0,0,,Ай мен басқалардың шақыруымен мен сапарға шығып, Нацуя-санды кездестірдім.
Dialogue: 0,0:28:05.43,0:28:07.94,Default,,0,0,0,,Ай мен Момо артқа итеріп жіберді
Dialogue: 0,0:28:07.94,0:28:13.38,Default,,0,0,0,,А... Кішкентай кезімде көрген түс есіме түскендей болды.
Dialogue: 0,0:28:13.38,0:28:20.98,Default,,0,0,0,,Сусуке: Одан да күшті болу арманы, таңғажайып жерде күресу арманы
Dialogue: 0,0:28:24.05,0:28:28.06,Default,,0,0,0,,Қатты тырыссаңыз, бір жерде қайтадан жүзе аласыз.
Dialogue: 0,0:28:28.06,0:28:31.39,Default,,0,0,0,,Өз әлеуетіңізді сындырмаңыз
Dialogue: 0,0:28:31.39,0:28:34.73,Default,,0,0,0,,Әй... бұл сөздерді біреуден естідім.
Dialogue: 0,0:28:34.73,0:28:37.23,Default,,0,0,0,,Сусуке…
Dialogue: 0,0:28:37.23,0:28:41.90,Default,,0,0,0,,Ал... мен жауап беруім керек.
Dialogue: 0,0:28:41.90,0:28:44.57,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:28:44.57,0:28:47.91,Default,,0,0,0,,Операцияны осында жасауды шештім.
Dialogue: 0,0:28:47.91,0:28:51.91,Default,,0,0,0,,Бұрынғыдай жүзе алатынымды білмеймін, бірақ...
Dialogue: 0,0:28:51.91,0:28:54.42,Default,,0,0,0,,Иә
Dialogue: 0,0:28:54.42,0:28:58.92,Default,,0,0,0,,Мен де Сосукеден ұтыла алмаймын. иә?
Dialogue: 0,0:28:58.92,0:29:01.59,Default,,0,0,0,,Мен көбірек оқып, көп жұмыс істеу керек деп ойладым.
Dialogue: 0,0:29:01.59,0:29:03.59,Default,,0,0,0,,Бұл не? Кенеттен...
Dialogue: 0,0:29:03.59,0:29:06.60,Default,,0,0,0,,Ақыр соңында, мен Сосуке керемет деп ойладым.
Dialogue: 0,0:29:06.60,0:29:08.93,Default,,0,0,0,,Не? ол
Dialogue: 0,0:29:08.93,0:29:12.87,Default,,0,0,0,,Жағдай қайтадан тынышталған соң, тамақ ішейік, Макото.
Dialogue: 0,0:29:12.87,0:29:15.70,Default,,0,0,0,,Иә, ықыласпен
Dialogue: 0,0:29:15.70,0:29:20.88,Default,,0,0,0,,Уау~ Университет чемпионатында Харука Сенпай өте керемет болды!
Dialogue: 0,0:29:20.88,0:29:23.88,Default,,0,0,0,,Әй, ол теңіз тасбақасындай жүзіп жүрді.
Dialogue: 0,0:29:23.88,0:29:26.72,Default,,0,0,0,,Пікірлер керемет болды, әсіресе тегін!
Dialogue: 0,0:29:26.72,0:29:29.72,Default,,0,0,0,,Бұл сумен бір болып көрінді...
Dialogue: 0,0:29:29.72,0:29:32.05,Default,,0,0,0,,Бұл дәл Вакаменің өзі сияқты болды.
Dialogue: 0,0:29:32.05,0:29:35.06,Default,,0,0,0,,Бұл оның дірілдеп тұрғанын білдіре ме?
Dialogue: 0,0:29:35.06,0:29:37.39,Default,,0,0,0,,Аюму! Оны таратудың қажеті жоқ
Dialogue: 0,0:29:37.39,0:29:39.73,Default,,0,0,0,,Ромео Исеби сияқты ашуланба.
Dialogue: 0,0:29:39.73,0:29:42.40,Default,,0,0,0,,Сондықтан теңіз өнімдерін ұқсастық ретінде қолданбаңыз!
Dialogue: 0,0:29:42.40,0:29:45.73,Default,,0,0,0,,Сонымен қатар Ромео-кун мен Шизуру-кун оқу-жаттығу жиынында.
Dialogue: 0,0:29:45.73,0:29:47.74,Default,,0,0,0,,Бұл өте жақсы жүзу болды.
Dialogue: 0,0:29:47.74,0:29:50.24,Default,,0,0,0,,Тапсырыс та өте әдемі...
Dialogue: 0,0:29:50.24,0:29:53.24,Default,,0,0,0,,Жоқ, мұның бәрі директор Рей мен Нағиса-сенпайдың арқасында.
Dialogue: 0,0:29:53.24,0:29:58.25,Default,,0,0,0,,Ол әдетте сондай ақкөңіл, бірақ матчқа түскенде қатты ашуланады.
Dialogue: 0,0:29:58.25,0:30:03.75,Default,,0,0,0,,Екеуміз үшін де мектептегі соңғы жаз, бірақ мен аяғымды сүйретіп келе жатырмын...
Dialogue: 0,0:30:03.75,0:30:05.75,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:30:05.75,0:30:09.45,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз. Неге мұны жоғарыдан істеп жатырсың!?
Dialogue: 0,0:30:11.76,0:30:13.76,Default,,0,0,0,,(All Might-тың ауыр демі)
Dialogue: 0,0:30:13.76,0:30:16.10,Default,,0,0,0,,Ең алдымен префектуралық турнирге бар күшімізді салайық.
Dialogue: 0,0:30:16.10,0:30:18.10,Default,,0,0,0,,Ах! (Аюму) Иә!
Dialogue: 0,0:30:18.10,0:30:20.10,Default,,0,0,0,,О!
Dialogue: 0,0:30:20.10,0:30:23.77,Default,,0,0,0,,Роми-чан да, Шизу-чан да өз уақыттарын жаңартып жатыр!
Dialogue: 0,0:30:23.77,0:30:26.78,Default,,0,0,0,,Мен суды алу тәсілі өзгерген сияқты.
Dialogue: 0,0:30:26.78,0:30:30.28,Default,,0,0,0,,Хмм, жеке алғанда ол өсіп жатыр.
Dialogue: 0,0:30:30.28,0:30:34.28,Default,,0,0,0,,Соңғы релелерде...уақыт біркелкі.
Dialogue: 0,0:30:34.28,0:30:38.62,Default,,0,0,0,,Эстафетаға келетін болсақ, мен өзімді көңілсіз сезінемін...
Dialogue: 0,0:30:38.62,0:30:41.96,Default,,0,0,0,,Бұл триггердің қандай да бір түрі бар дегенді білдіре ме?
Dialogue: 0,0:30:41.96,0:30:44.29,Default,,0,0,0,,Хмм…｡ (есіктің ашылған дыбысы)
Dialogue: 0,0:30:44.29,0:30:47.96,Default,,0,0,0,,Қараңдар, қараңдар! Мен саған сыйлық әкелдім.
Dialogue: 0,0:30:47.96,0:30:50.97,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:30:50.97,0:30:52.97,Default,,0,0,0,,Рахмет, Тен-чан!
Dialogue: 0,0:30:52.97,0:30:54.97,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:30:54.97,0:30:58.97,Default,,0,0,0,,Жаттығу жиынында сендер өте жарқын көріндіңдер.
Dialogue: 0,0:30:58.97,0:31:03.98,Default,,0,0,0,,Иә, Ромео-кун, Шизуру-кун және Аюму-чан да өте қатты жұмыс істейді.
Dialogue: 0,0:31:03.98,0:31:05.98,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:31:05.98,0:31:08.48,Default,,0,0,0,,Сондықтан мен келесі аралас эстафетаға барамын.
Dialogue: 0,0:31:08.48,0:31:11.82,Default,,0,0,0,,Мен одан толық ләззат алғым келеді, бәріңіз!
Dialogue: 0,0:31:11.82,0:31:15.76,Default,,0,0,0,,Мен жаздың ең жақсы естеліктерін бірге ойып алғым келеді.
Dialogue: 0,0:31:15.76,0:31:17.76,Default,,0,0,0,,Ол қазір Рин-Чанға ұқсайды!
Dialogue: 0,0:31:17.76,0:31:19.76,Default,,0,0,0,,Жақсы! Шынымен бе?
Dialogue: 0,0:31:19.76,0:31:22.93,Default,,0,0,0,,Бірақ эстафеталарда уақыт баяу, солай ма?
Dialogue: 0,0:31:22.93,0:31:24.93,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:31:24.93,0:31:26.94,Default,,0,0,0,,Роми-чан және басқалар эстафетада
Dialogue: 0,0:31:26.94,0:31:30.27,Default,,0,0,0,,Оның мейірімді мінезі оны жүзуге мәжбүр етеді...
Dialogue: 0,0:31:30.27,0:31:33.28,Default,,0,0,0,,Менің ойымша, сен ойланбастан жүзуге тырысатын сияқтысың ба?
Dialogue: 0,0:31:33.28,0:31:36.28,Default,,0,0,0,,Мен өзімді көбірек көрсете алғым келеді.
Dialogue: 0,0:31:36.28,0:31:38.61,Default,,0,0,0,,Рейкун, сен көп жеп тұрған жоқсың ба?
Dialogue: 0,0:31:38.61,0:31:42.28,Default,,0,0,0,,Кешіріңіз. Мен тек жеңіл түскі ас іштім.
Dialogue: 0,0:31:42.28,0:31:46.79,Default,,0,0,0,,Бірақ бұл қиын, солай емес пе? Үлкендер өте қамқор.
Dialogue: 0,0:31:46.79,0:31:48.79,Default,,0,0,0,,Менің ойымша?
Dialogue: 0,0:31:48.79,0:31:50.79,Default,,0,0,0,,Мүмкін бірдеңе дұрыс емес шығар
Dialogue: 0,0:31:50.79,0:31:55.30,Default,,0,0,0,,Олай болса, бірге секірсек қайтеді? Барлығы бұлшық ет биімен айналысса ше?
Dialogue: 0,0:31:55.30,0:31:57.63,Default,,0,0,0,,О! Көңілді сияқты. (E) Иә, иә!
Dialogue: 0,0:31:57.63,0:32:03.31,Default,,0,0,0,,Мен әркімнің арасындағы байланысты тереңдететін іс жасағым келеді.
Dialogue: 0,0:32:03.31,0:32:05.64,Default,,0,0,0,,Жылы.
Dialogue: 0,0:32:05.64,0:32:10.15,Default,,0,0,0,,Маңызды нәрселерді тікелей жеткізу керек.
Dialogue: 0,0:32:10.15,0:32:15.92,Default,,0,0,0,,Біраз амалсыз болса да, әдемірек, теориялық.
Dialogue: 0,0:32:15.92,0:32:18.92,Default,,0,0,0,,Рей-чан? иә? Не!?
Dialogue: 0,0:32:18.92,0:32:21.59,Default,,0,0,0,,Бұл кәмпиттің құрамында батыстық ішімдік жоқ па?
Dialogue: 0,0:32:21.59,0:32:23.59,Default,,0,0,0,,Иә!?
Dialogue: 0,0:32:23.59,0:32:28.10,Default,,0,0,0,,Алдымен теориялық жағынан әдемі... (Нагиса) Мүмкін Рей-чан...
Dialogue: 0,0:32:28.10,0:32:31.27,Default,,0,0,0,,Сіз массыз ба!?
Dialogue: 0,0:32:31.27,0:32:33.60,Default,,0,0,0,,Тоқта... күте тұр, Рюгасаки-кун!?
Dialogue: 0,0:32:33.60,0:32:35.60,Default,,0,0,0,,Сабыр ет! иә?
Dialogue: 0,0:32:35.60,0:32:40.44,Default,,0,0,0,,Кешіріңіз. (Ayumu) ​​Жабдықты тексеру аяқталды.
Dialogue: 0,0:32:40.44,0:32:42.44,Default,,0,0,0,,Директор Рей?
Dialogue: 0,0:32:42.44,0:32:45.11,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:32:45.11,0:32:47.12,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:32:47.12,0:32:51.29,Default,,0,0,0,,Рей-чан, мен қазір батыстық ішімдіктер мен тәттілерге мас болып жатырмын...
Dialogue: 0,0:32:51.29,0:32:53.79,Default,,0,0,0,,Өйткені мен өте адал болдым.
Dialogue: 0,0:32:53.79,0:32:58.13,Default,,0,0,0,,Барлығыңыздың қосылғаныңызға өте қуаныштымын!
Dialogue: 0,0:32:58.13,0:33:00.13,Default,,0,0,0,,Иә!?
Dialogue: 0,0:33:00.13,0:33:03.63,Default,,0,0,0,,Біздің команданы байланыстыратын нәрсе, әрине, махаббат!
Dialogue: 0,0:33:03.63,0:33:07.30,Default,,0,0,0,,Уау! Ұят... Бұл не!? Бұл!
Dialogue: 0,0:33:07.30,0:33:09.30,Default,,0,0,0,,Аюму-сан! (Адаммен) Ха, иә!
Dialogue: 0,0:33:09.30,0:33:12.24,Default,,0,0,0,,Бізбен көбірек соқтығысыңыз!
Dialogue: 0,0:33:12.24,0:33:16.58,Default,,0,0,0,,Нагиса-кунның да, Го-санның да ескертулері жоқ!
Dialogue: 0,0:33:16.58,0:33:18.58,Default,,0,0,0,,Мына жерде адасқан оқ!
Dialogue: 0,0:33:18.58,0:33:21.08,Default,,0,0,0,,Бұл маған қаншалықты көмектесті...
Dialogue: 0,0:33:21.08,0:33:23.42,Default,,0,0,0,,Не? Бұл ұят... хехехе!
Dialogue: 0,0:33:23.42,0:33:28.42,Default,,0,0,0,,Өтінемін, бұл туралы уайымдамаңыз, Аюму-сан және өзіңізді көбірек көрсетіңіз.
Dialogue: 0,0:33:28.42,0:33:30.43,Default,,0,0,0,,Тағамға салынған сезімдер
Dialogue: 0,0:33:30.43,0:33:33.10,Default,,0,0,0,,Бұл барлығына анық жеткізіледі.
Dialogue: 0,0:33:33.10,0:33:35.76,Default,,0,0,0,,Мм... Мен бақыттымын, бірақ ұялып тұрмын.
Dialogue: 0,0:33:35.76,0:33:37.77,Default,,0,0,0,,Шизуру-кун! Иә!
Dialogue: 0,0:33:37.77,0:33:41.77,Default,,0,0,0,,Мен қателеспеу үшін абайлап жүзу керектігін түсінемін.
Dialogue: 0,0:33:41.77,0:33:46.28,Default,,0,0,0,,Бірақ Шизуру-кун эстафета кезінде біраз тар көрінеді.
Dialogue: 0,0:33:46.28,0:33:48.28,Default,,0,0,0,,Көбірек еркіндік жақсы!
Dialogue: 0,0:33:48.28,0:33:51.28,Default,,0,0,0,,Өзіңдей бол және еркін бол!
Dialogue: 0,0:33:51.28,0:33:54.45,Default,,0,0,0,,Сіз сенімдісіз бе? Ромео-кун! Ха, иә!
Dialogue: 0,0:33:54.45,0:33:57.95,Default,,0,0,0,,Мұны маған алыстағы аға айтты.
Dialogue: 0,0:33:57.95,0:34:00.62,Default,,0,0,0,,Мен оның еркінірек болғанын қалаймын.
Dialogue: 0,0:34:00.62,0:34:02.96,Default,,0,0,0,,Сіз боссыз.
Dialogue: 0,0:34:02.96,0:34:07.96,Default,,0,0,0,,Біз үшінші курс студенттері үшін бұл орта мектептегі соңғы жазымыз болуы мүмкін.
Dialogue: 0,0:34:07.96,0:34:12.40,Default,,0,0,0,,Бірақ бәріңіз үшін бұл жаз тек бір рет келеді.
Dialogue: 0,0:34:12.40,0:34:15.40,Default,,0,0,0,,Сондықтан мен сенің еркін жүзгеніңді қалаймын.
Dialogue: 0,0:34:15.40,0:34:18.74,Default,,0,0,0,,Өзің бол, әдемі, теориялық
Dialogue: 0,0:34:18.74,0:34:24.25,Default,,0,0,0,,Осылайша мен Иватоби жүзу клубына қосылдым.
Dialogue: 0,0:34:24.25,0:34:28.25,Default,,0,0,0,,Енді ертеңнен бастап жаттығуға кірісейік!
Dialogue: 0,0:34:28.25,0:34:31.42,Default,,0,0,0,,Иә, иә! Махаббаттың күшімен!
Dialogue: 0,0:34:31.42,0:34:34.92,Default,,0,0,0,,Өйткені мен бәріңді жақсы көремін!
Dialogue: 0,0:34:34.92,0:34:39.09,Default,,0,0,0,,Иә... (Ромео және басқалары) Бұл ұят!
Dialogue: 0,0:34:39.09,0:34:42.10,Default,,0,0,0,,Кешіріңіз, Рейкун...
Dialogue: 0,0:34:42.10,0:34:44.93,Default,,0,0,0,,Жоқ, мен сенің арқаңда ояндым.
Dialogue: 0,0:34:44.93,0:34:49.60,Default,,0,0,0,,Мүмкін мен тек секіруді еңсере алғаныма қанағаттанған шығармын.
Dialogue: 0,0:34:49.60,0:34:51.94,Default,,0,0,0,,Мен де қорғаныста болдым.
Dialogue: 0,0:34:51.94,0:34:54.94,Default,,0,0,0,,Директор Рейдің сөзі жүрегімді елжіретіп жіберді.
Dialogue: 0,0:34:54.94,0:34:57.28,Default,,0,0,0,,Мен де!
Dialogue: 0,0:34:57.28,0:35:03.29,Default,,0,0,0,,Мен үшін, бір күні осы сәтті еске алғанда, мен осы мүшелермен жүзе алғаныма қуаныштымын деп ойлаймын.
Dialogue: 0,0:35:03.29,0:35:07.29,Default,,0,0,0,,Біздің топ болып жүзетінімізді ұмытпауларыңызды қалаймын.
Dialogue: 0,0:35:07.29,0:35:09.96,Default,,0,0,0,,Рей-чан да, солай ма?
Dialogue: 0,0:35:09.96,0:35:14.56,Default,,0,0,0,,Балшық тәрізді билейді, жапон алхоры кальмарындай шағады.
Dialogue: 0,0:35:14.56,0:35:16.90,Default,,0,0,0,,Берілістің тағы бір деңгейін қосамыз!
Dialogue: 0,0:35:16.90,0:35:21.90,Default,,0,0,0,,Біз сізді Куникида отбасының дәстүрлі бал лимонымен қолдаймыз.
Dialogue: 0,0:35:21.90,0:35:28.70,Default,,0,0,0,,Ааааа...Мен Рей-чанға үшеуміздің мотивациясын ертерек көрсеткім келді.
Dialogue: 0,0:35:30.75,0:35:32.75,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:35:32.75,0:35:35.08,Default,,0,0,0,,Екеуің де күрескерсіңдер!
Dialogue: 0,0:35:35.08,0:35:37.75,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:35:37.75,0:35:39.92,Default,,0,0,0,,Кешегі күн үшін көп рахмет!
Dialogue: 0,0:35:39.92,0:35:43.26,Default,,0,0,0,,Кеудемде тұрып қалған тунецтен құтылғандай болдым.
Dialogue: 0,0:35:43.26,0:35:46.26,Default,,0,0,0,,Сіздің сезімдеріңіз жақсы қабылданды!
Dialogue: 0,0:35:46.26,0:35:48.60,Default,,0,0,0,,Ум... Хэхехе!
Dialogue: 0,0:35:48.60,0:35:52.60,Default,,0,0,0,,Нана Нана... Бұл не!? Міне осы!
Dialogue: 0,0:35:52.60,0:35:57.27,Default,,0,0,0,,Иә! Рюгасаки-кун, сенің мұндай құмарлық сезімдерің бар екеніне сене алар емеспін.
Dialogue: 0,0:35:57.27,0:35:59.27,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:35:59.27,0:36:02.28,Default,,0,0,0,,Директор Рейдің сөзін жүрегімде сақтаймын!
Dialogue: 0,0:36:02.28,0:36:04.78,Default,,0,0,0,,Иә!? Мен де ұмытпаймын
Dialogue: 0,0:36:04.78,0:36:07.12,Default,,0,0,0,,Мен де!
Dialogue: 0,0:36:07.12,0:36:12.22,Default,,0,0,0,,Өтінемін... бірден ұмыт!
Dialogue: 0,0:36:12.22,0:36:55.02,Default,,0,0,0,,～
Dialogue: 0,0:36:57.10,0:36:59.10,Default,,0,0,0,,Ертең осында.
Dialogue: 0,0:36:59.10,0:37:02.10,Default,,0,0,0,,Иә, бәріміз, бәріміз бірігейік!
Dialogue: 0,0:37:02.10,0:37:04.44,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе...
Dialogue: 0,0:37:04.44,0:37:07.28,Default,,0,0,0,,Сонда да көңіл көтерейік!
Dialogue: 0,0:37:07.28,0:37:10.28,Default,,0,0,0,,Иватобидегі жүзу клубының жекпе-жегі!
Dialogue: 0,0:37:10.28,0:37:12.28,Default,,0,0,0,,О!
Dialogue: 0,0:37:19.05,0:37:21.22,Default,,0,0,0,,Phat!
Dialogue: 0,0:37:21.22,0:37:23.56,Default,,0,0,0,,Ха ха ха…
Dialogue: 0,0:37:23.56,0:37:25.56,Default,,0,0,0,,Ха ха ха…
Dialogue: 0,0:37:35.57,0:37:37.57,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:37:37.57,0:37:39.74,Default,,0,0,0,,Рюгасаки-кун да, Хазуки-кун да жергілікті турнирге шығады!
Dialogue: 0,0:37:39.74,0:37:41.74,Default,,0,0,0,,О, сен істедің!
Dialogue: 0,0:37:41.74,0:37:43.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:43.75,0:37:45.75,Default,,0,0,0,,Ал енді...
Dialogue: 0,0:37:45.75,0:37:47.75,Default,,0,0,0,,Бұл аралас эстафетаның финалы ма?
Dialogue: 0,0:37:47.75,0:37:49.75,Default,,0,0,0,,Есан!
Dialogue: 0,0:37:49.75,0:37:51.75,Default,,0,0,0,,Ахахах...｡ (Мойотару) Ахахаха!
Dialogue: 0,0:37:51.75,0:37:54.59,Default,,0,0,0,,Мен барлығының алдында геймін.
Dialogue: 0,0:37:54.59,0:37:57.93,Default,,0,0,0,,Мен сізге дамыған акула үлгісінің күшін көрсетемін!
Dialogue: 0,0:37:57.93,0:38:02.10,Default,,0,0,0,,Осыны қалайсың, Ай Чан.
Dialogue: 0,0:38:02.10,0:38:05.77,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:38:05.77,0:38:09.27,Default,,0,0,0,,Бағаларыңызды алыңыз. (Электронды тапанша дыбысы)
Dialogue: 0,0:38:09.27,0:38:11.44,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:38:11.44,0:38:13.44,Default,,0,0,0,,Шизуру! Шизучан!
Dialogue: 0,0:38:15.38,0:38:18.38,Default,,0,0,0,,Момо но Яту бірден жоғарыда!
Dialogue: 0,0:38:18.38,0:38:21.38,Default,,0,0,0,,Хаха, бұл керемет!
Dialogue: 0,0:38:21.38,0:38:23.72,Default,,0,0,0,,Момо-кунның Басаро...!
Dialogue: 0,0:38:23.72,0:38:26.22,Default,,0,0,0,,Шизуру-кун да айналады!
Dialogue: 0,0:38:28.72,0:38:30.89,Default,,0,0,0,,Шизуру-кун жетіп келеді!
Dialogue: 0,0:38:30.89,0:38:33.73,Default,,0,0,0,,Жоқ, шабдалы осы жерден өседі!
Dialogue: 0,0:38:33.73,0:38:35.73,Default,,0,0,0,,Ай-сенпай!
Dialogue: 0,0:38:35.73,0:38:37.73,Default,,0,0,0,,Нағиса-сенпай!
Dialogue: 0,0:38:40.24,0:38:42.24,Default,,0,0,0,,Нағиса-сенпай! Нагиса-кун!
Dialogue: 0,0:38:45.91,0:38:49.41,Default,,0,0,0,,Ромио-кун, көңіл көтерейік
Dialogue: 0,0:38:49.41,0:38:51.41,Default,,0,0,0,,Иә
Dialogue: 0,0:38:54.58,0:38:57.42,Default,,0,0,0,,Ай-сенпай, өте ыстық!
Dialogue: 0,0:38:57.42,0:39:02.76,Default,,0,0,0,,Нагиса-кун жоқ, оның шынымен жарқырайтын жері осы!
Dialogue: 0,0:39:02.76,0:39:05.46,Default,,0,0,0,,Ұқсас құстардың да төзімділігі әртүрлі!
Dialogue: 0,0:39:09.43,0:39:11.87,Default,,0,0,0,,Уозуми-кун!
Dialogue: 0,0:39:11.87,0:39:14.17,Default,,0,0,0,,Рей-чан!
Dialogue: 0,0:39:19.21,0:39:21.21,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:39:21.21,0:39:23.38,Default,,0,0,0,,Рейкунның өсуі!
Dialogue: 0,0:39:23.38,0:39:27.38,Default,,0,0,0,,Уокчи-сенпай!
Dialogue: 0,0:39:27.38,0:39:31.55,Default,,0,0,0,,Ол қайтадан жақсарып келеді...
Dialogue: 0,0:39:31.55,0:39:33.95,Default,,0,0,0,,Роми-чан. Ромио
Dialogue: 0,0:39:42.90,0:39:45.90,Default,,0,0,0,,Ромео-кун!
Dialogue: 0,0:39:45.90,0:39:47.90,Default,,0,0,0,,Роми-чан!
Dialogue: 0,0:39:49.90,0:39:51.90,Default,,0,0,0,,Ха...!
Dialogue: 0,0:39:55.08,0:39:57.75,Default,,0,0,0,,Ха ха...!
Dialogue: 0,0:39:57.75,0:40:11.26,Default,,0,0,0,,～
Dialogue: 0,0:40:11.26,0:40:13.43,Default,,0,0,0,,Ромео-кун жылдамдауда!
Dialogue: 0,0:40:13.43,0:40:15.76,Default,,0,0,0,,Олардың жасырынған жері университет жанындағы қойма еді және…
Dialogue: 0,0:40:15.76,0:40:17.76,Default,,0,0,0,,Ромео! Ломи-чан! Ромео-кун!
Dialogue: 0,0:40:20.94,0:40:24.27,Default,,0,0,0,,Phat!
Dialogue: 0,0:40:24.27,0:40:27.44,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:40:27.44,0:40:31.45,Default,,0,0,0,,Жақсы жұмыс! 1 орын Хафф!
Dialogue: 0,0:40:31.45,0:40:33.55,Default,,0,0,0,,Хахахаха! Апыр-ай!
Dialogue: 0,0:40:40.62,0:40:42.62,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:40:47.13,0:40:50.30,Default,,0,0,0,,Уау, бұл керемет емес пе!
Dialogue: 0,0:40:50.30,0:40:53.47,Default,,0,0,0,,Келесі - жергілікті турнир. Иә!
Dialogue: 0,0:40:53.47,0:40:57.31,Default,,0,0,0,,Мен де Рин Чанға біздің матчымызды көрсеткім келді~
Dialogue: 0,0:40:57.31,0:40:59.97,Default,,0,0,0,,Мен оның қозғалғанына және жылағанын сенімдімін!
Dialogue: 0,0:40:59.97,0:41:02.81,Default,,0,0,0,,Мен онша жыламаймын.
Dialogue: 0,0:41:02.81,0:41:06.48,Default,,0,0,0,,Ол өте күшті болды. Хахахаха!
Dialogue: 0,0:41:06.48,0:41:08.98,Default,,0,0,0,,Рей де тамаша жұмыс жасады.
Dialogue: 0,0:41:08.98,0:41:14.42,Default,,0,0,0,,Сезімдерің күшті болса, келесі матч жақсы болатынына сенімдімін.
Dialogue: 0,0:41:14.42,0:41:16.59,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:41:16.59,0:41:19.43,Default,,0,0,0,,Бүкіл жапондық таңдау үшін Рин-сан да таңдалды. Іске сәт!
Dialogue: 0,0:41:19.43,0:41:21.43,Default,,0,0,0,,О
Dialogue: 0,0:41:21.43,0:41:24.43,Default,,0,0,0,,Сіздің ағаңыз шетелден шақырылған спортшылармен жүзеді ме?
Dialogue: 0,0:41:24.43,0:41:26.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:26.60,0:41:31.61,Default,,0,0,0,,Қараңызшы, әлем чемпионаттары алдында Жапонияға шетелден бірнеше спортшылар келетінін естідім.
Dialogue: 0,0:41:31.61,0:41:34.94,Default,,0,0,0,,Жоқ, менің ешқандай жоспарым жоқ.
Dialogue: 0,0:41:34.94,0:41:37.95,Default,,0,0,0,,Керемет шабуыл! Мен оны ортасында аштым!
Dialogue: 0,0:41:37.95,0:41:39.95,Default,,0,0,0,,Жарайды, мінекей!
Dialogue: 0,0:41:41.95,0:41:43.95,Default,,0,0,0,,Қ.О.
Dialogue: 0,0:41:43.95,0:41:45.95,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:41:45.95,0:41:48.29,Default,,0,0,0,,Микошиба бұрынғыдай жақсы.
Dialogue: 0,0:41:48.29,0:41:50.29,Default,,0,0,0,,Бұл баяғыда болды!
Dialogue: 0,0:41:50.29,0:41:54.46,Default,,0,0,0,,Жүзу және жекпе-жек ойындары – менің өмірдегі мақсатым!
Dialogue: 0,0:41:54.46,0:41:57.13,Default,,0,0,0,,Жаңа қарсылас!
Dialogue: 0,0:41:57.13,0:41:59.97,Default,,0,0,0,,Хун Келесі кім?
Dialogue: 0,0:41:59.97,0:42:03.47,Default,,0,0,0,,Осы Isuzu Mikoshiba-ны еркелетейік.
Dialogue: 0,0:42:06.31,0:42:09.31,Default,,0,0,0,,Шетелдік пе? Ол жай ғана жарыс ойынын ойнады
Dialogue: 0,0:42:09.31,0:42:11.31,Default,,0,0,0,,Бұл өте жақсы болды!
Dialogue: 0,0:42:11.31,0:42:13.25,Default,,0,0,0,,Сақтықты түсірме, Микошиба
Dialogue: 0,0:42:13.25,0:42:16.92,Default,,0,0,0,,Хмм, мен бұл ойынға қанша қалта ақшасын жұмсадым?
Dialogue: 0,0:42:16.92,0:42:19.42,Default,,0,0,0,,Білесің бе, жалама!
Dialogue: 0,0:42:19.42,0:42:21.42,Default,,0,0,0,,Кеттік, жолдасым!
Dialogue: 0,0:42:21.42,0:42:23.76,Default,,0,0,0,,1 РУНД Жекпе-жек!
Dialogue: 0,0:42:23.76,0:42:26.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:26.43,0:42:29.93,Default,,0,0,0,,Барлығы қорғалған! Қандай тамаша қадам!
Dialogue: 0,0:42:29.93,0:42:31.93,Default,,0,0,0,,Ал, Чокомакато...!
Dialogue: 0,0:42:31.93,0:42:34.93,Default,,0,0,0,,Ондайда шеттерін бірден салып қойғанша...!
Dialogue: 0,0:42:36.94,0:42:38.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:41.44,0:42:43.44,Default,,0,0,0,,Дұрыс...!
Dialogue: 0,0:42:47.78,0:42:50.12,Default,,0,0,0,,Қ.О.
Dialogue: 0,0:42:50.12,0:42:52.12,Default,,0,0,0,,Ал... әлі алда!
Dialogue: 0,0:42:59.63,0:43:01.63,Default,,0,0,0,,О, сәл күте тұрыңыз...
Dialogue: 0,0:43:03.97,0:43:07.47,Default,,0,0,0,,Мм...
Dialogue: 0,0:43:07.47,0:43:10.07,Default,,0,0,0,,Мен оны бір жерден көргендей сезінемін...
Dialogue: 0,0:43:12.07,0:43:14.74,Default,,0,0,0,,Жаттықтырушы Тачибана. Мисаки-кун?
Dialogue: 0,0:43:14.74,0:43:17.41,Default,,0,0,0,,Сіз менің кезегімді көре аласыз ба?
Dialogue: 0,0:43:17.41,0:43:20.25,Default,,0,0,0,,Осы уақытқа дейін суға шомылған жоқсың ба?
Dialogue: 0,0:43:20.25,0:43:22.92,Default,,0,0,0,,Кішкене үзіліс жасасам болады ма?
Dialogue: 0,0:43:22.92,0:43:27.42,Default,,0,0,0,,Иә, бірақ мен Нацумэ Каору жеңгім келді.
Dialogue: 0,0:43:27.42,0:43:29.92,Default,,0,0,0,,Біз мектептерді ауыстырдық. Біз бәсекелеспіз бе?
Dialogue: 0,0:43:29.92,0:43:34.10,Default,,0,0,0,,Иә, оның кезегі шынымен тегіс болды.
Dialogue: 0,0:43:34.10,0:43:39.60,Default,,0,0,0,,Ақырында мен ешқашан жеңген жоқпын, сондықтан бұл жолы мен...
Dialogue: 0,0:43:39.60,0:43:43.44,Default,,0,0,0,,Жарайды, қанағаттанғанша барымызды салып көрейік!
Dialogue: 0,0:43:43.44,0:43:45.94,Default,,0,0,0,,Рахмет! Иә
Dialogue: 0,0:43:45.94,0:43:51.45,Default,,0,0,0,,Күтілгендей, бұл тек таңдалған ойыншыларға арналған оқу-жаттығу жиыны. Бұл керемет.
Dialogue: 0,0:43:51.45,0:43:54.95,Default,,0,0,0,,Ол жігіт, солай ма? Такадайда бір жыл
Dialogue: 0,0:43:54.95,0:43:58.45,Default,,0,0,0,,А, бұл Харука Нанасе, фрилансер.
Dialogue: 0,0:43:58.45,0:44:01.46,Default,,0,0,0,,Бүгінгі тәжірибе еркін жаттығуға бағытталған.
Dialogue: 0,0:44:01.46,0:44:03.96,Default,,0,0,0,,Қазір тамақ ішкен дұрыс па?
Dialogue: 0,0:44:03.96,0:44:07.46,Default,,0,0,0,,Иә, өйткені еркін суға ең бейім.
Dialogue: 0,0:44:07.46,0:44:12.06,Default,,0,0,0,,Гаххахаха Нанасе де сен сияқты бос шығар.
Dialogue: 0,0:44:19.57,0:44:22.24,Default,,0,0,0,,Хмм…
Dialogue: 0,0:44:22.24,0:44:24.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:44:35.09,0:44:37.29,Default,,0,0,0,,Тапсырыс беруді білесіз бе?
Dialogue: 0,0:44:39.26,0:44:41.93,Default,,0,0,0,,Мизо-бұқтырылған скумбрия жиынтығынан жасалған екі тағам.
Dialogue: 0,0:44:41.93,0:44:44.10,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:44:44.10,0:44:46.94,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:44:46.94,0:44:59.11,Default,,0,0,0,,～
Dialogue: 0,0:44:59.11,0:45:01.31,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:45:10.29,0:45:12.29,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:45:17.57,0:45:19.57,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:45:35.58,0:45:37.58,Default,,0,0,0,,Ах
Dialogue: 0,0:45:39.59,0:45:42.92,Default,,0,0,0,,Ағамның ерекше дайындығы ауыр болды...!
Dialogue: 0,0:45:42.92,0:45:46.93,Default,,0,0,0,,Не, бұл Гехсеннен бе...?
Dialogue: 0,0:45:46.93,0:45:50.10,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:45:50.10,0:45:53.30,Default,,0,0,0,,есіме түсті! Мен оның екеніне сенімдімін ...
Dialogue: 0,0:45:55.94,0:45:57.94,Default,,0,0,0,,Патч…
Dialogue: 0,0:45:59.94,0:46:21.90,Default,,0,0,0,,～
Dialogue: 0,0:46:21.90,0:46:24.23,Default,,0,0,0,,Ха ха...!
Dialogue: 0,0:46:24.23,0:46:26.43,Default,,0,0,0,,Ха ха...!
Dialogue: 0,0:46:33.24,0:46:37.58,Default,,0,0,0,,Бауырым! Бүгінгі жолдастық кездесуге шақырылған шетелдік ойыншылар кімдер?
Dialogue: 0,0:46:37.58,0:46:39.75,Default,,0,0,0,,Бұл Альберт, солай ма?
Dialogue: 0,0:46:39.75,0:46:42.75,Default,,0,0,0,,Не? Альберто...
Dialogue: 0,0:46:42.75,0:46:44.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:46:44.75,0:46:49.09,Default,,0,0,0,,Қазіргі 100 және 200 еркін әлемдік рекордшылар
Dialogue: 0,0:46:49.09,0:46:53.29,Default,,0,0,0,,Бұл швециялық Альберт Воландер.
Dialogue: 0,0:46:55.26,0:46:57.77,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:46:57.77,0:46:59.97,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:47:01.94,0:47:04.27,Default,,0,0,0,,Әй, Мисаки-кун!
Dialogue: 0,0:47:04.27,0:47:06.77,Default,,0,0,0,,А... денем қызып кетті!
Dialogue: 0,0:47:06.77,0:47:09.78,Default,,0,0,0,,Менде бәрі жақсы, басым айналып кетті.
Dialogue: 0,0:47:09.78,0:47:11.78,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз!
Dialogue: 0,0:47:11.78,0:47:14.22,Default,,0,0,0,,Мен сені үйге апарамын.
Dialogue: 0,0:47:14.22,0:47:17.72,Default,,0,0,0,,Келесі оқиға 200 тегін.
Dialogue: 0,0:47:24.39,0:47:28.40,Default,,0,0,0,,Өзіңізді жақсы сезінбейтін күндері өзіңізді итермеңіз.
Dialogue: 0,0:47:28.40,0:47:30.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:30.73,0:47:33.73,Default,,0,0,0,,Жақында жасөспірімдер арасындағы чемпионат өтеді.
Dialogue: 0,0:47:36.57,0:47:39.74,Default,,0,0,0,,Кешіріңіз. Мен оны байқамай да қалдым.
Dialogue: 0,0:47:39.74,0:47:41.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:47:41.91,0:47:45.25,Default,,0,0,0,,Бірақ денеңізге зақым келтірудің мәні жоқ.
Dialogue: 0,0:47:45.25,0:47:48.25,Default,,0,0,0,,Ең алдымен формаға келейік
Dialogue: 0,0:47:48.25,0:47:51.92,Default,,0,0,0,,Сәлем? Иә
Dialogue: 0,0:47:51.92,0:47:54.72,Default,,0,0,0,,Рахмет сізге Кочи Тачибана
Dialogue: 0,0:48:00.76,0:48:03.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:48:05.27,0:48:07.97,Default,,0,0,0,,Уақытында жетемін бе деп ойлаймын...!
Dialogue: 0,0:48:14.71,0:48:20.05,Default,,0,0,0,,Ха ха ха ха...!
Dialogue: 0,0:48:20.05,0:48:34.56,Default,,0,0,0,,～
Dialogue: 0,0:48:34.56,0:48:36.56,Default,,0,0,0,,Ха ха ха ха...!
Dialogue: 0,0:48:39.23,0:48:41.53,Default,,0,0,0,,Нанасе-сан...
Dialogue: 0,0:48:43.57,0:48:45.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:45.57,0:48:47.97,Default,,0,0,0,,Ха ха ха ха...!
Dialogue: 0,0:48:50.41,0:48:53.91,Default,,0,0,0,,Хару... жоғалып кетті...?
Dialogue: 0,0:49:07.26,0:49:09.60,Default,,0,0,0,,Эй, Рин біраз болды
Dialogue: 0,0:49:09.60,0:49:11.60,Default,,0,0,0,,О, Сусуке!
Dialogue: 0,0:49:13.53,0:49:15.54,Default,,0,0,0,,Біраз уақыт өтті. Ах.
Dialogue: 0,0:49:15.54,0:49:17.71,Default,,0,0,0,,Сиднейден қашан оралдыңыз?
Dialogue: 0,0:49:17.71,0:49:21.54,Default,,0,0,0,,Біраз бұрын. Бүкіл Жапония таңдауына қатысу.
Dialogue: 0,0:49:21.54,0:49:24.05,Default,,0,0,0,,Барлық Жапония?
Dialogue: 0,0:49:24.05,0:49:28.22,Default,,0,0,0,,Дұрыс, мен де саған кәдесый сатып алдым.
Dialogue: 0,0:49:28.22,0:49:30.55,Default,,0,0,0,,Ал...
Dialogue: 0,0:49:30.55,0:49:34.06,Default,,0,0,0,,Сіз қорқыныштысыз, сондықтан оны кисеңіз мейірімдірек көрінесіз деп ойладым.
Dialogue: 0,0:49:34.06,0:49:38.23,Default,,0,0,0,,Бұл күлкілі әзіл. Russie, бұл жақсы аулау болды, солай емес пе?
Dialogue: 0,0:49:38.23,0:49:40.56,Default,,0,0,0,,Дұрыс, мен де акула үлгісіне келдім.
Dialogue: 0,0:49:40.56,0:49:43.23,Default,,0,0,0,,Ай мен Момо арасындағы жергілікті турнир шешілген сияқты.
Dialogue: 0,0:49:43.23,0:49:46.90,Default,,0,0,0,,Қарасам, әлгі жігіттер тынбай еңбек етіпті.
Dialogue: 0,0:49:46.90,0:49:51.07,Default,,0,0,0,,Сонымен, Сосуке, онда...
Dialogue: 0,0:49:51.07,0:49:54.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:49:54.74,0:49:58.25,Default,,0,0,0,,Сіз мұнда ота нәтижесін есту үшін келдіңіз, солай ма?
Dialogue: 0,0:49:58.25,0:50:01.05,Default,,0,0,0,,О... ой
Dialogue: 0,0:50:07.76,0:50:09.96,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:50:12.43,0:50:14.93,Default,,0,0,0,,Операция сәтті өтті.
Dialogue: 0,0:50:25.27,0:50:28.61,Default,,0,0,0,,Жақсы, мен бұл сөздерді күтіп едім...
Dialogue: 0,0:50:28.61,0:50:30.95,Default,,0,0,0,,Сіз жыладыңыз ба? Жылауға себеп жоқ!
Dialogue: 0,0:50:30.95,0:50:35.28,Default,,0,0,0,,Хехе, мен ақыры бастапқы сызыққа жеткендей болдым.
Dialogue: 0,0:50:35.28,0:50:39.78,Default,,0,0,0,,Мен барғанша дүниеде күрес, Рин.
Dialogue: 0,0:50:41.79,0:50:43.96,Default,,0,0,0,,Мақтаншақ болма
Dialogue: 0,0:50:43.96,0:50:45.96,Default,,0,0,0,,Менің күтуге уақытым жоқ.
Dialogue: 0,0:50:45.96,0:50:49.30,Default,,0,0,0,,Бұдан асып кетіңіз. Көкжиектен тыс.
Dialogue: 0,0:50:49.30,0:50:51.30,Default,,0,0,0,,Тағы да өлең?
Dialogue: 0,0:50:51.30,0:50:53.30,Default,,0,0,0,,Хехе, мұндай кезде жақсырақ, солай ма?
Dialogue: 0,0:50:55.30,0:50:57.31,Default,,0,0,0,,Иә. Ха.
Dialogue: 0,0:50:57.31,0:50:59.47,Default,,0,0,0,,Әй, сен қатты терлеп кеттің!
Dialogue: 0,0:50:59.47,0:51:02.81,Default,,0,0,0,,Такасуми, сен жақсы спорт залдарын білесің.
Dialogue: 0,0:51:02.81,0:51:05.48,Default,,0,0,0,,Мекеме де таза болды. (Жақсы ауа-райы) Шынымды айтсам.
Dialogue: 0,0:51:05.48,0:51:08.82,Default,,0,0,0,,Хехе, менің ақпараттық желім жоқ!
Dialogue: 0,0:51:08.82,0:51:11.65,Default,,0,0,0,,Бұл өте қорлайтын сөз.
Dialogue: 0,0:51:11.65,0:51:14.09,Default,,0,0,0,,Кешіріңіз, мен ваннаға барамын.
Dialogue: 0,0:51:14.09,0:51:17.09,Default,,0,0,0,,А, мен де. Мен бірден қайтамын!
Dialogue: 0,0:51:17.09,0:51:19.59,Default,,0,0,0,,Иә, мен күтемін.
Dialogue: 0,0:51:19.59,0:51:21.76,Default,,0,0,0,,Асахи сен жалғызсың ба?
Dialogue: 0,0:51:21.76,0:51:23.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:51:23.93,0:51:25.93,Default,,0,0,0,,Хехе, мен жаңа ғана айттым.
Dialogue: 0,0:51:25.93,0:51:28.77,Default,,0,0,0,,Аа, дұрыс, мен оны Макотодан естідім.
Dialogue: 0,0:51:28.77,0:51:32.11,Default,,0,0,0,,Тоно-кун, арқамен жүзуде жақсы уақыт өткізіп жатырсың!
Dialogue: 0,0:51:32.11,0:51:36.44,Default,,0,0,0,,Икуямен және басқалармен салыстырғанда, бұл әлі алыс.
Dialogue: 0,0:51:36.44,0:51:39.45,Default,,0,0,0,,Бірақ мен де бір күні болады
Dialogue: 0,0:51:39.45,0:51:43.12,Default,,0,0,0,,Мен де сол көріністі көрсем ғой
Dialogue: 0,0:51:43.12,0:51:46.45,Default,,0,0,0,,Не болды.
Dialogue: 0,0:51:46.45,0:51:48.46,Default,,0,0,0,,Не?
Dialogue: 0,0:51:48.46,0:51:52.13,Default,,0,0,0,,Мен Тоно-кунның тағы бір жақсы жерін таптым.
Dialogue: 0,0:51:52.13,0:51:54.80,Default,,0,0,0,,Шигино-кун басқа, солай емес пе?
Dialogue: 0,0:51:54.80,0:51:56.96,Default,,0,0,0,,Солай ма? Бұл дұрыс
Dialogue: 0,0:51:56.96,0:51:58.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:58.97,0:52:01.14,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:52:01.14,0:52:03.14,Default,,0,0,0,,Тіпті Сусуке Рин!
Dialogue: 0,0:52:03.14,0:52:06.31,Default,,0,0,0,,Хахахаха Біраз уақыт өтті!
Dialogue: 0,0:52:06.31,0:52:08.81,Default,,0,0,0,,О, Такасуми, қалайсың?
Dialogue: 0,0:52:08.81,0:52:11.65,Default,,0,0,0,,Иә, Рин де жақсы көрінеді!
Dialogue: 0,0:52:11.65,0:52:14.42,Default,,0,0,0,,Әлі шулы.
Dialogue: 0,0:52:14.42,0:52:18.09,Default,,0,0,0,,Соускенің осылай әрекет еткеніне біраз уақыт болды!
Dialogue: 0,0:52:18.09,0:52:20.76,Default,,0,0,0,,Сіз не істеп жүрдіңіз? (Такасуми) Спортзалдан қайт!
Dialogue: 0,0:52:20.76,0:52:22.92,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:52:22.92,0:52:28.26,Default,,0,0,0,,Ах, Тоно Хиёри-кун. Шимогаку жүзу клубында арқамен жүзуші.
Dialogue: 0,0:52:28.26,0:52:30.43,Default,,0,0,0,,Сәлем
Dialogue: 0,0:52:30.43,0:52:32.60,Default,,0,0,0,,Бұл жерде өте сүйкімді нәрсе бар.
Dialogue: 0,0:52:32.60,0:52:34.60,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:52:34.60,0:52:36.94,Default,,0,0,0,,Хе, бұл...
Dialogue: 0,0:52:36.94,0:52:40.11,Default,,0,0,0,,Күткеніңізге рахмет. Бұл кім?
Dialogue: 0,0:52:40.11,0:52:43.94,Default,,0,0,0,,Иә, бұл Рин Мацуока мен Соусуке Ямадзаки.
Dialogue: 0,0:52:43.94,0:52:46.95,Default,,0,0,0,,Бастауыш сыныптағы достар
Dialogue: 0,0:52:46.95,0:52:49.45,Default,,0,0,0,,Танысқаныма қуаныштымын. Мацуока...
Dialogue: 0,0:52:49.45,0:52:54.29,Default,,0,0,0,,Ал бұлар орта мектепте бірге болған Асахи Шиина мен Икуя Киришима!
Dialogue: 0,0:52:54.29,0:52:58.13,Default,,0,0,0,,Киришима... Икуя?
Dialogue: 0,0:52:58.13,0:53:01.13,Default,,0,0,0,,Нацуя-санның... інісі...
Dialogue: 0,0:53:01.13,0:53:03.46,Default,,0,0,0,,Сіз Нацуя-санды білесіз бе?
Dialogue: 0,0:53:03.46,0:53:05.47,Default,,0,0,0,,Рин де?
Dialogue: 0,0:53:05.47,0:53:07.97,Default,,0,0,0,,Мацуока… Мацуока…
Dialogue: 0,0:53:07.97,0:53:10.64,Default,,0,0,0,,Жоқ, есімде жоқ!
Dialogue: 0,0:53:10.64,0:53:14.08,Default,,0,0,0,,Ол да бір жерде... (Ауа райы) Рин Мацуока
Dialogue: 0,0:53:14.08,0:53:18.08,Default,,0,0,0,,Мен оның Нанасе-кунның қарсыласы екеніне сенімдімін, солай ма?
Dialogue: 0,0:53:18.08,0:53:20.28,Default,,0,0,0,,Тегін ойында сіз Хал екеумізге қарсы күресетін боласыз.
Dialogue: 0,0:53:22.58,0:53:26.92,Default,,0,0,0,,Икуя Киришима Мен сен туралы өсек естідім
Dialogue: 0,0:53:26.92,0:53:29.92,Default,,0,0,0,,Мен Халмен эстафетада жүзген доспын.
Dialogue: 0,0:53:29.92,0:53:33.22,Default,,0,0,0,,Танысқаныма қуаныштымын. Мен де Халмен бірге эстафетада жүздім.
Dialogue: 0,0:53:35.26,0:53:37.43,Default,,0,0,0,,Мен ағамнан сен туралы өсек естідім.
Dialogue: 0,0:53:37.43,0:53:40.10,Default,,0,0,0,,Ха, бұл құрмет.
Dialogue: 0,0:53:40.10,0:53:42.27,Default,,0,0,0,,Неге кенет бір-бірлеріңмен жарысасыңдар?
Dialogue: 0,0:53:42.27,0:53:44.27,Default,,0,0,0,,Басқаша айтқанда… бұл…➡
Dialogue: 0,0:53:44.27,0:53:47.44,Default,,0,0,0,,Бәрібір мен жеңілмеймін, Рин.
Dialogue: 0,0:53:47.44,0:53:50.61,Default,,0,0,0,,Менің де жеңілгім келмейді, Икуя.
Dialogue: 0,0:53:50.61,0:53:53.45,Default,,0,0,0,,Иә, иә, екеуің де тынышталыңдар!
Dialogue: 0,0:53:53.45,0:53:56.62,Default,,0,0,0,,Мацуока-кун да Икуяға сонша көңіл бөлетін болса.
Dialogue: 0,0:53:56.62,0:53:59.12,Default,,0,0,0,,Бір рет байқап көру дұрыс емес пе?
Dialogue: 0,0:53:59.12,0:54:01.12,Default,,0,0,0,,Сізге бәсекелестік өте ұнайды, солай емес пе?
Dialogue: 0,0:54:01.12,0:54:03.12,Default,,0,0,0,,Жарыссақ та жарайды.
Dialogue: 0,0:54:03.12,0:54:05.13,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:54:05.13,0:54:08.80,Default,,0,0,0,,Ха, бұл қызық. Содан кейін мен сол байқауға қатысамын.
Dialogue: 0,0:54:08.80,0:54:10.80,Default,,0,0,0,,Е, жоқ, ұрыс!
Dialogue: 0,0:54:10.80,0:54:13.23,Default,,0,0,0,,Сосуке, бірдеңе айтыңызшы!
Dialogue: 0,0:54:13.23,0:54:15.57,Default,,0,0,0,,Егер бұл орын алса, Ринді тоқтату мүмкін емес.
Dialogue: 0,0:54:15.57,0:54:17.91,Default,,0,0,0,,Сусуке!
Dialogue: 0,0:54:17.91,0:54:22.41,Default,,0,0,0,,Орын ауыстырайық. Мен қызық жер білемін.
Dialogue: 0,0:54:22.41,0:54:24.41,Default,,0,0,0,,Онда неге ақ пен қараны қоспасқа?
Dialogue: 0,0:54:24.41,0:54:26.58,Default,,0,0,0,,Жақсы, ойнайық.
Dialogue: 0,0:54:26.58,0:54:30.92,Default,,0,0,0,,Мен саған кімнің шын мықты екенін көрсетемін!
Dialogue: 0,0:54:30.92,0:54:33.09,Default,,0,0,0,,Көрдіңіз бе.
Dialogue: 0,0:54:33.09,0:54:35.09,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:54:35.09,0:54:37.93,Default,,0,0,0,,Сіз Икуяға тең келе алмайсыз.
Dialogue: 0,0:54:37.93,0:54:39.93,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:54:39.93,0:54:43.43,Default,,0,0,0,,Ха, бұл тамаша! Балалар, келіңдер, бізге қосылыңдар!
Dialogue: 0,0:54:45.60,0:54:47.94,Default,,0,0,0,,Мен саған бірдеңе көрсетемін!
Dialogue: 0,0:54:47.94,0:54:50.60,Default,,0,0,0,,Әй, үзіліс! Русси
Dialogue: 0,0:54:50.60,0:54:53.77,Default,,0,0,0,,Иә, бұл қиын емес пе? (Асахи) Ой... ой
Dialogue: 0,0:54:53.77,0:54:55.78,Default,,0,0,0,,Ойын...｡ Мен солай ойладым.
Dialogue: 0,0:54:55.78,0:54:58.11,Default,,0,0,0,,Уау! (Асахи) Әбуне!
Dialogue: 0,0:54:58.11,0:55:00.11,Default,,0,0,0,,Мақсатсыз жүгірме!
Dialogue: 0,0:55:00.11,0:55:02.12,Default,,0,0,0,,Өйткені... Уау!
Dialogue: 0,0:55:02.12,0:55:05.79,Default,,0,0,0,,Эй, Тоно-кун, сенде бір сүйкімді нәрсе бар, солай ма?
Dialogue: 0,0:55:05.79,0:55:07.79,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:55:07.79,0:55:10.29,Default,,0,0,0,,Ой... енді ше?
Dialogue: 0,0:55:10.29,0:55:13.89,Default,,0,0,0,,Уа, ау, ау! (Икуя) Жарайды!
Dialogue: 0,0:55:13.89,0:55:16.23,Default,,0,0,0,,Қайырлы күн! Tsk
Dialogue: 0,0:55:16.23,0:55:19.90,Default,,0,0,0,,Жақсы өткен сияқты. Жоқ, бұл сөзсіз кездейсоқ болды.
Dialogue: 0,0:55:19.90,0:55:21.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:55:24.57,0:55:28.74,Default,,0,0,0,,Эй, Сусуке, иығың қалай?
Dialogue: 0,0:55:28.74,0:55:32.25,Default,,0,0,0,,А, мен ота жасадым.
Dialogue: 0,0:55:32.25,0:55:35.42,Default,,0,0,0,,Прогресс жақсы жүріп жатыр.
Dialogue: 0,0:55:35.42,0:55:38.75,Default,,0,0,0,,Ах! Сондықтан мен қайтадан жүзе аламын!
Dialogue: 0,0:55:38.75,0:55:43.76,Default,,0,0,0,,Ол үшін уайымдамаңыз, бұл біраз уақыт жеңілдейді.
Dialogue: 0,0:55:43.76,0:55:48.43,Default,,0,0,0,,Түсіндім, біз қайтадан бірге жүзе аламыз деп үміттенемін.
Dialogue: 0,0:55:48.43,0:55:53.43,Default,,0,0,0,,Түсінікті болу үшін мен басқа біреуге операция жасауды шешкен жоқпын.
Dialogue: 0,0:55:53.43,0:55:56.94,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:55:56.94,0:56:01.28,Default,,0,0,0,,Дегенмен, команданы еркін таңдау шатасу жағдайында.
Dialogue: 0,0:56:01.28,0:56:03.28,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:56:03.28,0:56:05.45,Default,,0,0,0,,Рин, Хару және Икуя
Dialogue: 0,0:56:05.45,0:56:08.62,Default,,0,0,0,,Ал Кинджо... Иә?
Dialogue: 0,0:56:08.62,0:56:14.05,Default,,0,0,0,,Ол орта мектептің үшінші курсында оқып жүргенде батингтен еркін агенттікке ауысты.
Dialogue: 0,0:56:14.05,0:56:16.72,Default,,0,0,0,,Соңғы алты айда қарқынды өсті.
Dialogue: 0,0:56:16.72,0:56:20.72,Default,,0,0,0,,Және одан әрі...
Dialogue: 0,0:56:23.40,0:56:25.40,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:56:25.40,0:56:28.07,Default,,0,0,0,,Қарғыс атқыр... Жолдан кет! Мен оны ұнатпаймын!
Dialogue: 0,0:56:28.07,0:56:30.07,Default,,0,0,0,,Күте тұр, Икуя! сурет?
Dialogue: 0,0:56:30.07,0:56:32.07,Default,,0,0,0,,Тоно күтіңіз!
Dialogue: 0,0:56:32.07,0:56:34.07,Default,,0,0,0,,Бұл соңы!
Dialogue: 0,0:56:36.91,0:56:38.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:40.91,0:56:42.92,Default,,0,0,0,,Жақсы ауа-райы!
Dialogue: 0,0:56:42.92,0:56:44.92,Default,,0,0,0,,Хаха, шыңға жетейік!
Dialogue: 0,0:56:44.92,0:56:46.92,Default,,0,0,0,,Сіз не істеп жатырсыз? (Икуя) Бұл Хиори но Катаки!
Dialogue: 0,0:56:46.92,0:56:49.09,Default,,0,0,0,,Икуя міндетті түрде жеңеді!
Dialogue: 0,0:56:49.09,0:56:53.43,Default,,0,0,0,,Тәжірибе мәзірі электрондық поштасына рахмет.
Dialogue: 0,0:56:53.43,0:56:55.43,Default,,0,0,0,,Олар маған кәдесый жіберді.
Dialogue: 0,0:56:55.43,0:56:57.43,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:56:57.43,0:57:00.10,Default,,0,0,0,,Менің сүйкімді оқушым тынбай еңбек етуде.
Dialogue: 0,0:57:00.10,0:57:02.27,Default,,0,0,0,,Бұл ондай емес.
Dialogue: 0,0:57:02.27,0:57:04.44,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:57:04.44,0:57:07.61,Default,,0,0,0,,Кішкентай кезімнен мен әрқашан артта қалатынмын.
Dialogue: 0,0:57:07.61,0:57:12.05,Default,,0,0,0,,Мен сенің соңынан ердім, бірақ Токиоға келеді деп ойламадым.
Dialogue: 0,0:57:12.05,0:57:17.05,Default,,0,0,0,,Мен қазірдің өзінде университет студентімін. Бұл дұрыс хахахаха
Dialogue: 0,0:57:17.05,0:57:19.39,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:57:19.39,0:57:22.22,Default,,0,0,0,,Макото балаларды оқытқысы келетінін айтты.
Dialogue: 0,0:57:22.22,0:57:27.06,Default,,0,0,0,,Неліктен Кочи Сасабе SC бастауға шешім қабылдады?
Dialogue: 0,0:57:27.06,0:57:29.56,Default,,0,0,0,,Мен? Мен осылай туылдым
Dialogue: 0,0:57:29.56,0:57:33.40,Default,,0,0,0,,Мен әрқашан жақсы көретін жалғыз нәрсе - жүзу.
Dialogue: 0,0:57:33.40,0:57:35.74,Default,,0,0,0,,Мен бұл сезімді одан бетер жеткізгім келді.
Dialogue: 0,0:57:35.74,0:57:39.24,Default,,0,0,0,,Жас кезіңізде спортшы боламын дедіңіз.
Dialogue: 0,0:57:39.24,0:57:42.74,Default,,0,0,0,,Айналамдағыларға қиындық туғызсам да
Dialogue: 0,0:57:42.74,0:57:45.41,Default,,0,0,0,,Бірақ соның арқасында мен адамдарға мейірімді болдым.
Dialogue: 0,0:57:45.41,0:57:48.75,Default,,0,0,0,,Балалар – бұл мүмкіндіктер жиынтығы.
Dialogue: 0,0:57:48.75,0:57:52.75,Default,,0,0,0,,Оқытатын адам жеткілікті үлкен болмаса, олар оны қабылдай алмайды.
Dialogue: 0,0:57:52.75,0:57:55.59,Default,,0,0,0,,Сондықтан Макотода да әртүрлі нәрселер болуы мүмкін.
Dialogue: 0,0:57:55.59,0:57:58.76,Default,,0,0,0,,Еш нәрсеге секіруден қорықпа
Dialogue: 0,0:57:58.76,0:58:03.06,Default,,0,0,0,,Мен сенің жігерлі бала екеніңді жақсы білемін.
Dialogue: 0,0:58:05.10,0:58:07.94,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:58:07.94,0:58:12.04,Default,,0,0,0,,Олай болса, маған қайта хабарласыңыз. Иә онда.
Dialogue: 0,0:58:14.54,0:58:16.94,Default,,0,0,0,,Ах... Рин?
Dialogue: 0,0:58:19.05,0:58:21.38,Default,,0,0,0,,Менің аквариумға бармағаныма біраз уақыт болды.
Dialogue: 0,0:58:21.38,0:58:24.05,Default,,0,0,0,,Иә, Рин, сен бақытты боласың деп ойлаймын.
Dialogue: 0,0:58:24.05,0:58:27.05,Default,,0,0,0,,Дұрыс. Хехе
Dialogue: 0,0:58:29.89,0:58:32.73,Default,,0,0,0,,Сіз Сусукемен кездестіңіз бе?
Dialogue: 0,0:58:32.73,0:58:35.23,Default,,0,0,0,,Ах
Dialogue: 0,0:58:35.23,0:58:38.43,Default,,0,0,0,,Операция сәтті өткен сияқты.
Dialogue: 0,0:58:40.40,0:58:42.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:58:44.57,0:58:48.24,Default,,0,0,0,,А, мен Халдың турнирде еркін эстафетаға қатысқанын естідім.
Dialogue: 0,0:58:48.24,0:58:50.58,Default,,0,0,0,,Дұрыс, мен де жүздім.
Dialogue: 0,0:58:50.58,0:58:54.92,Default,,0,0,0,,Харудың пікірі!? Иә, бірақ ол болашақта мұны істей ме деп ойлаймын?
Dialogue: 0,0:58:54.92,0:58:57.75,Default,,0,0,0,,Мен түсінбеймін деп ойлаймын.
Dialogue: 0,0:58:57.75,0:59:01.09,Default,,0,0,0,,Бұл зат тегін ме?
Dialogue: 0,0:59:01.09,0:59:03.59,Default,,0,0,0,,Сонымен, Хару қазір не істеп жатыр?
Dialogue: 0,0:59:03.59,0:59:06.76,Default,,0,0,0,,Мен Жапонияға оралғаннан бері сізбен байланыса алмадым.
Dialogue: 0,0:59:06.76,0:59:08.93,Default,,0,0,0,,Иә...
Dialogue: 0,0:59:08.93,0:59:10.93,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:59:10.93,0:59:12.87,Default,,0,0,0,,Оқу-жаттығу жиынындағы жолдастық кездесуде
Dialogue: 0,0:59:12.87,0:59:17.04,Default,,0,0,0,,Швециялық Альберто Воландерге жеңілді...
Dialogue: 0,0:59:17.04,0:59:20.21,Default,,0,0,0,,Майкл: Ринкун, сен онымен абай болғаның жөн.
Dialogue: 0,0:59:20.21,0:59:24.88,Default,,0,0,0,,Оның жүзуі басқа деңгейде.
Dialogue: 0,0:59:24.88,0:59:28.48,Default,,0,0,0,,Сіз акуламен бірге жүздіңіз бе? Хару
Dialogue: 0,0:59:33.05,0:59:35.06,Default,,0,0,0,,Кеттік, Макото. Қайда?
Dialogue: 0,0:59:35.06,0:59:37.76,Default,,0,0,0,,Бұл Харунтоко! Не, қазірден ба?
Dialogue: 0,0:59:46.90,0:59:50.24,Default,,0,0,0,,Әй, біраз уақыт болды!
Dialogue: 0,0:59:50.24,0:59:52.24,Default,,0,0,0,,Рин?
Dialogue: 0,0:59:52.24,0:59:55.41,Default,,0,0,0,,Мен сені көрмегелі біраз уақыт өткен сияқты.
Dialogue: 0,0:59:55.41,0:59:58.58,Default,,0,0,0,,Біртүрлі. Бұл рас болуы мүмкін.
Dialogue: 0,0:59:58.58,1:00:01.75,Default,,0,0,0,,Хахаха Биіктегі жаттығулар туралы не айтасыз?
Dialogue: 0,1:00:01.75,1:00:05.42,Default,,0,0,0,,Тыныс алу қиын. Бұл дұрыс. Мен де басында.
Dialogue: 0,1:00:05.42,1:00:07.52,Default,,0,0,0,,Мен гипервентиляцияға бара жатқандай болдым.
Dialogue: 0,1:00:11.76,1:00:13.96,Default,,0,0,0,,Альбертомен бірге суға барғаныңызды естідім бе?
Dialogue: 0,1:00:15.93,1:00:20.10,Default,,0,0,0,,Бұл жаңа сезім болды.
Dialogue: 0,1:00:20.10,1:00:24.10,Default,,0,0,0,,Су алынып, су бұзылады.
Dialogue: 0,1:00:24.10,1:00:26.94,Default,,0,0,0,,Мен жүзіп жүрсем де, жүзіп жүргендей сезінбедім.
Dialogue: 0,1:00:26.94,1:00:28.94,Default,,0,0,0,,Хару…
Dialogue: 0,1:00:30.94,1:00:33.45,Default,,0,0,0,,Нағыз қиын қарсыласқа ұқсайды.
Dialogue: 0,1:00:33.45,1:00:37.62,Default,,0,0,0,,Бірақ содан бері менің сезімім өзгерген жоқ.
Dialogue: 0,1:00:37.62,1:00:42.62,Default,,0,0,0,,Қандай қабырғалар болса да
Dialogue: 0,1:00:42.62,1:00:44.96,Default,,0,0,0,,Хару, сен ше?
Dialogue: 0,1:00:44.96,1:01:08.48,Default,,0,0,0,,～
Dialogue: 0,1:01:08.48,1:01:10.78,Default,,0,0,0,,Мен...
Dialogue: 0,1:01:13.42,1:01:17.26,Default,,0,0,0,,Менің денем әлі бітпеген болса да.
Dialogue: 0,1:01:17.26,1:01:20.76,Default,,0,0,0,,Өйткені сіз әлемдік рекордшымен күресіп жатырсыз. Сол ақымақ!
Dialogue: 0,1:01:20.76,1:01:22.93,Default,,0,0,0,,Азума мырза
Dialogue: 0,1:01:22.93,1:01:25.43,Default,,0,0,0,,Нанасе, осыдан бастайық.
Dialogue: 0,1:01:25.43,1:01:28.77,Default,,0,0,0,,Иә, бірақ мен бұл Хал екеніне сенімдімін.
Dialogue: 0,1:01:28.77,1:01:30.97,Default,,0,0,0,,Мен оны жеңемін деп ойлаймын.
Dialogue: 0,1:01:32.94,1:01:35.94,Default,,0,0,0,,Сен де солай істеп жатырсың.
Dialogue: 0,1:01:35.94,1:01:38.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:38.11,1:01:41.28,Default,,0,0,0,,Мен де солай істейтінмін.
Dialogue: 0,1:01:41.28,1:01:44.45,Default,,0,0,0,,Мен әлі жаспын, сондықтан мен көбірек уайымдаймын.
Dialogue: 0,1:01:44.45,1:01:46.45,Default,,0,0,0,,Нанасе сияқты
Dialogue: 0,1:01:49.79,1:01:51.99,Default,,0,0,0,,Хару…
Dialogue: 0,1:02:01.97,1:02:04.47,Default,,0,0,0,,Мисаки-кунның баяулағаны рас.
Dialogue: 0,1:02:04.47,1:02:07.47,Default,,0,0,0,,Ойын қашан болады? Келесі апта
Dialogue: 0,1:02:07.47,1:02:09.64,Default,,0,0,0,,Ол да қобалжыған сияқты.
Dialogue: 0,1:02:09.64,1:02:12.41,Default,,0,0,0,,Бір күні қызуым көтерілді.
Dialogue: 0,1:02:12.41,1:02:14.75,Default,,0,0,0,,Байқамасқа амалым жоқ.
Dialogue: 0,1:02:14.75,1:02:16.75,Default,,0,0,0,,Сондықтан мазасыз ба?
Dialogue: 0,1:02:18.75,1:02:23.76,Default,,0,0,0,,Жаттықтырушы Хал маған мұңайғанымды айтты.
Dialogue: 0,1:02:23.76,1:02:28.06,Default,,0,0,0,,Макото, сенде купальник бар ма? сурет?
Dialogue: 0,1:02:35.27,1:02:37.27,Default,,0,0,0,,Phat!
Dialogue: 0,1:02:37.27,1:02:39.77,Default,,0,0,0,,Нао-сенпай, бұл керемет!
Dialogue: 0,1:02:39.77,1:02:42.28,Default,,0,0,0,,Тіпті Макото да керемет соққыға ие.
Dialogue: 0,1:02:42.28,1:02:44.78,Default,,0,0,0,,Сіз үнемі жаттығасыз. Иә.
Dialogue: 0,1:02:44.78,1:02:47.78,Default,,0,0,0,,Мен мұнымен бала кезімнен айналысып келемін.
Dialogue: 0,1:02:47.78,1:02:50.08,Default,,0,0,0,,Мен суда жүзбесем, өзімді біртүрлі сезінемін.
Dialogue: 0,1:02:52.12,1:02:56.12,Default,,0,0,0,,Жоғарыда айтқанымдай, Макото үшін уайымдамағаныңыз жөн.
Dialogue: 0,1:02:56.12,1:02:59.29,Default,,0,0,0,,Өйткені Мисаки-кун мазасызданады. Иә.
Dialogue: 0,1:02:59.29,1:03:01.63,Default,,0,0,0,,Мен де басында солай болдым.
Dialogue: 0,1:03:01.63,1:03:05.30,Default,,0,0,0,,Бірден көп баланы оқыту қиын.
Dialogue: 0,1:03:05.30,1:03:07.80,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:03:07.80,1:03:14.24,Default,,0,0,0,,Әрбір адам шын мәнінде бірегей және олардың жақсы білетін әртүрлі нәрселері бар.
Dialogue: 0,1:03:14.24,1:03:16.58,Default,,0,0,0,,Иә, сондықтан қызық
Dialogue: 0,1:03:16.58,1:03:20.58,Default,,0,0,0,,Менің ойымша, сіз шыншыл болуыңыз керек. иә?
Dialogue: 0,1:03:20.58,1:03:23.42,Default,,0,0,0,,Мен жаттықтырушыға көмектесіп жатқанымды айттым ғой, солай ма?
Dialogue: 0,1:03:23.42,1:03:27.25,Default,,0,0,0,,Иә, бұл ойыншының қолдауы, солай ма?
Dialogue: 0,1:03:27.25,1:03:31.26,Default,,0,0,0,,Иә, мен кәсіби жаттығуларды жақыннан көруім керек.
Dialogue: 0,1:03:31.26,1:03:35.60,Default,,0,0,0,,Мен күн сайын ойыншылардың тынысы мен сезімін сезінемін.
Dialogue: 0,1:03:35.60,1:03:40.60,Default,,0,0,0,,Олардың әрқайсысы біреуге бір нәрсе үйреткенде күшке айналады.
Dialogue: 0,1:03:40.60,1:03:44.60,Default,,0,0,0,,Макото да дәл осындай жағдайды басынан өткерді.
Dialogue: 0,1:03:44.60,1:03:47.61,Default,,0,0,0,,Сөзсіз жеткізуге болмайтын нәрселер болады.
Dialogue: 0,1:03:47.61,1:03:50.61,Default,,0,0,0,,Оған қамқорлық жасаңыз
Dialogue: 0,1:03:50.61,1:03:52.78,Default,,0,0,0,,Нао-сенпай…
Dialogue: 0,1:03:52.78,1:03:55.12,Default,,0,0,0,,Мен Макото жаттықтырушы болу үшін қолайлы екенін айттым.
Dialogue: 0,1:03:55.12,1:04:01.12,Default,,0,0,0,,Өйткені мен Макото бұл байланысты бағалай алады деп ойладым.
Dialogue: 0,1:04:01.12,1:04:04.32,Default,,0,0,0,,Мен сенімдімін Макото...
Dialogue: 0,1:04:06.79,1:04:08.80,Default,,0,0,0,,Жарайсың, Макото!
Dialogue: 0,1:04:08.80,1:04:11.47,Default,,0,0,0,,Осы жолы тегін ойын ойнайық. иә?
Dialogue: 0,1:04:11.47,1:04:14.77,Default,,0,0,0,,100 метр. Ей, ей, Нао-сенпай!
Dialogue: 0,1:04:21.41,1:04:23.71,Default,,0,0,0,,Мисаки-кун, уақыт болды... А, иә!
Dialogue: 0,1:04:26.75,1:04:29.55,Default,,0,0,0,,Нао: Мен сенімдімін Макото...
Dialogue: 0,1:04:33.09,1:04:36.29,Default,,0,0,0,,Мисаки-кун, жақсысың ба?
Dialogue: 0,1:04:38.43,1:04:41.23,Default,,0,0,0,,Одан да демалыңыз! А... иә
Dialogue: 0,1:04:43.26,1:04:45.60,Default,,0,0,0,,Бір жігітпен суға түсемін деп ойлағаныма біраз болды.
Dialogue: 0,1:04:45.60,1:04:48.44,Default,,0,0,0,,Әйтеуір мен оған көп күш салдым...
Dialogue: 0,1:04:48.44,1:04:51.27,Default,,0,0,0,,Ондай адамның болғаны жақсы. иә?
Dialogue: 0,1:04:51.27,1:04:54.11,Default,,0,0,0,,Мен мұндай байланыстарды көп көрдім.
Dialogue: 0,1:04:54.11,1:04:58.11,Default,,0,0,0,,Бір жақ намыстанып, екіншісімен жарысады.
Dialogue: 0,1:04:58.11,1:05:00.28,Default,,0,0,0,,Мен ерекше назар аударған ойыншылар...
Dialogue: 0,1:05:00.28,1:05:03.45,Default,,0,0,0,,Бірге жүзе аламын деп ойлаған адамды мәңгілікке қалдыру.
Dialogue: 0,1:05:03.45,1:05:07.79,Default,,0,0,0,,Қайта кездескен кезде қатты сезімде болған ойыншы...
Dialogue: 0,1:05:07.79,1:05:12.49,Default,,0,0,0,,Бірақ бәріміз бірге жүзу арқылы құтылдық.
Dialogue: 0,1:05:15.56,1:05:18.73,Default,,0,0,0,,Мисаки-кунның да Нацумэ-кунмен бірге біраз уақыттан кейін алғаш рет жүзетініне сенімдімін.
Dialogue: 0,1:05:18.73,1:05:20.73,Default,,0,0,0,,Менің ойымша, сіз бір нәрсені байқаған боларсыз
Dialogue: 0,1:05:22.74,1:05:25.74,Default,,0,0,0,,Нацумэ-кунмен байланысыңызды бағалаңыз
Dialogue: 0,1:05:25.74,1:05:30.08,Default,,0,0,0,,Мен жүзуді жалғастырғандықтан, мен сізбен қайта кездесуге мүмкіндік алдым.
Dialogue: 0,1:05:30.08,1:05:33.48,Default,,0,0,0,,Маған осындай адаммен жүзе алғаным қатты ұнады.
Dialogue: 0,1:05:40.25,1:05:42.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:46.43,1:05:48.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:48.43,1:05:53.10,Default,,0,0,0,,(ысқырық)
Dialogue: 0,1:05:53.10,1:05:56.27,Default,,0,0,0,,Бағаларыңызды алыңыз. (Электронды тапанша дыбысы)
Dialogue: 0,1:05:56.27,1:05:58.27,Default,,0,0,0,,Қараңыз!
Dialogue: 0,1:05:58.27,1:06:00.27,Default,,0,0,0,,Жүр! Мисаки-кун!
Dialogue: 0,1:06:02.28,1:06:18.56,Default,,0,0,0,,～
Dialogue: 0,1:06:18.56,1:06:20.76,Default,,0,0,0,,Жүр!
Dialogue: 0,1:06:24.73,1:06:27.03,Default,,0,0,0,,Соңғы!
Dialogue: 0,1:06:31.24,1:06:33.44,Default,,0,0,0,,(қуаныш)
Dialogue: 0,1:06:43.25,1:06:46.42,Default,,0,0,0,,Нацюме…
Dialogue: 0,1:06:46.42,1:06:48.42,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,1:06:48.42,1:06:50.42,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:06:50.42,1:06:52.43,Default,,0,0,0,,Мисаки-кун жүзуді де жақсы орындады.
Dialogue: 0,1:06:52.43,1:06:55.60,Default,,0,0,0,,Біраз уақыттан кейін алғаш рет сенімен жүзе алғаныма өте қуаныштымын!
Dialogue: 0,1:06:55.60,1:06:57.60,Default,,0,0,0,,Хэм (Субару) Ааах!
Dialogue: 0,1:06:57.60,1:07:00.60,Default,,0,0,0,,Кочи! Еңбегіңіз үшін рахмет, Мисаки-кун
Dialogue: 0,1:07:00.60,1:07:04.27,Default,,0,0,0,,Жеңілу көңілім қалды, бірақ мен өз уақытымды жақсарта алдым.
Dialogue: 0,1:07:04.27,1:07:07.27,Default,,0,0,0,,Иә. Нацумэмен жүзу арқылы,
Dialogue: 0,1:07:07.27,1:07:10.28,Default,,0,0,0,,Мүмкін мен қолымнан келгеннің бәрін жасадым. Және...
Dialogue: 0,1:07:10.28,1:07:14.55,Default,,0,0,0,,Кочи Тачибанаға рахмет
Dialogue: 0,1:07:14.55,1:07:19.25,Default,,0,0,0,,Эй Макото, сенің арманың қандай?
Dialogue: 0,1:07:22.06,1:07:26.89,Default,,0,0,0,,Рахмет, жаттықтырушы Тачибана және жаттықтырушы Серизава!
Dialogue: 0,1:07:26.89,1:07:29.56,Default,,0,0,0,,Нао-сенпай. иә?
Dialogue: 0,1:07:29.56,1:07:32.07,Default,,0,0,0,,Өткен күнгі жаттықтырушының оқиғасы
Dialogue: 0,1:07:32.07,1:07:35.90,Default,,0,0,0,,Толығырақ мәлімет сұрасам бола ма?
Dialogue: 0,1:07:35.90,1:07:38.20,Default,,0,0,0,,Макото...
Dialogue: 0,1:07:41.24,1:07:43.91,Default,,0,0,0,,Керемет адам!
Dialogue: 0,1:07:43.91,1:07:47.75,Default,,0,0,0,,Міне, Хачидің жазғы демалысы осылай өтеді.
Dialogue: 0,1:07:47.75,1:07:51.92,Default,,0,0,0,,Көпшіліктен аулақ болып, кездескіңіз келсе, Мояйдың алдынан кездесуге болар еді.
Dialogue: 0,1:07:51.92,1:07:55.92,Default,,0,0,0,,Хэхехе... Күткендей, Роми-чан, бұл менің екінші туған жерім ғана.
Dialogue: 0,1:07:55.92,1:07:59.59,Default,,0,0,0,,Сонда да...｡ (Сілекейдің дыбысы)
Dialogue: 0,1:07:59.59,1:08:02.93,Default,,0,0,0,,Токиодағы бұлшықет…｡ Май…
Dialogue: 0,1:08:02.93,1:08:05.60,Default,,0,0,0,,Шикі Хачико…
Dialogue: 0,1:08:05.60,1:08:07.93,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:08:07.93,1:08:10.94,Default,,0,0,0,,Мако-чан! Кешіріңіз, күттіңіз бе?
Dialogue: 0,1:08:10.94,1:08:13.54,Default,,0,0,0,,Жоқ, мен жаңа ғана келдім.
Dialogue: 0,1:08:13.54,1:08:16.21,Default,,0,0,0,,Ах, бәрің жаңа мүшесіңдер.
Dialogue: 0,1:08:16.21,1:08:18.21,Default,,0,0,0,,Мен мұны Рейден және басқалардан естідім.
Dialogue: 0,1:08:18.21,1:08:20.55,Default,,0,0,0,,Мен Макото Тачибанамын
Dialogue: 0,1:08:20.55,1:08:23.22,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:08:23.22,1:08:26.22,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,1:08:26.22,1:08:29.89,Default,,0,0,0,,Хару-чан оқу-жаттығу жиынында, солай ма?
Dialogue: 0,1:08:29.89,1:08:33.23,Default,,0,0,0,,Дәл қазір бұл бүкіл Жапония таңдауының алдында.
Dialogue: 0,1:08:33.23,1:08:36.06,Default,,0,0,0,,Бірақ Рей және басқалары ертең ұлттық турнирді бастайды, солай ма?
Dialogue: 0,1:08:36.06,1:08:39.90,Default,,0,0,0,,Иә, мен жарқанатпын, ал Нағиса-күн ағайын.
Dialogue: 0,1:08:39.90,1:08:42.24,Default,,0,0,0,,Әрқайсысы қатысады.
Dialogue: 0,1:08:42.24,1:08:47.91,Default,,0,0,0,,Иә. Рей Нагиса, тағы да құттықтаймын.
Dialogue: 0,1:08:47.91,1:08:52.25,Default,,0,0,0,,Екеуің үшін кешірім сұраймын, ертең бірге көңіл көтерейік.
Dialogue: 0,1:08:52.25,1:08:54.25,Default,,0,0,0,,Иә!
Dialogue: 0,1:08:54.25,1:09:05.93,Default,,0,0,0,,～
Dialogue: 0,1:09:05.93,1:09:11.60,Default,,0,0,0,,Рюгасаки-кун да, Хазуки-кун да керемет, солай емес пе? Олар бүкіл елде.
Dialogue: 0,1:09:11.60,1:09:14.87,Default,,0,0,0,,Бұл жігіттердің талпынысы таң қалдырады.
Dialogue: 0,1:09:14.87,1:09:17.54,Default,,0,0,0,,Дұрыс, бұл сіз басқара алатын нәрсе емес.
Dialogue: 0,1:09:17.54,1:09:20.54,Default,,0,0,0,,Шынымен. Қалғаны...
Dialogue: 0,1:09:20.54,1:09:22.54,Default,,0,0,0,,Мен эстафетада ұлттық құрамды жіберіп алдым.
Dialogue: 0,1:09:22.54,1:09:25.55,Default,,0,0,0,,Сіз бұл туралы қажеттен артық алаңдамайсыз деп үміттенемін.
Dialogue: 0,1:09:25.55,1:09:30.22,Default,,0,0,0,,дегенді қалай түсінесіңдер? Ромео мен Шизурудың бұлшықеттері жақсы, бірақ
Dialogue: 0,1:09:30.22,1:09:33.89,Default,,0,0,0,,Ол әлі де болашақта ойыншы.
Dialogue: 0,1:09:33.89,1:09:39.23,Default,,0,0,0,,Рей мен Нагисаға алдын ала дайындықтан бері ауыр жүк түскен болуы керек.
Dialogue: 0,1:09:39.23,1:09:44.56,Default,,0,0,0,,Мен олар туралы айтып отырмын. Мен Ромео мен Шизурудың аға буыны ретінде сенімдімін.
Dialogue: 0,1:09:44.56,1:09:47.57,Default,,0,0,0,,Олар сендерге өздері көрген табиғатты көрсеткісі келеді.
Dialogue: 0,1:09:47.57,1:09:51.24,Default,,0,0,0,,Менің ойымша, сіз оған ынталы болдыңыз.
Dialogue: 0,1:09:51.24,1:09:56.24,Default,,0,0,0,,Шіркін... Арқада мұнша ауыртпалық болмаса.
Dialogue: 0,1:09:56.24,1:09:58.91,Default,,0,0,0,,Мен бұл балалардың жақсы болатынына сенімдімін.
Dialogue: 0,1:09:58.91,1:10:01.25,Default,,0,0,0,,Иә? Не болса да
Dialogue: 0,1:10:01.25,1:10:04.25,Default,,0,0,0,,Иватоби орта мектебінің жүзу клубы
Dialogue: 0,1:10:04.25,1:10:08.92,Default,,0,0,0,,А... Дұрыс.
Dialogue: 0,1:10:08.92,1:10:13.59,Default,,0,0,0,,Иватоби орта мектебінің жүзу клубы.
Dialogue: 0,1:10:13.59,1:10:15.93,Default,,0,0,0,,Уау, мен қатты толқып тұрмын!
Dialogue: 0,1:10:15.93,1:10:18.43,Default,,0,0,0,,Баршаңызға, ертең өкінбейсіздер деп сенемін.
Dialogue: 0,1:10:18.43,1:10:20.93,Default,,0,0,0,,Барымызды салайық! (мүшелер) Usu!
Dialogue: 0,1:10:20.93,1:10:24.27,Default,,0,0,0,,Ай-чан Момо-чан Сәлем!
Dialogue: 0,1:10:24.27,1:10:27.27,Default,,0,0,0,,Цзян мырза! Иватобидегі барлығында алдын ала қарау болды ма?
Dialogue: 0,1:10:27.27,1:10:31.61,Default,,0,0,0,,Иә. Жергілікті турнирде эстафетадан көңілім қалды.
Dialogue: 0,1:10:31.61,1:10:34.28,Default,,0,0,0,,Балалар сендер де жүзуді жақсы орындадыңдар.
Dialogue: 0,1:10:34.28,1:10:37.62,Default,,0,0,0,,Не... Сізге көп рахмет!
Dialogue: 0,1:10:37.62,1:10:39.62,Default,,0,0,0,,Сізге ұнаса...
Dialogue: 0,1:10:39.62,1:10:42.62,Default,,0,0,0,,Бұқтырылған қайнатпа? Шынымды айтсам, маған да бер!
Dialogue: 0,1:10:42.62,1:10:44.62,Default,,0,0,0,,Өтінемін. (Уозуми) О, мен жасадым!
Dialogue: 0,1:10:44.62,1:10:46.96,Default,,0,0,0,,Мен Ай Чанмен ұрысамын.
Dialogue: 0,1:10:46.96,1:10:50.63,Default,,0,0,0,,Е, үш жылдық мектептің шарықтау шегі
Dialogue: 0,1:10:50.63,1:10:56.30,Default,,0,0,0,,Мен барымды беремін, сондықтан дайын бол, Нагиса-кун.
Dialogue: 0,1:10:56.30,1:10:59.31,Default,,0,0,0,,Мен де жеңілмеймін, Ай Чан.
Dialogue: 0,1:10:59.31,1:11:01.64,Default,,0,0,0,,Hyakutaro!
Dialogue: 0,1:11:01.64,1:11:04.31,Default,,0,0,0,,Әй, әпке!
Dialogue: 0,1:11:04.31,1:11:06.98,Default,,0,0,0,,Әпке? Бұл Момотаро-кун ма?
Dialogue: 0,1:11:06.98,1:11:08.98,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:11:08.98,1:11:13.25,Default,,0,0,0,,Бұл алдын ала қарау. Бұл алдын ала қарау.
Dialogue: 0,1:11:13.25,1:11:16.92,Default,,0,0,0,,Өте сүйкімді! Сіз Цзян мырзасыз, солай ма?
Dialogue: 0,1:11:16.92,1:11:20.09,Default,,0,0,0,,Иә... Менің атым Исузу Микошиба!
Dialogue: 0,1:11:20.09,1:11:23.43,Default,,0,0,0,,Үлкен ағам мен інімнен әңгіме естимін!
Dialogue: 0,1:11:23.43,1:11:25.60,Default,,0,0,0,,Қандай... қандай әңгіме...
Dialogue: 0,1:11:25.60,1:11:28.27,Default,,0,0,0,,Аа, әпке, осы жерде осыны айтасыз ба?
Dialogue: 0,1:11:28.27,1:11:31.94,Default,,0,0,0,,Мен сіздің ағаңыз Риннің бұлшық еттері өте жақсы деп естідім.
Dialogue: 0,1:11:31.94,1:11:35.28,Default,,0,0,0,,Тіпті бөліну жасайтын бұлшықеттер
Dialogue: 0,1:11:35.28,1:11:38.95,Default,,0,0,0,,Исузу мырза, сіз...｡ Иә.
Dialogue: 0,1:11:38.95,1:11:42.28,Default,,0,0,0,,Нанасе-сенпай да қазір Бүкілжапондық іріктеуге дайындалуда.
Dialogue: 0,1:11:42.28,1:11:44.28,Default,,0,0,0,,Мен оқу-жаттығу жиынындамын, солай ма?
Dialogue: 0,1:11:44.28,1:11:46.62,Default,,0,0,0,,Иә. Кешіріңіз.
Dialogue: 0,1:11:46.62,1:11:49.62,Default,,0,0,0,,Мен ертеңгі ойынға келе алмайтын сияқтымын.
Dialogue: 0,1:11:49.62,1:11:52.63,Default,,0,0,0,,Қазір ең маңызды уақыт.
Dialogue: 0,1:11:52.63,1:11:58.30,Default,,0,0,0,,Рин-сенпай да осы уақытқа дейін қызу жұмыс істеуі керек.
Dialogue: 0,1:11:58.30,1:12:01.63,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:12:01.63,1:12:05.31,Default,,0,0,0,,Ха ха ха ха...｡ Нанасе, бүгінге қалдырыңыз.
Dialogue: 0,1:12:05.31,1:12:07.97,Default,,0,0,0,,Салқындатуды ұмытпаңыз
Dialogue: 0,1:12:07.97,1:12:10.97,Default,,0,0,0,,Хигаши Кочи. иә?
Dialogue: 0,1:12:12.91,1:12:16.25,Default,,0,0,0,,(Телефонның қоңырау үні)
Dialogue: 0,1:12:16.25,1:12:21.09,Default,,0,0,0,,Эй Хару, менің сенімен сөйлесетін бір нәрсем бар.
Dialogue: 0,1:12:21.09,1:12:26.09,Default,,0,0,0,,Мен де, жаңа ғана сөйлестік.
Dialogue: 0,1:12:26.09,1:12:30.60,Default,,0,0,0,,Майкл Кок сізді кешірді ме? Ах
Dialogue: 0,1:12:30.60,1:12:35.27,Default,,0,0,0,,Хару, бұл үшін ақылсыз болу үшін ешқандай сылтау айтпа.
Dialogue: 0,1:12:35.27,1:12:37.27,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,1:12:37.27,1:12:40.27,Default,,0,0,0,,Бір күнде жынданып кететін жынды денем жоқ.
Dialogue: 0,1:12:40.27,1:12:42.94,Default,,0,0,0,,Бұл үлкен сенімділік емес пе?
Dialogue: 0,1:12:42.94,1:12:46.95,Default,,0,0,0,,Сіз де. Хехе
Dialogue: 0,1:12:46.95,1:12:49.95,Default,,0,0,0,,Эй, сен тым жылдам бара жатырсың.
Dialogue: 0,1:12:49.95,1:12:52.29,Default,,0,0,0,,Уау, қандай керемет адам!
Dialogue: 0,1:12:52.29,1:12:54.62,Default,,0,0,0,,Ерте келгенің жақсы емес пе?
Dialogue: 0,1:12:54.62,1:12:56.96,Default,,0,0,0,,Ой!
Dialogue: 0,1:12:56.96,1:13:00.63,Default,,0,0,0,,Олай болса, кездескенше. Иә.
Dialogue: 0,1:13:00.63,1:13:04.63,Default,,0,0,0,,Сәлем, Мако-чан! Рей Нагиса
Dialogue: 0,1:13:04.63,1:13:07.30,Default,,0,0,0,,Бұл тез, Мако-чан. Жақсы.
Dialogue: 0,1:13:07.30,1:13:11.30,Default,,0,0,0,,Мен ұйықтай алмай жатқан сияқтымын. (Нагиса) Эххэхе... Мако-чан бүгін осында.
Dialogue: 0,1:13:11.30,1:13:14.24,Default,,0,0,0,,Мен жүзетін сияқты емеспін. (Макото) Бұл рас.
Dialogue: 0,1:13:14.24,1:13:17.58,Default,,0,0,0,,Сіз Рейге және басқаларға оларды қолдайтыныңызды айттыңыз ба?
Dialogue: 0,1:13:17.58,1:13:21.25,Default,,0,0,0,,Жоқ. Мен де оларға айтпаймын.
Dialogue: 0,1:13:21.25,1:13:24.55,Default,,0,0,0,,Бұл аз ғана қосымша.
Dialogue: 0,1:13:26.59,1:13:28.59,Default,,0,0,0,,Әпке!
Dialogue: 0,1:13:28.59,1:13:31.59,Default,,0,0,0,,Бұл Микошиба-сенпайдың сіңлісі...
Dialogue: 0,1:13:31.59,1:13:33.93,Default,,0,0,0,,Таңғажайып күшті жүзу
Dialogue: 0,1:13:33.93,1:13:37.26,Default,,0,0,0,,And... it's cute! (Көрермендер) О!
Dialogue: 0,1:13:37.26,1:13:39.93,Default,,0,0,0,,Yahoo! Әпкем күткендей!
Dialogue: 0,1:13:39.93,1:13:42.94,Default,,0,0,0,,Бұл жақсы жүзу. Sousuke-senpai!
Dialogue: 0,1:13:42.94,1:13:45.27,Default,,0,0,0,,So you came. Ах.
Dialogue: 0,1:13:45.27,1:13:48.61,Default,,0,0,0,,Балалар мен сендерге бір нәрсе айтқым келеді.
Dialogue: 0,1:13:48.61,1:13:51.28,Default,,0,0,0,,Асахи қайтып келмейді.
Dialogue: 0,1:13:51.28,1:13:54.61,Default,,0,0,0,,Ал, мен айтатын әңгіме көп болатынына сенімдімін.
Dialogue: 0,1:13:54.61,1:13:56.62,Default,,0,0,0,,Иә? Айтпақшы, Рей ше?
Dialogue: 0,1:13:56.62,1:13:59.45,Default,,0,0,0,,Сіз жаңа ғана сыртта ауа алайын дедіңіз.
Dialogue: 0,1:13:59.45,1:14:01.55,Default,,0,0,0,,He left, but
Dialogue: 0,1:14:06.96,1:14:09.46,Default,,0,0,0,,Not like me
Dialogue: 0,1:14:09.46,1:14:12.90,Default,,0,0,0,,Ой... Мен де жақында қайтатын боламын.
Dialogue: 0,1:14:12.90,1:14:15.74,Default,,0,0,0,,Мен сізге қайтадан электрондық хат жіберемін. Жуықта көріскенше!
Dialogue: 0,1:14:15.74,1:14:17.74,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:23.58,1:14:25.58,Default,,0,0,0,,Иә!?
Dialogue: 0,1:14:25.58,1:14:27.58,Default,,0,0,0,,Сіз! Сіз...
Dialogue: 0,1:14:29.92,1:14:33.59,Default,,0,0,0,,Сіз қызыл көзілдірікті әлі киіп жүрсіз бе?
Dialogue: 0,1:14:33.59,1:14:35.92,Default,,0,0,0,,Eh... yeah
Dialogue: 0,1:14:35.92,1:14:38.93,Default,,0,0,0,,Дәлірек айтқанда, осы жерде болу дегенді білдіреді
Dialogue: 0,1:14:38.93,1:14:40.93,Default,,0,0,0,,You still swim...
Dialogue: 0,1:14:40.93,1:14:45.26,Default,,0,0,0,,Жоқ Қарапайым киім кию тірек дегенді білдіре ме?
Dialogue: 0,1:14:45.26,1:14:48.27,Default,,0,0,0,,А, мен бүгін кішілерімді қолдауға келдім.
Dialogue: 0,1:14:48.27,1:14:53.27,Default,,0,0,0,,Мен әлі колледждемін және әлі де жүзумен айналысамын.
Dialogue: 0,1:14:53.27,1:14:57.28,Default,,0,0,0,,Мен жарғанаттар матчына барғалы жатырмын.
Dialogue: 0,1:14:57.28,1:14:59.61,Default,,0,0,0,,Шынымен! Бұл керемет емес пе!
Dialogue: 0,1:14:59.61,1:15:02.12,Default,,0,0,0,,Өткен жылы республикалық байқауға қатыса алмадым.
Dialogue: 0,1:15:02.12,1:15:06.29,Default,,0,0,0,,Сол себепті қобалжыған сияқтысың.
Dialogue: 0,1:15:06.29,1:15:08.29,Default,,0,0,0,,Міне...
Dialogue: 0,1:15:08.29,1:15:12.23,Default,,0,0,0,,Ақыл-ой жаттығулары сияқты көп нәрсе бар.
Dialogue: 0,1:15:12.23,1:15:15.56,Default,,0,0,0,,Соншалықты күрделі ойламаңыз.
Dialogue: 0,1:15:15.56,1:15:17.90,Default,,0,0,0,,Ойын – уақыттың жолы
Dialogue: 0,1:15:17.90,1:15:19.90,Default,,0,0,0,,Оны ұрып, сындырыңыз!
Dialogue: 0,1:15:19.90,1:15:21.90,Default,,0,0,0,,Жоқ, ол бұзылмауы керек.
Dialogue: 0,1:15:21.90,1:15:24.57,Default,,0,0,0,,Хахаха Бұл астарлы әңгіме.
Dialogue: 0,1:15:24.57,1:15:26.57,Default,,0,0,0,,Speaking of luck,
Dialogue: 0,1:15:26.57,1:15:29.91,Default,,0,0,0,,Сізде сәттілік болды, солай емес пе?
Dialogue: 0,1:15:29.91,1:15:32.91,Default,,0,0,0,,Көп жылдан бері бірінші рет осылай болып отырмыз
Dialogue: 0,1:15:32.91,1:15:36.21,Default,,0,0,0,,Біз ғажайып кездесу өткіздік.
Dialogue: 0,1:15:38.25,1:15:41.92,Default,,0,0,0,,That may be true.
Dialogue: 0,1:15:41.92,1:15:46.93,Default,,0,0,0,,Бұл мүмкін болмауы мүмкін. Believe it and hit it!
Dialogue: 0,1:15:46.93,1:15:49.60,Default,,0,0,0,,Не!
Dialogue: 0,1:15:49.60,1:15:52.00,Default,,0,0,0,,Иә
Dialogue: 0,1:15:53.93,1:15:55.94,Default,,0,0,0,,Ха ха... Бас Рей!
Dialogue: 0,1:15:55.94,1:15:59.94,Default,,0,0,0,,Ах... Ромео-кун Шизуру-кун
Dialogue: 0,1:15:59.94,1:16:04.94,Default,,0,0,0,,Ендеше, біз үлкендермен жүзе алғанымызға өте қуаныштымыз.
Dialogue: 0,1:16:04.94,1:16:07.28,Default,,0,0,0,,Мен мүлдем өкінбеймін.
Dialogue: 0,1:16:07.28,1:16:11.28,Default,,0,0,0,,Не? Бұл... Рей бастығы мейірімді.
Dialogue: 0,1:16:11.28,1:16:15.22,Default,,0,0,0,,Мен сенің эстафетадағы жеңіліске қатты мән беретініңді білемін, бірақ...
Dialogue: 0,1:16:15.22,1:16:17.22,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:16:17.22,1:16:22.56,Default,,0,0,0,,Осы жаз біз үшін ең жақсы жаз болды!
Dialogue: 0,1:16:22.56,1:16:26.57,Default,,0,0,0,,Бүгін Бас Рейге жүзіп келіңіз.
Dialogue: 0,1:16:26.57,1:16:28.90,Default,,0,0,0,,Менің айтқым келгені осы ғана
Dialogue: 0,1:16:28.90,1:16:31.50,Default,,0,0,0,,Мен сені қолдаймын.
Dialogue: 0,1:16:33.57,1:16:37.58,Default,,0,0,0,,Рей-чанның уайымы анық болған сияқты.
Dialogue: 0,1:16:37.58,1:16:40.25,Default,,0,0,0,,Нагиса-кун! Ол қашаннан бері сонда...
Dialogue: 0,1:16:40.25,1:16:45.25,Default,,0,0,0,,Хехехе... Роми-чанға және басқаларға деген сезімім бар сияқты.
Dialogue: 0,1:16:45.25,1:16:49.92,Default,,0,0,0,,Мен өз ойымды дұрыс жеткізе алдым деп қуандым.
Dialogue: 0,1:16:49.92,1:16:52.09,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:16:52.09,1:16:55.93,Default,,0,0,0,,Бізде де сондай кезең болған шығар.
Dialogue: 0,1:16:55.93,1:16:59.93,Default,,0,0,0,,Эй, есіңде ме? (Рей) Әрине.
Dialogue: 0,1:16:59.93,1:17:04.27,Default,,0,0,0,,Нагиса-кунның шақыруы, Харука-сенпайдың суға түсуіне тәнті болды.
Dialogue: 0,1:17:04.27,1:17:10.61,Default,,0,0,0,,Жағажайға бару, фестивальге бару, жаттығу, жүзу эстафеталары.
Dialogue: 0,1:17:10.61,1:17:15.55,Default,,0,0,0,,Алғашында жүзе алмайтын Рей-чанның өзі тамаша көрініске ие болды.
Dialogue: 0,1:17:15.55,1:17:19.55,Default,,0,0,0,,Мен мұны ешқашан жалғыз жасай алмас едім.
Dialogue: 0,1:17:19.55,1:17:23.56,Default,,0,0,0,,Мен, мен бұл сезімді суға шомылу кезінде бағалағым келеді
Dialogue: 0,1:17:23.56,1:17:26.56,Default,,0,0,0,,Иә, Нағиса-кун.
Dialogue: 0,1:17:26.56,1:17:30.23,Default,,0,0,0,,Ха ха ха ха...｡ (қуаныш)
Dialogue: 0,1:17:30.23,1:17:33.57,Default,,0,0,0,,Бұдан былай ерлер көбелегі 200 метр
Dialogue: 0,1:17:33.57,1:17:35.90,Default,,0,0,0,,Алдын ала матч... Уақытында үлгерген сияқтысыз.
Dialogue: 0,1:17:35.90,1:17:38.24,Default,,0,0,0,,Ах
Dialogue: 0,1:17:38.24,1:17:40.91,Default,,0,0,0,,Хару-чан!
Dialogue: 0,1:17:40.91,1:17:43.58,Default,,0,0,0,,Харука Сенпай! (Такасуми/Асахи) Хару!
Dialogue: 0,1:17:43.58,1:17:47.58,Default,,0,0,0,,Сен келдің. Сіз кешіктіңіз.
Dialogue: 0,1:17:50.92,1:17:54.22,Default,,0,0,0,,Рей!
Dialogue: 0,1:18:01.59,1:18:03.60,Default,,0,0,0,,Рей-чан...
Dialogue: 0,1:18:03.60,1:18:07.10,Default,,0,0,0,,Хаха... мен оның жүзгенін бірінші рет көруім.
Dialogue: 0,1:18:07.10,1:18:13.54,Default,,0,0,0,,《Рей: Дұрыс, осы сезіммен...》
Dialogue: 0,1:18:13.54,1:18:15.88,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,1:18:15.88,1:18:19.88,Default,,0,0,0,,Менің мектептегі соңғы ойыным, нағыз жарғанат
Dialogue: 0,1:18:19.88,1:18:22.21,Default,,0,0,0,,Қарап көрейік!
Dialogue: 0,1:18:22.21,1:18:25.22,Default,,0,0,0,,Бағаларыңызды алыңыз.
Dialogue: 0,1:18:25.22,1:18:27.22,Default,,0,0,0,,(Электронды тапанша дыбысы)
Dialogue: 0,1:18:27.22,1:18:29.89,Default,,0,0,0,,Рей! Рей-чан!
Dialogue: 0,1:18:29.89,1:18:31.89,Default,,0,0,0,,Рей! Рейкун!
Dialogue: 0,1:18:31.89,1:18:33.89,Default,,0,0,0,,Директор Рей!
Dialogue: 0,1:18:33.89,1:18:36.90,Default,,0,0,0,,Бар, бар, бар, бар, Рей!
Dialogue: 0,1:18:36.90,1:18:50.58,Default,,0,0,0,,～
Dialogue: 0,1:18:50.58,1:18:53.25,Default,,0,0,0,,Бұл жігіт Иватоби болатын.
Dialogue: 0,1:18:53.25,1:18:57.25,Default,,0,0,0,,Бұл Асахиге жақсы қарсылас болмай ма?
Dialogue: 0,1:18:57.25,1:18:59.25,Default,,0,0,0,,Ах
Dialogue: 0,1:18:59.25,1:19:02.25,Default,,0,0,0,,Сенде ондайға батылың жетпейді ғой
Dialogue: 0,1:19:04.26,1:19:08.26,Default,,0,0,0,,Ерлер арасында 100 метрге брасс әдісімен жүзуден 3-ші топ
Dialogue: 0,1:19:08.26,1:19:12.03,Default,,0,0,0,,Келесі Ай-сенпайдың батасы. Ах.
Dialogue: 0,1:19:12.03,1:19:14.53,Default,,0,0,0,,Ай!
Dialogue: 0,1:19:14.53,1:19:18.70,Default,,0,0,0,,Мен жеңілмеймін, Нағиса-күн.
Dialogue: 0,1:19:18.70,1:19:20.70,Default,,0,0,0,,Мен де
Dialogue: 0,1:19:24.21,1:19:26.88,Default,,0,0,0,,Бағаларыңызды алыңыз.
Dialogue: 0,1:19:26.88,1:19:29.22,Default,,0,0,0,,(Электронды тапанша дыбысы)
Dialogue: 0,1:19:29.22,1:19:34.22,Default,,0,0,0,,Дәмді! (Момотаро) Біз басынан-ақ өзгеріс жасадық!
Dialogue: 0,1:19:34.22,1:19:36.22,Default,,0,0,0,,Нагиса!
Dialogue: 0,1:19:36.22,1:19:39.56,Default,,0,0,0,,Нагиса! (Ромео және т.б.) Нағиса-сенпай!
Dialogue: 0,1:19:39.56,1:19:41.96,Default,,0,0,0,,Нагиса!
Dialogue: 0,1:19:45.23,1:19:49.24,Default,,0,0,0,,Ағаның мақсатқа жету алдындағы өсуі!
Dialogue: 0,1:19:49.24,1:19:51.24,Default,,0,0,0,,Нағиса-сенпай!
Dialogue: 0,1:19:57.74,1:19:59.75,Default,,0,0,0,,Сенде ондайға батылың жетпейді ғой
Dialogue: 0,1:19:59.75,1:20:04.58,Default,,0,0,0,,Нагиса-кун! Хаха... Рахмет
Dialogue: 0,1:20:04.58,1:20:07.28,Default,,0,0,0,,Мен де солай.
Dialogue: 0,1:20:11.26,1:20:14.59,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз, Рей Нагиса
Dialogue: 0,1:20:14.59,1:20:16.60,Default,,0,0,0,,Иә. Иә.
Dialogue: 0,1:20:16.60,1:20:20.93,Default,,0,0,0,,Бүгін бізді қолдауға келгеніңіз үшін рахмет.
Dialogue: 0,1:20:20.93,1:20:26.27,Default,,0,0,0,,Финалға өте алмасам да, менің жеке уақытым жаңартылды.
Dialogue: 0,1:20:26.27,1:20:30.57,Default,,0,0,0,,Соңғы мектеп ойыны, өкінбеймін
Dialogue: 0,1:20:33.28,1:20:37.62,Default,,0,0,0,,Нағиса да күшейе түсті.
Dialogue: 0,1:20:37.62,1:20:40.29,Default,,0,0,0,,Рахмет. Бұл мен.
Dialogue: 0,1:20:40.29,1:20:43.29,Default,,0,0,0,,Мен осы уақытқа дейін барлығымен жүзе алдым.
Dialogue: 0,1:20:43.29,1:20:46.63,Default,,0,0,0,,Мен өзімді өте қызық сезіндім.
Dialogue: 0,1:20:46.63,1:20:51.96,Default,,0,0,0,,Мен көптеген маңызды сезімдерді сезіне алдым.
Dialogue: 0,1:20:51.96,1:20:56.97,Default,,0,0,0,,Бүгін де менің жүрегім суда соғып тұрды.
Dialogue: 0,1:20:56.97,1:21:00.64,Default,,0,0,0,,Мен жүзуді өте жақсы көремін.
Dialogue: 0,1:21:00.64,1:21:03.31,Default,,0,0,0,,Иә
Dialogue: 0,1:21:03.31,1:21:05.98,Default,,0,0,0,,Ромео. иә?
Dialogue: 0,1:21:05.98,1:21:09.65,Default,,0,0,0,,Елді де аралап көрейік
Dialogue: 0,1:21:09.65,1:21:12.59,Default,,0,0,0,,That's right.
Dialogue: 0,1:21:12.59,1:21:14.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:14.59,1:21:17.26,Default,,0,0,0,,Біз мұны жасадық!
Dialogue: 0,1:21:17.26,1:21:19.59,Default,,0,0,0,,Мен қышуды сезінемін.
Dialogue: 0,1:21:19.59,1:21:22.93,Default,,0,0,0,,Бар күшіңмен орал.
Dialogue: 0,1:21:22.93,1:21:25.93,Default,,0,0,0,,О, күте тұрыңыз. Алайда...
Dialogue: 0,1:21:25.93,1:21:28.43,Default,,0,0,0,,Менен жеңілсең де жылама
Dialogue: 0,1:21:28.43,1:21:31.94,Default,,0,0,0,,Эй... жылама!
Dialogue: 0,1:21:31.94,1:21:36.61,Default,,0,0,0,,Хахахаха хахахаха!
Dialogue: 0,1:21:36.61,1:21:39.61,Default,,0,0,0,,Хахаха. Рин!
Dialogue: 0,1:21:39.61,1:21:41.95,Default,,0,0,0,,Рин де келді.
Dialogue: 0,1:21:41.95,1:21:44.28,Default,,0,0,0,,Сосуке де шаршады.
Dialogue: 0,1:21:44.28,1:21:46.29,Default,,0,0,0,,О
Dialogue: 0,1:21:46.29,1:21:49.96,Default,,0,0,0,,Рей де, Нагиса да барын салды, солай ма?
Dialogue: 0,1:21:49.96,1:21:55.29,Default,,0,0,0,,Иә. Бірақ бұл шынымен жақсы болды ма?
Dialogue: 0,1:21:55.29,1:21:57.30,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:21:57.30,1:22:00.80,Default,,0,0,0,,Бүгін келмегеніме өкінемін.
Dialogue: 0,1:22:00.80,1:22:03.30,Default,,0,0,0,,Ах
Dialogue: 0,1:22:03.30,1:22:08.97,Default,,0,0,0,,Осы байланыстың арқасында мен қазір осындамын.
Dialogue: 0,1:22:08.97,1:22:11.91,Default,,0,0,0,,Бұдан былай біз бұл байланысты сақтаймыз
Dialogue: 0,1:22:11.91,1:22:15.92,Default,,0,0,0,,Біз болашаққа дейін жалғасамыз.
Dialogue: 0,1:22:15.92,1:22:22.22,Default,,0,0,0,,Хару! Әрі қарай, біздің кезегіміз.
Dialogue: 0,1:22:24.26,1:22:28.96,Default,,0,0,0,,Ах, барлық Жапония таңдауы.
Dialogue: 0,1:22:32.26,1:23:02.29,Default,,0,0,0,,～
Dialogue: 0,1:23:02.29,1:23:07.30,Default,,0,0,0,,Мен Рюджи екеуіміз орта мектептен бастап қарсыласпыз деп айттым ба?
Dialogue: 0,1:23:07.30,1:23:10.97,Default,,0,0,0,,Иә. Ол данышпан еді.
Dialogue: 0,1:23:10.97,1:23:14.91,Default,,0,0,0,,Ол сөзсіз әлем шыңында тұра алатын ойыншы болды.
Dialogue: 0,1:23:14.91,1:23:16.91,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,1:23:16.91,1:23:21.91,Default,,0,0,0,,Бүкіл Жапония таңдауына бірнеше күн қалғанда, Рюджидің бала кездегі досы...
Dialogue: 0,1:23:21.91,1:23:23.92,Default,,0,0,0,,Мен апатқа ұшырадым. Ха...
Dialogue: 0,1:23:23.92,1:23:27.59,Default,,0,0,0,,Осы кезде Рюджи жақын досына асығудан гөрі көп ойланды.
Dialogue: 0,1:23:27.59,1:23:30.59,Default,,0,0,0,,Мен матчқа қатысуды таңдадым.
Dialogue: 0,1:23:30.59,1:23:32.93,Default,,0,0,0,,Сонда сіз жеңдіңіз бе?
Dialogue: 0,1:23:32.93,1:23:36.26,Default,,0,0,0,,Жоқ, мен жеңілдім.
Dialogue: 0,1:23:36.26,1:23:40.60,Default,,0,0,0,,Рюджи алысқа созылған матчта жеңе алмады.
Dialogue: 0,1:23:40.60,1:23:44.27,Default,,0,0,0,,Соңында мен ойыншы ретінде зейнетке шықтым.
Dialogue: 0,1:23:44.27,1:23:47.27,Default,,0,0,0,,Рюджи әлі де жүзумен айналысады.
Dialogue: 0,1:23:47.27,1:23:51.28,Default,,0,0,0,,Маңызды нәрсені іздей бергендей сезінемін.
Dialogue: 0,1:23:51.28,1:23:54.28,Default,,0,0,0,,Ол Нанасе-кунды жаттықтыруда.
Dialogue: 0,1:23:54.28,1:23:59.28,Default,,0,0,0,,Менің ойымша, ол сізді өзі сияқты жолмен жүруге мүмкіндік бермеуге тырысады.
Dialogue: 0,1:25:44.09,1:25:46.59,Default,,0,0,0,,Үлкен аға! Ілгері жүру!
Dialogue: 0,1:25:46.59,1:25:49.29,Default,,0,0,0,,Хошикава-сенпай! Ұрыс! Капитан!
Dialogue: 0,1:25:52.43,1:25:54.93,Default,,0,0,0,,Қарғыс атсын! (Хошикава) Қарғыс атсын!
Dialogue: 0,1:25:54.93,1:25:56.94,Default,,0,0,0,,…
Dialogue: 0,1:25:56.94,1:26:00.27,Default,,0,0,0,,Тіпті Хошикава-сенпай... алдын ала раундта сәтсіздікке ұшырады...
Dialogue: 0,1:26:00.27,1:26:02.61,Default,,0,0,0,,Бұл керемет, Рей Чан
Dialogue: 0,1:26:02.61,1:26:05.28,Default,,0,0,0,,Иә, алыстағы қарттар
Dialogue: 0,1:26:05.28,1:26:09.62,Default,,0,0,0,,Сіз шынымен таңғажайып әлемге секірдіңіз.
Dialogue: 0,1:26:09.62,1:26:14.55,Default,,0,0,0,,Бос 50...бұрын тең болған деп ойлаймын.
Dialogue: 0,1:26:14.55,1:26:17.89,Default,,0,0,0,,А, бүгін ақ пен қараны киеміз.
Dialogue: 0,1:26:17.89,1:26:20.89,Default,,0,0,0,,Мен осы күні жүзуді жалғастырдым.
Dialogue: 0,1:26:20.89,1:26:23.23,Default,,0,0,0,,Менің... Уау!
Dialogue: 0,1:26:23.23,1:26:25.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:26:28.07,1:26:30.57,Default,,0,0,0,,(қолдау)
Dialogue: 0,1:26:30.57,1:26:36.58,Default,,0,0,0,,Міне, Нарубузавалық Каэде Кинджо келді
Dialogue: 0,1:26:36.58,1:26:40.25,Default,,0,0,0,,Ол...
Dialogue: 0,1:26:40.25,1:26:42.95,Default,,0,0,0,,Бағаларыңызды алыңыз.
Dialogue: 0,1:26:45.25,1:26:47.95,Default,,0,0,0,,Қараңыз! (Электронды тапанша дыбысы)
Dialogue: 0,1:26:51.26,1:26:53.26,Default,,0,0,0,,Асахи!
Dialogue: 0,1:26:53.26,1:26:56.93,Default,,0,0,0,,Кинджо есімді адам өте әсерлі.
Dialogue: 0,1:26:56.93,1:26:59.23,Default,,0,0,0,,Қарғыс атсын…. Қарғыс атсын!
Dialogue: 0,1:27:10.28,1:27:12.38,Default,,0,0,0,,Phat!
Dialogue: 0,1:27:12.38,1:27:14.88,Default,,0,0,0,,Турнир рекорды маңызды ма?
Dialogue: 0,1:27:14.88,1:27:18.88,Default,,0,0,0,,Не болды? Сіз қорқып кеттіңіз бе? Жоқ, жоқ
Dialogue: 0,1:27:18.88,1:27:22.72,Default,,0,0,0,,Бір нәрседен бас тартпасаң, күшті бола алмайсың.
Dialogue: 0,1:27:22.72,1:27:26.23,Default,,0,0,0,,Бәсекелестік әлемде лайықты жүйкемен өмір сүре алмайсыз.
Dialogue: 0,1:27:26.23,1:27:29.23,Default,,0,0,0,,Сіз үшін маңызды біреуге бірдеңе болса да
Dialogue: 0,1:27:29.23,1:27:35.23,Default,,0,0,0,,Жүрегіне кедергі келтірмейтіндер нәтиже қалдыратын дүние.
Dialogue: 0,1:27:35.23,1:27:38.90,Default,,0,0,0,,Келесі кезекте 100 метрге баттерфляй әдісімен жүзу.
Dialogue: 0,1:27:38.90,1:27:41.24,Default,,0,0,0,,Рин-сенпай!
Dialogue: 0,1:27:41.24,1:27:43.91,Default,,0,0,0,,(Ысқырық)
Dialogue: 0,1:27:43.91,1:27:45.91,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:27:45.91,1:27:47.91,Default,,0,0,0,,Бағаларыңызды алыңыз.
Dialogue: 0,1:27:47.91,1:27:49.92,Default,,0,0,0,,Қараңыз! (Электронды тапанша дыбысы)
Dialogue: 0,1:27:49.92,1:27:51.92,Default,,0,0,0,,Жаман бастама емес
Dialogue: 0,1:27:51.92,1:27:56.59,Default,,0,0,0,,Бірақ бұл финалда халықаралық жарыстарда тәжірибесі бар үш адам болды.
Dialogue: 0,1:27:56.59,1:27:58.59,Default,,0,0,0,,Рин…
Dialogue: 0,1:27:58.59,1:28:01.59,Default,,0,0,0,,Ku…
Dialogue: 0,1:28:01.59,1:28:03.93,Default,,0,0,0,,Жылдамдық артты!
Dialogue: 0,1:28:03.93,1:28:06.60,Default,,0,0,0,,Рин-чан!
Dialogue: 0,1:28:06.60,1:28:09.94,Default,,0,0,0,,Рин! мен...
Dialogue: 0,1:28:09.94,1:28:12.54,Default,,0,0,0,,Уууу~! Уф!
Dialogue: 0,1:28:16.54,1:28:21.05,Default,,0,0,0,,Ха ха ха…
Dialogue: 0,1:28:21.05,1:28:25.22,Default,,0,0,0,,Екінші орын! Оның үстіне стандартты уақыт анық
Dialogue: 0,1:28:25.22,1:28:27.22,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:27.22,1:28:29.56,Default,,0,0,0,,Рин Жақсы.
Dialogue: 0,1:28:29.56,1:28:34.23,Default,,0,0,0,,Ха... хахаха! Шаа!
Dialogue: 0,1:28:34.23,1:28:38.23,Default,,0,0,0,,Қараңызшы, сіз келесідесіз. Дайын бол.
Dialogue: 0,1:28:38.23,1:28:41.57,Default,,0,0,0,,Иә
Dialogue: 0,1:28:41.57,1:28:44.90,Default,,0,0,0,,Ерлер арасында 200 метрге еркін жүзу финалы
Dialogue: 0,1:28:44.90,1:28:48.91,Default,,0,0,0,,Бұл жерде ұтсақ, келесі қадам әлем. Иә.
Dialogue: 0,1:28:48.91,1:28:51.24,Default,,0,0,0,,Аяқ
Dialogue: 0,1:28:51.24,1:28:55.94,Default,,0,0,0,,5-жол Haruka Nanase Тотака университеті
Dialogue: 0,1:29:01.25,1:29:03.92,Default,,0,0,0,,Хару…
Dialogue: 0,1:29:03.92,1:29:05.92,Default,,0,0,0,,Бағаларыңызды алыңыз.
Dialogue: 0,1:29:05.92,1:29:08.26,Default,,0,0,0,,Қараңыз! (Электронды тапанша дыбысы)
Dialogue: 0,1:29:08.26,1:29:10.93,Default,,0,0,0,,Әлгі ақымақ! Мен кешігіп қалдым!
Dialogue: 0,1:29:10.93,1:29:14.20,Default,,0,0,0,,Харука Сенпай! Хару-чан!
Dialogue: 0,1:29:14.20,1:29:17.54,Default,,0,0,0,,Харудың әдеттегі икемділігі...
Dialogue: 0,1:29:17.54,1:29:20.21,Default,,0,0,0,,Хару…
Dialogue: 0,1:29:20.21,1:29:24.21,Default,,0,0,0,,Хару! Бар!
Dialogue: 0,1:29:24.21,1:29:53.91,Default,,0,0,0,,～
Dialogue: 0,1:29:53.91,1:29:55.91,Default,,0,0,0,,
Dialogue: 0,1:29:55.91,1:29:58.51,Default,,0,0,0,,Хару-чан жоғалды...
Dialogue: 0,1:30:02.25,1:30:04.25,Default,,0,0,0,,Сенде ондайға батылың жетпейді ғой
Dialogue: 0,1:30:18.26,1:30:21.60,Default,,0,0,0,,Бір нәрседен бас тартпасаң, өмір сүре алмайсың
Dialogue: 0,1:30:21.60,1:30:25.27,Default,,0,0,0,,Бірақ мен оны тастағым келмеді
Dialogue: 0,1:30:25.27,1:30:28.27,Default,,0,0,0,,Бірақ мен жеңілдім
Dialogue: 0,1:30:28.27,1:30:31.94,Default,,0,0,0,,Мен бұл туралы ойын аяқталғаннан бері ойлап жүрмін.
Dialogue: 0,1:30:31.94,1:30:36.95,Default,,0,0,0,,Мен әлемде бәсекелесуге жарамды емеспін бе?
Dialogue: 0,1:30:36.95,1:30:39.62,Default,,0,0,0,,Ахахаха!
Dialogue: 0,1:30:39.62,1:30:41.95,Default,,0,0,0,,Неге күлу керек?
Dialogue: 0,1:30:41.95,1:30:46.29,Default,,0,0,0,,Жоқ, менің ойымша, Хару да қысымды сезінеді.
Dialogue: 0,1:30:46.29,1:30:48.96,Default,,0,0,0,,Күн қатты қызып барады, солай емес пе?
Dialogue: 0,1:30:48.96,1:30:53.30,Default,,0,0,0,,Біз Халдың жүзуінің арқасында келдік.
Dialogue: 0,1:30:53.30,1:30:56.97,Default,,0,0,0,,Осылай уайымдаудың өзі жауап емес пе?
Dialogue: 0,1:30:56.97,1:31:00.64,Default,,0,0,0,,Хэхехе. Бұл не?
Dialogue: 0,1:31:00.64,1:31:03.31,Default,,0,0,0,,Сәлем Хару
Dialogue: 0,1:31:03.31,1:31:07.98,Default,,0,0,0,,Мен де неше түрлі уайымға жығылғандай болдым.
Dialogue: 0,1:31:07.98,1:31:11.32,Default,,0,0,0,,Өз-өзіме сенбей қалған кездерім болды.
Dialogue: 0,1:31:11.32,1:31:14.59,Default,,0,0,0,,Жоқ, менің ойымша, сіз білесіз.
Dialogue: 0,1:31:14.59,1:31:18.92,Default,,0,0,0,,Бірақ біз бір-бірімізбен күресіп, күресіп, соқтығыстық.
Dialogue: 0,1:31:18.92,1:31:21.93,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,1:31:21.93,1:31:26.26,Default,,0,0,0,,Арманға жетудің бірнеше жолы бар.
Dialogue: 0,1:31:26.26,1:31:30.27,Default,,0,0,0,,Ертең біз мүмкіндігінше сезінеміз
Dialogue: 0,1:31:30.27,1:31:32.60,Default,,0,0,0,,Соқайық!
Dialogue: 0,1:31:32.60,1:31:38.28,Default,,0,0,0,,Балалармен жұмыс істей жүріп жаттықтырушы боламын деп шештім.
Dialogue: 0,1:31:38.28,1:31:40.28,Default,,0,0,0,,Не? (Макото) Армандаңыз
Dialogue: 0,1:31:40.28,1:31:42.78,Default,,0,0,0,,Достарыңызбен қалай соқтығысқаныңызды жақыннан қараңыз
Dialogue: 0,1:31:42.78,1:31:46.62,Default,,0,0,0,,Мен бұдан да басқа істегім келетін нәрсе бар екенін түсіндім.
Dialogue: 0,1:31:46.62,1:31:50.12,Default,,0,0,0,,Осылай ойлағалы бері толқыдым.
Dialogue: 0,1:31:50.12,1:31:54.29,Default,,0,0,0,,Әлем үшін күресетін спортшыларды қолдағым келеді.
Dialogue: 0,1:31:54.29,1:31:56.29,Default,,0,0,0,,Балалар орындайтынына сенімдімін
Dialogue: 0,1:31:56.29,1:31:59.63,Default,,0,0,0,,Өйткені бұл жүзу қуанышын жеткізуге көмектеседі деп ойладым.
Dialogue: 0,1:31:59.63,1:32:02.63,Default,,0,0,0,,Хахаха, бұл керемет емес пе?
Dialogue: 0,1:32:02.63,1:32:06.30,Default,,0,0,0,,Мүмкін болса, мені екі адам қолдағанын қалаймын.
Dialogue: 0,1:32:06.30,1:32:10.64,Default,,0,0,0,,Сол кездегі табиғат көрінісін қайта көрсек, тамаша болар еді.
Dialogue: 0,1:32:10.64,1:32:13.91,Default,,0,0,0,,Хахаха жай ғана салқын болуға тырыстым.
Dialogue: 0,1:32:13.91,1:32:16.92,Default,,0,0,0,,Мен сені сүйем, Макото.
Dialogue: 0,1:32:16.92,1:32:19.52,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:32:24.92,1:32:29.93,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:29.93,1:32:33.93,Default,,0,0,0,,Дүниеде шайқас!
Dialogue: 0,1:32:33.93,1:32:36.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:36.60,1:32:38.94,Default,,0,0,0,,Сәлем! Ахахаха!
Dialogue: 0,1:32:38.94,1:32:41.61,Default,,0,0,0,,Біз де барайық, Рин! иә?
Dialogue: 0,1:32:41.61,1:32:45.61,Default,,0,0,0,,Әй, бұл қандай жастар драмасы?
Dialogue: 0,1:32:45.61,1:32:48.28,Default,,0,0,0,,Таку!
Dialogue: 0,1:32:48.28,1:32:51.62,Default,,0,0,0,,Бұл турнирде көптеген қиын матчтар болады.
Dialogue: 0,1:32:51.62,1:32:55.29,Default,,0,0,0,,Жасөспірімдерге қысым көп болуы мүмкін.
Dialogue: 0,1:32:55.29,1:32:59.79,Default,,0,0,0,,Менталитетіңіз тым әлсіз. Таку Нанасе жоқ Яту
Dialogue: 0,1:32:59.79,1:33:02.96,Default,,0,0,0,,Әлем чемпионаты жақындап қалды, бірақ мен оны өткізіп алдым.
Dialogue: 0,1:33:02.96,1:33:05.63,Default,,0,0,0,,Сіз байқадыңыз ба? Ах
Dialogue: 0,1:33:05.63,1:33:09.63,Default,,0,0,0,,Мүмкін мен бастауға үлгермей, күшім жоғалған шығар.
Dialogue: 0,1:33:09.63,1:33:14.57,Default,,0,0,0,,Оның ортадағы жылдамдығы Альберттен жоғары екені анық.
Dialogue: 0,1:33:14.57,1:33:17.58,Default,,0,0,0,,Бірақ ол екінші таймда тоқтап қалды
Dialogue: 0,1:33:17.58,1:33:21.41,Default,,0,0,0,,Бәлкім, ол шынымен де білген нәрсе болды
Dialogue: 0,1:33:21.41,1:33:23.92,Default,,0,0,0,,Кинджо да, Альберто да емес
Dialogue: 0,1:33:23.92,1:33:28.25,Default,,0,0,0,,Менің ойымша, ол өзінің шегінен асып кеткен еркіндігімен шатастырды.
Dialogue: 0,1:33:28.25,1:33:30.76,Default,,0,0,0,,Ол әлі өзгеріп жатыр
Dialogue: 0,1:33:30.76,1:33:33.26,Default,,0,0,0,,Бұл шынымен де қорқынышты.
Dialogue: 0,1:33:33.26,1:33:36.26,Default,,0,0,0,,Ринкун да жеңілді деп ойламаймын.
Dialogue: 0,1:33:36.26,1:33:38.93,Default,,0,0,0,,Аа... Ертең білеміз.
Dialogue: 0,1:33:38.93,1:33:42.93,Default,,0,0,0,,Сіз біздің достығымыз туралы жылы сөздер айтасыз.
Dialogue: 0,1:33:42.93,1:33:45.60,Default,,0,0,0,,Уақыт өзгеріп жатыр, Рюджи.
Dialogue: 0,1:33:45.60,1:33:49.11,Default,,0,0,0,,Бұл балалар шынымен...
Dialogue: 0,1:33:49.11,1:33:52.28,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:33:52.28,1:33:54.61,Default,,0,0,0,,Сіз теңізде жүзіп жүрсіз бе?
Dialogue: 0,1:33:54.61,1:33:57.95,Default,,0,0,0,,Керемет, мен қызғанамын
Dialogue: 0,1:33:57.95,1:34:01.29,Default,,0,0,0,,Әдемі
Dialogue: 0,1:34:01.29,1:34:05.99,Default,,0,0,0,,Менің де жаңа арманым бар сияқты.
Dialogue: 0,1:34:13.90,1:34:17.24,Default,,0,0,0,,Қараңдаршы, бәріміз кешкі асқа кешігіп қаламыз.
Dialogue: 0,1:34:17.24,1:34:20.57,Default,,0,0,0,,Не? О, Рей-чан, бұл арман...
Dialogue: 0,1:34:20.57,1:34:22.57,Default,,0,0,0,,Маған қазір ұнамайды.
Dialogue: 0,1:34:22.57,1:34:26.24,Default,,0,0,0,,Рей-чан қу! Мен қу емеспін
Dialogue: 0,1:34:26.24,1:34:29.92,Default,,0,0,0,,Енді олай емес.
Dialogue: 0,1:34:29.92,1:34:32.92,Default,,0,0,0,,Нагиса-кун әрқашан...
Dialogue: 0,1:34:32.92,1:34:36.59,Default,,0,0,0,,Икуя бүгін өте жақсы жүзді.
Dialogue: 0,1:34:36.59,1:34:38.59,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:34:38.59,1:34:40.93,Default,,0,0,0,,Мен ертең қандай нәтиже алатынымды білмеймін, бірақ
Dialogue: 0,1:34:40.93,1:34:42.93,Default,,0,0,0,,Мен шамам келгенше жүзуге тырысамын
Dialogue: 0,1:34:42.93,1:34:45.26,Default,,0,0,0,,Мен Икуяның жақсы болатынына сенімдімін.
Dialogue: 0,1:34:45.26,1:34:48.93,Default,,0,0,0,,Осындай шуақты күнде де, қолыңда сөмке қалады.
Dialogue: 0,1:34:48.93,1:34:52.60,Default,,0,0,0,,Хиоридің қабілетімен жеңіске жетуге жақсы мүмкіндік бар.
Dialogue: 0,1:34:52.60,1:34:57.61,Default,,0,0,0,,Икуя танылу үшін сіз жарысты жүзуді жалғастырған болуыңыз керек.
Dialogue: 0,1:34:57.61,1:35:00.28,Default,,0,0,0,,Тым асыра айтылған. Хахахаха
Dialogue: 0,1:35:00.28,1:35:03.95,Default,,0,0,0,,Аа, кешіріңіз, мен смартфонымды ұмытып қалдым.
Dialogue: 0,1:35:03.95,1:35:06.62,Default,,0,0,0,,Тағы не? Мен оны бірден аламын
Dialogue: 0,1:35:06.62,1:35:09.62,Default,,0,0,0,,Мен осында күтемін. Түсіндім.
Dialogue: 0,1:35:20.23,1:35:23.23,Default,,0,0,0,,А, бұл тез болды, Ику...
Dialogue: 0,1:35:23.23,1:35:26.24,Default,,0,0,0,,Иә? Егер сіз біреуді ойласаңыз
Dialogue: 0,1:35:26.24,1:35:29.57,Default,,0,0,0,,Жылаушы Хиёри-кун. Кинджо...
Dialogue: 0,1:35:29.57,1:35:32.91,Default,,0,0,0,,Weather Free 50 керемет өсті
Dialogue: 0,1:35:32.91,1:35:34.91,Default,,0,0,0,,Сіз шынымен дарындысыз.
Dialogue: 0,1:35:34.91,1:35:38.92,Default,,0,0,0,,Мен бала кезімде турнирлерде лайықты нәтижелерге қол жеткіздім.
Dialogue: 0,1:35:38.92,1:35:43.25,Default,,0,0,0,,Бірақ Америкадан оралғаннан кейін үлгерімім баяу болды.
Dialogue: 0,1:35:43.25,1:35:46.93,Default,,0,0,0,,Сіз әлі де Икуямен араласып жүрсіз бе?
Dialogue: 0,1:35:46.93,1:35:49.26,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,1:35:49.26,1:35:52.60,Default,,0,0,0,,Шынымен, сіз әлі де су перісі ханшайымын ойнап жүрсіз бе?
Dialogue: 0,1:35:52.60,1:35:54.60,Default,,0,0,0,,Қойшы.
Dialogue: 0,1:35:54.60,1:35:57.60,Default,,0,0,0,,Мен бәрібір жалғыз жүземін.
Dialogue: 0,1:35:57.60,1:36:00.61,Default,,0,0,0,,Мен де солай ойлайтынмын.
Dialogue: 0,1:36:00.61,1:36:03.94,Default,,0,0,0,,Ей, жақсы күн...
Dialogue: 0,1:36:03.94,1:36:06.44,Default,,0,0,0,,Бұл қайшы көздер қандай?
Dialogue: 0,1:36:06.44,1:36:09.61,Default,,0,0,0,,Мен сізге бірнеше кеңес беремін.
Dialogue: 0,1:36:09.61,1:36:12.22,Default,,0,0,0,,Нанасе-кунды жеңе алмайсың.
Dialogue: 0,1:36:12.22,1:36:16.39,Default,,0,0,0,,Ей, кім кімнен жеңеді?
Dialogue: 0,1:36:16.39,1:36:20.56,Default,,0,0,0,,Нанасе-кунмен жүзсеңіз, сіз де түсінесіз!
Dialogue: 0,1:36:20.56,1:36:24.23,Default,,0,0,0,,О? Не түсінбеймін...
Dialogue: 0,1:36:24.23,1:36:27.23,Default,,0,0,0,,Бұл қолды жібер, Кинджо!
Dialogue: 0,1:36:27.23,1:36:30.07,Default,,0,0,0,,Аа, бұл Икуя-кун емес.
Dialogue: 0,1:36:30.07,1:36:33.24,Default,,0,0,0,,Сіз спортшысыз, сондықтан жарыстарға қатысыңыз.
Dialogue: 0,1:36:33.24,1:36:36.91,Default,,0,0,0,,Хахаха... Мен сізбен жүзуде бәсекеге түсе алмаймын.
Dialogue: 0,1:36:36.91,1:36:39.58,Default,,0,0,0,,Сонымен, сіз оны қолданып көргіңіз келе ме? Хмм...
Dialogue: 0,1:36:39.58,1:36:42.58,Default,,0,0,0,,Мектепке дейін кім болдым
Dialogue: 0,1:36:42.58,1:36:45.92,Default,,0,0,0,,Тіпті Икуя-кун да, күткендей, енді жеңе алмайды.
Dialogue: 0,1:36:45.92,1:36:50.59,Default,,0,0,0,,Сен менің ағамды ренжітіп тұрған жоқсың.
Dialogue: 0,1:36:50.59,1:36:52.59,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,1:36:52.59,1:36:56.26,Default,,0,0,0,,Бұл өте өрескел. Мүлдем.
Dialogue: 0,1:36:56.26,1:37:01.60,Default,,0,0,0,,Куджиразуда болған Икуяның үлкен ағасы және Соусуке Ямадзаки?
Dialogue: 0,1:37:01.60,1:37:04.60,Default,,0,0,0,,Хехехе... Маған достарым қатты ұнайды.
Dialogue: 0,1:37:04.60,1:37:06.60,Default,,0,0,0,,Үйге кететін уақыт келді
Dialogue: 0,1:37:06.60,1:37:11.28,Default,,0,0,0,,Ертең менің жүзуімді қараңыз. Мен бәріңді жауып тастаймын.
Dialogue: 0,1:37:11.28,1:37:13.55,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:37:13.55,1:37:16.88,Default,,0,0,0,,Бұл жапон рекордына ең жақын көрсеткіш.
Dialogue: 0,1:37:16.88,1:37:19.22,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:37:19.22,1:37:23.22,Default,,0,0,0,,Бірақ одан тыс дүние бар
Dialogue: 0,1:37:27.56,1:37:31.90,Default,,0,0,0,,(қуаныш)
Dialogue: 0,1:37:31.90,1:37:35.23,Default,,0,0,0,,Оңай стандартты уақыт анық
Dialogue: 0,1:37:35.23,1:37:37.90,Default,,0,0,0,,Тіпті 100 тегінде де турнир рекорды бар...
Dialogue: 0,1:37:37.90,1:37:39.90,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,1:37:39.90,1:37:44.20,Default,,0,0,0,,Ерлер арасында 100 метрге еркін жүзу, іріктеу 4 топ
Dialogue: 0,1:37:47.25,1:37:49.58,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Хару
Dialogue: 0,1:37:49.58,1:37:51.58,Default,,0,0,0,,Таң қаларлықтай тыныш
Dialogue: 0,1:37:51.58,1:37:54.92,Default,,0,0,0,,Хаха, мен оны асыға күтемін.
Dialogue: 0,1:37:54.92,1:37:57.59,Default,,0,0,0,,Әлем сізді күтуде
Dialogue: 0,1:37:57.59,1:37:59.59,Default,,0,0,0,,Бұл түс сияқты, солай ма?
Dialogue: 0,1:37:59.59,1:38:02.26,Default,,0,0,0,,Бірақ бұл арман емес
Dialogue: 0,1:38:02.26,1:38:06.93,Default,,0,0,0,,Аа, дұрыс. Қолымды созсам, қолым жететін жерде.
Dialogue: 0,1:38:06.93,1:38:12.20,Default,,0,0,0,,Бұдан былай не болатынын ешкім білмейді.
Dialogue: 0,1:38:12.20,1:38:16.04,Default,,0,0,0,,Алда не күтіп тұрғанын білейік
Dialogue: 0,1:38:16.04,1:38:19.54,Default,,0,0,0,,А, секірейік.
Dialogue: 0,1:38:19.54,1:38:21.55,Default,,0,0,0,,Болашаққа! (Электронды тапанша дыбысы)
Dialogue: 0,1:38:21.55,1:38:23.55,Default,,0,0,0,,Қараңыз!
Dialogue: 0,1:38:25.05,1:38:31.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory