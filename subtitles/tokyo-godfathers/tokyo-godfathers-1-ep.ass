Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.68,0:00:26.27,Default,,0,0,0,,Біз шығыста жұлдызды көрдік
Dialogue: 0,0:00:28.20,0:00:32.51,Default,,0,0,0,,Жұлдыз маған Құдай Ұлының дүниеге келгенін айтты.
Dialogue: 0,0:00:33.40,0:00:40.31,Default,,0,0,0,,Тыныш түн
Dialogue: 0,0:00:40.64,0:00:47.63,Default,,0,0,0,,Жұлдыздар жарқырайды
Dialogue: 0,0:00:47.72,0:00:54.35,Default,,0,0,0,,Құтқарушы Ұлы
Dialogue: 0,0:00:54.72,0:01:01.39,Default,,0,0,0,,Ана төсінде
Dialogue: 0,0:01:01.84,0:01:08.75,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:01:08.76,0:01:11.87,Default,,0,0,0,,Исаны ақырда жатуға жаратты
Dialogue: 0,0:01:11.88,0:01:15.58,Default,,0,0,0,,Басқаша айтқанда, баспанасы жоқ адамдарға көмектесу.
Dialogue: 0,0:01:15.60,0:01:18.75,Default,,0,0,0,,Бұл жанның құтқарылуына әкелді.
Dialogue: 0,0:01:18.76,0:01:22.23,Default,,0,0,0,,Баспананың жоқтығынан жаман ештеңе жоқ.
Dialogue: 0,0:01:22.24,0:01:26.51,Default,,0,0,0,,Бірақ бұл дүниеде өз орны жоқ адамдар көп.
Dialogue: 0,0:01:26.52,0:01:27.95,Default,,0,0,0,,Егер сіз оны жақсы білсеңіз
Dialogue: 0,0:01:27.96,0:01:31.39,Default,,0,0,0,,«Менімен бірге болғаныңды қалаймын» үлкен жалғыздықтың ортасында
Dialogue: 0,0:01:31.40,0:01:32.99,Default,,0,0,0,,Мен мұны біреу айтқанын қалаймын.
Dialogue: 0,0:01:33.00,0:01:34.35,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:01:34.36,0:01:35.58,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:01:35.88,0:01:41.27,Default,,0,0,0,,Иса оқшауланғандар үшін орын жасау үшін дүниеге келген.
Dialogue: 0,0:01:44.16,0:01:46.72,Default,,0,0,0,,«Мороби және басқалары тамаққа кезекте тұр».
Dialogue: 0,0:01:46.72,0:01:49.28,Default,,0,0,0,,«Моробилермен бірге келіп, бізге сәлем беріңдер және бізге табыныңдар».
Dialogue: 0,0:01:49.80,0:01:51.79,Default,,0,0,0,,Сенде білім жоқ, Джин Чан.
Dialogue: 0,0:01:51.80,0:01:54.51,Default,,0,0,0,,Сізде доптары жоқ наданға қарағанда парасаттылық бар.
Dialogue: 0,0:01:54.52,0:01:57.99,Default,,0,0,0,,Қанаттарым Алланың қатесі ғана
Dialogue: 0,0:01:58.00,0:02:00.67,Default,,0,0,0,,Бірақ менің жүрегім басқаларға қарағанда әйелдік
Dialogue: 0,0:02:00.68,0:02:02.67,Default,,0,0,0,,Әйелдер бала туады.
Dialogue: 0,0:02:03.16,0:02:06.75,Default,,0,0,0,,Әй, Мария қыз жүкті.
Dialogue: 0,0:02:06.76,0:02:09.51,Default,,0,0,0,,Ғажайыптар тіпті фагтардың басынан өтуі мүмкін.
Dialogue: 0,0:02:10.00,0:02:16.07,Default,,0,0,0,,О, маған үлкен порция беріңіз. Маған екі адамға жеткілікті тамақтану керек.
Dialogue: 0,0:02:40.72,0:02:41.86,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:45.12,0:02:45.99,Default,,0,0,0,,Миюки-чан
Dialogue: 0,0:02:47.72,0:02:49.51,Default,,0,0,0,,Жүр, тамақ ішейік.
Dialogue: 0,0:02:53.28,0:02:54.60,Default,,0,0,0,,Сәлем Миюки-чан
Dialogue: 0,0:02:54.96,0:02:58.27,Default,,0,0,0,,Аяғыңды жаб, әйел екенсің ғой.
Dialogue: 0,0:02:58.28,0:02:59.63,Default,,0,0,0,,Жауап бермеу.
Dialogue: 0,0:02:59.64,0:03:02.59,Default,,0,0,0,,Төгіп жіберейін деп тұрғанда бұл ысырап.
Dialogue: 0,0:03:04.04,0:03:06.47,Default,,0,0,0,,Сіз жай ғана нан жемейсіз бе?
Dialogue: 0,0:03:06.48,0:03:11.39,Default,,0,0,0,,Нан жасайтын, тасыған, Көптің сүйіспеншілігін алған.
Dialogue: 0,0:03:11.40,0:03:15.23,Default,,0,0,0,,Дінге келгенде ұнамайды, Акико сияқты.
Dialogue: 0,0:03:15.76,0:03:17.15,Default,,0,0,0,,Акико деген кім?
Dialogue: 0,0:03:18.80,0:03:20.02,Default,,0,0,0,,Мені дүниеге әкелген адам
Dialogue: 0,0:03:20.04,0:03:20.79,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:21.16,0:03:23.15,Default,,0,0,0,,Биологиялық анамды тастап кету
Dialogue: 0,0:03:23.16,0:03:25.03,Default,,0,0,0,,Қарғыс атсын, қария.
Dialogue: 0,0:03:25.64,0:03:27.87,Default,,0,0,0,,Қарсы емеспін, бірақ мен сені кешірмеймін қария.
Dialogue: 0,0:03:27.88,0:03:29.63,Default,,0,0,0,,Бар, қарғыс атқыр...
Dialogue: 0,0:03:30.56,0:03:31.78,Default,,0,0,0,,Баба...ба
Dialogue: 0,0:03:32.32,0:03:37.44,Default,,0,0,0,,Бұл құстың тітіркендіргіш баласы, тамақты да алмайды.
Dialogue: 0,0:03:37.44,0:03:40.55,Default,,0,0,0,,Бұл қоғамда арқа сүйеп отырған қария айта алатын жол ма?
Dialogue: 0,0:03:40.56,0:03:44.91,Default,,0,0,0,,Бізді арқалап көтеріп жүрген сендер қоқыстан кемсіңдер.
Dialogue: 0,0:03:46.04,0:03:48.68,Default,,0,0,0,,Бұл адамның көзіне, мұрнына күлу деп аталады.
Dialogue: 0,0:03:50.32,0:03:52.55,Default,,0,0,0,,Сен сондай мылқау баласың!
Dialogue: 0,0:03:52.56,0:03:56.03,Default,,0,0,0,,Рождествода жай ғана дос болайық.
Dialogue: 0,0:03:56.92,0:03:59.95,Default,,0,0,0,,Иә, менің Миюки-чанға сыйлығым бар.
Dialogue: 0,0:04:03.20,0:04:04.79,Default,,0,0,0,,№.
Dialogue: 0,0:04:04.80,0:04:08.19,Default,,0,0,0,,«Әлемдік балалар әдебиетінің толық шығармалары» Барлық 20 жол
Dialogue: 0,0:04:08.20,0:04:10.31,Default,,0,0,0,,Сізге осындай нәрсе керек пе?
Dialogue: 0,0:04:10.80,0:04:12.71,Default,,0,0,0,,Хана оны іздеу үшін көп күш жұмсады.
Dialogue: 0,0:04:12.72,0:04:16.47,Default,,0,0,0,,Жаңа жылдық сыйлықсыз қашып кеткен қызды аяймын.
Dialogue: 0,0:04:17.96,0:04:20.42,Default,,0,0,0,,Мен сені сүйгендіктен үйден қаштым.
Dialogue: 0,0:04:20.44,0:04:23.67,Default,,0,0,0,,Көшеде жарты жыл тұрсаңыз, үйсіз деп есептелесіз.
Dialogue: 0,0:04:24.08,0:04:27.07,Default,,0,0,0,,Менің үйім бар, егер қаласам қайтемін.
Dialogue: 0,0:04:27.08,0:04:30.55,Default,,0,0,0,,Бұлай айтуға ешкім қызықпайды деп ойлаймын.
Dialogue: 0,0:04:30.56,0:04:32.31,Default,,0,0,0,,Бұл қарт адам, солай ма?
Dialogue: 0,0:04:33.28,0:04:36.27,Default,,0,0,0,,Ал, Достоевскийді не істейсің?
Dialogue: 0,0:04:37.04,0:04:40.31,Default,,0,0,0,,Мен сені бүгін кешірмеймін.
Dialogue: 0,0:04:41.72,0:04:44.59,Default,,0,0,0,,Ата-анам мені ұрса да
Dialogue: 0,0:04:46.16,0:04:49.03,Default,,0,0,0,,Сондықтан мен оның орнына сені ұрдым.
Dialogue: 0,0:04:52.60,0:04:54.91,Default,,0,0,0,,Байсалды болма, сен ересексің.
Dialogue: 0,0:04:56.48,0:04:57.59,Default,,0,0,0,,Жарақат алмаңыз
Dialogue: 0,0:04:58.44,0:05:00.23,Default,,0,0,0,,Балалардың үлкендерді жалауына жол бермеңіз.
Dialogue: 0,0:05:00.24,0:05:01.91,Default,,0,0,0,,Ол бала емес.
Dialogue: 0,0:05:01.92,0:05:04.48,Default,,0,0,0,,Осындай жұқа кеуделермен не айтып тұрсың?
Dialogue: 0,0:05:04.48,0:05:06.91,Default,,0,0,0,,Бұл азғын, жыныстық қудалаушы қария
Dialogue: 0,0:05:06.92,0:05:08.59,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:05:12.00,0:05:12.83,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:05:32.52,0:05:33.95,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:05:33.96,0:05:35.39,Default,,0,0,0,,Негізгі бөлім
Dialogue: 0,0:05:35.96,0:05:37.83,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:05:45.72,0:05:46.99,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:05:47.96,0:05:49.03,Default,,0,0,0,,Бұл дүниенің ақыры
Dialogue: 0,0:05:49.04,0:05:53.59,Default,,0,0,0,,Ой, қызық мына қыздың аты кім?
Dialogue: 0,0:05:53.60,0:05:55.39,Default,,0,0,0,,Анонимді Гонбей.
Dialogue: 0,0:05:55.40,0:05:57.51,Default,,0,0,0,,Қыз, дөрекі болшы.
Dialogue: 0,0:05:58.40,0:06:03.67,Default,,0,0,0,,Мен 30 жасымда осылай өмір сүре бастадым.
Dialogue: 0,0:06:05.92,0:06:09.67,Default,,0,0,0,,Туғаннан бері үйде отырған нәрестемен салыстырғанда.
Dialogue: 0,0:06:10.68,0:06:12.63,Default,,0,0,0,,Мен бұл әлі жақсырақ деп ойладым.
Dialogue: 0,0:06:20.12,0:06:24.63,Default,,0,0,0,,Жарайды, жарайды, мен сені әлі жылы болғанша шығарып саламын.
Dialogue: 0,0:06:27.04,0:06:29.55,Default,,0,0,0,,Полицейлер мына жерде, эй.
Dialogue: 0,0:06:31.40,0:06:34.07,Default,,0,0,0,,Бұл бала Құдайдың Рождестволық сыйы.
Dialogue: 0,0:06:34.08,0:06:36.67,Default,,0,0,0,,Біздің балалар
Dialogue: 0,0:07:28.56,0:07:29.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:30.36,0:07:33.23,Default,,0,0,0,,Тоқта, мен сені үйге апарсам не істеуім керек?
Dialogue: 0,0:07:33.24,0:07:35.75,Default,,0,0,0,,Бұл Құдайдың қалауы
Dialogue: 0,0:07:36.32,0:07:38.23,Default,,0,0,0,,Ата-аналар қайтып келуі мүмкін
Dialogue: 0,0:07:38.52,0:07:41.99,Default,,0,0,0,,Мына суық аспанда кішкентай балаларын тастап кеткен ата-аналар қайда?
Dialogue: 0,0:07:42.00,0:07:44.38,Default,,0,0,0,,Бұл ата-ана емес, бұл жын.
Dialogue: 0,0:07:47.76,0:07:51.15,Default,,0,0,0,,Киёко оны табуымызды қалады.
Dialogue: 0,0:07:51.16,0:07:52.63,Default,,0,0,0,,Киёко?
Dialogue: 0,0:07:52.64,0:07:55.15,Default,,0,0,0,,Киёко? Неліктен Киёко?
Dialogue: 0,0:07:55.60,0:07:59.51,Default,,0,0,0,,«Киёшико но Йорудан» Киоко есімді.
Dialogue: 0,0:08:00.12,0:08:01.15,Default,,0,0,0,,...
Dialogue: 0,0:08:01.16,0:08:02.99,Default,,0,0,0,,Киёко деген жақсы есім, солай емес пе?
Dialogue: 0,0:08:03.48,0:08:05.99,Default,,0,0,0,,Неге қысып тұрсың, кемпір?
Dialogue: 0,0:08:06.00,0:08:06.99,Default,,0,0,0,,Бакаяру
Dialogue: 0,0:08:07.52,0:08:12.67,Default,,0,0,0,,Мәселе бұл емес. Сіз оны қалай атайсыз? Бұл ит немесе мысық емес.
Dialogue: 0,0:08:12.68,0:08:14.27,Default,,0,0,0,,Сондықтан мен сені үйге апарып жатырмын
Dialogue: 0,0:08:14.28,0:08:15.79,Default,,0,0,0,,Картон үйінде?
Dialogue: 0,0:08:15.80,0:08:17.55,Default,,0,0,0,,Ол тарылып барады.
Dialogue: 0,0:08:17.76,0:08:22.55,Default,,0,0,0,,Бұл өмірде бір рет болатын кездесу. Маған біраз уақыт ана сияқты сезінуге мүмкіндік беріңізші.
Dialogue: 0,0:08:25.92,0:08:27.55,Default,,0,0,0,,Өлең жаза алдым.
Dialogue: 0,0:08:50.48,0:08:52.11,Default,,0,0,0,,Сүйікті бар ~
Dialogue: 0,0:08:54.08,0:08:56.46,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:08:56.48,0:08:57.83,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:09:02.40,0:09:02.99,Default,,0,0,0,,Эй...
Dialogue: 0,0:09:03.00,0:09:07.75,Default,,0,0,0,,Жарайды, жарайды, бұл ана емес, ол жай ғана гей қаңғыбас.
Dialogue: 0,0:09:07.76,0:09:10.75,Default,,0,0,0,,Киёконың алдында оғаш сөздерді қолданбаңыз.
Dialogue: 0,0:09:10.76,0:09:14.51,Default,,0,0,0,,Әдетте мұндай жерде баланың жылағанын есту біртүрлі болады.
Dialogue: 0,0:09:14.84,0:09:18.15,Default,,0,0,0,,Мен бірден полицейге барамын.
Dialogue: 0,0:09:18.16,0:09:20.62,Default,,0,0,0,,Киёко ешқайда кетпеуі керек.
Dialogue: 0,0:09:20.64,0:09:23.51,Default,,0,0,0,,Ақымақ, полицияға бар.
Dialogue: 0,0:09:23.52,0:09:25.75,Default,,0,0,0,,Айқайлама, қария жылауын тоқтатпайды.
Dialogue: 0,0:09:25.76,0:09:29.39,Default,,0,0,0,,Мен неге жылауымды тоқтата алмаймын? Әлде қарным ашқандықтан ба?
Dialogue: 0,0:09:29.40,0:09:30.51,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:09:30.52,0:09:32.51,Default,,0,0,0,,Ол ауырып қалуы мүмкін.
Dialogue: 0,0:09:46.68,0:09:50.03,Default,,0,0,0,,Мен оны ертең сізге жеткізетініне сенімдімін.
Dialogue: 0,0:09:51.52,0:09:55.75,Default,,0,0,0,,Өйткені қазір жеткізсем, әр жолы оңайырақ болар еді.
Dialogue: 0,0:09:56.20,0:09:59.55,Default,,0,0,0,,Бұл баланың өміріндегі ең ауыр күн болғалы тұр.
Dialogue: 0,0:10:01.32,0:10:02.31,Default,,0,0,0,,Омучу…
Dialogue: 0,0:10:03.16,0:10:04.67,Default,,0,0,0,,Бұл жаялық болуы мүмкін.
Dialogue: 0,0:10:15.04,0:10:16.67,Default,,0,0,0,,Суды қайнатпаңыз
Dialogue: 0,0:10:17.08,0:10:18.30,Default,,0,0,0,,Сүтті дайында.
Dialogue: 0,0:10:18.72,0:10:21.03,Default,,0,0,0,,Әй, қария, сен неге аударылып жатырсың?
Dialogue: 0,0:10:21.04,0:10:25.59,Default,,0,0,0,,Миюки-чан, су сатып ал. Мен періштемді краннан су ішуге мәжбүрлей алмаймын.
Dialogue: 0,0:10:25.96,0:10:27.59,Default,,0,0,0,,Неге мен? !
Dialogue: 0,0:10:29.08,0:10:33.59,Default,,0,0,0,,Жұмыс істемейтіндер үйсіз болса да тамақ ішпейді.
Dialogue: 0,0:10:35.48,0:10:40.11,Default,,0,0,0,,Бүгін бір күн, ертең міндетті түрде полицияға хабарлаймын.
Dialogue: 0,0:10:42.72,0:10:46.47,Default,,0,0,0,,Джин Чан өмірінің соңына дейін жалғыз болған жоқ.
Dialogue: 0,0:10:50.96,0:10:52.99,Default,,0,0,0,,Су сатып алғыңыз келе ме?
Dialogue: 0,0:10:53.96,0:10:55.87,Default,,0,0,0,,Бұл Рождество кереметі.
Dialogue: 0,0:10:56.44,0:10:58.47,Default,,0,0,0,,Ухо үлкен аулау үлкен аулау
Dialogue: 0,0:11:04.96,0:11:07.39,Default,,0,0,0,,Бұл бала не істеді?
Dialogue: 0,0:11:07.40,0:11:08.99,Default,,0,0,0,,Алға қараңыз және сол жолмен жүріңіз.
Dialogue: 0,0:11:12.84,0:11:15.48,Default,,0,0,0,,Мен бір кездері үйлендім.
Dialogue: 0,0:11:15.76,0:11:17.39,Default,,0,0,0,,Сіздің балаңыз болды ма?
Dialogue: 0,0:11:17.40,0:11:20.99,Default,,0,0,0,,Тоқта, тоқта, тыңдама, өмірім туралы ештеңе естігім келмейді.
Dialogue: 0,0:11:22.88,0:11:26.35,Default,,0,0,0,,Мен балаларымды ешқашан ұмытқан емеспін
Dialogue: 0,0:11:26.36,0:11:30.51,Default,,0,0,0,,Менің өмірімнен маңыздырақ деп ойлаған ештеңе жоқ.
Dialogue: 0,0:11:32.28,0:11:33.35,Default,,0,0,0,,Бұл сіздің ұлыңыз болды.
Dialogue: 0,0:11:34.04,0:11:34.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:39.80,0:11:41.27,Default,,0,0,0,,Барлық өтірік
Dialogue: 0,0:11:41.28,0:11:43.27,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:11:43.64,0:11:47.91,Default,,0,0,0,,Сен Джин-санның қасындағы қызсың ба?
Dialogue: 0,0:11:47.92,0:11:49.87,Default,,0,0,0,,Олай болса, тез кетіңіз.
Dialogue: 0,0:11:49.88,0:11:52.44,Default,,0,0,0,,Егер мен сенімен аралассам, оның салдарынан қорқамын.
Dialogue: 0,0:11:53.76,0:11:54.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:54.56,0:11:57.67,Default,,0,0,0,,Сен Джин-санның қорапты қызысың ғой, солай ма?
Dialogue: 0,0:12:01.20,0:12:03.39,Default,,0,0,0,,Бұл жай ғана картон қорап.
Dialogue: 0,0:12:03.92,0:12:05.87,Default,,0,0,0,,Мен бұл кітапты аламын.
Dialogue: 0,0:12:08.68,0:12:10.79,Default,,0,0,0,,Неше қызы бар?
Dialogue: 0,0:12:10.80,0:12:12.55,Default,,0,0,0,,21 осы жылы?
Dialogue: 0,0:12:13.52,0:12:17.71,Default,,0,0,0,,Ойланып қарасаңыз, Миюкиден 5 немесе 6 жылға үлкен.
Dialogue: 0,0:12:17.72,0:12:19.83,Default,,0,0,0,,Өте үлкен...
Dialogue: 0,0:12:19.84,0:12:21.67,Default,,0,0,0,,Тірі болса ғой.
Dialogue: 0,0:12:23.72,0:12:28.07,Default,,0,0,0,,Қазір бітті деп атайтын неке менің 20 жасымда болды.
Dialogue: 0,0:12:28.92,0:12:30.95,Default,,0,0,0,,Бұл мені қуантты.
Dialogue: 0,0:12:31.32,0:12:35.20,Default,,0,0,0,,Көзге салсам да ауырмағаны өтірік деп ойладым.
Dialogue: 0,0:12:35.20,0:12:41.23,Default,,0,0,0,,Алайда менің қызым жазылмайтын дертке шалдыққан, емделуге кететін шығын кейде өте жоғары.
Dialogue: 0,0:12:41.24,0:12:45.79,Default,,0,0,0,,Ол кезде мен өте жақсы велосипедші едім.
Dialogue: 0,0:12:46.72,0:12:49.99,Default,,0,0,0,,Сондықтан мен емделуге ақша табуға тырыстым.
Dialogue: 0,0:12:50.56,0:12:51.47,Default,,0,0,0,,Сәйкестік?
Dialogue: 0,0:12:54.12,0:12:58.11,Default,,0,0,0,,Мен білетін қаскөй маған жақындады, бірақ
Dialogue: 0,0:12:58.12,0:13:04.11,Default,,0,0,0,,Сәйкестік анықталды, оның ойынға қатысу құқығынан айырылды, ал оның қызы тым ерте қайтыс болды.
Dialogue: 0,0:13:04.48,0:13:07.75,Default,,0,0,0,,Осыдан кейін менің жұмыс істеуге құлшынысым жоқ.
Dialogue: 0,0:13:07.76,0:13:10.99,Default,,0,0,0,,Оның үстіне әйелім қызымның соңынан еріп келе жатқан сияқты...
Dialogue: 0,0:13:11.00,0:13:12.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:13.52,0:13:15.98,Default,,0,0,0,,Адам осылай жаратылған.
Dialogue: 0,0:13:16.24,0:13:19.39,Default,,0,0,0,,Сол қайғылы тарихты естігім келмеді.
Dialogue: 0,0:13:20.96,0:13:23.07,Default,,0,0,0,,О, өте суық болды.
Dialogue: 0,0:13:26.72,0:13:28.15,Default,,0,0,0,,Әй, мен үйреніп қалдым.
Dialogue: 0,0:13:28.16,0:13:29.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:29.52,0:13:31.87,Default,,0,0,0,,Мен саған сүт беремін.
Dialogue: 0,0:13:33.04,0:13:35.23,Default,,0,0,0,,Армандар орындалады, солай ма?
Dialogue: 0,0:13:35.24,0:13:40.15,Default,,0,0,0,,Сүйкімді қыздың анасы болғым келді. Бұл менің арманым еді.
Dialogue: 0,0:13:40.16,0:13:42.47,Default,,0,0,0,,Жылы жанұя және сүйкімді қыз
Dialogue: 0,0:13:42.48,0:13:45.39,Default,,0,0,0,,Күйеуің қандай ақымақ?
Dialogue: 0,0:13:45.40,0:13:48.55,Default,,0,0,0,,Балаларың болса, кедей болсаң да аман қалуың мүмкін.
Dialogue: 0,0:13:48.56,0:13:50.39,Default,,0,0,0,,Тез істе, бейшара.
Dialogue: 0,0:13:55.64,0:13:57.15,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:13:58.32,0:14:01.75,Default,,0,0,0,,Дүниедегі ең сүйкімді қыз шығар
Dialogue: 0,0:14:27.32,0:14:29.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:29.08,0:14:30.07,Default,,0,0,0,,Ол жоғалып кетті
Dialogue: 0,0:14:33.68,0:14:36.03,Default,,0,0,0,,Аяз ата?
Dialogue: 0,0:14:36.04,0:14:39.31,Default,,0,0,0,,Қария мен сәби кетті.
Dialogue: 0,0:14:39.32,0:14:41.83,Default,,0,0,0,,Мынау не ойлап отыр?
Dialogue: 0,0:14:44.84,0:14:47.55,Default,,0,0,0,,Бірақ сенің аяғың үлкен.
Dialogue: 0,0:14:47.56,0:14:49.67,Default,,0,0,0,,Аяқтардың пішінін өзгерту мүмкін емес.
Dialogue: 0,0:15:06.96,0:15:08.47,Default,,0,0,0,,Оны қайтаруға келдің бе?
Dialogue: 0,0:15:10.24,0:15:12.88,Default,,0,0,0,,Іздеу сұрауы қазірге дейін шығарылған болуы мүмкін.
Dialogue: 0,0:15:12.88,0:15:14.75,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:15:14.76,0:15:15.47,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:16.52,0:15:19.83,Default,,0,0,0,,Егер сізге қажет болса, сіз іздеушілер тізімінде болуыңыз мүмкін.
Dialogue: 0,0:15:21.20,0:15:24.51,Default,,0,0,0,,Сәбидің ата-анасы да бір түннен кейін өкінеді.
Dialogue: 0,0:15:24.52,0:15:27.23,Default,,0,0,0,,Ендеше оны полицияға апарайық.
Dialogue: 0,0:15:27.64,0:15:32.11,Default,,0,0,0,,Мен сәбилердің нағыз ата-анасымен жақсы болатынына сенімдімін.
Dialogue: 0,0:15:32.12,0:15:33.83,Default,,0,0,0,,Бұл сіздің ата-анаңыз ба?
Dialogue: 0,0:15:35.72,0:15:38.36,Default,,0,0,0,,Ата-ана туған ата-анадан маңыздырақ.
Dialogue: 0,0:15:38.36,0:15:39.03,Default,,0,0,0,,Эй, жоқ.
Dialogue: 0,0:15:39.04,0:15:40.87,Default,,0,0,0,,Мені біртүрлі сезінбе. Эй, жоқ.
Dialogue: 0,0:15:41.64,0:15:44.87,Default,,0,0,0,,Мен туған әке-шешемнің жүзін білмеймін.
Dialogue: 0,0:15:46.88,0:15:51.23,Default,,0,0,0,,Мені қазір туған әке-шешем көрсе, ренжіп қалар еді.
Dialogue: 0,0:15:52.80,0:15:55.79,Default,,0,0,0,,Үйсіз адам ретінде сізде бала тәрбиелеуге біліктілік жоқ.
Dialogue: 0,0:15:55.80,0:15:58.36,Default,,0,0,0,,Мен білемін, білемін
Dialogue: 0,0:15:59.44,0:16:03.43,Default,,0,0,0,,Білесің бе, мені анау-мынау айналып өтті.
Dialogue: 0,0:16:03.44,0:16:05.79,Default,,0,0,0,,Бірде-бір махаббат алғаным есімде жоқ.
Dialogue: 0,0:16:05.80,0:16:07.99,Default,,0,0,0,,Мен сенің бұлай өмір сүргеніңді қаламаймын.
Dialogue: 0,0:16:08.32,0:16:11.39,Default,,0,0,0,,Осындай тастанды емес балалар көп.
Dialogue: 0,0:16:12.20,0:16:14.43,Default,,0,0,0,,Кейбір ауыр жағдайлар болуы керек.
Dialogue: 0,0:16:14.44,0:16:17.08,Default,,0,0,0,,Бұл дүниеде баланы тастап кетуге ешқандай жағдай болмауы керек.
Dialogue: 0,0:16:18.96,0:16:23.95,Default,,0,0,0,,Ол кезде махаббатыңды да тастайсың, қоқыстай тастайсың.
Dialogue: 0,0:16:25.44,0:16:28.39,Default,,0,0,0,,Сонымен не істей аламыз?
Dialogue: 0,0:16:29.08,0:16:30.19,Default,,0,0,0,,Мен ата-анамды іздеймін
Dialogue: 0,0:16:32.72,0:16:35.95,Default,,0,0,0,,Балаңызды неге тастап кеткеніңізді білгім келеді.
Dialogue: 0,0:16:37.08,0:16:39.59,Default,,0,0,0,,Егер мен оны шынымен түсіне алсам, мен сені кешіремін.
Dialogue: 0,0:16:40.48,0:16:43.07,Default,,0,0,0,,Бұл баланың ата-анасы да, менікі де
Dialogue: 0,0:16:43.96,0:16:46.07,Default,,0,0,0,,Оны іздеп жүрсіз бе?
Dialogue: 0,0:16:46.08,0:16:47.59,Default,,0,0,0,,Мен қайда қарауым керек?
Dialogue: 0,0:16:51.96,0:16:53.91,Default,,0,0,0,,Артық төлем бар.
Dialogue: 0,0:16:54.48,0:16:57.59,Default,,0,0,0,,Жыл соңындағы бос емес желі
Dialogue: 0,0:16:57.92,0:17:00.23,Default,,0,0,0,,Ішінен тағы бір сәби шықты.
Dialogue: 0,0:17:00.24,0:17:02.43,Default,,0,0,0,,Осылай лақтыру қызықсыз ба?
Dialogue: 0,0:17:13.84,0:17:15.59,Default,,0,0,0,,Бұл қайтадан кілт.
Dialogue: 0,0:17:15.96,0:17:20.15,Default,,0,0,0,,Ой, мына шалбар желді ұстайды.
Dialogue: 0,0:17:20.60,0:17:22.71,Default,,0,0,0,,Бұл адамдардың өздері ме?
Dialogue: 0,0:17:26.68,0:17:28.43,Default,,0,0,0,,Ата-анаң
Dialogue: 0,0:17:29.24,0:17:31.03,Default,,0,0,0,,Эй, бұл болды.
Dialogue: 0,0:17:38.48,0:17:41.55,Default,,0,0,0,,Таңертеңгілік тағамдар туралы ешқашан естіген емеспін.
Dialogue: 0,0:17:42.44,0:17:45.00,Default,,0,0,0,,Ой, экскурсияға шығып, көңіл көтерейік
Dialogue: 0,0:17:45.00,0:17:46.87,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:17:50.36,0:17:51.87,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:18:05.72,0:18:11.07,Default,,0,0,0,,Алайда, жолға дайындалып, сәбиді қалай жіберетінін түсінбеймін.
Dialogue: 0,0:18:11.88,0:18:15.27,Default,,0,0,0,,Мүмкін ол Киоконы тастап, жалғыз кеткен шығар.
Dialogue: 0,0:18:15.28,0:18:16.47,Default,,0,0,0,,Отбасылық суицид?
Dialogue: 0,0:18:18.12,0:18:19.39,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:18:19.88,0:18:22.23,Default,,0,0,0,,Мен оны табу үшін о дүниеге бара алмаймын.
Dialogue: 0,0:18:22.24,0:18:23.38,Default,,0,0,0,,Қатты дауыс
Dialogue: 0,0:18:29.88,0:18:33.03,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:18:33.04,0:18:36.74,Default,,0,0,0,,Қалың қарға байланысты қазіргі уақытта қызмет көрсету тоқтатылды.
Dialogue: 0,0:18:38.40,0:18:40.11,Default,,0,0,0,,Ыстық, солай емес пе?
Dialogue: 0,0:18:40.12,0:18:41.79,Default,,0,0,0,,Сасық.
Dialogue: 0,0:18:42.40,0:18:45.04,Default,,0,0,0,,Сен Джин Чанмен шомылып жатырсың ба?
Dialogue: 0,0:18:46.04,0:18:48.03,Default,,0,0,0,,Айтпақшы, мен соңғы кездері кір жуған жоқпын.
Dialogue: 0,0:18:48.04,0:18:49.79,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:18:59.76,0:19:01.91,Default,,0,0,0,,О, жарайды, жарайды.
Dialogue: 0,0:19:01.92,0:19:05.39,Default,,0,0,0,,Бұл несеп пе? Көшеде сасық.
Dialogue: 0,0:19:05.40,0:19:07.07,Default,,0,0,0,,Сасық адам сен болуың керек.
Dialogue: 0,0:19:07.40,0:19:08.54,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:19:08.56,0:19:10.03,Default,,0,0,0,,Тыныш, балақай.
Dialogue: 0,0:19:25.08,0:19:25.95,Default,,0,0,0,,Біраз
Dialogue: 0,0:19:27.16,0:19:27.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:37.36,0:19:38.71,Default,,0,0,0,,Миюки-чан
Dialogue: 0,0:19:38.72,0:19:40.35,Default,,0,0,0,,Мынау не ақымақ?
Dialogue: 0,0:19:46.96,0:19:49.34,Default,,0,0,0,,Қыруар ақшаны талап ететін пойыздың жүру ақысы пар.
Dialogue: 0,0:19:50.00,0:19:51.99,Default,,0,0,0,,Бұл мен берген ақша емес.
Dialogue: 0,0:19:53.68,0:19:57.35,Default,,0,0,0,,Кешіріңіз, сүтім бітті.
Dialogue: 0,0:19:57.60,0:19:59.63,Default,,0,0,0,,Бұл бәрібір менің кінәм.
Dialogue: 0,0:20:00.20,0:20:03.07,Default,,0,0,0,,Көңілімізді көтеріп, барайық. Неге біз ән айтпаймыз?
Dialogue: 0,0:20:08.24,0:20:09.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:09.40,0:20:11.19,Default,,0,0,0,,Бұл «Музыка дыбысы» емес пе?
Dialogue: 0,0:20:11.20,0:20:12.23,Default,,0,0,0,,Сондықтан енді сыртқа шықпаймын.
Dialogue: 0,0:20:20.48,0:20:23.47,Default,,0,0,0,,Сіз әлдеқайда аш боласыз, солай емес пе?
Dialogue: 0,0:20:32.92,0:20:34.35,Default,,0,0,0,,Соңғы жебеге айналғанша...
Dialogue: 0,0:20:35.28,0:20:37.23,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:20:37.76,0:20:39.91,Default,,0,0,0,,Мен сіздің періштеңізді сұрадым
Dialogue: 0,0:20:41.64,0:20:43.15,Default,,0,0,0,,Алға, уайымдама.
Dialogue: 0,0:20:43.48,0:20:47.39,Default,,0,0,0,,Бірақ, мынандай фаза болғанын ұмытпа.
Dialogue: 0,0:20:48.24,0:20:50.75,Default,,0,0,0,,Қараңызшы, бұл зират.
Dialogue: 0,0:20:50.76,0:20:52.43,Default,,0,0,0,,Мен әлі өлген жоқпын.
Dialogue: 0,0:21:06.32,0:21:08.07,Default,,0,0,0,,А, мен өмірге қайта оралдым.
Dialogue: 0,0:21:09.44,0:21:14.56,Default,,0,0,0,,Өлген адамның төсегіндегі баланың аузына бұлай бірдеңе салу мүмкін емес.
Dialogue: 0,0:21:14.56,0:21:16.19,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,0:21:17.04,0:21:19.83,Default,,0,0,0,,Бірдеңе болады.
Dialogue: 0,0:21:19.84,0:21:22.95,Default,,0,0,0,,Осылай деп жүріп, мен осылай өмір сүрдім.
Dialogue: 0,0:21:23.32,0:21:28.95,Default,,0,0,0,,Ал, мәселе шешілгенше сәби құлпытастың астында қалады.
Dialogue: 0,0:21:28.96,0:21:30.83,Default,,0,0,0,,Киоко, сенің атың бар ма?
Dialogue: 0,0:21:30.84,0:21:35.83,Default,,0,0,0,,Ештеңе етпейді балалар сүйкімді, о не сүйкімді
Dialogue: 0,0:21:36.36,0:21:38.82,Default,,0,0,0,,Бірақ мұқият тыңдаңыз, бұл маңызды.
Dialogue: 0,0:21:39.44,0:21:40.35,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:21:41.84,0:21:45.47,Default,,0,0,0,,Егер сіз өз балаларыңызға шын көңіл бөлсеңіз
Dialogue: 0,0:21:45.48,0:21:48.71,Default,,0,0,0,,Қорғаныс болғаны дұрыс.
Dialogue: 0,0:21:48.72,0:21:51.23,Default,,0,0,0,,Мұны балалы болған адам айтады.
Dialogue: 0,0:21:51.24,0:21:53.67,Default,,0,0,0,,Кийоконы тастап кеткен ата-анаңмен бірге емессің бе?
Dialogue: 0,0:21:53.68,0:21:57.31,Default,,0,0,0,,Не десең де, баламды тастап кетуге жол жоқ.
Dialogue: 0,0:21:57.60,0:22:00.06,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:22:00.08,0:22:02.59,Default,,0,0,0,,Сізді отбасыңыз тастап кететін адамсыз.
Dialogue: 0,0:22:03.60,0:22:07.19,Default,,0,0,0,,Әй, айттым ғой... аузыңды жап, тыңда.
Dialogue: 0,0:22:07.20,0:22:10.23,Default,,0,0,0,,Ей, бұл туралы көп айтатын ақымақ.
Dialogue: 0,0:22:10.24,0:22:14.51,Default,,0,0,0,,Біз не істеп жатырмыз? сурет? қазір не істеп жатырсың
Dialogue: 0,0:22:14.52,0:22:16.51,Default,,0,0,0,,Мен қатты қиналып отырмын.
Dialogue: 0,0:22:16.52,0:22:19.95,Default,,0,0,0,,Әр түрлі зираттарда құрбандықтарды қырып алу
Dialogue: 0,0:22:19.96,0:22:22.71,Default,,0,0,0,,Себебі, мен қандай да бір себептермен үйсізмін.
Dialogue: 0,0:22:22.72,0:22:23.75,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:22:23.76,0:22:25.95,Default,,0,0,0,,Мен ештеңе істемеймін.
Dialogue: 0,0:22:25.96,0:22:29.15,Default,,0,0,0,,Басқаша айтқанда, біз Темеге мүлдем қамқорлық жасай алмаймыз.
Dialogue: 0,0:22:29.16,0:22:31.62,Default,,0,0,0,,Үш бейбақ дос.
Dialogue: 0,0:22:31.64,0:22:33.87,Default,,0,0,0,,Аузыңды жап, ойланып отырмын.
Dialogue: 0,0:22:34.36,0:22:35.75,Default,,0,0,0,,Жоқ, мен үндемеймін.
Dialogue: 0,0:22:36.28,0:22:41.15,Default,,0,0,0,,Қанша ойласам да, иістің төсінен сүт шықпайды.
Dialogue: 0,0:22:41.80,0:22:46.03,Default,,0,0,0,,Эй, Хана-чан, іргетас салу мүмкін емес.
Dialogue: 0,0:22:46.28,0:22:47.50,Default,,0,0,0,,Оны араластырмаңыз
Dialogue: 0,0:22:48.28,0:22:51.03,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, бұл отбасылық суицид болады.
Dialogue: 0,0:23:00.12,0:23:01.91,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:23:03.16,0:23:05.80,Default,,0,0,0,,Киоко қаншалықты бақытты?
Dialogue: 0,0:23:05.80,0:23:07.91,Default,,0,0,0,,Құдайдың мені жақсы көретініне сенімдімін
Dialogue: 0,0:23:09.00,0:23:10.55,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:23:10.56,0:23:11.91,Default,,0,0,0,,Ол тасталды.
Dialogue: 0,0:23:13.04,0:23:14.63,Default,,0,0,0,,Мүлдем сол жақта
Dialogue: 0,0:23:14.64,0:23:17.67,Default,,0,0,0,,Бұл бұрын тығырыққа тірелген жер емес пе еді?
Dialogue: 0,0:23:17.68,0:23:18.67,Default,,0,0,0,,Дұрыс, дұрыс
Dialogue: 0,0:23:21.52,0:23:22.31,Default,,0,0,0,,ол әлі де дем алып тұрғанша, сен жабысып алған «Shock» бақыланады.
Dialogue: 0,0:23:22.32,0:23:23.07,Default,,0,0,0,,Кесте
Dialogue: 0,0:23:32.56,0:23:35.71,Default,,0,0,0,,Дұрыс. Мазалама, мені тоқтат.
Dialogue: 0,0:23:35.72,0:23:38.18,Default,,0,0,0,,Сіз қоғамдық адамгершілік туралы ештеңе білмейсіз бе?
Dialogue: 0,0:23:59.44,0:24:01.19,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,0:24:01.20,0:24:07.07,Default,,0,0,0,,Дұрыс, көлігім кептеліп қалды, бірақ қол тежегішті қолдануды ұмытып кеткенім менің жолым болды.
Dialogue: 0,0:24:07.08,0:24:09.72,Default,,0,0,0,,Мен "Күте тұр, Дороти" дегенді естідім
Dialogue: 0,0:24:09.72,0:24:11.43,Default,,0,0,0,,«а» дегенде солай болады...
Dialogue: 0,0:24:11.84,0:24:15.23,Default,,0,0,0,,Көлік келе жатыр еді
Dialogue: 0,0:24:16.88,0:24:22.83,Default,,0,0,0,,Көбінесе жастарды ертіп барамын, бірақ қатал әкемнің бейітіне жиі бармаймын.
Dialogue: 0,0:24:23.40,0:24:27.23,Default,,0,0,0,,Мен сізге ризамын. Егер сізде қандай да бір қиындықтар болса, маған хабарлаңыз.
Dialogue: 0,0:24:27.24,0:24:29.75,Default,,0,0,0,,Жоқ, менде проблема жоқ.
Dialogue: 0,0:24:29.76,0:24:31.99,Default,,0,0,0,,О, Киншичо халқы.
Dialogue: 0,0:24:32.00,0:24:34.83,Default,,0,0,0,,Мен сонда барайын деп жатыр едім.
Dialogue: 0,0:24:34.84,0:24:37.27,Default,,0,0,0,,Мен сенен бірдеңе сұрауым керек...
Dialogue: 0,0:24:37.28,0:24:39.51,Default,,0,0,0,,Түсінбеген нәрселер туралы сұрау дөрекі.
Dialogue: 0,0:24:39.52,0:24:40.63,Default,,0,0,0,,Кеттік
Dialogue: 0,0:24:42.28,0:24:45.23,Default,,0,0,0,,Сіз бұл дүкенмен таныссыз ба?
Dialogue: 0,0:24:47.92,0:24:49.59,Default,,0,0,0,,Сіз ештеңе білмейсіз...
Dialogue: 0,0:24:50.40,0:24:54.63,Default,,0,0,0,,Сол дүкеннің иесі менің қызым үйленетін адам.
Dialogue: 0,0:24:55.92,0:25:00.79,Default,,0,0,0,,Бұл менің жас жігітім, дене бітімі тамаша.
Dialogue: 0,0:25:00.80,0:25:03.39,Default,,0,0,0,,Мен бұған мүлдем қарсы болдым.
Dialogue: 0,0:25:03.40,0:25:05.63,Default,,0,0,0,,Бірақ қызыңыз таңдаған шығар.
Dialogue: 0,0:25:05.64,0:25:09.15,Default,,0,0,0,,Мен сондай кісіге қадірлеген қызымнан айырылдым.
Dialogue: 0,0:25:11.20,0:25:12.27,Default,,0,0,0,,Сәлем аға
Dialogue: 0,0:25:13.20,0:25:17.55,Default,,0,0,0,,Қызыңыз бақытты болса, бәрінен де маңыздырақ, солай емес пе?
Dialogue: 0,0:25:17.56,0:25:19.67,Default,,0,0,0,,Мұның бәрі баланың бақыты.
Dialogue: 0,0:25:19.68,0:25:20.79,Default,,0,0,0,,Керемет
Dialogue: 0,0:25:20.80,0:25:24.91,Default,,0,0,0,,Жоқ, мен де солай ойлаймын. Бүгінгі тойда көз жасымды көрсетпеймін.
Dialogue: 0,0:25:24.92,0:25:27.91,Default,,0,0,0,,Мен жаңа ғана әкемнің бейітіне ант бердім.
Dialogue: 0,0:25:28.20,0:25:29.91,Default,,0,0,0,,алға қараңыз
Dialogue: 0,0:25:35.40,0:25:36.83,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:25:39.20,0:25:40.71,Default,,0,0,0,,О, еркін жүр
Dialogue: 0,0:25:54.08,0:25:56.07,Default,,0,0,0,,Әкем кешігіп қалды
Dialogue: 0,0:25:56.08,0:26:00.11,Default,,0,0,0,,Жоқ, кешіріңіз, мен жаңа ғана өмірден өттім.
Dialogue: 0,0:26:00.12,0:26:03.19,Default,,0,0,0,,Анау сол кездегі менің қайырымды адамым.
Dialogue: 0,0:26:03.20,0:26:04.71,Default,,0,0,0,,Бұл менің қызым Киёко.
Dialogue: 0,0:26:04.72,0:26:05.79,Default,,0,0,0,,Сәлем
Dialogue: 0,0:26:16.72,0:26:19.71,Default,,0,0,0,,Сіз керемет жерге келдіңіз!
Dialogue: 0,0:26:19.72,0:26:21.75,Default,,0,0,0,,Қалағаныңызша жей беріңіз.
Dialogue: 0,0:26:25.64,0:26:28.10,Default,,0,0,0,,Тамақ ішетін Миюкидің кезегі.
Dialogue: 0,0:26:36.72,0:26:40.87,Default,,0,0,0,,Сен олай ойламайсың ба, Джин Чан? Киёконың біртүрлі жолы бар.
Dialogue: 0,0:26:43.60,0:26:44.59,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:26:45.36,0:26:47.27,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:26:50.72,0:26:53.39,Default,,0,0,0,,А, бұл Сачико екеніне сенімдімін.
Dialogue: 0,0:26:54.00,0:26:55.47,Default,,0,0,0,,Бұл жасыл, солай емес пе?
Dialogue: 0,0:26:55.48,0:26:57.15,Default,,0,0,0,,Дүкенде осылай аталады.
Dialogue: 0,0:26:57.16,0:27:00.03,Default,,0,0,0,,Оның есімі Сачико, ол бақытты емес сияқты.
Dialogue: 0,0:27:00.04,0:27:04.79,Default,,0,0,0,,Кедей болып көрінсең де, анау-мынау қадағаласаң, көп ақша табасың.
Dialogue: 0,0:27:06.80,0:27:09.63,Default,,0,0,0,,Бірақ мен балам бар болғандықтан жұмыстан шықтым.
Dialogue: 0,0:27:09.64,0:27:11.63,Default,,0,0,0,,Сізде менің байланыс ақпаратым бар ма?
Dialogue: 0,0:27:12.56,0:27:15.02,Default,,0,0,0,,Ақшаны сығуға болмайды деп ойлаймын.
Dialogue: 0,0:27:15.76,0:27:18.55,Default,,0,0,0,,Менің жеткізуім керек тағы бір нәрсе бар.
Dialogue: 0,0:27:22.44,0:27:25.79,Default,,0,0,0,,Тамақты ертерек төгіп алғаным үшін кешіріңіз.
Dialogue: 0,0:27:26.28,0:27:29.43,Default,,0,0,0,,Қараңызшы, Мидори кедей әйел.
Dialogue: 0,0:27:31.32,0:27:33.55,Default,,0,0,0,,Күйеуімнің қарызы үйіліп, өзін-өзі асырай алмай қалды.
Dialogue: 0,0:27:33.56,0:27:35.94,Default,,0,0,0,,Бұрын не болды?
Dialogue: 0,0:27:35.96,0:27:37.31,Default,,0,0,0,,Әлгі бейбақ...
Dialogue: 0,0:27:37.32,0:27:39.59,Default,,0,0,0,,Сіз бұл адамды танисыз ба?
Dialogue: 0,0:27:40.16,0:27:41.95,Default,,0,0,0,,Жалақым тағы да қарызға батып кетті.
Dialogue: 0,0:27:42.32,0:27:45.03,Default,,0,0,0,,Аяқтаған соң, ішіңізді үрлеңіз.
Dialogue: 0,0:27:45.60,0:27:47.27,Default,,0,0,0,,Сіз бұл адамның байланыс ақпаратын білесіз бе?
Dialogue: 0,0:27:48.48,0:27:52.07,Default,,0,0,0,,Егер ол бейбақ маған ақшамен жақындамаған болса.
Dialogue: 0,0:27:52.08,0:27:55.03,Default,,0,0,0,,Әйелім мен балаларыммен қоштасудың қажеті жоқ еді.
Dialogue: 0,0:27:55.04,0:27:57.71,Default,,0,0,0,,Әйеліңіз бен балаңыз өлді, солай ма?
Dialogue: 0,0:27:57.72,0:27:59.91,Default,,0,0,0,,Мен ол бейбақты өлтіремін.
Dialogue: 0,0:28:00.96,0:28:02.83,Default,,0,0,0,,Сізді өлтіретін боласыз.
Dialogue: 0,0:28:29.84,0:28:31.51,Default,,0,0,0,,Мицуо Мицуо
Dialogue: 0,0:28:31.52,0:28:33.51,Default,,0,0,0,,Бұл қызметші, анау қызметші.
Dialogue: 0,0:28:35.00,0:28:35.83,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:28:36.88,0:28:38.27,Default,,0,0,0,,Менде мылтық бар.
Dialogue: 0,0:28:39.60,0:28:40.63,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:28:46.04,0:28:47.51,Default,,0,0,0,,Киоко Миюки-чан
Dialogue: 0,0:28:49.00,0:28:49.91,Default,,0,0,0,,Ой
Dialogue: 0,0:29:15.44,0:29:18.03,Default,,0,0,0,,Мен не істеуім керек? Менде мылтық бар.
Dialogue: 0,0:29:18.04,0:29:21.03,Default,,0,0,0,,Тастауға тұрарлық өмір емес пе?
Dialogue: 0,0:29:21.04,0:29:21.55,Default,,0,0,0,,Хана
Dialogue: 0,0:29:27.08,0:29:27.87,Default,,0,0,0,,Осымен.
Dialogue: 0,0:29:53.48,0:29:57.91,Default,,0,0,0,,Демек, сіздің көлігіңіз қолында сәбиі бар жас қызды алып кеткенін айтасыз.
Dialogue: 0,0:29:57.92,0:30:00.59,Default,,0,0,0,,Мемлекеттік нөмірі 12-25. Көлік...
Dialogue: 0,0:30:01.92,0:30:04.67,Default,,0,0,0,,Менің атым Токио мұнарасының астында...
Dialogue: 0,0:30:07.36,0:30:09.67,Default,,0,0,0,,Эй, күте тұр, эй
Dialogue: 0,0:30:14.24,0:30:18.71,Default,,0,0,0,,Біз жай ғана үйсіз адамдармыз, біз экшн фильмінің жұлдыздары емеспіз.
Dialogue: 0,0:30:19.44,0:30:21.59,Default,,0,0,0,,Бұл жолғы полицияның жұмысы шығар.
Dialogue: 0,0:30:22.60,0:30:27.62,Default,,0,0,0,,Полиция Егер сізге полиция ұнаса, солардың бірі болыңыз.
Dialogue: 0,0:30:27.64,0:30:30.59,Default,,0,0,0,,Бұл балалар отбасы сияқты.
Dialogue: 0,0:30:30.60,0:30:32.63,Default,,0,0,0,,Мен оны соншалықты жауапсыз деп ойламадым.
Dialogue: 0,0:30:32.64,0:30:36.34,Default,,0,0,0,,Нё...әйеліме қарау сияқты сөздерді айтпа.
Dialogue: 0,0:30:38.60,0:30:40.35,Default,,0,0,0,,Мен бармаймын
Dialogue: 0,0:30:40.36,0:30:41.19,Default,,0,0,0,,Джин-чан
Dialogue: 0,0:30:41.96,0:30:44.11,Default,,0,0,0,,Сіз жеткілікті орындадыңыз.
Dialogue: 0,0:30:44.12,0:30:45.15,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:30:46.40,0:30:49.27,Default,,0,0,0,,Біздің қолымыздан ештеңе келмейді.
Dialogue: 0,0:30:49.76,0:30:52.59,Default,,0,0,0,,Сен шынымен де адам баласының күл-қоқысысың.
Dialogue: 0,0:30:52.60,0:30:55.75,Default,,0,0,0,,Бұл Секи тауы, онда сіз жабайы табиғатта өліп, туыссыз Буддаға айналасыз.
Dialogue: 0,0:30:55.76,0:30:59.64,Default,,0,0,0,,Әй, енді қаламаймын, қаламаймын, өлсем мені ешкім еске алмайды.
Dialogue: 0,0:30:59.64,0:31:02.79,Default,,0,0,0,,Сіз өмір сүрсеңіз де, адамдарға қиындық тудырудан басқа ештеңе істей алмайсыз.
Dialogue: 0,0:31:02.80,0:31:05.51,Default,,0,0,0,,Сіз бұл жерде болсаңыз да, жоқсыз ба, бәрібір қоқыстың патшасысыз.
Dialogue: 0,0:31:05.52,0:31:07.90,Default,,0,0,0,,Бұл... Ақымақ патшасы!
Dialogue: 0,0:31:12.40,0:31:16.43,Default,,0,0,0,,Шіркін, сұмдық туралы не айтады?
Dialogue: 0,0:31:32.44,0:31:33.31,Default,,0,0,0,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:31:33.80,0:31:35.95,Default,,0,0,0,,Мен қоқысты тастағым келеді.
Dialogue: 0,0:31:41.64,0:31:44.02,Default,,0,0,0,,Менің ойымша, бұл кішкентай.
Dialogue: 0,0:31:44.84,0:31:48.43,Default,,0,0,0,,Қарғыс атқан адамсың.
Dialogue: 0,0:31:51.20,0:31:55.55,Default,,0,0,0,,Нодаре өлді ме? Жақсырақ емес пе?
Dialogue: 0,0:31:56.92,0:32:00.19,Default,,0,0,0,,Біз бірге өлеміз
Dialogue: 0,0:32:22.68,0:32:24.35,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:32:25.44,0:32:27.35,Default,,0,0,0,,Мықты бол, қария.
Dialogue: 0,0:32:30.24,0:32:32.99,Default,,0,0,0,,Ал... соңғы бір өтінішім бар ма?
Dialogue: 0,0:32:33.00,0:32:33.63,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:32:35.36,0:32:37.63,Default,,0,0,0,,Эй... бір жұтым берші.
Dialogue: 0,0:33:28.40,0:33:30.63,Default,,0,0,0,,...
Dialogue: 0,0:33:32.92,0:33:35.07,Default,,0,0,0,,Маған біреу көмектессін...
Dialogue: 0,0:33:49.20,0:33:53.43,Default,,0,0,0,,...
Dialogue: 0,0:33:53.44,0:33:56.19,Default,,0,0,0,,Сізге рахмет, мен жартылай бақыттымын.
Dialogue: 0,0:33:56.84,0:33:58.71,Default,,0,0,0,,Бұл да жасыл түстің бір түрі.
Dialogue: 0,0:33:59.96,0:34:02.91,Default,,0,0,0,,Мен өзімді ұзақ өмір сүргендей сезінемін.
Dialogue: 0,0:34:02.92,0:34:06.59,Default,,0,0,0,,...
Dialogue: 0,0:34:06.60,0:34:09.03,Default,,0,0,0,,Жалғыз ештеңе айтпа
Dialogue: 0,0:34:09.80,0:34:13.99,Default,,0,0,0,,...
Dialogue: 0,0:34:14.52,0:34:16.98,Default,,0,0,0,,Сізді күтумен
Dialogue: 0,0:34:17.00,0:34:20.51,Default,,0,0,0,,Сізден соңғы өтініш сұрасам бола ма?
Dialogue: 0,0:34:21.24,0:34:24.35,Default,,0,0,0,,Бұдан құтылуыңызды өтінемін.
Dialogue: 0,0:34:24.36,0:34:30.15,Default,,0,0,0,,...
Dialogue: 0,0:34:30.16,0:34:33.91,Default,,0,0,0,,Түсіндім... Жоқ, түсінемін, мен сенімен біржола айналысамын.
Dialogue: 0,0:34:47.68,0:34:52.03,Default,,0,0,0,,…
Dialogue: 0,0:34:52.80,0:34:54.02,Default,,0,0,0,,...
Dialogue: 0,0:34:59.64,0:35:02.07,Default,,0,0,0,,Қош бол
Dialogue: 0,0:35:17.72,0:35:18.67,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:35:21.96,0:35:23.59,Default,,0,0,0,,Рахмет, қария
Dialogue: 0,0:35:29.36,0:35:32.35,Default,,0,0,0,,Біз мұнда жыл соңында тазалауға келдік.
Dialogue: 0,0:35:40.72,0:35:42.59,Default,,0,0,0,,...
Dialogue: 0,0:35:55.24,0:35:57.43,Default,,0,0,0,,А...күйеу?
Dialogue: 0,0:36:12.84,0:36:13.83,Default,,0,0,0,,…Әке
Dialogue: 0,0:36:14.72,0:36:15.86,Default,,0,0,0,,Полиция
Dialogue: 0,0:36:15.88,0:36:17.87,Default,,0,0,0,,Әкем полиция ма?
Dialogue: 0,0:36:17.88,0:36:19.39,Default,,0,0,0,,Менің әкем де полиция қызметкері
Dialogue: 0,0:36:19.88,0:36:21.35,Default,,0,0,0,,Әке полиция қызметкері?
Dialogue: 0,0:36:23.84,0:36:29.35,Default,,0,0,0,,Бірақ мені ұстайтын әкем.
Dialogue: 0,0:36:44.16,0:36:45.03,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:36:48.56,0:36:51.02,Default,,0,0,0,,О, біраз болды.
Dialogue: 0,0:36:53.52,0:36:55.31,Default,,0,0,0,,...
Dialogue: 0,0:36:55.32,0:36:57.91,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:36:57.92,0:36:59.11,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:37:02.52,0:37:04.63,Default,,0,0,0,,Олай етпе, ақымақ.
Dialogue: 0,0:37:05.80,0:37:07.55,Default,,0,0,0,,Оян, қария.
Dialogue: 0,0:37:07.56,0:37:10.91,Default,,0,0,0,,Өлетін уақыт келді. Киё де осында. Барайық.
Dialogue: 0,0:37:11.52,0:37:13.83,Default,,0,0,0,,Киё-чан мен басқалары жақын жерде ішіп отыр.
Dialogue: 0,0:37:13.84,0:37:15.16,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:37:15.16,0:37:16.19,Default,,0,0,0,,Қазір барыңыз Қазір жүріңіз
Dialogue: 0,0:37:16.84,0:37:19.27,Default,,0,0,0,,...
Dialogue: 0,0:37:19.28,0:37:20.31,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:37:23.20,0:37:24.27,Default,,0,0,0,,Қайта бер.
Dialogue: 0,0:37:25.72,0:37:27.91,Default,,0,0,0,,Жарайды... маған оны қайтар.
Dialogue: 0,0:37:29.40,0:37:33.83,Default,,0,0,0,,Иә, шетелдіктің күйеуінің көңіл-күйі өте нашар болды.
Dialogue: 0,0:37:34.84,0:37:36.19,Default,,0,0,0,,Маған шабуыл жасалды
Dialogue: 0,0:37:36.20,0:37:39.67,Default,,0,0,0,,...
Dialogue: 0,0:37:39.68,0:37:42.71,Default,,0,0,0,,Меннен үйренгің келеді.
Dialogue: 0,0:37:42.80,0:37:47.59,Default,,0,0,0,,「 」
Dialogue: 0,0:37:47.60,0:37:52.80,Default,,0,0,0,,...
Dialogue: 0,0:37:52.80,0:37:55.11,Default,,0,0,0,,…」
Dialogue: 0,0:37:55.12,0:37:58.47,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:37:58.48,0:38:00.59,Default,,0,0,0,,Бұл да әзіл емес.
Dialogue: 0,0:38:07.24,0:38:09.23,Default,,0,0,0,,Ана діні
Dialogue: 0,0:38:23.00,0:38:24.63,Default,,0,0,0,,Қараңызшы, бұл сүйкімді емес пе?
Dialogue: 0,0:38:25.00,0:38:28.51,Default,,0,0,0,,...
Dialogue: 0,0:38:28.52,0:38:30.15,Default,,0,0,0,,Сондықтан аты Періште
Dialogue: 0,0:38:31.84,0:38:33.75,Default,,0,0,0,,Бірақ артық емес
Dialogue: 0,0:38:37.16,0:38:38.03,Default,,0,0,0,,Әке
Dialogue: 0,0:38:49.04,0:38:50.67,Default,,0,0,0,,...
Dialogue: 0,0:38:51.40,0:38:53.67,Default,,0,0,0,,...
Dialogue: 0,0:39:20.16,0:39:22.95,Default,,0,0,0,,Бала? құдай сыйы
Dialogue: 0,0:39:22.96,0:39:23.95,Default,,0,0,0,,Иә
Dialogue: 0,0:39:25.16,0:39:27.51,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:39:27.52,0:39:29.79,Default,,0,0,0,,...
Dialogue: 0,0:39:29.80,0:39:32.18,Default,,0,0,0,,Ол балалар да менің асыл отбасым.
Dialogue: 0,0:39:33.84,0:39:35.43,Default,,0,0,0,,Мен осында кірдім.
Dialogue: 0,0:39:36.16,0:39:37.19,Default,,0,0,0,,О, аз ақша.
Dialogue: 0,0:39:37.20,0:39:38.55,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:39:38.84,0:39:41.07,Default,,0,0,0,,Киёко Миюки
Dialogue: 0,0:39:42.36,0:39:44.47,Default,,0,0,0,,Киоко Миюки
Dialogue: 0,0:39:44.48,0:39:45.83,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:39:53.36,0:39:56.00,Default,,0,0,0,,Миюки Киёко
Dialogue: 0,0:40:13.00,0:40:15.51,Default,,0,0,0,,Ата-анаңа не дедің?
Dialogue: 0,0:40:17.00,0:40:18.47,Default,,0,0,0,,Бұл сенің әкеңнің кінәсі.
Dialogue: 0,0:40:19.24,0:40:24.75,Default,,0,0,0,,...
Dialogue: 0,0:40:24.76,0:40:26.63,Default,,0,0,0,,Сіз оны бәрібір пайдаланбайтын шығарсыз.
Dialogue: 0,0:40:26.64,0:40:27.99,Default,,0,0,0,,Оны тез қайтарыңыз.
Dialogue: 0,0:40:28.00,0:40:30.95,Default,,0,0,0,,Қайдасың, періштем?
Dialogue: 0,0:40:31.60,0:40:32.99,Default,,0,0,0,,Дәл сол жерде.
Dialogue: 0,0:40:33.00,0:40:34.75,Default,,0,0,0,,Сәлем періште
Dialogue: 0,0:40:37.04,0:40:38.75,Default,,0,0,0,,Эй, қарным ашты.
Dialogue: 0,0:40:38.76,0:40:40.51,Default,,0,0,0,,Маған тамақ беріңізші
Dialogue: 0,0:40:41.64,0:40:42.47,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:40:43.12,0:40:45.50,Default,,0,0,0,,Балалар, сендер неге үйдесіңдер?
Dialogue: 0,0:40:45.52,0:40:49.79,Default,,0,0,0,,...
Dialogue: 0,0:41:00.12,0:41:05.99,Default,,0,0,0,,Киоко Миюки-чан
Dialogue: 0,0:41:10.00,0:41:11.27,Default,,0,0,0,,Апайдың ағасы
Dialogue: 0,0:41:15.16,0:41:18.75,Default,,0,0,0,,Мен сенімен танысқым келді, менің сүйкімді періштем.
Dialogue: 0,0:41:22.44,0:41:25.95,Default,,0,0,0,,Мен сені анам деп атасам ғой, бірақ мен жай ғана фазамын.
Dialogue: 0,0:41:27.56,0:41:28.39,Default,,0,0,0,,Миюки-чан
Dialogue: 0,0:41:29.96,0:41:31.43,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:41:41.08,0:41:41.91,Default,,0,0,0,,Қария ше?
Dialogue: 0,0:41:42.84,0:41:45.43,Default,,0,0,0,,Ол жігіт өлуі керек.
Dialogue: 0,0:41:47.56,0:41:50.31,Default,,0,0,0,,Ши... өл
Dialogue: 0,0:42:00.36,0:42:02.82,Default,,0,0,0,,Қызық, қария үйіне кетті ме?
Dialogue: 0,0:42:02.84,0:42:04.19,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:42:04.48,0:42:06.86,Default,,0,0,0,,Бар болғаны жақсы болсаң болды, ондай сорақы.
Dialogue: 0,0:42:08.20,0:42:12.99,Default,,0,0,0,,Бірақ саған қарт қатты ұнайды, солай емес пе, Хана-сан?
Dialogue: 0,0:42:13.00,0:42:17.23,Default,,0,0,0,,Ақымақ болма, маған ер мінезді еркектер ұнайды.
Dialogue: 0,0:42:17.24,0:42:22.87,Default,,0,0,0,,Мысалы... терісі күйген, басы қырылған орта жастағы сымбатты адам.
Dialogue: 0,0:42:22.88,0:42:26.51,Default,,0,0,0,,Мен аздап мазасызданып, жеткіліксіз соманы төледім.
Dialogue: 0,0:42:26.52,0:42:29.63,Default,,0,0,0,,«Оған көмектесу мүмкін емес»
Dialogue: 0,0:42:29.64,0:42:32.71,Default,,0,0,0,,Маған Эдокко сияқты жомарттықпен жеңілетін адамдар ұнайды.
Dialogue: 0,0:42:36.24,0:42:38.75,Default,,0,0,0,,Енді не істейсің, Хана?
Dialogue: 0,0:42:38.76,0:42:43.15,Default,,0,0,0,,Бұдан былай мені қалай атасаңыз да, апай-о-сан деп атай аласыз.
Dialogue: 0,0:42:43.16,0:42:45.15,Default,,0,0,0,,Қоңырау шалу ұзақ және қиын.
Dialogue: 0,0:42:52.40,0:42:53.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:42:56.92,0:42:58.24,Default,,0,0,0,,Сіз құлап қалдыңыз ба?
Dialogue: 0,0:42:58.24,0:42:59.79,Default,,0,0,0,,О, үйсіз адам
Dialogue: 0,0:42:59.80,0:43:01.27,Default,,0,0,0,,Ертең бұл мен болуым мүмкін
Dialogue: 0,0:43:01.28,0:43:02.79,Default,,0,0,0,,Еңбек етейік, еңбек етейік
Dialogue: 0,0:43:02.80,0:43:04.55,Default,,0,0,0,,Джин-чан
Dialogue: 0,0:43:07.52,0:43:10.11,Default,,0,0,0,,Джин-чан Джин-чан
Dialogue: 0,0:43:10.68,0:43:12.31,Default,,0,0,0,,қазіргі уақытта қарғысқа ұшыраған эмбрионмен бірге әлі де сонда қамалып отыр –
Dialogue: 0,0:43:12.32,0:43:13.43,Default,,0,0,0,,Джин-чан
Dialogue: 0,0:43:13.44,0:43:14.76,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:43:23.44,0:43:27.19,Default,,0,0,0,,Бұл Джадрок қайда?
Dialogue: 0,0:43:28.32,0:43:32.91,Default,,0,0,0,,Тазалау…
Dialogue: 0,0:43:33.96,0:43:38.55,Default,,0,0,0,,Осы түн
Dialogue: 0,0:43:39.96,0:43:44.19,Default,,0,0,0,,Өлер алдында сені тағы бір көргім келді.
Dialogue: 0,0:43:46.80,0:43:49.83,Default,,0,0,0,,Киоко
Dialogue: 0,0:44:05.12,0:44:08.87,Default,,0,0,0,,Сізге қайсысы ұнайды, менің сиқырымды ма, әлде жедел жәрдемді ме?
Dialogue: 0,0:44:09.72,0:44:11.23,Default,,0,0,0,,Бұл жігіт міндетті түрде есінен танып қалады
Dialogue: 0,0:44:11.24,0:44:12.87,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:44:14.00,0:44:18.35,Default,,0,0,0,,Біз не істеуіміз керек? Мен Киёко лагерін жабайы табиғатқа жібере алмаймын.
Dialogue: 0,0:44:18.36,0:44:22.75,Default,,0,0,0,,Қарт жоқ, күн суық, ұйқым келді, қарным ашты.
Dialogue: 0,0:44:22.76,0:44:24.35,Default,,0,0,0,,Бұл ең нашар
Dialogue: 0,0:44:25.00,0:44:27.35,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:44:33.36,0:44:36.00,Default,,0,0,0,,Мен енді осында келемін деп ойламадым.
Dialogue: 0,0:44:42.24,0:44:46.27,Default,,0,0,0,,Кешіріңіз, мен бүгін жеке кешке байланысты жабықпын...
Dialogue: 0,0:44:48.64,0:44:50.03,Default,,0,0,0,,Ха Хана Чан?
Dialogue: 0,0:44:50.40,0:44:54.39,Default,,0,0,0,,Мен қазір үлкен бет бұратындай жағдайда емес екенімді жақсы түсінемін.
Dialogue: 0,0:44:54.40,0:44:58.23,Default,,0,0,0,,Бірақ қазір анамнан басқа арқа сүйер ешкімім жоқ.
Dialogue: 0,0:45:03.04,0:45:04.67,Default,,0,0,0,,Хана-чан
Dialogue: 0,0:45:05.28,0:45:06.87,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:45:06.88,0:45:08.15,Default,,0,0,0,,Хана-чан
Dialogue: 0,0:45:15.92,0:45:16.79,Default,,0,0,0,,Қария
Dialogue: 0,0:45:20.20,0:45:22.03,Default,,0,0,0,,Не болды, Джин Чан?
Dialogue: 0,0:45:24.40,0:45:26.75,Default,,0,0,0,,Балалардың шабуылы
Dialogue: 0,0:45:27.92,0:45:30.95,Default,,0,0,0,,Бұл экшн фильміне ұқсамайды.
Dialogue: 0,0:45:35.32,0:45:37.96,Default,,0,0,0,,Мен Хана-чанның танысы емеспін.
Dialogue: 0,0:45:37.96,0:45:41.31,Default,,0,0,0,,Бірақ сіз үйсіз екеніңізді айттыңыз.
Dialogue: 0,0:45:42.40,0:45:43.95,Default,,0,0,0,,Шындығында, мен де
Dialogue: 0,0:45:43.96,0:45:47.39,Default,,0,0,0,,Иә, мүмкін емес, неге?
Dialogue: 0,0:45:48.92,0:45:51.30,Default,,0,0,0,,Аа, мен ол кісіні жоғалтқаннан бері.
Dialogue: 0,0:45:51.32,0:45:53.67,Default,,0,0,0,,Мен ән айтуды ұмытқан канареймін
Dialogue: 0,0:45:54.04,0:45:56.07,Default,,0,0,0,,Сіз жынды сияқты ән айттыңыз.
Dialogue: 0,0:45:57.72,0:45:59.23,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:45:59.24,0:46:00.91,Default,,0,0,0,,Мен босанғым келеді
Dialogue: 0,0:46:06.24,0:46:09.47,Default,,0,0,0,,Иә, Кен Чан қайтыс болды...
Dialogue: 0,0:46:11.96,0:46:12.95,Default,,0,0,0,,СПИД?
Dialogue: 0,0:46:13.72,0:46:16.18,Default,,0,0,0,,Жуынатын бөлмеде сабынды басып қалдым...
Dialogue: 0,0:46:16.20,0:46:19.98,Default,,0,0,0,,Адамдардан бір дюйм алда қараңғылық.
Dialogue: 0,0:46:20.76,0:46:24.64,Default,,0,0,0,,Бірақ Хана-чан қиналса, ол неге үйге келмеді?
Dialogue: 0,0:46:27.64,0:46:30.83,Default,,0,0,0,,Ол кезде өте қызық еді.
Dialogue: 0,0:46:32.84,0:46:35.59,Default,,0,0,0,,Осы ескі жолақта
Dialogue: 0,0:46:35.60,0:46:39.19,Default,,0,0,0,,Өйткені мен көп ішетінмін
Dialogue: 0,0:46:40.00,0:46:42.11,Default,,0,0,0,,Ескі естеліктер
Dialogue: 0,0:46:42.72,0:46:47.27,Default,,0,0,0,,Бұлыңғыр болып бара жатқан сияқты
Dialogue: 0,0:46:47.28,0:46:49.87,Default,,0,0,0,,Мен ғашықпын
Dialogue: 0,0:46:49.88,0:46:53.23,Default,,0,0,0,,Мені тастап кетті.
Dialogue: 0,0:46:54.48,0:46:59.79,Default,,0,0,0,,Себебі мені адамдар тег деп атайды
Dialogue: 0,0:46:59.80,0:47:01.63,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:47:02.16,0:47:04.75,Default,,0,0,0,,Бейбақ
Dialogue: 0,0:47:04.76,0:47:05.75,Default,,0,0,0,,Кері тарту
Dialogue: 0,0:47:05.76,0:47:08.40,Default,,0,0,0,,Бейбақ
Dialogue: 0,0:47:09.40,0:47:13.28,Default,,0,0,0,,Оны айту қандай сұмдық
Dialogue: 0,0:47:13.28,0:47:15.63,Default,,0,0,0,,Мына қарғыс атқыр қарт
Dialogue: 0,0:47:17.40,0:47:21.51,Default,,0,0,0,,Боқтауға қарсы емеспін, бірақ қарттарға шыдамаймын.
Dialogue: 0,0:47:28.52,0:47:31.67,Default,,0,0,0,,Мен берілмеймін. Мен осындай қиындықты тудырып жатырмын.
Dialogue: 0,0:47:32.08,0:47:36.07,Default,,0,0,0,,Жарайды, оны ақшамен шешуге болады.
Dialogue: 0,0:47:36.08,0:47:38.95,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:47:40.96,0:47:44.55,Default,,0,0,0,,Тоқта, сенің жылаған жүзіңнен қорқамын.
Dialogue: 0,0:47:46.52,0:47:50.83,Default,,0,0,0,,Мына бала ше? Сол қыздың баласы ма?
Dialogue: 0,0:47:50.84,0:47:52.16,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:47:55.56,0:47:59.03,Default,,0,0,0,,Қызық, сенің анаң қайда?
Dialogue: 0,0:47:59.92,0:48:01.35,Default,,0,0,0,,Иә, сізді тастап кетті ме?
Dialogue: 0,0:48:01.36,0:48:04.79,Default,,0,0,0,,Иә, мені тастап кетті.
Dialogue: 0,0:48:07.32,0:48:09.96,Default,,0,0,0,,Бұл тағдыр сияқты.
Dialogue: 0,0:48:11.36,0:48:13.71,Default,,0,0,0,,Мен бұл менікі деп ойладым.
Dialogue: 0,0:48:14.20,0:48:18.23,Default,,0,0,0,,Көшеде туған, енді көшеде
Dialogue: 0,0:48:18.80,0:48:24.59,Default,,0,0,0,,Сондықтан мен сол балаға деген махаббатқа толы үй тапқым келеді.
Dialogue: 0,0:48:24.60,0:48:29.11,Default,,0,0,0,,Өйткені мен бәрінен де қатты қалағаным махаббат еді.
Dialogue: 0,0:48:36.20,0:48:36.99,Default,,0,0,0,,Ау, ауырып тұр
Dialogue: 0,0:48:43.76,0:48:45.71,Default,,0,0,0,,Көрдіңіз бе? Мен айтқанымдай болды ғой, иә?
Dialogue: 0,0:48:48.24,0:48:50.75,Default,,0,0,0,,Қарт өмір салтын өзгертті.
Dialogue: 0,0:48:50.76,0:48:52.27,Default,,0,0,0,,Менің киімдерім
Dialogue: 0,0:49:02.00,0:49:03.99,Default,,0,0,0,,Үлкен тұтқа, Джин Чан
Dialogue: 0,0:49:05.76,0:49:07.99,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса, кез келген уақытта оралыңыз.
Dialogue: 0,0:49:09.04,0:49:11.23,Default,,0,0,0,,Рахмет анашым
Dialogue: 0,0:50:36.84,0:50:38.99,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:50:39.64,0:50:42.99,Default,,0,0,0,,Бос үй – тамаша тұтынушы.
Dialogue: 0,0:50:46.72,0:50:49.95,Default,,0,0,0,,Тойдым...Ет жегім келеді.
Dialogue: 0,0:50:50.88,0:50:52.51,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:50:54.40,0:50:56.51,Default,,0,0,0,,Қалжың, әзіл
Dialogue: 0,0:51:01.52,0:51:05.22,Default,,0,0,0,,Қараңғы болды, Миюки-чан, дүкенге барыңыз.
Dialogue: 0,0:51:05.24,0:51:06.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:51:06.36,0:51:08.27,Default,,0,0,0,,Мен аздап алкогольге тапсырыс беремін.
Dialogue: 0,0:51:09.16,0:51:10.79,Default,,0,0,0,,Бір ғана сусын, солай ма?
Dialogue: 0,0:51:28.92,0:51:29.67,Default,,0,0,0,,Ах.
Dialogue: 0,0:51:29.68,0:51:30.90,Default,,0,0,0,,Мен үміттенемін ...
Dialogue: 0,0:51:48.44,0:51:49.51,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:52:07.72,0:52:14.47,Default,,0,0,0,,Иә, сіз осындай жерде тұрасыз. Мен оны ұнатпаймын. Мен үйсіз қалғым келмейді.
Dialogue: 0,0:52:18.08,0:52:21.55,Default,,0,0,0,,Негізі мен бұл адамдарды іздеп жүрмін.
Dialogue: 0,0:52:22.96,0:52:25.31,Default,,0,0,0,,О, Сачико Нишизава
Dialogue: 0,0:52:25.72,0:52:26.99,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:52:27.48,0:52:31.36,Default,,0,0,0,,Сіз мен төлеген көршілес қауымдастық жарналарын елемедіңіз.
Dialogue: 0,0:52:31.36,0:52:33.87,Default,,0,0,0,,Сіз ол әйелмен туыссыз ба?
Dialogue: 0,0:52:33.88,0:52:38.59,Default,,0,0,0,,Жоқ, мен Сачиконың жақын танысымын, әлде айтайын ба...
Dialogue: 0,0:52:38.60,0:52:40.98,Default,,0,0,0,,Әйел де әйел болса, күйеуі де күйеу.
Dialogue: 0,0:52:41.00,0:52:45.35,Default,,0,0,0,,Мен күні-түні құмар ойнадым, тіпті ішімдік ішуді әдетке айналдырдым.
Dialogue: 0,0:52:47.64,0:52:50.99,Default,,0,0,0,,Ол әйелінің табысы мен қарызына күн көретін сияқты.
Dialogue: 0,0:52:51.00,0:52:52.87,Default,,0,0,0,,Енді... қай жолмен?
Dialogue: 0,0:52:52.88,0:52:56.76,Default,,0,0,0,,Енді, Курумизава-сан, сен білесің бе?
Dialogue: 0,0:52:57.88,0:53:00.59,Default,,0,0,0,,Бұл шамамен үш ай бұрын шыққан.
Dialogue: 0,0:53:01.52,0:53:07.63,Default,,0,0,0,,Бұл үйді борышкер алып кеткен, сондықтан түн жарымында қашып кеткендей. Сәлем деуге болмайды.
Dialogue: 0,0:53:08.76,0:53:12.11,Default,,0,0,0,,Осында көшіп келгенде жақсы жұп едік.
Dialogue: 0,0:53:12.12,0:53:16.27,Default,,0,0,0,,Көп ұзамай ерлі-зайыптылар үздіксіз ұрыса бастады.
Dialogue: 0,0:53:16.28,0:53:18.39,Default,,0,0,0,,Кедей болу сені түңілмейді.
Dialogue: 0,0:53:18.40,0:53:22.91,Default,,0,0,0,,Ол тек қарыз бере алатын болса да, ол бастық күйеу сияқты көрінеді.
Dialogue: 0,0:53:22.92,0:53:26.23,Default,,0,0,0,,Бөксесін сүртетін әйелдерім жетпейді.
Dialogue: 0,0:53:27.64,0:53:29.87,Default,,0,0,0,,Кейде бетім көгеріп кететін.
Dialogue: 0,0:53:29.88,0:53:31.79,Default,,0,0,0,,Мен де сол әйелге ренжідім.
Dialogue: 0,0:53:31.80,0:53:34.51,Default,,0,0,0,,Керісінше, туу белгісі күйеуден.
Dialogue: 0,0:53:34.52,0:53:35.74,Default,,0,0,0,,Ах~
Dialogue: 0,0:53:36.44,0:53:43.19,Default,,0,0,0,,Бірақ қайын енем бір жағынан көмектесті, сондықтан әйелімнің көңіл-күйі нашар болған сияқты.
Dialogue: 0,0:53:44.04,0:53:47.19,Default,,0,0,0,,Макоко да менің ата-анам салған үй.
Dialogue: 0,0:53:47.20,0:53:49.31,Default,,0,0,0,,Сен ата-анаңның үйін білесің бе?
Dialogue: 0,0:53:49.32,0:53:51.31,Default,,0,0,0,,Яманучи мырза біледі ме?
Dialogue: 0,0:53:53.76,0:53:56.07,Default,,0,0,0,,Қайын енем үнемі төгетін.
Dialogue: 0,0:53:56.08,0:53:58.51,Default,,0,0,0,,Әйелім үй жұмысын көп істемейді.
Dialogue: 0,0:53:58.52,0:54:00.95,Default,,0,0,0,,Баламның қадірін сөреге қояды деп жиі айтамын.
Dialogue: 0,0:54:00.96,0:54:03.79,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:54:03.80,0:54:08.07,Default,,0,0,0,,Немерелеріңді көргің келсе, әйеліңді түнде жұмысқа жіберме.
Dialogue: 0,0:54:08.40,0:54:11.43,Default,,0,0,0,,Бірақ сен істедің, балам.
Dialogue: 0,0:54:11.44,0:54:13.82,Default,,0,0,0,,Ер мен әйел деген ұғым жоқ.
Dialogue: 0,0:54:13.84,0:54:15.59,Default,,0,0,0,,Бар болғаны істеу керек
Dialogue: 0,0:54:15.60,0:54:17.95,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:54:22.72,0:54:25.18,Default,,0,0,0,,Түнде қашып жүргеніңізге сенімдісіз бе?
Dialogue: 0,0:54:25.20,0:54:27.43,Default,,0,0,0,,Қандай сұмдық адам еді.
Dialogue: 0,0:54:27.84,0:54:33.19,Default,,0,0,0,,Күйеуінің қарызын арқалап, жұмыс істеуге мәжбүр болған Сачикоға жаным ашиды.
Dialogue: 0,0:54:33.20,0:54:34.47,Default,,0,0,0,,Ал... мүлде емес.
Dialogue: 0,0:54:34.88,0:54:39.23,Default,,0,0,0,,Мен баламды қаламаймын деп тастаймын деп ешқашан ойлаған емеспін.
Dialogue: 0,0:54:40.60,0:54:41.99,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:42.00,0:54:46.23,Default,,0,0,0,,Бұл сіздің балаңызды жібере алмайсыз дегенді білдірмейді.
Dialogue: 0,0:54:46.24,0:54:47.95,Default,,0,0,0,,Сіз мұны басынан бастап айттыңыз.
Dialogue: 0,0:54:59.96,0:55:02.60,Default,,0,0,0,,Жалықпай жаңбыр көп жауады.
Dialogue: 0,0:55:05.40,0:55:06.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:16.92,0:55:20.47,Default,,0,0,0,,Маған таң қалдым, біз қандай боламыз?
Dialogue: 0,0:55:20.48,0:55:23.15,Default,,0,0,0,,Үй-күйсіз, немқұрайлы, қашқын қызы және тастанды бала
Dialogue: 0,0:55:23.64,0:55:26.91,Default,,0,0,0,,Киоко - Құдайдың елшісі, ал біз оның қызметшілеріміз
Dialogue: 0,0:55:28.16,0:55:30.35,Default,,0,0,0,,Сіз тіпті жалақы да алмайтын қызметшісіз бе?
Dialogue: 0,0:55:30.92,0:55:34.23,Default,,0,0,0,,Мені жазаламайтын ата-анамның кесірінен қиналдым.
Dialogue: 0,0:55:34.24,0:55:37.63,Default,,0,0,0,,Мен мінсіз әдепті ата-анадан туған болсам ғой.
Dialogue: 0,0:55:37.64,0:55:40.15,Default,,0,0,0,,Осы қиыншылықтың бәрін өткермесем екен.
Dialogue: 0,0:55:41.68,0:55:46.55,Default,,0,0,0,,Дұрыс жасамаған ата-ана да балаларын ұмыта алмайды.
Dialogue: 0,0:55:48.88,0:55:50.20,Default,,0,0,0,,Ол аздап шығады
Dialogue: 0,0:55:54.80,0:55:57.67,Default,,0,0,0,,Бұрынғы жігітке не болды?
Dialogue: 0,0:55:57.68,0:56:01.19,Default,,0,0,0,,Балалар да ата-анасын ұмыта алмайды.
Dialogue: 0,0:56:05.84,0:56:08.43,Default,,0,0,0,,Мен де әрқашан солай ойлаймын.
Dialogue: 0,0:56:10.04,0:56:12.39,Default,,0,0,0,,Бір қарағанда қызбен танысу
Dialogue: 0,0:56:12.84,0:56:14.67,Default,,0,0,0,,Сонда сен тірісің бе?
Dialogue: 0,0:56:15.28,0:56:16.60,Default,,0,0,0,,О
Dialogue: 0,0:56:16.60,0:56:17.59,Default,,0,0,0,,Сіздің әйеліңіз де?
Dialogue: 0,0:56:19.08,0:56:21.35,Default,,0,0,0,,Мен оның қазірге дейін қайта үйленетініне сенімдімін.
Dialogue: 0,0:56:21.84,0:56:23.91,Default,,0,0,0,,Біз бірге бақытты өмір сүріп жатырмыз.
Dialogue: 0,0:56:29.20,0:56:30.03,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:56:30.84,0:56:32.47,Default,,0,0,0,,Миюки Аташи
Dialogue: 0,0:56:33.20,0:56:34.91,Default,,0,0,0,,Неліктен ажырастың?
Dialogue: 0,0:56:35.44,0:56:36.66,Default,,0,0,0,,Алкоголь және құмар ойындар
Dialogue: 0,0:56:36.68,0:56:37.23,Default,,0,0,0,,Ах.
Dialogue: 0,0:56:38.72,0:56:39.79,Default,,0,0,0,,Бұл жай ғана...
Dialogue: 0,0:56:41.12,0:56:43.47,Default,,0,0,0,,Жоқ, бұл сіздің бетіңізге байланысты емес.
Dialogue: 0,0:56:44.56,0:56:49.43,Default,,0,0,0,,Бірақ мен осындай болсам да, мен әке сияқты ең болмағанда бір нәрсені жасағым келеді.
Dialogue: 0,0:56:50.00,0:56:51.47,Default,,0,0,0,,Бірте-бірте
Dialogue: 0,0:56:52.24,0:56:55.99,Default,,0,0,0,,Құмар ойнап жүрген кезімде ол қағаз сияқты еді.
Dialogue: 0,0:56:56.36,0:57:00.06,Default,,0,0,0,,Қазіргі уақытта үш Юкичи кесектерін жинауға табақ табу қиын.
Dialogue: 0,0:57:00.08,0:57:01.99,Default,,0,0,0,,Ұлы Джин Чан
Dialogue: 0,0:57:02.60,0:57:04.39,Default,,0,0,0,,Сіз мұнымен көп жеуге болады.
Dialogue: 0,0:57:04.40,0:57:05.62,Default,,0,0,0,,Бақатаре
Dialogue: 0,0:57:15.64,0:57:17.39,Default,,0,0,0,,Иә, мен Ишидамын.
Dialogue: 0,0:57:25.80,0:57:28.63,Default,,0,0,0,,Миюки? Бұл Миюки.
Dialogue: 0,0:57:31.24,0:57:32.27,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:57:38.40,0:57:41.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:57:42.28,0:57:43.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:57:46.28,0:57:48.92,Default,,0,0,0,,Кешіріңіз, бірақ уақыт келді...
Dialogue: 0,0:57:48.92,0:57:50.27,Default,,0,0,0,,Шығу керек пе?
Dialogue: 0,0:57:50.92,0:57:54.67,Default,,0,0,0,,Басқа тұтынушылар да қызметті пайдаланады.
Dialogue: 0,0:57:54.68,0:57:56.43,Default,,0,0,0,,Шынында да тұтынушылар жоқ.
Dialogue: 0,0:57:56.44,0:57:57.91,Default,,0,0,0,,Сасық.
Dialogue: 0,0:57:58.88,0:58:02.31,Default,,0,0,0,,Сіз үйсізсіз бе?
Dialogue: 0,0:58:02.92,0:58:06.67,Default,,0,0,0,,Қоқыс пенделерді адамдай қылып жатыр.
Dialogue: 0,0:58:07.56,0:58:09.51,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:58:11.84,0:58:13.31,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:58:14.16,0:58:15.83,Default,,0,0,0,,Жоқ, тұтынушы.
Dialogue: 0,0:58:15.84,0:58:17.91,Default,,0,0,0,,Тоқта, бұл не қоқыс?
Dialogue: 0,0:58:27.80,0:58:31.58,Default,,0,0,0,,Жыл соңындағы азық-түлік дүкендері жыл аяғында сатылымдарды ұсынады.
Dialogue: 0,0:58:31.60,0:58:38.23,Default,,0,0,0,,Жаңа жыл мен Жаңа жыл түні үшін барлығын азық-түлік дүкеніне қалдырыңыз.
Dialogue: 0,0:58:38.24,0:58:41.11,Default,,0,0,0,,Жаңа жылды отбасымызбен қарсы алайық
Dialogue: 0,0:58:41.12,0:58:42.95,Default,,0,0,0,,Жедел жәрдемді... тез жеткізіңіз.
Dialogue: 0,0:58:43.60,0:58:44.99,Default,,0,0,0,,Иә
Dialogue: 0,0:58:48.20,0:58:52.71,Default,,0,0,0,,Өйткені, Киёко – Құдайдың елшісі.
Dialogue: 0,0:58:55.48,0:58:56.35,Default,,0,0,0,,Эй
Dialogue: 0,0:58:56.88,0:58:57.47,Default,,0,0,0,,Хана-сан
Dialogue: 0,0:58:57.48,0:58:58.62,Default,,0,0,0,,Хана, мықты бол.
Dialogue: 0,0:58:58.64,0:58:59.23,Default,,0,0,0,,Хана-сан
Dialogue: 0,0:58:59.24,0:58:59.95,Default,,0,0,0,,Хана
Dialogue: 0,0:59:16.52,0:59:19.39,Default,,0,0,0,,Бұл өткен аптада болған атыс оқиғасының жалғасы.
Dialogue: 0,0:59:19.40,0:59:24.75,Default,,0,0,0,,Елордалық полиция департаменті қылмыскерді оңтүстік америкалық шетелдік деп санайды және қашып кеткен ер адамды қадағалап жатыр.
Dialogue: 0,0:59:25.52,0:59:28.03,Default,,0,0,0,,Бұл оқиғада үш тірі раунд атылды.
Dialogue: 0,0:59:28.04,0:59:32.11,Default,,0,0,0,,Бас Отаны қорғаған атқарушы Мицуо Хирута ауыр жарақат алды.
Dialogue: 0,0:59:32.52,0:59:37.67,Default,,0,0,0,,Бақытымызға орай, өмірге қауіп төндіретін жарақаттар болған жоқ, полиция істі ашпас бұрын оның сауығып кетуін күтуге ниетті.
Dialogue: 0,0:59:38.52,0:59:42.51,Default,,0,0,0,,Сен сондай сүйкімдісің. Сіз қашан дүниеге келдіңіз?
Dialogue: 0,0:59:42.52,0:59:45.27,Default,,0,0,0,,Жақында... мүмкін
Dialogue: 0,0:59:45.92,0:59:47.67,Default,,0,0,0,,Анам…
Dialogue: 0,0:59:47.68,0:59:49.15,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:59:49.68,0:59:51.67,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:59:51.68,0:59:52.39,Default,,0,0,0,,Киёко
Dialogue: 0,0:59:52.40,0:59:56.18,Default,,0,0,0,,Ой, менің де Киёко болғаным кездейсоқтық.
Dialogue: 0,0:59:58.92,1:00:01.43,Default,,0,0,0,,Сіздің серігіңіз өте әлсіз.
Dialogue: 0,1:00:01.44,1:00:04.55,Default,,0,0,0,,Тек демалыңыз және құнарлы тамақ ішіңіз.
Dialogue: 0,1:00:04.56,1:00:05.67,Default,,0,0,0,,Мұғалім
Dialogue: 0,1:00:06.56,1:00:09.20,Default,,0,0,0,,Біз қалай қарасақ та, баспанасызбыз.
Dialogue: 0,1:00:09.20,1:00:11.19,Default,,0,0,0,,Мен жай ғана дәрігермін
Dialogue: 0,1:00:12.92,1:00:18.43,Default,,0,0,0,,Біздің өміріміз тыныштық пен нәрлі емес, түсіндің бе?
Dialogue: 0,1:00:19.32,1:00:25.58,Default,,0,0,0,,Мен сізге ауруыңызды емдеуге көмектесе аламын, бірақ өміріңізді жақсарту сіздің қолыңызда.
Dialogue: 0,1:00:25.60,1:00:28.95,Default,,0,0,0,,Қолыңнан келгеннің бәрін істеуден басқа не істей аласың?
Dialogue: 0,1:00:31.28,1:00:32.83,Default,,0,0,0,,Өзіңізді күтіңіз
Dialogue: 0,1:00:36.60,1:00:39.95,Default,,0,0,0,,Сақтандыру картаңызды кейінірек әкелсеңіз, біз төлемді реттейміз.
Dialogue: 0,1:00:39.96,1:00:43.91,Default,,0,0,0,,Бүгін ол 29 830 иен болады.
Dialogue: 0,1:00:45.32,1:00:47.78,Default,,0,0,0,,Кешіріңіз Джин Чан
Dialogue: 0,1:00:48.48,1:00:51.87,Default,,0,0,0,,Жылама, мен Юкичидің бетіне қарап жылай алсам ғой
Dialogue: 0,1:00:52.84,1:00:54.59,Default,,0,0,0,,Біз 30 000 иенді сақтаймыз.
Dialogue: 0,1:01:11.12,1:01:12.11,Default,,0,0,0,,Киоко…
Dialogue: 0,1:01:17.36,1:01:18.27,Default,,0,0,0,,Ол дәрігер атағын биліктегілердің көңілін табу үшін пайдаланып жүр
Dialogue: 0,1:01:41.40,1:01:43.27,Default,,0,0,0,,Сонымен сіз медбике болдыңыз ба?
Dialogue: 0,1:01:44.80,1:01:46.67,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:01:49.40,1:01:51.43,Default,,0,0,0,,Сіздің жақсы көрінгеніңізге қуаныштымын.
Dialogue: 0,1:01:51.44,1:01:57.03,Default,,0,0,0,,…Ой, сенің анаң қаншалықты жігерлі?
Dialogue: 0,1:01:57.04,1:01:58.03,Default,,0,0,0,,Генки
Dialogue: 0,1:01:59.16,1:02:01.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:02:02.00,1:02:03.79,Default,,0,0,0,,Енді әкеңіз ше?
Dialogue: 0,1:02:03.80,1:02:09.87,Default,,0,0,0,,А...әлде бұл коллекциялық бизнес шығар...Менің сізге жеткізетін бір нәрсем бар.
Dialogue: 0,1:02:14.16,1:02:15.95,Default,,0,0,0,,Сізде кек бар шығар.
Dialogue: 0,1:02:17.44,1:02:21.43,Default,,0,0,0,,Мен сізге ата-ана сияқты ештеңе істей алмадым.
Dialogue: 0,1:02:21.84,1:02:27.43,Default,,0,0,0,,Бірақ шын мәнінде мен сені ойлағаным үшін аздап ақша жинадым.
Dialogue: 0,1:02:29.20,1:02:30.79,Default,,0,0,0,,Сіз бұған сенбейсіз.
Dialogue: 0,1:02:34.16,1:02:37.43,Default,,0,0,0,,Мен сенімен әрқашан кездескім келеді
Dialogue: 0,1:02:38.68,1:02:42.59,Default,,0,0,0,,Кішкентай кезімде анам екеуміз әр жерден іздедік.
Dialogue: 0,1:02:43.08,1:02:45.46,Default,,0,0,0,,Мен де белгісіз денелерді көруге бардым.
Dialogue: 0,1:02:46.72,1:02:51.11,Default,,0,0,0,,Әкем жоқ болғандықтан, анам дүкенді жалғыз өзі басқарды.
Dialogue: 0,1:02:52.48,1:02:53.35,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,1:02:53.36,1:02:57.35,Default,,0,0,0,,Велосипед дүкенін бір әйелмен жүргізу қиынға соғатын сияқты.
Dialogue: 0,1:02:58.68,1:03:01.59,Default,,0,0,0,,Велосипедшіден мүлде айырмашылығы жоқ па?
Dialogue: 0,1:03:01.60,1:03:08.19,Default,,0,0,0,,Сіз білесіз бе? Сол кезде қарызын өндіріп алуға келген адамды мылтықпен атып, ауыр жараланған.
Dialogue: 0,1:03:08.20,1:03:09.23,Default,,0,0,0,,Сіз құтқарылдыңыз ба?
Dialogue: 0,1:03:10.64,1:03:12.83,Default,,0,0,0,,көремін.
Dialogue: 0,1:03:12.84,1:03:14.59,Default,,0,0,0,,Мен сені осылай айтты деп ойладым.
Dialogue: 0,1:03:17.64,1:03:22.27,Default,,0,0,0,,Қарыздың үйілгеніне оның емес, менің кінәм.
Dialogue: 0,1:03:24.28,1:03:28.59,Default,,0,0,0,,Сол дәрігерге рахмет айтыңызшы, ол жақсы адам.
Dialogue: 0,1:03:29.64,1:03:31.59,Default,,0,0,0,,Мен үйленемін
Dialogue: 0,1:03:34.04,1:03:35.91,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,1:03:35.92,1:03:37.27,Default,,0,0,0,,Сол мұғаліммен
Dialogue: 0,1:03:37.28,1:03:41.47,Default,,0,0,0,,Тамаша... сіз менімен құрдас емессіз бе?
Dialogue: 0,1:03:42.36,1:03:45.87,Default,,0,0,0,,Ажырасқаным сонша, айықпас дерттен қызымнан айырылдым.
Dialogue: 0,1:03:46.64,1:03:48.63,Default,,0,0,0,,Әйелім де артымнан келе жатқан сияқты.
Dialogue: 0,1:03:53.92,1:03:56.11,Default,,0,0,0,,Әлгі адам таң қалды.
Dialogue: 0,1:03:56.12,1:03:57.79,Default,,0,0,0,,Сізге әсер еткен жоқ па?
Dialogue: 0,1:03:58.68,1:04:01.63,Default,,0,0,0,,Мекен-жайы мен телефон нөмірі
Dialogue: 0,1:04:01.64,1:04:02.67,Default,,0,0,0,,Сіздікі?
Dialogue: 0,1:04:02.68,1:04:05.32,Default,,0,0,0,,Менің бұрынғы үйім қазір жоқ.
Dialogue: 0,1:04:05.32,1:04:07.43,Default,,0,0,0,,Дәл қазір мүмкін емес, бірақ бір күні...
Dialogue: 0,1:04:08.92,1:04:11.19,Default,,0,0,0,,Киоко…
Dialogue: 0,1:04:13.32,1:04:17.55,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,1:04:17.56,1:04:18.55,Default,,0,0,0,,Хана-сан?
Dialogue: 0,1:04:18.56,1:04:21.27,Default,,0,0,0,,Велосипедшімін деп өтірік айтатын.
Dialogue: 0,1:04:22.28,1:04:24.27,Default,,0,0,0,,Мен велодромға баратынмын.
Dialogue: 0,1:04:24.28,1:04:25.83,Default,,0,0,0,,Сіз құмар ойыншысыз ба?
Dialogue: 0,1:04:25.84,1:04:30.31,Default,,0,0,0,,Соның кесірінен қардай борышым жиналып, отбасыма көрсететін бетім қалмады.
Dialogue: 0,1:04:30.32,1:04:32.27,Default,,0,0,0,,Менің ойымша, ол картон қорапқа тап болды.
Dialogue: 0,1:04:32.28,1:04:34.27,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:04:34.28,1:04:36.79,Default,,0,0,0,,Сіздің әкеңіз осындай ма?
Dialogue: 0,1:04:37.16,1:04:40.94,Default,,0,0,0,,Бәс әлсiз болса ерiк әлсiз, Аяғың сасық болса, арақ-шарап жаман.
Dialogue: 0,1:04:40.96,1:04:45.03,Default,,0,0,0,,Біреудің көзайымына айналғың келсе, өз әйеліңді, қызыңды рұқсатсыз өлтіресің.
Dialogue: 0,1:04:45.04,1:04:48.07,Default,,0,0,0,,Сіз жазылмайтын аурудан қайтыс болдыңыз.
Dialogue: 0,1:04:48.08,1:04:53.31,Default,,0,0,0,,Бұл әке болса, қанша ғұмыр кешсе де, жаным ашиды.
Dialogue: 0,1:04:53.32,1:04:56.23,Default,,0,0,0,,Ей...Жақсылығымды жауға айналдырамын.
Dialogue: 0,1:04:56.80,1:04:58.79,Default,,0,0,0,,Қайырымдылық? Рахмет? !
Dialogue: 0,1:04:58.80,1:05:00.87,Default,,0,0,0,,Ой, мен қате естідім.
Dialogue: 0,1:05:00.88,1:05:03.23,Default,,0,0,0,,Егер сіз жақсылық жасасаңыз, ақшаны маған қайтаруыңызды қалаймын.
Dialogue: 0,1:05:03.24,1:05:05.99,Default,,0,0,0,,Қанжыны қайырымды адамым да, жауым да білмесе де.
Dialogue: 0,1:05:06.00,1:05:09.55,Default,,0,0,0,,Ал, мен қоқыс жәшіктерін ақтаруды білемін.
Dialogue: 0,1:05:09.56,1:05:12.47,Default,,0,0,0,,Балалармен қарызды қалай құру керектігін білесіз бе?
Dialogue: 0,1:05:12.48,1:05:16.23,Default,,0,0,0,,Менің ойымша, мен ең жақсы балаларды тәрбиелеуде жақсы емеспін.
Dialogue: 0,1:05:16.24,1:05:19.35,Default,,0,0,0,,Өзі жақсы өссе де, қарызды әйеліне итермелеп, әйелі білмеген кейіп танытты.
Dialogue: 0,1:05:19.36,1:05:22.87,Default,,0,0,0,,Мен үнемі қашып, ешнәрсеге тоймаймын.
Dialogue: 0,1:05:22.88,1:05:25.75,Default,,0,0,0,,Тек жүгіру жылдамдығы велосипедшімен тең.
Dialogue: 0,1:05:25.76,1:05:28.63,Default,,0,0,0,,Миюки-чан, оны да орап алайық.
Dialogue: 0,1:05:31.72,1:05:32.63,Default,,0,0,0,,Хана-сан?
Dialogue: 0,1:05:38.40,1:05:40.51,Default,,0,0,0,,Өзіңізді жақсы сезінесіз, солай емес пе?
Dialogue: 0,1:05:41.76,1:05:44.51,Default,,0,0,0,,Неге, неге мұндай қорқынышты сөздер айтасың?
Dialogue: 0,1:05:47.64,1:05:50.67,Default,,0,0,0,,Егер сіз кешіре алсаңыз, бұл шын болған шығар.
Dialogue: 0,1:05:53.80,1:05:57.23,Default,,0,0,0,,Адал болайық, бір-бірімізге бәрін көрсетейік
Dialogue: 0,1:05:57.24,1:06:00.27,Default,,0,0,0,,Сонда да тек қана қандас туыс арқылы сүюге болады емес пе?
Dialogue: 0,1:06:01.04,1:06:02.39,Default,,0,0,0,,Менің ойымша, бұл тілек.
Dialogue: 0,1:06:05.40,1:06:07.99,Default,,0,0,0,,Мен саған ғашық болдым ғой.
Dialogue: 0,1:06:08.00,1:06:11.55,Default,,0,0,0,,Ақымақ болма, жылаған қызыл жын
Dialogue: 0,1:06:13.04,1:06:15.42,Default,,0,0,0,,Бұл менің сүйікті әңгімем.
Dialogue: 0,1:06:16.44,1:06:21.07,Default,,0,0,0,,Ертеде адамдармен достасқысы келетін қызыл жын болыпты.
Dialogue: 0,1:06:22.08,1:06:27.07,Default,,0,0,0,,Бірақ адамдар қорқады және ешкім Акаони-санға жақындауға тырыспайды.
Dialogue: 0,1:06:27.08,1:06:30.43,Default,,0,0,0,,Менің досым Ао Они бұл туралы білгенде, ол жоспар туралы ойлай бастады.
Dialogue: 0,1:06:31.84,1:06:37.39,Default,,0,0,0,,Ао Они адамдарға қасақана зорлық-зомбылық жасайды, ал Ред Они оған көмектеседі.
Dialogue: 0,1:06:50.36,1:06:52.23,Default,,0,0,0,,Ал жоспар сәтті болды
Dialogue: 0,1:06:52.72,1:06:57.23,Default,,0,0,0,,Бірақ Аоки-сан келіссөздер анықталмас үшін кетіп қалады.
Dialogue: 0,1:07:00.48,1:07:02.11,Default,,0,0,0,,Көз жасын төгетін әңгіме.
Dialogue: 0,1:07:02.12,1:07:06.43,Default,,0,0,0,,Бірақ кетсең не істейсің? Хана қайда барады?
Dialogue: 0,1:07:07.36,1:07:10.87,Default,,0,0,0,,Әрбір адам өзінің шынайы отбасына оралғаны жақсы.
Dialogue: 0,1:07:10.88,1:07:12.99,Default,,0,0,0,,Киёко да жақын арада анасымен кездесе алады.
Dialogue: 0,1:07:13.00,1:07:17.11,Default,,0,0,0,,Осыдан кейін? Өйткені Хана-санның нағыз отбасы жоқ.
Dialogue: 0,1:07:30.88,1:07:35.27,Default,,0,0,0,,Жыл сайынғы жұмбо лотереясының жылдық ұтысы өткізілді.
Dialogue: 0,1:07:36.08,1:07:39.51,Default,,0,0,0,,Бірінші ұтқан сан математиканың өте ерекше бөлігі болып табылады.
Dialogue: 0,1:07:40.24,1:07:44.59,Default,,0,0,0,,11 111,111 жиындары
Dialogue: 0,1:07:44.60,1:07:47.51,Default,,0,0,0,,Бірінші жүлде 200 миллион иен және 50 миллион иен
Dialogue: 0,1:07:47.52,1:07:49.27,Default,,0,0,0,,Әр түрлі топтар үшін жүлде 100 000 иен.
Dialogue: 0,1:07:50.36,1:07:52.87,Default,,0,0,0,,Бірінші жүлдені жеңіп алған нөмірлер:
Dialogue: 0,1:07:55.52,1:07:57.15,Default,,0,0,0,,Бұл жаңа ғана түскен жаңалық.
Dialogue: 0,1:07:57.68,1:08:01.38,Default,,0,0,0,,Жаңа туылған нәрестені Шинагава Уордындағы орталық ауруханадан ұрлау оқиғасы.
Dialogue: 0,1:08:01.40,1:08:05.23,Default,,0,0,0,,Елордалық полиция департаменті сәбилердің ерекшеліктерін көрсететін иллюстрация шығарды.
Dialogue: 0,1:08:07.56,1:08:12.68,Default,,0,0,0,,Біз не істейміз? Екеуміз жақын болсақ та, жадынама болмаудың мәні жоқ.
Dialogue: 0,1:08:12.68,1:08:15.43,Default,,0,0,0,,Қарияда бар, қайтайық.
Dialogue: 0,1:08:15.44,1:08:17.55,Default,,0,0,0,,Эй, сен қайда бара жатырсың?
Dialogue: 0,1:08:19.28,1:08:20.42,Default,,0,0,0,,Полиция
Dialogue: 0,1:08:20.44,1:08:23.63,Default,,0,0,0,,Иә? Сен оны қатты жек көрдің.
Dialogue: 0,1:08:24.48,1:08:26.15,Default,,0,0,0,,Барлығы менің эгоым болды
Dialogue: 0,1:08:27.04,1:08:30.59,Default,,0,0,0,,Дәл қазір мен Киёконың ата-анасынан кешірім сұрағым келеді.
Dialogue: 0,1:08:30.60,1:08:35.15,Default,,0,0,0,,Мен дәл қазір жаңалықтарды ұйқысыз күтіп отырған шығармын.
Dialogue: 0,1:08:35.16,1:08:38.79,Default,,0,0,0,,Басында осылай дедіңіз.
Dialogue: 0,1:08:38.80,1:08:43.23,Default,,0,0,0,,Бәлкім, ол өз-өзіне қол жұмсамақ болғаны сонша, өкінген шығар.
Dialogue: 0,1:08:43.24,1:08:46.79,Default,,0,0,0,,А, мен қайтару мүмкін емес нәрсе жасадым.
Dialogue: 0,1:08:46.80,1:08:49.63,Default,,0,0,0,,Өзімізді өзенге тастап өлейік.
Dialogue: 0,1:08:49.64,1:08:53.91,Default,,0,0,0,,Аяқ киімдеріңізді жинап, қоршауға көтеріліңіз. Егер сіз өлсеңіз, әрине оңайырақ болады.
Dialogue: 0,1:08:53.92,1:08:57.11,Default,,0,0,0,,Бірақ бір сәт өзен бетінде сәбидің жүзі көрінді.
Dialogue: 0,1:08:57.12,1:09:02.06,Default,,0,0,0,,Жоқ, мен мына баланың түрін көрмейінше өле алмаймын...
Dialogue: 0,1:09:02.08,1:09:03.79,Default,,0,0,0,,Эй, эй!
Dialogue: 0,1:09:03.80,1:09:04.91,Default,,0,0,0,,No
Dialogue: 0,1:09:07.20,1:09:08.79,Default,,0,0,0,,- Босатыңыз - Тым асықпаңыз.
Dialogue: 0,1:09:08.80,1:09:11.07,Default,,0,0,0,,Маған өлуге рұқсат етіңізші
Dialogue: 0,1:09:18.68,1:09:20.19,Default,,0,0,0,,О сен
Dialogue: 0,1:09:20.96,1:09:22.18,Default,,0,0,0,,Сачико Нишизава
Dialogue: 0,1:09:26.68,1:09:28.59,Default,,0,0,0,,Нақты нені айтасыз?
Dialogue: 0,1:09:28.60,1:09:30.95,Default,,0,0,0,,Кешірім сұрауың керек емес пе еді?
Dialogue: 0,1:09:30.96,1:09:35.07,Default,,0,0,0,,Оны таппағанымызда, суықта тоңып өлетін еді.
Dialogue: 0,1:09:35.08,1:09:36.59,Default,,0,0,0,,Мен емес
Dialogue: 0,1:09:36.60,1:09:39.79,Default,,0,0,0,,Мен жоқта күйеуім өз демалысын алды...
Dialogue: 0,1:09:41.08,1:09:43.95,Default,,0,0,0,,Мен қатты іздедім
Dialogue: 0,1:09:51.24,1:09:52.31,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:09:55.56,1:10:00.47,Default,,0,0,0,,Мен мұндай адам үшін сонша қиыншылықтан өткеніме сене алар емеспін.
Dialogue: 0,1:10:11.88,1:10:14.63,Default,,0,0,0,,Сәлем, өтінемін.
Dialogue: 0,1:10:23.00,1:10:26.35,Default,,0,0,0,,Бұл баланы Құдай шынымен жақсы көреді.
Dialogue: 0,1:10:26.88,1:10:30.11,Default,,0,0,0,,Маған да көп махаббат сыйлашы.
Dialogue: 0,1:10:30.48,1:10:33.39,Default,,0,0,0,,Сәбиге осылай қарасаң, жазаланасың.
Dialogue: 0,1:10:33.40,1:10:35.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:10:35.52,1:10:36.91,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,1:10:46.80,1:10:48.02,Default,,0,0,0,,Нишизава мырза
Dialogue: 0,1:11:34.84,1:11:36.27,Default,,0,0,0,,Не... сен қандайсың?
Dialogue: 0,1:11:36.28,1:11:39.15,Default,,0,0,0,,Ендеше... шық, шық.
Dialogue: 0,1:11:39.16,1:11:41.35,Default,,0,0,0,,Ал, күте тұрыңыз, бұл күдікті емес.
Dialogue: 0,1:11:41.36,1:11:43.82,Default,,0,0,0,,Бұл өтірік, тезірек кет.
Dialogue: 0,1:11:43.84,1:11:44.95,Default,,0,0,0,,Нәрестеге не болды?
Dialogue: 0,1:11:48.48,1:11:51.83,Default,,0,0,0,,Келмедің бе? Жігіт пен бәйбіше баланы қайтарып жатыр.
Dialogue: 0,1:11:51.84,1:11:53.55,Default,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,1:11:53.56,1:11:55.71,Default,,0,0,0,,Баланы тастап кеттің ғой, солай ма?
Dialogue: 0,1:11:57.80,1:11:59.59,Default,,0,0,0,,Жаңалық шықты.
Dialogue: 0,1:12:00.44,1:12:02.55,Default,,0,0,0,,Сіз полициясыз ба?
Dialogue: 0,1:12:02.56,1:12:07.07,Default,,0,0,0,,Не, мен өтіп бара жатқан үйсіз адаммын.
Dialogue: 0,1:12:08.48,1:12:10.63,Default,,0,0,0,,Сен жындысың ба?
Dialogue: 0,1:12:10.64,1:12:12.87,Default,,0,0,0,,Бұл біртүрлі болады.
Dialogue: 0,1:12:12.88,1:12:18.51,Default,,0,0,0,,Неліктен сіз тастап кеткен нәрестеңізді алып кетті деген ақпарат жарияланды?
Dialogue: 0,1:12:18.52,1:12:20.98,Default,,0,0,0,,Осы қарқынмен біз ұрлаушылармыз.
Dialogue: 0,1:12:21.60,1:12:25.63,Default,,0,0,0,,Бұл мен емес. Бұл менің балам емес.
Dialogue: 0,1:12:28.16,1:12:29.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:31.00,1:12:33.38,Default,,0,0,0,,Жарайды, жарайды, жылама, жылама.
Dialogue: 0,1:12:33.40,1:12:34.47,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,1:12:35.16,1:12:36.99,Default,,0,0,0,,Жақсы бала болып өс
Dialogue: 0,1:12:37.00,1:12:38.87,Default,,0,0,0,,Бір күні тағы кездесеміз.
Dialogue: 0,1:12:40.72,1:12:43.03,Default,,0,0,0,,Енді ешқашан жіберме
Dialogue: 0,1:13:23.92,1:13:28.71,Default,,0,0,0,,Бұл нәрестені Сачико ауруханадан ұрлап кеткен.
Dialogue: 0,1:13:28.72,1:13:33.27,Default,,0,0,0,,Ұрланған ба? Сіз баланы ұрлап, кейін лақтырып жібердіңіз бе?
Dialogue: 0,1:13:33.28,1:13:35.19,Default,,0,0,0,,Қалай ойлайсың, адам өмірі қандай құнды?
Dialogue: 0,1:13:35.20,1:13:38.07,Default,,0,0,0,,Мен де алғашында алданып қалдым.
Dialogue: 0,1:13:38.08,1:13:41.31,Default,,0,0,0,,Егер осындай бірдеңе анықталса, бұл үлкен оқиға болар еді.
Dialogue: 0,1:13:41.72,1:13:46.19,Default,,0,0,0,,Мен онымен енді ештеңе істегім келмейді. Сіз мені полицияға немесе кез келген жерге апара аласыз.
Dialogue: 0,1:13:46.20,1:13:47.34,Default,,0,0,0,,Карс Супер Ажаны іздеді —
Dialogue: 0,1:13:48.84,1:13:51.91,Default,,0,0,0,,Мұндай жауапсыз сөзді қалай айттыңыз?
Dialogue: 0,1:13:51.92,1:13:55.11,Default,,0,0,0,,Басқалармен араласуды ұнатпайсыз ба? Отбасы болсын
Dialogue: 0,1:13:55.48,1:13:59.71,Default,,0,0,0,,Екеуміз ажырастық, мен өмірімді қайта бастап жатырмын.
Dialogue: 0,1:13:59.72,1:14:00.71,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,1:14:00.72,1:14:04.99,Default,,0,0,0,,Мен жыл соңында 100 000 иен ұтып алдым, менің жолым өзгерді.
Dialogue: 0,1:14:08.12,1:14:13.87,Default,,0,0,0,,Мен дәл сіз сияқты өмірі мен отбасын тастап кеткен адамды білемін.
Dialogue: 0,1:14:14.44,1:14:16.35,Default,,0,0,0,,Жоқ, мені лақтырып жіберді.
Dialogue: 0,1:14:16.88,1:14:18.63,Default,,0,0,0,,Мен жеңілген емеспін
Dialogue: 0,1:14:23.72,1:14:25.87,Default,,0,0,0,,Әйелімнің сөмкесінде болды.
Dialogue: 0,1:14:28.20,1:14:31.35,Default,,0,0,0,,Әйеліңіз қайда баруы мүмкін екенін білесіз бе?
Dialogue: 0,1:14:31.88,1:14:34.99,Default,,0,0,0,,Ол нәрестені көретінін айтты.
Dialogue: 0,1:14:35.60,1:14:38.47,Default,,0,0,0,,Сен... бұл сенің өлесің деген сөз емес пе?
Dialogue: 0,1:14:40.28,1:14:42.15,Default,,0,0,0,,Бұл жай ғана жеңілдететін кезең емес.
Dialogue: 0,1:14:42.16,1:14:45.75,Default,,0,0,0,,Мен мұндай нәрсені іздеп барамын деп ойламадым.
Dialogue: 0,1:14:45.76,1:14:48.27,Default,,0,0,0,,Шаршаған кезде қолыңнан келетін бір ғана нәрсе бар.
Dialogue: 0,1:14:49.92,1:14:51.24,Default,,0,0,0,,Мен қайда қарауым керек?
Dialogue: 0,1:15:07.64,1:15:08.78,Default,,0,0,0,,Хана
Dialogue: 0,1:15:08.80,1:15:09.91,Default,,0,0,0,,Миюки
Dialogue: 0,1:15:11.88,1:15:13.20,Default,,0,0,0,,Киоко
Dialogue: 0,1:15:19.44,1:15:22.19,Default,,0,0,0,,Жылдың осы мезгілінде Құдайдың да қолы бос емес.
Dialogue: 0,1:15:22.20,1:15:24.27,Default,,0,0,0,,Жыл бойы көзден жақсы.
Dialogue: 0,1:15:25.44,1:15:26.19,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,1:15:35.72,1:15:39.91,Default,,0,0,0,,Сіз сәл кешігіп қалдыңыз, эмоционалды кездесу аяқталды.
Dialogue: 0,1:15:39.92,1:15:41.59,Default,,0,0,0,,Не болды, қария?
Dialogue: 0,1:15:45.56,1:15:46.31,Default,,0,0,0,,Киоко
Dialogue: 0,1:15:50.04,1:15:50.71,Default,,0,0,0,,Іші
Dialogue: 0,1:15:53.32,1:15:54.54,Default,,0,0,0,,Ана
Dialogue: 0,1:15:54.56,1:15:56.23,Default,,0,0,0,,...
Dialogue: 0,1:15:56.24,1:15:57.71,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:15:58.32,1:16:02.10,Default,,0,0,0,,Бұл жалған. Сачиконың анасы жалған.
Dialogue: 0,1:16:04.48,1:16:05.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:11.12,1:16:13.47,Default,,0,0,0,,Неге ішпейсің?
Dialogue: 0,1:16:14.48,1:16:18.63,Default,,0,0,0,,Сәбилер анасының кеудесін ішеді, солай ма?
Dialogue: 0,1:16:19.32,1:16:23.71,Default,,0,0,0,,Сүт ішпесең, дұрыс ата-ана, бала бола алмайсың.
Dialogue: 0,1:16:30.00,1:16:31.47,Default,,0,0,0,,А, сіз дұрыс емес адамсыз.
Dialogue: 0,1:16:34.40,1:16:35.99,Default,,0,0,0,,Сіз әлі алысқа кеткен жоқсыз.
Dialogue: 0,1:16:36.76,1:16:38.75,Default,,0,0,0,,Бірақ мен оны таба алмаймын.
Dialogue: 0,1:16:38.76,1:16:41.22,Default,,0,0,0,,Киёко менімен бірге жүруі дұрыс па?
Dialogue: 0,1:16:54.48,1:16:55.62,Default,,0,0,0,,Киоко.
Dialogue: 0,1:17:03.12,1:17:04.91,Default,,0,0,0,,Ақылсыз болған дұрыс па, Хана?
Dialogue: 0,1:17:04.92,1:17:07.15,Default,,0,0,0,,Қашанға дейін бұлай бейқам болуды қоясың?
Dialogue: 0,1:17:07.80,1:17:08.75,Default,,0,0,0,,Мұнда
Dialogue: 0,1:17:22.92,1:17:27.07,Default,,0,0,0,,Ұрыны қайтару үшін жолдан шығып кеткеніңіз қандай жақсы.
Dialogue: 0,1:17:27.08,1:17:29.15,Default,,0,0,0,,Жанұяның өз-өзіне қол жұмсауына кім жол берді?
Dialogue: 0,1:17:29.16,1:17:30.55,Default,,0,0,0,,Сен қария емессің бе?
Dialogue: 0,1:17:36.64,1:17:37.27,Default,,0,0,0,,Қандай
Dialogue: 0,1:17:37.28,1:17:37.83,Default,,0,0,0,,Сол жақта
Dialogue: 0,1:17:37.84,1:17:38.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:17:38.80,1:17:39.91,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:17:40.32,1:17:41.83,Default,,0,0,0,,Менің ойымша, сіз құмар ойындарға жақсы емессіз.
Dialogue: 0,1:17:41.84,1:17:43.91,Default,,0,0,0,,Жауап беретін сөзім жоқ.
Dialogue: 0,1:17:43.92,1:17:45.71,Default,,0,0,0,,Маған біреу көмектес
Dialogue: 0,1:17:59.48,1:18:00.83,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,1:18:01.24,1:18:02.35,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:18:02.36,1:18:04.19,Default,,0,0,0,,Ұры ұры
Dialogue: 0,1:18:04.20,1:18:05.07,Default,,0,0,0,,Не болды?
Dialogue: 0,1:18:05.08,1:18:08.35,Default,,0,0,0,,Менің жүк көлігімнің үстінен бір әйел келді.
Dialogue: 0,1:18:09.24,1:18:10.71,Default,,0,0,0,,Бұл ұры
Dialogue: 0,1:18:10.72,1:18:12.59,Default,,0,0,0,,Иә, ол әйел ұры.
Dialogue: 0,1:18:13.24,1:18:16.11,Default,,0,0,0,,Бұл бала ұры.
Dialogue: 0,1:18:30.60,1:18:33.99,Default,,0,0,0,,Тыныш болшы, жақсы қыз бол.
Dialogue: 0,1:18:42.36,1:18:44.63,Default,,0,0,0,,Салыстырылған Киоконы қайтарыңыз
Dialogue: 0,1:18:49.12,1:18:51.03,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,1:18:51.04,1:18:53.11,Default,,0,0,0,,Рахмет саған өмір бойы қарыздармын.
Dialogue: 0,1:18:58.24,1:18:59.03,Default,,0,0,0,,Джин-чан
Dialogue: 0,1:19:00.92,1:19:03.15,Default,,0,0,0,,Жоқ, ол әйел мүлде ақылсыз.
Dialogue: 0,1:19:03.60,1:19:04.67,Default,,0,0,0,,Жақын кел
Dialogue: 0,1:19:04.68,1:19:05.63,Default,,0,0,0,,Бұл ақылға қонымсыз.
Dialogue: 0,1:19:05.64,1:19:08.02,Default,,0,0,0,,Киёкоға не болатыны маған бәрібір.
Dialogue: 0,1:19:08.04,1:19:08.99,Default,,0,0,0,,Киёко деген кім?
Dialogue: 0,1:19:09.00,1:19:10.03,Default,,0,0,0,,Адам Аксель
Dialogue: 0,1:19:10.04,1:19:10.91,Default,,0,0,0,,Иә
Dialogue: 0,1:19:16.04,1:19:18.42,Default,,0,0,0,,Тыныш отырыңыз.
Dialogue: 0,1:19:22.32,1:19:23.11,Default,,0,0,0,,Джин мырза
Dialogue: 0,1:19:23.12,1:19:23.99,Default,,0,0,0,,Қария
Dialogue: 0,1:19:27.44,1:19:28.43,Default,,0,0,0,,Қария
Dialogue: 0,1:19:28.44,1:19:32.19,Default,,0,0,0,,Сәттілік, Джин Чан, экшн фильміндегі басты кейіпкер ретінде сәттілік.
Dialogue: 0,1:19:32.20,1:19:33.79,Default,,0,0,0,,Озып озу және алға шығу.
Dialogue: 0,1:19:33.80,1:19:34.79,Default,,0,0,0,,Сен өлесің.
Dialogue: 0,1:19:34.80,1:19:35.67,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,1:19:35.68,1:19:37.43,Default,,0,0,0,,Иә
Dialogue: 0,1:19:39.20,1:19:40.55,Default,,0,0,0,,Жылама
Dialogue: 0,1:19:41.64,1:19:44.51,Default,,0,0,0,,Жарайды, мен сені енді ешқашан жібермеймін.
Dialogue: 0,1:19:45.32,1:19:46.39,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,1:19:55.60,1:19:57.19,Default,,0,0,0,,Джин-чан
Dialogue: 0,1:20:09.44,1:20:10.91,Default,,0,0,0,,Джин-чан
Dialogue: 0,1:20:13.44,1:20:14.43,Default,,0,0,0,,Сол жерде
Dialogue: 0,1:20:16.08,1:20:16.99,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:20:17.00,1:20:17.79,Default,,0,0,0,,Киёко ше?
Dialogue: 0,1:20:18.48,1:20:19.35,Default,,0,0,0,,Иә
Dialogue: 0,1:20:39.08,1:20:39.75,Default,,0,0,0,,Қайсысы?
Dialogue: 0,1:21:27.04,1:21:28.87,Default,,0,0,0,,Қайталап айтайын
Dialogue: 0,1:21:28.88,1:21:33.51,Default,,0,0,0,,Бұдан бұрын мен сізге Шинагава Уордында жүк көлігі ғимаратпен соқтығысқан жол апаты туралы айтқан болатынмын.
Dialogue: 0,1:21:33.52,1:21:37.63,Default,,0,0,0,,Енді сол ғимараттың төбесінде сәбиін ұстаған әйел пайда болды.
Dialogue: 0,1:21:38.20,1:21:43.19,Default,,0,0,0,,Куәгерлердің айтуынша, апатқа ұшыраған жүк көлігін сәбиі бар әйел басқарған.
Dialogue: 0,1:21:43.20,1:21:45.27,Default,,0,0,0,,Жазатайым оқиғаға қатысты сияқты
Dialogue: 0,1:21:51.56,1:21:54.59,Default,,0,0,0,,Енді тағы бір адам пайда болды. Сіз оны көре аласыз ба?
Dialogue: 0,1:21:59.20,1:22:00.19,Default,,0,0,0,,Келме
Dialogue: 0,1:22:00.20,1:22:02.55,Default,,0,0,0,,No
Dialogue: 0,1:22:09.36,1:22:11.95,Default,,0,0,0,,Айтшы, сен неге баланы ұрладың?
Dialogue: 0,1:22:11.96,1:22:12.71,Default,,0,0,0,,Жоқ
Dialogue: 0,1:22:12.72,1:22:15.43,Default,,0,0,0,,Бұл бала менің балам, менің нағыз балам.
Dialogue: 0,1:22:15.44,1:22:19.19,Default,,0,0,0,,Бұл өтірік. Баласының қамын ойлап, күтіп жүрген нағыз ата-ана бар.
Dialogue: 0,1:22:19.20,1:22:20.47,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,1:22:20.48,1:22:24.59,Default,,0,0,0,,Балаңыз кеткенде қандай сезімде болатынын білесіз.
Dialogue: 0,1:22:36.08,1:22:41.35,Default,,0,0,0,,Ол қайтыс болды... Менің балам тумай жатып қайтыс болды.
Dialogue: 0,1:22:48.72,1:22:52.63,Default,,0,0,0,,Қалған нәрестелердің барлығы жаңа туған нәрестелер бөлмесінде жақсы жұмыс істейді.
Dialogue: 0,1:22:52.64,1:22:54.87,Default,,0,0,0,,Оны көргенде өлгім келмеді.
Dialogue: 0,1:22:55.28,1:22:58.11,Default,,0,0,0,,Бірақ бұл қыз маған қарап күлді.
Dialogue: 0,1:22:58.12,1:23:00.35,Default,,0,0,0,,Менің балам деп ойладым
Dialogue: 0,1:23:00.36,1:23:04.51,Default,,0,0,0,,Осы бала менде болғанша, бәрі жақсы болатынына сенімдімін.
Dialogue: 0,1:23:04.52,1:23:08.40,Default,,0,0,0,,Ол адам сауығып, бәріміз нағыз отбасы бола аламыз.
Dialogue: 0,1:23:08.40,1:23:09.99,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,1:23:10.60,1:23:16.03,Default,,0,0,0,,Балаңыздың өмірін босқа өткізсеңіз, отбасының не керегі бар? Өлетін болсаң жалғыз өлуің керек.
Dialogue: 0,1:23:16.04,1:23:20.91,Default,,0,0,0,,Бір өмір екі рет тумайды, сен де, мен де, Киёко да.
Dialogue: 0,1:23:26.44,1:23:28.51,Default,,0,0,0,,Қайтарыңыз, солай ма?
Dialogue: 0,1:23:35.80,1:23:37.43,Default,,0,0,0,,Мен қайта туылғым келеді
Dialogue: 0,1:23:38.56,1:23:40.79,Default,,0,0,0,,Өлген болса да, оның мәйіті табылмағаны таңқаларлық.
Dialogue: 0,1:23:42.08,1:23:45.07,Default,,0,0,0,,Сачико, өлме, қайтып кел.
Dialogue: 0,1:23:45.08,1:23:49.07,Default,,0,0,0,,Менің кінәм болды, өлмеші.
Dialogue: 0,1:23:49.52,1:23:52.08,Default,,0,0,0,,Қайта туып, қайталап көрейік
Dialogue: 0,1:23:52.52,1:23:54.19,Default,,0,0,0,,Өлген болса да, оның мәйіті табылмағаны таңқаларлық.
Dialogue: 0,1:23:54.20,1:23:56.79,Default,,0,0,0,,Мен алға барып күтемін.
Dialogue: 0,1:24:01.40,1:24:02.59,Default,,0,0,0,,Өлген болса да, оның мәйіті табылмағаны таңқаларлық.
Dialogue: 0,1:24:04.60,1:24:06.47,Default,,0,0,0,,Маған өлуге рұқсат етіңізші
Dialogue: 0,1:24:06.48,1:24:09.55,Default,,0,0,0,,Киёко әкесі мен анасын көргісі келеді.
Dialogue: 0,1:24:15.48,1:24:16.91,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,1:24:20.24,1:24:22.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:24:30.24,1:24:31.19,Default,,0,0,0,,Бұл бала
Dialogue: 0,1:24:31.72,1:24:34.43,Default,,0,0,0,,Әке мен шешенің орнына
Dialogue: 0,1:24:43.88,1:24:44.43,Default,,0,0,0,,Өтірік...
Dialogue: 0,1:24:45.52,1:24:46.99,Default,,0,0,0,,Хана
Dialogue: 0,1:24:48.64,1:24:49.51,Default,,0,0,0,,Жарайды
Dialogue: 0,1:24:50.24,1:24:51.83,Default,,0,0,0,,Әлі тірі
Dialogue: 0,1:25:32.28,1:25:36.55,Default,,0,0,0,,Инспектор, мен сізге қалай алғыс айтамын?
Dialogue: 0,1:25:36.56,1:25:40.31,Default,,0,0,0,,Жоқ, біз алғыс айтып жатқан жоқпыз.
Dialogue: 0,1:25:42.44,1:25:47.56,Default,,0,0,0,,А, сен жақсы ұйықтадың. Маған темекі әкелші, Миюки.
Dialogue: 0,1:25:47.56,1:25:49.07,Default,,0,0,0,,Бұл күртешенің қалтасы.
Dialogue: 0,1:25:49.08,1:25:49.95,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:25:49.96,1:25:53.31,Default,,0,0,0,,Бұл өте қиын Жаңа жыл кеші болды.
Dialogue: 0,1:25:54.08,1:25:55.95,Default,,0,0,0,,Бұл жерде темекі шегуге болмайды.
Dialogue: 0,1:25:55.96,1:25:59.27,Default,,0,0,0,,Қатты болма, мен батырмын.
Dialogue: 0,1:25:59.28,1:26:01.19,Default,,0,0,0,,Бұл біз болуымыз керек.
Dialogue: 0,1:26:04.96,1:26:10.31,Default,,0,0,0,,Ертеңнен бастап Киёконың қатты айқайы тоқтамайды.
Dialogue: 0,1:26:10.32,1:26:12.70,Default,,0,0,0,,Ол енді Киёко емес.
Dialogue: 0,1:26:12.72,1:26:14.83,Default,,0,0,0,,Маған қандай да бір себептермен ұнамайды.
Dialogue: 0,1:26:15.96,1:26:17.55,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:26:18.04,1:26:19.36,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,1:26:20.20,1:26:22.43,Default,,0,0,0,,Бұл адамның аурухана бөлмесі емес.
Dialogue: 0,1:26:25.12,1:26:26.91,Default,,0,0,0,,Бұл дөрекі ме?
Dialogue: 0,1:26:26.92,1:26:28.91,Default,,0,0,0,,Жоқ, жай ғана
Dialogue: 0,1:26:29.72,1:26:32.23,Default,,0,0,0,,Мен олардың үйсіз жүргенін естідім.
Dialogue: 0,1:26:32.24,1:26:33.67,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:26:33.68,1:26:36.59,Default,,0,0,0,,Мен сенің осы баланың құдасы болғаныңды қалаймын.
Dialogue: 0,1:26:38.36,1:26:39.11,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:26:40.60,1:26:41.59,Default,,0,0,0,,Ол таяққа тиді
Dialogue: 0,1:26:42.36,1:26:45.59,Default,,0,0,0,,Сәбидің ата-анасы сәлем айтқысы келеді.
Dialogue: 0,1:26:51.52,1:26:52.87,Default,,0,0,0,,Әкем…
Dialogue: 0,1:27:32.36,1:27:39.03,Default,,0,0,0,,Маған қамшы түскен ұнамайды.
Dialogue: 0,1:27:39.16,1:27:45.79,Default,,0,0,0,,Тозақ болмаса, жұмақ та жоқ
Dialogue: 0,1:27:46.00,1:27:52.44,Default,,0,0,0,,Буланып кеткім келеді, бұл дүние қараңғы
Dialogue: 0,1:27:52.44,1:27:59.31,Default,,0,0,0,,Бірақ жасырынатын жері адамға толы
Dialogue: 0,1:28:10.04,1:28:16.71,Default,,0,0,0,,Ымырт қайғылы және жиіркенішті.
Dialogue: 0,1:28:16.92,1:28:23.47,Default,,0,0,0,,Мен бәрібір өмір сүретін болсам, бұл түн жақсырақ
Dialogue: 0,1:28:23.72,1:28:30.11,Default,,0,0,0,,Маған ертең керек емес, болашақ керек емес
Dialogue: 0,1:28:30.12,1:28:37.23,Default,,0,0,0,,Бірақ ақшадан құтыла алсаңыз, бұл жақсы.
Dialogue: 0,1:29:11.76,1:29:18.39,Default,,0,0,0,,Әрбір қоқыстың өлетін жері бар.
Dialogue: 0,1:29:18.60,1:29:25.27,Default,,0,0,0,,Қоқыстың тұратын жері бар.
Dialogue: 0,1:29:25.40,1:29:31.87,Default,,0,0,0,,Бұл аспанның астында нантока болғаны дұрыс
Dialogue: 0,1:29:31.88,1:29:39.11,Default,,0,0,0,,Бірақ мен ұмыта алмайтыным – оргазмым
Dialogue: 0,1:29:39.16,1:29:45.50,Default,,0,0,0,,Сен екеуміз бөтенміз.
Dialogue: 0,1:29:45.64,1:29:52.75,Default,,0,0,0,,Кариб теңізінде бір стақан ром ішейік
Dialogue: 0,1:30:40.84,1:30:47.23,Default,,0,0,0,,Сен екеуміз бөтенміз.
Dialogue: 0,1:30:47.36,1:30:54.47,Default,,0,0,0,,Кариб теңізінде бір стақан ром ішейік
Dialogue: 0,1:30:54.72,1:31:00.87,Default,,0,0,0,,Менің ойымша, біз бәріміз бір шаңырақтың астындамыз.
Dialogue: 0,1:31:01.00,1:31:08.11,Default,,0,0,0,,Жүр, Кариб аралында темекі шегейік.
Dialogue: 0,1:31:09.61,1:31:14.61,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
