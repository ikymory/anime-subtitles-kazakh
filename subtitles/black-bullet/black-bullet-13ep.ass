Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.12,0:00:06.17,Default,,0,0,0,,Біздің ең үлкен және соңғы қаруымыз
Dialogue: 0,0:00:06.75,0:00:11.13,Default,,0,0,0,,Соңғы шайқастың өтетін орны – «Оралу жалыны»
Dialogue: 0,0:00:12.09,0:00:13.30,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:00:13.38,0:00:17.30,Default,,0,0,0,,Уақытты құру үшін мен бұл әлемді құтқару дұрыс деп ойлаймын.
Dialogue: 0,0:00:17.76,0:00:20.14,Default,,0,0,0,,Біз әлемді тірі қалдыруымыз керек
Dialogue: 0,0:00:22.35,0:00:24.48,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:00:24.56,0:00:27.61,Default,,0,0,0,,Бұл Рентаро Сатомидің соңы.
Dialogue: 0,0:00:27.69,0:00:29.94,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:00:30.03,0:00:36.20,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.73,0:01:59.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:11.08,0:02:13.63,Default,,0,0,0,,Гастрияның жоспарланған келуіне 10 минут қалды.
Dialogue: 0,0:02:13.80,0:02:15.59,Default,,0,0,0,,Неліктен батарея келмей жатыр?
Dialogue: 0,0:02:16.05,0:02:19.13,Default,,0,0,0,,Көру диапазонында асқазан жоқ.
Dialogue: 0,0:02:19.22,0:02:21.55,Default,,0,0,0,,Сенің көзің пайдалы сияқты.
Dialogue: 0,0:02:21.64,0:02:23.10,Default,,0,0,0,,Үкі жасырын
Dialogue: 0,0:02:23.51,0:02:25.43,Default,,0,0,0,,Алайда Ұлттық полиция
Dialogue: 0,0:02:25.52,0:02:27.85,Default,,0,0,0,,Менде ондай қабілет жоқ.
Dialogue: 0,0:02:28.27,0:02:31.23,Default,,0,0,0,,Өзін-өзі қорғау күштерінен ешқандай байланыс болған жоқ.
Dialogue: 0,0:02:31.31,0:02:35.02,Default,,0,0,0,,Егер сіз оны қазір алмаған болсаңыз, мен оның аяғына жетпейтінін ғана болжауға болады.
Dialogue: 0,0:02:38.65,0:02:40.61,Default,,0,0,0,,Гастреяның әскері орманнан өтті.
Dialogue: 0,0:02:41.03,0:02:42.82,Default,,0,0,0,,Ол тура сізге келеді.
Dialogue: 0,0:02:43.41,0:02:45.58,Default,,0,0,0,,Сатоми-кун, егер бұл жалғаса берсе...
Dialogue: 0,0:02:45.95,0:02:48.20,Default,,0,0,0,,Жаудың шабуылына ұшырап, ажал құшасың ба?
Dialogue: 0,0:02:48.29,0:02:49.12,Default,,0,0,0,,Әлде…
Dialogue: 0,0:02:49.21,0:02:51.08,Default,,0,0,0,,Біз асығыс кіріп, құрып кетеміз бе?
Dialogue: 0,0:02:51.42,0:02:54.59,Default,,0,0,0,,5 минуттан кейін боламыз.
Dialogue: 0,0:02:57.88,0:02:59.09,Default,,0,0,0,,Барлық мүшелер ақылы!
Dialogue: 0,0:02:59.17,0:03:00.09,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:03:01.47,0:03:02.84,Default,,0,0,0,,Бұл!
Dialogue: 0,0:03:07.60,0:03:10.44,Default,,0,0,0,,Не? Бұл жарық
Dialogue: 0,0:03:12.40,0:03:15.36,Default,,0,0,0,,Бұл Генан фестивалі
Dialogue: 0,0:03:15.98,0:03:20.03,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:03:20.57,0:03:22.53,Default,,0,0,0,,Сатоми мырза, бұл менмін.
Dialogue: 0,0:03:22.61,0:03:23.95,Default,,0,0,0,,Қасиетті періште!
Dialogue: 0,0:03:25.28,0:03:27.95,Default,,0,0,0,,Түсіндім, сен...
Dialogue: 0,0:03:33.96,0:03:37.50,Default,,0,0,0,,Сатоми мырза, осы шамдардың әрқайсысы...
Dialogue: 0,0:03:37.59,0:03:40.97,Default,,0,0,0,,Токио аймағы тұрғындарының үміттері мен дұғалары
Dialogue: 0,0:03:41.05,0:03:44.01,Default,,0,0,0,,Және өмір сүруге деген құштарлық.
Dialogue: 0,0:03:44.47,0:03:48.06,Default,,0,0,0,,Токио аймағының болашағын сізге сеніп тапсырамыз
Dialogue: 0,0:03:49.77,0:03:51.06,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:03:51.35,0:03:55.31,Default,,0,0,0,,Ешқашан шайқаста берілмеңіз және жеңіске жету үшін батыл болыңыз
Dialogue: 0,0:03:56.48,0:03:58.15,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:04:00.03,0:04:00.86,Default,,0,0,0,,Энжу
Dialogue: 0,0:04:02.45,0:04:05.70,Default,,0,0,0,,Адамдардың екі беті бар шығар.
Dialogue: 0,0:04:05.78,0:04:07.33,Default,,0,0,0,,Жарық пен қараңғылық
Dialogue: 0,0:04:07.91,0:04:09.62,Default,,0,0,0,,Бұл жарықтың беті
Dialogue: 0,0:04:10.66,0:04:15.29,Default,,0,0,0,,Осы нұрдың әрбір бөлігінде жатқан дұғалар мен үміттерді көре алсаңыз.
Dialogue: 0,0:04:16.38,0:04:17.54,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,0:04:18.13,0:04:19.63,Default,,0,0,0,,Біз барлығына көмектесуіміз керек
Dialogue: 0,0:04:20.05,0:04:21.05,Default,,0,0,0,,Иә
Dialogue: 0,0:04:22.05,0:04:22.88,Default,,0,0,0,,Келеді!
Dialogue: 0,0:04:23.34,0:04:25.76,Default,,0,0,0,,Гастреяның әскері, тылда Альдебаран
Dialogue: 0,0:04:25.84,0:04:28.51,Default,,0,0,0,,(Альдебаранның шайқас айқайы)
Dialogue: 0,0:04:28.93,0:04:32.52,Default,,0,0,0,,Rapier Thrust операциясы қазір басталады!
Dialogue: 0,0:04:32.60,0:04:35.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:51.45,0:04:53.33,Default,,0,0,0,,(Альдебаранның шайқас айқайы)
Dialogue: 0,0:04:54.04,0:04:56.83,Default,,0,0,0,,Жарайды, операция екінші кезеңге өтеді.
Dialogue: 0,0:04:57.29,0:04:59.09,Default,,0,0,0,,Барлық мүшелер, шабуылға өтіңіз!
Dialogue: 0,0:04:59.50,0:05:00.34,Default,,0,0,0,,Тина!
Dialogue: 0,0:05:00.80,0:05:02.71,Default,,0,0,0,,Шабуылға қолдау көрсету
Dialogue: 0,0:05:03.30,0:05:04.42,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:07.47,0:05:09.89,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:10.35,0:05:13.27,Default,,0,0,0,,Алып Gastrea сізге тікелей зарядтауда!
Dialogue: 0,0:05:15.48,0:05:16.48,Default,,0,0,0,,Уф
Dialogue: 0,0:05:16.89,0:05:17.94,Default,,0,0,0,,Құт
Dialogue: 0,0:05:23.99,0:05:25.36,Default,,0,0,0,,Жүгір, Сатоми-кун!
Dialogue: 0,0:05:33.66,0:05:34.50,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:05:37.33,0:05:38.33,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:39.38,0:05:40.92,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:05:41.00,0:05:42.92,Default,,0,0,0,,Ха! Таа!
Dialogue: 0,0:05:43.55,0:05:44.42,Default,,0,0,0,,Иә
Dialogue: 0,0:05:44.92,0:05:46.34,Default,,0,0,0,,(Гастреаның шайқас айқайы)
Dialogue: 0,0:05:47.26,0:05:48.34,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:48.72,0:05:50.05,Default,,0,0,0,,Тендо стиліндегі ұрыс техникасы
Dialogue: 0,0:05:50.89,0:05:52.35,Default,,0,0,0,,Жалын желдеткіші
Dialogue: 0,0:05:56.73,0:05:58.23,Default,,0,0,0,,Бұл жаман... Уф
Dialogue: 0,0:05:59.19,0:06:01.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:01.90,0:06:06.07,Default,,0,0,0,,Бұл өлім, бұл соғыс
Dialogue: 0,0:06:07.15,0:06:08.61,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:09.28,0:06:10.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:12.58,0:06:15.62,Default,,0,0,0,,...
Dialogue: 0,0:06:15.70,0:06:17.08,Default,,0,0,0,,Көшбасшы Сатоми!
Dialogue: 0,0:06:18.08,0:06:19.33,Default,,0,0,0,,Сатоми (Рентаро) Га
Dialogue: 0,0:06:19.96,0:06:20.96,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:06:24.80,0:06:26.76,Default,,0,0,0,,100
Dialogue: 0,0:06:27.26,0:06:28.26,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:06:28.84,0:06:30.18,Default,,0,0,0,,Кеттік, Енджу!
Dialogue: 0,0:06:34.35,0:06:36.06,Default,,0,0,0,,Енді жауларды жойыңыз
Dialogue: 0,0:06:37.85,0:06:39.77,Default,,0,0,0,,Тория!
Dialogue: 0,0:06:43.73,0:06:46.28,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:06:46.86,0:06:48.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:56.49,0:06:57.87,Default,,0,0,0,,Қазір...
Dialogue: 0,0:06:57.95,0:06:59.21,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:07:00.79,0:07:01.62,Default,,0,0,0,,Рентаро!
Dialogue: 0,0:07:07.67,0:07:10.43,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:07:25.23,0:07:27.23,Default,,0,0,0,,EP бомба жинағы аяқталды
Dialogue: 0,0:07:27.86,0:07:29.36,Default,,0,0,0,,1 минуттан кейін жарылады
Dialogue: 0,0:07:30.28,0:07:32.45,Default,,0,0,0,,үшін, дереу кетіңдер!
Dialogue: 0,0:07:36.49,0:07:37.91,Default,,0,0,0,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:07:38.83,0:07:44.75,Default,,0,0,0,,５ ４ ３ ２ １…
Dialogue: 0,0:07:46.46,0:07:47.46,Default,,0,0,0,,Га
Dialogue: 0,0:07:48.00,0:07:50.42,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:51.01,0:07:53.05,Default,,0,0,0,,А... мүмкін емес!
Dialogue: 0,0:07:54.01,0:07:56.80,Default,,0,0,0,,Мисори қатесі ме?
Dialogue: 0,0:08:03.06,0:08:05.19,Default,,0,0,0,,Рентаро...
Dialogue: 0,0:08:07.36,0:08:09.57,Default,,0,0,0,,Кешіріңіз, Сатоми-чан
Dialogue: 0,0:08:11.32,0:08:12.32,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:13.20,0:08:15.36,Default,,0,0,0,,Бір ғана жол бар
Dialogue: 0,0:08:16.12,0:08:17.20,Default,,0,0,0,,Энжу
Dialogue: 0,0:08:17.78,0:08:18.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.70,0:08:20.54,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:08:20.62,0:08:22.96,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:08:23.83,0:08:25.00,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:08:25.50,0:08:28.46,Default,,0,0,0,,...
Dialogue: 0,0:08:29.80,0:08:33.76,Default,,0,0,0,,Мен сені кездестіргеннен бері өткен жылы бақытты болдым.
Dialogue: 0,0:08:35.30,0:08:39.22,Default,,0,0,0,,...
Dialogue: 0,0:08:43.48,0:08:44.89,Default,,0,0,0,,Кеттік... (соққы дыбысы)
Dialogue: 0,0:08:55.36,0:08:57.91,Default,,0,0,0,,Егер сіз оған тікелей әсер етсеңіз...
Dialogue: 0,0:08:57.99,0:09:00.24,Default,,0,0,0,,EP бомбалары жарылуы керек
Dialogue: 0,0:09:01.37,0:09:02.50,Default,,0,0,0,,Сатоми…
Dialogue: 0,0:09:03.00,0:09:04.00,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:09:05.12,0:09:06.71,Default,,0,0,0,,Нөлдік қашықтықта!
Dialogue: 0,0:09:11.92,0:09:14.13,Default,,0,0,0,,Рентаро...
Dialogue: 0,0:09:14.59,0:09:17.76,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:09:24.27,0:09:25.98,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:09:26.64,0:09:27.98,Default,,0,0,0,,Балан эрозиялық сұйықтығы
Dialogue: 0,0:09:28.48,0:09:30.52,Default,,0,0,0,,Сонымен... міне, солай!
Dialogue: 0,0:09:31.07,0:09:32.61,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:09:34.07,0:09:37.41,Default,,0,0,0,,Уф... Қарғыс атсын.
Dialogue: 0,0:09:38.07,0:09:41.91,Default,,0,0,0,,Альдебаран жақын жерде...
Dialogue: 0,0:09:43.33,0:09:44.33,Default,,0,0,0,,Уф
Dialogue: 0,0:09:45.91,0:09:46.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:50.71,0:09:53.42,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:09:54.42,0:09:57.68,Default,,0,0,0,,Сатоми, сен көп жұмыс жасадың.
Dialogue: 0,0:09:58.68,0:10:00.18,Default,,0,0,0,,Шома-нии...
Dialogue: 0,0:10:00.60,0:10:01.72,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:01.80,0:10:04.18,Default,,0,0,0,,Мен жағдайды түсінемін.
Dialogue: 0,0:10:05.02,0:10:05.89,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:10:05.98,0:10:10.19,Default,,0,0,0,,Оның денесінің тереңінде...
Dialogue: 0,0:10:10.27,0:10:12.44,Default,,0,0,0,,Егер сіз соққы бермесеңіз...
Dialogue: 0,0:10:14.73,0:10:19.03,Default,,0,0,0,,...
Dialogue: 0,0:10:19.53,0:10:22.16,Default,,0,0,0,,Жоқ, Шома-нии...
Dialogue: 0,0:10:24.58,0:10:26.95,Default,,0,0,0,,Жоқ! Мен өлемін!
Dialogue: 0,0:10:27.04,0:10:29.42,Default,,0,0,0,,Менің техникам – гейдо техникасы
Dialogue: 0,0:10:29.71,0:10:33.50,Default,,0,0,0,,Бұл техника Канаваның шетінде тығыздалуы керек.
Dialogue: 0,0:10:33.79,0:10:36.34,Default,,0,0,0,,Сол Альдебаранмен
Dialogue: 0,0:10:39.09,0:10:42.72,Default,,0,0,0,,Сатоми... өтінемін, мен үшін де өмір сүр.
Dialogue: 0,0:10:43.10,0:10:44.06,Default,,0,0,0,,Шома-нии!
Dialogue: 0,0:10:49.06,0:10:52.27,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:10:56.19,0:10:57.53,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:17.80,0:11:19.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.72,0:11:22.13,Default,,0,0,0,,Энжу…
Dialogue: 0,0:11:26.26,0:11:27.68,Default,,0,0,0,,Уф
Dialogue: 0,0:11:32.48,0:11:33.73,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:11:39.90,0:11:43.86,Default,,0,0,0,,Акима-нии, Альдебаранмен...
Dialogue: 0,0:11:44.12,0:11:47.33,Default,,0,0,0,,Иә, мен Тинаның бәрін көргенін естідім.
Dialogue: 0,0:11:47.79,0:11:49.50,Default,,0,0,0,,Гастреяның қалған бөлігі ше?
Dialogue: 0,0:11:50.08,0:11:53.67,Default,,0,0,0,,Альдебаран жарылған кезде қозғалыс біртүрлі болды.
Dialogue: 0,0:11:53.92,0:11:57.13,Default,,0,0,0,,Жеңілу оңай болды, өйткені ол бір-бірінен ажыратылған түрде әрекет ете бастады.
Dialogue: 0,0:11:57.71,0:12:00.59,Default,,0,0,0,,Олардың көпшілігі монолиттен тыс қашып шықты.
Dialogue: 0,0:12:04.05,0:12:05.55,Default,,0,0,0,,Сатоми-кун
Dialogue: 0,0:12:06.26,0:12:07.60,Default,,0,0,0,,Аға
Dialogue: 0,0:12:07.68,0:12:09.10,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:13.10,0:12:15.94,Default,,0,0,0,,Мұның бәрі...?
Dialogue: 0,0:12:17.15,0:12:19.69,Default,,0,0,0,,Дәл осы...
Dialogue: 0,0:12:36.63,0:12:39.00,Default,,0,0,0,,Кантоның үшінші шайқасы...
Dialogue: 0,0:12:39.09,0:12:43.01,Default,,0,0,0,,IV гастреа кезеңі Альдебаранның жойылуымен-
Dialogue: 0,0:12:43.42,0:12:45.55,Default,,0,0,0,,Адамдар жеңді.
Dialogue: 0,0:12:51.72,0:12:54.64,Default,,0,0,0,,Канто шайқасындағы жеңіске екі күн өтті...
Dialogue: 0,0:12:54.73,0:12:59.65,Default,,0,0,0,,№32 жаңа монолиттің құрылысы бірқалыпты жүріп жатқан сияқты.
Dialogue: 0,0:13:00.02,0:13:02.69,Default,,0,0,0,,Биіктігі 300 метрден асады...
Dialogue: 0,0:13:02.78,0:13:04.24,Default,,0,0,0,,Маңайдағы Гастреяға...
Dialogue: 0,0:13:04.49,0:13:07.49,Default,,0,0,0,,Оның айтарлықтай әсері бар деп бағаланады.
Dialogue: 0,0:13:12.54,0:13:15.25,Default,,0,0,0,,Біз келдік, Вако мырза.
Dialogue: 0,0:13:20.88,0:13:23.63,Default,,0,0,0,,Қош келдіңіз Вако аға
Dialogue: 0,0:13:23.80,0:13:24.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:24.97,0:13:27.93,Default,,0,0,0,,Сізді Жер, инфрақұрылым, көлік және туризм министрінің орынбасары деп атағаныңыз дұрыс болар еді.
Dialogue: 0,0:13:28.01,0:13:29.01,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:13:29.51,0:13:31.10,Default,,0,0,0,,Кисара...
Dialogue: 0,0:13:33.31,0:13:35.89,Default,,0,0,0,,Балаңызды сонда әкелесіз бе, Рентаро?
Dialogue: 0,0:13:36.64,0:13:38.27,Default,,0,0,0,,Не уәде етілген?
Dialogue: 0,0:13:46.57,0:13:48.91,Default,,0,0,0,,Ей, мен бәрін жоюым керек еді!
Dialogue: 0,0:13:49.53,0:13:52.99,Default,,0,0,0,,Мен әрқашан ойланып келемін
Dialogue: 0,0:13:53.54,0:13:57.54,Default,,0,0,0,,Неліктен Альдебаран монолитке жабысты?
Dialogue: 0,0:13:58.58,0:14:00.92,Default,,0,0,0,,Гастрея соғысының соңында салынған
Dialogue: 0,0:14:01.00,0:14:05.17,Default,,0,0,0,,№32 монолитке тапсырыс беруге жауапты болған адам...
Dialogue: 0,0:14:06.09,0:14:07.93,Default,,0,0,0,,Бұл Ваконың ағасы емес пе?
Dialogue: 0,0:14:08.30,0:14:09.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:09.93,0:14:13.72,Default,,0,0,0,,Баланды араластырып, арзан монолит...
Dialogue: 0,0:14:13.81,0:14:17.23,Default,,0,0,0,,Жоғалған шығындарды қалтаға салу маған ұнамайды.
Dialogue: 0,0:14:17.31,0:14:19.94,Default,,0,0,0,,Теориялық тұрғыдан, тіпті бұл тазалық жақсы болды!
Dialogue: 0,0:14:20.69,0:14:23.19,Default,,0,0,0,,Бірақ бұл Альдебаранда жұмыс істемеді.
Dialogue: 0,0:14:23.52,0:14:24.48,Default,,0,0,0,,Уф
Dialogue: 0,0:14:24.82,0:14:29.86,Default,,0,0,0,,Тапқан ақшаңызбен сіз қазіргі лауазымыңызға ие болдыңыз.
Dialogue: 0,0:14:30.11,0:14:34.24,Default,,0,0,0,,Сіз Кантодағы Үшінші шайқастың триггерін басқан адамсыз.
Dialogue: 0,0:14:34.58,0:14:39.12,Default,,0,0,0,,Сіз сияқты адам қоқысы Гастрея соғысында өлуі керек еді.
Dialogue: 0,0:14:39.25,0:14:40.79,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:14:40.88,0:14:43.09,Default,,0,0,0,,Нағыз жауыздар ешқашан өлмейді!
Dialogue: 0,0:14:43.17,0:14:44.55,Default,,0,0,0,,Ақшаны айналаға таратыңыз
Dialogue: 0,0:14:44.63,0:14:48.01,Default,,0,0,0,,Өлім жинағанша қашып кетуге болады!
Dialogue: 0,0:14:49.93,0:14:52.76,Default,,0,0,0,,Екі тараптың да куәгер алдында
Dialogue: 0,0:14:54.47,0:14:56.81,Default,,0,0,0,,Мен Казуми Шиинамын.
Dialogue: 0,0:14:56.89,0:14:59.94,Default,,0,0,0,,Осы дуэльдің куәгері...
Dialogue: 0,0:15:00.02,0:15:02.86,Default,,0,0,0,,Осы жерде біреуіміз өлтірілсе де...
Dialogue: 0,0:15:02.94,0:15:07.53,Default,,0,0,0,,Осы арқылы мен полицияға немесе басқа сот органына шағым бермеуге ант етемін.
Dialogue: 0,0:15:07.90,0:15:09.36,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:15:09.45,0:15:11.82,Default,,0,0,0,,Біз бұл шайқаста шынымен күресуіміз керек пе?
Dialogue: 0,0:15:12.16,0:15:13.28,Default,,0,0,0,,Рентаро
Dialogue: 0,0:15:13.37,0:15:16.95,Default,,0,0,0,,Енді мына әйелдің аузын жабу керек.
Dialogue: 0,0:15:17.37,0:15:20.87,Default,,0,0,0,,Сатоми-кун, мен 10 жыл күттім.
Dialogue: 0,0:15:21.29,0:15:24.42,Default,,0,0,0,,Әке мен шешенің жауларының бірі
Dialogue: 0,0:15:25.21,0:15:27.13,Default,,0,0,0,,Мен оны ақыры бұрыштан қағып алдым.
Dialogue: 0,0:15:27.76,0:15:31.22,Default,,0,0,0,,Бұл кісімен соғысу тағдырдың тәлкегімен жазылған.
Dialogue: 0,0:15:33.22,0:15:34.26,Default,,0,0,0,,(Норияки Какёин) Әрине, бұл Абдул мен Польнареффтің тобы емес шығар?
Dialogue: 0,0:15:34.80,0:15:38.77,Default,,0,0,0,,Tendo Shikigami Spear Джуцу Кайден Тендо Вако
Dialogue: 0,0:15:39.22,0:15:43.27,Default,,0,0,0,,Тендо стилі Баттожуцу Кайден Тендо Кисара
Dialogue: 0,0:16:03.33,0:16:04.54,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:16:05.13,0:16:05.96,Default,,0,0,0,,Ах
Dialogue: 0,0:16:08.50,0:16:09.76,Default,,0,0,0,,Бұл қандай түр?
Dialogue: 0,0:16:09.84,0:16:13.34,Default,,0,0,0,,Тендо стилі Баттожуцу Рюко Сугеки
Dialogue: 0,0:16:14.26,0:16:18.47,Default,,0,0,0,,Бұл мен барлық Тендоны көму үшін ойлап тапқан үлгі.
Dialogue: 0,0:16:18.81,0:16:20.06,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:16:20.31,0:16:22.48,Default,,0,0,0,,Тианци Сюаньмин Фосс!
Dialogue: 0,0:16:24.19,0:16:25.31,Default,,0,0,0,,Ах... (Қисара) Ха!
Dialogue: 0,0:16:32.74,0:16:35.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:37.70,0:16:41.25,Default,,0,0,0,,Тендо стилі Баттожуцу Zero no Katō Sanban
Dialogue: 0,0:16:41.33,0:16:42.96,Default,,0,0,0,,Авей зұлым қос басты қылыш
Dialogue: 0,0:16:43.75,0:16:46.75,Default,,0,0,0,,Ағамды өлтірген техника осылай аталады.
Dialogue: 0,0:16:47.21,0:16:50.21,Default,,0,0,0,,Сонымен... бұл нөлдің бір түрі?
Dialogue: 0,0:16:51.13,0:16:53.34,Default,,0,0,0,,Бір соққы, екі соққы
Dialogue: 0,0:16:53.51,0:16:56.51,Default,,0,0,0,,Екінші ату жылдамдығы дыбыс жылдамдығынан асып түседі
Dialogue: 0,0:16:56.64,0:16:57.93,Default,,0,0,0,,Сіздің ағаңызға
Dialogue: 0,0:16:58.01,0:17:01.97,Default,,0,0,0,,Сол аяғымды кесіп алған екінші оқты көре алмадым.
Dialogue: 0,0:17:03.06,0:17:05.98,Default,,0,0,0,,Қане, аға, сөйлесіңізші.
Dialogue: 0,0:17:06.65,0:17:11.23,Default,,0,0,0,,10 жыл бұрын әке-шешемді өлтірген шабуыл туралы.
Dialogue: 0,0:17:11.86,0:17:13.86,Default,,0,0,0,,Токио облысының орталығында
Dialogue: 0,0:17:13.94,0:17:17.66,Default,,0,0,0,,Қалай ойлайсыз, адасып кеткен Gastrea пайда болуы мүмкін бе?
Dialogue: 0,0:17:17.74,0:17:18.99,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:17:20.37,0:17:21.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:21.37,0:17:24.58,Default,,0,0,0,,Ке... Жоспарға бес адам тартылды.
Dialogue: 0,0:17:24.66,0:17:29.29,Default,,0,0,0,,Мен, үш ағам және Тендо Кикуноджо
Dialogue: 0,0:17:29.50,0:17:32.13,Default,,0,0,0,,Балалар, неге олай жасадыңдар?
Dialogue: 0,0:17:33.46,0:17:37.43,Default,,0,0,0,,Әкесі Тендоны қараңғылықта айыптамақ болды.
Dialogue: 0,0:17:37.89,0:17:38.93,Default,,0,0,0,,Қараңғылық?
Dialogue: 0,0:17:39.18,0:17:41.56,Default,,0,0,0,,үшін қазір сияқты
Dialogue: 0,0:17:41.64,0:17:43.97,Default,,0,0,0,,Тендо отбасы өзінің қазіргі жағдайына қалай жетті
Dialogue: 0,0:17:44.06,0:17:46.98,Default,,0,0,0,,Осыған ұқсас заттар көп.
Dialogue: 0,0:17:47.06,0:17:51.32,Default,,0,0,0,,Әкесі кенет оны жария етпекші болды...
Dialogue: 0,0:17:51.73,0:17:55.07,Default,,0,0,0,,Сонымен, сендер де...
Dialogue: 0,0:17:56.90,0:17:58.03,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:58.11,0:18:00.49,Default,,0,0,0,,Маған... көмектесе аласыз ба?
Dialogue: 0,0:18:01.41,0:18:05.20,Default,,0,0,0,,Сатоми-кун, Енджу-чан, Тина-чан, кеттік.
Dialogue: 0,0:18:05.29,0:18:08.33,Default,,0,0,0,,Ах... ой-а!
Dialogue: 0,0:18:09.29,0:18:12.34,Default,,0,0,0,,Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін
Dialogue: 0,0:18:13.34,0:18:16.72,Default,,0,0,0,,Рахмет, рахмет, рахмет...
Dialogue: 0,0:18:16.80,0:18:18.22,Default,,0,0,0,,Сатоми-кун
Dialogue: 0,0:18:18.30,0:18:20.39,Default,,0,0,0,,Шулы, сондықтан есікті тартыңыз.
Dialogue: 0,0:18:20.47,0:18:21.30,Default,,0,0,0,,О
Dialogue: 0,0:18:22.93,0:18:24.97,Default,,0,0,0,,Кисара мырза, бұл шынымен...
Dialogue: 0,0:18:25.06,0:18:26.81,Default,,0,0,0,,Бір соққы, содан кейін екі
Dialogue: 0,0:18:27.81,0:18:32.19,Default,,0,0,0,,Сатоми-кун, екінші ату тек аяққа арналған емес.
Dialogue: 0,0:18:32.77,0:18:33.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.44,0:18:38.11,Default,,0,0,0,,Ах... уау!
Dialogue: 0,0:18:38.40,0:18:40.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:42.28,0:18:43.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:47.91,0:18:49.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:49.92,0:18:51.17,Default,,0,0,0,,Құт
Dialogue: 0,0:18:51.25,0:18:52.38,Default,,0,0,0,,Рентаро?
Dialogue: 0,0:18:52.46,0:18:53.63,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,0:18:56.09,0:18:58.38,Default,,0,0,0,,Қарама (Тина Енджу) Ах.
Dialogue: 0,0:18:59.17,0:19:00.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.89,0:19:04.85,Default,,0,0,0,,Сатоми-кун, мен мұны істедім.
Dialogue: 0,0:19:04.93,0:19:08.31,Default,,0,0,0,,Мен әкемнің бір жауын өлтірдім!
Dialogue: 0,0:19:08.39,0:19:09.69,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:19:15.23,0:19:19.11,Default,,0,0,0,,Не болды? Сатоми-кун, бақытты емессің бе?
Dialogue: 0,0:19:19.19,0:19:21.99,Default,,0,0,0,,Бұл біздің кек алуымыз емес.
Dialogue: 0,0:19:22.53,0:19:24.32,Default,,0,0,0,,Сіздің орындауыңыз!
Dialogue: 0,0:19:25.08,0:19:27.58,Default,,0,0,0,,Вако-нисанды не үшін өлтірдің?
Dialogue: 0,0:19:28.12,0:19:31.12,Default,,0,0,0,,Сіз мұны жасамас бұрын білдіңіз!
Dialogue: 0,0:19:31.67,0:19:35.25,Default,,0,0,0,,Кисара мырза, бұл жерде әділдік қайда!
Dialogue: 0,0:19:37.21,0:19:40.38,Default,,0,0,0,,Сатоми-кун, мен жаңа ғана байқадым.
Dialogue: 0,0:19:40.72,0:19:45.14,Default,,0,0,0,,Сатоми-кун сонымен қатар Кагетан оқиғасының ұйымдастырушысы, Тендо Кикуноджо.
Dialogue: 0,0:19:45.22,0:19:49.47,Default,,0,0,0,,Мерген оқиғасындағы Сайбу Согенді соттау мүмкін болмады.
Dialogue: 0,0:19:49.81,0:19:53.56,Default,,0,0,0,,Бірақ мен Кадзуко Тендоға төрелік ете алдым.
Dialogue: 0,0:19:54.98,0:19:56.61,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:19:58.44,0:20:01.36,Default,,0,0,0,,Бұл менің «зұлым» болғандықтан
Dialogue: 0,0:20:03.28,0:20:07.12,Default,,0,0,0,,Сатоми-кунның әділдік жұдырығы зұлымдыққа жете алмайды.
Dialogue: 0,0:20:07.62,0:20:10.91,Default,,0,0,0,,Зұлымдыққа қарсы тұра алатын әділдік емес.
Dialogue: 0,0:20:11.00,0:20:14.37,Default,,0,0,0,,Зұлымдықтан асып түсетін «Абсолютті зұлымдық».
Dialogue: 0,0:20:14.92,0:20:17.54,Default,,0,0,0,,Менде ондай күш бар
Dialogue: 0,0:20:17.96,0:20:19.88,Default,,0,0,0,,Енді мен сенімдімін
Dialogue: 0,0:20:25.55,0:20:28.10,Default,,0,0,0,,Тина Енджу…
Dialogue: 0,0:20:30.06,0:20:34.19,Default,,0,0,0,,Мен Кисара-санның жауы болып қалуым мүмкін.
Dialogue: 0,0:20:38.73,0:20:41.28,Default,,0,0,0,,Осы ұлттық дағдарыстан аман қалған бізге...
Dialogue: 0,0:20:41.36,0:20:44.24,Default,,0,0,0,,Татуласуға тағы бір мүмкіндік келді.
Dialogue: 0,0:20:44.95,0:20:47.66,Default,,0,0,0,,Жаңа Gastrea заңын қабылдау...
Dialogue: 0,0:20:47.74,0:20:49.33,Default,,0,0,0,,Осы шайқаста қаза тапты.
Dialogue: 0,0:20:49.41,0:20:52.37,Default,,0,0,0,,Бұл көптеген адамдар үшін реквием болады деп ойлаймын.
Dialogue: 0,0:20:53.62,0:20:55.12,Default,,0,0,0,,Біз қазір-
Dialogue: 0,0:20:55.37,0:20:58.59,Default,,0,0,0,,Қалыпты балалар, тіпті қартаймаған қыздарға...
Dialogue: 0,0:20:58.67,0:21:01.59,Default,,0,0,0,,...
Dialogue: 0,0:21:02.63,0:21:04.13,Default,,0,0,0,,Енді, одан басқа...
Dialogue: 0,0:21:04.22,0:21:06.76,Default,,0,0,0,,...
Dialogue: 0,0:21:07.05,0:21:07.89,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:21:08.43,0:21:12.64,Default,,0,0,0,,...
Dialogue: 0,0:21:12.72,0:21:15.39,Default,,0,0,0,,Жоқ, біз сенімдімін
Dialogue: 0,0:21:15.81,0:21:17.19,Default,,0,0,0,,Күнді жасаңыз!
Dialogue: 0,0:21:17.27,0:21:22.28,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:21:24.44,0:21:26.49,Default,,0,0,0,,Инвестициялау рәсімі?
Dialogue: 0,0:21:26.57,0:21:29.66,Default,,0,0,0,,...
Dialogue: 0,0:21:30.41,0:21:32.74,Default,,0,0,0,,Ол бізді тойлап жатқанын айтты.
Dialogue: 0,0:21:32.87,0:21:35.62,Default,,0,0,0,,Жарайды ма? Бұл киіммен
Dialogue: 0,0:21:35.71,0:21:36.83,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:21:37.33,0:21:38.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:39.33,0:21:40.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:40.50,0:21:43.63,Default,,0,0,0,,Бұл Рентаро үшін!
Dialogue: 0,0:21:44.59,0:21:45.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:46.05,0:21:47.68,Default,,0,0,0,,«Ант»?
Dialogue: 0,0:21:48.14,0:21:51.81,Default,,0,0,0,,“１ １ ”
Dialogue: 0,0:21:51.89,0:21:54.43,Default,,0,0,0,,«2. Біз бәрін бірге жасаймыз».
Dialogue: 0,0:21:54.52,0:21:58.44,Default,,0,0,0,,“３  ”
Dialogue: 0,0:21:58.69,0:21:59.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:00.52,0:22:01.94,Default,,0,0,0,,“４…” （）
Dialogue: 0,0:22:02.02,0:22:03.07,Default,,0,0,0,,О
Dialogue: 0,0:22:06.19,0:22:07.78,Default,,0,0,0,,3-ші бөлім станциясының үй-жайында -
Dialogue: 0,0:22:07.86,0:22:09.70,Default,,0,0,0,,Жеке жазатайым оқиға орын алды
Dialogue: 0,0:22:09.78,0:22:11.53,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:22:12.41,0:22:13.62,Default,,0,0,0,,Я...
Dialogue: 0,0:22:13.70,0:22:15.50,Default,,0,0,0,,Сіз кешігіп қалдыңыз деп ойлаймын.
Dialogue: 0,0:22:16.71,0:22:18.33,Default,,0,0,0,,Бұл ауырды ма?
Dialogue: 0,0:22:22.38,0:22:24.38,Default,,0,0,0,,Бұл мәселе болды ма?
Dialogue: 0,0:22:24.76,0:22:28.26,Default,,0,0,0,,―
Dialogue: 0,0:22:28.38,0:22:29.30,Default,,0,0,0,,Болмады ма?
Dialogue: 0,0:22:32.64,0:22:35.81,Default,,0,0,0,,Ах... Сәлем, Рентаро
Dialogue: 0,0:22:38.35,0:22:39.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:41.44,0:22:44.98,Default,,0,0,0,,А... не болды? Рентаро
Dialogue: 0,0:22:46.23,0:22:47.82,Default,,0,0,0,,Басқа адамның өлімі -
Dialogue: 0,0:22:47.90,0:22:50.41,Default,,0,0,0,,Мен өзім сал болып қалудан қорқамын
Dialogue: 0,0:22:50.99,0:22:52.20,Default,,0,0,0,,Энжу
Dialogue: 0,0:22:52.62,0:22:54.53,Default,,0,0,0,,Мәңгі қасымда болшы
Dialogue: 0,0:22:55.37,0:22:57.00,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:23:03.29,0:23:05.71,Default,,0,0,0,,Жарайды, Рентаро.
Dialogue: 0,0:23:06.09,0:23:11.30,Default,,0,0,0,,...
Dialogue: 0,0:23:12.80,0:23:18.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
