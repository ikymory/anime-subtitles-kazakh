Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.43,0:00:18.26,Default,,0,0,0,,Не? Онымен кездескіңіз келе ме?
Dialogue: 0,0:00:19.26,0:00:20.06,Default,,0,0,0,,О
Dialogue: 0,0:00:20.77,0:00:22.64,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:00:22.77,0:00:25.44,Default,,0,0,0,,Сізбен кездесудің қызық ештеңесі жоқ.
Dialogue: 0,0:00:25.56,0:00:27.52,Default,,0,0,0,,Дұрыс, дұрыс, ысырапшылдық.
Dialogue: 0,0:00:27.65,0:00:29.40,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:00:30.36,0:00:32.28,Default,,0,0,0,,Мен олардың осында жүргенін естідім.
Dialogue: 0,0:00:33.11,0:00:34.07,Default,,0,0,0,,Адам әлеміне түсу
Dialogue: 0,0:00:34.20,0:00:37.78,Default,,0,0,0,,Қызық істермен айналысқан өлім құдайы бар.
Dialogue: 0,0:01:17.95,0:01:19.16,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:01:19.28,0:01:21.83,Default,,0,0,0,,Ол сені көруге келді.
Dialogue: 0,0:01:21.95,0:01:24.12,Default,,0,0,0,,Мен сіздің әңгімеңізді тыңдағым келеді.
Dialogue: 0,0:01:24.25,0:01:25.04,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:01:25.16,0:01:27.37,Default,,0,0,0,,Тегін деп айтпаңыз
Dialogue: 0,0:01:33.30,0:01:34.71,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:34.84,0:01:39.30,Default,,0,0,0,,Мүмкін болса, мен сәл шырындырақ нәрсені ұнататын едім.
Dialogue: 0,0:01:40.80,0:01:43.01,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:01:43.14,0:01:45.06,Default,,0,0,0,,Мен төменгі әлемге түсуім керек.
Dialogue: 0,0:01:45.18,0:01:48.27,Default,,0,0,0,,Шаршадым мына сұм дүниеден
Dialogue: 0,0:01:48.39,0:01:51.65,Default,,0,0,0,,Адам әлемі қызық деп естідім.
Dialogue: 0,0:01:56.65,0:02:00.87,Default,,0,0,0,,Адамдардың қызықсыз дүние туралы шағымдануын көру қызықсыз.
Dialogue: 0,0:02:00.99,0:02:04.33,Default,,0,0,0,,Егер сіз әлемді өзгерту сияқты ақымақ нәрсені ойласаңыз.
Dialogue: 0,0:02:04.45,0:02:06.91,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:02:09.58,0:02:14.21,Default,,0,0,0,,Жарайды, мен жай ғана жалықтым, мен сенімен сөйлесемін.
Dialogue: 0,0:02:15.76,0:02:18.38,Default,,0,0,0,,Рингоның арқасында бәрі жақсы емес.
Dialogue: 0,0:02:18.51,0:02:21.76,Default,,0,0,0,,Иә, мен әлемді өзгертуге тырыстым⸺
Dialogue: 0,0:02:21.89,0:02:25.93,Default,,0,0,0,,Бұл құдай болуға талпынған адамның оқиғасы.
Dialogue: 0,0:02:32.11,0:02:34.52,Default,,0,0,0,,Мұны біреу істеу керек
Dialogue: 0,0:02:35.15,0:02:37.69,Default,,0,0,0,,Біз бұлай жүре алмаймыз!
Dialogue: 0,0:02:39.07,0:02:42.66,Default,,0,0,0,,Бір нәрсені күнде қайталау
Dialogue: 0,0:02:43.32,0:02:45.12,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:02:45.24,0:02:48.54,Default,,0,0,0,,Олардың бәрі өлсе, әлем үшін жақсы болатын адамдар.
Dialogue: 0,0:02:48.66,0:02:52.13,Default,,0,0,0,,Иә, дүние шірік.
Dialogue: 0,0:02:52.92,0:02:55.13,Default,,0,0,0,,Шірігендердің өлгені жақсы.
Dialogue: 0,0:02:56.34,0:02:59.26,Default,,0,0,0,,Өлім жазбасымен жасайық
Dialogue: 0,0:03:00.26,0:03:01.89,Default,,0,0,0,,Мен әлемді өзгертемін!
Dialogue: 0,0:03:03.51,0:03:06.35,Default,,0,0,0,,Мен өз қылмысына лайық зұлым адамдарды жоямын!
Dialogue: 0,0:03:06.47,0:03:09.48,Default,,0,0,0,,Иә, бұл жерді тазарту!
Dialogue: 0,0:03:10.14,0:03:13.77,Default,,0,0,0,,Зорлық-зомбылық жасаған адамдар жүрек жеткіліксіздігінен бірінен соң бірі өледі.
Dialogue: 0,0:03:15.02,0:03:16.11,Default,,0,0,0,,Адам қаншалықты ақымақ, зұлым болса да
Dialogue: 0,0:03:16.23,0:03:18.36,Default,,0,0,0,,Оны біреу өшіргенін байқайсыз.
Dialogue: 0,0:03:18.48,0:03:20.45,Default,,0,0,0,,Білсін әлем
Dialogue: 0,0:03:20.57,0:03:22.11,Default,,0,0,0,,Менің қатысуым!
Dialogue: 0,0:03:23.24,0:03:24.95,Default,,0,0,0,,Жамандықты қайтаратын күш!
Dialogue: 0,0:03:27.08,0:03:29.75,Default,,0,0,0,,Бұл әділдік!
Dialogue: 0,0:03:44.64,0:03:45.93,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:46.05,0:03:48.85,Default,,0,0,0,,Әлем сөзсіз жақсы бағытта қозғалады.
Dialogue: 0,0:03:49.68,0:03:51.81,Default,,0,0,0,,Мен мойындадым⸺
Dialogue: 0,0:03:51.94,0:03:55.94,Default,,0,0,0,,Тек байсалды, ақкөңіл адамдарға ғана дүние жасау
Dialogue: 0,0:03:56.81,0:03:58.11,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:04:00.53,0:04:02.53,Default,,0,0,0,,Жаңа әлемнің құдайы бол!
Dialogue: 0,0:04:18.00,0:04:21.97,Default,,0,0,0,,(ағылшын тілін оқитын мұғалімнің дауысы)
Dialogue: 0,0:04:22.09,0:04:24.26,Default,,0,0,0,,Шынайы ма? Сіз оны көрдіңіз бе?
Dialogue: 0,0:04:24.38,0:04:27.60,Default,,0,0,0,,Уақытты босқа кетіру. Мен ақшамды қайтаруым керек сияқты.
Dialogue: 0,0:04:27.72,0:04:29.18,Default,,0,0,0,,Жарайды, мен де көрдім.
Dialogue: 0,0:05:04.42,0:05:08.39,Default,,0,0,0,,«Өлім туралы жазба» сөзбе-сөз аударғанда «Өлім туралы жазба»
Dialogue: 0,0:05:08.51,0:05:09.89,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.60,0:05:13.35,Default,,0,0,0,,«Қалай пайдалану керек»
Dialogue: 0,0:05:13.93,0:05:19.11,Default,,0,0,0,,«Осы дәптерге аты жазылған адам өледі»?
Dialogue: 0,0:05:19.23,0:05:20.31,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.07,0:05:22.78,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:05:23.40,0:05:26.11,Default,,0,0,0,,Сіз мүлде ауырып қалдыңыз.
Dialogue: 0,0:05:26.24,0:05:30.12,Default,,0,0,0,,Бәле хаттан бері ілгерілеген жоқпын.
Dialogue: 0,0:05:30.70,0:05:33.62,Default,,0,0,0,,«Аты жазылған адам өледі» деген не?
Dialogue: 0,0:05:43.05,0:05:46.47,Default,,0,0,0,,Менде де ештеңе жоқ.
Dialogue: 0,0:06:15.12,0:06:16.95,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:22.46,0:06:23.34,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:06:23.46,0:06:25.55,Default,,0,0,0,,Бұл ерте болды, солай емес пе?
Dialogue: 0,0:06:25.67,0:06:26.46,Default,,0,0,0,,О
Dialogue: 0,0:06:27.42,0:06:30.38,Default,,0,0,0,,Анам дәл қазір... Иә?
Dialogue: 0,0:06:32.30,0:06:35.18,Default,,0,0,0,,Ах, ұлттық сынақ емтиханының нәтижелері.
Dialogue: 0,0:06:35.31,0:06:36.64,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:06:37.48,0:06:38.64,Default,,0,0,0,,Иә
Dialogue: 0,0:06:38.77,0:06:41.19,Default,,0,0,0,,О, тағы да 1 орын!
Dialogue: 0,0:06:41.31,0:06:43.23,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасадың, Ай
Dialogue: 0,0:06:43.36,0:06:47.19,Default,,0,0,0,,Олай болса мен сабаққа барамын, маған кедергі жасама.
Dialogue: 0,0:06:47.32,0:06:48.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:06:48.53,0:06:51.74,Default,,0,0,0,,Әй, ай, бірдеңе қалайды ма?
Dialogue: 0,0:06:51.86,0:06:53.49,Default,,0,0,0,,Кез келген нәрсені айтыңыз
Dialogue: 0,0:06:53.62,0:06:56.08,Default,,0,0,0,,Шынымен емес, анашым.
Dialogue: 0,0:06:58.79,0:07:00.87,Default,,0,0,0,,Мен қалағанымды алдым
Dialogue: 0,0:07:05.09,0:07:06.71,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:06.84,0:07:10.72,Default,,0,0,0,,Хэхе... хехе...
Dialogue: 0,0:07:11.26,0:07:13.97,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:07:14.10,0:07:17.06,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:07:17.18,0:07:19.93,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:07:20.06,0:07:22.15,Default,,0,0,0,,Саған ұнайтын сияқты (Ай) А...
Dialogue: 0,0:07:22.27,0:07:23.69,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:07:23.81,0:07:24.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:24.81,0:07:27.11,Default,,0,0,0,,Уаааааааааааааааааааа
Dialogue: 0,0:07:29.44,0:07:31.95,Default,,0,0,0,,Неге сонша таң қалдыңыз?
Dialogue: 0,0:07:32.07,0:07:36.16,Default,,0,0,0,,Жазбаны түсірген адам - ​​өлім құдайы Рюк.
Dialogue: 0,0:07:36.28,0:07:37.58,Default,,0,0,0,,Дәл қазір көрінгендей
Dialogue: 0,0:07:38.45,0:07:41.66,Default,,0,0,0,,Сіз бұл енді жай дәптер емес екенін білесіз бе?
Dialogue: 0,0:07:48.25,0:07:49.76,Default,,0,0,0,,Шинигами?
Dialogue: 0,0:07:53.84,0:07:56.18,Default,,0,0,0,,Мен Рюкке таң қалған жоқпын
Dialogue: 0,0:07:57.14,0:07:58.01,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:58.89,0:08:01.18,Default,,0,0,0,,Мен сені күттім, Рюк.
Dialogue: 0,0:08:01.31,0:08:03.02,Default,,0,0,0,,Хо…
Dialogue: 0,0:08:03.14,0:08:08.73,Default,,0,0,0,,Мен Грим Реапердің дәптерінің шынайы екеніне күмәнданбадым.
Dialogue: 0,0:08:08.86,0:08:10.82,Default,,0,0,0,,Осылайша, әртүрлі нәрселерге тікелей қарсы тұру арқылы,
Dialogue: 0,0:08:10.94,0:08:13.99,Default,,0,0,0,,Өзіңізге сенімділікпен әрекет етіңіз
Dialogue: 0,0:08:14.66,0:08:18.37,Default,,0,0,0,,Сен мені таң қалдырдың.
Dialogue: 0,0:08:19.08,0:08:22.46,Default,,0,0,0,,Бұрын адам әлемінде Өлім кітабы туралы әңгіме болған.
Dialogue: 0,0:08:22.58,0:08:24.83,Default,,0,0,0,,Мен мұны бірнеше рет естідім.
Dialogue: 0,0:08:25.67,0:08:29.38,Default,,0,0,0,,Сіз небәрі бес күн ішінде мұны жасаған бірінші адамсыз.
Dialogue: 0,0:08:29.50,0:08:31.59,Default,,0,0,0,,Егер мен орташа болсам, соншалықты жазуға қорқатын едім.
Dialogue: 0,0:08:32.55,0:08:34.76,Default,,0,0,0,,Мен дайынмын, Рюк.
Dialogue: 0,0:08:34.88,0:08:38.10,Default,,0,0,0,,Мен Grim Reaper дәптерін білдім және пайдаландым.
Dialogue: 0,0:08:38.22,0:08:39.60,Default,,0,0,0,,Сосын Қасқыр келді.
Dialogue: 0,0:08:40.51,0:08:43.89,Default,,0,0,0,,Маған не болады? Менің жаным алынады ма?
Dialogue: 0,0:08:44.02,0:08:46.65,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:08:46.77,0:08:48.94,Default,,0,0,0,,Адамдар жасаған ерікті бейне ме?
Dialogue: 0,0:08:50.07,0:08:52.15,Default,,0,0,0,,Мен саған ештеңе істемеймін
Dialogue: 0,0:08:52.28,0:08:53.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.65,0:08:56.03,Default,,0,0,0,,Адам әлеміне келгеннен кейін
Dialogue: 0,0:08:56.16,0:08:58.24,Default,,0,0,0,,Дәптер адам дүниесінің затына айналады.
Dialogue: 0,0:08:58.37,0:09:02.29,Default,,0,0,0,,Енді ол сенікі.
Dialogue: 0,0:09:02.41,0:09:04.75,Default,,0,0,0,,Менің… заттарым…
Dialogue: 0,0:09:04.87,0:09:07.46,Default,,0,0,0,,Керек болмаса, басқаға бер.
Dialogue: 0,0:09:07.58,0:09:10.38,Default,,0,0,0,,Сол кезде Өлім туралы жазба туралы тек есіңізде қалғаны
Dialogue: 0,0:09:10.50,0:09:12.13,Default,,0,0,0,,Оны жоюға рұқсат етіңіз
Dialogue: 0,0:09:12.26,0:09:15.51,Default,,0,0,0,,Сонымен Өлім жазбасын пайдаланудың нақты бағасы қандай?
Dialogue: 0,0:09:15.63,0:09:16.76,Default,,0,0,0,,Ештеңе жоқ, солай ма?
Dialogue: 0,0:09:16.88,0:09:19.18,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:09:19.30,0:09:24.06,Default,,0,0,0,,Сол дәптерді пайдаланатын адамға ғана келетін уайым мен қорқыныш
Dialogue: 0,0:09:25.02,0:09:26.85,Default,,0,0,0,,Ал сен өлгенде
Dialogue: 0,0:09:27.44,0:09:31.65,Default,,0,0,0,,Мен сенің атыңды дәптеріме жазамын.
Dialogue: 0,0:09:32.86,0:09:35.28,Default,,0,0,0,,Өлім жазбасын пайдаланған адам
Dialogue: 0,0:09:35.40,0:09:39.12,Default,,0,0,0,,Мен жәннатқа да, тозаққа да бара алмаймын деп ойлаймын.
Dialogue: 0,0:09:39.87,0:09:41.20,Default,,0,0,0,,Осымен
Dialogue: 0,0:09:41.83,0:09:45.41,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,0:09:45.54,0:09:48.71,Default,,0,0,0,,Өлгеннен кейін қызық болады.
Dialogue: 0,0:09:50.92,0:09:54.21,Default,,0,0,0,,Өткен аптада мен 52 адамды білемін.
Dialogue: 0,0:09:54.34,0:09:56.84,Default,,0,0,0,,Мұның бәрі жүрек соғысы.
Dialogue: 0,0:09:56.97,0:09:58.63,Default,,0,0,0,,Өлгені расталмады⸺
Dialogue: 0,0:09:58.76,0:10:00.68,Default,,0,0,0,,Қылмыскерлер де бар шығар.
Dialogue: 0,0:10:00.80,0:10:04.18,Default,,0,0,0,,А... басталып кетті директор.
Dialogue: 0,0:10:04.31,0:10:07.23,Default,,0,0,0,,Әй, мен штабтан естідім.
Dialogue: 0,0:10:07.35,0:10:08.35,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:08.48,0:10:11.61,Default,,0,0,0,,Ірі қылмыскер немесе өлім жазасына кесілген тұтқын болсын, біреуді өлтіру - кісі өлтіру.
Dialogue: 0,0:10:11.73,0:10:14.07,Default,,0,0,0,,Бұл кісі өлтіру екені анықталмаған.
Dialogue: 0,0:10:14.19,0:10:16.99,Default,,0,0,0,,100-ден астам адамның инфаркт болуы кездейсоқтық па?
Dialogue: 0,0:10:17.11,0:10:19.86,Default,,0,0,0,,Өлім себебі инфаркт емес пе?
Dialogue: 0,0:10:19.99,0:10:21.24,Default,,0,0,0,,Ештеңе шықпайды.
Dialogue: 0,0:10:21.37,0:10:22.45,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:10:22.58,0:10:25.20,Default,,0,0,0,,Егер оған пышақ жабысып қалса, оны жуғыңыз келуі мүмкін...
Dialogue: 0,0:10:25.83,0:10:29.17,Default,,0,0,0,,Егер бұл орын алса, менің L-ден мәселені қайтадан шешуін сұраудан басқа амалым қалмайды.
Dialogue: 0,0:10:29.29,0:10:30.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:33.46,0:10:36.30,Default,,0,0,0,,Директор Не? L
Dialogue: 0,0:10:36.42,0:10:39.34,Default,,0,0,0,,Аа, бұл кездесуге бірінші рет қатысып отырсыз.
Dialogue: 0,0:10:40.01,0:10:44.22,Default,,0,0,0,,Ешкім Л-ның атын, оның қайда екенін, тіпті бетін де білмейді.
Dialogue: 0,0:10:44.97,0:10:48.89,Default,,0,0,0,,Дегенмен, іс қанша қиын болса да, әрқашан шешіледі.
Dialogue: 0,0:10:49.02,0:10:51.85,Default,,0,0,0,,Мен әлем бойынша көптеген лабиринттік істерді шештім⸺
Dialogue: 0,0:10:51.98,0:10:55.78,Default,,0,0,0,,Бұл дүниенің көлеңкесінің шыңы, соңғы қозыр
Dialogue: 0,0:10:55.90,0:10:57.74,Default,,0,0,0,,Міне
Dialogue: 0,0:10:57.86,0:10:59.36,Default,,0,0,0,,Бірақ L
Dialogue: 0,0:10:59.49,0:11:01.82,Default,,0,0,0,,Мен тек мені қызықтыратын істермен жұмыс істеймін⸺
Dialogue: 0,0:11:01.95,0:11:03.70,Default,,0,0,0,,Оны менмен деп атайды.
Dialogue: 0,0:11:03.82,0:11:05.16,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:11:05.28,0:11:08.00,Default,,0,0,0,,Біз тіпті сізбен байланыса алмаймыз.
Dialogue: 0,0:11:08.12,0:11:10.12,Default,,0,0,0,,L қазірдің өзінде қозғалуда
Dialogue: 0,0:11:10.25,0:11:11.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.51,0:11:22.39,Default,,0,0,0,,L бұл істі тергеуді бастады.
Dialogue: 0,0:11:22.51,0:11:23.93,Default,,0,0,0,,Ватари
Dialogue: 0,0:11:24.05,0:11:25.76,Default,,0,0,0,,Не, Ватари?
Dialogue: 0,0:11:25.89,0:11:29.02,Default,,0,0,0,,Ол Л-мен байланыса алатын жалғыз адам.
Dialogue: 0,0:11:29.14,0:11:32.14,Default,,0,0,0,,Дегенмен, Ватаридің шынайы тұлғасын ешкім білмейді.
Dialogue: 0,0:11:32.27,0:11:36.44,Default,,0,0,0,,Өтінемін, үндемеңіз, мен қазір Л-ның дауысын естимін.
Dialogue: 0,0:11:40.82,0:11:42.91,Default,,0,0,0,,Құрметті ICPO
Dialogue: 0,0:11:44.82,0:11:45.78,Default,,0,0,0,,Бұл Л.
Dialogue: 0,0:11:50.25,0:11:52.21,Default,,0,0,0,,«Құтқарушы Кира туралы аңыз»
Dialogue: 0,0:11:52.33,0:11:55.42,Default,,0,0,0,,Бұл керемет емес пе? Бұл сен туралы ма?
Dialogue: 0,0:11:55.54,0:11:59.51,Default,,0,0,0,,Аа, өлтіруші дегенді білдіретін өлтіруші сөзінен шыққан сияқты.
Dialogue: 0,0:11:59.63,0:12:01.01,Default,,0,0,0,,Маған бұл аздап ұнамайды.
Dialogue: 0,0:12:01.84,0:12:05.09,Default,,0,0,0,,Мен бүкіл әлем бойынша осы Кира болдым.
Dialogue: 0,0:12:05.22,0:12:09.01,Default,,0,0,0,,«Кира» сөзін іздеңіз, сонда сіз осыған ұқсас көптеген беттерді табасыз.
Dialogue: 0,0:12:10.02,0:12:11.73,Default,,0,0,0,,Әлі де газеттер мен теледидарда
Dialogue: 0,0:12:11.85,0:12:15.77,Default,,0,0,0,,Тек зорлық-зомбылық жасаған қылмыскерлердің оғаш өлімінің сериясы ғана жарияланды.
Dialogue: 0,0:12:15.90,0:12:20.15,Default,,0,0,0,,Бірақ дүние жүзіндегі адамдар мұны қазірдің өзінде сезінуде.
Dialogue: 0,0:12:20.28,0:12:22.70,Default,,0,0,0,,Әділ судьяның болуы
Dialogue: 0,0:12:23.36,0:12:24.45,Default,,0,0,0,,Хо…
Dialogue: 0,0:12:24.57,0:12:26.53,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:12:26.66,0:12:29.87,Default,,0,0,0,,Іс жоспарлағандай жүріп жатыр.
Dialogue: 0,0:12:30.54,0:12:32.29,Default,,0,0,0,,Бұл бағдарламаның ортасында.
Dialogue: 0,0:12:32.41,0:12:37.29,Default,,0,0,0,,ICPO Интерполының арнайы тікелей трансляциясы бүкіл әлем бойынша бір уақытта өткізіледі.
Dialogue: 0,0:12:37.42,0:12:39.42,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:12:39.55,0:12:41.13,Default,,0,0,0,,Интерпол?
Dialogue: 0,0:12:41.26,0:12:42.30,Default,,0,0,0,,бастайық
Dialogue: 0,0:12:43.88,0:12:48.39,Default,,0,0,0,,Мен бүкіл әлемдегі полицияны басқара алатын жалғыз адаммын.
Dialogue: 0,0:12:48.51,0:12:49.56,Default,,0,0,0,,Линд Л. Тейлор
Dialogue: 0,0:12:50.60,0:12:52.85,Default,,0,0,0,,Жалпы аты L.
Dialogue: 0,0:12:52.98,0:12:55.39,Default,,0,0,0,,Не? Бұл жігіт
Dialogue: 0,0:12:56.10,0:12:57.61,Default,,0,0,0,,Ол ақырында басталды.
Dialogue: 0,0:12:59.19,0:13:01.57,Default,,0,0,0,,Қылмыскерлерге бағытталған сериялық кісі өлтіру
Dialogue: 0,0:13:02.32,0:13:06.45,Default,,0,0,0,,Бұл тарихтағы ең ауыр қылмыс, оған ешқашан жол беруге болмайды.
Dialogue: 0,0:13:06.57,0:13:12.16,Default,,0,0,0,,Сондықтан мен Кира деп аталатын бұл қылмысты ұйымдастырушыны міндетті түрде ұстаймын.
Dialogue: 0,0:13:12.29,0:13:15.00,Default,,0,0,0,,Мен сені міндетті түрде ұстаймын
Dialogue: 0,0:13:15.12,0:13:18.42,Default,,0,0,0,,Хмф, ақымақ, ұсталып қалуың мүмкін емес.
Dialogue: 0,0:13:19.13,0:13:20.75,Default,,0,0,0,,Бұл өлім туралы жазба
Dialogue: 0,0:13:20.88,0:13:24.80,Default,,0,0,0,,Осы дәптерді алмасаңыз, ешқандай дәлел қалмайды.
Dialogue: 0,0:13:24.92,0:13:27.64,Default,,0,0,0,,Оны ұстау мүлдем мүмкін емес.
Dialogue: 0,0:13:28.68,0:13:30.93,Default,,0,0,0,,Я, полиция да қозғалып жатыр.
Dialogue: 0,0:13:31.06,0:13:34.10,Default,,0,0,0,,Мұндай нәрсенің шығуы жоспардың бір бөлігі.
Dialogue: 0,0:13:34.23,0:13:36.77,Default,,0,0,0,,Кира, сен қалай ойлайсың?
Dialogue: 0,0:13:36.89,0:13:40.56,Default,,0,0,0,,Мен олардың осылай істеп жатқанын елестете аламын.
Dialogue: 0,0:13:40.69,0:13:43.90,Default,,0,0,0,,Бірақ сенің істеп жатқаның жаман.
Dialogue: 0,0:13:44.03,0:13:44.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:46.11,0:13:48.49,Default,,0,0,0,,Мен зұлыммын ба?
Dialogue: 0,0:13:50.53,0:13:51.70,Default,,0,0,0,,Мен әділдіктімін!
Dialogue: 0,0:13:51.83,0:13:54.08,Default,,0,0,0,,Жамандықтан қорқатын әлсіздерді құтқар
Dialogue: 0,0:13:54.20,0:13:57.37,Default,,0,0,0,,Ол бәрі армандайтын жаңа әлемнің құдайына айналатын адам!
Dialogue: 0,0:13:57.50,0:14:01.17,Default,,0,0,0,,Ал Аллаға қарсы шыққандар зұлым!
Dialogue: 0,0:14:03.67,0:14:05.38,Default,,0,0,0,,Сен тым ақымақсың Л
Dialogue: 0,0:14:05.51,0:14:09.84,Default,,0,0,0,,Егер ол аздап ақылдырақ болса, қызықтырақ болар еді.
Dialogue: 0,0:14:21.48,0:14:24.98,Default,,0,0,0,,А... Хахаха...
Dialogue: 0,0:14:25.11,0:14:27.28,Default,,0,0,0,,Маған бағынбасаң не болады?
Dialogue: 0,0:14:28.45,0:14:31.62,Default,,0,0,0,,Әлем Л
Dialogue: 0,0:14:36.29,0:14:37.45,Default,,0,0,0,,5 секунд қалды
Dialogue: 0,0:14:37.58,0:14:41.96,Default,,0,0,0,,４ ３ ２ １
Dialogue: 0,0:14:43.25,0:14:46.92,Default,,0,0,0,,Уф, а... а, уф!
Dialogue: 0,0:14:50.38,0:14:53.97,Default,,0,0,0,,Хахахаха Ахахаха…
Dialogue: 0,0:14:54.10,0:14:56.47,Default,,0,0,0,,Не болды? Оны қандай да бір жолмен айтуға тырысыңыз!
Dialogue: 0,0:14:57.10,0:15:00.02,Default,,0,0,0,,Ахахахахахахаха…
Dialogue: 0,0:15:00.14,0:15:01.10,Default,,0,0,0,,Ах
Dialogue: 0,0:15:01.81,0:15:04.02,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:15:04.15,0:15:07.40,Default,,0,0,0,,Мен мұны жағдайға дейін қолданып көрдім, бірақ мұндай нәрсе болады деп күткен емеспін...
Dialogue: 0,0:15:08.32,0:15:13.24,Default,,0,0,0,,Кира, сен қолыңды тікелей қолданбай біреуді өлтіре аласың ба?
Dialogue: 0,0:15:14.12,0:15:17.33,Default,,0,0,0,,Мен өз көзіммен көрмейінше сене алмадым.
Dialogue: 0,0:15:18.12,0:15:19.83,Default,,0,0,0,,Мұқият тыңдаңыз Кира
Dialogue: 0,0:15:19.96,0:15:25.17,Default,,0,0,0,,Егер сіз Линд Л. Тейлорды теледидардан өлтірсеңіз.
Dialogue: 0,0:15:25.29,0:15:29.21,Default,,0,0,0,,Бүгін дәл осы сағатта өлім жазасына кесілетін адам.
Dialogue: 0,0:15:29.34,0:15:30.34,Default,,0,0,0,,Мен емес
Dialogue: 0,0:15:30.47,0:15:31.76,Default,,0,0,0,,Не!?
Dialogue: 0,0:15:31.88,0:15:33.76,Default,,0,0,0,,Теледидарда немесе интернетте хабарланбаған⸺
Dialogue: 0,0:15:34.64,0:15:36.81,Default,,0,0,0,,Ол полицияға жасырын түрде ұсталған қылмыскер.
Dialogue: 0,0:15:37.97,0:15:40.48,Default,,0,0,0,,Сіз күткендей бұл қылмыскер туралы ақпаратыңыз бар ма?
Dialogue: 0,0:15:40.60,0:15:42.27,Default,,0,0,0,,Сіз оны алмаған сияқтысыз.
Dialogue: 0,0:15:42.94,0:15:45.94,Default,,0,0,0,,Ха-ха... Сен істедің.
Dialogue: 0,0:15:46.07,0:15:49.44,Default,,0,0,0,,Бірақ мен, L, бармын.
Dialogue: 0,0:15:49.57,0:15:52.15,Default,,0,0,0,,Енді мені өлтіріп көріңіз.
Dialogue: 0,0:15:53.45,0:15:55.20,Default,,0,0,0,,Эйк! Не?!
Dialogue: 0,0:15:55.32,0:15:56.28,Default,,0,0,0,,Менің ұлымның өші—
Dialogue: 0,0:15:56.41,0:15:57.16,Default,,0,0,0,,Бұл не! Бұл керемет болады
Dialogue: 0,0:15:57.16,0:15:58.45,Default,,0,0,0,,Бұл не! Бұл керемет болады
Dialogue: 0,0:15:57.16,0:15:58.45,Default,,0,0,0,,Тез қолданып көріңіз
Dialogue: 0,0:15:58.45,0:15:58.58,Default,,0,0,0,,Бұл не! Бұл керемет болады
Dialogue: 0,0:15:58.58,0:15:59.24,Default,,0,0,0,,Бұл не! Бұл керемет болады
Dialogue: 0,0:15:58.58,0:15:59.24,Default,,0,0,0,,Енді тезірек мені өлтір.
Dialogue: 0,0:15:59.24,0:15:59.37,Default,,0,0,0,,Енді тезірек мені өлтір.
Dialogue: 0,0:15:59.37,0:16:00.62,Default,,0,0,0,,Енді тезірек мені өлтір.
Dialogue: 0,0:15:59.37,0:16:00.62,Default,,0,0,0,,Өлгің келе ме? Л
Dialogue: 0,0:16:00.75,0:16:01.83,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:16:01.83,0:16:02.41,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:16:01.83,0:16:02.41,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:16:02.41,0:16:02.54,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:16:02.54,0:16:03.25,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:16:02.54,0:16:03.25,Default,,0,0,0,,Бұл Кира мен Л.
Dialogue: 0,0:16:03.25,0:16:03.37,Default,,0,0,0,,Бұл Кира мен Л.
Dialogue: 0,0:16:03.37,0:16:03.96,Default,,0,0,0,,Бұл Кира мен Л.
Dialogue: 0,0:16:03.37,0:16:03.96,Default,,0,0,0,,Мені қазір өлтір
Dialogue: 0,0:16:03.96,0:16:04.08,Default,,0,0,0,,Мені қазір өлтір
Dialogue: 0,0:16:04.08,0:16:04.54,Default,,0,0,0,,Мені қазір өлтір
Dialogue: 0,0:16:04.08,0:16:04.54,Default,,0,0,0,,Бұл кісі өлтіру эстафетасы.
Dialogue: 0,0:16:04.54,0:16:04.67,Default,,0,0,0,,Бұл кісі өлтіру эстафетасы.
Dialogue: 0,0:16:04.67,0:16:06.17,Default,,0,0,0,,Бұл кісі өлтіру эстафетасы.
Dialogue: 0,0:16:04.67,0:16:06.17,Default,,0,0,0,,Кел, Кира.
Dialogue: 0,0:16:06.29,0:16:08.21,Default,,0,0,0,,Ал, мені өлтіріп көрші
Dialogue: 0,0:16:09.05,0:16:11.01,Default,,0,0,0,,Не болды? Сіз жасай алмайсыз ба?
Dialogue: 0,0:16:11.13,0:16:12.76,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:13.88,0:16:16.80,Default,,0,0,0,,Мені өлтіру мүмкін емес сияқты.
Dialogue: 0,0:16:16.93,0:16:19.60,Default,,0,0,0,,Кейбір адамдарды өлтіруге болмайды.
Dialogue: 0,0:16:20.14,0:16:21.77,Default,,0,0,0,,Мен жақсы кеңес алдым.
Dialogue: 0,0:16:22.39,0:16:24.23,Default,,0,0,0,,Бір нәрсені қайтару дегенді қалай түсінесіңдер?
Dialogue: 0,0:16:24.35,0:16:26.56,Default,,0,0,0,,Сізге тағы бір нәрсе айтайын.
Dialogue: 0,0:16:26.69,0:16:30.61,Default,,0,0,0,,Бұл хабар бүкіл әлем бойынша бір уақыттағы хабар ретінде белгіленді.
Dialogue: 0,0:16:30.73,0:16:33.78,Default,,0,0,0,,Шын мәнінде, ол тек Жапонияның Канто аймағында ғана таратылады.
Dialogue: 0,0:16:33.90,0:16:34.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:35.11,0:16:37.24,Default,,0,0,0,,Әр ауданға әр уақытта таратылады деп жоспарланған, бірақ
Dialogue: 0,0:16:37.37,0:16:39.83,Default,,0,0,0,,Бұл енді қажет емес.
Dialogue: 0,0:16:39.95,0:16:43.21,Default,,0,0,0,,Сіз қазір Кантодасыз.
Dialogue: 0,0:16:43.33,0:16:45.79,Default,,0,0,0,,Кухаха, олай етпе, L жігіт
Dialogue: 0,0:16:45.92,0:16:48.34,Default,,0,0,0,,Әзірге бәрі менің күткенімдей болды.
Dialogue: 0,0:16:48.46,0:16:50.34,Default,,0,0,0,,Шынымды айтсам, олай ойламадым.
Dialogue: 0,0:16:50.46,0:16:55.47,Default,,0,0,0,,Кира, мен сені асуға жібергеніме көп уақыт өтпейді.
Dialogue: 0,0:16:55.59,0:16:58.76,Default,,0,0,0,,Л күткендей.
Dialogue: 0,0:16:58.89,0:17:02.06,Default,,0,0,0,,Иә, Кираның бар болуы, өлтіру
Dialogue: 0,0:17:02.18,0:17:05.19,Default,,0,0,0,,Тіпті Жапонияда екенін дәлелдеді.
Dialogue: 0,0:17:05.31,0:17:06.85,Default,,0,0,0,,Кира
Dialogue: 0,0:17:06.98,0:17:09.61,Default,,0,0,0,,Сіз кісі өлтіруді қалай жасайсыз?
Dialogue: 0,0:17:09.73,0:17:12.86,Default,,0,0,0,,Мені қатты қызықтырады, бірақ олай емес.
Dialogue: 0,0:17:12.99,0:17:16.07,Default,,0,0,0,,Мен сені ұстаған кезде түсінесің.
Dialogue: 0,0:17:16.86,0:17:20.16,Default,,0,0,0,,Қайта кездескенше Кира
Dialogue: 0,0:17:20.28,0:17:21.08,Default,,0,0,0,,(Реленің дыбысы өшіп жатыр)
Dialogue: 0,0:17:29.59,0:17:31.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:31.59,0:17:34.05,Default,,0,0,0,,Ай Бір сәтке бола ма?
Dialogue: 0,0:17:34.17,0:17:37.89,Default,,0,0,0,,Мен саған сыртта мүмкіндігінше сөйлеспе дедім.
Dialogue: 0,0:17:38.01,0:17:39.26,Default,,0,0,0,,Бас директор
Dialogue: 0,0:17:39.39,0:17:42.22,Default,,0,0,0,,Ендеше, біржақты сөйлесейік.
Dialogue: 0,0:17:42.35,0:17:45.27,Default,,0,0,0,,Ах... Өкінішке орай, солай.
Dialogue: 0,0:17:45.89,0:17:47.48,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:17:48.44,0:17:51.44,Default,,0,0,0,,Сізді үнемі аңдып жүрген біреу бар.
Dialogue: 0,0:18:18.43,0:18:20.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:24.39,0:18:25.35,Default,,0,0,0,,Бұл Л.
Dialogue: 0,0:18:25.47,0:18:27.31,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:18:27.43,0:18:29.81,Default,,0,0,0,,Хмм, менде сурет бар...
Dialogue: 0,0:18:29.94,0:18:31.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:31.40,0:18:32.98,Default,,0,0,0,,Ах
Dialogue: 0,0:18:33.73,0:18:35.40,Default,,0,0,0,,Мен Ұлттық полиция агенттігінен Ягамимін.
Dialogue: 0,0:18:36.15,0:18:38.28,Default,,0,0,0,,Ах... бұл Мацуда. (Айзава) Бұл Айзава.
Dialogue: 0,0:18:38.40,0:18:40.03,Default,,0,0,0,,Бұл Моки (Укута) Бұл Укута.
Dialogue: 0,0:18:41.57,0:18:45.12,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз, бірақ бұл бес адам қазір...
Dialogue: 0,0:18:45.24,0:18:46.50,Default,,0,0,0,,Өрт (бәрі) А?
Dialogue: 0,0:18:46.62,0:18:48.50,Default,,0,0,0,,Не... (Айзава) Қандай еліктеушілік!
Dialogue: 0,0:18:50.50,0:18:54.55,Default,,0,0,0,,Егер мен Кираның орнында болсам, мен өлген болар едім, Соичиро Ягами.
Dialogue: 0,0:18:54.67,0:18:55.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.34,0:18:59.59,Default,,0,0,0,,Кираға кісі өлтіру үшін тек бет-әлпет пен ат қана керек.
Dialogue: 0,0:18:59.72,0:19:02.14,Default,,0,0,0,,Сіз мұны бұрыннан білуіңіз керек.
Dialogue: 0,0:19:02.85,0:19:05.06,Default,,0,0,0,,Өтінемін, аттарды абайсыз айтпаңыз.
Dialogue: 0,0:19:05.68,0:19:09.27,Default,,0,0,0,,Сондай-ақ, сіз маған қоңырау шалғанда, L қолданбаңыз.
Dialogue: 0,0:19:09.39,0:19:11.81,Default,,0,0,0,,Рюзаки, өтінемін.
Dialogue: 0,0:19:11.94,0:19:13.19,Default,,0,0,0,,Сондай-ақ жағдайға байланысты
Dialogue: 0,0:19:14.02,0:19:15.36,Default,,0,0,0,,Қазір кіріңіз.
Dialogue: 0,0:19:25.45,0:19:29.91,Default,,0,0,0,,Теледидар арқылы қоғамдық тергеу жүргізілгеніне бір ай болды.
Dialogue: 0,0:19:30.04,0:19:32.75,Default,,0,0,0,,Осы уақытқа дейін не болғанын анықтайық.
Dialogue: 0,0:19:34.00,0:19:35.96,Default,,0,0,0,,Бірінші 10 желтоқсан
Dialogue: 0,0:19:36.84,0:19:42.72,Default,,0,0,0,,Ел түрмелеріндегі 23 қылмыскер сағат сайын өледі
Dialogue: 0,0:19:45.18,0:19:49.93,Default,,0,0,0,,Студенттер әрекет ете алмайтын күндіз кісі өлтіруге батылы бару арқылы.
Dialogue: 0,0:19:50.06,0:19:52.19,Default,,0,0,0,,Оқушылардың жолын өшіруге тырысты
Dialogue: 0,0:19:53.10,0:19:56.19,Default,,0,0,0,,Бірақ мен үшін бұл
Dialogue: 0,0:19:56.32,0:19:59.78,Default,,0,0,0,,Бұл екі үлкен жаңалыққа әкелді.
Dialogue: 0,0:20:00.65,0:20:05.49,Default,,0,0,0,,Бірі - Кира өлім уақытын еркін басқара алады.
Dialogue: 0,0:20:05.62,0:20:06.66,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:20:06.78,0:20:10.58,Default,,0,0,0,,Кира балаша, жеңілгенді жек көреді.
Dialogue: 0,0:20:12.46,0:20:15.42,Default,,0,0,0,,Иә? Бұл бүгін Өлім жазбасы емес.
Dialogue: 0,0:20:15.54,0:20:17.59,Default,,0,0,0,,Емтихан үлгісі қандай?
Dialogue: 0,0:20:17.71,0:20:20.92,Default,,0,0,0,,Қазір олай оқып жүргенің жақсы емес.
Dialogue: 0,0:20:21.05,0:20:22.76,Default,,0,0,0,,Хмм, сонда ше?
Dialogue: 0,0:20:23.59,0:20:26.80,Default,,0,0,0,,Мәселе осы жерден басталады
Dialogue: 0,0:20:26.93,0:20:29.72,Default,,0,0,0,,Мен есімін білмеймін.
Dialogue: 0,0:20:29.85,0:20:33.94,Default,,0,0,0,,12 ФБР агенттері Кираны тергеу үшін Жапонияға кіреді
Dialogue: 0,0:20:34.56,0:20:36.81,Default,,0,0,0,,Ал басқа күні, 27-сі
Dialogue: 0,0:20:38.27,0:20:39.82,Default,,0,0,0,,Барлығы өлді
Dialogue: 0,0:20:41.19,0:20:43.70,Default,,0,0,0,,Бұл кезде мен көп қозғалдым.
Dialogue: 0,0:20:47.07,0:20:48.41,Default,,0,0,0,,Рэй Пембер
Dialogue: 0,0:20:48.53,0:20:52.00,Default,,0,0,0,,Мен Кирамын, мен саған қарадым.
Dialogue: 0,0:20:52.12,0:20:55.46,Default,,0,0,0,,Егер сіз менің нұсқауларымнан сәл басқаша әрекет етсеңіз.
Dialogue: 0,0:20:55.58,0:20:59.00,Default,,0,0,0,,Мен барлығын, соның ішінде сіздің отбасыңызды да өлтіремін.
Dialogue: 0,0:20:59.13,0:21:00.80,Default,,0,0,0,,Әрине, сіз де
Dialogue: 0,0:21:03.01,0:21:03.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:04.55,0:21:06.68,Default,,0,0,0,,Эй, Сакута. Иә, не болды?
Dialogue: 0,0:21:06.80,0:21:10.18,Default,,0,0,0,,Сіздің бастығыңыз сізге жақын арада файл жібереді.
Dialogue: 0,0:21:10.89,0:21:12.77,Default,,0,0,0,,Жапонияға кірген барлық ФБР агенттері⸺
Dialogue: 0,0:21:12.89,0:21:15.52,Default,,0,0,0,,Бет пен аты бар файл
Dialogue: 0,0:21:16.06,0:21:19.15,Default,,0,0,0,,Әр тергеушінің аты-жөніне мұқият қараңыз.
Dialogue: 0,0:21:19.27,0:21:21.27,Default,,0,0,0,,Конвертті толтырыңыз
Dialogue: 0,0:21:27.78,0:21:28.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:27.78,0:21:28.87,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:21:28.99,0:21:32.04,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:32.16,0:21:36.67,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:43.05,0:21:45.22,Default,,0,0,0,,Қош бол Рэй Пембер
Dialogue: 0,0:21:50.51,0:21:52.26,Default,,0,0,0,,Менің оған сол кезде бергенім
Dialogue: 0,0:21:53.10,0:21:56.14,Default,,0,0,0,,Өлім себебі алдын ала жазылған өлім туралы хат
Dialogue: 0,0:21:56.85,0:22:00.36,Default,,0,0,0,,Рэй Пембер Достарының өліміне себепкер болған
Dialogue: 0,0:22:00.48,0:22:02.23,Default,,0,0,0,,Сіз өзіңіз.
Dialogue: 0,0:22:18.29,0:22:19.62,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:22:20.25,0:22:22.09,Default,,0,0,0,,Кешіріңіз, бірақ сіз менен сұрай аласыз ба?
Dialogue: 0,0:22:22.75,0:22:24.63,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:22:24.76,0:22:26.67,Default,,0,0,0,,Мен сені бірден жіберемін.
Dialogue: 0,0:22:27.55,0:22:30.64,Default,,0,0,0,,Шохиро, өтінемін
Dialogue: 0,0:22:30.76,0:22:33.35,Default,,0,0,0,,Иә? Қазір бастайсыз ба?
Dialogue: 0,0:22:33.47,0:22:36.22,Default,,0,0,0,,Әке, сіз түні бойы киім ауыстырмай отырдыңыз.
Dialogue: 0,0:22:36.35,0:22:37.93,Default,,0,0,0,,Мен оны жеткізуім керек.
Dialogue: 0,0:22:38.06,0:22:41.10,Default,,0,0,0,,Бұл адам…
Dialogue: 0,0:22:41.23,0:22:42.23,Default,,0,0,0,,Ол бір жағынан… әсер береді…
Dialogue: 0,0:22:42.36,0:22:43.73,Default,,0,0,0,,Мен Ұлттық полиция агенттігінен Ягамимін.
Dialogue: 0,0:22:43.86,0:22:47.24,Default,,0,0,0,,Бақытты! Үлкен аға рахмет
Dialogue: 0,0:22:56.37,0:22:57.16,Default,,0,0,0,,Эй
Dialogue: 0,0:22:58.04,0:23:01.67,Default,,0,0,0,,Сіз, әрине, тамаша ФБР агенті болдыңыз.
Dialogue: 0,0:23:01.79,0:23:04.29,Default,,0,0,0,,Бірақ қазір сен тек менің болашақ жарымсың.
Dialogue: 0,0:23:04.92,0:23:09.17,Default,,0,0,0,,Мен Кира оқиғасы туралы ештеңе айтпаймын. Мен ешқандай қауіпті әрекеттер жасамаймын.
Dialogue: 0,0:23:09.30,0:23:10.38,Default,,0,0,0,,Сен
Dialogue: 0,0:23:10.51,0:23:13.51,Default,,0,0,0,,Жапониядағы ата-анаңызға сәлем беру
Dialogue: 0,0:23:13.64,0:23:14.97,Default,,0,0,0,,Мен сені өзіммен бірге алып келдім.
Dialogue: 0,0:23:15.68,0:23:19.02,Default,,0,0,0,,Түсіндім, Рэй, әдетімнен...
Dialogue: 0,0:23:19.14,0:23:20.39,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:20.52,0:23:23.56,Default,,0,0,0,,Әрине, әкеме де айтпаймын
Dialogue: 0,0:23:24.40,0:23:25.69,Default,,0,0,0,,Жарайды, мен қазір кетейін
Dialogue: 0,0:23:25.82,0:23:28.86,Default,,0,0,0,,Бос емеспін, тергеуші екенімді ұмыттым.
Dialogue: 0,0:23:29.65,0:23:32.45,Default,,0,0,0,,Мен полицияның ФБР агентімен байланыста болғанымды білуін де қаламайым
Dialogue: 0,0:23:32.57,0:23:33.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:23:33.74,0:23:37.29,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:23:37.41,0:23:38.62,Default,,0,0,0,,Сәуле...
Dialogue: 0,0:23:40.21,0:23:41.50,Default,,0,0,0,,Эй!
Dialogue: 0,0:23:43.08,0:23:44.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:46.96,0:23:50.01,Default,,0,0,0,,Кира өлтірді
Dialogue: 0,0:23:52.34,0:23:53.89,Default,,0,0,0,,Сіз жасаған телефон қоңырауы...
Dialogue: 0,0:23:54.01,0:23:56.22,Default,,0,0,0,,Бұл ерекше, әке.
Dialogue: 0,0:23:58.81,0:24:00.93,Default,,0,0,0,,Немесе есім қате хабарланған болар.
Dialogue: 0,0:24:03.56,0:24:04.86,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:24:04.98,0:24:08.90,Default,,0,0,0,,Мен тергеу штабымен тікелей сөйлескім келеді.
Dialogue: 0,0:24:09.03,0:24:11.78,Default,,0,0,0,,Тек айтқанымды істе.
Dialogue: 0,0:24:11.90,0:24:13.91,Default,,0,0,0,,Кира оқиғасы?
Dialogue: 0,0:24:16.87,0:24:20.29,Default,,0,0,0,,Жоқ, жай ғана мен сөйлеп жатқанда,
Dialogue: 0,0:24:20.41,0:24:22.00,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:24:22.12,0:24:24.12,Default,,0,0,0,,Ол жоқ сияқты. Сіз оны мен үшін сақтай аласыз ба?
Dialogue: 0,0:24:24.25,0:24:26.46,Default,,0,0,0,,Ах! Цуки-кун, көптен бері көрмедім
Dialogue: 0,0:24:27.38,0:24:29.25,Default,,0,0,0,,Күткендей, штабта ешкім жоқ.
Dialogue: 0,0:24:29.92,0:24:34.47,Default,,0,0,0,,Осы бесеуі қазіргі…
Dialogue: 0,0:24:34.59,0:24:37.05,Default,,0,0,0,,Бан
Dialogue: 0,0:24:37.18,0:24:38.31,Default,,0,0,0,,Ум...
Dialogue: 0,0:24:39.01,0:24:41.98,Default,,0,0,0,,Менің әкем Кира оқиғасының басшысы.
Dialogue: 0,0:24:42.10,0:24:44.10,Default,,0,0,0,,Егер мен Кира болсам, осы уақытта өліп қойған болар едім, Соичиро Ягами.
Dialogue: 0,0:24:44.81,0:24:48.06,Default,,0,0,0,,Менің ұялы телефоным өшірулі сияқты, сондықтан мен бірден бара алмаймын.
Dialogue: 0,0:24:48.90,0:24:50.82,Default,,0,0,0,,ФБР қызметкері өлтірілді.
Dialogue: 0,0:24:50.94,0:24:54.78,Default,,0,0,0,,Тіпті штабтың өзінде көптеген адамдар Кирадан қорқып жұмыстан шығып жатыр.
Dialogue: 0,0:24:54.91,0:24:56.78,Default,,0,0,0,,Менің ойымша, бұл бейберекетсіздік.
Dialogue: 0,0:24:56.91,0:25:00.12,Default,,0,0,0,,Цуки-кун, бұл қарапайым адамдарға дұрыс емес...
Dialogue: 0,0:25:00.24,0:25:02.87,Default,,0,0,0,,Бұл қазірдің өзінде әлемде өсек.
Dialogue: 0,0:25:03.50,0:25:07.67,Default,,0,0,0,,Ал бұл адамға сенуге болады, оның көзіне қарап білуге ​​болады.
Dialogue: 0,0:25:07.79,0:25:09.38,Default,,0,0,0,,Немесе есім қате хабарланған болар.
Dialogue: 0,0:25:09.50,0:25:11.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:13.34,0:25:16.09,Default,,0,0,0,,Сонда да сен батылсың.
Dialogue: 0,0:25:16.72,0:25:18.72,Default,,0,0,0,,Жоқ, жай ғана мен сөйлеп жатқанда,
Dialogue: 0,0:25:19.35,0:25:20.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:20.56,0:25:24.89,Default,,0,0,0,,Аты-жөніңізді бере аласыз ба?
Dialogue: 0,0:25:25.02,0:25:26.06,Default,,0,0,0,,Мен Цуки Ягамимін
Dialogue: 0,0:25:26.73,0:25:29.90,Default,,0,0,0,,Түн құдайы ай болып жазылып, жарық болып оқылады.
Dialogue: 0,0:25:30.02,0:25:31.61,Default,,0,0,0,,Бұл Л.
Dialogue: 0,0:25:31.73,0:25:35.49,Default,,0,0,0,,Ағаштың жарығында бір бала тұр.
Dialogue: 0,0:25:35.61,0:25:37.70,Default,,0,0,0,,Маки мырза, солай ма?
Dialogue: 0,0:25:37.82,0:25:39.53,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:25:40.16,0:25:43.79,Default,,0,0,0,,Маки мырза, менің ойымша Кираның күші
Dialogue: 0,0:25:44.58,0:25:48.42,Default,,0,0,0,,Ах, Мацуда екен.
Dialogue: 0,0:25:48.54,0:25:49.33,Default,,0,0,0,,Иә
Dialogue: 0,0:25:49.46,0:25:53.55,Default,,0,0,0,,Өлту үшін сізге тек бет пен есім керек.
Dialogue: 0,0:25:53.67,0:25:55.09,Default,,0,0,0,,Иә
Dialogue: 0,0:25:55.80,0:25:59.89,Default,,0,0,0,,ФБР сіздің жүзіңіз бен атыңызды білетін шығар.
Dialogue: 0,0:26:00.01,0:26:01.81,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:26:01.93,0:26:06.02,Default,,0,0,0,,Иә, менің күйеуім солардың бірі болды.
Dialogue: 0,0:26:06.14,0:26:06.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:07.69,0:26:10.86,Default,,0,0,0,,Қайтыс болған күннен бастап бейнебақылау камерасының түсірілімдерін тексеру.
Dialogue: 0,0:26:12.15,0:26:14.82,Default,,0,0,0,,Билет қақпасы мен перронда ұстап тұрған конверт
Dialogue: 0,0:26:14.94,0:26:17.90,Default,,0,0,0,,Мен оны пойызға қалдырдым.
Dialogue: 0,0:26:18.74,0:26:19.86,Default,,0,0,0,,Мүмкін Кира
Dialogue: 0,0:26:19.99,0:26:23.16,Default,,0,0,0,,ФБР агентінің файлын сол жерден алыңыз.
Dialogue: 0,0:26:23.70,0:26:25.25,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:26:25.37,0:26:30.13,Default,,0,0,0,,Қайтыс болған сәтте ол пойыздың ішіне үңілді.
Dialogue: 0,0:26:31.46,0:26:34.42,Default,,0,0,0,,Мүмкін Кира сонда болған шығар.
Dialogue: 0,0:26:35.92,0:26:39.34,Default,,0,0,0,,Басқаша айтқанда, сол кезде Рэй қарап тұрған адам.
Dialogue: 0,0:26:39.88,0:26:42.18,Default,,0,0,0,,Бұл адам Кира
Dialogue: 0,0:26:53.02,0:26:55.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:58.07,0:26:59.99,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет
Dialogue: 0,0:27:00.11,0:27:03.33,Default,,0,0,0,,А-а... (Айзава) Мынау... мынау Ватари ме?
Dialogue: 0,0:27:03.45,0:27:05.24,Default,,0,0,0,,Сіз әдетте не киесіз?
Dialogue: 0,0:27:06.04,0:27:09.79,Default,,0,0,0,,Осылай киінгенде, қыдырып жүрген адам екеніңді аңғаруға болады.
Dialogue: 0,0:27:09.91,0:27:13.34,Default,,0,0,0,,20 желтоқсан
Dialogue: 0,0:27:13.46,0:27:15.17,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,0:27:19.05,0:27:21.18,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:27:21.30,0:27:24.22,Default,,0,0,0,,бұл әйел білетін нәрсе – шындық.
Dialogue: 0,0:27:24.97,0:27:26.64,Default,,0,0,0,,Бізде онымен күресуден басқа амал қалмайды.
Dialogue: 0,0:27:27.27,0:27:28.93,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:27:30.14,0:27:31.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:27:33.44,0:27:37.15,Default,,0,0,0,,Мен сіздің әңгімеңізді қайта қарап шықтым.
Dialogue: 0,0:27:37.28,0:27:40.24,Default,,0,0,0,,Мен осы жолдар бойынша тергеуді бастау керек деп ойлай бастадым.
Dialogue: 0,0:27:41.15,0:27:42.41,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:27:42.53,0:27:45.70,Default,,0,0,0,,Иә Бұл оқиға әлі ешкімге айтылды ма?
Dialogue: 0,0:27:45.83,0:27:48.45,Default,,0,0,0,,Жоқ. Сен біріншісісің.
Dialogue: 0,0:27:48.58,0:27:51.29,Default,,0,0,0,,Хахаха, бұл жақсы болды.
Dialogue: 0,0:27:51.41,0:27:55.67,Default,,0,0,0,,Бірақ оны қалай өшіруге болады? Жақында бұл жерде қауіпті болады.
Dialogue: 0,0:27:55.79,0:27:57.46,Default,,0,0,0,,Рюк мұны маған айтпаса да.
Dialogue: 0,0:27:57.59,0:27:58.84,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:27:59.84,0:28:01.97,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:28:02.55,0:28:04.59,Default,,0,0,0,,Келініңіздің пойызда болған күні мен уақыты.
Dialogue: 0,0:28:04.72,0:28:05.72,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:28:06.39,0:28:09.81,Default,,0,0,0,,27 желтоқсан 15:13
Dialogue: 0,0:28:09.93,0:28:14.02,Default,,0,0,0,,Шиндзюкудан Шибуяға баратын Яманоте сызығымен жүріңіз.
Dialogue: 0,0:28:14.15,0:28:15.94,Default,,0,0,0,,27 желтоқсан
Dialogue: 0,0:28:17.02,0:28:17.90,Default,,0,0,0,,Шибуяға қарай Яманоте сызығы
Dialogue: 0,0:28:17.90,0:28:19.57,Default,,0,0,0,,Шибуяға қарай Яманоте сызығы.
Dialogue: 0,0:28:17.90,0:28:19.57,Default,,0,0,0,,(Рюк күледі)
Dialogue: 0,0:28:19.57,0:28:19.69,Default,,0,0,0,,(Рюктің күлкісі)
Dialogue: 0,0:28:19.69,0:28:20.49,Default,,0,0,0,,(Рюк күледі)
Dialogue: 0,0:28:19.69,0:28:20.49,Default,,0,0,0,,Иә
Dialogue: 0,0:28:20.49,0:28:22.86,Default,,0,0,0,,(Рюк күледі)
Dialogue: 0,0:28:31.71,0:28:34.29,Default,,0,0,0,,1:15 10 секундта
Dialogue: 0,0:28:36.84,0:28:40.55,Default,,0,0,0,,Жүр, өлімге асығыңыз
Dialogue: 0,0:28:57.94,0:29:00.61,Default,,0,0,0,,Бізде онымен күресуден басқа амал қалмайды.
Dialogue: 0,0:29:04.32,0:29:07.24,Default,,0,0,0,,Бұл біртүрлі. Бұл әйел неге қозғалмайды?
Dialogue: 0,0:29:07.37,0:29:12.37,Default,,0,0,0,,Хахахахаха... хахахахаха...
Dialogue: 0,0:29:13.46,0:29:14.58,Default,,0,0,0,,Мен оны Рук айтпаса да, алдын ала ойластырғанмын.
Dialogue: 0,0:29:15.71,0:29:18.38,Default,,0,0,0,,Бұл жалған есім, бар болғаны.
Dialogue: 0,0:29:18.50,0:29:22.59,Default,,0,0,0,,Рюктің көзінен әйелдің шын есімі көрінеді.
Dialogue: 0,0:29:22.71,0:29:24.34,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:29:24.47,0:29:29.01,Default,,0,0,0,,Біреу жалған есімді қолданғаннан кейін оның шын атын білу қиынырақ.
Dialogue: 0,0:29:29.14,0:29:33.27,Default,,0,0,0,,Ай Сіз әрқашан көзіңізді ауыстыра аласыз.
Dialogue: 0,0:29:34.14,0:29:39.77,Default,,0,0,0,,Иә, бұл басқа адамның атын және өмір сүру ұзақтығын көруге болатын Грим Реапердің көзімен мәміле.
Dialogue: 0,0:29:39.90,0:29:44.49,Default,,0,0,0,,Онда несі оғаш, Рюк?
Dialogue: 0,0:29:44.61,0:29:46.95,Default,,0,0,0,,Мұндай әйелге арналған
Dialogue: 0,0:29:47.07,0:29:49.45,Default,,0,0,0,,Сіз қалған өміріңізді екіге бөле аласыз ба?
Dialogue: 0,0:29:50.16,0:29:52.87,Default,,0,0,0,,Маған кедергі жасама. Аузыңды жап, Қылмыскер!
Dialogue: 0,0:29:53.79,0:29:54.75,Default,,0,0,0,,Бұл
Dialogue: 0,0:29:54.87,0:29:55.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:56.00,0:29:58.96,Default,,0,0,0,,Негізі мен сізге әлі айтпаған бір нәрсе бар.
Dialogue: 0,0:29:59.08,0:29:59.88,Default,,0,0,0,,А... иә
Dialogue: 0,0:30:01.17,0:30:04.13,Default,,0,0,0,,Сіз штабтағы адаммен тікелей сөйлеспеуіңіз керек.
Dialogue: 0,0:30:04.26,0:30:05.30,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:30:05.42,0:30:06.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:06.51,0:30:09.14,Default,,0,0,0,,Жоқ. Сен біріншісісің.
Dialogue: 0,0:30:09.26,0:30:12.39,Default,,0,0,0,,Бізде жауапты адам белгісіз жүйе бар.
Dialogue: 0,0:30:13.52,0:30:17.27,Default,,0,0,0,,Хехехе, күткендей жақсы сөздер айтасың, Цуки.
Dialogue: 0,0:30:17.94,0:30:21.06,Default,,0,0,0,,Неліктен сонша егжей-тегжейлі білесіз?
Dialogue: 0,0:30:22.32,0:30:24.57,Default,,0,0,0,,Амал жоқ, сөйлесейік.
Dialogue: 0,0:30:25.90,0:30:28.15,Default,,0,0,0,,Онда несі оғаш, Рюк?
Dialogue: 0,0:30:28.28,0:30:29.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:29.20,0:30:31.78,Default,,0,0,0,,Сіз тергеу штабының мүшесісіз бе?
Dialogue: 0,0:30:32.41,0:30:35.41,Default,,0,0,0,,L штабта кадр тапшылығына байланысты қиындық көрді.
Dialogue: 0,0:30:36.33,0:30:39.33,Default,,0,0,0,,Өйткені барлығы Кирадан қорқып кетті.
Dialogue: 0,0:30:39.92,0:30:41.54,Default,,0,0,0,,Мен әлі жоғары сынып оқушысымын.
Dialogue: 0,0:30:41.67,0:30:47.05,Default,,0,0,0,,Жарайды, мен де мұндағы ісімді бітірдім. Өз кілтіңмен кір.
Dialogue: 0,0:30:47.17,0:30:49.05,Default,,0,0,0,,Сосын сіз оны сатып алдыңыз...
Dialogue: 0,0:30:50.18,0:30:51.30,Default,,0,0,0,,Иә
Dialogue: 0,0:30:53.14,0:30:56.22,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:30:57.85,0:31:00.44,Default,,0,0,0,,Негізі, мен де екі жыл бұрын жасадым.
Dialogue: 0,0:31:00.56,0:31:04.32,Default,,0,0,0,,Мен Америкада бір іс бойынша L компаниясында жұмыс істедім.
Dialogue: 0,0:31:04.44,0:31:07.19,Default,,0,0,0,,А... сен Л-ның қол астында жұмыс істедің бе?
Dialogue: 0,0:31:07.32,0:31:12.78,Default,,0,0,0,,Үш ай бұрын мен де ФБР агенті болдым.
Dialogue: 0,0:31:12.91,0:31:13.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:14.03,0:31:16.62,Default,,0,0,0,,Сол автобусты басып алу оқиғасының күні мен уақытын айта аласың ба?
Dialogue: 0,0:31:17.66,0:31:19.71,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:31:19.83,0:31:21.83,Default,,0,0,0,,Кираны қуғандағы көзқарасы мен әрекеті таңқаларлық емес
Dialogue: 0,0:31:21.96,0:31:24.42,Default,,0,0,0,,Мен өзімді әуесқойдан ерекшемін деп ойладым.
Dialogue: 0,0:31:25.55,0:31:27.71,Default,,0,0,0,,Бұл оқиға менікі
Dialogue: 0,0:31:27.84,0:31:32.76,Default,,0,0,0,,Мен полицияны, тіпті тергеу штабындағы адамдарды да күдіктену керек деп шештім.
Dialogue: 0,0:31:33.34,0:31:35.47,Default,,0,0,0,,Онда несі оғаш, Рюк?
Dialogue: 0,0:31:36.93,0:31:39.77,Default,,0,0,0,,Сізде L-ге ұқсас нәрсе бар.
Dialogue: 0,0:31:41.02,0:31:43.19,Default,,0,0,0,,Ватару келе жатыр.
Dialogue: 0,0:31:44.61,0:31:45.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:49.11,0:31:51.11,Default,,0,0,0,,Бірге зерттегіңіз келе ме?
Dialogue: 0,0:31:51.24,0:31:52.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:52.66,0:31:56.08,Default,,0,0,0,,Тергеу штабының мүшесі болғыңыз келе ме?
Dialogue: 0,0:31:57.16,0:31:59.54,Default,,0,0,0,,Сіздің пікіріңізді естігеннен кейін оны мүмкіндігінше тезірек хабардар еткім келді.
Dialogue: 0,0:32:00.20,0:32:03.46,Default,,0,0,0,,Иә, бізге сіздей адамдар керек.
Dialogue: 0,0:32:03.58,0:32:06.79,Default,,0,0,0,,Сіз жалпы ақпарат беруші емессіз.
Dialogue: 0,0:32:07.59,0:32:10.63,Default,,0,0,0,,Тағдырдың жазуымен осында сені кездестірдім.
Dialogue: 0,0:32:11.47,0:32:13.26,Default,,0,0,0,,Мен сізге ұсынамын
Dialogue: 0,0:32:16.97,0:32:20.85,Default,,0,0,0,,А... Аа, кешіріңіз, мен жаңа ғана толқып кеттім.
Dialogue: 0,0:32:20.98,0:32:24.44,Default,,0,0,0,,Бірақ ол әлі жас, әдемі.
Dialogue: 0,0:32:24.56,0:32:25.86,Default,,0,0,0,,Осындай қауіпті тергеу үшін...
Dialogue: 0,0:32:25.98,0:32:29.36,Default,,0,0,0,,Жоқ, менің лақтыратын ештеңем жоқ.
Dialogue: 0,0:32:29.48,0:32:33.20,Default,,0,0,0,,Мен Кираны ұстап алғым келеді. Менде сол сезімнен басқа ештеңе жоқ.
Dialogue: 0,0:32:33.32,0:32:35.53,Default,,0,0,0,,Бірге зерттейік.
Dialogue: 0,0:32:35.66,0:32:38.33,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:32:38.45,0:32:41.04,Default,,0,0,0,,Хахаха ха ахахаха…
Dialogue: 0,0:32:41.16,0:32:44.17,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:32:44.87,0:32:46.21,Default,,0,0,0,,Жақсы
Dialogue: 0,0:32:46.83,0:32:50.00,Default,,0,0,0,,Маған сәйкестендіру ретінде қолдануға болатын нәрсені көрсете аласыз ба?
Dialogue: 0,0:32:50.71,0:32:53.17,Default,,0,0,0,,Ватару келе жатыр.
Dialogue: 0,0:32:53.30,0:32:54.30,Default,,0,0,0,,Иә
Dialogue: 0,0:33:13.40,0:33:14.90,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:33:30.75,0:33:35.13,Default,,0,0,0,,Сағаттар сізді неге сонша мазалайсыз?
Dialogue: 0,0:33:35.26,0:33:37.84,Default,,0,0,0,,Сіздің пікіріңізді естігеннен кейін оны мүмкіндігінше тезірек хабардар еткім келді.
Dialogue: 0,0:33:39.05,0:33:40.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:43.73,0:33:44.52,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:33:45.48,0:33:48.06,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:34:08.88,0:34:10.13,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:34:11.21,0:34:13.63,Default,,0,0,0,,бұл әйел білетін нәрсе – шындық.
Dialogue: 0,0:34:15.67,0:34:19.09,Default,,0,0,0,,Қош бол Наоми Нанзора
Dialogue: 0,0:34:41.41,0:34:44.95,Default,,0,0,0,,Иә... Иә, сәл күте тұрыңыз.
Dialogue: 0,0:34:45.70,0:34:48.21,Default,,0,0,0,,Бұл оғаш емес пе?
Dialogue: 0,0:34:48.33,0:34:52.67,Default,,0,0,0,,Мен сізді қызықтыратын жалпы ақпарат алу үшін қазір қоңыраулар алып жатқаныңызды түсінемін.
Dialogue: 0,0:34:53.71,0:34:55.21,Default,,0,0,0,,Рэй Пембердің күйеуі?
Dialogue: 0,0:34:56.09,0:34:59.63,Default,,0,0,0,,Наоми Нанзора... Мен бұл есімді бір жерден естідім.
Dialogue: 0,0:35:01.59,0:35:03.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:03.18,0:35:04.89,Default,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:35:05.47,0:35:07.81,Default,,0,0,0,,Лос-Анджелес BB кісі өлтіру ісі...
Dialogue: 0,0:35:11.69,0:35:15.86,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,0:35:15.98,0:35:20.11,Default,,0,0,0,,Күйеуі қайтыс болса, кез келген адам депрессияға ұшырайды.
Dialogue: 0,0:35:20.24,0:35:21.11,Default,,0,0,0,,Суицид…
Dialogue: 0,0:35:21.24,0:35:24.08,Default,,0,0,0,,Жоқ, мен білетін Наоми Нанзора
Dialogue: 0,0:35:24.20,0:35:27.25,Default,,0,0,0,,Ол күшті және дарынды ФБР агенті.
Dialogue: 0,0:35:27.37,0:35:31.37,Default,,0,0,0,,Жоқ… әрине, мүмкін емес
Dialogue: 0,0:35:31.50,0:35:33.75,Default,,0,0,0,,Ол Пембермен бірге болған сияқты.
Dialogue: 0,0:35:33.88,0:35:36.67,Default,,0,0,0,,Мүмкін ол бірдеңені тартып алған шығар
Dialogue: 0,0:35:36.80,0:35:40.47,Default,,0,0,0,,Алайда, бәлкім ол дәл осы болжамды керісінше айналдырып жіберген болар
Dialogue: 0,0:35:43.18,0:35:45.35,Default,,0,0,0,,Ханымдар мен мырзалар, бұдан былай, Рэй Пембер
Dialogue: 0,0:35:45.47,0:35:48.81,Default,,0,0,0,,Біз тек Жапонияда тергеуге алынғандарды ғана зерттейміз.
Dialogue: 0,0:35:48.93,0:35:53.56,Default,,0,0,0,,Тек Рэй Пенбердің билет тосқауылынан өтуі, пойызға мінуі және оның өлімі көріністері.
Dialogue: 0,0:35:53.69,0:35:56.02,Default,,0,0,0,,Сіз кімсіз? Сол екі адам
Dialogue: 0,0:35:57.02,0:36:00.19,Default,,0,0,0,,Директордың орынбасары Китамура және оның отбасы және
Dialogue: 0,0:36:00.32,0:36:02.70,Default,,0,0,0,,Директор Ягами және оның отбасы.
Dialogue: 0,0:36:02.82,0:36:03.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:36:04.78,0:36:06.16,Default,,0,0,0,,Және сол екі үйде
Dialogue: 0,0:36:06.95,0:36:10.62,Default,,0,0,0,,Тыңдау құрылғысы мен бақылау камерасын орнатқым келеді.
Dialogue: 0,0:36:11.46,0:36:12.92,Default,,0,0,0,,Ол төменде.
Dialogue: 0,0:36:13.04,0:36:14.79,Default,,0,0,0,,Аа, ертең кездескенше.
Dialogue: 0,0:36:18.17,0:36:20.46,Default,,0,0,0,,Э-э… Рэй Пенбер
Dialogue: 0,0:36:28.81,0:36:30.02,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:36:40.23,0:36:43.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:46.41,0:36:49.49,Default,,0,0,0,,Эй Цуки, үйде ешкім жоқ сияқты.
Dialogue: 0,0:36:49.62,0:36:52.29,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет екі адаммен ойын ойнағыңыз келе ме? (Дүйсенбі) Әй...
Dialogue: 0,0:36:53.41,0:36:54.21,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:36:54.92,0:36:56.08,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:36:59.46,0:37:00.67,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:37:01.55,0:37:03.80,Default,,0,0,0,,Сенің бұлай істеп жатқаныңа сене алар емеспін.
Dialogue: 0,0:37:03.93,0:37:06.72,Default,,0,0,0,,Бөлмеде көргіңіз келмейтін нәрсе бар ма?
Dialogue: 0,0:37:06.84,0:37:11.35,Default,,0,0,0,,Э-э… ал 16:42-де ол Токио станциясының платформасында өлі күйінде табылды
Dialogue: 0,0:37:12.06,0:37:14.56,Default,,0,0,0,,Мен де мағынасыз істер жасадым.
Dialogue: 0,0:37:15.31,0:37:20.07,Default,,0,0,0,,Эй Цуки, мені елемегенің үшін мен саған ашуланамын.
Dialogue: 0,0:37:20.65,0:37:21.28,Default,,0,0,0,,Билет қақпаларында да, платформада да ол конвертке ұқсайтын бір нәрсені ұстап тұр.
Dialogue: 0,0:37:21.28,0:37:23.40,Default,,0,0,0,,Билет қақпаларында да, платформада да ол конвертке ұқсайтын бір нәрсені ұстап тұр.
Dialogue: 0,0:37:21.28,0:37:23.40,Default,,0,0,0,,Ой Цуки
Dialogue: 0,0:37:23.53,0:37:24.95,Default,,0,0,0,,дүйсенбі~
Dialogue: 0,0:37:25.07,0:37:29.91,Default,,0,0,0,,Рюк: Үйде бақылау камерасы немесе телефон тыңдау құрылғысы бар ма? Жоқ, мүмкін екеуі де.
Dialogue: 0,0:37:30.03,0:37:31.99,Default,,0,0,0,,бұрмаланған болуы мүмкін
Dialogue: 0,0:37:32.12,0:37:34.54,Default,,0,0,0,,Мен әрқашан есікті жапқаннан кейін
Dialogue: 0,0:37:34.66,0:37:38.58,Default,,0,0,0,,Қызық болар еді, егер ол Кира болса?
Dialogue: 0,0:37:39.38,0:37:42.96,Default,,0,0,0,,Басқаша айтқанда, есікті ашқанда, тұтқа толығымен жоғары болса.
Dialogue: 0,0:37:43.09,0:37:45.05,Default,,0,0,0,,Бөлмеге біреу кірген болуы мүмкін
Dialogue: 0,0:37:45.17,0:37:46.80,Default,,0,0,0,,15:11-де Шинжюку батыс шығысындағы билет қақпасынан кірді.
Dialogue: 0,0:37:46.93,0:37:49.80,Default,,0,0,0,,Менің ата-анам мен сіңлім қағазды байқамай қалды.
Dialogue: 0,0:37:49.93,0:37:53.60,Default,,0,0,0,,Бұл күдікті, себебі сіз қағазды әдейі қайта қойдыңыз.
Dialogue: 0,0:37:54.39,0:37:56.85,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:37:56.98,0:37:57.77,Default,,0,0,0,,Э-э… ал 16:42-де ол Токио станциясының платформасында өлі күйінде табылды
Dialogue: 0,0:37:57.90,0:38:00.69,Default,,0,0,0,,Қасқыр өлмейді, сондықтан ол аштан өлмейді.
Dialogue: 0,0:38:00.82,0:38:03.48,Default,,0,0,0,,Сондықтан алма бермесең де, еш қиындық жоқ.
Dialogue: 0,0:38:03.61,0:38:05.44,Default,,0,0,0,,Эй... сәл күте тұршы, Ай.
Dialogue: 0,0:38:06.07,0:38:09.74,Default,,0,0,0,,Мен үшін алма... дұрыс.
Dialogue: 0,0:38:09.87,0:38:12.70,Default,,0,0,0,,Адам бойындағы алкоголь мен темекі сияқты.
Dialogue: 0,0:38:12.83,0:38:14.70,Default,,0,0,0,,Егер сіз мұны ұзақ уақыт жасамасаңыз, сізде абстиненция белгілері пайда болады...
Dialogue: 0,0:38:15.41,0:38:17.96,Default,,0,0,0,,Егер сіз шынымен алма жегіңіз келсе...
Dialogue: 0,0:38:19.33,0:38:22.55,Default,,0,0,0,,Алдымен барлық камералардың орналасуын түсініңіз
Dialogue: 0,0:38:22.67,0:38:26.38,Default,,0,0,0,,Қызық болар еді, егер ол Кира болса?
Dialogue: 0,0:38:26.51,0:38:27.55,Default,,0,0,0,,О
Dialogue: 0,0:38:27.68,0:38:29.51,Default,,0,0,0,,Ал, кеттік, Рюк.
Dialogue: 0,0:38:29.64,0:38:32.60,Default,,0,0,0,,А, камераны іздеп жатырмын.
Dialogue: 0,0:38:32.72,0:38:36.02,Default,,0,0,0,,Бұл да қызық! болып табылады!
Dialogue: 0,0:38:40.56,0:38:43.40,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,0:38:45.82,0:38:46.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:46.99,0:38:48.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:38:48.82,0:38:50.91,Default,,0,0,0,,Бұл өте жақсы, Тосики Рукава!
Dialogue: 0,0:38:51.03,0:38:54.66,Default,,0,0,0,,Ол сабақта жоқ, анық!
Dialogue: 0,0:38:54.79,0:38:57.12,Default,,0,0,0,,Шохиро, тамақыңды іш.
Dialogue: 0,0:38:57.25,0:38:59.21,Default,,0,0,0,,Кейінірек~
Dialogue: 0,0:38:59.33,0:39:02.63,Default,,0,0,0,,Айзава мырза, Китамура отбасы қазір теледидар көріп жатыр ма?
Dialogue: 0,0:39:02.75,0:39:03.54,Default,,0,0,0,,Иә
Dialogue: 0,0:39:03.67,0:39:07.21,Default,,0,0,0,,Директордың орынбасарын есептемегенде, тамақ ішіп отырғанда төртеуміз қарап тұрмыз.
Dialogue: 0,0:39:07.34,0:39:08.47,Default,,0,0,0,,Қызық болар еді, егер ол Кира болса?
Dialogue: 0,0:39:09.59,0:39:11.26,Default,,0,0,0,,Әрбір теледидар станциясына ватари
Dialogue: 0,0:39:11.39,0:39:13.85,Default,,0,0,0,,Маған жоғарыдағы жазуды ойнауды тапсырыңыз.
Dialogue: 0,0:39:13.97,0:39:14.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:39:15.10,0:39:16.31,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:39:16.43,0:39:18.85,Default,,0,0,0,,Не?
Dialogue: 0,0:39:18.98,0:39:23.27,Default,,0,0,0,,«ICPO Кира оқиғасына жауап береді»
Dialogue: 0,0:39:23.40,0:39:27.90,Default,,0,0,0,,«Дамыған елдерден барлығы 1500 тергеуші»
Dialogue: 0,0:39:28.03,0:39:31.03,Default,,0,0,0,,«Жапонияға жіберуге шешім қабылдадым»
Dialogue: 0,0:39:31.95,0:39:35.08,Default,,0,0,0,,және батыл әрекетке барған болар
Dialogue: 0,0:39:35.79,0:39:39.08,Default,,0,0,0,,L Жұмыс істеу әдісі бірінші ретпен бірдей.
Dialogue: 0,0:39:40.00,0:39:41.79,Default,,0,0,0,,ICPO да ақымақ.
Dialogue: 0,0:39:41.92,0:39:42.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:43.50,0:39:45.67,Default,,0,0,0,,Мұндай хабарландырудың еш мәні жоқ.
Dialogue: 0,0:39:45.80,0:39:49.30,Default,,0,0,0,,Егер сіз оны жіберетін болсаңыз, оны жасырын түрде ішке кіргізіп, жасырын түрде тергеуге рұқсат етіңіз.
Dialogue: 0,0:39:49.42,0:39:53.59,Default,,0,0,0,,Тіпті өте құпия тергеу жүргізген ФБР да осындай жағдайға тап болды.
Dialogue: 0,0:39:53.72,0:39:55.22,Default,,0,0,0,,Бұл екінші қадам болар еді.
Dialogue: 0,0:39:56.06,0:39:58.10,Default,,0,0,0,,Сондықтан мұны асыра айту керек.
Dialogue: 0,0:39:58.22,0:40:00.94,Default,,0,0,0,,Бұл Кираны тұрақсыздандыруға арналған полиция стратегиясы.
Dialogue: 0,0:40:01.77,0:40:04.73,Default,,0,0,0,,Бірақ Кира бұл туралы білмей ме?
Dialogue: 0,0:40:04.86,0:40:06.19,Default,,0,0,0,,Чи…
Dialogue: 0,0:40:07.53,0:40:09.78,Default,,0,0,0,,Бұл оғаш емес пе?
Dialogue: 0,0:40:09.90,0:40:12.15,Default,,0,0,0,,Е... жақсы
Dialogue: 0,0:40:15.62,0:40:19.95,Default,,0,0,0,,La… Мен айдағы барлық камераларды таптым.
Dialogue: 0,0:40:20.08,0:40:22.42,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:40:23.42,0:40:25.08,Default,,0,0,0,,Билет қақпаларында да, платформада да ол конвертке ұқсайтын бір нәрсені ұстап тұр.
Dialogue: 0,0:40:25.21,0:40:28.17,Default,,0,0,0,,О… дұрыс айтасың.
Dialogue: 0,0:40:29.26,0:40:31.92,Default,,0,0,0,,Бұл камералардың үлкен саны.
Dialogue: 0,0:40:32.05,0:40:35.80,Default,,0,0,0,,Оны киген адам ашылып қалсын деген ниетпен солай жасады деп ойламаймын.
Dialogue: 0,0:40:35.93,0:40:37.85,Default,,0,0,0,,Демек, ол пойызда болған.
Dialogue: 0,0:40:38.60,0:40:41.89,Default,,0,0,0,,Олай болса, мына күйімде мен алманы қайда жеймін?
Dialogue: 0,0:40:42.02,0:40:44.40,Default,,0,0,0,,Жоқ… әрине, мүмкін емес
Dialogue: 0,0:40:44.52,0:40:47.94,Default,,0,0,0,,Аа, үй ішінде сөйлесе алмайтын шығармыз.
Dialogue: 0,0:40:48.07,0:40:50.53,Default,,0,0,0,,Ертең далаға шыққанда айт.
Dialogue: 0,0:40:50.65,0:40:53.15,Default,,0,0,0,,Жарайды, бұл сұрақ та дұрыс.
Dialogue: 0,0:40:53.86,0:40:56.28,Default,,0,0,0,,Камералардың санын және олардың қалай бекітілгенін қарастыру
Dialogue: 0,0:40:56.41,0:40:58.99,Default,,0,0,0,,Олар аз уақыт ішінде оны анықтауға тырысатын сияқты.
Dialogue: 0,0:40:59.12,0:41:02.91,Default,,0,0,0,,Жоғарыдағы кадрлар кездейсоқ қауіпсіздік камерасына түсірілген, онда Жапонияда қаза тапқан ФБР агенті көрсетілген.
Dialogue: 0,0:41:03.04,0:41:06.00,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:41:10.00,0:41:13.05,Default,,0,0,0,,Хехехехехехехехе...
Dialogue: 0,0:41:13.17,0:41:17.93,Default,,0,0,0,,(Рюктің ыңырсыуы)
Dialogue: 0,0:41:18.05,0:41:21.22,Default,,0,0,0,,Хухахахахахахаха...
Dialogue: 0,0:41:21.35,0:41:23.98,Default,,0,0,0,,Енді 3 аптаға дейін қылмыскерлер өледі.
Dialogue: 0,0:41:24.10,0:41:25.77,Default,,0,0,0,,Өлім кітабында жазылғанымен
Dialogue: 0,0:41:26.48,0:41:28.48,Default,,0,0,0,,Сондай-ақ Кираның өлім уақытын басқара алатыны айтылады.
Dialogue: 0,0:41:28.61,0:41:30.27,Default,,0,0,0,,L-де көрсетілген
Dialogue: 0,0:41:30.40,0:41:34.82,Default,,0,0,0,,Сонымен, бұл жағдайда менде ешқандай ақпарат болмаған кезде
Dialogue: 0,0:41:34.95,0:41:38.57,Default,,0,0,0,,15:11-де Шинжюку батыс шығысындағы билет қақпасынан кірді.
Dialogue: 0,0:41:38.70,0:41:42.08,Default,,0,0,0,,Қолайсыз қабылдау белгілері! Уф...
Dialogue: 0,0:41:42.20,0:41:44.79,Default,,0,0,0,,Мен орындаймын L
Dialogue: 0,0:41:49.54,0:41:52.51,Default,,0,0,0,,Рюктің ақпаратымен және алдын ала дайындықтарымен
Dialogue: 0,0:41:52.63,0:41:55.34,Default,,0,0,0,,Қалай қарасаң да, тестілеуші болып жүрсің, оқисың.
Dialogue: 0,0:41:55.47,0:41:59.43,Default,,0,0,0,,Мен қазір Death Note-те хабарланып жатқан қылмыскермін.
Dialogue: 0,0:42:00.39,0:42:02.10,Default,,0,0,0,,Бұл оғаш емес пе?
Dialogue: 0,0:42:02.22,0:42:04.39,Default,,0,0,0,,Несі оғаш, Л?
Dialogue: 0,0:42:05.39,0:42:06.94,Default,,0,0,0,,Бір нәрсені байқадың ба?
Dialogue: 0,0:42:11.11,0:42:13.78,Default,,0,0,0,,Картоп чипін алып, жеп қойыңыз
Dialogue: 0,0:42:14.65,0:42:17.61,Default,,0,0,0,,Уау
Dialogue: 0,0:42:24.87,0:42:28.04,Default,,0,0,0,,Кешкі астан кейін ұлым теледидарды да, компьютерді де қоспады.
Dialogue: 0,0:42:28.17,0:42:30.00,Default,,0,0,0,,Мен үнемі сабақ оқимын.
Dialogue: 0,0:42:30.13,0:42:32.92,Default,,0,0,0,,Ұлттық орталық тестілеуіне небәрі 10 күн қалды.
Dialogue: 0,0:42:35.13,0:42:36.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:42.55,0:42:44.60,Default,,0,0,0,,Енді мен білмейтін қылмыскер бар.
Dialogue: 0,0:42:44.72,0:42:47.23,Default,,0,0,0,,40 секундтан кейін инфаркт
Dialogue: 0,0:42:48.56,0:42:52.11,Default,,0,0,0,,Әлібиімнің куәгері Л-ның өзі.
Dialogue: 0,0:42:58.70,0:42:59.70,Default,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:42:59.82,0:43:01.99,Default,,0,0,0,,Бүгін 9-дағы жаңалықтарда алғаш рет хабарланды⸺
Dialogue: 0,0:43:02.12,0:43:05.16,Default,,0,0,0,,Банк қызметкері қаржы жымқырды деген күдікке ілінді
Dialogue: 0,0:43:05.29,0:43:07.45,Default,,0,0,0,,Жүрек талмасынан қайтыс болды
Dialogue: 0,0:43:07.58,0:43:08.54,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,0:43:08.66,0:43:11.46,Default,,0,0,0,,Бүгінгі Кира - әлдеқайда жеңіл қылмысы бар адам.
Dialogue: 0,0:43:11.58,0:43:13.75,Default,,0,0,0,,Ол хабар жеткен бойда өлтірілді.
Dialogue: 0,0:43:13.88,0:43:14.67,Default,,0,0,0,,А...
Dialogue: 0,0:43:15.50,0:43:18.22,Default,,0,0,0,,Бұл камера қосылған бірінші күн.
Dialogue: 0,0:43:18.34,0:43:21.01,Default,,0,0,0,,Ягами отбасы қызық тегіс.
Dialogue: 0,0:43:22.64,0:43:24.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:32.56,0:43:34.48,Default,,0,0,0,,Келесі Наоми Нанзораның мәселесі.
Dialogue: 0,0:43:35.19,0:43:37.82,Default,,0,0,0,,Біз қазірдің өзінде қоғамдық тергеуді бастауымыз керек емес пе?
Dialogue: 0,0:43:37.94,0:43:40.53,Default,,0,0,0,,Егер сіз мұны істесеңіз, оның Кира оқиғасына қатысы жоқ.
Dialogue: 0,0:43:40.65,0:43:43.07,Default,,0,0,0,,Фотосуреттерден аулақ болу керек және оның орнына портреттерді пайдалану керек.
Dialogue: 0,0:43:43.07,0:43:43.87,Default,,0,0,0,,Фотосуреттерден аулақ болу және портреттерді пайдалану керек.
Dialogue: 0,0:43:43.07,0:43:43.87,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:43:43.99,0:43:45.12,Default,,0,0,0,,Рюзаки (Ж) Иә?
Dialogue: 0,0:43:45.24,0:43:48.62,Default,,0,0,0,,Сакура теледидары... үлкен дәрежеде
Dialogue: 0,0:43:48.75,0:43:49.54,Default,,0,0,0,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,0:43:49.66,0:43:53.04,Default,,0,0,0,,Басқаша айтқанда, біз Кираның кепілі және
Dialogue: 0,0:43:53.17,0:43:56.84,Default,,0,0,0,,Репортердің міндеті - бұл туралы хабарлау.
Dialogue: 0,0:43:56.96,0:43:58.84,Default,,0,0,0,,Ешқашан өтірік айтпаңыз немесе қызықпаңыз
Dialogue: 0,0:43:58.96,0:44:00.97,Default,,0,0,0,,Бұл таспа трансляцияға арналмағанын түсініңіз.
Dialogue: 0,0:44:00.97,0:44:02.84,Default,,0,0,0,,Бұл таспа трансляцияға арналмағанын түсініңіз.
Dialogue: 0,0:44:00.97,0:44:02.84,Default,,0,0,0,,Кираның тұтқындары ма?
Dialogue: 0,0:44:02.97,0:44:04.72,Default,,0,0,0,,Эй, Сакута. Иә, не болды?
Dialogue: 0,0:44:04.85,0:44:05.97,Default,,0,0,0,,4 күн бұрын
Dialogue: 0,0:44:06.10,0:44:09.22,Default,,0,0,0,,Осы бағдарламаның директорына жіберілген төрт таспа.
Dialogue: 0,0:44:09.35,0:44:13.69,Default,,0,0,0,,Аудитория рейтингі 60%... жоқ, ол 70% болады.
Dialogue: 0,0:44:13.81,0:44:17.65,Default,,0,0,0,,Алдын ала ескерту арқылы сіз нағыз Кира өлтірген екеніңізді дәлелдеңіз
Dialogue: 0,0:44:17.78,0:44:20.32,Default,,0,0,0,,Және әлем халқына хабар
Dialogue: 0,0:44:20.44,0:44:21.74,Default,,0,0,0,,енгізілгені айтылады.
Dialogue: 0,0:44:21.86,0:44:23.24,Default,,0,0,0,,Ах... (Ууда) Жарайды... тағы⸺
Dialogue: 0,0:44:23.36,0:44:24.82,Default,,0,0,0,,Бұл орын алу үшін жасалған жоқ па?
Dialogue: 0,0:44:24.95,0:44:29.12,Default,,0,0,0,,Мен мұндай жамандықты ешқашан күтпедім...
Dialogue: 0,0:44:29.24,0:44:30.25,Default,,0,0,0,,қараңыз.
Dialogue: 0,0:44:30.87,0:44:36.46,Default,,0,0,0,,Мен оның осы уақыт бойы Тас Масканы жасырып келгенін мүлде білмеппін…
Dialogue: 0,0:44:38.50,0:44:39.84,Default,,0,0,0,,Мен – Кирамын.
Dialogue: 0,0:44:39.96,0:44:42.84,Default,,0,0,0,,Бұл бейне 18 сәуірде шығарылды
Dialogue: 0,0:44:42.97,0:44:45.97,Default,,0,0,0,,Дәл 17:59-да шайылып кетсе.
Dialogue: 0,0:44:46.10,0:44:51.48,Default,,0,0,0,,Қазір 5:59 47 48 49...
Dialogue: 0,0:44:51.60,0:44:53.94,Default,,0,0,0,,Арнаны Taiyo TV деп өзгертіңіз
Dialogue: 0,0:44:54.06,0:44:56.77,Default,,0,0,0,,Бас рөлді ойнаушы Казухико Хибима
Dialogue: 0,0:44:56.90,0:44:58.94,Default,,0,0,0,,Тура 6-да жүрек талмасынан қайтыс болды.
Dialogue: 0,0:44:59.07,0:45:00.44,Default,,0,0,0,,Ах! (L) Өзгерту
Dialogue: 0,0:45:00.57,0:45:01.24,Default,,0,0,0,,Сәлем! Суретке түсірме, суретке түсірме, суретке түсірме
Dialogue: 0,0:45:01.24,0:45:02.95,Default,,0,0,0,,Сәлем! Суретке түсірме, суретке түсірме, суретке түсірме
Dialogue: 0,0:45:01.24,0:45:02.95,Default,,0,0,0,,Ах! (Мацуда) Жоқ...
Dialogue: 0,0:45:03.07,0:45:04.11,Default,,0,0,0,,Суретке түспеңіз!
Dialogue: 0,0:45:04.24,0:45:06.57,Default,,0,0,0,,Бұл хабарды тоқтатпасақ, жағдай нашар болады!
Dialogue: 0,0:45:06.70,0:45:10.20,Default,,0,0,0,,А... Сакура теледидарына қоңырау шалыңыз!
Dialogue: 0,0:45:11.16,0:45:14.87,Default,,0,0,0,,болжанғандай, сол екі күдікті жүрек тоқтауынан қайтыс болды.
Dialogue: 0,0:45:15.00,0:45:17.29,Default,,0,0,0,,Егер бұл рас болса, оны тек Кира ғана жасай алады.
Dialogue: 0,0:45:17.42,0:45:19.17,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:45:19.84,0:45:20.71,Default,,0,0,0,,Әй, Ууда мырза!
Dialogue: 0,0:45:20.84,0:45:23.72,Default,,0,0,0,,Мен тікелей вокзалға барып, оларды тоқтатуға мәжбүр етемін!
Dialogue: 0,0:45:25.13,0:45:27.51,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:45:27.64,0:45:30.39,Default,,0,0,0,,Және онда әлем халқына арналған хабарлама бар делінеді
Dialogue: 0,0:45:31.10,0:45:34.98,Default,,0,0,0,,Тілегім – зұлымдық жоқ дүние жасау.
Dialogue: 0,0:45:35.52,0:45:38.69,Default,,0,0,0,,Жасағыңыз келсе, орындау оңай.
Dialogue: 0,0:45:38.81,0:45:39.61,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:45:40.65,0:45:42.78,Default,,0,0,0,,Мені алуға тырыспасаң
Dialogue: 0,0:45:42.90,0:45:45.07,Default,,0,0,0,,Жазықсыз адам өлмейді
Dialogue: 0,0:45:45.61,0:45:48.37,Default,,0,0,0,,Келесі, Наоми Минами ісіне қатысты:
Dialogue: 0,0:45:48.49,0:45:53.12,Default,,0,0,0,,Мен бұл арам дүниені мейірімді жандарға мекен еттім⸺
Dialogue: 0,0:45:53.25,0:45:55.33,Default,,0,0,0,,Оны жаңа әлемге өзгертейік
Dialogue: 0,0:45:58.75,0:46:00.13,Default,,0,0,0,,Иә! Ха ха...
Dialogue: 0,0:46:00.88,0:46:02.92,Default,,0,0,0,,Уф! Шүкір, жабық.
Dialogue: 0,0:46:04.34,0:46:06.93,Default,,0,0,0,,Полиция! Оны ашыңыз!
Dialogue: 0,0:46:07.63,0:46:09.97,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:46:10.10,0:46:10.72,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:46:10.72,0:46:13.35,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:46:10.72,0:46:13.35,Default,,0,0,0,,Уф! Ах... аа...
Dialogue: 0,0:46:14.22,0:46:16.69,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:46:18.73,0:46:22.61,Default,,0,0,0,,Ах... у... а...
Dialogue: 0,0:46:24.11,0:46:25.03,Default,,0,0,0,,Мен бағдарламаны кенет өзгерттім.
Dialogue: 0,0:46:25.03,0:46:26.36,Default,,0,0,0,,Мен бағдарламаны кенет өзгерттім.
Dialogue: 0,0:46:25.03,0:46:26.36,Default,,0,0,0,,Сәлеметсіз бе? Ақымақ, қосыла алмаймын.
Dialogue: 0,0:46:26.36,0:46:26.49,Default,,0,0,0,,Сәлеметсіз бе? Ақымақ, қосыла алмаймын.
Dialogue: 0,0:46:26.49,0:46:27.78,Default,,0,0,0,,Сәлеметсіз бе? Ақымақ, қосыла алмаймын.
Dialogue: 0,0:46:26.49,0:46:27.78,Default,,0,0,0,,Сакура теледидарының алдынан тікелей трансляция жібереміз.
Dialogue: 0,0:46:27.78,0:46:27.91,Default,,0,0,0,,Сакура теледидарының алдынан тікелей трансляция жібереміз.
Dialogue: 0,0:46:27.91,0:46:28.91,Default,,0,0,0,,Сакура теледидарының алдынан тікелей трансляция жібереміз.
Dialogue: 0,0:46:27.91,0:46:28.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:29.03,0:46:30.03,Default,,0,0,0,,Әй, Айзава-сан!
Dialogue: 0,0:46:30.16,0:46:31.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:35.83,0:46:36.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:46:36.79,0:46:39.54,Default,,0,0,0,,Қараңызшы, біреу құлап қалды!
Dialogue: 0,0:46:39.67,0:46:41.17,Default,,0,0,0,,Ух... Ууда мырза...
Dialogue: 0,0:46:41.29,0:46:42.63,Default,,0,0,0,,Уф... нуууу!
Dialogue: 0,0:46:42.75,0:46:44.30,Default,,0,0,0,,Жарайды, назар аударыңыздар
Dialogue: 0,0:46:45.21,0:46:46.92,Default,,0,0,0,,Және онда әлем халқына арналған хабарлама бар делінеді
Dialogue: 0,0:46:47.05,0:46:49.34,Default,,0,0,0,,Укутаның орнында болатынына сенімдімін.
Dialogue: 0,0:46:49.47,0:46:51.93,Default,,0,0,0,,Жоқ, тынышталыңыз.
Dialogue: 0,0:46:52.05,0:46:55.27,Default,,0,0,0,,Қазір 17:59… 47, 48, 49…
Dialogue: 0,0:46:55.39,0:46:59.35,Default,,0,0,0,,Келесі, Наоми Минами ісіне қатысты:
Dialogue: 0,0:46:59.48,0:47:00.77,Default,,0,0,0,,Немесе мүмкін
Dialogue: 0,0:47:00.90,0:47:01.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:02.82,0:47:05.94,Default,,0,0,0,,және фотосурет орнына эскиз пайдаланғанымыз жөн болар.
Dialogue: 0,0:47:06.74,0:47:10.57,Default,,0,0,0,,Осыған қарап отырсаңыз, біреуді тек бетімен өлтіруге болады.
Dialogue: 0,0:47:10.70,0:47:12.37,Default,,0,0,0,,Тек нөл болмаса...
Dialogue: 0,0:47:13.74,0:47:15.12,Default,,0,0,0,,Мен қазір айта алатын нәрсе
Dialogue: 0,0:47:15.24,0:47:17.50,Default,,0,0,0,,Кира сол телеарнада.
Dialogue: 0,0:47:17.62,0:47:20.79,Default,,0,0,0,,Егер ол табылса, біз одан бірдеңе біле алар едік.
Dialogue: 0,0:47:20.92,0:47:23.34,Default,,0,0,0,,Егер Кира сол жерде деп ойласаңыз.
Dialogue: 0,0:47:23.46,0:47:24.88,Default,,0,0,0,,Сіз одан әрі баруыңыз керек емес пе?
Dialogue: 0,0:47:25.00,0:47:28.17,Default,,0,0,0,,Сізде жай ғана бақылау камералары орнатылған болуы мүмкін.
Dialogue: 0,0:47:29.13,0:47:31.18,Default,,0,0,0,,Мм... А, Рюзаки!
Dialogue: 0,0:47:31.30,0:47:32.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:36.89,0:47:38.52,Default,,0,0,0,,Хмм!
Dialogue: 0,0:47:38.64,0:47:39.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:43.56,0:47:46.44,Default,,0,0,0,,(Күзетшінің айқайы)
Dialogue: 0,0:47:46.57,0:47:49.82,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:47:49.95,0:47:50.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:52.07,0:47:53.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:47:54.03,0:47:55.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:47:56.29,0:47:59.16,Default,,0,0,0,,Кираның бейнесін қойып жатқан студия қайда?
Dialogue: 0,0:47:59.29,0:48:03.42,Default,,0,0,0,,Ішке асығыс! Көлік Сакура теледидарын соқты
Dialogue: 0,0:48:04.63,0:48:07.71,Default,,0,0,0,,Егер сіз мұны жасасаңыз, станцияға көрінбей кіре аласыз.
Dialogue: 0,0:48:07.84,0:48:10.26,Default,,0,0,0,,Бірақ дәл кім?
Dialogue: 0,0:48:10.38,0:48:13.59,Default,,0,0,0,,Бұл тағы бір тұзақ болуы мүмкін бе?
Dialogue: 0,0:48:13.72,0:48:14.55,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:48:14.68,0:48:17.14,Default,,0,0,0,,Кираның таспасын дереу тоқтатыңыз.
Dialogue: 0,0:48:17.26,0:48:19.56,Default,,0,0,0,,Эй... сәл күте тұрыңыз, детектив.
Dialogue: 0,0:48:19.68,0:48:23.19,Default,,0,0,0,,Егер біз мұны жасамасақ, Кира бізді өлтіреді.
Dialogue: 0,0:48:24.31,0:48:28.23,Default,,0,0,0,,Шығар! Егер мен оны шығарсам, тым болмаса қазір өлуден аулақ бола аламын.
Dialogue: 0,0:48:28.36,0:48:32.15,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:48:32.28,0:48:34.24,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:48:34.36,0:48:36.41,Default,,0,0,0,,Маған қайта қоңырау шалыңыз
Dialogue: 0,0:48:36.53,0:48:38.91,Default,,0,0,0,,осы екінші видеоны тарату үшін
Dialogue: 0,0:48:39.04,0:48:41.58,Default,,0,0,0,,Бұл менмін, Ягами-сан.
Dialogue: 0,0:48:41.71,0:48:43.62,Default,,0,0,0,,Күткендей, сіз колоннадасыз...
Dialogue: 0,0:48:43.75,0:48:47.00,Default,,0,0,0,,Иә, мен қарсы тұра алмадым.
Dialogue: 0,0:48:47.13,0:48:50.46,Default,,0,0,0,,Әрине, мүмкін емес—қандай жағдай болса да, осындай зұлым тұзақ...
Dialogue: 0,0:48:57.22,0:49:01.85,Default,,0,0,0,,Ха... хехе хахахаха...
Dialogue: 0,0:49:01.98,0:49:04.90,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:49:05.02,0:49:07.86,Default,,0,0,0,,Және онда әлем халқына арналған хабарлама бар делінеді
Dialogue: 0,0:49:07.98,0:49:10.61,Default,,0,0,0,,Хаға ұқсайды.
Dialogue: 0,0:49:11.40,0:49:14.49,Default,,0,0,0,,Бұл жігіттің көзі қырғынның көзі болса керек.
Dialogue: 0,0:49:15.07,0:49:19.41,Default,,0,0,0,,Басқаша айтқанда, Кираның өлтіру қабілеті менікінен әлдеқайда жоғары.
Dialogue: 0,0:49:19.53,0:49:21.29,Default,,0,0,0,,Екінші Кира?
Dialogue: 0,0:49:21.41,0:49:25.96,Default,,0,0,0,,Иә, бұл Кира өтірікші болуы мүмкін.
Dialogue: 0,0:49:26.08,0:49:29.46,Default,,0,0,0,,Басқаша айтқанда, оны екінші Кира деп атауға болады.
Dialogue: 0,0:49:30.09,0:49:32.17,Default,,0,0,0,,Жалған қателесіп, ұсталады
Dialogue: 0,0:49:32.30,0:49:35.22,Default,,0,0,0,,Өлім қағазының бар екені белгілі болса жаман болар еді.
Dialogue: 0,0:49:35.34,0:49:37.80,Default,,0,0,0,,Ұзақ уақыт жалғыз қалуға болмайды
Dialogue: 0,0:49:37.93,0:49:40.18,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:49:40.31,0:49:43.43,Default,,0,0,0,,Дәл қазір мен үшін ең идеалдысы
Dialogue: 0,0:49:44.27,0:49:45.89,Default,,0,0,0,,Тергеу штабымен ынтымақтасады
Dialogue: 0,0:49:46.02,0:49:50.11,Default,,0,0,0,,Л-ның қимылын және Кираның жалған қимылын түсіну
Dialogue: 0,0:49:50.98,0:49:51.94,Default,,0,0,0,,осы екінші видеоны тарату үшін
Dialogue: 0,0:49:52.07,0:49:56.32,Default,,0,0,0,,Мен ұлымды тергеумен ынтымақтасуын өтінгенім дұрыс па?
Dialogue: 0,0:49:56.45,0:49:57.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:57.53,0:50:01.62,Default,,0,0,0,,Мен мұны ұлымның күдігі толығымен жойылды деп түсінуге бола ма?
Dialogue: 0,0:50:01.74,0:50:04.08,Default,,0,0,0,,Жарайды, назар аударыңыздар
Dialogue: 0,0:50:04.20,0:50:09.88,Default,,0,0,0,,Менің ойымша, басқа Кираны түсіру үшін бірнеше кеңестер болады.
Dialogue: 0,0:50:16.30,0:50:17.38,Default,,0,0,0,,Әй, теңіз құмы
Dialogue: 0,0:50:18.01,0:50:20.10,Default,,0,0,0,,Мен сізге өлім туралы жазбаны бергеніммен⸺
Dialogue: 0,0:50:20.72,0:50:24.27,Default,,0,0,0,,Оны өзім үшін көбірек пайдалануым керек пе?
Dialogue: 0,0:50:24.39,0:50:26.56,Default,,0,0,0,,Егер ол табылса, біз одан бірдеңе біле алар едік.
Dialogue: 0,0:50:26.69,0:50:29.06,Default,,0,0,0,,Өйткені мен Кирамен келісемін.
Dialogue: 0,0:50:29.19,0:50:31.77,Default,,0,0,0,,Мен Кираның қандай адам екенін білгім келеді.
Dialogue: 0,0:50:31.90,0:50:34.36,Default,,0,0,0,,Мен де кездесіп, сөйлескім келеді.
Dialogue: 0,0:50:35.11,0:50:36.70,Default,,0,0,0,,Төрт күн бұрын біздің бағдарламаның режиссеріне төрт таспа жіберілді
Dialogue: 0,0:50:37.32,0:50:40.41,Default,,0,0,0,,Оларды сөзсіз Кира жіберген
Dialogue: 0,0:50:41.37,0:50:42.74,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:50:42.87,0:50:45.87,Default,,0,0,0,,Кира бейкүнә балаларға мейірімді.
Dialogue: 0,0:50:46.00,0:50:50.75,Default,,0,0,0,,Төтенше жағдайда көзді теңіз құмы күштірек.
Dialogue: 0,0:50:59.22,0:51:01.93,Default,,0,0,0,,Әкем осында келуімді өтінді.
Dialogue: 0,0:51:02.05,0:51:03.64,Default,,0,0,0,,Әлі ерте болды ма?
Dialogue: 0,0:51:03.76,0:51:04.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:51:04.81,0:51:05.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:51:04.81,0:51:05.81,Default,,0,0,0,,Ах
Dialogue: 0,0:51:05.81,0:51:09.10,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:51:09.23,0:51:11.15,Default,,0,0,0,,Хабарламау…
Dialogue: 0,0:51:11.73,0:51:12.73,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:51:12.86,0:51:13.77,Default,,0,0,0,,Иә
Dialogue: 0,0:51:13.90,0:51:16.03,Default,,0,0,0,,Сіз Цуки Ягамисіз бе?
Dialogue: 0,0:51:16.15,0:51:17.86,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:51:17.99,0:51:18.78,Default,,0,0,0,,Бұл Л.
Dialogue: 0,0:51:18.90,0:51:20.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:51:21.24,0:51:24.33,Default,,0,0,0,,Бүгін мен Кира оқиғасы бойынша сізбен кеңескім келеді.
Dialogue: 0,0:51:24.45,0:51:26.66,Default,,0,0,0,,Мен әкемді келуге мәжбүрледім.
Dialogue: 0,0:51:27.54,0:51:30.46,Default,,0,0,0,,Кешіріңіз, мен бос емеспін.
Dialogue: 0,0:51:30.58,0:51:31.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:51:32.00,0:51:33.84,Default,,0,0,0,,Олай болса, мен сізге жол көрсетуге рұқсат етіңіз.
Dialogue: 0,0:51:37.88,0:51:40.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:52:33.02,0:52:33.81,Default,,0,0,0,,Ах
Dialogue: 0,0:52:45.07,0:52:45.87,Default,,0,0,0,,Иә
Dialogue: 0,0:52:45.99,0:52:49.04,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:52:57.79,0:53:01.84,Default,,0,0,0,,Бұл Л. Бүгінгі күнге қош келдіңіздер.
Dialogue: 0,0:53:01.97,0:53:03.38,Default,,0,0,0,,№ L
Dialogue: 0,0:53:03.51,0:53:07.85,Default,,0,0,0,,Мен сенің өнеріңе тәнті болдым.
Dialogue: 0,0:53:08.39,0:53:09.18,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:53:09.31,0:53:13.35,Default,,0,0,0,,Хаха түсіндім, бұл құрмет.
Dialogue: 0,0:53:13.48,0:53:14.90,Default,,0,0,0,,А... а...
Dialogue: 0,0:53:15.02,0:53:17.94,Default,,0,0,0,,Осы жерде мені Рюзаки деп атаңыз.
Dialogue: 0,0:53:18.06,0:53:22.69,Default,,0,0,0,,Енді мен сізге бірден бейнені қарағаныңызды қалаймын.
Dialogue: 0,0:53:22.82,0:53:24.20,Default,,0,0,0,,Қоңырау шалыңыз
Dialogue: 0,0:53:24.32,0:53:25.91,Default,,0,0,0,,Иә, Рюзаки.
Dialogue: 0,0:53:27.95,0:53:29.74,Default,,0,0,0,,О? (Л) Уф хаа
Dialogue: 0,0:53:29.87,0:53:31.24,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:53:38.04,0:53:39.34,Default,,0,0,0,,Бұл басталмайды.
Dialogue: 0,0:53:39.46,0:53:42.71,Default,,0,0,0,,А, мен ұмытып қалдым. Өтінемін, бастаңыз.
Dialogue: 0,0:53:48.35,0:53:50.56,Default,,0,0,0,,Бұл өткен күні...
Dialogue: 0,0:53:50.68,0:53:52.97,Default,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:53:53.10,0:53:57.27,Default,,0,0,0,,Бұл Кираны екінші Кира деп ойлаймыз.
Dialogue: 0,0:53:57.40,0:54:00.94,Default,,0,0,0,,Күні кеше мен нағыз Кираға еліктеп хабарлама жібердім.
Dialogue: 0,0:54:01.82,0:54:03.78,Default,,0,0,0,,Мен нағыз Кирамын
Dialogue: 0,0:54:03.90,0:54:05.99,Default,,0,0,0,,Менің атымды алған адам
Dialogue: 0,0:54:06.11,0:54:10.58,Default,,0,0,0,,Дүниеде тағы да хаос тудыратын болсаң, мен бірінші сені соттаймын.
Dialogue: 0,0:54:11.95,0:54:13.45,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:54:13.58,0:54:17.67,Default,,0,0,0,,Иә, мұны полиция жасаған.
Dialogue: 0,0:54:17.79,0:54:20.96,Default,,0,0,0,,Міне, соған жауап.
Dialogue: 0,0:54:21.09,0:54:23.21,Default,,0,0,0,,Бұл біраз түсініксіз.
Dialogue: 0,0:54:24.26,0:54:27.47,Default,,0,0,0,,Біз бұған дейін білген Кира мұндай күдіктіні кісі өлтірумен қорқыту үшін пайдаланбас еді.
Dialogue: 0,0:54:27.59,0:54:30.30,Default,,0,0,0,,Кира-сан айтқандай істеймін.
Dialogue: 0,0:54:30.43,0:54:32.22,Default,,0,0,0,,Мен Кира-санмен кездескім келеді.
Dialogue: 0,0:54:32.35,0:54:35.06,Default,,0,0,0,,Не? Бұл жігіт
Dialogue: 0,0:54:35.18,0:54:36.60,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:54:36.73,0:54:39.06,Default,,0,0,0,,Кираның көзі жоқ деп ойлаймын.
Dialogue: 0,0:54:39.06,0:54:39.65,Default,,0,0,0,,Кираның көзі жоқ деп ойлаймын.
Dialogue: 0,0:54:39.06,0:54:39.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:39.65,0:54:39.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:39.77,0:54:40.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:39.77,0:54:40.56,Default,,0,0,0,,Мен Кира-санды өлтірмеймін.
Dialogue: 0,0:54:40.56,0:54:42.44,Default,,0,0,0,,Мен Кира-санды өлтірмеймін.
Dialogue: 0,0:54:42.57,0:54:44.15,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:54:42.57,0:54:44.15,Default,,0,0,0,,А... а...
Dialogue: 0,0:54:44.86,0:54:46.49,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:54:46.61,0:54:48.99,Default,,0,0,0,,Қасқырдың көздері ше?
Dialogue: 0,0:54:49.11,0:54:49.91,Default,,0,0,0,,Ha
Dialogue: 0,0:54:53.33,0:54:55.45,Default,,0,0,0,,Полиция білмейтін нәрсе⸺
Dialogue: 0,0:54:55.58,0:54:57.96,Default,,0,0,0,,Кездесудің жақсы әдісін ойлаңыз.
Dialogue: 0,0:54:55.58,0:54:57.96,Default,,0,0,0,,Жоқ, ренжімеңіз.
Dialogue: 0,0:54:58.08,0:55:02.17,Default,,0,0,0,,Кездескен кезде бір-біріңіздің Шинигамиді көрсету арқылы растай аласыз.
Dialogue: 0,0:55:02.88,0:55:07.17,Default,,0,0,0,,Жоқ, бұл жігіт... Маған тезірек бірдеңе істеу керек.
Dialogue: 0,0:55:23.94,0:55:25.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:55:25.82,0:55:27.44,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:55:27.57,0:55:29.53,Default,,0,0,0,,Біріншіден, бұл Кира ойдан да артық.
Dialogue: 0,0:55:29.65,0:55:33.03,Default,,0,0,0,,Ол Кирамен кездесуді қалайды.
Dialogue: 0,0:55:33.66,0:55:37.75,Default,,0,0,0,,Ең бастысы, «шинигами» сөзі
Dialogue: 0,0:55:37.87,0:55:39.41,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:55:51.43,0:55:53.05,Default,,0,0,0,,(Айзава) Бірінші жекпе-жек бойынша ой елегінен өткізуге арналған негізгі тармақтарды айтыңыз
Dialogue: 0,0:55:54.26,0:55:55.93,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:55:56.06,0:55:58.68,Default,,0,0,0,,Жарайды, жарайды, жарайды, Миса Чан.
Dialogue: 0,0:55:58.81,0:56:00.44,Default,,0,0,0,,Керемет! (Теңіз құмы) Уууу
Dialogue: 0,0:56:00.56,0:56:01.48,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:56:02.06,0:56:04.69,Default,,0,0,0,,Ах~ шаршадым~
Dialogue: 0,0:56:04.81,0:56:07.90,Default,,0,0,0,,Модельдеу жұмыстары да дене күшін сынау болып табылады.
Dialogue: 0,0:56:09.11,0:56:11.32,Default,,0,0,0,,Сәлем, Рем?
Dialogue: 0,0:56:11.45,0:56:13.16,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:56:13.28,0:56:14.62,Default,,0,0,0,,Не?
Dialogue: 0,0:56:14.74,0:56:18.08,Default,,0,0,0,,Өлім туралы жазбасы болмаса, Қасқырдың пайдасы жоқ.
Dialogue: 0,0:56:18.20,0:56:21.83,Default,,0,0,0,,Адамға өлім кітабын беріп, онымен ойнау үшін екі кітап қажет.
Dialogue: 0,0:56:21.96,0:56:24.63,Default,,0,0,0,,Рюк Кираға блокнот берді.
Dialogue: 0,0:56:24.75,0:56:28.59,Default,,0,0,0,,Сонымен, сіз Қасқырды алдап, екінші кітапты алдыңыз ба?
Dialogue: 0,0:56:28.71,0:56:30.34,Default,,0,0,0,,Иә
Dialogue: 0,0:56:30.47,0:56:31.93,Default,,0,0,0,,Сонымен, Рем туралы не деуге болады?
Dialogue: 0,0:56:32.05,0:56:37.01,Default,,0,0,0,,Жоқ, Ұлы Шинигами оңай алдайтын адам емес.
Dialogue: 0,0:56:37.14,0:56:38.52,Default,,0,0,0,,Сонда қалай...
Dialogue: 0,0:56:39.56,0:56:42.23,Default,,0,0,0,,Мен Шинигами әлеміндегі санаулылардың бірімін⸺
Dialogue: 0,0:56:42.35,0:56:46.48,Default,,0,0,0,,Ол Шинигамиді қалай өлтіруді біледі, сондықтан ол Шинигами...
Dialogue: 0,0:56:47.44,0:56:49.15,Default,,0,0,0,,делік
Dialogue: 0,0:56:55.82,0:56:59.83,Default,,0,0,0,,Мен Шинигами әлемінен бір қызды көріп жүрмін⸺
Dialogue: 0,0:56:59.95,0:57:02.66,Default,,0,0,0,,Қызғаныш деген өлім құдайы болған.
Dialogue: 0,0:57:23.64,0:57:25.73,Default,,0,0,0,,Мен сені әлемдегі басқалардан артық жақсы көремін
Dialogue: 0,0:57:25.85,0:57:27.98,Default,,0,0,0,,Үнемі саған қараймын, сені қорғағым келеді!
Dialogue: 0,0:57:28.11,0:57:29.27,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:57:30.32,0:57:31.28,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,0:57:31.40,0:57:33.44,Default,,0,0,0,,Уф! О... эй!
Dialogue: 0,0:57:33.57,0:57:37.32,Default,,0,0,0,,Тоқтамаңыз! Хмм… мм…
Dialogue: 0,0:57:37.95,0:57:42.16,Default,,0,0,0,,Қызғаныш Шинигами жасамауы керек нәрсені жасады.
Dialogue: 0,0:57:42.29,0:57:43.41,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:57:42.29,0:57:43.41,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,0:57:43.41,0:57:44.00,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,0:57:44.96,0:57:45.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:52.26,0:57:55.30,Default,,0,0,0,,Қызға көмектесемін деп қызғанады
Dialogue: 0,0:57:55.43,0:57:57.89,Default,,0,0,0,,Мен дәптерімді пайдаландым
Dialogue: 0,0:57:58.72,0:58:00.14,Default,,0,0,0,,Бірақ бұл жақсы емес.
Dialogue: 0,0:58:00.26,0:58:01.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:02.10,0:58:05.64,Default,,0,0,0,,Grim Reaper адам өмірін қысқартады
Dialogue: 0,0:58:05.77,0:58:09.44,Default,,0,0,0,,Тек қабылдау үшін бар
Dialogue: 0,0:58:09.56,0:58:13.61,Default,,0,0,0,,А... аа... уф
Dialogue: 0,0:58:14.94,0:58:16.57,Default,,0,0,0,,Дәл сол сәтте,
Dialogue: 0,0:58:16.70,0:58:20.91,Default,,0,0,0,,Қызғаныш құмнан, тоттан айырмашылығы жоқ нәрсеге айналады.
Dialogue: 0,0:58:21.03,0:58:22.37,Default,,0,0,0,,Эй!
Dialogue: 0,0:58:24.29,0:58:27.83,Default,,0,0,0,,Артында тек Өлім туралы жазба қалды.
Dialogue: 0,0:58:33.55,0:58:35.59,Default,,0,0,0,,Балаға ғашық болмасаң
Dialogue: 0,0:58:35.72,0:58:38.47,Default,,0,0,0,,Демек, Аңшылық өлген жоқ па?
Dialogue: 0,0:58:38.59,0:58:40.35,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:58:41.18,0:58:42.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:43.01,0:58:44.97,Default,,0,0,0,,Белгіленген күн мен уақытқа дейін жауап беріңіз
Dialogue: 0,0:58:46.06,0:58:50.52,Default,,0,0,0,,Мені құтқарған адам қызғаныш атты өлім құдайы еді...
Dialogue: 0,0:58:55.03,0:58:56.82,Default,,0,0,0,,көремін.
Dialogue: 0,0:58:56.95,0:59:01.74,Default,,0,0,0,,Шинигамиді өлтіру үшін адамды оған ғашық етіп, оған көмектесу керек.
Dialogue: 0,0:59:02.70,0:59:05.41,Default,,0,0,0,,Бірақ мен Кираға айта алатын оқиға осы.
Dialogue: 0,0:59:05.54,0:59:06.50,Default,,0,0,0,,Мен мұны қайтадан жасадым
Dialogue: 0,0:59:06.62,0:59:09.54,Default,,0,0,0,,Сіз білесіз бе? Қылмыскер...
Dialogue: 0,0:59:10.21,0:59:13.25,Default,,0,0,0,,････
Dialogue: 0,0:59:25.22,0:59:27.10,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:59:38.95,0:59:41.24,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:59:45.58,0:59:49.29,Default,,0,0,0,,... Танысқаныма қуаныштымын, Я, мен Мисамын.
Dialogue: 0,0:59:49.41,0:59:52.92,Default,,0,0,0,,Теледидар көріп отырғанда, мен сені уайымдайтын шығар деп ойладым.
Dialogue: 0,0:59:53.04,0:59:56.55,Default,,0,0,0,,Мен бұл жазбаға қарсы тұра алмадым.
Dialogue: 0,0:59:56.67,0:59:59.17,Default,,0,0,0,,Ха… Өлім туралы жазба
Dialogue: 0,1:00:05.10,1:00:08.22,Default,,0,0,0,,А... Қасқыр!
Dialogue: 0,1:00:08.89,1:00:10.44,Default,,0,0,0,,және кім білсін, матч тіпті тоқтатылып қалуы мүмкін.
Dialogue: 0,1:00:11.02,1:00:12.06,Default,,0,0,0,,Саған хабарлап қояйын, бәлкім қажет болады.
Dialogue: 0,1:00:13.52,1:00:15.73,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,1:00:26.28,1:00:27.45,Default,,0,0,0,,Жырақта!
Dialogue: 0,1:00:27.58,1:00:31.50,Default,,0,0,0,,А-а... Менің ойымша, біз көз алмадық.
Dialogue: 0,1:00:31.62,1:00:32.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:32.83,1:00:34.83,Default,,0,0,0,,Өлім құдайының көзі бар
Dialogue: 0,1:00:34.96,1:00:38.17,Default,,0,0,0,,Адамның өмір сүру ұзақтығы мен есімін көре алады
Dialogue: 0,1:00:38.30,1:00:42.59,Default,,0,0,0,,Бірақ дәптерді ұстаған адамның өмір сүру ұзақтығын көре алмаймыз.
Dialogue: 0,1:00:44.30,1:00:45.55,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:00:49.31,1:00:52.77,Default,,0,0,0,,Ягами… Цуки-кун ба?
Dialogue: 0,1:00:52.89,1:00:57.15,Default,,0,0,0,,Мен бір ғана адамның өмірін көре алмаймын Кира шешті!
Dialogue: 0,1:00:57.27,1:01:01.24,Default,,0,0,0,,Мұнда ақымақ сөз айтпаған жөн; оның қалай әрекет ететінін күтіп көрейік
Dialogue: 0,1:01:02.03,1:01:04.45,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,1:01:05.11,1:01:09.66,Default,,0,0,0,,Егер сізді полиция ұстап алса, Кираның құпиясы ашылатын еді.
Dialogue: 0,1:01:09.79,1:01:13.33,Default,,0,0,0,,Ол 30 мамырда дәл осылай жасамақшы дегендей.
Dialogue: 0,1:01:13.46,1:01:17.75,Default,,0,0,0,,Бұдан былай сенің айтқаныңды істесем, ұсталмаймын, солай ма?
Dialogue: 0,1:01:18.38,1:01:20.71,Default,,0,0,0,,Мен Л-ның атын көріп тұрмын
Dialogue: 0,1:01:21.46,1:01:23.72,Default,,0,0,0,,Мен сенің көзің боламын
Dialogue: 0,1:01:24.59,1:01:25.39,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:01:28.22,1:01:29.31,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:01:30.31,1:01:31.89,Default,,0,0,0,,Өтінемін, ол болыңыз
Dialogue: 0,1:01:32.02,1:01:35.19,Default,,0,0,0,,Не... қызым?
Dialogue: 0,1:01:35.94,1:01:36.98,Default,,0,0,0,,Иә
Dialogue: 0,1:01:37.11,1:01:38.69,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,1:01:38.82,1:01:42.36,Default,,0,0,0,,Егер сіз бұл жігітке жамандық жасасаңыз, сізді өлтіруіңіз мүмкін.
Dialogue: 0,1:01:42.49,1:01:43.90,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:01:44.03,1:01:45.15,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:01:45.91,1:01:50.41,Default,,0,0,0,,Теледидар станциясына жіберген барлық нәрседе бірдей саусақ ізі бар.
Dialogue: 0,1:01:50.54,1:01:52.75,Default,,0,0,0,,Қазірше оны ақымақ деп атаудан басқа амалым жоқ
Dialogue: 0,1:01:52.87,1:01:55.62,Default,,0,0,0,,Дәл солай. Кирамен «Джайентс» матчында кездесу идеясы тым ашық,
Dialogue: 0,1:01:55.75,1:01:57.33,Default,,0,0,0,,Я...
Dialogue: 0,1:01:57.92,1:02:00.25,Default,,0,0,0,,Ол жай ғана отыра тұрып күте алмай ма?
Dialogue: 0,1:02:00.38,1:02:03.59,Default,,0,0,0,,Мына дәптерді сақтаңыз.
Dialogue: 0,1:02:05.63,1:02:07.72,Default,,0,0,0,,Осылайша мен сені өлтіре алмаймын.
Dialogue: 0,1:02:07.84,1:02:11.85,Default,,0,0,0,,Ол 30 мамырда дәл осылай жасамақшы дегендей.
Dialogue: 0,1:02:12.64,1:02:14.85,Default,,0,0,0,,Бұл жігіт мұнда неге...
Dialogue: 0,1:02:15.81,1:02:18.69,Default,,0,0,0,,Бірақ мен дәптерімнен біраз парақтарды қиып алдым.
Dialogue: 0,1:02:18.81,1:02:20.69,Default,,0,0,0,,Эй, Рем
Dialogue: 0,1:02:20.82,1:02:23.86,Default,,0,0,0,,Уф... неге сонша күмәндісің!?
Dialogue: 0,1:02:23.99,1:02:28.78,Default,,0,0,0,,Маған сеніңіз, мен сізді пайдаланғаныңыз дұрыс.
Dialogue: 0,1:02:30.24,1:02:31.99,Default,,0,0,0,,Осыншалықты қалай айта аласыз?
Dialogue: 0,1:02:32.12,1:02:33.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:34.41,1:02:40.75,Default,,0,0,0,,Осыдан тура бір жыл бұрын ата-анам менің көз алдымда қарақшылар қолынан қаза тапты.
Dialogue: 0,1:02:41.71,1:02:43.71,Default,,0,0,0,,Дәптерге ие адамдар бір-бірінің өмір жасын да көре алмайды.
Dialogue: 0,1:02:44.38,1:02:48.47,Default,,0,0,0,,Бірақ сот процесі созылып жатыр, ақырында біз бұл жалған айыптау болатын деңгейге жеттік...
Dialogue: 0,1:02:49.59,1:02:53.85,Default,,0,0,0,,Сол кезде қылмыскерді жауапқа тартқан Кира болатын.
Dialogue: 0,1:02:54.60,1:02:58.19,Default,,0,0,0,,Мен үшін Кира – абсолютті болмыс.
Dialogue: 0,1:03:00.23,1:03:01.19,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,1:03:02.15,1:03:04.15,Default,,0,0,0,,Мен сенімен танысқым келді
Dialogue: 0,1:03:04.82,1:03:06.99,Default,,0,0,0,,Мен рахмет айтқым келді.
Dialogue: 0,1:03:21.96,1:03:22.88,Default,,0,0,0,,Ах ха...
Dialogue: 0,1:03:27.92,1:03:30.72,Default,,0,0,0,,А... а...
Dialogue: 0,1:03:32.97,1:03:34.35,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:03:34.47,1:03:37.35,Default,,0,0,0,,Мен сенің жігітің бола алмаймын, бірақ мен сенің жігітің болып көріне аламын.
Dialogue: 0,1:03:38.23,1:03:41.90,Default,,0,0,0,,Дәл солай. Кирамен «Джайентс» матчында кездесу идеясы тым ашық,
Dialogue: 0,1:03:42.02,1:03:46.03,Default,,0,0,0,,Қалған ғұмырыңды екіге қысқартқан көздерің қаруға айналады.
Dialogue: 0,1:03:47.19,1:03:51.61,Default,,0,0,0,,Рахмет. Мен сені ұнату үшін барымды саламын.
Dialogue: 0,1:03:58.16,1:04:02.92,Default,,0,0,0,,Фуфуфу... хахахаха...
Dialogue: 0,1:04:10.68,1:04:13.09,Default,,0,0,0,,Хаха, бұл дұрыс емес.
Dialogue: 0,1:04:13.22,1:04:15.22,Default,,0,0,0,,Мен сенің оны өлтіруге тартынғаныңды «достар» туралы сөйлей бастағаныңнан деп ойладым.
Dialogue: 0,1:04:15.35,1:04:16.51,Default,,0,0,0,,Ха…
Dialogue: 0,1:04:25.73,1:04:30.53,Default,,0,0,0,,Әй, Ягами-кун! Сәлем
Dialogue: 0,1:04:30.65,1:04:31.90,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:35.07,1:04:36.83,Default,,0,0,0,,Не болды? Рюзаки
Dialogue: 0,1:04:36.95,1:04:39.37,Default,,0,0,0,,Бетіңізді осылай көрсетуге бола ма?
Dialogue: 0,1:04:39.50,1:04:42.46,Default,,0,0,0,,Ягами-кун Кира болмаса, бәрі жақсы.
Dialogue: 0,1:04:42.58,1:04:44.13,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:44.25,1:04:45.96,Default,,0,0,0,,Мен айтуды ұмытып кетіппін
Dialogue: 0,1:04:46.09,1:04:50.26,Default,,0,0,0,,Мен Цуки-кунды Кира деп ойлаймын.
Dialogue: 0,1:04:50.38,1:04:52.97,Default,,0,0,0,,Бұл шамамен 5% ғана.
Dialogue: 0,1:04:53.93,1:04:58.35,Default,,0,0,0,,Қазіргі уақытта Цуки-кун менің Л екенімді білетін сырттағы жалғыз адам.
Dialogue: 0,1:04:59.10,1:05:01.39,Default,,0,0,0,,Егер мен тез арада өлтірілсем
Dialogue: 0,1:05:01.52,1:05:05.52,Default,,0,0,0,,Мен штаб-пәтерде барлығына Цуки Ягамидің Кира екенін айттым.
Dialogue: 0,1:05:05.65,1:05:06.61,Default,,0,0,0,,Ха…
Dialogue: 0,1:05:07.40,1:05:09.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:11.19,1:05:13.61,Default,,0,0,0,,Хахахаха...
Dialogue: 0,1:05:13.74,1:05:16.82,Default,,0,0,0,,Осы жігітті өлтіремін деп ойлағанымда, Нококо шықты.
Dialogue: 0,1:05:16.95,1:05:19.04,Default,,0,0,0,,Біз бірге кешкі ас ішіп, түнгі көріністі тамашалаймыз.
Dialogue: 0,1:05:19.16,1:05:22.41,Default,,0,0,0,,Бұл жігіттің қалауы осы емес пе?
Dialogue: 0,1:05:22.96,1:05:26.08,Default,,0,0,0,,Ай! Міне болды!
Dialogue: 0,1:05:26.21,1:05:28.71,Default,,0,0,0,,Иә…♡
Dialogue: 0,1:05:28.84,1:05:30.96,Default,,0,0,0,,Теңіз құмы! ақымақ!
Dialogue: 0,1:05:31.09,1:05:35.18,Default,,0,0,0,,Айдың достары? Бұл ерекше және жақсы
Dialogue: 0,1:05:36.05,1:05:37.55,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,1:05:38.39,1:05:41.39,Default,,0,0,0,,Рюзакидің шын есімі теңіз құмында көрінеді
Dialogue: 0,1:05:41.52,1:05:45.52,Default,,0,0,0,,Мен, Цуки но Каноджо но Я, Мисуна, танысқаныма қуаныштымын.
Dialogue: 0,1:05:45.65,1:05:46.81,Default,,0,0,0,,менің Кира екенім туралы күшті күдікке дайын болуым керек
Dialogue: 0,1:05:46.94,1:05:48.94,Default,,0,0,0,,Иә? Рукава Хиросики…
Dialogue: 0,1:05:50.11,1:05:54.74,Default,,0,0,0,,Аа, мына жігіттің аты мен фамилиясы ана кумирмен бірдей. Күлкілі емес пе?
Dialogue: 0,1:05:55.61,1:05:58.74,Default,,0,0,0,,Мен басынан-ақ: «Егер ол достық іздесе, мен оны қабылдаймын» дедім ғой.
Dialogue: 0,1:05:58.87,1:06:03.29,Default,,0,0,0,,Рюзаки: Бұл жолы болған оқиға кері әсер етті...
Dialogue: 0,1:06:03.41,1:06:04.25,Default,,0,0,0,,Ха!
Dialogue: 0,1:06:04.37,1:06:07.25,Default,,0,0,0,,Эхехе... Эхехе...
Dialogue: 0,1:06:07.88,1:06:09.25,Default,,0,0,0,,Не? Сол күлкі
Dialogue: 0,1:06:09.96,1:06:12.71,Default,,0,0,0,,Бұл жігіт тіпті байқады ма?
Dialogue: 0,1:06:12.84,1:06:15.68,Default,,0,0,0,,Бірақ екінші Кира мүмкіндігін қарастырсақ.
Dialogue: 0,1:06:15.80,1:06:18.05,Default,,0,0,0,,Мен күлуім керек...
Dialogue: 0,1:06:18.93,1:06:20.05,Default,,0,0,0,,Ұлың қайтадан үйге келді
Dialogue: 0,1:06:20.18,1:06:22.10,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:22.22,1:06:23.85,Default,,0,0,0,,Қалған күнде де, дәлел болмайды.
Dialogue: 0,1:06:23.98,1:06:24.85,Default,,0,0,0,,Ха…
Dialogue: 0,1:06:24.98,1:06:28.35,Default,,0,0,0,,«Он сегіз» Мен тамыз санындағы Мисаның жанкүйерімін.
Dialogue: 0,1:06:28.48,1:06:30.61,Default,,0,0,0,,Иә? Шынымен бе? бақытты!
Dialogue: 0,1:06:30.73,1:06:33.11,Default,,0,0,0,,А, бұл қыз Миса Миса емес пе?
Dialogue: 0,1:06:33.23,1:06:34.90,Default,,0,0,0,,Бұл рас, бұл Миса Миса!
Dialogue: 0,1:06:35.03,1:06:36.86,Default,,0,0,0,,Иә, Миса Миса? (Ер студент) Иә? Бұл шын ба?
Dialogue: 0,1:06:36.99,1:06:39.24,Default,,0,0,0,,Өйткені, жастар көп болса, халық біледі.
Dialogue: 0,1:06:39.37,1:06:42.41,Default,,0,0,0,,Мен оны ай сайын көремін! (Қыз студент) Сәттілік!
Dialogue: 0,1:06:42.54,1:06:44.45,Default,,0,0,0,,Біз бірге кешкі ас ішіп, түнгі көріністі тамашалаймыз.
Dialogue: 0,1:06:44.58,1:06:45.91,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:06:46.04,1:06:50.79,Default,,0,0,0,,Умиса Уақыт та қалды. Тағы да кешігіп қаласыз ба?
Dialogue: 0,1:06:50.92,1:06:52.59,Default,,0,0,0,,Кешіріңіз Йоши
Dialogue: 0,1:06:52.71,1:06:55.38,Default,,0,0,0,,Кеттік (Умиса) Ух... Иә.
Dialogue: 0,1:06:55.51,1:06:58.97,Default,,0,0,0,,Жақсы, егер бұл жерден теңіз құмы кетсе.
Dialogue: 0,1:06:59.09,1:07:01.60,Default,,0,0,0,,Осыдан кейін мен сіздің атыңызды телефон арқылы біле аламын.
Dialogue: 0,1:07:02.22,1:07:06.10,Default,,0,0,0,,Келесі айда кездескенше~ Жұмыстан кейін~
Dialogue: 0,1:07:10.60,1:07:13.69,Default,,0,0,0,,Ал, кеттік, Ягами-кун (Ай) А.
Dialogue: 0,1:07:14.44,1:07:18.28,Default,,0,0,0,,Жақында лекциям бар, кейін сөйлесе аламыз ба?
Dialogue: 0,1:07:18.40,1:07:21.32,Default,,0,0,0,,көремін. Кейінірек кездесеміз.
Dialogue: 0,1:07:33.54,1:07:34.71,Default,,0,0,0,,Бітті
Dialogue: 0,1:07:36.01,1:07:38.59,Default,,0,0,0,,Өте қызық болды Л
Dialogue: 0,1:07:47.39,1:07:50.27,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:07:50.98,1:07:53.61,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:07:53.73,1:07:54.52,Default,,0,0,0,,Иә
Dialogue: 0,1:07:56.40,1:07:59.15,Default,,0,0,0,,Ә? Не? Әлі жеті де болған жоқ қой.
Dialogue: 0,1:08:00.03,1:08:00.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:08:02.82,1:08:07.04,Default,,0,0,0,,Менің ойымша, Ягами-кун не қуанышты, не мұңды.
Dialogue: 0,1:08:07.70,1:08:11.04,Default,,0,0,0,,Я Умиса екінші Кира күдікті ретінде қамауға алынды.
Dialogue: 0,1:08:11.17,1:08:13.29,Default,,0,0,0,,Не... (Рюк) Вухё
Dialogue: 0,1:08:13.42,1:08:16.05,Default,,0,0,0,,Біз теңіз құмы туралы қашаннан бері айта бастадық...
Dialogue: 0,1:08:16.17,1:08:20.55,Default,,0,0,0,,Екінші Кира Я бөлмесінен бейне таспаны жіберген кезде.
Dialogue: 0,1:08:21.22,1:08:23.14,Default,,0,0,0,,Ол жабысқақ таспаға жабысып қалды⸺
Dialogue: 0,1:08:23.26,1:08:27.39,Default,,0,0,0,,Көптеген дәлелдер, соның ішінде шаш пен киім талшықтары болды.
Dialogue: 0,1:08:28.39,1:08:32.39,Default,,0,0,0,,Кираға екінші күдік бар болғандықтан, жұртшылықтың шатасуы күтілуде.
Dialogue: 0,1:08:32.52,1:08:36.11,Default,,0,0,0,,айналада ешкім жоқ екеніне көз жеткізіп, дауысыңды бәсеңдет.
Dialogue: 0,1:08:36.90,1:08:39.19,Default,,0,0,0,,Мен де Рюкпен солай істеймін.
Dialogue: 0,1:08:41.36,1:08:43.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:43.16,1:08:45.49,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:46.99,1:08:49.75,Default,,0,0,0,,Рю... Рюзаки Бұл не!?
Dialogue: 0,1:08:50.87,1:08:52.96,Default,,0,0,0,,Мен оны екінші Кира ретінде ұстадым.
Dialogue: 0,1:08:53.08,1:08:55.08,Default,,0,0,0,,L – Кираның жауы.
Dialogue: 0,1:08:55.88,1:08:57.88,Default,,0,0,0,,Ал Ягами мырза (Соичиро) Ах...
Dialogue: 0,1:08:58.00,1:09:00.92,Default,,0,0,0,,Цуки-кун Кира үшін маңызды анықтама ретінде
Dialogue: 0,1:09:01.05,1:09:02.93,Default,,0,0,0,,Мен сізге телефон соғамын деп ойлаймын.
Dialogue: 0,1:09:03.05,1:09:05.14,Default,,0,0,0,,Дайын болыңыз (Соичиро)...
Dialogue: 0,1:09:12.77,1:09:13.85,Default,,0,0,0,,Ой, шын ба?
Dialogue: 0,1:09:14.85,1:09:16.23,Default,,0,0,0,,Лайт Ягами
Dialogue: 0,1:09:17.02,1:09:20.82,Default,,0,0,0,,Умисаны өлім туралы естеліктерінен бас тартуға мәжбүр етті.
Dialogue: 0,1:09:21.90,1:09:25.61,Default,,0,0,0,,Енді дәптердің барлық жады өшіріледі.
Dialogue: 0,1:09:26.24,1:09:29.87,Default,,0,0,0,,Құпиялар енді теңіз құмынан ағып кетпейді
Dialogue: 0,1:09:31.50,1:09:35.12,Default,,0,0,0,,Мен оны жіберейін десем де Умиса бас тартты.
Dialogue: 0,1:09:36.33,1:09:40.09,Default,,0,0,0,,Адамдар өздерінің ерекше күштері бар деп ойлайды
Dialogue: 0,1:09:40.21,1:09:44.13,Default,,0,0,0,,Ой, жарай берші — ертең бе?
Dialogue: 0,1:09:44.26,1:09:48.60,Default,,0,0,0,,Мұның бәрі мен сені жақсы көргім келгендіктен.
Dialogue: 0,1:09:49.43,1:09:51.10,Default,,0,0,0,,Лайт Ягами
Dialogue: 0,1:09:51.89,1:09:54.02,Default,,0,0,0,,Умисанды құтқармасақ
Dialogue: 0,1:09:54.14,1:09:56.23,Default,,0,0,0,,«Егер ол рас болса, біз жасырын кіре алар едік» деп сен айтқан едің ғой?
Dialogue: 0,1:10:34.02,1:10:38.44,Default,,0,0,0,,Осылайша Я мен Цуки Ягами бір апта түрмеге қамалды.
Dialogue: 0,1:10:39.06,1:10:42.32,Default,,0,0,0,,Кираның қылмыскерлерге үкімі кенет тоқтады.
Dialogue: 0,1:10:43.07,1:10:45.90,Default,,0,0,0,,Екеуі Кира екені анық.
Dialogue: 0,1:10:46.03,1:10:50.78,Default,,0,0,0,,Бірақ неліктен сіз қамауды мойынсұнып қабылдадыңыз?
Dialogue: 0,1:10:50.91,1:10:54.25,Default,,0,0,0,,Сіз Кира болсаңыз да, сіз оны «түсінбедіңіз».
Dialogue: 0,1:10:54.37,1:10:57.50,Default,,0,0,0,,Сізге тек итеру керек деп ойлайсыз ба?
Dialogue: 0,1:10:58.37,1:11:00.33,Default,,0,0,0,,Ягами Цукиге ұқсамайды.
Dialogue: 0,1:11:00.46,1:11:03.34,Default,,0,0,0,,Мен саған берген дәптерімнің жерге көміліп қалатынын ешқашан ойламаған едім
Dialogue: 0,1:11:12.26,1:11:17.18,Default,,0,0,0,,Цуки-кун, бар болғаны бір апта болды, бірақ сіз өзіңізді қорлық сезіне бастадыңыз.
Dialogue: 0,1:11:17.31,1:11:19.14,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:11:21.36,1:11:24.61,Default,,0,0,0,,Уақыт келді. Осы уақытқа дейін жетсек...
Dialogue: 0,1:11:30.24,1:11:34.79,Default,,0,0,0,,А, мен өзімді жақсы формада емеспін деп ойлаймын.
Dialogue: 0,1:11:34.91,1:11:36.91,Default,,0,0,0,,Мұндай түкке тұрғысыз мақтаныш...
Dialogue: 0,1:11:38.50,1:11:39.29,Default,,0,0,0,,осындай ұсақ-түйек намысты ысырып қоямын
Dialogue: 0,1:11:39.42,1:11:40.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:43.54,1:11:46.34,Default,,0,0,0,,Ой... жарайды.
Dialogue: 0,1:11:54.14,1:11:55.93,Default,,0,0,0,,Иә.
Dialogue: 0,1:11:59.44,1:12:00.73,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:12:06.03,1:12:09.70,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:12:10.78,1:12:11.57,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,1:12:12.28,1:12:13.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:14.16,1:12:17.12,Default,,0,0,0,,Мен мұны не үшін істеп жатырмын?
Dialogue: 0,1:12:17.87,1:12:18.70,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:12:18.83,1:12:21.96,Default,,0,0,0,,Түрмеге отыруға келісім бергенім рас.
Dialogue: 0,1:12:22.08,1:12:23.96,Default,,0,0,0,,Мен мұны таңдадым.
Dialogue: 0,1:12:24.08,1:12:28.13,Default,,0,0,0,,Бірақ қазір мен мұны істеудің қажеті жоқ екенін анық түсіндім.
Dialogue: 0,1:12:28.26,1:12:29.05,Default,,0,0,0,,Әй?
Dialogue: 0,1:12:29.17,1:12:30.72,Default,,0,0,0,,Өйткені мен Кира емеспін
Dialogue: 0,1:12:30.84,1:12:32.97,Default,,0,0,0,,Мен осы қиындыққа тап болдым
Dialogue: 0,1:12:33.68,1:12:36.10,Default,,0,0,0,,Не болды? Цуки Ягами
Dialogue: 0,1:12:36.22,1:12:38.18,Default,,0,0,0,,Сенің айтып тұрғаның – әбігер.
Dialogue: 0,1:12:38.31,1:12:41.48,Default,,0,0,0,,Э? О, иә.
Dialogue: 0,1:12:41.60,1:12:44.69,Default,,0,0,0,,Тез шығарып беріңізші, бұл бос уақыт.
Dialogue: 0,1:12:44.81,1:12:47.11,Default,,0,0,0,,Жоқ, сіз оны өшіре алмайсыз.
Dialogue: 0,1:12:47.23,1:12:50.99,Default,,0,0,0,,Сіз қателесесіз. Әзірге тергеу жағдайы негізінде.
Dialogue: 0,1:12:51.11,1:12:54.62,Default,,0,0,0,,Мен Кира екенімді шығарып жатқаныңызды түсіндім, бірақ бұл тұзақ.
Dialogue: 0,1:12:54.74,1:12:56.53,Default,,0,0,0,,Сен ақымақсың ғой, иә?
Dialogue: 0,1:12:56.66,1:12:59.79,Default,,0,0,0,,Үлкейтіңіз немесе кез келген нәрсені өзгертіңіз және менің көзіме қараңыз!
Dialogue: 0,1:12:59.91,1:13:03.04,Default,,0,0,0,,Бұл өтірікші адамның көздері ме?
Dialogue: 0,1:13:04.75,1:13:05.54,Default,,0,0,0,,Уф...
Dialogue: 0,1:13:07.46,1:13:08.38,Default,,0,0,0,,Я теңіз құмы
Dialogue: 0,1:13:08.50,1:13:11.30,Default,,0,0,0,,Аа, Сталкер мырза, не?
Dialogue: 0,1:13:11.42,1:13:12.80,Default,,0,0,0,,Эй, мистер Столкер
Dialogue: 0,1:13:13.43,1:13:16.35,Default,,0,0,0,,Сен неге қазір байланып қалдың?
Dialogue: 0,1:13:16.47,1:13:19.43,Default,,0,0,0,,Умисуна неліктен кумир?
Dialogue: 0,1:13:19.56,1:13:22.31,Default,,0,0,0,,Бірақ мұның бәрін мен үшін жасаған аңдыушы
Dialogue: 0,1:13:22.43,1:13:23.94,Default,,0,0,0,,Сіз біріншісіз
Dialogue: 0,1:13:24.06,1:13:26.73,Default,,0,0,0,,Сіз Кираның кім екенін шынымен де білмейсіз ғой, солай ма?
Dialogue: 0,1:13:26.86,1:13:30.86,Default,,0,0,0,,Иә? Тағы да солай ма? Мен теңіз құмын білгім келеді
Dialogue: 0,1:13:31.94,1:13:32.86,Default,,0,0,0,,Мен осы дәптерге деген меншік құқығымнан бас тартамын…
Dialogue: 0,1:13:32.99,1:13:37.78,Default,,0,0,0,,Кеше бір күнде екі аптадан астам сотталмаған қылмыскерлер кенеттен қайтыс болды.
Dialogue: 0,1:13:37.91,1:13:40.29,Default,,0,0,0,,Ах, Кира қайтып келді.
Dialogue: 0,1:13:41.08,1:13:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:46.46,1:13:49.13,Default,,0,0,0,,Мен оның не екенін білмеймін
Dialogue: 0,1:13:57.55,1:13:59.26,Default,,0,0,0,,Цуки-кун мен Миса-миса да
Dialogue: 0,1:13:59.39,1:14:03.06,Default,,0,0,0,,Бақылаумен болса да, қалыпты өмірге оралғаныма қуаныштымын.
Dialogue: 0,1:14:03.18,1:14:06.23,Default,,0,0,0,,Бірақ Мацуда, мені Миса Миса деп атама!
Dialogue: 0,1:14:06.90,1:14:10.98,Default,,0,0,0,,Эй, бұл кездесу емес сияқты.
Dialogue: 0,1:14:11.11,1:14:13.86,Default,,0,0,0,,Мен сізден тергеуде ынтымақтасуыңызды сұрағаныма қарамастан.
Dialogue: 0,1:14:13.99,1:14:17.87,Default,,0,0,0,,Сіз әлі күдіктісіз, сабырлы болыңыз.
Dialogue: 0,1:14:18.57,1:14:22.79,Default,,0,0,0,,Оның орнына біз бірге зерттеуді шештік.
Dialogue: 0,1:14:22.91,1:14:25.58,Default,,0,0,0,,Рюзаки, сенде мотивация мүлдем жоқ.
Dialogue: 0,1:14:26.54,1:14:28.46,Default,,0,0,0,,Мотивацияңыз бар ма...
Dialogue: 0,1:14:29.29,1:14:32.92,Default,,0,0,0,,Жоқ, мен шынымен де депрессиядамын.
Dialogue: 0,1:14:33.05,1:14:34.13,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,1:14:34.26,1:14:35.63,Default,,0,0,0,,Иә
Dialogue: 0,1:14:36.93,1:14:39.80,Default,,0,0,0,,Мен әрқашан Цуки-кун Кира ма деп ойлайтынмын.
Dialogue: 0,1:14:39.93,1:14:41.93,Default,,0,0,0,,Өйткені мен бұл туралы ойладым.
Dialogue: 0,1:14:42.06,1:14:45.18,Default,,0,0,0,,Егер бұл шегерім қате болып шықса, мен шошып кетер едім...
Dialogue: 0,1:14:48.02,1:14:49.10,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:14:49.23,1:14:50.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:50.48,1:14:51.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:51.73,1:14:53.78,Default,,0,0,0,,Уф (ай) уф
Dialogue: 0,1:14:55.69,1:14:58.41,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:14:58.53,1:15:01.53,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,1:15:01.66,1:15:05.41,Default,,0,0,0,,Уф... ауырады.
Dialogue: 0,1:15:05.54,1:15:08.87,Default,,0,0,0,,Өзіңді алдама, мен Кира емес едім...
Dialogue: 0,1:15:09.00,1:15:12.00,Default,,0,0,0,,Сіздің ойыңыз дұрыс емес болып шыққандықтан, сіз өзіңізді ынтасыз сезінесіз бе?
Dialogue: 0,1:15:13.59,1:15:16.42,Default,,0,0,0,,Мүмкін мен оны қате жазған шығармын.
Dialogue: 0,1:15:16.55,1:15:19.05,Default,,0,0,0,,Мен қазірден бастасам да шығын болуы мүмкін, сондықтан мен...
Dialogue: 0,1:15:19.18,1:15:22.80,Default,,0,0,0,,Мені бұрылыссыз ұстап алу мүмкін емес!
Dialogue: 0,1:15:22.93,1:15:26.02,Default,,0,0,0,,Қанша жазықсыз адамдарға қатысыңыз бар деп ойлайсыз?
Dialogue: 0,1:15:26.81,1:15:29.39,Default,,0,0,0,,Оның үстіне Үміса екеумізді түрмеге отырғызған сен болдың!
Dialogue: 0,1:15:30.56,1:15:32.19,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,1:15:32.81,1:15:36.07,Default,,0,0,0,,Бірақ қандай себеп болса да...
Dialogue: 0,1:15:36.19,1:15:38.20,Default,,0,0,0,,Ах! (Теңіз құмы) Ах!
Dialogue: 0,1:15:39.61,1:15:41.45,Default,,0,0,0,,Ах, сен үйге кеткенің жөн.
Dialogue: 0,1:15:43.78,1:15:47.16,Default,,0,0,0,,… （Ｌ･）～
Dialogue: 0,1:15:47.29,1:15:48.37,Default,,0,0,0,,Ах! (Л) Ух...
Dialogue: 0,1:15:50.12,1:15:51.42,Default,,0,0,0,,Даа!
Dialogue: 0,1:15:51.54,1:15:53.34,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,1:15:56.30,1:16:00.22,Default,,0,0,0,,Шегерім қате болғанның орнына, Лайт Ягами Кираға тең.
Dialogue: 0,1:16:00.34,1:16:04.35,Default,,0,0,0,,Я Миса екінші Кираға тең, іс шешілмейді.
Dialogue: 0,1:16:04.47,1:16:07.10,Default,,0,0,0,,Сол себепті біраз көңілім қалды.
Dialogue: 0,1:16:07.22,1:16:09.64,Default,,0,0,0,,Адам ретінде соншалықты жамансың ба?
Dialogue: 0,1:16:09.77,1:16:12.77,Default,,0,0,0,,Бұл жақсы емес. Жалпы айтқанда, сіз солай айтасыз.
Dialogue: 0,1:16:12.90,1:16:16.19,Default,,0,0,0,,Мен Кира болмасам, көңілім толмайды деген сөз.
Dialogue: 0,1:16:17.28,1:16:20.24,Default,,0,0,0,,Цуки-кун Кира болмаса, көңілің толмай ма?
Dialogue: 0,1:16:20.36,1:16:22.95,Default,,0,0,0,,Расында да солай болуы мүмкін.
Dialogue: 0,1:16:23.87,1:16:25.95,Default,,0,0,0,,Бақылау камерасы ма?
Dialogue: 0,1:16:26.58,1:16:29.37,Default,,0,0,0,,Цуки-кун Кира болса екен.
Dialogue: 0,1:16:29.50,1:16:30.29,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:31.00,1:16:32.79,Default,,0,0,0,,Уф... Уф
Dialogue: 0,1:16:33.58,1:16:36.88,Default,,0,0,0,,Бір уақыт бір рет...
Dialogue: 0,1:16:37.00,1:16:40.05,Default,,0,0,0,,Мен өте күштімін.
Dialogue: 0,1:16:40.88,1:16:42.38,Default,,0,0,0,,Уау, аа...
Dialogue: 0,1:16:42.51,1:16:44.85,Default,,0,0,0,,өтіңіз... Оны тоқтату үшін бөлмеге хабарласыңыз.
Dialogue: 0,1:16:44.97,1:16:46.85,Default,,0,0,0,,Уф (Ай/Л) Иә?
Dialogue: 0,1:16:44.97,1:16:46.85,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,1:16:46.97,1:16:48.02,Default,,0,0,0,,Иә
Dialogue: 0,1:16:48.14,1:16:49.56,Default,,0,0,0,,Эй~, бұл шынымен кездесу ме екен деп ойлаймын.
Dialogue: 0,1:16:49.68,1:16:52.31,Default,,0,0,0,,Миса Миса «Он сегіз» оқырмандарының танымалдығы туралы сауалнамада
Dialogue: 0,1:16:52.44,1:16:54.35,Default,,0,0,0,,1-ші орын
Dialogue: 0,1:16:54.48,1:16:55.98,Default,,0,0,0,,Иә, түсінемін...
Dialogue: 0,1:16:56.11,1:16:58.48,Default,,0,0,0,,Басқаша айтқанда, ол режиссер Нишинаканың келесі фильмінің кейіпкері болады.
Dialogue: 0,1:16:58.61,1:16:59.65,Default,,0,0,0,,Бұл шешім қабылданғанын білдіреді.
Dialogue: 0,1:17:01.40,1:17:02.45,Default,,0,0,0,,Не болды?
Dialogue: 0,1:17:02.57,1:17:04.53,Default,,0,0,0,,Дегенмен, тәттілер жегенде ақылмен жесең, салмақ қоспайсың, білесің бе.
Dialogue: 0,1:17:04.66,1:17:05.32,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:17:05.32,1:17:08.45,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:17:05.32,1:17:08.45,Default,,0,0,0,,Мацуда-сан табиғи.
Dialogue: 0,1:17:08.45,1:17:08.58,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:17:08.58,1:17:09.62,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:17:08.58,1:17:09.62,Default,,0,0,0,,Мен сізді естимін...
Dialogue: 0,1:17:09.62,1:17:10.62,Default,,0,0,0,,Мен сізді естимін...
Dialogue: 0,1:17:17.59,1:17:21.38,Default,,0,0,0,,Рюзаки, мотивация алмағаным үшін кешіріңіз, бірақ бір сәт осында келіңіз.
Dialogue: 0,1:17:22.30,1:17:24.43,Default,,0,0,0,,Қыңырсың ғой~ Осындай дәмсіз әзілдеріңді қоймасаңшы?
Dialogue: 0,1:17:24.55,1:17:26.14,Default,,0,0,0,,Сіз біржақтысыз ба? (L) Иә?
Dialogue: 0,1:17:26.85,1:17:29.14,Default,,0,0,0,,Үшеуі де Жапонияны көрсететін компанияларда.
Dialogue: 0,1:17:29.26,1:17:31.48,Default,,0,0,0,,Маңызды қызметке тартылған тұлғалар
Dialogue: 0,1:17:32.43,1:17:35.02,Default,,0,0,0,,Олардың үшеуі жүрек жеткіліксіздігінен қайтыс болды.
Dialogue: 0,1:17:35.48,1:17:40.15,Default,,0,0,0,,Оны қой, біз жабдықталған штабқа әдейі келдік қой…
Dialogue: 0,1:17:40.28,1:17:43.82,Default,,0,0,0,,Басқаша айтқанда, бұл Йоцуба үшін қолайлы өлім болды...
Dialogue: 0,1:17:43.95,1:17:46.16,Default,,0,0,0,,Сіз қалай ойлайсыз? Маған
Dialogue: 0,1:17:46.28,1:17:49.33,Default,,0,0,0,,Менің ойымша, Кира Йоцубаға сүйенеді...
Dialogue: 0,1:17:54.96,1:17:58.96,Default,,0,0,0,,Барлығы дайын сияқты. Кезекті жиналысты бастайық.
Dialogue: 0,1:17:59.75,1:18:02.71,Default,,0,0,0,,Біздің Yotsuba тобының одан әрі өсуі
Dialogue: 0,1:18:02.84,1:18:06.01,Default,,0,0,0,,Әлемдегі ең ірі компания болу
Dialogue: 0,1:18:06.13,1:18:07.72,Default,,0,0,0,,Кімді өлтіру керек...
Dialogue: 0,1:18:18.44,1:18:19.19,Default,,0,0,0,,(ДК хабарландыру дыбысы)
Dialogue: 0,1:18:19.19,1:18:19.73,Default,,0,0,0,,(ДК хабарландыру дыбысы)
Dialogue: 0,1:18:19.19,1:18:19.73,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:18:19.73,1:18:20.19,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:18:20.32,1:18:21.73,Default,,0,0,0,,Не болды? Ватари
Dialogue: 0,1:18:21.86,1:18:24.15,Default,,0,0,0,,Детектив Эралд Койлға
Dialogue: 0,1:18:24.28,1:18:27.11,Default,,0,0,0,,Л-ның шынайы тұлғасын ашу туралы өтініш болды.
Dialogue: 0,1:18:27.24,1:18:28.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:28.20,1:18:29.78,Default,,0,0,0,,Эралд Коил туралы айту
Dialogue: 0,1:18:29.91,1:18:33.33,Default,,0,0,0,,Ол L-ден кейінгі екінші үлкен детектив деп айтылатын адам емес пе?
Dialogue: 0,1:18:33.45,1:18:35.12,Default,,0,0,0,,Кім мұндай өтініш жасады?
Dialogue: 0,1:18:36.37,1:18:38.96,Default,,0,0,0,,Клиент - Yotsuba Group Tokyo бас кеңсесі
Dialogue: 0,1:18:39.63,1:18:43.13,Default,,0,0,0,,Мен Масахико Китаны, құқықтарды жоспарлау жөніндегі директорды анықтадым.
Dialogue: 0,1:18:43.26,1:18:45.30,Default,,0,0,0,,Бұл Йоцуба ғой!
Dialogue: 0,1:18:45.42,1:18:47.84,Default,,0,0,0,,Бұл өте жаман, бізде жұмыс күші жоқ.
Dialogue: 0,1:18:47.97,1:18:51.51,Default,,0,0,0,,Орамға да назар аудару керек пе?
Dialogue: 0,1:18:52.14,1:18:54.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:18:54.31,1:18:57.06,Default,,0,0,0,,Эралд Койл детективі де менмін.
Dialogue: 0,1:18:57.19,1:18:58.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:58.52,1:19:01.57,Default,,0,0,0,,Қазір әлемдегі ең ұлы үш детективтің бірі деп аталады⸺
Dialogue: 0,1:19:01.69,1:19:03.19,Default,,0,0,0,,L катушкасы Денев…
Dialogue: 0,1:19:03.32,1:19:05.03,Default,,0,0,0,,Бұл менмін, бәріміз.
Dialogue: 0,1:19:05.15,1:19:08.57,Default,,0,0,0,,Мен саған құлпынай беремін, оны құпия сақта.
Dialogue: 0,1:19:08.70,1:19:09.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:09.87,1:19:11.95,Default,,0,0,0,,Йоцуба тобы, Токио қаласындағы бас кеңсе
Dialogue: 0,1:19:35.56,1:19:38.02,Default,,0,0,0,,Маған да қарашы.
Dialogue: 0,1:19:38.14,1:19:39.73,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,1:19:46.90,1:19:50.28,Default,,0,0,0,,Жарайды, оған жақында.
Dialogue: 0,1:19:50.41,1:19:51.28,Default,,0,0,0,,бірақ мен әлемді өзгерту үшін өзім кісі өлтірушіге айналар едім деп ойламаймын
Dialogue: 0,1:19:51.41,1:19:56.04,Default,,0,0,0,,Сонымен...Мен бұл жігіт орналасқан Yotsuba Tokyo штаб-пәтеріндемін⸺
Dialogue: 0,1:19:56.16,1:20:00.17,Default,,0,0,0,,Неліктен бақылау камералары мен қауіпсіздік жүйелерін сынғыш етіп жасамасқа?
Dialogue: 0,1:20:00.29,1:20:01.08,Default,,0,0,0,,Иә
Dialogue: 0,1:20:01.88,1:20:06.00,Default,,0,0,0,,Кира мен Йоцубаның туысы сөзсіз.
Dialogue: 0,1:20:06.13,1:20:08.30,Default,,0,0,0,,Алдымен Йоцубаны жуыңыз
Dialogue: 0,1:20:08.42,1:20:12.22,Default,,0,0,0,,Билік кімде және қанша адамда?
Dialogue: 0,1:20:12.34,1:20:14.05,Default,,0,0,0,,Рю… Рюзаки
Dialogue: 0,1:20:16.47,1:20:19.06,Default,,0,0,0,,Шүкір, мен сені анық ести алмаймын.
Dialogue: 0,1:20:19.18,1:20:22.85,Default,,0,0,0,,Маңызды бірдеңе сұрасаңыз...
Dialogue: 0,1:20:24.94,1:20:27.94,Default,,0,0,0,,Маған ол жігіт енді керек емес, ол жай ғана мазасыз, солай ма?
Dialogue: 0,1:20:28.07,1:20:29.65,Default,,0,0,0,,Қорды өлтіріп, бөлейік.
Dialogue: 0,1:20:29.78,1:20:30.28,Default,,0,0,0,,Мен «өлтіру» дегенді естідім
Dialogue: 0,1:20:30.28,1:20:31.78,Default,,0,0,0,,Мен «өлтіру» дегенді естідім
Dialogue: 0,1:20:30.28,1:20:31.78,Default,,0,0,0,,Бұл автокөлік сатылымын арттырады
Dialogue: 0,1:20:31.78,1:20:33.37,Default,,0,0,0,,Бұл автокөлік сатылымын арттырады
Dialogue: 0,1:20:33.49,1:20:35.37,Default,,0,0,0,,Бұл мүлдем басқа.
Dialogue: 0,1:20:35.49,1:20:38.12,Default,,0,0,0,,Кира!? Кира шықты! Ол шықты!
Dialogue: 0,1:20:38.25,1:20:41.29,Default,,0,0,0,,Не? Кираның сені өлтіргенін қалайсың ба? Мен сені естідім!
Dialogue: 0,1:20:42.00,1:20:44.08,Default,,0,0,0,,Бұл жігіттер Кира ғой...
Dialogue: 0,1:20:44.21,1:20:46.25,Default,,0,0,0,,Мен жасадым. Бұл үлкен мәселе.
Dialogue: 0,1:20:48.80,1:20:51.97,Default,,0,0,0,,А... а... а...
Dialogue: 0,1:20:53.51,1:20:54.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:55.64,1:20:57.10,Default,,0,0,0,,Не? сен!
Dialogue: 0,1:20:58.56,1:21:01.89,Default,,0,0,0,,Біз Мисаны екінші Кира болуы мүмкін деген күдікпен қамауға алдық
Dialogue: 0,1:21:02.02,1:21:04.23,Default,,0,0,0,,Бір адамның пікіріне сенбеу
Dialogue: 0,1:21:04.35,1:21:05.19,Default,,0,0,0,,(ДК хабарландыру дыбысы)
Dialogue: 0,1:21:05.31,1:21:06.11,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:21:06.23,1:21:08.23,Default,,0,0,0,,Не болды? Ватари
Dialogue: 0,1:21:08.36,1:21:11.70,Default,,0,0,0,,Мацуда мырза белбеуімен шұғыл сигнал берді.
Dialogue: 0,1:21:12.95,1:21:13.91,Default,,0,0,0,,Моги мырза шынымен де әсерлі адам, білесің бе
Dialogue: 0,1:21:14.03,1:21:15.70,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:21:15.82,1:21:19.37,Default,,0,0,0,,Бұл Йоцубаның Токиодағы штаб-пәтерінен шыққан сияқты.
Dialogue: 0,1:21:19.49,1:21:21.37,Default,,0,0,0,,I Yoshida Productions-те
Dialogue: 0,1:21:21.50,1:21:24.71,Default,,0,0,0,,Менің атым Таро Мацуи, мен менеджермін.
Dialogue: 0,1:21:24.83,1:21:28.25,Default,,0,0,0,,Менің сүйікті көп қырлы дарынды адамым - Миса Миса.
Dialogue: 0,1:21:28.38,1:21:33.05,Default,,0,0,0,,Оны жарнамалық роликте компанияңыздың имиджі ретінде пайдалану туралы не айтасыз?
Dialogue: 0,1:21:34.30,1:21:35.93,Default,,0,0,0,,Міне, дәл қазір мен Кира болуым мүмкін.
Dialogue: 0,1:21:36.05,1:21:38.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:39.51,1:21:42.27,Default,,0,0,0,,Уф... ха...
Dialogue: 0,1:21:42.98,1:21:44.10,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:21:44.23,1:21:47.40,Default,,0,0,0,,Әй, ай! Бүгін күн жақсы ма?
Dialogue: 0,1:21:47.52,1:21:49.15,Default,,0,0,0,,Рюзаки-санмен...
Dialogue: 0,1:21:50.23,1:21:51.53,Default,,0,0,0,,Умиса-сан (Ай) Ах.
Dialogue: 0,1:21:51.65,1:21:54.11,Default,,0,0,0,,Сіз Цукиді жақсы көресіз бе?
Dialogue: 0,1:21:54.24,1:21:55.45,Default,,0,0,0,,Иә
Dialogue: 0,1:21:55.57,1:21:59.08,Default,,0,0,0,,Сонымен, Цуки-кун мен Кира арасында қайсысын таңдар едіңіз?
Dialogue: 0,1:21:59.20,1:22:02.37,Default,,0,0,0,,Иә? Бұл айда шешілді.
Dialogue: 0,1:22:02.50,1:22:05.92,Default,,0,0,0,,Егер сіз Цуки-кунға көмектесіп, Цуки-кунмен бірге тергеу жүргізсеңіз.
Dialogue: 0,1:22:06.04,1:22:08.46,Default,,0,0,0,,Мен ынтымақтасқым келеді... солай ма?
Dialogue: 0,1:22:08.59,1:22:10.05,Default,,0,0,0,,Рю... Рюзаки! (Теңіз құмы) Иә!
Dialogue: 0,1:22:10.17,1:22:12.76,Default,,0,0,0,,Теңіз құмы ай үшін бәрін жасайды!
Dialogue: 0,1:22:12.88,1:22:15.47,Default,,0,0,0,,Жоқ... сәл күте тұрыңыз, не істейсіз?
Dialogue: 0,1:22:16.43,1:22:19.80,Default,,0,0,0,,Мацуда мырза қазір Йоцубаның тұтқынында.
Dialogue: 0,1:22:19.93,1:22:22.27,Default,,0,0,0,,Жақсырақ, жағдайды пайдаланып көріңіз.
Dialogue: 0,1:22:22.39,1:22:25.14,Default,,0,0,0,,Мисуна мырза енді Йоцубаға мінеді.
Dialogue: 0,1:22:25.27,1:22:28.23,Default,,0,0,0,,Жарнамада пайдалану үшін өзіңізді сатыңыз және т.б.
Dialogue: 0,1:22:28.36,1:22:31.98,Default,,0,0,0,,Біз Миса-саннан Йоцуба туралы мәлімет аламыз.
Dialogue: 0,1:22:32.11,1:22:33.69,Default,,0,0,0,,Демек, сен тыңшысың.
Dialogue: 0,1:22:33.82,1:22:36.15,Default,,0,0,0,,Иә, иә (дүйсенбі) Бұл жақсы емес.
Dialogue: 0,1:22:36.28,1:22:37.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:22:37.57,1:22:40.37,Default,,0,0,0,,Осы қарқынмен… әсіресе «жұма мен сенбі күндері,
Dialogue: 0,1:22:40.49,1:22:43.16,Default,,0,0,0,,Ал, менің қауіпсіздігім үшін алаңдайсың ба?
Dialogue: 0,1:22:43.29,1:22:45.12,Default,,0,0,0,,Цуки-кун (Ай) Ух...
Dialogue: 0,1:22:46.00,1:22:49.83,Default,,0,0,0,,Біз жеңсек, Миса-сан өлмейді, және
Dialogue: 0,1:22:50.59,1:22:53.92,Default,,0,0,0,,Қолымызда кісен болғанша, тағдырымыз бір, солай емес пе?
Dialogue: 0,1:22:54.05,1:22:55.30,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:22:55.42,1:22:56.63,Default,,0,0,0,,Олай болса, көп ұзамай,
Dialogue: 0,1:22:56.76,1:22:59.51,Default,,0,0,0,,Мацуда өлсін.
Dialogue: 0,1:22:59.64,1:23:01.64,Default,,0,0,0,,Миса мырза, келіңіз.
Dialogue: 0,1:23:01.76,1:23:03.39,Default,,0,0,0,,Иә
Dialogue: 0,1:23:03.52,1:23:05.10,Default,,0,0,0,,Бұл Миса Миса!
Dialogue: 0,1:23:05.23,1:23:09.23,Default,,0,0,0,,Жалаңаштануға болмайды, бірақ купальник пен іш киім жарайды.
Dialogue: 0,1:23:09.98,1:23:11.52,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:23:11.65,1:23:14.15,Default,,0,0,0,,Эхехехе… (Камимура/Хатори) Хмм…
Dialogue: 0,1:23:14.28,1:23:17.86,Default,,0,0,0,,Хмм, нағыз сүйкімді.
Dialogue: 0,1:23:17.99,1:23:20.99,Default,,0,0,0,,Қазір мәселе осы емес пе?
Dialogue: 0,1:23:21.12,1:23:24.20,Default,,0,0,0,,(Дауыспен сөйлесу)
Dialogue: 0,1:23:24.33,1:23:26.71,Default,,0,0,0,,Иә, іш, іш
Dialogue: 0,1:23:26.83,1:23:28.21,Default,,0,0,0,,Бұл жұмақ...
Dialogue: 0,1:23:28.33,1:23:29.58,Default,,0,0,0,,Хмм.
Dialogue: 0,1:23:29.71,1:23:32.21,Default,,0,0,0,,Миса мырза, сіз көп жұмыс жасайсыз.
Dialogue: 0,1:23:35.84,1:23:36.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:37.59,1:23:39.22,Default,,0,0,0,,Кя! (Камимура) Не!?
Dialogue: 0,1:23:42.10,1:23:45.35,Default,,0,0,0,,Ал... Мен маспын мен маспын
Dialogue: 0,1:23:46.39,1:23:48.81,Default,,0,0,0,,Барлығыңыз күте тұрыңыз.
Dialogue: 0,1:23:48.94,1:23:53.73,Default,,0,0,0,,Taro Matsui Showtime! Ықылық...
Dialogue: 0,1:23:54.48,1:23:56.78,Default,,0,0,0,,Эй, сен не істейсің? (Мацуда) Жарайды.
Dialogue: 0,1:23:57.90,1:24:00.16,Default,,0,0,0,,Кя Мацуи-сан Гунбар!
Dialogue: 0,1:24:00.28,1:24:02.07,Default,,0,0,0,,Иётто...
Dialogue: 0,1:24:02.20,1:24:03.41,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:05.03,1:24:07.91,Default,,0,0,0,,Тоқта! Қауіп! ақымақ!
Dialogue: 0,1:24:08.04,1:24:11.17,Default,,0,0,0,,Йоцуба үшін ыңғайлы өлімдер көбіне демалыс күндеріне жиілейді.
Dialogue: 0,1:24:12.38,1:24:14.04,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:16.59,1:24:21.47,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:23.14,1:24:24.14,Default,,0,0,0,,(Fat Gum) Бірақ! Егер біреуге арқаңды сүйенсең, сеніміңді арта отырып, бәрін оларға тапсыру – ер адамның парызы!
Dialogue: 0,1:24:24.26,1:24:25.39,Default,,0,0,0,,Уф
Dialogue: 0,1:24:27.06,1:24:28.35,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,1:24:28.48,1:24:29.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:29.93,1:24:30.77,Default,,0,0,0,,Мен мұнда ауыртпалық болғым келмейді, түсінесің бе.
Dialogue: 0,1:24:33.73,1:24:34.77,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,1:24:34.90,1:24:36.78,Default,,0,0,0,,О, жоқ!
Dialogue: 0,1:24:36.90,1:24:40.15,Default,,0,0,0,,Мен тарсылдаған дыбысты естідім, сондықтан мен келдім, бұл қорқынышты!
Dialogue: 0,1:24:40.28,1:24:43.28,Default,,0,0,0,,Бұл шынымен... ұнамсыз рөл.
Dialogue: 0,1:24:43.95,1:24:47.45,Default,,0,0,0,,Эй, Мацуу!
Dialogue: 0,1:24:47.58,1:24:48.66,Default,,0,0,0,,Аа... солай
Dialogue: 0,1:24:48.79,1:24:52.79,Default,,0,0,0,,Жарайды. Жарнамаға қатысты, өтінемін.
Dialogue: 0,1:24:58.71,1:25:00.92,Default,,0,0,0,,Хмм... аааа
Dialogue: 0,1:25:01.05,1:25:04.30,Default,,0,0,0,,Әй... Жұмыс күші болмаса да, өзіме байланысты.
Dialogue: 0,1:25:04.43,1:25:06.64,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,1:25:06.76,1:25:09.02,Default,,0,0,0,,Міне, дәл қазір мен Кира болуым мүмкін.
Dialogue: 0,1:25:18.19,1:25:21.99,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,1:25:22.61,1:25:24.32,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,1:25:25.11,1:25:27.62,Default,,0,0,0,,Бірақ қызық болып барады.
Dialogue: 0,1:25:28.49,1:25:31.41,Default,,0,0,0,,Мисаны әйелі етіп аламын.
Dialogue: 0,1:25:31.54,1:25:32.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:32.87,1:25:37.17,Default,,0,0,0,,Фуфуфуфуфуфу... хехехехехе...
Dialogue: 0,1:25:37.29,1:25:41.55,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,1:25:41.67,1:25:44.22,Default,,0,0,0,,Сырттан қарасаңыз, қызғанышыңыз болуы мүмкін.
Dialogue: 0,1:25:47.05,1:25:51.35,Default,,0,0,0,,Біз үйленсек, мен саған көп сақтандыру ақшасын төлеймін.
Dialogue: 0,1:25:52.85,1:25:56.06,Default,,0,0,0,,Мен мұндай жексұрын адамды күткен емеспін...
Dialogue: 0,1:26:00.94,1:26:04.32,Default,,0,0,0,,Ху... жүйкені пайдалан
Dialogue: 0,1:26:04.45,1:26:07.82,Default,,0,0,0,,Бірақ бәрі жақсы, сондықтан мен көп тырысуым керек.
Dialogue: 0,1:26:14.29,1:26:15.50,Default,,0,0,0,,Ха…
Dialogue: 0,1:26:17.08,1:26:18.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:20.13,1:26:23.30,Default,,0,0,0,,Не... бұл не, елес?
Dialogue: 0,1:26:23.42,1:26:24.80,Default,,0,0,0,,Мен де Рюкпен солай істеймін.
Dialogue: 0,1:26:24.92,1:26:28.80,Default,,0,0,0,,Енді сізді Йоцуба кез келген уақытта өлтіруі мүмкін⸺
Dialogue: 0,1:26:28.93,1:26:32.72,Default,,0,0,0,,Мен қауіпті жағдайдамын, соны айтайын деп келдім.
Dialogue: 0,1:26:33.43,1:26:35.35,Default,,0,0,0,,Жоқ, Ооидің айтып отырғаны – ақыр соңында L-дің шынайы кім екенін Койл анықтауы керек,
Dialogue: 0,1:26:35.48,1:26:36.90,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,1:26:37.02,1:26:39.61,Default,,0,0,0,,Бұл аруақтың Умисандты өлтіру ықтималдығы аз.
Dialogue: 0,1:26:40.61,1:26:42.44,Default,,0,0,0,,Койл да бізбен бірге мұнда болуы керек емес пе?
Dialogue: 0,1:26:43.19,1:26:46.20,Default,,0,0,0,,Менің... одақтасым?
Dialogue: 0,1:26:46.32,1:26:50.78,Default,,0,0,0,,Пухахахахахаха...
Dialogue: 0,1:26:51.45,1:26:52.70,Default,,0,0,0,,Сіз не?
Dialogue: 0,1:26:53.49,1:26:55.83,Default,,0,0,0,,Мен сенің аңдыушы емес екеніңді білемін, бірақ
Dialogue: 0,1:26:55.96,1:26:58.33,Default,,0,0,0,,Адамға мүлдем ұқсамайды
Dialogue: 0,1:26:58.46,1:27:01.54,Default,,0,0,0,,Әрине, мен азғындықпын.
Dialogue: 0,1:27:01.67,1:27:02.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:03.25,1:27:06.88,Default,,0,0,0,,Сіз менімен бір рет әрекет еттіңіз.
Dialogue: 0,1:27:07.01,1:27:09.93,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды мүлдем түсінбеймін.
Dialogue: 0,1:27:11.01,1:27:12.68,Default,,0,0,0,,Осыған сәйкес, Яисаны Л сұраққа алған сияқты, бірақ
Dialogue: 0,1:27:14.06,1:27:16.89,Default,,0,0,0,,Сол жерге адамның атын жаз
Dialogue: 0,1:27:17.02,1:27:20.73,Default,,0,0,0,,Есімі жазылған адам міндетті түрде өледі.
Dialogue: 0,1:27:21.65,1:27:26.03,Default,,0,0,0,,Сол дәптерді пайдаланып, Цуки Ягами қылмыскерлерді соттайды.
Dialogue: 0,1:27:26.15,1:27:28.70,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,1:27:28.82,1:27:30.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:31.53,1:27:34.62,Default,,0,0,0,,Ал теңіз құмы Кирамен бірдей.
Dialogue: 0,1:27:34.74,1:27:37.75,Default,,0,0,0,,Дегенмен, мен бұл ойды қабылдауға өзімді қиналдыра алмаймын.
Dialogue: 0,1:27:38.41,1:27:42.00,Default,,0,0,0,,Ай – Кира, ал теңіз құмы – екінші Кира?
Dialogue: 0,1:27:42.88,1:27:45.63,Default,,0,0,0,,Рюзаки, дұрыс айтасыз.
Dialogue: 0,1:27:48.51,1:27:50.97,Default,,0,0,0,,Енді мен сұхбатқа оралғанда
Dialogue: 0,1:27:51.09,1:27:53.81,Default,,0,0,0,,Теңіз құмы Кираның кім екенін білуі керек.
Dialogue: 0,1:27:53.93,1:27:56.68,Default,,0,0,0,,Рем, дәптерді әдеттегі жерге жасыршы.
Dialogue: 0,1:27:57.52,1:27:59.73,Default,,0,0,0,,Дәретхананы ұзақ пайдаланғаным үшін кешіріңіз.
Dialogue: 0,1:27:59.85,1:28:03.19,Default,,0,0,0,,Мен де макияжымды керемет түзетіп алдым.
Dialogue: 0,1:28:04.07,1:28:06.48,Default,,0,0,0,,Койл Яиса Л-ді білуі мүмкін деп хабарлады.
Dialogue: 0,1:28:06.61,1:28:10.45,Default,,0,0,0,,Менің алдымда отырған адам Кира.
Dialogue: 0,1:28:10.57,1:28:14.49,Default,,0,0,0,,Рем Ремнің алдындағы адам Кира.
Dialogue: 0,1:28:23.71,1:28:25.55,Default,,0,0,0,,Жоғарыдағыларға сүйене отырып, Яи Кираға табынады деп айта аламыз.
Dialogue: 0,1:28:26.30,1:28:27.84,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,1:28:35.60,1:28:37.68,Default,,0,0,0,,дәптерге иелік етуден бас тартып, жадын жоғалтқанын білдіреді.
Dialogue: 0,1:28:37.81,1:28:39.73,Default,,0,0,0,,Соңғы рет көңіл көтергеннен бері
Dialogue: 0,1:28:39.85,1:28:43.90,Default,,0,0,0,,Маған ең тұрақты электрондық пошта шақыруларын жіберген азғын қарт.
Dialogue: 0,1:28:44.73,1:28:49.28,Default,,0,0,0,,Бұл жігіттің Кира болғаны өте жаман болды.
Dialogue: 0,1:28:49.40,1:28:52.49,Default,,0,0,0,,Миса-чан, тезірек тамақ ішуге шыққыңыз келе ме?
Dialogue: 0,1:28:52.61,1:28:57.20,Default,,0,0,0,,Хмм? Сіз мені бөтен жерге апармайсыз, солай ма?
Dialogue: 0,1:28:57.33,1:28:59.66,Default,,0,0,0,,Маған оғаш нәрсе болса да
Dialogue: 0,1:28:59.79,1:29:02.67,Default,,0,0,0,,Койл Яиса Л-ді білуі мүмкін деп хабарлады.
Dialogue: 0,1:29:04.33,1:29:06.75,Default,,0,0,0,,Сіз не ойлап отырсыз? теңіз құмы
Dialogue: 0,1:29:06.88,1:29:10.47,Default,,0,0,0,,Цуки Ягами осылай дейді ме?
Dialogue: 0,1:29:11.01,1:29:14.59,Default,,0,0,0,,Хахахаха күлкілі ештеңе айтпа, Миса Чан.
Dialogue: 0,1:29:14.72,1:29:16.30,Default,,0,0,0,,Дегенмен, мен бұл ойды қабылдауға өзімді қиналдыра алмаймын.
Dialogue: 0,1:29:16.43,1:29:19.14,Default,,0,0,0,,Бұл дұрыс, өйткені теңіз құмы
Dialogue: 0,1:29:20.02,1:29:21.48,Default,,0,0,0,,Өйткені бұл екінші Кира
Dialogue: 0,1:29:21.60,1:29:22.56,Default,,0,0,0,,Ха…
Dialogue: 0,1:29:23.19,1:29:26.23,Default,,0,0,0,,Умиса Менің арманым Кираның әйелі болу.
Dialogue: 0,1:29:26.36,1:29:29.19,Default,,0,0,0,,Кираға да теңіз құмы керек.
Dialogue: 0,1:29:30.07,1:29:33.11,Default,,0,0,0,,Сакура теледидарындағы оқиғадан екінші Кира болса
Dialogue: 0,1:29:33.24,1:29:36.07,Default,,0,0,0,,Оның қасқырдың көзі бар екені көрініп тұр.
Dialogue: 0,1:29:36.20,1:29:37.91,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,1:29:38.03,1:29:42.12,Default,,0,0,0,,Мен бұл баланы еш нәрсеге қарамастан қасымда ұстағым келеді.
Dialogue: 0,1:29:42.79,1:29:44.37,Default,,0,0,0,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,1:29:47.25,1:29:48.59,Default,,0,0,0,,мәселе дәл осы жерден басталады
Dialogue: 0,1:29:48.71,1:29:51.21,Default,,0,0,0,,Жоғарыдағыларға сүйене отырып, Яи Кираға табынады деп айта аламыз.
Dialogue: 0,1:29:51.34,1:29:53.26,Default,,0,0,0,,Қорқынышты жинағымен әйгілі
Dialogue: 0,1:29:53.38,1:29:56.59,Default,,0,0,0,,Кейбір жағдайларда сізді сақтандыру ақшасымен төлеуге мәжбүр ететін жаман жігіт.
Dialogue: 0,1:29:56.72,1:29:58.05,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:29:58.18,1:30:00.52,Default,,0,0,0,,Мен оның өлген-өлмегенін дереу тексере аламын ба?
Dialogue: 0,1:30:00.64,1:30:02.23,Default,,0,0,0,,Дегенмен, мен бұл ойды қабылдауға өзімді қиналдыра алмаймын.
Dialogue: 0,1:30:02.35,1:30:05.10,Default,,0,0,0,,Олай болса, сол жаққа қара.
Dialogue: 0,1:30:05.23,1:30:07.94,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,1:30:09.36,1:30:13.69,Default,,0,0,0,,Умиса Мен Джинзо Гиндзоны өлтіремін.
Dialogue: 0,1:30:13.82,1:30:17.07,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,1:30:17.20,1:30:18.49,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:30:21.45,1:30:23.20,Default,,0,0,0,,L-дің шынайы кім екенін анықтау келісімнің бір бөлігі болуы тиіс еді.
Dialogue: 0,1:30:26.62,1:30:27.75,Default,,0,0,0,,Койл да бізбен бірге мұнда болуы керек емес пе?
Dialogue: 0,1:30:27.88,1:30:31.38,Default,,0,0,0,,Кешіріңіз! Енді, президент құлап, тынысы тарылды... артына қалдыр!
Dialogue: 0,1:30:31.50,1:30:32.38,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,1:30:32.51,1:30:36.47,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,1:30:38.64,1:30:39.80,Default,,0,0,0,,Эй?
Dialogue: 0,1:30:40.47,1:30:44.27,Default,,0,0,0,,Мен ұсынған адам, дәл осы жерде және қазір...
Dialogue: 0,1:30:44.39,1:30:48.65,Default,,0,0,0,,Егер сізде күш болмаса, мұны істеу ешқашан мүмкін емес.
Dialogue: 0,1:30:48.77,1:30:49.73,Default,,0,0,0,,Шұғыл ма?
Dialogue: 0,1:30:50.90,1:30:52.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:53.40,1:30:56.61,Default,,0,0,0,,Егер мен Кираның орнында болсам, үйленетін едім, солай ма?
Dialogue: 0,1:30:57.45,1:30:58.49,Default,,0,0,0,,Содан кейін дәлелдер
Dialogue: 0,1:30:58.61,1:30:59.57,Default,,0,0,0,,Хмм...
Dialogue: 0,1:30:59.70,1:31:04.00,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,1:31:04.12,1:31:06.50,Default,,0,0,0,,О, бұл жақсы емес.
Dialogue: 0,1:31:07.21,1:31:10.79,Default,,0,0,0,,Ол Умисунаны Кратердің үйіне әкелуге батылдық танытуы мүмкін.
Dialogue: 0,1:31:11.84,1:31:14.13,Default,,0,0,0,,Түсіндім. (Tinder) Иә?
Dialogue: 0,1:31:14.26,1:31:17.80,Default,,0,0,0,,Олай болса, екінші жағынан, қылмыскерлерді соттауды доғарыңыз.
Dialogue: 0,1:31:17.93,1:31:20.14,Default,,0,0,0,,Кира оны тоқтата алуы керек.
Dialogue: 0,1:31:20.26,1:31:24.06,Default,,0,0,0,,-та теңіз құмы үкім шығара бастады десең, төрелік етеді.
Dialogue: 0,1:31:24.18,1:31:25.64,Default,,0,0,0,,Сонда мен сенемін
Dialogue: 0,1:31:25.77,1:31:27.23,Default,,0,0,0,,Тек қылмыстық сот төрелігі
Dialogue: 0,1:31:27.23,1:31:27.64,Default,,0,0,0,,Тек қылмыстық сот төрелігі
Dialogue: 0,1:31:27.23,1:31:27.64,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:31:27.64,1:31:27.77,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:31:27.77,1:31:28.23,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:31:27.77,1:31:28.23,Default,,0,0,0,,Тек Кираның еркіне сай қозғалуы керек.
Dialogue: 0,1:31:28.23,1:31:30.98,Default,,0,0,0,,Тек Кираның еркіне сай қозғалуы керек.
Dialogue: 0,1:31:31.11,1:31:33.69,Default,,0,0,0,,Түсіндім, бұл тамаша идея.
Dialogue: 0,1:31:34.90,1:31:35.90,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:31:36.03,1:31:39.74,Default,,0,0,0,,Мен Кира болғандықтан, Мисаның маған сенгенін қалаймын.
Dialogue: 0,1:31:39.86,1:31:41.91,Default,,0,0,0,,Қазір қылмыстық сот төрелігін тоқтатыңыз
Dialogue: 0,1:31:42.03,1:31:46.20,Default,,0,0,0,,Ал егер менің Кира екенімді түсінсең, үйленеміз.
Dialogue: 0,1:31:46.33,1:31:48.04,Default,,0,0,0,,Не... а...
Dialogue: 0,1:31:48.16,1:31:50.25,Default,,0,0,0,,Сонымен
Dialogue: 0,1:31:50.37,1:31:52.59,Default,,0,0,0,,Кратер - Кира
Dialogue: 0,1:31:52.71,1:31:53.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:04.06,1:32:07.14,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,1:32:07.27,1:32:11.85,Default,,0,0,0,,Қылмыстық сот төрелігін тоқтатқаннан кейін үш күннен кейін уақыт келді.
Dialogue: 0,1:32:12.81,1:32:16.57,Default,,0,0,0,,Енді екінші Кираяға үйленсем
Dialogue: 0,1:32:16.69,1:32:18.99,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,1:32:19.11,1:32:23.03,Default,,0,0,0,,Мен бүкіл Йоцубаға билік жүргіземін.
Dialogue: 0,1:32:23.16,1:32:26.66,Default,,0,0,0,,Хахахаха... Аххахаха...
Dialogue: 0,1:32:26.79,1:32:28.04,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:32:28.04,1:32:29.58,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:32:28.04,1:32:29.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:29.58,1:32:30.75,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:32:31.92,1:32:35.67,Default,,0,0,0,,Кратер нашар. Теледидар қарау. Бұл Сакура теледидары.
Dialogue: 0,1:32:35.80,1:32:37.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:38.55,1:32:41.38,Default,,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,1:32:41.51,1:32:44.05,Default,,0,0,0,,Иә, дәлелдер көп.
Dialogue: 0,1:32:44.18,1:32:48.52,Default,,0,0,0,,Не? Бұл бәрібір өтірік болуы керек. Бұл Сакура теледидары.
Dialogue: 0,1:32:48.64,1:32:50.81,Default,,0,0,0,,Бұл бірінші нәрсе
Dialogue: 0,1:32:50.94,1:32:53.98,Default,,0,0,0,,Ол: «Сегіз адам жиналыс өткізіп жатқанда мен оған тап болдым», - деді.
Dialogue: 0,1:32:54.11,1:32:55.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:55.15,1:32:57.44,Default,,0,0,0,,А? Уф...
Dialogue: 0,1:32:57.57,1:32:58.94,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,1:32:59.07,1:33:00.70,Default,,0,0,0,,А... бұл ол!
Dialogue: 0,1:33:00.82,1:33:03.49,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:33:00.82,1:33:03.49,Default,,0,0,0,,(қызметкерлердің шуы)
Dialogue: 0,1:33:04.12,1:33:08.20,Default,,0,0,0,,Ол Умисунаның менеджері болды... Мацуи деп ойлаймын! Неге тірісің!?
Dialogue: 0,1:33:10.08,1:33:11.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:33:11.16,1:33:13.12,Default,,0,0,0,,Қазір тоқтағыңыз келе ме?
Dialogue: 0,1:33:13.25,1:33:15.42,Default,,0,0,0,,Жоқ, мен тәуекелдерді білемін.
Dialogue: 0,1:33:16.04,1:33:20.55,Default,,0,0,0,,Әділдік үшін өлтірілсе де, соңына дейін барымды саламын.
Dialogue: 0,1:33:20.67,1:33:22.47,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,1:33:22.59,1:33:27.05,Default,,0,0,0,,Кираның хабарландыруы бағдарламаның соңына дейін жасалмауы керек.
Dialogue: 0,1:33:27.18,1:33:28.26,Default,,0,0,0,,Бұл жаман. Қашан ашылады...
Dialogue: 0,1:33:28.26,1:33:30.93,Default,,0,0,0,,Бұл жаман. Қашан ашылады...
Dialogue: 0,1:33:28.26,1:33:30.93,Default,,0,0,0,,Қалай барады? Жағдай қандай?
Dialogue: 0,1:33:31.06,1:33:32.31,Default,,0,0,0,,Арна өзгеріссіз қалады
Dialogue: 0,1:33:32.44,1:33:37.44,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:33:37.57,1:33:39.36,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,1:33:39.48,1:33:42.57,Default,,0,0,0,,Сандо Бұл менмін, Сакура теледидары нашар.
Dialogue: 0,1:33:42.70,1:33:44.78,Default,,0,0,0,,Кеңесшілер үйіндегі қарияңыздан
Dialogue: 0,1:33:44.91,1:33:48.83,Default,,0,0,0,,Хигучи – Кира!
Dialogue: 0,1:33:48.95,1:33:51.04,Default,,0,0,0,,Егер қылмыскерлерді өлтіру тоқтаса, Хигучиде Кираның күші бар екеніне еш күмән жоқ.
Dialogue: 0,1:33:51.16,1:33:53.87,Default,,0,0,0,,Бұл бағдарламаға ешкім сенбейді.
Dialogue: 0,1:33:54.00,1:33:55.42,Default,,0,0,0,,Керісінше күдікті
Dialogue: 0,1:33:55.42,1:33:55.96,Default,,0,0,0,,Керісінше күдікті
Dialogue: 0,1:33:55.42,1:33:55.96,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:55.96,1:33:56.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:56.08,1:33:56.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:56.08,1:33:56.71,Default,,0,0,0,,оның осыншалықты әріге барады деп ойламаппын
Dialogue: 0,1:33:56.71,1:33:58.54,Default,,0,0,0,,оның осыншалықты әріге барады деп ойламаппын
Dialogue: 0,1:33:58.67,1:34:03.76,Default,,0,0,0,,Дәл қазір мен оның бетін теледидардан көрдім және оның Таро Мацуи екенін растадым.
Dialogue: 0,1:34:03.88,1:34:07.89,Default,,0,0,0,,Нанагава барлығына теледидар көріңдер деп хабар жіберді.
Dialogue: 0,1:34:08.01,1:34:12.27,Default,,0,0,0,,Таро Мацуи жақында өледі, өйткені жеті адамның бірі Кира.
Dialogue: 0,1:34:13.02,1:34:15.19,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,1:34:15.31,1:34:18.06,Default,,0,0,0,,Таро Мацуи оның шын есімі емес екенін білеміз.
Dialogue: 0,1:34:18.19,1:34:20.40,Default,,0,0,0,,Тек мен, Кира
Dialogue: 0,1:34:20.52,1:34:24.45,Default,,0,0,0,,Ол: «Егер ол Кира болса, мен онымен үйленемін» деді.
Dialogue: 0,1:34:25.82,1:34:26.36,Default,,0,0,0,,Барлығы, Кираның шынайы тұлғасы жақында ашылады.
Dialogue: 0,1:34:26.36,1:34:28.28,Default,,0,0,0,,Барлығы, Кираның шынайы тұлғасы жақында ашылады.
Dialogue: 0,1:34:26.36,1:34:28.28,Default,,0,0,0,,Дұрыс, кездескенше.
Dialogue: 0,1:34:28.41,1:34:29.62,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,1:34:28.41,1:34:29.62,Default,,0,0,0,,анық болады
Dialogue: 0,1:34:29.74,1:34:31.58,Default,,0,0,0,,Маған шыдаңыз.
Dialogue: 0,1:34:32.70,1:34:37.33,Default,,0,0,0,,Бағдарламаның соңында айтқыңыз келсе, әлі екі сағат қалды.
Dialogue: 0,1:34:41.80,1:34:43.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:34:48.59,1:34:52.43,Default,,0,0,0,,Crater Check Менде тек сөмкем бар, мен сізге еремін
Dialogue: 0,1:34:56.19,1:34:58.52,Default,,0,0,0,,Әзірге бұл күткендей.
Dialogue: 0,1:34:58.65,1:34:59.44,Default,,0,0,0,,Иә
Dialogue: 0,1:35:02.82,1:35:04.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:35:09.95,1:35:11.12,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,1:35:41.86,1:35:46.07,Default,,0,0,0,,Жүр, оны қалай өлтіретініңді көрсет.
Dialogue: 0,1:35:52.24,1:35:53.78,Default,,0,0,0,,Иә
Dialogue: 0,1:35:57.96,1:36:00.96,Default,,0,0,0,,Жоқ! Аты-жөніңізді жазыңыз, ол шығады.
Dialogue: 0,1:36:01.08,1:36:02.54,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,1:36:02.67,1:36:04.88,Default,,0,0,0,,Рюзаки: Сіз оны ұстағыңыз келе ме?
Dialogue: 0,1:36:05.00,1:36:08.05,Default,,0,0,0,,Матсуда мырза өледі.
Dialogue: 0,1:36:08.17,1:36:10.89,Default,,0,0,0,,Мүмкін көлікте бірдеңе істейміз.
Dialogue: 0,1:36:11.55,1:36:13.10,Default,,0,0,0,,Жалдаған адамдарыңның есімдерін кем дегенде есте сақта!
Dialogue: 0,1:36:13.22,1:36:14.26,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,1:36:16.68,1:36:17.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:18.39,1:36:21.60,Default,,0,0,0,,Мацуда-санды тезірек өлтіргім келуі керек еді.
Dialogue: 0,1:36:21.73,1:36:23.31,Default,,0,0,0,,Шұңқыр тыныш.
Dialogue: 0,1:36:23.44,1:36:28.36,Default,,0,0,0,,36 37 38 39…
Dialogue: 0,1:36:28.99,1:36:30.49,Default,,0,0,0,,Миса☆-ның «Жеңімпаздар» ружы – іске қосылды
Dialogue: 0,1:36:31.07,1:36:32.87,Default,,0,0,0,,Өйткені Кира кісі өлтіруші
Dialogue: 0,1:36:32.99,1:36:34.78,Default,,0,0,0,,Мен ешқашан кешірмеймін
Dialogue: 0,1:36:34.91,1:36:37.37,Default,,0,0,0,,Мм... Шүкір, мен өлмеймін!
Dialogue: 0,1:36:37.50,1:36:40.92,Default,,0,0,0,,Не... нені айтып тұрсың? Мен «өлмеймін» дедім
Dialogue: 0,1:36:41.04,1:36:43.42,Default,,0,0,0,,Сіз өлтіруді әлі жасадыңыз ба?
Dialogue: 0,1:36:43.54,1:36:46.13,Default,,0,0,0,,Есім жазу адам өлтіру әрекеті ме?
Dialogue: 0,1:36:46.25,1:36:47.59,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:53.01,1:36:54.80,Default,,0,0,0,,Рем, бұл мәміле.
Dialogue: 0,1:36:55.85,1:36:57.14,Default,,0,0,0,,Мәміле?
Dialogue: 0,1:36:57.26,1:37:00.43,Default,,0,0,0,,Кираның күші шынымен көктен келе ме, әлде бір нәрсе ме?
Dialogue: 0,1:37:01.23,1:37:04.31,Default,,0,0,0,,Әйтеуір, күте тұра көрген жөн.
Dialogue: 0,1:37:06.48,1:37:09.24,Default,,0,0,0,,Кішкентай шайтанның тартымдылығы
Dialogue: 0,1:37:09.36,1:37:11.78,Default,,0,0,0,,Мұны істеудің көптеген жолдары бар.
Dialogue: 0,1:37:14.57,1:37:15.53,Default,,0,0,0,,Миса☆-ның «Жеңімпаздар» ружы – іске қосылды
Dialogue: 0,1:37:21.87,1:37:24.25,Default,,0,0,0,,Жарнама аяқталуға жақын, бірақ Рюзаки: Миса☆-ның «Жеңімпаздар» ружы – іске қосылды
Dialogue: 0,1:37:24.38,1:37:25.96,Default,,0,0,0,,Миса☆-ның «Winners» ружы – таныстырылымы
Dialogue: 0,1:37:26.09,1:37:26.88,Default,,0,0,0,,Цк
Dialogue: 0,1:37:30.67,1:37:33.59,Default,,0,0,0,,Бұл өте жаман, кратерді мотоцикл полициясының қызметкері ұстап алды.
Dialogue: 0,1:37:34.30,1:37:37.01,Default,,0,0,0,,сол жерде болған адамдар Кира кім болғанын түсінеді,
Dialogue: 0,1:37:37.14,1:37:38.47,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,1:37:38.60,1:37:40.98,Default,,0,0,0,,сондықтан қазір бұдан артық ештеңе айта алмаймын.
Dialogue: 0,1:37:41.60,1:37:44.85,Default,,0,0,0,,Мен лицензиямды қайда қойдым?
Dialogue: 0,1:37:46.69,1:37:48.86,Default,,0,0,0,,Менің мұндай нәрсемен араласуға уақытым жоқ.
Dialogue: 0,1:37:51.19,1:37:51.99,Default,,0,0,0,,Кора!
Dialogue: 0,1:37:52.11,1:37:54.61,Default,,0,0,0,,Кратер полиция мотоциклін сілкіп тастап, қашып кетті!
Dialogue: 0,1:37:55.70,1:37:57.28,Default,,0,0,0,,Мынау жол полициясы, уф!
Dialogue: 0,1:37:57.28,1:37:57.83,Default,,0,0,0,,Мынау жол полициясы, уф!
Dialogue: 0,1:37:57.28,1:37:57.83,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,1:37:57.83,1:37:57.95,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,1:37:57.95,1:37:58.49,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,1:37:57.95,1:37:58.49,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:37:58.49,1:37:59.37,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:38:00.79,1:38:01.87,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:03.12,1:38:06.33,Default,,0,0,0,,Ши... Мотоцикл жүк көлігіне соғылды! Үлкен апат!
Dialogue: 0,1:38:06.46,1:38:08.96,Default,,0,0,0,,Қираған ба? Кездейсоқ өлім?
Dialogue: 0,1:38:09.09,1:38:10.09,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,1:38:10.21,1:38:11.71,Default,,0,0,0,,Жоқ, одан да көп.
Dialogue: 0,1:38:11.84,1:38:14.72,Default,,0,0,0,,Мотоцикл полициясының атын қалай алдыңыз?
Dialogue: 0,1:38:15.68,1:38:18.22,Default,,0,0,0,,Мүмкін жай ғана екінші Кира сияқты тұлға...
Dialogue: 0,1:38:18.85,1:38:20.93,Default,,0,0,0,,Рем... мәміле?
Dialogue: 0,1:38:21.06,1:38:24.56,Default,,0,0,0,,Жоқ, егер сіз біреуді бетіңізбен өлтіре алсаңыз.
Dialogue: 0,1:38:24.69,1:38:27.56,Default,,0,0,0,,Оның бетін білетін Мацуданың өзі оны бірден өлтіруі керек.
Dialogue: 0,1:38:27.69,1:38:29.90,Default,,0,0,0,,Не болып жатыр? Бірақ...
Dialogue: 0,1:38:30.02,1:38:31.40,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,1:38:31.53,1:38:35.61,Default,,0,0,0,,Кратерді одан әрі жылжыту қауіпті деп есептей отырып, біз оны бекітуге көшеміз.
Dialogue: 0,1:38:35.74,1:38:39.12,Default,,0,0,0,,Алайда, екінші Кира сияқты, Кратер тек бетімен өлтіре алатын Кира болды.
Dialogue: 0,1:38:39.12,1:38:41.24,Default,,0,0,0,,Алайда, екінші Кира сияқты, Кратер тек бетімен өлтіре алатын Кираға айналды.
Dialogue: 0,1:38:39.12,1:38:41.24,Default,,0,0,0,,Ихихихихихи…
Dialogue: 0,1:38:41.37,1:38:43.50,Default,,0,0,0,,Осыны ескере отырып қамтамасыз етілген!
Dialogue: 0,1:38:41.37,1:38:43.50,Default,,0,0,0,,Ухихи Ухихихи...
Dialogue: 0,1:38:44.58,1:38:48.13,Default,,0,0,0,,Бұл Л. Мен Кираны белгілі бір тұлға ретінде анықтадым.
Dialogue: 0,1:38:48.25,1:38:52.42,Default,,0,0,0,,Қазіргі уақытта 1-ұлттық маршрут бойынша Хибиядан Шибуяға бет алуда⸺
Dialogue: 0,1:38:52.55,1:38:54.13,Default,,0,0,0,,Қызыл Porsche 911
Dialogue: 0,1:38:54.26,1:38:56.63,Default,,0,0,0,,Біз оны осында қорғаймыз.
Dialogue: 0,1:38:56.76,1:39:00.93,Default,,0,0,0,,Мен оны міндетті түрде өлтіремін
Dialogue: 0,1:39:01.06,1:39:04.52,Default,,0,0,0,,Әке, 7-ші жауап келесі жарнамадан басталады.
Dialogue: 0,1:39:04.64,1:39:05.81,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:39:05.93,1:39:09.98,Default,,0,0,0,,Сонымен, Ягами-кун, біз де барамыз ба? (Ай) Ах.
Dialogue: 0,1:39:11.07,1:39:13.23,Default,,0,0,0,,Ол Касуканың жауы ғой, иә?
Dialogue: 0,1:39:13.36,1:39:17.24,Default,,0,0,0,,Әке, кратер ақыры Сакура теледидарына қарай бет алған сияқты.
Dialogue: 0,1:39:17.36,1:39:20.49,Default,,0,0,0,,Тек сөмкесі бар. Біз оның ізіне түстік.
Dialogue: 0,1:39:20.62,1:39:23.58,Default,,0,0,0,,Мен ұлымның менен «жағдайың бар ма?» деген сияқты нәрселерді сұрағанын қаламаймын.
Dialogue: 0,1:39:23.70,1:39:25.25,Default,,0,0,0,,Мен бәрін... иеленемін!
Dialogue: 0,1:39:25.37,1:39:28.37,Default,,0,0,0,,Дәл қазір біз Кираның шынайы тұлғасын ашқалы жатырмыз⸺
Dialogue: 0,1:39:28.50,1:39:30.79,Default,,0,0,0,,Сізге, батыл куәгер.
Dialogue: 0,1:39:30.92,1:39:34.55,Default,,0,0,0,,Бізге көбірек қолдау телефон қоңыраулары мен факстар түсуде.
Dialogue: 0,1:39:34.67,1:39:36.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:36.97,1:39:38.63,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:39:38.63,1:39:39.09,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:39:38.63,1:39:39.09,Default,,0,0,0,,Не!?
Dialogue: 0,1:39:39.09,1:39:39.68,Default,,0,0,0,,Не!?
Dialogue: 0,1:39:39.68,1:39:40.09,Default,,0,0,0,,Не!?
Dialogue: 0,1:39:39.68,1:39:40.09,Default,,0,0,0,,Жағдайларға байланысты бұл бағдарлама осы жерде аяқталады.
Dialogue: 0,1:39:40.09,1:39:41.14,Default,,0,0,0,,Жағдайларға байланысты бұл бағдарлама осы жерде аяқталады.
Dialogue: 0,1:39:41.14,1:39:43.60,Default,,0,0,0,,Жағдайларға байланысты бұл бағдарлама осы жерде аяқталады.
Dialogue: 0,1:39:41.14,1:39:43.60,Default,,0,0,0,,Қуыршақ! Амал жоқ...
Dialogue: 0,1:39:43.72,1:39:45.60,Default,,0,0,0,,Міне, Кратер! (Синдер) Ух...
Dialogue: 0,1:39:45.72,1:39:47.27,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,1:39:49.56,1:39:50.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:52.56,1:39:54.11,Default,,0,0,0,,Тек сөмкесі бар. Біз оның ізіне түстік.
Dialogue: 0,1:39:54.73,1:39:57.19,Default,,0,0,0,,Не... бірдеңені дұрыс түсінбедіңіз бе?
Dialogue: 0,1:39:57.95,1:40:00.82,Default,,0,0,0,,Менің Демегава мырзамен сөйлесетін бірдеңе бар...
Dialogue: 0,1:40:00.95,1:40:03.24,Default,,0,0,0,,Енді маған визитка беріңіз...
Dialogue: 0,1:40:03.37,1:40:05.33,Default,,0,0,0,,Иә! (Үйлену Соичиро) Ух...
Dialogue: 0,1:40:06.08,1:40:07.58,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,1:40:08.12,1:40:09.00,Default,,0,0,0,,Жоқ, бұл 70 пайызға жетеді, бұл
Dialogue: 0,1:40:09.12,1:40:10.33,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:11.13,1:40:14.63,Default,,0,0,0,,Тиндерде мылтық бар Директорды атып тастады!
Dialogue: 0,1:40:14.75,1:40:15.96,Default,,0,0,0,,Егер мен тым егжей-тегжейге тоқталсам,
Dialogue: 0,1:40:16.09,1:40:17.05,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:40:17.17,1:40:21.55,Default,,0,0,0,,Бізде оны қамтамасыз етуді тікелей жалғастырудан басқа амал жоқ.
Dialogue: 0,1:40:21.68,1:40:24.22,Default,,0,0,0,,Ватари Сіз дайынсыз ба? иә
Dialogue: 0,1:40:42.41,1:40:43.49,Default,,0,0,0,,Уф!
Dialogue: 0,1:40:52.46,1:40:54.04,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:58.63,1:41:01.01,Default,,0,0,0,,Уф... у-х
Dialogue: 0,1:41:08.56,1:41:10.14,Default,,0,0,0,,Міне (кратер) Уау...
Dialogue: 0,1:41:16.40,1:41:18.82,Default,,0,0,0,,Келме! Ешкімнің келуіне жол берме!
Dialogue: 0,1:41:18.94,1:41:20.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:28.66,1:41:29.87,Default,,0,0,0,,Періштенің нұры
Dialogue: 0,1:41:31.25,1:41:33.54,Default,,0,0,0,,Иә, дұрыс айтасың.
Dialogue: 0,1:41:33.67,1:41:35.29,Default,,0,0,0,,Уф...
Dialogue: 0,1:41:35.42,1:41:39.55,Default,,0,0,0,,(кратердің жылдам тынысы)
Dialogue: 0,1:41:47.68,1:41:49.60,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:41:53.31,1:41:57.56,Default,,0,0,0,,Tinder Сіз қалай өлтірдіңіз? айт
Dialogue: 0,1:42:03.32,1:42:04.66,Default,,0,0,0,,Бұл дәптер.
Dialogue: 0,1:42:04.78,1:42:05.57,Default,,0,0,0,,Дәптер ме?
Dialogue: 0,1:42:06.32,1:42:08.08,Default,,0,0,0,,Сен бұған сенбейсің, бірақ
Dialogue: 0,1:42:08.20,1:42:10.49,Default,,0,0,0,,Бет-әлпетін білетін адамның атын жазу
Dialogue: 0,1:42:10.62,1:42:12.96,Default,,0,0,0,,Сонымен қатар, Ягами-сан, Мокки-саннан Цукидің қозғалысын бақылап отыруды сұраңыз
Dialogue: 0,1:42:14.29,1:42:15.83,Default,,0,0,0,,Ескертулер…
Dialogue: 0,1:42:15.96,1:42:17.29,Default,,0,0,0,,осы екінші видеоны тарату үшін
Dialogue: 0,1:42:17.42,1:42:21.30,Default,,0,0,0,,Аа, ол қапшықта болды.
Dialogue: 0,1:42:21.42,1:42:24.22,Default,,0,0,0,,Адамның аты-жөні жазылғаны рас, бірақ
Dialogue: 0,1:42:24.34,1:42:26.68,Default,,0,0,0,,Ерекше ерекше блокнотта...
Dialogue: 0,1:42:26.80,1:42:29.22,Default,,0,0,0,,Ах! Ах
Dialogue: 0,1:42:29.35,1:42:30.72,Default,,0,0,0,,Не болды? Әке!
Dialogue: 0,1:42:30.85,1:42:33.18,Default,,0,0,0,,А... мынау... мынау
Dialogue: 0,1:42:33.31,1:42:36.06,Default,,0,0,0,,Оны дәптерді ұстағандар ғана көреді.
Dialogue: 0,1:42:36.19,1:42:39.06,Default,,0,0,0,,Егер... құбыжық...
Dialogue: 0,1:42:40.69,1:42:42.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:42:48.37,1:42:51.33,Default,,0,0,0,,Грим Реапер... солай ма?
Dialogue: 0,1:42:51.45,1:42:55.00,Default,,0,0,0,,Шынында да болды...
Dialogue: 0,1:42:55.12,1:42:56.29,Default,,0,0,0,,Цуки Ягами…
Dialogue: 0,1:42:56.42,1:42:59.54,Default,,0,0,0,,Жазбалар... Аоямада бір-біріне жазбаларды көрсету
Dialogue: 0,1:42:59.67,1:43:00.50,Default,,0,0,0,,Мен екінші бір көргеннен ғашық болдым...
Dialogue: 0,1:43:00.63,1:43:02.17,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,1:43:02.30,1:43:04.01,Default,,0,0,0,,Кираны өлтіру құралдары 2-ші...
Dialogue: 0,1:43:04.13,1:43:05.30,Default,,0,0,0,,Моги мырза, жоспар бойынша, қабылдағышты Хигучиге қойыңыз.
Dialogue: 0,1:43:06.51,1:43:11.56,Default,,0,0,0,,Екі немесе одан да көп жазу кітапшалары бар Әлі аяқталмады
Dialogue: 0,1:43:12.39,1:43:13.22,Default,,0,0,0,,Хмм...
Dialogue: 0,1:43:20.11,1:43:25.07,Default,,0,0,0,,Шыу!
Dialogue: 0,1:43:36.37,1:43:39.58,Default,,0,0,0,,Ха... ха...
Dialogue: 0,1:43:40.83,1:43:43.50,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,1:43:43.63,1:43:45.88,Default,,0,0,0,,Мұндай құбыжық кез келген адамды таң қалдырады.
Dialogue: 0,1:43:47.17,1:43:48.38,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,1:43:48.51,1:43:49.59,Default,,0,0,0,,Иә
Dialogue: 0,1:43:49.72,1:43:52.26,Default,,0,0,0,,Ең алдымен, мұнда жазылған адамдармен.
Dialogue: 0,1:43:52.39,1:43:55.06,Default,,0,0,0,,Мен жәбірленушінің атын сәйкестендіруге тырысамын.
Dialogue: 0,1:43:55.18,1:43:59.81,Default,,0,0,0,,Не? Иә, дұрыс
Dialogue: 0,1:44:05.73,1:44:07.24,Default,,0,0,0,,Модель! Модель! Менің не болып жатқанын түсіндірші!
Dialogue: 0,1:44:09.15,1:44:11.20,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,1:44:11.32,1:44:12.49,Default,,0,0,0,,(Шұбар жылау)
Dialogue: 0,1:44:12.62,1:44:13.58,Default,,0,0,0,,Ha
Dialogue: 0,1:44:13.70,1:44:16.04,Default,,0,0,0,,Уф! (Соичиро) Кратер! Рюзаки кратері!
Dialogue: 0,1:44:16.79,1:44:18.25,Default,,0,0,0,,Не? Не болды!
Dialogue: 0,1:44:18.37,1:44:20.67,Default,,0,0,0,,Ах... гах...
Dialogue: 0,1:44:20.79,1:44:21.88,Default,,0,0,0,,Әй, кратер!
Dialogue: 0,1:44:22.00,1:44:24.84,Default,,0,0,0,,Не... не істеп жатырсың, әке!
Dialogue: 0,1:44:24.96,1:44:27.26,Default,,0,0,0,,Егер мен осы жерде кратерде өлетін болсам...
Dialogue: 0,1:44:27.38,1:44:32.76,Default,,0,0,0,,Жарайды... болмайды... жоқ, бірақ бұл қазірдің өзінде...
Dialogue: 0,1:44:34.55,1:44:36.97,Default,,0,0,0,,О, мен өлдім.
Dialogue: 0,1:44:37.98,1:44:39.60,Default,,0,0,0,,Моги мырза, жоспар бойынша, қабылдағышты Хигучиге қойыңыз.
Dialogue: 0,1:44:41.19,1:44:42.56,Default,,0,0,0,,Хигучи
Dialogue: 0,1:44:57.91,1:44:58.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:45:07.30,1:45:08.13,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,1:45:08.26,1:45:10.63,Default,,0,0,0,,Сен бұған сенбейсің, бірақ
Dialogue: 0,1:45:10.76,1:45:13.64,Default,,0,0,0,,Мен бұл дәптерді қашан пайдаланғаным туралы
Dialogue: 0,1:45:15.76,1:45:16.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:19.64,1:45:22.81,Default,,0,0,0,,«Сен осы хатты оқығанша, Умиса»
Dialogue: 0,1:45:22.94,1:45:24.98,Default,,0,0,0,,«Сіз бәрін есте сақтауыңыз керек».
Dialogue: 0,1:45:25.11,1:45:27.52,Default,,0,0,0,,Онда адамдардың аттары жазылғаны рас, бірақ
Dialogue: 0,1:45:28.23,1:45:31.57,Default,,0,0,0,,«Тойо университетінде ол өзін Тошики Рукава деп атады»
Dialogue: 0,1:45:31.70,1:45:33.66,Default,,0,0,0,,«Менің досым есіңде ме?»
Dialogue: 0,1:45:33.78,1:45:37.91,Default,,0,0,0,,«Дәптерге шын атын жазып, жерле».
Dialogue: 0,1:45:38.04,1:45:40.12,Default,,0,0,0,,«Бұл хатты дереу өртеп жібер».
Dialogue: 0,1:45:40.25,1:45:42.41,Default,,0,0,0,,«Мен дәптерімнің бірнеше бетін ғана жасырамын»
Dialogue: 0,1:45:42.54,1:45:45.58,Default,,0,0,0,,«Дәптердің өзін толтырыңыз»
Dialogue: 0,1:45:45.71,1:45:47.79,Default,,0,0,0,,«Мені келесі жолы көргенде»
Dialogue: 0,1:45:47.92,1:45:50.63,Default,,0,0,0,,«Дәптерімнің қалдықтарымен табиғатты түртіп көрейін».
Dialogue: 0,1:45:50.76,1:45:53.63,Default,,0,0,0,,«Егер сен осыны орындасаң, мен саған Умисаны беремін...»
Dialogue: 0,1:45:53.76,1:45:54.55,Default,,0,0,0,,Уау...
Dialogue: 0,1:45:54.68,1:45:56.97,Default,,0,0,0,,«Мен сені мәңгі сүйемін»
Dialogue: 0,1:45:57.10,1:45:58.06,Default,,0,0,0,,Иә!
Dialogue: 0,1:45:58.18,1:46:01.56,Default,,0,0,0,,Директор… ол жай ғана шаршаған
Dialogue: 0,1:46:01.68,1:46:04.56,Default,,0,0,0,,Осы дәптерді теңіз құмына беріп, оның естеліктерін қалпына келтіріңіз.
Dialogue: 0,1:46:05.85,1:46:09.36,Default,,0,0,0,,Рукава Токики... Рюзакиді өлтіріңіз
Dialogue: 0,1:46:10.23,1:46:13.03,Default,,0,0,0,,Бұл айдағы бір кедергіні жояды.
Dialogue: 0,1:46:13.15,1:46:15.53,Default,,0,0,0,,Теңіз құмы айдың қуатына айналуы мүмкін...
Dialogue: 0,1:46:16.24,1:46:20.45,Default,,0,0,0,,Хмм... у... жоқ, Ай.
Dialogue: 0,1:46:21.50,1:46:23.71,Default,,0,0,0,,Директор: Мен де барамын.
Dialogue: 0,1:46:24.58,1:46:26.12,Default,,0,0,0,,Күніне ондаған адам
Dialogue: 0,1:46:26.25,1:46:29.67,Default,,0,0,0,,Мен жүздеген адамдардың аты-жөні мен өмір сүру ұзақтығын көрдім.
Dialogue: 0,1:46:30.42,1:46:33.47,Default,,0,0,0,,Ах! Не істесем де, есімде жоқ!
Dialogue: 0,1:46:33.59,1:46:35.51,Default,,0,0,0,,Теңіз құмы ақымақ!
Dialogue: 0,1:46:35.63,1:46:36.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:36.80,1:46:37.68,Default,,0,0,0,,А...
Dialogue: 0,1:46:37.80,1:46:40.14,Default,,0,0,0,,Мен осында оралдым.
Dialogue: 0,1:46:40.26,1:46:41.52,Default,,0,0,0,,оны өлтірмей ұстаңдар.
Dialogue: 0,1:46:41.64,1:46:44.39,Default,,0,0,0,,Біраз уақыт өтті. Қалайсың? Ахаха
Dialogue: 0,1:46:44.52,1:46:46.14,Default,,0,0,0,,Ахахха... (Рюк) Кешіріңіз...
Dialogue: 0,1:46:46.27,1:46:48.40,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,1:46:49.36,1:46:52.28,Default,,0,0,0,,Мен де ер адаммын.
Dialogue: 0,1:46:52.40,1:46:53.19,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,1:46:53.32,1:46:55.90,Default,,0,0,0,,Жақсы өткен сияқты.
Dialogue: 0,1:46:56.74,1:47:00.45,Default,,0,0,0,,Сіз дәптерге иелік етуден бас тартсаңыз, есте сақтау қабілетіңіз жоғалады.
Dialogue: 0,1:47:00.58,1:47:05.37,Default,,0,0,0,,Ақырында дәптерді тағы бір түртіп, есте сақтау қабілетім қалпына келеді.
Dialogue: 0,1:47:06.75,1:47:09.17,Default,,0,0,0,,Осы кезде Рэм басқа жігіт туралы айтып отырды.
Dialogue: 0,1:47:09.29,1:47:13.13,Default,,0,0,0,,Айдың келуін шыдамдылықпен күттім.
Dialogue: 0,1:47:14.63,1:47:18.72,Default,,0,0,0,,Ал қазір полиция жігіттері дәптерге қарап отыр.
Dialogue: 0,1:47:18.84,1:47:24.31,Default,,0,0,0,,Сонда мен айға жазылған жалған ережелермен қиналып жүрмін бе?
Dialogue: 0,1:47:25.31,1:47:26.81,Default,,0,0,0,,Олай болса, Рем мырза.
Dialogue: 0,1:47:27.52,1:47:29.98,Default,,0,0,0,,Кезінде дәптерге есімдерін жазғандар
Dialogue: 0,1:47:30.11,1:47:33.32,Default,,0,0,0,,Келесі есімді 13 күн ішінде жазбасаңыз
Dialogue: 0,1:47:33.44,1:47:35.32,Default,,0,0,0,,Бұл сенің өлетініңді білдіре ме?
Dialogue: 0,1:47:37.45,1:47:39.28,Default,,0,0,0,,Не? Яғни
Dialogue: 0,1:47:39.41,1:47:43.08,Default,,0,0,0,,Бұл Цуки-кун мен Миса-Миса толығымен Широ дегенді білдіре ме?
Dialogue: 0,1:47:43.20,1:47:45.37,Default,,0,0,0,,Ах... (Айзава) О, әрине.
Dialogue: 0,1:47:45.50,1:47:50.46,Default,,0,0,0,,Цуки-кун мен Я 50 күннен астам қамауда отырды және әлі де бақылауда.
Dialogue: 0,1:47:50.58,1:47:53.84,Default,,0,0,0,,Егер екеуің Кира болсаңдар, олардың қазір тірі болуы мүмкін емес.
Dialogue: 0,1:47:55.38,1:47:59.93,Default,,0,0,0,,Өте жақсы орындадың, ай бала.
Dialogue: 0,1:48:00.05,1:48:01.76,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,1:48:01.89,1:48:03.14,Default,,0,0,0,,Иә (Рюк) Уау
Dialogue: 0,1:48:03.76,1:48:05.64,Default,,0,0,0,,Хигучи ұсталды.
Dialogue: 0,1:48:07.68,1:48:09.73,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,1:48:09.85,1:48:10.90,Default,,0,0,0,,О
Dialogue: 0,1:48:11.02,1:48:13.82,Default,,0,0,0,,Адам әлеміндегі алма шырынды деп аталады ма?
Dialogue: 0,1:48:13.94,1:48:15.07,Default,,0,0,0,,Дәмді
Dialogue: 0,1:48:17.07,1:48:18.49,Default,,0,0,0,,Егер сөйлемесең, қажетті барлық шараларды қолданып, сөйлетеміз.
Dialogue: 0,1:48:18.61,1:48:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:19.82,1:48:22.45,Default,,0,0,0,,Бұл дәптер.
Dialogue: 0,1:48:22.57,1:48:24.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:48:24.24,1:48:26.16,Default,,0,0,0,,Дәмді емес сияқты...
Dialogue: 0,1:48:26.29,1:48:27.95,Default,,0,0,0,,Бір ауыз сөз
Dialogue: 0,1:48:28.08,1:48:29.25,Default,,0,0,0,,Хмм...
Dialogue: 0,1:48:30.00,1:48:31.67,Default,,0,0,0,,Сондай-ақ, бұл дұрыс, Рюк.
Dialogue: 0,1:48:31.79,1:48:34.29,Default,,0,0,0,,Менімен көзіңді айырбаста
Dialogue: 0,1:48:34.42,1:48:36.25,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,1:48:36.38,1:48:39.80,Default,,0,0,0,,Иә! Пеп құм~!
Dialogue: 0,1:48:39.93,1:48:43.43,Default,,0,0,0,,Уау... Мм...
Dialogue: 0,1:48:45.39,1:48:46.39,Default,,0,0,0,,Мәміле?
Dialogue: 0,1:48:47.14,1:48:48.39,Default,,0,0,0,,Иә
Dialogue: 0,1:48:48.52,1:48:53.77,Default,,0,0,0,,...
Dialogue: 0,1:48:53.90,1:48:58.78,Default,,0,0,0,,Қалған өмірді қайтадан екіге қысқарту дұрыс па?
Dialogue: 0,1:48:58.90,1:49:01.91,Default,,0,0,0,,Хмм, оған көмектесу мүмкін емес.
Dialogue: 0,1:49:02.57,1:49:06.62,Default,,0,0,0,,Есте сақтау керек есімді мүлде ұмытып қалдым.
Dialogue: 0,1:49:06.74,1:49:09.79,Default,,0,0,0,,Жақындап қарамасаң, ай ұрсады.
Dialogue: 0,1:49:11.00,1:49:13.21,Default,,0,0,0,,Жақсы, менде бәрі жақсы.
Dialogue: 0,1:49:17.55,1:49:19.42,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:49:20.26,1:49:21.55,Default,,0,0,0,,Директор… ол жай ғана шаршаған
Dialogue: 0,1:49:21.68,1:49:23.18,Default,,0,0,0,,Рюк
Dialogue: 0,1:49:23.30,1:49:25.93,Default,,0,0,0,,Неліктен теңіз құмына...
Dialogue: 0,1:49:26.05,1:49:26.85,Default,,0,0,0,,Ха!
Dialogue: 0,1:49:29.43,1:49:32.69,Default,,0,0,0,,...
Dialogue: 0,1:49:32.81,1:49:36.65,Default,,0,0,0,,Мен Рюкпен көз алмасамын деп ешқашан ойламадым...
Dialogue: 0,1:49:39.11,1:49:40.07,Default,,0,0,0,,Ай…
Dialogue: 0,1:49:45.53,1:49:47.74,Default,,0,0,0,,Біраз уақыт болды, Рюк.
Dialogue: 0,1:49:47.87,1:49:51.79,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,1:49:58.88,1:50:03.76,Default,,0,0,0,,Умиса Дәл қазір мен сенімен ұзақ уақыт бойы идеалды әлемде өмір сүргім келеді.
Dialogue: 0,1:50:03.88,1:50:05.30,Default,,0,0,0,,Хигучи
Dialogue: 0,1:50:05.43,1:50:07.01,Default,,0,0,0,,Ай мен бақыттымын!
Dialogue: 0,1:50:07.93,1:50:12.48,Default,,0,0,0,,２ ⸺
Dialogue: 0,1:50:12.60,1:50:14.64,Default,,0,0,0,,Жаңа әлем құрайық
Dialogue: 0,1:50:14.77,1:50:15.73,Default,,0,0,0,,Иә
Dialogue: 0,1:50:32.25,1:50:35.46,Default,,0,0,0,,Не болды? Рюзаки
Dialogue: 0,1:50:38.79,1:50:39.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:43.01,1:50:44.47,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,1:50:44.59,1:50:50.14,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,1:50:58.19,1:51:01.07,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,1:51:01.19,1:51:06.15,Default,,0,0,0,,(Балалардың айқайы және берілістердің айналу дыбыстары)
Dialogue: 0,1:51:21.04,1:51:26.01,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:51:45.65,1:51:48.95,Default,,0,0,0,,♪「Misa no uta」
Dialogue: 0,1:51:49.86,1:51:53.58,Default,,0,0,0,,♪～
Dialogue: 0,1:52:48.42,1:52:53.39,Default,,0,0,0,,～♪
Dialogue: 0,1:53:00.60,1:53:01.77,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,1:53:02.69,1:53:04.23,Default,,0,0,0,,Тағы бір қылмыскер өлтіруші...
Dialogue: 0,1:53:04.36,1:53:06.73,Default,,0,0,0,,кеше ғана 16 адам.
Dialogue: 0,1:53:06.86,1:53:09.40,Default,,0,0,0,,Кратер өлгеннен кейін хабарланғандар...
Dialogue: 0,1:53:09.53,1:53:11.07,Default,,0,0,0,,Бұл бір жағы...
Dialogue: 0,1:53:11.20,1:53:15.12,Default,,0,0,0,,Сонда кратер Кира емес пе еді?
Dialogue: 0,1:53:15.24,1:53:17.20,Default,,0,0,0,,Жоқ, кратерді басып алғанша.
Dialogue: 0,1:53:17.33,1:53:20.00,Default,,0,0,0,,Шұңқыр қылмыскерлерді жазалап жатқаны рас.
Dialogue: 0,1:53:20.12,1:53:23.58,Default,,0,0,0,,…
Dialogue: 0,1:53:23.71,1:53:26.21,Default,,0,0,0,,Ах! Неліктен?
Dialogue: 0,1:53:26.34,1:53:28.67,Default,,0,0,0,,Қарғыс атсын, жарқырайсың...
Dialogue: 0,1:53:29.38,1:53:32.55,Default,,0,0,0,,Кира мұнда... не болып жатыр?
Dialogue: 0,1:53:33.72,1:53:35.72,Default,,0,0,0,,О, тәңірім
Dialogue: 0,1:53:35.85,1:53:38.06,Default,,0,0,0,,Осы «Қылмыс дәптерінің» бетінің шеті сәл жыртылған.
Dialogue: 0,1:53:38.18,1:53:41.02,Default,,0,0,0,,Егер мен сол жыртылған жерге бір адамның атын жазсам, ол адам өліп қалар ма?
Dialogue: 0,1:53:41.14,1:53:43.52,Default,,0,0,0,,…
Dialogue: 0,1:53:43.65,1:53:45.65,Default,,0,0,0,,Теңіз құмының оған еш қатысы жоқ.
Dialogue: 0,1:53:45.77,1:53:49.32,Default,,0,0,0,,Бірақ Өлім періштесінің ішкі ағзалары дегенерацияланған
Dialogue: 0,1:53:49.44,1:53:50.78,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:53:52.74,1:53:58.08,Default,,0,0,0,,Егер сізде басқа дәптер болса және оны басқа біреу пайдаланып жатса...
Dialogue: 0,1:53:59.79,1:54:02.58,Default,,0,0,0,,Ақыры босап шыққаныма қарамастан, мен бұл жерден сирек шығамын.
Dialogue: 0,1:54:08.59,1:54:11.13,Default,,0,0,0,,“”
Dialogue: 0,1:54:11.84,1:54:16.30,Default,,0,0,0,,…
Dialogue: 0,1:54:19.51,1:54:21.39,Default,,0,0,0,,Кира ісі әлі шешілмей тұр.
Dialogue: 0,1:54:21.52,1:54:25.56,Default,,0,0,0,,Дегенмен, осы дәптерге бір кездері өз атын жазған адам
Dialogue: 0,1:54:25.69,1:54:29.27,Default,,0,0,0,,Келесі атыңызды 13 күн ішінде жазбасаңыз, өлесіз.
Dialogue: 0,1:54:30.57,1:54:33.82,Default,,0,0,0,,Ягами Цуки мен Я Умиса тірі
Dialogue: 0,1:54:33.95,1:54:37.74,Default,,0,0,0,,13 Тек осы...
Dialogue: 0,1:54:39.45,1:54:44.16,Default,,0,0,0,,Кайса, бірге жаңа әлем құрайық.
Dialogue: 0,1:54:44.29,1:54:48.67,Default,,0,0,0,,Оған жаппай адам өлтірген деген айып тағылып, жазаланады ма?
Dialogue: 0,1:54:48.79,1:54:51.21,Default,,0,0,0,,Ал, шешілді емес пе?
Dialogue: 0,1:54:51.34,1:54:53.05,Default,,0,0,0,,Адамдардың өлетінін білу
Dialogue: 0,1:54:53.17,1:54:55.55,Default,,0,0,0,,That means you wrote down a number of people's names.
Dialogue: 0,1:54:55.68,1:54:58.26,Default,,0,0,0,,If the existence of the notebook should not be made public
Dialogue: 0,1:54:58.39,1:54:59.68,Default,,0,0,0,,Жою керек
Dialogue: 0,1:54:59.80,1:55:00.64,Default,,0,0,0,,Ах...
Dialogue: 0,1:55:00.76,1:55:03.02,Default,,0,0,0,,сен мені әрдайым табасың.
Dialogue: 0,1:55:03.14,1:55:05.94,Default,,0,0,0,,The higher ups will probably take similar measures.
Dialogue: 0,1:55:06.06,1:55:09.44,Default,,0,0,0,,Capital punishment if admitted to murder using notebook
Dialogue: 0,1:55:09.56,1:55:11.73,Default,,0,0,0,,Кем дегенде өмір бойына бас бостандығынан айыру
Dialogue: 0,1:55:13.40,1:55:14.94,Default,,0,0,0,,сен маған қайта-қайта айтып бересің.
Dialogue: 0,1:55:15.74,1:55:19.16,Default,,0,0,0,,Сіз не ойлап отырсыз? Цуки Ягами
Dialogue: 0,1:55:19.28,1:55:22.04,Default,,0,0,0,,Теңіз құмы қолға түссе, ол сіз боласыз...
Dialogue: 0,1:55:22.16,1:55:25.87,Default,,0,0,0,,Ах! Солай ма?
Dialogue: 0,1:55:26.46,1:55:27.92,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,1:55:30.08,1:55:31.34,Default,,0,0,0,,Цуки Ягами
Dialogue: 0,1:55:31.46,1:55:35.51,Default,,0,0,0,,Умисаның өмірін сақтап қалатыныма сенімдімін.
Dialogue: 0,1:55:35.63,1:55:38.26,Default,,0,0,0,,Бұл жағдайда теңіз құмына қалай көмектесуге болады
Dialogue: 0,1:55:38.38,1:55:42.43,Default,,0,0,0,,I have no choice but to write Ryuzaki's real name in my notebook.
Dialogue: 0,1:55:43.22,1:55:46.02,Default,,0,0,0,,Егер мен Рюзакиді өлтірсем...
Dialogue: 0,1:55:48.06,1:55:52.73,Default,,0,0,0,,I'm definitely involved in the lifespan of the sea sand, and I'll die too.
Dialogue: 0,1:55:53.36,1:55:57.65,Default,,0,0,0,,Everything has been completed for Tsuki Yagami's convenience!
Dialogue: 0,1:56:00.45,1:56:03.28,Default,,0,0,0,,Не істеу керек? Рем Мен өлім құдайы болсам да
Dialogue: 0,1:56:03.41,1:56:07.00,Default,,0,0,0,,I'm fully aware that you're stuck in the sea sand.
Dialogue: 0,1:56:07.96,1:56:13.04,Default,,0,0,0,,You cannot abandon the sea sand whose lifespan has further decreased.
Dialogue: 0,1:56:13.17,1:56:15.51,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,1:56:36.03,1:56:37.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:56:50.21,1:56:53.08,Default,,0,0,0,,Ондай жерде не істеп жүрсің? Рюзаки
Dialogue: 0,1:56:56.46,1:56:58.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:56:58.13,1:57:00.88,Default,,0,0,0,,What are you doing in a place like that, Ryuzaki?
Dialogue: 0,1:57:03.43,1:57:04.64,Default,,0,0,0,,Хмм
Dialogue: 0,1:57:13.98,1:57:15.90,Default,,0,0,0,,Сіз не істеп жатырсыз? Рюзаки
Dialogue: 0,1:57:16.48,1:57:19.99,Default,,0,0,0,,Жоқ, бұл соншалықты үлкен мәселе емес.
Dialogue: 0,1:57:21.15,1:57:22.45,Default,,0,0,0,,Қоңырау үні...
Dialogue: 0,1:57:23.32,1:57:24.66,Default,,0,0,0,,Қоңырау?
Dialogue: 0,1:57:24.78,1:57:29.91,Default,,0,0,0,,Иә, бүгін қоңыраулар шынымен шулы.
Dialogue: 0,1:57:30.04,1:57:31.58,Default,,0,0,0,,Әй?
Dialogue: 0,1:57:33.88,1:57:35.33,Default,,0,0,0,,Каиша келгенде де, біз тек бірнеше минут тұрып әңгімелесеміз.
Dialogue: 0,1:57:36.13,1:57:37.84,Default,,0,0,0,,Шынында ма?
Dialogue: 0,1:57:37.96,1:57:40.38,Default,,0,0,0,,Бүгін тоқтаусыз
Dialogue: 0,1:57:40.51,1:57:43.22,Default,,0,0,0,,Мен уайымдамай тұра алмаймын.
Dialogue: 0,1:57:43.84,1:57:46.68,Default,,0,0,0,,Бұл шіркеу ме? той?
Dialogue: 0,1:57:47.47,1:57:49.77,Default,,0,0,0,,Әлде... (Ай) Не айтып тұрсың? Рюзаки
Dialogue: 0,1:57:50.43,1:57:53.48,Default,,0,0,0,,Қазір мен қылмыскерлерді соттауға қауқарлы емеспін.
Dialogue: 0,1:57:53.60,1:57:55.90,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,1:57:56.94,1:57:59.15,Default,,0,0,0,,Менің айтқанымның бәрі бос сөз.
Dialogue: 0,1:57:59.90,1:58:02.11,Default,,0,0,0,,Бір сөзге сенбе
Dialogue: 0,1:58:03.20,1:58:04.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:58:09.45,1:58:12.58,Default,,0,0,0,,А... Дұрыс, Рюзаки.
Dialogue: 0,1:58:13.16,1:58:15.67,Default,,0,0,0,,Айтқандарыңыздың көбі бос сөз.
Dialogue: 0,1:58:15.79,1:58:19.21,Default,,0,0,0,,If we take each issue seriously, there will be no end to it.
Dialogue: 0,1:58:19.34,1:58:22.13,Default,,0,0,0,,Бұл менің ең жақсы білетінім.
Dialogue: 0,1:58:22.92,1:58:26.14,Default,,0,0,0,,Иә, дұрыс, Цуки-кун.
Dialogue: 0,1:58:28.10,1:58:31.89,Default,,0,0,0,,Бірақ бұл өзара.
Dialogue: 0,1:58:32.02,1:58:35.02,Default,,0,0,0,,Хм... Бұл нені білдіреді?
Dialogue: 0,1:58:36.65,1:58:38.23,Default,,0,0,0,,Тіпті туғаннан бері бір рет
Dialogue: 0,1:58:38.36,1:58:41.15,Default,,0,0,0,,Сіз шындықты айттыңыз ба?
Dialogue: 0,1:58:47.99,1:58:50.41,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Рюзаки
Dialogue: 0,1:58:50.54,1:58:53.00,Default,,0,0,0,,Менің де кейде өтірік айтатыным рас.
Dialogue: 0,1:58:53.54,1:58:57.83,Default,,0,0,0,,Бірақ өмірін тек шындықты айтумен өткізетіндер де бар⸺
Dialogue: 0,1:58:57.96,1:58:59.25,Default,,0,0,0,,Біреу жоқ па?
Dialogue: 0,1:59:00.13,1:59:03.26,Default,,0,0,0,,Адамдар соншалықты мінсіз емес.
Dialogue: 0,1:59:03.38,1:59:06.76,Default,,0,0,0,,Барлығы өтірік айта алады, бірақ мен айтамын⸺
Dialogue: 0,1:59:06.88,1:59:11.64,Default,,0,0,0,,Мен әрқашан басқаларға қасақана зиян келтіретін өтірік айтпауға тырыстым.
Dialogue: 0,1:59:11.76,1:59:13.43,Default,,0,0,0,,Демек, тағы бір Кира пайда болды.
Dialogue: 0,1:59:16.14,1:59:18.98,Default,,0,0,0,,Ааа, сен осылай айтасың деп ойладым.
Dialogue: 0,1:59:32.03,1:59:34.66,Default,,0,0,0,,Әй, Рюзаки! Не айтқың келеді?
Dialogue: 0,1:59:34.79,1:59:39.00,Default,,0,0,0,,Олар тіпті белгілі бір елден дәптерді өлім жазасына кесуде қолдануға рұқсат алды...
Dialogue: 0,1:59:39.13,1:59:41.50,Default,,0,0,0,,Құдай қарап тұр.
Dialogue: 0,1:59:41.63,1:59:42.42,Default,,0,0,0,,Жоқ
Dialogue: 0,1:59:42.55,1:59:46.92,Default,,0,0,0,,Дәптеріңізді алып жүруді дереу реттеңіз.
Dialogue: 0,1:59:47.05,1:59:48.09,Default,,0,0,0,,Иә
Dialogue: 0,1:59:48.22,1:59:49.64,Default,,0,0,0,,Эй, Рюзаки, сен не айтып тұрсың?
Dialogue: 0,1:59:51.22,1:59:53.64,Default,,0,0,0,,Бұл дәптерді іс жүзінде сынап көру дегенді білдіреді.
Dialogue: 0,1:59:53.76,1:59:54.89,Default,,0,0,0,,Ха…
Dialogue: 0,1:59:55.02,1:59:57.77,Default,,0,0,0,,Бұл мүмкін емес. Енді мұны істеудің қажеті жоқ.
Dialogue: 0,1:59:57.89,2:00:00.10,Default,,0,0,0,,Бұл нотаның күші шынайы, солай ма?
Dialogue: 0,2:00:00.23,2:00:02.15,Default,,0,0,0,,Жалпы айтқанда есімді кім жазады?
Dialogue: 0,2:00:02.27,2:00:05.36,Default,,0,0,0,,Бір рет жазылған, 13 күн ішінде
Dialogue: 0,2:00:05.48,2:00:07.90,Default,,0,0,0,,Маған мәңгілікке жазу керек
Dialogue: 0,2:00:08.03,2:00:10.57,Default,,0,0,0,,Ал егер мен бәрін түсіне бастасам, мен не істеуім керек?
Dialogue: 0,2:00:10.70,2:00:14.45,Default,,0,0,0,,Содан кейін 13 күн ішінде өлім жазасына кесілген адам өлім жазасына кесіледі.
Dialogue: 0,2:00:14.58,2:00:16.62,Default,,0,0,0,,13 күннен кейін әлі тірі болсаңыз
Dialogue: 0,2:00:16.75,2:00:19.29,Default,,0,0,0,,Өлім жазасынан құтылу үшін кінәсін мойындау туралы келісім жасаңыз
Dialogue: 0,2:00:19.42,2:00:20.21,Default,,0,0,0,,Ах...
Dialogue: 0,2:00:20.88,2:00:22.54,Default,,0,0,0,,Бірақ адам өмірі...
Dialogue: 0,2:00:22.67,2:00:24.34,Default,,0,0,0,,Демек, Хигучи Кира емес болып шықты ғой?
Dialogue: 0,2:00:24.46,2:00:28.22,Default,,0,0,0,,Егер мұны тазалау мүмкін болса, ол бірден шешімге әкеледі.
Dialogue: 0,2:00:28.34,2:00:32.26,Default,,0,0,0,,(Найзағай)
Dialogue: 0,2:00:32.39,2:00:33.10,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,2:00:33.10,2:00:35.72,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,2:00:33.10,2:00:35.72,Default,,0,0,0,,Ах... (Мацуда) Не...? Электр қуатының үзілуі?
Dialogue: 0,2:00:35.72,2:00:35.85,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,2:00:35.85,2:00:37.85,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,2:00:35.85,2:00:37.85,Default,,0,0,0,,Ах...
Dialogue: 0,2:00:37.98,2:00:40.10,Default,,0,0,0,,Ах... а...
Dialogue: 0,2:00:40.23,2:00:45.90,Default,,0,0,0,,(Ватаридің ыңырануы)
Dialogue: 0,2:00:46.86,2:00:47.65,Default,,0,0,0,,Ақыры босап шыққаныма қарамастан, мен бұл жерден сирек шығамын.
Dialogue: 0,2:00:47.78,2:00:48.57,Default,,0,0,0,,Ах...
Dialogue: 0,2:00:50.24,2:00:51.03,Default,,0,0,0,,Ватари…
Dialogue: 0,2:00:51.16,2:00:52.78,Default,,0,0,0,,Ах...
Dialogue: 0,2:00:53.37,2:00:54.37,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,2:00:54.49,2:00:57.37,Default,,0,0,0,,Деректерді өшіру? Не айтқың келеді?
Dialogue: 0,2:00:58.00,2:01:01.62,Default,,0,0,0,,Ватариге бірдеңе болса,
Dialogue: 0,2:01:01.75,2:01:04.67,Default,,0,0,0,,Ол барлық деректердің артта қалмауын қамтамасыз етеді.
Dialogue: 0,2:01:05.34,2:01:07.09,Default,,0,0,0,,Ал егер...
Dialogue: 0,2:01:07.21,2:01:08.21,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,2:01:08.34,2:01:09.84,Default,,0,0,0,,Қасқыр туралы не деуге болады?
Dialogue: 0,2:01:09.97,2:01:11.47,Default,,0,0,0,,Енді ойлап қарасам...
Dialogue: 0,2:01:14.22,2:01:16.31,Default,,0,0,0,,Ешқайда (Соичиро) Не айтып тұрсың!
Dialogue: 0,2:01:16.43,2:01:18.31,Default,,0,0,0,,Барлығы, Шинига...
Dialogue: 0,2:01:18.43,2:01:19.64,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,2:01:19.77,2:01:21.14,Default,,0,0,0,,Ми…
Dialogue: 0,2:01:48.71,2:01:51.97,Default,,0,0,0,,Рю... Рюзаки, не болды!?
Dialogue: 0,2:01:54.43,2:01:59.89,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,2:02:15.41,2:02:18.37,Default,,0,0,0,,(Қоңырау соғуын тоқтатады)
Dialogue: 0,2:02:37.60,2:02:39.47,Default,,0,0,0,,Сәлем Рюзаки
Dialogue: 0,2:02:39.60,2:02:41.56,Default,,0,0,0,,Не болды! Мықты болыңыз!
Dialogue: 0,2:02:41.68,2:02:44.10,Default,,0,0,0,,Не... Не! (Моки) Не болып жатыр?
Dialogue: 0,2:02:44.23,2:02:47.35,Default,,0,0,0,,Уау! Ааа...
Dialogue: 0,2:02:47.48,2:02:48.48,Default,,0,0,0,,Сабыр ет, ай!
Dialogue: 0,2:02:48.61,2:02:52.61,Default,,0,0,0,,Өлтірілді! Ватари Рюзаки Қалғаны біз...
Dialogue: 0,2:02:52.74,2:02:55.57,Default,,0,0,0,,Эй... Эй! (Мацуда) Уау...
Dialogue: 0,2:02:55.70,2:02:56.95,Default,,0,0,0,,Уф... (Моки) Уф...
Dialogue: 0,2:03:01.87,2:03:05.08,Default,,0,0,0,,Ууууууу... а?
Dialogue: 0,2:03:06.00,2:03:07.42,Default,,0,0,0,,Қат! (Мацуда) А...
Dialogue: 0,2:03:07.54,2:03:10.29,Default,,0,0,0,,Қасқыр қай жерде! Шығу!
Dialogue: 0,2:03:10.42,2:03:12.00,Default,,0,0,0,,Ла...Ай
Dialogue: 0,2:03:12.13,2:03:14.55,Default,,0,0,0,,Қазір мен романтика туралы ойлауға өзімді дайын сезіне алмаймын.
Dialogue: 0,2:03:14.67,2:03:16.68,Default,,0,0,0,,Шық!
Dialogue: 0,2:03:41.66,2:03:42.83,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,2:03:43.66,2:03:49.08,Default,,0,0,0,,Жаназаны ешкімге білдіртпей өзіміз өткіздік.
Dialogue: 0,2:03:49.92,2:03:53.05,Default,,0,0,0,,Және сізді тірі етіп көрсетіңіз
Dialogue: 0,2:03:53.17,2:03:58.30,Default,,0,0,0,,Әлемдік полиция күштерін бұрынғыдай басқаруды жалғастырыңыз
Dialogue: 0,2:03:59.14,2:04:01.80,Default,,0,0,0,,Мен Кираны ұстаймын.
Dialogue: 0,2:04:02.56,2:04:03.97,Default,,0,0,0,,Уәде берейік
Dialogue: 0,2:04:05.60,2:04:07.85,Default,,0,0,0,,Ұйқыларыңыз тыныш болсын.
Dialogue: 0,2:04:10.52,2:04:12.06,Default,,0,0,0,,Иә.
Dialogue: 0,2:04:13.48,2:04:16.07,Default,,0,0,0,,Рюзакидің жаулары міндетті түрде жеңіледі.
Dialogue: 0,2:04:16.99,2:04:21.20,Default,,0,0,0,,Менің мақсатым осы істі шешу.
Dialogue: 0,2:04:21.32,2:04:26.20,Default,,0,0,0,,Ватари және басқа құрбандар үшін, барлығы үшін.
Dialogue: 0,2:04:26.33,2:04:28.71,Default,,0,0,0,,Әрине мен
Dialogue: 0,2:04:29.58,2:04:32.88,Default,,0,0,0,,Мен Кираны асуға жіберемін.
Dialogue: 0,2:04:39.88,2:04:41.47,Default,,0,0,0,,Цуки-кун…
Dialogue: 0,2:04:48.68,2:04:50.94,Default,,0,0,0,,Мацуда (Мацуда) Ах...
Dialogue: 0,2:04:51.06,2:04:52.19,Default,,0,0,0,,Ах...
Dialogue: 0,2:04:59.57,2:05:01.24,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,2:05:01.36,2:05:04.66,Default,,0,0,0,,Л да ақыры дүниеден өтті.
Dialogue: 0,2:05:05.78,2:05:10.00,Default,,0,0,0,,Олай болса мен енді аса қызық ештеңе күте алмаймын.
Dialogue: 0,2:05:11.92,2:05:14.92,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,2:05:15.04,2:05:19.17,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,2:05:19.30,2:05:21.84,Default,,0,0,0,,Хехехе...
Dialogue: 0,2:05:21.97,2:05:25.01,Default,,0,0,0,,Ахахаха…
Dialogue: 0,2:05:25.14,2:05:30.60,Default,,0,0,0,,(Айдың күлкісі)
Dialogue: 0,2:05:30.73,2:05:34.10,Default,,0,0,0,,Енді барлық кедергілер жойылды.
Dialogue: 0,2:05:34.23,2:05:36.61,Default,,0,0,0,,Басқалар маған толық сенеді
Dialogue: 0,2:05:37.65,2:05:40.49,Default,,0,0,0,,Олар полицияны бақылауға алғанша уақыт мәселесі.
Dialogue: 0,2:05:40.61,2:05:42.40,Default,,0,0,0,,Не болды L!
Dialogue: 0,2:05:43.16,2:05:45.12,Default,,0,0,0,,Бұл сөзсіз менің жеңісім!
Dialogue: 0,2:05:45.24,2:05:48.16,Default,,0,0,0,,Менікі! Бұл жеңіс!
Dialogue: 0,2:06:08.31,2:06:11.81,Default,,0,0,0,,Сонымен, сіз енді қызықты ештеңе күте алмайсыз ба?
Dialogue: 0,2:06:11.93,2:06:13.10,Default,,0,0,0,,Рюк
Dialogue: 0,2:06:14.48,2:06:16.61,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,2:06:17.31,2:06:18.52,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,2:06:22.07,2:06:25.41,Default,,0,0,0,,Мен – Цукидің қызы, Миса
Dialogue: 0,2:06:46.97,2:06:49.93,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,2:07:10.08,2:07:11.45,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,2:07:13.08,2:07:14.62,Default,,0,0,0,,Жаңа әлем...
Dialogue: 0,2:07:17.17,2:07:18.33,Default,,0,0,0,,Құдай
Dialogue: 0,2:07:36.48,2:07:40.48,Default,,0,0,0,,Ол кезде сен құдай емес едің.
Dialogue: 0,2:07:41.11,2:07:42.98,Default,,0,0,0,,Бұл дұрысырақ...
Dialogue: 0,2:07:49.03,2:07:50.45,Default,,0,0,0,,Өзі... өзім істеймін.
Dialogue: 0,2:07:52.49,2:07:53.66,Default,,0,0,0,,Хаха
Dialogue: 0,2:07:54.75,2:07:58.71,Default,,0,0,0,,Барып, жолы болғанын көріңіз.
Dialogue: 0,2:07:58.83,2:08:01.71,Default,,0,0,0,,Бір ашуланшақ жігіт дәптерді алды.
Dialogue: 0,2:08:01.84,2:08:06.63,Default,,0,0,0,,Сіз ешқашан ұмытпайтын қызықты нәрсені көресіз.
Dialogue: 0,2:08:10.72,2:08:12.43,Default,,0,0,0,,Қайдасың?
Dialogue: 0,2:08:13.81,2:08:16.81,Default,,0,0,0,,Сәлем? ай
Dialogue: 0,2:08:21.15,2:08:26.11,Default,,0,0,0,,♪～
Dialogue: 0,2:09:55.20,2:10:00.16,Default,,0,0,0,,～♪
Dialogue: 0,2:10:01.66,2:10:07.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory