Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:22.93,0:02:28.33,Default,,0,0,0,,Ах ха ха ха ха ха ха
Dialogue: 0,0:02:31.50,0:02:44.60,Default,,0,0,0,,(көк арфа)
Dialogue: 0,0:02:55.86,0:02:56.36,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:56.36,0:02:56.93,Default,,0,0,0,,Куу Куу
Dialogue: 0,0:02:56.96,0:02:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.43,0:02:57.93,Default,,0,0,0,,Ит
Dialogue: 0,0:02:58.26,0:03:00.20,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:00.50,0:03:01.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:05.03,0:03:06.13,Default,,0,0,0,,Кук кук кук
Dialogue: 0,0:03:08.76,0:03:09.63,Default,,0,0,0,,Ха Ам
Dialogue: 0,0:03:10.06,0:03:10.56,Default,,0,0,0,,Күн
Dialogue: 0,0:03:11.53,0:03:13.70,Default,,0,0,0,,Жұмыс істемейтіндер тамақтанбасын.
Dialogue: 0,0:03:14.00,0:03:16.33,Default,,0,0,0,,Тамағыңызды өзіңіз сақтаңыз.
Dialogue: 0,0:03:17.60,0:03:18.80,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:03:19.13,0:03:21.33,Default,,0,0,0,,Әйел тірі болғанымен ғана ұлы.
Dialogue: 0,0:03:24.66,0:03:25.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:29.60,0:03:30.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:32.06,0:03:33.56,Default,,0,0,0,,3 млн.
Dialogue: 0,0:03:34.30,0:03:36.80,Default,,0,0,0,,Жарайды, оны адам тапсын.
Dialogue: 0,0:03:40.10,0:03:42.20,Default,,0,0,0,,Жоқ, блюз арфасы жақсы.
Dialogue: 0,0:03:42.26,0:03:43.60,Default,,0,0,0,,Бұл бәрібір жақсы
Dialogue: 0,0:03:44.26,0:03:45.86,Default,,0,0,0,,Сіз джаз фанаты емес пе едіңіз?
Dialogue: 0,0:03:46.50,0:03:47.73,Default,,0,0,0,,Оны ақымақтықпен айт
Dialogue: 0,0:03:48.13,0:03:50.06,Default,,0,0,0,,Анамның сүтін емсем де
Dialogue: 0,0:03:50.23,0:03:52.36,Default,,0,0,0,,Мен соқырлықты қолдандым.
Dialogue: 0,0:03:52.80,0:03:54.53,Default,,0,0,0,,Бұл ақылды бала.
Dialogue: 0,0:03:57.83,0:04:00.20,Default,,0,0,0,,Қате болмаңыз, бұл Жираф.
Dialogue: 0,0:04:00.50,0:04:01.26,Default,,0,0,0,,Гү…!! Уф!! Уф…!!
Dialogue: 0,0:04:01.76,0:04:02.76,Default,,0,0,0,,Мен оң жақтанмын
Dialogue: 0,0:04:03.20,0:04:04.43,Default,,0,0,0,,Сіз сол жақтасыз
Dialogue: 0,0:04:05.06,0:04:06.26,Default,,0,0,0,,Семіз адам бар, жолын кеседі.
Dialogue: 0,0:04:06.40,0:04:07.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.10,0:04:09.86,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:04:10.03,0:04:11.16,Default,,0,0,0,,Бұл майлы
Dialogue: 0,0:04:11.83,0:04:13.03,Default,,0,0,0,,Бұл сіздің юрисдикцияңыз.
Dialogue: 0,0:04:13.16,0:04:14.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.73,0:04:16.96,Default,,0,0,0,,Майлы
Dialogue: 0,0:04:17.60,0:04:19.90,Default,,0,0,0,,Майлы өзен Біраз уақыт өтті.
Dialogue: 0,0:04:20.10,0:04:23.63,Default,,0,0,0,,О, не деген, Джет Блэк
Dialogue: 0,0:04:23.80,0:04:26.06,Default,,0,0,0,,Бұл жерде қашан пайда болды?
Dialogue: 0,0:04:26.20,0:04:28.43,Default,,0,0,0,,Сен сондай бейқам адамсың.
Dialogue: 0,0:04:28.86,0:04:30.50,Default,,0,0,0,,Сіз үлкен балық ұстадыңыз ба?
Dialogue: 0,0:04:30.56,0:04:31.90,Default,,0,0,0,,-Хахахаха -Хахахахаха
Dialogue: 0,0:04:33.76,0:04:36.50,Default,,0,0,0,,Сіздің блюз жанкүйері екеніңізді білмедім
Dialogue: 0,0:04:36.70,0:04:38.03,Default,,0,0,0,,Оны ақымақтықпен айт
Dialogue: 0,0:04:38.43,0:04:40.60,Default,,0,0,0,,Мен әкемнің доп сөмкесінде болғаннан бері
Dialogue: 0,0:04:40.66,0:04:42.50,Default,,0,0,0,,Мен блюз жайлымын
Dialogue: 0,0:04:42.56,0:04:43.86,Default,,0,0,0,,-уахахаха -уахахахха
Dialogue: 0,0:05:15.86,0:05:17.20,Default,,0,0,0,,А, иә?
Dialogue: 0,0:05:17.46,0:05:18.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:48.53,0:05:49.03,Default,,0,0,0,,Әй
Dialogue: 0,0:05:58.83,0:06:00.06,Default,,0,0,0,,Оны маған қайтарыңыз.
Dialogue: 0,0:06:02.13,0:06:02.96,Default,,0,0,0,,Зебра
Dialogue: 0,0:06:04.96,0:06:06.40,Default,,0,0,0,,Мұндай жерде шынымен де Хамон мұғалімі бар ма?
Dialogue: 0,0:06:13.63,0:06:14.56,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,0:06:27.46,0:06:28.73,Default,,0,0,0,,Иә
Dialogue: 0,0:06:29.53,0:06:30.10,Default,,0,0,0,,Га
Dialogue: 0,0:06:40.60,0:06:41.80,Default,,0,0,0,,Ей, өлме.
Dialogue: 0,0:06:42.16,0:06:42.66,Default,,0,0,0,,Эй
Dialogue: 0,0:06:43.30,0:06:46.16,Default,,0,0,0,,Ұтыстарыңызды бөлуді жоспарлап отырсыз ба?
Dialogue: 0,0:06:46.70,0:06:50.96,Default,,0,0,0,,Оның сыртқы түріне алданып қалмаңыз.
Dialogue: 0,0:06:51.10,0:06:52.90,Default,,0,0,0,,Ақымақ, сөйлеме.
Dialogue: 0,0:06:53.63,0:06:56.60,Default,,0,0,0,,​​Оған көмектесіңізші.
Dialogue: 0,0:06:57.53,0:06:58.60,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:07:01.30,0:07:02.76,Default,,0,0,0,,Бұл тас...
Dialogue: 0,0:07:08.70,0:07:09.20,Default,,0,0,0,,Га
Dialogue: 0,0:07:09.33,0:07:09.83,Default,,0,0,0,,Эй
Dialogue: 0,0:07:35.10,0:07:38.63,Default,,0,0,0,,Мен оны талдауға тырыспайынша білмеймін.
Dialogue: 0,0:07:38.83,0:07:41.00,Default,,0,0,0,,Бұл көп нәрсеге тұрарлық болуы мүмкін
Dialogue: 0,0:07:41.60,0:07:43.16,Default,,0,0,0,,Сонымен, біз не істейміз?
Dialogue: 0,0:07:43.50,0:07:44.56,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:07:45.20,0:07:47.73,Default,,0,0,0,,Рұқсатсыз тапсырып, рұқсатсыз өлді.
Dialogue: 0,0:07:48.33,0:07:50.00,Default,,0,0,0,,Мен оны алсам, сіз қарсы емессіз, солай ма?
Dialogue: 0,0:07:50.06,0:07:51.53,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:07:52.26,0:07:54.63,Default,,0,0,0,,Бала: Көмек беруге міндетті емес, солай ма?
Dialogue: 0,0:07:54.70,0:07:55.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:56.16,0:07:58.23,Default,,0,0,0,,Бұл біздің тамақ ақшамыз.
Dialogue: 0,0:07:58.66,0:07:59.83,Default,,0,0,0,,Сізге ештеңе жоқ
Dialogue: 0,0:08:00.63,0:08:02.50,Default,,0,0,0,,Рухы кедей адам.
Dialogue: 0,0:08:02.73,0:08:04.80,Default,,0,0,0,,Мен ондай емеспін.
Dialogue: 0,0:08:05.16,0:08:06.50,Default,,0,0,0,,Хой күні
Dialogue: 0,0:08:06.63,0:08:08.43,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:08:10.70,0:08:12.00,Default,,0,0,0,,Билл
Dialogue: 0,0:08:12.30,0:08:13.56,Default,,0,0,0,,Вексель дегеніміз не?
Dialogue: 0,0:08:13.76,0:08:16.90,Default,,0,0,0,,Кемеге қанша шығын жұмсадыңыз?
Dialogue: 0,0:08:17.16,0:08:18.66,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:19.06,0:08:20.70,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:08:22.63,0:08:25.06,Default,,0,0,0,,Неліктен өлі сый басын іздеу керек?
Dialogue: 0,0:08:25.10,0:08:27.13,Default,,0,0,0,,Жоқ, жақсы
Dialogue: 0,0:08:27.33,0:08:30.46,Default,,0,0,0,,Ей, сен де Жирафты көздедің ғой, солай ма?
Dialogue: 0,0:08:31.46,0:08:32.96,Default,,0,0,0,,Бұл дәмді әңгіме ме?
Dialogue: 0,0:08:33.83,0:08:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:34.96,0:08:35.73,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,0:08:36.03,0:08:37.26,Default,,0,0,0,,Ал, жеп қой.
Dialogue: 0,0:08:37.46,0:08:38.46,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:08:38.96,0:08:40.60,Default,,0,0,0,,Жүлде ақшасы бәрібір тең.
Dialogue: 0,0:08:41.03,0:08:43.26,Default,,0,0,0,,Дұрыс, бұл сізге жақсылық әкелмейді.
Dialogue: 0,0:08:43.53,0:08:44.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.40,0:08:46.56,Default,,0,0,0,,Жоқ, жоқ, ештеңе.
Dialogue: 0,0:08:47.06,0:08:47.90,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:08:48.13,0:08:49.90,Default,,0,0,0,,Мен оны бүгін саған сақтаймын.
Dialogue: 0,0:08:50.46,0:08:53.96,Default,,0,0,0,,Қараңызшы, өткен күні блюз арфасында ойнайтын бала болды.
Dialogue: 0,0:08:54.70,0:08:57.46,Default,,0,0,0,,Жираф Вэннің әкесін нысанаға алған.
Dialogue: 0,0:08:57.66,0:08:59.00,Default,,0,0,0,,Жолдас Зебра
Dialogue: 0,0:08:59.30,0:09:00.40,Default,,0,0,0,,Жолдас?
Dialogue: 0,0:09:00.73,0:09:02.16,Default,,0,0,0,,Сен мұны білмейсің бе?
Dialogue: 0,0:09:02.76,0:09:04.30,Default,,0,0,0,,10 жыл бұрын
Dialogue: 0,0:09:04.36,0:09:08.06,Default,,0,0,0,,Ол сондай-ақ ұлттық қорғаныс ерікті күштерінің басшысы қызметін атқарды.
Dialogue: 0,0:09:10.10,0:09:14.20,Default,,0,0,0,,Неліктен ескі досты нысанаға алады?
Dialogue: 0,0:09:16.50,0:09:17.73,Default,,0,0,0,,10 жыл бұрын
Dialogue: 0,0:09:17.86,0:09:19.13,Default,,0,0,0,,Зебра мен жираф
Dialogue: 0,0:09:19.16,0:09:22.73,Default,,0,0,0,,Мен белгілі бір нысанның учаскесіне аумақтық құқықтарды сатып, оған отырдым.
Dialogue: 0,0:09:23.56,0:09:24.93,Default,,0,0,0,,Бірақ бірнеше күннен кейін
Dialogue: 0,0:09:25.06,0:09:26.46,Default,,0,0,0,,Зебра жоқ
Dialogue: 0,0:09:26.86,0:09:28.43,Default,,0,0,0,,Жирафтың көзі байланған.
Dialogue: 0,0:09:28.63,0:09:31.93,Default,,0,0,0,,Мен бұрын көрмеген шалғай аймақта тасталған.
Dialogue: 0,0:09:35.00,0:09:36.36,Default,,0,0,0,,Жираф оны реттеді.
Dialogue: 0,0:09:36.43,0:09:38.93,Default,,0,0,0,,Бұл шың үшін жарыста сатқындық болса керек.
Dialogue: 0,0:09:39.83,0:09:43.43,Default,,0,0,0,,Бірақ зебра тірі болды.
Dialogue: 0,0:09:54.30,0:09:55.46,Default,,0,0,0,,Соңында Жираф
Dialogue: 0,0:09:55.56,0:09:58.30,Default,,0,0,0,,Бұл менің жеңіліске ұшырағаным ғана емес.
Dialogue: 0,0:09:58.56,0:10:00.50,Default,,0,0,0,,Әйелдер тез сатқындық жасайды, бірақ
Dialogue: 0,0:10:00.96,0:10:02.73,Default,,0,0,0,,Адам парызбен өмір сүреді.
Dialogue: 0,0:10:03.40,0:10:04.20,Default,,0,0,0,,Міндет
Dialogue: 0,0:10:04.96,0:10:07.10,Default,,0,0,0,,Мен бұған сенгім келеді.
Dialogue: 0,0:10:35.76,0:10:37.43,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:39.43,0:10:40.63,Default,,0,0,0,,Күдікті
Dialogue: 0,0:10:41.83,0:10:42.86,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:10:43.40,0:10:45.26,Default,,0,0,0,,Жираф менен мұны істеуді өтінді.
Dialogue: 0,0:10:45.33,0:10:47.50,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:10:51.10,0:10:53.50,Default,,0,0,0,,Бірақ Жирафты зебра атқан.
Dialogue: 0,0:10:53.66,0:10:54.63,Default,,0,0,0,,О
Dialogue: 0,0:10:56.40,0:10:59.73,Default,,0,0,0,,Неліктен Жираф сізден балаға көмектесуіңізді сұрады?
Dialogue: 0,0:11:00.40,0:11:01.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:01.26,0:11:02.80,Default,,0,0,0,,Бұл бала осы уақытқа дейін келді
Dialogue: 0,0:11:03.43,0:11:05.20,Default,,0,0,0,,Ол өте атақты бала, солай емес пе?
Dialogue: 0,0:11:05.26,0:11:08.13,Default,,0,0,0,,О, бұл данышпандық.
Dialogue: 0,0:11:09.33,0:11:09.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.43,0:11:13.56,Default,,0,0,0,,Эй, бұл жігіт зебра емес.
Dialogue: 0,0:11:13.93,0:11:14.76,Default,,0,0,0,,Не?
Dialogue: 0,0:11:15.16,0:11:17.13,Default,,0,0,0,,Бұл күнді қараңыз
Dialogue: 0,0:11:17.90,0:11:18.96,Default,,0,0,0,,Қорқып қалмаңдар
Dialogue: 0,0:11:19.36,0:11:21.43,Default,,0,0,0,,Неліктен бұл мақала 30 жыл болды?
Dialogue: 0,0:11:21.56,0:11:23.30,Default,,0,0,0,,Олардың бетінде бірдей бет бар.
Dialogue: 0,0:11:24.66,0:11:26.73,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:11:27.76,0:11:28.53,Default,,0,0,0,,Мына жаққа кел
Dialogue: 0,0:11:29.46,0:11:30.03,Default,,0,0,0,,Уф
Dialogue: 0,0:11:31.90,0:11:33.46,Default,,0,0,0,,Үніңді жап, балам.
Dialogue: 0,0:11:33.53,0:11:34.16,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:11:35.40,0:11:37.80,Default,,0,0,0,,Басыңды қажетсіз жерлерге тығып алсаң
Dialogue: 0,0:11:38.06,0:11:39.66,Default,,0,0,0,,Сіз күйіп кетесіз
Dialogue: 0,0:11:41.03,0:11:43.10,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:43.20,0:11:44.70,Default,,0,0,0,,Маған ештеңе айтпа, балам.
Dialogue: 0,0:11:45.40,0:11:46.66,Default,,0,0,0,,Мен бала емеспін
Dialogue: 0,0:11:47.33,0:11:48.63,Default,,0,0,0,,Бала осылай дейді.
Dialogue: 0,0:11:50.46,0:11:51.90,Default,,0,0,0,,Тіптен осылай көрінсе де, мен
Dialogue: 0,0:11:52.23,0:11:53.63,Default,,0,0,0,,Адамдар жер бетінде жүреді
Dialogue: 0,0:11:53.73,0:11:56.26,Default,,0,0,0,,Содан бері менің қолымнан бәрі ойнау болды.
Dialogue: 0,0:11:56.43,0:11:57.60,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:13:44.06,0:13:48.46,Default,,0,0,0,,Фазалар айырмашылығының ғарыш қақпасында жарылыс апаты болған кезден бастап.
Dialogue: 0,0:13:49.23,0:13:52.13,Default,,0,0,0,,Менің денем қартаюды тоқтатты.
Dialogue: 0,0:13:53.56,0:13:54.90,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:13:55.86,0:13:58.66,Default,,0,0,0,,Мені ермек үшін зерттегендер
Dialogue: 0,0:13:58.73,0:14:00.20,Default,,0,0,0,,Алдымен қайтыс болды
Dialogue: 0,0:14:01.13,0:14:02.43,Default,,0,0,0,,Зертханаға жасырын кірген адам
Dialogue: 0,0:14:02.50,0:14:03.93,Default,,0,0,0,,Бұл жігіттің жолы таусылып барады
Dialogue: 0,0:14:04.46,0:14:05.23,Default,,0,0,0,,Маған
Dialogue: 0,0:14:06.13,0:14:08.96,Default,,0,0,0,,Маған жасырынатын ата-ана керек еді.
Dialogue: 0,0:14:10.13,0:14:14.66,Default,,0,0,0,,Оның сыртқы түріне алданып қалмаңыз.
Dialogue: 0,0:14:15.86,0:14:18.93,Default,,0,0,0,,Оған көмектесіңізші.
Dialogue: 0,0:14:20.03,0:14:21.43,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:14:25.26,0:14:27.53,Default,,0,0,0,,Менің ойымша, бұл үшінші адам.
Dialogue: 0,0:14:28.70,0:14:30.06,Default,,0,0,0,,Маған сақинаны беріңіз
Dialogue: 0,0:14:30.76,0:14:32.86,Default,,0,0,0,,Қоңырау? Не айтқың келеді?
Dialogue: 0,0:14:33.63,0:14:34.13,Default,,0,0,0,,Уф
Dialogue: 0,0:14:34.63,0:14:35.13,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:35.13,0:14:36.06,Default,,0,0,0,,Дегенмен, Титан аумағына әрбір шығу
Dialogue: 0,0:14:37.20,0:14:40.23,Default,,0,0,0,,Сізде бар болса да, бұл шошқаға арналған інжу-маржан.
Dialogue: 0,0:14:41.13,0:14:41.76,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:15:19.60,0:15:20.10,Default,,0,0,0,,Ах
Dialogue: 0,0:15:26.33,0:15:27.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:30.96,0:15:32.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:53.06,0:15:56.20,Default,,0,0,0,,Өтінемін, маған үзіліс беріңіз, сіз өте ақымақсыз.
Dialogue: 0,0:15:56.96,0:15:59.56,Default,,0,0,0,,Мен мұның осылай болғанына қуаныштымын.
Dialogue: 0,0:15:59.93,0:16:02.26,Default,,0,0,0,,Менде жерлеуге төлейтін ақша жоқ.
Dialogue: 0,0:16:03.36,0:16:03.96,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:16:04.20,0:16:04.93,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:05.93,0:16:07.06,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:08.20,0:16:09.56,Default,,0,0,0,,Ван Ван Ван Ван
Dialogue: 0,0:16:09.80,0:16:11.03,Default,,0,0,0,,Бұл тітіркендіргіш, Айн
Dialogue: 0,0:16:11.36,0:16:12.50,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:16:12.96,0:16:14.66,Default,,0,0,0,,Кюу Куу
Dialogue: 0,0:16:17.20,0:16:17.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:26.80,0:16:28.96,Default,,0,0,0,,Джет Alpha Catch
Dialogue: 0,0:16:36.76,0:16:39.20,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:40.56,0:16:41.43,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:16:42.00,0:16:44.40,Default,,0,0,0,,Енді не қарап тұрсыз?
Dialogue: 0,0:16:48.76,0:16:49.40,Default,,0,0,0,,Бұл қонақүй.
Dialogue: 0,0:16:50.33,0:16:52.86,Default,,0,0,0,,Жирафтың қашан өлгені есіңізде болса керек.
Dialogue: 0,0:16:53.76,0:16:54.73,Default,,0,0,0,,Оны маған қайтарыңыз.
Dialogue: 0,0:16:55.03,0:16:57.30,Default,,0,0,0,,Зебра осында келеді
Dialogue: 0,0:16:57.73,0:17:00.43,Default,,0,0,0,,Қарғыс атқыр, содан кейін не болды?
Dialogue: 0,0:17:00.70,0:17:02.30,Default,,0,0,0,,Жираф не деді?
Dialogue: 0,0:17:05.33,0:17:06.20,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:06.86,0:17:08.16,Default,,0,0,0,,Мен сізге мұны істей аламын
Dialogue: 0,0:17:08.76,0:17:11.30,Default,,0,0,0,,Бұл сіздің уақытыңызды кері қайтаратын тас.
Dialogue: 0,0:17:13.96,0:17:15.16,Default,,0,0,0,,Маған зебраны беріңіз.
Dialogue: 0,0:17:17.16,0:17:17.80,Default,,0,0,0,,Зебра
Dialogue: 0,0:17:31.83,0:17:46.23,Default,,0,0,0,,(көк арфа үні)
Dialogue: 0,0:17:46.36,0:17:49.46,Default,,0,0,0,,Қақпа жарылған кезде сол сақинада тас бар еді.
Dialogue: 0,0:17:49.80,0:17:52.40,Default,,0,0,0,,Фазалар айырымы кеңістігінің бұралуынан туындаған
Dialogue: 0,0:17:52.66,0:17:54.53,Default,,0,0,0,,Елестетілген өлшемдік кеңістікпен
Dialogue: 0,0:17:54.96,0:17:57.53,Default,,0,0,0,,Энергияның үлкен көлемі тұзаққа түседі.
Dialogue: 0,0:17:59.00,0:18:01.06,Default,,0,0,0,,Және сол энергия
Dialogue: 0,0:18:01.33,0:18:03.56,Default,,0,0,0,,Вэннің циркадиялық ырғағын бұзды.
Dialogue: 0,0:18:04.43,0:18:05.86,Default,,0,0,0,,Оның эпифизі
Dialogue: 0,0:18:06.06,0:18:07.33,Default,,0,0,0,,Қартаюды басу
Dialogue: 0,0:18:07.36,0:18:10.20,Default,,0,0,0,,Мелатонинге ұқсас заттарды өндіруді жалғастырады
Dialogue: 0,0:18:11.10,0:18:14.76,Default,,0,0,0,,Дөрекі түрде айтқанда, гипотеза мынау.
Dialogue: 0,0:18:15.33,0:18:16.26,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:18:16.63,0:18:17.53,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:18:17.96,0:18:19.60,Default,,0,0,0,,Эй, мен де.
Dialogue: 0,0:18:20.03,0:18:23.50,Default,,0,0,0,,Қысқасы, сол тасты Вэньге лақтырсаңыз болғаны.
Dialogue: 0,0:18:23.60,0:18:25.96,Default,,0,0,0,,Бұған сенімді болу мүмкін емес.
Dialogue: 0,0:18:30.33,0:18:32.30,Default,,0,0,0,,Не болатынын ешқашан білмейсіз.
Dialogue: 0,0:18:32.43,0:18:34.76,Default,,0,0,0,,Кейде сіз оны түсірген бойда ол шуға айналады.
Dialogue: 0,0:18:35.70,0:18:36.90,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:18:46.90,0:18:47.43,Default,,0,0,0,,Не?
Dialogue: 0,0:18:48.20,0:18:52.10,Default,,0,0,0,,Бұл сізді соңғы рет көруім болуы мүмкін, сондықтан мен бір қарап көрейін деп ойладым.
Dialogue: 0,0:18:52.83,0:18:54.96,Default,,0,0,0,,Эй, сен ақырында шығасың ба?
Dialogue: 0,0:18:55.06,0:18:56.76,Default,,0,0,0,,Сіз қайтып келмейсіз.
Dialogue: 0,0:19:06.33,0:19:07.43,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:08.56,0:19:09.50,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:19:19.06,0:19:20.70,Default,,0,0,0,,Ер адамдар ақымақ
Dialogue: 0,0:20:57.86,0:20:58.36,Default,,0,0,0,,Ах
Dialogue: 0,0:21:28.66,0:21:31.50,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:21:32.76,0:21:36.13,Default,,0,0,0,,Уф… бұл өте жаман.
Dialogue: 0,0:21:36.90,0:21:37.90,Default,,0,0,0,,Ах
Dialogue: 0,0:21:39.03,0:21:44.03,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:21:44.10,0:21:48.23,Default,,0,0,0,,Түсіндім, мен де осыдан өле аламын ба?
Dialogue: 0,0:21:48.60,0:21:52.43,Default,,0,0,0,,Менің денем ауыр
Dialogue: 0,0:21:52.83,0:21:59.13,Default,,0,0,0,,Ах, бірақ бұл оңайырақ.
Dialogue: 0,0:21:59.20,0:22:00.40,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:22:03.16,0:22:07.13,Default,,0,0,0,,Түсінесіз бе? Саған
Dialogue: 0,0:22:22.70,0:22:23.63,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:22:36.96,0:22:37.60,Default,,0,0,0,,Баан
Dialogue: 0,0:22:52.63,0:22:57.70,Default,,0,0,0,,Мен сені сүйдім деп күйіну
Dialogue: 0,0:22:58.23,0:23:02.76,Default,,0,0,0,,Тым көп уақыт өтті
Dialogue: 0,0:23:04.56,0:23:09.70,Default,,0,0,0,,Менің жүрегім әлі де жаралы
Dialogue: 0,0:23:10.23,0:23:14.43,Default,,0,0,0,,Емсіз жел соғып тұр
Dialogue: 0,0:23:16.90,0:23:24.90,Default,,0,0,0,,Біреу құрғақ көзімен жыласын
Dialogue: 0,0:23:27.66,0:23:30.76,Default,,0,0,0,,НАҒЫЗ ХАЛЫҚТЫҚ КӨКТЕР
Dialogue: 0,0:23:31.23,0:23:39.23,Default,,0,0,0,,Мен жай ғана шынайы қайғыны білгім келеді
Dialogue: 0,0:23:39.63,0:23:51.53,Default,,0,0,0,,Балшық өзеніне батырылған өмір соншалықты жаман емес
Dialogue: 0,0:23:51.73,0:23:59.86,Default,,0,0,0,,Егер ол тек бір рет аяқталса
Dialogue: 0,0:24:25.36,0:24:26.66,Default,,0,0,0,,Ауыр металл туралы білесіз бе?
Dialogue: 0,0:24:26.83,0:24:28.33,Default,,0,0,0,,Не, мен сізді жақсы естімеймін.
Dialogue: 0,0:24:28.50,0:24:30.36,Default,,0,0,0,,Бұл ауыр металл. Ауыр металл.
Dialogue: 0,0:24:30.56,0:24:31.66,Default,,0,0,0,,Не?
Dialogue: 0,0:24:31.73,0:24:34.10,Default,,0,0,0,,Эй, мына шулы шу туралы бірдеңе жасаңыз.
Dialogue: 0,0:24:34.26,0:24:36.26,Default,,0,0,0,,​​Бұл келесі жолы ойнатылатын нәрсе.
Dialogue: 0,0:24:36.36,0:24:37.86,Default,,0,0,0,,Мен сыртқа шығуды тоқтатуым керек деп ойлаймын.
Dialogue: 0,0:24:38.16,0:24:39.63,Default,,0,0,0,,Мен оны мүлдем естімеймін.
Dialogue: 0,0:24:39.73,0:24:42.20,Default,,0,0,0,,Келесі жолы «Heavy Metal Queen»
Dialogue: 0,0:24:42.40,0:24:44.30,Default,,0,0,0,,Сіз дұрыс сөйлесесіз бе?
Dialogue: 0,0:24:45.80,0:24:50.80,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
