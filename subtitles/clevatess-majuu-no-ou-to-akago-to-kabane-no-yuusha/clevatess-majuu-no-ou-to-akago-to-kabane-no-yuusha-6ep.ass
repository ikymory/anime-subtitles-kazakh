Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:05.67,Default,,0,0,0,,Бұл қара су қандай? Нелл.
Dialogue: 0,0:00:05.67,0:00:10.01,Default,,0,0,0,,Кофе мейрамханасы Лорд. Бұл өте қымбат➨
Dialogue: 0,0:00:10.01,0:00:13.01,Default,,0,0,0,,Кейде Броконың күйеуі ішетін.
Dialogue: 0,0:00:13.01,0:00:18.01,Default,,0,0,0,,Олардың барлығы шығыс теңіздің арғы жағындағы Слададан жинауға болатын бұршақтар.
Dialogue: 0,0:00:18.01,0:00:20.02,Default,,0,0,0,,Хмм…. Қант да➨
Dialogue: 0,0:00:20.02,0:00:24.02,Default,,0,0,0,,Мен оған көп норе салдым. Шаршағаныңызды басады деп ойлаймын.
Dialogue: 0,0:00:24.02,0:00:27.36,Default,,0,0,0,,Адамдар біртүрлі нәрселер ойлап табады...
Dialogue: 0,0:00:27.36,0:00:29.36,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:00:29.36,0:00:32.69,Default,,0,0,0,,Тіліңнің терісі де жұқа екенін ұмыттым.
Dialogue: 0,0:00:32.69,0:00:35.36,Default,,0,0,0,,О~ О~. Тоқта, Луна.
Dialogue: 0,0:00:35.36,0:00:38.03,Default,,0,0,0,,Иттің тілі күйдірер.
Dialogue: 0,0:00:38.03,0:00:40.04,Default,,0,0,0,,Ааааааааа.... Токоре➨
Dialogue: 0,0:00:40.04,0:00:43.71,Default,,0,0,0,,Сол қорқынышты адам қайда кетті?
Dialogue: 0,0:00:43.71,0:00:46.04,Default,,0,0,0,,Галт? Сол жігіт болса...
Dialogue: 0,0:00:46.04,0:00:49.34,Default,,0,0,0,,《Галт: Мен сиқырлар мен сиқыршылар туралы есеп беремін》
Dialogue: 0,0:00:52.38,0:00:54.38,Default,,0,0,0,,Соны айтты да, ұшып кетті.
Dialogue: 0,0:00:54.38,0:00:56.72,Default,,0,0,0,,Норесу ұшып кетті ме?
Dialogue: 0,0:00:56.72,0:01:01.66,Default,,0,0,0,,Мен Уну туралы күмәнімді жойдым, сондықтан мен енді қорықпаймын.
Dialogue: 0,0:01:01.66,0:01:03.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:03.66,0:01:07.50,Default,,0,0,0,,Бұл жағымсыз иіс емес.
Dialogue: 0,0:01:07.50,0:01:10.00,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,Таза!
Dialogue: 0,0:01:12.00,0:01:15.34,Default,,0,0,0,,Мен қаладағы саудагерлерден әңгіме естідім.
Dialogue: 0,0:01:15.34,0:01:20.04,Default,,0,0,0,,Мен күткендей, бұл Хайден қазір қорқынышты жағдайда.
Dialogue: 0,0:03:01.98,0:03:05.98,Default,,0,0,0,,Көрші елдің борттық жылдамдығы шекараны бұзып, бізге шабуыл жасады.
Dialogue: 0,0:03:05.98,0:03:08.65,Default,,0,0,0,,Әрине, Хайден де қарсы шығады➨
Dialogue: 0,0:03:08.65,0:03:13.32,Default,,0,0,0,,Король мен астана өз функцияларын жоғалтқан қазіргі жағдайда, оны қандай жағдайда да тоқтату мүмкін емес.
Dialogue: 0,0:03:13.32,0:03:15.32,Default,,0,0,0,,Еслин шекара алдында➨
Dialogue: 0,0:03:15.32,0:03:19.49,Default,,0,0,0,,Менің естуімше, олар ілгерілеуді тоқтатуға тырысты, бірақ мұны істей алмады.
Dialogue: 0,0:03:19.49,0:03:21.50,Default,,0,0,0,,Неліктен Эслин?
Dialogue: 0,0:03:21.50,0:03:26.00,Default,,0,0,0,,Еслин мен Борат ұзақ уақыт бойы бірнеше рет соғысқан.
Dialogue: 0,0:03:26.00,0:03:29.67,Default,,0,0,0,,Еслиннің көзқарасы бойынша ол қазір сиқырдан артта қалды➨
Dialogue: 0,0:03:29.67,0:03:32.67,Default,,0,0,0,,Тіпті Хайден корольдік пешінің де жіберу жылдамдығы бар➨
Dialogue: 0,0:03:32.67,0:03:34.68,Default,,0,0,0,,Менің ойымша, бұл қайтымсыз. Хмм….
Dialogue: 0,0:03:34.68,0:03:39.01,Default,,0,0,0,,Хайденде пеш болса да, қазір патша қайтыс болды➨
Dialogue: 0,0:03:39.01,0:03:42.35,Default,,0,0,0,,Оны жеңе алатын сиқырлы білімі бар адам жоқ.
Dialogue: 0,0:03:42.35,0:03:45.02,Default,,0,0,0,,Сиқыршылар шынымен жоқ.
Dialogue: 0,0:03:45.02,0:03:47.36,Default,,0,0,0,,Неліктен? Король Хайден➨
Dialogue: 0,0:03:47.36,0:03:50.69,Default,,0,0,0,,Себебі ел ішінде сиқырды қолдануға тыйым салынған.
Dialogue: 0,0:03:50.69,0:03:56.03,Default,,0,0,0,,Сиқырдан бейхабар болуың да содан болар.
Dialogue: 0,0:03:56.03,0:03:59.70,Default,,0,0,0,,Батырлар да, өтінемін.
Dialogue: 0,0:03:59.70,0:04:03.31,Default,,0,0,0,,Кофе! ? Мен оған бар жүрегімді салдым.
Dialogue: 0,0:04:03.31,0:04:06.98,Default,,0,0,0,,Не? Сіз Унуды бірінші рет ішіп отырсыз ба? кофе.
Dialogue: 0,0:04:06.98,0:04:09.98,Default,,0,0,0,,Шулы! Ауылдан келген мен үшін➨
Dialogue: 0,0:04:09.98,0:04:12.98,Default,,0,0,0,,Бұл алыс нәрсе.
Dialogue: 0,0:04:12.98,0:04:14.98,Default,,0,0,0,,Ухуху….
Dialogue: 0,0:04:14.98,0:04:17.29,Default,,0,0,0,,Тәтті.
Dialogue: 0,0:04:19.32,0:04:22.99,Default,,0,0,0,,Бұл дәмді, Неру. Ащырақ болар деп ойладым.
Dialogue: 0,0:04:22.99,0:04:25.33,Default,,0,0,0,,Норе тәтті еді.
Dialogue: 0,0:04:25.33,0:04:27.66,Default,,0,0,0,,Ааааааааа! Кел, Луна➨
Dialogue: 0,0:04:27.66,0:04:29.66,Default,,0,0,0,,Тамақтану уақыты келді.
Dialogue: 0,0:04:29.66,0:04:33.34,Default,,0,0,0,,Міне, бұл сіздің жұмысыңызға кедергі келтіреді.
Dialogue: 0,0:04:33.34,0:04:35.67,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:35.67,0:04:39.34,Default,,0,0,0,,Керемет, Нерул өте қамқор➨
Dialogue: 0,0:04:39.34,0:04:43.68,Default,,0,0,0,,Соған қарап өзімді бақытты сезінемін, хаха.
Dialogue: 0,0:04:43.68,0:04:47.68,Default,,0,0,0,,Оның денесінен басқа әйелдік белгілері жоқ ит болса да➨
Dialogue: 0,0:04:47.68,0:04:50.69,Default,,0,0,0,,Мен күткендей, Нерлден бала көтере алмаймын. Боу!
Dialogue: 0,0:04:50.69,0:04:53.36,Default,,0,0,0,,Менің қарап отырғаным бұл емес еді!
Dialogue: 0,0:04:53.36,0:04:56.36,Default,,0,0,0,,Сонымен не? Ах...
Dialogue: 0,0:04:56.36,0:05:00.30,Default,,0,0,0,,Мен біреуді қылышпен алғаш рет күлдіре алдым➨
Dialogue: 0,0:05:00.30,0:05:03.63,Default,,0,0,0,,Ол батыр сияқты бірдеңе жасай алатынына қуанышты екенін айтты➨
Dialogue: 0,0:05:03.63,0:05:06.03,Default,,0,0,0,,Маған бәрін айтуға мәжбүрлеме!
Dialogue: 0,0:05:08.30,0:05:10.31,Default,,0,0,0,,Негізгі тақырыпқа оралу!
Dialogue: 0,0:05:10.31,0:05:12.97,Default,,0,0,0,,Әрі қарай не істеу керек.
Dialogue: 0,0:05:12.97,0:05:15.98,Default,,0,0,0,,Сіз Лунаның патша болғанын айттыңыз➨
Dialogue: 0,0:05:15.98,0:05:19.31,Default,,0,0,0,,Елдің өзі жоқ болып кететін уақыт қана!
Dialogue: 0,0:05:19.31,0:05:22.65,Default,,0,0,0,,Себебі біреу бірінші астанадан айырылды!
Dialogue: 0,0:05:22.65,0:05:25.32,Default,,0,0,0,,Хайден жіберу жылдамдығына жеткенде➨
Dialogue: 0,0:05:25.32,0:05:29.32,Default,,0,0,0,,Менің көзқарасым бойынша ешқандай айырмашылық жоқ. Мәселе неде?
Dialogue: 0,0:05:29.32,0:05:31.66,Default,,0,0,0,,Берілу жылдамдығы басым болған кезде ➨
Dialogue: 0,0:05:31.66,0:05:34.66,Default,,0,0,0,,Луна, Хайден, патша бола алмайды.
Dialogue: 0,0:05:34.66,0:05:37.00,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:05:37.00,0:05:41.67,Default,,0,0,0,,Керісінше, табылса, міндетті түрде тұтқынға түсесің.
Dialogue: 0,0:05:41.67,0:05:44.67,Default,,0,0,0,,Таза қанды Гейден сәбилері аз➨
Dialogue: 0,0:05:44.67,0:05:47.34,Default,,0,0,0,,Сырт келбетіңізден патша қанынан екеніңізді оңай аңғаруға болады.
Dialogue: 0,0:05:47.34,0:05:50.01,Default,,0,0,0,,Хайдендер елі жойылып кетсе➨
Dialogue: 0,0:05:50.01,0:05:53.01,Default,,0,0,0,,Луна адам әлеміндегі орнын жоғалтады.
Dialogue: 0,0:05:53.01,0:05:57.69,Default,,0,0,0,,Гейден корольдік отбасының қанында кенді өңдеудің сиқырлы технологиясының құпиясы сақталған➨
Dialogue: 0,0:05:57.69,0:06:00.96,Default,,0,0,0,,Беріліс жылдамдығы табиғи түрде соған бағытталған.
Dialogue: 0,0:06:00.96,0:06:03.96,Default,,0,0,0,,Ал сол үшін әскерді жылжыта алатын адамдар бар➨
Dialogue: 0,0:06:03.96,0:06:05.96,Default,,0,0,0,,Бір ғана адам бар.
Dialogue: 0,0:06:05.96,0:06:08.63,Default,,0,0,0,,«Айдаһар өлтіруші» Дорелл?
Dialogue: 0,0:06:08.63,0:06:13.30,Default,,0,0,0,,Дұрыс, ол кісі зейнеткерлікке шығып, жасырынып тұрған.➨
Dialogue: 0,0:06:13.30,0:06:17.31,Default,,0,0,0,,Мен оны тауып өлтіру үшін барын салдым...
Dialogue: 0,0:06:17.31,0:06:21.31,Default,,0,0,0,,《Дөрел: Қылышын меңгерген адамды жеңу арқылы...
Dialogue: 0,0:06:21.31,0:06:24.31,Default,,0,0,0,,Қарғыс атқыр... Менің сиқырым аяқталуға жақын➨
Dialogue: 0,0:06:24.31,0:06:28.65,Default,,0,0,0,,Мен көрдім десем де болады, бірақ... әлі де жеткіліксіз.
Dialogue: 0,0:06:28.65,0:06:32.99,Default,,0,0,0,,Мұны растау үшін әкеңізбен ұрыстыңыз ба?
Dialogue: 0,0:06:32.99,0:06:34.99,Default,,0,0,0,,Бұл не деген сұмдық?
Dialogue: 0,0:06:38.33,0:06:40.63,Default,,0,0,0,,Менің атым Дорелл.
Dialogue: 0,0:06:44.33,0:06:48.67,Default,,0,0,0,,Уф…. Ер адамның бұрынғы досы болыңыз➨
Dialogue: 0,0:06:48.67,0:06:52.07,Default,,0,0,0,,Шынайы күшке ұмтылатындар.
Dialogue: 0,0:06:54.01,0:06:56.68,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:56.68,0:06:59.95,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:06:59.95,0:07:03.29,Default,,0,0,0,,Кел, Алисия...
Dialogue: 0,0:07:03.29,0:07:07.29,Default,,0,0,0,,Ол әскери адам және соғыс жүргізуші.
Dialogue: 0,0:07:07.29,0:07:12.29,Default,,0,0,0,,Соғыссаң, соғысқа тартыласың.
Dialogue: 0,0:07:12.29,0:07:16.30,Default,,0,0,0,,Соғыс - ержүректердің жолынан ең алыс...
Dialogue: 0,0:07:16.30,0:07:21.30,Default,,0,0,0,,Соғыс адамдардың әлемін кішірейтеді...
Dialogue: 0,0:07:21.30,0:07:25.31,Default,,0,0,0,,Сондықтан онымен ұрыспаңыз.
Dialogue: 0,0:07:25.31,0:07:28.98,Default,,0,0,0,,Сен батырға айналасың, Алисия.
Dialogue: 0,0:07:28.98,0:07:33.65,Default,,0,0,0,,Әлемнің арғы жағына қараңыз.
Dialogue: 0,0:07:33.65,0:07:37.15,Default,,0,0,0,,А... Әкеңе де бер➨
Dialogue: 0,0:07:37.15,0:07:41.06,Default,,0,0,0,,Көрейін...
Dialogue: 0,0:07:43.99,0:07:46.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.10,0:07:52.00,Default,,0,0,0,,Уау! 》
Dialogue: 0,0:07:54.00,0:07:57.01,Default,,0,0,0,,Егер сіз шынымен Лунаның адам әлемінде өмір сүргенін қаласаңыз➨
Dialogue: 0,0:07:57.01,0:07:59.67,Default,,0,0,0,,Енді Бод жылдамдығы армиясымен күресейік➨
Dialogue: 0,0:07:59.67,0:08:02.94,Default,,0,0,0,,Бұл менің Хайденді қорғауым керек дегенді білдіреді.
Dialogue: 0,0:08:02.94,0:08:04.95,Default,,0,0,0,,О, менің...
Dialogue: 0,0:08:06.95,0:08:08.95,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:08:08.95,0:08:10.95,Default,,0,0,0,,Бір күні құртамын деп шешкенім➨
Dialogue: 0,0:08:10.95,0:08:12.95,Default,,0,0,0,,Мен оны қорғауым керек.
Dialogue: 0,0:08:12.95,0:08:15.62,Default,,0,0,0,,Сен барсаң, мен де барамын...
Dialogue: 0,0:08:15.62,0:08:18.96,Default,,0,0,0,,Уну осында қалып, Луна мен Нерулды қорғайды.
Dialogue: 0,0:08:18.96,0:08:21.30,Default,,0,0,0,,А... неге! ? Мен жын патшасымын➨
Dialogue: 0,0:08:21.30,0:08:25.30,Default,,0,0,0,,Өйткені олар белгілі бір адамдар тобында жұмыс істейтін ретінде танылғысы келмейді.
Dialogue: 0,0:08:25.30,0:08:29.14,Default,,0,0,0,,Оның пайда болуы үшін жақсы себеп болуы керек.
Dialogue: 0,0:08:29.14,0:08:31.31,Default,,0,0,0,,Шебер және Дрел….
Dialogue: 0,0:08:31.31,0:08:34.31,Default,,0,0,0,,Егер сіз жын жыртқыштың баласын жасырын ұрлап жатсаңыз➨
Dialogue: 0,0:08:34.31,0:08:36.98,Default,,0,0,0,,Мен, жын патшасы, оған күмән келтіретін адаммын➨
Dialogue: 0,0:08:36.98,0:08:38.98,Default,,0,0,0,,Өте табиғи.
Dialogue: 0,0:08:38.98,0:08:43.82,Default,,0,0,0,,Біз мұны істеп жатқанда, сиқыршылардың қандай қуат бар екенін көрейік.
Dialogue: 0,0:08:43.82,0:08:47.66,Default,,0,0,0,,Мүмкін ол ата-анасы үшін кек алу сезімін сезінетін шығар➨
Dialogue: 0,0:08:47.66,0:08:50.66,Default,,0,0,0,,Пайда болатын перде жоқ. Қарғыс атқыр...
Dialogue: 0,0:08:50.66,0:08:52.66,Default,,0,0,0,,Және Унуха➨
Dialogue: 0,0:08:52.66,0:08:57.33,Default,,0,0,0,,Сізге Дреллмен төбелеспеңіз деп айтылмады ма?
Dialogue: 0,0:08:57.33,0:08:59.93,Default,,0,0,0,,Бұл менің әкеме берген уәдем...
Dialogue: 0,0:08:59.93,0:09:03.61,Default,,0,0,0,,Соғыс ержүрек жолына қарсы...
Dialogue: 0,0:09:03.61,0:09:06.94,Default,,0,0,0,,...
Dialogue: 0,0:09:06.94,0:09:11.61,Default,,0,0,0,,…
Dialogue: 0,0:09:11.61,0:09:14.62,Default,,0,0,0,,➨
Dialogue: 0,0:09:14.62,0:09:16.62,Default,,0,0,0,,Бұл жақсы емес пе...
Dialogue: 0,0:09:16.62,0:09:21.62,Default,,0,0,0,,...
Dialogue: 0,0:09:21.62,0:09:25.63,Default,,0,0,0,,…
Dialogue: 0,0:09:25.63,0:09:28.63,Default,,0,0,0,,...
Dialogue: 0,0:09:28.63,0:09:33.03,Default,,0,0,0,,Ең алдымен Уну батыр болғысы келді?
Dialogue: 0,0:09:35.30,0:09:40.31,Default,,0,0,0,,…
Dialogue: 0,0:09:40.31,0:09:44.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:44.31,0:09:47.65,Default,,0,0,0,,...
Dialogue: 0,0:09:47.65,0:09:49.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.65,0:09:51.65,Default,,0,0,0,,Мен бірде-бір рет➨
Dialogue: 0,0:09:51.65,0:09:55.32,Default,,0,0,0,,...
Dialogue: 0,0:09:55.32,0:09:57.66,Default,,0,0,0,,Ах... Шығыңыз келсе➨
Dialogue: 0,0:09:57.66,0:10:00.36,Default,,0,0,0,,Мен сені тоқтата алмаймын.
Dialogue: 0,0:10:06.67,0:10:09.67,Default,,0,0,0,,Күте тұрыңыз, Крен!
Dialogue: 0,0:10:09.67,0:10:13.34,Default,,0,0,0,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:10:13.34,0:10:17.51,Default,,0,0,0,,...
Dialogue: 0,0:10:17.51,0:10:21.35,Default,,0,0,0,,…
Dialogue: 0,0:10:21.35,0:10:23.35,Default,,0,0,0,,…
Dialogue: 0,0:10:23.35,0:10:26.05,Default,,0,0,0,,… …
Dialogue: 0,0:10:30.02,0:10:33.03,Default,,0,0,0,,...
Dialogue: 0,0:10:33.03,0:10:36.70,Default,,0,0,0,,Мырза қайда кетті?
Dialogue: 0,0:10:36.70,0:10:39.37,Default,,0,0,0,,Егер ол болса, мен бірден қайтамын.
Dialogue: 0,0:10:39.37,0:10:41.67,Default,,0,0,0,,Тіпті қаламасаңыз да.
Dialogue: 0,0:10:46.04,0:10:48.04,Default,,0,0,0,,Хмф….
Dialogue: 0,0:10:58.05,0:11:03.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:09.66,0:11:16.34,Default,,0,0,0,,♬～
Dialogue: 0,0:11:16.34,0:11:18.34,Default,,0,0,0,,...
Dialogue: 0,0:11:20.68,0:11:22.68,Default,,0,0,0,,Екінші бекініс...
Dialogue: 0,0:11:22.68,0:11:24.68,Default,,0,0,0,,Қарғыс атсын, бұл өте оңай болды...
Dialogue: 0,0:11:24.68,0:11:27.35,Default,,0,0,0,,Не істеу керек? таяқ. Ха!
Dialogue: 0,0:11:27.35,0:11:29.68,Default,,0,0,0,,Мен шекарадан рұқсатсыз өттім➨
Dialogue: 0,0:11:29.68,0:11:32.02,Default,,0,0,0,,...
Dialogue: 0,0:11:32.02,0:11:34.02,Default,,0,0,0,,Күшейткіштер уақытында келмейді!
Dialogue: 0,0:11:34.02,0:11:36.02,Default,,0,0,0,,Мұны істеуден басқа амалымыз жоқ, Микель!
Dialogue: 0,0:11:36.02,0:11:38.69,Default,,0,0,0,,Алда түбі таяз кең өзен.
Dialogue: 0,0:11:38.69,0:11:40.70,Default,,0,0,0,,Сол жерде тоқтаңыз!
Dialogue: 0,0:11:44.70,0:11:46.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:51.54,0:11:54.04,Default,,0,0,0,,Сіз ұйықтап қалдыңыз. Бұл дұрыс.
Dialogue: 0,0:11:54.04,0:11:56.04,Default,,0,0,0,,《Ауырып тұр! Ол аурады!
Dialogue: 0,0:11:56.04,0:11:58.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.05,0:12:02.65,Default,,0,0,0,,…
Dialogue: 0,0:12:02.65,0:12:05.65,Default,,0,0,0,,Ендеше, бір жерден шықтыңыз.
Dialogue: 0,0:12:05.65,0:12:08.66,Default,,0,0,0,,Шилонг ​​- ағаш өңдеушілер үшін қала!
Dialogue: 0,0:12:08.66,0:12:13.66,Default,,0,0,0,,…
Dialogue: 0,0:12:13.66,0:12:17.33,Default,,0,0,0,,Қарғалардың қалдығы...
Dialogue: 0,0:12:17.33,0:12:20.67,Default,,0,0,0,,Уф... «Мен олардан әлі қорқатын шығармын».
Dialogue: 0,0:12:20.67,0:12:22.67,Default,,0,0,0,,Жарайды, Неру.
Dialogue: 0,0:12:22.67,0:12:25.67,Default,,0,0,0,,Енді сені ешкім байқамайды.
Dialogue: 0,0:12:25.67,0:12:29.34,Default,,0,0,0,,Онсыз да жаман... Ах.
Dialogue: 0,0:12:29.34,0:12:33.35,Default,,0,0,0,,Бұл ол! Сол батыр жасырынған жерімізге сегізаяқ жіберіпті...
Dialogue: 0,0:12:33.35,0:12:36.35,Default,,0,0,0,,Иә? Ол көрінбесе...
Dialogue: 0,0:12:36.35,0:12:39.35,Default,,0,0,0,,Қандай батыр! Жай ойнам айттым! Ах...
Dialogue: 0,0:12:39.35,0:12:41.36,Default,,0,0,0,,Ах... Батыр тірі болса, қазір болар еді➨
Dialogue: 0,0:12:41.36,0:12:44.36,Default,,0,0,0,,Бұл ел ондай емес!
Dialogue: 0,0:12:44.36,0:12:46.69,Default,,0,0,0,,Маған бәрібір. Мына жігітті де ағаштан іліп ал!
Dialogue: 0,0:12:46.69,0:12:48.70,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:52.03,0:12:54.54,Default,,0,0,0,,Бүгін бір ғана тоғыз қарға болды...
Dialogue: 0,0:12:54.54,0:12:59.04,Default,,0,0,0,,Эльба білігінде алып сегізаяқтың пайда болғаны рас болуы мүмкін.
Dialogue: 0,0:12:59.04,0:13:03.31,Default,,0,0,0,,Бұл көне түр ме? Бұл елге не болды?
Dialogue: 0,0:13:03.31,0:13:07.32,Default,,0,0,0,,Клебатстың пайда болуы, Баурето маршы туралы.
Dialogue: 0,0:13:07.32,0:13:09.65,Default,,0,0,0,,Мен тек жаман өсек естідім.
Dialogue: 0,0:13:09.65,0:13:13.35,Default,,0,0,0,,Бұл дүниенің ақыры. Хаа….
Dialogue: 0,0:13:15.32,0:13:19.66,Default,,0,0,0,,Қандай жағдай болмасын, біз өз қаламызды өз қолымызбен қорғаймыз.
Dialogue: 0,0:13:19.66,0:13:24.67,Default,,0,0,0,,Қарттан балаға дейін барлық күшті адамдарды қаруландыр!
Dialogue: 0,0:13:24.67,0:13:27.34,Default,,0,0,0,,Осы жолмен! Жүр, кеттік.
Dialogue: 0,0:13:27.34,0:13:30.34,Default,,0,0,0,,Күткендей, шаншып жатыр.
Dialogue: 0,0:13:30.34,0:13:32.67,Default,,0,0,0,,Нерул сенен бір жақсылығым бар.
Dialogue: 0,0:13:32.67,0:13:34.68,Default,,0,0,0,,Құрметті батыр.
Dialogue: 0,0:13:34.68,0:13:37.01,Default,,0,0,0,,Қалада, батыр емес➨
Dialogue: 0,0:13:37.01,0:13:39.01,Default,,0,0,0,,Сіз мені Алисия деп атай аласыз ба?
Dialogue: 0,0:13:39.01,0:13:41.02,Default,,0,0,0,,Сіз оны жек көресіз бе?
Dialogue: 0,0:13:41.02,0:13:43.62,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды әзірге жасырғым келеді.
Dialogue: 0,0:13:49.69,0:13:53.70,Default,,0,0,0,,Иә? бұршақ пастасы? Бұл не, балалар?
Dialogue: 0,0:13:53.70,0:13:56.36,Default,,0,0,0,,Сіз қарақшылардың мүшесісіз бе?
Dialogue: 0,0:13:56.36,0:14:00.64,Default,,0,0,0,,Жоқ, біз... (Қари) Жақсы ұлдар.
Dialogue: 0,0:14:00.64,0:14:02.64,Default,,0,0,0,,Иә... Ана.
Dialogue: 0,0:14:02.64,0:14:05.14,Default,,0,0,0,,Бала оянады.
Dialogue: 0,0:14:05.14,0:14:07.98,Default,,0,0,0,,Иә? Аа….
Dialogue: 0,0:14:07.98,0:14:12.31,Default,,0,0,0,,Бірақ, мама, бұл жігіттің көзінің таңғышы мен қылышы бар.
Dialogue: 0,0:14:12.31,0:14:14.32,Default,,0,0,0,,Иә. Тіпті бір қылышсыз➨
Dialogue: 0,0:14:14.32,0:14:16.98,Default,,0,0,0,,Мына заманда мен далада жүре алмаймын.
Dialogue: 0,0:14:16.98,0:14:20.99,Default,,0,0,0,,Денең үлкен болса да, жүрегің кішкентай, Фил.
Dialogue: 0,0:14:20.99,0:14:22.99,Default,,0,0,0,,Ол әкесіне ұқсайды.
Dialogue: 0,0:14:22.99,0:14:28.00,Default,,0,0,0,,Пит: Тек қобалжыған кезде «Иә» деп айту әдетінен арылу керек.
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0,0,0,,Иә... Кешіріңіз, тұтынушы.
Dialogue: 0,0:14:31.00,0:14:33.33,Default,,0,0,0,,Мен Каримын, мұндағы шебермін.
Dialogue: 0,0:14:33.33,0:14:36.67,Default,,0,0,0,,Бала – таза қанды Гейден.
Dialogue: 0,0:14:36.67,0:14:40.34,Default,,0,0,0,,Ашық қызғылт шаш және үшкір құлақ...
Dialogue: 0,0:14:40.34,0:14:43.34,Default,,0,0,0,,Ауылда таза қанды балалар сирек кездеседі.
Dialogue: 0,0:14:43.34,0:14:46.35,Default,,0,0,0,,Сіз маған жағдайды айтып бере аласыз ба?
Dialogue: 0,0:14:46.35,0:14:51.02,Default,,0,0,0,,Мазмұнына қарай мына екі тентекті арандатуым керек.
Dialogue: 0,0:14:51.02,0:14:53.35,Default,,0,0,0,,Уау…. Біз ➨
Dialogue: 0,0:14:53.35,0:14:56.36,Default,,0,0,0,,Белгілі бір асыл адамға қызмет ететін күзетші.
Dialogue: 0,0:14:56.36,0:14:59.36,Default,,0,0,0,,Қазір мен бұл баланы қорғау үшін жұмыс істеймін.
Dialogue: 0,0:15:01.30,0:15:03.30,Default,,0,0,0,,《Мен өтірік айтпаймын》
Dialogue: 0,0:15:05.30,0:15:07.97,Default,,0,0,0,,Жақсы. Немесе анашым!
Dialogue: 0,0:15:07.97,0:15:11.64,Default,,0,0,0,,Сіздің жұмыс берушіңіз де бәрібір Гидраттан қашып кетті➨
Dialogue: 0,0:15:11.64,0:15:15.31,Default,,0,0,0,,Ол дворян немесе басқасы болуы керек. Мақсатын білмеймін➨
Dialogue: 0,0:15:15.31,0:15:18.65,Default,,0,0,0,,Маған ақша тастай алсаңыз, мен де ризамын.
Dialogue: 0,0:15:18.65,0:15:23.32,Default,,0,0,0,,Сонда сізге алкоголь керек пе? Тамақ?
Dialogue: 0,0:15:23.32,0:15:25.99,Default,,0,0,0,,А... Мен бөлмені жалға алғым келеді.
Dialogue: 0,0:15:25.99,0:15:30.99,Default,,0,0,0,,Балаңыз қауіпсіз ұйықтай алатын төсек және екі адамға арналған тамақ.
Dialogue: 0,0:15:30.99,0:15:35.33,Default,,0,0,0,,Бір түнге екі күміс монета екі күн бойы алдын ала төленеді.
Dialogue: 0,0:15:35.33,0:15:39.00,Default,,0,0,0,,Жарайды. Майдо.
Dialogue: 0,0:15:39.00,0:15:42.34,Default,,0,0,0,,Бөлме баспалдақпен жоғары оң жақта орналасқан.
Dialogue: 0,0:15:42.34,0:15:44.67,Default,,0,0,0,,Рахмет. Айтпақшы, біз➨
Dialogue: 0,0:15:44.67,0:15:48.68,Default,,0,0,0,,Мен бөгде адамдарға сенбеймін. Иә иә.
Dialogue: 0,0:15:48.68,0:15:50.68,Default,,0,0,0,,Сәлем! Кәне!
Dialogue: 0,0:15:50.68,0:15:54.02,Default,,0,0,0,,Ақымақ болма, жүгіңді алып жүр!
Dialogue: 0,0:15:54.02,0:15:56.68,Default,,0,0,0,,Сондықтан балалар, сендер танымал емессіңдер.
Dialogue: 0,0:15:56.68,0:15:59.02,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:15:59.02,0:16:02.62,Default,,0,0,0,,Оны маған қарызға бер. Мен танымал болғым келеді...
Dialogue: 0,0:16:02.62,0:16:04.96,Default,,0,0,0,,Не, аға, қашып құтылмақшысыз ба?
Dialogue: 0,0:16:04.96,0:16:09.30,Default,,0,0,0,,Хун. Сонымен….
Dialogue: 0,0:16:09.30,0:16:11.97,Default,,0,0,0,,Ух... ше? Үлкен аға.
Dialogue: 0,0:16:11.97,0:16:14.30,Default,,0,0,0,,Саған жақсылық, Неру. иә.
Dialogue: 0,0:16:14.30,0:16:17.64,Default,,0,0,0,,Қарамай-ақ көмектесіңіз! О...
Dialogue: 0,0:16:17.64,0:16:19.97,Default,,0,0,0,,Хмм…. Апыр-ай….
Dialogue: 0,0:16:19.97,0:16:22.64,Default,,0,0,0,,А, жер бетінде не болып жатыр?
Dialogue: 0,0:16:22.64,0:16:24.98,Default,,0,0,0,,Бұл өте ауыр...
Dialogue: 0,0:16:24.98,0:16:27.32,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:16:27.32,0:16:31.49,Default,,0,0,0,,Аа, өте жақсы. Төсегі де темірден жасалған және керемет.
Dialogue: 0,0:16:31.49,0:16:35.66,Default,,0,0,0,,Ағаш шеберлерінің қалашығында темір төсек болғаны қызық емес пе?
Dialogue: 0,0:16:35.66,0:16:39.33,Default,,0,0,0,,Ондаған жылдар бұрын, сарайға орындық жасау құрметіне➨
Dialogue: 0,0:16:39.33,0:16:42.00,Default,,0,0,0,,Оны маған патша берді.
Dialogue: 0,0:16:42.00,0:16:45.33,Default,,0,0,0,,Бірақ бұл болды...
Dialogue: 0,0:16:45.33,0:16:50.34,Default,,0,0,0,,Патша өліп, соғыс басталған соң, енді не болар екен...
Dialogue: 0,0:16:50.34,0:16:54.01,Default,,0,0,0,,Кешіріңіз... Неге кешірім сұрағыңыз келеді?
Dialogue: 0,0:16:54.01,0:16:58.35,Default,,0,0,0,,Қалай болғанда да, сабыр етіңіз.
Dialogue: 0,0:16:58.35,0:17:02.28,Default,,0,0,0,,Аа, егер сізге бірдеңе керек болса, маған хабарлаңыз. (есік жабылған дыбыс)
Dialogue: 0,0:17:02.28,0:17:05.95,Default,,0,0,0,,Әзірше Луна-саманы төсекке жатқызғыңыз келе ме?
Dialogue: 0,0:17:05.95,0:17:07.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:14.30,0:17:17.63,Default,,0,0,0,,О, мен оны тауып алған сияқтымын.
Dialogue: 0,0:17:17.63,0:17:21.30,Default,,0,0,0,,Хехе, сүйкімді жәндіктер➨
Dialogue: 0,0:17:21.30,0:17:24.31,Default,,0,0,0,,Мақсат жоғалып кеткен Гейден ханзадасы...
Dialogue: 0,0:17:24.31,0:17:26.31,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:30.98,0:17:34.32,Default,,0,0,0,,《Алисия: Мен бұл жерден де ай тауларын көріп тұрмын...
Dialogue: 0,0:17:34.32,0:17:37.99,Default,,0,0,0,,Клибэтс ұрыс алаңына келді ме? 》
Dialogue: 0,0:17:37.99,0:17:39.99,Default,,0,0,0,,Луна ше?
Dialogue: 0,0:17:39.99,0:17:42.66,Default,,0,0,0,,Бұл жақын арада болады деп ойлаймын.
Dialogue: 0,0:17:42.66,0:17:45.36,Default,,0,0,0,,Қараңдаршы, Алисия. Иә?
Dialogue: 0,0:17:47.33,0:17:50.00,Default,,0,0,0,,Бірінші тіс өсіп келеді.
Dialogue: 0,0:17:50.00,0:17:55.00,Default,,0,0,0,,Бұл рас, бұл кішкентай. Бәрі кішкентай.
Dialogue: 0,0:17:57.34,0:17:59.34,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:17:59.34,0:18:03.28,Default,,0,0,0,,Ой... Төменгі қабатта тамақтанғың келмесе, келіп ал.
Dialogue: 0,0:18:03.28,0:18:06.28,Default,,0,0,0,,Иә. мен барамын.
Dialogue: 0,0:18:06.28,0:18:08.95,Default,,0,0,0,,Лунаның да оянатынына сенімдімін.
Dialogue: 0,0:18:08.95,0:18:12.62,Default,,0,0,0,,Бізде алкоголь жеткіліксіз! Хахахаха!
Dialogue: 0,0:18:12.62,0:18:15.29,Default,,0,0,0,,Кешіріңіз, түнде өте шулы.
Dialogue: 0,0:18:15.29,0:18:19.29,Default,,0,0,0,,Бұл дұрыс емес. Сондықтан мен айттым.
Dialogue: 0,0:18:19.29,0:18:22.96,Default,,0,0,0,,Ол үстелдің артында, сондықтан оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:18:22.96,0:18:25.97,Default,,0,0,0,,Бұл кім? Кари Сол әйел.
Dialogue: 0,0:18:25.97,0:18:29.64,Default,,0,0,0,,Ол сенің қызың емес, Ғаби.
Dialogue: 0,0:18:29.64,0:18:32.31,Default,,0,0,0,,Маған да бала керек, маған араласпа.
Dialogue: 0,0:18:32.31,0:18:36.64,Default,,0,0,0,,Tch, тұтқамен не бар? (күлкі)
Dialogue: 0,0:18:36.64,0:18:41.32,Default,,0,0,0,,Бірақ патшаның өлгені рас па?
Dialogue: 0,0:18:41.32,0:18:45.32,Default,,0,0,0,,А, мен оның жын хайуан патшасын бағындыра алмағанын және оның орнына өлтірілгенін естідім.
Dialogue: 0,0:18:45.32,0:18:47.66,Default,,0,0,0,,Батырлар не істеді?
Dialogue: 0,0:18:47.66,0:18:50.99,Default,,0,0,0,,Батыр атағы жай ғана безендіру.
Dialogue: 0,0:18:50.99,0:18:55.33,Default,,0,0,0,,Олар патшаның асыл қылышын қалағандықтан ғана батыр атанды.
Dialogue: 0,0:18:55.33,0:18:58.67,Default,,0,0,0,,Мен бұл сұмдық адамды алған күні саттым.
Dialogue: 0,0:18:58.67,0:19:01.94,Default,,0,0,0,,Қылыш жасалса да, аңызды ешкім дауламайды.
Dialogue: 0,0:19:01.94,0:19:06.61,Default,,0,0,0,,Сондықтан патша соңғы он бес жылда темірді соғуды тоқтатты.
Dialogue: 0,0:19:06.61,0:19:10.28,Default,,0,0,0,,Соған қарамастан, он үш адам батыр болуды таңдады.
Dialogue: 0,0:19:10.28,0:19:13.61,Default,,0,0,0,,Мен тіпті сарайдың алдында шеру болғанын естідім.
Dialogue: 0,0:19:13.61,0:19:16.62,Default,,0,0,0,,Шынайы ма? Жын патшасын жеңгеніңізге сенімді болыңыз➨
Dialogue: 0,0:19:16.62,0:19:18.62,Default,,0,0,0,,Ол мақтанған болуы керек.
Dialogue: 0,0:19:18.62,0:19:21.62,Default,,0,0,0,,Олардың шеруге шығып, кек алуға да мүмкіндігі жоқ.
Dialogue: 0,0:19:21.62,0:19:24.29,Default,,0,0,0,,Сіз сәтсіз кейіпкерсіз. Патша қайтыс болды ➨
Dialogue: 0,0:19:24.29,0:19:26.96,Default,,0,0,0,,Қамалдың құлауына батырдың кінәсі болды.
Dialogue: 0,0:19:26.96,0:19:29.63,Default,,0,0,0,,Мен сондай-ақ жіберу жылдамдығының жоғарылауына мүмкіндік бердім.
Dialogue: 0,0:19:29.63,0:19:32.30,Default,,0,0,0,,Бәрі арманшыл батыр кінәлі.
Dialogue: 0,0:19:32.30,0:19:34.30,Default,,0,0,0,,Эдсиден тыс көздеу➨
Dialogue: 0,0:19:34.30,0:19:36.97,Default,,0,0,0,,Аяғың жерге тимеген соң солай болады.
Dialogue: 0,0:19:36.97,0:19:39.31,Default,,0,0,0,,Өйткені олар біз сияқты ауыр жұмыс істемейді➨
Dialogue: 0,0:19:39.31,0:19:41.64,Default,,0,0,0,,Мен сондай ақымақ түс көрдім.
Dialogue: 0,0:19:41.64,0:19:45.31,Default,,0,0,0,,《Батырдың қазіргі бағасы осы ма...》
Dialogue: 0,0:19:51.65,0:19:53.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:53.65,0:19:55.99,Default,,0,0,0,,《Жын-шайтанның белгісі! ? 》
Dialogue: 0,0:19:55.99,0:19:58.33,Default,,0,0,0,,А... Иә! ?
Dialogue: 0,0:19:58.33,0:20:00.10,Default,,0,0,0,,Бұл кім? ? Тереземді сындырған адам!
Dialogue: 0,0:20:00.10,0:20:03.66,Default,,0,0,0,,Бұл не? Оған тиме!
Dialogue: 0,0:20:03.66,0:20:07.67,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:20:07.67,0:20:10.34,Default,,0,0,0,,Жәндіктер! ? Мен тілеймін!
Dialogue: 0,0:20:10.34,0:20:12.67,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:20:12.67,0:20:15.34,Default,,0,0,0,,Бұл жай жәндік емес.
Dialogue: 0,0:20:15.34,0:20:17.68,Default,,0,0,0,,Жын-шайтан аңдардың мекенінде өмір сүру➨
Dialogue: 0,0:20:17.68,0:20:21.02,Default,,0,0,0,,Жәндіктер сиқырлы аңдармен тең дәрежеде өмір сүреді.
Dialogue: 0,0:20:21.02,0:20:25.69,Default,,0,0,0,,Демек, бұл таңғажайып жәндік.
Dialogue: 0,0:20:25.69,0:20:28.36,Default,,0,0,0,,Көп қозғалмаған дұрыс.
Dialogue: 0,0:20:28.36,0:20:31.03,Default,,0,0,0,,Бұйырмасам да, нашар ынталандырсаңыз➨
Dialogue: 0,0:20:31.03,0:20:35.03,Default,,0,0,0,,Өздігінен шабуыл жасайды. Ақыр аяғында бұл жәндік.
Dialogue: 0,0:20:35.03,0:20:37.36,Default,,0,0,0,,Жәндіктерді пайдаланатын шебер!
Dialogue: 0,0:20:37.36,0:20:40.03,Default,,0,0,0,,《Мен қылышты бөлмеде қалдырдым》
Dialogue: 0,0:20:40.03,0:20:42.70,Default,,0,0,0,,Әй, қашамын, қашамын!
Dialogue: 0,0:20:42.70,0:20:47.04,Default,,0,0,0,,Ғаби! Мен көп аяқты жәндіктерді ұнатпаймын!
Dialogue: 0,0:20:47.04,0:20:49.04,Default,,0,0,0,,Хи хи... иә?
Dialogue: 0,0:20:49.04,0:20:51.05,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,0:20:51.05,0:20:54.05,Default,,0,0,0,,Жәндіктер жәндіктер жәндіктер...аа аа!
Dialogue: 0,0:20:56.05,0:20:59.05,Default,,0,0,0,,Иә, мен оны айтуды ұмытып кетіппін➨
Dialogue: 0,0:20:59.05,0:21:01.99,Default,,0,0,0,,Сыртта да жәндіктер көп.
Dialogue: 0,0:21:01.99,0:21:04.66,Default,,0,0,0,,Осы уақытта қаланы қоршаңыз ➨
Dialogue: 0,0:21:04.66,0:21:08.33,Default,,0,0,0,,Мен бір тышқанның қашып кетуіне жол бермеуді бұйырдым.
Dialogue: 0,0:21:08.33,0:21:10.33,Default,,0,0,0,,Бұл қандай жәндік? ?
Dialogue: 0,0:21:10.33,0:21:12.33,Default,,0,0,0,,Өлгің келмесе➨
Dialogue: 0,0:21:12.33,0:21:15.00,Default,,0,0,0,,Қашып кетуді ойламаңыз.
Dialogue: 0,0:21:15.00,0:21:18.34,Default,,0,0,0,,Бұл не? Сіздің мақсатыңыз қандай? ?
Dialogue: 0,0:21:18.34,0:21:23.01,Default,,0,0,0,,Бұл өрескел. Сіз әлі есіміңізді жариялаған жоқсыз.
Dialogue: 0,0:21:23.01,0:21:25.01,Default,,0,0,0,,Менің атым Мейнард Свон.
Dialogue: 0,0:21:27.01,0:21:32.35,Default,,0,0,0,,Ол генерал Дрелл басқаратын Борат армиясындағы ең жоғары дәрежелі сиқыршы.
Dialogue: 0,0:21:32.35,0:21:36.02,Default,,0,0,0,,А... жіберу жылдамдығы! ? Қазірдің өзінде осы уақытқа дейін! ?
Dialogue: 0,0:21:36.02,0:21:38.36,Default,,0,0,0,,Ал мақсаты біреу.
Dialogue: 0,0:21:38.36,0:21:40.69,Default,,0,0,0,,Мұндағы Хайден сәбиі➨
Dialogue: 0,0:21:40.69,0:21:43.70,Default,,0,0,0,,Сізде патша қаны бар-жоғын тексеріңіз.
Dialogue: 0,0:21:43.70,0:21:45.70,Default,,0,0,0,,Ах... Кяах!
Dialogue: 0,0:21:45.70,0:21:47.70,Default,,0,0,0,,Әй, Неру!
Dialogue: 0,0:21:47.70,0:21:49.70,Default,,0,0,0,,(Лунаның жылағаны)
Dialogue: 0,0:21:49.70,0:21:53.11,Default,,0,0,0,,Бұл жалықтырады, сондықтан мен алдымен түсіндіремін.
Dialogue: 0,0:21:57.04,0:21:59.65,Default,,0,0,0,,Мен Ней Шифонлицпін.
Dialogue: 0,0:22:01.65,0:22:04.32,Default,,0,0,0,,Борат әскеріндегі жоғары дәрежелі сиқыршы.
Dialogue: 0,0:22:04.32,0:22:08.32,Default,,0,0,0,,Қарғыс атсын... (Луна жылайды)
Dialogue: 0,0:22:09.82,0:22:15.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory