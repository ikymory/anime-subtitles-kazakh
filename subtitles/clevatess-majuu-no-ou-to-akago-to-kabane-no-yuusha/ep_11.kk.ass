Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.17,0:00:16.85,Default,,0,0,0,,(Айқайлау)
Dialogue: 0,0:00:16.85,0:00:19.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:19.18,0:00:21.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:21.35,0:00:24.52,Default,,0,0,0,,Сәлем, Клен! Не деген басы жоқ патша! ?
Dialogue: 0,0:00:24.52,0:00:27.69,Default,,0,0,0,,Лунаны өртеуге бола ма? Не айтқың келеді! ? Эй!
Dialogue: 0,0:00:27.69,0:00:30.69,Default,,0,0,0,,Батыр Алисия!
Dialogue: 0,0:00:30.69,0:00:33.53,Default,,0,0,0,,Батыл Алисия, аман бол!
Dialogue: 0,0:00:33.53,0:00:36.70,Default,,0,0,0,,Мәртебелі! Жалғыз қайттың ба? ?
Dialogue: 0,0:00:36.70,0:00:39.70,Default,,0,0,0,,Түтіннің астында мен қол астындағыларымды жібердім.
Dialogue: 0,0:00:39.70,0:00:42.20,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:00:42.20,0:00:45.87,Default,,0,0,0,,Мен бәріңді Клибэтс өлтірді деп ойладым.
Dialogue: 0,0:00:45.87,0:00:47.88,Default,,0,0,0,,Басқалар келе ме?
Dialogue: 0,0:00:47.88,0:00:50.71,Default,,0,0,0,,Жоқ. Бұл тек мен, Жоғары Мәртебелі.
Dialogue: 0,0:00:50.71,0:00:55.05,Default,,0,0,0,,Қалған батырлардың барлығын Клебатс өлтірді.
Dialogue: 0,0:00:55.05,0:00:58.89,Default,,0,0,0,,Түсінемін... Бірақ сен ғана➨
Dialogue: 0,0:00:58.89,0:01:01.16,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:01:01.16,0:01:03.49,Default,,0,0,0,,Қазіргі Гидраттың әскери күшімен➨
Dialogue: 0,0:01:03.49,0:01:06.50,Default,,0,0,0,,Ақырында біз қаладағы Дореллдің сарбаздарын ұстай алдық.
Dialogue: 0,0:01:06.50,0:01:11.17,Default,,0,0,0,,Сіз қазынаға ие және күшті сиқырды қолданатын Дреллмен бәсекеге түсе алмайсыз.
Dialogue: 0,0:01:11.17,0:01:14.50,Default,,0,0,0,,Бірақ сендей қазынасы бар батыр болса➨
Dialogue: 0,0:01:14.50,0:01:16.51,Default,,0,0,0,,Сіз бұл құбыжықты да ұстай аласыз!
Dialogue: 0,0:01:16.51,0:01:20.01,Default,,0,0,0,,Әрине. Енді басқа достар да бар...
Dialogue: 0,0:01:20.01,0:01:24.01,Default,,0,0,0,,Иә! Бұған дейін мен Мәртебелі Мәртебеліге мынаны айтуым керек!
Dialogue: 0,0:01:24.01,0:01:28.68,Default,,0,0,0,,Луна... жоқ, сіздің ұлыңыз тірі!
Dialogue: 0,0:01:28.68,0:01:30.85,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:01:30.85,0:01:34.69,Default,,0,0,0,,Баланы патша елтаңбасы бейнеленген матаға орап алған.
Dialogue: 0,0:01:34.69,0:01:39.03,Default,,0,0,0,,Таза тұқымды сәби. Сіздің ұлыңыз екеніне сенімдімін...
Dialogue: 0,0:01:39.03,0:01:43.53,Default,,0,0,0,,Менің ұлым… тірі….
Dialogue: 0,0:01:43.53,0:01:46.37,Default,,0,0,0,,Шынында… тірі….
Dialogue: 0,0:01:46.37,0:01:48.70,Default,,0,0,0,,Бұл қайда! ? Менің ұлым қазір қайда?
Dialogue: 0,0:01:48.70,0:01:52.54,Default,,0,0,0,,Кле... Менің серіктерім мені Король сарайына апарып жатыр.
Dialogue: 0,0:01:52.54,0:01:54.54,Default,,0,0,0,,Корольдік пеште! ? Түсіндіру кейінірек келеді.
Dialogue: 0,0:01:54.54,0:01:57.55,Default,,0,0,0,,Дорелл де сол жаққа бара жатыр. Мен де ілесуім керек!
Dialogue: 0,0:01:57.55,0:02:00.48,Default,,0,0,0,,Күте тұрыңыз! Мен де барамын!
Dialogue: 0,0:02:00.48,0:02:02.82,Default,,0,0,0,,Бұл қауіпті, Жоғары Мәртебелі!
Dialogue: 0,0:02:02.82,0:02:05.49,Default,,0,0,0,,Мен сені міндетті түрде қайтарамын, сондықтан қауіпсіз жерде қалуың үшін...
Dialogue: 0,0:02:05.49,0:02:07.49,Default,,0,0,0,,Ешбір жер қауіпсіз емес!
Dialogue: 0,0:02:07.49,0:02:11.16,Default,,0,0,0,,Мен тақ ханшайымы болумен қатар анамын!
Dialogue: 0,0:02:11.16,0:02:13.16,Default,,0,0,0,,Егер бұл менің ұлымды көру болса➨
Dialogue: 0,0:02:13.16,0:02:15.66,Default,,0,0,0,,Қайда өлсем де, артыңыздан еремін!
Dialogue: 0,0:04:17.32,0:04:21.62,Default,,0,0,0,,Осы ет пен қанды пеш иесіне ұсын.
Dialogue: 0,0:04:49.35,0:04:52.35,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:04:54.52,0:04:59.86,Default,,0,0,0,,Біріншіден, немере ұстаудың дұрыс жолы осы ма?
Dialogue: 0,0:04:59.86,0:05:02.30,Default,,0,0,0,,Бұл өте ұқыпсыз көрінеді.
Dialogue: 0,0:05:02.30,0:05:05.47,Default,,0,0,0,,Бұл оның нағыз немересі емес болуы мүмкін бе?
Dialogue: 0,0:05:05.47,0:05:10.31,Default,,0,0,0,,...
Dialogue: 0,0:05:10.31,0:05:12.31,Default,,0,0,0,,Күмәндануға болмайды.
Dialogue: 0,0:05:12.31,0:05:16.65,Default,,0,0,0,,Олай болса мені неге өлтірмексің? Басы жоқ бұрынғы патша.
Dialogue: 0,0:05:16.65,0:05:20.98,Default,,0,0,0,,...
Dialogue: 0,0:05:20.98,0:05:24.82,Default,,0,0,0,,Қалыпты емес. Әрине, бұл дене ➨
Dialogue: 0,0:05:24.82,0:05:28.32,Default,,0,0,0,,Менің қалауым бойынша қозғалмайды.
Dialogue: 0,0:05:28.32,0:05:31.16,Default,,0,0,0,,Барлығы пеш қалағандай.
Dialogue: 0,0:05:31.16,0:05:33.66,Default,,0,0,0,,Қалауыңызша?
Dialogue: 0,0:05:33.66,0:05:37.33,Default,,0,0,0,,➨
Dialogue: 0,0:05:37.33,0:05:40.50,Default,,0,0,0,,Күлден тіріліп, патша болады.
Dialogue: 0,0:05:40.50,0:05:42.84,Default,,0,0,0,,Бұл ежелгі тәжірибе.
Dialogue: 0,0:05:42.84,0:05:49.51,Default,,0,0,0,,Әдетте алдымен ат қою рәсімі болып, пешке шын есімі ойылып жазылатын.
Dialogue: 0,0:05:49.51,0:05:52.85,Default,,0,0,0,,...
Dialogue: 0,0:05:52.85,0:05:58.35,Default,,0,0,0,,Бұл баланың аты ресми түрде Гидериус VI, бірақ➨
Dialogue: 0,0:05:58.35,0:06:01.12,Default,,0,0,0,,Оның шын аты Тот.
Dialogue: 0,0:06:01.12,0:06:05.29,Default,,0,0,0,,Алайда, шын аты пеште ойылып жазылмағандықтан➨
Dialogue: 0,0:06:05.29,0:06:08.96,Default,,0,0,0,,Өз қалауыңыз бойынша пешке секіру мүмкін емес➨
Dialogue: 0,0:06:08.96,0:06:12.97,Default,,0,0,0,,Сондықтан оның орнына бұл дене қозғалды.
Dialogue: 0,0:06:12.97,0:06:15.30,Default,,0,0,0,,Басқаша айтқанда, Қисама да күлге айналды➨
Dialogue: 0,0:06:15.30,0:06:18.81,Default,,0,0,0,,...
Dialogue: 0,0:06:18.81,0:06:22.64,Default,,0,0,0,,...
Dialogue: 0,0:06:22.64,0:06:30.15,Default,,0,0,0,,Менің балам... Бұл баланың әкесі пешке шақырылады деп қорқып, өз-өзіне қол жұмсады.
Dialogue: 0,0:06:30.15,0:06:36.49,Default,,0,0,0,,...
Dialogue: 0,0:06:36.49,0:06:41.66,Default,,0,0,0,,...
Dialogue: 0,0:06:41.66,0:06:48.84,Default,,0,0,0,,Әрбір тіршілік иесінің тағдыры туған кезде шешіледі.
Dialogue: 0,0:06:48.84,0:06:53.01,Default,,0,0,0,,Бұл жер, Эдсиа.
Dialogue: 0,0:06:53.01,0:06:58.01,Default,,0,0,0,,...
Dialogue: 0,0:06:58.01,0:07:04.12,Default,,0,0,0,,…
Dialogue: 0,0:07:04.12,0:07:10.53,Default,,0,0,0,,Ержүрек туралы аңыздың күлінен патшаға дейін.
Dialogue: 0,0:07:15.96,0:07:20.47,Default,,0,0,0,,Мен білемін. Сыртқа сүйреп апару керек нәрсе - пештің мазмұны.
Dialogue: 0,0:07:20.47,0:07:23.81,Default,,0,0,0,,Әлемді құрту...
Dialogue: 0,0:07:23.81,0:07:27.14,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:07:27.14,0:07:30.05,Default,,0,0,0,,Амансың ба? Уф... иә.
Dialogue: 0,0:07:31.98,0:07:33.98,Default,,0,0,0,,Осы жерден мен оны алып жүремін.
Dialogue: 0,0:07:33.98,0:07:37.32,Default,,0,0,0,,Құлап қалмас үшін өзіңізді ұстаңыз. иә.
Dialogue: 0,0:07:37.32,0:07:40.82,Default,,0,0,0,,Пештің бағыты қандай? Ол сол жерде.
Dialogue: 0,0:07:40.82,0:07:42.82,Default,,0,0,0,,Уф... Аа!
Dialogue: 0,0:07:42.82,0:07:44.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:50.50,0:07:54.84,Default,,0,0,0,,➨
Dialogue: 0,0:07:54.84,0:07:58.67,Default,,0,0,0,,...
Dialogue: 0,0:07:58.67,0:08:01.61,Default,,0,0,0,,...
Dialogue: 0,0:08:01.61,0:08:07.62,Default,,0,0,0,,Енді нағыз батырлар жоқ. Қазіргі қаһарманның жын патшаны жеңетін күші жоқ.
Dialogue: 0,0:08:07.62,0:08:13.62,Default,,0,0,0,,Неге ол енді жоқ дейсің? Неге сен оны жеңуге күшің жетпейді деп мәлімдейсің...
Dialogue: 0,0:08:13.62,0:08:17.63,Default,,0,0,0,,Шын мәнінде, мың жылдық тарихта жазылған➨
Dialogue: 0,0:08:17.63,0:08:20.30,Default,,0,0,0,,Оның жеңілгені туралы айтылмаған.
Dialogue: 0,0:08:20.30,0:08:23.47,Default,,0,0,0,,Бұрынғы жазбалар да өте анық емес.
Dialogue: 0,0:08:23.47,0:08:26.47,Default,,0,0,0,,Сонда батыр туралы аңыз қандай?
Dialogue: 0,0:08:26.47,0:08:31.31,Default,,0,0,0,,Төрт жын хайуан патшасын жеңсең, дүние ашылады деуге не негіз бар?
Dialogue: 0,0:08:31.31,0:08:34.81,Default,,0,0,0,,Бұл дәстүрді кім қалдырды?
Dialogue: 0,0:08:34.81,0:08:39.81,Default,,0,0,0,,Шебер бұл сұраққа жауап бермеді.
Dialogue: 0,0:08:39.81,0:08:43.65,Default,,0,0,0,,Ол маған жай ғана суық жымиды...
Dialogue: 0,0:08:43.65,0:08:45.65,Default,,0,0,0,,Мүмкін кейінгі патшалар➨
Dialogue: 0,0:08:45.65,0:08:48.32,Default,,0,0,0,,Шындықты біліп, бірақ жасыру.
Dialogue: 0,0:08:48.32,0:08:50.83,Default,,0,0,0,,Егер бұл орын алса, мен жеңе алмайтынымды білемін➨
Dialogue: 0,0:08:50.83,0:08:53.83,Default,,0,0,0,,Бұл сіздің 13 адамыңызды жіберді деген сөз.
Dialogue: 0,0:08:53.83,0:08:56.50,Default,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:08:56.50,0:08:59.50,Default,,0,0,0,,Тоқтата алмау себебі болса да➨
Dialogue: 0,0:08:59.50,0:09:02.94,Default,,0,0,0,,Біз шындықпен бетпе-бет келіп, түзету керек нәрсені түзетуіміз керек.
Dialogue: 0,0:09:02.94,0:09:08.78,Default,,0,0,0,,Біз тағы да осындай зиян келтіреміз және көптеген қымбат өмірді алып кетеміз ...
Dialogue: 0,0:09:08.78,0:09:12.45,Default,,0,0,0,,Мен ұлымның ондай патша болғанын қаламаймын.
Dialogue: 0,0:09:12.45,0:09:15.45,Default,,0,0,0,,Мен ненің қиын екенін білмеймін.
Dialogue: 0,0:09:15.45,0:09:17.95,Default,,0,0,0,,Бірақ дәстүр қандай болса да➨
Dialogue: 0,0:09:17.95,0:09:20.46,Default,,0,0,0,,Менің ойымша, тапсырманы қабылдаудың мәні болды.
Dialogue: 0,0:09:20.46,0:09:24.63,Default,,0,0,0,,Дәлірек айтсақ, дәстүр болмаса да, мен міндетті түрде сынақты көтердім.
Dialogue: 0,0:09:24.63,0:09:28.80,Default,,0,0,0,,Белгісізді аңсау, күш-қуатқа ұмтылу.
Dialogue: 0,0:09:28.80,0:09:33.80,Default,,0,0,0,,Адамның жақсартуға деген тойымсыз ұмтылысы - бұл ешқашан тоқтауға болмайтын нәрсе➨
Dialogue: 0,0:09:33.80,0:09:36.14,Default,,0,0,0,,Мен олай ойламаймын!
Dialogue: 0,0:09:36.14,0:09:40.31,Default,,0,0,0,,Батырдың анықтамасы не екенін әлі білмеймін.
Dialogue: 0,0:09:40.31,0:09:44.48,Default,,0,0,0,,Тағдырына оң көзқараспен қарайтын адам туралы деп ойлаймын.
Dialogue: 0,0:09:44.48,0:09:48.48,Default,,0,0,0,,Негізі адам ма, жануар ма, маған бәрібір➨
Dialogue: 0,0:09:48.48,0:09:53.82,Default,,0,0,0,,Менің ойымша, мұндай көрініс біреу сізді батыр деп атайды.
Dialogue: 0,0:09:53.82,0:09:56.83,Default,,0,0,0,,Тіпті бұл мағынада Дрелл батыр емес.
Dialogue: 0,0:09:56.83,0:10:00.66,Default,,0,0,0,,Сіз тек үмітсіздіктен қазіргі шындықты жоюға тырысасыз.
Dialogue: 0,0:10:00.66,0:10:03.33,Default,,0,0,0,,Ол менің әкемнің жауы➨
Dialogue: 0,0:10:03.33,0:10:06.67,Default,,0,0,0,,Оған дейін батыр ретінде жауды жеңу керек.
Dialogue: 0,0:10:06.67,0:10:09.00,Default,,0,0,0,,Мен қазір солай ойлаймын.
Dialogue: 0,0:10:09.00,0:10:11.67,Default,,0,0,0,,Сен шынымен мықтысың, Алисия.
Dialogue: 0,0:10:11.67,0:10:17.01,Default,,0,0,0,,Мен әлсізмін. Дореллден және, әрине, жын-шайтан патшасынан да көп.
Dialogue: 0,0:10:17.01,0:10:20.52,Default,,0,0,0,,Бірақ бұл енді батыр болуым керек дегенді білдірмейді➨
Dialogue: 0,0:10:20.52,0:10:22.52,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:10:24.85,0:10:27.52,Default,,0,0,0,,Негізі аздап бас тарттым➨
Dialogue: 0,0:10:27.52,0:10:30.02,Default,,0,0,0,,Мен мұны істеуге рұқсат етпейтін адамды кездестірдім.
Dialogue: 0,0:10:30.02,0:10:32.69,Default,,0,0,0,,Жақсы. Бұл қандай адам?
Dialogue: 0,0:10:32.69,0:10:38.03,Default,,0,0,0,,Қарапайым тілмен айтсақ, ол сіз кездестіргіңіз келмейтін адам.
Dialogue: 0,0:10:38.03,0:10:45.87,Default,,0,0,0,,Енді сәби күлге айналды. Сонда не болады? Басы жоқ патша.
Dialogue: 0,0:10:45.87,0:10:50.04,Default,,0,0,0,,Күлден шыққан жоқ па?
Dialogue: 0,0:10:50.04,0:10:55.72,Default,,0,0,0,,Бұл не? Бұл шын болуы керек пе?
Dialogue: 0,0:10:55.72,0:10:58.72,Default,,0,0,0,,Көлеңкеден патша туа ма?
Dialogue: 0,0:10:58.72,0:11:03.66,Default,,0,0,0,,Сіз менің қолымнан ұстаған сәтте қолыңызды ауыстырдыңыз деп айтасыз ба?
Dialogue: 0,0:11:03.66,0:11:07.16,Default,,0,0,0,,Кисама мына жігіттің орнына өзің секірме➨ деді
Dialogue: 0,0:11:07.16,0:11:09.16,Default,,0,0,0,,Жылжыту.
Dialogue: 0,0:11:09.16,0:11:13.00,Default,,0,0,0,,Оған қол жеткізу мүмкін болмаған кезде денеге не болады?
Dialogue: 0,0:11:13.00,0:11:16.50,Default,,0,0,0,,Түсінбейтін жалғыз нәрсе - қуыршақ сияқты әрекет ету.
Dialogue: 0,0:11:16.50,0:11:19.61,Default,,0,0,0,,Оны елестету оңай.
Dialogue: 0,0:11:35.86,0:11:40.19,Default,,0,0,0,,Мм... Күл деген күл.
Dialogue: 0,0:11:40.19,0:11:43.20,Default,,0,0,0,,Оның жарамсыз және өртенгені анықталды ма?
Dialogue: 0,0:11:43.20,0:11:48.20,Default,,0,0,0,,Енді оны келесі кім алып кетуге келеді?
Dialogue: 0,0:11:52.21,0:11:55.88,Default,,0,0,0,,Сіз онымен бірге Лунаны өртеуге ниетіңіз бар ма?
Dialogue: 0,0:11:55.88,0:11:59.55,Default,,0,0,0,,Жарық неғұрлым күшті болса, көлеңке де соғұрлым ерекшеленетінін білмейтін сияқты.
Dialogue: 0,0:11:59.55,0:12:03.85,Default,,0,0,0,,Беріліп, шығыңыз. Пештің иесі.
Dialogue: 0,0:12:15.83,0:12:18.17,Default,,0,0,0,,Пештің үлкен қақпағы жарылып ашылды!
Dialogue: 0,0:12:18.17,0:12:20.17,Default,,0,0,0,,Пеш! ?
Dialogue: 0,0:12:24.01,0:12:30.35,Default,,0,0,0,,Тез, менің сынамды айда.
Dialogue: 0,0:12:30.35,0:12:34.35,Default,,0,0,0,,Дрелл! Ұлым... ұлым!
Dialogue: 0,0:12:34.35,0:12:39.69,Default,,0,0,0,,Төмен қалдырыңыз! Мен барып анықтаймын!
Dialogue: 0,0:12:39.69,0:12:42.02,Default,,0,0,0,,Крен Лунаның өлуіне жол береді деп елестету қиын➨
Dialogue: 0,0:12:42.02,0:12:46.86,Default,,0,0,0,,Солтүстіктің жын патшасының тынысы бар Дреллді жібере алмаймын!
Dialogue: 0,0:12:46.86,0:12:49.86,Default,,0,0,0,,Қарғыс атсын... Уақытында үлгере алмаймын!
Dialogue: 0,0:12:52.53,0:12:54.87,Default,,0,0,0,,Қазір!
Dialogue: 0,0:12:54.87,0:12:56.87,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:12:56.87,0:13:01.81,Default,,0,0,0,,Дрелл! ! Мен оны осы жолы тоқтатамын!
Dialogue: 0,0:13:01.81,0:13:06.31,Default,,0,0,0,,Мұз найзасы!
Dialogue: 0,0:13:06.31,0:13:08.32,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:13:08.32,0:13:10.49,Default,,0,0,0,,Бұл бөлім командирі Ройес!
Dialogue: 0,0:13:10.49,0:13:12.49,Default,,0,0,0,,Қазына!
Dialogue: 0,0:13:12.49,0:13:14.99,Default,,0,0,0,,Мен саған алыстан қарауға рұқсат етемін.
Dialogue: 0,0:13:14.99,0:13:18.29,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Ройес Эслин.
Dialogue: 0,0:13:30.17,0:13:33.57,Default,,0,0,0,,Ха ха ха... қалай! ?
Dialogue: 0,0:13:36.68,0:13:40.01,Default,,0,0,0,,Ха! ? Апыр-ай!
Dialogue: 0,0:13:40.01,0:13:43.85,Default,,0,0,0,,Қанша тырыссаң да мағынасыз.
Dialogue: 0,0:13:43.85,0:13:46.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:55.70,0:13:59.03,Default,,0,0,0,,Көмегің үшін рахмет. Мүмкін сіз батырсыз ба?
Dialogue: 0,0:13:59.03,0:14:02.14,Default,,0,0,0,,Иә. 13 батырдың аман қалғандары.
Dialogue: 0,0:14:02.14,0:14:04.97,Default,,0,0,0,,Түсіндіру қиын, сондықтан алдымен айтайын.
Dialogue: 0,0:14:04.97,0:14:07.98,Default,,0,0,0,,Әрине, мұндай жағдайда емес. Мен Родпын.
Dialogue: 0,0:14:07.98,0:14:09.98,Default,,0,0,0,,Алисия.
Dialogue: 0,0:14:09.98,0:14:12.31,Default,,0,0,0,,Бұл жерде бірге соғысамыз деп айтуға бола ма?
Dialogue: 0,0:14:12.31,0:14:15.98,Default,,0,0,0,,Мүмкін. Әйтпесе, ол жігіт...
Dialogue: 0,0:14:15.98,0:14:17.99,Default,,0,0,0,,Жеңілу мүмкін емес!
Dialogue: 0,0:14:28.33,0:14:31.83,Default,,0,0,0,,Бірлесу… Ең үлкен қазынаға ие адамдар➨
Dialogue: 0,0:14:31.83,0:14:35.34,Default,,0,0,0,,Екі адам болса, біз жеңіске жетуіміз мүмкін.
Dialogue: 0,0:14:35.34,0:14:40.17,Default,,0,0,0,,Расында да, сендер ең дарындылардың бірісіңдер. Бірақ пайдасы жоқ.
Dialogue: 0,0:14:40.17,0:14:44.01,Default,,0,0,0,,Өйткені, бұл қазіргі адам тұқымының ішіндегі иерархия.
Dialogue: 0,0:14:44.01,0:14:47.52,Default,,0,0,0,,Енді сен менің жауым бола алмайсың!
Dialogue: 0,0:14:50.35,0:14:53.19,Default,,0,0,0,,Ах! Тағы екі көз ашылды!
Dialogue: 0,0:14:53.19,0:14:55.52,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:14:55.52,0:14:57.53,Default,,0,0,0,,Иә! ? артта!
Dialogue: 0,0:14:59.53,0:15:02.13,Default,,0,0,0,,Эй. Декудың квиркі бар екен ғой?
Dialogue: 0,0:15:02.13,0:15:05.53,Default,,0,0,0,,Ах... Ах! Уф... уф!
Dialogue: 0,0:15:12.64,0:15:15.81,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:15:15.81,0:15:18.61,Default,,0,0,0,,Уау! Гуаааа!
Dialogue: 0,0:15:21.48,0:15:23.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:23.82,0:15:26.82,Default,,0,0,0,,Уф, гуха, гуа!
Dialogue: 0,0:15:26.82,0:15:28.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:28.82,0:15:30.99,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:15:30.99,0:15:32.99,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:15:37.17,0:15:40.50,Default,,0,0,0,,Уф... Уф... Гуха.
Dialogue: 0,0:15:40.50,0:15:43.00,Default,,0,0,0,,Гехо Гехо!
Dialogue: 0,0:15:43.00,0:15:45.84,Default,,0,0,0,,Хун.
Dialogue: 0,0:15:45.84,0:15:49.51,Default,,0,0,0,,Мұзды шығарыңыз. Ха! ?
Dialogue: 0,0:15:49.51,0:15:52.35,Default,,0,0,0,,Мына үлкен мұзды шығарыңыз!
Dialogue: 0,0:15:52.35,0:15:54.65,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:57.35,0:15:59.65,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:16:03.12,0:16:07.33,Default,,0,0,0,,Мұзды найза!
Dialogue: 0,0:16:09.96,0:16:13.77,Default,,0,0,0,,Қалай ойлайсыңдар, мұндай тамаша техника жұмыс істей ме?
Dialogue: 0,0:16:18.14,0:16:20.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:20.48,0:16:23.48,Default,,0,0,0,,Мұз түрмесі!
Dialogue: 0,0:16:26.48,0:16:30.82,Default,,0,0,0,,Мынау... қазір солай!
Dialogue: 0,0:16:30.82,0:16:33.02,Default,,0,0,0,,Шешіңіз! Батыл адам!
Dialogue: 0,0:16:34.99,0:16:37.99,Default,,0,0,0,,Төңкерілген айдаһар!
Dialogue: 0,0:16:37.99,0:16:42.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:45.83,0:16:48.84,Default,,0,0,0,,Таудан құлау!
Dialogue: 0,0:16:48.84,0:16:52.01,Default,,0,0,0,,Бұл туралы не деуге болады! ? құбыжық!
Dialogue: 0,0:16:52.01,0:16:54.34,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:54.34,0:17:00.65,Default,,0,0,0,,Эксцентристік. Қалың. Бұл қылышшы ойлап табатын әдіс сияқты.
Dialogue: 0,0:17:04.29,0:17:08.79,Default,,0,0,0,,《Ах! ? Бұл жынның қаны ма? Бүкіл дене жын қаны! ? 》
Dialogue: 0,0:17:10.96,0:17:13.46,Default,,0,0,0,,Батыр: Дұрыс! Ах!
Dialogue: 0,0:17:13.46,0:17:15.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.47,0:17:21.64,Default,,0,0,0,,Ах! Батыл адам!
Dialogue: 0,0:17:21.64,0:17:23.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:23.64,0:17:25.84,Default,,0,0,0,,Алисия!
Dialogue: 0,0:17:37.99,0:17:42.49,Default,,0,0,0,,Күш-жігер мен үміт➨
Dialogue: 0,0:17:42.49,0:17:45.79,Default,,0,0,0,,Шындықтың алдында бәрі бос.
Dialogue: 0,0:17:48.00,0:17:51.33,Default,,0,0,0,,Балықтың адамға айналуына жол бермеу➨
Dialogue: 0,0:17:51.33,0:17:59.34,Default,,0,0,0,,Қанша тырыссақ та, нағыз қаһарман бола алмаймыз.
Dialogue: 0,0:17:59.34,0:18:01.28,Default,,0,0,0,,Бұл бірінші орында➨
Dialogue: 0,0:18:01.28,0:18:04.95,Default,,0,0,0,,Қарапайым себебі, ол бір бола алатын түр емес.
Dialogue: 0,0:18:04.95,0:18:12.79,Default,,0,0,0,,Егер сіз тастарды немесе сиқырды пайдалана алмасаңыз, Эдсеяның бес нәсілі төмен нәсілдер.
Dialogue: 0,0:18:12.79,0:18:15.12,Default,,0,0,0,,Төменгі түрлер….
Dialogue: 0,0:18:15.12,0:18:20.29,Default,,0,0,0,,Нағыз адам тұқымы – бір кездері жер бетіндегі барлық нәрселерді билеген нәсіл➨
Dialogue: 0,0:18:20.29,0:18:23.63,Default,,0,0,0,,Олар жоғалып кетті, артында біз бен аңыз ғана қалды!
Dialogue: 0,0:18:23.63,0:18:26.47,Default,,0,0,0,,Олар сені билеуге мәжбүрлеп жатыр!
Dialogue: 0,0:18:26.47,0:18:29.30,Default,,0,0,0,,Адамдар да! Жын-шайтан аңдар да!
Dialogue: 0,0:18:29.30,0:18:31.81,Default,,0,0,0,,Оны аяқтау үшін➨
Dialogue: 0,0:18:31.81,0:18:38.98,Default,,0,0,0,,Батыр туралы аңыздың барлық іздерін жою керек!
Dialogue: 0,0:18:38.98,0:18:40.98,Default,,0,0,0,,♬~
Dialogue: 0,0:18:42.98,0:18:45.82,Default,,0,0,0,,Қарғыс атсын! Сол себепті➨
Dialogue: 0,0:18:45.82,0:18:50.32,Default,,0,0,0,,Қаншама соғыс жасасақ та, қанша тау өлексесін салсақ та➨
Dialogue: 0,0:18:50.32,0:18:54.16,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:18:54.16,0:18:56.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:58.67,0:19:00.60,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:00.60,0:19:06.61,Default,,0,0,0,,Дреллдің мақсаты... Жоқ, менде Вордайнның мақсаты туралы шамалы түсінік бар.
Dialogue: 0,0:19:06.61,0:19:08.61,Default,,0,0,0,,Тіпті өткенді ойласам да, мен➨
Dialogue: 0,0:19:08.61,0:19:11.95,Default,,0,0,0,,Мен оның шынайы болмысын ешқашан көрген емеспін.
Dialogue: 0,0:19:11.95,0:19:17.28,Default,,0,0,0,,Бұл мен Жын хайуан патшасының тағына отырғанға дейін оның жоғалып кеткенін білдіре ме?
Dialogue: 0,0:19:17.28,0:19:21.62,Default,,0,0,0,,оның мың жылдан астам уақыт бұрын жоғалып кеткенін білдіреді.
Dialogue: 0,0:19:21.62,0:19:26.63,Default,,0,0,0,,Зафти, сен мұны біліп, үндемедің.
Dialogue: 0,0:19:26.63,0:19:33.63,Default,,0,0,0,,Сонда да батыр туралы аңыздың ізі дегенге сене алар емеспін.
Dialogue: 0,0:19:37.81,0:19:42.48,Default,,0,0,0,,``Тоа кітабы'' Қандай да бір себептермен мен бұл бөлімді оқи аламын.
Dialogue: 0,0:19:42.48,0:19:46.65,Default,,0,0,0,,Мәңгілік көлеңкедегі нұрды ұрлап, ақыры мен оны көре алдым➨
Dialogue: 0,0:19:46.65,0:19:50.65,Default,,0,0,0,,Олай етпесеңіз, жарық пен жылу көзіңізді зақымдайды.
Dialogue: 0,0:19:50.65,0:19:55.16,Default,,0,0,0,,Ал ол пайда болған бойда пештің өзі ғайып болды.
Dialogue: 0,0:19:55.16,0:19:59.83,Default,,0,0,0,,Бұл пеш шеберінің шынайы тұлғасы екені даусыз.
Dialogue: 0,0:19:59.83,0:20:04.17,Default,,0,0,0,,Тек бір кітап Гейден патшасын өртеп жіберді және оны күлден қайта тұрғызды➨
Dialogue: 0,0:20:04.17,0:20:08.00,Default,,0,0,0,,Бұл оны өзінің әкімшісі етіп қойғанын білдіреді.
Dialogue: 0,0:20:08.00,0:20:13.34,Default,,0,0,0,,Түсіну мүлде қиын. Бұл да сиқырдың бір түрі ме?
Dialogue: 0,0:20:13.34,0:20:18.51,Default,,0,0,0,,Әлисия маған семсерін бұрды ма?
Dialogue: 0,0:20:18.51,0:20:20.85,Default,,0,0,0,,Луна осындай нәрсеге арналған➨
Dialogue: 0,0:20:20.85,0:20:24.35,Default,,0,0,0,,Бір кезде күлге айналу тағдыры болды ма?
Dialogue: 0,0:20:24.35,0:20:27.52,Default,,0,0,0,,Осындай нәрсенің кесірінен мен сарайымнан айырылдым➨
Dialogue: 0,0:20:27.52,0:20:31.69,Default,,0,0,0,,Сіз бүкіл адамзат баласын жоюды ойлайтын деңгейге жеттіңіз бе?
Dialogue: 0,0:20:31.69,0:20:33.69,Default,,0,0,0,,А... иә?
Dialogue: 0,0:20:33.69,0:20:36.70,Default,,0,0,0,,Хехехе…. Апыр-ай.
Dialogue: 0,0:20:36.70,0:20:41.87,Default,,0,0,0,,Ахахахаха! Ахахахахха!
Dialogue: 0,0:20:41.87,0:20:46.54,Default,,0,0,0,,《Мм... Мәнсіз. Бұл мағынасыз сияқты.
Dialogue: 0,0:20:46.54,0:20:51.71,Default,,0,0,0,,Ол өзінен бұрынғы адамның естеліктерін мұрагер етпесе де, ол жын хайуан патшасы мәртебесіне де ие болуы мүмкін➨
Dialogue: 0,0:20:51.71,0:20:54.05,Default,,0,0,0,,Сол жерді қорғау мақсаты➨
Dialogue: 0,0:20:54.05,0:20:58.55,Default,,0,0,0,,Қазірдің өзінде жойылып кеткен түрлердің мағынасыз дәстүрлеріне жауап ретінде.
Dialogue: 0,0:20:58.55,0:21:03.49,Default,,0,0,0,,Туу да, тағдыр да маңызды емес.
Dialogue: 0,0:21:03.49,0:21:08.33,Default,,0,0,0,,Бастау мағынасыз. Әлем сұр
Dialogue: 0,0:21:08.33,0:21:12.17,Default,,0,0,0,,Дүние хаостан туған болса➨
Dialogue: 0,0:21:12.17,0:21:16.34,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:21:16.34,0:21:20.67,Default,,0,0,0,,Бұл сөздерді кім айтты... мен?
Dialogue: 0,0:21:20.67,0:21:24.51,Default,,0,0,0,,Оның жалықтырғанына сенімдімін.
Dialogue: 0,0:21:24.51,0:21:26.51,Default,,0,0,0,,Уф, у...
Dialogue: 0,0:21:26.51,0:21:32.69,Default,,0,0,0,,Неге... мен осы маймылдың баласын алып жүрмін бе?
Dialogue: 0,0:21:32.69,0:21:37.36,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууу-жоғары.
Dialogue: 0,0:21:37.36,0:21:43.20,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:21:43.20,0:21:46.53,Default,,0,0,0,,Ах~ Ах~ Ах Ах Ах.
Dialogue: 0,0:21:46.53,0:21:49.37,Default,,0,0,0,,Мен өз халқымды құртуды қойдым.
Dialogue: 0,0:21:49.37,0:21:53.04,Default,,0,0,0,,Мені `` Тоа кітабы '' қызықтырмайды.
Dialogue: 0,0:21:53.04,0:21:55.71,Default,,0,0,0,,Айдың тауына қайтамын.
Dialogue: 0,0:21:55.71,0:22:00.65,Default,,0,0,0,,А, у, а, а....
Dialogue: 0,0:22:00.65,0:22:03.48,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:22:03.48,0:22:06.49,Default,,0,0,0,,《Егер бірдеңе аздап өзгерсе...》 (Саусақтарды сермеу дыбысы)
Dialogue: 0,0:22:06.49,0:22:08.99,Default,,0,0,0,,《Мен оны асыға күттім...》
Dialogue: 0,0:22:08.99,0:22:13.59,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:22:15.09,0:22:21.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory