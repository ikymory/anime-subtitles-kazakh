Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.09,0:00:16.43,Default,,0,0,0,,Сағыныштың елі қандай тамаша, Жер!
Dialogue: 0,0:00:18.39,0:00:23.44,Default,,0,0,0,,Уақыт келді, Нехеления-сама.
Dialogue: 0,0:00:23.94,0:00:24.81,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:26.44,0:00:27.36,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:36.82,0:00:38.33,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:00:51.55,0:00:53.01,Default,,0,0,0,,Сәуір айы
Dialogue: 0,0:00:53.63,0:00:56.43,Default,,0,0,0,,Усаги керемет түрде Джубан орта мектебіне түседі
Dialogue: 0,0:00:57.68,0:01:00.72,Default,,0,0,0,,Мамо-чан университеттің медициналық училищесін оңай тапсырды
Dialogue: 0,0:01:03.02,0:01:06.44,Default,,0,0,0,,Ал мен жақсы жауынгер болып өстім.
Dialogue: 0,0:01:06.52,0:01:09.40,Default,,0,0,0,,Мен 30-ғасырға оралуды шештім.
Dialogue: 0,0:01:10.73,0:01:14.32,Default,,0,0,0,,Әке, ана, қарсы алыңыздар!
Dialogue: 0,0:01:20.16,0:01:21.87,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:01:21.95,0:01:23.16,Default,,0,0,0,,Ғажайып адам
Dialogue: 0,0:01:23.25,0:01:24.37,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:01:24.46,0:01:27.29,Default,,0,0,0,,Бүгін - осы ғасырдағы ең үлкен күн тұтылу күні.
Dialogue: 0,0:01:27.37,0:01:29.67,Default,,0,0,0,,Таңертең теледидардан көрсетілді.
Dialogue: 0,0:01:29.75,0:01:31.21,Default,,0,0,0,,Кайкинишоку?
Dialogue: 0,0:01:31.84,0:01:34.55,Default,,0,0,0,,Жаңа ай күннің алдынан өтеді
Dialogue: 0,0:01:34.63,0:01:36.68,Default,,0,0,0,,Күнді бүркейтін құбылыс.
Dialogue: 0,0:01:37.26,0:01:40.55,Default,,0,0,0,,Жаңа ай күнді бүркемелейді...
Dialogue: 0,0:01:40.64,0:01:43.18,Default,,0,0,0,,Қаласаңыз, күн тұтылуына арналған әйнек алыңыз.
Dialogue: 0,0:01:43.68,0:01:45.48,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:45.56,0:01:46.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:49.65,0:01:50.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:50.98,0:01:52.69,Default,,0,0,0,,Күн сөне бастады
Dialogue: 0,0:01:52.78,0:01:55.15,Default,,0,0,0,,Қызық, қазір қояндар қарап тұр ма?
Dialogue: 0,0:01:55.24,0:01:58.53,Default,,0,0,0,,Күннің толық тұтылуын осындай қолайлы жағдайларда көруге болады.
Dialogue: 0,0:01:58.61,0:02:00.37,Default,,0,0,0,,1000 жылда бір рет болуы керек!
Dialogue: 0,0:02:00.45,0:02:01.37,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:02:01.45,0:02:03.33,Default,,0,0,0,,Тілек айтсаңыз, ол орындалуы мүмкін!
Dialogue: 0,0:02:03.95,0:02:05.62,Default,,0,0,0,,Менің арманым - кумир болу!
Dialogue: 0,0:02:05.70,0:02:08.25,Default,,0,0,0,,Сіз өте танымал кумирге айналасыз деп үміттенемін!
Dialogue: 0,0:02:08.33,0:02:10.00,Default,,0,0,0,,Хехе... Мина болса
Dialogue: 0,0:02:10.08,0:02:12.09,Default,,0,0,0,,Менің арманым сенің әйелің болу!
Dialogue: 0,0:02:12.17,0:02:15.17,Default,,0,0,0,,Гүл сататын дүкен немесе торт дүкенін жүргізген кезде
Dialogue: 0,0:02:15.26,0:02:17.59,Default,,0,0,0,,Мен бақытты әйел болғым келеді.
Dialogue: 0,0:02:17.68,0:02:19.01,Default,,0,0,0,,Мако-чан сараң!
Dialogue: 0,0:02:19.09,0:02:21.51,Default,,0,0,0,,Менің арманым дәрігер болу
Dialogue: 0,0:02:21.60,0:02:23.60,Default,,0,0,0,,Сізден керемет дәрігер болады деп үміттенемін!
Dialogue: 0,0:02:23.68,0:02:26.39,Default,,0,0,0,,Мен ата жолын қуамын.
Dialogue: 0,0:02:26.48,0:02:29.44,Default,,0,0,0,,Сіз Хикава храмының тамаша бас діни қызметкері бола аласыз деп үміттенемін.
Dialogue: 0,0:02:31.52,0:02:32.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:34.69,0:02:36.99,Default,,0,0,0,,Қараңғыланып барады...
Dialogue: 0,0:02:41.66,0:02:43.33,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:45.20,0:02:46.16,Default,,0,0,0,,Қоңыраудың дыбысы?
Dialogue: 0,0:02:46.25,0:02:48.08,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:48.16,0:02:50.87,Default,,0,0,0,,Дыбыс қандай таза, әдемі
Dialogue: 0,0:02:50.96,0:02:51.83,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:51.92,0:02:53.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:54.96,0:02:55.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:56.71,0:02:57.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.72,0:02:58.63,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:02:59.93,0:03:01.05,Default,,0,0,0,,Қыз
Dialogue: 0,0:03:02.09,0:03:03.05,Default,,0,0,0,,Әдемі қыз
Dialogue: 0,0:03:05.60,0:03:07.39,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:03:09.73,0:03:10.73,Default,,0,0,0,,Қыз…
Dialogue: 0,0:03:11.73,0:03:12.56,Default,,0,0,0,,Pegasus?
Dialogue: 0,0:03:12.65,0:03:13.56,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:13.65,0:03:15.69,Default,,0,0,0,,Мамо-чан да көрді ме?
Dialogue: 0,0:03:15.77,0:03:16.48,Default,,0,0,0,,О
Dialogue: 0,0:03:17.03,0:03:18.19,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:03:18.28,0:03:18.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:19.03,0:03:20.82,Default,,0,0,0,,Мамо-чан! Мамору-сама!
Dialogue: 0,0:03:21.45,0:03:23.70,Default,,0,0,0,,Мен жай ғана жеңілдеп қалдым.
Dialogue: 0,0:03:24.66,0:03:26.99,Default,,0,0,0,,Не? Ауыруы қазір
Dialogue: 0,0:03:27.08,0:03:31.17,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:34.21,0:03:36.46,Default,,0,0,0,,Күн мен жаңа ай...
Dialogue: 0,0:03:36.55,0:03:37.92,Default,,0,0,0,,Жабу
Dialogue: 0,0:03:39.30,0:03:42.34,Default,,0,0,0,,Жүр, цирк келді!
Dialogue: 0,0:03:42.43,0:03:45.51,Default,,0,0,0,,Әдемі армандарға толы жарықтар қаласы
Dialogue: 0,0:03:45.60,0:03:47.39,Default,,0,0,0,,Менің арманымдағы ел!
Dialogue: 0,0:03:47.47,0:03:50.43,Default,,0,0,0,,Мен бұл сәтті көптен күттім!
Dialogue: 0,0:03:50.52,0:03:53.23,Default,,0,0,0,,Біз өлі ай циркі
Dialogue: 0,0:03:53.31,0:03:54.90,Default,,0,0,0,,Сіз осындасыз!
Dialogue: 0,0:03:57.90,0:04:00.24,Default,,0,0,0,,Қанға боялған жерде жатқан Курису Макисе және
Dialogue: 0,0:04:00.90,0:04:03.66,Default,,0,0,0,,Бүгін күн тұтылудан кеме шықты!
Dialogue: 0,0:04:03.74,0:04:06.62,Default,,0,0,0,,Мен қателеспеген сияқтымын.
Dialogue: 0,0:04:07.79,0:04:09.08,Default,,0,0,0,,Бұл жайлы жаман сезім бар
Dialogue: 0,0:04:11.87,0:04:12.58,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,0:04:12.67,0:04:14.92,Default,,0,0,0,,Мен көрдім, тамаша.
Dialogue: 0,0:04:15.00,0:04:16.29,Default,,0,0,0,,Не? ток
Dialogue: 0,0:04:16.38,0:04:18.71,Default,,0,0,0,,Өлі Ай циркі…
Dialogue: 0,0:04:18.80,0:04:21.17,Default,,0,0,0,,Солай естілгеніне сенімдімін.
Dialogue: 0,0:04:21.26,0:04:23.13,Default,,0,0,0,,Фобос! Димос!
Dialogue: 0,0:04:29.22,0:04:30.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:30.81,0:04:31.85,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:04:33.31,0:04:35.19,Default,,0,0,0,,Tarot Moon картасы
Dialogue: 0,0:04:35.69,0:04:38.57,Default,,0,0,0,,Мағынасы «уайымдау, жаман ескерту»
Dialogue: 0,0:04:39.90,0:04:43.03,Default,,0,0,0,,Осыны айтып тұрсыз ба? Фобос Димос
Dialogue: 0,0:04:44.11,0:04:46.91,Default,,0,0,0,,Мамо-чан, бұрынғы кеме...
Dialogue: 0,0:04:46.99,0:04:48.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:48.37,0:04:51.62,Default,,0,0,0,,Қандай жағдай болмасын, біз бұл дүниені қорғаймыз.
Dialogue: 0,0:04:51.70,0:04:53.08,Default,,0,0,0,,Не? Қоян
Dialogue: 0,0:04:53.16,0:04:53.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:53.91,0:04:55.17,Default,,0,0,0,,Әрине!
Dialogue: 0,0:04:55.25,0:04:57.21,Default,,0,0,0,,Мұны бізге қалдырыңыз.
Dialogue: 0,0:04:57.29,0:04:59.59,Default,,0,0,0,,Чибиуса болашаққа бейбіт түрде орала алады.
Dialogue: 0,0:04:59.67,0:05:00.50,Default,,0,0,0,,Эй?
Dialogue: 0,0:05:01.71,0:05:04.05,Default,,0,0,0,,Жарайды, егер бұл жай қоян болса, мен уайымдайтын едім.
Dialogue: 0,0:05:04.13,0:05:06.59,Default,,0,0,0,,Мамо-чан және басқалары да сонда.
Dialogue: 0,0:05:06.68,0:05:07.68,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:05:07.76,0:05:10.22,Default,,0,0,0,,Бірақ қазір адамдар тым көп.
Dialogue: 0,0:05:10.31,0:05:13.10,Default,,0,0,0,,Чибиусаның болашаққа оралуы мүмкін емес.
Dialogue: 0,0:05:13.18,0:05:14.73,Default,,0,0,0,,Кейінірек келесің бе?
Dialogue: 0,0:05:14.81,0:05:15.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:15.77,0:05:18.31,Default,,0,0,0,,О, сәл күте тұрыңыз!
Dialogue: 0,0:05:21.07,0:05:21.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:22.61,0:05:24.36,Default,,0,0,0,,Мамо-чан, бұл...
Dialogue: 0,0:05:24.45,0:05:25.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.86,0:05:28.95,Default,,0,0,0,,«Амазонкадан: жұмбақ өлі ай циркі»
Dialogue: 0,0:05:29.03,0:05:31.91,Default,,0,0,0,,«Әлем бойынша, ақырында қону»
Dialogue: 0,0:05:32.66,0:05:36.00,Default,,0,0,0,,«Танукиана Сакагами саябағында жұртшылық үшін ашық»
Dialogue: 0,0:05:37.92,0:05:39.71,Default,,0,0,0,,Өлі Ай циркі...
Dialogue: 0,0:05:40.42,0:05:41.63,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,0:05:42.92,0:05:44.84,Default,,0,0,0,,Әй, Чибиуса!
Dialogue: 0,0:05:48.30,0:05:50.10,Default,,0,0,0,,Не болды? Чибиуза
Dialogue: 0,0:05:50.18,0:05:51.31,Default,,0,0,0,,Бұл…
Dialogue: 0,0:05:51.39,0:05:53.18,Default,,0,0,0,,Шыны калейдоскоп?
Dialogue: 0,0:05:53.27,0:05:54.27,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:05:54.35,0:05:55.39,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:05:55.48,0:05:58.90,Default,,0,0,0,,Калейдоскоп мырза сізден «сатып алуды және сатып алуды» сұрайды!
Dialogue: 0,0:05:58.98,0:06:00.27,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:06:00.36,0:06:02.98,Default,,0,0,0,,Мен мұны қалаймын!
Dialogue: 0,0:06:03.07,0:06:03.78,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:03.86,0:06:05.36,Default,,0,0,0,,Аа, бұл да сүйкімді!
Dialogue: 0,0:06:05.44,0:06:07.74,Default,,0,0,0,,Усаги алдамшы! Хмм...
Dialogue: 0,0:06:07.82,0:06:09.78,Default,,0,0,0,,Әй, Мамо-чан!
Dialogue: 0,0:06:10.37,0:06:11.28,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:11.37,0:06:12.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:12.24,0:06:13.74,Default,,0,0,0,,Мамо-чанға рахмет
Dialogue: 0,0:06:13.83,0:06:15.16,Default,,0,0,0,,Мен оны бағалаймын.
Dialogue: 0,0:06:15.25,0:06:16.37,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:16.46,0:06:18.50,Default,,0,0,0,,Мамо-чан маған сәйкес жұп сатып алды.
Dialogue: 0,0:06:18.58,0:06:19.83,Default,,0,0,0,,Бұл менің бірінші рет!
Dialogue: 0,0:06:19.92,0:06:20.92,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:22.29,0:06:25.51,Default,,0,0,0,,Иә, әлі де аз адамдар бар.
Dialogue: 0,0:06:25.59,0:06:28.59,Default,,0,0,0,,Чибиуса, ертең таңертең үйге қашан келесің?
Dialogue: 0,0:06:28.68,0:06:30.30,Default,,0,0,0,,Түнде қауіпті.
Dialogue: 0,0:06:30.39,0:06:31.47,Default,,0,0,0,,Олай болса орындаңыз!
Dialogue: 0,0:06:32.10,0:06:34.01,Default,,0,0,0,,Мамо-чан, жүр, білесің бе.
Dialogue: 0,0:06:34.10,0:06:35.93,Default,,0,0,0,,Менің өтінішім бар...
Dialogue: 0,0:06:36.02,0:06:37.43,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:06:37.52,0:06:38.73,Default,,0,0,0,,Оттомари~♪
Dialogue: 0,0:06:38.81,0:06:39.98,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:06:40.06,0:06:42.48,Default,,0,0,0,,Мен Мамо-чанның пижамасын қарызға алдым
Dialogue: 0,0:06:42.56,0:06:43.57,Default,,0,0,0,,Әй, ана?
Dialogue: 0,0:06:43.65,0:06:47.11,Default,,0,0,0,,Мен қазір Мамочанчиде оқимын... Иә, иә.
Dialogue: 0,0:06:47.19,0:06:49.49,Default,,0,0,0,,Мен бүгін түнде қалуым мүмкін. Сонда кездескенше!
Dialogue: 0,0:06:50.95,0:06:53.16,Default,,0,0,0,,Уау, өте әдемі!
Dialogue: 0,0:06:53.24,0:06:55.24,Default,,0,0,0,,Маған осындай нәрсе керек еді
Dialogue: 0,0:06:55.33,0:06:56.41,Default,,0,0,0,,Кя~!
Dialogue: 0,0:06:56.50,0:06:59.54,Default,,0,0,0,,Чибиуса, мен ертең сағат 5-те тұрып, үйге барамын.
Dialogue: 0,0:06:59.62,0:07:00.29,Default,,0,0,0,,Ерте ұйықтаңыз
Dialogue: 0,0:07:00.37,0:07:01.17,Default,,0,0,0,,Эх!
Dialogue: 0,0:07:01.75,0:07:03.96,Default,,0,0,0,,Қоян, үйге бару керек.
Dialogue: 0,0:07:04.04,0:07:05.38,Default,,0,0,0,,Сіз менің сенімімді жоғалтасыз, солай ма?
Dialogue: 0,0:07:05.46,0:07:06.38,Default,,0,0,0,,Эх!
Dialogue: 0,0:07:06.46,0:07:08.59,Default,,0,0,0,,Менің үйге барғым келмейді!
Dialogue: 0,0:07:08.67,0:07:09.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:13.10,0:07:13.89,Default,,0,0,0,,Уау
Dialogue: 0,0:07:13.97,0:07:15.26,Default,,0,0,0,,Гааах!
Dialogue: 0,0:07:15.35,0:07:19.14,Default,,0,0,0,,Мен қызымды өсірсем, міндетті түрде қатаң түрде тәрбиелеймін.
Dialogue: 0,0:07:19.23,0:07:20.64,Default,,0,0,0,,Ngggg…
Dialogue: 0,0:07:20.73,0:07:23.77,Default,,0,0,0,,Балалардың ашық еркелегені жақсы.
Dialogue: 0,0:07:23.86,0:07:27.07,Default,,0,0,0,,Хаа~ Мен де Чибиуса сияқты кішкентай болғым келеді.
Dialogue: 0,0:07:27.15,0:07:29.99,Default,,0,0,0,,Е! Мен мүмкіндігінше тезірек ересек болғым келеді!
Dialogue: 0,0:07:30.07,0:07:32.36,Default,,0,0,0,,Содан кейін, Мамо-чаннан
Dialogue: 0,0:07:32.45,0:07:35.20,Default,,0,0,0,,Сіз толыққанды әйел ретінде көрінесіз, солай ма?
Dialogue: 0,0:07:35.28,0:07:37.75,Default,,0,0,0,,Неге олай дейсің, Мамо-чан сонша мүйізді болса да!
Dialogue: 0,0:07:37.83,0:07:38.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:38.79,0:07:40.21,Default,,0,0,0,,Өтінемін, ұйықта!
Dialogue: 0,0:07:42.29,0:07:43.63,Default,,0,0,0,,Бұл шынымен менмін
Dialogue: 0,0:07:43.71,0:07:45.79,Default,,0,0,0,,Мен қоян сияқты болғым келеді
Dialogue: 0,0:07:45.88,0:07:49.09,Default,,0,0,0,,Ұзын, жіңішке аяқтары
Dialogue: 0,0:07:49.59,0:07:51.09,Default,,0,0,0,,Үлпілдек кеуде
Dialogue: 0,0:07:51.18,0:07:53.30,Default,,0,0,0,,Жұмсақ және ұзын шаш
Dialogue: 0,0:07:54.39,0:07:55.47,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:55.55,0:07:58.56,Default,,0,0,0,,Мен де қоян сияқты асығамын...
Dialogue: 0,0:07:59.73,0:08:00.85,Default,,0,0,0,,Сіз ұйықтай алмайсыз ба?
Dialogue: 0,0:08:00.93,0:08:03.02,Default,,0,0,0,,А... ештеңе!
Dialogue: 0,0:08:03.56,0:08:05.44,Default,,0,0,0,,Ертең 30 ғасыр.
Dialogue: 0,0:08:05.52,0:08:06.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.98,0:08:09.32,Default,,0,0,0,,Эй, менімен сөйлесші.
Dialogue: 0,0:08:09.40,0:08:10.36,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:08:10.90,0:08:14.53,Default,,0,0,0,,Түнде ұйықтағанда анам маған ертегі айтып беретін.
Dialogue: 0,0:08:15.57,0:08:17.70,Default,,0,0,0,,Теңізге батқан ұлы империя
Dialogue: 0,0:08:17.79,0:08:18.79,Default,,0,0,0,,Пирамидалар туралы жұмбақ
Dialogue: 0,0:08:19.58,0:08:21.00,Default,,0,0,0,,Қарғыс атқан гауһарға
Dialogue: 0,0:08:21.83,0:08:23.75,Default,,0,0,0,,Android құрылғылары, вампирлер,
Dialogue: 0,0:08:23.83,0:08:26.00,Default,,0,0,0,,Айна оқиғасы т.б.
Dialogue: 0,0:08:26.67,0:08:28.00,Default,,0,0,0,,Айна оқиғасы?
Dialogue: 0,0:08:28.96,0:08:30.84,Default,,0,0,0,,Білесің бе, айнаның арғы жағында
Dialogue: 0,0:08:30.92,0:08:34.51,Default,,0,0,0,,Қап қараңғы басқа әлем бар.
Dialogue: 0,0:08:34.59,0:08:37.64,Default,,0,0,0,,Сонымен, ай жаңарған қоңыр түнде
Dialogue: 0,0:08:37.72,0:08:39.68,Default,,0,0,0,,Айнаға қарамау керек
Dialogue: 0,0:08:40.22,0:08:44.02,Default,,0,0,0,,Өйткені мен айнаның ішіндегі басқа әлемге тартылдым.
Dialogue: 0,0:08:44.10,0:08:46.98,Default,,0,0,0,,Ей, мен енді түнде айнаға қарай алмаймын.
Dialogue: 0,0:08:47.06,0:08:49.19,Default,,0,0,0,,Чибиусаның ақымақ! қайырлы түн!
Dialogue: 0,0:08:49.27,0:08:50.36,Default,,0,0,0,,Бала?
Dialogue: 0,0:08:51.44,0:08:53.24,Default,,0,0,0,,Чибиуса жетілген.
Dialogue: 0,0:08:53.32,0:08:54.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:54.82,0:08:57.32,Default,,0,0,0,,Мамо-чан, бұл рас па?
Dialogue: 0,0:08:57.41,0:09:01.54,Default,,0,0,0,,Бұл менмін, тезірек есейгім келеді.
Dialogue: 0,0:09:05.12,0:09:08.84,Default,,0,0,0,,Күн сәулесі қарт адамдарға тым ашық.
Dialogue: 0,0:09:08.92,0:09:11.76,Default,,0,0,0,,Түнде мен өзімді жеңіл сезінемін
Dialogue: 0,0:09:13.05,0:09:15.38,Default,,0,0,0,,Осы қалада ерте
Dialogue: 0,0:09:15.47,0:09:19.76,Default,,0,0,0,,Мен өз циркімді табысты етуім керек.
Dialogue: 0,0:09:20.81,0:09:22.27,Default,,0,0,0,,Циркон
Dialogue: 0,0:09:23.89,0:09:27.56,Default,,0,0,0,,Сіз мені естисіз бе? Кішкентай қыздар
Dialogue: 0,0:09:27.65,0:09:30.02,Default,,0,0,0,,Мен білемін, әже.
Dialogue: 0,0:09:30.11,0:09:31.90,Default,,0,0,0,,Ура! Йо! біртүрлі!
Dialogue: 0,0:09:32.48,0:09:35.61,Default,,0,0,0,,Оны допты пайдаланушылардың амазониялық квартетіне қалдыратын кез келді.
Dialogue: 0,0:09:35.70,0:09:39.16,Default,,0,0,0,,Біздің бизнесімізге араласпау үшін.
Dialogue: 0,0:09:40.95,0:09:43.20,Default,,0,0,0,,Тіпті бір көріксіз жәндік келіп-кетіп жатыр
Dialogue: 0,0:09:43.29,0:09:44.58,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:09:44.66,0:09:47.37,Default,,0,0,0,,Кіру және шығу есіктері тығыз жабылуы керек.
Dialogue: 0,0:09:48.29,0:09:51.42,Default,,0,0,0,,Біздің амазонкалар арасында қалған қарғыс атқан тас.
Dialogue: 0,0:09:51.50,0:09:53.38,Default,,0,0,0,,Amazon Stone!
Dialogue: 0,0:09:54.38,0:09:55.88,Default,,0,0,0,,Нефриттен жасалған тәж!
Dialogue: 0,0:10:03.02,0:10:05.64,Default,,0,0,0,,Қыз... Қыз
Dialogue: 0,0:10:06.56,0:10:08.73,Default,,0,0,0,,Қыз? Бұл...
Dialogue: 0,0:10:09.40,0:10:11.11,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:10:12.32,0:10:13.36,Default,,0,0,0,,Ұшу!
Dialogue: 0,0:10:14.69,0:10:15.99,Default,,0,0,0,,Pegasus ол кезде?
Dialogue: 0,0:10:16.82,0:10:19.11,Default,,0,0,0,,Әдемі армандары бар қыз
Dialogue: 0,0:10:19.20,0:10:20.07,Default,,0,0,0,,Қыз…
Dialogue: 0,0:10:20.87,0:10:23.79,Default,,0,0,0,,Сіз шынымен мені айтқыңыз келді ме?
Dialogue: 0,0:10:23.87,0:10:24.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.16,0:10:27.79,Default,,0,0,0,,Уау! әдемі!
Dialogue: 0,0:10:28.62,0:10:30.71,Default,,0,0,0,,Сізге бұл көрініс ұнай ма?
Dialogue: 0,0:10:30.79,0:10:32.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:33.50,0:10:34.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.34,0:10:36.72,Default,,0,0,0,,Тек сонда ғана қараңғы
Dialogue: 0,0:10:36.80,0:10:38.38,Default,,0,0,0,,Бұл сіз тұрған қала.
Dialogue: 0,0:10:38.47,0:10:41.55,Default,,0,0,0,,А... Бұл Джубан сауда ауданы ма?
Dialogue: 0,0:10:41.64,0:10:43.51,Default,,0,0,0,,Неліктен түн қараңғы?
Dialogue: 0,0:10:50.35,0:10:52.23,Default,,0,0,0,,Маған қолыңды бер
Dialogue: 0,0:10:58.03,0:10:59.61,Default,,0,0,0,,Suzu…
Dialogue: 0,0:10:59.70,0:11:01.91,Default,,0,0,0,,Қажет болса
Dialogue: 0,0:11:01.99,0:11:03.95,Default,,0,0,0,,Маған сол қоңыраумен қоңырау шалыңыз
Dialogue: 0,0:11:04.83,0:11:06.41,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:06.50,0:11:08.62,Default,,0,0,0,,Мен Пегасуспын
Dialogue: 0,0:11:08.71,0:11:10.25,Default,,0,0,0,,Бұл Элиос
Dialogue: 0,0:11:11.08,0:11:12.00,Default,,0,0,0,,Қыз
Dialogue: 0,0:11:12.58,0:11:15.00,Default,,0,0,0,,Міндетті түрде өз күшіңіз болыңыз
Dialogue: 0,0:11:15.84,0:11:17.34,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:11:17.42,0:11:20.05,Default,,0,0,0,,Маған күшіңізді беріңізші
Dialogue: 0,0:11:20.13,0:11:21.34,Default,,0,0,0,,Менікі?
Dialogue: 0,0:11:21.43,0:11:24.51,Default,,0,0,0,,Мен Элизиумды құтқарғым келеді.
Dialogue: 0,0:11:24.60,0:11:27.52,Default,,0,0,0,,Маған Алтын Кристалл керек.
Dialogue: 0,0:11:27.60,0:11:29.39,Default,,0,0,0,,Элиос!
Dialogue: 0,0:11:30.02,0:11:30.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:32.15,0:11:34.44,Default,,0,0,0,,Амансың ба? кішкентай ханым
Dialogue: 0,0:11:35.02,0:11:36.11,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:11:37.28,0:11:38.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:41.61,0:11:43.20,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:11:57.13,0:11:58.51,Default,,0,0,0,,Түсінде...
Dialogue: 0,0:11:58.59,0:12:00.72,Default,,0,0,0,,Чибиуса, әлгі Пегас...
Dialogue: 0,0:12:00.80,0:12:03.68,Default,,0,0,0,,Ха... Мамо-чан, сенің де түсің бар ма?
Dialogue: 0,0:12:03.76,0:12:04.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.22,0:12:06.72,Default,,0,0,0,,Мамо-чан мынау!
Dialogue: 0,0:12:06.81,0:12:08.10,Default,,0,0,0,,Мен үйге жалғыз барамын
Dialogue: 0,0:12:08.72,0:12:12.19,Default,,0,0,0,,Уайымдама, мен саған тағы да келемін.
Dialogue: 0,0:12:12.27,0:12:14.94,Default,,0,0,0,,Көріскенше, Чибиуса
Dialogue: 0,0:12:16.48,0:12:17.94,Default,,0,0,0,,Кішкентай ханым?
Dialogue: 0,0:12:19.90,0:12:22.20,Default,,0,0,0,,Менің үйге барғым келмейді
Dialogue: 0,0:12:22.78,0:12:23.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.78,0:12:25.66,Default,,0,0,0,,Мен Элиоспын
Dialogue: 0,0:12:25.74,0:12:28.16,Default,,0,0,0,,Мен Элизийді құтқарғым келеді.
Dialogue: 0,0:12:29.04,0:12:32.00,Default,,0,0,0,,Маған Алтын Кристалл керек.
Dialogue: 0,0:12:32.08,0:12:34.00,Default,,0,0,0,,Оның көзі байыпты.
Dialogue: 0,0:12:34.08,0:12:37.00,Default,,0,0,0,,Көмек сұрап тұрғандай көрінді
Dialogue: 0,0:12:39.63,0:12:41.22,Default,,0,0,0,,Кішкентай ханым…
Dialogue: 0,0:12:42.26,0:12:44.18,Default,,0,0,0,,Уақыт қорғаушысы!
Dialogue: 0,0:12:44.26,0:12:49.10,Default,,0,0,0,,Уақыт пен кеңістіктің есігі, Аспанды жарып, маған аш!
Dialogue: 0,0:12:49.18,0:12:51.89,Default,,0,0,0,,Мен сенің шын атыңды атаймын!
Dialogue: 0,0:12:51.98,0:12:56.19,Default,,0,0,0,,Уақыттың Құдіретті Құдайы, Сақшылардың Әкесі, Кронус!
Dialogue: 0,0:12:56.27,0:12:58.48,Default,,0,0,0,,Маған жол көрсет!
Dialogue: 0,0:12:58.57,0:13:00.19,Default,,0,0,0,,Мені қорға!
Dialogue: 0,0:13:00.78,0:13:02.49,Default,,0,0,0,,Маған жарық жолын әкел!
Dialogue: 0,0:13:03.95,0:13:05.95,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:13:07.41,0:13:09.28,Default,,0,0,0,,Кішкентай ханым!
Dialogue: 0,0:13:09.37,0:13:10.54,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:13:10.62,0:13:12.41,Default,,0,0,0,,Усаги-сама! Мамору-сама!
Dialogue: 0,0:13:12.50,0:13:14.87,Default,,0,0,0,,Кеңістік-уақыт кілті жұмыс істемейді.
Dialogue: 0,0:13:14.96,0:13:16.08,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:13:16.17,0:13:16.92,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:13:20.05,0:13:20.92,Default,,0,0,0,,Қыз
Dialogue: 0,0:13:21.01,0:13:22.13,Default,,0,0,0,,Элиос!
Dialogue: 0,0:13:22.76,0:13:24.51,Default,,0,0,0,,Маған күшіңізді беріңіз...
Dialogue: 0,0:13:25.47,0:13:26.72,Default,,0,0,0,,Сол Pegasus...
Dialogue: 0,0:13:26.80,0:13:28.51,Default,,0,0,0,,Қоян Мамо-чан
Dialogue: 0,0:13:28.60,0:13:30.72,Default,,0,0,0,,Маған үйге барудың қажеті жоқ!
Dialogue: 0,0:13:30.81,0:13:32.81,Default,,0,0,0,,Одан да әлгі Pegasus.
Dialogue: 0,0:13:32.89,0:13:34.73,Default,,0,0,0,,Сіз көмек сұрап жатқан сияқтысыз
Dialogue: 0,0:13:34.81,0:13:36.81,Default,,0,0,0,,Мен саған күшімді бергім келеді!
Dialogue: 0,0:13:38.56,0:13:40.69,Default,,0,0,0,,Мен сеземін... Мен оны сезінемін.
Dialogue: 0,0:13:41.28,0:13:44.95,Default,,0,0,0,,Біреу күшпен тосқауылдан өтпек болды.
Dialogue: 0,0:13:45.74,0:13:47.91,Default,,0,0,0,,Мен оны қарап шығуым керек.
Dialogue: 0,0:13:51.41,0:13:53.83,Default,,0,0,0,,Бар, Тора-но-ме-чан!
Dialogue: 0,0:13:53.91,0:13:57.17,Default,,0,0,0,,Сол күдікті жігіттердің құйрығынан ұстаңыз!
Dialogue: 0,0:13:57.25,0:13:59.25,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:14:00.04,0:14:02.59,Default,,0,0,0,,Элиос - Пегас.
Dialogue: 0,0:14:02.67,0:14:04.47,Default,,0,0,0,,«Мен Элизийді құтқарғым келеді»
Dialogue: 0,0:14:04.55,0:14:06.51,Default,,0,0,0,,«Алтын кристалл қажет»
Dialogue: 0,0:14:06.59,0:14:07.93,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:14:08.59,0:14:09.43,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.05,0:14:11.89,Default,,0,0,0,,Элизиум…
Dialogue: 0,0:14:11.97,0:14:13.89,Default,,0,0,0,,Әйтеуір ностальгиялық естіледі...
Dialogue: 0,0:14:14.48,0:14:16.77,Default,,0,0,0,,Сіз кімсіз? Сол Пегасус
Dialogue: 0,0:14:18.35,0:14:21.98,Default,,0,0,0,,Солай болса да, кеңістік-уақыт кілті жұмыс істемейді...
Dialogue: 0,0:14:23.86,0:14:24.99,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:25.07,0:14:26.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:26.82,0:14:28.74,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:14:29.87,0:14:31.95,Default,,0,0,0,,Цирк ұжымынан жолбарыс қашып кетті.
Dialogue: 0,0:14:32.03,0:14:34.24,Default,,0,0,0,,Мен Джубан сауда ауданына жүгірдім.
Dialogue: 0,0:14:34.33,0:14:35.58,Default,,0,0,0,,Жолбарыс?
Dialogue: 0,0:14:37.16,0:14:39.58,Default,,0,0,0,,Біз барлығын қорғауымыз керек!
Dialogue: 0,0:14:42.04,0:14:43.17,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,0:14:43.25,0:14:44.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:45.76,0:14:48.47,Default,,0,0,0,,Бұл тікенді шаншып ауырды тағы
Dialogue: 0,0:14:53.76,0:14:56.43,Default,,0,0,0,,Чибиуса, түрлен! иә!
Dialogue: 0,0:14:56.52,0:14:59.19,Default,,0,0,0,,Айдың ғарыштық күші!
Dialogue: 0,0:14:59.27,0:15:01.44,Default,,0,0,0,,Ай призмасының күші!
Dialogue: 0,0:15:01.52,0:15:03.69,Default,,0,0,0,,Макияж!
Dialogue: 0,0:15:05.11,0:15:07.07,Default,,0,0,0,,Хмм... О, не?
Dialogue: 0,0:15:07.15,0:15:08.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:08.28,0:15:09.11,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:10.16,0:15:11.07,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:15:11.16,0:15:12.28,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:12.37,0:15:14.45,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:15:15.79,0:15:16.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:24.34,0:15:25.96,Default,,0,0,0,,Неліктен өзгерте алмайсыз?
Dialogue: 0,0:15:31.34,0:15:32.47,Default,,0,0,0,,Қасиетті Граил...
Dialogue: 0,0:15:35.76,0:15:36.60,Default,,0,0,0,,Қасиетті Граил
Dialogue: 0,0:15:36.68,0:15:39.89,Default,,0,0,0,,Тоғыз жауынгердің күші бір жерге жиналғанда не пайда болды
Dialogue: 0,0:15:42.69,0:15:45.40,Default,,0,0,0,,Бұл үшеуі енді жоқ.
Dialogue: 0,0:15:47.03,0:15:47.86,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:48.36,0:15:50.90,Default,,0,0,0,,Біз күресуіміз керек!
Dialogue: 0,0:15:51.53,0:15:54.66,Default,,0,0,0,,Қараңызшы, ішімізден толып жатыр.
Dialogue: 0,0:15:54.74,0:15:57.83,Default,,0,0,0,,Бұрынғыдан өзгеше жаңа қуат
Dialogue: 0,0:16:00.50,0:16:05.04,Default,,0,0,0,,Ай дағдарысына арналған макияж!
Dialogue: 0,0:16:33.74,0:16:35.49,Default,,0,0,0,,Махаббат пен әділеттілік
Dialogue: 0,0:16:36.20,0:16:38.41,Default,,0,0,0,,Матрос костюмі әдемі жауынгер қыз
Dialogue: 0,0:16:39.08,0:16:41.37,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:16:42.75,0:16:45.13,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:16:46.00,0:16:48.38,Default,,0,0,0,,Ай атынан
Dialogue: 0,0:16:48.46,0:16:50.09,Default,,0,0,0,,Мені жазала!
Dialogue: 0,0:16:52.13,0:16:53.63,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:53.72,0:16:54.84,Default,,0,0,0,,Йотто!
Dialogue: 0,0:16:56.72,0:16:58.26,Default,,0,0,0,,Тора но Ме-чан
Dialogue: 0,0:16:58.35,0:17:00.77,Default,,0,0,0,,Күдікті адамды әшкерелеудегі қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:17:02.94,0:17:06.19,Default,,0,0,0,,Барьерді бұзбақ болғандар сендер болдыңдар.
Dialogue: 0,0:17:06.27,0:17:06.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.06,0:17:07.94,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:17:08.77,0:17:10.44,Default,,0,0,0,,Мазасыздықтан құтылыңыз!
Dialogue: 0,0:17:12.03,0:17:13.11,Default,,0,0,0,,Маған доптарды шақырыңыз!
Dialogue: 0,0:17:13.78,0:17:17.45,Default,,0,0,0,,Қобалжыған түн, Лемурлар, мені же!
Dialogue: 0,0:17:17.53,0:17:18.74,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:17:18.83,0:17:20.37,Default,,0,0,0,,Міне! Кекекеке!
Dialogue: 0,0:17:20.45,0:17:21.83,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:17:24.67,0:17:25.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:26.83,0:17:28.25,Default,,0,0,0,,Біз шабуылға шығуымыз керек...
Dialogue: 0,0:17:28.34,0:17:30.75,Default,,0,0,0,,Бұл жігіттерді жеңетін қару!
Dialogue: 0,0:17:30.84,0:17:31.51,Default,,0,0,0,,Біз оны да білмейміз.
Dialogue: 0,0:17:33.84,0:17:35.13,Default,,0,0,0,,Қоңырау...
Dialogue: 0,0:17:35.80,0:17:39.35,Default,,0,0,0,,Мен саған күшімді беремін, қыз.
Dialogue: 0,0:17:39.43,0:17:40.47,Default,,0,0,0,,Элиос?
Dialogue: 0,0:17:40.56,0:17:43.77,Default,,0,0,0,,Менің атымды атаңыз
Dialogue: 0,0:17:43.85,0:17:47.23,Default,,0,0,0,,және Twinkle Ale деп айқайлаңыз!
Dialogue: 0,0:17:47.31,0:17:48.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.15,0:17:50.82,Default,,0,0,0,,Кя~!
Dialogue: 0,0:17:50.90,0:17:52.28,Default,,0,0,0,,Қыз!
Dialogue: 0,0:17:53.90,0:17:55.49,Default,,0,0,0,,Элиос, өтінемін!
Dialogue: 0,0:17:55.57,0:17:57.78,Default,,0,0,0,,Бізге қару беріңіз!
Dialogue: 0,0:17:57.87,0:17:59.78,Default,,0,0,0,,Twinkle Ale!
Dialogue: 0,0:18:04.41,0:18:05.54,Default,,0,0,0,,Не!
Dialogue: 0,0:18:05.62,0:18:06.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:06.75,0:18:08.46,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:18:09.59,0:18:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:11.84,0:18:13.01,Default,,0,0,0,,Калейдоскоп?
Dialogue: 0,0:18:14.26,0:18:16.93,Default,,0,0,0,,Бұл кристалды калейдоскоп
Dialogue: 0,0:18:17.01,0:18:20.01,Default,,0,0,0,,Мен сенімен берік байланысқа үміттендім.
Dialogue: 0,0:18:21.18,0:18:23.18,Default,,0,0,0,,Ай калейдоскопы және
Dialogue: 0,0:18:23.27,0:18:24.98,Default,,0,0,0,,Chibi Moon Kaleido ауқымы
Dialogue: 0,0:18:26.56,0:18:28.94,Default,,0,0,0,,Қарғыс атқыр... Жасай бер, Лемлес!
Dialogue: 0,0:18:29.02,0:18:31.44,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:18:46.21,0:18:51.50,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,0:18:59.13,0:18:59.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.84,0:19:00.76,Default,,0,0,0,,Ол адам қуанады…
Dialogue: 0,0:19:02.43,0:19:04.06,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:19:04.14,0:19:05.60,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:19:05.68,0:19:07.43,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:19:09.06,0:19:10.98,Default,,0,0,0,,Сол жарқыраған күш...
Dialogue: 0,0:19:12.15,0:19:13.07,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:19:15.94,0:19:17.15,Default,,0,0,0,,Элиос!
Dialogue: 0,0:19:18.49,0:19:19.32,Default,,0,0,0,,Элиос…
Dialogue: 0,0:19:20.74,0:19:23.74,Default,,0,0,0,,Күткендей, мен бұл дыбыста сағыныш сезінемін.
Dialogue: 0,0:19:23.83,0:19:25.24,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:19:25.74,0:19:26.91,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:28.00,0:19:28.87,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,0:19:31.83,0:19:33.79,Default,,0,0,0,,Бұл не? Сол жігіттер
Dialogue: 0,0:19:33.88,0:19:35.21,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:19:35.30,0:19:38.88,Default,,0,0,0,,Біріншіден, бірдеңені түсінбесеңіз, айнадан сұраңыз.
Dialogue: 0,0:19:38.97,0:19:42.09,Default,,0,0,0,,Сол балалардың әдемі армандары ше?
Dialogue: 0,0:19:42.18,0:19:43.64,Default,,0,0,0,,Сен мықты болуың керек!
Dialogue: 0,0:19:43.72,0:19:45.31,Default,,0,0,0,,Мен жетілген болуым керек!
Dialogue: 0,0:19:45.39,0:19:48.27,Default,,0,0,0,,Маған әлі ересек болу керек емес.
Dialogue: 0,0:19:49.64,0:19:51.48,Default,,0,0,0,,Мен бұл тілекті түсінемін!
Dialogue: 0,0:19:51.56,0:19:54.06,Default,,0,0,0,,Қай заманда болмасын шын айқай
Dialogue: 0,0:19:54.15,0:19:56.82,Default,,0,0,0,,Сөздердің астарында не жатыр
Dialogue: 0,0:19:56.90,0:19:58.24,Default,,0,0,0,,Гякудама!
Dialogue: 0,0:19:58.32,0:19:59.74,Default,,0,0,0,,Ауруханаға асығыңыз!
Dialogue: 0,0:19:59.82,0:20:00.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:02.49,0:20:03.53,Default,,0,0,0,,Кя!
Dialogue: 0,0:20:04.07,0:20:04.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:06.04,0:20:07.95,Default,,0,0,0,,Чибиуса? Қоян?
Dialogue: 0,0:20:08.95,0:20:12.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:14.29,0:20:16.00,Default,,0,0,0,,О...
Dialogue: 0,0:20:16.84,0:20:21.05,Default,,0,0,0,,Бұл шын мәнінде фантомдық күміс кристалының күші.
Dialogue: 0,0:20:21.13,0:20:24.05,Default,,0,0,0,,Ақ Ай патшалығының адамдары
Dialogue: 0,0:20:24.14,0:20:26.81,Default,,0,0,0,,Бұл дүниеде реинкарнация болу қандай болды?
Dialogue: 0,0:20:27.43,0:20:28.43,Default,,0,0,0,,Циркония…
Dialogue: 0,0:20:28.52,0:20:30.27,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:30.35,0:20:31.77,Default,,0,0,0,,Лорд Нехеления
Dialogue: 0,0:20:31.85,0:20:35.52,Default,,0,0,0,,Ақ Ай патшалығының адамдары
Dialogue: 0,0:20:35.61,0:20:38.03,Default,,0,0,0,,Біздің жек көретін жауымыз
Dialogue: 0,0:20:38.11,0:20:39.03,Default,,0,0,0,,Қош бол
Dialogue: 0,0:20:39.11,0:20:41.99,Default,,0,0,0,,Оларды түнгі түстердің жеміне айналдыр
Dialogue: 0,0:20:42.07,0:20:45.41,Default,,0,0,0,,Ал менің қолымда елес күміс кристалды ...
Dialogue: 0,0:20:46.16,0:20:48.12,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:20:48.20,0:20:50.00,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:20:51.58,0:20:53.17,Default,,0,0,0,,Мен дем ала алмаймын
Dialogue: 0,0:20:53.25,0:20:55.67,Default,,0,0,0,,Менің кеудемде бірдеңе...
Dialogue: 0,0:20:55.75,0:20:56.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:57.04,0:20:58.17,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:20:59.51,0:21:01.67,Default,,0,0,0,,АҚШ... Чибиуса...
Dialogue: 0,0:21:01.76,0:21:03.18,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:21:03.26,0:21:04.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:05.59,0:21:06.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.60,0:21:08.72,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,0:21:08.81,0:21:10.02,Default,,0,0,0,,Мамору-сан ше?
Dialogue: 0,0:21:10.10,0:21:11.06,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:21:11.14,0:21:12.43,Default,,0,0,0,,Мен енді ғана ояндым
Dialogue: 0,0:21:12.52,0:21:13.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:15.90,0:21:17.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:17.65,0:21:20.53,Default,,0,0,0,,Кенет Усаги-чан кішірейіп кетті.
Dialogue: 0,0:21:20.61,0:21:22.36,Default,,0,0,0,,Чибиуса үлкейіп кетті ме?
Dialogue: 0,0:21:22.44,0:21:23.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:23.15,0:21:24.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:24.28,0:21:26.32,Default,,0,0,0,,Сондықтан мен оны мүлдем түсінбеймін!
Dialogue: 0,0:21:26.41,0:21:29.79,Default,,0,0,0,,Цирктен қашқан жолбарысты қудым.
Dialogue: 0,0:21:29.87,0:21:31.08,Default,,0,0,0,,Жау пайда болады...
Dialogue: 0,0:21:31.16,0:21:32.75,Default,,0,0,0,,Цирк тобы?
Dialogue: 0,0:21:32.83,0:21:33.79,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:33.87,0:21:35.83,Default,,0,0,0,,Өлі Ай циркі…
Dialogue: 0,0:21:35.92,0:21:37.21,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:21:37.29,0:21:38.13,Default,,0,0,0,,
Dialogue: 0,0:21:39.21,0:21:42.55,Default,,0,0,0,,Мамору Чиба мырза, тексеру дайын.
Dialogue: 0,0:21:42.63,0:21:43.51,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:21:43.59,0:21:45.51,Default,,0,0,0,,Амидың анасы?
Dialogue: 0,0:21:45.59,0:21:46.80,Default,,0,0,0,,Өте әдемі!
Dialogue: 0,0:21:46.89,0:21:47.97,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:49.47,0:21:50.56,Default,,0,0,0,,Өкпедегі көлеңке?
Dialogue: 0,0:21:50.64,0:21:51.60,Default,,0,0,0,,Иә
Dialogue: 0,0:21:51.68,0:21:54.31,Default,,0,0,0,,Бір рет мұқият тексерген дұрыс.
Dialogue: 0,0:21:55.14,0:21:56.19,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:57.73,0:21:58.90,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:21:58.98,0:22:01.32,Default,,0,0,0,,Қалаған нәрсе бар ма?
Dialogue: 0,0:22:01.40,0:22:02.40,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:22:02.48,0:22:06.32,Default,,0,0,0,,Уса, сен де, осындай қиын кезеңнен өткенім үшін кешір.
Dialogue: 0,0:22:07.07,0:22:08.82,Default,,0,0,0,,Өлі Ай циркі
Dialogue: 0,0:22:08.91,0:22:12.08,Default,,0,0,0,,Олар міндетті түрде осы қаланы нысанаға алады.
Dialogue: 0,0:22:12.75,0:22:14.87,Default,,0,0,0,,Бізге тезірек бірдеңе істеу керек.
Dialogue: 0,0:22:14.96,0:22:16.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:18.46,0:22:19.42,Default,,0,0,0,,Аха…
Dialogue: 0,0:22:20.13,0:22:22.55,Default,,0,0,0,,Бірдеңе дұрыс емес...
Dialogue: 0,0:22:22.63,0:22:23.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:24.63,0:22:25.76,Default,,0,0,0,,Мамо-чан?
Dialogue: 0,0:22:25.84,0:22:27.51,Default,,0,0,0,,Ой... жарайды.
Dialogue: 0,0:22:27.59,0:22:29.51,Default,,0,0,0,,Мен сәл демаламын.
Dialogue: 0,0:22:31.97,0:22:32.64,Default,,0,0,0,,Қоян
Dialogue: 0,0:22:33.31,0:22:36.44,Default,,0,0,0,,Мен саған көп жүк артып жатырмын.
Dialogue: 0,0:22:36.52,0:22:37.27,Default,,0,0,0,,А...
Dialogue: 0,0:22:38.56,0:22:41.69,Default,,0,0,0,,Менде сенің күшіңнің үзіндісі де жоқ.
Dialogue: 0,0:22:42.52,0:22:45.74,Default,,0,0,0,,Керісінше, ол бізді тек ұстап тұр.
Dialogue: 0,0:22:46.53,0:22:48.61,Default,,0,0,0,,Мен осында мәңгі боламын
Dialogue: 0,0:22:48.70,0:22:52.58,Default,,0,0,0,,Саған тек кедергі бола ма деп қорқамын.
Dialogue: 0,0:22:52.66,0:22:54.91,Default,,0,0,0,,Кейде ойлаймын
Dialogue: 0,0:22:56.66,0:22:57.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:57.62,0:22:59.38,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:22:59.46,0:23:00.46,Default,,0,0,0,,Мамо-чан
Dialogue: 0,0:23:01.04,0:23:04.96,Default,,0,0,0,,Мен сенің қасыңда болсам, Мамо-чан араласады.
Dialogue: 0,0:23:05.97,0:23:08.18,Default,,0,0,0,,Бұл мені жаман сезінеді
Dialogue: 0,0:23:09.30,0:23:12.30,Default,,0,0,0,,Мен болмасам жақсы емес пе?
Dialogue: 0,0:23:13.47,0:23:16.14,Default,,0,0,0,,Менің арманым – Мамо-чан
Dialogue: 0,0:23:17.14,0:23:20.23,Default,,0,0,0,,Мен сенің жаныңда осылай мәңгі қалсам деп едім
Dialogue: 0,0:23:21.48,0:23:23.65,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:23:25.94,0:23:27.07,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:23:28.32,0:23:29.91,Default,,0,0,0,,Қаншалықты ұнаса да
Dialogue: 0,0:23:29.99,0:23:32.91,Default,,0,0,0,,Мамо-чан менің болашақ әкем
Dialogue: 0,0:23:36.04,0:23:38.46,Default,,0,0,0,,Мамо-чанның қояны бар.
Dialogue: 0,0:23:42.04,0:23:43.50,Default,,0,0,0,,Кішкентай ханым…
Dialogue: 0,0:23:43.59,0:23:46.26,Default,,0,0,0,,Мен қазір кішкентай емеспін.
Dialogue: 0,0:23:48.17,0:23:49.13,Default,,0,0,0,,Ханым
Dialogue: 0,0:23:49.63,0:23:50.55,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:23:52.39,0:23:54.81,Default,,0,0,0,,Элиос іздеп жүрген қыз...
Dialogue: 0,0:23:55.56,0:23:57.18,Default,,0,0,0,,Бұл шынымен...
Dialogue: 0,0:23:57.27,0:23:58.89,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:23:58.98,0:24:00.35,Default,,0,0,0,,Қыз...
Dialogue: 0,0:24:01.02,0:24:01.81,Default,,0,0,0,,Элиос!
Dialogue: 0,0:24:02.52,0:24:04.06,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:24:04.98,0:24:06.36,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:24:06.44,0:24:09.95,Default,,0,0,0,,Өйткені, сен мен іздеген қызсың.
Dialogue: 0,0:24:10.03,0:24:11.03,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:24:11.11,0:24:12.87,Default,,0,0,0,,Бұл жаудың ісі шығар...
Dialogue: 0,0:24:12.95,0:24:14.49,Default,,0,0,0,,Жау?
Dialogue: 0,0:24:14.58,0:24:17.33,Default,,0,0,0,,Бұл олардың ісі шығар.
Dialogue: 0,0:24:17.41,0:24:20.71,Default,,0,0,0,,Элиос, сен жау туралы білесің бе?
Dialogue: 0,0:24:20.79,0:24:22.29,Default,,0,0,0,,Сіз...
Dialogue: 0,0:24:23.04,0:24:24.34,Default,,0,0,0,,Мен...
Dialogue: 0,0:24:25.71,0:24:27.84,Default,,0,0,0,,Жоқ, қазір айта алмаймын.
Dialogue: 0,0:24:27.92,0:24:30.05,Default,,0,0,0,,Бірақ маған сеніңіз.
Dialogue: 0,0:24:30.13,0:24:32.34,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет.
Dialogue: 0,0:24:33.51,0:24:37.06,Default,,0,0,0,,Ай сәулесінен қорғалған әдемі армандар⸺
Dialogue: 0,0:24:37.14,0:24:38.85,Default,,0,0,0,,Ханшайым мен жауынгер...
Dialogue: 0,0:24:40.06,0:24:41.60,Default,,0,0,0,,Таңдалған қыз
Dialogue: 0,0:24:42.90,0:24:43.85,Default,,0,0,0,,Элиос!
Dialogue: 0,0:24:47.48,0:24:50.74,Default,,0,0,0,,Бұл қыз Элиос іздеп жүр ме?
Dialogue: 0,0:24:51.74,0:24:53.99,Default,,0,0,0,,Бұл шынымен мен бе?
Dialogue: 0,0:25:02.00,0:25:03.04,Default,,0,0,0,,Ханзада…
Dialogue: 0,0:25:04.04,0:25:05.54,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:25:06.29,0:25:08.75,Default,,0,0,0,,Элизиумды қорғау мүмкін емес
Dialogue: 0,0:25:08.84,0:25:10.63,Default,,0,0,0,,Тіпті сіздің денеңіз де...
Dialogue: 0,0:25:11.47,0:25:12.68,Default,,0,0,0,,Ханзада…
Dialogue: 0,0:25:14.84,0:25:15.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:19.39,0:25:20.35,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:25:26.56,0:25:28.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:28.40,0:25:31.94,Default,,0,0,0,,Джубан сауда ауданын қоршап тұрған бұл қалыпты емес аура...
Dialogue: 0,0:25:32.03,0:25:33.65,Default,,0,0,0,,Бұл шынымен де кедергі ме?
Dialogue: 0,0:25:33.74,0:25:34.95,Default,,0,0,0,,Ами…
Dialogue: 0,0:25:36.20,0:25:37.74,Default,,0,0,0,,Әрқашан жауға дайын бол
Dialogue: 0,0:25:37.83,0:25:40.41,Default,,0,0,0,,Сабырлы пайымдаулар жасай білу
Dialogue: 0,0:25:40.49,0:25:43.16,Default,,0,0,0,,Өйткені сен әркімнің миысың
Dialogue: 0,0:25:45.67,0:25:46.92,Default,,0,0,0,,Сецуна-сан…
Dialogue: 0,0:25:47.00,0:25:48.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:25:50.00,0:25:51.30,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:25:51.38,0:25:53.76,Default,,0,0,0,,Сіз әлі ояусыз ба? Сағат 1 болды
Dialogue: 0,0:25:53.84,0:25:55.09,Default,,0,0,0,,Кешкі ас ше?
Dialogue: 0,0:25:55.18,0:25:57.01,Default,,0,0,0,,Мен оны кездейсоқ жасап, жедім.
Dialogue: 0,0:25:58.26,0:26:00.64,Default,,0,0,0,,Сіз шынымен мықтысыз.
Dialogue: 0,0:26:00.72,0:26:04.23,Default,,0,0,0,,Бір жақсысы, мен саған үйде жалғыз қалуға рұқсат беремін.
Dialogue: 0,0:26:04.31,0:26:06.19,Default,,0,0,0,,Сіз ана болу құқығынан айырылдыңыз.
Dialogue: 0,0:26:06.27,0:26:07.27,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:26:08.73,0:26:10.82,Default,,0,0,0,,Менің әкем жапондық суретші
Dialogue: 0,0:26:10.90,0:26:13.49,Default,,0,0,0,,Анаммен бәрі жақсы болмады.
Dialogue: 0,0:26:15.20,0:26:19.28,Default,,0,0,0,,Менің туған күніме әкем әлі күнге дейін ашық хаттар жібереді.
Dialogue: 0,0:26:19.37,0:26:22.08,Default,,0,0,0,,Хехе... Әкем де мен туралы.
Dialogue: 0,0:26:22.16,0:26:25.87,Default,,0,0,0,,Мен тым қаталмын, бала сияқты емеспін деп айттыңыз ба?
Dialogue: 0,0:26:26.62,0:26:28.63,Default,,0,0,0,,Тора но Ме-чан♪
Dialogue: 0,0:26:29.59,0:26:31.38,Default,,0,0,0,,Така но Ме-чан♪
Dialogue: 0,0:26:31.46,0:26:34.34,Default,,0,0,0,,Және сүйкімді U-no-me-chan♪
Dialogue: 0,0:26:34.97,0:26:38.30,Default,,0,0,0,,Балалар, адам болғыларың келе ме?
Dialogue: 0,0:26:38.39,0:26:40.26,Default,,0,0,0,,(айқай)
Dialogue: 0,0:26:40.35,0:26:42.72,Default,,0,0,0,,Хехе, сен сондай ақылдысың.
Dialogue: 0,0:26:42.81,0:26:43.64,Default,,0,0,0,,Парапара!
Dialogue: 0,0:26:44.60,0:26:45.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:26:45.31,0:26:46.52,Default,,0,0,0,,Таманокоши!
Dialogue: 0,0:26:51.36,0:26:52.98,Default,,0,0,0,,Uso~!
Dialogue: 0,0:26:53.65,0:26:56.70,Default,,0,0,0,,Адам! Адам бейнесі!
Dialogue: 0,0:26:56.78,0:26:59.07,Default,,0,0,0,,Менің уақытым келді~
Dialogue: 0,0:26:59.16,0:27:01.49,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:27:01.58,0:27:05.29,Default,,0,0,0,,Біздің Өлі Ай циркінің ең маңызды сәті!
Dialogue: 0,0:27:05.37,0:27:08.46,Default,,0,0,0,,Жақсылық жасасаң, мені марапаттай аласың.
Dialogue: 0,0:27:08.54,0:27:11.29,Default,,0,0,0,,Бұл жолбарыстың көз арманы суретші
Dialogue: 0,0:27:11.38,0:27:12.34,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:27:13.13,0:27:16.42,Default,,0,0,0,,Ханымдар мен мырзалар, мұны Hawks Eye-ге қалдырыңыз.
Dialogue: 0,0:27:16.51,0:27:18.84,Default,,0,0,0,,Менің жасым жетпейді!
Dialogue: 0,0:27:18.93,0:27:21.14,Default,,0,0,0,,Fish Eye де қолынан келгеннің бәрін жасайды!
Dialogue: 0,0:27:21.22,0:27:22.39,Default,,0,0,0,,Эй!
Dialogue: 0,0:27:22.47,0:27:25.85,Default,,0,0,0,,Енді маған кім несие береді?
Dialogue: 0,0:27:25.93,0:27:27.56,Default,,0,0,0,,Уау
Dialogue: 0,0:27:27.64,0:27:30.77,Default,,0,0,0,,Алдымен мына балықтың көзіне қалдырыңыз!
Dialogue: 0,0:27:30.85,0:27:33.69,Default,,0,0,0,,Кел, айна, мені бейнеле.
Dialogue: 0,0:27:33.77,0:27:35.65,Default,,0,0,0,,Арманы көп, нұры барлар
Dialogue: 0,0:27:37.99,0:27:40.11,Default,,0,0,0,,Уух, таптым.
Dialogue: 0,0:27:40.20,0:27:43.37,Default,,0,0,0,,Судың ағынын басқаратын мен сияқты.
Dialogue: 0,0:27:47.83,0:27:50.25,Default,,0,0,0,,Осындай жерде тропикалық балық дүкені бар ма?
Dialogue: 0,0:27:51.04,0:27:53.46,Default,,0,0,0,,Ах... әдемі
Dialogue: 0,0:27:54.46,0:27:56.51,Default,,0,0,0,,Бұл суда жүргендей
Dialogue: 0,0:27:57.46,0:28:00.22,Default,,0,0,0,,Адамдар суды неліктен сағынады?
Dialogue: 0,0:28:00.30,0:28:03.18,Default,,0,0,0,,Бұл күйзелістің немесе көңілсіздіктің белгісі болса керек.
Dialogue: 0,0:28:03.26,0:28:04.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:04.26,0:28:06.56,Default,,0,0,0,,Біраз балық ұстасақ ше?
Dialogue: 0,0:28:06.64,0:28:08.52,Default,,0,0,0,,Мен бұл қызды өте ұсынамын.
Dialogue: 0,0:28:09.23,0:28:10.69,Default,,0,0,0,,Хех сүйкімді
Dialogue: 0,0:28:12.10,0:28:14.65,Default,,0,0,0,,Иә, анам да бақытты болуы мүмкін.
Dialogue: 0,0:28:14.73,0:28:15.61,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:19.28,0:28:20.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:20.49,0:28:23.16,Default,,0,0,0,,Әкем маған сыйлаған ашықхаттағы балыққа ұқсайды
Dialogue: 0,0:28:23.24,0:28:25.12,Default,,0,0,0,,Мама, таң қалдыңыз ба?
Dialogue: 0,0:28:30.83,0:28:32.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:33.38,0:28:34.25,Default,,0,0,0,,Ана?
Dialogue: 0,0:28:36.50,0:28:37.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:37.25,0:28:39.67,Default,,0,0,0,,Қызым, сен әлі ояу емессің бе?
Dialogue: 0,0:28:40.34,0:28:42.43,Default,,0,0,0,,Жалғыз қызығы оқу ғана болатын бала.
Dialogue: 0,0:28:42.51,0:28:45.18,Default,,0,0,0,,Оның маған қатысы жоқ, хехехе...
Dialogue: 0,0:28:50.31,0:28:51.06,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:28:52.52,0:28:54.02,Default,,0,0,0,,Ха... мен?
Dialogue: 0,0:28:54.69,0:28:56.73,Default,,0,0,0,,Әке, мен күнәмді айтуға келдім.
Dialogue: 0,0:28:56.82,0:28:58.61,Default,,0,0,0,,Анам жұмысқа кетті
Dialogue: 0,0:28:59.28,0:29:02.07,Default,,0,0,0,,Сіз тек оқуға қызығасыз, солай емес пе?
Dialogue: 0,0:29:02.15,0:29:03.49,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:29:04.62,0:29:05.57,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:29:05.66,0:29:07.87,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:29:07.95,0:29:10.08,Default,,0,0,0,,Мен анам мен әкем туралы ойлаймын...
Dialogue: 0,0:29:10.83,0:29:12.25,Default,,0,0,0,,Усаги-чан?
Dialogue: 0,0:29:12.33,0:29:14.54,Default,,0,0,0,,Үшеуміз әрқашан біргеміз.
Dialogue: 0,0:29:14.63,0:29:16.63,Default,,0,0,0,,Маған басқа ештеңе керек емес.
Dialogue: 0,0:29:16.71,0:29:17.34,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:29:17.42,0:29:20.30,Default,,0,0,0,,Хехе, үшеуің бақытты сияқтысыңдар.
Dialogue: 0,0:29:22.22,0:29:25.93,Default,,0,0,0,,Қараңдар, мен ұстанудың қажеті жоқ.
Dialogue: 0,0:29:26.01,0:29:28.72,Default,,0,0,0,,Қызғаныш болды ма? Сол үш адам
Dialogue: 0,0:29:28.81,0:29:32.52,Default,,0,0,0,,Маған шын мәнінде не ойлайтыныңызды айтыңыз, хехехе...
Dialogue: 0,0:29:32.60,0:29:34.69,Default,,0,0,0,,Иә, мен...
Dialogue: 0,0:29:35.35,0:29:37.06,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:29:37.15,0:29:39.48,Default,,0,0,0,,Кім екенің маңызды емес, біреудің сүйгенін қалайсың...
Dialogue: 0,0:29:39.57,0:29:40.99,Default,,0,0,0,,Ха... жоқ!
Dialogue: 0,0:29:41.82,0:29:44.49,Default,,0,0,0,,Мықты бол, Ами! Бұл галлюцинация!
Dialogue: 0,0:29:44.57,0:29:46.45,Default,,0,0,0,,Усаги-чан, сен мені естисің бе?
Dialogue: 0,0:29:46.53,0:29:48.91,Default,,0,0,0,,Ами-чан Ами-чан?
Dialogue: 0,0:29:48.99,0:29:49.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:49.99,0:29:50.91,Default,,0,0,0,,Ами-чан!
Dialogue: 0,0:29:51.00,0:29:53.16,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:29:54.67,0:29:55.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:55.62,0:29:56.88,Default,,0,0,0,,Хехе
Dialogue: 0,0:29:58.38,0:29:59.59,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:29:59.67,0:30:01.59,Default,,0,0,0,,О... аа!
Dialogue: 0,0:30:01.67,0:30:03.26,Default,,0,0,0,,Гү…
Dialogue: 0,0:30:05.76,0:30:08.18,Default,,0,0,0,,Бұл... қорқынышты түс.
Dialogue: 0,0:30:08.26,0:30:12.77,Default,,0,0,0,,Иә, бұл зұлым жын Лемураның тәтті түні.
Dialogue: 0,0:30:13.48,0:30:16.90,Default,,0,0,0,,Жылы түсте қайырлы түн
Dialogue: 0,0:30:18.52,0:30:19.57,Default,,0,0,0,,Жақсы сезінеді...
Dialogue: 0,0:30:20.94,0:30:23.82,Default,,0,0,0,,Маған осылай мәңгі ұйықтауға рұқсат етіңіз
Dialogue: 0,0:30:25.15,0:30:26.36,Default,,0,0,0,,Ханшайым…
Dialogue: 0,0:30:28.53,0:30:30.37,Default,,0,0,0,,Меркурий ханшайымы
Dialogue: 0,0:30:30.45,0:30:33.12,Default,,0,0,0,,Кім? мені кім шақырады
Dialogue: 0,0:30:35.21,0:30:37.08,Default,,0,0,0,,Ха... мен?
Dialogue: 0,0:30:37.17,0:30:40.17,Default,,0,0,0,,Иә, мен сенің қосарыңмын.
Dialogue: 0,0:30:40.25,0:30:43.09,Default,,0,0,0,,Оян, Меркурий ханшайым
Dialogue: 0,0:30:43.17,0:30:45.84,Default,,0,0,0,,Шынайы армандарыңызды есте сақтаңыз!
Dialogue: 0,0:30:45.92,0:30:48.97,Default,,0,0,0,,Менің... шын арманым?
Dialogue: 0,0:30:50.80,0:30:51.64,Default,,0,0,0,,Хехе
Dialogue: 0,0:30:52.81,0:30:54.43,Default,,0,0,0,,Иә
Dialogue: 0,0:30:54.52,0:30:55.52,Default,,0,0,0,,Маған
Dialogue: 0,0:30:55.60,0:30:57.90,Default,,0,0,0,,Мен жақсы көретін, жақсы көретін адамдар көп.
Dialogue: 0,0:30:58.77,0:31:01.82,Default,,0,0,0,,Сол адамдарды одан сайын жақсы көргім келеді
Dialogue: 0,0:31:01.90,0:31:02.78,Default,,0,0,0,,Мен сені қорғағым келеді
Dialogue: 0,0:31:03.53,0:31:05.44,Default,,0,0,0,,Сондықтан мен оқимын
Dialogue: 0,0:31:05.53,0:31:07.78,Default,,0,0,0,,Ал менің арманым...
Dialogue: 0,0:31:07.86,0:31:09.28,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:31:09.37,0:31:12.66,Default,,0,0,0,,Толық жауынгер болып, барлығын қорға
Dialogue: 0,0:31:13.29,0:31:14.50,Default,,0,0,0,,Не!
Dialogue: 0,0:31:14.58,0:31:16.00,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:31:16.08,0:31:18.00,Default,,0,0,0,,Бұл менің миссиям!
Dialogue: 0,0:31:19.58,0:31:23.25,Default,,0,0,0,,Меркурийлік кристалды күшті макияж!
Dialogue: 0,0:31:46.36,0:31:48.24,Default,,0,0,0,,Су жұлдызы!
Dialogue: 0,0:31:48.32,0:31:50.61,Default,,0,0,0,,Меркурийдің қамқоршысы болған білім жауынгері!
Dialogue: 0,0:31:51.70,0:31:53.28,Default,,0,0,0,,Теңізші Меркурий
Dialogue: 0,0:31:55.37,0:31:58.79,Default,,0,0,0,,Өзіңізді сумен жабыңыз және ойланыңыз!
Dialogue: 0,0:31:58.87,0:32:00.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:32:00.12,0:32:01.75,Default,,0,0,0,,Меркурий
Dialogue: 0,0:32:03.54,0:32:05.25,Default,,0,0,0,,Аква рапсодия
Dialogue: 0,0:32:08.92,0:32:10.30,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:32:10.38,0:32:11.30,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:32:11.80,0:32:14.18,Default,,0,0,0,,Лемрес қорқынышынан ояну!
Dialogue: 0,0:32:14.26,0:32:15.68,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:32:15.76,0:32:17.39,Default,,0,0,0,,Қоян! Чибиуса-чан!
Dialogue: 0,0:32:17.47,0:32:19.85,Default,,0,0,0,,Мұның бәрі трансформация туралы!
Dialogue: 0,0:32:19.94,0:32:20.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:20.98,0:32:25.82,Default,,0,0,0,,Ай дағдарысына арналған макияж!
Dialogue: 0,0:32:28.11,0:32:29.57,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:32:29.65,0:32:31.03,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:32:31.11,0:32:32.78,Default,,0,0,0,,♬~
Dialogue: 0,0:32:35.58,0:32:37.49,Default,,0,0,0,,Кеттік, Чиби Мун!
Dialogue: 0,0:32:39.12,0:32:45.00,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,0:32:47.88,0:32:50.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:51.34,0:32:52.72,Default,,0,0,0,,Балық көзі!
Dialogue: 0,0:32:52.80,0:32:55.93,Default,,0,0,0,,Менің Гякудама техникамды бұзуға қалай дәтің бар...
Dialogue: 0,0:32:56.01,0:32:58.06,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:32:59.48,0:33:00.89,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:33:00.98,0:33:03.85,Default,,0,0,0,,Екеуіңіз де бастапқы пішіндеріңізге оралдыңыздар!
Dialogue: 0,0:33:04.48,0:33:07.15,Default,,0,0,0,,Барлығына әрқашан қажет⸺
Dialogue: 0,0:33:07.23,0:33:08.90,Default,,0,0,0,,Күшті және әдемі қоян
Dialogue: 0,0:33:08.98,0:33:10.78,Default,,0,0,0,,Уау, сен істедің!
Dialogue: 0,0:33:10.86,0:33:12.70,Default,,0,0,0,,Мен білдім...
Dialogue: 0,0:33:12.78,0:33:15.91,Default,,0,0,0,,Бізде бірдей фантомдық күміс кристалы болса да
Dialogue: 0,0:33:15.99,0:33:17.83,Default,,0,0,0,,Сізде бірдей элемент болса да
Dialogue: 0,0:33:18.95,0:33:20.91,Default,,0,0,0,,Менен мүлдем басқасың.
Dialogue: 0,0:33:21.41,0:33:23.33,Default,,0,0,0,,Twinkle Ale!
Dialogue: 0,0:33:24.75,0:33:25.71,Default,,0,0,0,,Қыз...
Dialogue: 0,0:33:25.79,0:33:28.59,Default,,0,0,0,,Элиос Бұл сөзсіз басқаша.
Dialogue: 0,0:33:28.67,0:33:32.34,Default,,0,0,0,,Элиос іздеп жүрген қыз мен емес!
Dialogue: 0,0:33:32.42,0:33:35.01,Default,,0,0,0,,Елиос қыз іздеп жүр?
Dialogue: 0,0:33:35.09,0:33:37.64,Default,,0,0,0,,Мен іздеп жүрген қыз қандай?
Dialogue: 0,0:33:37.72,0:33:39.52,Default,,0,0,0,,Әдемі армандар көр
Dialogue: 0,0:33:39.60,0:33:42.85,Default,,0,0,0,,Ай жарығымен қорғалған ханшайым мен жауынгер
Dialogue: 0,0:33:42.94,0:33:46.40,Default,,0,0,0,,Алтын кристалдың мөрін бұзатын қасиетті тас бар.
Dialogue: 0,0:33:46.48,0:33:48.52,Default,,0,0,0,,Таңдалған қыз туралы
Dialogue: 0,0:33:50.53,0:33:53.57,Default,,0,0,0,,Жоқ, ол қыз Сейлор Мун...
Dialogue: 0,0:33:53.65,0:33:56.41,Default,,0,0,0,,Жоқ. Сіз Тыныштық ханшайымын айтып тұрсыз ба?
Dialogue: 0,0:33:56.49,0:33:58.49,Default,,0,0,0,,Сейлор Мун
Dialogue: 0,0:33:58.58,0:34:00.41,Default,,0,0,0,,Сіз Серенити ханшайымсыз ба?
Dialogue: 0,0:34:01.08,0:34:01.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:02.00,0:34:03.54,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:34:05.87,0:34:07.88,Default,,0,0,0,,«Уа, қыз»
Dialogue: 0,0:34:07.96,0:34:12.09,Default,,0,0,0,,Мені осылай атағанына қытықтап, қуандым.
Dialogue: 0,0:34:12.17,0:34:15.13,Default,,0,0,0,,Бірақ сізге керек мен емес
Dialogue: 0,0:34:16.47,0:34:19.89,Default,,0,0,0,,Жоқ, мен кішкентаймын және күшім жоқ.
Dialogue: 0,0:34:20.64,0:34:21.64,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:34:21.72,0:34:22.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:34:22.64,0:34:24.81,Default,,0,0,0,,Ах... Элиос
Dialogue: 0,0:34:26.19,0:34:30.48,Default,,0,0,0,,Бәлкім бір күні мен де керек болармын
Dialogue: 0,0:34:31.32,0:34:34.24,Default,,0,0,0,,Өсіп, жақсы жауынгер бол
Dialogue: 0,0:34:34.32,0:34:35.95,Default,,0,0,0,,Керемет ханымға...
Dialogue: 0,0:34:37.24,0:34:41.12,Default,,0,0,0,,Мүмкін бір күні менің арманым орындалатын шығар
Dialogue: 0,0:34:47.58,0:34:48.96,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:34:51.92,0:34:52.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:01.26,0:35:04.18,Default,,0,0,0,,Жылама, кішкентай қыз
Dialogue: 0,0:35:04.85,0:35:07.39,Default,,0,0,0,,Сіз әрқашан сұранысқа иесіз
Dialogue: 0,0:35:07.94,0:35:11.94,Default,,0,0,0,,Махаббат айналаңда
Dialogue: 0,0:35:12.02,0:35:13.53,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:35:14.94,0:35:17.20,Default,,0,0,0,,Бұл формада бұл шек...
Dialogue: 0,0:35:18.03,0:35:19.49,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,0:35:19.57,0:35:21.37,Default,,0,0,0,,Мен міндетті түрде тағы да кездесуге келемін.
Dialogue: 0,0:35:21.45,0:35:23.04,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:35:23.12,0:35:25.66,Default,,0,0,0,,Чибиуса~! (Ами) Чибиуса-чан!
Dialogue: 0,0:35:25.75,0:35:28.62,Default,,0,0,0,,Чибиуса! Ха ха ха...
Dialogue: 0,0:35:29.79,0:35:30.88,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:35:31.88,0:35:33.55,Default,,0,0,0,,Мен суық тигіземін. Үйге барайық.
Dialogue: 0,0:35:34.96,0:35:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:35.67,0:35:36.92,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:35:37.01,0:35:37.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:39.22,0:35:40.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:40.34,0:35:42.10,Default,,0,0,0,,Элиос…
Dialogue: 0,0:35:42.18,0:35:43.76,Default,,0,0,0,,Бұл Элиос па?
Dialogue: 0,0:35:53.44,0:35:55.11,Default,,0,0,0,,А... а...
Dialogue: 0,0:35:55.19,0:35:56.07,Default,,0,0,0,,Хо…
Dialogue: 0,0:35:56.86,0:35:59.66,Default,,0,0,0,,Мен сиқырымнан құтыламын деп ешқашан ойламадым.
Dialogue: 0,0:35:59.74,0:36:01.45,Default,,0,0,0,,Үлкен мәселе сияқты
Dialogue: 0,0:36:01.53,0:36:05.54,Default,,0,0,0,,Бірақ сіз және бұл жер менікісіз.
Dialogue: 0,0:36:06.70,0:36:10.75,Default,,0,0,0,,Ақырында жер бетіндегі бәрі менікі болады.
Dialogue: 0,0:36:11.63,0:36:14.55,Default,,0,0,0,,Мен сенің қалағаныңды істегеніңді кешірмеймін. Кукукуку...
Dialogue: 0,0:36:15.05,0:36:18.09,Default,,0,0,0,,Осы жер мен денені басып алса да
Dialogue: 0,0:36:18.17,0:36:20.97,Default,,0,0,0,,Тіпті менің жүрегім әлі басқарылмайды!
Dialogue: 0,0:36:21.64,0:36:23.76,Default,,0,0,0,,Сен зұлым ханзада.
Dialogue: 0,0:36:23.85,0:36:26.52,Default,,0,0,0,,Ал ханшайым оны міндетті түрде өшіреді.
Dialogue: 0,0:36:27.10,0:36:28.68,Default,,0,0,0,,Қарғыс атсын... арсыз!
Dialogue: 0,0:36:28.77,0:36:29.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:31.02,0:36:33.06,Default,,0,0,0,,Алтын кристалды тез алыңыз
Dialogue: 0,0:36:33.15,0:36:34.52,Default,,0,0,0,,Мен оны іздеуім керек.
Dialogue: 0,0:36:34.61,0:36:36.82,Default,,0,0,0,,Тіпті бұл планета...
Dialogue: 0,0:36:44.91,0:36:46.83,Default,,0,0,0,,Хино, не болды?
Dialogue: 0,0:36:46.91,0:36:48.50,Default,,0,0,0,,Жебе адасып бара жатқан сияқты.
Dialogue: 0,0:36:49.71,0:36:50.58,Default,,0,0,0,,Жоғалған...
Dialogue: 0,0:36:50.66,0:36:52.04,Default,,0,0,0,,Рэй-чан
Dialogue: 0,0:36:52.12,0:36:55.34,Default,,0,0,0,,Осылай істегенде, Ами-чанға ұқсайсың.
Dialogue: 0,0:36:55.42,0:36:56.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:56.21,0:36:57.88,Default,,0,0,0,,Ғибадатхананы басқару заңы?
Dialogue: 0,0:36:57.96,0:36:59.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:59.13,0:37:00.01,Default,,0,0,0,,Хаа…
Dialogue: 0,0:37:00.09,0:37:02.72,Default,,0,0,0,,Ата суық тиіп, құлап қалды.
Dialogue: 0,0:37:02.80,0:37:06.56,Default,,0,0,0,,Әлем рецессияда, сондықтан мен тиімді басқару әдісін іздеймін.
Dialogue: 0,0:37:06.64,0:37:08.18,Default,,0,0,0,,Мен біреуді жалдасам ше?
Dialogue: 0,0:37:08.27,0:37:10.14,Default,,0,0,0,,Жоқ! Еңбек құны жоғары!
Dialogue: 0,0:37:10.23,0:37:13.35,Default,,0,0,0,,Ондай жағдайда күйеу баланы тез асырап алсақ қайтеді?
Dialogue: 0,0:37:13.44,0:37:14.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:14.44,0:37:18.40,Default,,0,0,0,,Мен Рей-чанның еркектерді жек көретінін жақсы білемін.
Dialogue: 0,0:37:18.48,0:37:21.57,Default,,0,0,0,,Мәселе мынада, сіз үйленгенмін деп ойлаудың қажеті жоқ.
Dialogue: 0,0:37:21.65,0:37:22.49,Default,,0,0,0,,Ғибадатхана үшін
Dialogue: 0,0:37:22.57,0:37:25.03,Default,,0,0,0,,Сізге біреу тегін келді деп ойлаңыз.
Dialogue: 0,0:37:25.12,0:37:27.24,Default,,0,0,0,,Ғибадатханадағы барлық жұмыстарды орындаңыз.
Dialogue: 0,0:37:27.33,0:37:29.16,Default,,0,0,0,,Рей-чан өз өмірін өзіне ұнайтын іспен өткізеді.
Dialogue: 0,0:37:29.75,0:37:31.58,Default,,0,0,0,,Мені тек қызметші деп ойлаңыз.
Dialogue: 0,0:37:31.66,0:37:33.54,Default,,0,0,0,,Қызметші... жақсы шығар
Dialogue: 0,0:37:33.62,0:37:37.04,Default,,0,0,0,,Екеуміз де оқушыға ұқсас бірдеңе айтсақ ше?
Dialogue: 0,0:37:37.13,0:37:38.67,Default,,0,0,0,,Студентке ұқсас нәрселер туралы айтсақ!
Dialogue: 0,0:37:39.30,0:37:41.17,Default,,0,0,0,,Мен жігітті қалаймын~
Dialogue: 0,0:37:41.26,0:37:42.93,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:37:43.01,0:37:46.51,Default,,0,0,0,,Әй, бұл мектеп оқушысының шын тілегі!
Dialogue: 0,0:37:46.60,0:37:47.26,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:37:47.35,0:37:49.81,Default,,0,0,0,,Ертең «Өлі Ай» циркінің қойылымының бірінші күні.
Dialogue: 0,0:37:50.64,0:37:51.56,Default,,0,0,0,,Міне, ақыры!
Dialogue: 0,0:37:51.64,0:37:52.81,Default,,0,0,0,,Кез келген уақытта жақсы!
Dialogue: 0,0:37:52.89,0:37:54.94,Default,,0,0,0,,Хм, менің де уақытым келді.
Dialogue: 0,0:37:55.02,0:37:56.77,Default,,0,0,0,,Одабутсу...
Dialogue: 0,0:37:56.86,0:37:58.65,Default,,0,0,0,,Наму Амида Бутсу.
Dialogue: 0,0:37:58.73,0:38:01.86,Default,,0,0,0,,Ата, біздің үй – киелі үй.
Dialogue: 0,0:38:01.94,0:38:03.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:38:03.40,0:38:05.57,Default,,0,0,0,,Маған екі теңдестіру думанын беріңізші.
Dialogue: 0,0:38:05.66,0:38:06.78,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:38:08.08,0:38:09.49,Default,,0,0,0,,Өтінемін (жоғары сынып қызы А) Рахмет.
Dialogue: 0,0:38:09.58,0:38:12.16,Default,,0,0,0,,Мен ағама ғашық болсам ғой.
Dialogue: 0,0:38:12.25,0:38:13.46,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр!
Dialogue: 0,0:38:13.54,0:38:16.96,Default,,0,0,0,,Сіз шынымен жігітті қатты қалайсыз ба?
Dialogue: 0,0:38:17.04,0:38:18.42,Default,,0,0,0,,Мен мұны қалаймын!
Dialogue: 0,0:38:20.84,0:38:22.38,Default,,0,0,0,,Менің арманым келін болу!
Dialogue: 0,0:38:23.01,0:38:24.68,Default,,0,0,0,,Менің арманым дәрігер болу
Dialogue: 0,0:38:24.76,0:38:27.18,Default,,0,0,0,,Менің арманым – кумир болу!
Dialogue: 0,0:38:27.26,0:38:28.64,Default,,0,0,0,,Мен...
Dialogue: 0,0:38:29.64,0:38:32.18,Default,,0,0,0,,Ата жолын жалғастыр
Dialogue: 0,0:38:32.27,0:38:33.98,Default,,0,0,0,,Хикава храмының бас діни қызметкері бол
Dialogue: 0,0:38:34.81,0:38:36.90,Default,,0,0,0,,Мен бұл қалыпты деп ойладым.
Dialogue: 0,0:38:37.60,0:38:40.65,Default,,0,0,0,,Бірақ менің арманым...
Dialogue: 0,0:38:40.73,0:38:41.90,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:38:48.45,0:38:50.37,Default,,0,0,0,,Бүгін жебе адасып бара жатқан сияқты.
Dialogue: 0,0:39:01.63,0:39:03.34,Default,,0,0,0,,Рей осы ғибадатханаға келді
Dialogue: 0,0:39:03.42,0:39:06.30,Default,,0,0,0,,Менің ойымша, бұл бастауыш мектепке барғанға дейін болды.
Dialogue: 0,0:39:07.55,0:39:10.51,Default,,0,0,0,,Атаның бақшасында қарға бар ма?
Dialogue: 0,0:39:10.60,0:39:12.97,Default,,0,0,0,,Көптеген қалалар бар.
Dialogue: 0,0:39:13.06,0:39:14.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:14.73,0:39:17.14,Default,,0,0,0,,Фобос! Димос!
Dialogue: 0,0:39:17.23,0:39:18.06,Default,,0,0,0,,Рэй!
Dialogue: 0,0:39:18.15,0:39:21.48,Default,,0,0,0,,Бұл балалардың есімдері Фобос пен Деймос.
Dialogue: 0,0:39:21.57,0:39:23.11,Default,,0,0,0,,Осылайша шешілді.
Dialogue: 0,0:39:23.65,0:39:26.32,Default,,0,0,0,,Ол әрқашан жұмбақ бала болды.
Dialogue: 0,0:39:27.66,0:39:30.95,Default,,0,0,0,,Рэй, бір күні сен бұл жерден кетесің.
Dialogue: 0,0:39:31.03,0:39:35.00,Default,,0,0,0,,Сіз болу керек жерге ұшып кетесіз.
Dialogue: 0,0:39:35.08,0:39:39.46,Default,,0,0,0,,Мен қашан, қайда екенін білмеймін.
Dialogue: 0,0:39:40.83,0:39:42.04,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:39:43.75,0:39:45.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:45.13,0:39:47.13,Default,,0,0,0,,Өлі ай тамаша цирк шоуы!
Dialogue: 0,0:39:47.22,0:39:49.68,Default,,0,0,0,,Билеттерді алу үшін осы жерді басыңыз
Dialogue: 0,0:39:49.76,0:39:52.05,Default,,0,0,0,,Ішінде жылжымалы ойын-сауық саябағы да бар.
Dialogue: 0,0:39:52.81,0:39:54.26,Default,,0,0,0,,S орны 10 000 иен?
Dialogue: 0,0:39:54.35,0:39:55.89,Default,,0,0,0,,Қымбат! Бұл алаяқтық!
Dialogue: 0,0:39:55.98,0:39:58.23,Default,,0,0,0,,Одан да күдікті! өлі ай циркі
Dialogue: 0,0:39:58.31,0:40:00.77,Default,,0,0,0,,Мен айналама қараймын.
Dialogue: 0,0:40:00.85,0:40:01.65,Default,,0,0,0,,Жарайды
Dialogue: 0,0:40:01.73,0:40:03.73,Default,,0,0,0,,Уау, ойнайтын нәрсе өте көп!
Dialogue: 0,0:40:03.82,0:40:05.78,Default,,0,0,0,,Әй, сен мұнда ойнауға келмедің.
Dialogue: 0,0:40:05.86,0:40:08.49,Default,,0,0,0,,Мамо-чан, азғантай картаға мінейік.
Dialogue: 0,0:40:08.57,0:40:10.07,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:40:10.16,0:40:11.95,Default,,0,0,0,,Бұл жай ғана ойын емес.
Dialogue: 0,0:40:12.53,0:40:14.49,Default,,0,0,0,,Бұл орынсыз.
Dialogue: 0,0:40:14.58,0:40:17.62,Default,,0,0,0,,Мен де Фобос пен Деймосты әдейі алып келдім.
Dialogue: 0,0:40:17.71,0:40:19.83,Default,,0,0,0,,Біз де барлаушыларға барайық.
Dialogue: 0,0:40:19.92,0:40:20.96,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:40:21.04,0:40:23.13,Default,,0,0,0,,Ха... Мен балмұздақ сататын дүңгіршек таптым!
Dialogue: 0,0:40:23.21,0:40:25.46,Default,,0,0,0,,А... Минако-чан, барлаушы!
Dialogue: 0,0:40:25.55,0:40:27.09,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:40:27.17,0:40:28.63,Default,,0,0,0,,Рей-чан не істейді?
Dialogue: 0,0:40:28.72,0:40:31.80,Default,,0,0,0,,Мен мұнда келген-кеткендерді қадағалаймын.
Dialogue: 0,0:40:31.89,0:40:33.64,Default,,0,0,0,,Жарайды, мен бірден қайтамын.
Dialogue: 0,0:40:33.72,0:40:35.01,Default,,0,0,0,,Бұл соншалықты қызықты болды ма?
Dialogue: 0,0:40:35.10,0:40:35.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:36.47,0:40:37.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:40:38.10,0:40:40.94,Default,,0,0,0,,Бірақ мен бұлай сезінгеніме біраз уақыт болды
Dialogue: 0,0:40:41.02,0:40:42.15,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:40:42.23,0:40:44.77,Default,,0,0,0,,Өйткені бұл цирк.
Dialogue: 0,0:40:44.86,0:40:45.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:46.53,0:40:47.69,Default,,0,0,0,,Айналы үй?
Dialogue: 0,0:40:50.57,0:40:53.16,Default,,0,0,0,,Көңілді болды (Ұ) Иә.
Dialogue: 0,0:40:54.24,0:40:55.45,Default,,0,0,0,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:40:57.33,0:40:58.91,Default,,0,0,0,,Кекекеке…
Dialogue: 0,0:41:03.75,0:41:05.75,Default,,0,0,0,,Ол бірден басталды!
Dialogue: 0,0:41:05.84,0:41:09.21,Default,,0,0,0,,Айна үйіне бір адам шақырылады.
Dialogue: 0,0:41:10.47,0:41:11.63,Default,,0,0,0,,Джокукио!
Dialogue: 0,0:41:17.89,0:41:19.43,Default,,0,0,0,,(айқай)
Dialogue: 0,0:41:26.52,0:41:28.44,Default,,0,0,0,,Ештеңені көрсетпейтін айна?
Dialogue: 0,0:41:29.23,0:41:31.24,Default,,0,0,0,,Қызық, қандай қулық бар?
Dialogue: 0,0:41:31.32,0:41:34.66,Default,,0,0,0,,Уайымдамаңыз! Ешқандай тұқым немесе айла жоқ.
Dialogue: 0,0:41:34.74,0:41:35.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:35.62,0:41:37.74,Default,,0,0,0,,Танысқаныма қуаныштымын «мен»
Dialogue: 0,0:41:37.83,0:41:39.50,Default,,0,0,0,,Иә! мен?
Dialogue: 0,0:41:39.58,0:41:44.08,Default,,0,0,0,,Енді мен саған жүрегіңде не бар екенін көрсетемін.
Dialogue: 0,0:41:44.17,0:41:46.46,Default,,0,0,0,,Жоқ! Бұл жау...
Dialogue: 0,0:41:46.54,0:41:47.46,Default,,0,0,0,,Күлкі
Dialogue: 0,0:41:48.21,0:41:51.42,Default,,0,0,0,,Қараңдаршы, анам ерте қайтыс болды.
Dialogue: 0,0:41:51.51,0:41:53.76,Default,,0,0,0,,Әкем саяси жұмыстармен айналысады.
Dialogue: 0,0:41:53.84,0:41:56.80,Default,,0,0,0,,Мені атамның үйіне қалдырыңыз.
Dialogue: 0,0:41:56.89,0:41:59.26,Default,,0,0,0,,Жастайыңнан бақытсыз болсаң керек.
Dialogue: 0,0:41:59.35,0:42:00.35,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:42:01.02,0:42:02.73,Default,,0,0,0,,Мен бақытты болғым келеді
Dialogue: 0,0:42:04.48,0:42:07.15,Default,,0,0,0,,Зұлым рухтар қуылды!
Dialogue: 0,0:42:08.65,0:42:09.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:42:10.57,0:42:11.99,Default,,0,0,0,,Ал...
Dialogue: 0,0:42:12.57,0:42:14.82,Default,,0,0,0,,Кейде өзіңе ұнамайтын адаммен
Dialogue: 0,0:42:14.91,0:42:16.82,Default,,0,0,0,,Мен сені бір-екі сүйемін.
Dialogue: 0,0:42:17.78,0:42:19.24,Default,,0,0,0,,Бірақ түпкі мақсат
Dialogue: 0,0:42:19.33,0:42:22.16,Default,,0,0,0,,Бай адамға тұрмысқа шығу
Dialogue: 0,0:42:22.25,0:42:23.87,Default,,0,0,0,,Өмір бойы бақытты өмір сүріңіз
Dialogue: 0,0:42:23.96,0:42:25.10,Default,,0,0,0,,Әйел бақыты деген осы
Dialogue: 0,0:42:25.10,0:42:25.33,Default,,0,0,0,,Әйел бақыты деген осы. Ғибадатхананың бас діни қызметкері болу әзіл емес.
Dialogue: 0,0:42:25.33,0:42:28.54,Default,,0,0,0,,Ғибадатхананың бас діни қызметкері болу әзіл емес.
Dialogue: 0,0:42:28.63,0:42:30.88,Default,,0,0,0,,Мұндай жерде ұзақ тұрудың қажеті жоқ!
Dialogue: 0,0:42:31.80,0:42:34.38,Default,,0,0,0,,Марс жұлдызының қуаты…
Dialogue: 0,0:42:34.47,0:42:35.97,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:42:38.01,0:42:39.35,Default,,0,0,0,,Өзгерту мүмкін емес!
Dialogue: 0,0:42:40.10,0:42:42.02,Default,,0,0,0,,Сіз қате түрлендіру заклинасын қолдандыңыз ба?
Dialogue: 0,0:42:42.10,0:42:43.73,Default,,0,0,0,,Ах... Трансформация...
Dialogue: 0,0:42:44.56,0:42:46.56,Default,,0,0,0,,Нені түрлендіру керек...
Dialogue: 0,0:42:47.06,0:42:50.98,Default,,0,0,0,,Мен... не іздедім?
Dialogue: 0,0:42:53.86,0:42:55.36,Default,,0,0,0,,Хехехе
Dialogue: 0,0:42:55.45,0:42:57.57,Default,,0,0,0,,Кел, Лемрес-чан!
Dialogue: 0,0:42:57.66,0:43:00.28,Default,,0,0,0,,Әдемі арманы бар мына байғұс қыз
Dialogue: 0,0:43:00.37,0:43:02.79,Default,,0,0,0,,Тәніңіз бен жаныңыз болсын
Dialogue: 0,0:43:02.87,0:43:05.75,Default,,0,0,0,,Кекекекекеке…
Dialogue: 0,0:43:05.83,0:43:06.71,Default,,0,0,0,,Мияу!
Dialogue: 0,0:43:06.79,0:43:08.25,Default,,0,0,0,,Мысықтар жоқ.
Dialogue: 0,0:43:08.33,0:43:09.34,Default,,0,0,0,,Міне!
Dialogue: 0,0:43:09.42,0:43:10.21,Default,,0,0,0,,Хмф! (3 жануар) Мияу!
Dialogue: 0,0:43:10.29,0:43:11.96,Default,,0,0,0,,Тынш! Тынш!
Dialogue: 0,0:43:13.01,0:43:14.30,Default,,0,0,0,,Енді.
Dialogue: 0,0:43:14.38,0:43:17.38,Default,,0,0,0,,Өлі Ай циркінің басталатын уақыты келді.
Dialogue: 0,0:43:23.31,0:43:24.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:43:24.81,0:43:26.19,Default,,0,0,0,,Ухухухуху
Dialogue: 0,0:43:31.69,0:43:32.61,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:43:35.36,0:43:36.57,Default,,0,0,0,,Эххе
Dialogue: 0,0:43:37.24,0:43:39.11,Default,,0,0,0,,Хе, ха!
Dialogue: 0,0:43:40.07,0:43:40.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:41.41,0:43:43.62,Default,,0,0,0,,Кекекеке!
Dialogue: 0,0:43:43.70,0:43:45.08,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:43:45.70,0:43:50.54,Default,,0,0,0,,Нехеления көбірек, қайта тірілу үшін күш!
Dialogue: 0,0:43:50.63,0:43:53.75,Default,,0,0,0,,Адамдар үшін қорқынышты армандар!
Dialogue: 0,0:43:54.46,0:43:55.63,Default,,0,0,0,,Аспаз…
Dialogue: 0,0:43:55.71,0:43:57.84,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:44:00.76,0:44:01.76,Default,,0,0,0,,Хунда!
Dialogue: 0,0:44:01.85,0:44:03.89,Default,,0,0,0,,Біз бәрібір мысықпыз!
Dialogue: 0,0:44:03.97,0:44:05.52,Default,,0,0,0,,Мен циркті көргім келді.
Dialogue: 0,0:44:05.60,0:44:07.14,Default,,0,0,0,,(айқай)
Dialogue: 0,0:44:09.35,0:44:10.48,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:44:11.02,0:44:13.77,Default,,0,0,0,,Бұрын мұндай ғимарат болмаған.
Dialogue: 0,0:44:16.69,0:44:17.86,Default,,0,0,0,,Хехехе
Dialogue: 0,0:44:17.95,0:44:20.07,Default,,0,0,0,,Менің ойымша, тамақ ішетін уақыт келді.
Dialogue: 0,0:44:22.62,0:44:23.62,Default,,0,0,0,,Ха... Жарайды!
Dialogue: 0,0:44:26.58,0:44:27.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:44:29.16,0:44:30.71,Default,,0,0,0,,Марс…
Dialogue: 0,0:44:31.33,0:44:33.09,Default,,0,0,0,,Марс ханшайымы!
Dialogue: 0,0:44:33.79,0:44:36.01,Default,,0,0,0,,Хмм... кім?
Dialogue: 0,0:44:42.22,0:44:43.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:44.76,0:44:46.14,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:46.97,0:44:49.14,Default,,0,0,0,,Мұндай техникаға алданып қалу
Dialogue: 0,0:44:49.23,0:44:50.98,Default,,0,0,0,,Маған не болды!
Dialogue: 0,0:44:51.73,0:44:53.15,Default,,0,0,0,,Сен мықты болуың керек!
Dialogue: 0,0:44:53.77,0:44:56.90,Default,,0,0,0,,Бұл біздің Марс ханшайымымыз!
Dialogue: 0,0:44:57.78,0:44:58.82,Default,,0,0,0,,Балалар...
Dialogue: 0,0:44:59.40,0:45:00.78,Default,,0,0,0,,Мен Фобоспын
Dialogue: 0,0:45:00.86,0:45:02.16,Default,,0,0,0,,Мен Димоспын
Dialogue: 0,0:45:02.24,0:45:03.95,Default,,0,0,0,,Енді түрлендіру!
Dialogue: 0,0:45:04.03,0:45:06.62,Default,,0,0,0,,Сіздің Марс Кристаллыңыз!
Dialogue: 0,0:45:08.37,0:45:09.66,Default,,0,0,0,,Марс кристалы…
Dialogue: 0,0:45:12.92,0:45:14.59,Default,,0,0,0,,Менің кристалым!
Dialogue: 0,0:45:15.79,0:45:20.01,Default,,0,0,0,,Mars Crystal Power Макияж!
Dialogue: 0,0:45:47.41,0:45:48.79,Default,,0,0,0,,От жұлдызы!
Dialogue: 0,0:45:48.87,0:45:51.75,Default,,0,0,0,,Марстың қамқоршысы болған жауынгер!
Dialogue: 0,0:45:52.58,0:45:53.87,Default,,0,0,0,,Теңізші Марс!
Dialogue: 0,0:45:55.63,0:45:59.00,Default,,0,0,0,,Марс атынан жазалау!
Dialogue: 0,0:45:59.88,0:46:00.92,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:46:01.67,0:46:05.30,Default,,0,0,0,,Ах! Денемнен жалындар өтіп жатыр
Dialogue: 0,0:46:05.39,0:46:08.10,Default,,0,0,0,,Сізді не қызықтырды?
Dialogue: 0,0:46:08.18,0:46:12.81,Default,,0,0,0,,Мен Серенити ханшайымына тазалығымды ант еткен отты жауынгермін.
Dialogue: 0,0:46:13.52,0:46:17.15,Default,,0,0,0,,Ханшайымды, осы планетаны және менің достарымды қорғау.
Dialogue: 0,0:46:17.23,0:46:18.65,Default,,0,0,0,,Мен күресемін!
Dialogue: 0,0:46:18.73,0:46:20.48,Default,,0,0,0,,Бұл менің арманым!
Dialogue: 0,0:46:23.49,0:46:24.57,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:46:24.66,0:46:27.41,Default,,0,0,0,,Менің арманым суретші болу!
Dialogue: 0,0:46:27.49,0:46:28.41,Default,,0,0,0,,Ахаха~
Dialogue: 0,0:46:28.49,0:46:30.41,Default,,0,0,0,,Уау! Ахх!
Dialogue: 0,0:46:31.37,0:46:33.66,Default,,0,0,0,,Бұл көркем эго…
Dialogue: 0,0:46:34.25,0:46:37.67,Default,,0,0,0,,Қайсысы нағыз мен екенін айта аласыз ба?
Dialogue: 0,0:46:38.38,0:46:39.13,Default,,0,0,0,,Тс!
Dialogue: 0,0:46:40.71,0:46:42.05,Default,,0,0,0,,Бұл өте күлкілі.
Dialogue: 0,0:46:43.26,0:46:47.26,Default,,0,0,0,,Сізде жүйкелер мен сезімдер жоғары дамыған.
Dialogue: 0,0:46:47.34,0:46:50.35,Default,,0,0,0,,Жау сені пайдаланып қалса
Dialogue: 0,0:46:50.43,0:46:53.27,Default,,0,0,0,,Жүрегіңдегі бір жіпті қатайт
Dialogue: 0,0:46:53.77,0:46:55.60,Default,,0,0,0,,Ал шын жүректен
Dialogue: 0,0:46:55.69,0:46:58.31,Default,,0,0,0,,Аяқтау көрсеткісін атыңыз
Dialogue: 0,0:46:58.40,0:46:59.48,Default,,0,0,0,,Марс!
Dialogue: 0,0:47:03.90,0:47:05.61,Default,,0,0,0,,Жалын снайпері!
Dialogue: 0,0:47:10.28,0:47:14.62,Default,,0,0,0,,Уф... Менің арманым суретші болу!
Dialogue: 0,0:47:15.66,0:47:17.58,Default,,0,0,0,,Кекекеке…
Dialogue: 0,0:47:18.42,0:47:19.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:24.63,0:47:26.05,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:47:26.13,0:47:28.18,Default,,0,0,0,,Жолбарыстың көзі жойылды ма?
Dialogue: 0,0:47:28.26,0:47:32.26,Default,,0,0,0,,Қайғы~ Тағы!
Dialogue: 0,0:47:33.22,0:47:35.23,Default,,0,0,0,,Неге... неге бұл тек мен?
Dialogue: 0,0:47:35.31,0:47:37.14,Default,,0,0,0,,Жалғыз карта?
Dialogue: 0,0:47:37.23,0:47:38.85,Default,,0,0,0,,Және үш рет
Dialogue: 0,0:47:38.94,0:47:40.31,Default,,0,0,0,,Ол қазірдің өзінде жоғары сынып оқушысы.
Dialogue: 0,0:47:40.40,0:47:42.69,Default,,0,0,0,,Сіз өз бетіңізше міне аласыз, солай ма?
Dialogue: 0,0:47:42.78,0:47:43.86,Default,,0,0,0,,Сіз әрқашан болдыңыз
Dialogue: 0,0:47:43.94,0:47:46.90,Default,,0,0,0,,Мамо-чан, менің ойымша, мұның барлығын өзіме сақтап қойғандықтан шығар!
Dialogue: 0,0:47:46.99,0:47:49.11,Default,,0,0,0,,Ақыр соңында, жігітіңмен осындай жерге келу керек емес пе?
Dialogue: 0,0:47:49.20,0:47:50.95,Default,,0,0,0,,Бұл жақсы (Ами) Хаа...
Dialogue: 0,0:47:51.03,0:47:51.99,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:47:52.08,0:47:53.37,Default,,0,0,0,,Рей-чан?
Dialogue: 0,0:47:54.45,0:47:56.37,Default,,0,0,0,,Жау пайда болып, сіз соғысып жатырсыз ба?
Dialogue: 0,0:47:56.46,0:47:57.25,Default,,0,0,0,,Иә
Dialogue: 0,0:47:57.87,0:48:01.63,Default,,0,0,0,,Екіленіп қалсаң, жүрегіңнің түбіне енеді.
Dialogue: 0,0:48:01.71,0:48:03.55,Default,,0,0,0,,Жау деген сондай жиіркенішті адамдар.
Dialogue: 0,0:48:03.63,0:48:07.30,Default,,0,0,0,,Бұл бүкіл цирк олардың тұзағы дегенді білдіре ме?
Dialogue: 0,0:48:07.38,0:48:09.43,Default,,0,0,0,,Өлі Ай циркі
Dialogue: 0,0:48:09.51,0:48:12.68,Default,,0,0,0,,Қандай жағдай болмасын, біз олардың шынайы болмысын ашуымыз керек!
Dialogue: 0,0:48:12.76,0:48:16.02,Default,,0,0,0,,Ал біз қала тұрғындарын қорғауымыз керек!
Dialogue: 0,0:48:16.10,0:48:18.14,Default,,0,0,0,,Хм, қазірдің өзінде!
Dialogue: 0,0:48:18.23,0:48:19.31,Default,,0,0,0,,Теңізші Сенши!
Dialogue: 0,0:48:19.40,0:48:22.27,Default,,0,0,0,,Әлгі қарғыс атқырлар да қауесет сияқты!
Dialogue: 0,0:48:22.36,0:48:25.82,Default,,0,0,0,,Жолбарыстың көзіне жету оңай болды...
Dialogue: 0,0:48:25.90,0:48:27.65,Default,,0,0,0,,Шоу да ортада ашылады!
Dialogue: 0,0:48:28.49,0:48:30.57,Default,,0,0,0,,Бұл кек қымбат!
Dialogue: 0,0:48:30.66,0:48:32.41,Default,,0,0,0,,Бірақ оны жарқыраған етіп орнатыңыз
Dialogue: 0,0:48:32.49,0:48:35.37,Default,,0,0,0,,Циркті бүлдіріп көріңіз.
Dialogue: 0,0:48:35.45,0:48:39.12,Default,,0,0,0,,Біз қарт қаңбақпен жыртылатынбыз.
Dialogue: 0,0:48:39.21,0:48:40.33,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:48:40.42,0:48:42.58,Default,,0,0,0,,Баяу және мұқият жоспарлаңыз
Dialogue: 0,0:48:42.67,0:48:45.25,Default,,0,0,0,,Ал көңілді болған жақсы.
Dialogue: 0,0:48:46.30,0:48:48.51,Default,,0,0,0,,Менің өлі ай циркінің шоуы
Dialogue: 0,0:48:48.59,0:48:50.63,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:48:54.01,0:48:54.97,Default,,0,0,0,,Жылама
Dialogue: 0,0:48:56.10,0:48:57.52,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,0:48:59.23,0:49:01.69,Default,,0,0,0,,Содан бері Элиос көрінбеді.
Dialogue: 0,0:49:02.90,0:49:03.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:49:08.36,0:49:09.45,Default,,0,0,0,,Хаа…
Dialogue: 0,0:49:09.53,0:49:10.82,Default,,0,0,0,,Элиос…
Dialogue: 0,0:49:11.41,0:49:14.12,Default,,0,0,0,,Неліктен ол кенеттен көрінбей қалды?
Dialogue: 0,0:49:14.62,0:49:17.08,Default,,0,0,0,,Бұл Элиостың шынайы формасы ма?
Dialogue: 0,0:49:18.12,0:49:20.58,Default,,0,0,0,,Неліктен Пегасқа ұқсайды?
Dialogue: 0,0:49:24.46,0:49:27.13,Default,,0,0,0,,Чибиуса, сенде тамақ жоқ па?
Dialogue: 0,0:49:27.21,0:49:29.92,Default,,0,0,0,,Менің тәбетім жоқ. Менің кеудем толы.
Dialogue: 0,0:49:30.01,0:49:30.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:31.05,0:49:33.39,Default,,0,0,0,,Түсіндім, бұл ұят.
Dialogue: 0,0:49:33.47,0:49:37.01,Default,,0,0,0,,Бүгін менде анамның дәмді шоколадты торты болды.
Dialogue: 0,0:49:39.14,0:49:41.48,Default,,0,0,0,,Менің тәбетім жоқ, бірақ жеймін!
Dialogue: 0,0:49:41.56,0:49:43.56,Default,,0,0,0,,Иә? Қайда бара жатырсың?
Dialogue: 0,0:49:44.19,0:49:46.69,Default,,0,0,0,,Мамо-чан өзін нашар сезінеді.
Dialogue: 0,0:49:46.77,0:49:48.53,Default,,0,0,0,,Мен де университетте жоқпын.
Dialogue: 0,0:49:48.61,0:49:50.36,Default,,0,0,0,,Мен сізге қонаққа баруды ойладым.
Dialogue: 0,0:49:50.86,0:49:52.20,Default,,0,0,0,,Сен де барасың ба?
Dialogue: 0,0:49:54.07,0:49:56.53,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:49:56.62,0:49:57.95,Default,,0,0,0,,О, бұл әдеттен тыс.
Dialogue: 0,0:49:59.12,0:50:00.37,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:50:00.45,0:50:01.46,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:50:04.58,0:50:05.83,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:50:06.63,0:50:09.84,Default,,0,0,0,,Содан бері мен Элиос туралы ғана ойладым.
Dialogue: 0,0:50:11.05,0:50:12.59,Default,,0,0,0,,Мен саған көмектескім келеді
Dialogue: 0,0:50:14.05,0:50:16.39,Default,,0,0,0,,Мүмкін мен біреумен сөйлесуім керек шығар...
Dialogue: 0,0:50:17.51,0:50:21.06,Default,,0,0,0,,Қояндардың сөйлесе алатын достары көп болғаны жақсы.
Dialogue: 0,0:50:21.14,0:50:23.77,Default,,0,0,0,,Кішкентай ханым Сіз жаттығудасыз!
Dialogue: 0,0:50:23.85,0:50:26.65,Default,,0,0,0,,Мен өз ұстанымымды Усаги-самамен салыстырып жатқаныма сене алар емеспін...
Dialogue: 0,0:50:27.44,0:50:28.94,Default,,0,0,0,,Жарайды, міне. Бағасы 12 доллар болады.
Dialogue: 0,0:50:31.69,0:50:34.36,Default,,0,0,0,,Бір күні мен де жақсы жауынгер боламын.
Dialogue: 0,0:50:34.45,0:50:36.82,Default,,0,0,0,,Мен қашан достасамын...
Dialogue: 0,0:50:36.91,0:50:38.87,Default,,0,0,0,,Сондай заман келер деп үміттенемін
Dialogue: 0,0:50:40.08,0:50:41.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:50:41.12,0:50:44.92,Default,,0,0,0,,
Dialogue: 0,0:50:46.17,0:50:47.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:50:47.67,0:50:48.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:50:48.96,0:50:50.21,Default,,0,0,0,,Мао-чан
Dialogue: 0,0:50:50.30,0:50:51.26,Default,,0,0,0,,Қоян
Dialogue: 0,0:50:51.34,0:50:52.21,Default,,0,0,0,,Эххе
Dialogue: 0,0:50:52.76,0:50:54.30,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:50:54.38,0:50:56.68,Default,,0,0,0,,Мен сені тамақ жеген жоқпын деп ойладым.
Dialogue: 0,0:50:56.76,0:50:58.43,Default,,0,0,0,,Мен түскі қорап әкелдім.
Dialogue: 0,0:50:58.51,0:51:00.72,Default,,0,0,0,,Осыдан кейін сусындар мен...
Dialogue: 0,0:51:00.81,0:51:01.64,Default,,0,0,0,,Қоян
Dialogue: 0,0:51:01.72,0:51:02.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:03.77,0:51:05.35,Default,,0,0,0,,Қайтып келе аласыз ба?
Dialogue: 0,0:51:05.44,0:51:06.27,Default,,0,0,0,,А...
Dialogue: 0,0:51:06.35,0:51:09.11,Default,,0,0,0,,Мен енді ұйықтайын деп ойладым.
Dialogue: 0,0:51:09.19,0:51:11.36,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:51:11.44,0:51:13.44,Default,,0,0,0,,Кешіріңіз, мен үйге бара жатырмын.
Dialogue: 0,0:51:14.45,0:51:17.45,Default,,0,0,0,,Сізге кенеттен кіріп кеткенім үшін кешіріңіз.
Dialogue: 0,0:51:18.12,0:51:18.87,Default,,0,0,0,,Секір!!
Dialogue: 0,0:51:19.70,0:51:21.04,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:51:21.12,0:51:22.33,Default,,0,0,0,,
Dialogue: 0,0:51:22.41,0:51:23.87,Default,,0,0,0,,Өкпедегі көлеңкелер...
Dialogue: 0,0:51:24.54,0:51:27.29,Default,,0,0,0,,Менің денеме не болды...
Dialogue: 0,0:51:27.83,0:51:31.59,Default,,0,0,0,,Мен тағы да қоянға кедергі боламын ба?
Dialogue: 0,0:51:33.80,0:51:34.72,Default,,0,0,0,,Мамо-чан...
Dialogue: 0,0:51:38.14,0:51:39.85,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:51:39.93,0:51:42.51,Default,,0,0,0,,Цирк қалада өзін толықтай танытты.
Dialogue: 0,0:51:42.60,0:51:46.27,Default,,0,0,0,,Сол жігіттер келгеннен бері Джубан аздап кірленіп кетті.
Dialogue: 0,0:51:46.35,0:51:48.98,Default,,0,0,0,,Көмек болмайды, адамдар жиналып қалады.
Dialogue: 0,0:51:49.06,0:51:51.15,Default,,0,0,0,,Бізге тез арада бірдеңе істеу керек.
Dialogue: 0,0:51:52.52,0:51:54.90,Default,,0,0,0,,Сонда да ыстық, солай емес пе?
Dialogue: 0,0:51:57.07,0:51:58.91,Default,,0,0,0,,Макочан
Dialogue: 0,0:51:58.99,0:51:59.95,Default,,0,0,0,,Эххе
Dialogue: 0,0:52:00.03,0:52:01.08,Default,,0,0,0,,О!
Dialogue: 0,0:52:01.99,0:52:03.66,Default,,0,0,0,,Сәлем, Чибиуса!
Dialogue: 0,0:52:03.74,0:52:06.04,Default,,0,0,0,,Ах... Мако-чан
Dialogue: 0,0:52:06.12,0:52:08.54,Default,,0,0,0,,Мен сізбен бір нәрсені талқылағым келеді.
Dialogue: 0,0:52:09.12,0:52:11.34,Default,,0,0,0,,Не? Не? Ол өзгерді
Dialogue: 0,0:52:11.42,0:52:13.75,Default,,0,0,0,,Сізді қызықтырған баламен кездесе алдыңыз ба?
Dialogue: 0,0:52:14.38,0:52:15.21,Default,,0,0,0,,Өткір...
Dialogue: 0,0:52:15.30,0:52:16.05,Default,,0,0,0,,Хехехе
Dialogue: 0,0:52:16.13,0:52:17.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:18.05,0:52:18.93,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:52:19.01,0:52:21.85,Default,,0,0,0,,Осы уақытта Мако-чан сізге дәмді тағам дайындап береді.
Dialogue: 0,0:52:21.93,0:52:22.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:22.64,0:52:23.51,Default,,0,0,0,,Хехе
Dialogue: 0,0:52:24.14,0:52:26.02,Default,,0,0,0,,Ах... бұл иіс...
Dialogue: 0,0:52:29.81,0:52:31.48,Default,,0,0,0,,
Dialogue: 0,0:52:32.36,0:52:34.57,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:52:34.65,0:52:37.70,Default,,0,0,0,,А, у... мына дүкен...
Dialogue: 0,0:52:37.78,0:52:39.82,Default,,0,0,0,,Дүкен бүгін ғана ашылды.
Dialogue: 0,0:52:39.91,0:52:41.62,Default,,0,0,0,,Қуаныштымын... Уһ.
Dialogue: 0,0:52:42.20,0:52:43.37,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:52:43.45,0:52:45.79,Default,,0,0,0,,Қандай керемет әртүрлілік!
Dialogue: 0,0:52:45.87,0:52:47.71,Default,,0,0,0,,Бізде көптеген шөптер бар.
Dialogue: 0,0:52:47.79,0:52:48.96,Default,,0,0,0,,Я~
Dialogue: 0,0:52:49.46,0:52:52.21,Default,,0,0,0,,Осындай шағын дүкеннің иесі менмін.
Dialogue: 0,0:52:52.29,0:52:54.42,Default,,0,0,0,,Бұл менің жас кезімнен арманым еді.
Dialogue: 0,0:52:54.50,0:52:56.84,Default,,0,0,0,,Сонымен, сіздің арманыңыз орындалды.
Dialogue: 0,0:52:56.92,0:52:59.80,Default,,0,0,0,,Орындалмады, орындалды.
Dialogue: 0,0:53:00.38,0:53:02.05,Default,,0,0,0,,Мен арманымды орындадым...
Dialogue: 0,0:53:02.14,0:53:04.39,Default,,0,0,0,,Бірақ арман әлі де жалғасуда
Dialogue: 0,0:53:04.47,0:53:07.27,Default,,0,0,0,,Бір күні мен дүние жүзінде дүкендер ашамын.
Dialogue: 0,0:53:08.56,0:53:09.39,Default,,0,0,0,,Ум...
Dialogue: 0,0:53:09.48,0:53:10.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:10.73,0:53:14.73,Default,,0,0,0,,Менің арманым бір күні дүкеннің иесі болу.
Dialogue: 0,0:53:14.82,0:53:16.90,Default,,0,0,0,,Гүл дүкені немесе торт дүкені?
Dialogue: 0,0:53:16.98,0:53:18.49,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:53:18.57,0:53:20.86,Default,,0,0,0,,Оны орындаңыз.
Dialogue: 0,0:53:21.36,0:53:22.45,Default,,0,0,0,,Мақсаттарыңызды анықтағаннан кейін
Dialogue: 0,0:53:22.53,0:53:24.78,Default,,0,0,0,,Жастайынан талпыну керек!
Dialogue: 0,0:53:24.87,0:53:26.62,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:53:26.70,0:53:27.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:53:29.04,0:53:33.21,Default,,0,0,0,,Алғашқы екі тұтынушыға арнайы сыйлық
Dialogue: 0,0:53:33.29,0:53:35.88,Default,,0,0,0,,Уау, әдемі сақина
Dialogue: 0,0:53:35.96,0:53:38.05,Default,,0,0,0,,Бұл зұлымдықтан сақтандыратын бойтұмар.
Dialogue: 0,0:53:38.13,0:53:40.80,Default,,0,0,0,,Бұл да арманды орындайтын бойтұмар.
Dialogue: 0,0:53:40.88,0:53:43.05,Default,,0,0,0,,Армандарыңызды орындаңыз?
Dialogue: 0,0:53:44.76,0:53:45.97,Default,,0,0,0,,Мако-чан
Dialogue: 0,0:53:46.06,0:53:48.22,Default,,0,0,0,,Мен қызанақты турап, салатқа саламын.
Dialogue: 0,0:53:48.31,0:53:49.10,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:53:49.18,0:53:51.64,Default,,0,0,0,,Содан кейін насыбайгүл себіңіз де, үстелге қызмет етіңіз.
Dialogue: 0,0:53:51.73,0:53:52.60,Default,,0,0,0,,Насыбайгүл?
Dialogue: 0,0:53:52.69,0:53:54.69,Default,,0,0,0,,Қызанақты дәмді ететін шөп.
Dialogue: 0,0:53:54.77,0:53:55.56,Default,,0,0,0,,Я~
Dialogue: 0,0:53:56.90,0:53:59.49,Default,,0,0,0,,Олай болса... (2 адам) Мен аламын.
Dialogue: 0,0:54:03.11,0:54:05.45,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:54:05.53,0:54:06.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:54:06.53,0:54:09.08,Default,,0,0,0,,Мако-чанның тамағы ең жақсы!
Dialogue: 0,0:54:09.16,0:54:12.16,Default,,0,0,0,,Армандарды орындайтын бойтұмар...
Dialogue: 0,0:54:12.25,0:54:15.08,Default,,0,0,0,,Бұл кеңсе қызметкері жақсы болды.
Dialogue: 0,0:54:15.79,0:54:18.88,Default,,0,0,0,,Армандарымды орындасам да, тырысамын.
Dialogue: 0,0:54:19.88,0:54:22.42,Default,,0,0,0,,Ата-анам жастай қайтыс болды.
Dialogue: 0,0:54:22.51,0:54:24.30,Default,,0,0,0,,Себебі мен ұзақ уақыт жалғыз тұрдым
Dialogue: 0,0:54:24.39,0:54:27.89,Default,,0,0,0,,Ерте үйленіп, бақытты отбасын құру
Dialogue: 0,0:54:28.76,0:54:32.31,Default,,0,0,0,,Ал шағын гүл дүкені мен торт дүкенін ашыңыз.
Dialogue: 0,0:54:34.85,0:54:37.19,Default,,0,0,0,,Бұл құпия, бірақ бұл шындық.
Dialogue: 0,0:54:37.27,0:54:40.23,Default,,0,0,0,,Мен Мичиру сияқты әдемі әйел болғым келеді
Dialogue: 0,0:54:40.32,0:54:42.78,Default,,0,0,0,,Мен Харука-сан сияқты күшті болғым келеді
Dialogue: 0,0:54:43.45,0:54:44.70,Default,,0,0,0,,Көптеген армандар
Dialogue: 0,0:54:45.57,0:54:46.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:54:47.28,0:54:50.70,Default,,0,0,0,,Сол арман үшін көп еңбек еттім бе?
Dialogue: 0,0:54:52.75,0:54:54.75,Default,,0,0,0,,Кеше Мако-чанға
Dialogue: 0,0:54:54.83,0:54:57.63,Default,,0,0,0,,Маған шөптен жасалған тағамдар көп болды.
Dialogue: 0,0:54:57.71,0:54:58.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:55:00.00,0:55:00.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:01.55,0:55:02.80,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:55:02.88,0:55:05.51,Default,,0,0,0,,Мен оны кеше Мако-чанмен бірге барған дүкеннен алдым.
Dialogue: 0,0:55:05.59,0:55:07.76,Default,,0,0,0,,Бұл зұлым рухтардан қорғайтын бойтұмар.
Dialogue: 0,0:55:07.85,0:55:10.26,Default,,0,0,0,,Мамо-чанның қолында болғанын қалаймын.
Dialogue: 0,0:55:10.76,0:55:12.14,Default,,0,0,0,,Рахмет Чибиуса
Dialogue: 0,0:55:13.64,0:55:15.48,Default,,0,0,0,,Сау болыңыз Мамо-чан
Dialogue: 0,0:55:15.56,0:55:17.65,Default,,0,0,0,,Жақсы тамақтаныңыз.
Dialogue: 0,0:55:17.73,0:55:19.40,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:55:19.90,0:55:21.15,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:55:21.23,0:55:23.49,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:55:23.57,0:55:26.16,Default,,0,0,0,,
Dialogue: 0,0:55:30.53,0:55:33.91,Default,,0,0,0,,Мен саған жақсылап қара дедім.
Dialogue: 0,0:55:34.00,0:55:36.50,Default,,0,0,0,,Мамо-чан әлі науқас болып көрінді.
Dialogue: 0,0:55:36.58,0:55:37.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:55:38.04,0:55:40.25,Default,,0,0,0,,Кешіріңіз, Чибиуса, рахмет
Dialogue: 0,0:55:40.34,0:55:42.42,Default,,0,0,0,,Неге кездеспейміз?
Dialogue: 0,0:55:42.50,0:55:43.42,Default,,0,0,0,,Та-да!
Dialogue: 0,0:55:43.51,0:55:44.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:45.17,0:55:47.68,Default,,0,0,0,,Мен қайтадан қабылданбаудан қорқамын.
Dialogue: 0,0:55:48.93,0:55:51.31,Default,,0,0,0,,Бірдеңе болды, солай ма? Мамо-чан
Dialogue: 0,0:55:51.39,0:55:54.27,Default,,0,0,0,,Сіз маған уақытында айтасыз.
Dialogue: 0,0:56:00.52,0:56:01.23,Default,,0,0,0,,
Dialogue: 0,0:56:01.32,0:56:02.61,Default,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:56:03.19,0:56:05.44,Default,,0,0,0,,Мен қарап шыға аламын ба?
Dialogue: 0,0:56:05.53,0:56:07.07,Default,,0,0,0,,Әрине.
Dialogue: 0,0:56:08.24,0:56:10.95,Default,,0,0,0,,Не болды? Бірдеңе болды ма?
Dialogue: 0,0:56:12.24,0:56:15.33,Default,,0,0,0,,Мен достарыммен бірдеңе туралы сөйлесе алмаймын...
Dialogue: 0,0:56:16.54,0:56:19.42,Default,,0,0,0,,Менің армандарым көп.
Dialogue: 0,0:56:19.50,0:56:21.46,Default,,0,0,0,,Бірақ мен абдырап қалдым...
Dialogue: 0,0:56:22.29,0:56:23.71,Default,,0,0,0,,Жер
Dialogue: 0,0:56:23.80,0:56:26.17,Default,,0,0,0,,Егер мен осылай матрос сенші болып қала берсем.
Dialogue: 0,0:56:26.26,0:56:27.80,Default,,0,0,0,,Тек ұрыс
Dialogue: 0,0:56:28.30,0:56:31.18,Default,,0,0,0,,Менің армандарым орындалмайды, солай ма?
Dialogue: 0,0:56:31.85,0:56:33.31,Default,,0,0,0,,Мен жүрген жол
Dialogue: 0,0:56:33.39,0:56:35.98,Default,,0,0,0,,Мен қате болуы мүмкін деп ойладым.
Dialogue: 0,0:56:36.60,0:56:38.77,Default,,0,0,0,,Жоқ... не айтып тұрсың?
Dialogue: 0,0:56:38.85,0:56:41.65,Default,,0,0,0,,Күмәніңіз болса, неге тастамайсыз?
Dialogue: 0,0:56:41.73,0:56:42.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:42.52,0:56:44.61,Default,,0,0,0,,Теңізші Сенши?
Dialogue: 0,0:56:45.23,0:56:46.86,Default,,0,0,0,,Не, мына балалар!
Dialogue: 0,0:56:46.94,0:56:48.32,Default,,0,0,0,,Қашу мүмкін емес!
Dialogue: 0,0:56:48.40,0:56:50.82,Default,,0,0,0,,Қошмар инкарнация Ремрес-чан және т.б
Dialogue: 0,0:56:50.91,0:56:53.58,Default,,0,0,0,,Арманға толысың, жарылып кете жаздадың
Dialogue: 0,0:56:53.66,0:56:55.66,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,0:56:55.74,0:56:58.16,Default,,0,0,0,,Сіз де Өлі Ай циркіне қосылыңыз.
Dialogue: 0,0:56:58.25,0:56:59.67,Default,,0,0,0,,Неге кірмеске?
Dialogue: 0,0:56:59.75,0:57:01.17,Default,,0,0,0,,Өлі ай!
Dialogue: 0,0:57:01.25,0:57:03.13,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:57:03.21,0:57:04.21,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:57:04.29,0:57:07.51,Default,,0,0,0,,Дүние жүзінде түнгі түндерді сатайық.
Dialogue: 0,0:57:07.59,0:57:09.47,Default,,0,0,0,,Арх... аа!
Dialogue: 0,0:57:09.55,0:57:11.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:11.18,0:57:12.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:57:12.85,0:57:14.51,Default,,0,0,0,,Қуат...
Dialogue: 0,0:57:16.27,0:57:18.23,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:57:18.31,0:57:21.10,Default,,0,0,0,,Енді маған ешкім көмекке келе алмайды.
Dialogue: 0,0:57:21.19,0:57:23.81,Default,,0,0,0,,Бұл Амазонка тасының «шар түйіні».
Dialogue: 0,0:57:23.90,0:57:27.61,Default,,0,0,0,,Бұл жолы Теңізші Сеншидің соңы.
Dialogue: 0,0:57:28.57,0:57:30.49,Default,,0,0,0,,Бұл кішкентай ғана нәрсе.
Dialogue: 0,0:57:30.57,0:57:33.87,Default,,0,0,0,,Юпитер... Юпитер!
Dialogue: 0,0:57:34.70,0:57:35.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:37.37,0:57:38.54,Default,,0,0,0,,Бұл!
Dialogue: 0,0:57:38.62,0:57:40.29,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:57:40.91,0:57:42.88,Default,,0,0,0,,Жауға әлсіздігімді көрсетсем не істеймін?
Dialogue: 0,0:57:42.96,0:57:45.63,Default,,0,0,0,,Өз миссияңызды ұмыттыңыз ба?
Dialogue: 0,0:57:45.71,0:57:47.50,Default,,0,0,0,,Ешбір суперқуат Юпитер жоқ
Dialogue: 0,0:57:47.59,0:57:50.42,Default,,0,0,0,,Серенити ханшайымы мен оның басқа достарына кім қамқор болды...
Dialogue: 0,0:57:50.51,0:57:53.05,Default,,0,0,0,,Сіз бұл қаланың тұрғындарын қорғай аласыз!
Dialogue: 0,0:57:53.14,0:57:56.47,Default,,0,0,0,,Дұрыс... Мен Юпитермін
Dialogue: 0,0:57:57.14,0:57:58.89,Default,,0,0,0,,Арман көп, бірақ
Dialogue: 0,0:57:59.48,0:58:01.27,Default,,0,0,0,,Дәл қазір менің ең үлкен арманым
Dialogue: 0,0:58:01.35,0:58:04.90,Default,,0,0,0,,Өзің жақсы көретіндердің барлығын қорғайтын ең мықты жауынгер бол
Dialogue: 0,0:58:05.56,0:58:07.69,Default,,0,0,0,,Міне, миссия!
Dialogue: 0,0:58:07.78,0:58:08.90,Default,,0,0,0,,Шындық
Dialogue: 0,0:58:09.78,0:58:10.82,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:58:11.40,0:58:13.66,Default,,0,0,0,,Ең үлкен жау – өз әлсіздігің!
Dialogue: 0,0:58:13.74,0:58:15.91,Default,,0,0,0,,Мен білемін, Харука-сан.
Dialogue: 0,0:58:16.87,0:58:17.91,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:58:17.99,0:58:20.91,Default,,0,0,0,,Хехе... Сондықтан Юпитер теңізші
Dialogue: 0,0:58:21.00,0:58:23.21,Default,,0,0,0,,Бұл менің Юпитер ханшайымым.
Dialogue: 0,0:58:25.58,0:58:27.67,Default,,0,0,0,,Бұл сіздің Юпитер Кристаллыңыз.
Dialogue: 0,0:58:28.25,0:58:29.00,Default,,0,0,0,,Сіз...
Dialogue: 0,0:58:29.09,0:58:31.97,Default,,0,0,0,,Менің ойымша, мен сенің алтер-эгосыңмын.
Dialogue: 0,0:58:33.22,0:58:34.68,Default,,0,0,0,,Мен сені үнемі бақылап отырамын!
Dialogue: 0,0:58:34.76,0:58:36.76,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Юпитер!
Dialogue: 0,0:58:38.97,0:58:39.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:58:40.72,0:58:42.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:43.27,0:58:45.56,Default,,0,0,0,,Юпитердің кристалдық күші
Dialogue: 0,0:58:45.65,0:58:47.56,Default,,0,0,0,,Макияж!
Dialogue: 0,0:59:08.88,0:59:10.84,Default,,0,0,0,,Найзағай жұлдызы!
Dialogue: 0,0:59:10.92,0:59:13.80,Default,,0,0,0,,Юпитер оның қамқоршысы болған қорғаныс жауынгері!
Dialogue: 0,0:59:14.38,0:59:16.22,Default,,0,0,0,,Теңізші Юпитер!
Dialogue: 0,0:59:17.76,0:59:20.76,Default,,0,0,0,,Өкінішті етіп, жансыздандырамын!
Dialogue: 0,0:59:22.64,0:59:24.81,Default,,0,0,0,,Мен сені бұл қаладан міндетті түрде қуамын.
Dialogue: 0,0:59:24.89,0:59:26.73,Default,,0,0,0,,Өлі Ай циркі!
Dialogue: 0,0:59:27.90,0:59:30.32,Default,,0,0,0,,Не! (Хокстың көзі) Жоқ!
Dialogue: 0,0:59:32.69,0:59:36.24,Default,,0,0,0,,Бұл Райденнің эмблемасы: емен жапырағы!
Dialogue: 0,0:59:39.58,0:59:41.08,Default,,0,0,0,,Юпитер!
Dialogue: 0,0:59:41.16,0:59:44.12,Default,,0,0,0,,Орк эволюциясы!
Dialogue: 0,0:59:44.20,0:59:45.41,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:59:47.46,0:59:48.54,Default,,0,0,0,,An!
Dialogue: 0,0:59:48.63,0:59:50.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:51.00,0:59:51.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:53.46,0:59:54.59,Default,,0,0,0,,Ойланба
Dialogue: 0,0:59:55.26,0:59:58.55,Default,,0,0,0,,Менің арманым осымен аяқталады деп ойлаймын...
Dialogue: 0,0:59:59.68,1:00:02.97,Default,,0,0,0,,Аз ғана уақыт болса да, сіз өзіңіздің жеке дүкеніңізге ие бола аласыз.
Dialogue: 0,1:00:03.06,1:00:04.27,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,1:00:06.23,1:00:07.81,Default,,0,0,0,,Сен де армансың...
Dialogue: 0,1:00:08.77,1:00:11.52,Default,,0,0,0,,Оны міндетті түрде орындаңыз
Dialogue: 0,1:00:11.61,1:00:13.69,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:00:15.86,1:00:17.03,Default,,0,0,0,,Юпитер!
Dialogue: 0,1:00:17.11,1:00:19.03,Default,,0,0,0,,Қоян! Чибиуса!
Dialogue: 0,1:00:21.41,1:00:23.41,Default,,0,0,0,,Бұл жігіттер қатты тітіркендіреді!
Dialogue: 0,1:00:23.49,1:00:25.75,Default,,0,0,0,,Бұл шынымен тітіркендіргіш.
Dialogue: 0,1:00:27.21,1:00:28.83,Default,,0,0,0,,Олар жау ма?
Dialogue: 0,1:00:28.92,1:00:29.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:00:29.75,1:00:30.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:32.59,1:00:34.55,Default,,0,0,0,,Сузу... Элиос?
Dialogue: 0,1:00:35.63,1:00:38.30,Default,,0,0,0,,Элиос мені бір жерге шақырып жатыр!
Dialogue: 0,1:00:38.93,1:00:39.55,Default,,0,0,0,,Ха!
Dialogue: 0,1:00:39.64,1:00:40.97,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:00:41.05,1:00:42.22,Default,,0,0,0,,Чибиуса!
Dialogue: 0,1:00:42.30,1:00:43.31,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:47.64,1:00:49.44,Default,,0,0,0,,Мамо-чан! (Чиби Мун) Элиос!
Dialogue: 0,1:00:49.52,1:00:50.65,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:00:50.73,1:00:51.40,Default,,0,0,0,,Иә!
Dialogue: 0,1:00:53.98,1:00:59.57,Default,,0,0,0,,Айдың керемет медитациясы!
Dialogue: 0,1:01:03.28,1:01:04.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:05.16,1:01:06.37,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:01:06.45,1:01:08.83,Default,,0,0,0,,Қыз... Уф...
Dialogue: 0,1:01:08.91,1:01:10.00,Default,,0,0,0,,Элиос!
Dialogue: 0,1:01:10.08,1:01:11.83,Default,,0,0,0,,Мамо-чан! (Юпитер) Мамору-сан!
Dialogue: 0,1:01:11.92,1:01:14.50,Default,,0,0,0,,(Маморудың жөтелі)
Dialogue: 0,1:01:15.59,1:01:16.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:16.67,1:01:17.67,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:01:17.76,1:01:18.80,Default,,0,0,0,,(Танжиро) Ой… (Чунтарo) Чип, чип
Dialogue: 0,1:01:19.30,1:01:20.97,Default,,0,0,0,,Қара қан?
Dialogue: 0,1:01:21.05,1:01:23.51,Default,,0,0,0,,Мамо-чан, сен қашаннан бері осылайсың...
Dialogue: 0,1:01:24.05,1:01:26.43,Default,,0,0,0,,Біраз бұрын кеудем ауыра бастады...
Dialogue: 0,1:01:27.10,1:01:27.93,Default,,0,0,0,,Уф!
Dialogue: 0,1:01:28.02,1:01:30.35,Default,,0,0,0,,Ал өкпемде қара көлеңке...
Dialogue: 0,1:01:30.44,1:01:32.60,Default,,0,0,0,,Уақыт жеткен сияқты
Dialogue: 0,1:01:32.69,1:01:34.19,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,1:01:36.53,1:01:38.49,Default,,0,0,0,,Мен Элизийдің діни қызметкерімін
Dialogue: 0,1:01:39.74,1:01:40.99,Default,,0,0,0,,Элиос
Dialogue: 0,1:01:41.07,1:01:43.32,Default,,0,0,0,,Элизий діни қызметкері?
Dialogue: 0,1:01:44.99,1:01:47.58,Default,,0,0,0,,Элизий жердің тереңінде
Dialogue: 0,1:01:47.66,1:01:50.25,Default,,0,0,0,,Бұл планетаны қорғайтын киелі жер.
Dialogue: 0,1:01:50.33,1:01:52.88,Default,,0,0,0,,Осы планетаның жүрегі сияқты жер
Dialogue: 0,1:01:54.13,1:01:57.42,Default,,0,0,0,,Менің миссиям - Элизиум және бұл планета...
Dialogue: 0,1:01:57.50,1:02:01.80,Default,,0,0,0,,Ханзада Эндимион сізді бақылап отыру үшін
Dialogue: 0,1:02:03.05,1:02:05.80,Default,,0,0,0,,Мен де сенің қамқоршы діни қызметкеріңмін.
Dialogue: 0,1:02:05.89,1:02:08.56,Default,,0,0,0,,Менің қамқоршы діни қызметкерім?
Dialogue: 0,1:02:09.68,1:02:12.39,Default,,0,0,0,,Бұл планетаны киелі Элизиум жері қорғайды.
Dialogue: 0,1:02:12.94,1:02:15.77,Default,,0,0,0,,Менің өмірім де Элизиуммен.
Dialogue: 0,1:02:16.82,1:02:20.15,Default,,0,0,0,,Ханзада, бұл планета, Элизиум және мен
Dialogue: 0,1:02:20.78,1:02:22.91,Default,,0,0,0,,Төрт ақыл мен дене байланысқан
Dialogue: 0,1:02:22.99,1:02:25.74,Default,,0,0,0,,Олар бір-бірімен резонанс тудыруға арналған.
Dialogue: 0,1:02:26.33,1:02:27.12,Default,,0,0,0,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,1:02:27.74,1:02:31.08,Default,,0,0,0,,Міне, осылай болды...
Dialogue: 0,1:02:32.41,1:02:35.13,Default,,0,0,0,,Ха... кеудемде қара раушан гүл бар!
Dialogue: 0,1:02:35.21,1:02:37.09,Default,,0,0,0,,Ах! Мамо-чан!
Dialogue: 0,1:02:37.67,1:02:41.05,Default,,0,0,0,,Мына қарғыс атқан қара раушан менің де жүрегімде...
Dialogue: 0,1:02:42.05,1:02:45.14,Default,,0,0,0,,Бұл Элизийдің эрозияға ұшырауының белгісі.
Dialogue: 0,1:02:45.22,1:02:48.85,Default,,0,0,0,,Ханзада мен сияқты қарғысқа ұшырады.
Dialogue: 0,1:02:48.93,1:02:50.85,Default,,0,0,0,,Ал менің денем...
Dialogue: 0,1:02:51.81,1:02:55.27,Default,,0,0,0,,Енді тағы бір қарғыстың кесірінен мен Пегас кейпіне айналдым.
Dialogue: 0,1:02:56.11,1:02:58.57,Default,,0,0,0,,Ол Элизиумда түрмеде отыр.
Dialogue: 0,1:03:00.15,1:03:03.57,Default,,0,0,0,,Жаңа айдың қараңғылығында мөрленген патшалық⸺
Dialogue: 0,1:03:04.07,1:03:07.32,Default,,0,0,0,,Өлі Айдың ханшайымы Нехеления
Dialogue: 0,1:03:07.41,1:03:09.08,Default,,0,0,0,,Өлі ай!
Dialogue: 0,1:03:09.87,1:03:12.29,Default,,0,0,0,,Ақ ай патшалығы⸺
Dialogue: 0,1:03:12.37,1:03:15.00,Default,,0,0,0,,Күміс мыңжылдықтың құлдырауымен
Dialogue: 0,1:03:15.08,1:03:18.38,Default,,0,0,0,,Нехеленияны жауып тастаған күш әлсіреді.
Dialogue: 0,1:03:19.42,1:03:21.59,Default,,0,0,0,,Нехеления қайта жандануда.
Dialogue: 0,1:03:21.67,1:03:23.47,Default,,0,0,0,,Элизийді қарғыс
Dialogue: 0,1:03:24.17,1:03:27.59,Default,,0,0,0,,Күннің толық тұтылуының әдемі, бірақ қарғыс атқан сәтінде
Dialogue: 0,1:03:27.68,1:03:30.39,Default,,0,0,0,,Ол жерге енді.
Dialogue: 0,1:03:32.77,1:03:34.48,Default,,0,0,0,,Тыныштық ханшайымы
Dialogue: 0,1:03:34.56,1:03:36.94,Default,,0,0,0,,Супер Сейлор Мун жоқ
Dialogue: 0,1:03:37.60,1:03:42.03,Default,,0,0,0,,Өтінемін, күміс кристалдың және алтын кристалдың күшімен,
Dialogue: 0,1:03:42.11,1:03:44.86,Default,,0,0,0,,Бәрімізді осы қорқынышты түстен құтқара гөр.
Dialogue: 0,1:03:44.95,1:03:45.99,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:47.66,1:03:48.78,Default,,0,0,0,,Элиос…
Dialogue: 0,1:03:48.87,1:03:50.74,Default,,0,0,0,,Мамо-чан!
Dialogue: 0,1:03:51.95,1:03:53.70,Default,,0,0,0,,Менен аулақ болғаныңыз жөн
Dialogue: 0,1:03:53.79,1:03:54.46,Default,,0,0,0,,А...
Dialogue: 0,1:03:55.41,1:03:58.13,Default,,0,0,0,,Бұл қарғыс берілуі мүмкін
Dialogue: 0,1:03:58.21,1:03:59.08,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:59.67,1:04:00.84,Default,,0,0,0,,Мен сенің жаныңдамын
Dialogue: 0,1:04:01.80,1:04:04.47,Default,,0,0,0,,Осы планетаның азабын түсіну үшін...
Dialogue: 0,1:04:05.76,1:04:08.97,Default,,0,0,0,,Сенің азабың – менің азабым!
Dialogue: 0,1:04:12.01,1:04:15.10,Default,,0,0,0,,Мен сені міндетті түрде емдеймін!
Dialogue: 0,1:04:16.56,1:04:19.86,Default,,0,0,0,,Ендеше қандай жағдай болмасын сенімен бірге болуға рұқсат ет.
Dialogue: 0,1:04:20.52,1:04:22.61,Default,,0,0,0,,Айтайын, қолымыздан келгенді бірге жасайық!
Dialogue: 0,1:04:22.69,1:04:23.78,Default,,0,0,0,,Қоян...
Dialogue: 0,1:04:23.86,1:04:25.74,Default,,0,0,0,,Бұл жұлдызды міндетті түрде алыңыз
Dialogue: 0,1:04:25.82,1:04:28.78,Default,,0,0,0,,Бұл адам... Мен барлығын қорғаймын.
Dialogue: 0,1:04:32.33,1:04:33.45,Default,,0,0,0,,Элиос…
Dialogue: 0,1:04:36.66,1:04:39.04,Default,,0,0,0,,Жерді өлі айдан қалай құтқарамыз
Dialogue: 0,1:04:39.12,1:04:41.42,Default,,0,0,0,,Сізге алтын кристалл керек пе?
Dialogue: 0,1:04:41.50,1:04:43.25,Default,,0,0,0,,Жер ғана емес
Dialogue: 0,1:04:43.34,1:04:45.17,Default,,0,0,0,,Мамору-сан да, Элизиум да
Dialogue: 0,1:04:45.26,1:04:47.13,Default,,0,0,0,,Элиос та...
Dialogue: 0,1:04:47.84,1:04:51.05,Default,,0,0,0,,Енді бесеуміз қоянға көмектесеміз.
Dialogue: 0,1:04:51.14,1:04:53.22,Default,,0,0,0,,Біз Мамору-санды қорғап, соғысуымыз керек.
Dialogue: 0,1:04:53.31,1:04:54.39,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:54.47,1:04:55.47,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:56.02,1:04:56.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:04:58.44,1:04:59.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:05:01.15,1:05:03.44,Default,,0,0,0,,Ха ха! Хехехехе!
Dialogue: 0,1:05:04.69,1:05:08.40,Default,,0,0,0,,Венера планетасының қуатты макияжы!
Dialogue: 0,1:05:11.49,1:05:13.91,Default,,0,0,0,,Иә, мен бәріне айтқан жоқпын.
Dialogue: 0,1:05:13.99,1:05:16.16,Default,,0,0,0,,Мен өзгерте алмаймын.
Dialogue: 0,1:05:16.83,1:05:18.66,Default,,0,0,0,,Дүрбелеңнің қажеті жоқ!
Dialogue: 0,1:05:18.75,1:05:19.83,Default,,0,0,0,,Өйткені
Dialogue: 0,1:05:19.92,1:05:22.33,Default,,0,0,0,,Сіз Теңізші Сеншінің басшысысыз!
Dialogue: 0,1:05:22.42,1:05:25.46,Default,,0,0,0,,Бұл туралы уайымдаудың еш пайдасы жоқ.
Dialogue: 0,1:05:26.42,1:05:28.72,Default,,0,0,0,,Жуынуға барайық.
Dialogue: 0,1:05:28.80,1:05:30.68,Default,,0,0,0,,Иә, бұл дәлел.
Dialogue: 0,1:05:30.76,1:05:34.35,Default,,0,0,0,,Мина, сен соңғы кездері әлдеқайда әдемі болып кетіпсің.
Dialogue: 0,1:05:35.43,1:05:39.27,Default,,0,0,0,,Венера құдайына жақындағандай
Dialogue: 0,1:05:40.69,1:05:41.90,Default,,0,0,0,,Көшбасшы?
Dialogue: 0,1:05:42.48,1:05:43.44,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,1:05:43.52,1:05:45.82,Default,,0,0,0,,Мен барлығына көшбасшы болдым, солай ма?
Dialogue: 0,1:05:51.61,1:05:52.95,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:05:53.03,1:05:56.95,Default,,0,0,0,,Өзгерте алмайтын бір матрос Сенши бар.
Dialogue: 0,1:05:57.04,1:05:57.95,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:58.04,1:06:00.96,Default,,0,0,0,,Барлық әлемде мисо-чан бар.
Dialogue: 0,1:06:01.04,1:06:03.46,Default,,0,0,0,,Цирк шоуларынан шаршадым.
Dialogue: 0,1:06:03.54,1:06:04.75,Default,,0,0,0,,Осыны пайдаланыңыз
Dialogue: 0,1:06:04.84,1:06:07.13,Default,,0,0,0,,Көңілді шара өткіземіз бе?
Dialogue: 0,1:06:07.21,1:06:08.34,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,1:06:08.42,1:06:10.88,Default,,0,0,0,,Xenotime! Цеолит!
Dialogue: 0,1:06:12.26,1:06:14.80,Default,,0,0,0,,Оны бізге қалдырыңыз, ханымдар.
Dialogue: 0,1:06:14.89,1:06:18.35,Default,,0,0,0,,Біз қабілетсіз Amazon триосы емеспіз.
Dialogue: 0,1:06:18.43,1:06:20.27,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:06:22.23,1:06:25.02,Default,,0,0,0,,Ах~ Шикаши, өте ыстық.
Dialogue: 0,1:06:25.11,1:06:28.36,Default,,0,0,0,,Әйтеуір, көшелер қаңырап қалды.
Dialogue: 0,1:06:28.44,1:06:29.99,Default,,0,0,0,,Жоқ, ұрыс?
Dialogue: 0,1:06:30.07,1:06:31.32,Default,,0,0,0,,Эй!
Dialogue: 0,1:06:31.40,1:06:33.99,Default,,0,0,0,,Ыстық кезде мен тітіркенемін.
Dialogue: 0,1:06:37.28,1:06:39.08,Default,,0,0,0,,О? Бұл...
Dialogue: 0,1:06:39.16,1:06:40.87,Default,,0,0,0,,Мичиру айнасы
Dialogue: 0,1:06:40.95,1:06:42.54,Default,,0,0,0,,Мен оны Чибиусадан алдым.
Dialogue: 0,1:06:43.54,1:06:46.25,Default,,0,0,0,,Соңғы кездері мен мазасызданып жүрмін.
Dialogue: 0,1:06:46.34,1:06:48.05,Default,,0,0,0,,Осы Мичиру-санның айнасында
Dialogue: 0,1:06:48.13,1:06:50.55,Default,,0,0,0,,Бір оғаш нәрсенің себебін білсем ғой.
Dialogue: 0,1:06:50.63,1:06:55.01,Default,,0,0,0,,Цирк тобының айналасында орналасқан Джубанды біртүрлі сезім билейді.
Dialogue: 0,1:06:55.59,1:06:57.43,Default,,0,0,0,,Кедергіден басқа миды жуу толқындары да бар...
Dialogue: 0,1:06:57.51,1:06:58.89,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,1:06:58.97,1:07:01.43,Default,,0,0,0,,Менің ойымша, сондықтан мен өзгере алмаймын ...
Dialogue: 0,1:07:01.52,1:07:02.52,Default,,0,0,0,,Мина?
Dialogue: 0,1:07:02.60,1:07:04.56,Default,,0,0,0,,А, уһ, ештеңе!
Dialogue: 0,1:07:04.65,1:07:07.73,Default,,0,0,0,,Ами-чан, мен сол тосқауыл бойынша деректерді өзім зерттедім.
Dialogue: 0,1:07:07.82,1:07:08.52,Default,,0,0,0,,Керемет!
Dialogue: 0,1:07:08.61,1:07:11.78,Default,,0,0,0,,Иә, маған Сецуна-сан берген бағдарламамен.
Dialogue: 0,1:07:11.86,1:07:13.45,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,1:07:13.53,1:07:15.20,Default,,0,0,0,,Тікұшақтың дыбысын естігенде
Dialogue: 0,1:07:15.28,1:07:17.66,Default,,0,0,0,,Бұл маған Харуканы және басқаларды еске түсіреді.
Dialogue: 0,1:07:18.45,1:07:20.49,Default,,0,0,0,,Харука-сан сияқты тікұшақ және басқалар...
Dialogue: 0,1:07:20.58,1:07:21.62,Default,,0,0,0,,5 рет
Dialogue: 0,1:07:21.70,1:07:22.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:22.66,1:07:25.33,Default,,0,0,0,,Осы үш есімнің бүгін неше рет келгені
Dialogue: 0,1:07:25.42,1:07:26.71,Default,,0,0,0,,барлығы 5 рет
Dialogue: 0,1:07:27.58,1:07:30.09,Default,,0,0,0,,Мұнда жоқ адамдар туралы ойлаудың пайдасы жоқ деп ойлаймын!
Dialogue: 0,1:07:30.17,1:07:31.05,Default,,0,0,0,,Мина?
Dialogue: 0,1:07:31.13,1:07:33.80,Default,,0,0,0,,Үш адамға сенуге болады дейді.
Dialogue: 0,1:07:35.26,1:07:37.26,Default,,0,0,0,,Мен бәрібір сенімсіз көшбасшымын!
Dialogue: 0,1:07:37.34,1:07:39.60,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз.
Dialogue: 0,1:07:39.68,1:07:41.52,Default,,0,0,0,,Мина... Бүгін біртүрлі.
Dialogue: 0,1:07:42.39,1:07:43.81,Default,,0,0,0,,Бәрібір біртүрлі!
Dialogue: 0,1:07:43.89,1:07:46.73,Default,,0,0,0,,Біртүрлі болған дұрыс!
Dialogue: 0,1:07:47.40,1:07:48.40,Default,,0,0,0,,Мина!
Dialogue: 0,1:07:48.98,1:07:50.73,Default,,0,0,0,,О, бұл сұмдық!
Dialogue: 0,1:07:50.82,1:07:52.94,Default,,0,0,0,,Бұл мені көшбасшы ретінде айырады!
Dialogue: 0,1:07:55.03,1:07:56.32,Default,,0,0,0,,(Мұрынды шұқылау дыбысы)
Dialogue: 0,1:07:56.41,1:07:57.66,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,1:07:57.74,1:08:00.16,Default,,0,0,0,,Сіз кумирді тыңдағыңыз келе ме?
Dialogue: 0,1:08:01.62,1:08:04.04,Default,,0,0,0,,Мина! Сіз не ойлап отырсыз?
Dialogue: 0,1:08:04.12,1:08:05.71,Default,,0,0,0,,Сіз жалғыз отыруды жоспарлап отырсыз ба?
Dialogue: 0,1:08:05.79,1:08:07.29,Default,,0,0,0,,Мен өзгере алмасам да
Dialogue: 0,1:08:07.37,1:08:08.58,Default,,0,0,0,,О? Біреуге ғашық болдың ба?
Dialogue: 0,1:08:08.67,1:08:09.29,Default,,0,0,0,,Мугага...
Dialogue: 0,1:08:09.38,1:08:10.34,Default,,0,0,0,,Мен де
Dialogue: 0,1:08:10.42,1:08:12.46,Default,,0,0,0,,Менің білетінім - бұл Өлі Айдың тұзағы.
Dialogue: 0,1:08:13.17,1:08:15.59,Default,,0,0,0,,Мен көшбасшымын, маған әрекет етсе болғаны!
Dialogue: 0,1:08:16.18,1:08:17.47,Default,,0,0,0,,Теңізші Венера
Dialogue: 0,1:08:17.55,1:08:20.80,Default,,0,0,0,,Мен сізге қызық үшін де, пайда үшін де күресуге рұқсат етемін!
Dialogue: 0,1:08:23.60,1:08:26.73,Default,,0,0,0,,
Dialogue: 0,1:08:26.81,1:08:28.02,Default,,0,0,0,,Баршаңыз!
Dialogue: 0,1:08:28.10,1:08:29.10,Default,,0,0,0,,Олай болса
Dialogue: 0,1:08:29.19,1:08:32.36,Default,,0,0,0,,Тыңдау өтетін шатырдың ішіне кіріңіз!
Dialogue: 0,1:08:32.44,1:08:34.15,Default,,0,0,0,,​​Джунгли?
Dialogue: 0,1:08:34.94,1:08:36.53,Default,,0,0,0,,Енді аман қалу тыңдалымы.
Dialogue: 0,1:08:36.61,1:08:37.91,Default,,0,0,0,,Бастау!
Dialogue: 0,1:08:37.99,1:08:40.70,Default,,0,0,0,,Бұл тыңдау оқиғаға негізделген.
Dialogue: 0,1:08:40.78,1:08:43.04,Default,,0,0,0,,Әр адам батырға айналып, джунглиден өтеді.
Dialogue: 0,1:08:43.12,1:08:46.21,Default,,0,0,0,,Сол мұнарадағы балаларды құтқарыңдар!
Dialogue: 0,1:08:46.29,1:08:48.25,Default,,0,0,0,,Балалар осындай жерде!
Dialogue: 0,1:08:48.33,1:08:51.04,Default,,0,0,0,,Бірінші орын 5 миллион иен мөлшерінде сыйлық алады.
Dialogue: 0,1:08:51.13,1:08:53.25,Default,,0,0,0,,Idol дебютіне кепілдік беріледі!
Dialogue: 0,1:08:53.34,1:08:54.84,Default,,0,0,0,,Бастайық!
Dialogue: 0,1:08:55.67,1:08:58.68,Default,,0,0,0,,Иә! Барған сайын көбірек энергияны босатыңыз
Dialogue: 0,1:08:58.76,1:09:01.39,Default,,0,0,0,,Бұл энергия және сіздің армандарыңыз
Dialogue: 0,1:09:01.47,1:09:04.06,Default,,0,0,0,,Ремрес оны қорқынышты түске айналдырады.
Dialogue: 0,1:09:04.85,1:09:07.23,Default,,0,0,0,,Барлығыңыз тынышталыңыздар! Эй, эй!
Dialogue: 0,1:09:07.31,1:09:08.10,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,1:09:08.19,1:09:09.60,Default,,0,0,0,,Біз кумирге айналамыз!
Dialogue: 0,1:09:11.90,1:09:12.77,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:09:12.86,1:09:13.69,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:17.11,1:09:18.03,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:19.36,1:09:20.41,Default,,0,0,0,,Юпитер!
Dialogue: 0,1:09:20.49,1:09:22.62,Default,,0,0,0,,Мина! Бізде енді ондай ештеңе жоқ!
Dialogue: 0,1:09:22.70,1:09:23.62,Default,,0,0,0,,Иә!
Dialogue: 0,1:09:23.70,1:09:25.70,Default,,0,0,0,,Отырғызу кезінде барлығы бірге!
Dialogue: 0,1:09:25.79,1:09:28.29,Default,,0,0,0,,Марс! Меркурий!
Dialogue: 0,1:09:28.37,1:09:29.67,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:09:29.75,1:09:30.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:30.67,1:09:32.13,Default,,0,0,0,,Минаны өзгерту!
Dialogue: 0,1:09:33.63,1:09:37.63,Default,,0,0,0,,Венера планетасының қуатты макияжы!
Dialogue: 0,1:09:38.26,1:09:38.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:38.97,1:09:39.97,Default,,0,0,0,,Мина?
Dialogue: 0,1:09:40.93,1:09:43.97,Default,,0,0,0,,Жоқ, мен өзгере алмаймын!
Dialogue: 0,1:09:44.05,1:09:45.35,Default,,0,0,0,,Алға!
Dialogue: 0,1:09:45.43,1:09:47.10,Default,,0,0,0,,Мина!
Dialogue: 0,1:09:47.18,1:09:48.77,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:09:50.14,1:09:50.89,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:09:50.98,1:09:52.90,Default,,0,0,0,,Кекекеке!
Dialogue: 0,1:09:52.98,1:09:56.15,Default,,0,0,0,,Әр адамның таза арманын қалай пайдалануға болады?
Dialogue: 0,1:09:56.23,1:09:57.19,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,1:09:57.28,1:09:58.36,Default,,0,0,0,,Мина!
Dialogue: 0,1:09:59.28,1:10:03.16,Default,,0,0,0,,Тыңдауға қатыспайтын адамдар бар сияқты.
Dialogue: 0,1:10:03.24,1:10:04.49,Default,,0,0,0,,Егер сіз нашар қозғалсаңыз
Dialogue: 0,1:10:04.58,1:10:09.62,Default,,0,0,0,,Мен өзгере алмайтын достарыңның өміріне кепілдік бере алмаймын.
Dialogue: 0,1:10:09.71,1:10:11.42,Default,,0,0,0,,Келіңдер, Лемурлар.
Dialogue: 0,1:10:11.50,1:10:14.63,Default,,0,0,0,,Теңізші Сенши жеп қойды!
Dialogue: 0,1:10:14.71,1:10:15.79,Default,,0,0,0,,Ахахха!
Dialogue: 0,1:10:15.88,1:10:17.59,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:20.26,1:10:23.64,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,1:10:23.72,1:10:24.55,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:10:24.64,1:10:25.89,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:10:26.64,1:10:27.60,Default,,0,0,0,,Кекекеке…
Dialogue: 0,1:10:27.68,1:10:29.52,Default,,0,0,0,,Жоқ! Алақай!
Dialogue: 0,1:10:33.60,1:10:34.69,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,1:10:34.77,1:10:37.19,Default,,0,0,0,,Көптеген кедергілерден өтті
Dialogue: 0,1:10:37.27,1:10:40.15,Default,,0,0,0,,Сіз бұған дейін бірінші орында келдіңіз.
Dialogue: 0,1:10:40.78,1:10:43.07,Default,,0,0,0,,Енді кумир болуға бір қадам жақындады
Dialogue: 0,1:10:43.16,1:10:46.58,Default,,0,0,0,,Соңында, біз сізге арнайы қазына іздеуді ұсынамыз.
Dialogue: 0,1:10:48.29,1:10:49.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:10:50.41,1:10:52.04,Default,,0,0,0,,Мен өзімді ессіз сезінемін...
Dialogue: 0,1:10:52.75,1:10:53.87,Default,,0,0,0,,Хехехе
Dialogue: 0,1:10:53.96,1:10:56.54,Default,,0,0,0,,Сіз енді Өлі Айдың мүшесісіз.
Dialogue: 0,1:10:57.34,1:11:00.05,Default,,0,0,0,,Енді достарыңызға барыңыз
Dialogue: 0,1:11:00.13,1:11:02.80,Default,,0,0,0,,Күміс кристалды алып тастаңыз!
Dialogue: 0,1:11:02.88,1:11:05.39,Default,,0,0,0,,Фантомдық күміс кристалы
Dialogue: 0,1:11:05.47,1:11:08.81,Default,,0,0,0,,Қолымызда, Өлі Ай...
Dialogue: 0,1:11:08.89,1:11:09.81,Default,,0,0,0,,Тағы да оралып келдім
Dialogue: 0,1:11:09.89,1:11:11.06,Default,,0,0,0,,Няняняня…
Dialogue: 0,1:11:11.68,1:11:13.02,Default,,0,0,0,,Мықты бол, Мина!
Dialogue: 0,1:11:13.94,1:11:14.94,Default,,0,0,0,,Артемида?
Dialogue: 0,1:11:15.02,1:11:15.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:11:17.69,1:11:18.86,Default,,0,0,0,,Өтірік!
Dialogue: 0,1:11:18.94,1:11:19.78,Default,,0,0,0,,Мияу!
Dialogue: 0,1:11:21.78,1:11:22.78,Default,,0,0,0,,Артемида!
Dialogue: 0,1:11:23.36,1:11:26.32,Default,,0,0,0,,Жоқ... қолым үзіліп кететін сияқты!
Dialogue: 0,1:11:27.41,1:11:30.49,Default,,0,0,0,,Маған да осы жерде көңіл көтеруіңізді өтінемін.
Dialogue: 0,1:11:31.37,1:11:32.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:11:36.42,1:11:37.88,Default,,0,0,0,,Артемида!
Dialogue: 0,1:11:39.96,1:11:41.38,Default,,0,0,0,,Артемида…
Dialogue: 0,1:11:43.26,1:11:46.59,Default,,0,0,0,,Менің бүкіл денем қатты ауырады
Dialogue: 0,1:11:46.68,1:11:49.51,Default,,0,0,0,,Қатты ауырып тұр, Артемида!
Dialogue: 0,1:11:49.60,1:11:52.85,Default,,0,0,0,,Сен менімен әрқашан бірсің.
Dialogue: 0,1:11:52.93,1:11:54.77,Default,,0,0,0,,Ол менің альтер эго болды!
Dialogue: 0,1:12:01.82,1:12:03.28,Default,,0,0,0,,(Норияки Какёин) Бұл бөлмедегі қиратулар барған сайын тереңдей түсуде.
Dialogue: 0,1:12:04.32,1:12:07.03,Default,,0,0,0,,Мина, сен өзгере алмадың.
Dialogue: 0,1:12:08.57,1:12:11.99,Default,,0,0,0,,Менің серігім, күшім жетпегендіктен!
Dialogue: 0,1:12:12.58,1:12:14.12,Default,,0,0,0,,Артемида?
Dialogue: 0,1:12:14.75,1:12:15.62,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:12:17.37,1:12:19.75,Default,,0,0,0,,Денемді қуат толтырады
Dialogue: 0,1:12:20.42,1:12:23.88,Default,,0,0,0,,Біз бұрынғыдан әлдеқайда көп байланыстамыз.
Dialogue: 0,1:12:23.96,1:12:26.01,Default,,0,0,0,,Мен және Артемида...
Dialogue: 0,1:12:31.97,1:12:34.64,Default,,0,0,0,,Бұл сіздің Венера Кристаллыңыз, Мина.
Dialogue: 0,1:12:35.64,1:12:37.60,Default,,0,0,0,,Енді түрленейік!
Dialogue: 0,1:12:39.90,1:12:42.27,Default,,0,0,0,,Венераның кристалдық күші
Dialogue: 0,1:12:42.36,1:12:44.03,Default,,0,0,0,,Макияж!
Dialogue: 0,1:13:12.14,1:13:13.72,Default,,0,0,0,,Сұлулық жұлдызы!
Dialogue: 0,1:13:13.81,1:13:16.77,Default,,0,0,0,,Венера өзінің қамқоршысы болған махаббат жауынгері!
Dialogue: 0,1:13:16.85,1:13:18.60,Default,,0,0,0,,Теңізші Венера!
Dialogue: 0,1:13:19.40,1:13:23.07,Default,,0,0,0,,Махаббаттың илаһи жазасынан бас тартамын!
Dialogue: 0,1:13:23.61,1:13:25.03,Default,,0,0,0,,Венера!
Dialogue: 0,1:13:25.11,1:13:26.78,Default,,0,0,0,,Артемида!
Dialogue: 0,1:13:26.86,1:13:28.40,Default,,0,0,0,,Бар!
Dialogue: 0,1:13:28.49,1:13:30.36,Default,,0,0,0,,Ал, мына Венера.
Dialogue: 0,1:13:30.45,1:13:33.83,Default,,0,0,0,,Сен мені қатты қинадың, қоқыс сияқты қарадың!
Dialogue: 0,1:13:33.91,1:13:37.79,Default,,0,0,0,,Венера құдайының махаббат қамшысын қабыл алыңыздар!
Dialogue: 0,1:13:38.50,1:13:39.46,Default,,0,0,0,,Венера!
Dialogue: 0,1:13:41.96,1:13:42.58,Default,,0,0,0,,Уау
Dialogue: 0,1:13:44.59,1:13:47.55,Default,,0,0,0,,Махаббат пен сұлулық соққысы!
Dialogue: 0,1:13:47.63,1:13:48.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:48.97,1:13:51.05,Default,,0,0,0,,Гяаа!
Dialogue: 0,1:13:51.14,1:13:53.01,Default,,0,0,0,,Бар!
Dialogue: 0,1:13:56.10,1:13:57.02,Default,,0,0,0,,Әй!
Dialogue: 0,1:13:57.10,1:13:58.77,Default,,0,0,0,,Ахх!
Dialogue: 0,1:13:58.85,1:14:00.73,Default,,0,0,0,,Гяаа!
Dialogue: 0,1:14:04.15,1:14:05.11,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:14:05.19,1:14:06.69,Default,,0,0,0,,Венера!
Dialogue: 0,1:14:06.78,1:14:08.03,Default,,0,0,0,,Сіз өзгере алдыңыз!
Dialogue: 0,1:14:08.11,1:14:09.82,Default,,0,0,0,,Барлығыңызды кешіріңіз!
Dialogue: 0,1:14:09.90,1:14:11.53,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,1:14:12.82,1:14:14.03,Default,,0,0,0,,Керемет!
Dialogue: 0,1:14:14.12,1:14:17.54,Default,,0,0,0,,Артемида, мұның бәрі сенің арқаң.
Dialogue: 0,1:14:18.12,1:14:19.04,Default,,0,0,0,,Мина…
Dialogue: 0,1:14:19.12,1:14:20.25,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:14:20.33,1:14:22.33,Default,,0,0,0,,Керемет оқиға!
Dialogue: 0,1:14:22.42,1:14:25.54,Default,,0,0,0,,Бұл Amazon квартеті оны жандандырады!
Dialogue: 0,1:14:25.63,1:14:26.59,Default,,0,0,0,,Парапара!
Dialogue: 0,1:14:26.67,1:14:28.05,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,1:14:28.13,1:14:29.72,Default,,0,0,0,,Тамаказура!
Dialogue: 0,1:14:30.38,1:14:32.01,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:14:32.09,1:14:33.01,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:35.68,1:14:36.51,Default,,0,0,0,,Хехе
Dialogue: 0,1:14:36.60,1:14:40.43,Default,,0,0,0,,Біз Амазонкадағы аты аңызға айналған ең мықты жауынгерміз.
Dialogue: 0,1:14:40.52,1:14:42.27,Default,,0,0,0,,Менде амазониялық қан бар...
Dialogue: 0,1:14:42.35,1:14:44.36,Default,,0,0,0,,Амазонка квартеті!
Dialogue: 0,1:14:44.44,1:14:46.94,Default,,0,0,0,,Amazon квартеті?
Dialogue: 0,1:14:47.02,1:14:50.19,Default,,0,0,0,,Амазонка джунгли Амазонка тропикалық түні
Dialogue: 0,1:14:50.28,1:14:52.57,Default,,0,0,0,,Біз амазонкаларға беріледі⸺
Dialogue: 0,1:14:52.66,1:14:55.41,Default,,0,0,0,,Қарғыс атқан тас Амазонка тасы
Dialogue: 0,1:14:55.49,1:14:58.95,Default,,0,0,0,,Жаңа айдың қараңғылығы астында шын күшін танытқан адам
Dialogue: 0,1:14:59.04,1:15:00.87,Default,,0,0,0,,Бұдан былай
Dialogue: 0,1:15:00.95,1:15:02.87,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:15:02.96,1:15:03.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:04.88,1:15:05.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:15:05.67,1:15:06.63,Default,,0,0,0,,Мина!
Dialogue: 0,1:15:06.71,1:15:09.67,Default,,0,0,0,,Көбірек, көбірек күш...
Dialogue: 0,1:15:10.46,1:15:14.51,Default,,0,0,0,,Жауды жеңу, өзің үшін маңыздыларды қорғау
Dialogue: 0,1:15:14.59,1:15:17.01,Default,,0,0,0,,Күш, жинал!
Dialogue: 0,1:15:17.10,1:15:17.76,Default,,0,0,0,,Ха…
Dialogue: 0,1:15:18.64,1:15:20.27,Default,,0,0,0,,Мен уайымдаймын
Dialogue: 0,1:15:20.98,1:15:23.52,Default,,0,0,0,,Мен бүгін түнде бір жұлдызды көре алмаймын.
Dialogue: 0,1:15:25.10,1:15:27.02,Default,,0,0,0,,Бұл да жаудың ісі ме?
Dialogue: 0,1:15:28.23,1:15:29.23,Default,,0,0,0,,Элиос…
Dialogue: 0,1:15:29.32,1:15:30.57,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:15:31.57,1:15:34.24,Default,,0,0,0,,
Dialogue: 0,1:15:34.32,1:15:36.37,Default,,0,0,0,,Қоян, сен кешігіп қалдың.
Dialogue: 0,1:15:36.45,1:15:38.58,Default,,0,0,0,,Мамо-чанның жағдайы қалай?
Dialogue: 0,1:15:38.66,1:15:41.16,Default,,0,0,0,,Сузуха ше? Хмм?
Dialogue: 0,1:15:41.25,1:15:42.08,Default,,0,0,0,,
Dialogue: 0,1:15:42.91,1:15:44.08,Default,,0,0,0,,Қоян?
Dialogue: 0,1:15:45.62,1:15:48.88,Default,,0,0,0,,Лорд Нехеления, ақыры осында.
Dialogue: 0,1:15:49.59,1:15:52.92,Default,,0,0,0,,Жиналған халықтың түнгі түндерінің күшімен
Dialogue: 0,1:15:53.01,1:15:56.89,Default,,0,0,0,,Бұл жұлдызды өлім жұлдызына айналдыр!
Dialogue: 0,1:16:00.18,1:16:02.18,Default,,0,0,0,,♪~
Dialogue: 0,1:19:41.32,1:19:43.32,Default,,0,0,0,,~♪
Dialogue: 0,1:19:43.40,1:19:46.20,Default,,0,0,0,,Шынында да, біраз аян жақын.
Dialogue: 0,1:19:47.87,1:19:50.70,Default,,0,0,0,,Шынында да, екінші келу уақыты жақын.
Dialogue: 0,1:19:51.91,1:19:55.67,Default,,0,0,0,,«Қайтару» Осы сөзді айтқан бойда
Dialogue: 0,1:19:56.33,1:19:59.17,Default,,0,0,0,,Дүниенің рухтарынан алынған алып бейне
