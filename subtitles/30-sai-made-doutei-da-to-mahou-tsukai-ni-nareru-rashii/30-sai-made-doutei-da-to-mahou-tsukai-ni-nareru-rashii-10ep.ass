Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:05.53,Default,,0,0,0,,Мен Адачиге ұқсамай, не ойлап отырмын?➡
Dialogue: 0,0:00:05.53,0:00:07.64,Default,,0,0,0,,Сөзбен жеткізбейінше түсінбеймін.
Dialogue: 0,0:00:07.64,0:00:18.15,Default,,0,0,0,,♬～
Dialogue: 0,0:02:03.09,0:02:05.29,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:02:05.29,0:02:09.12,Default,,0,0,0,,Эй, Цюге романс жазушысы болған.
Dialogue: 0,0:02:09.12,0:02:11.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:11.76,0:02:14.80,Default,,0,0,0,,Неліктен олай болды...?
Dialogue: 0,0:02:14.80,0:02:16.97,Default,,0,0,0,,Кітап дүкенінде тізіліп тұрған жаңа кітаптарды көрдім.
Dialogue: 0,0:02:21.10,0:02:23.94,Default,,0,0,0,,Сіз оны оқыдыңыз ба? Иә.
Dialogue: 0,0:02:23.94,0:02:27.78,Default,,0,0,0,,Басты кейіпкердің сүйікті биші нағыз қатал мінезді➡
Dialogue: 0,0:02:27.78,0:02:30.18,Default,,0,0,0,,Бұл таңқаларлық сүйкімді және қызықты болды.
Dialogue: 0,0:02:32.45,0:02:35.95,Default,,0,0,0,,Кешіріңіз. Неге кешірім сұрадың?
Dialogue: 0,0:02:35.95,0:02:39.82,Default,,0,0,0,,Цюге бірнеше кітап шығарды.
Dialogue: 0,0:02:39.82,0:02:43.46,Default,,0,0,0,,Керемет. Бұл мұғалім.
Dialogue: 0,0:02:43.46,0:02:47.43,Default,,0,0,0,,Жақсы. Бір нәрсе➡
Dialogue: 0,0:02:47.43,0:02:50.60,Default,,0,0,0,,Оны ұзақ уақыт бойы ұстап тұрудың айласы бар ма?
Dialogue: 0,0:02:50.60,0:02:53.94,Default,,0,0,0,,Жалғастырудың амалы бар ма?
Dialogue: 0,0:02:53.94,0:02:58.64,Default,,0,0,0,,Оны оқып отырған адамның жүзін елестетіңіз...мүмкін.
Dialogue: 0,0:03:00.61,0:03:03.51,Default,,0,0,0,,Соңында оқитын адам болмаса➡
Dialogue: 0,0:03:03.51,0:03:06.78,Default,,0,0,0,,Шығармашылық жай ғана сөз.
Dialogue: 0,0:03:09.79,0:03:12.79,Default,,0,0,0,,Мм. Одан да көп➡
Dialogue: 0,0:03:12.79,0:03:16.22,Default,,0,0,0,,Менің ойымша, ертең маңызды би тыңдауы болады.
Dialogue: 0,0:03:16.22,0:03:18.96,Default,,0,0,0,,Жартылай финалға өткеніңіз ғажап емес пе?
Dialogue: 0,0:03:18.96,0:03:23.33,Default,,0,0,0,,Иә. Бұл жолы ірі компанияның демеушілігімен тікелей эфир болады➡
Dialogue: 0,0:03:23.33,0:03:26.44,Default,,0,0,0,,Өйткені, SHOWTA – төрешілердің бірі.
Dialogue: 0,0:03:26.44,0:03:29.60,Default,,0,0,0,,Шота? Университет күндерімде бір рет қана➡
Dialogue: 0,0:03:29.60,0:03:32.27,Default,,0,0,0,,Бірде сахнада бірге өнер көрсеттік.
Dialogue: 0,0:03:32.27,0:03:34.94,Default,,0,0,0,,Бұл өте қауіпті...
Dialogue: 0,0:03:34.94,0:03:37.31,Default,,0,0,0,,Құдай мен үшін➡
Dialogue: 0,0:03:37.31,0:03:40.62,Default,,0,0,0,,Бұл менің кәсіби биші болуға талпындырды.
Dialogue: 0,0:03:40.62,0:03:42.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:42.78,0:03:47.12,Default,,0,0,0,,Бұл Осаму Дазайдың романға іріктеу комиссиясында болғаны сияқты.
Dialogue: 0,0:03:47.12,0:03:51.93,Default,,0,0,0,,Бұл да сіздің рухыңызды арттырады. иә? Менің ойымша, солай.
Dialogue: 0,0:03:51.93,0:03:55.13,Default,,0,0,0,,Минатоның жақсы болатынына сенімдімін.
Dialogue: 0,0:03:55.13,0:03:57.20,Default,,0,0,0,,Қолдау.
Dialogue: 0,0:04:04.27,0:04:06.68,Default,,0,0,0,,《Адачи: Мен ұйықтай алмадым...》
Dialogue: 0,0:04:09.44,0:04:12.28,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:12.28,0:04:17.35,Default,,0,0,0,,《Куросаваның ауыр дауысы әлі күнге дейін құлағымда сыңғырлайды》
Dialogue: 0,0:04:17.35,0:04:21.12,Default,,0,0,0,,｟Нагасакиге ауысу ұсынысынан бас тартқаныңыз рас па?
Dialogue: 0,0:04:21.12,0:04:24.96,Default,,0,0,0,,А... Қайдан білесің...
Dialogue: 0,0:04:24.96,0:04:28.50,Default,,0,0,0,,Неге... Неліктен маңызды➡
Dialogue: 0,0:04:28.50,0:04:31.77,Default,,0,0,0,,Сіз өзіңіз шешім қабылдайсыз!
Dialogue: 0,0:04:31.77,0:04:33.74,Default,,0,0,0,,Алыста жүргенше➡
Dialogue: 0,0:04:33.74,0:04:37.44,Default,,0,0,0,,Мен сені енді ғана менімен ажырасатын шығар деп ойладым.
Dialogue: 0,0:04:37.44,0:04:40.41,Default,,0,0,0,,《Ондай нәрсеге қандай себеп болғанына қарамастан➡
Dialogue: 0,0:04:40.41,0:04:44.35,Default,,0,0,0,,Мен сізге айтпаймын.
Dialogue: 0,0:04:44.35,0:04:48.75,Default,,0,0,0,,Мен Адачиге ұқсамай, не ойлап отырмын?➡
Dialogue: 0,0:04:48.75,0:04:52.42,Default,,0,0,0,,Сөзбен жеткізбейінше түсінбеймін｠
Dialogue: 0,0:04:52.42,0:04:55.92,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:55.92,0:04:58.69,Default,,0,0,0,,Бүгін демалыс күні болғанына қуаныштымын. (шу)
Dialogue: 0,0:05:09.44,0:05:12.44,Default,,0,0,0,,көремін. Бұл сенің кінәң.
Dialogue: 0,0:05:12.44,0:05:14.74,Default,,0,0,0,,Боу! Сіз кездесіп жүрген адам➡
Dialogue: 0,0:05:14.74,0:05:18.91,Default,,0,0,0,,Осы уақытта басқа адамдармен кеңесіңіз...
Dialogue: 0,0:05:18.91,0:05:23.22,Default,,0,0,0,,Неліктен бас тартқанын айтпайды, себебі ол сені ренжіткісі келмейді.
Dialogue: 0,0:05:23.22,0:05:27.09,Default,,0,0,0,,Бұл басқа адамды алаңдатады.
Dialogue: 0,0:05:27.09,0:05:29.93,Default,,0,0,0,,Мен ойларды оқи алмаймын.
Dialogue: 0,0:05:29.93,0:05:33.60,Default,,0,0,0,,Бізге ұқсамайды.
Dialogue: 0,0:05:33.60,0:05:37.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:37.00,0:05:39.20,Default,,0,0,0,,Мен біраздан бері уайымдап жүрмін...
Dialogue: 0,0:05:41.57,0:05:43.91,Default,,0,0,0,,Сіз мейірімсіз айтасыз➡
Dialogue: 0,0:05:43.91,0:05:46.78,Default,,0,0,0,,Теріс десек, өзімді бағалауым төмен➡
Dialogue: 0,0:05:46.78,0:05:49.24,Default,,0,0,0,,Өзіңізге ұнайтын адамның ойын оқи алсаңыз...
Dialogue: 0,0:05:52.41,0:05:55.25,Default,,0,0,0,,Басқа адамның қалағанын оларға байқамай орындаңыз➡
Dialogue: 0,0:05:55.25,0:05:58.09,Default,,0,0,0,,Бұзықтық жасай ма деп қорықтым.
Dialogue: 0,0:05:58.09,0:06:01.09,Default,,0,0,0,,Ах…. Бір күні сиқыр жоғалады➡
Dialogue: 0,0:06:01.09,0:06:03.39,Default,,0,0,0,,Ойды оқи алмағанда не істейсің?
Dialogue: 0,0:06:05.76,0:06:09.93,Default,,0,0,0,,Дұрыс. мен….
Dialogue: 0,0:06:09.93,0:06:14.44,Default,,0,0,0,,Мен мұны білмей тұрып, мен бұл күшке тым тәуелді болдым.
Dialogue: 0,0:06:14.44,0:06:17.57,Default,,0,0,0,,《Куросаваның ойын қанша оқи алсам да➡
Dialogue: 0,0:06:17.57,0:06:21.08,Default,,0,0,0,,Мен өзімнің шынайы сезімімді сөзбен жеткізуім керек➡
Dialogue: 0,0:06:21.08,0:06:25.01,Default,,0,0,0,,Ештеңе басталмағанымен.
Dialogue: 0,0:06:25.01,0:06:28.92,Default,,0,0,0,,Мен... Енді мен Куросава боламын➡
Dialogue: 0,0:06:28.92,0:06:31.09,Default,,0,0,0,,Мен өз сезімімді дұрыс жеткізуім керек》
Dialogue: 0,0:06:33.09,0:06:36.42,Default,,0,0,0,,Бірақ... Не?
Dialogue: 0,0:06:36.42,0:06:39.59,Default,,0,0,0,,Айтуға тура келетінін ішіңізде білсеңіз де➡
Dialogue: 0,0:06:39.59,0:06:45.07,Default,,0,0,0,,Мен сөйлейін десем, сөздерді дұрыс айта алмаймын...
Dialogue: 0,0:06:45.07,0:06:51.41,Default,,0,0,0,,Мен Куросаваның мұндай беймаза эмоцияларын бірінші рет бастан өткеруім...
Dialogue: 0,0:06:51.41,0:06:55.28,Default,,0,0,0,,Сіз байсалдысыз ба? Сіз де➡
Dialogue: 0,0:06:55.28,0:06:57.81,Default,,0,0,0,,Сол Куросава жігіті де.
Dialogue: 0,0:06:57.81,0:07:02.25,Default,,0,0,0,,Иә. Саған айтпасам жақсы емес.
Dialogue: 0,0:07:02.25,0:07:06.42,Default,,0,0,0,,А, мен қазіргі сезімдерімді электрондық пошта арқылы жақсырақ жеткізе алатын шығармын.
Dialogue: 0,0:07:06.42,0:07:10.29,Default,,0,0,0,,Мен оны сабырмен ұрып аламын. Жоқ, онда➡
Dialogue: 0,0:07:10.29,0:07:13.09,Default,,0,0,0,,Басқа жол бар.
Dialogue: 0,0:07:13.09,0:07:16.46,Default,,0,0,0,,♬～
Dialogue: 0,0:07:16.46,0:07:19.50,Default,,0,0,0,,♬～
Dialogue: 0,0:07:19.50,0:07:25.64,Default,,0,0,0,,♬～
Dialogue: 0,0:07:25.64,0:07:28.14,Default,,0,0,0,,《SHOWTA қарап тұр.
Dialogue: 0,0:07:28.14,0:07:31.25,Default,,0,0,0,,Мен сізге ең жақсы жерін көрсетуім керек...》
Dialogue: 0,0:07:31.25,0:07:34.15,Default,,0,0,0,,Бұл бала жақсы. Сыртқы түрі де жақсы.
Dialogue: 0,0:07:36.28,0:07:39.32,Default,,0,0,0,,Міне. үшін сәтсіз аяқталды.
Dialogue: 0,0:07:39.32,0:07:42.59,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:07:42.59,0:07:46.09,Default,,0,0,0,,Сіз 125 нөмірсіз. иә!
Dialogue: 0,0:07:46.09,0:07:49.00,Default,,0,0,0,,Сізде дағдылар бар.
Dialogue: 0,0:07:49.00,0:07:50.97,Default,,0,0,0,,Бірақ солай.
Dialogue: 0,0:07:54.44,0:07:58.51,Default,,0,0,0,,📺Жартылай финалда өкінішке орай 18 адам жеңілді.
Dialogue: 0,0:07:58.51,0:08:02.08,Default,,0,0,0,,📺Көрермендер арасында 1-ші орын алдағы қайталау матчына дауыс береді➡
Dialogue: 0,0:08:02.08,0:08:05.08,Default,,0,0,0,,Сізде әлі де финалға өту мүмкіндігі бар!
Dialogue: 0,0:08:08.58,0:08:10.69,Default,,0,0,0,,А…?
Dialogue: 0,0:08:15.29,0:08:17.93,Default,,0,0,0,,⚟Жылама! ⚟Әлі біткен жоқ.
Dialogue: 0,0:08:17.93,0:08:20.76,Default,,0,0,0,,Жеңілген адамның қайта тірілу матчы Қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,0:08:20.76,0:08:23.93,Default,,0,0,0,,《Өте жас. Сіз орта мектеп оқушысысыз ба?
Dialogue: 0,0:08:23.93,0:08:27.10,Default,,0,0,0,,Бүгін де айналада тек жастар ғана болды.
Dialogue: 0,0:08:27.10,0:08:31.77,Default,,0,0,0,,Минато! Хм... Юта Хашигучи.
Dialogue: 0,0:08:31.77,0:08:35.11,Default,,0,0,0,,Кешіріңіз. Сіз мені қолдау үшін келдіңіз.
Dialogue: 0,0:08:35.11,0:08:38.25,Default,,0,0,0,,Уау, Минато... Ол өте азғындық танытты➡
Dialogue: 0,0:08:38.25,0:08:40.78,Default,,0,0,0,,Мен бұл міндетті түрде жұмыс істейді деп ойладым.
Dialogue: 0,0:08:40.78,0:08:44.45,Default,,0,0,0,,Дұрыс! Көрермендердің дауыс беруін не күтіп тұр?
Dialogue: 0,0:08:44.45,0:08:47.82,Default,,0,0,0,,Біз ынтымақтастық жасаймыз. Өтінемін, маған айқайлаңыз.
Dialogue: 0,0:08:47.82,0:08:49.99,Default,,0,0,0,,Бұл алдау болар еді.
Dialogue: 0,0:08:52.09,0:08:55.10,Default,,0,0,0,,Мүмкін уақыт келді. Минато...
Dialogue: 0,0:08:55.10,0:08:58.60,Default,,0,0,0,,Ха! ? Сізге сәттілік!
Dialogue: 0,0:08:58.60,0:09:01.50,Default,,0,0,0,,Дұрыс. Енді ішуге барамыз ба?
Dialogue: 0,0:09:01.50,0:09:04.27,Default,,0,0,0,,Нашар. Менде түнгі ауысым бар.
Dialogue: 0,0:09:04.27,0:09:06.94,Default,,0,0,0,,көремін.
Dialogue: 0,0:09:06.94,0:09:10.61,Default,,0,0,0,,Рахмет. 📱 (дірілдеген дыбыс)
Dialogue: 0,0:09:10.61,0:09:13.95,Default,,0,0,0,,Хмм... Хашигучи?
Dialogue: 0,0:09:13.95,0:09:16.55,Default,,0,0,0,,Енді? Жарайды бірақ.
Dialogue: 0,0:09:16.55,0:09:20.72,Default,,0,0,0,,📱 (Хашигучи) Нашар. Күні бойы не айтарымды білмедім, бірақ...
Dialogue: 0,0:09:23.16,0:09:25.76,Default,,0,0,0,,Толық жұмыс күні? 📱(Хашигучи) Мен жұмыс істейтін компанияда➡
Dialogue: 0,0:09:25.76,0:09:29.73,Default,,0,0,0,,Кенеттен бос орын пайда болды, мен қызметкер іздедім.
Dialogue: 0,0:09:29.73,0:09:32.73,Default,,0,0,0,,📱Егер бұл Минато болса, ол байсалды және бұл жаман компания➡
Dialogue: 0,0:09:32.73,0:09:36.10,Default,,0,0,0,,Әлеуметтік жәрдемақылар өте жақсы...
Dialogue: 0,0:09:36.10,0:09:39.47,Default,,0,0,0,,📱Мен де Минатоның билеу арманын қолдаймын.
Dialogue: 0,0:09:39.47,0:09:43.75,Default,,0,0,0,,📱Мен неге президентпен кездеспеске деп ойладым...
Dialogue: 0,0:09:48.28,0:09:51.45,Default,,0,0,0,,Бізде қызметкерлердің жатақханасы және тұрғын үй субсидиялары бар.
Dialogue: 0,0:09:51.45,0:09:54.59,Default,,0,0,0,,Менің жалақым өседі деп үміттенемін. Яғни➡
Dialogue: 0,0:09:54.59,0:09:58.46,Default,,0,0,0,,Менің ойымша, бұл Хашигучи-кунның жұмысына байланысты. Бұл дұрыс.
Dialogue: 0,0:09:58.46,0:10:00.50,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:00.50,0:10:02.46,Default,,0,0,0,,Сонда кездескенше, Ватая-кун.
Dialogue: 0,0:10:04.93,0:10:07.44,Default,,0,0,0,,Бұл жақсы компания.
Dialogue: 0,0:10:07.44,0:10:09.80,Default,,0,0,0,,Президент мырза, сіз өте мейірімдісіз.
Dialogue: 0,0:10:09.80,0:10:14.11,Default,,0,0,0,,Дұрыс па? Дегенмен вокзалдан сәл алыс.
Dialogue: 0,0:10:14.11,0:10:18.08,Default,,0,0,0,,Айтпақшы, Минато, бүгін мұнда келгенім дұрыс па?
Dialogue: 0,0:10:18.08,0:10:23.25,Default,,0,0,0,,Бүгін менің ауысымдағы жалғыз демалыс күнім, сондықтан қазір барсам, уақытында келемін.
Dialogue: 0,0:10:23.25,0:10:26.59,Default,,0,0,0,,Минатоның кіруі кешкі уақытта.
Dialogue: 0,0:10:26.59,0:10:30.66,Default,,0,0,0,,Қазір кетсем сәл ерте болар ма еді...
Dialogue: 0,0:10:30.66,0:10:34.93,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:10:34.93,0:10:39.77,Default,,0,0,0,,Минато? Мен жақында үйден кетейін деп жатырмын...
Dialogue: 0,0:10:39.77,0:10:42.80,Default,,0,0,0,,Не? Мен келуім керек пе?
Dialogue: 0,0:10:42.80,0:10:46.44,Default,,0,0,0,,Негізі менің велосипедім тоқтап қалды.
Dialogue: 0,0:10:46.44,0:10:50.11,Default,,0,0,0,,Вокзал алыс, мен уақытында жетемін деп ойламаймын.
Dialogue: 0,0:10:50.11,0:10:54.98,Default,,0,0,0,,Жетер деп ойлаймын... Неге сонша әлсізсің?
Dialogue: 0,0:10:54.98,0:10:57.79,Default,,0,0,0,,📱(Минато) Ол маған алдыңғы тыңдауда түсіндірді.
Dialogue: 0,0:10:57.79,0:11:01.46,Default,,0,0,0,,«Менде технология бар, бірақ бәрі».
Dialogue: 0,0:11:01.46,0:11:05.59,Default,,0,0,0,,Айналамдағылардың бәрі жас, талантты➡
Dialogue: 0,0:11:05.59,0:11:11.57,Default,,0,0,0,,Жеңілген адамның қайта тірілуінде олардың біреуі ғана жеңіске жетеді.
Dialogue: 0,0:11:11.57,0:11:15.10,Default,,0,0,0,,Велосипед те осындай...
Dialogue: 0,0:11:15.10,0:11:19.77,Default,,0,0,0,,Құдай маған қазірдің өзінде бас тарт деп жатыр ма деп ойлаймын.
Dialogue: 0,0:11:19.77,0:11:23.65,Default,,0,0,0,,📱 (Минато) Сізді қолдағаным үшін кешіріңіз.
Dialogue: 0,0:11:23.65,0:11:25.75,Default,,0,0,0,,📱 (Цуге) Не айтып тұрсың? иә?
Dialogue: 0,0:11:25.75,0:11:27.92,Default,,0,0,0,,Маған ағымдағы орналасқан жеріңізді жіберіңіз.
Dialogue: 0,0:11:27.92,0:11:29.92,Default,,0,0,0,,Мен сені қазір алып кетейін.
Dialogue: 0,0:11:34.82,0:11:39.39,Default,,0,0,0,,Сіз оны алып кеткенде... оның лицензиясы бар ма?
Dialogue: 0,0:11:39.39,0:11:42.46,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:11:42.46,0:11:44.43,Default,,0,0,0,,Минато!
Dialogue: 0,0:11:47.54,0:11:50.74,Default,,0,0,0,,Сіз бұл тыңдауға қанша жұмсадыңыз➡
Dialogue: 0,0:11:50.74,0:11:55.28,Default,,0,0,0,,Мен сенің қаншалықты жаттығу жасағаныңды білемін!
Dialogue: 0,0:11:55.28,0:11:59.28,Default,,0,0,0,,｟Сіз шынымен де әлі бас тартқыңыз келмейді, солай ма?
Dialogue: 0,0:11:59.28,0:12:02.78,Default,,0,0,0,,Әйтпесе, аяқ киім соншалықты бүлінетін еді➡
Dialogue: 0,0:12:02.78,0:12:05.62,Default,,0,0,0,,Мен жаттығу жасамаймын｠
Dialogue: 0,0:12:05.62,0:12:08.96,Default,,0,0,0,,Құдай сізге бас тартуды бұйырғанын білесіз бе?
Dialogue: 0,0:12:08.96,0:12:12.76,Default,,0,0,0,,Сіздің басыңыздың үстінде тұрған адамның сөздерінде қандай мағына бар?
Dialogue: 0,0:12:12.76,0:12:16.13,Default,,0,0,0,,Мен... Мен➡
Dialogue: 0,0:12:16.13,0:12:18.40,Default,,0,0,0,,Минатоның өзі бас тартпаса➡
Dialogue: 0,0:12:18.40,0:12:21.10,Default,,0,0,0,,Мен армандар орындалатынына сенемін!
Dialogue: 0,0:12:21.10,0:12:43.22,Default,,0,0,0,,♬～
Dialogue: 0,0:12:43.22,0:12:45.13,Default,,0,0,0,,Цюге…. Жарайды, жүр!
Dialogue: 0,0:12:45.13,0:12:47.60,Default,,0,0,0,,Рахмет! Мен сені тістеймін!
Dialogue: 0,0:12:52.10,0:12:54.27,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:54.27,0:12:58.64,Default,,0,0,0,,《Жүргеніме біраз болды, қобалжыдым...》
Dialogue: 0,0:12:58.64,0:13:05.45,Default,,0,0,0,,♬～
Dialogue: 0,0:13:05.45,0:13:07.62,Default,,0,0,0,,《Тағы да сіздің деңгейіңіз жоғары.
Dialogue: 0,0:13:07.62,0:13:09.62,Default,,0,0,0,,Артықшылықтары көп》
Dialogue: 0,0:13:09.62,0:13:15.19,Default,,0,0,0,,♬～
Dialogue: 0,0:13:15.19,0:13:19.79,Default,,0,0,0,,｟Цюге: Сіз шынымен де әлі бас тартқыңыз келмейді, солай ма? ｠
Dialogue: 0,0:13:19.79,0:13:23.46,Default,,0,0,0,,《Алғашында біртүрлі жігіт екен деп ойладым.
Dialogue: 0,0:13:23.46,0:13:26.33,Default,,0,0,0,,Бірақ мен бас тартқым келген сайын➡
Dialogue: 0,0:13:26.33,0:13:28.44,Default,,0,0,0,,Ол мені артқа итеріп жіберді》
Dialogue: 0,0:13:28.44,0:13:30.97,Default,,0,0,0,,｟Минатоның өзі бас тартпаса➡
Dialogue: 0,0:13:30.97,0:13:32.94,Default,,0,0,0,,Армандар орындалатынына сенемін! ｠
Dialogue: 0,0:13:34.94,0:13:38.75,Default,,0,0,0,,《Тестілеуден өтуді ойладым➡
Dialogue: 0,0:13:38.75,0:13:41.45,Default,,0,0,0,,Мен қарап тұрған адамдарды ұмытып кеттім.
Dialogue: 0,0:13:41.45,0:13:45.59,Default,,0,0,0,,Камераның екінші жағында, көрермен де➡
Dialogue: 0,0:13:45.59,0:13:49.46,Default,,0,0,0,,Юта мен Хашигучи... менің би достарым да қарап отыр.
Dialogue: 0,0:13:49.46,0:13:51.76,Default,,0,0,0,,Цюге де сенімдімін》
Dialogue: 0,0:13:51.76,0:13:54.63,Default,,0,0,0,,🔊 Жеңілген қайта тірілудің соңғы блогы!
Dialogue: 0,0:13:54.63,0:13:58.40,Default,,0,0,0,,🔊Кіру нөмірі 125 Минато Ватая!
Dialogue: 0,0:13:58.40,0:14:03.40,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:09.58,0:14:12.95,Default,,0,0,0,,Минато! Құттықтаймыз!
Dialogue: 0,0:14:12.95,0:14:15.45,Default,,0,0,0,,Ах. Жеңілгеннің қайталау матчы: алыс бірінші орын➡
Dialogue: 0,0:14:15.45,0:14:20.76,Default,,0,0,0,,Финалға шығудың эмоционалды болғаны соншалық, осы жылы қатты әсер еттім!
Dialogue: 0,0:14:20.76,0:14:24.93,Default,,0,0,0,,Юта…. Төреші SHOWTA да оны жоғары бағалады.
Dialogue: 0,0:14:24.93,0:14:29.23,Default,,0,0,0,,Керемет! Бақылағандарыңызға рахмет.
Dialogue: 0,0:14:38.44,0:14:40.41,Default,,0,0,0,,Аа...
Dialogue: 0,0:14:42.44,0:14:45.75,Default,,0,0,0,,Цюге.
Dialogue: 0,0:14:45.75,0:14:49.42,Default,,0,0,0,,Мені күттіңіз бе? Минато...
Dialogue: 0,0:14:49.42,0:14:51.92,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:14:51.92,0:14:54.92,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:14:54.92,0:14:58.83,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз. Тыңдау әлі аяқталған жоқ.
Dialogue: 0,0:14:58.83,0:15:00.73,Default,,0,0,0,,Финалдық матч әлі бар.
Dialogue: 0,0:15:00.73,0:15:04.93,Default,,0,0,0,,Мен білемін. дегенмен….
Dialogue: 0,0:15:04.93,0:15:08.64,Default,,0,0,0,,Маған неге сонша мейірімдісің?
Dialogue: 0,0:15:18.11,0:15:21.25,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:15:21.25,0:15:23.75,Default,,0,0,0,,Себебі оның астарлы мақсаты бар.
Dialogue: 0,0:15:23.75,0:15:25.95,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:30.66,0:15:32.93,Default,,0,0,0,,Басқаша айтқанда, мен... ⚟Аа, солай болды!
Dialogue: 0,0:15:32.93,0:15:35.93,Default,,0,0,0,,Керемет! Минато Ватая ➡
Dialogue: 0,0:15:35.93,0:15:38.10,Default,,0,0,0,,Судьяның айтары бар сияқты➡
Dialogue: 0,0:15:38.10,0:15:41.67,Default,,0,0,0,,Мен қайтып орала аламын ба? Иә.
Dialogue: 0,0:15:44.94,0:15:47.24,Default,,0,0,0,,Менің әңгімем жақсы.
Dialogue: 0,0:15:47.24,0:15:49.64,Default,,0,0,0,,Финалда сәттілік.
Dialogue: 0,0:15:55.25,0:15:57.69,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:57.69,0:16:00.92,Default,,0,0,0,,<Цюге: Минато би тыңдауының финалында➡
Dialogue: 0,0:16:00.92,0:16:05.09,Default,,0,0,0,,Мен өзімді жеңілгендей сезінемін ➡
Dialogue: 0,0:16:05.09,0:16:07.06,Default,,0,0,0,,Интернеттегі ақпараттан білдім＞
Dialogue: 0,0:16:30.08,0:16:33.45,Default,,0,0,0,,``Күні жақсы сөйлей алмағаным үшін кешіріңіз.''
Dialogue: 0,0:16:33.45,0:16:35.72,Default,,0,0,0,,Иә? сәтті?
Dialogue: 0,0:16:35.72,0:16:38.69,Default,,0,0,0,,«Келесі күні дұрыс сөйлей алмағаным үшін кешірім сұраймын.
Dialogue: 0,0:16:38.69,0:16:42.90,Default,,0,0,0,,Мен өз сезімімді жеткізуде әрқашан жаман болдым...''
Dialogue: 0,0:16:42.90,0:16:44.90,Default,,0,0,0,,Уф...》
Dialogue: 0,0:16:44.90,0:16:47.57,Default,,0,0,0,,Бірдеңе дұрыс емес. Аа….
Dialogue: 0,0:16:55.74,0:16:59.61,Default,,0,0,0,,Иә? Куросава мырза: Түнде қайтып келмедің бе?
Dialogue: 0,0:16:59.61,0:17:03.68,Default,,0,0,0,,Ааа, кешкі жиналыс болмай қалды➡
Dialogue: 0,0:17:03.68,0:17:08.16,Default,,0,0,0,,Мен ерте оралдым. Сен сондай еңбекқорсың, үйге бірден бармайсың.
Dialogue: 0,0:17:15.90,0:17:19.07,Default,,0,0,0,,《Адачиді қадағалау➡
Dialogue: 0,0:17:19.07,0:17:21.60,Default,,0,0,0,,Менің барлық жағымсыз жерлерім➡
Dialogue: 0,0:17:21.60,0:17:24.07,Default,,0,0,0,,Адачи білуі керек еді.
Dialogue: 0,0:17:24.07,0:17:28.08,Default,,0,0,0,,О, Куросава! Бұл дұрыс болды.
Dialogue: 0,0:17:28.08,0:17:32.11,Default,,0,0,0,,Қайтып келе салысымен, кешіріңіздер, қазірден бастап комитетке бетімді көрсете аламын ба?
Dialogue: 0,0:17:32.11,0:17:34.15,Default,,0,0,0,,Иә, мен қазір барамын.
Dialogue: 0,0:17:34.15,0:17:36.45,Default,,0,0,0,,A3 конференц-залы.
Dialogue: 0,0:17:47.40,0:17:51.20,Default,,0,0,0,,《Азалау ретінде қазір бос емес болған дұрыс》
Dialogue: 0,0:17:56.57,0:18:00.74,Default,,0,0,0,,《Мазасыздық тудырғаны сонша, мен оны оқылған деп те көре алмаймын.
Dialogue: 0,0:18:00.74,0:18:02.91,Default,,0,0,0,,Жарайды ма?...》
Dialogue: 0,0:18:02.91,0:18:06.58,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:18:06.58,0:18:11.42,Default,,0,0,0,,Мен мөр алғым келеді, өтінемін. иә.
Dialogue: 0,0:18:11.42,0:18:14.46,Default,,0,0,0,,Ол жеткізу үшін осында келетін➡
Dialogue: 0,0:18:14.46,0:18:17.89,Default,,0,0,0,,Аққұба жігіт ше? Аа, кешіріңіз.
Dialogue: 0,0:18:17.89,0:18:21.23,Default,,0,0,0,,Мен жеке ақпаратты бөлісе алмаймын.
Dialogue: 0,0:18:21.23,0:18:23.40,Default,,0,0,0,,《Бұл күдікті.
Dialogue: 0,0:18:23.40,0:18:25.93,Default,,0,0,0,,Сіз аңдыушысыз ба? 》
Dialogue: 0,0:18:25.93,0:18:28.34,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:18:28.34,0:18:30.34,Default,,0,0,0,,Дөрекі...
Dialogue: 0,0:18:32.74,0:18:35.91,Default,,0,0,0,,《Алайда, жалпы ойланып қарасаңыз➡
Dialogue: 0,0:18:35.91,0:18:40.31,Default,,0,0,0,,Жасы 30-дан асқан ер адам жас босанушы балаға құмар➡
Dialogue: 0,0:18:40.31,0:18:43.35,Default,,0,0,0,,Бұлай ойламай тұра алмайтының рас.
Dialogue: 0,0:18:43.35,0:18:46.82,Default,,0,0,0,,Егер Минато әдейі қашып жатса...》
Dialogue: 0,0:18:46.82,0:18:50.02,Default,,0,0,0,,｟Бұл жерде жасырын ниет болғандықтан｠
Dialogue: 0,0:18:51.93,0:18:54.80,Default,,0,0,0,,《Ол кезде мен үмітсіз болғаным сонша, ұмытып кетіппін➡
Dialogue: 0,0:18:54.80,0:18:58.57,Default,,0,0,0,,Егер сіз осы бөлікті қиып алсаңыз, оған жасырын ниетпен мейірімді болған Сукехираны көресіз➡
Dialogue: 0,0:18:58.57,0:19:01.94,Default,,0,0,0,,Қабылданса, көмектесуге болмайды.
Dialogue: 0,0:19:01.94,0:19:04.91,Default,,0,0,0,,Сол кезде Минато осылай қарады...
Dialogue: 0,0:19:07.58,0:19:11.91,Default,,0,0,0,,《Егер сізден 7 жас үлкен ер адам өзінің арам ниеті бар екенін айтса➡
Dialogue: 0,0:19:11.91,0:19:17.55,Default,,0,0,0,,Қорқудың өзі табиғи нәрсе. Түсініспеушілікті бірден жоймасам...
Dialogue: 0,0:19:17.55,0:19:21.76,Default,,0,0,0,,Бірақ бұл түсінбеушілік болмаса ше?
Dialogue: 0,0:19:21.76,0:19:24.73,Default,,0,0,0,,Жеткізу аймағын өзгерткен сайын, сіз маған ұнайсыз➡
Dialogue: 0,0:19:24.73,0:19:28.26,Default,,0,0,0,,Егер бұл жағымсыз болса...
Dialogue: 0,0:19:28.26,0:19:31.43,Default,,0,0,0,,Мен үшін енді жоқ➡
Dialogue: 0,0:19:31.43,0:19:35.07,Default,,0,0,0,,Портқа кіру мүмкін емес.
Dialogue: 0,0:19:35.07,0:19:38.11,Default,,0,0,0,,Ақыл оқи алатын күшім болса да➡
Dialogue: 0,0:19:38.11,0:19:42.08,Default,,0,0,0,,Кездесе алмасақ, қол тигізу былай тұрсын➡
Dialogue: 0,0:19:42.08,0:19:44.08,Default,,0,0,0,,Мағынасы жоқ》
Dialogue: 0,0:19:52.69,0:19:56.42,Default,,0,0,0,,Аа, еңбегіңіз үшін рахмет. Роккаку әлі сол жерде болды.
Dialogue: 0,0:19:56.42,0:19:58.63,Default,,0,0,0,,Үйге кететін уақыт келді.
Dialogue: 0,0:20:00.80,0:20:03.46,Default,,0,0,0,,Жалғастырыңыз. Жақсы жұмыс.
Dialogue: 0,0:20:05.83,0:20:10.34,Default,,0,0,0,,《Куросава... мен іссапардан оралдым》
Dialogue: 0,0:20:38.10,0:20:40.07,Default,,0,0,0,,♬～
Dialogue: 0,0:20:40.07,0:20:42.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:42.24,0:20:45.51,Default,,0,0,0,,📺Шұғыл ескерту!
Dialogue: 0,0:20:45.51,0:20:48.58,Default,,0,0,0,,📺Ғажайып жаңа би бірлігі➡
Dialogue: 0,0:20:48.58,0:20:53.08,Default,,0,0,0,,SHOWTA ұлттық турының бірінші күні сахнада дебют жасайды!
Dialogue: 0,0:20:56.08,0:20:58.05,Default,,0,0,0,,《Минато…》
Dialogue: 0,0:21:00.25,0:21:02.26,Default,,0,0,0,,📺Жақында!
Dialogue: 0,0:21:10.90,0:21:14.70,Default,,0,0,0,,《Әу бастан басқа әлемнің тұрғыны едім》
Dialogue: 0,0:21:16.84,0:21:19.24,Default,,0,0,0,,《Тұлға, жас және қызмет➡
Dialogue: 0,0:21:19.24,0:21:21.94,Default,,0,0,0,,Біз өмір сүріп жатқан әлем туралы бәрі басқаша...》
Dialogue: 0,0:21:23.91,0:21:28.22,Default,,0,0,0,,《Цюге: Біз бір-бірімізбен қиылыстан қысқаша өтіп кеттік...》
Dialogue: 0,0:21:34.39,0:21:36.69,Default,,0,0,0,,Құттықтаймыз...
Dialogue: 0,0:21:42.50,0:21:46.73,Default,,0,0,0,,《Адачи... Бүгін іссапарға барасың ба?
Dialogue: 0,0:21:46.73,0:21:48.74,Default,,0,0,0,,10 күн бойы...》
Dialogue: 0,0:21:54.91,0:21:57.24,Default,,0,0,0,,《Куросаваға айт.
Dialogue: 0,0:21:57.24,0:22:00.41,Default,,0,0,0,,Менің сезімдерім➡
Dialogue: 0,0:22:00.41,0:22:04.08,Default,,0,0,0,,Мұны Куросаваға айт.
Dialogue: 0,0:22:05.58,0:22:11.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
