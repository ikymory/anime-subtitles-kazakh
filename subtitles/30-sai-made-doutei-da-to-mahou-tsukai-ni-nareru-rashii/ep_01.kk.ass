Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.10,0:00:11.67,Default,,0,0,0,,<Адачи: Менің атым Киёши Адачи>
Dialogue: 0,0:00:13.78,0:00:17.45,Default,,0,0,0,,<Себебі мен 30 жасқа дейін пәк болдым➡
Dialogue: 0,0:00:17.45,0:00:19.92,Default,,0,0,0,,Мен енді сиқырды қолдана аламын>
Dialogue: 0,0:00:22.92,0:00:25.95,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:00:25.95,0:00:28.46,Default,,0,0,0,,＜ Дегенмен➡
Dialogue: 0,0:00:28.46,0:00:30.96,Default,,0,0,0,,Бұл мені өлтіретіндей түсінікті>
Dialogue: 0,0:00:30.96,0:00:34.50,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:00:34.50,0:00:36.80,Default,,0,0,0,,《Ой, мен тигіздім.
Dialogue: 0,0:00:36.80,0:00:39.17,Default,,0,0,0,,Мүлдем мүмкін емес》
Dialogue: 0,0:00:39.17,0:00:41.97,Default,,0,0,0,,<Түріп тұрған адамның не ойлайтынын түсінуге болады>
Dialogue: 0,0:00:45.71,0:00:47.68,Default,,0,0,0,,<Бәрі>
Dialogue: 0,0:00:49.58,0:00:52.61,Default,,0,0,0,,< Бұл өте пайдалы сиқыр емес.
Dialogue: 0,0:00:52.61,0:00:55.12,Default,,0,0,0,,Қала маңындағы пойыздар - тозақ＞
Dialogue: 0,0:00:55.12,0:00:59.25,Default,,0,0,0,,《Аяғым басылды》 《Ақша алғым келеді》 《Аа, нағыз жігіт...》
Dialogue: 0,0:00:59.25,0:01:02.96,Default,,0,0,0,,《Кім менің бөксесіме тиді?》 《Мынау》
Dialogue: 0,0:01:02.96,0:01:06.60,Default,,0,0,0,,<Қызықтыратын қызды түртіп, оның сезімін тексеріңіз➡\NМен
Dialogue: 0,0:01:06.60,0:01:08.60,Default,,0,0,0,,туралы ойладым, бірақ...>
Dialogue: 0,0:01:11.60,0:01:14.10,Default,,0,0,0,,＜Егер сіз бірінші кезекте қол тигізетін адам болсаңыз➡
Dialogue: 0,0:01:14.10,0:01:17.04,Default,,0,0,0,,Осы жасқа дейін қыздығымды жоғалтқан жоқпын>
Dialogue: 0,0:01:17.04,0:01:19.01,Default,,0,0,0,,Га.
Dialogue: 0,0:01:23.11,0:01:26.65,Default,,0,0,0,,Га. (Куросава) Қайырлы таң, Адачи.
Dialogue: 0,0:01:26.65,0:01:29.25,Default,,0,0,0,,Ах. Ах.
Dialogue: 0,0:01:29.25,0:01:32.25,Default,,0,0,0,,Қайырлы таң. ше?
Dialogue: 0,0:01:32.25,0:01:35.96,Default,,0,0,0,,Мен қатты күрсіндім.
Dialogue: 0,0:01:35.96,0:01:40.96,Default,,0,0,0,,Бөлек. Мен күнде таңертең толып жатқан лифтілерді жек көремін.
Dialogue: 0,0:01:40.96,0:01:44.47,Default,,0,0,0,,Олай болса, менімен бірге 17-ші қабатқа баспалдақпен көтерілгің келе ме?
Dialogue: 0,0:01:44.47,0:01:46.47,Default,,0,0,0,,Бұл жақсы жаттығу.
Dialogue: 0,0:01:46.47,0:01:48.50,Default,,0,0,0,,《Мабуши》
Dialogue: 0,0:01:48.50,0:01:51.04,Default,,0,0,0,,<Бұл жігіт Куросава, ол сол дәуірде болған.
Dialogue: 0,0:01:51.04,0:01:53.14,Default,,0,0,0,,Сымбатты және жұмысқа жақсы➡
Dialogue: 0,0:01:53.14,0:01:55.61,Default,,0,0,0,,Мен сияқты қарапайым адамдарға да мейірімді ➡
Dialogue: 0,0:01:55.61,0:01:57.81,Default,,0,0,0,,Барлығына мейірімді бол＞
Dialogue: 0,0:01:57.81,0:02:00.18,Default,,0,0,0,,Куросава-сенпай, бүгін де тамаша!
Dialogue: 0,0:02:00.18,0:02:04.79,Default,,0,0,0,,Сіздің қызыңыз бар деп ойлайсыз ба? Иә әрине.
Dialogue: 0,0:02:04.79,0:02:07.29,Default,,0,0,0,,<Өлімге дейін танымал>
Dialogue: 0,0:02:07.29,0:02:11.13,Default,,0,0,0,,《Ол жасөспірім кезінде пәктігін жоғалтқанына сенімдімін.》
Dialogue: 0,0:02:11.13,0:02:14.13,Default,,0,0,0,,Қайырлы таң! қайырлы таң.
Dialogue: 0,0:02:14.13,0:02:17.30,Default,,0,0,0,,《Ирааа! Кішкене➡
Dialogue: 0,0:02:17.30,0:02:19.63,Default,,0,0,0,,Қарап шығуға болмайды.
Dialogue: 0,0:02:19.63,0:02:22.80,Default,,0,0,0,,Мінезі жаман болсын! 》
Dialogue: 0,0:02:22.80,0:02:26.94,Default,,0,0,0,,《Бақыт. Таңертең сені көремін деп ойламаппын.
Dialogue: 0,0:02:26.94,0:02:29.64,Default,,0,0,0,,Маған қарап отыра берсең, мен күдіктенемін.
Dialogue: 0,0:02:29.64,0:02:31.81,Default,,0,0,0,,А, бірақ мен ұйықтаудан шаршадым.
Dialogue: 0,0:02:31.81,0:02:34.15,Default,,0,0,0,,Өте сүйкімді》《Уау!
Dialogue: 0,0:02:34.15,0:02:36.72,Default,,0,0,0,,Бұл жігіт Жұмыста сізге ұнайтын адам бар ма?
Dialogue: 0,0:02:36.72,0:02:38.69,Default,,0,0,0,,Мен қызым бар деп ойладым》
Dialogue: 0,0:02:40.79,0:02:44.63,Default,,0,0,0,,《Бұл кім? Ұйқыдан шаршаған бала➡
Dialogue: 0,0:02:44.63,0:02:48.00,Default,,0,0,0,,Сіз сондасыз ба? 》 (есіктің ашылған дыбысы)
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Ой! Ах.
Dialogue: 0,0:02:50.00,0:02:52.63,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:52.63,0:02:54.64,Default,,0,0,0,,《Уау~》
Dialogue: 0,0:02:54.64,0:02:56.61,Default,,0,0,0,,《Не?》
Dialogue: 0,0:03:08.62,0:03:11.15,Default,,0,0,0,,Адачи?
Dialogue: 0,0:03:11.15,0:03:13.12,Default,,0,0,0,,《Шынымен бе?》
Dialogue: 0,0:04:54.19,0:04:58.63,Default,,0,0,0,,《Мүмкін емес... Бұл мүмкін емес!
Dialogue: 0,0:04:58.63,0:05:01.33,Default,,0,0,0,,Күтіңіз. Енді мен сиқырды қолдана аламын➡
Dialogue: 0,0:05:01.33,0:05:05.80,Default,,0,0,0,,Мен солай ойладым, бірақ бірінші кезекте мұның бәрі менің қиялым еді➡
Dialogue: 0,0:05:05.80,0:05:09.81,Default,,0,0,0,,Сіз естіген дауыс галлюцинация ма?
Dialogue: 0,0:05:09.81,0:05:11.97,Default,,0,0,0,,Иә. Солай болуы керек!
Dialogue: 0,0:05:11.97,0:05:14.11,Default,,0,0,0,,Өйткені бұл біртүрлі. Сиқыр және т.
Dialogue: 0,0:05:14.11,0:05:16.75,Default,,0,0,0,,Куросава мен туралы айтып жатыр➡
Dialogue: 0,0:05:16.75,0:05:19.58,Default,,0,0,0,,Маған ұнайды... және т.б.
Dialogue: 0,0:05:19.58,0:05:21.62,Default,,0,0,0,,Келесі жолы мен де президент болғанын қалаймын.
Dialogue: 0,0:05:21.62,0:05:24.79,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:05:24.79,0:05:27.59,Default,,0,0,0,,《Бірақ бұл тым тамаша.
Dialogue: 0,0:05:27.59,0:05:30.63,Default,,0,0,0,,Әлгі ашулы президент жынды екен.
Dialogue: 0,0:05:30.63,0:05:34.30,Default,,0,0,0,,Адачи-кун. Иә, менеджер.
Dialogue: 0,0:05:34.30,0:05:36.97,Default,,0,0,0,,Өткен күні мен сұраған Albireo компаниясына қатысты материалдар➡
Dialogue: 0,0:05:36.97,0:05:38.97,Default,,0,0,0,,Сіз орындадыңыз ба? иә?
Dialogue: 0,0:05:38.97,0:05:41.97,Default,,0,0,0,,Мен оны бүгін сұраймын. Бұл➡
Dialogue: 0,0:05:41.97,0:05:44.87,Default,,0,0,0,,Келесі аптаға дейін... иә?
Dialogue: 0,0:05:44.87,0:05:48.11,Default,,0,0,0,,Менеджер…. иә! ?
Dialogue: 0,0:05:48.11,0:05:50.45,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:05:50.45,0:05:52.61,Default,,0,0,0,,Бұл менің түсінбеуім болды.
Dialogue: 0,0:05:52.61,0:05:55.28,Default,,0,0,0,,《Мүмкін емес.
Dialogue: 0,0:05:55.28,0:05:57.92,Default,,0,0,0,,Мен қайдамын, сонша мұңайып?
Dialogue: 0,0:05:57.92,0:06:01.66,Default,,0,0,0,,Бұл жерде сізге ұнайтын нәрсе бар.
Dialogue: 0,0:06:01.66,0:06:03.63,Default,,0,0,0,,Сол Куросава! 》
Dialogue: 0,0:06:10.13,0:06:12.97,Default,,0,0,0,,《А, бұл бітпейді》
Dialogue: 0,0:06:12.97,0:06:14.97,Default,,0,0,0,,Ах.
Dialogue: 0,0:06:14.97,0:06:16.97,Default,,0,0,0,,Қалғандары бар ма?
Dialogue: 0,0:06:16.97,0:06:22.41,Default,,0,0,0,,《Сіз шынымен байсалды екенсіз. Мен адамдарға көбірек сенім артқанымды қалаймын.
Dialogue: 0,0:06:22.41,0:06:24.81,Default,,0,0,0,,Бұл маңызды емес. Мен саған көмектесемін.
Dialogue: 0,0:06:24.81,0:06:28.15,Default,,0,0,0,,《Менің айтайын дегенім, маған сену керек.》
Dialogue: 0,0:06:28.15,0:06:30.19,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:06:30.19,0:06:32.19,Default,,0,0,0,,《Есту галлюцинациясы》
Dialogue: 0,0:06:32.19,0:06:34.96,Default,,0,0,0,,Олай болса мен сенен мынаны сұраймын. Оу.
Dialogue: 0,0:06:34.96,0:06:37.46,Default,,0,0,0,,《Аа, желкедегі мең》
Dialogue: 0,0:06:37.46,0:06:39.46,Default,,0,0,0,,Иә? Эй.
Dialogue: 0,0:06:39.46,0:06:41.50,Default,,0,0,0,,《Бұл біртүрлі жерде》
Dialogue: 0,0:06:41.50,0:06:44.13,Default,,0,0,0,,Бұл сандар біртүрлі ме?
Dialogue: 0,0:06:44.13,0:06:46.13,Default,,0,0,0,,《Жалап...》 Уау!
Dialogue: 0,0:06:46.13,0:06:48.64,Default,,0,0,0,,Эй, әжетхана!
Dialogue: 0,0:06:51.57,0:06:54.44,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:06:54.44,0:06:57.45,Default,,0,0,0,,Бұл галлюцинация емес еді.
Dialogue: 0,0:06:57.45,0:07:00.35,Default,,0,0,0,,Ах, ақыры аяқталды.
Dialogue: 0,0:07:00.35,0:07:02.82,Default,,0,0,0,,《Әріптесім байсалды сияқты》
Dialogue: 0,0:07:05.95,0:07:08.96,Default,,0,0,0,,Мен енді компанияда жалғызбын деп ойлаймын.
Dialogue: 0,0:07:08.96,0:07:11.13,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:11.13,0:07:14.40,Default,,0,0,0,,《Маған шабуыл жасалса да, ешкім келмейді...》
Dialogue: 0,0:07:17.03,0:07:19.03,Default,,0,0,0,,Бүгін суық.
Dialogue: 0,0:07:27.61,0:07:29.58,Default,,0,0,0,,Мен оны саған қарызға беремін.
Dialogue: 0,0:07:29.58,0:07:32.58,Default,,0,0,0,,《Аа, мен бүгін дыбыс өшіргіш әкелгеніме қуаныштымын》
Dialogue: 0,0:07:32.58,0:07:35.15,Default,,0,0,0,,Бұл жаман. Жарайды.
Dialogue: 0,0:07:35.15,0:07:37.95,Default,,0,0,0,,《Менің көзім... шынымен қансырап тұр.
Dialogue: 0,0:07:37.95,0:07:40.42,Default,,0,0,0,,Ол байсалды болғандықтан, оның жұмысы менеджерге де ұнайды➡
Dialogue: 0,0:07:40.42,0:07:43.96,Default,,0,0,0,,Сіз мені тым мәжбүрлеп жатырсыз》
Dialogue: 0,0:07:43.96,0:07:47.76,Default,,0,0,0,,Суық тиіп қалсаң, жұмысым артады.
Dialogue: 0,0:07:47.76,0:07:50.77,Default,,0,0,0,,《Мен оны жалғыз қалдыра алмаймын》
Dialogue: 0,0:07:50.77,0:07:53.94,Default,,0,0,0,,《S... Ол сондай жақсы жігіт.
Dialogue: 0,0:07:53.94,0:07:56.10,Default,,0,0,0,,Сізге шабуыл жасайды деп ойлағаныңыз үшін кешіріңіз.
Dialogue: 0,0:07:56.10,0:07:58.11,Default,,0,0,0,,Мм. Үйге ерте қайтайық.
Dialogue: 0,0:08:02.61,0:08:06.21,Default,,0,0,0,,Рахмет. Куросаваның сонда болуы маған көмектесті.
Dialogue: 0,0:08:08.95,0:08:11.12,Default,,0,0,0,,Ахаха... бұл асыра сілтеу.
Dialogue: 0,0:08:11.12,0:08:14.12,Default,,0,0,0,,Жоқ, бұл шынымен көмектесті.
Dialogue: 0,0:08:14.12,0:08:16.62,Default,,0,0,0,,Келесі кездескенше➡
Dialogue: 0,0:08:16.62,0:08:18.59,Default,,0,0,0,,Саған денеммен алғыс айтуым керек пе?
Dialogue: 0,0:08:20.60,0:08:23.10,Default,,0,0,0,,Не елестетесің, бұзық?
Dialogue: 0,0:08:23.10,0:08:26.77,Default,,0,0,0,,Келесіде тамақ ішейік. Уф иә.
Dialogue: 0,0:08:26.77,0:08:30.21,Default,,0,0,0,,《Сен байсалдысың ба, әлде қалжыңдадың ба? ? 》
Dialogue: 0,0:08:30.21,0:08:32.61,Default,,0,0,0,,Айтпақшы, соңғы пойызда жақсысың ба?
Dialogue: 0,0:08:32.61,0:08:34.61,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:08:34.61,0:08:37.48,Default,,0,0,0,,Бітті... уақыт таяп қалды.
Dialogue: 0,0:08:37.48,0:08:41.32,Default,,0,0,0,,Шынайы ма? Әй, такси ақысы...
Dialogue: 0,0:08:41.32,0:08:43.32,Default,,0,0,0,,Хмм, содан кейін➡
Dialogue: 0,0:08:43.32,0:08:45.29,Default,,0,0,0,,Менің үйімде қалғың келе ме?
Dialogue: 0,0:08:49.49,0:08:51.46,Default,,0,0,0,,Иә! ? Жақын➡
Dialogue: 0,0:08:51.46,0:08:55.00,Default,,0,0,0,,Такси жақсы. ``Мен не істеуім керек...?
Dialogue: 0,0:08:55.00,0:08:57.30,Default,,0,0,0,,Куросава мені ұнатса да➡
Dialogue: 0,0:08:57.30,0:09:00.14,Default,,0,0,0,,Ноконоко Сіздің үйіңізге баруға болады ма?
Dialogue: 0,0:09:00.14,0:09:02.47,Default,,0,0,0,,Жоқ, бірақ ол жақсы жігіт.
Dialogue: 0,0:09:02.47,0:09:04.97,Default,,0,0,0,,Осы уақытқа дейін ештеңе болған жоқ...
Dialogue: 0,0:09:04.97,0:09:08.64,Default,,0,0,0,,Әй, сенде арам ниет бар ма, жоқ па?
Dialogue: 0,0:09:08.64,0:09:11.65,Default,,0,0,0,,Иә, оны түрткен кезде білесің.
Dialogue: 0,0:09:11.65,0:09:14.15,Default,,0,0,0,,Жарайды, кездейсоқ сурет...》
Dialogue: 0,0:09:14.15,0:09:16.12,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:16.12,0:09:18.12,Default,,0,0,0,,《Қазір! 》 📱 (рингтон)
Dialogue: 0,0:09:18.12,0:09:20.62,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:20.62,0:09:24.33,Default,,0,0,0,,Амансың ба? Уф иә.
Dialogue: 0,0:09:24.33,0:09:27.33,Default,,0,0,0,,《Уф, есек...》
Dialogue: 0,0:09:27.33,0:09:29.70,Default,,0,0,0,,Қараңыз. Ах.
Dialogue: 0,0:09:34.97,0:09:38.37,Default,,0,0,0,,《Ол қатты шу шығарды, бірақ мен зардап шеккен жоқпын деп үміттенемін》
Dialogue: 0,0:09:38.37,0:09:40.64,Default,,0,0,0,,《Ол өте жақсы жігіт.
Dialogue: 0,0:09:40.64,0:09:44.15,Default,,0,0,0,,Сақ болғаным үшін кешіріңіз》
Dialogue: 0,0:09:44.15,0:09:46.11,Default,,0,0,0,,Куросава. иә?
Dialogue: 0,0:09:51.82,0:09:53.99,Default,,0,0,0,,Мазасыздық тудырмаса➡
Dialogue: 0,0:09:53.99,0:09:56.16,Default,,0,0,0,,Бүгін түнеуге бола ма?
Dialogue: 0,0:09:58.96,0:10:01.06,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:10:01.06,0:10:06.30,Default,,0,0,0,,｟Куросава? Куросава. Куросава…｠
Dialogue: 0,0:10:06.30,0:10:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.17,0:10:11.17,Default,,0,0,0,,《Ол қазір не?》
Dialogue: 0,0:10:21.08,0:10:23.59,Default,,0,0,0,,Өтінемін. Онда отырыңыз.
Dialogue: 0,0:10:27.79,0:10:30.49,Default,,0,0,0,,《Тек танымал аурасы бар бұл қандай бөлме?》
Dialogue: 0,0:10:33.26,0:10:35.96,Default,,0,0,0,,《Мен тыныштала алмаймын》 (шу)
Dialogue: 0,0:10:39.80,0:10:42.27,Default,,0,0,0,,Бұл манга…. Ах!
Dialogue: 0,0:10:44.61,0:10:48.11,Default,,0,0,0,,Мен оны кеше оқи бастадым, тоқтай алмадым.
Dialogue: 0,0:10:48.11,0:10:50.08,Default,,0,0,0,,Сіз балаға ұқсайсыз.
Dialogue: 0,0:10:55.42,0:11:00.09,Default,,0,0,0,,Мен де. иә? Маған да бұл манга ұнайды.
Dialogue: 0,0:11:00.09,0:11:03.59,Default,,0,0,0,,Он екі сынақ доғасы ортасында тоқтамайды.
Dialogue: 0,0:11:03.59,0:11:07.10,Default,,0,0,0,,Дұрыс! Маған ең алдымен сынақ нұсқасы ұнайды!
Dialogue: 0,0:11:07.10,0:11:09.60,Default,,0,0,0,,Бұл трюк таңқаларлық.
Dialogue: 0,0:11:09.60,0:11:12.93,Default,,0,0,0,,《Бұл жігіттің қызығушылықтары таң қалдырады》
Dialogue: 0,0:11:12.93,0:11:16.94,Default,,0,0,0,,Аа, дұрыс. Ванна қайнап жатыр, кіріңіз.
Dialogue: 0,0:11:16.94,0:11:20.11,Default,,0,0,0,,Бұл киім ауыстыру. Ах, рахмет.
Dialogue: 0,0:11:20.11,0:11:23.61,Default,,0,0,0,,《Нәзік》 《Адачи кисе сүйкімді болар еді➡
Dialogue: 0,0:11:23.61,0:11:26.95,Default,,0,0,0,,Мен армандау үшін пижама сатып алдым➡
Dialogue: 0,0:11:26.95,0:11:29.45,Default,,0,0,0,,Пайдалы болады деп ойламаппын...》
Dialogue: 0,0:11:29.45,0:11:31.45,Default,,0,0,0,,Уф….
Dialogue: 0,0:11:31.45,0:11:34.12,Default,,0,0,0,,《Мен пижама кигім келмейді~! 》
Dialogue: 0,0:11:34.12,0:11:39.53,Default,,0,0,0,,Мен жақсы ваннаға түссем де, ол мүлдем жылынбайды...
Dialogue: 0,0:11:39.53,0:11:42.10,Default,,0,0,0,,《Уф... Көлемі тамаша.
Dialogue: 0,0:11:42.10,0:11:46.43,Default,,0,0,0,,Мен әр түрлі эмоцияларға толы болғандай сезінемін.
Dialogue: 0,0:11:46.43,0:11:48.94,Default,,0,0,0,,Ванна Сәлем.
Dialogue: 0,0:11:48.94,0:11:51.31,Default,,0,0,0,,Менде сыра бар. Сіз оны ішкіңіз келе ме?
Dialogue: 0,0:11:51.31,0:11:53.34,Default,,0,0,0,,《Мені мас қылып не істемексің? 》
Dialogue: 0,0:11:53.34,0:11:56.95,Default,,0,0,0,,Сумен.
Dialogue: 0,0:11:56.95,0:11:59.28,Default,,0,0,0,,Жарайды, мен де суға түсейін.
Dialogue: 0,0:11:59.28,0:12:02.78,Default,,0,0,0,,Ах. Мен футонды артқа қалдырдым.
Dialogue: 0,0:12:02.78,0:12:06.15,Default,,0,0,0,,Рахмет. Ұйқыңыз келсе, алдымен ұйықтаңыз.
Dialogue: 0,0:12:15.83,0:12:18.63,Default,,0,0,0,,《Егер мен немесе ол әйел болсам➡
Dialogue: 0,0:12:18.63,0:12:20.94,Default,,0,0,0,,Бұл оңайырақ болуы мүмкін бе?
Dialogue: 0,0:12:23.77,0:12:29.24,Default,,0,0,0,,《30 жыл өмір сүргеннен кейін менде махаббат сезімі мүлдем жоқ➡
Dialogue: 0,0:12:29.24,0:12:31.78,Default,,0,0,0,,Басқа адамның жүрегін түсінгеннен кейін➡
Dialogue: 0,0:12:31.78,0:12:33.98,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:12:44.96,0:12:47.30,Default,,0,0,0,,Сіз әлі ұйықтадыңыз ба?
Dialogue: 0,0:12:47.30,0:12:50.16,Default,,0,0,0,,《Ұйықтап жатырмын деп тұрмын. Қандай бет жасауым керек➡
Dialogue: 0,0:12:50.16,0:12:54.44,Default,,0,0,0,,Себебі мен білмеймін》 (аяқ дыбысы)
Dialogue: 0,0:12:54.44,0:12:56.44,Default,,0,0,0,,《Не?
Dialogue: 0,0:12:56.44,0:12:59.31,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:59.31,0:13:01.31,Default,,0,0,0,,Эй, эй! 》
Dialogue: 0,0:13:14.56,0:13:17.09,Default,,0,0,0,,《Жақын.
Dialogue: 0,0:13:17.09,0:13:20.96,Default,,0,0,0,,Бұл қауіпті. Куросава не істеп жатқанын білмеймін➡
Dialogue: 0,0:13:20.96,0:13:22.93,Default,,0,0,0,,Өте қорқынышты》
Dialogue: 0,0:13:24.93,0:13:27.90,Default,,0,0,0,,《Иә. Егер сіз оны ұстасаңыз, ол сиқырлы болады...》
Dialogue: 0,0:13:39.51,0:13:43.12,Default,,0,0,0,,《Мен таң қалдым.
Dialogue: 0,0:13:43.12,0:13:45.39,Default,,0,0,0,,Жаңа ғана смартфоныңызды алуға келдіңіз бе?
Dialogue: 0,0:13:49.16,0:13:51.96,Default,,0,0,0,,《Куросава мені ұнатады➡
Dialogue: 0,0:13:51.96,0:13:54.96,Default,,0,0,0,,Бұл не? Бірақ ➡
Dialogue: 0,0:13:54.96,0:13:56.96,Default,,0,0,0,,Неге ештеңе істемедің?
Dialogue: 0,0:14:00.30,0:14:02.27,Default,,0,0,0,,Ах.
Dialogue: 0,0:14:02.27,0:14:05.24,Default,,0,0,0,,《Мен сенің бұл туралы бірдеңе істеуіңді қалаған сияқтымын! 》
Dialogue: 0,0:14:05.24,0:14:09.28,Default,,0,0,0,,Олай емес! Аа….
Dialogue: 0,0:14:09.28,0:14:12.78,Default,,0,0,0,,Көп нәрсе болып жатқаны сонша, менің басым тырнақалды.
Dialogue: 0,0:14:15.12,0:14:18.79,Default,,0,0,0,,《Мен сияқты пәк қыз үшін тым көп》
Dialogue: 0,0:14:18.79,0:14:20.79,Default,,0,0,0,,Аа...
Dialogue: 0,0:14:34.84,0:14:37.64,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:14:37.64,0:14:39.64,Default,,0,0,0,,Мен ұйықтай алмаймын.
Dialogue: 0,0:14:42.51,0:14:48.28,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:14:48.28,0:14:51.15,Default,,0,0,0,,(қайнаған судың дыбысы)
Dialogue: 0,0:14:51.15,0:14:54.79,Default,,0,0,0,,Жағымды иіс... қайырлы таң!
Dialogue: 0,0:14:54.79,0:14:56.79,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:14:56.79,0:14:59.43,Default,,0,0,0,,Таңғы ас ішкіңіз келе ме?
Dialogue: 0,0:14:59.43,0:15:01.96,Default,,0,0,0,,Тамақтану.
Dialogue: 0,0:15:01.96,0:15:04.83,Default,,0,0,0,,О!
Dialogue: 0,0:15:04.83,0:15:06.83,Default,,0,0,0,,Итадакимасу.
Dialogue: 0,0:15:09.10,0:15:11.44,Default,,0,0,0,,Дәмді.
Dialogue: 0,0:15:11.44,0:15:14.11,Default,,0,0,0,,Бұл керемет, Куросава. Таңертеңнен осылай➡
Dialogue: 0,0:15:14.11,0:15:16.51,Default,,0,0,0,,Тамақты дұрыс дайындау.
Dialogue: 0,0:15:16.51,0:15:19.41,Default,,0,0,0,,Мен емес.
Dialogue: 0,0:15:19.41,0:15:21.95,Default,,0,0,0,,Сонымен, сіз күнде тамақ ішуге келесіз бе?
Dialogue: 0,0:15:21.95,0:15:24.12,Default,,0,0,0,,Не!
Dialogue: 0,0:15:24.12,0:15:28.12,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,0:15:28.12,0:15:31.26,Default,,0,0,0,,《Бір сәт бұл жақсы идея болар деп ойладым.
Dialogue: 0,0:15:31.26,0:15:33.96,Default,,0,0,0,,Бұл шындық болу үшін тым жақсы.
Dialogue: 0,0:15:33.96,0:15:35.93,Default,,0,0,0,,Омлет дүкенін қараңыз》
Dialogue: 0,0:15:42.77,0:15:46.64,Default,,0,0,0,,《Біраз уақыт арақашықтықты сақтаңыз!
Dialogue: 0,0:15:46.64,0:15:49.28,Default,,0,0,0,,Махаббат тәжірибесі нөлдік маған➡
Dialogue: 0,0:15:49.28,0:15:52.45,Default,,0,0,0,,Куросаваның махаббаты тым ауыр жүк》
Dialogue: 0,0:15:52.45,0:15:55.45,Default,,0,0,0,,Га. Уау….
Dialogue: 0,0:15:55.45,0:15:58.12,Default,,0,0,0,,Сәлем Адачи! Директор.
Dialogue: 0,0:15:58.12,0:16:01.26,Default,,0,0,0,,Таңертеңнен бері болды. Мен араласамын.
Dialogue: 0,0:16:01.26,0:16:03.96,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:03.96,0:16:08.13,Default,,0,0,0,,《Басында менеджер қосымша жұмыс істеуімді өтінді...》
Dialogue: 0,0:16:08.13,0:16:12.00,Default,,0,0,0,,Айтпақшы, кешегі құжат жақсы жасалған.
Dialogue: 0,0:16:12.00,0:16:15.10,Default,,0,0,0,,Сіз мұны өзіңіз жасадыңыз ба? Негізі➡
Dialogue: 0,0:16:15.10,0:16:17.91,Default,,0,0,0,,Куросавадан сізге көмектесуін сұраңыз. Не?
Dialogue: 0,0:16:17.91,0:16:21.94,Default,,0,0,0,,Алдымен соны айт. Эй, Куросава-кун!
Dialogue: 0,0:16:21.94,0:16:24.95,Default,,0,0,0,,《Сәлем! қашықтық! 》
Dialogue: 0,0:16:24.95,0:16:27.92,Default,,0,0,0,,Бұл не? Кеше менің Адачим болды➡
Dialogue: 0,0:16:27.92,0:16:30.62,Default,,0,0,0,,Саған жүк болып көрінгенім үшін кешір.
Dialogue: 0,0:16:30.62,0:16:34.02,Default,,0,0,0,,Жоқ, жоқ. Құжаттардың көбін өзі жасады➡
Dialogue: 0,0:16:34.02,0:16:36.59,Default,,0,0,0,,Мен аз ғана көмектестім.
Dialogue: 0,0:16:36.59,0:16:39.26,Default,,0,0,0,,《Куросава…》 Хахахаха….
Dialogue: 0,0:16:39.26,0:16:42.63,Default,,0,0,0,,Куросава-кун кішіпейілділікке жақсы.
Dialogue: 0,0:16:42.63,0:16:45.23,Default,,0,0,0,,Дұрыс тағзым еттіңіз бе? Аа….
Dialogue: 0,0:16:45.23,0:16:49.74,Default,,0,0,0,,Бұл өз уақытында болады. 《Тоқта, бұл туралы...》
Dialogue: 0,0:16:49.74,0:16:53.41,Default,,0,0,0,,Иә. Жақын жерде жақсы якинику мейрамханасы бар.
Dialogue: 0,0:16:53.41,0:16:55.91,Default,,0,0,0,,Солай ма? «бір минут күте тұрыңыз.
Dialogue: 0,0:16:55.91,0:16:58.71,Default,,0,0,0,,Бұл ағын нашар! 》
Dialogue: 0,0:16:58.71,0:17:01.08,Default,,0,0,0,,Қаласаңыз, екеуіңіз бірге жүре аласыздар.
Dialogue: 0,0:17:01.08,0:17:04.62,Default,,0,0,0,,Бұл тегін билет. 《Оны орнатпаңыз! 》
Dialogue: 0,0:17:04.62,0:17:07.42,Default,,0,0,0,,Мен сізден тұрақты қолдау күтемін.
Dialogue: 0,0:17:07.42,0:17:10.76,Default,,0,0,0,,Жақсы араласыңыз! 《Куросава/Адачи: Шынымен бе?
Dialogue: 0,0:17:10.76,0:17:13.96,Default,,0,0,0,,Менеджер байыпты түрде...》《Оба құдайы! 》 《Купида》
Dialogue: 0,0:17:19.83,0:17:23.10,Default,,0,0,0,,《Мен бас тарта алмадым. менің ақымақ
Dialogue: 0,0:17:23.10,0:17:27.07,Default,,0,0,0,,Мен біраз уақытқа қашықтықты сақтауды жоспарлап отырмын, бірақ...
Dialogue: 0,0:17:27.07,0:17:30.24,Default,,0,0,0,,Иә! (2 адам) Дәмді!
Dialogue: 0,0:17:30.24,0:17:32.91,Default,,0,0,0,,Бұл қауіпті. Аузыңда еріп кетті.
Dialogue: 0,0:17:32.91,0:17:34.88,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:17:40.92,0:17:43.09,Default,,0,0,0,,Пуха.
Dialogue: 0,0:17:47.43,0:17:50.97,Default,,0,0,0,,Хехе. иә? Бұл не?
Dialogue: 0,0:17:50.97,0:17:55.60,Default,,0,0,0,,Жоқ, мен Адачи жақсы тамақтанатын сияқты деп ойладым.
Dialogue: 0,0:17:55.60,0:17:58.44,Default,,0,0,0,,Шынымен бе? Сіз аузыңызды толтырып жатырсыз ба?
Dialogue: 0,0:17:58.44,0:18:01.31,Default,,0,0,0,,Жақсы... бұл керемет.
Dialogue: 0,0:18:01.31,0:18:04.45,Default,,0,0,0,,《Мм? Қазір не болды?
Dialogue: 0,0:18:04.45,0:18:06.95,Default,,0,0,0,,《Яба. Мен оны сүйкімді деп айта жаздадым》
Dialogue: 0,0:18:11.29,0:18:15.66,Default,,0,0,0,,Тіпті мен өзімді әдеттегіден жақсы сезінемін.
Dialogue: 0,0:18:15.66,0:18:18.69,Default,,0,0,0,,Иә? Бұл жақсы ет.
Dialogue: 0,0:18:18.69,0:18:21.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.63,0:18:24.10,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:18:24.10,0:18:26.47,Default,,0,0,0,,Салқын кеспе мен бибимбапқа тапсырыс беріп, бөліскіңіз келе ме?
Dialogue: 0,0:18:26.47,0:18:30.04,Default,,0,0,0,,Жақсы. Кешіріңіз.
Dialogue: 0,0:18:30.04,0:18:32.94,Default,,0,0,0,,《Тек көңілді.
Dialogue: 0,0:18:32.94,0:18:36.28,Default,,0,0,0,,Куросава да көңілді жүрген сияқты.
Dialogue: 0,0:18:36.28,0:18:38.25,Default,,0,0,0,,Бұл қызық》
Dialogue: 0,0:18:40.35,0:18:44.09,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. Сіздің шотыңыз осында болады.
Dialogue: 0,0:18:44.09,0:18:47.62,Default,,0,0,0,,Қазір төлеңіз. иә.
Dialogue: 0,0:18:47.62,0:18:50.09,Default,,0,0,0,,О? кешіріңіз.
Dialogue: 0,0:18:50.09,0:18:53.56,Default,,0,0,0,,Бұл мерзімі аяқталды. Ха!
Dialogue: 0,0:18:53.56,0:18:56.26,Default,,0,0,0,,《Бастық! 》
Dialogue: 0,0:18:56.26,0:19:00.63,Default,,0,0,0,,《Жоқ》 Шынымен, сіз тегін купондарды пайдалана алмайсыз ба?
Dialogue: 0,0:19:00.63,0:19:03.67,Default,,0,0,0,,Сізде ақша жеткілікті ме? Ах.
Dialogue: 0,0:19:03.67,0:19:07.48,Default,,0,0,0,,Иә….
Dialogue: 0,0:19:07.48,0:19:10.11,Default,,0,0,0,,Карточка бойынша. иә. Е, онда➡
Dialogue: 0,0:19:10.11,0:19:12.95,Default,,0,0,0,,Рахмет айту деген нені білдіреді? Кем дегенде Варикан!
Dialogue: 0,0:19:12.95,0:19:16.28,Default,,0,0,0,,Жарайды. Жарайды.
Dialogue: 0,0:19:16.28,0:19:19.12,Default,,0,0,0,,Келесіде айлық алған кезде өзіңізді емдеңіз.
Dialogue: 0,0:19:19.12,0:19:21.29,Default,,0,0,0,,Ах.
Dialogue: 0,0:19:21.29,0:19:24.43,Default,,0,0,0,,《Куросава мені ұнататын сияқты➡
Dialogue: 0,0:19:24.43,0:19:27.83,Default,,0,0,0,,Мен ерекше ештеңе істеп жатқан сияқты емеспін...
Dialogue: 0,0:19:27.83,0:19:29.80,Default,,0,0,0,,Маған жұмысқа көмектесіңіз➡
Dialogue: 0,0:19:29.80,0:19:33.73,Default,,0,0,0,,Маған осылай мейірімді бола алсаңыз➡
Dialogue: 0,0:19:33.73,0:19:37.41,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:19:37.41,0:19:41.08,Default,,0,0,0,,Дос ретінде ол өте жақсы жігіт.
Dialogue: 0,0:19:41.08,0:19:44.41,Default,,0,0,0,,Бірге болу қызық》
Dialogue: 0,0:19:44.41,0:19:47.75,Default,,0,0,0,,Мен кәмпит алдым. Рақмет сізге.
Dialogue: 0,0:19:47.75,0:19:50.25,Default,,0,0,0,,《Бұл шынымен де арман сияқты》
Dialogue: 0,0:19:50.25,0:19:52.62,Default,,0,0,0,,Ах. 《Міне, біз тағы да Адачимен біргеміз➡
Dialogue: 0,0:19:52.62,0:19:55.16,Default,,0,0,0,,Енді кешкі асқа шығуға сылтауым бар.
Dialogue: 0,0:19:55.16,0:19:58.43,Default,,0,0,0,,Мен... Мен қатты ренжідім.
Dialogue: 0,0:19:58.43,0:20:01.80,Default,,0,0,0,,Маған қатты ұнайды. Мен сондай қуаныштымын.
Dialogue: 0,0:20:01.80,0:20:04.90,Default,,0,0,0,,Бүгін үйге барғым келмейді.
Dialogue: 0,0:20:04.90,0:20:07.10,Default,,0,0,0,,Менің үйге барғым келмейді》
Dialogue: 0,0:20:09.40,0:20:12.24,Default,,0,0,0,,А, кешіріңіз!
Dialogue: 0,0:20:12.24,0:20:14.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.41,0:20:16.58,Default,,0,0,0,,Кешіріңіз, Куросава.
Dialogue: 0,0:20:16.58,0:20:20.41,Default,,0,0,0,,《Мен... ең нашармын》
Dialogue: 0,0:20:20.41,0:20:23.72,Default,,0,0,0,,Мен шынымен кешірім сұраймын. Не болды, Адачи?
Dialogue: 0,0:20:23.72,0:20:26.05,Default,,0,0,0,,Сіз массыз ба?
Dialogue: 0,0:20:26.05,0:20:28.26,Default,,0,0,0,,《Бұл ең нашар.
Dialogue: 0,0:20:28.26,0:20:33.26,Default,,0,0,0,,Мен шынымен қулық туралы ойладым.
Dialogue: 0,0:20:33.26,0:20:35.93,Default,,0,0,0,,Мен Куросаваның байыптылығына жауап бере алмасам да》
Dialogue: 0,0:20:38.60,0:20:41.10,Default,,0,0,0,,Кешіріңіз, мен дүкенге тоқтай аламын ба?
Dialogue: 0,0:20:45.27,0:20:48.78,Default,,0,0,0,,Иә. иә?
Dialogue: 0,0:20:48.78,0:20:50.95,Default,,0,0,0,,Өйткені, бұл менің алғысым➡
Dialogue: 0,0:20:50.95,0:20:54.12,Default,,0,0,0,,Жақсылық сұрау жаман. Эх, жарайды, солай.
Dialogue: 0,0:20:54.12,0:20:57.08,Default,,0,0,0,,Ол үшін уайымдамаңыз... Жұмысыма көмектескеніңіз үшін рахмет➡
Dialogue: 0,0:20:57.08,0:20:59.29,Default,,0,0,0,,Маған қалуға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:20:59.29,0:21:02.09,Default,,0,0,0,,Бірақ мен енді тым жұмсақ болғым келмейді...
Dialogue: 0,0:21:02.09,0:21:04.19,Default,,0,0,0,,Ах.
Dialogue: 0,0:21:06.76,0:21:09.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:09.06,0:21:11.57,Default,,0,0,0,,Қалай болғанда да, кешіріңіз! Ах.
Dialogue: 0,0:21:21.58,0:21:24.08,Default,,0,0,0,,《Мен не істеуім керек?
Dialogue: 0,0:21:24.08,0:21:26.41,Default,,0,0,0,,Мен не істеуім керек еді➡
Dialogue: 0,0:21:26.41,0:21:29.92,Default,,0,0,0,,Менде ештеңе жоқ.
Dialogue: 0,0:21:29.92,0:21:33.39,Default,,0,0,0,,Куросаваның сол беті➡
Dialogue: 0,0:21:33.39,0:21:35.59,Default,,0,0,0,,Бірінші рет көрдім》
Dialogue: 0,0:21:38.36,0:21:41.23,Default,,0,0,0,,《Мен не істеуім керек...》
Dialogue: 0,0:23:16.16,0:23:24.57,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:23:24.57,0:23:28.24,Default,,0,0,0,,Не болды? Осындай уақытта.
Dialogue: 0,0:23:28.24,0:23:31.87,Default,,0,0,0,,Маған бәрібір. Егер ол сіз туралы болса➡
Dialogue: 0,0:23:31.87,0:23:34.07,Default,,0,0,0,,Өйткені мен бәрінен де жақсы білемін.
Dialogue: 0,0:23:35.57,0:23:41.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
