Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:49.10,0:01:51.07,Default,,0,0,0,,Хмм….
Dialogue: 0,0:01:54.61,0:01:58.08,Default,,0,0,0,,《О, дұрыс. Куросава кеше➡
Dialogue: 0,0:01:58.08,0:02:01.25,Default,,0,0,0,,Нагасакиге келгеніңіз үшін рахмет... және...
Dialogue: 0,0:02:01.25,0:02:04.15,Default,,0,0,0,,Мен мұны жасадым!
Dialogue: 0,0:02:04.15,0:02:06.19,Default,,0,0,0,,Аа….
Dialogue: 0,0:02:06.19,0:02:09.22,Default,,0,0,0,,Шынымды айтсам, жүрегімдегі дауысты мәңгі естідім➡
Dialogue: 0,0:02:09.22,0:02:11.79,Default,,0,0,0,,Ұялғаным сонша, өлемін деп ойладым》
Dialogue: 0,0:02:13.80,0:02:18.13,Default,,0,0,0,,Осы уақытқа дейін мен Куросаваның дауысын естімейтінмін➡
Dialogue: 0,0:02:18.13,0:02:20.47,Default,,0,0,0,,Сенің не ойлайтыныңды білмеймін➡
Dialogue: 0,0:02:20.47,0:02:22.50,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:02:22.50,0:02:25.11,Default,,0,0,0,,Бірақ мен сені тастап кетсем де➡
Dialogue: 0,0:02:25.11,0:02:27.78,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін》
Dialogue: 0,0:02:27.78,0:02:29.98,Default,,0,0,0,,Ах... Қайырлы таң.
Dialogue: 0,0:02:32.95,0:02:36.12,Default,,0,0,0,,Тағы біраз ұйықтайық...
Dialogue: 0,0:02:38.95,0:02:41.12,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:43.46,0:02:46.96,Default,,0,0,0,,Иә? Куросава! Оян!
Dialogue: 0,0:02:46.96,0:02:49.97,Default,,0,0,0,,Маған түртіңіз! Не?
Dialogue: 0,0:02:49.97,0:02:53.77,Default,,0,0,0,,Сіз таңертеңнен бері белсенді болдыңыз. Фугия! басқа!
Dialogue: 0,0:02:56.77,0:03:00.11,Default,,0,0,0,,Жүр, бірдеңе ойлап тап!
Dialogue: 0,0:03:00.11,0:03:04.95,Default,,0,0,0,,Енді... сіз не ойладыңыз? Мені оятатын періште келсе екен➡
Dialogue: 0,0:03:04.95,0:03:07.28,Default,,0,0,0,,Бұл аспан ба?
Dialogue: 0,0:03:07.28,0:03:11.62,Default,,0,0,0,,Зефир щектері. Таңертеңнен бері өткір екенсің.
Dialogue: 0,0:03:11.62,0:03:13.62,Default,,0,0,0,,➡ емес
Dialogue: 0,0:03:13.62,0:03:16.26,Default,,0,0,0,,Мен енді жүрегімдегі дауысты ести алмаймын.
Dialogue: 0,0:03:16.26,0:03:19.76,Default,,0,0,0,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:03:19.76,0:03:24.17,Default,,0,0,0,,《Неге... Куросавамен істегендіктен бе?
Dialogue: 0,0:03:24.17,0:03:26.44,Default,,0,0,0,,Себебі мен 30 жасқа дейін пәк болдым➡
Dialogue: 0,0:03:26.44,0:03:29.81,Default,,0,0,0,,Мен сиқыршы болдым деп ойладым➡
Dialogue: 0,0:03:29.81,0:03:32.44,Default,,0,0,0,,Бұл шынымен басқаша ма?
Dialogue: 0,0:03:32.44,0:03:35.28,Default,,0,0,0,,Қыздықтың басқаша анықтамасы бар ма?
Dialogue: 0,0:03:35.28,0:03:39.25,Default,,0,0,0,,Немесе... Неліктен жер бетінде бұл болып жатыр?
Dialogue: 0,0:03:39.25,0:03:43.25,Default,,0,0,0,,Маған не болып жатыр? ? 》 Адачи.
Dialogue: 0,0:03:43.25,0:03:45.25,Default,,0,0,0,,Кофе алғыңыз келе ме?
Dialogue: 0,0:03:50.43,0:03:54.60,Default,,0,0,0,,Сіз тынышталдыңыз ба? Шатастыру үшін кешіріңіз.
Dialogue: 0,0:03:54.60,0:03:59.27,Default,,0,0,0,,Мен сиқыр кенеттен жоғалады деп ешқашан ойламадым.
Dialogue: 0,0:03:59.27,0:04:03.74,Default,,0,0,0,,Менің ойымша, ақыл-ойды оқи білудің күші керемет➡
Dialogue: 0,0:04:03.74,0:04:06.17,Default,,0,0,0,,Адачи менің жүрегімнің үні...
Dialogue: 0,0:04:06.17,0:04:10.45,Default,,0,0,0,,Асқыну, қызғаныш, қауіпті адасушылық...
Dialogue: 0,0:04:10.45,0:04:13.58,Default,,0,0,0,,Әр түрлі нәрселерді тыңдаңыз...
Dialogue: 0,0:04:13.58,0:04:17.29,Default,,0,0,0,,Лас және ақымақ жерлерді біл➡
Dialogue: 0,0:04:17.29,0:04:19.92,Default,,0,0,0,,Оның үстіне сен маған ғашық болып қалдың➡
Dialogue: 0,0:04:19.92,0:04:24.43,Default,,0,0,0,,Мен шынымен бақытты болдым және сол күшке ризамын.
Dialogue: 0,0:04:24.43,0:04:27.63,Default,,0,0,0,,Бұл... Бірақ➡
Dialogue: 0,0:04:27.63,0:04:30.77,Default,,0,0,0,,Менің жүрегімді елжіреткен бірінші адам➡ болды
Dialogue: 0,0:04:30.77,0:04:32.73,Default,,0,0,0,,Бұл сиқырлы күш туралы емес...
Dialogue: 0,0:04:37.14,0:04:41.44,Default,,0,0,0,,Бұл Адачидің өз сөзі еді. а….
Dialogue: 0,0:04:41.44,0:04:44.95,Default,,0,0,0,,Әлде өкінесіз бе?
Dialogue: 0,0:04:44.95,0:04:47.62,Default,,0,0,0,,Менімен не істедің. Мен істеген жоқпын!
Dialogue: 0,0:04:47.62,0:04:50.09,Default,,0,0,0,,Мен еш өкінбеймін! абсолютті!
Dialogue: 0,0:04:52.09,0:04:55.79,Default,,0,0,0,,Мен... Мен Куросаваға қатты ғашық болдым➡
Dialogue: 0,0:04:55.79,0:04:58.43,Default,,0,0,0,,Мен өз сезімімді сөзбен жеткізе алмаймын деп ойладым...
Dialogue: 0,0:04:58.43,0:05:01.43,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:01.43,0:05:04.10,Default,,0,0,0,,Осы уақытқа дейін мен Куросаваға қол тигізуім керек➡
Dialogue: 0,0:05:04.10,0:05:07.60,Default,,0,0,0,,Мен не ойлайтынымды білмегендіктен қорықтым.
Dialogue: 0,0:05:07.60,0:05:10.61,Default,,0,0,0,,Бірақ қазірден бастап, егер сіз алаңдасаңыз➡
Dialogue: 0,0:05:10.61,0:05:13.51,Default,,0,0,0,,Сөзбен жеткізіңіз➡
Dialogue: 0,0:05:13.51,0:05:16.08,Default,,0,0,0,,Түртіңіз, түртіңіз, тексеріңіз➡
Dialogue: 0,0:05:16.08,0:05:18.28,Default,,0,0,0,,Себебі мен түсінемін...
Dialogue: 0,0:05:18.28,0:05:21.95,Default,,0,0,0,,Иә! Ақыры түсіндім.
Dialogue: 0,0:05:21.95,0:05:26.12,Default,,0,0,0,,Сиқыр болмаса да, мен Куросаваға жарайды деп ойладым...
Dialogue: 0,0:05:28.09,0:05:30.16,Default,,0,0,0,,Демек, сиқыр жоғалып кеткен болуы керек...
Dialogue: 0,0:05:37.00,0:05:39.77,Default,,0,0,0,,Ах.
Dialogue: 0,0:05:39.77,0:05:42.60,Default,,0,0,0,,Не деген қанды сөз...
Dialogue: 0,0:05:42.60,0:05:46.14,Default,,0,0,0,,Неліктен Адачи үнемі осылай жасайды?
Dialogue: 0,0:05:46.14,0:05:48.44,Default,,0,0,0,,Алдау.
Dialogue: 0,0:05:48.44,0:05:52.28,Default,,0,0,0,,Сіз маған қарағанда салқынсыз.
Dialogue: 0,0:05:52.28,0:05:56.85,Default,,0,0,0,,Осы уақытқа дейін мен мінсіз болуға тырыстым.
Dialogue: 0,0:05:56.85,0:06:00.42,Default,,0,0,0,,Бірақ мен Адачиге ғашық болдым➡
Dialogue: 0,0:06:00.42,0:06:06.09,Default,,0,0,0,,Ұсақ-түйек нәрселерге толқу және шарасыздық➡
Dialogue: 0,0:06:06.09,0:06:08.60,Default,,0,0,0,,Маған шіркін көп жағыңды көрсетші...
Dialogue: 0,0:06:11.63,0:06:15.94,Default,,0,0,0,,Мен Адачимен бірге болғанда, мен мүлде мінсіз бола алмаймын.
Dialogue: 0,0:06:17.77,0:06:21.44,Default,,0,0,0,,Бірақ мен де онша жаман емеспін➡
Dialogue: 0,0:06:21.44,0:06:24.78,Default,,0,0,0,,Неге екені белгісіз, мен солай ойлаймын. Куросава...
Dialogue: 0,0:06:24.78,0:06:29.35,Default,,0,0,0,,Мен сені одан сайын жақсы көрсем, жынданып қаламын деп ойлаймын.
Dialogue: 0,0:06:29.35,0:06:32.09,Default,,0,0,0,,Егер бұдан да оғаш нәрсе болса, мен қиыншылыққа тап болмас едім.
Dialogue: 0,0:06:32.09,0:06:35.89,Default,,0,0,0,,Эй... Мен жылауымды тоқтата алмаймын.
Dialogue: 0,0:06:44.60,0:06:47.94,Default,,0,0,0,,Енді... менің не ойлап тұрғанымды білесің бе?
Dialogue: 0,0:06:47.94,0:06:50.77,Default,,0,0,0,,Мен саған айттым ғой, сен енді ойды оқи алмайсың.
Dialogue: 0,0:06:50.77,0:06:53.14,Default,,0,0,0,,Өтірік. Сен түсінесің.
Dialogue: 0,0:06:53.14,0:06:56.11,Default,,0,0,0,,Ауызбен айт. Мен сіздің болжауыңызды қалаймын.
Dialogue: 0,0:06:59.01,0:07:01.28,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:10.46,0:07:14.10,Default,,0,0,0,,Жүрегіңдегі дауысты естімегенде тыныштық.
Dialogue: 0,0:07:14.10,0:07:16.13,Default,,0,0,0,,Бәрін дауыстап айтайын ба?
Dialogue: 0,0:07:16.13,0:07:21.14,Default,,0,0,0,,Жоқ, жақсы. Әйтеуір сенің дауысыңды естімеймін➡
Dialogue: 0,0:07:21.14,0:07:24.77,Default,,0,0,0,,Куросаваның дене қызуы, иісі, т.б.➡
Dialogue: 0,0:07:24.77,0:07:29.14,Default,,0,0,0,,Мен оны бұрынғыдан да күшті сезінемін.
Dialogue: 0,0:07:29.14,0:07:31.78,Default,,0,0,0,,Адачи: Шынымен... (дабыл)
Dialogue: 0,0:07:31.78,0:07:33.75,Default,,0,0,0,,Әй, ұшу уақыты!
Dialogue: 0,0:07:36.62,0:07:39.95,Default,,0,0,0,,Уау! Бұл таңғы алғашқы рейс пе?
Dialogue: 0,0:07:39.95,0:07:43.12,Default,,0,0,0,,Уф, бұл қиын. Мен үйге барғым келмейді.
Dialogue: 0,0:07:43.12,0:07:48.03,Default,,0,0,0,,Сондай-ақ, трансфер туралы... Аа, қайтып келгенде сөйлесейік.
Dialogue: 0,0:07:48.03,0:07:50.93,Default,,0,0,0,,Мен өз үйімде тұра аламын ба? Оу.
Dialogue: 0,0:07:50.93,0:07:55.14,Default,,0,0,0,,Содан кейін жалғастырыңыз. Ах.
Dialogue: 0,0:07:55.14,0:07:59.11,Default,,0,0,0,,《Мен бұл туралы жақсылап ойлануым керек, сондықтан өкінбеймін.》
Dialogue: 0,0:07:59.11,0:08:01.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:01.51,0:08:04.48,Default,,0,0,0,,Ах…. жоғалған зат.
Dialogue: 0,0:08:06.61,0:08:09.92,Default,,0,0,0,,Әлгі ақымақ.
Dialogue: 0,0:08:09.92,0:08:12.12,Default,,0,0,0,,《Сіздің шешіміңіз түтіккен болады.》
Dialogue: 0,0:08:21.60,0:08:25.43,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:25.43,0:08:37.11,Default,,0,0,0,,♬～
Dialogue: 0,0:08:37.11,0:08:39.08,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:08:43.15,0:08:45.59,Default,,0,0,0,,А, өте дәмді болды.
Dialogue: 0,0:08:45.59,0:08:48.26,Default,,0,0,0,,Рахмет. Бұл бір нәрсе болса да.
Dialogue: 0,0:08:48.26,0:08:50.26,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:08:53.09,0:08:57.27,Default,,0,0,0,,Бұл трансфер туралы, бірақ мен оны қабылдаймын деп ойлаймын.
Dialogue: 0,0:08:57.27,0:09:00.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:00.27,0:09:02.60,Default,,0,0,0,,Бастапқыда мені қатты қызықтырған жоқ➡
Dialogue: 0,0:09:02.60,0:09:05.47,Default,,0,0,0,,Саған жақсы қарады деп ойладым➡
Dialogue: 0,0:09:05.47,0:09:10.08,Default,,0,0,0,,Мен дүкенге қарасам, мүлдем бос екен...
Dialogue: 0,0:09:10.08,0:09:12.61,Default,,0,0,0,,Егер сіз мұны нөлден жасай аласыз ба деп ойласаңыз, мұнда➡
Dialogue: 0,0:09:12.61,0:09:16.75,Default,,0,0,0,,Неге екенін білмеймін, бірақ көңілім толқып тұр...
Dialogue: 0,0:09:16.75,0:09:20.92,Default,,0,0,0,,Шынымды айтсам, мен біраз қобалжып тұрмын, өйткені мен бір нәрсені бірінші рет іске қосып отырмын.
Dialogue: 0,0:09:20.92,0:09:23.12,Default,,0,0,0,,Жарайды, Адачи.
Dialogue: 0,0:09:25.59,0:09:29.76,Default,,0,0,0,,Рахмет. Хехе, неге рахмет айтасың?
Dialogue: 0,0:09:29.76,0:09:32.93,Default,,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:09:32.93,0:09:36.10,Default,,0,0,0,,Мен Нагасакиге барып, тағы да ойландым.
Dialogue: 0,0:09:36.10,0:09:39.47,Default,,0,0,0,,Менің позитивті бола алған себебім➡
Dialogue: 0,0:09:39.47,0:09:44.25,Default,,0,0,0,,Куросаваға рахмет. Куросаваның жүрек үніне➡
Dialogue: 0,0:09:44.25,0:09:46.25,Default,,0,0,0,,Өйткені ол маған әрқашан сенімділік берді.
Dialogue: 0,0:09:48.42,0:09:53.32,Default,,0,0,0,,Кетуім өкінішті, бірақ мен жаңа дүкен ашамын➡
Dialogue: 0,0:09:53.32,0:09:57.59,Default,,0,0,0,,Мен бір жыл ішінде ертерек оралатын сияқтымын...
Dialogue: 0,0:09:57.59,0:09:59.69,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:03.10,0:10:06.60,Default,,0,0,0,,Түсіндім. Барасың ба?
Dialogue: 0,0:10:06.60,0:10:10.24,Default,,0,0,0,,Иә! Бос емес болады деп ойлаймын➡
Dialogue: 0,0:10:10.24,0:10:13.14,Default,,0,0,0,,Бұл біздің компания үшін маңызды сәт.
Dialogue: 0,0:10:13.14,0:10:15.44,Default,,0,0,0,,Өтінемін. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:10:18.61,0:10:22.42,Default,,0,0,0,,《Мен Куросавадан біраз уақыт бөлінемін.
Dialogue: 0,0:10:22.42,0:10:26.29,Default,,0,0,0,,Шынымды айтсам, мен уайымдамадым десем өтірік айтқан болар едім.
Dialogue: 0,0:10:26.29,0:10:28.36,Default,,0,0,0,,Бірақ…》
Dialogue: 0,0:10:28.36,0:10:31.19,Default,,0,0,0,,｟Бұл Адачи болса, жарайды｠
Dialogue: 0,0:10:31.19,0:10:33.50,Default,,0,0,0,,《Мен бар күшімді салуым керек. Жақсы! 》
Dialogue: 0,0:10:39.43,0:10:43.10,Default,,0,0,0,,Адачи Бұл картон кітаптарға жарамды ма?
Dialogue: 0,0:10:43.10,0:10:45.67,Default,,0,0,0,,Иә. Бұл орынды және жақсы.
Dialogue: 0,0:10:48.28,0:10:51.95,Default,,0,0,0,,Жұмыс күндері кешіріңіз. Цюге маған көмектесті➡
Dialogue: 0,0:10:51.95,0:10:55.92,Default,,0,0,0,,Бұл маған шынымен көмектесті. Уайымдама.
Dialogue: 0,0:10:55.92,0:10:58.32,Default,,0,0,0,,《Мен көмектескім келді》
Dialogue: 0,0:10:58.32,0:11:01.96,Default,,0,0,0,,Бірақ мені шынымен ауыстырады деп ойламаймын.
Dialogue: 0,0:11:01.96,0:11:04.43,Default,,0,0,0,,Жарайды, бұл жай ғана жарнама➡
Dialogue: 0,0:11:04.43,0:11:07.60,Default,,0,0,0,,Менде енді мұндай мүмкіндік болмайды.
Dialogue: 0,0:11:07.60,0:11:10.77,Default,,0,0,0,,Мен оны Куросавамен жан-жақты талқылап, шешім қабылдадым➡
Dialogue: 0,0:11:10.77,0:11:14.30,Default,,0,0,0,,Мұның бәрі мені итеріп жібергені үшін Цюгенің арқасы.
Dialogue: 0,0:11:14.30,0:11:18.41,Default,,0,0,0,,Рахмет. Тағы да алғысымды білдіргенім сонша➡
Dialogue: 0,0:11:18.41,0:11:21.11,Default,,0,0,0,,Ештеңе емес. Ахах...
Dialogue: 0,0:11:21.11,0:11:23.78,Default,,0,0,0,,Цюге сияқты. иә?
Dialogue: 0,0:11:23.78,0:11:25.75,Default,,0,0,0,,《Цугэ: Гумте қосылды》
Dialogue: 0,0:11:25.75,0:11:28.92,Default,,0,0,0,,《Сонымен қатар, мен енді сиқыршы емеспін➡
Dialogue: 0,0:11:28.92,0:11:30.92,Default,,0,0,0,,Мен мұны айтуым керек деп ойлаймын.
Dialogue: 0,0:11:30.92,0:11:34.09,Default,,0,0,0,,Жоқ, оны айтудың да қажеті жоқ...》
Dialogue: 0,0:11:34.09,0:11:36.12,Default,,0,0,0,,Ах…. Кешіріңіз.
Dialogue: 0,0:11:36.12,0:11:38.43,Default,,0,0,0,,Мен сұрағым келмеді, бірақ...
Dialogue: 0,0:11:38.43,0:11:42.50,Default,,0,0,0,,Ах! Ал, жақсы….
Dialogue: 0,0:11:42.50,0:11:46.77,Default,,0,0,0,,Мен сізден егжей-тегжейлі сұрамаймын, бірақ бәрібір жақсы болды.
Dialogue: 0,0:11:46.77,0:11:48.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:48.74,0:11:52.44,Default,,0,0,0,,《Бірақ Адачи де өзгерді.
Dialogue: 0,0:11:52.44,0:11:56.84,Default,,0,0,0,,Алғашында басқаның мейірімділігіне таң қалдым➡
Dialogue: 0,0:11:56.84,0:11:59.21,Default,,0,0,0,,Өз еркіңізбен басқа адамның қолын алыңыз...》
Dialogue: 0,0:12:01.75,0:12:04.95,Default,,0,0,0,,《Цюге: Мен сиқырға сенбей бірге тұруды шештім》
Dialogue: 0,0:12:08.29,0:12:12.93,Default,,0,0,0,,《Мен қазірден бастап ішімді қатты ұстауым керек.
Dialogue: 0,0:12:12.93,0:12:14.93,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:14.93,0:12:18.13,Default,,0,0,0,,Мен де сиқырымнан айырылатын күн келе ме? ? 》
Dialogue: 0,0:12:28.21,0:12:31.48,Default,,0,0,0,,<Нагасакиге ауыстырылғаннан кейін бір ай.
Dialogue: 0,0:12:31.48,0:12:35.85,Default,,0,0,0,,Әр күн мен елестеткеннен әлдеқайда қиын.
Dialogue: 0,0:12:35.85,0:12:37.89,Default,,0,0,0,,☎
Dialogue: 0,0:12:37.89,0:12:41.29,Default,,0,0,0,,Иә Тоёкава Нагасаки филиалы.
Dialogue: 0,0:12:41.29,0:12:46.13,Default,,0,0,0,,Иә, иә. Кусумото мырза, біз не істеуіміз керек?
Dialogue: 0,0:12:46.13,0:12:48.80,Default,,0,0,0,,Түсқағазға уақытында тапсырыс бере алмайтын сияқтымыз...
Dialogue: 0,0:12:48.80,0:12:51.80,Default,,0,0,0,,А... Мен бірден дайындайтын нәрсе бар ма?➡
Dialogue: 0,0:12:51.80,0:12:53.80,Default,,0,0,0,,Жергілікті дилерден сұраңыз.
Dialogue: 0,0:12:53.80,0:12:57.14,Default,,0,0,0,,Жеткізу мерзімі: 15 күн! ? Мен оны естіген жоқпын.
Dialogue: 0,0:12:57.14,0:13:00.31,Default,,0,0,0,,Кешірім сұраймыз. Мен электрондық поштаны жібердім ...
Dialogue: 0,0:13:00.31,0:13:03.48,Default,,0,0,0,,Өйткені біз аналогпыз. кешіріңіз.
Dialogue: 0,0:13:03.48,0:13:07.45,Default,,0,0,0,,Енді мен оны факс арқылы жіберемін. Аа….
Dialogue: 0,0:13:07.45,0:13:11.15,Default,,0,0,0,,Ватанабе мырза демалыс бөлмесінде темекі шегіп отыр...
Dialogue: 0,0:13:11.15,0:13:14.62,Default,,0,0,0,,Маған ескерте аласыз ба? Жарайды➡
Dialogue: 0,0:13:14.62,0:13:17.33,Default,,0,0,0,,Мен саған кеше де ескерттім...
Dialogue: 0,0:13:17.33,0:13:20.96,Default,,0,0,0,,Мен дереу темекі шегуге арналған орын орнатамын, сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:13:20.96,0:13:24.63,Default,,0,0,0,,《Уф... Қиындықтар бірінен соң бірі келе береді...
Dialogue: 0,0:13:24.63,0:13:28.80,Default,,0,0,0,,Барлығына Кусумото мырза көмектесті...》
Dialogue: 0,0:13:28.80,0:13:31.64,Default,,0,0,0,,Түсіндім, Адачи...
Dialogue: 0,0:13:31.64,0:13:34.18,Default,,0,0,0,,Сенің қиналып жатқаныңды естідім.
Dialogue: 0,0:13:34.18,0:13:36.78,Default,,0,0,0,,Ал, бұл бейтаныс жер➡
Dialogue: 0,0:13:36.78,0:13:39.95,Default,,0,0,0,,Бұл менің бірінші рет жаңа дүкен ашуым.
Dialogue: 0,0:13:39.95,0:13:43.28,Default,,0,0,0,,Иә. Бірақ егер ол...
Dialogue: 0,0:13:43.28,0:13:47.46,Default,,0,0,0,,Жарайды, мен де Адачиден үлкен үміт күтемін.
Dialogue: 0,0:13:47.46,0:13:49.46,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:49.46,0:13:52.13,Default,,0,0,0,,《Адачи күресіп жатыр…》
Dialogue: 0,0:13:52.13,0:13:55.30,Default,,0,0,0,,Кохон Кохон…. (Алтыбұрыш) Жоқ, Куросава-сан.
Dialogue: 0,0:13:55.30,0:13:57.97,Default,,0,0,0,,Не? Шығуға мәжбүрлеме➡
Dialogue: 0,0:13:57.97,0:14:00.64,Default,,0,0,0,,Жарайды. Жаздың салқынын нашарлатсаңыз➡
Dialogue: 0,0:14:00.64,0:14:04.14,Default,,0,0,0,,Мазасыздық деп аталады... О, жоқ➡
Dialogue: 0,0:14:04.14,0:14:07.81,Default,,0,0,0,,Мен енді ештеңе істей алмаймын... О, жоқ... Куросава мырза!
Dialogue: 0,0:14:07.81,0:14:11.28,Default,,0,0,0,,《Фудзисаки: Куросава мырза, Адачи мырзаның ауысуы мені әлсіз сезінді ➡
Dialogue: 0,0:14:11.28,0:14:13.65,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:14:13.65,0:14:17.62,Default,,0,0,0,,Бірақ бір-бірімізді көре алмаған кезде махаббат артады дейді...
Dialogue: 0,0:14:17.62,0:14:19.92,Default,,0,0,0,,Курода, шыда! 》
Dialogue: 0,0:14:31.80,0:14:33.97,Default,,0,0,0,,Кайо-чан мен Ая-чанды да бірге шақырғаныңда мен өте қуандым!
Dialogue: 0,0:14:36.27,0:14:39.64,Default,,0,0,0,,《Бұлай жалғаса берсе, мен міндетті түрде ұйықтаймын.
Dialogue: 0,0:14:39.64,0:14:42.61,Default,,0,0,0,,Маған материалдар жасау керек...
Dialogue: 0,0:14:42.61,0:14:48.82,Default,,0,0,0,,Жаңа дүкен ашуда көп нәрсе істеу керек.
Dialogue: 0,0:14:48.82,0:14:52.29,Default,,0,0,0,,Мені бас кеңседен жібергендіктен ғана басшы ретінде қарайды➡
Dialogue: 0,0:14:52.29,0:14:54.46,Default,,0,0,0,,Жүйені аздап өзгерту➡
Dialogue: 0,0:14:54.46,0:14:57.63,Default,,0,0,0,,Нақты дүкендердің пайдасы жоқ ➡
Dialogue: 0,0:14:57.63,0:15:00.13,Default,,0,0,0,,Тәжірибе жағынан да, қарым-қатынас дағдылары жағынан да➡
Dialogue: 0,0:15:00.13,0:15:02.53,Default,,0,0,0,,Менің ойымша, Кусумото мырза жетекші болса жақсы болар еді➡
Dialogue: 0,0:15:02.53,0:15:05.30,Default,,0,0,0,,Адамдарға бұлай ойлау қиын...》
Dialogue: 0,0:15:05.30,0:15:07.30,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:07.30,0:15:10.17,Default,,0,0,0,,《Жоқ, күшті болсам➡
Dialogue: 0,0:15:10.17,0:15:12.74,Default,,0,0,0,,Бұл жай ғана...》
Dialogue: 0,0:15:12.74,0:15:16.71,Default,,0,0,0,,Аа... (Жаңбыр дыбысы)
Dialogue: 0,0:15:22.35,0:15:24.35,Default,,0,0,0,,Жаңбыр….
Dialogue: 0,0:15:26.45,0:15:30.99,Default,,0,0,0,,《Куросава... мен сенімен танысқым келеді...
Dialogue: 0,0:15:30.99,0:15:34.16,Default,,0,0,0,,Мен Токиода болған кезім Біз кездесе бастағаннан кейін де➡
Dialogue: 0,0:15:34.16,0:15:37.43,Default,,0,0,0,,Кездесе алмаған кездеріміз көп болса да...》
Dialogue: 0,0:15:39.47,0:15:41.97,Default,,0,0,0,,｟Асахина: Сенің қиналып жатқаныңды естідім.
Dialogue: 0,0:15:44.11,0:15:46.47,Default,,0,0,0,,《Қандай күрес➡
Dialogue: 0,0:15:46.47,0:15:50.58,Default,,0,0,0,,Бұл мүлде олай емес еді.
Dialogue: 0,0:15:50.58,0:15:54.85,Default,,0,0,0,,Адачи... мені алаңдатпау үшін үндемедің бе? 》
Dialogue: 0,0:15:57.45,0:15:59.42,Default,,0,0,0,,《Не жазуым керек...》
Dialogue: 0,0:16:08.63,0:16:11.63,Default,,0,0,0,,《Кеше хабар келді: суық тиіп қалдым...
Dialogue: 0,0:16:11.63,0:16:14.80,Default,,0,0,0,,Бұл шынымен жақсы ма? Ха, мүмкін тағы да...》
Dialogue: 0,0:16:14.80,0:16:17.64,Default,,0,0,0,,А…?
Dialogue: 0,0:16:17.64,0:16:19.61,Default,,0,0,0,,《Аа, жақсы》
Dialogue: 0,0:16:21.81,0:16:25.48,Default,,0,0,0,,《Бірақ мен қатты ауырып тұрмын➡
Dialogue: 0,0:16:25.48,0:16:27.85,Default,,0,0,0,,Мен ауруханаға түссем де➡
Dialogue: 0,0:16:27.85,0:16:31.92,Default,,0,0,0,,Менімен ешкім хабарласпайды деп ойлаймын...
Dialogue: 0,0:16:31.92,0:16:36.29,Default,,0,0,0,,Біздің қарым-қатынасымызды ешкім білмейді...
Dialogue: 0,0:16:36.29,0:16:40.13,Default,,0,0,0,,Өте тұрақсыз...》
Dialogue: 0,0:16:40.13,0:16:44.73,Default,,0,0,0,,《Мен неге сонша уайымдаймын?
Dialogue: 0,0:16:44.73,0:16:47.60,Default,,0,0,0,,Адачи: "Куросавамен бәрібір" ➡ деді
Dialogue: 0,0:16:47.60,0:16:50.27,Default,,0,0,0,,Маған айтсаң да...》
Dialogue: 0,0:16:50.27,0:16:52.47,Default,,0,0,0,,《Бұлай жалғастыра алмаймыз.
Dialogue: 0,0:16:52.47,0:16:56.44,Default,,0,0,0,,Мен қазір Куросава үшін не істей аламын?
Dialogue: 0,0:17:03.62,0:17:07.12,Default,,0,0,0,,Олай болса, бұл попты тікелей дүкенге апарайық.
Dialogue: 0,0:17:07.12,0:17:10.12,Default,,0,0,0,,Иә. Осы демалыс күндері ашылады➡
Dialogue: 0,0:17:10.12,0:17:14.10,Default,,0,0,0,,Жақсы. көп рахмет.
Dialogue: 0,0:17:14.10,0:17:16.46,Default,,0,0,0,,Мені жақсы сатушымен таныстырғаныңыз үшін рахмет.
Dialogue: 0,0:17:16.46,0:17:20.30,Default,,0,0,0,,Жоқ, олай емес. Мен әрқашан жергілікті болдым.
Dialogue: 0,0:17:20.30,0:17:23.44,Default,,0,0,0,,Оның үстіне, ол соңғы минутта поптың қатесін байқады➡
Dialogue: 0,0:17:23.44,0:17:26.94,Default,,0,0,0,,Көмегің үшін рахмет. а….
Dialogue: 0,0:17:26.94,0:17:29.64,Default,,0,0,0,,Көп қате жіберген кіші бала болды.
Dialogue: 0,0:17:32.28,0:17:36.45,Default,,0,0,0,,Енді мен жұмысты аяқтадым, бүгін кешке сусын ішуге барғың келе ме?
Dialogue: 0,0:17:36.45,0:17:39.62,Default,,0,0,0,,А, кешіріңіз. Бүгін түстен кейін➡
Dialogue: 0,0:17:39.62,0:17:43.46,Default,,0,0,0,,Мен демалыс күнін алып жатырмын. Менің бір ісім бар...
Dialogue: 0,0:17:43.46,0:17:49.13,Default,,0,0,0,,《Мен үшін өмірімдегі ең маңызды тапсырма...
Dialogue: 0,0:17:49.13,0:17:52.47,Default,,0,0,0,,Мен күте алмаймын. Бір сәтке де емес...
Dialogue: 0,0:17:52.47,0:17:55.14,Default,,0,0,0,,Сиқыр бұзылып, ертегі болса ше➡
Dialogue: 0,0:17:55.14,0:17:58.54,Default,,0,0,0,,Қуанышты нотамен аяқталады➡
Dialogue: 0,0:17:58.54,0:18:01.28,Default,,0,0,0,,Біздің өміріміз қазірден басталады➡
Dialogue: 0,0:18:01.28,0:18:03.78,Default,,0,0,0,,Сөзбен жеткізу мүмкін емес нәрселер бар.
Dialogue: 0,0:18:03.78,0:18:08.45,Default,,0,0,0,,Бірақ сөзсіз жеткізу мүмкін емес нәрселер бар.
Dialogue: 0,0:18:08.45,0:18:12.95,Default,,0,0,0,,Мен сізге Куроса деп айтсам, қандай бет-әлпет жасар едіңіз...》
Dialogue: 0,0:18:12.95,0:18:16.86,Default,,0,0,0,,Ха ха ха... Ах.
Dialogue: 0,0:18:16.86,0:18:21.76,Default,,0,0,0,,Куросава! Адачи...
Dialogue: 0,0:18:21.76,0:18:25.67,Default,,0,0,0,,Неліктен? Мен... Нагасакиге бармақшы болдым.
Dialogue: 0,0:18:25.67,0:18:29.17,Default,,0,0,0,,Не? а…. Бірақ амал жоқ➡
Dialogue: 0,0:18:29.17,0:18:32.31,Default,,0,0,0,,Сенің келе жатқаныңа сене алар емеспін... Иә.
Dialogue: 0,0:18:32.31,0:18:35.11,Default,,0,0,0,,Мен... Куросаваға бармасқа амалым жоқ➡
Dialogue: 0,0:18:35.11,0:18:37.11,Default,,0,0,0,,Мен сізге бір нәрсе айтқым келеді.
Dialogue: 0,0:18:43.78,0:18:46.95,Default,,0,0,0,,Біз бөлекпіз және жұмысқа тым бос емеспіз➡
Dialogue: 0,0:18:46.95,0:18:51.63,Default,,0,0,0,,Мен де теріс айналдым, себебі мен Куросава➡ кездесуін сағындым
Dialogue: 0,0:18:51.63,0:18:54.13,Default,,0,0,0,,Мен одан сайын уайымдап барамын...
Dialogue: 0,0:18:54.13,0:18:56.30,Default,,0,0,0,,Мен бұл туралы өзінше ойладым.
Dialogue: 0,0:18:56.30,0:18:59.67,Default,,0,0,0,,Адачи…. Бұл алаңдаушылықты жою үшін ➡
Dialogue: 0,0:18:59.67,0:19:03.97,Default,,0,0,0,,Мен не істеуім керек? Бұл жай ғана сөз бен қол тигізу емес➡
Dialogue: 0,0:19:03.97,0:19:07.44,Default,,0,0,0,,Менің ойымша, бізге сенімдірек нәрсе керек.
Dialogue: 0,0:19:11.35,0:19:13.95,Default,,0,0,0,,Нагасакидегі жұмыстан кейін➡
Dialogue: 0,0:19:13.95,0:19:16.12,Default,,0,0,0,,Токиоға оралғанда➡
Dialogue: 0,0:19:16.12,0:19:20.12,Default,,0,0,0,,Мен... Мен Куросавамен бірге тұрғым келеді!
Dialogue: 0,0:19:20.12,0:19:23.79,Default,,0,0,0,,Ах…. Бұдан былай екеуміз әрқашан бірге боламыз➡
Dialogue: 0,0:19:23.79,0:19:30.16,Default,,0,0,0,,Бірге болудың алғашқы қадамы ретінде...
Dialogue: 0,0:19:30.16,0:19:34.74,Default,,0,0,0,,Бұл қауіпті. Мен мүлдем абайсызда ұсталдым ...
Dialogue: 0,0:19:34.74,0:19:58.59,Default,,0,0,0,,♬～
Dialogue: 0,0:19:58.59,0:20:02.26,Default,,0,0,0,,Мен де Адачимен бірге болғым келеді.
Dialogue: 0,0:20:02.26,0:20:04.43,Default,,0,0,0,,Біз мәңгі бірге боламыз.
Dialogue: 0,0:20:04.43,0:20:07.94,Default,,0,0,0,,Сонымен... иә?
Dialogue: 0,0:20:07.94,0:20:10.30,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:10.30,0:20:12.44,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:20:12.44,0:20:38.93,Default,,0,0,0,,♬～
Dialogue: 0,0:20:46.64,0:20:49.64,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:20:49.64,0:20:52.05,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:20:52.05,0:21:04.69,Default,,0,0,0,,♬～
Dialogue: 0,0:21:04.69,0:21:07.13,Default,,0,0,0,,Рахмет сізге.
Dialogue: 0,0:21:07.13,0:21:09.83,Default,,0,0,0,,Цюгемен танысқаным сенің арқаңда.
Dialogue: 0,0:21:09.83,0:21:11.97,Default,,0,0,0,,Мияу. Удонға арналған тағамдар➡
Dialogue: 0,0:21:11.97,0:21:14.14,Default,,0,0,0,,Оны әкелдің бе?
Dialogue: 0,0:21:14.14,0:21:16.94,Default,,0,0,0,,Әдеттегідей рахмет. Жақсы.
Dialogue: 0,0:21:25.95,0:21:29.45,Default,,0,0,0,,Адачи-сан Куросава-сан! Мен саунаға билет алдым!
Dialogue: 0,0:21:29.45,0:21:31.45,Default,,0,0,0,,Шынайы ма? Жүр, бірге ойнайық!
Dialogue: 0,0:21:31.45,0:21:33.62,Default,,0,0,0,,Жақсы. Хмм, мен бұл туралы ойланамын. (Алтыбұрыш) Бұл➡
Dialogue: 0,0:21:33.62,0:21:35.66,Default,,0,0,0,,Куросава мырза, көңіл-күйіңіз нашар!
Dialogue: 0,0:21:35.66,0:21:38.13,Default,,0,0,0,,《Бүгін де жарқырап тұрған жұп сақина!
Dialogue: 0,0:21:38.13,0:21:42.13,Default,,0,0,0,,Мұны неге менің айналамдағы ешкім байқамайды? ?
Dialogue: 0,0:21:42.13,0:21:44.97,Default,,0,0,0,,Ах~ Курода тым қымбат➡
Dialogue: 0,0:21:44.97,0:21:47.30,Default,,0,0,0,,Мен дем ала алмаймын...》
Dialogue: 0,0:21:47.30,0:21:52.14,Default,,0,0,0,,Құпия ингредиент қантты қосу оны әлдеқайда жақсы етеді.
Dialogue: 0,0:21:52.14,0:21:54.81,Default,,0,0,0,,Мен көремін. Бір шай қасық.
Dialogue: 0,0:21:54.81,0:21:56.81,Default,,0,0,0,,О.
Dialogue: 0,0:21:56.81,0:22:21.50,Default,,0,0,0,,♬～
Dialogue: 0,0:23:34.78,0:23:36.81,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:23:36.81,0:23:39.18,Default,,0,0,0,,Дәл қазір. Қайтадан қош келдіңіз.
Dialogue: 0,0:23:40.68,0:23:46.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
