Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.16,0:00:04.13,Default,,0,0,0,,Мияу.
Dialogue: 0,0:00:07.17,0:00:12.14,Default,,0,0,0,,Мияу. мияу.
Dialogue: 0,0:00:12.14,0:00:15.81,Default,,0,0,0,,Хмм…. мияу.
Dialogue: 0,0:00:15.81,0:00:18.78,Default,,0,0,0,,Уф. Аа….
Dialogue: 0,0:00:22.99,0:00:24.95,Default,,0,0,0,,Ерте, удон.
Dialogue: 0,0:00:27.12,0:00:30.33,Default,,0,0,0,,Мияу.
Dialogue: 0,0:00:30.33,0:00:33.20,Default,,0,0,0,,Иә. Әлі ашпадың ба?
Dialogue: 0,0:00:39.20,0:00:42.30,Default,,0,0,0,,Удонның арқасында мен таңғы адаммын.
Dialogue: 0,0:00:46.98,0:00:50.98,Default,,0,0,0,,Бүгін мен 7-тараудың соңына барғым келеді.
Dialogue: 0,0:00:50.98,0:00:56.49,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:00:56.49,0:00:59.32,Default,,0,0,0,,Га. (Минато) Үйдесің бе?
Dialogue: 0,0:00:59.32,0:01:01.32,Default,,0,0,0,,Қайта жеткізу.
Dialogue: 0,0:01:01.32,0:01:03.49,Default,,0,0,0,,Гэез. Тағы да бұл жігіт пе?
Dialogue: 0,0:01:05.49,0:01:08.26,Default,,0,0,0,,《Бұл адам жақында осы аймақта жеткізуші болды...》
Dialogue: 0,0:01:10.67,0:01:12.63,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:01:14.80,0:01:18.11,Default,,0,0,0,,《Цюге: Шынымды айтсам, мен ондайға жақсы емеспін.
Dialogue: 0,0:01:18.11,0:01:22.21,Default,,0,0,0,,Көру қабілеті нашар, түрі біртүрлі》
Dialogue: 0,0:01:22.21,0:01:25.81,Default,,0,0,0,,Сәлеметсіз бе. (Минато) Штамп төсек сулау.
Dialogue: 0,0:01:25.81,0:01:27.98,Default,,0,0,0,,《Цюге: Үйден және баспадан?
Dialogue: 0,0:01:27.98,0:01:30.65,Default,,0,0,0,,Қызық... Дұрыс.
Dialogue: 0,0:01:30.65,0:01:33.99,Default,,0,0,0,,Кеше сіздің туған күніңіз болды ма? ұмытып қалдым》
Dialogue: 0,0:01:33.99,0:01:37.53,Default,,0,0,0,,《Минато: Мені неше рет шақырасың, мына қария?》
Dialogue: 0,0:01:37.53,0:01:39.83,Default,,0,0,0,,Сәлеметсіз бе. Ха! ?
Dialogue: 0,0:01:39.83,0:01:42.20,Default,,0,0,0,,《Минато: сенің үйде екеніңді білемін➡
Dialogue: 0,0:01:42.20,0:01:45.47,Default,,0,0,0,,Бұл қайтарып алу》
Dialogue: 0,0:01:45.47,0:01:48.47,Default,,0,0,0,,《Бұл не! ?
Dialogue: 0,0:01:48.47,0:01:50.64,Default,,0,0,0,,Сіздің басыңыздың ішіндегі дауыс?
Dialogue: 0,0:01:50.64,0:01:53.58,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:01:53.58,0:01:57.31,Default,,0,0,0,,｟Адачи: 30 жасқа дейін пәк болып қалсаң, сиқыршы боласың➡
Dialogue: 0,0:01:57.31,0:01:59.31,Default,,0,0,0,,Түрткен кезде...｠
Dialogue: 0,0:01:59.31,0:02:01.98,Default,,0,0,0,,《Кеше! туған күн!
Dialogue: 0,0:02:01.98,0:02:04.29,Default,,0,0,0,,30 жаста!
Dialogue: 0,0:02:04.29,0:02:07.62,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:02:07.62,0:02:10.46,Default,,0,0,0,,Жүрегіндегі дауыс! ? 》
Dialogue: 0,0:02:10.46,0:02:13.80,Default,,0,0,0,,Мияу.
Dialogue: 0,0:02:13.80,0:02:16.13,Default,,0,0,0,,Мияу.
Dialogue: 0,0:02:16.13,0:02:18.17,Default,,0,0,0,,Уау.
Dialogue: 0,0:02:18.17,0:02:20.47,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:20.47,0:02:23.14,Default,,0,0,0,,Мм... анау мысық➡
Dialogue: 0,0:02:23.14,0:02:25.47,Default,,0,0,0,,Мен саған тиіссем жақсы ма?
Dialogue: 0,0:02:25.47,0:02:29.14,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:29.14,0:02:32.45,Default,,0,0,0,,Жоқ… ааа….
Dialogue: 0,0:02:36.82,0:02:39.19,Default,,0,0,0,,《Минато: Сені алып кетті.》
Dialogue: 0,0:02:41.32,0:02:44.49,Default,,0,0,0,,《Минато: Мен уайымдадым, себебі сен кенет жоғалып кеттің.
Dialogue: 0,0:02:44.49,0:02:50.37,Default,,0,0,0,,Өте жұмсақ. Сіз ғашықсыз.
Dialogue: 0,0:02:50.37,0:02:53.57,Default,,0,0,0,,Мен оны жай хикикомори деп ойладым, бірақ ол жақсы жігіт.
Dialogue: 0,0:02:56.81,0:02:59.31,Default,,0,0,0,,《Минато: Оның мейірімді адам сияқты көрінгеніне қуаныштымын》
Dialogue: 0,0:02:59.31,0:03:03.18,Default,,0,0,0,,Хехе. Ах...
Dialogue: 0,0:03:03.18,0:03:05.95,Default,,0,0,0,,Аа... Ааа.
Dialogue: 0,0:03:07.98,0:03:10.95,Default,,0,0,0,,Өте сүйкімді... (құлап жатқан дыбыс)
Dialogue: 0,0:03:10.95,0:03:14.16,Default,,0,0,0,,Не болды? Жоқ, шынымен емес...
Dialogue: 0,0:05:05.13,0:05:07.80,Default,,0,0,0,,А... неге?
Dialogue: 0,0:05:07.80,0:05:10.87,Default,,0,0,0,,Бірдеңені ойласам, әлгі жеткізушінің жүзі басыма шығып тұрады...
Dialogue: 0,0:05:10.87,0:05:12.81,Default,,0,0,0,,｟Хаха｠
Dialogue: 0,0:05:12.81,0:05:14.98,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:05:14.98,0:05:16.98,Default,,0,0,0,,Концентрат. Бүгін күн➡
Dialogue: 0,0:05:16.98,0:05:19.98,Default,,0,0,0,,Соңына дейін жаз! (Кіру қоңырауы)
Dialogue: 0,0:05:19.98,0:05:23.49,Default,,0,0,0,,Сәлем! (Кіру қоңырауы)
Dialogue: 0,0:05:25.62,0:05:28.02,Default,,0,0,0,,Штампты төсекке сулау.
Dialogue: 0,0:05:28.02,0:05:31.29,Default,,0,0,0,,Сәлеметсіз бе. Ах...
Dialogue: 0,0:05:31.29,0:05:33.50,Default,,0,0,0,,Аа….
Dialogue: 0,0:05:33.50,0:05:35.46,Default,,0,0,0,,《Минато: Бүгін➡
Dialogue: 0,0:05:35.46,0:05:38.40,Default,,0,0,0,,Сізде мысық жоқ па? 》
Dialogue: 0,0:05:38.40,0:05:40.97,Default,,0,0,0,,Қарсы болмасаңыз, Удонмен танысқыңыз келе ме?
Dialogue: 0,0:05:40.97,0:05:43.44,Default,,0,0,0,,Не? Жарайды ма? ?
Dialogue: 0,0:05:45.97,0:05:49.54,Default,,0,0,0,,Гах... Ой, мен жұмыстамын➡
Dialogue: 0,0:05:49.54,0:05:53.48,Default,,0,0,0,,Аз ғана. мияу.
Dialogue: 0,0:05:53.48,0:05:55.95,Default,,0,0,0,,Сіз тағы да үлкейдіңіз.
Dialogue: 0,0:05:55.95,0:06:00.16,Default,,0,0,0,,Мияу. Аты - удон.
Dialogue: 0,0:06:00.16,0:06:03.29,Default,,0,0,0,,Ах. Сіз оны алған кезде➡
Dialogue: 0,0:06:03.29,0:06:06.96,Default,,0,0,0,,Удон кеспесі салынған қорапта... (Минато) Бұл орынды ма?
Dialogue: 0,0:06:06.96,0:06:10.13,Default,,0,0,0,,Аа, кешіріңіз. Жоқ, жарайды.
Dialogue: 0,0:06:10.13,0:06:13.30,Default,,0,0,0,,Дұрыс, басында жай қалдыра алмадым➡
Dialogue: 0,0:06:13.30,0:06:16.47,Default,,0,0,0,,Әйтеуір көтеріп алдым, енді ➡
Dialogue: 0,0:06:16.47,0:06:19.81,Default,,0,0,0,,Менің ойымша, бұл сүйкімді. мияу.
Dialogue: 0,0:06:19.81,0:06:21.98,Default,,0,0,0,,《Минато: Басында мен не істеп жатқанымды білмедім➡
Dialogue: 0,0:06:21.98,0:06:25.48,Default,,0,0,0,,Мен оны күдікті адам деп ойладым, бірақ...》
Dialogue: 0,0:06:25.48,0:06:29.15,Default,,0,0,0,,Сіз оны тамақтандырасыз ба? Жұқа.
Dialogue: 0,0:06:29.15,0:06:31.65,Default,,0,0,0,,《Бұл жігіт жақсы иесі сияқты.
Dialogue: 0,0:06:31.65,0:06:34.66,Default,,0,0,0,,Жаңа қарап тұрған менен артық...》
Dialogue: 0,0:06:34.66,0:06:38.66,Default,,0,0,0,,Мияу. Күтіңіз, күтіңіз.
Dialogue: 0,0:06:38.66,0:06:40.73,Default,,0,0,0,,《Минато: Енді уайымдайтын ештеңе жоқ.》
Dialogue: 0,0:06:42.96,0:06:46.13,Default,,0,0,0,,Бұл... егер сізге жараса➡
Dialogue: 0,0:06:46.13,0:06:49.97,Default,,0,0,0,,Тағы келесің бе? иә?
Dialogue: 0,0:06:49.97,0:06:54.14,Default,,0,0,0,,Удон да сенімен кездескісі келетін сияқты.
Dialogue: 0,0:06:54.14,0:06:58.15,Default,,0,0,0,,Жеткізу үшін келуіңізге болады.
Dialogue: 0,0:06:58.15,0:07:00.65,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,0:07:03.32,0:07:05.32,Default,,0,0,0,,Амансың ба? мияу.
Dialogue: 0,0:07:05.32,0:07:08.99,Default,,0,0,0,,《Ей, бұл қорқынышты сиқыр ғой! 》
Dialogue: 0,0:07:11.16,0:07:13.16,Default,,0,0,0,,📱 (Хабарландыру дыбысы)
Dialogue: 0,0:07:17.97,0:07:20.77,Default,,0,0,0,,Не сұрайын дегенім... Бұл не екен деп ойлаймын.
Dialogue: 0,0:07:23.34,0:07:27.91,Default,,0,0,0,,О. Мен караокеде әріптес әйелге ғашық болдым...
Dialogue: 0,0:07:27.91,0:07:30.48,Default,,0,0,0,,Ах. Мен сізге көмектесуге тырыстым➡
Dialogue: 0,0:07:30.48,0:07:33.65,Default,,0,0,0,,Басқа адам шынымен жаман екен... Мм.
Dialogue: 0,0:07:33.65,0:07:36.52,Default,,0,0,0,,Мен ұтылып қалдым, бірақ мен әр түрлі нәрселерге дайындалдым➡
Dialogue: 0,0:07:36.52,0:07:40.59,Default,,0,0,0,,Маған Куросава көмектесті. Куросаваның орны жақсы➡
Dialogue: 0,0:07:40.59,0:07:42.56,Default,,0,0,0,,үшін алынды.
Dialogue: 0,0:07:44.49,0:07:47.83,Default,,0,0,0,,Бұл көңілді болатын сияқты. иә?
Dialogue: 0,0:07:47.83,0:07:50.33,Default,,0,0,0,,Әзірге компания туралы осындай әңгімелер ➡
Dialogue: 0,0:07:50.33,0:07:52.63,Default,,0,0,0,,Мен мұны ешқашан жасамас едім.
Dialogue: 0,0:07:52.63,0:07:56.81,Default,,0,0,0,,көремін. Сол жігіт Куросава деп атады➡
Dialogue: 0,0:07:56.81,0:07:59.21,Default,,0,0,0,,Бұл сіздің арқаңыз емес пе? иә?
Dialogue: 0,0:08:01.14,0:08:03.95,Default,,0,0,0,,《Әрине.
Dialogue: 0,0:08:03.95,0:08:08.82,Default,,0,0,0,,30 жасқа дейін күн сайын жұмыстан үйге қайта-қайта саяхаттаңыз.
Dialogue: 0,0:08:08.82,0:08:11.99,Default,,0,0,0,,Бір нәрсені қайталау...
Dialogue: 0,0:08:11.99,0:08:14.49,Default,,0,0,0,,Осылай, ауадай қалыңыз➡
Dialogue: 0,0:08:14.49,0:08:18.33,Default,,0,0,0,,Бірде-бір затсыз өтеді деп ойладым➡
Dialogue: 0,0:08:18.33,0:08:21.96,Default,,0,0,0,,Осы сиқырды қолдана білгеннен кейін➡
Dialogue: 0,0:08:21.96,0:08:24.13,Default,,0,0,0,,Күн сайын таңқаламын➡
Dialogue: 0,0:08:24.13,0:08:26.74,Default,,0,0,0,,Мен толқып, бос емеспін...》
Dialogue: 0,0:08:26.74,0:08:28.64,Default,,0,0,0,,｟Куросава: Адачи...｠
Dialogue: 0,0:08:28.64,0:08:33.14,Default,,0,0,0,,《Қатты! Мен Куросаваның жүзін байқамай тұра алмаймын...
Dialogue: 0,0:08:33.14,0:08:35.68,Default,,0,0,0,,Мен өзімді тұрақсыз сезінемін.
Dialogue: 0,0:08:35.68,0:08:38.48,Default,,0,0,0,,Ах. Дұрыс, сен➡
Dialogue: 0,0:08:38.48,0:08:40.48,Default,,0,0,0,,Сізге қажет нәрсе болмады ма?
Dialogue: 0,0:08:40.48,0:08:43.65,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:08:43.65,0:08:46.02,Default,,0,0,0,,Махо сіз өткен күні айттыңыз...
Dialogue: 0,0:08:46.02,0:08:48.49,Default,,0,0,0,,Тофу Чампуру Күткеніңізге рахмет.
Dialogue: 0,0:08:51.06,0:08:53.86,Default,,0,0,0,,А... о, жоқ, бұл….
Dialogue: 0,0:08:56.63,0:09:00.97,Default,,0,0,0,,《Уақыты келгенде кесіп тастау қиын.》
Dialogue: 0,0:09:00.97,0:09:04.14,Default,,0,0,0,,⚟Көп рахмет.
Dialogue: 0,0:09:04.14,0:09:08.31,Default,,0,0,0,,Біз осында болғандықтан, басқа мейрамханаға барайық.
Dialogue: 0,0:09:08.31,0:09:11.15,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:11.15,0:09:14.28,Default,,0,0,0,,Білесің бе, сен өткен күні айтқан сиқырды...
Dialogue: 0,0:09:14.28,0:09:19.82,Default,,0,0,0,,Иә? Жоқ, мен... 30-ға толдым...
Dialogue: 0,0:09:19.82,0:09:22.62,Default,,0,0,0,,⚟Күтіңіз!
Dialogue: 0,0:09:22.62,0:09:26.63,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:26.63,0:09:29.63,Default,,0,0,0,,Күте тұрыңыз, Юичи!
Dialogue: 0,0:09:29.63,0:09:32.30,Default,,0,0,0,,Уау, өте әдемі.
Dialogue: 0,0:09:32.30,0:09:35.64,Default,,0,0,0,,Бұл жақсы. Олар маған бір күн тұруға рұқсат берді.
Dialogue: 0,0:09:35.64,0:09:38.31,Default,,0,0,0,,Мен кенеттен қиындыққа тап болдым.
Dialogue: 0,0:09:38.31,0:09:41.21,Default,,0,0,0,,Ал сенің қазіргі жігітің не болды?
Dialogue: 0,0:09:41.21,0:09:43.28,Default,,0,0,0,,Ах! мен білмеймін.
Dialogue: 0,0:09:43.28,0:09:47.65,Default,,0,0,0,,Білмеймін... Әй, бір күн ғана!
Dialogue: 0,0:09:47.65,0:09:49.95,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:09:57.59,0:10:00.83,Default,,0,0,0,,Әй, не болды? Сіз тыңдайсыз ба?
Dialogue: 0,0:10:00.83,0:10:04.20,Default,,0,0,0,,Кешіріңіз. Мен бүгін үйге барамын.
Dialogue: 0,0:10:04.20,0:10:06.47,Default,,0,0,0,,Әй, эй, кенет не болды?
Dialogue: 0,0:10:14.84,0:10:17.01,Default,,0,0,0,,Енді Куросавамен➡
Dialogue: 0,0:10:17.01,0:10:19.71,Default,,0,0,0,,Бұрынғы қыз... солай ма?
Dialogue: 0,0:10:26.65,0:10:28.96,Default,,0,0,0,,《Ал, сенің бұрынғы қызың бар шығар》
Dialogue: 0,0:10:31.06,0:10:33.09,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:10:33.09,0:10:35.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:38.83,0:10:41.00,Default,,0,0,0,,《Бұл не...》
Dialogue: 0,0:10:51.85,0:10:54.85,Default,,0,0,0,,Аа... Жақсы жұмыс, Куросава.
Dialogue: 0,0:10:54.85,0:10:58.42,Default,,0,0,0,,Ах... Жақсы жұмыс. Сіз ұйықтап жатқан сияқтысыз.
Dialogue: 0,0:10:58.42,0:11:01.29,Default,,0,0,0,,Аа, кеше қаншама оқиға болды.
Dialogue: 0,0:11:01.29,0:11:05.66,Default,,0,0,0,,Әртүрлі заттар? Айтпақшы, Адачи ше?
Dialogue: 0,0:11:05.66,0:11:08.33,Default,,0,0,0,,Бүгін демалыс күні. иә?
Dialogue: 0,0:11:08.33,0:11:12.00,Default,,0,0,0,,Мен сізден Albireo компаниясы туралы бірдеңе сұрайын деп едім➡
Dialogue: 0,0:11:12.00,0:11:14.17,Default,,0,0,0,,Мен сізбен байланыса алмаймын.
Dialogue: 0,0:11:17.14,0:11:20.64,Default,,0,0,0,,Баға!
Dialogue: 0,0:11:20.64,0:11:23.14,Default,,0,0,0,,Менің ақымақ.
Dialogue: 0,0:11:23.14,0:11:25.45,Default,,0,0,0,,Жаңбырда дымқыл ұйықтау...
Dialogue: 0,0:11:27.85,0:11:29.82,Default,,0,0,0,,Ah~.
Dialogue: 0,0:11:31.82,0:11:34.32,Default,,0,0,0,,(асқазан дыбыстары)
Dialogue: 0,0:11:34.32,0:11:36.52,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:11:39.99,0:11:42.00,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:11:44.00,0:11:46.94,Default,,0,0,0,,Га.
Dialogue: 0,0:11:46.94,0:11:50.00,Default,,0,0,0,,Сіз бірге жақсы көріндіңіз.
Dialogue: 0,0:11:50.00,0:11:52.67,Default,,0,0,0,,Содан кейін түнде қалды ма деп ойлаймын.
Dialogue: 0,0:11:54.64,0:12:00.32,Default,,0,0,0,,《Бір немесе екі бұрынғы қыздың болуы табиғи нәрсе деп ойлаймын...》
Dialogue: 0,0:12:00.32,0:12:04.15,Default,,0,0,0,,Кеш болса да... Ах.
Dialogue: 0,0:12:04.15,0:12:08.49,Default,,0,0,0,,Мен неге сонша таң қалдым...
Dialogue: 0,0:12:08.49,0:12:13.16,Default,,0,0,0,,Мен білмеймін. Мен білмеймін, бірақ мен айналамын.
Dialogue: 0,0:12:13.16,0:12:16.63,Default,,0,0,0,,Мұның бәрі қызбаның кесірінен.
Dialogue: 0,0:12:16.63,0:12:18.63,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:12:20.84,0:12:24.21,Default,,0,0,0,,｟Иә? Сіздің ешқашан қызыңыз болған жоқ па?
Dialogue: 0,0:12:24.21,0:12:27.74,Default,,0,0,0,,Иә. Сіз қалай ойлайсыз? Студент болсаңыз да➡
Dialogue: 0,0:12:27.74,0:12:30.65,Default,,0,0,0,,Бұл жұмыс істейтін ересектер үшін дұрыс емес. иә?
Dialogue: 0,0:12:30.65,0:12:34.32,Default,,0,0,0,,Байыпты көрінген дұрыс. Шынайы!
Dialogue: 0,0:12:34.32,0:12:37.69,Default,,0,0,0,,《Аа... бұл арман》
Dialogue: 0,0:12:37.69,0:12:40.15,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:12:40.15,0:12:42.46,Default,,0,0,0,,Кешіріңіз, мен қоңырауды қабылдаймын.
Dialogue: 0,0:12:42.46,0:12:45.86,Default,,0,0,0,,《5 жыл бұрын ұнатқан қызбен➡
Dialogue: 0,0:12:45.86,0:12:48.96,Default,,0,0,0,,Мен бірінші рет әріптесіммен сусын ішуге шықтым...》
Dialogue: 0,0:12:48.96,0:12:51.30,Default,,0,0,0,,Эй, Адачи ше?
Dialogue: 0,0:12:51.30,0:12:54.14,Default,,0,0,0,,Оның қызбен болған тарихы жоқ.
Dialogue: 0,0:12:54.14,0:12:56.64,Default,,0,0,0,,Адачи-кун?
Dialogue: 0,0:12:56.64,0:13:00.24,Default,,0,0,0,,Хмм, бұл ауыр деп ойлаймын.
Dialogue: 0,0:13:00.24,0:13:03.14,Default,,0,0,0,,《Бастамастан бұрын біткен махаббат.
Dialogue: 0,0:13:03.14,0:13:07.25,Default,,0,0,0,,Бұл жарақат мені махаббатқа деген одан сайын қорқады.
Dialogue: 0,0:13:10.32,0:13:12.99,Default,,0,0,0,,Кешіріңіз. Дос ретінде.
Dialogue: 0,0:13:12.99,0:13:14.99,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:13:14.99,0:13:18.39,Default,,0,0,0,,Өйткені біз кездесе бастадық.
Dialogue: 0,0:13:18.39,0:13:21.63,Default,,0,0,0,,《Ах, менің бұрынғы махаббатымның жарақаты➡
Dialogue: 0,0:13:21.63,0:13:23.63,Default,,0,0,0,,Жанып тұрған шам сияқты...》｠
Dialogue: 0,0:13:23.63,0:13:26.13,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:13:26.13,0:13:30.47,Default,,0,0,0,,Уау! (Кіру қоңырауы)
Dialogue: 0,0:13:30.47,0:13:34.84,Default,,0,0,0,,Пинг теннисі өте қатты!
Dialogue: 0,0:13:34.84,0:13:38.38,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:13:38.38,0:13:41.15,Default,,0,0,0,,Осы сағатта сен кімсің...?
Dialogue: 0,0:13:41.15,0:13:44.15,Default,,0,0,0,,Үйге жеткізу?
Dialogue: 0,0:13:44.15,0:13:46.15,Default,,0,0,0,,Куросава?
Dialogue: 0,0:13:58.10,0:14:01.97,Default,,0,0,0,,Куросава? иә? Неліктен?
Dialogue: 0,0:14:01.97,0:14:06.27,Default,,0,0,0,,Мекенжай…. Әй, мен кенеттен кешірім сұраймын.
Dialogue: 0,0:14:06.27,0:14:09.68,Default,,0,0,0,,Мен сізге жұмыс жөнінде талай рет хабарластым➡
Dialogue: 0,0:14:09.68,0:14:11.95,Default,,0,0,0,,Мен уайымдадым, өйткені жауап болмады.
Dialogue: 0,0:14:13.95,0:14:17.95,Default,,0,0,0,,Бұл рас. Уау, маған қоңырау келді.
Dialogue: 0,0:14:17.95,0:14:21.36,Default,,0,0,0,,Нашар. Мен ұйықтап жатырмын, оны мүлдем байқамадым.
Dialogue: 0,0:14:21.36,0:14:24.26,Default,,0,0,0,,Амансың ба? Дәрі, тамақ және т.б.
Dialogue: 0,0:14:24.26,0:14:27.60,Default,,0,0,0,,Аа, бұл рас...
Dialogue: 0,0:14:27.60,0:14:31.47,Default,,0,0,0,,(асқазан дыбыстары)
Dialogue: 0,0:14:31.47,0:14:35.30,Default,,0,0,0,,Тамақ жасаймыз ба? иә? Жоқ, бұл жаман.
Dialogue: 0,0:14:35.30,0:14:37.71,Default,,0,0,0,,Ұялмаңыз.
Dialogue: 0,0:14:40.11,0:14:42.31,Default,,0,0,0,,Уау.
Dialogue: 0,0:14:42.31,0:14:44.48,Default,,0,0,0,,Итадакимасу.
Dialogue: 0,0:14:47.15,0:14:49.75,Default,,0,0,0,,Дәмді! жақсы.
Dialogue: 0,0:14:49.75,0:14:52.79,Default,,0,0,0,,Бұл керемет, Куросава.
Dialogue: 0,0:14:52.79,0:14:55.46,Default,,0,0,0,,Мен жейтін ештеңеміз жоқ деп ойладым.
Dialogue: 0,0:14:58.29,0:15:01.60,Default,,0,0,0,,Иә... Негізі бүгін сол күн➡
Dialogue: 0,0:15:01.60,0:15:04.43,Default,,0,0,0,,Мен ештеңе жеген жоқпын.
Dialogue: 0,0:15:04.43,0:15:08.47,Default,,0,0,0,,Өте қатты ауырады. Шынайы ма?
Dialogue: 0,0:15:08.47,0:15:11.77,Default,,0,0,0,,Сіз ауруханаға бардыңыз ба? Жоқ, мен күні бойы ұйықтадым.
Dialogue: 0,0:15:11.77,0:15:14.44,Default,,0,0,0,,Сонымен безгегі туралы не деуге болады? Кәне.
Dialogue: 0,0:15:14.44,0:15:17.78,Default,,0,0,0,,Мен олай ойламаймын. Ал...
Dialogue: 0,0:15:17.78,0:15:20.78,Default,,0,0,0,,Өйткені бізде термометр жоқ.
Dialogue: 0,0:15:23.85,0:15:25.89,Default,,0,0,0,,Уау.
Dialogue: 0,0:15:25.89,0:15:28.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.29,0:15:30.79,Default,,0,0,0,,Аа….
Dialogue: 0,0:15:30.79,0:15:33.76,Default,,0,0,0,,《Жақсы. Менде қызба жоқ.
Dialogue: 0,0:15:38.43,0:15:40.94,Default,,0,0,0,,Сіздің қызуыңыз жоқ екеніне сенімдімін.
Dialogue: 0,0:15:40.94,0:15:43.77,Default,,0,0,0,,Тек термометр сатып алыңыз.
Dialogue: 0,0:15:43.77,0:15:46.84,Default,,0,0,0,,Мен жалғыз тұрамын. Ой ой.
Dialogue: 0,0:15:46.84,0:15:48.88,Default,,0,0,0,,《Мен таң қалдым》
Dialogue: 0,0:15:48.88,0:15:51.31,Default,,0,0,0,,Керемет. Драманы қараңыз.
Dialogue: 0,0:15:51.31,0:15:53.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:58.79,0:16:00.96,Default,,0,0,0,,《Сен кімсің?》
Dialogue: 0,0:16:03.09,0:16:06.93,Default,,0,0,0,,《Менің бұрынғы сұлу қызым бар еді.
Dialogue: 0,0:16:06.93,0:16:10.13,Default,,0,0,0,,Ол әдемі және оны бәрі жақсы көреді...》
Dialogue: 0,0:16:10.13,0:16:12.80,Default,,0,0,0,,Мен дүкенге кейінірек барамын.
Dialogue: 0,0:16:12.80,0:16:15.14,Default,,0,0,0,,Қазір ғана құмар көздеріңмен мені шолып тұрдың ғой, иә?
Dialogue: 0,0:16:15.14,0:16:19.94,Default,,0,0,0,,《Бірақ сен маған неге сонша мейірімді боласың? 》
Dialogue: 0,0:16:19.94,0:16:22.44,Default,,0,0,0,,Мен шынымен де білмеймін.
Dialogue: 0,0:16:24.41,0:16:28.12,Default,,0,0,0,,Сподори мен желе Мен оларды тоңазытқышта сақтадым.
Dialogue: 0,0:16:28.12,0:16:30.95,Default,,0,0,0,,Соны ішіп, ерте жат.
Dialogue: 0,0:16:30.95,0:16:33.52,Default,,0,0,0,,О, рахмет.
Dialogue: 0,0:16:33.52,0:16:37.02,Default,,0,0,0,,Ертең ауруханаға барыңыз.
Dialogue: 0,0:16:37.02,0:16:39.46,Default,,0,0,0,,Сіз уайымдағаныңыз өкінішті.
Dialogue: 0,0:16:39.46,0:16:44.30,Default,,0,0,0,,Жарайды. Мен мұнда өз күшіммен келдім.
Dialogue: 0,0:16:44.30,0:16:46.93,Default,,0,0,0,,Хмм…. Хмм, Адачи?
Dialogue: 0,0:16:46.93,0:16:49.97,Default,,0,0,0,,Амансың ба? Сіз әлі де өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:16:49.97,0:16:52.11,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:52.11,0:16:54.48,Default,,0,0,0,,Бұл мен➡
Dialogue: 0,0:16:54.48,0:16:57.28,Default,,0,0,0,,Мен суық тиген кезде маған отбасымнан басқа біреу осылай жасады➡
Dialogue: 0,0:16:57.28,0:17:01.28,Default,,0,0,0,,Оның жоқтығына таң қалдыңыз ба?➡
Dialogue: 0,0:17:01.28,0:17:04.22,Default,,0,0,0,,Ол осындай нәрсені істемекші.
Dialogue: 0,0:17:04.22,0:17:06.45,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:17:06.45,0:17:10.12,Default,,0,0,0,,Міне.
Dialogue: 0,0:17:10.12,0:17:13.43,Default,,0,0,0,,《Жоқ, мен Темпера қажет емес деп айтуым мүмкін.
Dialogue: 0,0:17:13.43,0:17:15.63,Default,,0,0,0,,Мұндай нәрсе...》 Ештеңе жоқ.
Dialogue: 0,0:17:15.63,0:17:20.03,Default,,0,0,0,,О... Мен сенімен кездескеніме қуаныштымын.
Dialogue: 0,0:17:20.03,0:17:22.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.94,0:17:28.31,Default,,0,0,0,,Кездесуге бару немесе бірге тамақтану➡
Dialogue: 0,0:17:28.31,0:17:30.38,Default,,0,0,0,,Қол ұстасып...
Dialogue: 0,0:17:30.38,0:17:33.51,Default,,0,0,0,,Одан да көп➡
Dialogue: 0,0:17:33.51,0:17:35.68,Default,,0,0,0,,Бұл сіздің бірінші рет екеніңізді білдіре ме?
Dialogue: 0,0:17:38.12,0:17:40.62,Default,,0,0,0,,Сіз шынымен бақыттысыз деп ойлаймын.
Dialogue: 0,0:17:40.62,0:17:44.13,Default,,0,0,0,,《Егер бұл мен болсам, мен бақытты болар едім》
Dialogue: 0,0:17:46.09,0:17:48.16,Default,,0,0,0,,Әрине.
Dialogue: 0,0:17:48.16,0:17:51.47,Default,,0,0,0,,《Адачи бірінші рет мен туралы болды➡
Dialogue: 0,0:17:51.47,0:17:55.64,Default,,0,0,0,,Мүлдем...Мен бәрін қатты бағалаймын》
Dialogue: 0,0:18:05.61,0:18:08.98,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:08.98,0:18:12.12,Default,,0,0,0,,Уау, Адачи, сенің жүзің ашық қызыл!
Dialogue: 0,0:18:12.12,0:18:15.29,Default,,0,0,0,,Менің әлі қызуым бар... Қазір ауруханаға барамыз ба?
Dialogue: 0,0:18:15.29,0:18:17.63,Default,,0,0,0,,Tch, жоқ...
Dialogue: 0,0:18:17.63,0:18:19.63,Default,,0,0,0,,Қарама.
Dialogue: 0,0:18:19.63,0:18:22.43,Default,,0,0,0,,《Мен бұрын-соңды махаббатты бастан өткерген емеспін➡
Dialogue: 0,0:18:22.43,0:18:24.53,Default,,0,0,0,,Кешенде...》
Dialogue: 0,0:18:24.53,0:18:26.87,Default,,0,0,0,,｜Артқы зарядтың жарылуы｠
Dialogue: 0,0:18:26.87,0:18:29.10,Default,,0,0,0,,《Барған сайын қорқақ болып барады➡
Dialogue: 0,0:18:29.10,0:18:32.11,Default,,0,0,0,,30-ға келдім.
Dialogue: 0,0:18:32.11,0:18:34.71,Default,,0,0,0,,Бірақ...》
Dialogue: 0,0:18:34.71,0:18:38.78,Default,,0,0,0,,｟《Егер бұл мен болсам, мен бақытты болар едім》｠
Dialogue: 0,0:18:38.78,0:18:40.98,Default,,0,0,0,,《Олай десеңіз...》
Dialogue: 0,0:18:49.96,0:18:51.93,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:55.96,0:18:59.97,Default,,0,0,0,,《Бәрі бірінші рет➡
Dialogue: 0,0:18:59.97,0:19:02.64,Default,,0,0,0,,Бұл жігіт сияқты жақсы болуы мүмкін➡
Dialogue: 0,0:19:02.64,0:19:06.41,Default,,0,0,0,,Мен солай ойлаймын》
Dialogue: 0,0:19:10.78,0:19:13.28,Default,,0,0,0,,《Неге мен Куросаваны оның бұрынғы қызымен көрдім➡
Dialogue: 0,0:19:13.28,0:19:15.65,Default,,0,0,0,,Сіз ренжідіңіз бе?➡
Dialogue: 0,0:19:15.65,0:19:17.72,Default,,0,0,0,,Ақырында...》
Dialogue: 0,0:19:17.72,0:19:20.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:20.45,0:19:23.12,Default,,0,0,0,,《Мен... Куросава туралы...》
Dialogue: 0,0:19:23.12,0:19:26.59,Default,,0,0,0,,Ах... Куросава: Мен...
Dialogue: 0,0:19:28.63,0:19:32.00,Default,,0,0,0,,⚟Сіз осында болдыңыз!
Dialogue: 0,0:19:32.00,0:19:36.27,Default,,0,0,0,,Мен оны таптым, Юичи!
Dialogue: 0,0:19:36.27,0:19:38.77,Default,,0,0,0,,Неліктен кенеттен...?
Dialogue: 0,0:19:38.77,0:19:42.44,Default,,0,0,0,,《Мүмкін бұл бейберекеттіктің көрінісі шығар! ? 》
Dialogue: 0,0:19:42.44,0:19:45.45,Default,,0,0,0,,Сіз бір күн ғана боламын деп уәде бергенсіз, солай ма?
Dialogue: 0,0:19:45.45,0:19:49.42,Default,,0,0,0,,Біздің таңдауымыз жоқ. Өйткені ол еңкеймейді.
Dialogue: 0,0:19:49.42,0:19:53.79,Default,,0,0,0,,Аа... Ол үшін уайымдамаңыз, әпке.
Dialogue: 0,0:19:53.79,0:19:56.46,Default,,0,0,0,,《Не, әпке? 》 Шамамен➡
Dialogue: 0,0:19:56.46,0:20:00.93,Default,,0,0,0,,Бұл жер неге...? G.P.S!
Dialogue: 0,0:20:00.93,0:20:04.60,Default,,0,0,0,,А... Мен білмей тұрып! Бұл сенің кінәң.
Dialogue: 0,0:20:04.60,0:20:06.77,Default,,0,0,0,,Өйткені сен менен қашуға тырыстың. Сондықтан➡
Dialogue: 0,0:20:06.77,0:20:11.11,Default,,0,0,0,,Біреудің смартфонына рұқсатсыз қол жеткізіңіз! Негізінде, неге пароль?
Dialogue: 0,0:20:11.11,0:20:14.18,Default,,0,0,0,,Мен саған қамқор боламын!
Dialogue: 0,0:20:14.18,0:20:16.28,Default,,0,0,0,,《Егер мұқият қарасаңыз➡
Dialogue: 0,0:20:16.28,0:20:18.95,Default,,0,0,0,,Олар өте ұқсас.
Dialogue: 0,0:20:18.95,0:20:20.95,Default,,0,0,0,,Бұл сіздің бұрынғы қызыңыз емес пе еді?
Dialogue: 0,0:20:20.95,0:20:23.32,Default,,0,0,0,,Мен жеңілдеп қалдым... Иә?
Dialogue: 0,0:20:23.32,0:20:25.32,Default,,0,0,0,,Рельеф...》
Dialogue: 0,0:20:25.32,0:20:29.36,Default,,0,0,0,,Сіз сондасыз ба? иә. Сіз... Юичидің досысыз ба?
Dialogue: 0,0:20:29.36,0:20:31.86,Default,,0,0,0,,Эй...Адачиді бұған араластырма.
Dialogue: 0,0:20:31.86,0:20:34.93,Default,,0,0,0,,Ол жұмыстағы әріптес. Сәлем Адачи-кун.
Dialogue: 0,0:20:34.93,0:20:39.10,Default,,0,0,0,,Ах. Сен Юичимен өте жақсы доссың.
Dialogue: 0,0:20:39.10,0:20:41.30,Default,,0,0,0,,《Керемет күшті》
Dialogue: 0,0:20:41.30,0:20:43.94,Default,,0,0,0,,Біз жақсы доспыз➡
Dialogue: 0,0:20:43.94,0:20:46.44,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:20:46.44,0:20:48.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:48.44,0:20:51.11,Default,,0,0,0,,Ах! Ол кешірім сұрағанша➡
Dialogue: 0,0:20:51.11,0:20:54.28,Default,,0,0,0,,Маған Юичидің бөлмесін қарызға бер. Ха! ?
Dialogue: 0,0:20:54.28,0:20:56.45,Default,,0,0,0,,Жоқ... сонша сөйлеп тұрсың ба?
Dialogue: 0,0:20:56.45,0:20:58.95,Default,,0,0,0,,Менің де жұмысым бар...
Dialogue: 0,0:20:58.95,0:21:01.46,Default,,0,0,0,,Хехе. Ах. Менің осындай жақсы достарым бар➡
Dialogue: 0,0:21:01.46,0:21:04.13,Default,,0,0,0,,Егер сіз сонда болсаңыз, маған біраз тұруға рұқсат ете аласыз ба?
Dialogue: 0,0:21:04.13,0:21:06.79,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:21:06.79,0:21:09.30,Default,,0,0,0,,Біреу ауырып жатқанда кенеттен қалай түсіп қалады➡
Dialogue: 0,0:21:09.30,0:21:11.47,Default,,0,0,0,,Қалай қарасаң да, ақылсыз ғой, солай ма?
Dialogue: 0,0:21:11.47,0:21:13.93,Default,,0,0,0,,Сен оған қамқор болуың керек.
Dialogue: 0,0:21:13.93,0:21:17.81,Default,,0,0,0,,Не? Бөлмені досыңызбен бөлісіңіз.
Dialogue: 0,0:21:17.81,0:21:21.34,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:21:21.34,0:21:23.38,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:23.38,0:21:40.63,Default,,0,0,0,,♬～
Dialogue: 0,0:21:40.63,0:21:43.43,Default,,0,0,0,,Бұл әрине қызық.
Dialogue: 0,0:21:43.43,0:21:45.43,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:45.43,0:21:47.47,Default,,0,0,0,,Олай болса, болды.
Dialogue: 0,0:21:47.47,0:21:51.64,Default,,0,0,0,,Адачи-кун, менің ініме қамқор болшы.
Dialogue: 0,0:21:51.64,0:21:55.21,Default,,0,0,0,,Иә! ? Аа, аа….
Dialogue: 0,0:22:00.61,0:22:02.62,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:22:02.62,0:22:05.09,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:22:06.59,0:22:12.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
