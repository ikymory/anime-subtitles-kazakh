Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.22,0:00:17.30,Default,,0,0,0,,Мохи
Dialogue: 0,0:00:18.93,0:00:20.06,Default,,0,0,0,,Ангус
Dialogue: 0,0:00:22.14,0:00:23.31,Default,,0,0,0,,Шен
Dialogue: 0,0:00:25.44,0:00:26.77,Default,,0,0,0,,Ешуа
Dialogue: 0,0:00:27.56,0:00:32.40,Default,,0,0,0,,Қарғыс атсын! Ол түсіп жатыр!
Dialogue: 0,0:00:34.41,0:00:36.45,Default,,0,0,0,,Ештеңе қалмады...
Dialogue: 0,0:00:41.87,0:00:43.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:00:44.46,0:00:45.83,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:00:46.46,0:00:49.42,Default,,0,0,0,,Бұл Люси-кунның дауысы ма?
Dialogue: 0,0:00:49.50,0:00:52.38,Default,,0,0,0,,Ааа... аааа!
Dialogue: 0,0:00:52.46,0:00:54.09,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:00:57.26,0:01:00.39,Default,,0,0,0,,О, мынау... мынау!
Dialogue: 0,0:01:02.27,0:01:04.56,Default,,0,0,0,,Трансформация... Трансформация!
Dialogue: 0,0:01:05.23,0:01:07.40,Default,,0,0,0,,Немесе… Ол өзгеруде.
Dialogue: 0,0:01:08.23,0:01:09.77,Default,,0,0,0,,Люс Ренрен
Dialogue: 0,0:01:12.07,0:01:13.99,Default,,0,0,0,,Қараңғы Шнайдерге!
Dialogue: 0,0:01:19.83,0:01:21.83,Default,,0,0,0,,♪～
Dialogue: 0,0:02:44.99,0:02:47.00,Default,,0,0,0,,～♪
Dialogue: 0,0:02:50.50,0:02:54.09,Default,,0,0,0,,Шулы!
Dialogue: 0,0:02:55.09,0:02:56.92,Default,,0,0,0,,Ах! (Ларс) Агия!
Dialogue: 0,0:02:57.01,0:02:58.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:58.22,0:02:59.59,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:02:59.68,0:03:00.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:05.01,0:03:06.72,Default,,0,0,0,,Аа...
Dialogue: 0,0:03:06.81,0:03:09.98,Default,,0,0,0,,Шудың болғаны сонша, ұйықтай алмаймын.
Dialogue: 0,0:03:10.52,0:03:15.44,Default,,0,0,0,,О, мына төменгі жануарлар!
Dialogue: 0,0:03:15.52,0:03:17.36,Default,,0,0,0,,О... ой!
Dialogue: 0,0:03:20.36,0:03:23.99,Default,,0,0,0,,Өлме!
Dialogue: 0,0:03:27.24,0:03:28.37,Default,,0,0,0,,(үру)
Dialogue: 0,0:03:29.04,0:03:32.58,Default,,0,0,0,,Напалм өлімі!
Dialogue: 0,0:03:38.09,0:03:39.92,Default,,0,0,0,,Nu! Не!
Dialogue: 0,0:03:41.97,0:03:43.18,Default,,0,0,0,,Ах
Dialogue: 0,0:03:47.06,0:03:50.27,Default,,0,0,0,,Ал егер... олар жойылса...?
Dialogue: 0,0:03:50.35,0:03:53.15,Default,,0,0,0,,Күшті кедергісі бар сфинкстер тобы.
Dialogue: 0,0:03:53.23,0:03:55.98,Default,,0,0,0,,Бір соққымен жанып кететін сиқырлы күш!
Dialogue: 0,0:03:56.06,0:03:58.11,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:03:58.73,0:04:02.61,Default,,0,0,0,,Бұл дүниеде мұндай күшке ие бір ғана адам бар!
Dialogue: 0,0:04:03.16,0:04:06.58,Default,,0,0,0,,А... Бұл керемет пе?
Dialogue: 0,0:04:07.66,0:04:11.00,Default,,0,0,0,,Жоқ... мүмкін емес...
Dialogue: 0,0:04:12.37,0:04:14.75,Default,,0,0,0,,Бұл... бұл сиқыр
Dialogue: 0,0:04:15.79,0:04:17.25,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:04:24.38,0:04:25.55,Default,,0,0,0,,Руше
Dialogue: 0,0:04:31.10,0:04:33.23,Default,,0,0,0,,Ежелгі Ұлы Сиқыршы
Dialogue: 0,0:04:33.77,0:04:38.19,Default,,0,0,0,,Қараңғылықтың шегінде орналасқан, өлім мен жойылуды басқарады.
Dialogue: 0,0:04:38.27,0:04:40.44,Default,,0,0,0,,Оның сиқырлы күші шексіз!
Dialogue: 0,0:04:40.53,0:04:41.90,Default,,0,0,0,,Аягья!
Dialogue: 0,0:04:41.99,0:04:45.07,Default,,0,0,0,,Мен сенің міндетті түрде қайтып келетініңді білдім!
Dialogue: 0,0:04:45.16,0:04:48.49,Default,,0,0,0,,Сәл үлкейдіңіз ғой, солай ма?
Dialogue: 0,0:04:48.58,0:04:51.20,Default,,0,0,0,,О, қателесуге болмайды.
Dialogue: 0,0:04:51.29,0:04:54.96,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:04:55.62,0:04:56.96,Default,,0,0,0,,Керемет сұлулық
Dialogue: 0,0:04:57.04,0:04:59.42,Default,,0,0,0,,Ультра алтын керемет галактика
Dialogue: 0,0:04:59.50,0:05:02.84,Default,,0,0,0,,Керемет Браво Өте Қауіпті Әдемі
Dialogue: 0,0:05:02.92,0:05:05.55,Default,,0,0,0,,Deluxe Дирк Шнайдер
Dialogue: 0,0:05:05.63,0:05:07.55,Default,,0,0,0,,Жаңғыру!
Dialogue: 0,0:05:07.64,0:05:12.18,Default,,0,0,0,,Мен сені жақсы көремін, Йоко!
Dialogue: 0,0:05:14.73,0:05:19.11,Default,,0,0,0,,Ха ха тата тата… Уақытында!
Dialogue: 0,0:05:19.73,0:05:21.44,Default,,0,0,0,,Мен А-Иан-Мейде патшасымын.
Dialogue: 0,0:05:21.53,0:05:23.19,Default,,0,0,0,,Мен сізге бірден бұйрық беремін.
Dialogue: 0,0:05:23.28,0:05:26.82,Default,,0,0,0,,Дирк Шнайдер Мені қорға, мені қорға, мені қорға!
Dialogue: 0,0:05:26.91,0:05:28.74,Default,,0,0,0,,Ой, сұмдық!
Dialogue: 0,0:05:28.82,0:05:31.62,Default,,0,0,0,,Огееееее!
Dialogue: 0,0:05:32.41,0:05:34.45,Default,,0,0,0,,Маған бұйрық берме.
Dialogue: 0,0:05:34.54,0:05:37.00,Default,,0,0,0,,Мен дүниенің билеушісімін
Dialogue: 0,0:05:37.08,0:05:39.67,Default,,0,0,0,,Бұл дүниеде бәрі маған тиесілі
Dialogue: 0,0:05:39.75,0:05:46.09,Default,,0,0,0,,Бұл дүниеде өмір сүретіндердің бәрі менің құлым! Хаха~
Dialogue: 0,0:05:47.84,0:05:51.05,Default,,0,0,0,,Маған қарсы шыққандар аямайды
Dialogue: 0,0:05:51.64,0:05:54.02,Default,,0,0,0,,Бұл... бұрмалаудың бұл жолы.
Dialogue: 0,0:05:54.10,0:05:56.64,Default,,0,0,0,,Ештеңе өзгерген жоқ.
Dialogue: 0,0:05:56.73,0:05:59.98,Default,,0,0,0,,О... бара бер...
Dialogue: 0,0:06:00.06,0:06:01.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.15,0:06:05.57,Default,,0,0,0,,Немесе... қабырға!
Dialogue: 0,0:06:05.65,0:06:09.53,Default,,0,0,0,,Сыртқы қорғанысты бұзып өттіңіз бе?
Dialogue: 0,0:06:09.61,0:06:13.49,Default,,0,0,0,,Хахахаха мен осы сәтті күттім!
Dialogue: 0,0:06:14.49,0:06:15.91,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:06:16.00,0:06:19.75,Default,,0,0,0,,Демон Шогун Макапиннің Demon Slash жібін қабылдаңыз!
Dialogue: 0,0:06:19.83,0:06:25.13,Default,,0,0,0,,Гехахаха, бұл басты маған Бассоли берді!
Dialogue: 0,0:06:25.21,0:06:27.88,Default,,0,0,0,,Мен оны алдым! Бұл уақыт болса
Dialogue: 0,0:06:27.97,0:06:30.14,Default,,0,0,0,,Жын болса да, қашып кетпеймін.
Dialogue: 0,0:06:30.72,0:06:33.72,Default,,0,0,0,,Өл! Йозан 100 миллион жарықшақты жіп!
Dialogue: 0,0:06:33.81,0:06:38.19,Default,,0,0,0,,Сәлеметсіз бе! Бұзылған қол қатесі!
Dialogue: 0,0:06:44.07,0:06:45.40,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:06:48.11,0:06:51.32,Default,,0,0,0,,Ал... Мен екі жын генералдың шабуылына тосқауыл қойып жатқаныма сене алар емеспін!
Dialogue: 0,0:06:51.41,0:06:52.74,Default,,0,0,0,,Жын жібі...
Dialogue: 0,0:06:52.82,0:06:55.33,Default,,0,0,0,,Қандай күшті сиқырлы қалқан!
Dialogue: 0,0:06:56.95,0:07:00.96,Default,,0,0,0,,Сіз Калдың шәкіртісіз, бірақ білмейсіз бе?
Dialogue: 0,0:07:01.50,0:07:06.05,Default,,0,0,0,,Кукукуку, мен қатыгезмін.
Dialogue: 0,0:07:07.05,0:07:09.80,Default,,0,0,0,,Ешкі Сай Клуза…
Dialogue: 0,0:07:09.88,0:07:11.26,Default,,0,0,0,,Ба... сен ақымақ.
Dialogue: 0,0:07:11.34,0:07:13.22,Default,,0,0,0,,Олқылықтар өте көп!
Dialogue: 0,0:07:13.30,0:07:15.18,Default,,0,0,0,,Урааааааа!
Dialogue: 0,0:07:15.85,0:07:18.18,Default,,0,0,0,,Жарылыс ағыны, дауылға айналу
Dialogue: 0,0:07:18.27,0:07:21.14,Default,,0,0,0,,Соғыс императорының қаһары (Вау Вау)!
Dialogue: 0,0:07:21.94,0:07:24.82,Default,,0,0,0,,Угеееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:07:24.90,0:07:26.78,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:07:27.86,0:07:29.74,Default,,0,0,0,,Қандай сиқырлы күш
Dialogue: 0,0:07:30.65,0:07:33.20,Default,,0,0,0,,17 жыл бұрын кездескен кезбен салыстырғанда
Dialogue: 0,0:07:33.28,0:07:35.74,Default,,0,0,0,,Күш өсуде
Dialogue: 0,0:07:38.66,0:07:41.83,Default,,0,0,0,,Сіз куккуккукке қарсы тұрдыңыз ба?
Dialogue: 0,0:07:41.92,0:07:44.79,Default,,0,0,0,,Бұл аздап қызық болған сияқты.
Dialogue: 0,0:07:44.88,0:07:49.59,Default,,0,0,0,,Ва~хахаха, міне, кішкентай шабақтар! Ойнайық!
Dialogue: 0,0:07:49.67,0:07:52.72,Default,,0,0,0,,Ууууууу, сен!
Dialogue: 0,0:07:52.80,0:07:55.18,Default,,0,0,0,,Мен сені талқандаймын!
Dialogue: 0,0:07:55.26,0:07:58.64,Default,,0,0,0,,Бұл күшті итергіш құрт!
Dialogue: 0,0:07:58.72,0:07:59.60,Default,,0,0,0,,Ах
Dialogue: 0,0:08:00.43,0:08:02.60,Default,,0,0,0,,Мен саған айтамын, мен күштімін.
Dialogue: 0,0:08:03.15,0:08:05.02,Default,,0,0,0,,Мылтық!
Dialogue: 0,0:08:05.11,0:08:08.48,Default,,0,0,0,,Губуууу! (Азаматтар) Әй, солай істедік!
Dialogue: 0,0:08:08.57,0:08:10.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:11.03,0:08:12.15,Default,,0,0,0,,Ба Кешіріңіз!
Dialogue: 0,0:08:12.24,0:08:15.82,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу қайтадан тағы да
Dialogue: 0,0:08:15.91,0:08:19.04,Default,,0,0,0,,Нууууууу!
Dialogue: 0,0:08:20.20,0:08:21.62,Default,,0,0,0,,Бааааа!
Dialogue: 0,0:08:21.71,0:08:22.71,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:08:22.79,0:08:24.67,Default,,0,0,0,,Мм... бұрылды!
Dialogue: 0,0:08:27.21,0:08:29.09,Default,,0,0,0,,Роророро...
Dialogue: 0,0:08:30.26,0:08:35.05,Default,,0,0,0,,Оның үстіне менің сұлу екенімді айтпаса да түсінікті.
Dialogue: 0,0:08:35.72,0:08:37.51,Default,,0,0,0,,Ата…
Dialogue: 0,0:08:38.05,0:08:41.77,Default,,0,0,0,,Бұл аңызға айналған жын Дирк Шнайдер
Dialogue: 0,0:08:41.85,0:08:43.23,Default,,0,0,0,,(Вайдың ауыр тыныс алуы)
Dialogue: 0,0:08:43.31,0:08:45.31,Default,,0,0,0,,А, анау адам...
Dialogue: 0,0:08:45.94,0:08:48.36,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:08:51.11,0:08:52.78,Default,,0,0,0,,Люс...
Dialogue: 0,0:08:52.86,0:08:54.24,Default,,0,0,0,,Мм!
Dialogue: 0,0:08:55.03,0:08:56.70,Default,,0,0,0,,Ой, күткендей.
Dialogue: 0,0:08:56.78,0:08:59.62,Default,,0,0,0,,Бірақ сен сиқыршы болғандықтан,
Dialogue: 0,0:08:59.70,0:09:02.79,Default,,0,0,0,,Сіз бұл «Күнәкардың қылышынан (Гариялық қылыш)» құтыла алмайсыз!
Dialogue: 0,0:09:02.87,0:09:04.71,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:09:05.25,0:09:08.04,Default,,0,0,0,,Бұл барлық сиқырлы қорғанысты таратады⸺
Dialogue: 0,0:09:08.13,0:09:10.67,Default,,0,0,0,,Бұл сиқырға қарсы күреске арналған қылыш!
Dialogue: 0,0:09:10.75,0:09:13.09,Default,,0,0,0,,Ха~хахаха
Dialogue: 0,0:09:13.17,0:09:16.30,Default,,0,0,0,,Сиқыршылар және сол сияқтылар кедергісіз жалаңаш сияқты жақсы!
Dialogue: 0,0:09:16.38,0:09:17.47,Default,,0,0,0,,Мен күлгенімді тыя алмаймын
Dialogue: 0,0:09:17.55,0:09:21.10,Default,,0,0,0,,Га~хаха мен сондай бірдеңені жеймін, кішкентай шабақ.
Dialogue: 0,0:09:21.18,0:09:23.14,Default,,0,0,0,,Егер қолыңыздан келсе, жасап көріңіз.
Dialogue: 0,0:09:23.73,0:09:27.02,Default,,0,0,0,,Абайлаңыз! Макапин лас қолды пайдаланады!
Dialogue: 0,0:09:27.10,0:09:28.56,Default,,0,0,0,,Үніңді жап, маймыл!
Dialogue: 0,0:09:28.65,0:09:31.78,Default,,0,0,0,,Сондықтан самурайлар жын генералдарынан төмен!
Dialogue: 0,0:09:31.86,0:09:35.99,Default,,0,0,0,,Сіз қандай құралды пайдалансаңыз да, сіз жеңсеңіз, бәрі жақсы!
Dialogue: 0,0:09:36.07,0:09:38.62,Default,,0,0,0,,Жеңіске жетпесең, төбелесудің қажеті жоқ!
Dialogue: 0,0:09:38.70,0:09:43.20,Default,,0,0,0,,Ақыл мен сезімге мүлде әсер етпейтін адалдық пен адамгершілік, күш!
Dialogue: 0,0:09:43.29,0:09:45.08,Default,,0,0,0,,Ах! (Йоко) Апай!
Dialogue: 0,0:09:45.16,0:09:47.92,Default,,0,0,0,,Бұл таза күш!
Dialogue: 0,0:09:48.00,0:09:50.42,Default,,0,0,0,,Мен қазір дәлелдеймін.
Dialogue: 0,0:09:50.50,0:09:52.34,Default,,0,0,0,,Оны тікелей тиіп, жарып жіберген сол сым емес еді
Dialogue: 0,0:09:52.42,0:09:56.13,Default,,0,0,0,,Кәне, Дарк Шнайдер, сүйікті заклинанияңызды қолданыңыз!
Dialogue: 0,0:09:56.22,0:09:59.39,Default,,0,0,0,,Жылан шаққан Хоррицудың құпия техникасы!
Dialogue: 0,0:10:00.43,0:10:01.30,Default,,0,0,0,,Ах
Dialogue: 0,0:10:02.01,0:10:03.18,Default,,0,0,0,,Люс!
Dialogue: 0,0:10:04.18,0:10:07.39,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:08.56,0:10:09.94,Default,,0,0,0,,Гах...
Dialogue: 0,0:10:10.02,0:10:14.23,Default,,0,0,0,,Ауырды... аа... аа... уф
Dialogue: 0,0:10:15.44,0:10:16.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.86,0:10:18.24,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:18.32,0:10:20.87,Default,,0,0,0,,H... адамдарды қалқан ретінде пайдалану...
Dialogue: 0,0:10:23.33,0:10:26.04,Default,,0,0,0,,Қатал және өте күшті...
Dialogue: 0,0:10:26.12,0:10:27.62,Default,,0,0,0,,Біз финалға өте алмадық—
Dialogue: 0,0:10:27.71,0:10:30.92,Default,,0,0,0,,Әйелдің жамбасын сулайтындай әдемі
Dialogue: 0,0:10:31.00,0:10:32.21,Default,,0,0,0,,Және…
Dialogue: 0,0:10:32.29,0:10:34.59,Default,,0,0,0,,Жау болса да, Қалқан боп пайдаландым.
Dialogue: 0,0:10:35.09,0:10:36.92,Default,,0,0,0,,Ки... кір
Dialogue: 0,0:10:37.01,0:10:42.55,Default,,0,0,0,,Фухахаха ақымақ! Мен мұны жексұрын деп айтпас едім, бұл одан да абыройлы.
Dialogue: 0,0:10:42.64,0:10:44.26,Default,,0,0,0,,Бұл маймылдың баласы
Dialogue: 0,0:10:44.35,0:10:45.60,Default,,0,0,0,,Бала маймыл…
Dialogue: 0,0:10:46.81,0:10:48.98,Default,,0,0,0,,Өте күшті және өте әдемі
Dialogue: 0,0:10:49.06,0:10:51.23,Default,,0,0,0,,Одан да қатыгез және қатыгез
Dialogue: 0,0:10:51.31,0:10:54.98,Default,,0,0,0,,Бұл менмін, Дирк Шнайдер!
Dialogue: 0,0:10:55.07,0:10:57.19,Default,,0,0,0,,Dowahahahaha
Dialogue: 0,0:10:57.28,0:10:59.90,Default,,0,0,0,,Оны айтудың басқа жолы бар ма?
Dialogue: 0,0:11:05.95,0:11:09.21,Default,,0,0,0,,Сіз әлі де ұрысуды жоспарлап жүрсіз бе?
Dialogue: 0,0:11:09.29,0:11:10.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:12.08,0:11:15.30,Default,,0,0,0,,Өтінемін, бұл макапейн Тони Штраус.
Dialogue: 0,0:11:16.09,0:11:18.72,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:11:19.88,0:11:23.09,Default,,0,0,0,,Ерікті болып, сәтсіздікке ұшырау – шектен шығу!
Dialogue: 0,0:11:23.18,0:11:26.51,Default,,0,0,0,,Егер бұл орын алса, лорд Калдан алған сенімім жерге түседі.
Dialogue: 0,0:11:26.60,0:11:28.48,Default,,0,0,0,,Жазалау сөзсіз болады
Dialogue: 0,0:11:28.56,0:11:33.31,Default,,0,0,0,,Мен Калға сендім және өзім жын болуды шештім.
Dialogue: 0,0:11:33.40,0:11:37.03,Default,,0,0,0,,Көтерілісшілер үрей билейді.
Dialogue: 0,0:11:37.11,0:11:40.24,Default,,0,0,0,,Мейірімсіз шайтан деп сынаса да
Dialogue: 0,0:11:40.32,0:11:44.24,Default,,0,0,0,,Барлығы Каль-саманың мұраттарын жүзеге асыру үшін!
Dialogue: 0,0:11:44.32,0:11:46.45,Default,,0,0,0,,Не болды? Кәне.
Dialogue: 0,0:11:46.53,0:11:50.46,Default,,0,0,0,,Жеңіске жетпесең, төбелесудің қажеті жоқ, солай ма? Эй
Dialogue: 0,0:11:50.54,0:11:51.41,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:51.50,0:11:54.38,Default,,0,0,0,,Бұл ақымақтар
Dialogue: 0,0:11:54.46,0:11:57.05,Default,,0,0,0,,Сондай екінші дәрежелі сұлулық
Dialogue: 0,0:11:57.13,0:11:59.96,Default,,0,0,0,,Бұл өте әдемі Дирк Шнайдерге.
Dialogue: 0,0:12:00.05,0:12:03.09,Default,,0,0,0,,Сіз шынымен тісіңізді шыдай аламын деп ойлайсыз ба?
Dialogue: 0,0:12:03.18,0:12:04.14,Default,,0,0,0,,Уф
Dialogue: 0,0:12:04.22,0:12:08.56,Default,,0,0,0,,Сен менің жауым емессің!
Dialogue: 0,0:12:09.35,0:12:11.48,Default,,0,0,0,,Үлкен күш үшбұрышы
Dialogue: 0,0:12:11.56,0:12:13.85,Default,,0,0,0,,Гексаграмдық пентаграмма Жарық пен қараңғылық
Dialogue: 0,0:12:13.94,0:12:18.44,Default,,0,0,0,,Айдаһар патшаның дискі мен батырлық рухын толтырған айға айтамын.
Dialogue: 0,0:12:18.53,0:12:21.86,Default,,0,0,0,,Аспан принципі, жер принципі, адам принципі ...
Dialogue: 0,0:12:21.95,0:12:23.41,Default,,0,0,0,,Ахх!
Dialogue: 0,0:12:23.49,0:12:26.49,Default,,0,0,0,,ДиМаджио шыңы бар қуат конусы
Dialogue: 0,0:12:26.57,0:12:30.87,Default,,0,0,0,,Қасиетті жалыным, Үш басты алтын айдаһардың құдіреті
Dialogue: 0,0:12:30.95,0:12:33.00,Default,,0,0,0,,Беру
Dialogue: 0,0:12:36.88,0:12:38.75,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:42.30,0:12:43.43,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:12:43.51,0:12:45.68,Default,,0,0,0,,Бұл додо додо...
Dialogue: 0,0:12:46.39,0:12:47.76,Default,,0,0,0,,Айдаһар!
Dialogue: 0,0:12:47.85,0:12:49.10,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:12:49.18,0:12:50.97,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:12:51.77,0:12:54.64,Default,,0,0,0,,Люстің... сиқыры
Dialogue: 0,0:12:55.48,0:12:58.90,Default,,0,0,0,,Бар, Ұлы Рух әлемі!
Dialogue: 0,0:12:59.61,0:13:01.82,Default,,0,0,0,,Император Айдаһар (Ma No)…
Dialogue: 0,0:13:01.90,0:13:03.11,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:03.19,0:13:08.37,Default,,0,0,0,,Соғыс!
Dialogue: 0,0:13:11.66,0:13:12.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:15.96,0:13:18.50,Default,,0,0,0,,Яаааааа!
Dialogue: 0,0:13:18.59,0:13:21.71,Default,,0,0,0,,Жоқ... жоқ! Адамдар мұндай сиқырды жасай алады!
Dialogue: 0,0:13:21.80,0:13:26.30,Default,,0,0,0,,Кал... Кал-сама!
Dialogue: 0,0:13:26.38,0:13:29.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:04.38,0:14:08.72,Default,,0,0,0,,О, бұлттар... бұлттар ашылып жатыр.
Dialogue: 0,0:14:08.80,0:14:11.39,Default,,0,0,0,,Дауылдың тосқауылдары бұзылды ма?
Dialogue: 0,0:14:22.77,0:14:24.61,Default,,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,0:14:24.69,0:14:28.66,Default,,0,0,0,,Сендердің әрқайсыларыңның жүздері сондай бейшарасыңдар.
Dialogue: 0,0:14:30.70,0:14:35.20,Default,,0,0,0,,Өте әдемі кейіпкердің қайтып оралуын қарсы алған қатты дауыстар не болды?
Dialogue: 0,0:14:35.29,0:14:39.08,Default,,0,0,0,,Құрттар! Увахахаха
Dialogue: 0,0:14:40.67,0:14:43.04,Default,,0,0,0,,Аа~ мен ұйықтадым, ұйықтадым
Dialogue: 0,0:14:43.13,0:14:47.01,Default,,0,0,0,,Хмм, бұл жақсы жел.
Dialogue: 0,0:14:47.09,0:14:49.30,Default,,0,0,0,,Сергіту таңы, солай емес пе?
Dialogue: 0,0:15:08.90,0:15:10.15,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:15:18.87,0:15:22.83,Default,,0,0,0,,Ха... харру~ Бұл не? Не? Шынайы ма?
Dialogue: 0,0:15:22.92,0:15:25.00,Default,,0,0,0,,Йоко-сан, кернеу тым жоғары.
Dialogue: 0,0:15:25.09,0:15:26.96,Default,,0,0,0,,(Марио) Уау! (Цезарь) Уф!
Dialogue: 0,0:15:27.05,0:15:29.38,Default,,0,0,0,,Бір сәт...
Dialogue: 0,0:15:32.26,0:15:34.14,Default,,0,0,0,,ше? иә?
Dialogue: 0,0:15:34.22,0:15:35.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:35.18,0:15:36.47,Default,,0,0,0,,Ахондара!
Dialogue: 0,0:15:36.56,0:15:39.27,Default,,0,0,0,,Кеш болды, кеш болды, кеш болды!
Dialogue: 0,0:15:39.35,0:15:41.81,Default,,0,0,0,,Екі жыл бойы не істеп жүрсің!
Dialogue: 0,0:15:41.89,0:15:44.40,Default,,0,0,0,,Екінші маусымда енгізілген негізгі жаңа кейіпкерлер
Dialogue: 0,0:15:44.48,0:15:46.27,Default,,0,0,0,,Олардың бәрі өлді!
Dialogue: 0,0:15:46.36,0:15:49.03,Default,,0,0,0,,Сіз басты кейіпкер ретінде дисквалификациясыз!
Dialogue: 0,0:15:49.78,0:15:52.24,Default,,0,0,0,,Мен тез ашуланамын
Dialogue: 0,0:15:52.32,0:15:56.49,Default,,0,0,0,,Егер бұл Йоко-саннан басқа біреу болса, мен өлуге қарсы емеспін.
Dialogue: 0,0:15:56.58,0:15:58.45,Default,,0,0,0,,Ашулан, шындап.
Dialogue: 0,0:15:58.54,0:16:01.71,Default,,0,0,0,,Кешіріңіз, енді қайталамаймын, енді айтпаймын!
Dialogue: 0,0:16:02.79,0:16:05.08,Default,,0,0,0,,Бірдеңе істе, жарай ма?
Dialogue: 0,0:16:05.17,0:16:07.71,Default,,0,0,0,,Сіз мұны оңай айтасыз.
Dialogue: 0,0:16:07.80,0:16:09.67,Default,,0,0,0,,Жаңа кейіпкер өлді, солай ма?
Dialogue: 0,0:16:09.76,0:16:11.88,Default,,0,0,0,,Сіз мені күтпеген жерден өмірге қайтаруымды өтінсеңіз де
Dialogue: 0,0:16:11.97,0:16:13.30,Default,,0,0,0,,Ешқандай болжам жоқ
Dialogue: 0,0:16:13.38,0:16:16.01,Default,,0,0,0,,Бұл аниме қаншалықты жақсы болса да.
Dialogue: 0,0:16:16.68,0:16:17.81,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:16:19.97,0:16:24.19,Default,,0,0,0,,Мен сенетін жалғыз адамсың, өтінемін
Dialogue: 0,0:16:24.27,0:16:28.02,Default,,0,0,0,,Мен енді саған ашуланбаймын, ұрмаймын.
Dialogue: 0,0:16:28.11,0:16:29.11,Default,,0,0,0,,Эй?
Dialogue: 0,0:16:29.19,0:16:30.07,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:16:36.12,0:16:37.16,Default,,0,0,0,,Өзінің өліміне әкелсе де.
Dialogue: 0,0:16:37.24,0:16:38.33,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.62,0:16:42.75,Default,,0,0,0,,Уф хахаха...
Dialogue: 0,0:16:43.75,0:16:46.21,Default,,0,0,0,,Бұл... үлкен мәселе болды.
Dialogue: 0,0:16:46.29,0:16:49.17,Default,,0,0,0,,Маған Калға хабарлау керек.
Dialogue: 0,0:16:49.25,0:16:51.92,Default,,0,0,0,,Ухехехе, қарашы.
Dialogue: 0,0:16:52.01,0:16:56.14,Default,,0,0,0,,Өлмейтін адам Ашулы Батори-сама... Иә?
Dialogue: 0,0:16:59.01,0:17:03.52,Default,,0,0,0,,Эй, сіздің ішкі ағзаларыңызды зақымдайтын регенерациялық жәндіктер болды, солай ма?
Dialogue: 0,0:17:03.60,0:17:05.40,Default,,0,0,0,,Оххх
Dialogue: 0,0:17:06.65,0:17:10.36,Default,,0,0,0,,Хм, бұл бәріне жетеді ме?
Dialogue: 0,0:17:10.44,0:17:14.78,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:17:14.86,0:17:16.78,Default,,0,0,0,,Өйткені сіз басты кейіпкерсіз, солай ма?
Dialogue: 0,0:17:16.86,0:17:19.78,Default,,0,0,0,,Мен жараланған адаммын. Эй, мен қарсы емеспін.
Dialogue: 0,0:17:19.87,0:17:22.66,Default,,0,0,0,,Сіз мұндай адамды кездестіремін деп ойламадыңыз ба? мм...
Dialogue: 0,0:17:23.37,0:17:25.83,Default,,0,0,0,,Менің ойымша, мен оны тағы да алуым керек.
Dialogue: 0,0:17:26.33,0:17:28.00,Default,,0,0,0,,Техи…
Dialogue: 0,0:17:28.08,0:17:31.34,Default,,0,0,0,,Мен сені сүйреп шығарамын!
Dialogue: 0,0:17:31.42,0:17:32.76,Default,,0,0,0,,Тоқта... Жооо!
Dialogue: 0,0:17:32.84,0:17:35.55,Default,,0,0,0,,Жүр, шық!
Dialogue: 0,0:17:42.06,0:17:43.35,Default,,0,0,0,,А…?
Dialogue: 0,0:17:44.14,0:17:47.10,Default,,0,0,0,,Гүл бақшасы... Иә?
Dialogue: 0,0:17:49.98,0:17:53.19,Default,,0,0,0,,Шен Мохи Ангус!
Dialogue: 0,0:17:53.28,0:17:55.40,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,0:18:01.08,0:18:02.20,Default,,0,0,0,,Ешуа!
Dialogue: 0,0:18:02.29,0:18:04.91,Default,,0,0,0,,Кай! Аман жүргеніңізге қуаныштымын.
Dialogue: 0,0:18:06.54,0:18:07.37,Default,,0,0,0,,Ах
Dialogue: 0,0:18:08.92,0:18:11.00,Default,,0,0,0,,Бір нәрсе киіңіз.
Dialogue: 0,0:18:11.09,0:18:14.34,Default,,0,0,0,,О, кешіріңіз! Мен... көп жағдайда кешірім сұраймын.
Dialogue: 0,0:18:19.68,0:18:24.14,Default,,0,0,0,,Жақсы, Шин, ол оны тірі қалдырды.
Dialogue: 0,0:18:25.93,0:18:29.15,Default,,0,0,0,,Шынымды айтсам, мен бақыттымын.
Dialogue: 0,0:18:29.77,0:18:32.77,Default,,0,0,0,,Уфуфуфу... Уау
Dialogue: 0,0:18:32.86,0:18:33.94,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:18:34.03,0:18:36.19,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:18:36.28,0:18:38.65,Default,,0,0,0,,Бұдан былай мен үшінші дәрежелі комедияны ойнаймын.
Dialogue: 0,0:18:38.74,0:18:41.87,Default,,0,0,0,,Мен бәріңді осы Қараңғы Шнайдер-саманың қызметшісі етемін.
Dialogue: 0,0:18:41.95,0:18:44.70,Default,,0,0,0,,Мен өзімді құрметтеймін, сондықтан...
Dialogue: 0,0:18:46.25,0:18:48.16,Default,,0,0,0,,Кяаааааааааааааааааааааааааааа
Dialogue: 0,0:18:48.25,0:18:50.63,Default,,0,0,0,,Бұл әйел менікі
Dialogue: 0,0:18:50.71,0:18:53.46,Default,,0,0,0,,Сондықтан менімен араласқан адамды өлтіремін!
Dialogue: 0,0:18:53.54,0:18:57.59,Default,,0,0,0,,Түсіндіңіз бе? Қорқақ ақымақ!
Dialogue: 0,0:18:57.67,0:18:59.59,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:18:59.68,0:19:03.43,Default,,0,0,0,,Алаңдамаңыз! (Дирк Шнайдер) Гуфу...
Dialogue: 0,0:19:04.14,0:19:05.93,Default,,0,0,0,,Йоко-сан: Сіз Абигейлмен соғысқан кезде
Dialogue: 0,0:19:06.02,0:19:07.98,Default,,0,0,0,,Маған қыз беремін деді.
Dialogue: 0,0:19:08.06,0:19:10.19,Default,,0,0,0,,На~ни~!
Dialogue: 0,0:19:10.27,0:19:11.73,Default,,0,0,0,,Жоқ... олай емес...
Dialogue: 0,0:19:11.81,0:19:13.02,Default,,0,0,0,,Мен саған беремін дедім.
Dialogue: 0,0:19:13.11,0:19:14.90,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:19:15.78,0:19:17.11,Default,,0,0,0,,Бұл кім? сол адам
Dialogue: 0,0:19:17.19,0:19:19.86,Default,,0,0,0,,Сондықтан бұл түсінбеушілік. Бұл дұрыс емес!
Dialogue: 0,0:19:19.95,0:19:21.66,Default,,0,0,0,,Эй, Йоко-сан, істейік.
Dialogue: 0,0:19:21.74,0:19:22.74,Default,,0,0,0,,Қазір жасайық
Dialogue: 0,0:19:22.82,0:19:25.58,Default,,0,0,0,,Киіміңізді кенеттен шешпеңіз!
Dialogue: 0,0:19:26.16,0:19:28.04,Default,,0,0,0,,О!
Dialogue: 0,0:19:28.79,0:19:32.67,Default,,0,0,0,,Иә, бұл Дирк Шнайдер ме?
Dialogue: 0,0:19:43.30,0:19:48.68,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:19:53.73,0:19:57.61,Default,,0,0,0,,Уф, аа, а...
Dialogue: 0,0:19:57.69,0:20:00.70,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:20:00.78,0:20:03.07,Default,,0,0,0,,Ол адам адам емес.
Dialogue: 0,0:20:04.12,0:20:09.58,Default,,0,0,0,,Буха, кешіріңіз... Кешіріңіз.
Dialogue: 0,0:20:11.96,0:20:13.54,Default,,0,0,0,,О, ау
Dialogue: 0,0:20:13.62,0:20:17.50,Default,,0,0,0,,Ненің құлап жатқанын ойласам, тағы да адам екен.
Dialogue: 0,0:20:20.38,0:20:22.76,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:20:22.84,0:20:24.76,Default,,0,0,0,,Уф... Иә?
Dialogue: 0,0:20:24.84,0:20:28.51,Default,,0,0,0,,Дегенмен, бұл біртүрлі кездейсоқтық. Негізі мен де...
Dialogue: 0,0:20:28.60,0:20:31.02,Default,,0,0,0,,Фуууууу
Dialogue: 0,0:20:32.31,0:20:35.98,Default,,0,0,0,,Осыдан екі жылдай бұрын мен кенет бір жерге құлап қалдым.
Dialogue: 0,0:20:36.48,0:20:41.36,Default,,0,0,0,,Мен мұны кім жасағанын білемін.
Dialogue: 0,0:20:42.03,0:20:44.41,Default,,0,0,0,,Бұл күлкілі бөтен жер.
Dialogue: 0,0:20:44.49,0:20:46.87,Default,,0,0,0,,Әй, мен қиын болдым.
Dialogue: 0,0:20:46.95,0:20:48.87,Default,,0,0,0,,Теңізден өту немесе шөлден өту
Dialogue: 0,0:20:48.95,0:20:52.08,Default,,0,0,0,,Жол-жөнекей ессіз шытырман оқиғаға тап болдым.
Dialogue: 0,0:20:52.16,0:20:54.17,Default,,0,0,0,,Біз осы Бейіт Барриге жеткенше
Dialogue: 0,0:20:54.25,0:20:56.33,Default,,0,0,0,,Оған екі жыл қажет болды.
Dialogue: 0,0:20:56.42,0:21:02.80,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууу!
Dialogue: 0,0:21:02.88,0:21:06.39,Default,,0,0,0,,Хмф, бұл сиқырлы зақым.
Dialogue: 0,0:21:06.47,0:21:09.01,Default,,0,0,0,,Сіз үлкен дәрежеде жеңіліп қалған сияқтысыз...
Dialogue: 0,0:21:09.10,0:21:11.52,Default,,0,0,0,,Мұны кім жасады? Сіз
Dialogue: 0,0:21:11.60,0:21:13.94,Default,,0,0,0,,Дада…
Dialogue: 0,0:21:14.02,0:21:17.98,Default,,0,0,0,,Дар... Дирк Шнайдер...
Dialogue: 0,0:21:18.06,0:21:21.44,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:21:23.36,0:21:27.53,Default,,0,0,0,,Уа, иә, солай.
Dialogue: 0,0:21:27.62,0:21:31.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:31.45,0:21:35.33,Default,,0,0,0,,Мен міндетті түрде аламын... Мен міндетті түрде кек аламын Гаха
Dialogue: 0,0:21:35.41,0:21:38.04,Default,,0,0,0,,Жарайды, жақсы, түсіндім.
Dialogue: 0,0:21:38.13,0:21:39.84,Default,,0,0,0,,Мұны орындаңыз.
Dialogue: 0,0:21:40.42,0:21:43.55,Default,,0,0,0,,Гала-сама (бағыныңқы) Жер бетінде бұл не?
Dialogue: 0,0:21:43.63,0:21:47.09,Default,,0,0,0,,Ей, балалар, мына жігітке қамқор болыңдар.
Dialogue: 0,0:21:47.18,0:21:49.18,Default,,0,0,0,,Иә (бағыныңқы) Түсіндім.
Dialogue: 0,0:22:03.73,0:22:07.74,Default,,0,0,0,,Құдай-ау, ол әлі тірі ме?
Dialogue: 0,0:22:10.74,0:22:14.29,Default,,0,0,0,,Тексеріңіз, бұл өте қыңыр.
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.05,0:23:50.05,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory