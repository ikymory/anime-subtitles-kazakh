Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.76,0:00:16.64,Default,,0,0,0,,Бұл самурай генералы Нильс Шон Мифуненің хабарламасы.
Dialogue: 0,0:00:17.43,0:00:22.35,Default,,0,0,0,,Ертең күн батқанда самурайлар корпусы басқарған көтерілісшілер әскері шабуыл жасайды
Dialogue: 0,0:00:22.43,0:00:26.65,Default,,0,0,0,,Біз бұрынғы Яһуда патшалығының астанасы Типтоаға жан-жақты шабуыл жасаймыз.
Dialogue: 0,0:00:27.23,0:00:28.48,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:28.57,0:00:31.94,Default,,0,0,0,,Geo Note Sort-қа, Мета-Ликананың бас діни қызметкері,
Dialogue: 0,0:00:32.03,0:00:34.36,Default,,0,0,0,,Менің Лунаттық көтерілісшілер әскерін басқар
Dialogue: 0,0:00:34.45,0:00:38.24,Default,,0,0,0,,Ол сіздің Типтоаның оңтүстіктен жасалған шабуылына қосылуыңызды қалайды.
Dialogue: 0,0:00:38.78,0:00:42.16,Default,,0,0,0,,Әрине, қуана қатысамын.
Dialogue: 0,0:00:42.25,0:00:44.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:44.16,0:00:48.38,Default,,0,0,0,,Егер бұрынғы Бес Батыр, Мифуне-сама мен Гео-сама қатысатын болса.
Dialogue: 0,0:00:48.46,0:00:50.92,Default,,0,0,0,,Сондай-ақ көтерілісшілер әскерінің рухын көтеруді көздейді.
Dialogue: 0,0:00:52.26,0:00:54.38,Default,,0,0,0,,Гео мырза, одан басқа
Dialogue: 0,0:00:55.05,0:00:57.09,Default,,0,0,0,,Мета-Ликана патшалығының ханшайымы
Dialogue: 0,0:00:57.18,0:01:01.47,Default,,0,0,0,,Шейла Тоэль Мета-Ликананың қайда екені белгілі болған сияқты.
Dialogue: 0,0:01:01.56,0:01:02.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:01:02.73,0:01:04.94,Default,,0,0,0,,Шейла ханшайымы ше?
Dialogue: 0,0:01:05.02,0:01:07.10,Default,,0,0,0,,Сонымен ханшайым қайда?
Dialogue: 0,0:01:07.19,0:01:10.57,Default,,0,0,0,,Мен бұл Король Кримсон Даңқы деп естідім.
Dialogue: 0,0:01:10.65,0:01:13.24,Default,,0,0,0,,Король Кримсон Даңқы
Dialogue: 0,0:01:13.99,0:01:17.53,Default,,0,0,0,,Жоғалған эльф қираған қалада Шейла ханшайым...
Dialogue: 0,0:01:18.37,0:01:21.29,Default,,0,0,0,,Лорд Мифуне Шейла ханшайымды құтқаруға келді.
Dialogue: 0,0:01:21.37,0:01:23.58,Default,,0,0,0,,Біз элиталық самурайларды жібердік
Dialogue: 0,0:01:24.29,0:01:28.29,Default,,0,0,0,,Құтқару тобына Джоның қызы Йоко және
Dialogue: 0,0:01:28.38,0:01:29.92,Default,,0,0,0,,Аңызға айналған шебер⸺
Dialogue: 0,0:01:30.00,0:01:32.63,Default,,0,0,0,,Менімен бірге Дирк Шнайдер келеді.
Dialogue: 0,0:01:32.71,0:01:33.71,Default,,0,0,0,,Не!
Dialogue: 0,0:01:33.80,0:01:36.01,Default,,0,0,0,,Ах
Dialogue: 0,0:01:36.68,0:01:37.80,Default,,0,0,0,,Да…
Dialogue: 0,0:01:37.89,0:01:40.60,Default,,0,0,0,,Дирк Шнайдер тірі ме...?
Dialogue: 0,0:01:40.68,0:01:42.56,Default,,0,0,0,,Шон Хари
Dialogue: 0,0:01:42.64,0:01:45.31,Default,,0,0,0,,Бұл… бұл рас па?
Dialogue: 0,0:01:45.39,0:01:48.56,Default,,0,0,0,,бұл... Иә, естігенімше.
Dialogue: 0,0:01:48.65,0:01:50.73,Default,,0,0,0,,Қайта тірілген Қараңғы Шнайдер
Dialogue: 0,0:01:50.81,0:01:56.15,Default,,0,0,0,,Олар өздерінің зор сиқырлы күшімен самурайлар резиденциясына шабуыл жасаған екі сиқырлы генералды жеңді.
Dialogue: 0,0:01:56.24,0:01:59.99,Default,,0,0,0,,Каль-Су ұйымдастырған деми-адамдардың үлкен экспедициялық күші.
Dialogue: 0,0:02:00.07,0:02:02.08,Default,,0,0,0,,Жойқын соққы беру
Dialogue: 0,0:02:03.58,0:02:05.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:06.66,0:02:08.54,Default,,0,0,0,,Дирк Шнайдер...
Dialogue: 0,0:02:11.13,0:02:12.80,Default,,0,0,0,,Маған жақсы әйел болу керек
Dialogue: 0,0:02:12.88,0:02:14.51,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:02:17.13,0:02:18.55,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:02:21.85,0:02:23.85,Default,,0,0,0,,♪～
Dialogue: 0,0:03:47.06,0:03:49.06,Default,,0,0,0,,～♪
Dialogue: 0,0:03:53.31,0:03:54.40,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:03:56.65,0:03:58.15,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:58.82,0:04:00.78,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:04:01.57,0:04:02.70,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:02.78,0:04:05.82,Default,,0,0,0,,Кел, Шейла.
Dialogue: 0,0:04:06.45,0:04:10.91,Default,,0,0,0,,Енді маған тез кел.
Dialogue: 0,0:04:11.79,0:04:14.71,Default,,0,0,0,,Ішіңді аш
Dialogue: 0,0:04:15.38,0:04:17.92,Default,,0,0,0,,Оның мазмұнын таратыңыз
Dialogue: 0,0:04:19.09,0:04:22.09,Default,,0,0,0,,Мені босат
Dialogue: 0,0:04:22.17,0:04:25.01,Default,,0,0,0,,Мен... Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,0:04:25.09,0:04:27.18,Default,,0,0,0,,Көмектесіңіз! біреу!
Dialogue: 0,0:04:27.26,0:04:31.14,Default,,0,0,0,,Шейла, егер сен өлсең...
Dialogue: 0,0:04:31.22,0:04:34.19,Default,,0,0,0,,Ах! Ааа...
Dialogue: 0,0:04:34.27,0:04:37.31,Default,,0,0,0,,Менің мөрім сынған
Dialogue: 0,0:04:37.40,0:04:39.78,Default,,0,0,0,,Еркін болыңыз
Dialogue: 0,0:04:40.86,0:04:41.99,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,0:04:42.57,0:04:47.28,Default,,0,0,0,,Бүкіл дүниенің тағдырын өз қолыңда ұстайтын сен бол.
Dialogue: 0,0:04:47.91,0:04:51.16,Default,,0,0,0,,Ауырды... тоқтатыңызшы.
Dialogue: 0,0:04:51.25,0:04:53.46,Default,,0,0,0,,Мен үшін бұл мүмкін емес
Dialogue: 0,0:04:54.12,0:04:55.37,Default,,0,0,0,,Мен саған қандай питч лақтыратынымды айтамын дедім.
Dialogue: 0,0:04:55.46,0:04:58.42,Default,,0,0,0,,Бұл... сенің өмірің.
Dialogue: 0,0:04:59.13,0:05:00.84,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:05:00.92,0:05:02.76,Default,,0,0,0,,Кяаааааааааа!
Dialogue: 0,0:05:02.84,0:05:04.80,Default,,0,0,0,,Маған көмектес, ағайын!
Dialogue: 0,0:05:07.18,0:05:08.26,Default,,0,0,0,,Ах
Dialogue: 0,0:05:09.26,0:05:12.22,Default,,0,0,0,,Сіз қандайсыз...!
Dialogue: 0,0:05:18.44,0:05:19.77,Default,,0,0,0,,Бауырым...
Dialogue: 0,0:05:22.82,0:05:26.20,Default,,0,0,0,,Жоқ. Сіз...
Dialogue: 0,0:05:26.95,0:05:28.45,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:05:30.87,0:05:33.83,Default,,0,0,0,,Ах Дирк Шнайдер
Dialogue: 0,0:05:34.54,0:05:37.79,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:05:37.87,0:05:39.54,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:05:39.63,0:05:40.96,Default,,0,0,0,,Ах
Dialogue: 0,0:05:41.59,0:05:44.05,Default,,0,0,0,,Ханшайым көз жасын төгеді...
Dialogue: 0,0:05:46.05,0:05:49.26,Default,,0,0,0,,Әлгі адамның сиқырлы ұйқысы
Dialogue: 0,0:05:49.34,0:05:51.93,Default,,0,0,0,,Ол таяз болып бара жатыр ма?
Dialogue: 0,0:05:52.01,0:05:56.27,Default,,0,0,0,,Қарасам, әлгі адам оянды.
Dialogue: 0,0:05:56.35,0:05:59.19,Default,,0,0,0,,Қараңғы... Шнайдер мырза
Dialogue: 0,0:05:59.90,0:06:02.40,Default,,0,0,0,,Ханшайым жеңіл ұйықтаса
Dialogue: 0,0:06:02.48,0:06:06.28,Default,,0,0,0,,Бұл сізді Калдың сиқырлы анықтауына сезімтал етеді.
Dialogue: 0,0:06:06.99,0:06:11.49,Default,,0,0,0,,Осы жылдамдықпен мысықтар ақырында сізді табады.
Dialogue: 0,0:06:11.58,0:06:15.20,Default,,0,0,0,,Жоқ немесе әлдеқашан...
Dialogue: 0,0:06:16.75,0:06:21.00,Default,,0,0,0,,Ханшайымды ерте алуға келгенім керек еді.
Dialogue: 0,0:06:21.08,0:06:24.96,Default,,0,0,0,,Бұл қираған қалаға жау жеткенше
Dialogue: 0,0:06:28.55,0:06:29.97,Default,,0,0,0,,Ана
Dialogue: 0,0:06:30.05,0:06:32.93,Default,,0,0,0,,Әкесіз жалғызсың ба?
Dialogue: 0,0:06:33.60,0:06:35.14,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:35.22,0:06:38.14,Default,,0,0,0,,Жалғыз емеспін десем, өтірік айтқан болар едім
Dialogue: 0,0:06:38.23,0:06:39.73,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:06:39.81,0:06:44.44,Default,,0,0,0,,Өмір бойы анаңның қасында болып, мұңайсаң жұбатармын.
Dialogue: 0,0:06:44.52,0:06:46.74,Default,,0,0,0,,Рахмет Кал
Dialogue: 0,0:06:46.82,0:06:48.40,Default,,0,0,0,,Менде сен бар
Dialogue: 0,0:06:49.15,0:06:51.16,Default,,0,0,0,,Мен сенде.
Dialogue: 0,0:06:55.91,0:06:58.62,Default,,0,0,0,,Біз енді бір-біріміз емеспіз
Dialogue: 0,0:06:58.71,0:07:01.83,Default,,0,0,0,,Өйткені менде маңызды ештеңе жоқ
Dialogue: 0,0:07:10.26,0:07:11.84,Default,,0,0,0,,Қар…
Dialogue: 0,0:07:12.39,0:07:14.43,Default,,0,0,0,,Осы маусымда қар жауады.
Dialogue: 0,0:07:14.97,0:07:20.23,Default,,0,0,0,,Лорд Калдан тасып төгілген құдіретті сиқырлы күш жаңбыр жауып тұрғандай болды.
Dialogue: 0,0:07:22.90,0:07:26.57,Default,,0,0,0,,Ынви мен оның достарының дирижабльмен шайқасқа кеткеніне 10 күн болды.
Dialogue: 0,0:07:27.23,0:07:29.11,Default,,0,0,0,,Жағдайыңыз жақсы ма?
Dialogue: 0,0:07:29.61,0:07:31.70,Default,,0,0,0,,Өйткені олар жақсы араласпайды.
Dialogue: 0,0:07:33.28,0:07:34.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:35.37,0:07:37.41,Default,,0,0,0,,Жел суық және ауыр
Dialogue: 0,0:07:38.04,0:07:39.37,Default,,0,0,0,,(Төртеуінің ауыр демі)
Dialogue: 0,0:07:39.45,0:07:41.62,Default,,0,0,0,,Бір нәрсе келе жатыр
Dialogue: 0,0:07:42.42,0:07:45.04,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:07:45.13,0:07:48.13,Default,,0,0,0,,Ауыр атмосфера аумақты толтырады...
Dialogue: 0,0:07:51.05,0:07:51.97,Default,,0,0,0,,Ах
Dialogue: 0,0:07:52.51,0:07:54.51,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:07:55.22,0:07:57.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:58.68,0:07:59.81,Default,,0,0,0,,Балалар...?
Dialogue: 0,0:08:00.31,0:08:04.15,Default,,0,0,0,,Мына түрі... Бала кезіндегі Кәл-сама ма?
Dialogue: 0,0:08:04.90,0:08:08.78,Default,,0,0,0,,Бұл рухани дене ме? Жоқ, бұл психикалық дене.
Dialogue: 0,0:08:09.44,0:08:10.90,Default,,0,0,0,,Иә, бұл арман.
Dialogue: 0,0:08:11.49,0:08:15.41,Default,,0,0,0,,Каль-саманың... түсін есте сақтауы қандай да бір қатты психологиялық қысымға ұшырайды.
Dialogue: 0,0:08:15.49,0:08:17.12,Default,,0,0,0,,Ол жобалануда.
Dialogue: 0,0:08:17.74,0:08:21.08,Default,,0,0,0,,Қалдың қарғыс атқан баласы
Dialogue: 0,0:08:21.16,0:08:22.00,Default,,0,0,0,,Репрессия
Dialogue: 0,0:08:22.08,0:08:24.42,Default,,0,0,0,,Шекара халқының көсемінің немересі (Арман дауысы).
Dialogue: 0,0:08:24.50,0:08:28.63,Default,,0,0,0,,Қысым (Арман дауыс) Көсемнің немересі
Dialogue: 0,0:08:28.71,0:08:31.63,Default,,0,0,0,,Арам қанды мұра еткен сенсің
Dialogue: 0,0:08:31.72,0:08:33.88,Default,,0,0,0,,Отбасын мұрагерлікке алуға құқығы жоқ!
Dialogue: 0,0:08:33.97,0:08:35.14,Default,,0,0,0,,Уф
Dialogue: 0,0:08:39.18,0:08:42.10,Default,,0,0,0,,Ана, әке ше?
Dialogue: 0,0:08:42.18,0:08:47.44,Default,,0,0,0,,Cal Күміс шашың мен көк көздерің
Dialogue: 0,0:08:47.52,0:08:51.86,Default,,0,0,0,,Суық терімізді сол кісіден алғанбыз.
Dialogue: 0,0:08:51.94,0:08:54.65,Default,,0,0,0,,Әкесі енді жоқ.
Dialogue: 0,0:08:55.28,0:08:57.57,Default,,0,0,0,,Мен туған әлемге оралдым.
Dialogue: 0,0:08:57.66,0:09:00.79,Default,,0,0,0,,Бұл Лорд Калдың анасы ма?
Dialogue: 0,0:09:00.87,0:09:02.87,Default,,0,0,0,,Қандай әдемі адам!
Dialogue: 0,0:09:03.83,0:09:05.79,Default,,0,0,0,,Эй (бала) Ахаха
Dialogue: 0,0:09:05.87,0:09:07.50,Default,,0,0,0,,Жо… Жотаро-сан! Ой… бұл не?!
Dialogue: 0,0:09:07.58,0:09:10.42,Default,,0,0,0,,Каль Сені басшының немересі дейді.
Dialogue: 0,0:09:10.50,0:09:12.96,Default,,0,0,0,,Мұны барлық ересектер біледі.
Dialogue: 0,0:09:13.05,0:09:15.47,Default,,0,0,0,,Сенің әкең адам емес.
Dialogue: 0,0:09:15.55,0:09:18.43,Default,,0,0,0,,Демек, сен де адам емессің.
Dialogue: 0,0:09:18.51,0:09:21.77,Default,,0,0,0,,Сенің анаң...
Dialogue: 0,0:09:21.85,0:09:24.43,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:09:29.69,0:09:32.11,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:32.78,0:09:36.03,Default,,0,0,0,,Немесе... Ана...
Dialogue: 0,0:09:36.11,0:09:37.99,Default,,0,0,0,,Ка… Кал…
Dialogue: 0,0:09:42.41,0:09:43.91,Default,,0,0,0,,Бұл қарғыс!
Dialogue: 0,0:09:44.00,0:09:47.67,Default,,0,0,0,,Қандай қорқынышты қарғыс!
Dialogue: 0,0:09:47.75,0:09:49.92,Default,,0,0,0,,Бұл бала адам емес!
Dialogue: 0,0:09:50.00,0:09:53.80,Default,,0,0,0,,Бұлай жалғаса берсе, біз де өлгенше қарғысқа ұшыраймыз!
Dialogue: 0,0:09:53.88,0:09:56.17,Default,,0,0,0,,Қамау! Мені құлыптаңыз!
Dialogue: 0,0:09:56.26,0:09:57.51,Default,,0,0,0,,Ка… Кал!
Dialogue: 0,0:09:58.22,0:10:01.76,Default,,0,0,0,,Анашым! Анашым!
Dialogue: 0,0:10:06.18,0:10:09.15,Default,,0,0,0,,Бұл отбасына апат әкеледі.
Dialogue: 0,0:10:09.23,0:10:12.32,Default,,0,0,0,,5 немесе 10 жылға бас бостандығынан айыру.
Dialogue: 0,0:10:12.40,0:10:13.40,Default,,0,0,0,,Өлгенше!
Dialogue: 0,0:10:13.48,0:10:16.24,Default,,0,0,0,,Қарғыс атқан бала Адам емес
Dialogue: 0,0:10:16.32,0:10:17.82,Default,,0,0,0,,Адам емес!
Dialogue: 0,0:10:20.62,0:10:21.62,Default,,0,0,0,,Кал
Dialogue: 0,0:10:22.41,0:10:24.08,Default,,0,0,0,,My Cal
Dialogue: 0,0:10:24.79,0:10:25.79,Default,,0,0,0,,Кал
Dialogue: 0,0:10:28.04,0:10:29.42,Default,,0,0,0,,Ана
Dialogue: 0,0:10:30.08,0:10:34.96,Default,,0,0,0,,Кешіріңіз, Каль, мені кешіріңіз.
Dialogue: 0,0:10:35.05,0:10:39.43,Default,,0,0,0,,Анашым, ертең келесіз бе?
Dialogue: 0,0:10:40.39,0:10:44.72,Default,,0,0,0,,Мен тыныш боламын, сондықтан мені ұмытпа.
Dialogue: 0,0:10:44.81,0:10:45.97,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:10:46.56,0:10:49.06,Default,,0,0,0,,Cal… Құрметті Кал
Dialogue: 0,0:10:49.98,0:10:55.61,Default,,0,0,0,,(судағы аяқ дыбыстары)
Dialogue: 0,0:11:02.66,0:11:04.78,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:11:05.33,0:11:07.87,Default,,0,0,0,,Бұл ерекше бала.
Dialogue: 0,0:11:07.95,0:11:09.87,Default,,0,0,0,,Қайғылы бала
Dialogue: 0,0:11:09.96,0:11:11.75,Default,,0,0,0,,Жексұрын бала
Dialogue: 0,0:11:11.83,0:11:13.46,Default,,0,0,0,,Қауіпті бала
Dialogue: 0,0:11:13.54,0:11:15.92,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:11:16.00,0:11:19.26,Default,,0,0,0,,Әлде... Ана?
Dialogue: 0,0:11:19.34,0:11:20.88,Default,,0,0,0,,Менің қызым
Dialogue: 0,0:11:20.97,0:11:24.39,Default,,0,0,0,,Біздің отбасымызға апат келгенше
Dialogue: 0,0:11:24.47,0:11:27.56,Default,,0,0,0,,Осы қымбат қылышпен «Мұз сұңқары»
Dialogue: 0,0:11:27.64,0:11:31.64,Default,,0,0,0,,Жиренішті баланың өмірін өз қолыңмен аяқта.
Dialogue: 0,0:11:32.27,0:11:34.94,Default,,0,0,0,,Бұл отбасылық заң.
Dialogue: 0,0:11:35.69,0:11:37.07,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:11:38.03,0:11:39.28,Default,,0,0,0,,Менің күнәм
Dialogue: 0,0:11:40.49,0:11:42.53,Default,,0,0,0,,Осы баланы дүниеге әкелген!
Dialogue: 0,0:11:42.61,0:11:43.87,Default,,0,0,0,,Мына бала!
Dialogue: 0,0:11:45.16,0:11:46.49,Default,,0,0,0,,Тоқта...!
Dialogue: 0,0:11:55.42,0:11:56.96,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:12:07.89,0:12:09.85,Default,,0,0,0,,Ахх!
Dialogue: 0,0:12:09.93,0:12:12.23,Default,,0,0,0,,Ахх!
Dialogue: 0,0:12:12.31,0:12:13.94,Default,,0,0,0,,Кяаааааааа!
Dialogue: 0,0:12:14.02,0:12:19.86,Default,,0,0,0,,(Кал Судың айқайы)
Dialogue: 0,0:12:19.94,0:12:21.40,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:12:21.49,0:12:23.11,Default,,0,0,0,,Хахаха
Dialogue: 0,0:12:23.20,0:12:27.41,Default,,0,0,0,,Мені сүйе алмаған анам мені өлтіруге келді.
Dialogue: 0,0:12:27.49,0:12:31.20,Default,,0,0,0,,Анасының кегін алды.
Dialogue: 0,0:12:31.29,0:12:34.37,Default,,0,0,0,,Сенің жүрегіңде осы жарақат болғанша
Dialogue: 0,0:12:35.00,0:12:38.00,Default,,0,0,0,,Менің жүрегімде осы бос орын болғанша
Dialogue: 0,0:12:38.09,0:12:41.72,Default,,0,0,0,,Егер сіз өз әлсіздігіңізді жеңе алмасаңыз
Dialogue: 0,0:12:41.80,0:12:44.01,Default,,0,0,0,,Кал, сен
Dialogue: 0,0:12:44.09,0:12:47.68,Default,,0,0,0,,Менің сиқырымнан құтылу мүмкін емес
Dialogue: 0,0:12:48.26,0:12:51.85,Default,,0,0,0,,Кальдың сүйкімді жәндігі
Dialogue: 0,0:12:52.60,0:12:56.73,Default,,0,0,0,,Осы қарғыс атқан мөрден жойылу құдайы Сібір жарасы.
Dialogue: 0,0:12:56.81,0:12:58.52,Default,,0,0,0,,Шығару үшін...
Dialogue: 0,0:12:58.61,0:12:59.90,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:12:59.98,0:13:02.28,Default,,0,0,0,,Бұрынғы Абигейл сияқты
Dialogue: 0,0:13:02.36,0:13:05.36,Default,,0,0,0,,Өлгенше еңбек ет
Dialogue: 0,0:13:05.45,0:13:11.29,Default,,0,0,0,,Говалававара Говалававара
Dialogue: 0,0:13:11.37,0:13:13.46,Default,,0,0,0,,Ах, а, ки... Сіз мұны естідіңіз бе?
Dialogue: 0,0:13:13.54,0:13:16.12,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:13:16.21,0:13:17.25,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.17,0:13:20.96,Default,,0,0,0,,Ах! Че, ол... Шера-сама!
Dialogue: 0,0:13:21.05,0:13:23.42,Default,,0,0,0,,Енді… қазір, сіз жаңа айтқаныңызды естідіңіз бе?
Dialogue: 0,0:13:23.51,0:13:25.18,Default,,0,0,0,,Ка... Каль-сама...
Dialogue: 0,0:13:25.97,0:13:28.85,Default,,0,0,0,,Балалар сендер мұны естідіңдер.
Dialogue: 0,0:13:31.89,0:13:33.43,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:13:33.52,0:13:37.60,Default,,0,0,0,,Мұны естісең, мен сені тірі қалдырмаймын!
Dialogue: 0,0:13:38.65,0:13:40.48,Default,,0,0,0,,Яаааааа!
Dialogue: 0,0:13:45.82,0:13:48.41,Default,,0,0,0,,Зығыр сияқты бейберекет адам әлемінде
Dialogue: 0,0:13:48.49,0:13:51.28,Default,,0,0,0,,Нұр әкелетін Құтқарушыны іздеңіз
Dialogue: 0,0:13:51.37,0:13:53.16,Default,,0,0,0,,батасын беру
Dialogue: 0,0:13:55.04,0:13:57.75,Default,,0,0,0,,Мәсіх - Лорд Кал.
Dialogue: 0,0:13:57.83,0:14:00.04,Default,,0,0,0,,Мен әлі де сенемін
Dialogue: 0,0:14:01.46,0:14:02.55,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:03.84,0:14:05.26,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:14:06.17,0:14:07.97,Default,,0,0,0,,Өте аянышты.
Dialogue: 0,0:14:10.89,0:14:12.14,Default,,0,0,0,,Тозақ тозағы
Dialogue: 0,0:14:21.15,0:14:25.03,Default,,0,0,0,,Тез, адал қол-аяғым.
Dialogue: 0,0:14:25.11,0:14:27.74,Default,,0,0,0,,Анасы шыдамайды.
Dialogue: 0,0:14:27.82,0:14:29.74,Default,,0,0,0,,Куку куку
Dialogue: 0,0:14:29.82,0:14:36.50,Default,,0,0,0,,(Кал Судың күлкісі)
Dialogue: 0,0:14:38.71,0:14:40.88,Default,,0,0,0,,Не... нені айтып тұрсыз?
Dialogue: 0,0:14:41.50,0:14:45.67,Default,,0,0,0,,Осы қараусыз қалған астананың төңірегінде қара бұлттар жиналуда.
Dialogue: 0,0:14:46.21,0:14:49.43,Default,,0,0,0,,Бұл табиғи құбылыс емес
Dialogue: 0,0:14:50.01,0:14:53.14,Default,,0,0,0,,Жау... Жау келе жатыр.
Dialogue: 0,0:14:55.72,0:14:58.02,Default,,0,0,0,,12-ші кемеге найзағай түсті!
Dialogue: 0,0:14:58.73,0:15:01.15,Default,,0,0,0,,Ұшу мүмкін емес. Құлап жатыр!
Dialogue: 0,0:15:01.23,0:15:04.73,Default,,0,0,0,,Қарғыс атсын, неткен дауыл! Мен оны басқара алмаймын!
Dialogue: 0,0:15:04.82,0:15:08.44,Default,,0,0,0,,Құрметті Ынви, корпус мұндай жылдамдықпен тұра алмайды!
Dialogue: 0,0:15:08.53,0:15:09.99,Default,,0,0,0,,Біртүрлі. Шынында да, бәрі біртүрлі.
Dialogue: 0,0:15:10.07,0:15:13.49,Default,,0,0,0,,Бұл өте төмен қысым сиқыр арқылы жасалған болуы керек.
Dialogue: 0,0:15:14.08,0:15:16.54,Default,,0,0,0,,King Crimson Glory әуе қорғаныс жүйесі
Dialogue: 0,0:15:16.62,0:15:18.08,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:15:18.62,0:15:19.62,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:15:19.71,0:15:22.67,Default,,0,0,0,,«Әлемнің көзі» жауабы көбейіп келеді
Dialogue: 0,0:15:22.75,0:15:25.09,Default,,0,0,0,,Баратын жерімізге жақындап қалдық.
Dialogue: 0,0:15:25.17,0:15:28.21,Default,,0,0,0,,Сиқырлы қала патшасы Crimson Glory
Dialogue: 0,0:15:28.30,0:15:30.34,Default,,0,0,0,,Бұл дауылдың арғы жағында!
Dialogue: 0,0:15:31.93,0:15:35.68,Default,,0,0,0,,Ран мырза, өнімді бұдан әрі көбейту қауіпті!
Dialogue: 0,0:15:35.76,0:15:37.39,Default,,0,0,0,,Жылдамдықты төмендетпеңіз!
Dialogue: 0,0:15:37.47,0:15:40.14,Default,,0,0,0,,Жылдамдықты нашар бәсеңдетсең, дауылға тап боласың!
Dialogue: 0,0:15:40.94,0:15:44.27,Default,,0,0,0,,Баратын жер жақын! Қорқынышыңызды сейілтіңіз!
Dialogue: 0,0:15:44.77,0:15:45.61,Default,,0,0,0,,Ах
Dialogue: 0,0:15:45.69,0:15:48.07,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:15:50.36,0:15:51.99,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:15:52.07,0:15:54.82,Default,,0,0,0,,Мен бұл көлеңкені ешқашан ойламаппын...
Dialogue: 0,0:15:58.04,0:16:00.58,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:16:00.66,0:16:01.96,Default,,0,0,0,,6-шы кеме!
Dialogue: 0,0:16:02.96,0:16:05.17,Default,,0,0,0,,Не? Ағымдағы көлеңке
Dialogue: 0,0:16:05.25,0:16:06.38,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:16:06.46,0:16:09.09,Default,,0,0,0,,Енді бұл найзағайдың тынысы.
Dialogue: 0,0:16:09.17,0:16:11.22,Default,,0,0,0,,Ха, олай емес...
Dialogue: 0,0:16:11.30,0:16:13.68,Default,,0,0,0,,Бұл ақымақ!
Dialogue: 0,0:16:13.76,0:16:15.89,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:15.97,0:16:19.10,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:16:19.18,0:16:20.68,Default,,0,0,0,,Бұл айдаһар!
Dialogue: 0,0:16:20.77,0:16:23.14,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:24.15,0:16:26.65,Default,,0,0,0,,Эй, мынаны қара! (Теңізші) Бұл айдаһар!
Dialogue: 0,0:16:28.36,0:16:29.53,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:16:32.78,0:16:35.20,Default,,0,0,0,,Мүмкін бұлт айдаһары
Dialogue: 0,0:16:35.28,0:16:39.41,Default,,0,0,0,,Алайда мен мұндай ересек айдаһардың бар екенін білмедім.
Dialogue: 0,0:16:39.49,0:16:43.71,Default,,0,0,0,,Сиқырлы қалаға әуе жолын қорғайтын қамқоршы?
Dialogue: 0,0:16:43.79,0:16:47.63,Default,,0,0,0,,Әй, айдаһар барын білсең.
Dialogue: 0,0:16:47.71,0:16:50.09,Default,,0,0,0,,Каль-сама да әдепсіз.
Dialogue: 0,0:16:52.47,0:16:54.84,Default,,0,0,0,,9 және 14-ші кемелер суға батады!
Dialogue: 0,0:16:54.93,0:16:56.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:56.14,0:16:59.51,Default,,0,0,0,,... Жылдам (матрос) Жоқ, қашып құтыла алмайсың!
Dialogue: 0,0:17:05.14,0:17:06.77,Default,,0,0,0,,Дааааааа!
Dialogue: 0,0:17:06.85,0:17:07.73,Default,,0,0,0,,Влад!
Dialogue: 0,0:17:07.81,0:17:09.61,Default,,0,0,0,,Ууууууууууууууууууууууууу
Dialogue: 0,0:17:09.69,0:17:13.65,Default,,0,0,0,,Ууууууууууууууууууууууу!
Dialogue: 0,0:17:13.74,0:17:18.24,Default,,0,0,0,,дирижабль ауада ұшатын сутегі газы бомбасына ұқсайды.
Dialogue: 0,0:17:18.32,0:17:20.66,Default,,0,0,0,,Бұл қарқынмен біз барлығын құтқара алмаймыз!
Dialogue: 0,0:17:20.74,0:17:22.75,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:17:22.83,0:17:25.50,Default,,0,0,0,,Бірақ сиқыр айдаһарларда жұмыс істемейді!
Dialogue: 0,0:17:25.58,0:17:27.92,Default,,0,0,0,,Онымен намысшыл қылышыңызбен шайқасқыңыз келе ме?
Dialogue: 0,0:17:28.00,0:17:29.79,Default,,0,0,0,,Қалжыңдауды доғар!
Dialogue: 0,0:17:29.88,0:17:33.63,Default,,0,0,0,,Адамдар айдаһардың алдында жәндіктерден артық емес.
Dialogue: 0,0:17:33.72,0:17:36.01,Default,,0,0,0,,Шүкір, тағы келді.
Dialogue: 0,0:17:36.93,0:17:38.09,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:17:41.64,0:17:43.52,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:17:43.60,0:17:46.60,Default,,0,0,0,,Мынау... Артынан айдаһар келе жатыр!
Dialogue: 0,0:17:46.69,0:17:49.02,Default,,0,0,0,,Қарғыс атсын... осы уақытқа дейін?
Dialogue: 0,0:17:49.11,0:17:52.48,Default,,0,0,0,,Осы біртүрлі аспан менің соңғы баратын жерім бола ма?
Dialogue: 0,0:17:58.53,0:18:01.53,Default,,0,0,0,,Ю... 18-ші кеме - біздің кеменің қалқаны!
Dialogue: 0,0:18:04.58,0:18:06.41,Default,,0,0,0,,18-ші кеме апатқа ұшырады
Dialogue: 0,0:18:06.50,0:18:09.92,Default,,0,0,0,,18-ші кеме капитанының телепатиялық байланысы
Dialogue: 0,0:18:11.09,0:18:14.63,Default,,0,0,0,,«Мен демон генерал өз миссиясын аяқтайды деп күтемін».
Dialogue: 0,0:18:15.26,0:18:16.26,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:18.30,0:18:19.84,Default,,0,0,0,,Қарғыс атсын... (матрос) Мен жеңілдім.
Dialogue: 0,0:18:19.93,0:18:22.31,Default,,0,0,0,,О, құдайым (теңізші) Қарғыс атсын...
Dialogue: 0,0:18:25.35,0:18:28.52,Default,,0,0,0,,Сонымен... дұрыс, әлі емес.
Dialogue: 0,0:18:28.60,0:18:30.94,Default,,0,0,0,,Біз әлі бас тарта алмаймыз!
Dialogue: 0,0:18:31.02,0:18:32.86,Default,,0,0,0,,Қандай қиыншылық болса да
Dialogue: 0,0:18:32.94,0:18:36.82,Default,,0,0,0,,Ажалдың соңғы сәтіне дейін, сол адам үшін!
Dialogue: 0,0:18:36.90,0:18:39.86,Default,,0,0,0,,Сиқырлы құрылғының қуатын 120% дейін арттырыңыз!
Dialogue: 0,0:18:39.95,0:18:40.99,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:18:41.07,0:18:43.53,Default,,0,0,0,,Егер мұны жасасаңыз, сиқырлы құрылғы шамадан тыс жүктеледі.
Dialogue: 0,0:18:43.62,0:18:45.50,Default,,0,0,0,,Ең нашар сценарий, ол өздігінен жойылады!
Dialogue: 0,0:18:45.58,0:18:46.62,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:18:46.70,0:18:49.25,Default,,0,0,0,,Біз бұл дауылдан аман қалғанша, жақсы!
Dialogue: 0,0:18:49.33,0:18:50.88,Default,,0,0,0,,Өнімді көбейтіңіз!
Dialogue: 0,0:18:50.96,0:18:52.38,Default,,0,0,0,,У… у… Құдай-ай!
Dialogue: 0,0:18:57.88,0:18:59.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:59.34,0:19:03.51,Default,,0,0,0,,Ка... Каль, маған күш берші.
Dialogue: 0,0:19:04.43,0:19:05.47,Default,,0,0,0,,Ах
Dialogue: 0,0:19:05.56,0:19:07.06,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:19:07.14,0:19:08.77,Default,,0,0,0,,Лорд Ынви, алға!
Dialogue: 0,0:19:09.35,0:19:10.19,Default,,0,0,0,,Ах
Dialogue: 0,0:19:12.23,0:19:14.36,Default,,0,0,0,,Бұлттардың арасынан жарық түседі...
Dialogue: 0,0:19:14.44,0:19:16.53,Default,,0,0,0,,Бұлттарды жарып өт!
Dialogue: 0,0:19:37.80,0:19:40.34,Default,,0,0,0,,Ой!
Dialogue: 0,0:19:42.01,0:19:43.05,Default,,0,0,0,,Лапута
Dialogue: 0,0:19:44.64,0:19:47.52,Default,,0,0,0,,Керемет, Лапута шынымен де болған.
Dialogue: 0,0:19:49.10,0:19:51.10,Default,,0,0,0,,Сонымен... Деки
Dialogue: 0,0:19:51.19,0:19:54.31,Default,,0,0,0,,Мен оны қалқымалы қала деп ешқашан ойламадым
Dialogue: 0,0:19:54.40,0:19:59.28,Default,,0,0,0,,Ежелгі жазбалардағы кеме сияқты.
Dialogue: 0,0:20:00.19,0:20:01.74,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:20:01.82,0:20:04.45,Default,,0,0,0,,Бұл сиқырлы қала
Dialogue: 0,0:20:04.53,0:20:07.41,Default,,0,0,0,,Король Кримсон Даңқы?
Dialogue: 0,0:20:07.99,0:20:11.08,Default,,0,0,0,,Ақыры... Ақыры келдім.
Dialogue: 0,0:20:11.96,0:20:16.92,Default,,0,0,0,,Міне, Сібірдің жойылу Құдайын қайта тірілтетін соңғы мөр.
Dialogue: 0,0:20:17.42,0:20:19.67,Default,,0,0,0,,Каль-саманың тілегі орындалады!
Dialogue: 0,0:20:19.76,0:20:21.76,Default,,0,0,0,,Лорд Ынви, жоғары!
Dialogue: 0,0:20:23.09,0:20:24.26,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:20:26.35,0:20:28.01,Default,,0,0,0,,Не? Сол жарық
Dialogue: 0,0:20:30.85,0:20:33.23,Default,,0,0,0,,Мұнараға жарық түсті!
Dialogue: 0,0:20:33.31,0:20:35.94,Default,,0,0,0,,Уф, мүмкін емес! Міне осы!
Dialogue: 0,0:20:36.02,0:20:39.90,Default,,0,0,0,,Ғарыш тасымалдау құрылғысы Қақпа ашылды!
Dialogue: 0,0:20:39.98,0:20:43.74,Default,,0,0,0,,Бізден бұрын қалаға біреу басып кірді!
Dialogue: 0,0:20:43.82,0:20:46.49,Default,,0,0,0,,Лорд Ынви, артымыздағы аласапыран бұлттардан!
Dialogue: 0,0:20:46.57,0:20:47.70,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:20:48.49,0:20:51.87,Default,,0,0,0,,Ой, мен бұл туралы ұмытып кетіппін!
Dialogue: 0,0:20:51.95,0:20:52.79,Default,,0,0,0,,Барлық кемелер
Dialogue: 0,0:20:52.87,0:20:55.04,Default,,0,0,0,,Король Қырмызы Даңққа қоныңыз!
Dialogue: 0,0:20:55.12,0:20:57.08,Default,,0,0,0,,Егер сол айдаһар қамқоршы болса
Dialogue: 0,0:20:57.17,0:20:59.34,Default,,0,0,0,,Олар сиқырлы қалаға шабуыл жасамауы керек!
Dialogue: 0,0:21:01.05,0:21:04.05,Default,,0,0,0,,Күте тұрыңыз... бұл тікелей соққы! Күте тұр!
Dialogue: 0,0:21:04.13,0:21:08.80,Default,,0,0,0,,Баратын жеріңнің алдында құласаң, Жын генералдың масқарасы боласың!
Dialogue: 0,0:21:08.89,0:21:10.51,Default,,0,0,0,,Не болса да, асығыңыз...
Dialogue: 0,0:21:10.60,0:21:11.52,Default,,0,0,0,,Уф
Dialogue: 0,0:21:12.68,0:21:15.14,Default,,0,0,0,,Құны қандай болса да...
Dialogue: 0,0:21:15.23,0:21:17.73,Default,,0,0,0,,Король Қырмызы Даңққа!
Dialogue: 0,0:21:27.70,0:21:30.91,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:21:30.99,0:21:32.29,Default,,0,0,0,,Уф
Dialogue: 0,0:21:32.37,0:21:34.46,Default,,0,0,0,,Уф... жақсысың ба?
Dialogue: 0,0:21:34.54,0:21:35.87,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:21:35.96,0:21:37.71,Default,,0,0,0,,Сіз әлі келдіңіз бе?
Dialogue: 0,0:21:37.79,0:21:39.54,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:21:39.63,0:21:42.38,Default,,0,0,0,,Шен, жолдан кет, Ангус, сен де.
Dialogue: 0,0:21:46.30,0:21:50.93,Default,,0,0,0,,Бұл аңызға айналған эльфтің қираған қаласы.
Dialogue: 0,0:21:51.56,0:21:52.89,Default,,0,0,0,,Ауырды
Dialogue: 0,0:21:52.97,0:21:55.43,Default,,0,0,0,,Ей, бәрі тез жолдан кетші... Буфууууу
Dialogue: 0,0:21:56.48,0:22:00.02,Default,,0,0,0,,Сонымен... керемет. Бүкіл қала аспанмен ұшып келеді.
Dialogue: 0,0:22:00.94,0:22:02.94,Default,,0,0,0,,Дұрыс, Йоко-сан.
Dialogue: 0,0:22:03.53,0:22:07.36,Default,,0,0,0,,Ескі дүние сиқырының мәнін жинау арқылы эльфтер жасаған⸺
Dialogue: 0,0:22:07.45,0:22:09.03,Default,,0,0,0,,Ұлы сиқырлы қала
Dialogue: 0,0:22:09.95,0:22:12.54,Default,,0,0,0,,Сиқырлы мәдениеттің гүлденуі
Dialogue: 0,0:22:13.41,0:22:14.87,Default,,0,0,0,,Қираған қала
Dialogue: 0,0:22:16.16,0:22:17.83,Default,,0,0,0,,Мұнарлы боқ
Dialogue: 0,0:22:18.33,0:22:20.54,Default,,0,0,0,,Король Кримсон Даңқы
Dialogue: 0,0:22:21.34,0:22:23.34,Default,,0,0,0,,♪～
Dialogue: 0,0:22:27.51,0:22:30.26,Default,,0,0,0,,Мен бүкіл қаланы аспанда қалықтата алатындай болдым
Dialogue: 0,0:22:30.34,0:22:32.89,Default,,0,0,0,,Жетілдірілген сиқырлы өркениет болса да
Dialogue: 0,0:22:34.85,0:22:36.31,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:39.48,0:22:41.73,Default,,0,0,0,,Сіз бірден түсінесіз
Dialogue: 0,0:22:41.81,0:22:42.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:46.53,0:22:48.74,Default,,0,0,0,,Кинг Кримсон Даңқы
Dialogue: 0,0:22:48.82,0:22:50.28,Default,,0,0,0,,Оның жойылу себебі
Dialogue: 0,0:22:50.99,0:22:54.99,Default,,0,0,0,,Дүниенің 400 жыл бұрын жойылу себебі
Dialogue: 0,0:23:47.84,0:23:49.84,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory