Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.84,0:00:14.84,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.93,0:01:39.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:42.26,0:01:45.64,Default,,0,0,0,,Әй, өл.
Dialogue: 0,0:01:45.73,0:01:46.77,Default,,0,0,0,,Ах
Dialogue: 0,0:01:46.85,0:01:48.81,Default,,0,0,0,,Антра Рэй!
Dialogue: 0,0:01:48.90,0:01:51.73,Default,,0,0,0,,Жарық сәулесінің ақ жүзін алып тастау! Не!
Dialogue: 0,0:01:51.82,0:01:53.15,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:01:54.65,0:01:57.40,Default,,0,0,0,,Сіз енді қаракөз емессіз
Dialogue: 0,0:01:57.49,0:02:00.03,Default,,0,0,0,,Шаш сияқты ауыртпайды
Dialogue: 0,0:02:00.12,0:02:01.62,Default,,0,0,0,,Хмм!
Dialogue: 0,0:02:01.70,0:02:05.66,Default,,0,0,0,,Өлі рух зеңбіректерін түрмеге жабу (Фо Бе Дун)!
Dialogue: 0,0:02:06.54,0:02:09.50,Default,,0,0,0,,Сиқыршы патша Дарк Шнайдер үнемі
Dialogue: 0,0:02:09.58,0:02:14.63,Default,,0,0,0,,Ең күшті және жеңілмейтін Төрт аспан патшасы сенің соңынан ереді!
Dialogue: 0,0:02:18.34,0:02:21.97,Default,,0,0,0,,А... а...
Dialogue: 0,0:02:22.05,0:02:23.93,Default,,0,0,0,,О...
Dialogue: 0,0:02:24.01,0:02:26.48,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:02:26.98,0:02:28.52,Default,,0,0,0,,Ниндзя шебері Гала
Dialogue: 0,0:02:29.02,0:02:30.02,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:02:30.10,0:02:31.90,Default,,0,0,0,,Найзағай императоры Эшет Ней
Dialogue: 0,0:02:32.82,0:02:34.82,Default,,0,0,0,,Аспан асты елінің пайғамбары Әбигел
Dialogue: 0,0:02:35.61,0:02:38.24,Default,,0,0,0,,Ши...Төрт Аспан Патшасы
Dialogue: 0,0:02:38.32,0:02:40.95,Default,,0,0,0,,Қараңғы Шнайдердің төрт аспан патшасы!
Dialogue: 0,0:02:41.03,0:02:43.12,Default,,0,0,0,,Гала Сіз тірісіз!
Dialogue: 0,0:02:43.20,0:02:46.08,Default,,0,0,0,,Жоқ... Ней мырза!
Dialogue: 0,0:02:46.16,0:02:48.54,Default,,0,0,0,,Найзағай императоры Эш Ней
Dialogue: 0,0:02:48.62,0:02:51.04,Default,,0,0,0,,Мен оны тірі деп ойламаппын.
Dialogue: 0,0:02:52.00,0:02:53.50,Default,,0,0,0,,Дарш!
Dialogue: 0,0:02:54.38,0:02:55.59,Default,,0,0,0,,Күл
Dialogue: 0,0:03:00.01,0:03:01.47,Default,,0,0,0,,Темерамо
Dialogue: 0,0:03:01.55,0:03:05.22,Default,,0,0,0,,Енді Жоюшы Құдайдың күші көрінді
Dialogue: 0,0:03:05.31,0:03:07.98,Default,,0,0,0,,Оны енді Қалмен шайқас деп атауға болмайды.
Dialogue: 0,0:03:08.06,0:03:09.89,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:03:09.98,0:03:14.40,Default,,0,0,0,,Мен Аспандағы Төрт Патшаның міндеттерін орындаймын және көмектесемін.
Dialogue: 0,0:03:14.48,0:03:19.44,Default,,0,0,0,,Хехехехе, мен саған көмектесуге келдім, Дирк Шнайдер.
Dialogue: 0,0:03:20.11,0:03:22.41,Default,,0,0,0,,Бұл жақын қоңырау болды, сен.
Dialogue: 0,0:03:22.49,0:03:25.33,Default,,0,0,0,,Кешігіп қалдың, ақымақ! Ақымақ! Норома!
Dialogue: 0,0:03:25.41,0:03:28.04,Default,,0,0,0,,Не істедің, пайдасыз!
Dialogue: 0,0:03:28.12,0:03:31.46,Default,,0,0,0,,Саған анау сұрықсыз қолдар керек емес, маймыл!
Dialogue: 0,0:03:31.54,0:03:32.71,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:03:32.79,0:03:35.17,Default,,0,0,0,,Мына сұлу мен ұтыла ма? Сегізаяқ!
Dialogue: 0,0:03:35.25,0:03:37.42,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:03:37.50,0:03:39.38,Default,,0,0,0,,Нуах...
Dialogue: 0,0:03:39.46,0:03:41.97,Default,,0,0,0,,Нуанда және мына Қараңғы Шнайдер!
Dialogue: 0,0:03:42.05,0:03:43.97,Default,,0,0,0,,Содан кейін біз екі жылдан кейін бірінші рет қайта кездестік...
Dialogue: 0,0:03:44.05,0:03:46.97,Default,,0,0,0,,Оның үстіне өмірін сақтап қалған адамға түкірген сызығы осы!
Dialogue: 0,0:03:47.06,0:03:48.77,Default,,0,0,0,,Шулы горилла!
Dialogue: 0,0:03:48.85,0:03:52.35,Default,,0,0,0,,Әдеттегідей, сахна артындағы шайқасты түсіндіріңіз!
Dialogue: 0,0:03:52.44,0:03:56.57,Default,,0,0,0,,Бұл горилла! Пайдасыз горилла! Біліксіз горилла!
Dialogue: 0,0:03:56.65,0:03:59.28,Default,,0,0,0,,Міне... бейбақ!
Dialogue: 0,0:03:59.36,0:04:01.99,Default,,0,0,0,,Сен ақымақсың, ақымақсың!
Dialogue: 0,0:04:02.07,0:04:04.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:04.20,0:04:06.45,Default,,0,0,0,,Өлейін деп тұрсың, ақымақ!
Dialogue: 0,0:04:06.53,0:04:07.78,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:04:07.87,0:04:10.04,Default,,0,0,0,,Сіз мені жылатасыз! Мен қазір жылаймын!
Dialogue: 0,0:04:10.12,0:04:11.79,Default,,0,0,0,,О, байқап көріңіз!
Dialogue: 0,0:04:11.87,0:04:14.21,Default,,0,0,0,,Тоқта, Гала Дааш сені ренжітіп жатыр!
Dialogue: 0,0:04:14.29,0:04:15.71,Default,,0,0,0,,Ней, қамқорлық жасама!
Dialogue: 0,0:04:15.79,0:04:17.79,Default,,0,0,0,,Мен әрқашан Дарштың жағында боламын!
Dialogue: 0,0:04:17.88,0:04:19.92,Default,,0,0,0,,Балалар сендер қатты шу шығарып жатырсыңдар!
Dialogue: 0,0:04:20.01,0:04:22.88,Default,,0,0,0,,Не айтып тұрсың! Шығу тегі туралы айтатын болсақ, сіз...
Dialogue: 0,0:04:22.97,0:04:26.09,Default,,0,0,0,,Нуууууууууууууууууууууууууууууууууууууууаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:26.18,0:04:30.06,Default,,0,0,0,,Құдайға қарсы күресетін ақымақтар
Dialogue: 0,0:04:30.68,0:04:33.48,Default,,0,0,0,,Ол бәрін өлтіреді
Dialogue: 0,0:04:43.45,0:04:45.20,Default,,0,0,0,,Адамдардың жан дүниесі
Dialogue: 0,0:04:45.28,0:04:47.82,Default,,0,0,0,,Сібір жарасының жұтуы
Dialogue: 0,0:04:48.62,0:04:51.50,Default,,0,0,0,,Ол азап шегіп, қайтыс болғандардан⸺
Dialogue: 0,0:04:51.58,0:04:54.67,Default,,0,0,0,,Олар мұң мен реніштен зардап шегеді.
Dialogue: 0,0:04:57.63,0:04:58.67,Default,,0,0,0,,Ібіліс
Dialogue: 0,0:04:58.75,0:05:04.59,Default,,0,0,0,,А~хахаха хахаха
Dialogue: 0,0:05:04.68,0:05:08.51,Default,,0,0,0,,Құдайға қарсы шыққан ақымақтар
Dialogue: 0,0:05:09.14,0:05:12.47,Default,,0,0,0,,Ол бәріңді өлтіреді!
Dialogue: 0,0:05:12.56,0:05:14.64,Default,,0,0,0,,Шулы құбыжық!
Dialogue: 0,0:05:14.73,0:05:17.85,Default,,0,0,0,,Мен саған енді қалағаныңды істеуге рұқсат бермеймін. Өзіңізді дайындаңыз!
Dialogue: 0,0:05:17.94,0:05:23.24,Default,,0,0,0,,Ха, адам күші Құдайға жете ала ма?
Dialogue: 0,0:05:23.32,0:05:25.32,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:05:27.36,0:05:29.62,Default,,0,0,0,,Ах (Йоко) Пішін...
Dialogue: 0,0:05:30.58,0:05:32.24,Default,,0,0,0,,Ол өзгеруде!
Dialogue: 0,0:05:33.79,0:05:38.71,Default,,0,0,0,,(Өзгерген мұз айдаһарының ырылдауы)
Dialogue: 0,0:05:39.46,0:05:42.71,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:45.30,0:05:47.43,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:05:47.51,0:05:50.89,Default,,0,0,0,,Қызық, ол әрі қарай түрлене ме?
Dialogue: 0,0:05:50.97,0:05:53.60,Default,,0,0,0,,Қандай құбыжық
Dialogue: 0,0:05:53.68,0:05:56.56,Default,,0,0,0,,Әй, Жою Құдайы аспанда бейнеленген.
Dialogue: 0,0:05:57.19,0:05:58.52,Default,,0,0,0,,Жоғалу
Dialogue: 0,0:05:59.65,0:06:03.73,Default,,0,0,0,,Өлім жақсы!
Dialogue: 0,0:06:03.82,0:06:05.69,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:06:05.78,0:06:09.07,Default,,0,0,0,,Өл! Өл! Өл!
Dialogue: 0,0:06:09.16,0:06:12.03,Default,,0,0,0,,Өл! Өл!
Dialogue: 0,0:06:12.12,0:06:15.62,Default,,0,0,0,,Жоқ... жоқ... аспанның төрт патшасы қанша болса да.
Dialogue: 0,0:06:15.70,0:06:18.62,Default,,0,0,0,,Жау – Құдай.
Dialogue: 0,0:06:18.71,0:06:21.71,Default,,0,0,0,,Үш адаммен не істейміз? Уф
Dialogue: 0,0:06:21.79,0:06:23.17,Default,,0,0,0,,Уф
Dialogue: 0,0:06:26.76,0:06:28.72,Default,,0,0,0,,Шамасы, бұл құбыжық
Dialogue: 0,0:06:28.80,0:06:32.43,Default,,0,0,0,,Каль-Су өзегі ретінде көбейген жойылу Құдайының ұйымы.
Dialogue: 0,0:06:32.51,0:06:35.72,Default,,0,0,0,,«Мұз сұңқары» сиқырлы қылыштың сиқырлы күшін сіңіру түрінде
Dialogue: 0,0:06:35.81,0:06:37.89,Default,,0,0,0,,Қалыптасқан сияқты
Dialogue: 0,0:06:38.73,0:06:42.65,Default,,0,0,0,,Дене бетін жабатын өте төмен температурадағы сиқырлы мұзды жояды.
Dialogue: 0,0:06:42.73,0:06:47.36,Default,,0,0,0,,Денеге тікелей соққы беретін тактика логикалық тұрғыдан тиімді.
Dialogue: 0,0:06:47.44,0:06:49.32,Default,,0,0,0,,Жарайды Кал
Dialogue: 0,0:06:49.86,0:06:52.49,Default,,0,0,0,,Мен сенен кек аламын!
Dialogue: 0,0:06:52.57,0:06:53.91,Default,,0,0,0,,Не болды!
Dialogue: 0,0:06:53.99,0:06:57.12,Default,,0,0,0,,Айқай, Мурасаме! Жарып өт, жарқыл!
Dialogue: 0,0:06:57.20,0:07:02.21,Default,,0,0,0,,Q-Ultimate Ninja Power, метеорға айналып, зұлымдықты жойыңыз!
Dialogue: 0,0:07:02.83,0:07:04.29,Default,,0,0,0,,Өртенген адам
Dialogue: 0,0:07:04.38,0:07:05.80,Default,,0,0,0,,Фантастикалық супер бейтарап
Dialogue: 0,0:07:05.88,0:07:07.71,Default,,0,0,0,,Астро Ғажайып Гала⸺
Dialogue: 0,0:07:07.80,0:07:09.93,Default,,0,0,0,,Енді ашумен
Dialogue: 0,0:07:10.01,0:07:11.76,Default,,0,0,0,,Өлім... а?
Dialogue: 0,0:07:11.84,0:07:16.06,Default,,0,0,0,,Райджин королі кометасының сызығы!
Dialogue: 0,0:07:16.81,0:07:19.35,Default,,0,0,0,,Ой, ақымақ
Dialogue: 0,0:07:19.43,0:07:21.90,Default,,0,0,0,,Бір әдіс Құдайға екі рет әсер етеді...
Dialogue: 0,0:07:21.98,0:07:24.15,Default,,0,0,0,,Угяоооооо!
Dialogue: 0,0:07:26.19,0:07:28.24,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:07:28.32,0:07:30.36,Default,,0,0,0,,Гухооооооо
Dialogue: 0,0:07:31.28,0:07:33.32,Default,,0,0,0,,Ренгеки құйрықты жұлдызы
Dialogue: 0,0:07:33.99,0:07:36.99,Default,,0,0,0,,О! Ней-сама күткендей
Dialogue: 0,0:07:37.08,0:07:39.75,Default,,0,0,0,,Туй үйге кірді
Dialogue: 0,0:07:39.83,0:07:44.58,Default,,0,0,0,,Қайтарылмаған кекшіл рухтардың күнәларымен толтырылған қасиетті қан.
Dialogue: 0,0:07:44.67,0:07:47.00,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:07:48.84,0:07:51.97,Default,,0,0,0,,Осы себепті...
Dialogue: 0,0:07:52.05,0:07:54.39,Default,,0,0,0,,Гуаааааааааааааааааааааааааааа
Dialogue: 0,0:07:54.47,0:07:56.85,Default,,0,0,0,,Біраз... Иә!
Dialogue: 0,0:07:56.93,0:07:59.14,Default,,0,0,0,,Су… Сусу…
Dialogue: 0,0:07:59.22,0:08:01.06,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:08:01.14,0:08:04.40,Default,,0,0,0,,Қандай керемет күш!
Dialogue: 0,0:08:04.48,0:08:09.28,Default,,0,0,0,,Бұл... бұл Қараңғы Шнайдердің төрт аспан патшасы ма?
Dialogue: 0,0:08:10.07,0:08:11.95,Default,,0,0,0,,Тек күш емес
Dialogue: 0,0:08:12.03,0:08:13.03,Default,,0,0,0,,Сол құбыжықтан
Dialogue: 0,0:08:13.11,0:08:17.70,Default,,0,0,0,,Ичизунаның Дарк Шнайдерді қорғауға деген сенімі
Dialogue: 0,0:08:17.78,0:08:20.66,Default,,0,0,0,,Сәлем! Не істеп жатырсыңдар!
Dialogue: 0,0:08:20.75,0:08:24.12,Default,,0,0,0,,Бұл Гала-самадан бері көп уақыт өтті...
Dialogue: 0,0:08:24.21,0:08:26.42,Default,,0,0,0,,Бұл ең керемет жер болды!
Dialogue: 0,0:08:26.50,0:08:27.96,Default,,0,0,0,,Ұят, ұят!
Dialogue: 0,0:08:28.04,0:08:29.67,Default,,0,0,0,,А? Не?
Dialogue: 0,0:08:29.75,0:08:31.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.72,0:08:37.76,Default,,0,0,0,,Мұндай шабуыл мүлдем жұмыс істемейді!
Dialogue: 0,0:08:37.85,0:08:39.51,Default,,0,0,0,,Не!
Dialogue: 0,0:08:39.60,0:08:41.39,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,0:08:41.48,0:08:45.23,Default,,0,0,0,,Осындай супер сиқырлы шабуылды қабылдағаннан кейін мен мүлдем зиянсыз қалдым!
Dialogue: 0,0:08:45.31,0:08:47.86,Default,,0,0,0,,Мухахаха
Dialogue: 0,0:08:47.94,0:08:50.23,Default,,0,0,0,,Ах... бұл техника
Dialogue: 0,0:08:50.32,0:08:53.45,Default,,0,0,0,,Маса шаққандай сезілмейді.
Dialogue: 0,0:08:53.53,0:08:56.11,Default,,0,0,0,,Немесе… Құдай сияқты!
Dialogue: 0,0:08:56.20,0:08:57.82,Default,,0,0,0,,Қан
Dialogue: 0,0:08:57.91,0:08:59.53,Default,,0,0,0,,Шығу
Мен
Dialogue: 0,0:08:59.62,0:09:01.87,Default,,0,0,0,,бастап жақсымын
Dialogue: 0,0:09:02.87,0:09:04.33,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:09:05.37,0:09:08.17,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:09:08.25,0:09:09.13,Default,,0,0,0,,Хмм!
Dialogue: 0,0:09:09.21,0:09:11.63,Default,,0,0,0,,Құрыш орналастырылды!
Dialogue: 0,0:09:11.71,0:09:14.34,Default,,0,0,0,,Сен не істемексің?
Dialogue: 0,0:09:14.42,0:09:17.05,Default,,0,0,0,,Тамақ
Dialogue: 0,0:09:19.35,0:09:22.22,Default,,0,0,0,,Нуо! Бұл... бұл
Dialogue: 0,0:09:22.31,0:09:25.77,Default,,0,0,0,,Жоқ! Ол бөліне бастаған сияқты.
Dialogue: 0,0:09:25.85,0:09:29.69,Default,,0,0,0,,Шешені тез өлтірмесең, үлкен пәле болады.
Dialogue: 0,0:09:29.77,0:09:31.73,Default,,0,0,0,,Кяаааааааааааааааааааааа
Dialogue: 0,0:09:31.82,0:09:33.99,Default,,0,0,0,,Мухахаха жәндіктер
Dialogue: 0,0:09:34.07,0:09:37.32,Default,,0,0,0,,Хяхахаха, қателер, не болды?
Dialogue: 0,0:09:37.41,0:09:39.70,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:09:39.78,0:09:43.45,Default,,0,0,0,,Бейбақ, құбыжық!
Dialogue: 0,0:09:52.84,0:09:53.84,Default,,0,0,0,,Кал
Dialogue: 0,0:09:55.92,0:09:57.59,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:09:57.68,0:09:58.93,Default,,0,0,0,,Гуах
Dialogue: 0,0:09:59.01,0:10:00.26,Default,,0,0,0,,Зеон!
Dialogue: 0,0:10:00.35,0:10:02.06,Default,,0,0,0,,Құрметті Зак! Гуаааа
Dialogue: 0,0:10:03.01,0:10:04.06,Default,,0,0,0,,Бол!
Dialogue: 0,0:10:04.14,0:10:06.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:06.10,0:10:10.06,Default,,0,0,0,,А... бұл басым емес пе?
Dialogue: 0,0:10:10.15,0:10:12.57,Default,,0,0,0,,Біз онымен сәйкес келе алмаймыз.
Dialogue: 0,0:10:12.65,0:10:15.44,Default,,0,0,0,,Лорд Калды да басқарған!
Dialogue: 0,0:10:15.53,0:10:18.32,Default,,0,0,0,,Құдайдың алдында, біз адамдар
Dialogue: 0,0:10:18.41,0:10:20.45,Default,,0,0,0,,Олар жәндіктерден артық емес!
Dialogue: 0,0:10:20.53,0:10:21.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.49,0:10:23.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:24.12,0:10:26.25,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:10:26.83,0:10:29.50,Default,,0,0,0,,Енді сол Каль құлады.
Dialogue: 0,0:10:30.04,0:10:33.21,Default,,0,0,0,,Біз не істей аламыз?
Dialogue: 0,0:10:33.30,0:10:38.34,Default,,0,0,0,,Уау... біз сондай дәрменсіз, кішкентай жаратылыстармыз.
Dialogue: 0,0:10:38.43,0:10:39.72,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:40.76,0:10:42.68,Default,,0,0,0,,Көбелек биі Asura Slash!
Dialogue: 0,0:10:43.97,0:10:45.81,Default,,0,0,0,,Джошуа Белахия!
Dialogue: 0,0:10:47.48,0:10:50.81,Default,,0,0,0,,Әр адамның күші аз, күшсіз болса да,
Dialogue: 0,0:10:50.90,0:10:54.11,Default,,0,0,0,,Егер біз оларды біріктірсек, біз үлкен және күшті күш жасай аламыз!
Dialogue: 0,0:10:55.36,0:10:58.99,Default,,0,0,0,,Біз ешқашан жалғыз емеспіз
Dialogue: 0,0:10:59.07,0:11:01.70,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:11:04.20,0:11:08.08,Default,,0,0,0,,Кагерю Нинпоның құпия техникасы Фудо Мейокен!
Dialogue: 0,0:11:10.17,0:11:13.54,Default,,0,0,0,,Мықты бол, ағайын, соңына дейін берілме.
Dialogue: 0,0:11:13.63,0:11:17.55,Default,,0,0,0,,Майданда үмітін үзгендер өледі.
Dialogue: 0,0:11:17.63,0:11:20.38,Default,,0,0,0,,Мұны менің ағам жақсы білуі керек!
Dialogue: 0,0:11:20.47,0:11:23.35,Default,,0,0,0,,Шен О... Сен...
Dialogue: 0,0:11:25.97,0:11:28.85,Default,,0,0,0,,Шен Сионды кінәламаңыз.
Dialogue: 0,0:11:31.27,0:11:33.69,Default,,0,0,0,,Зеон самурайдан бас тартты
Dialogue: 0,0:11:33.77,0:11:35.98,Default,,0,0,0,,Сиқырлы қылышты кім алуға тырысты?
Dialogue: 0,0:11:37.32,0:11:41.15,Default,,0,0,0,,Егер біз қазіргідей жүрсек, идеалымызға жете алмаймыз.
Dialogue: 0,0:11:41.74,0:11:43.37,Default,,0,0,0,,Мұқият қарастырғаннан кейін...
Dialogue: 0,0:11:44.53,0:11:46.83,Default,,0,0,0,,Ағайындылар бөлек болса да
Dialogue: 0,0:11:47.33,0:11:52.04,Default,,0,0,0,,Біз екі бөлек жолға шыққанда... және...
Dialogue: 0,0:11:53.04,0:11:55.92,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:11:56.63,0:11:57.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:58.30,0:12:00.59,Default,,0,0,0,,Қайдан іздеп жүрсіз?
Dialogue: 0,0:12:02.47,0:12:03.59,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:12:04.64,0:12:07.60,Default,,0,0,0,,Тұр! Орныңыздан тұрып күресіңіз, ағайын.
Dialogue: 0,0:12:07.68,0:12:09.52,Default,,0,0,0,,Қалағаныңыз үшін!
Dialogue: 0,0:12:09.60,0:12:10.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:10.93,0:12:13.31,Default,,0,0,0,,Иә, күресейік!
Dialogue: 0,0:12:13.90,0:12:16.27,Default,,0,0,0,,Қара қасқыр қылыш!
Dialogue: 0,0:12:16.36,0:12:19.53,Default,,0,0,0,,Егер біз бір берік сенімге күш біріктірсек,
Dialogue: 0,0:12:19.61,0:12:21.90,Default,,0,0,0,,Сіз кез келген қиындыққа тап бола аласыз!
Dialogue: 0,0:12:22.74,0:12:24.66,Default,,0,0,0,,Ақыр аяғы өлім болса да
Dialogue: 0,0:12:24.74,0:12:28.03,Default,,0,0,0,,Мен енді ол зұлымдықты кешіре алмаймын!
Dialogue: 0,0:12:28.12,0:12:31.29,Default,,0,0,0,,Ал... өлсем не істеймін?
Dialogue: 0,0:12:31.37,0:12:34.50,Default,,0,0,0,,Сондықтан сіз жеңсеңіз де, бұл мүлдем ештеңені білдірмейді.
Dialogue: 0,0:12:34.58,0:12:35.71,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:35.79,0:12:38.63,Default,,0,0,0,,Неліктен сендер жеңіліске ұқсайтын ұрысқа шықтыңдар...
Dialogue: 0,0:12:38.71,0:12:40.84,Default,,0,0,0,,Менің ойымша, бұл шешілді!
Dialogue: 0,0:12:41.72,0:12:45.05,Default,,0,0,0,,Аспандағы Конго шабуылы артты!
Dialogue: 0,0:12:47.97,0:12:49.10,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:12:49.18,0:12:51.18,Default,,0,0,0,,Үлкен қараңғы дауылда
Dialogue: 0,0:12:51.27,0:12:53.31,Default,,0,0,0,,Мен оған жалғыз тап болдым
Dialogue: 0,0:12:53.39,0:12:55.27,Default,,0,0,0,,Мен ол кісіге сендім.
Dialogue: 0,0:13:00.19,0:13:03.15,Default,,0,0,0,,Ей, мен енді ештеңеден қорықпаймын.
Dialogue: 0,0:13:03.70,0:13:06.57,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:13:06.66,0:13:09.03,Default,,0,0,0,,А... сендер балалар
Dialogue: 0,0:13:09.12,0:13:10.99,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:13:11.08,0:13:13.20,Default,,0,0,0,,Мен... Мен өлемін.
Dialogue: 0,0:13:13.79,0:13:15.29,Default,,0,0,0,,Әрине түсінемін!
Dialogue: 0,0:13:17.42,0:13:22.92,Default,,0,0,0,,Бушидо дегеніміз не? Өлу және сенім табу!
Dialogue: 0,0:13:29.35,0:13:32.22,Default,,0,0,0,,Енді самурайдың адалдығын орындайтын уақыт!
Dialogue: 0,0:13:32.31,0:13:33.43,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:13:34.73,0:13:36.90,Default,,0,0,0,,А... анау жігіттер.
Dialogue: 0,0:13:36.98,0:13:39.86,Default,,0,0,0,,Бұл самурай ма?
Dialogue: 0,0:13:41.65,0:13:44.53,Default,,0,0,0,,Енді сіз мұны түсіндіңіз.
Dialogue: 0,0:13:45.15,0:13:48.24,Default,,0,0,0,,Лорд Дирк Шнайдердің айтқанының мәні!
Dialogue: 0,0:13:48.32,0:13:50.66,Default,,0,0,0,,Утопия?
Dialogue: 0,0:13:50.74,0:13:54.70,Default,,0,0,0,,Бұл дүниеде мұндай ыңғайлы нәрсенің болуы мүмкін емес.
Dialogue: 0,0:13:54.79,0:13:56.62,Default,,0,0,0,,Тар, көлеңке!
Dialogue: 0,0:13:57.46,0:14:01.17,Default,,0,0,0,,Көлеңкелі манипуляцияның құпия техникасы Көлеңке жын рухы
Dialogue: 0,0:14:01.25,0:14:03.09,Default,,0,0,0,,Жоғары жоғары мырза
Dialogue: 0,0:14:03.17,0:14:04.26,Default,,0,0,0,,Бол!
Dialogue: 0,0:14:04.34,0:14:06.05,Default,,0,0,0,,Нағыз қазына – бұл...
Dialogue: 0,0:14:06.13,0:14:09.97,Default,,0,0,0,,Утопия оны іздегендердің жүрегінде жатыр
Dialogue: 0,0:14:10.05,0:14:13.60,Default,,0,0,0,,Арман боп құмарланып жанғанымен қымбат.
Dialogue: 0,0:14:13.68,0:14:17.98,Default,,0,0,0,,Міне, бұл адамдарға жол көрсететін жақсы күшке айналады.
Dialogue: 0,0:14:18.06,0:14:20.98,Default,,0,0,0,,Дүниені жындардың күшімен биледі
Dialogue: 0,0:14:21.06,0:14:22.94,Default,,0,0,0,,Оның құны қандай?
Dialogue: 0,0:14:23.82,0:14:28.99,Default,,0,0,0,,Біз идеалды әлемді өз күшімізбен жасаймыз!
Dialogue: 0,0:14:29.07,0:14:31.28,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.37,0:14:33.62,Default,,0,0,0,,Қабықтағы елес жын семсер!
Dialogue: 0,0:14:33.70,0:14:35.25,Default,,0,0,0,,Grrgh!
Dialogue: 0,0:14:35.33,0:14:37.12,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:14:38.83,0:14:40.00,Default,,0,0,0,,Уф
Dialogue: 0,0:14:42.04,0:14:42.96,Default,,0,0,0,,Кай!
Dialogue: 0,0:14:43.04,0:14:45.46,Default,,0,0,0,,Уф... оян!
Dialogue: 0,0:14:45.55,0:14:49.18,Default,,0,0,0,,Сіз бен біз әртүрлі жолмен сенсек те
Dialogue: 0,0:14:49.26,0:14:51.72,Default,,0,0,0,,Сіз іздеген нәрсе бірдей болуы керек!
Dialogue: 0,0:14:51.80,0:14:53.05,Default,,0,0,0,,Ах
Dialogue: 0,0:14:53.14,0:14:54.39,Default,,0,0,0,,Уф аа
Dialogue: 0,0:14:54.47,0:14:55.85,Default,,0,0,0,,Ммм аа
Dialogue: 0,0:14:55.93,0:14:57.10,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:57.18,0:14:58.81,Default,,0,0,0,,Біздің
Dialogue: 0,0:14:58.89,0:15:00.56,Default,,0,0,0,,Не іздеу керек
Dialogue: 0,0:15:01.73,0:15:03.11,Default,,0,0,0,,Бұл жер бетінде
Dialogue: 0,0:15:05.15,0:15:07.11,Default,,0,0,0,,Мәңгілік бейбітшілік
Dialogue: 0,0:15:10.53,0:15:14.37,Default,,0,0,0,,Қанша қиын болса да, сеніңдер, жауынгерлер.
Dialogue: 0,0:15:14.95,0:15:16.95,Default,,0,0,0,,Неге сенесіз
Dialogue: 0,0:15:17.04,0:15:19.04,Default,,0,0,0,,Меншікті қуат
Dialogue: 0,0:15:19.62,0:15:20.92,Default,,0,0,0,,Достар
Dialogue: 0,0:15:21.58,0:15:22.88,Default,,0,0,0,,Себебі тергеліп жатыр
Dialogue: 0,0:15:23.54,0:15:24.79,Default,,0,0,0,,Болашақ
Dialogue: 0,0:15:29.51,0:15:31.89,Default,,0,0,0,,Дүниедегі азапты тоқтат!
Dialogue: 0,0:15:34.93,0:15:37.89,Default,,0,0,0,,Мен сенемін ...
Dialogue: 0,0:15:38.68,0:15:39.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:40.94,0:15:42.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:44.06,0:15:45.69,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:47.53,0:15:49.40,Default,,0,0,0,,Сіз өле алмайсыз!
Dialogue: 0,0:15:49.49,0:15:51.03,Default,,0,0,0,,Ынви!
Dialogue: 0,0:15:51.11,0:15:54.32,Default,,0,0,0,,Лорд Кал өле алмайды!
Dialogue: 0,0:15:54.41,0:15:57.54,Default,,0,0,0,,Ол сонда тірі. Бұл сөзсіз тірі!
Dialogue: 0,0:15:57.62,0:15:58.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:58.75,0:16:00.62,Default,,0,0,0,,Өмір сүру...
Dialogue: 0,0:16:00.71,0:16:02.25,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:02.33,0:16:03.46,Default,,0,0,0,,Мистер Кал
Dialogue: 0,0:16:03.54,0:16:06.42,Default,,0,0,0,,Ол адамның одан өліп кетуі мүмкін емес!
Dialogue: 0,0:16:07.46,0:16:09.59,Default,,0,0,0,,Лорд Каль тірі!
Dialogue: 0,0:16:09.67,0:16:11.09,Default,,0,0,0,,Маған сенің көмегің керек!
Dialogue: 0,0:16:11.17,0:16:13.38,Default,,0,0,0,,Сол құбыжықтың ішінен!
Dialogue: 0,0:16:13.47,0:16:14.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:14.68,0:16:15.93,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:16:16.97,0:16:19.35,Default,,0,0,0,,Біз нені елеусіз қалдырдық?
Dialogue: 0,0:16:19.43,0:16:22.14,Default,,0,0,0,,Лорд Кэлдің өлгеніне жол жоқ.
Dialogue: 0,0:16:23.27,0:16:25.86,Default,,0,0,0,,Мен сені жеңемін, құбыжық!
Dialogue: 0,0:16:25.94,0:16:30.53,Default,,0,0,0,,Біз сізге генерал-демонның күшін көрсетеміз!
Dialogue: 0,0:16:30.61,0:16:31.74,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:16:38.20,0:16:42.33,Default,,0,0,0,,Нуууууууууууууууууки... балалар
Dialogue: 0,0:16:42.41,0:16:46.67,Default,,0,0,0,,Тәңірім қайырлы болсын, көтерілген қайсар ерлерге.
Dialogue: 0,0:16:47.21,0:16:49.80,Default,,0,0,0,,Зұлым қараңғылықты бөгейтін қасиетті қалқан
Dialogue: 0,0:16:49.88,0:16:52.55,Default,,0,0,0,,Әділдіктің зұлымдықты тойтару күші
Dialogue: 0,0:16:52.63,0:16:53.93,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:16:56.47,0:16:58.47,Default,,0,0,0,,Мм! Аан
Dialogue: 0,0:16:58.55,0:17:00.43,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:17:00.52,0:17:03.64,Default,,0,0,0,,Сауыт... менің денем – жарық!
Dialogue: 0,0:17:03.73,0:17:05.56,Default,,0,0,0,,Бұл діни қызметкердің «демі».
Dialogue: 0,0:17:05.65,0:17:07.98,Default,,0,0,0,,Қорғаныс күші қасиетті нұрмен артты
Dialogue: 0,0:17:08.06,0:17:10.44,Default,,0,0,0,,Денем өртеніп жатқандай
Dialogue: 0,0:17:10.53,0:17:12.78,Default,,0,0,0,,Маған бұл керек емес.
Dialogue: 0,0:17:12.86,0:17:13.99,Default,,0,0,0,,Сақтығыңызды түсірмеңіз
Dialogue: 0,0:17:14.57,0:17:15.57,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:23.25,0:17:24.62,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:17:25.92,0:17:29.79,Default,,0,0,0,,(Уақыт дауысы)
Dialogue: 0,0:17:29.88,0:17:32.76,Default,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:17:32.84,0:17:34.72,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:17:34.80,0:17:38.93,Default,,0,0,0,,Хуааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:17:39.68,0:17:40.93,Default,,0,0,0,,Құрметті Кал
Dialogue: 0,0:17:41.01,0:17:42.60,Default,,0,0,0,,Түнгі патша семсер!
Dialogue: 0,0:17:42.68,0:17:44.56,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:44.64,0:17:47.48,Default,,0,0,0,,Ұшатын V-тәрізді қиғаш сызық!
Dialogue: 0,0:17:47.56,0:17:49.98,Default,,0,0,0,,Иа, рахмет Кай.
Dialogue: 0,0:17:50.06,0:17:52.61,Default,,0,0,0,,Сенің сөздерің мені оятты!
Dialogue: 0,0:17:52.69,0:17:54.28,Default,,0,0,0,,Гуааааах
Dialogue: 0,0:17:54.36,0:17:57.74,Default,,0,0,0,,Zuoriyaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa to!
Dialogue: 0,0:17:58.45,0:18:01.33,Default,,0,0,0,,Қаһарлы қаһарды жойды!
Dialogue: 0,0:18:01.41,0:18:04.29,Default,,0,0,0,,Гуааааах
Dialogue: 0,0:18:04.37,0:18:07.83,Default,,0,0,0,,Нууууууууууу мына жәндіктер!
Dialogue: 0,0:18:07.92,0:18:09.42,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:18:09.50,0:18:11.13,Default,,0,0,0,,Кууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:18:11.21,0:18:12.59,Default,,0,0,0,,Уау
Dialogue: 0,0:18:12.67,0:18:14.92,Default,,0,0,0,,Біз, жын генералдары,
Dialogue: 0,0:18:15.01,0:18:19.14,Default,,0,0,0,,Дирк Шнайдерге де, Құдайға да, басқа ешкімге де қызмет етпеңіз.
Dialogue: 0,0:18:19.22,0:18:20.60,Default,,0,0,0,,Біз...
Dialogue: 0,0:18:20.68,0:18:24.89,Default,,0,0,0,,Мені қорға, теріс құрыш «Қара ренегад»!
Dialogue: 0,0:18:24.97,0:18:29.27,Default,,0,0,0,,Жын соғысының он екі генералы тек Лорд Калға бағынады.
Dialogue: 0,0:18:30.10,0:18:34.86,Default,,0,0,0,,Ооо, айқай, сиқырлы қылыш «Жан жегіш»
Dialogue: 0,0:18:35.78,0:18:37.95,Default,,0,0,0,,Қара гильотинді слаггер!
Dialogue: 0,0:18:39.99,0:18:41.20,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:18:41.28,0:18:42.49,Default,,0,0,0,,Гуах
Dialogue: 0,0:18:42.58,0:18:43.95,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:18:44.04,0:18:45.33,Default,,0,0,0,,Уф
Dialogue: 0,0:18:47.25,0:18:49.83,Default,,0,0,0,,Қарғыс атсын, Уолдер жүргізуші!
Dialogue: 0,0:18:52.17,0:18:53.17,Default,,0,0,0,,Зак!
Dialogue: 0,0:18:53.25,0:18:54.59,Default,,0,0,0,,Зеон
Dialogue: 0,0:18:56.30,0:18:59.01,Default,,0,0,0,,Ойланып қарасаңыз, біз жын-шайтандық генералдармыз
Dialogue: 0,0:18:59.09,0:19:00.89,Default,,0,0,0,,Бір-біріне көмектесу
Dialogue: 0,0:19:00.97,0:19:03.72,Default,,0,0,0,,Біз бұрын ешқашан бірге жұмыс істеген емеспіз.
Dialogue: 0,0:19:04.68,0:19:07.10,Default,,0,0,0,,Сізге бұл таңқаларлық емес пе, сэр?
Dialogue: 0,0:19:08.48,0:19:13.23,Default,,0,0,0,,Мен маңызды нәрсені есіме түсіргендей болдым.
Dialogue: 0,0:19:13.31,0:19:17.07,Default,,0,0,0,,Гуааааааааааааааааааааааааааааааааааааааааааааааа Алланың қолы...
Dialogue: 0,0:19:17.15,0:19:19.70,Default,,0,0,0,,Ки... сендер балалар!
Dialogue: 0,0:19:20.32,0:19:21.91,Default,,0,0,0,,«Сену»
Dialogue: 0,0:19:21.99,0:19:24.41,Default,,0,0,0,,Бұл әдемі сөздер.
Dialogue: 0,0:19:25.16,0:19:29.41,Default,,0,0,0,,Адамдар Құдайға қарсы шығатын шайқас үшін өте қолайлы.
Dialogue: 0,0:19:30.92,0:19:32.42,Default,,0,0,0,,Шақыру
Dialogue: 0,0:19:32.50,0:19:35.13,Default,,0,0,0,,Бубу... Бубу... Букоро...
Dialogue: 0,0:19:35.21,0:19:36.09,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:19:36.17,0:19:37.05,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:19:37.13,0:19:40.01,Default,,0,0,0,,Дыбыстық тербелістердің соңы!
Dialogue: 0,0:19:40.09,0:19:42.01,Default,,0,0,0,,Гяаааааааааааааааааааааааааа
Dialogue: 0,0:19:42.09,0:19:43.59,Default,,0,0,0,,Титан аяқтары!
Dialogue: 0,0:19:43.68,0:19:44.97,Default,,0,0,0,,Бугюру
Dialogue: 0,0:19:45.05,0:19:47.68,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,0:19:47.77,0:19:51.64,Default,,0,0,0,,Менің құйрығым... Құдайдың құйрығы!
Dialogue: 0,0:19:51.73,0:19:53.94,Default,,0,0,0,,Сіз неге «сенесіз»?
Dialogue: 0,0:19:54.02,0:19:58.11,Default,,0,0,0,,Сен нені айтып тұрсың?
Dialogue: 0,0:19:58.19,0:20:01.40,Default,,0,0,0,,Сондықтан мен балалар мен Нарсиді жек көремін.
Dialogue: 0,0:20:01.49,0:20:03.74,Default,,0,0,0,,Егер біз Калды құтқара алмасақ
Dialogue: 0,0:20:03.82,0:20:07.45,Default,,0,0,0,,Біз жай ғана әскери қылмыскерлерміз.
Dialogue: 0,0:20:07.54,0:20:09.66,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:20:09.75,0:20:11.46,Default,,0,0,0,,Супер гравитациялық бомба (Mega Graviton)!
Dialogue: 0,0:20:11.54,0:20:12.62,Default,,0,0,0,,Уф
Dialogue: 0,0:20:12.71,0:20:15.08,Default,,0,0,0,,Ugggggg...
Dialogue: 0,0:20:15.17,0:20:17.04,Default,,0,0,0,,Buheet!
Dialogue: 0,0:20:17.13,0:20:21.84,Default,,0,0,0,,Ааа... Хаа... Жәндіктер...
Dialogue: 0,0:20:21.92,0:20:28.14,Default,,0,0,0,,О... мен... өлтіремін... өлтіремін... сені өлтіремін...
Dialogue: 0,0:20:28.22,0:20:33.64,Default,,0,0,0,,Өлтіру... Өлтіргенде...
Dialogue: 0,0:20:33.73,0:20:36.69,Default,,0,0,0,,Сен сияқты лас арам
Dialogue: 0,0:20:36.77,0:20:38.65,Default,,0,0,0,,Қате деп нені айтады?
Dialogue: 0,0:20:38.73,0:20:40.94,Default,,0,0,0,,Өте жағымсыз!
Dialogue: 0,0:20:41.90,0:20:43.53,Default,,0,0,0,,Үлкен өлшемді қиғаш сызық!
Dialogue: 0,0:20:43.61,0:20:46.78,Default,,0,0,0,,Баяу
Dialogue: 0,0:20:50.62,0:20:53.21,Default,,0,0,0,,Уф... Мен сені өлтіремін.
Dialogue: 0,0:20:54.25,0:20:58.38,Default,,0,0,0,,Өлетін адам сенсің, ақымақ!
Dialogue: 0,0:20:58.46,0:21:00.46,Default,,0,0,0,,Ниндзя Мастер Гала⸺
Dialogue: 0,0:21:00.55,0:21:04.88,Default,,0,0,0,,Менің жаңа ерекше қимылыммен мен сені дәл қазір талқандаймын!
Dialogue: 0,0:21:04.97,0:21:07.43,Default,,0,0,0,,Кинтама өл!
Dialogue: 0,0:21:07.51,0:21:11.81,Default,,0,0,0,,Өлімге әкелетін жын жарқылы!
Dialogue: 0,0:21:11.89,0:21:13.81,Default,,0,0,0,,Гогюоооо
Dialogue: 0,0:21:18.27,0:21:20.82,Default,,0,0,0,,Адамдарға тіл тигізбе
Dialogue: 0,0:21:21.36,0:21:23.24,Default,,0,0,0,,Бұл Кинтама
Dialogue: 0,0:21:24.99,0:21:26.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:51.78,0:22:53.78,Default,,0,0,0,,～♪
Dialogue: 0,0:23:04.96,0:23:08.88,Default,,0,0,0,,(Обабаның жылағаны)
Dialogue: 0,0:23:08.97,0:23:11.34,Default,,0,0,0,,Сәлем... Ханшайым...
Dialogue: 0,0:23:11.93,0:23:15.06,Default,,0,0,0,,Бұл өте ауыр болса керек.
Dialogue: 0,0:23:15.14,0:23:19.98,Default,,0,0,0,,Қатты болған шығар, ханшайым...
Dialogue: 0,0:23:20.06,0:23:22.44,Default,,0,0,0,,Кешіріңіз, Шейла.
Dialogue: 0,0:23:23.02,0:23:24.52,Default,,0,0,0,,Қазір маған
Dialogue: 0,0:23:24.61,0:23:27.90,Default,,0,0,0,,Егер менде сені қорғауға күшім жетсе...
Dialogue: 0,0:23:28.61,0:23:32.07,Default,,0,0,0,,Мені кешіріңіз, әпкем.
Dialogue: 0,0:23:34.49,0:23:37.41,Default,,0,0,0,,Қарғыс атқыр... Уақытында үлгердім деп ойлаймын.
Dialogue: 0,0:23:37.50,0:23:39.79,Default,,0,0,0,,О... сен!
Dialogue: 0,0:23:39.87,0:23:42.63,Default,,0,0,0,,О, келдің!
Dialogue: 0,0:23:42.71,0:23:45.54,Default,,0,0,0,,Grand Priest Geo Note сұрыптау
Dialogue: 0,0:23:46.05,0:23:49.67,Default,,0,0,0,,Ал кидо триосы Шон Хари
Dialogue: 0,0:23:51.17,0:23:57.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory