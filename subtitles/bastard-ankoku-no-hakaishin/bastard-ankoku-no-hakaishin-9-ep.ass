Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.59,0:00:15.09,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:15.18,0:00:17.85,Default,,0,0,0,,Әй, ата, менімен сөйлесіңіз.
Dialogue: 0,0:00:17.93,0:00:18.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:18.93,0:00:21.39,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:00:21.48,0:00:24.40,Default,,0,0,0,,Олай болса, ертегі кітабыңызды әкеліңіз.
Dialogue: 0,0:00:24.48,0:00:27.40,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:00:27.48,0:00:28.90,Default,,0,0,0,,Бұл шынайы оқиға.
Dialogue: 0,0:00:28.98,0:00:31.90,Default,,0,0,0,,Хмм, бұл шынайы оқиға ма?
Dialogue: 0,0:00:31.99,0:00:34.36,Default,,0,0,0,,Иә, ата үлкен атадан.
Dialogue: 0,0:00:34.45,0:00:37.70,Default,,0,0,0,,Арғы ата да үлкен атадан.
Dialogue: 0,0:00:37.78,0:00:40.91,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан шынайы оқиға.
Dialogue: 0,0:00:41.87,0:00:42.96,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:00:43.04,0:00:44.04,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:44.75,0:00:49.59,Default,,0,0,0,,Адамдар арасында мәңгілікке жалғасатын тарих.
Dialogue: 0,0:00:49.67,0:00:54.09,Default,,0,0,0,,Адам ісінен туған қирау туралы аңыз.
Dialogue: 0,0:00:56.89,0:00:58.89,Default,,0,0,0,,♪～
Dialogue: 0,0:02:22.05,0:02:24.06,Default,,0,0,0,,～♪
Dialogue: 0,0:02:25.77,0:02:27.98,Default,,0,0,0,,Бұл көп уақыт бұрын болды
Dialogue: 0,0:02:28.48,0:02:30.19,Default,,0,0,0,,Жерде орктар да, тролльдер де
Dialogue: 0,0:02:30.27,0:02:32.44,Default,,0,0,0,,Бір кездері гоблиндер де болмаған.
Dialogue: 0,0:02:33.82,0:02:37.03,Default,,0,0,0,,Адамзат әлемі қазіргіден әлдеқайда бай болды.
Dialogue: 0,0:02:38.40,0:02:40.78,Default,,0,0,0,,Үлкен мұнарасы бар қала тұрғызыңыз
Dialogue: 0,0:02:40.86,0:02:44.49,Default,,0,0,0,,Ескі дүниенің орасан зор сиқырлы күші енді жойылды.
Dialogue: 0,0:02:44.58,0:02:47.29,Default,,0,0,0,,Түнді түстей нұрландырды.
Dialogue: 0,0:02:48.00,0:02:50.17,Default,,0,0,0,,Қала арқылы болат арба өтеді
Dialogue: 0,0:02:50.25,0:02:52.84,Default,,0,0,0,,Аспанда ұшатын болат құсты пайдалансаң
Dialogue: 0,0:02:52.92,0:02:56.13,Default,,0,0,0,,Мұхитты кешіп, дүниенің кез келген жеріне бара алатынын айтады.
Dialogue: 0,0:02:59.05,0:03:02.93,Default,,0,0,0,,Тіпті аспанның алыстағы жұлдыздарына да жетуге болады.
Dialogue: 0,0:03:03.01,0:03:04.93,Default,,0,0,0,,Өркендейтіндей болды.
Dialogue: 0,0:03:05.72,0:03:07.06,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:03:07.14,0:03:10.48,Default,,0,0,0,,Әйтсе де, берекенің шыңына жеткен адамның дүниесі
Dialogue: 0,0:03:10.56,0:03:13.44,Default,,0,0,0,,Піскен жемістің шіріп, құлайтыны сияқты.
Dialogue: 0,0:03:14.02,0:03:17.94,Default,,0,0,0,,Байлығына қарамастан, адамдардың жүрегі суық.
Dialogue: 0,0:03:18.44,0:03:22.45,Default,,0,0,0,,Алдау, көреалмаушылық, күдік дерттей тарады.
Dialogue: 0,0:03:22.53,0:03:24.95,Default,,0,0,0,,Ақырында кедей адамдар
Dialogue: 0,0:03:25.03,0:03:28.37,Default,,0,0,0,,Мен тек тыныштықты армандай бастадым.
Dialogue: 0,0:03:29.04,0:03:31.67,Default,,0,0,0,,Қараңғылық осы жерден туды.
Dialogue: 0,0:03:32.62,0:03:37.63,Default,,0,0,0,,Қараңғылық өз күшін пайдаланып, әлемді екіге бөліп, бір-біріне қарсы қойды.
Dialogue: 0,0:03:38.55,0:03:43.30,Default,,0,0,0,,Ақырында адамдарды өркендеткен ұлы сиқырды бұрмалады.
Dialogue: 0,0:03:43.39,0:03:47.51,Default,,0,0,0,,Сен жер бетінде қорқынышты жын жараттың.
Dialogue: 0,0:03:47.60,0:03:52.27,Default,,0,0,0,,Иә, бұл Антрасакс басқаратын жойылу құдайы.
Dialogue: 0,0:03:52.35,0:03:54.56,Default,,0,0,0,,Бұл зұлым құдайлардың біртүрлі тобы болды.
Dialogue: 0,0:03:59.23,0:04:02.36,Default,,0,0,0,,Сиқыршы алхимик қуанды
Dialogue: 0,0:04:02.45,0:04:07.45,Default,,0,0,0,,Өйткені мен бұл құдай дүниеден соғысты жояды деп ойладым.
Dialogue: 0,0:04:08.87,0:04:09.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.20,0:04:11.79,Default,,0,0,0,,(Азаматтардың үрейлі дауыстары)
Dialogue: 0,0:04:11.87,0:04:14.67,Default,,0,0,0,,Қиратушы құдай Антрасакстың күші
Dialogue: 0,0:04:14.75,0:04:16.08,Default,,0,0,0,,Бұл керемет болды
Dialogue: 0,0:04:17.63,0:04:19.63,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:19.71,0:04:24.93,Default,,0,0,0,,Тауларды аспанға үрлеп, Мұхиттарды қайнаған қанға айналдыр.
Dialogue: 0,0:04:25.01,0:04:29.81,Default,,0,0,0,,Найзағай жаңбыр жауып, жерді жарып жібереді
Dialogue: 0,0:04:29.89,0:04:34.31,Default,,0,0,0,,Олар адам қалаларын су сөндірмейтін отпен өртеп жіберді.
Dialogue: 0,0:04:35.35,0:04:39.86,Default,,0,0,0,,Көптеген қалалар зұлым құдайлардың өте жойқын қабілеттерінен жойылды.
Dialogue: 0,0:04:39.94,0:04:42.95,Default,,0,0,0,,Ұлы соғыстың нәтижесі шешілгендей болды.
Dialogue: 0,0:04:44.91,0:04:49.58,Default,,0,0,0,,Алайда, жеңіске қуанғандарды күтпеген оқиға тудырды...
Dialogue: 0,0:04:49.66,0:04:51.54,Default,,0,0,0,,Жоқ, ол бүкіл адамзатты өлім қорқынышының тереңіне батырды.
Dialogue: 0,0:04:49.66,0:04:51.54,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:04:51.54,0:04:54.67,Default,,0,0,0,,Жоқ, ол бүкіл адамзатты өлім қорқынышының тереңіне батырды.
Dialogue: 0,0:04:55.37,0:05:00.80,Default,,0,0,0,,Күтпеген жерден жойылу құдайы Сібір жарасы адамды жаратушының бұйрығын елемейді.
Dialogue: 0,0:05:00.88,0:05:03.34,Default,,0,0,0,,Ол өз еркімен қозғала бастады.
Dialogue: 0,0:05:03.84,0:05:08.72,Default,,0,0,0,,Бұл жойылу Құдайын жасау үшін сиқырлы түрде синтезделген көптеген жануарлардың бірі.
Dialogue: 0,0:05:08.80,0:05:11.97,Default,,0,0,0,,Тірі адамдардың қосылуынан деп те айтылады.
Dialogue: 0,0:05:12.56,0:05:16.06,Default,,0,0,0,,Сібір жарасы зұлым құдайлар тобын басқарады.
Dialogue: 0,0:05:16.14,0:05:20.98,Default,,0,0,0,,Табиғаттан тыс қабілетімен ол әрбір адамның жүрегіне үн салды.
Dialogue: 0,0:05:21.07,0:05:24.57,Default,,0,0,0,,Біз қирататын еркіміз
Dialogue: 0,0:05:25.24,0:05:29.37,Default,,0,0,0,,Мен түскен жаңа патшамын
Dialogue: 0,0:05:30.03,0:05:34.20,Default,,0,0,0,,Енді мен ақымақ адаммын
Dialogue: 0,0:05:34.29,0:05:37.29,Default,,0,0,0,,Жою туралы үкім
Dialogue: 0,0:05:39.50,0:05:40.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:41.00,0:05:45.42,Default,,0,0,0,,Бұл шынымен де адамзатқа қарсы соғыс жариялау болды.
Dialogue: 0,0:05:46.17,0:05:49.93,Default,,0,0,0,,Барлық адамдар қорқып, жынданып кете жаздады.
Dialogue: 0,0:05:51.01,0:05:55.68,Default,,0,0,0,,Дүниенің әскерлері зұлым құдайды өлтіру үшін бірікті.
Dialogue: 0,0:05:55.77,0:05:58.31,Default,,0,0,0,,Үмітсіз шайқас басталды
Dialogue: 0,0:05:58.90,0:06:02.86,Default,,0,0,0,,Алайда зұлым құдайлардың күші басым болды.
Dialogue: 0,0:06:03.44,0:06:07.20,Default,,0,0,0,,Сол күні жер көп қан жұтқан болуы керек.
Dialogue: 0,0:06:07.74,0:06:10.49,Default,,0,0,0,,Жер бетін жүздеген миллион мәйіттер толтырады
Dialogue: 0,0:06:10.57,0:06:14.79,Default,,0,0,0,,Адамзат өзінің жауыздығынан бұрын жойылу алдында тұрды.
Dialogue: 0,0:06:15.41,0:06:20.04,Default,,0,0,0,,Өйткені зұлым құдайлар осы мақсат үшін жаратылған.
Dialogue: 0,0:06:21.25,0:06:23.46,Default,,0,0,0,,Толығымен жойылған жер бетінде
Dialogue: 0,0:06:23.55,0:06:27.38,Default,,0,0,0,,Бірнеше адам өлуді күтіп тұрды.
Dialogue: 0,0:06:28.18,0:06:32.80,Default,,0,0,0,,Үмітсіз күнәһар да, ақымақ та жай ғана дұға етті.
Dialogue: 0,0:06:33.35,0:06:37.35,Default,,0,0,0,,Бірақ қазір бәрі кеш болды
Dialogue: 0,0:06:38.10,0:06:39.52,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:06:42.73,0:06:49.07,Default,,0,0,0,,Саңыраулық қатты дыбыспен бірге аспанға алтын нұрдың алып бағанасы жетті.
Dialogue: 0,0:06:49.15,0:06:53.16,Default,,0,0,0,,Адамдар оның жерді жарып, шығыс жерінде көтерілгенін көрді.
Dialogue: 0,0:06:53.70,0:06:58.91,Default,,0,0,0,,Сол жарқыраған жарықтан үлкен көлеңке шығады.
Dialogue: 0,0:06:59.00,0:07:01.08,Default,,0,0,0,,Мен зұлымдықтың алдында тұрдым.
Dialogue: 0,0:07:02.63,0:07:07.38,Default,,0,0,0,,Бір ғажабы, оның сыртқы түрі қанаттары жайылған айдаһарға ұқсайды.
Dialogue: 0,0:07:07.46,0:07:10.68,Default,,0,0,0,,Бұл үлкен қылыш ұстаған алып адамға ұқсайды.
Dialogue: 0,0:07:12.18,0:07:13.80,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:14.39,0:07:18.27,Default,,0,0,0,,Ешқандай ескертусіз ұрыс айқайы көтерілді.
Dialogue: 0,0:07:18.35,0:07:20.98,Default,,0,0,0,,Айдаһар жауынгер аспанға қалықтады
Dialogue: 0,0:07:23.77,0:07:28.78,Default,,0,0,0,,Бұл белгі ретінде екі алып мақұлық соғыса бастады.
Dialogue: 0,0:07:30.65,0:07:31.99,Default,,0,0,0,,Екеуі де сияқты
Dialogue: 0,0:07:32.07,0:07:35.74,Default,,0,0,0,,Біз бір-бірімізбен соғысатынымызды білгендей.
Dialogue: 0,0:07:36.91,0:07:38.33,Default,,0,0,0,,О...
Dialogue: 0,0:07:40.58,0:07:44.96,Default,,0,0,0,,Зұлым құдайлар мен айдаһар жауынгерлері арасындағы кескілескен шайқас өте қатты болды.
Dialogue: 0,0:07:45.54,0:07:47.38,Default,,0,0,0,,Жердің осін шайқау
Dialogue: 0,0:07:47.46,0:07:52.22,Default,,0,0,0,,Шайқастың кескілескені сонша, бірнеше құрлық теңізге батып кеткен дейді.
Dialogue: 0,0:07:52.88,0:07:58.31,Default,,0,0,0,,Ақыры ондаған күнге созылған шайқас өз мәресіне жетті.
Dialogue: 0,0:08:04.06,0:08:07.07,Default,,0,0,0,,Айдаһар жауынгерінің соңғы соққысы
Dialogue: 0,0:08:07.15,0:08:10.15,Default,,0,0,0,,Сіз жойылудың қара құдайын жеңдіңіз.
Dialogue: 0,0:08:18.37,0:08:21.45,Default,,0,0,0,,Түтін сейілгенде, адамдар көрді
Dialogue: 0,0:08:21.96,0:08:27.71,Default,,0,0,0,,Айдаһар жауынгері зұлым құдайға төрт белгі қойып, оны жердің тереңіне мөрлейді.
Dialogue: 0,0:08:29.17,0:08:33.80,Default,,0,0,0,,«400 жылдан кейін бұл мөр бұзылады»
Dialogue: 0,0:08:33.88,0:08:36.72,Default,,0,0,0,,«Бірақ менің қанымнан шыққандар»
Dialogue: 0,0:08:36.80,0:08:41.43,Default,,0,0,0,,«Қайтадан айдаһар жауынгері бол және оны жең.»
Dialogue: 0,0:08:42.48,0:08:45.48,Default,,0,0,0,,Бұл сөздер пайғамбарлық кітапта жазылған.
Dialogue: 0,0:08:45.56,0:08:47.31,Default,,0,0,0,,Көп рет көшірілді
Dialogue: 0,0:08:47.40,0:08:50.61,Default,,0,0,0,,Осы континентте әлі де бар төрт құлыптың астында.
Dialogue: 0,0:08:50.69,0:08:53.70,Default,,0,0,0,,Мұқият сақталғаны айтылады.
Dialogue: 0,0:08:55.24,0:08:56.24,Default,,0,0,0,,Сәлем, ата
Dialogue: 0,0:08:56.74,0:09:00.62,Default,,0,0,0,,Жою құдайын жеңген айдаһар жауынгеріне не болды?
Dialogue: 0,0:09:00.70,0:09:04.54,Default,,0,0,0,,«Ұлы соғыс құдайы, қараңғылық қуылды».
Dialogue: 0,0:09:05.42,0:09:09.34,Default,,0,0,0,,Дүние жүзіндегі адамдардың шексіз қуаныштары арасында
Dialogue: 0,0:09:09.84,0:09:14.34,Default,,0,0,0,,Айдаһар жауынгері бір жерде жоғалып кеткен сияқты.
Dialogue: 0,0:09:15.43,0:09:17.18,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:09:17.84,0:09:19.76,Default,,0,0,0,,Енді ұйықтайық.
Dialogue: 0,0:09:20.26,0:09:21.01,Default,,0,0,0,,Иә
Dialogue: 0,0:09:22.35,0:09:23.56,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:09:29.06,0:09:30.90,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:30.98,0:09:31.73,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:09:32.32,0:09:34.74,Default,,0,0,0,,Одан кейін әлемге не болды?
Dialogue: 0,0:09:35.53,0:09:37.95,Default,,0,0,0,,Арғы атамнан естігенім осы.
Dialogue: 0,0:09:38.03,0:09:42.95,Default,,0,0,0,,Жою құдайы мен Айдаһар жауынгері арасындағы шайқаста жердің көп бөлігі су астында қалды.
Dialogue: 0,0:09:43.04,0:09:46.37,Default,,0,0,0,,Сонымен қатар, ескі дүние өркениеттерінің жоғалуына байланысты,
Dialogue: 0,0:09:46.46,0:09:49.21,Default,,0,0,0,,Адамзаттың көпшілігі жойылып кеткен сияқты.
Dialogue: 0,0:09:50.04,0:09:54.97,Default,,0,0,0,,Алайда адамдар ескі дүние өркениеттерінен ерекше сиқыр жасады.
Dialogue: 0,0:09:55.59,0:09:58.51,Default,,0,0,0,,Сиқырлы өркениет жарылыспен тарады.
Dialogue: 0,0:09:58.59,0:10:01.26,Default,,0,0,0,,Шекарада тұратын эльфтер адамдарға қарағанда жақсы.
Dialogue: 0,0:10:01.35,0:10:04.98,Default,,0,0,0,,Мен оның сиқырлы білімі әлдеқайда жоғары екенін естідім.
Dialogue: 0,0:10:05.81,0:10:08.69,Default,,0,0,0,,Қалай болғанда да, сиқырды жасаған адамдар
Dialogue: 0,0:10:08.77,0:10:12.32,Default,,0,0,0,,Осыны пайдалану арқылы біз осы күнге дейін аман қалдық.
Dialogue: 0,0:10:12.40,0:10:13.44,Default,,0,0,0,,(әкесінің жөтелі)
Dialogue: 0,0:10:13.53,0:10:17.36,Default,,0,0,0,,Егер солай болса, сіз төбелесуден басқа ештеңе істеп жатқан жоқсыз.
Dialogue: 0,0:10:17.45,0:10:18.99,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:10:19.07,0:10:22.99,Default,,0,0,0,,Аумаққа, дінге, нәсілге және т.б. даулар міндетті түрде болады.
Dialogue: 0,0:10:23.08,0:10:25.41,Default,,0,0,0,,Біз адам болғандықтан,
Dialogue: 0,0:10:26.04,0:10:28.33,Default,,0,0,0,,Сондықтан да жанжалдан аулақпын
Dialogue: 0,0:10:28.42,0:10:31.25,Default,,0,0,0,,Мен сондай шалғай жерде тұруға келдім.
Dialogue: 0,0:10:31.92,0:10:34.42,Default,,0,0,0,,Сіздің арқаңызда мен осылай өмір сүре аламын.
Dialogue: 0,0:10:35.01,0:10:38.01,Default,,0,0,0,,Әй, сенің айтқаның рас па?
Dialogue: 0,0:10:38.55,0:10:42.26,Default,,0,0,0,,Білмеймін, 400 жыл бұрын болған оқиға.
Dialogue: 0,0:10:42.76,0:10:45.60,Default,,0,0,0,,Дегенмен, осыны көп айтуға болады
Dialogue: 0,0:10:46.10,0:10:48.64,Default,,0,0,0,,«Айдаһар жауынгерлері нағыз»
Dialogue: 0,0:10:48.73,0:10:50.85,Default,,0,0,0,,А, онда мен де білемін.
Dialogue: 0,0:10:51.69,0:10:55.94,Default,,0,0,0,,Мета-Ликана князі Ларс аты аңызға айналған айдаһар жауынгерін шақырады.
Dialogue: 0,0:10:56.03,0:10:59.57,Default,,0,0,0,,Сіз Dark Schneider атты зұлым сиқыршыны жеңдіңіз, солай ма?
Dialogue: 0,0:10:59.65,0:11:02.07,Default,,0,0,0,,Хмм, мен әлі осындамын.
Dialogue: 0,0:11:02.16,0:11:05.04,Default,,0,0,0,,Мета-Ликана ретінде қызмет ету кезінде
Dialogue: 0,0:11:05.12,0:11:09.75,Default,,0,0,0,,Рыцарь орденінің мүшесі айдаһар жауынгерін өз көзімен көргенін айтты.
Dialogue: 0,0:11:10.33,0:11:12.08,Default,,0,0,0,,Аңыз айтқандай болды.
Dialogue: 0,0:11:13.13,0:11:16.34,Default,,0,0,0,,Сауытқа оранған үлкен қанаттары бар дәу
Dialogue: 0,0:11:16.84,0:11:18.63,Default,,0,0,0,,Және үлкен қылыш пен қалқан
Dialogue: 0,0:11:19.13,0:11:21.97,Default,,0,0,0,,Айдаһар жауынгері
Dialogue: 0,0:11:22.05,0:11:25.47,Default,,0,0,0,,Аңыз дұрыс па білмеймін, бірақ
Dialogue: 0,0:11:25.97,0:11:29.27,Default,,0,0,0,,Кем дегенде Айдаһар жауынгері қатысты.
Dialogue: 0,0:11:29.35,0:11:30.85,Default,,0,0,0,,Қате жоқ
Dialogue: 0,0:11:32.15,0:11:37.28,Default,,0,0,0,,Бірақ айдаһар жауынгері де зұлым сиқыршыны жеңе алмады.
Dialogue: 0,0:11:37.36,0:11:40.36,Default,,0,0,0,,Жоқ, мен жеңдім, жеңдім.
Dialogue: 0,0:11:40.99,0:11:42.74,Default,,0,0,0,,Бірақ сіз мұны білмедіңіз.
Dialogue: 0,0:11:43.62,0:11:45.58,Default,,0,0,0,,Зұлым сиқыршының өзі
Dialogue: 0,0:11:45.66,0:11:48.16,Default,,0,0,0,,Ол маған реинкарнация сиқырын жасады.
Dialogue: 0,0:11:50.33,0:11:55.09,Default,,0,0,0,,Мен сәби ретінде қайта дүниеге келген зұлым сиқыршыны таптым⸺
Dialogue: 0,0:11:55.17,0:11:59.80,Default,,0,0,0,,Бес батырдың бірі, Мета-Ликана, Бас діни қызметкер, Гео-сама.
Dialogue: 0,0:11:59.88,0:12:04.09,Default,,0,0,0,,Сәбидің сиқырлы күшін нығыздау үшін әдіс қолданылды.
Dialogue: 0,0:12:04.84,0:12:08.85,Default,,0,0,0,,Зұлым сиқыршы енді ешқашан көтерілмейді.
Dialogue: 0,0:12:08.93,0:12:13.35,Default,,0,0,0,,Пломбаны бұзуды талап ететін жағдай орын алды.
Dialogue: 0,0:12:13.94,0:12:18.69,Default,,0,0,0,,Зұлым сиқыршының көмекшілері қараңғы бүлікшілер әскерін құрайды.
Dialogue: 0,0:12:19.28,0:12:21.53,Default,,0,0,0,,Орктар мен гоблиндерді сарбазға айналдырыңыз
Dialogue: 0,0:12:21.61,0:12:26.45,Default,,0,0,0,,Олар осы құрлықтағы төрт ірі державаға қарсы басқыншылық соғыс ашты.
Dialogue: 0,0:12:28.83,0:12:32.75,Default,,0,0,0,,Мета-Ликана қара бүлікші әскерге қарсы соғысады.
Dialogue: 0,0:12:32.83,0:12:35.88,Default,,0,0,0,,Зұлым сиқыршының мөрін бұзу
Dialogue: 0,0:12:36.46,0:12:38.67,Default,,0,0,0,,Неліктен зұлым сиқыршы?
Dialogue: 0,0:12:38.75,0:12:40.76,Default,,0,0,0,,Қол астыңызда болғандармен соғысып көрдіңіз бе?
Dialogue: 0,0:12:40.84,0:12:43.17,Default,,0,0,0,,Мен де егжей-тегжейлі білмеймін.
Dialogue: 0,0:12:43.26,0:12:47.14,Default,,0,0,0,,Өйткені менің сиқырым жойылып, мен қарапайым адам болып өстім.
Dialogue: 0,0:12:47.22,0:12:50.06,Default,,0,0,0,,Ішінде жақсы жүрек тұрады дейді.
Dialogue: 0,0:12:50.56,0:12:54.85,Default,,0,0,0,,Бірақ соңында Мета-Ликана жойылды.
Dialogue: 0,0:12:54.94,0:12:58.94,Default,,0,0,0,,Қазірдің өзінде қара бүлікші әскер елдерді бірінен соң бірі қиратуда.
Dialogue: 0,0:13:00.28,0:13:02.03,Default,,0,0,0,,Бұл маңызды нәрсе
Dialogue: 0,0:13:02.53,0:13:05.74,Default,,0,0,0,,Бірақ Мета-Ликана мен Яһуданың шекарасында.
Dialogue: 0,0:13:05.82,0:13:09.95,Default,,0,0,0,,Қақтығыстың мұндай шалғай жерге тарағанын қаламаймын.
Dialogue: 0,0:13:11.16,0:13:12.83,Default,,0,0,0,,Сіз қонақсыз ба?
Dialogue: 0,0:13:14.62,0:13:16.62,Default,,0,0,0,,Біраз уақыт болды, Гизун.
Dialogue: 0,0:13:16.71,0:13:17.92,Default,,0,0,0,,Осы кеште...
Dialogue: 0,0:13:18.88,0:13:20.50,Default,,0,0,0,,Мен жаңалық алдым.
Dialogue: 0,0:13:21.00,0:13:24.67,Default,,0,0,0,,А-Иан-Мейде елінің самурай корпусында орналасқан көтерілісшілер әскері
Dialogue: 0,0:13:24.76,0:13:28.51,Default,,0,0,0,,Қараңғы көтеріліс әскерінің басшысы Каль-Суды жеңу үшін.
Dialogue: 0,0:13:28.60,0:13:32.60,Default,,0,0,0,,Бұрынғы Яһуда патшалығының астанасы Типтоаға жаппай шабуыл болатын сияқты.
Dialogue: 0,0:13:33.18,0:13:34.60,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:13:35.10,0:13:36.10,Default,,0,0,0,,О
Dialogue: 0,0:13:36.19,0:13:40.27,Default,,0,0,0,,«Ерік-жігері күштілер көтерілісшілер әскеріне қосылды».
Dialogue: 0,0:13:40.36,0:13:42.86,Default,,0,0,0,,Сондықтан мен сізді шақыруға келдім.
Dialogue: 0,0:13:43.36,0:13:46.11,Default,,0,0,0,,А-Иан-Мейде рыцарь болған саған.
Dialogue: 0,0:13:46.91,0:13:47.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:51.83,0:13:54.58,Default,,0,0,0,,Мен осыдан 10 жыл бұрын қылыш берген адаммын.
Dialogue: 0,0:13:55.08,0:13:56.50,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:13:56.58,0:13:59.92,Default,,0,0,0,,Кеттік. Біз бұл шайқаста міндетті түрде жеңеміз.
Dialogue: 0,0:14:00.42,0:14:05.13,Default,,0,0,0,,Ақыр соңында, бес батырдың екеуі осы жаппай шабуылға қатысады.
Dialogue: 0,0:14:06.80,0:14:08.64,Default,,0,0,0,,А-Иан-Мейдтің самурай шебері
Dialogue: 0,0:14:08.72,0:14:10.93,Default,,0,0,0,,Нилс Шон Мифуне мырзамен
Dialogue: 0,0:14:11.01,0:14:14.97,Default,,0,0,0,,Бұрынғы Мета-Ликананың Бас діни қызметкері Geo Note сұрыптау...
Dialogue: 0,0:14:15.56,0:14:19.48,Default,,0,0,0,,Джи... Гео-доно әлі тірі бола ала ма?
Dialogue: 0,0:14:19.56,0:14:21.69,Default,,0,0,0,,Мен бұл есепті алдым...
Dialogue: 0,0:14:21.77,0:14:23.90,Default,,0,0,0,,Түсіндім, Гео мырза...
Dialogue: 0,0:14:25.15,0:14:28.45,Default,,0,0,0,,Бірге барып, А-Иан-Мейдті қайтарайық.
Dialogue: 0,0:14:31.32,0:14:33.66,Default,,0,0,0,,Әке, үй туралы сұраңыз
Dialogue: 0,0:14:34.37,0:14:35.62,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:14:36.37,0:14:39.21,Default,,0,0,0,,Мен А-Иан-Мейдеге қарыздармын.
Dialogue: 0,0:14:43.38,0:14:45.80,Default,,0,0,0,,Сен кетіп қалдың ба?
Dialogue: 0,0:14:48.88,0:14:50.76,Default,,0,0,0,,Кім жеңеді
Dialogue: 0,0:14:50.84,0:14:52.97,Default,,0,0,0,,Ұлы соғыс
Dialogue: 0,0:14:53.05,0:14:56.39,Default,,0,0,0,,Бұл мен қалаған соңғы нәрсе
Dialogue: 0,0:14:59.69,0:15:02.44,Default,,0,0,0,,Сәлем! Ия, иә, тим
Dialogue: 0,0:15:02.52,0:15:05.07,Default,,0,0,0,,Сен менің бетіме енді ғана бастың.
Dialogue: 0,0:15:05.15,0:15:07.32,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:15:07.40,0:15:10.41,Default,,0,0,0,,Эй, тыңдап тұрсың ба? Дирк Шнайдер Сәлем!
Dialogue: 0,0:15:10.49,0:15:12.70,Default,,0,0,0,,Біріншіден, сен, мен бұл жердің аспанда екеніне сене алмаймын.
Dialogue: 0,0:15:12.78,0:15:15.24,Default,,0,0,0,,Сен үндемедің, солай ма?
Dialogue: 0,0:15:15.33,0:15:18.08,Default,,0,0,0,,Ки... Мука!
Dialogue: 0,0:15:18.16,0:15:21.00,Default,,0,0,0,,Беранми! Мен есінен танып қалдым!
Dialogue: 0,0:15:21.08,0:15:23.59,Default,,0,0,0,,Дәл қазір бүкіл әлем үлкен дағдарыста.
Dialogue: 0,0:15:23.67,0:15:26.30,Default,,0,0,0,,Сіз шынымен мотивация алдыңыз ба? Апыр-ай!
Dialogue: 0,0:15:26.38,0:15:29.38,Default,,0,0,0,,Тітіркендіргіш кішкентай маймыл
Dialogue: 0,0:15:29.47,0:15:32.30,Default,,0,0,0,,Дүниеге не болды? Сіз мұны білесіз бе?
Dialogue: 0,0:15:32.39,0:15:34.01,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:15:34.10,0:15:36.10,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын!
Dialogue: 0,0:15:36.18,0:15:37.60,Default,,0,0,0,,Тоқта, Вай (Лаз) Агия.
Dialogue: 0,0:15:37.68,0:15:40.10,Default,,0,0,0,,Йокоға жабыспа!
Dialogue: 0,0:15:40.18,0:15:43.81,Default,,0,0,0,,Ей, сен маған сүт бересің. Маған сүт берші, Гарруру...
Dialogue: 0,0:15:43.90,0:15:46.61,Default,,0,0,0,,Сәлеметсіз бе? Әлемнің тағдыры қандай?
Dialogue: 0,0:15:46.69,0:15:49.53,Default,,0,0,0,,Басыңызды алыңыз.
Dialogue: 0,0:15:49.61,0:15:51.28,Default,,0,0,0,,Йокоға жақындамаңыз!
Dialogue: 0,0:15:51.36,0:15:53.66,Default,,0,0,0,,«Йоко»?
Dialogue: 0,0:15:53.74,0:15:54.95,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:15:55.45,0:15:58.16,Default,,0,0,0,,Мен сені «Йоко-сан» деп атаймын
Dialogue: 0,0:15:58.24,0:16:01.58,Default,,0,0,0,,Мені әйелім деме
Dialogue: 0,0:16:01.66,0:16:04.00,Default,,0,0,0,,Мен бұл сұмдықты өлтіруім керек пе?
Dialogue: 0,0:16:04.08,0:16:07.30,Default,,0,0,0,,Қарғыс атсын... де! Бұл әзіл емес.
Dialogue: 0,0:16:07.38,0:16:09.30,Default,,0,0,0,,Әйелдің кім екенін кім шешті?
Dialogue: 0,0:16:09.80,0:16:11.30,Default,,0,0,0,,Мен және Йоко Хана
Dialogue: 0,0:16:11.38,0:16:15.80,Default,,0,0,0,,Бір күні киім ауыстыратын бөлмеде жыныстық қатынасқа түсе жаздадық.
Dialogue: 0,0:16:15.89,0:16:17.76,Default,,0,0,0,,Не!
Dialogue: 0,0:16:19.56,0:16:22.35,Default,,0,0,0,,Дахаха! Не болды? Белланми!
Dialogue: 0,0:16:22.44,0:16:26.98,Default,,0,0,0,,Уф... менің демалысымда осындай жағдай болды...
Dialogue: 0,0:16:22.44,0:16:26.98,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:16:27.86,0:16:30.28,Default,,0,0,0,,Не! Өткен күні бұл мен шығармын...
Dialogue: 0,0:16:30.36,0:16:33.82,Default,,0,0,0,,Жуынатын бөлмеде мен Йокомен С болдым.
Dialogue: 0,0:16:34.57,0:16:38.45,Default,,0,0,0,,Нани бірдеңе істемекші болды!
Dialogue: 0,0:16:38.53,0:16:40.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:41.96,0:16:44.33,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:16:44.42,0:16:47.84,Default,,0,0,0,,Әрине, А мұны үнемі жасайды!
Dialogue: 0,0:16:47.92,0:16:50.09,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен және мен
Dialogue: 0,0:16:50.17,0:16:53.34,Default,,0,0,0,,Біз жинаған махаббат тарихы мүлде басқа!
Dialogue: 0,0:16:53.42,0:16:55.18,Default,,0,0,0,,Дирк Шнайдер Ви
Dialogue: 0,0:16:53.42,0:16:55.18,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:16:55.18,0:16:55.26,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:16:55.26,0:16:57.39,Default,,0,0,0,,Иә? Тез қаш!
Dialogue: 0,0:16:55.26,0:16:57.39,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:16:57.47,0:17:00.14,Default,,0,0,0,,А? Дауысы сонша, мен оны естімеймін
Dialogue: 0,0:16:57.47,0:17:00.14,Default,,0,0,0,,(қозғалтқыш дыбысын арттыру)
Dialogue: 0,0:17:00.14,0:17:00.22,Default,,0,0,0,,(қозғалтқыш дыбысын арттыру)
Dialogue: 0,0:17:00.22,0:17:02.77,Default,,0,0,0,,Бұл өте тітіркендіргіш. Мен баратынмын...
Dialogue: 0,0:17:00.22,0:17:02.77,Default,,0,0,0,,(қозғалтқыш дыбысын арттыру)
Dialogue: 0,0:17:02.77,0:17:04.23,Default,,0,0,0,,Бұл өте тітіркендіргіш. Мен баратынмын...
Dialogue: 0,0:17:04.31,0:17:05.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:05.44,0:17:06.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:06.90,0:17:09.32,Default,,0,0,0,,Цк
Dialogue: 0,0:17:09.40,0:17:11.99,Default,,0,0,0,,Тістеріңді қайраңдар!
Dialogue: 0,0:17:12.07,0:17:13.95,Default,,0,0,0,,Не болды!
Dialogue: 0,0:17:14.03,0:17:17.87,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:17:17.95,0:17:18.62,Default,,0,0,0,,Гухе
Dialogue: 0,0:17:19.99,0:17:22.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:22.20,0:17:24.50,Default,,0,0,0,,Уф... Люс!
Dialogue: 0,0:17:24.58,0:17:26.33,Default,,0,0,0,,Қараңыз! Әлі түсіп жатыр
Dialogue: 0,0:17:26.87,0:17:27.92,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:17:28.00,0:17:30.50,Default,,0,0,0,,Жын жауынгері... бұл олардың дирижаблиі.
Dialogue: 0,0:17:31.09,0:17:34.09,Default,,0,0,0,,Әрбір кеме бірінен соң бірі соғылып, соғылады.
Dialogue: 0,0:17:34.17,0:17:35.34,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:17:35.43,0:17:37.97,Default,,0,0,0,,Ой... мінекей!
Dialogue: 0,0:17:38.05,0:17:39.39,Default,,0,0,0,,Айдаһар!
Dialogue: 0,0:17:43.39,0:17:45.23,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:46.35,0:17:49.36,Default,,0,0,0,,Кримсон Даңқының қамқоршысы?
Dialogue: 0,0:17:49.44,0:17:52.94,Default,,0,0,0,,дирижабльді сол айдаһар өлтірген сияқты.
Dialogue: 0,0:17:53.03,0:17:54.32,Default,,0,0,0,,Ах~аа~
Dialogue: 0,0:17:54.40,0:17:57.91,Default,,0,0,0,,дирижабльді атып түсіріп, тапсырмасын орындап, ұшып кетіңіз
Dialogue: 0,0:17:58.49,0:18:00.32,Default,,0,0,0,,О! Бұл...
Dialogue: 0,0:18:00.83,0:18:05.37,Default,,0,0,0,,Король Қырмызы Даңқты қоршап тұрған бұлттар жоғалып кетеді.
Dialogue: 0,0:18:07.92,0:18:08.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:10.00,0:18:12.42,Default,,0,0,0,,А... не? Яғни
Dialogue: 0,0:18:18.63,0:18:21.47,Default,,0,0,0,,Люс! Люс!
Dialogue: 0,0:18:22.35,0:18:23.47,Default,,0,0,0,,Люс...
Dialogue: 0,0:18:24.31,0:18:25.31,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:18:27.89,0:18:30.65,Default,,0,0,0,,Люс жаншып кетті
Dialogue: 0,0:18:31.73,0:18:33.19,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:18:33.94,0:18:35.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:35.19,0:18:36.49,Default,,0,0,0,,（）
Dialogue: 0,0:18:37.24,0:18:39.41,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:18:40.41,0:18:42.16,Default,,0,0,0,,Ах... Ичичи
Dialogue: 0,0:18:42.24,0:18:44.24,Default,,0,0,0,,Ол шынымен қамқор бала.
Dialogue: 0,0:18:44.33,0:18:47.08,Default,,0,0,0,,Кааааааааааааааааааааааааааааа!
Dialogue: 0,0:18:47.16,0:18:49.21,Default,,0,0,0,,Сондықтан мен балаларды жек көремін
Dialogue: 0,0:18:49.29,0:18:50.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:50.12,0:18:52.00,Default,,0,0,0,,Нана... Нана... Нана Нана
Dialogue: 0,0:18:52.08,0:18:53.46,Default,,0,0,0,,Нанана…
Dialogue: 0,0:18:53.54,0:18:54.96,Default,,0,0,0,,А, бұл не?
Dialogue: 0,0:18:55.55,0:18:57.26,Default,,0,0,0,,Руше қиылысады?
Dialogue: 0,0:18:57.34,0:18:58.67,Default,,0,0,0,,Бұл жігіт!
Dialogue: 0,0:18:58.76,0:18:59.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:59.93,0:19:01.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.89,0:19:04.22,Default,,0,0,0,,Жарайды, біріктірейік!
Dialogue: 0,0:19:04.31,0:19:05.93,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:19:07.10,0:19:08.94,Default,,0,0,0,,Құрастыру!
Dialogue: 0,0:19:09.73,0:19:11.85,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:19:11.94,0:19:13.82,Default,,0,0,0,,Жаңғыру!
Dialogue: 0,0:19:13.90,0:19:17.74,Default,,0,0,0,,Өте әдемі! Дирк Шнайдер!
Dialogue: 0,0:19:18.36,0:19:19.78,Default,,0,0,0,,Не?
Dialogue: 0,0:19:21.03,0:19:23.24,Default,,0,0,0,,Ха… ха ха…
Dialogue: 0,0:19:23.32,0:19:26.08,Default,,0,0,0,,Қандай боқтық дене, уф.
Dialogue: 0,0:19:27.87,0:19:28.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:28.79,0:19:31.17,Default,,0,0,0,,Те... Тем Дирк Шнайдер
Dialogue: 0,0:19:31.25,0:19:34.04,Default,,0,0,0,,Мені көзге лақтырасың!
Dialogue: 0,0:19:34.13,0:19:35.88,Default,,0,0,0,,Қайда қарап тұрсың? Гуггаааааааааааааааааа
Dialogue: 0,0:19:35.96,0:19:38.30,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:19:38.38,0:19:40.88,Default,,0,0,0,,Олардың барлық дирижабльдері біздікінен жақсы.
Dialogue: 0,0:19:40.97,0:19:44.01,Default,,0,0,0,,Мен Шейла тұрған ғибадатхананың жанына қондым.
Dialogue: 0,0:19:44.10,0:19:45.05,Default,,0,0,0,,Га
Dialogue: 0,0:19:46.18,0:19:49.02,Default,,0,0,0,,Бірақ... Бірақ сол күйге қарап...
Dialogue: 0,0:19:49.10,0:19:51.44,Default,,0,0,0,,Ешкім құтқарылады деп ойламаймын...
Dialogue: 0,0:19:51.52,0:19:54.36,Default,,0,0,0,,Бұл жағдай төмендегеннен гөрі төмендеді.
Dialogue: 0,0:19:54.90,0:19:57.23,Default,,0,0,0,,Хе! Жын соғысы генерал жігіттер
Dialogue: 0,0:19:57.32,0:19:59.24,Default,,0,0,0,,Мені айдаһар өлтірді.
Dialogue: 0,0:19:59.32,0:20:01.28,Default,,0,0,0,,Хаха, бұл жақсы сезіледі.
Dialogue: 0,0:20:01.36,0:20:04.20,Default,,0,0,0,,Бұл адам олардың арасында болды ма?
Dialogue: 0,0:20:04.82,0:20:07.37,Default,,0,0,0,,Тіпті егер демон жауынгері аман қалса да,
Dialogue: 0,0:20:07.45,0:20:08.87,Default,,0,0,0,,Ауыр жарақаттар сөзсіз.
Dialogue: 0,0:20:09.41,0:20:11.16,Default,,0,0,0,,Шейла ханшайым тұрған ғибадатханаға барайық.
Dialogue: 0,0:20:11.25,0:20:13.71,Default,,0,0,0,,Ей, ақымақ, қатынның баласы.
Dialogue: 0,0:20:15.08,0:20:17.09,Default,,0,0,0,,Көздерің ойық па?
Dialogue: 0,0:20:17.63,0:20:19.05,Default,,0,0,0,,Эй, шық!
Dialogue: 0,0:20:19.13,0:20:21.97,Default,,0,0,0,,Ол сонда жасырынып жүр!
Dialogue: 0,0:20:22.05,0:20:23.43,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:20:25.01,0:20:28.10,Default,,0,0,0,,Хехехе... Олай емес.
Dialogue: 0,0:20:28.18,0:20:30.68,Default,,0,0,0,,Бұл дауыс қайда? Сен қайдасың?
Dialogue: 0,0:20:31.27,0:20:34.48,Default,,0,0,0,,Ұлы сиқыршы Дирк Шнайдерден күткендей
Dialogue: 0,0:20:35.06,0:20:38.19,Default,,0,0,0,,Жақсы жұмыс, мен өз көлеңкемнің бар екенін көрдім.
Dialogue: 0,0:20:38.27,0:20:39.90,Default,,0,0,0,,Көлеңке бар ма?
Dialogue: 0,0:20:40.48,0:20:42.40,Default,,0,0,0,,Бұл күтпеген жағдай
Dialogue: 0,0:20:42.95,0:20:46.37,Default,,0,0,0,,Хэхехехе, енді біз кездесіп қалдық
Dialogue: 0,0:20:46.45,0:20:49.37,Default,,0,0,0,,Мен сені сол ғибадатханаға жібере алмаймын.
Dialogue: 0,0:20:50.24,0:20:55.58,Default,,0,0,0,,Shadow User Demon Battle General Bol Gil Bol сапары
Dialogue: 0,0:20:56.29,0:20:58.09,Default,,0,0,0,,(Суралған қылыштың дыбысы)
Dialogue: 0,0:20:58.17,0:21:01.13,Default,,0,0,0,,Көлеңкелік пайдаланушы? Бұл дұрыс
Dialogue: 0,0:21:01.21,0:21:05.01,Default,,0,0,0,,Ол барлық көлеңкелерді еркін басқара алады.
Dialogue: 0,0:21:05.09,0:21:07.30,Default,,0,0,0,,Бұл бейбақ салқын болуға тырысады.
Dialogue: 0,0:21:07.39,0:21:11.10,Default,,0,0,0,,Байқамай секірмеңіз, қарсыласыңыз жын генерал.
Dialogue: 0,0:21:11.18,0:21:14.31,Default,,0,0,0,,О, сен Кай Хан емессің бе?
Dialogue: 0,0:21:14.39,0:21:18.15,Default,,0,0,0,,Шин Хари бірдей емес пе? Ран-доно өзінің қауіпсіздігіне алаңдайды...
Dialogue: 0,0:21:18.23,0:21:20.36,Default,,0,0,0,,Өте таза сөйлейді.
Dialogue: 0,0:21:20.44,0:21:22.07,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:21:22.74,0:21:25.40,Default,,0,0,0,,Сіз бұған қарсы жеңе алмайсыз.
Dialogue: 0,0:21:25.49,0:21:27.37,Default,,0,0,0,,Әрине, тіпті самурай да.
Dialogue: 0,0:21:27.45,0:21:28.53,Default,,0,0,0,,Не?
Dialogue: 0,0:21:30.33,0:21:31.54,Default,,0,0,0,,Сәлем, Ларс
Dialogue: 0,0:21:31.62,0:21:33.12,Default,,0,0,0,,Тыңдап тұрсың ба, Ларс?
Dialogue: 0,0:21:33.20,0:21:35.83,Default,,0,0,0,,Менің басымда жаңғырған дауыс
Dialogue: 0,0:21:35.92,0:21:36.75,Default,,0,0,0,,Телепатия?
Dialogue: 0,0:21:36.83,0:21:38.79,Default,,0,0,0,,Дирк Шнайдер не болды?
Dialogue: 0,0:21:39.38,0:21:43.26,Default,,0,0,0,,Іс жүзінде жағдай біршама нашар болды.
Dialogue: 0,0:21:43.76,0:21:44.76,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:21:45.72,0:21:47.84,Default,,0,0,0,,Көрмейді
Dialogue: 0,0:21:47.93,0:21:51.76,Default,,0,0,0,,Мен оны мүлдем көрмеймін Мен оны мүлдем көрмеймін Мен оны мүлдем көрмеймін
Dialogue: 0,0:21:51.85,0:21:55.39,Default,,0,0,0,,Хм, ертерек дирижабль соққан соққыдан шығар.
Dialogue: 0,0:21:55.48,0:21:56.81,Default,,0,0,0,,Угиджи
Dialogue: 0,0:21:56.89,0:22:02.23,Default,,0,0,0,,Не... Не... Не?!
Dialogue: 0,0:22:03.07,0:22:05.24,Default,,0,0,0,,Фу... хехехе
Dialogue: 0,0:22:05.86,0:22:09.20,Default,,0,0,0,,Король Кримсон Глоридің орны анықталды.
Dialogue: 0,0:22:09.78,0:22:13.41,Default,,0,0,0,,Мен соңғы мөрді таптым.
Dialogue: 0,0:22:14.00,0:22:17.29,Default,,0,0,0,,Хехе... хахаха...
Dialogue: 0,0:22:17.37,0:22:19.71,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:22:21.34,0:22:23.34,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.17,0:23:50.17,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.67,0:23:57.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory