Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.51,0:00:19.18,Default,,0,0,0,,Емдеу аяқталды.
Dialogue: 0,0:00:19.68,0:00:21.85,Default,,0,0,0,,Сіз бірнеше күн ішінде толық емделесіз.
Dialogue: 0,0:00:21.93,0:00:24.06,Default,,0,0,0,,Кешіріңіз Рахмет
Dialogue: 0,0:00:24.14,0:00:27.44,Default,,0,0,0,,А... жаңа ғана аспаннан ұшып өткен бұл қандай материк еді?
Dialogue: 0,0:00:27.94,0:00:30.28,Default,,0,0,0,,Король Кримсон Даңқы
Dialogue: 0,0:00:30.36,0:00:32.49,Default,,0,0,0,,Бұл эльфтердің қалқымалы қаласы.
Dialogue: 0,0:00:32.99,0:00:36.49,Default,,0,0,0,,Алайда ол баяғыда жойылды.
Dialogue: 0,0:00:36.57,0:00:39.20,Default,,0,0,0,,Түсіндім, бұл аңыз...
Dialogue: 0,0:00:39.28,0:00:42.25,Default,,0,0,0,,Эй, қарным ашты. Маған жейтін бірдеңе жасап берші.
Dialogue: 0,0:00:42.33,0:00:43.58,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:00:44.33,0:00:46.63,Default,,0,0,0,,Бұл Баторидің ой қатесі
Dialogue: 0,0:00:48.88,0:00:51.63,Default,,0,0,0,,Бұл Макапан, бұл Бассоли.
Dialogue: 0,0:00:52.26,0:00:55.47,Default,,0,0,0,,Көтерілісшілер әскері Типтоа Яһуда сарайына қарай жүрісін бастады.
Dialogue: 0,0:00:55.55,0:00:56.80,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:00:56.89,0:01:00.14,Default,,0,0,0,,Лорд Кал, оның сүйемелдеушісі Шерадан басқа жын соғысының генералдары.
Dialogue: 0,0:01:00.22,0:01:02.22,Default,,0,0,0,,Барлығы қамалдан шықты.
Dialogue: 0,0:01:02.73,0:01:05.06,Default,,0,0,0,,Макапин, қамалға қарай жүр!
Dialogue: 0,0:01:05.14,0:01:07.35,Default,,0,0,0,,Кальді бірге қорғайық.
Dialogue: 0,0:01:08.19,0:01:09.69,Default,,0,0,0,,Уа, не болды?
Dialogue: 0,0:01:10.19,0:01:13.03,Default,,0,0,0,,Менің шұғыл жұмысым бар. Кешіріңіз.
Dialogue: 0,0:01:15.57,0:01:19.58,Default,,0,0,0,,Лорд Кал миссиямды орындамағаным үшін мені ешқашан кешірмейді.
Dialogue: 0,0:01:20.33,0:01:24.33,Default,,0,0,0,,Бірақ бұл менің өміріме қымбат болса да, мен міндетті түрде Кал-саманы беремін!
Dialogue: 0,0:01:27.83,0:01:29.84,Default,,0,0,0,,♪～
Dialogue: 0,0:02:53.00,0:02:55.00,Default,,0,0,0,,～♪
Dialogue: 0,0:02:58.30,0:03:00.05,Default,,0,0,0,,Кола Луше!
Dialogue: 0,0:03:00.13,0:03:02.43,Default,,0,0,0,,Ей, жалғыз барма.
Dialogue: 0,0:03:02.51,0:03:03.68,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:03:03.76,0:03:06.43,Default,,0,0,0,,Жын генералдары ғибадатханаға бара жатыр.
Dialogue: 0,0:03:06.52,0:03:08.10,Default,,0,0,0,,Мен Шейла ханшайымын қорғауым керек.
Dialogue: 0,0:03:08.18,0:03:09.43,Default,,0,0,0,,О!
Dialogue: 0,0:03:10.52,0:03:12.65,Default,,0,0,0,,Не! Мына суық ауа ше?
Dialogue: 0,0:03:12.73,0:03:15.44,Default,,0,0,0,,Суық... Суық...
Dialogue: 0,0:03:15.52,0:03:19.15,Default,,0,0,0,,Ах! Бұл шынымен...
Dialogue: 0,0:03:19.24,0:03:20.24,Default,,0,0,0,,Агия
Dialogue: 0,0:03:20.32,0:03:22.57,Default,,0,0,0,,Эй...ол келе жатыр, Дирк Шнайдер.
Dialogue: 0,0:03:23.07,0:03:25.95,Default,,0,0,0,,Бәрің де осында болдыңдар ма?
Dialogue: 0,0:03:28.79,0:03:30.21,Default,,0,0,0,,Кал?
Dialogue: 0,0:03:30.29,0:03:32.67,Default,,0,0,0,,Қал Бұл адам?
Dialogue: 0,0:03:32.75,0:03:35.67,Default,,0,0,0,,Қараңғы көтеріліс әскерінің тиімді билеушісі
Dialogue: 0,0:03:36.21,0:03:37.84,Default,,0,0,0,,Мұздың жоғары патшасы!
Dialogue: 0,0:03:38.71,0:03:40.84,Default,,0,0,0,,А, а... солай.
Dialogue: 0,0:03:40.92,0:03:43.55,Default,,0,0,0,,Құрметті Каль, мұнда қалай келдіңіз?
Dialogue: 0,0:03:43.64,0:03:46.64,Default,,0,0,0,,Лордтар иеленген «Әлемнің көзі».
Dialogue: 0,0:03:46.72,0:03:48.72,Default,,0,0,0,,Жоюшы Құдаймен байланысты
Dialogue: 0,0:03:49.35,0:03:52.56,Default,,0,0,0,,Сіздің арқаңызда мен осы қаланың координаталарын таба алдым.
Dialogue: 0,0:03:53.23,0:03:57.07,Default,,0,0,0,,Ух, табу мүмкін емес деген сиқырлы жер.
Dialogue: 0,0:03:57.15,0:04:00.99,Default,,0,0,0,,Мен King Crimson Glory-ге еш қиындықсыз кіре алдым.
Dialogue: 0,0:04:01.07,0:04:03.57,Default,,0,0,0,,Соңғы пломбаны бұзудың маңызды рөлі
Dialogue: 0,0:04:04.07,0:04:08.29,Default,,0,0,0,,Сіз жын соғысының генералы ретінде қызмет етем деп шындап ойладыңыз ба?
Dialogue: 0,0:04:08.37,0:04:09.95,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:04:10.04,0:04:11.46,Default,,0,0,0,,Кал…
Dialogue: 0,0:04:12.00,0:04:15.75,Default,,0,0,0,,Иә, сіз Дирк Шнайдерсіз бе?
Dialogue: 0,0:04:15.83,0:04:17.21,Default,,0,0,0,,Не?
Dialogue: 0,0:04:17.29,0:04:20.30,Default,,0,0,0,,Сіз мені осы уақытқа дейін көп қорғаған сияқтысыз.
Dialogue: 0,0:04:20.80,0:04:22.93,Default,,0,0,0,,Бірақ бұл мені көп қиындықтан құтқарды.
Dialogue: 0,0:04:23.43,0:04:25.84,Default,,0,0,0,,Шейладан пломбаны тартпас бұрын
Dialogue: 0,0:04:26.43,0:04:30.06,Default,,0,0,0,,Сібір жарасына етіңді, қаныңды құрбан етейік.
Dialogue: 0,0:04:31.06,0:04:33.98,Default,,0,0,0,,Бернард Уолтер Уорнердрехер
Dialogue: 0,0:04:34.06,0:04:38.52,Default,,0,0,0,,Су, рухқа толы бол! Менің жауым сенсің
Dialogue: 0,0:04:38.61,0:04:40.73,Default,,0,0,0,,Уау! Бұл сиқыр
Dialogue: 0,0:04:40.82,0:04:43.24,Default,,0,0,0,,Мен оны қойдым
Dialogue: 0,0:04:43.32,0:04:46.87,Default,,0,0,0,,Төтенше сұлу адамды кездестіргенде, «Уау!» деп ойламай қалдым...
Dialogue: 0,0:04:47.74,0:04:48.95,Default,,0,0,0,,Ми… су.
Dialogue: 0,0:04:49.03,0:04:50.58,Default,,0,0,0,,Атқылап жатыр!
Dialogue: 0,0:04:50.66,0:04:53.04,Default,,0,0,0,,Ка... Кал-сама~!
Dialogue: 0,0:04:53.96,0:04:55.17,Default,,0,0,0,,Император су айдаһар сарқырамасы (Aku Seas)!
Dialogue: 0,0:04:57.79,0:05:00.92,Default,,0,0,0,,Әй, ол супер су қысымымен жаншылады.
Dialogue: 0,0:05:01.63,0:05:04.13,Default,,0,0,0,,Ұсқынсыз жәндіктер
Dialogue: 0,0:05:04.22,0:05:09.05,Default,,0,0,0,,Не...? маған қарай
Dialogue: 0,0:05:09.14,0:05:11.89,Default,,0,0,0,,Сіз Кальдың алдында тұрсыз!
Dialogue: 0,0:05:12.52,0:05:14.64,Default,,0,0,0,,Өте қараңғы Шнайдер сәулесі!
Dialogue: 0,0:05:14.73,0:05:15.94,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:05:16.02,0:05:18.11,Default,,0,0,0,,Қасиетті бомба (Хроминг заңы)!
Dialogue: 0,0:05:20.27,0:05:22.40,Default,,0,0,0,,Yahooooooooo!
Dialogue: 0,0:05:22.48,0:05:24.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:24.11,0:05:27.74,Default,,0,0,0,,Әй, сен мына сұмдық күшті көрдің бе?
Dialogue: 0,0:05:27.82,0:05:32.29,Default,,0,0,0,,Ол жаққа көшпе, мен сені қазір өлтіремін...
Dialogue: 0,0:05:36.62,0:05:40.29,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:05:40.38,0:05:42.38,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:05:44.55,0:05:47.38,Default,,0,0,0,,Мен ешкімге керек емеспін
Dialogue: 0,0:05:48.01,0:05:49.93,Default,,0,0,0,,Жарайды, мен алып кетейін.
Dialogue: 0,0:05:50.01,0:05:52.01,Default,,0,0,0,,Бүгіннен бастап менікі бол
Dialogue: 0,0:05:53.02,0:05:55.35,Default,,0,0,0,,Ко… Kora Тоқта.
Dialogue: 0,0:05:55.43,0:05:57.64,Default,,0,0,0,,Қарғыс атсын, мұны маған неге көрсетіп тұрсың?
Dialogue: 0,0:06:06.15,0:06:10.16,Default,,0,0,0,,Әй, енді соңғы мөр ғана қалды.
Dialogue: 0,0:06:10.87,0:06:13.20,Default,,0,0,0,,Не? Бұл не жарылыс болды?
Dialogue: 0,0:06:13.29,0:06:14.37,Default,,0,0,0,,Жақын
Dialogue: 0,0:06:14.45,0:06:17.25,Default,,0,0,0,,Хмм, бұл самурай болуы мүмкін бе?
Dialogue: 0,0:06:17.33,0:06:20.50,Default,,0,0,0,,Не істеу керек? Сіз ғибадатханаға барасыз ба?
Dialogue: 0,0:06:20.58,0:06:22.21,Default,,0,0,0,,Немесе бірінші...
Dialogue: 0,0:06:23.17,0:06:25.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:28.34,0:06:30.34,Default,,0,0,0,,Ммммм...
Dialogue: 0,0:06:30.43,0:06:33.47,Default,,0,0,0,,Бұл бір нәрсенің басы.
Dialogue: 0,0:06:33.56,0:06:37.93,Default,,0,0,0,,Оның үстіне бұл жұмбақ энергия қарапайым нәрсе емес.
Dialogue: 0,0:06:38.02,0:06:39.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:42.19,0:06:43.40,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:06:43.48,0:06:46.03,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:06:46.11,0:06:48.11,Default,,0,0,0,,Сәлем... Ханшайым!
Dialogue: 0,0:06:48.20,0:06:51.41,Default,,0,0,0,,Баба, бұл не...
Dialogue: 0,0:06:51.49,0:06:53.58,Default,,0,0,0,,Ха! Мета-Ликана ше?
Dialogue: 0,0:06:53.66,0:06:55.79,Default,,0,0,0,,Әй, ханшайым...
Dialogue: 0,0:06:55.87,0:06:57.91,Default,,0,0,0,,О, ханшайым...
Dialogue: 0,0:06:58.00,0:07:01.25,Default,,0,0,0,,Ханшайым оянды.
Dialogue: 0,0:07:01.33,0:07:02.33,Default,,0,0,0,,Баба
Dialogue: 0,0:07:04.34,0:07:06.46,Default,,0,0,0,,Ми... Бәрі жақсы ма?
Dialogue: 0,0:07:06.55,0:07:10.97,Default,,0,0,0,,Ауырсын, Хидеко істеп жатыр.
Dialogue: 0,0:07:11.05,0:07:12.89,Default,,0,0,0,,Калус есімді адам
Dialogue: 0,0:07:12.97,0:07:17.56,Default,,0,0,0,,Өте мейірімді, ақылды адам деп еститінмін.
Dialogue: 0,0:07:17.64,0:07:20.64,Default,,0,0,0,,Қайда? Олар бүкіл аймақты шатастырып жатыр!
Dialogue: 0,0:07:21.14,0:07:23.90,Default,,0,0,0,,Бірақ мұндай трагедиямен
Dialogue: 0,0:07:23.98,0:07:25.90,Default,,0,0,0,,Неліктен біз әлі де тіріміз?
Dialogue: 0,0:07:27.36,0:07:28.90,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:07:28.99,0:07:30.32,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:07:30.86,0:07:31.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:31.95,0:07:34.57,Default,,0,0,0,,Неге сен жалғызсың мұндай тоз-тозы...
Dialogue: 0,0:07:34.66,0:07:36.79,Default,,0,0,0,,Мен бізді күтпедім...
Dialogue: 0,0:07:36.87,0:07:38.50,Default,,0,0,0,,Сен мені қорғадың ба?
Dialogue: 0,0:07:39.00,0:07:42.54,Default,,0,0,0,,Сіз... қалайсыз ба? Бұл адам ...
Dialogue: 0,0:07:42.62,0:07:43.54,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:07:43.63,0:07:45.21,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:07:45.29,0:07:46.29,Default,,0,0,0,,Бол!
Dialogue: 0,0:07:46.88,0:07:50.38,Default,,0,0,0,,Сіз бірге әрекет етіп жүргенде, бұл адам...
Dialogue: 0,0:07:50.47,0:07:54.55,Default,,0,0,0,,Жоқ, сіз бұл адамды мүлде түсінбейсіз!
Dialogue: 0,0:07:55.05,0:07:56.18,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:07:57.18,0:07:58.64,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:07:59.14,0:08:01.98,Default,,0,0,0,,Бұл заклинание Каль-саманың құпия әдістерінің бірі болса да.
Dialogue: 0,0:08:02.06,0:08:05.11,Default,,0,0,0,,Бұл адам қаласа қашып кетуі мүмкін еді.
Dialogue: 0,0:08:05.94,0:08:09.36,Default,,0,0,0,,Бұнымен қақтығысудың не қажеті бар?
Dialogue: 0,0:08:09.99,0:08:12.32,Default,,0,0,0,,Бірақ бұл маған соқтығысты.
Dialogue: 0,0:08:12.82,0:08:15.95,Default,,0,0,0,,Ұрыста жарақат алған денемен
Dialogue: 0,0:08:16.66,0:08:19.20,Default,,0,0,0,,Неге екенін білесің бе, балақай?
Dialogue: 0,0:08:19.29,0:08:23.04,Default,,0,0,0,,Қашып кетсең, сен де, достарың да өлесің.
Dialogue: 0,0:08:23.12,0:08:24.29,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:24.88,0:08:25.88,Default,,0,0,0,,Люс...
Dialogue: 0,0:08:27.29,0:08:29.30,Default,,0,0,0,,Жеңіске жету үшін Кал-сама
Dialogue: 0,0:08:29.38,0:08:30.96,Default,,0,0,0,,Сіз осылай істейсіз
Dialogue: 0,0:08:31.05,0:08:32.42,Default,,0,0,0,,Мен оны өшіруге тырыстым, бірақ
Dialogue: 0,0:08:32.51,0:08:35.72,Default,,0,0,0,,Бұл адам оны қорғау үшін өз өмірін қатерге тіккен.
Dialogue: 0,0:08:35.80,0:08:40.64,Default,,0,0,0,,Көрінбейтін көзді одан әрі итеріп, оған қарсы күрескен сол ерлік.
Dialogue: 0,0:08:40.72,0:08:43.27,Default,,0,0,0,,Бұл адам нағыз генерал.
Dialogue: 0,0:08:43.35,0:08:46.69,Default,,0,0,0,,Әй... күте тұршы, көздерің... көздеріңе не болды?
Dialogue: 0,0:08:46.77,0:08:48.77,Default,,0,0,0,,Сен өте шулысың! Жүйкеме тиіп барасың.
Dialogue: 0,0:08:49.27,0:08:51.44,Default,,0,0,0,,Сіздің достарыңыз білмей ме?
Dialogue: 0,0:08:51.94,0:08:56.28,Default,,0,0,0,,Бұл кісінің көзі дәл қазір көрмейтінін білмейсің бе?
Dialogue: 0,0:08:56.36,0:09:02.25,Default,,0,0,0,,(Ино) Бұл соңғы кезде Шығыс Одақтың жастары арасында өте танымал ғылыми-фантастикалық сахна —
Dialogue: 0,0:09:10.05,0:09:12.55,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:13.47,0:09:15.97,Default,,0,0,0,,Бізді пісіп-жетілмегендер түсінбесін.
Dialogue: 0,0:09:16.47,0:09:18.22,Default,,0,0,0,,Осындай жеккөрінішті сөздер...
Dialogue: 0,0:09:18.76,0:09:21.10,Default,,0,0,0,,Менің көзім көрмей қалды.
Dialogue: 0,0:09:21.18,0:09:22.68,Default,,0,0,0,,Олай емес, ол кезде
Dialogue: 0,0:09:23.73,0:09:26.65,Default,,0,0,0,,Мен сізге тағы да үлкен қарыздармын.
Dialogue: 0,0:09:27.15,0:09:29.15,Default,,0,0,0,,Біз осы адам туралы айтып отырмыз.
Dialogue: 0,0:09:29.23,0:09:30.65,Default,,0,0,0,,Сіз дұрыс түсінбедіңіз деп ойлаймын.
Dialogue: 0,0:09:31.98,0:09:34.99,Default,,0,0,0,,Мен бұл адамды неге сонша жек көрдім?
Dialogue: 0,0:09:36.11,0:09:37.45,Default,,0,0,0,,Сен жақсы адам емессің бе!
Dialogue: 0,0:09:37.95,0:09:40.16,Default,,0,0,0,,Ол әлемдегі ең жақсы адам!
Dialogue: 0,0:09:41.20,0:09:44.33,Default,,0,0,0,,Уф... уф... Вай
Dialogue: 0,0:09:44.41,0:09:46.62,Default,,0,0,0,,Қызық, бұл шынымен не?
Dialogue: 0,0:09:47.37,0:09:48.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:49.00,0:09:52.92,Default,,0,0,0,,Ей, шіркін, шіркін.
Dialogue: 0,0:09:53.80,0:09:55.55,Default,,0,0,0,,О, мен ояндым.
Dialogue: 0,0:09:55.63,0:09:56.68,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:09:56.76,0:09:57.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:58.05,0:10:01.14,Default,,0,0,0,,Сен ақымақсың!
Dialogue: 0,0:10:01.22,0:10:03.43,Default,,0,0,0,,Дирк Шнайдерге жарайсың.
Dialogue: 0,0:10:03.52,0:10:06.10,Default,,0,0,0,,Сіз қолыңызды көтердіңіз!
Dialogue: 0,0:10:07.02,0:10:08.98,Default,,0,0,0,,Ларс, маған жол көрсет!
Dialogue: 0,0:10:09.06,0:10:10.31,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:11.02,0:10:15.24,Default,,0,0,0,,Мен сені кешірмеймін! Мен сені өлтіремін!
Dialogue: 0,0:10:18.03,0:10:19.82,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:10:19.91,0:10:20.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.74,0:10:27.12,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:10:27.21,0:10:29.21,Default,,0,0,0,,Оны таптым, Шейла.
Dialogue: 0,0:10:29.79,0:10:32.34,Default,,0,0,0,,Енді дүние тозаққа айналады
Dialogue: 0,0:10:32.42,0:10:33.42,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:10:33.50,0:10:37.05,Default,,0,0,0,,Бұйрала!
Dialogue: 0,0:10:37.13,0:10:38.30,Default,,0,0,0,,Агия...
Dialogue: 0,0:10:38.38,0:10:40.39,Default,,0,0,0,,Сәл солға қарай, Дирк Шнайдер
Dialogue: 0,0:10:40.47,0:10:44.06,Default,,0,0,0,,«Әдемі қараңғы Шнайдер» деңіз!
Dialogue: 0,0:10:44.14,0:10:45.47,Default,,0,0,0,,Губуах!
Dialogue: 0,0:10:46.10,0:10:48.31,Default,,0,0,0,,Не! сен!
Dialogue: 0,0:10:48.81,0:10:52.81,Default,,0,0,0,,Боқ бала ағашты кесіп тастайды.
Dialogue: 0,0:10:52.90,0:10:55.03,Default,,0,0,0,,Өлме!
Dialogue: 0,0:10:57.36,0:11:00.24,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:01.11,0:11:03.95,Default,,0,0,0,,(Кал Судың мазасыз дауысы)
Dialogue: 0,0:11:04.03,0:11:07.66,Default,,0,0,0,,Хахахахаха Менің атымды айт!
Dialogue: 0,0:11:07.75,0:11:09.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:15.46,0:11:16.67,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:11:17.17,0:11:19.30,Default,,0,0,0,,Мен өте әдемімін...
Dialogue: 0,0:11:19.38,0:11:22.14,Default,,0,0,0,,Бұл Дарк Шнайдер мырза~!
Dialogue: 0,0:11:22.22,0:11:23.43,Default,,0,0,0,,Зуа!
Dialogue: 0,0:11:24.55,0:11:28.68,Default,,0,0,0,,Қарғыс атқыр... Бұл жігіт осыншама билікті қайдан алды?
Dialogue: 0,0:11:30.69,0:11:32.85,Default,,0,0,0,,Дирк Шнайдер Бұл...
Dialogue: 0,0:11:36.98,0:11:40.11,Default,,0,0,0,,Ге... Гэндзюцу! Негізгі дене қайсысы?
Dialogue: 0,0:11:40.61,0:11:42.49,Default,,0,0,0,,Менің иллюзиямды көрдіңіз бе?
Dialogue: 0,0:11:42.57,0:11:44.24,Default,,0,0,0,,Қарғыс атқыр өлім
Dialogue: 0,0:11:44.32,0:11:45.66,Default,,0,0,0,,Енді маған соңғы нүктені беріңіз...
Dialogue: 0,0:11:45.74,0:11:47.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:47.70,0:11:51.29,Default,,0,0,0,,Міне! (Кал-Су) Уф!
Dialogue: 0,0:11:54.96,0:11:57.13,Default,,0,0,0,,Не? Ақымақ...
Dialogue: 0,0:11:57.21,0:11:58.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:58.30,0:12:00.63,Default,,0,0,0,,Бұл жебе аса бағалы — олардың тек біреуі ғана бар.
Dialogue: 0,0:12:00.72,0:12:02.80,Default,,0,0,0,,Ерекше күшпен
Dialogue: 0,0:12:02.88,0:12:07.18,Default,,0,0,0,,Сіз бұл Қараңғы Шнайдерді жеңе аламын деп ойладыңыз ба?
Dialogue: 0,0:12:07.26,0:12:10.14,Default,,0,0,0,,Өзіңді біл!
Dialogue: 0,0:12:10.23,0:12:14.98,Default,,0,0,0,,Зазад Зазад Скронор Роно Соук
Dialogue: 0,0:12:15.06,0:12:19.65,Default,,0,0,0,,Қап-қара түнектің қойнауында жанып тұрған тозақ оты.
Dialogue: 0,0:12:19.73,0:12:23.53,Default,,0,0,0,,Менің семсерім болып, жауды жой.
Dialogue: 0,0:12:23.61,0:12:24.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:25.45,0:12:26.37,Default,,0,0,0,,Қаха!
Dialogue: 0,0:12:27.87,0:12:29.62,Default,,0,0,0,,Жарылғыш тозақ
Dialogue: 0,0:12:29.70,0:12:36.71,Default,,0,0,0,,(Кал Судың ыңырсыуы)
Dialogue: 0,0:12:36.79,0:12:40.00,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:42.72,0:12:44.34,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:12:51.31,0:12:53.31,Default,,0,0,0,,О, Унуха...
Dialogue: 0,0:12:53.81,0:12:55.56,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:12:57.69,0:13:00.61,Default,,0,0,0,,Сен келдің.
Dialogue: 0,0:13:01.78,0:13:05.11,Default,,0,0,0,,А... бұл дауыстар ескі хаг пен шейла ма?
Dialogue: 0,0:13:05.61,0:13:06.74,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:13:07.53,0:13:10.03,Default,,0,0,0,,Келетініңізге сенімдімін...
Dialogue: 0,0:13:11.91,0:13:13.54,Default,,0,0,0,,Маған көмектессеңіз
Dialogue: 0,0:13:15.37,0:13:16.79,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:18.63,0:13:19.96,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:13:23.88,0:13:25.38,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:13:25.97,0:13:27.89,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:13:39.81,0:13:41.44,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:13:43.19,0:13:44.94,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:13:48.36,0:13:49.87,Default,,0,0,0,,Кал
Dialogue: 0,0:13:55.46,0:13:57.67,Default,,0,0,0,,Мен бірдеңе іздеп жүрмін
Dialogue: 0,0:13:58.17,0:14:01.79,Default,,0,0,0,,Мен оны көптен бері іздеп жүрмін.
Dialogue: 0,0:14:03.05,0:14:05.17,Default,,0,0,0,,Бұл дүниеге келгенімде
Dialogue: 0,0:14:05.26,0:14:08.26,Default,,0,0,0,,Біреу бөлген және жасырған нәрсе
Dialogue: 0,0:14:09.05,0:14:10.89,Default,,0,0,0,,Маған жетпейтін нәрседен жасалған
Dialogue: 0,0:14:11.72,0:14:13.14,Default,,0,0,0,,Бұл менің жартым.
Dialogue: 0,0:14:13.64,0:14:17.39,Default,,0,0,0,,Үлкен соғысты бастаудың шын мақсаты осы ма?
Dialogue: 0,0:14:18.02,0:14:19.85,Default,,0,0,0,,Мен оны тапқанша, Кал...
Dialogue: 0,0:14:20.36,0:14:22.36,Default,,0,0,0,,Сен менің екінші жартым болдың
Dialogue: 0,0:14:23.61,0:14:25.03,Default,,0,0,0,,Мен саған керекпін бе?
Dialogue: 0,0:14:25.11,0:14:26.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:27.07,0:14:30.32,Default,,0,0,0,,Эй, мен сені алғашында алдым.
Dialogue: 0,0:14:30.41,0:14:31.82,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:14:32.41,0:14:34.79,Default,,0,0,0,,Біз әлемді жаулап аламыз
Dialogue: 0,0:14:34.87,0:14:36.29,Default,,0,0,0,,Мен аламын.
Dialogue: 0,0:14:36.37,0:14:39.00,Default,,0,0,0,,Түсіндім, Дирк Шнайдер.
Dialogue: 0,0:14:41.04,0:14:43.38,Default,,0,0,0,,Сіз маған керек екеніңізді айттыңыз
Dialogue: 0,0:14:45.80,0:14:48.63,Default,,0,0,0,,Сен екеуміз әлемді басқарамыз
Dialogue: 0,0:14:50.55,0:14:51.55,Default,,0,0,0,,Мен және...
Dialogue: 0,0:14:53.14,0:14:54.26,Default,,0,0,0,,Сізден
Dialogue: 0,0:14:55.31,0:14:57.43,Default,,0,0,0,,Жоқ! Яаааа!
Dialogue: 0,0:14:57.52,0:14:58.98,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:14:59.06,0:15:00.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:02.90,0:15:04.07,Default,,0,0,0,,Не болды, Йоко?
Dialogue: 0,0:15:04.15,0:15:07.36,Default,,0,0,0,,Қазір... Дәл қазір өзімді біртүрлі сезініп тұрмын.
Dialogue: 0,0:15:08.49,0:15:11.49,Default,,0,0,0,,Артымнан біреу өтіп бара жатқандай болды.
Dialogue: 0,0:15:12.07,0:15:15.03,Default,,0,0,0,,Люсқа бірдеңе болды... Люсқа бірдеңе болды.
Dialogue: 0,0:15:15.12,0:15:16.45,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:15:16.54,0:15:18.33,Default,,0,0,0,,Бір нәрсе дегеніміз не?
Dialogue: 0,0:15:18.41,0:15:20.42,Default,,0,0,0,,Мен бұл туралы білмеймін, бірақ...
Dialogue: 0,0:15:23.17,0:15:25.92,Default,,0,0,0,,Гуоооо... аа... аа...
Dialogue: 0,0:15:26.00,0:15:28.13,Default,,0,0,0,,Бұл қалпына келтіру қабілеті...
Dialogue: 0,0:15:28.80,0:15:31.55,Default,,0,0,0,,Мета-Ликанаға шабуыл жасаған өлмеген циклоптар.
Dialogue: 0,0:15:31.63,0:15:33.93,Default,,0,0,0,,Сол Абигейл сияқты
Dialogue: 0,0:15:34.43,0:15:36.31,Default,,0,0,0,,Бұл жігіт мүмкін емес...
Dialogue: 0,0:15:36.39,0:15:39.64,Default,,0,0,0,,Сізге жойылатын Құдай ұйымы шабуыл жасап жатыр ма?
Dialogue: 0,0:15:39.73,0:15:41.60,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:15:41.69,0:15:43.69,Default,,0,0,0,,Әй (раз) ағя!
Dialogue: 0,0:15:45.98,0:15:48.90,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:48.99,0:15:50.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:50.70,0:15:52.49,Default,,0,0,0,,Ғибадатханадан жарылыс болды!
Dialogue: 0,0:15:52.57,0:15:55.95,Default,,0,0,0,,Хмм... бұл жақсы емес.
Dialogue: 0,0:15:57.24,0:15:59.25,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:15:59.33,0:16:01.16,Default,,0,0,0,,Ангус бірінші рет сөйлейді
Dialogue: 0,0:16:01.25,0:16:03.67,Default,,0,0,0,,Не? Сіз не туралы сөйлестіңіз?
Dialogue: 0,0:16:03.75,0:16:06.46,Default,,0,0,0,,Бұл дауыс... Әйтеуір!
Dialogue: 0,0:16:10.17,0:16:12.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:18.81,0:16:20.06,Default,,0,0,0,,Менде тек бір ғана сұрақ бар.
Dialogue: 0,0:16:20.14,0:16:23.19,Default,,0,0,0,,Уау! Ангус жарылып жатыр!
Dialogue: 0,0:16:24.98,0:16:27.36,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:16:27.94,0:16:29.69,Default,,0,0,0,,Бұл Абигейл!
Dialogue: 0,0:16:31.07,0:16:34.99,Default,,0,0,0,,А... Біраз болды, сұлу келіншек.
Dialogue: 0,0:16:35.07,0:16:37.45,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:16:38.45,0:16:40.20,Default,,0,0,0,,Абигейл туралы не деуге болады?
Dialogue: 0,0:16:40.29,0:16:41.66,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:16:42.16,0:16:44.87,Default,,0,0,0,,Екі жыл бұрын қараңғыда ұсталдым.
Dialogue: 0,0:16:44.96,0:16:47.71,Default,,0,0,0,,Оны жою Құдайы басқарды.
Dialogue: 0,0:16:48.34,0:16:50.96,Default,,0,0,0,,Мен енді сенің жауың емеспін.
Dialogue: 0,0:16:51.51,0:16:52.97,Default,,0,0,0,,Ма... Шынайы ма?
Dialogue: 0,0:16:53.05,0:16:54.05,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.13,0:16:57.68,Default,,0,0,0,,2 жылдан астам уақыт бұрын Біз әлемдік үстемдікке ұмтыламыз
Dialogue: 0,0:16:57.76,0:17:00.10,Default,,0,0,0,,Иуда сарайының жерасты ғибадатханасында ұйықтайды
Dialogue: 0,0:17:00.18,0:17:03.94,Default,,0,0,0,,Мен жойылу құдайы Антрасакстың төрт мөрінің бірін сындырдым.
Dialogue: 0,0:17:04.60,0:17:05.52,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:17:05.60,0:17:09.23,Default,,0,0,0,,Өкінішке орай, бірінші мөр
Dialogue: 0,0:17:09.32,0:17:12.99,Default,,0,0,0,,Ол Жоюшы Құдайдың рухын мөрлейді.
Dialogue: 0,0:17:13.07,0:17:15.32,Default,,0,0,0,,Уа, Құдайым!
Dialogue: 0,0:17:15.41,0:17:18.70,Default,,0,0,0,,Сол сәтте ол менің жүрегімді жаулап алды.
Dialogue: 0,0:17:18.78,0:17:22.54,Default,,0,0,0,,Ол да өз денесінің бір бөлігін маған салды.
Dialogue: 0,0:17:23.08,0:17:25.50,Default,,0,0,0,,Содан бері мен, Аби-чан,
Dialogue: 0,0:17:25.58,0:17:28.75,Default,,0,0,0,,«Сен бұзған мөр оның денесінің мөрі» деп өтірік айту.
Dialogue: 0,0:17:28.84,0:17:32.13,Default,,0,0,0,,Мен Төрт Аспан Патшасын ауыстырдым...
Dialogue: 0,0:17:32.21,0:17:33.88,Default,,0,0,0,,Дирк Шнайдермен бір рет
Dialogue: 0,0:17:33.97,0:17:38.39,Default,,0,0,0,,Жою Құдайының бүкіл ұйымының арқасында менің денем жойылды.
Dialogue: 0,0:17:38.47,0:17:41.81,Default,,0,0,0,,Осылайша оны бастапқы қалпына келтіруге мүмкіндік алды.
Dialogue: 0,0:17:42.47,0:17:45.23,Default,,0,0,0,,Ал самурай өзін Ангус Джан деп атады.
Dialogue: 0,0:17:45.31,0:17:46.94,Default,,0,0,0,,Қатарыңызға қосылыңыз
Dialogue: 0,0:17:47.02,0:17:50.02,Default,,0,0,0,,Тәнімді емдеп жатып, Сәтті күттім.
Dialogue: 0,0:17:50.82,0:17:56.11,Default,,0,0,0,,Айтпақшы, сіз қалай ойлайсыз? Барлығы, бұл менің сәнді маскам.
Dialogue: 0,0:17:56.20,0:17:59.62,Default,,0,0,0,,Бұл тамаша техника деп ойламайсыз ба?
Dialogue: 0,0:17:59.70,0:18:00.99,Default,,0,0,0,,Денеңізді емдегіңіз келсе...
Dialogue: 0,0:18:01.08,0:18:02.49,Default,,0,0,0,,Жасыру және демалу.
Dialogue: 0,0:18:02.58,0:18:04.37,Default,,0,0,0,,Керемет бетперде...
Dialogue: 0,0:18:04.45,0:18:06.16,Default,,0,0,0,,Беттің айырмашылығы неде?
Dialogue: 0,0:18:06.25,0:18:09.79,Default,,0,0,0,,Бұл ұқыпты бетперде емес пе?
Dialogue: 0,0:18:09.88,0:18:11.54,Default,,0,0,0,,А, иә, иә!
Dialogue: 0,0:18:13.84,0:18:16.09,Default,,0,0,0,,Мен түсінбедім...
Dialogue: 0,0:18:16.17,0:18:18.18,Default,,0,0,0,,Екі жылға
Dialogue: 0,0:18:19.05,0:18:22.35,Default,,0,0,0,,Мұның бәрі менің өткенім туралы.
Dialogue: 0,0:18:22.43,0:18:23.93,Default,,0,0,0,,Сіз жеткілікті сөйледіңіз.
Dialogue: 0,0:18:24.02,0:18:26.02,Default,,0,0,0,,Біз асығуымыз керек
Dialogue: 0,0:18:26.10,0:18:28.73,Default,,0,0,0,,«Қайта тірілу уақыты» жақын
Dialogue: 0,0:18:28.81,0:18:31.56,Default,,0,0,0,,Енді ол жерде қанша уақыт боласың?
Dialogue: 0,0:18:31.65,0:18:32.77,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:18:32.86,0:18:34.03,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:18:34.11,0:18:37.49,Default,,0,0,0,,Нанана... Не істеп жатырсың, бұзық?
Dialogue: 0,0:18:37.57,0:18:39.95,Default,,0,0,0,,Ах... бұл... ауырады.
Dialogue: 0,0:18:40.03,0:18:40.95,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:18:41.03,0:18:43.20,Default,,0,0,0,,Йоко Міне! (Йоко) Иә?
Dialogue: 0,0:18:43.28,0:18:46.37,Default,,0,0,0,,Дехехе~ Хехехе...
Dialogue: 0,0:18:46.45,0:18:48.00,Default,,0,0,0,,Дирк Шнайдер?
Dialogue: 0,0:18:49.71,0:18:50.96,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:18:53.25,0:18:55.96,Default,,0,0,0,,Жоқ, сен!
Dialogue: 0,0:18:56.05,0:18:57.97,Default,,0,0,0,,Уау! Гррр...
Dialogue: 0,0:18:58.05,0:19:00.89,Default,,0,0,0,,Сен маған үнемі жабысып тұрдың ба?
Dialogue: 0,0:19:00.97,0:19:03.05,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:19:04.60,0:19:06.52,Default,,0,0,0,,Бұл жоқ болғандықтан
Dialogue: 0,0:19:06.60,0:19:09.52,Default,,0,0,0,,Дирк Шнайдер соқыр болып қалды.
Dialogue: 0,0:19:09.60,0:19:10.98,Default,,0,0,0,,Өзіңізді қыспаңыз
Dialogue: 0,0:19:11.06,0:19:14.32,Default,,0,0,0,,Ауырмайды ма, Дирк Шнайдер?
Dialogue: 0,0:19:15.94,0:19:18.44,Default,,0,0,0,,Маған әйелдердің бөкселері ұнайды
Dialogue: 0,0:19:18.53,0:19:21.24,Default,,0,0,0,,Маған әсіресе әлгі әйелдің құлағы ұнайды.
Dialogue: 0,0:19:21.32,0:19:23.87,Default,,0,0,0,,Мына есек ғажап, бұл менікі!
Dialogue: 0,0:19:23.95,0:19:24.87,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:24.95,0:19:26.95,Default,,0,0,0,,Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:19:27.66,0:19:30.08,Default,,0,0,0,,Менің құлағым менің жаным
Dialogue: 0,0:19:30.16,0:19:32.33,Default,,0,0,0,,Дирк Шнайдерді түсіндім
Dialogue: 0,0:19:32.83,0:19:35.21,Default,,0,0,0,,Мына есекпен қалағаныңды істе.
Dialogue: 0,0:19:35.29,0:19:36.71,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:19:37.26,0:19:42.39,Default,,0,0,0,,Бірақ қазір мәселе Каль мен жойылу Құдайының мөрінде.
Dialogue: 0,0:19:42.47,0:19:43.93,Default,,0,0,0,,Сонымен... жарайды
Dialogue: 0,0:19:44.43,0:19:47.85,Default,,0,0,0,,Каль-Су қазір Шейла-самамен бірге ме?
Dialogue: 0,0:19:48.39,0:19:49.77,Default,,0,0,0,,Люс!
Dialogue: 0,0:19:49.85,0:19:50.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:50.94,0:19:54.44,Default,,0,0,0,,Бұл «Не?» емес. Сіз не тыныштандыруға тырысасыз?
Dialogue: 0,0:19:54.52,0:19:58.82,Default,,0,0,0,,Шейла ханым өлтіріледі. Тез арада бірдеңе істеу керек... Эй!
Dialogue: 0,0:19:58.90,0:20:01.90,Default,,0,0,0,,Вааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:20:01.99,0:20:03.78,Default,,0,0,0,,Сондықтан қазір бұл туралы ойланып отырсың, солай ма?
Dialogue: 0,0:20:03.87,0:20:05.78,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:20:05.87,0:20:08.20,Default,,0,0,0,,Қал - жойылу құдайы және қараңғылық энергиясы.
Dialogue: 0,0:20:08.29,0:20:11.29,Default,,0,0,0,,Сіз күшті регенеративті қабілеттерге ие болуыңыз керек еді.
Dialogue: 0,0:20:12.33,0:20:15.88,Default,,0,0,0,,Дәл осыдан екі жыл бұрынғы мен сияқты, сізбен бірдей деңгейде.
Dialogue: 0,0:20:15.96,0:20:18.63,Default,,0,0,0,,Бұдан артық күш бар деп айтуға болады.
Dialogue: 0,0:20:19.13,0:20:20.63,Default,,0,0,0,,Өлмейтін
Dialogue: 0,0:20:21.17,0:20:24.39,Default,,0,0,0,,Ке! Өлмейтіндік - менің ерекше патентім
Dialogue: 0,0:20:24.47,0:20:27.35,Default,,0,0,0,,Егер сіз соншалықты бастық болсаңыз, не істей аласыз?
Dialogue: 0,0:20:28.43,0:20:32.10,Default,,0,0,0,,Кез келген жағдайда қазіргі күйде жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:20:32.19,0:20:34.19,Default,,0,0,0,,Бұл өте кішкентай.
Dialogue: 0,0:20:34.27,0:20:36.61,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:36.69,0:20:39.44,Default,,0,0,0,,Иә, бірақ уайымдамаңыз.
Dialogue: 0,0:20:39.53,0:20:43.20,Default,,0,0,0,,Мен осындай жағдай орын алған жағдайда біраз нәрселерді дайындап қойдым.
Dialogue: 0,0:20:43.28,0:20:44.70,Default,,0,0,0,,Сиқырлы балға
Dialogue: 0,0:20:44.78,0:20:46.28,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:20:46.37,0:20:49.37,Default,,0,0,0,,Үйдегі кунграттың қақпағы
Dialogue: 0,0:20:49.45,0:20:51.58,Default,,0,0,0,,Хмм... үйдегі шелпек бар ма?
Dialogue: 0,0:20:52.08,0:20:52.91,Default,,0,0,0,,Секір!!
Dialogue: 0,0:20:53.00,0:20:55.42,Default,,0,0,0,,Бұл Дирк Шнайдерді бастапқы өлшеміне қайтара ма?
Dialogue: 0,0:20:55.50,0:20:56.50,Default,,0,0,0,,Шынында да
Dialogue: 0,0:20:56.58,0:20:58.38,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:20:58.46,0:20:59.71,Default,,0,0,0,,Жоқ, бұл мен бе?
Dialogue: 0,0:20:59.80,0:21:01.88,Default,,0,0,0,,А... хех хе хе...
Dialogue: 0,0:21:01.96,0:21:04.80,Default,,0,0,0,,Әй, бір сәт ауырады.
Dialogue: 0,0:21:04.88,0:21:06.59,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:21:06.68,0:21:09.89,Default,,0,0,0,,Барлығыңыз, оны ұстаңыздар.
Dialogue: 0,0:21:11.35,0:21:13.64,Default,,0,0,0,,Тоқта, ақымақ.
Dialogue: 0,0:21:13.73,0:21:16.98,Default,,0,0,0,,Міне, Дирк Шнайдер хахахаха...
Dialogue: 0,0:21:17.06,0:21:18.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:18.56,0:21:21.40,Default,,0,0,0,,Егер саған осындай нәрсе тисе, сен өлесің.
Dialogue: 0,0:21:21.48,0:21:24.49,Default,,0,0,0,,... Жібер, қанішер!
Dialogue: 0,0:21:24.57,0:21:26.36,Default,,0,0,0,,Сіз шынымен одақтассыз ба?
Dialogue: 0,0:21:26.45,0:21:30.28,Default,,0,0,0,,Әрине Дирк Шнайдер
Dialogue: 0,0:21:30.37,0:21:33.00,Default,,0,0,0,,Фугияаааааааа!
Dialogue: 0,0:21:30.37,0:21:33.00,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:35.67,0:21:37.29,Default,,0,0,0,,Ах... (Йоко) Ах.
Dialogue: 0,0:21:38.58,0:21:41.71,Default,,0,0,0,,Сізге жақсы Дирк Шнайдер
Dialogue: 0,0:21:41.80,0:21:46.01,Default,,0,0,0,,Өте қатты ауырды! Бұл қандай жағымсыз жағы?
Dialogue: 0,0:21:46.51,0:21:48.26,Default,,0,0,0,,Қарғыс атсын, бұл құпия.
Dialogue: 0,0:21:48.34,0:21:51.35,Default,,0,0,0,,Хмм, сен Абигейлге жақсы емессің.
Dialogue: 0,0:21:51.43,0:21:54.18,Default,,0,0,0,,Дирк Шнайдер Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:21:54.27,0:21:55.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:55.18,0:21:57.31,Default,,0,0,0,,Бұл керемет болуы керек.
Dialogue: 0,0:21:57.98,0:21:59.19,Default,,0,0,0,,Хун
Dialogue: 0,0:22:00.69,0:22:06.32,Default,,0,0,0,,Сол үлкен жарылыс кезінде қанша әскер болғанын ойласаңыз ше?
Dialogue: 0,0:22:06.40,0:22:08.91,Default,,0,0,0,,Мұның бәрі осы ма?
Dialogue: 0,0:22:10.03,0:22:11.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:11.62,0:22:12.62,Default,,0,0,0,,Не?
Dialogue: 0,0:22:12.70,0:22:14.04,Default,,0,0,0,,Жын соғысының генералы!
Dialogue: 0,0:22:14.62,0:22:16.71,Default,,0,0,0,,Әлі сонда болды ма...
Dialogue: 0,0:22:17.79,0:22:18.79,Default,,0,0,0,,Зеон!
Dialogue: 0,0:22:21.04,0:22:23.05,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.05,0:23:50.05,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory