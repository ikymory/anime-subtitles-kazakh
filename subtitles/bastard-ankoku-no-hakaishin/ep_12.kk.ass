Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.88,0:00:15.01,Default,,0,0,0,,Армия қаншалықты көп екенін ескере отырып,
Dialogue: 0,0:00:15.09,0:00:17.01,Default,,0,0,0,,Мұның бәрі осы ма?
Dialogue: 0,0:00:17.10,0:00:18.51,Default,,0,0,0,,Ах
Dialogue: 0,0:00:19.06,0:00:23.73,Default,,0,0,0,,Біреуіміз жететін еді.
Dialogue: 0,0:00:23.81,0:00:25.35,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:00:25.44,0:00:28.86,Default,,0,0,0,,Ынви мен Сайс ғибадатханаға бет алды.
Dialogue: 0,0:00:28.94,0:00:30.94,Default,,0,0,0,,Бұл жай ғана Влад па?
Dialogue: 0,0:00:31.03,0:00:33.61,Default,,0,0,0,,Не, онда тіпті Бол бар ма?
Dialogue: 0,0:00:33.70,0:00:35.91,Default,,0,0,0,,Мырза, не болып жатыр?
Dialogue: 0,0:00:35.99,0:00:39.41,Default,,0,0,0,,Бұл шайқас, ол төмендейді
Dialogue: 0,0:00:39.49,0:00:41.58,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:41.66,0:00:43.41,Default,,0,0,0,,Самурай шетке
Dialogue: 0,0:00:43.50,0:00:46.13,Default,,0,0,0,,Ондағы адамның дәрежесін ата.
Dialogue: 0,0:00:46.21,0:00:49.38,Default,,0,0,0,,Мен Кэлдің де бақытты болатынына сенімдімін.
Dialogue: 0,0:00:49.46,0:00:51.63,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:00:54.68,0:00:57.72,Default,,0,0,0,,Тек ол кісі аман болсын.
Dialogue: 0,0:01:01.43,0:01:04.98,Default,,0,0,0,,Сиқырлы қылыштың қамқоршысы болған әйелі Мариді өлтірді.
Dialogue: 0,0:01:05.06,0:01:07.48,Default,,0,0,0,,«Жан жегішті» ұрлаған адам
Dialogue: 0,0:01:12.61,0:01:16.78,Default,,0,0,0,,Өмірім болса да мен сені міндетті түрде өлтіремін!
Dialogue: 0,0:01:18.41,0:01:22.33,Default,,0,0,0,,Шайтанның жолына менің бауырым Зеон ғана түсті!
Dialogue: 0,0:01:25.83,0:01:27.83,Default,,0,0,0,,♪～
Dialogue: 0,0:02:51.00,0:02:53.00,Default,,0,0,0,,～♪
Dialogue: 0,0:02:54.75,0:02:57.76,Default,,0,0,0,,Мен Дирк Шнайдердің басын аламын.
Dialogue: 0,0:02:59.80,0:03:02.22,Default,,0,0,0,,Осы сиқырлы қылышпен Жан жегіш
Dialogue: 0,0:03:02.30,0:03:05.22,Default,,0,0,0,,Мен сенің жаныңды жұлып аламын
Dialogue: 0,0:03:05.31,0:03:08.93,Default,,0,0,0,,Олай болса, самураймен айналысуым керек пе?
Dialogue: 0,0:03:09.02,0:03:10.60,Default,,0,0,0,,Мотор басы
Dialogue: 0,0:03:10.69,0:03:14.06,Default,,0,0,0,,Хаос қақпасынан, Қараңғылықтың ізбасарлары
Dialogue: 0,0:03:14.15,0:03:17.53,Default,,0,0,0,,Сықырлау (Ваи)... Бұл ненің дыбысы?
Dialogue: 0,0:03:17.61,0:03:19.74,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:03:19.82,0:03:21.70,Default,,0,0,0,,Ха! Мынау... мынау!
Dialogue: 0,0:03:21.78,0:03:24.45,Default,,0,0,0,,Жын! Шақырушы бар.
Dialogue: 0,0:03:24.53,0:03:26.95,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:03:27.04,0:03:28.66,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:28.75,0:03:31.96,Default,,0,0,0,,Енді не істейміз? Дирк Шнайдер Самурай
Dialogue: 0,0:03:32.04,0:03:35.75,Default,,0,0,0,,Бар күшіңді салмасаң, жол бойы келуден пайда жоқ.
Dialogue: 0,0:03:39.63,0:03:40.80,Default,,0,0,0,,Абигейл
Dialogue: 0,0:03:40.88,0:03:42.97,Default,,0,0,0,,Иә Дирк Шнайдер
Dialogue: 0,0:03:43.05,0:03:45.93,Default,,0,0,0,,Кальді қалпына келтірудің қандай да бір жолы бар ма?
Dialogue: 0,0:03:46.01,0:03:49.56,Default,,0,0,0,,Өкінішке орай, Дирк Шнайдер емес
Dialogue: 0,0:03:49.64,0:03:53.10,Default,,0,0,0,,Жоюшы Құдайдың тәні ажырағысыз.
Dialogue: 0,0:03:53.19,0:03:54.35,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:56.36,0:03:58.44,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:03:59.19,0:04:01.90,Default,,0,0,0,,Жарайды, мен барайын.
Dialogue: 0,0:04:01.99,0:04:03.78,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:04:03.86,0:04:07.99,Default,,0,0,0,,Олар өздеріндегі жағдайды мүлде түсінбейтін сияқты.
Dialogue: 0,0:04:08.08,0:04:12.66,Default,,0,0,0,,Мен сені ешқайда жібермеймін. Барлығың осында өліңдер!
Dialogue: 0,0:04:15.63,0:04:17.00,Default,,0,0,0,,Лорд Дирк Шнайдер⸺
Dialogue: 0,0:04:17.09,0:04:21.26,Default,,0,0,0,,Сіздің терең және терең сезімдеріңізді түсінбей, көптеген құрметтемеу әрекеттері.
Dialogue: 0,0:04:21.34,0:04:23.72,Default,,0,0,0,,Пісіп-жетілмегеніміз үшін кешіріңіз.
Dialogue: 0,0:04:24.26,0:04:27.60,Default,,0,0,0,,Біз сізге ереміз!
Dialogue: 0,0:04:27.68,0:04:29.97,Default,,0,0,0,,Кеттік, самурай жауынгер!
Dialogue: 0,0:04:30.52,0:04:33.44,Default,,0,0,0,,Біздің күшіміз Енді оны көрсететін кез келді!
Dialogue: 0,0:04:33.52,0:04:34.52,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:04:34.60,0:04:37.23,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:04:37.31,0:04:41.36,Default,,0,0,0,,Лорд Дарк Шнайдерге жеңіс жолын ашыңыз!
Dialogue: 0,0:04:42.32,0:04:44.32,Default,,0,0,0,,Көбелек биі Asura Slash!
Dialogue: 0,0:04:46.41,0:04:48.45,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:04:49.28,0:04:50.95,Default,,0,0,0,,Жаса! Қанекей мынаны істейік!
Dialogue: 0,0:04:51.04,0:04:53.16,Default,,0,0,0,,Гуха, жылы!
Dialogue: 0,0:04:56.46,0:04:58.25,Default,,0,0,0,,О, мұны істеу оңай емес.
Dialogue: 0,0:04:58.34,0:04:59.54,Default,,0,0,0,,Бұл да
Dialogue: 0,0:04:59.63,0:05:02.21,Default,,0,0,0,,Мен оны кәсіподақ сиқырымен сейілтемін.
Dialogue: 0,0:05:02.30,0:05:03.51,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:05:03.59,0:05:05.34,Default,,0,0,0,,Жердің тереңдігіне оралу
Dialogue: 0,0:05:05.43,0:05:07.30,Default,,0,0,0,,Жиренішті оғаш көлеңке
Dialogue: 0,0:05:07.97,0:05:08.85,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:08.93,0:05:10.22,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:05:10.31,0:05:11.56,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:05:14.89,0:05:16.48,Default,,0,0,0,,Кай! Қарғыс атсын
Dialogue: 0,0:05:16.56,0:05:19.65,Default,,0,0,0,,Ол көтерілісшілер әскерінен шығып қана қойған жоқ;
Dialogue: 0,0:05:19.73,0:05:22.69,Default,,0,0,0,,Бізге әлі де қарсылық танытудың себебі неде?
Dialogue: 0,0:05:22.78,0:05:26.24,Default,,0,0,0,,Егер сіз ақылды болсаңыз, сіз оны бұрыннан білетін шығарсыз.
Dialogue: 0,0:05:26.32,0:05:29.87,Default,,0,0,0,,Қазіргі Қалдың өзі Жоюшы Құдайдың қуыршақтарынан басқа ештеңе емес!
Dialogue: 0,0:05:29.95,0:05:31.41,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:31.49,0:05:35.71,Default,,0,0,0,,Ағасының ақымақтығын білсе, Көрініс... Апам мұңаяды!
Dialogue: 0,0:05:40.34,0:05:41.25,Default,,0,0,0,,Зеон
Dialogue: 0,0:05:42.09,0:05:44.38,Default,,0,0,0,,Сен мені жек көресің бе? Шен
Dialogue: 0,0:05:45.13,0:05:48.22,Default,,0,0,0,,Бұл ағасы сүйікті әйелін өлтірді.
Dialogue: 0,0:05:48.30,0:05:51.76,Default,,0,0,0,,Кек ал! Мен сені өлтіремін!
Dialogue: 0,0:05:51.85,0:05:55.89,Default,,0,0,0,,Кагерю Нинпоның құпия техникасы Фудо Мейокен!
Dialogue: 0,0:06:04.78,0:06:06.65,Default,,0,0,0,,Хмм? Бұл не…
Dialogue: 0,0:06:06.74,0:06:11.12,Default,,0,0,0,,Ху, жеке кекпен көмкерілген, Бушидоны ұмытқан самурайдың шеберлігі.
Dialogue: 0,0:06:11.20,0:06:13.54,Default,,0,0,0,,Бұл мен үшін жұмыс істейтін нәрсе ме?
Dialogue: 0,0:06:13.62,0:06:16.29,Default,,0,0,0,,Мені жеңгің келсе, сиқырға түс.
Dialogue: 0,0:06:16.37,0:06:17.75,Default,,0,0,0,,Не!
Dialogue: 0,0:06:17.83,0:06:20.13,Default,,0,0,0,,Үлкен күшке ие болмасаң
Dialogue: 0,0:06:20.21,0:06:23.21,Default,,0,0,0,,Үлкен амбициялар орындалмайды.
Dialogue: 0,0:06:24.34,0:06:27.26,Default,,0,0,0,,Мен осындай өзімшіл себептермен әйелімнен айырылдым...
Dialogue: 0,0:06:27.34,0:06:29.18,Default,,0,0,0,,Сонда Мариді өлтірдің бе?
Dialogue: 0,0:06:29.26,0:06:32.39,Default,,0,0,0,,Әлемді өзгерту күшіне ие болыңыз
Dialogue: 0,0:06:32.47,0:06:34.39,Default,,0,0,0,,Идеалды қоғам
Dialogue: 0,0:06:34.93,0:06:37.10,Default,,0,0,0,,Оны жүзеге асыру үшін
Dialogue: 0,0:06:37.77,0:06:40.06,Default,,0,0,0,,«Жоятын» деп айту дұрыс емес пе?
Dialogue: 0,0:06:47.19,0:06:50.74,Default,,0,0,0,,Айтпақшы, Баторидің денесіне не болды?
Dialogue: 0,0:06:50.82,0:06:54.12,Default,,0,0,0,,Өйткені көптеген жәндіктер жойылды.
Dialogue: 0,0:06:54.20,0:06:56.37,Default,,0,0,0,,Қараңғы Шнайдер
Dialogue: 0,0:06:56.45,0:06:59.41,Default,,0,0,0,,Жәндіктер, көбірек жаңарайық!
Dialogue: 0,0:06:59.50,0:07:02.96,Default,,0,0,0,,Сонымен қатар, Лорд Кэл жер бетінде қай жерде?
Dialogue: 0,0:07:03.04,0:07:05.80,Default,,0,0,0,,Бәлкім, жойылу құдайы Антрасакспен⸺
Dialogue: 0,0:07:05.88,0:07:07.76,Default,,0,0,0,,Жер асты ғибадатханасында шығар.
Dialogue: 0,0:07:07.84,0:07:10.05,Default,,0,0,0,,Бірақ бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:07:10.13,0:07:13.14,Default,,0,0,0,,Ах, қамалдың ішінде ешкім қалмады.
Dialogue: 0,0:07:13.64,0:07:14.93,Default,,0,0,0,,Бұл да бос қабық.
Dialogue: 0,0:07:15.60,0:07:17.77,Default,,0,0,0,,Тіпті Шераның эскорт бөлімі де жоқ...
Dialogue: 0,0:07:17.85,0:07:20.73,Default,,0,0,0,,Жер бетінде не болды... Уф
Dialogue: 0,0:07:22.19,0:07:24.69,Default,,0,0,0,,Солдаттар өлді
Dialogue: 0,0:07:24.77,0:07:25.98,Default,,0,0,0,,Және барлығы
Dialogue: 0,0:07:26.07,0:07:28.61,Default,,0,0,0,,Рухты сорып алғандай кеуіп қалды
Dialogue: 0,0:07:28.69,0:07:30.36,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:07:30.45,0:07:32.16,Default,,0,0,0,,Макапин Қараңызшы!
Dialogue: 0,0:07:32.24,0:07:33.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:36.16,0:07:39.04,Default,,0,0,0,,Ш... Шера! Сьерра Э. Ли!
Dialogue: 0,0:07:41.62,0:07:42.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:48.09,0:07:49.67,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:07:49.76,0:07:52.76,Default,,0,0,0,,Жоқ, өйткені менің денем тез суып кетті.
Dialogue: 0,0:07:52.84,0:07:55.55,Default,,0,0,0,,Сіз крио-ұйқы күйінде тұрған сияқтысыз.
Dialogue: 0,0:07:55.64,0:07:58.31,Default,,0,0,0,,Оны ерте емдесең, оянуы керек.
Dialogue: 0,0:07:58.39,0:07:59.89,Default,,0,0,0,,Олай болса асығыңыз
Dialogue: 0,0:07:59.98,0:08:02.10,Default,,0,0,0,,Көтерілісшілер әскері жақындап келеді.
Dialogue: 0,0:08:02.19,0:08:03.19,Default,,0,0,0,,О
Dialogue: 0,0:08:03.27,0:08:07.40,Default,,0,0,0,,Неліктен Сьерра мұзда? Амал жоқ...
Dialogue: 0,0:08:07.48,0:08:09.86,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:08:10.94,0:08:15.32,Default,,0,0,0,,(Шейланың жылағаны)
Dialogue: 0,0:08:15.41,0:08:18.29,Default,,0,0,0,,Дирк Шнайдер қайтыс болды
Dialogue: 0,0:08:18.37,0:08:20.70,Default,,0,0,0,,(Шейланың жылағаны)
Dialogue: 0,0:08:20.79,0:08:24.71,Default,,0,0,0,,Ал Шейла, сен де өл!
Dialogue: 0,0:08:24.79,0:08:28.13,Default,,0,0,0,,Қалдың кедей жігіті
Dialogue: 0,0:08:28.67,0:08:30.55,Default,,0,0,0,,Жоюшы Құдайдың күшімен және т.б.
Dialogue: 0,0:08:30.63,0:08:33.76,Default,,0,0,0,,Утопияны жасауға болатынына шынымен сенесіз бе?
Dialogue: 0,0:08:33.84,0:08:39.60,Default,,0,0,0,,Қан мен соғыс қана бейбітшілік пен әділеттілік әкеледі!
Dialogue: 0,0:08:39.68,0:08:42.56,Default,,0,0,0,,Ооо!
Dialogue: 0,0:08:42.64,0:08:45.02,Default,,0,0,0,,Агия! Ханшайым!
Dialogue: 0,0:08:45.10,0:08:47.56,Default,,0,0,0,,Ааа... хаа... уф
Dialogue: 0,0:08:50.11,0:08:51.99,Default,,0,0,0,,Онда?
Dialogue: 0,0:08:52.07,0:08:56.49,Default,,0,0,0,,Жоқ, мөр қараңғылық күшіне әрекет ете бастады.
Dialogue: 0,0:08:56.57,0:08:58.99,Default,,0,0,0,,Ааа! Осы қарқынмен
Dialogue: 0,0:08:59.08,0:09:00.66,Default,,0,0,0,,Пломба сынған!
Dialogue: 0,0:09:00.74,0:09:02.37,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:09:04.66,0:09:08.00,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,0:09:08.96,0:09:11.80,Default,,0,0,0,,Кеттік! Яһуданы қайтар!
Dialogue: 0,0:09:11.88,0:09:13.01,Default,,0,0,0,,Гуах
Dialogue: 0,0:09:13.92,0:09:16.68,Default,,0,0,0,,Шүкір, жаулардың бәрі кішкентай сарбаздар.
Dialogue: 0,0:09:16.76,0:09:19.05,Default,,0,0,0,,Патша сарайы бос деген нені білдіреді?
Dialogue: 0,0:09:19.14,0:09:22.60,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:09:22.68,0:09:24.31,Default,,0,0,0,,Бұл діріл дегеніміз не?
Dialogue: 0,0:09:24.39,0:09:27.35,Default,,0,0,0,,Мифуне Бұл жер сілкінісі емес.
Dialogue: 0,0:09:27.44,0:09:29.48,Default,,0,0,0,,Қамал дірілдеп тұр
Dialogue: 0,0:09:30.07,0:09:32.86,Default,,0,0,0,,Бұл шынымен басталды ма?
Dialogue: 0,0:09:38.62,0:09:41.95,Default,,0,0,0,,Қазір аздап...
Dialogue: 0,0:09:42.04,0:09:45.54,Default,,0,0,0,,Құдайдың 400 жылдық ұзақ ұйқысы бітеді
Dialogue: 0,0:09:46.04,0:09:48.71,Default,,0,0,0,,Енді адамзатқа соңғы үкім келді.
Dialogue: 0,0:09:48.79,0:09:51.13,Default,,0,0,0,,Таза емес жерді тозаққа айналдыр
Dialogue: 0,0:09:51.21,0:09:53.05,Default,,0,0,0,,Үлкен қараңғылық жабады
Dialogue: 0,0:09:53.76,0:09:55.22,Default,,0,0,0,,Керемет тазарту!
Dialogue: 0,0:09:55.30,0:09:57.72,Default,,0,0,0,,Тоқта, оян!
Dialogue: 0,0:09:57.80,0:10:00.26,Default,,0,0,0,,Бұл қайтымсыз болады!
Dialogue: 0,0:10:00.35,0:10:03.47,Default,,0,0,0,,Хааааа... (Шейла) Хааааа...
Dialogue: 0,0:10:03.56,0:10:06.60,Default,,0,0,0,,Күтіңіз~!
Dialogue: 0,0:10:06.69,0:10:08.81,Default,,0,0,0,,Угяаа
Dialogue: 0,0:10:08.90,0:10:11.73,Default,,0,0,0,,О! Ол әлі тірі ме еді?
Dialogue: 0,0:10:11.82,0:10:13.78,Default,,0,0,0,,Да… да…
Dialogue: 0,0:10:15.32,0:10:18.41,Default,,0,0,0,,Доарк Шнайдоуэр!
Dialogue: 0,0:10:18.49,0:10:21.37,Default,,0,0,0,,Қараңғы... Шнайдер
Dialogue: 0,0:10:21.45,0:10:24.58,Default,,0,0,0,,Не болды? Сіз әлі шаршадыңыз ба?
Dialogue: 0,0:10:24.66,0:10:27.29,Default,,0,0,0,,уф... уф
Dialogue: 0,0:10:28.12,0:10:30.50,Default,,0,0,0,,Кал!
Dialogue: 0,0:10:30.58,0:10:33.21,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:10:34.25,0:10:37.55,Default,,0,0,0,,Жалындаған жолбарыстың (Газо Пантан) шақыруы!
Dialogue: 0,0:10:39.84,0:10:42.76,Default,,0,0,0,,Мұз найзасы жыланның соққысы (Zelt Froste)!
Dialogue: 0,0:10:45.43,0:10:47.31,Default,,0,0,0,,Кяаааааааааааааааааааааааааааааа
Dialogue: 0,0:10:53.48,0:10:55.19,Default,,0,0,0,,Мм! не?
Dialogue: 0,0:10:55.28,0:10:56.53,Default,,0,0,0,,Не?
Dialogue: 0,0:10:56.61,0:10:57.99,Default,,0,0,0,,Ғибадатхана...
Dialogue: 0,0:11:05.74,0:11:08.20,Default,,0,0,0,,О, бұл Кал!
Dialogue: 0,0:11:11.00,0:11:12.42,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:11:12.50,0:11:13.75,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:11:13.84,0:11:16.21,Default,,0,0,0,,Неліктен Кал мұнда?
Dialogue: 0,0:11:16.30,0:11:20.68,Default,,0,0,0,,Екеуінің шайқасы ақыры басталды.
Dialogue: 0,0:11:20.76,0:11:24.47,Default,,0,0,0,,Бұл екеуінің керемет сиқыры бір-бірімен соқтығысса ше?
Dialogue: 0,0:11:24.55,0:11:26.72,Default,,0,0,0,,Не болады...
Dialogue: 0,0:11:26.81,0:11:29.14,Default,,0,0,0,,Бұл тіпті мен үшін де болжау мүмкін емес.
Dialogue: 0,0:11:29.23,0:11:31.81,Default,,0,0,0,,Бірақ мен айта алатын жалғыз нәрсе
Dialogue: 0,0:11:31.90,0:11:34.81,Default,,0,0,0,,Себебі екеуі де сиқыршы.
Dialogue: 0,0:11:34.90,0:11:37.61,Default,,0,0,0,,Жақын шайқас мүмкін емес.
Dialogue: 0,0:11:37.69,0:11:39.78,Default,,0,0,0,,Шалғай жерден шығар⸺
Dialogue: 0,0:11:39.86,0:11:43.07,Default,,0,0,0,,Бұл күшті заклинаниелердің шайқасы болады.
Dialogue: 0,0:11:43.16,0:11:48.16,Default,,0,0,0,,Сонымен қатар, олардың сиқырлы күшінің табиғаты мүлдем қарама-қарсы: от пен мұз.
Dialogue: 0,0:11:48.24,0:11:51.12,Default,,0,0,0,,Не болады?
Dialogue: 0,0:11:51.21,0:11:54.54,Default,,0,0,0,,Бұл әдемі шайқастың жеңімпазы
Dialogue: 0,0:11:54.63,0:11:57.05,Default,,0,0,0,,Дүниенің тағдырын шеш
Dialogue: 0,0:12:02.22,0:12:05.97,Default,,0,0,0,,Менің есімде, сіз Дирк Шнайдер екенсіз.
Dialogue: 0,0:12:06.47,0:12:08.72,Default,,0,0,0,,Менің бұрынғы досым және ұстазым
Dialogue: 0,0:12:09.72,0:12:11.73,Default,,0,0,0,,Және сатқын
Dialogue: 0,0:12:12.39,0:12:14.48,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:12:14.56,0:12:16.27,Default,,0,0,0,,Ең болмағанда менің қолыммен
Dialogue: 0,0:12:16.94,0:12:19.15,Default,,0,0,0,,Мен сіздің тыныс алуыңызды тоқтатамын
Dialogue: 0,0:12:20.57,0:12:22.24,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:12:27.74,0:12:30.79,Default,,0,0,0,,Жеңдер! Танкард!
Dialogue: 0,0:12:37.38,0:12:41.26,Default,,0,0,0,,Я, қашудың қажеті жоқ, Дирк Шнайдер.
Dialogue: 0,0:12:42.80,0:12:44.68,Default,,0,0,0,,Сиқырлы садақ жарқыл көрсеткі (сәулелік садақ)!
Dialogue: 0,0:12:47.76,0:12:50.06,Default,,0,0,0,,Әй, сен қашасың ба?
Dialogue: 0,0:12:51.43,0:12:52.64,Default,,0,0,0,,Хо
Dialogue: 0,0:12:52.73,0:12:56.52,Default,,0,0,0,,Реинкарнация сәтсіз болса да, оның күші бұзылмаған сияқты.
Dialogue: 0,0:12:56.60,0:12:58.90,Default,,0,0,0,,Осы деңгейде
Dialogue: 0,0:12:58.98,0:13:02.19,Default,,0,0,0,,Екеуінің де күшті сиқырлы кедергілері бар.
Dialogue: 0,0:13:02.28,0:13:04.49,Default,,0,0,0,,Қарсыласқа зиян келтіру үшін
Dialogue: 0,0:13:04.57,0:13:07.95,Default,,0,0,0,,Сіз өте күшті заклинание қолдануыңыз керек.
Dialogue: 0,0:13:08.03,0:13:12.70,Default,,0,0,0,,Бірақ күшті заклинание ұзағырақ ән айтуды қажет етеді.
Dialogue: 0,0:13:13.79,0:13:18.04,Default,,0,0,0,,Дәл қазір екеуің соңғы заклинание жасауға мүмкіндік іздеп жатырсыңдар.
Dialogue: 0,0:13:18.75,0:13:21.50,Default,,0,0,0,,Ал сіз заклинание жасағанда
Dialogue: 0,0:13:21.59,0:13:23.72,Default,,0,0,0,,Біреуіміздің өлетін кезі келді!
Dialogue: 0,0:13:27.72,0:13:29.93,Default,,0,0,0,,Екеуміз де сиқырлаймыз.
Dialogue: 0,0:13:31.39,0:13:33.68,Default,,0,0,0,,Луи Эли Гре Скорбилли
Dialogue: 0,0:13:33.77,0:13:37.35,Default,,0,0,0,,Мені қара жаныңмен тазарттың.
Dialogue: 0,0:13:37.44,0:13:41.48,Default,,0,0,0,,Уа, гадес, Ең Тағаланың құдіретті жиналысында.
Dialogue: 0,0:13:41.57,0:13:44.44,Default,,0,0,0,,Ажалдың аязды дауылы киіндім.
Dialogue: 0,0:13:44.53,0:13:46.78,Default,,0,0,0,,Жерді шақырудың пентаграммасы
Dialogue: 0,0:13:46.86,0:13:48.66,Default,,0,0,0,,Өртті шақыру пентаграммасы
Dialogue: 0,0:13:48.74,0:13:50.66,Default,,0,0,0,,Су шақыру пентаграммасы
Dialogue: 0,0:13:50.74,0:13:52.66,Default,,0,0,0,,Жел шақыруының пентаграммасы
Dialogue: 0,0:13:52.74,0:13:56.16,Default,,0,0,0,,Ұлы Құдай-Перғауын, бес бұрышты жұлдыздар мені қоршап тұр.
Dialogue: 0,0:13:56.25,0:14:01.13,Default,,0,0,0,,Жалынмен жанып, аспанның алтыбұрыштарынан түсіп, маған күш бер.
Dialogue: 0,0:14:01.21,0:14:03.67,Default,,0,0,0,,Сиқырға екі адам кірді! о!
Dialogue: 0,0:14:03.76,0:14:06.67,Default,,0,0,0,,Қайсысы? Қай сиқыр бірінші болып шешіледі?
Dialogue: 0,0:14:06.76,0:14:08.72,Default,,0,0,0,,Бұл заклинание жақсы емес!
Dialogue: 0,0:14:08.80,0:14:10.93,Default,,0,0,0,,Кальдың әні бірінші болып аяқталады.
Dialogue: 0,0:14:11.01,0:14:12.01,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:14:12.10,0:14:17.19,Default,,0,0,0,,Енді жаңа антпен мұз бен қардың күші бір-бірімен байланысты.
Dialogue: 0,0:14:17.27,0:14:18.77,Default,,0,0,0,,Сол «өмірге»
Dialogue: 0,0:14:18.85,0:14:23.15,Default,,0,0,0,,Ғажайып құмырсқаның шымылдығы тартылып, Құдайдың өлімдегі бейнесін көресіз.
Dialogue: 0,0:14:23.98,0:14:26.53,Default,,0,0,0,,Қоштасу Дирк Шнайдер
Dialogue: 0,0:14:27.03,0:14:28.66,Default,,0,0,0,,Абсолютті нөлдік мұздату!
Dialogue: 0,0:14:30.74,0:14:34.37,Default,,0,0,0,,Бұл Кальдің ең үлкен және ең соңғы суық шағы!
Dialogue: 0,0:14:34.45,0:14:38.83,Default,,0,0,0,,Ауаның абсолютті нөлде қатуы барлық дерлік молекулалардың қозғалысын тоқтатады.
Dialogue: 0,0:14:38.92,0:14:40.92,Default,,0,0,0,,Молекулалық байланыстар ыдырайды
Dialogue: 0,0:14:41.00,0:14:43.09,Default,,0,0,0,,Барлық заттар шаңға айналады!
Dialogue: 0,0:14:43.17,0:14:45.59,Default,,0,0,0,,Дирк Шнайдер қайтыс болды!
Dialogue: 0,0:14:48.88,0:14:50.55,Default,,0,0,0,,(Өлімдегі Құдайдың зары)
Dialogue: 0,0:14:57.56,0:14:59.94,Default,,0,0,0,,Қарғыс атсын... Қасиетті Гвардия (Төтенше)!
Dialogue: 0,0:15:00.02,0:15:01.31,Default,,0,0,0,,Кяаа
Dialogue: 0,0:15:03.90,0:15:05.15,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:15:09.36,0:15:10.49,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:10.57,0:15:11.95,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:15:14.03,0:15:15.66,Default,,0,0,0,,Ол тірі!
Dialogue: 0,0:15:16.16,0:15:21.33,Default,,0,0,0,,Кайзард Альзадо Ки Сук Ханс Гросс Жібек
Dialogue: 0,0:15:21.42,0:15:25.34,Default,,0,0,0,,Жер, құм және мұз үлкен күшпен көтеріліп жатыр!
Dialogue: 0,0:15:25.42,0:15:28.38,Default,,0,0,0,,Түсіндім! Қараңғы Шнайдердің ертедегі сиқыры болды
Dialogue: 0,0:15:28.46,0:15:29.88,Default,,0,0,0,,Шабуыл үшін емес
Dialogue: 0,0:15:29.97,0:15:32.22,Default,,0,0,0,,Үлкен вакуумдық ақауды жасау
Dialogue: 0,0:15:32.30,0:15:34.35,Default,,0,0,0,,Мұздатылған ауаның таралуына кедергі болды ма?
Dialogue: 0,0:15:34.43,0:15:35.72,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:35.81,0:15:39.23,Default,,0,0,0,,Күлге айнал, Жер асты данышпан
Dialogue: 0,0:15:39.31,0:15:41.06,Default,,0,0,0,,Қорқынышты сиқырлар
Dialogue: 0,0:15:41.14,0:15:44.44,Default,,0,0,0,,Ауаны кескеннен кейін де, мен көп зиян көрдім.
Dialogue: 0,0:15:44.52,0:15:47.28,Default,,0,0,0,,Бірақ енді менің кезегім.
Dialogue: 0,0:15:47.36,0:15:50.07,Default,,0,0,0,,Осы «Жеті негізгі қамқоршы Құдайды (Haro Een)» жеңіз
Dialogue: 0,0:15:50.15,0:15:54.28,Default,,0,0,0,,Жеті кілтпен тозақ есігін аш
Dialogue: 0,0:15:54.37,0:15:55.66,Default,,0,0,0,,Бұл сиқыр!
Dialogue: 0,0:15:55.74,0:15:58.62,Default,,0,0,0,,Харло Ен!
Dialogue: 0,0:16:01.16,0:16:02.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:02.62,0:16:04.38,Default,,0,0,0,,Дирк Шнайдер жеңді!
Dialogue: 0,0:16:04.46,0:16:05.59,Default,,0,0,0,,Тікелей соққы!
Dialogue: 0,0:16:05.67,0:16:07.21,Default,,0,0,0,,Құрметті Кал!
Dialogue: 0,0:16:08.67,0:16:09.63,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:09.71,0:16:10.88,Default,,0,0,0,,Кяаа
Dialogue: 0,0:16:10.97,0:16:13.51,Default,,0,0,0,,Уа! Харло Ен
Dialogue: 0,0:16:13.59,0:16:14.89,Default,,0,0,0,,Иілген!
Dialogue: 0,0:16:14.97,0:16:17.51,Default,,0,0,0,,Ақымақ! Қарсу
Dialogue: 0,0:16:17.60,0:16:21.98,Default,,0,0,0,,Сіз шынайы өмірде Ω Абигейлге қарағанда сиқырлы қабілеттеріңіз көп деп айтасыз ба?
Dialogue: 0,0:16:22.06,0:16:24.06,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:16:24.15,0:16:26.40,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,0:16:26.48,0:16:29.86,Default,,0,0,0,,Асқын өткізгіштік (Йоко) Асқын өткізгіштік?
Dialogue: 0,0:16:29.94,0:16:30.99,Default,,0,0,0,,Цк
Dialogue: 0,0:16:31.07,0:16:32.57,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:32.65,0:16:36.95,Default,,0,0,0,,Кейбір заттардың белгілі бір температурасы критикалық температурадан төмен болады.
Dialogue: 0,0:16:37.03,0:16:41.33,Default,,0,0,0,,Электр кедергісін жоғалтады және электр тогының әдеттен тыс оңай ағуына мүмкіндік береді
Dialogue: 0,0:16:41.41,0:16:46.46,Default,,0,0,0,,Каль абсолютті нөл диапазонында үлкен электр құйындысын шығарады.
Dialogue: 0,0:16:46.54,0:16:50.96,Default,,0,0,0,,Ол өте жоғары тығыздықтағы электромагниттік толқындарды тудырды!
Dialogue: 0,0:16:51.05,0:16:54.68,Default,,0,0,0,,Күшті электромагниттік толқындар тіпті ядролық реакциялардың жылуын жеңе алады.
Dialogue: 0,0:16:54.76,0:16:57.39,Default,,0,0,0,,Оны қамтуға болады!
Dialogue: 0,0:16:57.47,0:17:00.89,Default,,0,0,0,,Қандай қорқынышты сиқырлы шайқас!
Dialogue: 0,0:17:00.97,0:17:03.35,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:17:03.43,0:17:05.81,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:17:05.90,0:17:07.27,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:17:07.36,0:17:11.11,Default,,0,0,0,,Енді бұл шайқастың нәтижесі де басқаша емес.
Dialogue: 0,0:17:11.19,0:17:12.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.11,0:17:13.82,Default,,0,0,0,,Күтілгендей, Cal's
Dialogue: 0,0:17:13.90,0:17:16.61,Default,,0,0,0,,Қараңғы Шнайдерді жеңу мүмкін емес.
Dialogue: 0,0:17:16.70,0:17:20.41,Default,,0,0,0,,Өзіңізді алдамаңыз! Екеуінің арасындағы бәсеке толығымен тең емес пе?
Dialogue: 0,0:17:20.49,0:17:22.83,Default,,0,0,0,,Жоқ, Кальдікі.
Dialogue: 0,0:17:22.91,0:17:26.42,Default,,0,0,0,,Шайқас сәл артықшылықпен жүріп жатқан сияқты...
Dialogue: 0,0:17:26.50,0:17:29.96,Default,,0,0,0,,Әрине, сиқыр ретінде ол жоғары температураның сиқырынан жақсы.
Dialogue: 0,0:17:30.04,0:17:33.59,Default,,0,0,0,,Суық мезгіл көп қуатты қажет етеді.
Dialogue: 0,0:17:33.67,0:17:37.68,Default,,0,0,0,,Ол затты құрайтын молекулалардың қозғалысын жылдамдатады.
Dialogue: 0,0:17:37.76,0:17:41.10,Default,,0,0,0,,Өйткені баяулау қиынырақ.
Dialogue: 0,0:17:41.18,0:17:43.52,Default,,0,0,0,,Бірақ Дирк Шнайдер
Dialogue: 0,0:17:43.60,0:17:46.23,Default,,0,0,0,,Абсолюттік нөлдік шабуылдың алдын алды.
Dialogue: 0,0:17:46.31,0:17:48.40,Default,,0,0,0,,Бұл Қал үшін дегенді білдіреді
Dialogue: 0,0:17:48.48,0:17:51.19,Default,,0,0,0,,Қараңғы Шнайдерді жеңетін ешбір заклинание жоқ.
Dialogue: 0,0:17:51.27,0:17:52.53,Default,,0,0,0,,білдіреді
Dialogue: 0,0:17:52.61,0:17:54.61,Default,,0,0,0,,Не! Бұл не нәрсе...
Dialogue: 0,0:17:54.69,0:17:57.78,Default,,0,0,0,,А, мүмкін емес... Жоқ, түсінемін.
Dialogue: 0,0:17:57.86,0:18:00.49,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:18:00.58,0:18:05.41,Default,,0,0,0,,Иә, өйткені жоғары температураның физикалық жоғарғы шегі жоқ.
Dialogue: 0,0:18:05.50,0:18:09.54,Default,,0,0,0,,Өйткені абсолютті нөлден төмен температура жоқ!
Dialogue: 0,0:18:11.38,0:18:13.80,Default,,0,0,0,,Сонымен қатар, Дирк Шнайдер
Dialogue: 0,0:18:13.88,0:18:15.92,Default,,0,0,0,,Бұл «Өлім қара ядролық жарылғыш тозақ (Бурагозахаас)» деп аталатын тыйым салынған заклинание⸺
Dialogue: 0,0:18:16.01,0:18:20.01,Default,,0,0,0,,Өте жоғары қызба бар, ол тіпті Харло Еннен де асып түседі.
Dialogue: 0,0:18:20.09,0:18:22.76,Default,,0,0,0,,Сосын бұл шайқас...
Dialogue: 0,0:18:22.85,0:18:24.68,Default,,0,0,0,,Дирк Шнайдер жеңді!
Dialogue: 0,0:18:24.77,0:18:28.39,Default,,0,0,0,,Бәлкім, келесі жолы бір-бірімізді атып жатқанымыз соңғы рет шығар.
Dialogue: 0,0:18:29.65,0:18:33.82,Default,,0,0,0,,Тағы да менде бірдеңе қатты дұрыс емес сияқты.
Dialogue: 0,0:18:33.90,0:18:35.74,Default,,0,0,0,,Жан түршігерлік нәрсе болады
Dialogue: 0,0:18:35.82,0:18:40.20,Default,,0,0,0,,Мен қайтымсыз нәрсе болатынын сеземін...
Dialogue: 0,0:18:40.82,0:18:41.99,Default,,0,0,0,,Руше
Dialogue: 0,0:18:46.25,0:18:47.87,Default,,0,0,0,,Ынви?
Dialogue: 0,0:18:47.96,0:18:50.42,Default,,0,0,0,,Сайкс, о, Влад та.
Dialogue: 0,0:18:50.50,0:18:53.42,Default,,0,0,0,,Тезірек, ғибадатхана дәл осы жерде.
Dialogue: 0,0:18:53.50,0:18:56.17,Default,,0,0,0,,Лорд Кал Дарк Шнайдермен соғысып жатқанда
Dialogue: 0,0:18:56.26,0:18:57.88,Default,,0,0,0,,Шейла ханшайымды ұстаңыз!
Dialogue: 0,0:18:57.97,0:19:02.05,Default,,0,0,0,,Хахаха, жойылу Құдайы ақыры қайта тірілді.
Dialogue: 0,0:19:03.89,0:19:04.89,Default,,0,0,0,,Ах
Dialogue: 0,0:19:08.56,0:19:09.89,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:19:11.23,0:19:14.77,Default,,0,0,0,,...
Dialogue: 0,0:19:14.86,0:19:16.94,Default,,0,0,0,,Күте тұрыңыз, Брэд, әлгі адам...
Dialogue: 0,0:19:18.07,0:19:20.36,Default,,0,0,0,,Скад бомбалаушы!
Dialogue: 0,0:19:20.45,0:19:22.82,Default,,0,0,0,,... бірақ...?
Dialogue: 0,0:19:22.91,0:19:24.20,Default,,0,0,0,,Иә
Dialogue: 0,0:19:24.28,0:19:25.74,Default,,0,0,0,,Гухаа
Dialogue: 0,0:19:25.83,0:19:26.87,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:19:26.95,0:19:28.41,Default,,0,0,0,,Бірақ негізгі денені табуымыз керек дейді… оны қалайша тауып алуымыз керек?
Dialogue: 0,0:19:28.50,0:19:31.67,Default,,0,0,0,,Сіз үш жын генералға қарсы не істеуді жоспарлап отырсыз?
Dialogue: 0,0:19:31.75,0:19:32.75,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:19:33.54,0:19:35.04,Default,,0,0,0,,Гухаа
Dialogue: 0,0:19:35.13,0:19:39.05,Default,,0,0,0,,Бір соққымен не істедім...!?
Dialogue: 0,0:19:39.13,0:19:41.51,Default,,0,0,0,,Хмф, мен сені өлтірмеймін.
Dialogue: 0,0:19:42.30,0:19:45.47,Default,,0,0,0,,Екеуінің арасындағы шайқас біткенше үндемейді.
Dialogue: 0,0:19:46.06,0:19:47.47,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:47.56,0:19:51.06,Default,,0,0,0,,Егер сен мұны істеймін десең, оны істеме, Ынви.
Dialogue: 0,0:19:52.02,0:19:54.81,Default,,0,0,0,,Біз Гундамнан күштіміз.
Dialogue: 0,0:19:54.90,0:19:56.98,Default,,0,0,0,,Бұл не? Яғни
Dialogue: 0,0:19:57.07,0:19:59.15,Default,,0,0,0,,Ниндзя Мастер Гала
Dialogue: 0,0:19:59.24,0:20:01.11,Default,,0,0,0,,Найзағай императоры Эшет Ней
Dialogue: 0,0:20:01.20,0:20:03.16,Default,,0,0,0,,Мен... ол тірі ме еді?
Dialogue: 0,0:20:04.41,0:20:07.83,Default,,0,0,0,,Бұл ақыры басталды, ә
Dialogue: 0,0:20:07.91,0:20:11.79,Default,,0,0,0,,Ал, олар барлығына қарама-қарсы екі нәрсе.
Dialogue: 0,0:20:11.87,0:20:15.25,Default,,0,0,0,,Бәлкім, біз бір күні ұрысатын шығармыз.
Dialogue: 0,0:20:15.33,0:20:16.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:17.30,0:20:18.59,Default,,0,0,0,,Дарш…
Dialogue: 0,0:20:19.34,0:20:21.63,Default,,0,0,0,,Дарш пен Калдың төбелесуі мүмкін емес.
Dialogue: 0,0:20:22.22,0:20:23.97,Default,,0,0,0,,Өрт және мұз
Dialogue: 0,0:20:24.05,0:20:29.06,Default,,0,0,0,,Екеуі бір-біріне қатты тартылды, өйткені олар мүлдем қарама-қайшы болды.
Dialogue: 0,0:20:29.14,0:20:32.56,Default,,0,0,0,,Сондықтан мен Кальдікі ұнай алмадым.
Dialogue: 0,0:20:33.85,0:20:37.73,Default,,0,0,0,,Бұл шайқастың себебі болуы керек.
Dialogue: 0,0:20:39.65,0:20:41.69,Default,,0,0,0,,Дирк Шнайдер
Dialogue: 0,0:20:42.99,0:20:46.12,Default,,0,0,0,,Күшті сиқырлы күшіне байланысты адамдар жек көреді.
Dialogue: 0,0:20:46.20,0:20:47.58,Default,,0,0,0,,Өзіңізден қорқыңыз
Dialogue: 0,0:20:47.66,0:20:50.33,Default,,0,0,0,,Қарғыс айтуды жалғастырған мен үшін
Dialogue: 0,0:20:50.95,0:20:53.08,Default,,0,0,0,,Сіздің қатысуыңыз күтпеген жағдай болды.
Dialogue: 0,0:20:54.46,0:20:57.17,Default,,0,0,0,,Менде жоқтың бәрі сенде болды.
Dialogue: 0,0:20:58.00,0:21:00.67,Default,,0,0,0,,Менен де қорқынышты сиқырлы күшке ие болсаң да
Dialogue: 0,0:21:01.46,0:21:04.38,Default,,0,0,0,,Өзіңнен де, өзіңнен басқа ешкімнен де қорықпа.
Dialogue: 0,0:21:04.47,0:21:06.76,Default,,0,0,0,,Шықпа, шегінбе
Dialogue: 0,0:21:07.35,0:21:11.60,Default,,0,0,0,,Бүкіл әлем саған жау болғанда да, сен соғыстың.
Dialogue: 0,0:21:12.14,0:21:14.39,Default,,0,0,0,,Жек көру
Dialogue: 0,0:21:14.48,0:21:18.02,Default,,0,0,0,,Сол кезде тіпті анам да мені өшірмек болды.
Dialogue: 0,0:21:18.11,0:21:20.15,Default,,0,0,0,,Сіз бұл қажет дедіңіз.
Dialogue: 0,0:21:20.23,0:21:23.15,Default,,0,0,0,,Калусты жек көр, жек көр!
Dialogue: 0,0:21:23.24,0:21:25.91,Default,,0,0,0,,Мен саған керек екенімді айттың
Dialogue: 0,0:21:25.99,0:21:27.28,Default,,0,0,0,,Жалғыз сен едің
Dialogue: 0,0:21:27.37,0:21:30.58,Default,,0,0,0,,Саған опасыздық жасаған!
Dialogue: 0,0:21:30.66,0:21:33.54,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:34.29,0:21:35.75,Default,,0,0,0,,«періштелер баспалдағы» деп те аталатын жарық.
Dialogue: 0,0:21:36.71,0:21:38.21,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:21:38.29,0:21:39.09,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:21:39.17,0:21:42.80,Default,,0,0,0,,Бұл мұзды сиқырлы қылыш «Мұз сұңқары»!
Dialogue: 0,0:21:42.88,0:21:45.76,Default,,0,0,0,,Ол қолым әлі де бар!
Dialogue: 0,0:21:45.84,0:21:46.76,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:21:46.84,0:21:50.55,Default,,0,0,0,,Сиқырға енгелі тұрған Люс мүлде қорғансыз!
Dialogue: 0,0:21:50.64,0:21:53.06,Default,,0,0,0,,Енді маған сиқырлы қылышпен шабуыл жасалса ше?
Dialogue: 0,0:21:53.14,0:21:55.02,Default,,0,0,0,,Ахх!
Dialogue: 0,0:21:55.81,0:21:58.19,Default,,0,0,0,,Қаш, Дирк Шнайдер!
Dialogue: 0,0:21:58.27,0:22:01.40,Default,,0,0,0,,Қараңғы Шнайдер!
Dialogue: 0,0:22:10.66,0:22:12.66,Default,,0,0,0,,♪～
Dialogue: 0,0:22:12.74,0:22:15.66,Default,,0,0,0,,Сен менікісің...
Dialogue: 0,0:22:19.79,0:22:21.00,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:22:22.34,0:22:23.55,Default,,0,0,0,,Менің⸺
Dialogue: 0,0:22:25.55,0:22:27.47,Default,,0,0,0,,Менің жалғыз досым
Dialogue: 0,0:22:31.05,0:22:35.06,Default,,0,0,0,,Кал!
Dialogue: 0,0:23:27.32,0:23:29.32,Default,,0,0,0,,～♪
Dialogue: 0,0:23:29.40,0:23:33.37,Default,,0,0,0,,Ааааааааааааааа ханшайым!
Dialogue: 0,0:23:33.45,0:23:36.33,Default,,0,0,0,,Ахх... мөр!
Dialogue: 0,0:23:36.41,0:23:37.79,Default,,0,0,0,,Шейла…
Dialogue: 0,0:23:37.87,0:23:40.50,Default,,0,0,0,,Ааааааааааааааа!
Dialogue: 0,0:23:40.58,0:23:42.96,Default,,0,0,0,,Пломба сынған!
Dialogue: 0,0:23:43.04,0:23:46.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:47.92,0:23:53.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory