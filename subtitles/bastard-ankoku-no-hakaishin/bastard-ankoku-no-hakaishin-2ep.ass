Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.60,0:00:28.44,Default,,0,0,0,,(Уақыт дауысы)
Dialogue: 0,0:00:28.52,0:00:30.15,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:00:30.23,0:00:31.61,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:00:31.69,0:00:34.36,Default,,0,0,0,,Ей, біз адамбыз.
Dialogue: 0,0:00:34.45,0:00:35.95,Default,,0,0,0,,Тамақ жемесең, өлесің!
Dialogue: 0,0:00:36.03,0:00:39.08,Default,,0,0,0,,Бұрынғы патшаның кезінде мұндай ауыр салықтар болмаған!
Dialogue: 0,0:00:39.16,0:00:41.45,Default,,0,0,0,,Тамақты қайтар!
Dialogue: 0,0:00:43.08,0:00:45.46,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:00:45.54,0:00:47.96,Default,,0,0,0,,Лизардман!
Dialogue: 0,0:00:48.04,0:00:50.46,Default,,0,0,0,,Угяаа
Dialogue: 0,0:00:50.96,0:00:52.01,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:00:52.09,0:00:54.30,Default,,0,0,0,,Ооо, хмф!
Dialogue: 0,0:00:54.38,0:00:55.22,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:00:55.84,0:00:57.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:57.89,0:00:59.30,Default,,0,0,0,,Өлуіңнің уақыты келді!
Dialogue: 0,0:00:59.39,0:01:02.10,Default,,0,0,0,,Бұл жігіттердің таразыларының қаттылығы сонша, жүзі оларға өте алмайды.
Dialogue: 0,0:01:02.81,0:01:03.98,Default,,0,0,0,,(үру)
Dialogue: 0,0:01:04.06,0:01:06.56,Default,,0,0,0,,Жағалау! Жағаға асығыңыз!
Dialogue: 0,0:01:06.65,0:01:07.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:09.73,0:01:10.65,Default,,0,0,0,,Гуах
Dialogue: 0,0:01:11.48,0:01:12.61,Default,,0,0,0,,(үру)
Dialogue: 0,0:01:12.69,0:01:13.82,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:01:13.90,0:01:15.99,Default,,0,0,0,,Гуах (бүлікші солдат) Гаах
Dialogue: 0,0:01:16.07,0:01:18.82,Default,,0,0,0,,Бұл жігіттер интерьерде одан әрі болуы керек.
Dialogue: 0,0:01:18.91,0:01:21.45,Default,,0,0,0,,Мен сені күткендей болдым!
Dialogue: 0,0:01:21.54,0:01:24.62,Default,,0,0,0,,Ақымақ, бұл жолды түсіне алмайсың!
Dialogue: 0,0:01:25.29,0:01:26.92,Default,,0,0,0,,Га… тассу…
Dialogue: 0,0:01:27.92,0:01:28.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:33.67,0:01:36.76,Default,,0,0,0,,А... а...
Dialogue: 0,0:01:36.84,0:01:39.22,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:01:40.10,0:01:41.68,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:01:47.69,0:01:50.06,Default,,0,0,0,,О! (Бүлікші солдат) Міне!
Dialogue: 0,0:01:51.32,0:01:52.73,Default,,0,0,0,,Самурай-сама!
Dialogue: 0,0:01:52.82,0:01:54.28,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:01:54.36,0:01:57.28,Default,,0,0,0,,Қылышыңды алып, достарыңа көмектес!
Dialogue: 0,0:01:57.36,0:01:59.11,Default,,0,0,0,,Олар да тірі заттар
Dialogue: 0,0:01:59.82,0:02:01.95,Default,,0,0,0,,Өлтіру мүмкін емес!
Dialogue: 0,0:02:04.54,0:02:07.29,Default,,0,0,0,,Қара қасқыр қылышын алыңыз!
Dialogue: 0,0:02:08.50,0:02:10.21,Default,,0,0,0,,(Кесірткенің айқайы)
Dialogue: 0,0:02:13.88,0:02:16.51,Default,,0,0,0,,Бушидоға адалдықпен еріңіз
Dialogue: 0,0:02:17.13,0:02:18.88,Default,,0,0,0,,Бұл самурай
Dialogue: 0,0:02:21.85,0:02:23.85,Default,,0,0,0,,♪～
Dialogue: 0,0:03:47.22,0:03:49.22,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.02,0:03:56.52,Default,,0,0,0,,(Арфа үні)
Dialogue: 0,0:04:07.33,0:04:08.79,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:04:08.87,0:04:11.50,Default,,0,0,0,,Сіздің ойнаған үніңіз әдемі
Dialogue: 0,0:04:13.25,0:04:14.79,Default,,0,0,0,,Деннис стратегиясы
Dialogue: 0,0:04:14.88,0:04:17.21,Default,,0,0,0,,Сенде қиындық бар сияқты, Ынви.
Dialogue: 0,0:04:17.29,0:04:19.92,Default,,0,0,0,,Бұл туралы әскери кеңесте айтайық.
Dialogue: 0,0:04:20.42,0:04:23.01,Default,,0,0,0,,Мен солдаттан бұрын естідім,
Dialogue: 0,0:04:23.09,0:04:25.18,Default,,0,0,0,,Хо Ландауда көтеріліс болды.
Dialogue: 0,0:04:25.26,0:04:28.18,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:04:28.26,0:04:31.43,Default,,0,0,0,,Жын генералдарының бірі қазірдің өзінде қозғалыста.
Dialogue: 0,0:04:32.02,0:04:34.27,Default,,0,0,0,,Құбыжық Макапин
Dialogue: 0,0:04:34.35,0:04:36.15,Default,,0,0,0,,Самурай тобы алға!
Dialogue: 0,0:04:36.23,0:04:39.48,Default,,0,0,0,,Жау жауынгерлерін таратып, шығуға жол аш! Қанекей мынаны істейік!
Dialogue: 0,0:04:39.57,0:04:41.19,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:04:41.28,0:04:44.03,Default,,0,0,0,,Ио... Жарайды, біз де.
Dialogue: 0,0:04:44.11,0:04:45.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.20,0:04:46.03,Default,,0,0,0,,Vibo!
Dialogue: 0,0:04:46.11,0:04:47.57,Default,,0,0,0,,Гяаа
Dialogue: 0,0:04:48.08,0:04:49.70,Default,,0,0,0,,Не!
Dialogue: 0,0:04:49.79,0:04:54.92,Default,,0,0,0,,Кукукукукукк, мына маймылдар алып кетті.
Dialogue: 0,0:04:55.00,0:04:59.38,Default,,0,0,0,,Бұл көтерілістің арқасын самурайлар тартып жатқаны рас па?
Dialogue: 0,0:05:00.00,0:05:03.76,Default,,0,0,0,,Қал-самаға көнбей, төтеп беретіндер!
Dialogue: 0,0:05:03.84,0:05:05.18,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:05:05.26,0:05:10.35,Default,,0,0,0,,Оны жайына қалдырыңыз... Сиқырлы қолбасшы Макапин!
Dialogue: 0,0:05:10.93,0:05:13.68,Default,,0,0,0,,Сен ұлы үшінсің.
Dialogue: 0,0:05:13.77,0:05:16.02,Default,,0,0,0,,Өлгенше еңбек етсең, жақсы.
Dialogue: 0,0:05:17.40,0:05:20.15,Default,,0,0,0,,Олардың жағдайын білмей көтеріліс
Dialogue: 0,0:05:20.86,0:05:22.28,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:05:22.36,0:05:24.11,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:05:24.19,0:05:25.32,Default,,0,0,0,,Macapine-ді күтіңіз
Dialogue: 0,0:05:26.74,0:05:28.03,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:28.12,0:05:31.49,Default,,0,0,0,,Самурай Центурион Йорг Фисис
Dialogue: 0,0:05:32.33,0:05:33.45,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:05:33.54,0:05:37.12,Default,,0,0,0,,Сізге ары қарай азаматтарға араласуға рұқсат етілмейді!
Dialogue: 0,0:05:37.21,0:05:40.17,Default,,0,0,0,,Иә? Осы маймылды өлтірсем...
Dialogue: 0,0:05:40.25,0:05:41.38,Default,,0,0,0,,Хогех
Dialogue: 0,0:05:41.96,0:05:44.34,Default,,0,0,0,,«Сюй мырза» деп қалай айтасыз?
Dialogue: 0,0:05:44.42,0:05:46.47,Default,,0,0,0,,Мен... күте тұрыңыз
Dialogue: 0,0:05:47.43,0:05:49.18,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:05:54.89,0:05:57.77,Default,,0,0,0,,Қара қасқыр қылыш!
Dialogue: 0,0:05:57.85,0:05:59.73,Default,,0,0,0,,Әй, ақымақ.
Dialogue: 0,0:05:59.81,0:06:04.03,Default,,0,0,0,,Не... анау ақымақ қара қасқыр қылыш...
Dialogue: 0,0:06:04.65,0:06:06.28,Default,,0,0,0,,Сондықтан мен білмеймін.
Dialogue: 0,0:06:07.57,0:06:09.70,Default,,0,0,0,,Угвааааааааааааа!
Dialogue: 0,0:06:10.78,0:06:13.41,Default,,0,0,0,,Иә... Лорд Йорг! Угяаа
Dialogue: 0,0:06:14.04,0:06:16.71,Default,,0,0,0,,Қанша адам келсе де солай.
Dialogue: 0,0:06:16.79,0:06:20.63,Default,,0,0,0,,Сіз оны самурайлардан қалып қойған жын-генерал деп ойлайсыз ба?
Dialogue: 0,0:06:20.71,0:06:22.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:22.34,0:06:24.17,Default,,0,0,0,,Бұл... болат жіп
Dialogue: 0,0:06:24.67,0:06:29.38,Default,,0,0,0,,Көзге көрінбейтіндей жіңішке соғылған арнайы болат жіпті пайдаланатын адам.
Dialogue: 0,0:06:29.47,0:06:31.89,Default,,0,0,0,,Мен сізді жын соғысының генералында деп естідім.
Dialogue: 0,0:06:32.80,0:06:34.60,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,0:06:34.68,0:06:39.14,Default,,0,0,0,,Мм, сен менің жын жібімнен қаштың ба?
Dialogue: 0,0:06:39.23,0:06:41.52,Default,,0,0,0,,Иә, шынымен
Dialogue: 0,0:06:41.61,0:06:46.40,Default,,0,0,0,,Бұл сансыз жіптер шексіз созылып, саусақтардың шамалы қимылымен еркін қозғалады.
Dialogue: 0,0:06:46.94,0:06:50.45,Default,,0,0,0,,Ол тіпті миллион шақырым жердегі тасты кесіп өте алады.
Dialogue: 0,0:06:50.53,0:06:52.32,Default,,0,0,0,,Йорг ше?
Dialogue: 0,0:06:52.41,0:06:55.83,Default,,0,0,0,,Өзіңіздің үйіңіздің, самурайлар резиденциясының орнын айтсаңыз.
Dialogue: 0,0:06:55.91,0:06:58.21,Default,,0,0,0,,Сіз оны оңай өлуге рұқсат ете аласыз.
Dialogue: 0,0:06:58.29,0:07:01.17,Default,,0,0,0,,Әй, ақымақ, пайдасы жоқ.
Dialogue: 0,0:07:01.25,0:07:04.00,Default,,0,0,0,,Самурай өлімнен де, аурудан да қорықпайды.
Dialogue: 0,0:07:05.00,0:07:06.63,Default,,0,0,0,,Куку куку
Dialogue: 0,0:07:06.71,0:07:10.97,Default,,0,0,0,,Хахахаха солай деп ойлаймын? шынымен
Dialogue: 0,0:07:13.05,0:07:16.77,Default,,0,0,0,,Өз өмірі үшін қорқып сөйлеген самурай болса ше?
Dialogue: 0,0:07:16.85,0:07:17.85,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:07:17.93,0:07:19.77,Default,,0,0,0,,Сіздің базаңыз әлдеқашан жарылған.
Dialogue: 0,0:07:19.85,0:07:24.19,Default,,0,0,0,,Ұлы әскеріміз жан-жақты шабуыл жасауға дайындалып жатса ше?
Dialogue: 0,0:07:24.27,0:07:25.36,Default,,0,0,0,,Не?
Dialogue: 0,0:07:25.44,0:07:28.82,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,0:07:28.90,0:07:32.07,Default,,0,0,0,,Біз көтерілісті қаншалықты дәл болжадық?
Dialogue: 0,0:07:32.16,0:07:34.12,Default,,0,0,0,,Оның буксирде болғаны
Dialogue: 0,0:07:34.20,0:07:38.41,Default,,0,0,0,,Сізге бұл мүлдем оғаш көрінбейді ме? Кукукукукуку
Dialogue: 0,0:07:38.50,0:07:41.83,Default,,0,0,0,,Аузыңды жап! Бұл өтірік! Бұл сіздің қайталауыңыз!
Dialogue: 0,0:07:41.92,0:07:45.04,Default,,0,0,0,,Хахахаха жарайды
Dialogue: 0,0:07:45.13,0:07:48.80,Default,,0,0,0,,Мені жалғыз қалдырсаң, өлесің. Мұның саған еш қатысы жоқ.
Dialogue: 0,0:07:48.88,0:07:51.47,Default,,0,0,0,,Мен қазірден бастап бос боламын.
Dialogue: 0,0:07:51.55,0:07:53.80,Default,,0,0,0,,Сіздің қожайыныңыз Джошуа Белахия
Dialogue: 0,0:07:53.89,0:07:55.93,Default,,0,0,0,,Оны дөңгелек етіп кесу керек.
Dialogue: 0,0:07:56.01,0:07:59.72,Default,,0,0,0,,Жарайды... күте тұр, бұл өтірік, өтірік деп айт!
Dialogue: 0,0:07:59.81,0:08:02.89,Default,,0,0,0,,Адамдар – әлсіз жаратылыс.
Dialogue: 0,0:08:02.98,0:08:05.69,Default,,0,0,0,,Физикалық жағынан да, психикалық жағынан да әлсіз
Dialogue: 0,0:08:06.31,0:08:10.82,Default,,0,0,0,,Кішкентай дерт қадір-қасиетті жойып, адамзатты тізе бүктіреді.
Dialogue: 0,0:08:10.90,0:08:14.99,Default,,0,0,0,,Мұндай адамға қаншалықты сенуге болады?
Dialogue: 0,0:08:15.70,0:08:20.33,Default,,0,0,0,,Бір-біріне сеніп, құрып кетудің бәрі қызық па?
Dialogue: 0,0:08:21.33,0:08:22.87,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:08:22.96,0:08:26.42,Default,,0,0,0,,Гах... бұл ақымақтық
Dialogue: 0,0:08:26.50,0:08:29.75,Default,,0,0,0,,Мен сенбеймін, сенбеймін!
Dialogue: 0,0:08:29.84,0:08:34.34,Default,,0,0,0,,Ал... күте тұр, Макапин, өтірігіңді қайтар!
Dialogue: 0,0:08:34.43,0:08:38.39,Default,,0,0,0,,Бұл өтірік! Ой!
Dialogue: 0,0:08:44.44,0:08:46.56,Default,,0,0,0,,Менің адал қызметшім
Dialogue: 0,0:08:46.65,0:08:48.52,Default,,0,0,0,,Жын соғысының генералдары
Dialogue: 0,0:08:49.15,0:08:51.61,Default,,0,0,0,,Қазіргі уақытта біздің жоспарымыз
Dialogue: 0,0:08:51.69,0:08:55.11,Default,,0,0,0,,Кішігірім проблемаларды қоспағанда, барлығы жақсы жүріп жатыр деп айта аламын.
Dialogue: 0,0:08:55.66,0:08:57.45,Default,,0,0,0,,Біздің армия қазірдің өзінде бар
Dialogue: 0,0:08:57.53,0:09:00.12,Default,,0,0,0,,Бұл аймақта 20-дан астам бекіністі қалалар
Dialogue: 0,0:09:00.20,0:09:02.62,Default,,0,0,0,,Сәтті бақылауға алынды
Dialogue: 0,0:09:03.16,0:09:06.42,Default,,0,0,0,,Бірақ ол маған әлі жеткен жоқ.
Dialogue: 0,0:09:06.50,0:09:08.84,Default,,0,0,0,,Тәуелсіз коммерциялық және коммерциялық қалаларға қарсы тұруды жалғастыру
Dialogue: 0,0:09:08.92,0:09:10.92,Default,,0,0,0,,Спутниктік қалалар бар
Dialogue: 0,0:09:11.51,0:09:13.80,Default,,0,0,0,,Жақында жаппай шабуыл жоспарланған.
Dialogue: 0,0:09:13.88,0:09:15.47,Default,,0,0,0,,Мысықтар да шарасыз
Dialogue: 0,0:09:15.55,0:09:18.80,Default,,0,0,0,,Бірлігі мықты, қорғанысы мықты.
Dialogue: 0,0:09:19.43,0:09:21.31,Default,,0,0,0,,Мұны тіпті лордтар да біледі
Dialogue: 0,0:09:21.39,0:09:23.77,Default,,0,0,0,,Катсура қаласына экспедицияға бару
Dialogue: 0,0:09:23.85,0:09:26.31,Default,,0,0,0,,Территориядағы көтерілісшілер
Dialogue: 0,0:09:26.39,0:09:29.02,Default,,0,0,0,,Шешуші әрекет жасау керек
Dialogue: 0,0:09:29.61,0:09:32.23,Default,,0,0,0,,Көтеріліске қатысқандар ғана емес
Dialogue: 0,0:09:32.32,0:09:34.90,Default,,0,0,0,,Оның отбасы мен руы
Dialogue: 0,0:09:34.99,0:09:37.57,Default,,0,0,0,,Барлығын жойыңыз.
Dialogue: 0,0:09:37.66,0:09:39.57,Default,,0,0,0,,Менің... жоқ
Dialogue: 0,0:09:39.66,0:09:42.66,Default,,0,0,0,,Лордтардың идеалды қоғамын жүзеге асыру
Dialogue: 0,0:09:42.74,0:09:44.91,Default,,0,0,0,,Құны қандай болса да
Dialogue: 0,0:09:45.00,0:09:47.12,Default,,0,0,0,,Жоспарды орындаңыз
Dialogue: 0,0:09:47.21,0:09:49.25,Default,,0,0,0,,Бұл империялық бұйрық
Dialogue: 0,0:09:49.33,0:09:50.63,Default,,0,0,0,,Хаха
Dialogue: 0,0:09:51.34,0:09:53.84,Default,,0,0,0,,Бірақ одан да көп
Dialogue: 0,0:09:53.92,0:09:58.43,Default,,0,0,0,,Біздің ең маңызды миссиямыз бар екенін есте сақтаңыз.
Dialogue: 0,0:09:59.18,0:10:01.14,Default,,0,0,0,,Бұл континентте ғана емес
Dialogue: 0,0:10:01.22,0:10:04.14,Default,,0,0,0,,Сонымен қатар бүкіл экожүйеде
Dialogue: 0,0:10:04.22,0:10:07.81,Default,,0,0,0,,Адамзат қоғамының оннан бір бөлігінен аз
Dialogue: 0,0:10:07.89,0:10:09.81,Default,,0,0,0,,Барлық материктердің шекаралары
Dialogue: 0,0:10:09.90,0:10:12.82,Default,,0,0,0,,Жындар әлемінде тұратын ергежейлі Эльф
Dialogue: 0,0:10:12.90,0:10:14.65,Default,,0,0,0,,Хобибит Гигант
Dialogue: 0,0:10:14.73,0:10:17.15,Default,,0,0,0,,Orc Troll
Dialogue: 0,0:10:17.24,0:10:19.57,Default,,0,0,0,,Гоблин Коболд және т.б.
Dialogue: 0,0:10:19.66,0:10:22.16,Default,,0,0,0,,Деми-адам қоғамы, соның ішінде барлығы⸺
Dialogue: 0,0:10:22.24,0:10:24.37,Default,,0,0,0,,Бүкіл әлемді басқару
Dialogue: 0,0:10:24.45,0:10:27.66,Default,,0,0,0,,Міне, ол сиқырлы күшпен біріктірілді⸺
Dialogue: 0,0:10:27.75,0:10:30.38,Default,,0,0,0,,Идеалды жаңа әлемді құру
Dialogue: 0,0:10:31.04,0:10:32.96,Default,,0,0,0,,Ежелгі заманнан Ескі дүниеде
Dialogue: 0,0:10:33.04,0:10:34.59,Default,,0,0,0,,Александр мен Рим
Dialogue: 0,0:10:34.67,0:10:36.76,Default,,0,0,0,,Хубилай, Наполеон және Президент
Dialogue: 0,0:10:36.84,0:10:39.72,Default,,0,0,0,,Оны тіпті Иса да істей алмады⸺
Dialogue: 0,0:10:39.80,0:10:42.93,Default,,0,0,0,,Адамзаттың ең үлкен тілегі және ең үлкен жетістігі!
Dialogue: 0,0:10:43.01,0:10:44.60,Default,,0,0,0,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,0:10:45.18,0:10:47.39,Default,,0,0,0,,Абсолютті шекті күш...
Dialogue: 0,0:10:47.48,0:10:50.56,Default,,0,0,0,,Жою құдайы Антрасакстың толық қайта тірілуі.
Dialogue: 0,0:10:50.65,0:10:52.61,Default,,0,0,0,,Бұл өте қажет.
Dialogue: 0,0:10:53.27,0:10:58.03,Default,,0,0,0,,Жою Құдайының физикалық қайта тірілуі өзінің соңғы кезеңіне жетті.
Dialogue: 0,0:10:58.11,0:11:00.74,Default,,0,0,0,,Күннен күнге жетіліп келеді
Dialogue: 0,0:11:00.82,0:11:04.49,Default,,0,0,0,,Дегенмен, рух әлі де күшті мөр.
Dialogue: 0,0:11:04.58,0:11:07.29,Default,,0,0,0,,Ол оятусыз қалады.
Dialogue: 0,0:11:07.37,0:11:11.54,Default,,0,0,0,,Аңызға айналған «Қайта тірілу сағаты» жақындап қалды.
Dialogue: 0,0:11:11.63,0:11:14.21,Default,,0,0,0,,Жоюшы Құдай оянбағандықтан
Dialogue: 0,0:11:14.29,0:11:16.25,Default,,0,0,0,,Соңғы мөрді ұстау⸺
Dialogue: 0,0:11:16.34,0:11:19.01,Default,,0,0,0,,Мета-Ликана патшалығының ханшайымы
Dialogue: 0,0:11:19.09,0:11:23.22,Default,,0,0,0,,Шейла Тоэль Мета-Ликананың аман қалуы сөзсіз.
Dialogue: 0,0:11:24.35,0:11:26.68,Default,,0,0,0,,Міндетті түрде біліңіз
Dialogue: 0,0:11:26.77,0:11:28.06,Default,,0,0,0,,Ақтау жоқ
Dialogue: 0,0:11:28.68,0:11:31.77,Default,,0,0,0,,Жындармен соғысқан генералдар, менің күшім болыңдар!
Dialogue: 0,0:11:31.85,0:11:34.44,Default,,0,0,0,,Хаха, қалағаныңызша.
Dialogue: 0,0:11:35.32,0:11:37.03,Default,,0,0,0,,Бұл суық ауа
Dialogue: 0,0:11:37.11,0:11:40.70,Default,,0,0,0,,Бұл тек Кальдан шыққан мұздатылған ауаға байланысты емес.
Dialogue: 0,0:11:40.78,0:11:42.16,Default,,0,0,0,,Оян
Dialogue: 0,0:11:42.24,0:11:44.37,Default,,0,0,0,,Ингви фон Малмстин!
Dialogue: 0,0:11:44.45,0:11:48.16,Default,,0,0,0,,Қалдың билігі жаман екенін неге түсінбейсің!
Dialogue: 0,0:11:51.29,0:11:55.38,Default,,0,0,0,,Бос дворяндардан тәркіленген дүние-мүлік пен азық-түлікті пайдаланып,
Dialogue: 0,0:11:55.46,0:11:58.25,Default,,0,0,0,,Нашар егіннен зардап шеккен адамдарды құтқарыңыз!
Dialogue: 0,0:11:58.34,0:11:59.71,Default,,0,0,0,,Бұл жеткіліксіз болса
Dialogue: 0,0:11:59.80,0:12:02.47,Default,,0,0,0,,Мен әскеріміздің әскери шығындарын қысқартуға қарсы емеспін.
Dialogue: 0,0:12:03.13,0:12:04.47,Default,,0,0,0,,Құрметті Кал…
Dialogue: 0,0:12:06.72,0:12:08.64,Default,,0,0,0,,Бұл адам өзгерді
Dialogue: 0,0:12:11.27,0:12:14.40,Default,,0,0,0,,Бірақ менің адалдығым сол қалпында қалады.
Dialogue: 0,0:12:14.48,0:12:15.61,Default,,0,0,0,,Құрметті Кал
Dialogue: 0,0:12:15.69,0:12:19.19,Default,,0,0,0,,Денис шекарасындағы А-Иан-Мейде қалдықтары туралы
Dialogue: 0,0:12:19.28,0:12:20.82,Default,,0,0,0,,Не естідің
Dialogue: 0,0:12:20.90,0:12:23.28,Default,,0,0,0,,Иә, басқа самурай?
Dialogue: 0,0:12:23.36,0:12:24.61,Default,,0,0,0,,Ынви!
Dialogue: 0,0:12:24.70,0:12:28.28,Default,,0,0,0,,Құрметті Ием, сізге мысық ойнау қиынға соғып жатыр ма?
Dialogue: 0,0:12:28.37,0:12:30.08,Default,,0,0,0,,Фугайнай Яцуме
Dialogue: 0,0:12:30.16,0:12:33.00,Default,,0,0,0,,Бірінші жын соғыс генералының есімі мені жылатады!
Dialogue: 0,0:12:33.08,0:12:36.71,Default,,0,0,0,,Абайлаңыз, Батори, Жоғарғы Патшаның алдында.
Dialogue: 0,0:12:37.75,0:12:38.80,Default,,0,0,0,,Цк
Dialogue: 0,0:12:38.88,0:12:40.13,Default,,0,0,0,,Иә
Dialogue: 0,0:12:40.96,0:12:43.01,Default,,0,0,0,,Оны тыңдайық, Ынви.
Dialogue: 0,0:12:43.09,0:12:44.47,Default,,0,0,0,,Га
Dialogue: 0,0:12:44.55,0:12:48.43,Default,,0,0,0,,Бұл самурайлар тобында және біраз уақыттан бері қауесет тараған⸺
Dialogue: 0,0:12:48.51,0:12:51.43,Default,,0,0,0,,Басшы әйелдің шынайы тұлғасы ашылды.
Dialogue: 0,0:12:51.52,0:12:52.68,Default,,0,0,0,,Хо
Dialogue: 0,0:12:52.77,0:12:55.15,Default,,0,0,0,,Ол әйел кім...
Dialogue: 0,0:12:55.23,0:12:56.86,Default,,0,0,0,,Кай Хан?
Dialogue: 0,0:12:56.94,0:12:59.32,Default,,0,0,0,,Сол Кай хан ше?
Dialogue: 0,0:12:59.40,0:13:01.78,Default,,0,0,0,,Ол Кидо Санниншулардың бірі емес пе?
Dialogue: 0,0:13:01.86,0:13:03.03,Default,,0,0,0,,Кай...!
Dialogue: 0,0:13:03.78,0:13:05.24,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:13:05.32,0:13:06.91,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:13:06.99,0:13:11.20,Default,,0,0,0,,Сонымен, сэр, сіз басқа әйелдің түрін де көрдіңіз бе?
Dialogue: 0,0:13:11.29,0:13:13.33,Default,,0,0,0,,Не? Басқа адам?
Dialogue: 0,0:13:14.00,0:13:17.33,Default,,0,0,0,,Бұл адам қаншалықты терең?
Dialogue: 0,0:13:17.42,0:13:22.05,Default,,0,0,0,,Ха, екіншісі Мета-Ликананың бас діни қызметкерінің қызы...
Dialogue: 0,0:13:22.13,0:13:23.51,Default,,0,0,0,,Құсу!
Dialogue: 0,0:13:23.59,0:13:26.51,Default,,0,0,0,,Не! Ал... бұл мүмкін емес...
Dialogue: 0,0:13:27.64,0:13:29.39,Default,,0,0,0,,Йоко…
Dialogue: 0,0:13:30.81,0:13:32.56,Default,,0,0,0,,Yoko деңгейінің ескертпесі!
Dialogue: 0,0:13:34.43,0:13:37.02,Default,,0,0,0,,Ақымақ, сен тірі ме едің?
Dialogue: 0,0:13:37.10,0:13:40.27,Default,,0,0,0,,Бірақ бұл жарылыс қалай өтеді?
Dialogue: 0,0:13:40.82,0:13:42.11,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:13:42.86,0:13:45.74,Default,,0,0,0,,Дүрбелең емес! Бұл жағымсыз, мырзалар.
Dialogue: 0,0:13:45.82,0:13:48.07,Default,,0,0,0,,Шейла әлі тірі.
Dialogue: 0,0:13:48.16,0:13:51.58,Default,,0,0,0,,Йоко деген қыз әлі тірі болса, таң қалмас едім.
Dialogue: 0,0:13:51.66,0:13:52.95,Default,,0,0,0,,Макапин
Dialogue: 0,0:13:54.08,0:13:55.58,Default,,0,0,0,,Құрметті Кал
Dialogue: 0,0:13:55.66,0:13:58.71,Default,,0,0,0,,Бұл мәселеге қатысты менің жоспарым жоқ.
Dialogue: 0,0:13:58.79,0:14:00.92,Default,,0,0,0,,Егер сіз әлдеқашан қадамдар жасаған болсаңыз
Dialogue: 0,0:14:01.46,0:14:04.01,Default,,0,0,0,,Егер сіз Йоко есімді қызды ұстасаңыз,
Dialogue: 0,0:14:04.09,0:14:07.05,Default,,0,0,0,,Мен Шейланың қайда екенін білгім келеді.
Dialogue: 0,0:14:08.84,0:14:12.06,Default,,0,0,0,,Өтінемін, бұл макапейн Тони Штраус.
Dialogue: 0,0:14:12.85,0:14:15.56,Default,,0,0,0,,Маған қалдырыңызшы.
Dialogue: 0,0:14:22.90,0:14:26.78,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:14:37.21,0:14:38.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:55.06,0:14:56.52,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:14:59.85,0:15:02.40,Default,,0,0,0,,Бүгін... Бүгін...
Dialogue: 0,0:15:02.48,0:15:04.82,Default,,0,0,0,,Бүгін не істеп жатырсың? Вай
Dialogue: 0,0:15:04.90,0:15:06.03,Default,,0,0,0,,Удаах!
Dialogue: 0,0:15:06.11,0:15:08.49,Default,,0,0,0,,А, аа... а...
Dialogue: 0,0:15:08.57,0:15:11.36,Default,,0,0,0,,Ах, ахаха, а, жоқ, бұл...
Dialogue: 0,0:15:11.45,0:15:13.20,Default,,0,0,0,,Бизнеске келсек...
Dialogue: 0,0:15:13.28,0:15:17.29,Default,,0,0,0,,Уггья~ Субба Эна Йокоттеба
Dialogue: 0,0:15:19.08,0:15:21.08,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:15:22.00,0:15:23.79,Default,,0,0,0,,Сіз оны шынымен де сонша көргіңіз келе ме?
Dialogue: 0,0:15:23.88,0:15:24.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:28.55,0:15:30.26,Default,,0,0,0,,Менің жалаңаштығым
Dialogue: 0,0:15:30.84,0:15:33.72,Default,,0,0,0,,Не...! Ах...
Dialogue: 0,0:15:33.80,0:15:36.68,Default,,0,0,0,,(Ви жүрек соғысының дыбысы)
Dialogue: 0,0:15:36.76,0:15:39.35,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:15:40.31,0:15:41.44,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:15:46.07,0:15:48.82,Default,,0,0,0,,(Вайдың ауыр тыныс алуы)
Dialogue: 0,0:15:51.36,0:15:53.53,Default,,0,0,0,,Йо… Йоко
Dialogue: 0,0:15:54.32,0:15:57.16,Default,,0,0,0,,жұмсақ ыстық
Dialogue: 0,0:15:57.79,0:15:59.79,Default,,0,0,0,,Сен әдемісің
Dialogue: 0,0:16:01.71,0:16:06.21,Default,,0,0,0,,Йоко Менде бүгін маңызды нәрсе істеу керек.
Dialogue: 0,0:16:06.79,0:16:10.38,Default,,0,0,0,,Бұл мен әрқашан растағым келетін нәрсе.
Dialogue: 0,0:16:10.47,0:16:11.51,Default,,0,0,0,,Енді?
Dialogue: 0,0:16:11.59,0:16:14.18,Default,,0,0,0,,Ертең келетініне кепілдік жоқ.
Dialogue: 0,0:16:14.26,0:16:16.97,Default,,0,0,0,,Нені растағыңыз келеді?
Dialogue: 0,0:16:18.18,0:16:19.35,Default,,0,0,0,,Йоко! (Йоко) Ах.
Dialogue: 0,0:16:19.43,0:16:21.31,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:16:21.39,0:16:25.27,Default,,0,0,0,,(Ви жүрек соғысының дыбысы)
Dialogue: 0,0:16:28.07,0:16:30.44,Default,,0,0,0,,Мен бүгін бара аламын!
Dialogue: 0,0:16:32.49,0:16:33.32,Default,,0,0,0,,Уф
Dialogue: 0,0:16:33.91,0:16:35.20,Default,,0,0,0,,Тексермейсіз бе?
Dialogue: 0,0:16:35.28,0:16:39.70,Default,,0,0,0,,Мен... Ал, мен қазір түсіндім, Йоко.
Dialogue: 0,0:16:40.20,0:16:41.33,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:16:42.04,0:16:45.04,Default,,0,0,0,,Тезірек кетіңіз.
Dialogue: 0,0:16:45.88,0:16:47.96,Default,,0,0,0,,Ваи! (Вай) Сәлем!
Dialogue: 0,0:16:48.04,0:16:50.76,Default,,0,0,0,,Сен тағы да кінәсізсің!
Dialogue: 0,0:16:50.84,0:16:53.13,Default,,0,0,0,,Әйелдің ванна бөлмесіне жасырын кіру деген нені білдіреді?
Dialogue: 0,0:16:53.22,0:16:55.51,Default,,0,0,0,,Самурайдың желге қарсы орналасуына да болады
Dialogue: 0,0:16:55.59,0:16:57.64,Default,,0,0,0,,Күте тұрыңыз! Қанша айтсам да түсінесің!
Dialogue: 0,0:16:57.72,0:16:59.81,Default,,0,0,0,,Мұның бәрі Йоко туралы!
Dialogue: 0,0:16:59.89,0:17:02.43,Default,,0,0,0,,Дінбасылар пышақ ұстай алмайды
Dialogue: 0,0:17:02.52,0:17:03.77,Default,,0,0,0,,Қалаусыздық
Dialogue: 0,0:17:04.48,0:17:06.19,Default,,0,0,0,,Кешіріңіз Вай
Dialogue: 0,0:17:06.98,0:17:10.19,Default,,0,0,0,,Бірақ сәл күте тұрыңыз.
Dialogue: 0,0:17:17.37,0:17:19.33,Default,,0,0,0,,Мифунэ-саманың танымал болуына байланысты
Dialogue: 0,0:17:19.41,0:17:22.79,Default,,0,0,0,,Қуғын-сүргінге ұшыраған азаматтар бірінен соң бірі көтеріледі.
Dialogue: 0,0:17:22.87,0:17:25.54,Default,,0,0,0,,Көтерілісші күштердің саны тұрақты түрде артып келеді.
Dialogue: 0,0:17:25.62,0:17:27.17,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:17:27.25,0:17:30.92,Default,,0,0,0,,Үнемі өсіп келе жатқан көтерілісшілер әскерін қолдау үшін самурайлар жеткіліксіз
Dialogue: 0,0:17:31.46,0:17:35.38,Default,,0,0,0,,Еріксіз аз адаммен жауап беруден басқа амалымыз жоқ
Dialogue: 0,0:17:35.47,0:17:36.97,Default,,0,0,0,,Ахахаха! Қандай қызық.
Dialogue: 0,0:17:37.05,0:17:38.05,Default,,0,0,0,,Ах
Dialogue: 0,0:17:40.68,0:17:41.81,Default,,0,0,0,,Кай
Dialogue: 0,0:17:41.89,0:17:44.35,Default,,0,0,0,,Ойланып тұрып қылышты сермесем де
Dialogue: 0,0:17:44.43,0:17:46.73,Default,,0,0,0,,Ол саған жабыспайды, Джошуа.
Dialogue: 0,0:17:46.81,0:17:49.31,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:17:49.40,0:17:52.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Жеңіл жанасу және т.б.
Dialogue: 0,0:17:52.36,0:17:55.90,Default,,0,0,0,,Бұл күтпеген ұсыныс.
Dialogue: 0,0:17:57.91,0:17:59.45,Default,,0,0,0,,Мен мұны осында қалдырамын.
Dialogue: 0,0:17:59.53,0:18:01.41,Default,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:18:09.50,0:18:10.50,Default,,0,0,0,,Апай
Dialogue: 0,0:18:10.59,0:18:12.84,Default,,0,0,0,,Иә? Жақсы Йоко
Dialogue: 0,0:18:12.92,0:18:16.55,Default,,0,0,0,,Бүгін тағы бір үлкен жеңіс болды деп естідім.
Dialogue: 0,0:18:16.63,0:18:19.30,Default,,0,0,0,,Бұл қыста аштықтан өлу санын айтарлықтай азайтады.
Dialogue: 0,0:18:19.39,0:18:20.60,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:21.26,0:18:24.18,Default,,0,0,0,,Бірақ құрбандар да көп болды.
Dialogue: 0,0:18:24.27,0:18:26.23,Default,,0,0,0,,Азаматтар да, самурайлар да...
Dialogue: 0,0:18:32.02,0:18:35.32,Default,,0,0,0,,Сен өте жақсы істеп жатырсың, Йоко.
Dialogue: 0,0:18:35.40,0:18:37.65,Default,,0,0,0,,Мен өте жақсы түсінемін.
Dialogue: 0,0:18:37.74,0:18:39.03,Default,,0,0,0,,Апай
Dialogue: 0,0:18:39.74,0:18:42.58,Default,,0,0,0,,Кел, кел, дымқыл болма.
Dialogue: 0,0:18:42.66,0:18:44.66,Default,,0,0,0,,Рубо, мені кешкі асқа апар.
Dialogue: 0,0:18:45.29,0:18:46.29,Default,,0,0,0,,Иә
Dialogue: 0,0:18:47.41,0:18:49.92,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Йоко
Dialogue: 0,0:18:51.38,0:18:56.34,Default,,0,0,0,,Уншо Уншо Уншо...
Dialogue: 0,0:18:56.42,0:18:57.42,Default,,0,0,0,,Агия
Dialogue: 0,0:18:59.43,0:19:01.18,Default,,0,0,0,,Бітті
Dialogue: 0,0:19:01.26,0:19:02.97,Default,,0,0,0,,Рути Кун
Dialogue: 0,0:19:03.05,0:19:04.43,Default,,0,0,0,,Түскі асқа барайық
Dialogue: 0,0:19:04.51,0:19:10.06,Default,,0,0,0,,Ах Йоко-сан, үйге қош келдіңіз хахаха
Dialogue: 0,0:19:10.81,0:19:12.56,Default,,0,0,0,,Енді, Люс
Dialogue: 0,0:19:13.69,0:19:16.07,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:19:16.15,0:19:19.53,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:19:19.61,0:19:21.03,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:19:21.11,0:19:23.70,Default,,0,0,0,,Люси-кун, тезірек ішке кірейік.
Dialogue: 0,0:19:23.78,0:19:26.41,Default,,0,0,0,,А-а, кір...
Dialogue: 0,0:19:28.50,0:19:30.96,Default,,0,0,0,,Туған күніңмен Люси-кун
Dialogue: 0,0:19:31.04,0:19:32.92,Default,,0,0,0,,Мен бүгін 17 жастамын.
Dialogue: 0,0:19:33.00,0:19:34.42,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:34.50,0:19:37.38,Default,,0,0,0,,Ю... 17 бұл жігіт пе?
Dialogue: 0,0:19:38.01,0:19:39.84,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:19:41.01,0:19:43.39,Default,,0,0,0,,Сіз қалай ойлайсыз? Люси-кун, дәмді ме?
Dialogue: 0,0:19:43.47,0:19:45.05,Default,,0,0,0,,Дәмді
Dialogue: 0,0:19:45.81,0:19:48.02,Default,,0,0,0,,Беттеріңде тамақ бар.
Dialogue: 0,0:19:48.72,0:19:49.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:51.56,0:19:55.44,Default,,0,0,0,,Уууу, сен әрқашан шындап жейсің.
Dialogue: 0,0:19:55.52,0:19:59.61,Default,,0,0,0,,Қарғыс атсын, екі жыл өтсе де мүлде өспеді.
Dialogue: 0,0:19:59.69,0:20:01.53,Default,,0,0,0,,Ұрыста қолдар мен аяқтар
Dialogue: 0,0:20:01.61,0:20:04.03,Default,,0,0,0,,Мен де жаттығуда жақсы емеспін.
Dialogue: 0,0:20:04.12,0:20:06.28,Default,,0,0,0,,Оған көмектесу мүмкін емес, адам ретінде.
Dialogue: 0,0:20:06.37,0:20:11.25,Default,,0,0,0,,Оның үстіне сіз кірден басқаның бәріне қабілетсізсіз!
Dialogue: 0,0:20:11.33,0:20:13.12,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:20:13.83,0:20:15.00,Default,,0,0,0,,Ga!
Dialogue: 0,0:20:15.79,0:20:20.46,Default,,0,0,0,,Сәлем! Люси-кун туралы жаман сөз айтпа, бұзық.
Dialogue: 0,0:20:20.55,0:20:23.93,Default,,0,0,0,,Мен оған тек екі адамның жұмысын істеуім керек.
Dialogue: 0,0:20:24.01,0:20:26.89,Default,,0,0,0,,Қорат, сен бізбен бірге күлсең не істейміз!
Dialogue: 0,0:20:26.97,0:20:28.06,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:20:28.14,0:20:30.77,Default,,0,0,0,,Вай Йоко дұрыс айтады.
Dialogue: 0,0:20:30.85,0:20:34.48,Default,,0,0,0,,Сенің адамдарға күлуге хақың жоқ, әй, көз тіккен шайтан!
Dialogue: 0,0:20:34.56,0:20:36.27,Default,,0,0,0,,О, дұрыс!
Dialogue: 0,0:20:36.36,0:20:37.77,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:37.86,0:20:39.53,Default,,0,0,0,,Жалпы айтқанда, неге?
Dialogue: 0,0:20:39.61,0:20:41.99,Default,,0,0,0,,Мен Йоконың дәл қасында отырмын!
Dialogue: 0,0:20:42.07,0:20:44.57,Default,,0,0,0,,Бұл жақсы. Бұл жерде ештеңе жоқ!
Dialogue: 0,0:20:44.66,0:20:46.12,Default,,0,0,0,,Сіз де күлетін едіңіз.
Dialogue: 0,0:20:46.20,0:20:47.95,Default,,0,0,0,,Қарапайым бейбақ!
Dialogue: 0,0:20:48.03,0:20:49.66,Default,,0,0,0,,Люс Ренренде
Dialogue: 0,0:20:49.74,0:20:52.29,Default,,0,0,0,,Бұл жарылғыш сиқыршы Дирк Шнайдер
Dialogue: 0,0:20:52.37,0:20:54.12,Default,,0,0,0,,Не мөрленген?
Dialogue: 0,0:20:55.75,0:20:58.00,Default,,0,0,0,,Оның шын екенін білсеңіз де
Dialogue: 0,0:20:58.09,0:21:00.38,Default,,0,0,0,,Сонда да сену қиын
Dialogue: 0,0:21:00.46,0:21:02.84,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:21:03.67,0:21:08.43,Default,,0,0,0,,Соңғы екі жылда Йоко ашылу салтанатын бірнеше рет орындағанына қарамастан.
Dialogue: 0,0:21:08.51,0:21:10.64,Default,,0,0,0,,Ол ешқашан келмеді
Dialogue: 0,0:21:11.97,0:21:14.35,Default,,0,0,0,,Сонымен, ақыр соңында
Dialogue: 0,0:21:14.89,0:21:18.73,Default,,0,0,0,,Дирк Шнайдердің екі жыл бұрын Абигейлмен жекпе-жегі кезінде...
Dialogue: 0,0:21:19.94,0:21:21.32,Default,,0,0,0,,Шаааах!
Dialogue: 0,0:21:21.40,0:21:23.95,Default,,0,0,0,,Не? О, жоқ...
Dialogue: 0,0:21:24.03,0:21:27.32,Default,,0,0,0,,Ашылу салтанатын орындауда ақау болуы мүмкін.
Dialogue: 0,0:21:27.41,0:21:29.66,Default,,0,0,0,,Қазіргі жағдайдан шығу үшін
Dialogue: 0,0:21:29.74,0:21:31.95,Default,,0,0,0,,Ашылу салтанатын Йоконың орнында өткіземін...
Dialogue: 0,0:21:32.04,0:21:34.04,Default,,0,0,0,,Бұл жақсы емес! иә?
Dialogue: 0,0:21:34.12,0:21:36.37,Default,,0,0,0,,Не болды? Джошуа
Dialogue: 0,0:21:36.46,0:21:39.88,Default,,0,0,0,,Жоқ... жоқ... Кешіріңіз.
Dialogue: 0,0:21:45.38,0:21:49.51,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:49.60,0:21:53.77,Default,,0,0,0,,Немесе... Қақпалар ашылды! Қақпа ашық!
Dialogue: 0,0:21:55.89,0:21:57.65,Default,,0,0,0,,Бұл... қиын, Джошуа!
Dialogue: 0,0:21:57.73,0:21:58.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:59.86,0:22:01.65,Default,,0,0,0,,Йоко, дереу кел!
Dialogue: 0,0:22:01.73,0:22:03.36,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:22:03.44,0:22:06.74,Default,,0,0,0,,Йо... Йорг... Йорг...
Dialogue: 0,0:22:08.11,0:22:09.91,Default,,0,0,0,,Кел... кел
Dialogue: 0,0:22:11.08,0:22:15.25,Default,,0,0,0,,Мынау... міне, генерал жын...
Dialogue: 0,0:22:16.08,0:22:17.37,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:22:20.96,0:22:22.96,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.05,0:23:50.05,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.55,0:23:57.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory