Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.15,0:00:35.91,Default,,0,0,0,,Егер сен бізге мәңгілік адалдығыңды ант етсең,
Dialogue: 0,0:00:36.57,0:00:39.41,Default,,0,0,0,,Осы қаладағы адамдардың өміріне кепілдік берейік.
Dialogue: 0,0:00:42.20,0:00:44.83,Default,,0,0,0,,Материктің ортасында Металлионның бірігуі
Dialogue: 0,0:00:46.46,0:00:51.59,Default,,0,0,0,,Адамдар аумақ үшін ұсқынсыз күресуді жалғастыратын қоғамнан қашу
Dialogue: 0,0:00:51.67,0:00:54.05,Default,,0,0,0,,Өзіңді қолыңа ал.
Dialogue: 0,0:00:57.72,0:00:59.30,Default,,0,0,0,,Куку куку...
Dialogue: 0,0:00:59.39,0:01:01.01,Default,,0,0,0,,Бұл қаланың трагедиясы
Dialogue: 0,0:01:01.10,0:01:04.35,Default,,0,0,0,,Жанжалсыз жаңа әлемді жүзеге асыру⸺
Dialogue: 0,0:01:05.19,0:01:06.81,Default,,0,0,0,,Реформаның азабы
Dialogue: 0,0:01:08.61,0:01:09.82,Default,,0,0,0,,Сондай-ақ... егер
Dialogue: 0,0:01:09.90,0:01:13.53,Default,,0,0,0,,Ант бермеймін десем ше? Уф...
Dialogue: 0,0:01:14.15,0:01:15.99,Default,,0,0,0,,Барлығын жоғалтыңыз
Dialogue: 0,0:01:16.66,0:01:19.87,Default,,0,0,0,,Отбасы, мүлік және аумақ
Dialogue: 0,0:01:21.41,0:01:25.83,Default,,0,0,0,,Екі жыл бұрын Мета-Ликана сарайы мүлдем жоғалып кеткендей болды...
Dialogue: 0,0:01:27.29,0:01:30.50,Default,,0,0,0,,Жарылғыш жалын шебері Қараңғы Шнайдер
Dialogue: 0,0:01:30.59,0:01:33.55,Default,,0,0,0,,Бізді ештеңе тоқтата алмады.
Dialogue: 0,0:01:33.63,0:01:37.38,Default,,0,0,0,,А... анау аңызға айналған сиқыршы?
Dialogue: 0,0:01:38.09,0:01:39.60,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:01:40.26,0:01:43.89,Default,,0,0,0,,Ірі қалалардың 90% қазірдің өзінде Металлионда орналасқан.
Dialogue: 0,0:01:43.97,0:01:45.56,Default,,0,0,0,,Бізге адал болуға ант берді
Dialogue: 0,0:01:45.64,0:01:48.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:48.10,0:01:50.11,Default,,0,0,0,,Мен сенің де ант бергеніңді қалаймын.
Dialogue: 0,0:01:50.73,0:01:51.98,Default,,0,0,0,,Және…
Dialogue: 0,0:01:54.15,0:01:57.95,Default,,0,0,0,,Жанжалсыз жаңа әлем жасаңыз.
Dialogue: 0,0:01:58.82,0:02:03.04,Default,,0,0,0,,Біз Қалмен бірге Жоғарғы Патшамыз.
Dialogue: 0,0:02:04.62,0:02:07.83,Default,,0,0,0,,Жек көру
Dialogue: 0,0:02:08.67,0:02:11.54,Default,,0,0,0,,Қарғыс атсын мына мөр.
Dialogue: 0,0:02:12.38,0:02:14.21,Default,,0,0,0,,Бұл шешілсе
Dialogue: 0,0:02:14.80,0:02:19.09,Default,,0,0,0,,Мен өзім жерге келіп, шытырмандарды шашамын.
Dialogue: 0,0:02:20.30,0:02:22.43,Default,,0,0,0,,Асығыңыз, Кал.
Dialogue: 0,0:02:22.93,0:02:25.97,Default,,0,0,0,,Соңғы пломбаны мүмкіндігінше тез ашыңыз
Dialogue: 0,0:02:29.02,0:02:31.44,Default,,0,0,0,,Мен оның алдында
Dialogue: 0,0:02:32.27,0:02:36.03,Default,,0,0,0,,Біз жойылатын құдай Антрасаксты тірілтеміз.
Dialogue: 0,0:02:51.42,0:02:53.17,Default,,0,0,0,,Күн суып барады.
Dialogue: 0,0:02:53.96,0:02:55.96,Default,,0,0,0,,Алыста Яһуда елінде⸺
Dialogue: 0,0:02:56.05,0:02:57.67,Default,,0,0,0,,Сол адамның сиқырлы күші
Dialogue: 0,0:02:57.76,0:03:00.30,Default,,0,0,0,,Бұл жерге де суық ауа әкеле ме?
Dialogue: 0,0:03:01.22,0:03:05.43,Default,,0,0,0,,Осындай шалғай аймаққа келгенде, ізі жоқ.
Dialogue: 0,0:03:06.35,0:03:07.64,Default,,0,0,0,,Асығу керек
Dialogue: 0,0:03:08.14,0:03:12.69,Default,,0,0,0,,Сол кісінің көне құжаттардан талданған қиямет күніне санаулы күндер қалды.
Dialogue: 0,0:03:13.81,0:03:16.07,Default,,0,0,0,,Мета-Ликана корольдік сарайы жоғалып кеткеннен бері
Dialogue: 0,0:03:16.15,0:03:20.11,Default,,0,0,0,,Біз не болса да жетіспейтін соңғы мөрді табуымыз керек.
Dialogue: 0,0:03:21.11,0:03:22.32,Default,,0,0,0,,Демон генерал
Dialogue: 0,0:03:22.41,0:03:24.03,Default,,0,0,0,,Ингви фон Малмстиндікі
Dialogue: 0,0:03:24.12,0:03:25.78,Default,,0,0,0,,Аты үшін
Dialogue: 0,0:03:25.87,0:03:27.70,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:03:28.87,0:03:30.16,Default,,0,0,0,,Лорд Ынви
Dialogue: 0,0:03:30.75,0:03:34.67,Default,,0,0,0,,Азаматтық көтерілісшілер біздің әскерилердің азық-түлік дүкендеріне шабуыл жасауда.
Dialogue: 0,0:03:35.25,0:03:36.34,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:03:36.84,0:03:39.13,Default,,0,0,0,,Азамат сияқты үрейленбе
Dialogue: 0,0:03:39.21,0:03:40.63,Default,,0,0,0,,Қалыпты әрекетті орындаңыз.
Dialogue: 0,0:03:41.22,0:03:43.30,Default,,0,0,0,,Олардың бәрін өлтірсем де, бәрібір.
Dialogue: 0,0:03:43.39,0:03:44.89,Default,,0,0,0,,Міне... болды.
Dialogue: 0,0:03:45.76,0:03:48.77,Default,,0,0,0,,А-Иан-Мейде самурайларының қалдықтары жол көрсетеді.
Dialogue: 0,0:03:48.85,0:03:49.85,Default,,0,0,0,,Не?
Dialogue: 0,0:03:49.93,0:03:51.14,Default,,0,0,0,,Самурай?
Dialogue: 0,0:03:52.14,0:03:56.86,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,0:03:57.94,0:03:59.36,Default,,0,0,0,,О!
Dialogue: 0,0:04:01.32,0:04:02.45,Default,,0,0,0,,Уау
Dialogue: 0,0:04:03.95,0:04:05.82,Default,,0,0,0,,(Көрермен) Сонымен, Мидория соңғы сегіздіктен шығып қалды ғой?
Dialogue: 0,0:04:05.91,0:04:07.37,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:04:07.45,0:04:10.29,Default,,0,0,0,,Демон генерал өзінің негізгі күшін әкелгенге дейін
Dialogue: 0,0:04:10.37,0:04:12.92,Default,,0,0,0,,Азаматтардың тамағын қайтарып алу.
Dialogue: 0,0:04:13.00,0:04:13.79,Default,,0,0,0,,Ах
Dialogue: 0,0:04:13.87,0:04:15.96,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:04:16.04,0:04:17.63,Default,,0,0,0,,Орктар
Dialogue: 0,0:04:17.71,0:04:19.09,Default,,0,0,0,,Біз адамдар⸺
Dialogue: 0,0:04:19.17,0:04:21.67,Default,,0,0,0,,Менің ойымша, сізді жай ғана басып жатыр!
Dialogue: 0,0:04:21.76,0:04:24.59,Default,,0,0,0,,Жалынды толқындарды же!
Dialogue: 0,0:04:24.68,0:04:26.22,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:26.30,0:04:27.64,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:04:27.72,0:04:30.77,Default,,0,0,0,,Вай, азық-түлік қоймасын бүлдірме.
Dialogue: 0,0:04:30.85,0:04:32.56,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:04:32.64,0:04:33.77,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:04:35.48,0:04:36.90,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:41.32,0:04:45.53,Default,,0,0,0,,Дохи~! цу... күшті
Dialogue: 0,0:04:45.61,0:04:48.95,Default,,0,0,0,,Оның қылыш шеберлігі шеберлік сабағы.
Dialogue: 0,0:04:49.03,0:04:52.66,Default,,0,0,0,,Оның үстіне, ол тіпті сиқыршыларды қолданады.
Dialogue: 0,0:04:52.75,0:04:57.13,Default,,0,0,0,,Соғыс топтары көп болғандықтан, бұл патшалық жаулап алынды!
Dialogue: 0,0:04:57.21,0:04:58.75,Default,,0,0,0,,Мен сенбеймін
Dialogue: 0,0:05:00.34,0:05:02.80,Default,,0,0,0,,Жүр, қазір тамақ ал.
Dialogue: 0,0:05:02.88,0:05:04.22,Default,,0,0,0,,Барлығы
Dialogue: 0,0:05:04.30,0:05:07.26,Default,,0,0,0,,Самурайлар тобы жауды тоқтатқанда,
Dialogue: 0,0:05:07.34,0:05:11.31,Default,,0,0,0,,Салықты көбейту арқылы сығымдалған егінді қайтарып алайық.
Dialogue: 0,0:05:11.39,0:05:14.10,Default,,0,0,0,,Асығыңыз! (Азаматтар) Келіңдер!
Dialogue: 0,0:05:14.69,0:05:17.40,Default,,0,0,0,,Бұл біздің тағамымыз болды.
Dialogue: 0,0:05:17.48,0:05:19.65,Default,,0,0,0,,Ой... Жақсы.
Dialogue: 0,0:05:19.73,0:05:23.40,Default,,0,0,0,,Енді біздің балалар биылғы қыста аштан өлмейді.
Dialogue: 0,0:05:23.49,0:05:25.82,Default,,0,0,0,,Жүр, тез орындайық.
Dialogue: 0,0:05:25.90,0:05:28.41,Default,,0,0,0,,Балалар қарны ашып, күтіп отыр.
Dialogue: 0,0:05:28.49,0:05:30.20,Default,,0,0,0,,көремін. (Азамат) А.
Dialogue: 0,0:05:30.70,0:05:33.04,Default,,0,0,0,,Балалар аштан өліп жатыр ма?
Dialogue: 0,0:05:33.66,0:05:35.66,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:05:35.75,0:05:36.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:36.67,0:05:37.87,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:05:37.96,0:05:41.84,Default,,0,0,0,,Сіз құлдарға бүлік шығаруға болмайды.
Dialogue: 0,0:05:43.76,0:05:45.76,Default,,0,0,0,,Қылмыс жазалануы керек
Dialogue: 0,0:05:46.68,0:05:48.51,Default,,0,0,0,,Бұл да
Dialogue: 0,0:05:48.59,0:05:52.81,Default,,0,0,0,,Жоғарғы Патшаның соңынан ерген жындар қолбасшысының рөлі
Dialogue: 0,0:05:53.52,0:05:55.14,Default,,0,0,0,,Жақсарып келеді.
Dialogue: 0,0:05:55.23,0:05:57.02,Default,,0,0,0,,Иә? Айқай ма?
Dialogue: 0,0:05:57.10,0:05:58.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:58.48,0:06:00.86,Default,,0,0,0,,Қоймада, мен білмей тұрып
Dialogue: 0,0:06:00.94,0:06:02.36,Default,,0,0,0,,Әрі қарай жалғастырыңыздар!
Dialogue: 0,0:06:02.44,0:06:03.44,Default,,0,0,0,,Уф
Dialogue: 0,0:06:06.40,0:06:07.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:08.53,0:06:09.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:18.50,0:06:19.62,Default,,0,0,0,,Самурай...
Dialogue: 0,0:06:20.21,0:06:23.21,Default,,0,0,0,,Сәлеметсіз бе... Қош келдіңіз!
Dialogue: 0,0:06:24.38,0:06:26.09,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:06:26.17,0:06:28.63,Default,,0,0,0,,Қарғыс атқан жын генерал!
Dialogue: 0,0:06:28.72,0:06:30.05,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:06:30.14,0:06:31.60,Default,,0,0,0,,Күтіңіз!
Dialogue: 0,0:06:31.68,0:06:33.93,Default,,0,0,0,,Жалғыз жүрме. Сен өлесің. (Вай) Хана... Мені жіберіңізші.
Dialogue: 0,0:06:34.51,0:06:38.02,Default,,0,0,0,,Жын генерал, сенің жалғыз қалғаның біртүрлі.
Dialogue: 0,0:06:38.10,0:06:39.64,Default,,0,0,0,,Миниондарға не болды?
Dialogue: 0,0:06:39.73,0:06:42.48,Default,,0,0,0,,Мен сонша самураймен бетпе-бет келемін деп ойламадым.
Dialogue: 0,0:06:42.56,0:06:45.28,Default,,0,0,0,,Сіз жалғыз соғысуды жоспарлап отырған жоқсыз, солай ма?
Dialogue: 0,0:06:45.36,0:06:49.20,Default,,0,0,0,,Хмм, мен өзімді онша мақтаншақпын деп ойламаймын.
Dialogue: 0,0:06:50.24,0:06:53.45,Default,,0,0,0,,Менің естігенім бойынша самурайдың «шикитари»
Dialogue: 0,0:06:53.53,0:06:56.45,Default,,0,0,0,,«Көп-бір шайқас болмайды» деген емес пе?
Dialogue: 0,0:06:56.54,0:06:57.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:59.00,0:07:00.42,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:01.21,0:07:03.38,Default,,0,0,0,,«Бушидо» деп аталады.
Dialogue: 0,0:07:03.46,0:07:05.67,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:07:05.75,0:07:08.67,Default,,0,0,0,,Бірақ таза және асыл рух.
Dialogue: 0,0:07:09.26,0:07:12.18,Default,,0,0,0,,Оны ронин ретінде қалдыру ұят.
Dialogue: 0,0:07:13.43,0:07:17.77,Default,,0,0,0,,Сіз Жоғарғы Патшаның тамаша рыцарларын жасайсыз.
Dialogue: 0,0:07:17.85,0:07:20.06,Default,,0,0,0,,Неліктен Калдың соңынан ермейсің?
Dialogue: 0,0:07:20.14,0:07:22.06,Default,,0,0,0,,Мен не білдім
Dialogue: 0,0:07:22.77,0:07:24.86,Default,,0,0,0,,Самурай екі мырзаға қызмет етпейді.
Dialogue: 0,0:07:25.44,0:07:27.82,Default,,0,0,0,,Оны Бушидо деп те атайды.
Dialogue: 0,0:07:27.90,0:07:29.03,Default,,0,0,0,,Шынында да
Dialogue: 0,0:07:29.74,0:07:31.78,Default,,0,0,0,,Сонымен қатар, Бушидода мыналар бар:
Dialogue: 0,0:07:31.86,0:07:34.37,Default,,0,0,0,,Қожайыныңыз өкінішпен өлгенде
Dialogue: 0,0:07:34.95,0:07:37.33,Default,,0,0,0,,Жауыңның кек алу үшін өз өміріңді қатерге тігу керек.
Dialogue: 0,0:07:37.91,0:07:39.37,Default,,0,0,0,,Бұл «адалдық» деп аталады
Dialogue: 0,0:07:40.46,0:07:41.87,Default,,0,0,0,,Демон генерал
Dialogue: 0,0:07:41.96,0:07:44.75,Default,,0,0,0,,«Адалдықпен» мен сенімен айналысамын!
Dialogue: 0,0:07:45.54,0:07:47.30,Default,,0,0,0,,Атыңызды сұрайын ба?
Dialogue: 0,0:07:49.21,0:07:52.55,Default,,0,0,0,,Самурай шебері Джошуа Белахия
Dialogue: 0,0:07:53.05,0:07:55.60,Default,,0,0,0,,О, сен бұл...
Dialogue: 0,0:07:56.81,0:07:59.22,Default,,0,0,0,,Бұрыштарды кесудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:08:01.31,0:08:05.23,Default,,0,0,0,,Жын жауынгері, тонауды енді қайталамаңыз.
Dialogue: 0,0:08:05.31,0:08:06.44,Default,,0,0,0,,Күлуді тоқтатыңыз
Dialogue: 0,0:08:06.94,0:08:09.90,Default,,0,0,0,,Қазір талан-таражға түскен сен емес пе?
Dialogue: 0,0:08:09.99,0:08:12.95,Default,,0,0,0,,Ұрланған нәрсені қайтарып алу үшін күресу
Dialogue: 0,0:08:13.45,0:08:15.32,Default,,0,0,0,,Бұл да «адалдық» болады
Dialogue: 0,0:08:17.08,0:08:21.08,Default,,0,0,0,,Дегенмен, біз де логистиканы жоғалта алмаймыз.
Dialogue: 0,0:08:26.88,0:08:30.34,Default,,0,0,0,,Қараңдар... жын генералдың сауытында сызат бар.
Dialogue: 0,0:08:30.84,0:08:32.30,Default,,0,0,0,,Ешуа күткендей
Dialogue: 0,0:08:32.84,0:08:35.68,Default,,0,0,0,,Бұл біздің күшіміз екенін көрдіңіз бе?
Dialogue: 0,0:08:35.76,0:08:38.10,Default,,0,0,0,,Бриллиант... айтайық
Dialogue: 0,0:08:38.93,0:08:42.68,Default,,0,0,0,,Менің ұзын қылышымды аз да болса айналып өттіңіз.
Dialogue: 0,0:08:43.64,0:08:44.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.81,0:08:46.02,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:08:46.69,0:08:48.44,Default,,0,0,0,,Бұл жындардың қолбасшысы
Dialogue: 0,0:08:48.52,0:08:51.28,Default,,0,0,0,,Ингви фон Малмстиннің қабілеті?
Dialogue: 0,0:08:51.94,0:08:52.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:54.95,0:08:57.49,Default,,0,0,0,,Бетіңіз таныс сияқты.
Dialogue: 0,0:08:58.33,0:08:59.87,Default,,0,0,0,,Түсіндім, сен...
Dialogue: 0,0:08:59.95,0:09:00.83,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:09:00.91,0:09:01.91,Default,,0,0,0,,Зеонның...
Dialogue: 0,0:09:02.00,0:09:02.91,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:09:03.41,0:09:06.83,Default,,0,0,0,,Мен сенімен айналысатын адам болуым керек.
Dialogue: 0,0:09:08.00,0:09:09.21,Default,,0,0,0,,Білсең де
Dialogue: 0,0:09:10.00,0:09:10.92,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:09:11.42,0:09:12.63,Default,,0,0,0,,Күте тұрыңыз, Джошуа
Dialogue: 0,0:09:14.42,0:09:18.60,Default,,0,0,0,,Самурай шебері мен демон генерал - жақсы айырбас.
Dialogue: 0,0:09:18.68,0:09:21.64,Default,,0,0,0,,Не? О... сен
Dialogue: 0,0:09:23.35,0:09:24.56,Default,,0,0,0,,Кай Хан!
Dialogue: 0,0:09:26.23,0:09:28.86,Default,,0,0,0,,Егер сіз жын соғысының генералдарының бірін жеңе алсаңыз да.
Dialogue: 0,0:09:28.94,0:09:30.77,Default,,0,0,0,,Самурай шеберінен айырылу
Dialogue: 0,0:09:30.86,0:09:34.49,Default,,0,0,0,,А-Иан-Мейде рониндері де көшеде адасып қалады.
Dialogue: 0,0:09:36.74,0:09:38.99,Default,,0,0,0,,Маған мұны шешуге рұқсат етіңіз.
Dialogue: 0,0:09:39.99,0:09:40.91,Default,,0,0,0,,Кай…
Dialogue: 0,0:09:41.45,0:09:42.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:43.25,0:09:46.08,Default,,0,0,0,,Самурайлар тобында, шеберден өзгеше⸺
Dialogue: 0,0:09:46.16,0:09:48.92,Default,,0,0,0,,Бір әйел басшы болыпты деген қауесет тарады.
Dialogue: 0,0:09:49.50,0:09:50.92,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,0:09:51.00,0:09:52.63,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:09:52.71,0:09:58.18,Default,,0,0,0,,Кидошудың ескі жауы сізбен бірге самурай жұмыс істеп жатқанына таң қалдым.
Dialogue: 0,0:09:58.84,0:10:01.85,Default,,0,0,0,,Мм, белгілі бір адамның арашалауымен.
Dialogue: 0,0:10:01.93,0:10:03.43,Default,,0,0,0,,Белгілі бір адам?
Dialogue: 0,0:10:04.56,0:10:07.39,Default,,0,0,0,,Самурайларға Кидошуды қабылдаңыз
Dialogue: 0,0:10:07.48,0:10:08.90,Default,,0,0,0,,Ондай адам бар ма?
Dialogue: 0,0:10:09.81,0:10:12.73,Default,,0,0,0,,Өлгенде білудің қажеті жоқ.
Dialogue: 0,0:10:13.32,0:10:15.74,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:10:16.28,0:10:17.36,Default,,0,0,0,,Ешуа
Dialogue: 0,0:10:17.45,0:10:20.41,Default,,0,0,0,,Жоқ, мен мұны оған қалдырамын.
Dialogue: 0,0:10:20.49,0:10:24.87,Default,,0,0,0,,Әй, анау әйел жасайтын шығар.
Dialogue: 0,0:10:24.95,0:10:26.16,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:27.16,0:10:30.50,Default,,0,0,0,,Кальдың сиқыры шақырған суық ауаның әсерінен дәндер қурап қалады.
Dialogue: 0,0:10:30.58,0:10:32.71,Default,,0,0,0,,Аңдар жоғалып кетеді
Dialogue: 0,0:10:32.79,0:10:36.67,Default,,0,0,0,,Балалар аштан өледі, ересектер мәжбүрлі еңбекке тартылады
Dialogue: 0,0:10:36.76,0:10:41.51,Default,,0,0,0,,Соңғы екі жылда бұл аймақтағы қалалар мен ауылдар айтарлықтай өзгерді.
Dialogue: 0,0:10:42.01,0:10:45.35,Default,,0,0,0,,Күндіз қара орктар мен гоблиндер
Dialogue: 0,0:10:45.43,0:10:48.27,Default,,0,0,0,,Сіз оны меншігіңіздей кейіпте жүріп, қалағаныңызды жасай аласыз.
Dialogue: 0,0:10:49.02,0:10:50.15,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:10:50.65,0:10:53.77,Default,,0,0,0,,Калус екеуің айтып отырған идеалды қоғам осы ма?
Dialogue: 0,0:10:54.36,0:10:55.69,Default,,0,0,0,,Осындай нәрсе үшін
Dialogue: 0,0:10:55.78,0:10:58.19,Default,,0,0,0,,Біз Кидошу соғысуға мәжбүр болдық па?
Dialogue: 0,0:10:58.90,0:11:01.70,Default,,0,0,0,,Сіз мұны біртүрлі деп ойламайсыз ба!
Dialogue: 0,0:11:01.78,0:11:03.53,Default,,0,0,0,,Каль жолы
Dialogue: 0,0:11:05.91,0:11:08.33,Default,,0,0,0,,Өзгеріс ауырсынумен бірге келеді.
Dialogue: 0,0:11:08.41,0:11:11.04,Default,,0,0,0,,Азаптан асқан мұрат бар
Dialogue: 0,0:11:11.54,0:11:15.38,Default,,0,0,0,,Адамдарды аяусыз таптау идеалы қандай?
Dialogue: 0,0:11:15.46,0:11:17.05,Default,,0,0,0,,ақылсыз
Dialogue: 0,0:11:17.13,0:11:19.26,Default,,0,0,0,,Сіз және Кал
Dialogue: 0,0:11:19.34,0:11:22.55,Default,,0,0,0,,Мен өзімді қорлауды ғана қабылдаймын.
Dialogue: 0,0:11:23.05,0:11:27.18,Default,,0,0,0,,Бірақ ол кісіні балағаттауыма рұқсат жоқ!
Dialogue: 0,0:11:29.23,0:11:30.23,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:30.31,0:11:32.15,Default,,0,0,0,,Түнгі император семсер!
Dialogue: 0,0:11:32.65,0:11:35.15,Default,,0,0,0,,Гах... ха...
Dialogue: 0,0:11:35.23,0:11:36.36,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:11:36.44,0:11:38.99,Default,,0,0,0,,Көрдіңіз бе...? қазіргі қылышшы
Dialogue: 0,0:11:39.07,0:11:42.07,Default,,0,0,0,,Жоқ, мен оны көре алмадым. Бір сәт бірдеңе жарқырап тұрғандай болды.
Dialogue: 0,0:11:42.16,0:11:43.32,Default,,0,0,0,,(Серо) Бастамас бұрын мен бұл жай ғана әуесқой деңгейде болады деп уайымдадым—
Dialogue: 0,0:11:43.41,0:11:44.78,Default,,0,0,0,,Кай! Жүгіріп кету!
Dialogue: 0,0:11:44.87,0:11:47.95,Default,,0,0,0,,Мен дыбыстан жоғары соққыдан қорықтым.
Dialogue: 0,0:11:48.58,0:11:50.21,Default,,0,0,0,,Бірақ солай.
Dialogue: 0,0:11:50.29,0:11:51.50,Default,,0,0,0,,Түнгі круиз…
Dialogue: 0,0:11:51.58,0:11:53.12,Default,,0,0,0,,Зұлым қаңқа тас түйіні!
Dialogue: 0,0:11:54.08,0:11:55.96,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:56.04,0:11:57.67,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:57.75,0:11:59.63,Default,,0,0,0,,Не? бұл!
Dialogue: 0,0:11:59.71,0:12:02.68,Default,,0,0,0,,Жарайсыңдар! Таусыздану сиқырымен басып алынған
Dialogue: 0,0:12:02.76,0:12:03.97,Default,,0,0,0,,Бұл шайқас болды.
Dialogue: 0,0:12:04.05,0:12:07.06,Default,,0,0,0,,А... Жоғары ежелгі?
Dialogue: 0,0:12:07.76,0:12:12.27,Default,,0,0,0,,Кидошудың самурайлардан жақсы сиқырлы жауынгер екенін ұмыттыңыз ба?
Dialogue: 0,0:12:13.06,0:12:15.90,Default,,0,0,0,,Оян, Ынви фон Малмстин!
Dialogue: 0,0:12:16.52,0:12:19.78,Default,,0,0,0,,Кальдың билігі жаман екенін неге түсінбейсің!
Dialogue: 0,0:12:19.86,0:12:21.53,Default,,0,0,0,,Тыныш, сатқын
Dialogue: 0,0:12:21.61,0:12:24.61,Default,,0,0,0,,Мен сізге Лорд Калды зұлым деп атауға рұқсат бермеймін.
Dialogue: 0,0:12:25.45,0:12:28.20,Default,,0,0,0,,Тәнімді жау қорлаған жоқ па?
Dialogue: 0,0:12:28.28,0:12:29.49,Default,,0,0,0,,Тіпті менің жүрегім де ұрланды
Dialogue: 0,0:12:29.58,0:12:33.71,Default,,0,0,0,,Сіз жай ғана әйел болып төмендедіңіз.
Dialogue: 0,0:12:33.79,0:12:34.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:35.92,0:12:36.75,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:37.34,0:12:39.92,Default,,0,0,0,,Жоқ... аа!
Dialogue: 0,0:12:40.00,0:12:42.51,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:12:42.59,0:12:46.39,Default,,0,0,0,,Сонда... денеңді жау қорлады ма?
Dialogue: 0,0:12:47.22,0:12:48.35,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:48.93,0:12:51.35,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:12:51.89,0:12:53.64,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:12:53.73,0:12:55.48,Default,,0,0,0,,Бұл рас па? Кай
Dialogue: 0,0:12:56.90,0:12:58.65,Default,,0,0,0,,О... мен...
Dialogue: 0,0:12:59.73,0:13:03.74,Default,,0,0,0,,Қашан мені қорлап, жүрегімді ұрладың?
Dialogue: 0,0:13:03.82,0:13:05.32,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:13:06.07,0:13:06.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:08.07,0:13:09.12,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:13:09.20,0:13:10.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:10.16,0:13:11.08,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:13:11.16,0:13:12.66,Default,,0,0,0,,Мәжбүрлеп алып тасталған
Dialogue: 0,0:13:13.29,0:13:15.62,Default,,0,0,0,,Кай Хирн шайқасы!
Dialogue: 0,0:13:17.25,0:13:18.71,Default,,0,0,0,,Не... не?
Dialogue: 0,0:13:19.38,0:13:21.59,Default,,0,0,0,,Әй... бұл кедергі
Dialogue: 0,0:13:22.46,0:13:23.47,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:23.97,0:13:27.22,Default,,0,0,0,,Бұл діни қызметкердің жоғары деңгейдегі қорғаныс сиқыры емес пе?
Dialogue: 0,0:13:27.72,0:13:29.51,Default,,0,0,0,,Самурай пайдалана алады
Dialogue: 0,0:13:29.60,0:13:33.73,Default,,0,0,0,,Орта деңгейге дейінгі шебердің емлесімен ғана шектелуі керек.
Dialogue: 0,0:13:33.81,0:13:37.02,Default,,0,0,0,,Бұл Бас діни қызметкер араласты дегенді білдіре ме?
Dialogue: 0,0:13:37.52,0:13:40.06,Default,,0,0,0,,Сіз кімсіз? сен қайдасың?
Dialogue: 0,0:13:40.98,0:13:44.36,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:44.44,0:13:45.99,Default,,0,0,0,,Йо… Йоко
Dialogue: 0,0:13:47.66,0:13:48.78,Default,,0,0,0,,Ой
Dialogue: 0,0:13:48.87,0:13:49.95,Default,,0,0,0,,Бұл Йоко.
Dialogue: 0,0:13:52.24,0:13:53.50,Default,,0,0,0,,Йоко
Dialogue: 0,0:13:54.08,0:13:55.00,Default,,0,0,0,,Йоко
Dialogue: 0,0:13:55.08,0:13:55.96,Default,,0,0,0,,Йоко
Dialogue: 0,0:13:56.04,0:13:58.92,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:13:59.00,0:14:02.00,Default,,0,0,0,,Йоко? Бұл Йоко ма?
Dialogue: 0,0:14:02.75,0:14:04.92,Default,,0,0,0,,Мен сенің ақымақ екеніңе сене алар емеспін...
Dialogue: 0,0:14:07.59,0:14:10.72,Default,,0,0,0,,Бұл ауыр шайқас. Неге араластың?
Dialogue: 0,0:14:12.14,0:14:14.06,Default,,0,0,0,,Мен жеңілгенім үшін кешірші, Кай.
Dialogue: 0,0:14:14.72,0:14:18.14,Default,,0,0,0,,Жаудың негізгі күші жақындап келеді. Шығаратын кез келді.
Dialogue: 0,0:14:18.69,0:14:21.52,Default,,0,0,0,,Тағы зардап шеккендер болмай тұрып, шегініңіз.
Dialogue: 0,0:14:26.40,0:14:27.53,Default,,0,0,0,,Йоко
Dialogue: 0,0:14:28.03,0:14:31.82,Default,,0,0,0,,Тиа Нот Йоко, Мета-Ликананың бас діни қызметкерінің қызы?
Dialogue: 0,0:14:32.74,0:14:36.25,Default,,0,0,0,,Мета-Ликана сарайы жоғалып кеткен кезде өлді деп есептелді, бірақ
Dialogue: 0,0:14:36.87,0:14:39.08,Default,,0,0,0,,Мен оны тірі деп ойламаппын...
Dialogue: 0,0:14:41.50,0:14:44.42,Default,,0,0,0,,Сол үлкен жарылыстан қалай шықтыңыз?
Dialogue: 0,0:14:45.46,0:14:46.38,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:46.46,0:14:49.22,Default,,0,0,0,,Бір нәрсе сұрайын: өмір сүру деген не?
Dialogue: 0,0:14:52.39,0:14:53.72,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:14:54.31,0:14:56.85,Default,,0,0,0,,Ммм... әдемі
Dialogue: 0,0:14:59.77,0:15:03.02,Default,,0,0,0,,Жаудың негізгі күші шегінуге жақындап қалды
Dialogue: 0,0:15:03.11,0:15:04.11,Default,,0,0,0,,О!
Dialogue: 0,0:15:04.19,0:15:08.28,Default,,0,0,0,,Барлық әскерлер шығарылады. Самурайлар бейбіт тұрғындарды басқарады.
Dialogue: 0,0:15:09.32,0:15:12.16,Default,,0,0,0,,Қолы босағандар тамақ алып жүрсін.
Dialogue: 0,0:15:13.66,0:15:15.54,Default,,0,0,0,,Хмм, күте тұрыңыз.
Dialogue: 0,0:15:15.62,0:15:19.29,Default,,0,0,0,,Содан кейін көлеңкелі көсем де самурайға кидошуды қосты.
Dialogue: 0,0:15:19.37,0:15:20.21,Default,,0,0,0,,Барлығы... Ну!
Dialogue: 0,0:15:21.50,0:15:23.00,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:15:23.08,0:15:25.38,Default,,0,0,0,,Қорғаныш тосқауыл болса да, абайсызда әрекет жасасаң.
Dialogue: 0,0:15:25.46,0:15:26.92,Default,,0,0,0,,Абыройсыз шықпайсың.
Dialogue: 0,0:15:27.01,0:15:28.76,Default,,0,0,0,,Жын соғысының генералы
Dialogue: 0,0:15:29.97,0:15:31.59,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:31.68,0:15:35.60,Default,,0,0,0,,Дәл қазір азаматтар мен олардың тамағын қорғау басты міндет болып табылады.
Dialogue: 0,0:15:35.68,0:15:36.97,Default,,0,0,0,,Мен сені жұмыстан шығарамын.
Dialogue: 0,0:15:37.47,0:15:39.89,Default,,0,0,0,,Мен шайқасты ақырында шешемін.
Dialogue: 0,0:15:39.98,0:15:41.69,Default,,0,0,0,,Мойынды жуып, күт.
Dialogue: 0,0:15:41.77,0:15:44.40,Default,,0,0,0,,Әй, қашпа.
Dialogue: 0,0:15:44.48,0:15:46.11,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:15:46.65,0:15:49.78,Default,,0,0,0,,Біз Калдың езгісіне ешқашан көнбейміз.
Dialogue: 0,0:15:50.28,0:15:52.36,Default,,0,0,0,,Мен соңғы болсам да
Dialogue: 0,0:15:52.45,0:15:54.95,Default,,0,0,0,,Мен сіздің амбицияларыңызды міндетті түрде жоққа шығарамын.
Dialogue: 0,0:15:58.16,0:16:00.00,Default,,0,0,0,,Yoko деңгейіндегі жазба
Dialogue: 0,0:16:00.83,0:16:02.04,Default,,0,0,0,,Голем соғысында
Dialogue: 0,0:16:02.12,0:16:05.13,Default,,0,0,0,,Дарк Шнайдерді жеңген бес батырдың бірі
Dialogue: 0,0:16:06.25,0:16:08.67,Default,,0,0,0,,Geo Note Сорттың жалғыз қызы
Dialogue: 0,0:16:09.92,0:16:12.80,Default,,0,0,0,,Бұл керемет Йоко...
Dialogue: 0,0:16:12.88,0:16:15.76,Default,,0,0,0,,Әй... Мен ренжіп жүрмін.
Dialogue: 0,0:16:16.60,0:16:19.02,Default,,0,0,0,,Мен мұны да айттым...
Dialogue: 0,0:16:20.27,0:16:24.27,Default,,0,0,0,,Йоко: Бұл оқиға орнынан естігенімнен мүлдем басқа әсер.
Dialogue: 0,0:16:24.98,0:16:27.98,Default,,0,0,0,,Сіздің мінезіңіз тікерек деп естідім.
Dialogue: 0,0:16:29.65,0:16:32.28,Default,,0,0,0,,Мен Кальдың амбицияларын міндетті түрде жоққа шығарамын.
Dialogue: 0,0:16:33.24,0:16:34.24,Default,,0,0,0,,Майюри сол жарыққа тартылып бара жатқандай болды
Dialogue: 0,0:16:41.83,0:16:44.17,Default,,0,0,0,,Жын шайқас генералының бейбақы.
Dialogue: 0,0:16:44.25,0:16:46.58,Default,,0,0,0,,Кай мені тарастпен ұрғанда
Dialogue: 0,0:16:47.13,0:16:51.34,Default,,0,0,0,,Йоко саған тосқауыл қойғанда, сен солай көріндің.
Dialogue: 0,0:16:51.84,0:16:55.64,Default,,0,0,0,,Бұл күлкілі болды. Кук кук...
Dialogue: 0,0:16:56.30,0:16:59.43,Default,,0,0,0,,Кайдың Тарасы да, Йоконың тосқауылдары да керемет болды.
Dialogue: 0,0:16:59.51,0:17:00.85,Default,,0,0,0,,Эй Шен
Dialogue: 0,0:17:00.93,0:17:04.81,Default,,0,0,0,,Иә, екеуі де үлкен әйелдер.
Dialogue: 0,0:17:04.89,0:17:08.27,Default,,0,0,0,,Әсіресе Йоконың заңды күші таң қалдырады.
Dialogue: 0,0:17:08.36,0:17:10.73,Default,,0,0,0,,Кидошудың сиқырлы қылышшысы ретінде
Dialogue: 0,0:17:10.82,0:17:13.57,Default,,0,0,0,,Қатаң дайындықтан өткен Кай ханның сиқыры,
Dialogue: 0,0:17:13.65,0:17:15.15,Default,,0,0,0,,Мүлдем екінші
Dialogue: 0,0:17:16.11,0:17:19.24,Default,,0,0,0,,Аа~ Діни қызметкердің қорғаныс сиқыры дегеніміз не?
Dialogue: 0,0:17:19.33,0:17:21.54,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:17:24.75,0:17:28.38,Default,,0,0,0,,Сонымен қатар, Бас діни қызметкер класының емдік сиқырлары
Dialogue: 0,0:17:28.46,0:17:31.71,Default,,0,0,0,,100 үздік дәрігерге тең.
Dialogue: 0,0:17:31.80,0:17:33.63,Default,,0,0,0,,Хмм (барлығы) Ой?
Dialogue: 0,0:17:33.72,0:17:37.22,Default,,0,0,0,,Ол енді біз үшін таптырмас.
Dialogue: 0,0:17:37.30,0:17:39.64,Default,,0,0,0,,Біріншіден, ол жақсы әйел.
Dialogue: 0,0:17:39.72,0:17:42.60,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:43.35,0:17:44.56,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:17:47.48,0:17:50.94,Default,,0,0,0,,Иә? Сіздің жүзіңіз таныс сияқты.
Dialogue: 0,0:17:51.86,0:17:53.40,Default,,0,0,0,,Түсіндім, сен...
Dialogue: 0,0:17:53.48,0:17:54.32,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:17:54.40,0:17:55.65,Default,,0,0,0,,Зеонның...
Dialogue: 0,0:17:57.61,0:18:01.37,Default,,0,0,0,,Мари, сенің жауың әрқашан мен боламын...
Dialogue: 0,0:18:01.91,0:18:04.12,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:04.20,0:18:05.79,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:18:05.87,0:18:09.08,Default,,0,0,0,,Иә? Не болды, Ангус?
Dialogue: 0,0:18:11.38,0:18:14.01,Default,,0,0,0,,Ол әлі тыныш жігіт.
Dialogue: 0,0:18:17.72,0:18:20.85,Default,,0,0,0,,Агия Агия...
Dialogue: 0,0:18:21.43,0:18:23.93,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:24.93,0:18:27.81,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:28.69,0:18:32.36,Default,,0,0,0,,Сіз жындар қолбасшысын бөгетпен жауып тастадыңыз ба?
Dialogue: 0,0:18:32.86,0:18:33.69,Default,,0,0,0,,Иә
Dialogue: 0,0:18:34.40,0:18:35.49,Default,,0,0,0,,Ол қазір
Dialogue: 0,0:18:35.57,0:18:38.78,Default,,0,0,0,,Бас діни қызметкер сыныбының сиқырларын меңгеру деңгейіне жеттіңіз.
Dialogue: 0,0:18:39.70,0:18:42.99,Default,,0,0,0,,Осы самурай резиденциясында екі жыл ішінде қол жеткізілген жетістіктер болды
Dialogue: 0,0:18:43.08,0:18:44.49,Default,,0,0,0,,Екінші рет қараудың қажеті бар ма?
Dialogue: 0,0:18:44.99,0:18:46.58,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:46.66,0:18:50.42,Default,,0,0,0,,Сол қыздың заңды күші таңғажайып өсуге қол жеткізді.
Dialogue: 0,0:18:50.92,0:18:56.34,Default,,0,0,0,,Яғни, қызымның күресуге бел байлауынан туындаған психикалық өзгерістер.
Dialogue: 0,0:18:56.84,0:18:59.47,Default,,0,0,0,,Бастапқыда болған тамаша қасиеттер
Dialogue: 0,0:18:59.55,0:19:01.18,Default,,0,0,0,,Бұл менің оянғанымды білдіреді.
Dialogue: 0,0:19:02.18,0:19:03.76,Default,,0,0,0,,Сіз күресуге бел байладыңыз ба?
Dialogue: 0,0:19:08.68,0:19:10.60,Default,,0,0,0,,Бірақ Самурай шебері
Dialogue: 0,0:19:11.35,0:19:14.48,Default,,0,0,0,,Тағдырдың миссиясы сол қыз Йоко болды
Dialogue: 0,0:19:14.57,0:19:17.07,Default,,0,0,0,,Бұл одан да маңыздырақ.
Dialogue: 0,0:19:17.15,0:19:18.15,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.82,0:19:21.11,Default,,0,0,0,,Соғыс жағдайы қиындап барады.
Dialogue: 0,0:19:21.61,0:19:24.41,Default,,0,0,0,,Қалдың әскері күшті.
Dialogue: 0,0:19:24.49,0:19:27.25,Default,,0,0,0,,Самурайдың тағдыры шайқасқа түседі
Dialogue: 0,0:19:27.95,0:19:32.33,Default,,0,0,0,,Марқұм монарх Король Харристің өкініштері үшін кек алу.
Dialogue: 0,0:19:32.42,0:19:35.25,Default,,0,0,0,,Менің қожайыным өкінішпен өлгенде
Dialogue: 0,0:19:35.34,0:19:37.88,Default,,0,0,0,,Жауыңның кек алу үшін өз өміріңді қатерге тігу керек.
Dialogue: 0,0:19:38.38,0:19:41.22,Default,,0,0,0,,Содан кейін «адалдығыңызды» орындаңыз
Dialogue: 0,0:19:42.39,0:19:45.22,Default,,0,0,0,,Жоғалып бара жатқан әлемдік тәртіп үшін
Dialogue: 0,0:19:45.85,0:19:47.27,Default,,0,0,0,,Тіпті егер солай болса да
Dialogue: 0,0:19:47.35,0:19:50.98,Default,,0,0,0,,Бұл қаншалықты қиын және үлкен шығындарға әкелетін еді⸺
Dialogue: 0,0:19:51.06,0:19:54.40,Default,,0,0,0,,Үмітсіз шайқас болса да
Dialogue: 0,0:19:55.73,0:19:57.02,Default,,0,0,0,,Бұл да тағдыр
Dialogue: 0,0:19:58.03,0:20:00.70,Default,,0,0,0,,Екі жыл бұрын сол қыз
Dialogue: 0,0:20:00.78,0:20:05.70,Default,,0,0,0,,Тіпті қолтығында қанды баланы алып бізге келді.
Dialogue: 0,0:20:07.45,0:20:09.58,Default,,0,0,0,,Түннің бір уағында қаскүнем...
Dialogue: 0,0:20:10.08,0:20:12.75,Default,,0,0,0,,Неліктен самурайлар резиденциясы жасырын ауыл?
Dialogue: 0,0:20:12.83,0:20:14.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:20:14.08,0:20:15.08,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:20:15.79,0:20:18.67,Default,,0,0,0,,Мүмкін ол көтерілісшілер әскерінің барлаушысы шығар?
Dialogue: 0,0:20:19.84,0:20:21.51,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:20:21.59,0:20:23.43,Default,,0,0,0,,Сіз самурайсыз ба?
Dialogue: 0,0:20:23.51,0:20:26.76,Default,,0,0,0,,Мына баланы маған беріңізші...
Dialogue: 0,0:20:26.85,0:20:29.18,Default,,0,0,0,,Люси-кунға көмектес!
Dialogue: 0,0:20:31.35,0:20:33.31,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:20:33.39,0:20:35.31,Default,,0,0,0,,Мүмкін бұл тағдыр
Dialogue: 0,0:20:37.69,0:20:38.94,Default,,0,0,0,,Әке...
Dialogue: 0,0:20:39.53,0:20:40.78,Default,,0,0,0,,Құрметті Шейла...
Dialogue: 0,0:20:41.28,0:20:43.53,Default,,0,0,0,,Гала... барлығы...
Dialogue: 0,0:20:47.62,0:20:50.29,Default,,0,0,0,,Мен оның бір жерде тірі екеніне сенімдімін.
Dialogue: 0,0:20:51.54,0:20:54.75,Default,,0,0,0,,Мен де, Кай да аман қалды.
Dialogue: 0,0:20:55.54,0:20:57.75,Default,,0,0,0,,Иә, сөзсіз тірі.
Dialogue: 0,0:20:58.59,0:20:59.59,Default,,0,0,0,,Иә
Dialogue: 0,0:21:00.80,0:21:02.59,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:21:02.67,0:21:06.34,Default,,0,0,0,,Хехе, Йоко шомылып жатыр ма?
Dialogue: 0,0:21:06.43,0:21:10.77,Default,,0,0,0,,Ниндзя дағдыларын үйренгеніме қуаныштымын.
Dialogue: 0,0:21:12.52,0:21:14.60,Default,,0,0,0,,Иә? адамдардың болуы
Dialogue: 0,0:21:15.14,0:21:18.73,Default,,0,0,0,,Vi қайтадан? Мүлдем кінәсіз
Dialogue: 0,0:21:23.78,0:21:26.20,Default,,0,0,0,,Кора Вай!
Dialogue: 0,0:21:26.28,0:21:28.53,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:21:29.99,0:21:31.99,Default,,0,0,0,,Ах, Йоко-сан
Dialogue: 0,0:21:32.08,0:21:33.70,Default,,0,0,0,,Люси-кун
Dialogue: 0,0:21:34.46,0:21:39.71,Default,,0,0,0,,Қайта-қайта... Самурайдай сыпайы бол, Вай
Dialogue: 0,0:21:39.79,0:21:41.09,Default,,0,0,0,,Иә
Dialogue: 0,0:21:41.17,0:21:44.05,Default,,0,0,0,,Ия, бұл Йоко-сан.
Dialogue: 0,0:21:44.13,0:21:46.51,Default,,0,0,0,,Фухаха фуфуфуфуфуфуфу…
Dialogue: 0,0:21:47.30,0:21:48.55,Default,,0,0,0,,Содан бері екі жыл өтті
Dialogue: 0,0:21:49.55,0:21:51.47,Default,,0,0,0,,Ашылу салтанатын қанша рет орындасаңыз да⸺
Dialogue: 0,0:21:52.35,0:21:55.81,Default,,0,0,0,,Дарк Шнайдердің мөрін бұзу мүмкін болмады.
Dialogue: 0,0:21:57.52,0:22:00.36,Default,,0,0,0,,Хахаха вахахаха!
Dialogue: 0,0:22:01.40,0:22:02.40,Default,,0,0,0,,Ахаха
Dialogue: 0,0:22:03.19,0:22:04.74,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:22:05.70,0:22:08.03,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:22:09.70,0:22:11.91,Default,,0,0,0,,Сөзсіз сен
Dialogue: 0,0:22:12.87,0:22:15.91,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:22:21.00,0:22:23.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:45.75,0:23:47.76,Default,,0,0,0,,～♪
