Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.99,0:00:12.99,Default,,0,0,0,,<(АҚШ) Мен орта мектепте оқитынмын
Dialogue: 0,0:00:08.99,0:00:12.99,Default,,0,0,0,,Апаттар сериясы>
Dialogue: 0,0:00:30.18,0:00:32.88,Default,,0,0,0,,Сейсо
Dialogue: 0,0:00:52.03,0:02:20.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:28.50,0:02:30.51,Default,,0,0,0,,≪(Тагами) АҚШ
Dialogue: 0,0:02:30.51,0:02:33.01,Default,,0,0,0,,АҚШ!
Dialogue: 0,0:02:33.01,0:02:35.51,Default,,0,0,0,,Тагами
Dialogue: 0,0:02:33.01,0:02:35.51,Default,,0,0,0,,Кітапханашының жұмысы
Dialogue: 0,0:02:35.51,0:02:37.68,Default,,0,0,0,,Осыны тез бітіріп, үйге қайтайық.
Dialogue: 0,0:02:37.68,0:02:41.35,Default,,0,0,0,,Сонымен, бүгіннен басталады?
Dialogue: 0,0:02:37.68,0:02:41.35,Default,,0,0,0,,Жалғыз өмір сүру
Dialogue: 0,0:02:41.35,0:02:43.35,Default,,0,0,0,,Иә
Dialogue: 0,0:02:43.35,0:02:47.02,Default,,0,0,0,,Жарайды~ Менің ата-анам да
Dialogue: 0,0:02:43.35,0:02:47.02,Default,,0,0,0,,Қызық, бұл аударуға байланысты ма?
Dialogue: 0,0:02:47.02,0:02:49.96,Default,,0,0,0,,Бұл қандай пәтер?
Dialogue: 0,0:02:49.96,0:02:52.46,Default,,0,0,0,,Бүгін бірінші рет бара жатырсыз, солай емес пе?
Dialogue: 0,0:02:52.46,0:02:54.80,Default,,0,0,0,,Мен менеджерді кездестірдім.
Dialogue: 0,0:02:54.80,0:02:57.30,Default,,0,0,0,,≪(Тагами) Әй, бұл не?
Dialogue: 0,0:02:57.30,0:03:00.14,Default,,0,0,0,,Алдымдағы адамның жүгі ше?
Dialogue: 0,0:03:00.14,0:03:02.64,Default,,0,0,0,,А, мен қайтып келдім.
Dialogue: 0,0:03:13.98,0:03:16.65,Default,,0,0,0,,Дәл сол жерде
Dialogue: 0,0:03:38.67,0:03:41.18,Default,,0,0,0,,Бұл Уса-кун!
Dialogue: 0,0:03:41.18,0:03:43.18,Default,,0,0,0,,Сізге бастауыш мектеп ұнайды ма?
Dialogue: 0,0:03:43.18,0:03:46.52,Default,,0,0,0,,Кім! Дәлірек айтқанда, неге менің атым!?
Dialogue: 0,0:03:46.52,0:03:48.52,Default,,0,0,0,,≪(Офицер) Сәлем балалар.
Dialogue: 0,0:03:48.52,0:03:52.12,Default,,0,0,0,,Бастауыш мектеп
Dialogue: 0,0:03:48.52,0:03:52.12,Default,,0,0,0,,Біртүрлі адам қарап тұр.
Dialogue: 0,0:03:52.12,0:03:54.29,Default,,0,0,0,,Мен есеп алдым.
Dialogue: 0,0:03:54.29,0:03:57.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.29,0:03:57.29,Default,,0,0,0,,Бұл сенсің, сен
Dialogue: 0,0:03:57.29,0:03:59.63,Default,,0,0,0,,≪Е?
Dialogue: 0,0:03:57.29,0:03:59.63,Default,,0,0,0,,Мен оны зерттеген жоқпын.
Dialogue: 0,0:03:59.63,0:04:02.80,Default,,0,0,0,,Сым тордағы басы
Dialogue: 0,0:03:59.63,0:04:02.80,Default,,0,0,0,,Жаңа ғана ішке кірмедің бе?
Dialogue: 0,0:04:02.80,0:04:06.80,Default,,0,0,0,,Егер сіз осындай тесік тапсаңыз
Dialogue: 0,0:04:02.80,0:04:06.80,Default,,0,0,0,,Менің ішке кіруден басқа амалым жоқ.
Dialogue: 0,0:04:06.80,0:04:11.81,Default,,0,0,0,,Расында да, баланың да, ердің де жүрегі
Dialogue: 0,0:04:06.80,0:04:11.81,Default,,0,0,0,,Бұл қытықтайтын жағдай, бірақ...
Dialogue: 0,0:04:11.81,0:04:13.98,Default,,0,0,0,,Сіз не туралы айтып отырсыз, офицер?
Dialogue: 0,0:04:13.98,0:04:16.81,Default,,0,0,0,,Супермаркет арбасында
Dialogue: 0,0:04:13.98,0:04:16.81,Default,,0,0,0,,Сіз мұны тез орындағыңыз келе ме?
Dialogue: 0,0:04:16.81,0:04:19.65,Default,,0,0,0,,Орындыққа аяқ-қолды созу.
Dialogue: 0,0:04:16.81,0:04:19.65,Default,,0,0,0,,Айналғыңыз келе ме?
Dialogue: 0,0:04:19.65,0:04:23.32,Default,,0,0,0,,Сол көп азғырулар
Dialogue: 0,0:04:19.65,0:04:23.32,Default,,0,0,0,,үшін шыдамды болыңыз
Dialogue: 0,0:04:23.32,0:04:25.32,Default,,0,0,0,,Қызық, ол әлі тірі ме?
Dialogue: 0,0:04:25.32,0:04:27.32,Default,,0,0,0,,Жоқ, мен емес...
Dialogue: 0,0:04:27.32,0:04:30.83,Default,,0,0,0,,Бірақ балалардың қауіпсіздігі үшін
Dialogue: 0,0:04:27.32,0:04:30.83,Default,,0,0,0,,Бұл сезімтал дүние
Dialogue: 0,0:04:30.83,0:04:32.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:32.83,0:04:35.66,Default,,0,0,0,,Жоқ, жоқ, басым эротикалық ойларға толы
Dialogue: 0,0:04:35.66,0:04:38.17,Default,,0,0,0,,Жақында 18-ге толған және одан асқан жоғары сынып оқушылары
Dialogue: 0,0:04:35.66,0:04:38.17,Default,,0,0,0,,Әйелдер ерікті
Dialogue: 0,0:04:38.17,0:04:40.67,Default,,0,0,0,,Бастауыш сынып оқушылары кіреді
Dialogue: 0,0:04:38.17,0:04:40.67,Default,,0,0,0,,Артықшылық деген жоқ!
Dialogue: 0,0:04:40.67,0:04:43.17,Default,,0,0,0,,Сізде басқа адамдармен бірдей этика сезімі бар сияқты, бірақ...
Dialogue: 0,0:04:45.17,0:04:47.68,Default,,0,0,0,,≪Бәрібір
Dialogue: 0,0:04:45.17,0:04:47.68,Default,,0,0,0,,Вокзал алдындағы баспалдақпен жүріңіз➡
Dialogue: 0,0:04:47.68,0:04:49.68,Default,,0,0,0,,Ал мен оны мүлде көрген жоқпын.
Dialogue: 0,0:04:49.68,0:04:51.61,Default,,0,0,0,,«Не қарап тұрсың, қария?»
Dialogue: 0,0:04:51.61,0:04:54.78,Default,,0,0,0,,Менсінген көзбен
Dialogue: 0,0:04:51.61,0:04:54.78,Default,,0,0,0,,Маған негізсіз қадалып қалғым келеді.
Dialogue: 0,0:04:54.78,0:04:56.95,Default,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:04:56.95,0:05:00.29,Default,,0,0,0,,Бір сәт полиция бөлімшесіне келіңіз.
Dialogue: 0,0:04:56.95,0:05:00.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.29,0:05:02.63,Default,,0,0,0,,≪(Офицер) Тез кел!
Dialogue: 0,0:05:02.63,0:05:04.63,Default,,0,0,0,,≪А, Уса-кун!
Dialogue: 0,0:05:04.63,0:05:06.63,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:11.63,0:05:15.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:11.63,0:05:15.14,Default,,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:05:15.14,0:05:17.47,Default,,0,0,0,,Жоқ, біртүрлі біреу бар...
Dialogue: 0,0:05:17.47,0:05:21.31,Default,,0,0,0,,Жарайды, бұл әбігер.
Dialogue: 0,0:05:17.47,0:05:21.31,Default,,0,0,0,,Тез үйге келіңізші.
Dialogue: 0,0:05:21.31,0:05:24.81,Default,,0,0,0,,<Бірақ неге?
Dialogue: 0,0:05:21.31,0:05:24.81,Default,,0,0,0,,Ол кісі, менің атым...>
Dialogue: 0,0:05:24.81,0:05:28.82,Default,,0,0,0,,<Не болса да
Dialogue: 0,0:05:24.81,0:05:28.82,Default,,0,0,0,,Оны ұмытайық, өйткені ол бізді сараң етеді>
Dialogue: 0,0:05:28.82,0:05:32.15,Default,,0,0,0,,Әкімші
Dialogue: 0,0:05:28.82,0:05:32.15,Default,,0,0,0,,≪(Сумико) Өтінемін, мені Сумико-сан деп атаңыз.
Dialogue: 0,0:05:32.15,0:05:35.49,Default,,0,0,0,,Сумико-сан
Dialogue: 0,0:05:32.15,0:05:35.49,Default,,0,0,0,,Бүгіннен бастап қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:05:35.49,0:05:40.50,Default,,0,0,0,,Бұл мен ойлағаннан да жақсы.
Dialogue: 0,0:05:35.49,0:05:40.50,Default,,0,0,0,,Оның қанша жаста екеніне таң қалдыңыз ба?
Dialogue: 0,0:05:40.50,0:05:43.33,Default,,0,0,0,,Жоқ, бұл жақсы сезінеді.
Dialogue: 0,0:05:40.50,0:05:43.33,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:05:43.33,0:05:46.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:43.33,0:05:46.67,Default,,0,0,0,,Алдымен шай ішіп алғыңыз келе ме?
Dialogue: 0,0:05:46.67,0:05:49.84,Default,,0,0,0,,Бөлмені көргіңіз келе ме?
Dialogue: 0,0:05:46.67,0:05:49.84,Default,,0,0,0,,А, мен бөлмені көргім келеді.
Dialogue: 0,0:05:49.84,0:05:52.94,Default,,0,0,0,,Кең! Бұл төрт жарым татами ма?
Dialogue: 0,0:05:52.94,0:05:55.95,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:05:55.95,0:06:00.28,Default,,0,0,0,,Осылайша, осылай, төрт жарым татами төсеніш
Dialogue: 0,0:06:00.28,0:06:02.28,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:02.28,0:06:04.98,Default,,0,0,0,,Бұл қорқынышты~ Уса-кун
Dialogue: 0,0:06:06.29,0:06:08.96,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:06:08.96,0:06:11.46,Default,,0,0,0,,Неге мұндасың!?
Dialogue: 0,0:06:08.96,0:06:11.46,Default,,0,0,0,,Резидент
Dialogue: 0,0:06:11.46,0:06:13.46,Default,,0,0,0,,Неге менің атым!?
Dialogue: 0,0:06:13.46,0:06:15.63,Default,,0,0,0,,Мен Сумико ханымнан және фотосуретті естідім.
Dialogue: 0,0:06:15.63,0:06:17.80,Default,,0,0,0,,Бөлме жолдасы дегеніміз не?
Dialogue: 0,0:06:15.63,0:06:17.80,Default,,0,0,0,,Жоқ, бұл адаммен!?
Dialogue: 0,0:06:17.80,0:06:20.14,Default,,0,0,0,,Бөлімге бөлінген бөлме!
Dialogue: 0,0:06:20.14,0:06:23.97,Default,,0,0,0,,Қабырғалары әрине жұқа.
Dialogue: 0,0:06:23.97,0:06:26.81,Default,,0,0,0,,Жоқ, бұл перделер отбасының мүшесі.
Dialogue: 0,0:06:26.81,0:06:28.81,Default,,0,0,0,,Мен мұндай адаммен бірге болғым келмейді!
Dialogue: 0,0:06:28.81,0:06:31.65,Default,,0,0,0,,≪(Сумико) Дәл солай.
Dialogue: 0,0:06:28.81,0:06:31.65,Default,,0,0,0,,Сіз бұл туралы көп білмейсіз, солай ма?
Dialogue: 0,0:06:31.65,0:06:33.65,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:31.65,0:06:33.65,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:06:33.65,0:06:36.32,Default,,0,0,0,,Широ-кун бұзық болса да
Dialogue: 0,0:06:33.65,0:06:36.32,Default,,0,0,0,,Негізгі зиянсыз
Dialogue: 0,0:06:36.32,0:06:38.65,Default,,0,0,0,,Зиян келтіруден гөрі
Dialogue: 0,0:06:36.32,0:06:38.65,Default,,0,0,0,,Өйткені ол сізге берілгісі келетін тип.
Dialogue: 0,0:06:38.65,0:06:42.83,Default,,0,0,0,,Әлсіз түрде М қосылған тауық котлеті
Dialogue: 0,0:06:38.65,0:06:42.83,Default,,0,0,0,,Сүйікті тауық етінің қалдықтары
Dialogue: 0,0:06:42.83,0:06:45.66,Default,,0,0,0,,Жақсырақ білу жақсы
Dialogue: 0,0:06:42.83,0:06:45.66,Default,,0,0,0,,Бұл қорқынышты емес пе!
Dialogue: 0,0:06:45.66,0:06:50.27,Default,,0,0,0,,Сумиконың сөзі қарапайым сияқты.
Dialogue: 0,0:06:45.66,0:06:50.27,Default,,0,0,0,,Маған оның тыныштығы ұнайды.
Dialogue: 0,0:06:54.94,0:06:57.11,Default,,0,0,0,,Әйтеуір, ата-анаңнан сұра.
Dialogue: 0,0:06:57.11,0:06:59.44,Default,,0,0,0,,Бүгін мен досымның үйінде тұрамын!
Dialogue: 0,0:06:59.44,0:07:02.28,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:07:02.28,0:07:05.28,Default,,0,0,0,,<Мен тынышпын
Dialogue: 0,0:07:02.28,0:07:05.28,Default,,0,0,0,,Мен күн көргім келеді>
Dialogue: 0,0:07:21.46,0:07:24.63,Default,,0,0,0,,О, Рицу-чан
Dialogue: 0,0:07:21.46,0:07:24.63,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:29.64,0:07:31.81,Default,,0,0,0,,Рицу-чан, мен бұл туралы бұрын айтқанмын.
Dialogue: 0,0:07:31.81,0:07:34.31,Default,,0,0,0,,Уса-кун бүгіннен бастап тұрғын болады.
Dialogue: 0,0:07:34.31,0:07:36.81,Default,,0,0,0,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:07:36.81,0:07:39.82,Default,,0,0,0,,Сәлеметсіз бе, мен Киносакимін
Dialogue: 0,0:07:36.81,0:07:39.82,Default,,0,0,0,,Маған Широ деп қоңырау шалыңыз
Dialogue: 0,0:07:39.82,0:07:41.82,Default,,0,0,0,,Мүмкіндігінше итке ұқсайды
Dialogue: 0,0:07:41.82,0:07:45.02,Default,,0,0,0,,Сіз бөлек
Dialogue: 0,0:07:41.82,0:07:45.02,Default,,0,0,0,,Мен сенімен амандасқым келмейді.
Dialogue: 0,0:07:48.49,0:07:50.93,Default,,0,0,0,,Рицу Кавай
Dialogue: 0,0:07:50.93,0:07:53.93,Default,,0,0,0,,Мен Кита орта мектебінің екінші курс студентімін.
Dialogue: 0,0:07:50.93,0:07:53.93,Default,,0,0,0,,Уса-кун да Солтүстік орта мектебінің оқушысы, солай ма?
Dialogue: 0,0:07:53.93,0:07:55.93,Default,,0,0,0,,Иә
Dialogue: 0,0:07:55.93,0:08:01.27,Default,,0,0,0,,<Сенбеймін, өзіме қатты ұнайтын қызбен
Dialogue: 0,0:07:55.93,0:08:01.27,Default,,0,0,0,,Бір пәтер>
Dialogue: 0,0:08:01.27,0:08:06.44,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:08:01.27,0:08:06.44,Default,,0,0,0,,Біз кітапханада кездестік, солай ма?
Dialogue: 0,0:08:06.44,0:08:09.78,Default,,0,0,0,,А, жоқ, мен оны бір жақты көрдім.
Dialogue: 0,0:08:12.11,0:08:14.95,Default,,0,0,0,,Бір орта мектепте оқитынымыз кездейсоқтық.
Dialogue: 0,0:08:14.95,0:08:18.12,Default,,0,0,0,,Мен бірінші курста оқимын.
Dialogue: 0,0:08:14.95,0:08:18.12,Default,,0,0,0,,Мен әлі үйренбегенмін.
Dialogue: 0,0:08:18.12,0:08:20.12,Default,,0,0,0,,Мен бұл сала туралы көп білмеймін.
Dialogue: 0,0:08:20.12,0:08:22.52,Default,,0,0,0,,Маған әртүрлі нәрселерді айтыңызшы...
Dialogue: 0,0:08:24.79,0:08:26.96,Default,,0,0,0,,Әйелдер аймағы
Dialogue: 0,0:08:26.96,0:08:29.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.47,0:08:31.97,Default,,0,0,0,,Біз әлі сөйлескен жоқпыз➡
Dialogue: 0,0:08:31.97,0:08:36.14,Default,,0,0,0,,Біз еркек пен әйелміз.
Dialogue: 0,0:08:31.97,0:08:36.14,Default,,0,0,0,,Қозғалыс ауқымы шектелген бе?
Dialogue: 0,0:08:36.14,0:08:40.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:36.14,0:08:40.31,Default,,0,0,0,,Тек шектелген ер адамдар
Dialogue: 0,0:08:40.31,0:08:44.65,Default,,0,0,0,,Дәретхана мен ванна
Dialogue: 0,0:08:40.31,0:08:44.65,Default,,0,0,0,,Сақ болыңыз, өйткені ерлер мен әйелдер бөлінген.
Dialogue: 0,0:08:44.65,0:08:47.15,Default,,0,0,0,,Сол резиденцияда
Dialogue: 0,0:08:44.65,0:08:47.15,Default,,0,0,0,,Бұл өте алшақ қоғам.
Dialogue: 0,0:08:47.15,0:08:49.82,Default,,0,0,0,,Жастардың теңсіздік туралы білуі маңызды
Dialogue: 0,0:08:49.82,0:08:51.75,Default,,0,0,0,,Төменнен төменге
Dialogue: 0,0:08:51.75,0:08:54.09,Default,,0,0,0,,Тек төменде мен бақыттымын!
Dialogue: 0,0:08:54.09,0:08:56.09,Default,,0,0,0,,Төменнен білім алу
Dialogue: 0,0:08:54.09,0:08:56.09,Default,,0,0,0,,Сөзден бір нәрсе
Dialogue: 0,0:08:56.09,0:08:58.79,Default,,0,0,0,,Хивай Докки Докки…
Dialogue: 0,0:09:01.43,0:09:04.93,Default,,0,0,0,,Менің қызым бар
Dialogue: 0,0:09:01.43,0:09:04.93,Default,,0,0,0,,Мұндай адамдар қауіпті...
Dialogue: 0,0:09:04.93,0:09:08.94,Default,,0,0,0,,≪(Сумико) Жарайды. Маңызды нүктелерде.
Dialogue: 0,0:09:04.93,0:09:08.94,Default,,0,0,0,,Өйткені ол жерде тауарлар бар
Dialogue: 0,0:09:08.94,0:09:11.61,Default,,0,0,0,,Әйелдер аймағы өте қорқынышты
Dialogue: 0,0:09:11.61,0:09:15.44,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,0:09:11.61,0:09:15.44,Default,,0,0,0,,Сіз шындықты қабылдаған сияқтысыз.
Dialogue: 0,0:09:15.44,0:09:18.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.44,0:09:18.28,Default,,0,0,0,,Құрметпен, бөлмелес
Dialogue: 0,0:09:18.28,0:09:21.95,Default,,0,0,0,,Бір-біріне кедергі жасамау
Dialogue: 0,0:09:18.28,0:09:21.95,Default,,0,0,0,,Кейде мені физикалық түрде тежейді.
Dialogue: 0,0:09:21.95,0:09:24.79,Default,,0,0,0,,Кешіріңіз, бұл мүмкін емес.
Dialogue: 0,0:09:24.79,0:09:27.12,Default,,0,0,0,,Осы уақытқа дейін көңіл-күйім жақсы болды
Dialogue: 0,0:09:27.12,0:09:29.12,Default,,0,0,0,,Эй
Dialogue: 0,0:09:29.12,0:09:31.82,Default,,0,0,0,,Бұл бәрібір күтуде!
Dialogue: 0,0:09:34.13,0:09:36.30,Default,,0,0,0,,☎(Ана) Енді не айтып тұрсың?
Dialogue: 0,0:09:36.30,0:09:39.80,Default,,0,0,0,,☎Егер жалғыз өмір сүре алсаңыз
Dialogue: 0,0:09:36.30,0:09:39.80,Default,,0,0,0,,Ешқашан бөлмеде шағымданбаңыз
Dialogue: 0,0:09:39.80,0:09:41.80,Default,,0,0,0,,☎Сіз уәде бердіңіз.
Dialogue: 0,0:09:41.80,0:09:44.81,Default,,0,0,0,,☎Бір бөлмедегі адамдар
Dialogue: 0,0:09:41.80,0:09:44.81,Default,,0,0,0,,Мен мұны ерекше және қызықты деп естідім.
Dialogue: 0,0:09:44.81,0:09:47.48,Default,,0,0,0,,Мұны қызық деп айтуды тоқтата аласыз ба?
Dialogue: 0,0:09:47.48,0:09:51.48,Default,,0,0,0,,Бір бөлмеде басқа біреу болғанда.
Dialogue: 0,0:09:47.48,0:09:51.48,Default,,0,0,0,,Сіз жалғыз өмір сүрмейсіз.
Dialogue: 0,0:09:51.48,0:09:54.48,Default,,0,0,0,,☎Сіз рас айтасыз
Dialogue: 0,0:09:51.48,0:09:54.48,Default,,0,0,0,,Сіз егжей-тегжейлерге мән бересіз.
Dialogue: 0,0:09:54.48,0:09:58.15,Default,,0,0,0,,Менің анам дөрекі.
Dialogue: 0,0:09:54.48,0:09:58.15,Default,,0,0,0,,Менің салғырт мінезім үшін
Dialogue: 0,0:09:58.15,0:10:00.99,Default,,0,0,0,,Қанша еңбек етсем де...
Dialogue: 0,0:09:58.15,0:10:00.99,Default,,0,0,0,,☎Аа, тым шулы!
Dialogue: 0,0:10:00.99,0:10:03.16,Default,,0,0,0,,☎Арнайы
Dialogue: 0,0:10:00.99,0:10:03.16,Default,,0,0,0,,Мен оны арзандатып жатырмын.
Dialogue: 0,0:10:03.16,0:10:05.66,Default,,0,0,0,,☎Мен сән-салтанат туралы айтпаймын, ал жұмыс күндері
Dialogue: 0,0:10:05.66,0:10:08.36,Default,,0,0,0,,☎Әкімші
Dialogue: 0,0:10:05.66,0:10:08.36,Default,,0,0,0,,Тіпті маған тамақ жасап береді.
Dialogue: 0,0:10:10.33,0:10:12.63,Default,,0,0,0,,☎Тағы не айтайын?
Dialogue: 0,0:10:10.33,0:10:12.63,Default,,0,0,0,,Өйткені мен ақша жібермеймін.
Dialogue: 0,0:10:28.52,0:10:30.52,Default,,0,0,0,,Көлікті жалға алу
Dialogue: 0,0:10:35.02,0:10:37.03,Default,,0,0,0,,≪(Сумико) Уса-кун
Dialogue: 0,0:10:37.03,0:10:39.19,Default,,0,0,0,,Неге Нононоға қарамайсың?
Dialogue: 0,0:10:37.03,0:10:39.19,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:10:39.19,0:10:42.36,Default,,0,0,0,,Бетіңізді көрсете аласыз ба?
Dialogue: 0,0:10:39.19,0:10:42.36,Default,,0,0,0,,Киімді ауыстырудың қажеті жоқ!
Dialogue: 0,0:10:42.36,0:10:45.87,Default,,0,0,0,,Мен олай ойламаймын!
Dialogue: 0,0:10:42.36,0:10:45.87,Default,,0,0,0,,Ойланып қарасаңыз жақсы болады➡
Dialogue: 0,0:10:45.87,0:10:49.37,Default,,0,0,0,,Мен саған шай дайындадым.
Dialogue: 0,0:10:45.87,0:10:49.37,Default,,0,0,0,,Менімен бірге боласың ба?
Dialogue: 0,0:10:51.97,0:10:54.81,Default,,0,0,0,,Тамағыңызды осы жерден ішіңіз.
Dialogue: 0,0:10:54.81,0:10:57.31,Default,,0,0,0,,Рицу-чан да менімен бірге.
Dialogue: 0,0:10:57.31,0:10:59.61,Default,,0,0,0,,Қызымның оқу үлгеріміне келсек…
Dialogue: 0,0:11:02.82,0:11:05.32,Default,,0,0,0,,Рицу-чан қатал.
Dialogue: 0,0:11:06.32,0:11:08.49,Default,,0,0,0,,Әй, жақсысың ба?
Dialogue: 0,0:11:08.49,0:11:10.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:08.49,0:11:10.83,Default,,0,0,0,,Мен оны бір рет көргім келді.
Dialogue: 0,0:11:10.83,0:11:14.50,Default,,0,0,0,,Бұл романтикалық драма немесе кеңес емес.
Dialogue: 0,0:11:10.83,0:11:14.50,Default,,0,0,0,,Мағынасы бар жолдар
Dialogue: 0,0:11:14.50,0:11:17.83,Default,,0,0,0,,Бірдеңе істеп, бетінен құсатын қосалқы кейіпкер әйел!
Dialogue: 0,0:11:17.83,0:11:20.50,Default,,0,0,0,,Аа... тамаша актерлік.
Dialogue: 0,0:11:20.50,0:11:23.34,Default,,0,0,0,,≪(Сумико) Рицу-чан
Dialogue: 0,0:11:20.50,0:11:23.34,Default,,0,0,0,,Ол менің ағамның немересі➡
Dialogue: 0,0:11:23.34,0:11:25.51,Default,,0,0,0,,Мен аздап өз қарқыныммен жүрмін
Dialogue: 0,0:11:23.34,0:11:25.51,Default,,0,0,0,,Өйткені сен жақсы қызсың
Dialogue: 0,0:11:25.51,0:11:28.34,Default,,0,0,0,,Маған мейірімді болыңыз.
Dialogue: 0,0:11:25.51,0:11:28.34,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:28.34,0:11:32.01,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:11:32.01,0:11:35.35,Default,,0,0,0,,Татуласуға тырыспаңыз
Dialogue: 0,0:11:32.01,0:11:35.35,Default,,0,0,0,,Дос бол
Dialogue: 0,0:11:35.35,0:11:37.65,Default,,0,0,0,,Бұл да әйелдің қосалқы кейіпкерінің желісі ме?
Dialogue: 0,0:11:45.69,0:11:49.97,Default,,0,0,0,,<Осындай жақсы араласатынымызға сене алар емеспін...
Dialogue: 0,0:11:45.69,0:11:49.97,Default,,0,0,0,,Лас болып барады>
Dialogue: 0,0:12:20.16,0:12:24.33,Default,,0,0,0,,<О, құдайым
Dialogue: 0,0:12:20.16,0:12:24.33,Default,,0,0,0,,Емдеу сәті...>
Dialogue: 0,0:12:24.33,0:12:27.17,Default,,0,0,0,,Уса-кун!
Dialogue: 0,0:12:24.33,0:12:27.17,Default,,0,0,0,,Менің багажымда футон жоқ.
Dialogue: 0,0:12:27.17,0:12:29.17,Default,,0,0,0,,Түнде не істеп жүрсің?
Dialogue: 0,0:12:43.69,0:12:45.69,Default,,0,0,0,,Содан кейін 48 саны
Dialogue: 0,0:12:45.69,0:12:47.69,Default,,0,0,0,,Бұл әсерлі сан қандай?
Dialogue: 0,0:12:47.69,0:12:50.29,Default,,0,0,0,,Егер сіз жайлы ұйықтағыңыз келсе, 69 немесе одан да көп...
Dialogue: 0,0:12:50.29,0:12:53.13,Default,,0,0,0,,О, менің ақымақ
Dialogue: 0,0:12:53.13,0:12:57.47,Default,,0,0,0,,Бәрі жақсы болады, иә?
Dialogue: 0,0:12:53.13,0:12:57.47,Default,,0,0,0,,Біздің қазір айтып отырғанымыз сөздің аясы...
Dialogue: 0,0:12:57.47,0:13:00.47,Default,,0,0,0,,Уса-кун онда қыздар аймағы
Dialogue: 0,0:13:00.47,0:13:02.47,Default,,0,0,0,,Әй...
Dialogue: 0,0:13:04.81,0:13:07.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:16.65,0:13:19.05,Default,,0,0,0,,≪Әй, Уса-кун
Dialogue: 0,0:13:16.65,0:13:19.05,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:13:20.99,0:13:23.33,Default,,0,0,0,,≪Эй Уса-кун➡
Dialogue: 0,0:13:23.33,0:13:27.16,Default,,0,0,0,,Рицу-чанның бөксе шинайы дегеніміз не?
Dialogue: 0,0:13:23.33,0:13:27.16,Default,,0,0,0,,Бұл керемет азап емес пе?
Dialogue: 0,0:13:27.16,0:13:30.17,Default,,0,0,0,,Сіз шынымен
Dialogue: 0,0:13:27.16,0:13:30.17,Default,,0,0,0,,Өтінемін, үндемеңіз!
Dialogue: 0,0:13:40.34,0:13:43.01,Default,,0,0,0,,Олар қалай жасырынып кірді?
Dialogue: 0,0:13:43.01,0:13:48.02,Default,,0,0,0,,Ал, жоқ, шық.
Dialogue: 0,0:13:43.01,0:13:48.02,Default,,0,0,0,,Мен сенің сонда екеніңді білемін.
Dialogue: 0,0:13:48.02,0:13:50.29,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:13:50.29,0:13:52.29,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:13:52.29,0:13:56.12,Default,,0,0,0,,Міне, сен барсың.
Dialogue: 0,0:13:52.29,0:13:56.12,Default,,0,0,0,,Кішкентай фантастикалық ойын
Dialogue: 0,0:13:56.12,0:13:58.96,Default,,0,0,0,,Менің бөлмелесімде осындай жағымсыз әсерлер бар...
Dialogue: 0,0:13:58.96,0:14:02.30,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:13:58.96,0:14:02.30,Default,,0,0,0,,Мен ең көп зардап шеккен адаммын.
Dialogue: 0,0:14:02.30,0:14:06.47,Default,,0,0,0,,Уса-кун фантастикалық пьесаларды да ойнайды!
Dialogue: 0,0:14:02.30,0:14:06.47,Default,,0,0,0,,Мен жасамаймын!
Dialogue: 0,0:14:06.47,0:14:09.14,Default,,0,0,0,,«Мұны маған қалдыр да, алдымен бар!»
Dialogue: 0,0:14:06.47,0:14:09.14,Default,,0,0,0,,немесе соған ұқсас нәрсе
Dialogue: 0,0:14:09.14,0:14:11.97,Default,,0,0,0,,Мен жасамаймын!
Dialogue: 0,0:14:09.14,0:14:11.97,Default,,0,0,0,,Сұлу апаға
Dialogue: 0,0:14:11.97,0:14:15.98,Default,,0,0,0,,«Менде тәжірибе жоқ. Саған үйретейін бе?»
Dialogue: 0,0:14:11.97,0:14:15.98,Default,,0,0,0,,немесе соған ұқсас нәрсе
Dialogue: 0,0:14:15.98,0:14:18.31,Default,,0,0,0,,Бұл алдау...
Dialogue: 0,0:14:18.31,0:14:21.48,Default,,0,0,0,,Шикаши Уса-кун, сен тез бейімделесің.
Dialogue: 0,0:14:21.48,0:14:23.99,Default,,0,0,0,,3 күннен кейін үйреніп кетесіз.
Dialogue: 0,0:14:23.99,0:14:29.32,Default,,0,0,0,,Иә? Барлық тұрғындармен
Dialogue: 0,0:14:23.99,0:14:29.32,Default,,0,0,0,,Жақында дос болатын сияқтымыз.
Dialogue: 0,0:14:29.32,0:14:34.16,Default,,0,0,0,,Сумико-сан шетке
Dialogue: 0,0:14:29.32,0:14:34.16,Default,,0,0,0,,Менің ойымша, Кавай-сенпай мүмкін емес.
Dialogue: 0,0:14:34.16,0:14:36.16,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:14:36.16,0:14:39.17,Default,,0,0,0,,Пышақтағаннан кейін
Dialogue: 0,0:14:36.16,0:14:39.17,Default,,0,0,0,,Олар тіпті көз тигізбейді
Dialogue: 0,0:14:39.17,0:14:42.07,Default,,0,0,0,,Тіпті мектеп мені елемейді...
Dialogue: 0,0:14:43.34,0:14:45.67,Default,,0,0,0,,Мен тіпті күлмеймін
Dialogue: 0,0:14:45.67,0:14:48.51,Default,,0,0,0,,Сөзсіз Сіз тым немқұрайлысыз ба?
Dialogue: 0,0:14:45.67,0:14:48.51,Default,,0,0,0,,Сол адам
Dialogue: 0,0:14:48.51,0:14:52.78,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:14:48.51,0:14:52.78,Default,,0,0,0,,Мен ондай әсер алған жоқпын.
Dialogue: 0,0:14:52.78,0:14:56.28,Default,,0,0,0,,Шынай қылышын қолданғандағы бет
Dialogue: 0,0:14:52.78,0:14:56.28,Default,,0,0,0,,Ең жақсы емес!
Dialogue: 0,0:14:56.28,0:15:00.12,Default,,0,0,0,,Саяка
Dialogue: 0,0:14:56.28,0:15:00.12,Default,,0,0,0,,Маюми мен Аякамен
Dialogue: 0,0:14:56.28,0:15:00.12,Default,,0,0,0,,Тіпті біз сөйлесіп тұрған кезде де
Dialogue: 0,0:15:00.12,0:15:03.29,Default,,0,0,0,,Кім бар?
Dialogue: 0,0:15:00.12,0:15:03.29,Default,,0,0,0,,Өйткені екеуі де саяхаттап жүр
Dialogue: 0,0:15:03.29,0:15:06.29,Default,,0,0,0,,Біз кездескен жоқпыз ба?
Dialogue: 0,0:15:03.29,0:15:06.29,Default,,0,0,0,,кеңсе ханымы Майумимен
Dialogue: 0,0:15:06.29,0:15:08.30,Default,,0,0,0,,Аяка-чан, колледж студенті
Dialogue: 0,0:15:08.30,0:15:10.47,Default,,0,0,0,,Майумидің суреті бар.
Dialogue: 0,0:15:10.47,0:15:12.47,Default,,0,0,0,,О...
Dialogue: 0,0:15:12.47,0:15:14.80,Default,,0,0,0,,Ол жақсы ханым.
Dialogue: 0,0:15:14.80,0:15:17.31,Default,,0,0,0,,Менің адасушылықтарым орындалды
Dialogue: 0,0:15:19.31,0:15:22.31,Default,,0,0,0,,Широ-кун, сен маған балық сатып ала аласың ба?
Dialogue: 0,0:15:22.31,0:15:24.31,Default,,0,0,0,,Тәкаппар болыңыз.
Dialogue: 0,0:15:24.31,0:15:27.65,Default,,0,0,0,,≪(Сумико) Ой, кешіріңіз.
Dialogue: 0,0:15:24.31,0:15:27.65,Default,,0,0,0,,Барып балық сатып ал, шошқа!
Dialogue: 0,0:15:27.65,0:15:30.15,Default,,0,0,0,,Ерік!
Dialogue: 0,0:15:40.66,0:15:43.50,Default,,0,0,0,,≪(Дүкен қызметкері)
Dialogue: 0,0:15:40.66,0:15:43.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:58.28,0:16:01.62,Default,,0,0,0,,<Менің қолымда бар
Dialogue: 0,0:15:58.28,0:16:01.62,Default,,0,0,0,,Бұл сіз жеңе алмайтын түрі.>
Dialogue: 0,0:16:19.13,0:16:23.47,Default,,0,0,0,,Кенджидің ақымақ!
Dialogue: 0,0:16:19.13,0:16:23.47,Default,,0,0,0,,Ең жаман адам!
Dialogue: 0,0:16:23.47,0:16:25.64,Default,,0,0,0,,<Бұл шынымен де рас па?
Dialogue: 0,0:16:23.47,0:16:25.64,Default,,0,0,0,,Оны жасайтын адамдар бар...>
Dialogue: 0,0:16:25.64,0:16:28.81,Default,,0,0,0,,Үйленгенде
Dialogue: 0,0:16:25.64,0:16:28.81,Default,,0,0,0,,Дос болып көріну
Dialogue: 0,0:16:28.81,0:16:33.15,Default,,0,0,0,,«Біз бірге махаббат қуыршақтарын жиі жасаймыз.
Dialogue: 0,0:16:28.81,0:16:33.15,Default,,0,0,0,,Сіз компанияның акцияларын сатып алдыңыз.''
Dialogue: 0,0:16:33.15,0:16:35.15,Default,,0,0,0,,«Кенджи-сан таңдаған адам осындай».
Dialogue: 0,0:16:35.15,0:16:39.15,Default,,0,0,0,,«Ол атмосфераны оқи алуы керек (lol)»
Dialogue: 0,0:16:39.15,0:16:41.66,Default,,0,0,0,,«Ер адам некеде терісін жоғалтады.
Dialogue: 0,0:16:39.15,0:16:41.66,Default,,0,0,0,,...
Dialogue: 0,0:16:41.66,0:16:43.83,Default,,0,0,0,,«Бірнеше жыл бұрын
Dialogue: 0,0:16:41.66,0:16:43.83,Default,,0,0,0,,Жаңа ғана операцияда шықты.
Dialogue: 0,0:16:43.83,0:16:46.83,Default,,0,0,0,,«Абайлаңыз»
Dialogue: 0,0:16:43.83,0:16:46.83,Default,,0,0,0,,Мен сізге жеделхат жіберемін!
Dialogue: 0,0:16:54.27,0:16:57.44,Default,,0,0,0,,Бұл! Егер сіз осында болсаңыз
Dialogue: 0,0:16:54.27,0:16:57.44,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:16:57.44,0:16:59.94,Default,,0,0,0,,Аяқтар қалқып тұрады
Dialogue: 0,0:17:03.61,0:17:06.62,Default,,0,0,0,,Бала мені көбірек алып кетеді
Dialogue: 0,0:17:03.61,0:17:06.62,Default,,0,0,0,,Өйткені мен қиындыққа тап емеспін
Dialogue: 0,0:17:06.62,0:17:09.79,Default,,0,0,0,,Жоқ, мен жай ғана
Dialogue: 0,0:17:06.62,0:17:09.79,Default,,0,0,0,,Тек назар аудару арқылы
Dialogue: 0,0:17:09.79,0:17:12.12,Default,,0,0,0,,Мен олай сезінбеймін...
Dialogue: 0,0:17:12.12,0:17:16.29,Default,,0,0,0,,Тіпті сондай пәк жігітке
Dialogue: 0,0:17:12.12,0:17:16.29,Default,,0,0,0,,Маған ешкім қарамайды...
Dialogue: 0,0:17:20.96,0:17:24.13,Default,,0,0,0,,Өзенге орташа дәрежеде батып кету
Dialogue: 0,0:17:20.96,0:17:24.13,Default,,0,0,0,,Мен сені кінәлі сезінемін!
Dialogue: 0,0:17:24.13,0:17:26.30,Default,,0,0,0,,Уау~ Мен солай ойладым!
Dialogue: 0,0:17:24.13,0:17:26.30,Default,,0,0,0,,болды
Dialogue: 0,0:17:26.30,0:17:28.30,Default,,0,0,0,,Мен сондай бейқаммын!
Dialogue: 0,0:17:28.30,0:17:30.31,Default,,0,0,0,,Сіздің әпкеңіз өте тартымды.
Dialogue: 0,0:17:30.31,0:17:32.31,Default,,0,0,0,,Бұл мен үшін ауыр жүк...
Dialogue: 0,0:17:32.31,0:17:34.81,Default,,0,0,0,,Ауыр деп айтпа!
Dialogue: 0,0:17:37.15,0:17:40.15,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:17:37.15,0:17:40.15,Default,,0,0,0,,Төменгі корпус жаңа болғандықтан.
Dialogue: 0,0:17:40.15,0:17:42.98,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:17:40.15,0:17:42.98,Default,,0,0,0,,Сіз міне алмайсыз!
Dialogue: 0,0:17:42.98,0:17:47.49,Default,,0,0,0,,Өз еркімен куәландырмаңыз
Dialogue: 0,0:17:42.98,0:17:47.49,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:47.49,0:17:52.49,Default,,0,0,0,,Білесің бе, коньяк - ұрлық.
Dialogue: 0,0:17:47.49,0:17:52.49,Default,,0,0,0,,Картоп крахмалы да
Dialogue: 0,0:17:54.60,0:17:56.60,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:17:58.60,0:18:02.10,Default,,0,0,0,,Оякодон Оякодон Мен жегім келеді...
Dialogue: 0,0:18:02.10,0:18:05.94,Default,,0,0,0,,Төбешік бар...
Dialogue: 0,0:18:02.10,0:18:05.94,Default,,0,0,0,,Мен сөмкемді ұмытып қалдым!
Dialogue: 0,0:18:05.94,0:18:09.95,Default,,0,0,0,,Оякодон… Сумико…
Dialogue: 0,0:18:09.95,0:18:13.78,Default,,0,0,0,,<Иә?
Dialogue: 0,0:18:09.95,0:18:13.78,Default,,0,0,0,,Жаңа ғана Сумико-сан дедіңіз бе? >
Dialogue: 0,0:18:13.78,0:18:17.62,Default,,0,0,0,,Иә, оны дұрыс ұстаңыз.
Dialogue: 0,0:18:13.78,0:18:17.62,Default,,0,0,0,,Мен қоқысты лақтырамын.
Dialogue: 0,0:18:17.62,0:18:19.62,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:18:19.62,0:18:21.62,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:23.63,0:18:25.79,Default,,0,0,0,,Ол жақсы жігіт.
Dialogue: 0,0:18:25.79,0:18:27.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:27.80,0:18:29.97,Default,,0,0,0,,Мен бір-бірімізді бірінші рет кездесіп тұрғандай сезінбеймін.
Dialogue: 0,0:18:31.97,0:18:36.07,Default,,0,0,0,,Әй, әпке.
Dialogue: 0,0:18:31.97,0:18:36.07,Default,,0,0,0,,Мен сізге біраз нәрсе айтайын ба?
Dialogue: 0,0:18:38.97,0:18:41.48,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:18:43.48,0:18:45.48,Default,,0,0,0,,Тете…
Dialogue: 0,0:18:45.48,0:18:47.48,Default,,0,0,0,,Бұл не, Рицу-чан?
Dialogue: 0,0:18:50.25,0:18:52.25,Default,,0,0,0,,Бұл болуы керек еді...
Dialogue: 0,0:18:52.25,0:18:54.76,Default,,0,0,0,,Сіз тағы да мас болып қалдыңыз.
Dialogue: 0,0:18:54.76,0:18:57.76,Default,,0,0,0,,Бұл мәселе
Dialogue: 0,0:18:54.76,0:18:57.76,Default,,0,0,0,,Мен саған шабуыл жасап жатқан сияқтымын.
Dialogue: 0,0:18:57.76,0:19:00.26,Default,,0,0,0,,Ұнамайды
Dialogue: 0,0:18:57.76,0:19:00.26,Default,,0,0,0,,Сіз маған шабуыл жасадыңыз, солай ма?
Dialogue: 0,0:19:00.26,0:19:04.77,Default,,0,0,0,,Ол адам мас болған кезде көп нәрсе дұрыс емес болады.
Dialogue: 0,0:19:00.26,0:19:04.77,Default,,0,0,0,,Алыс болған дұрыс
Dialogue: 0,0:19:04.77,0:19:07.60,Default,,0,0,0,,Ақпарат өте кеш
Dialogue: 0,0:19:04.77,0:19:07.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:07.60,0:19:11.44,Default,,0,0,0,,Айтпақшы, ол кісі...
Dialogue: 0,0:19:11.44,0:19:13.94,Default,,0,0,0,,Бұл өте қызық сияқты, солай емес пе?
Dialogue: 0,0:19:16.28,0:19:18.78,Default,,0,0,0,,№1 Майуми Нишикино
Dialogue: 0,0:19:18.78,0:19:22.58,Default,,0,0,0,,Жамбастарың бір-біріне үйкеліп, қызып кетсе де
Dialogue: 0,0:19:18.78,0:19:22.58,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:26.45,0:19:29.96,Default,,0,0,0,,<Осылайша тіл-көз
Dialogue: 0,0:19:26.45,0:19:29.96,Default,,0,0,0,,Қонған кезде ұшып кетесің...>
Dialogue: 0,0:19:29.96,0:19:32.26,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:19:34.30,0:19:36.97,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:19:36.97,0:19:39.47,Default,,0,0,0,,Аа, мен бірдеңеден қорқып тұрмын, тоқтайын.
Dialogue: 0,0:19:39.47,0:19:42.14,Default,,0,0,0,,Иә? Қазірдің өзінде қиын болса да
Dialogue: 0,0:19:42.14,0:19:45.31,Default,,0,0,0,,Неліктен мұндай қорқынышты әрекетке бардың?
Dialogue: 0,0:19:45.31,0:19:47.61,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:19:49.64,0:19:52.48,Default,,0,0,0,,Ой, күте тұр, не...
Dialogue: 0,0:19:52.48,0:19:54.98,Default,,0,0,0,,Уау
Dialogue: 0,0:19:52.48,0:19:54.98,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:20:00.99,0:20:04.99,Default,,0,0,0,,Маюми-чан! Мас болған кезде көп нәрсе болады
Dialogue: 0,0:20:00.99,0:20:04.99,Default,,0,0,0,,Өйткені ол бір-бірінен ажыратылмайды
Dialogue: 0,0:20:04.99,0:20:07.83,Default,,0,0,0,,Сыртта ішпеңіз
Dialogue: 0,0:20:04.99,0:20:07.83,Default,,0,0,0,,Сіз уәде бердіңіз!
Dialogue: 0,0:20:07.83,0:20:10.00,Default,,0,0,0,,Рицу-чан да сақ болу керек➡
Dialogue: 0,0:20:10.00,0:20:12.83,Default,,0,0,0,,Өйткені Уса-кун мені қорғады.
Dialogue: 0,0:20:10.00,0:20:12.83,Default,,0,0,0,,Жақсы болғанымен...
Dialogue: 0,0:20:12.83,0:20:14.84,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:14.84,0:20:18.34,Default,,0,0,0,,Тек тұзаққа түсу арқылы...
Dialogue: 0,0:20:14.84,0:20:18.34,Default,,0,0,0,,Компрессті қайда қою керек?
Dialogue: 0,0:20:20.34,0:20:23.01,Default,,0,0,0,,Себебі Рицу-чан
Dialogue: 0,0:20:20.34,0:20:23.01,Default,,0,0,0,,Ол кенет мені қағып кетті...
Dialogue: 0,0:20:23.01,0:20:25.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:23.01,0:20:25.35,Default,,0,0,0,,Келесі жолы мен сізге сөздік лақтырамын.
Dialogue: 0,0:20:25.35,0:20:27.68,Default,,0,0,0,,Мен өлемін!
Dialogue: 0,0:20:25.35,0:20:27.68,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:27.68,0:20:31.02,Default,,0,0,0,,Жігітім бар болғандықтан сабырлы болдым.
Dialogue: 0,0:20:31.02,0:20:34.36,Default,,0,0,0,,Тіпті төбелесіп кететіндей дөрекі болды ма?
Dialogue: 0,0:20:34.36,0:20:37.06,Default,,0,0,0,,Сіздің сапарыңыз ертең аяқталады, солай ма?
Dialogue: 0,0:20:41.36,0:20:43.87,Default,,0,0,0,,Мен электрондық поштаны көрдім...
Dialogue: 0,0:20:43.87,0:20:48.37,Default,,0,0,0,,Ол уақытын бөліп отырды...
Dialogue: 0,0:20:48.37,0:20:51.47,Default,,0,0,0,,Мен оны мұндай болады деп күтпедім.
Dialogue: 0,0:20:51.47,0:20:55.31,Default,,0,0,0,,Мен сендім...
Dialogue: 0,0:20:51.47,0:20:55.31,Default,,0,0,0,,Маюми-чан...
Dialogue: 0,0:20:55.31,0:20:58.48,Default,,0,0,0,,Расында да ерлердің жолы болмай қалады.
Dialogue: 0,0:20:58.48,0:21:00.98,Default,,0,0,0,,Менің көретін көзім жоқ деп ойлаймын.
Dialogue: 0,0:21:00.98,0:21:04.49,Default,,0,0,0,,Бірақ алдыңғы жағы үш қырлы
Dialogue: 0,0:21:00.98,0:21:04.49,Default,,0,0,0,,Өйткені оның алдында төрт тармақ бар.
Dialogue: 0,0:21:04.49,0:21:06.49,Default,,0,0,0,,Даму...
Dialogue: 0,0:21:04.49,0:21:06.49,Default,,0,0,0,,үшін жасырынсын!
Dialogue: 0,0:21:06.49,0:21:09.49,Default,,0,0,0,,Мені жұбат!
Dialogue: 0,0:21:09.49,0:21:12.66,Default,,0,0,0,,<Бұл адам не дейді
Dialogue: 0,0:21:09.49,0:21:12.66,Default,,0,0,0,,Сенімсіз…>
Dialogue: 0,0:21:12.66,0:21:16.33,Default,,0,0,0,,≪(Сумико) Тамақ ішейік.
Dialogue: 0,0:21:12.66,0:21:16.33,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:21:16.33,0:21:19.33,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:21:21.67,0:21:24.01,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:21:32.68,0:21:34.85,Default,,0,0,0,,Йошикава шынымен де оның жағдайын ойлап жүр…
Dialogue: 0,0:21:34.85,0:21:37.69,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:21:37.69,0:21:40.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:48.36,0:21:51.13,Default,,0,0,0,,Бұл ауырады ма? Сенімен бәрі жақсы ма?
Dialogue: 0,0:21:51.13,0:21:53.13,Default,,0,0,0,,А, жоқ, бәрі жақсы...
Dialogue: 0,0:21:55.30,0:21:57.31,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:22:01.48,0:22:05.28,Default,,0,0,0,,Кешірім сұрау
Dialogue: 0,0:22:01.48,0:22:05.28,Default,,0,0,0,,Кеудеңізді итеріңіз.
Dialogue: 0,0:22:07.32,0:22:09.65,Default,,0,0,0,,≪(Сумико) Маюми-чан!
Dialogue: 0,0:22:09.65,0:22:32.35,Default,,0,0,0,,♬～
Dialogue: 0,0:23:41.34,0:23:45.35,Default,,0,0,0,,Мереке жақындап қалды.
Dialogue: 0,0:23:41.34,0:23:45.35,Default,,0,0,0,,Жаман нәрселерді есіме түсірме!
Dialogue: 0,0:23:45.35,0:23:48.52,Default,,0,0,0,,Елдің түкпір-түкпіріндегі кездесу орындарына баруға батылдықпен барыңыз
Dialogue: 0,0:23:45.35,0:23:48.52,Default,,0,0,0,,Мен далаға жалғыз шыққаным өкінішті
Dialogue: 0,0:23:48.52,0:23:51.29,Default,,0,0,0,,Уақытыңызды өткізудің тамаша тәсілі.
Dialogue: 0,0:23:48.52,0:23:51.29,Default,,0,0,0,,Шулы!
Dialogue: 0,0:23:51.29,0:23:54.79,Default,,0,0,0,,Бұл күдікті антиквариат дүкенінде орын алса ше?
Dialogue: 0,0:23:51.29,0:23:54.79,Default,,0,0,0,,Мен алған қарғыс сақинамен
Dialogue: 0,0:23:54.79,0:23:57.63,Default,,0,0,0,,Дүние жүзіндегі бақытты жұптар
Dialogue: 0,0:23:54.79,0:23:57.63,Default,,0,0,0,,Мен саған қарғыс айтамын!
Dialogue: 0,0:23:57.63,0:24:01.63,Default,,0,0,0,,Маюми-сан, бұл нұсқаулықта.
Dialogue: 0,0:23:57.63,0:24:01.63,Default,,0,0,0,,Оны киген адам қарғысқа ұшырайды дейді.
Dialogue: 0,0:24:01.63,0:24:04.13,Default,,0,0,0,,Мен оны кидім.
Dialogue: 0,0:24:01.63,0:24:04.13,Default,,0,0,0,,Не? Сақина киген адам
Dialogue: 0,0:24:04.13,0:24:06.97,Default,,0,0,0,,Ойланатындар ойламайды
Dialogue: 0,0:24:04.13,0:24:06.97,Default,,0,0,0,,Күтпеген адамдардың көзіне түспеу
Dialogue: 0,0:24:06.97,0:24:08.97,Default,,0,0,0,,Мен оларға мүлде қызықпаймын—
Dialogue: 0,0:24:06.97,0:24:08.97,Default,,0,0,0,,Статус-квоны сақтау керек пе?
Dialogue: 0,0:24:10.47,0:24:16.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
