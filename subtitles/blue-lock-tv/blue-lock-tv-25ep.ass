Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.13,0:00:03.14,Default,,0000,0000,0000,,Арыстан
Dialogue: 0,0:00:01.13,0:00:03.14,Default,,0000,0000,0000,,Кеттік, Наги!
Dialogue: 0,0:00:01.13,0:00:03.14,Default,,0000,0000,0000,,Иса Босс.
Dialogue: 0,0:00:05.14,0:00:07.11,Default,,0000,0000,0000,,〈“Шоколадты жоспарлаушы” арнайы шығарылымы→
Dialogue: 0,0:00:07.11,0:00:11.11,Default,,0000,0000,0000,,«Көк рок» фильмінің шығарылымын еске алу
Dialogue: 0,0:00:07.11,0:00:11.11,Default,,0000,0000,0000,,Арнайы ынтымақтастық! 〉
Dialogue: 0,0:00:12.15,0:00:14.15,Default,,0000,0000,0000,,〈Сондай танымал жоба→
Dialogue: 0,0:00:14.15,0:00:17.15,Default,,0000,0000,0000,,«Көк жартастан» ешқашан өтпеген шың
Dialogue: 0,0:00:14.15,0:00:17.15,Default,,0000,0000,0000,,өтті〉
Dialogue: 0,0:00:17.15,0:00:19.15,Default,,0000,0000,0000,,Наги күткендей...
Dialogue: 0,0:00:17.15,0:00:19.15,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:00:19.15,0:00:21.25,Default,,0000,0000,0000,,Сіз бұл жерде рамен туралы айтып отырсыз ба?
Dialogue: 0,0:00:19.15,0:00:21.25,Default,,0000,0000,0000,,Рамен! ?
Dialogue: 0,0:00:21.25,0:00:23.16,Default,,0000,0000,0000,,Рамен Наги.
Dialogue: 0,0:00:21.25,0:00:23.16,Default,,0000,0000,0000,,Нибоши рамен.
Dialogue: 0,0:00:23.16,0:00:25.13,Default,,0000,0000,0000,,Жоқ, бұл кептірілген сардина емес.
Dialogue: 0,0:00:23.16,0:00:25.13,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:00:25.13,0:00:29.10,Default,,0000,0000,0000,,〈Ешқашан өтпегендер
Dialogue: 0,0:00:25.13,0:00:29.10,Default,,0000,0000,0000,,Интуиция негізінде корреляциялық диаграммалар құру...>
Dialogue: 0,0:00:30.13,0:00:32.13,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:00:36.14,0:00:38.10,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:00:39.11,0:00:42.11,Default,,0000,0000,0000,,〈Фильм шығарар алдында!
Dialogue: 0,0:00:39.11,0:00:42.11,Default,,0000,0000,0000,,Мұны қараңыз, содан кейін кинотеатрға барыңыз! 〉
Dialogue: 0,0:00:53.12,0:00:57.09,Default,,0000,0000,0000,,Ал, бүгінгі жоба – мен бұрын соңды болмаған саммит!
Dialogue: 0,0:00:53.12,0:00:57.09,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:00:57.09,0:00:59.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:00:59.13,0:01:04.13,Default,,0000,0000,0000,,Бұл жолғы тақырып
Dialogue: 0,0:00:59.13,0:01:04.13,Default,,0000,0000,0000,,Бұл көпшіліктің назарын аударатын танымал ``Көгілдір жартас» шығармасы.
Dialogue: 0,0:01:05.13,0:01:09.14,Default,,0000,0000,0000,,Міне келдік.
Dialogue: 0,0:01:05.13,0:01:09.14,Default,,0000,0000,0000,,Бұл ''Көк жартас''.
Dialogue: 0,0:01:09.14,0:01:12.11,Default,,0000,0000,0000,,Бұл «Көк жартас» арқылы өтпейді.
Dialogue: 0,0:01:09.14,0:01:12.11,Default,,0000,0000,0000,,Барлығы.
Dialogue: 0,0:01:12.11,0:01:15.11,Default,,0000,0000,0000,,Өтінемін! өтінемін маған айтшы!
Dialogue: 0,0:01:15.11,0:01:17.08,Default,,0000,0000,0000,,Келіңіздер, Ватанабе мырза.
Dialogue: 0,0:01:15.11,0:01:17.08,Default,,0000,0000,0000,,Кездейсоқ...
Dialogue: 0,0:01:21.11,0:01:24.12,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:01:21.11,0:01:24.12,Default,,0000,0000,0000,,Мынау... а, шегелер де.
Dialogue: 0,0:01:24.12,0:01:27.12,Default,,0000,0000,0000,,Бұл бірден тәртіпсіздік.
Dialogue: 0,0:01:24.12,0:01:27.12,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,0:01:27.12,0:01:29.12,Default,,0000,0000,0000,,Бұл қауіпті.
Dialogue: 0,0:01:29.12,0:01:32.09,Default,,0000,0000,0000,,Жүр, өтіп бара жатқан жақта.
Dialogue: 0,0:01:29.12,0:01:32.09,Default,,0000,0000,0000,,Диктор Сумита да келді.
Dialogue: 0,0:01:32.09,0:01:34.13,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:01:32.09,0:01:34.13,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:01:34.13,0:01:36.10,Default,,0000,0000,0000,,Өткенде, кездейсоқ→
Dialogue: 0,0:01:36.10,0:01:39.13,Default,,0000,0000,0000,,«Көк жартас»
Dialogue: 0,0:01:36.10,0:01:39.13,Default,,0000,0000,0000,,Қалқымалы дүкен болды.
Dialogue: 0,0:01:39.13,0:01:43.10,Default,,0000,0000,0000,,Өйткені Наги әдемі еді
Dialogue: 0,0:01:39.13,0:01:43.10,Default,,0000,0000,0000,,Оған табынған соң қайттым.
Dialogue: 0,0:01:51.11,0:01:53.08,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:01:51.11,0:01:53.08,Default,,0000,0000,0000,,Шешпеймін, шеше алмаймын...!
Dialogue: 0,0:01:55.11,0:01:57.08,Default,,0000,0000,0000,,Иә, иә, иә, иә….
Dialogue: 0,0:01:55.11,0:01:57.08,Default,,0000,0000,0000,,Оны қойып, ләззат алыңыз.
Dialogue: 0,0:01:58.12,0:02:01.12,Default,,0000,0000,0000,,Сонымен қатар, біз мұнда рамен туралы айтып отырмыз...
Dialogue: 0,0:01:58.12,0:02:01.12,Default,,0000,0000,0000,,Рамен! ?
Dialogue: 0,0:02:01.12,0:02:03.09,Default,,0000,0000,0000,,Рамен Наги.
Dialogue: 0,0:02:01.12,0:02:03.09,Default,,0000,0000,0000,,Нибоши рамен.
Dialogue: 0,0:02:03.09,0:02:05.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:05.09,0:02:07.33,Default,,0000,0000,0000,,Жоқ, бұл кептірілген сардина емес.
Dialogue: 0,0:02:05.09,0:02:07.33,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:02:07.33,0:02:09.30,Default,,0000,0000,0000,,Мен ол жерге жиі барамын.
Dialogue: 0,0:02:07.33,0:02:09.30,Default,,0000,0000,0000,,Баспалдақтар...
Dialogue: 0,0:02:12.47,0:02:14.10,Default,,0000,0000,0000,,Сәлем. Баспалдақтар қатал, солай емес пе?
Dialogue: 0,0:02:14.10,0:02:17.30,Default,,0000,0000,0000,,Бұл жолы аниме 1 маусымы →
Dialogue: 0,0:02:17.30,0:02:20.11,Default,,0000,0000,0000,,Мангада 11-томға дейінгі мазмұн.
Dialogue: 0,0:02:17.30,0:02:20.11,Default,,0000,0000,0000,,Мен мұны жалғастырғым келеді.
Dialogue: 0,0:02:20.11,0:02:24.11,Default,,0000,0000,0000,,Егер сізді келесі нәрсе қызықтырса
Dialogue: 0,0:02:20.11,0:02:24.11,Default,,0000,0000,0000,,Өзіңіз қараңыз.
Dialogue: 0,0:02:24.11,0:02:26.18,Default,,0000,0000,0000,,Мен бұл туралы қызықтымын.
Dialogue: 0,0:02:24.11,0:02:26.18,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:02:26.18,0:02:29.08,Default,,0000,0000,0000,,Жарты жол…
Dialogue: 0,0:02:26.18,0:02:29.08,Default,,0000,0000,0000,,Ол маған өте қызықты нәрселерді үйретті→
Dialogue: 0,0:02:29.08,0:02:31.18,Default,,0000,0000,0000,,Оны жай қалдырмайсың ба?
Dialogue: 0,0:02:31.18,0:02:34.12,Default,,0000,0000,0000,,So...you should read it!
Dialogue: 0,0:02:34.12,0:02:36.12,Default,,0000,0000,0000,,Also, when this comes out...
Dialogue: 0,0:02:38.12,0:02:41.09,Default,,0000,0000,0000,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:02:38.12,0:02:41.09,Default,,0000,0000,0000,,«Сіз білмеймін деп ойлаймын».
Dialogue: 0,0:02:41.09,0:02:43.16,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:02:43.16,0:02:46.13,Default,,0000,0000,0000,,Айтпақшы, «Көк жартас» дегеніміз не?
Dialogue: 0,0:02:43.16,0:02:46.13,Default,,0000,0000,0000,,Бұл қандай әңгіме деп ойлайсыңдар?
Dialogue: 0,0:02:46.13,0:02:48.10,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:02:46.13,0:02:48.10,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:02:48.10,0:02:50.10,Default,,0000,0000,0000,,Айтсам жарай ма?
Dialogue: 0,0:02:48.10,0:02:50.10,Default,,0000,0000,0000,,Бұл өте жақсы.
Dialogue: 0,0:02:50.10,0:02:53.11,Default,,0000,0000,0000,,Футбол.
Dialogue: 0,0:02:50.10,0:02:53.11,Default,,0000,0000,0000,,Ой, футбол. Ал футбол ше?
Dialogue: 0,0:02:53.11,0:02:57.11,Default,,0000,0000,0000,,Егер мен рок тобында болсам...
Dialogue: 0,0:02:53.11,0:02:57.11,Default,,0000,0000,0000,,Мен де бұл музыкаға байланысты деп ойладым.
Dialogue: 0,0:03:09.12,0:03:12.13,Default,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:03:09.12,0:03:12.13,Default,,0000,0000,0000,,Тақырып түсініксіз.
Dialogue: 0,0:03:14.13,0:03:16.10,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:03:17.13,0:03:19.13,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:03:17.13,0:03:19.13,Default,,0000,0000,0000,,«Көк жартас» танымал ма?→
Dialogue: 0,0:03:19.13,0:03:22.10,Default,,0000,0000,0000,,Мен оны қысқаша қорытындыладым.
Dialogue: 0,0:03:19.13,0:03:22.10,Default,,0000,0000,0000,,Диктор Сумита, өтінемін.
Dialogue: 0,0:03:36.12,0:03:38.15,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:03:36.12,0:03:38.15,Default,,0000,0000,0000,,5 жылдан кейін! ?
Dialogue: 0,0:03:38.15,0:03:40.12,Default,,0000,0000,0000,,It's quite fast...
Dialogue: 0,0:03:41.15,0:03:43.12,Default,,0000,0000,0000,,Мен білемін, білемін.
Dialogue: 0,0:03:48.33,0:03:51.30,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:03:48.33,0:03:51.30,Default,,0000,0000,0000,,Well then, let's move on.
Dialogue: 0,0:03:52.13,0:03:55.13,Default,,0000,0000,0000,,Жалғастырсам бола ма?
Dialogue: 0,0:03:52.13,0:03:55.13,Default,,0000,0000,0000,,Пошта тапсырыс бағдарламасы….
Dialogue: 0,0:03:56.14,0:03:59.14,Default,,0000,0000,0000,,It's not a mail order program. Жоқ, жоқ, жоқ...
Dialogue: 0,0:03:59.14,0:04:01.14,Default,,0000,0000,0000,,And this is important.
Dialogue: 0,0:04:01.14,0:04:03.28,Default,,0000,0000,0000,,Ағымдағы жылдың 19 сәуірінде көптен күткен →
Dialogue: 0,0:04:03.28,0:04:06.15,Default,,0000,0000,0000,,Эпизод
Dialogue: 0,0:04:03.28,0:04:06.15,Default,,0000,0000,0000,,«Көк рок фильмі -ЭПИСОД Наги-»
Dialogue: 0,0:04:03.28,0:04:06.15,Default,,0000,0000,0000,,Жалпыға қолжетімді болғандықтан...
Dialogue: 0,0:04:06.15,0:04:09.15,Default,,0000,0000,0000,,Уау~ міне!
Dialogue: 0,0:04:06.15,0:04:09.15,Default,,0000,0000,0000,,Иә, мен оны асыға күтіп жүрмін.
Dialogue: 0,0:04:09.15,0:04:12.12,Default,,0000,0000,0000,,Бірақ бұл да менің бірінші
Dialogue: 0,0:04:09.15,0:04:12.12,Default,,0000,0000,0000,,Бұл танымал → сияқты
Dialogue: 0,0:04:12.12,0:04:14.12,Default,,0000,0000,0000,,I watched the anime.
Dialogue: 0,0:04:18.12,0:04:20.13,Default,,0000,0000,0000,,Ой, бұл қызық.
Dialogue: 0,0:04:18.12,0:04:20.13,Default,,0000,0000,0000,,Маған қызық.
Dialogue: 0,0:04:21.13,0:04:23.13,Default,,0000,0000,0000,,Айтпақшы...
Dialogue: 0,0:04:24.16,0:04:26.13,Default,,0000,0000,0000,,Олардың саны өте аз. Ах!
Dialogue: 0,0:04:24.16,0:04:26.13,Default,,0000,0000,0000,,Уау, бұл керемет.
Dialogue: 0,0:04:26.13,0:04:28.13,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:04:26.13,0:04:28.13,Default,,0000,0000,0000,,Сіз мұны қашан жасадыңыз? Масудаға келсек.
Dialogue: 0,0:04:28.13,0:04:30.14,Default,,0000,0000,0000,,Мен бастауыш, орта мектеп, орта мектеп және университетке бардым.
Dialogue: 0,0:04:28.13,0:04:30.14,Default,,0000,0000,0000,,және келісім-шарт аяқталады
Dialogue: 0,0:04:30.14,0:04:32.11,Default,,0000,0000,0000,,Сіз мұны толығымен жасайсыз ба?
Dialogue: 0,0:04:30.14,0:04:32.11,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:04:35.14,0:04:37.11,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:04:35.14,0:04:37.11,Default,,0000,0000,0000,,Ондай адам бар ма?
Dialogue: 0,0:04:39.11,0:04:41.11,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:04:44.15,0:04:46.15,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:04:46.15,0:04:49.12,Default,,0000,0000,0000,,Сіз не істеп жүрсіз...?
Dialogue: 0,0:04:46.15,0:04:49.12,Default,,0000,0000,0000,,Ондай адам бар ма?
Dialogue: 0,0:04:49.12,0:04:51.12,Default,,0000,0000,0000,,Мацуо мырза ше?
Dialogue: 0,0:04:49.12,0:04:51.12,Default,,0000,0000,0000,,Бастауыш және орта мектеп.
Dialogue: 0,0:04:53.13,0:04:55.13,Default,,0000,0000,0000,,Иә Жоқ 10 Мен капитан болдым.
Dialogue: 0,0:04:53.13,0:04:55.13,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:04:55.13,0:04:57.10,Default,,0000,0000,0000,,Буға пісірілген тоқаштар ше?
Dialogue: 0,0:04:55.13,0:04:57.10,Default,,0000,0000,0000,,Мен бастауыш мектепте оқимын.
Dialogue: 0,0:04:59.13,0:05:01.13,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:05:02.20,0:05:04.20,Default,,0000,0000,0000,,бір рет⤵️
Dialogue: 0,0:05:07.11,0:05:09.21,Default,,0000,0000,0000,,Бір ату керек пе?
Dialogue: 0,0:05:07.11,0:05:09.21,Default,,0000,0000,0000,,Бір ату….
Dialogue: 0,0:05:09.21,0:05:11.18,Default,,0000,0000,0000,,Бір оқ қызыл?
Dialogue: 0,0:05:09.21,0:05:11.18,Default,,0000,0000,0000,,Ондай адам бар ма?
Dialogue: 0,0:05:14.31,0:05:16.12,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:05:14.31,0:05:16.12,Default,,0000,0000,0000,,Өте қызық.
Dialogue: 0,0:05:16.12,0:05:18.12,Default,,0000,0000,0000,,Игучи ше?
Dialogue: 0,0:05:16.12,0:05:18.12,Default,,0000,0000,0000,,Мен де бастауыш, орта мектеп, орта мектеп, жоғары оқу орындарында оқыдым.
Dialogue: 0,0:05:19.22,0:05:21.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:19.22,0:05:21.19,Default,,0000,0000,0000,,Бірақ соңғы турнир...
Dialogue: 0,0:05:23.12,0:05:25.12,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:05:25.12,0:05:27.13,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:05:25.12,0:05:27.13,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:30.10,0:05:32.10,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:05:30.10,0:05:32.10,Default,,0000,0000,0000,,шығарып салумен аяқталды. Шынымен.
Dialogue: 0,0:05:32.10,0:05:34.10,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:05:32.10,0:05:34.10,Default,,0000,0000,0000,,Онша көп емес.
Dialogue: 0,0:05:36.14,0:05:38.14,Default,,0000,0000,0000,,"Ей! Бұл қақпаға соққы!"
Dialogue: 0,0:05:36.14,0:05:38.14,Default,,0000,0000,0000,,Үкім келеді →
Dialogue: 0,0:05:38.14,0:05:40.11,Default,,0000,0000,0000,,«Шық!» Маған айтты...
Dialogue: 0,0:05:44.11,0:05:46.18,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:05:44.11,0:05:46.18,Default,,0000,0000,0000,,Осы бұрышқа барайық.
Dialogue: 0,0:05:46.18,0:05:48.18,Default,,0000,0000,0000,,Онда бармайтындар үшін⤵️
Dialogue: 0,0:05:49.12,0:05:51.08,Default,,0000,0000,0000,,Жасағым келеді!
Dialogue: 0,0:05:56.12,0:05:58.12,Default,,0000,0000,0000,,〈Онда болмағандардың түйсігінен→
Dialogue: 0,0:05:58.12,0:06:01.09,Default,,0000,0000,0000,,Басты кейіпкерлердің қарым-қатынас диаграммасын құруға тырысыңыз →
Dialogue: 0,0:06:01.09,0:06:04.10,Default,,0000,0000,0000,,Таныс жылдық жоба>
Dialogue: 0,0:06:06.13,0:06:09.14,Default,,0000,0000,0000,,<Кейіпкерлер аттары және қарым-қатынастары
Dialogue: 0,0:06:06.13,0:06:09.14,Default,,0000,0000,0000,,Болжау кезінде →
Dialogue: 0,0:06:09.14,0:06:12.11,Default,,0000,0000,0000,,«Көк жартастың» сүйкімділігі
Dialogue: 0,0:06:09.14,0:06:12.11,Default,,0000,0000,0000,,Тереңірек қазайық〉
Dialogue: 0,0:06:16.14,0:06:19.11,Default,,0000,0000,0000,,Демек, бұл команда, солай ма?
Dialogue: 0,0:06:16.14,0:06:19.11,Default,,0000,0000,0000,,Blue Rock мүшесі.
Dialogue: 0,0:06:23.15,0:06:27.12,Default,,0000,0000,0000,,Көк тас
Dialogue: 0,0:06:23.15,0:06:27.12,Default,,0000,0000,0000,,Бұл КӨК ҚҰЛПАП
Dialogue: 0,0:06:23.15,0:06:27.12,Default,,0000,0000,0000,,Шынымен ҚҰЛПАЛАУ... «L».
Dialogue: 0,0:06:27.12,0:06:30.09,Default,,0000,0000,0000,,Ах! иә! иә! иә!
Dialogue: 0,0:06:27.12,0:06:30.09,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:32.13,0:06:35.09,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:06:32.13,0:06:35.09,Default,,0000,0000,0000,,Демек, оның мағынасы осы.
Dialogue: 0,0:06:36.10,0:06:38.10,Default,,0000,0000,0000,,Кілт!
Dialogue: 0,0:06:40.10,0:06:42.10,Default,,0000,0000,0000,,О!
Dialogue: 0,0:06:40.10,0:06:42.10,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,Мен мұны істей бастадым. Мен жасай бастадым.
Dialogue: 0,0:06:53.11,0:06:56.08,Default,,0000,0000,0000,,Теңіз түбіндегі қазына сандығын табыңыз.
Dialogue: 0,0:06:59.12,0:07:02.12,Default,,0000,0000,0000,,Алтын доп сияқты нәрсе
Dialogue: 0,0:06:59.12,0:07:02.12,Default,,0000,0000,0000,,Ол...
Dialogue: 0,0:07:08.16,0:07:11.13,Default,,0000,0000,0000,,Пеле алаяқ па? Лепе.
Dialogue: 0,0:07:08.16,0:07:11.13,Default,,0000,0000,0000,,Кейде бұл мангада болады.
Dialogue: 0,0:07:12.20,0:07:14.13,Default,,0000,0000,0000,,Сары! ? Қауіп!
Dialogue: 0,0:07:12.20,0:07:14.13,Default,,0000,0000,0000,,Сары.
Dialogue: 0,0:07:14.13,0:07:16.10,Default,,0000,0000,0000,,Осындай нәрсе...
Dialogue: 0,0:07:17.10,0:07:19.11,Default,,0000,0000,0000,,Бұл қауіпті болды.
Dialogue: 0,0:07:32.12,0:07:35.09,Default,,0000,0000,0000,,Мангада онша емес... анимеде
Dialogue: 0,0:07:32.12,0:07:35.09,Default,,0000,0000,0000,,Қорғаныс бар ма?
Dialogue: 0,0:07:39.13,0:07:42.09,Default,,0000,0000,0000,,Алғашында бұл керемет көрінді. Шынайы.
Dialogue: 0,0:07:44.13,0:07:46.10,Default,,0000,0000,0000,,Жоқ, бұл не?
Dialogue: 0,0:07:52.14,0:07:55.14,Default,,0000,0000,0000,,Сіз байсалдысыз ба? Жастық шығар.
Dialogue: 0,0:07:55.14,0:07:59.15,Default,,0000,0000,0000,,Жапон өкілінің көк түсінде
Dialogue: 0,0:07:55.14,0:07:59.15,Default,,0000,0000,0000,,Өкіл →
Dialogue: 0,0:07:59.15,0:08:01.11,Default,,0000,0000,0000,,Қорғалған.
Dialogue: 0,0:07:59.15,0:08:01.11,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:04.12,0:08:06.12,Default,,0000,0000,0000,,Жоқ, шындап.
Dialogue: 0,0:08:04.12,0:08:06.12,Default,,0000,0000,0000,,Мен бұл жақсы жол деп ойладым.
Dialogue: 0,0:08:15.26,0:08:17.26,Default,,0000,0000,0000,,Бұл жақсы жол.
Dialogue: 0,0:08:19.13,0:08:21.10,Default,,0000,0000,0000,,<Біріншіден, «Көк жартас» бұл...>
Dialogue: 0,0:08:22.24,0:08:24.20,Default,,0000,0000,0000,,<Жапония футбол одағы⤵️
Dialogue: 0,0:08:28.14,0:08:30.11,Default,,0000,0000,0000,,Уау... өте көп.
Dialogue: 0,0:08:31.11,0:08:35.15,Default,,0000,0000,0000,,Жапон футболы әлемнің үздік футболшысы болу үшін не қажет
Dialogue: 0,0:08:31.11,0:08:35.15,Default,,0000,0000,0000,,Бір ғана нәрсе.
Dialogue: 0,0:08:35.15,0:08:38.15,Default,,0000,0000,0000,,Революциялық ереуілші дүниеге келді.
Dialogue: 0,0:08:38.15,0:08:40.15,Default,,0000,0000,0000,,Бұл →
Dialogue: 0,0:08:40.15,0:08:42.12,Default,,0000,0000,0000,,Көк тас.
Dialogue: 0,0:08:43.16,0:08:49.13,Default,,0000,0000,0000,,Иә, Blue Rock деп аталатын күшейту нысанында.
Dialogue: 0,0:08:43.16,0:08:49.13,Default,,0000,0000,0000,,300 шабуылшының шыңы→
Dialogue: 0,0:08:49.13,0:08:53.10,Default,,0000,0000,0000,,Басқаша айтқанда, әлемнің ең үздік шабуылшысын жасаңыз
Dialogue: 0,0:08:49.13,0:08:53.10,Default,,0000,0000,0000,,Әңгіме〉
Dialogue: 0,0:08:55.23,0:08:58.14,Default,,0000,0000,0000,,Сонымен, барлығы осында→
Dialogue: 0,0:08:58.14,0:09:00.14,Default,,0000,0000,0000,,Барлық шабуылшы үміткерлері.
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:09:04.11,0:09:07.11,Default,,0000,0000,0000,,Бәріміз де форвардпыз.
Dialogue: 0,0:09:07.11,0:09:10.12,Default,,0000,0000,0000,,Бәріміз де форвардпыз.
Dialogue: 0,0:09:07.11,0:09:10.12,Default,,0000,0000,0000,,Уау... бұл қызық!
Dialogue: 0,0:09:15.15,0:09:18.12,Default,,0000,0000,0000,,Бір адам? қызық!
Dialogue: 0,0:09:25.13,0:09:27.13,Default,,0000,0000,0000,,Мен мұны істеуім керек. Өйткені бұл қазір маңызды.
Dialogue: 0,0:09:29.17,0:09:32.14,Default,,0000,0000,0000,,Бөлу
Dialogue: 0,0:09:29.17,0:09:32.14,Default,,0000,0000,0000,,Сіз мұны үйлесімдірек орындадыңыз ба?
Dialogue: 0,0:09:29.17,0:09:32.14,Default,,0000,0000,0000,,Өйткені бұл маңызды!
Dialogue: 0,0:09:33.14,0:09:35.14,Default,,0000,0000,0000,,〈Келесі, әрқайсысының атаулары →
Dialogue: 0,0:09:35.14,0:09:38.11,Default,,0000,0000,0000,,Сыртқы түрі мен түйсігі негізінде болжам жасайық〉
Dialogue: 0,0:09:41.18,0:09:43.12,Default,,0000,0000,0000,,Ең көп көрсеткілер.
Dialogue: 0,0:09:41.18,0:09:43.12,Default,,0000,0000,0000,,Күтілгендей, бұл ең маңыздысы.
Dialogue: 0,0:09:43.12,0:09:46.15,Default,,0000,0000,0000,,Сонымен, сіз бұл жігіттің атын білесіз бе?
Dialogue: 0,0:09:46.15,0:09:48.12,Default,,0000,0000,0000,,Тез... Иә, Мацуо-сан.
Dialogue: 0,0:09:49.16,0:09:51.12,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:09:49.16,0:09:51.12,Default,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:09:51.12,0:09:55.13,Default,,0000,0000,0000,,Со-со футбол…
Dialogue: 0,0:09:51.12,0:09:55.13,Default,,0000,0000,0000,,Бұл футбол мангасында жиі кездесетін сияқты.
Dialogue: 0,0:09:55.13,0:09:57.10,Default,,0000,0000,0000,,Біраз уақыт өткізіңіз.
Dialogue: 0,0:09:58.13,0:10:01.23,Default,,0000,0000,0000,,«shiba» «shiba» үшін дұрыс па?
Dialogue: 0,0:09:58.13,0:10:01.23,Default,,0000,0000,0000,,Шиба мырзаның «Шиба».
Dialogue: 0,0:10:01.23,0:10:03.14,Default,,0000,0000,0000,,«Кәке» «жүгіру» дегенді білдіреді ме?
Dialogue: 0,0:10:01.23,0:10:03.14,Default,,0000,0000,0000,,«Жүгіру».
Dialogue: 0,0:10:03.14,0:10:05.14,Default,,0000,0000,0000,,Төмендегі адам→
Dialogue: 0,0:10:05.14,0:10:07.14,Default,,0000,0000,0000,,Широгами
Dialogue: 0,0:10:05.14,0:10:07.14,Default,,0000,0000,0000,,Ақ шашты адам….
Dialogue: 0,0:10:05.14,0:10:07.14,Default,,0000,0000,0000,,Мынау? иә.
Dialogue: 0,0:10:11.28,0:10:13.25,Default,,0000,0000,0000,,Бұл аздап...
Dialogue: 0,0:10:16.25,0:10:19.19,Default,,0000,0000,0000,,Сары! жақсы.
Dialogue: 0,0:10:16.25,0:10:19.19,Default,,0000,0000,0000,,Сары.
Dialogue: 0,0:10:19.19,0:10:23.16,Default,,0000,0000,0000,,Шашу
Dialogue: 0,0:10:19.19,0:10:23.16,Default,,0000,0000,0000,,Жақсы, бірақ Шибато т.б.
Dialogue: 0,0:10:19.19,0:10:23.16,Default,,0000,0000,0000,,Бұл жақсы жол Бұл жақсы жол.
Dialogue: 0,0:10:25.16,0:10:29.13,Default,,0000,0000,0000,,Хакухатсу
Dialogue: 0,0:10:25.16,0:10:29.13,Default,,0000,0000,0000,,Ватанабе мырза, бұрынғы ақ шашты жігіт.
Dialogue: 0,0:10:25.16,0:10:29.13,Default,,0000,0000,0000,,Бір сәт үйге тиген жоқ па?
Dialogue: 0,0:10:31.10,0:10:34.13,Default,,0000,0000,0000,,Катагегинджи?
Dialogue: 0,0:10:34.13,0:10:36.14,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:10:36.14,0:10:39.11,Default,,0000,0000,0000,,Басыңызды көтеріңіз.
Dialogue: 0,0:10:36.14,0:10:39.11,Default,,0000,0000,0000,,Басыңызды көтеріңіз.
Dialogue: 0,0:10:39.11,0:10:41.11,Default,,0000,0000,0000,,Карточка жоқ па? Карта жоқ па?
Dialogue: 0,0:10:41.11,0:10:45.11,Default,,0000,0000,0000,,Эй... Тек тексерсем бола ма?
Dialogue: 0,0:10:41.11,0:10:45.11,Default,,0000,0000,0000,,VAR...VAR.
Dialogue: 0,0:10:45.11,0:10:47.11,Default,,0000,0000,0000,,Катагегинджи.
Dialogue: 0,0:10:45.11,0:10:47.11,Default,,0000,0000,0000,,Катагегинджи бұл...
Dialogue: 0,0:10:49.12,0:10:51.12,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Сіз қалай ойлайсыз?
Dialogue: 0,0:10:53.09,0:10:56.12,Default,,0000,0000,0000,,Бұл сары болды!
Dialogue: 0,0:10:53.09,0:10:56.12,Default,,0000,0000,0000,,Ах~ Бұл қорқынышты.
Dialogue: 0,0:10:56.12,0:10:59.13,Default,,0000,0000,0000,,Қатты!
Dialogue: 0,0:10:56.12,0:10:59.13,Default,,0000,0000,0000,,Қатты! Судья: Бұл қиын.
Dialogue: 0,0:11:02.13,0:11:04.10,Default,,0000,0000,0000,,Наги осында!
Dialogue: 0,0:11:02.13,0:11:04.10,Default,,0000,0000,0000,,...бұл дегеніміз бе?
Dialogue: 0,0:11:04.10,0:11:06.17,Default,,0000,0000,0000,,Бұл керемет, солай ма? тыныш.
Dialogue: 0,0:11:04.10,0:11:06.17,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:11:06.17,0:11:10.14,Default,,0000,0000,0000,,Бұл фильмнің субтитрінде дерлік.
Dialogue: 0,0:11:06.17,0:11:10.14,Default,,0000,0000,0000,,“-ЭПИСОД Наги-”.
Dialogue: 0,0:11:11.10,0:11:13.14,Default,,0000,0000,0000,,Адалдық.
Dialogue: 0,0:11:13.14,0:11:15.11,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:11:19.11,0:11:21.11,Default,,0000,0000,0000,,Солай емес пе? Бірдеңе...
Dialogue: 0,0:11:21.11,0:11:23.08,Default,,0000,0000,0000,,Чинненшу
Dialogue: 0,0:11:21.11,0:11:23.08,Default,,0000,0000,0000,,Чиненки...
Dialogue: 0,0:11:21.11,0:11:23.08,Default,,0000,0000,0000,,Сирек тебу сияқты нәрсе.
Dialogue: 0,0:11:24.12,0:11:27.12,Default,,0000,0000,0000,,«Тепудің» шамалы элементі бар.
Dialogue: 0,0:11:27.12,0:11:30.09,Default,,0000,0000,0000,,Бұл керемет түрі емес, солай ма?
Dialogue: 0,0:11:27.12,0:11:30.09,Default,,0000,0000,0000,,Бұл үшінші, солай емес пе?
Dialogue: 0,0:11:30.09,0:11:33.09,Default,,0000,0000,0000,,Айтпақшы, Нагидің есімі осында.
Dialogue: 0,0:11:36.13,0:11:40.13,Default,,0000,0000,0000,,Ах... Сейширо Наги.
Dialogue: 0,0:11:36.13,0:11:40.13,Default,,0000,0000,0000,,Сейширо Наги.
Dialogue: 0,0:11:40.13,0:11:42.10,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:11:46.11,0:11:48.11,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:11:53.11,0:11:56.12,Default,,0000,0000,0000,,Футбол қауымдастығы…?
Dialogue: 0,0:11:53.11,0:11:56.12,Default,,0000,0000,0000,,Ол адам жоқ!
Dialogue: 0,0:11:56.12,0:11:58.12,Default,,0000,0000,0000,,Бұл адам Сейширо Наги емес пе?
Dialogue: 0,0:11:58.12,0:12:00.09,Default,,0000,0000,0000,,Мынау... мынау ма?
Dialogue: 0,0:12:04.09,0:12:06.13,Default,,0000,0000,0000,,Бұл адам сізге ұнамайтын адам шығар.
Dialogue: 0,0:12:06.13,0:12:10.10,Default,,0000,0000,0000,,Бұл ақ емес пе?
Dialogue: 0,0:12:06.13,0:12:10.10,Default,,0000,0000,0000,,Мен солай ойладым! Соған ұқсас нәрсе.
Dialogue: 0,0:12:10.10,0:12:13.17,Default,,0000,0000,0000,,Бұл Сейширо Наги емес пе?
Dialogue: 0,0:12:13.17,0:12:16.14,Default,,0000,0000,0000,,Бұл жігіт? Мұнда.
Dialogue: 0,0:12:13.17,0:12:16.14,Default,,0000,0000,0000,,Жоқ, бар! Мүлдем иә, мүлде иә...!
Dialogue: 0,0:12:18.14,0:12:20.11,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:12:18.14,0:12:20.11,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:12:21.11,0:12:23.08,Default,,0000,0000,0000,,Футбол ойнайық!
Dialogue: 0,0:12:24.14,0:12:29.12,Default,,0000,0000,0000,,<“Блю-рок фильмі -ЭПИСОД Наги-”
Dialogue: 0,0:12:24.14,0:12:29.12,Default,,0000,0000,0000,,Сейширо Наги, ол да басты кейіпкер...〉
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,Менің арманым басталды.
Dialogue: 0,0:12:32.12,0:12:35.12,Default,,0000,0000,0000,,<Футбол тәжірибесі
Dialogue: 0,0:12:32.12,0:12:35.12,Default,,0000,0000,0000,,Жарты жыл болса да→
Dialogue: 0,0:12:35.12,0:12:37.09,Default,,0000,0000,0000,,Керемет талғамы бар данышпан бала〉
Dialogue: 0,0:12:38.09,0:12:41.09,Default,,0000,0000,0000,,<әсіресе
Dialogue: 0,0:12:38.09,0:12:41.09,Default,,0000,0000,0000,,Оның тұзаққа түсу қабілеті керемет〉
Dialogue: 0,0:12:42.23,0:12:46.20,Default,,0000,0000,0000,,Мен өзімді футболда сынап көргім келеді!
Dialogue: 0,0:12:47.30,0:12:49.27,Default,,0000,0000,0000,,Исаги
Dialogue: 0,0:12:47.30,0:12:49.27,Default,,0000,0000,0000,,Бұл құбыжық дәл солай!
Dialogue: 0,0:12:51.14,0:12:53.14,Default,,0000,0000,0000,,Иә. Мен оны содан кейін шығарамын.
Dialogue: 0,0:12:51.14,0:12:53.14,Default,,0000,0000,0000,,Бұл қайсысы?
Dialogue: 0,0:12:53.14,0:12:55.14,Default,,0000,0000,0000,,«Игараши»?
Dialogue: 0,0:12:53.14,0:12:55.14,Default,,0000,0000,0000,,Иә «Игараши»...?
Dialogue: 0,0:12:57.28,0:12:59.25,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:13:03.12,0:13:05.12,Default,,0000,0000,0000,,«Гриму». иә.
Dialogue: 0,0:13:06.12,0:13:08.12,Default,,0000,0000,0000,,Сол жақтағы екінші адам емес пе?
Dialogue: 0,0:13:08.12,0:13:10.12,Default,,0000,0000,0000,,Көз әжімі бар ма?
Dialogue: 0,0:13:08.12,0:13:10.12,Default,,0000,0000,0000,,, солай ма?
Dialogue: 0,0:13:10.12,0:13:12.12,Default,,0000,0000,0000,,Бұл аздап ауыр...
Dialogue: 0,0:13:14.13,0:13:17.10,Default,,0000,0000,0000,,Гримм
Dialogue: 0,0:13:14.13,0:13:17.10,Default,,0000,0000,0000,,Бірақ «Куриму»...
Dialogue: 0,0:13:14.13,0:13:17.10,Default,,0000,0000,0000,,Дұрыс, дұрыс...
Dialogue: 0,0:13:17.10,0:13:19.10,Default,,0000,0000,0000,,Күтпеген жерден….
Dialogue: 0,0:13:20.10,0:13:22.10,Default,,0000,0000,0000,,Ата….
Dialogue: 0,0:13:20.10,0:13:22.10,Default,,0000,0000,0000,,Барлығын бір рет алу керек.
Dialogue: 0,0:13:22.10,0:13:24.10,Default,,0000,0000,0000,,Сау болыңыз...
Dialogue: 0,0:13:25.14,0:13:27.11,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:13:25.14,0:13:27.11,Default,,0000,0000,0000,,Оңай алғаныңыз дұрыс.
Dialogue: 0,0:13:27.11,0:13:29.11,Default,,0000,0000,0000,,Қауіпті Қауіпті Қауіпті….
Dialogue: 0,0:13:31.11,0:13:33.11,Default,,0000,0000,0000,,Қауіпті Қауіпті Қауіпті….
Dialogue: 0,0:13:31.11,0:13:33.11,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:13:33.11,0:13:35.11,Default,,0000,0000,0000,,Мені бақылап жатыр.
Dialogue: 0,0:13:33.11,0:13:35.11,Default,,0000,0000,0000,,Тағы бір бөлік.
Dialogue: 0,0:13:35.11,0:13:37.12,Default,,0000,0000,0000,,Мен оны бір рет толтырып көруім керек.
Dialogue: 0,0:13:37.12,0:13:39.08,Default,,0000,0000,0000,,Бір рет, тез толтырыңыз...
Dialogue: 0,0:13:37.12,0:13:39.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:41.12,0:13:43.09,Default,,0000,0000,0000,,«Сенгири»….
Dialogue: 0,0:13:41.12,0:13:43.09,Default,,0000,0000,0000,,«Сенгири Хьюма»…?
Dialogue: 0,0:13:43.09,0:13:45.12,Default,,0000,0000,0000,,«Жыртып тастау»?
Dialogue: 0,0:13:43.09,0:13:45.12,Default,,0000,0000,0000,,«Чигири» емес пе?
Dialogue: 0,0:13:45.12,0:13:47.09,Default,,0000,0000,0000,,Ах...! иә.
Dialogue: 0,0:13:48.09,0:13:50.16,Default,,0000,0000,0000,,Бұл «пума» емес.
Dialogue: 0,0:13:50.16,0:13:53.13,Default,,0000,0000,0000,,Мұнымен «пью» деп айта аласыз ба?
Dialogue: 0,0:13:50.16,0:13:53.13,Default,,0000,0000,0000,,Бұл «пума» емес...
Dialogue: 0,0:13:55.13,0:13:57.10,Default,,0000,0000,0000,,«Пума» бұл... ақыр соңында.
Dialogue: 0,0:13:58.10,0:14:00.11,Default,,0000,0000,0000,,А, бірақ...
Dialogue: 0,0:13:58.10,0:14:00.11,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:14:00.11,0:14:02.11,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:14:05.11,0:14:07.11,Default,,0000,0000,0000,,Уау~ Бұл рас.
Dialogue: 0,0:14:05.11,0:14:07.11,Default,,0000,0000,0000,,А, мен сенімдімін...
Dialogue: 0,0:14:09.15,0:14:12.15,Default,,0000,0000,0000,,Ол жоғарғы оң жақта.
Dialogue: 0,0:14:09.15,0:14:12.15,Default,,0000,0000,0000,,Иә, иә, иә, иә... Міне кеттік.
Dialogue: 0,0:14:12.15,0:14:14.12,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:14:17.12,0:14:20.13,Default,,0000,0000,0000,,Ал, жақсы...
Dialogue: 0,0:14:17.12,0:14:20.13,Default,,0000,0000,0000,,Оны аздап бөлшектеп, оқып көрсек ше?
Dialogue: 0,0:14:22.13,0:14:24.13,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:14:26.17,0:14:28.13,Default,,0000,0000,0000,,А, қазірдің өзінде...!
Dialogue: 0,0:14:29.13,0:14:32.14,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:14:29.13,0:14:32.14,Default,,0000,0000,0000,,Күткендей шықты!
Dialogue: 0,0:14:32.14,0:14:35.11,Default,,0000,0000,0000,,Бұл жақсы болмады...
Dialogue: 0,0:14:32.14,0:14:35.11,Default,,0000,0000,0000,,Обер….
Dialogue: 0,0:14:35.11,0:14:37.14,Default,,0000,0000,0000,,Бұл баклажан болуы мүмкін емес.
Dialogue: 0,0:14:37.14,0:14:39.11,Default,,0000,0000,0000,,Баклажан қай бөлікке жатады?
Dialogue: 0,0:14:37.14,0:14:39.11,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,0:14:39.11,0:14:41.15,Default,,0000,0000,0000,,Сіз қайда және не ойладыңыз?
Dialogue: 0,0:14:41.15,0:14:43.12,Default,,0000,0000,0000,,Қазір және осында.
Dialogue: 0,0:14:47.12,0:14:50.12,Default,,0000,0000,0000,,Мауах
Dialogue: 0,0:14:47.12,0:14:50.12,Default,,0000,0000,0000,,Тағы біраз бұрылыңыз
Dialogue: 0,0:14:47.12,0:14:50.12,Default,,0000,0000,0000,,Басқаша айтқанда...
Dialogue: 0,0:14:51.12,0:14:53.09,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:14:51.12,0:14:53.09,Default,,0000,0000,0000,,«Айналдыру» астындағы атау?
Dialogue: 0,0:14:56.13,0:14:58.13,Default,,0000,0000,0000,,Бұл «айналдыру» емес.
Dialogue: 0,0:14:59.13,0:15:01.10,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:14:59.13,0:15:01.10,Default,,0000,0000,0000,,Тамаша!
Dialogue: 0,0:15:04.14,0:15:06.11,Default,,0000,0000,0000,,Бұл «хачираку» емес.
Dialogue: 0,0:15:11.14,0:15:13.11,Default,,0000,0000,0000,,Шулы "Хаппа Хаппа"...
Dialogue: 0,0:15:15.11,0:15:17.12,Default,,0000,0000,0000,,Жақын... жақын.
Dialogue: 0,0:15:15.11,0:15:17.12,Default,,0000,0000,0000,,Қазір бітуге жақын.
Dialogue: 0,0:15:18.15,0:15:20.15,Default,,0000,0000,0000,,«Бачира»?
Dialogue: 0,0:15:18.15,0:15:20.15,Default,,0000,0000,0000,,Бачира
Dialogue: 0,0:15:18.15,0:15:20.15,Default,,0000,0000,0000,,Айнала
Dialogue: 0,0:15:18.15,0:15:20.15,Default,,0000,0000,0000,,«Хачираку Кай».
Dialogue: 0,0:15:20.15,0:15:22.15,Default,,0000,0000,0000,,Енді мынаны шығарайық.
Dialogue: 0,0:15:22.15,0:15:24.12,Default,,0000,0000,0000,,Алдымен түсінгенімді айтайын.
Dialogue: 0,0:15:24.12,0:15:26.13,Default,,0000,0000,0000,,«Анри»
Dialogue: 0,0:15:24.12,0:15:26.13,Default,,0000,0000,0000,,Одақ шығар.
Dialogue: 0,0:15:26.13,0:15:28.13,Default,,0000,0000,0000,,Не? бұл….
Dialogue: 0,0:15:31.13,0:15:33.13,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:15:31.13,0:15:33.13,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:15:38.14,0:15:40.14,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:15:47.11,0:15:49.11,Default,,0000,0000,0000,,Ах Марадона...
Dialogue: 0,0:15:49.11,0:15:52.12,Default,,0000,0000,0000,,Ума... Ума... Умарадона.
Dialogue: 0,0:15:49.11,0:15:52.12,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,0:15:53.15,0:15:56.12,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:15:57.12,0:15:59.12,Default,,0000,0000,0000,,Бұл сөзсіз "шоэй", солай ма?
Dialogue: 0,0:16:02.16,0:16:04.16,Default,,0000,0000,0000,,«Умарадона Шои.»
Dialogue: 0,0:16:02.16,0:16:04.16,Default,,0000,0000,0000,,«Умарадона Шоей»….
Dialogue: 0,0:16:06.13,0:16:09.13,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:16:06.13,0:16:09.13,Default,,0000,0000,0000,,Ей, толтырайық...
Dialogue: 0,0:16:10.14,0:16:12.14,Default,,0000,0000,0000,,〈Сонымен
Dialogue: 0,0:16:10.14,0:16:12.14,Default,,0000,0000,0000,,Дұрыс корреляция диаграммасы →
Бұл
Dialogue: 0,0:16:12.14,0:16:14.11,Default,,0000,0000,0000,,Көріп отырғаныңыздай
Dialogue: 0,0:16:12.14,0:16:14.11,Default,,0000,0000,0000,,болды
Dialogue: 0,0:16:16.14,0:16:18.11,Default,,0000,0000,0000,,<Осы фильм нұсқасында→
Dialogue: 0,0:16:18.11,0:16:20.11,Default,,0000,0000,0000,,Сейширо Наги – басты кейіпкер →
Dialogue: 0,0:16:20.11,0:16:22.11,Default,,0000,0000,0000,,Телехикаяда→
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Йоичи
Dialogue: 0,0:16:22.11,0:16:25.12,Default,,0000,0000,0000,,Басты кейіпкер - Киёшиичи есімді бала.
Dialogue: 0,0:16:27.15,0:16:29.15,Default,,0000,0000,0000,,《Футбол бұл...→
Dialogue: 0,0:16:29.15,0:16:32.12,Default,,0000,0000,0000,,Бұл 11 адам ойнайтын спорт түрі.
Dialogue: 0,0:16:33.09,0:16:36.13,Default,,0000,0000,0000,,《Бұл галстук...》
Dialogue: 0,0:16:36.13,0:16:38.10,Default,,0000,0000,0000,,《Өтірік! ? 》
Dialogue: 0,0:16:38.10,0:16:41.10,Default,,0000,0000,0000,,
Dialogue: 0,0:16:41.10,0:16:46.11,Default,,0000,0000,0000,,〈Киёши префектуралық турнирдің финалында жеңілген орта мектеп оқушысы.
Dialogue: 0,0:16:41.10,0:16:46.11,Default,,0000,0000,0000,,Аты жоқ Форвард>
Dialogue: 0,0:16:48.11,0:16:50.11,Default,,0000,0000,0000,,〈Алайда, Blue Rock-қа қосылғаннан кейін→
Dialogue: 0,0:16:50.11,0:16:54.11,Default,,0000,0000,0000,,Өзіңізде бар екенін байқамаған күшті жақтары туралы біліңіз.
Dialogue: 0,0:16:50.11,0:16:54.11,Default,,0000,0000,0000,,Мен оянамын〉
Dialogue: 0,0:16:55.11,0:17:00.12,Default,,0000,0000,0000,,<Әсіресе тікелей түсіру
Dialogue: 0,0:16:55.11,0:17:00.12,Default,,0000,0000,0000,,Ең жақсы Blue Rock мүшесі
Dialogue: 0,0:17:07.09,0:17:09.09,Default,,0000,0000,0000,,<Сонымен...>
Dialogue: 0,0:17:13.13,0:17:15.13,Default,,0000,0000,0000,,Бұл жерде супер пьеса бар.
Dialogue: 0,0:17:13.13,0:17:15.13,Default,,0000,0000,0000,,Керемет ойын.
Dialogue: 0,0:17:15.13,0:17:17.14,Default,,0000,0000,0000,,<«Көк жартаста»→
Dialogue: 0,0:17:17.14,0:17:20.11,Default,,0000,0000,0000,,Әрбір таңба үшін
Dialogue: 0,0:17:17.14,0:17:20.11,Default,,0000,0000,0000,,Керемет қабілеті бар→
Dialogue: 0,0:17:20.11,0:17:25.11,Default,,0000,0000,0000,,Ойын барысында супер ойындар
Dialogue: 0,0:17:20.11,0:17:25.11,Default,,0000,0000,0000,,Маңызды сәттердің бірі>
Dialogue: 0,0:17:34.12,0:17:38.12,Default,,0000,0000,0000,,<Бұдан былай мұндай супер ойын техникасының атауы болады
Dialogue: 0,0:17:34.12,0:17:38.12,Default,,0000,0000,0000,,Мен сізге көрсетемін →
Dialogue: 0,0:17:38.12,0:17:41.09,Default,,0000,0000,0000,,Бұл қандай техника?
Dialogue: 0,0:17:38.12,0:17:41.09,Default,,0000,0000,0000,,Болжаңыз〉
Dialogue: 0,0:17:42.13,0:17:44.13,Default,,0000,0000,0000,,Біріншіден, мен оны ертерек таныстырдым→
Dialogue: 0,0:17:44.13,0:17:48.10,Default,,0000,0000,0000,,Сейширо Нагидің супер ойыны
Dialogue: 0,0:17:44.13,0:17:48.10,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:17:49.10,0:17:51.14,Default,,0000,0000,0000,,Жалпы сіңіру….
Dialogue: 0,0:17:51.14,0:17:53.11,Default,,0000,0000,0000,,Алдымен оны қалай оқу керек...
Dialogue: 0,0:18:01.11,0:18:03.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:01.11,0:18:03.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:07.19,0:18:09.19,Default,,0000,0000,0000,,Бір-біріне жабысып қалды.
Dialogue: 0,0:18:07.19,0:18:09.19,Default,,0000,0000,0000,,Қосымша….
Dialogue: 0,0:18:12.19,0:18:14.19,Default,,0000,0000,0000,,Менің айтайын дегенім бұл емес...
Dialogue: 0,0:18:15.13,0:18:17.10,Default,,0000,0000,0000,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:18:15.13,0:18:17.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:19.10,0:18:21.17,Default,,0000,0000,0000,,Мақсат!
Dialogue: 0,0:18:21.17,0:18:24.10,Default,,0000,0000,0000,,Мақсат Мақсат Мақсат Мақсат Мақсат Мақсат!
Dialogue: 0,0:18:21.17,0:18:24.10,Default,,0000,0000,0000,,Қаз келді. Қаз.
Dialogue: 0,0:18:24.10,0:18:26.11,Default,,0000,0000,0000,,Олай болса, сәл ғана.
Dialogue: 0,0:18:24.10,0:18:26.11,Default,,0000,0000,0000,,Дұрыс жауап супер ойын сахнасы →
Dialogue: 0,0:18:26.11,0:18:28.11,Default,,0000,0000,0000,,Дайындаңыз.
Dialogue: 0,0:18:26.11,0:18:28.11,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:18:28.11,0:18:30.11,Default,,0000,0000,0000,,《Қорғаныс қысымы
Dialogue: 0,0:18:28.11,0:18:30.11,Default,,0000,0000,0000,,Кеткен тыныштық → болады
Dialogue: 0,0:18:30.11,0:18:35.11,Default,,0000,0000,0000,,Алға емін-еркін қарау
Dialogue: 0,0:18:30.11,0:18:35.11,Default,,0000,0000,0000,,Сіз өзіңізге ұнайтын кез келген кеңістікте ойнай аласыз→
Dialogue: 0,0:18:35.11,0:18:41.12,Default,,0000,0000,0000,,Жол жүру бағытында.
Dialogue: 0,0:18:35.11,0:18:41.12,Default,,0000,0000,0000,,Ату қабілеті бар күшті пас жақсы.
Dialogue: 0,0:18:41.12,0:18:43.12,Default,,0000,0000,0000,,《Міне, біз көрсетеміз
Dialogue: 0,0:18:41.12,0:18:43.12,Default,,0000,0000,0000,,Бұрынғыдан өзгеше→
Dialogue: 0,0:18:43.12,0:18:45.09,Default,,0000,0000,0000,,Жұмсақ…》
Dialogue: 0,0:18:48.13,0:18:50.10,Default,,0000,0000,0000,,《Бұл Нагидің күші...》
Dialogue: 0,0:18:51.10,0:18:53.10,Default,,0000,0000,0000,,Уау~ Керемет!
Dialogue: 0,0:18:51.10,0:18:53.10,Default,,0000,0000,0000,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:18:53.10,0:18:55.27,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:53.10,0:18:55.27,Default,,0000,0000,0000,,Бұл өте керемет.
Dialogue: 0,0:18:55.27,0:18:57.27,Default,,0000,0000,0000,,Сейширо Нагидің супер ойыны жалғасуда
Dialogue: 0,0:18:55.27,0:18:57.27,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:18:58.14,0:19:00.21,Default,,0000,0000,0000,,Бос мылтықтан тура соққы.
Dialogue: 0,0:19:00.21,0:19:02.11,Default,,0000,0000,0000,,Иә, жақсы, жақсы, жақсы.
Dialogue: 0,0:19:02.11,0:19:05.08,Default,,0000,0000,0000,,Бұл оның да басқаша екенін білдіре ме? Қалай оқу керек.
Dialogue: 0,0:19:02.11,0:19:05.08,Default,,0000,0000,0000,,Екі сатылы түрге дейін Екі сатылы түрі….
Dialogue: 0,0:19:10.28,0:19:13.12,Default,,0000,0000,0000,,Хехехе…. Бұл «Жан» емес.
Dialogue: 0,0:19:10.28,0:19:13.12,Default,,0000,0000,0000,,Пистолет?
Dialogue: 0,0:19:13.12,0:19:16.12,Default,,0000,0000,0000,,Күйіп қалу….
Dialogue: 0,0:19:13.12,0:19:16.12,Default,,0000,0000,0000,,Бұл бос мылтық. Бұл бос мылтық.
Dialogue: 0,0:19:19.12,0:19:21.13,Default,,0000,0000,0000,,Бұл «орыс рулеткасы» емес...
Dialogue: 0,0:19:19.12,0:19:21.13,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:19:21.13,0:19:23.13,Default,,0000,0000,0000,,Қорқынышты.
Dialogue: 0,0:19:21.13,0:19:23.13,Default,,0000,0000,0000,,Кенет өзімді ақымақ сияқты сезіндім...
Dialogue: 0,0:19:23.13,0:19:25.13,Default,,0000,0000,0000,,Кенет ақымақ сияқты сөйлей бастайсың...
Dialogue: 0,0:19:25.13,0:19:27.10,Default,,0000,0000,0000,,«Орыс рулеткасы».
Dialogue: 0,0:19:36.14,0:19:38.11,Default,,0000,0000,0000,,Галлюцинация сияқты нәрсе бар ма?
Dialogue: 0,0:19:38.11,0:19:41.11,Default,,0000,0000,0000,,Нөлдік гравитация сияқты нәрсе...
Dialogue: 0,0:19:38.11,0:19:41.11,Default,,0000,0000,0000,,Жоқ, мүлде емес.
Dialogue: 0,0:19:43.15,0:19:45.12,Default,,0000,0000,0000,,Жасандылық?
Dialogue: 0,0:19:52.12,0:19:54.13,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:19:54.13,0:19:56.13,Default,,0000,0000,0000,,Өте жақсы екен!
Dialogue: 0,0:19:54.13,0:19:56.13,Default,,0000,0000,0000,,Уау, бұл жақсы.
Dialogue: 0,0:19:56.13,0:19:59.13,Default,,0000,0000,0000,,Сіз шешім қабылдағанда жақсы сезінесіз.
Dialogue: 0,0:19:56.13,0:19:59.13,Default,,0000,0000,0000,,Керемет кадр.
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,Бір қызығы, олар тіпті қолдан жасап қойған.
Dialogue: 0,0:19:59.13,0:20:02.10,Default,,0000,0000,0000,,VTR Міне, осы.
Dialogue: 0,0:20:03.14,0:20:05.14,Default,,0000,0000,0000,,Мұны қалай жасауға болады? бұл.
Dialogue: 0,0:20:05.14,0:20:07.14,Default,,0000,0000,0000,,《Тікелей Риннің артында! 》
Dialogue: 0,0:20:07.14,0:20:09.11,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:20:09.11,0:20:11.21,Default,,0000,0000,0000,,《Ой, мына жігіт...! 》
Dialogue: 0,0:20:11.21,0:20:14.15,Default,,0000,0000,0000,,《Осы донпишаның асуында да
Dialogue: 0,0:20:11.21,0:20:14.15,Default,,0000,0000,0000,,Оқу мен реакцияны әрең қадағалады》
Dialogue: 0,0:20:14.15,0:20:17.12,Default,,0000,0000,0000,,《Онда... Мен атамын! 》
Dialogue: 0,0:20:17.12,0:20:19.12,Default,,0000,0000,0000,,Уау не? не? не?
Dialogue: 0,0:20:19.12,0:20:21.32,Default,,0000,0000,0000,,《...тұзақ сияқты! 》
Dialogue: 0,0:20:21.32,0:20:23.16,Default,,0000,0000,0000,,《Кімнен...》
Dialogue: 0,0:20:23.16,0:20:25.12,Default,,0000,0000,0000,,Әй, сен осылай айтып тұрсың!
Dialogue: 0,0:20:23.16,0:20:25.12,Default,,0000,0000,0000,,Сондықтан екі сатылы жүйе.
Dialogue: 0,0:20:27.13,0:20:30.16,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:20:27.13,0:20:30.16,Default,,0000,0000,0000,,Ах~ Бұл керемет.
Dialogue: 0,0:20:30.16,0:20:32.13,Default,,0000,0000,0000,,Құдай...
Dialogue: 0,0:20:32.13,0:20:34.10,Default,,0000,0000,0000,,Қызықты.
Dialogue: 0,0:20:32.13,0:20:34.10,Default,,0000,0000,0000,,Бұл керемет...
Dialogue: 0,0:20:34.10,0:20:37.10,Default,,0000,0000,0000,,Қызықты
Dialogue: 0,0:20:34.10,0:20:37.10,Default,,0000,0000,0000,,Қызықты.
Dialogue: 0,0:20:34.10,0:20:37.10,Default,,0000,0000,0000,,Сіз: «Құдай?» дедіңіз бе?
Dialogue: 0,0:20:37.10,0:20:39.14,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:20:37.10,0:20:39.14,Default,,0000,0000,0000,,Не болып жатыр →
Dialogue: 0,0:20:39.14,0:20:43.11,Default,,0000,0000,0000,,Бірінші рет саусақпен ысқылаңыз
Dialogue: 0,0:20:39.14,0:20:43.11,Default,,0000,0000,0000,,Оны жалған жасау →
Dialogue: 0,0:20:43.11,0:20:46.11,Default,,0000,0000,0000,,Екінші волейболды ату...
Dialogue: 0,0:20:46.11,0:20:48.08,Default,,0000,0000,0000,,Не? сол. таңқаларлық.
Dialogue: 0,0:20:49.11,0:20:51.12,Default,,0000,0000,0000,,Айтпақшы, осылай түсіріңіз →
Dialogue: 0,0:20:51.12,0:20:54.12,Default,,0000,0000,0000,,Митома
Dialogue: 0,0:20:51.12,0:20:54.12,Default,,0000,0000,0000,,Митома ойнатқышы
Dialogue: 0,0:20:51.12,0:20:54.12,Default,,0000,0000,0000,,Ол мұны матчта жасады...
Dialogue: 0,0:20:54.12,0:20:56.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:54.12,0:20:56.12,Default,,0000,0000,0000,,Тақырып бойынша….
Dialogue: 0,0:20:56.12,0:20:59.09,Default,,0000,0000,0000,,Егер сіз «Blue Rock» фанаты болсаңыз,
Dialogue: 0,0:20:56.12,0:20:59.09,Default,,0000,0000,0000,,Бұл қызу тақырып болды.
Dialogue: 0,0:21:02.13,0:21:04.10,Default,,0000,0000,0000,,Сонда иә.
Dialogue: 0,0:21:02.13,0:21:04.10,Default,,0000,0000,0000,,Митома мұны жасамас бұрын.
Dialogue: 0,0:21:05.10,0:21:07.13,Default,,0000,0000,0000,,Міне, келесі сұрақ.
Dialogue: 0,0:21:07.13,0:21:09.10,Default,,0000,0000,0000,,Бұл Киёши Сэйчи. иә.
Dialogue: 0,0:21:09.10,0:21:11.10,Default,,0000,0000,0000,,Артқа….
Dialogue: 0,0:21:09.10,0:21:11.10,Default,,0000,0000,0000,,Өкше?
Dialogue: 0,0:21:12.14,0:21:14.11,Default,,0000,0000,0000,,Уа! Артқы өкшесі?
Dialogue: 0,0:21:14.11,0:21:16.11,Default,,0000,0000,0000,,Соңғы… соңғы канжи….
Dialogue: 0,0:21:14.11,0:21:16.11,Default,,0000,0000,0000,,Түсіру?
Dialogue: 0,0:21:16.11,0:21:18.08,Default,,0000,0000,0000,,Түсіру?
Dialogue: 0,0:21:16.11,0:21:18.08,Default,,0000,0000,0000,,Ату!
Dialogue: 0,0:21:20.11,0:21:22.11,Default,,0000,0000,0000,,Мен шешемін.
Dialogue: 0,0:21:20.11,0:21:22.11,Default,,0000,0000,0000,,Жылдам.
Dialogue: 0,0:21:22.11,0:21:25.12,Default,,0000,0000,0000,,Міне! О!
Dialogue: 0,0:21:27.32,0:21:30.29,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:21:27.32,0:21:30.29,Default,,0000,0000,0000,,Аздап….
Dialogue: 0,0:21:31.09,0:21:33.09,Default,,0000,0000,0000,,Енді бұл дұрыс жауап.
Dialogue: 0,0:21:33.09,0:21:35.13,Default,,0000,0000,0000,,《Жүріңдер, шығарыңдар! 》
Dialogue: 0,0:21:35.13,0:21:39.10,Default,,0000,0000,0000,,《Мен осылай елестеткенмін
Dialogue: 0,0:21:35.13,0:21:39.10,Default,,0000,0000,0000,,Өрістің болашағы! 》
Dialogue: 0,0:21:39.10,0:21:41.10,Default,,0000,0000,0000,,《Міне, келді! Тегін! Шешуші машина! 》
Dialogue: 0,0:21:43.20,0:21:45.14,Default,,0000,0000,0000,,《Рин! ? 》
Dialogue: 0,0:21:45.14,0:21:47.24,Default,,0000,0000,0000,,《Йоба! Бұл өтірік! ? 》
Dialogue: 0,0:21:47.24,0:21:52.24,Default,,0000,0000,0000,,《Мен мүлде қашып кетсем де...
Dialogue: 0,0:21:47.24,0:21:52.24,Default,,0000,0000,0000,,Мен әрең жеттім.》
Dialogue: 0,0:21:52.24,0:21:55.11,Default,,0000,0000,0000,,《Атыс блогының қашықтығы...! 》
Dialogue: 0,0:21:55.11,0:21:57.25,Default,,0000,0000,0000,,《Жоқ...》
Dialogue: 0,0:21:57.25,0:22:01.25,Default,,0000,0000,0000,,《Бұл менмін
Dialogue: 0,0:21:57.25,0:22:01.25,Default,,0000,0000,0000,,Мен бұл жігітті жеңе алмаймын...! 》
Dialogue: 0,0:22:03.12,0:22:05.12,Default,,0000,0000,0000,,《…? 》
Dialogue: 0,0:22:05.12,0:22:07.09,Default,,0000,0000,0000,,《Сені алды, данышпан! 》
Dialogue: 0,0:22:09.09,0:22:12.10,Default,,0000,0000,0000,,《Осы сәт
Dialogue: 0,0:22:09.09,0:22:12.10,Default,,0000,0000,0000,,Мені оқып, қуып жет →
Dialogue: 0,0:22:12.10,0:22:16.10,Default,,0000,0000,0000,,Сенің арқаңда дүниеге келген
Dialogue: 0,0:22:12.10,0:22:16.10,Default,,0000,0000,0000,,Данышпанның арқасында соқыр нүкте! 》
Dialogue: 0,0:22:16.10,0:22:20.11,Default,,0000,0000,0000,,《Ал мұнда
Dialogue: 0,0:22:16.10,0:22:20.11,Default,,0000,0000,0000,,Менің соңғы әрекетім! 》
Dialogue: 0,0:22:20.11,0:22:22.11,Default,,0000,0000,0000,,《Тікелей кері соққы...→
Dialogue: 0,0:22:22.11,0:22:25.11,Default,,0000,0000,0000,,Артқы өкшелі соққы! ! 》
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,Қызық!
Dialogue: 0,0:22:28.11,0:22:30.12,Default,,0000,0000,0000,,Сіз өттіңіз дегіңіз келді ме?
Dialogue: 0,0:22:30.12,0:22:33.19,Default,,0000,0000,0000,,Иә. Мен оны бір рет басып оздым...
Dialogue: 0,0:22:30.12,0:22:33.19,Default,,0000,0000,0000,,Иә. Мен оны бір рет басып оздым...
Dialogue: 0,0:22:33.19,0:22:35.15,Default,,0000,0000,0000,,Енді, айтпақшы, бұл техника⤵️
Dialogue: 0,0:22:37.12,0:22:39.12,Default,,0000,0000,0000,,Менің дәл қазір мақсатым бар.
Dialogue: 0,0:22:39.12,0:22:41.09,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:22:39.12,0:22:41.09,Default,,0000,0000,0000,,Жайылым….
Dialogue: 0,0:22:43.13,0:22:45.13,Default,,0000,0000,0000,,Тек байқап көріңіз. сәл.
Dialogue: 0,0:22:43.13,0:22:45.13,Default,,0000,0000,0000,,О, жақсысың ба?
Dialogue: 0,0:22:45.13,0:22:47.10,Default,,0000,0000,0000,,〈Одан кейін...〉
Dialogue: 0,0:22:48.13,0:22:50.10,Default,,0000,0000,0000,,〈Манжу керемет ойнайды! 〉
Dialogue: 0,0:22:52.10,0:22:55.11,Default,,0000,0000,0000,,<Киёичидің супер ойыны
Dialogue: 0,0:22:52.10,0:22:55.11,Default,,0000,0000,0000,,Артқы өкшелі соққы →
Dialogue: 0,0:22:55.11,0:22:58.08,Default,,0000,0000,0000,,Ямазоэ мырза мен Манжу мырза
Dialogue: 0,0:22:55.11,0:22:58.08,Default,,0000,0000,0000,,Сынақ>
Dialogue: 0,0:22:58.08,0:23:00.11,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:22:58.08,0:23:00.11,Default,,0000,0000,0000,,
Dialogue: 0,0:23:00.11,0:23:02.08,Default,,0000,0000,0000,,Баяу қабылдаңыз!
Dialogue: 0,0:23:09.12,0:23:11.09,Default,,0000,0000,0000,,Не? Қазір не болды?
Dialogue: 0,0:23:11.09,0:23:13.09,Default,,0000,0000,0000,,Кешіріңіз. Мен тағы барамын.
Dialogue: 0,0:23:11.09,0:23:13.09,Default,,0000,0000,0000,,
Dialogue: 0,0:23:13.09,0:23:15.09,Default,,0000,0000,0000,,Аздап теріс өту
Dialogue: 0,0:23:13.09,0:23:15.09,Default,,0000,0000,0000,,Оны шығарып алған дұрыс.
Dialogue: 0,0:23:15.09,0:23:18.10,Default,,0000,0000,0000,,Бұл аздап теріс.
Dialogue: 0,0:23:15.09,0:23:18.10,Default,,0000,0000,0000,,Иә! иә!
Dialogue: 0,0:23:18.10,0:23:21.10,Default,,0000,0000,0000,,Басында мен тура жүгірдім...
Dialogue: 0,0:23:18.10,0:23:21.10,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:23:21.10,0:23:23.07,Default,,0000,0000,0000,,Бұлай жүр, былай жүр.
Dialogue: 0,0:23:21.10,0:23:23.07,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:23:31.11,0:23:33.08,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:23:34.08,0:23:38.12,Default,,0000,0000,0000,,(қызметкерлер күледі)
Dialogue: 0,0:23:34.08,0:23:38.12,Default,,0000,0000,0000,,Бұл қорқытуға айналады...
Dialogue: 0,0:23:38.12,0:23:41.09,Default,,0000,0000,0000,,Сондықтан мен шектен шығып кеттім
Dialogue: 0,0:23:38.12,0:23:41.09,Default,,0000,0000,0000,,Сонымен мен шектен шығып кеттім→
Dialogue: 0,0:23:41.09,0:23:43.12,Default,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:23:43.12,0:23:45.16,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:23:43.12,0:23:45.16,Default,,0000,0000,0000,,Ах~ Түсіндім!
Dialogue: 0,0:23:45.16,0:23:48.16,Default,,0000,0000,0000,,Қолмен домалатқандай баяу
Dialogue: 0,0:23:45.16,0:23:48.16,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:23:53.10,0:23:55.13,Default,,0000,0000,0000,,Иә. Кезек-кезек алайық.
Dialogue: 0,0:23:55.13,0:23:57.14,Default,,0000,0000,0000,,
Dialogue: 0,0:23:55.13,0:23:57.14,Default,,0000,0000,0000,,Диктор Сумита ренжіді.
Dialogue: 0,0:23:57.14,0:24:00.21,Default,,0000,0000,0000,,Бұл қызық. Ахаха….
Dialogue: 0,0:23:57.14,0:24:00.21,Default,,0000,0000,0000,,Өйткені «қолыңмен домалатады» деген сияқты.
Dialogue: 0,0:24:00.21,0:24:02.11,Default,,0000,0000,0000,,Міне, келді!
Dialogue: 0,0:24:02.11,0:24:04.08,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:24:02.11,0:24:04.08,Default,,0000,0000,0000,,Міне кеттік!
Dialogue: 0,0:24:04.08,0:24:07.11,Default,,0000,0000,0000,,Орындалды, орындалды!
Dialogue: 0,0:24:04.08,0:24:07.11,Default,,0000,0000,0000,,Каштан арманы!
Dialogue: 0,0:24:07.11,0:24:09.15,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:24:07.11,0:24:09.15,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:24:09.15,0:24:11.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:09.15,0:24:11.12,Default,,0000,0000,0000,,Найшу Найшу Найшу.
Dialogue: 0,0:24:12.08,0:24:15.29,Default,,0000,0000,0000,,〈“Көк жартастың” сүйкімділігі
Dialogue: 0,0:24:12.08,0:24:15.29,Default,,0000,0000,0000,,Тағы да бар〉
Dialogue: 0,0:24:15.29,0:24:18.29,Default,,0000,0000,0000,,〈Ендеше, келесіде⤵️
Dialogue: 0,0:24:20.29,0:24:22.29,Default,,0000,0000,0000,,«Көк жартастың» бір сүйкімділігі –⤵️
Dialogue: 0,0:24:25.26,0:24:28.17,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:24:25.26,0:24:28.17,Default,,0000,0000,0000,,Көк жартасқа кіргенде не айтылды→
Dialogue: 0,0:24:28.17,0:24:30.14,Default,,0000,0000,0000,,Жаттықтырушы⤵️
Dialogue: 0,0:24:32.10,0:24:34.11,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:24:32.10,0:24:34.11,Default,,0000,0000,0000,,Алдымен осы жерді басыңыз→
Dialogue: 0,0:24:34.11,0:24:36.07,Default,,0000,0000,0000,,Қандай сөз екенін қараңыз.
Dialogue: 0,0:24:34.11,0:24:36.07,Default,,0000,0000,0000,,Мен оны көргім келеді.
Dialogue: 0,0:24:36.07,0:24:39.08,Default,,0000,0000,0000,,Эго
Dialogue: 0,0:24:36.07,0:24:39.08,Default,,0000,0000,0000,,Мен сізден сұраймын.
Dialogue: 0,0:24:36.07,0:24:39.08,Default,,0000,0000,0000,,Футбол дегеніміз не?
Dialogue: 0,0:24:39.08,0:24:42.11,Default,,0000,0000,0000,,11 адам бірігіп, соғысады ма?
Dialogue: 0,0:24:42.11,0:24:47.09,Default,,0000,0000,0000,,Сіз облигацияларыңызды бағалайсыз ба? Арнайы?
Dialogue: 0,0:24:42.11,0:24:47.09,Default,,0000,0000,0000,,Достарыңыз үшін бе?
Dialogue: 0,0:24:47.09,0:24:52.09,Default,,0000,0000,0000,,Сондықтан бұл елде футбол
Dialogue: 0,0:24:47.09,0:24:52.09,Default,,0000,0000,0000,,Қанша уақыт өтсе де, сен әрқашан әлсіз боласың.
Dialogue: 0,0:24:53.09,0:24:56.13,Default,,0000,0000,0000,,Мен сізге айтамын.
Dialogue: 0,0:24:53.09,0:24:56.13,Default,,0000,0000,0000,,Футбол дегеніміз не?→
Dialogue: 0,0:24:56.13,0:25:00.10,Default,,0000,0000,0000,,Екінші тараптан
Dialogue: 0,0:24:56.13,0:25:00.10,Default,,0000,0000,0000,,Бұл көп ұпай алатын спорт түрі.
Dialogue: 0,0:25:01.10,0:25:04.10,Default,,0000,0000,0000,,Кім ұпай жинаса, сол үлкен.
Dialogue: 0,0:25:04.10,0:25:07.11,Default,,0000,0000,0000,,Егер сіз жақын достық қарым-қатынаста болғыңыз келсе
Dialogue: 0,0:25:04.10,0:25:07.11,Default,,0000,0000,0000,,Құлыптауды өшіру.
Dialogue: 0,0:25:07.11,0:25:10.08,Default,,0000,0000,0000,,Кира
Dialogue: 0,0:25:07.11,0:25:10.08,Default,,0000,0000,0000,,Бұл жағымсыз.
Dialogue: 0,0:25:07.11,0:25:10.08,Default,,0000,0000,0000,,Шығарыңыз.
Dialogue: 0,0:25:10.08,0:25:14.08,Default,,0000,0000,0000,,Жапон өкілі үшін
Dialogue: 0,0:25:10.08,0:25:14.08,Default,,0000,0000,0000,,Мен сыйлайтын ойыншылар көп.
Dialogue: 0,0:25:14.08,0:25:16.08,Default,,0000,0000,0000,,Олар менің жұлдыздарым!
Dialogue: 0,0:25:16.08,0:25:19.12,Default,,0000,0000,0000,,Сіз қателесесіз.
Dialogue: 0,0:25:19.12,0:25:23.09,Default,,0000,0000,0000,,Иә? Жапония өкілі? Хмм….
Dialogue: 0,0:25:24.09,0:25:28.09,Default,,0000,0000,0000,,Бұл әлем чемпионаттары.
Dialogue: 0,0:25:24.09,0:25:28.09,Default,,0000,0000,0000,,Сіз әлі ұтып алған жоқсыз ба?
Dialogue: 0,0:25:28.09,0:25:31.13,Default,,0000,0000,0000,,Мен әлемдегі ең жақсы болу туралы айттым.
Dialogue: 0,0:25:31.13,0:25:33.10,Default,,0000,0000,0000,,Ой, қандай жігіт.
Dialogue: 0,0:25:33.10,0:25:35.07,Default,,0000,0000,0000,,«Одақтасқа көмектесу
Dialogue: 0,0:25:33.10,0:25:35.07,Default,,0000,0000,0000,,1-0 ұтқаннан жақсы →
Dialogue: 0,0:25:35.07,0:25:37.10,Default,,0000,0000,0000,,Хет-трик жасадым →
Dialogue: 0,0:25:37.10,0:25:40.11,Default,,0000,0000,0000,,3-4 жеңілген жақсы
Dialogue: 0,0:25:37.10,0:25:40.11,Default,,0000,0000,0000,,Бұл жақсы сезінеді».
Dialogue: 0,0:25:41.27,0:25:45.08,Default,,0000,0000,0000,,Месси мен Криштиану Роналдуды жеңді
Dialogue: 0,0:25:41.27,0:25:45.08,Default,,0000,0000,0000,,«Алтын допты жеңіп алды» →
Dialogue: 0,0:25:45.08,0:25:49.08,Default,,0000,0000,0000,,Қазір әлемдегі ең үздік шабуылшы
Dialogue: 0,0:25:45.08,0:25:49.08,Default,,0000,0000,0000,,Бұл Ноэль Нойдың сөздері.
Dialogue: 0,0:25:50.08,0:25:52.12,Default,,0000,0000,0000,,Эрик Кантона дейді→
Dialogue: 0,0:25:52.12,0:25:56.22,Default,,0000,0000,0000,,«Мен командаға мән бермеймін.
Dialogue: 0,0:25:52.12,0:25:56.22,Default,,0000,0000,0000,,Мен ерекшеленуім керек».
Dialogue: 0,0:25:56.22,0:25:58.09,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Ең жаманы емес пе?
Dialogue: 0,0:25:58.09,0:26:01.16,Default,,0000,0000,0000,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:25:58.09,0:26:01.16,Default,,0000,0000,0000,,Бірақ бұл жігіттер бірінші орында!
Dialogue: 0,0:26:01.16,0:26:04.10,Default,,0000,0000,0000,,Олардың барлығы сирек кездесетін эгоист!
Dialogue: 0,0:26:04.10,0:26:08.10,Default,,0000,0000,0000,,Жапон футболында не жетіспейді?
Dialogue: 0,0:26:04.10,0:26:08.10,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:26:09.10,0:26:14.11,Default,,0000,0000,0000,,Егер сіз әлемдегі ең үлкен эгоист болмасаңыз
Dialogue: 0,0:26:09.10,0:26:14.11,Default,,0000,0000,0000,,Сіз әлемдегі ең үздік шабуылшы бола алмайсыз.
Dialogue: 0,0:26:14.11,0:26:20.11,Default,,0000,0000,0000,,Мақсатыңызды ең үлкен қуанышқа айналдырыңыз.
Dialogue: 0,0:26:14.11,0:26:20.11,Default,,0000,0000,0000,,Тек осы сәтпен өмір сүр!
Dialogue: 0,0:26:20.11,0:26:23.08,Default,,0000,0000,0000,,Бұл шабуылшы, солай ма?
Dialogue: 0,0:26:24.12,0:26:27.12,Default,,0000,0000,0000,,Уау! Керемет!
Dialogue: 0,0:26:24.12,0:26:27.12,Default,,0000,0000,0000,,Уау, бұл керемет.
Dialogue: 0,0:26:27.12,0:26:30.12,Default,,0000,0000,0000,,Бұл өте жақсы
Dialogue: 0,0:26:27.12,0:26:30.12,Default,,0000,0000,0000,,Бұл маңызды мәселе.
Dialogue: 0,0:26:30.12,0:26:34.09,Default,,0000,0000,0000,,Тек эгоист болыңыз
Dialogue: 0,0:26:30.12,0:26:34.09,Default,,0000,0000,0000,,Оқыту арқылы →
Dialogue: 0,0:26:34.09,0:26:37.10,Default,,0000,0000,0000,,Әрбір таңба
Dialogue: 0,0:26:34.09,0:26:37.10,Default,,0000,0000,0000,,Әңгімеде қолданылған Эго есім жолы→
Dialogue: 0,0:26:37.10,0:26:39.13,Default,,0000,0000,0000,,Бұл «Көгілдір жартастың» бір сүйкімділігі.
Dialogue: 0,0:26:39.13,0:26:43.13,Default,,0000,0000,0000,,Бұдан былай, Эгозерифу.
Dialogue: 0,0:26:39.13,0:26:43.13,Default,,0000,0000,0000,,Сұрақтар толтыру → форматында қойылады
Dialogue: 0,0:26:43.13,0:26:46.10,Default,,0000,0000,0000,,Сіз де эгоист болуға тырысыңыз.
Dialogue: 0,0:26:43.13,0:26:46.10,Default,,0000,0000,0000,,Жауап беріңізші.
Dialogue: 0,0:26:47.14,0:26:50.11,Default,,0000,0000,0000,,Ең алдымен
Dialogue: 0,0:26:47.14,0:26:50.11,Default,,0000,0000,0000,,Бұл Сейширо Нагидің Эго Зерифі.
Dialogue: 0,0:26:50.11,0:26:52.11,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:26:50.11,0:26:52.11,Default,,0000,0000,0000,,Наги келді.
Dialogue: 0,0:26:52.11,0:26:57.12,Default,,0000,0000,0000,,《Интуитивті түрде жасалған пьесалар
Dialogue: 0,0:26:52.11,0:26:57.12,Default,,0000,0000,0000,,Менде мағына бар》
Dialogue: 0,0:26:58.12,0:27:01.12,Default,,0000,0000,0000,,《Қайталанатын теңдеуге айналдыру》
Dialogue: 0,0:27:09.09,0:27:11.10,Default,,0000,0000,0000,,《Қарағым, ырғағым》
Dialogue: 0,0:27:17.34,0:27:19.30,Default,,0000,0000,0000,,Иә. Міне, солай.
Dialogue: 0,0:27:20.11,0:27:22.44,Default,,0000,0000,0000,,Сонымен, бұл кеңес...?
Dialogue: 0,0:27:22.44,0:27:24.11,Default,,0000,0000,0000,,Енді мен мұнда не айттым?
Dialogue: 0,0:27:22.44,0:27:24.11,Default,,0000,0000,0000,,«Мен»….
Dialogue: 0,0:27:24.11,0:27:26.08,Default,,0000,0000,0000,,«Өмірмен тыныс ал»… «Допқа өмір сал»….
Dialogue: 0,0:27:27.15,0:27:30.12,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:27:27.15,0:27:30.12,Default,,0000,0000,0000,,Мен шынымен болжай аламын ба?
Dialogue: 0,0:27:30.12,0:27:32.08,Default,,0000,0000,0000,,«Сіз допқа тыныс ала аласыз»….
Dialogue: 0,0:27:35.12,0:27:37.09,Default,,0000,0000,0000,,А, дерлік, дерлік...
Dialogue: 0,0:27:37.09,0:27:39.09,Default,,0000,0000,0000,,«Ол бәрін жаратушы Құдай».
Dialogue: 0,0:27:37.09,0:27:39.09,Default,,0000,0000,0000,,Жақын.
Dialogue: 0,0:27:39.09,0:27:41.06,Default,,0000,0000,0000,,Жабу. Ал...
Dialogue: 0,0:27:43.09,0:27:45.10,Default,,0000,0000,0000,,Құдай
Dialogue: 0,0:27:43.09,0:27:45.10,Default,,0000,0000,0000,,«Жаратушы».
Dialogue: 0,0:27:43.09,0:27:45.10,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:27:46.10,0:27:48.07,Default,,0000,0000,0000,,Әй, одан әрі кеңейтілсе екен.
Dialogue: 0,0:27:51.10,0:27:54.07,Default,,0000,0000,0000,,Өйткені бұл Пеле.
Dialogue: 0,0:27:51.10,0:27:54.07,Default,,0000,0000,0000,,Себебі бар.
Dialogue: 0,0:27:58.08,0:28:00.08,Default,,0000,0000,0000,,Аа, бұл дегеніміз осы.
Dialogue: 0,0:27:58.08,0:28:00.08,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:28:01.08,0:28:03.11,Default,,0000,0000,0000,,Әй, жақын!
Dialogue: 0,0:28:01.08,0:28:03.11,Default,,0000,0000,0000,,А, жақын қалды! Жақын.
Dialogue: 0,0:28:03.11,0:28:05.12,Default,,0000,0000,0000,,Қадам… Қадам….
Dialogue: 0,0:28:03.11,0:28:05.12,Default,,0000,0000,0000,,О, анау... Басқа...
Dialogue: 0,0:28:09.09,0:28:11.09,Default,,0000,0000,0000,,Бұл дұрыс жауап.
Dialogue: 0,0:28:18.10,0:28:20.10,Default,,0000,0000,0000,,《Қарағым, ырғағым》
Dialogue: 0,0:28:25.10,0:28:28.24,Default,,0000,0000,0000,,«Жаратушы»!
Dialogue: 0,0:28:25.10,0:28:28.24,Default,,0000,0000,0000,,«Ками-сама» сол кейіпкер.
Dialogue: 0,0:28:28.24,0:28:31.11,Default,,0000,0000,0000,,Оның үстіне, бұл «ұрыс алаңы».
Dialogue: 0,0:28:31.11,0:28:35.08,Default,,0000,0000,0000,,Бару
Dialogue: 0,0:28:31.11,0:28:35.08,Default,,0000,0000,0000,,Шоэй
Dialogue: 0,0:28:31.11,0:28:35.08,Default,,0000,0000,0000,,Келесі - Терухей Марудың эго атауының жолы.
Dialogue: 0,0:28:31.11,0:28:35.08,Default,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:28:35.08,0:28:37.08,Default,,0000,0000,0000,,…Тоқта!
Dialogue: 0,0:28:37.08,0:28:39.08,Default,,0000,0000,0000,,《Солға кел! 》
Dialogue: 0,0:28:39.08,0:28:42.09,Default,,0000,0000,0000,,《Өкшені көтеру! ? О, жоқ... Мені басып озды! 》
Dialogue: 0,0:28:42.09,0:28:44.09,Default,,0000,0000,0000,,Куон
Dialogue: 0,0:28:42.09,0:28:44.09,Default,,0000,0000,0000,,Кешіріңіз Куон! Мен сонда бардым!
Dialogue: 0,0:28:44.09,0:28:47.09,Default,,0000,0000,0000,,Жарайды! Маған қалдырыңыз!
Dialogue: 0,0:28:44.09,0:28:47.09,Default,,0000,0000,0000,,Жарайды! 2-ге 1!
Dialogue: 0,0:28:48.23,0:28:50.10,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:28:50.10,0:28:53.26,Default,,0000,0000,0000,,《Үздіксіз арқанды алу! ? Бұл не жігіт? 》
Dialogue: 0,0:28:53.26,0:28:55.23,Default,,0000,0000,0000,,《Декейши дәмді! 》
Dialogue: 0,0:28:57.10,0:28:59.10,Default,,0000,0000,0000,,《Қозғалуға болмайды...》
Dialogue: 0,0:28:59.10,0:29:02.07,Default,,0000,0000,0000,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:29:02.07,0:29:06.08,Default,,0000,0000,0000,,Тыңдау. Соны есіңде сақта, ақымақ.
Dialogue: 0,0:29:18.09,0:29:21.09,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:29:18.09,0:29:21.09,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:29:21.09,0:29:23.09,Default,,0000,0000,0000,,Иә, солай...
Dialogue: 0,0:29:21.09,0:29:23.09,Default,,0000,0000,0000,,Ал, сен не айттың?
Dialogue: 0,0:29:23.09,0:29:25.10,Default,,0000,0000,0000,,Қолыңды тез көтересің.
Dialogue: 0,0:29:23.09,0:29:25.10,Default,,0000,0000,0000,,Иә, Ватанабе мырза.
Dialogue: 0,0:29:25.10,0:29:27.10,Default,,0000,0000,0000,,«Біз дос емеспіз немесе ештеңе емеспіз».
Dialogue: 0,0:29:31.10,0:29:33.10,Default,,0000,0000,0000,,Ах! Міне бітті.
Dialogue: 0,0:29:33.10,0:29:36.07,Default,,0000,0000,0000,,Бұл туралы аздап
Dialogue: 0,0:29:33.10,0:29:36.07,Default,,0000,0000,0000,,Сіз нені айтасыз? Жоғарыдан қарағанда...
Dialogue: 0,0:29:36.07,0:29:38.08,Default,,0000,0000,0000,,Не? Жоғарыдан қарау?
Dialogue: 0,0:29:36.07,0:29:38.08,Default,,0000,0000,0000,,Жоғарыдан?
Dialogue: 0,0:29:38.08,0:29:40.11,Default,,0000,0000,0000,,Патша болғандықтан, патша.
Dialogue: 0,0:29:38.08,0:29:40.11,Default,,0000,0000,0000,,Ол патша.
Dialogue: 0,0:29:40.11,0:29:42.08,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:29:40.11,0:29:42.08,Default,,0000,0000,0000,,Кел, Ямазоэ.
Dialogue: 0,0:29:43.11,0:29:46.12,Default,,0000,0000,0000,,Ах! Жақын!
Dialogue: 0,0:29:46.12,0:29:48.09,Default,,0000,0000,0000,,Иә, Масуда.
Dialogue: 0,0:29:51.09,0:29:54.09,Default,,0000,0000,0000,,Ватанабе мырза.
Dialogue: 0,0:29:51.09,0:29:54.09,Default,,0000,0000,0000,,айтты. деді.
Dialogue: 0,0:30:01.10,0:30:03.07,Default,,0000,0000,0000,,Кешіріңіз. Мен мұны айттым ба?
Dialogue: 0,0:30:04.10,0:30:06.10,Default,,0000,0000,0000,,Құлдар жақын. Құлдар жақын жерде.
Dialogue: 0,0:30:04.10,0:30:06.10,Default,,0000,0000,0000,,Иә, Мацуо мырза.
Dialogue: 0,0:30:06.10,0:30:09.07,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:30:06.10,0:30:09.07,Default,,0000,0000,0000,,«доп» → «жігіт» құлын жаз
Dialogue: 0,0:30:09.07,0:30:11.08,Default,,0000,0000,0000,,Тамадо
Dialogue: 0,0:30:09.07,0:30:11.08,Default,,0000,0000,0000,,Ол допты жігіт.
Dialogue: 0,0:30:09.07,0:30:11.08,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:30:11.08,0:30:13.08,Default,,0000,0000,0000,,Допшы жігіт.
Dialogue: 0,0:30:15.11,0:30:17.08,Default,,0000,0000,0000,,Бұл не? Доп дегенді қалай түсінесіңдер?
Dialogue: 0,0:30:18.12,0:30:20.08,Default,,0000,0000,0000,,Ой….
Dialogue: 0,0:30:18.12,0:30:20.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:30:20.08,0:30:22.09,Default,,0000,0000,0000,,Шар? сфера?
Dialogue: 0,0:30:29.09,0:30:32.10,Default,,0000,0000,0000,,Сіз жақындайсыз.
Dialogue: 0,0:30:29.09,0:30:32.10,Default,,0000,0000,0000,,Екеуміз қайтадан құшақтадық.
Dialogue: 0,0:30:35.10,0:30:37.07,Default,,0000,0000,0000,,Эгоист бол!
Dialogue: 0,0:30:35.10,0:30:37.07,Default,,0000,0000,0000,,Ой, кешіріңіз...
Dialogue: 0,0:30:40.10,0:30:43.07,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:30:40.10,0:30:43.07,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:30:49.11,0:30:52.08,Default,,0000,0000,0000,,Ватанабе мырза, түсіндіңіз бе?
Dialogue: 0,0:30:49.11,0:30:52.08,Default,,0000,0000,0000,,Патша... Король айтады?
Dialogue: 0,0:30:54.09,0:30:56.09,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:30:54.09,0:30:56.09,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:30:57.09,0:30:59.09,Default,,0000,0000,0000,,Қоқыс лай тұшпара….
Dialogue: 0,0:30:59.09,0:31:02.06,Default,,0000,0000,0000,,Бұл шықпайды деп ойлаймын.
Dialogue: 0,0:30:59.09,0:31:02.06,Default,,0000,0000,0000,,Бұл дұрыс жауап.
Dialogue: 0,0:31:03.09,0:31:06.06,Default,,0000,0000,0000,,Тыңдау. Соны есіңде сақта, ақымақ.
Dialogue: 0,0:31:16.88,0:31:18.11,Default,,0000,0000,0000,,Аа~ түсіндім.
Dialogue: 0,0:31:16.88,0:31:18.11,Default,,0000,0000,0000,,Бұл шардың қызметшісі болды.
Dialogue: 0,0:31:18.11,0:31:21.18,Default,,0000,0000,0000,,Бірақ бұл ұят.
Dialogue: 0,0:31:18.11,0:31:21.18,Default,,0000,0000,0000,,Аздап болатын сияқты.
Dialogue: 0,0:31:21.18,0:31:24.08,Default,,0000,0000,0000,,Олай болса, бәріңе.
Dialogue: 0,0:31:21.18,0:31:24.08,Default,,0000,0000,0000,,Мен көп нәрсе жасадым→
Dialogue: 0,0:31:24.08,0:31:26.08,Default,,0000,0000,0000,,Қалай болды? `` Көк рок''.
Dialogue: 0,0:31:28.09,0:31:30.09,Default,,0000,0000,0000,,Сіз оны көргіңіз келеді, солай ма?
Dialogue: 0,0:31:36.23,0:31:38.23,Default,,0000,0000,0000,,Иә, мен осылай сезінемін...
Dialogue: 0,0:31:41.27,0:31:44.17,Default,,0000,0000,0000,,Бұл «Көк жартас» емес пе?
Dialogue: 0,0:31:41.27,0:31:44.17,Default,,0000,0000,0000,,Куриму Вада.
Dialogue: 0,0:31:44.17,0:31:46.14,Default,,0000,0000,0000,,Куриму⤵️
Dialogue: 0,0:31:47.11,0:31:49.14,Default,,0000,0000,0000,,Ал, Масуда, қалай болды?
Dialogue: 0,0:31:49.14,0:31:51.14,Default,,0000,0000,0000,,Қалай болғанда да⤵️
Dialogue: 0,0:31:52.08,0:31:54.08,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:31:57.08,0:31:59.08,Default,,0000,0000,0000,,(Барлығы күледі)
Dialogue: 0,0:32:00.08,0:32:02.09,Default,,0000,0000,0000,,〈Одан кейін→
Dialogue: 0,0:32:02.09,0:32:04.09,Default,,0000,0000,0000,,«Blue Rock» жанкүйерлері де
Dialogue: 0,0:32:02.09,0:32:04.09,Default,,0000,0000,0000,,Қатыспағандарға айтарым →
Dialogue: 0,0:32:04.09,0:32:06.06,Default,,0000,0000,0000,,Соңғы ақпарат шығарылды! 〉
Dialogue: 0,0:32:07.09,0:32:09.06,Default,,0000,0000,0000,,Уау Көргім келеді Көргім келеді!
Dialogue: 0,0:32:12.13,0:32:15.10,Default,,0000,0000,0000,,Хинатазака қырық алты
Dialogue: 0,0:32:12.13,0:32:15.10,Default,,0000,0000,0000,,<Келесі жолы Хинатазака46
Dialogue: 0,0:32:12.13,0:32:15.10,Default,,0000,0000,0000,,Топты өзгерту →
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,Көп рет
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,Greetings
Dialogue: 0,0:32:15.10,0:32:17.10,Default,,0000,0000,0000,,Киінетін бөлмеге барғанда сәлемдесу→
Dialogue: 0,0:32:17.10,0:32:19.07,Default,,0000,0000,0000,,Қарт байқайды ма?
Dialogue: 0,0:32:17.10,0:32:19.07,Default,,0000,0000,0000,,Тексеру! 〉
Dialogue: 0,0:32:21.11,0:32:23.17,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:32:21.11,0:32:23.17,Default,,0000,0000,0000,,Сәлеметсіз бе, бұл Ода. өтінемін.
Dialogue: 0,0:32:23.17,0:32:25.14,Default,,0000,0000,0000,,Қараңдар! Уау...
Dialogue: 0,0:32:23.17,0:32:25.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:32:28.21,0:32:30.18,Default,,0000,0000,0000,,Жоқ, бұл... бұл⤵️
Dialogue: 0,0:32:33.18,0:32:35.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:32:39.06,0:32:41.06,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:32:45.06,0:32:49.03,Default,,0000,0000,0000,,Бірақ олай емес...
Dialogue: 0,0:32:45.06,0:32:49.03,Default,,0000,0000,0000,,Бұл эго деп аталады...
Dialogue: 0,0:32:55.07,0:32:57.04,Default,,0000,0000,0000,,Манга әлі жалғасуда.
Dialogue: 0,0:32:55.07,0:32:57.04,Default,,0000,0000,0000,,Қараңыз...
Dialogue: 0,0:33:00.11,0:33:02.11,Default,,0000,0000,0000,,Енді... Кешіріңіз. Мен әлі емес⤵️
Dialogue: 0,0:33:03.08,0:33:06.05,Default,,0000,0000,0000,,Иә, `` Шима өсіру '' қазір.
Dialogue: 0,0:33:03.08,0:33:06.05,Default,,0000,0000,0000,,Бұл ұзақ.
Dialogue: 0,0:33:06.05,0:33:08.05,Default,,0000,0000,0000,,Иә, ``Аралдарды өсіру.''
Dialogue: 0,0:33:08.05,0:33:11.09,Default,,0000,0000,0000,,Ал, соңғы бір нәрсе.
Dialogue: 0,0:33:08.05,0:33:11.09,Default,,0000,0000,0000,,Бұл өтпейтін мүше →
Dialogue: 0,0:33:11.09,0:33:13.06,Default,,0000,0000,0000,,Алдағы фильмдердің трейлерлері
Dialogue: 0,0:33:11.09,0:33:13.06,Default,,0000,0000,0000,,Қарап көрейік.
Dialogue: 0,0:33:13.06,0:33:15.06,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:33:13.06,0:33:15.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:33:16.06,0:33:18.03,Default,,0000,0000,0000,,Кеттік, Наги!
Dialogue: 0,0:33:16.06,0:33:18.03,Default,,0000,0000,0000,,Иса Босс.
Dialogue: 0,0:33:21.07,0:33:23.07,Default,,0000,0000,0000,,Мен осы 300 адамның ішіндемін→
Dialogue: 0,0:33:23.07,0:33:26.07,Default,,0000,0000,0000,,Әлемдегі ең үздік шабуылшыны жасау үшін эксперимент жүргізіңіз.
Dialogue: 0,0:33:26.07,0:33:29.07,Default,,0000,0000,0000,,Мен сенің әлемдегі ең жақсы екеніңді дәлелдеймін.
Dialogue: 0,0:33:29.07,0:33:32.08,Default,,0000,0000,0000,,Киёшиичи Мен сені жеңе алатын адаммын!
Dialogue: 0,0:33:32.08,0:33:34.08,Default,,0000,0000,0000,,Менің ойымша, бұл дәл қазір қызық болуы мүмкін.
Dialogue: 0,0:33:34.08,0:33:36.08,Default,,0000,0000,0000,,Наги сен...
Dialogue: 0,0:33:36.08,0:33:39.05,Default,,0000,0000,0000,,Мен жасап көремін.
Dialogue: 0,0:33:41.09,0:33:45.06,Default,,0000,0000,0000,,Иә. Менің айтайын дегенім осы.
Dialogue: 0,0:33:41.09,0:33:45.06,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:33:45.06,0:33:47.06,Default,,0000,0000,0000,,«Көк рок фильмі
Dialogue: 0,0:33:45.06,0:33:47.06,Default,,0000,0000,0000,,-ЭПИСОД Наги-'' бұл →
Dialogue: 0,0:33:47.06,0:33:49.06,Default,,0000,0000,0000,,19 сәуірде шығарылды.
Dialogue: 0,0:33:49.06,0:33:51.10,Default,,0000,0000,0000,,Сонымен қатар, фильмнің шығуын атап өту үшін→
Dialogue: 0,0:33:51.10,0:33:55.07,Default,,0000,0000,0000,,Шай бар
Dialogue: 0,0:33:51.10,0:33:55.07,Default,,0000,0000,0000,,13 сәуірден бастап TVer арнасында
Dialogue: 0,0:33:51.10,0:33:55.07,Default,,0000,0000,0000,,«Blue Rock» теле аниме →
Dialogue: 0,0:33:55.07,0:33:57.04,Default,,0000,0000,0000,,Тек шектеулі уақытқа ғана қол жетімді.
Dialogue: 0,0:33:58.07,0:34:00.07,Default,,0000,0000,0000,,Уау Көргім келеді Көргім келеді!
Dialogue: 0,0:34:01.07,0:34:05.08,Default,,0000,0000,0000,,Әрбір эпизодтың таралу кестесі және т.б.
Dialogue: 0,0:34:01.07,0:34:05.08,Default,,0000,0000,0000,,Мәліметтерді TVer бөлімінен қараңыз.
Dialogue: 0,0:34:05.08,0:34:07.08,Default,,0000,0000,0000,,Теледидар болсаңыз, оны көре аласыз.
Dialogue: 0,0:34:05.08,0:34:07.08,Default,,0000,0000,0000,,Мен оны көргім келеді.
Dialogue: 0,0:34:07.08,0:34:09.18,Default,,0000,0000,0000,,Сонымен →
Dialogue: 0,0:34:09.18,0:34:13.08,Default,,0000,0000,0000,,Фильмнің шығарылымына арналған арнайы шығарылым!
Dialogue: 0,0:34:09.18,0:34:13.08,Default,,0000,0000,0000,,``Көгілдір жартас'' мен бұрын соңды болмаған шың болды.
Dialogue: 0,0:34:13.08,0:34:16.05,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:34:13.08,0:34:16.05,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:34:17.09,0:34:19.12,Default,,0000,0000,0000,,Терраса
Dialogue: 0,0:34:17.09,0:34:19.12,Default,,0000,0000,0000,,〈Осыдан кейін TELASA-да→
Dialogue: 0,0:34:19.12,0:34:21.06,Default,,0000,0000,0000,,Басқа да қиындықтар болды.
Dialogue: 0,0:34:19.12,0:34:21.06,Default,,0000,0000,0000,,Супер ойнату және т.б.→
Dialogue: 0,0:34:21.06,0:34:24.06,Default,,0000,0000,0000,,Шығарлмаған мазмұн қосылған толық нұсқасы! 〉
Dialogue: 0,0:34:25.56,0:34:31.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory