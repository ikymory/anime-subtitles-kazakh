Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.98,0:00:23.98,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:00:27.99,0:00:30.96,Default,,0,0,0,,《Жеңіске жетсек, бүкіл ел көлемінде болады! 》
Dialogue: 0,0:00:30.96,0:00:36.96,Default,,0,0,0,,Сен
Dialogue: 0,0:00:36.96,0:00:38.97,Default,,0,0,0,,Жүр! Тазалық!
Dialogue: 0,0:00:38.97,0:00:40.97,Default,,0,0,0,,Бұл ойын сіздің соңғы мүмкіндігіңіз! Өтінемін!
Dialogue: 0,0:00:40.97,0:00:45.00,Default,,0,0,0,,《Бүкіл елде… Елдің барлық жерінде… Елдің барлық жерінде! 》
Dialogue: 0,0:00:45.00,0:00:47.01,Default,,0,0,0,,《Міне! 》
Dialogue: 0,0:00:48.01,0:00:50.01,Default,,0,0,0,,《Атылуды шешіңіз... Атыңыз! 》
Dialogue: 0,0:00:51.04,0:00:53.98,Default,,0,0,0,,《Бүкіл ел бойынша! 》
Dialogue: 0,0:00:53.98,0:00:56.98,Default,,0,0,0,,Киёши! Бұл тегін!
Dialogue: 0,0:00:56.98,0:00:58.99,Default,,0,0,0,,《Аа, Тада-чан...》
Dialogue: 0,0:00:58.99,0:01:01.02,Default,,0,0,0,,《Өтсең 1 ұпай...》
Dialogue: 0,0:01:01.02,0:01:04.96,Default,,0,0,0,,Киёши! Барлығы үшін бір! Барлығы бір үшін!
Dialogue: 0,0:01:04.96,0:01:06.96,Default,,0,0,0,,《Иә! Футбол бұл...》
Dialogue: 0,0:01:07.96,0:01:10.96,Default,,0,0,0,,《Бұл 11 адам ойнайтын спорт түрі.》
Dialogue: 0,0:01:12.97,0:01:14.97,Default,,0,0,0,,《Я! Бұл галстук...》
Dialogue: 0,0:01:15.97,0:01:17.97,Default,,0,0,0,,《Өтірік!》
Dialogue: 0,0:01:17.97,0:01:21.01,Default,,0,0,0,,Есептегіш! (Оқушы) Тұр! Тұр!
Dialogue: 0,0:01:21.01,0:01:26.01,Default,,0,0,0,,Сен
Dialogue: 0,0:01:27.98,0:01:29.98,Default,,0,0,0,,《Жаман! 》
Dialogue: 0,0:01:29.98,0:01:31.98,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:35.99,0:01:37.99,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:37.99,0:01:40.99,Default,,0,0,0,,
Dialogue: 0,0:01:40.99,0:01:44.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:45.97,0:01:49.00,Default,,0,0,0,,Кешіріңіз, бәрі...
Dialogue: 0,0:01:49.00,0:01:51.97,Default,,0,0,0,,Егер мен шешсем...
Dialogue: 0,0:01:51.97,0:01:54.97,Default,,0,0,0,,Бұл Тада-чанның кінәсі емес
Dialogue: 0,0:01:57.01,0:01:58.98,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:58.98,0:02:00.98,Default,,0,0,0,,Йошиёши-кун! керемет!
Dialogue: 0,0:02:00.98,0:02:02.98,Default,,0,0,0,,Кира ойыншысы →
Dialogue: 0,0:02:02.98,0:02:04.98,Default,,0,0,0,,Жапон футболының қазынасы болып саналады.
Dialogue: 0,0:02:04.98,0:02:09.02,Default,,0,0,0,,Сондай-ақ оны U-18 құрамасына шақыру туралы шешім қабылданды→
Dialogue: 0,0:02:09.02,0:02:10.99,Default,,0,0,0,,Сіздің ұмтылыстарыңыз қандай? (Кира) Дұрыс.
Dialogue: 0,0:02:10.99,0:02:14.99,Default,,0,0,0,,Дәл қазір менің жалғыз мақсатым – осы командамен ел чемпионатында жеңіске жету.
Dialogue: 0,0:02:14.99,0:02:16.96,Default,,0,0,0,,Мен айта алатын жалғыз нәрсе - →
Dialogue: 0,0:02:16.96,0:02:18.97,Default,,0,0,0,,Мен қазір қандаймын →
Dialogue: 0,0:02:18.97,0:02:22.07,Default,,0,0,0,,Бұл тек осы командадағы барлық адамдар үшін.
Dialogue: 0,0:02:22.07,0:02:24.07,Default,,0,0,0,,Керемет!
Dialogue: 0,0:02:24.97,0:02:26.97,Default,,0,0,0,,жақсы күресті
Dialogue: 0,0:02:26.97,0:02:29.04,Default,,0,0,0,,Бұл менің 3 жылдық зейнеткерлігім.
Dialogue: 0,0:02:29.04,0:02:32.98,Default,,0,0,0,,Ұжым болып бірге күрескен күндерді мақтан етіңіз.
Dialogue: 0,0:02:32.98,0:02:36.98,Default,,0,0,0,,Бұл жоғалту бір күні сіздің өміріңіз болады...
Dialogue: 0,0:02:36.98,0:02:40.99,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:02:40.99,0:02:45.96,Default,,0,0,0,,Оның бәрі бекер емес екенін түсінетін кез міндетті түрде келеді!
Dialogue: 0,0:02:45.96,0:02:49.96,Default,,0,0,0,,Мен үшін бұл футбол клубы қиын→
Dialogue: 0,0:02:49.96,0:02:53.03,Default,,0,0,0,,Жапониядағы ең жақсы команда!
Dialogue: 0,0:02:53.03,0:03:00.04,Default,,0,0,0,,《Жоқ...бұл ұлттық деңгейге жете алмаған және префектуралық іріктеу турларында өткен команда》
Dialogue: 0,0:03:04.98,0:03:08.95,Default,,0,0,0,,《Мен бұл команданың екінші курсының белгісіз шабуылшысымын》
Dialogue: 0,0:03:08.95,0:03:11.95,Default,,0,0,0,,《Бұл шындық》
Dialogue: 0,0:03:11.95,0:03:14.95,Default,,0,0,0,,《Excuse me, Mr. Noah...》
Dialogue: 0,0:03:15.96,0:03:17.96,Default,,0,0,0,,《Сіз сияқты супержұлдыз болыңыз...》
Dialogue: 0,0:03:22.03,0:03:24.96,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:03:24.96,0:03:29.97,Default,,0,0,0,,"Direct volley! Super goal!"
Dialogue: 0,0:03:29.97,0:03:31.97,Default,,0,0,0,,《I don't think I can become one》
Dialogue: 0,0:03:31.97,0:03:35.04,Default,,0,0,0,,World-chan is amazing! (Бала) Тоқтамаңыз!
Dialogue: 0,0:03:35.04,0:03:36.98,Default,,0,0,0,,《I admire you...》
Dialogue: 0,0:03:36.98,0:03:39.95,Default,,0,0,0,,Керемет кадр! (Student) Not at a junior high school level!
Dialogue: 0,0:03:39.95,0:03:41.95,Default,,0,0,0,,《Мен әрқашан футбол ойнадым》
Dialogue: 0,0:03:41.95,0:03:43.95,Default,,0,0,0,,Әйтеуір, гала-концерт – өзіңді ерекше көрсетуге арналған.
Dialogue: 0,0:03:43.95,0:03:46.99,Default,,0,0,0,,Біріміз бәріміз үшін Бәріміз біріміз үшін
Dialogue: 0,0:03:46.99,0:03:48.96,Default,,0,0,0,,Let's all go all over the country! (Барлығы) О!
Dialogue: 0,0:03:48.96,0:03:53.06,Default,,0,0,0,,《Арман тек арманмен бітетін сияқты》
Dialogue: 0,0:03:53.06,0:03:56.96,Default,,0,0,0,,《Бір күні мен Жапония құрамасының шабуылшысы боламын→
Dialogue: 0,0:03:56.96,0:04:01.97,Default,,0,0,0,,Ал Әлем кубогын жеңу үшін →
Dialogue: 0,0:04:01.97,0:04:03.97,Default,,0,0,0,,My stupid dream...
Dialogue: 0,0:04:03.97,0:04:09.94,Default,,0,0,0,,Сен
Dialogue: 0,0:04:09.94,0:04:13.98,Default,,0,0,0,,《Егер сол көріністе болса→
Dialogue: 0,0:04:13.98,0:04:16.98,Default,,0,0,0,,Өту емес→
Dialogue: 0,0:04:16.98,0:04:19.99,Default,,0,0,0,,Мен түсіріп жатқанда...》
Dialogue: 0,0:04:21.99,0:04:24.99,Default,,0,0,0,,《Менің тағдырым басқа болды ма? 》
Dialogue: 0,0:04:24.99,0:04:29.00,Default,,0,0,0,,Hey, everyone, hurry up! Хахаха...
Dialogue: 0,0:04:30.00,0:04:36.00,Default,,0,0,0,,Біреу – бәрі үшін – бәрі – бір…
Dialogue: 0,0:04:36.97,0:04:40.97,Default,,0,0,0,,Футбол – 11 адам ойнайтын спорт түрі...
Dialogue: 0,0:04:40.97,0:04:43.98,Default,,0,0,0,,Only one person...
Dialogue: 0,0:04:43.98,0:04:48.98,Default,,0,0,0,,Aaaaaaaaaaaaaaaaaaa!
Dialogue: 0,0:04:51.98,0:04:56.99,Default,,0,0,0,,Боқ... Жеңгім келді...
Dialogue: 0,0:04:58.99,0:05:00.99,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:05:00.99,0:05:03.96,Default,,0,0,0,,Қайтадан қош келдіңіз. Қалай болды? сәйкестік
Dialogue: 0,0:05:03.96,0:05:07.00,Default,,0,0,0,,Мен жоғалттым, жеңілдім. Менің қарным ашты~
Dialogue: 0,0:05:07.00,0:05:10.00,Default,,0,0,0,,Кешіріңіз! Мен бүгін шошқа етінен котлет жасадым
Dialogue: 0,0:05:10.00,0:05:14.01,Default,,0,0,0,,Мұндай нәрсені әдетте бір күн бұрын жейді, солай ма?
Dialogue: 0,0:05:14.01,0:05:16.98,Default,,0,0,0,,Шынымен бе? Бұл дәмді! Жеңдер, жеңдер!
Dialogue: 0,0:05:16.98,0:05:18.98,Default,,0,0,0,,Айтпақшы, Сечанға →
Dialogue: 0,0:05:18.98,0:05:21.01,Default,,0,0,0,,Хат келді.
Dialogue: 0,0:05:21.01,0:05:22.98,Default,,0,0,0,,Japan Football Union
Dialogue: 0,0:05:22.98,0:05:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.02,0:05:29.06,Default,,0,0,0,,“Reinforced designated player”…?
Dialogue: 0,0:05:29.06,0:05:30.96,Default,,0,0,0,,Бұл қазір жақсы нәрсе, солай ма?
Dialogue: 0,0:05:30.96,0:05:33.99,Default,,0,0,0,,Мен шынымен түсінбеймін. Хахаха...!
Dialogue: 0,0:05:33.99,0:05:37.00,Default,,0,0,0,,《Неге мен!》
Dialogue: 0,0:05:43.00,0:05:45.07,Default,,0,0,0,,《Осы жерде сәйкес келе ме? 》
Dialogue: 0,0:05:45.07,0:05:47.97,Default,,0,0,0,,Иә? Қиын...
Dialogue: 0,0:05:47.97,0:05:49.98,Default,,0,0,0,,Kiyoshi-kun... right?
Dialogue: 0,0:05:49.98,0:05:51.98,Default,,0,0,0,,Сізді де шақырды ғой.
Dialogue: 0,0:05:51.98,0:05:56.02,Default,,0,0,0,,Сәлеметсіз бе. Түсінесіз бе? Мен туралы
Dialogue: 0,0:05:56.02,0:05:57.98,Default,,0,0,0,,Ах Кира...кун
Dialogue: 0,0:05:57.98,0:06:00.99,Default,,0,0,0,,Сондай-ақ... әрине. He's the one I lost to the other day.
Dialogue: 0,0:06:00.99,0:06:04.99,Default,,0,0,0,,Менің есімде көп нәрсе бар! сен туралы
Dialogue: 0,0:06:04.99,0:06:07.99,Default,,0,0,0,,Does he have a wide field of vision? Does he have a high soccer IQ?
Dialogue: 0,0:06:07.99,0:06:10.00,Default,,0,0,0,,If we were on the same team →
Dialogue: 0,0:06:10.00,0:06:11.96,Default,,0,0,0,,Ол маған өте жақсы пас беретін сияқты.
Dialogue: 0,0:06:11.96,0:06:14.10,Default,,0,0,0,,Ах, Азасу...
Dialogue: 0,0:06:14.10,0:06:17.97,Default,,0,0,0,,《Lies... Seriously!? Мені Риосуке Кира мақтады! 》
Dialogue: 0,0:06:17.97,0:06:20.07,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:06:20.07,0:06:22.01,Default,,0,0,0,,Айтайын дегенім, мен мұнда не істеп жатқанымды білмеймін.
Dialogue: 0,0:06:22.01,0:06:24.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:24.08,0:06:27.98,Default,,0,0,0,,Менің айтайын дегенім, құрметті сөздерді қолдануды доғарайық. Біз бір жастамыз.
Dialogue: 0,0:06:27.98,0:06:29.98,Default,,0,0,0,,Құрметпен Киёши-кун
Dialogue: 0,0:06:29.98,0:06:31.98,Default,,0,0,0,,…Усу!
Dialogue: 0,0:06:31.98,0:06:33.99,Default,,0,0,0,,《He's such a nice guy! 》
Dialogue: 0,0:06:34.95,0:06:36.96,Default,,0,0,0,,Мынадай көрінеді...
Dialogue: 0,0:06:37.99,0:06:45.03,Default,,0,0,0,,Сен
Dialogue: 0,0:06:45.03,0:06:47.03,Default,,0,0,0,,Уау... өте көп
Dialogue: 0,0:06:47.03,0:06:50.00,Default,,0,0,0,,Оны бұрын көргендер бар ма?
Dialogue: 0,0:06:50.00,0:06:52.00,Default,,0,0,0,,Окаваның іріңді жуғыштығы
Dialogue: 0,0:06:52.00,0:06:55.01,Default,,0,0,0,,Исикари, орта мектептегі ең ұзын оқушы
Dialogue: 0,0:06:55.01,0:06:58.01,Default,,0,0,0,,О, Аомори ойыншысы Месси Нишиока да осында.
Dialogue: 0,0:06:58.01,0:07:02.01,Default,,0,0,0,,《Мм? Мүмкін олардың бәрі шабуылшы шығар? 》
Dialogue: 0,0:07:04.05,0:07:06.99,Default,,0,0,0,,Е-а-а-а…
Dialogue: 0,0:07:06.99,0:07:10.02,Default,,0,0,0,,Құтты болсын, таланттың асыл тастары.
Dialogue: 0,0:07:10.02,0:07:14.23,Default,,0,0,0,,Сіз менің жеке пікірім мен теріс пікірім бойынша таңдалды→
Dialogue: 0,0:07:14.23,0:07:17.00,Default,,0,0,0,,18 жасқа толмаған 300 ереуілші
Dialogue: 0,0:07:17.00,0:07:20.00,Default,,0,0,0,,Ал мен Ешин Цзинпачимін
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Жапонияға әлем чемпионатын жеңіп алуға көмектесу→
Dialogue: 0,0:07:22.00,0:07:25.00,Default,,0,0,0,,Ол жалдамалы адам.
Dialogue: 0,0:07:25.00,0:07:27.07,Default,,0,0,0,,
Dialogue: 0,0:07:27.07,0:07:30.01,Default,,0,0,0,,《Не... жаңа ғана не алдың? 》
Dialogue: 0,0:07:30.01,0:07:32.98,Default,,0,0,0,,《Әлем кубогы...Жеңімпаз? 》
Dialogue: 0,0:07:32.98,0:07:36.05,Default,,0,0,0,,Бұл кім... сен білесің бе?
Dialogue: 0,0:07:36.05,0:07:38.02,Default,,0,0,0,,Жоқ, мүлде емес
Dialogue: 0,0:07:38.02,0:07:40.09,Default,,0,0,0,,Қарапайым болайық
Dialogue: 0,0:07:40.09,0:07:42.99,Default,,0,0,0,,Жапон футболы әлемнің үздік футболшысы болу үшін не қажет→
Dialogue: 0,0:07:42.99,0:07:45.02,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:07:45.02,0:07:47.99,Default,,0,0,0,,Революциялық ереуілшінің дүниеге келуі
Dialogue: 0,0:07:47.99,0:07:50.00,Default,,0,0,0,,Осы 300 адамның ішінде мен бармын→
Dialogue: 0,0:07:50.00,0:07:53.00,Default,,0,0,0,,Әлемдегі ең үздік шабуылшы экспериментін жасаңыз
Dialogue: 0,0:07:53.00,0:07:56.04,Default,,0,0,0,,Бұл →
Dialogue: 0,0:07:56.04,0:07:58.00,Default,,0,0,0,,Көк тас
Dialogue: 0,0:07:58.00,0:08:00.97,Default,,0,0,0,,Бүгіннен бастап осында бірге тұрасың→
Dialogue: 0,0:08:00.97,0:08:05.01,Default,,0,0,0,,Мен сіздерге мен ойлап тапқан арнайы жоғарғы жаттығуды орындауды сұраймын.
Dialogue: 0,0:08:05.01,0:08:07.01,Default,,0,0,0,,Мен үйге бара алмаймын →
Dialogue: 0,0:08:07.01,0:08:10.02,Default,,0,0,0,,Мен сіздің бұрынғы футбол өміріңізден алыстағаныңызды қалаймын.
Dialogue: 0,0:08:10.02,0:08:12.02,Default,,0,0,0,,Бірақ бекітіңіз
Dialogue: 0,0:08:12.02,0:08:15.02,Default,,0,0,0,,Мұндағы аман қалу→
Dialogue: 0,0:08:15.02,0:08:19.03,Default,,0,0,0,,299 адамды жойғаннан кейін қалған соңғы адам →
Dialogue: 0,0:08:19.03,0:08:21.99,Default,,0,0,0,,Әлемдегі ең үздік шабуылшы болыңыз
Dialogue: 0,0:08:21.99,0:08:24.00,Default,,0,0,0,,Мұның бәрі түсіндіру үшін. Құрметпен.
Dialogue: 0,0:08:25.00,0:08:28.00,Default,,0,0,0,,
Dialogue: 0,0:08:28.00,0:08:31.00,Default,,0,0,0,,《Ол не деді? 》
Dialogue: 0,0:08:31.00,0:08:32.97,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:08:32.97,0:08:36.04,Default,,0,0,0,,Мен қазіргі түсініктемемен келісе алмаймын.
Dialogue: 0,0:08:36.04,0:08:38.98,Default,,0,0,0,,Біздің әрқайсымыздың өзіміздің маңызды командаларымыз бар.
Dialogue: 0,0:08:38.98,0:08:41.98,Default,,0,0,0,,Кейбір спортшылар республикалық турнирлерге дайындалуда.
Dialogue: 0,0:08:41.98,0:08:44.02,Default,,0,0,0,,Мағынасы жоқ нәрсеге →
Dialogue: 0,0:08:44.02,0:08:46.99,Default,,0,0,0,,Мен өз командамды тастап, қосыла алмаймын!
Dialogue: 0,0:08:46.99,0:08:48.99,Default,,0,0,0,,Иә! Менде де бүкіл елде бар.
Dialogue: 0,0:08:48.99,0:08:51.99,Default,,0,0,0,,Мен кенеттен бірге тұрудың мағынасын түсінбеймін.
Dialogue: 0,0:08:51.99,0:08:54.99,Default,,0,0,0,,Сонда сен кімсің? (Оқушы) Маған лайықты адамды көрсет.
Dialogue: 0,0:08:54.99,0:08:58.00,Default,,0,0,0,,
Dialogue: 0,0:08:58.00,0:09:02.00,Default,,0,0,0,,Түсіндім... сендер қатты ауырып жатырсыңдар.
Dialogue: 0,0:09:03.00,0:09:07.01,Default,,0,0,0,,Құлыптауды өшіру. Үйіне қайтқысы келген адам үйіне бара алады.
Dialogue: 0,0:09:07.97,0:09:10.98,Default,,0,0,0,,Әлемдегі ең үздік шабуылшы болудан да артық →
Dialogue: 0,0:09:10.98,0:09:12.98,Default,,0,0,0,,Осындай дамымаған футбол еліндегі орта мектепте→
Dialogue: 0,0:09:12.98,0:09:16.02,Default,,0,0,0,,Ең жақсы болу маңыздырақ па? а?
Dialogue: 0,0:09:16.02,0:09:18.02,Default,,0,0,0,,Сіз сияқты адамдар →
Dialogue: 0,0:09:18.02,0:09:20.99,Default,,0,0,0,,Мен Жапонияның болашағын иығымда көтеріп жүрмін деп үмітсіз сезінемін.
Dialogue: 0,0:09:20.99,0:09:22.99,Default,,0,0,0,,《Не... иә? 》
Dialogue: 0,0:09:22.99,0:09:27.99,Default,,0,0,0,,Тыңдаңыз, жапон футболының ұйымдастырылуы жоғары деңгейде.
Dialogue: 0,0:09:27.99,0:09:32.00,Default,,0,0,0,,Басқаларға қамқорлық жасаудың ұлттық сипатының дарыны деп айтуға болады.
Dialogue: 0,0:09:32.00,0:09:35.00,Default,,0,0,0,,Бірақ қалғандарының бәрі екінші дәрежелі.
Dialogue: 0,0:09:35.00,0:09:37.97,Default,,0,0,0,,Мен сізден сұраймын: Футбол дегеніміз не?
Dialogue: 0,0:09:37.97,0:09:40.97,Default,,0,0,0,,11 адам бірге соғысады?
Dialogue: 0,0:09:40.97,0:09:45.98,Default,,0,0,0,,Сіз облигацияларыңызды бағалайсыз ба? Арнайы? Достарыңыз үшін?
Dialogue: 0,0:09:45.98,0:09:50.98,Default,,0,0,0,,Сондықтан бұл елде футбол әрқашан әлсіз болады.
Dialogue: 0,0:09:52.02,0:09:55.99,Default,,0,0,0,,Мен сізге айтамын. Футбол дегеніміз не?→
Dialogue: 0,0:09:55.99,0:09:58.99,Default,,0,0,0,,Бұл қарсыласыңыздан көп ұпай жинайтын спорт түрі.
Dialogue: 0,0:09:58.99,0:10:02.06,Default,,0,0,0,,Кім ұпай жинаса, сол үлкен.
Dialogue: 0,0:10:02.06,0:10:06.07,Default,,0,0,0,,Егер сіз жақын достық қарым-қатынаста болғыңыз келсе, Rock Off
Dialogue: 0,0:10:07.03,0:10:11.00,Default,,0,0,0,,《Ол не деген жігіт... пәле ғой! 》
Dialogue: 0,0:10:11.00,0:10:14.01,Default,,0,0,0,,Бұл қорлау. Шығарыңыз.
Dialogue: 0,0:10:14.01,0:10:18.01,Default,,0,0,0,,Жапония құрамасында мен сыйлайтын ойыншылар көп.
Dialogue: 0,0:10:18.01,0:10:23.02,Default,,0,0,0,,Біз олардың 11 топ болып күрескенін көріп өстік!
Dialogue: 0,0:10:23.02,0:10:24.98,Default,,0,0,0,,Олар менің жұлдыздарым!
Dialogue: 0,0:10:24.98,0:10:27.99,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:10:29.99,0:10:33.99,Default,,0,0,0,,Иә? Жапония өкілі? Хмм...
Dialogue: 0,0:10:34.99,0:10:39.07,Default,,0,0,0,,Олар әлі әлем кубогын жеңіп алған жоқ па?
Dialogue: 0,0:10:39.07,0:10:42.07,Default,,0,0,0,,Мен әлемдегі ең жақсы болу туралы айттым.
Dialogue: 0,0:10:43.07,0:10:46.07,Default,,0,0,0,,«Одақтасқа көмектесіп, 1-0 → жеңген дұрыс
Dialogue: 0,0:10:46.07,0:10:47.97,Default,,0,0,0,,Хет-трик жасадым →
Dialogue: 0,0:10:47.97,0:10:50.98,Default,,0,0,0,,3-4 жеңілген жақсырақ болады».
Dialogue: 0,0:10:52.08,0:10:56.15,Default,,0,0,0,,«Алтын допты» алу үшін Месси мен Криштиану Роналдуды жеңді →
Dialogue: 0,0:10:56.15,0:11:00.15,Default,,0,0,0,,Бұл қазіргі уақытта әлемдегі ең үздік шабуылшы Ноэль Ноаның сөздері.
Dialogue: 0,0:11:00.99,0:11:02.96,Default,,0,0,0,,Эрик Кантона дейді→
Dialogue: 0,0:11:02.96,0:11:06.99,Default,,0,0,0,,«Маған команда маңызды емес, мен ерекшеленуім керек».
Dialogue: 0,0:11:06.99,0:11:10.00,Default,,0,0,0,,Пеленің айтуынша, «Әлемдегі ең үздік шабуылшы→
Dialogue: 0,0:11:10.00,0:11:13.00,Default,,0,0,0,,Жартылай қорғаушы Қорғаушы Қақпашы→
Dialogue: 0,0:11:13.00,0:11:16.00,Default,,0,0,0,,Қайсысын сұрасаң да, мен деп айтамын.''
Dialogue: 0,0:11:18.00,0:11:19.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Ең жаманы емес пе?
Dialogue: 0,0:11:19.97,0:11:22.01,Default,,0,0,0,,Бірақ бұл жігіттер бірінші орында!
Dialogue: 0,0:11:22.01,0:11:26.01,Default,,0,0,0,,Олардың барлығы сирек кездесетін эгоист!
Dialogue: 0,0:11:26.01,0:11:30.02,Default,,0,0,0,,Жапон футболына жетіспейтін нәрсе...
Dialogue: 0,0:11:30.02,0:11:32.99,Default,,0,0,0,,Егер сіз әлемдегі ең үлкен эгоист болмасаңыз→
Dialogue: 0,0:11:32.99,0:11:35.99,Default,,0,0,0,,Сіз әлемнің үздік шабуылшысы бола алмайсыз
Dialogue: 0,0:11:37.99,0:11:39.99,Default,,0,0,0,,《Бұл жігіт не айтып жатыр...》
Dialogue: 0,0:11:39.99,0:11:44.00,Default,,0,0,0,,Мен осы елде сондай адамды жасағым келеді.
Dialogue: 0,0:11:44.00,0:11:47.00,Default,,0,0,0,,《Мен бұл дұрыс емес екеніне сенімдімін》
Dialogue: 0,0:11:48.00,0:11:51.97,Default,,0,0,0,,Осы 299 адамның үстінде тұрған →
Dialogue: 0,0:11:51.97,0:11:54.97,Default,,0,0,0,,Бір ғана батыр...
Dialogue: 0,0:11:54.97,0:11:57.01,Default,,0,0,0,,(Жұтыну дыбысы)
Dialogue: 0,0:11:57.01,0:11:59.98,Default,,0,0,0,,《Мүмкін емес... өйткені менің тәжірибем жоқ.》
Dialogue: 0,0:11:59.98,0:12:03.98,Default,,0,0,0,,Елестетіңіз. Кезең – әлем чемпионатының финалы.
Dialogue: 0,0:12:03.98,0:12:06.02,Default,,0,0,0,,80 000 адамнан тұратын үлкен аудитория
Dialogue: 0,0:12:06.02,0:12:07.99,Default,,0,0,0,,Сіз сол алаңдасыз
Dialogue: 0,0:12:07.99,0:12:10.99,Default,,0,0,0,,Ұпай 0-0. Екінші таймның қосымша уақыты
Dialogue: 0,0:12:10.99,0:12:14.99,Default,,0,0,0,,Соңғы ойын: Сізді әріптесіңіздің пасы ұстап алды →
Dialogue: 0,0:12:14.99,0:12:16.96,Default,,0,0,0,,Қақпашымен жеке-жеке
Dialogue: 0,0:12:16.96,0:12:19.00,Default,,0,0,0,,Оң жақта 6 метр жерде бір одақтас бар.
Dialogue: 0,0:12:19.00,0:12:22.00,Default,,0,0,0,,Егер сіз өтсеңіз, міндетті түрде ұпай жинауға болатын жағдайлар
Dialogue: 0,0:12:22.00,0:12:26.01,Default,,0,0,0,,Барша азаматтардың үміті Жеңіске қауіп төнген осындай жағдайда...
Dialogue: 0,0:12:26.97,0:12:29.04,Default,,0,0,0,,Еш ойланбастан атыңыз
Dialogue: 0,0:12:29.04,0:12:32.04,Default,,0,0,0,,Тек осындай ессіз эгоистер ғана...
Dialogue: 0,0:12:33.98,0:12:35.98,Default,,0,0,0,,Алға
Dialogue: 0,0:12:38.99,0:12:42.99,Default,,0,0,0,,Ақыл-ойды тастаңыз. Алаңда сен жұлдызсың.
Dialogue: 0,0:12:45.99,0:12:49.06,Default,,0,0,0,,《Оны маған ешкім айтқан жоқ》
Dialogue: 0,0:12:49.06,0:12:55.07,Default,,0,0,0,,Мақсатыңызды ең үлкен қуанышқа айналдырыңыз және тек сол сәтте өмір сүріңіз!
Dialogue: 0,0:12:56.97,0:12:59.97,Default,,0,0,0,,Бұл шабуылшы, солай ма?
Dialogue: 0,0:13:03.98,0:13:06.98,Default,,0,0,0,,《Мен шабуылшымын! 》
Dialogue: 0,0:13:08.98,0:13:10.98,Default,,0,0,0,,Киёши-кун...
Dialogue: 0,0:13:10.98,0:13:13.99,Default,,0,0,0,,Мен барамын, қарғыс атсын! Мен де!
Dialogue: 0,0:13:13.99,0:13:23.96,Default,,0,0,0,,Сен
Dialogue: 0,0:13:23.96,0:13:25.97,Default,,0,0,0,,Хехе...
Dialogue: 0,0:13:27.00,0:13:29.00,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:13:31.04,0:13:35.01,Default,,0,0,0,,Футбол үшін әлемдегі ең ыстық жер
Dialogue: 0,0:13:35.01,0:13:38.01,Default,,0,0,0,,Бұл Көк жартас
Dialogue: 0,0:13:49.06,0:13:53.06,Default,,0,0,0,,《299Z, сондықтан… Z?》
Dialogue: 0,0:13:53.06,0:13:55.06,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:14:05.04,0:14:07.07,Default,,0,0,0,,Киёши-кун!
Dialogue: 0,0:14:07.07,0:14:10.08,Default,,0,0,0,,Жақсы, мен білетін адам бір бөлмеде.
Dialogue: 0,0:14:10.08,0:14:14.15,Default,,0,0,0,,Йошиёши-кун. Хаха... Мен де жеңілдеп қалдым.
Dialogue: 0,0:14:14.15,0:14:16.15,Default,,0,0,0,,Уау! (Ренсуке Кунигами) Ах, бұл жаман.
Dialogue: 0,0:14:17.05,0:14:19.05,Default,,0,0,0,,Киім ұшып кетті
Dialogue: 0,0:14:19.05,0:14:21.05,Default,,0,0,0,,А... бәрі жақсы.
Dialogue: 0,0:14:21.05,0:14:24.06,Default,,0,0,0,,Бұл…｡ Төменде абай болыңыз.
Dialogue: 0,0:14:24.06,0:14:26.09,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:14:26.09,0:14:31.06,Default,,0,0,0,,Эй, Зико, өт... Маған берші, Зико...
Dialogue: 0,0:14:31.06,0:14:34.07,Default,,0,0,0,,《Қандай түс көрдіңіз? 》
Dialogue: 0,0:14:36.04,0:14:39.07,Default,,0,0,0,,Сіз Риосуке Кирасыз ба?
Dialogue: 0,0:14:39.07,0:14:43.04,Default,,0,0,0,,Уау, бұл шын! (Кира) А... рахмет
Dialogue: 0,0:14:43.04,0:14:45.08,Default,,0,0,0,,Иә? Танысқаныма қуаныштымын
Dialogue: 0,0:14:45.08,0:14:48.08,Default,,0,0,0,,Менің атым Куриму Игараши.
Dialogue: 0,0:14:48.08,0:14:50.05,Default,,0,0,0,,А... сәлем
Dialogue: 0,0:14:50.05,0:14:54.12,Default,,0,0,0,,Мен храмдар отбасының ұлымын, бірақ мен оны мұрагер еткім келмейді.
Dialogue: 0,0:14:54.12,0:14:57.06,Default,,0,0,0,,Сондықтан мен ол туралы ертерек естігенде шошып кеттім!
Dialogue: 0,0:14:57.06,0:15:00.06,Default,,0,0,0,,Міне, сіздің өміріңізді өзгерту мүмкіндігі! Ол сияқты
Dialogue: 0,0:15:01.06,0:15:05.06,Default,,0,0,0,,"Өзгеріп бітірдіңіз бе? Талантты асыл тастар."
Dialogue: 0,0:15:06.07,0:15:08.07,Default,,0,0,0,,«Сәлеметсіз бе, сәлем».
Dialogue: 0,0:15:08.07,0:15:11.07,Default,,0,0,0,,«Қазір бір бөлмеде отырған мүшелер - бөлмелес→
Dialogue: 0,0:15:11.07,0:15:14.07,Default,,0,0,0,,Олар бір-бірін арттыратын бәсекелестер».
Dialogue: 0,0:15:14.07,0:15:16.08,Default,,0,0,0,,«Сіздің қабілеттеріңіз →
Dialogue: 0,0:15:16.08,0:15:19.08,Default,,0,0,0,,Ол менің жеке пікіріме және теріс пікіріме негізделіп, сандық түрде бағаланды және бағаланды».
Dialogue: 0,0:15:19.08,0:15:22.08,Default,,0,0,0,,«Бұл формадағы нөмір».
Dialogue: 0,0:15:22.08,0:15:26.05,Default,,0,0,0,,«Сіз бір қарағанда 300 адамның ішінен өз дәрежеңізді көре аласыз».
Dialogue: 0,0:15:26.05,0:15:30.06,Default,,0,0,0,,《299-орын... О, жоқ! Мен тым төменмін
Dialogue: 0,0:15:30.06,0:15:32.16,Default,,0,0,0,,«Рейтинг – →
Dialogue: 0,0:15:32.16,0:15:36.10,Default,,0,0,0,,Жаттығулар мен ойын нәтижелеріне байланысты көтерілу және құлдырау».
Dialogue: 0,0:15:36.10,0:15:39.07,Default,,0,0,0,,``Ал үздік 5 адам сөзсіз → болады
Dialogue: 0,0:15:39.07,0:15:44.07,Default,,0,0,0,,6 айдан кейін өтетін турнир: U-20 әлем чемпионаты→
Dialogue: 0,0:15:44.07,0:15:47.07,Default,,0,0,0,,Тіркелген шабуылшы».
Dialogue: 0,0:15:47.07,0:15:50.08,Default,,0,0,0,,《U-20 Жапония құрамасы!》
Dialogue: 0,0:15:50.08,0:15:52.14,Default,,0,0,0,,«Айтпақшы→
Dialogue: 0,0:15:52.14,0:15:55.15,Default,,0,0,0,,Көк жартаста жеңілген адам бұдан былай болады...»
Dialogue: 0,0:15:57.15,0:16:01.15,Default,,0,0,0,,«Сіз өмір бойы Жапония құрамасында болу құқығынан айырыласыз.»
Dialogue: 0,0:16:01.15,0:16:03.16,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:16:04.06,0:16:07.06,Default,,0,0,0,,«Мұнда жеңу үшін қажет нәрсе - бұл эго».
Dialogue: 0,0:16:07.06,0:16:10.06,Default,,0,0,0,,«Енді біз оны өлшеу үшін сынақ жүргіземіз.»
Dialogue: 0,0:16:10.06,0:16:14.03,Default,,0,0,0,,Енді киска ойнайтын кез келді.
Dialogue: 0,0:16:14.03,0:16:16.07,Default,,0,0,0,,«Уақыт – 136 секунд»
Dialogue: 0,0:16:16.07,0:16:18.04,Default,,0,0,0,,«Допқа тиген адам адам болады→
Dialogue: 0,0:16:18.04,0:16:21.04,Default,,0,0,0,,Уақыт біткен сәтте адам болған адам →
Dialogue: 0,0:16:21.04,0:16:24.08,Default,,0,0,0,,Мен рок-офф жігітпін.'' А... иә?
Dialogue: 0,0:16:24.08,0:16:26.08,Default,,0,0,0,,«Сонымен қатар, қолдар рұқсат етілмейді».
Dialogue: 0,0:16:28.15,0:16:30.15,Default,,0,0,0,,А...
Dialogue: 0,0:16:31.05,0:16:33.15,Default,,0,0,0,,Бұл футбол емес.
Dialogue: 0,0:16:33.15,0:16:36.16,Default,,0,0,0,,Мен ең төменгі, бірінші жігіт пе...
Dialogue: 0,0:16:37.12,0:16:40.06,Default,,0,0,0,,Жасай бер! Кек сақтамаңыз
Dialogue: 0,0:16:40.06,0:16:42.06,Default,,0,0,0,,Эй... күте тұр!
Dialogue: 0,0:16:42.06,0:16:44.13,Default,,0,0,0,,Оның айтқанына сенесің бе?
Dialogue: 0,0:16:44.13,0:16:46.07,Default,,0,0,0,,Егер бұл маңызды болса, сіз не істер едіңіз?
Dialogue: 0,0:16:46.07,0:16:48.10,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:16:48.10,0:16:51.10,Default,,0,0,0,,Мен мұны істеймін. Егер мен жеңілсем, өмірімнің соңына дейін ғибадатхананың діни қызметкері боламын...
Dialogue: 0,0:16:53.14,0:16:57.14,Default,,0,0,0,,《Осында жеңілгендер ешқашан Жапонияны көрсете алмайды》
Dialogue: 0,0:16:59.08,0:17:01.08,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:02.05,0:17:04.05,Default,,0,0,0,,Эй... мұнда келме!
Dialogue: 0,0:17:04.05,0:17:06.05,Default,,0,0,0,,Өкінішті, Киёши-кун! иә?
Dialogue: 0,0:17:06.05,0:17:08.19,Default,,0,0,0,,Намузо! Апыр-ай!
Dialogue: 0,0:17:08.19,0:17:10.06,Default,,0,0,0,,А-а... шіркін!
Dialogue: 0,0:17:10.06,0:17:12.06,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:17:12.06,0:17:16.06,Default,,0,0,0,,Мен оны жоққа шығару үшін келдім.
Dialogue: 0,0:17:16.06,0:17:18.20,Default,,0,0,0,,Ой! (Райнчи) Ақымақ болма!
Dialogue: 0,0:17:18.20,0:17:21.07,Default,,0,0,0,,Бұл мүлдем дұрыс емес
Dialogue: 0,0:17:21.07,0:17:23.20,Default,,0,0,0,,Болашағымның жойылуына шыдай алмаймын...!
Dialogue: 0,0:17:23.20,0:17:25.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:25.04,0:17:27.04,Default,,0,0,0,,Жоқ! О, жоқ!
Dialogue: 0,0:17:29.14,0:17:31.04,Default,,0,0,0,,Хе... мына жігіт әлі ұйықтап жатыр.
Dialogue: 0,0:17:31.04,0:17:33.05,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:17:34.05,0:17:36.05,Default,,0,0,0,,Хегг...!
Dialogue: 0,0:17:39.05,0:17:42.05,Default,,0,0,0,,Сәлем! Бұзушылық! Бұзушылық!
Dialogue: 0,0:17:42.05,0:17:44.06,Default,,0,0,0,,Мынадай сіріңке болса, түзу қызыл болар еді...!
Dialogue: 0,0:17:44.06,0:17:47.06,Default,,0,0,0,,Тек қолға тиым салынады, солай ма?
Dialogue: 0,0:17:47.06,0:17:49.06,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:17:49.06,0:17:51.13,Default,,0,0,0,,《Не! Бұл жігіт》
Dialogue: 0,0:17:51.13,0:17:54.03,Default,,0,0,0,,Эй, мен лас әдістерді ұнатпаймын.
Dialogue: 0,0:17:54.03,0:17:56.07,Default,,0,0,0,,Әділ және алаңсыз күрес
Dialogue: 0,0:17:56.07,0:17:58.07,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:18:03.18,0:18:05.18,Default,,0,0,0,,Мүмкіндік бар! Намузо!
Dialogue: 0,0:18:06.08,0:18:08.18,Default,,0,0,0,,Няру...!
Dialogue: 0,0:18:08.18,0:18:10.05,Default,,0,0,0,,Igaguri Crush!
Dialogue: 0,0:18:10.05,0:18:12.05,Default,,0,0,0,,Сәлем! Эй...
Dialogue: 0,0:18:15.05,0:18:17.06,Default,,0,0,0,,Тоқта...!
Dialogue: 0,0:18:17.06,0:18:19.06,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:18:19.06,0:18:21.06,Default,,0,0,0,,Намузо. Киёши-кун!
Dialogue: 0,0:18:21.06,0:18:24.06,Default,,0,0,0,,Ах... менің жаманым. Бұл сен емессің.
Dialogue: 0,0:18:26.07,0:18:28.07,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:18:28.07,0:18:33.04,Default,,0,0,0,,《Жоқ... Болмасам, футбол өмірім бітеді! 》
Dialogue: 0,0:18:33.04,0:18:36.04,Default,,0,0,0,,《Бір минут қалды...》
Dialogue: 0,0:18:36.04,0:18:39.05,Default,,0,0,0,,《Осылай біткенін қаламаймын...! 》
Dialogue: 0,0:18:40.05,0:18:42.08,Default,,0,0,0,,Уау! (Ватару Куон) Қауіпсіз!
Dialogue: 0,0:18:42.08,0:18:44.05,Default,,0,0,0,,《Жоғары физикалық қабілет! 》
Dialogue: 0,0:18:44.05,0:18:47.09,Default,,0,0,0,,《Мұнымен, мен оны кездейсоқ тепсем де, соқпайды! 》
Dialogue: 0,0:18:47.09,0:18:50.12,Default,,0,0,0,,《Егер сіз менен рейтингі төмен біреуді көздесеңіз! 》
Dialogue: 0,0:18:50.12,0:18:54.06,Default,,0,0,0,,Сәлем! Бар күшіммен қашып кеттім!
Dialogue: 0,0:18:54.06,0:18:58.06,Default,,0,0,0,,《Рас, менің болашағым осылай шешілді!? 》
Dialogue: 0,0:18:58.06,0:19:01.07,Default,,0,0,0,,Сен
Dialogue: 0,0:19:01.07,0:19:03.07,Default,,0,0,0,,《Жоқ... О, жоқ! 》
Dialogue: 0,0:19:03.07,0:19:07.07,Default,,0,0,0,,《Мен қаламаймын... Мен жоғалтқым келмейді! Мен мұның біткенін қаламаймын! 》
Dialogue: 0,0:19:07.07,0:19:10.08,Default,,0,0,0,,《Бәрі жоқ... Жеңгім келеді! 》
Dialogue: 0,0:19:10.08,0:19:13.08,Default,,0,0,0,,《Мен әлі де футбол ойнауды жалғастырғым келеді! 》
Dialogue: 0,0:19:13.08,0:19:16.08,Default,,0,0,0,,《Армандарымның біткенін қаламаймын! 》
Dialogue: 0,0:19:17.08,0:19:19.09,Default,,0,0,0,,Хаха! Сәлем!
Dialogue: 0,0:19:19.09,0:19:21.09,Default,,0,0,0,,Түсіңіз! Эй! Бұл мүмкіндік!
Dialogue: 0,0:19:21.09,0:19:24.29,Default,,0,0,0,,Сәлеметсіз бе! Жіберу! (Игараши) Жүр, кел! Ана жерде!
Dialogue: 0,0:19:24.29,0:19:28.06,Default,,0,0,0,,Олай болса, әділетті түрде жасайық... Менің ойымша!
Dialogue: 0,0:19:28.06,0:19:30.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:30.06,0:19:32.06,Default,,0,0,0,,Ittetete…｡ Жолдан тез кет! сен!
Dialogue: 0,0:19:33.07,0:19:35.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:35.07,0:19:38.07,Default,,0,0,0,,О... О, жоқ. Эй... Уақыт.
Dialogue: 0,0:19:40.07,0:19:42.07,Default,,0,0,0,,Киёши-кун, тап! Қазір!
Dialogue: 0,0:19:45.14,0:19:49.18,Default,,0,0,0,,Әй... Әй, күте тұрыңыз. Келме... Келме!
Dialogue: 0,0:19:49.18,0:19:52.05,Default,,0,0,0,,Бұндай жерде... біткенін қаламаймын!
Dialogue: 0,0:19:52.05,0:19:56.06,Default,,0,0,0,,《Сіз жеңе аласыз... Сіз аман қала аласыз》
Dialogue: 0,0:19:56.06,0:19:59.06,Default,,0,0,0,,《Бірақ бұл жігіттің футбол мансабы аяқталды》
Dialogue: 0,0:20:01.06,0:20:06.03,Default,,0,0,0,,《Жоқ, мен керек... Бұл сондай жер》
Dialogue: 0,0:20:06.03,0:20:10.07,Default,,0,0,0,,《Жеңіс ұтылғандар бар дегенді білдіреді→
Dialogue: 0,0:20:10.07,0:20:13.04,Default,,0,0,0,,Бұл менің армандарымды орындай алатынымды білдіреді→
Dialogue: 0,0:20:13.04,0:20:16.04,Default,,0,0,0,,Бұл біреудің арманын аяқтау туралы.
Dialogue: 0,0:20:27.05,0:20:29.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:30.06,0:20:32.06,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:35.06,0:20:39.07,Default,,0,0,0,,Бұлай жалғаса берсе, мен бұрынғыдай боламын.
Dialogue: 0,0:20:39.07,0:20:42.03,Default,,0,0,0,,Мен сенің өміріңді өзгерту үшін келдім.
Dialogue: 0,0:20:42.03,0:20:45.04,Default,,0,0,0,,Мен әлемдегі ең жақсы болу үшін келдім.
Dialogue: 0,0:20:45.04,0:20:50.08,Default,,0,0,0,,《Өзімнен күшті біреуді жеңбесем, ештеңе өзгермейді! 》
Dialogue: 0,0:20:50.08,0:20:52.08,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:20:52.08,0:20:55.08,Default,,0,0,0,,Не? Бұл дұрыс! Егер сіз оны жойғыңыз келсе ...
Dialogue: 0,0:20:57.05,0:21:00.05,Default,,0,0,0,,Ең күштісі!
Dialogue: 0,0:21:03.06,0:21:05.06,Default,,0,0,0,,Мен бе!
Dialogue: 0,0:21:05.06,0:21:07.06,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:07.06,0:21:15.07,Default,,0,0,0,,Сен
Dialogue: 0,0:21:15.07,0:21:17.04,Default,,0,0,0,,〈Біреу айтты〉
Dialogue: 0,0:21:17.04,0:21:19.07,Default,,0,0,0,,<Футбол әлемінде→
Dialogue: 0,0:21:19.07,0:21:22.04,Default,,0,0,0,,Үздік қақпашылар мен қорғаушылар→
Dialogue: 0,0:21:22.04,0:21:25.04,Default,,0,0,0,,Жартылай қорғаушыларды дамытуға болады, бірақ→
Dialogue: 0,0:21:25.04,0:21:29.05,Default,,0,0,0,,Шабуылшы мұндай жалғыз адам емес.
Dialogue: 0,0:21:29.05,0:21:32.05,Default,,0,0,0,,〈Бірінші дәрежелі шабуылшы деп аталатын тіршілік иесі →
Dialogue: 0,0:21:32.05,0:21:37.06,Default,,0,0,0,,Ол кезде футбол үшін ең ыстық жерде...〉
Dialogue: 0,0:21:37.06,0:21:39.06,Default,,0,0,0,,Ең күштісі...
Dialogue: 0,0:21:39.06,0:21:41.06,Default,,0,0,0,,Бум!
Dialogue: 0,0:21:42.06,0:21:44.06,Default,,0,0,0,,Уф…!
Dialogue: 0,0:21:45.06,0:21:49.07,Default,,0,0,0,,(шузер)
Dialogue: 0,0:21:49.07,0:21:52.07,Default,,0,0,0,,<кенеттен пайда болу>
Dialogue: 0,0:21:59.08,0:22:09.08,Default,,0,0,0,,Сен
Dialogue: 0,0:22:10.58,0:22:16.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory