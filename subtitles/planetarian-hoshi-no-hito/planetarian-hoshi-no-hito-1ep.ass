Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.02,0:00:22.18,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,0:00:22.93,0:00:26.23,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,0:00:26.81,0:00:29.15,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,0:00:30.11,0:00:34.03,Default,,0,0,0,,Сізді жұлдызға толы аспан күтіп тұр.
Dialogue: 0,0:00:35.61,0:00:37.87,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,0:00:38.91,0:00:42.33,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,0:00:43.00,0:00:45.50,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,0:00:46.58,0:00:50.50,Default,,0,0,0,,Сізді жұлдызға толы аспан күтіп тұр.
Dialogue: 0,0:00:52.67,0:00:55.01,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,0:00:55.68,0:00:58.97,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,0:00:59.55,0:01:01.81,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,0:01:02.81,0:01:06.81,Default,,0,0,0,,Сізді жұлдызға толы аспан күтіп тұр.
Dialogue: 0,0:01:14.03,0:01:18.78,Default,,0,0,0,,Адамдардың ақымақ соғыстары әлемді қармен жауып жатыр.
Dialogue: 0,0:01:18.87,0:01:21.37,Default,,0,0,0,,Сөзсіз жойылуға әкеледі
Dialogue: 0,0:01:21.95,0:01:25.37,Default,,0,0,0,,Қазіргі кезде халық саны 100 000-ға да жетпейтін сияқты.
Dialogue: 0,0:01:26.46,0:01:30.00,Default,,0,0,0,,Статистика жүргізетін адамдар болмағанына көп уақыт болды.
Dialogue: 0,0:01:30.50,0:01:33.96,Default,,0,0,0,,Нақты ешкім білмейді
Dialogue: 0,0:01:39.34,0:01:41.39,Default,,0,0,0,,Бір қадам Басқа қадам
Dialogue: 0,0:01:42.14,0:01:46.27,Default,,0,0,0,,Денем қартаяды, мен қалағандай қозғала алмаймын.
Dialogue: 0,0:01:47.06,0:01:50.40,Default,,0,0,0,,Сіз сүйреп бара жатқан шана жыл сайын ауырлай түседі.
Dialogue: 0,0:01:51.23,0:01:56.53,Default,,0,0,0,,Мені біреу алып кетуге келгенде маңызды емес сияқты сезінемін.
Dialogue: 0,0:01:58.45,0:02:02.37,Default,,0,0,0,,Бірақ... Әлі де біраз өкінішім бар.
Dialogue: 0,0:02:03.24,0:02:07.87,Default,,0,0,0,,Бұл өкініш менің ғана проблемам емес.
Dialogue: 0,0:02:08.62,0:02:09.87,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:16.34,0:02:19.97,Default,,0,0,0,,Біреуге айтыңыз...
Dialogue: 0,0:02:31.65,0:02:35.61,Default,,0,0,0,,Алым! Yoboo! Екі!
Dialogue: 0,0:02:36.19,0:02:39.49,Default,,0,0,0,,Алым! Жұмыс! Екі!
Dialogue: 0,0:02:39.99,0:02:42.12,Default,,0,0,0,,Қайда кеттіңіз?
Dialogue: 0,0:02:42.28,0:02:44.53,Default,,0,0,0,,Мен көп уақыт бойы сыртта қалмауым керек сияқты.
Dialogue: 0,0:02:44.66,0:02:45.95,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:02:46.08,0:02:48.83,Default,,0,0,0,,Ол жаста не айтсаң да тыңдамайды.
Dialogue: 0,0:02:49.04,0:02:51.00,Default,,0,0,0,,Исайя Бұл мәселе.
Dialogue: 0,0:02:51.08,0:02:52.50,Default,,0,0,0,,Иә, бірақ келіңіз.
Dialogue: 0,0:02:52.96,0:02:55.13,Default,,0,0,0,,Әзірше жел диірмендерін аралап көрейік.
Dialogue: 0,0:02:55.25,0:02:56.92,Default,,0,0,0,,Сіз бір жерде жасырынып жүрсіз бе?
Dialogue: 0,0:02:57.55,0:02:58.55,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:58.92,0:03:01.01,Default,,0,0,0,,Маған тез арада тексеруді тапсыру керек.
Dialogue: 0,0:03:01.22,0:03:03.43,Default,,0,0,0,,Қайта қашан жарылғанын білмеймін.
Dialogue: 0,0:03:03.51,0:03:04.76,Default,,0,0,0,,Еремия~ Иә?
Dialogue: 0,0:03:05.35,0:03:07.18,Default,,0,0,0,,Біз солтүстіктің жел диірменіміз
Dialogue: 0,0:03:07.27,0:03:08.14,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:08.22,0:03:09.14,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.32,0:03:25.58,Default,,0,0,0,,Еремия мен оның достары жел диірменіне барды.
Dialogue: 0,0:03:25.74,0:03:27.41,Default,,0,0,0,,Олар білмеді деп үміттенемін.
Dialogue: 0,0:03:27.54,0:03:28.83,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:03:28.91,0:03:31.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Үшеуің бірге шештіңдер.
Dialogue: 0,0:03:32.83,0:03:35.17,Default,,0,0,0,,Ия, ә, Әйүп, абай бол.
Dialogue: 0,0:03:35.25,0:03:36.29,Default,,0,0,0,,Саңылаулар болуы мүмкін
Dialogue: 0,0:03:36.38,0:03:38.00,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:03:38.09,0:03:39.38,Default,,0,0,0,,Ааа аа
Dialogue: 0,0:03:39.63,0:03:41.97,Default,,0,0,0,,Мен айттым~
Dialogue: 0,0:03:44.34,0:03:45.18,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:45.26,0:03:48.06,Default,,0,0,0,,Фу~ Аа, бір секундқа тоқтаңыз.
Dialogue: 0,0:03:48.51,0:03:49.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:03:51.39,0:03:55.36,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:03:59.44,0:04:00.32,Default,,0,0,0,,​​О?
Dialogue: 0,0:04:00.61,0:04:03.36,Default,,0,0,0,,Өйткені, кешегі боран ғажап болды.
Dialogue: 0,0:04:03.53,0:04:04.36,Default,,0,0,0,,Ах
Dialogue: 0,0:04:04.45,0:04:07.99,Default,,0,0,0,,Солтүстік жел диірмені бүгінгі күнге дейін ең керемет бұзылған болуы мүмкін.
Dialogue: 0,0:04:08.20,0:04:10.58,Default,,0,0,0,,Жөндеуге көмектеспесеңіз, ұрысып қаласыз.
Dialogue: 0,0:04:10.87,0:04:12.58,Default,,0,0,0,,Иә, қазір тым кеш.
Dialogue: 0,0:04:12.66,0:04:15.00,Default,,0,0,0,,Сіз далаға шыққанда бар күшіңізбен ойнауды шештіңіз, солай ма?
Dialogue: 0,0:04:15.08,0:04:16.04,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:04:16.13,0:04:18.46,Default,,0,0,0,,Неліктен ол Еремиядан және басқалардан жасырды деп ойлайсыз?
Dialogue: 0,0:04:18.59,0:04:19.71,Default,,0,0,0,,Уау... уау~
Dialogue: 0,0:04:19.80,0:04:20.67,Default,,0,0,0,,Уау
Dialogue: 0,0:04:21.59,0:04:23.97,Default,,0,0,0,,Әй, мен тағы құладым.
Dialogue: 0,0:04:24.18,0:04:26.22,Default,,0,0,0,,Кенеттен екі рет құлады?
Dialogue: 0,0:04:26.34,0:04:27.18,Default,,0,0,0,,Ах
Dialogue: 0,0:04:30.14,0:04:32.93,Default,,0,0,0,,Жұмыс, кешіріңіз, сәл артқа шегініңіз.
Dialogue: 0,0:04:33.06,0:04:33.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.85,0:04:36.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:37.23,0:04:38.27,Default,,0,0,0,,Бұл ағаш.
Dialogue: 0,0:04:38.44,0:04:40.82,Default,,0,0,0,,Бұл бір нәрсенің бөлігі сияқты
Dialogue: 0,0:04:41.07,0:04:41.90,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:04:42.03,0:04:43.19,Default,,0,0,0,,Қазып алайық! Қазып алайық!
Dialogue: 0,0:04:48.87,0:04:51.83,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:04:52.62,0:04:54.79,Default,,0,0,0,,Эй, эй, бұл...
Dialogue: 0,0:04:55.12,0:04:55.96,Default,,0,0,0,,О
Dialogue: 0,0:04:56.42,0:04:57.71,Default,,0,0,0,,Бұл адам, солай ма?
Dialogue: 0,0:04:57.88,0:04:58.71,Default,,0,0,0,,Иә
Dialogue: 0,0:04:59.00,0:05:01.05,Default,,0,0,0,,Бұл жер неге көп?
Dialogue: 0,0:05:01.25,0:05:02.67,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:05:02.76,0:05:04.30,Default,,0,0,0,,Жұмыс, үлкенді шақыр.
Dialogue: 0,0:05:04.38,0:05:07.01,Default,,0,0,0,,Иә? Бірақ... Рұқсатсыз далаға шыққаным белгілі болады.
Dialogue: 0,0:05:07.09,0:05:08.93,Default,,0,0,0,,Бұлай айтатын уақыт емес.
Dialogue: 0,0:05:09.01,0:05:10.35,Default,,0,0,0,,Міне кеттік! Асықшы!
Dialogue: 0,0:05:10.51,0:05:12.14,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:05:14.60,0:05:17.19,Default,,0,0,0,,Әй, мына кісі тірі ме?
Dialogue: 0,0:05:17.52,0:05:18.44,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:18.98,0:05:21.36,Default,,0,0,0,,Аа, маска сәл қозғалады.
Dialogue: 0,0:05:21.52,0:05:22.40,Default,,0,0,0,,Мен тыныс аламын
Dialogue: 0,0:05:22.48,0:05:23.32,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:05:23.40,0:05:25.03,Default,,0,0,0,,Жақсы, бұл көмектесуі мүмкін.
Dialogue: 0,0:05:25.11,0:05:26.24,Default,,0,0,0,,Иә, ә...
Dialogue: 0,0:05:29.28,0:05:30.12,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:05:33.20,0:05:34.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:57.14,0:05:58.31,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:05:59.81,0:06:01.06,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:01.65,0:06:03.61,Default,,0,0,0,,Сіздің есіңіз анық па?
Dialogue: 0,0:06:05.03,0:06:08.15,Default,,0,0,0,,Сізді осы жерде өлі күйде таптыңыз.
Dialogue: 0,0:06:08.95,0:06:10.41,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:06:10.91,0:06:13.74,Default,,0,0,0,,Қарлы боран соғып, құладым.
Dialogue: 0,0:06:13.87,0:06:16.08,Default,,0,0,0,,Әй, қарағым, сен әлі оянбайсың.
Dialogue: 0,0:06:16.62,0:06:18.41,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:06:20.33,0:06:22.29,Default,,0,0,0,,Бұл маған шынымен көмектесті
Dialogue: 0,0:06:22.63,0:06:24.46,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:25.25,0:06:28.22,Default,,0,0,0,,Менің өмірімді сақтап қалдым
Dialogue: 0,0:06:29.34,0:06:30.43,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:06:31.43,0:06:34.14,Default,,0,0,0,,Бұл соғыстан кейінгі баспана.
Dialogue: 0,0:06:35.31,0:06:39.31,Default,,0,0,0,,Шөл далада шіркеу астында салынған қараусыз қалған баспана.
Dialogue: 0,0:06:39.60,0:06:42.98,Default,,0,0,0,,Бірнеше ондаған жылдар бойы ауыл ретінде пайдаланылған.
Dialogue: 0,0:06:43.44,0:06:47.44,Default,,0,0,0,,Қазір балалы болуы мүмкін адам бірнеше жыл бұрын қайтыс болды.
Dialogue: 0,0:06:48.11,0:06:52.45,Default,,0,0,0,,Бұл жай ғана жойылуды күтіп тұрған 20 адамнан аспайтын ауыл.
Dialogue: 0,0:06:54.16,0:06:56.04,Default,,0,0,0,,Өтінемін, бұл сізді жылытады.
Dialogue: 0,0:06:56.12,0:06:57.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:58.37,0:07:00.75,Default,,0,0,0,,Еремия Бұл жер жақсы.
Dialogue: 0,0:07:00.87,0:07:04.17,Default,,0,0,0,,Үшеуіңізге есін жиғаныңызды айтыңыз.
Dialogue: 0,0:07:04.34,0:07:06.50,Default,,0,0,0,,Иә, сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:07:06.92,0:07:10.84,Default,,0,0,0,,Жылы Бұл шынымен өмірге қайта оралғандай сезінеді
Dialogue: 0,0:07:11.30,0:07:14.43,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:07:14.76,0:07:17.47,Default,,0,0,0,,Неліктен мұндай қаңырап бос жерде?
Dialogue: 0,0:07:17.89,0:07:19.39,Default,,0,0,0,,Біз сізді қайда көрдік
Dialogue: 0,0:07:19.56,0:07:22.19,Default,,0,0,0,,Ол да саудагер емес сияқты.
Dialogue: 0,0:07:22.56,0:07:23.65,Default,,0,0,0,,Иә
Dialogue: 0,0:07:24.77,0:07:29.74,Default,,0,0,0,,Мен көптен бері бірдеңе іздеп жүрмін.
Dialogue: 0,0:07:30.36,0:07:35.12,Default,,0,0,0,,Мен оны осы маңдағы ауылда көрген адамды кездестірдім.
Dialogue: 0,0:07:35.95,0:07:37.16,Default,,0,0,0,,Тік тау —
Dialogue: 0,0:07:37.24,0:07:41.08,Default,,0,0,0,,Кәрі сүйектерге болашағым айқын жауап беретінімді білдім.
Dialogue: 0,0:07:42.33,0:07:43.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:43.79,0:07:46.79,Default,,0,0,0,,Іздегеніңізді таба алмасаңыз да—
Dialogue: 0,0:07:47.21,0:07:50.47,Default,,0,0,0,,Мен еш өкінгім келмеді.
Dialogue: 0,0:07:52.43,0:07:55.68,Default,,0,0,0,,О, намаз өте сирек.
Dialogue: 0,0:07:55.93,0:07:56.76,Default,,0,0,0,,О
Dialogue: 0,0:07:56.97,0:07:59.52,Default,,0,0,0,,Біз құдайдан сұрадық
Dialogue: 0,0:07:59.64,0:08:01.68,Default,,0,0,0,,Сол адамға көмектесіңізші.
Dialogue: 0,0:08:01.77,0:08:03.02,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:08:03.56,0:08:06.48,Default,,0,0,0,,Хмм, дұғалар орындалды ма?
Dialogue: 0,0:08:07.11,0:08:10.40,Default,,0,0,0,,Сіз тапқан адам оянды.
Dialogue: 0,0:08:10.57,0:08:11.40,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:11.49,0:08:12.78,Default,,0,0,0,,Шынымен бе? Еремия
Dialogue: 0,0:08:12.90,0:08:13.82,Default,,0,0,0,,Ахаха
Dialogue: 0,0:08:14.95,0:08:17.83,Default,,0,0,0,,Эльбланка елді мекені жойылды.
Dialogue: 0,0:08:18.20,0:08:19.91,Default,,0,0,0,,4 жыл болды.
Dialogue: 0,0:08:20.58,0:08:22.04,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:08:22.37,0:08:25.29,Default,,0,0,0,,Бұл аймақтағы көрнекті елді мекендер жойылды.
Dialogue: 0,0:08:25.58,0:08:28.63,Default,,0,0,0,,Трейдерлер де шамамен 10 жыл бойы пайда болған жоқ.
Dialogue: 0,0:08:29.30,0:08:31.51,Default,,0,0,0,,Басқа елді мекендердегі жағдайды білсеңіз—
Dialogue: 0,0:08:31.63,0:08:34.13,Default,,0,0,0,,Маған хабарлай аласыз ба?
Dialogue: 0,0:08:36.80,0:08:38.80,Default,,0,0,0,,Осы жердегі жер —
Dialogue: 0,0:08:39.10,0:08:42.14,Default,,0,0,0,,Радиоактивті ластану соншалықты маңызды емес, бірақ...
Dialogue: 0,0:08:42.27,0:08:45.19,Default,,0,0,0,,Генетикалық ауытқулардың әсері барлық жерде байқалады
Dialogue: 0,0:08:45.19,0:08:45.48,Default,,0,0,0,,Генетикалық ауытқулардың әсері барлық жерде байқалады
Dialogue: 0,0:08:45.19,0:08:45.48,Default,,0,0,0,,Эй, мені итерме.
Dialogue: 0,0:08:45.48,0:08:45.94,Default,,0,0,0,,Эй, мені итерме.
Dialogue: 0,0:08:45.94,0:08:46.48,Default,,0,0,0,,Эй, мені итерме.
Dialogue: 0,0:08:45.94,0:08:46.48,Default,,0,0,0,,Көріп отырғаныңыздай, бұл ерекшелік емес.
Dialogue: 0,0:08:46.48,0:08:46.56,Default,,0,0,0,,Көріп отырғаныңыздай, бұл ерекшелік емес.
Dialogue: 0,0:08:46.56,0:08:47.90,Default,,0,0,0,,Көріп отырғаныңыздай, бұл ерекшелік емес.
Dialogue: 0,0:08:46.56,0:08:47.90,Default,,0,0,0,,Ұстамды болыңыз
Dialogue: 0,0:08:47.90,0:08:49.15,Default,,0,0,0,,Көріп отырғаныңыздай, бұл ерекшелік емес.
Dialogue: 0,0:08:50.61,0:08:51.86,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:08:51.98,0:08:55.20,Default,,0,0,0,,Балалар біз үшін асыл қазынамыз.
Dialogue: 0,0:08:55.95,0:08:57.66,Default,,0,0,0,,Леви Әйүп Рут
Dialogue: 0,0:08:57.82,0:09:00.37,Default,,0,0,0,,Тыңдамай кіріңіз.
Dialogue: 0,0:09:00.45,0:09:01.99,Default,,0,0,0,,Қараңдар, мен білдім!
Dialogue: 0,0:09:02.08,0:09:03.62,Default,,0,0,0,,Өйткені Әйүп көп шу шығарады!
Dialogue: 0,0:09:03.79,0:09:05.54,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:09:08.46,0:09:11.46,Default,,0,0,0,,Балалар маған көмектескен сияқтысыңдар.
Dialogue: 0,0:09:11.84,0:09:13.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:13.97,0:09:15.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:15.76,0:09:18.22,Default,,0,0,0,,«Егер біреу қиналса, оған көмектес».
Dialogue: 0,0:09:18.64,0:09:20.51,Default,,0,0,0,,Себебі Эзра үнемі солай айтатын.
Dialogue: 0,0:09:20.81,0:09:22.27,Default,,0,0,0,,Әй, сен қайдансың?
Dialogue: 0,0:09:22.35,0:09:24.14,Default,,0,0,0,,Басқа ауылдар? Алыс?
Dialogue: 0,0:09:24.77,0:09:26.64,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:27.06,0:09:29.23,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:09:30.19,0:09:34.65,Default,,0,0,0,,Мен көптен бері саяхаттап жүрмін.
Dialogue: 0,0:09:35.40,0:09:38.86,Default,,0,0,0,,Сондықтан мен жер шарын араладым.
Dialogue: 0,0:09:39.12,0:09:40.37,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:09:40.70,0:09:41.53,Default,,0,0,0,,Иә
Dialogue: 0,0:09:41.83,0:09:43.70,Default,,0,0,0,,Бұл сізді қызықтырады ма?
Dialogue: 0,0:09:43.79,0:09:45.20,Default,,0,0,0,,Иә
Dialogue: 0,0:09:45.54,0:09:47.83,Default,,0,0,0,,Бұл бомба ма?
Dialogue: 0,0:09:48.29,0:09:50.92,Default,,0,0,0,,Жоқ, бұл қауіпті емес.
Dialogue: 0,0:09:51.79,0:09:55.46,Default,,0,0,0,,Бұл жұлдыздарды көрсететін машина.
Dialogue: 0,0:09:55.84,0:09:56.80,Default,,0,0,0,,Жұлдыз?
Dialogue: 0,0:09:57.09,0:09:58.01,Default,,0,0,0,,Жұлдыз?
Dialogue: 0,0:09:58.88,0:10:02.14,Default,,0,0,0,,Ал егер... сіз жұлдызды адамсыз ба?
Dialogue: 0,0:10:02.26,0:10:03.10,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:10:03.97,0:10:05.39,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.68,0:10:06.77,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:07.39,0:10:11.31,Default,,0,0,0,,Баяғыда қартайған кезімде сен туралы өсек естігенмін.
Dialogue: 0,0:10:11.77,0:10:14.57,Default,,0,0,0,,Мен сенімен бір күні кездескім келеді.
Dialogue: 0,0:10:15.61,0:10:19.11,Default,,0,0,0,,Осы жасымда арманым орындалады деп ойламаппын.
Dialogue: 0,0:10:19.28,0:10:20.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.20,0:10:22.24,Default,,0,0,0,,Эзра Жұлдызды адам кім?
Dialogue: 0,0:10:22.41,0:10:23.70,Default,,0,0,0,,Жұлдыз дегеніміз не?
Dialogue: 0,0:10:23.78,0:10:24.62,Default,,0,0,0,,О
Dialogue: 0,0:10:24.74,0:10:27.83,Default,,0,0,0,,Сіз жұлдыздар туралы естідіңіз бе?
Dialogue: 0,0:10:27.96,0:10:29.71,Default,,0,0,0,,Мен олай ойламаймын...
Dialogue: 0,0:10:30.08,0:10:32.63,Default,,0,0,0,,Хаха, таңқаларлық емес.
Dialogue: 0,0:10:33.71,0:10:37.84,Default,,0,0,0,,Бірақ мен жас кезімде ұқсас едім.
Dialogue: 0,0:10:38.84,0:10:41.72,Default,,0,0,0,,Міне, өмір сүруге тырысу - бұл ...
Dialogue: 0,0:10:41.80,0:10:45.01,Default,,0,0,0,,Мен ешқашан жұлдыздар туралы ойлаған емеспін.
Dialogue: 0,0:10:45.93,0:10:48.14,Default,,0,0,0,,Мен кішкентай балаларды көргендіктен бе?
Dialogue: 0,0:10:48.27,0:10:51.81,Default,,0,0,0,,Әлде мұнда келу мақсатынан ба?
Dialogue: 0,0:10:52.86,0:10:55.86,Default,,0,0,0,,Онымен кездескенім есіме түсті.
Dialogue: 0,0:10:56.73,0:10:58.61,Default,,0,0,0,,Мен оны қай жерде кездестірдім
Dialogue: 0,0:10:59.15,0:11:01.95,Default,,0,0,0,,Бұл мөрленген қала болды.
Dialogue: 0,0:11:14.17,0:11:15.96,Default,,0,0,0,,Қарғыс атқыр, олар табанды.
Dialogue: 0,0:11:17.67,0:11:20.34,Default,,0,0,0,,Қаланы сыртқы жаулардан қорғау үшін жаяу әскерге қарсы танктерге арналған.
Dialogue: 0,0:11:21.09,0:11:23.47,Default,,0,0,0,,Шірігеннен кейін де қорғалуын жалғастыратын қирандылар
Dialogue: 0,0:11:35.52,0:11:36.36,Default,,0,0,0,,Га
Dialogue: 0,0:11:39.24,0:11:40.07,Default,,0,0,0,,Боқ...
Dialogue: 0,0:11:44.62,0:11:45.87,Default,,0,0,0,,Бұл әскери нысан ма?
Dialogue: 0,0:12:01.76,0:12:02.59,Default,,0,0,0,,Я~
Dialogue: 0,0:12:08.35,0:12:09.81,Default,,0,0,0,,Мен іздедім
Dialogue: 0,0:12:10.60,0:12:12.89,Default,,0,0,0,,Жабық болып қалатын сақталған тағам
Dialogue: 0,0:12:13.77,0:12:17.69,Default,,0,0,0,,Дәрі-дәрмектер Дәл жабдық Қару және оқ-дәрілер
Dialogue: 0,0:12:19.90,0:12:21.40,Default,,0,0,0,,Қолдануға болатын кез келген нәрсе
Dialogue: 0,0:12:22.07,0:12:25.49,Default,,0,0,0,,Нашақор болу деген осы.
Dialogue: 0,0:12:26.16,0:12:26.99,Default,,0,0,0,,Ах
Dialogue: 0,0:12:34.12,0:12:34.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.42,0:12:37.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:42.72,0:12:43.55,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:52.48,0:12:54.73,Default,,0,0,0,,Электр энергиясы беріліп жатыр ма?
Dialogue: 0,0:12:56.10,0:12:57.94,Default,,0,0,0,,Бұл әскери нысан емес сияқты.
Dialogue: 0,0:13:13.25,0:13:14.62,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:13:15.08,0:13:18.88,Default,,0,0,0,,Сіз біздің 2,5 миллионыншы тұтынушымыз ғана
Dialogue: 0,0:13:19.67,0:13:20.59,Default,,0,0,0,,Уф
Dialogue: 0,0:13:21.67,0:13:22.51,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:13:25.17,0:13:26.01,Default,,0,0,0,,Уф
Dialogue: 0,0:13:27.43,0:13:28.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:30.68,0:13:33.60,Default,,0,0,0,,Неліктен мұндай жерде әйел бар?
Dialogue: 0,0:13:35.52,0:13:36.85,Default,,0,0,0,,Не істеп тұрсың?
Dialogue: 0,0:13:37.02,0:13:39.36,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:13:39.56,0:13:42.40,Default,,0,0,0,,Мен шынымен, шынымен кешірім сұраймын.
Dialogue: 0,0:13:42.78,0:13:44.28,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:13:44.44,0:13:45.61,Default,,0,0,0,,Егер сіз—
Dialogue: 0,0:13:45.69,0:13:50.82,Default,,0,0,0,,Шындығында, мен жай ғана 2 487 288-ші тұтынушымын.
Dialogue: 0,0:13:51.24,0:13:54.62,Default,,0,0,0,,Алайда бұл сан шын мәнінде дұрыс емес.
Dialogue: 0,0:13:55.29,0:13:59.38,Default,,0,0,0,,Жақында бізде кішкентай бала мен қыз болатын тұтынушы болды.
Dialogue: 0,0:14:00.13,0:14:02.88,Default,,0,0,0,,Өйткені менде кіру жарнасы жоқ.
Dialogue: 0,0:14:03.17,0:14:06.51,Default,,0,0,0,,Ерекше жағдай ретінде біз сізге мұражайға тегін кіруге рұқсат бердік.
Dialogue: 0,0:14:07.26,0:14:10.18,Default,,0,0,0,,Сонымен, шын мәнінде, тұтынушы әділ
Dialogue: 0,0:14:10.34,0:14:14.52,Default,,0,0,0,,Мен 2 487 290-шы тұтынушымын.
Dialogue: 0,0:14:14.85,0:14:17.39,Default,,0,0,0,,Қайталағаным үшін кешіріңіз
Dialogue: 0,0:14:23.32,0:14:24.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.23,0:14:26.11,Default,,0,0,0,,Сол тұтынушы (Кузумая)?
Dialogue: 0,0:14:26.65,0:14:27.61,Default,,0,0,0,,Егер сіз—
Dialogue: 0,0:14:27.70,0:14:31.32,Default,,0,0,0,,Сізге соңғы рет барғаныма тура 29 жыл 81 күн болды.
Dialogue: 0,0:14:32.20,0:14:33.03,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:14:33.12,0:14:37.29,Default,,0,0,0,,Ханабиши әмбебап дүкенінің басты дүкенінің төбесіндегі планетарийге
Dialogue: 0,0:14:37.50,0:14:38.54,Default,,0,0,0,,Бұл робот па?
Dialogue: 0,0:14:38.66,0:14:40.12,Default,,0,0,0,,Иә, бұл робот.
Dialogue: 0,0:14:40.58,0:14:43.84,Default,,0,0,0,,Менің атым Юмэми Хошино, мен мұражайымызда аудармашымын.
Dialogue: 0,0:14:50.84,0:14:52.01,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,0:14:52.22,0:14:53.26,Default,,0,0,0,,Гүл шоғы
Dialogue: 0,0:14:53.60,0:14:56.35,Default,,0,0,0,,Мұны сапарыңызды еске алу ретінде қабылдаңыз.
Dialogue: 0,0:14:59.35,0:15:00.64,Default,,0,0,0,,Гүл шоғы...
Dialogue: 0,0:15:01.06,0:15:02.86,Default,,0,0,0,,Кешіріңіз (Кузумия) А?
Dialogue: 0,0:15:03.06,0:15:04.27,Default,,0,0,0,,Шынымды айтсам,
Dialogue: 0,0:15:04.36,0:15:06.82,Default,,0,0,0,,Мен нағыз гүлдерді ала алмадым.
Dialogue: 0,0:15:07.07,0:15:11.28,Default,,0,0,0,,Біздің әмбебап дүкеннің бірінші қабатындағы гүл сататын дүкендегі телефон желісі соңғы кездері істен шықты.
Dialogue: 0,0:15:12.53,0:15:14.78,Default,,0,0,0,,Сондықтан мен оны өзім жасауға тырыстым.
Dialogue: 0,0:15:17.49,0:15:18.66,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,0:15:20.46,0:15:23.08,Default,,0,0,0,,Иә, сәл сынған.
Dialogue: 0,0:15:23.54,0:15:27.34,Default,,0,0,0,,Қазіргі уақытта өзін-өзі диагностикалау бағдарламасында белгісіз қате бар.
Dialogue: 0,0:15:27.88,0:15:31.80,Default,,0,0,0,,Резервтік батарея таусылған және оны ауыстыру қажет.
Dialogue: 0,0:15:32.34,0:15:36.47,Default,,0,0,0,,Омыртқалардың қуат блогы тозған, оны ауыстыру қажет.
Dialogue: 0,0:15:36.93,0:15:40.23,Default,,0,0,0,,Содан кейін тұлға аралық ақпарат базасына және сөйлесу тәртібіне өтіңіз.
Dialogue: 0,0:15:40.31,0:15:41.02,Default,,0,0,0,,Белгілі қате бар
Dialogue: 0,0:15:41.02,0:15:41.98,Default,,0,0,0,,Белгілі қате бар
Dialogue: 0,0:15:41.02,0:15:41.98,Default,,0,0,0,,Күрсін
Dialogue: 0,0:15:41.98,0:15:42.06,Default,,0,0,0,,Белгілі қате бар
Dialogue: 0,0:15:42.65,0:15:45.86,Default,,0,0,0,,Сондықтан біз артық әңгімелерді қайталай береміз...
Dialogue: 0,0:15:45.94,0:15:47.73,Default,,0,0,0,,Ұшаққа ғана тән техникалық сипаттамалар
Dialogue: 0,0:15:50.03,0:15:50.86,Default,,0,0,0,,Тәтті~
Dialogue: 0,0:15:51.11,0:15:52.32,Default,,0,0,0,,Сол тұтынушы
Dialogue: 0,0:15:52.40,0:15:53.74,Default,,0,0,0,,Уф, айналаңа абай бол.
Dialogue: 0,0:15:54.95,0:15:58.54,Default,,0,0,0,,Өзіңізді жақсы сезінбей жатқан шығарсыз?
Dialogue: 0,0:15:58.70,0:16:01.58,Default,,0,0,0,,Сізді біздің әмбебап дүкендегі медициналық кабинетке апарғанымды қалайсыз ба?
Dialogue: 0,0:16:01.87,0:16:02.92,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:16:03.71,0:16:04.71,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:16:04.92,0:16:07.09,Default,,0,0,0,,Мен тұтынушы емеспін және мен ауырмаймын.
Dialogue: 0,0:16:07.38,0:16:08.30,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:09.30,0:16:13.05,Default,,0,0,0,,Ал, проекция шамамен жеті минуттан кейін басталады, сондықтан...
Dialogue: 0,0:16:13.22,0:16:13.51,Default,,0,0,0,,Орыныңызға отырыңыз және күтіңіз.
Dialogue: 0,0:16:13.51,0:16:15.89,Default,,0,0,0,,Орыныңызға отырыңыз және күтіңіз.
Dialogue: 0,0:16:13.51,0:16:15.89,Default,,0,0,0,,Ол өте сөйлейтін жігіт.
Dialogue: 0,0:16:15.89,0:16:16.01,Default,,0,0,0,,Ол өте сөйлейтін жігіт.
Dialogue: 0,0:16:16.22,0:16:18.39,Default,,0,0,0,,Мен тұтынушы емеспін.
Dialogue: 0,0:16:18.89,0:16:19.93,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:16:20.06,0:16:23.39,Default,,0,0,0,,Бірақ проекцияға назар аударыңыз.
Dialogue: 0,0:16:23.48,0:16:24.31,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:16:24.40,0:16:26.90,Default,,0,0,0,,Айтпақшы, 45 минуттай ғана.
Dialogue: 0,0:16:26.98,0:16:28.07,Default,,0,0,0,,Жарайды, үндеме.
Dialogue: 0,0:16:28.15,0:16:30.61,Default,,0,0,0,,Сондай-ақ, кешіріңіз, бірақ темекі жобалануда...
Dialogue: 0,0:16:30.69,0:16:32.61,Default,,0,0,0,,Аузыңды жап! сөйлеме
Dialogue: 0,0:16:32.70,0:16:34.41,Default,,0,0,0,,Тыныш болыңыз.
Dialogue: 0,0:16:34.78,0:16:36.78,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:16:37.16,0:16:38.45,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:16:38.58,0:16:40.16,Default,,0,0,0,,Сол тұтынушы
Dialogue: 0,0:16:40.29,0:16:41.75,Default,,0,0,0,,Тыныш кетпес бұрын—
Dialogue: 0,0:16:41.83,0:16:44.37,Default,,0,0,0,,Менің де бір өтінішім бар...
Dialogue: 0,0:16:44.46,0:16:46.54,Default,,0,0,0,,Эй, сен 3 секунд қана үндемедің.
Dialogue: 0,0:16:48.13,0:16:50.59,Default,,0,0,0,,Қарсы болмасаң, әйтеуір (Кузумая)?
Dialogue: 0,0:16:53.13,0:16:56.39,Default,,0,0,0,,2,5 миллион келушілерді еске алуға арналған арнайы проекция -
Dialogue: 0,0:16:56.47,0:16:59.18,Default,,0,0,0,,Мен сенің бір қарағаныңды қалаймын. Сіз қалай ойлайсыз?
Dialogue: 0,0:16:59.72,0:17:00.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:01.43,0:17:02.68,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:17:02.98,0:17:04.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:04.64,0:17:07.31,Default,,0,0,0,,Енді проекцияға дайындалайық.
Dialogue: 0,0:17:07.40,0:17:09.56,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:17:11.57,0:17:12.44,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:17:12.57,0:17:13.40,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.82,0:17:15.61,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:17:16.20,0:17:17.78,Default,,0,0,0,,Маған не көрсетпексің?
Dialogue: 0,0:17:17.99,0:17:18.99,Default,,0,0,0,,Холокинема?
Dialogue: 0,0:17:19.62,0:17:20.58,Default,,0,0,0,,Бұл жұлдызды аспан
Dialogue: 0,0:17:21.87,0:17:22.83,Default,,0,0,0,,Жұлдызды аспан?
Dialogue: 0,0:17:23.20,0:17:24.83,Default,,0,0,0,,Иә, бұл жұлдызды аспан
Dialogue: 0,0:17:26.92,0:17:29.67,Default,,0,0,0,,Хмм, жұлдызды аспан... солай ма?
Dialogue: 0,0:17:40.80,0:17:42.22,Default,,0,0,0,,Екі қалды
Dialogue: 0,0:17:44.31,0:17:45.68,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:17:48.40,0:17:52.98,Default,,0,0,0,,Бүгін Ханабиши әмбебап дүкенінің төбесіндегі планетарий ғимаратында.
Dialogue: 0,0:17:53.07,0:17:55.15,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:17:55.94,0:18:00.49,Default,,0,0,0,,Менің атым Юмэми Хошино, мен осы мұражайда аудармашымын.
Dialogue: 0,0:18:01.24,0:18:05.54,Default,,0,0,0,,Жобалауды бастамас бұрын, біз сізге қысқаша ескерту бергіміз келеді.
Dialogue: 0,0:18:06.08,0:18:07.29,Default,,0,0,0,,Проекция кезіндегі жеке тіл —
Dialogue: 0,0:18:07.37,0:18:10.67,Default,,0,0,0,,Бұл әрекеттен аулақ болыңыз, себебі бұл басқа тұтынушыларға қолайсыздық тудыруы мүмкін.
Dialogue: 0,0:18:10.67,0:18:11.46,Default,,0,0,0,,Бұл әрекеттен аулақ болыңыз, себебі бұл басқа тұтынушыларға қолайсыздық тудыруы мүмкін.
Dialogue: 0,0:18:10.67,0:18:11.46,Default,,0,0,0,,Кептірсем жақсы болады ма деп ойлаймын.
Dialogue: 0,0:18:11.46,0:18:12.50,Default,,0,0,0,,Кептірсем жақсы болады ма деп ойлаймын.
Dialogue: 0,0:18:12.63,0:18:13.42,Default,,0,0,0,,Ұялы телефоныңыздағы немесе сағатыңыздағы кез келген дабылдарды алдын ала өшіріңіз.
Dialogue: 0,0:18:13.42,0:18:17.34,Default,,0,0,0,,Ұялы телефонды және дабыл сағатын алдын ала өшіріңіз.
Dialogue: 0,0:18:13.42,0:18:17.34,Default,,0,0,0,,Иә~ Иә~
Dialogue: 0,0:18:17.34,0:18:17.51,Default,,0,0,0,,Ұялы телефоныңыздағы немесе сағатыңыздағы дабылдарды алдын ала өшіріңіз.
Dialogue: 0,0:18:18.55,0:18:22.43,Default,,0,0,0,,Сондай-ақ проекция кезінде тамақ ішуге, ішуге және темекі шегуге тыйым салынады.
Dialogue: 0,0:18:22.55,0:18:25.02,Default,,0,0,0,,Олай істеуден аулақ болыңыз.
Dialogue: 0,0:18:25.64,0:18:29.19,Default,,0,0,0,,Соңында мен сендерді жұлдыздар әлеміне шақырғым келеді.
Dialogue: 0,0:18:29.27,0:18:31.44,Default,,0,0,0,,Маңызды серіктестермен таныстыру
Dialogue: 0,0:18:32.11,0:18:34.36,Default,,0,0,0,,Бізді қошеметпен қарсы алыңыздар.
Dialogue: 0,0:18:35.44,0:18:36.99,Default,,0,0,0,,Бұл Йена (Қоқыс дүкені) Ах!
Dialogue: 0,0:18:42.12,0:18:46.83,Default,,0,0,0,,Шын мәнінде~ Йена-сан~
Dialogue: 0,0:18:47.70,0:18:51.75,Default,,0,0,0,,Бұл үлкен машинаның аты.
Dialogue: 0,0:18:57.17,0:18:58.97,Default,,0,0,0,,Мм... тұтынушы?
Dialogue: 0,0:18:59.34,0:19:01.30,Default,,0,0,0,,Өйткені бұл күлетін жер.
Dialogue: 0,0:19:02.05,0:19:04.18,Default,,0,0,0,,Хмм, бұл күлкілі деп ойлайсың ба?
Dialogue: 0,0:19:05.89,0:19:07.68,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:19:08.23,0:19:09.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:09.85,0:19:11.98,Default,,0,0,0,,Сіз оны асыға күткеніңізге қуаныштымын.
Dialogue: 0,0:19:12.06,0:19:13.61,Default,,0,0,0,,Өте пайдалы
Dialogue: 0,0:19:14.19,0:19:15.82,Default,,0,0,0,,Оны кім асыға күтеді?
Dialogue: 0,0:19:16.19,0:19:21.95,Default,,0,0,0,,Олай болса, Йена-сан, мен бәріңе сәлем айтқым келеді.
Dialogue: 0,0:19:30.66,0:19:32.54,Default,,0,0,0,,Тағы да
Dialogue: 0,0:19:33.92,0:19:36.42,Default,,0,0,0,,Сіздерден сәлем~
Dialogue: 0,0:19:43.39,0:19:45.47,Default,,0,0,0,,Бұл сізге жұлдыздарды көрсетпей ме?
Dialogue: 0,0:19:45.55,0:19:46.39,Default,,0,0,0,,Не?!
Dialogue: 0,0:19:46.47,0:19:48.77,Default,,0,0,0,,Құрметті тұтынушы, кешірім сұраймыз.
Dialogue: 0,0:19:48.93,0:19:51.56,Default,,0,0,0,,Мен шынымен, шынымен кешірім сұраймын.
Dialogue: 0,0:19:51.94,0:19:52.77,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:53.81,0:19:55.98,Default,,0,0,0,,Мен бұлай айтуға ұяламын
Dialogue: 0,0:19:56.15,0:20:00.53,Default,,0,0,0,,Қазіргі уақытта проекторда күрделі ақау бар сияқты.
Dialogue: 0,0:20:01.11,0:20:04.57,Default,,0,0,0,,Директор мен барлық қызметкерлер сапарда болды.
Dialogue: 0,0:20:05.03,0:20:08.04,Default,,0,0,0,,Жағдайды өз бетімше түсіне алмаймын.
Dialogue: 0,0:20:13.04,0:20:15.96,Default,,0,0,0,,Жақсы, маған бәрібір.
Dialogue: 0,0:20:25.51,0:20:28.01,Default,,0,0,0,,Жабық қаланы зерттеу кезінде
Dialogue: 0,0:20:28.10,0:20:31.27,Default,,0,0,0,,Сіз ең қиын нәрсе не екенін білесіз бе?
Dialogue: 0,0:20:36.69,0:20:40.40,Default,,0,0,0,,Жабық қаладағы ең қиын нәрсе не?
Dialogue: 0,0:20:41.78,0:20:43.86,Default,,0,0,0,,Мен роботты кездестіргенде
Dialogue: 0,0:20:45.57,0:20:49.16,Default,,0,0,0,,Егер сізбен біреу сөйлессе де, оған шабуыл жасамаңыз.
Dialogue: 0,0:20:56.58,0:20:59.00,Default,,0,0,0,,Ах аа... а
Dialogue: 0,0:21:00.09,0:21:02.46,Default,,0,0,0,,Гүл шоғы... Бұл тіпті жақсы емес.
Dialogue: 0,0:21:04.22,0:21:07.26,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,0:21:07.64,0:21:09.97,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,0:21:11.06,0:21:14.89,Default,,0,0,0,,Сізді жұлдызға толы аспан күтіп тұр.
Dialogue: 0,0:21:15.56,0:21:17.90,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,0:21:19.27,0:21:22.69,Default,,0,0,0,,Сәлеметсіз бе, тұтынушы, көңіл-күйіңіз қалай?
Dialogue: 0,0:21:23.15,0:21:25.61,Default,,0,0,0,,Ештеңе емес, мен жай ғана ұйықтап жатыр едім.
Dialogue: 0,0:21:26.57,0:21:29.45,Default,,0,0,0,,Күннің батуына бір сағаттай уақыт қалды.
Dialogue: 0,0:21:31.83,0:21:34.58,Default,,0,0,0,,Сізге жұлдыздар ұнайды, солай ма?
Dialogue: 0,0:21:35.87,0:21:36.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:37.33,0:21:40.04,Default,,0,0,0,,Жұлдызша өрнекті кулон жасап жатыр.
Dialogue: 0,0:21:40.63,0:21:42.92,Default,,0,0,0,,Міне, Цигнус шоқжұлдызы.
Dialogue: 0,0:21:43.51,0:21:44.42,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:21:46.22,0:21:48.55,Default,,0,0,0,,Мен қазір кетемін. Сіз маған кедергі келтірдіңіз.
Dialogue: 0,0:21:48.93,0:21:49.97,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:21:50.14,0:21:53.22,Default,,0,0,0,,Келесі проекция шамамен 18 минуттан кейін.
Dialogue: 0,0:21:53.60,0:21:56.06,Default,,0,0,0,,Ол қозғалмады, солай ма? Ол машина
Dialogue: 0,0:21:57.81,0:22:01.40,Default,,0,0,0,,Сіз бұл машина арқылы Йенаны айтасыз ба?
Dialogue: 0,0:22:01.48,0:22:02.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:02.69,0:22:05.03,Default,,0,0,0,,Иә Қазіргі уақытта жұмыс істемейді
Dialogue: 0,0:22:05.36,0:22:07.86,Default,,0,0,0,,Бірақ егер сіз біраз күте алсаңыз -
Dialogue: 0,0:22:07.95,0:22:09.45,Default,,0,0,0,,Оны жөндеуге болады деп күтілуде.
Dialogue: 0,0:22:09.99,0:22:12.28,Default,,0,0,0,,Кешіріңіз, бірақ мен күткенді ұнатпаймын.
Dialogue: 0,0:22:12.58,0:22:14.95,Default,,0,0,0,,Жөндеу кезінде біздің әмбебап дүкенде—
Dialogue: 0,0:22:15.04,0:22:17.54,Default,,0,0,0,,Дүкенге бару туралы не айтасыз?
Dialogue: 0,0:22:17.71,0:22:20.54,Default,,0,0,0,,Біз сізге жеңілдік купондарын дайындай аламыз.
Dialogue: 0,0:22:23.25,0:22:25.05,Default,,0,0,0,,Оны кім жөндей алады?
Dialogue: 0,0:22:25.30,0:22:26.80,Default,,0,0,0,,Ешкім келмейді.
Dialogue: 0,0:22:27.17,0:22:29.01,Default,,0,0,0,,Гардарик империясы шапқыншылық бастады.
Dialogue: 0,0:22:29.09,0:22:31.60,Default,,0,0,0,,Мен қазір қызметкерлерді шақырып жатырмын.
Dialogue: 0,0:22:31.68,0:22:34.26,Default,,0,0,0,,Біз келгеннен кейін жөндеу жұмыстарын бастаймыз.
Dialogue: 0,0:22:34.35,0:22:35.18,Default,,0,0,0,,Күрсін
Dialogue: 0,0:22:35.64,0:22:37.48,Default,,0,0,0,,Сарказм жұмыс істей ме?
Dialogue: 0,0:22:37.56,0:22:39.35,Default,,0,0,0,,Мм... тұтынушы?
Dialogue: 0,0:22:39.69,0:22:43.15,Default,,0,0,0,,Сіздің денеңізде ақау бар ма?
Dialogue: 0,0:22:43.36,0:22:45.86,Default,,0,0,0,,Олай болса, біздің әмбебап дүкеннің емханасына барыңыз...
Dialogue: 0,0:22:45.94,0:22:47.07,Default,,0,0,0,,Жетеді
Dialogue: 0,0:22:48.24,0:22:51.28,Default,,0,0,0,,Кешіріңіз, бірақ мен «жеткілікті» деп айтуым керек пе?
Dialogue: 0,0:22:52.82,0:22:53.66,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:22:54.45,0:22:56.04,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:22:56.33,0:22:59.04,Default,,0,0,0,,Мен төмендемін. Түзете алатын кезде маған қоңырау шалыңыз.
Dialogue: 0,0:22:59.16,0:23:00.79,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:23:01.04,0:23:03.17,Default,,0,0,0,,Жай ғана шығудың өзі азап.
Dialogue: 0,0:23:03.25,0:23:05.63,Default,,0,0,0,,Сізге көп рахмет. Мен өте қуаныштымын.
Dialogue: 0,0:23:05.71,0:23:06.96,Default,,0,0,0,,Иә?Иә?
Dialogue: 0,0:23:07.76,0:23:09.17,Default,,0,0,0,,Шынымды айтсам,
Dialogue: 0,0:23:09.26,0:23:11.89,Default,,0,0,0,,Тұтынушы көңілсіз болып көрінді, сондықтан...
Dialogue: 0,0:23:11.97,0:23:15.43,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім деп уайымдадым.
Dialogue: 0,0:23:16.14,0:23:18.52,Default,,0,0,0,,Адамдарды жайсыз сезіну -
Dialogue: 0,0:23:18.60,0:23:20.94,Default,,0,0,0,,Адамдарды жайсыз сезінуден аулақ болыңыз
Dialogue: 0,0:23:21.02,0:23:25.15,Default,,0,0,0,,Сізге бар күш-жігерімізбен қызмет ету роботымыздың қуанышы.
Dialogue: 0,0:23:26.02,0:23:29.32,Default,,0,0,0,,Жөндеу аяқталғаннан кейін біз сізге ішкі хабар тарату жүйесі арқылы хабарлаймыз.
Dialogue: 0,0:23:34.57,0:23:37.74,Default,,0,0,0,,Тұтынушыларға арнайы проекция көрсетіледі, сондықтан...
Dialogue: 0,0:23:38.20,0:23:41.46,Default,,0,0,0,,Ғимаратқа қайта кірген кезде маған хабарлаңыз.
Dialogue: 0,0:23:41.83,0:23:42.71,Default,,0,0,0,,О
Dialogue: 0,0:23:43.00,0:23:46.63,Default,,0,0,0,,Арнайы проекцияны бірінші болып көресіз.
Dialogue: 0,0:23:47.30,0:23:51.97,Default,,0,0,0,,Бұл біздің жан-тәнімізбен жасағанымызды мақтан тұтатын өнер туындысы.
Dialogue: 0,0:23:52.09,0:23:54.89,Default,,0,0,0,,Мен де бар күшімді саламын.
Dialogue: 0,0:23:54.97,0:23:55.80,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:23:55.89,0:23:57.97,Default,,0,0,0,,Сонда сіздің гүл шоғыңыз—
Dialogue: 0,0:23:58.14,0:24:01.35,Default,,0,0,0,,Сіздің ақпаратыңызды мұқият сақтайтынымызға сенімді болыңыз.
Dialogue: 0,0:24:01.69,0:24:03.40,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:24:12.03,0:24:14.36,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:24:14.82,0:24:16.49,Default,,0,0,0,,Мен мұны шынымен түсінбеймін.
Dialogue: 0,0:24:17.24,0:24:18.58,Default,,0,0,0,,Мен айта аламын:
Dialogue: 0,0:24:18.66,0:24:22.54,Default,,0,0,0,,Күн батқаннан кейін қозғалу қауіпті.
Dialogue: 0,0:24:23.04,0:24:26.13,Default,,0,0,0,,Бұл өте қарапайым машина ...
Dialogue: 0,0:24:26.33,0:24:28.55,Default,,0,0,0,,Бұл көрінгеннен қиынырақ.
Dialogue: 0,0:24:29.88,0:24:32.47,Default,,0,0,0,,Тұтынушы Йенаның жөндеуі...
Dialogue: 0,0:24:32.55,0:24:35.26,Default,,0,0,0,,Ол қаншалықты тез аяқталады деп ойлайсыз?
Dialogue: 0,0:24:35.43,0:24:37.39,Default,,0,0,0,,Келіңіздер, менде ештеңе жоқ.
Dialogue: 0,0:24:37.76,0:24:41.60,Default,,0,0,0,,Сіз оны ертең сағат 11-де проекцияға уақытында жасай аласыз ба?
Dialogue: 0,0:24:41.73,0:24:43.23,Default,,0,0,0,,Мүмкін емес шығар.
Dialogue: 0,0:24:43.48,0:24:44.52,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:24:44.60,0:24:47.56,Default,,0,0,0,,Проекцияның жойылғанын хабарлаған дұрыс па?
Dialogue: 0,0:24:47.77,0:24:48.94,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:24:49.11,0:24:50.15,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:24:50.23,0:24:52.44,Default,,0,0,0,,Кәсіби басымдық ретінде тіркелу
Dialogue: 0,0:24:52.44,0:24:53.07,Default,,0,0,0,,Кәсіби басымдық ретінде тіркелу
Dialogue: 0,0:24:52.44,0:24:53.07,Default,,0,0,0,,Көп қиындық көрген боларсың.
Dialogue: 0,0:24:53.07,0:24:54.61,Default,,0,0,0,,Көп қиындық көрген боларсың.
Dialogue: 0,0:24:54.86,0:24:56.16,Default,,0,0,0,,Бұл шамның жіпшелері —
Dialogue: 0,0:24:56.24,0:24:58.49,Default,,0,0,0,,Ол сынған, бірақ менде бір жерде резерв бар...
Dialogue: 0,0:24:58.58,0:24:59.58,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:25:00.08,0:25:04.29,Default,,0,0,0,,Кешіріңіз, жақында түн ортасы болады.
Dialogue: 0,0:25:04.41,0:25:06.71,Default,,0,0,0,,Мен кәдімгі бизнес параметрлерін орындаймын—
Dialogue: 0,0:25:06.79,0:25:09.17,Default,,0,0,0,,Біз ұйқы режиміне кіреміз.
Dialogue: 0,0:25:09.42,0:25:10.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:10.92,0:25:13.13,Default,,0,0,0,,Ояну уақыты ертең таңғы 9.
Dialogue: 0,0:25:13.76,0:25:17.89,Default,,0,0,0,,Оянған кездегі қалған жұмыс уақыты 75 сағатты құрайды.
Dialogue: 0,0:25:18.18,0:25:20.06,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:25:20.68,0:25:21.97,Default,,0,0,0,,Күте тұрыңыз, эй.
Dialogue: 0,0:25:25.81,0:25:28.06,Default,,0,0,0,,Хмф, құдайым.
Dialogue: 0,0:25:49.50,0:25:51.67,Default,,0,0,0,,Тұтынушы Тұтынушы
Dialogue: 0,0:25:52.21,0:25:53.71,Default,,0,0,0,,Тұтынушы (Кусуя) Ах!
Dialogue: 0,0:25:55.05,0:25:56.01,Default,,0,0,0,,Күрсін
Dialogue: 0,0:25:56.51,0:25:58.64,Default,,0,0,0,,Қайырлы таң, тұтынушылар.
Dialogue: 0,0:25:58.84,0:26:00.43,Default,,0,0,0,,Қоңырау шалған сен бе?
Dialogue: 0,0:26:00.51,0:26:01.35,Default,,0,0,0,,Иә
Dialogue: 0,0:26:02.64,0:26:03.97,Default,,0,0,0,,Мен түс көрдім
Dialogue: 0,0:26:04.27,0:26:06.02,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:26:06.35,0:26:07.89,Default,,0,0,0,,Бұл жағымды түс болды ма?
Dialogue: 0,0:26:08.23,0:26:09.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:09.44,0:26:13.78,Default,,0,0,0,,Мен роботпын, сондықтан армандай алмаймын.
Dialogue: 0,0:26:14.32,0:26:18.07,Default,,0,0,0,,Мен не айта аламын? Мен сені қатты жақсы көремін.
Dialogue: 0,0:26:18.61,0:26:20.74,Default,,0,0,0,,Ұмтылатын нәрсе емес
Dialogue: 0,0:26:21.45,0:26:22.74,Default,,0,0,0,,Армандардың көпшілігі
Dialogue: 0,0:26:23.16,0:26:25.75,Default,,0,0,0,,Солай ма? Хаа~
Dialogue: 0,0:26:27.00,0:26:27.83,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:26:28.25,0:26:32.17,Default,,0,0,0,,Сонда сіз жылына бір апта ғана жұмыс істейсіз бе?
Dialogue: 0,0:26:32.54,0:26:34.50,Default,,0,0,0,,Иә, соңғы 30 жыл ішінде—
Dialogue: 0,0:26:34.59,0:26:38.88,Default,,0,0,0,,Біздің әмбебап дүкенге берілетін электр энергиясы айтарлықтай төмендеді.
Dialogue: 0,0:26:39.01,0:26:42.68,Default,,0,0,0,,Параметрлерге сәйкес қуатты үнемдеу режиміне ауысу
Dialogue: 0,0:26:43.01,0:26:49.19,Default,,0,0,0,,Сондықтан кеше таңғы сағат 9-да ол 8601 сағатта алғаш рет жұмысын бастады.
Dialogue: 0,0:26:50.40,0:26:51.23,Default,,0,0,0,,О
Dialogue: 0,0:26:51.60,0:26:54.44,Default,,0,0,0,,Мен сол күні не үшін келдім?
Dialogue: 0,0:26:54.90,0:26:57.19,Default,,0,0,0,,Бес күннен кейін түн ортасы бойынша -
Dialogue: 0,0:26:57.28,0:26:59.99,Default,,0,0,0,,Ұзақ мерзімді зарядтау күйіне қайта оралыңыз
Dialogue: 0,0:27:00.07,0:27:01.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:27:02.49,0:27:05.70,Default,,0,0,0,,Мен апаттық қуат көздері әлі жұмыс істеп тұрғанын білмедім.
Dialogue: 0,0:27:06.75,0:27:08.20,Default,,0,0,0,,Айтпақшы, тұтынушылар
Dialogue: 0,0:27:08.29,0:27:11.37,Default,,0,0,0,,Сол жаңбыр суы не үшін пайдаланылады?
Dialogue: 0,0:27:13.59,0:27:14.42,Default,,0,0,0,,Иә
Dialogue: 0,0:27:15.38,0:27:16.50,Default,,0,0,0,,Сусын
Dialogue: 0,0:27:17.46,0:27:21.76,Default,,0,0,0,,Мен сіздей емес, сусыз өмір сүре алмаймын.
Dialogue: 0,0:27:23.14,0:27:26.56,Default,,0,0,0,,Қарсы болмасаң, мен саған ішетін бірдеңе дайындап берейін.
Dialogue: 0,0:27:26.85,0:27:27.81,Default,,0,0,0,,Сусын?
Dialogue: 0,0:27:27.93,0:27:28.77,Default,,0,0,0,,Иә
Dialogue: 0,0:27:28.85,0:27:32.69,Default,,0,0,0,,Шынымды айтсам, мен шай қайнатуға шебермін.
Dialogue: 0,0:27:32.94,0:27:35.19,Default,,0,0,0,,Жаңа қайнатылған кофе ше?
Dialogue: 0,0:27:36.02,0:27:37.19,Default,,0,0,0,,Сәлем кофе
Dialogue: 0,0:27:37.82,0:27:39.61,Default,,0,0,0,,Сонда да ішімдік жоқ па?
Dialogue: 0,0:27:39.90,0:27:42.53,Default,,0,0,0,,Ашылмаған бөтелкедегі тазартылған сұйықтық.
Dialogue: 0,0:27:43.07,0:27:45.45,Default,,0,0,0,,Бұл мен үшін өте маңызды.
Dialogue: 0,0:27:45.53,0:27:46.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:27:46.83,0:27:48.29,Default,,0,0,0,,Шынымен бе? Бұл қайда?
Dialogue: 0,0:27:48.70,0:27:53.54,Default,,0,0,0,,Иә, біздің әмбебап дүкеннің жертөле қабатында жоғары санатты алкогольдік дүкен бар.
Dialogue: 0,0:27:54.50,0:27:56.46,Default,,0,0,0,,Жетеді, мен түсінемін.
Dialogue: 0,0:27:56.59,0:27:57.42,Default,,0,0,0,,Иә
Dialogue: 0,0:27:58.00,0:27:59.67,Default,,0,0,0,,Айтпақшы, тұтынушылар
Dialogue: 0,0:27:59.92,0:28:04.18,Default,,0,0,0,,Йенаның жөндеу жұмыстарының қазіргі жағдайы қандай?
Dialogue: 0,0:28:04.39,0:28:05.89,Default,,0,0,0,,Юбе сияқты
Dialogue: 0,0:28:06.43,0:28:07.68,Default,,0,0,0,,Әлі жөндеуде
Dialogue: 0,0:28:10.98,0:28:12.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:28:12.81,0:28:16.52,Default,,0,0,0,,Содан кейін мен проекцияның жойылғанын жариялаймын.
Dialogue: 0,0:28:19.65,0:28:20.49,Default,,0,0,0,,Эй
Dialogue: 0,0:28:20.57,0:28:22.95,Default,,0,0,0,,Бір жерде жанып кеткен шамды ауыстыратын құрал бар ма?
Dialogue: 0,0:28:23.74,0:28:24.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:26.03,0:28:28.37,Default,,0,0,0,,Соңғы үлгідегі 905 сериясы:
Dialogue: 0,0:28:28.45,0:28:32.16,Default,,0,0,0,,Олардың екеуі бірінші қабаттағы кіреберістегі жалпы ақпарат бөліміне тағайындалды.
Dialogue: 0,0:28:32.87,0:28:37.71,Default,,0,0,0,,Екеуінің де FT типті денелері бар, сондықтан олардың маған қарағанда жетілген формалары бар.
Dialogue: 0,0:28:38.46,0:28:40.96,Default,,0,0,0,,Бет маскалары өте дәл және—
Dialogue: 0,0:28:41.05,0:28:43.30,Default,,0,0,0,,Көз жасын да төгуге болады.
Dialogue: 0,0:28:43.68,0:28:45.01,Default,,0,0,0,,Көз жасы
Dialogue: 0,0:28:45.55,0:28:47.01,Default,,0,0,0,,Оны қосыңыз.
Dialogue: 0,0:28:47.64,0:28:48.93,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:28:50.39,0:28:52.02,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:28:54.06,0:28:56.69,Default,,0,0,0,,Сіз ағып кете алмайсыз ба? Көз жасы
Dialogue: 0,0:28:56.77,0:28:57.61,Default,,0,0,0,,Иә
Dialogue: 0,0:28:57.77,0:28:59.32,Default,,0,0,0,,Көздің жасын төгу функциясы:
Dialogue: 0,0:28:59.40,0:29:03.32,Default,,0,0,0,,Ол бірінші рет алдыңғы үлгіде, 9000 сериясында орнатылды.
Dialogue: 0,0:29:03.70,0:29:04.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:04.82,0:29:06.87,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:29:09.49,0:29:10.74,Default,,0,0,0,,Иә ауыстырыңыз
Dialogue: 0,0:29:11.62,0:29:12.91,Default,,0,0,0,,Бұл жігіт жақсы емес.
Dialogue: 0,0:29:13.71,0:29:14.91,Default,,0,0,0,,Сіз екеуін пайдалана аласыз ба?
Dialogue: 0,0:29:15.46,0:29:19.25,Default,,0,0,0,,Бұл кабельді қазір ажырату дұрыс па?
Dialogue: 0,0:29:19.67,0:29:21.55,Default,,0,0,0,,Бұл бастапқыда тұтынушыларға арналған—
Dialogue: 0,0:29:21.63,0:29:25.59,Default,,0,0,0,,Бұл мен сізге ешқашан көрсете алмайтын ұят төтенше шара.
Dialogue: 0,0:29:25.93,0:29:27.84,Default,,0,0,0,,Иә, сәл күте тұрыңыз.
Dialogue: 0,0:29:28.05,0:29:29.60,Default,,0,0,0,,Мен де қозғалтқышты іске қосқым келеді.
Dialogue: 0,0:29:29.80,0:29:31.39,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:29:31.51,0:29:33.02,Default,,0,0,0,,Айтпақшы, тұтынушылар
Dialogue: 0,0:29:33.10,0:29:34.18,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:29:34.48,0:29:38.10,Default,,0,0,0,,Көз жасын төгу қандай сезімде болады?
Dialogue: 0,0:29:38.98,0:29:40.69,Default,,0,0,0,,Хмм... Келіңіздер.
Dialogue: 0,0:29:41.19,0:29:43.82,Default,,0,0,0,,Жылап жатқанда онша ойлай алмайсың.
Dialogue: 0,0:29:44.19,0:29:45.32,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:29:46.32,0:29:47.74,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:29:48.07,0:29:51.95,Default,,0,0,0,,Көз жасымды төгуді қатты аңсаймын.
Dialogue: 0,0:29:52.16,0:29:55.87,Default,,0,0,0,,Мен арзан нұсқа болғандықтан, көз жасымды шығара алмаймын.
Dialogue: 0,0:29:56.25,0:29:58.08,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:29:58.42,0:29:59.63,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:29:59.71,0:30:01.50,Default,,0,0,0,,Аа, солай.
Dialogue: 0,0:30:03.25,0:30:04.13,Default,,0,0,0,,Йошито
Dialogue: 0,0:30:04.67,0:30:06.59,Default,,0,0,0,,Ендік осін жоғары жылжытып көріңіз.
Dialogue: 0,0:30:07.01,0:30:08.01,Default,,0,0,0,,Баяу
Dialogue: 0,0:30:08.09,0:30:08.93,Default,,0,0,0,,Иә
Dialogue: 0,0:30:09.26,0:30:13.43,Default,,0,0,0,,Олай болса, өз қауіпсіздігіңіз үшін бұрылыс аймағынан шығып кетіңіз.
Dialogue: 0,0:30:13.97,0:30:16.39,Default,,0,0,0,,(Мотордың жұмыс дыбысы)
Dialogue: 0,0:30:23.11,0:30:25.53,Default,,0,0,0,,(Мотордың баяулау дыбысы)
Dialogue: 0,0:30:26.53,0:30:27.86,Default,,0,0,0,,Күрсін
Dialogue: 0,0:30:34.24,0:30:35.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:37.66,0:30:40.50,Default,,0,0,0,,Тұтынушы Йенаның жөндеуі –
Dialogue: 0,0:30:40.58,0:30:43.17,Default,,0,0,0,,Сіз оны қанша уақытта аяқтайды деп ойлайсыз?
Dialogue: 0,0:30:43.42,0:30:44.38,Default,,0,0,0,,Саана
Dialogue: 0,0:30:44.63,0:30:48.68,Default,,0,0,0,,Сіз оны ертең сағат 11-де проекцияға уақытында жасай аласыз ба?
Dialogue: 0,0:30:50.43,0:30:53.18,Default,,0,0,0,,Мен білмеймін. Құдайға дұға ет.
Dialogue: 0,0:30:53.72,0:30:57.02,Default,,0,0,0,,Сонда қай құдайға сиынуымыз керек?
Dialogue: 0,0:30:57.52,0:30:59.02,Default,,0,0,0,,Иә? Не болса да
Dialogue: 0,0:30:59.23,0:31:01.52,Default,,0,0,0,,Мысалы, грек мифологиясында...
Dialogue: 0,0:31:01.60,0:31:05.90,Default,,0,0,0,,Зевс Афина Аполлон Гермес Артемида—
Dialogue: 0,0:31:06.19,0:31:08.86,Default,,0,0,0,,Деметер Посейдон Аид
Dialogue: 0,0:31:09.11,0:31:10.41,Default,,0,0,0,,Сіз көп нәрсені білесіз.
Dialogue: 0,0:31:10.78,0:31:12.99,Default,,0,0,0,,Ал, өзіңе ұнайтын нәрсе үшін дұға ет.
Dialogue: 0,0:31:13.07,0:31:13.91,Default,,0,0,0,,Иә
Dialogue: 0,0:31:13.99,0:31:16.74,Default,,0,0,0,,Енді Диониске дұға етейік.
Dialogue: 0,0:31:16.91,0:31:18.62,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:31:18.79,0:31:22.63,Default,,0,0,0,,Шарап пен молшылық құдайы, оның ағылшынша аты Бахус.
Dialogue: 0,0:31:23.04,0:31:25.92,Default,,0,0,0,,Мен бұл тұтынушыға жақсы сәйкес келеді деп ойладым.
Dialogue: 0,0:31:26.17,0:31:28.80,Default,,0,0,0,,О, ол өшірілген жоқ.
Dialogue: 0,0:31:29.38,0:31:32.47,Default,,0,0,0,,Неге менің құдайыма емес, құдайыңа сыйынбайсың?
Dialogue: 0,0:31:32.84,0:31:34.68,Default,,0,0,0,,Сен менің Құдайымсың ба?
Dialogue: 0,0:31:34.97,0:31:36.22,Default,,0,0,0,,Роботтардың құдайы
Dialogue: 0,0:31:39.14,0:31:40.69,Default,,0,0,0,,Менің дерекқорымда—
Dialogue: 0,0:31:40.77,0:31:43.31,Default,,0,0,0,,Сәйкес ақпарат табылмады
Dialogue: 0,0:31:43.77,0:31:45.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:45.48,0:31:48.99,Default,,0,0,0,,Бірақ мен кейбір маңызды ақпаратты таптым.
Dialogue: 0,0:31:49.36,0:31:50.65,Default,,0,0,0,,Алдыңғы болжамдарда—
Dialogue: 0,0:31:50.74,0:31:54.03,Default,,0,0,0,,Бұл мифтік аспандағы ерекше белгі туралы кездесу.
Dialogue: 0,0:31:54.53,0:31:56.53,Default,,0,0,0,,Голограмма ретінде сақталған
Dialogue: 0,0:32:01.16,0:32:02.21,Default,,0,0,0,,Роботтар үшін де жұмақ бар ма?
Dialogue: 0,0:32:02.21,0:32:03.96,Default,,0,0,0,,Роботтар үшін де жұмақ бар ма?
Dialogue: 0,0:32:02.21,0:32:03.96,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:32:03.96,0:32:04.29,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:32:04.46,0:32:07.00,Default,,0,0,0,,Иә, болуы керек.
Dialogue: 0,0:32:07.25,0:32:08.13,Default,,0,0,0,,Сәлем, директор
Dialogue: 0,0:32:08.21,0:32:10.30,Default,,0,0,0,,А, а... дұрыс.
Dialogue: 0,0:32:10.42,0:32:12.63,Default,,0,0,0,,Бұл қандай жер?
Dialogue: 0,0:32:12.72,0:32:14.89,Default,,0,0,0,,А, м...
Dialogue: 0,0:32:15.26,0:32:17.43,Default,,0,0,0,,Дұрыс жұмыс істемеу немесе зарядсыздану сияқты нәрсе.
Dialogue: 0,0:32:17.51,0:32:19.35,Default,,0,0,0,,Онда ештеңе жоқ, солай ма?
Dialogue: 0,0:32:19.43,0:32:21.06,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:32:21.14,0:32:25.44,Default,,0,0,0,,Бағдарламалық құрал қателері немесе шығын бөлшектерін ауыстыру жоқ деп естідім... Қызық?
Dialogue: 0,0:32:25.52,0:32:28.98,Default,,0,0,0,,Басқа кез келген тілек орындалады.
Dialogue: 0,0:32:29.15,0:32:30.44,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:32:30.61,0:32:31.82,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:32:34.03,0:32:35.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:32:36.41,0:32:39.04,Default,,0,0,0,,Құдай сол роботтың аспанында.
Dialogue: 0,0:32:39.12,0:32:40.24,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:32:41.79,0:32:45.12,Default,,0,0,0,,Иә Маңызды білім ретінде тіркелген
Dialogue: 0,0:32:45.50,0:32:48.63,Default,,0,0,0,,Мен Құдай туралы білгеніме өте қуаныштымын.
Dialogue: 0,0:32:49.80,0:32:53.97,Default,,0,0,0,,Негізі робот құдайдан сұрайтыным бар.
Dialogue: 0,0:32:54.05,0:32:55.68,Default,,0,0,0,,Кім... қалайсың?
Dialogue: 0,0:32:58.39,0:33:00.10,Default,,0,0,0,,Сіз жер бетінде не тілейсіз?
Dialogue: 0,0:33:00.89,0:33:02.64,Default,,0,0,0,,Иә, аспан...
Dialogue: 0,0:33:04.19,0:33:05.77,Default,,0,0,0,,Хмм... не болды?
Dialogue: 0,0:33:06.23,0:33:07.31,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:33:07.40,0:33:12.03,Default,,0,0,0,,Біз өте өкінеміз, бірақ жақында түн ортасы болады.
Dialogue: 0,0:33:12.28,0:33:14.49,Default,,0,0,0,,Мен кәдімгі бизнес параметрлерін ұстанамын—
Dialogue: 0,0:33:14.78,0:33:17.20,Default,,0,0,0,,Біз ұйқы режиміне өтеміз.
Dialogue: 0,0:33:18.53,0:33:20.12,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:33:21.37,0:33:23.71,Default,,0,0,0,,Ояну уақыты ертең таңғы 9.
Dialogue: 0,0:33:24.00,0:33:28.13,Default,,0,0,0,,Оянған кездегі қалған жұмыс уақыты 60 сағатты құрайды.
Dialogue: 0,0:33:28.54,0:33:30.71,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:33:35.05,0:33:35.88,Default,,0,0,0,,Әй
Dialogue: 0,0:33:42.31,0:33:44.56,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,0:33:45.06,0:33:47.90,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,0:33:48.31,0:33:50.65,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,0:33:51.73,0:33:52.82,Default,,0,0,0,,Аспан жұлдыздарға толы...
Dialogue: 0,0:33:52.90,0:33:54.61,Default,,0,0,0,,Әй, аяқталды.
Dialogue: 0,0:33:56.24,0:33:57.20,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:33:57.28,0:34:01.24,Default,,0,0,0,,Бұл Йенаның жөндеу жұмыстары аяқталғанын білдіре ме?
Dialogue: 0,0:34:01.70,0:34:03.33,Default,,0,0,0,,Иә
Dialogue: 0,0:34:03.91,0:34:06.33,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:34:10.50,0:34:14.38,Default,,0,0,0,,Бүгін Ханабиши әмбебап дүкенінің басты дүкенінің төбесінде.
Dialogue: 0,0:34:14.51,0:34:17.97,Default,,0,0,0,,Планетарий ғимаратына қош келдіңіздер.
Dialogue: 0,0:34:18.68,0:34:23.01,Default,,0,0,0,,Менің атым Юмэми Хошино, мен осы мұражайда аудармашымын.
Dialogue: 0,0:34:23.77,0:34:28.23,Default,,0,0,0,,Проекцияны бастамас бұрын, біз сізге бірнеше қарапайым сақтық шаралары туралы хабарлағымыз келеді.
Dialogue: 0,0:34:28.98,0:34:30.40,Default,,0,0,0,,Проекция кезіндегі жеке тіл —
Dialogue: 0,0:34:30.48,0:34:34.28,Default,,0,0,0,,Бұл әрекеттен аулақ болыңыз, себебі бұл басқа тұтынушыларға қолайсыздық тудыруы мүмкін.
Dialogue: 0,0:34:34.61,0:34:38.95,Default,,0,0,0,,Ұялы телефоныңыздағы немесе сағатыңыздағы оятқышты алдын ала өшіріңіз.
Dialogue: 0,0:34:39.40,0:34:43.12,Default,,0,0,0,,Сонымен қатар проекция кезінде тамақ ішпеңіз, ішпеңіз және темекі шекпеңіз.
Dialogue: 0,0:34:43.20,0:34:45.70,Default,,0,0,0,,Олай істеуден аулақ болыңыз.
Dialogue: 0,0:34:46.62,0:34:48.04,Default,,0,0,0,,Соңында —
Dialogue: 0,0:34:48.12,0:34:53.13,Default,,0,0,0,,Сізді жұлдыздар әлеміне шақыратын маңызды серіктестерімізді таныстыру.
Dialogue: 0,0:34:53.67,0:34:56.17,Default,,0,0,0,,Бізді қошеметпен қарсы алыңыздар.
Dialogue: 0,0:34:59.97,0:35:01.34,Default,,0,0,0,,Бұл Йена.
Dialogue: 0,0:35:07.64,0:35:11.35,Default,,0,0,0,,Шын мәнінде~ Йена-сан~
Dialogue: 0,0:35:11.73,0:35:16.15,Default,,0,0,0,,Бұл үлкен машинаның аты.
Dialogue: 0,0:35:17.03,0:35:22.99,Default,,0,0,0,,Олай болса, Йена-сан, мен барлығына сәлем айтқым келеді~
Dialogue: 0,0:35:31.75,0:35:33.33,Default,,0,0,0,,Қазір, бүгін
Dialogue: 0,0:35:33.42,0:35:37.05,Default,,0,0,0,,Ақырында, біздің планетарий ашылған күннен бастап жұмыс істеп тұр.
Dialogue: 0,0:35:37.13,0:35:42.47,Default,,0,0,0,,Бізге 2 487 290-шы тұтынушы келді.
Dialogue: 0,0:35:42.80,0:35:46.97,Default,,0,0,0,,Сізге барлық қызметкерлер атынан үлкен алғысымды білдіремін.
Dialogue: 0,0:35:48.72,0:35:53.48,Default,,0,0,0,,Бүгін осы оқиғаны атап өту үшін біз арнайы проекция дайындадық.
Dialogue: 0,0:35:57.11,0:36:00.28,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,0:36:06.49,0:36:09.45,Default,,0,0,0,,Күздің күні далада жаңбыр жауды.
Dialogue: 0,0:36:10.08,0:36:13.71,Default,,0,0,0,,Осындай күндерде мен күйзеліске ұшыраймын.
Dialogue: 0,0:36:14.29,0:36:16.54,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:36:17.63,0:36:21.13,Default,,0,0,0,,Мұнда күнді кез келген уақытта шақыруға болады.
Dialogue: 0,0:36:21.22,0:36:22.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:22.43,0:36:24.55,Default,,0,0,0,,Иә, бұл күн
Dialogue: 0,0:36:25.05,0:36:27.97,Default,,0,0,0,,Ақырындап батыс аспанға батып бара жатыр
Dialogue: 0,0:36:32.85,0:36:34.81,Default,,0,0,0,,Бірінші жұлдыз көрінді
Dialogue: 0,0:36:35.23,0:36:37.52,Default,,0,0,0,,Кешкі жұлдыз Венера
Dialogue: 0,0:36:38.27,0:36:40.94,Default,,0,0,0,,Аспан күннен-күнге қарайып барады
Dialogue: 0,0:36:41.36,0:36:44.24,Default,,0,0,0,,Жүр, үйге тез қайтайық.
Dialogue: 0,0:36:44.74,0:36:49.45,Default,,0,0,0,,Көп ұзамай түн қараңғылығы айналаны жайлап алады.
Dialogue: 0,0:36:56.33,0:36:58.54,Default,,0,0,0,,Бүгін түнгі сағат 8-де жұлдызды аспан
Dialogue: 0,0:36:59.80,0:37:02.92,Default,,0,0,0,,Аспанда Құс жолы өтеді.
Dialogue: 0,0:37:03.42,0:37:07.47,Default,,0,0,0,,Ежелгі адамдар сүт аққан сияқты деп ойлаған.
Dialogue: 0,0:37:07.64,0:37:10.51,Default,,0,0,0,,Біз мұны Құс жолы деп атадық.
Dialogue: 0,0:37:11.31,0:37:12.98,Default,,0,0,0,,Ең жоғары нүкте
Dialogue: 0,0:37:13.18,0:37:16.40,Default,,0,0,0,,Аспан басындағы жұлдыздарды көріп тұрсың ба?
Dialogue: 0,0:37:16.73,0:37:19.90,Default,,0,0,0,,Бұл Cygnus шоқжұлдызындағы бірінші магнитудалы Денеб жұлдызы.
Dialogue: 0,0:37:20.40,0:37:24.40,Default,,0,0,0,,Лирадағы жақын маңдағы Вегамен және Акиладағы Альтаирмен бірге —
Dialogue: 0,0:37:24.53,0:37:26.61,Default,,0,0,0,,«Жазғы үшбұрыш» дейді.
Dialogue: 0,0:37:27.49,0:37:30.53,Default,,0,0,0,,Бұл біз қазір көріп тұрған жазғы шоқжұлдыздар.
Dialogue: 0,0:37:31.29,0:37:33.54,Default,,0,0,0,,Бүгін салқын күн болды, бірақ...
Dialogue: 0,0:37:33.62,0:37:36.62,Default,,0,0,0,,Көзіңді кешкі жұлдызды аспанға бұрсаң, әлі де бар...
Dialogue: 0,0:37:36.87,0:37:39.34,Default,,0,0,0,,Жаздың қалдықтарын табуға болады
Dialogue: 0,0:37:40.38,0:37:44.47,Default,,0,0,0,,Сонымен күзгі шоқжұлдыздар қандай?
Dialogue: 0,0:37:44.84,0:37:48.89,Default,,0,0,0,,Денебтен сәл шығысқа қара.
Dialogue: 0,0:37:49.60,0:37:52.64,Default,,0,0,0,,Арқасында қанатты жылқы – Пегас.
Dialogue: 0,0:37:52.97,0:37:56.44,Default,,0,0,0,,Шынжырлы ханшайым - Андромеда.
Dialogue: 0,0:37:56.89,0:37:59.40,Default,,0,0,0,,Күз шоқжұлдыздары туралы әйгілі миф бар...
Dialogue: 0,0:37:59.48,0:38:02.57,Default,,0,0,0,,Мен өзімді жұлдыздар сорып жатқандай сезінемін.
Dialogue: 0,0:38:03.99,0:38:05.15,Default,,0,0,0,,Андромеда —
Dialogue: 0,0:38:05.24,0:38:10.62,Default,,0,0,0,,Ежелгі Эфиопия патшасы Кефей мен оның әйелі Кассиопеяның қызы.
Dialogue: 0,0:38:11.24,0:38:14.91,Default,,0,0,0,,Кассиопея қызының сұлулығына тым мақтанды.
Dialogue: 0,0:38:15.04,0:38:18.42,Default,,0,0,0,,Теңіз құдайы Посейдонның қаһарына ұшырар едім.
Dialogue: 0,0:38:19.04,0:38:23.46,Default,,0,0,0,,Посейдон аруақ китті Эфиопия жағалауына жібереді
Dialogue: 0,0:38:24.13,0:38:27.05,Default,,0,0,0,,Эфиопия елес кит тудырған цунамиге ұшырады.
Dialogue: 0,0:38:27.13,0:38:29.34,Default,,0,0,0,,Сіз үлкен шығынға ұшырайсыз.
Dialogue: 0,0:38:30.14,0:38:33.64,Default,,0,0,0,,Цефей: «Посейдонның ашуын басу үшін...
Dialogue: 0,0:38:33.72,0:38:36.89,Default,,0,0,0,,«Қызыңыз Андромеданы құрбандыққа беріңіз».
Dialogue: 0,0:38:37.10,0:38:38.98,Default,,0,0,0,,Амонның пайғамбарлығын қабыл алыңыз
Dialogue: 0,0:38:39.56,0:38:42.48,Default,,0,0,0,,Уайымдап тұрған Кефейге, Андромеда...
Dialogue: 0,0:38:42.73,0:38:46.07,Default,,0,0,0,,«Мен құрбан болуды ұсындым».
Dialogue: 0,0:38:46.61,0:38:48.74,Default,,0,0,0,,Цефей мұңын басады —
Dialogue: 0,0:38:48.82,0:38:52.49,Default,,0,0,0,,Андромеданы жағадағы жартасқа байлау
Dialogue: 0,0:38:53.33,0:38:56.12,Default,,0,0,0,,Андромеда жағада жалғыз қалтырап тұрды.
Dialogue: 0,0:38:56.20,0:38:58.41,Default,,0,0,0,,Теңіз толқындай бастайды
Dialogue: 0,0:38:59.00,0:39:01.04,Default,,0,0,0,,Елес кит пайда болды.
Dialogue: 0,0:39:01.88,0:39:05.13,Default,,0,0,0,,Елес кит барған сайын Андромедаға жақындап келеді
Dialogue: 0,0:39:05.76,0:39:08.01,Default,,0,0,0,,Андромеда шаршауға тырысады, бірақ...
Dialogue: 0,0:39:08.13,0:39:09.93,Default,,0,0,0,,Тізбек қозғалмайды
Dialogue: 0,0:39:10.18,0:39:12.43,Default,,0,0,0,,"Көмектесіңіз! Біреу көмектесіңізші!"
Dialogue: 0,0:39:13.18,0:39:16.10,Default,,0,0,0,,Андромеда жүрегінде көмекке шақырды.
Dialogue: 0,0:39:16.85,0:39:17.81,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:39:18.10,0:39:22.10,Default,,0,0,0,,Батыр Персей аспандағы Пегас атты мініп көрінді.
Dialogue: 0,0:39:22.48,0:39:26.28,Default,,0,0,0,,Персей Горгон Медузасын жеңіп қайтып келе жатқан еді.
Dialogue: 0,0:39:26.44,0:39:29.99,Default,,0,0,0,,Мен жағалау сызығынан біртүрлі нәрсені байқадым, сондықтан мен оны көруге келдім.
Dialogue: 0,0:39:30.32,0:39:34.20,Default,,0,0,0,,Енді бұл дүниеде ол әмбебап әңгімеші.
Dialogue: 0,0:39:34.83,0:39:36.91,Default,,0,0,0,,Жұлдызды аспан – оның бағы
Dialogue: 0,0:39:37.12,0:39:41.83,Default,,0,0,0,,Ханшайымдар, батырлар, құбыжықтар және құдайлар оның қол астында.
Dialogue: 0,0:39:42.21,0:39:45.88,Default,,0,0,0,,Кашидзуки әр адамның рөлін құрметпен ойнайды.
Dialogue: 0,0:39:47.21,0:39:51.01,Default,,0,0,0,,Осылайша Андромеда мен Персей шоқжұлдыздарға айналды.
Dialogue: 0,0:39:51.26,0:39:54.93,Default,,0,0,0,,Күзгі түнгі аспан астында әлі бақытты өмір сүріп жатырмыз.
Dialogue: 0,0:39:58.06,0:40:01.19,Default,,0,0,0,,Енді арнайы проекцияның уақыты келді.
Dialogue: 0,0:40:01.56,0:40:05.15,Default,,0,0,0,,Тақырыбы: «Адамзаттың ғарышқа ұшу арманы»
Dialogue: 0,0:40:05.23,0:40:06.32,Default,,0,0,0,,(қуатты өшіру дыбысы)
Dialogue: 0,0:40:06.40,0:40:07.23,Default,,0,0,0,,Oh?
Dialogue: 0,0:40:07.61,0:40:09.49,Default,,0,0,0,,Не болды? Ол дұрыс жұмыс істемеді ме?
Dialogue: 0,0:40:10.36,0:40:11.90,Default,,0,0,0,,Жоқ, мүмкін емес…
Dialogue: 0,0:40:14.32,0:40:16.03,Default,,0,0,0,,Бұл ажыратқыш
Dialogue: 0,0:40:21.91,0:40:22.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:25.46,0:40:28.34,Default,,0,0,0,,Тұтынушы Йена жауап бермейді
Dialogue: 0,0:40:28.80,0:40:32.17,Default,,0,0,0,,Барлық проекциялық құрылғылар мен жылжымалы осьтер қозғалмайды
Dialogue: 0,0:40:32.59,0:40:36.10,Default,,0,0,0,,Жөндеу жұмыстарын жүргізу үшін қандай құралдар қажет?
Dialogue: 0,0:40:37.47,0:40:39.35,Default,,0,0,0,,Электр жарығы жоқ...
Dialogue: 0,0:40:39.93,0:40:43.60,Default,,0,0,0,,Кешіріңіз, мен не айтқыңыз келгенін толық түсінбедім.
Dialogue: 0,0:40:44.65,0:40:45.77,Default,,0,0,0,,Әйтеуір—
Dialogue: 0,0:40:46.65,0:40:51.11,Default,,0,0,0,,30 жыл бойы бұл жерде ғажайып аз ғана электр қуаты болған.
Dialogue: 0,0:40:51.90,0:40:53.57,Default,,0,0,0,,Бірақ ол тоқтады.
Dialogue: 0,0:40:54.41,0:40:56.07,Default,,0,0,0,,Сонымен, бұл электр қуатының үзілуі.
Dialogue: 0,0:40:56.57,0:40:59.91,Default,,0,0,0,,Біраз уақыттан кейін ол төтенше қуатқа ауысады.
Dialogue: 0,0:41:00.16,0:41:03.37,Default,,0,0,0,,Бұл жер бастапқыда төтенше жағдайда жұмыс істеді.
Dialogue: 0,0:41:04.08,0:41:05.46,Default,,0,0,0,,Кері қайтару жоқ
Dialogue: 0,0:41:06.17,0:41:08.50,Default,,0,0,0,,Бұл біреу бірдеңе жасай алатын мәселе емес.
Dialogue: 0,0:41:09.25,0:41:12.21,Default,,0,0,0,,Енді арнайы проекция туралы...
Dialogue: 0,0:41:13.63,0:41:16.05,Default,,0,0,0,,Менің айтқанымды мұқият тыңда.
Dialogue: 0,0:41:16.34,0:41:17.18,Default,,0,0,0,,Иә
Dialogue: 0,0:41:18.64,0:41:20.10,Default,,0,0,0,,Проекцияны жалғастыру
Dialogue: 0,0:41:20.56,0:41:21.97,Default,,0,0,0,,Сіздің дауысыңыз жеткілікті
Dialogue: 0,0:41:23.81,0:41:27.23,Default,,0,0,0,,Кешіріңіз, мен не айтқыңыз келгенін түсінбедім.
Dialogue: 0,0:41:27.31,0:41:29.27,Default,,0,0,0,,«Жүре бер» дедім.
Dialogue: 0,0:41:29.94,0:41:33.90,Default,,0,0,0,,Проекторды жылжытудың қажеті жоқ, сондықтан түсініктемеңізді тыңдауға рұқсат етіңіз.
Dialogue: 0,0:41:34.32,0:41:35.28,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:41:35.65,0:41:37.16,Default,,0,0,0,,Ал енді, досым! Міне, жеңіс.
Dialogue: 0,0:41:37.62,0:41:41.41,Default,,0,0,0,,Бірақ менің түсіндірменің өзі проекция емес.
Dialogue: 0,0:41:41.74,0:41:42.70,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:41:43.20,0:41:45.58,Default,,0,0,0,,Жұлдызға келгенде бәрі менің басымда.
Dialogue: 0,0:41:46.12,0:41:50.17,Default,,0,0,0,,Сөйлессең, көргеніңді түсінемін.
Dialogue: 0,0:41:51.25,0:41:54.55,Default,,0,0,0,,Сіз жұлдыздарды шынымен жақсы көресіз, солай ма?
Dialogue: 0,0:41:54.80,0:41:55.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:55.84,0:41:58.59,Default,,0,0,0,,Сіз сияқты адамдарды бізге қонаққа шақырамыз—
Dialogue: 0,0:41:58.68,0:42:00.76,Default,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,0:42:02.47,0:42:03.31,Default,,0,0,0,,О
Dialogue: 0,0:42:03.47,0:42:08.06,Default,,0,0,0,,Олай болса, мен сіздің сөзіңізді қабылдап, тек өзімнің түсіндіруіммен жалғастырамын.
Dialogue: 0,0:42:08.69,0:42:09.90,Default,,0,0,0,,Осы жерді басыңыз
Dialogue: 0,0:42:13.32,0:42:16.90,Default,,0,0,0,,Шынымен де бейхабар адам.
Dialogue: 0,0:42:20.87,0:42:24.29,Default,,0,0,0,,Енді біз арнайы проекцияны жалғастырамыз.
Dialogue: 0,0:42:28.75,0:42:32.63,Default,,0,0,0,,Бұл ұзақ уақыт бұрын болды.
Dialogue: 0,0:42:33.63,0:42:36.13,Default,,0,0,0,,Суық және қараңғы үңгірде
Dialogue: 0,0:42:36.38,0:42:39.97,Default,,0,0,0,,Адамның ата-бабалары үйір-үйір болып өмір сүрген
Dialogue: 0,0:42:41.05,0:42:43.01,Default,,0,0,0,,Дүние жүзін мұз басып жатыр
Dialogue: 0,0:42:43.14,0:42:46.39,Default,,0,0,0,,Өткір тістері бар аң аңдып жүр.
Dialogue: 0,0:42:47.73,0:42:52.06,Default,,0,0,0,,Бір түнде бір жігіт оянып кетті.
Dialogue: 0,0:42:52.86,0:42:57.32,Default,,0,0,0,,Ол суық және тегіс, ұйықтай алмады.
Dialogue: 0,0:42:58.24,0:42:59.66,Default,,0,0,0,,Ұйқысы келген көзіңізді уқалаңыз
Dialogue: 0,0:42:59.82,0:43:04.79,Default,,0,0,0,,Ол үңгірдің кіреберісінен сыртқа қарады.
Dialogue: 0,0:43:05.74,0:43:07.87,Default,,0,0,0,,Тіпті түнгі аспанда да —
Dialogue: 0,0:43:08.00,0:43:11.25,Default,,0,0,0,,Көптеген жұлдыздар жарқырап тұрды.
Dialogue: 0,0:43:12.79,0:43:14.84,Default,,0,0,0,,Сол уақыттан бері
Dialogue: 0,0:43:15.00,0:43:19.97,Default,,0,0,0,,Адамдар жұлдыздардың шексіз кеңею әлеміне әрқашан таңданыспен қарайды.
Dialogue: 0,0:43:26.35,0:43:32.06,Default,,0,0,0,,Мұндай адамдардың аспаннан тыс ғарышты көздейтіні табиғи нәрсе еді.
Dialogue: 0,0:43:33.40,0:43:34.94,Default,,0,0,0,,Алыс биіктерге
Dialogue: 0,0:43:35.77,0:43:40.03,Default,,0,0,0,,Түннің қараңғылығында көптеген көз жасы -
Dialogue: 0,0:43:40.49,0:43:43.24,Default,,0,0,0,,Жаңа арман тамшылары орнында
Dialogue: 0,0:43:45.28,0:43:49.00,Default,,0,0,0,,Мен білмей тұрып, бұл қол ғарышқа жетті.
Dialogue: 0,0:43:50.16,0:43:52.42,Default,,0,0,0,,Күн жүйесі үшінші планета
Dialogue: 0,0:43:53.33,0:43:56.05,Default,,0,0,0,,Бұл біздің Жер
Dialogue: 0,0:43:56.92,0:43:59.34,Default,,0,0,0,,Мәңгілік әдемі жер
Dialogue: 0,0:44:00.13,0:44:04.47,Default,,0,0,0,,Бірақ қазір неше түрлі ұрыс-керіс, дау-дамай бар.
Dialogue: 0,0:44:04.76,0:44:07.39,Default,,0,0,0,,Шешілмеген мәселелер бар
Dialogue: 0,0:44:08.27,0:44:11.10,Default,,0,0,0,,Халық мәселесі Энергетикалық мәселе
Dialogue: 0,0:44:11.56,0:44:15.02,Default,,0,0,0,,Азық-түлік мәселесі Ғарыштық аумақ мәселесі
Dialogue: 0,0:44:15.98,0:44:18.44,Default,,0,0,0,,Бірақ мен сенемін
Dialogue: 0,0:44:19.28,0:44:22.45,Default,,0,0,0,,Адамдар әрқашан барлық мәселені шешеді
Dialogue: 0,0:44:22.82,0:44:27.20,Default,,0,0,0,,Бір күні мен жұлдыздар әлемін аралайтыныма сенімдімін.
Dialogue: 0,0:44:30.54,0:44:35.50,Default,,0,0,0,,Енді Койой саған ерекше сырды ашады.
Dialogue: 0,0:44:35.71,0:44:36.54,Default,,0,0,0,,О
Dialogue: 0,0:44:37.75,0:44:41.01,Default,,0,0,0,,Планетарий де уақыт машинасы.
Dialogue: 0,0:44:47.01,0:44:49.68,Default,,0,0,0,,Алыс өткеннен алыс болашаққа
Dialogue: 0,0:44:50.22,0:44:54.40,Default,,0,0,0,,Уақытты еркін басқаруға болады.
Dialogue: 0,0:44:58.61,0:44:59.82,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:45:00.36,0:45:02.90,Default,,0,0,0,,Осыдан тура 1000 жылдан кейінгі түн
Dialogue: 0,0:45:03.20,0:45:05.49,Default,,0,0,0,,Бұл жерден жұлдызды аспан көрінеді
Dialogue: 0,0:45:06.41,0:45:10.08,Default,,0,0,0,,Проектор Йена-сан және робот Хошино Юмэми—
Dialogue: 0,0:45:10.16,0:45:14.87,Default,,0,0,0,,Бұл мен тоқып еңбек еткен қарапайым болашақтың жұлдызды аспаны.
Dialogue: 0,0:45:15.87,0:45:17.13,Default,,0,0,0,,Барлығыңызды өтінемін.
Dialogue: 0,0:45:17.29,0:45:20.25,Default,,0,0,0,,Мұнда көрген жұлдызды аспанды ұмытпа.
Dialogue: 0,0:45:22.55,0:45:24.47,Default,,0,0,0,,Қараңғыда адасып қалдың
Dialogue: 0,0:45:24.84,0:45:27.97,Default,,0,0,0,,Нағыз жұлдызды аспанды енді көре алмайтын кезде
Dialogue: 0,0:45:28.72,0:45:30.97,Default,,0,0,0,,Оны ақырын есте сақтауға тырысыңыз.
Dialogue: 0,0:45:32.14,0:45:36.31,Default,,0,0,0,,Бұл менің кішкентай арманым
Dialogue: 0,0:45:37.56,0:45:41.23,Default,,0,0,0,,Ендеше өз заманымызға оралайық.
Dialogue: 0,0:45:42.53,0:45:44.28,Default,,0,0,0,,Жұлдыздар айналады
Dialogue: 0,0:45:48.78,0:45:52.91,Default,,0,0,0,,Қысқы шоқжұлдыздар шығыс көкжиектен көрінеді.
Dialogue: 0,0:45:53.45,0:45:54.50,Default,,0,0,0,,Орион
Dialogue: 0,0:45:54.66,0:45:55.54,Default,,0,0,0,,Аурига
Dialogue: 0,0:45:55.71,0:45:56.71,Default,,0,0,0,,Телец
Dialogue: 0,0:45:57.54,0:46:01.63,Default,,0,0,0,,Бұл әр түнде болатын жыл мезгілдерінің керемет ауысуы.
Dialogue: 0,0:46:02.25,0:46:07.13,Default,,0,0,0,,Ақырында ұзақ түн бітеді, Дүниеге таң атар.
Dialogue: 0,0:46:07.68,0:46:09.55,Default,,0,0,0,,Күн шықты
Dialogue: 0,0:46:09.93,0:46:13.52,Default,,0,0,0,,Құстардың сайрағанын, желдің сыбдырын естимін.
Dialogue: 0,0:46:17.10,0:46:19.56,Default,,0,0,0,,Ұйқыда жатқан ғимараттар мен ағаштар —
Dialogue: 0,0:46:19.73,0:46:22.98,Default,,0,0,0,,Жаңа күн сәулесінде ұйқылы көзімді уқалап
Dialogue: 0,0:46:23.82,0:46:26.07,Default,,0,0,0,,Жақында қала көше бастайды.
Dialogue: 0,0:46:26.70,0:46:29.45,Default,,0,0,0,,Ешкімге ұқсамайтын күн бүгін басталады.
Dialogue: 0,0:46:30.12,0:46:32.53,Default,,0,0,0,,Баршаңызға қайырлы таң.
Dialogue: 0,0:46:34.54,0:46:37.54,Default,,0,0,0,,Бұл арнайы проекцияны аяқтайды.
Dialogue: 0,0:46:38.08,0:46:42.88,Default,,0,0,0,,Бұл эпизодтың түсіндірмесін Юмеми Хошино әкелді.
Dialogue: 0,0:46:43.67,0:46:46.42,Default,,0,0,0,,Назарларыңызға рахмет.
Dialogue: 0,0:46:55.14,0:46:55.97,Default,,0,0,0,,​​О?
Dialogue: 0,0:46:56.68,0:46:57.64,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:46:58.39,0:47:00.77,Default,,0,0,0,,Бүгінгі проекция аяқталды
Dialogue: 0,0:47:02.27,0:47:05.11,Default,,0,0,0,,Тұтынушы Тұтынушы?
Dialogue: 0,0:47:07.15,0:47:08.99,Default,,0,0,0,,Сонымен ұйықтап қалдың ба?
Dialogue: 0,0:47:10.11,0:47:12.03,Default,,0,0,0,,Жағдайды ескере отырып,
Dialogue: 0,0:47:12.16,0:47:16.58,Default,,0,0,0,,Таң атқанша тұрғаныңыз дұрыс деп ойлаймыз.
Dialogue: 0,0:47:23.71,0:47:24.75,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:47:25.05,0:47:29.01,Default,,0,0,0,,Бұрын режиссер жұлдызды аспан астында ұйықтаған.
Dialogue: 0,0:47:29.26,0:47:32.72,Default,,0,0,0,,Ол маған бұл адамдар үшін ең үлкен салтанат екенін айтты.
Dialogue: 0,0:47:33.80,0:47:35.06,Default,,0,0,0,,Әрине
Dialogue: 0,0:47:35.31,0:47:39.10,Default,,0,0,0,,Менің ойымша, тапсырыс беруші арнайы проекцияға риза болды.
Dialogue: 0,0:47:40.06,0:47:43.36,Default,,0,0,0,,Мен сіз үшін өте қуаныштымын...
Dialogue: 0,0:47:43.44,0:47:46.98,Default,,0,0,0,,Нағыз жұлдыздарды көре алмайтын әлемде—
Dialogue: 0,0:47:47.61,0:47:50.65,Default,,0,0,0,,Осы уақытта ол маған көрсеткен жұлдыздар...
Dialogue: 0,0:47:51.20,0:47:55.28,Default,,0,0,0,,Ол әлі күнге дейін қабақтың артқы жағына күйіп тұрғаны анық.
Dialogue: 0,0:48:19.47,0:48:21.98,Default,,0,0,0,,Әй, жұлдызды адам дегеніміз не?
Dialogue: 0,0:48:22.27,0:48:24.31,Default,,0,0,0,,Сіздің қарапайым саудагерлерден айырмашылығыңыз бар ма?
Dialogue: 0,0:48:24.69,0:48:28.65,Default,,0,0,0,,Аа... Уа, менің ойымша, бұл сәл басқаша.
Dialogue: 0,0:48:28.86,0:48:30.94,Default,,0,0,0,,Мен ештеңе сатпаймын.
Dialogue: 0,0:48:31.36,0:48:33.66,Default,,0,0,0,,Эзра шынымен бақытты көрінді.
Dialogue: 0,0:48:34.20,0:48:37.62,Default,,0,0,0,,Бәйбішеге сыйынғандай тізерлеп отырдым.
Dialogue: 0,0:48:39.08,0:48:42.46,Default,,0,0,0,,Біз сізді қарсы аламыз
Dialogue: 0,0:48:42.79,0:48:43.75,Default,,0,0,0,,Жұлдызды тұлға
Dialogue: 0,0:48:44.46,0:48:46.29,Default,,0,0,0,,Иә, ауыл бастығы
Dialogue: 0,0:48:46.50,0:48:50.13,Default,,0,0,0,,Ол жігіт тым болмаса кішірек болуы керек.
Dialogue: 0,0:48:50.84,0:48:53.76,Default,,0,0,0,,Күтілгендей, ондай бала туылуы мүмкін емес еді.
Dialogue: 0,0:48:53.84,0:48:57.05,Default,,0,0,0,,Бұл енді менің айтып отырғаным емес, солай ма?
Dialogue: 0,0:48:57.43,0:49:00.56,Default,,0,0,0,,Ей, Еремия, жұлдыз деген не?
Dialogue: 0,0:49:00.72,0:49:03.35,Default,,0,0,0,,Не? Ал, бұл...
Dialogue: 0,0:49:03.73,0:49:06.94,Default,,0,0,0,,Бұл күн мен ай және сол сияқты нәрселер туралы.
Dialogue: 0,0:49:07.81,0:49:09.73,Default,,0,0,0,,Күн мен ай?
Dialogue: 0,0:49:10.03,0:49:11.94,Default,,0,0,0,,Сонымен, сіз шам сататын адамсыз ба?
Dialogue: 0,0:49:12.40,0:49:13.40,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:49:13.65,0:49:17.12,Default,,0,0,0,,Күн шамды емес, сырттағы нәрсені білдіреді.
Dialogue: 0,0:49:17.53,0:49:19.95,Default,,0,0,0,,Бірақ біз өткен күні далаға шықтық...
Dialogue: 0,0:49:20.04,0:49:21.79,Default,,0,0,0,,Күн болған жоқ
Dialogue: 0,0:49:21.91,0:49:23.96,Default,,0,0,0,,Еш жерде мұндай ештеңе болған жоқ.
Dialogue: 0,0:49:24.16,0:49:25.83,Default,,0,0,0,,Иә, солай...
Dialogue: 0,0:49:26.04,0:49:27.63,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:49:27.92,0:49:29.92,Default,,0,0,0,,Жұлдызды адамдар қайдан келеді?
Dialogue: 0,0:49:30.00,0:49:30.96,Default,,0,0,0,,Жұлдыздардан ма?
Dialogue: 0,0:49:31.13,0:49:33.47,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:49:33.55,0:49:35.43,Default,,0,0,0,,Жұлдызды адамдар да қарапайым адамдар.
Dialogue: 0,0:49:35.51,0:49:38.64,Default,,0,0,0,,Сіз қарапайым адам болсаңыз, неге өзіңізді жұлдызды адам дейсіз?
Dialogue: 0,0:49:38.85,0:49:41.01,Default,,0,0,0,,Неліктен көпес сияқты саяхаттайсың?
Dialogue: 0,0:49:41.18,0:49:42.81,Default,,0,0,0,,Иә~ Эй, неге?
Dialogue: 0,0:49:42.89,0:49:44.27,Default,,0,0,0,,Неліктен не?
Dialogue: 0,0:49:44.35,0:49:45.73,Default,,0,0,0,,Ишая саған
Dialogue: 0,0:49:45.81,0:49:47.85,Default,,0,0,0,,Хехе, әзілдеп тұрмын.
Dialogue: 0,0:49:47.94,0:49:50.40,Default,,0,0,0,,Маған көптеген сұрақтар қойылса да...
Dialogue: 0,0:49:50.48,0:49:51.78,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:49:51.86,0:49:53.49,Default,,0,0,0,,А?
Dialogue: 0,0:49:53.78,0:49:55.95,Default,,0,0,0,,Сіз өз жұмысыңызды дұрыс атқарып жатырсыз ба?
Dialogue: 0,0:49:56.11,0:49:57.41,Default,,0,0,0,,Әрине істеймін.
Dialogue: 0,0:49:57.49,0:49:59.16,Default,,0,0,0,,Иә, тамаша. Иә иә.
Dialogue: 0,0:49:59.70,0:50:00.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:01.24,0:50:02.99,Default,,0,0,0,,Еремия Ишая
Dialogue: 0,0:50:03.41,0:50:06.16,Default,,0,0,0,,Биыл да астық азайып бара жатқан сияқты.
Dialogue: 0,0:50:06.67,0:50:08.33,Default,,0,0,0,,Тыңайтқыштарды жақсарту туралы не айтасыз?
Dialogue: 0,0:50:08.75,0:50:11.84,Default,,0,0,0,,Біз картоптан нәтиже көріп отырмыз, бірақ көкөністер...
Dialogue: 0,0:50:12.17,0:50:13.00,Default,,0,0,0,,Иә
Dialogue: 0,0:50:13.34,0:50:15.09,Default,,0,0,0,,Бірақ мен осылай жалғастырамын.
Dialogue: 0,0:50:15.30,0:50:16.80,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:50:16.88,0:50:17.80,Default,,0,0,0,,Иә
Dialogue: 0,0:50:18.09,0:50:21.51,Default,,0,0,0,,Леви Әйүп Рут, менің артымнан жүр.
Dialogue: 0,0:50:21.72,0:50:22.56,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:50:22.64,0:50:25.73,Default,,0,0,0,,Жұлдызды адамдар сізді кездестіргісі келетін сияқты.
Dialogue: 0,0:50:26.85,0:50:30.36,Default,,0,0,0,,Менің сендерге өтінішім бар еді.
Dialogue: 0,0:50:30.52,0:50:31.69,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:50:32.11,0:50:33.78,Default,,0,0,0,,Қолшатырлар туралы білесің бе?
Dialogue: 0,0:50:33.86,0:50:34.90,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:50:34.99,0:50:37.95,Default,,0,0,0,,Жаңбыр мен қарды жауып тұратын нәрсе
Dialogue: 0,0:50:38.36,0:50:40.74,Default,,0,0,0,,десем де... түсінбеймін.
Dialogue: 0,0:50:40.99,0:50:43.37,Default,,0,0,0,,Мен оны суреттерден көрдім.
Dialogue: 0,0:50:44.95,0:50:50.00,Default,,0,0,0,,Балалар мен сендерге үлкен қолшатыр жасауларыңды қалаймын.
Dialogue: 0,0:50:50.38,0:50:53.71,Default,,0,0,0,,Мен бұрын қолданғанымды жоғалтып алдым.
Dialogue: 0,0:50:54.05,0:50:55.76,Default,,0,0,0,,Сонымен, сіз сыртқа шығасыз ба?
Dialogue: 0,0:50:56.38,0:50:59.30,Default,,0,0,0,,Жоқ, оны ішінде қолданыңыз.
Dialogue: 0,0:50:59.97,0:51:04.72,Default,,0,0,0,,Үлкен қолшатыр қойып, ұрыспайтын жер бар ма?
Dialogue: 0,0:51:05.18,0:51:06.93,Default,,0,0,0,,Бұл жағдайда алаң жақсырақ.
Dialogue: 0,0:51:07.02,0:51:09.19,Default,,0,0,0,,Иә, ол жерде ашуланбайсың.
Dialogue: 0,0:51:31.37,0:51:32.79,Default,,0,0,0,,Дұрыс кесу мүмкін емес
Dialogue: 0,0:51:33.08,0:51:35.46,Default,,0,0,0,,Дұрыс, шамамен осы уақытқа дейін.
Dialogue: 0,0:51:35.55,0:51:38.05,Default,,0,0,0,,Айла - артық қалғаны жеткілікті.
Dialogue: 0,0:51:38.47,0:51:41.34,Default,,0,0,0,,Эй, сен қазір не істеп жатырсың?
Dialogue: 0,0:51:41.47,0:51:43.51,Default,,0,0,0,,Сондықтан бұл қолшатыр, Леви.
Dialogue: 0,0:51:43.60,0:51:45.64,Default,,0,0,0,,Басында айтпадың ба?
Dialogue: 0,0:51:45.72,0:51:49.06,Default,,0,0,0,,«Қолшатырлар жаңбыр мен қарды жауып тұруға арналған», - деді ол.
Dialogue: 0,0:51:49.35,0:51:52.60,Default,,0,0,0,,Бірақ бөлменің ішінде жаңбыр да, қар да жаумайды, сондықтан...
Dialogue: 0,0:51:52.73,0:51:54.11,Default,,0,0,0,,Бұл қолшатыр емес.
Dialogue: 0,0:51:54.23,0:51:55.40,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:51:55.57,0:51:56.53,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:51:56.65,0:51:58.11,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:51:58.61,0:51:59.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:52:00.15,0:52:03.49,Default,,0,0,0,,Мұның не екенін шынымен білгіңіз келе ме?
Dialogue: 0,0:52:03.78,0:52:05.33,Default,,0,0,0,,А... иә
Dialogue: 0,0:52:08.04,0:52:10.21,Default,,0,0,0,,Бұл ғалам
Dialogue: 0,0:52:10.33,0:52:11.41,Default,,0,0,0,,Әлем?
Dialogue: 0,0:52:12.42,0:52:17.67,Default,,0,0,0,,Дәлірек айтсақ, бұл ғаламды бейнелейтін модельдің бөлігі.
Dialogue: 0,0:52:18.00,0:52:22.59,Default,,0,0,0,,Әрине, нағыз ғалам онша кішкентай емес.
Dialogue: 0,0:52:23.18,0:52:25.72,Default,,0,0,0,,Егер ол тым үлкен болса, сіз оны көтере алмайсыз.
Dialogue: 0,0:52:26.14,0:52:28.47,Default,,0,0,0,,Сондықтан мен оны осылай жасаймын.
Dialogue: 0,0:52:28.72,0:52:30.64,Default,,0,0,0,,Ғалам дегеніміз не?
Dialogue: 0,0:52:31.14,0:52:36.02,Default,,0,0,0,,Аспаннан алыс жерде, жұлдыздар орналасқан жерде
Dialogue: 0,0:52:36.52,0:52:38.98,Default,,0,0,0,,Барлық жол қанша?
Dialogue: 0,0:52:39.19,0:52:40.74,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:52:40.90,0:52:43.07,Default,,0,0,0,,Бұл... уф уф
Dialogue: 0,0:52:43.32,0:52:44.28,Default,,0,0,0,,О
Dialogue: 0,0:52:44.49,0:52:45.41,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:52:45.49,0:52:48.37,Default,,0,0,0,,Мен Эзраға телефон соғамын.
Dialogue: 0,0:52:48.79,0:52:51.50,Default,,0,0,0,,Уф, жоқ... жарайды.
Dialogue: 0,0:52:52.29,0:52:54.37,Default,,0,0,0,,Э-э, кешіріңіз
Dialogue: 0,0:52:55.33,0:52:59.59,Default,,0,0,0,,Мен сіздің сұрақтарыңызға жауап бергенді ұнатамын.
Dialogue: 0,0:52:59.84,0:53:04.97,Default,,0,0,0,,А, бірақ мен сіздің сұрағыңызға сәл кейінірек жауап бере аламын ба?
Dialogue: 0,0:53:05.55,0:53:06.43,Default,,0,0,0,,Иә
Dialogue: 0,0:53:07.18,0:53:08.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:53:08.85,0:53:11.68,Default,,0,0,0,,А, қолшатыр жасауды жалғастырайық.
Dialogue: 0,0:53:13.23,0:53:15.85,Default,,0,0,0,,Леви Рут Тезірек!
Dialogue: 0,0:53:15.94,0:53:18.69,Default,,0,0,0,,Қолшатыр аз уақытта бітетініне сенімдімін.
Dialogue: 0,0:53:18.82,0:53:20.15,Default,,0,0,0,,Аюб, қазір ерте.
Dialogue: 0,0:53:20.28,0:53:23.28,Default,,0,0,0,,Егістікте жұмыс істейтін топырақты алып тастау керек.
Dialogue: 0,0:53:23.36,0:53:25.41,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:53:27.95,0:53:28.95,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:53:29.03,0:53:31.87,Default,,0,0,0,,Бұл адам балаларға бірдеңе жасауға мәжбүр етеді.
Dialogue: 0,0:53:32.04,0:53:32.58,Default,,0,0,0,,Әй, анау қария ғой.
Dialogue: 0,0:53:32.58,0:53:33.54,Default,,0,0,0,,Әй, анау қарт.
Dialogue: 0,0:53:32.58,0:53:33.54,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:53:33.54,0:53:33.91,Default,,0,0,0,,Әй, анау қарт.
Dialogue: 0,0:53:34.25,0:53:34.71,Default,,0,0,0,,Сіз мата, ағаш сияқты әртүрлі заттарды пайдаланасыз.
Dialogue: 0,0:53:34.71,0:53:36.00,Default,,0,0,0,,Мата, ағаш сияқты неше түрлі заттарды пайдаланасыз.
Dialogue: 0,0:53:34.71,0:53:36.00,Default,,0,0,0,,Әйүппен не болды?
Dialogue: 0,0:53:36.00,0:53:36.17,Default,,0,0,0,,Мата, ағаш сияқты неше түрлі заттарды пайдаланасыз.
Dialogue: 0,0:53:36.17,0:53:37.00,Default,,0,0,0,,Мата, ағаш сияқты неше түрлі заттарды пайдаланасыз.
Dialogue: 0,0:53:36.17,0:53:37.00,Default,,0,0,0,,(Бір күні сені қолға түсіреміз)
Dialogue: 0,0:53:37.00,0:53:37.83,Default,,0,0,0,,Сіз мата, ағаш сияқты неше түрлі заттарды пайдаланасыз.
Dialogue: 0,0:53:38.13,0:53:42.05,Default,,0,0,0,,Осыншама мата болса, қанша әдемі кимоно тігуге болады?
Dialogue: 0,0:53:42.30,0:53:43.97,Default,,0,0,0,,Тек мата емес
Dialogue: 0,0:53:44.05,0:53:45.93,Default,,0,0,0,,Көп жесең де, ақымақ болма.
Dialogue: 0,0:53:46.13,0:53:49.72,Default,,0,0,0,,Бала өсіре алмайтын қарттарды мәңгілік ұстай алмайсың.
Dialogue: 0,0:53:49.85,0:53:51.60,Default,,0,0,0,,30 жастан кем емес.
Dialogue: 0,0:53:51.60,0:53:52.81,Default,,0,0,0,,30 жастан кем емес.
Dialogue: 0,0:53:51.60,0:53:52.81,Default,,0,0,0,,Ух мм
Dialogue: 0,0:53:52.81,0:53:52.97,Default,,0,0,0,,Ух мм
Dialogue: 0,0:53:54.31,0:53:55.56,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:53:56.73,0:53:57.65,Default,,0,0,0,,Леви?
Dialogue: 0,0:53:57.77,0:53:59.61,Default,,0,0,0,,Жұмыс №!
Dialogue: 0,0:53:59.73,0:54:00.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:54:00.69,0:54:04.32,Default,,0,0,0,,Біз ересектерге қиын екенін білеміз, солай ма?
Dialogue: 0,0:54:04.69,0:54:07.45,Default,,0,0,0,,Сонда да бұлай айтуға амал жоқ.
Dialogue: 0,0:54:08.41,0:54:09.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:54:10.28,0:54:11.83,Default,,0,0,0,,Эзра әрқашан
Dialogue: 0,0:54:11.91,0:54:14.96,Default,,0,0,0,,Онда «Мұқтаждарға көмектес» деп жазылған.
Dialogue: 0,0:54:16.00,0:54:20.25,Default,,0,0,0,,Сонда үлкендер неге осылай айтады?
Dialogue: 0,0:54:21.09,0:54:23.84,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:54:23.92,0:54:24.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:30.89,0:54:32.01,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:54:32.39,0:54:33.52,Default,,0,0,0,,Ах~
Dialogue: 0,0:54:33.97,0:54:36.02,Default,,0,0,0,,Біртүрлі сезіледі~
Dialogue: 0,0:54:36.48,0:54:40.65,Default,,0,0,0,,Сіз бірінші рет өте жақсы қолшатыр жасадыңыз.
Dialogue: 0,0:54:42.07,0:54:43.98,Default,,0,0,0,,Иә, тамаша.
Dialogue: 0,0:54:44.07,0:54:45.36,Default,,0,0,0,,Ахаха
Dialogue: 0,0:54:45.53,0:54:46.90,Default,,0,0,0,,Леви Әйүп
Dialogue: 0,0:54:47.07,0:54:49.95,Default,,0,0,0,,Қолшатырдың астына қараңғы перде ілу ғана қалды.
Dialogue: 0,0:54:50.24,0:54:53.28,Default,,0,0,0,,Ішке жарық түспейтініне көз жеткізіңіз.
Dialogue: 0,0:54:53.62,0:54:54.83,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:54:55.33,0:54:58.67,Default,,0,0,0,,Осыған дайындалайық, Руфь.
Dialogue: 0,0:54:58.96,0:54:59.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:00.92,0:55:02.21,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:55:02.50,0:55:05.76,Default,,0,0,0,,Майдың көптігі де, азы да жақсы емес.
Dialogue: 0,0:55:06.09,0:55:07.34,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:55:07.47,0:55:08.30,Default,,0,0,0,,Иә
Dialogue: 0,0:55:08.76,0:55:11.47,Default,,0,0,0,,Жұмыс, бос орын қалдыр, бұл жақсы емес.
Dialogue: 0,0:55:11.55,0:55:13.26,Default,,0,0,0,,Сіз білесіз.
Dialogue: 0,0:55:13.35,0:55:14.85,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:55:15.10,0:55:16.27,Default,,0,0,0,,Мен сені кез келген уақытта ауыстыра аламын.
Dialogue: 0,0:55:16.43,0:55:18.98,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:55:19.10,0:55:21.19,Default,,0,0,0,,Ол Левиге қарағанда шебер.
Dialogue: 0,0:55:21.31,0:55:22.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:22.81,0:55:26.65,Default,,0,0,0,,Проекторлар әрқашан тапқыр.
Dialogue: 0,0:55:26.82,0:55:31.45,Default,,0,0,0,,Бұл әрқашан нашар және көп жұмысты қажет етеді.
Dialogue: 0,0:55:31.82,0:55:35.49,Default,,0,0,0,,Кез келген дәуірдің кез келген проекторы.
Dialogue: 0,0:55:35.91,0:55:39.12,Default,,0,0,0,,О, бірақ сіз өте жақсы араласасыз.
Dialogue: 0,0:55:39.21,0:55:40.83,Default,,0,0,0,,Демон Көзі: Тағдырды анықтау.
Dialogue: 0,0:55:41.00,0:55:41.83,Default,,0,0,0,,О
Dialogue: 0,0:55:42.17,0:55:43.84,Default,,0,0,0,,Иә, оны сонда іліңіз.
Dialogue: 0,0:55:43.92,0:55:46.42,Default,,0,0,0,,Бұрынғы серіппелі бөлікті қолдайды.
Dialogue: 0,0:55:47.26,0:55:48.09,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:55:48.38,0:55:49.97,Default,,0,0,0,,Иә, тамаша жұмыс.
Dialogue: 0,0:55:50.09,0:55:51.01,Default,,0,0,0,,Ахаха
Dialogue: 0,0:55:51.47,0:55:52.80,Default,,0,0,0,,Олай болса, енді не болады?
Dialogue: 0,0:55:53.01,0:55:55.68,Default,,0,0,0,,Осы кітапты қарап отырып, оны өзім құрастырып көрейін бе?
Dialogue: 0,0:55:55.89,0:55:58.81,Default,,0,0,0,,Не? Бұл мүмкін емес
Dialogue: 0,0:55:59.27,0:56:00.73,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:56:00.98,0:56:04.19,Default,,0,0,0,,Мен сені қадағалаймын, ендеше байқап көрейік.
Dialogue: 0,0:56:04.77,0:56:09.19,Default,,0,0,0,,Жарайды, бұл менің қолжазбам, сондықтан оны оқу қиын шығар.
Dialogue: 0,0:56:09.49,0:56:12.20,Default,,0,0,0,,Менің жазуым өте таза емес.
Dialogue: 0,0:56:12.36,0:56:15.70,Default,,0,0,0,,Ах... хехехе
Dialogue: 0,0:56:16.16,0:56:17.83,Default,,0,0,0,,Иә, мен тырысамын.
Dialogue: 0,0:56:18.16,0:56:19.00,Default,,0,0,0,,Ei Ei
Dialogue: 0,0:56:19.08,0:56:23.92,Default,,0,0,0,,Егер сіз жай ғана шамды және қозғалтқышты іске қосқыңыз келсе, оны бар болғаны 5 минут іске қосу керек.
Dialogue: 0,0:56:24.25,0:56:27.92,Default,,0,0,0,,Егер ол жеткіліксіз болса, оны жартылай айналдыру арқылы қосуға болады.
Dialogue: 0,0:56:28.25,0:56:29.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:29.26,0:56:30.76,Default,,0,0,0,,Мен сенің орныңды аламын ба?
Dialogue: 0,0:56:31.34,0:56:33.47,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:56:33.72,0:56:38.68,Default,,0,0,0,,Иә, мен оны орындағаннан кейін сынап көремін.
Dialogue: 0,0:56:38.93,0:56:40.35,Default,,0,0,0,,Ах~ Ахахах
Dialogue: 0,0:56:43.81,0:56:46.48,Default,,0,0,0,,Эх~ Хехе... Хехехе
Dialogue: 0,0:56:54.20,0:56:56.03,Default,,0,0,0,,Мына дөңгелек нәрсе не?
Dialogue: 0,0:56:56.45,0:56:57.66,Default,,0,0,0,,Бұл ай
Dialogue: 0,0:56:58.41,0:57:02.66,Default,,0,0,0,,Бұл түнгі аспандағы өте жарқын және үлкен қатысу.
Dialogue: 0,0:57:02.66,0:57:03.46,Default,,0,0,0,,Бұл түнгі аспандағы өте жарқын және үлкен қатысу.
Dialogue: 0,0:57:02.66,0:57:03.46,Default,,0,0,0,,Ах~
Dialogue: 0,0:57:03.46,0:57:04.54,Default,,0,0,0,,Ах~
Dialogue: 0,0:57:05.96,0:57:06.79,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:57:10.09,0:57:11.80,Default,,0,0,0,,Ах... уау~
Dialogue: 0,0:57:16.14,0:57:18.22,Default,,0,0,0,,Бұл... жұлдыз ба?
Dialogue: 0,0:57:21.27,0:57:22.68,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:57:23.48,0:57:25.31,Default,,0,0,0,,Өйткені бұл осылай...
Dialogue: 0,0:57:25.77,0:57:27.36,Default,,0,0,0,,Тым әдемі
Dialogue: 0,0:57:27.56,0:57:28.40,Default,,0,0,0,,Иә
Dialogue: 0,0:57:33.28,0:57:34.11,Default,,0,0,0,,Эй
Dialogue: 0,0:57:34.99,0:57:38.16,Default,,0,0,0,,Олар неге сонша ұқыпты тізіліп тұр?
Dialogue: 0,0:57:38.95,0:57:41.87,Default,,0,0,0,,Басқа жердегі жұлдыздар сирек болса да
Dialogue: 0,0:57:42.33,0:57:46.96,Default,,0,0,0,,Сұлулықтан тынысымды тартқаннан кейін мен көбірек білгім келеді
Dialogue: 0,0:57:46.96,0:57:48.04,Default,,0,0,0,,Сұлулықтан тынысымды тартқаннан кейін мен көбірек білгім келеді
Dialogue: 0,0:57:46.96,0:57:48.04,Default,,0,0,0,,Ол жақта да бір адам тізіліп тұр.
Dialogue: 0,0:57:48.04,0:57:48.84,Default,,0,0,0,,Ол жақта да қатар тұрғандар бар.
Dialogue: 0,0:57:48.84,0:57:49.09,Default,,0,0,0,,Сол жерде де бір адам тізіліп тұр.
Dialogue: 0,0:57:48.84,0:57:49.09,Default,,0,0,0,,Менің де есімде.
Dialogue: 0,0:57:49.09,0:57:49.84,Default,,0,0,0,,Менің де есімде.
Dialogue: 0,0:57:49.84,0:57:51.05,Default,,0,0,0,,Менің де есімде.
Dialogue: 0,0:57:49.84,0:57:51.05,Default,,0,0,0,,Бұл Еремия еді...
Dialogue: 0,0:57:51.17,0:57:51.42,Default,,0,0,0,,Бұл ашуланған кездегі позаға ұқсайды.
Dialogue: 0,0:57:51.42,0:57:53.34,Default,,0,0,0,,Бұл ашуланған кездегі позаға ұқсайды.
Dialogue: 0,0:57:51.42,0:57:53.34,Default,,0,0,0,,Мен сіздің сұрақтарыңызға мүмкіндігімше жауап беремін.
Dialogue: 0,0:57:53.34,0:57:55.13,Default,,0,0,0,,Мен сіздің сұрақтарыңызға мүмкіндігімше жауап беремін.
Dialogue: 0,0:57:55.63,0:57:57.18,Default,,0,0,0,,Бір-бірден барайық
Dialogue: 0,0:57:57.84,0:57:59.64,Default,,0,0,0,,Біріншіден, Леви туралы сұрақ.
Dialogue: 0,0:58:00.72,0:58:04.81,Default,,0,0,0,,Бір нәрсеге ұқсайтын тізілген жұлдыздар шоқжұлдыз деп аталады.
Dialogue: 0,0:58:05.35,0:58:06.98,Default,,0,0,0,,Ежелгі адамдар...
Dialogue: 0,0:58:13.44,0:58:16.24,Default,,0,0,0,,Міне, бүгінгі күн осымен бітті.
Dialogue: 0,0:58:16.36,0:58:18.24,Default,,0,0,0,,Тағы сәл ғана өтінемін
Dialogue: 0,0:58:18.41,0:58:21.08,Default,,0,0,0,,Жұлдыздар туралы көбірек айтып беріңізші.
Dialogue: 0,0:58:21.41,0:58:22.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:58:22.70,0:58:25.79,Default,,0,0,0,,Енді бір-бірімізді қашан көретінімізді білмейміз.
Dialogue: 0,0:58:26.21,0:58:28.58,Default,,0,0,0,,Ертең тағы да далада жұмыс істеуім керек.
Dialogue: 0,0:58:29.25,0:58:30.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:58:30.71,0:58:34.01,Default,,0,0,0,,Үшеулерің бір сәт көздеріңді жұмыңдар.
Dialogue: 0,0:58:34.13,0:58:35.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:37.22,0:58:41.89,Default,,0,0,0,,Олай болса бұрын көрген жұлдызды аспанды елестетіңіз.
Dialogue: 0,0:58:53.02,0:58:53.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:53.94,0:58:55.40,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:58:55.49,0:58:56.32,Default,,0,0,0,,Ах~
Dialogue: 0,0:58:56.40,0:59:00.16,Default,,0,0,0,,Бір рет көрсең, ешқашан ұмытпайсың
Dialogue: 0,0:59:00.99,0:59:05.58,Default,,0,0,0,,Жұлдыздар осындай.
Dialogue: 0,0:59:07.75,0:59:09.42,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:59:09.50,0:59:10.71,Default,,0,0,0,,Қайырлы түн~
Dialogue: 0,0:59:10.79,0:59:11.83,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:59:17.30,0:59:19.30,Default,,0,0,0,,Гохо у...
Dialogue: 0,0:59:23.76,0:59:24.97,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:59:25.06,0:59:25.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:59:26.35,0:59:27.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:27.43,0:59:29.81,Default,,0,0,0,,О, сен бе?
Dialogue: 0,0:59:31.23,0:59:33.52,Default,,0,0,0,,Жұлдыздарға қарағың келе ме?
Dialogue: 0,0:59:34.15,0:59:37.86,Default,,0,0,0,,Кейінірек басқалармен кездескенше
Dialogue: 0,0:59:38.82,0:59:40.61,Default,,0,0,0,,Одан гөрі қазіргі жөтел
Dialogue: 0,0:59:40.91,0:59:42.70,Default,,0,0,0,,Менде өкпе ауруы бар
Dialogue: 0,0:59:43.74,0:59:45.16,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:59:45.79,0:59:49.00,Default,,0,0,0,,Мен мұндай әлемде тым ұзақ өмір сүрдім.
Dialogue: 0,0:59:49.25,0:59:50.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:50.42,0:59:54.04,Default,,0,0,0,,Менімен көп жыл бірге болғандарыңызға рахмет.
Dialogue: 0,0:59:54.34,0:59:56.88,Default,,0,0,0,,Мен өз денем үшін өте ризамын.
Dialogue: 0,0:59:57.96,1:00:00.43,Default,,0,0,0,,Мүмкін болса, сәл көбірек
Dialogue: 0,1:00:02.14,1:00:05.47,Default,,0,0,0,,Жұлдыздарды көруге келмесең, мақсатың не еді?
Dialogue: 0,1:00:05.72,1:00:07.27,Default,,0,0,0,,Егер біреу қате әрекет етсе — тіпті ол жай ғана апаттық жағдай болса да —
Dialogue: 0,1:00:07.93,1:00:11.64,Default,,0,0,0,,Мен сенімен сән-салтанат алғым келеді.
Dialogue: 0,1:00:12.90,1:00:14.56,Default,,0,0,0,,Мен бұл үшін ризамын.
Dialogue: 0,1:00:18.11,1:00:21.86,Default,,0,0,0,,Иә, а~ Біраз уақыт өтті.
Dialogue: 0,1:00:22.45,1:00:26.24,Default,,0,0,0,,Аха... Сіз керемет нәрсе жасапсыз.
Dialogue: 0,1:00:26.99,1:00:29.79,Default,,0,0,0,,Бұл балалар, мен олардың осыншама құмар екеніне сене алар емеспін
Dialogue: 0,1:00:30.16,1:00:33.54,Default,,0,0,0,,Олар өте түзу өседі.
Dialogue: 0,1:00:34.33,1:00:36.96,Default,,0,0,0,,Бұл керемет сияқты
Dialogue: 0,1:00:37.67,1:00:41.22,Default,,0,0,0,,Басқа тұрғын үй-жайлар соншалықты нашар болды ма?
Dialogue: 0,1:00:42.09,1:00:46.30,Default,,0,0,0,,Кейбір елді мекендер сырттан келгендердің барлығын жау санады.
Dialogue: 0,1:00:46.97,1:00:50.73,Default,,0,0,0,,Олардың ойы тек жұптау болатын жерлер болды.
Dialogue: 0,1:00:51.52,1:00:53.73,Default,,0,0,0,,Салыстырмалы түрде, мұнда—
Dialogue: 0,1:00:54.15,1:00:56.86,Default,,0,0,0,,Белгілі бір реттілік пен жарықтық бар
Dialogue: 0,1:00:57.52,1:01:01.69,Default,,0,0,0,,Мына ымырт әлемінде бұл ең қымбат нәрсе...
Dialogue: 0,1:01:01.82,1:01:04.07,Default,,0,0,0,,Алтын тамшы дейік.
Dialogue: 0,1:01:04.32,1:01:05.91,Default,,0,0,0,,Егер солай десеңіз.
Dialogue: 0,1:01:06.03,1:01:09.12,Default,,0,0,0,,Біздің тынымсыз еңбегіміздің қайтарымы болатынын сеземін.
Dialogue: 0,1:01:09.91,1:01:13.92,Default,,0,0,0,,Бірақ, өздеріңіз білесіздер, егер біз осы ауылда осылай қалсақ...
Dialogue: 0,1:01:14.04,1:01:16.13,Default,,0,0,0,,Ол балалардың болашағы жоқ.
Dialogue: 0,1:01:16.63,1:01:17.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:18.29,1:01:22.38,Default,,0,0,0,,Ауыл бастығы, сізге бір өтінішім бар.
Dialogue: 0,1:01:23.42,1:01:24.47,Default,,0,0,0,,Не?
Dialogue: 0,1:01:26.01,1:01:30.68,Default,,0,0,0,,Сол балаларды маған қалдыра аласыз ба?
Dialogue: 0,1:01:31.02,1:01:34.23,Default,,0,0,0,,Мен оны мұрагер етіп өсіргім келеді.
Dialogue: 0,1:01:36.10,1:01:40.82,Default,,0,0,0,,Олардың жұлдыздық қасиеттері маған қарағанда көбірек.
Dialogue: 0,1:01:41.53,1:01:43.86,Default,,0,0,0,,Ақылды, қарапайым және таза
Dialogue: 0,1:01:44.20,1:01:48.70,Default,,0,0,0,,Сондай-ақ, бұл балалардың болашағын ашуға мүмкіндік береді.
Dialogue: 0,1:01:49.08,1:01:51.20,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,1:01:57.88,1:02:01.92,Default,,0,0,0,,Ертең ауылдың үлкендері жиналады.
Dialogue: 0,1:02:02.46,1:02:04.63,Default,,0,0,0,,Онда жиналыс жасайық.
Dialogue: 0,1:02:05.59,1:02:09.97,Default,,0,0,0,,Дегенмен, ауыл тұрғындары оны қабылдаса да,
Dialogue: 0,1:02:10.18,1:02:12.77,Default,,0,0,0,,Түптеп келгенде, сол балалар шешеді.
Dialogue: 0,1:02:13.56,1:02:16.81,Default,,0,0,0,,Әрине, рахмет.
Dialogue: 0,1:02:24.86,1:02:27.41,Default,,0,0,0,,Әйүп Оян, Әйүп!
Dialogue: 0,1:02:27.53,1:02:28.36,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,1:02:28.45,1:02:30.28,Default,,0,0,0,,Юбе Үшеуміз шештік.
Dialogue: 0,1:02:30.37,1:02:31.66,Default,,0,0,0,,Жүр, тезірек!
Dialogue: 0,1:02:31.74,1:02:32.91,Default,,0,0,0,,О! О
Dialogue: 0,1:02:35.75,1:02:36.62,Default,,0,0,0,,Әй?
Dialogue: 0,1:02:36.91,1:02:38.50,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:02:38.58,1:02:39.92,Default,,0,0,0,,Еремия! Уа!
Dialogue: 0,1:02:40.13,1:02:41.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:02:41.34,1:02:43.00,Default,,0,0,0,,Кез келген нәрсе, атап айтқанда...
Dialogue: 0,1:02:43.25,1:02:45.97,Default,,0,0,0,,Менің ойымша, сіз еркелік ойнауға тырыспайсыз.
Dialogue: 0,1:02:46.13,1:02:47.51,Default,,0,0,0,,Мен жасамаймын
Dialogue: 0,1:02:47.63,1:02:49.84,Default,,0,0,0,,Біз маңызды пікірталас болғалы жатырмыз.
Dialogue: 0,1:02:49.93,1:02:51.55,Default,,0,0,0,,Өз бетіңізше далаға шықпаңыз
Dialogue: 0,1:02:51.64,1:02:53.01,Default,,0,0,0,,Біз де келеміз бе?
Dialogue: 0,1:02:53.14,1:02:55.31,Default,,0,0,0,,Жоқ, тек ересектер.
Dialogue: 0,1:02:55.60,1:02:58.77,Default,,0,0,0,,Жағдайға байланысты сіздің шеберіңіз де шақырылуы мүмкін.
Dialogue: 0,1:02:58.90,1:03:00.23,Default,,0,0,0,,Ишая Ах...
Dialogue: 0,1:03:00.61,1:03:03.48,Default,,0,0,0,,Мүмкін барлығына да жұлдыздар көрсетілетін шығар?
Dialogue: 0,1:03:03.78,1:03:05.90,Default,,0,0,0,,Енді мен білмеймін.
Dialogue: 0,1:03:06.19,1:03:08.11,Default,,0,0,0,,Леви Рут, кеттік.
Dialogue: 0,1:03:08.20,1:03:10.57,Default,,0,0,0,,Иә, сәл ғана.
Dialogue: 0,1:03:10.70,1:03:12.24,Default,,0,0,0,,Көшеге шықпаңыз
Dialogue: 0,1:03:12.33,1:03:14.24,Default,,0,0,0,,Міндетті түрде ертерек оралыңыз.
Dialogue: 0,1:03:14.33,1:03:15.50,Default,,0,0,0,,Иә
Dialogue: 0,1:03:26.63,1:03:27.63,Default,,0,0,0,,Иә? Иә
Dialogue: 0,1:03:28.01,1:03:29.01,Default,,0,0,0,,Иә? Иә
Dialogue: 0,1:03:30.80,1:03:32.47,Default,,0,0,0,,Уф гохо...
Dialogue: 0,1:03:40.23,1:03:41.06,Default,,0,0,0,,Бұл
Dialogue: 0,1:03:41.15,1:03:41.98,Default,,0,0,0,,Әй?
Dialogue: 0,1:03:42.86,1:03:45.19,Default,,0,0,0,,Балалар сендер кіресіңдер ме?
Dialogue: 0,1:03:45.82,1:03:46.65,Default,,0,0,0,,Иә
Dialogue: 0,1:03:48.36,1:03:52.07,Default,,0,0,0,,Ум, біздің өтінішіміз бар.
Dialogue: 0,1:03:52.70,1:03:54.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:03:56.33,1:03:57.16,Default,,0,0,0,,Иә
Dialogue: 0,1:03:57.83,1:03:58.87,Default,,0,0,0,,Біз (Әйүп Рут) қызметшілеріміз
Dialogue: 0,1:03:58.96,1:04:00.62,Default,,0,0,0,,Мен жұлдызды адам болғым келеді!
Dialogue: 0,1:04:02.88,1:04:06.17,Default,,0,0,0,,Мен Руттың жұлдыздарды көрсететін машина жасай алатынына сенімдімін.
Dialogue: 0,1:04:06.38,1:04:08.13,Default,,0,0,0,,Сіз оған қамқорлық жасай аласыз, солай ма?
Dialogue: 0,1:04:08.26,1:04:09.09,Default,,0,0,0,,Иә
Dialogue: 0,1:04:09.59,1:04:11.93,Default,,0,0,0,,Ал шанамен басқа ауылға бару...
Dialogue: 0,1:04:12.01,1:04:14.35,Default,,0,0,0,,Әйүп осында болғанша, бәрі жақсы болады.
Dialogue: 0,1:04:14.64,1:04:17.56,Default,,0,0,0,,Содан кейін барлығына жұлдыздар туралы айту ...
Dialogue: 0,1:04:17.64,1:04:19.73,Default,,0,0,0,,Мен мұны істеймін деп ойлаймын...
Dialogue: 0,1:04:20.43,1:04:22.85,Default,,0,0,0,,Бірақ біз көбірек білуіміз керек...
Dialogue: 0,1:04:22.94,1:04:24.27,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын.
Dialogue: 0,1:04:24.86,1:04:26.69,Default,,0,0,0,,Сонымен, біз—
Dialogue: 0,1:04:26.77,1:04:29.94,Default,,0,0,0,,Мен лайықты жұлдыз болғанша маған үйреткеніңізді қалаймын.
Dialogue: 0,1:04:30.70,1:04:33.87,Default,,0,0,0,,Мен де айырбасқа бірдеңе әкелдім.
Dialogue: 0,1:04:34.82,1:04:36.78,Default,,0,0,0,,Біздің қазынамыз
Dialogue: 0,1:04:38.24,1:04:41.33,Default,,0,0,0,,Бұл жеткіліксіз болуы мүмкін, бірақ
Dialogue: 0,1:04:53.59,1:04:55.76,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,1:04:56.26,1:04:57.81,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,1:04:57.93,1:04:59.27,Default,,0,0,0,,Шынымен бе? Уау
Dialogue: 0,1:04:59.68,1:05:03.60,Default,,0,0,0,,Алайда менің де бір өтінішім бар.
Dialogue: 0,1:05:03.77,1:05:04.73,Default,,0,0,0,,Өтінемін?
Dialogue: 0,1:05:05.48,1:05:06.31,Default,,0,0,0,,Әй?
Dialogue: 0,1:05:07.27,1:05:10.32,Default,,0,0,0,,Мен оны алғаныңызды қалаймын.
Dialogue: 0,1:05:11.49,1:05:14.20,Default,,0,0,0,,Бұл менің қазынам
Dialogue: 0,1:05:15.70,1:05:19.41,Default,,0,0,0,,Бұл өмірді өзгертеді.
Dialogue: 0,1:05:20.66,1:05:22.58,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,1:05:23.46,1:05:26.54,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,1:05:26.75,1:05:29.21,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,1:05:29.84,1:05:30.71,Default,,0,0,0,,Жұлдыздарға толы аспанда...
Dialogue: 0,1:05:30.80,1:05:32.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:05:32.97,1:05:34.55,Default,,0,0,0,,Сәлеметсіз бе, тұтынушы
Dialogue: 0,1:05:34.93,1:05:36.39,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,1:05:36.72,1:05:38.89,Default,,0,0,0,,Жақсы емес, бірақ жаман да емес
Dialogue: 0,1:05:39.35,1:05:40.43,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:05:40.81,1:05:43.56,Default,,0,0,0,,Егер сіз әлі де өзіңізді жақсы сезінбесеңіз
Dialogue: 0,1:05:43.64,1:05:44.56,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:05:45.14,1:05:46.94,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,1:05:47.77,1:05:49.40,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:05:49.90,1:05:53.40,Default,,0,0,0,,Толық емес проекция үшін кешірім сұраймыз.
Dialogue: 0,1:05:54.11,1:05:56.03,Default,,0,0,0,,Шын жүректен кешірім сұраймыз.
Dialogue: 0,1:05:56.82,1:05:57.66,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:05:58.49,1:06:01.37,Default,,0,0,0,,Проекцияңыз жаман болған жоқ.
Dialogue: 0,1:06:02.79,1:06:05.25,Default,,0,0,0,,Мен сіздің мақтауыңызды алғаныма өте қуаныштымын.
Dialogue: 0,1:06:05.96,1:06:09.46,Default,,0,0,0,,Сонымен қатар, біз тұтынушыларымыздан көп көмек алдық.
Dialogue: 0,1:06:10.50,1:06:13.63,Default,,0,0,0,,Эй, сен...
Dialogue: 0,1:06:16.72,1:06:17.76,Default,,0,0,0,,Не?
Dialogue: 0,1:06:19.22,1:06:20.39,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,1:06:21.43,1:06:22.85,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,1:06:23.06,1:06:23.89,Default,,0,0,0,,Иә
Dialogue: 0,1:06:23.98,1:06:26.06,Default,,0,0,0,,Барлығы үшін көп рахмет.
Dialogue: 0,1:06:26.19,1:06:30.02,Default,,0,0,0,,Роботтардың Құдайы, үйге тірі оралуым үшін дұға етіңіз.
Dialogue: 0,1:06:30.40,1:06:31.23,Default,,0,0,0,,Иә
Dialogue: 0,1:06:49.00,1:06:50.38,Default,,0,0,0,,Тұтынушы (Кусуя) Иә?
Dialogue: 0,1:06:52.88,1:06:55.92,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге сұрақ қоя аламын ба?
Dialogue: 0,1:06:56.51,1:06:57.34,Default,,0,0,0,,Не?
Dialogue: 0,1:06:57.55,1:07:00.51,Default,,0,0,0,,Үйге қайтып бара жатқанда қауіп бар ма?
Dialogue: 0,1:07:00.80,1:07:03.31,Default,,0,0,0,,Жоқ десем өтірік айтқан болар едім.
Dialogue: 0,1:07:03.85,1:07:06.89,Default,,0,0,0,,Үйге бара жатқанда пойызға отырғыңыз келе ме?
Dialogue: 0,1:07:07.35,1:07:10.48,Default,,0,0,0,,Пойыз жүрмейді, себебі электр қуаты өшіп қалды.
Dialogue: 0,1:07:11.15,1:07:15.19,Default,,0,0,0,,Сонымен, үйге автобуспен, таксимен немесе көлікпен барғыңыз келе ме?
Dialogue: 0,1:07:15.57,1:07:17.70,Default,,0,0,0,,Машина... Менің ойымша.
Dialogue: 0,1:07:18.15,1:07:20.41,Default,,0,0,0,,Сіздің көлігіңіз қайда қойылған?
Dialogue: 0,1:07:20.66,1:07:23.41,Default,,0,0,0,,Бұл жерден 3 километр радиуста ма?
Dialogue: 0,1:07:25.04,1:07:26.66,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,1:07:28.41,1:07:30.21,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,1:07:32.50,1:07:33.84,Default,,0,0,0,,Қолдау орталығына—
Dialogue: 0,1:07:33.92,1:07:37.88,Default,,0,0,0,,Мен еңбек ережелерінің арнайы ережелеріне негізделген іс-қимыл нұсқаулығына сұраныс жібердім.
Dialogue: 0,1:07:38.09,1:07:39.55,Default,,0,0,0,,Қабылданбаған
Dialogue: 0,1:07:40.34,1:07:41.80,Default,,0,0,0,,Демек, бұдан былай —
Dialogue: 0,1:07:41.89,1:07:45.43,Default,,0,0,0,,Мен өз пікірім бойынша әрекет етемін.
Dialogue: 0,1:07:45.68,1:07:46.52,Default,,0,0,0,,О
Dialogue: 0,1:07:48.52,1:07:51.65,Default,,0,0,0,,Мен сені көлігіңе дейін ертіп барамын.
Dialogue: 0,1:07:52.06,1:07:52.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:53.56,1:07:55.98,Default,,0,0,0,,Науқас адамды шығарып салу...
Dialogue: 0,1:07:56.19,1:07:58.78,Default,,0,0,0,,Бұл біздің робот ретіндегі рөліміз.
Dialogue: 0,1:07:59.57,1:08:01.24,Default,,0,0,0,,Иә? Есіңіз дұрыс па?
Dialogue: 0,1:08:02.11,1:08:02.95,Default,,0,0,0,,Жоқ
Dialogue: 0,1:08:03.20,1:08:05.24,Default,,0,0,0,,Сәл сынған
Dialogue: 0,1:08:10.21,1:08:11.96,Default,,0,0,0,,Жаяу 2-3 шақырымдай
Dialogue: 0,1:08:12.71,1:08:14.96,Default,,0,0,0,,Батареяңыз қанша уақытқа жетеді?
Dialogue: 0,1:08:15.84,1:08:20.05,Default,,0,0,0,,Иә, егер сіз ағымдағы жұмыс режимінде болсаңыз, тағы 4 күн жұмыс істей аласыз.
Dialogue: 0,1:08:20.55,1:08:22.18,Default,,0,0,0,,Сонда үйге бару қиын емес.
Dialogue: 0,1:08:22.84,1:08:23.68,Default,,0,0,0,,Иә
Dialogue: 0,1:08:23.97,1:08:24.97,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,1:08:25.43,1:08:26.72,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,1:08:27.68,1:08:28.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:29.27,1:08:30.10,Default,,0,0,0,,Эй
Dialogue: 0,1:08:36.73,1:08:38.98,Default,,0,0,0,,Қадамдар бар екенін ескеріңіз.
Dialogue: 0,1:08:41.57,1:08:43.20,Default,,0,0,0,,Тұтынушыны қараңыз
Dialogue: 0,1:08:43.61,1:08:45.87,Default,,0,0,0,,Бұл дүкендегі ванильді кілегейлі пуф:
Dialogue: 0,1:08:45.95,1:08:49.12,Default,,0,0,0,,Бұл өте танымал және әрқашан сызық бар.
Dialogue: 0,1:08:51.37,1:08:54.29,Default,,0,0,0,,Кремді ұнтақты ұнатасыз ба?
Dialogue: 0,1:08:54.58,1:08:56.96,Default,,0,0,0,,Ұнасаң да, ұнатпасаң да жеген жоқсың.
Dialogue: 0,1:08:57.29,1:09:00.17,Default,,0,0,0,,Оның орнына, мен сіздің басшылығыңызды бағалаймын, сондықтан тезірек жүріңіз.
Dialogue: 0,1:09:00.42,1:09:01.34,Default,,0,0,0,,Мен асығыспын.
Dialogue: 0,1:09:01.63,1:09:03.43,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:09:06.89,1:09:07.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:09.35,1:09:10.31,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:09:10.68,1:09:12.31,Default,,0,0,0,,Осы ғимараттың 5-қабатында—
Dialogue: 0,1:09:12.39,1:09:14.73,Default,,0,0,0,,Біздің әмбебап дүкенге қарасты сыра залы бар.
Dialogue: 0,1:09:15.23,1:09:17.06,Default,,0,0,0,,Жаңа піскен теңіз өнімдерімен—
Dialogue: 0,1:09:17.15,1:09:18.90,Default,,0,0,0,,Әртүрлі жергілікті сыралардан ләззат алыңыз
Dialogue: 0,1:09:19.02,1:09:22.78,Default,,0,0,0,,Өтінемін, сөйлесуді тоқтатып, тезірек жүріңіз.
Dialogue: 0,1:09:23.70,1:09:25.41,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:09:26.41,1:09:27.83,Default,,0,0,0,,(Дененің қалыптан тыс дыбысы)
Dialogue: 0,1:09:28.58,1:09:31.16,Default,,0,0,0,,А, м... тұтынушы
Dialogue: 0,1:09:31.37,1:09:33.87,Default,,0,0,0,,Иә? Тағы үзіліс пе?
Dialogue: 0,1:09:34.17,1:09:35.00,Default,,0,0,0,,Иә
Dialogue: 0,1:09:35.08,1:09:38.46,Default,,0,0,0,,Негізгі қуат блогы қазір қызып жатыр.
Dialogue: 0,1:09:38.79,1:09:40.13,Default,,0,0,0,,Салқындату қажет
Dialogue: 0,1:09:40.63,1:09:41.46,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:45.89,1:09:48.05,Default,,0,0,0,,Жаңбыр өте жақсы жауады.
Dialogue: 0,1:09:52.47,1:09:53.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:54.69,1:09:55.56,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:09:56.98,1:09:58.69,Default,,0,0,0,,Айтпақшы, тапсырыс беруші...
Dialogue: 0,1:09:58.77,1:10:01.07,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,1:10:02.53,1:10:03.15,Default,,0,0,0,,Бұл қоқыс дүкені.
Dialogue: 0,1:10:03.99,1:10:05.57,Default,,0,0,0,,Егер сіз...
Dialogue: 0,1:10:06.28,1:10:11.08,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл қоқыс жинау бизнесі сияқты.
Dialogue: 0,1:10:12.04,1:10:13.75,Default,,0,0,0,,Сіз қалдықтарды жинау бизнесімен айналысасыз ба?
Dialogue: 0,1:10:14.04,1:10:16.50,Default,,0,0,0,,Бұл өте құрметті жұмыс.
Dialogue: 0,1:10:17.08,1:10:18.42,Default,,0,0,0,,Менің денем-
Dialogue: 0,1:10:18.50,1:10:21.63,Default,,0,0,0,,Ол қайта өңдеу мүмкіндігін ескере отырып жасалған...
Dialogue: 0,1:10:21.71,1:10:22.88,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,1:10:24.42,1:10:25.30,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:10:25.67,1:10:27.47,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,1:10:29.01,1:10:30.30,Default,,0,0,0,,Бұл нәрсені қалдырыңыз.
Dialogue: 0,1:10:30.76,1:10:31.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:31.81,1:10:35.35,Default,,0,0,0,,«Анау» дегенде мына гүл шоғын айтасыз ба?
Dialogue: 0,1:10:35.73,1:10:36.56,Default,,0,0,0,,Иә.
Dialogue: 0,1:10:36.89,1:10:39.27,Default,,0,0,0,,Егер сіз сол затты алып жүрсеңіз, құлауыңыз ықтимал.
Dialogue: 0,1:10:39.65,1:10:42.15,Default,,0,0,0,,Бірақ бұл сенікі, сондықтан
Dialogue: 0,1:10:42.23,1:10:43.23,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:10:44.82,1:10:46.28,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,1:10:47.15,1:10:48.91,Default,,0,0,0,,Бұл гүл шоғы менікі.
Dialogue: 0,1:10:49.32,1:10:50.66,Default,,0,0,0,,Ендеше оны маған беріңіз
Dialogue: 0,1:10:51.20,1:10:52.03,Default,,0,0,0,,Иә
Dialogue: 0,1:10:54.29,1:10:56.62,Default,,0,0,0,,Өтінемін, бұл сенің гүл шоғың.
Dialogue: 0,1:10:59.29,1:11:00.83,Default,,0,0,0,,Бұл менің гүл шоғым ба?
Dialogue: 0,1:11:07.47,1:11:08.88,Default,,0,0,0,,Бұл ликер дүкені ме?
Dialogue: 0,1:11:09.43,1:11:10.51,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:11:10.76,1:11:12.55,Default,,0,0,0,,Мен сұрасам болады ма?
Dialogue: 0,1:11:13.06,1:11:16.85,Default,,0,0,0,,Бұл көліктің соқтығысуы немесе газдың жарылуы сияқты апат па?
Dialogue: 0,1:11:17.52,1:11:20.69,Default,,0,0,0,,Ұрысқа араластыңыз ба, әлде бір салада болдыңыз ба?
Dialogue: 0,1:11:21.23,1:11:23.52,Default,,0,0,0,,Бір мағынада бұл кездейсоқ оқиға сияқты.
Dialogue: 0,1:11:27.65,1:11:30.99,Default,,0,0,0,,Бұл керемет ішімдік сататын дүкен, бірақ ештеңе қалмады.
Dialogue: 0,1:11:34.45,1:11:36.20,Default,,0,0,0,,Кем дегенде жартысы бұзылды...
Dialogue: 0,1:11:39.25,1:11:41.00,Default,,0,0,0,,О, бұл не?
Dialogue: 0,1:11:43.04,1:11:43.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:51.89,1:11:52.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:53.93,1:11:54.76,Default,,0,0,0,,​​О?
Dialogue: 0,1:11:56.52,1:11:57.56,Default,,0,0,0,,Оны қалдырмайсыз ба?
Dialogue: 0,1:11:59.27,1:12:02.98,Default,,0,0,0,,Адам қайтыс болғанда, біз ештеңе істей алмайтын кездер көп болады.
Dialogue: 0,1:12:04.52,1:12:07.15,Default,,0,0,0,,Салмақты анықтайтын сымдар немесе құрылғылар жоқ.
Dialogue: 0,1:12:07.61,1:12:09.11,Default,,0,0,0,,Тағы бір мүмкіндік...
Dialogue: 0,1:12:10.74,1:12:11.57,Default,,0,0,0,,Не?
Dialogue: 0,1:12:12.11,1:12:12.95,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:12:27.88,1:12:28.71,Default,,0,0,0,,Ах
Dialogue: 0,1:12:29.38,1:12:32.97,Default,,0,0,0,,Әй... Осыншама еңбектен кейін қолыма түскен жалғыз ау.
Dialogue: 0,1:12:33.30,1:12:37.22,Default,,0,0,0,,Менің ойымша, сізде бар бөтелке шотланд вискиі.
Dialogue: 0,1:12:37.89,1:12:40.68,Default,,0,0,0,,12 жылдық Шерри баррель бағасы салықты қосқанда…
Dialogue: 0,1:12:40.77,1:12:42.85,Default,,0,0,0,,Сіз өте білімдісіз.
Dialogue: 0,1:12:43.35,1:12:44.40,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,1:12:44.69,1:12:46.52,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,1:12:46.98,1:12:47.82,Default,,0,0,0,,Даха, гохо…
Dialogue: 0,1:12:47.90,1:12:49.94,Default,,0,0,0,,Тұтынушы Жақсысыз ба?
Dialogue: 0,1:12:51.65,1:12:52.61,Default,,0,0,0,,Күрсін
Dialogue: 0,1:12:53.32,1:12:54.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:02.25,1:13:04.92,Default,,0,0,0,,Мұнда сәл қадам бар, сондықтан...
Dialogue: 0,1:13:05.00,1:13:05.83,Default,,0,0,0,,Абайлаңыз...
Dialogue: 0,1:13:05.92,1:13:07.17,Default,,0,0,0,,Жоқ... хмм...
Dialogue: 0,1:13:08.46,1:13:08.67,Default,,0,0,0,,Уф…
Dialogue: 0,1:13:08.67,1:13:09.46,Default,,0,0,0,,Уф…
Dialogue: 0,1:13:08.67,1:13:09.46,Default,,0,0,0,,барлығы 14 рет
Dialogue: 0,1:13:09.46,1:13:10.67,Default,,0,0,0,,барлығы 14 рет
Dialogue: 0,1:13:10.96,1:13:12.84,Default,,0,0,0,,Мен саған қарама дедім.
Dialogue: 0,1:13:13.34,1:13:15.55,Default,,0,0,0,,Иә, менде ұят жоқ.
Dialogue: 0,1:13:15.93,1:13:17.51,Default,,0,0,0,,Ол оңайлықпен сынбайды.
Dialogue: 0,1:13:18.18,1:13:20.52,Default,,0,0,0,,Ол көрінгеннен де берік.
Dialogue: 0,1:13:22.85,1:13:24.23,Default,,0,0,0,,Бұл бәрінен бұрын
Dialogue: 0,1:13:24.94,1:13:25.77,Default,,0,0,0,,Иә
Dialogue: 0,1:13:28.32,1:13:30.90,Default,,0,0,0,,Көшеде шынымен де көп адам жоқ.
Dialogue: 0,1:13:31.53,1:13:33.74,Default,,0,0,0,,О, бұл біз ғана.
Dialogue: 0,1:13:34.74,1:13:39.79,Default,,0,0,0,,Осындай жаңбырлы күндері далаға шыға алмай, қатты жалығып кетемін.
Dialogue: 0,1:13:40.70,1:13:44.42,Default,,0,0,0,,Бірақ менің ойымша, үйде уақыт өткізу де қызық.
Dialogue: 0,1:13:47.71,1:13:50.09,Default,,0,0,0,,Жалықпадың ба?
Dialogue: 0,1:13:50.71,1:13:52.84,Default,,0,0,0,,«Жанығу» дегенді қалай түсінесіңдер?
Dialogue: 0,1:13:53.51,1:13:56.51,Default,,0,0,0,,Сіз планетарийде жұмыс істегенсіз, солай емес пе?
Dialogue: 0,1:13:57.30,1:14:00.14,Default,,0,0,0,,Сіз мүлде басқа жұмысқа орналасу туралы ойладыңыз ба?
Dialogue: 0,1:14:01.43,1:14:04.64,Default,,0,0,0,,Маған қазіргі жұмысым қатты ұнайды.
Dialogue: 0,1:14:04.98,1:14:09.31,Default,,0,0,0,,Директормен, барлық қызметкерлермен және Йена ханыммен бірлесе отырып...
Dialogue: 0,1:14:09.40,1:14:11.94,Default,,0,0,0,,Өте көңілді және пайдалы
Dialogue: 0,1:14:13.69,1:14:14.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:17.16,1:14:19.03,Default,,0,0,0,,Мм... тұтынушы?
Dialogue: 0,1:14:19.58,1:14:21.45,Default,,0,0,0,,Мен сұрасам болады ма?
Dialogue: 0,1:14:21.54,1:14:23.29,Default,,0,0,0,,Хмм... не?
Dialogue: 0,1:14:23.95,1:14:27.71,Default,,0,0,0,,Сіз Құдайға өтініш жасадыңыз ба?
Dialogue: 0,1:14:29.08,1:14:32.46,Default,,0,0,0,,Болған шығар, бірақ мен жамандық тілемеймін.
Dialogue: 0,1:14:33.38,1:14:36.97,Default,,0,0,0,,Ойланып қарашы, мен сенің тілегіңді әлі естіген жоқпын.
Dialogue: 0,1:14:37.18,1:14:38.84,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:14:39.93,1:14:40.85,Default,,0,0,0,,Сіз не тілейсіз?
Dialogue: 0,1:14:43.10,1:14:44.18,Default,,0,0,0,,Аспан...
Dialogue: 0,1:14:45.14,1:14:48.02,Default,,0,0,0,,Аспанды екіге бөлме
Dialogue: 0,1:14:48.65,1:14:52.11,Default,,0,0,0,,Мен мұны робот құдайдан сұрағым келеді.
Dialogue: 0,1:14:52.36,1:14:53.19,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:53.57,1:14:57.15,Default,,0,0,0,,Аспан қақпалары адамдар мен роботтарға бөлінсе ше?
Dialogue: 0,1:14:57.24,1:14:59.32,Default,,0,0,0,,Мен қатты қиналып жүрмін.
Dialogue: 0,1:14:59.95,1:15:04.29,Default,,0,0,0,,Жұмаққа барсам да, адамдарға көмектескім келеді.
Dialogue: 0,1:15:04.83,1:15:08.46,Default,,0,0,0,,Мен сенің жаныңда жұмыс істеуді жалғастырғым келеді.
Dialogue: 0,1:15:08.92,1:15:09.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:10.63,1:15:11.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:15:11.92,1:15:13.55,Default,,0,0,0,,...
Dialogue: 0,1:15:16.72,1:15:19.51,Default,,0,0,0,,Оны осылай қалдырсаңыз, батарея заряды таусылады.
Dialogue: 0,1:15:20.64,1:15:22.80,Default,,0,0,0,,Бұл жігіттің тілегін орындау үшін...
Dialogue: 0,1:15:23.01,1:15:24.97,Default,,0,0,0,,Оны бұл қаладан алып кетуден басқа амалым жоқ...
Dialogue: 0,1:15:25.52,1:15:29.19,Default,,0,0,0,,Сіз бұл жігітті оның еркіне қарамай күшпен шығарып саласыз ба?
Dialogue: 0,1:15:30.60,1:15:31.61,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:15:31.86,1:15:34.11,Default,,0,0,0,,Көлігіңіз әлі алыс па?
Dialogue: 0,1:15:34.19,1:15:35.03,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:15:35.15,1:15:37.03,Default,,0,0,0,,Жоқ, уақыт таяп қалды.
Dialogue: 0,1:15:37.53,1:15:38.99,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,1:15:39.20,1:15:40.49,Default,,0,0,0,,Бір сәт – Буггарати мен басқалардың да бағыты бар шығар
Dialogue: 0,1:15:40.74,1:15:41.62,Default,,0,0,0,,О
Dialogue: 0,1:15:43.91,1:15:44.79,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,1:15:45.91,1:15:48.00,Default,,0,0,0,,Себебі мен алғаш рет ішімдік ішкенмін.
Dialogue: 0,1:15:49.37,1:15:50.21,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:15:51.79,1:15:53.92,Default,,0,0,0,,Мен алкогольді ішуді бастағанға дейін -
Dialogue: 0,1:15:54.29,1:15:57.80,Default,,0,0,0,,Мен жеткілікті мас болдым.
Dialogue: 0,1:15:59.17,1:16:00.26,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,1:16:00.68,1:16:02.30,Default,,0,0,0,,Ештеңе емес, кеттік.
Dialogue: 0,1:16:03.97,1:16:06.64,Default,,0,0,0,,Мен онымен не істеуім керек?
Dialogue: 0,1:16:18.07,1:16:18.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:19.61,1:16:20.53,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:16:20.74,1:16:21.95,Default,,0,0,0,,Алдағы көше –
Dialogue: 0,1:16:22.03,1:16:24.78,Default,,0,0,0,,Менің дерекқорымнан айтарлықтай ерекшеленетін сияқты.
Dialogue: 0,1:16:25.08,1:16:26.95,Default,,0,0,0,,Ол қайта өңделді ме?
Dialogue: 0,1:16:27.79,1:16:28.87,Default,,0,0,0,,Мүмкін емес…
Dialogue: 0,1:16:29.25,1:16:32.92,Default,,0,0,0,,Сонда сіз мұнда қандай құрылыс техникасын көріп тұрсыз?
Dialogue: 0,1:16:33.75,1:16:35.75,Default,,0,0,0,,Автоматты артиллериялық скрипкашы краб.
Dialogue: 0,1:16:36.25,1:16:37.55,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,1:16:38.55,1:16:40.09,Default,,0,0,0,,Сіз сияқты.
Dialogue: 0,1:16:40.72,1:16:44.39,Default,,0,0,0,,Бірақ мен блокада қабырғасының дәл алдында тұрмын деп ойламаймын.
Dialogue: 0,1:16:45.22,1:16:46.43,Default,,0,0,0,,Жеңіске жету мүмкіндігі бар ма?
Dialogue: 0,1:16:47.06,1:16:48.81,Default,,0,0,0,,Мм... тұтынушы
Dialogue: 0,1:16:49.93,1:16:51.23,Default,,0,0,0,,Аңға шығу
Dialogue: 0,1:16:51.44,1:16:53.52,Default,,0,0,0,,«Аңшылық» дегенді қалай түсінесіңдер?
Dialogue: 0,1:16:54.98,1:16:57.15,Default,,0,0,0,,Мен қайтып келгенше осында бол.
Dialogue: 0,1:16:57.69,1:16:59.86,Default,,0,0,0,,Мен жақында бұл қаладан кетемін.
Dialogue: 0,1:17:00.99,1:17:03.95,Default,,0,0,0,,Менімен ажырасқан соң не істейсің?
Dialogue: 0,1:17:04.07,1:17:04.91,Default,,0,0,0,,Иә
Dialogue: 0,1:17:04.99,1:17:08.99,Default,,0,0,0,,Мен жұмысқа жалғыз қайтатын боламын, сондықтан уайымдамаңыз.
Dialogue: 0,1:17:09.41,1:17:10.83,Default,,0,0,0,,Бұл қала қаңырап бос қалды
Dialogue: 0,1:17:11.37,1:17:13.92,Default,,0,0,0,,Қайтып келсең де, қонақтар енді келмейді...
Dialogue: 0,1:17:14.00,1:17:15.88,Default,,0,0,0,,Планетарийді көрсетуге мүмкіндік жоқ
Dialogue: 0,1:17:16.21,1:17:18.88,Default,,0,0,0,,Сондай-ақ, бұл қаланы электрмен қамту аяқталды.
Dialogue: 0,1:17:19.13,1:17:20.51,Default,,0,0,0,,Проектор енді ешқашан жұмыс істемейді.
Dialogue: 0,1:17:20.76,1:17:23.43,Default,,0,0,0,,Бәрі де өз көзіңмен көргендей.
Dialogue: 0,1:17:24.18,1:17:26.01,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,1:17:26.22,1:17:29.89,Default,,0,0,0,,Менің негізгі және жинақталған мәліметтер қорымды тексеру—
Dialogue: 0,1:17:30.02,1:17:32.89,Default,,0,0,0,,Тапсырыс беруші міндетті түрде келеді деп болжанады.
Dialogue: 0,1:17:33.35,1:17:36.31,Default,,0,0,0,,Электр қуатын беру қалпына келтірілгенге дейін электр қуатын өшіру үшін —
Dialogue: 0,1:17:36.44,1:17:39.48,Default,,0,0,0,,Йена да, мен де мәңгі күте аламыз.
Dialogue: 0,1:17:39.61,1:17:40.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:17:40.69,1:17:44.95,Default,,0,0,0,,Қараңдар! Енді менің айтқанымды мұқият тыңдап, түсініңіз.
Dialogue: 0,1:17:45.45,1:17:46.99,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,1:17:47.57,1:17:48.78,Default,,0,0,0,,Мен мұнда келгенше—
Dialogue: 0,1:17:48.87,1:17:51.75,Default,,0,0,0,,Барлығын тек көрген фактілерге сүйене отырып бағалаңыз.
Dialogue: 0,1:17:52.45,1:17:55.79,Default,,0,0,0,,Бұл қалаға енді сізге де, планетарий де керек емес!
Dialogue: 0,1:17:56.67,1:17:59.67,Default,,0,0,0,,Адамдар үшін жұмыс істеуді жалғастырғыңыз келсе
Dialogue: 0,1:18:00.21,1:18:01.59,Default,,0,0,0,,Артымнан еруден басқа амалың жоқ.
Dialogue: 0,1:18:02.59,1:18:06.43,Default,,0,0,0,,Бұл сізді бақытты ете ме, білмеймін.
Dialogue: 0,1:18:07.22,1:18:09.89,Default,,0,0,0,,Бірақ... мен үшін...
Dialogue: 0,1:18:13.89,1:18:18.36,Default,,0,0,0,,Мен адамдарға көмектесуді жалғастырғым келеді.
Dialogue: 0,1:18:18.94,1:18:21.73,Default,,0,0,0,,Бұл менің бақытым
Dialogue: 0,1:18:23.32,1:18:27.66,Default,,0,0,0,,Дегенмен, тұтынушының әңгімесіне негізделген болашақ әрекеттерді анықтау үшін—
Dialogue: 0,1:18:27.74,1:18:30.08,Default,,0,0,0,,Менің ойымша, ақпарат жеткіліксіз
Dialogue: 0,1:18:30.99,1:18:34.04,Default,,0,0,0,,Қосымша ақпаратты алу мүмкіндігі жоқ.
Dialogue: 0,1:18:34.66,1:18:35.58,Default,,0,0,0,,Мұндай жағдайлар бола ма?
Dialogue: 0,1:18:38.79,1:18:41.00,Default,,0,0,0,,Мен қайтып оралмас бұрын ойланыңыз.
Dialogue: 0,1:18:41.59,1:18:43.30,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,1:18:43.80,1:18:44.63,Default,,0,0,0,,Иә.
Dialogue: 0,1:18:44.80,1:18:46.09,Default,,0,0,0,,Мына жігітті қалдырыңыз.
Dialogue: 0,1:18:47.76,1:18:50.35,Default,,0,0,0,,Иә, мен оны сақтаймын.
Dialogue: 0,1:18:51.10,1:18:53.56,Default,,0,0,0,,Қайта айтамын, не болса да, қозғалма.
Dialogue: 0,1:18:53.85,1:18:54.85,Default,,0,0,0,,Даусыңды да көтерме
Dialogue: 0,1:18:55.18,1:18:56.56,Default,,0,0,0,,Мен қайтып келгенше.
Dialogue: 0,1:18:56.98,1:19:00.06,Default,,0,0,0,,Иә Маңызды тапсырыс ретінде тіркелген
Dialogue: 0,1:19:00.77,1:19:02.57,Default,,0,0,0,,Сіздің қайтып келуіңізді асыға күтеміз.
Dialogue: 0,1:19:22.04,1:19:25.80,Default,,0,0,0,,Зарядтау құрылғылары қымбат, бірақ оларды алу мүмкін емес.
Dialogue: 0,1:19:26.76,1:19:27.76,Default,,0,0,0,,Ол үшін
Dialogue: 0,1:19:28.13,1:19:31.47,Default,,0,0,0,,Сондай-ақ шағын проекторды орнатуға болады.
Dialogue: 0,1:19:31.93,1:19:35.27,Default,,0,0,0,,Олармен елді мекендерді аралау
Dialogue: 0,1:19:35.72,1:19:38.06,Default,,0,0,0,,Жұлдызды аспанды түсіндіреді
Dialogue: 0,1:19:38.64,1:19:41.31,Default,,0,0,0,,Өміріңізді осындай бизнеске өзгертуге қалай қарайсыз?
Dialogue: 0,1:19:44.02,1:19:46.40,Default,,0,0,0,,Иә, бұл күлкілі.
Dialogue: 0,1:20:02.63,1:20:06.21,Default,,0,0,0,,Кешіріңіз, бірақ мен қайтадан серіктес таптым.
Dialogue: 0,1:20:08.63,1:20:09.67,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:20:13.18,1:20:14.22,Default,,0,0,0,,Қателік!
Dialogue: 0,1:21:10.65,1:21:13.41,Default,,0,0,0,,Бірінші оқтан өлмегенім өте ауыр.
Dialogue: 0,1:21:17.87,1:21:18.95,Default,,0,0,0,,Екі оқ қалды
Dialogue: 0,1:21:19.45,1:21:22.12,Default,,0,0,0,,Мүмкіндігінше арықтаңыз және алдымен тоқтаңыз.
Dialogue: 0,1:21:22.62,1:21:26.38,Default,,0,0,0,,Содан кейін жоғарғы сауытты көздеп, оны жойыңыз.
Dialogue: 0,1:21:53.57,1:21:54.95,Default,,0,0,0,,Пайдасыз оқтарды атпа
Dialogue: 0,1:22:00.95,1:22:04.12,Default,,0,0,0,,Бұл қарсыластың атыс күші анық болмаған кездегі стандартты әрекет.
Dialogue: 0,1:22:04.66,1:22:06.17,Default,,0,0,0,,Жақында тағы да өрт болады.
Dialogue: 0,1:22:06.88,1:22:07.79,Default,,0,0,0,,Соракита
Dialogue: 0,1:22:18.05,1:22:19.60,Default,,0,0,0,,1 2 3
Dialogue: 0,1:22:41.28,1:22:43.79,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,1:22:47.29,1:22:49.54,Default,,0,0,0,,Қарғыс атсын, құлағым шырылдап тұр.
Dialogue: 0,1:22:50.04,1:22:51.34,Default,,0,0,0,,Күйді тексеру
Dialogue: 0,1:22:51.50,1:22:52.34,Default,,0,0,0,,Ах
Dialogue: 0,1:22:57.34,1:23:00.10,Default,,0,0,0,,Қайта жүктеуге 30 секундтан аз уақыт қалды, келесісі жақын арада келеді
Dialogue: 0,1:23:01.60,1:23:02.56,Default,,0,0,0,,Бұзылған ба...
Dialogue: 0,1:23:02.89,1:23:06.52,Default,,0,0,0,,Көзге көз, аяққа аяқ, а...
Dialogue: 0,1:23:18.11,1:23:18.95,Default,,0,0,0,,Уау
Dialogue: 0,1:23:22.99,1:23:23.83,Default,,0,0,0,,Уау~
Dialogue: 0,1:23:43.14,1:23:44.10,Default,,0,0,0,,Не деп тұрсың өзің?
Dialogue: 0,1:23:49.06,1:23:49.89,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:13.42,1:24:14.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:22.22,1:24:23.05,Default,,0,0,0,,​​О?
Dialogue: 0,1:25:22.78,1:25:24.78,Default,,0,0,0,,Неге мұндай ақымақтық жасадың!
Dialogue: 0,1:25:25.03,1:25:27.37,Default,,0,0,0,,Тұтынушы, қайта қош келдіңіз
Dialogue: 0,1:25:28.28,1:25:30.37,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:25:30.75,1:25:33.00,Default,,0,0,0,,Мен қайтып келгенше қозғалма дедім!
Dialogue: 0,1:25:36.25,1:25:39.42,Default,,0,0,0,,Тіркелмеген әуе кемесі, қашып кеткен күйде көрінеді -
Dialogue: 0,1:25:39.80,1:25:43.93,Default,,0,0,0,,Мәжбүрлі тоқтату сигналы жіберілді, бірақ қабылданбады.
Dialogue: 0,1:25:44.63,1:25:47.60,Default,,0,0,0,,Қабылдаушы жағында ақау бар екені анықталды.
Dialogue: 0,1:25:47.85,1:25:52.27,Default,,0,0,0,,Физикалық операцияларды қолдану арқылы шұғыл тоқтату әрекеті жасалды, бірақ ол сәтсіз аяқталды.
Dialogue: 0,1:25:52.73,1:25:54.48,Default,,0,0,0,,Қашқын күйіндегі әуе кемесі —
Dialogue: 0,1:25:54.56,1:25:57.44,Default,,0,0,0,,Функция қазір тоқтатылған сияқты.
Dialogue: 0,1:25:58.15,1:26:00.02,Default,,0,0,0,,Зардап шеккен ұшақтан алыстау—
Dialogue: 0,1:26:00.11,1:26:04.70,Default,,0,0,0,,Жергілікті полиция агенттігіне немесе қолдау орталығына хабарласыңыз.
Dialogue: 0,1:26:05.41,1:26:09.91,Default,,0,0,0,,Маңызды тапсырысты бұзғаным үшін кешірім сұраймын.
Dialogue: 0,1:26:10.95,1:26:14.50,Default,,0,0,0,,Одан да ескі конвенция бар.
Dialogue: 0,1:26:15.87,1:26:19.38,Default,,0,0,0,,«Адамға зиян тигізбеу»
Dialogue: 0,1:26:20.38,1:26:24.72,Default,,0,0,0,,Мұны қорғайтын робот ретінде біздің мақтанышымыз.
Dialogue: 0,1:26:25.38,1:26:26.47,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:26:26.97,1:26:29.01,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:26:29.39,1:26:30.22,Default,,0,0,0,,О
Dialogue: 0,1:26:30.89,1:26:32.22,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,1:26:32.93,1:26:34.89,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:26:36.35,1:26:39.86,Default,,0,0,0,,Оның атынан шын жүректен кешірім сұраймын.
Dialogue: 0,1:26:40.65,1:26:43.74,Default,,0,0,0,,Оның да сынғанына сенімдімін.
Dialogue: 0,1:26:45.36,1:26:46.91,Default,,0,0,0,,Біз роботтармыз
Dialogue: 0,1:26:47.24,1:26:50.99,Default,,0,0,0,,Бұл барлық адамдардың бақыты үшін.
Dialogue: 0,1:26:51.53,1:26:53.24,Default,,0,0,0,,Мұндай өрескелдік
Dialogue: 0,1:26:53.66,1:26:56.08,Default,,0,0,0,,Мен шынымен де қаламаған шығармын.
Dialogue: 0,1:26:56.87,1:26:58.79,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,1:27:00.38,1:27:04.51,Default,,0,0,0,,Мен де аздап... сынғанмын.
Dialogue: 0,1:27:08.34,1:27:09.18,Default,,0,0,0,,Ах
Dialogue: 0,1:27:12.18,1:27:13.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:27:13.85,1:27:19.52,Default,,0,0,0,,Апаттық батареяның қуаты шамамен 600 секундта таусылады.
Dialogue: 0,1:27:19.60,1:27:20.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:20.52,1:27:23.23,Default,,0,0,0,,Резервтік батарея таусылған, сондықтан...
Dialogue: 0,1:27:23.57,1:27:26.44,Default,,0,0,0,,Осыдан кейін оны бастау мүмкін болмайды.
Dialogue: 0,1:27:27.11,1:27:29.86,Default,,0,0,0,,Біз техникалық қызмет көрсетуге қоңырау шалып жатырмыз.
Dialogue: 0,1:27:29.95,1:27:31.12,Default,,0,0,0,,Қабылданбаған
Dialogue: 0,1:27:31.70,1:27:34.16,Default,,0,0,0,,Мен аздап уайымдап тұрмын.
Dialogue: 0,1:27:34.95,1:27:36.41,Default,,0,0,0,,Ешкімге қоңырау шалудың қажеті жоқ!
Dialogue: 0,1:27:37.37,1:27:38.41,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,1:27:38.79,1:27:39.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:27:40.92,1:27:42.34,Default,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,1:27:45.21,1:27:48.01,Default,,0,0,0,,Жағымсыз оқиға үшін кешірім сұраймыз.
Dialogue: 0,1:27:48.68,1:27:51.05,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,1:27:52.18,1:27:53.97,Default,,0,0,0,,Мен роботпын
Dialogue: 0,1:27:54.72,1:27:56.98,Default,,0,0,0,,Ауырсынуды сезінбеу
Dialogue: 0,1:27:58.27,1:28:00.94,Default,,0,0,0,,Сондай-ақ денені жөндеуге және—
Dialogue: 0,1:28:01.65,1:28:05.53,Default,,0,0,0,,Сіз оны жаңа тұрғын үйге айырбастауға да болады.
Dialogue: 0,1:28:08.19,1:28:12.37,Default,,0,0,0,,Сізді жөндей алатын техник, жаңа дене жоқ.
Dialogue: 0,1:28:13.41,1:28:18.04,Default,,0,0,0,,Бұл дүниеде тіпті сізге мұқтаж адамдар бар...
Dialogue: 0,1:28:20.04,1:28:26.21,Default,,0,0,0,,Маған осылай қарасаң, қатты қиналатын едім.
Dialogue: 0,1:28:27.05,1:28:29.38,Default,,0,0,0,,Мен роботпын
Dialogue: 0,1:28:30.05,1:28:33.59,Default,,0,0,0,,Сіздің күлімсіреуіңіз ең маңыздысы
Dialogue: 0,1:28:34.64,1:28:36.89,Default,,0,0,0,,Барлығының есінде
Dialogue: 0,1:28:37.85,1:28:42.23,Default,,0,0,0,,Мен роботпын, сондықтан мен заттарды есте сақтауда жақсымын.
Dialogue: 0,1:28:45.73,1:28:47.11,Default,,0,0,0,,Бұл Юмэми Хошино.
Dialogue: 0,1:28:47.65,1:28:50.65,Default,,0,0,0,,Өте жақсы атыңызға рахмет.
Dialogue: 0,1:28:51.24,1:28:55.45,Default,,0,0,0,,Мен бар күшімді саламын, сондықтан қолдауларыңызға рахмет.
Dialogue: 0,1:28:55.53,1:28:56.95,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:28:58.24,1:29:00.79,Default,,0,0,0,,Юмэми-чан, өтінемін.
Dialogue: 0,1:29:02.33,1:29:04.96,Default,,0,0,0,,Юмэми-чан, әдемі жұлдыз үшін рахмет
Dialogue: 0,1:29:05.71,1:29:09.76,Default,,0,0,0,,Мен келесі жолы барлық достарыммен келемін, сондықтан оған дейін жақсы болыңыз.
Dialogue: 0,1:29:11.09,1:29:14.05,Default,,0,0,0,,Келесі жолы үйлену тойымызға әйелімді әкелемін.
Dialogue: 0,1:29:17.47,1:29:21.02,Default,,0,0,0,,Бала кезімдегідей тамаша жұлдызды аспан еді.
Dialogue: 0,1:29:21.81,1:29:25.56,Default,,0,0,0,,Сіз роботты келесі жылы қайта көруге келетініңізге сенімдімін.
Dialogue: 0,1:29:27.11,1:29:30.07,Default,,0,0,0,,Жұлдыздар туралы көп нәрсені білу қызықты болды.
Dialogue: 0,1:29:30.69,1:29:32.53,Default,,0,0,0,,Жазғы демалыста тегін зерттеу үшін—
Dialogue: 0,1:29:32.61,1:29:34.82,Default,,0,0,0,,Мен Юмэми-чан туралы жазғым келеді.
Dialogue: 0,1:29:36.28,1:29:40.04,Default,,0,0,0,,Жарайды, бұл өте әдемі болды және маған қатты әсер етті.
Dialogue: 0,1:29:40.91,1:29:42.16,Default,,0,0,0,,Мен міндетті түрде тағы келемін
Dialogue: 0,1:29:43.33,1:29:45.63,Default,,0,0,0,,Юмэми-чан мен сені жақсы көремін
Dialogue: 0,1:29:46.21,1:29:47.50,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:48.17,1:29:51.26,Default,,0,0,0,,Біз сізді тағы да күтеміз.
Dialogue: 0,1:29:52.55,1:29:53.55,Default,,0,0,0,,Юмэми-чан
Dialogue: 0,1:29:53.88,1:29:57.97,Default,,0,0,0,,Бәріміз біраз уақытқа саяхатқа шығамыз.
Dialogue: 0,1:29:58.47,1:29:59.72,Default,,0,0,0,,Саяхаттау?
Dialogue: 0,1:29:59.81,1:30:01.35,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,1:30:01.43,1:30:02.35,Default,,0,0,0,,Демек, мұнда Бағана болған екен ғой?
Dialogue: 0,1:30:02.89,1:30:05.10,Default,,0,0,0,,Ах... Юмэми-чан
Dialogue: 0,1:30:05.44,1:30:09.27,Default,,0,0,0,,Біз қайтып келгенше осында күте аласыз ба?
Dialogue: 0,1:30:09.73,1:30:11.32,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,1:30:11.65,1:30:14.03,Default,,0,0,0,,Сонда қашан қайтасыз?
Dialogue: 0,1:30:14.24,1:30:15.28,Default,,0,0,0,,Бұл...
Dialogue: 0,1:30:17.03,1:30:18.45,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:30:18.74,1:30:20.91,Default,,0,0,0,,Мен әлі білмеймін.
Dialogue: 0,1:30:21.74,1:30:26.58,Default,,0,0,0,,Бірақ біз мұнда міндетті түрде қайтамыз.
Dialogue: 0,1:30:26.92,1:30:29.75,Default,,0,0,0,,Олай болса, менімен қайта жұмыс істеңіз.
Dialogue: 0,1:30:30.38,1:30:31.84,Default,,0,0,0,,Юмэми сияқты
Dialogue: 0,1:30:32.30,1:30:33.71,Default,,0,0,0,,Иә, директор.
Dialogue: 0,1:30:34.13,1:30:37.97,Default,,0,0,0,,Уф... Кешіріңіз, Юмэми-чан.
Dialogue: 0,1:30:39.22,1:30:42.27,Default,,0,0,0,,Мен мұндай жерде жалғызбын...
Dialogue: 0,1:30:42.72,1:30:45.73,Default,,0,0,0,,Мен туралы болса, уайымдамаңыз.
Dialogue: 0,1:30:46.23,1:30:50.36,Default,,0,0,0,,Мен Йена-санмен бірге мәңгілік күтемін.
Dialogue: 0,1:30:52.53,1:30:55.32,Default,,0,0,0,,Өтінемін, жоқтығыңызды маған қалдырыңыз.
Dialogue: 0,1:30:55.99,1:30:59.12,Default,,0,0,0,,Баршаңызға сапарыңыз сәтті өтсін.
Dialogue: 0,1:31:01.74,1:31:06.75,Default,,0,0,0,,Бұл 29 жыл 71 күн бұрынғы рекорд.
Dialogue: 0,1:31:07.62,1:31:09.71,Default,,0,0,0,,Мұражайдың алғашқы проекциясынан бастап
Dialogue: 0,1:31:10.08,1:31:15.13,Default,,0,0,0,,44 жыл 138 күн өтті
Dialogue: 0,1:31:15.84,1:31:18.47,Default,,0,0,0,,Тұтынушы келгенге дейін—
Dialogue: 0,1:31:19.01,1:31:23.10,Default,,0,0,0,,Мен бұл туралы көп ойладым.
Dialogue: 0,1:31:23.97,1:31:29.94,Default,,0,0,0,,Директор мен қызметкерлер қашан оралады?
Dialogue: 0,1:31:30.65,1:31:34.19,Default,,0,0,0,,Келесі тұтынушы қашан келеді?
Dialogue: 0,1:31:35.23,1:31:38.74,Default,,0,0,0,,Сонда біз әрқашан бір қорытындыға келеміз.
Dialogue: 0,1:31:39.45,1:31:44.41,Default,,0,0,0,,Қорытынды: барлық адамдар... қайтып келмейді.
Dialogue: 0,1:31:45.54,1:31:48.16,Default,,0,0,0,,Бірақ бұл дұрыс болуы мүмкін емес.
Dialogue: 0,1:31:48.75,1:31:52.71,Default,,0,0,0,,Мен бұзған болуы керек деп ойладым.
Dialogue: 0,1:31:53.34,1:31:57.72,Default,,0,0,0,,Мен өзін-өзі диагностикалау бағдарламасын іске қосып, кез келген ауытқуларды іздедім.
Dialogue: 0,1:31:59.59,1:32:03.14,Default,,0,0,0,,Бірақ еш жерде ауытқулар табылмады.
Dialogue: 0,1:32:03.93,1:32:09.98,Default,,0,0,0,,Өзін-өзі диагностикалау бағдарламасында белгісіз қате болуы керек деп ойладым.
Dialogue: 0,1:32:11.73,1:32:17.40,Default,,0,0,0,,Тұтынушы келгенде өте қуаныштымын.
Dialogue: 0,1:32:18.61,1:32:21.53,Default,,0,0,0,,«Мен қателестім».
Dialogue: 0,1:32:22.20,1:32:26.62,Default,,0,0,0,,«Тұтынушы мені ұмытқан жоқ».
Dialogue: 0,1:32:27.12,1:32:31.71,Default,,0,0,0,,Осылай ойлап, шын қуанып қалдым.
Dialogue: 0,1:32:33.88,1:32:36.71,Default,,0,0,0,,Бірақ... бұл басқаша болды.
Dialogue: 0,1:32:38.59,1:32:44.35,Default,,0,0,0,,Мен сынған жоқпын, мен сындым...
Dialogue: 0,1:32:47.06,1:32:49.98,Default,,0,0,0,,Неліктен бұзылды?
Dialogue: 0,1:32:52.23,1:32:58.19,Default,,0,0,0,,Апаттық батареяның қуаты шамамен 150 секундта таусылады.
Dialogue: 0,1:32:59.07,1:33:02.95,Default,,0,0,0,,Сақтық батарея заряды таусылған, сондықтан...
Dialogue: 0,1:33:03.45,1:33:06.53,Default,,0,0,0,,Осыдан кейін оны бастау мүмкін болмайды.
Dialogue: 0,1:33:08.83,1:33:11.87,Default,,0,0,0,,Тек бір рет жазуға болады
Dialogue: 0,1:33:13.08,1:33:14.13,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:33:14.75,1:33:18.38,Default,,0,0,0,,Біздің мұражайға барғаныңызды еске алу үшін—
Dialogue: 0,1:33:19.38,1:33:22.22,Default,,0,0,0,,Бірдеңе айтыңызшы.
Dialogue: 0,1:33:25.51,1:33:27.68,Default,,0,0,0,,Егер тым алысқа кетсек, Радио ғимаратында дүрбелең болады,
Dialogue: 0,1:33:27.93,1:33:28.76,Default,,0,0,0,,Иә
Dialogue: 0,1:33:31.23,1:33:32.89,Default,,0,0,0,,Сізге шындықты айту
Dialogue: 0,1:33:34.90,1:33:37.73,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,1:33:37.94,1:33:39.53,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,1:33:41.40,1:33:45.28,Default,,0,0,0,,Бұл қабырғаның арғы жағында сіздің жаңа жұмыс орныңыз бар.
Dialogue: 0,1:33:46.24,1:33:49.95,Default,,0,0,0,,Досыңыздың проекторы, сіздің әріптесіңіз де.
Dialogue: 0,1:33:50.04,1:33:51.70,Default,,0,0,0,,Барлығы сонда күтіп тұр.
Dialogue: 0,1:33:52.58,1:33:55.67,Default,,0,0,0,,Көпшілік толып, сізді күтіп отыр.
Dialogue: 0,1:33:56.42,1:33:59.67,Default,,0,0,0,,Біз бәріміз сіздің түсініктемелеріңізді күтеміз.
Dialogue: 0,1:34:00.42,1:34:03.38,Default,,0,0,0,,Бүгіннен бастап сонда жұмыс істейсіз.
Dialogue: 0,1:34:04.47,1:34:09.51,Default,,0,0,0,,Қалағаныңызша жұмыс істей аласыз.
Dialogue: 0,1:34:11.18,1:34:14.56,Default,,0,0,0,,Бұл аспан сияқты, солай емес пе?
Dialogue: 0,1:34:16.31,1:34:17.15,Default,,0,0,0,,О
Dialogue: 0,1:34:17.86,1:34:20.19,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,1:34:21.78,1:34:27.03,Default,,0,0,0,,Мен клиенттің кім екенін ақыры білдім деп ойлаймын.
Dialogue: 0,1:34:28.74,1:34:29.87,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:34:30.37,1:34:33.37,Default,,0,0,0,,Менің өтінішімді тыңдай аласыз ба?
Dialogue: 0,1:34:33.87,1:34:35.25,Default,,0,0,0,,О, не?
Dialogue: 0,1:34:36.17,1:34:39.71,Default,,0,0,0,,Менің құлақ қабылдағышымның артқы ұясында—
Dialogue: 0,1:34:40.04,1:34:42.88,Default,,0,0,0,,Жад картасы салынған
Dialogue: 0,1:34:43.63,1:34:49.26,Default,,0,0,0,,Онда менің барлық естеліктерім жазылған.
Dialogue: 0,1:34:50.10,1:34:54.02,Default,,0,0,0,,Олардың барлығы тамаша естеліктер.
Dialogue: 0,1:34:54.89,1:34:59.90,Default,,0,0,0,,Оны менің жаңа жұмыс орныма жеткізе аласыз ба?
Dialogue: 0,1:35:01.94,1:35:04.78,Default,,0,0,0,,Егер сіз жаңа денені дайындай алсаңыз —
Dialogue: 0,1:35:05.44,1:35:09.28,Default,,0,0,0,,Мен сол күннен бастап жұмысқа кірісе аламын.
Dialogue: 0,1:35:10.91,1:35:16.21,Default,,0,0,0,,Мен барлық адамдар үшін әрқашан боламын.
Dialogue: 0,1:35:16.91,1:35:19.96,Default,,0,0,0,,Жұмыс істей алады...
Dialogue: 0,1:35:21.17,1:35:25.92,Default,,0,0,0,,Олай болса, шынымды айтайын...
Dialogue: 0,1:35:26.80,1:35:32.60,Default,,0,0,0,,Маған жұмақ керек емес...
Dialogue: 0,1:35:34.18,1:35:38.06,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,1:35:39.15,1:35:43.69,Default,,0,0,0,,Мені аспанға шақырсаң...
Dialogue: 0,1:35:44.57,1:35:48.40,Default,,0,0,0,,Құдай... өтінемін... өтінемін
Dialogue: 0,1:35:49.78,1:35:53.20,Default,,0,0,0,,Аспанды екіге бөлме
Dialogue: 0,1:35:54.08,1:36:00.42,Default,,0,0,0,,Роботтар мен адамдарға бөлмеңіз.
Dialogue: 0,1:36:01.46,1:36:06.55,Default,,0,0,0,,Мен мәңгі боламын... мәңгілік...
Dialogue: 0,1:36:07.26,1:36:10.05,Default,,0,0,0,,Адамдар... Сіздің...
Dialogue: 0,1:36:10.76,1:36:14.10,Default,,0,0,0,,Жарайды, мен жеткіземін.
Dialogue: 0,1:36:16.06,1:36:19.81,Default,,0,0,0,,Иә, рахмет...
Dialogue: 0,1:36:20.77,1:36:23.31,Default,,0,0,0,,Мен өте... бақыттымын.
Dialogue: 0,1:36:23.94,1:36:25.40,Default,,0,0,0,,(дененің сықырлауы)
Dialogue: 0,1:36:26.28,1:36:27.32,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,1:36:28.69,1:36:31.20,Default,,0,0,0,,Қайда келгіңіз келеді?
Dialogue: 0,1:36:32.66,1:36:33.78,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,1:36:34.58,1:36:37.91,Default,,0,0,0,,Сіз... сондасыз ба?
Dialogue: 0,1:36:39.04,1:36:40.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:36:40.83,1:36:45.71,Default,,0,0,0,,Мен өзімді сындырғандай сезінемін...
Dialogue: 0,1:36:47.21,1:36:53.30,Default,,0,0,0,,Мен... Арзан нұсқасы болғандықтан, көз жасымды шығара алмаймын, бірақ...
Dialogue: 0,1:36:54.14,1:36:59.14,Default,,0,0,0,,Ал егер… функция орнатылған болса…
Dialogue: 0,1:36:59.85,1:37:04.69,Default,,0,0,0,,Менің ойымша, сен жылап жатқан шығарсың...
Dialogue: 0,1:37:05.77,1:37:10.78,Default,,0,0,0,,Мен жылауымды тоқтата алмаймын деп ойлаймын...
Dialogue: 0,1:37:11.78,1:37:16.45,Default,,0,0,0,,Мен өте... бақыттымын.
Dialogue: 0,1:37:17.28,1:37:22.71,Default,,0,0,0,,Мен бақытты сезімдерге толы болсам да...
Dialogue: 0,1:37:26.17,1:37:28.42,Default,,0,0,0,,Неліктен...?
Dialogue: 0,1:37:29.67,1:37:33.38,Default,,0,0,0,,Сіздің жаңа жұмыс орныңыз қандай болады?
Dialogue: 0,1:37:34.47,1:37:39.47,Default,,0,0,0,,Клиенттер қашан келе алады...
Dialogue: 0,1:37:40.56,1:37:46.86,Default,,0,0,0,,Сіз ең жақсы жағдайда келуіңіз керек.
Dialogue: 0,1:37:48.73,1:37:51.69,Default,,0,0,0,,Планетарий туралы не деуге болады?
Dialogue: 0,1:37:53.15,1:37:55.82,Default,,0,0,0,,Кез келген уақытта...
Dialogue: 0,1:37:56.74,1:37:57.83,Default,,0,0,0,,Ешқашан...
Dialogue: 0,1:37:58.78,1:38:02.66,Default,,0,0,0,,Жоғал... ешқашан...
Dialogue: 0,1:38:04.83,1:38:06.46,Default,,0,0,0,,Әдемі...
Dialogue: 0,1:39:01.47,1:39:02.56,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,1:39:30.17,1:39:31.09,Default,,0,0,0,,Қазына?
Dialogue: 0,1:39:31.38,1:39:32.71,Default,,0,0,0,,Бұл жағдай туралы не деуге болады?
Dialogue: 0,1:39:33.21,1:39:34.96,Default,,0,0,0,,Бұл іс қазына ма?
Dialogue: 0,1:39:35.96,1:39:40.68,Default,,0,0,0,,Дәл осы істің ішінде не бар.
Dialogue: 0,1:39:42.18,1:39:44.06,Default,,0,0,0,,Бұл жұлдызды тұлғаның дәлелі.
Dialogue: 0,1:39:45.02,1:39:48.31,Default,,0,0,0,,Осыны бағалағаныңызды қалаймын.
Dialogue: 0,1:39:49.10,1:39:54.27,Default,,0,0,0,,Егер сіз бір күні нағыз жұлдызды аспанды көре алсаңыз...
Dialogue: 0,1:39:55.82,1:39:56.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:39:56.82,1:39:57.65,Default,,0,0,0,,Әй?
Dialogue: 0,1:40:00.28,1:40:02.83,Default,,0,0,0,,Алаңға келе аласыз ба?
Dialogue: 0,1:40:08.50,1:40:09.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:10.00,1:40:12.75,Default,,0,0,0,,Балалар, басқа жерде күтулерің керек.
Dialogue: 0,1:40:12.96,1:40:13.79,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,1:40:13.88,1:40:16.42,Default,,0,0,0,,Біз осындамыз, өйткені біз...
Dialogue: 0,1:40:16.51,1:40:19.17,Default,,0,0,0,,Жұлдызды халыққа шәкірт болдық.
Dialogue: 0,1:40:19.55,1:40:22.64,Default,,0,0,0,,Кешіріңіз, мен айттым, бірақ тыңдамадың.
Dialogue: 0,1:40:23.05,1:40:25.35,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,1:40:26.43,1:40:28.06,Default,,0,0,0,,Сіз де тыңдаңыз.
Dialogue: 0,1:40:31.23,1:40:33.56,Default,,0,0,0,,Осы ауылдың жалпы ниетін айтамын.
Dialogue: 0,1:40:35.27,1:40:39.28,Default,,0,0,0,,Бүгін түстен кейін осы ауылдан кетуді сұрайды.
Dialogue: 0,1:40:41.03,1:40:43.57,Default,,0,0,0,,Бұл қорқынышты! Мен өз бетіммен шешім қабылдағаныма сене алар емеспін
Dialogue: 0,1:40:43.66,1:40:45.87,Default,,0,0,0,,Мен әлі жақсы емеспін.
Dialogue: 0,1:40:45.99,1:40:48.58,Default,,0,0,0,,Джоб Рут Бұл қазірдің өзінде шешілді.
Dialogue: 0,1:40:49.25,1:40:51.83,Default,,0,0,0,,Күте тұрыңыз! уәде бердік
Dialogue: 0,1:40:51.92,1:40:55.59,Default,,0,0,0,,Ол маған жұлдыздар туралы көп нәрсені үйретті, мен жұлдызды адам болатынымды білдім!
Dialogue: 0,1:40:55.67,1:40:58.51,Default,,0,0,0,,Жұлдыз болып, басқа ауылдарды аралау.
Dialogue: 0,1:40:58.63,1:41:02.05,Default,,0,0,0,,Мен солтүстікке барамын, мен оңтүстікке барамын, мен айға барамын
Dialogue: 0,1:41:02.43,1:41:03.84,Default,,0,0,0,,Бұл рұқсат етілмейді
Dialogue: 0,1:41:03.93,1:41:04.85,Default,,0,0,0,,Неге!
Dialogue: 0,1:41:06.01,1:41:10.31,Default,,0,0,0,,Бұл дүниеде жұлдызды адамдар өз рөлін аяқтап қойған.
Dialogue: 0,1:41:10.60,1:41:11.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:11.52,1:41:14.52,Default,,0,0,0,,Бұл барлық ересектердің қорытындысы.
Dialogue: 0,1:41:14.65,1:41:16.23,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:41:20.94,1:41:23.32,Default,,0,0,0,,Эзра және басқалары қателеседі!
Dialogue: 0,1:41:23.49,1:41:26.16,Default,,0,0,0,,Сіз бұл жұлдызды әлі көрген жоқсыз!
Dialogue: 0,1:41:26.28,1:41:28.62,Default,,0,0,0,,Жұлдыздарға қарасаң, міндетті түрде түсінесің
Dialogue: 0,1:41:28.70,1:41:30.62,Default,,0,0,0,,Сен неге жұлдыздарға қарамайсың?
Dialogue: 0,1:41:30.70,1:41:33.17,Default,,0,0,0,,Сіз соншалықты маңызды нәрсені шешіп жатырсыз ба?
Dialogue: 0,1:41:33.87,1:41:35.08,Default,,0,0,0,,Неге...
Dialogue: 0,1:41:35.38,1:41:37.63,Default,,0,0,0,,Мұндай маңызды нәрсе...
Dialogue: 0,1:41:39.34,1:41:40.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:40.71,1:41:41.72,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:41:41.88,1:41:44.51,Default,,0,0,0,,Өзіңіздің дұрыс екеніңізді қайдан білесіз?
Dialogue: 0,1:41:45.30,1:41:46.55,Default,,0,0,0,,Неге!
Dialogue: 0,1:41:46.93,1:41:48.26,Default,,0,0,0,,Неге!
Dialogue: 0,1:41:48.81,1:41:51.56,Default,,0,0,0,,Неге... неге...
Dialogue: 0,1:41:52.06,1:41:53.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:41:55.35,1:41:56.61,Default,,0,0,0,,Леви Ах...
Dialogue: 0,1:41:58.19,1:42:00.15,Default,,0,0,0,,Леви Әйүп Рут
Dialogue: 0,1:42:00.48,1:42:03.20,Default,,0,0,0,,Жақсы, рахмет.
Dialogue: 0,1:42:03.90,1:42:04.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:05.57,1:42:06.41,Default,,0,0,0,,Ах!
Dialogue: 0,1:42:06.87,1:42:10.20,Default,,0,0,0,,Барлығы маған өте мейірімді болды.
Dialogue: 0,1:42:10.45,1:42:12.45,Default,,0,0,0,,Мен оны шынымен бағалаймын.
Dialogue: 0,1:42:43.61,1:42:44.61,Default,,0,0,0,,Богиня
Dialogue: 0,1:42:45.11,1:42:48.45,Default,,0,0,0,,Жұлдызды адамдарға осы ауылда қалуға рұқсат етіңіз.
Dialogue: 0,1:42:49.03,1:42:51.79,Default,,0,0,0,,Біз сені міндетті түрде жақсы қыз етеміз.
Dialogue: 0,1:42:51.91,1:42:53.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:42:54.50,1:42:56.42,Default,,0,0,0,,Леви Әйүп Рут
Dialogue: 0,1:42:57.37,1:43:00.13,Default,,0,0,0,,Еремия маған өзінің осында екенін айтты.
Dialogue: 0,1:43:00.88,1:43:04.09,Default,,0,0,0,,Мен сендермен соңғы қоштасқым келді.
Dialogue: 0,1:43:04.88,1:43:06.26,Default,,0,0,0,,Сіз кетіп қалдыңыз ба?
Dialogue: 0,1:43:06.34,1:43:08.18,Default,,0,0,0,,Осы жерде ұзағырақ қалуыңызды өтінемін!
Dialogue: 0,1:43:08.30,1:43:11.18,Default,,0,0,0,,Біз әлі күнге дейін жұлдыздар туралы ештеңе білмейміз.
Dialogue: 0,1:43:11.26,1:43:12.81,Default,,0,0,0,,Осы машина туралы.
Dialogue: 0,1:43:13.56,1:43:16.64,Default,,0,0,0,,Мен өз кітабымды саған оқуға қалдырамын.
Dialogue: 0,1:43:17.48,1:43:19.06,Default,,0,0,0,,Бұл жеткіліксіз болса —
Dialogue: 0,1:43:19.19,1:43:22.69,Default,,0,0,0,,Үлкен елді мекенге барып, басқа кітап тауып ал.
Dialogue: 0,1:43:23.61,1:43:25.15,Default,,0,0,0,,Бұл әлем...
Dialogue: 0,1:43:25.57,1:43:29.03,Default,,0,0,0,,Сонда да білім алу мүмкін емес.
Dialogue: 0,1:43:29.57,1:43:32.83,Default,,0,0,0,,Үміттерің нық болғанша, үміт үзбе
Dialogue: 0,1:43:33.54,1:43:34.37,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:43:34.62,1:43:38.04,Default,,0,0,0,,Жарайды, сендердің қолдарыңнан келетініне сенімдімін.
Dialogue: 0,1:43:38.46,1:43:39.96,Default,,0,0,0,,Тағы біраз күтіңіз
Dialogue: 0,1:43:40.04,1:43:43.34,Default,,0,0,0,,Бәйбіше тілегіңді орындайтынына сенімдімін.
Dialogue: 0,1:43:43.63,1:43:47.80,Default,,0,0,0,,Құдайдың өзі барлық тілектерді орындай алмайды.
Dialogue: 0,1:43:48.22,1:43:49.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:49.72,1:43:50.55,Default,,0,0,0,,О...
Dialogue: 0,1:43:51.05,1:43:52.05,Default,,0,0,0,,О
Dialogue: 0,1:43:53.47,1:43:54.56,Default,,0,0,0,,Не болды?
Dialogue: 0,1:43:55.02,1:43:56.73,Default,,0,0,0,,Уа... ау...
Dialogue: 0,1:44:05.61,1:44:08.07,Default,,0,0,0,,Автоматты… Қуыршақ
Dialogue: 0,1:44:14.33,1:44:15.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:24.29,1:44:25.13,Default,,0,0,0,,Ах
Dialogue: 0,1:44:25.21,1:44:27.92,Default,,0,0,0,,Иә, құлақтың артында...
Dialogue: 0,1:44:28.47,1:44:30.51,Default,,0,0,0,,Мен ұяшыққа сенімдімін...
Dialogue: 0,1:44:34.22,1:44:35.06,Default,,0,0,0,,Ах
Dialogue: 0,1:44:36.39,1:44:39.69,Default,,0,0,0,,А, мен түсіндім... хехехе...
Dialogue: 0,1:44:40.85,1:44:43.15,Default,,0,0,0,,Ах... а
Dialogue: 0,1:44:46.48,1:44:47.36,Default,,0,0,0,,Oh?
Dialogue: 0,1:44:49.07,1:44:49.90,Default,,0,0,0,,Ата!
Dialogue: 0,1:44:49.99,1:44:51.07,Default,,0,0,0,,Ата!
Dialogue: 0,1:44:51.32,1:44:52.20,Default,,0,0,0,,Не болды?
Dialogue: 0,1:44:52.66,1:44:54.57,Default,,0,0,0,,Жұмыс, үлкенді шақыр! иә!
Dialogue: 0,1:44:54.66,1:44:55.74,Default,,0,0,0,,Ата
Dialogue: 0,1:44:55.83,1:44:57.20,Default,,0,0,0,,Ата!
Dialogue: 0,1:44:58.37,1:45:00.04,Default,,0,0,0,,(балалар жылайды)
Dialogue: 0,1:45:00.16,1:45:03.00,Default,,0,0,0,,Өйткені ол ұзақ және қатал жолда болды.
Dialogue: 0,1:45:03.13,1:45:06.29,Default,,0,0,0,,Өкпесі мен жүйкесі қатты зақымданса керек.
Dialogue: 0,1:45:07.55,1:45:10.59,Default,,0,0,0,,«Тіпті қысқа серуендеу немесе әңгіме...»
Dialogue: 0,1:45:10.72,1:45:12.88,Default,,0,0,0,,«Бұл қатты ауырған болуы керек».
Dialogue: 0,1:45:13.51,1:45:16.14,Default,,0,0,0,,«Бірақ ертең мен қайтадан оянамын...»
Dialogue: 0,1:45:16.22,1:45:19.81,Default,,0,0,0,,«Мүмкін сөйлесіп қалармыз», - деді Эзра.
Dialogue: 0,1:45:20.06,1:45:22.56,Default,,0,0,0,,Енді біраз демалып алайық.
Dialogue: 0,1:45:24.02,1:45:26.61,Default,,0,0,0,,Ендеше бүгін сен де ұйықтау керек.
Dialogue: 0,1:45:26.94,1:45:27.94,Default,,0,0,0,,Сәлем (3 адам) Иә.
Dialogue: 0,1:46:19.91,1:46:20.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:23.96,1:46:24.87,Default,,0,0,0,,Ой
Dialogue: 0,1:46:25.54,1:46:30.05,Default,,0,0,0,,Сен мені алып кетуге келдің бе? мен
Dialogue: 0,1:46:36.84,1:46:40.60,Default,,0,0,0,,Бір ғана қақпа бар ма?
Dialogue: 0,1:46:41.81,1:46:46.35,Default,,0,0,0,,Екі болса, бармаймын.
Dialogue: 0,1:47:01.79,1:47:02.70,Default,,0,0,0,,О
Dialogue: 0,1:47:04.70,1:47:05.54,Default,,0,0,0,,О...
Dialogue: 0,1:47:39.61,1:47:40.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:47:45.45,1:47:46.91,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,1:47:47.41,1:47:49.21,Default,,0,0,0,,Иә, біраз уақыт өтті.
Dialogue: 0,1:47:49.37,1:47:50.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:47:51.21,1:47:52.13,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,1:47:53.17,1:47:56.63,Default,,0,0,0,,Иә, мен роботпын.
Dialogue: 0,1:47:57.84,1:48:01.34,Default,,0,0,0,,Өтінемін, міне, мен саған сақтап қойған гүл шоғын.
Dialogue: 0,1:48:01.76,1:48:04.76,Default,,0,0,0,,Кешіріңіз, бұл ұзақ болды.
Dialogue: 0,1:48:05.81,1:48:09.06,Default,,0,0,0,,Ақыры саған бере алдым.
Dialogue: 0,1:48:09.77,1:48:10.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:48:11.48,1:48:13.23,Default,,0,0,0,,Енді сіз жылай аласыз.
Dialogue: 0,1:48:13.61,1:48:15.98,Default,,0,0,0,,Кешір, кешір.
Dialogue: 0,1:48:17.90,1:48:19.53,Default,,0,0,0,,Мен тұтынушы емеспін
Dialogue: 0,1:48:20.32,1:48:21.70,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:48:23.12,1:48:25.91,Default,,0,0,0,,Мен әрқашан рахмет айтқым келді
Dialogue: 0,1:48:27.04,1:48:28.58,Default,,0,0,0,,Мен шынымен ризамын.
Dialogue: 0,1:48:29.66,1:48:33.46,Default,,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,1:48:34.25,1:48:39.22,Default,,0,0,0,,Жұлдыздар туралы көп адамға айтып бергеніңіз үшін рахмет.
Dialogue: 0,1:48:39.76,1:48:41.72,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:48:42.14,1:48:43.01,Default,,0,0,0,,Ах
Dialogue: 0,1:48:51.94,1:48:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:48:55.65,1:48:56.61,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:48:57.90,1:48:59.03,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,1:49:00.20,1:49:01.28,Default,,0,0,0,,Марапатталады
Dialogue: 0,1:49:03.70,1:49:07.54,Default,,0,0,0,,Сонымен... бір сөз... бәрі.
Dialogue: 0,1:49:14.79,1:49:16.92,Default,,0,0,0,,Енді проекциялауды бастайық
Dialogue: 0,1:49:17.80,1:49:18.67,Default,,0,0,0,,Иә
Dialogue: 0,1:49:41.95,1:49:46.07,Default,,0,0,0,,Осы жерде ұйықтауға қуанышты болатыныңызға сенімдімін.
Dialogue: 0,1:49:46.83,1:49:47.66,Default,,0,0,0,,Иә
Dialogue: 0,1:49:47.74,1:49:51.20,Default,,0,0,0,,Бұл жер асты зиратынан да жақсырақ.
Dialogue: 0,1:49:52.37,1:49:55.63,Default,,0,0,0,,Жұлдыздардың адамдары аспанды көретін жерде болуы керек.
Dialogue: 0,1:49:57.96,1:50:00.26,Default,,0,0,0,,Мына жерде ай бар.
Dialogue: 0,1:50:00.46,1:50:03.09,Default,,0,0,0,,Иә, жұлдыздар да бар.
Dialogue: 0,1:50:05.43,1:50:07.97,Default,,0,0,0,,Болайық! Жұлдызды адамға
Dialogue: 0,1:50:08.81,1:50:09.64,Default,,0,0,0,,Иә
Dialogue: 0,1:50:25.28,1:50:30.29,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:56:23.10,1:56:28.10,Default,,0,0,0,,~♪
Dialogue: 0,1:56:32.69,1:56:35.02,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,1:56:35.65,1:56:38.95,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,1:56:39.57,1:56:41.86,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,1:56:42.78,1:56:46.87,Default,,0,0,0,,Сізді жұлдызға толы аспан күтіп тұр.
Dialogue: 0,1:56:48.41,1:56:50.62,Default,,0,0,0,,Планетарий туралы не айтасыз?
Dialogue: 0,1:56:51.67,1:56:54.96,Default,,0,0,0,,Қандай жағдай болмасын, ол ешқашан жоғалмайды
Dialogue: 0,1:56:55.75,1:56:58.13,Default,,0,0,0,,Әдемі шексіз жарқырау
Dialogue: 0,1:56:59.34,1:57:01.13,Default,,0,0,0,,Аспан жұлдыздарға толы...
Dialogue: 0,1:57:02.63,1:57:08.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory