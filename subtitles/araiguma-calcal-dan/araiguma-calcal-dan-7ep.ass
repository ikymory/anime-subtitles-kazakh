Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.98,STAFF 2,,0,0,0,,[²]，～
Dialogue: 0,0:00:00.00,0:00:02.98,STAFF 2,,0,0,0,,Жапондық көшіру және аударма және кейінгі кезең: Эча Роши мектебі және қауын: Корольдің мата жинағы
Dialogue: 0,0:00:00.00,0:00:03.00,-,,0,0,0,,Күмән! Менің бар екендігімнің дәлелі!
Dialogue: 1,0:00:00.73,0:00:02.20,-,,0,0,0,,Енот Carcar тобы
Dialogue: 0,0:00:00.73,0:00:02.20,-,,0,0,0,,...
Dialogue: 1,0:00:03.53,0:00:04.66,-,,0,0,0,,Ах, жарай берсін—
Dialogue: 0,0:00:03.53,0:00:04.66,-,,0,0,0,,——
Dialogue: 1,0:00:04.96,0:00:06.86,-,,0,0,0,,Сәлеметсіз бе, SNS аймағында
Dialogue: 0,0:00:04.96,0:00:06.86,-,,0,0,0,,Сыртқы түрі әлеуметтік деңгейдегі платформаға ұқсас
Dialogue: 1,0:00:06.86,0:00:09.53,-,,0,0,0,,Адамдар бізді енот емеспіз деп күдіктенетін сияқты.
Dialogue: 0,0:00:06.86,0:00:09.53,-,,0,0,0,,Мені кішкентай аю деп айыптады.
Dialogue: 0,0:00:06.13,0:00:07.57,-,,0,0,0,,Коен
Dialogue: 0,0:00:06.13,0:00:09.32,-,,0,0,0,,Аю көптен бері болды ма? w
Dialogue: 1,0:00:09.76,0:00:10.33,-,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:00:09.76,0:00:10.33,-,,0,0,0,,тақырып
Dialogue: 1,0:00:10.33,0:00:12.23,-,,0,0,0,,Біз ақымақ емеспіз бе?
Dialogue: 0,0:00:10.33,0:00:12.23,-,,0,0,0,,Бастапқыда мен Коен аю емеспін!?
Dialogue: 1,0:00:12.65,0:00:13.36,-,,0,0,0,,Сақал
Dialogue: 0,0:00:12.65,0:00:13.36,-,,0,0,0,,Аюдың өлімі
Dialogue: 0,0:00:12.65,0:00:13.36,-,,0,0,0,,⊂(;)⊃
Dialogue: 0,0:00:12.65,0:00:13.36,-,,0,0,0,,※（）， \h「」，⊂(;)⊃
Dialogue: 1,0:00:13.36,0:00:16.57,-,,0,0,0,,Жоқ, сіз қалай қарасаңыз да, біз жай ғана ақымақпыз.
Dialogue: 0,0:00:13.36,0:00:16.57,-,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 1,0:00:16.66,0:00:18.00,-,,0,0,0,,Мына қалың құйрыққа
Dialogue: 0,0:00:16.66,0:00:18.00,-,,0,0,0,,Сағаттың құйрығы
Dialogue: 1,0:00:18.00,0:00:19.10,-,,0,0,0,,Жолақты өрнек
Dialogue: 0,0:00:18.00,0:00:19.10,-,,0,0,0,,...
Dialogue: 1,0:00:19.10,0:00:21.10,-,,0,0,0,,Бұл жаттыққан дене
Dialogue: 0,0:00:19.10,0:00:21.10,-,,0,0,0,,Келесі денені жұмыстан шығаруға болады
Dialogue: 1,0:00:21.36,0:00:21.96,-,,0,0,0,,На
Dialogue: 0,0:00:21.36,0:00:21.96,-,,0,0,0,,Медбике
Dialogue: 0,0:00:22.96,0:00:25.88,-,,0,0,0,,Сіздің шегіңіз қандай?
Dialogue: 0,0:00:25.93,0:00:28.04,-,,0,0,0,,Сенің қолыңнан келеді... Түлкі мен енот 70%
Dialogue: 0,0:00:28.04,0:00:29.71,-,,0,0,0,,Түлкі мен енот ит
Dialogue: 0,0:00:28.04,0:00:29.71,-,,0,0,0,,Коен аю
Dialogue: 1,0:00:28.29,0:00:28.83,-,,0,0,0,,О
Dialogue: 0,0:00:28.29,0:00:28.83,-,,0,0,0,,О?
Dialogue: 1,0:00:30.00,0:00:30.83,-,,0,0,0,,Иә
Dialogue: 0,0:00:30.00,0:00:30.83,-,,0,0,0,,...
Dialogue: 1,0:00:31.43,0:00:35.00,-,,0,0,0,,Жарайды, егер 30% десең, бұл шақпақ болады.
Dialogue: 0,0:00:31.43,0:00:35.00,-,,0,0,0,,Бар болмыс 3-ті шағын деуге болады
Dialogue: 1,0:00:35.18,0:00:35.96,-,,0,0,0,,Гокури
Dialogue: 0,0:00:35.18,0:00:35.96,-,,0,0,0,,（）
Dialogue: 1,0:00:37.64,0:00:38.43,-,,0,0,0,,Ахаха
Dialogue: 0,0:00:37.64,0:00:38.43,-,,0,0,0,,(lol)
Dialogue: 0,0:00:36.59,0:00:42.27,-,,0,0,0,,Сіздің шегіңіз қандай?
Dialogue: 0,0:00:40.35,0:00:42.27,-,,0,0,0,,Сіз ең жақсысыз...Кішкентай аю мысық 100%
Dialogue: 0,0:00:40.35,0:00:42.27,-,,0,0,0,,Кішкентай аю мысық
Dialogue: 1,0:00:43.40,0:00:45.73,-,,0,0,0,,Ауыз қуысынан эктоплазманың бұлыңғырлануы
Dialogue: 0,0:00:43.40,0:00:45.73,-,,0,0,0,,Жан пайда болды
Dialogue: 0,0:00:43.40,0:00:45.73,-,,0,0,0,,※Эктоплазма: Эктоплазма, дененің физикалық беті, әсіресе ауыз, мұрын, құлақша, т.б. Ол цилиндр тәрізді, сұйық, қатты және т.б. әр түрлі пішінде көрінеді.
Dialogue: 1,0:00:46.00,0:00:47.63,-,,0,0,0,,Мен кіммін...?
Dialogue: 0,0:00:46.00,0:00:47.63,-,,0,0,0,,Менің түпкі мақсатым осы.
Dialogue: 1,0:00:49.10,0:00:50.26,-,,0,0,0,,Хмм~
Dialogue: 0,0:00:49.10,0:00:50.26,-,,0,0,0,,～
Dialogue: 0,0:00:53.00,0:00:54.46,-,,0,0,0,,Сіз мұны істей аласыз...Кендзиро Цуда 60%
Dialogue: 0,0:00:54.45,0:00:55.91,-,,0,0,0,,Қасқыр
Dialogue: 0,0:00:54.45,0:00:55.91,-,,0,0,0,,Бөлім
Dialogue: 1,0:00:58.74,0:00:59.30,-,,0,0,0,,Иә?
Dialogue: 0,0:00:58.74,0:00:59.30,-,,0,0,0,,Аты?
