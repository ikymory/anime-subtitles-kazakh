Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.85,0:00:03.56,Default,,0,0,0,,Императорлық күнтізбе 2018
Dialogue: 0,0:00:03.68,0:00:07.10,Default,,0,0,0,,Әлемдік үстемдікті алға жылжытатын Қасиетті Британ империясының алдында -
Dialogue: 0,0:00:07.23,0:00:09.69,Default,,0,0,0,,Бір террорист қайта тірілді
Dialogue: 0,0:00:09.82,0:00:11.57,Default,,0,0,0,,Оның аты нөлге тең
Dialogue: 0,0:00:11.69,0:00:15.82,Default,,0,0,0,,Жұмбақ қыздан алынған абсолютті мойынсұнушылық күші С.С.
Dialogue: 0,0:00:15.95,0:00:19.49,Default,,0,0,0,,Геассты пайдаланып, Зеро қайтадан шайқасуды шешеді.
Dialogue: 0,0:00:20.91,0:00:21.66,Default,,0,0,0,,Колониялар -
Dialogue: 0,0:00:22.08,0:00:25.50,Default,,0,0,0,,Бұл толқындар 11-аймаққа айналған Жапониядан басталады.
Dialogue: 0,0:00:25.92,0:00:29.92,Default,,0,0,0,,Заманға, адамдардың жүрегіне не қалдырамыз?
Dialogue: 0,0:00:30.04,0:00:32.96,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:33.17,0:00:38.59,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:00:38.72,0:00:41.39,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:00:41.51,0:00:44.31,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:00:44.43,0:00:49.86,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:00:49.98,0:00:52.82,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:00:52.94,0:00:55.70,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:01:01.49,0:01:06.96,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:01:07.08,0:01:12.55,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:01:12.67,0:01:15.42,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:01:15.55,0:01:17.97,Default,,0,0,0,,♪Сырылдап, дыбыстай бастайды
Dialogue: 0,0:01:18.26,0:01:20.89,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:01:21.05,0:01:24.02,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:01:24.27,0:01:27.06,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:27.18,0:01:29.60,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:31.23,0:01:36.49,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:01:36.61,0:01:38.95,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:01:39.41,0:01:42.24,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:01:42.37,0:01:47.75,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:01:47.87,0:01:50.37,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:01:50.50,0:01:54.96,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:01:55.09,0:01:59.43,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:02:08.81,0:02:10.73,Default,,0,0,0,,Қай барлау бюросына бірінші болып асығып кірді?
Dialogue: 0,0:02:10.85,0:02:11.77,Default,,0,0,0,,Әлі байланыс жоқ
Dialogue: 0,0:02:11.98,0:02:14.11,Default,,0,0,0,,Қақпаның концентрациясы азаюы керек.
Dialogue: 0,0:02:14.23,0:02:15.44,Default,,0,0,0,,4-барлау станциясы
Dialogue: 0,0:02:15.57,0:02:17.82,Default,,0,0,0,,Қара рыцарьлар деп есептелген лаңкестер...
Dialogue: 0,0:02:17.94,0:02:19.70,Default,,0,0,0,,Мен әлі күнге дейін Бабель мұнарасында баррикададамын.
Dialogue: 0,0:02:20.45,0:02:22.74,Default,,0,0,0,,Жаудың Nightmare кадрының бар екенін растаңыз
Dialogue: 0,0:02:22.95,0:02:23.78,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:23.91,0:02:26.54,Default,,0,0,0,,7-ші арнайы дивизия төменнен кіруі керек.
Dialogue: 0,0:02:26.79,0:02:27.91,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:02:30.92,0:02:32.17,Default,,0,0,0,,Бұл енді мүмкін емес, қашайық.
Dialogue: 0,0:02:32.50,0:02:34.21,Default,,0,0,0,,Сәл ұзағырақ ұстаңыз
Dialogue: 0,0:02:34.34,0:02:36.55,Default,,0,0,0,,Нөл мұнда құрылымды түсінгенше
Dialogue: 0,0:02:36.67,0:02:38.09,Default,,0,0,0,,Біз де қолдау көрсетеміз.
Dialogue: 0,0:02:40.68,0:02:41.80,Default,,0,0,0,,Лелуш
Dialogue: 0,0:02:43.39,0:02:45.43,Default,,0,0,0,,Дұрыс, мен нөлмін.
Dialogue: 0,0:02:54.86,0:02:55.48,Default,,0,0,0,,Уфф
Dialogue: 0,0:02:55.61,0:02:56.82,Default,,0,0,0,,Ах, нөл
Dialogue: 0,0:02:57.11,0:02:58.44,Default,,0,0,0,,Бұл Лелуш
Dialogue: 0,0:02:58.57,0:02:59.19,Default,,0,0,0,,Уф
Dialogue: 0,0:02:59.32,0:03:02.03,Default,,0,0,0,,Жапондар сені пайдаланған адам.
Dialogue: 0,0:03:02.15,0:03:04.49,Default,,0,0,0,,Ондай адамды қорғағың келе ме?
Dialogue: 0,0:03:06.03,0:03:07.74,Default,,0,0,0,,Уф
Dialogue: 0,0:03:07.87,0:03:11.08,Default,,0,0,0,,Уф
Dialogue: 0,0:03:13.54,0:03:14.67,Default,,0,0,0,,Әй
Dialogue: 0,0:03:14.83,0:03:17.88,Default,,0,0,0,,Нөл Мен сені аяқтаймын
Dialogue: 0,0:03:19.42,0:03:20.30,Default,,0,0,0,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,0:03:21.30,0:03:24.39,Default,,0,0,0,,Өткеніме, Созақудан жеңілдім
Dialogue: 0,0:03:25.97,0:03:27.64,Default,,0,0,0,,Ал оған -
Dialogue: 0,0:03:28.89,0:03:31.43,Default,,0,0,0,,Британ императорының алдына әкелінді
Dialogue: 0,0:03:31.56,0:03:32.44,Default,,0,0,0,,Гуах
Dialogue: 0,0:03:35.86,0:03:39.07,Default,,0,0,0,,Тақтың бұрынғы 17-ші мұрагері -
Dialogue: 0,0:03:39.19,0:03:41.53,Default,,0,0,0,,Лелуш ви Британия
Dialogue: 0,0:03:41.65,0:03:44.78,Default,,0,0,0,,Көп болды, балам.
Dialogue: 0,0:03:44.91,0:03:47.24,Default,,0,0,0,,Қайырлы Раббым!
Dialogue: 0,0:03:47.53,0:03:48.99,Default,,0,0,0,,Geass қолданбаңыз
Dialogue: 0,0:03:49.12,0:03:51.04,Default,,0,0,0,,Уф
Dialogue: 0,0:03:51.66,0:03:53.79,Default,,0,0,0,,Тек Флюгель отбасына арнайы жеткізілген.
Dialogue: 0,0:03:53.91,0:03:57.71,Default,,0,0,0,,Мәртебелі, мен өзімді империяның ең күшті он екі рыцарьсы деп есептеймін.
Dialogue: 0,0:03:57.84,0:04:00.00,Default,,0,0,0,,Қоңыр түніне қосыңыз
Dialogue: 0,0:04:00.25,0:04:04.18,Default,,0,0,0,,Нөлді түсіргенім үшін маған сыйлық беріңізші?
Dialogue: 0,0:04:04.47,0:04:05.63,Default,,0,0,0,,Сіз
Dialogue: 0,0:04:05.76,0:04:07.64,Default,,0,0,0,,Мен саған айттым, Лелуч.
Dialogue: 0,0:04:07.76,0:04:10.89,Default,,0,0,0,,Мен бұл әлемді іштен өзгертемін
Dialogue: 0,0:04:11.02,0:04:12.98,Default,,0,0,0,,Жоғары көтерілу үшін достарыңызды сатасыз ба?
Dialogue: 0,0:04:13.10,0:04:13.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:14.06,0:04:14.89,Default,,0,0,0,,Не?
Dialogue: 0,0:04:15.56,0:04:19.02,Default,,0,0,0,,Жарайды, маған қазіргі жауап ұнады.
Dialogue: 0,0:04:19.15,0:04:19.77,Default,,0,0,0,,Құт
Dialogue: 0,0:04:20.23,0:04:23.86,Default,,0,0,0,,Браун рыцарларына бұйрық береді
Dialogue: 0,0:04:23.99,0:04:25.95,Default,,0,0,0,,Нөлдің сол көзін жабыңыз
Dialogue: 0,0:04:26.32,0:04:28.45,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:04:28.70,0:04:33.87,Default,,0,0,0,,Ханзада бола тұра бас көтерген лайықсыз ұл.
Dialogue: 0,0:04:34.00,0:04:37.37,Default,,0,0,0,,Бірақ әлі де қолданыстар бар.
Dialogue: 0,0:04:37.50,0:04:38.83,Default,,0,0,0,,Не?
Dialogue: 0,0:04:39.08,0:04:41.42,Default,,0,0,0,,Жадты қайта жазу
Dialogue: 0,0:04:41.55,0:04:44.51,Default,,0,0,0,,Марианна туралы нөл болу
Dialogue: 0,0:04:44.63,0:04:46.80,Default,,0,0,0,,Nunnally туралы
Dialogue: 0,0:04:47.18,0:04:49.09,Default,,0,0,0,,Шынымен Геасс па?
Dialogue: 0,0:04:49.22,0:04:52.97,Default,,0,0,0,,Барлығын ұмытып, жай ғана адам бол.
Dialogue: 0,0:04:53.10,0:04:56.31,Default,,0,0,0,,Тоқта, сен тағы менен ұрламақшысың ба?
Dialogue: 0,0:04:56.44,0:04:58.81,Default,,0,0,0,,Анадан Нунеллиге
Dialogue: 0,0:04:59.23,0:05:02.23,Default,,0,0,0,,Британдық Чарльз ойып салған
Dialogue: 0,0:05:02.36,0:05:03.57,Default,,0,0,0,,Ештеңе істей алмаймыз.
Dialogue: 0,0:05:03.78,0:05:06.40,Default,,0,0,0,,Жаңа жалған жады
Dialogue: 0,0:05:06.61,0:05:09.24,Default,,0,0,0,,Увааааааааааааааааааааааааааа
Dialogue: 0,0:05:16.25,0:05:17.29,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:05:17.41,0:05:20.75,Default,,0,0,0,,Гиссті ол адамға берген мен емес едім.
Dialogue: 0,0:05:20.88,0:05:21.50,Default,,0,0,0,,Хун
Dialogue: 0,0:05:22.46,0:05:23.84,Default,,0,0,0,,Nunnally қайда орналасқан?
Dialogue: 0,0:05:23.96,0:05:28.26,Default,,0,0,0,,Әпкеңді іздеп көрейін десем де, Қара рыцарьлар қираған күйде емес.
Dialogue: 0,0:05:28.38,0:05:29.80,Default,,0,0,0,,Сакиокоға не болды?
Dialogue: 0,0:05:30.26,0:05:33.01,Default,,0,0,0,,Диетардпен Қытай Федерациясына қашып кеткен.
Dialogue: 0,0:05:34.18,0:05:36.60,Default,,0,0,0,,Ол әйел Нөлдің шынайы тұлғасын білмейді.
Dialogue: 0,0:05:36.98,0:05:40.35,Default,,0,0,0,,Егер сіз Нунеллидің маңыздылығын түсінбесеңіз, көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:05:40.48,0:05:41.31,Default,,0,0,0,,Хун
Dialogue: 0,0:05:43.23,0:05:46.15,Default,,0,0,0,,Геассты императорға берген адамды табыңыз.
Dialogue: 0,0:05:46.28,0:05:47.53,Default,,0,0,0,,Нуннальды...
Dialogue: 0,0:05:48.82,0:05:49.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.91,0:05:52.78,Default,,0,0,0,,Менің қарындасым бар, бірақ інім жоқ.
Dialogue: 0,0:05:53.33,0:05:55.20,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:05:55.95,0:05:56.75,Default,,0,0,0,,Ах
Dialogue: 0,0:05:57.41,0:05:59.37,Default,,0,0,0,,Жақсы, бұл британдық армия.
Dialogue: 0,0:05:59.50,0:06:01.21,Default,,0,0,0,,Мен ағамды іздеп жүрмін.
Dialogue: 0,0:06:02.59,0:06:06.92,Default,,0,0,0,,Ғимараттың құрылымдық сызбасы бар, бірақ сәйкестендіру нөмірі туралы жазба жоқ.
Dialogue: 0,0:06:07.05,0:06:09.01,Default,,0,0,0,,Бұл Nightmare әлі де қолданыла ма?
Dialogue: 0,0:06:09.13,0:06:10.51,Default,,0,0,0,,Онда не істеп жүрсің!
Dialogue: 0,0:06:11.93,0:06:13.64,Default,,0,0,0,,Ол киімдер, сен студентсің бе?
Dialogue: 0,0:06:14.64,0:06:18.60,Default,,0,0,0,,Сіз солдатсыз ба? Рақмет сізге. Осы кісіні тез емдеңіздерші.
Dialogue: 0,0:06:21.31,0:06:25.40,Default,,0,0,0,,Құпия барлау қызметі? Мәртебелі императордың тікелей бақылауымен не болды?
Dialogue: 0,0:06:26.53,0:06:30.57,Default,,0,0,0,,Жарайды, ақпарат бойынша, Қарарес әскері мен туралы білмейді.
Dialogue: 0,0:06:30.70,0:06:32.87,Default,,0,0,0,,Мен бұл жігіттің деректерін пайдалана алмаймын.
Dialogue: 0,0:06:33.95,0:06:35.20,Default,,0,0,0,,Тірі қалған жалғыз адам бар ма?
Dialogue: 0,0:06:35.33,0:06:37.54,Default,,0,0,0,,Иә, бұл тек сенсің.
Dialogue: 0,0:06:37.83,0:06:38.58,Default,,0,0,0,,Не?
Dialogue: 0,0:06:38.70,0:06:39.71,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:41.00,0:06:43.75,Default,,0,0,0,,Маған қорқынышты түсіңді бер
Dialogue: 0,0:06:54.05,0:06:55.01,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:55.64,0:06:59.89,Default,,0,0,0,,Сәйкестендіру нөмірі – QR5 YK1D6
Dialogue: 0,0:07:00.64,0:07:01.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:02.48,0:07:06.69,Default,,0,0,0,,Қарсыластың көзіне тура қарамайынша, Геасс қолданылмайды.
Dialogue: 0,0:07:07.48,0:07:09.74,Default,,0,0,0,,Өлмейтін бақсы маған айтқым келмейді
Dialogue: 0,0:07:09.99,0:07:10.90,Default,,0,0,0,,Әй
Dialogue: 0,0:07:12.15,0:07:14.91,Default,,0,0,0,,Сіз қарсы тұрасыз ба? Террорист пе?
Dialogue: 0,0:07:15.03,0:07:17.12,Default,,0,0,0,,Иә, менің армиямның түнгі түні...
Dialogue: 0,0:07:17.24,0:07:19.04,Default,,0,0,0,,Ол қолға түскен сияқты.
Dialogue: 0,0:07:19.16,0:07:20.25,Default,,0,0,0,,Масқара
Dialogue: 0,0:07:20.37,0:07:21.96,Default,,0,0,0,,Бірақ жау аз
Dialogue: 0,0:07:22.37,0:07:24.17,Default,,0,0,0,,Қарсы болмасаңыз, мен
Dialogue: 0,0:07:24.50,0:07:27.92,Default,,0,0,0,,Жоқ, сіз жай ғана қонақтың капитанысыз.
Dialogue: 0,0:07:28.84,0:07:31.38,Default,,0,0,0,,Губернатор ретінде мен осында баруым керек.
Dialogue: 0,0:07:31.51,0:07:32.47,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:07:33.01,0:07:34.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:34.76,0:07:37.39,Default,,0,0,0,,Қытай тағамындағы дәмдеуіштер дәмді емес.
Dialogue: 0,0:07:37.51,0:07:39.47,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:07:39.72,0:07:40.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:41.06,0:07:42.35,Default,,0,0,0,,Адамның аң аулауы
Dialogue: 0,0:07:42.48,0:07:43.94,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:07:50.03,0:07:51.99,Default,,0,0,0,,Британияның жарылуы
Dialogue: 0,0:08:02.00,0:08:05.25,Default,,0,0,0,,Жақсы жұмыс 1-тоқсан Әрі қарай 21-қабатқа барыңыз.
Dialogue: 0,0:08:05.62,0:08:07.46,Default,,0,0,0,,P4 баспалдақтарды блоктайды.
Dialogue: 0,0:08:09.38,0:08:11.01,Default,,0,0,0,,R5 солға 30 градус
Dialogue: 0,0:08:14.09,0:08:17.72,Default,,0,0,0,,N1 Сол жерден 50 метр жерде төбеге қарай оқ атыңыз
Dialogue: 0,0:08:25.31,0:08:26.85,Default,,0,0,0,,Сэр Эмилио байланыс жоғалуы
Dialogue: 0,0:08:26.98,0:08:28.36,Default,,0,0,0,,IFF кодын өзгерту
Dialogue: 0,0:08:28.48,0:08:29.94,Default,,0,0,0,,Бұл бесінші рет
Dialogue: 0,0:08:30.07,0:08:31.07,Default,,0,0,0,,Ортиз отряды жойылды
Dialogue: 0,0:08:31.65,0:08:34.28,Default,,0,0,0,,Идиот Террористерді кім басқарады?
Dialogue: 0,0:08:34.40,0:08:35.82,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:35.95,0:08:36.82,Default,,0,0,0,,Губернатор
Dialogue: 0,0:08:39.78,0:08:42.33,Default,,0,0,0,,Нөлдің шынайы тұлғасы студент емес.
Dialogue: 0,0:08:42.45,0:08:45.29,Default,,0,0,0,,Бірақ бәрі басқаша.
Dialogue: 0,0:08:45.50,0:08:46.54,Default,,0,0,0,,Жаяу әскер бөлімдері
Dialogue: 0,0:08:46.67,0:08:49.13,Default,,0,0,0,,Нөл тартып алған Сазерленд әлі де қалды.
Dialogue: 0,0:08:49.25,0:08:50.17,Default,,0,0,0,,Тез кіріңіз
Dialogue: 0,0:08:50.79,0:08:52.21,Default,,0,0,0,,Сізде нөл болғанша ұта аласыз
Dialogue: 0,0:08:52.34,0:08:53.63,Default,,0,0,0,,Ғажайыптар орын алады
Dialogue: 0,0:08:53.76,0:08:55.17,Default,,0,0,0,,Оян
Dialogue: 0,0:08:55.42,0:08:56.30,Default,,0,0,0,,Террористер
Dialogue: 0,0:08:59.34,0:09:03.72,Default,,0,0,0,,Хехехе Губернатор Каралестің келетін уақыты келді деп ойлаймын?
Dialogue: 0,0:09:03.85,0:09:04.81,Default,,0,0,0,,Іс жақсы жүріп жатқан сияқты.
Dialogue: 0,0:09:04.93,0:09:08.27,Default,,0,0,0,,Иә? Карен, 21-қабатқа барайық.
Dialogue: 0,0:09:08.81,0:09:10.73,Default,,0,0,0,,Мен сенің жаныңда болғым келді
Dialogue: 0,0:09:13.03,0:09:15.11,Default,,0,0,0,,Ақыры екеуміз жалғыз болдық.
Dialogue: 0,0:09:18.61,0:09:23.20,Default,,0,0,0,,11-ауданда біреу қармақ алған сияқты.
Dialogue: 0,0:09:23.33,0:09:24.83,Default,,0,0,0,,Бұл C.C.?
Dialogue: 0,0:09:25.00,0:09:26.75,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:09:27.50,0:09:33.17,Default,,0,0,0,,Куруруги: Сіз бұл жерге бірінші болып кірдіңіз, тіпті Лоундесте де.
Dialogue: 0,0:09:33.50,0:09:36.09,Default,,0,0,0,,Бұл жерді тіпті Шнайзел де, басқалары да білмейді.
Dialogue: 0,0:09:36.22,0:09:37.80,Default,,0,0,0,,Бұл құрмет, Мәртебелі.
Dialogue: 0,0:09:37.93,0:09:39.84,Default,,0,0,0,,Бірақ неге мен?
Dialogue: 0,0:09:39.97,0:09:43.68,Default,,0,0,0,,Раундтарда тек сіз білесіз
Dialogue: 0,0:09:46.14,0:09:48.81,Default,,0,0,0,,Нөлдің шынайы тұлғасы және Геасс
Dialogue: 0,0:09:48.94,0:09:49.90,Default,,0,0,0,,Ах
Dialogue: 0,0:09:51.31,0:09:52.15,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:52.98,0:09:54.19,Default,,0,0,0,,Храм?
Dialogue: 0,0:09:54.32,0:09:55.94,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:09:56.07,0:10:00.66,Default,,0,0,0,,Бұл Құдайды жою қаруы.
Dialogue: 0,0:10:00.86,0:10:01.78,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:10:01.91,0:10:04.83,Default,,0,0,0,,Ол Акашаның қылышы деп аталады.
Dialogue: 0,0:10:10.33,0:10:14.50,Default,,0,0,0,,Каминеджимада нөлді тастап кеткенде не айтып тұрсыз?
Dialogue: 0,0:10:14.63,0:10:18.59,Default,,0,0,0,,Лелуш Сіз мені осы уақыт бойы алдап жүрдіңіз.
Dialogue: 0,0:10:18.72,0:10:21.51,Default,,0,0,0,,Нөл шынымен сіздің сыныптасыңыз болды ма?
Dialogue: 0,0:10:21.64,0:10:24.56,Default,,0,0,0,,Әлде бұл Геастың күші ме?
Dialogue: 0,0:10:24.68,0:10:25.64,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:10:26.97,0:10:28.10,Default,,0,0,0,,Маған жауап бер
Dialogue: 0,0:10:28.23,0:10:30.85,Default,,0,0,0,,Сіз маған да Geass қолдандыңыз ба?
Dialogue: 0,0:10:30.98,0:10:34.02,Default,,0,0,0,,Менің ойымды мойынсұнуға айналдыр
Dialogue: 0,0:10:34.15,0:10:35.07,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:10:35.19,0:10:35.82,Default,,0,0,0,,Лелуш
Dialogue: 0,0:10:36.36,0:10:38.65,Default,,0,0,0,,Жүрегің өзіңдікі
Dialogue: 0,0:10:38.78,0:10:41.03,Default,,0,0,0,,Менің барлық адалдығым мен нөлге деген сүйіспеншілігім
Dialogue: 0,0:10:41.16,0:10:41.82,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:10:42.45,0:10:44.70,Default,,0,0,0,,Карен, мақтануға болады.
Dialogue: 0,0:10:45.08,0:10:46.12,Default,,0,0,0,,Сіз шешім қабылдадыңыз.
Dialogue: 0,0:10:46.66,0:10:48.33,Default,,0,0,0,,Сіз оны таңдадыңыз.
Dialogue: 0,0:10:49.00,0:10:50.00,Default,,0,0,0,,Бұл…
Dialogue: 0,0:10:50.79,0:10:51.83,Default,,0,0,0,,мен
Dialogue: 0,0:10:52.37,0:10:53.54,Default,,0,0,0,,Уф
Dialogue: 0,0:10:53.79,0:10:55.21,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:10:57.71,0:11:00.92,Default,,0,0,0,,Сенгім келеді, сондықтан құл болсам да
Dialogue: 0,0:11:01.76,0:11:02.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:03.14,0:11:05.76,Default,,0,0,0,,Бірақ мен нөлге сенемін.
Dialogue: 0,0:11:05.89,0:11:08.02,Default,,0,0,0,,Лелуш, бұл сен емессің.
Dialogue: 0,0:11:08.14,0:11:09.93,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:11:10.06,0:11:11.23,Default,,0,0,0,,Айтпақшы, иә?
Dialogue: 0,0:11:11.39,0:11:13.19,Default,,0,0,0,,Осылай қашанға дейін тұрасың?
Dialogue: 0,0:11:13.31,0:11:14.15,Default,,0,0,0,,Ах
Dialogue: 0,0:11:15.65,0:11:17.52,Default,,0,0,0,,Маған қарама, бұзық.
Dialogue: 0,0:11:17.69,0:11:19.61,Default,,0,0,0,,Нөлге қарай Айтудың жолы
Dialogue: 0,0:11:19.74,0:11:21.95,Default,,0,0,0,,Иә, мен Лелушка айттым.
Dialogue: 0,0:11:22.07,0:11:22.91,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:11:23.03,0:11:23.99,Default,,0,0,0,,(Коммуникатордың қоңырау үні)
Dialogue: 0,0:11:24.11,0:11:24.78,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:25.16,0:11:26.91,Default,,0,0,0,,Британияда күшейтулер пайда болды.
Dialogue: 0,0:11:27.03,0:11:29.45,Default,,0,0,0,,Бұл үлкен сан. Не істеуім керек?
Dialogue: 0,0:11:29.66,0:11:31.66,Default,,0,0,0,,Сіз бұлай жеңе алмайсыз
Dialogue: 0,0:11:33.87,0:11:35.38,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:38.42,0:11:40.80,Default,,0,0,0,,4-ші арнайы құрал төмен түсе бастайды.
Dialogue: 0,0:11:40.92,0:11:43.09,Default,,0,0,0,,Қытай Федерациясына көрсетіңіз
Dialogue: 0,0:11:43.22,0:11:44.97,Default,,0,0,0,,Императордың ұлы мәртебелі
Dialogue: 0,0:11:45.26,0:11:48.39,Default,,0,0,0,,Біздің Қасиетті Британ империясының күші
Dialogue: 0,0:11:48.51,0:11:50.52,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:12:00.32,0:12:02.07,Default,,0,0,0,,Бұл да жоғарыдан келді.
Dialogue: 0,0:12:02.19,0:12:03.20,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:03.70,0:12:04.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.41,0:12:07.62,Default,,0,0,0,,Губернатор Каларес шықты деп ойлаймын.
Dialogue: 0,0:12:07.74,0:12:10.33,Default,,0,0,0,,Өйткені қашу қиын
Dialogue: 0,0:12:11.41,0:12:12.66,Default,,0,0,0,,Сен осы жолы сол тікұшаққа мінгің келмейтін шығар, иә?
Dialogue: 0,0:12:19.29,0:12:22.80,Default,,0,0,0,,Екінші шабуыл күші J қабатын бақылауды аяқтады.
Dialogue: 0,0:12:22.92,0:12:25.97,Default,,0,0,0,,Қара рыцарьлар үшін бір ғана қашу жолы қалды.
Dialogue: 0,0:12:26.39,0:12:29.68,Default,,0,0,0,,Бірақ біздің негізгі күшіміз сонда орналасқан.
Dialogue: 0,0:12:29.93,0:12:32.22,Default,,0,0,0,,Иә, оларды қуып шығу ғана қалды.
Dialogue: 0,0:12:32.60,0:12:34.39,Default,,0,0,0,,Баспасөзге шығуды ұйымдастыру.
Dialogue: 0,0:12:34.52,0:12:36.90,Default,,0,0,0,,Террористер көпшілік алдында өлім жазасына кесілуге ​​лайық.
Dialogue: 0,0:12:37.56,0:12:39.98,Default,,0,0,0,,Жау жеңіске сенімді болуы керек.
Dialogue: 0,0:12:40.44,0:12:42.65,Default,,0,0,0,,Шарттар жойылуда
Dialogue: 0,0:12:42.78,0:12:44.40,Default,,0,0,0,,Бұл қабат ше?
Dialogue: 0,0:12:44.61,0:12:46.11,Default,,0,0,0,,10 минут ішінде болуы мүмкін
Dialogue: 0,0:12:46.24,0:12:49.57,Default,,0,0,0,,Егер мен түсінсем, мен оны ағымдағы реттеумен қорғай аламын.
Dialogue: 0,0:12:49.91,0:12:51.49,Default,,0,0,0,,Диетард қалай дайындалады?
Dialogue: 0,0:12:51.62,0:12:53.08,Default,,0,0,0,,Жүйе тірі болды.
Dialogue: 0,0:12:53.20,0:12:55.25,Default,,0,0,0,,Барлығы стратегияға негізделген
Dialogue: 0,0:12:55.37,0:12:58.58,Default,,0,0,0,,Бұл B2 (Екі) Бір ғана жау бар Nightmare.
Dialogue: 0,0:12:58.71,0:12:59.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:59.46,0:13:01.42,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:13:01.84,0:13:03.30,Default,,0,0,0,,B2? Не?
Dialogue: 0,0:13:04.13,0:13:06.26,Default,,0,0,0,,Қарсылас IFF жойды ма?
Dialogue: 0,0:13:06.38,0:13:08.05,Default,,0,0,0,,Және ол жалғыз әрекет етіп жүр.
Dialogue: 0,0:13:08.43,0:13:13.06,Default,,0,0,0,,Нөл Бұл P6 Жау – жау Уау!
Dialogue: 0,0:13:13.18,0:13:14.02,Default,,0,0,0,,Ｐ６？
Dialogue: 0,0:13:14.14,0:13:16.73,Default,,0,0,0,,Бұл R5 R1 шабуылға ұшырады...
Dialogue: 0,0:13:17.77,0:13:20.11,Default,,0,0,0,,Бұл жаман. Бұлай жалғаса берсе, міне.
Dialogue: 0,0:13:21.52,0:13:24.32,Default,,0,0,0,,Нөл, тек қазір қашып кетуге болады.
Dialogue: 0,0:13:24.57,0:13:28.86,Default,,0,0,0,,Егер біз бастапқыда диверсиялық, лақтыратын стратегия болсақ.
Dialogue: 0,0:13:28.99,0:13:29.66,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:13:29.78,0:13:30.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.74,0:13:32.41,Default,,0,0,0,,Сіз қателесесіз, Урабе.
Dialogue: 0,0:13:32.53,0:13:36.00,Default,,0,0,0,,Британияны қысқарту арқылы оны жеңе алмайсыз.
Dialogue: 0,0:13:36.12,0:13:36.96,Default,,0,0,0,,Ах
Dialogue: 0,0:13:38.87,0:13:39.96,Default,,0,0,0,,Бөлімше командирі
Dialogue: 0,0:13:40.29,0:13:41.13,Default,,0,0,0,,Баруға болады ма?
Dialogue: 0,0:13:41.25,0:13:43.55,Default,,0,0,0,,Иә, бұл материалдық кіреберіс.
Dialogue: 0,0:13:43.80,0:13:47.67,Default,,0,0,0,,Ах, бұл қабатқа жетудің төте жолы.
Dialogue: 0,0:13:59.77,0:14:00.94,Default,,0,0,0,,Расталған
Dialogue: 0,0:14:01.35,0:14:04.40,Default,,0,0,0,,Бұл Ланселот негізіндегі жаппай өндірістің прототипі ме?
Dialogue: 0,0:14:04.82,0:14:07.61,Default,,0,0,0,,Иә, бірақ қазір қамауға алатын уақыт емес.
Dialogue: 0,0:14:07.82,0:14:08.65,Default,,0,0,0,,Оны жойыңыз.
Dialogue: 0,0:14:08.78,0:14:10.24,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:10.36,0:14:11.95,Default,,0,0,0,,Не? Ол жоғалып кетті ме?
Dialogue: 0,0:14:12.07,0:14:12.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.82,0:14:14.33,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:14:14.45,0:14:16.75,Default,,0,0,0,,Тоқтай тұрыңыз, ол жоғалып кетті дегеніңіз не?
Dialogue: 0,0:14:40.52,0:14:41.23,Default,,0,0,0,,Ｃ.Ｃ.！
Dialogue: 0,0:14:41.56,0:14:43.81,Default,,0,0,0,,Бұл қабат әлі біткен жоқ па?
Dialogue: 0,0:14:43.94,0:14:45.48,Default,,0,0,0,,Сіз не туралы үрейленесіз?
Dialogue: 0,0:14:45.82,0:14:48.03,Default,,0,0,0,,Карен мен Урабе сонда болады.
Dialogue: 0,0:14:49.07,0:14:51.82,Default,,0,0,0,,Ха, бұл жігіт тәртіпсіз.
Dialogue: 0,0:14:54.83,0:14:57.45,Default,,0,0,0,,Өзіңді алдама, мен Созаку емеспін.
Dialogue: 0,0:14:57.58,0:15:00.08,Default,,0,0,0,,Стратегияны тактика талқандайды ма?
Dialogue: 0,0:15:02.42,0:15:05.13,Default,,0,0,0,,Жақын шайқас үшін бұл жақсырақ.
Dialogue: 0,0:15:08.96,0:15:10.22,Default,,0,0,0,,баяу
Dialogue: 0,0:15:12.84,0:15:14.43,Default,,0,0,0,,Жоғалып кетті ме? шынымен
Dialogue: 0,0:15:14.55,0:15:15.64,Default,,0,0,0,,Құдайдың жылдамдығы
Dialogue: 0,0:15:18.31,0:15:22.94,Default,,0,0,0,,Мүмкін емес, физикалық емес, басқа нәрсе
Dialogue: 0,0:15:25.44,0:15:26.98,Default,,0,0,0,,...
Dialogue: 0,0:15:30.40,0:15:31.82,Default,,0,0,0,,Урабе? Урабе мырза
Dialogue: 0,0:15:32.57,0:15:36.24,Default,,0,0,0,,Нөл Сіздің жеке тұлғаңыздың студент екені маған бәрібір.
Dialogue: 0,0:15:36.41,0:15:38.24,Default,,0,0,0,,Мен оны жай ғана кесіп алма дедім.
Dialogue: 0,0:15:38.37,0:15:41.16,Default,,0,0,0,,Бұл сөздерде өтірік жоқ деп қабылдадым.
Dialogue: 0,0:15:41.33,0:15:41.96,Default,,0,0,0,,Акацуки
Dialogue: 0,0:15:42.29,0:15:43.46,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:15:43.58,0:15:47.34,Default,,0,0,0,,Нөлді сұра, жалғыз үміт қалды
Dialogue: 0,0:15:48.38,0:15:50.21,Default,,0,0,0,,Кешіріңіз Ракшата
Dialogue: 0,0:15:51.59,0:15:52.47,Default,,0,0,0,,Нөл
Dialogue: 0,0:15:52.72,0:15:56.89,Default,,0,0,0,,Мен Жапонияның өз халқын жинағанын қалаймын.
Dialogue: 0,0:15:57.85,0:16:01.10,Default,,0,0,0,,Төрт қасиетті қылыш жалған есім емес.
Dialogue: 0,0:16:03.52,0:16:04.56,Default,,0,0,0,,Урабе
Dialogue: 0,0:16:04.69,0:16:06.27,Default,,0,0,0,,Уф
Dialogue: 0,0:16:09.82,0:16:12.36,Default,,0,0,0,,Қарғыс атқыр, қайтадан телепортация?
Dialogue: 0,0:16:13.07,0:16:14.03,Default,,0,0,0,,Қара мысықтар – тек ырым ғой.
Dialogue: 0,0:16:14.40,0:16:17.37,Default,,0,0,0,,Мен де шешуім керек, Нөл үшін.
Dialogue: 0,0:16:18.53,0:16:21.33,Default,,0,0,0,,Жаман жаңалықтар. Мен дайынмын.
Dialogue: 0,0:16:21.58,0:16:23.54,Default,,0,0,0,,Түсіндім, Урабе
Dialogue: 0,0:16:23.66,0:16:26.37,Default,,0,0,0,,Сіз жасаған осы сәт бекер болған жоқ.
Dialogue: 0,0:16:34.47,0:16:37.09,Default,,0,0,0,,Террорист, сен өз-өзіңе қол жұмсайсың ба?
Dialogue: 0,0:16:37.22,0:16:38.68,Default,,0,0,0,,Мәдениетсіз маймыл
Dialogue: 0,0:16:38.80,0:16:40.39,Default,,0,0,0,,Барлық ұшақтар жоғалды Барлық ұшақ байланысы жоғалды.
Dialogue: 0,0:16:40.51,0:16:42.18,Default,,0,0,0,,Не? Увааааааааааааааааааааа
Dialogue: 0,0:16:42.31,0:16:44.56,Default,,0,0,0,,Жағдай туралы хабардар болу төтенше жағдай С деңгейіне өзгертілді
Dialogue: 0,0:16:44.68,0:16:46.60,Default,,0,0,0,,Кесіндіден 1500-ге дейін өскеннен кейін -
Dialogue: 0,0:16:46.73,0:16:47.73,Default,,0,0,0,,Бұрылуды бастаңыз
Dialogue: 0,0:16:57.28,0:16:59.20,Default,,0,0,0,,Түсіндім, енді жоғарыдағы жау...
Dialogue: 0,0:16:59.45,0:17:01.33,Default,,0,0,0,,Жерге лақтырылды
Dialogue: 0,0:17:01.45,0:17:02.45,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:17:02.58,0:17:03.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.25,0:17:08.75,Default,,0,0,0,,ақымақ
Dialogue: 0,0:17:09.08,0:17:12.17,Default,,0,0,0,,Қашу жолын тарылту қате болды.
Dialogue: 0,0:17:12.30,0:17:15.22,Default,,0,0,0,,Қайда екеніңді айтып тұрғандай емес пе?
Dialogue: 0,0:17:15.34,0:17:16.05,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:17:18.09,0:17:20.85,Default,,0,0,0,,Ахахахахахахахахахахахах
Dialogue: 0,0:17:20.97,0:17:23.93,Default,,0,0,0,,Қош бол губернатор Карралес
Dialogue: 0,0:17:25.31,0:17:26.98,Default,,0,0,0,,Губернатор өлтірілді ме?
Dialogue: 0,0:17:27.10,0:17:28.60,Default,,0,0,0,,Лорд Корнуэлл қайда?
Dialogue: 0,0:17:28.73,0:17:29.90,Default,,0,0,0,,Генерал-губернатормен
Dialogue: 0,0:17:30.02,0:17:31.57,Default,,0,0,0,,Сонымен командалар тізбегі қандай?
Dialogue: 0,0:17:31.69,0:17:32.69,Default,,0,0,0,,Ішкі істер министрлігі
Dialogue: 0,0:17:32.82,0:17:34.53,Default,,0,0,0,,Мемлекеттік қызметшілерге қалдырыңыз ба?
Dialogue: 0,0:17:34.65,0:17:36.44,Default,,0,0,0,,Егер сіз ренжісеңіз?
Dialogue: 0,0:17:36.57,0:17:37.65,Default,,0,0,0,,Ах
Dialogue: 0,0:17:38.53,0:17:42.12,Default,,0,0,0,,Мен команда қабылдаймын. Бұл күшті тартып алу емес.
Dialogue: 0,0:17:42.24,0:17:44.16,Default,,0,0,0,,Бұл уақытша шара ғана.
Dialogue: 0,0:17:44.29,0:17:46.45,Default,,0,0,0,,Мен ханшайымымның атымен ант етемін
Dialogue: 0,0:17:46.58,0:17:48.00,Default,,0,0,0,,Мен сіздің ынтымақтастықты қалаймын
Dialogue: 0,0:17:48.54,0:17:49.83,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:17:49.96,0:17:52.21,Default,,0,0,0,,Сіз Мәртебелі Корнелия ханшайымы туралы айтып отырсыз ба?
Dialogue: 0,0:17:52.34,0:17:53.71,Default,,0,0,0,,Содан кейін (белгі солдат 4) Ммм.
Dialogue: 0,0:17:54.92,0:17:56.84,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:17:56.97,0:17:58.17,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:17:58.93,0:18:02.43,Default,,0,0,0,,Содан кейін мен оқиға орнына барып, құтқару командасын өз қолыма аламын.
Dialogue: 0,0:18:02.89,0:18:05.22,Default,,0,0,0,,Альфред полиция, Барт осында.
Dialogue: 0,0:18:05.35,0:18:05.97,Default,,0,0,0,,Ах
Dialogue: 0,0:18:06.10,0:18:07.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.14,0:18:08.64,Default,,0,0,0,,О, солай.
Dialogue: 0,0:18:09.14,0:18:10.02,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:12.65,0:18:14.19,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,0:18:14.32,0:18:15.53,Default,,0,0,0,,Ах
Dialogue: 0,0:18:15.65,0:18:16.32,Default,,0,0,0,,Уф
Dialogue: 0,0:18:16.44,0:18:17.44,Default,,0,0,0,,Иә (2-ер адам) Эй, эй, бұл не?
Dialogue: 0,0:18:17.57,0:18:19.78,Default,,0,0,0,,Өтірік (еркек 4) Ол өлген болуы керек емес пе?
Dialogue: 0,0:18:20.24,0:18:21.70,Default,,0,0,0,,Бірақ неге кенеттен?
Dialogue: 0,0:18:21.82,0:18:23.53,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:18:24.03,0:18:27.16,Default,,0,0,0,,Жапон, мен қайтып келдім
Dialogue: 0,0:18:27.45,0:18:28.58,Default,,0,0,0,,Бейнені тоқтату
Dialogue: 0,0:18:28.71,0:18:30.62,Default,,0,0,0,,Жоқ, сигнал қабылданбады
Dialogue: 0,0:18:31.88,0:18:34.25,Default,,0,0,0,,Мен орнатқан Омега желісі
Dialogue: 0,0:18:34.38,0:18:36.30,Default,,0,0,0,,Мұны кім біледі?
Dialogue: 0,0:18:36.88,0:18:40.84,Default,,0,0,0,,Нөл Сіз әлі тірі едіңіз.
Dialogue: 0,0:18:41.55,0:18:44.76,Default,,0,0,0,,Тыңда, Британия, көзіңді аш.
Dialogue: 0,0:18:44.89,0:18:47.43,Default,,0,0,0,,Құдіреті барлар
Dialogue: 0,0:18:47.89,0:18:49.48,Default,,0,0,0,,Мен қайғылымын
Dialogue: 0,0:18:49.60,0:18:50.44,Default,,0,0,0,,Ах
Dialogue: 0,0:18:50.73,0:18:55.36,Default,,0,0,0,,Соғыс және кемсітушілік: күштілердің арам ниеті
Dialogue: 0,0:18:55.48,0:18:58.86,Default,,0,0,0,,Қатеде қалып қойған трагедия мен комедия
Dialogue: 0,0:19:00.32,0:19:03.74,Default,,0,0,0,,Дүниеде ештеңе өзгерген жоқ
Dialogue: 0,0:19:03.87,0:19:06.95,Default,,0,0,0,,Сондықтан мені қайта тірілтуге тура келді
Dialogue: 0,0:19:07.20,0:19:10.71,Default,,0,0,0,,Күштілер әлсіздерді басып жатқанша...
Dialogue: 0,0:19:10.83,0:19:12.29,Default,,0,0,0,,Мен қарсыласуды жалғастырамын
Dialogue: 0,0:19:12.96,0:19:15.84,Default,,0,0,0,,Біріншіден, ақымақ губернатор Калареске...
Dialogue: 0,0:19:15.96,0:19:18.88,Default,,0,0,0,,Мен жаңа ғана Тенчуды тапсырдым.
Dialogue: 0,0:19:19.09,0:19:21.76,Default,,0,0,0,,Әй, сен мұны кенеттен жасайсың.
Dialogue: 0,0:19:21.88,0:19:24.76,Default,,0,0,0,,Он бірдің патшасы Созаку кім?
Dialogue: 0,0:19:24.89,0:19:25.72,Default,,0,0,0,,Құт
Dialogue: 0,0:19:26.85,0:19:30.23,Default,,0,0,0,,Қытай Федерациясының Бас консулдығынан жіберілді
Dialogue: 0,0:19:30.35,0:19:31.39,Default,,0,0,0,,Қытай Федерациясы?
Dialogue: 0,0:19:31.52,0:19:32.94,Default,,0,0,0,,Бұл шынымен жер аударылған ба?
Dialogue: 0,0:19:33.06,0:19:34.77,Default,,0,0,0,,Қалай қоршауға болады
Dialogue: 0,0:19:35.52,0:19:36.98,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:19:37.11,0:19:39.86,Default,,0,0,0,,Олар құлаған ғимараттың ішінде...
Dialogue: 0,0:19:39.98,0:19:42.15,Default,,0,0,0,,Бабыл мұнарасын жол ретінде қарастыру
Dialogue: 0,0:19:42.82,0:19:44.95,Default,,0,0,0,,Қытай Федерациясы туралы не деуге болады?
Dialogue: 0,0:19:45.24,0:19:47.58,Default,,0,0,0,,Сіз мұны алдын ала талқыладыңыз ба?
Dialogue: 0,0:19:47.70,0:19:48.54,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:19:48.74,0:19:51.25,Default,,0,0,0,,Эй, сен өлдің, солай ма? нөл
Dialogue: 0,0:19:51.37,0:19:52.12,Default,,0,0,0,,О
Dialogue: 0,0:19:52.25,0:19:53.79,Default,,0,0,0,,Сонымен, сен жалғансың ба?
Dialogue: 0,0:19:53.92,0:19:57.09,Default,,0,0,0,,Қалай болғанда да, егер сіз консулдықты басып алсаңыз
Dialogue: 0,0:19:57.21,0:20:00.76,Default,,0,0,0,,Бұл ережені өрескел бұзу болып табылады. Ол халықаралық проблемаға айналады.
Dialogue: 0,0:20:00.88,0:20:03.93,Default,,0,0,0,,Ол өзін нөл деп атағандықтан, ол корольдік отбасының қанішері.
Dialogue: 0,0:20:04.05,0:20:06.80,Default,,0,0,0,,Е.У.-ға қарсы күрес. дегенмен де маңызды.
Dialogue: 0,0:20:08.05,0:20:09.97,Default,,0,0,0,,Екеуі де құмырсқа тозағы
Dialogue: 0,0:20:10.39,0:20:13.52,Default,,0,0,0,,Губернаторды өлтіру және қашу жолын қамтамасыз ету
Dialogue: 0,0:20:13.64,0:20:15.52,Default,,0,0,0,,Мен оның бір уақытта орындалатынына сене алмаймын.
Dialogue: 0,0:20:15.65,0:20:17.02,Default,,0,0,0,,) Бұл интеллект
Dialogue: 0,0:20:17.65,0:20:18.77,Default,,0,0,0,,Батылдық
Dialogue: 0,0:20:19.94,0:20:22.24,Default,,0,0,0,,Нөл, нақты
Dialogue: 0,0:20:22.94,0:20:24.32,Default,,0,0,0,,Мен ұрысамын
Dialogue: 0,0:20:24.70,0:20:28.62,Default,,0,0,0,,Қате күш қолданатындардың барлығымен
Dialogue: 0,0:20:30.24,0:20:35.62,Default,,0,0,0,,Сондықтан мен осымен Америка Құрама Штаттары мен Жапонияның құрылғанын жариялаймын.
Dialogue: 0,0:20:35.75,0:20:37.17,Default,,0,0,0,,Қайтадан хабарлаңыз
Dialogue: 0,0:20:37.96,0:20:41.80,Default,,0,0,0,,Сіз сенімдісіз бе? Бұл тіпті императордың бұйрығы емес.
Dialogue: 0,0:20:41.92,0:20:44.80,Default,,0,0,0,,Менің шешіміме көңіліңіз толмай ма?
Dialogue: 0,0:20:44.92,0:20:46.63,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:20:47.09,0:20:52.56,Default,,0,0,0,,Хехе, Нөл, сізге, Америка Құрама Штаттарына.
Dialogue: 0,0:20:52.68,0:20:53.73,Default,,0,0,0,,Жапония
Dialogue: 0,0:20:54.06,0:20:55.98,Default,,0,0,0,,Террористер елді басқарады?
Dialogue: 0,0:20:56.27,0:20:57.52,Default,,0,0,0,,Осы сәттен бастап-
Dialogue: 0,0:20:57.65,0:21:01.02,Default,,0,0,0,,Бұл бөлме Жапония Құрама Штаттарының бірінші аумағына айналады.
Dialogue: 0,0:21:01.32,0:21:02.98,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:21:03.11,0:21:07.57,Default,,0,0,0,,Бір ғана бөлмесі бар елде ол бұрынғыдай қызық.
Dialogue: 0,0:21:07.78,0:21:10.45,Default,,0,0,0,,Нәсіліне, принципіне немесе дініне қарамастан
Dialogue: 0,0:21:10.91,0:21:15.25,Default,,0,0,0,,Азамат болудың бірден-бір біліктілігі – әділеттілік.
Dialogue: 0,0:21:18.25,0:21:21.63,Default,,0,0,0,,Осы нүктеден кейін ол біздің Қытай Федерациясының аумағына айналады.
Dialogue: 0,0:21:21.88,0:21:26.63,Default,,0,0,0,,Жоқ, жоқ, жарайды. Кейін дипломатиялық шарада кездесеміз.
Dialogue: 0,0:21:30.26,0:21:33.56,Default,,0,0,0,,Нөл Оның пайдалылық мәні қандай?
Dialogue: 0,0:21:33.68,0:21:34.39,Default,,0,0,0,,Ах
Dialogue: 0,0:21:37.27,0:21:39.94,Default,,0,0,0,,Британ әскері үйіне қайтып кетті.
Dialogue: 0,0:21:40.40,0:21:43.27,Default,,0,0,0,,Әлде Нөлдің отбасынан шыққан біреу шығар?
Dialogue: 0,0:21:45.86,0:21:48.53,Default,,0,0,0,,Ал, бұл қайсысы?
Dialogue: 0,0:21:48.95,0:21:51.07,Default,,0,0,0,,Мен жұмбақтарды ұнатпаймын
Dialogue: 0,0:21:51.78,0:21:54.04,Default,,0,0,0,,Иә, мен де солаймын.
Dialogue: 0,0:21:54.58,0:21:56.70,Default,,0,0,0,,Мен шындықты білгім келеді.
Dialogue: 0,0:21:57.46,0:22:02.04,Default,,0,0,0,,Сондықтан мен Нөлді өлтіруге келдім.
Dialogue: 0,0:22:03.34,0:22:08.09,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.22,0:22:14.81,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.93,0:22:19.81,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.94,0:22:26.90,Default,,0,0,0,,♪Ортада сөнбестен
Dialogue: 0,0:22:30.11,0:22:34.74,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.87,0:22:40.04,Default,,0,0,0,,♪Бүгін осында болғаным барлығына рахмет
Dialogue: 0,0:22:40.16,0:22:44.71,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.84,0:22:47.55,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.67,0:22:51.01,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.13,0:22:56.14,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.26,0:23:02.73,Default,,0,0,0,,♪Себебі сол күні мен де өзіммін
Dialogue: 0,0:23:02.85,0:23:07.82,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.94,0:23:11.95,Default,,0,0,0,,♪Сіз маған айтуыңыз керек.
Dialogue: 0,0:23:12.07,0:23:16.33,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.45,0:23:23.00,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.12,0:23:27.13,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.25,0:23:34.22,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:37.60,0:23:38.97,Default,,0,0,0,,Нуннальды табу-
Dialogue: 0,0:23:39.10,0:23:41.18,Default,,0,0,0,,Өзіңді қорғау үшін күш керек
Dialogue: 0,0:23:41.35,0:23:43.44,Default,,0,0,0,,Императордан немесе Сузакудан күшті күш
Dialogue: 0,0:23:44.23,0:23:45.52,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:23:45.65,0:23:47.65,Default,,0,0,0,,Сол себепті, ең алдымен, оған қамқорлық жасайық.
Dialogue: 0,0:23:47.77,0:23:50.49,Default,,0,0,0,,Жалған інісі Роло
Dialogue: 0,0:23:51.99,0:23:57.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory