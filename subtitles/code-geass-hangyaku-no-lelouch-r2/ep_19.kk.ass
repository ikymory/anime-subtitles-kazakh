Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.10,0:00:04.64,Default,,0,0,0,,Токио концессиясында үлкен жарылыс расталды.
Dialogue: 0,0:00:04.94,0:00:07.56,Default,,0,0,0,,Менің ойымша, бұл есепте айтылған Freyja оқтұмсығы.
Dialogue: 0,0:00:07.98,0:00:09.36,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:00:09.48,0:00:11.44,Default,,0,0,0,,Осы Камин аралында болу
Dialogue: 0,0:00:11.65,0:00:14.82,Default,,0,0,0,,Жақсы, бәрін Шнайзелге қалдыр.
Dialogue: 0,0:00:15.90,0:00:19.78,Default,,0,0,0,,Жалпы жұртшылыққа келтірілген негізгі залал тек 10 миллион өлімнен асады деп есептеледі.
Dialogue: 0,0:00:19.91,0:00:23.33,Default,,0,0,0,,Екінші реттік залалдан зардап шеккендердің саны 25 миллион адамға бағаланады.
Dialogue: 0,0:00:23.45,0:00:26.67,Default,,0,0,0,,Құтқару нысандары да жоғалып кеткендіктен, азаматтарды құтқару мүмкін емес.
Dialogue: 0,0:00:27.08,0:00:29.67,Default,,0,0,0,,Токио концессиясы өлді.
Dialogue: 0,0:00:31.46,0:00:34.42,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:00:36.01,0:00:38.64,Default,,0,0,0,,Барлығы Барлығы
Dialogue: 0,0:00:41.14,0:00:43.52,Default,,0,0,0,,Мен мұны істедім бе?
Dialogue: 0,0:00:45.52,0:00:48.06,Default,,0,0,0,,Мектеп қауіпсіз ме? Бірақ бұл...
Dialogue: 0,0:00:48.19,0:00:50.11,Default,,0,0,0,,Бұл енді соғыс емес
Dialogue: 0,0:00:50.65,0:00:52.44,Default,,0,0,0,,Егер бұл қару қайтадан қолданылса...
Dialogue: 0,0:00:52.98,0:00:54.57,Default,,0,0,0,,Қара рыцарьлар жойылды.
Dialogue: 0,0:00:54.57,0:00:55.40,Default,,0,0,0,,Қара рыцарьлар жойылды.
Dialogue: 0,0:00:54.57,0:00:55.40,Default,,0,0,0,,(байланыс дыбысы)
Dialogue: 0,0:00:55.40,0:00:55.74,Default,,0,0,0,,(байланыс дыбысы)
Dialogue: 0,0:00:55.90,0:00:57.90,Default,,0,0,0,,Тапсырма Бұл менмін.
Dialogue: 0,0:00:58.03,0:00:58.99,Default,,0,0,0,,Нөл Мұнда...
Dialogue: 0,0:00:59.11,0:01:01.37,Default,,0,0,0,,Барлық күштер Токио концессиясына түседі.
Dialogue: 0,0:01:01.49,0:01:02.83,Default,,0,0,0,,Nunnally іздеңіз
Dialogue: 0,0:01:02.95,0:01:05.20,Default,,0,0,0,,Күте тұрыңыз, Асахина жеңілді.
Dialogue: 0,0:01:05.33,0:01:06.54,Default,,0,0,0,,Көптеген басқа құрбандықтар
Dialogue: 0,0:01:06.66,0:01:07.96,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:01:08.08,0:01:08.71,Default,,0,0,0,,Уф
Dialogue: 0,0:01:08.83,0:01:11.42,Default,,0,0,0,,Nunnally табыңыз, бірінші кезекте.
Dialogue: 0,0:01:11.54,0:01:13.42,Default,,0,0,0,,Барлық күштеріңізбен Nunnally іздеңіз!
Dialogue: 0,0:01:14.63,0:01:16.01,Default,,0,0,0,,Бұл нөл...
Dialogue: 0,0:01:17.34,0:01:21.89,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:01:22.01,0:01:27.56,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:01:43.45,0:01:48.41,Default,,0,0,0,,♪Сұлу болумен өмір сүре алмайсың
Dialogue: 0,0:01:48.79,0:01:54.13,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:54.25,0:01:56.96,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:57.09,0:01:59.22,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:59.67,0:02:02.30,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:02:02.43,0:02:05.56,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:02:05.68,0:02:10.56,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:02:11.39,0:02:14.02,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:02:14.15,0:02:20.57,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:02:22.20,0:02:26.66,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:02:26.79,0:02:31.33,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:02:32.21,0:02:37.84,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:02:50.77,0:02:52.64,Default,,0,0,0,,) Қашқын сол жақ ұшып-қону жолағында.
Dialogue: 0,0:02:52.77,0:02:54.94,Default,,0,0,0,,Тоқта, оның орнына әскерді қайта құрайық.
Dialogue: 0,0:02:55.06,0:02:56.82,Default,,0,0,0,,Білемін, мен бірден қайтамын.
Dialogue: 0,0:02:56.94,0:02:57.57,Default,,0,0,0,,Желдеткіш
Dialogue: 0,0:02:57.69,0:02:58.86,Default,,0,0,0,,О
Dialogue: 0,0:03:01.53,0:03:02.36,Default,,0,0,0,,Чигуса
Dialogue: 0,0:03:04.61,0:03:06.66,Default,,0,0,0,,Міне, қашқын-күн.
Dialogue: 0,0:03:06.78,0:03:07.87,Default,,0,0,0,,Ах
Dialogue: 0,0:03:09.16,0:03:09.91,Default,,0,0,0,,Ах
Dialogue: 0,0:03:10.04,0:03:11.33,Default,,0,0,0,,Корнелия
Dialogue: 0,0:03:11.45,0:03:13.79,Default,,0,0,0,,Мен қашып кеткен Вилетта деп ойладым.
Dialogue: 0,0:03:14.17,0:03:17.00,Default,,0,0,0,,Арсыз теледидар дүкенінен бері көп уақыт өтті
Dialogue: 0,0:03:17.34,0:03:20.59,Default,,0,0,0,,Бұл Нөлдің жұмысы болды ма? Мәртебелі ханшайым тұтқынға алынды.
Dialogue: 0,0:03:20.71,0:03:24.01,Default,,0,0,0,,Маған көбірек сенсеңіз екен.
Dialogue: 0,0:03:24.13,0:03:26.47,Default,,0,0,0,,Аяқты көздеу, өлтірмей басып алу
Dialogue: 0,0:03:26.59,0:03:27.18,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:27.18,0:03:28.14,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:29.26,0:03:29.60,Default,,0,0,0,,Мен Британияның дипломатиялық өкілімін. Қайталау.
Dialogue: 0,0:03:29.60,0:03:32.39,Default,,0,0,0,,Мен Британияның дипломатиялық өкілімін. Қайталау.
Dialogue: 0,0:03:32.77,0:03:35.15,Default,,0,0,0,,Мен Британияның дипломатиялық өкілімін.
Dialogue: 0,0:03:35.27,0:03:37.11,Default,,0,0,0,,Ұрысуға ниеті жоқ
Dialogue: 0,0:03:37.44,0:03:38.57,Default,,0,0,0,,Дипломатиялық өкіл?
Dialogue: 0,0:03:38.69,0:03:42.07,Default,,0,0,0,,Минас: Бұл ұшақ ресми маршрут арқылы сұралды ма?
Dialogue: 0,0:03:42.19,0:03:43.32,Default,,0,0,0,,Уф
Dialogue: 0,0:03:47.82,0:03:48.58,Default,,0,0,0,,Аға
Dialogue: 0,0:03:48.70,0:03:51.08,Default,,0,0,0,,Ақымақ, жаудың ортасында
Dialogue: 0,0:03:51.20,0:03:52.75,Default,,0,0,0,,Өзіңіз бортқа шығу деген нені білдіреді?
Dialogue: 0,0:03:54.21,0:03:56.88,Default,,0,0,0,,Тодо: Ол сізге Нунеллиді іздеуді айтып жатқан шығар.
Dialogue: 0,0:03:57.00,0:03:58.79,Default,,0,0,0,,Іздеу тобының басшылығын алыңыз
Dialogue: 0,0:03:58.92,0:03:59.67,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:03:59.84,0:04:02.26,Default,,0,0,0,,Карен, сен мені естисің бе? Лоло! Еремия!
Dialogue: 0,0:04:02.51,0:04:04.63,Default,,0,0,0,,Nunnally міндетті түрде тірі. Оны тап!
Dialogue: 0,0:04:04.76,0:04:06.47,Default,,0,0,0,,Nunnally табыңыз!
Dialogue: 0,0:04:06.59,0:04:07.51,Default,,0,0,0,,Бүкіл әскерге айт
Dialogue: 0,0:04:07.64,0:04:08.26,Default,,0,0,0,,Ах
Dialogue: 0,0:04:08.51,0:04:11.31,Default,,0,0,0,,Махариге шегініп, алдыңғы шепті қалпына келтіріңіз.
Dialogue: 0,0:04:11.43,0:04:13.14,Default,,0,0,0,,Барлық әскерлер дереу шегініңіз.
Dialogue: 0,0:04:13.27,0:04:15.27,Default,,0,0,0,,Тодо! Мен Нуннеллиді тапқым келеді...
Dialogue: 0,0:04:15.27,0:04:17.19,Default,,0,0,0,,Тапсырма! Мен Нуннеллиді тапқым келеді...
Dialogue: 0,0:04:15.27,0:04:17.19,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:18.61,0:04:20.32,Default,,0,0,0,,Ағам аман болса екен.
Dialogue: 0,0:04:20.48,0:04:21.94,Default,,0,0,0,,Тағы бір мүмкіндік болады
Dialogue: 0,0:04:22.69,0:04:24.82,Default,,0,0,0,,) Бұл нені білдіреді? Уақытша атысты тоқтату дегеніміз не?
Dialogue: 0,0:04:24.94,0:04:26.11,Default,,0,0,0,,Британияның жоспары қандай?
Dialogue: 0,0:04:26.45,0:04:28.16,Default,,0,0,0,,Неліктен Бисмарк әскерлерін төмендетті?
Dialogue: 0,0:04:28.53,0:04:31.83,Default,,0,0,0,,) Қазіргі уақытта себебі анықталуда, бірақ ұрысқа қатысу ниеті жоқ сияқты.
Dialogue: 0,0:04:31.95,0:04:34.45,Default,,0,0,0,,Сондай-ақ Токиода уақытша атысты тоқтату туралы келісім болды.
Dialogue: 0,0:04:35.29,0:04:36.29,Default,,0,0,0,,Нөлдік нұсқаулар?
Dialogue: 0,0:04:37.04,0:04:39.25,Default,,0,0,0,,) Әй, ұстаз.
Dialogue: 0,0:04:39.54,0:04:41.63,Default,,0,0,0,,Бауырым, берік бол.
Dialogue: 0,0:04:42.00,0:04:43.13,Default,,0,0,0,,Nunnally
Dialogue: 0,0:04:43.30,0:04:45.09,Default,,0,0,0,,Мен сенде
Dialogue: 0,0:04:45.63,0:04:48.38,Default,,0,0,0,,Осы уақытқа дейін екеуміз ғана болдық қой, солай емес пе?
Dialogue: 0,0:04:48.38,0:04:49.18,Default,,0,0,0,,Осы уақытқа дейін екеуміз ғана болғанбыз ғой, солай емес пе?
Dialogue: 0,0:04:48.38,0:04:49.18,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:49.18,0:04:49.51,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:49.51,0:04:50.64,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:49.51,0:04:50.64,Default,,0,0,0,,Ах
Dialogue: 0,0:04:50.64,0:04:51.35,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:52.22,0:04:53.52,Default,,0,0,0,,Еремия?
Dialogue: 0,0:04:53.64,0:04:56.10,Default,,0,0,0,,Дәл қазір мен ағамды үнсіз қалдырғым келеді.
Dialogue: 0,0:04:56.23,0:04:57.73,Default,,0,0,0,,Кейінірек сөйлесіңіз
Dialogue: 0,0:04:59.56,0:05:00.19,Default,,0,0,0,,Ах
Dialogue: 0,0:05:00.31,0:05:03.82,Default,,0,0,0,,Иә, мағынасы жоқ шығар, бірақ иә.
Dialogue: 0,0:05:04.36,0:05:06.15,Default,,0,0,0,,Себебі мен сенімен біргемін, ағайын.
Dialogue: 0,0:05:06.28,0:05:06.95,Default,,0,0,0,,Уф
Dialogue: 0,0:05:07.78,0:05:09.45,Default,,0,0,0,,Неліктен сізде бар!
Dialogue: 0,0:05:09.57,0:05:10.20,Default,,0,0,0,,Уф
Dialogue: 0,0:05:10.45,0:05:13.12,Default,,0,0,0,,Мен мұны Нуннеллиге бермек болдым.
Dialogue: 0,0:05:13.24,0:05:14.04,Default,,0,0,0,,Нунеллиге
Dialogue: 0,0:05:14.20,0:05:15.37,Default,,0,0,0,,Ах (Лелух) Сіз...
Dialogue: 0,0:05:15.50,0:05:17.33,Default,,0,0,0,,Бұл Nunnally-ді алмастыра ма?
Dialogue: 0,0:05:17.46,0:05:18.46,Default,,0,0,0,,Сіз жалғансыз!
Dialogue: 0,0:05:18.58,0:05:19.42,Default,,0,0,0,,Уф (C.C.) Ах.
Dialogue: 0,0:05:23.92,0:05:25.46,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:05:25.76,0:05:29.01,Default,,0,0,0,,Мен сені жек көремін, мен сені жек көремін!
Dialogue: 0,0:05:29.13,0:05:32.60,Default,,0,0,0,,Мен оны талай рет өлтірмек болдым, бірақ сәтсіз болды!
Dialogue: 0,0:05:32.97,0:05:34.26,Default,,0,0,0,,Бауырым...?
Dialogue: 0,0:05:34.39,0:05:37.23,Default,,0,0,0,,Шық! Енді менің алдымда өзіңді көрсетпе
Dialogue: 0,0:05:37.35,0:05:38.94,Default,,0,0,0,,Ха... (Лелуш) Шық!
Dialogue: 0,0:05:39.06,0:05:40.06,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:42.11,0:05:45.94,Default,,0,0,0,,Соңында мен түсінбедім.
Dialogue: 0,0:05:46.07,0:05:47.86,Default,,0,0,0,,Қандай зақым болады?
Dialogue: 0,0:05:48.15,0:05:50.82,Default,,0,0,0,,Нина-кун, сен шешуің керек.
Dialogue: 0,0:05:50.95,0:05:53.37,Default,,0,0,0,,Ғылымды тастап, жүрегімізді қорғауымыз керек пе?
Dialogue: 0,0:05:53.49,0:05:56.16,Default,,0,0,0,,Жүрегіңді жаралап, ғылымға құрбан боласың ба?
Dialogue: 0,0:05:57.50,0:05:59.46,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:05:59.83,0:06:01.96,Default,,0,0,0,,Сіз де профессор Ллойдты таңдадыңыз ба?
Dialogue: 0,0:06:02.29,0:06:04.92,Default,,0,0,0,,Өйткені мен басынан бері сындым.
Dialogue: 0,0:06:05.04,0:06:07.51,Default,,0,0,0,,Мен бұл туралы қаншалықты хабардармын.
Dialogue: 0,0:06:08.46,0:06:10.97,Default,,0,0,0,,Мен жасаған Фрейя
Dialogue: 0,0:06:11.51,0:06:14.97,Default,,0,0,0,,Мен олардың бәрін өлтірдім.
Dialogue: 0,0:06:16.39,0:06:17.43,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:06:17.56,0:06:20.69,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:06:20.81,0:06:22.23,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:06:22.35,0:06:24.65,Default,,0,0,0,,Жоқ, нөл пайда болмайды.
Dialogue: 0,0:06:24.77,0:06:28.28,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен Шнайзелмен нөлсіз кездесу өткіземін.
Dialogue: 0,0:06:28.40,0:06:30.95,Default,,0,0,0,,Бірақ біздің көшбасшымыз Нөл, солай емес пе?
Dialogue: 0,0:06:31.07,0:06:33.53,Default,,0,0,0,,Өз бетімен әрекет ету жаман идея емес пе?
Dialogue: 0,0:06:33.70,0:06:36.99,Default,,0,0,0,,Бұл қырғын. Барлығын, соның ішінде әйелдер мен балаларды өлтіріңіз.
Dialogue: 0,0:06:37.12,0:06:38.62,Default,,0,0,0,,Нөл нұсқаулар берді
Dialogue: 0,0:06:38.75,0:06:39.75,Default,,0,0,0,,Диетард
Dialogue: 0,0:06:40.00,0:06:42.54,Default,,0,0,0,,Шнайзелді неге бірден ұстамадың?
Dialogue: 0,0:06:42.67,0:06:45.75,Default,,0,0,0,,Жолсерік бір Nightmare болады, солай ма? Асахинаның жауы
Dialogue: 0,0:06:45.88,0:06:48.76,Default,,0,0,0,,Оның жеке ұшағында Фрейжа оқтұмсықтары бар.
Dialogue: 0,0:06:48.88,0:06:49.67,Default,,0,0,0,,Фрейя?
Dialogue: 0,0:06:50.13,0:06:53.13,Default,,0,0,0,,Бұл үлкен жарылысты тудырған бомба.
Dialogue: 0,0:06:53.26,0:06:54.89,Default,,0,0,0,,Егер ол сол жерде жарылып кетсе...
Dialogue: 0,0:06:55.01,0:06:57.72,Default,,0,0,0,,Біз де, Нөл де аман қалмадық.
Dialogue: 0,0:06:58.39,0:07:00.85,Default,,0,0,0,,Мен Шнайзелдің мақсаты не екенін білмеймін, бірақ...
Dialogue: 0,0:07:00.98,0:07:03.44,Default,,0,0,0,,Қалай болғанда да, өз бетімізше сөйлесуден басқа амалымыз қалмайды.
Dialogue: 0,0:07:03.73,0:07:05.06,Default,,0,0,0,,I Перт
Dialogue: 0,0:07:05.19,0:07:07.48,Default,,0,0,0,,Мен қайтып келген Гуренді тексергім келеді.
Dialogue: 0,0:07:07.77,0:07:11.24,Default,,0,0,0,,Сонымен, келіссөздер менімен, Чиба Диетардпен және...
Dialogue: 0,0:07:11.24,0:07:11.57,Default,,0,0,0,,Сонымен, келіссөздер менімен, Чиба Диетардпен және...
Dialogue: 0,0:07:11.24,0:07:11.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:11.57,0:07:11.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:11.69,0:07:12.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:11.69,0:07:12.57,Default,,0,0,0,,Жоқ, мен желдеткішті таба алмаймын.
Dialogue: 0,0:07:12.57,0:07:14.16,Default,,0,0,0,,Жоқ, мен желдеткішті таба алмаймын.
Dialogue: 0,0:07:14.45,0:07:16.57,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:07:18.12,0:07:18.95,Default,,0,0,0,,) Карен!
Dialogue: 0,0:07:19.08,0:07:20.45,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:07:20.79,0:07:23.04,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:07:23.41,0:07:24.62,Default,,0,0,0,,Нөл туралы не деуге болады?
Dialogue: 0,0:07:24.96,0:07:26.25,Default,,0,0,0,,Ол өз бөлмесінде.
Dialogue: 0,0:07:26.38,0:07:28.04,Default,,0,0,0,,Сенің жарақат алғаныңды естідім.
Dialogue: 0,0:07:28.38,0:07:29.46,Default,,0,0,0,,Га
Dialogue: 0,0:07:32.55,0:07:35.30,Default,,0,0,0,,Құрметті Нуннали, аман болыңыз.
Dialogue: 0,0:07:35.43,0:07:36.76,Default,,0,0,0,,Тірі
Dialogue: 0,0:07:40.31,0:07:43.60,Default,,0,0,0,,Менің Риодан көрген-білгенім осы ғана.
Dialogue: 0,0:07:43.73,0:07:46.06,Default,,0,0,0,,Рахмет сізге Корнелия Енді мен
Dialogue: 0,0:07:46.06,0:07:46.52,Default,,0,0,0,,Рахмет сізге Корнелия Енді мен
Dialogue: 0,0:07:46.06,0:07:46.52,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:46.52,0:07:46.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:46.65,0:07:47.31,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:46.65,0:07:47.31,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:07:47.31,0:07:47.94,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:07:48.27,0:07:49.32,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:07:49.44,0:07:52.28,Default,,0,0,0,,Өздеріңіз өлтірген жаралы сарбаздарға күтім жасауға уақыт бөліңіздер.
Dialogue: 0,0:07:52.74,0:07:55.78,Default,,0,0,0,,Тамаки мырза, жоғарыда айтқанымдай, бұл жер
Dialogue: 0,0:07:55.91,0:07:59.45,Default,,0,0,0,,Мен «Қара рыцарьлардың» ішкі істер бөлімінің тазалауды қолдау офицерімін.
Dialogue: 0,0:07:59.58,0:08:02.33,Default,,0,0,0,,Ол сондай-ақ Бас хатшы Оги Канаменің өкілі қызметін атқаруы мүмкін.
Dialogue: 0,0:08:02.45,0:08:04.41,Default,,0,0,0,,Бұл сіздің қиялыңыз ғана.
Dialogue: 0,0:08:04.54,0:08:07.21,Default,,0,0,0,,Жоқ, мен сенің қатысқаныңды қалаймын.
Dialogue: 0,0:08:07.38,0:08:08.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.54,0:08:10.13,Default,,0,0,0,,Шиничиро Тамаки
Dialogue: 0,0:08:10.29,0:08:12.34,Default,,0,0,0,,Нөлдің ең ескі жолдасы...
Dialogue: 0,0:08:12.46,0:08:14.34,Default,,0,0,0,,Ардагер жауынгер деп естідім.
Dialogue: 0,0:08:14.55,0:08:16.18,Default,,0,0,0,,Эй, сен сөйлесе аласың, солай ма?
Dialogue: 0,0:08:16.30,0:08:18.09,Default,,0,0,0,,Тамаки-сан
Dialogue: 0,0:08:18.89,0:08:22.81,Default,,0,0,0,,Сіз маған бір рет көмектестіңіз, солай ма?
Dialogue: 0,0:08:22.93,0:08:26.48,Default,,0,0,0,,Мен жай ғана ризашылығымды білдіргім келді, бірақ
Dialogue: 0,0:08:26.60,0:08:30.73,Default,,0,0,0,,Хехе сен екеуміз біртүрлі қарым-қатынастамыз.
Dialogue: 0,0:08:30.86,0:08:33.78,Default,,0,0,0,,Бәлкім, тағдырдың жазуымен жау болып қалатын шығармыз.
Dialogue: 0,0:08:34.74,0:08:36.28,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:36.40,0:08:39.03,Default,,0,0,0,,Мен Нуналли-саманы табуым керек.
Dialogue: 0,0:08:44.16,0:08:45.91,Default,,0,0,0,,Nunnally қазірдің өзінде...
Dialogue: 0,0:08:46.16,0:08:49.00,Default,,0,0,0,,Тірі қалғандар тізімге ретімен тіркелуі керек.
Dialogue: 0,0:08:49.13,0:08:50.84,Default,,0,0,0,,ID нөмірінен басқа
Dialogue: 0,0:08:50.96,0:08:54.17,Default,,0,0,0,,Аты-жөні, жасы, мекен-жайы және қан тобы да жарияланған.
Dialogue: 0,0:08:54.67,0:08:57.34,Default,,0,0,0,,Емдеуге мұқтаж жандар дәрігерлік қабылдауға бару керек.
Dialogue: 0,0:08:57.47,0:08:59.05,Default,,0,0,0,,Шатаспау үшін мүмкіндігінше...
Dialogue: 0,0:08:59.18,0:09:02.60,Default,,0,0,0,,Уау аа аа
Dialogue: 0,0:09:03.35,0:09:04.18,Default,,0,0,0,,Қарсылас
Dialogue: 0,0:09:04.35,0:09:07.27,Default,,0,0,0,,Төраға, сіз тірісіз.
Dialogue: 0,0:09:07.39,0:09:09.40,Default,,0,0,0,,Ол тірі еді Ол тірі еді
Dialogue: 0,0:09:09.52,0:09:12.23,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:09:12.36,0:09:14.23,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:09:14.65,0:09:17.90,Default,,0,0,0,,Мен кешегі нөлмен матчты білмедім.
Dialogue: 0,0:09:18.36,0:09:20.03,Default,,0,0,0,,Нөл қабылданбайды
Dialogue: 0,0:09:20.16,0:09:22.33,Default,,0,0,0,,Әңгіменің мазмұнын бекіткеннен кейін
Dialogue: 0,0:09:22.53,0:09:25.20,Default,,0,0,0,,Шығатын амал жоқ шығар.
Dialogue: 0,0:09:25.33,0:09:26.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.41,0:09:29.08,Default,,0,0,0,,Ол адамдармен сөйлесетін адам емес.
Dialogue: 0,0:09:29.21,0:09:32.17,Default,,0,0,0,,Оны жалғыз алып жүру адамдарды алыс ұстауы керек
Dialogue: 0,0:09:32.29,0:09:34.67,Default,,0,0,0,,Нөл туралы көп білетін сияқтысыз.
Dialogue: 0,0:09:34.80,0:09:35.84,Default,,0,0,0,,Сіз дәл осылай айтасыз.
Dialogue: 0,0:09:35.96,0:09:36.96,Default,,0,0,0,,Сізден артық
Dialogue: 0,0:09:37.09,0:09:37.72,Default,,0,0,0,,Уф
Dialogue: 0,0:09:37.92,0:09:41.47,Default,,0,0,0,,Нөл - мен және бұл Корнелияның інісі.
Dialogue: 0,0:09:41.64,0:09:42.55,Default,,0,0,0,,Уф
Dialogue: 0,0:09:42.68,0:09:43.43,Default,,0,0,0,,Не!
Dialogue: 0,0:09:43.85,0:09:47.31,Default,,0,0,0,,Қасиетті Британ империясының бұрынғы 11-ші ханзадасы
Dialogue: 0,0:09:47.43,0:09:49.48,Default,,0,0,0,,Лелуш ви Британия
Dialogue: 0,0:09:49.60,0:09:52.36,Default,,0,0,0,,Мен ең жақсы көретін және қорқатын адам.
Dialogue: 0,0:09:52.48,0:09:53.31,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:09:53.44,0:09:55.90,Default,,0,0,0,,Нөл - Британ ханзадасы?
Dialogue: 0,0:09:56.28,0:09:57.53,Default,,0,0,0,,Диетард
Dialogue: 0,0:09:57.65,0:09:59.99,Default,,0,0,0,,Сіз мұны түсінбедіңіз бе?
Dialogue: 0,0:10:00.45,0:10:03.57,Default,,0,0,0,,Ол Жеремия мен Виллеттадан ақпарат алған сияқты.
Dialogue: 0,0:10:03.70,0:10:04.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:05.08,0:10:06.58,Default,,0,0,0,,Бұл босқа
Dialogue: 0,0:10:06.70,0:10:10.37,Default,,0,0,0,,Бізді осындай бос сөзбен шатастырғың келе ме?
Dialogue: 0,0:10:10.50,0:10:12.92,Default,,0,0,0,,Біз нөлді шежіре емес деп санаймыз...
Dialogue: 0,0:10:13.04,0:10:15.50,Default,,0,0,0,,Өйткені мен жасаған ғажайыптар арқылы танылдым.
Dialogue: 0,0:10:15.63,0:10:19.22,Default,,0,0,0,,Бірақ ғажайып жалған болса ше?
Dialogue: 0,0:10:19.34,0:10:20.30,Default,,0,0,0,,Жалған?
Dialogue: 0,0:10:20.42,0:10:23.55,Default,,0,0,0,,Нөлдің Geass деп аталатын ерекше күші бар.
Dialogue: 0,0:10:23.68,0:10:24.39,Default,,0,0,0,,Иә? (Диетард) Иә?
Dialogue: 0,0:10:24.51,0:10:27.18,Default,,0,0,0,,Бұл біреуді бұйрық беруге мәжбүрлеу күші.
Dialogue: 0,0:10:27.31,0:10:30.31,Default,,0,0,0,,Егер сіз оны күшті гипноз деп ойласаңыз
Dialogue: 0,0:10:30.43,0:10:32.85,Default,,0,0,0,,Бұл күш - ғажайып дән?
Dialogue: 0,0:10:32.98,0:10:35.23,Default,,0,0,0,,Менің нөлімді жамандама!
Dialogue: 0,0:10:35.36,0:10:38.40,Default,,0,0,0,,Ол жігіт сондай ақылды, батыл.
Dialogue: 0,0:10:38.86,0:10:40.49,Default,,0,0,0,,Ханзада, Геасс және т.б.
Dialogue: 0,0:10:40.61,0:10:43.45,Default,,0,0,0,,Дәлелдер қандай? Қандай дәлел?
Dialogue: 0,0:10:44.07,0:10:45.24,Default,,0,0,0,,Егер дәлелдер болса
Dialogue: 0,0:10:45.95,0:10:46.83,Default,,0,0,0,,Желдеткіш
Dialogue: 0,0:10:46.95,0:10:47.91,Default,,0,0,0,,Виллеттаға
Dialogue: 0,0:10:48.24,0:10:49.70,Default,,0,0,0,,Ол айтқандай
Dialogue: 0,0:10:50.45,0:10:53.50,Default,,0,0,0,,Нөлдің шынайы тұлғасы - Британияның бұрынғы ханзадасы Лелуч.
Dialogue: 0,0:10:54.25,0:10:56.67,Default,,0,0,0,,Геастың күшімен адамдарды манипуляциялау
Dialogue: 0,0:10:57.00,0:10:57.71,Default,,0,0,0,,Ол шарлатан.
Dialogue: 0,0:11:12.89,0:11:15.15,Default,,0,0,0,,Нөл бізді осы уақыт бойы алдады.
Dialogue: 0,0:11:15.86,0:11:18.61,Default,,0,0,0,,Әрқашан бізбен бірге пешка болып
Dialogue: 0,0:11:18.73,0:11:20.53,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:20.65,0:11:22.61,Default,,0,0,0,,Бірақ егер бұл рас болса
Dialogue: 0,0:11:22.74,0:11:23.57,Default,,0,0,0,,Уақыты келгенде айтамын.
Dialogue: 0,0:11:23.70,0:11:26.95,Default,,0,0,0,,Нөлдің өткен жетістіктері жоққа шығарылмайды.
Dialogue: 0,0:11:27.07,0:11:29.20,Default,,0,0,0,,Ал егер шынымен Геас болса...
Dialogue: 0,0:11:29.33,0:11:31.33,Default,,0,0,0,,Сенімді емес пе?
Dialogue: 0,0:11:31.45,0:11:34.29,Default,,0,0,0,,Британияға қарсы күшті қаруға айналады
Dialogue: 0,0:11:34.79,0:11:38.04,Default,,0,0,0,,Сол күш тек жауға қарсы қолданылса.
Dialogue: 0,0:11:38.17,0:11:38.79,Default,,0,0,0,,Не?
Dialogue: 0,0:11:38.92,0:11:40.34,Default,,0,0,0,,Бұл біз үшін де болуы мүмкін бе?
Dialogue: 0,0:11:40.46,0:11:41.84,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:41.96,0:11:45.18,Default,,0,0,0,,Ол өзінің әпкесі Эфемияны қолдан жасады...
Dialogue: 0,0:11:45.30,0:11:47.76,Default,,0,0,0,,Жапонияның ерекше аймағына жиналған он бір адам қырғынға ұшырады.
Dialogue: 0,0:11:47.89,0:11:51.39,Default,,0,0,0,,Dahoo! Нөл - әділдіктің одақтасы! Мұндай нәрсе
Dialogue: 0,0:11:51.52,0:11:53.02,Default,,0,0,0,,Дәлел бар.
Dialogue: 0,0:11:54.02,0:11:54.94,Default,,0,0,0,,Лелуш
Dialogue: 0,0:11:55.52,0:11:58.02,Default,,0,0,0,,Юффиге Геассты түсірдіңіз бе?
Dialogue: 0,0:11:58.15,0:11:58.90,Default,,0,0,0,,О
Dialogue: 0,0:11:59.02,0:12:01.28,Default,,0,0,0,,Жапондарды қыру
Dialogue: 0,0:12:01.40,0:12:03.11,Default,,0,0,0,,Мен тапсырыс бердім.
Dialogue: 0,0:12:03.69,0:12:05.28,Default,,0,0,0,,Сол қырғын...
Dialogue: 0,0:12:05.57,0:12:07.24,Default,,0,0,0,,Нөл осылай істеді.
Dialogue: 0,0:12:07.37,0:12:08.49,Default,,0,0,0,,Менің әпкем емес
Dialogue: 0,0:12:08.70,0:12:11.58,Default,,0,0,0,,Нөл маған жапондарды өлтіруді айтты.
Dialogue: 0,0:12:11.70,0:12:13.33,Default,,0,0,0,,Бұл жалған екені анық!
Dialogue: 0,0:12:13.79,0:12:14.62,Default,,0,0,0,,Бұл-
Dialogue: 0,0:12:14.75,0:12:18.00,Default,,0,0,0,,Адамға Геасс берілді деп күдіктенетін оқиға.
Dialogue: 0,0:12:20.88,0:12:24.13,Default,,0,0,0,,А, Кусакабе, генерал-майор Катасеге.
Dialogue: 0,0:12:31.97,0:12:34.02,Default,,0,0,0,,Міне.
Dialogue: 0,0:12:34.18,0:12:35.43,Default,,0,0,0,,Хловис
Dialogue: 0,0:12:35.73,0:12:37.10,Default,,0,0,0,,Мені де іліп қояды
Dialogue: 0,0:12:37.23,0:12:37.85,Default,,0,0,0,,Уф
Dialogue: 0,0:12:38.27,0:12:40.15,Default,,0,0,0,,Енді Такахидің өзгеруі...
Dialogue: 0,0:12:40.27,0:12:43.78,Default,,0,0,0,,Сондай-ақ Еремия мен басқалардың неліктен жақтарын ауыстырғанын түсіндіреді.
Dialogue: 0,0:12:44.03,0:12:48.53,Default,,0,0,0,,Мені оның Геасс айла-шарғы жасамайтынына кепілдік жоқ.
Dialogue: 0,0:12:48.66,0:12:51.12,Default,,0,0,0,,Осылай ойлағанда өте қорқынышты.
Dialogue: 0,0:12:51.33,0:12:52.79,Default,,0,0,0,,Әйтеуір... (Тамаки) Біз де бе?
Dialogue: 0,0:12:53.37,0:12:54.50,Default,,0,0,0,,Және тағы бір нәрсе
Dialogue: 0,0:12:55.33,0:12:56.33,Default,,0,0,0,,Біз алдын ала
Dialogue: 0,0:12:56.46,0:12:59.33,Default,,0,0,0,,Мен Нөлге Freya оқтұмсығы туралы хабарладым.
Dialogue: 0,0:12:59.46,0:13:01.71,Default,,0,0,0,,Себебі мен қажетсіз жанжалдан аулақ болғым келді.
Dialogue: 0,0:13:01.84,0:13:04.80,Default,,0,0,0,,Байланыс жазбалары Ланселот ішінде қалады.
Dialogue: 0,0:13:04.92,0:13:05.67,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:13:06.38,0:13:08.09,Default,,0,0,0,,Бізге айтқан жоқ
Dialogue: 0,0:13:08.47,0:13:10.09,Default,,0,0,0,,Нөлге сенуге болмайды
Dialogue: 0,0:13:11.68,0:13:12.93,Default,,0,0,0,,Шого
Dialogue: 0,0:13:13.06,0:13:15.22,Default,,0,0,0,,Мен оған сенгім келді.
Dialogue: 0,0:13:15.35,0:13:17.35,Default,,0,0,0,,Мен сенгім келді
Dialogue: 0,0:13:17.52,0:13:20.19,Default,,0,0,0,,Бірақ оған біз жай ғана...
Dialogue: 0,0:13:20.35,0:13:21.65,Default,,0,0,0,,Бұл бөлік пе?
Dialogue: 0,0:13:21.77,0:13:24.36,Default,,0,0,0,,Қарғыс атсын! Нөлдік бейбақ, Йокомо
Dialogue: 0,0:13:24.53,0:13:26.19,Default,,0,0,0,,Чикишо!
Dialogue: 0,0:13:27.07,0:13:29.70,Default,,0,0,0,,Бәрің, бауырым...
Dialogue: 0,0:13:29.82,0:13:31.74,Default,,0,0,0,,Нөлді бере аласыз ба?
Dialogue: 0,0:13:31.87,0:13:33.08,Default,,0,0,0,,Құт
Dialogue: 0,0:13:33.58,0:13:34.58,Default,,0,0,0,,Шарттар қолданылады
Dialogue: 0,0:13:34.70,0:13:35.79,Default,,0,0,0,,Эх (Тамаки) Охги
Dialogue: 0,0:13:36.08,0:13:38.50,Default,,0,0,0,,Сіз сауда жасауға мүмкіндігіңіз бар деп ойлайсыз ба?
Dialogue: 0,0:13:38.62,0:13:40.21,Default,,0,0,0,,Тыңдап көрейік.
Dialogue: 0,0:13:41.88,0:13:43.63,Default,,0,0,0,,Жапонияға оралу
Dialogue: 0,0:13:43.75,0:13:44.71,Default,,0,0,0,,Уф (2 адам) Ха
Dialogue: 0,0:13:45.13,0:13:47.26,Default,,0,0,0,,Сенген достарыңа опасыздық жаса
Dialogue: 0,0:13:47.38,0:13:49.47,Default,,0,0,0,,Бізге ең болмағанда Жапонияны қайтару керек.
Dialogue: 0,0:13:49.76,0:13:51.34,Default,,0,0,0,,Мен өзімді кешіре алмаймын
Dialogue: 0,0:13:58.93,0:14:01.23,Default,,0,0,0,,Ұстаз, киіміңізді шешіңіз.
Dialogue: 0,0:14:02.77,0:14:03.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.73,0:14:05.32,Default,,0,0,0,,Бір жері ауырады ма?
Dialogue: 0,0:14:05.52,0:14:07.86,Default,,0,0,0,,Қол жетпесе, мен аламын
Dialogue: 0,0:14:08.11,0:14:10.28,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:10.99,0:14:14.87,Default,,0,0,0,,Дұрыс, қол жетімсіз.
Dialogue: 0,0:14:16.12,0:14:18.08,Default,,0,0,0,,Нөл Кіруге бола ма?
Dialogue: 0,0:14:18.08,0:14:18.41,Default,,0,0,0,,Нөл Кіруге бола ма?
Dialogue: 0,0:14:18.08,0:14:18.41,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.41,0:14:18.54,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.54,0:14:19.54,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.54,0:14:19.54,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:14:19.66,0:14:20.33,Default,,0,0,0,,Карен
Dialogue: 0,0:14:23.50,0:14:26.00,Default,,0,0,0,,Оги-сан сенің №4 қоймаға келгеніңді қалайды.
Dialogue: 0,0:14:26.13,0:14:27.25,Default,,0,0,0,,№ 4?
Dialogue: 0,0:14:27.59,0:14:29.38,Default,,0,0,0,,Менде де мәліметтер бар.
Dialogue: 0,0:14:29.59,0:14:30.47,Default,,0,0,0,,Мастер
Dialogue: 0,0:14:30.59,0:14:31.68,Default,,0,0,0,,Иә? (C.C.) Га
Dialogue: 0,0:14:32.64,0:14:36.01,Default,,0,0,0,,Уф... киімдеріңді шешіңдерші, мен бар күшімді саламын.
Dialogue: 0,0:14:36.14,0:14:37.22,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:14:37.35,0:14:39.10,Default,,0,0,0,,Балалар сендер не істедіңдер?
Dialogue: 0,0:14:39.43,0:14:40.81,Default,,0,0,0,,Мен қамауға алынған кезде
Dialogue: 0,0:14:40.94,0:14:44.31,Default,,0,0,0,,Жоқ, бұл К.С. бұл...
Dialogue: 0,0:14:46.07,0:14:47.57,Default,,0,0,0,,Менің есте сақтау қабілетім жоғалып кетті.
Dialogue: 0,0:14:47.69,0:14:48.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.82,0:14:50.28,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:14:50.57,0:14:53.86,Default,,0,0,0,,Сонымен, С.С. енді мұнда жоқ екенін білесің.
Dialogue: 0,0:14:53.99,0:14:55.12,Default,,0,0,0,,Ах
Dialogue: 0,0:14:56.20,0:14:57.20,Default,,0,0,0,,Га
Dialogue: 0,0:14:58.37,0:15:00.33,Default,,0,0,0,,C.C. жоқ...
Dialogue: 0,0:15:01.71,0:15:03.12,Default,,0,0,0,,К.С. жоқ.
Dialogue: 0,0:15:03.54,0:15:06.88,Default,,0,0,0,,Енді Нанналли кеткенде, Лелуш ше?
Dialogue: 0,0:15:07.00,0:15:08.30,Default,,0,0,0,,Карен Ух
Dialogue: 0,0:15:08.42,0:15:10.01,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:15:10.13,0:15:12.30,Default,,0,0,0,,Құтқару тым кеш болды.
Dialogue: 0,0:15:13.13,0:15:17.18,Default,,0,0,0,,Лелуш, бұл менмін, мен Наннеллимен сөйлестім.
Dialogue: 0,0:15:17.35,0:15:18.97,Default,,0,0,0,,Сіз маған көмектестіңіз
Dialogue: 0,0:15:19.14,0:15:20.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:20.52,0:15:23.39,Default,,0,0,0,,Осындай кезде мен не айтарымды білмеймін...
Dialogue: 0,0:15:23.52,0:15:24.94,Default,,0,0,0,,Менің ағам да...
Dialogue: 0,0:15:25.06,0:15:25.69,Default,,0,0,0,,Уф
Dialogue: 0,0:15:25.81,0:15:26.56,Default,,0,0,0,,Ах
Dialogue: 0,0:15:29.23,0:15:30.61,Default,,0,0,0,,Ойлан, Нөл.
Dialogue: 0,0:15:30.73,0:15:33.28,Default,,0,0,0,,Сен бізді алдадың.
Dialogue: 0,0:15:33.40,0:15:35.61,Default,,0,0,0,,Мен сіздің Геас туралы білемін.
Dialogue: 0,0:15:35.74,0:15:37.32,Default,,0,0,0,,Жоқ! ? Уф
Dialogue: 0,0:15:38.37,0:15:42.46,Default,,0,0,0,,Аты аңызға айналған батыр Нөл шайқаста, амбицияларының ортасында өледі.
Dialogue: 0,0:15:42.58,0:15:47.25,Default,,0,0,0,,Бірақ оның ерлігі ел есінде мәңгі сақталады.
Dialogue: 0,0:15:47.59,0:15:50.55,Default,,0,0,0,,Диетард Бұл сіздің сценарийіңіз бе?
Dialogue: 0,0:15:50.67,0:15:51.67,Default,,0,0,0,,Егер шын болса-
Dialogue: 0,0:15:51.80,0:15:54.09,Default,,0,0,0,,Британияны жеңгенше...
Dialogue: 0,0:15:54.22,0:15:55.68,Default,,0,0,0,,Мен суретке түскім келді...
Dialogue: 0,0:15:55.80,0:15:58.64,Default,,0,0,0,,Өкінішке орай, бағдарлама тоқтатылды.
Dialogue: 0,0:15:59.01,0:16:00.01,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:00.14,0:16:03.02,Default,,0,0,0,,Қорқыныш жолында, бірақ жанкүйерлер қорғансыз.
Dialogue: 0,0:16:03.14,0:16:04.94,Default,,0,0,0,,Білмеу үшін Geass пайдаланыңыз
Dialogue: 0,0:16:05.06,0:16:06.90,Default,,0,0,0,,Саған бәрі сенді
Dialogue: 0,0:16:07.02,0:16:09.77,Default,,0,0,0,,Инуэ де, Йошида да сен үшін өлді.
Dialogue: 0,0:16:10.07,0:16:12.69,Default,,0,0,0,,Күте тұрыңыз! Бұл тым біржақты.
Dialogue: 0,0:16:12.82,0:16:15.65,Default,,0,0,0,,Біз нөлдің арқасында осыншама келген жоқпыз.
Dialogue: 0,0:16:15.78,0:16:16.45,Default,,0,0,0,,Оның айтқаны...
Dialogue: 0,0:16:16.57,0:16:17.62,Default,,0,0,0,,Жолдан кетіңіз Карен!
Dialogue: 0,0:16:17.74,0:16:19.45,Default,,0,0,0,,Нөлмен өлгіңіз келе ме?
Dialogue: 0,0:16:19.58,0:16:21.91,Default,,0,0,0,,Менің ойымша, ол Гиастың қол астында емес.
Dialogue: 0,0:16:25.37,0:16:26.96,Default,,0,0,0,,Лелушка жауап беріңіз
Dialogue: 0,0:16:27.08,0:16:29.46,Default,,0,0,0,,Мен сен үшін қандаймын?
Dialogue: 0,0:16:31.30,0:16:33.17,Default,,0,0,0,,Егер мен сенімен бірге болсам
Dialogue: 0,0:16:33.80,0:16:34.42,Default,,0,0,0,,Эй
Dialogue: 0,0:16:35.67,0:16:36.30,Default,,0,0,0,,Га
Dialogue: 0,0:16:36.84,0:16:40.51,Default,,0,0,0,,Түсіндім, бұл сіздің чекіңіз бе?
Dialogue: 0,0:16:40.64,0:16:43.64,Default,,0,0,0,,Олай болса, мүмкіндік жоқ шығар.
Dialogue: 0,0:16:44.02,0:16:45.81,Default,,0,0,0,,Әй, жауап беріңізші!
Dialogue: 0,0:16:45.94,0:16:47.52,Default,,0,0,0,,Фухахахахахахахаха
Dialogue: 0,0:16:47.65,0:16:48.31,Default,,0,0,0,,Га
Dialogue: 0,0:16:48.44,0:16:51.02,Default,,0,0,0,,Ақымақ мұны осы уақытқа дейін түсінді ме?
Dialogue: 0,0:16:51.15,0:16:51.90,Default,,0,0,0,,Га
Dialogue: 0,0:16:52.02,0:16:54.36,Default,,0,0,0,,Бізді қолданып жатқанын сезіну
Dialogue: 0,0:16:54.90,0:16:57.82,Default,,0,0,0,,Сіз пешкадан басқа ештеңе емессіз.
Dialogue: 0,0:16:57.95,0:16:59.70,Default,,0,0,0,,Сіз әлі де нөлсіз
Dialogue: 0,0:16:59.82,0:17:00.99,Default,,0,0,0,,Нөл
Dialogue: 0,0:17:01.66,0:17:02.66,Default,,0,0,0,,Лелуш...
Dialogue: 0,0:17:03.70,0:17:04.95,Default,,0,0,0,,Карен
Dialogue: 0,0:17:05.08,0:17:08.08,Default,,0,0,0,,Сіз олардың арасында ерекше тамаша туынды болдыңыз.
Dialogue: 0,0:17:08.21,0:17:10.92,Default,,0,0,0,,Иә, бәрі тақтада жазылған.
Dialogue: 0,0:17:11.04,0:17:13.50,Default,,0,0,0,,Бұл ойын болды.
Dialogue: 0,0:17:13.63,0:17:14.88,Default,,0,0,0,,Иә
Dialogue: 0,0:17:17.76,0:17:20.01,Default,,0,0,0,,Қош бол Лелуч
Dialogue: 0,0:17:21.01,0:17:21.64,Default,,0,0,0,,Тұрыс
Dialogue: 0,0:17:24.22,0:17:26.10,Default,,0,0,0,,Карен, сен өмір сүруің керек.
Dialogue: 0,0:17:27.48,0:17:28.23,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:17:28.77,0:17:29.56,Default,,0,0,0,,Уф
Dialogue: 0,0:17:29.69,0:17:30.52,Default,,0,0,0,,На
Dialogue: 0,0:17:30.65,0:17:31.94,Default,,0,0,0,,Амансың ба? Аға
Dialogue: 0,0:17:32.06,0:17:32.69,Default,,0,0,0,,Лоло!
Dialogue: 0,0:17:32.82,0:17:35.03,Default,,0,0,0,,Маған бәрібір, миражды түсір
Dialogue: 0,0:17:35.48,0:17:36.11,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:36.28,0:17:38.20,Default,,0,0,0,,Мен ағамды қорғаймын!
Dialogue: 0,0:17:41.87,0:17:43.74,Default,,0,0,0,,Тоқта, Лоло! Жетеді
Dialogue: 0,0:17:43.87,0:17:44.62,Default,,0,0,0,,Га
Dialogue: 0,0:17:45.58,0:17:46.62,Default,,0,0,0,,Мастер
Dialogue: 0,0:17:46.75,0:17:48.00,Default,,0,0,0,,Уа, кетті
Dialogue: 0,0:17:48.75,0:17:49.67,Default,,0,0,0,,Сағым
Dialogue: 0,0:17:49.92,0:17:51.67,Default,,0,0,0,,Бабыл мұнарасы кезінде
Dialogue: 0,0:17:51.88,0:17:53.71,Default,,0,0,0,,Аня Нөл қашып кетті.
Dialogue: 0,0:17:53.92,0:17:55.88,Default,,0,0,0,,Сіз оны Мордредпен ұстай аласыз ба?
Dialogue: 0,0:17:57.17,0:17:58.97,Default,,0,0,0,,Жою
Dialogue: 0,0:18:04.39,0:18:05.31,Default,,0,0,0,,Уф
Dialogue: 0,0:18:05.43,0:18:08.77,Default,,0,0,0,,Абсолюттік қорғаныс аймағын есептеу соншалықты қиын екеніне сене алмаймын.
Dialogue: 0,0:18:09.06,0:18:12.23,Default,,0,0,0,,Уау, інім керемет.
Dialogue: 0,0:18:12.35,0:18:14.57,Default,,0,0,0,,Роло, менің енді өмір сүруге себебім жоқ
Dialogue: 0,0:18:17.48,0:18:18.32,Default,,0,0,0,,Га
Dialogue: 0,0:18:19.74,0:18:20.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:21.07,0:18:22.78,Default,,0,0,0,,Не? бұл қозғалыс
Dialogue: 0,0:18:23.12,0:18:26.08,Default,,0,0,0,,Мен сені өлтіруге рұқсат берме, ешқашан
Dialogue: 0,0:18:27.24,0:18:29.04,Default,,0,0,0,,Геасс осындай кең аумақта
Dialogue: 0,0:18:29.37,0:18:32.79,Default,,0,0,0,,Лоло, сенің жүрегің бұдан былай шыдамайды.
Dialogue: 0,0:18:33.71,0:18:35.88,Default,,0,0,0,,Әрбір мүшеге мираждың қолға түскенін айтыңыз.
Dialogue: 0,0:18:36.05,0:18:38.26,Default,,0,0,0,,Шайқасқа дайын әскерлермен миражды жойыңыз.
Dialogue: 0,0:18:38.38,0:18:40.26,Default,,0,0,0,,Қайталау Миражды жойыңыз
Dialogue: 0,0:18:40.38,0:18:41.51,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:18:42.26,0:18:43.34,Default,,0,0,0,,Ой!
Dialogue: 0,0:18:46.68,0:18:49.10,Default,,0,0,0,,Болды, Лоло, мен біттім.
Dialogue: 0,0:18:49.22,0:18:51.81,Default,,0,0,0,,Жоқ, аға.
Dialogue: 0,0:18:51.94,0:18:52.94,Default,,0,0,0,,Осы дүкеннен қанша адам ғайып болды екен?
Dialogue: 0,0:19:01.11,0:19:04.32,Default,,0,0,0,,Мен әрқашан біреудің құралы болдым
Dialogue: 0,0:19:04.45,0:19:06.99,Default,,0,0,0,,...Жүгір, Лоло, сен неге мен сияқты бірдеңе істедің...
Dialogue: 0,0:19:08.04,0:19:10.54,Default,,0,0,0,,Мен топтың құралымын
Dialogue: 0,0:19:11.83,0:19:13.83,Default,,0,0,0,,...Мен өлемін...
Dialogue: 0,0:19:14.50,0:19:16.67,Default,,0,0,0,,Келесі менің ағамдікі
Dialogue: 0,0:19:17.00,0:19:18.88,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:19:19.00,0:19:22.51,Default,,0,0,0,,Мүмкін мені ағам пайдаланып жүрген шығар.
Dialogue: 0,0:19:22.72,0:19:23.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:23.76,0:19:26.43,Default,,0,0,0,,Тек сол уақыт шынайы болды.
Dialogue: 0,0:19:28.26,0:19:29.89,Default,,0,0,0,,...сіз туралы...
Dialogue: 0,0:19:30.27,0:19:31.73,Default,,0,0,0,,Сол естеліктерге рахмет...
Dialogue: 0,0:19:32.94,0:19:35.02,Default,,0,0,0,,Соңында мен...
Dialogue: 0,0:19:35.15,0:19:36.65,Default,,0,0,0,,Адам болды
Dialogue: 0,0:19:37.40,0:19:39.19,Default,,0,0,0,,Кууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:39.32,0:19:41.24,Default,,0,0,0,,...Оны қолданыңыз Ah Lolo!
Dialogue: 0,0:19:42.99,0:19:44.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:44.91,0:19:47.99,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:48.37,0:19:51.45,Default,,0,0,0,,Тоқта! Geass қолданбаңыз. Өлгің келе ме?
Dialogue: 0,0:19:52.79,0:19:55.54,Default,,0,0,0,,Мен... құрал емеспін!
Dialogue: 0,0:19:55.67,0:19:58.54,Default,,0,0,0,,Бұл менікі...
Dialogue: 0,0:19:58.67,0:20:00.59,Default,,0,0,0,,Бұл ерік!
Dialogue: 0,0:20:11.77,0:20:14.89,Default,,0,0,0,,Роло, сен мені неге құтқардың?
Dialogue: 0,0:20:15.31,0:20:16.98,Default,,0,0,0,,Мен сені қалаймын...
Dialogue: 0,0:20:17.35,0:20:20.19,Default,,0,0,0,,Менің ағам өтірікші.
Dialogue: 0,0:20:20.32,0:20:21.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.19,0:20:24.07,Default,,0,0,0,,Бұл өтірік... солай ма?
Dialogue: 0,0:20:24.19,0:20:26.36,Default,,0,0,0,,Сіз мені өлтірмек болдыңыз
Dialogue: 0,0:20:26.49,0:20:29.87,Default,,0,0,0,,Хе, мен сені жек көремін... Не деген иә?
Dialogue: 0,0:20:29.99,0:20:32.87,Default,,0,0,0,,Түсіндім, сіз оны толығымен түсіндіңіз.
Dialogue: 0,0:20:34.25,0:20:35.79,Default,,0,0,0,,Інім күткендей.
Dialogue: 0,0:20:36.67,0:20:38.88,Default,,0,0,0,,Иә... солай.
Dialogue: 0,0:20:39.00,0:20:42.09,Default,,0,0,0,,Әңгіме ағамға келгенде...
Dialogue: 0,0:20:42.21,0:20:45.22,Default,,0,0,0,,Мен бәрін түсінемін...
Dialogue: 0,0:20:46.47,0:20:48.47,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:20:50.22,0:20:53.39,Default,,0,0,0,,Ағаң өтірікші
Dialogue: 0,0:20:54.64,0:20:56.35,Default,,0,0,0,,Мақсатты растау мүмкін емес
Dialogue: 0,0:20:56.48,0:20:58.02,Default,,0,0,0,,Іздеу аймағын кеңейтіңіз
Dialogue: 0,0:20:58.15,0:21:00.48,Default,,0,0,0,,Жердегі топты жіберіңіз.
Dialogue: 0,0:21:00.69,0:21:04.40,Default,,0,0,0,,Хехехехехехехехехехе
Dialogue: 0,0:21:04.53,0:21:06.78,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,0:21:06.90,0:21:09.28,Default,,0,0,0,,Ахахахахха
Dialogue: 0,0:21:09.74,0:21:13.08,Default,,0,0,0,,Нуннал Роло Ширли
Dialogue: 0,0:21:13.20,0:21:16.71,Default,,0,0,0,,Қара рыцарьлар Мен бәрінен айырылдым
Dialogue: 0,0:21:17.12,0:21:19.29,Default,,0,0,0,,Бұл бізге қалды
Dialogue: 0,0:21:19.42,0:21:21.88,Default,,0,0,0,,Жоқ, сыйлық?
Dialogue: 0,0:21:22.09,0:21:24.51,Default,,0,0,0,,Бірақ сол себепті
Dialogue: 0,0:21:25.09,0:21:29.09,Default,,0,0,0,,Рахмет саған, Лоло, сен қостың бұл өмір.
Dialogue: 0,0:21:29.22,0:21:32.35,Default,,0,0,0,,Менде әлі бірдеңе бар еді.
Dialogue: 0,0:21:33.26,0:21:35.43,Default,,0,0,0,,Иә, маған
Dialogue: 0,0:21:36.52,0:21:38.27,Default,,0,0,0,,Мүмкін емес—
Dialogue: 0,0:21:38.85,0:21:42.61,Default,,0,0,0,,Маған бұл жүйені қолданатыным маңызды емес.
Dialogue: 0,0:21:42.90,0:21:45.98,Default,,0,0,0,,Рагнарек қосылымы
Dialogue: 0,0:21:46.11,0:21:51.99,Default,,0,0,0,,Бұл ескі дүниені жойып, жаңасын жасайды.
Dialogue: 0,0:21:52.70,0:21:55.95,Default,,0,0,0,,Менің әкем, Британдық Чарльз.
Dialogue: 0,0:21:56.16,0:21:58.58,Default,,0,0,0,,Менің тозаққа бара жатқанымда-
Dialogue: 0,0:21:58.71,0:22:00.79,Default,,0,0,0,,Мен сені менімен бірге келуіңді сұраймын.
Dialogue: 0,0:22:00.92,0:22:01.83,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:22:03.34,0:22:06.92,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.05,0:22:10.47,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.59,0:22:14.43,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық таныт, кемшілік гүлі
Dialogue: 0,0:22:14.56,0:22:17.85,Default,,0,0,0,,♪Екіжүзділіктің арманшыл көздерін бақылаңыз
Dialogue: 0,0:22:17.98,0:22:21.98,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.40,0:22:28.90,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.03,0:22:32.86,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:32.99,0:22:36.33,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.45,0:22:40.04,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.16,0:22:43.71,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.83,0:22:47.63,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.75,0:22:54.55,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.89,0:22:59.39,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін
Dialogue: 0,0:22:59.52,0:23:03.10,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.23,0:23:05.86,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:05.98,0:23:09.65,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.82,0:23:14.11,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.24,0:23:18.12,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.24,0:23:21.58,Default,,0,0,0,,♪Екі жүзді қылыш.
Dialogue: 0,0:23:21.71,0:23:25.29,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.42,0:23:32.42,Default,,0,0,0,,♪Өзіңіз қандай болсаңыз, солай болыңыз.
Dialogue: 0,0:23:37.68,0:23:41.43,Default,,0,0,0,,Ролло, сен екеуміздің арамызда қандай қарым-қатынас болды деп ойлаймын.
Dialogue: 0,0:23:41.56,0:23:44.06,Default,,0,0,0,,Мен әрқашан кейінірек білемін
Dialogue: 0,0:23:44.19,0:23:47.11,Default,,0,0,0,,Сіз Лелуш ви Британия емессіз.
Dialogue: 0,0:23:47.23,0:23:49.36,Default,,0,0,0,,Ол Лелуш Ламперуждің інісі.
Dialogue: 0,0:23:50.03,0:23:50.90,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:23:52.40,0:23:58.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory