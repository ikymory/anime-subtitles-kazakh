Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.39,0:00:04.44,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:04.60,0:00:07.73,Default,,0,0,0,,Британдық бала, Лелучтың ниетінен басқа...
Dialogue: 0,0:00:08.23,0:00:11.44,Default,,0,0,0,,Көптеген тілектер мен эмоциялар бар.
Dialogue: 0,0:00:12.03,0:00:13.57,Default,,0,0,0,,Сосын Лелуш...
Dialogue: 0,0:00:13.99,0:00:16.78,Default,,0,0,0,,Біз тағы бір жауға қарсы тұруымыз керек.
Dialogue: 0,0:00:17.16,0:00:21.50,Default,,0,0,0,,Бірақ біз іздеу керек жау...
Dialogue: 0,0:00:21.75,0:00:24.71,Default,,0,0,0,,Адамның өз ісіне айналуы
Dialogue: 0,0:00:25.50,0:00:29.00,Default,,0,0,0,,Үміт пен төлем, еркіндік пен жалғыздық
Dialogue: 0,0:00:29.17,0:00:31.46,Default,,0,0,0,,Бірақ дүниенің массасы...
Dialogue: 0,0:00:31.88,0:00:36.01,Default,,0,0,0,,Ол адамның еркіне қарамастан жай ғана ағып кетеді.
Dialogue: 0,0:00:37.26,0:00:41.81,Default,,0,0,0,,♪Дүниенің ақырында дүниеге келген нұр
Dialogue: 0,0:00:41.93,0:00:47.48,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:01:03.37,0:01:08.33,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:01:08.71,0:01:14.05,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:14.17,0:01:16.88,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:17.01,0:01:19.14,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:19.60,0:01:22.22,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:01:22.35,0:01:25.48,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:01:25.60,0:01:30.48,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:01:31.32,0:01:34.03,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:01:34.15,0:01:40.70,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:01:42.12,0:01:46.58,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:01:46.71,0:01:51.25,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:01:52.13,0:01:57.76,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:02:24.99,0:02:28.62,Default,,0,0,0,,) Чарльз, император болғаннан бері бірдеңе үйрендің бе?
Dialogue: 0,0:02:29.42,0:02:32.38,Default,,0,0,0,,Бәрі де өтірікші, ағайын.
Dialogue: 0,0:02:32.50,0:02:35.92,Default,,0,0,0,,Әдеттегідей Британия деп аталатын ел
Dialogue: 0,0:02:36.05,0:02:39.76,Default,,0,0,0,,Егер сіз адам деп атайтын болсаңыз, солай ма?
Dialogue: 0,0:02:40.01,0:02:41.64,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:02:42.43,0:02:46.77,Default,,0,0,0,,Чарльз, сіз біздің келісімшартты ұмытқан жоқсыз.
Dialogue: 0,0:02:46.89,0:02:52.31,Default,,0,0,0,,Білемін, Құдайды өлтірейік, дүниенің өтірігін жойайық.
Dialogue: 0,0:02:59.45,0:03:00.95,Default,,0,0,0,,Бұл қауіпті болды, аға.
Dialogue: 0,0:03:01.07,0:03:03.16,Default,,0,0,0,,Ширлидің жады қайта оралды.
Dialogue: 0,0:03:03.28,0:03:05.95,Default,,0,0,0,,Өйткені ол қолында мылтық ұстап ағамды қуып келе жатқан.
Dialogue: 0,0:03:06.08,0:03:09.04,Default,,0,0,0,,Түсіндім, сен Ширлисің.
Dialogue: 0,0:03:09.25,0:03:12.50,Default,,0,0,0,,Иә, мен ағамның жауларын жоюым керек.
Dialogue: 0,0:03:14.63,0:03:15.54,Default,,0,0,0,,Лоло
Dialogue: 0,0:03:15.67,0:03:16.71,Default,,0,0,0,,Не? Аға
Dialogue: 0,0:03:20.01,0:03:21.63,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:03:22.13,0:03:23.47,Default,,0,0,0,,Егер сіз осында болмасаңыз...
Dialogue: 0,0:03:23.59,0:03:25.51,Default,,0,0,0,,Менің сырым бәріне ашыла жаздады.
Dialogue: 0,0:03:25.76,0:03:28.93,Default,,0,0,0,,Өйткені бұл енді менің ағама ғана құпия емес.
Dialogue: 0,0:03:29.18,0:03:33.15,Default,,0,0,0,,Дұрыс, онда Геас тобын жойайық.
Dialogue: 0,0:03:33.27,0:03:33.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.56,0:03:37.94,Default,,0,0,0,,Қара рыцарлармен күтпеген шабуыл жасап, Геастың көзін жойыңыз
Dialogue: 0,0:03:38.07,0:03:41.99,Default,,0,0,0,,Жоқ, аға, Коданда әлі де Geass қолданушылары бар.
Dialogue: 0,0:03:42.40,0:03:44.70,Default,,0,0,0,,Қашып кетсең ертең келмейді
Dialogue: 0,0:03:45.03,0:03:47.58,Default,,0,0,0,,Ал біздің бақытты болуымыз үшін.
Dialogue: 0,0:03:47.70,0:03:48.49,Default,,0,0,0,,Біз?
Dialogue: 0,0:03:48.62,0:03:52.33,Default,,0,0,0,,Иә, В.В. саған да күмән келтіреді.
Dialogue: 0,0:03:55.13,0:03:57.13,Default,,0,0,0,,Сіз қорқасыз ба? В.В.
Dialogue: 0,0:03:57.29,0:04:00.21,Default,,0,0,0,,Себебі мені көтеріп алған ол.
Dialogue: 0,0:04:00.34,0:04:03.80,Default,,0,0,0,,Бірақ аға, мен сізге сене аламын ба?
Dialogue: 0,0:04:03.93,0:04:06.93,Default,,0,0,0,,Көрініп тұр, екеуі ағайынды емес пе?
Dialogue: 0,0:04:08.31,0:04:09.85,Default,,0,0,0,,Мені өлтіресің бе?
Dialogue: 0,0:04:09.97,0:04:12.60,Default,,0,0,0,,Әлде мені Геаспен басқарасың ба?
Dialogue: 0,0:04:12.73,0:04:13.89,Default,,0,0,0,,Юффи сияқты
Dialogue: 0,0:04:14.90,0:04:18.11,Default,,0,0,0,,Әпкемді ақтау үшін мен өз позициямды бердім.
Dialogue: 0,0:04:18.23,0:04:20.57,Default,,0,0,0,,Әскерден кеткен жақсы ғой, солай емес пе?
Dialogue: 0,0:04:21.65,0:04:24.28,Default,,0,0,0,,Менің ойымша, ағайындар...
Dialogue: 0,0:04:24.40,0:04:28.08,Default,,0,0,0,,Менің ойымша, бұл әлемдегі ең әдемі қарым-қатынас.
Dialogue: 0,0:04:30.79,0:04:33.62,Default,,0,0,0,,Оқ жарақатынан және қан кетуден болатын көптеген мүшелердің жеткіліксіздігі.
Dialogue: 0,0:04:34.00,0:04:37.92,Default,,0,0,0,,Ширли өзін атып тастады ма?
Dialogue: 0,0:04:38.04,0:04:39.92,Default,,0,0,0,,Иә пароксизмальды
Dialogue: 0,0:04:40.13,0:04:42.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:42.76,0:04:47.51,Default,,0,0,0,,(Шерлидің анасының жылағаны)
Dialogue: 0,0:04:47.64,0:04:50.76,Default,,0,0,0,,Ширли…
Dialogue: 0,0:04:50.93,0:04:53.18,Default,,0,0,0,,Ширли өз-өзіне қол жұмсады
Dialogue: 0,0:04:55.35,0:04:58.19,Default,,0,0,0,,Эй, Лелуш ше?
Dialogue: 0,0:05:02.03,0:05:04.15,Default,,0,0,0,,Иә, досым
Dialogue: 0,0:05:04.28,0:05:07.45,Default,,0,0,0,,Иә, Милле мырза менімен хабарласты.
Dialogue: 0,0:05:07.57,0:05:08.82,Default,,0,0,0,,Дос болдың ба?
Dialogue: 0,0:05:08.95,0:05:12.29,Default,,0,0,0,,Кел, сен өте жарқын бала екенсің.
Dialogue: 0,0:05:12.45,0:05:15.04,Default,,0,0,0,,Шынымды айтсам, мен оны жақсы білмедім.
Dialogue: 0,0:05:15.37,0:05:17.96,Default,,0,0,0,,Қызғанған жоқсың ба? Сол бала туралы
Dialogue: 0,0:05:18.17,0:05:20.96,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:05:21.30,0:05:25.67,Default,,0,0,0,,Себебі көз жасымды төгемін деп ойламадым.
Dialogue: 0,0:05:25.80,0:05:30.01,Default,,0,0,0,,Нина Көз жасыңды төге алсаң, бәрібір.
Dialogue: 0,0:05:34.22,0:05:36.18,Default,,0,0,0,,) Толығымен Лелуч заттары
Dialogue: 0,0:05:36.31,0:05:38.56,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:05:38.69,0:05:41.52,Default,,0,0,0,,Хабаршы болып, мені қалдыр
Dialogue: 0,0:05:44.15,0:05:49.03,Default,,0,0,0,,Иә? Мен келісім-шартты ұмытып кеткен шығармын деп қорқамын.
Dialogue: 0,0:05:49.16,0:05:53.33,Default,,0,0,0,,Оның орнына не істейсіз? мәңгі
Dialogue: 0,0:05:53.74,0:05:54.58,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:05:54.70,0:05:55.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.95,0:05:57.41,Default,,0,0,0,,Еремия мен Роллоның ынтымақтастығымен
Dialogue: 0,0:05:57.54,0:05:59.63,Default,,0,0,0,,Топтың орны анықталды.
Dialogue: 0,0:05:59.75,0:06:02.75,Default,,0,0,0,,Нөлдік отрядты енгізіңіз және өлтіруші корпусын бірден жойыңыз.
Dialogue: 0,0:06:02.88,0:06:06.13,Default,,0,0,0,,Жою? Сіз оны пайдалануыңыз керек емес пе?
Dialogue: 0,0:06:06.26,0:06:09.68,Default,,0,0,0,,Бұл қарулы ұйым емес, ол тек Геассты зерттейді...
Dialogue: 0,0:06:09.80,0:06:10.64,Default,,0,0,0,,Жою!
Dialogue: 0,0:06:12.43,0:06:13.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:21.36,0:06:24.94,Default,,0,0,0,,Ширли соңына дейін Гиастың мейіріміне бөленді.
Dialogue: 0,0:06:25.07,0:06:26.99,Default,,0,0,0,,Ширлиді Гиасс өлтірді
Dialogue: 0,0:06:27.53,0:06:29.66,Default,,0,0,0,,Сондықтан сіз Коуданды жойғыңыз келе ме?
Dialogue: 0,0:06:29.82,0:06:33.24,Default,,0,0,0,,Дәл сол қайғылы оқиғаның қайталанбауы үшін өтеу ретінде?
Dialogue: 0,0:06:33.45,0:06:35.91,Default,,0,0,0,,Бұл патшаның билігі болса...
Dialogue: 0,0:06:36.04,0:06:38.58,Default,,0,0,0,,Бір күшті адам жеткілікті
Dialogue: 0,0:06:38.71,0:06:41.83,Default,,0,0,0,,Ролода, әрине, Геастың күші бар.
Dialogue: 0,0:06:41.96,0:06:46.17,Default,,0,0,0,,Мен бұл дүниеден күнәнің бар екенін өшіремін.
Dialogue: 0,0:06:46.30,0:06:48.84,Default,,0,0,0,,Бұл мен Ширли үшін жасай алатын ең аз нәрсе.
Dialogue: 0,0:06:48.97,0:06:50.80,Default,,0,0,0,,Оны да жойайын ба?
Dialogue: 0,0:06:50.93,0:06:54.14,Default,,0,0,0,,Өшірейін десем де, өшіре алмас едім, өлмес бақсы.
Dialogue: 0,0:06:54.26,0:06:57.47,Default,,0,0,0,,V.V. өлместігі жағынан да бірдей.
Dialogue: 0,0:06:57.85,0:07:00.10,Default,,0,0,0,,Оларды әрекетке қабілетсіз етіңіз.
Dialogue: 0,0:07:00.23,0:07:02.35,Default,,0,0,0,,Сондай-ақ Хловис бір рет қолданған әдіс бар.
Dialogue: 0,0:07:03.02,0:07:03.86,Default,,0,0,0,,Ей, жақсы шықты, жақсы шықты. Қорқып қалдың ба?
Dialogue: 0,0:07:03.98,0:07:06.94,Default,,0,0,0,,Менімен ынтымақтасасың ба, жоқ па көргім келеді.
Dialogue: 0,0:07:07.07,0:07:09.28,Default,,0,0,0,,Менің ойымша, ол Қоуданның шыңы болды.
Dialogue: 0,0:07:09.40,0:07:10.74,Default,,0,0,0,,Бұл баяғыда болды
Dialogue: 0,0:07:10.86,0:07:14.45,Default,,0,0,0,,Оның үстіне мен жай ғана декорациямын, В.В.
Dialogue: 0,0:07:15.83,0:07:20.21,Default,,0,0,0,,Бірақ сен екеуміз сыбайлас болдық.
Dialogue: 0,0:07:20.33,0:07:22.75,Default,,0,0,0,,Жанашырлық кедергі бола ма?
Dialogue: 0,0:07:22.87,0:07:25.46,Default,,0,0,0,,Мен ақырын көруге дайынмын
Dialogue: 0,0:07:25.59,0:07:27.46,Default,,0,0,0,,Енді мен тағы бір нәрсені тексергім келеді.
Dialogue: 0,0:07:27.59,0:07:29.46,Default,,0,0,0,,Менімен жасалған шарттың мазмұны
Dialogue: 0,0:07:29.76,0:07:31.59,Default,,0,0,0,,Сіздің тілегіңіз қандай?
Dialogue: 0,0:07:31.72,0:07:35.47,Default,,0,0,0,,Менің ойымша, бұл операцияға ешқандай қатысы жоқ, сондықтан мен бұл туралы қазір айтпаймын.
Dialogue: 0,0:07:35.60,0:07:38.39,Default,,0,0,0,,Хмф, өзімшіл әйел.
Dialogue: 0,0:07:38.56,0:07:42.31,Default,,0,0,0,,Жарайды, мен C.C.
Dialogue: 0,0:07:44.73,0:07:46.61,Default,,0,0,0,,Батли және басқалары әлі...
Dialogue: 0,0:07:46.73,0:07:49.15,Default,,0,0,0,,Мәртебелі Корнелия ханшайымымен не болады?
Dialogue: 0,0:07:49.28,0:07:52.03,Default,,0,0,0,,Ең болмағанда ұлы мәртебелі императорға хабарласыңыз.
Dialogue: 0,0:07:52.15,0:07:53.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:53.95,0:07:56.83,Default,,0,0,0,,Чарльз Корнелияның қимылдары туралы білді ме?
Dialogue: 0,0:07:56.95,0:07:58.62,Default,,0,0,0,,Сіз білмедіңіз бе?
Dialogue: 0,0:07:58.74,0:07:59.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.62,0:08:02.91,Default,,0,0,0,,Лорд В.В.-ның тұрақты байланысы. Еремия.
Dialogue: 0,0:08:03.04,0:08:04.79,Default,,0,0,0,,О, оны осында қосыңыз.
Dialogue: 0,0:08:06.42,0:08:10.17,Default,,0,0,0,,Танысқаныма қуаныштымын, сіз В.В.
Dialogue: 0,0:08:10.42,0:08:11.34,Default,,0,0,0,,Лелуш
Dialogue: 0,0:08:11.88,0:08:14.13,Default,,0,0,0,,Неліктен Еремияның байланыс желісі?
Dialogue: 0,0:08:14.26,0:08:15.43,Default,,0,0,0,,Дерек көзі кім?
Dialogue: 0,0:08:15.55,0:08:18.26,Default,,0,0,0,,11-аймақ Эшфорд академиясының ішінде ме?
Dialogue: 0,0:08:18.85,0:08:21.14,Default,,0,0,0,,Енді өзіңізді таныстырудың қажеті жоқ.
Dialogue: 0,0:08:21.27,0:08:23.27,Default,,0,0,0,,Бұл туралы сізден сұрайын дегенім бар.
Dialogue: 0,0:08:23.39,0:08:24.81,Default,,0,0,0,,Токиодағы шешуші шайқас кезінде-
Dialogue: 0,0:08:24.94,0:08:26.90,Default,,0,0,0,,Наннеллиді ұрлаған сен бе?
Dialogue: 0,0:08:27.48,0:08:29.78,Default,,0,0,0,,Мені, Сузакуды және басқаларды Каминеджимаға жинаңыз.
Dialogue: 0,0:08:29.90,0:08:32.28,Default,,0,0,0,,Ол да бақылаушы болып көрінді.
Dialogue: 0,0:08:32.40,0:08:34.03,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:34.15,0:08:36.28,Default,,0,0,0,,Бірақ естігенде...
Dialogue: 0,0:08:36.41,0:08:38.49,Default,,0,0,0,,Менің есте сақтау қабілетім қайта оралды.
Dialogue: 0,0:08:38.66,0:08:40.24,Default,,0,0,0,,Ах, мен нөлмін.
Dialogue: 0,0:08:40.37,0:08:42.29,Default,,0,0,0,,Содан кейін C.C. да бірдей, солай ма?
Dialogue: 0,0:08:42.41,0:08:43.87,Default,,0,0,0,,Маған КК алуға бола ма?
Dialogue: 0,0:08:44.00,0:08:45.71,Default,,0,0,0,,Сонда сіз бос боласыз
Dialogue: 0,0:08:46.00,0:08:47.21,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:08:47.33,0:08:49.75,Default,,0,0,0,,Бұл сіз бен менің арамыздағы соғысқа айналды.
Dialogue: 0,0:08:50.09,0:08:51.67,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:51.80,0:08:55.09,Default,,0,0,0,,Бірақ сіз осында келгенше біз көшіп болдық.
Dialogue: 0,0:08:55.22,0:08:56.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:56.34,0:08:58.01,Default,,0,0,0,,Лорд В.В. Қошмар
Dialogue: 0,0:08:58.14,0:08:58.89,Default,,0,0,0,,Не?
Dialogue: 0,0:08:59.30,0:09:01.06,Default,,0,0,0,,Қара рыцарьлар шығар
Dialogue: 0,0:09:02.47,0:09:04.48,Default,,0,0,0,,В.В.-ның қазіргі тұрған жері анықталды.
Dialogue: 0,0:09:04.81,0:09:06.85,Default,,0,0,0,,Барлық күштер Альфа 7 нүктесін қоршайды
Dialogue: 0,0:09:09.06,0:09:11.36,Default,,0,0,0,,Түсіндім, солай ма?
Dialogue: 0,0:09:11.57,0:09:14.15,Default,,0,0,0,,Аа, аздаған уақыт кеткеніне қуаныштымын.
Dialogue: 0,0:09:14.53,0:09:16.70,Default,,0,0,0,,Егер сіз сақтықты сәл төмендетсеңіз
Dialogue: 0,0:09:17.20,0:09:19.16,Default,,0,0,0,,Мен әлі де 11-ауданда болдым деп ойладым
Dialogue: 0,0:09:19.62,0:09:22.08,Default,,0,0,0,,Қашуды сәл кешіктіру
Dialogue: 0,0:09:23.54,0:09:26.87,Default,,0,0,0,,V.V. Мен судьямын.
Dialogue: 0,0:09:31.50,0:09:35.51,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:09:38.43,0:09:41.35,Default,,0,0,0,,Зерттеу деректерін шығару жебеге тасымалдау
Dialogue: 0,0:09:41.47,0:09:43.18,Default,,0,0,0,,Ал мені соған дайында.
Dialogue: 0,0:09:43.89,0:09:45.48,Default,,0,0,0,,Мырза, өзіңіз бе?
Dialogue: 0,0:09:45.93,0:09:48.02,Default,,0,0,0,,Біз қашу үшін уақыт сатып алуымыз керек.
Dialogue: 0,0:09:48.40,0:09:51.61,Default,,0,0,0,,Ал Марианнаның баласына тәртіп керек.
Dialogue: 0,0:09:52.86,0:09:54.99,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:09:55.11,0:09:57.53,Default,,0,0,0,,Нунелли ханшайым болған.
Dialogue: 0,0:09:57.86,0:10:00.03,Default,,0,0,0,,Өтірік айтқаным үшін кешіріңіз.
Dialogue: 0,0:10:00.16,0:10:01.91,Default,,0,0,0,,Бірге серуендеу
Dialogue: 0,0:10:02.03,0:10:04.95,Default,,0,0,0,,Мен Эшфорд академиясына деген ностальгияны сезінемін.
Dialogue: 0,0:10:05.75,0:10:07.50,Default,,0,0,0,,Миллейді және басқаларды кездестірмеңіз.
Dialogue: 0,0:10:07.62,0:10:09.04,Default,,0,0,0,,Өйткені былай делінген:
Dialogue: 0,0:10:09.17,0:10:11.79,Default,,0,0,0,,Мен сөйлесе алатын жалғыз адам - Созаку-сан.
Dialogue: 0,0:10:11.92,0:10:15.26,Default,,0,0,0,,Ағаң да хабарсыз кеткен дейді.
Dialogue: 0,0:10:15.76,0:10:18.01,Default,,0,0,0,,Лелух қандай аға болды?
Dialogue: 0,0:10:18.18,0:10:18.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.26,0:10:22.64,Default,,0,0,0,,Өйткені менің де ағам бар еді.
Dialogue: 0,0:10:22.93,0:10:24.31,Default,,0,0,0,,Мен сол лайшаға қызғанып жүр едім…
Dialogue: 0,0:10:24.43,0:10:26.85,Default,,0,0,0,,Мен ағам туралы айта алатыныма сене алар емеспін.
Dialogue: 0,0:10:28.48,0:10:29.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:30.81,0:10:32.40,Default,,0,0,0,,Губернатор Нуналли
Dialogue: 0,0:10:32.52,0:10:35.07,Default,,0,0,0,,Мен №107 тұтқынды қарызға алғым келеді.
Dialogue: 0,0:10:38.57,0:10:41.91,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:10:42.03,0:10:43.16,Default,,0,0,0,,Уау аа
Dialogue: 0,0:10:43.28,0:10:44.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:45.62,0:10:48.12,Default,,0,0,0,,Капитанның орынбасары Киношита, бірдеңе дұрыс емес.
Dialogue: 0,0:10:48.25,0:10:50.83,Default,,0,0,0,,Бұл шынымен де британдық әскери мекеме ме?
Dialogue: 0,0:10:50.96,0:10:54.25,Default,,0,0,0,,Қарсы шабуыл болмағаны рас еді.
Dialogue: 0,0:10:54.38,0:10:57.42,Default,,0,0,0,,Мұндағы адамдардың барлығы қарусыз.
Dialogue: 0,0:10:57.55,0:10:59.17,Default,,0,0,0,,Күмәндансаңыз, жазалаңыз
Dialogue: 0,0:10:59.59,0:11:00.43,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:00.55,0:11:03.64,Default,,0,0,0,,Британия Қытай Федерациясының ақпаратшысымен тіл табысады...
Dialogue: 0,0:11:04.05,0:11:07.47,Default,,0,0,0,,Бұл жерде біз өлмейтін сарбаздарды зерттеп, тәжірибе жасап жатырмыз.
Dialogue: 0,0:11:07.60,0:11:10.31,Default,,0,0,0,,Өмірді мұндай қорлауға жол бермеу керек.
Dialogue: 0,0:11:10.69,0:11:12.65,Default,,0,0,0,,Барлық зерттеушілер мен деректер жойылады.
Dialogue: 0,0:11:13.40,0:11:15.98,Default,,0,0,0,,Сыналушының қайда жасырынып жатқанын білмейміз.
Dialogue: 0,0:11:16.19,0:11:18.99,Default,,0,0,0,,Сондықтан Альфа 7 нүктесін қоршап тұрғанда...
Dialogue: 0,0:11:19.11,0:11:21.91,Default,,0,0,0,,Барлығын жойып, өртеп жібер!
Dialogue: 0,0:11:22.03,0:11:24.37,Default,,0,0,0,,Сынақ тақырыбына ұқсайтын нәрсені тапқан кезде.
Dialogue: 0,0:11:24.49,0:11:27.04,Default,,0,0,0,,Барлығын жоғары қысымды қаптамада жабыңыз
Dialogue: 0,0:11:27.33,0:11:29.62,Default,,0,0,0,,Мен жеке тексеремін
Dialogue: 0,0:11:31.58,0:11:34.54,Default,,0,0,0,,Мәртебелі ханшайым Корнелия табылды ма?
Dialogue: 0,0:11:34.67,0:11:35.75,Default,,0,0,0,,Мен сізді құтқару үшін осы мүмкіндікті пайдалануым керек.
Dialogue: 0,0:11:35.75,0:11:37.21,Default,,0,0,0,,Мен сізді құтқару үшін осы мүмкіндікті пайдалануым керек.
Dialogue: 0,0:11:35.75,0:11:37.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:37.21,0:11:37.96,Default,,0,0,0,,Мен сізді құтқару үшін осы мүмкіндікті пайдалануым керек.
Dialogue: 0,0:11:41.38,0:11:44.34,Default,,0,0,0,,Ол адам Хловиспен бірге болды, менің ойымша.
Dialogue: 0,0:11:44.47,0:11:45.89,Default,,0,0,0,,C.C.
Dialogue: 0,0:11:46.05,0:11:49.60,Default,,0,0,0,,Сіз қайтып келдіңіз. Бізге көмектесіңізші, C.C.
Dialogue: 0,0:11:50.43,0:11:51.48,Default,,0,0,0,,Ах
Dialogue: 0,0:11:55.48,0:11:57.15,Default,,0,0,0,,Жоғары мәртебелі Кукловис
Dialogue: 0,0:11:57.98,0:12:02.61,Default,,0,0,0,,Мәртебелі императорға сый көрсеткісі келген өлмейтін әйел...
Dialogue: 0,0:12:02.74,0:12:07.70,Default,,0,0,0,,Мәртебелі оның бар екенін білген сияқты.
Dialogue: 0,0:12:08.33,0:12:10.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:11.50,0:12:16.08,Default,,0,0,0,,Мен ол әйелге араласпауым керек еді.
Dialogue: 0,0:12:22.88,0:12:26.22,Default,,0,0,0,,Иә, Zero Britannia зерттеу мекемесіне шабуыл жасады.
Dialogue: 0,0:12:26.34,0:12:28.60,Default,,0,0,0,,Дегенмен, операцияның орны мен егжей-тегжейіне келетін болсақ,
Dialogue: 0,0:12:29.01,0:12:30.64,Default,,0,0,0,,Тағы бір құпия әрекет?
Dialogue: 0,0:12:30.77,0:12:32.77,Default,,0,0,0,,Енді Сауд Арабиясы тынышталды...
Dialogue: 0,0:12:32.89,0:12:35.90,Default,,0,0,0,,Біз Америка Құрама Штаттарының Жарғысын ратификациялауды тездетуіміз керек.
Dialogue: 0,0:12:36.06,0:12:36.90,Default,,0,0,0,,Шынында-
Dialogue: 0,0:12:37.02,0:12:40.69,Default,,0,0,0,,Британдық қауіп-қатерге төтеп беретін күштердің саны артып келеді.
Dialogue: 0,0:12:40.82,0:12:41.78,Default,,0,0,0,,) Бірақ-
Dialogue: 0,0:12:41.90,0:12:44.99,Default,,0,0,0,,Италия мен Польша біздің одақтасымыз болды.
Dialogue: 0,0:12:45.11,0:12:47.45,Default,,0,0,0,,Нөл оралған бойда маған хабарласыңыз.
Dialogue: 0,0:12:47.74,0:12:49.28,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:50.70,0:12:52.37,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:12:52.50,0:12:54.16,Default,,0,0,0,,Иә Нөлдің әрекеттері -
Dialogue: 0,0:12:54.29,0:12:57.67,Default,,0,0,0,,Бар болу құпия сақталуы керек
Dialogue: 0,0:12:58.08,0:13:00.71,Default,,0,0,0,,Олай болса, командирдің орынбасары Огиге еруіңізді сұраймын.
Dialogue: 0,0:13:00.84,0:13:01.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.96,0:13:06.05,Default,,0,0,0,,Командирдің орынбасары Оги кешегі жиналыстан бері біртүрлі әрекет етті.
Dialogue: 0,0:13:06.18,0:13:09.26,Default,,0,0,0,,Жоқ, содан бері бірдеңені жасырып жүр.
Dialogue: 0,0:13:11.14,0:13:13.68,Default,,0,0,0,,А, енді Қытай Федерациясына рейс
Dialogue: 0,0:13:14.43,0:13:16.98,Default,,0,0,0,,Мен Құпия барлау қызметіне тиесілімін.
Dialogue: 0,0:13:17.10,0:13:19.65,Default,,0,0,0,,Бұл ұлы мәртебелі императордың тікелей бақылауындағы ұйым ма?
Dialogue: 0,0:13:19.77,0:13:22.98,Default,,0,0,0,,Аа, дипломатиялық арналар арқылы арнайы рейс болған шығар?
Dialogue: 0,0:13:23.40,0:13:25.07,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:25.86,0:13:28.57,Default,,0,0,0,,Еремияны Лелух тұтқынға алғандықтан
Dialogue: 0,0:13:28.70,0:13:32.49,Default,,0,0,0,,Нөл үшін, егер қосалқы команда жауды ұшырып жіберетін сияқты болса.
Dialogue: 0,0:13:32.79,0:13:35.29,Default,,0,0,0,,Желдеткіш пернесі
Dialogue: 0,0:13:36.83,0:13:37.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:38.25,0:13:40.13,Default,,0,0,0,,Неліктен мұнда бала бар?
Dialogue: 0,0:13:40.46,0:13:41.50,Default,,0,0,0,,Фуфу
Dialogue: 0,0:13:52.64,0:13:54.64,Default,,0,0,0,,К-кешір!
Dialogue: 0,0:13:56.77,0:13:58.77,Default,,0,0,0,,қол қол
Dialogue: 0,0:13:59.44,0:14:01.44,Default,,0,0,0,,Ой-а-а
Dialogue: 0,0:14:03.15,0:14:04.73,Default,,0,0,0,,Мори сен де
Dialogue: 0,0:14:05.11,0:14:06.53,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:14:11.53,0:14:12.87,Default,,0,0,0,,Ах Геасс?
Dialogue: 0,0:14:12.99,0:14:14.29,Default,,0,0,0,,Бұл қуат
Dialogue: 0,0:14:14.41,0:14:15.58,Default,,0,0,0,,Роло-оний-чан?
Dialogue: 0,0:14:15.75,0:14:18.25,Default,,0,0,0,,А, қалайсың?
Dialogue: 0,0:14:23.63,0:14:29.18,Default,,0,0,0,,Ха, жаңа жігіт, Роло дедің бе? Сіз де осындасыз.
Dialogue: 0,0:14:30.76,0:14:33.01,Default,,0,0,0,,Енді маңызды емес
Dialogue: 0,0:14:33.26,0:14:35.85,Default,,0,0,0,,Ағаның соңынан ергенше
Dialogue: 0,0:14:37.52,0:14:40.69,Default,,0,0,0,,Хехехе хахаха Енді мен В.В.
Dialogue: 0,0:14:40.81,0:14:44.23,Default,,0,0,0,,Ролоның ұшағына орнатылған бомбаны іске қосу ғана қалды.
Dialogue: 0,0:14:44.36,0:14:47.82,Default,,0,0,0,,Роллоның өмірін Ширлиге ескерткіш ретінде ұсыну
Dialogue: 0,0:14:47.94,0:14:49.07,Default,,0,0,0,,Мен сізге төлеймін
Dialogue: 0,0:14:50.28,0:14:51.45,Default,,0,0,0,,Не?
Dialogue: 0,0:14:53.62,0:14:54.53,Default,,0,0,0,,Зигфрид?
Dialogue: 0,0:14:54.87,0:14:55.66,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:14:55.66,0:14:56.41,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:14:55.66,0:14:56.41,Default,,0,0,0,,Еремия Мен бұл ұшақ екеніне сенімдімін
Dialogue: 0,0:14:56.41,0:14:57.37,Default,,0,0,0,,Еремия Мен бұл ұшақ екеніне сенімдімін
Dialogue: 0,0:14:57.58,0:15:02.71,Default,,0,0,0,,Иә, бұл жүйке потенциалдық байланыс, сондықтан оны қозғалтатын менен басқа ешкім жоқ.
Dialogue: 0,0:15:02.83,0:15:03.67,Default,,0,0,0,,Хун
Dialogue: 0,0:15:03.79,0:15:04.50,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:15:08.13,0:15:09.34,Default,,0,0,0,,Бұл таңқаларлық В.В.
Dialogue: 0,0:15:10.55,0:15:12.68,Default,,0,0,0,,Бақылаушы ненің қатысушысы болады?
Dialogue: 0,0:15:12.97,0:15:16.22,Default,,0,0,0,,Сен маған аздап ұнадың, Лелуч.
Dialogue: 0,0:15:17.14,0:15:19.14,Default,,0,0,0,,Себебі сен Чарльзға ұқсайсың
Dialogue: 0,0:15:21.10,0:15:23.69,Default,,0,0,0,,Бұл жерде Зигфрид деген не?
Dialogue: 0,0:15:23.81,0:15:26.32,Default,,0,0,0,,Артыңызда жүріңіз, ол сіздің артыңызда.
Dialogue: 0,0:15:29.53,0:15:30.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.40,0:15:31.78,Default,,0,0,0,,Міне, В.В.
Dialogue: 0,0:15:31.99,0:15:33.53,Default,,0,0,0,,Қазір беріл.
Dialogue: 0,0:15:33.99,0:15:36.78,Default,,0,0,0,,Сіз не туралы айтып отырсыз? сатқындар
Dialogue: 0,0:15:37.33,0:15:39.83,Default,,0,0,0,,V.V. Мен сені ол жерден сүйреп шығарамын.
Dialogue: 0,0:15:40.04,0:15:41.66,Default,,0,0,0,,Барлық күштер шабуылға кіріседі
Dialogue: 0,0:15:41.83,0:15:44.17,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:15:47.13,0:15:47.88,Default,,0,0,0,,Ол да солардың бірі ғана ғой, иә?
Dialogue: 0,0:15:50.13,0:15:52.59,Default,,0,0,0,,Цк, электромагниттік сауыт әлі тірі және жақсы ма?
Dialogue: 0,0:15:52.76,0:15:55.09,Default,,0,0,0,,Марианнаның баласын алып кетсе де
Dialogue: 0,0:15:59.43,0:16:02.27,Default,,0,0,0,,Бұл менің адалдығым үшін болуы керек машина.
Dialogue: 0,0:16:02.52,0:16:05.77,Default,,0,0,0,,Еремия Сіз Нөлді жек көрдіңіз, солай ма?
Dialogue: 0,0:16:06.06,0:16:07.15,Default,,0,0,0,,Иә
Dialogue: 0,0:16:07.27,0:16:11.07,Default,,0,0,0,,Өйткені мен енді император отбасына деген адалдығымды орындай алмаймын деп ойладым.
Dialogue: 0,0:16:11.19,0:16:13.91,Default,,0,0,0,,Алайда, егер мен қызмет ететін шебер нөл болды.
Dialogue: 0,0:16:14.45,0:16:16.28,Default,,0,0,0,,Сондай-ақ Марианна үшін!
Dialogue: 0,0:16:16.66,0:16:19.79,Default,,0,0,0,,Сіз бұл есімді айтасыз ба?
Dialogue: 0,0:16:23.67,0:16:25.54,Default,,0,0,0,,Барлық қалған ұшақтарды шығарыңыз!
Dialogue: 0,0:16:25.67,0:16:28.80,Default,,0,0,0,,Мұндағы ең жақсы жігіт құбыжықтың сыртында отырған сияқты!
Dialogue: 0,0:16:31.84,0:16:33.17,Default,,0,0,0,,Ширли?
Dialogue: 0,0:16:33.30,0:16:35.72,Default,,0,0,0,,Сот-медициналық дәлелдемелер бұл өзін-өзі өлтіру екенін айтады.
Dialogue: 0,0:16:35.93,0:16:37.18,Default,,0,0,0,,Мен ондай қыз емеспін.
Dialogue: 0,0:16:37.30,0:16:39.26,Default,,0,0,0,,Созаку! Сіз де мұны білесіз, солай ма?
Dialogue: 0,0:16:39.39,0:16:43.27,Default,,0,0,0,,Аа, егер оны өлтірген қылмыскер болса.
Dialogue: 0,0:16:43.43,0:16:44.06,Default,,0,0,0,,Га
Dialogue: 0,0:16:44.19,0:16:46.60,Default,,0,0,0,,Иә, бұл Лелуш.
Dialogue: 0,0:16:46.73,0:16:47.86,Default,,0,0,0,,Құт
Dialogue: 0,0:16:48.69,0:16:51.36,Default,,0,0,0,,Роло, оны Зигфридке неге тіркемейсің?
Dialogue: 0,0:16:51.86,0:16:55.32,Default,,0,0,0,,Бірақ Геасс В.В.-ға қарсы жұмыс істемейді.
Dialogue: 0,0:16:55.45,0:16:58.37,Default,,0,0,0,,Тек оны ұстап алсаңыз болғаны. Басқа нұсқалар бар.
Dialogue: 0,0:16:58.49,0:17:00.03,Default,,0,0,0,,Иә, мен тырысамын.
Dialogue: 0,0:17:01.24,0:17:02.16,Default,,0,0,0,,Лоло
Dialogue: 0,0:17:02.29,0:17:05.21,Default,,0,0,0,,Осы жерде Зигфрид пен басқалардан құтылайық.
Dialogue: 0,0:17:05.50,0:17:07.46,Default,,0,0,0,,Винсентке қойылған бомбамен
Dialogue: 0,0:17:09.54,0:17:11.71,Default,,0,0,0,,Мен де ініме жасаймын
Dialogue: 0,0:17:14.72,0:17:18.47,Default,,0,0,0,,Бұл жолы Роло ма? Сен де маған өтірік айттың
Dialogue: 0,0:17:18.97,0:17:21.64,Default,,0,0,0,,Геасс маған жұмыс істемейтінін білсем де.
Dialogue: 0,0:17:27.19,0:17:28.10,Default,,0,0,0,,Иә
Dialogue: 0,0:17:28.23,0:17:31.23,Default,,0,0,0,,Магистр В.В. Қашуға дайын.
Dialogue: 0,0:17:31.36,0:17:33.74,Default,,0,0,0,,Мен ЕО-ға бет алғаным дұрыс па? дәл қазір?
Dialogue: 0,0:17:33.90,0:17:36.61,Default,,0,0,0,,Иә, мен бұл жерді тазалағаннан кейін сізге қосыламын.
Dialogue: 0,0:17:36.90,0:17:39.99,Default,,0,0,0,,Енді С.С.-ны қалай ұстау керектігі түсінікті.
Dialogue: 0,0:17:40.12,0:17:43.29,Default,,0,0,0,,Осы жерден қашып құтыла алсақ, Чарльз екеуміз жеңеміз.
Dialogue: 0,0:17:45.37,0:17:46.58,Default,,0,0,0,,Егер сіз оны тіркесеңіз болды!
Dialogue: 0,0:17:46.71,0:17:49.25,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:17:49.88,0:17:53.67,Default,,0,0,0,,Геассты пайдаланған кезде менің де жүрегім тоқтап қалды...
Dialogue: 0,0:17:53.80,0:17:56.26,Default,,0,0,0,,Кез келген уақытта өліп қалуы мүмкін ақаулы өнім.
Dialogue: 0,0:17:58.59,0:18:00.30,Default,,0,0,0,,Егер сіз әлі де тазалап жатсаңыз
Dialogue: 0,0:18:01.43,0:18:02.60,Default,,0,0,0,,Иә
Dialogue: 0,0:18:03.06,0:18:04.64,Default,,0,0,0,,Орындалды, аға.
Dialogue: 0,0:18:05.64,0:18:07.35,Default,,0,0,0,,Уау! Ааааааа!
Dialogue: 0,0:18:07.64,0:18:08.85,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:08.98,0:18:10.61,Default,,0,0,0,,Жарайсың Роло
Dialogue: 0,0:18:10.73,0:18:12.61,Default,,0,0,0,,Сонымен, сен мұнда несің?
Dialogue: 0,0:18:14.65,0:18:15.49,Default,,0,0,0,,Уф
Dialogue: 0,0:18:16.82,0:18:17.57,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:18:19.66,0:18:23.33,Default,,0,0,0,,Бұл кім? Зигфридтің әлсіз жақтарын білетін шабуыл
Dialogue: 0,0:18:30.58,0:18:32.42,Default,,0,0,0,,Сіз В.В.
Dialogue: 0,0:18:32.54,0:18:35.51,Default,,0,0,0,,Сен мені осал қылдың, әлсіз деп менсінбедің.
Dialogue: 0,0:18:35.63,0:18:36.80,Default,,0,0,0,,Уф
Dialogue: 0,0:18:37.42,0:18:39.18,Default,,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:18:39.30,0:18:41.05,Default,,0,0,0,,Жоқ, бұл туралы алаңдамаңыз.
Dialogue: 0,0:18:41.64,0:18:44.39,Default,,0,0,0,,Мен Корнелия осында болады деп ешқашан күтпедім.
Dialogue: 0,0:18:44.81,0:18:48.06,Default,,0,0,0,,Зигфридтің сауыттары зақымданғаннан кейін ол тікелей жөнделді.
Dialogue: 0,0:18:48.18,0:18:49.77,Default,,0,0,0,,Кууууу
Dialogue: 0,0:18:50.10,0:18:53.02,Default,,0,0,0,,Юффидің жаулары, оларды сол жерде жойыңыз.
Dialogue: 0,0:18:53.52,0:18:54.36,Default,,0,0,0,,Геасс
Dialogue: 0,0:18:54.48,0:18:55.32,Default,,0,0,0,,Дереккөз!
Dialogue: 0,0:18:59.40,0:19:03.20,Default,,0,0,0,,Уф, жоқ, бұл Зигфрид әлдеқашан...
Dialogue: 0,0:19:07.08,0:19:10.33,Default,,0,0,0,,Лелуч, қарғыс атқан ханзада.
Dialogue: 0,0:19:10.46,0:19:11.71,Default,,0,0,0,,Ха, Мәртебелі ханшайым.
Dialogue: 0,0:19:17.67,0:19:18.97,Default,,0,0,0,,Зигфрид
Dialogue: 0,0:19:19.09,0:19:20.26,Default,,0,0,0,,Лорд В.В.
Dialogue: 0,0:19:20.38,0:19:21.09,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:19:21.51,0:19:24.60,Default,,0,0,0,,Лорд В.В. шірімейтін денесі бар.
Dialogue: 0,0:19:24.72,0:19:27.64,Default,,0,0,0,,Сондай-ақ төменгі қабаттағы Ымырт есігін пайдалана алуыңыз керек.
Dialogue: 0,0:19:27.77,0:19:31.60,Default,,0,0,0,,Бұл жер зерттеу деректерімен бірге біз ғана.
Dialogue: 0,0:19:31.77,0:19:32.81,Default,,0,0,0,,Na (2-ші діни қызметкер) Мүмкін емес.
Dialogue: 0,0:19:32.94,0:19:34.06,Default,,0,0,0,,Құрметті С.К.!
Dialogue: 0,0:19:36.07,0:19:40.65,Default,,0,0,0,,Кешіріңіз, сізді жалғыз қалдырғаным үшін бұл менің кінәм.
Dialogue: 0,0:19:40.78,0:19:43.66,Default,,0,0,0,,Сонымен Геастың шежіресі осымен аяқталады.
Dialogue: 0,0:19:44.49,0:19:47.74,Default,,0,0,0,,Бұл мен және Лелуш шығар.
Dialogue: 0,0:19:52.79,0:19:58.00,Default,,0,0,0,,Барлық дәлелдер мен айғақтар Лелуштың ақ екенін айтады.
Dialogue: 0,0:19:58.13,0:20:00.30,Default,,0,0,0,,Бірақ менің жүрегім әрқашан
Dialogue: 0,0:20:00.42,0:20:03.59,Default,,0,0,0,,Егер Лелуш кінәлі болса, егер ол Нөл болса.
Dialogue: 0,0:20:03.89,0:20:07.47,Default,,0,0,0,,Мен Нөлдің шынайы тұлғасын білмеймін. Мен тұтқынға түскенде айттым ғой.
Dialogue: 0,0:20:07.60,0:20:09.31,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:20:09.52,0:20:11.60,Default,,0,0,0,,Қайғылы оқиғалардың алдын алу үшін...
Dialogue: 0,0:20:12.06,0:20:13.98,Default,,0,0,0,,Құралдарға әуестенбе
Dialogue: 0,0:20:14.35,0:20:16.52,Default,,0,0,0,,Сонымен, осы сөзбен
Dialogue: 0,0:20:16.65,0:20:17.40,Default,,0,0,0,,Га
Dialogue: 0,0:20:18.15,0:20:20.19,Default,,0,0,0,,Нысана нысанға қашып кетті.
Dialogue: 0,0:20:20.53,0:20:22.49,Default,,0,0,0,,Мен төменнен зерттеймін
Dialogue: 0,0:20:22.61,0:20:24.11,Default,,0,0,0,,Роло жоғарғы деңгейден іздейді
Dialogue: 0,0:20:24.24,0:20:27.74,Default,,0,0,0,,Киношита, әскерлеріңізді басқарып, ортаңғы бөлікті аралаңыз.
Dialogue: 0,0:20:28.03,0:20:34.04,Default,,0,0,0,,Хахахаха, Лелуш, жақсы.
Dialogue: 0,0:20:42.59,0:20:45.55,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын, Чарльз.
Dialogue: 0,0:20:46.18,0:20:49.22,Default,,0,0,0,,Өйткені, ең соңғы сенетін нәрсе - ағаң.
Dialogue: 0,0:20:49.43,0:20:50.43,Default,,0,0,0,,Аға
Dialogue: 0,0:20:50.56,0:20:54.35,Default,,0,0,0,,Лелушка өлтіруші жібергеніңіз рас па?
Dialogue: 0,0:20:54.48,0:20:57.06,Default,,0,0,0,,Сенің арқаңда мен кек алдым.
Dialogue: 0,0:20:57.86,0:21:01.69,Default,,0,0,0,,Бірақ мен Лелуш нөл екенін білдім.
Dialogue: 0,0:21:01.82,0:21:05.45,Default,,0,0,0,,Ол Нунеллиді де алдады.
Dialogue: 0,0:21:05.86,0:21:08.99,Default,,0,0,0,,Менің ағам тағы да өтірік айтты.
Dialogue: 0,0:21:10.54,0:21:12.62,Default,,0,0,0,,Бұл Британиямен бірдей емес пе?
Dialogue: 0,0:21:13.00,0:21:16.71,Default,,0,0,0,,Балаларды өлтіру қажет болды ма? шынымен
Dialogue: 0,0:21:19.34,0:21:21.80,Default,,0,0,0,,Иә? Бұл жерде биологиялық реакция бар ма?
Dialogue: 0,0:21:22.42,0:21:25.38,Default,,0,0,0,,Сіз бастапқы нүктеге оралдыңыз ба? В.В.
Dialogue: 0,0:21:28.43,0:21:32.10,Default,,0,0,0,,Не? Кешіріңіз, бұл Каминеджима.
Dialogue: 0,0:21:38.31,0:21:42.07,Default,,0,0,0,,Мен қашан сағым болдым? Ал мұнда?
Dialogue: 0,0:21:42.19,0:21:44.03,Default,,0,0,0,,Бұл голограмма емес пе?
Dialogue: 0,0:21:44.49,0:21:46.07,Default,,0,0,0,,Дұрыс (Лелуш)
Dialogue: 0,0:21:46.24,0:21:49.70,Default,,0,0,0,,Және қорқынышты түс сияқты қадірсіз нәрсе
Dialogue: 0,0:21:49.91,0:21:53.91,Default,,0,0,0,,Акашаның қылышы Бұл жүйеге дейін ешқашан болған емес
Dialogue: 0,0:21:54.79,0:21:55.91,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:21:56.04,0:22:00.13,Default,,0,0,0,,Ұлым Лелух, уақыт келді.
Dialogue: 0,0:22:00.33,0:22:03.25,Default,,0,0,0,,Өтеу уақыты
Dialogue: 0,0:22:03.38,0:22:06.97,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.09,0:22:10.51,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.64,0:22:14.47,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық көрсет, жамандық гүлі.
Dialogue: 0,0:22:14.60,0:22:17.89,Default,,0,0,0,,♪Екіжүзділіктің армандаған көздерін бақылаңыз
Dialogue: 0,0:22:18.02,0:22:22.02,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.44,0:22:28.95,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.07,0:22:32.91,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағын
Dialogue: 0,0:22:33.03,0:22:36.37,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.50,0:22:40.08,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.21,0:22:43.75,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.88,0:22:47.67,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.80,0:22:54.60,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.93,0:22:59.44,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.56,0:23:03.15,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.27,0:23:05.90,Default,,0,0,0,,♪ Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:06.03,0:23:09.70,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.86,0:23:14.16,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.28,0:23:18.16,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.29,0:23:21.62,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.75,0:23:25.34,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.46,0:23:32.47,Default,,0,0,0,,♪Өзіңді қандай болсаң солай қалдыр.
Dialogue: 0,0:23:37.47,0:23:39.31,Default,,0,0,0,,Неліктен император менің алдымда?
Dialogue: 0,0:23:39.43,0:23:42.56,Default,,0,0,0,,Ең жақсы жоспар - оны менікі ету үшін менің Геасымды пайдалану.
Dialogue: 0,0:23:42.69,0:23:46.23,Default,,0,0,0,,Бірақ оның Геассы мен бұл жер кедергі.
Dialogue: 0,0:23:46.36,0:23:47.94,Default,,0,0,0,,Менің қолымнан келетін нәрсе бар ма?
Dialogue: 0,0:23:48.07,0:23:51.40,Default,,0,0,0,,Өмірде бір рет болатын мүмкіндікті пайдаланыңыз...
Dialogue: 0,0:23:52.90,0:23:58.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory