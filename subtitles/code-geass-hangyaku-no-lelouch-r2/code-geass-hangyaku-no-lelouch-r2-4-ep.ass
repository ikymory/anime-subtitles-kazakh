Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.06,0:00:04.31,Default,,0,0,0,,Енді ертең әлі бар
Dialogue: 0,0:00:04.44,0:00:05.90,Default,,0,0,0,,Лелуш Ламперуж үшін...
Dialogue: 0,0:00:06.02,0:00:08.07,Default,,0,0,0,,Армандайтын ертең бар
Dialogue: 0,0:00:08.44,0:00:12.32,Default,,0,0,0,,Соның негізін мен жұмбақ қыз С.С.
Dialogue: 0,0:00:12.44,0:00:14.11,Default,,0,0,0,,Өзінің Геассы
Dialogue: 0,0:00:14.24,0:00:18.12,Default,,0,0,0,,Кез келген адамға бұйрық беруге мүмкіндік беретін абсолютті мойынсұну күші
Dialogue: 0,0:00:18.74,0:00:19.58,Default,,0,0,0,,Geass пайдалану-
Dialogue: 0,0:00:19.83,0:00:23.50,Default,,0,0,0,,Лелух Қасиетті Британ империясын жоюға шешім қабылдады.
Dialogue: 0,0:00:23.62,0:00:25.67,Default,,0,0,0,,Мұның бәрі анамның жауларынан кек алу.
Dialogue: 0,0:00:25.79,0:00:29.88,Default,,0,0,0,,Менің әпкем Нуналли бақытты өмір сүретін әлемді құру.
Dialogue: 0,0:00:30.71,0:00:33.80,Default,,0,0,0,,11 колония аймағына айналған Жапониядан.
Dialogue: 0,0:00:33.92,0:00:36.76,Default,,0,0,0,,Енді әлемге ант басталады
Dialogue: 0,0:00:37.22,0:00:42.64,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:00:42.77,0:00:45.44,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:00:45.56,0:00:48.36,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:00:48.48,0:00:53.90,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:00:54.03,0:00:56.86,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:00:56.99,0:00:59.74,Default,,0,0,0,,♪Енді кеттік, мен аққан жұлдызмын
Dialogue: 0,0:01:05.54,0:01:11.00,Default,,0,0,0,,♪Дүние ыдыраса да, ешқашан өзгермейтін нәрселер бар.
Dialogue: 0,0:01:11.13,0:01:16.59,Default,,0,0,0,,♪Көз жасымызды тыйсақ та, қорғайтын нәрсе бар.
Dialogue: 0,0:01:16.72,0:01:19.47,Default,,0,0,0,,♪Он мыңдаған жылдар бұрынғы хабарлар дененің ішінде.
Dialogue: 0,0:01:19.60,0:01:22.01,Default,,0,0,0,,♪Сырылдап, ызылдай бастайды
Dialogue: 0,0:01:22.31,0:01:24.93,Default,,0,0,0,,♪Ертең қарлығаш дауыспен қоңырау шалыңыз
Dialogue: 0,0:01:25.10,0:01:28.06,Default,,0,0,0,,♪Мен сені тыртық қолыммен қорғаймын
Dialogue: 0,0:01:28.31,0:01:31.11,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:31.23,0:01:33.65,Default,,0,0,0,,♪Мен күресуді жалғастырамын
Dialogue: 0,0:01:35.28,0:01:40.53,Default,,0,0,0,,♪Сағындым сені таң-түн
Dialogue: 0,0:01:40.66,0:01:43.04,Default,,0,0,0,,♪Жұлдыз боламын, Кимимамору
Dialogue: 0,0:01:43.49,0:01:46.33,Default,,0,0,0,,♪Ұрыс белгісіз
Dialogue: 0,0:01:46.46,0:01:51.84,Default,,0,0,0,,♪Ертең мен кешегі күннің қиылысында
Dialogue: 0,0:01:51.96,0:01:54.46,Default,,0,0,0,,♪Сен екеуміз қиылыспаймыз
Dialogue: 0,0:01:54.59,0:01:59.05,Default,,0,0,0,,♪Тағдырды кесіп өткен аққан жұлдыз
Dialogue: 0,0:01:59.18,0:02:03.51,Default,,0,0,0,,♪Тасып жатқан көз жасыңды мен қазір алып кетемін
Dialogue: 0,0:02:21.45,0:02:22.32,Default,,0,0,0,,Хмм? иә?
Dialogue: 0,0:02:22.45,0:02:23.62,Default,,0,0,0,,Балалар?
Dialogue: 0,0:02:32.71,0:02:33.50,Default,,0,0,0,,Иә
Dialogue: 0,0:02:33.63,0:02:35.88,Default,,0,0,0,,Қанша адамды өлтіргенім есімде жоқ
Dialogue: 0,0:02:36.88,0:02:37.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:39.34,0:02:41.05,Default,,0,0,0,,Тіс тазалау және тамақтану...
Dialogue: 0,0:02:41.18,0:02:42.76,Default,,0,0,0,,Есептейтін ешкім жоқ
Dialogue: 0,0:02:42.89,0:02:43.76,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:02:45.85,0:02:49.89,Default,,0,0,0,,Маған менің Геассим өлтіруге жарамды деп айтты.
Dialogue: 0,0:02:50.02,0:02:53.52,Default,,0,0,0,,Сондықтан мен оларды өлтірдім, өйткені менің басқа болатын жерім жоқ.
Dialogue: 0,0:02:55.23,0:02:57.82,Default,,0,0,0,,Жасырын операция? Сіз інісін ойнайсыз ба?
Dialogue: 0,0:02:58.49,0:03:00.24,Default,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:03:00.36,0:03:02.99,Default,,0,0,0,,Мен ата-анам мен отбасымды танымаймын.
Dialogue: 0,0:03:04.16,0:03:06.29,Default,,0,0,0,,Жоқ, егер бұл тапсырыс болса.
Dialogue: 0,0:03:06.91,0:03:09.96,Default,,0,0,0,,Менің үлкен ағам - Лелуш Ламперуж
Dialogue: 0,0:03:13.54,0:03:14.75,Default,,0,0,0,,Сіздің Geass -
Dialogue: 0,0:03:14.88,0:03:16.30,Default,,0,0,0,,Уақытты тоқтату мүмкіндігі?
Dialogue: 0,0:03:16.63,0:03:18.46,Default,,0,0,0,,Жауап беруге ешқандай себеп жоқ
Dialogue: 0,0:03:18.59,0:03:20.67,Default,,0,0,0,,Маған берілген нұсқаулар:
Dialogue: 0,0:03:20.80,0:03:23.64,Default,,0,0,0,,Лелуш Ламперуждің естеліктері қайта оралса...
Dialogue: 0,0:03:23.76,0:03:26.89,Default,,0,0,0,,Егер Нөл қайта тірілсе, оны өлтіріңіз.
Dialogue: 0,0:03:27.01,0:03:30.14,Default,,0,0,0,,16 17 18…
Dialogue: 0,0:03:30.27,0:03:32.23,Default,,0,0,0,,Не? Бұл сан
Dialogue: 0,0:03:32.35,0:03:34.02,Default,,0,0,0,,Сіз пайда болғаннан бері...
Dialogue: 0,0:03:34.35,0:03:36.86,Default,,0,0,0,,Сағатты санамда санап жүрдім
Dialogue: 0,0:03:37.15,0:03:39.90,Default,,0,0,0,,Бірақ қазір сандар өшірулі.
Dialogue: 0,0:03:40.36,0:03:41.45,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,0:03:41.70,0:03:44.32,Default,,0,0,0,,Нуналлиді іздеуде пешка болыңыз.
Dialogue: 0,0:03:51.12,0:03:54.58,Default,,0,0,0,,Ролло, сенің тоқтатқаның уақыт емес.
Dialogue: 0,0:03:54.71,0:03:56.75,Default,,0,0,0,,Тек менің тәжірибе уақытым
Dialogue: 0,0:03:56.88,0:03:59.71,Default,,0,0,0,,Соны түсінсең де, менен жеңе алмайсың.
Dialogue: 0,0:04:00.88,0:04:04.76,Default,,0,0,0,,Иә, мен сияқты ешкім өмір сүре алмайды.
Dialogue: 0,0:04:04.89,0:04:07.39,Default,,0,0,0,,Ролло, дұрыс айтасыз.
Dialogue: 0,0:04:07.89,0:04:11.85,Default,,0,0,0,,Мені бірден өлтірмейтін себебім, бәлкім, мен мұны білемін.
Dialogue: 0,0:04:11.98,0:04:14.81,Default,,0,0,0,,Осы қарқынмен мен екеуін де ала алмаймын.
Dialogue: 0,0:04:14.94,0:04:15.56,Default,,0,0,0,,Екі?
Dialogue: 0,0:04:15.77,0:04:19.27,Default,,0,0,0,,Бірі мені жем ретінде іздеген С.С.
Dialogue: 0,0:04:19.40,0:04:23.32,Default,,0,0,0,,Мені жіберсең, С.С.-ны сүйреп апарамын. шығып.
Dialogue: 0,0:04:23.78,0:04:25.78,Default,,0,0,0,,Сіз сатасыз ба? C.C.
Dialogue: 0,0:04:25.91,0:04:28.78,Default,,0,0,0,,Оны өз өміріңмен салыстыруға болмайды.
Dialogue: 0,0:04:29.28,0:04:30.12,Default,,0,0,0,,Ал екіншісі ше?
Dialogue: 0,0:04:30.58,0:04:31.62,Default,,0,0,0,,Сіздің өміріңіз
Dialogue: 0,0:04:31.75,0:04:34.21,Default,,0,0,0,,Әй, бұл не деген өмір?
Dialogue: 0,0:04:34.33,0:04:36.04,Default,,0,0,0,,Rollo Болашақ қандай болады?
Dialogue: 0,0:04:36.17,0:04:36.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.08,0:04:38.79,Default,,0,0,0,,Болашақ – үміт
Dialogue: 0,0:04:38.92,0:04:41.80,Default,,0,0,0,,Сіздің міндетіңізден басқа үміт бар ма?
Dialogue: 0,0:04:41.92,0:04:43.80,Default,,0,0,0,,С.С.-ны басып алу арқылы.
Dialogue: 0,0:04:43.92,0:04:46.30,Default,,0,0,0,,Сізді қандай болашақ күтіп тұр?
Dialogue: 0,0:04:46.43,0:04:49.22,Default,,0,0,0,,Ештеңе қазіргідей өзгермейді.
Dialogue: 0,0:04:49.35,0:04:50.97,Default,,0,0,0,,Бұл миссия
Dialogue: 0,0:04:51.10,0:04:53.60,Default,,0,0,0,,Мені өлтірсең, тапсырмаңды орындай алмайсың.
Dialogue: 0,0:04:53.73,0:04:55.98,Default,,0,0,0,,Сіз C.C.-ны ұстағыңыз келеді, солай ма?
Dialogue: 0,0:04:56.56,0:04:59.69,Default,,0,0,0,,Мен C.C. сүйреп апарамын. ертең шығады.
Dialogue: 0,0:04:59.82,0:05:02.78,Default,,0,0,0,,Сонда сіз жаңа болашаққа қол жеткізе аласыз
Dialogue: 0,0:05:03.03,0:05:04.99,Default,,0,0,0,,Жарайды, өтірік айтпаймын.
Dialogue: 0,0:05:05.57,0:05:06.66,Default,,0,0,0,,Тек сіз үшін
Dialogue: 0,0:05:08.82,0:05:10.37,Default,,0,0,0,,Бұл маған Аомориді еске түсіреді.
Dialogue: 0,0:05:10.49,0:05:13.70,Default,,0,0,0,,Одан да жақсы, өйткені бәрі киім киіп алған.
Dialogue: 0,0:05:13.83,0:05:18.00,Default,,0,0,0,,Уф, менің ойымша, Зеро Геассты Бас консулға тағайындады.
Dialogue: 0,0:05:18.13,0:05:19.17,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:05:19.29,0:05:22.38,Default,,0,0,0,,Егер сіз осы орынды алсаңыз...
Dialogue: 0,0:05:22.50,0:05:24.34,Default,,0,0,0,,Біз және Лелуш
Dialogue: 0,0:05:24.92,0:05:27.30,Default,,0,0,0,,Ол қайтадан ыдырай ма? (есіктің ашылған дыбысы)
Dialogue: 0,0:05:27.80,0:05:30.22,Default,,0,0,0,,Сіздің жалғыз келгеніңіз таң қалдырады.
Dialogue: 0,0:05:31.89,0:05:33.68,Default,,0,0,0,,Қытай Федерациясының Бас консулы -
Dialogue: 0,0:05:33.81,0:05:36.60,Default,,0,0,0,,АҚШ Жапонияны тануы керек еді?
Dialogue: 0,0:05:36.73,0:05:38.40,Default,,0,0,0,,) Адам өледі деп жоспарланған.
Dialogue: 0,0:05:38.52,0:05:39.19,Default,,0,0,0,,Иә?сурет?
Dialogue: 0,0:05:39.31,0:05:42.94,Default,,0,0,0,,Әлде қара рыцарьлар жүретін жолды таңдайсыз ба?
Dialogue: 0,0:05:43.28,0:05:44.57,Default,,0,0,0,,Күте тұрыңыз, кенет солай.
Dialogue: 0,0:05:44.69,0:05:49.20,Default,,0,0,0,,Жарайды, бас консул бізбен соғысып өлсін.
Dialogue: 0,0:05:49.32,0:05:49.99,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:05:50.82,0:05:53.16,Default,,0,0,0,,Нөл күтпеген триггерді шығарған сияқты.
Dialogue: 0,0:05:53.79,0:05:56.83,Default,,0,0,0,,Асыл амбиция ма әлде дүниелік амбиция ма?
Dialogue: 0,0:05:59.00,0:06:01.88,Default,,0,0,0,,Мен Ролоның күтуіне жеткілікті уақыт сатып алдым.
Dialogue: 0,0:06:02.50,0:06:04.30,Default,,0,0,0,,Егер сіз C.C.
Dialogue: 0,0:06:04.42,0:06:06.72,Default,,0,0,0,,Менің естеліктерімді елемейсің.
Dialogue: 0,0:06:07.22,0:06:10.51,Default,,0,0,0,,Бірақ оның шығу тегі қандай?
Dialogue: 0,0:06:10.64,0:06:13.89,Default,,0,0,0,,Бұл Британиядағы ілгерілеу мен адалдықтан басқаша көрінеді.
Dialogue: 0,0:06:14.01,0:06:17.60,Default,,0,0,0,,Басқа жолды іздеу керек пе?
Dialogue: 0,0:06:17.73,0:06:20.73,Default,,0,0,0,,Бұл қауіпті карта, бірақ оған тұрарлық.
Dialogue: 0,0:06:20.85,0:06:22.77,Default,,0,0,0,,Біз екілене алмаймыз.
Dialogue: 0,0:06:22.90,0:06:26.03,Default,,0,0,0,,Тодо және басқалары ертең өлім жазасына кесіледі.
Dialogue: 0,0:06:26.15,0:06:29.40,Default,,0,0,0,,Не істеу керек? Менің Геасымды Роло ашты.
Dialogue: 0,0:06:29.53,0:06:31.32,Default,,0,0,0,,Ролоны өлтірсем де...
Dialogue: 0,0:06:31.45,0:06:33.83,Default,,0,0,0,,Есімнің қайта оралғанын санам біледі.
Dialogue: 0,0:06:34.16,0:06:35.79,Default,,0,0,0,,Егер бұл орын алса, Нуналли
Dialogue: 0,0:06:35.91,0:06:39.04,Default,,0,0,0,,Мен Нуннеллиді құтқарғанша...
Dialogue: 0,0:06:39.16,0:06:41.63,Default,,0,0,0,,Студент болып жүре беруден басқа амалым жоқ.
Dialogue: 0,0:06:42.04,0:06:45.63,Default,,0,0,0,,Бақытымызға орай, Гилфордпен және басқалармен эмоционалды байланыс аз сияқты.
Dialogue: 0,0:06:46.34,0:06:48.84,Default,,0,0,0,,Жасырын түннің ашылмағаны...
Dialogue: 0,0:06:48.97,0:06:50.55,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:06:50.72,0:06:54.01,Default,,0,0,0,,Бірақ болды, мен не істеуім керек?
Dialogue: 0,0:06:54.14,0:06:55.93,Default,,0,0,0,,Қара рыцарларды құтқару-
Dialogue: 0,0:06:56.06,0:06:59.10,Default,,0,0,0,,Ролоны бір уақытта қалай жоюға болады
Dialogue: 0,0:07:06.40,0:07:08.15,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:07:08.65,0:07:11.24,Default,,0,0,0,,Бруноны өлтірген сол бала емес пе?
Dialogue: 0,0:07:11.36,0:07:12.57,Default,,0,0,0,,Бұл бесінші адам.
Dialogue: 0,0:07:12.70,0:07:15.41,Default,,0,0,0,,Виктор жаңа ғана зымыранына қолын тигізді.
Dialogue: 0,0:07:15.53,0:07:17.70,Default,,0,0,0,,Оның әрқашан қиындықтары болды.
Dialogue: 0,0:07:17.83,0:07:19.45,Default,,0,0,0,,Сізді өлтіруге жетпейтін шығар
Dialogue: 0,0:07:19.87,0:07:24.75,Default,,0,0,0,,Енді өзін нөл деп атайтын адам пайда болды, біз біртұтас болуымыз керек.
Dialogue: 0,0:07:24.88,0:07:28.13,Default,,0,0,0,,Сіз достарыңызды өлтіретін өлім құдайымен біріге алмайсыз.
Dialogue: 0,0:07:29.42,0:07:32.80,Default,,0,0,0,,Команда? Ең бастысы - миссия
Dialogue: 0,0:07:32.93,0:07:34.30,Default,,0,0,0,,Достар
Dialogue: 0,0:07:36.56,0:07:39.14,Default,,0,0,0,,Әй, қайта жаңғырған нөл - бұл нөл, солай ма?
Dialogue: 0,0:07:39.27,0:07:40.39,Default,,0,0,0,,) Саана
Dialogue: 0,0:07:40.52,0:07:44.02,Default,,0,0,0,,Қалай болғанда да, олар бізді қайтадан тастап кететін шығар.
Dialogue: 0,0:07:44.52,0:07:46.98,Default,,0,0,0,,Консулдықтағы жарылыстың себебі неде?
Dialogue: 0,0:07:47.11,0:07:49.11,Default,,0,0,0,,Әзірге ресми хабарландыру жоқ
Dialogue: 0,0:07:49.23,0:07:52.20,Default,,0,0,0,,Үкімнің орындалуын мақұлдайтынымды жаңа ғана хабардар еттім.
Dialogue: 0,0:07:52.32,0:07:55.53,Default,,0,0,0,,Әй, өлім жазасына кесу тек көрсету үшін.
Dialogue: 0,0:07:55.66,0:07:57.49,Default,,0,0,0,,Бұл дұрыс емес әдіс.
Dialogue: 0,0:07:57.74,0:07:59.79,Default,,0,0,0,,Нөл пайда бола ма?
Dialogue: 0,0:07:59.91,0:08:01.41,Default,,0,0,0,,Шықпаса, жақсы.
Dialogue: 0,0:08:01.54,0:08:02.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.50,0:08:05.00,Default,,0,0,0,,Егер Нөл керемет жасауға тырыспаса...
Dialogue: 0,0:08:05.13,0:08:06.96,Default,,0,0,0,,Қоғамдық қолдау жоқ
Dialogue: 0,0:08:07.09,0:08:08.92,Default,,0,0,0,,Сіз сонша ойладыңыз ба?
Dialogue: 0,0:08:09.17,0:08:12.38,Default,,0,0,0,,Бірақ мен сенің келгеніңді қалаймын.
Dialogue: 0,0:08:13.22,0:08:15.55,Default,,0,0,0,,Жоқ, солай деп үміттенемін.
Dialogue: 0,0:08:16.01,0:08:19.39,Default,,0,0,0,,Бір жерде жүрген ханшайымыма
Dialogue: 0,0:08:21.27,0:08:24.48,Default,,0,0,0,,Неліктен АҚШ Жапонияны мойындады?
Dialogue: 0,0:08:24.77,0:08:27.69,Default,,0,0,0,,Шукин Ситимен тексерусіз өз қалауым бойынша
Dialogue: 0,0:08:27.81,0:08:31.82,Default,,0,0,0,,Сіз ұлы уәзірлердің бірі болсаңыз да, бұл қабылданбайды.
Dialogue: 0,0:08:32.07,0:08:34.95,Default,,0,0,0,,Нөлді пайдалану мақсаты қандай болса да,
Dialogue: 0,0:08:35.07,0:08:37.37,Default,,0,0,0,,Ешқашан нөлді қолданбаңыз
Dialogue: 0,0:08:37.49,0:08:39.12,Default,,0,0,0,,Нөл – бақыт
Dialogue: 0,0:08:39.45,0:08:40.79,Default,,0,0,0,,Аспан Ұлының еркі қандай?
Dialogue: 0,0:08:40.91,0:08:42.95,Default,,0,0,0,,Мен анау қыздан жақсымын.
Dialogue: 0,0:08:43.08,0:08:47.08,Default,,0,0,0,,Абсолюттік заң - нөл мені бақытты етеді
Dialogue: 0,0:08:47.21,0:08:48.42,Default,,0,0,0,,Бұл сатқын
Dialogue: 0,0:08:48.54,0:08:49.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:51.88,0:08:53.88,Default,,0,0,0,,Бенитен өлді
Dialogue: 0,0:08:56.68,0:09:00.22,Default,,0,0,0,,Өлтіруге, ақпаратты манипуляциялауға, жасыруға болмайды...
Dialogue: 0,0:09:00.35,0:09:02.43,Default,,0,0,0,,Қайда барсаң да, Роло тығырыққа тіреледі.
Dialogue: 0,0:09:02.68,0:09:07.94,Default,,0,0,0,,Иә, орындау басталғанға дейін бұл ақпаратты қандай да бір түрде растаңыз.
Dialogue: 0,0:09:08.06,0:09:09.15,Default,,0,0,0,,Га
Dialogue: 0,0:09:15.70,0:09:17.49,Default,,0,0,0,,Бір кездері өздерін Қара рыцарлар деп атаған.
Dialogue: 0,0:09:17.61,0:09:20.41,Default,,0,0,0,,11-аймаққа кедергі келтірген лаңкестерді жазалау...
Dialogue: 0,0:09:20.53,0:09:22.74,Default,,0,0,0,,Орындауға жақын
Dialogue: 0,0:09:22.87,0:09:26.37,Default,,0,0,0,,Нөл шынымен бағыныштысы өлім жазасына кесілгенде пайда бола ма?
Dialogue: 0,0:09:26.58,0:09:28.13,Default,,0,0,0,,Құрметті Нөл, өтінемін...
Dialogue: 0,0:09:28.25,0:09:29.75,Default,,0,0,0,,Генерал Тодо (әйел) Мені өлтірме
Dialogue: 0,0:09:30.67,0:09:31.88,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:37.76,0:09:41.35,Default,,0,0,0,,Нөл бізге опасыздық жасады. Оның бізге көмекке келуі мүмкін емес.
Dialogue: 0,0:09:41.47,0:09:45.27,Default,,0,0,0,,Ол міндетті түрде келеді. Ол шын болса, тірі болса.
Dialogue: 0,0:09:45.39,0:09:47.14,Default,,0,0,0,,Мен ғажайып жасауға келе жатырмын.
Dialogue: 0,0:09:47.27,0:09:49.10,Default,,0,0,0,,Керемет?
Dialogue: 0,0:09:49.40,0:09:51.02,Default,,0,0,0,,Бұл – Әйел Титан
Dialogue: 0,0:09:51.15,0:09:54.03,Default,,0,0,0,,Мүмкіндік аз болғанымен, С.С.
Dialogue: 0,0:09:57.90,0:10:01.49,Default,,0,0,0,,Ogi Kaname Бұл соңы.
Dialogue: 0,0:10:04.91,0:10:06.20,Default,,0,0,0,,Шық, Нөл.
Dialogue: 0,0:10:06.45,0:10:09.42,Default,,0,0,0,,Әке Андреас Дальтонның жауы
Dialogue: 0,0:10:09.54,0:10:10.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:11.04,0:10:12.75,Default,,0,0,0,,Бұл негізгі блоктың өте құпия бұйрығы.
Dialogue: 0,0:10:12.88,0:10:17.09,Default,,0,0,0,,Маған байланысқа кедергі келтірмеу үшін ауызша сөйлесу керектігі айтылды.
Dialogue: 0,0:10:18.30,0:10:19.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.18,0:10:24.22,Default,,0,0,0,,Мен сіздің қатысуыңызды қарызға аламын.
Dialogue: 0,0:10:27.89,0:10:29.85,Default,,0,0,0,,Мұны қалай қабылдауым керек?
Dialogue: 0,0:10:30.27,0:10:32.44,Default,,0,0,0,,Нөл пайда болса, жылжытыңыз.
Dialogue: 0,0:10:32.56,0:10:35.19,Default,,0,0,0,,Британияға оқ жаудырсақ та...
Dialogue: 0,0:10:35.32,0:10:37.49,Default,,0,0,0,,Сіз білмеймін деп ойлай аласыз ба?
Dialogue: 0,0:10:37.61,0:10:39.20,Default,,0,0,0,,Жаман мәміле емес.
Dialogue: 0,0:10:39.65,0:10:43.24,Default,,0,0,0,,Мен оның әскери қызметкер екенін естідім, бірақ саясатпен де айналысатын сияқты.
Dialogue: 0,0:10:44.16,0:10:46.91,Default,,0,0,0,,Лорд Киммел: Алдыңғы қатарлы шығарылған ұшақта проблемалар бар ма?
Dialogue: 0,0:10:47.75,0:10:51.04,Default,,0,0,0,,Мен оны қызыққандықтан пайдаланғандықтан, менде біртүрлі әдеттер болуы мүмкін.
Dialogue: 0,0:10:51.29,0:10:55.34,Default,,0,0,0,,Бұл маңызды ұшақ. Бірдеңе дұрыс болмаса, хабарлаңыз.
Dialogue: 0,0:10:55.46,0:10:56.50,Default,,0,0,0,,Бұл Киммель
Dialogue: 0,0:10:56.92,0:10:59.76,Default,,0,0,0,,Винсентте ештеңе жоқ. Сіз бара аласыз.
Dialogue: 0,0:11:01.01,0:11:04.85,Default,,0,0,0,,Лелуш Егер уәдеңді орындамасаң, мен сені өлтіремін.
Dialogue: 0,0:11:05.60,0:11:06.81,Default,,0,0,0,,Лорд Гилдфорд
Dialogue: 0,0:11:07.81,0:11:10.10,Default,,0,0,0,,Енді үкімді орындау уақыты келді.
Dialogue: 0,0:11:10.23,0:11:13.06,Default,,0,0,0,,Әділдік қара рыцарьлардың қалдықтарына жеткізіледі.
Dialogue: 0,0:11:13.44,0:11:14.40,Default,,0,0,0,,Нөл мырза
Dialogue: 0,0:11:14.52,0:11:15.57,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:11:15.69,0:11:16.78,Default,,0,0,0,,Маған бір керемет көрсетіңізші
Dialogue: 0,0:11:16.90,0:11:17.86,Default,,0,0,0,,Он бір
Dialogue: 0,0:11:17.98,0:11:18.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:19.32,0:11:22.16,Default,,0,0,0,,Сіз сенген нөл пайда болмады.
Dialogue: 0,0:11:22.28,0:11:23.62,Default,,0,0,0,,Мұның бәрі өтірік
Dialogue: 0,0:11:23.87,0:11:28.37,Default,,0,0,0,,Мен қалаған әділ ойыннан қашты.
Dialogue: 0,0:11:28.79,0:11:29.41,Default,,0,0,0,,Тұрыс
Dialogue: 0,0:11:34.88,0:11:35.84,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:11:36.04,0:11:36.71,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:36.84,0:11:39.76,Default,,0,0,0,,Қозғалмаңыз. Бұл жерден кетсеңіз, сізді де өлтіреді.
Dialogue: 0,0:11:39.88,0:11:41.17,Default,,0,0,0,,Мен білемін, бірақ
Dialogue: 0,0:11:41.38,0:11:44.84,Default,,0,0,0,,Жетер, біз жақсы жұмыс жасадық.
Dialogue: 0,0:11:44.97,0:11:45.60,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:45.72,0:11:46.81,Default,,0,0,0,,Ах (Гильфорд) Иә?
Dialogue: 0,0:11:46.93,0:11:48.39,Default,,0,0,0,,Сіз қателесесіз, Гилфорд.
Dialogue: 0,0:11:48.52,0:11:49.14,Default,,0,0,0,,Құт
Dialogue: 0,0:11:49.27,0:11:51.06,Default,,0,0,0,,Ол келді, бірақ
Dialogue: 0,0:11:51.43,0:11:55.19,Default,,0,0,0,,Біз де көмектесе алмаймыз. Біз жалғыз не істеуіміз керек?
Dialogue: 0,0:11:55.52,0:11:59.28,Default,,0,0,0,,Мен көремін. Сіз артқа кеттіңіз бе? Нөл
Dialogue: 0,0:12:02.90,0:12:03.95,Default,,0,0,0,,Гилдфорд.
Dialogue: 0,0:12:04.20,0:12:07.41,Default,,0,0,0,,Сіз өлтірмекші болған адам террорист емес.
Dialogue: 0,0:12:07.53,0:12:10.45,Default,,0,0,0,,Менің Америка Құрама Штаттарының армиясы, Қара рыцарь жауынгері.
Dialogue: 0,0:12:10.58,0:12:13.62,Default,,0,0,0,,Біз оларды халықаралық құқық бойынша соғыс тұтқыны деп тануымыз керек пе?
Dialogue: 0,0:12:13.75,0:12:14.75,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:12:15.08,0:12:18.00,Default,,0,0,0,,Бұл шықты, бірақ-
Dialogue: 0,0:12:18.13,0:12:20.51,Default,,0,0,0,,Маған берген уәдеңді бұзсаң, мен сені өлтіремін.
Dialogue: 0,0:12:20.63,0:12:24.72,Default,,0,0,0,,Нөл, Лелуш Ламперуж жоқ
Dialogue: 0,0:12:34.64,0:12:36.52,Default,,0,0,0,,Бұл нөл. Нөл пайда болды.
Dialogue: 0,0:12:37.06,0:12:38.57,Default,,0,0,0,,Не деген ақымақтық!
Dialogue: 0,0:12:38.90,0:12:39.73,Default,,0,0,0,,Нөл?
Dialogue: 0,0:12:39.86,0:12:40.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:40.98,0:12:42.15,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:12:42.28,0:12:44.53,Default,,0,0,0,,Бұл шешілді, солай ма? Нөл
Dialogue: 0,0:12:45.32,0:12:47.20,Default,,0,0,0,,Айтпақшы, өлім жазасына кесілгені туралы хабарландыру бар еді...
Dialogue: 0,0:12:47.32,0:12:48.78,Default,,0,0,0,,Қосымша есеп беру
Dialogue: 0,0:12:48.91,0:12:50.08,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:12:50.20,0:12:52.16,Default,,0,0,0,,Бір адам Нөл – бір адам
Dialogue: 0,0:12:52.29,0:12:54.58,Default,,0,0,0,,Қошмар кадрында болу дегеніміз...
Dialogue: 0,0:12:54.71,0:12:56.29,Default,,0,0,0,,Менің ойымша, мақсаты өзін тапсыру емес еді.
Dialogue: 0,0:12:56.42,0:12:58.33,Default,,0,0,0,,Бірақ мен жалғыз күресуге ниетім жоқ...
Dialogue: 0,0:12:58.46,0:13:00.46,Default,,0,0,0,,) Қараңызшы, мен айтқандай болды, солай ма?
Dialogue: 0,0:13:00.59,0:13:04.17,Default,,0,0,0,,Олай болса өткен жылы жоспарлағандай жүрейік.
Dialogue: 0,0:13:04.30,0:13:07.97,Default,,0,0,0,,Нөл осы шымшудан өте алса.
Dialogue: 0,0:13:08.09,0:13:10.39,Default,,0,0,0,,Фуфуфуфуфу Сакиоко
Dialogue: 0,0:13:10.60,0:13:14.43,Default,,0,0,0,,Болашаққа дайындықты бастауыңызды қалаймын.
Dialogue: 0,0:13:14.85,0:13:16.10,Default,,0,0,0,,Британдық армия жағында нөлдік...
Dialogue: 0,0:13:16.23,0:13:17.40,Default,,0,0,0,,Лелух ше?
Dialogue: 0,0:13:17.52,0:13:18.52,Default,,0,0,0,,Роло қоса берілген
Dialogue: 0,0:13:18.86,0:13:20.98,Default,,0,0,0,,30 минут бұрын Спираль театрында
Dialogue: 0,0:13:23.78,0:13:25.90,Default,,0,0,0,,Көптен бері көрмегелі, лорд Гилдфорд.
Dialogue: 0,0:13:26.03,0:13:28.11,Default,,0,0,0,,Ескі әңгімелер туралы не айтасыз?
Dialogue: 0,0:13:28.53,0:13:31.16,Default,,0,0,0,,Бұл тамаша шақыру, бірақ мен одан бас тартамын.
Dialogue: 0,0:13:31.28,0:13:34.79,Default,,0,0,0,,Мен өткен тағдырыма қорқынышты түспен жауап бергім келеді.
Dialogue: 0,0:13:35.29,0:13:37.75,Default,,0,0,0,,Егер сіз шықпасаңыз, Geass қолданбасын пайдалана алмайсыз.
Dialogue: 0,0:13:37.96,0:13:41.80,Default,,0,0,0,,Мм, бұл сізге тән, онда ережелерді шешейік.
Dialogue: 0,0:13:41.92,0:13:42.80,Default,,0,0,0,,Ережелер?
Dialogue: 0,0:13:42.92,0:13:47.76,Default,,0,0,0,,Бұл дуэль ережесі. Шешім бір-бірден болуы керек.
Dialogue: 0,0:13:48.13,0:13:50.93,Default,,0,0,0,,Жақсы, мен оған басқа ешкімнің қол тигізуіне жол бермеймін.
Dialogue: 0,0:13:51.35,0:13:52.56,Default,,0,0,0,,Бір ғана қару
Dialogue: 0,0:13:52.68,0:13:53.31,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:13:56.98,0:13:58.60,Default,,0,0,0,,Бұл менің қаруым
Dialogue: 0,0:13:58.73,0:14:01.65,Default,,0,0,0,,Онда мен сенен сол қалқанды қарызға беруіңді өтінемін.
Dialogue: 0,0:14:01.77,0:14:03.36,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:14:03.48,0:14:04.44,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:14:04.78,0:14:08.86,Default,,0,0,0,,Бұл тәртіпсіздікке қарсы қалқан, ол басынан.
Dialogue: 0,0:14:08.99,0:14:10.66,Default,,0,0,0,,Өз-өзіне қол жұмсау ниетіңіз бар ма?
Dialogue: 0,0:14:11.32,0:14:12.58,Default,,0,0,0,,Иә
Dialogue: 0,0:14:12.91,0:14:14.91,Default,,0,0,0,,Қандай көңілсіздік, нөл.
Dialogue: 0,0:14:15.12,0:14:16.16,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:14:16.29,0:14:20.63,Default,,0,0,0,,Паразиттердің бірі Ұлы Евнухты жоя алғаным үшін сізге қарыздармын.
Dialogue: 0,0:14:20.88,0:14:24.55,Default,,0,0,0,,Бірақ бұл тұрақты үйлесімділікке негізделген байланыс емес.
Dialogue: 0,0:14:25.00,0:14:26.42,Default,,0,0,0,,Егер нөл қабілетсіз болса...
Dialogue: 0,0:14:26.55,0:14:30.05,Default,,0,0,0,,Қара рыцарьлардың дипломатиялық құралға айналудан басқа амалы қалмайды.
Dialogue: 0,0:14:31.68,0:14:33.35,Default,,0,0,0,,Лорд Гилдфордқа сұрақ қояйық
Dialogue: 0,0:14:34.01,0:14:37.68,Default,,0,0,0,,Әділдікпен жеңбейтін зұлымдық болғанда не істейсің?
Dialogue: 0,0:14:38.94,0:14:41.56,Default,,0,0,0,,Жамандық жасасаң да зұлымдықты жеңесің бе?
Dialogue: 0,0:14:41.69,0:14:46.07,Default,,0,0,0,,Әлде сіз әділдікті берік ұстанып, зұлымдыққа көнуге дайынсыз ба?
Dialogue: 0,0:14:46.19,0:14:48.24,Default,,0,0,0,,Қандай жағдайда да жамандық қалады
Dialogue: 0,0:14:48.45,0:14:50.66,Default,,0,0,0,,Қайшылық Сөз ойыны ма?
Dialogue: 0,0:14:51.20,0:14:54.24,Default,,0,0,0,,Менің әділдігім ханшайымның астында.
Dialogue: 0,0:14:54.53,0:14:56.54,Default,,0,0,0,,Түсінемін, егер мен болсам...
Dialogue: 0,0:14:56.83,0:14:59.46,Default,,0,0,0,,Жамандық жасап, үлкен зұлымдықты жең
Dialogue: 0,0:14:59.58,0:15:01.54,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:15:01.71,0:15:03.00,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:15:05.30,0:15:06.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:08.05,0:15:09.63,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:15:09.80,0:15:10.97,Default,,0,0,0,,Жер сілкінісі?
Dialogue: 0,0:15:11.09,0:15:12.97,Default,,0,0,0,,Жоқ, бұл стратегия
Dialogue: 0,0:15:13.51,0:15:14.80,Default,,0,0,0,,Қара көтеріліс кезінде?
Dialogue: 0,0:15:16.56,0:15:21.31,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,0:15:21.52,0:15:22.85,Default,,0,0,0,,12 атқыштар дивизиясы
Dialogue: 0,0:15:23.10,0:15:25.61,Default,,0,0,0,,4-деңгейдегі басқару бөлмесіне барыңыз.
Dialogue: 0,0:15:25.73,0:15:26.77,Default,,0,0,0,,Нөлдің бағыныңқылары
Dialogue: 0,0:15:26.90,0:15:27.90,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:28.03,0:15:29.90,Default,,0,0,0,,Карен, шабуылды басқаруды қолға ал.
Dialogue: 0,0:15:30.03,0:15:32.78,Default,,0,0,0,,Иә, еркін жауынгерлік броньды атты әскер бөлімі келеді.
Dialogue: 0,0:15:33.16,0:15:35.49,Default,,0,0,0,,Оги-санды және басқаларды құтқару - басты міндет.
Dialogue: 0,0:15:36.37,0:15:38.45,Default,,0,0,0,,Альфа 4 Альфа 1 Жауап беріңізші
Dialogue: 0,0:15:38.58,0:15:40.83,Default,,0,0,0,,Альфа 1 Альфа 1 Боқ, бұл кім...
Dialogue: 0,0:15:43.67,0:15:44.50,Default,,0,0,0,,Хикюнна
Dialogue: 0,0:15:48.17,0:15:49.51,Default,,0,0,0,,Бірден-бірге деген не?
Dialogue: 0,0:15:53.09,0:15:55.09,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:15:56.01,0:15:56.85,Default,,0,0,0,,Барт
Dialogue: 0,0:15:59.14,0:16:00.06,Default,,0,0,0,,Қара рыцарьлар
Dialogue: 0,0:16:00.52,0:16:02.31,Default,,0,0,0,,Жау біздің территорияға түсті.
Dialogue: 0,0:16:02.44,0:16:05.44,Default,,0,0,0,,Британдық әскерді жойып, отандастарыңызды құтқарыңыз.
Dialogue: 0,0:16:05.56,0:16:06.94,Default,,0,0,0,,Жерлестер?
Dialogue: 0,0:16:07.40,0:16:09.94,Default,,0,0,0,,Сіз концессия құрылымын пайдаландыңыз ба?
Dialogue: 0,0:16:10.11,0:16:12.61,Default,,0,0,0,,Британия дайындалмай тұрып, асығыңыз...
Dialogue: 0,0:16:12.74,0:16:14.03,Default,,0,0,0,,Барлығын босатыңыз.
Dialogue: 0,0:16:14.28,0:16:17.20,Default,,0,0,0,,Қытай Федерациясына қашып кеткен
Dialogue: 0,0:16:17.83,0:16:20.45,Default,,0,0,0,,Біздің мақсатымыз C.C.
Dialogue: 0,0:16:20.58,0:16:22.79,Default,,0,0,0,,Мұны Гилфордқа қалдырыңыз.
Dialogue: 0,0:16:23.12,0:16:24.12,Default,,0,0,0,,Террористер
Dialogue: 0,0:16:27.75,0:16:31.76,Default,,0,0,0,,Британия Бұл қазірдің өзінде Жапония территориясы.
Dialogue: 0,0:16:31.88,0:16:33.30,Default,,0,0,0,,Жапония деген ел жоқ
Dialogue: 0,0:16:33.63,0:16:36.93,Default,,0,0,0,,О, сондықтан Британия
Dialogue: 0,0:16:38.93,0:16:41.27,Default,,0,0,0,,Қоштасу Он бір Эйс
Dialogue: 0,0:16:45.44,0:16:48.11,Default,,0,0,0,,Алдын алды ма? Бұл қашықтықта, уф
Dialogue: 0,0:16:48.40,0:16:49.90,Default,,0,0,0,,Бұл сәулелі толқын
Dialogue: 0,0:16:50.02,0:16:53.40,Default,,0,0,0,,Қалтамға түскенде жеңісім шешілді.
Dialogue: 0,0:16:53.86,0:16:54.78,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:16:57.28,0:16:59.66,Default,,0,0,0,,Ууууу аааа
Dialogue: 0,0:17:02.25,0:17:03.71,Default,,0,0,0,,Жарайсың Альфред
Dialogue: 0,0:17:03.83,0:17:06.79,Default,,0,0,0,,Атпа. Бұл Қытай Федерациясының экстерриториялық аймағы.
Dialogue: 0,0:17:06.92,0:17:07.63,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:17:07.75,0:17:09.04,Default,,0,0,0,,Ішінде жаңалықтар камерасы да бар.
Dialogue: 0,0:17:09.17,0:17:10.30,Default,,0,0,0,,Құт
Dialogue: 0,0:17:10.42,0:17:11.38,Default,,0,0,0,,Ви Винсент
Dialogue: 0,0:17:11.50,0:17:12.13,Default,,0,0,0,,Уф
Dialogue: 0,0:17:12.30,0:17:14.59,Default,,0,0,0,,Винсент ішке кірді.
Dialogue: 0,0:17:15.43,0:17:16.30,Default,,0,0,0,,Ішек
Dialogue: 0,0:17:16.43,0:17:20.10,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:17:26.56,0:17:28.19,Default,,0,0,0,,Мен қозғала алмаймын, қашамын.
Dialogue: 0,0:17:30.19,0:17:33.40,Default,,0,0,0,,Келдің бе? Келдің бе? Лоло
Dialogue: 0,0:17:36.86,0:17:40.95,Default,,0,0,0,,Ол қашып барады емес пе? С.С. беруге уәде берді.
Dialogue: 0,0:17:41.08,0:17:43.83,Default,,0,0,0,,Лелуш маған басынан бастап өтірік айтты
Dialogue: 0,0:17:46.33,0:17:48.50,Default,,0,0,0,,Олардың әлі ұсталуы мүмкін емес.
Dialogue: 0,0:17:48.92,0:17:51.04,Default,,0,0,0,,Маған болашақ сыйлаймын десең де
Dialogue: 0,0:17:51.34,0:17:52.96,Default,,0,0,0,,Мен бұл жерде өле алмаймын
Dialogue: 0,0:17:53.55,0:17:56.38,Default,,0,0,0,,Міндетіңді орындасаң, болашақ байланыста болады.
Dialogue: 0,0:17:57.22,0:17:58.09,Default,,0,0,0,,Га
Dialogue: 0,0:18:01.55,0:18:02.97,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:18:03.60,0:18:08.06,Default,,0,0,0,,Физикалық құбылыстарды тоқтату мүмкін емес. Ха, бұл тікелей соққы курсы.
Dialogue: 0,0:18:08.56,0:18:09.94,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:18:13.07,0:18:14.23,Default,,0,0,0,,Га
Dialogue: 0,0:18:15.53,0:18:16.57,Default,,0,0,0,,Тоқта, Дэвид.
Dialogue: 0,0:18:16.69,0:18:19.74,Default,,0,0,0,,Консулдыққа соқса, Қытай Федерациясымен соғыс болады.
Dialogue: 0,0:18:19.86,0:18:20.95,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:18:21.95,0:18:23.33,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:26.75,0:18:28.96,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:18:29.08,0:18:31.17,Default,,0,0,0,,Өйткені сен менің ағамсың
Dialogue: 0,0:18:31.29,0:18:32.38,Default,,0,0,0,,Га
Dialogue: 0,0:18:32.59,0:18:34.96,Default,,0,0,0,,Отырғызылған естелік болса да...
Dialogue: 0,0:18:35.09,0:18:37.72,Default,,0,0,0,,Мен сенімен өткізген уақытымда өтірік болмады.
Dialogue: 0,0:18:37.97,0:18:38.88,Default,,0,0,0,,Га
Dialogue: 0,0:18:39.51,0:18:42.30,Default,,0,0,0,,Осы уақытқа дейін бәрі өтірік емес еді
Dialogue: 0,0:18:43.14,0:18:45.56,Default,,0,0,0,,Өйткені сен менің ағамсың
Dialogue: 0,0:18:45.68,0:18:49.23,Default,,0,0,0,,Інісі? I
Dialogue: 0,0:18:50.27,0:18:53.94,Default,,0,0,0,,Сол күні бірінші рет туған күнім болмады.
Dialogue: 0,0:18:54.11,0:18:55.44,Default,,0,0,0,,Бұл да
Dialogue: 0,0:18:55.57,0:18:58.78,Default,,0,0,0,,Өмірің маңызды десең де...
Dialogue: 0,0:18:59.36,0:19:01.16,Default,,0,0,0,,Осындай ақымақ себеппен
Dialogue: 0,0:19:01.28,0:19:05.03,Default,,0,0,0,,Өйткені мен саған уәде бердім, сенің жаңа болашағың.
Dialogue: 0,0:19:05.28,0:19:06.12,Default,,0,0,0,,Га
Dialogue: 0,0:19:06.24,0:19:09.33,Default,,0,0,0,,Сенің болашағың менімен
Dialogue: 0,0:19:10.29,0:19:12.33,Default,,0,0,0,,Нөл Қатынасты осы жерден аяқтаймыз.
Dialogue: 0,0:19:12.67,0:19:14.00,Default,,0,0,0,,Менің соққыммен
Dialogue: 0,0:19:16.17,0:19:17.34,Default,,0,0,0,,Осы үтікпен
Dialogue: 0,0:19:18.97,0:19:19.59,Default,,0,0,0,,Уф
Dialogue: 0,0:19:24.43,0:19:26.56,Default,,0,0,0,,Не? Сіз не айтасыз, лорд Киммел?
Dialogue: 0,0:19:26.76,0:19:28.18,Default,,0,0,0,,А, жоқ, бұл
Dialogue: 0,0:19:28.47,0:19:30.44,Default,,0,0,0,,Сіз Zero мүшесісіз бе?
Dialogue: 0,0:19:30.56,0:19:33.86,Default,,0,0,0,,Жоқ. Лелуш өлген кезде менің миссиям бар.
Dialogue: 0,0:19:33.98,0:19:36.57,Default,,0,0,0,,Жоқ, бірақ мен не істеп жатырмын?
Dialogue: 0,0:19:36.57,0:19:36.86,Default,,0,0,0,,Жоқ, бірақ мен не істеп жатырмын?
Dialogue: 0,0:19:36.57,0:19:36.86,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:36.86,0:19:36.98,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:36.98,0:19:38.40,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:36.98,0:19:38.40,Default,,0,0,0,,Га
Dialogue: 0,0:19:38.40,0:19:40.40,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:41.45,0:19:42.28,Default,,0,0,0,,Иә
Dialogue: 0,0:19:42.41,0:19:44.12,Default,,0,0,0,,Лоло, бұл жаман. Бұл Виллетта мырзадан.
Dialogue: 0,0:19:44.24,0:19:44.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.07,0:19:46.03,Default,,0,0,0,,IM ашық арқылы қосылайық
Dialogue: 0,0:19:46.16,0:19:46.83,Default,,0,0,0,,Ах
Dialogue: 0,0:19:46.95,0:19:49.04,Default,,0,0,0,,Роло? Сен қайда болдың?
Dialogue: 0,0:19:49.70,0:19:50.33,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:19:50.71,0:19:54.38,Default,,0,0,0,,Жоқ, сэр, бізге бөлек дәретханалар болсын.
Dialogue: 0,0:19:55.00,0:19:57.34,Default,,0,0,0,,Сонда бұл не болды? бұрынғыдан
Dialogue: 0,0:19:57.46,0:19:59.30,Default,,0,0,0,,Бұл консулдық туралы.
Dialogue: 0,0:19:59.42,0:20:01.80,Default,,0,0,0,,Әй, әбігершілік көп сияқты.
Dialogue: 0,0:20:02.26,0:20:04.89,Default,,0,0,0,,Осы уақытқа дейін не болғанын білсе, олай етпе...
Dialogue: 0,0:20:05.01,0:20:08.10,Default,,0,0,0,,Тіпті жеке себептерге байланысты есептен шығарылған адам
Dialogue: 0,0:20:08.60,0:20:10.22,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:10.35,0:20:12.60,Default,,0,0,0,,Мен енді ағамды қауіпті ештеңеге араластырмаймын.
Dialogue: 0,0:20:12.73,0:20:13.44,Default,,0,0,0,,Га
Dialogue: 0,0:20:13.56,0:20:15.15,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:20:15.27,0:20:18.48,Default,,0,0,0,,Кісі өлтірушілер бар әлем Ролоға сәйкес келмейді.
Dialogue: 0,0:20:20.57,0:20:22.57,Default,,0,0,0,,Міне, Британдық мырзалар.
Dialogue: 0,0:20:22.70,0:20:23.65,Default,,0,0,0,,Уф
Dialogue: 0,0:20:23.78,0:20:25.70,Default,,0,0,0,,Кез келген әрі қарай әрекет қарулы араласу болып саналады.
Dialogue: 0,0:20:25.82,0:20:27.41,Default,,0,0,0,,Жоғары тартыңыз
Dialogue: 0,0:20:27.53,0:20:28.16,Default,,0,0,0,,Ішек
Dialogue: 0,0:20:31.33,0:20:32.91,Default,,0,0,0,,Эй
Dialogue: 0,0:20:33.04,0:20:36.29,Default,,0,0,0,,Жақсы Оги-сан (Тамаки) хахахахаха Оуги
Dialogue: 0,0:20:36.42,0:20:37.50,Default,,0,0,0,,Рахмет сізге Карен
Dialogue: 0,0:20:37.84,0:20:41.59,Default,,0,0,0,,Тодо-сан және басқалары да жақсы болды.
Dialogue: 0,0:20:41.71,0:20:44.09,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:44.22,0:20:45.38,Default,,0,0,0,,Бұл қиын болған болуы керек.
Dialogue: 0,0:20:45.51,0:20:47.51,Default,,0,0,0,,Хехехе, солай.
Dialogue: 0,0:20:47.64,0:20:50.18,Default,,0,0,0,,Әй, бұл түнгі түн ше?
Dialogue: 0,0:20:50.56,0:20:55.69,Default,,0,0,0,,Бұл ұшақ жау болды, бірақ мен қазір ұшқышпын.
Dialogue: 0,0:20:56.06,0:21:00.40,Default,,0,0,0,,Мен Нөлді қорғадым. Кем дегенде, ол жау емес.
Dialogue: 0,0:21:00.53,0:21:04.15,Default,,0,0,0,,Менде С.С.
Dialogue: 0,0:21:04.28,0:21:05.61,Default,,0,0,0,,Басынан -
Dialogue: 0,0:21:05.74,0:21:07.66,Default,,0,0,0,,Британияда тыныштық болмады.
Dialogue: 0,0:21:08.24,0:21:10.70,Default,,0,0,0,,Сіздің орныңыз осында.
Dialogue: 0,0:21:10.91,0:21:12.41,Default,,0,0,0,,Уау
Dialogue: 0,0:21:13.00,0:21:14.79,Default,,0,0,0,,Хмф, құлады.
Dialogue: 0,0:21:15.33,0:21:18.29,Default,,0,0,0,,Мен мұндай материалды команда бөлмесіне қалдырамын.
Dialogue: 0,0:21:18.42,0:21:20.96,Default,,0,0,0,,Менің ойымша, Геасс оны алудың жалғыз жолы.
Dialogue: 0,0:21:21.09,0:21:23.21,Default,,0,0,0,,Мен бұл жігіттің құпия сөзі пайдалы екеніне сене алмаймын.
Dialogue: 0,0:21:23.63,0:21:24.34,Default,,0,0,0,,Және...
Dialogue: 0,0:21:25.55,0:21:26.51,Default,,0,0,0,,Үлгі дельтасы?
Dialogue: 0,0:21:26.88,0:21:27.84,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:27.97,0:21:30.30,Default,,0,0,0,,Нөлдің ұшағы орбитаға шыққанда...
Dialogue: 0,0:21:30.43,0:21:32.68,Default,,0,0,0,,Қуып келе жатқан түнгі түнді арт жағынан атыңыз.
Dialogue: 0,0:21:32.81,0:21:34.89,Default,,0,0,0,,Кейінірек, Нөл қашып кеткенде...
Dialogue: 0,0:21:35.02,0:21:37.48,Default,,0,0,0,,Қарсыласыңыздың Nightmare ойынын толығымен жойыңыз.
Dialogue: 0,0:21:37.60,0:21:40.31,Default,,0,0,0,,Егер қашпасаңыз, сол жерде күтіңіз.
Dialogue: 0,0:21:40.65,0:21:42.98,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:21:43.82,0:21:45.82,Default,,0,0,0,,Фуфуфухахахаха
Dialogue: 0,0:21:45.95,0:21:49.82,Default,,0,0,0,,Сен Нанналлидің орнын тартып алған жалғансың.
Dialogue: 0,0:21:49.95,0:21:54.41,Default,,0,0,0,,Мен оны көп пайдаланамын, шүберектей лақтырып тастаймын.
Dialogue: 0,0:21:54.79,0:21:58.79,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:03.38,0:22:07.97,Default,,0,0,0,,♪Мен оны бір күні кеудемнен таптым
Dialogue: 0,0:22:08.09,0:22:14.68,Default,,0,0,0,,♪Бақыт бөліктерін жинап алайық
Dialogue: 0,0:22:14.81,0:22:19.69,Default,,0,0,0,,♪Ұмытып қала жаздаған әуен
Dialogue: 0,0:22:19.81,0:22:26.78,Default,,0,0,0,,♪Ортада сөнбестен
Dialogue: 0,0:22:29.99,0:22:34.62,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:34.74,0:22:39.92,Default,,0,0,0,,♪Бүгін осында болғаным барлығына рахмет
Dialogue: 0,0:22:40.04,0:22:44.59,Default,,0,0,0,,♪Шын жүректен рахмет
Dialogue: 0,0:22:44.71,0:22:47.42,Default,,0,0,0,,♪Келесі мен бәріне айтамын
Dialogue: 0,0:22:47.55,0:22:50.89,Default,,0,0,0,,♪БАҚЫТТЫ Мен саған Уау беремін
Dialogue: 0,0:22:51.01,0:22:56.02,Default,,0,0,0,,♪Мен ештеңені ұмытпаймын
Dialogue: 0,0:22:56.14,0:23:02.61,Default,,0,0,0,,♪Себебі мен де сол күні менмін
Dialogue: 0,0:23:02.73,0:23:07.69,Default,,0,0,0,,♪Мен әрқашан сені сүйемін деп айтамын
Dialogue: 0,0:23:07.82,0:23:11.82,Default,,0,0,0,,♪Сіз маған айтуыңыз керек.
Dialogue: 0,0:23:11.95,0:23:16.20,Default,,0,0,0,,♪ Көз жасы ағып кете жаздады
Dialogue: 0,0:23:16.33,0:23:22.88,Default,,0,0,0,,♪Ұзақ түнде кенет артыма қарадым
Dialogue: 0,0:23:23.00,0:23:27.00,Default,,0,0,0,,♪Адамның ізімен жүру
Dialogue: 0,0:23:27.13,0:23:34.10,Default,,0,0,0,,♪Сол күнді ұмытпа
Dialogue: 0,0:23:37.81,0:23:39.56,Default,,0,0,0,,Лоло Ламперуж дегеніміз не?
Dialogue: 0,0:23:39.68,0:23:41.69,Default,,0,0,0,,Мен ол жігітті інім деп ойлағаныма сене алар емеспін...
Dialogue: 0,0:23:41.81,0:23:43.85,Default,,0,0,0,,Мені селт еткізетін қорлық.
Dialogue: 0,0:23:44.11,0:23:47.15,Default,,0,0,0,,Хмм, бірақ пайдалы пешкаға айналсаң.
Dialogue: 0,0:23:47.27,0:23:48.61,Default,,0,0,0,,Бірақ ұмытпаңыз
Dialogue: 0,0:23:48.73,0:23:51.20,Default,,0,0,0,,Сен жай ғана алаяқсың, Нуналли.
Dialogue: 0,0:23:52.70,0:23:58.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory