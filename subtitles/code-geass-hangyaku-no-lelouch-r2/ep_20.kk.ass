Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.85,0:00:05.48,Default,,0,0,0,,Императорлық күнтізбе 2010 ж
Dialogue: 0,0:00:05.60,0:00:08.77,Default,,0,0,0,,Жапонияның Сакурадит жер асты байлығын өңдеуі
Dialogue: 0,0:00:08.90,0:00:12.28,Default,,0,0,0,,Қасиетті Британ империясымен соғыс жағдайына кірді.
Dialogue: 0,0:00:14.32,0:00:17.62,Default,,0,0,0,,Толық қарсылықты жақтаған әкем Генбуға қарсы...
Dialogue: 0,0:00:17.74,0:00:18.74,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:00:19.91,0:00:23.83,Default,,0,0,0,,Жас Тым жас импульсивті мінез-құлық
Dialogue: 0,0:00:23.96,0:00:27.79,Default,,0,0,0,,Бірақ мен бұл соғыстың аяқталуы деп ойладым.
Dialogue: 0,0:00:27.96,0:00:31.00,Default,,0,0,0,,Енді босқа қан төгілмейді.
Dialogue: 0,0:00:31.88,0:00:35.13,Default,,0,0,0,,Бірақ шайқас біткен жоқ.
Dialogue: 0,0:00:38.05,0:00:39.30,Default,,0,0,0,,Мен жай ғана-
Dialogue: 0,0:00:39.47,0:00:41.76,Default,,0,0,0,,Адамдардың басқа адамдардан бас тартуы...
Dialogue: 0,0:00:41.93,0:00:43.60,Default,,0,0,0,,Мен оны тоқтатқым келді
Dialogue: 0,0:00:46.98,0:00:47.81,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:47.94,0:00:49.02,Default,,0,0,0,,Бұл басқаша
Dialogue: 0,0:00:49.15,0:00:50.02,Default,,0,0,0,,Геасс
Dialogue: 0,0:00:50.15,0:00:52.19,Default,,0,0,0,,Адамдардың еркін бұрмалау күші
Dialogue: 0,0:00:54.53,0:00:57.24,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:00:57.57,0:00:58.78,Default,,0,0,0,,Мен
Dialogue: 0,0:01:00.62,0:01:03.49,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:03.87,0:01:06.50,Default,,0,0,0,,Мен мұның соншалықты нашар болатынына сене алар емеспін.
Dialogue: 0,0:01:06.62,0:01:08.92,Default,,0,0,0,,Мен сондаймын
Dialogue: 0,0:01:09.04,0:01:09.88,Default,,0,0,0,,Соншалықты
Dialogue: 0,0:01:10.46,0:01:11.09,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:01:11.21,0:01:12.50,Default,,0,0,0,,Га
Dialogue: 0,0:01:12.63,0:01:14.46,Default,,0,0,0,,Үлкен жетістік Нина
Dialogue: 0,0:01:14.59,0:01:17.05,Default,,0,0,0,,Фрейджаның оқтұмсық күші орасан зор.
Dialogue: 0,0:01:17.22,0:01:19.26,Default,,0,0,0,,Нәтижесінде менің Британиям...
Dialogue: 0,0:01:19.39,0:01:21.35,Default,,0,0,0,,Жеңіс әкеледі
Dialogue: 0,0:01:24.35,0:01:28.89,Default,,0,0,0,,♪Ақырзаманда туған нұр
Dialogue: 0,0:01:29.02,0:01:34.57,Default,,0,0,0,,♪Қазір желде
Dialogue: 0,0:01:50.46,0:01:55.42,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:01:55.80,0:02:01.14,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:02:01.26,0:02:03.97,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:02:04.10,0:02:06.22,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:02:06.68,0:02:09.31,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:02:09.44,0:02:12.56,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:02:12.69,0:02:17.57,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:02:18.40,0:02:21.03,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:02:21.16,0:02:27.58,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:02:29.21,0:02:33.67,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:02:33.79,0:02:38.34,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:02:39.22,0:02:44.85,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:02:58.53,0:03:00.69,Default,,0,0,0,,11-аймаққа келген кезде
Dialogue: 0,0:03:00.82,0:03:03.24,Default,,0,0,0,,Император Токио концессиясында көрінбеді.
Dialogue: 0,0:03:03.86,0:03:07.08,Default,,0,0,0,,Басқаша айтқанда, оның мақсаты басқа.
Dialogue: 0,0:03:07.20,0:03:08.99,Default,,0,0,0,,Бағыт бойынша Шикинедзима
Dialogue: 0,0:03:09.12,0:03:10.08,Default,,0,0,0,,Жоқ-
Dialogue: 0,0:03:10.20,0:03:11.54,Default,,0,0,0,,Каминеджима қирандылары?
Dialogue: 0,0:03:13.62,0:03:14.83,Default,,0,0,0,,Бас діни қызметкер В.В.
Dialogue: 0,0:03:14.96,0:03:17.42,Default,,0,0,0,,Жолдастарымыздың қалдырған құжаттары бойынша...
Dialogue: 0,0:03:17.55,0:03:19.34,Default,,0,0,0,,Бұл нүкте ең жақсы
Dialogue: 0,0:03:19.46,0:03:22.38,Default,,0,0,0,,Дүние жүзіне шашылған қирандылар да синхрондалады.
Dialogue: 0,0:03:22.51,0:03:24.26,Default,,0,0,0,,Енді Акашаның қылышы...
Dialogue: 0,0:03:24.39,0:03:26.47,Default,,0,0,0,,Қайта қолжетімді болады
Dialogue: 0,0:03:26.60,0:03:32.35,Default,,0,0,0,,Я, мен мұндай көне құрылғыны қолданамын деп ойламаппын.
Dialogue: 0,0:03:33.69,0:03:37.77,Default,,0,0,0,,Ух ха ха ха ха ха ха ха
Dialogue: 0,0:03:40.11,0:03:42.61,Default,,0,0,0,,Иә, сіз бастауды жоспарлап отырсыз... Ах.
Dialogue: 0,0:03:42.61,0:03:43.82,Default,,0,0,0,,Иә, сіз бастауды жоспарлап отырсыз... Ах.
Dialogue: 0,0:03:42.61,0:03:43.82,Default,,0,0,0,,(байланыс дыбысы)
Dialogue: 0,0:03:43.95,0:03:45.82,Default,,0,0,0,,Сағымның қазіргі орны қандай?
Dialogue: 0,0:03:45.95,0:03:47.03,Default,,0,0,0,,Бұл әлі де солай
Dialogue: 0,0:03:47.91,0:03:50.12,Default,,0,0,0,,Британияның ынтымақтастығы да алынған.
Dialogue: 0,0:03:50.24,0:03:53.62,Default,,0,0,0,,Бекітілгеннен кейін барлық күштеріңізді көтеріп, миражды жойыңыз.
Dialogue: 0,0:03:53.75,0:03:54.96,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:55.08,0:03:56.25,Default,,0,0,0,,) Сіздің күйеуіңіз...
Dialogue: 0,0:03:56.25,0:03:57.25,Default,,0,0,0,,) Сіздің күйеуіңіз...
Dialogue: 0,0:03:56.25,0:03:57.25,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:04:00.71,0:04:04.55,Default,,0,0,0,,Бетпе-бет кездескенімізге біраз болды! Мен, мен!
Dialogue: 0,0:04:04.68,0:04:06.01,Default,,0,0,0,,Иә? (Аня) Иә?
Dialogue: 0,0:04:06.14,0:04:08.30,Default,,0,0,0,,C.C.Олай емес
Dialogue: 0,0:04:08.43,0:04:10.18,Default,,0,0,0,,Ха, кешіріңіз.
Dialogue: 0,0:04:28.78,0:04:30.12,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:30.24,0:04:32.33,Default,,0,0,0,,Тағы да осындай жерге қамалды
Dialogue: 0,0:04:33.33,0:04:34.79,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:04:34.91,0:04:35.71,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:04:35.83,0:04:37.67,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:04:37.88,0:04:39.38,Default,,0,0,0,,Мен едім!
Dialogue: 0,0:04:39.50,0:04:40.13,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:40.34,0:04:41.88,Default,,0,0,0,,Сіз
Dialogue: 0,0:04:42.05,0:04:44.01,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:04:44.13,0:04:45.84,Default,,0,0,0,,Сіз Лелуш үшін алаңдайсыз ба?
Dialogue: 0,0:04:45.97,0:04:46.97,Default,,0,0,0,,Марианна
Dialogue: 0,0:04:47.09,0:04:48.14,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:48.26,0:04:51.56,Default,,0,0,0,,Сіз шынымен мені ананың идеалы деп ойладыңыз ба?
Dialogue: 0,0:04:51.68,0:04:53.60,Default,,0,0,0,,Олай болса, біз мұнда не үшін келдік?
Dialogue: 0,0:04:53.72,0:04:57.31,Default,,0,0,0,,Сіздің әлі де біз жақта екеніңізді білгіміз келеді.
Dialogue: 0,0:04:57.60,0:04:58.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.60,0:04:59.69,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:04:59.81,0:05:02.40,Default,,0,0,0,,Неліктен сіз өзіңіздің кодыңызды пломбаладыңыз?
Dialogue: 0,0:05:02.90,0:05:04.86,Default,,0,0,0,,Чарльз, сіздің тілегіңіз...
Dialogue: 0,0:05:04.99,0:05:07.82,Default,,0,0,0,,Менің өлсем деген тілегімді орындадың.
Dialogue: 0,0:05:07.95,0:05:10.16,Default,,0,0,0,,Мен мұны өзім түсінбеймін.
Dialogue: 0,0:05:10.28,0:05:11.53,Default,,0,0,0,,Мен біраз таң қалдым.
Dialogue: 0,0:05:11.66,0:05:13.37,Default,,0,0,0,,Шынымен бе…
Dialogue: 0,0:05:13.49,0:05:15.91,Default,,0,0,0,,Онда мен оны шын мәнінде тексеруім керек.
Dialogue: 0,0:05:16.04,0:05:16.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:17.21,0:05:19.71,Default,,0,0,0,,Мен оны шештім, сондықтан бұл шешім.
Dialogue: 0,0:05:19.83,0:05:21.21,Default,,0,0,0,,Сіз туралы.
Dialogue: 0,0:05:21.34,0:05:22.13,Default,,0,0,0,,Не?
Dialogue: 0,0:05:22.25,0:05:25.46,Default,,0,0,0,,Мені үнемі қоздыруға тырысатын адам
Dialogue: 0,0:05:25.59,0:05:27.93,Default,,0,0,0,,О, мен ризамын.
Dialogue: 0,0:05:28.34,0:05:31.01,Default,,0,0,0,,Маған Геассты сыйлағаны үшін
Dialogue: 0,0:05:31.14,0:05:33.01,Default,,0,0,0,,Шарттың бұзылуына қарамастан
Dialogue: 0,0:05:33.14,0:05:35.47,Default,,0,0,0,,Олай десеңіз, бірге барайық.
Dialogue: 0,0:05:35.68,0:05:38.64,Default,,0,0,0,,Күте тұрыңыз, тым болмаса соншалықты.
Dialogue: 0,0:05:38.77,0:05:39.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.15,0:05:43.15,Default,,0,0,0,,Мен Аняны осы Икаругада қалдырамын.
Dialogue: 0,0:05:43.27,0:05:44.11,Default,,0,0,0,,Уф
Dialogue: 0,0:05:44.23,0:05:47.28,Default,,0,0,0,,Өйткені бізге Нөлді қамқорлыққа алатын біреу керек.
Dialogue: 0,0:05:47.40,0:05:49.91,Default,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:05:50.03,0:05:51.45,Default,,0,0,0,,Сіз Қара Рыцарларда қаласыз ба?
Dialogue: 0,0:05:51.57,0:05:52.62,Default,,0,0,0,,Уф
Dialogue: 0,0:05:52.74,0:05:56.00,Default,,0,0,0,,Бұл жерде менің ағам да, мен де сені жазалаймыз деген ниетіміз жоқ.
Dialogue: 0,0:05:56.12,0:05:59.71,Default,,0,0,0,,Жоқ, себебі жағдай келесі кезеңге өтті -
Dialogue: 0,0:05:59.83,0:06:02.04,Default,,0,0,0,,Менің ойымша, мен оны енді көтере алмадым деп айтуым керек.
Dialogue: 0,0:06:02.17,0:06:04.25,Default,,0,0,0,,Дұрыс, мен.
Dialogue: 0,0:06:04.38,0:06:06.88,Default,,0,0,0,,Хе, соны айтып тұрмын...
Dialogue: 0,0:06:07.01,0:06:09.47,Default,,0,0,0,,Дүние тек атақтардан тұрмайды.
Dialogue: 0,0:06:09.59,0:06:10.72,Default,,0,0,0,,Ах
Dialogue: 0,0:06:11.34,0:06:12.72,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:06:12.85,0:06:14.68,Default,,0,0,0,,Нөлдің өлімін іс-әрекетте жария етейік.
Dialogue: 0,0:06:14.89,0:06:17.39,Default,,0,0,0,,) Лелуш әлі табылмаса да.
Dialogue: 0,0:06:17.52,0:06:19.60,Default,,0,0,0,,Сіз мұны орындалуға тырысасыз ба?
Dialogue: 0,0:06:20.10,0:06:21.31,Default,,0,0,0,,Міне...
Dialogue: 0,0:06:21.44,0:06:24.73,Default,,0,0,0,,Мен Нөлдің маған опасыздық жасағанын білдім, бірақ...
Dialogue: 0,0:06:24.86,0:06:26.69,Default,,0,0,0,,Сіз Geass туралы да хабарлауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:26.82,0:06:30.49,Default,,0,0,0,,Олар бізді жынды деп ойлап, қуып жібереді.
Dialogue: 0,0:06:30.61,0:06:31.41,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:31.70,0:06:33.49,Default,,0,0,0,,Егер нақты нөл пайда болса ше?
Dialogue: 0,0:06:33.62,0:06:36.16,Default,,0,0,0,,Оның шын екенін қалай дәлелдейсіз?
Dialogue: 0,0:06:36.29,0:06:37.12,Default,,0,0,0,,Ах
Dialogue: 0,0:06:37.75,0:06:40.41,Default,,0,0,0,,Бетперде киген батырлар, т.б. Рәміздер
Dialogue: 0,0:06:40.54,0:06:42.79,Default,,0,0,0,,Оны мойындайтын ешкім болмаса, ол жұмыс істемейді.
Dialogue: 0,0:06:44.46,0:06:45.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:45.79,0:06:47.96,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:06:48.09,0:06:51.34,Default,,0,0,0,,Әй, ұялы телефоным қосылды...
Dialogue: 0,0:06:51.47,0:06:53.39,Default,,0,0,0,,Мен барлығының қауіпсіз екенін білемін.
Dialogue: 0,0:06:53.51,0:06:54.72,Default,,0,0,0,,Менің ағам – ескі мектептің адамы – алдау мен айла-шарғы арқылы жеңетіндерден—
Dialogue: 0,0:06:54.85,0:06:57.10,Default,,0,0,0,,Сіздің бөлмеңіз жоқ, бірақ...
Dialogue: 0,0:06:57.22,0:06:58.77,Default,,0,0,0,,Клуб үйі бос.
Dialogue: 0,0:06:58.89,0:07:00.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:00.18,0:07:01.60,Default,,0,0,0,,Студенттік кеңес бөлмесі қауіпсіз ме?
Dialogue: 0,0:07:01.73,0:07:04.27,Default,,0,0,0,,Иә, айтпақшы, Роло ше?
Dialogue: 0,0:07:04.40,0:07:05.27,Default,,0,0,0,,Олар бірдей, солай ма?
Dialogue: 0,0:07:05.40,0:07:07.32,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:07:08.53,0:07:09.36,Default,,0,0,0,,Қарсылас
Dialogue: 0,0:07:10.11,0:07:12.07,Default,,0,0,0,,Төрағаға айта аласыз ба?
Dialogue: 0,0:07:12.20,0:07:15.49,Default,,0,0,0,,Мен бірге отшашуды жасаймын деген уәдемді орындай алмаймын деп ойлаймын.
Dialogue: 0,0:07:15.74,0:07:16.28,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:07:16.28,0:07:18.04,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:07:16.28,0:07:18.04,Default,,0,0,0,,А... ол не деді?
Dialogue: 0,0:07:18.04,0:07:18.87,Default,,0,0,0,,А... ол не деді?
Dialogue: 0,0:07:18.99,0:07:21.12,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:07:21.83,0:07:24.12,Default,,0,0,0,,Қарсылас, кешіріңіз.
Dialogue: 0,0:07:24.92,0:07:27.67,Default,,0,0,0,,Карен С.С.-ға қамқорлық жасаңыз.
Dialogue: 0,0:07:27.80,0:07:30.42,Default,,0,0,0,,Мен қателессем де, мен ол адамды жеңемін.
Dialogue: 0,0:07:31.26,0:07:32.47,Default,,0,0,0,,Өлмейтіндік-
Dialogue: 0,0:07:32.59,0:07:35.64,Default,,0,0,0,,Геасс та жұмыс істемейді, сондықтан мен ол адамды жеңемін деп бәс тігемін.
Dialogue: 0,0:07:35.76,0:07:38.47,Default,,0,0,0,,Менде қалғаны осы
Dialogue: 0,0:07:38.60,0:07:41.31,Default,,0,0,0,,Мәртебелі, синхронизацияға дайындық аяқталды.
Dialogue: 0,0:07:41.43,0:07:43.06,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:07:46.98,0:07:48.19,Default,,0,0,0,,Дірілдеп тұрған жоқ па?
Dialogue: 0,0:07:48.32,0:07:49.65,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:07:50.69,0:07:51.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:54.32,0:07:55.49,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:07:55.61,0:07:56.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.66,0:08:04.58,Default,,0,0,0,,(Пингвин дыбысы)
Dialogue: 0,0:08:06.17,0:08:09.25,Default,,0,0,0,,Әрбір бұзылған жүйені синхрондау аяқталды.
Dialogue: 0,0:08:09.38,0:08:12.67,Default,,0,0,0,,Бұл Құдайдың бар әлемінің соңы.
Dialogue: 0,0:08:12.84,0:08:14.76,Default,,0,0,0,,Жою және құру
Dialogue: 0,0:08:15.13,0:08:17.30,Default,,0,0,0,,Рагнарек басталады
Dialogue: 0,0:08:17.80,0:08:20.97,Default,,0,0,0,,Мәртебелі, мен Токио концессиясының мәртебелі Шнайзелінен хабарлама алдым.
Dialogue: 0,0:08:21.10,0:08:24.56,Default,,0,0,0,,Мен сізге қалдырамын дедім деп ойладым, т.б.
Dialogue: 0,0:08:24.69,0:08:25.60,Default,,0,0,0,,Дүние?
Dialogue: 0,0:08:26.27,0:08:29.77,Default,,0,0,0,,Шнайзел, байқадың ба?
Dialogue: 0,0:08:29.90,0:08:31.03,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,0:08:31.15,0:08:35.15,Default,,0,0,0,,Соғыс деп аталатын ойын аяқталды.
Dialogue: 0,0:08:37.91,0:08:39.99,Default,,0,0,0,,Бұл KT теледидары.
Dialogue: 0,0:08:40.12,0:08:41.87,Default,,0,0,0,,Студия кеткендіктен...
Dialogue: 0,0:08:42.16,0:08:44.54,Default,,0,0,0,,Эшфорд академиясының уақытша студиясынан.
Dialogue: 0,0:08:44.66,0:08:46.87,Default,,0,0,0,,Біз сізге шұғыл жаңалықтарды береміз.
Dialogue: 0,0:08:47.00,0:08:48.63,Default,,0,0,0,,Бұдан бұрын мәртебелі Шнайзел...
Dialogue: 0,0:08:48.75,0:08:51.55,Default,,0,0,0,,Қара рыцарлармен бітімге қол қойылды...
Dialogue: 0,0:08:51.67,0:08:53.05,Default,,0,0,0,,Ресми түрде жарияланды
Dialogue: 0,0:08:53.63,0:08:55.80,Default,,0,0,0,,Сондай-ақ, Қара рыцарлардан...
Dialogue: 0,0:08:55.92,0:08:59.34,Default,,0,0,0,,CEO Zero қайтыс болды.
Dialogue: 0,0:08:59.97,0:09:03.14,Default,,0,0,0,,Нөл Токио концессиясындағы шайқаста жарақат алды.
Dialogue: 0,0:09:03.27,0:09:05.73,Default,,0,0,0,,Мен флагмандық «Икаруга» кемесінде емделдім, бірақ...
Dialogue: 0,0:09:06.19,0:09:07.06,Default,,0,0,0,,Бүгін ерте -
Dialogue: 0,0:09:07.19,0:09:09.40,Default,,0,0,0,,Соңғы тынысын кеменің ішінде алды дейді.
Dialogue: 0,0:09:16.36,0:09:17.28,Default,,0,0,0,,Құрметті Нөл!
Dialogue: 0,0:09:17.40,0:09:18.24,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:18.36,0:09:19.28,Default,,0,0,0,,Біркөз…
Dialogue: 0,0:09:19.53,0:09:21.41,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:21.53,0:09:23.45,Default,,0,0,0,,Нөл өлді деген рас па?
Dialogue: 0,0:09:23.87,0:09:27.08,Default,,0,0,0,,Өкінішке орай, бұл ресми хабарландыруда айтылғандай.
Dialogue: 0,0:09:27.21,0:09:29.46,Default,,0,0,0,,Ең болмағанда сіздің бетіңіз.
Dialogue: 0,0:09:29.58,0:09:30.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:30.75,0:09:34.63,Default,,0,0,0,,Мен қазір бір нәрсемен айналысып жатырмын, бұл туралы кейінірек айтамын.
Dialogue: 0,0:09:34.96,0:09:36.26,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:36.38,0:09:39.05,Default,,0,0,0,,Қара рыцарларға енді нөл қажет емес.
Dialogue: 0,0:09:39.18,0:09:43.01,Default,,0,0,0,,Нөлдің арқасында осы уақытқа дейін жеттік.
Dialogue: 0,0:09:43.14,0:09:44.68,Default,,0,0,0,,Мұндай бір реттік зат
Dialogue: 0,0:09:45.14,0:09:47.89,Default,,0,0,0,,Нөл бәрін лақтырып жіберді.
Dialogue: 0,0:09:48.85,0:09:51.06,Default,,0,0,0,,Ол бәрін алдады.
Dialogue: 0,0:09:51.19,0:09:53.15,Default,,0,0,0,,Геас - жексұрын күш.
Dialogue: 0,0:09:53.27,0:09:56.28,Default,,0,0,0,,Мен де сені ең жақын досым деп ойладым.
Dialogue: 0,0:09:56.53,0:09:58.45,Default,,0,0,0,,Мен оны жақсы көрдім.
Dialogue: 0,0:09:58.57,0:09:59.57,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:59.70,0:10:02.45,Default,,0,0,0,,) Қара көтеріліс кезінде де...
Dialogue: 0,0:10:02.57,0:10:04.62,Default,,0,0,0,,Желдеткішті бір рет қолданылатын етіп жасауға әрекеттену
Dialogue: 0,0:10:04.74,0:10:07.08,Default,,0,0,0,,Жоқ, тіпті оған дейін.
Dialogue: 0,0:10:07.75,0:10:09.41,Default,,0,0,0,,Иә, адамдар...
Dialogue: 0,0:10:09.54,0:10:12.29,Default,,0,0,0,,Әр адам ойында пешка емес.
Dialogue: 0,0:10:12.42,0:10:14.04,Default,,0,0,0,,Мен тірімін.
Dialogue: 0,0:10:17.55,0:10:20.05,Default,,0,0,0,,Лелуш ви Британия командалары
Dialogue: 0,0:10:20.18,0:10:24.76,Default,,0,0,0,,Бұдан былай менің нұсқауларымды орындау керек.
Dialogue: 0,0:10:43.87,0:10:45.49,Default,,0,0,0,,А, керемет
Dialogue: 0,0:10:47.83,0:10:50.33,Default,,0,0,0,,Ллойд мырза, Ланселот не болып жатыр?
Dialogue: 0,0:10:50.54,0:10:53.58,Default,,0,0,0,,Сіз нені айтасыз, Корейминус сол күйде?
Dialogue: 0,0:10:53.71,0:10:56.55,Default,,0,0,0,,Жоқ, бұл Ланселот Альбион.
Dialogue: 0,0:10:56.67,0:10:58.13,Default,,0,0,0,,Шығаруға дейін
Dialogue: 0,0:11:00.92,0:11:02.47,Default,,0,0,0,,Бұл не? Альбион дегеніміз не?
Dialogue: 0,0:11:03.39,0:11:04.47,Default,,0,0,0,,Ааа
Dialogue: 0,0:11:04.60,0:11:08.18,Default,,0,0,0,,Бұл тек Сузаку Куруругиге арналған түнгі түн...
Dialogue: 0,0:11:08.31,0:11:10.48,Default,,0,0,0,,Енді оны саған бергім келмейді.
Dialogue: 0,0:11:10.77,0:11:12.31,Default,,0,0,0,,Бұл пәрмен
Dialogue: 0,0:11:12.44,0:11:13.81,Default,,0,0,0,,Жеті рыцарь ретінде
Dialogue: 0,0:11:13.94,0:11:15.69,Default,,0,0,0,,Мен оны одан сайын жек көре бастадым.
Dialogue: 0,0:11:15.81,0:11:17.02,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:11:17.15,0:11:18.19,Default,,0,0,0,,Сен, Фрейя...
Dialogue: 0,0:11:18.32,0:11:20.86,Default,,0,0,0,,Атпауға да дайын болу керек дедіңіз.
Dialogue: 0,0:11:20.99,0:11:22.32,Default,,0,0,0,,Сесил мырза
Dialogue: 0,0:11:22.45,0:11:24.20,Default,,0,0,0,,Қару дегеніміз не?
Dialogue: 0,0:11:24.32,0:11:27.24,Default,,0,0,0,,Лорд Куруруги, сіз балаларды талқылайсыз ба?
Dialogue: 0,0:11:27.37,0:11:28.04,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:28.16,0:11:30.00,Default,,0,0,0,,Тоқта, Созаку.
Dialogue: 0,0:11:30.12,0:11:31.29,Default,,0,0,0,,Ұқсамайды (есіктің ашылған дыбысы)
Dialogue: 0,0:11:32.46,0:11:33.50,Default,,0,0,0,,А, міне, осы.
Dialogue: 0,0:11:33.67,0:11:34.83,Default,,0,0,0,,Жақсы, сол күйінде қалдырыңыз.
Dialogue: 0,0:11:35.00,0:11:38.71,Default,,0,0,0,,Көп болды, Корнелия ханшайым.
Dialogue: 0,0:11:38.84,0:11:39.67,Default,,0,0,0,,О
Dialogue: 0,0:11:40.88,0:11:42.22,Default,,0,0,0,,Гилфордқа не болды?
Dialogue: 0,0:11:42.34,0:11:43.84,Default,,0,0,0,,О, бұл
Dialogue: 0,0:11:44.18,0:11:45.14,Default,,0,0,0,,Корнелия
Dialogue: 0,0:11:45.26,0:11:47.05,Default,,0,0,0,,Шын мәнінде, Лорд Гилдфорд...
Dialogue: 0,0:11:47.18,0:11:48.51,Default,,0,0,0,,Бұл шайқаста-
Dialogue: 0,0:11:48.64,0:11:50.85,Default,,0,0,0,,Біз Freyja оқтұмсығымен шабуыл жасасақ та...
Dialogue: 0,0:11:50.97,0:11:51.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:52.02,0:11:53.48,Default,,0,0,0,,Гилдфорд?
Dialogue: 0,0:11:53.60,0:11:56.65,Default,,0,0,0,,Оның өмірі мен өлімі белгісіз болғанымен, жетістіктері орасан.
Dialogue: 0,0:11:56.77,0:11:57.73,Default,,0,0,0,,Мақтануға болады
Dialogue: 0,0:11:57.86,0:11:59.86,Default,,0,0,0,,Корнелия рыцарынан күткендей.
Dialogue: 0,0:12:00.07,0:12:01.40,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:12:01.53,0:12:03.40,Default,,0,0,0,,Фрейджа оқтұмсығын атқан мен болдым.
Dialogue: 0,0:12:04.32,0:12:05.70,Default,,0,0,0,,Бұл менің несием.
Dialogue: 0,0:12:06.20,0:12:08.24,Default,,0,0,0,,Бірлік Рыцарь болу үшін не қажет
Dialogue: 0,0:12:08.37,0:12:09.12,Default,,0,0,0,,Сәлем Созаку
Dialogue: 0,0:12:09.41,0:12:12.54,Default,,0,0,0,,Бұл әрекет лорд Гилдфордтың абыройын қорғау үшін ме?
Dialogue: 0,0:12:12.75,0:12:13.91,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,0:12:14.04,0:12:15.50,Default,,0,0,0,,Жарайды, Созаку-кун.
Dialogue: 0,0:12:15.62,0:12:18.17,Default,,0,0,0,,Жоқ, мен осы уақытқа дейін аңғал болдым.
Dialogue: 0,0:12:18.29,0:12:19.21,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:12:19.67,0:12:21.25,Default,,0,0,0,,Нәтижеден гөрі құралдар туралы айтқанда...
Dialogue: 0,0:12:21.38,0:12:22.76,Default,,0,0,0,,Мен үшін маңыздысы...
Dialogue: 0,0:12:23.26,0:12:25.30,Default,,0,0,0,,Мүмкін бұл идеал немесе эстетикалық болды.
Dialogue: 0,0:12:25.43,0:12:26.26,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:12:26.39,0:12:29.22,Default,,0,0,0,,Әлде Мәртебелі сіз үшін мұны істей ала ма?
Dialogue: 0,0:12:29.35,0:12:30.85,Default,,0,0,0,,Өзіңізді Бірдің Рыцары етіңіз
Dialogue: 0,0:12:30.97,0:12:31.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.43,0:12:37.31,Default,,0,0,0,,Бұл өте құрметсіз мәлімдеме, Куруруги.
Dialogue: 0,0:12:37.44,0:12:39.15,Default,,0,0,0,,Бірдің рыцарының тағайындалуы -
Dialogue: 0,0:12:39.27,0:12:41.40,Default,,0,0,0,,Мұны тек ұлы мәртебелі император жасай алады.
Dialogue: 0,0:12:41.65,0:12:43.07,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:12:45.74,0:12:47.57,Default,,0,0,0,,Олай болса солай айтайық
Dialogue: 0,0:12:47.86,0:12:48.70,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:12:48.91,0:12:49.78,Default,,0,0,0,,Аға
Dialogue: 0,0:12:49.91,0:12:51.79,Default,,0,0,0,,Мен император боламын
Dialogue: 0,0:12:51.91,0:12:53.70,Default,,0,0,0,,Сонда ешқандай проблема жоқ, солай ма?
Dialogue: 0,0:12:53.83,0:12:55.79,Default,,0,0,0,,Мәртебелі, бұл мәлімдеме
Dialogue: 0,0:12:55.91,0:12:56.62,Default,,0,0,0,,Джино
Dialogue: 0,0:12:56.75,0:12:58.79,Default,,0,0,0,,Сіз нені айтасыз? Бұл
Dialogue: 0,0:12:58.92,0:13:02.55,Default,,0,0,0,,Жоғары мәртебелі Шнайзел, сіз жаңа айтқан сөзіңізге шындап қарайсыз ба?
Dialogue: 0,0:13:02.67,0:13:04.92,Default,,0,0,0,,Мен сіздің «дүниелік нәрселер» деп айтқаныңызды естідім
Dialogue: 0,0:13:05.05,0:13:06.26,Default,,0,0,0,,О? а?
Dialogue: 0,0:13:06.38,0:13:10.18,Default,,0,0,0,,Мәртебелі Қара рыцарлармен соғыс туралы айтты.
Dialogue: 0,0:13:10.30,0:13:11.01,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:13:11.22,0:13:13.14,Default,,0,0,0,,Мұны Корнелия да біледі.
Dialogue: 0,0:13:13.27,0:13:17.39,Default,,0,0,0,,Әкем қауіпті ізденіспен айналысып, тақтан жиі кетіп қалды.
Dialogue: 0,0:13:17.73,0:13:18.65,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.77,0:13:21.90,Default,,0,0,0,,Олар саясат пен соғысты ойын ретінде қарастырды.
Dialogue: 0,0:13:22.40,0:13:25.65,Default,,0,0,0,,Бүгінгі күні бұл дүниеге деген қызығушылығым жоғалды.
Dialogue: 0,0:13:25.78,0:13:29.45,Default,,0,0,0,,Барлығының қиналғанын бақылайтын адам...
Dialogue: 0,0:13:29.57,0:13:30.74,Default,,0,0,0,,Патша болуға жарамайды
Dialogue: 0,0:13:31.16,0:13:34.16,Default,,0,0,0,,Шешім ақыры қабылданды, бірақ...
Dialogue: 0,0:13:34.29,0:13:36.83,Default,,0,0,0,,Бұл төңкеріс пе?
Dialogue: 0,0:13:37.33,0:13:39.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:39.33,0:13:43.84,Default,,0,0,0,,Мәртебелі, егер мен Лоундестің орнында болсам, Мәртебелі мырзамен бірге аудитория болар едім.
Dialogue: 0,0:13:43.96,0:13:46.67,Default,,0,0,0,,Императорды өлтіруге бұйрық беріңіз.
Dialogue: 0,0:13:46.80,0:13:47.88,Default,,0,0,0,,Созаку
Dialogue: 0,0:13:48.01,0:13:51.05,Default,,0,0,0,,Егер сіздің жұмысыңыз біреуден бас тарту болса...
Dialogue: 0,0:13:51.18,0:13:53.76,Default,,0,0,0,,Джино Мен мұны мойындаймын.
Dialogue: 0,0:13:53.89,0:13:56.64,Default,,0,0,0,,Сізге қажет нәрсе - нәтиже
Dialogue: 0,0:13:57.14,0:13:58.35,Default,,0,0,0,,) Содан кейін, Аспан Ұлы
Dialogue: 0,0:13:58.48,0:14:00.35,Default,,0,0,0,,Кездесуге сәйкес, Токиода...
Dialogue: 0,0:14:00.48,0:14:03.11,Default,,0,0,0,,Мен канцлер Шнайзелмен келіссөз жүргіземін.
Dialogue: 0,0:14:03.27,0:14:04.36,Default,,0,0,0,,Кагурая
Dialogue: 0,0:14:04.48,0:14:06.78,Default,,0,0,0,,Бұл нөл туралы не деуге болады?
Dialogue: 0,0:14:06.90,0:14:09.78,Default,,0,0,0,,Нөл-саманы жоғалту - бұл қорқынышты соққы.
Dialogue: 0,0:14:09.91,0:14:12.24,Default,,0,0,0,,Сондықтан оның өлімін қалаймыз...
Dialogue: 0,0:14:12.37,0:14:15.24,Default,,0,0,0,,Мүмкіндігінше пайдалану керек
Dialogue: 0,0:14:15.37,0:14:19.75,Default,,0,0,0,,Оның үстіне біз күйеу болсақ та, Нөл-сама екеуміз...
Dialogue: 0,0:14:19.87,0:14:23.79,Default,,0,0,0,,Тек ресми көрініспен
Dialogue: 0,0:14:24.59,0:14:27.46,Default,,0,0,0,,Мәртебелі император Камине аралына қонды ма?
Dialogue: 0,0:14:27.59,0:14:30.59,Default,,0,0,0,,Иә, белгісіз байланыстары бар
Dialogue: 0,0:14:30.72,0:14:32.14,Default,,0,0,0,,Белгісіз мүшелік
Dialogue: 0,0:14:32.26,0:14:33.85,Default,,0,0,0,,Геас тобынан аман қалған адам?
Dialogue: 0,0:14:34.43,0:14:37.97,Default,,0,0,0,,Сіз Созаку ұлы мәртебелі императорды өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:14:38.10,0:14:41.48,Default,,0,0,0,,Джино, қазіргі жағдайыңыз жақсы ма?
Dialogue: 0,0:14:42.31,0:14:43.11,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:14:43.31,0:14:45.48,Default,,0,0,0,,Адамның мәні неде?
Dialogue: 0,0:14:45.61,0:14:48.53,Default,,0,0,0,,Бұл сізді бір нәрсе басқарғыңыз келетінін білдіреді.
Dialogue: 0,0:14:48.65,0:14:52.41,Default,,0,0,0,,Этникалық дін дәстүрінің беделі
Dialogue: 0,0:14:52.74,0:14:55.95,Default,,0,0,0,,Британ императоры оларды ойнауы керек.
Dialogue: 0,0:14:56.08,0:14:58.79,Default,,0,0,0,,Жоғары мәртебелі орындай алады дейсіз бе?
Dialogue: 0,0:14:58.91,0:15:00.00,Default,,0,0,0,,Билік
Dialogue: 0,0:15:00.12,0:15:02.92,Default,,0,0,0,,Мүмкін сіз іздеген нәрсе болса
Dialogue: 0,0:15:04.04,0:15:05.59,Default,,0,0,0,,Не болуы мүмкін?
Dialogue: 0,0:15:05.96,0:15:09.17,Default,,0,0,0,,Биліктің басқа мағынасын білесіз бе?
Dialogue: 0,0:15:10.63,0:15:12.26,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:15:12.80,0:15:14.97,Default,,0,0,0,,Шнайзелдің депозиті?
Dialogue: 0,0:15:15.10,0:15:16.39,Default,,0,0,0,,Бұл менің еркім
Dialogue: 0,0:15:16.89,0:15:17.89,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:15:18.01,0:15:19.64,Default,,0,0,0,,Мені құрметтегеніңіз үшін рахмет...
Dialogue: 0,0:15:19.77,0:15:21.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:21.14,0:15:23.73,Default,,0,0,0,,Бірақ сенің екі күнәң бар.
Dialogue: 0,0:15:23.85,0:15:25.27,Default,,0,0,0,,Хооо
Dialogue: 0,0:15:25.40,0:15:28.61,Default,,0,0,0,,Бірі – ол патшалық міндетінен бас тартты.
Dialogue: 0,0:15:28.73,0:15:30.36,Default,,0,0,0,,Ал басқа нәрсе -
Dialogue: 0,0:15:31.53,0:15:33.49,Default,,0,0,0,,Геасспен айналысу
Dialogue: 0,0:15:33.61,0:15:35.49,Default,,0,0,0,,Бұл күнә ма?
Dialogue: 0,0:15:35.62,0:15:38.91,Default,,0,0,0,,Геас адамдардағы жамандықты сыртқа шығарады.
Dialogue: 0,0:15:39.04,0:15:41.75,Default,,0,0,0,,Иә, егер сіз бәрін білсеңіз...
Dialogue: 0,0:15:41.87,0:15:44.12,Default,,0,0,0,,Тіпті Юффиді құтқарып қалуға болар еді.
Dialogue: 0,0:15:44.25,0:15:45.17,Default,,0,0,0,,Бірақ мен сені тастап кеттім
Dialogue: 0,0:15:45.29,0:15:46.84,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:15:47.00,0:15:48.04,Default,,0,0,0,,На
Dialogue: 0,0:15:48.34,0:15:49.50,Default,,0,0,0,,Бұл қылышқа-
Dialogue: 0,0:15:49.63,0:15:52.51,Default,,0,0,0,,Мен Лелуш пен Нанналлидің үмітсіздігін де қосамын.
Dialogue: 0,0:15:53.26,0:15:54.26,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:15:55.01,0:15:56.80,Default,,0,0,0,,Лорд Ва Вальдштейн
Dialogue: 0,0:15:56.93,0:15:57.85,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:15:58.35,0:16:01.73,Default,,0,0,0,,Геасс туралы жалғыз өзіңді біледі деп ойладың ба?
Dialogue: 0,0:16:02.10,0:16:03.60,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:16:03.73,0:16:07.73,Default,,0,0,0,,Маған опасыздық жасайтын сен сияқты адамға кім сенеді?
Dialogue: 0,0:16:07.86,0:16:10.78,Default,,0,0,0,,Бисмарк Дүниелік істерді саған тапсырамын.
Dialogue: 0,0:16:10.90,0:16:12.69,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:16:12.86,0:16:13.53,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:19.78,0:16:23.00,Default,,0,0,0,,) Оуги немесе Хонгу. Мен кемеге қонуға рұқсат сұрағым келеді.
Dialogue: 0,0:16:23.12,0:16:25.33,Default,,0,0,0,,Мен Тенши-сама мен Кагура-саманы әкелдім.
Dialogue: 0,0:16:25.46,0:16:26.79,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:26.92,0:16:29.54,Default,,0,0,0,,Сосын мен де Шнайзелге хабарласамын.
Dialogue: 0,0:16:30.09,0:16:33.09,Default,,0,0,0,,Мен желдеткіш аздап өзгерді деп ойладым...
Dialogue: 0,0:16:33.22,0:16:35.47,Default,,0,0,0,,Бұл әлі де қате көрсетілді ме?
Dialogue: 0,0:16:35.59,0:16:38.55,Default,,0,0,0,,Оның мәні – қорғау
Dialogue: 0,0:16:40.76,0:16:41.60,Default,,0,0,0,,№
Dialogue: 0,0:16:41.72,0:16:43.98,Default,,0,0,0,,Маған өмір сүруді бұйыратын Геас маған сүйенеді...
Dialogue: 0,0:16:44.48,0:16:46.35,Default,,0,0,0,,Мына жер сенің қашасың деп айқайлап тұр.
Dialogue: 0,0:16:46.48,0:16:49.40,Default,,0,0,0,,Бір рыцарь соншалықты қауіпті қарсылас па?
Dialogue: 0,0:16:49.61,0:16:51.78,Default,,0,0,0,,Бірақ мен әлсіздіктен бас тарттым!
Dialogue: 0,0:16:51.90,0:16:52.90,Default,,0,0,0,,ақымақ
Dialogue: 0,0:16:53.03,0:16:54.74,Default,,0,0,0,,Сіздің әлсіздігіңіз...
Dialogue: 0,0:16:56.07,0:16:59.53,Default,,0,0,0,,Мейірімділік күшінің негізі неде болды
Dialogue: 0,0:16:59.66,0:17:03.58,Default,,0,0,0,,Иә, нормасыз күш – жай ғана зорлық.
Dialogue: 0,0:17:03.70,0:17:04.45,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:17:04.58,0:17:05.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:05.91,0:17:08.46,Default,,0,0,0,,Сузаку Куруруги осында өлген жақсы
Dialogue: 0,0:17:08.46,0:17:09.00,Default,,0,0,0,,Сузаку Куруруги осында өлген жақсы
Dialogue: 0,0:17:08.46,0:17:09.00,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:09.00,0:17:09.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:09.13,0:17:09.54,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:09.13,0:17:09.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:09.54,0:17:10.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:19.39,0:17:22.31,Default,,0,0,0,,Менің атым Лелух ви Британия
Dialogue: 0,0:17:22.43,0:17:24.72,Default,,0,0,0,,Императрица Марианнаның үлкен баласы...
Dialogue: 0,0:17:24.85,0:17:27.35,Default,,0,0,0,,Империя тастап кеткен князь
Dialogue: 0,0:17:28.06,0:17:30.02,Default,,0,0,0,,Мәртебелі императормен байланысу мүмкін болмады
Dialogue: 0,0:17:30.15,0:17:33.23,Default,,0,0,0,,Күдікті адамдарға қамауға алынбайды, өлтіріледі деген болжаммен қарау.
Dialogue: 0,0:17:33.36,0:17:34.86,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:17:36.57,0:17:38.74,Default,,0,0,0,,Не! ? Неге біз... Уау.
Dialogue: 0,0:17:39.11,0:17:40.95,Default,,0,0,0,,Неліктен сіз өз әріптестеріңізге оқ жаудырасыз? ?
Dialogue: 0,0:17:41.07,0:17:44.24,Default,,0,0,0,,Мен тексеріп жатырмын, бірақ 3-ші мұнара бөлмесімен байланыса алмаймын.
Dialogue: 0,0:17:44.37,0:17:46.66,Default,,0,0,0,,Біреудің басып алу мүмкіндігі
Dialogue: 0,0:17:46.79,0:17:48.75,Default,,0,0,0,,Жауап 3-мұнара бөлмесі
Dialogue: 0,0:17:48.87,0:17:52.00,Default,,0,0,0,,Жауап болмаса, мәжбүрлі түрде жойылады
Dialogue: 0,0:17:52.21,0:17:54.59,Default,,0,0,0,,Бізбен бірге жүріңіз, корольдік гвардия!
Dialogue: 0,0:17:54.71,0:17:56.55,Default,,0,0,0,,Барлық жауларды жою
Dialogue: 0,0:17:56.67,0:17:58.13,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:17:59.51,0:18:00.18,Default,,0,0,0,,Га
Dialogue: 0,0:18:00.30,0:18:03.51,Default,,0,0,0,,Шикинедзима базасындағы барлық күштер дұшпандық әрекеттерді жасауда.
Dialogue: 0,0:18:03.64,0:18:06.89,Default,,0,0,0,,Біздің лагерьде өзара ұрыс болғаны туралы хабарлар болды.
Dialogue: 0,0:18:07.06,0:18:07.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:07.98,0:18:09.10,Default,,0,0,0,,Бұл көтеріліс! ?
Dialogue: 0,0:18:09.23,0:18:11.27,Default,,0,0,0,,Иә Мәртебелі император туралы не деуге болады?
Dialogue: 0,0:18:11.40,0:18:14.11,Default,,0,0,0,,Мәртебелі ең қауіпсіз жерге көшірілді.
Dialogue: 0,0:18:14.23,0:18:15.40,Default,,0,0,0,,Енді... Иә?
Dialogue: 0,0:18:16.99,0:18:19.74,Default,,0,0,0,,Лелуш Бұл менің айқышым.
Dialogue: 0,0:18:22.16,0:18:23.24,Default,,0,0,0,,Уф уау
Dialogue: 0,0:18:24.74,0:18:26.83,Default,,0,0,0,,Ұлыбританияны кім басқарады?
Dialogue: 0,0:18:26.95,0:18:30.12,Default,,0,0,0,,Он екі сері Моника Крушевский
Dialogue: 0,0:18:30.25,0:18:33.25,Default,,0,0,0,,Егер жақсы болса, мен Галахадқа кетемін.
Dialogue: 0,0:18:34.67,0:18:36.88,Default,,0,0,0,,Мордредпен әлі де байланыса алмадыңыз ба?
Dialogue: 0,0:18:37.01,0:18:39.92,Default,,0,0,0,,Иә, баратын жер Камин аралы.
Dialogue: 0,0:18:40.30,0:18:42.76,Default,,0,0,0,,Бұрынғы ақпаратты ескере отырып...
Dialogue: 0,0:18:42.89,0:18:45.18,Default,,0,0,0,,Менің ойымша, ол Ұлы мәртебелі императордың қол астында көшірілді ме?
Dialogue: 0,0:18:46.93,0:18:48.98,Default,,0,0,0,,Сузаку-кунмен
Dialogue: 0,0:18:49.10,0:18:50.89,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:18:51.27,0:18:53.56,Default,,0,0,0,,Кагура-сама, кешіріңіз.
Dialogue: 0,0:18:53.69,0:18:56.36,Default,,0,0,0,,Енді Каминедзимаға баруымыз керек.
Dialogue: 0,0:18:56.48,0:18:58.40,Default,,0,0,0,,Олай болса біз де келеміз.
Dialogue: 0,0:18:58.53,0:18:59.28,Default,,0,0,0,,Ах
Dialogue: 0,0:18:59.69,0:19:00.86,Default,,0,0,0,,Жағдайларда -
Dialogue: 0,0:19:00.99,0:19:03.66,Default,,0,0,0,,Британ императорына жүзін бұрған адамға.
Dialogue: 0,0:19:03.78,0:19:06.03,Default,,0,0,0,,Менің есімде тек бір адам қалды.
Dialogue: 0,0:19:06.28,0:19:07.58,Default,,0,0,0,,) Мен де
Dialogue: 0,0:19:07.87,0:19:11.25,Default,,0,0,0,,деп алсақ, тексеретін бірнеше нүкте бар сияқты.
Dialogue: 0,0:19:11.83,0:19:15.17,Default,,0,0,0,,Осы мәселе біткен соң әңгімемізді жалғастырайық.
Dialogue: 0,0:19:16.21,0:19:18.63,Default,,0,0,0,,Егер сіз оны тоқтата алсаңыз, оны тоқтатуға тырысыңыз.
Dialogue: 0,0:19:18.76,0:19:22.22,Default,,0,0,0,,Менің үмітсіздігіме тең келетін адам болса
Dialogue: 0,0:19:28.85,0:19:31.02,Default,,0,0,0,,Жаудың кім екенін білмеймін, бірақ...
Dialogue: 0,0:19:31.14,0:19:34.19,Default,,0,0,0,,Біз бәрін қиратамыз... А?
Dialogue: 0,0:19:35.86,0:19:37.98,Default,,0,0,0,,Аня, мен бұл сен болады деп күтпедім.
Dialogue: 0,0:19:38.11,0:19:41.15,Default,,0,0,0,,Бұл төңкеріске қосылу үшін әлі де бір рыцарь бола ма?
Dialogue: 0,0:19:41.28,0:19:41.90,Default,,0,0,0,,Не?
Dialogue: 0,0:19:43.66,0:19:47.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:51.79,0:19:52.96,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:19:53.08,0:19:55.17,Default,,0,0,0,,Мен қалай сенемін?
Dialogue: 0,0:19:57.21,0:19:58.88,Default,,0,0,0,,Жау Шикинедзимадан келді.
Dialogue: 0,0:19:59.00,0:20:00.59,Default,,0,0,0,,Моника да куәлік етеді.
Dialogue: 0,0:20:00.84,0:20:03.13,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:20:03.59,0:20:05.34,Default,,0,0,0,,Түсінсеңіз, жақсы.
Dialogue: 0,0:20:05.47,0:20:06.68,Default,,0,0,0,,Әуе кемесінің зақымдануы туралы не айтуға болады?
Dialogue: 0,0:20:07.39,0:20:09.51,Default,,0,0,0,,Әуедегі жауынгерлік маневрлік қабілеті төмендейді
Dialogue: 0,0:20:09.64,0:20:12.18,Default,,0,0,0,,Мен көтерілісшілер әскеріне құрлықтан шабуыл жасағым келеді.
Dialogue: 0,0:20:12.31,0:20:15.19,Default,,0,0,0,,Жарайды, мен тақ кемесін қорғаймын.
Dialogue: 0,0:20:16.94,0:20:18.48,Default,,0,0,0,,Ол керемет актер.
Dialogue: 0,0:20:18.61,0:20:21.74,Default,,0,0,0,,Менің Бисмаркқа түсіндіруге уақытым жоқ.
Dialogue: 0,0:20:21.86,0:20:24.78,Default,,0,0,0,,Сен күмәндансаң, олар күмәнданбайды.
Dialogue: 0,0:20:24.90,0:20:27.82,Default,,0,0,0,,Сол шабыт өшпейтін сияқты.
Dialogue: 0,0:20:27.95,0:20:29.66,Default,,0,0,0,,Марианна Флеш
Dialogue: 0,0:20:29.78,0:20:32.16,Default,,0,0,0,,Лелухтың анасы күткендей.
Dialogue: 0,0:20:32.29,0:20:33.50,Default,,0,0,0,,Эй, не істеуіміз керек?
Dialogue: 0,0:20:33.62,0:20:34.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.75,0:20:37.25,Default,,0,0,0,,Мен көмектесуім керек пе? ол
Dialogue: 0,0:20:52.39,0:20:54.43,Default,,0,0,0,,Кел, Құдайым
Dialogue: 0,0:20:54.85,0:20:57.65,Default,,0,0,0,,Жабу уақыты келді
Dialogue: 0,0:20:57.77,0:20:59.40,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:21:00.06,0:21:03.61,Default,,0,0,0,,Сіз қателесесіз, Чарльз Британдық.
Dialogue: 0,0:21:03.74,0:21:06.95,Default,,0,0,0,,Бұл мәселені шешуге Құдай емес.
Dialogue: 0,0:21:08.62,0:21:10.45,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:21:10.58,0:21:12.41,Default,,0,0,0,,Қалай
Dialogue: 0,0:21:12.54,0:21:15.66,Default,,0,0,0,,Мылтық болсын, қылыш болсын, Геас болсын...
Dialogue: 0,0:21:15.79,0:21:19.17,Default,,0,0,0,,Мені өлтіре алмасаң да
Dialogue: 0,0:21:20.25,0:21:21.67,Default,,0,0,0,,Кишибе Рохан секілді күші бар біреу!
Dialogue: 0,0:21:21.80,0:21:24.30,Default,,0,0,0,,Осы жерге келгеніңіз үшін рахмет...
Dialogue: 0,0:21:24.42,0:21:26.22,Default,,0,0,0,,Жеңіс көз алдында
Dialogue: 0,0:21:26.34,0:21:27.18,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:31.89,0:21:33.01,Default,,0,0,0,,Құт
Dialogue: 0,0:21:34.14,0:21:35.81,Default,,0,0,0,,Сіз шығуды жауып тастадыңыз ба?
Dialogue: 0,0:21:35.93,0:21:38.69,Default,,0,0,0,,Дұрыс, Геас та, сіз де...
Dialogue: 0,0:21:38.81,0:21:41.48,Default,,0,0,0,,Менімен бірге осы кеңістікте мені қамап қойыңыз.
Dialogue: 0,0:21:41.61,0:21:43.82,Default,,0,0,0,,Егер сіз енді шынайы әлемге араласа алмасаңыз...
Dialogue: 0,0:21:43.94,0:21:47.24,Default,,0,0,0,,Нені жоспарлап отырғаныңыз маңызды емес.
Dialogue: 0,0:21:47.36,0:21:49.36,Default,,0,0,0,,Ерен де, мен де бұны ұзақ уақыттан бері білеміз
Dialogue: 0,0:21:49.49,0:21:51.41,Default,,0,0,0,,Лелуш
Dialogue: 0,0:21:51.78,0:21:53.66,Default,,0,0,0,,Сіз жасаған бұл жүйе...
Dialogue: 0,0:21:53.79,0:21:57.71,Default,,0,0,0,,Ол енді өзіңді зынданға салып, жаныңның түрмесіне айналды.
Dialogue: 0,0:21:57.83,0:22:02.92,Default,,0,0,0,,Кел, мәңгілік азапта менімен бірге қинал.
Dialogue: 0,0:22:03.34,0:22:06.92,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.05,0:22:10.47,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.59,0:22:14.43,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық көрсет, жамандық гүлі
Dialogue: 0,0:22:14.56,0:22:17.85,Default,,0,0,0,,♪Екіжүзділіктің арманшыл көздерін бақылаңыз
Dialogue: 0,0:22:17.98,0:22:21.98,Default,,0,0,0,,♪ Өмір мен зұлымдық бөлінбейді
Dialogue: 0,0:22:25.40,0:22:28.90,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:29.03,0:22:32.87,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағынсың
Dialogue: 0,0:22:32.99,0:22:36.33,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.45,0:22:40.04,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.16,0:22:43.71,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.84,0:22:47.63,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.76,0:22:54.55,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.89,0:22:59.39,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.52,0:23:03.10,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.23,0:23:05.86,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:05.98,0:23:09.65,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.82,0:23:14.12,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.24,0:23:18.12,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.24,0:23:21.58,Default,,0,0,0,,♪Екі жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.71,0:23:25.29,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.42,0:23:32.43,Default,,0,0,0,,♪Өзіңді қандай болсаң солай қалдыр.
Dialogue: 0,0:23:37.39,0:23:39.06,Default,,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:23:39.18,0:23:41.10,Default,,0,0,0,,Иә, мен онымен бетпе-бет келемін.
Dialogue: 0,0:23:41.23,0:23:43.10,Default,,0,0,0,,Мен өзім болуым үшін бәріне тәуекел еттім.
Dialogue: 0,0:23:43.23,0:23:44.44,Default,,0,0,0,,Бұл адаммен
Dialogue: 0,0:23:44.56,0:23:46.61,Default,,0,0,0,,Британ императоры Чарльзбен
Dialogue: 0,0:23:46.73,0:23:49.36,Default,,0,0,0,,Бұдан кейін бізді не күтіп тұрғанына қарамастан...
Dialogue: 0,0:23:49.61,0:23:50.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:52.28,0:23:58.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory