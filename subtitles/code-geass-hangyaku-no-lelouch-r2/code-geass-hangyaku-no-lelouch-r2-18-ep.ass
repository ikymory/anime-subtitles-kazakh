Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.98,0:00:03.14,Default,,0,0,0,,Біріккен Ұлттар Ұйымының №1 қарары -
Dialogue: 0,0:00:03.27,0:00:06.27,Default,,0,0,0,,Жапонияны азат ету туралы өтінішке қара рыцарьлар...
Dialogue: 0,0:00:06.40,0:00:10.15,Default,,0,0,0,,Қасиетті Британ империясының колониясы 11-аймаққа қарсы.
Dialogue: 0,0:00:10.28,0:00:12.28,Default,,0,0,0,,Қону операциясын жүргізу
Dialogue: 0,0:00:12.82,0:00:15.32,Default,,0,0,0,,Бір рыцарь Кюсю жағалауында қосын құрады.
Dialogue: 0,0:00:15.45,0:00:17.28,Default,,0,0,0,,Бисмарк Вальдштейнге -
Dialogue: 0,0:00:17.41,0:00:21.00,Default,,0,0,0,,Бас қолбасшы Ли Син-ку бастаған негізгі күштер қақтығысып қалды.
Dialogue: 0,0:00:21.12,0:00:24.17,Default,,0,0,0,,Бұны бұрыс ретінде пайдаланып, Қара рыцарьлардың жеке бөлімшесі...
Dialogue: 0,0:00:24.29,0:00:27.04,Default,,0,0,0,,Біз Токио концессиясына қарай ілгерілей бастадық.
Dialogue: 0,0:00:27.63,0:00:30.13,Default,,0,0,0,,Дегенмен, Шнайзел армиясы күтіп тұр...
Dialogue: 0,0:00:30.25,0:00:33.13,Default,,0,0,0,,Жаппай қырып-жою қаруы Фрейяның болуы...
Dialogue: 0,0:00:33.26,0:00:35.64,Default,,0,0,0,,Осы кезде нөлден бастап...
Dialogue: 0,0:00:35.76,0:00:39.64,Default,,0,0,0,,Қара рыцарьлар жағында ешкім білуге мүмкіндік болмады.
Dialogue: 0,0:00:43.27,0:00:47.81,Default,,0,0,0,,♪Дүниенің ақырында туған нұр
Dialogue: 0,0:00:47.94,0:00:53.49,Default,,0,0,0,,♪ Енді желде
Dialogue: 0,0:01:09.38,0:01:14.34,Default,,0,0,0,,♪Сұлу болу арқылы өмір сүре алмайсың
Dialogue: 0,0:01:14.72,0:01:20.05,Default,,0,0,0,,♪Мейірімділік жалғыз емдей алмайды
Dialogue: 0,0:01:20.18,0:01:22.89,Default,,0,0,0,,♪Не ұрланды?
Dialogue: 0,0:01:23.02,0:01:25.14,Default,,0,0,0,,♪Өзгермейтін әлемде
Dialogue: 0,0:01:25.60,0:01:28.23,Default,,0,0,0,,♪Сіз не естідіңіз?
Dialogue: 0,0:01:28.35,0:01:31.48,Default,,0,0,0,,♪Түстер әні
Dialogue: 0,0:01:31.61,0:01:36.49,Default,,0,0,0,,♪Бәрі жарық
Dialogue: 0,0:01:37.32,0:01:39.95,Default,,0,0,0,,♪Тасылған армандар
Dialogue: 0,0:01:40.07,0:01:46.50,Default,,0,0,0,,♪Ертеңгі күннің соңында жаңғырық
Dialogue: 0,0:01:48.12,0:01:52.59,Default,,0,0,0,,♪Дүниенің соңында туған нұр
Dialogue: 0,0:01:52.71,0:01:57.26,Default,,0,0,0,,♪Біз бірміз
Dialogue: 0,0:01:58.13,0:02:03.76,Default,,0,0,0,,♪ Қазір желде
Dialogue: 0,0:02:17.28,0:02:19.91,Default,,0,0,0,,Қара рыцарьлар Икаруга флотына айтады
Dialogue: 0,0:02:20.36,0:02:21.74,Default,,0,0,0,,Gefion Disturber бойынша -
Dialogue: 0,0:02:21.87,0:02:24.08,Default,,0,0,0,,Токио концессиясының өмірлік байланыс желісі
Dialogue: 0,0:02:24.20,0:02:27.79,Default,,0,0,0,,Ал бесінші ұрпақ алдындағы түнгі түндер жұмысын тоқтатты.
Dialogue: 0,0:02:27.91,0:02:29.96,Default,,0,0,0,,Жаудың күші екі есе азайды.
Dialogue: 0,0:02:30.08,0:02:31.42,Default,,0,0,0,,Әрбір негізгі нысанға соққы беріңіз.
Dialogue: 0,0:02:31.54,0:02:34.25,Default,,0,0,0,,Токио концессиясының күресті жалғастыру мүмкіндігін алыңыз
Dialogue: 0,0:02:34.38,0:02:38.30,Default,,0,0,0,,Шайқас Шнайзел басқарған негізгі күш келгенше болады.
Dialogue: 0,0:02:38.42,0:02:41.80,Default,,0,0,0,,Қорғаныс сызығын сақтай отырып, Британ үкіметінің кеңсесін оқшаулаңыз.
Dialogue: 0,0:02:41.93,0:02:45.39,Default,,0,0,0,,Губернатор Нунеллиді қолға түсірсек, әскеріміз жеңіске жетеді.
Dialogue: 0,0:02:47.02,0:02:50.19,Default,,0,0,0,,Губернатор Нуналли Нөл пайда болды.
Dialogue: 0,0:02:50.44,0:02:52.02,Default,,0,0,0,,Ах га нөл
Dialogue: 0,0:02:52.19,0:02:53.65,Default,,0,0,0,,Нөл келді
Dialogue: 0,0:02:53.77,0:02:55.27,Default,,0,0,0,,Жақсы жүз, иә?
Dialogue: 0,0:02:55.78,0:02:58.49,Default,,0,0,0,,Бұл сізге дұрыс сияқты.
Dialogue: 0,0:02:58.65,0:03:01.86,Default,,0,0,0,,Бірақ кешіріңіз, тілегіңіз орындалмайды.
Dialogue: 0,0:03:02.03,0:03:04.99,Default,,0,0,0,,Мен және Тристан осында болғанша
Dialogue: 0,0:03:06.95,0:03:09.33,Default,,0,0,0,,Алдымен айналма жол бойымен кеңейтіңіз.
Dialogue: 0,0:03:09.46,0:03:12.17,Default,,0,0,0,,Gefion Disturber жою үшін
Dialogue: 0,0:03:12.58,0:03:14.63,Default,,0,0,0,,Ланселот үлгере ала ма?
Dialogue: 0,0:03:14.75,0:03:16.71,Default,,0,0,0,,Бұл Лорд Куруругидің мақтанышы...
Dialogue: 0,0:03:16.84,0:03:18.05,Default,,0,0,0,,Мен сұрауым керек пе?
Dialogue: 0,0:03:18.17,0:03:19.22,Default,,0,0,0,,Фуфу
Dialogue: 0,0:03:19.42,0:03:22.89,Default,,0,0,0,,Ұрыс даласында мұндай сөзді естимін деп ойламаппын.
Dialogue: 0,0:03:23.39,0:03:25.35,Default,,0,0,0,,Нина, сенің қолыңнан келмейді.
Dialogue: 0,0:03:25.51,0:03:28.39,Default,,0,0,0,,Бірақ бәрі осылай жалғаса берсе, Токио концессиясы нөлге тең болады.
Dialogue: 0,0:03:28.52,0:03:29.64,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:03:29.77,0:03:32.65,Default,,0,0,0,,Ойлаушы емессің, ғалымсың.
Dialogue: 0,0:03:32.77,0:03:35.52,Default,,0,0,0,,Егер сіз FCC пайдалансаңыз, сіз мемлекеттік мекемелерге бара аласыз.
Dialogue: 0,0:03:35.98,0:03:38.32,Default,,0,0,0,,Сіз Фрейяны атуға дайынсыз ба?
Dialogue: 0,0:03:38.44,0:03:39.40,Default,,0,0,0,,Ах
Dialogue: 0,0:03:39.53,0:03:43.03,Default,,0,0,0,,Бұл ғана емес, атпауға да дайын болу керек.
Dialogue: 0,0:03:43.16,0:03:44.03,Default,,0,0,0,,Тапсырма
Dialogue: 0,0:03:44.16,0:03:46.99,Default,,0,0,0,,Асахина мен Чиба үкіметтің әуедегі артықшылығын басқарсын
Dialogue: 0,0:03:47.12,0:03:48.33,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:03:48.74,0:03:52.87,Default,,0,0,0,,Енді, мәселе жаудың 6-шы буын Nightmares және одан кейінгі.
Dialogue: 0,0:03:53.00,0:03:56.17,Default,,0,0,0,,Роло, ол жақта жағдай қалай?
Dialogue: 0,0:03:56.46,0:03:58.71,Default,,0,0,0,,Сакиоко командасы алда.
Dialogue: 0,0:03:58.84,0:04:01.09,Default,,0,0,0,,Біз қазірден бастап сізге қосыламыз.
Dialogue: 0,0:04:01.22,0:04:04.14,Default,,0,0,0,,Жарайды, Nunnally-ді қорғаңыз.
Dialogue: 0,0:04:05.09,0:04:07.97,Default,,0,0,0,,Иә? Сіз күткендей келдіңіз бе? Созаку
Dialogue: 0,0:04:08.51,0:04:12.64,Default,,0,0,0,,Лелуш: Менде нөлдік төлем жасаудан басқа амалым жоқ.
Dialogue: 0,0:04:12.77,0:04:15.40,Default,,0,0,0,,Мені естисің бе, Нөл, шайқасты тоқтат?
Dialogue: 0,0:04:15.86,0:04:18.82,Default,,0,0,0,,Бұл ауыр тактикалық оқтұмсықты алып жүреді.
Dialogue: 0,0:04:18.94,0:04:23.15,Default,,0,0,0,,Егер ол қолданылса, 40 миллион ритадан астам зиян келтіреді. Оған дейін...
Dialogue: 0,0:04:23.28,0:04:26.16,Default,,0,0,0,,Өз сөзіңізге сене аласыз ба, Еремия?
Dialogue: 0,0:04:26.28,0:04:26.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.03,0:04:28.83,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:04:30.54,0:04:32.29,Default,,0,0,0,,Сіз сэр Еремиясыз ба? неге!
Dialogue: 0,0:04:32.46,0:04:35.25,Default,,0,0,0,,Сузаку Куруруги Мен сізге қарыздармын.
Dialogue: 0,0:04:35.37,0:04:38.84,Default,,0,0,0,,Жанашырлық та бар, ұялшақтық та бар, бірақ бұл жерде...
Dialogue: 0,0:04:38.96,0:04:40.13,Default,,0,0,0,,Адалдық басым!
Dialogue: 0,0:04:41.92,0:04:43.13,Default,,0,0,0,,Зигфрид те
Dialogue: 0,0:04:43.26,0:04:45.51,Default,,0,0,0,,Адалдық дауылын қабылдаңыз!
Dialogue: 0,0:04:48.51,0:04:51.22,Default,,0,0,0,,Қарғыс атсын, сіз үшін қандай жағдай болса да...
Dialogue: 0,0:04:51.39,0:04:52.43,Default,,0,0,0,,Қазір!
Dialogue: 0,0:04:54.39,0:04:55.06,Default,,0,0,0,,Әй
Dialogue: 0,0:04:55.81,0:04:58.36,Default,,0,0,0,,Сазерленд Сиг пайдалы болып көрінеді.
Dialogue: 0,0:04:58.48,0:04:59.98,Default,,0,0,0,,Бірақ иә?
Dialogue: 0,0:05:00.23,0:05:03.49,Default,,0,0,0,,Зигфрид жүйесін қолданатын бір реттік ұшақ
Dialogue: 0,0:05:03.61,0:05:05.40,Default,,0,0,0,,Бұл жаппай өндіруге жарамайды.
Dialogue: 0,0:05:05.95,0:05:07.82,Default,,0,0,0,,Маған бұдан да артық айтқаныңызды қалаймын...
Dialogue: 0,0:05:07.95,0:05:11.08,Default,,0,0,0,,Мен Еремия неге бізге қосылып жатыр деп ойлаймын.
Dialogue: 0,0:05:11.45,0:05:14.96,Default,,0,0,0,,Империяның найзасы атанған адамнан басқа.
Dialogue: 0,0:05:15.41,0:05:16.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:16.92,0:05:20.59,Default,,0,0,0,,Неліктен мен Британдық әскерді өз жауыма айналдырдым?
Dialogue: 0,0:05:20.71,0:05:21.34,Default,,0,0,0,,Гилдфорд
Dialogue: 0,0:05:21.34,0:05:22.09,Default,,0,0,0,,Гилдфорд
Dialogue: 0,0:05:21.34,0:05:22.09,Default,,0,0,0,,Уф
Dialogue: 0,0:05:22.21,0:05:25.01,Default,,0,0,0,,Еремияға қосылыңыз және Сузаку Куруругиді атыңыз
Dialogue: 0,0:05:25.42,0:05:27.43,Default,,0,0,0,,Дегенмен, ханшайым Куруруги
Dialogue: 0,0:05:27.64,0:05:30.68,Default,,0,0,0,,Түсіндіруге уақыт жоқ. Апаттық жағдай
Dialogue: 0,0:05:30.81,0:05:32.56,Default,,0,0,0,,Маған сеніп, күресесің бе?
Dialogue: 0,0:05:32.68,0:05:34.77,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:05:34.98,0:05:38.31,Default,,0,0,0,,Еремия сэр Мен бұл шайқастың аяқталуын қалаймын.
Dialogue: 0,0:05:38.44,0:05:42.65,Default,,0,0,0,,Сонда менің қасіретімді өшіру үшін не істей аласың?
Dialogue: 0,0:05:43.03,0:05:44.82,Default,,0,0,0,,Барлығын тартудың қажеті жоқ!
Dialogue: 0,0:05:45.78,0:05:46.78,Default,,0,0,0,,Уф
Dialogue: 0,0:05:46.90,0:05:48.03,Default,,0,0,0,,Лорд Гилдфордқа
Dialogue: 0,0:05:48.24,0:05:50.70,Default,,0,0,0,,Куруруги Екеуінің де шебері бар
Dialogue: 0,0:05:50.95,0:05:51.87,Default,,0,0,0,,Қате түсінбе.
Dialogue: 0,0:05:51.99,0:05:53.66,Default,,0,0,0,,Сузаку Фрейяны атып таста!
Dialogue: 0,0:05:53.83,0:05:54.33,Default,,0,0,0,,Ах
Dialogue: 0,0:05:54.33,0:05:54.95,Default,,0,0,0,,Ах
Dialogue: 0,0:05:54.33,0:05:54.95,Default,,0,0,0,,Қазір нөл!
Dialogue: 0,0:05:54.95,0:05:55.83,Default,,0,0,0,,Қазір нөл!
Dialogue: 0,0:05:55.96,0:05:59.42,Default,,0,0,0,,Кешіріңіз, Нина, мен мұны қолданбаймын, бірақ-
Dialogue: 0,0:06:00.08,0:06:01.42,Default,,0,0,0,,Нөл –
Dialogue: 0,0:06:01.67,0:06:02.67,Default,,0,0,0,,Мен!
Dialogue: 0,0:06:07.34,0:06:08.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:10.22,0:06:13.39,Default,,0,0,0,,Жарайды, жоспар бойынша Созақуды осы жерден шығарсақ...
Dialogue: 0,0:06:13.51,0:06:15.22,Default,,0,0,0,,Nunnally-ді қайтарудағы кедергілер...
Dialogue: 0,0:06:15.35,0:06:15.98,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:06:18.48,0:06:21.36,Default,,0,0,0,,Қоңыр түні ұрыс даласында жеңіліс жоқ!
Dialogue: 0,0:06:23.23,0:06:24.28,Default,,0,0,0,,Джино, кешіріңіз.
Dialogue: 0,0:06:24.48,0:06:26.90,Default,,0,0,0,,Осындай кезде тек бақытты бол.
Dialogue: 0,0:06:27.03,0:06:28.11,Default,,0,0,0,,Еремия сэр?
Dialogue: 0,0:06:29.57,0:06:31.87,Default,,0,0,0,,Оранждың күдігі рас болған сияқты.
Dialogue: 0,0:06:31.99,0:06:36.33,Default,,0,0,0,,Апельсин? Хехе менің адалдығымның аты осы.
Dialogue: 0,0:06:37.50,0:06:39.00,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:06:39.21,0:06:43.25,Default,,0,0,0,,Бұл күш, Шнайзел, сен Токио шайқасын оқыдың ба?
Dialogue: 0,0:06:47.84,0:06:51.89,Default,,0,0,0,,Дұрыс, мен сізге сәл кейінірек қосыламын.
Dialogue: 0,0:06:52.01,0:06:56.39,Default,,0,0,0,,Иә, түсіндім. Мен 13-қабатқа дейін көтерілдім.
Dialogue: 0,0:06:57.85,0:07:01.48,Default,,0,0,0,,Уайымдама, мен міндетті түрде Нуналлиді табамын.
Dialogue: 0,0:07:01.60,0:07:03.86,Default,,0,0,0,,А, мен сұрадым, Роло.
Dialogue: 0,0:07:04.48,0:07:08.53,Default,,0,0,0,,Біз Нунеллиді қайтарғанша, Роло, бізбен жұмыс бітті.
Dialogue: 0,0:07:09.19,0:07:10.65,Default,,0,0,0,,Маған қалдырыңыз, ағайын.
Dialogue: 0,0:07:10.78,0:07:13.32,Default,,0,0,0,,Мен Нуннеллиді міндетті түрде табамын...
Dialogue: 0,0:07:13.53,0:07:15.24,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:07:15.70,0:07:18.33,Default,,0,0,0,,Мен ағамның жанұясының мен болғанына жақсымын.
Dialogue: 0,0:07:18.45,0:07:19.79,Default,,0,0,0,,Құрметті Роло
Dialogue: 0,0:07:20.21,0:07:23.13,Default,,0,0,0,,Бұл ангарға барған екінші топтың шұғыл хабарламасы.
Dialogue: 0,0:07:23.79,0:07:26.55,Default,,0,0,0,,Үшінші басымдық табылды.
Dialogue: 0,0:07:27.88,0:07:30.26,Default,,0,0,0,,Жоқ, мен жалғыз қашып жүрмін.
Dialogue: 0,0:07:30.38,0:07:32.68,Default,,0,0,0,,Бұл Жоғары мәртебелі Премьер-Министрдің тапсырмасы.
Dialogue: 0,0:07:32.80,0:07:34.43,Default,,0,0,0,,Шнайзел ағасы
Dialogue: 0,0:07:34.55,0:07:38.10,Default,,0,0,0,,Басқалары губернаторды тастап қаша алмайды.
Dialogue: 0,0:07:38.10,0:07:38.72,Default,,0,0,0,,Басқалары губернаторды тастап қаша алмайды.
Dialogue: 0,0:07:38.10,0:07:38.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:38.72,0:07:39.06,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:39.06,0:07:40.06,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:39.06,0:07:40.06,Default,,0,0,0,,Ах
Dialogue: 0,0:07:41.85,0:07:43.98,Default,,0,0,0,,Я, мына Гареттің алдында
Dialogue: 0,0:07:44.10,0:07:46.61,Default,,0,0,0,,Еш қағыспа! Ауа артықшылығын алыңыз
Dialogue: 0,0:07:46.86,0:07:48.61,Default,,0,0,0,,Ватари-сан үкімет кеңсесінде!
Dialogue: 0,0:07:48.94,0:07:50.90,Default,,0,0,0,,Жоқ болды, Тодо мырза...
Dialogue: 0,0:07:53.61,0:07:54.95,Default,,0,0,0,,Көмегіңе рахмет, Асахина
Dialogue: 0,0:07:55.07,0:07:56.95,Default,,0,0,0,,Бірдеңе істеу керек, солай ма?
Dialogue: 0,0:07:57.08,0:08:00.20,Default,,0,0,0,,Уф, оның орнына не істеуім керек?
Dialogue: 0,0:08:00.62,0:08:01.54,Default,,0,0,0,,Нөлдік нұсқауларда -
Dialogue: 0,0:08:01.66,0:08:03.25,Default,,0,0,0,,Губернатор Нунеллиді ұстағанша...
Dialogue: 0,0:08:03.37,0:08:06.25,Default,,0,0,0,,Маған үкімет кеңсесінің өзіне шабуыл жасамау керектігін айтты.
Dialogue: 0,0:08:06.38,0:08:07.67,Default,,0,0,0,,Нөл, сәлем
Dialogue: 0,0:08:08.80,0:08:11.55,Default,,0,0,0,,Барлығы, бәрі соғысуда
Dialogue: 0,0:08:12.55,0:08:14.55,Default,,0,0,0,,Кез келген жағдайда қорғаңыз
Dialogue: 0,0:08:14.76,0:08:17.81,Default,,0,0,0,,Кем дегенде, біз Гластон Найтстары белгі қоюымыз керек.
Dialogue: 0,0:08:17.93,0:08:20.06,Default,,0,0,0,,Енді лорд Гилдфорд есінен танып қалды...
Dialogue: 0,0:08:20.18,0:08:22.81,Default,,0,0,0,,Жоғары мәртебелі ханшайым Корнелия қандай қызмет атқарады?
Dialogue: 0,0:08:34.57,0:08:35.70,Default,,0,0,0,,Маған жауап беріңізші, нөл.
Dialogue: 0,0:08:35.82,0:08:39.16,Default,,0,0,0,,Бұл ұрысты өзім үшін бастасам ше?
Dialogue: 0,0:08:39.28,0:08:40.49,Default,,0,0,0,,Тәкаппар болма
Dialogue: 0,0:08:40.62,0:08:44.04,Default,,0,0,0,,Сіз ата-анаңызды және Жапонияны сатып кеткен адамсыз.
Dialogue: 0,0:08:44.16,0:08:47.04,Default,,0,0,0,,Сондықтан да достыққа опасыздық бар.
Dialogue: 0,0:08:47.04,0:08:47.38,Default,,0,0,0,,Сондықтан да достығымызға опасыздық жасадым. Барлығы осы...
Dialogue: 0,0:08:47.04,0:08:47.38,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:47.38,0:08:47.50,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:47.50,0:08:48.67,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:47.50,0:08:48.67,Default,,0,0,0,,О? Иә иә
Dialogue: 0,0:08:50.75,0:08:51.42,Default,,0,0,0,,Аня
Dialogue: 0,0:08:51.80,0:08:52.63,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:08:52.76,0:08:55.18,Default,,0,0,0,,Сузаку нөлді Аняға қалдырайық.
Dialogue: 0,0:08:56.22,0:08:58.18,Default,,0,0,0,,Қалқаныңыз көтерілді ме?
Dialogue: 0,0:08:58.30,0:09:00.56,Default,,0,0,0,,Менің Старк Адрон жоғарыда ма?
Dialogue: 0,0:09:01.68,0:09:05.39,Default,,0,0,0,,Бұл қаншалықты абсолютті қорғау аймағы болса да,
Dialogue: 0,0:09:07.44,0:09:08.81,Default,,0,0,0,,Мираж Байланыс жасай алмайды
Dialogue: 0,0:09:08.94,0:09:09.69,Default,,0,0,0,,) Нөл туралы не деуге болады?
Dialogue: 0,0:09:09.82,0:09:12.94,Default,,0,0,0,,Біз алтылық рыцарымен соғысып жатқан сияқтымыз.
Dialogue: 0,0:09:13.61,0:09:15.40,Default,,0,0,0,,Хашимото командасына қандай нұсқаулар бересіз?
Dialogue: 0,0:09:15.53,0:09:17.20,Default,,0,0,0,,Сондай-ақ Куджуукури туралы ереже бар.
Dialogue: 0,0:09:17.32,0:09:18.70,Default,,0,0,0,,А-а-а
Dialogue: 0,0:09:19.16,0:09:21.04,Default,,0,0,0,,) Маған Хашимотоның байланысын беріңізші.
Dialogue: 0,0:09:21.16,0:09:23.87,Default,,0,0,0,,Сугияма: Қандай бөлімшелер нөл үшін күшейткіш ретінде әрекет ете алады?
Dialogue: 0,0:09:24.00,0:09:25.71,Default,,0,0,0,,Бұл тек Тамаки
Dialogue: 0,0:09:25.83,0:09:27.04,Default,,0,0,0,,Ах
Dialogue: 0,0:09:27.50,0:09:30.38,Default,,0,0,0,,Иә, губернатор Нанналли қазір қашу қайығында.
Dialogue: 0,0:09:30.50,0:09:33.96,Default,,0,0,0,,Gefion Disturber көтерілмейінше.
Dialogue: 0,0:09:36.01,0:09:39.89,Default,,0,0,0,,Иә, Nightmare-де сіз жаулардың нысанасына айналуыңыз мүмкін.
Dialogue: 0,0:09:40.01,0:09:42.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:43.64,0:09:45.56,Default,,0,0,0,,Карен Акацукиді жою туралы не деуге болады?
Dialogue: 0,0:09:45.68,0:09:47.44,Default,,0,0,0,,сэр Георг (Румыния)
Dialogue: 0,0:09:47.56,0:09:50.56,Default,,0,0,0,,Бірақ сіз сенімдісіз бе? Губернатор Нуналли
Dialogue: 0,0:09:50.69,0:09:54.49,Default,,0,0,0,,Әкім үшін, жарымжан өзін-өзі тану, т.б.
Dialogue: 0,0:09:54.74,0:09:55.99,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:09:56.45,0:09:57.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:00.24,0:10:01.12,Default,,0,0,0,,Сакиоко!
Dialogue: 0,0:10:01.24,0:10:02.87,Default,,0,0,0,,ағамды тірідей шағып өлтірдім?
Dialogue: 0,0:10:02.99,0:10:05.83,Default,,0,0,0,,Нуналли-саманы Роло-сама көтеріп алды.
Dialogue: 0,0:10:05.95,0:10:09.04,Default,,0,0,0,,Біз Каренге сыйлық жеткізіп жатырмыз.
Dialogue: 0,0:10:10.21,0:10:14.30,Default,,0,0,0,,Сондай-ақ, менің ойымша, Милле-саманың бұрынғы ұйымдастырушысы ...
Dialogue: 0,0:10:14.42,0:10:16.76,Default,,0,0,0,,Нұсқаулыққа ұқсайтын бірдеңе де болды.
Dialogue: 0,0:10:16.88,0:10:17.93,Default,,0,0,0,,Ааа
Dialogue: 0,0:10:18.05,0:10:19.76,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:10:19.89,0:10:21.89,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:10:25.72,0:10:29.44,Default,,0,0,0,,Біз алдыңғы шепті толығымен ұзартуға мүмкіндік жоқ, сондықтан бұл шектеу.
Dialogue: 0,0:10:31.40,0:10:34.11,Default,,0,0,0,,Икебукуро Сугамоның бұзушысы толығымен жойылды
Dialogue: 0,0:10:34.27,0:10:38.45,Default,,0,0,0,,Енді 5-ші ұрпақтағы және одан бұрынғы Nightmares да майданға оралуы мүмкін.
Dialogue: 0,0:10:38.57,0:10:41.20,Default,,0,0,0,,Үкіметтің қорғаныс жүйесі де қалпына келтіріледі.
Dialogue: 0,0:10:41.32,0:10:43.78,Default,,0,0,0,,Әскери күші жағынан кері өзгерістер болды.
Dialogue: 0,0:10:48.41,0:10:49.21,Default,,0,0,0,,Жарық
Dialogue: 0,0:10:49.33,0:10:50.17,Default,,0,0,0,,Уақыт аяқталды
Dialogue: 0,0:10:50.42,0:10:52.63,Default,,0,0,0,,Киношита: Сен губернаторды әлі таппадың ба?
Dialogue: 0,0:10:52.75,0:10:55.75,Default,,0,0,0,,Басқыншылар тобы капитан Акацуки туралы естіген жалғыз нәрсе болды.
Dialogue: 0,0:10:55.88,0:10:56.92,Default,,0,0,0,,Киношита!
Dialogue: 0,0:11:02.97,0:11:04.51,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:11:04.64,0:11:05.31,Default,,0,0,0,,Ах
Dialogue: 0,0:11:06.22,0:11:09.98,Default,,0,0,0,,Операцияларға оралу
Dialogue: 0,0:11:10.19,0:11:12.15,Default,,0,0,0,,Мен қазірдің өзінде бармын
Dialogue: 0,0:11:12.27,0:11:13.69,Default,,0,0,0,,Уф
Dialogue: 0,0:11:15.19,0:11:17.28,Default,,0,0,0,,Менің ойымша, бұл еш жерде жоқ!
Dialogue: 0,0:11:17.61,0:11:20.95,Default,,0,0,0,,Нөл қайда ұрысады, менің жақын досым?
Dialogue: 0,0:11:22.82,0:11:24.24,Default,,0,0,0,,Бар
Dialogue: 0,0:11:24.37,0:11:27.08,Default,,0,0,0,,күрсіну
Dialogue: 0,0:11:27.20,0:11:29.16,Default,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:11:31.50,0:11:33.04,Default,,0,0,0,,Мордред ше? Уф
Dialogue: 0,0:11:33.04,0:11:34.00,Default,,0,0,0,,Мордред ше? Уф
Dialogue: 0,0:11:33.04,0:11:34.00,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:37.25,0:11:39.38,Default,,0,0,0,,«Нөлдік қара көтеріліс» -
Dialogue: 0,0:11:39.51,0:11:42.26,Default,,0,0,0,,Бұл сәтсіздікке ұшыраған сияқты.
Dialogue: 0,0:11:42.38,0:11:44.68,Default,,0,0,0,,Жоқ, тағы да Қоңыр түні?
Dialogue: 0,0:11:44.93,0:11:46.31,Default,,0,0,0,,Үйретейік
Dialogue: 0,0:11:47.72,0:11:50.93,Default,,0,0,0,,Не маңызды? Яғни-
Dialogue: 0,0:11:51.10,0:11:52.10,Default,,0,0,0,,Өмір
Dialogue: 0,0:11:57.52,0:11:59.48,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:12:03.82,0:12:05.41,Default,,0,0,0,,Негізгі жүйелер бірдей ме?
Dialogue: 0,0:12:10.87,0:12:13.25,Default,,0,0,0,,Қазіргі уақытта Ноль мырзаның орналасқан жері зерттелуде.
Dialogue: 0,0:12:13.37,0:12:15.83,Default,,0,0,0,,Дос немесе дұшпанның сәйкестендіру ақпаратын тасымалдағыңыз келе ме?
Dialogue: 0,0:12:15.96,0:12:17.59,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:12:24.51,0:12:29.81,Default,,0,0,0,,Ум, Гурен Сейтен Хачи, жарай ма?
Dialogue: 0,0:12:30.97,0:12:31.89,Default,,0,0,0,,Іске қосуды растау
Dialogue: 0,0:12:32.02,0:12:33.35,Default,,0,0,0,,Іске қосу расталды
Dialogue: 0,0:12:34.06,0:12:37.56,Default,,0,0,0,,Кримсон Сортиден кейін біз бастапқы стратегиямызға ораламыз.
Dialogue: 0,0:12:37.69,0:12:40.78,Default,,0,0,0,,Иә, губернаторға қатысты мен нөлді аламын.
Dialogue: 0,0:12:40.90,0:12:42.53,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:12:43.07,0:12:43.70,Default,,0,0,0,,Гурен
Dialogue: 0,0:12:44.07,0:12:46.20,Default,,0,0,0,,Seiten Hakkyoku стилін іске қосу!
Dialogue: 0,0:12:46.32,0:12:47.78,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,0:12:55.87,0:12:57.13,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:12:57.25,0:12:57.88,Default,,0,0,0,,Ой!
Dialogue: 0,0:12:58.00,0:13:02.05,Default,,0,0,0,,Арх! Мені де кешіріңіз, әке.
Dialogue: 0,0:13:03.47,0:13:04.30,Default,,0,0,0,,Дэвид!
Dialogue: 0,0:13:06.39,0:13:09.18,Default,,0,0,0,,Бұл Акацуки болды ма? Бірақ бұл ұшақ
Dialogue: 0,0:13:12.52,0:13:14.39,Default,,0,0,0,,Қалай болса да,
Dialogue: 0,0:13:16.10,0:13:19.23,Default,,0,0,0,,Тек қаттылығы бар Nightmare жақтауы және т.б
Dialogue: 0,0:13:19.48,0:13:21.78,Default,,0,0,0,,Валькири отряды, мені ешқашан жіберме
Dialogue: 0,0:13:21.90,0:13:23.15,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:13:23.53,0:13:26.53,Default,,0,0,0,,Жоқ, Мордред кезінде тұтынылатын энергия
Dialogue: 0,0:13:26.66,0:13:28.41,Default,,0,0,0,,Нөл Сіз мені ести аласыз ба? Нөл
Dialogue: 0,0:13:28.53,0:13:30.28,Default,,0,0,0,,Біздің күшейткіштерге не болды?
Dialogue: 0,0:13:30.41,0:13:31.54,Default,,0,0,0,,Көп ұзамай Тамаки-сан
Dialogue: 0,0:13:31.66,0:13:33.87,Default,,0,0,0,,Тынық мұхитында жаудың көлеңкелері бар.
Dialogue: 0,0:13:34.00,0:13:35.12,Default,,0,0,0,,Бұған не болды!
Dialogue: 0,0:13:35.25,0:13:36.62,Default,,0,0,0,,Нөл бұл менмін
Dialogue: 0,0:13:36.75,0:13:39.79,Default,,0,0,0,,Жаудың көлеңкесінің шынайы тұлғасы Британ императорының флагманы сияқты.
Dialogue: 0,0:13:39.92,0:13:40.59,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:13:41.13,0:13:43.34,Default,,0,0,0,,Ол да 11-ауданда ма?
Dialogue: 0,0:13:46.05,0:13:49.01,Default,,0,0,0,,Жоқ, ұлы мәртебелі ұрыс алаңына келе алмайды.
Dialogue: 0,0:13:49.51,0:13:51.22,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,0:13:51.35,0:13:55.56,Default,,0,0,0,,Бүгінгі күн сіз үшін маңызды деп ойлайсыз ба?
Dialogue: 0,0:13:55.68,0:13:56.81,Default,,0,0,0,,Ол
Dialogue: 0,0:13:58.19,0:13:59.73,Default,,0,0,0,,Нөлді жіберіңіз!
Dialogue: 0,0:13:59.86,0:14:03.69,Default,,0,0,0,,Темера - Нөлдің ең жақын досы, ал Шиничиро Тамаки - оның қарсыласы...
Dialogue: 0,0:14:03.82,0:14:04.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:04.86,0:14:07.70,Default,,0,0,0,,Қарғыс атсын! Неге мен әрқашан?
Dialogue: 0,0:14:07.86,0:14:08.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:08.61,0:14:09.74,Default,,0,0,0,,Қазір
Dialogue: 0,0:14:09.87,0:14:10.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:10.78,0:14:12.49,Default,,0,0,0,,Мен сені күттім, Нөл.
Dialogue: 0,0:14:12.62,0:14:15.04,Default,,0,0,0,,Шабуыл жасау кезінде қалқан қоюға болмайды.
Dialogue: 0,0:14:15.16,0:14:18.75,Default,,0,0,0,,Кел, өзің үшін маңызды нәрсені шашып жібер.
Dialogue: 0,0:14:20.25,0:14:22.42,Default,,0,0,0,,Бұл позицияда...
Dialogue: 0,0:14:22.54,0:14:23.21,Default,,0,0,0,,Нуннал!
Dialogue: 0,0:14:23.96,0:14:24.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.88,0:14:29.30,Default,,0,0,0,,Не? Сіз соққы алдыңыз ба?
Dialogue: 0,0:14:29.43,0:14:30.18,Default,,0,0,0,,Қиын!
Dialogue: 0,0:14:36.31,0:14:39.23,Default,,0,0,0,,Сәлем, Британиядан келген вампир.
Dialogue: 0,0:14:39.35,0:14:40.27,Default,,0,0,0,,Хооо
Dialogue: 0,0:14:40.40,0:14:41.94,Default,,0,0,0,,Карен?
Dialogue: 0,0:14:42.31,0:14:44.98,Default,,0,0,0,,Нөлдік гвардия капитаны Карен Акацуки
Dialogue: 0,0:14:45.11,0:14:47.90,Default,,0,0,0,,Жаңа ғана майданға оралдым.
Dialogue: 0,0:14:48.15,0:14:50.70,Default,,0,0,0,,Ұры! менің
Dialogue: 0,0:14:50.82,0:14:54.03,Default,,0,0,0,,Жоқ, мен де оны жақсартып жатырмын.
Dialogue: 0,0:14:54.16,0:14:57.54,Default,,0,0,0,,Иә, дұрыс айтасыз. Жоқ, бұл сіз айтып тұрған жоқсыз.
Dialogue: 0,0:14:57.66,0:14:59.37,Default,,0,0,0,,Осыны игере алатын құрылғы болса...
Dialogue: 0,0:14:59.50,0:15:02.71,Default,,0,0,0,,Егер сіз мініп жүрсеңіз, тіпті 60 пайыз қуатта болса да.
Dialogue: 0,0:15:02.83,0:15:07.34,Default,,0,0,0,,Граф пудинг және бұл Сесилдің энергетикалық қанаты ма?
Dialogue: 0,0:15:07.46,0:15:09.67,Default,,0,0,0,,Олар менің Гуренімді рұқсатсыз алып кетті.
Dialogue: 0,0:15:09.80,0:15:12.84,Default,,0,0,0,,Бірақ қазір Карен қайтып келді.
Dialogue: 0,0:15:12.97,0:15:14.47,Default,,0,0,0,,Әскери күштер дайын
Dialogue: 0,0:15:16.93,0:15:19.43,Default,,0,0,0,,Лорд Брэдлиге Гуренді жоюға рұқсат берілді.
Dialogue: 0,0:15:19.56,0:15:23.27,Default,,0,0,0,,Маңызды емес, сіз ұрыс даласында болсаңыз, оны өлтіріңіз.
Dialogue: 0,0:15:31.82,0:15:33.03,Default,,0,0,0,,Жоқ, мырза—
Dialogue: 0,0:15:39.00,0:15:40.08,Default,,0,0,0,,Он бір
Dialogue: 0,0:15:40.21,0:15:42.50,Default,,0,0,0,,Сіз ұрыс даласы туралы шындықты білесіз бе?
Dialogue: 0,0:15:43.13,0:15:45.13,Default,,0,0,0,,Күнделікті өмірде біреуді өлтіру қылмыс, бірақ...
Dialogue: 0,0:15:45.25,0:15:48.67,Default,,0,0,0,,Ұрыс даласында сіз өлтірген адам саны үшін батырға айналасыз.
Dialogue: 0,0:15:48.80,0:15:53.01,Default,,0,0,0,,Хмм, демек британдық вампир батыр болғысы келеді ме?
Dialogue: 0,0:15:53.14,0:15:56.10,Default,,0,0,0,,Жоқ, көпшілік алдында адамдардың маңызды нәрселері...
Dialogue: 0,0:15:56.22,0:15:59.56,Default,,0,0,0,,Біреудің өмірін қиюдың өзі керемет емес пе?
Dialogue: 0,0:15:59.89,0:16:03.06,Default,,0,0,0,,Сіз аздап дөрекісіз.
Dialogue: 0,0:16:06.86,0:16:08.07,Default,,0,0,0,,Қазір
Dialogue: 0,0:16:08.19,0:16:09.15,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:16:10.69,0:16:11.74,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:16:11.86,0:16:14.03,Default,,0,0,0,,Жоқ, ол енді жабылды.
Dialogue: 0,0:16:16.95,0:16:17.99,Default,,0,0,0,,Жоқ! ? Не?
Dialogue: 0,0:16:17.99,0:16:18.91,Default,,0,0,0,,Жоқ! ? Не?
Dialogue: 0,0:16:17.99,0:16:18.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:19.62,0:16:22.58,Default,,0,0,0,,Сұрақ Сіз үшін не маңызды?
Dialogue: 0,0:16:22.87,0:16:24.12,Default,,0,0,0,,Бұл сіздің өміріңіз ғана ма?
Dialogue: 0,0:16:24.25,0:16:26.08,Default,,0,0,0,,Сен мені қорқытпақшысың ба, он бір?
Dialogue: 0,0:16:26.21,0:16:27.17,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:16:30.42,0:16:33.26,Default,,0,0,0,,Менің өмірім жойылды
Dialogue: 0,0:16:33.38,0:16:36.72,Default,,0,0,0,,Мына маймыл мұнда!
Dialogue: 0,0:16:38.35,0:16:41.31,Default,,0,0,0,,Жарайсың Карен, енді үкімет кеңсесіне қайтып барып, Нуналлиге қамқорлық жаса.
Dialogue: 0,0:16:41.43,0:16:42.43,Default,,0,0,0,,Бүгін түстен кейін мектеп әлеуметтік жиналысқа жабық болады.
Dialogue: 0,0:16:42.56,0:16:43.27,Default,,0,0,0,,Құт
Dialogue: 0,0:16:43.60,0:16:44.60,Default,,0,0,0,,Сузаку Куруруги!
Dialogue: 0,0:16:44.73,0:16:46.10,Default,,0,0,0,,Ой
Dialogue: 0,0:16:46.23,0:16:46.90,Default,,0,0,0,,Құт
Dialogue: 0,0:16:47.27,0:16:48.65,Default,,0,0,0,,Карен Докунда!
Dialogue: 0,0:16:48.77,0:16:50.23,Default,,0,0,0,,Жіберме, Созаку!
Dialogue: 0,0:16:50.36,0:16:53.03,Default,,0,0,0,,Фу алдын алды! ? адрон бластер
Dialogue: 0,0:16:53.82,0:16:56.57,Default,,0,0,0,,Карен Штадтфельдтің атынан...
Dialogue: 0,0:16:56.70,0:16:58.20,Default,,0,0,0,,Сіз Акацукиді таңдадыңыз ба?
Dialogue: 0,0:16:58.33,0:17:00.58,Default,,0,0,0,,Иә, сондықтан Джино
Dialogue: 0,0:17:00.70,0:17:04.71,Default,,0,0,0,,Майданда кездескенімізге қуану керек пе, әлде мұңайу керек пе?
Dialogue: 0,0:17:04.83,0:17:05.83,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:06.25,0:17:08.04,Default,,0,0,0,,Көңіл көтеру туралы не айтасыз?
Dialogue: 0,0:17:08.17,0:17:09.04,Default,,0,0,0,,Ах
Dialogue: 0,0:17:09.17,0:17:12.80,Default,,0,0,0,,Созаку! Каренмен елді мекенді жалғыз қалдырыңыз.
Dialogue: 0,0:17:12.96,0:17:14.30,Default,,0,0,0,,Өйткені Созаку
Dialogue: 0,0:17:14.72,0:17:16.47,Default,,0,0,0,,Кешіріңіз Джино
Dialogue: 0,0:17:16.84,0:17:19.60,Default,,0,0,0,,Менің ойымша, ол мен мұндай еркіндікке қол жеткізе алатын адам емес.
Dialogue: 0,0:17:20.31,0:17:23.14,Default,,0,0,0,,Тодо әскері жаудың негізгі лагеріне шабуыл жасады.
Dialogue: 0,0:17:23.27,0:17:25.27,Default,,0,0,0,,Нуоряа
Dialogue: 0,0:17:25.69,0:17:28.31,Default,,0,0,0,,Міне! Бұл Гарет
Dialogue: 0,0:17:30.36,0:17:32.03,Default,,0,0,0,,Күш аймағына қалқан орнатыңыз
Dialogue: 0,0:17:32.23,0:17:34.28,Default,,0,0,0,,Шнайзелдің басын ғана көздеңіз
Dialogue: 0,0:17:34.40,0:17:36.70,Default,,0,0,0,,Кесетін қоршауды орнату
Dialogue: 0,0:17:36.82,0:17:40.16,Default,,0,0,0,,Тодо мырза, мен сізге капитанның орынбасары Киношитаның куәлік деректерін жіберемін.
Dialogue: 0,0:17:40.28,0:17:41.87,Default,,0,0,0,,Осындай уақытта не болады?
Dialogue: 0,0:17:41.99,0:17:45.41,Default,,0,0,0,,Менен сұрасаң түсінерсің. Өйткені, мен Нөлге сене алмаймын.
Dialogue: 0,0:17:45.54,0:17:46.25,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:46.37,0:17:49.50,Default,,0,0,0,,Мен енді үкімет кеңсесіне кіріп, Ролоны тұтқынға аламын.
Dialogue: 0,0:17:55.34,0:17:58.09,Default,,0,0,0,,Жарылыс реакциясы кемедегі №4 А купесінде орын алды.
Dialogue: 0,0:17:58.22,0:17:59.14,Default,,0,0,0,,Ах
Dialogue: 0,0:17:59.76,0:18:02.14,Default,,0,0,0,,Бұл Чигуса ма?
Dialogue: 0,0:18:04.60,0:18:06.35,Default,,0,0,0,,Оны жақын шайқасқа шығаруға тырысу
Dialogue: 0,0:18:06.48,0:18:09.90,Default,,0,0,0,,Созаку! Сіздің қарсыласыңыз Карен емес, ол нөл!
Dialogue: 0,0:18:13.86,0:18:14.90,Default,,0,0,0,,Уф
Dialogue: 0,0:18:15.03,0:18:17.03,Default,,0,0,0,,Қашу жолы Икебукураға қарай.
Dialogue: 0,0:18:17.15,0:18:18.28,Default,,0,0,0,,Төтенше жағдайда -
Dialogue: 0,0:18:18.41,0:18:21.28,Default,,0,0,0,,Қара рыцарларды жол бойынан тазартқаннан кейін біз ұшамыз.
Dialogue: 0,0:18:22.16,0:18:24.16,Default,,0,0,0,,Нөл мырза, мен губернаторды таптым.
Dialogue: 0,0:18:24.29,0:18:25.91,Default,,0,0,0,,Жарайды, бүгінгі сабақ осымен аяқталды. (қоңырау дыбысы)
Dialogue: 0,0:18:26.04,0:18:28.21,Default,,0,0,0,,Роло Nightmare түсіргеннен кейін...
Dialogue: 0,0:18:28.33,0:18:30.25,Default,,0,0,0,,Сіз менің жолсерік боласыз деп естідім.
Dialogue: 0,0:18:30.38,0:18:32.88,Default,,0,0,0,,Жарайды, енді бізде жеңіс шарты бар.
Dialogue: 0,0:18:33.25,0:18:35.38,Default,,0,0,0,,Карен! Сузакуды бірден жеңіңіз
Dialogue: 0,0:18:35.51,0:18:37.26,Default,,0,0,0,,Сонда ешқандай кедергі болмайды.
Dialogue: 0,0:18:37.38,0:18:38.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:38.22,0:18:39.59,Default,,0,0,0,,Қашыңыз, лорд Куруруги!
Dialogue: 0,0:18:39.72,0:18:41.09,Default,,0,0,0,,Қазіргі Ланселот
Dialogue: 0,0:18:41.22,0:18:42.35,Default,,0,0,0,,Бірақ нөл!
Dialogue: 0,0:18:42.47,0:18:44.64,Default,,0,0,0,,Бұл Пак Нен Ин!
Dialogue: 0,0:18:47.56,0:18:50.98,Default,,0,0,0,,Машинаның потенциалы тым әртүрлі.
Dialogue: 0,0:18:58.07,0:19:01.95,Default,,0,0,0,,Мәртебелі, бұлай жалғаса берсе, мен лорд Брэдлидің соңынан лорд Кардиналға барамын.
Dialogue: 0,0:19:02.12,0:19:04.45,Default,,0,0,0,,Мені атып таста, Созаку, егер бұл Фрейя болса.
Dialogue: 0,0:19:04.58,0:19:08.37,Default,,0,0,0,,Жоқ, бұл жай ғана қауіп. Мен оны қолдансам ше?
Dialogue: 0,0:19:12.08,0:19:13.63,Default,,0,0,0,,Ха, мен жеңе алмаймын.
Dialogue: 0,0:19:15.17,0:19:17.01,Default,,0,0,0,,Қош бол Созаку
Dialogue: 0,0:19:17.13,0:19:17.92,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:19:18.05,0:19:19.09,Default,,0,0,0,,Га
Dialogue: 0,0:19:19.22,0:19:20.18,Default,,0,0,0,,Құрметті Нуннали!
Dialogue: 0,0:19:21.72,0:19:23.09,Default,,0,0,0,,Өлтір! Сузаку!
Dialogue: 0,0:19:23.22,0:19:26.64,Default,,0,0,0,,Фрейяны атып таста! Сіз де көмектесе аласыз!
Dialogue: 0,0:19:26.77,0:19:31.65,Default,,0,0,0,,Бірақ мен осында өлсем де,
Dialogue: 0,0:19:32.23,0:19:35.44,Default,,0,0,0,,Иә, бұл өтеу.
Dialogue: 0,0:19:35.94,0:19:40.36,Default,,0,0,0,,Менің бұл жерде қабылдаудан басқа амалым жоқ.
Dialogue: 0,0:19:42.57,0:19:43.70,Default,,0,0,0,,Тірі!
Dialogue: 0,0:19:45.08,0:19:47.99,Default,,0,0,0,,А, мен тұрамын.
Dialogue: 0,0:19:58.34,0:19:59.46,Default,,0,0,0,,Ах (Нина) Иә?
Dialogue: 0,0:19:59.92,0:20:00.88,Default,,0,0,0,,Иә
Dialogue: 0,0:20:03.26,0:20:04.89,Default,,0,0,0,,Бұл Фрейя ма?
Dialogue: 0,0:20:05.26,0:20:07.47,Default,,0,0,0,,Жабу! Барлық әскерлер шегінді!
Dialogue: 0,0:20:08.39,0:20:10.23,Default,,0,0,0,,Британ әскері неліктен шегінді?
Dialogue: 0,0:20:11.14,0:20:12.56,Default,,0,0,0,,Біздің әскер де құлады.
Dialogue: 0,0:20:12.69,0:20:14.10,Default,,0,0,0,,Асахина, сен мені естисің бе?
Dialogue: 0,0:20:14.31,0:20:16.52,Default,,0,0,0,,Мемлекеттік кеңседен кет, Асахина!
Dialogue: 0,0:20:16.73,0:20:20.61,Default,,0,0,0,,Бірдеңе дұрыс емес. Икаруганы максималды жылдамдықпен артқа итеріңіз!
Dialogue: 0,0:20:20.86,0:20:24.03,Default,,0,0,0,,Сазерленд, сен мұнда не істеп жүрсің? Бұл Фрейя!
Dialogue: 0,0:20:24.91,0:20:25.78,Default,,0,0,0,,Фрейя?
Dialogue: 0,0:20:26.16,0:20:28.66,Default,,0,0,0,,Әйтеуір, Созаку осылай деді.
Dialogue: 0,0:20:28.79,0:20:31.71,Default,,0,0,0,,Әй, Нунелли! !
Dialogue: 0,0:20:38.00,0:20:39.55,Default,,0,0,0,,Ха ха
Dialogue: 0,0:20:39.75,0:20:42.13,Default,,0,0,0,,Тодо мырза, мен сіз үшінмін.
Dialogue: 0,0:20:42.26,0:20:44.51,Default,,0,0,0,,Неліктен Фрейя мұнда?
Dialogue: 0,0:20:49.81,0:20:51.64,Default,,0,0,0,,Ханшайым, қашыңыз!
Dialogue: 0,0:20:51.77,0:20:53.39,Default,,0,0,0,,Ханшайым! !
Dialogue: 0,0:20:56.52,0:20:57.36,Default,,0,0,0,,Га
Dialogue: 0,0:20:57.69,0:21:01.03,Default,,0,0,0,,Ханшайым, өмір сүр! Тікелей...
Dialogue: 0,0:21:03.32,0:21:04.28,Default,,0,0,0,,Ах
Dialogue: 0,0:21:07.74,0:21:11.41,Default,,0,0,0,,Кяах! уф уф
Dialogue: 0,0:21:17.88,0:21:19.25,Default,,0,0,0,,Лоло
Dialogue: 0,0:21:19.38,0:21:20.84,Default,,0,0,0,,Иә, аға.
Dialogue: 0,0:21:22.09,0:21:24.38,Default,,0,0,0,,Маған Нуннеллимен сөйлесуге рұқсат бере аласыз ба?
Dialogue: 0,0:21:24.51,0:21:26.43,Default,,0,0,0,,Мені атыммен атап тұрсың ба?
Dialogue: 0,0:21:26.55,0:21:28.72,Default,,0,0,0,,Мен Сакиокоға қосыла алмаймын.
Dialogue: 0,0:21:29.47,0:21:33.39,Default,,0,0,0,,Сол ағамыз уақытында үлгермей қалды.
Dialogue: 0,0:21:33.52,0:21:35.77,Default,,0,0,0,,Нунелли осы жарықта
Dialogue: 0,0:21:35.89,0:21:38.19,Default,,0,0,0,,Менің сұрайтыным бұл емес.
Dialogue: 0,0:21:38.65,0:21:40.77,Default,,0,0,0,,Мен жай ғана Нуналлимен сөйлескім келеді.
Dialogue: 0,0:21:40.90,0:21:43.28,Default,,0,0,0,,Бірақ Нуналли қайтыс болды.
Dialogue: 0,0:21:43.57,0:21:44.86,Default,,0,0,0,,Ах
Dialogue: 0,0:21:44.99,0:21:46.11,Default,,0,0,0,,Ол өлді, аға.
Dialogue: 0,0:21:46.24,0:21:47.20,Default,,0,0,0,,Өтірік айтпа!
Dialogue: 0,0:21:47.32,0:21:48.53,Default,,0,0,0,,Уф
Dialogue: 0,0:21:49.07,0:21:50.87,Default,,0,0,0,,Сәлем Роло
Dialogue: 0,0:21:51.87,0:21:54.29,Default,,0,0,0,,Аз ғана болса жеткілікті
Dialogue: 0,0:21:55.16,0:21:59.00,Default,,0,0,0,,Маған Нуналлимен сөйлесуге рұқсат етіңіз.
Dialogue: 0,0:22:03.30,0:22:06.88,Default,,0,0,0,,♪～
Dialogue: 0,0:22:07.01,0:22:10.43,Default,,0,0,0,,♪Дүние жын, әділдік деген не?
Dialogue: 0,0:22:10.55,0:22:14.39,Default,,0,0,0,,♪Сұрамай тұрып, қарсылық таныт, жамандық гүлі
Dialogue: 0,0:22:14.52,0:22:17.81,Default,,0,0,0,,♪Екіжүзділіктің арманшыл көздерін бақылаңыз
Dialogue: 0,0:22:17.94,0:22:21.94,Default,,0,0,0,,♪Өмір мен зұлымдықтың арасы жоқ.
Dialogue: 0,0:22:25.36,0:22:28.86,Default,,0,0,0,,♪Жарық ұрық сияқты жоғалады
Dialogue: 0,0:22:28.99,0:22:32.83,Default,,0,0,0,,♪Ұйқыдағы қараңғылық құрсағын
Dialogue: 0,0:22:32.95,0:22:36.29,Default,,0,0,0,,♪Жалғыздық сүйкімді
Dialogue: 0,0:22:36.41,0:22:40.00,Default,,0,0,0,,♪Ол сенің жалғыз одақтасың болады
Dialogue: 0,0:22:40.12,0:22:43.67,Default,,0,0,0,,♪Бәрі қанға боялған
Dialogue: 0,0:22:43.80,0:22:47.59,Default,,0,0,0,,♪ Осы дәуірде дүниеге келген
Dialogue: 0,0:22:47.72,0:22:54.51,Default,,0,0,0,,♪Таңдаулы ханзадалар, шайқас – береке
Dialogue: 0,0:22:54.85,0:22:59.35,Default,,0,0,0,,♪Ах, мен сұлумын, бәрін білемін.
Dialogue: 0,0:22:59.48,0:23:03.06,Default,,0,0,0,,♪Сүйікті ана сені дүниеге әкеледі
Dialogue: 0,0:23:03.19,0:23:05.82,Default,,0,0,0,,♪Бұл сүт немен қоректенеді?
Dialogue: 0,0:23:05.94,0:23:09.61,Default,,0,0,0,,♪Тозақтағы бауырлар
Dialogue: 0,0:23:10.78,0:23:14.08,Default,,0,0,0,,♪Аянның белгісі Ақиқат дегеніміз не?
Dialogue: 0,0:23:14.20,0:23:18.08,Default,,0,0,0,,♪Белгісіз және көмілген, жасырылған тұқымдар
Dialogue: 0,0:23:18.20,0:23:21.54,Default,,0,0,0,,♪Қос жүзді қылыш, жүзді суырып алғаныңызға қаратыңыз
Dialogue: 0,0:23:21.67,0:23:25.25,Default,,0,0,0,,♪Қорғау керек нәрсеге ғана сеніңіз
Dialogue: 0,0:23:25.38,0:23:32.39,Default,,0,0,0,,♪Өзіңіз қандай болсаңыз, солай болыңыз.
Dialogue: 0,0:23:36.81,0:23:42.81,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.31,0:23:50.31,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory