Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:57.52,0:00:59.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:00:59.86,0:01:01.86,Default,,0000,0000,0000,,Ахаха.
Dialogue: 0,0:01:03.80,0:01:09.14,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,0:01:09.14,0:01:12.81,Default,,0000,0000,0000,,Уау! Ол басталды!
Dialogue: 0,0:01:12.81,0:01:17.64,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,0:01:17.64,0:01:19.98,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:01:19.98,0:01:29.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:29.99,0:01:31.99,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:01:31.99,0:01:35.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:31.99,0:01:35.50,Default,,0000,0000,0000,,That's very correct.
Dialogue: 0,0:01:35.50,0:01:38.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:01:35.50,0:01:38.33,Default,,0000,0000,0000,,➡
Dialogue: 0,0:01:38.33,0:01:41.17,Default,,0000,0000,0000,,Бұл тамаша!
Dialogue: 0,0:01:38.33,0:01:41.17,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:01:41.17,0:01:44.84,Default,,0000,0000,0000,,～
Dialogue: 0,0:01:44.84,0:01:49.64,Default,,0000,0000,0000,,Өйткені, саке отшашумен бірге жүреді...
Dialogue: 0,0:01:44.84,0:01:49.64,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:01:51.68,0:01:53.85,Default,,0000,0000,0000,,Уақыт келді ме?
Dialogue: 0,0:01:53.85,0:01:57.85,Default,,0000,0000,0000,,Жақсы ату.
Dialogue: 0,0:01:57.85,0:01:59.95,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:01:59.95,0:02:01.96,Default,,0000,0000,0000,,～
Dialogue: 0,0:02:01.96,0:02:04.79,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:04.79,0:02:08.50,Default,,0000,0000,0000,,Бұл жерде!
Dialogue: 0,0:02:15.47,0:02:17.47,Default,,0000,0000,0000,,～…
Dialogue: 0,0:02:19.81,0:02:21.98,Default,,0000,0000,0000,,～
Dialogue: 0,0:02:21.98,0:02:26.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:02:21.98,0:02:26.15,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:26.15,0:02:28.82,Default,,0000,0000,0000,,The chicken is perfectly cooked.
Dialogue: 0,0:02:28.82,0:02:31.32,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:02:28.82,0:02:31.32,Default,,0000,0000,0000,,Дәмді.
Dialogue: 0,0:02:34.49,0:02:36.49,Default,,0000,0000,0000,,Болады!
Dialogue: 0,0:02:34.49,0:02:36.49,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,0:02:36.49,0:02:39.99,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,0:02:39.99,0:02:42.16,Default,,0000,0000,0000,,…
Dialogue: 0,0:02:42.16,0:02:44.16,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:02:44.16,0:02:48.33,Default,,0000,0000,0000,,(отшашулардың дыбысы)
Dialogue: 0,0:02:48.33,0:02:52.34,Default,,0000,0000,0000,,Хмм! Ммм!
Dialogue: 0,0:02:52.34,0:02:55.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:52.34,0:02:55.01,Default,,0000,0000,0000,,…
Dialogue: 0,0:02:55.01,0:02:57.01,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:02:57.01,0:03:00.81,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:57.01,0:03:00.81,Default,,0000,0000,0000,,～
Dialogue: 0,0:03:23.80,0:03:26.14,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:26.14,0:03:31.31,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:26.14,0:03:31.31,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:31.31,0:03:34.81,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:31.31,0:03:34.81,Default,,0000,0000,0000,,Біздің лагерьде тұру тәсілі де өзгеруі мүмкін.
Dialogue: 0,0:03:34.81,0:03:37.65,Default,,0000,0000,0000,,I want a wood stove.
Dialogue: 0,0:03:37.65,0:03:40.49,Default,,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:03:37.65,0:03:40.49,Default,,0000,0000,0000,,Сіз кез келген уақытта лагерь жасай аласыз, солай ма?
Dialogue: 0,0:03:40.49,0:03:43.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:40.49,0:03:43.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:43.32,0:03:45.33,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:03:47.33,0:03:51.50,Default,,0000,0000,0000,,Мен лицензияны алып, әртүрлі жерлерге бардым.
Dialogue: 0,0:03:47.33,0:03:51.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:51.50,0:03:54.83,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:51.50,0:03:54.83,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:54.83,0:03:56.84,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:03:56.84,0:03:59.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:59.01,0:04:02.61,Default,,0000,0000,0000,,➡
Dialogue: 0,0:04:02.61,0:04:04.61,Default,,0000,0000,0000,,Шетелге кемпингке барғыңыз келе ме?
Dialogue: 0,0:04:04.61,0:04:08.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:04.61,0:04:08.31,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:10.45,0:04:13.95,Default,,0000,0000,0000,,Ересек адам ретінде әртүрлі лагерьлер➡
Dialogue: 0,0:04:13.95,0:04:16.26,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:20.96,0:04:23.96,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:21.45,0:06:25.12,Default,,0000,0000,0000,,（）
Dialogue: 0,0:06:25.12,0:06:41.30,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:41.30,0:06:44.30,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:50.81,0:06:53.81,Default,,0000,0000,0000,,күрсіну…. Жақсы.
Dialogue: 0,0:06:53.81,0:06:55.82,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:55.82,0:06:59.92,Default,,0000,0000,0000,,Soft. Қайырлы таң.
Dialogue: 0,0:06:59.92,0:07:02.09,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:07:02.09,0:07:06.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:02.09,0:07:06.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:06.09,0:07:08.43,Default,,0000,0000,0000,,～
Dialogue: 0,0:07:08.43,0:07:11.43,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:11.43,0:07:16.44,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:11.43,0:07:16.44,Default,,0000,0000,0000,,…
Dialogue: 0,0:07:16.44,0:07:19.61,Default,,0000,0000,0000,,Дәлірек айтқанда
Dialogue: 0,0:07:16.44,0:07:19.61,Default,,0000,0000,0000,,Шима-чан жылдам.
Dialogue: 0,0:07:19.61,0:07:23.78,Default,,0000,0000,0000,,Бұл L-дің ізбасарын тәрбиелеуге арналған мекеме сияқты.
Dialogue: 0,0:07:19.61,0:07:23.78,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:23.78,0:07:25.78,Default,,0000,0000,0000,,～
Dialogue: 0,0:07:25.78,0:07:27.78,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:27.78,0:07:31.78,Default,,0000,0000,0000,,…
Dialogue: 0,0:07:31.78,0:07:36.46,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:31.78,0:07:36.46,Default,,0000,0000,0000,,Иә. рақмет сізге.
Dialogue: 0,0:07:36.46,0:07:40.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:36.46,0:07:40.46,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:40.46,0:07:42.63,Default,,0000,0000,0000,,Басқасын дайындаған жоқсың ба?
Dialogue: 0,0:07:42.63,0:07:46.63,Default,,0000,0000,0000,,…
Dialogue: 0,0:07:42.63,0:07:46.63,Default,,0000,0000,0000,,...
Dialogue: 0,0:07:48.63,0:07:53.14,Default,,0000,0000,0000,,（）
Dialogue: 0,0:07:53.14,0:07:56.14,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:07:58.14,0:08:00.08,Default,,0000,0000,0000,,➡
Dialogue: 0,0:08:00.08,0:08:03.58,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:00.08,0:08:03.58,Default,,0000,0000,0000,,Мен оны көрсеткім келеді.
Dialogue: 0,0:08:03.58,0:08:06.92,Default,,0000,0000,0000,,«Кокура тост тәттілерінің жаңа сезімі» т.б.➡
Dialogue: 0,0:08:06.92,0:08:08.92,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:06.92,0:08:08.92,Default,,0000,0000,0000,,➡
Dialogue: 0,0:08:08.92,0:08:12.59,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:08.92,0:08:12.59,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:12.59,0:08:18.26,Default,,0000,0000,0000,,Сұхбат негізінен Мейеки Сакае аймағында жүргізілді.
Dialogue: 0,0:08:12.59,0:08:18.26,Default,,0000,0000,0000,,Кафелерге барудан ләззат алатын карта➡
Dialogue: 0,0:08:18.26,0:08:20.27,Default,,0000,0000,0000,,…
Dialogue: 0,0:08:18.26,0:08:20.27,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:29.78,0:08:32.78,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:08:37.28,0:08:40.79,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:37.28,0:08:40.79,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:40.79,0:08:45.12,Default,,0000,0000,0000,,２
Dialogue: 0,0:08:40.79,0:08:45.12,Default,,0000,0000,0000,,Мен сізге дәлелді жіберемін. Рақмет сізге.
Dialogue: 0,0:08:45.12,0:08:47.13,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:09:00.74,0:09:03.04,Default,,0000,0000,0000,,📱
Dialogue: 0,0:09:09.58,0:09:23.26,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:23.26,0:09:25.77,Default,,0000,0000,0000,,📱
Dialogue: 0,0:09:30.44,0:09:32.61,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:09:32.61,0:10:23.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:23.99,0:10:27.29,Default,,0000,0000,0000,,Okay, done!
Dialogue: 0,0:10:35.33,0:10:39.17,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:35.33,0:10:39.17,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:10:39.17,0:10:41.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:41.17,0:10:45.38,Default,,0000,0000,0000,,Иә, бұл жақсы емес.
Dialogue: 0,0:10:41.17,0:10:45.38,Default,,0000,0000,0000,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:10:48.01,0:10:50.52,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:10:48.01,0:10:50.52,Default,,0000,0000,0000,,Ертеңгі ауысым демалыс па?
Dialogue: 0,0:10:50.52,0:10:52.52,Default,,0000,0000,0000,,Сен тағы тауға барасың ба?
Dialogue: 0,0:10:52.52,0:10:55.35,Default,,0000,0000,0000,,I was thinking of going back to my parents' house.
Dialogue: 0,0:10:55.35,0:10:57.86,Default,,0000,0000,0000,,My sister is coming back for the first time in a while.
Dialogue: 0,0:10:57.86,0:10:59.86,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:10:59.86,0:11:01.96,Default,,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:11:01.96,0:11:04.46,Default,,0000,0000,0000,,Мен от жағу орны іздеп жүрмін.
Dialogue: 0,0:11:04.46,0:11:08.63,Default,,0000,0000,0000,,Жазғыдан басқа лагерьлер
Dialogue: 0,0:11:04.46,0:11:08.63,Default,,0000,0000,0000,,Мен байқап көрейін деп ойладым.
Dialogue: 0,0:11:08.63,0:11:13.14,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:11:08.63,0:11:13.14,Default,,0000,0000,0000,,The upcoming season is also going to be fun.
Dialogue: 0,0:11:13.14,0:11:16.81,Default,,0000,0000,0000,,Бұл от жағу орны
Dialogue: 0,0:11:13.14,0:11:16.81,Default,,0000,0000,0000,,Compatible with various cooking methods➡
Dialogue: 0,0:11:16.81,0:11:18.98,Default,,0000,0000,0000,,Бұл функционалдық модель.
Dialogue: 0,0:11:18.98,0:11:23.32,Default,,0000,0000,0000,,Отқа ас пісірген жақсы.
Dialogue: 0,0:11:18.98,0:11:23.32,Default,,0000,0000,0000,,А, бірақ...
Dialogue: 0,0:11:23.32,0:11:26.32,Default,,0000,0000,0000,,Бұл көп...
Dialogue: 0,0:11:26.32,0:11:29.32,Default,,0000,0000,0000,,Суық мезгілде
Dialogue: 0,0:11:26.32,0:11:29.32,Default,,0000,0000,0000,,Сіз лагерьге сонша көп барасыз ба?
Dialogue: 0,0:11:29.32,0:11:31.49,Default,,0000,0000,0000,,Бұл бала әлі кішкентай.
Dialogue: 0,0:11:31.49,0:11:34.16,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:31.49,0:11:34.16,Default,,0000,0000,0000,,Бұл рас, бірақ...
Dialogue: 0,0:11:34.16,0:11:37.33,Default,,0000,0000,0000,,Мм...жазғы лагерьге баратын болсаңыз➡
Dialogue: 0,0:11:37.33,0:11:39.83,Default,,0000,0000,0000,,Құралдардың бір жиынтығы
Dialogue: 0,0:11:37.33,0:11:39.83,Default,,0000,0000,0000,,Бізде бәрі бар, солай ма?
Dialogue: 0,0:11:39.83,0:11:42.50,Default,,0000,0000,0000,,А, иә.
Dialogue: 0,0:11:39.83,0:11:42.50,Default,,0000,0000,0000,,Егер солай болса➡
Dialogue: 0,0:11:42.50,0:11:45.17,Default,,0000,0000,0000,,Алауда ас әзірлеу
Dialogue: 0,0:11:42.50,0:11:45.17,Default,,0000,0000,0000,,Әзірше бұл туралы ойламаңыз➡
Dialogue: 0,0:11:45.17,0:11:48.84,Default,,0000,0000,0000,,Қарапайым өрт ошағы ше?
Dialogue: 0,0:11:45.17,0:11:48.84,Default,,0000,0000,0000,,Содан кейін➡
Dialogue: 0,0:11:48.84,0:11:51.18,Default,,0000,0000,0000,,Қолжетімді бағалар
Dialogue: 0,0:11:48.84,0:11:51.18,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:51.18,0:11:56.52,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:51.18,0:11:56.52,Default,,0000,0000,0000,,. Ал, бұл өнім ...
Dialogue: 0,0:11:56.52,0:11:59.52,Default,,0000,0000,0000,,Аа, үйде емес, ана жақта➡
Dialogue: 0,0:11:59.52,0:12:02.46,Default,,0000,0000,0000,,It's sold at the store diagonally in front of you.
Dialogue: 0,0:12:02.46,0:12:05.29,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:12:05.29,0:12:07.63,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:12:07.63,0:12:10.46,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:12:10.46,0:12:13.13,Default,,0000,0000,0000,,Менің өнімдерімді де сатыңызшы.
Dialogue: 0,0:12:13.13,0:12:16.30,Default,,0000,0000,0000,,Эхехе... Кешіріңіз, менеджер.
Dialogue: 0,0:12:16.30,0:12:18.97,Default,,0000,0000,0000,,Ағымдағы тұтынушы➡
Dialogue: 0,0:12:18.97,0:12:21.97,Default,,0000,0000,0000,,Тағы бір күні
Dialogue: 0,0:12:18.97,0:12:21.97,Default,,0000,0000,0000,,Менің үйіме тоқтайсың деп ойлаймын.
Dialogue: 0,0:12:23.98,0:12:26.31,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:12:23.98,0:12:26.31,Default,,0000,0000,0000,,Бұл емес пе?
Dialogue: 0,0:12:26.31,0:12:29.82,Default,,0000,0000,0000,,Сол жерде көрсетілген.
Dialogue: 0,0:12:29.82,0:12:34.15,Default,,0000,0000,0000,,Иә. Газ... фонар?
Dialogue: 0,0:12:34.15,0:12:36.82,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:12:34.15,0:12:36.82,Default,,0000,0000,0000,,А, бұл өте қымбат.
Dialogue: 0,0:12:36.82,0:12:38.82,Default,,0000,0000,0000,,Бұл кішкентай және сүйкімді емес пе?
Dialogue: 0,0:12:38.82,0:12:41.49,Default,,0000,0000,0000,,Бірінші орында Текаса
Dialogue: 0,0:12:38.82,0:12:41.49,Default,,0000,0000,0000,,Сіз лагерьге бармайсыз, солай ма?
Dialogue: 0,0:12:41.49,0:12:44.83,Default,,0000,0000,0000,,Ой... Жақсы.
Dialogue: 0,0:12:44.83,0:12:47.67,Default,,0000,0000,0000,,Сіз от жағыңыз келе ме?
Dialogue: 0,0:12:47.67,0:12:50.57,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:57.01,0:12:59.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:06.79,0:13:08.79,Default,,0000,0000,0000,,Әдемі.
Dialogue: 0,0:13:11.79,0:13:14.63,Default,,0000,0000,0000,,Бұл өте сүйкімді.
Dialogue: 0,0:13:11.79,0:13:14.63,Default,,0000,0000,0000,,Мүмкін тынышталып қалар.
Dialogue: 0,0:13:14.63,0:13:16.63,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:13:14.63,0:13:16.63,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:13:18.63,0:13:20.63,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:30.64,0:13:33.65,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:13:40.15,0:13:42.15,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:13:44.99,0:13:49.33,Default,,0000,0000,0000,,《Сенбі және жексенбі күндері демалыс болмағаныма көп болды...
Dialogue: 0,0:13:49.33,0:13:51.53,Default,,0000,0000,0000,,Ең жақсы》
Dialogue: 0,0:13:56.00,0:13:58.50,Default,,0000,0000,0000,,《Мен Миеге өткен айда бардым➡
Dialogue: 0,0:13:58.50,0:14:01.31,Default,,0000,0000,0000,,Келесі жолы ішкі жерлерге шабуыл жасап көруіміз керек пе?
Dialogue: 0,0:14:13.29,0:14:15.49,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:14:20.79,0:14:23.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:40.15,0:14:43.98,Default,,0000,0000,0000,,Куха~.
Dialogue: 0,0:14:40.15,0:14:43.98,Default,,0000,0000,0000,,Жоқ, шынында да, біраз уақыт өтті.
Dialogue: 0,0:14:43.98,0:14:46.65,Default,,0000,0000,0000,,Соңғы рет қашан кездестік?
Dialogue: 0,0:14:46.65,0:14:49.32,Default,,0000,0000,0000,,Сіз үш жыл бұрын кемпингке барғаныңызды айттыңыз.
Dialogue: 0,0:14:49.32,0:14:52.66,Default,,0000,0000,0000,,Бұл туралы бұрын айтқан жоқпыз ба?
Dialogue: 0,0:14:52.66,0:14:56.50,Default,,0000,0000,0000,,Нагоя тауық қанаттары
Dialogue: 0,0:14:52.66,0:14:56.50,Default,,0000,0000,0000,,Өте жақсы!
Dialogue: 0,0:14:56.50,0:14:59.50,Default,,0000,0000,0000,,Бұл шынымен мас болу қиын жол.
Dialogue: 0,0:14:56.50,0:14:59.50,Default,,0000,0000,0000,,Чиаки….
Dialogue: 0,0:14:59.50,0:15:02.80,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:14:59.50,0:15:02.80,Default,,0000,0000,0000,,Маған ауыстыруыңызды өтінемін!
Dialogue: 0,0:15:07.77,0:15:12.11,Default,,0000,0000,0000,,Бәрі де солай ғой.
Dialogue: 0,0:15:07.77,0:15:12.11,Default,,0000,0000,0000,,Кесте сәйкес келмеді.
Dialogue: 0,0:15:12.11,0:15:15.11,Default,,0000,0000,0000,,А, бірақ
Dialogue: 0,0:15:12.11,0:15:15.11,Default,,0000,0000,0000,,Мен Надешиконың суретін қарап отырмын.
Dialogue: 0,0:15:15.11,0:15:17.12,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:23.12,0:15:25.62,Default,,0000,0000,0000,,Сіз бұрынғыдай сау көрінесіз.
Dialogue: 0,0:15:25.62,0:15:27.96,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:15:27.96,0:15:31.30,Default,,0000,0000,0000,,-де? Сіз соңғы уақытта лагерьде болдыңыз ба?
Dialogue: 0,0:15:31.30,0:15:34.97,Default,,0000,0000,0000,,Хмм, мен ауысқаннан бері.
Dialogue: 0,0:15:31.30,0:15:34.97,Default,,0000,0000,0000,,Өте...
Dialogue: 0,0:15:34.97,0:15:37.14,Default,,0000,0000,0000,,А, редакция бөлімі? Сіз қалай ойлайсыз?
Dialogue: 0,0:15:37.14,0:15:41.64,Default,,0000,0000,0000,,Әйтеуір.
Dialogue: 0,0:15:37.14,0:15:41.64,Default,,0000,0000,0000,,Бұл оқиға компаниясы туралы не айтасыз?
Dialogue: 0,0:15:41.64,0:15:46.05,Default,,0000,0000,0000,,Мен? мен...
Dialogue: 0,0:15:51.15,0:15:53.32,Default,,0000,0000,0000,,Мен кеттім!
Dialogue: 0,0:15:51.15,0:15:53.32,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:15:53.32,0:15:56.82,Default,,0000,0000,0000,,Һмпф
Dialogue: 0,0:15:53.32,0:15:56.82,Default,,0000,0000,0000,,Мен біраз уақыт бұрын жұмысымды ауыстырдым және қазір Яманашидемін.
Dialogue: 0,0:15:56.82,0:15:58.82,Default,,0000,0000,0000,,Қайтып келдіңіз бе?
Dialogue: 0,0:15:58.82,0:16:03.60,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:15:58.82,0:16:03.60,Default,,0000,0000,0000,,Бұл Яманаши Туризмді насихаттау ұйымынан келген Огаки.
Dialogue: 0,0:16:03.60,0:16:07.43,Default,,0000,0000,0000,,«Туризмді насихаттау»...?
Dialogue: 0,0:16:03.60,0:16:07.43,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:07.43,0:16:10.44,Default,,0000,0000,0000,,Яманашиді қызықтырақ етіңіз!
Dialogue: 0,0:16:10.44,0:16:13.94,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:16:13.94,0:16:17.44,Default,,0000,0000,0000,,Өнім жәрмеңкесінде киген кигуруми.
Dialogue: 0,0:16:13.94,0:16:17.44,Default,,0000,0000,0000,,Бұл саз балшықтан жасалған мүсінше кейіпкері.
Dialogue: 0,0:16:17.44,0:16:19.61,Default,,0000,0000,0000,,Менің қазір істеп жатқан ең бастысы –➡
Dialogue: 0,0:16:19.61,0:16:23.28,Default,,0000,0000,0000,,Биік және аласа аумақтарды қайта құру жоспары.
Dialogue: 0,0:16:19.61,0:16:23.28,Default,,0000,0000,0000,,Жоғары және төмен?
Dialogue: 0,0:16:23.28,0:16:26.45,Default,,0000,0000,0000,,Around here
Dialogue: 0,0:16:23.28,0:16:26.45,Default,,0000,0000,0000,,Бірнеше жыл бұрын банкротқа ұшыраған нысан болды➡
Dialogue: 0,0:16:26.45,0:16:28.45,Default,,0000,0000,0000,,Сайт өте үлкен➡
Dialogue: 0,0:16:28.45,0:16:30.46,Default,,0000,0000,0000,,Оны қирандыға қалдыру
Dialogue: 0,0:16:28.45,0:16:30.46,Default,,0000,0000,0000,,Өйткені бұл ысырап➡
Dialogue: 0,0:16:30.46,0:16:32.62,Default,,0000,0000,0000,,Сонымен, бірдеңе жасаңыз.
Dialogue: 0,0:16:32.62,0:16:34.96,Default,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:16:32.62,0:16:34.96,Default,,0000,0000,0000,,Қызықты көрінеді➡
Dialogue: 0,0:16:34.96,0:16:39.13,Default,,0000,0000,0000,,Мен мұны істесем де
Dialogue: 0,0:16:34.96,0:16:39.13,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Сіздің айтып отырғаныңыз осы емес пе?
Dialogue: 0,0:16:39.13,0:16:43.30,Default,,0000,0000,0000,,Егер сайт соншалықты үлкен болса
Dialogue: 0,0:16:39.13,0:16:43.30,Default,,0000,0000,0000,,Оны лагерьге айналдырсақ жақсы болар еді.
Dialogue: 0,0:16:43.30,0:16:45.60,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:50.14,0:16:52.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:52.48,0:16:54.48,Default,,0000,0000,0000,,Тапсырыс беру!
Dialogue: 0,0:16:54.48,0:16:59.49,Default,,0000,0000,0000,,Шима командасы: Оқиға туралы толығырақ.
Dialogue: 0,0:16:54.48,0:16:59.49,Default,,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз!
Dialogue: 0,0:16:59.49,0:17:01.49,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:17:03.42,0:17:06.26,Default,,0000,0000,0000,,Яманашидегі Фуджикава қаласына!
Dialogue: 0,0:17:03.42,0:17:06.26,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:17:06.26,0:17:08.76,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:08.76,0:17:12.77,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:17:12.77,0:17:15.97,Default,,0000,0000,0000,,Кеттік~ Такашита!
Dialogue: 0,0:17:29.28,0:17:32.95,Default,,0000,0000,0000,,<Такашита ауданы, Фуджикава-мачи, Яманаши префектурасы.
Dialogue: 0,0:17:32.95,0:17:37.29,Default,,0000,0000,0000,,«Күншығыс ауылы» деп те аталады
Dialogue: 0,0:17:32.95,0:17:37.29,Default,,0000,0000,0000,,Қысқы күн тоқырауынан Жаңа жыл күніне дейін➡
Dialogue: 0,0:17:37.29,0:17:42.13,Default,,0000,0000,0000,,Күннің шығуы Фудзи тауының шыңымен қабаттасады
Dialogue: 0,0:17:37.29,0:17:42.13,Default,,0000,0000,0000,,Алмаз Фудзи атақты＞
Dialogue: 0,0:17:42.13,0:17:44.83,Default,,0000,0000,0000,,Әр жолы иә!
Dialogue: 0,0:17:49.13,0:17:51.30,Default,,0000,0000,0000,,Бұл шынымен де келді...
Dialogue: 0,0:17:51.30,0:17:55.31,Default,,0000,0000,0000,,Қараңдаршы, мына жерде. Сіз айтқан нысан.
Dialogue: 0,0:18:02.41,0:18:06.42,Default,,0000,0000,0000,,Бұл қираған жер.
Dialogue: 0,0:18:02.41,0:18:06.42,Default,,0000,0000,0000,,Бес жыл бұрын жабылған.
Dialogue: 0,0:18:06.42,0:18:08.42,Default,,0000,0000,0000,,Лагерь ➡
Dialogue: 0,0:18:08.42,0:18:11.42,Default,,0000,0000,0000,,Тек тазалау үшін
Dialogue: 0,0:18:08.42,0:18:11.42,Default,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:18:11.42,0:18:14.26,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:18:11.42,0:18:14.26,Default,,0000,0000,0000,,Мен мұны айтқым келген жоқ...
Dialogue: 0,0:18:14.26,0:18:17.06,Default,,0000,0000,0000,,Каа~!
Dialogue: 0,0:18:20.43,0:18:23.10,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:18:23.10,0:18:28.11,Default,,0000,0000,0000,,《Таңертең күтіңіз
Dialogue: 0,0:18:23.10,0:18:28.11,Default,,0000,0000,0000,,Үйге телефон соғудан басқа амалым жоқ.
Dialogue: 0,0:18:34.45,0:18:36.45,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:18:36.45,0:18:38.75,Default,,0000,0000,0000,,《Шабуыл~》
Dialogue: 0,0:18:55.97,0:19:00.47,Default,,0000,0000,0000,,Гааааааааааааааааааааааааааааааааааааааааааааааааа ххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххх...
Dialogue: 0,0:19:02.57,0:19:05.08,Default,,0000,0000,0000,,Қорқынышты.
Dialogue: 0,0:19:05.08,0:19:08.75,Default,,0000,0000,0000,,《Ол шынымен де тасталған.
Dialogue: 0,0:19:08.75,0:19:12.92,Default,,0000,0000,0000,,Сіз оны осындай жерде жасасаңыз да
Dialogue: 0,0:19:08.75,0:19:12.92,Default,,0000,0000,0000,,Мен оны көп қолданбаймын.
Dialogue: 0,0:19:12.92,0:19:16.76,Default,,0000,0000,0000,,Бұл өте күрделі жерде.
Dialogue: 0,0:19:16.76,0:19:20.43,Default,,0000,0000,0000,,Ол өте кең... Түзетсем жұмыс істейді деп ойлаймын.
Dialogue: 0,0:19:20.43,0:19:23.03,Default,,0000,0000,0000,,Сондай-ақ дәретхана бар》
Dialogue: 0,0:19:32.10,0:19:35.81,Default,,0000,0000,0000,,А... Баспалдақ сияқты ма?
Dialogue: 0,0:19:44.78,0:19:47.12,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:19:44.78,0:19:47.12,Default,,0000,0000,0000,,(бөренені бұзу дыбысы)
Dialogue: 0,0:19:47.12,0:19:50.02,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:19:51.96,0:19:54.06,Default,,0000,0000,0000,,《Бұл жерден кетейік》
Dialogue: 0,0:20:02.63,0:20:04.64,Default,,0000,0000,0000,,《Су бар》
Dialogue: 0,0:20:06.64,0:20:09.47,Default,,0000,0000,0000,,《Оның шығуы мүмкін емес пе?》
Dialogue: 0,0:20:09.47,0:20:11.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:11.48,0:20:13.48,Default,,0000,0000,0000,,Не? Бұл.
Dialogue: 0,0:20:18.82,0:20:23.32,Default,,0000,0000,0000,,《Бұл джунглидегі спорт залы емес...
Dialogue: 0,0:20:23.32,0:20:26.53,Default,,0000,0000,0000,,Әлі де түбі бар ма?
Dialogue: 0,0:20:36.67,0:20:39.34,Default,,0000,0000,0000,,《Жұмыс сарайы?
Dialogue: 0,0:20:39.34,0:20:44.18,Default,,0000,0000,0000,,Қолмен жасалған ба?
Dialogue: 0,0:20:39.34,0:20:44.18,Default,,0000,0000,0000,,Бұл өте қызықты ғимарат.
Dialogue: 0,0:20:44.18,0:20:55.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:55.02,0:20:58.69,Default,,0000,0000,0000,,күрсіну. Осы уакытқа дейін?
Dialogue: 0,0:20:58.69,0:21:00.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:00.79,0:21:26.49,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:26.49,0:21:28.49,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:21:30.49,0:22:17.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:17.97,0:22:21.31,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:22:21.31,0:22:23.81,Default,,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:22:23.81,0:22:27.98,Default,,0000,0000,0000,,Жұмсақ.
Dialogue: 0,0:22:23.81,0:22:27.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:27.98,0:22:33.49,Default,,0000,0000,0000,,Шөбі қираған, нысандары қираған.
Dialogue: 0,0:22:33.49,0:22:37.32,Default,,0000,0000,0000,,Лагерьге өте ыңғайлы, солай ма?
Dialogue: 0,0:22:37.32,0:22:39.99,Default,,0000,0000,0000,,Сондықтан мен...
Dialogue: 0,0:22:39.99,0:22:42.16,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:22:42.16,0:22:46.50,Default,,0000,0000,0000,,Маған да бұл жер ұнайды.
Dialogue: 0,0:22:42.16,0:22:46.50,Default,,0000,0000,0000,,Мен оны лагерьге айналдыруды ойладым.
Dialogue: 0,0:22:46.50,0:22:52.00,Default,,0000,0000,0000,,Бастықпен де сөйлесіңіз.
Dialogue: 0,0:22:46.50,0:22:52.00,Default,,0000,0000,0000,,Рұқсат әлдеқашан алынған.
Dialogue: 0,0:22:52.00,0:22:57.51,Default,,0000,0000,0000,,Мен, Токиодағы өмірім маған өте ұнады.
Dialogue: 0,0:22:52.00,0:22:57.51,Default,,0000,0000,0000,,Мен ойлаған жерде➡
Dialogue: 0,0:22:57.51,0:23:00.45,Default,,0000,0000,0000,,Менің қазіргі жұмыс орным: мені шақырды.
Dialogue: 0,0:23:00.45,0:23:03.55,Default,,0000,0000,0000,,Әңгімені естігенде көңілді көрінді.
Dialogue: 0,0:23:06.45,0:23:11.62,Default,,0000,0000,0000,,Маған бұл жер ұнайтын шығар.
Dialogue: 0,0:23:11.62,0:23:13.96,Default,,0000,0000,0000,,Бірақ мен қайтқанда➡
Dialogue: 0,0:23:13.96,0:23:17.46,Default,,0000,0000,0000,,барлық жерде
Dialogue: 0,0:23:13.96,0:23:17.46,Default,,0000,0000,0000,,Бірте-бірте жалғызсырап барамын➡
Dialogue: 0,0:23:17.46,0:23:20.63,Default,,0000,0000,0000,,Тіпті бұл жер
Dialogue: 0,0:23:17.46,0:23:20.63,Default,,0000,0000,0000,,Бастапқыда әртүрлі адамдар жиналды➡
Dialogue: 0,0:23:20.63,0:23:23.97,Default,,0000,0000,0000,,Көңілді болу үшін
Dialogue: 0,0:23:20.63,0:23:23.97,Default,,0000,0000,0000,,Жасалған болуы керек, солай ма?
Dialogue: 0,0:23:23.97,0:23:28.47,Default,,0000,0000,0000,,Бұл жағдайда, ақыр соңында
Dialogue: 0,0:23:23.97,0:23:28.47,Default,,0000,0000,0000,,Менің ойымша, біреуі болғаны жақсы болар еді.
Dialogue: 0,0:23:32.14,0:23:34.31,Default,,0000,0000,0000,,Бюджет пен жұмыс күші аз➡
Dialogue: 0,0:23:34.31,0:23:37.98,Default,,0000,0000,0000,,Қалай болғанда да, ерікті.
Dialogue: 0,0:23:34.31,0:23:37.98,Default,,0000,0000,0000,,Мен жұмысқа қабылдауды жоспарладым.
Dialogue: 0,0:23:37.98,0:23:40.32,Default,,0000,0000,0000,,Егер бірдеңе болса...
Dialogue: 0,0:23:40.32,0:23:44.16,Default,,0000,0000,0000,,Оны жасап көргіңіз келе ме? Бізбен бірге.
Dialogue: 0,0:23:44.16,0:24:03.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:03.94,0:24:06.44,Default,,0000,0000,0000,,Ойлан.
Dialogue: 0,0:24:08.45,0:24:11.28,Default,,0000,0000,0000,,Күрсін! Қарғыс атсын...!
Dialogue: 0,0:24:11.28,0:24:15.45,Default,,0000,0000,0000,,Сәлем, Шима отряды!
Dialogue: 0,0:24:11.28,0:24:15.45,Default,,0000,0000,0000,,Мен сендім!
Dialogue: 0,0:24:15.45,0:24:17.62,Default,,0000,0000,0000,,Уа, ау...
Dialogue: 0,0:24:15.45,0:24:17.62,Default,,0000,0000,0000,,хм/сағ хм/сағ….
Dialogue: 0,0:24:17.62,0:24:20.03,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:24:17.62,0:24:20.03,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:24:23.80,0:24:27.47,Default,,0000,0000,0000,,Рин-чан! Акичан!
Dialogue: 0,0:24:27.47,0:24:30.47,Default,,0000,0000,0000,,Не... Надешико?
Dialogue: 0,0:24:32.47,0:24:34.64,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:24:34.64,0:24:36.64,Default,,0000,0000,0000,,Екеуміздің кездеспегенімізге көп болды!
Dialogue: 0,0:24:36.64,0:24:39.81,Default,,0000,0000,0000,,Надешико…. Неге мұндасың?
Dialogue: 0,0:24:39.81,0:24:43.65,Default,,0000,0000,0000,,Не? Өйткені Аки-чан
Dialogue: 0,0:24:39.81,0:24:43.65,Default,,0000,0000,0000,,Ол маған осы жерде кездесуді айтты.
Dialogue: 0,0:24:43.65,0:24:45.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:58.00,0:25:00.60,Default,,0000,0000,0000,,Оны Аои мен Сайтоға да жіберді.
Dialogue: 0,0:25:00.60,0:25:02.60,Default,,0000,0000,0000,,Нахахаха….
Dialogue: 0,0:25:02.60,0:25:05.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:02.60,0:25:05.44,Default,,0000,0000,0000,,Мүмкін бұл жиынтық емес шығар?
Dialogue: 0,0:25:05.44,0:25:09.77,Default,,0000,0000,0000,,Кешіріңіз! Токиодан барлық жол.
Dialogue: 0,0:25:05.44,0:25:09.77,Default,,0000,0000,0000,,А, жоқ!
Dialogue: 0,0:25:09.77,0:25:12.28,Default,,0000,0000,0000,,Мен де кеше түннен бері
Dialogue: 0,0:25:09.77,0:25:12.28,Default,,0000,0000,0000,,Мен осында қайтып келдім.
Dialogue: 0,0:25:12.28,0:25:14.28,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:25:14.28,0:25:17.48,Default,,0000,0000,0000,,Осыдан кейін бәріміз бірге қазан ішеміз бе?
Dialogue: 0,0:25:26.29,0:25:28.63,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:25:28.63,0:25:31.46,Default,,0000,0000,0000,,Шаян!
Dialogue: 0,0:25:28.63,0:25:31.46,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:25:31.46,0:25:33.47,Default,,0000,0000,0000,,Бұл апамнан келген кәдесый.
Dialogue: 0,0:25:33.47,0:25:35.57,Default,,0000,0000,0000,,Оны жей беріңіз.
Dialogue: 0,0:25:37.64,0:25:41.34,Default,,0000,0000,0000,,Көптеген қосымшалар бар.
Dialogue: 0,0:25:37.64,0:25:41.34,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:25:43.64,0:25:46.65,Default,,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,0:25:46.65,0:25:50.15,Default,,0000,0000,0000,,Аму…. Хохохохо....
Dialogue: 0,0:25:50.15,0:25:52.85,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:25:50.15,0:25:52.85,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:25:55.32,0:25:58.66,Default,,0000,0000,0000,,《Алғаш тістегеннен-ақ өзімді керемет сезіндім.
Dialogue: 0,0:25:58.66,0:26:03.09,Default,,0000,0000,0000,,Дашига
Dialogue: 0,0:25:58.66,0:26:03.09,Default,,0000,0000,0000,,Тоңған денеге суық тарайды.
Dialogue: 0,0:26:03.09,0:26:05.93,Default,,0000,0000,0000,,Және үлпілдек тофу.
Dialogue: 0,0:26:05.93,0:26:08.77,Default,,0000,0000,0000,,Сорпасы мол қытай қырыққабаты.
Dialogue: 0,0:26:08.77,0:26:12.10,Default,,0000,0000,0000,,Жасыл пияз және шиитаке саңырауқұлақтары➡
Dialogue: 0,0:26:12.10,0:26:14.31,Default,,0000,0000,0000,,Және…》
Dialogue: 0,0:26:24.95,0:26:29.29,Default,,0000,0000,0000,,《Краб тәттісі》
Dialogue: 0,0:26:29.29,0:26:31.99,Default,,0000,0000,0000,,Иә? Уф.
Dialogue: 0,0:26:35.29,0:26:37.96,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:26:37.96,0:26:40.77,Default,,0000,0000,0000,,Хмм. Хехе.
Dialogue: 0,0:26:51.31,0:26:53.31,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:26:53.31,0:26:55.31,Default,,0000,0000,0000,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:27:19.27,0:27:21.27,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:27:21.27,0:27:23.27,Default,,0000,0000,0000,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:27:39.62,0:27:43.53,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:27:46.46,0:27:48.97,Default,,0000,0000,0000,,Барлығы үнсіз.
Dialogue: 0,0:27:48.97,0:27:51.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:27:48.97,0:27:51.97,Default,,0000,0000,0000,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:27:51.97,0:27:54.47,Default,,0000,0000,0000,,Инуко! Мен білмей тұрып...
Dialogue: 0,0:27:54.47,0:27:56.81,Default,,0000,0000,0000,,Жаңа ғана келді.
Dialogue: 0,0:27:56.81,0:28:00.11,Default,,0000,0000,0000,,Дәлірек айтқанда
Dialogue: 0,0:27:56.81,0:28:00.11,Default,,0000,0000,0000,,Сіз шаянды жеуге тым көп көңіл бөлдіңіз.
Dialogue: 0,0:28:04.25,0:28:07.42,Default,,0000,0000,0000,,Өте
Dialogue: 0,0:28:04.25,0:28:07.42,Default,,0000,0000,0000,,Бұл дәмді болды.
Dialogue: 0,0:28:07.42,0:28:11.59,Default,,0000,0000,0000,,Солай бола тұра екеуміздің кездескенімізге біраз болды.
Dialogue: 0,0:28:07.42,0:28:11.59,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:28:11.59,0:28:13.93,Default,,0000,0000,0000,,Бүгін де сенің жұмысың бар еді.
Dialogue: 0,0:28:13.93,0:28:17.10,Default,,0000,0000,0000,,Соңғы кездері бастауыш мектеп қарбалас.
Dialogue: 0,0:28:17.10,0:28:19.43,Default,,0000,0000,0000,,Мен әдетте сенбіде де шығамын.
Dialogue: 0,0:28:19.43,0:28:21.60,Default,,0000,0000,0000,,Ена Чан келе алмайды ма?
Dialogue: 0,0:28:21.60,0:28:25.27,Default,,0000,0000,0000,,А, менде бүгін толық жұмыс күнім бар.
Dialogue: 0,0:28:25.27,0:28:29.77,Default,,0000,0000,0000,,Триминг салоны дегеніміз не?
Dialogue: 0,0:28:25.27,0:28:29.77,Default,,0000,0000,0000,,Менің ойымша, демалыс күндері қарбалас болады.
Dialogue: 0,0:28:37.62,0:28:41.12,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:28:37.62,0:28:41.12,Default,,0000,0000,0000,,Мен лагерь салып жатырмын.
Dialogue: 0,0:28:41.12,0:28:45.79,Default,,0000,0000,0000,,Бұл кенеттен болды.
Dialogue: 0,0:28:41.12,0:28:45.79,Default,,0000,0000,0000,,Кемпинг? Сіз кемпинг салып жатырсыз ба?
Dialogue: 0,0:28:45.79,0:28:47.79,Default,,0000,0000,0000,,Сабыр ет, Надешико.
Dialogue: 0,0:28:47.79,0:28:50.46,Default,,0000,0000,0000,,Жоғарыда айтқанымдай, мен мұны шынымен жасаймын.
Dialogue: 0,0:28:50.46,0:28:53.13,Default,,0000,0000,0000,,Ах. Барлығы бірге ше?
Dialogue: 0,0:28:53.13,0:28:56.13,Default,,0000,0000,0000,,Рин: ''Мен мұны міндетті түрде орындағым келеді'' деді.
Dialogue: 0,0:28:53.13,0:28:56.13,Default,,0000,0000,0000,,Ол маған айтып жатыр.
Dialogue: 0,0:28:56.13,0:28:58.14,Default,,0000,0000,0000,,Жоқ, мен емес...
Dialogue: 0,0:28:58.14,0:29:01.24,Default,,0000,0000,0000,,Жасайық!
Dialogue: 0,0:28:58.14,0:29:01.24,Default,,0000,0000,0000,,Барлығымыз лагерь салайық➡
Dialogue: 0,0:29:01.24,0:29:03.24,Default,,0000,0000,0000,,Өте қызықты көрінеді!
Dialogue: 0,0:29:03.24,0:29:07.75,Default,,0000,0000,0000,,Бірақ бұл қиын емес пе?
Dialogue: 0,0:29:03.24,0:29:07.75,Default,,0000,0000,0000,,Мен және Аки жергілікті тұрғындармыз➡
Dialogue: 0,0:29:07.75,0:29:11.58,Default,,0000,0000,0000,,Надешико-чан Токиода.
Dialogue: 0,0:29:07.75,0:29:11.58,Default,,0000,0000,0000,,Ена-чан Йокогамада.
Dialogue: 0,0:29:11.58,0:29:14.25,Default,,0000,0000,0000,,Рин Чан Нагоядан келген бе?
Dialogue: 0,0:29:14.25,0:29:17.26,Default,,0000,0000,0000,,Жарайды! Бұл қалай да болады!
Dialogue: 0,0:29:17.26,0:29:19.26,Default,,0000,0000,0000,,Сәлем, Рин Чан!
Dialogue: 0,0:29:19.26,0:29:22.76,Default,,0000,0000,0000,,Аа... Иә.
Dialogue: 0,0:29:22.76,0:29:27.57,Default,,0000,0000,0000,,Хэхе, Надешико-чан
Dialogue: 0,0:29:22.76,0:29:27.57,Default,,0000,0000,0000,,Сіз бұрынғыдай жігерлісіз.
Dialogue: 0,0:29:29.93,0:29:33.94,Default,,0000,0000,0000,,Жарайды! Енадан да
Dialogue: 0,0:29:29.93,0:29:33.94,Default,,0000,0000,0000,,Маған қатысуға болады деген жауап келді!
Dialogue: 0,0:29:33.94,0:29:36.27,Default,,0000,0000,0000,,Енді бізде барлық актерлер бар!
Dialogue: 0,0:29:36.27,0:29:40.95,Default,,0000,0000,0000,,Бүгіннен бастап бесеуміз бірге жұмыс жасаймыз
Dialogue: 0,0:29:36.27,0:29:40.95,Default,,0000,0000,0000,,Лагерь салуды жалғастырыңыз!
Dialogue: 0,0:29:40.95,0:29:43.62,Default,,0000,0000,0000,,Осы мақсатта мен сізге қызмет көрсетемін.
Dialogue: 0,0:29:43.62,0:29:45.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:29:45.62,0:29:48.82,Default,,0000,0000,0000,,Біріншіден, Надешико сайттың супервайзері!
Dialogue: 0,0:29:52.12,0:29:54.33,Default,,0000,0000,0000,,Инуко кестелерді басқарады!
Dialogue: 0,0:29:56.80,0:29:58.80,Default,,0000,0000,0000,,Ena - бұл қоғаммен байланыс!
Dialogue: 0,0:30:01.80,0:30:04.50,Default,,0000,0000,0000,,Сахна артындағы барлығына мен жауаптымын!
Dialogue: 0,0:30:07.14,0:30:10.98,Default,,0000,0000,0000,,Ал лагерьдің жалпы жетекшісі...
Dialogue: 0,0:30:10.98,0:30:13.28,Default,,0000,0000,0000,,Бұл Рин!
Dialogue: 0,0:30:10.98,0:30:13.28,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:30:15.31,0:30:20.32,Default,,0000,0000,0000,,Надешико-чанның физикалық күші бар.
Dialogue: 0,0:30:15.31,0:30:20.32,Default,,0000,0000,0000,,Сайттың супервайзері Керемет сәйкестік.
Dialogue: 0,0:30:20.32,0:30:23.15,Default,,0000,0000,0000,,Ауыр жүкті маған қалдыр!
Dialogue: 0,0:30:23.15,0:30:25.16,Default,,0000,0000,0000,,Дұрыс? Мен де➡
Dialogue: 0,0:30:25.16,0:30:27.99,Default,,0000,0000,0000,,Әр адамның қабілетіне қараңыз
Dialogue: 0,0:30:25.16,0:30:27.99,Default,,0000,0000,0000,,Мен бұл туралы ойладым.
Dialogue: 0,0:30:27.99,0:30:32.83,Default,,0000,0000,0000,,Эй... Эй, эй.
Dialogue: 0,0:30:27.99,0:30:32.83,Default,,0000,0000,0000,,Мен неге көшбасшымын?
Dialogue: 0,0:30:32.83,0:30:36.17,Default,,0000,0000,0000,,Себебі менде кемпингтердің ең ұзақ тарихы бар.
Dialogue: 0,0:30:36.17,0:30:39.67,Default,,0000,0000,0000,,Сіз біліктісіз бе?
Dialogue: 0,0:30:36.17,0:30:39.67,Default,,0000,0000,0000,,Кемпинг туралы айтатын болсақ, бұл Рин Чан.
Dialogue: 0,0:30:39.67,0:30:41.67,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:30:41.67,0:30:45.34,Default,,0000,0000,0000,,Рахмет, Көшбасшы.
Dialogue: 0,0:30:45.34,0:30:48.68,Default,,0000,0000,0000,,Мүмкіндігінше қолайсыздық тудырмау
Dialogue: 0,0:30:45.34,0:30:48.68,Default,,0000,0000,0000,,Себебі мен жасаймын.
Dialogue: 0,0:30:48.68,0:30:53.08,Default,,0000,0000,0000,,Хмм…. Күрсін.
Dialogue: 0,0:31:12.30,0:31:16.01,Default,,0000,0000,0000,,Біз мұны шынымен жасай аламыз ба?
Dialogue: 0,0:31:20.81,0:31:26.52,Default,,0000,0000,0000,,Бірақ жаңадан бастаңыз
Dialogue: 0,0:31:20.81,0:31:26.52,Default,,0000,0000,0000,,Көңіліңіз көтеріңкі емес пе?
Dialogue: 0,0:32:41.33,0:32:44.33,Default,,0000,0000,0000,,Мен мұны естідім. Надешикодан.
Dialogue: 0,0:32:44.33,0:32:47.33,Default,,0000,0000,0000,,Сіз лагерь салып жатырсыз ба?
Dialogue: 0,0:32:44.33,0:32:47.33,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:32:47.33,0:32:52.34,Default,,0000,0000,0000,,Хехе, Рин-Чан, қандай көшбасшы!
Dialogue: 0,0:32:47.33,0:32:52.34,Default,,0000,0000,0000,,Бұл тамаша.
Dialogue: 0,0:32:52.34,0:32:55.51,Default,,0000,0000,0000,,Бұл салқын болу туралы емес.
Dialogue: 0,0:32:52.34,0:32:55.51,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:32:55.51,0:33:00.28,Default,,0000,0000,0000,,Лагерьге дейін
Dialogue: 0,0:32:55.51,0:33:00.28,Default,,0000,0000,0000,,Велосипедпен жүру қанша уақытты алады?
Dialogue: 0,0:33:00.28,0:33:03.28,Default,,0000,0000,0000,,Хмм, Нагоядан 4 сағат.
Dialogue: 0,0:33:03.28,0:33:07.62,Default,,0000,0000,0000,,4 сағат! ? Мен онда жиі барамын
Dialogue: 0,0:33:03.28,0:33:07.62,Default,,0000,0000,0000,,Бұл қиын, солай емес пе?
Dialogue: 0,0:33:07.62,0:33:09.95,Default,,0000,0000,0000,,Бір қызығы, олай емес.
Dialogue: 0,0:33:09.95,0:33:13.46,Default,,0000,0000,0000,,Grandpa too
Dialogue: 0,0:33:09.95,0:33:13.46,Default,,0000,0000,0000,,Мен ол велосипедпен Яманашиге бардым.
Dialogue: 0,0:33:13.46,0:33:17.46,Default,,0000,0000,0000,,Әдеттегідей, сізде күшті стиль бар.
Dialogue: 0,0:33:13.46,0:33:17.46,Default,,0000,0000,0000,,Эхехе….
Dialogue: 0,0:33:17.46,0:33:21.97,Default,,0000,0000,0000,,Шима мырза
Dialogue: 0,0:33:17.46,0:33:21.97,Default,,0000,0000,0000,,Майды ауыстыру аяқталды.
Dialogue: 0,0:33:21.97,0:33:24.14,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:33:24.14,0:33:26.30,Default,,0000,0000,0000,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:33:26.30,0:33:29.31,Default,,0000,0000,0000,,Иә. Жақсы сезінеді.
Dialogue: 0,0:33:29.31,0:33:33.81,Default,,0000,0000,0000,,Рин Чан да әдемі көрінеді.
Dialogue: 0,0:33:33.81,0:33:36.81,Default,,0000,0000,0000,,Иә... Менің ойымша?
Dialogue: 0,0:33:38.82,0:33:42.32,Default,,0000,0000,0000,,Маған қазір біраз зерттеу керек.
Dialogue: 0,0:33:38.82,0:33:42.32,Default,,0000,0000,0000,,Менің қолымнан келмейді➡
Dialogue: 0,0:33:42.32,0:33:46.49,Default,,0000,0000,0000,,Қалай болғанда да жергілікті достармен
Dialogue: 0,0:33:42.32,0:33:46.49,Default,,0000,0000,0000,,Мен оны сынап көруді шештім...
Dialogue: 0,0:33:46.49,0:33:50.33,Default,,0000,0000,0000,,Эй, бұл лагерь. Қызық көрінеді!
Dialogue: 0,0:33:50.33,0:33:53.83,Default,,0000,0000,0000,,Үйде жасалған лагерь?
Dialogue: 0,0:33:53.83,0:33:57.00,Default,,0000,0000,0000,,Town журналындағы сериялау жобасы үшін
Dialogue: 0,0:33:53.83,0:33:57.00,Default,,0000,0000,0000,,Бұл дұрыс емес пе?
Dialogue: 0,0:33:57.00,0:33:59.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:33:59.00,0:34:02.11,Default,,0000,0000,0000,,Әй, бас редактор!
Dialogue: 0,0:34:02.11,0:34:04.11,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:34:04.11,0:34:06.44,Default,,0000,0000,0000,,О... шынымен бе?
Dialogue: 0,0:34:06.44,0:34:10.95,Default,,0000,0000,0000,,Жазушы мырза, бару қиын.
Dialogue: 0,0:34:06.44,0:34:10.95,Default,,0000,0000,0000,,Мақаланы өзіңіз жазыңыз.
Dialogue: 0,0:34:10.95,0:34:15.12,Default,,0000,0000,0000,,Веб нұсқасы да құпталады.
Dialogue: 0,0:34:10.95,0:34:15.12,Default,,0000,0000,0000,,Ұсынысты бүгінге дейін жіберіңіз.
Dialogue: 0,0:34:15.12,0:34:18.12,Default,,0000,0000,0000,,Иә! Мен оны дайындап, бірден қызмет етемін.
Dialogue: 0,0:34:28.13,0:34:31.14,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:34:28.13,0:34:31.14,Default,,0000,0000,0000,,Эй, міне. Мұнда.
Dialogue: 0,0:34:31.14,0:34:34.81,Default,,0000,0000,0000,,Ена-чан!
Dialogue: 0,0:34:31.14,0:34:34.81,Default,,0000,0000,0000,,Күткеніңізге рахмет.
Dialogue: 0,0:34:34.81,0:34:38.81,Default,,0000,0000,0000,,Біраз уақыт болды.
Dialogue: 0,0:34:34.81,0:34:38.81,Default,,0000,0000,0000,,Көптен бері көрмегелі!
Dialogue: 0,0:34:38.81,0:34:41.65,Default,,0000,0000,0000,,Жақсы жұмыс.
Dialogue: 0,0:34:38.81,0:34:41.65,Default,,0000,0000,0000,,Сіз жақсы көрінесіз.
Dialogue: 0,0:34:41.65,0:34:46.82,Default,,0000,0000,0000,,Жақсы! Енді ақыры
Dialogue: 0,0:34:41.65,0:34:46.82,Default,,0000,0000,0000,,Барлығы осында.
Dialogue: 0,0:34:41.65,0:34:46.82,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:34:46.82,0:34:51.02,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:34:46.82,0:34:51.02,Default,,0000,0000,0000,,Бұл біздің жедел штабымыз.
Dialogue: 0,0:34:53.32,0:34:55.53,Default,,0000,0000,0000,,Мынау... мынау! ?
Dialogue: 0,0:34:59.50,0:35:01.50,Default,,0000,0000,0000,,Тар!
Dialogue: 0,0:35:03.60,0:35:06.27,Default,,0000,0000,0000,,Жоба үшін
Dialogue: 0,0:35:03.60,0:35:06.27,Default,,0000,0000,0000,,Маған бөлме жалдасаңыз➡
Dialogue: 0,0:35:06.27,0:35:08.27,Default,,0000,0000,0000,,Осы бөлмеде.
Dialogue: 0,0:35:08.27,0:35:11.61,Default,,0000,0000,0000,,Нокурудың клуб бөлмесіне ұқсайды.
Dialogue: 0,0:35:08.27,0:35:11.61,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:35:11.61,0:35:14.78,Default,,0000,0000,0000,,Бұл жай ғана кездесу.
Dialogue: 0,0:35:11.61,0:35:14.78,Default,,0000,0000,0000,,Мен оны қолданбас едім➡
Dialogue: 0,0:35:14.78,0:35:17.62,Default,,0000,0000,0000,,Бұл жеткілікті болуы керек.
Dialogue: 0,0:35:14.78,0:35:17.62,Default,,0000,0000,0000,,Ой.
Dialogue: 0,0:35:17.62,0:35:19.78,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:35:19.78,0:35:24.29,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:35:19.78,0:35:24.29,Default,,0000,0000,0000,,Бұл жігіт Джинжер, туристік пиар робот.
Dialogue: 0,0:35:24.29,0:35:26.29,Default,,0000,0000,0000,,Маған мейірімді болыңыз.
Dialogue: 0,0:35:26.29,0:35:28.63,Default,,0000,0000,0000,,Неліктен туристік робот мұнда...?
Dialogue: 0,0:35:28.63,0:35:31.46,Default,,0000,0000,0000,,Міне, көп нәрсе болды.
Dialogue: 0,0:35:28.63,0:35:31.46,Default,,0000,0000,0000,,Бұл да.
Dialogue: 0,0:35:31.46,0:35:33.46,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:35:33.46,0:35:36.27,Default,,0000,0000,0000,,Тас, қағаз, қайшы ойнаймыз!
Dialogue: 0,0:35:33.46,0:35:36.27,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:35:38.30,0:35:42.14,Default,,0000,0000,0000,,Тас, қағаз, қайшы... Поп!
Dialogue: 0,0:35:42.14,0:35:46.64,Default,,0000,0000,0000,,Иә, мен жеңдім!
Dialogue: 0,0:35:42.14,0:35:46.64,Default,,0000,0000,0000,,(Фанфар)
Dialogue: 0,0:35:46.64,0:35:50.05,Default,,0000,0000,0000,,әділ
Dialogue: 0,0:35:46.64,0:35:50.05,Default,,0000,0000,0000,,Бұл тас-қағаз-қайшы робот емес пе?
Dialogue: 0,0:35:56.32,0:35:58.99,Default,,0000,0000,0000,,Мен біраз зерттеу жасадым➡
Dialogue: 0,0:35:58.99,0:36:02.26,Default,,0000,0000,0000,,Лагерь қалай жасалады
Dialogue: 0,0:35:58.99,0:36:02.26,Default,,0000,0000,0000,,Осы үш нәрсе қажет сияқты.
Dialogue: 0,0:36:02.26,0:36:04.26,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:36:04.26,0:36:09.27,Default,,0000,0000,0000,,Біріншіден, тұтынушылар базасы т.б.
Dialogue: 0,0:36:04.26,0:36:09.27,Default,,0000,0000,0000,,Сайт түрі және басқа жоспарлар туралы ойлану➡
Dialogue: 0,0:36:09.27,0:36:12.10,Default,,0000,0000,0000,,Сонымен қатар дала жұмыстары да алға жылжуда.
Dialogue: 0,0:36:12.10,0:36:14.77,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:36:12.10,0:36:14.77,Default,,0000,0000,0000,,Әр жұмыс арасындағы уақытты қараңыз➡
Dialogue: 0,0:36:14.77,0:36:17.44,Default,,0000,0000,0000,,Айналмалы жүйе болады ма?
Dialogue: 0,0:36:17.44,0:36:19.78,Default,,0000,0000,0000,,Енді ашылу үшін➡
Dialogue: 0,0:36:19.78,0:36:23.61,Default,,0000,0000,0000,,Брондау жүйесі т.б.
Dialogue: 0,0:36:19.78,0:36:23.61,Default,,0000,0000,0000,,Менің ойымша, бұл операциялық нұсқаулықты жасау сияқты.
Dialogue: 0,0:36:23.61,0:36:25.62,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:36:25.62,0:36:27.95,Default,,0000,0000,0000,,Олай болса, ең алдымен жоспар құрайық.
Dialogue: 0,0:36:27.95,0:36:32.12,Default,,0000,0000,0000,,Лагерьде кім үшін
Dialogue: 0,0:36:27.95,0:36:32.12,Default,,0000,0000,0000,,Маған қандай сайт керек екенін ойлауым керек.
Dialogue: 0,0:36:32.12,0:36:34.46,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:36:34.46,0:36:38.30,Default,,0000,0000,0000,,Достармен немесе отбасымен
Dialogue: 0,0:36:34.46,0:36:38.30,Default,,0000,0000,0000,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,0:36:38.30,0:36:41.13,Default,,0000,0000,0000,,Жалғыз адамдар
Dialogue: 0,0:36:38.30,0:36:41.13,Default,,0000,0000,0000,,Баяу орындай білген жақсы.
Dialogue: 0,0:36:41.13,0:36:44.97,Default,,0000,0000,0000,,Балаларды қуанту
Dialogue: 0,0:36:41.13,0:36:44.97,Default,,0000,0000,0000,,Лагерь өте жақсы.
Dialogue: 0,0:36:44.97,0:36:47.14,Default,,0000,0000,0000,,Балаларға арналған орын бар ма?
Dialogue: 0,0:36:44.97,0:36:47.14,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:36:47.14,0:36:49.14,Default,,0000,0000,0000,,Ит жүгіру немесе бір нәрсе жасаңыз ➡
Dialogue: 0,0:36:49.14,0:36:51.48,Default,,0000,0000,0000,,Иттері бар лагерьлер үшін
Dialogue: 0,0:36:49.14,0:36:51.48,Default,,0000,0000,0000,,Келесің деп үміттенемін.
Dialogue: 0,0:36:51.48,0:36:53.64,Default,,0000,0000,0000,,Тіпті біздің тұтынушылар
Dialogue: 0,0:36:51.48,0:36:53.64,Default,,0000,0000,0000,,Кемпингке баратын адамдар➡
Dialogue: 0,0:36:53.64,0:36:55.65,Default,,0000,0000,0000,,Олар өте аз.
Dialogue: 0,0:36:55.65,0:36:58.48,Default,,0000,0000,0000,,Әртүрлі адамдар
Dialogue: 0,0:36:55.65,0:36:58.48,Default,,0000,0000,0000,,Сіз оны көптеген жолдармен пайдалана аласыз➡
Dialogue: 0,0:36:58.48,0:37:00.92,Default,,0000,0000,0000,,Кемпинг болса жақсы болар еді.
Dialogue: 0,0:37:00.92,0:37:02.92,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:37:02.92,0:37:04.92,Default,,0000,0000,0000,,Содан кейін орынға барыңыз➡
Dialogue: 0,0:37:04.92,0:37:07.43,Default,,0000,0000,0000,,Кішкене нақтырақ болыңыз
Dialogue: 0,0:37:04.92,0:37:07.43,Default,,0000,0000,0000,,Ойланып көрейік.
Dialogue: 0,0:37:07.43,0:37:09.43,Default,,0000,0000,0000,,Айтпақшы, сен де шөп шабмайсың ба?
Dialogue: 0,0:37:09.43,0:37:11.73,Default,,0000,0000,0000,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:37:15.93,0:37:18.27,Default,,0000,0000,0000,,Жарайсыңдар, балалар.
Dialogue: 0,0:37:15.93,0:37:18.27,Default,,0000,0000,0000,,Біріншіден, бұл!
Dialogue: 0,0:37:18.27,0:37:20.27,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:37:22.27,0:37:24.28,Default,,0000,0000,0000,,Демалыс жауынгері….
Dialogue: 0,0:37:24.28,0:37:26.48,Default,,0000,0000,0000,,Жұмыс киімінің инспекторы!
Dialogue: 0,0:37:29.11,0:37:31.12,Default,,0000,0000,0000,,Қолғаптар мен құралдар да бар.
Dialogue: 0,0:37:31.12,0:37:33.28,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:37:33.28,0:37:36.95,Default,,0000,0000,0000,,Барлығы бірдей киім киеді
Dialogue: 0,0:37:33.28,0:37:36.95,Default,,0000,0000,0000,,Менің мектеп формасынан бері.
Dialogue: 0,0:37:36.95,0:37:39.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:37:36.95,0:37:39.96,Default,,0000,0000,0000,,Мен толқу үстіндемін.
Dialogue: 0,0:37:39.96,0:37:42.29,Default,,0000,0000,0000,,О, не? сол.
Dialogue: 0,0:37:42.29,0:37:45.13,Default,,0000,0000,0000,,Мен бейнежазбаға түсіремін деп ойладым.
Dialogue: 0,0:37:45.13,0:37:47.47,Default,,0000,0000,0000,,Бұл бір нәрсеге пайдалы болуы мүмкін.
Dialogue: 0,0:37:47.47,0:37:50.64,Default,,0000,0000,0000,,О! PR қызметкері күткендей.
Dialogue: 0,0:37:50.64,0:37:52.64,Default,,0000,0000,0000,,Олай болса, Ена-сан.
Dialogue: 0,0:37:52.64,0:37:55.47,Default,,0000,0000,0000,,Қазіргі ынтаңызды айтыңыз.
Dialogue: 0,0:37:55.47,0:37:57.98,Default,,0000,0000,0000,,Мен бар күшімді саламын.
Dialogue: 0,0:37:57.98,0:38:00.75,Default,,0000,0000,0000,,Ахаха.
Dialogue: 0,0:37:57.98,0:38:00.75,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:38:00.75,0:38:03.41,Default,,0000,0000,0000,,Ойынсыз бастайық.
Dialogue: 0,0:38:03.41,0:38:05.42,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:38:15.43,0:38:17.76,Default,,0000,0000,0000,,Иә? Иә!
Dialogue: 0,0:38:17.76,0:38:20.46,Default,,0000,0000,0000,,Оны кесу қиын.
Dialogue: 0,0:38:22.77,0:38:26.10,Default,,0000,0000,0000,,Хмм... Шыдай алмаймын... Уф.
Dialogue: 0,0:38:26.10,0:38:28.94,Default,,0000,0000,0000,,Бұл таңқаларлық қиын.
Dialogue: 0,0:38:28.94,0:38:32.44,Default,,0000,0000,0000,,Мен әдетте шөп шабмаймын.
Dialogue: 0,0:38:28.94,0:38:32.44,Default,,0000,0000,0000,,Мен мұны мүлдем істемеймін.
Dialogue: 0,0:38:32.44,0:38:34.45,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:38:34.45,0:38:37.78,Default,,0000,0000,0000,,Ой, арты қоқысқа толы.
Dialogue: 0,0:38:37.78,0:38:41.99,Default,,0000,0000,0000,,Маған мұны тазалау керек.
Dialogue: 0,0:38:37.78,0:38:41.99,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:38:43.95,0:38:46.96,Default,,0000,0000,0000,,Куу~! Менің арқам ауырады...
Dialogue: 0,0:38:46.96,0:38:49.79,Default,,0000,0000,0000,,Куу~! мен де.
Dialogue: 0,0:38:46.96,0:38:49.79,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:38:49.79,0:38:54.97,Default,,0000,0000,0000,,Рин, мені ауыстыршы.
Dialogue: 0,0:38:49.79,0:38:54.97,Default,,0000,0000,0000,,Біз енді ғана басталып жатырмыз.
Dialogue: 0,0:38:54.97,0:38:58.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:38:58.47,0:39:01.47,Default,,0000,0000,0000,,Сәлем! Бұл не?
Dialogue: 0,0:39:04.91,0:39:07.41,Default,,0000,0000,0000,,Аа~ Мен де қызық болдым.
Dialogue: 0,0:39:07.41,0:39:09.58,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:39:09.58,0:39:13.75,Default,,0000,0000,0000,,Бұл құс торы.
Dialogue: 0,0:39:09.58,0:39:13.75,Default,,0000,0000,0000,,Құс торы?
Dialogue: 0,0:39:13.75,0:39:15.75,Default,,0000,0000,0000,,Алдыңғы нысанға барған кезде➡
Dialogue: 0,0:39:15.75,0:39:18.92,Default,,0000,0000,0000,,Құстармен араласатын жер
Dialogue: 0,0:39:15.75,0:39:18.92,Default,,0000,0000,0000,,Мен қаладым.
Dialogue: 0,0:39:18.92,0:39:22.59,Default,,0000,0000,0000,,Бірақ тор тым үлкен...
Dialogue: 0,0:39:22.59,0:39:25.26,Default,,0000,0000,0000,,Құс бір күнде қашып кеткен көрінеді.
Dialogue: 0,0:39:25.26,0:39:28.43,Default,,0000,0000,0000,,Егер сіз бұл туралы сабырлы түрде ойласаңыз
Dialogue: 0,0:39:25.26,0:39:28.43,Default,,0000,0000,0000,,Бұл күлкілі оқиға.
Dialogue: 0,0:39:28.43,0:39:30.43,Default,,0000,0000,0000,,Не істеу керек? Бұл.
Dialogue: 0,0:39:30.43,0:39:32.94,Default,,0000,0000,0000,,Менің ойымша, ол жойылды.
Dialogue: 0,0:39:43.78,0:39:47.62,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:39:43.78,0:39:47.62,Default,,0000,0000,0000,,Бұл үлкен ілгерілеуге әкелмейді.
Dialogue: 0,0:39:47.62,0:39:50.96,Default,,0000,0000,0000,,Сәлем! Огаки-чан.
Dialogue: 0,0:39:47.62,0:39:50.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:39:50.96,0:39:53.79,Default,,0000,0000,0000,,Ах, Оказаки мырза!
Dialogue: 0,0:39:53.79,0:39:57.29,Default,,0000,0000,0000,,Үйде өсірген юзюді әкел!
Dialogue: 0,0:39:57.29,0:39:59.80,Default,,0000,0000,0000,,Уау, керемет!
Dialogue: 0,0:39:59.80,0:40:02.80,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:39:59.80,0:40:02.80,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:40:02.80,0:40:05.30,Default,,0000,0000,0000,,Не? Сіз оны қолмен кесіп жатырсыз ба?
Dialogue: 0,0:40:05.30,0:40:08.11,Default,,0000,0000,0000,,Бұл өте жақсы
Dialogue: 0,0:40:05.30,0:40:08.11,Default,,0000,0000,0000,,Жақсы болмады...
Dialogue: 0,0:40:10.14,0:40:13.14,Default,,0000,0000,0000,,Осылай бас бармағыңызды төмен қаратыңыз
Dialogue: 0,0:40:10.14,0:40:13.14,Default,,0000,0000,0000,,Оны алыңыз➡
Dialogue: 0,0:40:13.14,0:40:16.31,Default,,0000,0000,0000,,Мен тамырларды кесіп тастадым.
Dialogue: 0,0:40:16.31,0:40:18.48,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:40:18.48,0:40:21.99,Default,,0000,0000,0000,,Ара тартылған кезде
Dialogue: 0,0:40:18.48,0:40:21.99,Default,,0000,0000,0000,,Ол кесуге болатындай етіп жасалған➡
Dialogue: 0,0:40:21.99,0:40:26.32,Default,,0000,0000,0000,,Аздап басыңыз
Dialogue: 0,0:40:21.99,0:40:26.32,Default,,0000,0000,0000,,Тартқанда аздап күш қолданбаңыз.
Dialogue: 0,0:40:26.32,0:40:28.33,Default,,0000,0000,0000,,Ұсақ қимылдар жасасаңыз, шаршайсыз➡
Dialogue: 0,0:40:28.33,0:40:31.00,Default,,0000,0000,0000,,Бүкіл жүзді пайдаланыңыз.
Dialogue: 0,0:40:31.00,0:40:33.16,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:40:33.16,0:40:35.83,Default,,0000,0000,0000,,Жарақат алудан сақтаныңыз!
Dialogue: 0,0:40:35.83,0:40:39.34,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:40:39.34,0:40:42.17,Default,,0000,0000,0000,,Сіз маған көп нәрсені үйреттіңіз.
Dialogue: 0,0:40:42.17,0:40:44.18,Default,,0000,0000,0000,,Сіз көршісіз бе?
Dialogue: 0,0:40:44.18,0:40:46.34,Default,,0000,0000,0000,,Иә. Оказаки мырза фермер.
Dialogue: 0,0:40:46.34,0:40:48.85,Default,,0000,0000,0000,,Аки-чан
Dialogue: 0,0:40:46.34,0:40:48.85,Default,,0000,0000,0000,,Біз өте жақсы доспыз.
Dialogue: 0,0:40:48.85,0:40:50.85,Default,,0000,0000,0000,,Нихихихи.
Dialogue: 0,0:40:50.85,0:40:54.52,Default,,0000,0000,0000,,Мұндағы адамдар кімдер?
Dialogue: 0,0:40:50.85,0:40:54.52,Default,,0000,0000,0000,,Себебі мен сенімен жиі сөйлесемін.
Dialogue: 0,0:40:54.52,0:40:56.52,Default,,0000,0000,0000,,Әрине, абай болыңыз➡
Dialogue: 0,0:40:56.52,0:41:00.29,Default,,0000,0000,0000,,Жұмыс кезінде қиындық туғызу мүмкіндігі
Dialogue: 0,0:40:56.52,0:41:00.29,Default,,0000,0000,0000,,Бар болуы мүмкін.
Dialogue: 0,0:41:00.29,0:41:04.60,Default,,0000,0000,0000,,Осы жердегі адамдарға да
Dialogue: 0,0:41:00.29,0:41:04.60,Default,,0000,0000,0000,,лагерь Мен оны асыға күткеніңізді қалаймын.
Dialogue: 0,0:41:11.30,0:41:16.47,Default,,0000,0000,0000,,О! Ол оңай кесіледі!
Dialogue: 0,0:41:11.30,0:41:16.47,Default,,0000,0000,0000,,Бұл рас! Мүлдем басқа!
Dialogue: 0,0:41:16.47,0:41:19.14,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:41:19.14,0:41:21.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:41:23.31,0:41:25.32,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:41:34.66,0:41:38.16,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:41:34.66,0:41:38.16,Default,,0000,0000,0000,,О, сен көп кесіп тастадың.
Dialogue: 0,0:41:38.16,0:41:41.83,Default,,0000,0000,0000,,Иә. Шөп шабу да біршама алға жылжыды.
Dialogue: 0,0:41:41.83,0:41:44.17,Default,,0000,0000,0000,,Бәріңе сәлем!
Dialogue: 0,0:41:44.17,0:41:47.34,Default,,0000,0000,0000,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:41:44.17,0:41:47.34,Default,,0000,0000,0000,,Шай ішейік пе?
Dialogue: 0,0:41:47.34,0:41:49.64,Default,,0000,0000,0000,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:41:56.01,0:41:58.68,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:41:56.01,0:41:58.68,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:41:58.68,0:42:00.78,Default,,0000,0000,0000,,Уау, бұл иіс.
Dialogue: 0,0:42:00.78,0:42:03.29,Default,,0000,0000,0000,,Мен юзюді алдым
Dialogue: 0,0:42:00.78,0:42:03.29,Default,,0000,0000,0000,,Мен оны ыстық лимонға салып көрдім.
Dialogue: 0,0:42:03.29,0:42:05.49,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:42:07.79,0:42:12.80,Default,,0000,0000,0000,,Күрсін! Шаршаған денем ауырып тұр.
Dialogue: 0,0:42:07.79,0:42:12.80,Default,,0000,0000,0000,,Дәмді.
Dialogue: 0,0:42:12.80,0:42:16.80,Default,,0000,0000,0000,,Юзудың иісі тыныштандырады.
Dialogue: 0,0:42:12.80,0:42:16.80,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:42:16.80,0:42:20.30,Default,,0000,0000,0000,,Біраз уақыттан бері мұндай оқиға болған жоқ.
Dialogue: 0,0:42:20.30,0:42:22.97,Default,,0000,0000,0000,,Орта мектепке барғанда
Dialogue: 0,0:42:20.30,0:42:22.97,Default,,0000,0000,0000,,Мектеп ауласында жиі от жағамыз➡
Dialogue: 0,0:42:22.97,0:42:24.98,Default,,0000,0000,0000,,Мен кофе ішіп отырдым.
Dialogue: 0,0:42:24.98,0:42:27.14,Default,,0000,0000,0000,,Сағыныш.
Dialogue: 0,0:42:27.14,0:42:29.15,Default,,0000,0000,0000,,Тіпті солай➡
Dialogue: 0,0:42:29.15,0:42:33.82,Default,,0000,0000,0000,,Менің көз алдымда Фудзи тауы анық көрінеді.
Dialogue: 0,0:42:29.15,0:42:33.82,Default,,0000,0000,0000,,Бұл жақсы жер.
Dialogue: 0,0:42:33.82,0:42:36.82,Default,,0000,0000,0000,,Осылай қарады
Dialogue: 0,0:42:33.82,0:42:36.82,Default,,0000,0000,0000,,Террассалы аумақ➡
Dialogue: 0,0:42:36.82,0:42:40.32,Default,,0000,0000,0000,,Егер сақталса
Dialogue: 0,0:42:36.82,0:42:40.32,Default,,0000,0000,0000,,Шатыр алаңы әйтеуір жұмыс істейтін сияқты.
Dialogue: 0,0:42:40.32,0:42:43.49,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:42:40.32,0:42:43.49,Default,,0000,0000,0000,,Енді мен ойлап тапқан идеяға келсек➡
Dialogue: 0,0:42:43.49,0:42:46.00,Default,,0000,0000,0000,,Бұл сіз оны қалай біріктіретініңізде.
Dialogue: 0,0:42:46.00,0:42:48.60,Default,,0000,0000,0000,,А, мен оны салып көрейін.
Dialogue: 0,0:42:51.17,0:42:54.84,Default,,0000,0000,0000,,Жеке сайт пен отбасылық сайт жасаңыз➡
Dialogue: 0,0:42:54.84,0:42:57.51,Default,,0000,0000,0000,,Иттер мен балалар аймағын қосыңыз...
Dialogue: 0,0:42:57.51,0:42:59.51,Default,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:42:59.51,0:43:01.45,Default,,0000,0000,0000,,О, жақсы.
Dialogue: 0,0:43:01.45,0:43:03.78,Default,,0000,0000,0000,,Өте көп.
Dialogue: 0,0:43:03.78,0:43:06.62,Default,,0000,0000,0000,,Біз біраз орынды үнемдей алатын сияқтымыз.
Dialogue: 0,0:43:06.62,0:43:09.12,Default,,0000,0000,0000,,Бірақ құс торларын алып тастау да бар➡
Dialogue: 0,0:43:09.12,0:43:12.62,Default,,0000,0000,0000,,Ойынға қажетті құрал-жабдықтарды қою
Dialogue: 0,0:43:09.12,0:43:12.62,Default,,0000,0000,0000,,Қоршау салу➡
Dialogue: 0,0:43:12.62,0:43:14.96,Default,,0000,0000,0000,,Бюджет тығыз болуы мүмкін.
Dialogue: 0,0:43:14.96,0:43:17.26,Default,,0000,0000,0000,,Ахаха….
Dialogue: 0,0:43:14.96,0:43:17.26,Default,,0000,0000,0000,,Шынында да….
Dialogue: 0,0:43:19.30,0:43:22.13,Default,,0000,0000,0000,,Ағымдағы идеяларды қорытындылау➡
Dialogue: 0,0:43:22.13,0:43:24.30,Default,,0000,0000,0000,,Сізге кемпингке арналған тұжырымдама қажет болуы мүмкін.
Dialogue: 0,0:43:24.30,0:43:26.30,Default,,0000,0000,0000,,Тұжырымдама?
Dialogue: 0,0:43:26.30,0:43:29.47,Default,,0000,0000,0000,,Қандай лагерь?
Dialogue: 0,0:43:26.30,0:43:29.47,Default,,0000,0000,0000,,Менің ойымша, бұл мақсат қою керек нәрсе.
Dialogue: 0,0:43:29.47,0:43:31.64,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:43:31.64,0:43:36.15,Default,,0000,0000,0000,,Тұжырымдама?
Dialogue: 0,0:43:31.64,0:43:36.15,Default,,0000,0000,0000,,Менің ойыма ештеңе келмейді.
Dialogue: 0,0:43:36.15,0:43:39.15,Default,,0000,0000,0000,,Ал, мен басқа лагерьлерді де жазамын➡
Dialogue: 0,0:43:39.15,0:43:41.49,Default,,0000,0000,0000,,Мен де ойланып көрейін.
Dialogue: 0,0:43:41.49,0:43:43.65,Default,,0000,0000,0000,,Сұхбат?
Dialogue: 0,0:43:41.49,0:43:43.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:43:43.65,0:43:46.49,Default,,0000,0000,0000,,Мақалалар топтамасын осы жерден оқыңыз
Dialogue: 0,0:43:43.65,0:43:46.49,Default,,0000,0000,0000,,Енді мен оны жаза аламын.
Dialogue: 0,0:43:46.49,0:43:48.49,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:43:48.49,0:43:52.33,Default,,0000,0000,0000,,Мұндайды тез айт!
Dialogue: 0,0:43:48.49,0:43:52.33,Default,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:43:52.33,0:43:56.33,Default,,0000,0000,0000,,Мен бәрі жақсы екеніне сенімдімін!
Dialogue: 0,0:43:52.33,0:43:56.33,Default,,0000,0000,0000,,Ыстық тақырыпты құрайды.
Dialogue: 0,0:43:56.33,0:44:00.60,Default,,0000,0000,0000,,Өйткені бұл Нагоядағы жергілікті журнал.
Dialogue: 0,0:43:56.33,0:44:00.60,Default,,0000,0000,0000,,Бұл көп жарнама болмайды.
Dialogue: 0,0:44:00.60,0:44:04.31,Default,,0000,0000,0000,,Бірақ қызығушылық танытқан адам
Dialogue: 0,0:44:00.60,0:44:04.31,Default,,0000,0000,0000,,Менің ойымша, бар!
Dialogue: 0,0:44:06.28,0:44:10.95,Default,,0000,0000,0000,,Ал, келесі аптада сұхбат алайық.
Dialogue: 0,0:44:06.28,0:44:10.95,Default,,0000,0000,0000,,Мен барлығына қайта хабарласамын.
Dialogue: 0,0:44:10.95,0:44:12.95,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:44:36.81,0:44:38.81,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:44:42.98,0:44:46.15,Default,,0000,0000,0000,,Сәлеметсіз бе. Бұл Шима, мен сені шақырдым.
Dialogue: 0,0:44:46.15,0:44:48.82,Default,,0000,0000,0000,,О
Dialogue: 0,0:44:46.15,0:44:48.82,Default,,0000,0000,0000,,Мен сені күттім.
Dialogue: 0,0:44:48.82,0:44:59.50,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:44:59.50,0:45:02.10,Default,,0000,0000,0000,,Бұл жақсы лагерь.
Dialogue: 0,0:45:02.10,0:45:05.10,Default,,0000,0000,0000,,Мен мұнда жиі келетінмін.
Dialogue: 0,0:45:05.10,0:45:08.01,Default,,0000,0000,0000,,Хехе, дұрыс.
Dialogue: 0,0:45:09.94,0:45:12.78,Default,,0000,0000,0000,,Аха….
Dialogue: 0,0:45:12.78,0:45:16.61,Default,,0000,0000,0000,,Ол мүлде өзгермейді. Бұл көрініс.
Dialogue: 0,0:45:16.61,0:45:19.12,Default,,0000,0000,0000,,Мұнда мүмкіндігінше➡
Dialogue: 0,0:45:19.12,0:45:22.12,Default,,0000,0000,0000,,Табиғатқа қол сұғуға болмайды
Dialogue: 0,0:45:19.12,0:45:22.12,Default,,0000,0000,0000,,Мен істеп жатырмын.
Dialogue: 0,0:45:22.12,0:45:24.12,Default,,0000,0000,0000,,Айтсаңыз, дәл солай.
Dialogue: 0,0:45:24.12,0:45:26.29,Default,,0000,0000,0000,,«Дәл солай»….
Dialogue: 0,0:45:26.29,0:45:31.13,Default,,0000,0000,0000,,Бұл жердің жақсысы осы.
Dialogue: 0,0:45:26.29,0:45:31.13,Default,,0000,0000,0000,,Мен бұл шығар деп ойладым.
Dialogue: 0,0:45:31.13,0:45:53.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:53.65,0:45:55.65,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:45:55.65,0:46:07.76,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:46:07.76,0:46:10.57,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:46:17.11,0:46:41.53,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:47:01.25,0:47:03.25,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:47:01.25,0:47:03.25,Default,,0000,0000,0000,,📱
Dialogue: 0,0:47:08.76,0:47:11.06,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:47:20.44,0:47:22.94,Default,,0000,0000,0000,,«Қолда барды қолданыңыз»….
Dialogue: 0,0:47:45.96,0:47:47.97,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:48:11.76,0:48:22.77,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:48:22.77,0:48:25.10,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:48:25.10,0:48:27.80,Default,,0000,0000,0000,,Олай болса, осыны байқап көрейік.
Dialogue: 0,0:48:29.94,0:48:32.74,Default,,0000,0000,0000,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:48:50.46,0:48:53.63,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:48:53.63,0:48:57.30,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:48:53.63,0:48:57.30,Default,,0000,0000,0000,,Бұл да жұмыс па?
Dialogue: 0,0:48:57.30,0:49:01.07,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:48:57.30,0:49:01.07,Default,,0000,0000,0000,,Сіз өте ынталысыз.
Dialogue: 0,0:49:01.07,0:49:04.07,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:49:06.24,0:49:08.91,Default,,0000,0000,0000,,Екеуі алманың қабығын аршып жатыр, бірақ...
Dialogue: 0,0:49:08.91,0:49:10.91,Default,,0000,0000,0000,,Тамақтану.
Dialogue: 0,0:49:14.75,0:49:16.95,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:49:31.10,0:49:33.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:37.11,0:49:41.31,Default,,0000,0000,0000,,Күлсін... Күн суық.
Dialogue: 0,0:49:59.80,0:50:01.80,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:50:13.48,0:50:15.48,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:50:25.66,0:50:27.66,Default,,0000,0000,0000,,Эххе.
Dialogue: 0,0:50:41.51,0:50:43.84,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:50:43.84,0:50:48.15,Default,,0000,0000,0000,,(Жаңа жыл түні қоңырауының дыбысы)
Dialogue: 0,0:50:50.18,0:50:52.85,Default,,0000,0000,0000,,(Жаңа жыл түні қоңырауының дыбысы)
Dialogue: 0,0:50:52.85,0:50:55.35,Default,,0000,0000,0000,,Жаңа жыл құтты болсын!
Dialogue: 0,0:50:55.35,0:50:57.69,Default,,0000,0000,0000,,Бәріңе сәлем, біраз болды.
Dialogue: 0,0:50:57.69,0:50:59.96,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:50:57.69,0:50:59.96,Default,,0000,0000,0000,,Акари-чан!
Dialogue: 0,0:50:59.96,0:51:01.96,Default,,0000,0000,0000,,О~ Чиби Инуко да➡
Dialogue: 0,0:51:01.96,0:51:04.63,Default,,0000,0000,0000,,Дұрыс амандаса білу
Dialogue: 0,0:51:01.96,0:51:04.63,Default,,0000,0000,0000,,Олай болған жоқ па?
Dialogue: 0,0:51:04.63,0:51:06.63,Default,,0000,0000,0000,,Жасайық? Өйткені...
Dialogue: 0,0:51:06.63,0:51:09.47,Default,,0000,0000,0000,,Жаңа жылдық сыйлық. Аки-чан.
Dialogue: 0,0:51:09.47,0:51:12.97,Default,,0000,0000,0000,,Ол мүлде өзгерген жоқ...
Dialogue: 0,0:51:09.47,0:51:12.97,Default,,0000,0000,0000,,Эхехе.
Dialogue: 0,0:51:12.97,0:51:15.47,Default,,0000,0000,0000,,Токиодағы өнер университеттері туралы не деуге болады?
Dialogue: 0,0:51:12.97,0:51:15.47,Default,,0000,0000,0000,,Акари-чан.
Dialogue: 0,0:51:15.47,0:51:18.31,Default,,0000,0000,0000,,Тапсырмаларға толы, бірақ қызық.
Dialogue: 0,0:51:18.31,0:51:20.98,Default,,0000,0000,0000,,Жаңа жыл құтты болсын
Dialogue: 0,0:51:18.31,0:51:20.98,Default,,0000,0000,0000,,Барлығы.
Dialogue: 0,0:51:20.98,0:51:23.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:51:20.98,0:51:23.98,Default,,0000,0000,0000,,Тоба мырза!
Dialogue: 0,0:51:42.67,0:51:45.17,Default,,0000,0000,0000,,Аои Чаннан
Dialogue: 0,0:51:42.67,0:51:45.17,Default,,0000,0000,0000,,Тыңдаңыз.
Dialogue: 0,0:51:45.17,0:51:49.01,Default,,0000,0000,0000,,Сыбыс тараған лагерь туралы не деуге болады?
Dialogue: 0,0:51:45.17,0:51:49.01,Default,,0000,0000,0000,,Сіз қаншалықты алға жылдыңыз?
Dialogue: 0,0:51:49.01,0:51:53.51,Default,,0000,0000,0000,,Префектураның рұқсатымен
Dialogue: 0,0:51:49.01,0:51:53.51,Default,,0000,0000,0000,,Жаңа жылдың басынан бастап қарқынды түрде басталады.
Dialogue: 0,0:51:53.51,0:51:57.18,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:51:53.51,0:51:57.18,Default,,0000,0000,0000,,Маған да бір нәрседен көмектесейін!
Dialogue: 0,0:51:57.18,0:51:59.18,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:51:59.18,0:52:01.79,Default,,0000,0000,0000,,Кемпинг логотипі т.б.
Dialogue: 0,0:51:59.18,0:52:01.79,Default,,0000,0000,0000,,Егер мен оны маған жобалап беруіңізді сұрасам ше?
Dialogue: 0,0:52:01.79,0:52:03.79,Default,,0000,0000,0000,,Һм… Ха-ха-ха
Dialogue: 0,0:52:03.79,0:52:06.96,Default,,0000,0000,0000,,Инуяма мырза
Dialogue: 0,0:52:03.79,0:52:06.96,Default,,0000,0000,0000,,Бұл Кадзизава Фуджими бастауыш мектебі болды, солай ма?
Dialogue: 0,0:52:06.96,0:52:09.29,Default,,0000,0000,0000,,Наурызда болды деп ойлаймын...
Dialogue: 0,0:52:06.96,0:52:09.29,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:52:09.29,0:52:11.80,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:52:11.80,0:52:14.97,Default,,0000,0000,0000,,Бұл қиын кезең болуы керек.
Dialogue: 0,0:52:11.80,0:52:14.97,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:52:14.97,0:52:18.14,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:52:18.14,0:52:21.14,Default,,0000,0000,0000,,Мұғалім! Келесі жолы ішуді қалайсыз ба?
Dialogue: 0,0:52:21.14,0:52:23.81,Default,,0000,0000,0000,,Жапон сакесінің үлкен таңдауы бар дүкен
Dialogue: 0,0:52:21.14,0:52:23.81,Default,,0000,0000,0000,,Мен таптым.
Dialogue: 0,0:52:23.81,0:52:25.81,Default,,0000,0000,0000,,Иә! ? Барайық!
Dialogue: 0,0:52:23.81,0:52:25.81,Default,,0000,0000,0000,,Аха….
Dialogue: 0,0:52:25.81,0:52:28.65,Default,,0000,0000,0000,,Бұл Кофудағы дүкен.
Dialogue: 0,0:52:25.81,0:52:28.65,Default,,0000,0000,0000,,Тұтқалары да жақсы...
Dialogue: 0,0:52:28.65,0:52:30.65,Default,,0000,0000,0000,,Уау! Күшті!
Dialogue: 0,0:52:43.49,0:52:45.60,Default,,0000,0000,0000,,Иә~ Иә~.
Dialogue: 0,0:52:52.50,0:52:55.01,Default,,0000,0000,0000,,📱
Dialogue: 0,0:53:20.13,0:53:23.03,Default,,0000,0000,0000,,Кеттік! Жаңа жылдың алғашқы кадры!
Dialogue: 0,0:53:24.97,0:53:27.14,Default,,0000,0000,0000,,Жұмыс күндері эскадрилья….
Dialogue: 0,0:53:27.14,0:53:30.31,Default,,0000,0000,0000,,Жұмыс киімінің инспекторы!
Dialogue: 0,0:53:30.31,0:53:34.81,Default,,0000,0000,0000,,Демалыс және жұмыс күндері арасында аздап өзгереді.
Dialogue: 0,0:53:34.81,0:53:37.81,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:53:34.81,0:53:37.81,Default,,0000,0000,0000,,Бүгін де шөп шабу!
Dialogue: 0,0:53:37.81,0:53:40.82,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:53:37.81,0:53:40.82,Default,,0000,0000,0000,,Ол қашан ашылды?
Dialogue: 0,0:53:40.82,0:53:42.82,Default,,0000,0000,0000,,О, бұл жақсы сұрақ.
Dialogue: 0,0:53:42.82,0:53:44.82,Default,,0000,0000,0000,,Биылғы жылдың шілде айы.
Dialogue: 0,0:53:46.99,0:53:48.99,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:53:48.99,0:53:51.16,Default,,0000,0000,0000,,Бар болғаны жарты жыл қалды! ?
Dialogue: 0,0:53:51.16,0:53:53.50,Default,,0000,0000,0000,,Ересектерге қатысты!
Dialogue: 0,0:53:53.50,0:53:56.83,Default,,0000,0000,0000,,Оны қалай да жұтып қой
Dialogue: 0,0:53:53.50,0:53:56.83,Default,,0000,0000,0000,,Жоспарлау Мен оны орындадым!
Dialogue: 0,0:53:56.83,0:54:00.77,Default,,0000,0000,0000,,Аки-чан….
Dialogue: 0,0:53:56.83,0:54:00.77,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:54:00.77,0:54:03.47,Default,,0000,0000,0000,,Түсіндім! Мен бірдеңе істеймін!
Dialogue: 0,0:54:07.78,0:54:10.61,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:54:10.61,0:54:13.28,Default,,0000,0000,0000,,Экскаватор!
Dialogue: 0,0:54:13.28,0:54:16.09,Default,,0000,0000,0000,,Жүр, кеттік!
Dialogue: 0,0:54:22.79,0:54:26.13,Default,,0000,0000,0000,,Охохо!
Dialogue: 0,0:54:22.79,0:54:26.13,Default,,0000,0000,0000,,Надешико-чан керемет!
Dialogue: 0,0:54:26.13,0:54:29.97,Default,,0000,0000,0000,,Өйткені мен мінсіз оқу курсын алдым.
Dialogue: 0,0:54:26.13,0:54:29.97,Default,,0000,0000,0000,,Маған қалдырыңыз!
Dialogue: 0,0:54:29.97,0:54:33.07,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:54:29.97,0:54:33.07,Default,,0000,0000,0000,,Біз де бастайық!
Dialogue: 0,0:54:36.81,0:54:38.98,Default,,0000,0000,0000,,Бұл шөп шабатын машина!
Dialogue: 0,0:54:38.98,0:54:41.48,Default,,0000,0000,0000,,Оказаки мырза оны маған қарызға берді.
Dialogue: 0,0:54:44.15,0:54:48.05,Default,,0000,0000,0000,,Бұл жігітпен одан сайын қиясың!
Dialogue: 0,0:54:44.15,0:54:48.05,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:55:07.77,0:55:10.47,Default,,0000,0000,0000,,Кернеу жоғары.
Dialogue: 0,0:55:15.78,0:55:19.62,Default,,0000,0000,0000,,＜ Мұнда лагерь жасау үшін.
Dialogue: 0,0:55:15.78,0:55:19.62,Default,,0000,0000,0000,,Шолу.
Dialogue: 0,0:55:19.62,0:55:21.95,Default,,0000,0000,0000,,Алдымен шөпті кесіңіз.
Dialogue: 0,0:55:21.95,0:55:24.62,Default,,0000,0000,0000,,Үлкен аумақтар үшін шөп шапқышты пайдаланыңыз➡
Dialogue: 0,0:55:24.62,0:55:28.32,Default,,0000,0000,0000,,Тар кеңістікте, қолмен кесу＞
Dialogue: 0,0:55:30.29,0:55:33.46,Default,,0000,0000,0000,,<Сонымен қатар жерді гидравликалық экскаватормен тегістеу.
Dialogue: 0,0:55:33.46,0:55:36.57,Default,,0000,0000,0000,,Біз сынған баспалдақтарды да жөндейміз＞
Dialogue: 0,0:55:39.30,0:55:43.31,Default,,0000,0000,0000,,< Түпнұсқа нысан
Dialogue: 0,0:55:39.30,0:55:43.31,Default,,0000,0000,0000,,Әкімшілік ғимаратын жөндеу＞
Dialogue: 0,0:55:43.31,0:55:45.81,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:55:45.81,0:55:48.48,Default,,0000,0000,0000,,<Қанағаттану.
Dialogue: 0,0:55:48.48,0:55:51.58,Default,,0000,0000,0000,,Кестені басқару＞
Dialogue: 0,0:55:57.65,0:56:00.16,Default,,0000,0000,0000,,<Әрекеттерді қарастыру>
Dialogue: 0,0:56:03.26,0:56:05.76,Default,,0000,0000,0000,,<Су жөндеу>
Dialogue: 0,0:56:08.93,0:56:11.03,Default,,0000,0000,0000,,<Және т.б.>
Dialogue: 0,0:56:24.61,0:56:26.62,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:56:31.45,0:56:33.46,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:56:33.46,0:56:35.79,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:56:35.79,0:56:38.96,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:56:38.96,0:56:41.80,Default,,0000,0000,0000,,Иә! Аки-чан!
Dialogue: 0,0:56:41.80,0:56:44.63,Default,,0000,0000,0000,,Бұл қиын! бос орын!
Dialogue: 0,0:56:41.80,0:56:44.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:56:44.63,0:56:46.97,Default,,0000,0000,0000,,Біздің тағам...
Dialogue: 0,0:56:46.97,0:56:49.14,Default,,0000,0000,0000,,Қоқыс қоймасы...
Dialogue: 0,0:56:49.14,0:56:52.81,Default,,0000,0000,0000,,Оны бұзып жатыр!
Dialogue: 0,0:56:52.81,0:56:55.81,Default,,0000,0000,0000,,Жақын жерде тұратын жануар ма?
Dialogue: 0,0:56:55.81,0:56:57.81,Default,,0000,0000,0000,,Мұндағы таулар ➡
Dialogue: 0,0:56:57.81,0:57:00.75,Default,,0000,0000,0000,,Бұғылар, қабандар, маймылдар
Dialogue: 0,0:56:57.81,0:57:00.75,Default,,0000,0000,0000,,Бұл қалыпты жағдай.
Dialogue: 0,0:57:00.75,0:57:05.09,Default,,0000,0000,0000,,шаралар қабылдау
Dialogue: 0,0:57:00.75,0:57:05.09,Default,,0000,0000,0000,,Біз оның шын мәнінде кім екенін анықтауымыз керек.
Dialogue: 0,0:57:05.09,0:57:07.26,Default,,0000,0000,0000,,Қабан болса ше?➡
Dialogue: 0,0:57:07.26,0:57:09.43,Default,,0000,0000,0000,,Біз де бақылап отырамыз
Dialogue: 0,0:57:07.26,0:57:09.43,Default,,0000,0000,0000,,Бұл қауіпті емес пе?
Dialogue: 0,0:57:09.43,0:57:12.26,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:57:12.26,0:57:14.93,Default,,0000,0000,0000,,Ой! Хехе.
Dialogue: 0,0:57:14.93,0:57:17.53,Default,,0000,0000,0000,,Лайықты адам бар!
Dialogue: 0,0:57:20.10,0:57:34.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:34.78,0:57:36.79,Default,,0000,0000,0000,,Мынаны Джинжер көріп тұр➡
Dialogue: 0,0:57:36.79,0:57:39.29,Default,,0000,0000,0000,,Бейнефильм дегенді қалай түсінесіңдер?
Dialogue: 0,0:57:36.79,0:57:39.29,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:57:39.29,0:57:42.29,Default,,0000,0000,0000,,Егер сіз оларды сәтті шығара алсаңыз
Dialogue: 0,0:57:39.29,0:57:42.29,Default,,0000,0000,0000,,Жарайды, бірақ...
Dialogue: 0,0:57:46.46,0:57:49.30,Default,,0000,0000,0000,,А, не бар?
Dialogue: 0,0:57:49.30,0:57:52.30,Default,,0000,0000,0000,,Тас, қағаз, қайшы ойнаймыз!
Dialogue: 0,0:57:52.30,0:57:54.80,Default,,0000,0000,0000,,Тас, қағаз, қайшы....
Dialogue: 0,0:57:56.97,0:57:59.81,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:57:59.81,0:58:01.74,Default,,0000,0000,0000,,Джинжер-кун!
Dialogue: 0,0:58:01.74,0:58:04.75,Default,,0000,0000,0000,,Күте тұрыңыз... бұл қауіпті!
Dialogue: 0,0:58:07.25,0:58:09.45,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:58:17.59,0:58:19.60,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:58:19.60,0:58:22.43,Default,,0000,0000,0000,,Бұл не, ракон?
Dialogue: 0,0:58:22.43,0:58:25.60,Default,,0000,0000,0000,,Жабайы қабан болмағанына қуаныштымын...
Dialogue: 0,0:58:25.60,0:58:28.94,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:58:25.60,0:58:28.94,Default,,0000,0000,0000,,Тамақты сыртта қалдырмаңыз➡
Dialogue: 0,0:58:28.94,0:58:30.94,Default,,0000,0000,0000,,Ескерту қажет.
Dialogue: 0,0:58:30.94,0:58:34.04,Default,,0000,0000,0000,,Бұл менің жоғалтуым.
Dialogue: 0,0:58:59.64,0:59:02.04,Default,,0000,0000,0000,,Рин-чан!
Dialogue: 0,0:59:04.41,0:59:06.41,Default,,0000,0000,0000,,Асығыңыз, асығыңыз!
Dialogue: 0,0:59:28.77,0:59:30.93,Default,,0000,0000,0000,,Сіз біршама жетістіктерге жеттіңіз, солай емес пе?
Dialogue: 0,0:59:30.93,0:59:32.94,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:59:41.11,0:59:43.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:43.11,0:59:46.32,Default,,0000,0000,0000,,Рин-чан! Бірдеңе келе жатыр!
Dialogue: 0,0:59:48.62,0:59:50.79,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:59:48.62,0:59:50.79,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:59:50.79,0:59:53.29,Default,,0000,0000,0000,,Ха ха ха... Ааа!
Dialogue: 0,0:59:53.29,0:59:55.96,Default,,0000,0000,0000,,Чикувада~!
Dialogue: 0,0:59:55.96,0:59:58.13,Default,,0000,0000,0000,,Уф-уф….
Dialogue: 0,0:59:58.13,1:00:00.63,Default,,0000,0000,0000,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,1:00:00.63,1:00:03.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:00:03.80,1:00:08.14,Default,,0000,0000,0000,,Хехе, тым көңілді болып тұрсың.
Dialogue: 0,1:00:08.14,1:00:12.31,Default,,0000,0000,0000,,Чикува да қарт кісі.
Dialogue: 0,1:00:12.31,1:00:15.98,Default,,0000,0000,0000,,О! Барлығы осында.
Dialogue: 0,1:00:15.98,1:00:20.15,Default,,0000,0000,0000,,Менің жүгім осындай.
Dialogue: 0,1:00:20.15,1:00:24.32,Default,,0000,0000,0000,,Содан кейін біздің лагерьде.
Dialogue: 0,1:00:20.15,1:00:24.32,Default,,0000,0000,0000,,Бірінші сынақ лагері!
Dialogue: 0,1:00:24.32,1:00:26.52,Default,,0000,0000,0000,,Көріп көрейік!
Dialogue: 0,1:00:28.49,1:00:30.49,Default,,0000,0000,0000,,Бұл шатыр
Dialogue: 0,1:00:28.49,1:00:30.49,Default,,0000,0000,0000,,Надешико-чанмен➡
Dialogue: 0,1:00:30.49,1:00:32.50,Default,,0000,0000,0000,,Олар оны жалға алып жатыр.
Dialogue: 0,1:00:32.50,1:00:35.30,Default,,0000,0000,0000,,Ей, мен де солай істеп жатырмын.
Dialogue: 0,1:00:37.33,1:00:41.17,Default,,0000,0000,0000,,Үлкен!
Dialogue: 0,1:00:37.33,1:00:41.17,Default,,0000,0000,0000,,Менің ойымша, мұнымен бәрі ұйықтай алады.
Dialogue: 0,1:00:41.17,1:00:44.67,Default,,0000,0000,0000,,Жақтауды құрастыру Жарайды!
Dialogue: 0,1:00:41.17,1:00:44.67,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:00:47.18,1:00:49.68,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,1:00:52.85,1:00:55.69,Default,,0000,0000,0000,,Күрсіну…. Жақсы.
Dialogue: 0,1:00:55.69,1:00:58.52,Default,,0000,0000,0000,,Шатыр аяқталды!
Dialogue: 0,1:00:58.52,1:01:01.29,Default,,0000,0000,0000,,Сіз мұны істей алдыңыз.
Dialogue: 0,1:00:58.52,1:01:01.29,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:01:01.29,1:01:04.96,Default,,0000,0000,0000,,Дәл осылай басқа құралдарды да пайдаланыңыз.
Dialogue: 0,1:01:01.29,1:01:04.96,Default,,0000,0000,0000,,Оны тез жинап алайық.
Dialogue: 0,1:01:04.96,1:01:17.64,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:01:17.64,1:01:20.48,Default,,0000,0000,0000,,Аои-чан
Dialogue: 0,1:01:17.64,1:01:20.48,Default,,0000,0000,0000,,Бүгін осымен барайық!
Dialogue: 0,1:01:20.48,1:01:24.81,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:01:20.48,1:01:24.81,Default,,0000,0000,0000,,Басқа адам үшін кем болма.
Dialogue: 0,1:01:24.81,1:01:28.02,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,1:01:30.15,1:01:33.66,Default,,0000,0000,0000,,Рин Бұл жақсы ма?
Dialogue: 0,1:01:30.15,1:01:33.66,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:01:39.00,1:01:42.67,Default,,0000,0000,0000,,Woof woof woof….
Dialogue: 0,1:01:42.67,1:01:44.83,Default,,0000,0000,0000,,Ау? Бір!
Dialogue: 0,1:01:44.83,1:01:47.84,Default,,0000,0000,0000,,Хехе, жақсымын, жақсымын.
Dialogue: 0,1:01:47.84,1:01:51.17,Default,,0000,0000,0000,,Мен үйдемін.
Dialogue: 0,1:01:47.84,1:01:51.17,Default,,0000,0000,0000,,Мен сатып алуды аяқтадым.
Dialogue: 0,1:01:51.17,1:01:53.18,Default,,0000,0000,0000,,Қайтадан қош келдіңіз.
Dialogue: 0,1:01:53.18,1:01:55.58,Default,,0000,0000,0000,,О!
Dialogue: 0,1:01:53.18,1:01:55.58,Default,,0000,0000,0000,,Өте жақсы орындалды!
Dialogue: 0,1:01:57.51,1:02:00.95,Default,,0000,0000,0000,,Материалдар дұрыс па?
Dialogue: 0,1:01:57.51,1:02:00.95,Default,,0000,0000,0000,,Көрейік.
Dialogue: 0,1:02:00.95,1:02:03.95,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:02:00.95,1:02:03.95,Default,,0000,0000,0000,,Мен қазанды әкелуді ұмытып кетіппін.
Dialogue: 0,1:02:03.95,1:02:07.96,Default,,0000,0000,0000,,Аки-чан, мен сенің жүгіңді апарамын.
Dialogue: 0,1:02:03.95,1:02:07.96,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:02:07.96,1:02:11.29,Default,,0000,0000,0000,,Уа! Бұл ағаш пеш!
Dialogue: 0,1:02:11.29,1:02:13.30,Default,,0000,0000,0000,,Нихихи.
Dialogue: 0,1:02:13.30,1:02:16.80,Default,,0000,0000,0000,,Бұл да менің дүкенімде.
Dialogue: 0,1:02:13.30,1:02:16.80,Default,,0000,0000,0000,,Бұл мен жалға алғаным.
Dialogue: 0,1:02:16.80,1:02:18.80,Default,,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,1:02:27.64,1:02:30.15,Default,,0000,0000,0000,,Бұл әткеншек...
Dialogue: 0,1:02:30.15,1:02:33.35,Default,,0000,0000,0000,,Мен оны әкелмеуім керек сияқты.
Dialogue: 0,1:02:43.83,1:02:46.53,Default,,0000,0000,0000,,Бұл жақсы көрінеді.
Dialogue: 0,1:02:58.34,1:03:02.04,Default,,0000,0000,0000,,Иә~ Иә~.
Dialogue: 0,1:03:13.29,1:03:15.29,Default,,0000,0000,0000,,Бүгінгі ингредиенттер...
Dialogue: 0,1:03:15.29,1:03:17.29,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:03:17.29,1:03:19.30,Default,,0000,0000,0000,,Лосось!
Dialogue: 0,1:03:19.30,1:03:21.96,Default,,0000,0000,0000,,Жарайды, екеу болсын.
Dialogue: 0,1:03:19.30,1:03:21.96,Default,,0000,0000,0000,,Бұл тым көп емес пе?
Dialogue: 0,1:03:21.96,1:03:24.47,Default,,0000,0000,0000,,Шатасып кетті
Dialogue: 0,1:03:21.96,1:03:24.47,Default,,0000,0000,0000,,Бұл мәміле болды.
Dialogue: 0,1:03:24.47,1:03:28.30,Default,,0000,0000,0000,,Бүгін лосось фестивалі!
Dialogue: 0,1:03:28.30,1:03:32.31,Default,,0000,0000,0000,,<Албырт балық сорпасын жасау жолы.
Dialogue: 0,1:03:32.31,1:03:34.81,Default,,0000,0000,0000,,Алдымен қайнап тұрған суға саламыз➡
Dialogue: 0,1:03:34.81,1:03:38.15,Default,,0000,0000,0000,,Дәнді бұрыш Лавр жапырағы➡
Dialogue: 0,1:03:38.15,1:03:41.98,Default,,0000,0000,0000,,туралған
Dialogue: 0,1:03:38.15,1:03:41.98,Default,,0000,0000,0000,,Пияз бен сәбізді қосыңыз➡
Dialogue: 0,1:03:41.98,1:03:46.16,Default,,0000,0000,0000,,Аздап қайнатыңыз
Dialogue: 0,1:03:41.98,1:03:46.16,Default,,0000,0000,0000,,Содан кейін картопты қосыңыз.
Dialogue: 0,1:03:46.16,1:03:48.99,Default,,0000,0000,0000,,Қайнағанша біраз күтіңіз>
Dialogue: 0,1:03:48.99,1:03:53.60,Default,,0000,0000,0000,,Ол қандай тағам болады?
Dialogue: 0,1:03:48.99,1:03:53.60,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,1:03:48.99,1:03:53.60,Default,,0000,0000,0000,,Уууу.
Dialogue: 0,1:03:55.67,1:04:00.87,Default,,0000,0000,0000,,Мүмкін, уы ма?
Dialogue: 0,1:03:55.67,1:04:00.87,Default,,0000,0000,0000,,Абури лосось зура үшін.
Dialogue: 0,1:04:05.27,1:04:07.78,Default,,0000,0000,0000,,Куха~! Хахахаха!
Dialogue: 0,1:04:07.78,1:04:11.98,Default,,0000,0000,0000,,Мен мұны білмей тұрып...
Dialogue: 0,1:04:07.78,1:04:11.98,Default,,0000,0000,0000,,Ол сөзсіз 2-ші ұрпақ Губи-ни.
Dialogue: 0,1:04:14.62,1:04:17.12,Default,,0000,0000,0000,,<Көкөністер піскен кезде➡
Dialogue: 0,1:04:17.12,1:04:20.29,Default,,0000,0000,0000,,Негізгі лосось қосыңыз.
Dialogue: 0,1:04:20.29,1:04:24.13,Default,,0000,0000,0000,,Енді жаңа кілегей мен тұзды қосыңыз➡
Dialogue: 0,1:04:24.13,1:04:27.13,Default,,0000,0000,0000,,Соңында аскөк➡ қосыңыз
Dialogue: 0,1:04:27.13,1:04:29.47,Default,,0000,0000,0000,,Лосось сорпасы аяқталды＞
Dialogue: 0,1:04:29.47,1:04:31.47,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:04:31.47,1:04:33.77,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,1:04:35.97,1:04:38.07,Default,,0000,0000,0000,,Ааа...
Dialogue: 0,1:04:40.64,1:04:42.98,Default,,0000,0000,0000,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,1:04:42.98,1:04:45.65,Default,,0000,0000,0000,,Күрсін! Бұл өте жылы!
Dialogue: 0,1:04:45.65,1:04:48.99,Default,,0000,0000,0000,,Қарапайым, бірақ бай
Dialogue: 0,1:04:45.65,1:04:48.99,Default,,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,1:04:48.99,1:04:50.99,Default,,0000,0000,0000,,Эххе жақсы!
Dialogue: 0,1:04:50.99,1:04:53.49,Default,,0000,0000,0000,,《Албырт балық пен көкөністердің дәмді дәмі➡
Dialogue: 0,1:04:53.49,1:04:57.29,Default,,0000,0000,0000,,Құрамында жаңа крем бар
Dialogue: 0,1:04:53.49,1:04:57.29,Default,,0000,0000,0000,,Жұмсақ сорпаға ерітіңіз...》
Dialogue: 0,1:05:00.43,1:05:02.43,Default,,0000,0000,0000,,《Дәмді~》
Dialogue: 0,1:05:02.43,1:05:05.77,Default,,0000,0000,0000,,Чикуваның үлесі
Dialogue: 0,1:05:02.43,1:05:05.77,Default,,0000,0000,0000,,Ол бөлек жасалған.
Dialogue: 0,1:05:05.77,1:05:07.77,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,1:05:05.77,1:05:07.77,Default,,0000,0000,0000,,Надешико-чан.
Dialogue: 0,1:05:07.77,1:05:10.44,Default,,0000,0000,0000,,Оның иісі керемет.
Dialogue: 0,1:05:10.44,1:05:12.44,Default,,0000,0000,0000,,Аскөктің иісі бар.
Dialogue: 0,1:05:12.44,1:05:15.78,Default,,0000,0000,0000,,Бұл шөптің бір түрі.
Dialogue: 0,1:05:12.44,1:05:15.78,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:05:15.78,1:05:18.78,Default,,0000,0000,0000,,Сергітетін иіс
Dialogue: 0,1:05:15.78,1:05:18.78,Default,,0000,0000,0000,,Лосось қосылған тамаша.
Dialogue: 0,1:05:18.78,1:05:23.12,Default,,0000,0000,0000,,Иә, фин орманында
Дәмі
Dialogue: 0,1:05:18.78,1:05:23.12,Default,,0000,0000,0000,,сияқты.
Dialogue: 0,1:05:23.12,1:05:26.32,Default,,0000,0000,0000,,Оның дәмі қандай?
Dialogue: 0,1:05:23.12,1:05:26.32,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:05:28.79,1:05:31.46,Default,,0000,0000,0000,,О, бітуге жақын...
Dialogue: 0,1:05:31.46,1:05:33.96,Default,,0000,0000,0000,,5 адам болса, бір сәт болады.
Dialogue: 0,1:05:33.96,1:05:37.63,Default,,0000,0000,0000,,Фуфуфуфу Аки-чан
Dialogue: 0,1:05:33.96,1:05:37.63,Default,,0000,0000,0000,,Әлі біткен жоқ.
Dialogue: 0,1:05:37.63,1:05:39.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:05:39.64,1:05:43.54,Default,,0000,0000,0000,,Бұл жерде қайнайтын уақыт жақындап қалды.
Dialogue: 0,1:05:45.47,1:05:48.14,Default,,0000,0000,0000,,Тағы бір кастрюль! ?
Dialogue: 0,1:05:45.47,1:05:48.14,Default,,0000,0000,0000,,Мен мұны білмей тұрып...
Dialogue: 0,1:05:48.14,1:05:50.48,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,1:05:50.48,1:05:53.32,Default,,0000,0000,0000,,Лосось фестивалі басталғалы жатыр!
Dialogue: 0,1:05:53.32,1:05:55.65,Default,,0000,0000,0000,,Юбамен Ишикари набе!
Dialogue: 0,1:05:55.65,1:05:57.65,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:05:57.65,1:06:00.06,Default,,0000,0000,0000,,Иә~ Иә~.
Dialogue: 0,1:06:01.92,1:06:05.43,Default,,0000,0000,0000,,Хмм! Эй, эй!
Dialogue: 0,1:06:05.43,1:06:07.43,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,1:06:07.43,1:06:10.10,Default,,0000,0000,0000,,《Мисо хош иісі мені жеңілдетеді》
Dialogue: 0,1:06:10.10,1:06:13.77,Default,,0000,0000,0000,,Ишикари хотпотындағы Юба
Dialogue: 0,1:06:10.10,1:06:13.77,Default,,0000,0000,0000,,Бұл таңқаларлық сәйкес келеді.
Dialogue: 0,1:06:13.77,1:06:16.61,Default,,0000,0000,0000,,Минобу сәл жақсы Юба
Dialogue: 0,1:06:13.77,1:06:16.61,Default,,0000,0000,0000,,Моротена~.
Dialogue: 0,1:06:16.61,1:06:19.78,Default,,0000,0000,0000,,Дәмді араластырыңыз
Dialogue: 0,1:06:16.61,1:06:19.78,Default,,0000,0000,0000,,Сүт пен майды да қостым.
Dialogue: 0,1:06:19.78,1:06:21.94,Default,,0000,0000,0000,,Сондықтан да жұмсақ.
Dialogue: 0,1:06:21.94,1:06:24.61,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,1:06:21.94,1:06:24.61,Default,,0000,0000,0000,,Шиме – Хотойя.
Dialogue: 0,1:06:24.61,1:06:27.12,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:06:24.61,1:06:27.12,Default,,0000,0000,0000,,Аои-чан күткендей!
Dialogue: 0,1:06:27.12,1:06:29.95,Default,,0000,0000,0000,,Сіз заттарды ретке келтіруге шеберсіз.
Dialogue: 0,1:06:29.95,1:06:31.95,Default,,0000,0000,0000,,(Бекки) Ах, емтихандар аяқталды — ақыры тыныш күндер келді~
Dialogue: 0,1:06:31.95,1:06:34.46,Default,,0000,0000,0000,,Лагерьде өзіміз тұрдық.
Dialogue: 0,1:06:31.95,1:06:34.46,Default,,0000,0000,0000,,Тамақтану➡
Dialogue: 0,1:06:34.46,1:06:37.13,Default,,0000,0000,0000,,Кемпинг тағамдары ең жақсы!
Dialogue: 0,1:06:37.13,1:06:39.63,Default,,0000,0000,0000,,Ол әлі дайын емес.
Dialogue: 0,1:06:39.63,1:06:45.30,Default,,0000,0000,0000,,Бірақ бұл шынымен бе?
Dialogue: 0,1:06:39.63,1:06:45.30,Default,,0000,0000,0000,,Бұл өте сәнді, солай емес пе?
Dialogue: 0,1:06:45.30,1:06:47.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:06:47.97,1:06:51.47,Default,,0000,0000,0000,,Бұл қиын, бірақ қиын.
Dialogue: 0,1:06:47.97,1:06:51.47,Default,,0000,0000,0000,,Егер сіз тырыссаңыз, мұны істей аласыз.
Dialogue: 0,1:06:51.47,1:06:53.48,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:06:58.98,1:07:00.98,Default,,0000,0000,0000,,Бір?
Dialogue: 0,1:07:02.92,1:07:05.02,Default,,0000,0000,0000,,Ау?
Dialogue: 0,1:07:08.76,1:07:10.76,Default,,0000,0000,0000,,Ена-чан, қара түсті ме?
Dialogue: 0,1:07:10.76,1:07:12.76,Default,,0000,0000,0000,,Иә, рахмет.
Dialogue: 0,1:07:12.76,1:07:16.43,Default,,0000,0000,0000,,Уақыт келді
Dialogue: 0,1:07:12.76,1:07:16.43,Default,,0000,0000,0000,,Пайдалану нұсқаулығы туралы ойламаңыз.
Dialogue: 0,1:07:16.43,1:07:18.43,Default,,0000,0000,0000,,Мен бұл туралы ойлап отырмын.
Dialogue: 0,1:07:18.43,1:07:20.44,Default,,0000,0000,0000,,Надешико-чан күткендей.
Dialogue: 0,1:07:20.44,1:07:22.61,Default,,0000,0000,0000,,Мен ойлаған тағы бір нәрсе➡
Dialogue: 0,1:07:22.61,1:07:25.61,Default,,0000,0000,0000,,Осы жерден дәретханаға дейін
Dialogue: 0,1:07:22.61,1:07:25.61,Default,,0000,0000,0000,,Бұл өте алыс.
Dialogue: 0,1:07:25.61,1:07:27.61,Default,,0000,0000,0000,,А... әрине.
Dialogue: 0,1:07:27.61,1:07:31.28,Default,,0000,0000,0000,,Жолда бұдырлар бар
Dialogue: 0,1:07:27.61,1:07:31.28,Default,,0000,0000,0000,,Ертерек құлап қала жаздадым.
Dialogue: 0,1:07:31.28,1:07:34.95,Default,,0000,0000,0000,,Өйткені баспалдақтар көп
Dialogue: 0,1:07:31.28,1:07:34.95,Default,,0000,0000,0000,,Жүкті алып жүру қиын емес пе?
Dialogue: 0,1:07:34.95,1:07:37.12,Default,,0000,0000,0000,,Арбаны жалға алу➡
Dialogue: 0,1:07:37.12,1:07:39.62,Default,,0000,0000,0000,,Олардың еңісті пайдаланғаны дұрыс.
Dialogue: 0,1:07:37.12,1:07:39.62,Default,,0000,0000,0000,,Мүмкін жақсы шығар.
Dialogue: 0,1:07:39.62,1:07:42.53,Default,,0000,0000,0000,,Әлі де шешімін күткен мәселелер бар сияқты.
Dialogue: 0,1:07:44.63,1:07:46.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:07:48.63,1:07:51.63,Default,,0000,0000,0000,,Әй, неге ол жаққа бармайсың?
Dialogue: 0,1:07:51.63,1:07:53.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:07:59.48,1:08:01.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:08:04.41,1:08:06.75,Default,,0000,0000,0000,,Мен ойлағандай.
Dialogue: 0,1:08:06.75,1:08:09.42,Default,,0000,0000,0000,,Бұл планетарий сияқты.
Dialogue: 0,1:08:09.42,1:08:12.09,Default,,0000,0000,0000,,Біртүрлі сезіледі.
Dialogue: 0,1:08:12.09,1:08:14.09,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,1:08:14.09,1:08:19.26,Default,,0000,0000,0000,,Қиындықтарға қарамастан
Dialogue: 0,1:08:14.09,1:08:19.26,Default,,0000,0000,0000,,Бәлкім, сіз оған күш салсаңыз, ләззат аласыз.
Dialogue: 0,1:08:19.26,1:08:21.93,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:08:21.93,1:08:23.93,Default,,0000,0000,0000,,Каа~!
Dialogue: 0,1:08:23.93,1:08:25.94,Default,,0000,0000,0000,,Мен өте көңілдімін.
Dialogue: 0,1:08:28.60,1:08:30.61,Default,,0000,0000,0000,,О, Чикува!
Dialogue: 0,1:08:30.61,1:08:32.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:08:32.61,1:08:34.81,Default,,0000,0000,0000,,Сіз бірдеңе алдыңыз ба?
Dialogue: 0,1:08:38.45,1:08:40.45,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:08:40.45,1:08:42.95,Default,,0000,0000,0000,,Бұл гүл құмыра ма?
Dialogue: 0,1:08:42.95,1:08:45.62,Default,,0000,0000,0000,,Күтпеген жерден
Dialogue: 0,1:08:42.95,1:08:45.62,Default,,0000,0000,0000,,Бұл құнды нәрсе болды.
Dialogue: 0,1:08:45.62,1:08:48.62,Default,,0000,0000,0000,,Егер солай болса, сіз тамаша жұмыс жасадыңыз, Чикува!
Dialogue: 0,1:08:48.62,1:08:50.63,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,1:08:50.63,1:08:53.80,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:08:53.80,1:09:42.51,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:47.78,1:09:50.29,Default,,0000,0000,0000,,Хамф.
Dialogue: 0,1:09:50.29,1:09:53.29,Default,,0000,0000,0000,,Одан әрі ит жүгіруіне техникалық қызмет көрсету.
Dialogue: 0,1:09:53.29,1:09:56.46,Default,,0000,0000,0000,,Бұл жоспарланғаннан әлдеқайда ертерек, солай емес пе?
Dialogue: 0,1:09:56.46,1:09:59.46,Default,,0000,0000,0000,,Огаки. Бір сәтке бола ма?
Dialogue: 0,1:09:59.46,1:10:01.56,Default,,0000,0000,0000,,А, иә.
Dialogue: 0,1:10:04.63,1:10:06.64,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:10:14.31,1:10:17.31,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,1:10:14.31,1:10:17.31,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,1:10:22.48,1:10:24.82,Default,,0000,0000,0000,,Уа.
Dialogue: 0,1:10:22.48,1:10:24.82,Default,,0000,0000,0000,,📱 (дірілдеген дыбыс)
Dialogue: 0,1:10:24.82,1:10:26.82,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:10:26.82,1:10:29.16,Default,,0000,0000,0000,,📱 (Чиаки) О, шынында да.
Dialogue: 0,1:10:26.82,1:10:29.16,Default,,0000,0000,0000,,Лагерь алаңында➡
Dialogue: 0,1:10:29.16,1:10:31.83,Default,,0000,0000,0000,,Тергеу болады.
Dialogue: 0,1:10:31.83,1:10:34.33,Default,,0000,0000,0000,,Соңында біз оны U.A.-ға қабылдап алдық
Dialogue: 0,1:10:34.33,1:10:36.83,Default,,0000,0000,0000,,📱 (Чиаки) Өткен күні
Dialogue: 0,1:10:34.33,1:10:36.83,Default,,0000,0000,0000,,Чикува тапқан фрагмент➡
Dialogue: 0,1:10:36.83,1:10:38.83,Default,,0000,0000,0000,,Мен сенімді болу үшін бастығыма хабарладым➡
Dialogue: 0,1:10:38.83,1:10:41.17,Default,,0000,0000,0000,,Шынайы фаянс жасау мүмкіндігі
Dialogue: 0,1:10:38.83,1:10:41.17,Default,,0000,0000,0000,,Ол шықты.
Dialogue: 0,1:10:41.17,1:10:43.17,Default,,0000,0000,0000,,Ыдыс-аяқ?
Dialogue: 0,1:10:43.17,1:10:45.34,Default,,0000,0000,0000,,📱 (Чиаки) Яманаши
Dialogue: 0,1:10:43.17,1:10:45.34,Default,,0000,0000,0000,,Бірнеше орын➡
Dialogue: 0,1:10:45.34,1:10:48.34,Default,,0000,0000,0000,,Сіз қыш ыдыстарды табасыз.
Dialogue: 0,1:10:45.34,1:10:48.34,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:10:48.34,1:10:50.35,Default,,0000,0000,0000,,📱 (Чиаки) Жақсы
Dialogue: 0,1:10:48.34,1:10:50.35,Default,,0000,0000,0000,,Қарап көремін десем де➡
Dialogue: 0,1:10:50.35,1:10:52.85,Default,,0000,0000,0000,,Ең көбі 1-2 апта қажет сияқты.
Dialogue: 0,1:10:52.85,1:10:55.68,Default,,0000,0000,0000,,Содан кейін бұл аяқталған кезде
Dialogue: 0,1:10:52.85,1:10:55.68,Default,,0000,0000,0000,,Қайта бастауға болады, солай ма?
Dialogue: 0,1:10:55.68,1:10:57.69,Default,,0000,0000,0000,,📱 (Чиаки) Жүр!
Dialogue: 0,1:10:57.69,1:10:59.86,Default,,0000,0000,0000,,Біз қайта ашылғанша жабыламыз.
Dialogue: 0,1:10:59.86,1:11:02.63,Default,,0000,0000,0000,,📱 (Чиаки) Ах. бәрібір
Dialogue: 0,1:10:59.86,1:11:02.63,Default,,0000,0000,0000,,Мәліметтер анық болғаннан кейін➡
Dialogue: 0,1:11:02.63,1:11:04.79,Default,,0000,0000,0000,,Мен сізге бірден хабарласамын➡
Dialogue: 0,1:11:04.79,1:11:07.80,Default,,0000,0000,0000,,Біраз уақытқа
Dialogue: 0,1:11:04.79,1:11:07.80,Default,,0000,0000,0000,,Сабыр етіңіз.
Dialogue: 0,1:11:07.80,1:11:11.50,Default,,0000,0000,0000,,Иә... түсіндім. жақсы.
Dialogue: 0,1:11:14.80,1:11:16.81,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:11:16.81,1:11:19.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:11:16.81,1:11:19.31,Default,,0000,0000,0000,,Қария да солай істеп жатыр ма?
Dialogue: 0,1:11:19.31,1:11:21.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:11:19.31,1:11:21.48,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,1:11:21.48,1:11:25.48,Default,,0000,0000,0000,,Біраз уақыттан кейін бірінші рет баспаханаға бардым.
Dialogue: 0,1:11:21.48,1:11:25.48,Default,,0000,0000,0000,,Сәлем айтқым келді.
Dialogue: 0,1:11:25.48,1:11:27.82,Default,,0000,0000,0000,,Жұмысыңыз көп емес пе?
Dialogue: 0,1:11:27.82,1:11:30.32,Default,,0000,0000,0000,,Неге оны Шима-кунға да бермейсің?
Dialogue: 0,1:11:30.32,1:11:33.49,Default,,0000,0000,0000,,Мен қазір не істегім келеді➡
Dialogue: 0,1:11:33.49,1:11:36.83,Default,,0000,0000,0000,,Толығымен
Dialogue: 0,1:11:33.49,1:11:36.83,Default,,0000,0000,0000,,Сіз назар аударғыңыз келеді.
Dialogue: 0,1:11:36.83,1:11:40.33,Default,,0000,0000,0000,,Ха...
Dialogue: 0,1:11:36.83,1:11:40.33,Default,,0000,0000,0000,,Мүмкін өсудің уақыты келді.
Dialogue: 0,1:11:40.33,1:11:43.33,Default,,0000,0000,0000,,А...
Dialogue: 0,1:11:40.33,1:11:43.33,Default,,0000,0000,0000,,Қария мырза!
Dialogue: 0,1:11:43.33,1:11:45.50,Default,,0000,0000,0000,,Сіз мұны естіген шығарсыз?
Dialogue: 0,1:11:45.50,1:11:48.00,Default,,0000,0000,0000,,Мені де баспаханаға апарыңызшы.
Dialogue: 0,1:11:48.00,1:11:50.34,Default,,0000,0000,0000,,Иә? бірақ….
Dialogue: 0,1:11:50.34,1:11:54.18,Default,,0000,0000,0000,,Менің бүгін Яманашиге бару жоспарым жоқ.
Dialogue: 0,1:11:54.18,1:11:56.88,Default,,0000,0000,0000,,Аа, дұрыс...
Dialogue: 0,1:12:00.62,1:12:03.62,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,1:12:00.62,1:12:03.62,Default,,0000,0000,0000,,Жақсы қыз Жақсы қыз.
Dialogue: 0,1:12:03.62,1:12:05.62,Default,,0000,0000,0000,,Мен сізді алып кетуге келгенше күте тұрыңыз.
Dialogue: 0,1:12:05.62,1:12:07.82,Default,,0000,0000,0000,,Бір!
Dialogue: 0,1:12:12.80,1:12:15.13,Default,,0000,0000,0000,,Иә. Бұл дұрыс.
Dialogue: 0,1:12:15.13,1:12:18.30,Default,,0000,0000,0000,,Биіктікте және төменнен
Dialogue: 0,1:12:15.13,1:12:18.30,Default,,0000,0000,0000,,Себебі мен тоқтамаймын деп шештім.
Dialogue: 0,1:12:18.30,1:12:21.30,Default,,0000,0000,0000,,Мен тікелей үйге барамын.
Dialogue: 0,1:12:21.30,1:12:46.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:46.16,1:12:49.83,Default,,0000,0000,0000,,Әй, Аои-чан!
Dialogue: 0,1:12:46.16,1:12:49.83,Default,,0000,0000,0000,,«Бастап көріп, не боларын көрейік» дегендей. Хмм…
Dialogue: 0,1:12:49.83,1:12:52.17,Default,,0000,0000,0000,,Аои-чан емес
Dialogue: 0,1:12:49.83,1:12:52.17,Default,,0000,0000,0000,,Мұғалім.
Dialogue: 0,1:12:52.17,1:12:54.17,Default,,0000,0000,0000,,Эхехе….
Dialogue: 0,1:12:54.17,1:12:56.84,Default,,0000,0000,0000,,Қош бол! Аой-чан!
Dialogue: 0,1:12:56.84,1:13:00.78,Default,,0000,0000,0000,,Уууу.
Dialogue: 0,1:13:00.78,1:13:11.62,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:11.62,1:13:13.62,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,1:13:13.62,1:13:44.32,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:44.32,1:13:46.82,Default,,0000,0000,0000,,📱 (дірілдеген дыбыс)
Dialogue: 0,1:13:46.82,1:13:49.66,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,1:13:49.66,1:13:52.49,Default,,0000,0000,0000,,📱 (Чиаки) А... білесің бе...
Dialogue: 0,1:13:52.49,1:13:56.83,Default,,0000,0000,0000,,Мынау... әлгі фаянс➡
Dialogue: 0,1:13:56.83,1:14:00.27,Default,,0000,0000,0000,,Джомон дәуірінен болса керек...
Dialogue: 0,1:14:00.27,1:14:02.94,Default,,0000,0000,0000,,Үйінділерді қазу үшін➡
Dialogue: 0,1:14:02.94,1:14:06.78,Default,,0000,0000,0000,,Көптеген айларға
Dialogue: 0,1:14:02.94,1:14:06.78,Default,,0000,0000,0000,,Тергеу болады...
Dialogue: 0,1:14:06.78,1:14:09.28,Default,,0000,0000,0000,,Егер ол одан кейін ашылса...
Dialogue: 0,1:14:09.28,1:14:11.28,Default,,0000,0000,0000,,📱 (Чиаки) Жоқ, солай...
Dialogue: 0,1:14:11.28,1:14:14.78,Default,,0000,0000,0000,,Қыштан жасалған бұйымдар өте көп➡
Dialogue: 0,1:14:14.78,1:14:19.45,Default,,0000,0000,0000,,Сол жерді қирандыларға байланысты нысанға айналдырайық.
Dialogue: 0,1:14:14.78,1:14:19.45,Default,,0000,0000,0000,,шықты.
Dialogue: 0,1:14:19.45,1:14:21.46,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:14:21.46,1:14:24.13,Default,,0000,0000,0000,,📱 (Чиаки) Кемпинг салуды тоқтатыңыз➡
Dialogue: 0,1:14:24.13,1:14:27.30,Default,,0000,0000,0000,,Ол жермен не істеу керек?
Dialogue: 0,1:14:24.13,1:14:27.30,Default,,0000,0000,0000,,Мен қайта қарауды шештім.
Dialogue: 0,1:14:27.30,1:14:29.30,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:14:29.30,1:14:34.14,Default,,0000,0000,0000,,Лагерьді жоспарлау
Dialogue: 0,1:14:29.30,1:14:34.14,Default,,0000,0000,0000,,Қайта тірілу мүмкіндігі бар ма?
Dialogue: 0,1:14:34.14,1:14:36.47,Default,,0000,0000,0000,,📱 (Чиаки) қирандылары?
Dialogue: 0,1:14:34.14,1:14:36.47,Default,,0000,0000,0000,,Сол жерді қалай жандандыруға болады➡
Dialogue: 0,1:14:36.47,1:14:41.98,Default,,0000,0000,0000,,Бұл жақсы әңгіме
Dialogue: 0,1:14:36.47,1:14:41.98,Default,,0000,0000,0000,,Шынымды айтсам, бұл қиын болуы керек...
Dialogue: 0,1:14:41.98,1:14:44.48,Default,,0000,0000,0000,,Барлығына
Dialogue: 0,1:14:41.98,1:14:44.48,Default,,0000,0000,0000,,Маған көмектескен болсаң да➡
Dialogue: 0,1:14:44.48,1:14:46.48,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,1:14:46.48,1:15:12.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:15:56.82,1:15:58.82,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:15:58.82,1:16:01.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:16:04.93,1:16:08.03,Default,,0000,0000,0000,,Мұның бәрі ме?
Dialogue: 0,1:16:04.93,1:16:08.03,Default,,0000,0000,0000,,Иә. Бұл көмектесті.
Dialogue: 0,1:16:17.77,1:16:19.78,Default,,0000,0000,0000,,Мына жерді құртпақсың ба?
Dialogue: 0,1:16:19.78,1:16:22.11,Default,,0000,0000,0000,,Біз әлі сөйлесеміз.
Dialogue: 0,1:16:22.11,1:16:24.31,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:16:28.78,1:16:32.29,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:16:28.78,1:16:32.29,Default,,0000,0000,0000,,Уау! ? Ол аурады.
Dialogue: 0,1:16:32.29,1:16:34.62,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,1:16:32.29,1:16:34.62,Default,,0000,0000,0000,,Ихе хи хи.
Dialogue: 0,1:16:34.62,1:16:37.79,Default,,0000,0000,0000,,Жақсы жұмыс! Инуко.
Dialogue: 0,1:16:37.79,1:16:42.80,Default,,0000,0000,0000,,А... Иә, рахмет.
Dialogue: 0,1:16:42.80,1:16:46.80,Default,,0000,0000,0000,,басқа
Dialogue: 0,1:16:42.80,1:16:46.80,Default,,0000,0000,0000,,Мен мұғалімдік жұмысымды тастап кете алмаймын.
Dialogue: 0,1:16:46.80,1:16:50.11,Default,,0000,0000,0000,,Жаңа бастауыш мектеп
Dialogue: 0,1:16:46.80,1:16:50.11,Default,,0000,0000,0000,,Мен жай ғана қозғалып жатырмын.
Dialogue: 0,1:16:54.81,1:16:57.81,Default,,0000,0000,0000,,Бірақ... Мен жалғызбын.
Dialogue: 0,1:16:57.81,1:17:11.26,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:17:11.26,1:17:13.26,Default,,0000,0000,0000,,О, құдайым.
Dialogue: 0,1:17:13.26,1:17:15.76,Default,,0000,0000,0000,,Бұл өтірік!
Dialogue: 0,1:17:18.10,1:17:21.77,Default,,0000,0000,0000,,Аа... Сіз!
Dialogue: 0,1:17:21.77,1:17:23.94,Default,,0000,0000,0000,,Эй, сен мені алдадың!
Dialogue: 0,1:17:23.94,1:17:25.94,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:17:23.94,1:17:25.94,Default,,0000,0000,0000,,Күте тұрыңыз~ Эй!
Dialogue: 0,1:17:25.94,1:17:27.94,Default,,0000,0000,0000,,Біраз
Dialogue: 0,1:17:25.94,1:17:27.94,Default,,0000,0000,0000,,Аки мен суланамын!
Dialogue: 0,1:17:27.94,1:17:30.45,Default,,0000,0000,0000,,Үрлеу құрылғысы
Dialogue: 0,1:17:27.94,1:17:30.45,Default,,0000,0000,0000,,Мен осылай істеймін!
Dialogue: 0,1:17:35.95,1:17:38.95,Default,,0000,0000,0000,,Мен үйдемін. Ах...
Dialogue: 0,1:17:38.95,1:17:42.79,Default,,0000,0000,0000,,Хехе. Сіз көлікті естідіңіз бе?
Dialogue: 0,1:17:42.79,1:17:47.96,Default,,0000,0000,0000,,Түсіндім, қыдырғың келе ме?
Dialogue: 0,1:17:47.96,1:17:53.80,Default,,0000,0000,0000,,Бұл менің соңғы өтінішім
Dialogue: 0,1:17:53.80,1:17:56.00,Default,,0000,0000,0000,,Кун….
Dialogue: 0,1:18:04.91,1:18:07.42,Default,,0000,0000,0000,,күрсіну…. Мен оны жай ғана жібердім.
Dialogue: 0,1:18:07.42,1:18:10.42,Default,,0000,0000,0000,,Иә. Жақсы.
Dialogue: 0,1:18:10.42,1:18:12.42,Default,,0000,0000,0000,,Иә. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,1:18:12.42,1:18:14.42,Default,,0000,0000,0000,,Ум...
Dialogue: 0,1:18:12.42,1:18:14.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:18:14.42,1:18:17.26,Default,,0000,0000,0000,,Тағы бірдеңе бар ма?
Dialogue: 0,1:18:17.26,1:18:20.43,Default,,0000,0000,0000,,Ол қазірдің өзінде көтерілуі керек пе?
Dialogue: 0,1:18:17.26,1:18:20.43,Default,,0000,0000,0000,,Бұл кеше де соңғы пойыз болды, солай ма?
Dialogue: 0,1:18:20.43,1:18:23.10,Default,,0000,0000,0000,,Жоқ, менде бұрыннан бар.
Dialogue: 0,1:18:23.10,1:18:25.10,Default,,0000,0000,0000,,Олай емес...
Dialogue: 0,1:18:25.10,1:18:27.94,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:18:27.94,1:18:30.27,Default,,0000,0000,0000,,Уф. Олай болса➡
Dialogue: 0,1:18:30.27,1:18:33.28,Default,,0000,0000,0000,,Жаңа қолжазбаларды тексеру
Dialogue: 0,1:18:30.27,1:18:33.28,Default,,0000,0000,0000,,Мен сізге жақсылық сұрауым керек пе?
Dialogue: 0,1:18:33.28,1:18:35.28,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:18:35.28,1:18:37.28,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:18:40.12,1:18:43.62,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:18:40.12,1:18:43.62,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:18:52.29,1:19:15.75,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:19:15.75,1:19:17.75,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:19:20.09,1:19:22.76,Default,,0000,0000,0000,,Какамигахара мырза.
Dialogue: 0,1:19:20.09,1:19:22.76,Default,,0000,0000,0000,,А, иә.
Dialogue: 0,1:19:22.76,1:19:25.76,Default,,0000,0000,0000,,Бивуак
Dialogue: 0,1:19:22.76,1:19:25.76,Default,,0000,0000,0000,,«BIVOUAC» жаңа саны келді.
Dialogue: 0,1:19:22.76,1:19:25.76,Default,,0000,0000,0000,,Оны сөреге қоюға болады ма?
Dialogue: 0,1:19:25.76,1:19:27.96,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:19:31.77,1:19:35.44,Default,,0000,0000,0000,,⚟Шынымен қымбат па?
Dialogue: 0,1:19:31.77,1:19:35.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:19:35.44,1:19:37.77,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,1:19:35.44,1:19:37.77,Default,,0000,0000,0000,,Шам жетпес пе?
Dialogue: 0,1:19:37.77,1:19:39.77,Default,,0000,0000,0000,,Бұл қандай да бір ырым.
Dialogue: 0,1:19:39.77,1:19:41.78,Default,,0000,0000,0000,,(Аттың айғайы)
Dialogue: 0,1:19:41.78,1:19:44.61,Default,,0000,0000,0000,,《А, анау балалар...》
Dialogue: 0,1:19:44.61,1:19:47.95,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:19:44.61,1:19:47.95,Default,,0000,0000,0000,,Ум!
Dialogue: 0,1:19:47.95,1:19:50.29,Default,,0000,0000,0000,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,1:19:50.29,1:19:52.79,Default,,0000,0000,0000,,Ах, мектеп бітіру күнін еске алу үшін➡
Dialogue: 0,1:19:52.79,1:19:55.62,Default,,0000,0000,0000,,Кемпинг жасап көрейік
Dialogue: 0,1:19:52.79,1:19:55.62,Default,,0000,0000,0000,,Әңгімелесейік.
Dialogue: 0,1:19:55.62,1:20:00.13,Default,,0000,0000,0000,,Бірақ кемпинг болу үшін не қажет?
Dialogue: 0,1:19:55.62,1:20:00.13,Default,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,1:20:00.13,1:20:03.63,Default,,0000,0000,0000,,Әртүрлі құралдар бар.
Dialogue: 0,1:20:00.13,1:20:03.63,Default,,0000,0000,0000,,Бұл өте қымбат.
Dialogue: 0,1:20:05.80,1:20:08.80,Default,,0000,0000,0000,,Егер сіз кемпингке бірінші рет барсаңыз
Dialogue: 0,1:20:05.80,1:20:08.80,Default,,0000,0000,0000,,Алғашқыда түнеп қалмасаңыз да➡
Dialogue: 0,1:20:08.80,1:20:11.81,Default,,0000,0000,0000,,Сіз тек күндізгі уақытта ғана пикник жасай аласыз.
Dialogue: 0,1:20:08.80,1:20:11.81,Default,,0000,0000,0000,,Отты жағу➡
Dialogue: 0,1:20:11.81,1:20:14.81,Default,,0000,0000,0000,,Бірдеңені бірден жеп қойсаңыз да.
Dialogue: 0,1:20:11.81,1:20:14.81,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,1:20:14.81,1:20:17.81,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:20:14.81,1:20:17.81,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:20:17.81,1:20:20.65,Default,,0000,0000,0000,,Әрине! Бәрі жақсы.
Dialogue: 0,1:20:20.65,1:20:23.82,Default,,0000,0000,0000,,Құралдар кейінірек келеді
Dialogue: 0,1:20:20.65,1:20:23.82,Default,,0000,0000,0000,,Оларды бірте-бірте жинап алсаңыз болғаны.
Dialogue: 0,1:20:23.82,1:20:25.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:20:25.82,1:20:28.32,Default,,0000,0000,0000,,Олай болса. Сіз кесе кеспе жегіңіз келе ме?
Dialogue: 0,1:20:28.32,1:20:30.49,Default,,0000,0000,0000,,Мен оны жегім келеді.
Dialogue: 0,1:20:30.49,1:20:34.66,Default,,0000,0000,0000,,I Теңіз өнімдері!
Dialogue: 0,1:20:30.49,1:20:34.66,Default,,0000,0000,0000,,Менің ойымша, бұл стандартты соя соусы.
Dialogue: 0,1:20:34.66,1:20:36.67,Default,,0000,0000,0000,,Мен шошқаның сүйегімін.
Dialogue: 0,1:20:36.67,1:20:40.00,Default,,0000,0000,0000,,Ахаха! Шошқа сүйегі дегеніміз не?
Dialogue: 0,1:20:36.67,1:20:40.00,Default,,0000,0000,0000,,Өте сирек.
Dialogue: 0,1:20:40.00,1:20:42.10,Default,,0000,0000,0000,,Бұл тітіркендіргіш.
Dialogue: 0,1:20:40.00,1:20:42.10,Default,,0000,0000,0000,,Ахаха!
Dialogue: 0,1:20:44.17,1:20:47.34,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:20:47.34,1:20:51.05,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,1:20:53.52,1:20:56.35,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:20:53.52,1:20:56.35,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:20:56.35,1:21:01.46,Default,,0000,0000,0000,,Кемпингті алғаш бастаған кезім туралы.
Dialogue: 0,1:20:56.35,1:21:01.46,Default,,0000,0000,0000,,Жаңа есіме түсті.
Dialogue: 0,1:21:01.46,1:21:04.96,Default,,0000,0000,0000,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,1:21:04.96,1:21:08.30,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,1:21:08.30,1:21:12.13,Default,,0000,0000,0000,,Какамигахара мырза, күткендей.
Dialogue: 0,1:21:08.30,1:21:12.13,Default,,0000,0000,0000,,Мен бұл жұмысқа жарамдымын.
Dialogue: 0,1:21:12.13,1:21:14.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:21:14.80,1:21:32.49,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:21:32.49,1:21:34.59,Default,,0000,0000,0000,,Ха...
Dialogue: 0,1:21:55.34,1:21:57.55,Default,,0000,0000,0000,,｟Иә?
Dialogue: 0,1:21:59.95,1:22:02.05,Default,,0000,0000,0000,,Иә! сондықтан! ?
Dialogue: 0,1:22:04.12,1:22:06.82,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:22:04.12,1:22:06.82,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:22:10.46,1:22:13.80,Default,,0000,0000,0000,,Иә. Бұл жеуге оңай.
Dialogue: 0,1:22:13.80,1:22:15.80,Default,,0000,0000,0000,,Олай болса, үзіліс жасайық.
Dialogue: 0,1:22:15.80,1:22:18.30,Default,,0000,0000,0000,,А, Қария-сан?
Dialogue: 0,1:22:18.30,1:22:21.80,Default,,0000,0000,0000,,Жоқ, Шима-кун да.
Dialogue: 0,1:22:18.30,1:22:21.80,Default,,0000,0000,0000,,Маған көбірек жұмыс істеу керек.
Dialogue: 0,1:22:21.80,1:22:24.31,Default,,0000,0000,0000,,А... Бас редактор?
Dialogue: 0,1:22:24.31,1:22:26.31,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:22:26.31,1:22:31.15,Default,,0000,0000,0000,,Шынымен, маған бірдеңе айтыңызшы.
Dialogue: 0,1:22:26.31,1:22:31.15,Default,,0000,0000,0000,,📱 (дірілдеген дыбыс)
Dialogue: 0,1:22:31.15,1:22:33.98,Default,,0000,0000,0000,,Рин, болды!
Dialogue: 0,1:22:33.98,1:22:36.65,Default,,0000,0000,0000,,Біздің лагерь!
Dialogue: 0,1:22:36.65,1:22:39.15,Default,,0000,0000,0000,,Соңында➡
Dialogue: 0,1:22:39.15,1:22:42.16,Default,,0000,0000,0000,,Орындалды!
Dialogue: 0,1:22:45.49,1:22:47.66,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:22:47.66,1:22:50.33,Default,,0000,0000,0000,,Көңілді сияқты!
Dialogue: 0,1:22:47.66,1:22:50.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:22:50.33,1:22:54.00,Default,,0000,0000,0000,,Шима-кун, дереу барып сұхбат ал.
Dialogue: 0,1:22:50.33,1:22:54.00,Default,,0000,0000,0000,,Иә? Немесе, иә?
Dialogue: 0,1:22:54.00,1:22:56.00,Default,,0000,0000,0000,,Жарайды, бардым, кеттім!
Dialogue: 0,1:22:56.00,1:22:58.01,Default,,0000,0000,0000,,Уау. Эй, эй, эй….
Dialogue: 0,1:23:00.11,1:23:03.45,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,1:23:03.45,1:23:05.45,Default,,0000,0000,0000,,Барлығы...
Dialogue: 0,1:23:05.45,1:23:08.95,Default,,0000,0000,0000,,Мен бұған шыдай алмаймын.
Dialogue: 0,1:23:08.95,1:23:11.75,Default,,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,1:23:17.46,1:23:21.63,Default,,0000,0000,0000,,(Кіру қоңырауы)
Dialogue: 0,1:23:21.63,1:23:23.83,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:23:29.47,1:23:32.81,Default,,0000,0000,0000,,Не? Қазір...
Dialogue: 0,1:23:29.47,1:23:32.81,Default,,0000,0000,0000,,(Кіру қоңырауы)
Dialogue: 0,1:23:32.81,1:23:34.81,Default,,0000,0000,0000,,Шима-сан.
Dialogue: 0,1:23:32.81,1:23:34.81,Default,,0000,0000,0000,,(есік қағу дыбысы)
Dialogue: 0,1:23:34.81,1:23:37.15,Default,,0000,0000,0000,,Сіз алыстасыз ба?
Dialogue: 0,1:23:34.81,1:23:37.15,Default,,0000,0000,0000,,Курьер арқылы.
Dialogue: 0,1:23:37.15,1:23:40.15,Default,,0000,0000,0000,,А... иә! кешіріңіз.
Dialogue: 0,1:23:55.83,1:23:58.53,Default,,0000,0000,0000,,Төтенше тамақ….
Dialogue: 0,1:24:00.77,1:24:02.94,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,1:24:02.94,1:24:05.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:24:02.94,1:24:05.54,Default,,0000,0000,0000,,📱
Dialogue: 0,1:24:11.95,1:24:15.05,Default,,0000,0000,0000,,Ыстық бұлақ?
Dialogue: 0,1:24:30.30,1:24:36.14,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,1:24:36.14,1:24:40.48,Default,,0000,0000,0000,,《Ыстық бұлақтар?
Dialogue: 0,1:24:36.14,1:24:40.48,Default,,0000,0000,0000,,Тауға шығу емес пе?
Dialogue: 0,1:24:40.48,1:24:43.14,Default,,0000,0000,0000,,Рин-чан жекпе-жегі!
Dialogue: 0,1:24:43.14,1:24:47.35,Default,,0000,0000,0000,,Қатты өрмелеуден кейінгі ыстық бұлақтар
Dialogue: 0,1:24:43.14,1:24:47.35,Default,,0000,0000,0000,,Бұл ең жақсы!
Dialogue: 0,1:24:51.32,1:24:54.32,Default,,0000,0000,0000,,Еңіс соншалықты тік емес➡
Dialogue: 0,1:24:54.32,1:24:57.83,Default,,0000,0000,0000,,Мен өзімді бір сағат жүргендей сезінемін.
Dialogue: 0,1:24:57.83,1:25:00.43,Default,,0000,0000,0000,,Надешико Сіз мүлде шаршаған жоқсыз.
Dialogue: 0,1:25:00.43,1:25:02.93,Default,,0000,0000,0000,,Оны сатуға менің физикалық күшім жетеді.
Dialogue: 0,1:25:02.93,1:25:05.93,Default,,0000,0000,0000,,Оны қазір сатыңыз.
Dialogue: 0,1:25:08.44,1:25:12.44,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:25:19.45,1:25:22.55,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:25:19.45,1:25:22.55,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:25:27.12,1:25:29.12,Default,,0000,0000,0000,,Куун.
Dialogue: 0,1:25:29.12,1:25:33.33,Default,,0000,0000,0000,,Иә, иә, баяу жүрейік.
Dialogue: 0,1:25:47.81,1:25:51.31,Default,,0000,0000,0000,,Бұл жақсы сезінеді.
Dialogue: 0,1:25:47.81,1:25:51.31,Default,,0000,0000,0000,,Кун.
Dialogue: 0,1:25:51.31,1:25:56.52,Default,,0000,0000,0000,,Хехехе, биіктен төмен түскенде
Dialogue: 0,1:25:51.31,1:25:56.52,Default,,0000,0000,0000,,Ол қатты толқыды.
Dialogue: 0,1:26:09.43,1:26:12.43,Default,,0000,0000,0000,,Жылы.
Dialogue: 0,1:26:24.61,1:26:27.78,Default,,0000,0000,0000,,Ах! Мен таң қалдым...
Dialogue: 0,1:26:24.61,1:26:27.78,Default,,0000,0000,0000,,📱 (дірілдеген дыбыс)
Dialogue: 0,1:26:27.78,1:26:29.78,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:26:29.78,1:26:32.12,Default,,0000,0000,0000,,Сәлем Инуко.
Dialogue: 0,1:26:32.12,1:26:35.52,Default,,0000,0000,0000,,Бұл менмін...
Dialogue: 0,1:26:40.30,1:26:42.80,Default,,0000,0000,0000,,Ха...
Dialogue: 0,1:26:46.63,1:26:49.30,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:26:46.63,1:26:49.30,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:26:49.30,1:26:52.47,Default,,0000,0000,0000,,Бүгін теңіз өнімдері.
Dialogue: 0,1:26:52.47,1:26:58.15,Default,,0000,0000,0000,,Хэхе хехе мен дүкенге келген жоқпын.
Dialogue: 0,1:26:52.47,1:26:58.15,Default,,0000,0000,0000,,Жоғары сынып оқушыларының тұтынушылары➡
Dialogue: 0,1:26:58.15,1:27:01.25,Default,,0000,0000,0000,,Сізге кесе кеспенің қай дәмі ұнайды?
Dialogue: 0,1:26:58.15,1:27:01.25,Default,,0000,0000,0000,,Менімен сөйлес.
Dialogue: 0,1:27:01.25,1:27:03.59,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:27:01.25,1:27:03.59,Default,,0000,0000,0000,,Кейде дәмі сәл басқаша болады➡
Dialogue: 0,1:27:03.59,1:27:05.75,Default,,0000,0000,0000,,Мен мұны жақсы деп ойладым.
Dialogue: 0,1:27:05.75,1:27:08.06,Default,,0000,0000,0000,,Рин шынымен карриді жақсы көреді ме?
Dialogue: 0,1:27:11.76,1:27:13.76,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:27:13.76,1:27:15.76,Default,,0000,0000,0000,,(Дабыл дыбысы)
Dialogue: 0,1:27:17.77,1:27:19.77,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,1:27:19.77,1:27:21.77,Default,,0000,0000,0000,,Itadadakimasu.
Dialogue: 0,1:27:23.94,1:27:27.11,Default,,0000,0000,0000,,Ааа...
Dialogue: 0,1:27:27.11,1:27:46.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:27:46.96,1:27:49.13,Default,,0000,0000,0000,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,1:27:49.13,1:27:51.13,Default,,0000,0000,0000,,Тағы, тағы!
Dialogue: 0,1:27:51.13,1:27:53.64,Default,,0000,0000,0000,,Күріш шарлары да болды.
Dialogue: 0,1:27:53.64,1:27:56.64,Default,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,1:27:53.64,1:27:56.64,Default,,0000,0000,0000,,Үлкен.
Dialogue: 0,1:28:04.75,1:28:08.08,Default,,0000,0000,0000,,Бұдан былай мен крампондарды киемін.
Dialogue: 0,1:28:04.75,1:28:08.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:28:08.08,1:29:20.25,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:20.25,1:29:22.92,Default,,0000,0000,0000,,Күрсін... Ақыры келдік.
Dialogue: 0,1:29:22.92,1:29:25.09,Default,,0000,0000,0000,,Шомуға билетті осы жерден сатып алыңыз➡
Dialogue: 0,1:29:25.09,1:29:27.76,Default,,0000,0000,0000,,Монша
Dialogue: 0,1:29:25.09,1:29:27.76,Default,,0000,0000,0000,,Одан сәл ұзағырақ.
Dialogue: 0,1:29:27.76,1:29:30.26,Default,,0000,0000,0000,,Сіз әлі өрмелеп жатырсыз ба?
Dialogue: 0,1:29:33.43,1:29:36.10,Default,,0000,0000,0000,,осында
Dialogue: 0,1:29:33.43,1:29:36.10,Default,,0000,0000,0000,,Бұл туралы апам айтты.
Dialogue: 0,1:29:36.10,1:29:38.44,Default,,0000,0000,0000,,Сакура мырза?
Dialogue: 0,1:29:38.44,1:29:40.44,Default,,0000,0000,0000,,Бір күні маған қоңырау келді➡
Dialogue: 0,1:29:40.44,1:29:42.78,Default,,0000,0000,0000,,Лагерь салу
Dialogue: 0,1:29:40.44,1:29:42.78,Default,,0000,0000,0000,,Жоқ деп айттым.
Dialogue: 0,1:29:42.78,1:29:44.78,Default,,0000,0000,0000,,Содан кейін...
Dialogue: 0,1:29:47.45,1:29:50.45,Default,,0000,0000,0000,,｟Иә?
Dialogue: 0,1:29:50.45,1:29:53.25,Default,,0000,0000,0000,,Хо~｠
Dialogue: 0,1:29:55.79,1:29:58.13,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:29:58.13,1:30:00.33,Default,,0000,0000,0000,,Сакура-санға ұқсайды.
Dialogue: 0,1:30:06.30,1:30:08.50,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,1:30:06.30,1:30:08.50,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:30:17.48,1:30:20.48,Default,,0000,0000,0000,,Қандай керемет көрініс!
Dialogue: 0,1:30:17.48,1:30:20.48,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:30:20.48,1:30:22.98,Default,,0000,0000,0000,,А, бұл ыстық бұлақ.
Dialogue: 0,1:30:22.98,1:30:25.99,Default,,0000,0000,0000,,Иә! ? Tsk...
Dialogue: 0,1:30:25.99,1:30:29.16,Default,,0000,0000,0000,,Дәлірек айтқанда
Dialogue: 0,1:30:25.99,1:30:29.16,Default,,0000,0000,0000,,Ол еңіс үстінде орналасқан.
Dialogue: 0,1:30:29.16,1:30:31.33,Default,,0000,0000,0000,,Бостандық сезімі бар.
Dialogue: 0,1:30:31.33,1:30:33.66,Default,,0000,0000,0000,,Киінетін бөлме қайда?
Dialogue: 0,1:30:33.66,1:30:36.33,Default,,0000,0000,0000,,Мен сенің киіміңді шешіп жатқаныңды естідім.
Dialogue: 0,1:30:33.66,1:30:36.33,Default,,0000,0000,0000,,Не!
Dialogue: 0,1:30:36.33,1:30:40.03,Default,,0000,0000,0000,,Онда ешкім жоқ, сондықтан бәрі жақсы.
Dialogue: 0,1:30:36.33,1:30:40.03,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:30:46.51,1:30:49.84,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,1:30:49.84,1:30:53.51,Default,,0000,0000,0000,,Денемдегі шаршау ери бастайды...
Dialogue: 0,1:30:53.51,1:30:56.02,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:30:58.19,1:31:01.96,Default,,0000,0000,0000,,Ыстық бұлақтар...
Dialogue: 0,1:30:58.19,1:31:01.96,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,1:31:01.96,1:31:05.46,Default,,0000,0000,0000,,Қартайған сайын
Dialogue: 0,1:31:01.96,1:31:05.46,Default,,0000,0000,0000,,Ол шағып кетеді.
Dialogue: 0,1:31:05.46,1:31:07.96,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:31:09.96,1:31:14.47,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:31:09.96,1:31:14.47,Default,,0000,0000,0000,,Сіз ересек адам болдыңыз.
Dialogue: 0,1:31:14.47,1:31:18.47,Default,,0000,0000,0000,,Бірге жұмыс жасайық
Dialogue: 0,1:31:14.47,1:31:18.47,Default,,0000,0000,0000,,жұмсауға көбірек ақша➡
Dialogue: 0,1:31:18.47,1:31:21.81,Default,,0000,0000,0000,,Лагерьге арналған жабдықтар
Dialogue: 0,1:31:18.47,1:31:21.81,Default,,0000,0000,0000,,Енді мен көп нәрсені сатып аламын.
Dialogue: 0,1:31:21.81,1:31:25.31,Default,,0000,0000,0000,,Мен де жүргізуші куәлігін алдым.
Dialogue: 0,1:31:21.81,1:31:25.31,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:31:25.31,1:31:28.48,Default,,0000,0000,0000,,Токио да, Яманаши де
Dialogue: 0,1:31:25.31,1:31:28.48,Default,,0000,0000,0000,,Қаласаңыз, көлікпен жылдам сапарға шығыңыз.
Dialogue: 0,1:31:28.48,1:31:32.32,Default,,0000,0000,0000,,Мен велосипедпен жүрдім.
Dialogue: 0,1:31:28.48,1:31:32.32,Default,,0000,0000,0000,,Надешикогана.
Dialogue: 0,1:31:32.32,1:31:35.62,Default,,0000,0000,0000,,Эхехе, мен толығымен қоғамның мүшесімін.
Dialogue: 0,1:31:38.66,1:31:40.83,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:31:40.83,1:31:44.13,Default,,0000,0000,0000,,Бұл сіз ештеңе істей аласыз дегенді білдірмейді.
Dialogue: 0,1:31:40.83,1:31:44.13,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:31:47.34,1:31:50.34,Default,,0000,0000,0000,,Көңілді болды~ Такашита.
Dialogue: 0,1:31:50.34,1:31:52.34,Default,,0000,0000,0000,,Әйтеуір, сол жерде➡
Dialogue: 0,1:31:52.34,1:31:56.34,Default,,0000,0000,0000,,Ұзақ лагерь
Dialogue: 0,1:31:52.34,1:31:56.34,Default,,0000,0000,0000,,Ол мұны істеп жатқан сияқты болды.
Dialogue: 0,1:31:56.34,1:31:58.68,Default,,0000,0000,0000,,Мен баяғыдан➡
Dialogue: 0,1:31:58.68,1:32:04.62,Default,,0000,0000,0000,,Барлығымен тағы солай уақыт
Dialogue: 0,1:31:58.68,1:32:04.62,Default,,0000,0000,0000,,Мен сенімен біраз уақыт өткізгім келді.
Dialogue: 0,1:32:04.62,1:32:09.12,Default,,0000,0000,0000,,Содан кейін лагерь
Dialogue: 0,1:32:04.62,1:32:09.12,Default,,0000,0000,0000,,Ол бізге тағы кездесуге рұқсат берді.
Dialogue: 0,1:32:11.46,1:32:14.96,Default,,0000,0000,0000,,Иә. Мен де солай ойлаймын.
Dialogue: 0,1:32:14.96,1:32:20.13,Default,,0000,0000,0000,,Бірақ жұмыстың ауыртпалығы артады
Dialogue: 0,1:32:14.96,1:32:20.13,Default,,0000,0000,0000,,Ағаңызға барыңыз➡
Dialogue: 0,1:32:20.13,1:32:23.97,Default,,0000,0000,0000,,Сіз қиындық тудырдыңыз, солай емес пе?
Dialogue: 0,1:32:20.13,1:32:23.97,Default,,0000,0000,0000,,Сіз ашулысыз ба?
Dialogue: 0,1:32:23.97,1:32:28.48,Default,,0000,0000,0000,,№.
Dialogue: 0,1:32:23.97,1:32:28.48,Default,,0000,0000,0000,,Мен әрқашан сіздің қолдауыңызға ие болдым.
Dialogue: 0,1:32:28.48,1:32:33.65,Default,,0000,0000,0000,,Мен де өскенде
Dialogue: 0,1:32:28.48,1:32:33.65,Default,,0000,0000,0000,,Мен бәрін істей аламын деп ойладым.
Dialogue: 0,1:32:33.65,1:32:37.49,Default,,0000,0000,0000,,Бірақ шын мәнінде бұл жауапкершілік➡
Dialogue: 0,1:32:37.49,1:32:40.66,Default,,0000,0000,0000,,Сіз істеу керек нәрселер
Dialogue: 0,1:32:37.49,1:32:40.66,Default,,0000,0000,0000,,Арту➡
Dialogue: 0,1:32:40.66,1:32:42.99,Default,,0000,0000,0000,,Өйткенi кәмелетке жеткенде де➡
Dialogue: 0,1:32:42.99,1:32:46.33,Default,,0000,0000,0000,,Айнала
Dialogue: 0,1:32:42.99,1:32:46.33,Default,,0000,0000,0000,,Мені қолдап жатқандай сезінемін.
Dialogue: 0,1:32:46.33,1:32:50.67,Default,,0000,0000,0000,,Мен жалғыз емеспін
Dialogue: 0,1:32:46.33,1:32:50.67,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:32:50.67,1:32:54.37,Default,,0000,0000,0000,,Мен көремін. Мен келісемін.
Dialogue: 0,1:33:05.45,1:33:08.45,Default,,0000,0000,0000,,Бірақ тіпті біз үшін➡
Dialogue: 0,1:33:08.45,1:33:10.62,Default,,0000,0000,0000,,Себебі мен ересекпін➡
Dialogue: 0,1:33:10.62,1:33:13.45,Default,,0000,0000,0000,,Енді не істей аласыз
Dialogue: 0,1:33:10.62,1:33:13.45,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:33:13.45,1:33:16.79,Default,,0000,0000,0000,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,1:33:16.79,1:33:18.96,Default,,0000,0000,0000,,Мысалы ➡
Dialogue: 0,1:33:18.96,1:33:22.63,Default,,0000,0000,0000,,Біз қазір
Dialogue: 0,1:33:18.96,1:33:22.63,Default,,0000,0000,0000,,Менің ойымша, қызықты нәрсе➡
Dialogue: 0,1:33:22.63,1:33:25.97,Default,,0000,0000,0000,,Көп адамға жетті➡
Dialogue: 0,1:33:25.97,1:33:31.31,Default,,0000,0000,0000,,Бұл адамдар да
Dialogue: 0,1:33:25.97,1:33:31.31,Default,,0000,0000,0000,,Көңілді келесі адамдарға жеткізу.
Dialogue: 0,1:33:31.31,1:33:33.47,Default,,0000,0000,0000,,Куу... Уау!
Dialogue: 0,1:33:33.47,1:33:35.48,Default,,0000,0000,0000,,Міне, бұл➡
Dialogue: 0,1:33:35.48,1:33:38.78,Default,,0000,0000,0000,,Көп нәрсе болатын жер
Dialogue: 0,1:33:35.48,1:33:38.78,Default,,0000,0000,0000,,Бір нәрсені жасау.
Dialogue: 0,1:33:42.15,1:33:44.99,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:33:42.15,1:33:44.99,Default,,0000,0000,0000,,Мен не істеуге тырыстым➡
Dialogue: 0,1:33:44.99,1:33:47.29,Default,,0000,0000,0000,,Оның мағынасы осы емес пе?
Dialogue: 0,1:33:49.32,1:33:53.33,Default,,0000,0000,0000,,Надешико керемет.
Dialogue: 0,1:33:53.33,1:33:56.16,Default,,0000,0000,0000,,Егер сіз мұны істей алсаңыз, шынымен де керемет болар еді.
Dialogue: 0,1:33:56.16,1:33:58.33,Default,,0000,0000,0000,,Иә, мүмкін.
Dialogue: 0,1:33:58.33,1:34:00.27,Default,,0000,0000,0000,,Себебі бірінші➡
Dialogue: 0,1:34:00.27,1:34:02.77,Default,,0000,0000,0000,,Лагерьдің қуанышын маған әкелу
Dialogue: 0,1:34:00.27,1:34:02.77,Default,,0000,0000,0000,,Оның маған айтқаны➡
Dialogue: 0,1:34:02.77,1:34:04.77,Default,,0000,0000,0000,,Бұл Рин Чан!
Dialogue: 0,1:34:06.94,1:34:08.94,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:34:08.94,1:34:11.45,Default,,0000,0000,0000,,Камадо, тұр…
Dialogue: 0,1:34:08.94,1:34:11.45,Default,,0000,0000,0000,,есімде.
Dialogue: 0,1:34:11.45,1:34:13.75,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,1:34:15.78,1:34:19.29,Default,,0000,0000,0000,,Әлі де жол бар ма?
Dialogue: 0,1:34:19.29,1:34:22.12,Default,,0000,0000,0000,,Ойланып көрейік.
Dialogue: 0,1:34:22.12,1:34:25.29,Default,,0000,0000,0000,,Олай болса, қозғалып көреміз бе?
Dialogue: 0,1:34:25.29,1:34:27.29,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:34:48.65,1:34:50.65,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:34:58.49,1:35:00.80,Default,,0000,0000,0000,,Сәлем….
Dialogue: 0,1:35:06.43,1:35:08.44,Default,,0000,0000,0000,,Мұнда ешкім жоқ.
Dialogue: 0,1:35:08.44,1:35:10.77,Default,,0000,0000,0000,,Бұл сәл ерте болды ма?
Dialogue: 0,1:35:10.77,1:35:12.77,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:35:15.44,1:35:18.95,Default,,0000,0000,0000,,Қарағай конусы.
Dialogue: 0,1:35:18.95,1:35:20.95,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:35:20.95,1:35:22.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:35:22.95,1:35:24.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:35:24.95,1:35:28.29,Default,,0000,0000,0000,,Аки~? Ах.
Dialogue: 0,1:35:28.29,1:35:31.99,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,1:35:28.29,1:35:31.99,Default,,0000,0000,0000,,Күдікті адам бар.
Dialogue: 0,1:35:35.13,1:35:37.80,Default,,0000,0000,0000,,Надешико-чанмен
Dialogue: 0,1:35:35.13,1:35:37.80,Default,,0000,0000,0000,,Бұл Рин Чан емес пе?
Dialogue: 0,1:35:37.80,1:35:39.80,Default,,0000,0000,0000,,Балалар сендер кімсіңдер?
Dialogue: 0,1:35:39.80,1:35:43.30,Default,,0000,0000,0000,,Мені қорқытпа.
Dialogue: 0,1:35:39.80,1:35:43.30,Default,,0000,0000,0000,,Мен сені қорқытып тұрған жоқпын.
Dialogue: 0,1:35:43.30,1:35:47.14,Default,,0000,0000,0000,,(Джинжер-кунның іске қосу дыбысы)
Dialogue: 0,1:35:47.14,1:35:50.48,Default,,0000,0000,0000,,Барлығы... Мен көптен күттім.
Dialogue: 0,1:35:50.48,1:35:52.81,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,1:35:52.81,1:35:58.49,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:35:58.49,1:36:01.42,Default,,0000,0000,0000,,Барлығы, біраз уақыт болды.
Dialogue: 0,1:36:01.42,1:36:03.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:36:03.59,1:36:06.09,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз. Мен оны асыра орындадым.
Dialogue: 0,1:36:09.10,1:36:12.77,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:36:09.10,1:36:12.77,Default,,0000,0000,0000,,Барлығы тағы да осында.
Dialogue: 0,1:36:12.77,1:36:14.77,Default,,0000,0000,0000,,(Камо) Инумаки, оны ұстап тұр; біз шабуыл жасап, ара қашықтықты сақтаймыз.
Dialogue: 0,1:36:14.77,1:36:17.94,Default,,0000,0000,0000,,Тыңдаңдар, балалар!
Dialogue: 0,1:36:14.77,1:36:17.94,Default,,0000,0000,0000,,Қазіргі уақытта лагерьлер қайта ашылуда ➡
Dialogue: 0,1:36:17.94,1:36:19.94,Default,,0000,0000,0000,,Өте қатал.
Dialogue: 0,1:36:19.94,1:36:22.94,Default,,0000,0000,0000,,Сондықтан бұл жағдайдан шығу үшін➡
Dialogue: 0,1:36:22.94,1:36:26.45,Default,,0000,0000,0000,,Мен және Инуко
Dialogue: 0,1:36:22.94,1:36:26.45,Default,,0000,0000,0000,,Префектуралық үкімет жағы және қираған қазба жағы➡
Dialogue: 0,1:36:26.45,1:36:29.75,Default,,0000,0000,0000,,Екі жақтан қалай жақындауға болады
Dialogue: 0,1:36:26.45,1:36:29.75,Default,,0000,0000,0000,,Мен бұл туралы ойладым.
Dialogue: 0,1:36:31.95,1:36:34.46,Default,,0000,0000,0000,,Алдымен жоспарды қайта қарастырайық.
Dialogue: 0,1:36:34.46,1:36:36.46,Default,,0000,0000,0000,,Жаттығу дегеніміз не?
Dialogue: 0,1:36:36.46,1:36:40.80,Default,,0000,0000,0000,,Қазір сол жерде қирандыларға қатысты нысандар бар.
Dialogue: 0,1:36:36.46,1:36:40.80,Default,,0000,0000,0000,,Қарастырылатынына қарамастан ➡
Dialogue: 0,1:36:40.80,1:36:43.80,Default,,0000,0000,0000,,Бұған қарсы күреспе➡
Dialogue: 0,1:36:43.80,1:36:47.13,Default,,0000,0000,0000,,Жаңа лагерьді жоспарлау
Dialogue: 0,1:36:43.80,1:36:47.13,Default,,0000,0000,0000,,Мен ұсыныс жасап отырмын.
Dialogue: 0,1:36:47.13,1:36:49.64,Default,,0000,0000,0000,,Басқаша айтқанда….
Dialogue: 0,1:36:52.81,1:36:58.15,Default,,0000,0000,0000,,｟Мм. Огаки байсалдысыз ба?
Dialogue: 0,1:36:58.15,1:37:01.05,Default,,0000,0000,0000,,Иә! Мен байсалдымын｠
Dialogue: 0,1:37:02.92,1:37:05.59,Default,,0000,0000,0000,,Одан әрі қазба жұмыстары.
Dialogue: 0,1:37:05.59,1:37:10.26,Default,,0000,0000,0000,,Шындығында қазіргі жағдай жұмысшылардың аздығы.
Dialogue: 0,1:37:05.59,1:37:10.26,Default,,0000,0000,0000,,Кесте кестеден артта қалды.
Dialogue: 0,1:37:10.26,1:37:14.09,Default,,0000,0000,0000,,Біріншіден, қазба жұмысы алға баспайды.
Dialogue: 0,1:37:10.26,1:37:14.09,Default,,0000,0000,0000,,Себебі келесі қадамға өте алмаймын➡
Dialogue: 0,1:37:14.09,1:37:18.10,Default,,0000,0000,0000,,Бізде
Dialogue: 0,1:37:14.09,1:37:18.10,Default,,0000,0000,0000,,Мен қазба жұмыстарына көмектесемін.
Dialogue: 0,1:37:20.10,1:37:22.44,Default,,0000,0000,0000,,Бүгіннен бастап кезекпен қатысамыз.
Dialogue: 0,1:37:22.44,1:37:24.44,Default,,0000,0000,0000,,Мен Изуку Мидориямын!
Dialogue: 0,1:37:24.44,1:37:26.61,Default,,0000,0000,0000,,Жоқ, бұл пайдалы.
Dialogue: 0,1:37:26.61,1:37:30.44,Default,,0000,0000,0000,,О, түскі ас.
Dialogue: 0,1:37:26.61,1:37:30.44,Default,,0000,0000,0000,,Сіз жасай аласыз.
Dialogue: 0,1:37:30.44,1:37:32.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:37:32.45,1:38:23.76,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:38:23.76,1:38:27.94,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,1:38:23.76,1:38:27.94,Default,,0000,0000,0000,,Өте дәмді болды.
Dialogue: 0,1:38:27.94,1:38:29.94,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,1:38:29.94,1:38:32.11,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,1:38:29.94,1:38:32.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:38:32.11,1:38:35.44,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,1:38:32.11,1:38:35.44,Default,,0000,0000,0000,,Фаянс және Джомон кезеңінің заттары➡
Dialogue: 0,1:38:35.44,1:38:37.78,Default,,0000,0000,0000,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,1:38:37.78,1:38:39.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:38:39.78,1:38:42.95,Default,,0000,0000,0000,,Серияны жалғастыру керек пе?
Dialogue: 0,1:38:42.95,1:38:47.29,Default,,0000,0000,0000,,Иә. Лагерьлер әлі ашылған жоқ
Dialogue: 0,1:38:42.95,1:38:47.29,Default,,0000,0000,0000,,Әлі шешілген жоқ➡
Dialogue: 0,1:38:47.29,1:38:49.29,Default,,0000,0000,0000,,Бәріміз бірге қозғалайық.
Dialogue: 0,1:38:49.29,1:38:53.09,Default,,0000,0000,0000,,Әрине кәдімгі бизнес
Dialogue: 0,1:38:49.29,1:38:53.09,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,1:38:55.63,1:38:57.63,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:38:57.63,1:38:59.63,Default,,0000,0000,0000,,Оңай….
Dialogue: 0,1:38:59.63,1:39:03.57,Default,,0000,0000,0000,,Қолыңнан келгенше ерінбе.
Dialogue: 0,1:39:03.57,1:39:08.58,Default,,0000,0000,0000,,Жас кезімде мен де бас редактор болдым.
Dialogue: 0,1:39:03.57,1:39:08.58,Default,,0000,0000,0000,,Сіз маған көп ердің.
Dialogue: 0,1:39:08.58,1:39:10.58,Default,,0000,0000,0000,,Саған жақсырақ
Dialogue: 0,1:39:08.58,1:39:10.58,Default,,0000,0000,0000,,Бұл қиын болды.
Dialogue: 0,1:39:10.58,1:39:12.58,Default,,0000,0000,0000,,О, солай...
Dialogue: 0,1:39:14.58,1:39:18.09,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:39:21.76,1:39:23.76,Default,,0000,0000,0000,,Енді ➡
Dialogue: 0,1:39:23.76,1:39:27.76,Default,,0000,0000,0000,,Фуджикава қаласы Такашита ауданы
Dialogue: 0,1:39:23.76,1:39:27.76,Default,,0000,0000,0000,,Қазба алаңына қатысты➡
Dialogue: 0,1:39:27.76,1:39:32.60,Default,,0000,0000,0000,,Қазіргі уақытта қирандыларды көрсетуге болады
Dialogue: 0,1:39:27.76,1:39:32.60,Default,,0000,0000,0000,,Мәдени нысанға ұсыныс бар.
Dialogue: 0,1:39:32.60,1:39:36.60,Default,,0000,0000,0000,,Кешіріңіз. Туризмді насихаттау ұйымынан
Dialogue: 0,1:39:32.60,1:39:36.60,Default,,0000,0000,0000,,Менің ұсынысым бар.
Dialogue: 0,1:39:36.60,1:39:38.61,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:39:38.61,1:39:41.11,Default,,0000,0000,0000,,Осы жерден қараңыз.
Dialogue: 0,1:39:55.29,1:39:57.46,Default,,0000,0000,0000,,📺(Ена) Өткен жылы бастадық➡
Dialogue: 0,1:39:57.46,1:40:00.96,Default,,0000,0000,0000,,Бастапқыда Такашита ауданында орналасқан
Dialogue: 0,1:39:57.46,1:40:00.96,Default,,0000,0000,0000,,Нысан негізінде➡
Dialogue: 0,1:40:00.96,1:40:05.30,Default,,0000,0000,0000,,Біз лагерь жасап жатырмыз.
Dialogue: 0,1:40:05.30,1:40:09.14,Default,,0000,0000,0000,,Лагерь концепциясы – «қайта жаңғырту».
Dialogue: 0,1:40:09.14,1:40:11.31,Default,,0000,0000,0000,,Бар нәрсені пайдаланыңыз➡
Dialogue: 0,1:40:11.31,1:40:13.31,Default,,0000,0000,0000,,Оны әр адам пайдаланады ➡
Dialogue: 0,1:40:13.31,1:40:17.81,Default,,0000,0000,0000,,Қуанышты қайдан табуға болады
Dialogue: 0,1:40:13.31,1:40:17.81,Default,,0000,0000,0000,,Мен біреуін жасауға тырыстым.
Dialogue: 0,1:40:17.81,1:40:22.82,Default,,0000,0000,0000,,Джомон керамикасының ашылуымен
Dialogue: 0,1:40:17.81,1:40:22.82,Default,,0000,0000,0000,,Даму тоқтады➡
Dialogue: 0,1:40:22.82,1:40:28.32,Default,,0000,0000,0000,,Тіпті осындай оқиғалардан біз
Dialogue: 0,1:40:22.82,1:40:28.32,Default,,0000,0000,0000,,Ашу алынды.
Dialogue: 0,1:40:28.32,1:40:32.33,Default,,0000,0000,0000,,Бұл тесік қосымша саңылау деп аталады.
Dialogue: 0,1:40:28.32,1:40:32.33,Default,,0000,0000,0000,,Жарылған аймақ➡
Dialogue: 0,1:40:32.33,1:40:36.83,Default,,0000,0000,0000,,Шілтер байлау
Dialogue: 0,1:40:32.33,1:40:36.83,Default,,0000,0000,0000,,ашылды деп есептелінеді.
Dialogue: 0,1:40:36.83,1:40:39.67,Default,,0000,0000,0000,,Джомон халқы үшін бұзылған жерді түзетіңіз➡
Dialogue: 0,1:40:39.67,1:40:41.84,Default,,0000,0000,0000,,Заттарды ұқыпты пайдалануды жалғастыру мәдениеті
Dialogue: 0,1:40:39.67,1:40:41.84,Default,,0000,0000,0000,,болды.
Dialogue: 0,1:40:41.84,1:40:43.84,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,1:40:43.84,1:40:46.17,Default,,0000,0000,0000,,О….
Dialogue: 0,1:40:46.17,1:40:49.01,Default,,0000,0000,0000,,📺(Ена) Лагерде
Dialogue: 0,1:40:46.17,1:40:49.01,Default,,0000,0000,0000,,Күнделікті өмірден➡
Dialogue: 0,1:40:49.01,1:40:53.18,Default,,0000,0000,0000,,Қашықтықта
Dialogue: 0,1:40:49.01,1:40:53.18,Default,,0000,0000,0000,,Сіз өзіңізбен бетпе-бет келе аласыз.
Dialogue: 0,1:40:53.18,1:40:56.68,Default,,0000,0000,0000,,Мен бұл жерді қалпына келтіруге тырыстым.
Dialogue: 0,1:40:53.18,1:40:56.68,Default,,0000,0000,0000,,Біз ➡
Dialogue: 0,1:40:56.68,1:40:59.02,Default,,0000,0000,0000,,Лагерь салу барысында➡
Dialogue: 0,1:40:59.02,1:41:04.96,Default,,0000,0000,0000,,Ескі достармен және өзіммен қайта қауышу
Dialogue: 0,1:40:59.02,1:41:04.96,Default,,0000,0000,0000,,Біз бір-бірімізбен бетпе-бет келе алдық.
Dialogue: 0,1:41:04.96,1:41:09.63,Default,,0000,0000,0000,,Түпнұсқа қондырғылар
Dialogue: 0,1:41:04.96,1:41:09.63,Default,,0000,0000,0000,,Ежелгі қыш ыдыстар да➡
Dialogue: 0,1:41:09.63,1:41:13.80,Default,,0000,0000,0000,,Бізге кез келген нәрсе
Dialogue: 0,1:41:09.63,1:41:13.80,Default,,0000,0000,0000,,Бұл сізге хабардар етеді.
Dialogue: 0,1:41:13.80,1:41:16.47,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,1:41:16.47,1:41:20.64,Default,,0000,0000,0000,,Біздің лагерь
Dialogue: 0,1:41:16.47,1:41:20.64,Default,,0000,0000,0000,,Біз қирандылар мен қыш ыдыстарды да пайдаланамыз!
Dialogue: 0,1:41:20.64,1:41:29.32,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:41:29.32,1:41:36.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:41:36.16,1:41:40.56,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:41:43.83,1:41:47.67,Default,,0000,0000,0000,,Бұл біздің жаңа жоспарымыз.
Dialogue: 0,1:41:47.67,1:41:51.07,Default,,0000,0000,0000,,Қарастыру
Dialogue: 0,1:41:47.67,1:41:51.07,Default,,0000,0000,0000,,Мен Изуку Мидориямын!
Dialogue: 0,1:42:02.12,1:42:04.62,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:42:04.62,1:42:09.62,Default,,0000,0000,0000,,Басқа жобалық ұсыныстармен
Dialogue: 0,1:42:04.62,1:42:09.62,Default,,0000,0000,0000,,Мұны мұқият қарастырыңыз.
Dialogue: 0,1:42:09.62,1:42:11.83,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:42:17.63,1:42:21.64,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,1:42:17.63,1:42:21.64,Default,,0000,0000,0000,,Ммм, дәмді екен.
Dialogue: 0,1:42:29.81,1:42:34.65,Default,,0000,0000,0000,,Огаки Бұл өтініш формасы…. иә?
Dialogue: 0,1:42:34.65,1:42:39.32,Default,,0000,0000,0000,,Мен дайындық бөлмесіне бардым.
Dialogue: 0,1:42:34.65,1:42:39.32,Default,,0000,0000,0000,,Барлығына есеп беретінін айтты.
Dialogue: 0,1:42:39.32,1:42:42.02,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:42:56.67,1:42:58.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:43:09.62,1:43:12.62,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:43:12.62,1:43:16.96,Default,,0000,0000,0000,,Мен іздеген жоқпын
Dialogue: 0,1:43:12.62,1:43:16.96,Default,,0000,0000,0000,,Ол біршама өсті.
Dialogue: 0,1:43:16.96,1:43:20.13,Default,,0000,0000,0000,,Мұндағы шөптің тамыры күшті.
Dialogue: 0,1:43:20.13,1:43:22.96,Default,,0000,0000,0000,,Ішіміз жеңілмеген.
Dialogue: 0,1:43:22.96,1:43:25.63,Default,,0000,0000,0000,,Жаз қатал, бірақ➡
Dialogue: 0,1:43:25.63,1:43:28.47,Default,,0000,0000,0000,,Біз күзгі ашылуды көздеп отырмыз!
Dialogue: 0,1:43:28.47,1:43:30.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:43:30.64,1:43:34.81,Default,,0000,0000,0000,,А? Не? Не?
Dialogue: 0,1:43:34.81,1:43:37.81,Default,,0000,0000,0000,,Хехехе, Рин-Чан, сен сондай мотивацияландың.
Dialogue: 0,1:43:37.81,1:43:42.15,Default,,0000,0000,0000,,Шынымен де...
Dialogue: 0,1:43:37.81,1:43:42.15,Default,,0000,0000,0000,,Енді жалпы басшының сөзі!
Dialogue: 0,1:43:42.15,1:43:44.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:43:47.65,1:43:49.82,Default,,0000,0000,0000,,Ұрыс….
Dialogue: 0,1:43:49.82,1:43:52.13,Default,,0000,0000,0000,,О!
Dialogue: 0,1:43:57.00,1:44:00.43,Default,,0000,0000,0000,,Әзірге жоғарғы қадамнан бастаңыз.
Dialogue: 0,1:43:57.00,1:44:00.43,Default,,0000,0000,0000,,Осымен аяқтаймыз.
Dialogue: 0,1:44:00.43,1:44:02.94,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:44:00.43,1:44:02.94,Default,,0000,0000,0000,,Көрейік.
Dialogue: 0,1:44:05.44,1:44:08.78,Default,,0000,0000,0000,,Бұл
Dialogue: 0,1:44:05.44,1:44:08.78,Default,,0000,0000,0000,,Мен шатыр тігетін орын алғым келеді ➡
Dialogue: 0,1:44:08.78,1:44:11.78,Default,,0000,0000,0000,,Мүмкіндігінше
Dialogue: 0,1:44:08.78,1:44:11.78,Default,,0000,0000,0000,,Мен оны шетіне жақын салғым келеді.
Dialogue: 0,1:44:16.62,1:44:18.62,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:44:16.62,1:44:18.62,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,1:44:18.62,1:44:20.62,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:44:20.62,1:44:22.62,Default,,0000,0000,0000,,Уа, уа, уа....
Dialogue: 0,1:44:22.62,1:44:24.63,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:44:24.63,1:44:27.29,Default,,0000,0000,0000,,Иә...
Dialogue: 0,1:44:27.29,1:44:30.63,Default,,0000,0000,0000,,Хахахаха! Неліктен көбірек сенбейсіз?
Dialogue: 0,1:44:30.63,1:44:32.83,Default,,0000,0000,0000,,Оказаки мырза!
Dialogue: 0,1:44:35.47,1:44:37.47,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,1:44:37.47,1:44:40.31,Default,,0000,0000,0000,,Фуфуфуфуфуфу!
Dialogue: 0,1:44:40.31,1:44:42.98,Default,,0000,0000,0000,,Фуфуфуфуфуфу!
Dialogue: 0,1:44:42.98,1:44:46.65,Default,,0000,0000,0000,,Ха-ха! Міне осылай.
Dialogue: 0,1:44:46.65,1:44:48.82,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:44:48.82,1:44:52.49,Default,,0000,0000,0000,,Рин-чан!
Dialogue: 0,1:44:48.82,1:44:52.49,Default,,0000,0000,0000,,Надешико-чан!
Dialogue: 0,1:44:52.49,1:44:54.49,Default,,0000,0000,0000,,Сәлем?
Dialogue: 0,1:45:01.60,1:45:06.10,Default,,0000,0000,0000,,Мұнда қалғанның бәрі
Dialogue: 0,1:45:01.60,1:45:06.10,Default,,0000,0000,0000,,Бар болғаны дұрыс болып шықты.
Dialogue: 0,1:45:06.10,1:45:10.00,Default,,0000,0000,0000,,Менің ойымша, оны балалар аймағы ретінде пайдалануға болады.
Dialogue: 0,1:45:13.94,1:45:16.94,Default,,0000,0000,0000,,Уау! иә!
Dialogue: 0,1:45:13.94,1:45:16.94,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:45:19.78,1:45:21.78,Default,,0000,0000,0000,,Жақсы кадр….
Dialogue: 0,1:45:28.29,1:45:30.46,Default,,0000,0000,0000,,Чип… Чип, чип!
Dialogue: 0,1:45:30.46,1:45:32.46,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:45:32.46,1:45:34.76,Default,,0000,0000,0000,,Иә! Жақсы!
Dialogue: 0,1:45:41.97,1:45:43.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:45:43.97,1:45:46.97,Default,,0000,0000,0000,,Ол өте ылғалды...
Dialogue: 0,1:45:43.97,1:45:46.97,Default,,0000,0000,0000,,Уау….
Dialogue: 0,1:45:54.65,1:45:56.65,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:45:56.65,1:46:22.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:46:24.95,1:46:29.12,Default,,0000,0000,0000,,Жарықтан
Dialogue: 0,1:46:24.95,1:46:29.12,Default,,0000,0000,0000,,Мен оны саған сақтап қойдым.
Dialogue: 0,1:46:29.12,1:46:31.12,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:46:33.12,1:46:36.79,Default,,0000,0000,0000,,Балалар сендер отбасыңа қоңырау шалдыңдар ма?
Dialogue: 0,1:46:33.12,1:46:36.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:46:36.79,1:46:39.79,Default,,0000,0000,0000,,Мен күткеннен де көп
Dialogue: 0,1:46:36.79,1:46:39.79,Default,,0000,0000,0000,,Сіз оны асыға күтетін сияқтысыз.
Dialogue: 0,1:46:39.79,1:46:43.13,Default,,0000,0000,0000,,Мен дүкен қызметкерлерімен де сөйлестім.
Dialogue: 0,1:46:43.13,1:46:45.13,Default,,0000,0000,0000,,Акари-чан келе жатыр, солай ма?
Dialogue: 0,1:46:45.13,1:46:49.97,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,1:46:45.13,1:46:49.97,Default,,0000,0000,0000,,Тоба-сенсеймен және басқалармен келемін деді.
Dialogue: 0,1:46:49.97,1:46:52.47,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:46:52.47,1:46:54.98,Default,,0000,0000,0000,,Мүмкін сәл оңға қарай?
Dialogue: 0,1:46:54.98,1:46:57.14,Default,,0000,0000,0000,,Бұл көп пе?
Dialogue: 0,1:46:54.98,1:46:57.14,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:46:57.14,1:46:59.15,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:47:03.42,1:47:06.25,Default,,0000,0000,0000,,О.
Dialogue: 0,1:47:06.25,1:47:33.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:47:33.45,1:47:36.12,Default,,0000,0000,0000,,Se-no….
Dialogue: 0,1:47:36.12,1:47:38.82,Default,,0000,0000,0000,,Орындалды!
Dialogue: 0,1:47:46.29,1:47:50.30,Default,,0000,0000,0000,,Ум, консомме, тұз, сарымсақ....
Dialogue: 0,1:47:50.30,1:47:52.47,Default,,0000,0000,0000,,Зәйтүн майы да бар емес пе?
Dialogue: 0,1:47:52.47,1:47:54.80,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,1:47:54.80,1:47:57.64,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,1:47:54.80,1:47:57.64,Default,,0000,0000,0000,,Мен лагерьге барғалы біраз болды.
Dialogue: 0,1:47:57.64,1:47:59.64,Default,,0000,0000,0000,,Сонда сен алдасың.
Dialogue: 0,1:47:59.64,1:48:02.64,Default,,0000,0000,0000,,Иә. Сақ болыңыз.
Dialogue: 0,1:47:59.64,1:48:02.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:48:06.25,1:48:08.25,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:48:12.92,1:48:15.42,Default,,0000,0000,0000,,Бұл қозғалтқыштың ескерту шамы ма?
Dialogue: 0,1:48:15.42,1:48:18.59,Default,,0000,0000,0000,,Қауіпсіз болу үшін мен оны техникалық қызмет көрсетуге жіберуім керек.
Dialogue: 0,1:48:15.42,1:48:18.59,Default,,0000,0000,0000,,Бұл қауіпті.
Dialogue: 0,1:48:18.59,1:48:21.43,Default,,0000,0000,0000,,Мен жоғары-төмен жүрсем не істеуім керек...
Dialogue: 0,1:48:21.43,1:48:23.76,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,1:48:21.43,1:48:23.76,Default,,0000,0000,0000,,Бұған қалай қарайсыз?
Dialogue: 0,1:48:23.76,1:48:25.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:48:36.78,1:48:40.45,Default,,0000,0000,0000,,Қабылдау формасы ретінде не жазу керек
Dialogue: 0,1:48:36.78,1:48:40.45,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:48:40.45,1:48:43.12,Default,,0000,0000,0000,,Өзгеріс те тамаша.
Dialogue: 0,1:48:43.12,1:48:46.62,Default,,0000,0000,0000,,Дәретхананы тазалау аяқталды!
Dialogue: 0,1:48:43.12,1:48:46.62,Default,,0000,0000,0000,,О~ Рахмет.
Dialogue: 0,1:48:46.62,1:48:51.29,Default,,0000,0000,0000,,Бүгінгі тұтынушылар
Dialogue: 0,1:48:46.62,1:48:51.29,Default,,0000,0000,0000,,10 топ және 2 соло.
Dialogue: 0,1:48:51.29,1:48:53.79,Default,,0000,0000,0000,,Жиі келмеу.
Dialogue: 0,1:48:51.29,1:48:53.79,Default,,0000,0000,0000,,Дегенмен➡
Dialogue: 0,1:48:53.79,1:48:55.96,Default,,0000,0000,0000,,Біз жартылай таныспыз.
Dialogue: 0,1:48:55.96,1:48:58.77,Default,,0000,0000,0000,,Ашылған алғашқы күндегі жақсы жұмыс.
Dialogue: 0,1:49:00.90,1:49:03.50,Default,,0000,0000,0000,,Уақыт келді.
Dialogue: 0,1:49:00.90,1:49:03.50,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:49:12.41,1:49:14.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:49:18.08,1:49:21.25,Default,,0000,0000,0000,,Ешкім жоқ...
Dialogue: 0,1:49:21.25,1:49:24.09,Default,,0000,0000,0000,,Мен бас тарту туралы хабарлама алған жоқпын.
Dialogue: 0,1:49:24.09,1:49:27.09,Default,,0000,0000,0000,,Жақсы, күткендей.
Dialogue: 0,1:49:24.09,1:49:27.09,Default,,0000,0000,0000,,Нақты ашылу уақыты➡
Dialogue: 0,1:49:27.09,1:49:29.26,Default,,0000,0000,0000,,Келмейсің бе?
Dialogue: 0,1:49:27.09,1:49:29.26,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:49:29.26,1:49:31.60,Default,,0000,0000,0000,,☎
Dialogue: 0,1:49:31.60,1:49:36.77,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:49:31.60,1:49:36.77,Default,,0000,0000,0000,,Фуджикава қарағайлы лагері.
Dialogue: 0,1:49:36.77,1:49:39.27,Default,,0000,0000,0000,,Не? Білмейсіз бе?
Dialogue: 0,1:49:39.27,1:49:41.78,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:49:39.27,1:49:41.78,Default,,0000,0000,0000,,Бұл белгі ме?
Dialogue: 0,1:49:41.78,1:49:44.78,Default,,0000,0000,0000,,Тексеру
Dialogue: 0,1:49:41.78,1:49:44.78,Default,,0000,0000,0000,,Мен сізге бірден хабарласамын.
Dialogue: 0,1:49:46.78,1:49:49.78,Default,,0000,0000,0000,,Бізде көптеген ақпараттық тақталар дайындалған болатын, солай емес пе?
Dialogue: 0,1:49:49.78,1:49:52.12,Default,,0000,0000,0000,,Біз оны бірге жасадық, солай ма?
Dialogue: 0,1:49:49.78,1:49:52.12,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:49:52.12,1:49:55.62,Default,,0000,0000,0000,,Эй, сәлем…. Бұл туралы ше?
Dialogue: 0,1:49:55.62,1:49:57.62,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:49:57.62,1:50:00.13,Default,,0000,0000,0000,,Қосулы болуы керек
Dialogue: 0,1:49:57.62,1:50:00.13,Default,,0000,0000,0000,,Мұның мағынасы жоқ!
Dialogue: 0,1:50:00.13,1:50:03.30,Default,,0000,0000,0000,,Мүмкін тұтынушы?
Dialogue: 0,1:50:00.13,1:50:03.30,Default,,0000,0000,0000,,Бұл адасып кетуден басқаша ма?
Dialogue: 0,1:50:03.30,1:50:05.60,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:50:03.30,1:50:05.60,Default,,0000,0000,0000,,📱 (дірілдеген дыбыс)
Dialogue: 0,1:50:08.30,1:50:10.97,Default,,0000,0000,0000,,Акари! Қазір қайдасың?
Dialogue: 0,1:50:10.97,1:50:14.47,Default,,0000,0000,0000,,📱Бұл
Dialogue: 0,1:50:10.97,1:50:14.47,Default,,0000,0000,0000,,Мен қайда екенін білмеймін.
Dialogue: 0,1:50:14.47,1:50:16.81,Default,,0000,0000,0000,,Міне, мен қатты шатасамын.
Dialogue: 0,1:50:16.81,1:50:19.15,Default,,0000,0000,0000,,Мен сені алып кетейін.
Dialogue: 0,1:50:19.15,1:50:23.32,Default,,0000,0000,0000,,Надешико мен Сайто
Dialogue: 0,1:50:19.15,1:50:23.32,Default,,0000,0000,0000,,Мені жоғалған адамға бағыттаңыз.
Dialogue: 0,1:50:23.32,1:50:25.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:50:23.32,1:50:25.99,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,1:50:25.99,1:50:29.49,Default,,0000,0000,0000,,Памфлет картасы
Dialogue: 0,1:50:25.99,1:50:29.49,Default,,0000,0000,0000,,Түсіндіру оңай деп ойлаймын.
Dialogue: 0,1:50:29.49,1:50:32.16,Default,,0000,0000,0000,,Жақын жерде ғибадатхана сияқты нәрсені көруге болады дейді.
Dialogue: 0,1:50:32.16,1:50:34.66,Default,,0000,0000,0000,,Осы жерден ғибадатхана тапсаңыз...
Dialogue: 0,1:50:32.16,1:50:34.66,Default,,0000,0000,0000,,Міне, уақыты!
Dialogue: 0,1:50:34.66,1:50:38.00,Default,,0000,0000,0000,,Ақ вагон.
Dialogue: 0,1:50:34.66,1:50:38.00,Default,,0000,0000,0000,,Бұл Йокогама нөмірі болғандықтан ерекше болуы мүмкін.
Dialogue: 0,1:50:38.00,1:50:40.00,Default,,0000,0000,0000,,Өтінемін, Рин Чан!
Dialogue: 0,1:50:40.00,1:50:42.00,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:50:47.34,1:50:49.34,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:50:52.01,1:52:15.83,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:52:21.30,1:52:25.31,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,1:52:25.31,1:52:27.31,Default,,0000,0000,0000,,Генки Генки.
Dialogue: 0,1:52:29.81,1:52:34.81,Default,,0000,0000,0000,,Бұл осы жерден табылды.
Dialogue: 0,1:52:29.81,1:52:34.81,Default,,0000,0000,0000,,Бұл Джомон дәуірінен қалған резиденция қалдықтары.
Dialogue: 0,1:52:34.81,1:52:38.49,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:52:38.49,1:52:40.49,Default,,0000,0000,0000,,Бұл үлкен шатырдың көлеміндей.
Dialogue: 0,1:52:40.49,1:52:42.66,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:52:42.66,1:52:45.16,Default,,0000,0000,0000,,Уау! Хаха!
Dialogue: 0,1:52:47.66,1:52:50.50,Default,,0000,0000,0000,,Әй!
Dialogue: 0,1:52:50.50,1:52:53.17,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:52:53.17,1:52:56.57,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:52:53.17,1:52:56.57,Default,,0000,0000,0000,,Ах. Апыр-ай!
Dialogue: 0,1:52:59.94,1:53:04.78,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:53:04.78,1:53:07.95,Default,,0000,0000,0000,,Жаңа мектептегі балалар
Dialogue: 0,1:53:04.78,1:53:07.95,Default,,0000,0000,0000,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,1:53:07.95,1:53:12.12,Default,,0000,0000,0000,,Иә. Барлығы
Dialogue: 0,1:53:07.95,1:53:12.12,Default,,0000,0000,0000,,Біз қазірдің өзінде жақсы доспыз.
Dialogue: 0,1:53:12.12,1:53:14.62,Default,,0000,0000,0000,,Ухуху.
Dialogue: 0,1:53:14.62,1:53:16.62,Default,,0000,0000,0000,,Надешико!
Dialogue: 0,1:53:16.62,1:53:20.83,Default,,0000,0000,0000,,Өтінемін~!
Dialogue: 0,1:53:16.62,1:53:20.83,Default,,0000,0000,0000,,Иә! Мен үйдемін!
Dialogue: 0,1:53:22.96,1:53:25.47,Default,,0000,0000,0000,,Wow~ Кәсіби маман күткендей.
Dialogue: 0,1:53:25.47,1:53:27.63,Default,,0000,0000,0000,,Хехех жақсы.
Dialogue: 0,1:53:27.63,1:53:31.34,Default,,0000,0000,0000,,Ах. Эй Рин Чан!
Dialogue: 0,1:53:39.31,1:53:41.31,Default,,0000,0000,0000,,⚟Рин.
Dialogue: 0,1:53:44.82,1:53:47.15,Default,,0000,0000,0000,,Ата.
Dialogue: 0,1:53:47.15,1:53:50.32,Default,,0000,0000,0000,,Қош келдіңіз. Ол келді.
Dialogue: 0,1:53:50.32,1:53:52.33,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:53:52.33,1:53:56.13,Default,,0000,0000,0000,,Ол аяқталды.
Dialogue: 0,1:53:52.33,1:53:56.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:54:00.10,1:54:02.77,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:54:02.77,1:54:05.27,Default,,0000,0000,0000,,Бұл жақсы лагерь.
Dialogue: 0,1:54:07.44,1:54:09.74,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:54:15.78,1:55:13.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:55:13.94,1:55:17.28,Default,,0000,0000,0000,,Барлығы көңілді жүрген сияқты.
Dialogue: 0,1:55:13.94,1:55:17.28,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:55:17.28,1:55:21.61,Default,,0000,0000,0000,,Мен бақыттымын.
Dialogue: 0,1:55:17.28,1:55:21.61,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:55:21.61,1:55:26.29,Default,,0000,0000,0000,,Мен мұны істегеніме қуаныштымын.
Dialogue: 0,1:55:21.61,1:55:26.29,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:55:26.29,1:55:28.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:55:26.29,1:55:28.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:55:28.96,1:55:30.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:55:30.96,1:55:33.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:55:36.30,1:55:40.13,Default,,0000,0000,0000,,Сәлем! Жаңа жыл кеші
Dialogue: 0,1:55:36.30,1:55:40.13,Default,,0000,0000,0000,,Жаңа жыл қарсаңында тағы да осында лагерь жасағыңыз келе ме?
Dialogue: 0,1:55:40.13,1:55:42.30,Default,,0000,0000,0000,,О, жақсы! Олай болса➡
Dialogue: 0,1:55:42.30,1:55:45.31,Default,,0000,0000,0000,,Алмаз Фудзиде алғашқы күннің шығуы
Dialogue: 0,1:55:42.30,1:55:45.31,Default,,0000,0000,0000,,Соған мақсат қояйық.
Dialogue: 0,1:55:45.31,1:55:48.14,Default,,0000,0000,0000,,Біз не жейміз?
Dialogue: 0,1:55:45.31,1:55:48.14,Default,,0000,0000,0000,,Жаңа жыл кешінен кейін➡
Dialogue: 0,1:55:48.14,1:55:50.14,Default,,0000,0000,0000,,Бәріміз бірге соба жейміз бе?
Dialogue: 0,1:55:50.14,1:55:52.15,Default,,0000,0000,0000,,Рин-чан да.
Dialogue: 0,1:55:52.15,1:55:54.98,Default,,0000,0000,0000,,Уа...
Dialogue: 0,1:55:54.98,1:55:57.15,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:55:57.15,1:55:59.15,Default,,0000,0000,0000,,О!
Dialogue: 0,1:55:59.15,1:56:02.42,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:56:02.42,1:56:04.42,Default,,0000,0000,0000,,Әзірге...
Dialogue: 0,1:56:04.42,1:56:06.93,Default,,0000,0000,0000,,Ойлан.
Dialogue: 0,1:56:08.43,1:56:14.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory