Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.97,0:00:11.97,Default,,0,0,0,,(құбырды ашады)
Dialogue: 0,0:00:13.98,0:00:15.98,Default,,0,0,0,,Иә
Dialogue: 0,0:00:15.98,0:00:17.98,Default,,0,0,0,,(сүйрету дыбысы)
Dialogue: 0,0:00:35.66,0:00:37.67,Default,,0,0,0,,Сәлем, мен Кумамын.
Dialogue: 0,0:00:37.67,0:00:40.07,Default,,0,0,0,,Мен оны көрмедім деп айта аламын ба?
Dialogue: 0,0:00:42.00,0:00:44.67,Default,,0,0,0,,Ендеше, ол жақтан неге келе жатырсың?
Dialogue: 0,0:00:44.67,0:00:48.18,Default,,0,0,0,,Бұл тек сол жақтағы автоматта бар.
Dialogue: 0,0:00:48.18,0:00:50.68,Default,,0,0,0,,Құдай-ау, Майой
Dialogue: 0,0:00:50.68,0:00:53.35,Default,,0,0,0,,Неге бұлай киініп келдің?
Dialogue: 0,0:00:53.35,0:00:55.52,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:00:55.52,0:00:58.52,Default,,0,0,0,,Кездейсоқ, мен қонжықты алдым.
Dialogue: 0,0:00:58.52,0:01:01.46,Default,,0,0,0,,Мен барлығын таң қалдырғым келді.
Dialogue: 0,0:01:01.46,0:01:05.29,Default,,0,0,0,,Сіз бірінші рет сәтсіздікке ұшырадыңыз, хмм.
Dialogue: 0,0:01:05.29,0:01:08.63,Default,,0,0,0,,Дәлірек айтқанда, костюм киген аюдың беті қалыпты түрде көрінеді.
Dialogue: 0,0:01:08.63,0:01:11.97,Default,,0,0,0,,Мені тосыннан ұстап алсаңыз, таң қалмайсыз деп ойлаймын.
Dialogue: 0,0:01:11.97,0:01:13.97,Default,,0,0,0,,Nyohohoho
Dialogue: 0,0:01:19.14,0:01:22.98,Default,,0,0,0,,Мен бұл қулыққа таң қалдым.
Dialogue: 0,0:01:22.98,0:02:51.00,Default,,0,0,0,,♬～
Dialogue: 0,0:03:12.29,0:03:16.12,Default,,0,0,0,,Ой, келесі мақсат табылды!
Dialogue: 0,0:03:16.12,0:03:19.46,Default,,0,0,0,,Цумики Майоймен кездесіп жатырсыз ба?
Dialogue: 0,0:03:19.46,0:03:23.13,Default,,0,0,0,,Егер сіз мұны жасасаңыз, адамдар сіздің еркелік жасап жатқаныңызды байқайды.
Dialogue: 0,0:03:23.13,0:03:26.30,Default,,0,0,0,,Бұл да дұрыс... әсіресе Цумики болса.
Dialogue: 0,0:03:26.30,0:03:30.81,Default,,0,0,0,,Дәл қазір Цумики-сан осыны ойлап, күтіп отыр.
Dialogue: 0,0:03:30.81,0:03:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:45.99,0:03:48.32,Default,,0,0,0,,Мазмұнның ақиқатына немесе жалғандығына қарамастан
Dialogue: 0,0:03:48.32,0:03:50.83,Default,,0,0,0,,Соңы Біртүрлі дыбыстарды естімедің бе?
Dialogue: 0,0:03:50.83,0:03:53.83,Default,,0,0,0,,Ал, кететін уақыт келді деп ойлаймын. Ах...
Dialogue: 0,0:04:07.44,0:04:09.61,Default,,0,0,0,,Гах гага гага гавк
Dialogue: 0,0:04:09.61,0:04:12.01,Default,,0,0,0,,Гао
Dialogue: 0,0:04:14.28,0:04:17.12,Default,,0,0,0,,Егер бұл өте қиын болса, сіз тоқтай аласыз.
Dialogue: 0,0:04:17.12,0:04:19.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:21.46,0:04:24.46,Default,,0,0,0,,⚟(Майои) Айтпақшы, Цумики-сан Ими-санмен➡
Dialogue: 0,0:04:24.46,0:04:27.13,Default,,0,0,0,,Менің мектепке барғанымды күтіп тұрсың ба?
Dialogue: 0,0:04:27.13,0:04:29.63,Default,,0,0,0,,Жоқ, бірақ Ими-санмен.
Dialogue: 0,0:04:29.63,0:04:32.97,Default,,0,0,0,,Біз мектепке жиі бірге барамыз.
Dialogue: 0,0:04:32.97,0:04:37.81,Default,,0,0,0,,Таңертең кездейсоқ кездесіп қалып, бірге қалғандай болдық.
Dialogue: 0,0:04:37.81,0:04:40.14,Default,,0,0,0,,Өйткені тұрақты орын жоқ.
Dialogue: 0,0:04:40.14,0:04:43.81,Default,,0,0,0,,Хмм~ Мүмкін Цумики-сан➡
Dialogue: 0,0:04:43.81,0:04:48.48,Default,,0,0,0,,Күнделікті орын мен уақытты шебер өзгертіп, күмәндануға орын қалдырмайды➡
Dialogue: 0,0:04:48.48,0:04:51.99,Default,,0,0,0,,Мен мұны тамаша кездейсоқтық деп көрсетуге тырыстым...
Dialogue: 0,0:04:51.99,0:04:53.99,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:04:54.99,0:04:56.99,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:05:01.26,0:05:05.60,Default,,0,0,0,,Айтпақшы, ханшайым ше? Біз әрқашан мектепке бірге барамыз.
Dialogue: 0,0:05:05.60,0:05:08.77,Default,,0,0,0,,Біз бүгін сізді таң қалдыру үшін жиналып отырмыз.
Dialogue: 0,0:05:08.77,0:05:13.11,Default,,0,0,0,,Сәтсіз қалған Ими мен Цумики мырзаны таң қалдырмаңыз.
Dialogue: 0,0:05:13.11,0:05:16.81,Default,,0,0,0,,Ханшайым таң қалатын сияқты.
Dialogue: 0,0:05:17.95,0:05:20.62,Default,,0,0,0,,Химе-цчидің белі тайып кетпесін.
Dialogue: 0,0:05:20.62,0:05:24.12,Default,,0,0,0,,Қалыпты жағдайда, тым ұялшақ болсаң, ханшайым
Dialogue: 0,0:05:24.12,0:05:26.12,Default,,0,0,0,,Себебі менің мойным түсіп кетуі мүмкін
Dialogue: 0,0:05:26.12,0:05:28.62,Default,,0,0,0,,《(ханшайым) Менің басым түсіп кетті, қозғала алмаймын》
Dialogue: 0,0:05:32.46,0:05:34.46,Default,,0,0,0,,Ах
Dialogue: 0,0:05:34.46,0:05:37.27,Default,,0,0,0,,Қайырлы таң Майой-сан...
Dialogue: 0,0:05:40.30,0:05:43.47,Default,,0,0,0,,Жоқ! Nyoho
Dialogue: 0,0:05:43.47,0:05:45.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:45.97,0:05:47.98,Default,,0,0,0,,Гао хиееее
Dialogue: 0,0:05:47.98,0:05:52.48,Default,,0,0,0,,Жоқ, аю мені екі аяғымен қуып келеді.
Dialogue: 0,0:05:52.48,0:05:55.15,Default,,0,0,0,,Гао!
Dialogue: 0,0:05:55.15,0:05:58.05,Default,,0,0,0,,Екі аяқпен жүру...
Dialogue: 0,0:05:59.92,0:06:03.09,Default,,0,0,0,,Сіз бұл реакцияны іздедіңіз.
Dialogue: 0,0:06:03.09,0:06:05.59,Default,,0,0,0,,Амансың ба? ханшайым
Dialogue: 0,0:06:06.93,0:06:09.60,Default,,0,0,0,,Бұл өте қорқынышты болды.
Dialogue: 0,0:06:09.60,0:06:11.93,Default,,0,0,0,,Мен шындап қашып кеттім.
Dialogue: 0,0:06:11.93,0:06:16.10,Default,,0,0,0,,Бірақ мен сенің бұлай таң қалатыныңды күтпеген едім.
Dialogue: 0,0:06:16.10,0:06:19.27,Default,,0,0,0,,Жақсысың ба, Канян? иә орамал
Dialogue: 0,0:06:19.27,0:06:21.94,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:21.94,0:06:24.45,Default,,0,0,0,,Ал, мен аюды кездестірдім.
Dialogue: 0,0:06:24.45,0:06:26.62,Default,,0,0,0,,Спортшы ретінде жүгіріп жүргенде қуып жетсеңіз
Dialogue: 0,0:06:26.62,0:06:28.78,Default,,0,0,0,,Әдетте сіз қорқыныш сезінесіз.
Dialogue: 0,0:06:28.78,0:06:32.29,Default,,0,0,0,,Бұл қазірдің өзінде сұмдық, енді қайта естідім.
Dialogue: 0,0:06:32.29,0:06:34.29,Default,,0,0,0,,Бұл, әрине, қорқынышты болды.
Dialogue: 0,0:06:36.46,0:06:38.96,Default,,0,0,0,,Сакаки мырза
Dialogue: 0,0:06:38.96,0:06:40.96,Default,,0,0,0,,Сакаки де таң қалады ма?
Dialogue: 0,0:06:40.96,0:06:42.96,Default,,0,0,0,,Әрине, бұл мочи➡
Dialogue: 0,0:06:42.96,0:06:45.47,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:45.47,0:06:48.14,Default,,0,0,0,,Не болды? Сакаки жағдайында
Dialogue: 0,0:06:48.14,0:06:51.47,Default,,0,0,0,,Жай ғана шабуыл жасаған тиімдірек емес пе?
Dialogue: 0,0:06:51.47,0:06:55.64,Default,,0,0,0,,Егер сіз оғаш нәрсе жасасаңыз, олар сіздің көзіңізден көрінетін шығар деп ойлаймын.
Dialogue: 0,0:06:55.64,0:06:59.65,Default,,0,0,0,,Екі аяқпен жүгіресіз бе, әлде төрт аяқпен жүгіресіз бе?
Dialogue: 0,0:06:59.65,0:07:01.58,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:07:01.58,0:07:03.59,Default,,0,0,0,,Ойлану үшін өзіңізге біраз орын беруіңіз керек.
Dialogue: 0,0:07:03.59,0:07:06.25,Default,,0,0,0,,Менің ойымша, сіз таң қаласыз, тіпті Сакаки де.
Dialogue: 0,0:07:06.25,0:07:08.92,Default,,0,0,0,,Шана мінген аю... Иә?
Dialogue: 0,0:07:08.92,0:07:12.76,Default,,0,0,0,,Мені шамалы қимылдамай қатты жылдамдықпен қуа ма деп ойлаймын.
Dialogue: 0,0:07:12.76,0:07:14.76,Default,,0,0,0,,Бұл өте қорқынышты!
Dialogue: 0,0:07:18.10,0:07:20.30,Default,,0,0,0,,Олай болса, барып көрейік.
Dialogue: 0,0:07:24.11,0:07:26.11,Default,,0,0,0,,Дайын
Dialogue: 0,0:07:30.45,0:07:33.05,Default,,0,0,0,,...
Dialogue: 0,0:07:34.62,0:07:37.29,Default,,0,0,0,,(Шананың жақындаған дыбысы)
Dialogue: 0,0:07:37.29,0:07:39.29,Default,,0,0,0,,Бірдеңе келді➡
Dialogue: 0,0:07:39.29,0:07:41.49,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:07:46.29,0:07:48.30,Default,,0,0,0,,Үлкен...
Dialogue: 0,0:07:54.64,0:07:57.14,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:07:57.14,0:07:59.31,Default,,0,0,0,,Бұл... Иноми ме? ➡
Dialogue: 0,0:07:59.31,0:08:03.41,Default,,0,0,0,,Мен сізге не болғанын нақты айтып беремін...
Dialogue: 0,0:08:03.41,0:08:06.25,Default,,0,0,0,,Қозғалмайтын аю шанамен жүреді.
Dialogue: 0,0:08:06.25,0:08:08.25,Default,,0,0,0,,Егер сіз оны жоғары жылдамдықта пайда болды деп ойласаңыз
Dialogue: 0,0:08:08.25,0:08:10.42,Default,,0,0,0,,Ол керемет соққы жасады.
Dialogue: 0,0:08:10.42,0:08:13.25,Default,,0,0,0,,Мен енді не туралы айтып тұрғанымды да білмеймін...
Dialogue: 0,0:08:13.25,0:08:15.26,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:08:15.26,0:08:17.26,Default,,0,0,0,,Мен... Мен өзіме сенімді емеспін.
Dialogue: 0,0:08:17.26,0:08:19.76,Default,,0,0,0,,Жоқ, мен саған айтқан жоқпын.
Dialogue: 0,0:08:22.26,0:08:24.60,Default,,0,0,0,,Айқай... Айқай ➡
Dialogue: 0,0:08:24.60,0:08:29.60,Default,,0,0,0,,Әйтеуір... Сакаки-санды әйтеуір таң қалдырсам керек.
Dialogue: 0,0:08:29.60,0:08:32.77,Default,,0,0,0,,Кешіріңіз, бірақ бұл қатты соққы болды.
Dialogue: 0,0:08:32.77,0:08:34.94,Default,,0,0,0,,Менің айтайын дегенім, бұл мені ұшырды.
Dialogue: 0,0:08:34.94,0:08:38.95,Default,,0,0,0,,Бұған таң қалмайтындар – Миико мен Онива.
Dialogue: 0,0:08:38.95,0:08:40.95,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:40.95,0:08:43.79,Default,,0,0,0,,Күткендей, Миико-сан бұрын болған оқиғаға таң қалды...
Dialogue: 0,0:08:43.79,0:08:46.49,Default,,0,0,0,,《Гаах》 《Арааара》
Dialogue: 0,0:08:47.46,0:08:50.79,Default,,0,0,0,,Және... Иә? Мен елестете алмаймын
Dialogue: 0,0:08:50.79,0:08:53.63,Default,,0,0,0,,Бұл соншалықты жүрекке жылы тиетін көрініс емес.
Dialogue: 0,0:08:53.63,0:08:57.30,Default,,0,0,0,,Миико-санды таң қалдыру мүмкін емес.
Dialogue: 0,0:08:57.30,0:08:59.30,Default,,0,0,0,,Оң жақ ⚟(Майои) Ньохо
Dialogue: 0,0:08:59.30,0:09:02.57,Default,,0,0,0,,Мен алдымнан Кикуэ-сенсэйді таптым.
Dialogue: 0,0:09:02.57,0:09:06.91,Default,,0,0,0,,Мен бонустық миссияны қазір бастағым келеді.
Dialogue: 0,0:09:06.91,0:09:10.08,Default,,0,0,0,,Жарайды, мен де қосыламын.
Dialogue: 0,0:09:10.08,0:09:13.42,Default,,0,0,0,,Оны тоқтатудың қажеті жоқ. Бұл босқа.
Dialogue: 0,0:09:13.42,0:09:16.08,Default,,0,0,0,,Егер сіз Майойдың қасында бірге жарыссаңыз
Dialogue: 0,0:09:16.08,0:09:18.92,Default,,0,0,0,,Бұл еркелік екені бір кадрдан көрініп қалмай ма?
Dialogue: 0,0:09:18.92,0:09:20.92,Default,,0,0,0,,Менің ойымша ➡
Dialogue: 0,0:09:20.92,0:09:25.03,Default,,0,0,0,,Сондықтан мен қолымдағыны ретке келтірдім...
Dialogue: 0,0:09:27.93,0:09:29.93,Default,,0,0,0,,Мен мұнымен барамын.
Dialogue: 0,0:09:29.93,0:09:32.93,Default,,0,0,0,,Мен полиция қызметкері болсам, сізді ойланбастан тұтқынға алар едім.
Dialogue: 0,0:09:35.60,0:09:39.11,Default,,0,0,0,,Ал, кеттік. Қандай тамаша сурет.
Dialogue: 0,0:09:41.28,0:09:43.28,Default,,0,0,0,,Қайырлы таң, мұғалім.
Dialogue: 0,0:09:43.28,0:09:45.28,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:09:45.28,0:09:47.28,Default,,0,0,0,,⚟ (Майои) Сенсэй Қайырлы таң.
Dialogue: 0,0:09:47.28,0:09:49.28,Default,,0,0,0,,Иә, қайырлы таң...
Dialogue: 0,0:09:52.95,0:09:55.29,Default,,0,0,0,,Ей!
Dialogue: 0,0:09:55.29,0:09:57.46,Default,,0,0,0,,Ал 16:42-де
Dialogue: 0,0:09:57.46,0:09:59.79,Default,,0,0,0,,Ия, не?
Dialogue: 0,0:09:59.79,0:10:01.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.80,0:10:04.47,Default,,0,0,0,,Ду-сей!
Dialogue: 0,0:10:04.47,0:10:07.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:07.64,0:10:10.47,Default,,0,0,0,,(Кикуэдің айқайы)
Dialogue: 0,0:10:10.47,0:10:12.47,Default,,0,0,0,,Сіз қаншалықты алыс барасыз? ?
Dialogue: 0,0:10:12.47,0:10:14.64,Default,,0,0,0,,Мектепке...?
Dialogue: 0,0:10:14.64,0:10:17.15,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:10:17.15,0:10:20.05,Default,,0,0,0,,Барамыз ба? Иә.
Dialogue: 0,0:10:21.48,0:10:23.99,Default,,0,0,0,,Ах
Dialogue: 0,0:10:23.99,0:10:26.99,Default,,0,0,0,,Цумики Таң атты.
Dialogue: 0,0:10:26.99,0:10:31.49,Default,,0,0,0,,А, бұл күту емес... иә?
Dialogue: 0,0:10:31.49,0:10:34.50,Default,,0,0,0,,Біз кездесеміз бе?
Dialogue: 0,0:10:34.50,0:10:36.83,Default,,0,0,0,,Ертеңнен бастап
Dialogue: 0,0:10:36.83,0:10:39.17,Default,,0,0,0,,Ум... у...
Dialogue: 0,0:10:39.17,0:10:42.67,Default,,0,0,0,,Жарайды, бірақ... неге?
Dialogue: 0,0:10:42.67,0:10:48.34,Default,,0,0,0,,Хмм, менің ойымша, бұл маусымда таңертең суық болады.
Dialogue: 0,0:10:48.34,0:10:51.68,Default,,0,0,0,,Сіз басқаша десе де...
Dialogue: 0,0:10:51.68,0:10:54.08,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:10:55.85,0:10:58.65,Default,,0,0,0,,Ай!
Dialogue: 0,0:10:59.95,0:11:02.96,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:15.47,0:11:18.81,Default,,0,0,0,,Қысқы демалыс жақындап қалды, солай емес пе?
Dialogue: 0,0:11:18.81,0:11:21.81,Default,,0,0,0,,үшінңыз, 24-ті бір жаққа қалдырыңыз.
Dialogue: 0,0:11:21.81,0:11:24.65,Default,,0,0,0,,Ханшайым екеуміздің сол күнге жоспарымыз бар.
Dialogue: 0,0:11:24.65,0:11:27.65,Default,,0,0,0,,Мияу мияу! ? Екеуміздің жоспарымызға келсек...
Dialogue: 0,0:11:27.65,0:11:30.15,Default,,0,0,0,,Жаңа! ?
Dialogue: 0,0:11:31.99,0:11:33.99,Default,,0,0,0,,Ня Цумики
Dialogue: 0,0:11:33.99,0:11:36.82,Default,,0,0,0,,Не болды, Цумики? Мен біртүрлі болып тұрмын
Dialogue: 0,0:11:36.82,0:11:38.83,Default,,0,0,0,,Айла...
Dialogue: 0,0:11:38.83,0:11:42.00,Default,,0,0,0,,Ими мырза, сіз мүлде түсінбейсіз.
Dialogue: 0,0:11:42.00,0:11:45.00,Default,,0,0,0,,Сіз толық емес жұмыс күні туралы айтып отырсыз ба? Иә
Dialogue: 0,0:11:45.00,0:11:48.34,Default,,0,0,0,,Ханшайым екеуміз, Сакаки ауысымда.
Dialogue: 0,0:11:48.34,0:11:50.34,Default,,0,0,0,,болып табылады
Dialogue: 0,0:11:52.01,0:11:54.68,Default,,0,0,0,,Неліктен сіз толық емес жұмысқа орналасар едіңіз?
Dialogue: 0,0:11:54.68,0:11:57.18,Default,,0,0,0,,Менің бұл күні басқа шаруам жоқ.
Dialogue: 0,0:11:57.18,0:12:00.11,Default,,0,0,0,,Мен де Жоқ!
Dialogue: 0,0:12:00.11,0:12:02.62,Default,,0,0,0,,Бұл керемет Рождество, солай емес пе?
Dialogue: 0,0:12:02.62,0:12:05.12,Default,,0,0,0,,Иә, бірақ... Мухах
Dialogue: 0,0:12:05.12,0:12:08.62,Default,,0,0,0,,Қараңызшы, тағы бір нәрсе істеу керек, солай ма?
Dialogue: 0,0:12:08.62,0:12:11.96,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:12:11.96,0:12:15.13,Default,,0,0,0,,Мысалы? Сүйіктіммен...
Dialogue: 0,0:12:15.13,0:12:18.63,Default,,0,0,0,,Қайырлы таңнан сүйіктіңізбен қайырлы түнге дейін! ?
Dialogue: 0,0:12:18.63,0:12:20.97,Default,,0,0,0,,Өмірге көзқарас
Dialogue: 0,0:12:20.97,0:12:23.57,Default,,0,0,0,,Сіз Рождествода не істеп жатырсыз? Сол жұп...
Dialogue: 0,0:12:25.81,0:12:28.64,Default,,0,0,0,,Сол күні бірдеңе болып жатыр ма?
Dialogue: 0,0:12:28.64,0:12:33.65,Default,,0,0,0,,Мен барлығымен Рождество кешін өткізгім келеді...
Dialogue: 0,0:12:38.15,0:12:40.15,Default,,0,0,0,,⚟(Майои) Мен солай ойладым...
Dialogue: 0,0:12:40.15,0:12:42.82,Default,,0,0,0,,Майой қатты күйзеліске түседі.
Dialogue: 0,0:12:42.82,0:12:45.33,Default,,0,0,0,,Солай ма? ⚟(Mayoi) демо жақсылары➡
Dialogue: 0,0:12:45.33,0:12:48.00,Default,,0,0,0,,Қалай жоспарлау керек
Dialogue: 0,0:12:48.00,0:12:50.16,Default,,0,0,0,,Мәтіні де біртүрлі екен...
Dialogue: 0,0:12:50.16,0:12:55.17,Default,,0,0,0,,⚟(Майои) Ал Ими-сан мен Химе-чи Рождествоны бірге өткізеді.
Dialogue: 0,0:12:55.17,0:12:57.57,Default,,0,0,0,,Бұл толық емес жұмыс күні!
Dialogue: 0,0:13:01.61,0:13:03.78,Default,,0,0,0,,Тіпті Цумики-сан.
Dialogue: 0,0:13:03.78,0:13:07.98,Default,,0,0,0,,Олай болса, бірге жасаймыз ба? уақытша толық емес жұмыс
Dialogue: 0,0:13:09.12,0:13:12.52,Default,,0,0,0,,Миико-сан оған көмек керек екенін айтты.
Dialogue: 0,0:13:16.12,0:13:18.13,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:19.46,0:13:22.30,Default,,0,0,0,,О, мен мұны істеймін!
Dialogue: 0,0:13:22.30,0:13:26.50,Default,,0,0,0,,Көмектесемін. Менің барлығыңызбен бірге Рождестволық толық емес жұмыс күнім бар.
Dialogue: 0,0:13:37.98,0:13:39.98,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:13:39.98,0:13:43.48,Default,,0,0,0,,Қайырлы таң~ (Сакаки) Эй, келдің.
Dialogue: 0,0:13:43.48,0:13:45.49,Default,,0,0,0,,Қайырлы таң Қайырлы таң
Dialogue: 0,0:13:45.49,0:13:47.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:47.66,0:13:50.66,Default,,0,0,0,,⚟(Майои) Мен бүгінгі күнді асыға күтпеймін. ⚟(ханшайым) Иә.
Dialogue: 0,0:13:50.66,0:13:53.49,Default,,0,0,0,,Бүгінгі көмегіңіз үшін рахмет.
Dialogue: 0,0:13:53.49,0:13:56.33,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:13:56.33,0:13:59.93,Default,,0,0,0,,Екеуің Имикунмен дүкенде отырсыңдар.
Dialogue: 0,0:13:59.93,0:14:02.77,Default,,0,0,0,,Рождестволық торттарды сатыңыз.
Dialogue: 0,0:14:02.77,0:14:04.77,Default,,0,0,0,,Түсіндім, ня
Dialogue: 0,0:14:04.77,0:14:07.28,Default,,0,0,0,,Аяз ата костюмінде (Цумики Майои) Аяз ата! ?
Dialogue: 0,0:14:07.28,0:14:10.28,Default,,0,0,0,,Миико-сан, мен форма киемін, солай ма?
Dialogue: 0,0:14:10.28,0:14:13.28,Default,,0,0,0,,Өтінемін, иә...
Dialogue: 0,0:14:13.28,0:14:16.28,Default,,0,0,0,,Саған жарасатынына сенімдімін, хехе
Dialogue: 0,0:14:16.28,0:14:18.62,Default,,0,0,0,,Ими қысымға берілуде.
Dialogue: 0,0:14:18.62,0:14:23.83,Default,,0,0,0,,Миико-ни - Игоның әлсіз жақтарының бірі.
Dialogue: 0,0:14:27.96,0:14:32.63,Default,,0,0,0,,Аяз атаның киімдері өте жылы, солай емес пе? Олар ыңғайлы.
Dialogue: 0,0:14:32.63,0:14:36.47,Default,,0,0,0,,Оны тек осы маусымда киюге мүмкіндігіміз бар ысырап.
Dialogue: 0,0:14:36.47,0:14:38.47,Default,,0,0,0,,Цумики ше?
Dialogue: 0,0:14:40.64,0:14:43.31,Default,,0,0,0,,Бұл ең кіші өлшем
Dialogue: 0,0:14:43.31,0:14:47.15,Default,,0,0,0,,Өте сүйкімді Цумики Цун
Dialogue: 0,0:14:47.15,0:14:49.15,Default,,0,0,0,,Менің ойымша, бұл сізге сәйкес келеді.
Dialogue: 0,0:14:49.15,0:14:51.99,Default,,0,0,0,,Бұл Пуи сияқты
Dialogue: 0,0:14:51.99,0:14:54.49,Default,,0,0,0,,Ими-кун да саған керемет көрінеді.
Dialogue: 0,0:14:54.49,0:14:56.49,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:56.49,0:15:01.10,Default,,0,0,0,,Бұл дұрыс емес. Оның Аяз ата болғаны сонша, оны көрген адам шошып кетеді.
Dialogue: 0,0:15:02.26,0:15:06.60,Default,,0,0,0,,Аяз ата сізге қандай қызықты сыйлық береді?
Dialogue: 0,0:15:06.60,0:15:09.60,Default,,0,0,0,,Жүрегіңді елжірететін сыйлық емес пе?
Dialogue: 0,0:15:09.60,0:15:11.77,Default,,0,0,0,,Dokimune...
Dialogue: 0,0:15:11.77,0:15:14.94,Default,,0,0,0,,Жақсы қыз болсаң, Көңіліңді көтерерсің
Dialogue: 0,0:15:14.94,0:15:16.94,Default,,0,0,0,,сияқты нәрсе бар ма?
Dialogue: 0,0:15:18.45,0:15:20.95,Default,,0,0,0,,Қызықты! ? О, құдайым
Dialogue: 0,0:15:32.63,0:15:35.96,Default,,0,0,0,,Дайындық қалай? Кішкене ғана
Dialogue: 0,0:15:35.96,0:15:37.97,Default,,0,0,0,,Цумики Майои
Dialogue: 0,0:15:37.97,0:15:40.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:42.47,0:15:44.47,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:15:44.47,0:15:46.81,Default,,0,0,0,,Бір рет қолданылатын жылытқыштар?
Dialogue: 0,0:15:46.81,0:15:50.14,Default,,0,0,0,,Көшеде ұзақ тұрсаңыз, тоңып қаласыз, сондықтан оны қолданған дұрыс.
Dialogue: 0,0:15:50.14,0:15:53.31,Default,,0,0,0,,Кён Мейіріммен жылытыңыз
Dialogue: 0,0:15:53.31,0:15:55.32,Default,,0,0,0,,Жылы
Dialogue: 0,0:15:56.32,0:15:59.32,Default,,0,0,0,,Екеуіңіз де тоңып қалмағаныңызға көз жеткізіңіз...
Dialogue: 0,0:15:59.32,0:16:02.26,Default,,0,0,0,,Бақшада ыстық көрінеді.
Dialogue: 0,0:16:02.26,0:16:05.76,Default,,0,0,0,,Цумики-сан Ими-санға жылу соққысы бар екенін айтады.
Dialogue: 0,0:16:05.76,0:16:09.26,Default,,0,0,0,,Түсіндім, ыстық соққы...
Dialogue: 0,0:16:09.26,0:16:13.27,Default,,0,0,0,,Mayoi: «Ыстық соққыны» бөлек айтыңыз!
Dialogue: 0,0:16:13.27,0:16:15.27,Default,,0,0,0,,Няхо
Dialogue: 0,0:16:15.27,0:16:18.77,Default,,0,0,0,,Ал, Цумики мырза, Ими мырза.
Dialogue: 0,0:16:21.61,0:16:25.45,Default,,0,0,0,,Мияу! (Ханшайым) Поцелу келе жатыр!
Dialogue: 0,0:16:25.45,0:16:27.45,Default,,0,0,0,,Поцелу...
Dialogue: 0,0:16:30.79,0:16:33.96,Default,,0,0,0,,Жарайды, менің ойымша, үш қабатты қабаттастырған дұрыс.
Dialogue: 0,0:16:33.96,0:16:35.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:35.96,0:16:37.96,Default,,0,0,0,,3-ші дан жақсы, солай ма?
Dialogue: 0,0:16:37.96,0:16:40.46,Default,,0,0,0,,Мен оны сатқан сайын толықтырамын деп ойлаймын.
Dialogue: 0,0:16:40.46,0:16:42.46,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:16:42.46,0:16:44.80,Default,,0,0,0,,Оларды бір қатарға қойғанда, көп нәрсені көруге болады.
Dialogue: 0,0:16:44.80,0:16:48.80,Default,,0,0,0,,Сол Цумики-сан... мен оның қалпағын ғана көріп тұрмын.
Dialogue: 0,0:16:48.80,0:16:50.81,Default,,0,0,0,,Сіз қалай батылсыз
Dialogue: 0,0:16:52.14,0:16:54.48,Default,,0,0,0,,Олай болса, дүкенді ашатын кез келді.
Dialogue: 0,0:16:54.48,0:16:56.48,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.48,0:16:58.78,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:17:02.58,0:17:05.49,Default,,0,0,0,,Олай болса, ынтамен сатайық.
Dialogue: 0,0:17:08.76,0:17:13.93,Default,,0,0,0,,Қош келдіңіз, Рождествоны неге бал тортымен өткізбеске?
Dialogue: 0,0:17:13.93,0:17:16.43,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:16.43,0:17:18.93,Default,,0,0,0,,Торт ше?
Dialogue: 0,0:17:18.93,0:17:21.27,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:21.27,0:17:23.60,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:23.60,0:17:25.77,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:17:25.77,0:17:28.28,Default,,0,0,0,,Екі, рахмет.
Dialogue: 0,0:17:29.28,0:17:31.28,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:32.45,0:17:34.45,Default,,0,0,0,,Кюн
Dialogue: 0,0:17:34.45,0:17:38.12,Default,,0,0,0,,Цумики мырзаның өз жұмысына деген ынта-жігері сонша, оның ынта-ықыласы мұрнынан өтеді.
Dialogue: 0,0:17:38.12,0:17:42.29,Default,,0,0,0,,Аа, көп уайымдаудың қажеті жоқ.
Dialogue: 0,0:17:42.29,0:17:44.63,Default,,0,0,0,,Бұл дұрыс емес... ⚟(Саки) О ➡
Dialogue: 0,0:17:44.63,0:17:47.80,Default,,0,0,0,,Онива-сан және басқалары да осында толық емес жұмыс күнін бастады ма?
Dialogue: 0,0:17:47.80,0:17:49.80,Default,,0,0,0,,Көңілді (Майои) Көңілді➡
Dialogue: 0,0:17:49.80,0:17:51.97,Default,,0,0,0,,Бұл бүгінгі күннің уақытша ғана.
Dialogue: 0,0:17:51.97,0:17:55.47,Default,,0,0,0,,Қош келдіңіз, Сакимори мырза және басқалар, сіз Хачипочиде шай алғыңыз келе ме?
Dialogue: 0,0:17:55.47,0:17:57.81,Default,,0,0,0,,Иә, торт жейміз.
Dialogue: 0,0:17:57.81,0:18:01.58,Default,,0,0,0,,Ох~ Хачипочидің Рождестволық ерекше торты
Dialogue: 0,0:18:01.58,0:18:04.25,Default,,0,0,0,,Мұрыннан қызыл нәрсе шығады. Бұл дәмді.
Dialogue: 0,0:18:04.25,0:18:07.25,Default,,0,0,0,,Бұл шығады! ? Қызық, онда не бар?
Dialogue: 0,0:18:07.25,0:18:09.45,Default,,0,0,0,,Бұл махаббат па?
Dialogue: 0,0:18:12.25,0:18:15.59,Default,,0,0,0,,Мен Рождестволық торт сатып алуым керек деп ойлаймын.
Dialogue: 0,0:18:15.59,0:18:18.93,Default,,0,0,0,,Мен де сатып аламын, маған бал торты ұнайды
Dialogue: 0,0:18:18.93,0:18:21.60,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:21.60,0:18:24.43,Default,,0,0,0,,Бірақ сіз дүкенге торт жеуге келмедіңіз бе?
Dialogue: 0,0:18:24.43,0:18:26.43,Default,,0,0,0,,Бұл алып кетуге арналған.
Dialogue: 0,0:18:26.43,0:18:30.61,Default,,0,0,0,,Сонымен, біздің отбасылық қызметіміз арқылы сатып алғандар үшін.
Dialogue: 0,0:18:30.61,0:18:34.11,Default,,0,0,0,,Санта Ими сіздің басыңызды сипады!
Dialogue: 0,0:18:34.11,0:18:37.28,Default,,0,0,0,,Сізге бұл қажет емес. Мен мұны сатып алдым.
Dialogue: 0,0:18:37.28,0:18:42.48,Default,,0,0,0,,Өтінемін, ә...
Dialogue: 0,0:18:44.79,0:18:46.99,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:48.29,0:18:50.29,Default,,0,0,0,,Мен қосымша торт әкелдім.
Dialogue: 0,0:18:50.29,0:18:52.63,Default,,0,0,0,,Бұл бүгінгі соңғысы.
Dialogue: 0,0:18:52.63,0:18:54.63,Default,,0,0,0,,О
Dialogue: 0,0:18:54.63,0:18:59.63,Default,,0,0,0,,Дүкендегі торттар таусылып қалған сияқты, менің ойымша, ханшайым да осында келе алады.
Dialogue: 0,0:18:59.63,0:19:03.74,Default,,0,0,0,,Ол жақсы сатылуда, сондықтан ол оған дейін аяқталуы мүмкін.
Dialogue: 0,0:19:03.74,0:19:06.91,Default,,0,0,0,,Иә, бірақ әйел тұтынушылар көп.
Dialogue: 0,0:19:06.91,0:19:09.58,Default,,0,0,0,,Бәрінің де жігіттері бар ғой, солай ма?
Dialogue: 0,0:19:09.58,0:19:11.58,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:19:11.58,0:19:13.58,Default,,0,0,0,,Міне, мен сенімдімін➡
Dialogue: 0,0:19:13.58,0:19:16.25,Default,,0,0,0,,Торт менің сүйіктім
Dialogue: 0,0:19:16.25,0:19:19.42,Default,,0,0,0,,Рождествода бұл сөйлемге тыйым салынады.
Dialogue: 0,0:19:19.42,0:19:22.26,Default,,0,0,0,,Уау, көп нәрсе қалмады.
Dialogue: 0,0:19:22.26,0:19:26.76,Default,,0,0,0,,Иә, кеш өткен сайын тұтынушылардың саны арта түсті.
Dialogue: 0,0:19:26.76,0:19:30.60,Default,,0,0,0,,Сіз Рождествоға торт сатып аласыз, солай ма?
Dialogue: 0,0:19:30.60,0:19:32.60,Default,,0,0,0,,Әсіресе қыздар
Dialogue: 0,0:19:32.60,0:19:35.27,Default,,0,0,0,,Мен тортты жақсы көремін ғой... Әрі қарай жүрме.
Dialogue: 0,0:19:35.27,0:19:39.11,Default,,0,0,0,,Жалғасы? Жоқ, Сакаки жай ғана...
Dialogue: 0,0:19:39.11,0:19:41.61,Default,,0,0,0,,Менің сүйіктім...
Dialogue: 0,0:19:44.95,0:19:47.95,Default,,0,0,0,,《Ей, бұл сыйлық》
Dialogue: 0,0:19:47.95,0:19:49.95,Default,,0,0,0,,《(Бала) Рахмет, Аяз ата》
Dialogue: 0,0:19:49.95,0:19:51.95,Default,,0,0,0,,Аяз ата
Dialogue: 0,0:19:51.95,0:19:54.12,Default,,0,0,0,,《(Ана) Тоқтатыңызшы, Аяз атаның HP күші нөлге тең》
Dialogue: 0,0:19:54.12,0:19:56.12,Default,,0,0,0,,Олай етпе!
Dialogue: 0,0:19:56.12,0:19:58.83,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:20:00.80,0:20:03.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:09.30,0:20:11.31,Default,,0,0,0,,Бүгінгі күн үшін рахмет➡
Dialogue: 0,0:20:11.31,0:20:14.81,Default,,0,0,0,,Мен барлығына торт қалдыруды қадағаладым.
Dialogue: 0,0:20:14.81,0:20:16.81,Default,,0,0,0,,Уау, мен жасадым!
Dialogue: 0,0:20:16.81,0:20:18.81,Default,,0,0,0,,Торт…
Dialogue: 0,0:20:18.81,0:20:20.82,Default,,0,0,0,,Калорияға алаңдамай тамақтаныңыз
Dialogue: 0,0:20:33.99,0:20:36.33,Default,,0,0,0,,Баршаңызға жақсы жұмыс
Dialogue: 0,0:20:36.33,0:20:38.83,Default,,0,0,0,,Еңбегің үшін рахмет.Еңбегің үшін рахмет.
Dialogue: 0,0:20:38.83,0:20:40.84,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:20:40.84,0:20:44.17,Default,,0,0,0,,Ертеңгі Рождестволық кешті ұмытпа
Dialogue: 0,0:20:44.17,0:20:46.67,Default,,0,0,0,,Иә, Цумики-сан.
Dialogue: 0,0:20:46.67,0:20:50.18,Default,,0,0,0,,Сіз кенеттен келе алмасаңыз да, бәрібір.
Dialogue: 0,0:20:50.18,0:20:53.85,Default,,0,0,0,,Сондықтан Ими-сан мен...
Dialogue: 0,0:20:53.85,0:20:57.85,Default,,0,0,0,,Егер сіз уақытты жақсы өткізгіңіз келсе, оны еркін өткізіңіз.
Dialogue: 0,0:20:59.69,0:21:03.59,Default,,0,0,0,,Гухья! (Сакаки) Майой Жаңа жыл құтты болсын!
Dialogue: 0,0:21:16.97,0:21:20.27,Default,,0,0,0,,Осылай барлығымен толық емес жұмыс істеу жақсы.
Dialogue: 0,0:21:24.98,0:21:27.31,Default,,0,0,0,,Мен де...
Dialogue: 0,0:21:27.31,0:21:30.52,Default,,0,0,0,,Екеуміз бірге болғанда мен бақыттымын
Dialogue: 0,0:21:40.66,0:21:42.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:50.50,0:21:54.31,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:21:59.68,0:22:03.45,Default,,0,0,0,,Кеш ертең, сондықтан мен ұшамын.
Dialogue: 0,0:22:03.45,0:22:06.12,Default,,0,0,0,,Бұл ақ Рождество
Dialogue: 0,0:22:06.12,0:22:08.79,Default,,0,0,0,,(құбырды ашу)
Dialogue: 0,0:22:08.79,0:22:11.63,Default,,0,0,0,,Бұл әркімге құпия.
Dialogue: 0,0:22:11.63,0:22:14.03,Default,,0,0,0,,Иә
Dialogue: 0,0:22:16.96,0:22:19.57,Default,,0,0,0,,Сол әйел қалдырып кеткен тамақ… міне, сол ғой, иә?
Dialogue: 0,0:22:21.30,0:23:48.32,Default,,0,0,0,,♬～
Dialogue: 0,0:23:57.16,0:23:59.83,Default,,0,0,0,,Химе-чан, сен ненің суретін салып жатырсың?
Dialogue: 0,0:23:59.83,0:24:01.94,Default,,0,0,0,,Иго Тенте
Dialogue: 0,0:24:01.94,0:24:04.61,Default,,0,0,0,,Уау, өте жақсы!
Dialogue: 0,0:24:04.61,0:24:06.94,Default,,0,0,0,,Бұл керемет Химе Чан
Dialogue: 0,0:24:06.94,0:24:08.94,Default,,0,0,0,,Эхен
Dialogue: 0,0:24:15.45,0:24:17.45,Default,,0,0,0,,Ах, о...
Dialogue: 0,0:24:18.95,0:24:24.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
