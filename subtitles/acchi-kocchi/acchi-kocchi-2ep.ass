Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.50,0:00:08.50,Default,,0,0,0,,(есікті ашу)
Dialogue: 0,0:00:08.50,0:00:11.01,Default,,0,0,0,,⚟(Сакаки) Мен үйдемін~ Миико апа
Dialogue: 0,0:00:11.01,0:00:14.01,Default,,0,0,0,,⚟ (үшін) Сәлем~
Dialogue: 0,0:00:15.01,0:01:43.33,Default,,0,0,0,,♬～
Dialogue: 0,0:02:01.98,0:02:04.49,Default,,0,0,0,,⚟(ханшайым) Мен кенет ашуландым.
Dialogue: 0,0:02:04.49,0:02:07.49,Default,,0,0,0,,Партизан жаңбырының мәні осы.
Dialogue: 0,0:02:07.49,0:02:09.49,Default,,0,0,0,,Қазір қыс
Dialogue: 0,0:02:09.49,0:02:11.99,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:02:11.99,0:02:16.00,Default,,0,0,0,,Мен бүгін толық емес жұмыс күнім болды, бірақ сен келдің.
Dialogue: 0,0:02:16.00,0:02:20.67,Default,,0,0,0,,Аа, жоқ, мен торттың прототипін бақылауды асыға күтемін.
Dialogue: 0,0:02:20.67,0:02:22.67,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:02:22.67,0:02:25.01,Default,,0,0,0,,Дәмді торттар үшін
Dialogue: 0,0:02:25.01,0:02:27.51,Default,,0,0,0,,Отта немесе суда болса да
Dialogue: 0,0:02:27.51,0:02:30.01,Default,,0,0,0,,Ал мен жеген торт
Dialogue: 0,0:02:30.01,0:02:32.51,Default,,0,0,0,,Ауыздың ішінен асқазанның ішкі жағына ~
Dialogue: 0,0:02:32.51,0:02:36.02,Default,,0,0,0,,Соңында висцеральды майдан қорқу
Dialogue: 0,0:02:36.02,0:02:38.02,Default,,0,0,0,,Гах!
Dialogue: 0,0:02:38.02,0:02:40.62,Default,,0,0,0,,Бұл қандай ырғақ?
Dialogue: 0,0:02:45.03,0:02:48.03,Default,,0,0,0,,⚟Әркім, киімдеріңді ауыстырыңдар➡
Dialogue: 0,0:02:48.03,0:02:51.03,Default,,0,0,0,,Осылай қалсаң, суық тиіп қаласың.
Dialogue: 0,0:02:51.03,0:02:54.04,Default,,0,0,0,,Сосын мен дүкен формасын киемін.
Dialogue: 0,0:02:54.04,0:02:56.54,Default,,0,0,0,,Сонда мен де солай істеймін.
Dialogue: 0,0:02:56.54,0:02:58.54,Default,,0,0,0,,Ах, бірақ Цумики және басқалары...
Dialogue: 0,0:02:58.54,0:03:00.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.48,0:03:02.48,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:03:02.48,0:03:05.31,Default,,0,0,0,,Уфун Ахан
Dialogue: 0,0:03:05.31,0:03:08.98,Default,,0,0,0,,Ммф (барлығы) О!
Dialogue: 0,0:03:08.98,0:03:10.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.49,0:03:18.29,Default,,0,0,0,,Қара, қара, Цумики-сан, сен де бір шешімге кел.
Dialogue: 0,0:03:21.00,0:03:24.30,Default,,0,0,0,,Паа~!
Dialogue: 0,0:03:25.33,0:03:29.84,Default,,0,0,0,,О, екеуің бірге жақсы көрінесіңдер.
Dialogue: 0,0:03:29.84,0:03:32.51,Default,,0,0,0,,Мен мұны жасағаныма қуаныштымын.
Dialogue: 0,0:03:32.51,0:03:35.84,Default,,0,0,0,,〈(Сакаки/Иго) Сізді өзіне тартып алғысы келеді〉
Dialogue: 0,0:03:35.84,0:03:39.01,Default,,0,0,0,,Қалай ойлайсың, Ими, мені құшақтайсың ба?
Dialogue: 0,0:03:39.01,0:03:42.32,Default,,0,0,0,,Иә, бұл сізге өте жақсы сәйкес келетініне сенімдімін.
Dialogue: 0,0:03:43.85,0:03:47.52,Default,,0,0,0,,Жоқ, мен Ониваны құшақтап алғым келеді.
Dialogue: 0,0:03:47.52,0:03:50.36,Default,,0,0,0,,Цумики жағдайында бұл құшақтау➡
Dialogue: 0,0:03:50.36,0:03:53.03,Default,,0,0,0,,Құшақтап құшақтау
Dialogue: 0,0:03:53.03,0:03:56.03,Default,,0,0,0,,Мен түсінемін, мен алаңдаймын.
Dialogue: 0,0:03:56.03,0:03:58.03,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.03,0:04:00.97,Default,,0,0,0,,Бүгін түсініктеме бермейсіз бе?
Dialogue: 0,0:04:00.97,0:04:05.14,Default,,0,0,0,,Дүкенге қиындық тудыратын заттар
Dialogue: 0,0:04:05.14,0:04:07.98,Default,,0,0,0,,Бірдеңе жетіспейтін сияқты, Майой.
Dialogue: 0,0:04:07.98,0:04:10.48,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:04:10.48,0:04:13.48,Default,,0,0,0,,Түсіндім, сен Онива сені ұрғысы келді.
Dialogue: 0,0:04:13.48,0:04:15.48,Default,,0,0,0,,Иә, жоқ, бұл дұрыс емес.
Dialogue: 0,0:04:15.48,0:04:19.49,Default,,0,0,0,,Ешқандай реакция болмады, мен сәл ғана жалғыз қалдым.
Dialogue: 0,0:04:19.49,0:04:21.99,Default,,0,0,0,,Ал, бері қарай! Жарыл енді!
Dialogue: 0,0:04:21.99,0:04:25.16,Default,,0,0,0,,Бұл түсініспеушілікті тоқтатыңыз~!
Dialogue: 0,0:04:25.16,0:04:27.66,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:04:27.66,0:04:31.67,Default,,0,0,0,,Толық емес жұмыс күнімен жұмыс істегіңіз келсе, маған кез келген уақытта хабарлаңыз.
Dialogue: 0,0:04:31.67,0:04:33.67,Default,,0,0,0,,Мен тұтынушыларға қызмет көрсетемін...
Dialogue: 0,0:04:33.67,0:04:36.00,Default,,0,0,0,,Сен не сұрап тұрсың, Миико-сан?
Dialogue: 0,0:04:36.00,0:04:38.01,Default,,0,0,0,,Әй, хехехе
Dialogue: 0,0:04:38.01,0:04:41.51,Default,,0,0,0,,Ал, Онива көп күлмейді.
Dialogue: 0,0:04:41.51,0:04:44.01,Default,,0,0,0,,Цумики-сан, жарайды.
Dialogue: 0,0:04:44.01,0:04:49.02,Default,,0,0,0,,Клиенттерге қызмет көрсетудің мысалы ретінде Мииконың кіші інісі Сакакиді қарастырайық.
Dialogue: 0,0:04:52.52,0:04:55.02,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:56.53,0:04:58.53,Default,,0,0,0,,ішінен жарылды
Dialogue: 0,0:04:58.53,0:05:01.46,Default,,0,0,0,,Кешіріңіз Сакаки, мен не істеп жатырмын?
Dialogue: 0,0:05:01.46,0:05:04.97,Default,,0,0,0,,Күткендей, Игоның соққылары ішінен келеді.
Dialogue: 0,0:05:04.97,0:05:10.64,Default,,0,0,0,,Бұл Ими-санның жаман көрінгені сонша, ол оны тікелей цуккомимен өлтірді дегенді білдірмейді.
Dialogue: 0,0:05:10.64,0:05:13.98,Default,,0,0,0,,Бұл жаман мысал.
Dialogue: 0,0:05:13.98,0:05:17.48,Default,,0,0,0,,Мәжбүрлеп күлудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:05:17.48,0:05:21.98,Default,,0,0,0,,Сондықтан Мииконың тұтынушыларға қызмет көрсету күлкісінен ләззат алыңыз.
Dialogue: 0,0:05:25.99,0:05:28.49,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:28.49,0:05:32.49,Default,,0,0,0,,Бұл өте жарық Өйткені, мен тұтынушыларға қызмет көрсете алмаймын
Dialogue: 0,0:05:32.49,0:05:35.00,Default,,0,0,0,,Менің де қолымнан мұндай керемет күлімсіреу мүмкін емес.
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:05:43.00,0:05:48.01,Default,,0,0,0,,үшінның бірдей форма кигенінде біртүрлі нәрсе бар.
Dialogue: 0,0:05:48.01,0:05:51.01,Default,,0,0,0,,Иә, торт әлі сол жерде.
Dialogue: 0,0:05:51.01,0:05:53.52,Default,,0,0,0,,Адамдардың айтқанын тыңдау
Dialogue: 0,0:05:53.52,0:05:58.02,Default,,0,0,0,,Сонымен, Сакаки-санға көмектесу керек пе?
Dialogue: 0,0:05:58.02,0:06:00.96,Default,,0,0,0,,Жақсы, өйткені Иго саған көмектесіп жатыр.
Dialogue: 0,0:06:00.96,0:06:03.96,Default,,0,0,0,,Сіз де үлгересіз бе, Ими мырза?
Dialogue: 0,0:06:03.96,0:06:07.56,Default,,0,0,0,,Кейде мен де, Иго да жасаймыз.
Dialogue: 0,0:06:08.96,0:06:12.57,Default,,0,0,0,,Мен Миико-нимен бәсекеге түсе алмаймын.
Dialogue: 0,0:06:13.64,0:06:15.64,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:06:15.64,0:06:18.64,Default,,0,0,0,,Бүгін менде тек Миико-нидің торты бар.
Dialogue: 0,0:06:18.64,0:06:24.15,Default,,0,0,0,,Бұл түсінбеушілік емес.
Dialogue: 0,0:06:24.15,0:06:26.98,Default,,0,0,0,,Сакаки, ​​сен де көмектесе аласың.
Dialogue: 0,0:06:26.98,0:06:29.65,Default,,0,0,0,,Менсіз жақсы боласыз, солай ма?
Dialogue: 0,0:06:29.65,0:06:32.05,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:06:33.99,0:06:37.66,Default,,0,0,0,,Қызметші, күліңіз.
Dialogue: 0,0:06:37.66,0:06:41.16,Default,,0,0,0,,Айтпақшы, біздің дүкен күлімсіреу үшін ақы алады.
Dialogue: 0,0:06:41.16,0:06:43.67,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:43.67,0:06:47.50,Default,,0,0,0,,Бұл қанша тұрады?
Dialogue: 0,0:06:47.50,0:06:50.67,Default,,0,0,0,,Жоқ, мен оны алдым.
Dialogue: 0,0:06:50.67,0:06:54.68,Default,,0,0,0,,Баға – тұтынушымен кездесу
Dialogue: 0,0:06:54.68,0:06:56.68,Default,,0,0,0,,Кездесу!
Dialogue: 0,0:06:56.68,0:07:00.28,Default,,0,0,0,,Осылай десең, жүрегім қарнымның алдында...
Dialogue: 0,0:07:00.28,0:07:04.95,Default,,0,0,0,,Кейбір адамдар жағдайды көтере алмай, топ-топ болып шықты.
Dialogue: 0,0:07:04.95,0:07:08.96,Default,,0,0,0,,Қарқынымды жоғалтып, төгіліп кеткендей болдым.
Dialogue: 0,0:07:08.96,0:07:12.46,Default,,0,0,0,,Жоқ, Ими, сен оны стақаннан төгіп алдың.
Dialogue: 0,0:07:12.46,0:07:14.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:14.96,0:07:17.63,Default,,0,0,0,,Тағы қосамыз ба?
Dialogue: 0,0:07:17.63,0:07:19.63,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:07:19.63,0:07:22.64,Default,,0,0,0,,Бұл жеткілікті~
Dialogue: 0,0:07:24.97,0:07:28.48,Default,,0,0,0,,⚟(Майои) Ими-сан ше? Дәл сіз сияқты➡
Dialogue: 0,0:07:28.48,0:07:32.98,Default,,0,0,0,,Егер сіз кассада тұрсаңыз, сіз бармен сияқты боласыз.
Dialogue: 0,0:07:34.32,0:07:38.65,Default,,0,0,0,,Шейкерді алып, шайқасаңыз, қателесуіңіз мүмкін.
Dialogue: 0,0:07:38.65,0:07:41.99,Default,,0,0,0,,Шебер
Dialogue: 0,0:07:41.99,0:07:45.66,Default,,0,0,0,,Бұрандалы қада жетекі
Dialogue: 0,0:07:45.66,0:07:49.50,Default,,0,0,0,,Жоқ, Имикун, қызға олай етпе.
Dialogue: 0,0:07:49.50,0:07:52.33,Default,,0,0,0,,Жоқ, алмаймын.
Dialogue: 0,0:07:52.33,0:07:55.00,Default,,0,0,0,,Бұл қандай коктейль?
Dialogue: 0,0:07:55.00,0:07:58.51,Default,,0,0,0,,А, жоқ, бұл орыс балуанының кәсіпқой күрестегі қимылы.
Dialogue: 0,0:07:58.51,0:08:00.94,Default,,0,0,0,,Коктейль – бұрағыш
Dialogue: 0,0:08:00.94,0:08:03.28,Default,,0,0,0,,Я~
Dialogue: 0,0:08:03.28,0:08:06.45,Default,,0,0,0,,Шебер
Dialogue: 0,0:08:06.45,0:08:08.45,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:08:08.45,0:08:11.62,Default,,0,0,0,,Штопор соққысы
Dialogue: 0,0:08:11.62,0:08:14.62,Default,,0,0,0,,Неліктен жекпе-жек түріне жатады?
Dialogue: 0,0:08:16.96,0:08:19.96,Default,,0,0,0,,⚟Күткеніңізге рахмет
Dialogue: 0,0:08:19.96,0:08:21.96,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:21.96,0:08:24.97,Default,,0,0,0,,Уау, бұл тамаша.
Dialogue: 0,0:08:26.47,0:08:28.47,Default,,0,0,0,,Тортта қандай құлпынай бар?
Dialogue: 0,0:08:28.47,0:08:30.97,Default,,0,0,0,,Неге екені белгісіз, бұл өте дәмді.
Dialogue: 0,0:08:30.97,0:08:35.98,Default,,0,0,0,,Түсіндім, бұл жай ғана құлпынай жегендегіден мүлде басқаша сезінеді.
Dialogue: 0,0:08:35.98,0:08:40.48,Default,,0,0,0,,Адамдарды өзіне тартатын сиқырлы күштің арқасында ежелден бәсекелестік...
Dialogue: 0,0:08:40.48,0:08:42.48,Default,,0,0,0,,Қайғылы тарих.
Dialogue: 0,0:08:42.48,0:08:45.82,Default,,0,0,0,,Адам санына жетпегенде қиын.
Dialogue: 0,0:08:45.82,0:08:49.32,Default,,0,0,0,,Мен оны әдетте біреуге беретін шығармын.
Dialogue: 0,0:08:49.32,0:08:51.49,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:08:51.49,0:08:53.50,Default,,0,0,0,,Менен «неге?» деп сұрасаңыз да.
Dialogue: 0,0:08:53.50,0:08:56.00,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,0:08:56.00,0:08:58.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:59.93,0:09:02.44,Default,,0,0,0,,⚟(Майои) Маған ұнамайды, тоқтат, көмектесші➡
Dialogue: 0,0:09:02.44,0:09:05.94,Default,,0,0,0,,Жоқ, жоқ, жоқ➡
Dialogue: 0,0:09:05.94,0:09:09.78,Default,,0,0,0,,Мен бұл өшпенділіктен арылуым керек пе?
Dialogue: 0,0:09:09.78,0:09:11.78,Default,,0,0,0,,Тамақ жеу қиын.
Dialogue: 0,0:09:11.78,0:09:15.45,Default,,0,0,0,,Бұл жеуге тым сүйкімді.
Dialogue: 0,0:09:15.45,0:09:19.45,Default,,0,0,0,,Жоқ, мен тартынамын, өйткені ол сүйкімді.
Dialogue: 0,0:09:19.45,0:09:22.56,Default,,0,0,0,,О, менің...
Dialogue: 0,0:09:25.96,0:09:31.63,Default,,0,0,0,,О, мен осындай дәмді тортты жей алатыныма өте қуаныштымын.
Dialogue: 0,0:09:31.63,0:09:34.97,Default,,0,0,0,,Торт сататын дүкен тәттілер үйіне ұқсайды.
Dialogue: 0,0:09:34.97,0:09:36.97,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:36.97,0:09:41.31,Default,,0,0,0,,Қыздар кішкентай кезінде кәмпит үйінде тұрғылары келеді дейді.
Dialogue: 0,0:09:41.31,0:09:44.48,Default,,0,0,0,,⚟(ханшайым) Мен саған әлі де сүйсінемін~
Dialogue: 0,0:09:44.48,0:09:46.98,Default,,0,0,0,,⚟(Майои) Бақытты мияу~
Dialogue: 0,0:09:46.98,0:09:49.48,Default,,0,0,0,,Хааа~
Dialogue: 0,0:09:49.48,0:09:54.32,Default,,0,0,0,,Егер сіз тәттілерді жақсы көретін бала болсаңыз, бұл сізге кем дегенде бір рет қажет нәрсе.
Dialogue: 0,0:09:54.32,0:09:56.99,Default,,0,0,0,,Мен тәттіден гөрі етті ұнатамын.
Dialogue: 0,0:09:56.99,0:09:59.66,Default,,0,0,0,,Басқаша айтқанда, Сақаки...
Dialogue: 0,0:09:59.66,0:10:04.07,Default,,0,0,0,,Мен ет үйінде тұрғым келеді
Dialogue: 0,0:10:05.00,0:10:08.34,Default,,0,0,0,,Мен онда тұрғым келмейді! О, құдайым
Dialogue: 0,0:10:08.34,0:10:10.51,Default,,0,0,0,,Олай болса, пісіру керек пе?
Dialogue: 0,0:10:10.51,0:10:14.01,Default,,0,0,0,,⚟(Сакаки) А, онда... Жоқ, мен ол жерде тұрғым келмейді!
Dialogue: 0,0:10:14.01,0:10:16.51,Default,,0,0,0,,⚟Бұл майлы, солай емес пе?
Dialogue: 0,0:10:16.51,0:10:20.32,Default,,0,0,0,,Жаңбыр басылды.
Dialogue: 0,0:10:23.02,0:10:25.85,Default,,0,0,0,,⚟ Бүгінгі торт қалай болды?
Dialogue: 0,0:10:25.85,0:10:31.53,Default,,0,0,0,,Маған Монблан азырақ тәтті ұнайды.
Dialogue: 0,0:10:31.53,0:10:34.03,Default,,0,0,0,,Маған бұл өте ұнайды.
Dialogue: 0,0:10:34.03,0:10:36.53,Default,,0,0,0,,Қара шайға қосылатын тәтті ме деп ойлаймын.
Dialogue: 0,0:10:36.53,0:10:40.03,Default,,0,0,0,,Торттың тәттілігін теңестіру қиын.
Dialogue: 0,0:10:40.03,0:10:44.71,Default,,0,0,0,,Қабылданатын тәттілік сусын түріне байланысты өзгереді.
Dialogue: 0,0:10:44.71,0:10:47.04,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:10:47.04,0:10:50.21,Default,,0,0,0,,Айтпақшы, бүгін нені тәтті сезіндіңіз?
Dialogue: 0,0:10:50.21,0:10:53.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:54.05,0:10:56.05,Default,,0,0,0,,Көру Иә?
Dialogue: 0,0:10:59.55,0:11:01.86,Default,,0,0,0,,Торт сұрау
Dialogue: 0,0:11:08.50,0:11:12.00,Default,,0,0,0,,Ертең қыз мерекесі➡
Dialogue: 0,0:11:12.00,0:11:15.00,Default,,0,0,0,,Әулие Валентин күні Цумики-сан
Dialogue: 0,0:11:15.00,0:11:17.01,Default,,0,0,0,,Айо
Dialogue: 0,0:11:17.01,0:11:19.01,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:11:19.01,0:11:21.01,Default,,0,0,0,,Шоколад па?
Dialogue: 0,0:11:21.01,0:11:23.01,Default,,0,0,0,,Ня Мотой
Dialogue: 0,0:11:23.01,0:11:27.02,Default,,0,0,0,,Дайынсың ба? Бұл не?
Dialogue: 0,0:11:27.02,0:11:30.02,Default,,0,0,0,,Әрине мен саған шоколад беруге дайынмын.
Dialogue: 0,0:11:30.02,0:11:34.52,Default,,0,0,0,,Жартылай сезім болса, басқа адамға жете алмайсың!
Dialogue: 0,0:11:37.03,0:11:41.53,Default,,0,0,0,,Мәселе қандай таспаны дайындауда.
Dialogue: 0,0:11:41.53,0:11:44.03,Default,,0,0,0,,Шоколадтың орнына таспа ма?
Dialogue: 0,0:11:44.03,0:11:46.70,Default,,0,0,0,,Маған онша мағынасы жоқ.
Dialogue: 0,0:11:46.70,0:11:50.04,Default,,0,0,0,,Көптеген сүйкімді орауыш таспалар бар.
Dialogue: 0,0:11:50.04,0:11:56.04,Default,,0,0,0,,Бұл тым кішкентай.
Dialogue: 0,0:11:57.05,0:12:00.98,Default,,0,0,0,,Цумики не дайындайды➡
Dialogue: 0,0:12:00.98,0:12:04.99,Default,,0,0,0,,Бұл ұят, бірақ...
Dialogue: 0,0:12:05.99,0:12:08.99,Default,,0,0,0,,«Менің сыйлығым – Ва Та Ши» лентасы.
Dialogue: 0,0:12:08.99,0:12:10.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:11.99,0:12:14.50,Default,,0,0,0,,Барлық әзілдер бір шетке
Dialogue: 0,0:12:14.50,0:12:18.00,Default,,0,0,0,,Бұл әзіл болды ма? Сендіңіз бе?
Dialogue: 0,0:12:18.00,0:12:20.50,Default,,0,0,0,,Енді басты тақырып➡
Dialogue: 0,0:12:20.50,0:12:25.51,Default,,0,0,0,,Негізі мен Цумики-санға «Холе» дәрісін дайындадым.
Dialogue: 0,0:12:25.51,0:12:29.01,Default,,0,0,0,,Бұл шын ба? Бұл тым күдікті
Dialogue: 0,0:12:29.01,0:12:31.51,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:12:31.51,0:12:36.02,Default,,0,0,0,,Бірақ адамдардың сезімін сипаттау үшін мұндай нәрселерді пайдалану дұрыс емес деп ойлаймын.
Dialogue: 0,0:12:36.02,0:12:40.52,Default,,0,0,0,,Егер бұл сөзсіз болса немесе оған көмектесу мүмкін болмаса...
Dialogue: 0,0:12:40.52,0:12:45.53,Default,,0,0,0,,Цумики-сан, егер сіз Поку Ненжиннің Ими-саны болсаңыз да, мұны қолдансаңыз...
Dialogue: 0,0:12:47.53,0:12:50.53,Default,,0,0,0,,Ақырында, адам сияқты! ?
Dialogue: 0,0:12:50.53,0:12:53.33,Default,,0,0,0,,Жақсы... мүмкін
Dialogue: 0,0:12:55.54,0:12:58.71,Default,,0,0,0,,Сіз қазір шоколад ингредиенттерін сатып алғыңыз келе ме?
Dialogue: 0,0:12:58.71,0:13:01.98,Default,,0,0,0,,Дұрыс. Ханшайым мен Майой не істейді?
Dialogue: 0,0:13:01.98,0:13:06.98,Default,,0,0,0,,Мен мұны істеймін, мен оны маған қамқорлық жасағандардың бәріне беруді ойлап жүрмін.
Dialogue: 0,0:13:06.98,0:13:11.99,Default,,0,0,0,,Мен де, өйткені мен Хачипочи дәм тату шарасында көп нәрсені білдім.
Dialogue: 0,0:13:11.99,0:13:14.99,Default,,0,0,0,,Онда менімен барғың келе ме? иә
Dialogue: 0,0:13:14.99,0:13:19.83,Default,,0,0,0,,Мен сатып алуды ұмытып кеткен бір ингредиент бар.
Dialogue: 0,0:13:19.83,0:13:23.50,Default,,0,0,0,,Цумики қандай шоколад жасайды?
Dialogue: 0,0:13:23.50,0:13:26.00,Default,,0,0,0,,Шоколадты мусс мүмкін
Dialogue: 0,0:13:26.00,0:13:29.00,Default,,0,0,0,,Ой, сен торт жасап жатырсың.
Dialogue: 0,0:13:29.00,0:13:33.51,Default,,0,0,0,,Шоколадты ұнатпайтын Ими мырзаға неліктен торт жасауға барар едіңіз?
Dialogue: 0,0:13:33.51,0:13:37.51,Default,,0,0,0,,Шоколадты ұнатпайтын Имикун, сен қызсың ғой?
Dialogue: 0,0:13:37.51,0:13:40.01,Default,,0,0,0,,Мен кездейсоқ естідім.
Dialogue: 0,0:13:40.01,0:13:44.52,Default,,0,0,0,,Шоколадты тәттілерге қарсы емеспін, бірақ шоколадты өз бетімше ұнатпаймын.
Dialogue: 0,0:13:44.52,0:13:47.02,Default,,0,0,0,,⚟(Майо ханшайымы) Ху~
Dialogue: 0,0:13:47.02,0:13:49.32,Default,,0,0,0,,Ayo
Dialogue: 0,0:13:54.53,0:13:58.53,Default,,0,0,0,,Шоколад пен балғын кілегей сатылып кете жаздады.
Dialogue: 0,0:13:58.53,0:14:00.97,Default,,0,0,0,,Иә, бұл қауіпті болды.
Dialogue: 0,0:14:00.97,0:14:04.47,Default,,0,0,0,,Айтпақшы, Майой ше? Мен материалды сатып алған жоқпын
Dialogue: 0,0:14:04.47,0:14:07.98,Default,,0,0,0,,Дұрыс, мен кейде бірдеңе сатып алуды ұмытып кетемін.
Dialogue: 0,0:14:07.98,0:14:10.48,Default,,0,0,0,,Оларды сату үшін табу қиын.
Dialogue: 0,0:14:10.48,0:14:12.98,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:14:12.98,0:14:17.65,Default,,0,0,0,,Әрине, оны әдеттегідей жасау қызықсыз болар еді, сондықтан мен тосын шоколад жасадым.
Dialogue: 0,0:14:17.65,0:14:19.99,Default,,0,0,0,,Оған не қою керек?
Dialogue: 0,0:14:19.99,0:14:21.99,Default,,0,0,0,,Алкоголь жоқ
Dialogue: 0,0:14:21.99,0:14:25.66,Default,,0,0,0,,Мм, бақа?
Dialogue: 0,0:14:25.66,0:14:28.00,Default,,0,0,0,,Неліктен бақа?
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0,0,0,,Бұл жай ғана тосын сый, жәй ғана қудалау.
Dialogue: 0,0:14:31.00,0:14:34.50,Default,,0,0,0,,Жоқ, жоқ, бақа етінің құрылымы тауық етіне ұқсас.
Dialogue: 0,0:14:34.50,0:14:38.67,Default,,0,0,0,,Бұл жаман емес. Эй, сен оны жеп көрдің бе?
Dialogue: 0,0:14:38.67,0:14:41.51,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:14:41.51,0:14:44.01,Default,,0,0,0,,Тіпті тауық еті мен шоколад бірге келмейді.
Dialogue: 0,0:14:44.01,0:14:46.01,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:14:46.01,0:14:48.52,Default,,0,0,0,,Енді үйге ертерек барып дайындалуым керек.
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0,0,0,,⚟(ханшайым) Дұрыс, тездету керек.
Dialogue: 0,0:14:51.02,0:14:53.52,Default,,0,0,0,,⚟(Майои) Мен оны тағы іздеймін.
Dialogue: 0,0:14:53.52,0:14:56.32,Default,,0,0,0,,⚟(ханшайым) Өтінемін, біртүрлі заттар сатып алмаңыз.
Dialogue: 0,0:15:08.30,0:15:10.47,Default,,0,0,0,,Ihi➡
Dialogue: 0,0:15:10.47,0:15:13.98,Default,,0,0,0,,Ихихихихии Ихихихихихи
Dialogue: 0,0:15:23.82,0:15:26.52,Default,,0,0,0,,Дайын
Dialogue: 0,0:15:34.50,0:15:36.50,Default,,0,0,0,,Осы тапаншаны пайдаланып—
Dialogue: 0,0:15:36.50,0:15:39.50,Default,,0,0,0,,〈Кездейсоқ〉
Dialogue: 0,0:15:39.50,0:15:43.50,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:15:48.01,0:15:50.01,Default,,0,0,0,,Қайырлы таң Цумики
Dialogue: 0,0:15:50.01,0:15:52.01,Default,,0,0,0,,Бүгін тағы да салқын.
Dialogue: 0,0:15:52.01,0:15:55.32,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:15:57.85,0:16:01.12,Default,,0,0,0,,〈Кездейсоқ〉
Dialogue: 0,0:16:01.12,0:16:03.62,Default,,0,0,0,,<Casually>
Dialogue: 0,0:16:03.62,0:16:07.63,Default,,0,0,0,,Жақсы, жақсы...
Dialogue: 0,0:16:07.63,0:16:11.30,Default,,0,0,0,,Иә? Мұнда…
Dialogue: 0,0:16:11.30,0:16:14.00,Default,,0,0,0,,Мынау, мынау, а...
Dialogue: 0,0:16:17.97,0:16:21.81,Default,,0,0,0,,Қайырлы таң, Цумики-сан, Иноми-сан...
Dialogue: 0,0:16:21.81,0:16:25.51,Default,,0,0,0,,Ими-кун құлап қалды (Майои) Жерде не болып жатыр?
Dialogue: 0,0:16:27.48,0:16:29.98,Default,,0,0,0,,Сіз маған шоколад бермек болдыңыз.
Dialogue: 0,0:16:29.98,0:16:32.99,Default,,0,0,0,,Осы процесте неліктен дене соққысын алдым?
Dialogue: 0,0:16:32.99,0:16:34.99,Default,,0,0,0,,Мен оны естігім келеді
Dialogue: 0,0:16:34.99,0:16:37.99,Default,,0,0,0,,бақытсыз оқиға
Dialogue: 0,0:16:37.99,0:16:40.50,Default,,0,0,0,,Қалай болғанда да, Цумики шоколады үшін рахмет
Dialogue: 0,0:16:40.50,0:16:42.50,Default,,0,0,0,,Иә
Dialogue: 0,0:16:42.50,0:16:47.00,Default,,0,0,0,,Ими мырза, Цумики мырзадан шоколад алған кезде қандай сезімде болдыңыз?
Dialogue: 0,0:16:47.00,0:16:49.34,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:49.34,0:16:52.84,Default,,0,0,0,,Бір соққы мені шыдамдылық шегіне жеткізді.
Dialogue: 0,0:16:52.84,0:16:56.04,Default,,0,0,0,,Бұл шоколад емес, бұл соққыдан алған әсерім.
Dialogue: 0,0:16:58.51,0:17:01.45,Default,,0,0,0,,Ими~ Сіз сондасыз ба?
Dialogue: 0,0:17:01.45,0:17:04.45,Default,,0,0,0,,Қайырлы таң, Сакаки-сан.
Dialogue: 0,0:17:04.45,0:17:07.96,Default,,0,0,0,,Сәлем, бұл шоколад.
Dialogue: 0,0:17:07.96,0:17:11.79,Default,,0,0,0,,Миикодан келген Хачипочи қорабы?
Dialogue: 0,0:17:11.79,0:17:15.96,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл мен екенімді шешіп қойған.
Dialogue: 0,0:17:15.96,0:17:18.97,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:18.97,0:17:21.80,Default,,0,0,0,,Та-да!
Dialogue: 0,0:17:21.80,0:17:23.97,Default,,0,0,0,,Торт 1 тесік
Dialogue: 0,0:17:23.97,0:17:25.97,Default,,0,0,0,,Коммерциялық өнімге ұқсайды.
Dialogue: 0,0:17:25.97,0:17:28.48,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:28.48,0:17:30.98,Default,,0,0,0,,Менің ата-анамның үйі күткендей торт дүкені.
Dialogue: 0,0:17:30.98,0:17:32.98,Default,,0,0,0,,Бәріміз бірге тамақтанайық
Dialogue: 0,0:17:32.98,0:17:35.48,Default,,0,0,0,,Мұны басынан бастап айту керек.
Dialogue: 0,0:17:35.48,0:17:38.99,Default,,0,0,0,,Айтпақшы, Миико-ни де Имиге торт жасап берді.
Dialogue: 0,0:17:38.99,0:17:40.99,Default,,0,0,0,,Солай ма? Иә?
Dialogue: 0,0:17:40.99,0:17:42.99,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:17:42.99,0:17:46.33,Default,,0,0,0,,⚟(Майои/Ханшайым) Уфхх
Dialogue: 0,0:17:46.33,0:17:48.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:48.33,0:17:51.33,Default,,0,0,0,,Эй Ими-сан Сакаки-сан
Dialogue: 0,0:17:51.33,0:17:54.00,Default,,0,0,0,,Менен, же, же.
Dialogue: 0,0:17:54.00,0:17:56.00,Default,,0,0,0,,Майойдың қолдан жасағаны?
Dialogue: 0,0:17:56.00,0:17:58.51,Default,,0,0,0,,Маған бере аласыз ба? рахмет
Dialogue: 0,0:17:58.51,0:18:02.44,Default,,0,0,0,,Айтпақшы, бұл тосын шоколад.
Dialogue: 0,0:18:02.44,0:18:06.45,Default,,0,0,0,,Ештеңеден күдіктенбей аузыма салғаныма енді өкінемін.
Dialogue: 0,0:18:06.45,0:18:09.28,Default,,0,0,0,,Қандай кездейсоқтық, мен де.
Dialogue: 0,0:18:09.28,0:18:12.29,Default,,0,0,0,,Құрамында құпия ингредиент ретінде бақа еті бар
Dialogue: 0,0:18:12.29,0:18:14.29,Default,,0,0,0,,Кішкене
Dialogue: 0,0:18:14.29,0:18:18.46,Default,,0,0,0,,⚟(Сакаки) Боо~ Сіз оны шынымен салып қойғансыз.
Dialogue: 0,0:18:18.46,0:18:21.96,Default,,0,0,0,,⚟(Майои) Таңқаларлық табыс, таң қалуың керек~
Dialogue: 0,0:18:21.96,0:18:24.47,Default,,0,0,0,,⚟(Сакаки) Кез келген адам таң қалар еді!
Dialogue: 0,0:18:24.47,0:18:26.80,Default,,0,0,0,,Ими, жақсысың ба?
Dialogue: 0,0:18:26.80,0:18:30.47,Default,,0,0,0,,Мен Валентин бақа жейді деп ойламаппын.
Dialogue: 0,0:18:30.47,0:18:32.47,Default,,0,0,0,,Қалыпты Мен олай ойламаймын
Dialogue: 0,0:18:32.47,0:18:35.98,Default,,0,0,0,,Бірақ дәмді болды, солай ма? Сіз дәмін көре аласыз ба?
Dialogue: 0,0:18:35.98,0:18:37.98,Default,,0,0,0,,Сіз оны дұрыс жасадыңыз.
Dialogue: 0,0:18:37.98,0:18:42.48,Default,,0,0,0,,Бақа етін табу үшін көп күш қажет...
Dialogue: 0,0:18:43.99,0:18:45.99,Default,,0,0,0,,Хо…
Dialogue: 0,0:18:45.99,0:18:48.99,Default,,0,0,0,,Ақ күнді есте сақтаңыз!
Dialogue: 0,0:18:48.99,0:18:50.99,Default,,0,0,0,,Тосын қайтару
Dialogue: 0,0:18:50.99,0:18:54.60,Default,,0,0,0,,Мен зефирге шошқаның аяғын саламын!
Dialogue: 0,0:18:56.16,0:19:00.43,Default,,0,0,0,,Бұл жиіркенішті. Қызға бұлай жасау жиіркенішті.
Dialogue: 0,0:19:00.43,0:19:05.44,Default,,0,0,0,,Не! ? Шоколадты бақаны жазықсыз балаға беру ең жаманы.
Dialogue: 0,0:19:05.44,0:19:08.44,Default,,0,0,0,,Жазықсыз бала шошқаның аяғын таңдамас еді.
Dialogue: 0,0:19:08.44,0:19:12.45,Default,,0,0,0,,Сіз оны зефирмен жабудың кінәсіздігін сезінесіз.
Dialogue: 0,0:19:12.45,0:19:14.95,Default,,0,0,0,,Оны бөлшектеудің қажеті жоқ.
Dialogue: 0,0:19:14.95,0:19:18.12,Default,,0,0,0,,Зефир – жарты мейірімділік.
Dialogue: 0,0:19:18.12,0:19:21.96,Default,,0,0,0,,Ал, мен де сендерге дайындап қойдым.
Dialogue: 0,0:19:21.96,0:19:24.63,Default,,0,0,0,,Сіз оны ала аласыз ба?
Dialogue: 0,0:19:24.63,0:19:27.80,Default,,0,0,0,,Бұл анық. Жүрек тәрізді ме?
Dialogue: 0,0:19:27.80,0:19:30.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:30.30,0:19:34.30,Default,,0,0,0,,Егер ханшайымға бірдеңе берсең, ол қате түсінетін шығар.
Dialogue: 0,0:19:34.30,0:19:37.47,Default,,0,0,0,,Жүрек пішінді, білемін, білемін.
Dialogue: 0,0:19:37.47,0:19:40.81,Default,,0,0,0,,Парыз болса да ер балаға бермеген дұрыс шығар.
Dialogue: 0,0:19:40.81,0:19:44.31,Default,,0,0,0,,Тіпті мен, әйел болсам да, қате түсінетін сияқтымын.
Dialogue: 0,0:19:44.31,0:19:46.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:46.31,0:19:48.48,Default,,0,0,0,,Одан әріге бармаңыз.
Dialogue: 0,0:19:48.48,0:19:50.99,Default,,0,0,0,,Ханшайым, жарайды, мен байсалды емеспін.
Dialogue: 0,0:19:50.99,0:19:52.99,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:19:52.99,0:19:55.49,Default,,0,0,0,,Дәлірек айтқанда, олардың бәрі сүйікті ме?
Dialogue: 0,0:19:55.49,0:19:59.49,Default,,0,0,0,,Жоқ, бұл менің сүйікті емес...
Dialogue: 0,0:19:59.49,0:20:03.50,Default,,0,0,0,,Бұл дұрыс емес пе? Мен мұны білдім.
Dialogue: 0,0:20:12.01,0:20:15.01,Default,,0,0,0,,...Яғни,
Dialogue: 0,0:20:15.01,0:20:18.18,Default,,0,0,0,,Ханшайым, сабыр ет.
Dialogue: 0,0:20:18.18,0:20:21.08,Default,,0,0,0,,Бұл негізгі ой. (үшін) Бұл не?
Dialogue: 0,0:20:26.02,0:20:29.52,Default,,0,0,0,,⚟(Сақаки) Бүгін не істейміз? Не айтқың келеді?
Dialogue: 0,0:20:29.52,0:20:33.03,Default,,0,0,0,,Бұл ойын орталығы. Бүгін біз жеңеміз.
Dialogue: 0,0:20:33.03,0:20:36.03,Default,,0,0,0,,Оны қабылдап, орнымыздан тұрайық.
Dialogue: 0,0:20:36.03,0:20:38.70,Default,,0,0,0,,Цумики-сан
Dialogue: 0,0:20:38.70,0:20:40.70,Default,,0,0,0,,Не?
Dialogue: 0,0:20:43.04,0:20:45.87,Default,,0,0,0,,Шындығында, иә?
Dialogue: 0,0:20:45.87,0:20:50.21,Default,,0,0,0,,Цумики-сан үшін мен Пак Ненжиннің Ими-санға қарсы шаралары туралы ойладым.
Dialogue: 0,0:20:50.21,0:20:52.55,Default,,0,0,0,,Мен саған шоколад бердім.
Dialogue: 0,0:20:52.55,0:20:57.38,Default,,0,0,0,,Ал, тыңда, тыңда, жұрттың айтқанын тыңда.
Dialogue: 0,0:20:57.38,0:20:59.72,Default,,0,0,0,,Тесік дәрісі жақсы емес.
Dialogue: 0,0:20:59.72,0:21:01.99,Default,,0,0,0,,Ал, тыңда, тыңда➡
Dialogue: 0,0:21:01.99,0:21:03.99,Default,,0,0,0,,Біріншіден…
Dialogue: 0,0:21:03.99,0:21:05.99,Default,,0,0,0,,Не?
Dialogue: 0,0:21:05.99,0:21:10.50,Default,,0,0,0,,Мен шоколадты ерніме осылай сілкіп отырдым...
Dialogue: 0,0:21:10.50,0:21:13.00,Default,,0,0,0,,Қашан?
Dialogue: 0,0:21:15.00,0:21:17.84,Default,,0,0,0,,《Жесің》
Dialogue: 0,0:21:17.84,0:21:20.84,Default,,0,0,0,,Бұл ең жақсы бөлік!
Dialogue: 0,0:21:20.84,0:21:22.84,Default,,0,0,0,,Қазір
Dialogue: 0,0:21:22.84,0:21:25.01,Default,,0,0,0,,Ал, Цумики-сан
Dialogue: 0,0:21:25.01,0:21:27.01,Default,,0,0,0,,Жүр!
Dialogue: 0,0:21:31.02,0:21:34.52,Default,,0,0,0,,Қара, Ими-сан, қыздарды ұятқа қалдырма.
Dialogue: 0,0:21:34.52,0:21:37.36,Default,,0,0,0,,Мен келісемін, сіз джентльмен сияқты әрекет етуіңіз керек.
Dialogue: 0,0:21:37.36,0:21:39.36,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:21:48.20,0:21:50.70,Default,,0,0,0,,Ол жұмсақ және өте тәтті көрінеді.
Dialogue: 0,0:21:50.70,0:21:52.71,Default,,0,0,0,,Цумики
Dialogue: 0,0:21:58.05,0:21:59.98,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:21:59.98,0:22:01.98,Default,,0,0,0,,Қорқынышты Ими-сан
Dialogue: 0,0:22:05.65,0:22:08.99,Default,,0,0,0,,Цумики, жақсысың ба?
Dialogue: 0,0:22:08.99,0:22:10.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:10.99,0:22:12.99,Default,,0,0,0,,Иә
Dialogue: 0,0:22:17.00,0:22:20.00,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:22:20.00,0:23:48.52,Default,,0,0,0,,♬～
Dialogue: 0,0:23:55.36,0:23:59.53,Default,,0,0,0,,Ими-сенсэй, мен қазір қол-аяғымды қолдануға дайынмын.
Dialogue: 0,0:23:59.53,0:24:02.47,Default,,0,0,0,,Майои-чан жақсы жүр~
Dialogue: 0,0:24:02.47,0:24:04.47,Default,,0,0,0,,Мияу~
Dialogue: 0,0:24:04.47,0:24:08.64,Default,,0,0,0,,Хо-ха-чо-хо-хо-хо-хо-хо~
Dialogue: 0,0:24:08.64,0:24:13.98,Default,,0,0,0,,Ух~ Шабуыл~ Чоа~
Dialogue: 0,0:24:13.98,0:24:16.98,Default,,0,0,0,,Тоу О
Dialogue: 0,0:24:18.48,0:24:24.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
