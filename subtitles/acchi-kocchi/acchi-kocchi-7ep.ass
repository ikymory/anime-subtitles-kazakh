Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.32,0:01:37.62,Default,,0,0,0,,Мияу
Dialogue: 0,0:01:42.31,0:01:46.35,Default,,0,0,0,,≪(ханшайым) Бірге саяхаттау әрине қызықты.
Dialogue: 0,0:01:46.35,0:01:48.67,Default,,0,0,0,,Көп көңілді болыңыз
Dialogue: 0,0:01:48.67,0:01:53.32,Default,,0,0,0,,Енді үй тапсырмасы болмаса, болашағыма алаңдамай ойнайтын едім.
Dialogue: 0,0:01:53.32,0:01:57.83,Default,,0,0,0,,Бұл әлі шілде, сондықтан ойнаған кезде үй тапсырмасын ұмытыңыз.
Dialogue: 0,0:01:57.83,0:02:00.33,Default,,0,0,0,,Бұл жазғы демалыс еді...
Dialogue: 0,0:02:01.32,0:02:04.00,Default,,0,0,0,,Ауырған нәрселерден көзіңізді бұрып тұрсыз ба?
Dialogue: 0,0:02:04.00,0:02:05.99,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:02:05.99,0:02:09.01,Default,,0,0,0,,Жарайды, кейін дұрыстап жасаймын.
Dialogue: 0,0:02:09.01,0:02:12.31,Default,,0,0,0,,Айтпақшы, мен үй тапсырмасын орындадым...
Dialogue: 0,0:02:13.38,0:02:16.65,Default,,0,0,0,,...
Dialogue: 0,0:02:16.65,0:02:18.65,Default,,0,0,0,,≪Күткеніңізге рахмет
Dialogue: 0,0:02:22.65,0:02:24.67,Default,,0,0,0,,Қайырлы таң Цумики
Dialogue: 0,0:02:24.67,0:02:27.99,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:02:27.99,0:02:30.76,Default,,0,0,0,,Дайындыққа аз уақыт кетті.
Dialogue: 0,0:02:30.76,0:02:33.65,Default,,0,0,0,,Бұл менің Ими-санмен бірінші сапарым.
Dialogue: 0,0:02:33.65,0:02:37.17,Default,,0,0,0,,Әртүрлі тәсілдермен дайындалу қиын болды ма? Цу~н
Dialogue: 0,0:02:37.17,0:02:39.32,Default,,0,0,0,,Әй, кеттік
Dialogue: 0,0:02:39.32,0:02:44.34,Default,,0,0,0,,Жүр, Цумики-сан, Химе-цчи, кеттік!
Dialogue: 0,0:02:44.34,0:03:44.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:30.01,0:05:32.99,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:05:32.99,0:05:35.68,Default,,0,0,0,,Терезе жанында отырғанды ​​ұнататын адам бар ма?
Dialogue: 0,0:05:35.68,0:05:37.68,Default,,0,0,0,,Химекчи оңай мас болып қалады
Dialogue: 0,0:05:37.68,0:05:39.67,Default,,0,0,0,,Терезенің жанында отыру жақсы емес пе?
Dialogue: 0,0:05:39.67,0:05:43.67,Default,,0,0,0,,Мен көліктерге соншалықты сезімтал емеспін, сондықтан бәрібір.
Dialogue: 0,0:05:43.67,0:05:46.34,Default,,0,0,0,,Бірақ мені таң қалдырды, мұрным...
Dialogue: 0,0:05:46.34,0:05:49.94,Default,,0,0,0,,Мен оны бермеймін. Сондай-ақ, күтпеген шабуыл дегеніміз не?
Dialogue: 0,0:05:51.01,0:05:54.31,Default,,0,0,0,,Тосын шабуыл дегеніміз не?
Dialogue: 0,0:05:55.68,0:05:57.69,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:57.69,0:05:59.69,Default,,0,0,0,,Ханшайым, терезенің жанына отырыңыз.
Dialogue: 0,0:05:59.69,0:06:01.69,Default,,0,0,0,,2 адам суға батып кетті
Dialogue: 0,0:06:03.34,0:06:06.68,Default,,0,0,0,,...Сақ болыңыз және ешқашан сақтықты төмендетпеңіз.
Dialogue: 0,0:06:06.68,0:06:08.66,Default,,0,0,0,,Техе
Dialogue: 0,0:06:08.66,0:06:11.66,Default,,0,0,0,,Онива Иноның қасында.
Dialogue: 0,0:06:12.73,0:06:15.50,Default,,0,0,0,,Жоқ, жоқ, жоқ (2 адам) Иә?
Dialogue: 0,0:06:15.50,0:06:18.67,Default,,0,0,0,,Өйткені, ол сіздің тізеңізде.
Dialogue: 0,0:06:18.67,0:06:21.01,Default,,0,0,0,,Няго ~ ызылдау
Dialogue: 0,0:06:21.01,0:06:23.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:35.01,0:06:38.61,Default,,0,0,0,,Күннің ашық болғанына қуаныштымын. Онда кездескенше.
Dialogue: 0,0:06:40.34,0:06:44.40,Default,,0,0,0,,Пойыздың дыбысы қыздарға ұнамайтын сияқты.
Dialogue: 0,0:06:44.40,0:06:46.43,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:06:46.43,0:06:49.00,Default,,0,0,0,,Бұл нені білдіреді? Иә?
Dialogue: 0,0:06:49.00,0:06:51.00,Default,,0,0,0,,Жоқ, қараңыз...
Dialogue: 0,0:06:56.34,0:06:58.94,Default,,0,0,0,,Ауыр естіледі.
Dialogue: 0,0:07:02.00,0:07:05.00,Default,,0,0,0,,Көздер! Қыздардың салмағы 5 тоннаға да жетпейді.
Dialogue: 0,0:07:05.00,0:07:08.01,Default,,0,0,0,,Кешіріңіз, бұл Пунпун.
Dialogue: 0,0:07:08.01,0:07:10.01,Default,,0,0,0,,Пиязды қайдан аласыз?
Dialogue: 0,0:07:10.01,0:07:12.01,Default,,0,0,0,,Дәлірек айтсақ, Сакаки жақсысың ба?
Dialogue: 0,0:07:17.33,0:07:20.68,Default,,0,0,0,,Енді пойыздарды ауыстырудың қажеті жоқ.
Dialogue: 0,0:07:20.68,0:07:23.67,Default,,0,0,0,,Ал, жеңіл жүрейік.
Dialogue: 0,0:07:23.67,0:07:27.74,Default,,0,0,0,,Бұл межелі жерге апаратын рельс.
Dialogue: 0,0:07:27.74,0:07:31.68,Default,,0,0,0,,Мен лицензия алған соң көлікпен келгім келеді.
Dialogue: 0,0:07:31.68,0:07:34.35,Default,,0,0,0,,Эй, Ими-сан, қайда барасың?
Dialogue: 0,0:07:34.35,0:07:36.33,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:07:36.33,0:07:39.34,Default,,0,0,0,,Олар бекітілген рельсті алып тастамақ.
Dialogue: 0,0:07:39.34,0:07:42.36,Default,,0,0,0,,Болашақ – ақ парақ А, эй, ә!
Dialogue: 0,0:07:42.36,0:07:45.36,Default,,0,0,0,,Анда-санда өзіңіз ойлап, әрекет етіңіз.
Dialogue: 0,0:07:45.36,0:07:47.96,Default,,0,0,0,,Маған сусын сатып ал.
Dialogue: 0,0:07:54.02,0:07:56.02,Default,,0,0,0,,Мен тәттілер сатып алдым.
Dialogue: 0,0:07:56.02,0:07:58.01,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:07:58.01,0:08:00.67,Default,,0,0,0,,Жақында кетеміз, ханшайым ше?
Dialogue: 0,0:08:00.67,0:08:02.68,Default,,0,0,0,,Мен жаңа ғана шықтым
Dialogue: 0,0:08:02.68,0:08:06.33,Default,,0,0,0,,Мен дүкенге бардым, әлі оралған жоқпын.
Dialogue: 0,0:08:06.33,0:08:08.33,Default,,0,0,0,,Ұялы телефон...
Dialogue: 0,0:08:10.02,0:08:12.35,Default,,0,0,0,,Сіз оны алып жүрмейсіз.
Dialogue: 0,0:08:12.35,0:08:14.67,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:08:14.67,0:08:16.67,Default,,0,0,0,,Бұл дәретхана болуы мүмкін.
Dialogue: 0,0:08:16.67,0:08:18.99,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:08:18.99,0:08:23.06,Default,,0,0,0,,Химекчи әр адамның жүрегінде.
Dialogue: 0,0:08:23.06,0:08:25.36,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:08:26.33,0:08:29.34,Default,,0,0,0,,Жүрегімде болсаң да, жоқсың.
Dialogue: 0,0:08:29.34,0:08:33.01,Default,,0,0,0,,Мен сирек кездесетін тәттілер сатып алдым.
Dialogue: 0,0:08:33.01,0:08:37.01,Default,,0,0,0,,Ах, ня~ Химе-ччи қайтып келді~
Dialogue: 0,0:08:40.38,0:08:42.67,Default,,0,0,0,,Онда емес пе?
Dialogue: 0,0:08:42.67,0:08:46.00,Default,,0,0,0,,Цумики, ханшайым қайтып келді
Dialogue: 0,0:08:46.00,0:08:48.02,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:08:48.02,0:08:50.62,Default,,0,0,0,,[Үндеткіш] есігі жабылады
Dialogue: 0,0:08:54.34,0:08:57.01,Default,,0,0,0,,Сақаки, жүр, кеттік.
Dialogue: 0,0:08:57.01,0:08:59.00,Default,,0,0,0,,Мен не істесем де...
Dialogue: 0,0:08:59.00,0:09:01.00,Default,,0,0,0,,Мен сенімен кейін кездесемін.
Dialogue: 0,0:09:02.67,0:09:04.67,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:09:12.35,0:09:15.35,Default,,0,0,0,,Ими, не...
Dialogue: 0,0:09:15.35,0:09:18.72,Default,,0,0,0,,Бәріміз бірге саяхатқа шықсақ та.
Dialogue: 0,0:09:18.72,0:09:23.01,Default,,0,0,0,,Мұндай жерде жалғыз қалу жалғыз болу керек.
Dialogue: 0,0:09:23.01,0:09:25.31,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:09:27.38,0:09:29.66,Default,,0,0,0,,Бірақ Цумики соңғы минутта ғана болды.
Dialogue: 0,0:09:29.66,0:09:31.67,Default,,0,0,0,,Сіз ханшайымды іздедіңіз ғой, солай ма?
Dialogue: 0,0:09:31.67,0:09:34.97,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:09:42.34,0:09:45.00,Default,,0,0,0,,Ханшайымдардың жағдайы жақсы ма?
Dialogue: 0,0:09:45.00,0:09:47.01,Default,,0,0,0,,Сакаки екінші жағында.
Dialogue: 0,0:09:47.01,0:09:50.02,Default,,0,0,0,,Жарайды, меніңше.
Dialogue: 0,0:09:50.02,0:09:52.67,Default,,0,0,0,,Мүмкін Ими қалған шығар?
Dialogue: 0,0:09:52.67,0:09:56.01,Default,,0,0,0,,Қыз жалғыз қалмас үшін.
Dialogue: 0,0:09:56.01,0:09:58.01,Default,,0,0,0,,Бар ма деп ойлаймын
Dialogue: 0,0:09:59.03,0:10:01.35,Default,,0,0,0,,Не?
Dialogue: 0,0:10:01.35,0:10:04.45,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:10:05.50,0:10:09.00,Default,,0,0,0,,Қайта айтудың өзі ұят.
Dialogue: 0,0:10:12.67,0:10:17.34,Default,,0,0,0,,Нуои Сакаки-сан, неге мені тоқтатпадың!
Dialogue: 0,0:10:17.34,0:10:21.84,Default,,0,0,0,,Жарайды, мен қызды жалғыз қалдыра алмаймын.
Dialogue: 0,0:10:22.85,0:10:25.85,Default,,0,0,0,,Жоқ, бірақ бұл қауіпті.
Dialogue: 0,0:10:25.85,0:10:28.84,Default,,0,0,0,,Ху~ Ими-кун да, Сакаки-сан да
Dialogue: 0,0:10:28.84,0:10:31.34,Default,,0,0,0,,Мен сенің мейірімді екеніңді білемін, бірақ
Dialogue: 0,0:10:31.34,0:10:34.36,Default,,0,0,0,,Сонымен Ими артта қалғанда,
Dialogue: 0,0:10:34.36,0:10:36.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:36.40,0:10:39.45,Default,,0,0,0,,Пешкаға салып, Ониваны терезеден өткізіңіз
Dialogue: 0,0:10:39.45,0:10:43.45,Default,,0,0,0,,≪(Майои) және жұмсақтық ≪(ханшайым) Бұл мейірімділік пе?
Dialogue: 0,0:10:49.66,0:10:51.68,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:10:51.68,0:10:54.00,Default,,0,0,0,,Имикун, жақсысың ба?
Dialogue: 0,0:10:54.00,0:10:56.60,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:10:58.00,0:11:00.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.00,0:11:03.37,Default,,0,0,0,,Мұны қайталама.
Dialogue: 0,0:11:03.37,0:11:05.41,Default,,0,0,0,,Иә
Dialogue: 0,0:11:05.41,0:11:07.44,Default,,0,0,0,,Мен не қарап тұрмын деп уайымдаймын.
Dialogue: 0,0:11:07.44,0:11:09.33,Default,,0,0,0,,Бірдеңе болатын сияқты болды.
Dialogue: 0,0:11:09.33,0:11:13.02,Default,,0,0,0,,Жарайды, мен мұны айтсам да, іштей қорқамын.
Dialogue: 0,0:11:13.02,0:11:16.00,Default,,0,0,0,,Сақаки мырзаның көңіл-күйі жақсы болды.
Dialogue: 0,0:11:16.00,0:11:19.37,Default,,0,0,0,,Құсқа айналып кете жаздадым.
Dialogue: 0,0:11:19.37,0:11:22.43,Default,,0,0,0,,Сол кезде мен сені Бива көліне жіберемін.
Dialogue: 0,0:11:22.43,0:11:24.43,Default,,0,0,0,,Құстар сайысы! ?
Dialogue: 0,0:11:30.35,0:11:33.02,Default,,0,0,0,,≪(Сакаки) тауы! ≪(Майои) Кя
Dialogue: 0,0:11:33.02,0:11:36.01,Default,,0,0,0,,≪(Сакаки) Бұл табиғи! ≪(ханшайым) Кя
Dialogue: 0,0:11:36.01,0:11:39.01,Default,,0,0,0,,≪(Сакаки) Бұл вилла! ≪(Майо ханшайымы) Кя
Dialogue: 0,0:11:39.01,0:11:42.95,Default,,0,0,0,,Және бұл Ими!
Dialogue: 0,0:11:42.95,0:11:44.95,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:48.84,0:11:50.84,Default,,0,0,0,,Уау
Dialogue: 0,0:11:50.84,0:11:52.84,Default,,0,0,0,,Суық
Dialogue: 0,0:11:52.84,0:11:54.86,Default,,0,0,0,,Жақсы сезінеді→
Dialogue: 0,0:11:54.86,0:11:56.86,Default,,0,0,0,,Химекчи Яй
Dialogue: 0,0:11:58.35,0:12:01.67,Default,,0,0,0,,≪(Сакаки) Жаз Су жағасында ойнаған қыздың дауысы→
Dialogue: 0,0:12:01.67,0:12:04.00,Default,,0,0,0,,Лорелай сияқты
Dialogue: 0,0:12:04.00,0:12:07.00,Default,,0,0,0,,Сол дауысқа еріп кетсең, батып кетесің.
Dialogue: 0,0:12:07.00,0:12:09.04,Default,,0,0,0,,Біз де суға батып алайық
Dialogue: 0,0:12:09.04,0:12:11.04,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:12:13.34,0:12:15.34,Default,,0,0,0,,≪(Майои) Қараңдар, қараңдар!
Dialogue: 0,0:12:16.35,0:12:18.72,Default,,0,0,0,,Бұл табиғи көпір.
Dialogue: 0,0:12:18.72,0:12:21.72,Default,,0,0,0,,Егер сіз тым көп көңіл көтерсеңіз, бұл қауіпті.
Dialogue: 0,0:12:25.34,0:12:27.36,Default,,0,0,0,,Ал... Майой-сан!
Dialogue: 0,0:12:27.36,0:12:29.36,Default,,0,0,0,,Майопокан
Dialogue: 0,0:12:31.43,0:12:34.68,Default,,0,0,0,,Сақаки-сан жем
Dialogue: 0,0:12:34.68,0:12:38.98,Default,,0,0,0,,А-а, иленген жем.
Dialogue: 0,0:12:46.34,0:12:48.76,Default,,0,0,0,,Майопочаның қайтып келуі
Dialogue: 0,0:12:48.76,0:12:50.68,Default,,0,0,0,,Цумики
Dialogue: 0,0:12:50.68,0:12:52.68,Default,,0,0,0,,Мен оны аулаймын.
Dialogue: 0,0:12:52.68,0:12:54.98,Default,,0,0,0,,Қалыпты түрде тартыңыз~
Dialogue: 0,0:12:57.67,0:12:59.67,Default,,0,0,0,,Мияу~
Dialogue: 0,0:13:00.67,0:13:03.34,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:03.34,0:13:06.70,Default,,0,0,0,,Цумики мені байланыстырады деп ешқашан ойламадым.
Dialogue: 0,0:13:06.70,0:13:08.70,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:13:23.33,0:13:25.33,Default,,0,0,0,,Igo
Dialogue: 0,0:13:35.01,0:13:38.35,Default,,0,0,0,,＜Бірдеңе, бірдеңе...＞
Dialogue: 0,0:13:38.35,0:13:41.40,Default,,0,0,0,,<Осы жерде құлап кететін сияқты>
Dialogue: 0,0:13:41.40,0:13:44.40,Default,,0,0,0,,<Осы жерде құлап кетсе>
Dialogue: 0,0:13:45.34,0:13:47.35,Default,,0,0,0,,<Иық және т.б.>
Dialogue: 0,0:13:47.35,0:13:49.65,Default,,0,0,0,,<Тізе тізе? ＞
Dialogue: 0,0:13:50.67,0:13:52.69,Default,,0,0,0,,<Тізені төмен түсіру>
Dialogue: 0,0:13:52.69,0:13:54.73,Default,,0,0,0,,<болу...>
Dialogue: 0,0:13:54.73,0:13:57.35,Default,,0,0,0,,<Осында, осында>
Dialogue: 0,0:13:57.35,0:13:59.35,Default,,0,0,0,,<Батарикко осында>
Dialogue: 0,0:14:00.67,0:14:03.27,Default,,0,0,0,,<Бұл шынымен де келді>
Dialogue: 0,0:14:05.01,0:14:07.02,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:14:07.02,0:14:09.06,Default,,0,0,0,,бөлек
Dialogue: 0,0:14:09.06,0:14:11.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:11.09,0:14:13.68,Default,,0,0,0,,Әй, ұйқылы... Ұйқың келсе.
Dialogue: 0,0:14:13.68,0:14:16.72,Default,,0,0,0,,Сіз оны маған қарызға бере аласыз.
Dialogue: 0,0:14:16.72,0:14:20.32,Default,,0,0,0,,Тізе
Dialogue: 0,0:14:21.34,0:14:23.34,Default,,0,0,0,,Ұйқы! ?
Dialogue: 0,0:14:26.01,0:14:28.01,Default,,0,0,0,,≪(ханшайым) Цумикисан
Dialogue: 0,0:14:28.01,0:14:31.00,Default,,0,0,0,,Менімен ойнағың келе ме?
Dialogue: 0,0:14:31.00,0:14:33.67,Default,,0,0,0,,А, Имикун, ұйықтап жатырсың ба?
Dialogue: 0,0:14:33.67,0:14:37.67,Default,,0,0,0,,Мен оны сәл баяу алып жатырмын хаха~
Dialogue: 0,0:14:37.67,0:14:40.27,Default,,0,0,0,,Міне Химекчи Уау
Dialogue: 0,0:14:43.34,0:14:45.64,Default,,0,0,0,,Міне, Сакаки-сан
Dialogue: 0,0:14:46.76,0:14:49.02,Default,,0,0,0,,≪(Сакаки) Басқа нәрсе жоқ па?
Dialogue: 0,0:14:49.02,0:14:51.62,Default,,0,0,0,,<Мен бортқа отырдым>
Dialogue: 0,0:14:52.69,0:14:55.29,Default,,0,0,0,,<Ұйқыдағы Кюн>
Dialogue: 0,0:15:00.08,0:15:02.11,Default,,0,0,0,,...
Dialogue: 0,0:15:02.11,0:15:04.01,Default,,0,0,0,,Лап жастығы instax
Dialogue: 0,0:15:04.01,0:15:06.61,Default,,0,0,0,,Жастар Чеки Яй
Dialogue: 0,0:15:08.69,0:15:10.99,Default,,0,0,0,,Мен оянамын
Dialogue: 0,0:16:21.48,0:16:23.49,Default,,0,0,0,,≪(Сакаки) Ет жейік~
Dialogue: 0,0:16:23.49,0:16:26.48,Default,,0,0,0,,≪(Майо) Барбекю барбекюі
Dialogue: 0,0:16:26.48,0:16:30.33,Default,,0,0,0,,Менің қарным ашты.Сен әлі дайынсың ба? әке
Dialogue: 0,0:16:30.33,0:16:32.33,Default,,0,0,0,,Иә, сәл көбірек
Dialogue: 0,0:16:33.32,0:16:35.31,Default,,0,0,0,,және әкем
Dialogue: 0,0:16:35.31,0:16:37.67,Default,,0,0,0,,Иноми менің әкем... Жетеді.
Dialogue: 0,0:16:37.67,0:16:39.71,Default,,0,0,0,,О~ О~
Dialogue: 0,0:16:39.71,0:16:42.33,Default,,0,0,0,,және әкем
Dialogue: 0,0:16:42.33,0:16:44.98,Default,,0,0,0,,Бұл не, ана?
Dialogue: 0,0:16:44.98,0:16:47.98,Default,,0,0,0,,Цумики-сан, не болды?
Dialogue: 0,0:16:49.65,0:16:51.99,Default,,0,0,0,,≪(ханшайым) Имикун, тамақ ішіп жатырсың ба?
Dialogue: 0,0:16:51.99,0:16:54.32,Default,,0,0,0,,Оның орнына пісірсем бе?
Dialogue: 0,0:16:54.32,0:16:57.66,Default,,0,0,0,,Иә, мен тамақтанып жатырмын. Уайымдамай тамақтаныңыз.
Dialogue: 0,0:16:57.66,0:16:59.66,Default,,0,0,0,,Бұл жерде өртеніп кетті.
Dialogue: 0,0:16:59.66,0:17:01.70,Default,,0,0,0,,Ими Иә?
Dialogue: 0,0:17:01.70,0:17:03.75,Default,,0,0,0,,Мияу
Dialogue: 0,0:17:03.75,0:17:07.65,Default,,0,0,0,,А, шашлықтар жеуге дайын.
Dialogue: 0,0:17:07.65,0:17:10.66,Default,,0,0,0,,Иго Нян
Dialogue: 0,0:17:10.66,0:17:12.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:12.64,0:17:14.64,Default,,0,0,0,,Фольга грильде де Imi
Dialogue: 0,0:17:14.64,0:17:17.33,Default,,0,0,0,,Мияу
Dialogue: 0,0:17:17.33,0:17:19.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:19.33,0:17:21.32,Default,,0,0,0,,Цумики-сан
Dialogue: 0,0:17:21.32,0:17:23.32,Default,,0,0,0,,Сіз тамақ ішіп жатырсыз ба?
Dialogue: 0,0:17:25.81,0:17:29.99,Default,,0,0,0,,Ет Ет Келесі орында ет
Dialogue: 0,0:17:29.99,0:17:32.00,Default,,0,0,0,,Ет
Dialogue: 0,0:17:32.00,0:17:34.36,Default,,0,0,0,,Дондон еті
Dialogue: 0,0:17:34.36,0:17:36.65,Default,,0,0,0,,Мен тек ет жеймін.
Dialogue: 0,0:17:36.65,0:17:39.65,Default,,0,0,0,,Көкөніс пен балықты дұрыс жеу.
Dialogue: 0,0:17:39.65,0:17:44.32,Default,,0,0,0,,Дұрыс, неше түрлі тағамдарды жемесең, тамақтануың теңгерімсіз болады.
Dialogue: 0,0:17:44.32,0:17:46.62,Default,,0,0,0,,Рычаг білдіреді
Dialogue: 0,0:17:48.98,0:17:51.75,Default,,0,0,0,,Бұл ырғақты ойып шығару туралы.
Dialogue: 0,0:17:51.75,0:17:54.75,Default,,0,0,0,,Түсіндім, ырғақ болса, мен
Dialogue: 0,0:17:58.99,0:18:00.97,Default,,0,0,0,,Барлық ет
Dialogue: 0,0:18:00.97,0:18:02.99,Default,,0,0,0,,Көкөністерді жеу
Dialogue: 0,0:18:02.99,0:18:05.98,Default,,0,0,0,,Тамақты ырғақпен жеп жатырсыз ба, Ими мырза?
Dialogue: 0,0:18:05.98,0:18:09.67,Default,,0,0,0,,Хмм, мен ырғаққа мән бермеймін.
Dialogue: 0,0:18:09.67,0:18:12.32,Default,,0,0,0,,Мүмкін мен арасында көкөністер болуы керек шығар.
Dialogue: 0,0:18:12.32,0:18:16.66,Default,,0,0,0,,Менің ырғағым әдетте «ет, ет, көкөніс».
Dialogue: 0,0:18:16.66,0:18:20.73,Default,,0,0,0,,Бәлкім, осылайша сіз одан шаршамайсыз және одан да дәмді жей аласыз.
Dialogue: 0,0:18:20.73,0:18:25.33,Default,,0,0,0,,Нарухо~ Цумикидің ырғағы солай емес пе?
Dialogue: 0,0:18:25.33,0:18:27.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:27.32,0:18:30.87,Default,,0,0,0,,Махаббат Махаббат Иноми-сан Мен сені сүйемін Чуу Чуу Чуу Чуу
Dialogue: 0,0:18:30.87,0:18:32.91,Default,,0,0,0,,Қандай ырғақ?
Dialogue: 0,0:18:32.91,0:18:34.91,Default,,0,0,0,,Шу сияқты
Dialogue: 0,0:18:37.66,0:18:40.01,Default,,0,0,0,,≪(Майои) Ах~ Толық қарын Толық қарын
Dialogue: 0,0:18:40.01,0:18:42.65,Default,,0,0,0,,Онда ештеңе қалмады.
Dialogue: 0,0:18:42.65,0:18:46.65,Default,,0,0,0,,Бұл ауырады. Мүмкін мен көп жеген шығармын.
Dialogue: 0,0:18:46.65,0:18:49.99,Default,,0,0,0,,Қанағат Менің ішім шығыңқы
Dialogue: 0,0:18:49.99,0:18:51.99,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:18:55.31,0:18:57.31,Default,,0,0,0,,(Ойын музыкасы ұялы телефоннан ойнап тұр)
Dialogue: 0,0:18:59.42,0:19:02.00,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:19:02.00,0:19:04.02,Default,,0,0,0,,Жоқ, ол қозғалмайды!
Dialogue: 0,0:19:04.02,0:19:06.31,Default,,0,0,0,,Бұл күлкілі әзіл
Dialogue: 0,0:19:06.31,0:19:08.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:08.31,0:19:10.31,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:19:12.66,0:19:17.32,Default,,0,0,0,,Саяхатта жүргенде әйелдер ванналарына көз жүгірте алатын оқиғалар жиі болады.
Dialogue: 0,0:19:17.32,0:19:19.64,Default,,0,0,0,,Бұл тағы да кенеттен.
Dialogue: 0,0:19:19.64,0:19:22.31,Default,,0,0,0,,Мақсат - көз жүгірту емес →
Dialogue: 0,0:19:22.31,0:19:26.31,Default,,0,0,0,,Менің ойымша, ең жақсысы - бұл процесте көңіл көтеру→
Dialogue: 0,0:19:26.31,0:19:28.31,Default,,0,0,0,,Көріністің бір түрі?
Dialogue: 0,0:19:28.31,0:19:32.00,Default,,0,0,0,,Егер солай болса, мен түсінбеймін.
Dialogue: 0,0:19:32.00,0:19:35.65,Default,,0,0,0,,Бірақ егер сіз қарап қалсаңыз не істейсіз?
Dialogue: 0,0:19:35.65,0:19:38.66,Default,,0,0,0,,Жүрек соғып тұрған шығар...
Dialogue: 0,0:19:38.66,0:19:40.66,Default,,0,0,0,,Чикушо
Dialogue: 0,0:19:40.66,0:19:42.66,Default,,0,0,0,,Бұл нәзік ыңғайсыздық
Dialogue: 0,0:19:42.66,0:19:44.66,Default,,0,0,0,,Біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:19:44.66,0:19:46.96,Default,,0,0,0,,Тыныш күтпе
Dialogue: 0,0:19:49.32,0:19:52.32,Default,,0,0,0,,Мен шомылдым.
Dialogue: 0,0:19:52.32,0:19:54.82,Default,,0,0,0,,Пижамалар Жақсы жұмыс!
Dialogue: 0,0:19:54.82,0:19:57.99,Default,,0,0,0,,Менің ойымша, екеуі бірге керемет көрінеді.
Dialogue: 0,0:19:57.99,0:20:01.36,Default,,0,0,0,,Рахмет Пуи
Dialogue: 0,0:20:01.36,0:20:03.40,Default,,0,0,0,,≪(Майои) Хехехехе
Dialogue: 0,0:20:03.40,0:20:07.33,Default,,0,0,0,,Менің жазғы келбетім туралы не ойлайсың?
Dialogue: 0,0:20:07.33,0:20:09.30,Default,,0,0,0,,Мэйо юката киіп жүр ме?
Dialogue: 0,0:20:09.30,0:20:12.32,Default,,0,0,0,,Қонақ үйге ұқсайды, мм.
Dialogue: 0,0:20:12.32,0:20:14.32,Default,,0,0,0,,Бұл шынымен юкатаға ұқсайды
Dialogue: 0,0:20:14.32,0:20:16.32,Default,,0,0,0,,Мияу Манмаджан
Dialogue: 0,0:20:18.31,0:20:20.33,Default,,0,0,0,,Юката туралы айтқанда, Цумики-сан→
Dialogue: 0,0:20:20.33,0:20:23.35,Default,,0,0,0,,Мынаны алыңыз, иә?
Dialogue: 0,0:20:23.35,0:20:25.89,Default,,0,0,0,,Айналып жатыр.
Dialogue: 0,0:20:25.89,0:20:28.66,Default,,0,0,0,,«Ах!» деп айтатын түрі.
Dialogue: 0,0:20:28.66,0:20:31.64,Default,,0,0,0,,мияулауды тартыңыз.
Dialogue: 0,0:20:31.64,0:20:33.64,Default,,0,0,0,,...
Dialogue: 0,0:20:36.98,0:20:39.98,Default,,0,0,0,,А-а-а... айналдыра қоймады.
Dialogue: 0,0:20:39.98,0:20:42.82,Default,,0,0,0,,Сіз әлі де «ах-ре» дейсіз бе?
Dialogue: 0,0:20:42.82,0:20:44.82,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:20:49.33,0:20:53.65,Default,,0,0,0,,Цумики-сан, шашыңды кептіру қиын сияқты.
Dialogue: 0,0:20:53.65,0:20:56.98,Default,,0,0,0,,Бұл сәл қиын болуы мүмкін...
Dialogue: 0,0:20:56.98,0:20:59.32,Default,,0,0,0,,Цумики
Dialogue: 0,0:20:59.32,0:21:02.32,Default,,0,0,0,,Мен шашыңды кептіремін.
Dialogue: 0,0:21:04.34,0:21:06.64,Default,,0,0,0,,Мен мұны өзім жасаймын.
Dialogue: 0,0:21:06.64,0:21:08.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:08.65,0:21:11.31,Default,,0,0,0,,Жарайды, Химе-цчи, неге маған мұны жасамайсың?
Dialogue: 0,0:21:11.31,0:21:13.32,Default,,0,0,0,,Иә? Мен бе?
Dialogue: 0,0:21:13.32,0:21:17.32,Default,,0,0,0,,Не істеу керек? Ал, онда...
Dialogue: 0,0:21:19.97,0:21:22.66,Default,,0,0,0,,Келуден тартынбаңыз
Dialogue: 0,0:21:22.66,0:21:25.66,Default,,0,0,0,,Бұл енді дұрыс емес. Мені қате түсінбеңіз...
Dialogue: 0,0:21:25.66,0:21:27.96,Default,,0,0,0,,Цумики-сан
Dialogue: 0,0:21:53.32,0:21:56.99,Default,,0,0,0,,≪(Сакаки) Ал, мен дайынмын, сондықтан оны орындау уақыты келді.
Dialogue: 0,0:21:56.99,0:21:59.33,Default,,0,0,0,,Мен үлкен жиынтық сатып алдым.
Dialogue: 0,0:21:59.33,0:22:01.98,Default,,0,0,0,,Тағы бірнеше раушан гүлдері бар.
Dialogue: 0,0:22:01.98,0:22:05.37,Default,,0,0,0,,Өйткені, жазғы демалыс түндеріне келсек, бұл отшашу.
Dialogue: 0,0:22:05.37,0:22:07.40,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:22:07.40,0:22:09.31,Default,,0,0,0,,Енді келесіге көшейік
Dialogue: 0,0:22:09.31,0:22:12.81,Default,,0,0,0,,Әй, қайсысын таңдасам екен деп уайымдап жүрмін.
Dialogue: 0,0:22:15.98,0:22:19.67,Default,,0,0,0,,Бұл әдемі, иә.
Dialogue: 0,0:22:19.67,0:22:21.99,Default,,0,0,0,,Жарайды, келесі.
Dialogue: 0,0:22:21.99,0:22:24.65,Default,,0,0,0,,Парашют Кеттік
Dialogue: 0,0:22:24.65,0:22:26.95,Default,,0,0,0,,О~ (2 адам) Түсіндік!
Dialogue: 0,0:22:29.31,0:22:32.98,Default,,0,0,0,,Дайын!
Dialogue: 0,0:22:32.98,0:22:34.98,Default,,0,0,0,,Қазір ерте
Dialogue: 0,0:22:42.99,0:22:45.99,Default,,0,0,0,,Бұл ауырады, о
Dialogue: 0,0:22:48.06,0:22:50.06,Default,,0,0,0,,Мен оны ала алдым.
Dialogue: 0,0:22:54.67,0:22:56.67,Default,,0,0,0,,Зымыран
Dialogue: 0,0:23:00.82,0:23:04.34,Default,,0,0,0,,Ахх, не?
Dialogue: 0,0:23:04.34,0:23:06.38,Default,,0,0,0,,Сіз мені өлтіргіңіз келе ме?
Dialogue: 0,0:23:06.38,0:23:09.88,Default,,0,0,0,,Мен оны тұтандырсам, ол әйтеуір саған қарай кетті.
Dialogue: 0,0:23:12.15,0:23:15.31,Default,,0,0,0,,Келесі жолы сол жерге ұшатыныңызға көз жеткізіңіз.
Dialogue: 0,0:23:15.31,0:23:17.31,Default,,0,0,0,,Хмм, ауаға
Dialogue: 0,0:23:20.83,0:23:22.83,Default,,0,0,0,,Ах~
Dialogue: 0,0:23:22.83,0:23:24.83,Default,,0,0,0,,А, не?
Dialogue: 0,0:23:27.32,0:23:29.99,Default,,0,0,0,,Өте үлкен зымыран қондырғысы
Dialogue: 0,0:23:29.99,0:23:31.97,Default,,0,0,0,,ұшырудан 5 секунд бұрын
Dialogue: 0,0:23:31.97,0:23:34.97,Default,,0,0,0,,４ ３ ２ １
Dialogue: 0,0:23:39.65,0:23:41.66,Default,,0,0,0,,Мен бұрылдым.
Dialogue: 0,0:23:41.66,0:23:43.66,Default,,0,0,0,,Қаш
Dialogue: 0,0:23:46.32,0:23:48.32,Default,,0,0,0,,Йомоя!
Dialogue: 0,0:23:56.66,0:23:58.67,Default,,0,0,0,,О!
Dialogue: 0,0:23:58.67,0:24:01.67,Default,,0,0,0,,Тақырып түсіндіруді қажет етпейді.
Dialogue: 0,0:24:02.65,0:24:05.64,Default,,0,0,0,,≪(Сакаки) Олай болса кеттік. ≪(Майои) Усу.
Dialogue: 0,0:24:05.64,0:24:07.66,Default,,0,0,0,,≪(барлығы)
Dialogue: 0,0:24:07.66,0:24:09.96,Default,,0,0,0,,Дайын
Dialogue: 0,0:24:12.33,0:24:14.31,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:24:14.31,0:24:17.32,Default,,0,0,0,,Менің ойыма осындай қайғылы ойын келді.
Dialogue: 0,0:24:17.32,0:24:19.32,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:24:19.32,0:24:21.82,Default,,0,0,0,,Бұл жылдам, ең жылдам болды.
Dialogue: 0,0:24:28.31,0:24:30.31,Default,,0,0,0,,Ими Иә?
Dialogue: 0,0:24:31.65,0:24:34.33,Default,,0,0,0,,Тағы бір жарысайық па?
Dialogue: 0,0:24:34.33,0:24:37.83,Default,,0,0,0,,Цумики-сан бірінші құласа, менде екі сезім де болады.
Dialogue: 0,0:24:38.82,0:24:41.82,Default,,0,0,0,,Цумики-сан бірінші құласа, менде екі сезім де болады.
Dialogue: 0,0:24:42.84,0:24:44.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:45.91,0:24:47.81,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:24:47.81,0:24:49.91,Default,,0,0,0,,≪(Цумики/Ими) Ханым
Dialogue: 0,0:24:57.32,0:24:59.31,Default,,0,0,0,,(отшашулар)
Dialogue: 0,0:24:59.31,0:25:01.98,Default,,0,0,0,,Уау →
Dialogue: 0,0:25:01.98,0:25:03.98,Default,,0,0,0,,Woohohohoho~
Dialogue: 0,0:25:08.65,0:25:13.01,Default,,0,0,0,,Отшашулар ұшқыр, бірақ әдемі болғаны сонша, жадында қалады.
Dialogue: 0,0:25:13.01,0:25:16.31,Default,,0,0,0,,Иә, гүлдеп, жайнайтын гүлдердің сұлулығы.
Dialogue: 0,0:25:16.31,0:25:18.33,Default,,0,0,0,,Джейн
Dialogue: 0,0:25:18.33,0:25:21.33,Default,,0,0,0,,Ими Отшашуды тамашалаған қыздар
Dialogue: 0,0:25:21.33,0:25:24.32,Default,,0,0,0,,Толқу отын жағу
Dialogue: 0,0:25:24.32,0:25:26.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:28.65,0:25:30.64,Default,,0,0,0,,Кездейсоқ сәттерде көрсету
Dialogue: 0,0:25:30.64,0:25:32.64,Default,,0,0,0,,Сенің күлкің жақсырақ
Dialogue: 0,0:25:32.64,0:25:34.64,Default,,0,0,0,,Отшашудан да әдемі
Dialogue: 0,0:25:34.64,0:25:36.94,Default,,0,0,0,,Жүрегімде қалады
Dialogue: 0,0:25:40.65,0:25:43.99,Default,,0,0,0,,≪(Сакаки) Жаздың түнінде гүлдейтін екі қызыл гүл
Dialogue: 0,0:25:43.99,0:25:46.09,Default,,0,0,0,,≪(Майои) Бұл жел стилі.
Dialogue: 0,0:25:48.32,0:25:50.32,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:25:51.48,0:26:00.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:28:56.65,0:28:59.98,Default,,0,0,0,,Мен Цумики-чанды таптым
Dialogue: 0,0:28:59.98,0:29:02.32,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:29:02.32,0:29:05.64,Default,,0,0,0,,Кейдородағы барлық адамдар
Dialogue: 0,0:29:05.64,0:29:08.31,Default,,0,0,0,,Дұрыс, Цумики-чан
Dialogue: 0,0:29:08.31,0:29:10.33,Default,,0,0,0,,Мен қашуым керек.
Dialogue: 0,0:29:10.33,0:29:12.96,Default,,0,0,0,,Цумики-чан
Dialogue: 0,0:29:12.96,0:29:14.98,Default,,0,0,0,,Ұстау
Dialogue: 0,0:29:14.98,0:29:16.98,Default,,0,0,0,,Ұстаңыз, ұстаңыз...
Dialogue: 0,0:29:18.48,0:29:24.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
