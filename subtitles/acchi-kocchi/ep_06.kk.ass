Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.97,0:00:12.98,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:00:12.98,0:00:15.98,Default,,0,0,0,,《(Ими) Қайырлы таң Цумики》
Dialogue: 0,0:00:15.98,0:00:17.98,Default,,0,0,0,,《Аа... қайырлы таң》
Dialogue: 0,0:00:17.98,0:00:20.32,Default,,0,0,0,,《Бүгіннен жазғы киімнен басталады》
Dialogue: 0,0:00:20.32,0:00:22.99,Default,,0,0,0,,《Жақсы... дұрыс》
Dialogue: 0,0:00:22.99,0:00:25.99,Default,,0,0,0,,《Ол саған жарасады, Цумики》
Dialogue: 0,0:00:26.99,0:00:29.99,Default,,0,0,0,,＜Жоқ...＞
Dialogue: 0,0:00:29.99,0:00:32.10,Default,,0,0,0,,Қайырлы таң Цумики
Dialogue: 0,0:00:34.00,0:00:37.00,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:00:37.00,0:00:39.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:40.34,0:00:43.34,Default,,0,0,0,,Жазғы киім саған жарасады.
Dialogue: 0,0:00:44.67,0:00:49.01,Default,,0,0,0,,Не болды! ? Цумики: Бұл ештеңе емес...
Dialogue: 0,0:00:49.01,0:02:16.03,Default,,0,0,0,,♬～
Dialogue: 0,0:02:35.32,0:02:37.32,Default,,0,0,0,,О, ха~
Dialogue: 0,0:02:37.32,0:02:39.32,Default,,0,0,0,,Екеуіңізге қайырлы таң.
Dialogue: 0,0:02:39.32,0:02:41.66,Default,,0,0,0,,Қайырлы таң Қайырлы таң
Dialogue: 0,0:02:41.66,0:02:44.99,Default,,0,0,0,,Бүгін күн ыстық емес сияқты, солай ма?
Dialogue: 0,0:02:44.99,0:02:48.00,Default,,0,0,0,,Барлығының жазғы киімдерін осылай қарасам
Dialogue: 0,0:02:48.00,0:02:50.67,Default,,0,0,0,,Жыл мезгілдерін сезіне аласыз, солай ма?
Dialogue: 0,0:02:50.67,0:02:53.00,Default,,0,0,0,,Дәлірек айтқанда, не?
Dialogue: 0,0:02:53.00,0:02:55.67,Default,,0,0,0,,Жыл бойы ақ халатты 1 адам ғана киеді
Dialogue: 0,0:02:55.67,0:02:57.67,Default,,0,0,0,,Өз орнында жақсы көрінбейтіндер бар болса да.
Dialogue: 0,0:02:57.67,0:02:59.67,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:02:59.67,0:03:02.28,Default,,0,0,0,,Шын мәнінде! Иә?
Dialogue: 0,0:03:02.28,0:03:06.28,Default,,0,0,0,,⚟(Майои) О, құдай! Мата жұқарып барады.
Dialogue: 0,0:03:06.28,0:03:08.28,Default,,0,0,0,,Түсінесіз бе!
Dialogue: 0,0:03:10.29,0:03:13.29,Default,,0,0,0,,Няфу Иә?
Dialogue: 0,0:03:13.29,0:03:16.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:16.29,0:03:18.63,Default,,0,0,0,,Ими мырза, Ими мырза Иә?
Dialogue: 0,0:03:18.63,0:03:20.63,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:03:21.96,0:03:24.97,Default,,0,0,0,,Жазғы киімге қызмет көрсету
Dialogue: 0,0:03:27.97,0:03:31.97,Default,,0,0,0,,Майои-сан, күткендей...
Dialogue: 0,0:03:31.97,0:03:34.58,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:35.64,0:03:37.65,Default,,0,0,0,,Ах! ➡
Dialogue: 0,0:03:37.65,0:03:40.98,Default,,0,0,0,,Мен... Ими маған телефон соғып жатыр! Ах!
Dialogue: 0,0:03:40.98,0:03:42.98,Default,,0,0,0,,Ху~ Кюн
Dialogue: 0,0:03:42.98,0:03:45.65,Default,,0,0,0,,Сене алмайсың.
Dialogue: 0,0:03:45.65,0:03:48.66,Default,,0,0,0,,Ими-кун, сен телепортация жасай алдың.
Dialogue: 0,0:03:48.66,0:03:51.33,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:03:51.33,0:03:53.66,Default,,0,0,0,,Хаха~
Dialogue: 0,0:03:53.66,0:03:56.67,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:03:56.67,0:03:59.67,Default,,0,0,0,,⚟Ыстық~
Dialogue: 0,0:03:59.67,0:04:02.27,Default,,0,0,0,,Аджи~
Dialogue: 0,0:04:02.27,0:04:06.27,Default,,0,0,0,,А, бұл бассейнді тазалау үшін тамаша күн.
Dialogue: 0,0:04:06.27,0:04:11.61,Default,,0,0,0,,Енді дайын екеніңізді хабарлаңыз.
Dialogue: 0,0:04:11.61,0:04:13.95,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.95,0:04:16.95,Default,,0,0,0,,А, менің итім шашын жинап жатыр~
Dialogue: 0,0:04:16.95,0:04:18.95,Default,,0,0,0,,Өйткені ол ылғалданатын сияқты
Dialogue: 0,0:04:18.95,0:04:22.62,Default,,0,0,0,,Бұл өте сүйкімді және сирек➡
Dialogue: 0,0:04:22.62,0:04:26.29,Default,,0,0,0,,Иә, иә, миниван сүйкімді~
Dialogue: 0,0:04:26.29,0:04:30.30,Default,,0,0,0,,Ах~ Мен де шашымды өсіремін деп ойлаймын
Dialogue: 0,0:04:30.30,0:04:33.64,Default,,0,0,0,,Кана-ян шашын өсіргенде➡
Dialogue: 0,0:04:33.64,0:04:35.97,Default,,0,0,0,,Көлемі ➡
Dialogue: 0,0:04:35.97,0:04:38.64,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:38.64,0:04:40.64,Default,,0,0,0,,《Ол ауыр болуы мүмкін~》
Dialogue: 0,0:04:40.64,0:04:44.05,Default,,0,0,0,,Жоқ! Және сүйкімді емес
Dialogue: 0,0:04:45.98,0:04:48.98,Default,,0,0,0,,Күлсін... Күн ыстық.
Dialogue: 0,0:04:48.98,0:04:50.99,Default,,0,0,0,,Мұғалім Иә?
Dialogue: 0,0:04:50.99,0:04:54.16,Default,,0,0,0,,...
Dialogue: 0,0:04:54.16,0:04:56.16,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:04:56.16,0:04:58.99,Default,,0,0,0,,Ұстаз, мен осындай мейірімді шәкіртім барына қуаныштымын.
Dialogue: 0,0:04:58.99,0:05:00.93,Default,,0,0,0,,⚟(Saki) Sensei➡
Dialogue: 0,0:05:00.93,0:05:02.93,Default,,0,0,0,,Иә, бұл күннен қорғайтын крем
Dialogue: 0,0:05:02.93,0:05:06.27,Default,,0,0,0,,Рахмет ⚟(Кана) Сенсей➡
Dialogue: 0,0:05:06.27,0:05:08.94,Default,,0,0,0,,Иә, бұл күннен қорғайтын көзілдірік
Dialogue: 0,0:05:08.94,0:05:11.94,Default,,0,0,0,,Рахмет... ⚟(Сакаки) Сенсей
Dialogue: 0,0:05:11.94,0:05:14.94,Default,,0,0,0,,Мынаны пайдаланыңыз
Dialogue: 0,0:05:14.94,0:05:17.28,Default,,0,0,0,,Ух... Мен бақыттымын ⚟(Майои) Сенсей
Dialogue: 0,0:05:17.28,0:05:19.28,Default,,0,0,0,,Иә жеткізіледі
Dialogue: 0,0:05:19.28,0:05:21.98,Default,,0,0,0,,Мен бұл пікірге риза емеспін.
Dialogue: 0,0:05:27.62,0:05:30.63,Default,,0,0,0,,Мэйо-чан, сен не істеп жатырсың?
Dialogue: 0,0:05:30.63,0:05:32.63,Default,,0,0,0,,Орындалды! ➡
Dialogue: 0,0:05:32.63,0:05:34.63,Default,,0,0,0,,Джан!
Dialogue: 0,0:05:34.63,0:05:36.63,Default,,0,0,0,,Цумики мырза, мынаны алыңыз.
Dialogue: 0,0:05:36.63,0:05:38.63,Default,,0,0,0,,Неліктен щеткалар екі ұшына да керек?
Dialogue: 0,0:05:38.63,0:05:40.64,Default,,0,0,0,,Бұны мықтап бұраңыз
Dialogue: 0,0:05:40.64,0:05:44.04,Default,,0,0,0,,Барлық кірден арылайық. Ах...
Dialogue: 0,0:05:44.97,0:05:46.98,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:05:50.65,0:05:52.65,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:52.65,0:05:56.35,Default,,0,0,0,,Бұл ұнайды ма? Иә, бұл қатарынан
Dialogue: 0,0:05:59.32,0:06:02.59,Default,,0,0,0,,А... уф!
Dialogue: 0,0:06:02.59,0:06:04.59,Default,,0,0,0,,Кешіріңіз... кешіріңіз
Dialogue: 0,0:06:06.60,0:06:09.60,Default,,0,0,0,,⚟(Сакаки) Уха~
Dialogue: 0,0:06:09.60,0:06:11.60,Default,,0,0,0,,Хаха~
Dialogue: 0,0:06:11.60,0:06:13.60,Default,,0,0,0,,Қайда қарап тұрсың?
Dialogue: 0,0:06:13.60,0:06:15.94,Default,,0,0,0,,Менің желкем жазда жарқырайды~
Dialogue: 0,0:06:15.94,0:06:18.61,Default,,0,0,0,,Жаздың шуағы, солай емес пе?
Dialogue: 0,0:06:18.61,0:06:22.61,Default,,0,0,0,,Жаз күнінің астындағы денсаулық пен сұлулықты байқамай тұра алмаймын.
Dialogue: 0,0:06:23.95,0:06:26.28,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:06:26.28,0:06:29.28,Default,,0,0,0,,Мен желкесін білмеймін, иә➡
Dialogue: 0,0:06:29.28,0:06:33.96,Default,,0,0,0,,Киотани Сакимориге қарады, солай ма?
Dialogue: 0,0:06:33.96,0:06:37.96,Default,,0,0,0,,Сәлем! Мақсат қойып жатырсыз ба? Өткізіп алмаңыз.
Dialogue: 0,0:06:37.96,0:06:41.30,Default,,0,0,0,,⚟(Сақаки) Оны асқан сыпайылықпен, әсемдікпен аулақ ұстауға болатын сияқты.
Dialogue: 0,0:06:41.30,0:06:43.30,Default,,0,0,0,,Гамба! Бұл басқаша!
Dialogue: 0,0:06:43.30,0:06:45.97,Default,,0,0,0,,Бұл түсінбеушілік қашан шешіледі?
Dialogue: 0,0:06:45.97,0:06:47.97,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:06:47.97,0:06:51.31,Default,,0,0,0,,Айтпақшы, Отонаши қыздарға не қарайды?
Dialogue: 0,0:06:51.31,0:06:54.31,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:56.98,0:06:58.98,Default,,0,0,0,,Мүмкін күлімсіреу
Dialogue: 0,0:07:05.25,0:07:07.26,Default,,0,0,0,,Мені жалғыз қалдырыңыз!
Dialogue: 0,0:07:07.26,0:07:09.59,Default,,0,0,0,,«Кеуде» десе жақсы болар ма еді?
Dialogue: 0,0:07:09.59,0:07:11.99,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:07:14.60,0:07:17.93,Default,,0,0,0,,Күткендей, оның бір көрінісі бар.
Dialogue: 0,0:07:17.93,0:07:20.94,Default,,0,0,0,,Бақа немесе бақаның көрінісі
Dialogue: 0,0:07:20.94,0:07:25.27,Default,,0,0,0,,Жуатын ештеңе жоқ, мен не істеуім керек? Хмм
Dialogue: 0,0:07:25.27,0:07:28.28,Default,,0,0,0,,Жабдық бөлмесінде су ыдысы болған жоқ па?
Dialogue: 0,0:07:28.28,0:07:31.28,Default,,0,0,0,,Яго танкте, ал сержант...
Dialogue: 0,0:07:31.28,0:07:33.28,Default,,0,0,0,,«Сержант» деп айтпаңыз
Dialogue: 0,0:07:33.28,0:07:36.95,Default,,0,0,0,,Тұз қосу керек пе? Неліктен?
Dialogue: 0,0:07:36.95,0:07:38.95,Default,,0,0,0,,Балқыма... Су?
Dialogue: 0,0:07:38.95,0:07:40.96,Default,,0,0,0,,Бейшара сен!
Dialogue: 0,0:07:40.96,0:07:42.96,Default,,0,0,0,,Бұл шлам
Dialogue: 0,0:07:46.29,0:07:49.30,Default,,0,0,0,,Қабыл ал! Урья~!
Dialogue: 0,0:07:49.30,0:07:51.97,Default,,0,0,0,,О! Тіпті щеткамен хоккей ойнау да...
Dialogue: 0,0:07:51.97,0:07:54.30,Default,,0,0,0,,Бұх!
Dialogue: 0,0:07:54.30,0:07:57.64,Default,,0,0,0,,Аа, кешіріңіз... Жоқ, Сакаки-сан.
Dialogue: 0,0:07:57.64,0:07:59.91,Default,,0,0,0,,Скруббер мырза! ?
Dialogue: 0,0:07:59.91,0:08:03.91,Default,,0,0,0,,Мен екінші сыныпқа өтетін болдым.
Dialogue: 0,0:08:03.91,0:08:06.92,Default,,0,0,0,,Техеперо кешіріңіз
Dialogue: 0,0:08:06.92,0:08:09.92,Default,,0,0,0,,Таваши мырза, сіз не қарап тұрсыз, Ино?
Dialogue: 0,0:08:09.92,0:08:13.59,Default,,0,0,0,,Демек, бұл Сакаки-сан болар еді.
Dialogue: 0,0:08:13.59,0:08:17.26,Default,,0,0,0,,Шешім! Енді мен бұл тазартқышты «Сакаки-сан» деп атаймын.
Dialogue: 0,0:08:17.26,0:08:19.26,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:19.26,0:08:22.93,Default,,0,0,0,,Футбол добы сенің досың ба? Дәл солай.
Dialogue: 0,0:08:22.93,0:08:24.93,Default,,0,0,0,,Сол басы мен аяғы бар досқа
Dialogue: 0,0:08:24.93,0:08:27.94,Default,,0,0,0,,Сен мені ойланбастан ұрдың.
Dialogue: 0,0:08:27.94,0:08:30.94,Default,,0,0,0,,Достарыңызбен ұялмаңыз.
Dialogue: 0,0:08:30.94,0:08:33.61,Default,,0,0,0,,Бұл скруббер туралы...
Dialogue: 0,0:08:33.61,0:08:36.61,Default,,0,0,0,,Ха! Мен Сакаки-кунды қылқаламмен ұрамын~
Dialogue: 0,0:08:36.61,0:08:38.61,Default,,0,0,0,,Қорқыту!
Dialogue: 0,0:08:38.61,0:08:41.28,Default,,0,0,0,,Бұл сен емес, скруббер.
Dialogue: 0,0:08:41.28,0:08:44.29,Default,,0,0,0,,Тек жолдарды тыңдасаң, маған қауіп төніп тұр.
Dialogue: 0,0:08:44.29,0:08:48.96,Default,,0,0,0,,Дәлірек айтсақ, онда менің досымның аты да бар.
Dialogue: 0,0:08:48.96,0:08:52.63,Default,,0,0,0,,тартынбаңыз, ә...
Dialogue: 0,0:08:52.63,0:08:54.63,Default,,0,0,0,,Не?!
Dialogue: 0,0:08:54.63,0:08:56.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:56.63,0:08:59.90,Default,,0,0,0,,Сакаки-кун, дайындал!
Dialogue: 0,0:08:59.90,0:09:03.24,Default,,0,0,0,,Сакаки ~ Конояро!
Dialogue: 0,0:09:03.24,0:09:06.91,Default,,0,0,0,,⚟(Кана) Мен қолымнан келгеннің бәрін жасаймын, Сакаки-кун ⚟(Киотани) Бля, Сакаки
Dialogue: 0,0:09:06.91,0:09:09.91,Default,,0,0,0,,Неге мені әр кезде атыммен атайсың?
Dialogue: 0,0:09:09.91,0:09:14.25,Default,,0,0,0,,Бәрің, Сакакиді тым қорлайсыңдар. Осылай қалдырыңыз.
Dialogue: 0,0:09:14.25,0:09:16.25,Default,,0,0,0,,Фефефефе
Dialogue: 0,0:09:16.25,0:09:18.25,Default,,0,0,0,,Цунэ~
Dialogue: 0,0:09:18.25,0:09:21.59,Default,,0,0,0,,Ескі әңгімеде осындай пікір алмасу болған сияқты.
Dialogue: 0,0:09:21.59,0:09:24.93,Default,,0,0,0,,Мен сенің мені тоқтататыныңа сендім, менің ең жақын досым.
Dialogue: 0,0:09:24.93,0:09:27.60,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:09:27.60,0:09:30.30,Default,,0,0,0,,Скруббер Сакаки!
Dialogue: 0,0:09:37.94,0:09:41.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:41.94,0:09:43.95,Default,,0,0,0,,Ханшайым, амансың ба?
Dialogue: 0,0:09:43.95,0:09:47.62,Default,,0,0,0,,Иә... жарайды.
Dialogue: 0,0:09:47.62,0:09:51.32,Default,,0,0,0,,Мына шелекті қайда қою керек...
Dialogue: 0,0:09:52.29,0:09:55.29,Default,,0,0,0,,Ханшайым! Апыр-ай!
Dialogue: 0,0:09:56.29,0:09:58.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:58.96,0:10:01.30,Default,,0,0,0,,(шелек дыбысы)
Dialogue: 0,0:10:01.30,0:10:03.63,Default,,0,0,0,,Мен! Иноми…
Dialogue: 0,0:10:03.63,0:10:05.63,Default,,0,0,0,,Мен тірі едім
Dialogue: 0,0:10:05.63,0:10:10.31,Default,,0,0,0,,Менің басымды кенеттен су соғып, соққы және қараңғылық басып кеткеннен кейін.
Dialogue: 0,0:10:10.31,0:10:12.31,Default,,0,0,0,,Артынан ауыр соққы
Dialogue: 0,0:10:12.31,0:10:16.64,Default,,0,0,0,,Бұл ханшайым мен Онива арасындағы достық екі платондық шабуыл.
Dialogue: 0,0:10:16.64,0:10:18.65,Default,,0,0,0,,Ханшайым ауырып қалған жоқ па?
Dialogue: 0,0:10:18.65,0:10:20.98,Default,,0,0,0,,бұл... Иә, рахмет.
Dialogue: 0,0:10:20.98,0:10:22.98,Default,,0,0,0,,Цумики жарақат алды ма?
Dialogue: 0,0:10:22.98,0:10:25.32,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:10:25.32,0:10:27.32,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:10:27.32,0:10:30.66,Default,,0,0,0,,Шелек төңкеріліп тұрса ше?
Dialogue: 0,0:10:30.66,0:10:34.66,Default,,0,0,0,,Олар кәдімгі Сакаки мен Нишихараға ұқсады.
Dialogue: 0,0:10:37.00,0:10:40.67,Default,,0,0,0,,⚟Еңбегіңіз үшін рахмет~
Dialogue: 0,0:10:40.67,0:10:43.34,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:10:43.34,0:10:46.64,Default,,0,0,0,,Менде бәріңізге балмұздақ дайын.
Dialogue: 0,0:10:48.01,0:10:50.68,Default,,0,0,0,,Мұғалім, бұл не?
Dialogue: 0,0:10:50.68,0:10:53.35,Default,,0,0,0,,Ол үшін не істеуіміз керек? иә?
Dialogue: 0,0:10:53.35,0:10:56.02,Default,,0,0,0,,Қарбыз қалқып тұр!
Dialogue: 0,0:10:56.02,0:10:59.02,Default,,0,0,0,,Мен білмей тұрып салқындап барады.
Dialogue: 0,0:10:59.95,0:11:02.29,Default,,0,0,0,,⚟(Барлығы) Мен оны аламын.
Dialogue: 0,0:11:02.29,0:11:04.29,Default,,0,0,0,,Қарбыз тәтті, ал балмұздақ суық және дәмді.
Dialogue: 0,0:11:04.29,0:11:06.29,Default,,0,0,0,,Қарбызды да жейік.
Dialogue: 0,0:11:07.96,0:11:10.30,Default,,0,0,0,,Қарбызыңызға тұз керек болуы мүмкін.
Dialogue: 0,0:11:10.30,0:11:14.30,Default,,0,0,0,,Қайда бардың, Сақаки? Сіз...
Dialogue: 0,0:11:14.30,0:11:16.64,Default,,0,0,0,,Бұл бассейнге не тасталды?
Dialogue: 0,0:11:16.64,0:11:19.97,Default,,0,0,0,,Бұл алтын сақаки ме? Бұл күміс сакаки ме?
Dialogue: 0,0:11:19.97,0:11:21.98,Default,,0,0,0,,Мен оны тастадым! ?
Dialogue: 0,0:11:21.98,0:11:24.31,Default,,0,0,0,,Не? Мен қандаймын? Ах...
Dialogue: 0,0:11:24.31,0:11:26.98,Default,,0,0,0,,Кәдімгі Сакаки-сан!
Dialogue: 0,0:11:26.98,0:11:29.98,Default,,0,0,0,,⚟(Сакаки) Иә?
Dialogue: 0,0:11:39.99,0:11:42.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:42.00,0:11:45.00,Default,,0,0,0,,Не? Кенет няха
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Бүгін барлығы ертеңгі сынаққа дайындалады.
Dialogue: 0,0:11:47.00,0:11:49.34,Default,,0,0,0,,Оқу сабағын өткізейік пе? Айқай~
Dialogue: 0,0:11:49.34,0:11:53.34,Default,,0,0,0,,Бұл тамаша. Мен де қатысамын.
Dialogue: 0,0:11:53.34,0:11:55.68,Default,,0,0,0,,Содан кейін орын Ими Санчиде шешіледі.
Dialogue: 0,0:11:55.68,0:11:57.68,Default,,0,0,0,,Дәлірек айтсақ, бұл менмін.
Dialogue: 0,0:11:57.68,0:12:00.95,Default,,0,0,0,,Әрине, Цумики-сан да. Мен де?
Dialogue: 0,0:12:00.95,0:12:03.28,Default,,0,0,0,,⚟(Сакаки) Өкінішке орай.
Dialogue: 0,0:12:03.28,0:12:06.62,Default,,0,0,0,,Мен бүгін толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:12:06.62,0:12:08.62,Default,,0,0,0,,Түсіндім, толық емес жұмыс күніңе сәттілік.
Dialogue: 0,0:12:08.62,0:12:12.63,Default,,0,0,0,,Жарайсыңдар, бәрің жақсы оқып, барыңды салыңдар, Адю.
Dialogue: 0,0:12:12.63,0:12:16.63,Default,,0,0,0,,Олай болса, әрқайсың үйге келе салысымен дайындап алыңдар.
Dialogue: 0,0:12:16.63,0:12:18.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:18.63,0:12:22.30,Default,,0,0,0,,Ұрыс даласына барайық! ұрыс алаңы?
Dialogue: 0,0:12:22.30,0:12:24.31,Default,,0,0,0,,Жауға бөлмені босатуға уақыт берме!
Dialogue: 0,0:12:24.31,0:12:28.01,Default,,0,0,0,,Иә? Бұл оқу сабағы емес пе?
Dialogue: 0,0:12:36.65,0:12:39.65,Default,,0,0,0,,Қош келдіңіз Цумики, сіз ерте болдыңыз.
Dialogue: 0,0:12:39.65,0:12:41.66,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:12:41.66,0:12:44.66,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:12:50.33,0:12:54.04,Default,,0,0,0,,Қазір мен саған шай әкелемін.
Dialogue: 0,0:12:57.01,0:12:59.67,Default,,0,0,0,,<Игоның бөлмесінде жалғыз...>
Dialogue: 0,0:12:59.67,0:13:01.61,Default,,0,0,0,,《Кекеке, бөлмені сыпырып алғың келсе》
Dialogue: 0,0:13:01.61,0:13:04.61,Default,,0,0,0,,《Ими-сан жоқ, енді сенің мүмкіндігің~》
Dialogue: 0,0:13:04.61,0:13:07.28,Default,,0,0,0,,《Олай істесең жақсы емес~》
Dialogue: 0,0:13:07.28,0:13:09.28,Default,,0,0,0,,《Ухехе...》
Dialogue: 0,0:13:09.28,0:13:11.29,Default,,0,0,0,,Қоқыс жинамаңыз!
Dialogue: 0,0:13:23.30,0:13:26.00,Default,,0,0,0,,Иго…
Dialogue: 0,0:13:32.97,0:13:35.98,Default,,0,0,0,,<Мен не істеймін! ? ＞
Dialogue: 0,0:13:36.98,0:13:39.28,Default,,0,0,0,,<Не...>
Dialogue: 0,0:13:40.31,0:13:42.65,Default,,0,0,0,,<Не...>
Dialogue: 0,0:13:42.65,0:13:44.65,Default,,0,0,0,,Хо…
Dialogue: 0,0:13:46.65,0:13:49.32,Default,,0,0,0,,⚟(ханшайым)...Цумики-сан! ?
Dialogue: 0,0:13:49.32,0:13:53.03,Default,,0,0,0,,Не... жымиды~
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.00,0:14:01.27,Default,,0,0,0,,Жадты өшіру үшін қатты соққыны қолданыңыз...
Dialogue: 0,0:14:01.27,0:14:03.97,Default,,0,0,0,,Ми (Химе Майои) Ми! ?
Dialogue: 0,0:14:05.94,0:14:09.94,Default,,0,0,0,,Мм... Мен саған айтпаймын, Цумики-сан.
Dialogue: 0,0:14:09.94,0:14:11.95,Default,,0,0,0,,Бұл Имидің көйлегі ме?
Dialogue: 0,0:14:11.95,0:14:13.95,Default,,0,0,0,,Сен Майой-санға не істеп жатырсың?
Dialogue: 0,0:14:14.95,0:14:18.29,Default,,0,0,0,,Күннің иісінде, Ими-санның дәмі
Dialogue: 0,0:14:18.29,0:14:21.29,Default,,0,0,0,,Енді Химе-цчиге кезек келді.
Dialogue: 0,0:14:21.29,0:14:23.29,Default,,0,0,0,,Ал... бұл рас.
Dialogue: 0,0:14:23.29,0:14:26.29,Default,,0,0,0,,⚟(Майои) Жүр, жүр, ойланбай, алға.
Dialogue: 0,0:14:26.29,0:14:30.97,Default,,0,0,0,,⚟(ханшайым) Бұл өте ұят~
Dialogue: 0,0:14:30.97,0:14:33.97,Default,,0,0,0,,Біреудің көйлегін не істеп жүрсің?
Dialogue: 0,0:14:36.30,0:14:39.61,Default,,0,0,0,,Ура! сен?
Dialogue: 0,0:14:42.31,0:14:44.81,Default,,0,0,0,,Мен бұрын болған оқиғаны көрмеген сияқтымын.
Dialogue: 0,0:14:44.81,0:14:48.32,Default,,0,0,0,,Дәптерді тез ашыңыз Майои Нян
Dialogue: 0,0:14:51.32,0:14:54.32,Default,,0,0,0,,(Ойынның басталған дыбысы)
Dialogue: 0,0:14:55.66,0:14:57.66,Default,,0,0,0,,Мияу!
Dialogue: 0,0:14:59.66,0:15:01.93,Default,,0,0,0,,[]Тамаша!
Dialogue: 0,0:15:01.93,0:15:05.60,Default,,0,0,0,,Няхаха... Әзіл!
Dialogue: 0,0:15:05.60,0:15:08.60,Default,,0,0,0,,Жарайды, енді тыныш отыра бер.
Dialogue: 0,0:15:08.60,0:15:11.61,Default,,0,0,0,,Мен... Ими-сан: Иә?
Dialogue: 0,0:15:11.61,0:15:14.28,Default,,0,0,0,,Мұны айтқаным үшін кешіріңіз, бірақ...
Dialogue: 0,0:15:14.28,0:15:17.28,Default,,0,0,0,,Мен саған оқулықты қарызға беремін.
Dialogue: 0,0:15:17.28,0:15:21.28,Default,,0,0,0,,«Оқу сабағы» деген осы ма еді?
Dialogue: 0,0:15:21.28,0:15:24.99,Default,,0,0,0,,Әдемі~ Шек, Эх! ?
Dialogue: 0,0:15:27.62,0:15:31.29,Default,,0,0,0,,Хмм, Цумики-сан, не?
Dialogue: 0,0:15:31.29,0:15:34.30,Default,,0,0,0,,Мен бұл мәселе туралы білгім келеді.
Dialogue: 0,0:15:34.30,0:15:36.30,Default,,0,0,0,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:15:36.30,0:15:38.30,Default,,0,0,0,,Ах... міне.
Dialogue: 0,0:15:38.30,0:15:41.30,Default,,0,0,0,,Күтілгендей, сыныпта жоғары сынып
Dialogue: 0,0:15:41.30,0:15:44.31,Default,,0,0,0,,Бұл жерде осылай болады.
Dialogue: 0,0:15:44.31,0:15:46.31,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:15:46.31,0:15:49.64,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:15:49.64,0:15:52.65,Default,,0,0,0,,Мұндай мәселе шешілсе де, мен әлі түсінбеймін.
Dialogue: 0,0:15:52.65,0:15:54.65,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:15:54.65,0:15:57.65,Default,,0,0,0,,Онда мен саған айтамын.
Dialogue: 0,0:15:57.65,0:16:00.59,Default,,0,0,0,,Шынымен бе? Иә
Dialogue: 0,0:16:00.59,0:16:03.59,Default,,0,0,0,,Цумики-сан, бұлай күйзелудің қажеті жоқ.
Dialogue: 0,0:16:03.59,0:16:06.93,Default,,0,0,0,,Мен мүлде депрессияда емеспін. О?
Dialogue: 0,0:16:06.93,0:16:09.93,Default,,0,0,0,,Мұнда формуланы қолданыңыз.
Dialogue: 0,0:16:09.93,0:16:12.93,Default,,0,0,0,,Осылай жасасаң оңай шешетіні рас.
Dialogue: 0,0:16:12.93,0:16:15.94,Default,,0,0,0,,Бұл жақсы атмосфера.
Dialogue: 0,0:16:15.94,0:16:17.94,Default,,0,0,0,,Цумики-сан Якимочи...
Dialogue: 0,0:16:19.27,0:16:23.28,Default,,0,0,0,,Ита~! Цумики-сан Айда-и!
Dialogue: 0,0:16:24.28,0:16:26.95,Default,,0,0,0,,Сіз не істеп жатырсыз? Майой
Dialogue: 0,0:16:26.95,0:16:31.25,Default,,0,0,0,,Жоқ~ Цумики-сан Ими-сан мен Химекчиге мочи гриль жасап жатыр...
Dialogue: 0,0:16:32.95,0:16:36.29,Default,,0,0,0,,Цумики мырза, мен өзімнің ауыру сезімімнен бас тарта алмаймын.
Dialogue: 0,0:16:36.29,0:16:38.29,Default,,0,0,0,,Ішкі жамбас…
Dialogue: 0,0:16:38.29,0:16:41.96,Default,,0,0,0,,Ах! Сонда бұрын не болды?
Dialogue: 0,0:16:41.96,0:16:43.97,Default,,0,0,0,,⚟(Майои) Хе!
Dialogue: 0,0:16:45.63,0:16:49.04,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:16:50.64,0:16:54.34,Default,,0,0,0,,Мен... мен... күтемін... Иә?
Dialogue: 0,0:16:55.31,0:16:58.65,Default,,0,0,0,,Кохон... Мен саған айтамын.
Dialogue: 0,0:16:58.65,0:17:02.05,Default,,0,0,0,,Ах... Иә, мен оны қайта алдым!
Dialogue: 0,0:17:03.58,0:17:05.59,Default,,0,0,0,,Мияу➡
Dialogue: 0,0:17:05.59,0:17:08.26,Default,,0,0,0,,Тест енді мінсіз емес.
Dialogue: 0,0:17:08.26,0:17:11.26,Default,,0,0,0,,Ал, мен әлі де сенімді емеспін.
Dialogue: 0,0:17:11.26,0:17:13.59,Default,,0,0,0,,Менен де күткендей.
Dialogue: 0,0:17:13.59,0:17:15.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:15.60,0:17:18.60,Default,,0,0,0,,Жазғы демалыста бәріміз саяхатқа шығамыз ба?
Dialogue: 0,0:17:18.60,0:17:21.27,Default,,0,0,0,,Жақсы сапар
Dialogue: 0,0:17:21.27,0:17:27.28,Default,,0,0,0,,Саяхат? Бұл жағдайда мен Сакакимен және басқалармен бірге барған жалдамалы вилла жақсы идея болуы мүмкін.
Dialogue: 0,0:17:27.28,0:17:29.28,Default,,0,0,0,,Бұл көңілді сияқты.
Dialogue: 0,0:17:29.28,0:17:32.28,Default,,0,0,0,,Бұл жалға берілетін вилла ма? Бұл менің бірінші рет.
Dialogue: 0,0:17:32.28,0:17:34.62,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:17:34.62,0:17:37.62,Default,,0,0,0,,Олай болса, бірден жоспар құрайық.
Dialogue: 0,0:17:37.62,0:17:39.62,Default,,0,0,0,,Мен жылдаммын.
Dialogue: 0,0:17:39.62,0:17:43.62,Default,,0,0,0,,Сынақ біткен соң мияу.
Dialogue: 0,0:17:43.62,0:17:47.30,Default,,0,0,0,,<Имимен саяхат…>
Dialogue: 0,0:17:47.30,0:17:49.63,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:17:54.97,0:17:56.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:56.97,0:17:59.91,Default,,0,0,0,,Барлығының сынағы қалай өтті?
Dialogue: 0,0:17:59.91,0:18:02.58,Default,,0,0,0,,Әдеттегідей мен өзіме сенімді емеспін.
Dialogue: 0,0:18:02.58,0:18:07.25,Default,,0,0,0,,Бұл жолы мен барлығымен зерттеу сабағын өткіздім, сондықтан ол қандай да бір нәтиже береді деп үміттенемін.
Dialogue: 0,0:18:07.25,0:18:12.25,Default,,0,0,0,,Имиде не оқығаныңыз есіңізде болса
Dialogue: 0,0:18:12.25,0:18:15.26,Default,,0,0,0,,Есімде болса...
Dialogue: 0,0:18:17.26,0:18:20.26,Default,,0,0,0,,Менің есімде қалғаны – көйлегімнің иісі.
Dialogue: 0,0:18:20.26,0:18:22.26,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:18:26.27,0:18:28.60,Default,,0,0,0,,⚟(ханшайым) Ойланып қарашы➡
Dialogue: 0,0:18:28.60,0:18:31.94,Default,,0,0,0,,Бүгінгі ауа райы болжамында күндіз жаңбыр жауады.
Dialogue: 0,0:18:31.94,0:18:34.61,Default,,0,0,0,,Жаңбыр? жаңбыр?
Dialogue: 0,0:18:34.61,0:18:36.61,Default,,0,0,0,,Осы ашық ауа райымен?
Dialogue: 0,0:18:36.61,0:18:39.95,Default,,0,0,0,,Жылдың осы мезгілінде ауа райы құбылмалы.
Dialogue: 0,0:18:39.95,0:18:42.95,Default,,0,0,0,,Жарайды, мен қолшатыр әкелдім. Иә.
Dialogue: 0,0:18:42.95,0:18:45.95,Default,,0,0,0,,Таңертең дұрыс дайындал...
Dialogue: 0,0:18:45.95,0:18:47.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:47.96,0:18:50.96,Default,,0,0,0,,Мен оны үстелімнің үстіне қалдырдым.
Dialogue: 0,0:18:50.96,0:18:53.56,Default,,0,0,0,,Мен персоналды ұмытқан жоқпын.
Dialogue: 0,0:18:57.97,0:19:02.24,Default,,0,0,0,,Қазір, жаңбырлы күні мен күйзелемін.
Dialogue: 0,0:19:02.24,0:19:04.24,Default,,0,0,0,,Жаңашыл заттар бар
Dialogue: 0,0:19:04.24,0:19:06.24,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:19:06.24,0:19:08.54,Default,,0,0,0,,Тағы да күдікті нәрсе
Dialogue: 0,0:19:09.58,0:19:13.91,Default,,0,0,0,,Құмарлы жұптарға міндетті түрде ұсынылады➡
Dialogue: 0,0:19:13.91,0:19:16.25,Default,,0,0,0,,Иә, бұл!
Dialogue: 0,0:19:16.25,0:19:18.25,Default,,0,0,0,,Бұл үлкен жүрек.
Dialogue: 0,0:19:18.25,0:19:21.59,Default,,0,0,0,,Мұны қолшатырыңыздың ұшына бекітіңіз.
Dialogue: 0,0:19:21.59,0:19:25.26,Default,,0,0,0,,Дәл осылай, ол тез арада шынайы өзара қолшатырға айналады
Dialogue: 0,0:19:25.26,0:19:27.93,Default,,0,0,0,,Ал... түсіндім.
Dialogue: 0,0:19:27.93,0:19:31.60,Default,,0,0,0,,Күңгіртке ұқсайды
Dialogue: 0,0:19:31.60,0:19:33.60,Default,,0,0,0,,Иә, Цумики-санды қолданыңыз.
Dialogue: 0,0:19:33.60,0:19:35.60,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:19:41.28,0:19:43.61,Default,,0,0,0,,Қатты жаңбыр жауа бастады.
Dialogue: 0,0:19:43.61,0:19:46.28,Default,,0,0,0,,Жаңбырлы маусым өтіп кетті.
Dialogue: 0,0:19:46.28,0:19:48.62,Default,,0,0,0,,Жаңбырлы маусым... Маусым
Dialogue: 0,0:19:48.62,0:19:52.29,Default,,0,0,0,,Маусым Келін де өтті.
Dialogue: 0,0:19:52.29,0:19:56.29,Default,,0,0,0,,Қыздар шынымен осындай нәрселерге қызыға ма?
Dialogue: 0,0:19:56.29,0:19:58.99,Default,,0,0,0,,Сонымен... иә, маған қызық...
Dialogue: 0,0:19:59.96,0:20:02.63,Default,,0,0,0,,На… на…
Dialogue: 0,0:20:02.63,0:20:05.03,Default,,0,0,0,,Қазір! Енді?
Dialogue: 0,0:20:06.97,0:20:12.64,Default,,0,0,0,,Уау~ Мен дайындағаныммен, қолшатыр менің үстелімде тұр.
Dialogue: 0,0:20:12.64,0:20:15.31,Default,,0,0,0,,Менің екі қолшатырым бар.
Dialogue: 0,0:20:15.31,0:20:19.31,Default,,0,0,0,,Менің де қолшатырым болды ма деп ойлаймын. Цумики ше?
Dialogue: 0,0:20:19.31,0:20:21.32,Default,,0,0,0,,Мен де әкелген жоқпын.
Dialogue: 0,0:20:21.32,0:20:24.65,Default,,0,0,0,,Сонда Цумики менің қолшатырымның астына түсе ме?
Dialogue: 0,0:20:24.65,0:20:26.65,Default,,0,0,0,,Үйдің бағыты бірдей
Dialogue: 0,0:20:26.65,0:20:29.99,Default,,0,0,0,,Мен мұны істеуден аулақ боламын. Ааа~➡
Dialogue: 0,0:20:29.99,0:20:32.29,Default,,0,0,0,,Басқаша айтқанда, аударғанда...
Dialogue: 0,0:20:36.50,0:20:40.00,Default,,0,0,0,,Дұрыс па? Мен... көремін!
Dialogue: 0,0:20:42.34,0:20:44.67,Default,,0,0,0,,Қолшатыр Рахмет
Dialogue: 0,0:20:44.67,0:20:48.38,Default,,0,0,0,,Уау, екеуін қалдыруға тұрарлық еді.
Dialogue: 0,0:20:53.01,0:20:55.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.02,0:20:57.02,Default,,0,0,0,,Бұл әдейі емес пе?
Dialogue: 0,0:20:57.02,0:21:00.62,Default,,0,0,0,,⚟(ханшайым) Қолшатырлар ұшады, солай ма? Олар жоқ.
Dialogue: 0,0:21:00.62,0:21:02.62,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:21:02.62,0:21:04.96,Default,,0,0,0,,Ұшатын қолшатырмен не істейсің?
Dialogue: 0,0:21:04.96,0:21:07.96,Default,,0,0,0,,Дұрыс, мен жинаймын...
Dialogue: 0,0:21:07.96,0:21:10.30,Default,,0,0,0,,Ал... Сакаки мырза!
Dialogue: 0,0:21:10.30,0:21:13.00,Default,,0,0,0,,Аригато Томодачи
Dialogue: 0,0:21:17.64,0:21:20.98,Default,,0,0,0,,Олай болса, Ими-кун, Цумики-сан, ертең кездескенше~
Dialogue: 0,0:21:20.98,0:21:23.64,Default,,0,0,0,,Аа, ертең кездескенше
Dialogue: 0,0:21:23.64,0:21:25.65,Default,,0,0,0,,Үйге қайтар жолда
Dialogue: 0,0:21:25.65,0:21:27.98,Default,,0,0,0,,Аспан тамшыларымен мөлдір таза ақ көйлек
Dialogue: 0,0:21:27.98,0:21:29.98,Default,,0,0,0,,Сіз дымқыл боласыз.
Dialogue: 0,0:21:29.98,0:21:32.65,Default,,0,0,0,,Жұқа маталарға жабысатын жылтыр тері
Dialogue: 0,0:21:32.65,0:21:34.66,Default,,0,0,0,,Қолшатыр және жаңбыр дыбысы
Dialogue: 0,0:21:34.66,0:21:37.66,Default,,0,0,0,,Табиғи BGM конверттеу
Dialogue: 0,0:21:37.66,0:21:40.66,Default,,0,0,0,,Кенет не? Джакара
Dialogue: 0,0:21:40.66,0:21:43.00,Default,,0,0,0,,Жіберуші қасқырдан сақ бол
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Ими мырза! Мияу!
Dialogue: 0,0:21:45.00,0:21:47.00,Default,,0,0,0,,Маған шабуыл жасала ма?
Dialogue: 0,0:22:00.61,0:22:03.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.29,0:22:09.99,Default,,0,0,0,,Иә... не болды?
Dialogue: 0,0:22:10.96,0:22:14.56,Default,,0,0,0,,Маған шабуыл жасалуы мүмкін бе?
Dialogue: 0,0:22:16.96,0:22:19.97,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:22:19.97,0:23:47.99,Default,,0,0,0,,♬～
Dialogue: 0,0:23:55.33,0:23:58.33,Default,,0,0,0,,Ұйықтау уақыты келді, бәріңе!
Dialogue: 0,0:23:58.33,0:24:00.33,Default,,0,0,0,,Иә
Dialogue: 0,0:24:01.94,0:24:03.94,Default,,0,0,0,,Джи~
Dialogue: 0,0:24:03.94,0:24:07.27,Default,,0,0,0,,Бала ұйықтап жатыр, сондықтан тыныш болыңыз.
Dialogue: 0,0:24:07.27,0:24:10.28,Default,,0,0,0,,Иә? Цумики-чан
Dialogue: 0,0:24:11.28,0:24:14.95,Default,,0,0,0,,Мияу
Dialogue: 0,0:24:14.95,0:24:17.55,Default,,0,0,0,,Міне, Цумики-чан футонда...
Dialogue: 0,0:24:19.05,0:24:25.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
