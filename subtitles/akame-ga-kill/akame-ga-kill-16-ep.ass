Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.88,Default,,0,0,0,,Енді Тейгу соғысы басталады.
Dialogue: 0,0:00:07.29,0:00:08.96,Default,,0,0,0,,Қанша адам өледі?
Dialogue: 0,0:00:09.42,0:00:13.97,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:00:14.22,0:00:18.26,Default,,0,0,0,,Егер сегіз мәйітті манипуляцияласаңыз, құюшының қимылдары баяулайды.
Dialogue: 0,0:00:18.51,0:00:20.14,Default,,0,0,0,,Бұл мүмкіндікті жіберіп алмаңыз!
Dialogue: 0,0:00:25.44,0:00:26.48,Default,,0,0,0,,Ннн!
Dialogue: 0,0:00:27.36,0:00:28.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:33.65,0:00:34.45,Default,,0,0,0,,Хаа!
Dialogue: 0,0:00:34.61,0:00:35.78,Default,,0,0,0,,(Дыбыс алынды)
Dialogue: 0,0:00:36.03,0:00:37.62,Default,,0,0,0,,На... Натара!
Dialogue: 0,0:00:40.12,0:00:43.83,Default,,0,0,0,,Тек оны топыраққа қайтарыңыз. Бұл сіз бірге өскен досыңыз!
Dialogue: 0,0:00:44.46,0:00:46.62,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Үлкен әпке
Dialogue: 0,0:00:46.79,0:00:47.63,Default,,0,0,0,,(Дыбыс алынды)
Dialogue: 0,0:00:49.25,0:00:53.51,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді, өйткені біз доспыз.
Dialogue: 0,0:00:54.38,0:00:57.30,Default,,0,0,0,,Мен апаңды да жинаққа саламын.
Dialogue: 0,0:00:57.80,0:01:01.47,Default,,0,0,0,,Сонда бұрынғыдай бірге боламыз.
Dialogue: 0,0:01:01.60,0:01:03.60,Default,,0,0,0,,Хм... Ақымақ болма.
Dialogue: 0,0:01:04.06,0:01:04.89,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:01:05.48,0:01:06.81,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:01:09.02,0:01:10.94,Default,,0,0,0,,Магмалық жетек
Dialogue: 0,0:01:12.48,0:01:13.32,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:01:13.82,0:01:16.70,Default,,0,0,0,,Сол Тейгу алыстан шабуыл жасай ала ма?
Dialogue: 0,0:01:18.24,0:01:20.99,Default,,0,0,0,,А... жалғыз кірме.
Dialogue: 0,0:01:21.53,0:01:22.91,Default,,0,0,0,,Бұл сізге ұқсамайды, Ақаме!
Dialogue: 0,0:01:23.08,0:01:23.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:24.83,0:01:25.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:28.21,0:01:32.88,Default,,0,0,0,,Ол оңай жеңілетін қарсылас емес сияқты.
Dialogue: 0,0:01:34.05,0:01:40.05,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:57.38,0:03:03.39,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:07.52,0:03:08.85,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:03:09.43,0:03:12.31,Default,,0,0,0,,Бізге опасыздық жасағандар...
Dialogue: 0,0:03:12.69,0:03:14.94,Default,,0,0,0,,Жасай бер, Дестагул!
Dialogue: 0,0:03:15.52,0:03:16.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:17.03,0:03:17.94,Default,,0,0,0,,Ннн…
Dialogue: 0,0:03:18.11,0:03:18.86,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:03:23.57,0:03:24.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.74,0:03:26.70,Default,,0,0,0,,Бірақ ол күткендей, оны айналып өтті.
Dialogue: 0,0:03:29.70,0:03:32.67,Default,,0,0,0,,Бұл өте қауіпті түрдің күші ме?
Dialogue: 0,0:03:32.92,0:03:34.17,Default,,0,0,0,,Бұл тәртіпсіздік емес!
Dialogue: 0,0:03:34.33,0:03:38.13,Default,,0,0,0,,Ахахха... Жер бедері өзгерді.
Dialogue: 0,0:03:38.55,0:03:39.55,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:40.17,0:03:44.14,Default,,0,0,0,,Күтілгендей, бұл әйгілі түнгі рейд.
Dialogue: 0,0:03:44.26,0:03:45.85,Default,,0,0,0,,Мен дұрыс қаштым.
Dialogue: 0,0:03:46.14,0:03:48.81,Default,,0,0,0,,(жіптің реакция дыбысы)
Dialogue: 0,0:03:49.18,0:03:51.31,Default,,0,0,0,,Шайқас басталды ма?
Dialogue: 0,0:03:51.98,0:03:56.86,Default,,0,0,0,,Мен де өз үлесімді дұрыс орындаймын, Надженда-сан.
Dialogue: 0,0:03:57.98,0:04:02.49,Default,,0,0,0,,Мен осы сапардан оралғанда, өз сезімімді мойындайтын кез келді деп ойлаймын.
Dialogue: 0,0:04:02.61,0:04:06.12,Default,,0,0,0,,Күте тұрсаңыз, Сью мырза сізді ұстап алады.
Dialogue: 0,0:04:07.91,0:04:09.87,Default,,0,0,0,,Деструктивті күш күткендей.
Dialogue: 0,0:04:09.99,0:04:12.50,Default,,0,0,0,,Жарайды, бәріміз оны тоқтатайық.
Dialogue: 0,0:04:12.62,0:04:16.08,Default,,0,0,0,,Бұл бұйрық дұрыс емес, Надженда.
Dialogue: 0,0:04:16.42,0:04:18.59,Default,,0,0,0,,Ол, әрине, айбатты жау.
Dialogue: 0,0:04:19.17,0:04:20.17,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:04:20.67,0:04:22.17,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,0:04:22.59,0:04:26.22,Default,,0,0,0,,Мен оны өзім жеңе аламын, қалғандары басқаларды ұрсын.
Dialogue: 0,0:04:26.51,0:04:27.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.22,0:04:29.85,Default,,0,0,0,,Менің Тейгуым күткендей.
Dialogue: 0,0:04:31.47,0:04:33.02,Default,,0,0,0,,Мен Куромені жеңе алсам...
Dialogue: 0,0:04:33.39,0:04:35.35,Default,,0,0,0,,Бұл жолы мен мерген боламын!
Dialogue: 0,0:04:36.10,0:04:37.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:39.27,0:04:40.44,Default,,0,0,0,,Nnnnn… (тесетін дыбыс)
Dialogue: 0,0:04:43.49,0:04:45.66,Default,,0,0,0,,Сіз қару қолданушысыз... сіз онша жақсы емессіз!
Dialogue: 0,0:04:47.53,0:04:49.83,Default,,0,0,0,,(Маймыл адамның үруі)
Dialogue: 0,0:04:50.95,0:04:55.37,Default,,0,0,0,,Бұл қауіпті түрдің мәйіті ме? Бұл мен бұрын көрмеген жігіттің түрі.
Dialogue: 0,0:04:55.54,0:04:57.58,Default,,0,0,0,,(Тацумидің күш дауысы)
Dialogue: 0,0:04:57.96,0:04:59.46,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:00.00,0:05:00.67,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:03.05,0:05:04.34,Default,,0,0,0,,Жаңадан келген!
Dialogue: 0,0:05:08.30,0:05:09.55,Default,,0,0,0,,Миджуку Джукуджуку…
Dialogue: 0,0:05:09.72,0:05:10.85,Default,,0,0,0,,(Дыбыс тиетін дулыға)
Dialogue: 0,0:05:11.72,0:05:12.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:13.77,0:05:17.94,Default,,0,0,0,,Егер сауыт мені қорғамаса, маған шабуыл жасалар еді. Не? Бұл жігіт
Dialogue: 0,0:05:18.06,0:05:20.06,Default,,0,0,0,,Шиппай пирогы…
Dialogue: 0,0:05:20.32,0:05:21.86,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:05:22.03,0:05:24.82,Default,,0,0,0,,Бұл жалын қауіпті. Оны көм!
Dialogue: 0,0:05:25.15,0:05:27.24,Default,,0,0,0,,Тура келе жатыр...
Dialogue: 0,0:05:27.41,0:05:28.57,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:05:29.74,0:05:30.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:31.66,0:05:32.83,Default,,0,0,0,,Хаа! (кесілген дыбыс)
Dialogue: 0,0:05:35.62,0:05:39.33,Default,,0,0,0,,Мурасаме мәйіт қуыршақпен сөйлесе алмайды!
Dialogue: 0,0:05:39.50,0:05:40.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:42.34,0:05:43.63,Default,,0,0,0,,Аке! (ұшқан дыбыс)
Dialogue: 0,0:05:44.30,0:05:45.72,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:05:49.72,0:05:51.10,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:05:55.48,0:05:58.94,Default,,0,0,0,,Қария, сен істедің...
Dialogue: 0,0:06:02.07,0:06:03.78,Default,,0,0,0,,Мен мұндай шабуылды көре алмаймын ...
Dialogue: 0,0:06:05.53,0:06:06.69,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,0:06:06.86,0:06:07.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:07.95,0:06:10.66,Default,,0,0,0,,Менің динамикалық көру өткірлігім трансформацияға төтеп бере алмайды.
Dialogue: 0,0:06:10.78,0:06:12.66,Default,,0,0,0,,Мен Teigu қолданбасам да.
Dialogue: 0,0:06:13.08,0:06:14.24,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:06:14.70,0:06:18.75,Default,,0,0,0,,Уау, бұл үлкен шайқас. Бұл қызық!
Dialogue: 0,0:06:19.17,0:06:20.00,Default,,0,0,0,,Куроме…
Dialogue: 0,0:06:20.17,0:06:23.59,Default,,0,0,0,,Сәлем, жарай ма? менің ойыншықтарым
Dialogue: 0,0:06:24.38,0:06:27.72,Default,,0,0,0,,Доя – солтүстіктен келген жат нәсіл жіберген қастандық.
Dialogue: 0,0:06:28.42,0:06:32.01,Default,,0,0,0,,Сіздің сенімді тұлғаңыз әлі де жүзіңізден көрінеді.
Dialogue: 0,0:06:32.55,0:06:35.22,Default,,0,0,0,,Қабырға атақты күзетші болған...
Dialogue: 0,0:06:35.35,0:06:38.02,Default,,0,0,0,,Мен оны өлтірдім, өйткені ол өз нысанасын қорғады.
Dialogue: 0,0:06:38.52,0:06:42.65,Default,,0,0,0,,Apeman - бұл ми, бірақ оны пайдалану оңай, сондықтан мен оны әрқашан жақсы көрдім.
Dialogue: 0,0:06:43.23,0:06:46.11,Default,,0,0,0,,Хентер Ван тайпасынан аман қалған.
Dialogue: 0,0:06:46.23,0:06:50.53,Default,,0,0,0,,Қиын қозғалыстармен өлтіру үшін көп күш жұмсалған мақтаныш шедевр.
Dialogue: 0,0:06:51.03,0:06:53.62,Default,,0,0,0,,Рокуго — империя генералы.
Dialogue: 0,0:06:53.87,0:06:56.79,Default,,0,0,0,,Ол маған опасыздық жасап, көтерілісшілер әскеріне қосылмақ болды, сондықтан мені өлтірді.
Dialogue: 0,0:06:57.87,0:07:01.00,Default,,0,0,0,,Дестагул қысқы ұйқыда жатқан.
Dialogue: 0,0:07:01.12,0:07:02.29,Default,,0,0,0,,Сіз бақыттысыз!
Dialogue: 0,0:07:02.79,0:07:06.96,Default,,0,0,0,,Ал Натара менің кішкентай кезімізден досым.
Dialogue: 0,0:07:07.46,0:07:10.63,Default,,0,0,0,,Hachifusa іске қосылған кезде мені мұқият қорғаңыз
Dialogue: 0,0:07:11.22,0:07:15.97,Default,,0,0,0,,Шындығында тағы біреуі бар, бірақ оны ашу үшін тағы біраз күтуім керек.
Dialogue: 0,0:07:16.39,0:07:19.77,Default,,0,0,0,,Әлі келмеген адам бар ма?
Dialogue: 0,0:07:20.85,0:07:21.89,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,0:07:22.19,0:07:23.35,Default,,0,0,0,,Боқ...
Dialogue: 0,0:07:23.52,0:07:25.69,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:07:25.86,0:07:29.03,Default,,0,0,0,,Не? Бұл пайдасыз. Бұл қуыршақ.
Dialogue: 0,0:07:29.57,0:07:34.66,Default,,0,0,0,,Жүрегімді тесіп өтсең де, Мені жеңбегенше қозғала береді.
Dialogue: 0,0:07:34.82,0:07:35.87,Default,,0,0,0,,(Нәрсені қатты жерге ұрған дыбыс)
Dialogue: 0,0:07:36.03,0:07:37.87,Default,,0,0,0,,Гррр... Ааа...
Dialogue: 0,0:07:40.87,0:07:43.58,Default,,0,0,0,,Сен шынымен мықтысың, жігітім.
Dialogue: 0,0:07:43.96,0:07:45.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:46.79,0:07:48.71,Default,,0,0,0,,Күткендей, мен үйреніп қалдым.
Dialogue: 0,0:07:48.84,0:07:51.42,Default,,0,0,0,,Бір техника мәңгі жұмыс істейді деп ойламаңыз!
Dialogue: 0,0:07:51.55,0:07:53.13,Default,,0,0,0,,Жіберме, Леоне!
Dialogue: 0,0:07:54.05,0:07:55.34,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:07:56.18,0:07:57.35,Default,,0,0,0,,Жалпы Рокуго
Dialogue: 0,0:07:58.89,0:08:04.10,Default,,0,0,0,,Бұрынғы әріптес ретінде мен сізді сиқырдан тезірек босатамын.
Dialogue: 0,0:08:04.60,0:08:07.86,Default,,0,0,0,,Бо... Бастықтың төбелескенін көрмегелі біраз болды.
Dialogue: 0,0:08:08.61,0:08:10.03,Default,,0,0,0,,Жарайды, мен де...
Dialogue: 0,0:08:10.19,0:08:11.32,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:08:12.65,0:08:13.49,Default,,0,0,0,,Ах…
Dialogue: 0,0:08:14.45,0:08:15.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:16.20,0:08:18.20,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу мына жерде мына жерде мына жерде мынау мына жерде.
Dialogue: 0,0:08:18.33,0:08:21.95,Default,,0,0,0,,Жоқ, көзіңді менен мүлдем ала алмайсың.
Dialogue: 0,0:08:22.71,0:08:25.29,Default,,0,0,0,,Егер ашылатын болса, мен бар күшімді саламын.
Dialogue: 0,0:08:25.75,0:08:28.96,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:08:29.63,0:08:32.09,Default,,0,0,0,,Мүмкіндік болса, мен оны орнатамын...
Dialogue: 0,0:08:33.84,0:08:36.43,Default,,0,0,0,,Бұл жерде де солай.
Dialogue: 0,0:08:37.55,0:08:41.35,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:08:41.97,0:08:45.10,Default,,0,0,0,,Уау, қан кетуді өз бетіңізше тоқтата алатыныңыз ғажап.
Dialogue: 0,0:08:48.81,0:08:53.19,Default,,0,0,0,,Мен саған арыстанды ашуландырсаң не болатынын көрсетемін!
Dialogue: 0,0:08:53.53,0:08:54.95,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:08:55.91,0:08:57.28,Default,,0,0,0,,Асықпа, Леоне.
Dialogue: 0,0:08:58.07,0:09:02.29,Default,,0,0,0,,Куроменің де оққағары бар, сондықтан алдымен Акамеге көмекке барыңыз.
Dialogue: 0,0:09:02.79,0:09:05.08,Default,,0,0,0,,Осыдан кейін екеуің Куромені жеңулерің керек.
Dialogue: 0,0:09:05.41,0:09:07.46,Default,,0,0,0,,Бұл бұрынғы генералдар.
Dialogue: 0,0:09:07.58,0:09:10.71,Default,,0,0,0,,Егер қарсыласта Тейгу болмаса, мен оған бірдеңе істеймін.
Dialogue: 0,0:09:11.71,0:09:12.92,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:09:14.51,0:09:17.76,Default,,0,0,0,,Күте тұрыңыз, мен сонда барамын.
Dialogue: 0,0:09:18.76,0:09:22.64,Default,,0,0,0,,Оны коллекцияңыз үшін қажет болуы мүмкін
Dialogue: 0,0:09:28.52,0:09:32.11,Default,,0,0,0,,Қуып жететін уақыт шығар, бірақ біртүрлі.
Dialogue: 0,0:09:32.65,0:09:34.99,Default,,0,0,0,,Бұл біраз оғаш.
Dialogue: 0,0:09:35.11,0:09:38.32,Default,,0,0,0,,Бұл жалған, ал шынайысы Куроме және басқалары болуы мүмкін.
Dialogue: 0,0:09:40.78,0:09:43.41,Default,,0,0,0,,(Ерлердің күлкісі)
Dialogue: 0,0:09:44.41,0:09:49.38,Default,,0,0,0,,Бұл жерді өз территориясы деп атайтын ұрылар тобы ма? Бұл кездейсоқтық емес сияқты.
Dialogue: 0,0:09:49.63,0:09:51.84,Default,,0,0,0,,Мен ақпарат бойынша келдім.
Dialogue: 0,0:09:52.00,0:09:54.30,Default,,0,0,0,,Бұл генерал Эсдеат (Ер адам) Мен шыдай алмаймын!
Dialogue: 0,0:09:54.63,0:09:57.30,Default,,0,0,0,,Түнгі рейд және гуру?
Dialogue: 0,0:09:57.43,0:09:59.43,Default,,0,0,0,,Серю жүгірді
Dialogue: 0,0:10:00.09,0:10:04.81,Default,,0,0,0,,Біз сені басып аламыз. Екі-үш адамды қозғалыссыз қалдырыңыз.
Dialogue: 0,0:10:06.31,0:10:07.85,Default,,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:10:10.86,0:10:13.32,Default,,0,0,0,,Қарғыс атсын... Оған абайсызда секірме.
Dialogue: 0,0:10:13.57,0:10:14.98,Default,,0,0,0,,Бірақ... аа...
Dialogue: 0,0:10:15.15,0:10:16.99,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:18.82,0:10:22.41,Default,,0,0,0,,Қозғалыңыз, осы жерден саңылау іздеңіз.
Dialogue: 0,0:10:22.53,0:10:25.12,Default,,0,0,0,,Олай болса, мен сізге есік ашамын!
Dialogue: 0,0:10:26.37,0:10:27.37,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:10:29.79,0:10:30.92,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:10:36.76,0:10:39.97,Default,,0,0,0,,Мұндай жерлерде де қорғаныс құралдары, мүмкін Мурасамеге қарсы шара ретінде?
Dialogue: 0,0:10:41.30,0:10:42.89,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:10:43.05,0:10:44.89,Default,,0,0,0,,Әй, бұл керемет жалтару болды!
Dialogue: 0,0:10:45.72,0:10:46.77,Default,,0,0,0,,Ннн…
Dialogue: 0,0:10:50.56,0:10:52.06,Default,,0,0,0,,Бір ғана нәрсе... Иә?
Dialogue: 0,0:10:52.52,0:10:53.98,Default,,0,0,0,,Сұрауға бола ма?
Dialogue: 0,0:10:54.73,0:10:58.65,Default,,0,0,0,,Неліктен Акаме-чан көтерілісшілер әскеріне қосылды?
Dialogue: 0,0:10:59.70,0:11:03.16,Default,,0,0,0,,Егер біз сенің жаныңда қалсақ, сендірер едік...
Dialogue: 0,0:11:15.63,0:11:16.38,Default,,0,0,0,,(кеуде соғу дыбысы)
Dialogue: 0,0:11:16.50,0:11:20.47,Default,,0,0,0,,Себебі жүрегім сені дұрыс деп шешті.
Dialogue: 0,0:11:20.88,0:11:23.05,Default,,0,0,0,,Мен сенген жолмен жүргенше!
Dialogue: 0,0:11:24.30,0:11:27.60,Default,,0,0,0,,Бұл түсінікті жауап. рахмет.
Dialogue: 0,0:11:28.56,0:11:31.73,Default,,0,0,0,,Бірақ сол сенімнің барлығын өртеу...
Dialogue: 0,0:11:32.23,0:11:34.02,Default,,0,0,0,,Менің жұмысым!
Dialogue: 0,0:11:37.57,0:11:40.40,Default,,0,0,0,,Мені де қос, демек 2-ден 2-ге тең.
Dialogue: 0,0:11:40.74,0:11:42.03,Default,,0,0,0,,Әй, Леоне!
Dialogue: 0,0:11:42.32,0:11:46.70,Default,,0,0,0,,Ал, бұл туралы уайымдамаңыз, қазір шайқасқа назар аударыңыз.
Dialogue: 0,0:11:47.20,0:11:48.95,Default,,0,0,0,,Бұл күшті, абай болыңыз.
Dialogue: 0,0:11:49.08,0:11:52.96,Default,,0,0,0,,А, Болсты жеңіп, Куромеге барайық.
Dialogue: 0,0:11:55.25,0:11:57.21,Default,,0,0,0,,Эсдеат алған жарақатқа байланысты...
Dialogue: 0,0:11:57.34,0:12:01.26,Default,,0,0,0,,Ағымдағы жағдай: Менің күшім 40%-ға төмендеді...
Dialogue: 0,0:12:02.05,0:12:02.97,Default,,0,0,0,,(Нәрсені қатты жерге ұрған дыбыс)
Dialogue: 0,0:12:03.30,0:12:04.72,Default,,0,0,0,,Сіз ойлағаннан да көп қозғала аласыз!
Dialogue: 0,0:12:10.10,0:12:11.23,Default,,0,0,0,,Жер сілкінісі!
Dialogue: 0,0:12:13.39,0:12:15.23,Default,,0,0,0,,А... (ату дыбысы)
Dialogue: 0,0:12:18.15,0:12:22.57,Default,,0,0,0,,Мен сіздің техникаңызды жаттығу арқылы білемін.
Dialogue: 0,0:12:25.49,0:12:26.82,Default,,0,0,0,,Ролик шабуылы! (қосу дыбысы)
Dialogue: 0,0:12:26.99,0:12:28.03,Default,,0,0,0,,(орам сымының дыбысы)
Dialogue: 0,0:12:28.20,0:12:29.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:30.29,0:12:31.41,Default,,0,0,0,,(Тепкен дыбыс)
Dialogue: 0,0:12:35.58,0:12:37.71,Default,,0,0,0,,Наже, ішіп алайық.
Dialogue: 0,0:12:39.46,0:12:40.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.17,0:12:42.72,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:47.34,0:12:50.81,Default,,0,0,0,,Не... Тейгу жұртты балағаттау үшін қаншаға барады!
Dialogue: 0,0:12:50.97,0:12:51.97,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:12:56.69,0:12:58.48,Default,,0,0,0,,Аа... Ах!
Dialogue: 0,0:12:58.65,0:12:59.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:00.65,0:13:02.99,Default,,0,0,0,,(Дестагулдың ырылдауы)
Dialogue: 0,0:13:09.03,0:13:10.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.87,0:13:13.83,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:13:13.95,0:13:15.37,Default,,0,0,0,,(булану дыбысы)
Dialogue: 0,0:13:18.96,0:13:23.01,Default,,0,0,0,,Екеуміз де қыңырмыз.
Dialogue: 0,0:13:24.09,0:13:27.09,Default,,0,0,0,,Шірік болса да, бұл супер класс. Бұл әлі де қорқынышты ма?
Dialogue: 0,0:13:27.22,0:13:29.97,Default,,0,0,0,,Бұл да дұрыс, бірақ Наджендаға қараңыз.
Dialogue: 0,0:13:30.10,0:13:30.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.56,0:13:35.64,Default,,0,0,0,,Мен сол жақтағы шығыңқылыққа қатты алаңдаймын.
Dialogue: 0,0:13:36.35,0:13:38.65,Default,,0,0,0,,Бұл жерде асимметриялық.
Dialogue: 0,0:13:39.48,0:13:42.82,Default,,0,0,0,,Мен уайымдадым, бірақ маған дәл қазір шабуыл жасалды.
Dialogue: 0,0:13:42.94,0:13:47.32,Default,,0,0,0,,Сіз соншалықты керемет болуға тырысасыз, бірақ ол нәтиже бермеуі мүмкін.
Dialogue: 0,0:13:47.99,0:13:51.58,Default,,0,0,0,,Бірақ жақын арада біреу Куромеге жетуі керек.
Dialogue: 0,0:13:51.70,0:13:53.41,Default,,0,0,0,,Зақым тек қана болады.
Dialogue: 0,0:13:54.12,0:13:57.67,Default,,0,0,0,,Сусано-о шебері ретінде құпия қозғалысты пайдалануға рұқсат етіңіз.
Dialogue: 0,0:13:58.58,0:14:00.17,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:14:00.71,0:14:03.09,Default,,0,0,0,,Какакака Какакака…
Dialogue: 0,0:14:03.50,0:14:06.09,Default,,0,0,0,,Қарғыс атсын... бұл жігіттердің координациясы қорқынышты!
Dialogue: 0,0:14:06.22,0:14:08.34,Default,,0,0,0,,Егер шабуылдың біреуі де аздап тоқтаса...
Dialogue: 0,0:14:08.51,0:14:10.64,Default,,0,0,0,,Ннн!
Dialogue: 0,0:14:10.80,0:14:12.35,Default,,0,0,0,,Ннн... (Маймыл адам ырылдады)
Dialogue: 0,0:14:12.47,0:14:13.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:15.72,0:14:16.81,Default,,0,0,0,,Кака…
Dialogue: 0,0:14:17.23,0:14:17.89,Default,,0,0,0,,Хе-хе… Уф
Dialogue: 0,0:14:19.44,0:14:22.23,Default,,0,0,0,,Ух... Ах... Жоқ...
Dialogue: 0,0:14:24.69,0:14:25.44,Default,,0,0,0,,На…
Dialogue: 0,0:14:26.82,0:14:28.90,Default,,0,0,0,,Ішінде… Ма…
Dialogue: 0,0:14:33.28,0:14:34.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:34.41,0:14:36.33,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:14:36.45,0:14:38.46,Default,,0,0,0,,Акаме дұрыс айтады.
Dialogue: 0,0:14:39.33,0:14:43.59,Default,,0,0,0,,Яфуса басқарған мәйіттердің еркі жоқ, бірақ...
Dialogue: 0,0:14:43.71,0:14:47.09,Default,,0,0,0,,Бойыма сіңген әдеттер мен күшті ойлар қалады.
Dialogue: 0,0:14:48.01,0:14:50.59,Default,,0,0,0,,Өкінішке орай, мен жойылдым -
Dialogue: 0,0:14:50.72,0:14:52.93,Default,,0,0,0,,Мен сенің жерлесің емеспін.
Dialogue: 0,0:14:53.10,0:14:55.18,Default,,0,0,0,,Шыу!
Dialogue: 0,0:14:55.31,0:14:56.47,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:14:59.02,0:15:00.52,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:15:00.64,0:15:03.31,Default,,0,0,0,,Жақсы, ол енді жұмыс істемейді.
Dialogue: 0,0:15:03.86,0:15:05.52,Default,,0,0,0,,Көмегің үшін рахмет, Челси.
Dialogue: 0,0:15:05.65,0:15:08.44,Default,,0,0,0,,А, мен бұл маймылды саған қалдырамын, Тацуми.
Dialogue: 0,0:15:08.57,0:15:09.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.40,0:15:11.20,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:15:11.74,0:15:14.83,Default,,0,0,0,,Бұл мен үшін батыл стратегия болды.
Dialogue: 0,0:15:14.95,0:15:19.04,Default,,0,0,0,,Шееле мен Блартқа қатысты, енді олар өлтіруші ретінде дисквалификацияланды деп айту мүмкін болмайды.
Dialogue: 0,0:15:19.66,0:15:21.87,Default,,0,0,0,,Сізді осылай сезіндірген кінәліге —
Dialogue: 0,0:15:22.00,0:15:24.92,Default,,0,0,0,,Мен кейінірек жауапкершілікті алуым керек.
Dialogue: 0,0:15:27.09,0:15:30.09,Default,,0,0,0,,Егер сіз жалғыз болсаңыз, сіз әлдеқашан бас тартқан боларсыз.
Dialogue: 0,0:15:30.63,0:15:33.22,Default,,0,0,0,,Олар көптеген өлген адамдарды ойыншық ретінде пайдаланды...
Dialogue: 0,0:15:33.84,0:15:35.97,Default,,0,0,0,,Бұл жексұрын Тейгу!
Dialogue: 0,0:15:37.06,0:15:38.68,Default,,0,0,0,,Қазір ұйықта!
Dialogue: 0,0:15:38.85,0:15:41.02,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:15:42.65,0:15:43.81,Default,,0,0,0,,Ннн! (соққы дыбысы)
Dialogue: 0,0:15:47.57,0:15:48.82,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:15:48.94,0:15:52.91,Default,,0,0,0,,Соңғы кездері тәтті тағамдар арасындағы аралық қысқарды.
Dialogue: 0,0:15:55.99,0:15:58.62,Default,,0,0,0,,Амансың ба? толқын
Dialogue: 0,0:15:59.91,0:16:03.29,Default,,0,0,0,,Сенің тірі екенің рас...
Dialogue: 0,0:16:05.13,0:16:06.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:06.21,0:16:10.09,Default,,0,0,0,,Рокуго мен Хентер қозғалмайды, Апемен де қозғалмайды.
Dialogue: 0,0:16:11.09,0:16:12.55,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:16:12.88,0:16:17.81,Default,,0,0,0,,8-ші жақын арада қозғалатын шығар, сондықтан мен оны қайта реттеймін.
Dialogue: 0,0:16:18.06,0:16:20.18,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:16:21.06,0:16:23.14,Default,,0,0,0,,Қандай соққы!
Dialogue: 0,0:16:23.35,0:16:26.77,Default,,0,0,0,,Егер мен оны Гранчарионың қылышымен жауып тастамағанымда, мен бірден өліп кетер едім.
Dialogue: 0,0:16:27.56,0:16:31.07,Default,,0,0,0,,Асықпасақ, Болс мырза мен Куроме...
Dialogue: 0,0:16:31.61,0:16:33.03,Default,,0,0,0,,Ол күшті, бірақ...
Dialogue: 0,0:16:33.32,0:16:36.99,Default,,0,0,0,,Бұл жерде табиғи және ақымақтық бар.
Dialogue: 0,0:16:38.03,0:16:39.66,Default,,0,0,0,,Артыңнан жүруім керек... Ахх...
Dialogue: 0,0:16:39.79,0:16:40.83,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:16:41.33,0:16:46.29,Default,,0,0,0,,Қарғыс атсын... қанша ұшты? мен
Dialogue: 0,0:16:46.46,0:16:48.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:50.13,0:16:54.30,Default,,0,0,0,,Ол өте жақсы болды, бірақ оның қарсыласы нашар болды.
Dialogue: 0,0:16:54.88,0:16:57.18,Default,,0,0,0,,Мен атыс данышпанмын.
Dialogue: 0,0:17:00.22,0:17:00.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.14,0:17:04.14,Default,,0,0,0,,Уау! Не... не? Бұл жігіт
Dialogue: 0,0:17:04.27,0:17:06.98,Default,,0,0,0,,А... не, саған шабуыл жасалып жатыр ма?
Dialogue: 0,0:17:07.48,0:17:09.98,Default,,0,0,0,,Бұл жаңа Кайзер бақа.
Dialogue: 0,0:17:10.11,0:17:13.99,Default,,0,0,0,,Асқазанындағы ерітіндімен кез келген нәрсені еріте алатын қауіпті бақа.
Dialogue: 0,0:17:14.11,0:17:15.20,Default,,0,0,0,,Уф... тоқта...
Dialogue: 0,0:17:15.61,0:17:17.28,Default,,0,0,0,,Мен Серюуден естідім...
Dialogue: 0,0:17:17.66,0:17:20.45,Default,,0,0,0,,Сіздің серіктесіңіз Коро сізді жеді ме?
Dialogue: 0,0:17:20.58,0:17:21.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.79,0:17:24.58,Default,,0,0,0,,Сонымен, бұл сәйкестік аяқталуы.
Dialogue: 0,0:17:24.79,0:17:27.83,Default,,0,0,0,,Ннн... мынау... осындай жерде...
Dialogue: 0,0:17:28.17,0:17:31.21,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:17:31.34,0:17:32.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:33.21,0:17:36.05,Default,,0,0,0,,Соңы тез.
Dialogue: 0,0:17:36.30,0:17:38.22,Default,,0,0,0,,Қош бол, хехе...
Dialogue: 0,0:17:38.80,0:17:40.97,Default,,0,0,0,,Енді осыны жалғастырайық, бәріміз...
Dialogue: 0,0:17:41.10,0:17:41.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.18,0:17:43.72,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:17:44.06,0:17:48.40,Default,,0,0,0,,Акаменің әпкесі болғандықтан мен саған шыдамаймын Куроме!
Dialogue: 0,0:17:48.73,0:17:50.90,Default,,0,0,0,,А... Мен мұны істеймін деп ойлаймын.
Dialogue: 0,0:17:51.27,0:17:55.61,Default,,0,0,0,,Бірақ Натала сол маймылдан он есе күшті.
Dialogue: 0,0:17:58.41,0:18:00.12,Default,,0,0,0,,Жаман жанның көрінісі
Dialogue: 0,0:18:00.28,0:18:01.28,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:18:01.74,0:18:04.12,Default,,0,0,0,,Сюзаноның жасырын әрекеті – ессіздік.
Dialogue: 0,0:18:04.45,0:18:05.83,Default,,0,0,0,,Менің жүрегімдегі зұлым рухтан
Dialogue: 0,0:18:05.95,0:18:11.04,Default,,0,0,0,,Шебер ретінде менің өмірлік күшімді сіңіріп, сол күшті көрсетіңіз.
Dialogue: 0,0:18:12.46,0:18:16.97,Default,,0,0,0,,Үш рет пайдалансаң, оның орнына қожайынның өлуі сөзсіз...
Dialogue: 0,0:18:19.30,0:18:21.01,Default,,0,0,0,,Сіз алатын күш керемет!
Dialogue: 0,0:18:27.06,0:18:28.23,Default,,0,0,0,,Ята Кагами!
Dialogue: 0,0:18:28.39,0:18:29.14,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:18:32.61,0:18:33.32,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:18:33.57,0:18:35.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:35.78,0:18:38.07,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:47.45,0:18:49.21,Default,,0,0,0,,Он Муракумо қылыш!
Dialogue: 0,0:18:49.37,0:18:50.54,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:53.88,0:18:55.55,Default,,0,0,0,,(Қылыштардың соқтығысуы)
Dialogue: 0,0:18:55.75,0:18:56.84,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:18:56.96,0:19:01.76,Default,,0,0,0,,Тіпті мен Incursio киіп жүрсем де! Жоқ, одан да көп!
Dialogue: 0,0:19:02.18,0:19:04.22,Default,,0,0,0,,Ухухуху...
Dialogue: 0,0:19:04.56,0:19:06.27,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:19:06.39,0:19:09.60,Default,,0,0,0,,А... не болды?
Dialogue: 0,0:19:09.77,0:19:10.81,Default,,0,0,0,,Жақсы… Жақсы…
Dialogue: 0,0:19:10.94,0:19:12.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.65,0:19:14.52,Default,,0,0,0,,Іштен шабуыл
Dialogue: 0,0:19:14.65,0:19:17.61,Default,,0,0,0,,Бірақ асқазанда күшті еріткіш сұйықтық бар...
Dialogue: 0,0:19:18.28,0:19:19.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:19.78,0:19:21.53,Default,,0,0,0,,Ағып жатыр
Dialogue: 0,0:19:22.07,0:19:24.20,Default,,0,0,0,,Мұның мағынасы жоқ.
Dialogue: 0,0:19:24.66,0:19:25.58,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:19:29.71,0:19:31.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:32.00,0:19:34.29,Default,,0,0,0,,Ннн… Ннн…
Dialogue: 0,0:19:38.92,0:19:41.18,Default,,0,0,0,,Бұл ең нашар тәжірибе болды.
Dialogue: 0,0:19:41.68,0:19:43.93,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:19:44.05,0:19:47.39,Default,,0,0,0,,Бұл қиын болды! Өтінемін, мені толығымен қолдаңыз
Dialogue: 0,0:19:47.51,0:19:49.68,Default,,0,0,0,,Дұрысы, маған қарама, бұзық!
Dialogue: 0,0:19:49.81,0:19:51.44,Default,,0,0,0,,...Бұл өте қисынсыз!
Dialogue: 0,0:19:51.56,0:19:53.94,Default,,0,0,0,,Екеуің де қалдырыңдар.
Dialogue: 0,0:19:54.40,0:19:56.40,Default,,0,0,0,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:19:56.57,0:19:57.82,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:19:58.19,0:20:00.40,Default,,0,0,0,,Не? Сью-сан, жақсы!
Dialogue: 0,0:20:01.03,0:20:04.16,Default,,0,0,0,,Қанша адам өлетінін айттыңыз ба?
Dialogue: 0,0:20:04.28,0:20:06.70,Default,,0,0,0,,Бұл Куроменің жауабы
Dialogue: 0,0:20:08.37,0:20:11.33,Default,,0,0,0,,Мен түсіндім, сонда...
Dialogue: 0,0:20:12.46,0:20:15.04,Default,,0,0,0,,Енді осы жерде барлығын өлтіріңіз -
Dialogue: 0,0:20:15.17,0:20:18.55,Default,,0,0,0,,Мен сенен жаңа қуыршақ болуды сұрауым керек пе?
Dialogue: 0,0:20:21.34,0:20:22.42,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:20:24.55,0:20:25.76,Default,,0,0,0,,Кеттік! О
Dialogue: 0,0:20:29.22,0:20:32.14,Default,,0,0,0,,Әй, ауада қашып құтылу мүмкін емес!
Dialogue: 0,0:20:34.23,0:20:36.90,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:20:37.40,0:20:38.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.02,0:20:41.15,Default,,0,0,0,,Егер сізге бәрібір күзетшілер кедергі келтірсе...
Dialogue: 0,0:20:41.90,0:20:45.57,Default,,0,0,0,,Ұзын ату болса да, оларды алдауға тырысыңыз және алдымен эскортты көздеңіз!
Dialogue: 0,0:20:45.74,0:20:46.78,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:20:48.16,0:20:49.45,Default,,0,0,0,,Уолл мырза!
Dialogue: 0,0:20:51.54,0:20:53.37,Default,,0,0,0,,Ақаме тым алаңдап қалды
Dialogue: 0,0:20:53.50,0:20:55.79,Default,,0,0,0,,Күзетшілер енді өз билігін пайдалана алмайды.
Dialogue: 0,0:20:56.08,0:20:57.25,Default,,0,0,0,,Мен оны өлтірдім!
Dialogue: 0,0:20:57.58,0:20:58.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:02.30,0:21:03.42,Default,,0,0,0,,Бұл дайындық мори ме?
Dialogue: 0,0:21:04.22,0:21:04.97,Default,,0,0,0,,Менің қолым...
Dialogue: 0,0:21:09.47,0:21:11.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:11.93,0:21:13.14,Default,,0,0,0,,(жырту дыбысы)
Dialogue: 0,0:21:14.14,0:21:14.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:18.02,0:21:18.86,Default,,0,0,0,,Поо!
Dialogue: 0,0:21:18.98,0:21:20.73,Default,,0,0,0,,Мен оны жей алмаймын.
Dialogue: 0,0:21:22.28,0:21:24.44,Default,,0,0,0,,Тейгуды жұлып алу үшін...
Dialogue: 0,0:21:24.61,0:21:25.61,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:21:27.66,0:21:28.70,Default,,0,0,0,,Уолл мырза!
Dialogue: 0,0:21:28.82,0:21:30.28,Default,,0,0,0,,Енді Тейгу-
Dialogue: 0,0:21:30.41,0:21:32.16,Default,,0,0,0,,Бұл пайдасыз емес пе?
Dialogue: 0,0:21:33.00,0:21:35.08,Default,,0,0,0,,Бұл сөзсіз нашарлады.
Dialogue: 0,0:21:35.62,0:21:36.75,Default,,0,0,0,,Ийда…
Dialogue: 0,0:21:37.37,0:21:38.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:42.30,0:21:43.80,Default,,0,0,0,,Жою
Dialogue: 0,0:21:45.72,0:21:46.80,Default,,0,0,0,,Әй, болмайды...
Dialogue: 0,0:21:47.97,0:21:48.64,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:21:50.80,0:21:53.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:56.48,0:22:02.48,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:19.89,0:23:25.90,Default,,0,0,0,,〜♪
