Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.84,0:00:14.51,Default,,0,0,0,,Тацуми әлсіз болғандықтан өлді, болды.
Dialogue: 0,0:00:15.80,0:00:18.76,Default,,0,0,0,,Бірақ... не? бұл сезім
Dialogue: 0,0:00:21.64,0:00:22.56,Default,,0,0,0,,Бұл генерал Эсдеат!
Dialogue: 0,0:00:22.68,0:00:24.81,Default,,0,0,0,,Ол жалғыз қалды. Оны ұстаңыз!
Dialogue: 0,0:00:24.98,0:00:27.11,Default,,0,0,0,,Сондай әлсіреген ел...
Dialogue: 0,0:00:28.86,0:00:29.52,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:00:30.65,0:00:32.40,Default,,0,0,0,,Мен оны өшіремін!
Dialogue: 0,0:00:32.57,0:00:34.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:42.00,0:00:43.75,Default,,0,0,0,,Хаха... Ах!
Dialogue: 0,0:00:49.21,0:00:52.46,Default,,0,0,0,,Акаме, бұл сіздің жоғалтыңыз.
Dialogue: 0,0:00:52.63,0:00:57.84,Default,,0,0,0,,Империя жеңілді, бірақ менің аң аулауым жалғасуда.
Dialogue: 0,0:00:58.01,0:01:01.22,Default,,0,0,0,,Аң аулау? Соғыс аяқталды.
Dialogue: 0,0:01:01.39,0:01:03.98,Default,,0,0,0,,Басқа ұрыс алаңын іздеу
Dialogue: 0,0:01:04.64,0:01:06.35,Default,,0,0,0,,Егер жоқ болса, ол өндірілгенге дейін
Dialogue: 0,0:01:06.94,0:01:09.65,Default,,0,0,0,,Бейбіт болғалы тұрған әлемде —
Dialogue: 0,0:01:09.77,0:01:13.36,Default,,0,0,0,,Мен сені тірідей қалдыра алмаймын.
Dialogue: 0,0:01:13.53,0:01:17.16,Default,,0,0,0,,Менен бас тартқыңыз келсе, онда...
Dialogue: 0,0:01:17.32,0:01:19.16,Default,,0,0,0,,Өз күшіңізді көрсетіңіз
Dialogue: 0,0:01:21.33,0:01:25.50,Default,,0,0,0,,Есдеат... Ақыр аяғында менің жолыма тосқауыл болатын сенсің.
Dialogue: 0,0:01:27.08,0:01:29.25,Default,,0,0,0,,Акаме Эсдеатты өлтіріңіз!
Dialogue: 0,0:01:30.71,0:01:31.63,Default,,0,0,0,,Жерлеу!
Dialogue: 0,0:01:31.80,0:01:33.05,Default,,0,0,0,,Толып кетті!
Dialogue: 0,0:01:38.09,0:01:44.10,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:01.38,0:03:07.39,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:16.40,0:03:17.32,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:03:17.48,0:03:18.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:21.57,0:03:22.32,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:03:23.16,0:03:24.82,Default,,0,0,0,,Хаа!
Dialogue: 0,0:03:26.70,0:03:27.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:30.91,0:03:31.96,Default,,0,0,0,,Мұздату
Dialogue: 0,0:03:34.38,0:03:35.04,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:03:48.31,0:03:49.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:53.10,0:03:53.77,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:56.56,0:04:00.90,Default,,0,0,0,,Атышулы Акамеден күткендей, бұл тамаша.
Dialogue: 0,0:04:01.03,0:04:02.20,Default,,0,0,0,,Эсдеат
Dialogue: 0,0:04:02.70,0:04:07.95,Default,,0,0,0,,Жау жасап, оларды жеңе берсең не болады? Соңында не қалады?
Dialogue: 0,0:04:08.12,0:04:10.08,Default,,0,0,0,,Жеңімпаз қалады
Dialogue: 0,0:04:10.20,0:04:13.46,Default,,0,0,0,,Мәйіттің үстінде тұрған кісі өлтіруші.
Dialogue: 0,0:04:13.58,0:04:16.38,Default,,0,0,0,,Сен мені олай атасаң да бәрібір.
Dialogue: 0,0:04:16.88,0:04:21.01,Default,,0,0,0,,Өлгің келмесе, жаумен бетпе-бет келме, бағын.
Dialogue: 0,0:04:21.13,0:04:24.80,Default,,0,0,0,,Жоқ...олай алмағандар өледі.
Dialogue: 0,0:04:24.93,0:04:26.93,Default,,0,0,0,,Мына дүние осындай.
Dialogue: 0,0:04:27.10,0:04:28.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:28.85,0:04:33.39,Default,,0,0,0,,Барлығы өмір сүргісі келді Барлығы өмір сүргісі келді!
Dialogue: 0,0:04:39.65,0:04:42.82,Default,,0,0,0,,Өмір басқалар бұзатын нәрсе емес!
Dialogue: 0,0:04:42.99,0:04:46.53,Default,,0,0,0,,Шошқаның бос сөзін түсінбеймін дейсің!
Dialogue: 0,0:04:49.37,0:04:50.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:51.58,0:04:52.58,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:04:55.54,0:04:56.29,Default,,0,0,0,,Еніп алыңыз!
Dialogue: 0,0:05:02.01,0:05:03.63,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:05:05.68,0:05:06.68,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:05:06.84,0:05:08.34,Default,,0,0,0,,Хехе... (Саусақтардың сықырлаған дыбысы)
Dialogue: 0,0:05:10.89,0:05:11.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:12.31,0:05:13.18,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:05:19.77,0:05:20.94,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:05:21.07,0:05:22.40,Default,,0,0,0,,Ахх...
Dialogue: 0,0:05:23.94,0:05:26.49,Default,,0,0,0,,Не болды? Бұл солай ма?
Dialogue: 0,0:05:26.61,0:05:27.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:27.41,0:05:30.24,Default,,0,0,0,,Әлсіз болсаң, менің алдымда тұрма
Dialogue: 0,0:05:30.74,0:05:33.49,Default,,0,0,0,,Күш жоқ кезде армандама
Dialogue: 0,0:05:33.62,0:05:36.62,Default,,0,0,0,,Шошқа шошқадай иілу керек.
Dialogue: 0,0:05:36.79,0:05:39.75,Default,,0,0,0,,Адамдар қандай деп ойлайсың...
Dialogue: 0,0:05:39.92,0:05:42.21,Default,,0,0,0,,Әлсізге қызықпайды
Dialogue: 0,0:05:42.38,0:05:43.25,Default,,0,0,0,,Эсдеат!
Dialogue: 0,0:05:47.59,0:05:50.85,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:05:52.68,0:05:53.97,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:05:54.14,0:05:56.73,Default,,0,0,0,,Әй... ақыры байыптылығыңызды көрсеттіңіз бе?
Dialogue: 0,0:06:00.35,0:06:01.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:04.11,0:06:05.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:06.94,0:06:11.49,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:13.03,0:06:16.33,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:19.12,0:06:21.50,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:21.63,0:06:24.96,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:06:49.28,0:06:52.20,Default,,0,0,0,,О! Бұл сіздің жасырын қадамыңыз ба?
Dialogue: 0,0:06:52.82,0:06:55.70,Default,,0,0,0,,Мен көп адамды өлтірдім.
Dialogue: 0,0:06:55.83,0:07:00.62,Default,,0,0,0,,Қайғы, мұң, ашу, реніш
Dialogue: 0,0:07:00.96,0:07:02.79,Default,,0,0,0,,Мен алған өмір
Dialogue: 0,0:07:03.58,0:07:07.21,Default,,0,0,0,,Мұрасаме бәрі есіне түседі
Dialogue: 0,0:07:09.63,0:07:12.09,Default,,0,0,0,,Мен мұның бәрін қабылдаймын
Dialogue: 0,0:07:14.05,0:07:15.43,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:07:15.93,0:07:17.60,Default,,0,0,0,,Сіз біреуді тастап кеттіңіз бе?
Dialogue: 0,0:07:18.10,0:07:20.44,Default,,0,0,0,,Бұл жын семсерге лайық қулық.
Dialogue: 0,0:07:21.48,0:07:24.77,Default,,0,0,0,,Денем күйіп кетсе де, мен сені аламын...
Dialogue: 0,0:07:24.94,0:07:26.11,Default,,0,0,0,,Жеңіліс!
Dialogue: 0,0:07:28.53,0:07:30.74,Default,,0,0,0,,Ха! (ұстау дыбысы)
Dialogue: 0,0:07:34.12,0:07:35.45,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:07:41.79,0:07:43.12,Default,,0,0,0,,Бар!
Dialogue: 0,0:07:45.59,0:07:46.63,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:07:56.30,0:07:57.60,Default,,0,0,0,,Хаа!
Dialogue: 0,0:07:59.93,0:08:01.48,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:08:05.61,0:08:08.77,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:08.94,0:08:10.40,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:10.53,0:08:13.32,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:08:13.45,0:08:15.28,Default,,0,0,0,,Уф…
Dialogue: 0,0:08:15.41,0:08:16.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:20.41,0:08:25.29,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:08:25.46,0:08:27.46,Default,,0,0,0,,Уууу…
Dialogue: 0,0:08:27.63,0:08:28.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:29.09,0:08:29.84,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:08:31.96,0:08:36.39,Default,,0,0,0,,Хехехе... Қызық, қызық.
Dialogue: 0,0:08:36.93,0:08:40.18,Default,,0,0,0,,Қызық болғаны сонша, қол ұшын беруге тұрарлық.
Dialogue: 0,0:08:41.60,0:08:45.10,Default,,0,0,0,,Жасайық! Бір-бірімізді қанағат тұтқанша өлтірейік!
Dialogue: 0,0:08:49.11,0:08:50.94,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:08:52.65,0:08:53.99,Default,,0,0,0,,Уф…
Dialogue: 0,0:09:01.79,0:09:02.45,Default,,0,0,0,,Хаа!
Dialogue: 0,0:09:09.34,0:09:10.25,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:09:10.42,0:09:11.71,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:12.76,0:09:14.51,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:09:17.68,0:09:20.39,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:20.51,0:09:23.39,Default,,0,0,0,,Бұл пішін ұзаққа созылмайды...
Dialogue: 0,0:09:24.98,0:09:26.14,Default,,0,0,0,,Төменде –
Dialogue: 0,0:09:26.64,0:09:27.77,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:09:28.44,0:09:32.73,Default,,0,0,0,,Бар жүрегіммен жауап беремін, кел.
Dialogue: 0,0:09:52.46,0:09:53.34,Default,,0,0,0,,Хаа!
Dialogue: 0,0:09:53.50,0:09:54.17,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:58.76,0:10:00.01,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:00.18,0:10:02.05,Default,,0,0,0,,Махабачи Токума!
Dialogue: 0,0:10:06.81,0:10:10.31,Default,,0,0,0,,Сен мені екінші рет құпия амалдарыңды қолдануға мәжбүрледің.
Dialogue: 0,0:10:10.81,0:10:12.48,Default,,0,0,0,,Ал қарашы…
Dialogue: 0,0:10:12.65,0:10:14.32,Default,,0,0,0,,Көңілді болды.
Dialogue: 0,0:10:15.11,0:10:16.74,Default,,0,0,0,,А... Кейінгі кескін?
Dialogue: 0,0:10:21.07,0:10:22.53,Default,,0,0,0,,Қайда бардыңыз?
Dialogue: 0,0:10:25.41,0:10:27.20,Default,,0,0,0,,Жоғарыда! көм!
Dialogue: 0,0:10:35.21,0:10:36.42,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:10:36.55,0:10:40.51,Default,,0,0,0,,Неге... Махачи Токуманы жеңдіңіз?
Dialogue: 0,0:10:41.01,0:10:44.39,Default,,0,0,0,,Сюзанудың өмірін алып кеткен сіздің құпия қолыңыз
Dialogue: 0,0:10:45.06,0:10:47.89,Default,,0,0,0,,Мен оны пайдалану үшін қолайлы уақытты күттім.
Dialogue: 0,0:10:48.02,0:10:49.48,Default,,0,0,0,,Сонда сіз соған ұмтылдыңыз ба?
Dialogue: 0,0:10:49.64,0:10:53.19,Default,,0,0,0,,Сіз көрген кейінгі сурет адам өлтіру ниетінің массасы болды.
Dialogue: 0,0:10:53.61,0:10:56.11,Default,,0,0,0,,Мен сенің тәкаппарлығыңды пайдаланып аң ауладым.
Dialogue: 0,0:10:56.28,0:10:57.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:02.95,0:11:05.03,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:11:05.66,0:11:06.79,Default,,0,0,0,,Гаха…
Dialogue: 0,0:11:07.87,0:11:09.91,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:11:10.04,0:11:12.50,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:11:12.67,0:11:17.67,Default,,0,0,0,,Хахаха... Қызық екен. Бұл күш қайдан келді?
Dialogue: 0,0:11:17.80,0:11:20.13,Default,,0,0,0,,Тасыған нәрсенің салмағы
Dialogue: 0,0:11:20.97,0:11:23.51,Default,,0,0,0,,Бұл мені күшейтті
Dialogue: 0,0:11:23.64,0:11:28.56,Default,,0,0,0,,Өзгенің жаны сүйреп, өмір бойы осылай өмір сүресің бе?
Dialogue: 0,0:11:28.68,0:11:29.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:29.89,0:11:32.85,Default,,0,0,0,,А... Мен түсінбеймін.
Dialogue: 0,0:11:32.98,0:11:35.44,Default,,0,0,0,,Ал, жоғалту - шығын.
Dialogue: 0,0:11:35.56,0:11:37.40,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:37.53,0:11:40.95,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:11:47.20,0:11:49.12,Default,,0,0,0,,Сіз өлесіз бе?
Dialogue: 0,0:11:51.29,0:11:52.71,Default,,0,0,0,,Ха... Тацуми!
Dialogue: 0,0:11:53.96,0:11:55.17,Default,,0,0,0,,Эсдеат!
Dialogue: 0,0:12:04.01,0:12:05.30,Default,,0,0,0,,Тацуми
Dialogue: 0,0:12:05.43,0:12:09.64,Default,,0,0,0,,Қасымда болсаң ғой...
Dialogue: 0,0:12:15.52,0:12:17.61,Default,,0,0,0,,(Мұздың жарылған дыбысы)
Dialogue: 0,0:12:24.41,0:12:27.49,Default,,0,0,0,,Тацумиге деген бұл сезім...
Dialogue: 0,0:12:27.62,0:12:31.33,Default,,0,0,0,,Түсінбедім дедің.
Dialogue: 0,0:12:38.54,0:12:42.01,Default,,0,0,0,,Капитан... жатқан жерің жайлы...
Dialogue: 0,0:12:51.06,0:12:52.89,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:12:53.85,0:12:57.06,Default,,0,0,0,,Ең соңында ақылдылар жеңеді.
Dialogue: 0,0:12:57.19,0:13:02.23,Default,,0,0,0,,Менің өмірім қауіпсіз болғанша, мен қанша қаласам, сонша қайталай аламын!
Dialogue: 0,0:13:02.36,0:13:04.57,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:04.74,0:13:06.36,Default,,0,0,0,,Табылды
Dialogue: 0,0:13:06.49,0:13:09.78,Default,,0,0,0,,Сіз сияқты ең жаман қоқыстың түрі—
Dialogue: 0,0:13:09.95,0:13:11.20,Default,,0,0,0,,Мен сенің қашуыңа ешқашан жол бермеймін
Dialogue: 0,0:13:11.33,0:13:14.25,Default,,0,0,0,,Біреу! Біреу жоқ па?!
Dialogue: 0,0:13:14.37,0:13:16.67,Default,,0,0,0,,Менің ойымша, ол адамдардың назарын аудармауға тырысты.
Dialogue: 0,0:13:17.08,0:13:18.88,Default,,0,0,0,,Мен сенің дұрыс өлуіңді қадағалаймын.
Dialogue: 0,0:13:19.04,0:13:20.21,Default,,0,0,0,,Келме!
Dialogue: 0,0:13:22.34,0:13:23.51,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:13:24.38,0:13:25.47,Default,,0,0,0,,(Тэйгу сынған дыбыс)
Dialogue: 0,0:13:25.63,0:13:26.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:28.72,0:13:29.55,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:30.39,0:13:31.35,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:13:31.51,0:13:34.18,Default,,0,0,0,,Фуфуфуфуфу… ақымақ
Dialogue: 0,0:13:34.31,0:13:37.19,Default,,0,0,0,,Бұл менің Тейгуымның күші
Dialogue: 0,0:13:37.31,0:13:40.65,Default,,0,0,0,,Козырыңызды әрқашан жасырыңыз.
Dialogue: 0,0:13:40.81,0:13:42.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:42.32,0:13:45.78,Default,,0,0,0,,Енді мені қорқытқан күнә...
Dialogue: 0,0:13:46.20,0:13:47.45,Default,,0,0,0,,Өлім жазасы!
Dialogue: 0,0:13:47.61,0:13:48.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:50.45,0:13:51.58,Default,,0,0,0,,Уф! (Министр адал) О, менің...
Dialogue: 0,0:13:51.70,0:13:57.25,Default,,0,0,0,,Мәртебелі де солай болған, бірақ мен ақымақтармен айналысудан жалыққанмын.
Dialogue: 0,0:13:57.41,0:13:58.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:58.96,0:14:00.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:00.96,0:14:03.80,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:06.63,0:14:08.47,Default,,0,0,0,,Дедеде…
Dialogue: 0,0:14:08.63,0:14:12.51,Default,,0,0,0,,Не... неге ондай күшке ие...
Dialogue: 0,0:14:12.64,0:14:16.02,Default,,0,0,0,,Қараңғы жерде өстім, денем мықты...
Dialogue: 0,0:14:16.14,0:14:18.10,Default,,0,0,0,,Сіз оны елестете алмайсыз, солай емес пе?
Dialogue: 0,0:14:18.94,0:14:19.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:19.85,0:14:21.52,Default,,0,0,0,,Уф! (мылтық)
Dialogue: 0,0:14:21.69,0:14:23.48,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:14:23.65,0:14:25.48,Default,,0,0,0,,Уууу…
Dialogue: 0,0:14:25.65,0:14:30.49,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:14:30.61,0:14:34.08,Default,,0,0,0,,Тейгу мөрленген болса да...
Dialogue: 0,0:14:34.24,0:14:34.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:35.12,0:14:36.20,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:36.37,0:14:38.87,Default,,0,0,0,,Сен сияқты шірік жігіт...
Dialogue: 0,0:14:39.04,0:14:40.17,Default,,0,0,0,,Дұрыс, Макио-сан. Ммм…
Dialogue: 0,0:14:40.33,0:14:44.04,Default,,0,0,0,,Жанның күші бір бөлек!
Dialogue: 0,0:14:44.21,0:14:45.71,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:58.06,0:15:01.02,Default,,0,0,0,,Жоқ! Бітті бітті
Dialogue: 0,0:15:01.56,0:15:04.65,Default,,0,0,0,,Түнгі рейд енді таратылды.
Dialogue: 0,0:15:05.11,0:15:06.23,Default,,0,0,0,,Иә
Dialogue: 0,0:15:09.74,0:15:11.41,Default,,0,0,0,,Көріскенше, жан досым
Dialogue: 0,0:15:11.57,0:15:15.12,Default,,0,0,0,,Не? Леон сен...
Dialogue: 0,0:15:16.54,0:15:18.50,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:15:18.66,0:15:20.87,Default,,0,0,0,,Жарайды, мен барлығымен танысамын.
Dialogue: 0,0:15:24.21,0:15:26.25,Default,,0,0,0,,Жарайды, жақсы күлімсіреу.
Dialogue: 0,0:15:27.00,0:15:27.67,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:15:34.05,0:15:36.47,Default,,0,0,0,,Кездескенше Леоне
Dialogue: 0,0:15:39.39,0:15:44.40,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:15:47.48,0:15:52.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:52.24,0:15:54.57,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:57.49,0:16:00.70,Default,,0,0,0,,Революция құтты болсын!
Dialogue: 0,0:16:00.87,0:16:03.42,Default,,0,0,0,,Кедей өмірмен қош айт!
Dialogue: 0,0:16:03.54,0:16:06.75,Default,,0,0,0,,...Онымен ойнасам, кедей болып қалатын шығармын.
Dialogue: 0,0:16:06.92,0:16:08.75,Default,,0,0,0,,Хаха! Оның айырмашылығы жоқ
Dialogue: 0,0:16:10.55,0:16:11.97,Default,,0,0,0,,Сәлем, Леоне!
Dialogue: 0,0:16:12.13,0:16:14.01,Default,,0,0,0,,Осы жерде бірге ішейік.
Dialogue: 0,0:16:14.13,0:16:16.97,Default,,0,0,0,,Қария! Біреуі Леонға да
Dialogue: 0,0:16:17.39,0:16:19.14,Default,,0,0,0,,Леоне, мұнда асығыңыз...
Dialogue: 0,0:16:19.26,0:16:20.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.35,0:16:22.06,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:17:04.44,0:17:05.94,Default,,0,0,0,,Басы кесілді ме?
Dialogue: 0,0:17:07.02,0:17:10.32,Default,,0,0,0,,Бұл Кеджиме, солай емес пе? иә
Dialogue: 0,0:17:10.82,0:17:13.82,Default,,0,0,0,,Мен император болу құқығынан айырылдым деп ойладым.
Dialogue: 0,0:17:13.94,0:17:16.49,Default,,0,0,0,,Соңында, сіз біраз жұмыс жасай аласыз ба?
Dialogue: 0,0:17:16.61,0:17:17.36,Default,,0,0,0,,Иә
Dialogue: 0,0:17:17.53,0:17:21.91,Default,,0,0,0,,Мұнда жыласаң, күлкі боласың.
Dialogue: 0,0:17:22.04,0:17:24.96,Default,,0,0,0,,Соңында мақтанышпен өл
Dialogue: 0,0:17:37.63,0:17:41.14,Default,,0,0,0,,Тыныштық, қан тоқтамайтын ел болсын деп дұға етемін.
Dialogue: 0,0:17:43.64,0:17:47.73,Default,,0,0,0,,Бұл менің соңғы қаным деп ант етемін.
Dialogue: 0,0:17:55.69,0:17:56.74,Default,,0,0,0,,Куроме
Dialogue: 0,0:17:57.07,0:18:01.45,Default,,0,0,0,,Жаңа елде барлығының бақыты үшін бар күшімді саламын.
Dialogue: 0,0:18:01.95,0:18:03.45,Default,,0,0,0,,сенікі де
Dialogue: 0,0:18:03.74,0:18:09.54,Default,,0,0,0,,Мен де ішкі істер қызметкері ретінде болашақта бейбітшілік үшін бар күшімді саламын.
Dialogue: 0,0:18:10.21,0:18:15.34,Default,,0,0,0,,Аа... менімен капитандық күш-қуатыңыздың кішкене бөлігімен бөліссеңіз.
Dialogue: 0,0:18:16.26,0:18:19.22,Default,,0,0,0,,Менің ойымша, сіз Тацуми-кунды осы уақытқа дейін кездестіре алдыңыз ба?
Dialogue: 0,0:18:19.38,0:18:22.60,Default,,0,0,0,,Хмм... Тацуми, менің ойымша, ол тағы да қашып бара жатыр.
Dialogue: 0,0:18:22.72,0:18:26.31,Default,,0,0,0,,Хехе... кеттік.
Dialogue: 0,0:18:26.43,0:18:28.48,Default,,0,0,0,,Көп нәрсе істеу керек.
Dialogue: 0,0:18:39.61,0:18:41.28,Default,,0,0,0,,Бұрынғыдан да көп!
Dialogue: 0,0:18:41.66,0:18:46.62,Default,,0,0,0,,Тацуми мен оның достарының арқасында содан бері ешкім аш қалмады.
Dialogue: 0,0:18:46.75,0:18:48.75,Default,,0,0,0,,Елдің жаңа болуы...
Dialogue: 0,0:18:48.87,0:18:51.92,Default,,0,0,0,,Мүмкін Тацуми мен Сайо Иэясу да қайтып келер.
Dialogue: 0,0:18:52.08,0:18:55.63,Default,,0,0,0,,Хмм... батырлардың оралуы.
Dialogue: 0,0:18:55.75,0:18:58.97,Default,,0,0,0,,Сол кезде мен сені гүлденіп қарсы аламын.
Dialogue: 0,0:19:27.95,0:19:29.83,Default,,0,0,0,,Адамдар күшті адамдар.
Dialogue: 0,0:19:30.37,0:19:32.37,Default,,0,0,0,,Қала қайта құрылады
Dialogue: 0,0:19:32.50,0:19:35.38,Default,,0,0,0,,Бастық Денеңіз жақсы ма?
Dialogue: 0,0:19:35.50,0:19:39.63,Default,,0,0,0,,А, бұл шынымен өмір сүру ұзақтығын қысқартады.
Dialogue: 0,0:19:40.17,0:19:42.34,Default,,0,0,0,,Мен қанша өмір сүретінімді білмеймін.
Dialogue: 0,0:19:45.47,0:19:49.56,Default,,0,0,0,,Жаңа ұлттың іргетасын қалау үшін қалған өмірімді өртеп жіберемін.
Dialogue: 0,0:19:49.68,0:19:53.60,Default,,0,0,0,,Мен аман қалған адам ретінде қолымнан келгенше істей аламын.
Dialogue: 0,0:19:54.15,0:19:57.02,Default,,0,0,0,,Егер сіз бастық болсаңыз, сіз мұны істей аласыз. Іске сәт.
Dialogue: 0,0:20:01.95,0:20:04.66,Default,,0,0,0,,Сіз барасыз ба? Акаме
Dialogue: 0,0:20:05.12,0:20:06.28,Default,,0,0,0,,О
Dialogue: 0,0:20:06.41,0:20:11.25,Default,,0,0,0,,Революциялық армияның барлық қараңғы жағын мені кінәлауға болады.
Dialogue: 0,0:20:11.37,0:20:14.04,Default,,0,0,0,,Қиын рөл үшін кешіріңіз...
Dialogue: 0,0:20:14.17,0:20:17.88,Default,,0,0,0,,Елді құратын бастық болу әлдеқайда қиын.
Dialogue: 0,0:20:18.71,0:20:20.96,Default,,0,0,0,,Қиын кездер көп болды, бірақ
Dialogue: 0,0:20:21.09,0:20:25.26,Default,,0,0,0,,Сонда да бастықтың түнгі рейдке шақырғанына қуаныштымын.
Dialogue: 0,0:20:26.01,0:20:28.35,Default,,0,0,0,,Надженда Ах
Dialogue: 0,0:20:29.68,0:20:31.18,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:20:36.56,0:20:37.61,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:20:40.23,0:20:42.44,Default,,0,0,0,,Аман қалу Акаме
Dialogue: 0,0:20:49.12,0:20:50.62,Default,,0,0,0,,«Түнгі рейд»
Dialogue: 0,0:20:51.50,0:20:53.50,Default,,0,0,0,,Кейінгі империялық кезең —
Dialogue: 0,0:20:53.62,0:20:57.67,Default,,0,0,0,,Император астанасын дүр сілкіндірген қатыгез қылмыстық ұйым делінеді.
Dialogue: 0,0:20:58.50,0:21:01.80,Default,,0,0,0,,Бірақ жаңа ұлттың жазбаларында —
Dialogue: 0,0:21:01.92,0:21:05.09,Default,,0,0,0,,Олар туралы мүлде айтылмаған.
Dialogue: 0,0:21:07.09,0:21:10.68,Default,,0,0,0,,Адам әрекеті болғанша, қараңғылық болады.
Dialogue: 0,0:21:11.64,0:21:14.64,Default,,0,0,0,,Қараңғылық болғанша, жамандық туады
Dialogue: 0,0:21:15.27,0:21:17.48,Default,,0,0,0,,Пышағы жоқтар үшін —
Dialogue: 0,0:21:17.60,0:21:22.28,Default,,0,0,0,,Аспан соттай алмайтын зұлымдық қараңғыда шешіледі.
Dialogue: 0,0:21:23.44,0:21:26.45,Default,,0,0,0,,Біз бәріміз өлтірушіміз
Dialogue: 0,0:21:28.07,0:21:34.08,Default,,0,0,0,,♪〜
Dialogue: 0,0:22:50.86,0:22:56.87,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:04.59,0:23:06.92,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:23:07.34,0:23:12.76,Default,,0,0,0,,Олай болса, әркімнің сезімін иығымызға салып, өмір сүруді жалғастыруымыз керек.
Dialogue: 0,0:23:17.68,0:23:20.10,Default,,0,0,0,,Мен тек қиып аламын
Dialogue: 0,0:23:21.02,0:23:24.69,Default,,0,0,0,,Бірақ ашылатын болашақ бар...
Dialogue: 0,0:23:26.32,0:23:27.57,Default,,0,0,0,,сену
Dialogue: 0,0:23:28.15,0:23:31.91,Default,,0,0,0,,Сондықтан мен сол жолмен жүре беремін.
Dialogue: 0,0:23:35.70,0:23:36.87,Default,,0,0,0,,Жерлеу!
Dialogue: 0,0:23:38.37,0:23:44.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory