Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.01,0:00:16.01,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:00:16.01,0:00:19.52,Default,,0,0,0,,Қош келдіңіз. Мен тек ағама көмектестім.
Dialogue: 0,0:00:19.52,0:00:22.52,Default,,0,0,0,,《Өршіл жас жігіт》
Dialogue: 0,0:00:22.52,0:00:24.82,Default,,0,0,0,,《Мен түсінемін. Ол жеуге болмайтын адам.》
Dialogue: 0,0:00:27.02,0:00:29.02,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:00:29.02,0:00:32.03,Default,,0,0,0,,Мен сендермен бірдей күйдемін.
Dialogue: 0,0:00:32.03,0:00:34.03,Default,,0,0,0,,Менің ағам достықтың дәлелі ретінде Чинатаун➡
Dialogue: 0,0:00:34.03,0:00:37.03,Default,,0,0,0,,Сіз мені осында жібердіңіз.
Dialogue: 0,0:00:37.03,0:00:41.04,Default,,0,0,0,,Хмф, бұл өте өкінішті. Құрал ретінде пайдаланылады.
Dialogue: 0,0:00:41.04,0:00:43.04,Default,,0,0,0,,Сіз! (Гетрю) Жарайды. ➡
Dialogue: 0,0:00:43.04,0:00:46.04,Default,,0,0,0,,Бұл рас. ⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:00:51.05,0:00:55.05,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын, Шортер Вонг.
Dialogue: 0,0:00:55.05,0:00:58.05,Default,,0,0,0,,Уф... жібер! Чикусо.
Dialogue: 0,0:00:58.05,0:01:02.06,Default,,0,0,0,,Гах... (Автор) Хмф.
Dialogue: 0,0:01:02.06,0:01:04.06,Default,,0,0,0,,Бұл біздің кенже ағамыз Гетрю.
Dialogue: 0,0:01:04.06,0:01:06.06,Default,,0,0,0,,Не…. ➡
Dialogue: 0,0:01:06.06,0:01:09.06,Default,,0,0,0,,Ол өте әдемі болғандықтан, адамдар оны әйел деп есептейді.
Dialogue: 0,0:01:09.06,0:01:11.07,Default,,0,0,0,,Егер сізге ұнаса➡
Dialogue: 0,0:01:11.07,0:01:14.04,Default,,0,0,0,,Менің ағам оны қызметші ретінде пайдаланғаным жақсы деді.
Dialogue: 0,0:01:14.04,0:01:17.04,Default,,0,0,0,,О... Түсінді. ➡
Dialogue: 0,0:01:17.04,0:01:21.04,Default,,0,0,0,,Маңызды қонақ ретінде сізге қамқорлық жасайық.
Dialogue: 0,0:01:21.04,0:01:24.01,Default,,0,0,0,,Гетрю Оны оят.
Dialogue: 0,0:01:27.05,0:01:29.05,Default,,0,0,0,,Бұл инелік анестезия.
Dialogue: 0,0:01:29.05,0:01:31.02,Default,,0,0,0,,Хмм….
Dialogue: 0,0:01:35.06,0:01:37.06,Default,,0,0,0,,Сіз мені түсінесіз бе? Самурай баласы.
Dialogue: 0,0:01:37.06,0:01:39.06,Default,,0,0,0,,Автор….
Dialogue: 0,0:01:39.06,0:01:43.07,Default,,0,0,0,,Уайымдама, Жақында Эш келеді.
Dialogue: 0,0:01:43.07,0:01:45.07,Default,,0,0,0,,Мен сізге көмектескім келеді.
Dialogue: 0,0:01:45.07,0:01:48.04,Default,,0,0,0,,Танысқаныма қуаныштымын, балам.
Dialogue: 0,0:01:48.04,0:01:50.07,Default,,0,0,0,,Менің атым Гольцин.
Dialogue: 0,0:01:50.07,0:01:54.04,Default,,0,0,0,,Мен сенің жақын досың Аштың иесімін.
Dialogue: 0,0:01:57.08,0:02:01.08,Default,,0,0,0,,Қауіпті. Бұлшықеттеріңізде әлі де ұю болуы керек.
Dialogue: 0,0:02:01.08,0:02:03.09,Default,,0,0,0,,Юсис... сіз де қамауға алындыңыз ба?
Dialogue: 0,0:02:03.09,0:02:06.09,Default,,0,0,0,,Ха! Сіз қаншалықты алыс жүре аласыз?
Dialogue: 0,0:02:06.09,0:02:09.09,Default,,0,0,0,,Күлдің де таңғажайып жүкті тасымалдайды. ➡
Dialogue: 0,0:02:09.09,0:02:14.00,Default,,0,0,0,,Ол адам сені сатқан Лидің күйеуінің інісі.
Dialogue: 0,0:02:14.00,0:02:17.00,Default,,0,0,0,,А... Таңдануға әлі ерте.
Dialogue: 0,0:02:17.00,0:02:20.00,Default,,0,0,0,,Ашқа опасыздық жасап, сені осында ұрлап кеткен адам➡
Dialogue: 0,0:02:20.00,0:02:22.00,Default,,0,0,0,,Бұл адам.
Dialogue: 0,0:02:24.01,0:02:26.01,Default,,0,0,0,,Осындай ақымақ әңгімеге алданып қаламын деп ойлайсың ба? ?
Dialogue: 0,0:02:26.01,0:02:29.01,Default,,0,0,0,,Қысқарақ сен сияқты бейбақ емес!
Dialogue: 0,0:02:29.01,0:02:33.02,Default,,0,0,0,,Эй, сен мұны естідің бе? Сіз үлкен сенімге ие болдыңыз, Шортер.
Dialogue: 0,0:02:33.02,0:02:36.02,Default,,0,0,0,,Күлге опасыздық жасау мүмкін емес.
Dialogue: 0,0:02:36.02,0:02:39.02,Default,,0,0,0,,Бұл өтірік пе? Қысқарақ.
Dialogue: 0,0:02:44.03,0:02:46.03,Default,,0,0,0,,Қысқарақ! Эйзи!
Dialogue: 0,0:02:46.03,0:02:50.03,Default,,0,0,0,,Бұл өтірік болса керек! ? Автордың айтқаны өтірік! ?
Dialogue: 0,0:02:50.03,0:02:54.04,Default,,0,0,0,,Эйдзи! Мен сені міндетті түрде аламын...!
Dialogue: 0,0:02:54.04,0:02:56.04,Default,,0,0,0,,Уф! Енді ол үшін➡
Dialogue: 0,0:02:56.04,0:02:59.04,Default,,0,0,0,,Сізге үлкен көмек болатынына сенімдімін. ➡
Dialogue: 0,0:02:59.04,0:03:04.05,Default,,0,0,0,,Әрине сізге де емес.
Dialogue: 0,0:03:04.05,0:03:14.06,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:35.54,0:04:38.54,Default,,0,0,0,,Шамамен 30 минуттан кейін зәулім ғимараттар көзге түседі. ➡
Dialogue: 0,0:04:38.54,0:04:41.04,Default,,0,0,0,,Ностальгиялық Бұл сіздің Джунгли болуы керек. ➡
Dialogue: 0,0:04:41.04,0:04:43.04,Default,,0,0,0,,Жабайы мысық бала.
Dialogue: 0,0:04:43.04,0:04:46.01,Default,,0,0,0,,Сол Цукирю жігіті➡
Dialogue: 0,0:04:46.01,0:04:49.05,Default,,0,0,0,,Иә, бұл Чайнатаун лақтырған уланған жем.
Dialogue: 0,0:04:49.05,0:04:53.02,Default,,0,0,0,,Хмф... Сізге айтудың қажеті жоқ. ➡
Dialogue: 0,0:04:53.02,0:04:55.02,Default,,0,0,0,,Оның орнына қала орталығындағы адамдар➡
Dialogue: 0,0:04:55.02,0:04:57.03,Default,,0,0,0,,Сіз бәрін құрастырдыңыз ба?
Dialogue: 0,0:04:57.03,0:04:59.03,Default,,0,0,0,,Аш тобынан басқа. ➡
Dialogue: 0,0:04:59.03,0:05:02.03,Default,,0,0,0,,Олар сен емес, оның артынан жүрді.
Dialogue: 0,0:05:02.03,0:05:05.03,Default,,0,0,0,,Сіз үшін де солай айтуға болады. ➡
Dialogue: 0,0:05:05.03,0:05:08.04,Default,,0,0,0,,Ас менің ұсынысымнан бас тартты➡
Dialogue: 0,0:05:08.04,0:05:10.04,Default,,0,0,0,,Сіз бастық дәрежесіне көтерілдіңіз ғой. ➡
Dialogue: 0,0:05:10.04,0:05:11.97,Default,,0,0,0,,Тек өз мүмкіндігіңізбен.
Dialogue: 0,0:05:11.97,0:05:14.98,Default,,0,0,0,,Хмф... Сізде әлі де өкініш бар ма?
Dialogue: 0,0:05:14.98,0:05:17.98,Default,,0,0,0,,Мен оны көтердім.
Dialogue: 0,0:05:17.98,0:05:23.99,Default,,0,0,0,,Мен оны аштым, жетілдірдім, оқыттым және осы уақытқа дейін жеткіздім.
Dialogue: 0,0:05:23.99,0:05:26.99,Default,,0,0,0,,Өз қолыммен құртамын... ➡
Dialogue: 0,0:05:26.99,0:05:29.99,Default,,0,0,0,,Сіз түсінбейсіз. ⚟
Dialogue: 0,0:05:29.99,0:05:31.99,Default,,0,0,0,,Әке мен дайынмын.
Dialogue: 0,0:05:31.99,0:05:36.00,Default,,0,0,0,,Қонақтарды қабылдауға дайындалып жатырсыз делік.
Dialogue: 0,0:05:39.00,0:05:44.01,Default,,0,0,0,,Бетіңіз таныс сияқты. Ол Гриффинді атып өлтірді...
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:05:46.01,0:05:48.01,Default,,0,0,0,,Мұны Эшке айтып көріңіз.
Dialogue: 0,0:05:48.01,0:05:51.01,Default,,0,0,0,,Сіз өлтірген Гриффиннің ағасына.
Dialogue: 0,0:05:51.01,0:05:55.02,Default,,0,0,0,,Ол сені міндетті түрде құртады.
Dialogue: 0,0:05:55.02,0:05:57.02,Default,,0,0,0,,Аузыңды жап! Мұндай нәрсе не істей алады?
Dialogue: 0,0:05:57.02,0:05:59.02,Default,,0,0,0,,⚟Не деп шу шығарып тұрсың?
Dialogue: 0,0:05:59.02,0:06:02.02,Default,,0,0,0,,Дайынсың ба? аа. ➡
Dialogue: 0,0:06:02.02,0:06:04.03,Default,,0,0,0,,Мен оны бұл жолы тамаша орындаймын.
Dialogue: 0,0:06:04.03,0:06:08.03,Default,,0,0,0,,Сіз банан балығы туралы айтып отырсыз ба? Осы жабдықтың барлығымен➡
Dialogue: 0,0:06:08.03,0:06:10.03,Default,,0,0,0,,Сіз тек сәтсіз дәрілерді жасай аласыз дегенге сену қиын.
Dialogue: 0,0:06:10.03,0:06:13.00,Default,,0,0,0,,Бұл сәтсіздік пе, жоқ па➡
Dialogue: 0,0:06:13.00,0:06:16.00,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:06:16.00,0:06:18.01,Default,,0,0,0,,Сіз мені сынақ пәні ретінде пайдалануды жоспарлап отырсыз ба? ?
Dialogue: 0,0:06:18.01,0:06:20.98,Default,,0,0,0,,⚟Қысқарақ! (Қысқарақ) Эйджи!
Dialogue: 0,0:06:20.98,0:06:22.98,Default,,0,0,0,,Жұмысты бастау.
Dialogue: 0,0:06:22.98,0:06:24.98,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:06:24.98,0:06:28.02,Default,,0,0,0,,Чикушо... Құбыжық болып, шығамын!
Dialogue: 0,0:06:28.02,0:06:33.02,Default,,0,0,0,,Тоқта! Тоқта! !
Dialogue: 0,0:06:33.02,0:06:35.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:35.02,0:06:37.03,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:06:37.03,0:06:39.03,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:06:39.03,0:06:43.03,Default,,0,0,0,,Сіз банан балығының құпиясын білгіңіз келді.
Dialogue: 0,0:06:43.03,0:06:49.04,Default,,0,0,0,,Пульс 98, АҚ 80-150. (Зерттеуші) Ми толқындарында өзгерістер пайда болды.
Dialogue: 0,0:06:49.04,0:06:52.04,Default,,0,0,0,,Импульстің жоғарылауы жалғасуда.
Dialogue: 0,0:06:52.04,0:06:55.04,Default,,0,0,0,,Галлюцинациялар басталған сияқты. Қысқарақ! Мықты болыңыз!
Dialogue: 0,0:06:55.04,0:06:59.05,Default,,0,0,0,,Егер бұл орын алса, кез келген ой санадан тыс санаға сіңіп кетуі мүмкін.
Dialogue: 0,0:06:59.05,0:07:03.02,Default,,0,0,0,,Келіңіздер! Мына жігіттің бетіне мұқият қараңыз.
Dialogue: 0,0:07:06.05,0:07:08.02,Default,,0,0,0,,Қысқарақ….
Dialogue: 0,0:07:10.06,0:07:12.99,Default,,0,0,0,,Маған ұнамайды... Тоқта...
Dialogue: 0,0:07:12.99,0:07:18.00,Default,,0,0,0,,Келме... Ах... Ах...
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Ааааааа! !
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Ах...! Уф...!
Dialogue: 0,0:07:22.00,0:07:23.97,Default,,0,0,0,,Бұл қорқыныш. Түсінесіз бе?
Dialogue: 0,0:07:23.97,0:07:27.98,Default,,0,0,0,,Сіздің қорқынышыңыз енді қалыптасты.
Dialogue: 0,0:07:27.98,0:07:29.98,Default,,0,0,0,,Мен қашып құтыла алмайтын қорқынышты түс.
Dialogue: 0,0:07:29.98,0:07:31.98,Default,,0,0,0,,Бұл жігіт сіздің қорқынышты түстердің себебі.
Dialogue: 0,0:07:31.98,0:07:33.98,Default,,0,0,0,,Ооо! Мен бұл жігітті өлтіруім керек➡
Dialogue: 0,0:07:33.98,0:07:36.99,Default,,0,0,0,,Сіз ойға келмейтін жан түршігерлік азапты сезінесіз. ➡
Dialogue: 0,0:07:36.99,0:07:40.99,Default,,0,0,0,,Мына жігітті өлтіріңіз. Оны кесектерге бөліп, ішектерін сүйреп шығарыңыз! ➡
Dialogue: 0,0:07:40.99,0:07:45.99,Default,,0,0,0,,Бұл аурудан құтылудың жалғыз жолы. Ұмытпа!
Dialogue: 0,0:07:45.99,0:07:49.00,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл банан балықтарының күші.
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0,0,0,,Мен Эшке жақсы көрініс көрсетемін.
Dialogue: 0,0:07:51.00,0:07:56.00,Default,,0,0,0,,Менің көз алдымда ең жақын досым асыл баламның ішін кесіп тастады➡
Dialogue: 0,0:07:56.00,0:08:00.01,Default,,0,0,0,,Ішкі ағзаларыңызды жұлып алатын тозақтың суреті.
Dialogue: 0,0:08:00.01,0:08:03.04,Default,,0,0,0,,Күлді сілеусін? (Ер) Иә, дұрыс айтасыз.
Dialogue: 0,0:08:03.04,0:08:07.05,Default,,0,0,0,,Сонымен, Shorter бірдей ме? (Еркек) Бастыққа дереу хабарлайық.
Dialogue: 0,0:08:07.05,0:08:11.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:11.95,0:08:14.96,Default,,0,0,0,,Не? Жабайы мысық келді➡
Dialogue: 0,0:08:14.96,0:08:16.96,Default,,0,0,0,,Жаңалықтар. (Гетрю) Не? ➡
Dialogue: 0,0:08:16.96,0:08:18.96,Default,,0,0,0,,Болайын деп тұрса да.
Dialogue: 0,0:08:20.96,0:08:24.97,Default,,0,0,0,,Оның да жалығып кеткеніне сенімдімін.
Dialogue: 0,0:08:24.97,0:08:28.97,Default,,0,0,0,,Менің таңдауым жоқ. Мен оларды кешкі асқа шақырдым. ➡
Dialogue: 0,0:08:28.97,0:08:31.97,Default,,0,0,0,,Сіз де қатысуыңыз керек. (Гетрю) Мен мұны асыға күтемін.
Dialogue: 0,0:08:31.97,0:08:35.98,Default,,0,0,0,,Қымбатты Күллі Сілеусінді қайта көруге шыдамаймын.
Dialogue: 0,0:08:35.98,0:08:37.98,Default,,0,0,0,,Оның да солай ойлайтынына сенімдімін.
Dialogue: 0,0:08:37.98,0:08:39.98,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:43.99,0:08:45.99,Default,,0,0,0,,Бірдеңе айтқың келген сияқты.
Dialogue: 0,0:08:45.99,0:08:49.99,Default,,0,0,0,,Амансың ба? Мынадай нәрсе...
Dialogue: 0,0:08:49.99,0:08:51.99,Default,,0,0,0,,Сіз онымен ұйықтай аласыз ба?
Dialogue: 0,0:08:51.99,0:08:54.00,Default,,0,0,0,,Немесе ол сені екеумізді екі жағына жатқызады➡
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0,0,0,,Сіз көңіл көтеруге тырыстыңыз ба?
Dialogue: 0,0:08:56.00,0:09:00.00,Default,,0,0,0,,Екеуі де! Бұл үлкен мәселе емес, солай ма?
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Мұны тіпті Эш де жасады.
Dialogue: 0,0:09:02.00,0:09:06.01,Default,,0,0,0,,Ол бастапқыда Гольциннің жезөкшелерінің бірі болған.
Dialogue: 0,0:09:06.01,0:09:10.01,Default,,0,0,0,,Сол жерден мен өз өнерімді, тапқырлығымды пайдаланып, жоғары өрмеледім.
Dialogue: 0,0:09:10.01,0:09:12.98,Default,,0,0,0,,Мен әдемі ештеңе айта алмаймын.
Dialogue: 0,0:09:12.98,0:09:15.98,Default,,0,0,0,,Тірі қалу басты басымдық болар еді.
Dialogue: 0,0:09:15.98,0:09:18.99,Default,,0,0,0,,Сіз өте бақытты өмір сүрген сияқтысыз.
Dialogue: 0,0:09:18.99,0:09:22.99,Default,,0,0,0,,Саған қарасам тітіркенетінім осыдан болса керек.
Dialogue: 0,0:09:22.99,0:09:25.99,Default,,0,0,0,,Бірақ мен енді қарай алмаймын.
Dialogue: 0,0:09:25.99,0:09:29.00,Default,,0,0,0,,Батылдық танытып, мұқият қара.
Dialogue: 0,0:09:29.00,0:09:31.97,Default,,0,0,0,,Күл жататын әлем.
Dialogue: 0,0:09:37.01,0:09:40.01,Default,,0,0,0,,Маған осылай киіндіруге қалай дәтің бар...
Dialogue: 0,0:09:40.01,0:09:42.01,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:09:42.01,0:09:45.01,Default,,0,0,0,,Мен Эй Чанға және басқаларға не болды деп ойлаймын...
Dialogue: 0,0:09:45.01,0:09:48.02,Default,,0,0,0,,Ал, құрметті қонақ сәл кешігіп қалған сияқты...
Dialogue: 0,0:09:48.02,0:09:49.98,Default,,0,0,0,,⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:09:52.02,0:09:53.99,Default,,0,0,0,,Ах!?
Dialogue: 0,0:09:59.03,0:10:01.00,Default,,0,0,0,,Әдемі….
Dialogue: 0,0:10:05.00,0:10:11.21,Default,,0,0,0,,Шынымен әдемі. Ол туған ақсүйектерге ұқсайды.
Dialogue: 0,0:10:11.21,0:10:14.21,Default,,0,0,0,,Хмф... Бұл тіпті жабайы мысық емес, құбыжық мысық.
Dialogue: 0,0:10:14.21,0:10:16.21,Default,,0,0,0,,бастайық. ➡
Dialogue: 0,0:10:16.21,0:10:19.21,Default,,0,0,0,,Мен оны арнайы сен үшін таңдадым. ➡
Dialogue: 0,0:10:19.21,0:10:21.18,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:10:26.22,0:10:30.23,Default,,0,0,0,,Романь Конти Менің ойымша, бұл 69 жаста.
Dialogue: 0,0:10:30.23,0:10:34.23,Default,,0,0,0,,Браво! Сізге үйреткенімді ешқашан ұмытпайсыз деп үміттенемін➡
Dialogue: 0,0:10:34.23,0:10:37.23,Default,,0,0,0,,Мен бақыттымын. Бұл керемет түн болатын сияқты. ➡
Dialogue: 0,0:10:37.23,0:10:40.24,Default,,0,0,0,,Сізге сыйлық ұнады ма?
Dialogue: 0,0:10:40.24,0:10:44.24,Default,,0,0,0,,Құлағыңызды тесіп алғаныңыз жақсы емес.
Dialogue: 0,0:10:44.24,0:10:47.24,Default,,0,0,0,,Нефрит көзіңіздің түсіне сәйкес келеді➡
Dialogue: 0,0:10:47.24,0:10:49.24,Default,,0,0,0,,Бұл мен табуды арнайы сұраған нәрсе болды.
Dialogue: 0,0:10:49.24,0:10:52.25,Default,,0,0,0,,400 000 доллардың нарықтық бағасы нонсенс шығар.
Dialogue: 0,0:10:52.25,0:10:56.25,Default,,0,0,0,,《400 000! ? 》 (Ibe)《Рычағы 48 миллион иен! ? 》
Dialogue: 0,0:10:56.25,0:10:59.25,Default,,0,0,0,,Оның ауыр екені таңқаларлық емес.
Dialogue: 0,0:10:59.25,0:11:02.26,Default,,0,0,0,,Мен басқаратын клубта Эш жұмыс істеді➡
Dialogue: 0,0:11:02.26,0:11:04.26,Default,,0,0,0,,Бұл маңызды өнім болды. ➡
Dialogue: 0,0:11:04.26,0:11:07.26,Default,,0,0,0,,Сонымен қатар егжей-тегжейлі рейтингтер бар➡
Dialogue: 0,0:11:07.26,0:11:11.27,Default,,0,0,0,,Шаш үшін платина, көздің түсі үшін ашық жасыл. ➡
Dialogue: 0,0:11:11.27,0:11:13.20,Default,,0,0,0,,Зергерлік бұйымдармен бірдей➡
Dialogue: 0,0:11:13.20,0:11:17.21,Default,,0,0,0,,Тапшылық мәні неғұрлым жоғары болса, соғұрлым мән жоғары болады. ➡
Dialogue: 0,0:11:17.21,0:11:20.21,Default,,0,0,0,,Ол ең құнды тауар болды.
Dialogue: 0,0:11:20.21,0:11:23.21,Default,,0,0,0,,《Қандай жиіркенішті бейбақ...》
Dialogue: 0,0:11:23.21,0:11:25.21,Default,,0,0,0,,Неліктен Эйджи мен Шотер мұнда жоқ?
Dialogue: 0,0:11:25.21,0:11:28.22,Default,,0,0,0,,Олар шақырылмайды.
Dialogue: 0,0:11:28.22,0:11:32.29,Default,,0,0,0,,Уайымдамаңыз. Кейін кездесейік.
Dialogue: 0,0:11:32.29,0:11:35.22,Default,,0,0,0,,Осы кезеңде адамдарды не толғандырады?
Dialogue: 0,0:11:35.22,0:11:37.23,Default,,0,0,0,,Егер сіз өз ұстанымыңызды қарастырсаңыз ше?
Dialogue: 0,0:11:37.23,0:11:39.23,Default,,0,0,0,,Сіз де.
Dialogue: 0,0:11:39.23,0:11:41.23,Default,,0,0,0,,Не? Ұрысты тоқтат. ➡
Dialogue: 0,0:11:41.23,0:11:44.23,Default,,0,0,0,,Күл, мен саған айттым ғой➡
Dialogue: 0,0:11:44.23,0:11:48.24,Default,,0,0,0,,Оларға кітаптар мен ұстаздар берді, әртүрлі нәрселерді үйретті. ➡
Dialogue: 0,0:11:48.24,0:11:52.24,Default,,0,0,0,,Сосын оған мылтық беріп, өнерін шыңдауға мүмкіндік берді. ➡
Dialogue: 0,0:11:52.24,0:11:55.24,Default,,0,0,0,,Мен бұл мылтық маған бағытталады деп ешқашан ойламадым➡
Dialogue: 0,0:11:55.24,0:11:59.25,Default,,0,0,0,,Ол кезде мен бұл туралы армандаған емеспін.
Dialogue: 0,0:11:59.25,0:12:03.22,Default,,0,0,0,,Сіз ең әдемі және қауіпті аңсыз.
Dialogue: 0,0:12:05.25,0:12:08.22,Default,,0,0,0,,Міне, кешкі ас аяқталды.
Dialogue: 0,0:12:08.22,0:12:11.23,Default,,0,0,0,,Мен сізді шоу өтетін жерге апаруға рұқсат етіңіз.
Dialogue: 0,0:12:14.16,0:12:17.17,Default,,0,0,0,,⚟ (аяқ дыбысы) Бұл кім! ?
Dialogue: 0,0:12:17.17,0:12:20.17,Default,,0,0,0,,⚟Ерте-ертеде атақты Күллі Сілеусін тобы болыпты➡
Dialogue: 0,0:12:20.17,0:12:23.17,Default,,0,0,0,,Сіз осындай жерде егеуқұйрықтармен бірге тұрасыз ба?
Dialogue: 0,0:12:23.17,0:12:25.17,Default,,0,0,0,,Бұл кім? Темеха.
Dialogue: 0,0:12:25.17,0:12:29.18,Default,,0,0,0,,Мен Шин Су Линмін. Ол қытайлық бастық.
Dialogue: 0,0:12:29.18,0:12:32.18,Default,,0,0,0,,Бастық туралы не деуге болады? Маған қарап тұрсың ба, бала?
Dialogue: 0,0:12:32.18,0:12:34.18,Default,,0,0,0,,Қытай бастығы қысқарақ, солай ма?
Dialogue: 0,0:12:34.18,0:12:36.18,Default,,0,0,0,,Ол оқудан шығарылды. не! ?
Dialogue: 0,0:12:36.18,0:12:39.19,Default,,0,0,0,,Күлмен жұмыс істеу арқылы➡
Dialogue: 0,0:12:39.19,0:12:42.19,Default,,0,0,0,,Бұл менің үстімдегі адамдардың ашуын келтірді.
Dialogue: 0,0:12:42.19,0:12:45.19,Default,,0,0,0,,Одан гөрі соғысқа баруға дайынсың ба?
Dialogue: 0,0:12:45.19,0:12:47.20,Default,,0,0,0,,Соғыс туралы не айтасыз? Күлді сілеусін - бұл➡
Dialogue: 0,0:12:47.20,0:12:50.20,Default,,0,0,0,,Мен Нью-Йоркке оралдым. Не! ?
Dialogue: 0,0:12:50.20,0:12:53.20,Default,,0,0,0,,Ол қазір Гольциннің үйінде үйқамақта отыр.
Dialogue: 0,0:12:53.20,0:12:56.20,Default,,0,0,0,,Соғысқа дайын болсаң, қол ұшын созамын.
Dialogue: 0,0:12:56.20,0:13:00.21,Default,,0,0,0,,Мұны істеу дұрыс па? Жоғарыдағы жігіттер...
Dialogue: 0,0:13:00.21,0:13:03.21,Default,,0,0,0,,Жоғарыда Гольцинмен мәміле болғаны рас.
Dialogue: 0,0:13:03.21,0:13:06.21,Default,,0,0,0,,Бірақ бұл жоғарыдағы жағдай.
Dialogue: 0,0:13:06.21,0:13:09.22,Default,,0,0,0,,Біз үшін бастық әлі қысқарақ!
Dialogue: 0,0:13:11.22,0:13:14.22,Default,,0,0,0,,Жарайды, тыңдайық.
Dialogue: 0,0:13:16.16,0:13:19.16,Default,,0,0,0,,Хмф...Мен сені осымен қамап жатқаныма сене алар емеспін.
Dialogue: 0,0:13:19.16,0:13:21.16,Default,,0,0,0,,Осы жерге барыңыз.
Dialogue: 0,0:13:24.17,0:13:29.20,Default,,0,0,0,,Мен сенімдімін, олар республиканың мүшелері... және де әскери қызметкерлер.
Dialogue: 0,0:13:29.20,0:13:32.24,Default,,0,0,0,,тым кеш, Ас.
Dialogue: 0,0:13:32.24,0:13:36.21,Default,,0,0,0,,Сіз бұл жерді білесіз бе? Бұл Папа Диноның өлім жазасына кесу бөлмесі. ➡
Dialogue: 0,0:13:36.21,0:13:38.21,Default,,0,0,0,,Мен қосыламын деп ешқашан ойламадым➡
Dialogue: 0,0:13:38.21,0:13:40.21,Default,,0,0,0,,Мен бұл туралы ойламаған едім.
Dialogue: 0,0:13:40.21,0:13:43.22,Default,,0,0,0,,Аа... Әдеттегідей.
Dialogue: 0,0:13:43.22,0:13:48.19,Default,,0,0,0,,Бірақ біз қанша уақыт шыдай аламыз...?
Dialogue: 0,0:13:56.23,0:13:59.23,Default,,0,0,0,,Хмф... Сіз сондай тітіркендіргішсіз.
Dialogue: 0,0:13:59.23,0:14:01.24,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:14:01.24,0:14:04.24,Default,,0,0,0,,Білсем де, жүзіңді көрсем, қинағым келеді.
Dialogue: 0,0:14:04.24,0:14:06.24,Default,,0,0,0,,Ол бұзық болғандықтан.
Dialogue: 0,0:14:06.24,0:14:10.24,Default,,0,0,0,,Ха... бәрі жақсы болып жатыр. Бұл күрсінуді ұмытпа, жарай ма?
Dialogue: 0,0:14:10.24,0:14:12.15,Default,,0,0,0,,Avery!
Dialogue: 0,0:14:12.15,0:14:15.15,Default,,0,0,0,,Сәлем бауырым. Жарайды, қараңызшы.
Dialogue: 0,0:14:15.15,0:14:17.15,Default,,0,0,0,,Мен қорқып, қолымды тартып алдым➡
Dialogue: 0,0:14:17.15,0:14:19.15,Default,,0,0,0,,Мен өзім қол жеткіздім.
Dialogue: 0,0:14:19.15,0:14:23.16,Default,,0,0,0,,Сіз... не істеп жатқаныңызды білесіз бе! ?
Dialogue: 0,0:14:23.16,0:14:25.16,Default,,0,0,0,,Бұл керемет бастама! Бірінші...
Dialogue: 0,0:14:25.16,0:14:27.16,Default,,0,0,0,,⚟ Қажетсіз сөздерді айтпаңыз.
Dialogue: 0,0:14:27.16,0:14:29.16,Default,,0,0,0,,Қазір бастаңыз.
Dialogue: 0,0:14:29.16,0:14:33.17,Default,,0,0,0,,Қонақтардың алдында мені ұятқа қалдырмаңыз.
Dialogue: 0,0:14:33.17,0:14:36.17,Default,,0,0,0,,Мен білемін. Ха!
Dialogue: 0,0:14:36.17,0:14:39.17,Default,,0,0,0,,Авраам Доусон, солай ма?
Dialogue: 0,0:14:39.17,0:14:44.18,Default,,0,0,0,,Сіз Иракта солдаттарды теңіз шошқасы ретінде пайдаланып, бірінен соң бірін өлтірдіңіз.
Dialogue: 0,0:14:44.18,0:14:47.18,Default,,0,0,0,,Өйткені олардың бәрі мені мазақ етті!
Dialogue: 0,0:14:47.18,0:14:49.18,Default,,0,0,0,,Сіз егеуқұйрықсыз ба? Сіз қорқақсыз ба?
Dialogue: 0,0:14:49.18,0:14:51.19,Default,,0,0,0,,Бұл жай ғана кек!
Dialogue: 0,0:14:51.19,0:14:54.19,Default,,0,0,0,,Гриффин жақсы жігіт еді, бірақ➡
Dialogue: 0,0:14:54.19,0:14:58.19,Default,,0,0,0,,Мен не істегенімді түсіндім, сондықтан мен оған көмектесе алмадым ...
Dialogue: 0,0:14:58.19,0:15:02.20,Default,,0,0,0,,Олай болса сені өлтіргенімнен еш пайда жоқ.
Dialogue: 0,0:15:02.20,0:15:05.20,Default,,0,0,0,,Бұл жай ғана кек алу емес пе?
Dialogue: 0,0:15:05.20,0:15:10.20,Default,,0,0,0,,Мықты болғаннан пайда жоқ! Сен осы жерде өлесің!
Dialogue: 0,0:15:13.17,0:15:16.18,Default,,0,0,0,,Қысқарақ!
Dialogue: 0,0:15:16.18,0:15:19.18,Default,,0,0,0,,《Голзиннің сол жігіттермен байланысқанына сене алар емеспін...》➡
Dialogue: 0,0:15:19.18,0:15:21.18,Default,,0,0,0,,《Жер бетінде не? 》
Dialogue: 0,0:15:21.18,0:15:23.15,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:23.15,0:15:25.19,Default,,0,0,0,,⚟Сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:15:25.19,0:15:27.19,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:15:27.19,0:15:29.19,Default,,0,0,0,,Уайымдама, бұл сенің кінәң емес.
Dialogue: 0,0:15:29.19,0:15:32.19,Default,,0,0,0,,Олай емес... ➡
Dialogue: 0,0:15:32.19,0:15:35.20,Default,,0,0,0,,Мен... қазірдің өзінде...
Dialogue: 0,0:15:35.20,0:15:37.20,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:37.20,0:15:39.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:41.20,0:15:43.17,Default,,0,0,0,,Эйдзи! Эй Чан!
Dialogue: 0,0:15:43.17,0:15:45.17,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:15:45.17,0:15:48.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.18,0:15:52.21,Default,,0,0,0,,Ах... а... ➡
Dialogue: 0,0:15:52.21,0:15:56.22,Default,,0,0,0,,Ах... аа! Менің басым! Амал жоқ...
Dialogue: 0,0:15:56.22,0:16:00.22,Default,,0,0,0,,Иә, бұл банан балығы.
Dialogue: 0,0:16:00.22,0:16:02.19,Default,,0,0,0,,Не! ?
Dialogue: 0,0:16:02.19,0:16:06.19,Default,,0,0,0,,Күл Мен саған жақсы нәрсе көрсетейін. ➡
Dialogue: 0,0:16:06.19,0:16:10.20,Default,,0,0,0,,Қысқарақ Бұл жігіт есіңізде ме?
Dialogue: 0,0:16:10.20,0:16:13.13,Default,,0,0,0,,Уф! Ах... Ах! Келме!
Dialogue: 0,0:16:13.13,0:16:17.14,Default,,0,0,0,,Есіңде ме? Бұл жігіт сенің жауың.
Dialogue: 0,0:16:17.14,0:16:19.14,Default,,0,0,0,,Мына жігітті өлтір!
Dialogue: 0,0:16:24.18,0:16:26.15,Default,,0,0,0,,Міне, келдіңіз.
Dialogue: 0,0:16:28.18,0:16:30.18,Default,,0,0,0,,Жақсы, солай.
Dialogue: 0,0:16:30.18,0:16:32.25,Default,,0,0,0,,Келіңіздер... Қысқарақ!
Dialogue: 0,0:16:32.25,0:16:37.19,Default,,0,0,0,,Қарашы, сен де ұрыспақсың. Менің өлгім келмейді.
Dialogue: 0,0:16:37.19,0:16:40.19,Default,,0,0,0,,Қысқарақ Бұл менмін, түсінбеймін! ?
Dialogue: 0,0:16:40.19,0:16:43.20,Default,,0,0,0,,Қысқарақ! Ха… ха….
Dialogue: 0,0:16:43.20,0:16:46.17,Default,,0,0,0,,Ааааааа! ! Қаш, Эйджи!
Dialogue: 0,0:16:48.20,0:16:50.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:53.21,0:16:56.21,Default,,0,0,0,,Автор! Сіз мені өлтіргіңіз келеді! ? Өлтір!
Dialogue: 0,0:16:56.21,0:16:59.21,Default,,0,0,0,,Әрине аламын.
Dialogue: 0,0:16:59.21,0:17:03.22,Default,,0,0,0,,Бірақ сіз соңғысысыз. Мен оның қызығын сақтағым келеді.
Dialogue: 0,0:17:03.22,0:17:05.22,Default,,0,0,0,,Гах...!
Dialogue: 0,0:17:05.22,0:17:07.22,Default,,0,0,0,,Қауіпті! (Қысқарақ) Уф!
Dialogue: 0,0:17:07.22,0:17:09.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:09.22,0:17:13.13,Default,,0,0,0,,Жақсы, солай. Оны өлтірейік. ➡
Dialogue: 0,0:17:13.13,0:17:16.13,Default,,0,0,0,,Әй, өлгің келмесе, соғыс.
Dialogue: 0,0:17:16.13,0:17:19.13,Default,,0,0,0,,Қысқарақ, өтінемін! Есіңе орал!
Dialogue: 0,0:17:19.13,0:17:22.14,Default,,0,0,0,,Бұл пайдасыз. Мен бұйрықты орындай алмаймын.
Dialogue: 0,0:17:22.14,0:17:24.14,Default,,0,0,0,,Ауырсыну шыдамайды.
Dialogue: 0,0:17:24.14,0:17:27.14,Default,,0,0,0,,Бұйрықты орындағаныңыздың өзі босатылатыныңызды білдірмейді.
Dialogue: 0,0:17:27.14,0:17:32.25,Default,,0,0,0,,Егер олар нысанасынан айырылса, олар ауыртпалыққа шыдамай, аутодеструктивті мінез-құлыққа бет бұрады. ➡
Dialogue: 0,0:17:32.25,0:17:36.15,Default,,0,0,0,,Тірі қалсаңыз да, өміріңіздің соңына дейін қорқынышты түс көресіз. ➡
Dialogue: 0,0:17:36.15,0:17:39.15,Default,,0,0,0,,Өз ағаң сияқты.
Dialogue: 0,0:17:39.15,0:17:43.16,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:17:43.16,0:17:47.16,Default,,0,0,0,,Қысқарақ! Бұл Эйджи! Түсінбейсің бе? өтінемін
Dialogue: 0,0:17:47.16,0:17:49.16,Default,,0,0,0,,Ааа! Ах!
Dialogue: 0,0:17:49.16,0:17:52.17,Default,,0,0,0,,Тоқта! Өтінемін, тоқтатыңыз! Біреу өтінемін, оны тоқтатыңыз!
Dialogue: 0,0:17:52.17,0:17:54.17,Default,,0,0,0,,Тоқта...
Dialogue: 0,0:17:54.17,0:17:56.17,Default,,0,0,0,,О... тоқтаңызшы...
Dialogue: 0,0:17:56.17,0:17:59.17,Default,,0,0,0,,Хаха, тамаша шоу екен.
Dialogue: 0,0:17:59.17,0:18:02.18,Default,,0,0,0,,Сіз қалай ойлайсыз? барлығы.
Dialogue: 0,0:18:02.18,0:18:05.18,Default,,0,0,0,,Соны пайдалансаңыз, ата-аналар мен балалар, тіпті бауырлар➡
Dialogue: 0,0:18:05.18,0:18:09.18,Default,,0,0,0,,Бір-бірін өлтіруге мәжбүрлеуге болады.
Dialogue: 0,0:18:11.19,0:18:13.12,Default,,0,0,0,,Финалдың уақыты келді. ➡
Dialogue: 0,0:18:13.12,0:18:15.12,Default,,0,0,0,,Аяқта, қысқарақ.
Dialogue: 0,0:18:15.12,0:18:18.13,Default,,0,0,0,,Тоқта...Қысқарақ...
Dialogue: 0,0:18:18.13,0:18:22.16,Default,,0,0,0,,Ааааааааааааааааааааа! !
Dialogue: 0,0:18:22.16,0:18:26.17,Default,,0,0,0,,Шотаааааааа! !
Dialogue: 0,0:18:26.17,0:18:40.15,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:40.15,0:18:43.15,Default,,0,0,0,,Қысқарақ!
Dialogue: 0,0:18:46.19,0:18:49.19,Default,,0,0,0,,Күл…. ➡
Dialogue: 0,0:18:49.19,0:18:54.20,Default,,0,0,0,,Мен... енді... алмаймын...
Dialogue: 0,0:18:54.20,0:19:00.20,Default,,0,0,0,,Мені босатыңыз... Өтінемін... ➡
Dialogue: 0,0:19:00.20,0:19:02.17,Default,,0,0,0,,Ауырсынды...
Dialogue: 0,0:19:04.21,0:19:06.21,Default,,0,0,0,,Қысқарақ! ➡
Dialogue: 0,0:19:06.21,0:19:09.21,Default,,0,0,0,,Сіздің жауыңыз осында! Кәне!
Dialogue: 0,0:19:09.21,0:19:13.11,Default,,0,0,0,,Уф... Қысқарақ!
Dialogue: 0,0:19:13.11,0:19:15.12,Default,,0,0,0,,А... Жоқ!
Dialogue: 0,0:19:15.12,0:19:17.12,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:19:17.12,0:19:20.12,Default,,0,0,0,,Қаш, Эйджи! Жүгіріп кету!
Dialogue: 0,0:19:20.12,0:19:24.13,Default,,0,0,0,,Бір ғана оқ бар. Ұмытпа.
Dialogue: 0,0:19:29.13,0:19:32.23,Default,,0,0,0,,Арх! Ахх!
Dialogue: 0,0:19:32.23,0:19:37.14,Default,,0,0,0,,Ааааааааа! !
Dialogue: 0,0:19:37.14,0:19:39.14,Default,,0,0,0,,Тоқта! !
Dialogue: 0,0:19:55.16,0:20:09.17,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:09.17,0:20:13.17,Default,,0,0,0,,Қысқарақ? Эй, маған жауап берші...
Dialogue: 0,0:20:13.17,0:20:16.18,Default,,0,0,0,,Қысқарақ!
Dialogue: 0,0:20:16.18,0:20:22.18,Default,,0,0,0,,Қысқарақ…. аа….
Dialogue: 0,0:20:22.18,0:20:25.19,Default,,0,0,0,,Ха… хахаха….
Dialogue: 0,0:20:25.19,0:20:28.19,Default,,0,0,0,,Ол оны атып өлтірді. Замамиягаре! ➡
Dialogue: 0,0:20:28.19,0:20:30.19,Default,,0,0,0,,Сіз тамаша доссыз.
Dialogue: 0,0:20:30.19,0:20:33.19,Default,,0,0,0,,Шортер де бақытты болатынына сенімдімін.
Dialogue: 0,0:20:33.19,0:20:36.20,Default,,0,0,0,,Не? Сіз қалай ойлайсыз? Негганы ату қандай сезімде?
Dialogue: 0,0:20:36.20,0:20:38.20,Default,,0,0,0,,Сіз қалай ойлайсыз? Ха! ?
Dialogue: 0,0:20:38.20,0:20:41.20,Default,,0,0,0,,Уау... жүрекке соққы. Оған тиме!
Dialogue: 0,0:20:41.20,0:20:44.21,Default,,0,0,0,,Шүкір, басың аман.
Dialogue: 0,0:20:44.21,0:20:47.21,Default,,0,0,0,,Бұл ми жасушаларына қандай әсер етеді➡
Dialogue: 0,0:20:47.21,0:20:51.21,Default,,0,0,0,,Сенің ағаң да қызық, солай ма? (Автор) Көтеріңіз.
Dialogue: 0,0:20:51.21,0:20:54.22,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:20:54.22,0:20:58.22,Default,,0,0,0,,Ол затқа... тиіспе!
Dialogue: 0,0:20:58.22,0:21:02.22,Default,,0,0,0,,Қысқарақ! ! Қысқарақ! !
Dialogue: 0,0:21:02.22,0:21:07.23,Default,,0,0,0,,Қысқарақ! !
Dialogue: 0,0:21:07.23,0:21:09.23,Default,,0,0,0,,Қысқарақ….
Dialogue: 0,0:21:14.17,0:21:20.21,Default,,0,0,0,,Хехехе... хахахаха...
Dialogue: 0,0:21:20.21,0:21:23.21,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:21:23.21,0:21:28.08,Default,,0,0,0,,Өте керемет! Хахахахаха!
Dialogue: 0,0:21:32.22,0:21:39.23,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:39.23,0:21:42.20,Default,,0,0,0,,/～
