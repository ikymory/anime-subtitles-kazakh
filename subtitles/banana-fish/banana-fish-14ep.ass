Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.99,0:00:28.49,Default,,0,0,0,,Мұның бәрін өзім...
Dialogue: 0,0:00:28.49,0:00:30.49,Default,,0,0,0,,Бұл адам еңбегі емес...
Dialogue: 0,0:00:32.49,0:00:35.50,Default,,0,0,0,,《Өзіңді қорғау үшін қанша болса да➡
Dialogue: 0,0:00:35.50,0:00:39.50,Default,,0,0,0,,Тырнақтарың мен азуларың тым өткір, Күл.
Dialogue: 0,0:00:39.50,0:00:42.50,Default,,0,0,0,,Кетіңіз. Төтенше жағдай бар.
Dialogue: 0,0:00:44.51,0:00:47.51,Default,,0,0,0,,Кеш болды... Күлдің біреуі➡
Dialogue: 0,0:00:47.51,0:00:50.51,Default,,0,0,0,,Менің ойымша, ол соңғы сәтте өз ойын өзгерткен жоқ.
Dialogue: 0,0:00:50.51,0:00:52.51,Default,,0,0,0,,Егер солай болса, жақсы.
Dialogue: 0,0:00:52.51,0:00:55.52,Default,,0,0,0,,Не? (Ibe) Негізі, мен әлі де абдырап жүрмін.
Dialogue: 0,0:00:55.52,0:01:00.52,Default,,0,0,0,,Екеумізді осылай ажыратқан дұрыс па?
Dialogue: 0,0:01:00.52,0:01:03.53,Default,,0,0,0,,Мен Жапонияның тұншығуынан құтылғым келді➡
Dialogue: 0,0:01:03.53,0:01:05.53,Default,,0,0,0,,Америкаға әкелінген кезде➡
Dialogue: 0,0:01:05.53,0:01:08.53,Default,,0,0,0,,Эй Чан шынымен де жанды. ➡
Dialogue: 0,0:01:08.53,0:01:11.53,Default,,0,0,0,,Әсіресе, Күлмен танысқаннан кейін. ➡
Dialogue: 0,0:01:11.53,0:01:17.61,Default,,0,0,0,,Туған ел, туған нәсіл, өскен орта, бәрі басқаша еді, бәрібір➡
Dialogue: 0,0:01:17.61,0:01:20.54,Default,,0,0,0,,Мен өзім қалаған ең жақсы досты таптым...
Dialogue: 0,0:01:20.54,0:01:24.48,Default,,0,0,0,,Бірақ мен қайтадан тартып алмақшымын.
Dialogue: 0,0:01:24.48,0:01:26.48,Default,,0,0,0,,Сол баланы ренжітпеуге тырысу➡
Dialogue: 0,0:01:26.48,0:01:29.48,Default,,0,0,0,,Менің ойымша, бұл сізге зиян тигізуі мүмкін.
Dialogue: 0,0:01:29.48,0:01:31.49,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін➡
Dialogue: 0,0:01:31.49,0:01:34.49,Default,,0,0,0,,Бірақ қазір жағдай соншалықты үлкен болды ...
Dialogue: 0,0:01:34.49,0:01:36.49,Default,,0,0,0,,[] (Диктор) Кесаката Көшедегі бандылық тәртіпсіздік: ➡
Dialogue: 0,0:01:36.49,0:01:39.49,Default,,0,0,0,,Оны кейін полиция басып тастады➡
Dialogue: 0,0:01:39.49,0:01:41.50,Default,,0,0,0,,айналасындағы шатасу жалғасуда. ➡
Dialogue: 0,0:01:41.50,0:01:46.50,Default,,0,0,0,,Тәртіпсіздіктер қарама-қарсы топтардың басшылары арасындағы қақтығыстардан туындайды.
Dialogue: 0,0:01:46.50,0:01:48.50,Default,,0,0,0,,Жоқ! Қайтейік, Шуничи! ➡
Dialogue: 0,0:01:48.50,0:01:50.51,Default,,0,0,0,,Эйджи мұнда келмейді! (Иб) Иә! ?
Dialogue: 0,0:01:50.51,0:01:52.51,Default,,0,0,0,,Аштың орны шығар!
Dialogue: 0,0:01:52.51,0:01:54.51,Default,,0,0,0,,Ол Автормен соңғы шайқасқа шықты!
Dialogue: 0,0:01:54.51,0:01:56.51,Default,,0,0,0,,《Өлсем де➡
Dialogue: 0,0:01:56.51,0:01:58.51,Default,,0,0,0,,Сіз жұмысты жалғастырасыз ба? 》
Dialogue: 0,0:01:58.51,0:02:01.52,Default,,0,0,0,,《Ол біртүрлі әрекет етті...》➡
Dialogue: 0,0:02:01.52,0:02:04.02,Default,,0,0,0,,《Чикушо, мен неге байқамадым!? 》
Dialogue: 0,0:02:04.02,0:02:06.02,Default,,0,0,0,,Чарли Бұл менмін!
Dialogue: 0,0:02:06.02,0:02:16.03,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:37.15,0:03:40.65,Default,,0,0,0,,Пульс 61 Қан қысымы 75-42.
Dialogue: 0,0:03:40.65,0:03:43.65,Default,,0,0,0,,Қанның көп кетуі. Гипогастральды қолқаны байлау. ➡
Dialogue: 0,0:03:43.65,0:03:45.65,Default,,0,0,0,,Әйел.
Dialogue: 0,0:03:51.66,0:03:53.66,Default,,0,0,0,,《Маған олай қарама...》
Dialogue: 0,0:03:53.66,0:03:56.67,Default,,0,0,0,,《Өтінемін, маған олай қарама...》
Dialogue: 0,0:03:56.67,0:03:58.67,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:04:00.67,0:04:02.67,Default,,0,0,0,,《Ааа! 》
Dialogue: 0,0:04:02.67,0:04:04.67,Default,,0,0,0,,《Мен кісі өлтірушімін...》
Dialogue: 0,0:04:04.67,0:04:06.68,Default,,0,0,0,,《Кісі өлтіруші! ! 》
Dialogue: 0,0:04:06.68,0:04:08.68,Default,,0,0,0,,Эйдзи….
Dialogue: 0,0:04:14.85,0:04:18.85,Default,,0,0,0,,《Мен... Мені көргеніңді қаламаймын!'' ! 》
Dialogue: 0,0:04:18.85,0:04:21.86,Default,,0,0,0,,《Бұл нені білдіргені қызық...》
Dialogue: 0,0:04:24.79,0:04:27.80,Default,,0,0,0,,《Осындай жерде бос отыра алмаймын...》
Dialogue: 0,0:04:27.80,0:04:32.30,Default,,0,0,0,,《Мен дәл қазір сенің жаныңа ұшқым келеді...》
Dialogue: 0,0:04:32.30,0:04:34.30,Default,,0,0,0,,Чарли!
Dialogue: 0,0:04:34.30,0:04:36.30,Default,,0,0,0,,Күл! ? Оны сақтау мүмкін бе?
Dialogue: 0,0:04:36.30,0:04:38.31,Default,,0,0,0,,Дәрігер 50-50 дейді.
Dialogue: 0,0:04:38.31,0:04:41.31,Default,,0,0,0,,Иә! ? Не деген...
Dialogue: 0,0:04:41.31,0:04:44.31,Default,,0,0,0,,Эй Чан! ? (Чарли) Мен оны іздеп жүрмін, бірақ ➡
Dialogue: 0,0:04:44.31,0:04:47.32,Default,,0,0,0,,Сахна дәл қазір бейберекет...
Dialogue: 0,0:04:47.32,0:04:49.32,Default,,0,0,0,,⚟Макс!
Dialogue: 0,0:04:49.32,0:04:53.32,Default,,0,0,0,,Кепілмен босап жатқанда, сіз кепілмен шықтыңыз.
Dialogue: 0,0:04:53.32,0:04:55.32,Default,,0,0,0,,Жоқ, инспектор: Дұрыс...
Dialogue: 0,0:04:55.32,0:04:58.33,Default,,0,0,0,,Ал, бұл туралы кейінірек айтамын.
Dialogue: 0,0:04:58.33,0:05:01.33,Default,,0,0,0,,Операция біткен сияқты.
Dialogue: 0,0:05:01.33,0:05:03.33,Default,,0,0,0,,Жара іш пердеге жетті. ➡
Dialogue: 0,0:05:03.33,0:05:06.33,Default,,0,0,0,,Әдетте бұл көмектеспейді. Бір қарағанда нәзік көрінгенімен➡
Dialogue: 0,0:05:06.33,0:05:10.34,Default,,0,0,0,,Болаттай шыныққан денесі бар.
Dialogue: 0,0:05:10.34,0:05:13.34,Default,,0,0,0,,Олай болса, бұл пайдалы! ? ⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:05:13.34,0:05:16.34,Default,,0,0,0,,Қалғаны сіздің физикалық күшіңізге байланысты.
Dialogue: 0,0:05:23.29,0:05:27.29,Default,,0,0,0,,Сізге Аш туралы қызық па? ➡
Dialogue: 0,0:05:27.29,0:05:29.29,Default,,0,0,0,,Ол өлмейді. ➡
Dialogue: 0,0:05:29.29,0:05:32.29,Default,,0,0,0,,Автор сияқты бейбақ... ➡
Dialogue: 0,0:05:32.29,0:05:34.30,Default,,0,0,0,,Жоқ, мұны ешкім жасай алмайды.
Dialogue: 0,0:05:34.30,0:05:37.30,Default,,0,0,0,,Ол ешқандай мүмкіндік көрсетпесе.
Dialogue: 0,0:05:37.30,0:05:39.30,Default,,0,0,0,,⚟ (аяқ дыбысы)
Dialogue: 0,0:05:39.30,0:05:41.30,Default,,0,0,0,,Шин Су Лин сонда ма?
Dialogue: 0,0:05:41.30,0:05:46.31,Default,,0,0,0,,Бұл менмін. (Полиция қызметкері) шығыңыз. Сіз босатылдыңыз.
Dialogue: 0,0:05:46.31,0:05:49.31,Default,,0,0,0,,Менің достарым... (Полиция қызметкері) Эйджи Окумура, шығыңыз.
Dialogue: 0,0:05:54.32,0:05:56.32,Default,,0,0,0,,Жарайды. Екеуің маған еріңдер.
Dialogue: 0,0:05:56.32,0:05:59.32,Default,,0,0,0,,Бұл сіз көрмеген бет. Қай топ?
Dialogue: 0,0:05:59.32,0:06:03.33,Default,,0,0,0,,Ах... мен жапонмын.
Dialogue: 0,0:06:03.33,0:06:05.49,Default,,0,0,0,,Аштың досы...
Dialogue: 0,0:06:05.49,0:06:08.30,Default,,0,0,0,,Күл?
Dialogue: 0,0:06:10.33,0:06:13.34,Default,,0,0,0,,⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:06:13.34,0:06:16.34,Default,,0,0,0,,Қандай қателік, Шин Су Лин.
Dialogue: 0,0:06:16.34,0:06:21.34,Default,,0,0,0,,Ол сен бе...? Не... не істеп жатырсың! Жіберу!
Dialogue: 0,0:06:21.34,0:06:24.28,Default,,0,0,0,,Бұл! Ах. Бұл не деген жігіт...
Dialogue: 0,0:06:24.28,0:06:28.28,Default,,0,0,0,,Бұл туралы кейінірек. Жүріңіз.
Dialogue: 0,0:06:28.28,0:06:31.29,Default,,0,0,0,,Мен Эшке бұл туралы уайымдама дедім.
Dialogue: 0,0:06:31.29,0:06:34.29,Default,,0,0,0,,Мен сіздің ғашықтық сезімдеріңізді түсінемін➡
Dialogue: 0,0:06:34.29,0:06:37.29,Default,,0,0,0,,Мен бұдан былай қиындық тудырғым келмейді.
Dialogue: 0,0:06:37.29,0:06:40.30,Default,,0,0,0,,Не! ? Мен қашан ол адам боламын...
Dialogue: 0,0:06:40.30,0:06:43.30,Default,,0,0,0,,Адал бол. Ғибадат ету немесе жек көру?
Dialogue: 0,0:06:43.30,0:06:46.30,Default,,0,0,0,,Бұл өте күрделі, Шин.
Dialogue: 0,0:06:46.30,0:06:48.30,Default,,0,0,0,,Хмф! Айтыңызшы.
Dialogue: 0,0:06:48.30,0:06:52.31,Default,,0,0,0,,Оның үстіне, сен менің достарымды осылай жалғыз қалдырғың келмейді, солай ма?
Dialogue: 0,0:06:52.31,0:06:56.31,Default,,0,0,0,,Уайымдамаңыз. Мен сенің босатылуыңды дереу ұйымдастырамын.
Dialogue: 0,0:06:56.31,0:06:58.31,Default,,0,0,0,,Қосымша➡
Dialogue: 0,0:06:58.31,0:07:01.32,Default,,0,0,0,,Қабыл Қанды да босатады ма екен...
Dialogue: 0,0:07:01.32,0:07:03.32,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:07:03.32,0:07:05.32,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:05.32,0:07:07.32,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,0:07:07.32,0:07:10.33,Default,,0,0,0,,Мына жапонды құлыптаңыз.
Dialogue: 0,0:07:10.33,0:07:12.33,Default,,0,0,0,,Дегенмен, өрескел ештеңе жасамаңыз.
Dialogue: 0,0:07:12.33,0:07:14.33,Default,,0,0,0,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,0:07:20.34,0:07:24.27,Default,,0,0,0,,Бауырым, бұл жақсы емес. Бөлмеден шығыңыз.
Dialogue: 0,0:07:24.27,0:07:27.28,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:07:27.28,0:07:31.28,Default,,0,0,0,,Сен жақсы қызсың ғой, бөлмеңе қайтайық. Эй? ➡
Dialogue: 0,0:07:31.28,0:07:34.28,Default,,0,0,0,,Менің ағам ауырып жатыр.
Dialogue: 0,0:07:34.28,0:07:37.29,Default,,0,0,0,,Науқас! ? Өйткені ол сияқты...
Dialogue: 0,0:07:37.29,0:07:39.29,Default,,0,0,0,,Сіз басқа адаммын дейсіз бе?
Dialogue: 0,0:07:39.29,0:07:43.29,Default,,0,0,0,,Мына менмен және өршіл Ли Хуалун кім? ➡
Dialogue: 0,0:07:43.29,0:07:47.30,Default,,0,0,0,,Иә, менің ағам жай ғана қуыршаққа айналды. ➡
Dialogue: 0,0:07:47.30,0:07:52.30,Default,,0,0,0,,Не болды? Сіз ағаңызды жек көрдіңіз, солай ма?
Dialogue: 0,0:07:52.30,0:07:55.30,Default,,0,0,0,,Шындығында, мен де емеспін. ➡
Dialogue: 0,0:07:55.30,0:07:58.31,Default,,0,0,0,,Хахахаха! Хахахаха!
Dialogue: 0,0:08:00.31,0:08:03.31,Default,,0,0,0,,Мен оларды сағындым.
Dialogue: 0,0:08:03.31,0:08:06.31,Default,,0,0,0,,《Бұл не дыбыс...》
Dialogue: 0,0:08:06.31,0:08:09.32,Default,,0,0,0,,《Қайда? Міне...》
Dialogue: 0,0:08:09.32,0:08:12.32,Default,,0,0,0,,《Менің денем қозғалмайды...》
Dialogue: 0,0:08:12.32,0:08:15.32,Default,,0,0,0,,《Менің аяқ-қолым қорғасынға ұқсайды.》
Dialogue: 0,0:08:21.33,0:08:26.27,Default,,0,0,0,,《Мен... өлемін бе? 》
Dialogue: 0,0:08:26.27,0:08:30.27,Default,,0,0,0,,《Қандай тыныш және тыныш...》
Dialogue: 0,0:08:30.27,0:08:33.27,Default,,0,0,0,,《Қасірет өтірік сияқты》
Dialogue: 0,0:08:35.28,0:08:42.28,Default,,0,0,0,,《Өлім бәрін, соның ішінде қайғы мен қуанышты да ақырын алып кетеді.》
Dialogue: 0,0:08:42.28,0:08:44.29,Default,,0,0,0,,⚟ (Есіктің ашылған дыбысы) Ах!
Dialogue: 0,0:08:44.29,0:08:48.29,Default,,0,0,0,,Бұл қорқынышты бет. Алып жемесем де.
Dialogue: 0,0:08:48.29,0:08:50.29,Default,,0,0,0,,Өзіңді осындай жерге қамап қою дегенді қалай түсінесің? ?
Dialogue: 0,0:08:50.29,0:08:53.29,Default,,0,0,0,,Менің баратын жерім бар!
Dialogue: 0,0:08:53.29,0:08:55.30,Default,,0,0,0,,Сен Аштың орнына бардың➡
Dialogue: 0,0:08:55.30,0:08:58.30,Default,,0,0,0,,Сіз ештеңе істей алмайсыз.
Dialogue: 0,0:08:58.30,0:09:01.30,Default,,0,0,0,,Не... білесің! ? Әрине.
Dialogue: 0,0:09:01.30,0:09:06.31,Default,,0,0,0,,Операция сәтті өтті және ең жақсы ем жүргізілуде.
Dialogue: 0,0:09:06.31,0:09:08.31,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:08.31,0:09:10.31,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:09:10.31,0:09:12.31,Default,,0,0,0,,Дегенмен, жағымсыз жаңалықтар да бар.
Dialogue: 0,0:09:12.31,0:09:14.32,Default,,0,0,0,,Гольцин үйіне қайтып келеді.
Dialogue: 0,0:09:14.32,0:09:17.32,Default,,0,0,0,,Иә! ? Әрине оның орнында➡
Dialogue: 0,0:09:17.32,0:09:19.32,Default,,0,0,0,,Менің ойымша, онда ақпарат бар.
Dialogue: 0,0:09:19.32,0:09:21.32,Default,,0,0,0,,Күл ауыр жарақат алып, қозғала алмайды➡
Dialogue: 0,0:09:21.32,0:09:25.26,Default,,0,0,0,,Әлгі дәмсіз қария тіл жалап, қандай бетке батты➡
Dialogue: 0,0:09:25.26,0:09:27.26,Default,,0,0,0,,Көзімде қалқып бара жатқан сияқты.
Dialogue: 0,0:09:30.27,0:09:32.27,Default,,0,0,0,,Қайда бара жатырсың? Мен үйге бара жатырмын.
Dialogue: 0,0:09:32.27,0:09:35.27,Default,,0,0,0,,Сонымен, сіз не істей аласыз?
Dialogue: 0,0:09:37.27,0:09:40.28,Default,,0,0,0,,Достар? Бұл мені күлдіреді.
Dialogue: 0,0:09:40.28,0:09:43.28,Default,,0,0,0,,Сіз өзіңізді қаншамын деп ойлайсыз?
Dialogue: 0,0:09:43.28,0:09:48.28,Default,,0,0,0,,Сол теңдесі жоқ Күлді Сілеусінмен салыстырғанда.
Dialogue: 0,0:09:48.28,0:09:51.29,Default,,0,0,0,,Оған достар керек емес. ➡
Dialogue: 0,0:09:51.29,0:09:53.29,Default,,0,0,0,,Күл – жабайы аң. ➡
Dialogue: 0,0:09:53.29,0:09:57.36,Default,,0,0,0,,Ешкім басқармайтын, еркін жүретін әдемі аң. ➡
Dialogue: 0,0:09:57.36,0:10:00.30,Default,,0,0,0,,Оның абсолютті жанкүйері бар ма➡
Dialogue: 0,0:10:00.30,0:10:03.30,Default,,0,0,0,,Тек автор сияқты қарсылас керек.
Dialogue: 0,0:10:03.30,0:10:07.30,Default,,0,0,0,,Басқа адамдар қажет емес.
Dialogue: 0,0:10:07.30,0:10:11.31,Default,,0,0,0,,Ал сен оны тек ұстап тұрсың.
Dialogue: 0,0:10:11.31,0:10:16.31,Default,,0,0,0,,Сіз мұны түсінбейсіз бе? Сен ақымақсың.
Dialogue: 0,0:10:16.31,0:10:20.32,Default,,0,0,0,,Не болды? Біртүрлі бет жасаңыз.
Dialogue: 0,0:10:20.32,0:10:23.32,Default,,0,0,0,,Жастар мені жиі мазақ ететін сияқты➡
Dialogue: 0,0:10:23.32,0:10:28.32,Default,,0,0,0,,Мен басқа адамның мұндай ашық дұшпандығына бірінші рет тап болдым.
Dialogue: 0,0:10:28.32,0:10:32.33,Default,,0,0,0,,Мүлдем... адамдарды ренжітпе.
Dialogue: 0,0:10:32.33,0:10:36.33,Default,,0,0,0,,Сіз басқа адамдарға қандай да бір сезім тудыратын сияқтысыз.
Dialogue: 0,0:10:36.33,0:10:39.33,Default,,0,0,0,,Күл сияқты қорғанысқа деген құштарлықты оята аласыз ба?
Dialogue: 0,0:10:39.33,0:10:42.34,Default,,0,0,0,,Әйтпесе мен сені жұлып аламын➡
Dialogue: 0,0:10:42.34,0:10:44.34,Default,,0,0,0,,Оны таптағың келе ме?
Dialogue: 0,0:10:44.34,0:10:47.34,Default,,0,0,0,,Өкінішке орай, бұл соңғысы деп ойлаймын.
Dialogue: 0,0:10:47.34,0:10:51.35,Default,,0,0,0,,Ақылға сыймайтын арамдық деген бар.
Dialogue: 0,0:10:51.35,0:10:55.35,Default,,0,0,0,,Сіз тіпті елестете алмайсыз, солай ма?
Dialogue: 0,0:10:55.35,0:10:58.35,Default,,0,0,0,,Енді... сенімен не істеуім керек?
Dialogue: 0,0:11:02.86,0:11:04.86,Default,,0,0,0,,⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:11:04.86,0:11:07.20,Default,,0,0,0,,Сәлем. Өзіңізді қалай сезінесіз?
Dialogue: 0,0:11:07.20,0:11:09.20,Default,,0,0,0,,Сіз қайтадан өле алмадыңыз.
Dialogue: 0,0:11:09.20,0:11:13.20,Default,,0,0,0,,Менің айтып тұрғаным бұл емес. Маған көмектескеніңізге қуаныштымын.
Dialogue: 0,0:11:13.20,0:11:15.20,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:11:15.20,0:11:18.21,Default,,0,0,0,,Сіз не істегеніңізді білесіз, солай ма?
Dialogue: 0,0:11:18.21,0:11:21.21,Default,,0,0,0,,Сіз де қазір 18-десіз. Бала емес.
Dialogue: 0,0:11:21.21,0:11:24.15,Default,,0,0,0,,Мен заңға мән бермей өмір сүрдім.
Dialogue: 0,0:11:24.15,0:11:26.98,Default,,0,0,0,,Мен қазір заңмен қорғалғым келмейді➡
Dialogue: 0,0:11:26.98,0:11:29.15,Default,,0,0,0,,Мен жәндіктердің жақсы жақтарын ойламаймын.
Dialogue: 0,0:11:29.15,0:11:31.15,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:31.15,0:11:34.16,Default,,0,0,0,,Бұл бірнеше күн бұрын болды➡
Dialogue: 0,0:11:34.16,0:11:38.16,Default,,0,0,0,,Бұл өмір мен өлімнің арасында жүрген адамның желісі ме?
Dialogue: 0,0:11:40.16,0:11:43.16,Default,,0,0,0,,Егер сіз небәрі 8 жаста сексуалдық зорлық-зомбылыққа ұшырасаңыз➡
Dialogue: 0,0:11:43.16,0:11:47.17,Default,,0,0,0,,Тәртіп пен тәртіпті ақымақ деп ойлай бастасам да ➡
Dialogue: 0,0:11:47.17,0:11:49.17,Default,,0,0,0,,Менің ойымша, бұл негізсіз емес.
Dialogue: 0,0:11:49.17,0:11:52.17,Default,,0,0,0,,Қылмыскер мен жәбірленушінің арасында жұқа сызық бар ма?
Dialogue: 0,0:11:52.17,0:11:55.18,Default,,0,0,0,,Мен оны аяқтай алмаймын.
Dialogue: 0,0:11:55.18,0:11:58.18,Default,,0,0,0,,Уф… шіркін….
Dialogue: 0,0:12:00.18,0:12:04.19,Default,,0,0,0,,《Ол үйге келмеді...》
Dialogue: 0,0:12:11.19,0:12:14.20,Default,,0,0,0,,⚟(Есіктің ашылған дыбысы) ⚟(Салли) Иә, кешіріңіз➡
Dialogue: 0,0:12:14.20,0:12:16.20,Default,,0,0,0,,Полиция қызметкері. иә?
Dialogue: 0,0:12:16.20,0:12:19.20,Default,,0,0,0,,Сәлем. Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:19.20,0:12:22.14,Default,,0,0,0,,Енді біз сізге жауаптымыз.
Dialogue: 0,0:12:22.14,0:12:24.14,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:12:24.14,0:12:27.14,Default,,0,0,0,,Ах... иә... танысқаныма қуаныштымын...
Dialogue: 0,0:12:27.14,0:12:30.14,Default,,0,0,0,,Біз тапсырысымызды шешіп қойдық.
Dialogue: 0,0:12:30.14,0:12:33.15,Default,,0,0,0,,Олай болса, маған дереу қоңырау шалыңыз.
Dialogue: 0,0:12:33.15,0:12:35.15,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:35.15,0:12:38.15,Default,,0,0,0,,Әрине, бұл.
Dialogue: 0,0:12:38.15,0:12:42.22,Default,,0,0,0,,Өтінемін, оларды менен алыс ұстаңыз!
Dialogue: 0,0:12:42.22,0:12:45.16,Default,,0,0,0,,Олар мені ваннаға жалғыз баруға рұқсат бермейді!
Dialogue: 0,0:12:45.16,0:12:47.16,Default,,0,0,0,,Бұл сәнді денсаулық!
Dialogue: 0,0:12:47.16,0:12:49.16,Default,,0,0,0,,Мұны естіген ақ киімді періште таң қалады!
Dialogue: 0,0:12:49.16,0:12:51.17,Default,,0,0,0,,⚟ ⚟(Полиция қызметкері) инспекторы.
Dialogue: 0,0:12:51.17,0:12:54.17,Default,,0,0,0,,Бір сәт кешіріңіз.
Dialogue: 0,0:12:54.17,0:12:57.17,Default,,0,0,0,,Сұлу бала болу да оңай емес.
Dialogue: 0,0:12:57.17,0:13:02.18,Default,,0,0,0,,Эйджиді кездестірдіңіз бе? Ол мұнда келді ме?
Dialogue: 0,0:13:02.18,0:13:04.18,Default,,0,0,0,,Не? аа….
Dialogue: 0,0:13:04.18,0:13:08.18,Default,,0,0,0,,Бірақ мен адвокатымнан басқа ешкімді көре алмаймын.
Dialogue: 0,0:13:08.18,0:13:11.19,Default,,0,0,0,,Хмм…. ⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:13:11.19,0:13:14.19,Default,,0,0,0,,Бұл Прокуратурадан Альпер мырза.
Dialogue: 0,0:13:14.19,0:13:16.19,Default,,0,0,0,,Интеллект тесті?
Dialogue: 0,0:13:16.19,0:13:19.19,Default,,0,0,0,,Бұл жай ғана формальдылық.
Dialogue: 0,0:13:19.19,0:13:21.20,Default,,0,0,0,,Өйткені бұл міндетті.
Dialogue: 0,0:13:21.20,0:13:25.13,Default,,0,0,0,,Мен кәдімгі жынды жігітпін бе, әлде нағыз жынды жігітпін бе➡
Dialogue: 0,0:13:25.13,0:13:27.14,Default,,0,0,0,,Неліктен білгіңіз келеді? (Әлпер) Ах ха!
Dialogue: 0,0:13:27.14,0:13:29.14,Default,,0,0,0,,Сіз жақсы әзілкешсіз.
Dialogue: 0,0:13:32.14,0:13:34.14,Default,,0,0,0,,Менің сұрағым бар. (Альпер) А? ➡
Dialogue: 0,0:13:34.14,0:13:37.15,Default,,0,0,0,,Не? Бұл сіз түсінбейтін сөз болса да?
Dialogue: 0,0:13:37.15,0:13:40.15,Default,,0,0,0,,Жоқ, ол осында...
Dialogue: 0,0:13:40.15,0:13:42.15,Default,,0,0,0,,《Жоғары математика! ? 》
Dialogue: 0,0:13:42.15,0:13:44.15,Default,,0,0,0,,Соңғы сұрақ➡
Dialogue: 0,0:13:44.15,0:13:47.16,Default,,0,0,0,,Мен бұл Фибоначчи тізбегі болуы мүмкін деп ойладым.
Dialogue: 0,0:13:47.16,0:13:49.16,Default,,0,0,0,,Бірақ 3-тен кейін 5 болады.
Dialogue: 0,0:13:49.16,0:13:51.16,Default,,0,0,0,,Алайда бұл есепте 6-ға тең.
Dialogue: 0,0:13:51.16,0:13:53.16,Default,,0,0,0,,Сонымен, алдыңғы мүшеге сүйенбей-ақ кез келген сандық мән алуға болады➡
Dialogue: 0,0:13:53.16,0:13:55.16,Default,,0,0,0,,f(x) формуласы бар деп есептеп көрейік...
Dialogue: 0,0:13:55.16,0:14:03.17,Default,,0,0,0,,(Аштың сөйлейтін дауысы)
Dialogue: 0,0:14:03.17,0:14:06.17,Default,,0,0,0,,Әлде бұл мен білмейтін жаңа математикалық теория ма?
Dialogue: 0,0:14:06.17,0:14:09.18,Default,,0,0,0,,Өйткені, мен бастауыш сыныпқа да дұрыс бармадым.
Dialogue: 0,0:14:09.18,0:14:11.18,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:14:11.18,0:14:14.18,Default,,0,0,0,,Осыдан кейін өзіңізді мұны істеуге мәжбүрлеудің қажеті жоқ. ➡
Dialogue: 0,0:14:14.18,0:14:17.19,Default,,0,0,0,,Енді келесі тестті орындайық... ➡
Dialogue: 0,0:14:17.19,0:14:19.19,Default,,0,0,0,,Бұл неге ұқсайды?
Dialogue: 0,0:14:19.19,0:14:21.19,Default,,0,0,0,,Сіздің әйеліңіз.
Dialogue: 0,0:14:21.19,0:14:24.13,Default,,0,0,0,,Мен IQ 180-ге таң қалдым. ➡
Dialogue: 0,0:14:24.13,0:14:28.13,Default,,0,0,0,,Бұл бала есімде. Сол енот әке➡
Dialogue: 0,0:14:28.13,0:14:31.13,Default,,0,0,0,,Олар маған түніне 20 000 доллар болатынын айтты.
Dialogue: 0,0:14:31.13,0:14:34.14,Default,,0,0,0,,Ол кезде Гольцин онымен жұмыс істеп жатқан болатын➡
Dialogue: 0,0:14:34.14,0:14:37.14,Default,,0,0,0,,Менің ойымша, ол оны басқа біреуге сатқаны үшін ренжіді.
Dialogue: 0,0:14:37.14,0:14:40.14,Default,,0,0,0,,Бірақ ол да қателесті.
Dialogue: 0,0:14:40.14,0:14:43.14,Default,,0,0,0,,Бірақ бұл жоспармен не болады? ➡
Dialogue: 0,0:14:43.14,0:14:47.15,Default,,0,0,0,,Мен осы уақытқа дейін жасаған барлық ауыр жұмыс пен инвестицияның бекер болғанын қаламаймын.
Dialogue: 0,0:14:47.15,0:14:51.15,Default,,0,0,0,,Уайымдамаңыз. Жобада ешқандай проблемалар жоқ.
Dialogue: 0,0:14:51.15,0:14:54.16,Default,,0,0,0,,Не болса да, мен бұл баладан құтыламын.
Dialogue: 0,0:14:54.16,0:14:56.16,Default,,0,0,0,,Бірақ егер олар Гольциннен тірідей ұсталса➡
Dialogue: 0,0:14:56.16,0:14:58.16,Default,,0,0,0,,Мені тапсыруларыңызды қалаймын.
Dialogue: 0,0:14:58.16,0:15:00.16,Default,,0,0,0,,Осындай жайбарақат айта аласыз ба?
Dialogue: 0,0:15:00.16,0:15:03.16,Default,,0,0,0,,Бұл бала да маған➡
Dialogue: 0,0:15:03.16,0:15:06.17,Default,,0,0,0,,Бұл біз үшін де өлімге әкелуі мүмкін. ➡
Dialogue: 0,0:15:06.17,0:15:08.17,Default,,0,0,0,,Оның жолы болмады. ➡
Dialogue: 0,0:15:08.17,0:15:12.17,Default,,0,0,0,,Әдемі болсаң, біраз өмір сүрер едің.
Dialogue: 0,0:15:12.17,0:15:14.18,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:15:14.18,0:15:16.18,Default,,0,0,0,,⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:15:23.12,0:15:25.12,Default,,0,0,0,,Саллиге не болды?
Dialogue: 0,0:15:25.12,0:15:27.12,Default,,0,0,0,,О, ояусың ба?
Dialogue: 0,0:15:27.12,0:15:31.13,Default,,0,0,0,,Салли түстен кейін кезекшілікте болуы керек. Сен кімсің?
Dialogue: 0,0:15:31.13,0:15:34.13,Default,,0,0,0,,Саллидің бір ісі бар еді, мен оның орнына отырдым.
Dialogue: 0,0:15:34.13,0:15:37.13,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:15:37.13,0:15:39.13,Default,,0,0,0,,Неліктен мұны істейсіз?
Dialogue: 0,0:15:39.13,0:15:41.14,Default,,0,0,0,,Жауап бере алмайсыз ба?
Dialogue: 0,0:15:44.14,0:15:46.14,Default,,0,0,0,,Хмф! Уф!
Dialogue: 0,0:15:46.14,0:15:48.14,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:15:52.15,0:15:54.15,Default,,0,0,0,,Не істеп жатырсың! ? Келме!
Dialogue: 0,0:15:54.15,0:15:56.15,Default,,0,0,0,,Уф! Уф...!
Dialogue: 0,0:15:56.15,0:15:58.15,Default,,0,0,0,,Айт! Менен мұны кім сұрады! ?
Dialogue: 0,0:15:58.15,0:16:01.16,Default,,0,0,0,,Мойынның сынғанын қалайсың ба? ?
Dialogue: 0,0:16:01.16,0:16:04.16,Default,,0,0,0,,(Амон) Аогири ағашы туралы не білесің?
Dialogue: 0,0:16:04.16,0:16:06.16,Default,,0,0,0,,《Ол кетті! У...》
Dialogue: 0,0:16:11.17,0:16:14.17,Default,,0,0,0,,Мына әйел маған кенет шабуыл жасады.
Dialogue: 0,0:16:14.17,0:16:16.17,Default,,0,0,0,,Ол полиция қызметкерін атып, кейін өз-өзіне қол жұмсады.
Dialogue: 0,0:16:20.17,0:16:22.11,Default,,0,0,0,,Сәлем, қария.
Dialogue: 0,0:16:22.11,0:16:24.11,Default,,0,0,0,,Оның жалған екені маған түсінікті.
Dialogue: 0,0:16:24.11,0:16:26.11,Default,,0,0,0,,Иіс.
Dialogue: 0,0:16:26.11,0:16:29.12,Default,,0,0,0,,Сіз парфюмерия қолдандыңыз ба? Бұл керісінше.
Dialogue: 0,0:16:29.12,0:16:32.12,Default,,0,0,0,,Кісі өлтіру орнында із қалдырмаңыз.
Dialogue: 0,0:16:32.12,0:16:34.12,Default,,0,0,0,,Бұл кәсіпқой болудың бірінші шарты.
Dialogue: 0,0:16:34.12,0:16:37.12,Default,,0,0,0,,Бірақ бұл өлім қағы болды.
Dialogue: 0,0:16:37.12,0:16:40.13,Default,,0,0,0,,Мен медбике болсам да, дезинфекциялық заттың иісін де сезе алмадым.
Dialogue: 0,0:16:40.13,0:16:42.20,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:42.20,0:16:45.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.13,0:16:47.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:47.13,0:16:50.14,Default,,0,0,0,,Күл! Ах...
Dialogue: 0,0:16:50.14,0:16:52.14,Default,,0,0,0,,《Бұл жақсы емес…》➡
Dialogue: 0,0:16:52.14,0:16:55.14,Default,,0,0,0,,《Мен бұл жігітті бұл жерде қалдыра алмаймын.》
Dialogue: 0,0:16:55.14,0:16:59.15,Default,,0,0,0,,Бір ғана баланың соншалықты қиын болатынына сену қиын...
Dialogue: 0,0:16:59.15,0:17:02.15,Default,,0,0,0,,Маған осы мәселе бойынша доктор Маннерхаймнан ұсыныс түсті.
Dialogue: 0,0:17:02.15,0:17:05.15,Default,,0,0,0,,Ол бала сізді қызықтыратын сияқты.
Dialogue: 0,0:17:05.15,0:17:08.16,Default,,0,0,0,,Жарайсыңдар, алақандарыңды соғыңдар.
Dialogue: 0,0:17:08.16,0:17:11.16,Default,,0,0,0,,Еңбегіңізге рахмет, инспектор.
Dialogue: 0,0:17:11.16,0:17:14.16,Default,,0,0,0,,Бұдан былай бұл іске біз жауапты боламыз.
Dialogue: 0,0:17:14.16,0:17:18.17,Default,,0,0,0,,Сіз нені айтасыз! ? Бастық: Неліктен ФБР...?
Dialogue: 0,0:17:18.17,0:17:20.17,Default,,0,0,0,,Бұл жоғарыдан келген бұйрық. ➡
Dialogue: 0,0:17:20.17,0:17:23.10,Default,,0,0,0,,Біз енді бұл оқиғаға араласпаймыз.
Dialogue: 0,0:17:23.10,0:17:25.11,Default,,0,0,0,,Міне...
Dialogue: 0,0:17:25.11,0:17:29.11,Default,,0,0,0,,Тіпті дәрігер де таң қалды. Барлық операциялардан кейін➡
Dialogue: 0,0:17:29.11,0:17:32.11,Default,,0,0,0,,Мен науқастың жабайы болғанын бірінші рет көруім.
Dialogue: 0,0:17:32.11,0:17:34.12,Default,,0,0,0,,Сізге рахмет, бұл жақсы жаттығу болды.
Dialogue: 0,0:17:34.12,0:17:36.12,Default,,0,0,0,,Тамақ ішіп, ұйықтайтындықтан, салмақ қосамын деп ойлаймын.
Dialogue: 0,0:17:36.12,0:17:40.12,Default,,0,0,0,,Батырмаңыз. Сіз бозарған сияқтысыз.
Dialogue: 0,0:17:40.12,0:17:42.19,Default,,0,0,0,,Мен өзім ренжіп барамын.
Dialogue: 0,0:17:42.19,0:17:46.13,Default,,0,0,0,,Менің денем мен қалаған нәрсені жасай алмайды.
Dialogue: 0,0:17:46.13,0:17:49.13,Default,,0,0,0,,Егер сіз осында қалсаңыз, бұл көп рет болады.
Dialogue: 0,0:17:49.13,0:17:51.13,Default,,0,0,0,,Оның ішінде Гольцин➡
Dialogue: 0,0:17:51.13,0:17:55.14,Default,,0,0,0,,Сенің тірі қалғаныңды қаламайтындар көп.
Dialogue: 0,0:17:55.14,0:17:58.14,Default,,0,0,0,,Бірақ бұл жолы қарияның еркі емес.
Dialogue: 0,0:17:58.14,0:18:02.14,Default,,0,0,0,,Ол мені тірідей ұстап алып өлтірер еді.
Dialogue: 0,0:18:02.14,0:18:06.15,Default,,0,0,0,,Гольцин келесі аптада Жапонияға оралатын сияқты.
Dialogue: 0,0:18:06.15,0:18:10.15,Default,,0,0,0,,Хмм. Мен жақсы таксидермист таптым ба деп ойлаймын.
Dialogue: 0,0:18:10.15,0:18:12.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:12.15,0:18:16.16,Default,,0,0,0,,Сонымен, сен GOOSE-тің қос кітапшасын ұрлап алдың.
Dialogue: 0,0:18:16.16,0:18:21.16,Default,,0,0,0,,Мен ол үйге оралғанда онымен осы тақырыпты бөлісемін деп ойладым.
Dialogue: 0,0:18:21.16,0:18:23.10,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:18:23.10,0:18:25.10,Default,,0,0,0,,Дәл қазір сіз жай ғана штаттан тыс репортерсіз.
Dialogue: 0,0:18:25.10,0:18:29.10,Default,,0,0,0,,Бұл туралы блогыңызға жазасыз ба? Сіз жай ғана күлесіз.
Dialogue: 0,0:18:29.10,0:18:32.11,Default,,0,0,0,,Кішкене мәселе бар.
Dialogue: 0,0:18:32.11,0:18:36.11,Default,,0,0,0,,Өте сақ болыңыз. Мен сені бұл жерден алып шығуды қамтамасыз етемін.
Dialogue: 0,0:18:36.11,0:18:38.11,Default,,0,0,0,,Сіз?
Dialogue: 0,0:18:38.11,0:18:40.11,Default,,0,0,0,,Әкеңе сен.
Dialogue: 0,0:18:40.11,0:18:42.12,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:18:44.12,0:18:47.12,Default,,0,0,0,,Мен сене алар емеспін. Бұл жұмбақ роман сияқты.
Dialogue: 0,0:18:47.12,0:18:50.12,Default,,0,0,0,,Бірақ Бас редактор, ақыл-ойды басқаруды дамыту ➡ болып табылады
Dialogue: 0,0:18:50.12,0:18:53.13,Default,,0,0,0,,Бұл барлық барлау органдарының орындалмаған арманы.
Dialogue: 0,0:18:53.13,0:18:56.13,Default,,0,0,0,,Бұрын бұл жай ғана арман болатын.
Dialogue: 0,0:18:56.13,0:19:00.13,Default,,0,0,0,,2000 жылдары ол қайтадан назар аудара бастады.
Dialogue: 0,0:19:00.13,0:19:03.14,Default,,0,0,0,,Кейбір дәрілік заттардың пайда болуымен.
Dialogue: 0,0:19:03.14,0:19:05.14,Default,,0,0,0,,Бұл банан балығы қандай?
Dialogue: 0,0:19:05.14,0:19:07.14,Default,,0,0,0,,Бұл өткен күні болды➡
Dialogue: 0,0:19:07.14,0:19:11.15,Default,,0,0,0,,Сенатор Питер Грантты өлтірумен байланысты.
Dialogue: 0,0:19:11.15,0:19:13.15,Default,,0,0,0,,Оның бұл оқиғасы дәлелденсе➡
Dialogue: 0,0:19:13.15,0:19:16.15,Default,,0,0,0,,Біз үлкен қастандықты аша аламыз!
Dialogue: 0,0:19:16.15,0:19:20.15,Default,,0,0,0,,Жарайды, сенімен шарт жасасайық.
Dialogue: 0,0:19:22.09,0:19:24.09,Default,,0,0,0,,[(дірілдеткіш дыбыс) Ах...
Dialogue: 0,0:19:24.09,0:19:26.09,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:19:26.09,0:19:29.10,Default,,0,0,0,,Не... не?! ?
Dialogue: 0,0:19:29.10,0:19:31.10,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:19:31.10,0:19:34.10,Default,,0,0,0,,Сіздің ісіңізді енді біз қараймыз.
Dialogue: 0,0:19:34.10,0:19:37.10,Default,,0,0,0,,ФБР? (МакМерфи) Өткен күні психологиялық тестте➡
Dialogue: 0,0:19:37.10,0:19:41.11,Default,,0,0,0,,Нәтижелер сіздің психикалық жағдайыңыздың проблемалы екенін көрсетеді.
Dialogue: 0,0:19:41.11,0:19:45.11,Default,,0,0,0,,Алдымен Ұлттық психикалық денсаулық орталығында тексеруден өтіңіз.
Dialogue: 0,0:19:47.11,0:19:49.12,Default,,0,0,0,,Ол тағы да қашпақ болды.
Dialogue: 0,0:19:49.12,0:19:52.12,Default,,0,0,0,,А... Сіз қатты тырысып жатырсыз, солай емес пе?
Dialogue: 0,0:19:52.12,0:19:55.12,Default,,0,0,0,,⚟ ⚟ (есіктің ашылған дыбысы)
Dialogue: 0,0:19:55.12,0:19:57.12,Default,,0,0,0,,Ай Айдаһар.
Dialogue: 0,0:19:57.12,0:20:00.13,Default,,0,0,0,,Күл сілеусін ауруханадан шықты.
Dialogue: 0,0:20:04.13,0:20:07.13,Default,,0,0,0,,《Тіке жүріп, солға бұрыл. Қайтадан оңға бұрылыңыз...》
Dialogue: 0,0:20:07.13,0:20:11.14,Default,,0,0,0,,《Бұл біз солтүстікке бара жатырмыз дегенді білдіреді》
Dialogue: 0,0:20:11.14,0:20:14.14,Default,,0,0,0,,《Тасқынның иісі. Өзен бойындағы тас жол? 》
Dialogue: 0,0:20:14.14,0:20:19.15,Default,,0,0,0,,《Жоқ, бұл көпір. Көпірден өту》
Dialogue: 0,0:20:19.15,0:20:21.15,Default,,0,0,0,,《Нью-Джерси》
Dialogue: 0,0:20:21.15,0:20:23.15,Default,,0,0,0,,Сіз өте тынышсыз.
Dialogue: 0,0:20:23.15,0:20:27.15,Default,,0,0,0,,Оның IQ деңгейі өте жақсы➡
Dialogue: 0,0:20:27.15,0:20:30.16,Default,,0,0,0,,Ол ондаған адамды өлтірген қанішерге ұқсамайды.
Dialogue: 0,0:20:30.16,0:20:33.16,Default,,0,0,0,,Тіпті сендер FBI-ға ұқсамайсыңдар.
Dialogue: 0,0:20:33.16,0:20:37.16,Default,,0,0,0,,Том Стюарт костюмі, Франко галстук.
Dialogue: 0,0:20:37.16,0:20:39.17,Default,,0,0,0,,Холденнің соңғысы.
Dialogue: 0,0:20:39.17,0:20:42.17,Default,,0,0,0,,Бұл күлкілі, мені күлдіреді.
Dialogue: 0,0:20:42.17,0:20:46.17,Default,,0,0,0,,Мен көремін. Әрине, біз сақтықты төмендете алмайтын сияқтымыз.
Dialogue: 0,0:20:49.18,0:20:52.18,Default,,0,0,0,,Қош келдіңіз, Күлді сілеусін.
Dialogue: 0,0:20:52.18,0:20:56.18,Default,,0,0,0,,Мен доктор Манорхайммын, мұнда жауапты адаммын.
Dialogue: 0,0:20:58.19,0:21:00.19,Default,,0,0,0,,Әйтеуір, ертең Джорджға бас иемін.
Dialogue: 0,0:21:00.19,0:21:04.19,Default,,0,0,0,,Егер сіз адвокатпен жұмыс жасасаңыз, олар сізбен кездесуден бас тарта алмайды...
Dialogue: 0,0:21:04.19,0:21:07.19,Default,,0,0,0,,[(дірілдеткіш дыбысы) Иә?
Dialogue: 0,0:21:07.19,0:21:09.20,Default,,0,0,0,,Сәлеметсіз бе. [(Чарли) Макс Жаңалықты қараңыз! ➡
Dialogue: 0,0:21:09.20,0:21:12.20,Default,,0,0,0,,Асығыңыз! иә?
Dialogue: 0,0:21:12.20,0:21:14.20,Default,,0,0,0,,[] (Диктор) Себеп анықталуда. ➡
Dialogue: 0,0:21:14.20,0:21:17.20,Default,,0,0,0,,Ол бақталас көше бандыларының басшылары арасындағы жанжалға байланысты қамауға алынды.
Dialogue: 0,0:21:17.20,0:21:19.21,Default,,0,0,0,,Міне... [] (Диктор) Күлді сілеусін 18 жаста ➡
Dialogue: 0,0:21:19.21,0:21:22.14,Default,,0,0,0,,Ауыр жарақатпен қаладағы ауруханаға түсті➡
Dialogue: 0,0:21:22.14,0:21:26.15,Default,,0,0,0,,Кеса Мимей Ұлттық психикалық денсаулық орталығына ауыстырылды➡
Dialogue: 0,0:21:26.15,0:21:28.15,Default,,0,0,0,,Қайтыс болды.
Dialogue: 0,0:21:30.15,0:21:35.16,Default,,0,0,0,,《Өлді... Өлді... Өлді...》
Dialogue: 0,0:21:35.16,0:21:38.16,Default,,0,0,0,,《Өлген...》
Dialogue: 0,0:21:42.16,0:21:52.07,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:53.57,0:21:58.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
