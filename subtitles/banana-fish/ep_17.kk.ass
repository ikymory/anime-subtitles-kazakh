Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Эш операциясын сәтті аяқтады➡
Dialogue: 0,0:00:06.00,0:00:08.00,Default,,0,0,0,,Бұл ақпарат сенімді дереккөзден алынған.
Dialogue: 0,0:00:08.00,0:00:10.01,Default,,0,0,0,,Бірақ оның кенеттен қайтыс болғаны қызық.
Dialogue: 0,0:00:10.01,0:00:12.01,Default,,0,0,0,,Міне...
Dialogue: 0,0:00:12.01,0:00:15.01,Default,,0,0,0,,Бір хабар әр жерде қайта-қайта беріліп жатты.
Dialogue: 0,0:00:15.01,0:00:17.35,Default,,0,0,0,,Бұл сөзсіз жалған ақпарат!
Dialogue: 0,0:00:17.35,0:00:20.35,Default,,0,0,0,,Сол орталықты салған Гольцин болды.
Dialogue: 0,0:00:20.35,0:00:22.35,Default,,0,0,0,,Шынымен! ? Мына жігіт➡
Dialogue: 0,0:00:22.35,0:00:26.36,Default,,0,0,0,,Сенімді ақпаратпен. ⚟Бұл ақпарат кешіктірілді.
Dialogue: 0,0:00:26.36,0:00:29.36,Default,,0,0,0,,Бастық! ? Шынайы ма?
Dialogue: 0,0:00:31.36,0:00:35.36,Default,,0,0,0,,Не? Сол ақымақ жағы. Мен зомбиге ұқсаймын ба?
Dialogue: 0,0:00:35.36,0:00:37.37,Default,,0,0,0,,《Бұл шын...》
Dialogue: 0,0:00:37.37,0:00:40.37,Default,,0,0,0,,Неліктен мұнда? Мен Кейннен сұрадым.
Dialogue: 0,0:00:40.37,0:00:43.37,Default,,0,0,0,,Эйджи сенімен бірге босатылды.
Dialogue: 0,0:00:43.37,0:00:46.38,Default,,0,0,0,,Сонымен қатар, сен мұнда не істеп жүрсің?
Dialogue: 0,0:00:46.38,0:00:49.38,Default,,0,0,0,,Мен саған көмектесейін деп едім.
Dialogue: 0,0:00:49.38,0:00:51.38,Default,,0,0,0,,Мен барлық аудармаларды осы жігіттен естідім.
Dialogue: 0,0:00:51.38,0:00:55.38,Default,,0,0,0,,Неліктен Шортерді өлтіруге тура келді?
Dialogue: 0,0:00:55.38,0:00:57.69,Default,,0,0,0,,Ой! Ауырды... Не істеуім керек? Менің артымнан ермеңіздер!
Dialogue: 0,0:00:59.72,0:01:01.66,Default,,0,0,0,,Бұл туралы ешкімге айтпа.
Dialogue: 0,0:01:01.66,0:01:04.66,Default,,0,0,0,,Неліктен? Неге олай айту керек еді...
Dialogue: 0,0:01:04.66,0:01:06.66,Default,,0,0,0,,⚟(Есіктің ашылған дыбысы) ⚟Не істеп жатырсың!
Dialogue: 0,0:01:06.66,0:01:08.66,Default,,0,0,0,,Ол маған күш-қуатын бергісі келді!
Dialogue: 0,0:01:08.66,0:01:11.67,Default,,0,0,0,,Мен саған артымнан ерме дедім ғой!
Dialogue: 0,0:01:11.67,0:01:15.67,Default,,0,0,0,,Егер бұл анықталса! Мен сенің барлық достарыңды өлтіремін!
Dialogue: 0,0:01:15.67,0:01:18.67,Default,,0,0,0,,Сіз әлі де бастықсыз ба? ? Күл! Неге сен➡
Dialogue: 0,0:01:18.67,0:01:21.68,Default,,0,0,0,,Мен мұны үнемі айта алатын жалғыз жолым! ?
Dialogue: 0,0:01:21.68,0:01:23.68,Default,,0,0,0,,Ол сізге көмектесуге тырысты!
Dialogue: 0,0:01:23.68,0:01:26.68,Default,,0,0,0,,Мен сенен бір ғана нәрсені қалаймын.
Dialogue: 0,0:01:26.68,0:01:29.69,Default,,0,0,0,,Ештеңе жасамаңыз. А, түсіндім!
Dialogue: 0,0:01:29.69,0:01:33.69,Default,,0,0,0,,Егер солай болса, мен оларды енді ұстай алмаймын.
Dialogue: 0,0:01:33.69,0:01:35.69,Default,,0,0,0,,Олар үшін сіз әлі де➡сіз
Dialogue: 0,0:01:35.69,0:01:39.70,Default,,0,0,0,,Қысқарақты өлтірген жау! Тіпті мен үшін!
Dialogue: 0,0:01:39.70,0:01:41.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:41.70,0:01:44.70,Default,,0,0,0,,Қарашы, сен ашулысың. Сен де.
Dialogue: 0,0:01:44.70,0:01:47.70,Default,,0,0,0,,Сен онымен не үшін сөйлестің?
Dialogue: 0,0:01:47.70,0:01:49.71,Default,,0,0,0,,Мен сізге шындықты айтуым керек, ол әрқашан болды➡
Dialogue: 0,0:01:49.71,0:01:52.71,Default,,0,0,0,,Мен сені дұрыс түсінбедім және сені өлтірмек болдым.
Dialogue: 0,0:01:52.71,0:01:56.71,Default,,0,0,0,,Мен бұл кішкентай жігіттің мені ұруына жол бермеймін.
Dialogue: 0,0:01:56.71,0:02:00.65,Default,,0,0,0,,Шындықты білмеу өте ауыр.
Dialogue: 0,0:02:00.65,0:02:02.65,Default,,0,0,0,,Себебі мен оның сезімін дәл түсінемін➡
Dialogue: 0,0:02:02.65,0:02:05.65,Default,,0,0,0,,Мен саған шындықты айттым.
Dialogue: 0,0:02:05.65,0:02:08.66,Default,,0,0,0,,Жарайды, сен маған сене аласың деп айтпаймын.
Dialogue: 0,0:02:08.66,0:02:11.66,Default,,0,0,0,,Бірақ мен сенің маған көбірек сенгеніңді қалаймын.
Dialogue: 0,0:02:11.66,0:02:15.50,Default,,0,0,0,,Мен оларға сенбеймін деп ешкім айтқан жоқ.
Dialogue: 0,0:02:15.50,0:02:17.83,Default,,0,0,0,,Өйткені мен өзімді қауіп-қатерге араластырғым келмейді.
Dialogue: 0,0:02:17.83,0:02:21.67,Default,,0,0,0,,Мен мұны түсінемін, бірақ...
Dialogue: 0,0:02:21.67,0:02:26.68,Default,,0,0,0,,А... Меніңше, төбелескен жақсы.
Dialogue: 0,0:02:26.68,0:02:28.68,Default,,0,0,0,,Мен мұны істегім келмеді.
Dialogue: 0,0:02:35.68,0:02:38.69,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:02:51.87,0:03:01.88,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:23.83,0:04:25.83,Default,,0,0,0,,Бұл Ли Хуарёнг Холл.
Dialogue: 0,0:04:25.83,0:04:28.83,Default,,0,0,0,,Шақырғаныма өте ризамын.
Dialogue: 0,0:04:30.83,0:04:32.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:34.84,0:04:37.84,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,0:04:37.84,0:04:41.84,Default,,0,0,0,,⚟(Гетрю) Мен сені шақырдым.
Dialogue: 0,0:04:41.84,0:04:44.85,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:44.85,0:04:47.85,Default,,0,0,0,,Әрине, Ли Воллонг мырза.
Dialogue: 0,0:04:47.85,0:04:49.85,Default,,0,0,0,,Неге екені белгісіз, ағамның атын алдым➡
Dialogue: 0,0:04:49.85,0:04:53.86,Default,,0,0,0,,Кешірім сұраймын. Бірақ мұнымен➡
Dialogue: 0,0:04:53.86,0:04:56.86,Default,,0,0,0,,Жағдайдан құтылу мүмкін емес екенін түсіндіңіз бе?
Dialogue: 0,0:04:56.86,0:04:59.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:59.86,0:05:01.80,Default,,0,0,0,,Осылайша банан балығы басталды. ➡
Dialogue: 0,0:05:01.80,0:05:04.80,Default,,0,0,0,,Сіздің обсессиялық жобаңыз.
Dialogue: 0,0:05:04.80,0:05:07.80,Default,,0,0,0,,Жақсы зерттеу.
Dialogue: 0,0:05:07.80,0:05:10.81,Default,,0,0,0,,Сіз тіпті Ирактағы американдық солдаттарсыз➡
Dialogue: 0,0:05:10.81,0:05:14.81,Default,,0,0,0,,Ол эксперименттің объектісі болды. Онда➡
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Сол жерде сіздің сүйікті Эш Сілеусіннің ағасы болды➡
Dialogue: 0,0:05:17.81,0:05:21.82,Default,,0,0,0,,Бұл тағдырдың ирониясы. ➡
Dialogue: 0,0:05:21.82,0:05:26.82,Default,,0,0,0,,Қалай болғанда да, банан балығы сіздің құмарлығыңыздың жемісі➡
Dialogue: 0,0:05:26.82,0:05:30.66,Default,,0,0,0,,Ол үлкен пайда әкелетін стратегиялық қаруға айналды.
Dialogue: 0,0:05:30.66,0:05:35.83,Default,,0,0,0,,Кеса қорының директорларының бірі Леонард Фокин мырза жазатайым жағдайда қайтыс болды.
Dialogue: 0,0:05:35.83,0:05:38.83,Default,,0,0,0,,Енді сізден бас тартқан тағы 5 адам бар.
Dialogue: 0,0:05:38.83,0:05:43.84,Default,,0,0,0,,«Мен оларға қамқорлық жасаймын?» десем ше ➡
Dialogue: 0,0:05:43.84,0:05:47.84,Default,,0,0,0,,Сіз Қордың өзін басқарасыз.
Dialogue: 0,0:05:47.84,0:05:50.85,Default,,0,0,0,,Сіз маған не істеймін деп жатырсыз?
Dialogue: 0,0:05:50.85,0:05:53.85,Default,,0,0,0,,Біз, Ли отбасының басшысы, Ли Ванглонг➡
Dialogue: 0,0:05:53.85,0:05:57.85,Default,,0,0,0,,Және Қарю➡ қоспағанда, бес ағаны жою
Dialogue: 0,0:05:57.85,0:06:01.29,Default,,0,0,0,,Мен сізден көмек сұрағым келеді. Не! ?
Dialogue: 0,0:06:01.29,0:06:05.63,Default,,0,0,0,,Сонымен қатар, Ли отбасынан шыққандар, соның ішінде олардың әйелдері, балалары мен немерелері, ➡
Dialogue: 0,0:06:05.63,0:06:08.80,Default,,0,0,0,,Біз олардың әрқайсысын жойғымыз келеді.
Dialogue: 0,0:06:08.80,0:06:11.80,Default,,0,0,0,,Мен тұра аламын ба?
Dialogue: 0,0:06:11.80,0:06:13.80,Default,,0,0,0,,Мен жеткілікті ұйықтадым.
Dialogue: 0,0:06:13.80,0:06:16.81,Default,,0,0,0,,Қараңдаршы, күн батып жатыр.
Dialogue: 0,0:06:16.81,0:06:21.81,Default,,0,0,0,,Қоқысты күн батқанда және таң атқанда ғана көре аласыз.
Dialogue: 0,0:06:21.81,0:06:24.81,Default,,0,0,0,,Не болды? жоқ….
Dialogue: 0,0:06:24.81,0:06:27.82,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:06:29.82,0:06:31.82,Default,,0,0,0,,Ibe-ге хабарласыңыз.
Dialogue: 0,0:06:31.82,0:06:34.82,Default,,0,0,0,,Мен сені енді үйге баруға мәжбүрлемеймін.
Dialogue: 0,0:06:34.82,0:06:37.83,Default,,0,0,0,,Сіз осында қала аласыз! ? Жақсы емес десең де➡
Dialogue: 0,0:06:37.83,0:06:40.83,Default,,0,0,0,,Сіз бәрібір үйге бармайсыз.
Dialogue: 0,0:06:40.83,0:06:44.83,Default,,0,0,0,,Маған да жақсырақ болар еді...
Dialogue: 0,0:06:44.83,0:06:47.84,Default,,0,0,0,,Иә? Сені Жапонияға қайтарсам да➡
Dialogue: 0,0:06:47.84,0:06:50.84,Default,,0,0,0,,Мен бірдеңе болуы мүмкін деп алаңдаймын.
Dialogue: 0,0:06:50.84,0:06:54.84,Default,,0,0,0,,Олай болса, мен көретін жерде қалғаның жөн.
Dialogue: 0,0:06:56.85,0:07:00.78,Default,,0,0,0,,Бірдеңе айт.
Dialogue: 0,0:07:00.78,0:07:04.79,Default,,0,0,0,,Мен сенен тағы да менің жанымда болуды сұрағанымды қалайсың ба?
Dialogue: 0,0:07:06.79,0:07:08.79,Default,,0,0,0,,Не!
Dialogue: 0,0:07:08.79,0:07:12.79,Default,,0,0,0,,Мен өзімді жақсы сезінемін. Қайтадан айт.
Dialogue: 0,0:07:12.79,0:07:15.80,Default,,0,0,0,,Қалжың емес! Ах, қарным ашты! Тамақ ішейік!
Dialogue: 0,0:07:15.80,0:07:18.80,Default,,0,0,0,,Бұл жақсы. Ол азаймайды.
Dialogue: 0,0:07:18.80,0:07:21.80,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:07:21.80,0:07:24.81,Default,,0,0,0,,Сіз барлық уақытта Алекспен және басқалармен бірге болдыңыз ба?
Dialogue: 0,0:07:24.81,0:07:27.81,Default,,0,0,0,,Иә, дұрыс. Шынымен бе?
Dialogue: 0,0:07:27.81,0:07:31.81,Default,,0,0,0,,Иә...Мен кейде Шинмен бірге болған сияқтымын...
Dialogue: 0,0:07:31.81,0:07:34.82,Default,,0,0,0,,Шошқа қорабынан жақсы жұмыс.
Dialogue: 0,0:07:34.82,0:07:38.82,Default,,0,0,0,,Иә? Хмм... жақсы...
Dialogue: 0,0:07:41.66,0:07:45.66,Default,,0,0,0,,Сіз мұны шынымен де білесіз. Оған халық кінәлі.
Dialogue: 0,0:07:45.66,0:07:49.66,Default,,0,0,0,,Бұл Гетрюу. неге айтпайсың?
Dialogue: 0,0:07:49.66,0:07:53.67,Default,,0,0,0,,Арнайы мағынасы жоқ...
Dialogue: 0,0:07:53.67,0:07:56.67,Default,,0,0,0,,Сізді үйге аман-есен жеткізген жақсы жұмыс.
Dialogue: 0,0:07:56.67,0:08:00.61,Default,,0,0,0,,Мен оның не ойлап тұрғанын түсінбеймін.
Dialogue: 0,0:08:00.61,0:08:03.61,Default,,0,0,0,,Олар жау ма, жоқ па?
Dialogue: 0,0:08:03.61,0:08:06.61,Default,,0,0,0,,《Мен Күлдің жауы боламын》➡
Dialogue: 0,0:08:06.61,0:08:08.62,Default,,0,0,0,,《Күл үшін болса да➡
Dialogue: 0,0:08:08.62,0:08:11.62,Default,,0,0,0,,Қолыңызды кірлетуге болмайды.
Dialogue: 0,0:08:11.62,0:08:15.62,Default,,0,0,0,,Иә? ше? Ах...
Dialogue: 0,0:08:15.62,0:08:18.63,Default,,0,0,0,,Мен саған сусын алып келейін.
Dialogue: 0,0:08:21.63,0:08:24.63,Default,,0,0,0,,《Қандай жағынан дұшпандық танытасың?➡
Dialogue: 0,0:08:24.63,0:08:26.63,Default,,0,0,0,,Менің ойымша, олар оны орнатпақшы...》
Dialogue: 0,0:08:26.63,0:08:28.64,Default,,0,0,0,,《Менде жағымсыз сезім бар...》
Dialogue: 0,0:08:32.64,0:08:37.65,Default,,0,0,0,,Бругмансия. Алкалоидты галлюциногенді өсімдік. ➡
Dialogue: 0,0:08:37.65,0:08:42.65,Default,,0,0,0,,Есту галлюцинациялары Жедел деменция Мінез-құлық ауытқуларын тудырады. ➡
Dialogue: 0,0:08:42.65,0:08:45.65,Default,,0,0,0,,Бір нәрсеге ұқсайды ма? ➡
Dialogue: 0,0:08:45.65,0:08:52.66,Default,,0,0,0,,Иә, түпнұсқа банан балығы - Бругмансияның мутант штаммы.
Dialogue: 0,0:08:52.66,0:08:56.66,Default,,0,0,0,,Мен бала кезімнен мыңдаған есірткі қолдандым➡
Dialogue: 0,0:08:56.66,0:08:59.67,Default,,0,0,0,,Атап айтқанда, оларға улы заттар туралы білім берілді. ➡
Dialogue: 0,0:08:59.67,0:09:02.60,Default,,0,0,0,,Улау – халқымыздың дәстүрі. ➡
Dialogue: 0,0:09:02.60,0:09:04.61,Default,,0,0,0,,Осыдан 4000 жыл бұрын. ➡
Dialogue: 0,0:09:04.61,0:09:07.61,Default,,0,0,0,,Бірақ тарих енді ештеңе шығармайды. ➡
Dialogue: 0,0:09:07.61,0:09:09.61,Default,,0,0,0,,Ұлтшылдыққа берілгендік➡
Dialogue: 0,0:09:09.61,0:09:13.62,Default,,0,0,0,,Қандастар билеген заман бітті. ➡
Dialogue: 0,0:09:13.62,0:09:17.95,Default,,0,0,0,,Айтпақшы, қашып кеткен Эш пен доктор Доусон туралы➡
Dialogue: 0,0:09:17.95,0:09:23.29,Default,,0,0,0,,Менің екі ұсынысым бар.
Dialogue: 0,0:09:23.29,0:09:27.96,Default,,0,0,0,,Хмм... Мен бұл туралы естігім келеді.
Dialogue: 0,0:09:27.96,0:09:30.30,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:09:30.30,0:09:32.30,Default,,0,0,0,,Сіз паромға бірінші рет мініп отырсыз ба?
Dialogue: 0,0:09:32.30,0:09:35.30,Default,,0,0,0,,Мен бұған дейін Шеңбер сызығынан өткенмін.
Dialogue: 0,0:09:35.30,0:09:38.31,Default,,0,0,0,,Шеңбер? Сіз білмейсіз бе? Сіз Нью-Йорктіксіз бе?
Dialogue: 0,0:09:38.31,0:09:41.31,Default,,0,0,0,,Өкінішке орай, мен ауылданмын.
Dialogue: 0,0:09:41.31,0:09:45.31,Default,,0,0,0,,Шетелдіктер, Нью-Йорк пен Лос-Анджелесті қараңыздар➡
Dialogue: 0,0:09:45.31,0:09:49.32,Default,,0,0,0,,Сіз бұл Америка Құрама Штаттары деп ойлайтын сияқтысыз, бірақ қателесесіз.
Dialogue: 0,0:09:49.32,0:09:52.32,Default,,0,0,0,,Бұл ақымақ алып елде қала деп атайтын жер жоқ➡
Dialogue: 0,0:09:52.32,0:09:56.32,Default,,0,0,0,,Өте аз. Америка - үлкен ауыл.
Dialogue: 0,0:09:56.32,0:09:58.33,Default,,0,0,0,,Егер сіз құрлықта болсаңыз, онда теңіз бар➡
Dialogue: 0,0:09:58.33,0:10:00.33,Default,,0,0,0,,Мен тек теледидардан көрген нәрселер➡
Dialogue: 0,0:10:00.33,0:10:03.33,Default,,0,0,0,,Мен өзім тұратын қаладан туылғаннан бері ешқайда кетпедім➡
Dialogue: 0,0:10:03.33,0:10:06.33,Default,,0,0,0,,Өліп жатқан қарттар өте көп.
Dialogue: 0,0:10:06.33,0:10:11.34,Default,,0,0,0,,Хмм... Стивен Кингтің романы сияқты.
Dialogue: 0,0:10:11.34,0:10:14.34,Default,,0,0,0,,Жүгері егістігі мәңгі жүретін жол➡
Dialogue: 0,0:10:14.34,0:10:16.34,Default,,0,0,0,,Сырттан келгенді жек көретін ауыл.
Dialogue: 0,0:10:16.34,0:10:20.35,Default,,0,0,0,,Онда бөгде адамдардың тұруы қиынға соғатыны сөзсіз.
Dialogue: 0,0:10:20.35,0:10:23.35,Default,,0,0,0,,Менің анам да бөгде адам болатын.
Dialogue: 0,0:10:23.35,0:10:26.35,Default,,0,0,0,,Адамдар жазда ыстықтан құтылу үшін Кейп-Кодқа келеді➡
Dialogue: 0,0:10:26.35,0:10:28.36,Default,,0,0,0,,Ол қала тұрғындарының бірі болды.
Dialogue: 0,0:10:28.36,0:10:31.36,Default,,0,0,0,,Қашып кеткіңіз келетіні таңқаларлық емес.
Dialogue: 0,0:10:31.36,0:10:36.36,Default,,0,0,0,,Анаңның сенімен қоштасуы өте қиын болды деп ойлаймын.
Dialogue: 0,0:10:36.36,0:10:39.37,Default,,0,0,0,,Солай деп ойлаймын... Дұрыс.
Dialogue: 0,0:10:39.37,0:10:41.37,Default,,0,0,0,,Сіз маған бұрын бірдеңе айттыңыз.
Dialogue: 0,0:10:41.37,0:10:44.37,Default,,0,0,0,,Сіздің шын есіміңіз Аслан➡
Dialogue: 0,0:10:44.37,0:10:48.38,Default,,0,0,0,,Анам оны маған кигізді. Бұл бірдеңені білдіреді ме?
Dialogue: 0,0:10:48.38,0:10:52.38,Default,,0,0,0,,Ежелгі еврей тіліндегі дұға тілінде таңды білдірсе керек.
Dialogue: 0,0:10:52.38,0:10:55.38,Default,,0,0,0,,Себебі мен таң ата тудым.
Dialogue: 0,0:10:55.38,0:10:57.39,Default,,0,0,0,,Екеуіңіздің атыңыз кім, Дж?
Dialogue: 0,0:10:57.39,0:11:00.32,Default,,0,0,0,,Нефрит... Нефрит.
Dialogue: 0,0:11:00.32,0:11:03.32,Default,,0,0,0,,Қараңызшы, мен айтқандай болды.
Dialogue: 0,0:11:03.32,0:11:06.33,Default,,0,0,0,,Анаң бұл есімді ойлау үшін көп еңбек етті.
Dialogue: 0,0:11:06.33,0:11:10.33,Default,,0,0,0,,Таң атқанда туған, Бақыт тілеймін.
Dialogue: 0,0:11:10.33,0:11:12.33,Default,,0,0,0,,Таң атқандағы нефриттей өмірің➡
Dialogue: 0,0:11:12.33,0:11:15.34,Default,,0,0,0,,Мен оның керемет нәрсе болғанын қалаймын.
Dialogue: 0,0:11:15.34,0:11:18.34,Default,,0,0,0,,Ол адам сені жақсы көрмейді➡
Dialogue: 0,0:11:18.34,0:11:20.34,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:11:20.34,0:11:25.35,Default,,0,0,0,,Сонда неге...? иә?
Dialogue: 0,0:11:25.35,0:11:29.35,Default,,0,0,0,,Жоқ, мен сенімдімін.
Dialogue: 0,0:11:31.35,0:11:33.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:38.36,0:11:41.36,Default,,0,0,0,,Не болды? Мен бәрібір қайтемін деп ойлаймын.
Dialogue: 0,0:11:41.36,0:11:44.37,Default,,0,0,0,,Иә! ? Сіз Лонг-Айлендке барасыз ба?
Dialogue: 0,0:11:44.37,0:11:47.37,Default,,0,0,0,,Мен ойымды өзгерттім. Қазірдің өзінде бұл не ...
Dialogue: 0,0:11:47.37,0:11:49.70,Default,,0,0,0,,Бұл жай ғана қалау мәселесі...
Dialogue: 0,0:11:49.70,0:11:52.04,Default,,0,0,0,,Міне, мен осындай жер таптым.
Dialogue: 0,0:11:52.04,0:11:54.04,Default,,0,0,0,,Бірақ бұл жерде де қауіпсіз емес. ➡
Dialogue: 0,0:11:54.04,0:11:56.04,Default,,0,0,0,,Ауруханалар туралы не деуге болады?
Dialogue: 0,0:11:56.04,0:11:58.88,Default,,0,0,0,,Директор дәл қазір.
Dialogue: 0,0:11:58.88,0:12:01.65,Default,,0,0,0,,Оның орнына, біз келесі айдағы шығарылымда ерекше мүмкіндікті көрсетеміз.
Dialogue: 0,0:12:01.65,0:12:04.82,Default,,0,0,0,,Қараңызшы, Гольцин. Мен көпіршікті үрлеймін.
Dialogue: 0,0:12:04.82,0:12:06.99,Default,,0,0,0,,Кипперд пен Холсток та.
Dialogue: 0,0:12:06.99,0:12:08.99,Default,,0,0,0,,📞 (дірілдеткіш дыбысы)
Dialogue: 0,0:12:08.99,0:12:11.99,Default,,0,0,0,,Күл... Иә?
Dialogue: 0,0:12:11.99,0:12:15.00,Default,,0,0,0,,📞Келмейді! ? Нақты айта алмаймын, бірақ ➡
Dialogue: 0,0:12:15.00,0:12:19.00,Default,,0,0,0,,Біртүрлі сезіледі. Мен өзімді бақылап тұрғандай сезінемін...
Dialogue: 0,0:12:19.00,0:12:22.00,Default,,0,0,0,,Абайлаңыз. 📞Мен үйреніп қалдым. ➡
Dialogue: 0,0:12:22.00,0:12:25.01,Default,,0,0,0,,Алданбаңыз. 📞 (қоңырауды ажырату дыбысы)
Dialogue: 0,0:12:25.01,0:12:27.84,Default,,0,0,0,,《Бұл қазірдің өзінде дағдарыс》
Dialogue: 0,0:12:27.84,0:12:33.01,Default,,0,0,0,,《Банан балығы таза химиялық қосылыс емес пе? 》
Dialogue: 0,0:12:33.01,0:12:36.02,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:12:36.02,0:12:39.02,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:12:42.02,0:12:44.03,Default,,0,0,0,,⚟Аа... аа~ Ауыр...
Dialogue: 0,0:12:44.03,0:12:48.03,Default,,0,0,0,,Бүгін оқуды жоспарлап отырғаныңызға сенімдімін, солай ма?
Dialogue: 0,0:12:48.03,0:12:50.03,Default,,0,0,0,,Бұл менің ниетім. Сіз қалжыңдап тұрсыз! ?
Dialogue: 0,0:12:50.03,0:12:54.04,Default,,0,0,0,,Түн жақындады! Егер жалықсаңыз, қалтаңыздан ақша беремін➡
Dialogue: 0,0:12:54.04,0:12:58.04,Default,,0,0,0,,Манганы сатып ала аласыз ба? аа!
Dialogue: 0,0:12:58.04,0:12:59.97,Default,,0,0,0,,Мен мұны істеп жатқанда, мен саған хот-дог сатып аламын.
Dialogue: 0,0:12:59.97,0:13:03.98,Default,,0,0,0,,А, мен де сенен сұрайын. Қыша көп, аға.
Dialogue: 0,0:13:03.98,0:13:06.98,Default,,0,0,0,,Бау! Ах.
Dialogue: 0,0:13:09.98,0:13:12.99,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:12.99,0:13:14.99,Default,,0,0,0,,Мен сенімен бірге барамын. иә?
Dialogue: 0,0:13:17.99,0:13:19.99,Default,,0,0,0,,Уф... ше?
Dialogue: 0,0:13:19.99,0:13:22.00,Default,,0,0,0,,Бұл қыша шынымен тиімді...
Dialogue: 0,0:13:22.00,0:13:25.00,Default,,0,0,0,,Ол осы деңгейдегі бала.
Dialogue: 0,0:13:25.00,0:13:29.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:29.00,0:13:34.01,Default,,0,0,0,,《Біртүрлі екен. Бұл ненің белгісі...?
Dialogue: 0,0:13:34.01,0:13:36.01,Default,,0,0,0,,Сіз нені айтасыз? Ай айдаһар. ➡
Dialogue: 0,0:13:36.01,0:13:39.01,Default,,0,0,0,,Қайталанған қоңырауларға жауап бермедіңіз.
Dialogue: 0,0:13:39.01,0:13:43.02,Default,,0,0,0,,Жарайды. Сізден сұрайын дегенім көп.
Dialogue: 0,0:13:43.02,0:13:47.02,Default,,0,0,0,,Жақында Гольцин сіздің үйіңізге қонаққа келген сияқты.
Dialogue: 0,0:13:47.02,0:13:50.02,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:13:50.02,0:13:54.03,Default,,0,0,0,,Мен сені жаңа ғана түскі асқа шақырдым.
Dialogue: 0,0:13:54.03,0:13:56.03,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:56.03,0:13:59.97,Default,,0,0,0,,Өтірік айтпа! Бізге деген кекіңіз бар!
Dialogue: 0,0:13:59.97,0:14:02.97,Default,,0,0,0,,Маған өмір сүруге мүмкіндік бергеніңіз үшін қаншалықты риза болғаныңызды ұмытпаңыз!
Dialogue: 0,0:14:02.97,0:14:06.97,Default,,0,0,0,,Олай болса мен оны өлтіруім керек сияқты. Анамды өлтіргендей...
Dialogue: 0,0:14:06.97,0:14:09.98,Default,,0,0,0,,Хмф... Менің ойымша.
Dialogue: 0,0:14:09.98,0:14:14.98,Default,,0,0,0,,Сіз не ойлап отырсыз! ? Айтыңызшы! Неге айтпайсың?
Dialogue: 0,0:14:14.98,0:14:18.99,Default,,0,0,0,,Иә! ? Не... балалар сендер қандайсыңдар...?
Dialogue: 0,0:14:18.99,0:14:22.99,Default,,0,0,0,,Балалар, мені өлтірулерің керек еді. ➡
Dialogue: 0,0:14:22.99,0:14:28.00,Default,,0,0,0,,Анамды құрт-құмырсқа боп өлтірген кезде...
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0,0,0,,Барлығыңызды осы жерден құртыңыз➡
Dialogue: 0,0:14:31.00,0:14:35.00,Default,,0,0,0,,Мен Ли отбасын жойып жіберемін! Әрқайсысы қалды!
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Тіпті осындай нәрсені жасауға болады ма?
Dialogue: 0,0:14:37.00,0:14:41.01,Default,,0,0,0,,Сіз не істей аласыз! ? Бұл сіз үшін сәтсіздік!
Dialogue: 0,0:14:41.01,0:14:44.01,Default,,0,0,0,,Бірінші: Сіз де өз отбасыңыздың қанын мұра етесіз, солай ма? ➡
Dialogue: 0,0:14:44.01,0:14:48.02,Default,,0,0,0,,Тамырымда әкемнің қаны өтеді! Сол аң!
Dialogue: 0,0:14:48.02,0:14:51.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:53.02,0:14:56.02,Default,,0,0,0,,Сізді қанағаттандырды ма? 📞(Гетрю) Иә...
Dialogue: 0,0:14:56.02,0:14:59.96,Default,,0,0,0,,Фокинге қатысты көмегіңіз үшін рахмет.
Dialogue: 0,0:14:59.96,0:15:05.97,Default,,0,0,0,,Айтпақшы, сіздің ісіңізге лайықты адам бар.
Dialogue: 0,0:15:05.97,0:15:08.97,Default,,0,0,0,,Түсінікті…. 📞 (қоңырауды ажырату дыбысы)
Dialogue: 0,0:15:15.98,0:15:20.65,Default,,0,0,0,,📺 (Диктор) Өлтірген адам Хуаяң банкінің президенті Ли Ванлун мырза болды➡
Dialogue: 0,0:15:20.65,0:15:22.65,Default,,0,0,0,,Қылмыс жасаған топ әлі анықталған жоқ.
Dialogue: 0,0:15:22.65,0:15:24.65,Default,,0,0,0,,Бұл менмін. Бұл Кипперд. ➡
Dialogue: 0,0:15:24.65,0:15:28.66,Default,,0,0,0,,Корсика қорының топ-менеджерлері оғаш жағдайларда бірінен соң бірі өліп жатыр➡
Dialogue: 0,0:15:28.66,0:15:33.66,Default,,0,0,0,,Сіз де естіген боларсыз. Жақын арада уақытыңыз бола ма?
Dialogue: 0,0:15:33.66,0:15:37.67,Default,,0,0,0,,Иә. Оның кезегі әлдеқашан аяқталды.
Dialogue: 0,0:15:37.67,0:15:39.67,Default,,0,0,0,,📺 (Диктор) Келесі президент назар аударып отыр➡
Dialogue: 0,0:15:39.67,0:15:43.67,Default,,0,0,0,,Ол марқұм Хунлонг Ли мырзаның бесінші ұлы және Ванлун мырзаның оң қолы болды➡
Dialogue: 0,0:15:43.67,0:15:45.67,Default,,0,0,0,,Ли Хуа Лонг ықтимал кандидат ретінде қарастырылады➡
Dialogue: 0,0:15:45.67,0:15:51.68,Default,,0,0,0,,Сондай-ақ жетінші ұлы Цукурю мырза кеңесші болып тағайындалады.
Dialogue: 0,0:15:51.68,0:15:53.68,Default,,0,0,0,,Қонақ келді.
Dialogue: 0,0:15:53.68,0:15:58.69,Default,,0,0,0,,Сора. Мен банан балығының емдік ерекшелігін анықтауға тырыстым.
Dialogue: 0,0:15:58.69,0:16:02.62,Default,,0,0,0,,Психофармакология мамандарының пікірлерін тыңдау.
Dialogue: 0,0:16:02.62,0:16:04.63,Default,,0,0,0,,Мен ойладым... сіз?
Dialogue: 0,0:16:04.63,0:16:08.30,Default,,0,0,0,,Бұл тек химиялық жолмен синтезделмеген.
Dialogue: 0,0:16:08.30,0:16:12.63,Default,,0,0,0,,Мысалы, Оңтүстік Америкадағы пейот деп аталатын кактус түрінен ➡
Dialogue: 0,0:16:12.63,0:16:17.31,Default,,0,0,0,,Күшті галлюциногендік әсері бар белсенді ингредиенттер алынады.
Dialogue: 0,0:16:17.31,0:16:19.64,Default,,0,0,0,,Алкалоидты өсімдік түрінен➡
Dialogue: 0,0:16:19.64,0:16:21.81,Default,,0,0,0,,Менің ойымша, бұл құрама.
Dialogue: 0,0:16:21.81,0:16:25.98,Default,,0,0,0,,Мен таң қалдым... Бұл жай ғана болжам.
Dialogue: 0,0:16:25.98,0:16:29.65,Default,,0,0,0,,Доктор Доусон ше? Бұл дәрігер туралы➡
Dialogue: 0,0:16:29.65,0:16:33.15,Default,,0,0,0,,Мидың ақпарат тарату жолында бұзылыс бар➡
Dialogue: 0,0:16:33.15,0:16:37.66,Default,,0,0,0,,Есірткі әсерінен болды ма, жоқ па, дәлелдеу қиын сияқты. ➡
Dialogue: 0,0:16:37.66,0:16:41.16,Default,,0,0,0,,Бірақ егер біз оны анықтай алсақ, біз бірдеңе жасай аламыз.
Dialogue: 0,0:16:41.16,0:16:43.66,Default,,0,0,0,,Бұл себепті байланыстың дәлелі ме?
Dialogue: 0,0:16:43.66,0:16:46.67,Default,,0,0,0,,Қат! Кипперд немесе Холсток жақсы➡
Dialogue: 0,0:16:46.67,0:16:48.67,Default,,0,0,0,,Оны қатайтыңыз!
Dialogue: 0,0:16:48.67,0:16:51.01,Default,,0,0,0,,Мен мұны істеуге қарсы емеспін. Сіз?
Dialogue: 0,0:16:51.01,0:16:54.68,Default,,0,0,0,,Кипперд қарттың мейрамханасында жақсы болды.
Dialogue: 0,0:16:54.68,0:16:56.88,Default,,0,0,0,,Ол ауру ешқашан жазылмайды.
Dialogue: 0,0:16:58.85,0:17:01.95,Default,,0,0,0,,Әй, айтпақшы, сізді бақылап жатыр дедіңіз.
Dialogue: 0,0:17:01.95,0:17:06.95,Default,,0,0,0,,А, бұл өте қорқынышты, біз оның шын мәнінде не екенін анықтай алмаймыз ...
Dialogue: 0,0:17:06.95,0:17:09.96,Default,,0,0,0,,Осы уақытқа дейін мен өз өмірімді тек түйсігіме сүйеніп өткіздім➡
Dialogue: 0,0:17:09.96,0:17:12.96,Default,,0,0,0,,Мен бұған толық сенімді болдым.
Dialogue: 0,0:17:12.96,0:17:15.96,Default,,0,0,0,,Бірақ мұндай жағдай бірінші рет болып тұр.
Dialogue: 0,0:17:15.96,0:17:19.97,Default,,0,0,0,,Бұл сирек. Мен сенің соншалықты әлсіз дыбыс шығаратыныңа сене алар емеспін.
Dialogue: 0,0:17:28.98,0:17:30.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:30.98,0:17:35.98,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:17:38.99,0:17:43.99,Default,,0,0,0,,Мынау несі? Чикусо! Жай ойнам айттым!
Dialogue: 0,0:17:45.99,0:17:49.66,Default,,0,0,0,,⚟Сәлем! Күл!
Dialogue: 0,0:17:49.66,0:17:53.00,Default,,0,0,0,,Не, сен... Жалғыз шықпа дедім ғой! ?
Dialogue: 0,0:17:53.00,0:17:56.00,Default,,0,0,0,,Не... не қыжылдап жатыр?
Dialogue: 0,0:17:56.00,0:17:58.01,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,0:17:58.01,0:18:00.94,Default,,0,0,0,,Сіз жай ғана пончик сатып алмақ болған жоқсыз ба?
Dialogue: 0,0:18:00.94,0:18:02.94,Default,,0,0,0,,Біз сағат 3-те кездестік, солай ма?
Dialogue: 0,0:18:02.94,0:18:04.95,Default,,0,0,0,,Түсіндім... ұмытып кетіппін.
Dialogue: 0,0:18:04.95,0:18:07.95,Default,,0,0,0,,Эй.
Dialogue: 0,0:18:07.95,0:18:10.95,Default,,0,0,0,,Не болды? Күл. Ауырып тұрсыз ба?
Dialogue: 0,0:18:10.95,0:18:14.96,Default,,0,0,0,,Ештеңе. барайық. Айқайлағаным менің кінәм болды.
Dialogue: 0,0:18:18.96,0:18:21.96,Default,,0,0,0,,Төрт жыл болды... Бланка.
Dialogue: 0,0:18:21.96,0:18:25.30,Default,,0,0,0,,Көптен бері көрмегелі, мырза.
Dialogue: 0,0:18:25.30,0:18:27.97,Default,,0,0,0,,Жақсы пісірілген.
Dialogue: 0,0:18:27.97,0:18:30.97,Default,,0,0,0,,Кариб теңізінің өмірі менің жынысыма сәйкес келетін сияқты.
Dialogue: 0,0:18:30.97,0:18:33.98,Default,,0,0,0,,Зейнеткерлікке шыққаны рас сияқты.
Dialogue: 0,0:18:33.98,0:18:36.98,Default,,0,0,0,,Мен гермиттің ләззатынан ләззат аламын.
Dialogue: 0,0:18:36.98,0:18:38.98,Default,,0,0,0,,Мен күнде кітап оқығанды ​​ұнатамын.
Dialogue: 0,0:18:38.98,0:18:41.48,Default,,0,0,0,,Олай болса, мұнда не үшін келдің?
Dialogue: 0,0:18:41.48,0:18:43.48,Default,,0,0,0,,Бұл сұрауыңызды қабылдамауға арналған.
Dialogue: 0,0:18:43.48,0:18:46.99,Default,,0,0,0,,Сіздің өтінішіңіз сондай күтпеген еді➡
Dialogue: 0,0:18:46.99,0:18:50.32,Default,,0,0,0,,Мен оны өз көзіммен көргім келді.
Dialogue: 0,0:18:50.32,0:18:53.10,Default,,0,0,0,,Сонымен... көрдің бе? Ол.
Dialogue: 0,0:18:53.10,0:18:58.00,Default,,0,0,0,,Жылдар ирониялық. Біз үшін қартайған болса да➡
Dialogue: 0,0:18:58.00,0:19:02.94,Default,,0,0,0,,Осы жастағы адамдар үшін бұл өсуді білдіреді.
Dialogue: 0,0:19:02.94,0:19:07.27,Default,,0,0,0,,Бұл менің көңіл-күйімді сезіп, дірілдеп тұрды.
Dialogue: 0,0:19:07.27,0:19:09.94,Default,,0,0,0,,-де? Сіздің жауабыңыз қандай?
Dialogue: 0,0:19:09.94,0:19:13.95,Default,,0,0,0,,Мен оның қаншалықты алыс жүре алатынын көргім келді.
Dialogue: 0,0:19:13.95,0:19:17.45,Default,,0,0,0,,Қабыл алайық.
Dialogue: 0,0:19:17.45,0:19:20.96,Default,,0,0,0,,(шаш кептіргіш дыбысы)
Dialogue: 0,0:19:20.96,0:19:24.96,Default,,0,0,0,,Эй, бұл жаңалықты не істеп жатырсың?
Dialogue: 0,0:19:24.96,0:19:26.96,Default,,0,0,0,,Сіз 15 жаста көрінесіз бе?
Dialogue: 0,0:19:26.96,0:19:28.96,Default,,0,0,0,,Хахаха мен оны көріп тұрмын.
Dialogue: 0,0:19:28.96,0:19:32.97,Default,,0,0,0,,Не болды? Баланың бағасымен мұражайға барғыңыз келе ме?
Dialogue: 0,0:19:32.97,0:19:35.97,Default,,0,0,0,,Жезөкшелік. иә? Ахах...
Dialogue: 0,0:19:35.97,0:19:39.97,Default,,0,0,0,,Мен бұл әзілді түсінбеймін. Бұл әзіл емес.
Dialogue: 0,0:19:39.97,0:19:42.98,Default,,0,0,0,,Қандай жаңалық бар? О, мынау.
Dialogue: 0,0:19:42.98,0:19:45.98,Default,,0,0,0,,Сіз қалай ойлайсыз? Не айтқың келеді?
Dialogue: 0,0:19:45.98,0:19:50.99,Default,,0,0,0,,Шындығында, мен мойындауым керек, Гетсурю маған бұрын бірдеңе деді.
Dialogue: 0,0:19:50.99,0:19:53.65,Default,,0,0,0,,«Мен Күлдің жауы боламын».
Dialogue: 0,0:19:53.65,0:19:56.49,Default,,0,0,0,,Осы уақытқа дейін неге үндемедің?
Dialogue: 0,0:19:56.49,0:19:58.99,Default,,0,0,0,,Бұл… бұл….
Dialogue: 0,0:19:58.99,0:20:02.00,Default,,0,0,0,,《Бұдан былай мен сені мақсат етемін》➡
Dialogue: 0,0:20:02.00,0:20:05.00,Default,,0,0,0,,《Сен оның жалғыз әлсіздігі болсаң》
Dialogue: 0,0:20:05.00,0:20:11.01,Default,,0,0,0,,Білмеймін...бірақ ол өте зиянды➡
Dialogue: 0,0:20:11.01,0:20:15.01,Default,,0,0,0,,Бұл өте қауіпті... Мен жиіркенішті сезінемін.
Dialogue: 0,0:20:17.01,0:20:20.01,Default,,0,0,0,,Уайымдамаңыз. Сол жігіт жасап көрсе➡
Dialogue: 0,0:20:20.01,0:20:23.02,Default,,0,0,0,,Бұл уақыт. Қайда бара жатырсың?
Dialogue: 0,0:20:23.02,0:20:26.02,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:20:26.02,0:20:28.02,Default,,0,0,0,,Жезөкшелікке бару.
Dialogue: 0,0:20:28.02,0:20:31.03,Default,,0,0,0,,Жалғыз шықпаңыз. (есік жабылған дыбыс)
Dialogue: 0,0:20:36.03,0:20:40.03,Default,,0,0,0,,Бұл Петр емес, солай ма? Ол кенеттен ауырып қалды...
Dialogue: 0,0:20:40.03,0:20:43.04,Default,,0,0,0,,Менің орнына баруымды өтінді.
Dialogue: 0,0:20:43.04,0:20:46.04,Default,,0,0,0,,Мен болуым керек емес пе?
Dialogue: 0,0:20:48.04,0:20:52.05,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:20:52.05,0:20:56.05,Default,,0,0,0,,Сізге аққұбалар әлі де ұнай ма? Ха! ?
Dialogue: 0,0:20:56.05,0:20:59.99,Default,,0,0,0,,Сіз бұл бетті ұмыттыңыз ба? Бұл жүрексіз.
Dialogue: 0,0:20:59.99,0:21:01.99,Default,,0,0,0,,Сен... Ах!
Dialogue: 0,0:21:01.99,0:21:05.99,Default,,0,0,0,,Көшіп кете аласыз ба? Бұл ауыр.
Dialogue: 0,0:21:05.99,0:21:09.00,Default,,0,0,0,,Мен сізге ризамын.
Dialogue: 0,0:21:09.00,0:21:13.00,Default,,0,0,0,,Мені елеске айналдырғаныңыздың арқасында, Сацудың артынан қуудың қажеті жоқ.
Dialogue: 0,0:21:13.00,0:21:16.00,Default,,0,0,0,,Не... не қалайсыз? Ақша ма?
Dialogue: 0,0:21:16.00,0:21:18.01,Default,,0,0,0,,Банан балығы.
Dialogue: 0,0:21:18.01,0:21:20.01,Default,,0,0,0,,Уф... нені айтып тұрсың?
Dialogue: 0,0:21:20.01,0:21:22.01,Default,,0,0,0,,Қажетсіз драмадан аулақ болайық.
Dialogue: 0,0:21:22.01,0:21:25.01,Default,,0,0,0,,Сіз және Голзин Холсток күлді➡
Dialogue: 0,0:21:25.01,0:21:29.18,Default,,0,0,0,,Балалар, кімнің қорғауында жұмыс істейсіңдер?
Dialogue: 0,0:21:29.18,0:21:31.19,Default,,0,0,0,,Жауап берейін.
Dialogue: 0,0:21:31.19,0:21:33.19,Default,,0,0,0,,Сіз сияқты ер жезөкшенің қорқытуы➡
Dialogue: 0,0:21:33.19,0:21:35.69,Default,,0,0,0,,Елді сатамын деп ойлайсың ба? ?
Dialogue: 0,0:21:35.69,0:21:37.69,Default,,0,0,0,,Өлтіргің келсе, өлтір!
Dialogue: 0,0:21:37.69,0:21:40.03,Default,,0,0,0,,«Ел үшін» шықты.
Dialogue: 0,0:21:40.03,0:21:42.03,Default,,0,0,0,,Бірақ бұл туралы не деуге болады?
Dialogue: 0,0:21:42.03,0:21:46.03,Default,,0,0,0,,Ах! ? Қайда... бұл қайда! ?
Dialogue: 0,0:21:46.03,0:21:49.04,Default,,0,0,0,,Бұл Диноның жағымсыз жағы.
Dialogue: 0,0:21:49.04,0:21:52.04,Default,,0,0,0,,Клубтағылардың барлығы суретке түсті.
Dialogue: 0,0:21:52.04,0:21:55.04,Default,,0,0,0,,Сіз байқамай қалдыңыз ба?
Dialogue: 0,0:21:55.04,0:21:59.05,Default,,0,0,0,,Енді бұрынғы сұраққа не жауап береді?
Dialogue: 0,0:21:59.05,0:22:03.05,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:22:05.99,0:22:09.99,Default,,0,0,0,,Клиноктың бағыты мен қылышты айналдырған кезде қолданылатын күш бағыты дәл бірдей болуы керек
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,Жақсы жауап.
Dialogue: 0,0:22:13.99,0:22:19.00,Default,,0,0,0,,Сіз үйреткен нәрсені орындап жатқан сияқтысыз.
Dialogue: 0,0:22:19.00,0:22:23.00,Default,,0,0,0,,《Тыныш... Сабыр ет...》
Dialogue: 0,0:22:23.00,0:22:26.01,Default,,0,0,0,,《Олардың атып жатқанының белгісі жоқ...》
Dialogue: 0,0:22:26.01,0:22:31.01,Default,,0,0,0,,《Осы жақтан айтасың ба, бұл ғимарат па? ? 》
Dialogue: 0,0:22:31.01,0:22:34.01,Default,,0,0,0,,《Мүмкін емес... Бұл тым алыс...》
Dialogue: 0,0:22:34.01,0:22:39.02,Default,,0,0,0,,《Ол жерден атқан болсаң, орташа кәсіпқой болуың керек...》
Dialogue: 0,0:22:39.02,0:22:45.03,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:46.53,0:22:51.53,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
