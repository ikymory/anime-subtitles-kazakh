Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.58,0:00:21.00,Default,,0,0,0,,Сонау өткеннен біз
Dialogue: 0,0:00:21.12,0:00:23.41,Default,,0,0,0,,Мен сендерді жердегілер бақылап отырдым.
Dialogue: 0,0:00:26.95,0:00:28.62,Default,,0,0,0,,Годзилла пайда болғанға дейін
Dialogue: 0,0:00:30.00,0:00:32.25,Default,,0,0,0,,Сол өркениеттің таңына қайта оралу
Dialogue: 0,0:00:33.37,0:00:38.00,Default,,0,0,0,,Біз жердегілермен үздіксіз араласып тұрдық.
Dialogue: 0,0:00:38.50,0:00:42.91,Default,,0,0,0,,Міне, балалар, сендер қызық байқадыңдар.
Dialogue: 0,0:00:43.91,0:00:46.37,Default,,0,0,0,,Сондықтан біз адамзат туралы
Dialogue: 0,0:00:47.00,0:00:49.16,Default,,0,0,0,,Сіз өзіңіз білетіннен де көп білесіз.
Dialogue: 0,0:00:50.50,0:00:53.08,Default,,0,0,0,,Сіз шын мәнінде колониясыз.
Dialogue: 0,0:00:54.45,0:00:59.70,Default,,0,0,0,,Ерік бостандығы деп атауға болатын тәуелсіздік шын мәнінде сирек кездеседі.
Dialogue: 0,0:01:02.50,0:01:05.66,Default,,0,0,0,,Құдайдың сөзі адамдарға ешқашан жетпейді
Dialogue: 0,0:01:05.91,0:01:08.75,Default,,0,0,0,,Адамдар басқалардың сөзін ғана түсіне алады.
Dialogue: 0,0:01:08.83,0:01:10.08,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:01:10.50,0:01:14.08,Default,,0,0,0,,Адамның денесінде болғанда, ауыз арқылы
Dialogue: 0,0:01:14.16,0:01:17.33,Default,,0,0,0,,Бізге Құдайдың басшылығы туралы айтатын адам керек.
Dialogue: 0,0:01:18.79,0:01:21.08,Default,,0,0,0,,Сондықтан сіз батырларды іздейсіз
Dialogue: 0,0:01:22.16,0:01:24.91,Default,,0,0,0,,Күй де, себеп те емес
Dialogue: 0,0:01:25.12,0:01:29.04,Default,,0,0,0,,Дәуір рухын сенімімен, іс-әрекетімен алып жүргендер
Dialogue: 0,0:01:30.16,0:01:35.04,Default,,0,0,0,,Адамдар оның көшбасшылығына тәнті болып, сөзінен шындықты іздейді.
Dialogue: 0,0:01:35.91,0:01:37.58,Default,,0,0,0,,Бұл көзқарастың арғы жағында
Dialogue: 0,0:01:38.58,0:01:40.16,Default,,0,0,0,,Құдайды табу
Dialogue: 0,0:01:42.37,0:01:46.25,Default,,0,0,0,,Барлығын Алланың қақпасына апару шарт емес.
Dialogue: 0,0:01:47.12,0:01:51.04,Default,,0,0,0,,Бір ғана батыр жол көрсетсе
Dialogue: 0,0:01:51.91,0:01:55.45,Default,,0,0,0,,Сіздің шеруіңіз жалғасады.
Dialogue: 0,0:01:59.16,0:02:01.20,Default,,0,0,0,,Мен іздедім
Dialogue: 0,0:02:01.66,0:02:02.87,Default,,0,0,0,,Мен күттім
Dialogue: 0,0:02:03.12,0:02:07.83,Default,,0,0,0,,Адамзат тарихын қорытындылап, соңғы жол көрсетуші.
Dialogue: 0,0:02:08.25,0:02:10.75,Default,,0,0,0,,Осындай батыр шыққанын қалаймын
Dialogue: 0,0:02:12.33,0:02:13.33,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:14.04,0:02:15.95,Default,,0,0,0,,Мен сені күттім
Dialogue: 0,0:02:17.95,0:02:19.12,Default,,0,0,0,,Харуо…
Dialogue: 0,0:02:21.33,0:02:27.33,Default,,0,0,0,,♪~
Dialogue: 0,0:03:13.58,0:03:19.58,Default,,0,0,0,,~♪
Dialogue: 0,0:03:26.45,0:03:28.79,Default,,0,0,0,,Биологиялық реакцияларды растау мүмкін емес
Dialogue: 0,0:03:29.00,0:03:30.25,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:03:30.33,0:03:33.33,Default,,0,0,0,,Жоқ, денедегі электромагниттік бұзылу әлі де тірі және жақсы...
Dialogue: 0,0:03:33.66,0:03:36.66,Default,,0,0,0,,Ол баяу болғанымен, үлкен толқын пішінімен ол біршама тұрақты.
Dialogue: 0,0:03:37.70,0:03:39.29,Default,,0,0,0,,Жай ұйықтап жатырмын
Dialogue: 0,0:03:39.91,0:03:43.79,Default,,0,0,0,,Келесі ояту үшін күш жинау.
Dialogue: 0,0:03:45.37,0:03:49.20,Default,,0,0,0,,Мұның бәрі не туралы болды? Годзилланың тіршілігі қандай?
Dialogue: 0,0:03:49.75,0:03:51.50,Default,,0,0,0,,Есте сақтауға тырысыңыз
Dialogue: 0,0:03:51.58,0:03:54.29,Default,,0,0,0,,20 ғасырда құбыжықтар қалай дүниеге келді?
Dialogue: 0,0:03:55.29,0:03:58.08,Default,,0,0,0,,Адамзаттың… атом және сутегі бомбаларының сынақтары…
Dialogue: 0,0:03:58.16,0:04:02.08,Default,,0,0,0,,Адамның ақымақтығынан құбыжық деп аталатын құбыжықтар пайда болды.
Dialogue: 0,0:04:02.25,0:04:03.91,Default,,0,0,0,,Бізге солай үйретілді
Dialogue: 0,0:04:04.00,0:04:05.41,Default,,0,0,0,,Бірақ бәрі керісінше болуы мүмкін.
Dialogue: 0,0:04:05.50,0:04:06.12,Default,,0,0,0,,Керісінше...
Dialogue: 0,0:04:06.70,0:04:09.41,Default,,0,0,0,,Үлкен экологиялық жүйе тұрғысынан ойлау
Dialogue: 0,0:04:09.50,0:04:12.50,Default,,0,0,0,,Адамдардың осы уақытқа дейін ойлап тапқан әртүрлі технологиялары
Dialogue: 0,0:04:13.20,0:04:15.12,Default,,0,0,0,,Өзіміз үшін емес
Dialogue: 0,0:04:15.20,0:04:19.29,Default,,0,0,0,,Бұл әлемге құбыжықтар деп аталатын тіршілік формаларын әкелуге арналған.
Dialogue: 0,0:04:19.37,0:04:21.33,Default,,0,0,0,,Оны осылай да көруге болады.
Dialogue: 0,0:04:22.04,0:04:25.50,Default,,0,0,0,,Адамдар Годзилла деп аталатын соңғы өмірді жасауға тырысуда.
Dialogue: 0,0:04:25.58,0:04:27.54,Default,,0,0,0,,Менің ойымша, бұл жай ғана ашу әрекеті болды...
Dialogue: 0,0:04:27.62,0:04:28.75,Default,,0,0,0,,Иә!?
Dialogue: 0,0:04:28.83,0:04:30.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:31.20,0:04:32.95,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:04:38.08,0:04:40.83,Default,,0,0,0,,Мен қателессем де капитан Сакакидің алдында олай істемеймін...
Dialogue: 0,0:04:41.16,0:04:43.79,Default,,0,0,0,,Мен де адам ретінде,
Dialogue: 0,0:04:43.87,0:04:45.75,Default,,0,0,0,,Мен мойындауды жек көремін, бірақ
Dialogue: 0,0:04:46.95,0:04:49.83,Default,,0,0,0,,Құбыжық дегеніміз не? Годзилла дегеніміз не?
Dialogue: 0,0:04:49.91,0:04:53.41,Default,,0,0,0,,Бұл құбыжық, өйткені оны адам қолымен ешқашан жеңе алмайды.
Dialogue: 0,0:04:54.25,0:05:00.04,Default,,0,0,0,,Адамның ақыл-парасаты жетпеген адамды жеңу енді адамның қолында емес!
Dialogue: 0,0:05:00.45,0:05:01.41,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:05:01.50,0:05:05.66,Default,,0,0,0,,Сондықтан... Мен «Годзилланы жеңемін» деп шешкен сәттен бастап
Dialogue: 0,0:05:05.75,0:05:09.41,Default,,0,0,0,,Сіз адам емес, басқа нәрсе болуға ұмтылдыңыз, Харуо.
Dialogue: 0,0:05:10.04,0:05:11.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:11.87,0:05:12.95,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:13.79,0:05:15.12,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:05:15.33,0:05:17.54,Default,,0,0,0,,Егер жеңгіңіз келсе, дайындалыңыз.
Dialogue: 0,0:05:17.62,0:05:21.33,Default,,0,0,0,,Адамдардан асып, Годзилладан асып кетудің соңына жеткенде!
Dialogue: 0,0:05:21.58,0:05:25.04,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:05:25.12,0:05:28.50,Default,,0,0,0,,Харуо~!
Dialogue: 0,0:05:28.58,0:05:29.41,Default,,0,0,0,,(Байланысты ажырату дыбысы)
Dialogue: 0,0:05:30.08,0:05:33.20,Default,,0,0,0,,Осы қоңыраудан кейін Мехагодзилла қаласы үнсіз қалды.
Dialogue: 0,0:05:33.70,0:05:36.54,Default,,0,0,0,,Годзилла қайтадан тыныштық күйіне өтті
Dialogue: 0,0:05:36.62,0:05:39.91,Default,,0,0,0,,Қандай сатқындық!
Dialogue: 0,0:05:40.45,0:05:42.41,Default,,0,0,0,,Бір қадам қалды!
Dialogue: 0,0:05:42.50,0:05:45.25,Default,,0,0,0,,Капитан Сакаки өлім жазасына кесілсін!
Dialogue: 0,0:05:45.33,0:05:47.12,Default,,0,0,0,,Ол жаңа ғана есінен танып қалды.
Dialogue: 0,0:05:47.20,0:05:51.08,Default,,0,0,0,,Біз Годзилланы жеңу мүмкіндігімізден айырылдық!
Dialogue: 0,0:05:51.50,0:05:53.87,Default,,0,0,0,,Годзилла қайтыс болғаннан кейін не болды?
Dialogue: 0,0:05:53.95,0:05:54.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.20,0:05:57.87,Default,,0,0,0,,Бұл қала көлеміндегі наномашиналар
Dialogue: 0,0:05:57.95,0:06:01.83,Default,,0,0,0,,Жер бетінде біз жаһандық қоршаған ортаға не істедік?
Dialogue: 0,0:06:02.20,0:06:06.16,Default,,0,0,0,,Әрине, жаңа өркендеу дәуірі күтіп тұрды!
Dialogue: 0,0:06:06.25,0:06:09.70,Default,,0,0,0,,Бильсардоның даналығын басшылыққа алатын болашақ!
Dialogue: 0,0:06:10.20,0:06:13.91,Default,,0,0,0,,Бұл сол адамның жеке сенімі ғана еді...
Dialogue: 0,0:06:14.00,0:06:14.87,Default,,0,0,0,,Бұл сөз…
Dialogue: 0,0:06:15.45,0:06:17.54,Default,,0,0,0,,Дәл сол күйінде қайтарайық.
Dialogue: 0,0:06:18.04,0:06:20.75,Default,,0,0,0,,Машиналармен біріктірілген құбыжық болды
Dialogue: 0,0:06:20.83,0:06:22.08,Default,,0,0,0,,Өркендеу?
Dialogue: 0,0:06:22.16,0:06:24.54,Default,,0,0,0,,Бұл сіздің жеке сеніміңіз ғана емес.
Dialogue: 0,0:06:24.62,0:06:25.33,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:06:25.41,0:06:28.62,Default,,0,0,0,,Не!? Тіпті сіз Сакаки сияқты ақымақтық жасап жатырсыз!
Dialogue: 0,0:06:28.83,0:06:29.66,Default,,0,0,0,,Жарақаттары салыстырмалы түрде жеңіл болған Тодороки…
Dialogue: 0,0:06:29.95,0:06:32.16,Default,,0,0,0,,Мехагодзилла қаласының супервайзері
Dialogue: 0,0:06:32.25,0:06:35.62,Default,,0,0,0,,Мурел Гаргтың іс-әрекеті бүлікшіл әрекет болып табылады.
Dialogue: 0,0:06:35.70,0:06:38.50,Default,,0,0,0,,Капитан Сакаки мұның алдын алдым деп ойлады.
Dialogue: 0,0:06:38.58,0:06:39.54,Default,,0,0,0,,Бағалау керек
Dialogue: 0,0:06:39.62,0:06:40.87,Default,,0,0,0,,Бос сөзді өткізіп алмаңыз!
Dialogue: 0,0:06:40.95,0:06:42.00,Default,,0,0,0,,Жерлестер!
Dialogue: 0,0:06:42.50,0:06:44.45,Default,,0,0,0,,Барлығыңыз кімнен көмек сұрайсыз?
Dialogue: 0,0:06:44.54,0:06:46.45,Default,,0,0,0,,Сіз бүгінгі күнге дейін аман қалдым деп ойлайсыз ба?
Dialogue: 0,0:06:46.54,0:06:47.91,Default,,0,0,0,,Көмек бергеніңіз үшін
Dialogue: 0,0:06:48.00,0:06:50.45,Default,,0,0,0,,Сіз тіпті тууға немесе өлтіруге құқығыңыз бар деп ойлайсыз ба?
Dialogue: 0,0:06:50.54,0:06:53.12,Default,,0,0,0,,Тіпті ерікті емес адамдарды нанометалдарға қосу және т.б.
Dialogue: 0,0:06:53.20,0:06:55.12,Default,,0,0,0,,Ешбір сылтау жұмыс істемейді!
Dialogue: 0,0:06:55.25,0:06:58.20,Default,,0,0,0,,Бұл Годзилланы жеңуге болатын сөзсіз жауап болды!
Dialogue: 0,0:06:58.29,0:07:00.45,Default,,0,0,0,,Неліктен жағдайды осындай дәрежеде бағалай алмайсыз?
Dialogue: 0,0:07:00.54,0:07:03.50,Default,,0,0,0,,Мехагодзилланың шынайы тұлғасы жақында ғана анықталды!
Dialogue: 0,0:07:03.58,0:07:06.58,Default,,0,0,0,,Бұл Билсалдоның Жерді басып алу қаруы!
Dialogue: 0,0:07:06.66,0:07:10.16,Default,,0,0,0,,Біз ортақ жаумен соғысқан жоқпыз ба?
Dialogue: 0,0:07:10.62,0:07:15.91,Default,,0,0,0,,(Жұмыс дыбысын бақылау)
Dialogue: 0,0:07:18.95,0:07:19.87,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:20.75,0:07:22.25,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:07:22.62,0:07:24.54,Default,,0,0,0,,Бірақ жүрек соғып тұр
Dialogue: 0,0:07:25.04,0:07:26.04,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:07:27.20,0:07:31.08,Default,,0,0,0,,Нанометалдардың күші қорқынышты технология.
Dialogue: 0,0:07:31.16,0:07:36.62,Default,,0,0,0,,Оның денесін эрозияға ұшыратқан металл тіршілікті қамтамасыз ететін жүйе қызметін атқарады.
Dialogue: 0,0:07:37.33,0:07:39.16,Default,,0,0,0,,Ол өмір сүреді
Dialogue: 0,0:07:39.87,0:07:41.20,Default,,0,0,0,,Қазірге дейін бұл жаттығу 10 қатысушымен өтті, бірақ—
Dialogue: 0,0:07:41.79,0:07:44.16,Default,,0,0,0,,Ешқашан қайта оянба
Dialogue: 0,0:07:44.25,0:07:48.16,Default,,0,0,0,,Аратрумға оралыңыз және емдеу үшін жақсырақ құралдарды пайдаланыңыз!
Dialogue: 0,0:07:48.25,0:07:50.75,Default,,0,0,0,,Менің миым жұмысын тоқтатты.
Dialogue: 0,0:07:51.20,0:07:53.70,Default,,0,0,0,,Капитан Ол қазірдің өзінде...
Dialogue: 0,0:07:53.79,0:07:54.75,Default,,0,0,0,,Ха
Dialogue: 0,0:07:55.45,0:07:56.33,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:08:01.41,0:08:02.70,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:08:03.08,0:08:04.95,Default,,0,0,0,,Кемедегі адамдар не дейді?
Dialogue: 0,0:08:05.37,0:08:09.20,Default,,0,0,0,,Сіз қиындыққа тап болдыңыз. Бұл біраз уақытқа қайтарылмайды.
Dialogue: 0,0:08:09.29,0:08:10.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.41,0:08:11.66,Default,,0,0,0,,Капитан Сакаки
Dialogue: 0,0:08:11.75,0:08:15.37,Default,,0,0,0,,Сіздің емдеуіңізге қатысты пікірлер екіге бөлінеді.
Dialogue: 0,0:08:15.83,0:08:20.04,Default,,0,0,0,,Дордо бастаған Бильсардо фракциясы оны түбегейлі айыптауға дайын сияқты.
Dialogue: 0,0:08:20.12,0:08:20.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.79,0:08:24.83,Default,,0,0,0,,Годзилланы жеңуге бір қадам ғана қалдық...?
Dialogue: 0,0:08:25.33,0:08:26.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:26.50,0:08:29.66,Default,,0,0,0,,Егер сіз Гарг пен Билсардпен ынтымақтасатын болсаңыз.
Dialogue: 0,0:08:29.75,0:08:31.91,Default,,0,0,0,,Годзилла жеңуге болатын еді
Dialogue: 0,0:08:32.08,0:08:33.70,Default,,0,0,0,,Бірақ бұл үшін
Dialogue: 0,0:08:33.79,0:08:36.95,Default,,0,0,0,,Сержант Таниден бас тарту туралы шешім қабылдау қажет болды.
Dialogue: 0,0:08:37.25,0:08:41.20,Default,,0,0,0,,Егер солай болса, сен де құбыжық болып кетер едің.
Dialogue: 0,0:08:41.70,0:08:43.16,Default,,0,0,0,,Дене емес
Dialogue: 0,0:08:43.50,0:08:44.91,Default,,0,0,0,,Көңіл күйі ретінде
Dialogue: 0,0:08:45.29,0:08:46.33,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:46.66,0:08:49.50,Default,,0,0,0,,Капитан Сакакидің табиғи адамшылығына байланысты,
Dialogue: 0,0:08:49.58,0:08:52.70,Default,,0,0,0,,Сонда мен Годзилланы жеңе алмадым ба?
Dialogue: 0,0:08:53.16,0:08:56.20,Default,,0,0,0,,Адам болудан бас тартпасаң, құбыжықты жеңе алмайсың дейді.
Dialogue: 0,0:08:56.29,0:08:57.75,Default,,0,0,0,,Гаргтың талаптары
Dialogue: 0,0:08:57.91,0:09:01.66,Default,,0,0,0,,Нәтижесінде парадоксалды дәлел болды.
Dialogue: 0,0:09:01.79,0:09:03.66,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:09:03.95,0:09:07.29,Default,,0,0,0,,Өйткені Харуо өзінің адам ретінде қалай болуы керектігін ерекше ойлайтын.
Dialogue: 0,0:09:07.45,0:09:11.33,Default,,0,0,0,,Билсардоның жаңа Годзилла туылуына тосқауыл қойылды.
Dialogue: 0,0:09:11.91,0:09:12.83,Default,,0,0,0,,Неге...
Dialogue: 0,0:09:13.70,0:09:15.41,Default,,0,0,0,,Мен ғана құтқарылдым...
Dialogue: 0,0:09:16.04,0:09:17.04,Default,,0,0,0,,Юко...
Dialogue: 0,0:09:17.83,0:09:19.62,Default,,0,0,0,,Бұл... ғажайып.
Dialogue: 0,0:09:20.37,0:09:21.41,Default,,0,0,0,,Капитан…
Dialogue: 0,0:09:21.62,0:09:23.83,Default,,0,0,0,,Оның мағынасы бар деп ойламайсыз ба?
Dialogue: 0,0:09:24.20,0:09:26.00,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:09:26.08,0:09:29.66,Default,,0,0,0,,Билсард Құдайға бет бұрып, тәкаппарлық жолымен жүрді.
Dialogue: 0,0:09:29.75,0:09:33.95,Default,,0,0,0,,Олардың арбауына түскен Юуко да өлді. Жаза өтелді.
Dialogue: 0,0:09:34.04,0:09:35.62,Default,,0,0,0,,Клиноктың бағыты мен қылышты айналдырған кезде қолданылатын күш бағыты дәл бірдей болуы керек
Dialogue: 0,0:09:36.41,0:09:38.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:38.29,0:09:41.70,Default,,0,0,0,,Тек сені бірдеңе қорғап, аман қалдың.
Dialogue: 0,0:09:41.79,0:09:44.08,Default,,0,0,0,,Ол бізді құтқарды.
Dialogue: 0,0:09:44.29,0:09:46.12,Default,,0,0,0,,Бұл бата болуы керек.
Dialogue: 0,0:09:46.29,0:09:50.08,Default,,0,0,0,,Бұл сіздің таңдауыңыздың дұрыс екендігінің көрінісі.
Dialogue: 0,0:09:50.91,0:09:52.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:56.83,0:09:57.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:00.25,0:10:01.45,Default,,0,0,0,,Балалар...
Dialogue: 0,0:10:01.54,0:10:04.25,Default,,0,0,0,,Мұны барлығы осы сынақ арқылы түсінді.
Dialogue: 0,0:10:04.87,0:10:06.79,Default,,0,0,0,,Ұлы Құдайдың еркі
Dialogue: 0,0:10:08.20,0:10:11.37,Default,,0,0,0,,Мен бұл туралы осы уақытқа дейін шындап ойлаған емеспін.
Dialogue: 0,0:10:12.00,0:10:15.37,Default,,0,0,0,,Бірақ мен енді күмәнданбаймын
Dialogue: 0,0:10:15.50,0:10:18.87,Default,,0,0,0,,Құдай бізді бақылап тұр, капитан.
Dialogue: 0,0:10:19.12,0:10:20.54,Default,,0,0,0,,Годзиллаға қарсы тұру...
Dialogue: 0,0:10:20.66,0:10:22.29,Default,,0,0,0,,Біздің дұғаларымыз!
Dialogue: 0,0:10:22.37,0:10:23.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.20,0:10:37.20,Default,,0,0,0,,Юко...
Dialogue: 0,0:10:38.16,0:10:39.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:39.75,0:10:40.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:41.20,0:10:43.50,Default,,0,0,0,,Егер жеңгіңіз келсе, дайындалыңыз.
Dialogue: 0,0:10:43.62,0:10:46.87,Default,,0,0,0,,Сіз адамдардан және Годзилладан асып кетудің соңына жеткенде!
Dialogue: 0,0:10:49.33,0:10:50.41,Default,,0,0,0,,Маған...
Dialogue: 0,0:10:53.04,0:10:54.16,Default,,0,0,0,,Мүмкін емес…
Dialogue: 0,0:11:09.00,0:11:10.00,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:11:10.16,0:11:12.75,Default,,0,0,0,,Футуа құдайы қайда
Dialogue: 0,0:11:13.37,0:11:16.00,Default,,0,0,0,,Кіру үшін кешірім қажет
Dialogue: 0,0:11:17.00,0:11:19.45,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:11:19.70,0:11:22.70,Default,,0,0,0,,Кешіріңіз, мен адасып қалдым деп ойлаймын.
Dialogue: 0,0:11:31.54,0:11:35.41,Default,,0,0,0,,Ақырында, бұл Құс тек сәтті қалпына келтірілді.
Dialogue: 0,0:11:35.83,0:11:38.29,Default,,0,0,0,,Бірақ басқару блогы бұзылған кезде
Dialogue: 0,0:11:38.37,0:11:40.33,Default,,0,0,0,,Апаттық тоқтату сигналын қабылдау кезінде
Dialogue: 0,0:11:40.41,0:11:41.79,Default,,0,0,0,,Пәрмен құлыпталған
Dialogue: 0,0:11:42.29,0:11:44.62,Default,,0,0,0,,Мен оны қайта іске қосып көрсем де, ол электр қуатын да қабылдамайды.
Dialogue: 0,0:11:45.16,0:11:47.95,Default,,0,0,0,,Нанометалл функциясының өзі қатып қалған ба?
Dialogue: 0,0:11:48.33,0:11:51.58,Default,,0,0,0,,Берубтар Нанометалды қалай қайта іске қосты?
Dialogue: 0,0:11:51.66,0:11:54.29,Default,,0,0,0,,Себебі сіз оны соңына дейін бөліскен жоқсыз.
Dialogue: 0,0:11:55.12,0:11:58.08,Default,,0,0,0,,Біз Мехагодзилла қаласының қалдықтарын талдауға тырыссақ та,
Dialogue: 0,0:11:58.16,0:12:01.08,Default,,0,0,0,,Қатты қызудың әсерінен композиция құлады.
Dialogue: 0,0:12:02.25,0:12:03.83,Default,,0,0,0,,Бас тартудың уақыты келді.
Dialogue: 0,0:12:06.29,0:12:10.62,Default,,0,0,0,,Мені және Соколовты Nanometal дерлік бір уақытта тұтқынға алды.
Dialogue: 0,0:12:10.95,0:12:14.12,Default,,0,0,0,,Оның жұтылуы үшін шынымен де біраз уақыт қажет болды.
Dialogue: 0,0:12:14.20,0:12:15.12,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:12:15.20,0:12:18.00,Default,,0,0,0,,Қараңдар, мен оны қолымның осы жеріне алдым.
Dialogue: 0,0:12:18.12,0:12:19.29,Default,,0,0,0,,Бірақ ештеңе жоқ
Dialogue: 0,0:12:20.00,0:12:24.45,Default,,0,0,0,,Соколов жақсы болмады, бірақ мен оны оңай сілкіп тастадым.
Dialogue: 0,0:12:25.00,0:12:26.45,Default,,0,0,0,,Мен оны түсіндіре алмаймын.
Dialogue: 0,0:12:26.75,0:12:29.50,Default,,0,0,0,,Дұрыс, бұл ғажайып.
Dialogue: 0,0:12:29.58,0:12:31.37,Default,,0,0,0,,Иә, бұл ғажайып.
Dialogue: 0,0:12:31.45,0:12:34.41,Default,,0,0,0,,Иә, бұл даусыз ғажайып.
Dialogue: 0,0:12:34.79,0:12:39.50,Default,,0,0,0,,Капитан Сакаки сияқты сен де жарылқадың.
Dialogue: 0,0:12:39.58,0:12:40.87,Default,,0,0,0,,Капитан Сакаки
Dialogue: 0,0:12:41.58,0:12:43.08,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:12:44.29,0:12:47.54,Default,,0,0,0,,Мен қашуды сағынып, нанометаллға тигенім рас.
Dialogue: 0,0:12:47.62,0:12:49.83,Default,,0,0,0,,Эрозияға ұшырамағандар да бар.
Dialogue: 0,0:12:50.20,0:12:51.25,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:12:51.87,0:12:54.62,Default,,0,0,0,,Оларда ортақ нәрсе бар
Dialogue: 0,0:12:54.95,0:12:56.62,Default,,0,0,0,,Ғажайыпты естіп, таң қалдым.
Dialogue: 0,0:12:57.33,0:13:01.25,Default,,0,0,0,,Мехагодзилла қаласындағы барлық адамдар денсаулығының нашарлығына шағымданды.
Dialogue: 0,0:13:01.33,0:13:03.16,Default,,0,0,0,,Бұл менің тексеруден өтіп жатқан адамдар.
Dialogue: 0,0:13:03.25,0:13:04.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.45,0:13:06.95,Default,,0,0,0,,Сіз де солай жасадыңыз, капитан.
Dialogue: 0,0:13:07.04,0:13:09.91,Default,,0,0,0,,Ендеше, бізде не ортақ...
Dialogue: 0,0:13:10.08,0:13:13.29,Default,,0,0,0,,Олардың барлығы Хутуа ауылында емделді.
Dialogue: 0,0:13:13.70,0:13:15.54,Default,,0,0,0,,Бәлкім, футуаға ем ретінде
Dialogue: 0,0:13:15.87,0:13:17.58,Default,,0,0,0,,Нанометалл эрозиясының алдын алу
Dialogue: 0,0:13:17.66,0:13:20.20,Default,,0,0,0,,Оның құрамында антиденелер сияқты компоненттер болуы мүмкін.
Dialogue: 0,0:13:21.54,0:13:25.04,Default,,0,0,0,,Себеп соншалықты анық болса, неге бәріне айтпайсың?
Dialogue: 0,0:13:25.12,0:13:28.66,Default,,0,0,0,,Сәйкес келетін ортадамын деп ойлайсың ба? Бұл әзіл емес
Dialogue: 0,0:13:28.83,0:13:31.20,Default,,0,0,0,,Опасыз болсаң дарға асылады.
Dialogue: 0,0:13:31.62,0:13:33.70,Default,,0,0,0,,Қазір тірі қалғандардың көпшілігі
Dialogue: 0,0:13:33.79,0:13:36.25,Default,,0,0,0,,Дінді Exif культіне өзгертті
Dialogue: 0,0:13:36.33,0:13:40.04,Default,,0,0,0,,Мен қашып құтыла алмайтын осындай ортада азшылық болғым келмейді.
Dialogue: 0,0:13:40.33,0:13:41.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:43.50,0:13:47.75,Default,,0,0,0,,Өткенге қарасақ, күнделікті өмірде ғажайыптар болған.
Dialogue: 0,0:13:48.08,0:13:50.45,Default,,0,0,0,,Енді мен ештеңе көре алмадым...
Dialogue: 0,0:13:50.54,0:13:53.58,Default,,0,0,0,,Содан кейін біз дәрі-дәрмектің нормасын шектейміз.
Dialogue: 0,0:13:53.66,0:13:55.00,Default,,0,0,0,,Жарайсың ба? Captain Sakaki
Dialogue: 0,0:13:55.08,0:13:56.95,Default,,0,0,0,,Сол іске асырудың өзі ғажайып.
Dialogue: 0,0:13:57.04,0:13:57.87,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:13:57.95,0:14:00.79,Default,,0,0,0,,Түсіндім... Солай ма?
Dialogue: 0,0:14:01.25,0:14:02.50,Default,,0,0,0,,Мен байқадым...
Dialogue: 0,0:14:03.04,0:14:04.41,Default,,0,0,0,,Метфис Бір сәтке бола аламын ба?
Dialogue: 0,0:14:06.91,0:14:08.70,Default,,0,0,0,,Жаяу жүргенде жасасам қарсы ма?
Dialogue: 0,0:14:08.79,0:14:10.29,Default,,0,0,0,,Бұл жеке әңгіме.
Dialogue: 0,0:14:11.29,0:14:13.12,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:14:20.20,0:14:22.50,Default,,0,0,0,,Олай болса әңгіме қандай?
Dialogue: 0,0:14:22.58,0:14:24.75,Default,,0,0,0,,Біз нанометалдардан қорғандық.
Dialogue: 0,0:14:24.83,0:14:26.25,Default,,0,0,0,,Бұл ғажайып емес
Dialogue: 0,0:14:26.37,0:14:29.25,Default,,0,0,0,,Өйткені ол Фтуаның емінен антиденелер жасаған.
Dialogue: 0,0:14:29.33,0:14:31.54,Default,,0,0,0,,О, мен солай ойлаймын.
Dialogue: 0,0:14:31.95,0:14:32.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:33.16,0:14:35.08,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:35.33,0:14:36.12,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:36.58,0:14:39.33,Default,,0,0,0,,Сен мұны білесің бе және әлі де бәрін алдап жүрсің бе?
Dialogue: 0,0:14:40.20,0:14:44.00,Default,,0,0,0,,Бұл жердегілердің құндылықтарына негізделген арамдық көзқарас сияқты көрінуі мүмкін, бірақ
Dialogue: 0,0:14:44.45,0:14:48.41,Default,,0,0,0,,Өйткені, жағдай - бұл жағдай және сіз тек құралдарды таңдай алмайсыз.
Dialogue: 0,0:14:48.66,0:14:49.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.25,0:14:53.33,Default,,0,0,0,,...
Dialogue: 0,0:14:53.87,0:14:55.83,Default,,0,0,0,,Себебін сұрасаң, жауап беремін.
Dialogue: 0,0:14:56.45,0:14:58.79,Default,,0,0,0,,Годзилламен қайтадан күресу
Dialogue: 0,0:14:59.00,0:15:03.58,Default,,0,0,0,,Біз келесі шайқасқа дайындалу үшін жүрегімізді біріктіруіміз керек.
Dialogue: 0,0:15:03.70,0:15:05.45,Default,,0,0,0,,Бірақ Годзилла үшін...
Dialogue: 0,0:15:07.12,0:15:08.08,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:15:09.45,0:15:10.41,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:15:11.00,0:15:13.45,Default,,0,0,0,,Сіз шынымен де осылай айтып отырсыз ба?
Dialogue: 0,0:15:13.79,0:15:16.25,Default,,0,0,0,,Мен оны дәлірек айтқанда тыңдағым келеді.
Dialogue: 0,0:15:16.50,0:15:19.83,Default,,0,0,0,,Годзилланы жеңуге жол жоқ па? Немесе...
Dialogue: 0,0:15:19.91,0:15:22.79,Default,,0,0,0,,Сіз Годзилланы жеңу шешімін жоғалттыңыз ба?
Dialogue: 0,0:15:24.16,0:15:28.04,Default,,0,0,0,,Егер бұл біріншісі болса, бұрын айтқаныңызды кері қайтаруға болады.
Dialogue: 0,0:15:28.25,0:15:30.33,Default,,0,0,0,,Мен құралдарды беремін.
Dialogue: 0,0:15:30.95,0:15:33.04,Default,,0,0,0,,Сіз табынатын Құдай
Dialogue: 0,0:15:33.41,0:15:35.58,Default,,0,0,0,,Сіз Годзилланы жеңе аламын деп ойлайсыз ба?
Dialogue: 0,0:15:35.75,0:15:37.04,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:15:37.12,0:15:37.95,Default,,0,0,0,,А...
Dialogue: 0,0:15:38.04,0:15:40.83,Default,,0,0,0,,«Өте дамыған ғылымды сиқырдан ажыратуға болмайды».
Dialogue: 0,0:15:41.41,0:15:44.66,Default,,0,0,0,,Бұл жер туралы ғалымның сөзі еді.
Dialogue: 0,0:15:45.29,0:15:47.20,Default,,0,0,0,,Олай болса, сіз осылай ойладыңыз ба?
Dialogue: 0,0:15:47.54,0:15:51.12,Default,,0,0,0,,Окультизм мен ырымдар сияқты Құдай туралы айту
Dialogue: 0,0:15:51.20,0:15:53.29,Default,,0,0,0,,Бірінші кезекте сенің ғылымың
Dialogue: 0,0:15:53.37,0:15:56.12,Default,,0,0,0,,Өйткені сіз Құдайды түсінуге жетілмегенсіз.
Dialogue: 0,0:15:56.20,0:15:57.75,Default,,0,0,0,,Жоқ... Уф
Dialogue: 0,0:15:57.91,0:16:02.00,Default,,0,0,0,,Біз үшін Құдайдың бар болуы математикалық нәтиже болып табылады.
Dialogue: 0,0:16:02.29,0:16:03.70,Default,,0,0,0,,Балалар, оған әлі жеткен жоқсыңдар.
Dialogue: 0,0:16:03.79,0:16:06.04,Default,,0,0,0,,Гематрияны есептеу деп аталатын технология
Dialogue: 0,0:16:06.12,0:16:09.58,Default,,0,0,0,,Ол бізге жоғары өлшемді тіршілік иелерімен байланыс орнатуға мүмкіндік берді.
Dialogue: 0,0:16:09.75,0:16:11.37,Default,,0,0,0,,Шехер астрономиялық кітапханасының басқарма бастығы, «Юстиция» обсерваториясында
Dialogue: 0,0:16:11.70,0:16:12.79,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:16:13.12,0:16:14.95,Default,,0,0,0,,Жер адамдарында батылдық пен стратегия бар
Dialogue: 0,0:16:15.04,0:16:18.29,Default,,0,0,0,,Бильсардоның инженерлік технологияға сүйенгені сияқты.
Dialogue: 0,0:16:18.75,0:16:23.29,Default,,0,0,0,,Біз, Exif, Годзилланы жеңу үшін Құдайға сене аламыз.
Dialogue: 0,0:16:23.37,0:16:25.04,Default,,0,0,0,,Мені мазақ етпе!
Dialogue: 0,0:16:25.70,0:16:27.25,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:16:27.33,0:16:30.50,Default,,0,0,0,,Осындай ұлы Құдай бәрін шеше алса.
Dialogue: 0,0:16:30.58,0:16:32.37,Default,,0,0,0,,Осы уақытқа дейін қандай құрбандық шалды?
Dialogue: 0,0:16:32.95,0:16:35.00,Default,,0,0,0,,Бәрі бекер өлсе де! ?
Dialogue: 0,0:16:35.16,0:16:37.12,Default,,0,0,0,,Маған күту ғана қалды.
Dialogue: 0,0:16:38.70,0:16:40.25,Default,,0,0,0,,Уақыттың толықтығы үшін
Dialogue: 0,0:16:42.16,0:16:44.45,Default,,0,0,0,,Қазір жүрегіңді күйдіретін ашу
Dialogue: 0,0:16:44.79,0:16:46.91,Default,,0,0,0,,Годзиллаға деген өшпенділік
Dialogue: 0,0:16:47.00,0:16:50.08,Default,,0,0,0,,Білмей тұрып, дұға болып, Құдайға жетеді.
Dialogue: 0,0:16:50.33,0:16:52.45,Default,,0,0,0,,Сондықтан мен күтемін
Dialogue: 0,0:16:52.75,0:16:55.83,Default,,0,0,0,,Құдайға күмәнданатын жүрегіңнен де артық
Dialogue: 0,0:16:55.91,0:16:59.37,Default,,0,0,0,,Годзиллаға деген өшпенділігім жеңген сәт
Dialogue: 0,0:17:00.20,0:17:01.95,Default,,0,0,0,,Егер мен дінімді өзгертсем
Dialogue: 0,0:17:02.04,0:17:04.41,Default,,0,0,0,,«Мен сен үшін Годзилланы жеңемін»?
Dialogue: 0,0:17:04.50,0:17:05.87,Default,,0,0,0,,Мені күлдірме!
Dialogue: 0,0:17:05.95,0:17:08.45,Default,,0,0,0,,Адам ата мен басқаларды осылай көндірді!
Dialogue: 0,0:17:08.54,0:17:10.79,Default,,0,0,0,,Бұл тек сенсің, Харуо.
Dialogue: 0,0:17:11.20,0:17:16.41,Default,,0,0,0,,Егер Құдай осы планетаға шақырылса, сіз құрбандық үстелінде тұруға лайықты адамсыз.
Dialogue: 0,0:17:16.54,0:17:17.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:17.91,0:17:19.08,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:17:19.16,0:17:22.50,Default,,0,0,0,,Басқалардан да асылы, мақтанышы
Dialogue: 0,0:17:22.91,0:17:26.00,Default,,0,0,0,,Сен сенуші едің және адамдардың қандай екеніне ешқашан күмәнданбадың.
Dialogue: 0,0:17:26.08,0:17:28.12,Default,,0,0,0,,Сонымен мен сені таптым
Dialogue: 0,0:17:28.79,0:17:34.08,Default,,0,0,0,,Годзилланы шынымен жек көретін адам ретінде Құдайдың алдында тұруы керек кейіпкер
Dialogue: 0,0:17:34.16,0:17:36.33,Default,,0,0,0,,Сіз мұны бұрын айтпадыңыз ба?
Dialogue: 0,0:17:36.41,0:17:37.50,Default,,0,0,0,,Харуо
Dialogue: 0,0:17:37.83,0:17:39.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:49.04,0:17:51.91,Default,,0,0,0,,Аратрум Жердің геосинхронды орбитасын сақтайды
Dialogue: 0,0:17:52.08,0:17:54.50,Default,,0,0,0,,Инженер Билсардоның ауысымдық бойкотына байланысты.
Dialogue: 0,0:17:54.58,0:17:57.04,Default,,0,0,0,,Гравитациялық катушкалар қозғалтқышының жұмыс тиімділігі төмендеді.
Dialogue: 0,0:17:57.45,0:18:01.70,Default,,0,0,0,,Жер сферасынан қайтадан шығуды қарастыруымыз керек кезде...
Dialogue: 0,0:18:02.08,0:18:04.16,Default,,0,0,0,,Капитан, уақыт жоқ.
Dialogue: 0,0:18:04.70,0:18:08.08,Default,,0,0,0,,Капитан Сакаки оқиғасына қатысты біз онымен күресу саясатын шешуіміз керек.
Dialogue: 0,0:18:08.16,0:18:09.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:09.79,0:18:11.41,Default,,0,0,0,,Бұл төтенше жағдай.
Dialogue: 0,0:18:11.50,0:18:12.54,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:18:12.66,0:18:13.79,Default,,0,0,0,,Капитан Мори...
Dialogue: 0,0:18:14.12,0:18:16.91,Default,,0,0,0,,және Орталық Комитеттің мүшелері
Dialogue: 0,0:18:17.29,0:18:19.70,Default,,0,0,0,,Сіздің қорлайтын көзқарасыңыз үшін
Dialogue: 0,0:18:20.20,0:18:22.08,Default,,0,0,0,,Біз, Билсардо, осымен
Dialogue: 0,0:18:22.16,0:18:25.95,Default,,0,0,0,,Біз күш қолдану арқылы үзілді-кесілді қарсылық көрсетеміз!
Dialogue: 0,0:18:27.29,0:18:31.70,Default,,0,0,0,,Мехагодзилла қаласында қызметтік борышын өтеу кезінде қаза тапқан отандастарымызға көңіл айтамыз.
Dialogue: 0,0:18:31.79,0:18:35.45,Default,,0,0,0,,Капитан Харуо Сакакиді жауапкершілікке тартуға міндеттеніңіз.
Dialogue: 0,0:18:36.25,0:18:38.50,Default,,0,0,0,,Осы өтініш орындалғанға дейін
Dialogue: 0,0:18:38.58,0:18:42.41,Default,,0,0,0,,Біз Аратрумға келетін барлық қуатты өшіреміз.
Dialogue: 0,0:18:42.50,0:18:43.33,Default,,0,0,0,,(Байланысты ажырату дыбысы)
Dialogue: 0,0:18:51.62,0:18:54.37,Default,,0,0,0,,Дордо, сен осы уақытқа дейін барасың ба? ?
Dialogue: 0,0:18:55.16,0:18:57.91,Default,,0,0,0,,Әрине, азшылық Бильсардо үшін.
Dialogue: 0,0:18:58.00,0:19:02.16,Default,,0,0,0,,Мехагодзилла оқиғасын ақтау мүмкін бе, бұл өмір мен өлім мәселесі.
Dialogue: 0,0:19:02.75,0:19:03.58,Default,,0,0,0,,Қосалқы батареялар туралы не деуге болады?
Dialogue: 0,0:19:05.04,0:19:06.12,Default,,0,0,0,,Әлі тірі және жақсы
Dialogue: 0,0:19:06.20,0:19:10.12,Default,,0,0,0,,Алайда, тұрғын үй-жайлардағы айналым жүйесі тек 48 сағат бойы ғана сақталуы мүмкін.
Dialogue: 0,0:19:10.41,0:19:12.33,Default,,0,0,0,,Тез арада қауіпсіздік күштерін шақырыңыз!
Dialogue: 0,0:19:12.41,0:19:15.16,Default,,0,0,0,,Қуат бөлмесін қайта басып алу стратегиясын жоспарлауды бастаңыз
Dialogue: 0,0:19:15.25,0:19:18.37,Default,,0,0,0,,Күте тұрыңыз! Сіз жағдайды одан да нашарлатуға тырысасыз ба?
Dialogue: 0,0:19:18.45,0:19:20.25,Default,,0,0,0,,Бұл нағыз көтеріліс!
Dialogue: 0,0:19:20.70,0:19:23.58,Default,,0,0,0,,Бұл енді жалғыз капитан Сакакидің ісі емес.
Dialogue: 0,0:19:23.66,0:19:25.37,Default,,0,0,0,,Осындай қорқытуға көнсеңіз
Dialogue: 0,0:19:25.66,0:19:29.12,Default,,0,0,0,,Біз бұдан былай Бирсалдоға барлық бақылауды береміз.
Dialogue: 0,0:19:29.20,0:19:31.08,Default,,0,0,0,,Ол аударылады!
Dialogue: 0,0:19:35.58,0:19:38.29,Default,,0,0,0,,Әй, бұл жерде болды ғой.
Dialogue: 0,0:19:39.00,0:19:41.08,Default,,0,0,0,,Метфи есінен танып қалды.
Dialogue: 0,0:19:41.83,0:19:43.45,Default,,0,0,0,,Бір-бірімізді түсінбейтін сияқтымыз
Dialogue: 0,0:19:43.54,0:19:45.29,Default,,0,0,0,,Діни адам ретінде
Dialogue: 0,0:19:45.37,0:19:48.58,Default,,0,0,0,,Мен дұрыс болмыс жолына оралдым деп айта аласыз деп ойлаймын.
Dialogue: 0,0:19:49.37,0:19:52.91,Default,,0,0,0,,Ақыр соңында, бұл миссионерлік қызмет үшін тамаша мүмкіндік.
Dialogue: 0,0:19:53.00,0:19:56.66,Default,,0,0,0,,Тіпті Мехагодзилланың да жеңе алмайтынын білгенде бәрінің жүрегі ауырды.
Dialogue: 0,0:19:56.75,0:20:01.62,Default,,0,0,0,,Сол үмітсіздіктен құтылудың жалғыз жолы – Құдайға арқа сүйеу.
Dialogue: 0,0:20:01.70,0:20:03.62,Default,,0,0,0,,Мен оны жай қалдыруым керек пе...
Dialogue: 0,0:20:03.70,0:20:07.75,Default,,0,0,0,,Жақсы болсын, жаман болсын, бұдан былай ештеңе айтуға құқығыңыз жоқ.
Dialogue: 0,0:20:07.83,0:20:10.37,Default,,0,0,0,,Уф... Бұл нені білдіреді?
Dialogue: 0,0:20:10.45,0:20:12.00,Default,,0,0,0,,Ақылды нәрсе
Dialogue: 0,0:20:12.08,0:20:14.29,Default,,0,0,0,,Метфис Мехагодзилла қаласындағы оқиғаға қатысты.
Dialogue: 0,0:20:14.87,0:20:19.12,Default,,0,0,0,,Жауапкершілігіңе деген сұрақтың орнына діни кереметке айналдырдым.
Dialogue: 0,0:20:19.29,0:20:22.79,Default,,0,0,0,,Нәтиже Капитан Сакакиді сенімді басшы таниды.
Dialogue: 0,0:20:22.87,0:20:25.12,Default,,0,0,0,,Құрбандық үстелінің безендірілуіне айналды.
Dialogue: 0,0:20:25.20,0:20:26.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:26.12,0:20:29.00,Default,,0,0,0,,Саған бәрі риза болып, саған ғана құлшылық етеді.
Dialogue: 0,0:20:29.08,0:20:31.00,Default,,0,0,0,,Мен сіздің пікіріңізді сұрамаймын.
Dialogue: 0,0:20:31.45,0:20:34.37,Default,,0,0,0,,Мен тек Метфидің сөздерін тыңдаймын.
Dialogue: 0,0:20:34.79,0:20:36.70,Default,,0,0,0,,Бастама толығымен оныкі.
Dialogue: 0,0:20:37.00,0:20:37.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:38.62,0:20:41.08,Default,,0,0,0,,Айтпақшы, менің не істегенімді қалайсың?
Dialogue: 0,0:20:41.16,0:20:44.04,Default,,0,0,0,,Аа, дұрыс, бір секундқа осында келіңіз.
Dialogue: 0,0:20:45.50,0:20:49.54,Default,,0,0,0,,Енді мұнда жаңа дұға құрбандық үстелі орнатылды.
Dialogue: 0,0:20:50.04,0:20:52.66,Default,,0,0,0,,Қане, Аллаға мадақ айтайық!
Dialogue: 0,0:20:53.33,0:20:57.66,Default,,0,0,0,,Тек дұға етіп, кереметтерге сеніңіз!
Dialogue: 0,0:20:58.58,0:21:03.45,Default,,0,0,0,,Құдай бізге арнаудан басқа құтқарылу мен баталар береді.
Dialogue: 0,0:21:03.91,0:21:08.25,Default,,0,0,0,,Галбиторияның басшылығы бізбен бірге болсын.
Dialogue: 0,0:21:19.08,0:21:23.29,Default,,0,0,0,,Негізі, мен аналық кемеден соңғы ақпаратты алдым.
Dialogue: 0,0:21:23.37,0:21:26.54,Default,,0,0,0,,Билсард Аратрумның қуат бөлмесін басып алған сияқты.
Dialogue: 0,0:21:26.62,0:21:27.70,Default,,0,0,0,,Не... не?!
Dialogue: 0,0:21:28.37,0:21:32.70,Default,,0,0,0,,Сіздің өліміңіз туралы шешім қабылданғанға дейін борттағы қуат өшіріледі.
Dialogue: 0,0:21:33.20,0:21:34.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:34.37,0:21:35.25,Default,,0,0,0,,Міне.
Dialogue: 0,0:21:36.25,0:21:39.58,Default,,0,0,0,,Жағдайды тыныштандырудың ең жылдам жолы
Dialogue: 0,0:21:40.29,0:21:42.87,Default,,0,0,0,,Мен сенің мені тастап кеткеніңді қалаймын деп ойлаймын.
Dialogue: 0,0:21:43.70,0:21:46.41,Default,,0,0,0,,Менің ойымша, бұл сыртқы түрі бойынша қашу деп атауға болады.
Dialogue: 0,0:21:46.50,0:21:47.33,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:47.58,0:21:49.95,Default,,0,0,0,,Менің ойымша, бұл өте жағымсыз.
Dialogue: 0,0:21:50.04,0:21:53.91,Default,,0,0,0,,Бұл сіздің қауіпсіздігіңізді қамтамасыз етудің және жағдайды тыныштандырудың жалғыз жолы.
Dialogue: 0,0:21:54.62,0:21:57.50,Default,,0,0,0,,Сіз өзіңізді капитан Мори мен басқаларға жеткілікті қорғай алмайсыз.
Dialogue: 0,0:21:57.58,0:21:59.29,Default,,0,0,0,,Әскери жарғылардан ауытқысаңыз
Dialogue: 0,0:21:59.62,0:22:01.04,Default,,0,0,0,,Дордомен және басқалармен келіссөздер
Dialogue: 0,0:22:01.12,0:22:03.20,Default,,0,0,0,,Мүмкін біз қандай да бір ымыраға келерміз
Dialogue: 0,0:22:03.33,0:22:04.83,Default,,0,0,0,,Бірақ олай емес...
Dialogue: 0,0:22:04.91,0:22:06.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:22:06.08,0:22:08.25,Default,,0,0,0,,Негізгі шешімнен алыс
Dialogue: 0,0:22:08.33,0:22:11.79,Default,,0,0,0,,Бірақ бәрі суығанша уақытты сатып аламыз.
Dialogue: 0,0:22:13.20,0:22:14.45,Default,,0,0,0,,Миана... неге
Dialogue: 0,0:22:15.25,0:22:17.33,Default,,0,0,0,,Бұл бала ынтымақтасады.
Dialogue: 0,0:22:17.62,0:22:18.66,Default,,0,0,0,,Менің түсіндіруім
Dialogue: 0,0:22:18.75,0:22:21.25,Default,,0,0,0,,Қаншалықты түсінетініңді білмеймін...
Dialogue: 0,0:22:22.79,0:22:25.58,Default,,0,0,0,,Haruo Hide Қауіпсіздік…
Dialogue: 0,0:22:25.66,0:22:29.20,Default,,0,0,0,,Иә, бұл жеткілікті деп ойлаймын.
Dialogue: 0,0:22:30.50,0:22:32.37,Default,,0,0,0,,Капитан, мен осында қалсам да.
Dialogue: 0,0:22:32.45,0:22:34.95,Default,,0,0,0,,Оны Метфис өз пайдасына пайдаланып жатыр.
Dialogue: 0,0:22:35.70,0:22:39.41,Default,,0,0,0,,Кейде ең жақсы таңдау - ештеңе істемеу.
Dialogue: 0,0:22:39.58,0:22:41.20,Default,,0,0,0,,Міне, шыдамдылық.
Dialogue: 0,0:22:41.29,0:22:42.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:45.25,0:22:46.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:22:52.50,0:22:53.25,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:59.79,0:23:00.91,Default,,0,0,0,,Харуо?
Dialogue: 0,0:23:04.75,0:23:07.12,Default,,0,0,0,,ауыр қайғы
Dialogue: 0,0:23:07.50,0:23:08.33,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:23:10.41,0:23:11.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:12.87,0:23:14.83,Default,,0,0,0,,Мен Годзилланы жеңгім келді
Dialogue: 0,0:23:16.04,0:23:19.33,Default,,0,0,0,,Оны жеңетін құрал да менің алдымда болды.
Dialogue: 0,0:23:20.33,0:23:23.66,Default,,0,0,0,,Бірақ мен таңдай алмадым...
Dialogue: 0,0:23:25.04,0:23:28.66,Default,,0,0,0,,Адамзат бір кездері Годзилладан жеңіліп қалды
Dialogue: 0,0:23:29.20,0:23:33.00,Default,,0,0,0,,Тірі қалғандар өркениетін жоғалтты.
Dialogue: 0,0:23:33.20,0:23:37.91,Default,,0,0,0,,Қашып кеткендер маңыздырақ нәрсені ұмытып кетті...
Dialogue: 0,0:23:38.95,0:23:43.25,Default,,0,0,0,,Егер мен Годзилламен қайтадан бетпе-бет келуге батылым жетсем
Dialogue: 0,0:23:43.70,0:23:47.37,Default,,0,0,0,,Мен бір нәрсені қайтара алатыныма сенімді болдым.
Dialogue: 0,0:23:48.00,0:23:52.66,Default,,0,0,0,,Бірақ соңында адамдар бір-бірімен соғысады.
Dialogue: 0,0:23:53.25,0:23:57.62,Default,,0,0,0,,Шындыққа бет бұрып, Менде енді қонатын жер де жоқ.
Dialogue: 0,0:23:59.66,0:24:02.20,Default,,0,0,0,,Сен неге сонша келдің?
Dialogue: 0,0:24:06.75,0:24:09.79,Default,,0,0,0,,Сен де, мен де
Dialogue: 0,0:24:10.75,0:24:12.16,Default,,0,0,0,,(Көрермендер) Бұл Косей Арима ғой. (Көрермендер) Аизаның кішкентай қарындасымен бе?
Dialogue: 0,0:24:12.79,0:24:15.25,Default,,0,0,0,,Мен жеңдім және осындамын.
Dialogue: 0,0:24:17.04,0:24:17.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:18.58,0:24:20.54,Default,,0,0,0,,Біз ресми түрде келісімге келдік.
Dialogue: 0,0:24:20.91,0:24:21.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:24:22.41,0:24:23.70,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:24:24.08,0:24:26.45,Default,,0,0,0,,Мен әрқашан жеңілгім келді
Dialogue: 0,0:24:27.20,0:24:28.37,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:24:28.83,0:24:31.33,Default,,0,0,0,,Жеңіс немесе жеңілу сіз үшін...
Dialogue: 0,0:24:32.00,0:24:33.00,Default,,0,0,0,,Не?
Dialogue: 0,0:24:33.95,0:24:35.33,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:24:35.62,0:24:37.08,Default,,0,0,0,,Аман бол
Dialogue: 0,0:24:37.58,0:24:39.20,Default,,0,0,0,,Өмірді байланыстыру
Dialogue: 0,0:24:40.12,0:24:42.58,Default,,0,0,0,,Жоғалту – өлу
Dialogue: 0,0:24:42.83,0:24:44.12,Default,,0,0,0,,Жоғалу
Dialogue: 0,0:24:44.91,0:24:46.83,Default,,0,0,0,,Годзиллаға қарсы тұру
Dialogue: 0,0:24:49.50,0:24:50.75,Default,,0,0,0,,Харуо
Dialogue: 0,0:24:51.04,0:24:52.91,Default,,0,0,0,,Сіз жеңуіңіз керек
Dialogue: 0,0:24:54.04,0:24:56.20,Default,,0,0,0,,Бұдан былай да
Dialogue: 0,0:24:57.08,0:25:00.08,Default,,0,0,0,,Бізбен бірге
Dialogue: 0,0:25:02.62,0:25:04.29,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:25:07.54,0:25:09.00,Default,,0,0,0,,Мен аламын
Dialogue: 0,0:25:10.41,0:25:11.70,Default,,0,0,0,,Өмірді байланыстыру
Dialogue: 0,0:25:14.66,0:25:15.95,Default,,0,0,0,,А... а...
Dialogue: 0,0:25:16.41,0:25:18.12,Default,,0,0,0,,Неліктен бұлай етер едіңіз?
Dialogue: 0,0:25:18.50,0:25:21.33,Default,,0,0,0,,Маребитоны қабылдаңыз және ол туралы бәрін біліңіз.
Dialogue: 0,0:25:21.79,0:25:23.70,Default,,0,0,0,,Біздің рөл
Dialogue: 0,0:25:24.08,0:25:25.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:25.50,0:25:27.83,Default,,0,0,0,,Иә... Аа...
Dialogue: 0,0:25:28.91,0:25:29.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:30.58,0:25:31.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:31.79,0:25:32.91,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:25:33.29,0:25:34.83,Default,,0,0,0,,Алысқа бармаңыз
Dialogue: 0,0:25:35.66,0:25:36.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:36.91,0:25:37.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:40.25,0:25:42.00,Default,,0,0,0,,Маған демалуға рұқсат ете аласыз ба?
Dialogue: 0,0:25:42.16,0:25:45.50,Default,,0,0,0,,Мен мұнда тыныш ұйықтай алатындай сезінемін.
Dialogue: 0,0:25:47.37,0:25:48.20,Default,,0,0,0,,Иә
Dialogue: 0,0:26:11.62,0:26:12.75,Default,,0,0,0,,Ах
Dialogue: 0,0:26:14.29,0:26:16.79,Default,,0,0,0,,Ағымдағы резервтік қуат 43% қалды
Dialogue: 0,0:26:17.58,0:26:20.04,Default,,0,0,0,,Кеменің кейбір циркуляциялық жүйелерінің дұрыс жұмыс істемеуіне байланысты.
Dialogue: 0,0:26:20.12,0:26:22.79,Default,,0,0,0,,Болжалды прогресспен салыстырғанда энергияны тұтыну өсті
Dialogue: 0,0:26:22.87,0:26:24.79,Default,,0,0,0,,Кеме ішінде де дүрбелең бар (сарбаздардың әбігері).
Dialogue: 0,0:26:24.87,0:26:25.75,Default,,0,0,0,,Билсардо жігіттері
Dialogue: 0,0:26:25.83,0:26:27.45,Default,,0,0,0,,Жоғарғы басшылық не істеп жатыр?
Dialogue: 0,0:26:27.54,0:26:29.66,Default,,0,0,0,,Қараңғылықтан қорқудың қажеті жоқ
Dialogue: 0,0:26:30.66,0:26:33.58,Default,,0,0,0,,Жүрегіңнің нұрымен нұрлан
Dialogue: 0,0:26:33.91,0:26:38.45,Default,,0,0,0,,Имандылық көрсеткен жолды тіпті көзімізді жұмып жүруге болады.
Dialogue: 0,0:26:38.62,0:26:42.95,Default,,0,0,0,,Еш ойланба, қорықпа, тек дұға ет.
Dialogue: 0,0:26:43.58,0:26:46.25,Default,,0,0,0,,Бейбітшілік бар
Dialogue: 0,0:26:49.41,0:26:52.33,Default,,0,0,0,,Формальдылықтың барлығы белгіленген.
Dialogue: 0,0:26:52.41,0:26:54.20,Default,,0,0,0,,Біздің ұлымыз
Dialogue: 0,0:26:54.29,0:26:58.41,Default,,0,0,0,,Жарайды, осы салтты аяқтау ғана қалды.
Dialogue: 0,0:26:59.12,0:27:01.87,Default,,0,0,0,,Жұлдыздардың орналасуы анықталғандай.
Dialogue: 0,0:27:02.33,0:27:05.66,Default,,0,0,0,,Алайда жоспардан тыс жоспарлар көп болды.
Dialogue: 0,0:27:06.16,0:27:10.62,Default,,0,0,0,,Менмендікпен, қажетсіз айналма жол болмады ма?
Dialogue: 0,0:27:11.04,0:27:15.16,Default,,0,0,0,,Жоқ, құрбандық мінсіз болу үшін.
Dialogue: 0,0:27:15.50,0:27:18.25,Default,,0,0,0,,Бізге тағы бір нәрсе істеу керек.
Dialogue: 0,0:27:18.33,0:27:21.54,Default,,0,0,0,,Бір ғана жерді итеру үшін
Dialogue: 0,0:27:21.62,0:27:24.04,Default,,0,0,0,,Неге сонша табандысың?
Dialogue: 0,0:27:24.12,0:27:26.83,Default,,0,0,0,,Ол оған тұрарлық
Dialogue: 0,0:27:27.12,0:27:31.41,Default,,0,0,0,,Менде шынайы даңққа жетелейтін біліктілік жоқ...
Dialogue: 0,0:27:31.62,0:27:34.50,Default,,0,0,0,,Жұмбақ есімді неге жарияладың?
Dialogue: 0,0:27:34.58,0:27:36.91,Default,,0,0,0,,Exif емес бөтен планетаның адамдарына?
Dialogue: 0,0:27:37.45,0:27:40.87,Default,,0,0,0,,Уақыты келгенде, ол да жанын береді.
Dialogue: 0,0:27:41.16,0:27:43.41,Default,,0,0,0,,Оның есімі дәріптелсін
Dialogue: 0,0:27:44.20,0:27:46.37,Default,,0,0,0,,Қалағаныңыздай болыңыз.
Dialogue: 0,0:27:46.83,0:27:51.95,Default,,0,0,0,,Өйткені Галбиториумның басшылығы сізбен бірге.
Dialogue: 0,0:27:52.04,0:27:53.70,Default,,0,0,0,,Құдайды мадақтау
Dialogue: 0,0:27:53.79,0:27:58.00,Default,,0,0,0,,Барлығы құлшылық жолымен жүреді
Dialogue: 0,0:28:01.75,0:28:06.75,Default,,0,0,0,,Ондай жерге тығылма, неге тезірек шықпайсың?
Dialogue: 0,0:28:17.00,0:28:17.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:19.33,0:28:21.12,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:28:21.79,0:28:27.20,Default,,0,0,0,,Мені емделуге шешіндіріп жатқан болатын.
Dialogue: 0,0:28:28.16,0:28:30.41,Default,,0,0,0,,Миана бір рет
Dialogue: 0,0:28:31.25,0:28:36.83,Default,,0,0,0,,Мен герметикалық костюмді босатудың жолын табуым керек еді...
Dialogue: 0,0:28:40.12,0:28:41.45,Default,,0,0,0,,Сен…
Dialogue: 0,0:28:42.62,0:28:43.75,Default,,0,0,0,,Минор?
Dialogue: 0,0:28:44.33,0:28:45.33,Default,,0,0,0,,Иә
Dialogue: 0,0:28:46.62,0:28:47.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:28:48.29,0:28:49.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:52.58,0:28:54.33,Default,,0,0,0,,Бұл сен бе...
Dialogue: 0,0:29:12.25,0:29:13.87,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:29:16.08,0:29:18.62,Default,,0,0,0,,Себебі бұл қорқынышты...
Dialogue: 0,0:29:21.50,0:29:24.54,Default,,0,0,0,,Сіз жеңілгелі тұрсыз
Dialogue: 0,0:29:24.62,0:29:25.79,Default,,0,0,0,,Ха
Dialogue: 0,0:29:26.41,0:29:28.41,Default,,0,0,0,,Жоғалып кететін сияқты
Dialogue: 0,0:29:29.45,0:29:30.58,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:29:32.66,0:29:34.75,Default,,0,0,0,,Сондықтан мен сізге жеңіске рұқсат бердім
Dialogue: 0,0:29:36.25,0:29:38.54,Default,,0,0,0,,Өмірді байланыстыру
Dialogue: 0,0:29:41.04,0:29:42.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:29:43.20,0:29:44.29,Default,,0,0,0,,Жоспар
Dialogue: 0,0:29:45.50,0:29:46.83,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:29:52.25,0:29:54.70,Default,,0,0,0,,Енді шық.
Dialogue: 0,0:29:57.62,0:30:02.45,Default,,0,0,0,,Әңгімемізді басынан-ақ тыңдай алдыңыз, солай ма?
Dialogue: 0,0:30:02.75,0:30:06.37,Default,,0,0,0,,Дауыстарға сүйенбейтін ой сөздері
Dialogue: 0,0:30:07.04,0:30:09.37,Default,,0,0,0,,Сіз мұны қашан түсіндіңіз?
Dialogue: 0,0:30:09.45,0:30:12.29,Default,,0,0,0,,Себебі сен ғана ұзақ уақыт үнсіз қалдың
Dialogue: 0,0:30:12.70,0:30:17.75,Default,,0,0,0,,Ол біздің көз алдымызда үндемей, тіпті сыбырлап үндемеді.
Dialogue: 0,0:30:18.16,0:30:20.95,Default,,0,0,0,,Тек жүрегіңмен сөйлесуге дағдыланбасаң
Dialogue: 0,0:30:21.04,0:30:22.50,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:30:23.04,0:30:26.91,Default,,0,0,0,,Хм, мен оларды азғын нәсіл ретінде тым төмен бағаладым ба?
Dialogue: 0,0:30:27.37,0:30:30.45,Default,,0,0,0,,Ойларды күткеннен де дәлірек қолданады
Dialogue: 0,0:30:30.95,0:30:34.16,Default,,0,0,0,,Неліктен өз өкілеттіктеріңізді құпия ұстайсыз?
Dialogue: 0,0:30:34.66,0:30:37.00,Default,,0,0,0,,Әрине, бұл сенім қарым-қатынасына байланысты.
Dialogue: 0,0:30:37.66,0:30:40.54,Default,,0,0,0,,Телепатиялық қабілеттер басқа нәсілдерге қауіп төндіреді.
Dialogue: 0,0:30:41.12,0:30:42.95,Default,,0,0,0,,Ескерту арқылы ешкім жеңе алмайды.
Dialogue: 0,0:30:43.04,0:30:47.79,Default,,0,0,0,,Сіз сақтықты түсіріп, менің жүрегіме бір жақты қарадыңыз, солай емес пе?
Dialogue: 0,0:30:48.29,0:30:53.37,Default,,0,0,0,,Жер тұрғындары мен Билсардтың ойларын оқудың қажеті жоқ.
Dialogue: 0,0:30:53.83,0:30:57.95,Default,,0,0,0,,Телепаттарды білмейтін нәсілдер жүрек сырына мән бермейді.
Dialogue: 0,0:30:58.87,0:31:04.08,Default,,0,0,0,,Ой мен эмоция дауыста, мимикада, жүріс-тұрысында көрінеді.
Dialogue: 0,0:31:04.50,0:31:08.70,Default,,0,0,0,,Қарау арқылы бәрін көруге болады.
Dialogue: 0,0:31:09.20,0:31:12.45,Default,,0,0,0,,Нақты нені қалайсыз?
Dialogue: 0,0:31:15.04,0:31:17.70,Default,,0,0,0,,Жоғалғандарға нұсқау
Dialogue: 0,0:31:17.95,0:31:19.79,Default,,0,0,0,,Құтқарылу және бата
Dialogue: 0,0:31:19.87,0:31:23.87,Default,,0,0,0,,Сонымен біз нені тойлаймыз? Өзіңізді құтқару үшін не істейсіз?
Dialogue: 0,0:31:24.50,0:31:26.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:31:27.00,0:31:32.70,Default,,0,0,0,,Құпия етіп, бәрін қайда апарасың?
Dialogue: 0,0:31:33.08,0:31:36.58,Default,,0,0,0,,Мен мұны айтып тұрғанда, сен де...
Dialogue: 0,0:31:37.83,0:31:40.62,Default,,0,0,0,,Менің құрбандыққа қатысудан басқа амалым жоқ.
Dialogue: 0,0:31:40.70,0:31:41.83,Default,,0,0,0,,Ха
Dialogue: 0,0:31:43.50,0:31:45.29,Default,,0,0,0,,Уау! Қарғыс атқыр...
Dialogue: 0,0:31:45.37,0:31:48.04,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:31:48.12,0:31:49.16,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:31:50.62,0:31:52.50,Default,,0,0,0,,Еңкейіп, құлшылық ету.
Dialogue: 0,0:31:54.12,0:31:56.08,Default,,0,0,0,,Алтын ұшы
Dialogue: 0,0:31:56.16,0:31:59.25,Default,,0,0,0,,(Миананың үрейлі дауысы)
Dialogue: 0,0:31:59.37,0:32:03.79,Default,,0,0,0,,Мен... Жоооу!
Dialogue: 0,0:32:18.45,0:32:19.37,Default,,0,0,0,,Ха
Dialogue: 0,0:32:20.91,0:32:21.91,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:32:22.45,0:32:24.45,Default,,0,0,0,,Мен сендерді көңіл көтеруге дайындалдым.
Dialogue: 0,0:32:25.29,0:32:27.20,Default,,0,0,0,,Жақында кеш басталады.
Dialogue: 0,0:32:27.75,0:32:28.91,Default,,0,0,0,,Банкет?
Dialogue: 0,0:32:29.00,0:32:34.91,Default,,0,0,0,,Иә, бұл планетадағы барлық тіршілік иелерін шақыратын бата мерекесі.
Dialogue: 0,0:32:35.50,0:32:37.50,Default,,0,0,0,,Сіз құрметті қонақтардың бірісіз.
Dialogue: 0,0:32:39.00,0:32:40.12,Default,,0,0,0,,Мен?
Dialogue: 0,0:32:41.41,0:32:43.54,Default,,0,0,0,,Жүр, іш.
Dialogue: 0,0:32:43.91,0:32:44.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:32:46.08,0:32:46.75,Default,,0,0,0,,О
Dialogue: 0,0:32:48.25,0:32:53.04,Default,,0,0,0,,Бұл планетадан барлық адамдар жойылып кетсе ше?
Dialogue: 0,0:32:53.58,0:32:55.37,Default,,0,0,0,,Годзилла артта қалды
Dialogue: 0,0:32:56.04,0:32:59.12,Default,,0,0,0,,Ол шынымен Годзилла бола ала ма?
Dialogue: 0,0:32:59.45,0:33:01.20,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:33:01.29,0:33:06.04,Default,,0,0,0,,Жоқ, бұл үлкен мақұлықтан артық емес.
Dialogue: 0,0:33:06.33,0:33:08.00,Default,,0,0,0,,Оның күшінен қорық
Dialogue: 0,0:33:08.37,0:33:12.00,Default,,0,0,0,,Өмірі жек көріп, қарғысқа ұшыраған құбыжық.
Dialogue: 0,0:33:13.00,0:33:17.29,Default,,0,0,0,,Сондықтан сіздің қатысуыңыз маңызды.
Dialogue: 0,0:33:18.95,0:33:21.08,Default,,0,0,0,,Годзилла Годзилланы не етеді
Dialogue: 0,0:33:21.66,0:33:22.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:24.12,0:33:26.58,Default,,0,0,0,,Бұл сенің өшпенділігің
Dialogue: 0,0:33:27.00,0:33:27.91,Default,,0,0,0,,Ха
Dialogue: 0,0:33:33.04,0:33:35.83,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:33:37.41,0:33:41.12,Default,,0,0,0,,Ха! Ха... хаа
Dialogue: 0,0:33:41.20,0:33:45.04,Default,,0,0,0,,(Харуоның терең демі және Майнаның ыңырсыған дауысы)
Dialogue: 0,0:33:45.12,0:33:46.37,Default,,0,0,0,,Миана…
Dialogue: 0,0:33:46.45,0:33:47.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:48.66,0:33:50.12,Default,,0,0,0,,Майна ма?
Dialogue: 0,0:33:50.50,0:33:51.54,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:33:52.54,0:33:55.58,Default,,0,0,0,,Әпке, мен бір дауыс естідім...
Dialogue: 0,0:33:55.87,0:33:56.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:58.70,0:34:00.70,Default,,0,0,0,,«Гидора» және…
Dialogue: 0,0:34:01.33,0:34:02.25,Default,,0,0,0,,Ха
Dialogue: 0,0:34:03.12,0:34:04.50,Default,,0,0,0,,Метфис!
Dialogue: 0,0:34:22.00,0:34:23.04,Default,,0,0,0,,Иә
Dialogue: 0,0:34:31.79,0:34:35.54,Default,,0,0,0,,Көріп отырғаныңыздай, қазан бос.
Dialogue: 0,0:34:36.41,0:34:40.54,Default,,0,0,0,,Бірақ ішіндегі сорпа жайдан-жай жоғалып кеткен жоқ.
Dialogue: 0,0:34:41.20,0:34:44.04,Default,,0,0,0,,Етіңіз бен қаныңыз болып, біртұтас болды.
Dialogue: 0,0:34:44.58,0:34:46.79,Default,,0,0,0,,Жою емес, өлім емес
Dialogue: 0,0:34:46.87,0:34:51.29,Default,,0,0,0,,Қазандағы көже деген ойдан бас тартқанымыз ғой.
Dialogue: 0,0:34:51.62,0:34:56.41,Default,,0,0,0,,Үлкен нәрсемен бірігіп, жаңа болмысқа айналу
Dialogue: 0,0:34:56.75,0:35:00.29,Default,,0,0,0,,Арнау деген осы.
Dialogue: 0,0:35:01.16,0:35:03.62,Default,,0,0,0,,Дегенмен, сорпадан өзгешеміз.
Dialogue: 0,0:35:03.95,0:35:08.25,Default,,0,0,0,,Сіз өзіңізді кімге арнайтыныңызды таңдай аласыз.
Dialogue: 0,0:35:08.87,0:35:12.37,Default,,0,0,0,,Бар болғаны... жорамал.
Dialogue: 0,0:35:13.87,0:35:16.62,Default,,0,0,0,,Қайсысы көбірек берілгендік?
Dialogue: 0,0:35:17.04,0:35:19.70,Default,,0,0,0,,Мысалы, полковник Леланд және капитан Сакаки
Dialogue: 0,0:35:19.79,0:35:22.95,Default,,0,0,0,,Адамзат жеңісіне арналған
Dialogue: 0,0:35:23.45,0:35:26.54,Default,,0,0,0,,Бұл жақсы шешім сияқты.
Dialogue: 0,0:35:26.62,0:35:28.58,Default,,0,0,0,,Нәтиже жоқ
Dialogue: 0,0:35:29.12,0:35:31.20,Default,,0,0,0,,Тек адам анықтаған себеп емес
Dialogue: 0,0:35:31.29,0:35:34.62,Default,,0,0,0,,Соңында Годзилланы жеңе алмадық.
Dialogue: 0,0:35:34.70,0:35:38.79,Default,,0,0,0,,Сонымен, жеңіске жетудің дұрыс жолы қандай?
Dialogue: 0,0:35:39.29,0:35:42.33,Default,,0,0,0,,Құдай! Құдай Годзилланы жеңе алады!
Dialogue: 0,0:35:42.41,0:35:47.04,Default,,0,0,0,,Дұрыс, Годзилладан да күшті нәрсе.
Dialogue: 0,0:35:47.29,0:35:49.79,Default,,0,0,0,,Ең жоғары Құдай
Dialogue: 0,0:35:50.41,0:35:53.33,Default,,0,0,0,,Оған берілуден және онымен бір болудан басқа.
Dialogue: 0,0:35:54.08,0:35:56.70,Default,,0,0,0,,Жеңіске жол жоқ.
Dialogue: 0,0:35:57.41,0:36:03.29,Default,,0,0,0,,Құдаймен бірігу – адамның жеке тұлға ретіндегі өмірінен бас тартуы.
Dialogue: 0,0:36:03.54,0:36:07.25,Default,,0,0,0,,Сіз әлі де Құдайды шақырасыз ба?
Dialogue: 0,0:36:07.62,0:36:10.66,Default,,0,0,0,,Сіз өзіңізді құрбандық ретінде ұсынасыз ба?
Dialogue: 0,0:36:11.16,0:36:13.54,Default,,0,0,0,,Дұға етейік! Құдайдың атын шақырайық!
Dialogue: 0,0:36:14.16,0:36:16.20,Default,,0,0,0,,Годзиллаға өлім!
Dialogue: 0,0:36:16.54,0:36:18.37,Default,,0,0,0,,Жеңіс біз үшін!
Dialogue: 0,0:36:18.45,0:36:20.45,Default,,0,0,0,,О!
Dialogue: 0,0:36:20.54,0:36:21.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:36:22.29,0:36:26.41,Default,,0,0,0,,Олай болса, дәл осы жерде және қазір мен сізге құпия атыңызды айтайын.
Dialogue: 0,0:36:39.25,0:36:41.66,Default,,0,0,0,,Кел, алтын патша!
Dialogue: 0,0:36:42.33,0:36:44.20,Default,,0,0,0,,Оның аты Гидора!
Dialogue: 0,0:36:45.04,0:36:47.25,Default,,0,0,0,,Өлім қанаттары!
Dialogue: 0,0:36:47.62,0:36:51.83,Default,,0,0,0,,Кел, Гидора! Өлім қанаттары!
Dialogue: 0,0:36:51.91,0:36:57.16,Default,,0,0,0,,Гидора патша! Келіңіздер! Өлім қанаттары!
Dialogue: 0,0:36:57.33,0:37:02.00,Default,,0,0,0,,Кел, Гидора! Ақыр аяғымыз берекелі болсын!
Dialogue: 0,0:37:02.29,0:37:06.25,Default,,0,0,0,,Ет пен қанмен қоректеніп, түпкілікті жеңіске жет!
Dialogue: 0,0:37:06.33,0:37:09.83,Default,,0,0,0,,Гидора! Бізге жеңіс!
Dialogue: 0,0:37:09.91,0:37:14.62,Default,,0,0,0,,Кел, Гидора! Ет пен қанмен қоректеніп, түпкілікті жеңіске жетіңіз!
Dialogue: 0,0:37:17.20,0:37:19.20,Default,,0,0,0,,О...
Dialogue: 0,0:37:35.70,0:37:36.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:39.20,0:37:40.12,Default,,0,0,0,,Ха
Dialogue: 0,0:37:52.04,0:37:54.58,Default,,0,0,0,,А-а-а...
Dialogue: 0,0:37:54.66,0:37:56.41,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:37:56.50,0:37:57.75,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:37:58.12,0:38:02.50,Default,,0,0,0,,Кел, Гидора! Ақыр аяғымыз берекелі болсын!
Dialogue: 0,0:38:02.58,0:38:06.45,Default,,0,0,0,,Кел, Гидора! Өлім қанаттары!
Dialogue: 0,0:38:07.08,0:38:12.00,Default,,0,0,0,,Гидора патша! Келіңіздер! Өлім қанаттары!
Dialogue: 0,0:38:12.41,0:38:15.87,Default,,0,0,0,,Гидора! Бізге жеңіс!
Dialogue: 0,0:38:24.50,0:38:26.87,Default,,0,0,0,,Бұрмаланған гравитациялық толқындар кеменің жанында анықталды!
Dialogue: 0,0:38:27.37,0:38:29.58,Default,,0,0,0,,Не? Оның Годзилладан айырмашылығы бар ма?
Dialogue: 0,0:38:29.66,0:38:31.58,Default,,0,0,0,,Кеңістік-уақыт қисықтығының бөлінуін растаңыз!
Dialogue: 0,0:38:31.95,0:38:33.87,Default,,0,0,0,,Бұл... және... ерекшелік!
Dialogue: 0,0:38:34.25,0:38:35.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:38:35.16,0:38:38.20,Default,,0,0,0,,Ақымақ! Бұл табиғатта кездесетін ерекшелік пе?
Dialogue: 0,0:38:38.29,0:38:39.75,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:38:39.83,0:38:41.87,Default,,0,0,0,,Мониторда ештеңе өзгермейді!
Dialogue: 0,0:38:41.95,0:38:45.45,Default,,0,0,0,,Сыртқы монитор сигналы 120 секунд бойы айналуда!
Dialogue: 0,0:38:46.12,0:38:47.83,Default,,0,0,0,,Мынадай нәрсе... Түсіндіре алмаймын!
Dialogue: 0,0:38:47.91,0:38:50.12,Default,,0,0,0,,Осы уақытқа дейін әдеттен тыс ештеңе болған жоқ!
Dialogue: 0,0:38:50.20,0:38:52.25,Default,,0,0,0,,Мэйнфрейм ішіндегі гематрияларды есептеу схемасы
Dialogue: 0,0:38:52.33,0:38:54.12,Default,,0,0,0,,Мен бұрын ешқашан көрмеген кодты шығару
Dialogue: 0,0:38:54.75,0:38:55.83,Default,,0,0,0,,Мен оны басқара алмаймын!
Dialogue: 0,0:38:55.91,0:38:58.37,Default,,0,0,0,,Біреу оны бұзуға әрекеттеніп жатыр ма?
Dialogue: 0,0:38:59.41,0:39:05.20,Default,,0,0,0,,Кел, Гидора! Ақыр аяғымыз берекелі болсын!
Dialogue: 0,0:39:09.95,0:39:12.66,Default,,0,0,0,,Қашан... Кел!
Dialogue: 0,0:39:17.75,0:39:19.33,Default,,0,0,0,,Ерекшеліктің гравитациялық өрісі кеңейеді!
Dialogue: 0,0:39:19.41,0:39:21.16,Default,,0,0,0,,Жоқ... Жоқ. Жылжыту керек пе?
Dialogue: 0,0:39:21.25,0:39:21.91,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:39:22.00,0:39:22.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:39:23.04,0:39:25.00,Default,,0,0,0,,Гравитациялық өрістің контурының өзі өзгерді! ?
Dialogue: 0,0:39:25.70,0:39:28.41,Default,,0,0,0,,Ақымақ! Нақтырақ есеп беріңіз!
Dialogue: 0,0:39:29.12,0:39:30.45,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:39:30.54,0:39:33.45,Default,,0,0,0,,Кез келген жағдайда сингулярлықтан да нормадан тыс массасы бар объект
Dialogue: 0,0:39:33.87,0:39:35.62,Default,,0,0,0,,Бұл... бізге жақындап келеді!
Dialogue: 0,0:39:35.70,0:39:37.66,Default,,0,0,0,,Жақсырақ талдау жасай алмайсыз ба?
Dialogue: 0,0:39:37.75,0:39:41.29,Default,,0,0,0,,Кемеден тыс әртүрлі сенсорлар Жылу реакциясы Радиотолқындар Радиация
Dialogue: 0,0:39:41.37,0:39:43.66,Default,,0,0,0,,Алынған деректердің уақыт белгілері сәйкес келмейді!
Dialogue: 0,0:39:43.75,0:39:45.33,Default,,0,0,0,,Талдау бағдарламасы жауап беруден бас тартады
Dialogue: 0,0:39:45.41,0:39:46.75,Default,,0,0,0,,жүйенің 80 пайызы
Dialogue: 0,0:39:46.83,0:39:48.54,Default,,0,0,0,,Орындау уақытындағы қателерді жасау!
Dialogue: 0,0:39:48.62,0:39:50.50,Default,,0,0,0,,Балалар, не істедіңдер!
Dialogue: 0,0:39:50.58,0:39:53.20,Default,,0,0,0,,Дордо! Бұл сенің жұмысың емес пе?
Dialogue: 0,0:39:53.29,0:39:54.54,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:54.87,0:39:56.75,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:39:56.83,0:39:58.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:59.45,0:40:02.66,Default,,0,0,0,,Не болып жатыр! Аномалияның себебі ішкі ма? Сыртта ма?
Dialogue: 0,0:40:02.75,0:40:06.00,Default,,0,0,0,,Жоқ... кеңістік-уақыттың өзі бұрмаланған ба?
Dialogue: 0,0:40:06.62,0:40:08.29,Default,,0,0,0,,Руль жүйесі Навигация жүйесі
Dialogue: 0,0:40:08.37,0:40:11.08,Default,,0,0,0,,Ол аутентификацияланбаған командалар арқылы бірінен соң бірі қайта жазылады!
Dialogue: 0,0:40:11.16,0:40:12.75,Default,,0,0,0,,Кіріс сигналының көзі қандай?
Dialogue: 0,0:40:13.20,0:40:16.08,Default,,0,0,0,,Гематрия есептеу кристалының негізгі фреймінің ішінде!
Dialogue: 0,0:40:17.16,0:40:19.45,Default,,0,0,0,,Бұл... бұзу емес!
Dialogue: 0,0:40:19.62,0:40:20.79,Default,,0,0,0,,Нысаналы координаттар!
Dialogue: 0,0:40:21.16,0:40:22.70,Default,,0,0,0,,Бұл не... ойдан шығарылған сан?
Dialogue: 0,0:40:23.54,0:40:26.79,Default,,0,0,0,,Мына кеме... ол мені қайда апарады?
Dialogue: 0,0:40:27.00,0:40:30.16,Default,,0,0,0,,Аратрумның айналасында мүмкін емес гравитациялық өріс!
Dialogue: 0,0:40:30.25,0:40:33.79,Default,,0,0,0,,Сондықтан аумақты кеңейту! Сіз тыныштық шегіне дейін сүйрейсіз!
Dialogue: 0,0:40:34.25,0:40:37.25,Default,,0,0,0,,Жылдам бұрылу! Трустердің шығысы толық дроссельде!
Dialogue: 0,0:40:37.33,0:40:38.62,Default,,0,0,0,,Мен істеп жатырмын!
Dialogue: 0,0:40:38.83,0:40:41.58,Default,,0,0,0,,Мен тырысып жатырмын, бірақ рульдік командалар жұмыс істемейді!
Dialogue: 0,0:40:41.66,0:40:44.87,Default,,0,0,0,,Қалыпты ауырлық өрісі Біз кемеге жеттік!
Dialogue: 0,0:40:44.95,0:40:49.45,Default,,0,0,0,,Сыртқы қысым корпустың беріктігі шегінен 270%-ға асады!
Dialogue: 0,0:40:49.66,0:40:52.12,Default,,0,0,0,,Арх! Апыр-ай!
Dialogue: 0,0:40:52.58,0:40:55.79,Default,,0,0,0,,Екінші және үшінші тұрғын үйлердің ішкі қабығындағы жарықтар, қысымды түсіру!
Dialogue: 0,0:40:56.25,0:40:58.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:40:59.16,0:41:00.45,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:41:02.20,0:41:04.54,Default,,0,0,0,,Плазмалық қозғалыс құрылғылары туралы не деуге болады? Оны жағу мүмкін емес!
Dialogue: 0,0:41:04.62,0:41:05.70,Default,,0,0,0,,Электр қуаты жеткіліксіз!
Dialogue: 0,0:41:05.79,0:41:06.62,Default,,0,0,0,,Дордо!
Dialogue: 0,0:41:06.70,0:41:08.58,Default,,0,0,0,,Қуатты қалпына келтіріңіз! Асығыңыз!
Dialogue: 0,0:41:09.16,0:41:10.58,Default,,0,0,0,,Мен мұны істеп жатырмын, бірақ мен оны басқара алмаймын!
Dialogue: 0,0:41:11.25,0:41:13.33,Default,,0,0,0,,Не? Өзіңізді мазақ етпеңіз!
Dialogue: 0,0:41:13.87,0:41:17.12,Default,,0,0,0,,Айналу ауытқуының жоғарылауы! Электромагниттік қабық құлап кетеді!
Dialogue: 0,0:41:19.50,0:41:22.50,Default,,0,0,0,,Уууу!
Dialogue: 0,0:41:23.37,0:41:24.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:24.41,0:41:26.83,Default,,0,0,0,,Қуат бөлмесі! Эй Долд! Жауап беріңіз!
Dialogue: 0,0:41:26.91,0:41:29.83,Default,,0,0,0,,Қуат камерасы 40 секунд бұрын сынған!
Dialogue: 0,0:41:29.91,0:41:32.25,Default,,0,0,0,,Сонда бұл хабар бұрын не туралы болды?
Dialogue: 0,0:41:32.33,0:41:33.54,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:41:33.62,0:41:37.25,Default,,0,0,0,,Барлық жіберілген және қабылданған деректер уақытқа сәйкес келмейді!
Dialogue: 0,0:41:38.41,0:41:39.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:40.16,0:41:47.83,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:41:50.62,0:41:53.66,Default,,0,0,0,,Өтірік... Көпірдің өмірлік реакциясы үзілді...
Dialogue: 0,0:41:55.70,0:41:59.25,Default,,0,0,0,,Біз... әлдеқашан өлдік пе?
Dialogue: 0,0:42:03.58,0:42:04.70,Default,,0,0,0,,Неге...
Dialogue: 0,0:42:05.45,0:42:06.70,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:42:06.79,0:42:09.66,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:42:10.16,0:42:13.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:42:29.16,0:42:30.29,Default,,0,0,0,,Хаа…
Dialogue: 0,0:42:30.79,0:42:31.91,Default,,0,0,0,,Аратрум!
Dialogue: 0,0:42:32.00,0:42:34.45,Default,,0,0,0,,Аратрум жауап бер! Не болды!
Dialogue: 0,0:42:34.54,0:42:38.41,Default,,0,0,0,,Дәрігер, біз Аратрумнан ешқандай сигналды анықтай алмаймыз.
Dialogue: 0,0:42:38.50,0:42:42.91,Default,,0,0,0,,Ал гравитациялық өрістегі бұл бұзылыс... Годзилла бізге шабуыл жасаған болуы мүмкін!?
Dialogue: 0,0:42:43.00,0:42:46.04,Default,,0,0,0,,Жоқ, біз жерден ешқандай шабуылды анықтаған жоқпыз.
Dialogue: 0,0:43:03.41,0:43:05.12,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:43:06.29,0:43:07.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:43:08.37,0:43:11.12,Default,,0,0,0,,Барлығы... сонда барыңдар.
Dialogue: 0,0:43:11.20,0:43:12.12,Default,,0,0,0,,Ха
Dialogue: 0,0:43:12.37,0:43:13.79,Default,,0,0,0,,Бақылау мұнарасы?
Dialogue: 0,0:43:15.58,0:43:16.58,Default,,0,0,0,,Кеттік! Ах!
Dialogue: 0,0:43:20.95,0:43:22.08,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,0:43:23.33,0:43:24.95,Default,,0,0,0,,Маған рұқсат етіңіз! Кешіріңіз
Dialogue: 0,0:43:26.33,0:43:27.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:30.79,0:43:32.54,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:43:32.91,0:43:35.16,Default,,0,0,0,,Жер бетінде не болады?
Dialogue: 0,0:43:35.25,0:43:36.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:47.25,0:43:48.70,Default,,0,0,0,,Бұл таңғажайып гравитациялық өріс.
Dialogue: 0,0:43:49.08,0:43:51.45,Default,,0,0,0,,Сіз осындасыз ба, доктор Мартин?
Dialogue: 0,0:43:51.54,0:43:52.37,Default,,0,0,0,,Капитан Сакаки!
Dialogue: 0,0:43:52.45,0:43:53.83,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:43:54.08,0:43:55.08,Default,,0,0,0,,Харуо!
Dialogue: 0,0:43:56.25,0:43:58.41,Default,,0,0,0,,Мен оны сол жерден естіп тұрмын.
Dialogue: 0,0:43:59.00,0:44:00.45,Default,,0,0,0,,«Гидора»
Dialogue: 0,0:44:03.00,0:44:03.95,Default,,0,0,0,,Ха
Dialogue: 0,0:44:05.58,0:44:06.95,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:44:08.58,0:44:12.12,Default,,0,0,0,,Ах! Сол төбенің жанында әлсіз биологиялық реакция бар!
Dialogue: 0,0:44:12.20,0:44:13.20,Default,,0,0,0,,Не!
Dialogue: 0,0:44:14.33,0:44:17.37,Default,,0,0,0,,Мен келемін, сен осындасың.
Dialogue: 0,0:44:17.45,0:44:18.29,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:44:18.37,0:44:19.87,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Түсіндіріңіз!
Dialogue: 0,0:44:20.29,0:44:21.70,Default,,0,0,0,,Метфис бірдеңе жоспарлап отыр
Dialogue: 0,0:44:22.12,0:44:25.20,Default,,0,0,0,,Жоспарлау? Бұл жағдайда не істеу керек ...
Dialogue: 0,0:44:26.12,0:44:27.95,Default,,0,0,0,,Жоқ... мұның өзі?
Dialogue: 0,0:44:28.45,0:44:29.70,Default,,0,0,0,,растайды
Dialogue: 0,0:44:30.83,0:44:33.20,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:44:55.70,0:44:58.87,Default,,0,0,0,,(Харуоның қатты тыныс алуы)
Dialogue: 0,0:44:59.25,0:45:01.00,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:45:03.83,0:45:04.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:45:07.16,0:45:08.50,Default,,0,0,0,,Дәрігер! (Мартин) Иә?
Dialogue: 0,0:45:08.58,0:45:09.83,Default,,0,0,0,,Годзилланың діріл толқындарын анықтау!
Dialogue: 0,0:45:09.91,0:45:11.04,Default,,0,0,0,,Не?
Dialogue: 0,0:45:11.45,0:45:14.16,Default,,0,0,0,,Фудзи тауының етегінен шығып, осы жаққа бет алды!
Dialogue: 0,0:45:14.66,0:45:16.83,Default,,0,0,0,,Осындай кезде тіпті Годзилла...
Dialogue: 0,0:45:21.79,0:45:23.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:45:32.54,0:45:36.12,Default,,0,0,0,,Қалыпты емес гравитация өрістерінен туындаған жоғары ағындар кумулонимбус бұлттарын тудырады.
Dialogue: 0,0:45:36.95,0:45:39.33,Default,,0,0,0,,Мұндай құбылысты Жерде байқауға болмайды!
Dialogue: 0,0:45:39.41,0:45:41.08,Default,,0,0,0,,Жер бетіндегі себебі неде?
Dialogue: 0,0:45:41.75,0:45:44.25,Default,,0,0,0,,Оның Аратрумның байланысының бұзылуына қатысы бар ма?
Dialogue: 0,0:45:44.70,0:45:47.29,Default,,0,0,0,,Күшті нөсер күтілуде
Dialogue: 0,0:45:47.41,0:45:49.95,Default,,0,0,0,,Мұндай жерде болу қауіпті емес пе?
Dialogue: 0,0:45:50.33,0:45:53.33,Default,,0,0,0,,Годзилла да келе жатыр, оны жалғыз қалдыра аламыз ба?
Dialogue: 0,0:45:53.91,0:45:57.75,Default,,0,0,0,,Қараңдар! Бұлттарда бірдеңе бар...
Dialogue: 0,0:45:58.70,0:45:59.91,Default,,0,0,0,,Газ фронты?
Dialogue: 0,0:46:00.37,0:46:02.08,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:46:03.62,0:46:05.87,Default,,0,0,0,,А, тағы біреуі бар!
Dialogue: 0,0:46:06.83,0:46:08.62,Default,,0,0,0,,Ах! Онда да!
Dialogue: 0,0:46:08.91,0:46:12.12,Default,,0,0,0,,Жердегі бұл жарықшақ не...?
Dialogue: 0,0:46:12.20,0:46:15.54,Default,,0,0,0,,(Харуоның ауыр тыныс алуы)
Dialogue: 0,0:46:15.62,0:46:17.00,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:46:17.08,0:46:18.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:22.33,0:46:23.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:27.04,0:46:28.12,Default,,0,0,0,,Ха
Dialogue: 0,0:46:32.75,0:46:34.12,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:46:35.54,0:46:36.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:36.79,0:46:37.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:43.62,0:46:45.37,Default,,0,0,0,,Бұл жолы не болып жатыр...
Dialogue: 0,0:46:50.37,0:46:52.37,Default,,0,0,0,,(айқай)
Dialogue: 0,0:46:52.45,0:46:54.29,Default,,0,0,0,,Бұл да құбыжық па?
Dialogue: 0,0:46:54.37,0:46:57.91,Default,,0,0,0,,Ақымақ! Егер ол соншалықты үлкен болса, сенсор неге жауап бермейді?
Dialogue: 0,0:46:58.00,0:47:00.91,Default,,0,0,0,,Инфрақызыл сәулелер мен электромагниттік толқындардың барлығы жауап бермейді!
Dialogue: 0,0:47:01.00,0:47:04.20,Default,,0,0,0,,Сіз гравитациялық толқындарды көбейтуден басқа сандарды ала алмайсыз!
Dialogue: 0,0:47:04.29,0:47:06.25,Default,,0,0,0,,Мұнда тек Годзилла бар!
Dialogue: 0,0:47:06.33,0:47:07.62,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:47:07.70,0:47:09.75,Default,,0,0,0,,Сіз оны шынымен көре аласыз!
Dialogue: 0,0:47:09.95,0:47:10.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:47:11.50,0:47:13.95,Default,,0,0,0,,Жоқ! Ол дұрыс жұмыс істемеді ме?
Dialogue: 0,0:47:14.29,0:47:16.50,Default,,0,0,0,,Бұл да біртүрлі! (Мартин) Не?
Dialogue: 0,0:47:16.58,0:47:18.58,Default,,0,0,0,,Қанша талпынсам да шықпайды!
Dialogue: 0,0:47:18.91,0:47:22.62,Default,,0,0,0,,Сенсордың сезімтал аймағын кеңейтсеңіз де, реакция болмайды!
Dialogue: 0,0:47:22.91,0:47:25.70,Default,,0,0,0,,Ха... не болып жатыр?
Dialogue: 0,0:47:26.25,0:47:29.45,Default,,0,0,0,,(Харуоның ауыр тыныс алуы)
Dialogue: 0,0:47:29.58,0:47:30.50,Default,,0,0,0,,Ха
Dialogue: 0,0:47:33.70,0:47:35.70,Default,,0,0,0,,Мұндай жігіт шабуыл жасағанда…
Dialogue: 0,0:47:37.33,0:47:38.66,Default,,0,0,0,,Тіпті Годзилла!
Dialogue: 0,0:47:41.20,0:47:46.20,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:47:47.95,0:47:49.70,Default,,0,0,0,,(айқай)
Dialogue: 0,0:47:49.79,0:47:51.45,Default,,0,0,0,,Сіз не жоспарлап отырсыз...
Dialogue: 0,0:47:51.95,0:47:53.75,Default,,0,0,0,,Метфис!
Dialogue: 0,0:47:54.33,0:47:56.87,Default,,0,0,0,,Годзилланың ішкі электромагниттік толқындары тез өсуде!
Dialogue: 0,0:47:56.95,0:48:00.00,Default,,0,0,0,,Не!? Сіз шынымен онымен ұрысуды жоспарлап отырсыз ба?
Dialogue: 0,0:48:09.25,0:48:10.25,Default,,0,0,0,,Ал... қисық?
Dialogue: 0,0:48:14.45,0:48:17.20,Default,,0,0,0,,Годзилланың ішкі электромагниттік толқындары қайтадан көтеріледі!
Dialogue: 0,0:48:23.79,0:48:25.70,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,0:48:32.16,0:48:34.50,Default,,0,0,0,,Гравитациялық толқындар жылу сәулелерін бұзды ма?
Dialogue: 0,0:48:34.58,0:48:35.70,Default,,0,0,0,,Жоқ...бұл өте ақылға сыйымсыз!
Dialogue: 0,0:48:36.33,0:48:37.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:48:37.54,0:48:39.50,Default,,0,0,0,,Кеңістіктің өзі қисық!
Dialogue: 0,0:48:39.58,0:48:42.91,Default,,0,0,0,,Ағымдағы жылу сәулесі Бұл жазбаға сәйкес, ол тікелей өтті!
Dialogue: 0,0:48:43.75,0:48:46.33,Default,,0,0,0,,Ешқандай кедергінің белгісі жоқ!
Dialogue: 0,0:48:47.25,0:48:49.91,Default,,0,0,0,,Машина ол құбыжықты мүлдем көре алмайды.
Dialogue: 0,0:48:50.00,0:48:53.50,Default,,0,0,0,,Оны көзіміз бен құлағымыз ғана таниды!
Dialogue: 0,0:48:53.62,0:48:55.66,Default,,0,0,0,,Сіз бұл иллюзия дейсіз бе?
Dialogue: 0,0:49:03.37,0:49:04.45,Default,,0,0,0,,(айқай)
Dialogue: 0,0:49:05.66,0:49:11.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:49:23.62,0:49:26.66,Default,,0,0,0,,Өтіп бара жатырмын... Ақыры зат жоқ!?
Dialogue: 0,0:49:26.75,0:49:28.50,Default,,0,0,0,,Годзилла шағып алды!
Dialogue: 0,0:49:28.87,0:49:30.37,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:49:30.45,0:49:33.70,Default,,0,0,0,,Бір жаққа ғана тию қайшылық емес пе?
Dialogue: 0,0:49:34.04,0:49:35.95,Default,,0,0,0,,Ең алдымен асимметриялық қалқанға не болды?
Dialogue: 0,0:49:36.87,0:49:39.16,Default,,0,0,0,,Тіпті ядролық оқтұмсықтар да Годзиллаға қарсы жұмыс істей алмады...
Dialogue: 0,0:49:39.25,0:49:41.62,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:49:42.50,0:49:45.00,Default,,0,0,0,,Годзилланың ішкі электромагниттік толқындары тез төмендейді!
Dialogue: 0,0:49:45.45,0:49:47.62,Default,,0,0,0,,Жаңа ғана тістеп алды. Неліктен?
Dialogue: 0,0:49:47.87,0:49:50.87,Default,,0,0,0,,Годзилланың дене бетінде міндетті түрде қалқан бар.
Dialogue: 0,0:49:50.95,0:49:53.33,Default,,0,0,0,,Бірақ толқын пішінінде мүлде өзгеріс жоқ
Dialogue: 0,0:49:53.41,0:49:55.54,Default,,0,0,0,,Ешқандай шабуылдың белгісі жоқ!
Dialogue: 0,0:49:55.62,0:49:56.66,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:49:57.20,0:50:00.04,Default,,0,0,0,,Жаман түс көретін біз ғана ма?
Dialogue: 0,0:50:00.58,0:50:03.12,Default,,0,0,0,,Гравитациялық өрістің бұзылуы кеңейеді!
Dialogue: 0,0:50:03.33,0:50:04.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:12.45,0:50:14.87,Default,,0,0,0,,Жоқ! ? Саны үшке дейін өсті!
Dialogue: 0,0:50:14.95,0:50:16.75,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:50:16.83,0:50:19.41,Default,,0,0,0,,Сенсорға реакция жоқ па?
Dialogue: 0,0:50:30.16,0:50:31.62,Default,,0,0,0,,(айқай)
Dialogue: 0,0:50:32.75,0:50:33.58,Default,,0,0,0,,(айқай)
Dialogue: 0,0:50:33.91,0:50:36.75,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:50:36.83,0:50:38.54,Default,,0,0,0,,Әлі де жақсы емес
Dialogue: 0,0:50:38.62,0:50:41.83,Default,,0,0,0,,Аномальды гравитациялық өрістің ауданы жай ғана кеңеюде.
Dialogue: 0,0:50:41.91,0:50:43.54,Default,,0,0,0,,Басқа реакция жоқ!
Dialogue: 0,0:50:43.91,0:50:47.00,Default,,0,0,0,,Сонымен... бұл не?
Dialogue: 0,0:50:47.70,0:50:48.79,Default,,0,0,0,,Гидора
Dialogue: 0,0:50:49.41,0:50:50.54,Default,,0,0,0,,Гидора?
Dialogue: 0,0:50:50.62,0:50:51.62,Default,,0,0,0,,Иә
Dialogue: 0,0:50:53.79,0:50:56.29,Default,,0,0,0,,Барлығын жеу
Dialogue: 0,0:50:57.16,0:50:58.87,Default,,0,0,0,,Бұл дүниеден тыс
Dialogue: 0,0:50:59.58,0:51:01.79,Default,,0,0,0,,Бостың патшасы
Dialogue: 0,0:51:01.87,0:51:04.29,Default,,0,0,0,,(Харуоның ауыр тыныс алуы)
Dialogue: 0,0:51:04.79,0:51:05.91,Default,,0,0,0,,Метфис!
Dialogue: 0,0:51:06.00,0:51:07.66,Default,,0,0,0,,Сен мұнда не істеп жүрсің!
Dialogue: 0,0:51:08.29,0:51:09.29,Default,,0,0,0,,Ха
Dialogue: 0,0:51:09.83,0:51:10.83,Default,,0,0,0,,Миана!
Dialogue: 0,0:51:13.58,0:51:14.70,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:51:15.20,0:51:16.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:51:16.54,0:51:18.37,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:51:18.83,0:51:21.25,Default,,0,0,0,,Мұның бәрі сіздің әрекетіңіз бе?
Dialogue: 0,0:51:22.25,0:51:25.58,Default,,0,0,0,,Мәңгілік жалғасатын миссиям
Dialogue: 0,0:51:26.00,0:51:28.25,Default,,0,0,0,,Енді орындалады
Dialogue: 0,0:51:28.58,0:51:30.12,Default,,0,0,0,,Миссия?
Dialogue: 0,0:51:31.33,0:51:33.54,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:51:33.62,0:51:37.87,Default,,0,0,0,,Сізбен кездесу және бос жерде ұзақ сапар
Dialogue: 0,0:51:37.95,0:51:41.45,Default,,0,0,0,,Барлығы осы егін жинау күніне арналған
Dialogue: 0,0:51:42.91,0:51:45.20,Default,,0,0,0,,Жұлдыз деп аталатын тұқымнан тіршілік өнеді
Dialogue: 0,0:51:45.29,0:51:48.04,Default,,0,0,0,,Халық деген гүл өркениетті өркендетеді
Dialogue: 0,0:51:48.12,0:51:50.87,Default,,0,0,0,,Соңында өсетін жеміс – Годзилла
Dialogue: 0,0:51:51.50,0:51:54.37,Default,,0,0,0,,Біз, Exif, көп жұлдызбыз.
Dialogue: 0,0:51:54.45,0:51:56.91,Default,,0,0,0,,Мен циклдің куәсі болдым.
Dialogue: 0,0:51:58.54,0:52:02.00,Default,,0,0,0,,Ең соңында жемісті жұлып жейтін адам.
Dialogue: 0,0:52:02.08,0:52:04.20,Default,,0,0,0,,Бұл біздің Құдайымыз
Dialogue: 0,0:52:04.95,0:52:06.83,Default,,0,0,0,,Гидора патша
Dialogue: 0,0:52:07.08,0:52:08.95,Default,,0,0,0,,Алтын соң
Dialogue: 0,0:52:10.12,0:52:12.62,Default,,0,0,0,,Бүкіл ғалам
Dialogue: 0,0:52:12.70,0:52:16.16,Default,,0,0,0,,Ол тек Оған құрбандық ретінде бар.
Dialogue: 0,0:52:16.25,0:52:17.83,Default,,0,0,0,,мәні бар
Dialogue: 0,0:52:18.16,0:52:19.16,Default,,0,0,0,,Құт
Dialogue: 0,0:52:19.41,0:52:20.66,Default,,0,0,0,,Гидора – бұл...
Dialogue: 0,0:52:21.12,0:52:23.95,Default,,0,0,0,,Бұл сіздің планетаңызды жойған құбыжық емес пе?
Dialogue: 0,0:52:24.04,0:52:28.95,Default,,0,0,0,,Бір кездері біздің Exif өркениетіміз түпкілікті шындықты іздеді.
Dialogue: 0,0:52:29.33,0:52:33.58,Default,,0,0,0,,Өзіне құрбандық шалып, Құдаймен байланысын аяқтады.
Dialogue: 0,0:52:33.79,0:52:34.95,Default,,0,0,0,,Ұсыну?
Dialogue: 0,0:52:35.87,0:52:39.87,Default,,0,0,0,,Және бұл батаны бүкіл әлемге тарату
Dialogue: 0,0:52:39.95,0:52:42.87,Default,,0,0,0,,Бізде бір уыс діни қызметкер қалды.
Dialogue: 0,0:52:44.25,0:52:47.58,Default,,0,0,0,,Жойылған нәрсе... бата болды ма?
Dialogue: 0,0:52:47.66,0:52:50.41,Default,,0,0,0,,Иә! Қарғыс атсын!
Dialogue: 0,0:52:50.50,0:52:52.04,Default,,0,0,0,,Годзилла ғана емес
Dialogue: 0,0:52:52.12,0:52:54.95,Default,,0,0,0,,Біз және бұл планета
Dialogue: 0,0:52:55.04,0:52:58.66,Default,,0,0,0,,Сіз бәрін жоймақшысыз ба? Гидораның күшімен!
Dialogue: 0,0:52:59.04,0:53:02.70,Default,,0,0,0,,Ақыр аяғын мадақта, бұдан асқан нығмет жоқ.
Dialogue: 0,0:53:03.62,0:53:04.62,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:53:09.79,0:53:11.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:14.12,0:53:16.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:53:16.58,0:53:19.79,Default,,0,0,0,,Бас тартпау керек, тартынбау керек
Dialogue: 0,0:53:20.83,0:53:22.79,Default,,0,0,0,,Тек тағдырға мойынсұн
Dialogue: 0,0:53:22.87,0:53:24.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:29.33,0:53:30.66,Default,,0,0,0,,Харуо
Dialogue: 0,0:53:31.37,0:53:33.79,Default,,0,0,0,,Сен де, жүрегіңнің түбінде
Dialogue: 0,0:53:34.54,0:53:37.33,Default,,0,0,0,,Мен бұған үміттенуім керек еді.
Dialogue: 0,0:53:37.66,0:53:39.66,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:53:40.37,0:53:43.70,Default,,0,0,0,,Әзіл...
Dialogue: 0,0:53:47.33,0:53:53.79,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:54:02.29,0:54:04.45,Default,,0,0,0,,Ішкі электромагниттік толқындар одан әрі төмендейді
Dialogue: 0,0:54:04.54,0:54:06.91,Default,,0,0,0,,Годзилла міндетті түрде зақымдалған.
Dialogue: 0,0:54:07.00,0:54:09.91,Default,,0,0,0,,Годзилланың асимметриялық қалқаны міндетті түрде белсендірілген.
Dialogue: 0,0:54:10.00,0:54:12.16,Default,,0,0,0,,Шабуылдарға мүлде тосқауыл қоя алмайсыз ба?
Dialogue: 0,0:54:12.45,0:54:14.37,Default,,0,0,0,,Жаңа ғана шағып жатыр ма?
Dialogue: 0,0:54:15.12,0:54:19.00,Default,,0,0,0,,Біз көп қиындық көрген толық қорғаныс оңай орындалды...
Dialogue: 0,0:54:19.62,0:54:25.62,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:54:41.66,0:54:42.79,Default,,0,0,0,,Неге...
Dialogue: 0,0:54:43.20,0:54:46.00,Default,,0,0,0,,Қирау – береке...
Dialogue: 0,0:54:46.87,0:54:48.50,Default,,0,0,0,,Өркендеу шыңына жету
Dialogue: 0,0:54:48.70,0:54:52.83,Default,,0,0,0,,Біздің ата-бабаларымыз тіпті болашақты көре алатын ғылымды меңгерген.
Dialogue: 0,0:54:53.41,0:54:58.04,Default,,0,0,0,,Мәңгілік шындықты уақыттан тыс іздедім.
Dialogue: 0,0:54:58.66,0:55:03.16,Default,,0,0,0,,Бұл Exif тарихындағы ең асқақ кезең.
Dialogue: 0,0:55:04.20,0:55:08.33,Default,,0,0,0,,Ал ақырғы уақыттағы болашақты есептеңіз
Dialogue: 0,0:55:08.58,0:55:10.83,Default,,0,0,0,,Мен қорытындыға келдім
Dialogue: 0,0:55:11.79,0:55:14.75,Default,,0,0,0,,«Мәңгілік деген нәрсе жоқ»
Dialogue: 0,0:55:15.58,0:55:17.37,Default,,0,0,0,,Әлем шекті
Dialogue: 0,0:55:17.45,0:55:20.58,Default,,0,0,0,,Барлығы жойылып, жойылады
Dialogue: 0,0:55:21.37,0:55:22.95,Default,,0,0,0,,Содан кейін біз
Dialogue: 0,0:55:23.45,0:55:25.79,Default,,0,0,0,,Жоюдан тыс
Dialogue: 0,0:55:26.20,0:55:29.16,Default,,0,0,0,,Тек тыныштық пен даңқты табу үшін
Dialogue: 0,0:55:30.87,0:55:32.08,Default,,0,0,0,,Мен...
Dialogue: 0,0:55:32.33,0:55:34.25,Default,,0,0,0,,Мұндай сандырақ...
Dialogue: 0,0:55:35.16,0:55:36.50,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:55:36.79,0:55:39.08,Default,,0,0,0,,Бұл алдау, Харуо.
Dialogue: 0,0:55:39.62,0:55:41.87,Default,,0,0,0,,Өмір - қорқыныштар тізбегі
Dialogue: 0,0:55:42.04,0:55:44.87,Default,,0,0,0,,Құтқарылу және мәңгілік демалыс
Dialogue: 0,0:55:44.95,0:55:47.79,Default,,0,0,0,,Бұл барлық ақыл-ойдың көптен күткен тілегі.
Dialogue: 0,0:55:48.04,0:55:50.58,Default,,0,0,0,,А... жоқ!
Dialogue: 0,0:55:50.79,0:55:53.62,Default,,0,0,0,,Жүрегіңді тыңда
Dialogue: 0,0:55:53.87,0:55:55.29,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:55:56.08,0:55:59.75,Default,,0,0,0,,Өзінің шынайы қалауы мен
Dialogue: 0,0:56:09.87,0:56:12.04,Default,,0,0,0,,(датчикті анықтау дыбысы)
Dialogue: 0,0:56:12.12,0:56:14.45,Default,,0,0,0,,Годзилланың дене қызуы тез көтеріледі!
Dialogue: 0,0:56:14.91,0:56:17.87,Default,,0,0,0,,Сіз Мехагодзилла қаласын өртеп жібердіңіз. Сіз мұны істеуге ынталандырасыз ба?
Dialogue: 0,0:56:27.66,0:56:29.87,Default,,0,0,0,,Годзилланың дене бетінің температурасы одан әрі жоғарылайды!
Dialogue: 0,0:56:30.29,0:56:32.54,Default,,0,0,0,,Осы жоғары қызбамен, басқа адамды ұстай алмасаңыз да
Dialogue: 0,0:56:32.62,0:56:34.33,Default,,0,0,0,,Сіз шабуыл жасай аласыз!
Dialogue: 0,0:56:46.29,0:56:48.66,Default,,0,0,0,,Тіпті ең көне естеліктер
Dialogue: 0,0:56:49.41,0:56:52.08,Default,,0,0,0,,Сен қорқыныш пен үмітсіздіктің тұтқыны болдың.
Dialogue: 0,0:56:52.16,0:56:53.54,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:56:56.08,0:56:57.45,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:56:58.04,0:56:58.70,Default,,0,0,0,,Ах...!
Dialogue: 0,0:56:58.79,0:57:00.70,Default,,0,0,0,,Сен сол кезде дұға еткен болуың керек.
Dialogue: 0,0:57:01.66,0:57:03.37,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:57:03.83,0:57:05.91,Default,,0,0,0,,Мен бәрінің біткенін қалаймын
Dialogue: 0,0:57:06.00,0:57:06.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:07.33,0:57:08.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:57:10.83,0:57:11.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:57:14.50,0:57:15.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:57:15.45,0:57:16.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:57:19.45,0:57:22.12,Default,,0,0,0,,Сіздің өміріңізді не өсірді
Dialogue: 0,0:57:22.62,0:57:25.70,Default,,0,0,0,,Бұл ашу және қорлау
Dialogue: 0,0:57:26.58,0:57:29.79,Default,,0,0,0,,Және қашып құтылусыз қамау сезімі
Dialogue: 0,0:57:30.79,0:57:34.54,Default,,0,0,0,,Сондықтан мен оны әрқашан асыға күткен болуым керек.
Dialogue: 0,0:57:35.37,0:57:38.37,Default,,0,0,0,,Бір күні бәрінен
Dialogue: 0,0:57:38.87,0:57:40.79,Default,,0,0,0,,Шығарылады
Dialogue: 0,0:57:45.20,0:57:48.95,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:57:59.04,0:58:02.87,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:58:03.04,0:58:04.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:58:04.41,0:58:06.79,Default,,0,0,0,,Годзилланың айналасындағы температура төмендеп жатыр!
Dialogue: 0,0:58:06.87,0:58:10.58,Default,,0,0,0,,Молекулярлық тербеліс жалғасқанымен, жылу жұтылып жатыр ма?
Dialogue: 0,0:58:10.91,0:58:13.04,Default,,0,0,0,,Жоқ, олай емес!
Dialogue: 0,0:58:13.12,0:58:15.83,Default,,0,0,0,,Қызуым көтерілсе де, ыстық тұманды көрмеймін.
Dialogue: 0,0:58:15.91,0:58:17.75,Default,,0,0,0,,Егер ол салқындатылса, су буы ше?
Dialogue: 0,0:58:17.83,0:58:20.08,Default,,0,0,0,,Ештеңе жоқ дегеніңіз не!?
Dialogue: 0,0:58:20.16,0:58:23.20,Default,,0,0,0,,Бірақ Годзилланың қызуы көтеріле беретіні сөзсіз!
Dialogue: 0,0:58:23.29,0:58:24.37,Default,,0,0,0,,Сонда безгегі туралы не деуге болады?
Dialogue: 0,0:58:24.79,0:58:28.00,Default,,0,0,0,,Жай ғана алып кетіп, жоқ болып бара жатыр... жердің қай жерінде?
Dialogue: 0,0:58:29.00,0:58:32.12,Default,,0,0,0,,Молекулярлық тербелістің мөлшері іс жүзінде артып келеді.
Dialogue: 0,0:58:32.20,0:58:35.54,Default,,0,0,0,,Годзилла айналасындағы күту режиміндегі температура одан әрі төмендейді.
Dialogue: 0,0:58:35.62,0:58:36.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:36.87,0:58:39.58,Default,,0,0,0,,Дене бетінің температурасы да тез төмендейді!
Dialogue: 0,0:58:39.91,0:58:44.16,Default,,0,0,0,,Годзилланың дене температурасы кейбір жерлерде Фаренгейттен 32 градустан төмен түсіп кеткен!
Dialogue: 0,0:58:44.25,0:58:46.04,Default,,0,0,0,,Ол әлі де салқындатуды тоқтатпайды!
Dialogue: 0,0:58:46.12,0:58:47.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:48.04,0:58:49.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:58:49.66,0:58:51.33,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:58:51.70,0:58:53.29,Default,,0,0,0,,Басқа ғаламнан?
Dialogue: 0,0:58:54.54,0:58:57.91,Default,,0,0,0,,Бұл дүниенің заңдары мүлдем қолданылмайды.
Dialogue: 0,0:58:58.50,0:59:02.50,Default,,0,0,0,,Физикалық жүйенің өзі басқа өлшемнің шабуылы ма?
Dialogue: 0,0:59:03.04,0:59:06.37,Default,,0,0,0,,Олай болса... ол Годзилланы жеңе ала ма?
Dialogue: 0,0:59:06.79,0:59:08.45,Default,,0,0,0,,Мен қалжыңдамаймын!
Dialogue: 0,0:59:08.66,0:59:10.25,Default,,0,0,0,,Бұл тіпті Годзилла сияқты қауіп емес.
Dialogue: 0,0:59:10.33,0:59:11.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:11.25,0:59:14.33,Default,,0,0,0,,Жердің өзі жұтылады!
Dialogue: 0,0:59:14.41,0:59:21.41,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:59:24.04,0:59:25.08,Default,,0,0,0,,Харуо
Dialogue: 0,0:59:25.41,0:59:27.75,Default,,0,0,0,,Есте сақтау керек
Dialogue: 0,0:59:28.12,0:59:31.95,Default,,0,0,0,,Өз міндетін ерлікпен орындағандарға.
Dialogue: 0,0:59:32.29,0:59:33.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:33.54,0:59:36.33,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:59:36.95,0:59:39.20,Default,,0,0,0,,(Сарбаздардың әлсіз дауыстары)
Dialogue: 0,0:59:40.16,0:59:41.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:46.50,0:59:48.45,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:59:49.45,0:59:51.75,Default,,0,0,0,,Ха... Леланд!
Dialogue: 0,0:59:52.58,0:59:55.29,Default,,0,0,0,,Жанымды құрбан еткенше күрестім.
Dialogue: 0,0:59:56.50,0:59:58.29,Default,,0,0,0,,Неліктен жауды өлтірмейсің?
Dialogue: 0,0:59:59.20,1:00:02.04,Default,,0,0,0,,Неге өміріңді құрбан етпейсің?
Dialogue: 0,1:00:02.62,1:00:03.45,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,1:00:04.37,1:00:06.75,Default,,0,0,0,,Гидора оны жеңе алады.
Dialogue: 0,1:00:07.37,1:00:08.45,Default,,0,0,0,,Ха... Юко...
Dialogue: 0,1:00:09.08,1:00:12.04,Default,,0,0,0,,Бұл сіздің аман қалғыңыз келетінін білдіре ме?
Dialogue: 0,1:00:13.45,1:00:15.70,Default,,0,0,0,,Сол әйелдермен бе?
Dialogue: 0,1:00:16.16,1:00:17.33,Default,,0,0,0,,Өйткені ол
Dialogue: 0,1:00:18.16,1:00:20.45,Default,,0,0,0,,Осылай қарап тұрғанда...
Dialogue: 0,1:00:20.54,1:00:21.95,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,1:00:22.45,1:00:25.91,Default,,0,0,0,,Годзиллаға қарсы күресте көптеген адамдар өмірін қиды.
Dialogue: 0,1:00:26.70,1:00:30.29,Default,,0,0,0,,Сіз бұл ұрпақтың соңғысысыз, Харуо.
Dialogue: 0,1:00:31.50,1:00:33.66,Default,,0,0,0,,Олардың дауыстарына жауап беру
Dialogue: 0,1:00:34.08,1:00:36.70,Default,,0,0,0,,Істі реттейтін уақыт келді.
Dialogue: 0,1:00:36.79,1:00:38.12,Default,,0,0,0,,…қашып кету…
Dialogue: 0,1:00:38.91,1:00:42.66,Default,,0,0,0,,Адамзаттың аман қалуы үшін біз Годзилламен бетпе-бет келдік!
Dialogue: 0,1:00:43.58,1:00:45.58,Default,,0,0,0,,Оны жеңу
Dialogue: 0,1:00:46.00,1:00:49.37,Default,,0,0,0,,Мен бұл планетаны өзіммен бірге алғым келмеді!
Dialogue: 0,1:00:50.87,1:00:51.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:53.37,1:00:54.20,Default,,0,0,0,,Фу…
Dialogue: 0,1:01:13.58,1:01:14.50,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,1:01:15.12,1:01:16.75,Default,,0,0,0,,Бар... Годзилла
Dialogue: 0,1:01:17.16,1:01:18.29,Default,,0,0,0,,Қалқымалы
Dialogue: 0,1:01:20.62,1:01:21.87,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:01:22.70,1:01:25.62,Default,,0,0,0,,Осындай үлкен масса ауада қалай қалықтайды?
Dialogue: 0,1:01:25.70,1:01:27.16,Default,,0,0,0,,Экстрадименталды болмыс...
Dialogue: 0,1:01:27.62,1:01:30.66,Default,,0,0,0,,Годзилланың оған мүлде араласа алмағаны рас...
Dialogue: 0,1:01:30.95,1:01:31.95,Default,,0,0,0,,Сонда ол ше?
Dialogue: 0,1:01:32.04,1:01:34.95,Default,,0,0,0,,Бұл жаққа қарсы жақ қалай кедергі жасайды?
Dialogue: 0,1:01:35.04,1:01:36.66,Default,,0,0,0,,Қандай шарттар бар?
Dialogue: 0,1:01:37.33,1:01:40.75,Default,,0,0,0,,Біріншіден, оның бар екендігін дәлелдейтін бақылау әдістері жоқ.
Dialogue: 0,1:01:41.37,1:01:43.70,Default,,0,0,0,,Елес десең, сол.
Dialogue: 0,1:01:43.91,1:01:46.58,Default,,0,0,0,,Бірақ Гидораның тістері Годзиллаға жетеді
Dialogue: 0,1:01:46.66,1:01:49.16,Default,,0,0,0,,Гидорадан көрінетін Годзилла елес емес.
Dialogue: 0,1:01:49.62,1:01:52.37,Default,,0,0,0,,Ол Годзилланың бар екенін растайды
Dialogue: 0,1:01:52.95,1:01:54.75,Default,,0,0,0,,Жау Гидора емес!
Dialogue: 0,1:01:54.83,1:01:59.12,Default,,0,0,0,,Әлемнің біздің жағында оны басқаратын біреу бар.
Dialogue: 0,1:02:01.00,1:02:02.33,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:02:02.83,1:02:04.12,Default,,0,0,0,,Метфис!
Dialogue: 0,1:02:05.62,1:02:07.70,Default,,0,0,0,,Мен капитан Сакакиге айтуым керек.
Dialogue: 0,1:02:11.37,1:02:12.29,Default,,0,0,0,,Уф!
Dialogue: 0,1:02:13.91,1:02:15.45,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,1:02:15.66,1:02:17.45,Default,,0,0,0,,Мен Харуоға көмектесуім керек.
Dialogue: 0,1:02:17.83,1:02:20.79,Default,,0,0,0,,Ол қазір Гидорамен де күресіп жатыр.
Dialogue: 0,1:02:23.54,1:02:27.41,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:02:34.50,1:02:37.66,Default,,0,0,0,,Көптеген әлемдерде өркендеген өркениеттер
Dialogue: 0,1:02:38.45,1:02:41.25,Default,,0,0,0,,Бір күні біз тыйым салынған елге жетеміз
Dialogue: 0,1:02:42.00,1:02:44.45,Default,,0,0,0,,Есікті ашқанда
Dialogue: 0,1:02:45.08,1:02:47.41,Default,,0,0,0,,Құбыжық туады
Dialogue: 0,1:02:48.00,1:02:48.91,Default,,0,0,0,,Ха!
Dialogue: 0,1:02:54.29,1:02:56.58,Default,,0,0,0,,Годзилланың пайда болуына әкелген өркениет
Dialogue: 0,1:02:57.04,1:02:59.20,Default,,0,0,0,,Сол жол қиылысынан өткенде
Dialogue: 0,1:02:59.75,1:03:02.45,Default,,0,0,0,,Жойылған
Dialogue: 0,1:03:02.75,1:03:03.58,Default,,0,0,0,,Ха
Dialogue: 0,1:03:03.91,1:03:05.08,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,1:03:05.29,1:03:08.33,Default,,0,0,0,,Біз бұл жойылуды қалай қабылдаймыз?
Dialogue: 0,1:03:08.79,1:03:10.70,Default,,0,0,0,,Соңына дейін табанды түрде
Dialogue: 0,1:03:11.29,1:03:15.66,Default,,0,0,0,,Мақтану керек деп ойламайсың ба?
Dialogue: 0,1:03:21.12,1:03:25.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:25.75,1:03:27.04,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,1:03:27.50,1:03:29.66,Default,,0,0,0,,Тек жою үшін...
Dialogue: 0,1:03:30.70,1:03:32.75,Default,,0,0,0,,Сіз өркениет құрдыңыз ба?
Dialogue: 0,1:03:33.58,1:03:36.37,Default,,0,0,0,,Бірақ бұл пессимистік болмауы керек.
Dialogue: 0,1:03:36.87,1:03:41.50,Default,,0,0,0,,Шекті ғаламда бұл табиғи қорытынды.
Dialogue: 0,1:03:41.91,1:03:46.41,Default,,0,0,0,,Сондықтан приматтың рухы өлімнен де асып түсті.
Dialogue: 0,1:03:47.45,1:03:51.62,Default,,0,0,0,,Біз жойылмайтын саланы зерттеуіміз керек.
Dialogue: 0,1:03:52.00,1:03:58.45,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:03:59.00,1:03:59.95,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:00.04,1:04:03.79,Default,,0,0,0,,Гидора ғана емес, Годзилланың өлшемдері де екіұшты.
Dialogue: 0,1:04:04.70,1:04:08.00,Default,,0,0,0,,Шындық бұзылып жатыр дейсіз бе? ?
Dialogue: 0,1:04:08.54,1:04:13.50,Default,,0,0,0,,(Мартин мен Майнаның ауыр тыныс алуы)
Dialogue: 0,1:04:16.41,1:04:17.33,Default,,0,0,0,,Ха…
Dialogue: 0,1:04:20.04,1:04:21.25,Default,,0,0,0,,Ой!
Dialogue: 0,1:04:21.87,1:04:23.75,Default,,0,0,0,,Бұл футуа құдайы ма?
Dialogue: 0,1:04:25.62,1:04:27.95,Default,,0,0,0,,Сіздің ұзақ сапарыңыз
Dialogue: 0,1:04:28.25,1:04:31.58,Default,,0,0,0,,Өзінің жойылуымен бетпе-бет келу зиярат болды.
Dialogue: 0,1:04:32.37,1:04:33.91,Default,,0,0,0,,Годзилла дегеніміз не?
Dialogue: 0,1:04:34.12,1:04:37.58,Default,,0,0,0,,Таусылмас игілік іздеген менмендігінің жазасы
Dialogue: 0,1:04:38.12,1:04:43.12,Default,,0,0,0,,Мұны ең үлкен нәрсеге арнау арқылы жеңу.
Dialogue: 0,1:04:43.20,1:04:46.83,Default,,0,0,0,,Адам түрінің жанын тазартудан басқа амал жоқ.
Dialogue: 0,1:04:53.70,1:04:55.08,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,1:04:55.25,1:04:57.41,Default,,0,0,0,,Жексұрын түстегі құтқарылу белгісі
Dialogue: 0,1:04:58.16,1:05:01.33,Default,,0,0,0,,Мына әнді қарғаға жеткіз!
Dialogue: 0,1:05:01.62,1:05:08.62,Default,,0,0,0,,(Құбыжықтың айқайы)
Dialogue: 0,1:05:12.75,1:05:14.29,Default,,0,0,0,,Құдайға тіл тигізуші
Dialogue: 0,1:05:15.00,1:05:16.70,Default,,0,0,0,,(айқай)
Dialogue: 0,1:05:18.12,1:05:19.41,Default,,0,0,0,,(айқай)
Dialogue: 0,1:05:19.75,1:05:20.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:22.50,1:05:23.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:26.62,1:05:27.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:28.62,1:05:29.62,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:05:30.45,1:05:31.41,Default,,0,0,0,,Көбелек?
Dialogue: 0,1:05:32.33,1:05:33.58,Default,,0,0,0,,Харуо!
Dialogue: 0,1:05:36.04,1:05:37.00,Default,,0,0,0,,Харуо
Dialogue: 0,1:05:37.41,1:05:40.04,Default,,0,0,0,,Қорықпа, мұқият тыңда...
Dialogue: 0,1:05:46.25,1:05:47.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:47.62,1:05:48.95,Default,,0,0,0,,Харуо?
Dialogue: 0,1:05:49.45,1:05:52.41,Default,,0,0,0,,Енді Майнаның көмегімен мен сені шақырамын!
Dialogue: 0,1:05:52.50,1:05:56.45,Default,,0,0,0,,Гидора бұл дүниеге араласуға қабілетті, өйткені оның бақылау құралдары бар.
Dialogue: 0,1:05:56.91,1:05:59.41,Default,,0,0,0,,Мен Гидораның көзінің орнына Годзилланы көріп тұрмын!
Dialogue: 0,1:05:59.50,1:06:00.79,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,1:06:05.29,1:06:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:06.70,1:06:08.95,Default,,0,0,0,,(айқай)
Dialogue: 0,1:06:12.41,1:06:13.41,Default,,0,0,0,,Ха
Dialogue: 0,1:06:24.12,1:06:27.29,Default,,0,0,0,,Ах... хаха
Dialogue: 0,1:06:29.29,1:06:32.04,Default,,0,0,0,,Мұны неге маған көрсетіп жатырсың?
Dialogue: 0,1:06:33.66,1:06:35.75,Default,,0,0,0,,Менің не істегенімді қалайсың?
Dialogue: 0,1:06:36.41,1:06:39.54,Default,,0,0,0,,Құбыжықты құбыжық ететін қорқыныш
Dialogue: 0,1:06:40.04,1:06:42.87,Default,,0,0,0,,Адамды батыр ететін өшпенділік.
Dialogue: 0,1:06:42.95,1:06:47.37,Default,,0,0,0,,Ал Құдайды Құдай ететін батырлардың дұғалары.
Dialogue: 0,1:06:48.58,1:06:51.12,Default,,0,0,0,,Жаңа Годзилла болудың орнына
Dialogue: 0,1:06:51.20,1:06:55.83,Default,,0,0,0,,Адам ретінде сіз Годзиллаға қарсы тұрып, оны қарғауды жалғастырдыңыз.
Dialogue: 0,1:06:56.79,1:06:59.33,Default,,0,0,0,,Құдайымызды мадақтаңдар
Dialogue: 0,1:06:59.75,1:07:03.12,Default,,0,0,0,,Сол дауыспен Құдайға шақыруыңды қалаймын.
Dialogue: 0,1:07:03.45,1:07:04.29,Default,,0,0,0,,Ха…
Dialogue: 0,1:07:04.37,1:07:07.37,Default,,0,0,0,,Сендей батыр жаныңды құрбан етіп,
Dialogue: 0,1:07:07.79,1:07:09.83,Default,,0,0,0,,Ақырында Гидораның құдайлығы
Dialogue: 0,1:07:09.91,1:07:13.20,Default,,0,0,0,,Бұл дүниеде берік болу
Dialogue: 0,1:07:14.20,1:07:15.12,Default,,0,0,0,,Иә
Dialogue: 0,1:07:17.54,1:07:18.54,Default,,0,0,0,,Ха!
Dialogue: 0,1:07:31.58,1:07:32.87,Default,,0,0,0,,Сіз...
Dialogue: 0,1:07:33.75,1:07:35.04,Default,,0,0,0,,болды ма?
Dialogue: 0,1:07:35.87,1:07:38.16,Default,,0,0,0,,Ауырсыну үшін өмір т.б.
Dialogue: 0,1:07:38.37,1:07:40.16,Default,,0,0,0,,Біз қабылдамаймыз
Dialogue: 0,1:07:41.12,1:07:43.04,Default,,0,0,0,,Жоюға апаратын жол
Dialogue: 0,1:07:44.00,1:07:46.29,Default,,0,0,0,,Сіз тыныш болуыңыз керек.
Dialogue: 0,1:07:48.54,1:07:49.62,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,1:07:49.70,1:07:53.41,Default,,0,0,0,,Осылайша бәріміз құтқарылдық.
Dialogue: 0,1:07:53.79,1:07:57.58,Default,,0,0,0,,Барлығы жеткілікті ұзақ күресті
Dialogue: 0,1:07:58.16,1:08:01.00,Default,,0,0,0,,Өмір тек жаза үшін болса
Dialogue: 0,1:08:01.08,1:08:03.62,Default,,0,0,0,,Оны аяқтаудан басқа құтқару жоқ.
Dialogue: 0,1:08:04.45,1:08:05.58,Default,,0,0,0,,Эй
Dialogue: 0,1:08:06.50,1:08:08.91,Default,,0,0,0,,Сіз солай ойлайсыз, солай ма? Харуо…
Dialogue: 0,1:08:09.95,1:08:10.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:08:11.83,1:08:12.79,Default,,0,0,0,,Бірақ
Dialogue: 0,1:08:13.54,1:08:14.83,Default,,0,0,0,,Мен...
Dialogue: 0,1:08:15.79,1:08:17.25,Default,,0,0,0,,Харуо! тез!
Dialogue: 0,1:08:18.16,1:08:19.25,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:19.66,1:08:21.45,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:22.66,1:08:23.54,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:27.04,1:08:28.08,Default,,0,0,0,,Мақтау
Dialogue: 0,1:08:28.37,1:08:30.58,Default,,0,0,0,,Ақырзаман қанаттары
Dialogue: 0,1:08:31.91,1:08:33.25,Default,,0,0,0,,Ән
Dialogue: 0,1:08:33.58,1:08:34.66,Default,,0,0,0,,Алтын есім
Dialogue: 0,1:08:35.83,1:08:36.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:37.25,1:08:38.87,Default,,0,0,0,,Және сұраңыз
Dialogue: 0,1:08:40.04,1:08:42.45,Default,,0,0,0,,Жеңіс пен бата
Dialogue: 0,1:08:46.20,1:08:47.08,Default,,0,0,0,,Ха...
Dialogue: 0,1:08:48.83,1:08:49.91,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:09:01.25,1:09:03.08,Default,,0,0,0,,Бұл гүл ме?
Dialogue: 0,1:09:04.04,1:09:05.08,Default,,0,0,0,,О
Dialogue: 0,1:09:05.16,1:09:08.20,Default,,0,0,0,,Мына балаға бойтұмар етіп жасаған көктем гүлі.
Dialogue: 0,1:09:08.83,1:09:13.37,Default,,0,0,0,,Сондай заманда да бір күні қыс өтіп, көктем келеді.
Dialogue: 0,1:09:14.20,1:09:16.20,Default,,0,0,0,,Өмірді тірілту мезгілі
Dialogue: 0,1:09:16.58,1:09:17.79,Default,,0,0,0,,Иә.
Dialogue: 0,1:09:18.29,1:09:21.58,Default,,0,0,0,,Осылай дұға етіп, мына балаға ат қой.
Dialogue: 0,1:09:21.79,1:09:23.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:09:23.91,1:09:25.00,Default,,0,0,0,,Харуо
Dialogue: 0,1:09:27.16,1:09:29.75,Default,,0,0,0,,Сен Харусың, балам.
Dialogue: 0,1:09:31.33,1:09:32.54,Default,,0,0,0,,Иә.
Dialogue: 0,1:09:35.54,1:09:36.83,Default,,0,0,0,,Бұл болды
Dialogue: 0,1:09:41.54,1:09:42.58,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:09:45.50,1:09:47.87,Default,,0,0,0,,Куу... Кууу
Dialogue: 0,1:09:50.91,1:09:53.70,Default,,0,0,0,,Біздің қателіктерімізге жұбаныш жоқ
Dialogue: 0,1:09:53.95,1:09:56.20,Default,,0,0,0,,Мұның бәрі ақталу.
Dialogue: 0,1:09:56.87,1:09:59.00,Default,,0,0,0,,Берсең, бәрі өтірік болады
Dialogue: 0,1:09:59.29,1:10:01.00,Default,,0,0,0,,Құтқарудың қажеті жоқ.
Dialogue: 0,1:10:01.83,1:10:03.16,Default,,0,0,0,,Харуо…
Dialogue: 0,1:10:03.79,1:10:05.33,Default,,0,0,0,,Сен…
Dialogue: 0,1:10:05.87,1:10:09.33,Default,,0,0,0,,Бұл өмір қаншалықты аз, аянышты болса да,
Dialogue: 0,1:10:09.91,1:10:12.87,Default,,0,0,0,,Өлгендердің бәрі соған сенді
Dialogue: 0,1:10:12.95,1:10:15.00,Default,,0,0,0,,Саған опасыздық жасағанды жөн көремін.
Dialogue: 0,1:10:15.08,1:10:16.54,Default,,0,0,0,,Мен...!
Dialogue: 0,1:10:17.20,1:10:19.08,Default,,0,0,0,,Ууууах!
Dialogue: 0,1:10:19.54,1:10:22.41,Default,,0,0,0,,Шыу!
Dialogue: 0,1:10:27.91,1:10:31.37,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:10:34.29,1:10:36.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:10:36.54,1:10:40.45,Default,,0,0,0,,Шыу!
Dialogue: 0,1:10:42.87,1:10:44.20,Default,,0,0,0,,Не... не?
Dialogue: 0,1:10:45.08,1:10:46.08,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,1:10:46.16,1:10:49.37,Default,,0,0,0,,Жылу көзі Радиотолқындар Барлық сенсорлар Гидораны түсіреді!
Dialogue: 0,1:10:49.45,1:10:51.16,Default,,0,0,0,,Гравитация өрісінің қалыптан тыс әлсіреуі
Dialogue: 0,1:10:51.41,1:10:56.58,Default,,0,0,0,,Керемет, сізде неғұрлым көп деректер болса, соғұрлым құбылыстағы сәйкессіздіктер түзетіледі!
Dialogue: 0,1:11:37.41,1:11:39.66,Default,,0,0,0,,Харуо... сен мұны істедің бе!?
Dialogue: 0,1:11:39.79,1:11:40.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:41.16,1:11:44.75,Default,,0,0,0,,Ерго аймағы тез жабылуда!
Dialogue: 0,1:11:59.66,1:12:04.66,Default,,0,0,0,,Шыу!
Dialogue: 0,1:12:16.58,1:12:19.66,Default,,0,0,0,,Гидораны осы жағынан физика заңдары ұстады.
Dialogue: 0,1:12:20.70,1:12:22.50,Default,,0,0,0,,Сіз қазір Годзилланы жеңе аласыз!
Dialogue: 0,1:12:30.20,1:12:32.12,Default,,0,0,0,,(айқай)
Dialogue: 0,1:12:37.04,1:12:38.87,Default,,0,0,0,,(айқай)
Dialogue: 0,1:13:00.00,1:13:02.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:13:13.16,1:13:15.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:13:32.08,1:13:35.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:14:15.45,1:14:16.50,Default,,0,0,0,,Уф
Dialogue: 0,1:14:19.79,1:14:20.75,Default,,0,0,0,,Ха…
Dialogue: 0,1:14:35.29,1:14:36.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:38.58,1:14:39.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:40.37,1:14:41.41,Default,,0,0,0,,Хару...
Dialogue: 0,1:14:42.58,1:14:44.95,Default,,0,0,0,,Сол ашу мен жек көрушіліктен...
Dialogue: 0,1:14:45.37,1:14:48.37,Default,,0,0,0,,Қандай ыстық және таң қалдырады!
Dialogue: 0,1:14:51.33,1:14:52.62,Default,,0,0,0,,Сіз...
Dialogue: 0,1:14:53.91,1:14:56.87,Default,,0,0,0,,Қайғы мен қайғы
Dialogue: 0,1:14:57.33,1:15:00.70,Default,,0,0,0,,Барлық тіршілік иелеріне таңылған
Dialogue: 0,1:15:01.04,1:15:01.95,Default,,0,0,0,,Бұл қарғыс
Dialogue: 0,1:15:03.91,1:15:04.83,Default,,0,0,0,,Сондықтан...
Dialogue: 0,1:15:07.12,1:15:08.87,Default,,0,0,0,,Харуо…
Dialogue: 0,1:15:09.75,1:15:12.45,Default,,0,0,0,,Ол тірі болғанша...
Dialogue: 0,1:15:14.95,1:15:16.33,Default,,0,0,0,,Гидора
Dialogue: 0,1:15:18.37,1:15:19.54,Default,,0,0,0,,«періштелер баспалдағы» деп те аталатын жарық.
Dialogue: 0,1:15:20.33,1:15:22.79,Default,,0,0,0,,Қараңдар... мінекей.
Dialogue: 0,1:15:23.87,1:15:25.33,Default,,0,0,0,,Метфис…
Dialogue: 0,1:15:29.83,1:15:30.66,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:32.45,1:15:35.75,Default,,0,0,0,,(Харуоның жылағаны)
Dialogue: 0,1:15:40.04,1:15:46.04,Default,,0,0,0,,♪~
Dialogue: 0,1:17:45.25,1:17:51.25,Default,,0,0,0,,~♪
Dialogue: 0,1:17:52.33,1:17:53.37,Default,,0,0,0,,Бұл...
Dialogue: 0,1:17:54.54,1:17:57.75,Default,,0,0,0,,Жаңбырлы маусым алдындағы гүл маусымы
Dialogue: 0,1:17:58.50,1:18:00.50,Default,,0,0,0,,Мен оны Харуоға көрсеткім келді
Dialogue: 0,1:18:03.16,1:18:04.54,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:18:05.50,1:18:06.83,Default,,0,0,0,,Бұл...
Dialogue: 0,1:18:07.41,1:18:08.45,Default,,0,0,0,,Көктем
Dialogue: 0,1:18:10.12,1:18:11.87,Default,,0,0,0,,Мен оны бірінші рет көрдім
Dialogue: 0,1:18:12.50,1:18:14.75,Default,,0,0,0,,Менің атым болса да
Dialogue: 0,1:18:20.33,1:18:21.70,Default,,0,0,0,,Мен сені күттім, Харуо.
Dialogue: 0,1:18:22.08,1:18:24.45,Default,,0,0,0,,Төтенше жағдай дегеніміз не?
Dialogue: 0,1:18:24.54,1:18:28.20,Default,,0,0,0,,Иә, мен оны бірінші сенің көруіңді қаладым.
Dialogue: 0,1:18:30.75,1:18:31.95,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:18:34.25,1:18:36.45,Default,,0,0,0,,Бұл енді жұмыс істемейді, солай ма?
Dialogue: 0,1:18:36.91,1:18:38.54,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,1:18:39.25,1:18:41.08,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,1:18:41.41,1:18:43.91,Default,,0,0,0,,Қуат реакторы сәтті қайта іске қосылды
Dialogue: 0,1:18:44.00,1:18:46.58,Default,,0,0,0,,Бұл да өзін-өзі емдеу жүйесін қалпына келтіреді.
Dialogue: 0,1:18:47.00,1:18:50.29,Default,,0,0,0,,Ол таңға дейін қозғала алатын шығар!
Dialogue: 0,1:18:50.37,1:18:51.29,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:18:51.70,1:18:55.00,Default,,0,0,0,,Юконың денесі әлі де белсенді.
Dialogue: 0,1:18:55.08,1:18:57.70,Default,,0,0,0,,Өйткені біз нанометалл үлгісін қалпына келтіре алдық.
Dialogue: 0,1:18:57.79,1:18:59.45,Default,,0,0,0,,Жаман жабдық та қалмады.
Dialogue: 0,1:18:59.54,1:19:01.29,Default,,0,0,0,,Талдай аламын ба, жоқ па, құмар ойын болды.
Dialogue: 0,1:19:01.75,1:19:05.08,Default,,0,0,0,,Бүгін таңертең біз басқару жүйесін басқара алдық.
Dialogue: 0,1:19:05.16,1:19:06.66,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,1:19:06.83,1:19:09.25,Default,,0,0,0,,Өзін-өзі тарататын және есте сақтайтын технология
Dialogue: 0,1:19:09.33,1:19:11.41,Default,,0,0,0,,Шексіз қайталанатын наномашиналар!
Dialogue: 0,1:19:11.83,1:19:14.37,Default,,0,0,0,,Бильсалдо сияқты бұл жігітті басқара алсам.
Dialogue: 0,1:19:14.45,1:19:17.00,Default,,0,0,0,,Біз өткен өркениеттерді қалпына келтіре аламыз!
Dialogue: 0,1:19:17.08,1:19:19.66,Default,,0,0,0,,Қазір қарабайыр өмір қандай?
Dialogue: 0,1:19:19.79,1:19:20.62,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:20.79,1:19:22.79,Default,,0,0,0,,Не болды? Харуо
Dialogue: 0,1:19:24.70,1:19:25.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:26.04,1:19:27.50,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:19:27.95,1:19:31.75,Default,,0,0,0,,Өркендеу жолында тойымсыз жетілдірілу адамның табиғаты
Dialogue: 0,1:19:32.04,1:19:33.00,Default,,0,0,0,,Және де
Dialogue: 0,1:19:33.87,1:19:36.79,Default,,0,0,0,,Егін жинау науқаны жақындап қалды.
Dialogue: 0,1:19:38.20,1:19:39.45,Default,,0,0,0,,Қашан
Dialogue: 0,1:19:40.12,1:19:41.83,Default,,0,0,0,,Ол біз жақта.
Dialogue: 0,1:19:42.58,1:19:46.83,Default,,0,0,0,,Бізге тек күту керек және асықпау керек.
Dialogue: 0,1:19:49.12,1:19:51.25,Default,,0,0,0,,А... хмм?
Dialogue: 0,1:19:51.83,1:19:54.00,Default,,0,0,0,,Не болды? Харуо
Dialogue: 0,1:19:54.41,1:19:55.25,Default,,0,0,0,,Харуо!
Dialogue: 0,1:19:55.33,1:19:57.83,Default,,0,0,0,,Доктор Мартин данышпан.
Dialogue: 0,1:19:57.91,1:20:00.66,Default,,0,0,0,,Бұл қарабайыр өмір ме?
Dialogue: 0,1:20:01.37,1:20:04.50,Default,,0,0,0,,Бір рет үйреніп алсаңыз, бұл таңқаларлық жақсы.
Dialogue: 0,1:20:05.12,1:20:07.50,Default,,0,0,0,,Бұл сізге ұнады.
Dialogue: 0,1:20:07.58,1:20:09.66,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:20:11.04,1:20:13.12,Default,,0,0,0,,Харуо, жақсысың ба?
Dialogue: 0,1:20:14.41,1:20:16.62,Default,,0,0,0,,А... Менде бәрі жақсы.
Dialogue: 0,1:20:17.75,1:20:18.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:25.45,1:20:26.37,Default,,0,0,0,,Ха…
Dialogue: 0,1:20:31.66,1:20:35.45,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,1:20:43.04,1:20:43.95,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,1:20:45.04,1:20:45.91,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,1:20:46.54,1:20:48.25,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:20:49.75,1:20:50.79,Default,,0,0,0,,Миана
Dialogue: 0,1:20:51.25,1:20:52.50,Default,,0,0,0,,Годзилла қорқынышты ма?
Dialogue: 0,1:20:52.83,1:20:55.33,Default,,0,0,0,,Ах... иә
Dialogue: 0,1:20:55.58,1:20:56.87,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:20:58.04,1:20:58.87,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,1:20:59.79,1:21:00.87,Default,,0,0,0,,Сіз оны жек көресіз бе?
Dialogue: 0,1:21:01.66,1:21:02.79,Default,,0,0,0,,Годзилла туралы
Dialogue: 0,1:21:03.54,1:21:04.91,Default,,0,0,0,,«жек көретін»?
Dialogue: 0,1:21:06.00,1:21:06.87,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:07.95,1:21:09.75,Default,,0,0,0,,Годзилла қорқынышты
Dialogue: 0,1:21:10.58,1:21:13.12,Default,,0,0,0,,Мен торнадодан, найзағайдан қорқамын.
Dialogue: 0,1:21:14.12,1:21:17.54,Default,,0,0,0,,Бірақ «жек көру»…
Dialogue: 0,1:21:18.16,1:21:19.58,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:21:20.08,1:21:23.33,Default,,0,0,0,,Бұл қалыпты өмірде жоқ сөз.
Dialogue: 0,1:21:29.12,1:21:30.50,Default,,0,0,0,,Ах... Харуо!
Dialogue: 0,1:21:30.58,1:21:33.87,Default,,0,0,0,,Барма! Бұл шығын!
Dialogue: 0,1:21:34.45,1:21:35.62,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:21:35.79,1:21:36.66,Default,,0,0,0,,Ха…
Dialogue: 0,1:21:36.75,1:21:39.33,Default,,0,0,0,,Егер өмір тек жеңісті жалғастыру болса...
Dialogue: 0,1:21:40.16,1:21:41.58,Default,,0,0,0,,Аңмен бірдей
Dialogue: 0,1:21:43.16,1:21:44.41,Default,,0,0,0,,Бірақ біз
Dialogue: 0,1:21:45.33,1:21:46.66,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,1:21:47.16,1:21:49.04,Default,,0,0,0,,Сіз жеңілген шайқаста күресуді таңдай аласыз.
Dialogue: 0,1:21:49.41,1:21:50.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:52.37,1:21:53.79,Default,,0,0,0,,Маған...
Dialogue: 0,1:21:54.58,1:21:55.79,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,1:21:56.58,1:21:59.54,Default,,0,0,0,,Мәңгілік білудің қажеті жоқ
Dialogue: 0,1:22:01.20,1:22:02.66,Default,,0,0,0,,Мен сонда болсам ғой
Dialogue: 0,1:22:03.12,1:22:04.16,Default,,0,0,0,,Бір күні
Dialogue: 0,1:22:04.33,1:22:06.54,Default,,0,0,0,,Мүмкін түсінетін шығарсыңдар.
Dialogue: 0,1:22:06.62,1:22:07.50,Default,,0,0,0,,Ха…
Dialogue: 0,1:22:10.45,1:22:11.58,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,1:22:12.45,1:22:13.66,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,1:22:16.95,1:22:19.29,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,1:22:55.29,1:22:57.00,Default,,0,0,0,,Сіз Годзилланы түсінесіз бе...
Dialogue: 0,1:22:57.87,1:22:59.29,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,1:23:00.08,1:23:02.95,Default,,0,0,0,,Сізге қарсы шыққан соңғысы
Dialogue: 0,1:23:03.04,1:23:04.20,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,1:23:04.58,1:23:06.95,Default,,0,0,0,,Сіз алған барлық өмір
Dialogue: 0,1:23:07.70,1:23:10.75,Default,,0,0,0,,Сіз жойған барлық армандарыңызды арқалап
Dialogue: 0,1:23:11.12,1:23:13.04,Default,,0,0,0,,Енді мен осындамын!
Dialogue: 0,1:23:16.91,1:23:18.29,Default,,0,0,0,,Егер сіз
Dialogue: 0,1:23:18.66,1:23:21.29,Default,,0,0,0,,Егер сен шынымен де жойылу бейнесі болсаң.
Dialogue: 0,1:23:23.33,1:23:25.79,Default,,0,0,0,,Бұл уақытта ештеңе қалдырмаңыз
Dialogue: 0,1:23:26.37,1:23:28.54,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,1:23:29.41,1:23:31.58,Default,,0,0,0,,Өткеннің барлық қарғысы!
Dialogue: 0,1:23:34.91,1:23:36.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:23:41.25,1:23:42.70,Default,,0,0,0,,Хаа
Dialogue: 0,1:23:46.83,1:23:49.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:24:02.29,1:24:08.29,Default,,0,0,0,,♪~
Dialogue: 0,1:28:44.54,1:28:50.54,Default,,0,0,0,,~♪
Dialogue: 0,1:28:52.87,1:28:58.87,Default,,0,0,0,,(Ұрмалы аспаптың соғу дыбысы)
Dialogue: 0,1:29:07.00,1:29:09.00,Default,,0,0,0,,Ауырмаңыз
Dialogue: 0,1:29:09.08,1:29:11.37,Default,,0,0,0,,Сіз қорқынышты түс көрмейсіз деп үміттенемін
Dialogue: 0,1:29:11.45,1:29:13.54,Default,,0,0,0,,Жәндіктердің шағуына жол бермеңіз
Dialogue: 0,1:29:13.62,1:29:15.66,Default,,0,0,0,,Ағашқа өрмелеу кезінде жарақаттанбаңыз
Dialogue: 0,1:29:15.75,1:29:19.16,Default,,0,0,0,,Енді, бәріңіз, қорқынышты нәрсені мөрлеп тастадыңыз ба?
Dialogue: 0,1:29:19.50,1:29:20.91,Default,,0,0,0,,Иә
Dialogue: 0,1:29:21.41,1:29:24.29,Default,,0,0,0,,Оикарисама Ойкарисама
Dialogue: 0,1:29:24.37,1:29:27.50,Default,,0,0,0,,Осы жылы да тазаруыңызды өтінемін.
Dialogue: 0,1:29:27.58,1:29:30.45,Default,,0,0,0,,Қарғысты отпен ұмыт
Dialogue: 0,1:29:38.33,1:29:44.33,Default,,0,0,0,,(Ұрмалы аспаптардың дыбысы)
Dialogue: 0,1:29:45.83,1:29:51.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
