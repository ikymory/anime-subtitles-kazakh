Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.21,0:00:07.67,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:00:08.50,0:00:09.92,Default,,0,0,0,,Бұл Камо Серизава.
Dialogue: 0,0:00:10.01,0:00:15.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:34.92,0:01:39.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:40.51,0:01:42.68,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:42.76,0:01:44.64,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:01:50.69,0:01:51.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:07.54,0:02:14.55,Default,,0,0,0,,(Серизаваның ауыр тыныс алуы)
Dialogue: 0,0:02:15.84,0:02:18.26,Default,,0,0,0,,Ештеңе айтпай ілулі тұру
Dialogue: 0,0:02:18.34,0:02:24.39,Default,,0,0,0,,Сіз әдетте: «Бұл фарстың мәні неде?
Dialogue: 0,0:02:24.47,0:02:26.39,Default,,0,0,0,,Бірақ сен тыңдамайсың.
Dialogue: 0,0:02:27.39,0:02:29.81,Default,,0,0,0,,Үнсіз отырыңыз
Dialogue: 0,0:02:30.52,0:02:32.40,Default,,0,0,0,,Сізге ұқсайды.
Dialogue: 0,0:02:32.48,0:02:34.40,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:02:34.48,0:02:39.65,Default,,0,0,0,,Мен оның ебедейсіздігін бейнелеген самурайдан дәл осылай күттім.
Dialogue: 0,0:02:40.53,0:02:44.49,Default,,0,0,0,,Мен тым шебермін. Менде ол жоқ.
Dialogue: 0,0:02:45.54,0:02:48.16,Default,,0,0,0,,Тазалықтың гүлі
Dialogue: 0,0:02:48.25,0:02:50.83,Default,,0,0,0,,Құмарлықтың жалыны
Dialogue: 0,0:02:51.75,0:02:54.92,Default,,0,0,0,,Бір кездері менде болған нәрсе
Dialogue: 0,0:02:55.00,0:02:59.17,Default,,0,0,0,,Оны әлі де қастерлейтін адам
Dialogue: 0,0:03:01.34,0:03:03.39,Default,,0,0,0,,Егер сіз жоғарыдан соқсаңыз...
Dialogue: 0,0:03:07.02,0:03:10.77,Default,,0,0,0,,Қараңызшы, негізгі жауап.
Dialogue: 0,0:03:10.85,0:03:12.48,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:03:13.52,0:03:16.86,Default,,0,0,0,,Негіздердің маңызы зор.
Dialogue: 0,0:03:17.94,0:03:21.86,Default,,0,0,0,,Мен Кен-санға қанша күн өткізгенімді көріп тұрмын.
Dialogue: 0,0:03:21.95,0:03:24.45,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:24.53,0:03:31.29,Default,,0,0,0,,Сіздің алдыңызда бұл Серизава үйрегі пішінсіз.
Dialogue: 0,0:03:39.21,0:03:44.59,Default,,0,0,0,,Ол Мибро фракциясының бұл жекпе-жегін де ұйымдастырмаған шығар.
Dialogue: 0,0:03:45.09,0:03:50.18,Default,,0,0,0,,Ештеңе жасамай-ақ, айналаңызға адамдар жиналды.
Dialogue: 0,0:03:53.77,0:03:56.36,Default,,0,0,0,,Хиджиката және басқалар мұны істеді ме?
Dialogue: 0,0:03:57.48,0:03:59.53,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:03:59.61,0:04:03.70,Default,,0,0,0,,Танымал болсаң да, кезекке тұрдың.
Dialogue: 0,0:04:03.78,0:04:07.70,Default,,0,0,0,,Серизава мырза, мен сізге ризамын.
Dialogue: 0,0:04:07.78,0:04:11.12,Default,,0,0,0,,Көптеген сарбаздар әлі күнге дейін сізді таң қалдырады.
Dialogue: 0,0:04:11.20,0:04:15.29,Default,,0,0,0,,Егер сіз қаласаңыз, сіз өз отрядыңызды екіге бөлетін шайқасқа қатыса аласыз.
Dialogue: 0,0:04:15.79,0:04:19.63,Default,,0,0,0,,Бірақ сіз жаппай соғыстан аулақ болдыңыз.
Dialogue: 0,0:04:19.71,0:04:21.71,Default,,0,0,0,,Қан көп сақталды
Dialogue: 0,0:04:24.47,0:04:25.97,Default,,0,0,0,,Бұл дана шешім болды.
Dialogue: 0,0:04:26.05,0:04:28.76,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:04:28.85,0:04:31.27,Default,,0,0,0,,Мен жай ғана алаңдағым келмеді.
Dialogue: 0,0:04:31.35,0:04:33.77,Default,,0,0,0,,Осы сәнді уақыттан ләззат алыңыз!
Dialogue: 0,0:04:33.85,0:04:35.77,Default,,0,0,0,,Сіз нағыз самурай едіңіз!
Dialogue: 0,0:04:35.85,0:04:37.77,Default,,0,0,0,,Бұл менің мақсатым болды!
Dialogue: 0,0:04:37.86,0:04:39.19,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:04:43.86,0:04:45.28,Default,,0,0,0,,Серизава мырза!
Dialogue: 0,0:04:46.24,0:04:50.54,Default,,0,0,0,,(Серизаваның ауыр тыныс алуы)
Dialogue: 0,0:04:50.62,0:04:55.29,Default,,0,0,0,,Бүркіт нағыз самурай ма?
Dialogue: 0,0:04:56.42,0:04:59.79,Default,,0,0,0,,Жоқ, Кондо мырза, бұл дұрыс емес.
Dialogue: 0,0:05:01.96,0:05:05.01,Default,,0,0,0,,Сондықтан сен усуноросың.
Dialogue: 0,0:05:05.84,0:05:07.84,Default,,0,0,0,,Ол декунобо.
Dialogue: 0,0:05:08.34,0:05:10.51,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:05:11.14,0:05:13.73,Default,,0,0,0,,Мен басқамын.
Dialogue: 0,0:05:13.81,0:05:16.27,Default,,0,0,0,,Кішігірім рөл
Dialogue: 0,0:05:17.10,0:05:19.40,Default,,0,0,0,,Тек баспалдақ
Dialogue: 0,0:05:19.90,0:05:24.03,Default,,0,0,0,,Серизава мырза, мен бұл рөлді ойнағаныма қуаныштымын.
Dialogue: 0,0:05:25.28,0:05:30.53,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:05:31.12,0:05:35.46,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:05:35.54,0:05:39.00,Default,,0,0,0,,Сіз зұлым кейіпкерді ойнай алмайсыз!
Dialogue: 0,0:05:39.08,0:05:41.75,Default,,0,0,0,,Сіз жеткілікті емессіз. Жақсы адам бол.
Dialogue: 0,0:05:41.84,0:05:43.92,Default,,0,0,0,,Оны сол күйінде қалдырыңыз, жеткілікті.
Dialogue: 0,0:05:44.67,0:05:47.13,Default,,0,0,0,,Егер тым алысқа кетсек, Радио ғимаратында дүрбелең болады,
Dialogue: 0,0:05:47.22,0:05:49.59,Default,,0,0,0,,Мен осы уақытқа дейін көп нәрсені көрдім.
Dialogue: 0,0:05:49.68,0:05:52.72,Default,,0,0,0,,Барлығы, бұл адамдардың бәрі жалған.
Dialogue: 0,0:05:52.81,0:05:58.73,Default,,0,0,0,,Бұл Серизава Камо өз өмірін қатерге тігіп, сөзсіз айтады!
Dialogue: 0,0:05:58.81,0:06:00.48,Default,,0,0,0,,Тек сен
Dialogue: 0,0:06:00.56,0:06:03.98,Default,,0,0,0,,Сіз әлемдегі жалғыз самурайсыз!
Dialogue: 0,0:06:10.32,0:06:12.03,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:06:12.53,0:06:14.99,Default,,0,0,0,,Менің жалғыз үмітім сенсің
Dialogue: 0,0:06:15.87,0:06:18.12,Default,,0,0,0,,Бүркіттің арманы
Dialogue: 0,0:06:19.75,0:06:22.38,Default,,0,0,0,,Миброның бұрынғы теріс қылықтары
Dialogue: 0,0:06:22.46,0:06:26.55,Default,,0,0,0,,Мен және Ниими, мұның барлығын екеуміз жоспарлағанбыз.
Dialogue: 0,0:06:28.01,0:06:29.51,Default,,0,0,0,,Мибро
Dialogue: 0,0:06:30.89,0:06:32.51,Default,,0,0,0,,Қайта туылған
Dialogue: 0,0:06:32.60,0:06:34.26,Default,,0,0,0,,Бұдан былай!
Dialogue: 0,0:06:34.35,0:06:37.77,Default,,0,0,0,,Мықты бол! Өсу!
Dialogue: 0,0:06:38.43,0:06:43.52,Default,,0,0,0,,Кондо! Сіз жалғыз шынайы самурайсыз!
Dialogue: 0,0:06:44.23,0:06:47.36,Default,,0,0,0,,Мен Миброға жауапты қалдырдым!
Dialogue: 0,0:06:53.91,0:06:54.95,Default,,0,0,0,,Мибро
Dialogue: 0,0:06:56.20,0:06:57.54,Default,,0,0,0,,Тағайындалды
Dialogue: 0,0:06:59.91,0:07:01.42,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:07:05.75,0:07:06.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:06.67,0:07:10.59,Default,,0,0,0,,Келіңіз, Кондо мырза, не істеу керек болса, соны жасаңыз.
Dialogue: 0,0:07:11.59,0:07:12.84,Default,,0,0,0,,Не істеу керек...
Dialogue: 0,0:07:13.43,0:07:16.60,Default,,0,0,0,,Сіз бұл жерде болмауыңыз керек.
Dialogue: 0,0:07:16.68,0:07:22.10,Default,,0,0,0,,Ішкі жанжал сыртқы әлемге белгілі болса, ол заңсыздардың жиналысына айналады.
Dialogue: 0,0:07:22.69,0:07:24.52,Default,,0,0,0,,Мен түсінемін...
Dialogue: 0,0:07:25.19,0:07:28.07,Default,,0,0,0,,Енді, жеткілікті! Бар!
Dialogue: 0,0:07:28.69,0:07:30.11,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:42.54,0:07:43.46,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:07:47.80,0:07:48.71,Default,,0,0,0,,Гомен
Dialogue: 0,0:07:56.76,0:07:59.72,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:07:59.81,0:08:03.06,Default,,0,0,0,,Бүркіт өртеніп кетті
Dialogue: 0,0:08:06.19,0:08:07.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:08.44,0:08:13.53,Default,,0,0,0,,Бүркіттің өмірі қандай?
Dialogue: 0,0:08:14.66,0:08:16.53,Default,,0,0,0,,Менің ойымша, бұл керемет болды.
Dialogue: 0,0:08:17.53,0:08:19.54,Default,,0,0,0,,Сізге ешкім еліктей алмайды
Dialogue: 0,0:08:21.20,0:08:22.54,Default,,0,0,0,,Хехе...
Dialogue: 0,0:08:22.62,0:08:27.59,Default,,0,0,0,,Бірақ өмір мен өлім бір
Dialogue: 0,0:08:27.67,0:08:30.80,Default,,0,0,0,,Соңғы бөлім маңызды
Dialogue: 0,0:08:31.71,0:08:35.43,Default,,0,0,0,,Менің енді Харакири жасауға күшім жетпейді.
Dialogue: 0,0:08:36.01,0:08:41.14,Default,,0,0,0,,Самурайдың осылай далада өлуі ұят.
Dialogue: 0,0:08:41.22,0:08:45.69,Default,,0,0,0,,Мені өлтіру үшін біреуді шақыруым керек.
Dialogue: 0,0:08:46.27,0:08:48.02,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:48.11,0:08:49.52,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:50.52,0:08:51.53,Default,,0,0,0,,Га
Dialogue: 0,0:09:02.62,0:09:04.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:05.37,0:09:07.42,Default,,0,0,0,,Сіз жауаптысыз
Dialogue: 0,0:09:08.75,0:09:12.92,Default,,0,0,0,,Ер болсаң, өмір жолыңды заманға ойып ал.
Dialogue: 0,0:09:13.01,0:09:15.88,Default,,0,0,0,,Әкем маған солай үйретті
Dialogue: 0,0:09:18.80,0:09:21.10,Default,,0,0,0,,Менің әкем жоқ
Dialogue: 0,0:09:21.18,0:09:22.47,Default,,0,0,0,,Мен сенің жүзіңді де білмеймін
Dialogue: 0,0:09:24.73,0:09:26.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:27.98,0:09:29.48,Default,,0,0,0,,Біз...
Dialogue: 0,0:09:30.77,0:09:34.86,Default,,0,0,0,,Бүркіт оның орнын баса алар ма еді?
Dialogue: 0,0:09:36.03,0:09:37.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:42.58,0:09:46.25,Default,,0,0,0,,Әкемдей, Нағашымдай
Dialogue: 0,0:09:46.33,0:09:47.83,Default,,0,0,0,,Шебер сияқты
Dialogue: 0,0:09:49.00,0:09:50.84,Default,,0,0,0,,Таудай болды
Dialogue: 0,0:09:51.63,0:09:54.59,Default,,0,0,0,,Хэхе... Тау?
Dialogue: 0,0:09:54.67,0:09:58.34,Default,,0,0,0,,Бұл ең үлкен мақтау.
Dialogue: 0,0:09:58.43,0:10:02.01,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:10:02.10,0:10:05.31,Default,,0,0,0,,Адам әлсіздер үшін өмір сүруі керек.
Dialogue: 0,0:10:05.39,0:10:08.85,Default,,0,0,0,,Сіз түбегейлі дұрыс айтасыз.
Dialogue: 0,0:10:09.52,0:10:14.86,Default,,0,0,0,,Қалағанымдай өмір сүрдім, Жүрегім жетелегендей.
Dialogue: 0,0:10:15.48,0:10:17.78,Default,,0,0,0,,...
Dialogue: 0,0:10:19.86,0:10:21.62,Default,,0,0,0,,Үміттенемін...
Dialogue: 0,0:10:21.70,0:10:24.66,Default,,0,0,0,,Жан спираль салады
Dialogue: 0,0:10:24.74,0:10:28.04,Default,,0,0,0,,Адам қайтыс болғанда, сәби болып қайта туады.
Dialogue: 0,0:10:30.12,0:10:32.42,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:34.13,0:10:36.26,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:37.97,0:10:39.38,Default,,0,0,0,,Я...
Dialogue: 0,0:10:43.55,0:10:44.85,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:10:46.52,0:10:48.60,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,0:10:48.68,0:10:51.65,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:10:54.32,0:10:55.86,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:11:01.95,0:11:04.87,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,0:11:04.95,0:11:07.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:08.20,0:11:10.37,Default,,0,0,0,,Мен мұны баспен соққы деп ойламадым.
Dialogue: 0,0:11:14.04,0:11:16.38,Default,,0,0,0,,Мен Иайдоны тоқтата алмадым
Dialogue: 0,0:11:17.51,0:11:19.97,Default,,0,0,0,,Менің денем кенет қозғалды.
Dialogue: 0,0:11:20.05,0:11:21.97,Default,,0,0,0,,Бұл самурайдың инстинкті болды
Dialogue: 0,0:11:22.05,0:11:24.47,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:11:25.22,0:11:26.60,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:11:27.56,0:11:29.48,Default,,0,0,0,,Додж!
Dialogue: 0,0:11:33.73,0:11:36.48,Default,,0,0,0,,Ол мені жақсы айналып өтті.
Dialogue: 0,0:11:37.61,0:11:40.36,Default,,0,0,0,,Мен өмір бойы өкінемін.
Dialogue: 0,0:11:43.16,0:11:45.32,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:11:46.62,0:11:50.00,Default,,0,0,0,,Серизава сізге шынымен бергісі келген нәрсе болды
Dialogue: 0,0:11:51.21,0:11:54.04,Default,,0,0,0,,Өмір сүруге талпыну күш емес пе еді?
Dialogue: 0,0:12:00.21,0:12:05.01,Default,,0,0,0,,Сол билік, бұл жолы, астанада тұратын әлсіздерге.
Dialogue: 0,0:12:05.76,0:12:07.72,Default,,0,0,0,,Оны менімен бірге пайдалана аласыз ба?
Dialogue: 0,0:12:08.60,0:12:13.02,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,0:12:13.10,0:12:16.02,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:12:20.57,0:12:21.57,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:35.33,0:12:37.75,Default,,0,0,0,,Ах, жылап жібергім келеді!! Егер білгенімде➡
Dialogue: 0,0:12:37.84,0:12:41.55,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:12:41.63,0:12:44.51,Default,,0,0,0,,Мен өмір сүріп жатқан әлем әдемі емес.
Dialogue: 0,0:12:44.59,0:12:50.06,Default,,0,0,0,,(Нио жылап жатыр)
Dialogue: 0,0:12:50.14,0:12:51.52,Default,,0,0,0,,Қатыгез
Dialogue: 0,0:12:55.23,0:12:58.52,Default,,0,0,0,,Көмек жоқ... еш жерде.
Dialogue: 0,0:12:58.61,0:13:00.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:07.16,0:13:08.41,Default,,0,0,0,,Күрес іздері
Dialogue: 0,0:13:10.49,0:13:14.62,Default,,0,0,0,,Серизава мырзаны дүниеде кім аяқтамақ болды...
Dialogue: 0,0:13:19.00,0:13:21.21,Default,,0,0,0,,Бұл Харада мырза ма әлде Яманами мырза ма?
Dialogue: 0,0:13:22.71,0:13:25.72,Default,,0,0,0,,Қалай болғанда да, бұл соңы ма?
Dialogue: 0,0:13:26.22,0:13:27.80,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:13:29.18,0:13:31.43,Default,,0,0,0,,Серизаваның өлімі бекер болмайды
Dialogue: 0,0:13:33.72,0:13:34.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:37.81,0:13:39.94,Default,,0,0,0,,Хиджиката мырза, біреу келе жатыр.
Dialogue: 0,0:13:40.86,0:13:41.69,Default,,0,0,0,,Ах
Dialogue: 0,0:13:42.57,0:13:44.78,Default,,0,0,0,,Сіз инспектор болдыңыз ба?
Dialogue: 0,0:13:45.28,0:13:50.07,Default,,0,0,0,,Сол жерде құлаған Серизава ма?
Dialogue: 0,0:13:55.20,0:13:56.62,Default,,0,0,0,,Не істеу керек
Dialogue: 0,0:13:56.71,0:13:58.62,Default,,0,0,0,,Мұны жасаған Чошу болды.
Dialogue: 0,0:13:58.71,0:13:59.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.25,0:14:03.50,Default,,0,0,0,,Серизава мырзаны экстремист Ронин өлтірді.
Dialogue: 0,0:14:04.59,0:14:08.51,Default,,0,0,0,,Оны есік тақтасына қойып, сол жердегі Маекава резиденциясына апарыңыз.
Dialogue: 0,0:14:08.59,0:14:10.39,Default,,0,0,0,,О, және Асано
Dialogue: 0,0:14:11.47,0:14:13.60,Default,,0,0,0,,Сіз бұрынғы дәрігер болуыңыз керек.
Dialogue: 0,0:14:13.68,0:14:17.39,Default,,0,0,0,,Мұқият тексеріп, Айзуға жіберу үшін есеп жасаңыз.
Dialogue: 0,0:14:17.48,0:14:19.94,Default,,0,0,0,,Не... Не деген ауыз!
Dialogue: 0,0:14:20.02,0:14:20.86,Default,,0,0,0,,Хаяши мырза
Dialogue: 0,0:14:23.52,0:14:24.73,Default,,0,0,0,,...
Dialogue: 0,0:14:27.49,0:14:28.65,Default,,0,0,0,,Дереу
Dialogue: 0,0:14:38.79,0:14:40.08,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:14:40.17,0:14:41.21,Default,,0,0,0,,Ах
Dialogue: 0,0:14:44.96,0:14:47.05,Default,,0,0,0,,Ұрылар кіріп кеткен сияқты.
Dialogue: 0,0:14:47.55,0:14:50.47,Default,,0,0,0,,Маекава резиденциясында киім ауыстырдыңыз ба?
Dialogue: 0,0:14:51.14,0:14:52.72,Default,,0,0,0,,Амансыңдар деп үміттенемін.
Dialogue: 0,0:14:52.80,0:14:55.97,Default,,0,0,0,,Айтпақшы, күдікті біреуді көрдіңіз бе?
Dialogue: 0,0:14:57.52,0:14:59.06,Default,,0,0,0,,Ештеңеге қарамаңыз
Dialogue: 0,0:14:59.14,0:15:03.86,Default,,0,0,0,,Әкем мен балам құлағымызды жауып, көзімізді жұмып қалды.
Dialogue: 0,0:15:03.94,0:15:05.23,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,0:15:06.98,0:15:08.69,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:09.65,0:15:11.20,Default,,0,0,0,,Юбо жарақат алды ма?
Dialogue: 0,0:15:12.36,0:15:15.33,Default,,0,0,0,,Иә, кішкене аяқ.
Dialogue: 0,0:15:15.41,0:15:17.33,Default,,0,0,0,,- (Окита) Бұл... - (Мияби) Ах!
Dialogue: 0,0:15:17.41,0:15:21.33,Default,,0,0,0,,Мүмкін сол кезде менің қылышым...
Dialogue: 0,0:15:21.42,0:15:23.33,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:15:23.42,0:15:27.34,Default,,0,0,0,,Ол бірнеше күннен кейін аймақты айналып өтуі керек.
Dialogue: 0,0:15:30.01,0:15:30.84,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:15:34.35,0:15:37.68,Default,,0,0,0,,Басқа сарбаздар бас ғимаратты тексеріп жатыр.
Dialogue: 0,0:15:37.77,0:15:38.85,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:15:39.56,0:15:41.10,Default,,0,0,0,,Кокомока
Dialogue: 0,0:15:42.98,0:15:44.61,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:15:47.44,0:15:48.61,Default,,0,0,0,,Уф
Dialogue: 0,0:15:48.69,0:15:50.65,Default,,0,0,0,,Әдемі кескіш
Dialogue: 0,0:15:51.70,0:15:53.36,Default,,0,0,0,,Күтілгендей, басқаша.
Dialogue: 0,0:15:53.45,0:15:55.87,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:15:56.53,0:15:58.29,Default,,0,0,0,,Сіз еш жерден табылмайсыз.
Dialogue: 0,0:15:58.37,0:16:01.87,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:16:04.96,0:16:07.34,Default,,0,0,0,,Ешбір жерде жоқ.
Dialogue: 0,0:16:07.42,0:16:09.51,Default,,0,0,0,,Мибу-дера храмына да назар аударайық.
Dialogue: 0,0:16:12.63,0:16:13.84,Default,,0,0,0,,Асано
Dialogue: 0,0:16:13.93,0:16:16.51,Default,,0,0,0,,Бұрынғы «басқа» деген нені білдіреді?
Dialogue: 0,0:16:18.47,0:16:20.31,Default,,0,0,0,,Яги тұқымдасының қалдықтары
Dialogue: 0,0:16:21.35,0:16:23.44,Default,,0,0,0,,Менің ойымша, бұл шебердің қолынан шыққан.
Dialogue: 0,0:16:23.52,0:16:26.02,Default,,0,0,0,,Ұстаз! Маған солай көрінеді.
Dialogue: 0,0:16:26.11,0:16:27.82,Default,,0,0,0,,Олар мені өлтірді.
Dialogue: 0,0:16:27.90,0:16:30.15,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:16:31.03,0:16:34.32,Default,,0,0,0,,Серизава мырзаның соңғы соққысы бөлек.
Dialogue: 0,0:16:34.41,0:16:35.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:35.36,0:16:39.28,Default,,0,0,0,,Мойыннан кеуде тұсына соққы қол шабуылы емес.
Dialogue: 0,0:16:39.37,0:16:40.41,Default,,0,0,0,,Не!?
Dialogue: 0,0:16:40.49,0:16:42.33,Default,,0,0,0,,Хиджиката мырза мен Окита мырза
Dialogue: 0,0:16:42.41,0:16:46.29,Default,,0,0,0,,Оны директор Кондо жасаған.
Dialogue: 0,0:16:46.38,0:16:48.92,Default,,0,0,0,,Сонда оны кім өлтіргенін айтасың ба?
Dialogue: 0,0:16:49.00,0:16:51.17,Default,,0,0,0,,Мен оны Чошу деп атамайды деп ойлаймын.
Dialogue: 0,0:16:51.26,0:16:53.34,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:16:53.92,0:16:55.55,Default,,0,0,0,,- (Ямазаки) Міне болды - (Асано/Хаяши) Ах.
Dialogue: 0,0:16:56.68,0:16:57.80,Default,,0,0,0,,?
Dialogue: 0,0:16:58.89,0:17:02.81,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:17:02.89,0:17:06.15,Default,,0,0,0,,Эй, жақсысың ба? Біреу жасады ма?
Dialogue: 0,0:17:10.32,0:17:11.15,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:17:11.23,0:17:13.90,Default,,0,0,0,,Мықты болыңыз! Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:13.99,0:17:15.86,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:17:15.95,0:17:17.41,Default,,0,0,0,,Сонда не істеп жатырсың?
Dialogue: 0,0:17:18.87,0:17:23.04,Default,,0,0,0,,Маған жаңбыр аздап соғылып кеткендей болды...
Dialogue: 0,0:17:23.12,0:17:24.50,Default,,0,0,0,,Жыл бойы!
Dialogue: 0,0:17:24.58,0:17:26.08,Default,,0,0,0,,Әзірше сол жаққа барыңыз.
Dialogue: 0,0:17:29.63,0:17:31.00,Default,,0,0,0,,Ақ ыстық су
Dialogue: 0,0:17:31.09,0:17:33.63,Default,,0,0,0,,Мен ғибадатхананың діни қызметкерін оятып, оны дайындадым.
Dialogue: 0,0:17:33.71,0:17:34.55,Default,,0,0,0,,Ішіңіз
Dialogue: 0,0:17:34.63,0:17:36.55,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:44.77,0:17:46.77,Default,,0,0,0,,А... дәмді
Dialogue: 0,0:17:49.10,0:17:51.19,Default,,0,0,0,,Сізге бірдеңе болды ма?
Dialogue: 0,0:17:51.27,0:17:52.48,Default,,0,0,0,,Эй
Dialogue: 0,0:17:52.57,0:17:53.90,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:17:57.45,0:17:58.41,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:17:59.66,0:18:01.16,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:07.87,0:18:10.17,Default,,0,0,0,,Директор Серизаваға шабуыл жасалған сияқты.
Dialogue: 0,0:18:12.63,0:18:14.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:16.05,0:18:17.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:18.76,0:18:21.01,Default,,0,0,0,,Мені біраз уақытқа қалдырыңызшы.
Dialogue: 0,0:18:24.60,0:18:27.35,Default,,0,0,0,,Әй, не? Кенеттен не болды?
Dialogue: 0,0:18:27.43,0:18:29.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:29.44,0:18:31.86,Default,,0,0,0,,Қайда бара жатырсың? Әй, Асано!
Dialogue: 0,0:18:32.56,0:18:34.65,Default,,0,0,0,,Мен Хиджиката мырзаға барып кеңес беремін.
Dialogue: 0,0:18:36.11,0:18:37.53,Default,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:18:37.61,0:18:39.99,Default,,0,0,0,,Бұған жол беруге болмайды!
Dialogue: 0,0:18:41.32,0:18:45.12,Default,,0,0,0,,Олар оны қараңғыда көмуге тырысады, оны қолдарында ұстаңыз.
Dialogue: 0,0:18:45.20,0:18:47.00,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:18:48.58,0:18:50.87,Default,,0,0,0,,Мен өлтіремін
Dialogue: 0,0:18:50.96,0:18:52.17,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:18:52.25,0:18:55.30,Default,,0,0,0,,Мен Киотоны қорғағым келгендіктен дәрігер болдым.
Dialogue: 0,0:18:55.38,0:18:58.34,Default,,0,0,0,,Осыны ескере отырып, мен Миброға өтініш бердім!
Dialogue: 0,0:18:59.84,0:19:04.18,Default,,0,0,0,,Таң қаларлықтай қыңырсың, Асано-сенсэй.
Dialogue: 0,0:19:04.26,0:19:06.31,Default,,0,0,0,,Сіз қаталсыз ба?
Dialogue: 0,0:19:06.39,0:19:08.77,Default,,0,0,0,,Сіз қателесесіз, Хаяши мырза.
Dialogue: 0,0:19:10.35,0:19:12.69,Default,,0,0,0,,Біз инспектор боламыз!
Dialogue: 0,0:19:12.77,0:19:16.28,Default,,0,0,0,,Сіздің миссияңыз шындықты ашу емес пе?
Dialogue: 0,0:19:17.36,0:19:19.28,Default,,0,0,0,,Сонда кім құтқарылады?
Dialogue: 0,0:19:19.36,0:19:20.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:21.28,0:19:25.74,Default,,0,0,0,,Оның бұл іске қандай да бір қатысы бар шығар.
Dialogue: 0,0:19:26.24,0:19:28.91,Default,,0,0,0,,Күйіп қалсаңыз, не болады?
Dialogue: 0,0:19:29.00,0:19:31.92,Default,,0,0,0,,Не... не болады...
Dialogue: 0,0:19:32.00,0:19:35.92,Default,,0,0,0,,Шындықты ашу ешкімді құтқармайды.
Dialogue: 0,0:19:37.63,0:19:38.92,Default,,0,0,0,,Өтірік айту жаман
Dialogue: 0,0:19:39.01,0:19:40.17,Default,,0,0,0,,Жалпы теория және
Dialogue: 0,0:19:41.05,0:19:42.18,Default,,0,0,0,,Бұл сыбайлас.
Dialogue: 0,0:19:42.26,0:19:43.55,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:19:43.64,0:19:46.56,Default,,0,0,0,,Мен... Мен бұрынғы дәрігермін.
Dialogue: 0,0:19:46.64,0:19:49.56,Default,,0,0,0,,Мен қазір адамдар туралы айтып отырмын.
Dialogue: 0,0:19:50.81,0:19:53.06,Default,,0,0,0,,Сен үшін, достарың үшін.
Dialogue: 0,0:19:53.81,0:19:56.11,Default,,0,0,0,,Сіздің...
Dialogue: 0,0:19:56.19,0:19:58.98,Default,,0,0,0,,Шынымды айтсам, мен Мибро туралы ештеңе білмеймін.
Dialogue: 0,0:19:59.07,0:20:01.07,Default,,0,0,0,,Хиджиката да бәрібір.
Dialogue: 0,0:20:01.82,0:20:06.45,Default,,0,0,0,,Бірақ бір нәрсе анық: Иә, бұл рас.
Dialogue: 0,0:20:06.53,0:20:10.62,Default,,0,0,0,,Сіз дұрыс нәрсе үшін жылап, дұрыс нәрсеге ашулана аласыз.
Dialogue: 0,0:20:11.12,0:20:14.58,Default,,0,0,0,,Тексеруші болып бірге жұмыс істей отырып, мен солай ойладым.
Dialogue: 0,0:20:16.75,0:20:19.34,Default,,0,0,0,,Мен оның жағында болғым келеді.
Dialogue: 0,0:20:20.51,0:20:21.84,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:20:26.64,0:20:28.47,Default,,0,0,0,,Енді шешейік.
Dialogue: 0,0:20:29.06,0:20:32.85,Default,,0,0,0,,Біз инспекторлар ретінде осы үрдісті ұстануымыз керек пе?
Dialogue: 0,0:20:36.52,0:20:39.36,Default,,0,0,0,,Эй Асано, күте тұр!
Dialogue: 0,0:20:40.94,0:20:42.57,Default,,0,0,0,,Менің жұмысым бар.
Dialogue: 0,0:20:42.65,0:20:43.90,Default,,0,0,0,,​​О?
Dialogue: 0,0:20:46.62,0:20:49.33,Default,,0,0,0,,Есепті жіберіңіз.
Dialogue: 0,0:20:51.66,0:20:52.91,Default,,0,0,0,,Сейана
Dialogue: 0,0:20:53.87,0:20:54.83,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:21:13.02,0:21:14.23,Default,,0,0,0,,Бітті, солай емес пе?
Dialogue: 0,0:21:15.23,0:21:16.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:18.36,0:21:20.19,Default,,0,0,0,,Қазір басталады
Dialogue: 0,0:21:20.69,0:21:22.28,Default,,0,0,0,,Серизава ше?
Dialogue: 0,0:21:22.36,0:21:24.24,Default,,0,0,0,,Әйтеуір бәрі ойдағыдай болды.
Dialogue: 0,0:21:24.32,0:21:25.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:25.86,0:21:28.99,Default,,0,0,0,,Шимада Хирама үшін жақсы жұмыс істейді.
Dialogue: 0,0:21:29.83,0:21:33.37,Default,,0,0,0,,Нагакура мырза да сіздің уақытыңызды алған сияқты.
Dialogue: 0,0:21:36.04,0:21:38.88,Default,,0,0,0,,Ол ақыры тоқтады ма?
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:16.64,0:23:20.94,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.65,0:23:23.52,Default,,0,0,0,,Бұл Чиринуни.
Dialogue: 0,0:23:23.61,0:23:27.73,Default,,0,0,0,,Нөсер жаңбырда таулар бұлыңғыр көрінді.
Dialogue: 0,0:23:28.65,0:23:31.70,Default,,0,0,0,,Бұл дүние шексіз қатыгез.
Dialogue: 0,0:23:31.78,0:23:35.62,Default,,0,0,0,,Бірақ... Сонда да біз, Мибро,
Dialogue: 0,0:23:35.70,0:23:37.99,Default,,0,0,0,,Біз алға жылжуымыз керек.
Dialogue: 0,0:23:38.83,0:23:40.79,Default,,0,0,0,,Макото туына бағынбай
Dialogue: 0,0:23:40.87,0:23:44.50,Default,,0,0,0,,Киото қаласы үшін және әлсіздер үшін өмір сүру
Dialogue: 0,0:23:45.04,0:23:46.63,Default,,0,0,0,,Мен осылай ант бердім.
Dialogue: 0,0:23:47.21,0:23:48.05,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:49.55,0:23:55.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
