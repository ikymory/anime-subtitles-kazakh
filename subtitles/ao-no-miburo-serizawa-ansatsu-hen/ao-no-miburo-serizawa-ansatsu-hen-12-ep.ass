Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:04.37,Default,,0,0,0,,Артқы бөлмеде?
Dialogue: 0,0:00:06.17,0:00:07.04,Default,,0,0,0,,Ах
Dialogue: 0,0:00:07.13,0:00:08.38,Default,,0,0,0,,Ол мұнда болмады.
Dialogue: 0,0:00:08.46,0:00:10.88,Default,,0,0,0,,Қайда бардың, ақымақ?
Dialogue: 0,0:00:10.96,0:00:13.84,Default,,0,0,0,,Ол сыртқа жүгіріп шыққан шығар.
Dialogue: 0,0:00:13.93,0:00:15.39,Default,,0,0,0,,Бұл жаман, Хиджиката-сан.
Dialogue: 0,0:00:16.05,0:00:17.89,Default,,0,0,0,,Бұл жағдайда мүмкін емес
Dialogue: 0,0:00:20.47,0:00:22.89,Default,,0,0,0,,Маған біреу жол көрсетуші бере ме?
Dialogue: 0,0:00:32.53,0:00:33.82,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:00:33.90,0:00:36.95,Default,,0,0,0,,(Серизаваның ауыр тыныс алуы)
Dialogue: 0,0:00:38.12,0:00:39.28,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:00:40.04,0:00:45.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:04.91,0:02:09.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:14.00,0:02:16.92,Default,,0,0,0,,Хой хоре~ О, йотто~ Хэй!
Dialogue: 0,0:02:14.00,0:02:16.92,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:02:16.92,0:02:17.01,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:02:17.01,0:02:20.01,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:02:17.01,0:02:20.01,Default,,0,0,0,,Мынау, анау...
Dialogue: 0,0:02:20.01,0:02:21.05,Default,,0,0,0,,Анау, анау...
Dialogue: 0,0:02:21.14,0:02:23.76,Default,,0,0,0,,Би де, биле!
Dialogue: 0,0:02:34.32,0:02:35.53,Default,,0,0,0,,Ямануна
Dialogue: 0,0:02:38.32,0:02:40.41,Default,,0,0,0,,Қарлығаш ұшады
Dialogue: 0,0:02:41.36,0:02:46.29,Default,,0,0,0,,(Серизаваның ауыр тыныс алуы)
Dialogue: 0,0:02:51.67,0:02:55.30,Default,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:02:56.21,0:03:00.30,Default,,0,0,0,,Бүркітті қашуға тырысып жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:03:01.18,0:03:03.64,Default,,0,0,0,,Бұл Серизава үйрегі
Dialogue: 0,0:03:03.72,0:03:06.76,Default,,0,0,0,,Маған қашып, аман қалсын дейсің бе?
Dialogue: 0,0:03:07.89,0:03:10.69,Default,,0,0,0,,Бақытты өмір сүру үшін не істеуім керек?
Dialogue: 0,0:03:10.77,0:03:12.31,Default,,0,0,0,,Не қалды?
Dialogue: 0,0:03:12.40,0:03:15.32,Default,,0,0,0,,Орындалмаған ештеңе қалмады!
Dialogue: 0,0:03:20.19,0:03:24.16,Default,,0,0,0,,Не? неге ойыңа келеді
Dialogue: 0,0:03:24.66,0:03:26.91,Default,,0,0,0,,Балаңыз бар дейсіз бе?
Dialogue: 0,0:03:26.99,0:03:28.54,Default,,0,0,0,,Мен бұл туралы білмеймін!
Dialogue: 0,0:03:28.62,0:03:31.29,Default,,0,0,0,,Бұл әлемнің самурайлары.
Dialogue: 0,0:03:31.37,0:03:33.83,Default,,0,0,0,,Бір жерде тұру, үй шаруасы болу, т.б.
Dialogue: 0,0:03:33.92,0:03:36.04,Default,,0,0,0,,Менің қолымнан келмейді!
Dialogue: 0,0:03:36.96,0:03:39.96,Default,,0,0,0,,Босанғың келсе, туып, қалағандай өсір.
Dialogue: 0,0:03:40.05,0:03:41.63,Default,,0,0,0,,Ғұндық сандырақ
Dialogue: 0,0:03:44.22,0:03:48.14,Default,,0,0,0,,Мен дүниеге келсем, өмір сүрсем, өссем
Dialogue: 0,0:03:48.93,0:03:52.64,Default,,0,0,0,,Мен олармен бірдей екеніне сенімдімін.
Dialogue: 0,0:03:54.23,0:03:58.98,Default,,0,0,0,,Олардың ішінде бұл ең нашар болды.
Dialogue: 0,0:03:59.48,0:04:03.28,Default,,0,0,0,,Мен қобалжыдым, сенімім жоқ.
Dialogue: 0,0:04:03.36,0:04:05.74,Default,,0,0,0,,Мен әрқашан сәтсіздікке ұшыраймын
Dialogue: 0,0:04:05.82,0:04:09.16,Default,,0,0,0,,Мен адамдардың түр-түсіне ғана қараймын.
Dialogue: 0,0:04:10.41,0:04:15.08,Default,,0,0,0,,Шамамен Серизава Камоның «Хан бейнесінен» алыс.
Dialogue: 0,0:04:18.38,0:04:21.30,Default,,0,0,0,,Уф, мен ренжіп барамын!
Dialogue: 0,0:04:21.38,0:04:24.30,Default,,0,0,0,,Мен сені дәл қазір ұшырып жібергім келеді!
Dialogue: 0,0:04:30.60,0:04:33.31,Default,,0,0,0,,Кел, мен саған шомыламын.
Dialogue: 0,0:04:33.39,0:04:34.31,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:04:38.11,0:04:40.82,Default,,0,0,0,,Өз қалауымен алды...
Dialogue: 0,0:04:40.90,0:04:42.78,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:04:42.86,0:04:45.11,Default,,0,0,0,,Сіз тіпті шай қайната алмайсыз ба?
Dialogue: 0,0:04:45.20,0:04:48.32,Default,,0,0,0,,Маған қатал қараған адам...
Dialogue: 0,0:04:48.41,0:04:51.08,Default,,0,0,0,,Таро, қытырлақырақ жүр.
Dialogue: 0,0:04:51.16,0:04:53.04,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:04:53.12,0:04:55.83,Default,,0,0,0,,Балама көңіл бөле алмадым.
Dialogue: 0,0:04:55.92,0:04:58.71,Default,,0,0,0,,Мен мұны теріс көзқарастан деп ойладым.
Dialogue: 0,0:05:00.25,0:05:03.38,Default,,0,0,0,,Күнәларымды өтей алсам ғой.
Dialogue: 0,0:05:06.59,0:05:12.27,Default,,0,0,0,,Оны бір рет ұстағаным жақсы емес пе еді?
Dialogue: 0,0:05:16.19,0:05:19.06,Default,,0,0,0,,Сіз аман қаласыз ба?
Dialogue: 0,0:05:19.15,0:05:21.61,Default,,0,0,0,,Мұндай болашақ бар ма?
Dialogue: 0,0:05:23.74,0:05:24.90,Default,,0,0,0,,Өмір сүру
Dialogue: 0,0:05:26.24,0:05:27.20,Default,,0,0,0,,Мен өмір сүргім келеді
Dialogue: 0,0:05:27.28,0:05:28.36,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:05:29.03,0:05:29.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:42.75,0:05:46.88,Default,,0,0,0,,Серизава мырза, көп күткеніңізге рахмет.
Dialogue: 0,0:05:52.06,0:05:52.93,Default,,0,0,0,,«Ата» деген кім?
Dialogue: 0,0:05:55.85,0:05:57.06,Default,,0,0,0,,Интервенция
Dialogue: 0,0:06:00.65,0:06:03.57,Default,,0,0,0,,Мен қателеспеймін деп ойлаймын.
Dialogue: 0,0:06:03.65,0:06:05.82,Default,,0,0,0,,Сіз кімге айтып тұрсыз?
Dialogue: 0,0:06:10.74,0:06:12.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:12.58,0:06:17.37,Default,,0,0,0,,Серизава, маған үйректің өлімін көрсет.
Dialogue: 0,0:06:20.96,0:06:22.67,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:06:22.75,0:06:26.17,Default,,0,0,0,,Жоқ, сен не айтып тұрсың?
Dialogue: 0,0:06:26.67,0:06:31.51,Default,,0,0,0,,Бұл сіз қалаған болашақ емес пе?
Dialogue: 0,0:06:32.18,0:06:36.64,Default,,0,0,0,,Кук кук кук…
Dialogue: 0,0:06:36.72,0:06:39.14,Default,,0,0,0,,Фухахахаха
Dialogue: 0,0:06:39.23,0:06:43.98,Default,,0,0,0,,Мен көп күттім, Кондо мырза!
Dialogue: 0,0:06:45.69,0:06:47.28,Default,,0,0,0,,Менің досым қайтыс болды
Dialogue: 0,0:06:47.36,0:06:48.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:49.07,0:06:52.62,Default,,0,0,0,,Егер бұл өлім бірінші болып келсе
Dialogue: 0,0:06:53.70,0:06:55.87,Default,,0,0,0,,Сіз өз-өзіне қол жұмсадыңыз ба?
Dialogue: 0,0:06:55.95,0:06:57.29,Default,,0,0,0,,Иә
Dialogue: 0,0:06:57.37,0:07:00.62,Default,,0,0,0,,Алайда көп нәрсе артта қалды.
Dialogue: 0,0:07:04.79,0:07:06.46,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:06.55,0:07:10.05,Default,,0,0,0,,Жау мен досты да ажырата алмайтының несі!
Dialogue: 0,0:07:12.30,0:07:13.34,Default,,0,0,0,,өту
Dialogue: 0,0:07:13.43,0:07:14.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:21.64,0:07:23.65,Default,,0,0,0,,Өйткені, нағыз самурайлар басқаша.
Dialogue: 0,0:07:23.73,0:07:26.11,Default,,0,0,0,,Мибро Серизава мырзаның арқасында ғана мүмкін!
Dialogue: 0,0:07:26.19,0:07:29.07,Default,,0,0,0,,Да ха ха! Маған қалдырыңыз!
Dialogue: 0,0:07:29.94,0:07:32.82,Default,,0,0,0,,Ол өте зерделі адам болған.
Dialogue: 0,0:07:32.91,0:07:33.74,Default,,0,0,0,,Яманами
Dialogue: 0,0:07:34.78,0:07:36.62,Default,,0,0,0,,Бұл сізге
Dialogue: 0,0:07:37.79,0:07:38.95,Default,,0,0,0,,Ах
Dialogue: 0,0:07:40.04,0:07:41.08,Default,,0,0,0,,Кешіріңіз, бес порция алайын ба?
Dialogue: 0,0:07:41.96,0:07:44.04,Default,,0,0,0,,Мен сіздің суретіңізге бармаймын.
Dialogue: 0,0:07:51.05,0:07:53.22,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:07:53.30,0:07:57.81,Default,,0,0,0,,Ол суретті қанша қашықтыққа салды?
Dialogue: 0,0:07:58.64,0:07:59.81,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:07:59.89,0:08:04.06,Default,,0,0,0,,Оның бізге қатысы жоқ!
Dialogue: 0,0:08:04.15,0:08:07.15,Default,,0,0,0,,Жарайды, тынышталыңыз.
Dialogue: 0,0:08:07.65,0:08:10.23,Default,,0,0,0,,Бұл бізге ғана емес, сізге де...
Dialogue: 0,0:08:10.32,0:08:12.61,Default,,0,0,0,,Жоқ! Мен оны мүлдем жек көремін!
Dialogue: 0,0:08:12.70,0:08:14.57,Default,,0,0,0,,Біз бұл жерден қозғала алмаймыз!
Dialogue: 0,0:08:14.66,0:08:15.91,Default,,0,0,0,,Цк
Dialogue: 0,0:08:16.41,0:08:19.12,Default,,0,0,0,,Өзімшіл болма! Қарғыс атқыр әуесқой!
Dialogue: 0,0:08:19.20,0:08:20.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:20.66,0:08:22.91,Default,,0,0,0,,А... Жоқ, қан бар...
Dialogue: 0,0:08:25.21,0:08:27.71,Default,,0,0,0,,Итосато Фушимиге жіберілді.
Dialogue: 0,0:08:27.79,0:08:29.67,Default,,0,0,0,,Не, Ито-чан?
Dialogue: 0,0:08:29.75,0:08:32.67,Default,,0,0,0,,Бізге қосылыңыз және Киотодан кетіңіз.
Dialogue: 0,0:08:32.76,0:08:37.14,Default,,0,0,0,,Мүмкін болса, неге екеуің бейбіт өмір сүруге тырыспайсыңдар?
Dialogue: 0,0:08:37.72,0:08:39.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:39.72,0:08:41.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:46.98,0:08:49.23,Default,,0,0,0,,Сіз бұл жерден өзіңіз кете аласыз, солай ма?
Dialogue: 0,0:08:50.82,0:08:51.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:53.53,0:08:57.82,Default,,0,0,0,,Миброның тағдыры осы миссияға байланысты.
Dialogue: 0,0:08:57.91,0:09:02.45,Default,,0,0,0,,Біздің қатысуымыз ешқашан жария болмауы керек.
Dialogue: 0,0:09:03.70,0:09:06.04,Default,,0,0,0,,Мен де Хираманың қашып кетуіне жол бере алмаймын.
Dialogue: 0,0:09:06.62,0:09:09.29,Default,,0,0,0,,Мен оны сұрадым, Харада мырза.
Dialogue: 0,0:09:11.09,0:09:13.09,Default,,0,0,0,,Қашпа, Хирама!
Dialogue: 0,0:09:13.17,0:09:16.05,Default,,0,0,0,,Менімен әділ және әділ күрес!
Dialogue: 0,0:09:16.13,0:09:19.10,Default,,0,0,0,,Серизава үшін күрескіңіз келмейді!
Dialogue: 0,0:09:19.18,0:09:20.60,Default,,0,0,0,,Достар!
Dialogue: 0,0:09:20.68,0:09:22.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:23.02,0:09:23.98,Default,,0,0,0,,Ах
Dialogue: 0,0:09:24.81,0:09:26.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:28.81,0:09:30.40,Default,,0,0,0,,Сен жылайсың...
Dialogue: 0,0:09:30.48,0:09:32.11,Default,,0,0,0,,Жақсылығыңның есесін қайтарасың ба?
Dialogue: 0,0:09:32.19,0:09:33.23,Default,,0,0,0,,Не?
Dialogue: 0,0:09:33.32,0:09:34.57,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:09:34.65,0:09:37.49,Default,,0,0,0,,Мибро Серизава мырзаның арқасында бүгінгідей болды.
Dialogue: 0,0:09:37.57,0:09:40.03,Default,,0,0,0,,Сіз нақты мағынасын білмейсіз
Dialogue: 0,0:09:40.12,0:09:43.12,Default,,0,0,0,,Ұстаздан айырылу – ұлттық шығын!
Dialogue: 0,0:09:43.79,0:09:46.12,Default,,0,0,0,,Сіз соншалықты көп айтасыз ба?
Dialogue: 0,0:09:46.21,0:09:50.17,Default,,0,0,0,,Харада: Сіз дұрыс емес адамның соңынан ердіңіз!
Dialogue: 0,0:09:50.25,0:09:52.46,Default,,0,0,0,,Қандай микоши алып жүру керектігін шешіңіз
Dialogue: 0,0:09:52.55,0:09:53.59,Default,,0,0,0,,Хамф!
Dialogue: 0,0:09:53.67,0:09:55.42,Default,,0,0,0,,Ой, бұл кір!
Dialogue: 0,0:09:55.51,0:09:56.67,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:09:56.76,0:09:58.80,Default,,0,0,0,,Уф, не!
Dialogue: 0,0:09:59.64,0:10:03.06,Default,,0,0,0,,Жаман істерің әлемге ашылады.
Dialogue: 0,0:10:03.14,0:10:04.56,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:04.64,0:10:06.23,Default,,0,0,0,,- (Хирама) Те! -(Харада) Уау!
Dialogue: 0,0:10:06.81,0:10:07.73,Default,,0,0,0,,Ах
Dialogue: 0,0:10:07.81,0:10:09.44,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:10:11.31,0:10:12.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:13.94,0:10:19.24,Default,,0,0,0,,(Хараданың ауыр тыныс алуы)
Dialogue: 0,0:10:19.32,0:10:21.99,Default,,0,0,0,,А-а... Қарғыс атқыр, ол қайда?
Dialogue: 0,0:10:22.07,0:10:25.24,Default,,0,0,0,,Жауап беріңіз! Шық, Хирама!
Dialogue: 0,0:10:29.67,0:10:33.59,Default,,0,0,0,,Иә... бұл ақылсыз. Мен оны мүлдем жоғалттым.
Dialogue: 0,0:10:33.67,0:10:35.46,Default,,0,0,0,,- (Хирама) Арх! -(Харада) Ах!
Dialogue: 0,0:10:38.97,0:10:40.38,Default,,0,0,0,,Не болып жатыр? Не болды?
Dialogue: 0,0:10:40.47,0:10:41.84,Default,,0,0,0,,Ах
Dialogue: 0,0:11:03.99,0:11:05.83,Default,,0,0,0,,Бұл не нәрсе...
Dialogue: 0,0:11:06.99,0:11:10.79,Default,,0,0,0,,Шимада, мені абайлап жерлеңіз.
Dialogue: 0,0:11:13.67,0:11:14.92,Default,,0,0,0,,Шинпачи
Dialogue: 0,0:11:15.00,0:11:18.01,Default,,0,0,0,,Мен әдіске көңілім толмайды.
Dialogue: 0,0:11:20.01,0:11:23.01,Default,,0,0,0,,Мен мұны қабіріме апаруым керек.
Dialogue: 0,0:11:24.39,0:11:27.93,Default,,0,0,0,,Біз мұны сізге және өзіңізге қалдыра алмаймыз.
Dialogue: 0,0:11:28.02,0:11:30.94,Default,,0,0,0,,Мен де кінәні бірге көтерейін.
Dialogue: 0,0:11:35.40,0:11:37.44,Default,,0,0,0,,- (Харада) Не болды? -(Нагакура) Жоқ.
Dialogue: 0,0:11:38.15,0:11:40.82,Default,,0,0,0,,Шәкірттерімнің бағыт-бағдары мені алаңдатты.
Dialogue: 0,0:11:41.53,0:11:46.99,Default,,0,0,0,,(семсер дыбысы)
Dialogue: 0,0:11:47.08,0:11:48.95,Default,,0,0,0,,Біз енді ешқашан кездеспейміз.
Dialogue: 0,0:11:50.79,0:11:53.71,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:53.79,0:11:55.71,Default,,0,0,0,,Тым қатты итермеңіз
Dialogue: 0,0:11:55.79,0:11:57.21,Default,,0,0,0,,Уф... Қарғыс атсын!
Dialogue: 0,0:12:00.46,0:12:04.05,Default,,0,0,0,,Серизаваға деген көзқарасыңыз осылай ма?
Dialogue: 0,0:12:04.14,0:12:05.55,Default,,0,0,0,,Уф
Dialogue: 0,0:12:06.26,0:12:07.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:11.10,0:12:11.77,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:12:11.77,0:12:16.02,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:12:11.77,0:12:16.02,Default,,0,0,0,,Өкініштің ізі де қалмас үшін бәрін түкіріңіз.
Dialogue: 0,0:12:16.11,0:12:19.15,Default,,0,0,0,,Мен сізді барлық мүшелеріңіз бен мүшелеріңізден құстырамын.
Dialogue: 0,0:12:22.74,0:12:24.36,Default,,0,0,0,,Бұл Яги резиденциясы.
Dialogue: 0,0:12:24.45,0:12:26.78,Default,,0,0,0,,Бұл Мибродағы біздің негізгі базамыз.
Dialogue: 0,0:12:26.87,0:12:27.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:29.45,0:12:30.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.08,0:12:32.41,Default,,0,0,0,,Бұл Таро.
Dialogue: 0,0:12:32.50,0:12:36.79,Default,,0,0,0,,Мен мұнда көп жұмыс істеп жатырмын...
Dialogue: 0,0:12:37.46,0:12:41.38,Default,,0,0,0,,Мен сені алғаш көргенде жансыз көріндің.
Dialogue: 0,0:12:41.46,0:12:44.38,Default,,0,0,0,,Ол не ойлап тұрғанын білмеді.
Dialogue: 0,0:12:48.47,0:12:49.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:49.39,0:12:51.14,Default,,0,0,0,,Ішуге барайық
Dialogue: 0,0:12:51.22,0:12:52.81,Default,,0,0,0,,Серизавадан кейін
Dialogue: 0,0:12:52.89,0:12:55.64,Default,,0,0,0,,Мен сенің соңынан иттей еріп жүргенімде...
Dialogue: 0,0:12:52.89,0:12:55.64,Default,,0,0,0,,Мұғалім! Мен... хаори киемін.
Dialogue: 0,0:12:56.15,0:12:56.90,Default,,0,0,0,,Тез айт!
Dialogue: 0,0:12:56.90,0:12:57.35,Default,,0,0,0,,Тез айт!
Dialogue: 0,0:12:56.90,0:12:57.35,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:57.35,0:12:57.44,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:57.44,0:12:58.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:57.44,0:12:58.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:58.11,0:12:58.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:58.65,0:13:02.19,Default,,0,0,0,,Білмей тұрып, тынбай еңбек еттім.
Dialogue: 0,0:13:06.82,0:13:08.70,Default,,0,0,0,,Менікі де болады.
Dialogue: 0,0:13:10.08,0:13:11.95,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:13:14.83,0:13:17.25,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:13:18.67,0:13:22.25,Default,,0,0,0,,Ол сахнаның артында Серизавадан басқалардың бәріне у шашып тұрды.
Dialogue: 0,0:13:23.13,0:13:24.80,Default,,0,0,0,,Мен келген соң...
Dialogue: 0,0:13:25.34,0:13:27.84,Default,,0,0,0,,Таромен арнайы сумо жаттығуларын өткізгіңіз келе ме?
Dialogue: 0,0:13:27.93,0:13:30.01,Default,,0,0,0,,- (Таро) Бұлай етпе! -Хмф
Dialogue: 0,0:13:30.64,0:13:32.43,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:13:32.52,0:13:35.02,Default,,0,0,0,,Одан да жанды болып көрінді.
Dialogue: 0,0:13:35.85,0:13:38.15,Default,,0,0,0,,Меніңше, оның қылыш қолдануға деген ынтасы жоқ еді.
Dialogue: 0,0:13:38.23,0:13:39.36,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:13:41.15,0:13:44.19,Default,,0,0,0,,Мен жақында Нагакурадан қылыш үйренуді бастадым.
Dialogue: 0,0:13:45.11,0:13:46.24,Default,,0,0,0,,Шынайы нұсқасын осыншама мінсіз қайта жасай алатынын елестете алмаймын.
Dialogue: 0,0:13:48.07,0:13:49.37,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:13:49.45,0:13:53.29,Default,,0,0,0,,Білік те дірілдеп тұр, мен оны қолыммен шайқаймын.
Dialogue: 0,0:13:54.12,0:13:57.29,Default,,0,0,0,,Менің әлі де дайындығым жоқ.
Dialogue: 0,0:13:57.37,0:13:58.29,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:13:59.88,0:14:00.42,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:14:00.42,0:14:03.55,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:14:00.42,0:14:03.55,Default,,0,0,0,,Қорғайтын нәрсең болса, соншалықты күшті бола аласың ба?
Dialogue: 0,0:14:06.01,0:14:09.30,Default,,0,0,0,,Менің кетуім керек, Серизава мырза...
Dialogue: 0,0:14:09.39,0:14:10.93,Default,,0,0,0,,Серизава мырза!
Dialogue: 0,0:14:11.01,0:14:12.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:12.35,0:14:14.93,Default,,0,0,0,,Барсаң да, қолыңнан ештеңе келмейді.
Dialogue: 0,0:14:15.02,0:14:17.06,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:14:17.14,0:14:19.65,Default,,0,0,0,,Серизаваға неге соншалықты ерекше қарайсыз?
Dialogue: 0,0:14:19.73,0:14:23.73,Default,,0,0,0,,Дәл солай Яги отбасы мен Кондо жігіттеріне де қатысты.
Dialogue: 0,0:14:23.82,0:14:26.03,Default,,0,0,0,,Сіз маған жақсы қарауыңыз керек!
Dialogue: 0,0:14:27.19,0:14:28.95,Default,,0,0,0,,...
Dialogue: 0,0:14:29.61,0:14:30.61,Default,,0,0,0,,Мен де
Dialogue: 0,0:14:30.70,0:14:32.95,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:14:33.53,0:14:34.95,Default,,0,0,0,,Мұғалім...
Dialogue: 0,0:14:37.04,0:14:41.71,Default,,0,0,0,,үшінның алдынан шыққанда, бір сәт үзіліс болады.
Dialogue: 0,0:14:41.79,0:14:43.21,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:14:44.88,0:14:48.97,Default,,0,0,0,,Мұғалім Серизаваның үйрек боп кеткен кезі еді.
Dialogue: 0,0:14:54.56,0:14:56.97,Default,,0,0,0,,Артынан келе жатқан мен ғана білдім.
Dialogue: 0,0:14:57.68,0:15:00.35,Default,,0,0,0,,Маған бұл адам ұнайды.
Dialogue: 0,0:15:00.44,0:15:02.06,Default,,0,0,0,,Мен құрметтеймін
Dialogue: 0,0:15:03.65,0:15:06.11,Default,,0,0,0,,Маған үлкен топтарда шулаған ұнайды.
Dialogue: 0,0:15:06.19,0:15:08.99,Default,,0,0,0,,Бәріміз бірге ішіп-жейік
Dialogue: 0,0:15:09.07,0:15:11.99,Default,,0,0,0,,Ол шынымен бақытты көрінді.
Dialogue: 0,0:15:16.08,0:15:18.87,Default,,0,0,0,,Мені қаншама адам қоршап алды.
Dialogue: 0,0:15:18.95,0:15:20.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:21.71,0:15:25.38,Default,,0,0,0,,Бірақ мен жалғыз өлетініме сенімдімін.
Dialogue: 0,0:15:28.21,0:15:29.80,Default,,0,0,0,,Бір адам туралы...
Dialogue: 0,0:15:31.13,0:15:34.35,Default,,0,0,0,,Мен болсам да, соңына дейін артымнан жүре аласыз, солай ма?
Dialogue: 0,0:15:35.22,0:15:36.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:39.73,0:15:42.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:43.31,0:15:45.02,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:15:45.61,0:15:48.03,Default,,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,0:15:48.11,0:15:52.03,Default,,0,0,0,,(Тароның ауыр тыныс алуы)
Dialogue: 0,0:15:52.11,0:15:54.74,Default,,0,0,0,,Менде енді күш жоқ
Dialogue: 0,0:15:54.82,0:15:56.53,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:15:57.24,0:15:58.37,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:00.37,0:16:01.33,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:16:01.41,0:16:05.29,Default,,0,0,0,,Нақты орындау кезінде қылышты мүмкіндігінше қысқа ұстаңыз.
Dialogue: 0,0:16:05.38,0:16:09.71,Default,,0,0,0,,Ми... қысқа? Бірақ бұл сізге жетпейді
Dialogue: 0,0:16:09.80,0:16:12.30,Default,,0,0,0,,Егер сіз мұны істесеңіз, сіз үлкен кемшілікке ұшырайсыз, солай ма?
Dialogue: 0,0:16:12.38,0:16:15.80,Default,,0,0,0,,Жақсы, сосын төбелес.
Dialogue: 0,0:16:15.89,0:16:18.31,Default,,0,0,0,,Мұнда бір ғана қарлығаш бар
Dialogue: 0,0:16:18.39,0:16:21.10,Default,,0,0,0,,Бұл жағдайға арналған жем.
Dialogue: 0,0:16:23.35,0:16:24.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:27.86,0:16:30.99,Default,,0,0,0,,Нагакура Мен оны қолданамын.
Dialogue: 0,0:16:35.16,0:16:37.53,Default,,0,0,0,,Бұл қандай ұстаным?
Dialogue: 0,0:16:37.62,0:16:40.24,Default,,0,0,0,,Сіз сахнаның артында бірдеңе жасауға тырысасыз ба? Ақымақ
Dialogue: 0,0:16:41.25,0:16:43.50,Default,,0,0,0,,Мен сізге бұл қашықтықта жете алмаймын
Dialogue: 0,0:16:43.58,0:16:46.04,Default,,0,0,0,,Араларыңыздағы қашықтықты да білмейсіз бе?
Dialogue: 0,0:16:46.75,0:16:49.17,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:49.25,0:16:51.05,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз.
Dialogue: 0,0:16:52.55,0:16:53.88,Default,,0,0,0,,Бұл Таро.
Dialogue: 0,0:16:53.97,0:16:57.68,Default,,0,0,0,,Ол Серизаваға соңына дейін қызмет етуге ниетті.
Dialogue: 0,0:16:58.51,0:17:00.85,Default,,0,0,0,,Кіріспе Бұл сіздің жұмысыңыз.
Dialogue: 0,0:17:00.93,0:17:02.98,Default,,0,0,0,,Оны өлтіргенімді қалайсың ба?
Dialogue: 0,0:17:03.06,0:17:04.10,Default,,0,0,0,,Қалжың емес.
Dialogue: 0,0:17:04.18,0:17:06.06,Default,,0,0,0,,Олай болса, Хиджиката, сен мені өлтіруің керек!
Dialogue: 0,0:17:06.15,0:17:08.36,Default,,0,0,0,,Мен Серизаваны өлтіремін!
Dialogue: 0,0:17:08.44,0:17:09.77,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:11.15,0:17:11.98,Default,,0,0,0,,Не?
Dialogue: 0,0:17:14.65,0:17:16.74,Default,,0,0,0,,Тароны сақтаңыз.
Dialogue: 0,0:17:18.53,0:17:20.95,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:17:21.70,0:17:23.20,Default,,0,0,0,,Жаңбыр көп жауады.
Dialogue: 0,0:17:23.29,0:17:24.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:25.29,0:17:26.83,Default,,0,0,0,,Түнде тоқтай ма?
Dialogue: 0,0:17:26.92,0:17:28.83,Default,,0,0,0,,Саана
Dialogue: 0,0:17:31.42,0:17:34.05,Default,,0,0,0,,Маған Таро-кун туралы айтып беріңізші.
Dialogue: 0,0:17:34.13,0:17:35.09,Default,,0,0,0,,Га
Dialogue: 0,0:17:38.43,0:17:40.60,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:17:40.68,0:17:43.56,Default,,0,0,0,,Бұған осы да кіреді.
Dialogue: 0,0:17:46.69,0:17:48.81,Default,,0,0,0,,Ол кек алады!
Dialogue: 0,0:17:52.40,0:17:54.15,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:54.23,0:17:57.61,Default,,0,0,0,,Жаттығуды кеше мен бүгін бастаған шебер дұрыс орындаса да.
Dialogue: 0,0:17:57.70,0:17:59.32,Default,,0,0,0,,Шеберді жеңе алмайсың
Dialogue: 0,0:18:00.37,0:18:05.83,Default,,0,0,0,,Біраз шайқассаң, жау сенің қашықтығыңды өлшеп алатыны сөзсіз.
Dialogue: 0,0:18:05.91,0:18:10.83,Default,,0,0,0,,Сондықтан қолдарыңызды көрсетпеңіз және оң қолыңызды төмен қарай жылжытыңыз.
Dialogue: 0,0:18:10.92,0:18:12.21,Default,,0,0,0,,Ах
Dialogue: 0,0:18:12.29,0:18:15.42,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:18:15.51,0:18:19.34,Default,,0,0,0,,Бұл сенің қылышыңды бір жұдырықтай ұзартады.
Dialogue: 0,0:18:20.30,0:18:23.76,Default,,0,0,0,,Жасасаң, қарлығаш міндетті түрде ұшады
Dialogue: 0,0:18:32.98,0:18:34.27,Default,,0,0,0,,Қарлығаш
Dialogue: 0,0:18:41.95,0:18:44.12,Default,,0,0,0,,... жойылды!
Dialogue: 0,0:18:44.20,0:18:45.24,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:47.45,0:18:52.13,Default,,0,0,0,,Егер сіз бірінші қадам жасасаңыз, ойланбастан қайтып келу үшін семсерді пайдаланыңыз.
Dialogue: 0,0:18:52.21,0:18:53.88,Default,,0,0,0,,Денеңізбен есте сақтаңыз
Dialogue: 0,0:18:54.50,0:18:56.46,Default,,0,0,0,,Реакция арқылы қашып құтылу
Dialogue: 0,0:18:56.96,0:19:00.55,Default,,0,0,0,,Сол жалғыз қылыш сені қорғайды.
Dialogue: 0,0:19:02.47,0:19:03.76,Default,,0,0,0,,Қарсы күрес
Dialogue: 0,0:19:03.85,0:19:05.64,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:19:06.35,0:19:07.64,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:19:08.73,0:19:10.64,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:19:10.73,0:19:12.65,Default,,0,0,0,,Додж!
Dialogue: 0,0:19:16.23,0:19:18.65,Default,,0,0,0,,Даа!
Dialogue: 0,0:19:20.74,0:19:22.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:26.24,0:19:27.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:27.66,0:19:31.54,Default,,0,0,0,,Тым кеш, тым кеш, Кондо мырза.
Dialogue: 0,0:19:32.17,0:19:35.04,Default,,0,0,0,,Енді мұны артқа қояйық.
Dialogue: 0,0:19:36.04,0:19:38.30,Default,,0,0,0,,Иә, Серизава мырза.
Dialogue: 0,0:19:38.38,0:19:41.30,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:19:41.38,0:19:43.51,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:19:44.97,0:19:46.72,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:19:50.02,0:19:51.10,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:51.19,0:19:52.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:56.27,0:19:59.19,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:20:00.11,0:20:04.53,Default,,0,0,0,,Кондо мырза күткендей, мұны жасамаңыз.
Dialogue: 0,0:20:13.12,0:20:13.96,Default,,0,0,0,,Ниими мырза
Dialogue: 0,0:20:14.92,0:20:16.96,Default,,0,0,0,,Соңғы бір нәрсе, жарай ма?
Dialogue: 0,0:20:17.04,0:20:22.05,Default,,0,0,0,,Серизава мырза екеуің ұзақ уақыт бойы жаман істермен айналыстыңдар.
Dialogue: 0,0:20:22.13,0:20:26.72,Default,,0,0,0,,Серизава мырза тез жалықтырады, қиындық тудырады және келесі орынға көшеді.
Dialogue: 0,0:20:27.47,0:20:29.35,Default,,0,0,0,,Бірақ сізде Кио бар...
Dialogue: 0,0:20:29.97,0:20:32.48,Default,,0,0,0,,Мибро оған ғашық болғанын айтты.
Dialogue: 0,0:20:32.56,0:20:34.73,Default,,0,0,0,,Мен осында тағы біраз қалғым келеді.
Dialogue: 0,0:20:35.31,0:20:39.36,Default,,0,0,0,,Миброның бұрынғыдан қандай айырмашылығы болды?
Dialogue: 0,0:20:41.40,0:20:43.20,Default,,0,0,0,,Серизава басқаша болды
Dialogue: 0,0:20:44.61,0:20:45.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:45.57,0:20:49.79,Default,,0,0,0,,Жеңіл, көп күлетін, менің сүйіктім болатын.
Dialogue: 0,0:20:50.74,0:20:55.87,Default,,0,0,0,,Бірінші рет қасымда біреу тұрды, иығымдағы жүк жеңілірек болған шығар.
Dialogue: 0,0:20:58.96,0:21:00.96,Default,,0,0,0,,Яғни...
Dialogue: 0,0:21:01.05,0:21:01.88,Default,,0,0,0,,О
Dialogue: 0,0:21:04.01,0:21:06.18,Default,,0,0,0,,Ол жігітке алғыстан басқа ештеңем жоқ.
Dialogue: 0,0:21:06.97,0:21:11.81,Default,,0,0,0,,(Серизаваның ауыр тыныс алуы)
Dialogue: 0,0:21:17.15,0:21:18.86,Default,,0,0,0,,Гррр…
Dialogue: 0,0:21:19.73,0:21:22.86,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:23.78,0:21:24.61,Default,,0,0,0,,Құт
Dialogue: 0,0:21:25.86,0:21:28.99,Default,,0,0,0,,Жоқ, оны соңына дейін көру керек.
Dialogue: 0,0:21:30.49,0:21:32.41,Default,,0,0,0,,Соңына дейін қараңыз
Dialogue: 0,0:21:32.49,0:21:34.12,Default,,0,0,0,,Өмір бойы ұмытпа
Dialogue: 0,0:21:35.75,0:21:37.62,Default,,0,0,0,,Бұл Серизава мырза.
Dialogue: 0,0:21:42.71,0:21:43.88,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:21:44.63,0:21:46.38,Default,,0,0,0,,Серизава Камо
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:16.64,0:23:20.94,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.10,0:23:25.40,Default,,0,0,0,,Ниими... Жоқ, Иори.
Dialogue: 0,0:23:25.48,0:23:27.32,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:23:27.40,0:23:29.32,Default,,0,0,0,,Сізге уәде етілгендей
Dialogue: 0,0:23:29.40,0:23:34.62,Default,,0,0,0,,Бұл Серизава Камо. Соңы жақындап қалды.
Dialogue: 0,0:23:34.70,0:23:37.91,Default,,0,0,0,,Өкінбеймін Өкінбеймін
Dialogue: 0,0:23:37.99,0:23:41.12,Default,,0,0,0,,Орындалмаған ештеңе қалмады.
Dialogue: 0,0:23:41.21,0:23:43.63,Default,,0,0,0,,Сіз қарап отырсыз ба?
Dialogue: 0,0:23:43.71,0:23:47.13,Default,,0,0,0,,Бұл мен ең қалайтын болашақ.
Dialogue: 0,0:23:47.21,0:23:48.05,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:49.55,0:23:55.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
