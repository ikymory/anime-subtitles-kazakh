Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.87,0:00:08.80,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:16.89,0:00:17.97,Default,,0,0,0,,Бұл кенет, бірақ...
Dialogue: 0,0:00:19.76,0:00:21.98,Default,,0,0,0,,Маған Шигурэ-чан ұнайды
Dialogue: 0,0:00:22.06,0:00:24.98,Default,,0,0,0,,Бәрі сәтсіз болды (Сигуре) Хехехе...
Dialogue: 0,0:00:25.85,0:00:26.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:27.40,0:00:28.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:28.73,0:00:29.98,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:00:30.07,0:00:31.65,Default,,0,0,0,,Ааа~
Dialogue: 0,0:00:31.74,0:00:33.49,Default,,0,0,0,,Мен Шигурэ-чанмен сөйлескім келеді
Dialogue: 0,0:00:40.58,0:00:44.87,Default,,0,0,0,,Ал мен әрқашан Шигурэ-чан туралы қиялдаймын.
Dialogue: 0,0:00:46.79,0:00:53.80,Default,,0,0,0,,(Хинуга мен Шигуренің күлкісі)
Dialogue: 0,0:00:53.88,0:00:59.72,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:01:21.20,0:01:22.79,Default,,0,0,0,,Shigure Shigure
Dialogue: 0,0:01:22.87,0:01:24.04,Default,,0,0,0,,Уау
Dialogue: 0,0:01:24.12,0:01:27.17,Default,,0,0,0,,Бір минут күте тұрыңыз, мм...
Dialogue: 0,0:01:27.25,0:01:29.17,Default,,0,0,0,,Күріш күріш
Dialogue: 0,0:01:29.25,0:01:30.54,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:01:38.01,0:01:39.55,Default,,0,0,0,,Уау
Dialogue: 0,0:01:39.64,0:01:42.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:03.66,0:02:06.08,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:02:11.33,0:02:14.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:15.76,0:02:16.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.76,0:02:21.34,Default,,0,0,0,,Хината-кун?
Dialogue: 0,0:02:21.43,0:02:22.76,Default,,0,0,0,,Ах! Уау
Dialogue: 0,0:02:22.85,0:02:24.14,Default,,0,0,0,,Ах
Dialogue: 0,0:02:38.78,0:02:41.11,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:02:41.20,0:02:43.99,Default,,0,0,0,,Келесі жексенбі... (Қыз) Не болып жатыр?
Dialogue: 0,0:02:44.08,0:02:45.62,Default,,0,0,0,,Кинотеатрға бару
Dialogue: 0,0:02:49.71,0:02:52.13,Default,,0,0,0,,Уау, Хината-кун өте жақсы.
Dialogue: 0,0:02:52.54,0:02:53.50,Default,,0,0,0,,Ha
Dialogue: 0,0:02:53.59,0:02:55.13,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:02:55.34,0:02:56.25,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:02:56.34,0:02:59.51,Default,,0,0,0,,Хината-кун мұны өте жақсы біледі.
Dialogue: 0,0:03:03.39,0:03:06.14,Default,,0,0,0,,Эй Хината-кун, маған көбірек көрсетші.
Dialogue: 0,0:03:06.22,0:03:10.14,Default,,0,0,0,,Уаааааааааааа...
Dialogue: 0,0:03:11.14,0:03:15.11,Default,,0,0,0,,Кешіріңіз... Кешіріңіз!
Dialogue: 0,0:03:25.24,0:03:27.79,Default,,0,0,0,,Хмм... Шигурэ-чан
Dialogue: 0,0:03:27.87,0:03:28.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:29.50,0:03:30.50,Default,,0,0,0,,Иә
Dialogue: 0,0:03:31.16,0:03:34.46,Default,,0,0,0,,Иә, Шигурэ-чанның сүйікті аққуы.
Dialogue: 0,0:03:35.75,0:03:36.84,Default,,0,0,0,,Иә, қараңыз.
Dialogue: 0,0:03:36.92,0:03:38.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:39.05,0:03:40.30,Default,,0,0,0,,Хината-кун?
Dialogue: 0,0:03:40.63,0:03:44.68,Default,,0,0,0,,Увааааааааааааааа...
Dialogue: 0,0:03:46.10,0:03:47.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:47.60,0:03:49.68,Default,,0,0,0,,Уау, Шигурэ-чан, кешіріңіз!
Dialogue: 0,0:03:49.77,0:03:52.44,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:03:53.65,0:03:56.69,Default,,0,0,0,,Хината-кун, сен неге менен қашып жүрсің?
Dialogue: 0,0:03:56.77,0:03:58.19,Default,,0,0,0,,Кінә – кінәсіз мысықты сөмкеге салып, осы жерге тастап кеткен адамда.
Dialogue: 0,0:04:00.65,0:04:03.86,Default,,0,0,0,,Хината-кун да құстарды жақсы көреді, солай ма?
Dialogue: 0,0:04:03.95,0:04:06.70,Default,,0,0,0,,Қарсы болмасаң...
Dialogue: 0,0:04:06.78,0:04:11.20,Default,,0,0,0,,Хината-кун да құс қорабына қамқорлық жасап көруі мүмкін деп ойлады.
Dialogue: 0,0:04:11.29,0:04:12.37,Default,,0,0,0,,Хината-кун
Dialogue: 0,0:04:12.46,0:04:13.54,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:04:15.42,0:04:17.29,Default,,0,0,0,,Ей, бірге көрейік.
Dialogue: 0,0:04:17.42,0:04:18.46,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:04:18.54,0:04:19.92,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:20.00,0:04:20.84,Default,,0,0,0,,А, аа!
Dialogue: 0,0:04:20.92,0:04:22.13,Default,,0,0,0,,Уф
Dialogue: 0,0:04:22.22,0:04:23.63,Default,,0,0,0,,Ах (Сигур) Кьяа
Dialogue: 0,0:04:25.64,0:04:28.43,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:04:28.64,0:04:30.22,Default,,0,0,0,,Пами
Dialogue: 0,0:04:30.31,0:04:32.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:38.15,0:04:41.40,Default,,0,0,0,,Қайырлы таң, Шигурэ-чан
Dialogue: 0,0:04:42.15,0:04:43.99,Default,,0,0,0,,Қайырлы таң Хина...
Dialogue: 0,0:04:44.07,0:04:46.41,Default,,0,0,0,,Хината-кун Чак (Хината) Уау! Ах!
Dialogue: 0,0:04:46.49,0:04:47.41,Default,,0,0,0,,(сыдырманың жабылу дыбысы)
Dialogue: 0,0:04:50.37,0:04:52.91,Default,,0,0,0,,Хехе, мына бала сүйкімді екен.
Dialogue: 0,0:04:53.00,0:04:54.54,Default,,0,0,0,,Иә, сен жақсы қызсың.
Dialogue: 0,0:04:54.62,0:04:55.96,Default,,0,0,0,,Күріш күріш
Dialogue: 0,0:04:56.04,0:04:57.46,Default,,0,0,0,,Итте, тістеме.
Dialogue: 0,0:04:57.54,0:04:58.92,Default,,0,0,0,,Уау аа аааа~
Dialogue: 0,0:05:04.13,0:05:05.47,Default,,0,0,0,,Кешіріңіз, Хината-кун.
Dialogue: 0,0:05:05.55,0:05:06.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:06.51,0:05:07.55,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:07.64,0:05:09.43,Default,,0,0,0,,Ой, оны құлатып тастады
Dialogue: 0,0:05:12.89,0:05:14.43,Default,,0,0,0,,Иә (Хината) Рахмет.
Dialogue: 0,0:05:14.52,0:05:16.94,Default,,0,0,0,,Бүгін жұлдыздарға толы.
Dialogue: 0,0:05:17.02,0:05:19.06,Default,,0,0,0,,Сүт жолы сорпасы мен жұлдызды нан
Dialogue: 0,0:05:19.15,0:05:21.15,Default,,0,0,0,,Жұлдызды крокет және танзаку салаты
Dialogue: 0,0:05:21.23,0:05:24.19,Default,,0,0,0,,Жұлдызды желе және жұлдыз шырыны.
Dialogue: 0,0:05:30.95,0:05:32.70,Default,,0,0,0,,Хината-кун керемет
Dialogue: 0,0:05:32.79,0:05:34.33,Default,,0,0,0,,Бачкой
Dialogue: 0,0:05:34.41,0:05:35.62,Default,,0,0,0,,Уау (құлаған дыбыс)
Dialogue: 0,0:05:35.71,0:05:36.71,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:05:40.71,0:05:42.63,Default,,0,0,0,,Қош бол Шигурэ-чан
Dialogue: 0,0:05:42.71,0:05:43.67,Default,,0,0,0,,Уау
Dialogue: 0,0:05:44.30,0:05:46.67,Default,,0,0,0,,Нуааах~
Dialogue: 0,0:05:46.76,0:05:49.84,Default,,0,0,0,,Көзілдірік Көзілдірік…
Dialogue: 0,0:05:52.31,0:05:53.85,Default,,0,0,0,,Иә Көзілдірік
Dialogue: 0,0:05:55.18,0:05:56.14,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.15,0:06:01.94,Default,,0,0,0,,Абайлаңыз, Хината-кун.
Dialogue: 0,0:06:10.28,0:06:11.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:13.83,0:06:19.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:21.67,0:06:24.67,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:06:31.18,0:06:32.35,Default,,0,0,0,,Шак
Dialogue: 0,0:06:34.10,0:06:37.52,Default,,0,0,0,,Ой!
Dialogue: 0,0:06:37.98,0:06:39.44,Default,,0,0,0,,Уау
Dialogue: 0,0:06:39.52,0:06:41.10,Default,,0,0,0,,Yahoo
Dialogue: 0,0:06:41.81,0:06:45.07,Default,,0,0,0,,Мен қандай бақыттымын
Dialogue: 0,0:07:03.63,0:07:06.05,Default,,0,0,0,,(Хиюганың гуілдеуі)
Dialogue: 0,0:07:06.13,0:07:07.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.59,0:07:09.80,Default,,0,0,0,,Ах
Dialogue: 0,0:07:11.55,0:07:13.55,Default,,0,0,0,,Бірақ сол кезде —
Dialogue: 0,0:07:14.60,0:07:17.56,Default,,0,0,0,,Шигурэ-чан жалғыз жылап отырды.
Dialogue: 0,0:07:17.64,0:07:23.06,Default,,0,0,0,,(Сигураның айқайы)
Dialogue: 0,0:07:25.27,0:07:28.32,Default,,0,0,0,,Кешіріңіз, бүгін бір нәрсе істеуім керек, сондықтан мен бірінші барамын.
Dialogue: 0,0:07:28.40,0:07:30.53,Default,,0,0,0,,А... иә, сау бол.
Dialogue: 0,0:07:30.61,0:07:32.11,Default,,0,0,0,,Қош бол Шигурэ-чан
Dialogue: 0,0:07:32.20,0:07:33.57,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:07:41.54,0:07:42.54,Default,,0,0,0,,Әкемнің жұмысына байланысты.
Dialogue: 0,0:07:42.54,0:07:43.50,Default,,0,0,0,,Әкемнің жұмысына байланысты.
Dialogue: 0,0:07:42.54,0:07:43.50,Default,,0,0,0,,Кенет Шигурэ-чан мектептерді ауыстыруға мәжбүр болды.
Dialogue: 0,0:07:43.50,0:07:43.58,Default,,0,0,0,,Кенет Шигурэ-чан мектептерді ауыстыруға мәжбүр болды.
Dialogue: 0,0:07:43.58,0:07:45.04,Default,,0,0,0,,Кенет Шигурэ-чан мектептерді ауыстыруға мәжбүр болды.
Dialogue: 0,0:07:43.58,0:07:45.04,Default,,0,0,0,,Шигуре мырза —
Dialogue: 0,0:07:45.04,0:07:45.13,Default,,0,0,0,,Кенет Шигурэ-чан мектептерді ауыстыруға мәжбүр болды.
Dialogue: 0,0:07:45.13,0:07:47.17,Default,,0,0,0,,Кенет Шигурэ-чан мектептерді ауыстыруға мәжбүр болды.
Dialogue: 0,0:07:45.13,0:07:47.17,Default,,0,0,0,,Мен мектептерді ауыстыру туралы шешім қабылдадым.
Dialogue: 0,0:07:47.25,0:07:48.09,Default,,0,0,0,,Қоштасу кеші...
Dialogue: 0,0:07:48.38,0:07:51.13,Default,,0,0,0,,Жазғы каникулда қайта ораласыз, солай ма?
Dialogue: 0,0:07:51.22,0:07:52.09,Default,,0,0,0,,Біз қайтадан ойнай аламыз, солай ма?
Dialogue: 0,0:07:54.43,0:07:58.43,Default,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:08:17.49,0:08:19.45,Default,,0,0,0,,Мен саған хат жазамын.
Dialogue: 0,0:08:20.83,0:08:22.83,Default,,0,0,0,,Шигурэ-чан, мен сені тағы көремін.
Dialogue: 0,0:08:22.91,0:08:23.75,Default,,0,0,0,,Иә
Dialogue: 0,0:08:23.83,0:08:25.63,Default,,0,0,0,,Уау! (Сигур) Иә?
Dialogue: 0,0:08:25.71,0:08:28.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:32.34,0:08:33.88,Default,,0,0,0,,Хината-кун
Dialogue: 0,0:08:35.22,0:08:38.14,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:08:40.22,0:08:41.18,Default,,0,0,0,,Уф
Dialogue: 0,0:08:57.49,0:09:02.16,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:09:02.25,0:09:05.96,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:09:06.04,0:09:09.67,Default,,0,0,0,,Шигурэ-чан Уф...
Dialogue: 0,0:09:09.75,0:09:14.17,Default,,0,0,0,,(Хюганың жылағаны)
Dialogue: 0,0:09:14.26,0:09:17.05,Default,,0,0,0,,(ұшқан құстардың дыбысы)
Dialogue: 0,0:09:27.60,0:09:28.69,Default,,0,0,0,,Хината-кун
Dialogue: 0,0:09:30.31,0:09:31.19,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:31.32,0:09:32.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.57,0:09:35.36,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:09:36.20,0:09:39.41,Default,,0,0,0,,Сухаааааа!
Dialogue: 0,0:09:39.99,0:09:41.58,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:09:52.17,0:09:58.88,Default,,0,0,0,,♪～
Dialogue: 0,0:10:01.76,0:10:03.26,Default,,0,0,0,,Ах! Хината-кун
Dialogue: 0,0:10:08.81,0:10:10.81,Default,,0,0,0,,Мен Шигурэ-чанмын.
Dialogue: 0,0:10:11.90,0:10:13.98,Default,,0,0,0,,Өз ойларыңызды айтыңыз
Dialogue: 0,0:10:23.20,0:10:24.49,Default,,0,0,0,,Ах
Dialogue: 0,0:10:24.58,0:10:25.70,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:29.04,0:10:30.96,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:10:33.04,0:10:34.71,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:10:35.00,0:10:36.92,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:10:43.22,0:10:47.14,Default,,0,0,0,,Шигурэ-чан!
Dialogue: 0,0:10:57.53,0:10:58.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:14.96,0:11:16.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:44.24,0:11:46.28,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:11:46.99,0:11:49.41,Default,,0,0,0,,Шигурэ-чан (Шигуре) Ах!
Dialogue: 0,0:11:49.50,0:11:51.00,Default,,0,0,0,,Хината-кун
Dialogue: 0,0:11:51.08,0:11:52.29,Default,,0,0,0,,Қақпақ
Dialogue: 0,0:11:52.37,0:11:53.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:54.25,0:11:55.13,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:12:01.88,0:12:03.63,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:12:03.72,0:12:04.55,Default,,0,0,0,,Ах
Dialogue: 0,0:12:10.56,0:12:12.48,Default,,0,0,0,,Күте тұрыңыз, Шигурэ-чан
Dialogue: 0,0:12:12.56,0:12:15.23,Default,,0,0,0,,Мен... Шигурэ-чан үшін уайымдаймын...
Dialogue: 0,0:12:18.40,0:12:19.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:23.24,0:12:26.03,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:12:29.12,0:12:29.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:30.79,0:12:31.91,Default,,0,0,0,,Шигурэ-чан
Dialogue: 0,0:12:32.00,0:12:34.04,Default,,0,0,0,,Ах, Хината-кун
