Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:54.72,0:00:58.72,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:01:11.44,0:01:12.90,Default,,0,0,0,,Құпия сөз дегеніміз не?
Dialogue: 0,0:01:12.98,0:01:15.03,Default,,0,0,0,,Ге... Джеро Джеро Ринчо
Dialogue: 0,0:01:15.61,0:01:17.53,Default,,0,0,0,,Пинг теннисі Пинг теннисі үстел теннисі!
Dialogue: 0,0:01:17.61,0:01:18.82,Default,,0,0,0,,Геро герориньчо!
Dialogue: 0,0:01:18.91,0:01:20.41,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:21.28,0:01:23.54,Default,,0,0,0,,Неге оны өзгертпеске? Сол құпия сөз
Dialogue: 0,0:01:23.62,0:01:25.21,Default,,0,0,0,,Неліктен? Жироро
Dialogue: 0,0:01:25.29,0:01:27.04,Default,,0,0,0,,Кішкене ұялмайсың ба?
Dialogue: 0,0:01:27.12,0:01:29.08,Default,,0,0,0,,Иә? Күшті!
Dialogue: 0,0:01:29.17,0:01:31.54,Default,,0,0,0,,Джеро герориньчо! Джеро героринчо!
Dialogue: 0,0:01:31.63,0:01:32.21,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:32.30,0:01:33.46,Default,,0,0,0,,Одан да көп!
Dialogue: 0,0:01:33.55,0:01:34.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:34.51,0:01:36.47,Default,,0,0,0,,Оны әкелдің бе? мысал бірі
Dialogue: 0,0:01:36.55,0:01:37.72,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:01:38.30,0:01:38.97,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:39.05,0:01:40.39,Default,,0,0,0,,Құсу!
Dialogue: 0,0:01:40.47,0:01:43.35,Default,,0,0,0,,Бұл нағыз Kero Ball!
Dialogue: 0,0:01:45.27,0:01:47.27,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.95,0:02:00.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:06.87,0:02:09.12,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:02:09.71,0:02:11.84,Default,,0,0,0,,Эй, маған аздап қарыз берші.
Dialogue: 0,0:02:11.92,0:02:12.96,Default,,0,0,0,,-Жоқ. -А?
Dialogue: 0,0:02:13.04,0:02:14.34,Default,,0,0,0,,Мен саған көрсетейін дедім бе?
Dialogue: 0,0:02:14.42,0:02:17.13,Default,,0,0,0,,Жарайды, жарайды, сәл ғана~
Dialogue: 0,0:02:17.22,0:02:21.14,Default,,0,0,0,,Ағам сыртқа шыққанда жасырын қарызға алдым.
Dialogue: 0,0:02:21.22,0:02:23.72,Default,,0,0,0,,Бұзсаң, өлтіресің.
Dialogue: 0,0:02:23.81,0:02:24.64,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:24.72,0:02:27.23,Default,,0,0,0,,Кероро-кун! Гироро!
Dialogue: 0,0:02:27.31,0:02:28.06,Default,,0,0,0,,-Хмм? -Апыр-ай!
Dialogue: 0,0:02:28.14,0:02:28.89,Default,,0,0,0,,Нөл!
Dialogue: 0,0:02:28.98,0:02:30.31,Default,,0,0,0,,Мен сені алып келдім!
Dialogue: 0,0:02:33.11,0:02:34.19,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:34.27,0:02:35.69,Default,,0,0,0,,Пуруру-чан!
Dialogue: 0,0:02:36.53,0:02:37.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:37.49,0:02:38.95,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:02:40.03,0:02:42.70,Default,,0,0,0,,Кір, кір, біздің құпия базамыз.
Dialogue: 0,0:02:42.78,0:02:43.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:43.70,0:02:45.95,Default,,0,0,0,,О... Эй, Кероро, сенің құпия сөзің қандай?
Dialogue: 0,0:02:46.04,0:02:46.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:02:46.91,0:02:48.66,Default,,0,0,0,,-Өтінемін, Пуруру-чан -Ах...
Dialogue: 0,0:02:48.75,0:02:50.00,Default,,0,0,0,,-Мм... -Е... Иә.
Dialogue: 0,0:02:50.08,0:02:51.37,Default,,0,0,0,,Жироро да жылдам
Dialogue: 0,0:02:51.88,0:02:52.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:54.46,0:02:56.59,Default,,0,0,0,,Мен... Мен ше?
Dialogue: 0,0:03:01.09,0:03:03.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:05.05,0:03:07.39,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл таңқаларлық емес пе?
Dialogue: 0,0:03:09.93,0:03:13.27,Default,,0,0,0,,Иә~ Балалар, мұны сендер жасадыңдар ма, Кероро?
Dialogue: 0,0:03:13.35,0:03:14.48,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:03:14.56,0:03:16.69,Default,,0,0,0,,Бұл... маңызды мәселе емес.
Dialogue: 0,0:03:16.77,0:03:19.53,Default,,0,0,0,,Сонда маған жақсы нәрсе көрсету деген нені білдіреді?
Dialogue: 0,0:03:20.19,0:03:20.78,Default,,0,0,0,,Иә
Dialogue: 0,0:03:21.36,0:03:22.78,Default,,0,0,0,,Жая~!
Dialogue: 0,0:03:23.36,0:03:26.16,Default,,0,0,0,,Бұл туралы не деуге болады? Бұл таңқаларлық емес пе?
Dialogue: 0,0:03:26.91,0:03:28.79,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:03:28.87,0:03:30.21,Default,,0,0,0,,Гарн!
Dialogue: 0,0:03:30.29,0:03:32.08,Default,,0,0,0,,«Бұл не?»...
Dialogue: 0,0:03:32.17,0:03:32.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.88,0:03:36.54,Default,,0,0,0,,Мынау, анау... Қара, Керобол.
Dialogue: 0,0:03:36.63,0:03:38.38,Default,,0,0,0,,Бұл нағыз керо доп
Dialogue: 0,0:03:38.46,0:03:38.96,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:03:39.05,0:03:40.63,Default,,0,0,0,,Гарн!
Dialogue: 0,0:03:41.26,0:03:43.01,Default,,0,0,0,,Күтуім керек екен ғой?
Dialogue: 0,0:03:43.09,0:03:43.93,Default,,0,0,0,,Құсу?
Dialogue: 0,0:03:44.01,0:03:45.89,Default,,0,0,0,,Ах~ Джироро, тыныштал!
Dialogue: 0,0:03:46.76,0:03:47.39,Default,,0,0,0,,Гиро?
Dialogue: 0,0:03:47.47,0:03:49.18,Default,,0,0,0,,Қара, қара, қара
Dialogue: 0,0:03:49.27,0:03:50.18,Default,,0,0,0,,Kero Ball дегеніміз не?
Dialogue: 0,0:03:50.27,0:03:52.94,Default,,0,0,0,,Бұл тек Керон әскерінің капитанында болатын ғажайып қару.
Dialogue: 0,0:03:53.02,0:03:53.65,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:03:53.73,0:03:56.11,Default,,0,0,0,,-Ей, қайтар! -Мысалы... Эй!
Dialogue: 0,0:03:57.15,0:03:57.65,Default,,0,0,0,,Ах
Dialogue: 0,0:03:57.73,0:03:59.15,Default,,0,0,0,,Джиророро~!
Dialogue: 0,0:03:59.23,0:04:00.69,Default,,0,0,0,,-Ах... -Геро...
Dialogue: 0,0:04:02.03,0:04:02.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.95,0:04:04.16,Default,,0,0,0,,Әй, бұл таңқаларлық емес пе?
Dialogue: 0,0:04:04.78,0:04:06.66,Default,,0,0,0,,Сондай-ақ~ Неліктен бұл ұл?
Dialogue: 0,0:04:06.74,0:04:08.91,Default,,0,0,0,,Қызық, осының бәрі сізге ұнай ма?
Dialogue: 0,0:04:08.99,0:04:10.04,Default,,0,0,0,,Құсу?
Dialogue: 0,0:04:10.12,0:04:11.83,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:04:11.91,0:04:13.04,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:04:13.12,0:04:14.92,Default,,0,0,0,,Ммм...
Dialogue: 0,0:04:15.00,0:04:16.25,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:04:18.00,0:04:19.00,Default,,0,0,0,,Қый!
Dialogue: 0,0:04:25.51,0:04:26.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:27.93,0:04:30.35,Default,,0,0,0,,Kero Ball керемет, солай емес пе?
Dialogue: 0,0:04:30.43,0:04:33.64,Default,,0,0,0,,Бұл шынымен Керон армиясының ең күшті қаруы ма?
Dialogue: 0,0:04:33.73,0:04:35.48,Default,,0,0,0,,Иә
Dialogue: 0,0:04:35.56,0:04:38.44,Default,,0,0,0,,Құсу? Сол дауыс...
Dialogue: 0,0:04:38.94,0:04:41.48,Default,,0,0,0,,Я~ Джироро-кун, біраз уақыт болды.
Dialogue: 0,0:04:41.57,0:04:42.36,Default,,0,0,0,,-Хмф! -Аа...
Dialogue: 0,0:04:42.44,0:04:45.86,Default,,0,0,0,,Жироның ағасы Кероболдан күткендей
Dialogue: 0,0:04:45.95,0:04:48.95,Default,,0,0,0,,Сізге рахмет, Пуруру-чан да өте риза!
Dialogue: 0,0:04:49.45,0:04:51.74,Default,,0,0,0,,Олай болса, маған тағы біраз қарыз бере аласыз ба?
Dialogue: 0,0:04:51.83,0:04:54.29,Default,,0,0,0,,Жоқ! Уайымдама!
Dialogue: 0,0:04:54.37,0:04:56.25,Default,,0,0,0,,Жарайды, сәл ғана.
Dialogue: 0,0:04:56.33,0:04:57.25,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:58.00,0:04:59.63,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:04:59.71,0:05:01.75,Default,,0,0,0,,-Керо-кун -Мм?
Dialogue: 0,0:05:01.84,0:05:05.84,Default,,0,0,0,,А... пароль құсық героринпа болды ма?
Dialogue: 0,0:05:05.93,0:05:07.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:07.14,0:05:08.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:12.14,0:05:14.60,Default,,0,0,0,,-Бәрі жақсы ма? -Қал...
Dialogue: 0,0:05:14.68,0:05:15.73,Default,,0,0,0,,- Құсу? -иә?
Dialogue: 0,0:05:19.02,0:05:22.15,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:05:32.24,0:05:36.46,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:05:37.29,0:05:38.54,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:05:39.04,0:05:40.46,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,0:05:40.54,0:05:42.84,Default,,0,0,0,,Сіз Kero Ball ойынына сіңіп кеттіңіз!
Dialogue: 0,0:05:42.92,0:05:43.92,Default,,0,0,0,,Құсу?
Dialogue: 0,0:05:44.01,0:05:46.63,Default,,0,0,0,,Көрдім, бұл жер Kero Ball ішінде!
Dialogue: 0,0:05:46.72,0:05:48.34,Default,,0,0,0,,Көмек!
Dialogue: 0,0:05:48.43,0:05:50.68,Default,,0,0,0,,Бұл бақытты болатын уақыт емес!
Dialogue: 0,0:05:50.76,0:05:51.68,Default,,0,0,0,,Гомин
Dialogue: 0,0:05:52.76,0:05:54.35,Default,,0,0,0,,Барлығың қараңдар!
Dialogue: 0,0:05:54.43,0:05:55.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.31,0:05:57.52,Default,,0,0,0,,Қараңдар, ана жерде!
Dialogue: 0,0:05:57.60,0:05:58.23,Default,,0,0,0,,Ng...
Dialogue: 0,0:05:58.31,0:05:59.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:59.56,0:06:00.40,Default,,0,0,0,,Ашық!
Dialogue: 0,0:06:02.19,0:06:04.03,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:06:07.20,0:06:07.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.78,0:06:09.95,Default,,0,0,0,,Керон армиясының негізгі дайындық курсы
Dialogue: 0,0:06:10.03,0:06:12.49,Default,,0,0,0,,Т атлетикалық режимі басталды.
Dialogue: 0,0:06:12.58,0:06:14.29,Default,,0,0,0,,- Иә? -Иә...
Dialogue: 0,0:06:15.50,0:06:17.75,Default,,0,0,0,,Жаттығуды қазір бастаңыз
Dialogue: 0,0:06:18.41,0:06:21.25,Default,,0,0,0,,4 тыңдаушы тіркелді
Dialogue: 0,0:06:23.25,0:06:25.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:27.34,0:06:29.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:29.34,0:06:31.39,Default,,0,0,0,,Бұл тренинг ересектерге арналған ба?
Dialogue: 0,0:06:31.47,0:06:33.10,Default,,0,0,0,,Жаса! Жаса!
Dialogue: 0,0:06:33.18,0:06:35.60,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:06:35.68,0:06:36.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:36.97,0:06:39.02,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:39.10,0:06:41.81,Default,,0,0,0,,Уақыт шегі – 5 минут
Dialogue: 0,0:06:41.90,0:06:44.27,Default,,0,0,0,,Жаттығу басталады!
Dialogue: 0,0:06:44.36,0:06:47.28,Default,,0,0,0,,- (Десу доп)! -Апыр-ай!
Dialogue: 0,0:06:47.86,0:06:49.78,Default,,0,0,0,,- (Десу шары)! -Апыр-ай!
Dialogue: 0,0:06:49.86,0:06:51.28,Default,,0,0,0,,О...
Dialogue: 0,0:06:51.36,0:06:53.91,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:06:53.99,0:06:55.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:59.54,0:07:01.50,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:02.00,0:07:03.75,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:06.67,0:07:07.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:07.96,0:07:08.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:08.88,0:07:11.30,Default,,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:07:11.38,0:07:12.59,Default,,0,0,0,,- Құсу~! -Хмм!
Dialogue: 0,0:07:12.68,0:07:14.05,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,0:07:14.14,0:07:15.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:15.14,0:07:17.14,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:07:17.64,0:07:23.35,Default,,0,0,0,,Уау... аааа!
Dialogue: 0,0:07:24.65,0:07:28.07,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:07:28.15,0:07:29.57,Default,,0,0,0,,Құсу!
Dialogue: 0,0:07:30.15,0:07:31.86,Default,,0,0,0,,Tettete...
Dialogue: 0,0:07:31.95,0:07:32.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.07,0:07:34.66,Default,,0,0,0,,Құсу!
Dialogue: 0,0:07:38.66,0:07:39.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:40.00,0:07:42.37,Default,,0,0,0,,Ей, керемет көпір бар!
Dialogue: 0,0:07:42.46,0:07:43.71,Default,,0,0,0,,Кероро-кун болса ше?
Dialogue: 0,0:07:43.79,0:07:44.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:45.84,0:07:47.25,Default,,0,0,0,,-Жақсысың ба? -Иә
Dialogue: 0,0:07:48.09,0:07:49.63,Default,,0,0,0,,Рахмет, Гиро-кун
Dialogue: 0,0:07:49.71,0:07:52.01,Default,,0,0,0,,Бұл... үлкен мәселе емес.
Dialogue: 0,0:07:52.09,0:07:53.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:54.43,0:07:55.18,Default,,0,0,0,,Цк
Dialogue: 0,0:07:55.68,0:07:57.64,Default,,0,0,0,,3,5 минут қалды.
Dialogue: 0,0:07:58.47,0:07:59.64,Default,,0,0,0,,Кешіктірмеңіз!
Dialogue: 0,0:08:00.81,0:08:01.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.89,0:08:04.15,Default,,0,0,0,,А... Иә? Апыр-ай!
Dialogue: 0,0:08:04.23,0:08:05.77,Default,,0,0,0,,Құсу~?
Dialogue: 0,0:08:05.86,0:08:07.77,Default,,0,0,0,,Бұл қауіпті, жүгір!
Dialogue: 0,0:08:07.86,0:08:09.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:09.90,0:08:11.53,Default,,0,0,0,,Менің қолым ауырды!
Dialogue: 0,0:08:11.61,0:08:12.78,Default,,0,0,0,,Сәттілік Zeroro!
Dialogue: 0,0:08:12.86,0:08:15.28,Default,,0,0,0,,Көбірек хабарласыңыз!
Dialogue: 0,0:08:15.36,0:08:17.66,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:08:17.74,0:08:19.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:19.12,0:08:23.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:23.66,0:08:25.08,Default,,0,0,0,,Нөл!
Dialogue: 0,0:08:30.34,0:08:31.59,Default,,0,0,0,,Қый!
Dialogue: 0,0:08:31.67,0:08:33.59,Default,,0,0,0,,1 адам оқудан шықты
Dialogue: 0,0:08:33.67,0:08:37.55,Default,,0,0,0,,(Кероро мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:08:37.64,0:08:39.01,Default,,0,0,0,,Нөлдік-кун...
Dialogue: 0,0:08:39.10,0:08:41.06,Default,,0,0,0,,Өйткені бұл модельдеу
Dialogue: 0,0:08:41.14,0:08:43.39,Default,,0,0,0,,Құлап қалсаң да, ауырмайсың.
Dialogue: 0,0:08:43.48,0:08:44.60,Default,,0,0,0,,Не?
Dialogue: 0,0:08:45.39,0:08:47.94,Default,,0,0,0,,Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:08:48.02,0:08:48.61,Default,,0,0,0,,Құсу?
Dialogue: 0,0:08:48.69,0:08:51.11,Default,,0,0,0,,3 кезең басталады!
Dialogue: 0,0:08:51.19,0:08:52.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.07,0:08:54.32,Default,,0,0,0,,Кероро, сен!
Dialogue: 0,0:08:54.40,0:08:55.40,Default,,0,0,0,,Құсу?
Dialogue: 0,0:08:55.49,0:08:56.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:56.20,0:08:58.66,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:08:58.74,0:09:01.04,Default,,0,0,0,,Уаааааааааааааааааааа
Dialogue: 0,0:09:01.79,0:09:03.12,Default,,0,0,0,,Құсу!
Dialogue: 0,0:09:04.58,0:09:06.12,Default,,0,0,0,,Құсу, құсу!
Dialogue: 0,0:09:06.21,0:09:09.42,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:09:09.50,0:09:12.13,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:09:12.71,0:09:13.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:14.09,0:09:15.51,Default,,0,0,0,,Рахмет, Гиро-кун
Dialogue: 0,0:09:15.59,0:09:17.05,Default,,0,0,0,,Бұл... үлкен мәселе болды...
Dialogue: 0,0:09:17.13,0:09:17.64,Default,,0,0,0,,Құсу!
Dialogue: 0,0:09:18.26,0:09:19.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:19.47,0:09:20.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:22.47,0:09:25.60,Default,,0,0,0,,Тағы бір адам оқудан шықты
Dialogue: 0,0:09:28.06,0:09:29.02,Default,,0,0,0,,Жиро-кун...
Dialogue: 0,0:09:29.11,0:09:30.15,Default,,0,0,0,,Жиру...
Dialogue: 0,0:09:30.23,0:09:34.40,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:09:34.49,0:09:36.90,Default,,0,0,0,,Уау! Гайя!
Dialogue: 0,0:09:37.82,0:09:38.91,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:09:38.99,0:09:40.07,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:09:40.16,0:09:40.87,Default,,0,0,0,,(батырмаға түсетін дыбыс)
Dialogue: 0,0:09:40.95,0:09:41.66,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:09:41.74,0:09:42.91,Default,,0,0,0,,(батырмаға түсетін дыбыс)
Dialogue: 0,0:09:43.87,0:09:45.25,Default,,0,0,0,,Құсу!
Dialogue: 0,0:09:45.33,0:09:46.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:55.97,0:09:57.17,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:09:57.26,0:09:58.84,Default,,0,0,0,,Тез кеттік!
Dialogue: 0,0:09:58.93,0:10:01.30,Default,,0,0,0,,Бірақ Жиро-кун мен Зеро-кун ше?
Dialogue: 0,0:10:01.39,0:10:03.43,Default,,0,0,0,,Жарайды, себебі бұл модельдеу
Dialogue: 0,0:10:03.51,0:10:04.68,Default,,0,0,0,,Жиро да осылай деді.
Dialogue: 0,0:10:04.77,0:10:06.60,Default,,0,0,0,,-Жақсы емес -Ух...
Dialogue: 0,0:10:06.68,0:10:09.02,Default,,0,0,0,,Әлгі жігіттер ақсақ екен.
Dialogue: 0,0:10:09.10,0:10:11.48,Default,,0,0,0,,Өйткені, мен ең жақсымын! Дұрыс па?
Dialogue: 0,0:10:11.56,0:10:12.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:12.73,0:10:15.69,Default,,0,0,0,,Өйткені бұл Кероро-кунның кесірінен болды.
Dialogue: 0,0:10:15.78,0:10:16.69,Default,,0,0,0,,Гику!
Dialogue: 0,0:10:17.36,0:10:20.62,Default,,0,0,0,,Бірақ... бұл өте қызық.
Dialogue: 0,0:10:20.70,0:10:21.32,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:10:21.41,0:10:22.37,Default,,0,0,0,,Гику Гику!
Dialogue: 0,0:10:22.95,0:10:24.08,Default,,0,0,0,,Жарайды... онда
Dialogue: 0,0:10:24.16,0:10:26.41,Default,,0,0,0,,Тез тазалап, сыртқа шығайық.
Dialogue: 0,0:10:26.50,0:10:28.54,Default,,0,0,0,,Кероро-кун, сен шығуды білесің бе?
Dialogue: 0,0:10:28.62,0:10:29.83,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:31.21,0:10:32.67,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,0:10:34.05,0:10:35.63,Default,,0,0,0,,Сәл басқаша
Dialogue: 0,0:10:36.63,0:10:38.97,Default,,0,0,0,,Хаха... Мен қателесіппін.
Dialogue: 0,0:10:39.80,0:10:42.14,Default,,0,0,0,,Иә?Бұл біртүрлі
Dialogue: 0,0:10:42.80,0:10:44.89,Default,,0,0,0,,Міне, міне~ Қараңыз.
Dialogue: 0,0:10:45.47,0:10:46.77,Default,,0,0,0,,Құсу!
Dialogue: 0,0:10:47.27,0:10:49.31,Default,,0,0,0,,Бұл жарық - шығу!
Dialogue: 0,0:10:49.39,0:10:51.94,Default,,0,0,0,,Могумогу…
Dialogue: 0,0:10:52.44,0:10:55.32,Default,,0,0,0,,Кездескенше!
Dialogue: 0,0:10:55.40,0:10:57.32,Default,,0,0,0,,- Құсу~! -Кя~!
Dialogue: 0,0:10:58.36,0:10:59.82,Default,,0,0,0,,Шығу уақыты келді
Dialogue: 0,0:11:00.82,0:11:01.32,Default,,0,0,0,,Құсу?
Dialogue: 0,0:11:02.57,0:11:04.70,Default,,0,0,0,,Шамдарды қосулы қалдырмаңыз
Dialogue: 0,0:11:06.62,0:11:11.04,Default,,0,0,0,,Сәлем Джироро! Нөл!
Dialogue: 0,0:11:11.54,0:11:12.67,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:12.75,0:11:14.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:14.71,0:11:17.09,Default,,0,0,0,,Пу... Пуруру-чан?
Dialogue: 0,0:11:17.17,0:11:20.93,Default,,0,0,0,,Біз бұл жерден ешқашан кете алмаймыз ба?
Dialogue: 0,0:11:21.84,0:11:23.59,Default,,0,0,0,,Бар... Гомин
Dialogue: 0,0:11:23.68,0:11:24.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.22,0:11:29.06,Default,,0,0,0,,Мен жай ғана Пуруру-чанның бақытты болғанын қаладым.
Dialogue: 0,0:11:29.81,0:11:31.19,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:11:31.69,0:11:35.44,Default,,0,0,0,,Уау! Мен үйге барғым келеді!
Dialogue: 0,0:11:35.52,0:11:37.02,Default,,0,0,0,,Кероро-кун...
Dialogue: 0,0:11:37.11,0:11:40.36,Default,,0,0,0,,Жақсы! Анашым!
Dialogue: 0,0:11:40.44,0:11:43.11,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:11:43.20,0:11:44.57,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:11:44.66,0:11:47.03,Default,,0,0,0,,-Хмм? Бұл не? -Эй!
Dialogue: 0,0:11:47.12,0:11:47.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:48.45,0:11:50.04,Default,,0,0,0,,Бұл Керо доп па?
Dialogue: 0,0:11:50.12,0:11:50.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:50.87,0:11:53.46,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:11:53.54,0:11:54.79,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:11:54.88,0:11:57.88,Default,,0,0,0,,Кешіріңіз, мен сізден сәл озып кеттім.
Dialogue: 0,0:11:57.96,0:11:59.42,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:59.51,0:12:01.76,Default,,0,0,0,,Жарайды, мен сені үйде күтемін.
Dialogue: 0,0:12:01.84,0:12:03.09,Default,,0,0,0,,Риноноға барайық
Dialogue: 0,0:12:03.18,0:12:04.22,Default,,0,0,0,,Кеттік Шпепе
Dialogue: 0,0:12:04.80,0:12:06.60,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:12:06.68,0:12:08.10,Default,,0,0,0,,-Уау! - Құсу!
Dialogue: 0,0:12:08.18,0:12:09.72,Default,,0,0,0,,-Сәлем! -Апыр-ай!
Dialogue: 0,0:12:10.60,0:12:12.14,Default,,0,0,0,,Сыртта біреу бар.
Dialogue: 0,0:12:12.23,0:12:12.73,Default,,0,0,0,,Құсу?
Dialogue: 0,0:12:12.81,0:12:15.65,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:12:15.73,0:12:16.73,Default,,0,0,0,,-Сәлем! -иә?
Dialogue: 0,0:12:17.52,0:12:19.40,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:12:19.48,0:12:21.99,Default,,0,0,0,,Ей, шығарайық!
Dialogue: 0,0:12:22.07,0:12:24.41,Default,,0,0,0,,Иә? Іштен бір дауыс естимін.
Dialogue: 0,0:12:24.49,0:12:24.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:25.07,0:12:27.41,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:12:27.49,0:12:28.99,Default,,0,0,0,,-Кя~! - Құсу!
Dialogue: 0,0:12:29.08,0:12:31.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:31.08,0:12:32.46,Default,,0,0,0,,Құсу!
Dialogue: 0,0:12:32.54,0:12:34.50,Default,,0,0,0,,Уау~ Бұл шынымен де сонда.
Dialogue: 0,0:12:35.17,0:12:37.75,Default,,0,0,0,,Керемет Керо добы
Dialogue: 0,0:12:37.84,0:12:39.59,Default,,0,0,0,,Зенitsu, енді қоя салшы!
Dialogue: 0,0:12:39.67,0:12:41.67,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:12:41.76,0:12:43.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:43.17,0:12:44.13,Default,,0,0,0,,Эх!
Dialogue: 0,0:12:44.22,0:12:45.47,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:12:45.55,0:12:47.89,Default,,0,0,0,,Мен не айтсаң да тыңдаймын!
Dialogue: 0,0:12:47.97,0:12:49.10,Default,,0,0,0,,Сонда кездескенше...
Dialogue: 0,0:12:49.18,0:12:51.97,Default,,0,0,0,,Иә! Маған өмір бойы құнды карри мен күріш сатып алыңыз
Dialogue: 0,0:12:52.06,0:12:54.02,Default,,0,0,0,,Ка... Карри мен күріш?
Dialogue: 0,0:12:54.10,0:12:56.19,Default,,0,0,0,,Сіз қалай ойлайсыз? Маған бірдеңе сатып ала аласыз ба?
Dialogue: 0,0:12:56.27,0:12:57.40,Default,,0,0,0,,Огору Огору!
Dialogue: 0,0:12:57.48,0:12:59.86,Default,,0,0,0,,Мен саған карри немесе басқасын сатып аламын, маған көмектес!
Dialogue: 0,0:12:59.94,0:13:02.94,Default,,0,0,0,,Жарайды, онда мен саған көмектесемін.
Dialogue: 0,0:13:03.03,0:13:04.20,Default,,0,0,0,,- Иә! -Апыр-ай!
Dialogue: 0,0:13:04.28,0:13:06.57,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:13:06.66,0:13:08.70,Default,,0,0,0,,Шынымен, қай түймені басу керек?
Dialogue: 0,0:13:08.78,0:13:10.45,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:13:10.53,0:13:11.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.29,0:13:13.66,Default,,0,0,0,,Ку… куку… жаттығуы басталады
Dialogue: 0,0:13:13.75,0:13:15.71,Default,,0,0,0,,Ку... Жаттығу басталады.
Dialogue: 0,0:13:15.79,0:13:16.46,Default,,0,0,0,,Құсу?
Dialogue: 0,0:13:18.54,0:13:21.46,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:21.55,0:13:28.55,Default,,0,0,0,,Міне! Міне бітті! Міне бітті! Міне бітті!
Dialogue: 0,0:13:29.55,0:13:30.89,Default,,0,0,0,,Кероро-кун...
Dialogue: 0,0:13:30.97,0:13:32.10,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:13:32.18,0:13:33.47,Default,,0,0,0,,-Кероро-кун! -(2 адам) А?
Dialogue: 0,0:13:34.81,0:13:36.48,Default,,0,0,0,,Нөл! Гироро!
Dialogue: 0,0:13:39.02,0:13:40.98,Default,,0,0,0,,Барлығы, тоқтаңдар!
Dialogue: 0,0:13:41.07,0:13:42.98,Default,,0,0,0,,Десу~!
Dialogue: 0,0:13:43.07,0:13:47.99,Default,,0,0,0,,Біз бір дос емеспіз бе?
Dialogue: 0,0:13:48.07,0:13:49.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:49.32,0:13:49.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:50.07,0:13:52.99,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:13:55.04,0:13:55.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:57.00,0:13:58.00,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:58.08,0:13:59.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:59.33,0:14:01.67,Default,,0,0,0,,-Ууууууууууууууууууууууууууууу...
Dialogue: 0,0:14:01.75,0:14:02.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.59,0:14:04.42,Default,,0,0,0,,Кероро…
Dialogue: 0,0:14:04.51,0:14:05.67,Default,,0,0,0,,Desu desu desu
Dialogue: 0,0:14:05.76,0:14:06.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.76,0:14:07.72,Default,,0,0,0,,Desu desu desu
Dialogue: 0,0:14:07.80,0:14:08.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:10.14,0:14:11.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:23.32,0:14:25.61,Default,,0,0,0,,T режимі Күшті тоқтату
Dialogue: 0,0:14:25.69,0:14:27.65,Default,,0,0,0,,Жаттығу жүгірісі жарамсыз болады
Dialogue: 0,0:14:27.74,0:14:28.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:28.65,0:14:30.28,Default,,0,0,0,,-Қал... -Мм...
Dialogue: 0,0:14:30.36,0:14:31.32,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:31.82,0:14:34.24,Default,,0,0,0,,-Керо? -Аа...
Dialogue: 0,0:14:34.33,0:14:34.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:34.91,0:14:36.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:36.91,0:14:38.91,Default,,0,0,0,,Сіз маған көмектестіңіз!
Dialogue: 0,0:14:39.00,0:14:40.33,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:14:40.42,0:14:41.92,Default,,0,0,0,,Өмір бойы карри
Dialogue: 0,0:14:42.00,0:14:42.63,Default,,0,0,0,,- Құсу? -иә?
Dialogue: 0,0:14:42.71,0:14:45.59,Default,,0,0,0,,Себебі мен сені Кероболдан алып шықтым.
Dialogue: 0,0:14:45.67,0:14:47.13,Default,,0,0,0,,Уәдеңде тұр, жарай ма?
Dialogue: 0,0:14:47.21,0:14:48.34,Default,,0,0,0,,​​Карри?
Dialogue: 0,0:14:48.42,0:14:49.76,Default,,0,0,0,,Өмір бойы қамтамасыз ету дегеніміз не?
Dialogue: 0,0:14:49.84,0:14:51.64,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:14:51.72,0:14:53.14,Default,,0,0,0,,Маған бірдеңе сатып алмасаң
Dialogue: 0,0:14:53.22,0:14:55.72,Default,,0,0,0,,Мен Кероболмен ойнағанымды айтайын.
Dialogue: 0,0:14:55.81,0:14:56.72,Default,,0,0,0,,Қай сату кассасынан—
Dialogue: 0,0:14:56.81,0:14:57.89,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:14:57.98,0:14:59.39,Default,,0,0,0,,- Маған қарыз беріңіз - Ах!
Dialogue: 0,0:14:59.48,0:15:01.52,Default,,0,0,0,,Карри бұл...
Dialogue: 0,0:15:01.60,0:15:03.98,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:15:04.48,0:15:06.40,Default,,0,0,0,,-Ой! -Апыр-ай!
Dialogue: 0,0:15:08.19,0:15:09.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:10.99,0:15:13.16,Default,,0,0,0,,Иә? Мен тоқтай алмаймын, не істеуім керек?
Dialogue: 0,0:15:13.24,0:15:13.91,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:15:13.99,0:15:16.16,Default,,0,0,0,,Бірдеңе жасаңыз!
Dialogue: 0,0:15:16.24,0:15:17.83,Default,,0,0,0,,Бұл қауіпті, Кероро-кун.
Dialogue: 0,0:15:17.91,0:15:20.33,Default,,0,0,0,,-Аа... иә? -Уууу...
Dialogue: 0,0:15:20.41,0:15:23.08,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:15:23.17,0:15:24.92,Default,,0,0,0,,-Кездескенше! -Кешіріңіз!
Dialogue: 0,0:15:25.00,0:15:26.80,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:15:27.59,0:15:29.59,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:15:29.67,0:15:31.84,Default,,0,0,0,,Та... Көмектесіңіздер!
Dialogue: 0,0:15:32.64,0:15:34.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:34.64,0:15:36.43,Default,,0,0,0,,- Қайтарыңыз! -Аа...
Dialogue: 0,0:15:36.51,0:15:38.10,Default,,0,0,0,,Маған тағы да қарыз бере аласыз ба?
Dialogue: 0,0:15:38.18,0:15:39.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:39.52,0:15:40.60,Default,,0,0,0,,Құсу!
Dialogue: 0,0:15:40.68,0:15:42.65,Default,,0,0,0,,Мен оны енді саған ешқашан бермеймін!
Dialogue: 0,0:15:42.73,0:15:43.90,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:43.98,0:15:45.98,Default,,0,0,0,,Неліктен ұлдар әрқашан осылай болады?
Dialogue: 0,0:15:46.07,0:15:47.19,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:15:47.27,0:15:48.48,Default,,0,0,0,,Бұл не, Нөл!
Dialogue: 0,0:15:48.57,0:15:51.86,Default,,0,0,0,,А... кешіріңіз... Кешіріңіз!
Dialogue: 0,0:15:51.95,0:15:53.95,Default,,0,0,0,,♪～
Dialogue: 0,0:17:13.07,0:17:15.78,Default,,0,0,0,,Куку… Куку Куку…
Dialogue: 0,0:17:17.16,0:17:19.70,Default,,0,0,0,,Ki…ki… сарғаю
Dialogue: 0,0:17:20.28,0:17:22.33,Default,,0,0,0,,Сарғайту...
Dialogue: 0,0:17:22.41,0:17:23.41,Default,,0,0,0,,～♪
Dialogue: 0,0:17:23.50,0:17:26.04,Default,,0,0,0,,Ку-ку-ку-ку-ку-ку!
Dialogue: 0,0:17:51.57,0:17:53.48,Default,,0,0,0,,Кеме ішінде ауытқулар жоқ!
Dialogue: 0,0:17:53.57,0:17:55.11,Default,,0,0,0,,Жарайды, тағы бір рет.
Dialogue: 0,0:17:56.70,0:17:59.36,Default,,0,0,0,,Алда кедергі! Біз соқтығысамыз!
Dialogue: 0,0:18:03.45,0:18:07.37,Default,,0,0,0,,-Өлтіріңдер~ - (Теңізшілер) Уа!
Dialogue: 0,0:18:16.22,0:18:17.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:19.72,0:18:20.89,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:46.91,0:18:48.37,Default,,0,0,0,,Өлтіріңіз~!
Dialogue: 0,0:18:54.42,0:18:58.17,Default,,0,0,0,,Кируу...
Dialogue: 0,0:19:01.05,0:19:06.97,Default,,0,0,0,,(жаңғырған ән дауысы)
Dialogue: 0,0:19:07.06,0:19:08.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.93,0:19:15.94,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:19:38.42,0:19:40.26,Default,,0,0,0,,А... өте ыстық
Dialogue: 0,0:19:40.34,0:19:40.84,Default,,0,0,0,,Қап…
Dialogue: 0,0:19:44.51,0:19:48.31,Default,,0,0,0,,(Бағдаршам әуені)
Dialogue: 0,0:19:48.39,0:19:50.35,Default,,0,0,0,,Рей-чан, асығыңыз!
Dialogue: 0,0:19:50.43,0:19:51.89,Default,,0,0,0,,Саябаққа жүгір!
Dialogue: 0,0:19:51.98,0:19:54.77,Default,,0,0,0,,Тоқта, Юка-чан, Харука-кун!
Dialogue: 0,0:19:56.57,0:19:57.82,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:19:57.90,0:19:58.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:58.65,0:20:00.57,Default,,0,0,0,,Менің шарым!
Dialogue: 0,0:20:05.87,0:20:06.53,Default,,0,0,0,,Ах
Dialogue: 0,0:20:09.45,0:20:11.12,Default,,0,0,0,,Сондықтан оны бәрі көрді
Dialogue: 0,0:20:11.21,0:20:13.12,Default,,0,0,0,,Кресті бар үлкен құбыжық
Dialogue: 0,0:20:13.21,0:20:15.58,Default,,0,0,0,,Уф... Теңіз перілеріне ұқсайтын екі адам бар.
Dialogue: 0,0:20:16.46,0:20:17.59,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:20:18.21,0:20:20.26,Default,,0,0,0,,Әпке, қош келдіңіз.
Dialogue: 0,0:20:20.34,0:20:21.55,Default,,0,0,0,,Мен сені мазалап жүрмін
Dialogue: 0,0:20:22.13,0:20:23.97,Default,,0,0,0,,Момока-чан осында болды.
Dialogue: 0,0:20:24.05,0:20:27.05,Default,,0,0,0,,Мені күтіңіз, менде сізге дәмді шай мен тәттілер бар.
Dialogue: 0,0:20:27.14,0:20:28.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:28.64,0:20:29.89,Default,,0,0,0,,Нацуми Хината
Dialogue: 0,0:20:30.39,0:20:33.89,Default,,0,0,0,,14 жасар қыз жұмысбасты анасының орнына отбасын басқарады.
Dialogue: 0,0:20:33.98,0:20:34.81,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:20:34.90,0:20:36.77,Default,,0,0,0,,- (Фуюки) Уау! -(Нацуми) Күткеніңізге рахмет~
Dialogue: 0,0:20:36.86,0:20:38.48,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:20:38.57,0:20:39.82,Default,,0,0,0,,Не?
Dialogue: 0,0:20:41.44,0:20:42.36,Default,,0,0,0,,- (Фуюки) Уау! -(Момока) Кя~!
Dialogue: 0,0:20:42.95,0:20:44.11,Default,,0,0,0,,Нишизава мырза!
Dialogue: 0,0:20:44.61,0:20:46.11,Default,,0,0,0,,Бұл тағы да оның әрекеті!
Dialogue: 0,0:20:50.45,0:20:52.70,Default,,0,0,0,,- (Нацуми) Ах... - (Фуюки) Ах!
Dialogue: 0,0:20:57.63,0:20:58.75,Default,,0,0,0,,Сержант Кероро
Dialogue: 0,0:20:58.84,0:21:00.30,Default,,0,0,0,,Хюга отбасында болған кезде
Dialogue: 0,0:21:00.38,0:21:03.22,Default,,0,0,0,,Кероро взводын басқаратын басқыншы
Dialogue: 0,0:21:03.30,0:21:06.76,Default,,0,0,0,,Ге~рогерогеро, ақымақ Пекопон халқы.
Dialogue: 0,0:21:06.84,0:21:07.68,Default,,0,0,0,,- Міне! -(Фуюки) А?
Dialogue: 0,0:21:07.76,0:21:09.30,Default,,0,0,0,,Менің Керон әскерім
Dialogue: 0,0:21:09.39,0:21:12.77,Default,,0,0,0,,Бұл машина ең жақсы технологияны жинау арқылы жасалған!
Dialogue: 0,0:21:14.43,0:21:18.52,Default,,0,0,0,,Қырылған мұзды асығыс жеу басымды қатты ауыртады.
Dialogue: 0,0:21:18.61,0:21:21.78,Default,,0,0,0,,Бұл оны қолданатын қорқынышты шабуыл механизмі.
Dialogue: 0,0:21:22.28,0:21:23.61,Default,,0,0,0,,Құсу?
Dialogue: 0,0:21:23.69,0:21:24.78,Default,,0,0,0,,Боке бақасы
Dialogue: 0,0:21:24.86,0:21:29.16,Default,,0,0,0,,Мен осындай ақымақ стратегияларды ойлап табамын!
Dialogue: 0,0:21:30.49,0:21:31.70,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:21:31.79,0:21:34.79,Default,,0,0,0,,Пісіру мен жуудан жерді қорғауға дейін
Dialogue: 0,0:21:35.33,0:21:37.46,Default,,0,0,0,,Нацуми Хинатаның күнделікті өмірі өте тығыз.
Dialogue: 0,0:21:38.50,0:21:40.42,Default,,0,0,0,,Жоқ, жоқ, сержант.
Dialogue: 0,0:21:40.50,0:21:42.92,Default,,0,0,0,,Үйіңізді рұқсатсыз өзгертпеңіз...
Dialogue: 0,0:21:43.01,0:21:45.84,Default,,0,0,0,,Бұл да Фуюки-доно және Момока-доно.
Dialogue: 0,0:21:45.92,0:21:48.47,Default,,0,0,0,,Құсу? Бұл не?
Dialogue: 0,0:21:48.55,0:21:51.68,Default,,0,0,0,,О, бұл? Бұл сирек жаратылыс, солай емес пе?
Dialogue: 0,0:21:51.76,0:21:54.22,Default,,0,0,0,,Оны маған Нишизава мырза әкелді.
Dialogue: 0,0:21:54.31,0:21:55.85,Default,,0,0,0,,Бұл UMA болуы мүмкін.
Dialogue: 0,0:21:55.93,0:21:57.27,Default,,0,0,0,,UMA дегеніміз не?
Dialogue: 0,0:21:57.35,0:21:59.94,Default,,0,0,0,,Лох-Несстегі Несси немесе Гималайдағы қар адамы сияқты
Dialogue: 0,0:22:00.02,0:22:01.61,Default,,0,0,0,,Белгісіз организмдер
Dialogue: 0,0:22:01.69,0:22:06.95,Default,,0,0,0,,Біздің зерттеу тобымыз оны Оңтүстік Тынық мұхитының белгілі бір аймағында тапты.
Dialogue: 0,0:22:07.03,0:22:09.99,Default,,0,0,0,,Теңізде әлі де жұмбақ көп.
Dialogue: 0,0:22:10.07,0:22:10.74,Default,,0,0,0,,Құсу
Dialogue: 0,0:22:10.82,0:22:13.74,Default,,0,0,0,,Аа, мен толық зерттегім келеді.
Dialogue: 0,0:22:13.83,0:22:16.83,Default,,0,0,0,,Жарайды~ Дәл жоспарланғандай!
Dialogue: 0,0:22:16.91,0:22:20.83,Default,,0,0,0,,Лови-дови UMA барлау тобының жалғыз Фуюки-кунмен жұмысы
Dialogue: 0,0:22:20.92,0:22:23.00,Default,,0,0,0,,Біз бұл жолы сәтті орындаймыз!
Dialogue: 0,0:22:23.75,0:22:25.34,Default,,0,0,0,,Не болды? Нишизава мырза
Dialogue: 0,0:22:25.42,0:22:27.30,Default,,0,0,0,,Ха! А, жоқ, бұл...
Dialogue: 0,0:22:27.38,0:22:29.13,Default,,0,0,0,,- (Момока) Тоқта... күте тұр - (Фуюки) А? сурет?
Dialogue: 0,0:22:31.01,0:22:34.89,Default,,0,0,0,,Сонымен... Фуюки-кун, қарсы болмасаң...
Dialogue: 0,0:22:35.39,0:22:39.39,Default,,0,0,0,,Менімен осыны тапқан аймақтағы оңтүстік аралға барғың келе ме?
Dialogue: 0,0:22:39.48,0:22:41.44,Default,,0,0,0,,Құсу? Оңтүстік арал?
Dialogue: 0,0:22:41.52,0:22:42.77,Default,,0,0,0,,Шынымен бе? Нишизава мырза
Dialogue: 0,0:22:42.86,0:22:45.11,Default,,0,0,0,,Ах, Момокчи Микке
Dialogue: 0,0:22:45.19,0:22:48.11,Default,,0,0,0,,Тамама 2 сынып! Бұл демалыс! Бұл демалыс!
Dialogue: 0,0:22:48.20,0:22:48.86,Default,,0,0,0,,Эх!
Dialogue: 0,0:22:48.95,0:22:50.70,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,0:22:51.53,0:22:53.49,Default,,0,0,0,,Жазғы теңіз қауіпке толы
Dialogue: 0,0:22:53.58,0:22:55.37,Default,,0,0,0,,Мен осы Коюки-менді көргім келеді
Dialogue: 0,0:22:55.45,0:22:58.41,Default,,0,0,0,,Бұл жазғы тәжірибе, Куккок~
Dialogue: 0,0:22:58.50,0:23:00.17,Default,,0,0,0,,Жаз келді ме?
Dialogue: 0,0:23:00.25,0:23:02.00,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:23:02.08,0:23:03.42,Default,,0,0,0,,Мен де бармын.
Dialogue: 0,0:23:03.50,0:23:05.17,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:23:05.25,0:23:09.67,Default,,0,0,0,,Қалағаныңызды жай ғана айтпаңыз, басқаларға қолайсыздықты ескеріңіз...
Dialogue: 0,0:23:10.18,0:23:11.18,Default,,0,0,0,,- (Нацуми) А-а?
Dialogue: 0,0:23:11.93,0:23:15.22,Default,,0,0,0,,Лови-дови Фуюки-кунмен жалғыз...
Dialogue: 0,0:23:15.72,0:23:18.23,Default,,0,0,0,,О, оңтүстік арал...
Dialogue: 0,0:23:18.73,0:23:21.19,Default,,0,0,0,,Егер сізге ұнаса, бізге қосылыңыз!
Dialogue: 0,0:23:21.27,0:23:22.44,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:23:22.52,0:23:23.52,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:23:23.61,0:23:25.19,Default,,0,0,0,,Бұл Хината отбасы.
Dialogue: 0,0:23:25.27,0:23:27.86,Default,,0,0,0,,Кероро сержанты басқаратын Кероро взводының қатысуы
Dialogue: 0,0:23:27.94,0:23:31.41,Default,,0,0,0,,Бұл терең теңіздегі үлкен шытырман оқиғаның басы болды.
Dialogue: 0,0:23:35.91,0:23:37.91,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.59,0:23:52.88,Default,,0,0,0,,Хмм, келгеніме қуаныштымын!
Dialogue: 0,0:23:52.97,0:23:54.80,Default,,0,0,0,,Анам келе алмады.
Dialogue: 0,0:23:54.89,0:23:55.93,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:23:56.01,0:23:58.39,Default,,0,0,0,,Менің амалым жоқ, бұл менің жұмысым.
Dialogue: 0,0:23:59.14,0:24:01.35,Default,,0,0,0,,Енді мәселенің уақыты келді.
Dialogue: 0,0:24:01.44,0:24:02.52,Default,,0,0,0,,Бұл теңіз аймағының барлығы
Dialogue: 0,0:24:02.60,0:24:04.06,Default,,0,0,0,,Менің Нишизава шабдалы тобы
Dialogue: 0,0:24:04.15,0:24:05.73,Default,,0,0,0,,Мен оны сатып алдым.
Dialogue: 0,0:24:06.36,0:24:09.23,Default,,0,0,0,,Алдымен алдағы оңтүстік аралда демалыңыз.
Dialogue: 0,0:24:09.32,0:24:11.90,Default,,0,0,0,,Маған эскорт немесе көмек қажет емес.
Dialogue: 0,0:24:11.99,0:24:13.36,Default,,0,0,0,,Мен ақылдымын.
Dialogue: 0,0:24:13.45,0:24:15.37,Default,,0,0,0,,Yaho~ Нацуми-сан!
Dialogue: 0,0:24:15.45,0:24:17.37,Default,,0,0,0,,Иә? Коюки-чан!
Dialogue: 0,0:24:17.45,0:24:20.54,Default,,0,0,0,,Арал қазір көрініп тұр!
Dialogue: 0,0:24:22.50,0:24:25.21,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:24:37.26,0:24:40.31,Default,,0,0,0,,О! Бұл сіз мақсат етіп отырған оңтүстік арал ма?
Dialogue: 0,0:24:41.18,0:24:43.56,Default,,0,0,0,,Бұл өте жақсы жер.
Dialogue: 0,0:24:43.64,0:24:46.44,Default,,0,0,0,,Моа ағасымен демалыста болғанына қуанышты.
Dialogue: 0,0:24:47.52,0:24:49.61,Default,,0,0,0,,Некеге дейінгі саяхат?
Dialogue: 0,0:24:49.69,0:24:51.28,Default,,0,0,0,,Гор!
Dialogue: 0,0:24:51.36,0:24:54.32,Default,,0,0,0,,Егер мен сержантты бір саусақпен ұстасам
Dialogue: 0,0:24:54.40,0:24:56.07,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:24:56.16,0:24:58.66,Default,,0,0,0,,Олай болса, біздің халқымыздың уақыты келді
Dialogue: 0,0:24:58.74,0:25:00.29,Default,,0,0,0,,Пекопонның жазғы дәстүрі...
Dialogue: 0,0:25:01.83,0:25:03.91,Default,,0,0,0,,Қарбызды бөлуден рахат алыңыз!
Dialogue: 0,0:25:04.00,0:25:04.79,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:25:05.87,0:25:07.08,Default,,0,0,0,,Құсу?
Dialogue: 0,0:25:07.67,0:25:09.54,Default,,0,0,0,,Сізді не нәрсе қызықтырады?
Dialogue: 0,0:25:09.63,0:25:11.96,Default,,0,0,0,,Біз басқыншылармыз
Dialogue: 0,0:25:12.05,0:25:13.34,Default,,0,0,0,,О... сабыр етіңіз.
Dialogue: 0,0:25:13.42,0:25:14.42,Default,,0,0,0,,Ефрейтор Жироро
Dialogue: 0,0:25:14.51,0:25:15.43,Default,,0,0,0,,Бұл да дұрыс⸺
Dialogue: 0,0:25:15.51,0:25:16.97,Default,,0,0,0,,Бұл стратегияның бөлігі.
Dialogue: 0,0:25:17.05,0:25:18.39,Default,,0,0,0,,Өтірік, өтірік!
Dialogue: 0,0:25:19.30,0:25:21.68,Default,,0,0,0,,Дұрысы, капитан, стратегия қандай?
Dialogue: 0,0:25:21.77,0:25:23.18,Default,,0,0,0,,Мен сені тыңдамаймын.
Dialogue: 0,0:25:23.27,0:25:23.77,Default,,0,0,0,,Құсу?
Dialogue: 0,0:25:23.85,0:25:25.19,Default,,0,0,0,,Олай болса, қарбызды бөліп алайық.
Dialogue: 0,0:25:25.27,0:25:26.52,Default,,0,0,0,,«Көбірек» бөлімінен барайық
Dialogue: 0,0:25:27.60,0:25:30.52,Default,,0,0,0,,Армагеддон 10 триллионнан 1!
Dialogue: 0,0:25:31.57,0:25:32.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:33.49,0:25:35.74,Default,,0,0,0,,Жиру...
Dialogue: 0,0:25:41.20,0:25:42.12,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:25:42.20,0:25:45.62,Default,,0,0,0,,Дәл, бәрі ыстықта жақсы жүреді.
Dialogue: 0,0:25:45.71,0:25:47.12,Default,,0,0,0,,Кук-кук…
Dialogue: 0,0:25:52.34,0:25:54.34,Default,,0,0,0,,～♪
Dialogue: 0,0:25:54.84,0:25:58.13,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:25:58.22,0:25:59.51,Default,,0,0,0,,Ой!
Dialogue: 0,0:25:59.59,0:26:01.14,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:26:01.97,0:26:02.47,Default,,0,0,0,,Эй!
Dialogue: 0,0:26:02.56,0:26:04.22,Default,,0,0,0,,Иә! Не!
Dialogue: 0,0:26:04.89,0:26:06.23,Default,,0,0,0,,- (Коюки) Ура! -(Нацуми) Йотто!
Dialogue: 0,0:26:06.31,0:26:07.98,Default,,0,0,0,,- (Коюки) Иә! -(Нацуми) Эй!
Dialogue: 0,0:26:08.48,0:26:09.94,Default,,0,0,0,,Уау! Ой!
Dialogue: 0,0:26:10.02,0:26:10.73,Default,,0,0,0,,- (Коюки) Иә! -(Нацуми) Иә!
Dialogue: 0,0:26:11.36,0:26:12.77,Default,,0,0,0,,Ниндзя
Dialogue: 0,0:26:13.90,0:26:14.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:14.53,0:26:16.44,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:26:16.53,0:26:19.70,Default,,0,0,0,,Пухахаха! Не... Нацуми-сан
Dialogue: 0,0:26:19.78,0:26:21.74,Default,,0,0,0,,- (Коюки) Ахахха! -(Нацуми) А?
Dialogue: 0,0:26:22.70,0:26:24.49,Default,,0,0,0,,-(Нацуми) Бұл~! -(Коюки) Кя~!
Dialogue: 0,0:26:24.58,0:26:26.79,Default,,0,0,0,,Эй, күт, Коюки!
Dialogue: 0,0:26:27.29,0:26:30.21,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:26:30.29,0:26:33.21,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:26:33.92,0:26:36.63,Default,,0,0,0,,Ху~ Бұл мен үшін жақсы.
Dialogue: 0,0:26:36.72,0:26:38.72,Default,,0,0,0,,Нишизава мырза, отын ше?
Dialogue: 0,0:26:39.34,0:26:40.89,Default,,0,0,0,,Дайын
Dialogue: 0,0:26:40.97,0:26:42.05,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:26:42.14,0:26:44.64,Default,,0,0,0,,Олай болса, от әлі жанып тұрғанда от жағып алайық.
Dialogue: 0,0:26:45.56,0:26:47.93,Default,,0,0,0,,Иә?Бұл біртүрлі
Dialogue: 0,0:26:48.02,0:26:50.81,Default,,0,0,0,,Сіз сіріңке немесе шақпақ әкелген жоқсыз ба?
Dialogue: 0,0:26:50.90,0:26:54.11,Default,,0,0,0,,А, мынау... Керо Бал
Dialogue: 0,0:26:55.03,0:26:56.57,Default,,0,0,0,,Сержанттан алынған нәрсе.
Dialogue: 0,0:26:56.65,0:26:58.61,Default,,0,0,0,,Мен оны өзіммен бірге қателесіп алып келдім.
Dialogue: 0,0:27:00.20,0:27:01.36,Default,,0,0,0,,Керобол Бұл
Dialogue: 0,0:27:01.45,0:27:03.87,Default,,0,0,0,,Оны иемденуге тек Керон әскерінің капитаны рұқсат етілді⸺
Dialogue: 0,0:27:03.95,0:27:07.75,Default,,0,0,0,,Бұл қорқынышты портативті әмбебап шабуыл қаруына қатысты.
Dialogue: 0,0:27:08.41,0:27:10.96,Default,,0,0,0,,Иә, бұл жұмыс істеуі мүмкін.
Dialogue: 0,0:27:16.17,0:27:18.30,Default,,0,0,0,,- (Фуюки) Ия! - (Момока) Фуфуфуфуфу
Dialogue: 0,0:27:18.38,0:27:19.88,Default,,0,0,0,,Шынымен әмбебап қару
Dialogue: 0,0:27:19.97,0:27:22.14,Default,,0,0,0,,- (Фуюки) Бұл қандай түйме? -(Момока) Уау!
Dialogue: 0,0:27:22.22,0:27:23.09,Default,,0,0,0,,Джутоку пышағы
Dialogue: 0,0:27:23.68,0:27:25.18,Default,,0,0,0,,Бұл керемет, сержант.
Dialogue: 0,0:27:25.26,0:27:27.47,Default,,0,0,0,,Мұны лагерге әкелу керек.
Dialogue: 0,0:27:27.56,0:27:29.56,Default,,0,0,0,,Иә? Сержант?
Dialogue: 0,0:27:30.56,0:27:32.15,Default,,0,0,0,,Мен дәл қазір сонда болсам да
Dialogue: 0,0:27:32.23,0:27:33.15,Default,,0,0,0,,Иә
Dialogue: 0,0:27:33.65,0:27:35.57,Default,,0,0,0,,Ге~логерогерогерогеро
Dialogue: 0,0:27:36.27,0:27:38.11,Default,,0,0,0,,Ақымақ Пекопон халқы
Dialogue: 0,0:27:38.19,0:27:40.24,Default,,0,0,0,,Алаңсыз демалысты тамашалау кезінде
Dialogue: 0,0:27:40.32,0:27:43.70,Default,,0,0,0,,Біздің басқыншылық операциямыз тұрақты түрде жүріп жатыр.
Dialogue: 0,0:27:43.78,0:27:45.95,Default,,0,0,0,,-Ой... бұл рас па? -Апыр-ай!
Dialogue: 0,0:27:46.03,0:27:48.58,Default,,0,0,0,,Нацуми-доно мен Фуюки-дононы абайсызда ұстау.
Dialogue: 0,0:27:48.66,0:27:50.37,Default,,0,0,0,,Біз сайтқа жеткенше
Dialogue: 0,0:27:50.46,0:27:52.46,Default,,0,0,0,,Мен мұны сендерден де жасырдым.
Dialogue: 0,0:27:52.54,0:27:54.92,Default,,0,0,0,,Сержант-сан күткендей!
Dialogue: 0,0:27:55.00,0:27:57.75,Default,,0,0,0,,Мен бұл күлкілі көңілді жай ғана әрекет деп ойлаған емеспін.
Dialogue: 0,0:27:57.84,0:27:59.84,Default,,0,0,0,,Мен бұл туралы ешқашан армандаған емеспін.
Dialogue: 0,0:28:00.47,0:28:02.76,Default,,0,0,0,,Сержант майор Крулл Мысал деректер!
Dialogue: 0,0:28:02.84,0:28:04.51,Default,,0,0,0,,Аспазшы~ Почитто
Dialogue: 0,0:28:06.39,0:28:09.02,Default,,0,0,0,,Ах, өткен күні осы маңдағы теңіз аймағында.
Dialogue: 0,0:28:09.10,0:28:11.56,Default,,0,0,0,,Пекопонда ұйықтап жатқандай көрінетін тағы бір Кируру болды.
Dialogue: 0,0:28:11.64,0:28:13.65,Default,,0,0,0,,Оянған реакция болды.
Dialogue: 0,0:28:13.73,0:28:15.23,Default,,0,0,0,,Не!
Dialogue: 0,0:28:15.31,0:28:18.23,Default,,0,0,0,,Сол ежелгі Керон әскерінің қалдырған теріс мұрасы
Dialogue: 0,0:28:18.32,0:28:22.15,Default,,0,0,0,,Қорқынышты биологиялық қару Кируру қайта жанданды дейсіз бе?
Dialogue: 0,0:28:22.24,0:28:23.45,Default,,0,0,0,,Аспаз ~
Dialogue: 0,0:28:23.53,0:28:27.87,Default,,0,0,0,,Алайда сол қозу реакциясы әп-сәтте жоғалып кетті.
Dialogue: 0,0:28:28.37,0:28:31.04,Default,,0,0,0,,Күшті энергиялардың интерференциясы арқылы.
Dialogue: 0,0:28:31.12,0:28:32.75,Default,,0,0,0,,Сол Кируру
Dialogue: 0,0:28:32.83,0:28:35.75,Default,,0,0,0,,Бір мезетте болатын қуат
Dialogue: 0,0:28:36.63,0:28:37.84,Default,,0,0,0,,Сонымен, бұл стратегия
Dialogue: 0,0:28:38.88,0:28:41.17,Default,,0,0,0,,Сол энергияның кім екенін табыңыз
Dialogue: 0,0:28:41.26,0:28:43.76,Default,,0,0,0,,Біз оны Пекопонға басып кіру үшін пайдаланамыз!
Dialogue: 0,0:28:44.51,0:28:45.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:45.89,0:28:48.60,Default,,0,0,0,,Сізде осындай ой болды ма?
Dialogue: 0,0:28:48.68,0:28:51.68,Default,,0,0,0,,Кешіріңіз, Кероро, мен таяз болдым...
Dialogue: 0,0:28:52.48,0:28:53.94,Default,,0,0,0,,Госсосан~
Dialogue: 0,0:28:54.02,0:28:56.15,Default,,0,0,0,,Фу~ Жедім, жедім.
Dialogue: 0,0:28:56.73,0:28:58.90,Default,,0,0,0,,-Фуюки-доно, десертке не бар? - (Фуюки) А?
Dialogue: 0,0:28:58.98,0:29:01.15,Default,,0,0,0,,Бұл сержанттың сүйікті жұлдызды жемісі.
Dialogue: 0,0:29:01.23,0:29:02.65,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:29:02.74,0:29:04.70,Default,,0,0,0,,Сонымен... болды, десертті жеген соң.
Dialogue: 0,0:29:04.78,0:29:07.16,Default,,0,0,0,,Бәріміз де жігерімізді сынаймыз ба? Батылдығыңызды сынап көріңіз!
Dialogue: 0,0:29:08.03,0:29:10.66,Default,,0,0,0,,Бұл да... актерлік, солай ма?
Dialogue: 0,0:29:10.74,0:29:11.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:12.04,0:29:13.54,Default,,0,0,0,,Не болды? Азумая мырза
Dialogue: 0,0:29:14.29,0:29:16.04,Default,,0,0,0,,Айтпақшы, Нацуми ше?
Dialogue: 0,0:29:16.62,0:29:17.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:18.00,0:29:20.80,Default,,0,0,0,,Иә, бұл өте ыңғайлы.
Dialogue: 0,0:29:20.88,0:29:22.05,Default,,0,0,0,,Ауа райы да жақсы болды.
Dialogue: 0,0:29:22.63,0:29:25.80,Default,,0,0,0,,Хехехе, дәл солай. Мама дұрыс айтады.
Dialogue: 0,0:29:25.88,0:29:27.05,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:29:27.14,0:29:31.14,Default,,0,0,0,,Тым~ Бұл мерзімнен бұрын ұрыс алаңы.
Dialogue: 0,0:29:31.22,0:29:33.68,Default,,0,0,0,,Анам менімен бірге барғысы келді.
Dialogue: 0,0:29:33.77,0:29:35.23,Default,,0,0,0,,Хината-сан, күте тұр!
Dialogue: 0,0:29:35.31,0:29:36.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:29:36.14,0:29:38.65,Default,,0,0,0,,Бірақ ол мамасының баласы.
Dialogue: 0,0:29:38.73,0:29:40.44,Default,,0,0,0,,Нацуми осында болғанша бәрібір
Dialogue: 0,0:29:40.52,0:29:41.48,Default,,0,0,0,,А...
Dialogue: 0,0:29:42.23,0:29:43.86,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:29:43.94,0:29:46.28,Default,,0,0,0,,А, жоқ, ештеңе.
Dialogue: 0,0:29:46.36,0:29:49.82,Default,,0,0,0,,Иә... онда оны қысқарту уақыты келді.
Dialogue: 0,0:29:49.91,0:29:51.12,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:29:51.20,0:29:54.08,Default,,0,0,0,,Иә, жұмысыңызға сәттілік.
Dialogue: 0,0:29:55.04,0:29:55.79,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:29:57.71,0:29:58.58,Default,,0,0,0,,Хаа…
Dialogue: 0,0:30:06.30,0:30:07.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:07.68,0:30:08.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:13.81,0:30:14.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:14.56,0:30:15.81,Default,,0,0,0,,Кя~!
Dialogue: 0,0:30:15.89,0:30:17.23,Default,,0,0,0,,Нацуми!
Dialogue: 0,0:30:19.02,0:30:20.19,Default,,0,0,0,,Бірдеңе келе жатыр
Dialogue: 0,0:30:23.73,0:30:24.69,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:30:25.28,0:30:26.65,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,0:30:27.82,0:30:28.70,Default,,0,0,0,,Барлығың жүгіріңдер!
Dialogue: 0,0:30:29.45,0:30:29.95,Default,,0,0,0,,Қый!
Dialogue: 0,0:30:33.62,0:30:35.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:35.29,0:30:36.62,Default,,0,0,0,,Жата тұр, Нацуми!
Dialogue: 0,0:30:36.70,0:30:37.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:30:42.34,0:30:43.96,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,0:30:45.51,0:30:46.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:46.26,0:30:47.76,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,0:30:47.84,0:30:48.42,Default,,0,0,0,,Фуюки-кун!
Dialogue: 0,0:30:48.51,0:30:50.01,Default,,0,0,0,,Әпке!
Dialogue: 0,0:30:50.93,0:30:51.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:51.68,0:30:52.72,Default,,0,0,0,,Фуюки!
Dialogue: 0,0:30:53.35,0:30:54.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:54.72,0:30:57.02,Default,,0,0,0,,Әй... Әй, бұл не?!
Dialogue: 0,0:30:57.68,0:30:58.81,Default,,0,0,0,,Нацуми-доно!
Dialogue: 0,0:30:58.89,0:30:59.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:59.48,0:31:00.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:01.27,0:31:03.86,Default,,0,0,0,,- Құсу~! -(Нацуми) Жоқ!
Dialogue: 0,0:31:05.65,0:31:06.82,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,0:31:09.40,0:31:11.45,Default,,0,0,0,,Қарғыс атқыр... сен кімсің!
Dialogue: 0,0:31:12.62,0:31:16.08,Default,,0,0,0,,Аспаз~ Бұл сол түндегідей энергетикалық реакция.
Dialogue: 0,0:31:16.16,0:31:19.04,Default,,0,0,0,,Бұл жігіттер Кируру дегенді білдіре ме?
Dialogue: 0,0:31:19.12,0:31:20.58,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:31:22.42,0:31:24.38,Default,,0,0,0,,Әлем үшін, өзгелер үшін—
Dialogue: 0,0:31:24.46,0:31:25.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:31:25.13,0:31:27.21,Default,,0,0,0,,Қарғыс атсын, жолдан кет!
Dialogue: 0,0:31:29.47,0:31:30.72,Default,,0,0,0,,- (Коюки) Додж! -(Момока/Фуюки) Уау!
Dialogue: 0,0:31:30.80,0:31:32.05,Default,,0,0,0,,Құсу!
Dialogue: 0,0:31:32.55,0:31:33.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:33.93,0:31:35.47,Default,,0,0,0,,Иә, сержант!
Dialogue: 0,0:31:36.14,0:31:37.18,Default,,0,0,0,,Мынаны пайдаланыңыз!
Dialogue: 0,0:31:37.27,0:31:37.81,Default,,0,0,0,,Құсу?
Dialogue: 0,0:31:39.89,0:31:42.02,Default,,0,0,0,,О, Керобол!
Dialogue: 0,0:31:42.10,0:31:42.77,Default,,0,0,0,,Бугит
Dialogue: 0,0:31:43.27,0:31:45.94,Default,,0,0,0,,Осы бізде болса, әлгі жігіттер бақытты болар еді.
Dialogue: 0,0:31:46.02,0:31:49.03,Default,,0,0,0,,Үш жануар бірге Тенчу!
Dialogue: 0,0:31:50.15,0:31:51.61,Default,,0,0,0,,Құсу? Бұл қате болды ма?
Dialogue: 0,0:31:51.70,0:31:52.91,Default,,0,0,0,,Сонымен, бұл?
Dialogue: 0,0:31:52.99,0:31:54.03,Default,,0,0,0,,Әлде бұл?
Dialogue: 0,0:31:54.12,0:31:55.16,Default,,0,0,0,,Сержант?
Dialogue: 0,0:31:55.24,0:31:56.83,Default,,0,0,0,,Иә, Мамайо!
Dialogue: 0,0:31:57.74,0:32:00.12,Default,,0,0,0,,- (Фуюки және басқалар) Уау! - Құсу!
Dialogue: 0,0:32:05.75,0:32:06.92,Default,,0,0,0,,Құсу…
Dialogue: 0,0:32:08.00,0:32:09.05,Default,,0,0,0,,Бұлыңғыр бақа!
Dialogue: 0,0:32:09.55,0:32:11.17,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:32:13.30,0:32:16.05,Default,,0,0,0,,Әпке! Әпке!
Dialogue: 0,0:32:16.14,0:32:16.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:17.22,0:32:18.14,Default,,0,0,0,,Фуюки-кун!
Dialogue: 0,0:32:18.22,0:32:19.52,Default,,0,0,0,,Мен оны енді көре алмаймын
Dialogue: 0,0:32:19.60,0:32:22.77,Default,,0,0,0,,Қарғыс атсын, мен сені лордрейжеріммен қуамын.
Dialogue: 0,0:32:35.03,0:32:35.87,Default,,0,0,0,,Кеттік
Dialogue: 0,0:33:14.45,0:33:18.41,Default,,0,0,0,,Ана... Фую-кун... ол қайда?
Dialogue: 0,0:33:18.91,0:33:19.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:20.20,0:33:20.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:26.75,0:33:27.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:30.09,0:33:31.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:38.76,0:33:40.14,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:33:40.22,0:33:42.43,Default,,0,0,0,,Сіз ояусыз ба? ханшайым
Dialogue: 0,0:33:42.93,0:33:43.43,Default,,0,0,0,,Кім?
Dialogue: 0,0:33:44.02,0:33:45.94,Default,,0,0,0,,Күдікті адам емес
Dialogue: 0,0:33:49.19,0:33:52.07,Default,,0,0,0,,Терең теңіз ханшайымы Нацумиге қош келдіңіз
Dialogue: 0,0:33:52.15,0:33:55.49,Default,,0,0,0,,Бізді қарсы алған түнгі армандар өрескел әрекет жасады.
Dialogue: 0,0:33:55.57,0:33:56.95,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:33:57.53,0:34:00.41,Default,,0,0,0,,Терең теңіз? Алып алу дегенді қалай түсінесіңдер?
Dialogue: 0,0:34:00.49,0:34:01.91,Default,,0,0,0,,Сонымен... Ханшайым?
Dialogue: 0,0:34:01.99,0:34:03.45,Default,,0,0,0,,Эй... эй! мен?
Dialogue: 0,0:34:04.08,0:34:05.12,Default,,0,0,0,,Иә
Dialogue: 0,0:34:05.20,0:34:07.87,Default,,0,0,0,,Ханзада Мер сізді бірінші рет көрді.
Dialogue: 0,0:34:07.96,0:34:09.08,Default,,0,0,0,,Сәлем, Марл!
Dialogue: 0,0:34:09.83,0:34:11.34,Default,,0,0,0,,Ханзада қызметшісінің алдында
Dialogue: 0,0:34:11.42,0:34:14.01,Default,,0,0,0,,Ханшайыммен сонша сөйлесу қулық.
Dialogue: 0,0:34:14.09,0:34:15.42,Default,,0,0,0,,Сіз артқа тұрыңыз.
Dialogue: 0,0:34:15.51,0:34:18.09,Default,,0,0,0,,Кешіріңіз, ханзада.
Dialogue: 0,0:34:18.59,0:34:19.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:22.43,0:34:23.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:29.31,0:34:30.81,Default,,0,0,0,,Қош келдіңіз ханшайым
Dialogue: 0,0:34:31.31,0:34:32.94,Default,,0,0,0,,Менің атым Пошта
Dialogue: 0,0:34:33.02,0:34:35.49,Default,,0,0,0,,Нацуми сен бүгіннен бастап менің ханшайымымсың.
Dialogue: 0,0:34:35.57,0:34:36.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:36.69,0:34:37.61,Default,,0,0,0,,Ханзада Мер
Dialogue: 0,0:34:37.70,0:34:40.28,Default,,0,0,0,,Сен сияқты күшті, мейірімді ханшайым
Dialogue: 0,0:34:40.36,0:34:41.49,Default,,0,0,0,,Мен сені іздедім.
Dialogue: 0,0:34:42.24,0:34:44.99,Default,,0,0,0,,Көптеген жүздеген жылдар бойы
Dialogue: 0,0:34:45.08,0:34:47.00,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:34:47.08,0:34:49.79,Default,,0,0,0,,Нацуми қасымда болса, мен енді жалғыз қалмаймын.
Dialogue: 0,0:34:50.29,0:34:51.75,Default,,0,0,0,,Маған мына жігіт хабарлады.
Dialogue: 0,0:34:53.04,0:34:54.34,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:34:54.42,0:34:56.84,Default,,0,0,0,,Ханшайымдарды зерттеуге арналған кошмар
Dialogue: 0,0:34:56.92,0:35:00.55,Default,,0,0,0,,Бұлдыраған бақа деп аталатын бес ерекше жаратылысқа.
Dialogue: 0,0:35:00.64,0:35:02.85,Default,,0,0,0,,Сіздің тамаша жауапыңызды қараңыз.
Dialogue: 0,0:35:03.43,0:35:05.60,Default,,0,0,0,,Ханзада шешім қабылдады
Dialogue: 0,0:35:05.68,0:35:08.10,Default,,0,0,0,,Ерекше тіршілік иелері
Dialogue: 0,0:35:08.18,0:35:11.35,Default,,0,0,0,,Әрине, мен олармен айналысуға үйреніп қалғанмын.
Dialogue: 0,0:35:11.44,0:35:12.48,Default,,0,0,0,,- Құсу~! -(Нацуми) А?
Dialogue: 0,0:35:13.06,0:35:14.86,Default,,0,0,0,,Қазіргі бұлыңғыр бақа!
Dialogue: 0,0:35:14.94,0:35:17.07,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:35:17.69,0:35:19.74,Default,,0,0,0,,Құсу!
Dialogue: 0,0:35:21.82,0:35:24.24,Default,,0,0,0,,Ханзада Мер Осындай нәрсе
Dialogue: 0,0:35:24.33,0:35:24.83,Default,,0,0,0,,Құсу
Dialogue: 0,0:35:25.66,0:35:26.58,Default,,0,0,0,,Не!
Dialogue: 0,0:35:26.66,0:35:28.08,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:35:28.16,0:35:29.33,Default,,0,0,0,,Ха! ханзада!
Dialogue: 0,0:35:30.41,0:35:33.29,Default,,0,0,0,,Мынау.
Dialogue: 0,0:35:33.38,0:35:34.50,Default,,0,0,0,,Екеуің Кируруға мөр бастыңдар⸺
Dialogue: 0,0:35:34.59,0:35:36.34,Default,,0,0,0,,Сізде үлкен күш бар ма?
Dialogue: 0,0:35:36.96,0:35:37.96,Default,,0,0,0,,Кируру?
Dialogue: 0,0:35:38.05,0:35:39.01,Default,,0,0,0,,Ханзада Меру
Dialogue: 0,0:35:39.09,0:35:43.34,Default,,0,0,0,,Қараңдаршы, ол ақ түсті, үлкен, маңдайында тырнақшасы бар.
Dialogue: 0,0:35:43.43,0:35:45.35,Default,,0,0,0,,А, анау жігіт.
Dialogue: 0,0:35:45.43,0:35:47.72,Default,,0,0,0,,Өйткені сіз біздің аумақты жоймақ болдыңыз.
Dialogue: 0,0:35:47.81,0:35:49.06,Default,,0,0,0,,Мен оны жеңдім.
Dialogue: 0,0:35:49.14,0:35:51.35,Default,,0,0,0,,Ол шын мәнінде онша үлкен жігіт емес еді.
Dialogue: 0,0:35:51.44,0:35:54.06,Default,,0,0,0,,Түсіндім! бұл тамаша
Dialogue: 0,0:35:54.15,0:35:58.28,Default,,0,0,0,,Қалай болғанда да, халқымыз үшін күш-қуатыңызды берер едіңіз.
Dialogue: 0,0:35:58.36,0:36:01.90,Default,,0,0,0,,Алдымен мына достық шартына қол қойыңыз.
Dialogue: 0,0:36:01.99,0:36:04.87,Default,,0,0,0,,Осы кітапшаны кейінірек баяу оқып шығыңыз...
Dialogue: 0,0:36:04.95,0:36:06.74,Default,,0,0,0,,Сіз дөрекісіз.
Dialogue: 0,0:36:06.83,0:36:08.58,Default,,0,0,0,,Құсу... дөрекі?
Dialogue: 0,0:36:08.66,0:36:09.75,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:36:11.91,0:36:13.62,Default,,0,0,0,,Бір... Қызықсыз...
Dialogue: 0,0:36:14.25,0:36:15.63,Default,,0,0,0,,Бұны лақтырыңыз.
Dialogue: 0,0:36:15.71,0:36:16.38,Default,,0,0,0,,- Құсу? -(Нацуми) А?
Dialogue: 0,0:36:16.46,0:36:17.71,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:36:17.80,0:36:19.51,Default,,0,0,0,,-Аа... -(Нацуми) Эй, тоқтат.
Dialogue: 0,0:36:19.59,0:36:21.09,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:36:21.17,0:36:24.72,Default,,0,0,0,,Маған дәл қазір керек нәрсе...
Dialogue: 0,0:36:24.80,0:36:27.01,Default,,0,0,0,,Нацуми ханшайым, сен жалғызсың
Dialogue: 0,0:36:27.10,0:36:29.47,Default,,0,0,0,,Құсу? P... Ханшайым?
Dialogue: 0,0:36:29.56,0:36:30.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:36:30.77,0:36:33.06,Default,,0,0,0,,Мен... Не болып жатқанын білмеймін...
Dialogue: 0,0:36:33.14,0:36:33.90,Default,,0,0,0,,- Құсу~! -(Нацуми) Ах.
Dialogue: 0,0:36:34.60,0:36:37.40,Default,,0,0,0,,Та... Көмектесіңізші~ Ханшайым!
Dialogue: 0,0:36:37.48,0:36:38.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:38.98,0:36:40.11,Default,,0,0,0,,Бұлыңғыр бақа!
Dialogue: 0,0:36:40.19,0:36:42.11,Default,,0,0,0,,Ги-ро!
Dialogue: 0,0:36:43.70,0:36:45.03,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:36:46.03,0:36:48.37,Default,,0,0,0,,Ал, енді қиындық жоқ.
Dialogue: 0,0:36:49.58,0:36:51.16,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:36:51.25,0:36:53.08,Default,,0,0,0,,Барлығына қазір оралыңыз!
Dialogue: 0,0:36:53.16,0:36:56.00,Default,,0,0,0,,Нацуми, ашуланба.
Dialogue: 0,0:36:56.08,0:36:58.59,Default,,0,0,0,,Мен сендерге жақсы орын дайындап қойдым.
Dialogue: 0,0:36:59.30,0:37:01.51,Default,,0,0,0,,Сізге ұнайтынына сенімдімін.
Dialogue: 0,0:37:02.09,0:37:02.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:02.67,0:37:03.76,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:37:06.51,0:37:07.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:08.14,0:37:09.60,Default,,0,0,0,,Не?
Dialogue: 0,0:37:15.69,0:37:16.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:19.69,0:37:23.19,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:37:33.29,0:37:35.71,Default,,0,0,0,,Бұл Нацумидің естеліктерінен құрылған қала.
Dialogue: 0,0:37:35.79,0:37:38.46,Default,,0,0,0,,Нацумидің сүйікті қаласы
Dialogue: 0,0:37:47.43,0:37:49.85,Default,,0,0,0,,Менің сүйікті қалам?
Dialogue: 0,0:37:49.93,0:37:51.35,Default,,0,0,0,,Иә, сіздің қалаңыз
Dialogue: 0,0:37:52.26,0:37:55.18,Default,,0,0,0,,Енді бізге ханшайымның тұруы үшін сарай керек.
Dialogue: 0,0:37:55.69,0:37:58.23,Default,,0,0,0,,Нацуми сарайы Нацуми сарайы
Dialogue: 0,0:37:59.52,0:38:00.69,Default,,0,0,0,,Нацуми сарайы…
Dialogue: 0,0:38:31.05,0:38:32.39,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:38:41.48,0:38:44.32,Default,,0,0,0,,Кируруды жеңгеніңізге сене алар емеспін...
Dialogue: 0,0:38:44.40,0:38:46.40,Default,,0,0,0,,Әлгі ғажап жігіттер апамды алып кетті...
Dialogue: 0,0:38:46.99,0:38:49.74,Default,,0,0,0,,Ағаң қасыңда болса жақсы.
Dialogue: 0,0:38:50.32,0:38:53.53,Default,,0,0,0,,Уайымдама, мен сені міндетті түрде құтқарамын.
Dialogue: 0,0:38:53.62,0:38:54.99,Default,,0,0,0,,Мен оны талдай алдым.
Dialogue: 0,0:38:55.08,0:38:57.41,Default,,0,0,0,,Бұл биологиялық механизм.
Dialogue: 0,0:38:57.50,0:38:59.75,Default,,0,0,0,,Әрине, Пекопонның ғылыми қабілеті мұны істей алмайды.
Dialogue: 0,0:39:00.46,0:39:03.59,Default,,0,0,0,,Жау нәсілінің ісі ме? Неліктен Нацуми?
Dialogue: 0,0:39:03.67,0:39:06.09,Default,,0,0,0,,Әй, әдемі медуза...
Dialogue: 0,0:39:09.80,0:39:13.93,Default,,0,0,0,,Ағай... сізді бәріміз тез арада құтқарамыз.
Dialogue: 0,0:39:14.01,0:39:16.85,Default,,0,0,0,,Соған дейін мен Нацуми-санға қамқор боламын...
Dialogue: 0,0:39:16.93,0:39:19.35,Default,,0,0,0,,Теюука ағай табылды!
Dialogue: 0,0:39:20.94,0:39:22.31,Default,,0,0,0,,Жаман кетпей ме?
Dialogue: 0,0:39:22.40,0:39:24.11,Default,,0,0,0,,Олар мүлдем шектен шыққан!
Dialogue: 0,0:39:24.69,0:39:27.49,Default,,0,0,0,,Адамдардың жұмысы нашар деген нені білдіреді?
Dialogue: 0,0:39:27.57,0:39:29.61,Default,,0,0,0,,Сонда сіздің әпкеңізге не болды?
Dialogue: 0,0:39:29.70,0:39:32.87,Default,,0,0,0,,Аа, мен Нацуми-доно туралы ештеңе білмеймін.
Dialogue: 0,0:39:32.95,0:39:34.78,Default,,0,0,0,,Мен олардың ханшайымы болатын сияқтымын
Dialogue: 0,0:39:34.87,0:39:36.74,Default,,0,0,0,,Не? Бұл ханшайым!
Dialogue: 0,0:39:36.83,0:39:39.08,Default,,0,0,0,,Иә, ханшайым
Dialogue: 0,0:39:39.16,0:39:40.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:39:40.29,0:39:41.12,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:39:41.21,0:39:45.25,Default,,0,0,0,,Керороның миы жұлдызды жемістердің нәрлендіретін сергітетін күшін алған кезде жоғары жылдамдықпен айналдырды.
Dialogue: 0,0:39:46.00,0:39:47.17,Default,,0,0,0,,Сержант?
Dialogue: 0,0:39:47.25,0:39:49.22,Default,,0,0,0,,Эй Кероро, не болды?
Dialogue: 0,0:39:49.30,0:39:50.76,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:39:51.43,0:39:53.89,Default,,0,0,0,,Мен тамаша стратегия ойлап таптым.
Dialogue: 0,0:39:53.97,0:39:55.26,Default,,0,0,0,,Джеро Джеро Ринчо
Dialogue: 0,0:40:03.90,0:40:04.90,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:40:11.07,0:40:12.49,Default,,0,0,0,,Жүр, ханшайым
Dialogue: 0,0:40:16.08,0:40:17.91,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:40:22.92,0:40:24.75,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:40:26.63,0:40:28.42,Default,,0,0,0,,Не? Ол саған ұнады ма?
Dialogue: 0,0:40:29.13,0:40:31.05,Default,,0,0,0,,Егер сіз ана допты қолдансаңыз
Dialogue: 0,0:40:31.13,0:40:34.80,Default,,0,0,0,,Сіз өзіңіздің суретіңізде немесе жадыңызда кез келген нәрсені заттай аласыз.
Dialogue: 0,0:40:34.89,0:40:36.93,Default,,0,0,0,,Сіз тағы да сөйлейсіз!
Dialogue: 0,0:40:37.01,0:40:38.60,Default,,0,0,0,,Мен түсіндіремін!
Dialogue: 0,0:40:38.68,0:40:41.31,Default,,0,0,0,,Кешіріңіз, ханзада.
Dialogue: 0,0:40:41.39,0:40:45.23,Default,,0,0,0,,Өйткені, Марле әрқашан осылай...
Dialogue: 0,0:40:45.31,0:40:45.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:46.77,0:40:47.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:48.65,0:40:49.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:50.61,0:40:51.82,Default,,0,0,0,,- (Электрондық пошта) Нацуми - (Нацуми) Иә?
Dialogue: 0,0:40:52.49,0:40:54.07,Default,,0,0,0,,Міне, міне...
Dialogue: 0,0:40:54.16,0:40:55.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:01.16,0:41:02.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:03.37,0:41:05.33,Default,,0,0,0,,Ханзада, шыдамсыздық танытпаңыз.
Dialogue: 0,0:41:05.42,0:41:07.04,Default,,0,0,0,,- (электрондық пошта) наурыз! -(Марле) А...
Dialogue: 0,0:41:07.13,0:41:08.29,Default,,0,0,0,,Не?
Dialogue: 0,0:41:09.00,0:41:10.21,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:41:10.71,0:41:11.76,Default,,0,0,0,,Нацуми
Dialogue: 0,0:41:13.34,0:41:15.84,Default,,0,0,0,,Нацуми қаласын аралауға барайық
Dialogue: 0,0:41:15.93,0:41:17.85,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:41:20.06,0:41:21.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:22.73,0:41:23.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:27.02,0:41:30.69,Default,,0,0,0,,Жарайды, мен болсам қорықпайсың.
Dialogue: 0,0:41:33.57,0:41:35.36,Default,,0,0,0,,Жүріңіз, ханшайым.
Dialogue: 0,0:41:35.45,0:41:37.28,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:41:44.87,0:41:45.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:41:54.88,0:41:56.55,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:41:58.43,0:42:00.85,Default,,0,0,0,,Ахахха хехехехе
Dialogue: 0,0:42:03.64,0:42:05.06,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:42:05.14,0:42:07.10,Default,,0,0,0,,Бұл өте сағыныш сезімін тудырады.
Dialogue: 0,0:42:07.19,0:42:08.23,Default,,0,0,0,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:42:08.31,0:42:10.69,Default,,0,0,0,,Бұл жер ханшайымның есінде⸺
Dialogue: 0,0:42:10.77,0:42:12.78,Default,,0,0,0,,Өйткені бұл ханшайымның сүйікті қаласы.
Dialogue: 0,0:42:13.44,0:42:15.78,Default,,0,0,0,,Менің сүйікті қалам...
Dialogue: 0,0:42:15.86,0:42:17.53,Default,,0,0,0,,- (электрондық пошта) Уау! -(Нацуми) А?
Dialogue: 0,0:42:17.61,0:42:19.87,Default,,0,0,0,,Эй, эй, бұл не?
Dialogue: 0,0:42:20.66,0:42:22.03,Default,,0,0,0,,Онда барайық
Dialogue: 0,0:42:25.54,0:42:26.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:30.29,0:42:31.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:32.84,0:42:35.05,Default,,0,0,0,,Күте тұрыңыз, ханзада!
Dialogue: 0,0:42:35.71,0:42:38.18,Default,,0,0,0,,Екеуің де қасымнан кетпеңдер.
Dialogue: 0,0:42:38.80,0:42:40.72,Default,,0,0,0,,Адасып қалсаң да білмейсің.
Dialogue: 0,0:42:40.80,0:42:41.43,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:42:41.51,0:42:43.97,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:42:44.06,0:42:45.93,Default,,0,0,0,,Бұлай жүгіру қауіпті!
Dialogue: 0,0:42:46.02,0:42:47.48,Default,,0,0,0,,Ахаха ахахха
Dialogue: 0,0:42:47.56,0:42:49.19,Default,,0,0,0,,Күте тұрыңыз~ Ханзада!
Dialogue: 0,0:42:49.27,0:42:50.69,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:42:50.77,0:42:52.19,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:42:52.27,0:42:55.44,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:42:55.53,0:42:57.74,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:42:57.82,0:42:59.24,Default,,0,0,0,,Хахаха
Dialogue: 0,0:42:59.82,0:43:01.49,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:43:02.41,0:43:03.70,Default,,0,0,0,,Хехехе
Dialogue: 0,0:43:07.75,0:43:08.46,Default,,0,0,0,,Марл?
Dialogue: 0,0:43:11.54,0:43:14.42,Default,,0,0,0,,Сондықтан мен саған кетпе деп айттым.
Dialogue: 0,0:43:14.50,0:43:16.17,Default,,0,0,0,,Марл!
Dialogue: 0,0:43:17.63,0:43:18.76,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:43:24.43,0:43:26.10,Default,,0,0,0,,Эй
Dialogue: 0,0:43:27.31,0:43:29.35,Default,,0,0,0,,Танжиро мен Незуко Қандыперделерді жоюшылар корпусының мүшелері ретінде шайқаса алатынын,
Dialogue: 0,0:43:29.44,0:43:32.06,Default,,0,0,0,,Ах! Егер сіз қашып кететін болсаңыз, қазір уақыт емес
Dialogue: 0,0:43:32.94,0:43:33.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:43:33.52,0:43:35.86,Default,,0,0,0,,Нацуми ханшайым, бұл үлкен мәселе.
Dialogue: 0,0:43:35.94,0:43:37.11,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:43:37.19,0:43:39.86,Default,,0,0,0,,Мен ханзада Мерді көре алмаймын.
Dialogue: 0,0:43:41.20,0:43:42.78,Default,,0,0,0,,Майури
Dialogue: 0,0:43:42.87,0:43:45.24,Default,,0,0,0,,Ханзада! сен қайдасың?
Dialogue: 0,0:43:45.33,0:43:46.62,Default,,0,0,0,,Ханзада Мер!
Dialogue: 0,0:43:47.54,0:43:49.91,Default,,0,0,0,,Электрондық пошта! қайда?
Dialogue: 0,0:43:50.00,0:43:52.12,Default,,0,0,0,,Ханзада? Prince Mail!
Dialogue: 0,0:43:52.21,0:43:56.30,Default,,0,0,0,,Мен мұны не үшін жасадым...
Dialogue: 0,0:43:56.38,0:43:56.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:59.42,0:44:02.80,Default,,0,0,0,,Мен ханзаданы алғаш көрген жерім осы.
Dialogue: 0,0:44:02.89,0:44:04.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:44:04.76,0:44:08.39,Default,,0,0,0,,(электрондық поштаны жылау)
Dialogue: 0,0:44:11.94,0:44:13.40,Default,,0,0,0,,- (Нацуми) Ита - (Электрондық пошта) Ах.
Dialogue: 0,0:44:15.65,0:44:17.15,Default,,0,0,0,,Ханзада ашылды
Dialogue: 0,0:44:17.78,0:44:18.78,Default,,0,0,0,,Нацуми...
Dialogue: 0,0:44:18.86,0:44:20.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:20.99,0:44:23.66,Default,,0,0,0,,Не? Есікті қалай ашу керектігін білмедіңіз бе?
Dialogue: 0,0:44:23.74,0:44:24.41,Default,,0,0,0,,- (электрондық пошта) Уф! -(Нацуми) Ах.
Dialogue: 0,0:44:24.49,0:44:28.41,Default,,0,0,0,,(электрондық пошта айқайы)
Dialogue: 0,0:44:29.83,0:44:35.13,Default,,0,0,0,,(электрондық поштаны жылау)
Dialogue: 0,0:44:35.21,0:44:37.17,Default,,0,0,0,,Қазір дұрыс емес Электрондық пошта
Dialogue: 0,0:44:42.88,0:44:45.22,Default,,0,0,0,,Бастапқыда бұл Марле кінәлі!
Dialogue: 0,0:44:45.30,0:44:47.76,Default,,0,0,0,,Ха! Кешіріңіз, ханзада.
Dialogue: 0,0:44:48.97,0:44:49.93,Default,,0,0,0,,Нихи
Dialogue: 0,0:44:52.77,0:44:53.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:44:54.40,0:44:57.56,Default,,0,0,0,,Ей, сендер кімсіңдер?
Dialogue: 0,0:44:58.23,0:45:01.15,Default,,0,0,0,,Сен кімсің... Мен өзіммін.
Dialogue: 0,0:45:01.82,0:45:03.11,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:45:03.20,0:45:04.66,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:45:05.24,0:45:07.45,Default,,0,0,0,,Кішкентай кезімнен Марлемен біргемін.
Dialogue: 0,0:45:07.53,0:45:10.49,Default,,0,0,0,,Мен теңізде тұрдым, болды.
Dialogue: 0,0:45:10.99,0:45:11.87,Default,,0,0,0,,Тіпті Нацуми
Dialogue: 0,0:45:11.95,0:45:14.37,Default,,0,0,0,,Тіпті сізден «Сіз кімсіз?» деп сұраса да. жауап бере алмас едіңіз.
Dialogue: 0,0:45:15.42,0:45:17.33,Default,,0,0,0,,Мен адаммын
Dialogue: 0,0:45:17.42,0:45:20.09,Default,,0,0,0,,Сонда бұл қандай адам?
Dialogue: 0,0:45:20.59,0:45:22.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:45:37.56,0:45:40.27,Default,,0,0,0,,Додо додо...
Dialogue: 0,0:45:40.36,0:45:43.36,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:45:44.07,0:45:46.99,Default,,0,0,0,,Ахаха бьорн
Dialogue: 0,0:45:47.07,0:45:50.12,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:45:50.87,0:45:51.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:57.46,0:45:58.79,Default,,0,0,0,,Сол шар...
Dialogue: 0,0:45:58.88,0:45:59.96,Default,,0,0,0,,- (электрондық пошта) О, дұрыс! -(Нацуми) Ах...
Dialogue: 0,0:46:00.04,0:46:03.67,Default,,0,0,0,,Керісінше мен саған сыйлық беремін.
Dialogue: 0,0:46:03.76,0:46:06.47,Default,,0,0,0,,Не? Эй... эй!
Dialogue: 0,0:46:12.22,0:46:13.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:14.10,0:46:17.27,Default,,0,0,0,,Тіпті Ханзаданың келбеті де сен қалағандай.
Dialogue: 0,0:46:20.19,0:46:21.69,Default,,0,0,0,,Иә! Уф... бұл өтірік!
Dialogue: 0,0:46:25.19,0:46:26.57,Default,,0,0,0,,Сәлем Нацуми-чан
Dialogue: 0,0:46:27.15,0:46:28.74,Default,,0,0,0,,Сабуро-сенпай!
Dialogue: 0,0:46:28.82,0:46:31.58,Default,,0,0,0,,Бұл әдемі көйлек. Саған өте жарасады.
Dialogue: 0,0:46:32.24,0:46:33.49,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:46:34.66,0:46:37.08,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:46:41.67,0:46:44.13,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сияқты?
Dialogue: 0,0:46:44.21,0:46:47.09,Default,,0,0,0,,Мен оны Нацумидің басындағы суреттен жасадым.
Dialogue: 0,0:46:47.17,0:46:49.59,Default,,0,0,0,,Рамейо сомня...
Dialogue: 0,0:46:50.26,0:46:52.43,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:46:52.93,0:46:54.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:58.44,0:46:59.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:47:03.86,0:47:05.44,Default,,0,0,0,,Бұл төтенше жағдай
Dialogue: 0,0:47:07.32,0:47:08.70,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:47:13.66,0:47:16.54,Default,,0,0,0,,Құлып ішіндегі барлық аймақтар дабылда.
Dialogue: 0,0:47:18.41,0:47:19.16,Default,,0,0,0,,Құсу?
Dialogue: 0,0:47:19.67,0:47:21.79,Default,,0,0,0,,Ge gya gya gya...
Dialogue: 0,0:47:22.92,0:47:25.05,Default,,0,0,0,,Бұл тағы да баяғы ескі бақа ма?
Dialogue: 0,0:47:28.47,0:47:31.47,Default,,0,0,0,,Ханымдар мен мырзалар!
Dialogue: 0,0:47:31.55,0:47:32.55,Default,,0,0,0,,Сіз борттасыз ба?
Dialogue: 0,0:47:32.64,0:47:34.10,Default,,0,0,0,,Онда жоқ сияқты.
Dialogue: 0,0:47:34.18,0:47:35.14,Default,,0,0,0,,Құсу…
Dialogue: 0,0:47:35.22,0:47:37.18,Default,,0,0,0,,Бұл не үшін? бұлыңғыр бақа
Dialogue: 0,0:47:37.27,0:47:38.48,Default,,0,0,0,,Э-э…
Dialogue: 0,0:47:38.56,0:47:39.77,Default,,0,0,0,,Бұл... бұл князь...
Dialogue: 0,0:47:39.85,0:47:41.81,Default,,0,0,0,,Мен сені ханшайым іздеп жүргеніңді естідім.
Dialogue: 0,0:47:41.90,0:47:43.81,Default,,0,0,0,,Мен өзіммен бірге ханшайым кандидатын ала келдім.
Dialogue: 0,0:47:43.90,0:47:44.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:44.52,0:47:46.98,Default,,0,0,0,,Өйткені мен ханзаданың нені ұнататынын білмеймін.
Dialogue: 0,0:47:47.07,0:47:48.94,Default,,0,0,0,,Бізде әртүрлі түрлері бар.
Dialogue: 0,0:47:50.78,0:47:52.70,Default,,0,0,0,,Олай болса, кеттік
Dialogue: 0,0:47:52.78,0:47:55.87,Default,,0,0,0,,1-ші «Теңіз ханшайымы астында» байқауы
Dialogue: 0,0:47:55.95,0:48:00.50,Default,,0,0,0,,№1 жазба Шибуя стиліндегі заманауи орта мектеп оқушысынан
Dialogue: 0,0:48:01.71,0:48:04.96,Default,,0,0,0,,1 саны - Моа. Менің ерекше шеберлігім – төрт әріпті идиомалар.
Dialogue: 0,0:48:05.04,0:48:08.96,Default,,0,0,0,,Бұл анахронизм бе? Гадахикимизу?
Dialogue: 0,0:48:09.05,0:48:12.34,Default,,0,0,0,,Жылқы құлағы шығыс жел? Толық үй?
Dialogue: 0,0:48:13.76,0:48:15.22,Default,,0,0,0,,Ауаны оқу арқылы үзілді
Dialogue: 0,0:48:15.30,0:48:17.72,Default,,0,0,0,,Міне!
Dialogue: 0,0:48:17.81,0:48:19.81,Default,,0,0,0,,Ал келесі ханшайым
Dialogue: 0,0:48:20.31,0:48:22.35,Default,,0,0,0,,Ниндзя мен комедияның керемет үйлесімі
Dialogue: 0,0:48:22.44,0:48:24.48,Default,,0,0,0,,Шиноби ханшайымы
Dialogue: 0,0:48:24.56,0:48:26.82,Default,,0,0,0,,Бұл да Нацуми-санды құтқару.
Dialogue: 0,0:48:26.90,0:48:28.86,Default,,0,0,0,,№2 Коюки Хигашия
Dialogue: 0,0:48:28.94,0:48:31.07,Default,,0,0,0,,Арнайы дағдылар - қызықты оқиға.
Dialogue: 0,0:48:31.15,0:48:33.86,Default,,0,0,0,,Бірінші, «Қорқынышты ханшайым» жаңа әңгімесі
Dialogue: 0,0:48:35.07,0:48:38.95,Default,,0,0,0,,Бір күні түнде ханзада ханшайымға:
Dialogue: 0,0:48:39.45,0:48:41.83,Default,,0,0,0,,Қорқыныш &%△〇…
Dialogue: 0,0:48:41.91,0:48:43.29,Default,,0,0,0,,Жабылатын сылдырмақ
Dialogue: 0,0:48:43.37,0:48:46.46,Default,,0,0,0,,Кешіріңіз, жолдарыңызды шайнамаңыз.
Dialogue: 0,0:48:46.96,0:48:48.00,Default,,0,0,0,,Содан кейін, келесі!
Dialogue: 0,0:48:49.63,0:48:51.51,Default,,0,0,0,,Сүйкімді қарындас түрі!
Dialogue: 0,0:48:52.59,0:48:54.64,Default,,0,0,0,,№3 Антарктикалық тамаэ!
Dialogue: 0,0:48:54.72,0:48:57.80,Default,,0,0,0,,Ерекше қабілет - қызғаныш, тәттілерді тез жеу
Dialogue: 0,0:48:57.89,0:48:59.51,Default,,0,0,0,,Әй, анау әйел!
Dialogue: 0,0:49:01.60,0:49:03.27,Default,,0,0,0,,Ой, балалар!
Dialogue: 0,0:49:03.35,0:49:05.40,Default,,0,0,0,,Сонымен қатар, қоқыс тастау!
Dialogue: 0,0:49:05.48,0:49:06.52,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:49:07.44,0:49:09.78,Default,,0,0,0,,Тоқта, күт, күт! Бұл жолы рас
Dialogue: 0,0:49:09.86,0:49:11.78,Default,,0,0,0,,Дәстүрлі жапон ханшайымының түрі!
Dialogue: 0,0:49:12.61,0:49:13.99,Default,,0,0,0,,Хо хо хо
Dialogue: 0,0:49:14.49,0:49:17.57,Default,,0,0,0,,Йо... № 4 Джироко Ононо
Dialogue: 0,0:49:17.66,0:49:21.41,Default,,0,0,0,,Ал... Менің ерекше шеберлігім... Жыныстық тартымдылық.
Dialogue: 0,0:49:22.75,0:49:24.96,Default,,0,0,0,,Уау... мына ауа жынды екен
Dialogue: 0,0:49:25.54,0:49:27.08,Default,,0,0,0,,А... не... не!
Dialogue: 0,0:49:27.17,0:49:29.71,Default,,0,0,0,,-Ал, жақсы емес пе? -Ах!
Dialogue: 0,0:49:31.96,0:49:33.22,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:49:33.30,0:49:37.22,Default,,0,0,0,,Жоқ, сержант, сіз мақсатыңыздан айырылдыңыз.
Dialogue: 0,0:49:37.30,0:49:39.47,Default,,0,0,0,,Күтілгендей бұл жер ең жылы.
Dialogue: 0,0:49:39.55,0:49:42.31,Default,,0,0,0,,Балалар, бұл нені білдіреді?
Dialogue: 0,0:49:42.39,0:49:43.56,Default,,0,0,0,,- (Фуюки) Әпке! -(Момока) Ах.
Dialogue: 0,0:49:44.14,0:49:45.85,Default,,0,0,0,,Фуюки! Бұлыңғыр бақа!
Dialogue: 0,0:49:51.94,0:49:54.36,Default,,0,0,0,,Мер…Мер ханзада
Dialogue: 0,0:49:55.49,0:49:58.16,Default,,0,0,0,,Сіз Нацумиді ұрлап кеткен ханзадасыз ба?
Dialogue: 0,0:49:58.66,0:50:00.83,Default,,0,0,0,,Ах! Эй, Жироро, бұл жақсы емес.
Dialogue: 0,0:50:00.91,0:50:02.24,Default,,0,0,0,,Әлі тыңдалуда...
Dialogue: 0,0:50:04.20,0:50:05.87,Default,,0,0,0,,Нацумиді қайтарсам ба?
Dialogue: 0,0:50:05.96,0:50:07.79,Default,,0,0,0,,Күте тұрыңыз, Жиро...
Dialogue: 0,0:50:09.21,0:50:11.59,Default,,0,0,0,,Маған ханзада Маребол!
Dialogue: 0,0:50:11.67,0:50:12.25,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:50:12.34,0:50:15.51,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:50:18.59,0:50:19.34,Default,,0,0,0,,Чий!
Dialogue: 0,0:50:20.18,0:50:20.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:50:22.26,0:50:23.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:23.77,0:50:24.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:25.02,0:50:26.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:28.40,0:50:29.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:50:31.15,0:50:32.90,Default,,0,0,0,,Мен саған ханзадамен араласуға жол бермеймін.
Dialogue: 0,0:50:32.98,0:50:34.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:34.15,0:50:35.28,Default,,0,0,0,,- (Фуюки) Сержант! -(Нацуми) Ха!
Dialogue: 0,0:50:35.36,0:50:36.32,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:50:36.40,0:50:37.90,Default,,0,0,0,,Амансың ба? сержант
Dialogue: 0,0:50:38.41,0:50:39.66,Default,,0,0,0,,Бұдан гөрі...
Dialogue: 0,0:50:39.74,0:50:42.87,Default,,0,0,0,,Бұл қауіпті атмосфера.
Dialogue: 0,0:50:43.37,0:50:44.95,Default,,0,0,0,,-Мм? -Ку-кук-кук-кук...
Dialogue: 0,0:50:45.04,0:50:46.16,Default,,0,0,0,,Бұл өте қауіпті
Dialogue: 0,0:50:46.25,0:50:48.42,Default,,0,0,0,,Олардың бәрін ұстаңыз!
Dialogue: 0,0:50:48.50,0:50:51.67,Default,,0,0,0,,Құсу! Әзірге кетіңіз!
Dialogue: 0,0:50:54.88,0:50:56.42,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:50:57.72,0:50:58.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:59.01,0:51:00.93,Default,,0,0,0,,-Бұл жерде ыстық! -(Коюки) Дороро!
Dialogue: 0,0:51:01.01,0:51:04.14,Default,,0,0,0,,Дороро Нинпо Уки медузасы!
Dialogue: 0,0:51:04.22,0:51:05.43,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:51:05.52,0:51:06.48,Default,,0,0,0,,Не?!
Dialogue: 0,0:51:06.56,0:51:07.43,Default,,0,0,0,,Мәңгі менің қасымда бол.
Dialogue: 0,0:51:10.06,0:51:10.94,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:51:11.02,0:51:12.19,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:51:12.27,0:51:13.23,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:51:13.73,0:51:14.82,Default,,0,0,0,,Не? О?
Dialogue: 0,0:51:14.90,0:51:16.57,Default,,0,0,0,,Құсу!
Dialogue: 0,0:51:17.53,0:51:18.57,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:51:18.65,0:51:19.78,Default,,0,0,0,,Нишизава мырза!
Dialogue: 0,0:51:22.45,0:51:25.20,Default,,0,0,0,,Құсу!
Dialogue: 0,0:51:25.95,0:51:27.95,Default,,0,0,0,,Бұл қорқынышты, Кероро-кун.
Dialogue: 0,0:51:28.04,0:51:30.00,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:51:31.42,0:51:32.71,Default,,0,0,0,,Жылдам қашу
Dialogue: 0,0:51:32.79,0:51:35.00,Default,,0,0,0,,Дөрекі болуды доғар!
Dialogue: 0,0:51:35.09,0:51:37.63,Default,,0,0,0,,Жарайды, мен оны қуып жібердім.
Dialogue: 0,0:51:37.71,0:51:39.84,Default,,0,0,0,,Мен Нацумидің достарына қорқынышты ештеңе жасамаймын.
Dialogue: 0,0:51:40.47,0:51:43.35,Default,,0,0,0,,Оның үстіне олардың бәрі қызықсыз.
Dialogue: 0,0:51:43.85,0:51:46.22,Default,,0,0,0,,Бірақ сіз өте қызықсыз.
Dialogue: 0,0:51:46.31,0:51:47.60,Default,,0,0,0,,Мен өзімді басқа адам емес сияқты сезінемін.
Dialogue: 0,0:51:48.39,0:51:51.02,Default,,0,0,0,,Сіз маған бағынышты бола аласыз.
Dialogue: 0,0:51:51.52,0:51:53.90,Default,,0,0,0,,Мен не болып жатқанын көру үшін келдім.
Dialogue: 0,0:51:53.98,0:51:56.82,Default,,0,0,0,,Сіз айтқандай жасаған дұрыс па?
Dialogue: 0,0:51:57.32,0:51:57.90,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:51:58.78,0:52:02.11,Default,,0,0,0,,Бұл не? Кероболға ұқсайды
Dialogue: 0,0:52:02.61,0:52:05.45,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:52:05.95,0:52:12.37,Default,,0,0,0,,(Фуюки мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:52:14.04,0:52:15.71,Default,,0,0,0,,Сіз әйтеуір қашып үлгерген сияқтысыз.
Dialogue: 0,0:52:15.79,0:52:18.88,Default,,0,0,0,,Бірақ неге теңіз түбінде осындай қала бар?
Dialogue: 0,0:52:18.96,0:52:21.26,Default,,0,0,0,,Мен дәл қазір келгенімде ол жерде ештеңе болған жоқ.
Dialogue: 0,0:52:22.01,0:52:24.64,Default,,0,0,0,,Бұл шынымен теңіз түбі ме?
Dialogue: 0,0:52:24.72,0:52:26.68,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:52:26.76,0:52:29.77,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,0:52:31.56,0:52:34.27,Default,,0,0,0,,Бұл «аспанға түкіру» деп аталады.
Dialogue: 0,0:52:37.52,0:52:38.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:39.82,0:52:41.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:41.32,0:52:42.65,Default,,0,0,0,,Барлықтарыңыз маған еліктемеңіздер.
Dialogue: 0,0:52:43.57,0:52:46.16,Default,,0,0,0,,Бұл шынымен де теңіз түбіне ұқсайды.
Dialogue: 0,0:52:46.24,0:52:48.20,Default,,0,0,0,,- (Фуюки) Дұрыс - (Момока) Хахаха...
Dialogue: 0,0:52:48.29,0:52:50.95,Default,,0,0,0,,Бірақ бұл қала мен оны бұрын бір жерден көргендей сезінемін...
Dialogue: 0,0:52:51.04,0:52:53.04,Default,,0,0,0,,- (Коюки) Барлығы, қараңдар, қараңдар! -(2 адам) А?
Dialogue: 0,0:52:53.12,0:52:55.96,Default,,0,0,0,,Бұл жерде қызық нәрсе бар.
Dialogue: 0,0:52:59.67,0:53:00.80,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:00.88,0:53:03.55,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:53:03.63,0:53:05.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:05.64,0:53:07.30,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:53:07.39,0:53:09.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:09.14,0:53:12.43,Default,,0,0,0,,Керемет! Өйткені, сіз қарапайым адам емессіз!
Dialogue: 0,0:53:12.52,0:53:14.69,Default,,0,0,0,,Сіз жай ғана адам емессіз бе?
Dialogue: 0,0:53:14.77,0:53:17.19,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:53:17.27,0:53:19.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:19.27,0:53:20.65,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:53:20.73,0:53:22.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:24.40,0:53:27.28,Default,,0,0,0,,Ах... Хаа Хаа...
Dialogue: 0,0:53:27.37,0:53:29.99,Default,,0,0,0,,Нацуми, сен не қарап тұрсың?
Dialogue: 0,0:53:30.08,0:53:31.75,Default,,0,0,0,,Ah~re~
Dialogue: 0,0:53:31.83,0:53:33.79,Default,,0,0,0,,А... неге қашпайсың?
Dialogue: 0,0:53:33.87,0:53:35.87,Default,,0,0,0,,Сіз қазір оңай құтыла аласыз.
Dialogue: 0,0:53:35.96,0:53:37.04,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:53:37.75,0:53:40.96,Default,,0,0,0,,Менің айтайын дегенім, ол балаларды бұлай қалдырмау керек.
Dialogue: 0,0:53:41.05,0:53:41.84,Default,,0,0,0,,Нацуми!
Dialogue: 0,0:53:41.92,0:53:43.09,Default,,0,0,0,,- (Электрондық пошта) Міне, Жироро - Ах!
Dialogue: 0,0:53:43.67,0:53:46.30,Default,,0,0,0,,Сіз не істеп жатырсыз? Әлі біткен жоқ.
Dialogue: 0,0:53:46.38,0:53:49.10,Default,,0,0,0,,Бұл жолы сағат тілімен. Асығыңыз, асығыңыз!
Dialogue: 0,0:53:49.72,0:53:51.68,Default,,0,0,0,,-(Марль) Ханшайым -(Нацуми) Ах...
Dialogue: 0,0:53:51.77,0:53:53.60,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:53:53.68,0:53:55.27,Default,,0,0,0,,Міне!
Dialogue: 0,0:53:55.35,0:53:56.69,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:53:56.77,0:53:57.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:53:58.23,0:54:00.86,Default,,0,0,0,,Сіздің басқа достарыңыз жоқ па? Ал сіздің отбасыңыз ше?
Dialogue: 0,0:54:01.44,0:54:02.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:02.48,0:54:05.95,Default,,0,0,0,,Кішкентай кезімізден біз тек екеуміз ғана болдық.
Dialogue: 0,0:54:06.45,0:54:09.87,Default,,0,0,0,,Күзетшілерді Меабордағы князь жасады.
Dialogue: 0,0:54:09.95,0:54:12.87,Default,,0,0,0,,Мәңгілік, теңіз түбінде екеуміз ғана...
Dialogue: 0,0:54:12.95,0:54:17.92,Default,,0,0,0,,Ханшайымдар әлемінің тілімен айтқанда, бұл «балалық дос» қарым-қатынасы.
Dialogue: 0,0:54:18.00,0:54:19.29,Default,,0,0,0,,Бала күнгі досыңыз?
Dialogue: 0,0:54:19.79,0:54:21.63,Default,,0,0,0,,Екеуің жақсы доссыңдар ма?
Dialogue: 0,0:54:21.71,0:54:24.13,Default,,0,0,0,,Ал... онша емес.
Dialogue: 0,0:54:24.21,0:54:27.51,Default,,0,0,0,,Бірақ мен неге ханшайыммын?
Dialogue: 0,0:54:27.59,0:54:30.64,Default,,0,0,0,,Онда мен сенің ханшайым болғаныңды қалаймын.
Dialogue: 0,0:54:30.72,0:54:32.64,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:54:33.14,0:54:35.73,Default,,0,0,0,,Менің міндетім ханзаданы қорғау.
Dialogue: 0,0:54:39.73,0:54:41.36,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:54:41.44,0:54:42.77,Default,,0,0,0,,-Ой? -Ах!
Dialogue: 0,0:54:42.86,0:54:44.23,Default,,0,0,0,,-Куру~ -Хмм?
Dialogue: 0,0:54:45.24,0:54:46.74,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:54:46.82,0:54:50.28,Default,,0,0,0,,Бұл мен кішкентай кезімде отбасыммен баратын әмбебап дүкен.
Dialogue: 0,0:54:51.57,0:54:53.28,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:54:53.37,0:54:56.04,Default,,0,0,0,,Сен мұны істей алмайсың, Нацуми Фуюки!
Dialogue: 0,0:54:58.50,0:54:59.04,Default,,0,0,0,,Хаха…
Dialogue: 0,0:54:59.12,0:55:00.96,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:55:01.04,0:55:04.55,Default,,0,0,0,,Уау! Дөңгелектегі балмұздақ дүкені
Dialogue: 0,0:55:04.63,0:55:06.05,Default,,0,0,0,,онда
Dialogue: 0,0:55:06.13,0:55:08.22,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:55:08.30,0:55:09.05,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:55:09.68,0:55:12.22,Default,,0,0,0,,Өте көңілді орын сияқты!
Dialogue: 0,0:55:12.30,0:55:13.93,Default,,0,0,0,,Құпия жер таптың ба?
Dialogue: 0,0:55:14.51,0:55:16.89,Default,,0,0,0,,Барлығы бұрынғыдай.
Dialogue: 0,0:55:18.18,0:55:19.06,Default,,0,0,0,,Фуюки-кун?
Dialogue: 0,0:55:22.65,0:55:25.11,Default,,0,0,0,,Дүкендер ғана емес
Dialogue: 0,0:55:25.19,0:55:28.86,Default,,0,0,0,,Бұл біз тұрған қала.
Dialogue: 0,0:55:28.95,0:55:30.91,Default,,0,0,0,,Бірақ неге жер бетінде...
Dialogue: 0,0:55:30.99,0:55:31.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:35.08,0:55:37.08,Default,,0,0,0,,- Құсу ма? -(Фуюки) Бұл шар...
Dialogue: 0,0:55:38.00,0:55:39.00,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:55:39.91,0:55:41.08,Default,,0,0,0,,Хмм... Хмм...
Dialogue: 0,0:55:42.13,0:55:43.88,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:55:43.96,0:55:47.92,Default,,0,0,0,,Бұл менің әпкем адасып қалғанда жанында болған шар.
Dialogue: 0,0:55:48.01,0:55:49.47,Default,,0,0,0,,Нацуми жоғалып кетті ме?
Dialogue: 0,0:55:49.55,0:55:52.80,Default,,0,0,0,,Иә, біз әлі кішкентай кезімізде.
Dialogue: 0,0:55:52.89,0:55:54.76,Default,,0,0,0,,Отбасыңызбен әмбебап дүкенге келіңіз.
Dialogue: 0,0:55:54.85,0:55:58.18,Default,,0,0,0,,Жалғыз апам ажырасып, адасып қалды.
Dialogue: 0,0:55:58.27,0:55:59.98,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:56:01.64,0:56:04.44,Default,,0,0,0,,Ол кезде мына шарды әпкем ұстап тұрған.
Dialogue: 0,0:56:04.52,0:56:07.73,Default,,0,0,0,,Аспазшы~ Түсіндім, түсіндім.
Dialogue: 0,0:56:08.36,0:56:12.24,Default,,0,0,0,,Бұл қалада барлығы Нацуми Хинатаның естеліктерінен жасалған.
Dialogue: 0,0:56:12.32,0:56:14.57,Default,,0,0,0,,Әпкемнің естеліктерінен?
Dialogue: 0,0:56:15.78,0:56:18.41,Default,,0,0,0,,Бәлкім, ана допты немесе бір нәрсені пайдаланып жатқан шығар.
Dialogue: 0,0:56:18.50,0:56:20.00,Default,,0,0,0,,Менің ойымша, ол оны жасады.
Dialogue: 0,0:56:20.58,0:56:21.79,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:56:21.87,0:56:25.59,Default,,0,0,0,,Бұл Нацуми-дононы осы теңіздің түбінде ұстау.
Dialogue: 0,0:56:25.67,0:56:28.71,Default,,0,0,0,,Нацуми-сан, сен осында мәңгі қалғың келе ме?
Dialogue: 0,0:56:29.30,0:56:33.72,Default,,0,0,0,,Бірақ неге менде адасып қалған кездегі қайғылы естеліктер қалады?
Dialogue: 0,0:56:33.80,0:56:35.76,Default,,0,0,0,,- (Фуюки және т.б.) Ах... - (Момока) Иә?
Dialogue: 0,0:56:36.26,0:56:38.22,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:56:39.06,0:56:40.23,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:56:40.98,0:56:42.44,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:56:42.52,0:56:43.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:43.56,0:56:45.19,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:56:45.27,0:56:46.82,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:56:48.15,0:56:48.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:51.90,0:56:54.32,Default,,0,0,0,,Уау, әдемі
Dialogue: 0,0:56:55.24,0:56:56.53,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:56:56.62,0:56:58.33,Default,,0,0,0,,- (Электрондық пошта) Нацуми! -(Нацуми) А?
Dialogue: 0,0:56:58.41,0:56:59.83,Default,,0,0,0,,CERN-ге қарсы шыққан террорист.
Dialogue: 0,0:56:59.91,0:57:03.67,Default,,0,0,0,,Жироро маған Курукуру Ааренің қулығын үйретті~
Dialogue: 0,0:57:03.75,0:57:05.46,Default,,0,0,0,,Осыны тартып көріңіз.
Dialogue: 0,0:57:05.54,0:57:08.42,Default,,0,0,0,,Жоқ... жоқ, олай дегенім жоқ...
Dialogue: 0,0:57:08.50,0:57:10.26,Default,,0,0,0,,Олай болса мен сенің орныңды аламын.
Dialogue: 0,0:57:10.34,0:57:11.80,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:57:11.88,0:57:13.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:13.17,0:57:16.22,Default,,0,0,0,,Сіз бұл туралы не істейсіз?
Dialogue: 0,0:57:16.30,0:57:18.35,Default,,0,0,0,,Кешіріңіз, ханзада.
Dialogue: 0,0:57:18.43,0:57:19.47,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,0:57:19.56,0:57:21.77,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:57:21.85,0:57:23.48,Default,,0,0,0,,- (Нацуми) Фуфуфуфу - (Марл) Иә?
Dialogue: 0,0:57:23.56,0:57:25.44,Default,,0,0,0,,- (Нацуми) Ху ахаха - (электрондық пошта) Ах...
Dialogue: 0,0:57:25.52,0:57:29.15,Default,,0,0,0,,(Нацумидің күлкісі)
Dialogue: 0,0:57:29.23,0:57:32.49,Default,,0,0,0,,Балалар... Ахахха Ахахха
Dialogue: 0,0:57:32.57,0:57:35.49,Default,,0,0,0,,Хи хи ха ха ха ха ха
Dialogue: 0,0:57:35.57,0:57:39.49,Default,,0,0,0,,Ха ха ха... Аа, ішім ауырып тұр.
Dialogue: 0,0:57:39.58,0:57:40.70,Default,,0,0,0,,Аа...
Dialogue: 0,0:57:40.79,0:57:41.87,Default,,0,0,0,,Не? не?
Dialogue: 0,0:57:42.70,0:57:44.37,Default,,0,0,0,,Жоқ... ештеңе.
Dialogue: 0,0:57:44.46,0:57:48.21,Default,,0,0,0,,Ханзада Нацуми-саманың оны мазақ етіп жатқанына қуанады.
Dialogue: 0,0:57:48.29,0:57:48.84,Default,,0,0,0,,Марл!
Dialogue: 0,0:57:48.92,0:57:50.13,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:57:51.13,0:57:51.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:51.71,0:57:54.38,Default,,0,0,0,,Нацуми, мен мұнда келгеннен бері.
Dialogue: 0,0:57:54.47,0:57:56.26,Default,,0,0,0,,Себебі бұл қызықсыз болып көрінді
Dialogue: 0,0:57:56.34,0:57:57.89,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:57:57.97,0:57:59.80,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:57:59.89,0:58:02.27,Default,,0,0,0,,Ханзада қатты уайымдады.
Dialogue: 0,0:58:02.35,0:58:04.68,Default,,0,0,0,,«Егер Нацуми бізді ұнатпайтын болса ше?»
Dialogue: 0,0:58:04.77,0:58:06.73,Default,,0,0,0,,«Мен не істеуім керек?»
Dialogue: 0,0:58:06.81,0:58:07.73,Default,,0,0,0,,Марл!
Dialogue: 0,0:58:07.81,0:58:09.90,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:58:09.98,0:58:12.23,Default,,0,0,0,,Жоқ, жоқ! Сен шынымен сол жігітсің.
Dialogue: 0,0:58:12.82,0:58:14.24,Default,,0,0,0,,Ал бұл жер жаман иіскейді! Иіскейді!
Dialogue: 0,0:58:14.32,0:58:16.78,Default,,0,0,0,,Қанша жомарт болсам да, енді шыдай алмаймын!
Dialogue: 0,0:58:16.86,0:58:18.74,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:58:18.82,0:58:21.24,Default,,0,0,0,,Кук-кук-кук-кук
Dialogue: 0,0:58:21.95,0:58:25.75,Default,,0,0,0,,Осыны егжей-тегжейлі талдағанымда, мен қызықты нәрсе таптым.
Dialogue: 0,0:58:26.46,0:58:28.50,Default,,0,0,0,,Бұл маронит технологиясы.
Dialogue: 0,0:58:28.58,0:58:30.17,Default,,0,0,0,,Марониттер?
Dialogue: 0,0:58:30.25,0:58:34.05,Default,,0,0,0,,Мен марониттер туралы ойласам, мен олар туралы тарих сабағында бұрыннан білдім...
Dialogue: 0,0:58:34.13,0:58:36.67,Default,,0,0,0,,Ал... Менің есімде көп нәрсе жоқ.
Dialogue: 0,0:58:36.76,0:58:37.51,Default,,0,0,0,,Техехе~
Dialogue: 0,0:58:38.30,0:58:40.18,Default,,0,0,0,,Біздің Керон планетасымен бірдей
Dialogue: 0,0:58:40.26,0:58:44.02,Default,,0,0,0,,Гама тұманындағы су планетасы Маронстар тумасы.
Dialogue: 0,0:58:44.60,0:58:49.52,Default,,0,0,0,,Марониттер де басқыншы тайпа болған, бірақ олардың қызметі әлдеқашан тоқтаған.
Dialogue: 0,0:58:49.60,0:58:52.77,Default,,0,0,0,,Мүмкін сол кездегі басқыншылық күштердің бірі
Dialogue: 0,0:58:52.86,0:58:55.86,Default,,0,0,0,,Ғарышта адасып, осы Пекопонға жуындым.
Dialogue: 0,0:58:55.94,0:59:00.24,Default,,0,0,0,,Олар өз мақсатын ұмытып, мұхит түбіне қоныстанған шығар.
Dialogue: 0,0:59:00.74,0:59:03.70,Default,,0,0,0,,Қандай ебедейсіз адамдар тобы.
Dialogue: 0,0:59:03.79,0:59:06.79,Default,,0,0,0,,Бірақ бұл сержанттарға ұқсас нәрсе емес пе?
Dialogue: 0,0:59:06.87,0:59:07.79,Default,,0,0,0,,Ге... құсу
Dialogue: 0,0:59:07.87,0:59:10.88,Default,,0,0,0,,Бұл алаңсыз жүретін уақыт емес.
Dialogue: 0,0:59:10.96,0:59:13.80,Default,,0,0,0,,Марониттердің ханшайымды қарсы алуы нені білдіреді?
Dialogue: 0,0:59:13.88,0:59:17.30,Default,,0,0,0,,Бұл планетаны біз өмір сүретін ортаға айналдыру дегенді білдіреді.
Dialogue: 0,0:59:17.38,0:59:19.55,Default,,0,0,0,,Сонда не болады?
Dialogue: 0,0:59:20.22,0:59:22.85,Default,,0,0,0,,Пекопон 100% теңіз жұлдызына айналады
Dialogue: 0,0:59:22.93,0:59:23.43,Default,,0,0,0,,Соққы
Dialogue: 0,0:59:23.51,0:59:24.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:24.51,0:59:25.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:33.44,0:59:35.98,Default,,0,0,0,,Ал... бұл жаман.
Dialogue: 0,0:59:36.07,0:59:39.24,Default,,0,0,0,,Халқым, су ішуден аулақ бол.
Dialogue: 0,0:59:39.32,0:59:42.24,Default,,0,0,0,,Өйткені, біз Нацуми-санды құтқаруымыз керек.
Dialogue: 0,0:59:42.32,0:59:45.49,Default,,0,0,0,,Бірақ бізде қару да, ештеңе де жоқ.
Dialogue: 0,0:59:46.41,0:59:51.79,Default,,0,0,0,,Бұл ғимараттағы материалдар жауынгерлік техника жасауға жеткілікті...
Dialogue: 0,0:59:52.63,0:59:53.13,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:59:53.21,0:59:54.96,Default,,0,0,0,,Куруру сұрау
Dialogue: 0,0:59:55.04,0:59:56.59,Default,,0,0,0,,Қолымыздан келгенін істейік
Dialogue: 0,0:59:56.67,1:00:01.05,Default,,0,0,0,,Әпкемді міндетті түрде құтқарайық және бәріміз үйге қайтайық!
Dialogue: 0,1:00:04.55,1:00:05.39,Default,,0,0,0,,Иә
Dialogue: 0,1:00:06.64,1:00:07.43,Default,,0,0,0,,Иә
Dialogue: 0,1:00:07.52,1:00:08.35,Default,,0,0,0,,Иә
Dialogue: 0,1:00:08.43,1:00:09.02,Default,,0,0,0,,Хааа~
Dialogue: 0,1:00:09.68,1:00:10.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:10.98,1:00:13.81,Default,,0,0,0,,Фуюки-кун, бәрінің ойы бір.
Dialogue: 0,1:00:13.90,1:00:14.52,Default,,0,0,0,,Сержант...
Dialogue: 0,1:00:15.32,1:00:18.28,Default,,0,0,0,,Кеттік! Шешуші шайқас ертең таңертең болады!
Dialogue: 0,1:00:18.36,1:00:19.78,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:00:20.28,1:00:21.07,Default,,0,0,0,,қазір осында
Dialogue: 0,1:00:21.15,1:00:25.78,Default,,0,0,0,,Жер тұрғындары мен керондықтар арасында Нацумиді құтқару үшін бірлескен майдан басталды.
Dialogue: 0,1:00:27.87,1:00:34.42,Default,,0,0,0,,(Пошта ұйқысы)
Dialogue: 0,1:00:34.50,1:00:38.30,Default,,0,0,0,,Хмф, ханшайымнан гөрі ана сияқты.
Dialogue: 0,1:00:38.38,1:00:40.34,Default,,0,0,0,,Иә? Жироро
Dialogue: 0,1:00:41.13,1:00:42.30,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,1:00:43.01,1:00:45.26,Default,,0,0,0,,Күні бойы менде қорқынышты оқиға болды...
Dialogue: 0,1:00:45.35,1:00:47.18,Default,,0,0,0,,Балалар сендер үйреніп қалғансыңдар.
Dialogue: 0,1:00:47.26,1:00:49.06,Default,,0,0,0,,-Ба... Ақымақ болма -(Нацуми) Хехе
Dialogue: 0,1:00:50.39,1:00:52.35,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,1:00:52.44,1:00:53.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:53.39,1:00:57.23,Default,,0,0,0,,Егер сіз шынымен осы қалашықта тұрғыңыз келсе
Dialogue: 0,1:00:57.32,1:00:59.07,Default,,0,0,0,,Мен араласпаймын
Dialogue: 0,1:00:59.98,1:01:02.65,Default,,0,0,0,,Барасың ба, қаласың ба өзіңе байланысты.
Dialogue: 0,1:01:03.40,1:01:05.82,Default,,0,0,0,,Қалай болғанда да, мен Нацуми жағындамын.
Dialogue: 0,1:01:06.91,1:01:08.08,Default,,0,0,0,,Рахмет Джироро
Dialogue: 0,1:01:08.66,1:01:10.16,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:01:10.24,1:01:12.29,Default,,0,0,0,,Олардың технологиясы
Dialogue: 0,1:01:12.37,1:01:15.54,Default,,0,0,0,,Оны Пекопонды басып алу үшін пайдалануға болады...
Dialogue: 0,1:01:15.63,1:01:17.88,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:01:20.51,1:01:21.34,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,1:01:22.01,1:01:23.30,Default,,0,0,0,,Нацуми?
Dialogue: 0,1:01:23.38,1:01:25.72,Default,,0,0,0,,Кешіріңіз, мен сізді ояттым ба?
Dialogue: 0,1:01:26.34,1:01:26.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:30.52,1:01:31.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:32.60,1:01:33.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:33.81,1:01:37.86,Default,,0,0,0,,Нацуми, менімен бірге теңізге серуендеуге барғың келе ме?
Dialogue: 0,1:01:37.94,1:01:40.15,Default,,0,0,0,,Теңіз астында? қазірден?
Dialogue: 0,1:01:40.23,1:01:41.32,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,1:01:41.98,1:01:43.49,Default,,0,0,0,,- (Нацуми) Ах... - (Электрондық пошта) Келіңізші.
Dialogue: 0,1:01:46.49,1:01:48.37,Default,,0,0,0,,Қараңдар, мініңдер.
Dialogue: 0,1:01:48.45,1:01:49.53,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:57.46,1:02:00.92,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:02:05.26,1:02:07.89,Default,,0,0,0,,Айтпақшы, бір жедел мәселе…
Dialogue: 0,1:02:08.64,1:02:09.60,Default,,0,0,0,,Жарайды
Dialogue: 0,1:02:09.68,1:02:13.56,Default,,0,0,0,,Егер сіз сол диадеманы кисеңіз, сіз су астында дем аласыз.
Dialogue: 0,1:02:14.06,1:02:15.14,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:02:15.23,1:02:16.60,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,1:02:16.69,1:02:18.27,Default,,0,0,0,,Судың қысымы да жақсы.
Dialogue: 0,1:02:18.35,1:02:20.40,Default,,0,0,0,,Эй... сәл күте тұрыңыз!
Dialogue: 0,1:02:20.98,1:02:24.28,Default,,0,0,0,,Түсіңізде ұшқандағыдай жүзіп көріңізші?
Dialogue: 0,1:02:24.36,1:02:26.65,Default,,0,0,0,,Аспанды армандайсыз ба?
Dialogue: 0,1:02:29.91,1:02:31.74,Default,,0,0,0,,Ах хехе
Dialogue: 0,1:02:32.45,1:02:33.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:35.46,1:02:38.96,Default,,0,0,0,,Дәмді Дәмді! Нацуми күткендей керемет!
Dialogue: 0,1:02:39.04,1:02:40.29,Default,,0,0,0,,Эхехехехехехе
Dialogue: 0,1:02:40.38,1:02:41.50,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:02:41.59,1:02:45.51,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:02:45.59,1:02:51.60,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:02:54.10,1:02:56.35,Default,,0,0,0,,Біздің жерге Нацуми келді.
Dialogue: 0,1:02:56.43,1:02:58.02,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,1:02:58.10,1:03:00.10,Default,,0,0,0,,Өтінемін, мен сенің осында мәңгі қалуыңды қалаймын.
Dialogue: 0,1:03:00.86,1:03:01.86,Default,,0,0,0,,Ешқайда кетпеңіз
Dialogue: 0,1:03:04.78,1:03:09.11,Default,,0,0,0,,♪ Армандар айналады
Dialogue: 0,1:03:09.20,1:03:13.62,Default,,0,0,0,,♪ Көк өмір
Dialogue: 0,1:03:13.70,1:03:18.12,Default,,0,0,0,,♪ Жақсы ұйықтау
Dialogue: 0,1:03:18.21,1:03:23.42,Default,,0,0,0,,♪ Ең алыс теңіз
Dialogue: 0,1:03:23.50,1:03:27.88,Default,,0,0,0,,♪ Жел жоқ
Dialogue: 0,1:03:27.97,1:03:32.43,Default,,0,0,0,,♪ Жұлдыздар жоқ
Dialogue: 0,1:03:32.51,1:03:36.89,Default,,0,0,0,,♪ Қараңғыда
Dialogue: 0,1:03:36.97,1:03:41.40,Default,,0,0,0,,♪ Мен адасып кетсем де
Dialogue: 0,1:03:41.48,1:03:45.90,Default,,0,0,0,,♪ Жылама
Dialogue: 0,1:03:45.98,1:03:50.40,Default,,0,0,0,,♪ Армандасаң
Dialogue: 0,1:03:50.49,1:03:54.37,Default,,0,0,0,,♪ Бір күні
Dialogue: 0,1:03:54.45,1:04:00.46,Default,,0,0,0,,♪ Мен үйге бара жатырмын
Dialogue: 0,1:04:03.13,1:04:06.30,Default,,0,0,0,,Кішкентай кезімізде не болғанын бәріміз ұмыттық.
Dialogue: 0,1:04:06.38,1:04:08.80,Default,,0,0,0,,Бұл менің есімде қалған жалғыз ән
Dialogue: 0,1:04:08.88,1:04:11.51,Default,,0,0,0,,Бесік жырындай нәзік ән
Dialogue: 0,1:04:11.59,1:04:13.43,Default,,0,0,0,,- (электрондық пошта) Бесік жыры? -(Нацуми) Иә.
Dialogue: 0,1:04:13.51,1:04:17.35,Default,,0,0,0,,Менің анам мен әкем де хатта болғанын көрдім.
Dialogue: 0,1:04:17.43,1:04:19.48,Default,,0,0,0,,Әке? ана?
Dialogue: 0,1:04:19.56,1:04:21.69,Default,,0,0,0,,Бір күні келіп мені алып кететініне сенімдімін.
Dialogue: 0,1:04:22.27,1:04:23.77,Default,,0,0,0,,Жеткілікті
Dialogue: 0,1:04:23.86,1:04:26.61,Default,,0,0,0,,Мен бұл планетада ханшайымды қарсы аламын
Dialogue: 0,1:04:26.69,1:04:29.19,Default,,0,0,0,,Өзіміздің жаңа әлемімізді жасаңыз
Dialogue: 0,1:04:29.82,1:04:30.90,Default,,0,0,0,,Электрондық пошта…
Dialogue: 0,1:04:31.49,1:04:34.91,Default,,0,0,0,,Эй, Нацуми, сен ханшайым боласың, солай ма?
Dialogue: 0,1:04:35.41,1:04:37.16,Default,,0,0,0,,Мен енді жалғыз қалғым келмейді!
Dialogue: 0,1:04:37.83,1:04:38.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:04:39.37,1:04:41.96,Default,,0,0,0,,Нацуми осында қалса бақытты болады, солай ма?
Dialogue: 0,1:04:42.04,1:04:44.04,Default,,0,0,0,,Бұл Нацумидің сүйікті қаласы.
Dialogue: 0,1:04:44.75,1:04:46.54,Default,,0,0,0,,Міне, Нацуми қайтып келеді!
Dialogue: 0,1:04:46.63,1:04:48.05,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:51.42,1:04:54.14,Default,,0,0,0,,Ақыр соңында... бұл жақсы емес пе?
Dialogue: 0,1:04:56.01,1:04:59.31,Default,,0,0,0,,Нацуми, сен де мені тастап кетесің бе?
Dialogue: 0,1:05:00.02,1:05:00.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:02.27,1:05:04.06,Default,,0,0,0,,Ешкім... ешкім жоқ
Dialogue: 0,1:05:05.15,1:05:07.06,Default,,0,0,0,,Мен туралы!
Dialogue: 0,1:05:09.69,1:05:10.90,Default,,0,0,0,,Нацуми...
Dialogue: 0,1:05:11.40,1:05:13.07,Default,,0,0,0,,Бұл жақсы электрондық пошта
Dialogue: 0,1:05:14.74,1:05:15.70,Default,,0,0,0,,Нацуми...
Dialogue: 0,1:05:16.20,1:05:16.91,Default,,0,0,0,,Иә
Dialogue: 0,1:05:35.22,1:05:36.59,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:40.18,1:05:42.48,Default,,0,0,0,,Тиа Солмар Марон
Dialogue: 0,1:05:42.56,1:05:44.60,Default,,0,0,0,,Агрипус Вилдиркерон
Dialogue: 0,1:05:45.23,1:05:47.27,Default,,0,0,0,,Арадху поштасы
Dialogue: 0,1:05:55.32,1:05:57.11,Default,,0,0,0,,Рахмет саған Нацуми
Dialogue: 0,1:05:57.20,1:06:03.12,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:06:03.20,1:06:04.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:06.29,1:06:07.63,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,1:06:08.58,1:06:10.25,Default,,0,0,0,,Не болып жатыр? Ах!
Dialogue: 0,1:06:14.84,1:06:16.13,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,1:06:26.56,1:06:28.19,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,1:06:28.27,1:06:30.65,Default,,0,0,0,,Ханзада Пошта ханшайымы Нацуми
Dialogue: 0,1:06:31.40,1:06:33.11,Default,,0,0,0,,Біз дайынбыз.
Dialogue: 0,1:06:33.61,1:06:34.65,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,1:06:34.74,1:06:35.74,Default,,0,0,0,,Иә
Dialogue: 0,1:06:35.82,1:06:36.99,Default,,0,0,0,,Дайындық?
Dialogue: 0,1:06:37.07,1:06:38.16,Default,,0,0,0,,Нацуми күтіңіз!
Dialogue: 0,1:06:38.24,1:06:39.74,Default,,0,0,0,,Нацуми!
Dialogue: 0,1:06:40.24,1:06:42.83,Default,,0,0,0,,Нацумиге не істедің!
Dialogue: 0,1:06:43.83,1:06:45.45,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,1:06:45.54,1:06:48.75,Default,,0,0,0,,Нацуми~!
Dialogue: 0,1:06:57.55,1:06:59.55,Default,,0,0,0,,Барлығы дайын сияқты.
Dialogue: 0,1:07:00.14,1:07:00.97,Default,,0,0,0,,Иә
Dialogue: 0,1:07:01.05,1:07:01.89,Default,,0,0,0,,Иә
Dialogue: 0,1:07:02.47,1:07:03.64,Default,,0,0,0,,Иә
Dialogue: 0,1:07:03.72,1:07:04.89,Default,,0,0,0,,Иә
Dialogue: 0,1:07:06.14,1:07:07.39,Default,,0,0,0,,Куруру Бұл не?
Dialogue: 0,1:07:07.98,1:07:11.56,Default,,0,0,0,,Дененің айналасында су қысымының өрісін тудыратын құрылғы.
Dialogue: 0,1:07:11.65,1:07:13.19,Default,,0,0,0,,Сүңгуір костюмін ауыстырады
Dialogue: 0,1:07:13.27,1:07:14.65,Default,,0,0,0,,Тыныс алу да дұрыс.
Dialogue: 0,1:07:14.73,1:07:17.90,Default,,0,0,0,,Қарасам, бұл терең теңіз.
Dialogue: 0,1:07:17.99,1:07:20.53,Default,,0,0,0,,Бірдеңе болып қалса, құтылу үшін оны пайдаланыңыз.
Dialogue: 0,1:07:20.61,1:07:24.87,Default,,0,0,0,,Дегенмен, ол батареямен жұмыс істейтіндіктен, жұмыс уақыты бірнеше минутты ғана құрайды.
Dialogue: 0,1:07:24.95,1:07:26.50,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,1:07:26.58,1:07:29.00,Default,,0,0,0,,Бұл дабыл өшсе, бітті.
Dialogue: 0,1:07:29.08,1:07:31.38,Default,,0,0,0,,Судың қысымы сізді тегістейді.
Dialogue: 0,1:07:31.46,1:07:33.13,Default,,0,0,0,,Мұны ұмытпаңыз!
Dialogue: 0,1:07:33.21,1:07:36.80,Default,,0,0,0,,Содан кейін, сержант майор Крулл, Моа-доно және Момока-доно.
Dialogue: 0,1:07:36.88,1:07:38.01,Default,,0,0,0,,Сол Керороробо Г!
Dialogue: 0,1:07:38.09,1:07:38.59,Default,,0,0,0,,Иә
Dialogue: 0,1:07:38.67,1:07:43.47,Default,,0,0,0,,Екінші дәрежелі Тамама мен ефрейтор Дороро Коюки-доно Кероро Робоны қолдайды!
Dialogue: 0,1:07:43.55,1:07:44.47,Default,,0,0,0,,- (Коюки/Дороро) Түсіндім! -Саған қалдырамын!
Dialogue: 0,1:07:45.31,1:07:48.10,Default,,0,0,0,,Және бәрі жауларын тартып жатқанда
Dialogue: 0,1:07:48.18,1:07:50.60,Default,,0,0,0,,Менің әріптесім мен Фуюки-кун басты қоршауға асығады!
Dialogue: 0,1:07:50.69,1:07:53.86,Default,,0,0,0,,Жоспар - Нацуми-дононы құтқару!
Dialogue: 0,1:07:54.69,1:07:55.61,Default,,0,0,0,,Иә
Dialogue: 0,1:07:58.19,1:07:59.99,Default,,0,0,0,,Мақсат Нацуми сарайы!
Dialogue: 0,1:08:00.07,1:08:01.86,Default,,0,0,0,,Бұл шабуыл!
Dialogue: 0,1:08:19.59,1:08:21.47,Default,,0,0,0,,Мен Нацуми ханшайымнан бас тартпаймын!
Dialogue: 0,1:08:26.97,1:08:28.22,Default,,0,0,0,,Жүр!
Dialogue: 0,1:08:34.19,1:08:36.11,Default,,0,0,0,,-Коюки-доно! -(Коюки) Иә!
Dialogue: 0,1:08:43.16,1:08:43.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:47.08,1:08:48.33,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,1:08:48.99,1:08:52.08,Default,,0,0,0,,Құсу! Мен көмектесе алмайтыныма ренжідім.
Dialogue: 0,1:08:52.16,1:08:54.50,Default,,0,0,0,,Маған қазір біраз қашықтықты алу керек!
Dialogue: 0,1:09:05.47,1:09:07.64,Default,,0,0,0,,Теюука Тенчи Муйо!
Dialogue: 0,1:09:10.68,1:09:15.86,Default,,0,0,0,,Гипер Тамама әсері!
Dialogue: 0,1:09:15.94,1:09:17.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:17.19,1:09:18.07,Default,,0,0,0,,Тама-чан!
Dialogue: 0,1:09:18.15,1:09:19.40,Default,,0,0,0,,-Трансформация-(Момока) Иә!
Dialogue: 0,1:09:25.74,1:09:26.45,Default,,0,0,0,,Көзілдірік!
Dialogue: 0,1:09:27.95,1:09:28.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:28.91,1:09:29.58,Default,,0,0,0,,Кя~!
Dialogue: 0,1:09:34.21,1:09:36.04,Default,,0,0,0,,Крулл мырза! Мырза More!
Dialogue: 0,1:09:40.42,1:09:42.55,Default,,0,0,0,,Аспазшы~ Бұл қауіпті болды.
Dialogue: 0,1:09:43.34,1:09:44.84,Default,,0,0,0,,Олай болса, рахмет.
Dialogue: 0,1:09:44.93,1:09:46.01,Default,,0,0,0,,Аспазшы~
Dialogue: 0,1:09:48.35,1:09:50.51,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:09:50.60,1:09:51.39,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:09:51.47,1:09:53.02,Default,,0,0,0,,Жо... Жо...
Dialogue: 0,1:09:56.65,1:10:00.11,Default,,0,0,0,,Жарайсың, теңіз жұлдызы!
Dialogue: 0,1:10:05.11,1:10:06.28,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:06.36,1:10:08.28,Default,,0,0,0,,-Коюки-доно! -(Коюки) Ах...
Dialogue: 0,1:10:13.29,1:10:13.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:10:16.00,1:10:16.87,Default,,0,0,0,,Не!
Dialogue: 0,1:10:17.58,1:10:20.50,Default,,0,0,0,,Шабдалы күн күркіреуі!
Dialogue: 0,1:10:25.59,1:10:26.59,Default,,0,0,0,,Не!
Dialogue: 0,1:10:27.18,1:10:28.64,Default,,0,0,0,,- Толя! -(Коюки) Хехе!
Dialogue: 0,1:10:32.18,1:10:32.93,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:10:33.02,1:10:35.56,Default,,0,0,0,,Ниндзя техникасы: жел құдайының биі!
Dialogue: 0,1:10:41.90,1:10:43.53,Default,,0,0,0,,Құсу? Міне бітті!
Dialogue: 0,1:10:43.61,1:10:45.65,Default,,0,0,0,,Иә? Уау, болмайды...
Dialogue: 0,1:10:46.28,1:10:47.03,Default,,0,0,0,,Уф!
Dialogue: 0,1:10:47.11,1:10:48.03,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:51.99,1:10:53.41,Default,,0,0,0,,Йокоана Йокоана!
Dialogue: 0,1:10:53.49,1:10:54.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:55.50,1:10:57.00,Default,,0,0,0,,Жарық қосулы!
Dialogue: 0,1:10:59.71,1:11:01.67,Default,,0,0,0,,Жау оғы 3 Әлі таяп қалды!
Dialogue: 0,1:11:01.75,1:11:02.96,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,1:11:03.05,1:11:03.55,Default,,0,0,0,,- (Фуюки) Уау! - Құсу!
Dialogue: 0,1:11:03.63,1:11:07.84,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:11:12.39,1:11:14.77,Default,,0,0,0,,Ги-ро!
Dialogue: 0,1:11:14.85,1:11:17.60,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:11:20.15,1:11:21.40,Default,,0,0,0,,О!
Dialogue: 0,1:11:21.90,1:11:23.07,Default,,0,0,0,,Құлып!
Dialogue: 0,1:11:28.65,1:11:31.87,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:11:37.08,1:11:38.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:38.62,1:11:39.46,Default,,0,0,0,,- Құсу! -(Фуюки) Нишизава-сан!
Dialogue: 0,1:11:41.54,1:11:44.80,Default,,0,0,0,,Маған жол берме, Фуюки-кун!
Dialogue: 0,1:11:46.30,1:11:48.51,Default,,0,0,0,,Капитан-доно, Фуюки-доно, қазір!
Dialogue: 0,1:11:49.22,1:11:50.18,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,1:11:50.26,1:11:51.80,Default,,0,0,0,,(Үшеуі) Қане, бастаймыз~! (Танжиро) Уа!
Dialogue: 0,1:11:51.89,1:11:52.51,Default,,0,0,0,,Жарайды
Dialogue: 0,1:11:53.18,1:11:56.52,Default,,0,0,0,,Ахх!
Dialogue: 0,1:11:56.60,1:11:57.85,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:11:57.93,1:12:00.35,Default,,0,0,0,,Зарядтауды толық күшейту қосулы!
Dialogue: 0,1:12:02.98,1:12:09.03,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:12:13.62,1:12:15.66,Default,,0,0,0,,Итатата...
Dialogue: 0,1:12:15.74,1:12:16.87,Default,,0,0,0,,О, Жироро!
Dialogue: 0,1:12:16.95,1:12:19.54,Default,,0,0,0,,Жақсы болған сияқты...
Dialogue: 0,1:12:19.62,1:12:21.62,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,1:12:22.12,1:12:24.54,Default,,0,0,0,,Ефрейтор Жироро, сіздің әпкеңіз қайда?
Dialogue: 0,1:12:25.21,1:12:27.67,Default,,0,0,0,,Мен сені осы жерден өткізуге рұқсат ете алмаймын.
Dialogue: 0,1:12:29.63,1:12:31.55,Default,,0,0,0,,- Фуюки-доно - (Фуюки) Иә.
Dialogue: 0,1:12:33.80,1:12:36.06,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,1:12:36.14,1:12:38.89,Default,,0,0,0,,Уууу!
Dialogue: 0,1:12:38.97,1:12:42.77,Default,,0,0,0,,(Қорғаушылардың ырылдауы)
Dialogue: 0,1:12:43.60,1:12:46.61,Default,,0,0,0,,Қате түймені қайта басуды ұмытпаңыз.
Dialogue: 0,1:12:48.65,1:12:49.65,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,1:12:49.74,1:12:52.49,Default,,0,0,0,,О!
Dialogue: 0,1:12:53.07,1:12:55.16,Default,,0,0,0,,Бұл Кероболдың нағыз күші!
Dialogue: 0,1:12:56.49,1:12:59.66,Default,,0,0,0,,Сержант! Ефрейторды сол жігіттер айдап салып жатыр.
Dialogue: 0,1:12:59.75,1:13:00.79,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,1:13:01.46,1:13:04.04,Default,,0,0,0,,Одан гөрі Фуюки-доно Нацуми-доноға тезірек келеді!
Dialogue: 0,1:13:04.12,1:13:06.09,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,1:13:07.13,1:13:08.21,Default,,0,0,0,,- (Марл) Мен саған рұқсат бермеймін - (Фуюки) Ах!
Dialogue: 0,1:13:08.30,1:13:11.22,Default,,0,0,0,,Нацуми мұнда біздің ханшайым болады.
Dialogue: 0,1:13:11.30,1:13:13.88,Default,,0,0,0,,және елімізді гүлденуге жетелейді
Dialogue: 0,1:13:13.97,1:13:18.14,Default,,0,0,0,,Бұл біз үшін де, Нацуми үшін де ең үлкен бақыт.
Dialogue: 0,1:13:18.22,1:13:20.06,Default,,0,0,0,,Тіпті мен үшін
Dialogue: 0,1:13:20.14,1:13:22.14,Default,,0,0,0,,Оян, ефрейтор Жироро.
Dialogue: 0,1:13:22.85,1:13:24.90,Default,,0,0,0,,Бұл марониттер!
Dialogue: 0,1:13:24.98,1:13:28.90,Default,,0,0,0,,Не? Біз маронитпіз бе?
Dialogue: 0,1:13:29.61,1:13:30.69,Default,,0,0,0,,Құсу?
Dialogue: 0,1:13:30.78,1:13:33.15,Default,,0,0,0,,Сіз мұны білмегеніңізге сенімдісіз бе?
Dialogue: 0,1:13:33.24,1:13:36.45,Default,,0,0,0,,Ескі деректер жоғалғандықтан.
Dialogue: 0,1:13:36.53,1:13:40.41,Default,,0,0,0,,Пекопонды басып алу менің керондық әріптестердің жұмысы болды.
Dialogue: 0,1:13:40.49,1:13:41.70,Default,,0,0,0,,Маған кедергі жасамаңыз!
Dialogue: 0,1:13:42.54,1:13:43.41,Default,,0,0,0,,Е...
Dialogue: 0,1:13:43.50,1:13:45.71,Default,,0,0,0,,Мен ханшайымнан бас тартпаймын.
Dialogue: 0,1:13:46.88,1:13:47.96,Default,,0,0,0,,Тек Нацуми...
Dialogue: 0,1:13:49.00,1:13:50.84,Default,,0,0,0,,Ішінде менің әпкем бар...
Dialogue: 0,1:13:50.92,1:13:55.30,Default,,0,0,0,,Енді тыныш болыңыз және Марон планетаңызға оралыңыз.
Dialogue: 0,1:13:56.05,1:13:58.01,Default,,0,0,0,,Біздің жұлдыз...
Dialogue: 0,1:13:58.10,1:14:00.18,Default,,0,0,0,,Мен Жұлдыз Марон туралы білмеймін.
Dialogue: 0,1:14:00.26,1:14:02.77,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,1:14:02.85,1:14:05.44,Default,,0,0,0,,Осы планетаны өз жұлдызымызға айналдырайық!
Dialogue: 0,1:14:05.52,1:14:07.69,Default,,0,0,0,,Иә, оны біздің жұлдызға айналдыр
Dialogue: 0,1:14:08.56,1:14:10.69,Default,,0,0,0,,Бізде де қайтып келетін жұлдыз бар...
Dialogue: 0,1:14:11.57,1:14:12.57,Default,,0,0,0,,Иә
Dialogue: 0,1:14:12.65,1:14:14.90,Default,,0,0,0,,Алданба, Марл
Dialogue: 0,1:14:14.99,1:14:16.28,Default,,0,0,0,,Бірақ ханзада
Dialogue: 0,1:14:16.36,1:14:16.95,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:17.03,1:14:18.32,Default,,0,0,0,,Мені жіберме
Dialogue: 0,1:14:18.41,1:14:19.99,Default,,0,0,0,,Фуюки-доно!
Dialogue: 0,1:14:20.08,1:14:21.62,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,1:14:21.70,1:14:22.62,Default,,0,0,0,,Джироро!
Dialogue: 0,1:14:22.70,1:14:23.62,Default,,0,0,0,,Чий!
Dialogue: 0,1:14:24.96,1:14:27.46,Default,,0,0,0,,Өлімсіз Армагеддон!
Dialogue: 0,1:14:27.96,1:14:30.04,Default,,0,0,0,,Ng...
Dialogue: 0,1:14:30.75,1:14:31.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:14:32.00,1:14:32.63,Default,,0,0,0,,Ағай!
Dialogue: 0,1:14:32.71,1:14:34.88,Default,,0,0,0,,Демек, мұнда Бағана болған екен ғой?
Dialogue: 0,1:14:34.97,1:14:36.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:14:36.22,1:14:37.26,Default,,0,0,0,,Лорд Толығырақ...
Dialogue: 0,1:14:37.84,1:14:39.39,Default,,0,0,0,,Моа-чанға рахмет
Dialogue: 0,1:14:39.47,1:14:41.39,Default,,0,0,0,,Сержант: Менің әпкем сонда!
Dialogue: 0,1:14:41.47,1:14:42.89,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,1:14:45.77,1:14:47.52,Default,,0,0,0,,Бірақ бұл есік...
Dialogue: 0,1:14:48.35,1:14:48.90,Default,,0,0,0,,Ах
Dialogue: 0,1:14:54.32,1:14:56.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:56.15,1:14:57.07,Default,,0,0,0,,Иә
Dialogue: 0,1:15:03.49,1:15:06.25,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:15:07.16,1:15:08.25,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:15:08.33,1:15:10.17,Default,,0,0,0,,Фуюки-доно, бұл!
Dialogue: 0,1:15:10.67,1:15:12.17,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:15.34,1:15:16.30,Default,,0,0,0,,Ханзада Мер…
Dialogue: 0,1:15:16.92,1:15:21.30,Default,,0,0,0,,Уф... у... Мар...
Dialogue: 0,1:15:22.30,1:15:24.18,Default,,0,0,0,,Мен саған ешкімді жақындатпа дедім.
Dialogue: 0,1:15:24.26,1:15:26.85,Default,,0,0,0,,Ха, ханзада, бірақ...
Dialogue: 0,1:15:26.93,1:15:27.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:28.02,1:15:29.65,Default,,0,0,0,,Балалар...
Dialogue: 0,1:15:31.73,1:15:32.69,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,1:15:32.77,1:15:34.40,Default,,0,0,0,,Әй, эй... Әй, сен!
Dialogue: 0,1:15:34.98,1:15:36.74,Default,,0,0,0,,Мықты болыңыз, апа!
Dialogue: 0,1:15:36.82,1:15:37.90,Default,,0,0,0,,Оян!
Dialogue: 0,1:15:38.53,1:15:40.45,Default,,0,0,0,,Шулы, үйге қайт!
Dialogue: 0,1:15:40.53,1:15:42.91,Default,,0,0,0,,Нацуми менің ханшайымым болды
Dialogue: 0,1:15:42.99,1:15:45.29,Default,,0,0,0,,Үйге баратын кезегіңіз!
Dialogue: 0,1:15:46.12,1:15:46.83,Default,,0,0,0,,Ах
Dialogue: 0,1:15:46.91,1:15:50.25,Default,,0,0,0,,Мен Нацуми-дононы тастап, Марон планетасына тез оралдым.
Dialogue: 0,1:15:50.33,1:15:51.67,Default,,0,0,0,,Әйтпесе, осы Кероболмен...
Dialogue: 0,1:15:52.29,1:15:54.04,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:16:02.01,1:16:04.35,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,1:16:08.14,1:16:09.39,Default,,0,0,0,,Сержант?
Dialogue: 0,1:16:10.23,1:16:11.14,Default,,0,0,0,,Батарея бітті!
Dialogue: 0,1:16:11.23,1:16:12.10,Default,,0,0,0,,Өтірікші!
Dialogue: 0,1:16:12.19,1:16:15.07,Default,,0,0,0,,Мен қайтпаймын, кет!
Dialogue: 0,1:16:15.15,1:16:16.32,Default,,0,0,0,,- (Фуюки) Уау! - Құсу!
Dialogue: 0,1:16:16.40,1:16:19.82,Default,,0,0,0,,Армагеддон 1-де!
Dialogue: 0,1:16:19.90,1:16:22.28,Default,,0,0,0,,-Уау! -(Фуюки) А...
Dialogue: 0,1:16:26.20,1:16:27.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:16:27.87,1:16:28.91,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:29.00,1:16:30.87,Default,,0,0,0,,Ой!
Dialogue: 0,1:16:32.79,1:16:34.00,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:16:34.08,1:16:35.50,Default,,0,0,0,,Ал... әйтеуір
Dialogue: 0,1:16:35.59,1:16:36.63,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:39.72,1:16:41.05,Default,,0,0,0,,Ой!
Dialogue: 0,1:16:41.13,1:16:43.84,Default,,0,0,0,,Сол Кируруны әп-сәтте жойып жіберген күш.
Dialogue: 0,1:16:43.93,1:16:45.18,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,1:16:45.26,1:16:46.05,Default,,0,0,0,,Ах
Dialogue: 0,1:16:46.14,1:16:48.56,Default,,0,0,0,,Бірақ мен оны Нацумиге бермеймін.
Dialogue: 0,1:16:49.35,1:16:51.14,Default,,0,0,0,,Оны ешкімге бермеңіз!
Dialogue: 0,1:16:53.60,1:16:55.19,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,1:16:55.27,1:16:56.90,Default,,0,0,0,,-Фуюки-доно! -(Фуюки) Не?
Dialogue: 0,1:16:56.98,1:16:58.65,Default,,0,0,0,,Мен жолдасымды лақтырамын
Dialogue: 0,1:16:58.73,1:16:59.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:59.86,1:17:01.49,Default,,0,0,0,,Ішке кір! тез!
Dialogue: 0,1:17:02.74,1:17:04.32,Default,,0,0,0,,Сержант, өтінемін!
Dialogue: 0,1:17:13.08,1:17:13.71,Default,,0,0,0,,Уау
Dialogue: 0,1:17:13.79,1:17:20.21,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,1:17:26.30,1:17:28.47,Default,,0,0,0,,- Фуюки-сан - (Фуюки) Иә.
Dialogue: 0,1:17:32.89,1:17:35.81,Default,,0,0,0,,Ханзада, бұл не...
Dialogue: 0,1:17:39.32,1:17:40.65,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,1:17:41.15,1:17:41.65,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:46.87,1:17:47.95,Default,,0,0,0,,Қамал...
Dialogue: 0,1:17:48.03,1:17:48.53,Default,,0,0,0,,Не!
Dialogue: 0,1:18:05.30,1:18:06.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:06.64,1:18:07.89,Default,,0,0,0,,А...
Dialogue: 0,1:18:07.97,1:18:09.14,Default,,0,0,0,,Уф!
Dialogue: 0,1:18:10.10,1:18:11.39,Default,,0,0,0,,Ағай~!
Dialogue: 0,1:18:11.47,1:18:14.39,Default,,0,0,0,,Ги-ро!
Dialogue: 0,1:18:26.49,1:18:28.20,Default,,0,0,0,,- (Фуюки) Әпке! -Ах
Dialogue: 0,1:18:28.28,1:18:29.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:29.24,1:18:32.95,Default,,0,0,0,,Қазір бүкіл планетаны мұхитқа батыратын уақыт
Dialogue: 0,1:18:33.04,1:18:34.62,Default,,0,0,0,,Оны біздікі етіңіз
Dialogue: 0,1:18:44.63,1:18:47.13,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:18:48.14,1:18:50.01,Default,,0,0,0,,- Күте тұрыңыз! -(Фуюки) Иә?
Dialogue: 0,1:18:50.10,1:18:51.10,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:51.18,1:18:54.10,Default,,0,0,0,,Армагеддон 1-де!
Dialogue: 0,1:18:59.69,1:19:01.11,Default,,0,0,0,,Кя~!
Dialogue: 0,1:19:16.41,1:19:17.87,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,1:19:18.37,1:19:20.33,Default,,0,0,0,,Мен Нацумиге бермеймін
Dialogue: 0,1:19:20.42,1:19:22.84,Default,,0,0,0,,Қайт, үйге, үйге қайт!
Dialogue: 0,1:19:22.92,1:19:24.30,Default,,0,0,0,,Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,1:19:25.01,1:19:28.18,Default,,0,0,0,,Әй, әпкемді қайтарып берші!
Dialogue: 0,1:19:29.09,1:19:32.18,Default,,0,0,0,,Ол біздің әпкеміз!
Dialogue: 0,1:19:32.76,1:19:35.68,Default,,0,0,0,,Өтінемін! Оян, әпке!
Dialogue: 0,1:19:39.81,1:19:42.23,Default,,0,0,0,,Ханзада Мерле, оны тоқтатайық.
Dialogue: 0,1:19:42.31,1:19:45.03,Default,,0,0,0,,Нацуми ханшайымның маңызды отбасы бар.
Dialogue: 0,1:19:45.11,1:19:48.74,Default,,0,0,0,,Менің жолыма кедергі болма. Мен саған артта қал дедім.
Dialogue: 0,1:19:48.82,1:19:51.03,Default,,0,0,0,,Жоқ, ол төмендемейді.
Dialogue: 0,1:19:51.53,1:19:55.91,Default,,0,0,0,,Нацумиді мұңайтқанша маған ештеңе істеудің қажеті жоқ.
Dialogue: 0,1:19:55.99,1:19:57.50,Default,,0,0,0,,Егер солай болса, онда ол бұрынғыдай.
Dialogue: 0,1:19:57.58,1:19:59.62,Default,,0,0,0,,Мәңгі мен және ханзада болса да, бәрібір.
Dialogue: 0,1:19:59.71,1:20:02.63,Default,,0,0,0,,Тыныш, үндеме, үндеме!
Dialogue: 0,1:20:11.01,1:20:12.34,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:20:16.35,1:20:18.56,Default,,0,0,0,,Менің сүйікті қалам?
Dialogue: 0,1:20:19.06,1:20:20.35,Default,,0,0,0,,Бұл емес.
Dialogue: 0,1:20:20.94,1:20:23.90,Default,,0,0,0,,Сол кезде мен адасып қалдым.
Dialogue: 0,1:20:27.03,1:20:28.78,Default,,0,0,0,,Мен күшті болуым керек
Dialogue: 0,1:20:28.86,1:20:32.41,Default,,0,0,0,,Барлығына алаңдауға жол бермеңіз
Dialogue: 0,1:20:33.28,1:20:33.91,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:20:34.57,1:20:37.41,Default,,0,0,0,,Мен өзімді жалғыз сезінемін, жылағым келеді
Dialogue: 0,1:20:39.20,1:20:40.91,Default,,0,0,0,,Мен біреудің маған көмектескенін қалаймын
Dialogue: 0,1:20:49.84,1:20:52.88,Default,,0,0,0,,Мен... жалғызбын ба?
Dialogue: 0,1:20:56.14,1:20:58.06,Default,,0,0,0,,Жалғыз...
Dialogue: 0,1:21:00.48,1:21:01.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:01.31,1:21:04.98,Default,,0,0,0,,Нацуми ше!
Dialogue: 0,1:21:07.90,1:21:09.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:09.57,1:21:10.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:14.32,1:21:17.16,Default,,0,0,0,,Ах... Нацуми!
Dialogue: 0,1:21:17.24,1:21:17.87,Default,,0,0,0,,Анашым!
Dialogue: 0,1:21:19.24,1:21:21.00,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,1:21:21.08,1:21:24.58,Default,,0,0,0,,Мен саған анамды тастап кете алмайсың дедім.
Dialogue: 0,1:21:24.67,1:21:26.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:26.25,1:21:28.46,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,1:21:29.63,1:21:31.51,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:21:31.59,1:21:33.76,Default,,0,0,0,,Сізге жақсы, әпке~
Dialogue: 0,1:21:34.59,1:21:36.97,Default,,0,0,0,,Кешіріңіз, Фую-кун.
Dialogue: 0,1:21:37.47,1:21:41.27,Default,,0,0,0,,Уф... Уау! Уф...
Dialogue: 0,1:21:41.35,1:21:44.27,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,1:21:45.23,1:21:50.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:21:50.11,1:21:51.90,Default,,0,0,0,,Әпке!
Dialogue: 0,1:21:51.99,1:21:53.03,Default,,0,0,0,,Фуюки…
Dialogue: 0,1:21:54.40,1:21:55.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:56.11,1:21:57.20,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:57.28,1:22:00.12,Default,,0,0,0,,Тоқта... Әй, сен не істеп жатырсың, ақымақ бақа?
Dialogue: 0,1:22:00.20,1:22:03.46,Default,,0,0,0,,О, Нацуми-доно! Қайтадан қош келдіңіз
Dialogue: 0,1:22:03.54,1:22:04.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:04.12,1:22:05.79,Default,,0,0,0,,Сержант!
Dialogue: 0,1:22:06.37,1:22:07.25,Default,,0,0,0,,Фуюки!
Dialogue: 0,1:22:07.33,1:22:09.59,Default,,0,0,0,,-Жарайды! -(Нацуми) Ах.
Dialogue: 0,1:22:10.59,1:22:11.76,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:11.84,1:22:14.76,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,1:22:14.84,1:22:18.72,Default,,0,0,0,,Гррр! Сіз жігіттер!
Dialogue: 0,1:22:19.39,1:22:21.22,Default,,0,0,0,,Ханзада Мерле, өтінемін!
Dialogue: 0,1:22:21.31,1:22:22.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:22:40.08,1:22:44.66,Default,,0,0,0,,Ах... Мар... Ле...
Dialogue: 0,1:22:48.33,1:22:51.25,Default,,0,0,0,,Су деңгейі тез көтерілуде.
Dialogue: 0,1:22:51.34,1:22:53.76,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, жаһандық ауқымда үлкен су тасқыны болады!
Dialogue: 0,1:22:53.84,1:22:55.76,Default,,0,0,0,,Ханым…
Dialogue: 0,1:22:55.84,1:22:57.68,Default,,0,0,0,,Теңіз астынан жоғары энергетикалық реакция!
Dialogue: 0,1:22:57.76,1:22:58.26,Default,,0,0,0,,Әй!
Dialogue: 0,1:23:02.14,1:23:04.14,Default,,0,0,0,,N.P.G. Барлық кемелер қозғалады!
Dialogue: 0,1:23:14.23,1:23:15.15,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:16.07,1:23:17.65,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,1:23:18.82,1:23:20.16,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,1:23:21.70,1:23:24.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:25.95,1:23:27.79,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,1:23:28.46,1:23:30.13,Default,,0,0,0,,- Құсу~! -(Нацуми) Ах!
Dialogue: 0,1:23:30.21,1:23:31.21,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:23:31.79,1:23:32.75,Default,,0,0,0,,Аһ!
Dialogue: 0,1:23:32.84,1:23:34.34,Default,,0,0,0,,- (Нацуми) Уау! - Құсу!
Dialogue: 0,1:23:34.96,1:23:36.13,Default,,0,0,0,,Ханзада!
Dialogue: 0,1:23:36.21,1:23:39.01,Default,,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,1:23:39.51,1:23:41.64,Default,,0,0,0,,Бұл тоқтамайды!
Dialogue: 0,1:23:43.43,1:23:44.26,Default,,0,0,0,,Ханзада Мер!
Dialogue: 0,1:23:45.18,1:23:46.93,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,1:23:47.52,1:23:48.69,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,1:23:49.19,1:23:50.77,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,1:23:51.73,1:23:52.65,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,1:23:55.02,1:23:57.15,Default,,0,0,0,,Не? Алақай!
Dialogue: 0,1:23:57.24,1:23:58.15,Default,,0,0,0,,Марл!
Dialogue: 0,1:23:59.15,1:24:01.91,Default,,0,0,0,,Не... не болып жатыр?
Dialogue: 0,1:24:01.99,1:24:03.91,Default,,0,0,0,,- (Байланыс: Куруру) Куккук~ - (Барлығы) Ах!
Dialogue: 0,1:24:03.99,1:24:06.62,Default,,0,0,0,,Меребол олардың эмоцияларымен үндеседі.
Dialogue: 0,1:24:06.70,1:24:09.00,Default,,0,0,0,,Ол жабайы жүгіре бастады.
Dialogue: 0,1:24:09.08,1:24:10.21,Default,,0,0,0,,Осылайша, Джоэстар әулеті—
Dialogue: 0,1:24:10.29,1:24:12.67,Default,,0,0,0,,Бұлай жалғаса берсе, бұл аймақ ақырында ұшып кетеді.
Dialogue: 0,1:24:12.75,1:24:14.79,Default,,0,0,0,,Үлкен жарылыс тудырады
Dialogue: 0,1:24:15.46,1:24:16.88,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:24:16.96,1:24:19.51,Default,,0,0,0,,Оларды сол жерден алып кетуден басқа амалымыз жоқ.
Dialogue: 0,1:24:19.59,1:24:20.72,Default,,0,0,0,,Бұл...
Dialogue: 0,1:24:20.80,1:24:22.97,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,1:24:23.05,1:24:23.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:23.64,1:24:25.18,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:24:25.85,1:24:26.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:27.85,1:24:28.68,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:28.77,1:24:30.19,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,1:24:30.27,1:24:32.94,Default,,0,0,0,,Фуюки арқанды мықтап ұстады.
Dialogue: 0,1:24:36.02,1:24:37.65,Default,,0,0,0,,Хмм...
Dialogue: 0,1:24:39.78,1:24:41.07,Default,,0,0,0,,Сіз қалай ойлайсыз, сержант?
Dialogue: 0,1:24:41.99,1:24:44.28,Default,,0,0,0,,Әлі де көп нәрсе бар сияқты.
Dialogue: 0,1:24:45.95,1:24:46.58,Default,,0,0,0,,Құсу?
Dialogue: 0,1:24:46.66,1:24:48.45,Default,,0,0,0,,Ах, осы форма—сен соңғы іріктеуден өткенсің…
Dialogue: 0,1:24:48.95,1:24:49.95,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,1:24:55.17,1:24:57.59,Default,,0,0,0,,Электрондық пошта! Марл!
Dialogue: 0,1:24:58.55,1:24:59.76,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:00.26,1:25:02.38,Default,,0,0,0,,Пошта мен Марл Жаңалық!
Dialogue: 0,1:25:02.47,1:25:02.97,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:25:03.68,1:25:04.89,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,1:25:04.97,1:25:06.22,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,1:25:12.48,1:25:13.48,Default,,0,0,0,,Нацуми...
Dialogue: 0,1:25:18.07,1:25:19.98,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,1:25:20.07,1:25:22.99,Default,,0,0,0,,- Көбірек! -Бірақ...қолымнан келгеннің бәрін жасап жатырмын.
Dialogue: 0,1:25:24.28,1:25:25.99,Default,,0,0,0,,Джерри~!
Dialogue: 0,1:25:26.57,1:25:27.24,Default,,0,0,0,,≪Ол күлмейді≫
Dialogue: 0,1:25:27.33,1:25:30.25,Default,,0,0,0,,Уф! Уф!
Dialogue: 0,1:25:31.20,1:25:32.46,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:32.54,1:25:33.87,Default,,0,0,0,,- (Сөйлеуші: Жироро) Балалар сендер - (2 адам) Иә?
Dialogue: 0,1:25:33.96,1:25:37.00,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,1:25:37.09,1:25:38.13,Default,,0,0,0,,Ефрейтор Жиро!
Dialogue: 0,1:25:38.21,1:25:39.75,Default,,0,0,0,,Нацумиге не болды?
Dialogue: 0,1:25:39.84,1:25:43.76,Default,,0,0,0,,Угягягяи...
Dialogue: 0,1:25:43.84,1:25:45.26,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:45.34,1:25:48.10,Default,,0,0,0,,Нацуми, қолымды жібер.
Dialogue: 0,1:25:48.18,1:25:48.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:25:48.85,1:25:51.39,Default,,0,0,0,,Барлығымыз үйге қайтамыз!
Dialogue: 0,1:25:51.47,1:25:52.27,Default,,0,0,0,,Бәріміз үйге қайтайық!
Dialogue: 0,1:25:52.35,1:25:53.85,Default,,0,0,0,,Нацуми...
Dialogue: 0,1:25:54.35,1:25:55.27,Default,,0,0,0,,Ugi~!
Dialogue: 0,1:25:55.35,1:25:57.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:06.87,1:26:09.28,Default,,0,0,0,,- (Фуюки) Әпке! -Ағай!
Dialogue: 0,1:26:20.88,1:26:22.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:25.09,1:26:27.47,Default,,0,0,0,,- (Фуюки) Батарея бітті! -сурет?
Dialogue: 0,1:26:27.55,1:26:29.26,Default,,0,0,0,,- (Фуюки) Уау! -Кя~!
Dialogue: 0,1:26:35.48,1:26:37.06,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:26:37.56,1:26:40.86,Default,,0,0,0,,Мен үйге баруым керек... Мен анама уәде бердім.
Dialogue: 0,1:26:42.57,1:26:43.78,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,1:26:45.03,1:26:48.03,Default,,0,0,0,,Өтінемін, мен бәрімен бірге үйге барғым келеді.
Dialogue: 0,1:26:48.66,1:26:52.04,Default,,0,0,0,,Сол жерде... біздің үйде!
Dialogue: 0,1:26:59.13,1:27:01.25,Default,,0,0,0,,Уф... аа...
Dialogue: 0,1:27:01.75,1:27:03.92,Default,,0,0,0,,А... а...
Dialogue: 0,1:27:06.47,1:27:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:49.76,1:27:50.93,Default,,0,0,0,,Не… Не істеп жатырсың!?
Dialogue: 0,1:27:51.01,1:27:52.60,Default,,0,0,0,,Фуюки!
Dialogue: 0,1:27:52.68,1:27:53.97,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:27:54.06,1:27:55.81,Default,,0,0,0,,- Ағай! - (Фуюки/Нацуми) Иә?
Dialogue: 0,1:27:55.89,1:27:58.60,Default,,0,0,0,,Амансың ба? нағашы аға
Dialogue: 0,1:27:58.69,1:27:59.44,Default,,0,0,0,,Боке бақасы
Dialogue: 0,1:28:00.23,1:28:02.23,Default,,0,0,0,,- (Фуюки) Ах... - (Нацуми) Әйтеуір...
Dialogue: 0,1:28:08.15,1:28:10.11,Default,,0,0,0,,Қарама...
Dialogue: 0,1:28:10.86,1:28:12.24,Default,,0,0,0,,Қандай азап…
Dialogue: 0,1:28:12.32,1:28:13.83,Default,,0,0,0,,Бұл үлкен бұлдыр бақа!
Dialogue: 0,1:28:14.70,1:28:17.41,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,1:28:18.50,1:28:19.58,Default,,0,0,0,,Хехе
Dialogue: 0,1:28:19.66,1:28:21.46,Default,,0,0,0,,Нацуми-сан!
Dialogue: 0,1:28:21.54,1:28:23.00,Default,,0,0,0,,Фуюки-кун!
Dialogue: 0,1:28:23.08,1:28:24.54,Default,,0,0,0,,Сержант!
Dialogue: 0,1:28:24.63,1:28:25.59,Default,,0,0,0,,Нацуми!
Dialogue: 0,1:28:25.67,1:28:29.59,Default,,0,0,0,,(Коюки және басқалардың күлкісі)
Dialogue: 0,1:28:30.22,1:28:31.88,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:28:31.97,1:28:34.35,Default,,0,0,0,,​​Барлығыңызға рахмет!
Dialogue: 0,1:28:38.22,1:28:40.48,Default,,0,0,0,,Нацуми Бұл қай жерде?
Dialogue: 0,1:28:41.56,1:28:44.31,Default,,0,0,0,,Бұл менің қайтатын жерім.
Dialogue: 0,1:28:44.40,1:28:45.73,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,1:28:46.73,1:28:47.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:49.94,1:28:52.11,Default,,0,0,0,,Момока ханым!
Dialogue: 0,1:28:52.20,1:28:55.37,Default,,0,0,0,,Сау болғаныңа қуанамын, амансың!
Dialogue: 0,1:28:55.45,1:28:58.87,Default,,0,0,0,,Мен қазір жақсы жердемін, сондықтан кете аласыз ба?
Dialogue: 0,1:28:59.62,1:29:02.50,Default,,0,0,0,,Әйтеуір, мәселе шешілді.
Dialogue: 0,1:29:02.58,1:29:03.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:03.71,1:29:06.54,Default,,0,0,0,,Бірақ сіз ешкімді ұмытқан жоқсыз ба?
Dialogue: 0,1:29:06.63,1:29:07.96,Default,,0,0,0,,Дороро осында.
Dialogue: 0,1:29:08.05,1:29:10.05,Default,,0,0,0,,А, Куруру жоқ!
Dialogue: 0,1:29:10.13,1:29:11.01,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:11.92,1:29:12.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:12.55,1:29:15.47,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,1:29:32.45,1:29:33.74,Default,,0,0,0,,Ку~куку~
Dialogue: 0,1:29:35.32,1:29:38.62,Default,,0,0,0,,Олардың ғарыш кемесі құлыптың астында жерленген.
Dialogue: 0,1:29:39.33,1:29:42.46,Default,,0,0,0,,Бұл мұражай заты еді, бірақ мен оны жөндедім.
Dialogue: 0,1:29:43.12,1:29:46.63,Default,,0,0,0,,Сондай-ақ маршрут енгізілді. Бұл Марон планетасына тікелей рейс.
Dialogue: 0,1:29:46.71,1:29:48.17,Default,,0,0,0,,Аспазшы~
Dialogue: 0,1:29:55.55,1:29:58.22,Default,,0,0,0,,Қайтаратын үй тапқаныңызға қуаныштымын.
Dialogue: 0,1:29:58.30,1:30:00.56,Default,,0,0,0,,Нацумиге рахмет
Dialogue: 0,1:30:00.64,1:30:02.73,Default,,0,0,0,,Ханшайым екеуіңе рахмет
Dialogue: 0,1:30:02.81,1:30:06.40,Default,,0,0,0,,Хехе, мен енді ханшайым емеспін.
Dialogue: 0,1:30:08.56,1:30:09.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:13.82,1:30:15.95,Default,,0,0,0,,Бүгіннен бастап сен ханшайымсың.
Dialogue: 0,1:30:16.03,1:30:18.20,Default,,0,0,0,,- (Марл) Иә? -(Электрондық пошта) А...
Dialogue: 0,1:30:18.28,1:30:19.45,Default,,0,0,0,,Хехехе
Dialogue: 0,1:30:21.74,1:30:23.96,Default,,0,0,0,,Бірге жақсы дос болайық
Dialogue: 0,1:30:37.55,1:30:39.55,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:30:39.64,1:30:41.47,Default,,0,0,0,,Электрондық пошта! Марл!
Dialogue: 0,1:30:42.81,1:30:45.48,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:30:45.56,1:30:47.44,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:30:47.52,1:30:49.48,Default,,0,0,0,,Мен шебер болып өмір сүремін!
Dialogue: 0,1:30:55.49,1:30:57.49,Default,,0,0,0,,♪～
Dialogue: 0,1:31:00.28,1:31:02.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:03.24,1:31:06.12,Default,,0,0,0,,Мереболдың әсері жойылды.
Dialogue: 0,1:31:34.48,1:31:37.24,Default,,0,0,0,,Жүр, апа, біз де үйге қайтайық.
Dialogue: 0,1:31:38.40,1:31:40.24,Default,,0,0,0,,Біздің нағыз үйде
Dialogue: 0,1:35:05.69,1:35:07.70,Default,,0,0,0,,～♪
Dialogue: 0,1:35:09.20,1:35:15.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory