Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.96,0:00:11.84,Default,,0,0,0,,Инузука-сан, сен ақ сызықтарды жақсы саласың.
Dialogue: 0,0:00:12.42,0:00:13.55,Default,,0,0,0,,Шынында ма?
Dialogue: 0,0:00:13.72,0:00:16.51,Default,,0,0,0,,Қараңдаршы, бұл мұғалім.
Dialogue: 0,0:00:16.68,0:00:18.22,Default,,0,0,0,,Оған қатысы бар ма?
Dialogue: 0,0:00:18.35,0:00:19.81,Default,,0,0,0,,Маңызды емес пе?
Dialogue: 0,0:00:20.06,0:00:21.18,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:00:21.43,0:00:22.89,Default,,0,0,0,,Әкелер!
Dialogue: 0,0:00:23.35,0:00:25.35,Default,,0,0,0,,Балалар, көкөністерді кесейік.
Dialogue: 0,0:00:25.44,0:00:27.48,Default,,0,0,0,,Көргісі келетіндер келсін!
Dialogue: 0,0:00:27.56,0:00:28.94,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:00:30.73,0:00:34.03,Default,,0,0,0,,Сіз көкөністерді турайсыз ба? шынымен
Dialogue: 0,0:00:34.36,0:00:37.28,Default,,0,0,0,,Баланың пышағы ғой, жарайды.
Dialogue: 0,0:00:37.99,0:00:40.37,Default,,0,0,0,,Келіңіздер! ерекше жазғы демалыс
Dialogue: 0,0:00:40.45,0:00:43.62,Default,,0,0,0,,Ұйқыдағы кешкі ас - карри.
Dialogue: 0,0:00:43.96,0:00:47.67,Default,,0,0,0,,Бәріміз бірігіп, дәмді нәрсе жасайық!
Dialogue: 0,0:00:47.75,0:00:49.84,Default,,0,0,0,,Иә
Dialogue: 0,0:00:50.38,0:00:52.76,Default,,0,0,0,,Қане, ретімен орындайық.
Dialogue: 0,0:00:52.88,0:00:55.13,Default,,0,0,0,,Бірінші, Цумуги-чан
Dialogue: 0,0:00:55.22,0:00:56.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:56.47,0:00:57.30,Default,,0,0,0,,О
Dialogue: 0,0:01:01.06,0:01:03.64,Default,,0,0,0,,Пышағыңды мықтап ұста, Цумуги-чан.
Dialogue: 0,0:01:03.73,0:01:04.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:04.93,0:01:07.31,Default,,0,0,0,,Көкөністерді ұстаған қол мысық!
Dialogue: 0,0:01:07.65,0:01:08.52,Default,,0,0,0,,Нян!
Dialogue: 0,0:01:14.74,0:01:15.74,Default,,0,0,0,,Уф…
Dialogue: 0,0:01:15.82,0:01:17.74,Default,,0,0,0,,Иә, жарайсың~
Dialogue: 0,0:01:17.82,0:01:19.37,Default,,0,0,0,,О~
Dialogue: 0,0:01:19.45,0:01:21.28,Default,,0,0,0,,Көрдің бе, Отосан?
Dialogue: 0,0:01:21.37,0:01:24.50,Default,,0,0,0,,Таңғажайып Цумугиді көрдім
Dialogue: 0,0:01:24.58,0:01:26.41,Default,,0,0,0,,Хе...
Dialogue: 0,0:01:26.62,0:01:28.08,Default,,0,0,0,,Сонда кездескенше~
Dialogue: 0,0:01:29.29,0:01:31.17,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:01:36.76,0:01:38.01,Default,,0,0,0,,Фу~
Dialogue: 0,0:01:38.43,0:01:40.30,Default,,0,0,0,,Балаларға арналған пышақ па?
Dialogue: 0,0:01:41.51,0:01:44.43,Default,,0,0,0,,Барлығымыз жасаған карри дайын!
Dialogue: 0,0:01:44.52,0:01:46.14,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:46.31,0:01:48.81,Default,,0,0,0,,Енді қолдарымызды біріктірейік...
Dialogue: 0,0:01:49.77,0:01:51.36,Default,,0,0,0,,Ас болсын!
Dialogue: 0,0:01:51.52,0:01:53.78,Default,,0,0,0,,Ас болсын!!
Dialogue: 0,0:01:56.65,0:01:57.90,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:01:57.99,0:01:59.91,Default,,0,0,0,,Бұл «дәмді», солай емес пе?
Dialogue: 0,0:01:59.99,0:02:01.53,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:02:01.62,0:02:03.03,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:02:03.12,0:02:04.74,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:02:06.91,0:02:09.04,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:02:09.12,0:02:10.17,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:02:10.25,0:02:11.13,Default,,0,0,0,,Иә
Dialogue: 0,0:02:13.21,0:02:15.88,Default,,0,0,0,,Бұл Цумугидің кесілген сәбізі ме?
Dialogue: 0,0:02:16.09,0:02:18.59,Default,,0,0,0,,Эххе, мүмкін Юука шығар
Dialogue: 0,0:02:19.26,0:02:21.22,Default,,0,0,0,,Үйде жасалған карри де дәмді, бірақ...
Dialogue: 0,0:02:21.30,0:02:23.76,Default,,0,0,0,,Бұл да ұқсас және дәмді!
Dialogue: 0,0:02:23.85,0:02:24.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:25.01,0:02:27.60,Default,,0,0,0,,Бұл кәдімгі карри.
Dialogue: 0,0:02:28.89,0:02:31.35,Default,,0,0,0,,Бұл мейрамханаларда жейтін нәрсе.
Dialogue: 0,0:02:31.44,0:02:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:34.07,0:02:36.28,Default,,0,0,0,,Үйде жасалған карри әлдеқайда ерекшеленеді.
Dialogue: 0,0:02:36.48,0:02:38.86,Default,,0,0,0,,Онда жүзім көп.
Dialogue: 0,0:02:39.03,0:02:41.66,Default,,0,0,0,,Жүзім? Мүмкін мейіз?
Dialogue: 0,0:02:41.91,0:02:44.62,Default,,0,0,0,,Кептірілген шығар!
Dialogue: 0,0:02:45.37,0:02:47.00,Default,,0,0,0,,Міне~
Dialogue: 0,0:02:48.08,0:02:49.71,Default,,0,0,0,,Бұл дәмді болды~
Dialogue: 0,0:02:59.01,0:03:00.17,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:03:00.51,0:03:03.01,Default,,0,0,0,,Менің карри толығырақ...
Dialogue: 0,0:03:04.39,0:03:08.39,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:04:28.89,0:04:32.89,Default,,0,0,0,,~♪
Dialogue: 0,0:04:39.19,0:04:41.48,Default,,0,0,0,,Уау! Бұл әдемі
Dialogue: 0,0:04:41.61,0:04:44.03,Default,,0,0,0,,Ақ жолдың ішіндегі отшашулар~
Dialogue: 0,0:04:44.20,0:04:47.12,Default,,0,0,0,,Достарыңызбен кездеспеңіз~
Dialogue: 0,0:04:47.49,0:04:51.79,Default,,0,0,0,,Уау~ Отосан, қарашы, қарашы!
Dialogue: 0,0:04:52.54,0:04:53.41,Default,,0,0,0,,О
Dialogue: 0,0:04:53.62,0:04:55.42,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:04:55.50,0:04:57.75,Default,,0,0,0,,Бұл өте сүйкімді.
Dialogue: 0,0:04:57.83,0:05:01.46,Default,,0,0,0,,Керемет! Менің отшашуларым керемет!
Dialogue: 0,0:05:02.09,0:05:04.05,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:05:04.13,0:05:07.89,Default,,0,0,0,,Не! Менікі керемет...
Dialogue: 0,0:05:07.97,0:05:10.31,Default,,0,0,0,,Циклдан аулақ болыңыз!
Dialogue: 0,0:05:10.39,0:05:11.47,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:05:11.56,0:05:13.68,Default,,0,0,0,,Жібер!
Dialogue: 0,0:05:13.77,0:05:15.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:15.27,0:05:18.48,Default,,0,0,0,,Барлығы балабақшада қалады.
Dialogue: 0,0:05:18.60,0:05:22.03,Default,,0,0,0,,Үйдегі баршаға қайырлы түн айтайық.
Dialogue: 0,0:05:23.19,0:05:26.03,Default,,0,0,0,,Қайырлы түн!
Dialogue: 0,0:05:26.11,0:05:28.53,Default,,0,0,0,,Қайырлы түн!
Dialogue: 0,0:05:28.61,0:05:30.78,Default,,0,0,0,,Мен сені ертең алып кетемін!
Dialogue: 0,0:05:30.87,0:05:31.87,Default,,0,0,0,,Оу!
Dialogue: 0,0:05:32.08,0:05:34.16,Default,,0,0,0,,Қайырлы түн, Отосан!
Dialogue: 0,0:05:34.58,0:05:35.91,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:05:36.50,0:05:38.17,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:05:38.25,0:05:39.67,Default,,0,0,0,,Сен жыласың ба?
Dialogue: 0,0:05:42.50,0:05:44.63,Default,,0,0,0,,Шынымен бе? (Цумуги/Юка) Хаха...
Dialogue: 0,0:05:44.71,0:05:46.80,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:05:49.97,0:05:51.35,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:05.44,0:06:06.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:12.08,0:06:14.95,Default,,0,0,0,,Таңертең ыдыстарды қою керек пе?
Dialogue: 0,0:06:38.31,0:06:39.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.32,0:06:51.24,Default,,0,0,0,,Қызық, Цумуги дұрыс ұйықтап жатыр ма?
Dialogue: 0,0:06:54.53,0:06:58.41,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:06:59.37,0:07:01.29,Default,,0,0,0,,Қайтару...
Dialogue: 0,0:07:01.42,0:07:04.38,Default,,0,0,0,,Микио-кун, футонға кірейік.
Dialogue: 0,0:07:04.50,0:07:06.80,Default,,0,0,0,,Мұғалім, мен саған шапалақтаймын.
Dialogue: 0,0:07:07.30,0:07:10.43,Default,,0,0,0,,Мен үйге барамын... (Балабақша тәрбиешісі) Жарайды, жарайды.
Dialogue: 0,0:07:14.05,0:07:15.39,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:15.47,0:07:16.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:18.93,0:07:20.56,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:07:20.77,0:07:23.40,Default,,0,0,0,,Ей, сен бүгін ұйықтап қалдың, солай ма?
Dialogue: 0,0:07:23.94,0:07:26.77,Default,,0,0,0,,Иә, мен жаңа ғана бітіріп, қайта оралдым.
Dialogue: 0,0:07:26.98,0:07:27.90,Default,,0,0,0,,Тамақ туралы не деуге болады?
Dialogue: 0,0:07:28.23,0:07:30.86,Default,,0,0,0,,Балалар балабақшада карри пісірді.
Dialogue: 0,0:07:31.24,0:07:32.91,Default,,0,0,0,,Біз бірге тамақтандық.
Dialogue: 0,0:07:33.28,0:07:36.78,Default,,0,0,0,,Түсіндім... сонда не істеуіміз керек? Сіз ішуге келгіңіз келе ме?
Dialogue: 0,0:07:37.24,0:07:38.41,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:07:38.74,0:07:42.00,Default,,0,0,0,,Жоқ, бірдеңе болып қалса, мен көлікті шығарып салғым келеді.
Dialogue: 0,0:07:42.29,0:07:44.04,Default,,0,0,0,,Кешіріңіз, бірақ мен бүгін тоқтаймын.
Dialogue: 0,0:07:44.71,0:07:45.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:47.21,0:07:49.01,Default,,0,0,0,,Цумуги, мен болмасам да жылама
Dialogue: 0,0:07:49.46,0:07:50.84,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:51.13,0:07:52.34,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:07:52.88,0:07:56.10,Default,,0,0,0,,Тартылған ет пен мейіз қосылған карри.
Dialogue: 0,0:07:56.18,0:07:57.81,Default,,0,0,0,,Ей, оян!
Dialogue: 0,0:07:57.89,0:07:58.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.31,0:08:01.52,Default,,0,0,0,,Мм, сіз фарш дейсіз бе?
Dialogue: 0,0:08:01.85,0:08:03.44,Default,,0,0,0,,Балқымайтыны
Dialogue: 0,0:08:04.56,0:08:06.69,Default,,0,0,0,,Кема немесе құрғақ карри?
Dialogue: 0,0:08:06.90,0:08:09.98,Default,,0,0,0,,Мүмкін! Рахмет, көріскенше
Dialogue: 0,0:08:27.42,0:08:28.34,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:41.56,0:08:42.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:43.27,0:08:44.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:47.73,0:08:49.19,Default,,0,0,0,,Мұғалімнен
Dialogue: 0,0:08:52.28,0:08:53.57,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:08:53.69,0:08:54.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.70,0:08:57.20,Default,,0,0,0,,Құрғақ карри?
Dialogue: 0,0:08:57.99,0:08:59.99,Default,,0,0,0,,Дәл қазір!
Dialogue: 0,0:09:01.16,0:09:02.33,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:09:02.50,0:09:03.58,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:09:03.75,0:09:04.87,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:09:06.83,0:09:08.79,Default,,0,0,0,,Қазір! Гаргари-сан
Dialogue: 0,0:09:08.88,0:09:12.88,Default,,0,0,0,,Цумуги Кеше балабақшада ұйықтау кеші болды!
Dialogue: 0,0:09:13.09,0:09:16.13,Default,,0,0,0,,Цумуги! Қолыңызды жуыңыз және шайыңыз
Dialogue: 0,0:09:16.34,0:09:17.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:17.26,0:09:18.09,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:09:18.18,0:09:19.01,Default,,0,0,0,,О
Dialogue: 0,0:09:20.76,0:09:21.97,Default,,0,0,0,,〝Сәлеметсіз бе〞
Dialogue: 0,0:09:22.14,0:09:24.43,Default,,0,0,0,,〝Маған да құрғақ карри ұнайды〞
Dialogue: 0,0:09:24.52,0:09:26.52,Default,,0,0,0,,«Маған карридің кез келген түрі ұнайды».
Dialogue: 0,0:09:26.69,0:09:27.56,Default,,0,0,0,,О!
Dialogue: 0,0:09:28.23,0:09:29.56,Default,,0,0,0,,〝Міне сұрақ〞
Dialogue: 0,0:09:29.86,0:09:31.23,Default,,0,0,0,,«Ингредиенттер енгізілген»
Dialogue: 0,0:09:31.32,0:09:33.44,Default,,0,0,0,,``Мен пайдаланған карри русы мен дәмдеуіштер...''
Dialogue: 0,0:09:33.53,0:09:35.44,Default,,0,0,0,,«Білсеңіз, маған хабарлаңыз».
Dialogue: 0,0:09:35.95,0:09:37.95,Default,,0,0,0,,Хмм, материалдар...
Dialogue: 0,0:09:38.41,0:09:39.49,Default,,0,0,0,,Материал?
Dialogue: 0,0:09:40.28,0:09:42.87,Default,,0,0,0,,Сізде қайнатпа немесе дәмдеуіштер қалды ма?
Dialogue: 0,0:09:43.37,0:09:44.83,Default,,0,0,0,,Мен оның осында екеніне сенімдімін...
Dialogue: 0,0:09:44.91,0:09:45.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.00,0:09:49.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:51.50,0:09:52.75,Default,,0,0,0,,Рецепт ескертулері!
Dialogue: 0,0:09:52.84,0:09:57.17,Default,,0,0,0,,Түсіндім, кітап сөресін іздегендіктен таба алмадым.
Dialogue: 0,0:09:59.05,0:10:02.72,Default,,0,0,0,,Иә? Күте тұрыңыз... Мен небәрі 3 бет жаздым.
Dialogue: 0,0:10:03.72,0:10:05.64,Default,,0,0,0,,Кеңістікті сезу!
Dialogue: 0,0:10:06.68,0:10:07.94,Default,,0,0,0,,Эй, Зекро
Dialogue: 0,0:10:08.98,0:10:11.31,Default,,0,0,0,,Ал, сарықұйрық шалғам және...
Dialogue: 0,0:10:11.90,0:10:14.57,Default,,0,0,0,,О~ Құрғақ карри дейді!
Dialogue: 0,0:10:14.65,0:10:16.65,Default,,0,0,0,,Мен оны жудым~ Не? Не?
Dialogue: 0,0:10:17.28,0:10:20.41,Default,,0,0,0,,Цумуги! Енді үйде карри жасайық!
Dialogue: 0,0:10:20.74,0:10:22.33,Default,,0,0,0,,Үйде жасалған карри?
Dialogue: 0,0:10:22.70,0:10:26.16,Default,,0,0,0,,Үйдегі карри дегеніміз не?
Dialogue: 0,0:10:26.37,0:10:27.37,Default,,0,0,0,,Міне
Dialogue: 0,0:10:27.58,0:10:30.54,Default,,0,0,0,,Бұл менің үйде мейіз қосылған карри!
Dialogue: 0,0:10:30.75,0:10:33.92,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:10:34.00,0:10:35.67,Default,,0,0,0,,Жарайды, факс жіберуді жалғастырыңыз.
Dialogue: 0,0:10:35.76,0:10:38.30,Default,,0,0,0,,А, жоқ, мен бір рет көшірме жасадым...
Dialogue: 0,0:10:38.76,0:10:41.18,Default,,0,0,0,,Үйдегі карри Үйдегі карри!
Dialogue: 0,0:10:41.76,0:10:44.97,Default,,0,0,0,,Гаргари-сан! Анамның үйдегі карри...
Dialogue: 0,0:10:45.06,0:10:47.77,Default,,0,0,0,,Тәтті сиқырлы карри...
Dialogue: 0,0:11:04.70,0:11:06.37,Default,,0,0,0,,Ой... Ой, не болды?
Dialogue: 0,0:11:07.45,0:11:09.16,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:11:10.71,0:11:13.21,Default,,0,0,0,,Қашан тамақтану керек? ертең?
Dialogue: 0,0:11:13.42,0:11:15.63,Default,,0,0,0,,Қызық, ертең ерте ме?
Dialogue: 0,0:11:19.22,0:11:21.80,Default,,0,0,0,,Бұл жолы менде Инузука отбасының рецепті бар, сондықтан...
Dialogue: 0,0:11:21.88,0:11:24.01,Default,,0,0,0,,Жаңадан бастаушылар үшін мазмұны өзгертілген жоқ—
Dialogue: 0,0:11:24.18,0:11:26.85,Default,,0,0,0,,Түсінікті болу үшін анам қайта жазды.
Dialogue: 0,0:11:27.31,0:11:28.18,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:28.43,0:11:30.77,Default,,0,0,0,,Материал осылай көрінеді
Dialogue: 0,0:11:30.85,0:11:31.94,Default,,0,0,0,,О!
Dialogue: 0,0:11:32.10,0:11:35.19,Default,,0,0,0,,Эй, онда көп нәрсе бар.
Dialogue: 0,0:11:35.44,0:11:36.86,Default,,0,0,0,,Бұл қазына
Dialogue: 0,0:11:37.27,0:11:40.65,Default,,0,0,0,,Олар маусымдық көкөністерді де қосқан сияқты.
Dialogue: 0,0:11:41.11,0:11:43.57,Default,,0,0,0,,Сондай-ақ, карри ұнтағы, дәмдеуіштер және т.б.
Dialogue: 0,0:11:43.66,0:11:45.87,Default,,0,0,0,,Алдымен өлшеп алсаңыз, оңайырақ болады.
Dialogue: 0,0:11:46.08,0:11:48.12,Default,,0,0,0,,Мен оны өлшеп көрдім.
Dialogue: 0,0:11:48.20,0:11:50.37,Default,,0,0,0,,Енді алдымен көкөністерді турап ал...
Dialogue: 0,0:11:50.45,0:11:51.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:51.54,0:11:52.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:52.58,0:11:54.71,Default,,0,0,0,,Цумуги Хочо Сіз оны пайдалана аласыз!
Dialogue: 0,0:11:54.79,0:11:55.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.67,0:11:59.55,Default,,0,0,0,,Менде бүгін балаларға арналған пышақ жоқ, сондықтан...
Dialogue: 0,0:11:59.63,0:12:01.38,Default,,0,0,0,,Цумуги-сан көрінбейді.
Dialogue: 0,0:12:01.55,0:12:06.01,Default,,0,0,0,,Иә! Неліктен неге? Қолдануға болады, қолдануға болады...
Dialogue: 0,0:12:06.10,0:12:07.47,Default,,0,0,0,,Өйткені бұл қауіпті!
Dialogue: 0,0:12:09.60,0:12:11.23,Default,,0,0,0,,Уф...! (Әділет) А...
Dialogue: 0,0:12:12.44,0:12:13.39,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:13.56,0:12:16.90,Default,,0,0,0,,Ересектерге арналған пышақтарды тек әкеңізбен бірге болған кезде пайдаланыңыз.
Dialogue: 0,0:12:17.06,0:12:18.02,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:12:18.11,0:12:18.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:23.74,0:12:24.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:24.91,0:12:26.91,Default,,0,0,0,,Көкөністер Қандай қолды ұстау керек?
Dialogue: 0,0:12:27.12,0:12:27.95,Default,,0,0,0,,Нян!
Dialogue: 0,0:12:28.95,0:12:31.12,Default,,0,0,0,,Тон Тон Тон және аяқталды.
Dialogue: 0,0:12:31.29,0:12:32.12,Default,,0,0,0,,Иә
Dialogue: 0,0:12:32.87,0:12:33.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:42.05,0:12:42.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:49.93,0:12:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.68,0:12:53.56,Default,,0,0,0,,Фу~
Dialogue: 0,0:12:55.60,0:12:59.06,Default,,0,0,0,,Күрсін... Мен қолымнан келгеннің бәрін жасап қойдым, жарайды.
Dialogue: 0,0:12:59.23,0:13:01.73,Default,,0,0,0,,Иә, көмегіңіз үшін рахмет.
Dialogue: 0,0:13:01.90,0:13:02.90,Default,,0,0,0,,Ахх
Dialogue: 0,0:13:03.11,0:13:04.65,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:13:04.74,0:13:09.33,Default,,0,0,0,,Күні кеше мен балабақшада ұйықтайтын жерде балалардың пышағын қолдандым...
Dialogue: 0,0:13:09.62,0:13:11.66,Default,,0,0,0,,Енді оны пайдаланғыңыз келеді.
Dialogue: 0,0:13:11.79,0:13:13.79,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:13:14.04,0:13:16.37,Default,,0,0,0,,Мұның бәрі кесілген бе?
Dialogue: 0,0:13:16.50,0:13:17.88,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.04,0:13:21.17,Default,,0,0,0,,Жарайды, кесуді маған қалдырыңыз!
Dialogue: 0,0:13:21.38,0:13:22.96,Default,,0,0,0,,Саған қалдырдым~
Dialogue: 0,0:13:23.92,0:13:28.59,Default,,0,0,0,,Цумуги-чан пышақ қолданды.
Dialogue: 0,0:13:29.89,0:13:32.06,Default,,0,0,0,,Салыстырмалы түрде мен...
Dialogue: 0,0:13:32.97,0:13:35.73,Default,,0,0,0,,Хмм, пияз...
Dialogue: 0,0:13:36.02,0:13:37.31,Default,,0,0,0,,Көздің шаншуы
Dialogue: 0,0:13:37.52,0:13:38.73,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:13:40.56,0:13:43.44,Default,,0,0,0,,Енді қуыруды бастайық.
Dialogue: 0,0:13:43.57,0:13:48.61,Default,,0,0,0,,А, қатты сорпа негізін пайдаланып 300 cc сорпа жасаңыз.
Dialogue: 0,0:13:48.78,0:13:49.62,Default,,0,0,0,,Иә
Dialogue: 0,0:13:52.54,0:13:55.45,Default,,0,0,0,,Алдымен сарымсақ пен имбирді араластырып қуырамыз.
Dialogue: 0,0:13:56.16,0:14:00.29,Default,,0,0,0,,Хош иісті иіс шыққанда, пиязды қосыңыз.
Dialogue: 0,0:14:02.25,0:14:04.42,Default,,0,0,0,,Пияз мөлдір болған кезде—
Dialogue: 0,0:14:04.63,0:14:09.09,Default,,0,0,0,,Сәбіз, балдыркөк, баклажан қосып, қуырыңыз
Dialogue: 0,0:14:09.76,0:14:12.89,Default,,0,0,0,,Фаршты салып, піскен соң...
Dialogue: 0,0:14:13.18,0:14:16.48,Default,,0,0,0,,Карри ұнтағы мен тұзды қосыңыз
Dialogue: 0,0:14:17.02,0:14:20.44,Default,,0,0,0,,Енді туралған ингредиенттерді қосып, қайнатсаңыз болғаны.
Dialogue: 0,0:14:20.69,0:14:24.23,Default,,0,0,0,,Бір таңқаларлығы, оны кесіп алсаңыз, қалғаны оңай.
Dialogue: 0,0:14:24.61,0:14:25.44,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:14:26.53,0:14:28.90,Default,,0,0,0,,Қызанақ қосып, қайнатыңыз.
Dialogue: 0,0:14:30.32,0:14:31.16,Default,,0,0,0,,Қайнағаннан кейін—
Dialogue: 0,0:14:31.24,0:14:34.95,Default,,0,0,0,,Сорпаға үгітілген алма, мейіз, бұрыш қосыңыз.
Dialogue: 0,0:14:35.49,0:14:36.45,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:37.08,0:14:40.67,Default,,0,0,0,,Алма, мейіз, бұрыш…
Dialogue: 0,0:14:40.92,0:14:42.84,Default,,0,0,0,,Ах! жасыл бұрыш?
Dialogue: 0,0:14:43.13,0:14:47.84,Default,,0,0,0,,Сүйікті гратинге қосқаннан кейін де жей алмайтын жасыл бұрыш
Dialogue: 0,0:14:48.30,0:14:51.51,Default,,0,0,0,,Көп тағам жеген Цумуги-чан...
Dialogue: 0,0:14:51.68,0:14:55.85,Default,,0,0,0,,Мен жеңе алмаған жалғыз жасыл бұрыш!
Dialogue: 0,0:14:56.06,0:14:57.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:58.52,0:14:59.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.98,0:15:00.81,Default,,0,0,0,,Ах
Dialogue: 0,0:15:01.65,0:15:03.27,Default,,0,0,0,,Цу… Цумуги-чан
Dialogue: 0,0:15:03.36,0:15:05.61,Default,,0,0,0,,Карриде жасыл бұрыш бар...
Dialogue: 0,0:15:05.73,0:15:06.69,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:15:07.82,0:15:10.07,Default,,0,0,0,,Жарайды ма? Оны салыңыз
Dialogue: 0,0:15:10.53,0:15:11.36,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:12.28,0:15:13.12,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:15:13.41,0:15:15.24,Default,,0,0,0,,Үйдегі тәтті карри –
Dialogue: 0,0:15:15.33,0:15:18.75,Default,,0,0,0,,Кез келген көкөністі сиқырлы түрде карри дәміне айналдырады!
Dialogue: 0,0:15:19.37,0:15:20.37,Default,,0,0,0,,Сиқыр?
Dialogue: 0,0:15:20.54,0:15:21.62,Default,,0,0,0,,Хо
Dialogue: 0,0:15:22.42,0:15:24.84,Default,,0,0,0,,Цумуги Мен мұның дәмді екенін білемін.
Dialogue: 0,0:15:24.96,0:15:26.46,Default,,0,0,0,,Түсіндім... Түсіндім!
Dialogue: 0,0:15:26.55,0:15:28.55,Default,,0,0,0,,Бұл таңғажайып сиқыр~
Dialogue: 0,0:15:31.05,0:15:34.09,Default,,0,0,0,,Енді оны орташа температурада 10 минутқа қалдырыңыз.
Dialogue: 0,0:15:34.22,0:15:37.35,Default,,0,0,0,,Оны қайнатыңыз, су буланып кетеді!
Dialogue: 0,0:15:37.43,0:15:40.89,Default,,0,0,0,,Қайнау Қайнау...
Dialogue: 0,0:15:40.98,0:15:44.36,Default,,0,0,0,,Қайнау...
Dialogue: 0,0:15:44.65,0:15:45.65,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:15:46.40,0:15:50.86,Default,,0,0,0,,Жарайды, 10 минут болды, мен Цумуги-чанға біраз уақыт бөлемін.
Dialogue: 0,0:15:52.03,0:15:53.70,Default,,0,0,0,,Бұл сіз оны қоймас бұрын болды ма?
Dialogue: 0,0:15:53.78,0:15:56.03,Default,,0,0,0,,Иә, бұл құрғақ карри —
Dialogue: 0,0:15:56.12,0:15:59.87,Default,,0,0,0,,Дәмділікті балалар мен ересектер үшін реттеуге болады.
Dialogue: 0,0:16:01.62,0:16:05.50,Default,,0,0,0,,Гарам масала дәмдеуішін қоссаңыз, ол ащы болады, сондықтан...
Dialogue: 0,0:16:05.63,0:16:08.17,Default,,0,0,0,,Дәмді қоспас бұрын оны бір жаққа қойсаңыз—
Dialogue: 0,0:16:08.25,0:16:11.84,Default,,0,0,0,,Ересектер мен балалар үшін бөлек жасаудың қажеті жоқ, солай ма?
Dialogue: 0,0:16:12.01,0:16:13.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:13.72,0:16:16.89,Default,,0,0,0,,Дәл сол карриді жеп отырғандай сезінесіз.
Dialogue: 0,0:16:17.93,0:16:22.98,Default,,0,0,0,,Анам менің жақсы ана екенімді айтты.
Dialogue: 0,0:16:24.98,0:16:27.52,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:16:28.23,0:16:30.82,Default,,0,0,0,,Күрсін, иісі жақсы.
Dialogue: 0,0:16:31.44,0:16:33.95,Default,,0,0,0,,Бұл өте жақсы иіс.
Dialogue: 0,0:16:34.28,0:16:35.74,Default,,0,0,0,,Аш қалма.
Dialogue: 0,0:16:35.91,0:16:37.91,Default,,0,0,0,,Иә, маған ұнады!
Dialogue: 0,0:16:38.58,0:16:41.20,Default,,0,0,0,,Жарайды, жасауды жалғастырайық.
Dialogue: 0,0:16:41.37,0:16:44.33,Default,,0,0,0,,Иә! Ересектерге тек дәм татыңыз.
Dialogue: 0,0:16:44.42,0:16:46.67,Default,,0,0,0,,Тұз жеткіліксіз болса, оны қосыңыз.
Dialogue: 0,0:16:53.17,0:16:54.01,Default,,0,0,0,,Иә
Dialogue: 0,0:16:55.34,0:16:58.39,Default,,0,0,0,,Қызуды өшірер алдында ғана гарам масала қосыңыз.
Dialogue: 0,0:16:58.51,0:17:00.35,Default,,0,0,0,,Дәмділігін өз қалауыңыз бойынша реттеңіз
Dialogue: 0,0:17:00.72,0:17:01.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:04.18,0:17:05.35,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:17:05.56,0:17:07.19,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:17:09.57,0:17:12.19,Default,,0,0,0,,Инузука-санның үйдегі карриі!
Dialogue: 0,0:17:12.44,0:17:15.11,Default,,0,0,0,,Керемет таңқаларлық!
Dialogue: 0,0:17:15.36,0:17:17.87,Default,,0,0,0,,Күріш сәл қаттырақ піседі.
Dialogue: 0,0:17:18.16,0:17:19.45,Default,,0,0,0,,Қоңыр күрішті де араластырдым.
Dialogue: 0,0:17:19.53,0:17:21.45,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:17:21.54,0:17:23.29,Default,,0,0,0,,Тамақ ішейік Тамақ ішейік!
Dialogue: 0,0:17:23.37,0:17:25.37,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:17:27.79,0:17:30.09,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:17:31.55,0:17:32.38,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:33.21,0:17:34.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:34.80,0:17:36.38,Default,,0,0,0,,Олар мені өлтірмекші екені анық
Dialogue: 0,0:17:36.47,0:17:40.43,Default,,0,0,0,,Мейіз қосылған карри маған ұнамады...
Dialogue: 0,0:17:40.51,0:17:43.10,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:17:44.56,0:17:47.14,Default,,0,0,0,,Үйде жасалған карри өте дәмді!
Dialogue: 0,0:17:47.35,0:17:49.52,Default,,0,0,0,,Иә, өте дәмді!
Dialogue: 0,0:17:49.73,0:17:53.69,Default,,0,0,0,,Цумуги-чанчидің үйдегі карриі өте дәмді.
Dialogue: 0,0:18:01.95,0:18:05.25,Default,,0,0,0,,Цуцу... Цумуги Тыныштанып, баяу және мұқият шайнаңыз.
Dialogue: 0,0:18:05.33,0:18:07.37,Default,,0,0,0,,Жарайды (әділ) иә?
Dialogue: 0,0:18:07.54,0:18:09.42,Default,,0,0,0,,Цумуги-чанды толтыру -
Dialogue: 0,0:18:09.50,0:18:11.50,Default,,0,0,0,,Ол дұрыс бөлінген.
Dialogue: 0,0:18:12.04,0:18:14.55,Default,,0,0,0,,Хмм, мен тоқтай алмаймын!
Dialogue: 0,0:18:14.63,0:18:18.26,Default,,0,0,0,,Ахаха... Жарайды, менің қолымнан келмейтін сияқты.
Dialogue: 0,0:18:18.34,0:18:20.47,Default,,0,0,0,,Үйде жасалған карри дәмді
Dialogue: 0,0:18:20.64,0:18:22.60,Default,,0,0,0,,Иә, менің таңдауым жоқ!
Dialogue: 0,0:18:23.22,0:18:24.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:25.60,0:18:26.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:33.32,0:18:35.69,Default,,0,0,0,,Бүгін кешкі асқа не бар?
Dialogue: 0,0:18:39.24,0:18:40.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:49.71,0:18:50.71,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:08.06,0:19:08.98,Default,,0,0,0,,Ол оны қайта-қайта тыңдауды сұрай береді, сондықтан мен оны жаттап алдым.
Dialogue: 0,0:19:14.48,0:19:15.48,Default,,0,0,0,,Ох…
Dialogue: 0,0:19:15.90,0:19:16.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.49,0:19:20.90,Default,,0,0,0,,Қайта толтырыңыз! Хехе...
Dialogue: 0,0:19:21.82,0:19:22.74,Default,,0,0,0,,Ох…
Dialogue: 0,0:19:23.57,0:19:24.70,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:25.53,0:19:29.04,Default,,0,0,0,,Цумуги-чан үйде жасалған карриді жақсы көреді.
Dialogue: 0,0:19:29.20,0:19:31.29,Default,,0,0,0,,Иә! Бұны ұнатамын!
Dialogue: 0,0:19:34.29,0:19:35.88,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:36.17,0:19:37.30,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:19:38.34,0:19:40.63,Default,,0,0,0,,Қайырлы түн Цумуги-чан
Dialogue: 0,0:19:40.92,0:19:42.30,Default,,0,0,0,,Қайырлы түн~
Dialogue: 0,0:19:47.72,0:19:48.56,Default,,0,0,0,,Хе...
Dialogue: 0,0:19:49.56,0:19:50.68,Default,,0,0,0,,Неге күлдіңіз?
Dialogue: 0,0:19:50.85,0:19:54.31,Default,,0,0,0,,А, жоқ, мен бірдеңені есіме түсірдім.
Dialogue: 0,0:19:55.02,0:19:59.65,Default,,0,0,0,,Анам пиязды кесіп жатып жылады.
Dialogue: 0,0:19:59.74,0:20:01.20,Default,,0,0,0,,Карри уақыты келді, солай ма?
Dialogue: 0,0:20:01.95,0:20:03.49,Default,,0,0,0,,А, аа!
Dialogue: 0,0:20:03.66,0:20:06.83,Default,,0,0,0,,Ер адамның көзілдірігімен басы айналып бара жатқан жігіт!
Dialogue: 0,0:20:06.91,0:20:08.37,Default,,0,0,0,,Иә, бұл!
Dialogue: 0,0:20:08.54,0:20:10.33,Default,,0,0,0,,Уау Цумугимо—
Dialogue: 0,0:20:10.41,0:20:13.17,Default,,0,0,0,,Цумуги де дәл қазір есіне түсірді!
Dialogue: 0,0:20:13.37,0:20:15.29,Default,,0,0,0,,Біртүрлі көрінген осы емес пе?
Dialogue: 0,0:20:15.42,0:20:17.75,Default,,0,0,0,,Иә, шынымен бе?
Dialogue: 0,0:20:17.84,0:20:20.01,Default,,0,0,0,,Шынымен, шынымен! Біз біргеміз!
Dialogue: 0,0:20:20.09,0:20:23.38,Default,,0,0,0,,Хахаха түсіндім, бірге болдық.
Dialogue: 0,0:20:23.47,0:20:25.89,Default,,0,0,0,,Аха…
Dialogue: 0,0:20:25.97,0:20:27.60,Default,,0,0,0,,Ах ха
Dialogue: 0,0:20:28.43,0:20:29.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:30.81,0:20:33.02,Default,,0,0,0,,Цумуги, не болды?
Dialogue: 0,0:20:38.11,0:20:39.07,Default,,0,0,0,,Цумуги?
Dialogue: 0,0:20:40.69,0:20:43.07,Default,,0,0,0,,Анам келмейді...
Dialogue: 0,0:20:43.28,0:20:44.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:46.53,0:20:50.58,Default,,0,0,0,,Ото-сан, мен жетемін...
Dialogue: 0,0:20:50.70,0:20:51.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:53.54,0:20:56.08,Default,,0,0,0,,Ой... а...
Dialogue: 0,0:20:56.33,0:21:03.34,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:21:03.55,0:21:05.59,Default,,0,0,0,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:21:05.68,0:21:09.68,Default,,0,0,0,,(Цумугидің айқайы)
Dialogue: 0,0:21:13.39,0:21:15.23,Default,,0,0,0,,Мен бұдан былай үлгермеймін...
Dialogue: 0,0:21:15.35,0:21:16.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:17.10,0:21:19.44,Default,,0,0,0,,Уф, уф... Мен тамақ ішемін!
Dialogue: 0,0:21:34.20,0:21:36.79,Default,,0,0,0,,Үйде жасалған карри дәмді болды
Dialogue: 0,0:21:37.50,0:21:38.92,Default,,0,0,0,,Сәлем Цумуги
Dialogue: 0,0:21:39.92,0:21:40.75,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:42.21,0:21:43.55,Default,,0,0,0,,Жолсыз жерлерге арналған көлік қолайлырақ болар еді, білесің бе?
Dialogue: 0,0:21:56.39,0:22:00.40,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:27.94,0:23:31.95,Default,,0,0,0,,~♪
