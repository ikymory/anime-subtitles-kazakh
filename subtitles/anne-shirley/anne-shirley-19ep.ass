Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:03.67,Default,,0,0,0,,<Университеттің бірінші курсының жазғы демалысы➡
Dialogue: 0,0:00:03.67,0:00:07.00,Default,,0,0,0,,Сол кезде ата-анамнан хат алдым➡
Dialogue: 0,0:00:07.00,0:00:10.27,Default,,0,0,0,,Мен Авонлеаға қанағаттанған сезіммен оралдым＞
Dialogue: 0,0:00:10.27,0:00:15.81,Default,,0,0,0,,Негізі мен қазір шағын роман жазып, оны шығаруды ойлап жүрмін.
Dialogue: 0,0:00:15.81,0:00:17.75,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:17.75,0:00:21.42,Default,,0,0,0,,Баяғыда сіз Monogatari клубында маған қызықты оқиға жазған едіңіз.
Dialogue: 0,0:00:21.42,0:00:25.05,Default,,0,0,0,,Өткен жылы Редмондтың үшінші курс студенті жазған роман➡
Dialogue: 0,0:00:25.05,0:00:27.69,Default,,0,0,0,,Мен "Канада әйелдерінің досы" фильмінде болдым➡
Dialogue: 0,0:00:27.69,0:00:31.13,Default,,0,0,0,,Мен осылай жаза алатындай болдым.
Dialogue: 0,0:00:31.13,0:00:33.90,Default,,0,0,0,,Мен ол журналға жазыламын!
Dialogue: 0,0:00:33.90,0:00:38.00,Default,,0,0,0,,Мүмкін болса, мен оны үлкенірек баспагерге жібергім келеді.
Dialogue: 0,0:00:38.00,0:00:41.57,Default,,0,0,0,,Жазғалы отырған әңгімемнің сипатына байланысты.
Dialogue: 0,0:00:41.57,0:00:45.44,Default,,0,0,0,,Эй, Слоунның атасы кім?
Dialogue: 0,0:00:45.44,0:00:48.98,Default,,0,0,0,,Мен де Котон мырзаны көрмейтін сияқтымын...
Dialogue: 0,0:00:48.98,0:00:51.01,Default,,0,0,0,,Міне...
Dialogue: 0,0:00:51.01,0:00:53.75,Default,,0,0,0,,Ол... қайтыс болған болуы мүмкін бе?
Dialogue: 0,0:00:53.75,0:00:57.29,Default,,0,0,0,,Слоун қарт сақалын таза қырған➡
Dialogue: 0,0:00:57.29,0:01:00.49,Default,,0,0,0,,Мен табытта басқа біреу ұйықтап жатыр деп ойладым.
Dialogue: 0,0:01:00.49,0:01:03.46,Default,,0,0,0,,Әй, неге үлкендердің сөйлескені дұрыс?➡
Dialogue: 0,0:01:03.46,0:01:06.33,Default,,0,0,0,,Балаларға рұқсат етілмейді ме? Мен білгім келеді.
Dialogue: 0,0:01:06.33,0:01:10.23,Default,,0,0,0,,Иә. Есейесің бе, баласың ба маңызды емес. Хехе.
Dialogue: 0,0:01:10.23,0:01:12.47,Default,,0,0,0,,Әй, әйел келді.
Dialogue: 0,0:01:12.47,0:01:14.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:14.40,0:01:16.34,Default,,0,0,0,,Жүректің дауысы Билли Эндрюс…. ➡
Dialogue: 0,0:01:16.34,0:01:20.11,Default,,0,0,0,,Қарындасын сенімхат арқылы үйленуге мәжбүрлеген қыңыр адам. ➡
Dialogue: 0,0:01:20.11,0:01:23.71,Default,,0,0,0,,Жақсы жар тапқаныңызға қуаныштымын.
Dialogue: 0,0:01:23.71,0:01:26.68,Default,,0,0,0,,Энн апа. Бұл шошқа мінген пастор!
Dialogue: 0,0:01:26.68,0:01:29.55,Default,,0,0,0,,Ах…. Тынш!
Dialogue: 0,0:01:29.55,0:01:31.59,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:01:31.59,0:01:33.72,Default,,0,0,0,,Хехехе. …а.
Dialogue: 0,0:01:33.72,0:01:36.02,Default,,0,0,0,,Жүрек үні Бұл...
Dialogue: 0,0:01:37.93,0:01:40.33,Default,,0,0,0,,Жүрек үні Рубин?
Dialogue: 0,0:01:44.70,0:01:47.10,Default,,0,0,0,,Руби жарақат алды ма?
Dialogue: 0,0:01:47.10,0:01:49.94,Default,,0,0,0,,Оны өзі де, отбасы да мойындамаса да➡
Dialogue: 0,0:01:49.94,0:01:52.61,Default,,0,0,0,,Күзге дейін болмайды дейді.
Dialogue: 0,0:01:52.61,0:01:55.51,Default,,0,0,0,,Аа...⁉ Сен әлі жас болсаң да...
Dialogue: 0,0:01:55.51,0:01:57.75,Default,,0,0,0,,Қайтып келгенде сөйлесейік➡
Dialogue: 0,0:01:57.75,0:02:02.05,Default,,0,0,0,,Мен де Дианамен ақылдасып отырдым.
Dialogue: 0,0:02:02.05,0:02:04.65,Default,,0,0,0,,<Мен сене алмадым. ➡
Dialogue: 0,0:02:04.65,0:02:07.16,Default,,0,0,0,,Әрқашан жарқырап жүріңіз➡
Dialogue: 0,0:02:07.16,0:02:09.12,Default,,0,0,0,,Рубидің өмір оты➡
Dialogue: 0,0:02:09.12,0:02:12.13,Default,,0,0,0,,Жоғалуға жақын...＞
Dialogue: 0,0:02:12.13,0:02:21.37,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.37,0:02:26.04,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:26.04,0:02:28.58,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:28.58,0:02:30.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:30.51,0:02:34.38,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:34.38,0:02:36.72,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:36.72,0:02:38.95,Default,,0,0,0,,♬ «Мен сені жақсы көретінімді түсінемін».
Dialogue: 0,0:02:38.95,0:02:43.49,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:43.49,0:02:48.70,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:48.70,0:02:50.63,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:02:50.63,0:02:54.50,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:54.50,0:02:57.91,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:57.91,0:03:00.28,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:03:00.28,0:03:02.54,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:02.54,0:03:06.78,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:03:06.78,0:03:09.25,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:03:09.25,0:03:11.59,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:03:11.59,0:03:15.06,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:03:15.06,0:03:18.36,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:03:18.36,0:03:20.60,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:20.60,0:03:24.87,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:24.87,0:03:27.37,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:03:27.37,0:03:29.67,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:29.67,0:03:31.67,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:31.67,0:03:35.41,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:35.41,0:03:39.92,Default,,0,0,0,,♬～
Dialogue: 0,0:03:43.09,0:03:47.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:47.29,0:03:49.73,Default,,0,0,0,,Анна, мен сені сағындым.
Dialogue: 0,0:03:49.73,0:03:51.96,Default,,0,0,0,,Иә, мен де, Руби.
Dialogue: 0,0:03:51.96,0:03:54.93,Default,,0,0,0,,Ертең менің үйімде шағын той болады.
Dialogue: 0,0:03:54.93,0:03:56.93,Default,,0,0,0,,Анна, сіз де келіңіз.
Dialogue: 0,0:03:56.93,0:03:59.17,Default,,0,0,0,,Мен де Редмонд туралы естігім келеді.
Dialogue: 0,0:03:59.17,0:04:01.84,Default,,0,0,0,,Иә, мен міндетті түрде сұраймын.
Dialogue: 0,0:04:01.84,0:04:03.77,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:04:03.77,0:04:06.01,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:04:06.01,0:04:08.91,Default,,0,0,0,,Руби әрқашан Аннамен кездескісі келеді.
Dialogue: 0,0:04:08.91,0:04:13.45,Default,,0,0,0,,Мен сенімен жалғыз кездесуге шыдай алмаймын...
Dialogue: 0,0:04:13.45,0:04:20.99,Default,,0,0,0,,♬～
Dialogue: 0,0:04:20.99,0:04:26.36,Default,,0,0,0,,Бұл ауыр болады. Менің қолымнан келетіні қазір қарау ғана.
Dialogue: 0,0:04:26.36,0:04:30.27,Default,,0,0,0,,♬～
Dialogue: 0,0:04:30.27,0:04:34.77,Default,,0,0,0,,Қараңыз. Бұл алтын теңізде қалқып бара жатқан арал сияқты.
Dialogue: 0,0:04:34.77,0:04:39.47,Default,,0,0,0,,Осыншама қашықтыққа есу қандай тамаша болар еді.
Dialogue: 0,0:04:39.47,0:04:42.38,Default,,0,0,0,,Міне, біздің кешегі күн➡
Dialogue: 0,0:04:42.38,0:04:44.78,Default,,0,0,0,,Егер ол бұзылмаған болса...
Dialogue: 0,0:04:44.78,0:04:49.18,Default,,0,0,0,,Энн Сіз ескі әңгімелерді айтып тұрған кемпір сияқтысыз.
Dialogue: 0,0:04:52.89,0:04:55.62,Default,,0,0,0,,Әй, сен қандай роман жазасың?
Dialogue: 0,0:04:55.62,0:04:58.06,Default,,0,0,0,,Мен қазір сюжетті ойлап жатырмын.
Dialogue: 0,0:04:58.06,0:05:00.66,Default,,0,0,0,,Бірақ басты кейіпкердің есімі шешілді.
Dialogue: 0,0:05:00.66,0:05:03.63,Default,,0,0,0,,Авирил Лестер. Авирил?
Dialogue: 0,0:05:03.63,0:05:10.34,Default,,0,0,0,,Мен бұл романтикалық трагедия болғанын қаладым, бірақ редакторға қара аяқталуды ұнатпайтын сияқты.
Dialogue: 0,0:05:10.34,0:05:14.21,Default,,0,0,0,,«Бақытсыз аяқталуды тек данышпан жазуы керек».
Dialogue: 0,0:05:14.21,0:05:17.68,Default,,0,0,0,,Мен данышпандықтан алыспын.
Dialogue: 0,0:05:17.68,0:05:19.61,Default,,0,0,0,,Мен бақытты аяқтағым келеді.
Dialogue: 0,0:05:19.61,0:05:23.45,Default,,0,0,0,,Ой, Диана қайғылы оқиғаларға жылағысы келмейді.
Dialogue: 0,0:05:23.45,0:05:25.45,Default,,0,0,0,,Жарты жолға дейін.
Dialogue: 0,0:05:25.45,0:05:28.32,Default,,0,0,0,,Бірақ соңында бәрі өз орнына келеді➡
Dialogue: 0,0:05:28.32,0:05:30.73,Default,,0,0,0,,Маған ең бақытты аяқталу ұнайды.
Dialogue: 0,0:05:32.89,0:05:35.26,Default,,0,0,0,,(Күліп, сөйлесу)
Dialogue: 0,0:05:35.26,0:05:37.20,Default,,0,0,0,,♬～
Dialogue: 0,0:05:37.20,0:05:41.40,Default,,0,0,0,,Олардың барлығы мен танымайтын тұтынушылар. Рубин қайда?
Dialogue: 0,0:05:41.40,0:05:43.94,Default,,0,0,0,,Осы жолмен. (Анна Диана) Ах.
Dialogue: 0,0:05:43.94,0:05:45.94,Default,,0,0,0,,Диана да келді.
Dialogue: 0,0:05:45.94,0:05:47.94,Default,,0,0,0,,Хехе.
Dialogue: 0,0:05:47.94,0:05:50.28,Default,,0,0,0,,Мені жіберіңізші. Ал Диана ше?
Dialogue: 0,0:05:50.28,0:05:52.88,Default,,0,0,0,,Мен саған сусын алып келейін.
Dialogue: 0,0:05:52.88,0:05:57.12,Default,,0,0,0,,Мен де күзден бастап Ақ құмда сабақ беремін, солай ма?
Dialogue: 0,0:05:57.12,0:05:59.59,Default,,0,0,0,,Қазір дайындық қиын.
Dialogue: 0,0:05:59.59,0:06:03.33,Default,,0,0,0,,Менде әлі әлі жасамаған көк жібек бар...
Dialogue: 0,0:06:03.33,0:06:06.23,Default,,0,0,0,,Бұл қалпақ туралы не ойлайсың? Менің ойымша, бұл аздап жарқыраған.
Dialogue: 0,0:06:06.23,0:06:08.63,Default,,0,0,0,,...Ол сізге жарасады.
Dialogue: 0,0:06:08.63,0:06:11.53,Default,,0,0,0,,Хехе. Бүгін келгеніңізге қуаныштымын.
Dialogue: 0,0:06:11.53,0:06:15.57,Default,,0,0,0,,Мен сейсенбі және сәрсенбіде алыста болуым керек.
Dialogue: 0,0:06:15.57,0:06:17.17,Default,,0,0,0,,Кармодидің концерті және ➡
Dialogue: 0,0:06:17.17,0:06:19.44,Default,,0,0,0,,Ақ құмда кеш бар➡
Dialogue: 0,0:06:19.44,0:06:21.88,Default,,0,0,0,,Херб Спенсер сізді сонда апарсын.
Dialogue: 0,0:06:21.88,0:06:23.81,Default,,0,0,0,,Шөптер?
Dialogue: 0,0:06:23.81,0:06:27.55,Default,,0,0,0,,Сіз мені Спенсер-Веллдегі мұғаліммен құда болды деп ойладыңыз ба?
Dialogue: 0,0:06:27.55,0:06:29.48,Default,,0,0,0,,Бұл жай ғана өсек.
Dialogue: 0,0:06:29.48,0:06:34.66,Default,,0,0,0,,Төмендегі ұлдар да маңызды емес. Олар жай ғана келіп шу шығарады.
Dialogue: 0,0:06:34.66,0:06:37.46,Default,,0,0,0,,Шөп – сіздің тағдырыңыз.
Dialogue: 0,0:06:37.46,0:06:39.43,Default,,0,0,0,,Иә….
Dialogue: 0,0:06:39.43,0:06:44.03,Default,,0,0,0,,Сәлем, Руби. Жақында сырқаттанып қалдың деп естідім...
Dialogue: 0,0:06:44.03,0:06:47.07,Default,,0,0,0,,Өздеріңіз көріп отырғандай, мен сау және жақсымын.
Dialogue: 0,0:06:47.07,0:06:51.17,Default,,0,0,0,,Осы қыс барлығын аздап таң қалдырған шығар➡
Dialogue: 0,0:06:51.17,0:06:53.11,Default,,0,0,0,,Сіздің бетіңіз қазір жақсы көрінуі керек.
Dialogue: 0,0:06:53.11,0:06:56.98,Default,,0,0,0,,Жақсы... бұл жақсы болар еді.
Dialogue: 0,0:06:56.98,0:06:59.71,Default,,0,0,0,,Олай болса, тоқтайтын кез келді.
Dialogue: 0,0:06:59.71,0:07:02.02,Default,,0,0,0,,Не, қазірдің өзінде...?
Dialogue: 0,0:07:02.02,0:07:05.82,Default,,0,0,0,,Бүгінгі күн үшін рахмет. Мен Аннамен ақырын сөйлескім келді.
Dialogue: 0,0:07:05.82,0:07:09.36,Default,,0,0,0,,(Рубин) Біз әрқашан жақсы дос болдық.
Dialogue: 0,0:07:09.36,0:07:11.33,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:07:11.33,0:07:13.73,Default,,0,0,0,,Келесі жолы жалғыз кел. сурет?
Dialogue: 0,0:07:13.73,0:07:15.66,Default,,0,0,0,,Қашан келесіз?
Dialogue: 0,0:07:15.66,0:07:20.17,Default,,0,0,0,,Энн! Ха... Энн! асылу!
Dialogue: 0,0:07:20.17,0:07:22.20,Default,,0,0,0,,Энн!
Dialogue: 0,0:07:22.20,0:07:24.34,Default,,0,0,0,,Рубидің қолы...➡
Dialogue: 0,0:07:24.34,0:07:26.31,Default,,0,0,0,,Мен сондай арықпын...➡
Dialogue: 0,0:07:26.31,0:07:29.01,Default,,0,0,0,,Мен тыныс алуды тоқтатқандай болдым...
Dialogue: 0,0:07:29.01,0:07:31.45,Default,,0,0,0,,Анна….
Dialogue: 0,0:07:31.45,0:07:34.95,Default,,0,0,0,,Біз не істеуіміз керек, Диана?
Dialogue: 0,0:07:41.22,0:07:44.99,Default,,0,0,0,,Осындай кезде кім екен деп ойлаймын.
Dialogue: 0,0:07:44.99,0:07:47.90,Default,,0,0,0,,Харрисон мырза, біраз уақыт болды.
Dialogue: 0,0:07:47.90,0:07:50.13,Default,,0,0,0,,Жазғы демалыс? Иә.
Dialogue: 0,0:07:50.13,0:07:53.37,Default,,0,0,0,,Линд апай ертең бәліш пісіреді, мен оны саған әкелемін.
Dialogue: 0,0:07:53.37,0:07:56.71,Default,,0,0,0,,Сіз пирог алсаңыз да, шіркеуге садақа бермейсіз.
Dialogue: 0,0:07:56.71,0:07:59.24,Default,,0,0,0,,Жақсы! Хехе….
Dialogue: 0,0:07:59.24,0:08:04.71,Default,,0,0,0,,Сен жақсарту тобына садақа бермейсің, шіркеуге келмейсің бе, оғаш?
Dialogue: 0,0:08:04.71,0:08:06.65,Default,,0,0,0,,Сендер қашан дос болдыңдар?
Dialogue: 0,0:08:06.65,0:08:10.32,Default,,0,0,0,,Еске алу Келіссем де, садақа беру жеткіліксіз.
Dialogue: 0,0:08:10.32,0:08:12.29,Default,,0,0,0,,Қызылбас! Кішкентай қызыл шашты қыз!
Dialogue: 0,0:08:12.29,0:08:14.66,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:08:14.66,0:08:20.36,Default,,0,0,0,,Мен сол кезде ашуланғаныма сенімдімін, бірақ қоғамдық залдың түсі солай болып шықты...
Dialogue: 0,0:08:22.33,0:08:25.90,Default,,0,0,0,,Харрисон мырзаның түсінігі қате болмаған шығар.
Dialogue: 0,0:08:25.90,0:08:28.44,Default,,0,0,0,,Бұл жай ғана кездейсоқтық.
Dialogue: 0,0:08:28.44,0:08:32.17,Default,,0,0,0,,Иә. Бірақ ол өтірік айтпайтын, жағымпазданбайтын адам ➡
Dialogue: 0,0:08:32.17,0:08:34.78,Default,,0,0,0,,Жазуды аяқтаған соң, Харрисон мырза мен Дианаға ➡ айтыңыз
Dialogue: 0,0:08:34.78,0:08:36.75,Default,,0,0,0,,Мен саған оны оқып беремін.
Dialogue: 0,0:08:36.75,0:08:41.25,Default,,0,0,0,,Роман туралы не түсінесіз, Гаррисон мырза?
Dialogue: 0,0:08:43.05,0:08:44.99,Default,,0,0,0,,Ruby қалай болды?
Dialogue: 0,0:08:44.99,0:08:47.86,Default,,0,0,0,,Сіз мен күткеннен де жақсы көрінесіз.
Dialogue: 0,0:08:47.86,0:08:50.89,Default,,0,0,0,,Эй, қазір жақсысың ба? Иә.
Dialogue: 0,0:08:50.89,0:08:54.06,Default,,0,0,0,,Университет студенттері өте бос емес.
Dialogue: 0,0:08:54.06,0:08:57.60,Default,,0,0,0,,Мен саған шай мен печенье әкелемін.
Dialogue: 0,0:08:57.60,0:08:59.57,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:08:59.57,0:09:01.50,Default,,0,0,0,,Линдоның тәтесі біраз әбігерге түседі ➡
Dialogue: 0,0:09:01.50,0:09:04.31,Default,,0,0,0,,Сізге печенье пісіретін адамның болғаны жақсы.
Dialogue: 0,0:09:04.31,0:09:06.24,Default,,0,0,0,,Мен сізді естимін.
Dialogue: 0,0:09:06.24,0:09:09.84,Default,,0,0,0,,Ахх! (Анн Дора Линд ханым) Аха!
Dialogue: 0,0:09:14.72,0:09:17.95,Default,,0,0,0,,Еске алу Сен қашан келесің?
Dialogue: 0,0:09:17.95,0:09:20.42,Default,,0,0,0,,Еске алу Маған ең бақытты аяқталу ұнайды.
Dialogue: 0,0:09:20.42,0:09:23.32,Default,,0,0,0,,Жүректің дауысы Авирил Лестер. ➡
Dialogue: 0,0:09:23.32,0:09:26.29,Default,,0,0,0,,Маған сіздің әңгімеңізді жазуға рұқсат етіңіз.
Dialogue: 0,0:09:26.29,0:09:28.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:28.56,0:09:31.33,Default,,0,0,0,,<Осы жаздағы мақсатым - роман жазу➡
Dialogue: 0,0:09:31.33,0:09:35.24,Default,,0,0,0,,Сіз мені күтпеген жерден қолдадыңыз＞
Dialogue: 0,0:09:38.64,0:09:42.54,Default,,0,0,0,,♬～
Dialogue: 0,0:09:44.21,0:09:47.12,Default,,0,0,0,,<Мен Ruby-ге күнде дерлік барамын➡
Dialogue: 0,0:09:47.12,0:09:50.02,Default,,0,0,0,,Кешті бірге өткіздік＞
Dialogue: 0,0:09:50.02,0:09:53.89,Default,,0,0,0,,Мен күзден бастап мектепте сабақ беруді тастадым➡
Dialogue: 0,0:09:53.89,0:09:57.09,Default,,0,0,0,,Әкем жаңа жылға дейін күткен дұрыс дейді.
Dialogue: 0,0:09:57.09,0:09:59.03,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:09:59.03,0:10:02.86,Default,,0,0,0,,Қазірдің өзінде! Мен тіпті кешке көйлекті киемін.
Dialogue: 0,0:10:02.86,0:10:05.47,Default,,0,0,0,,Балалар тағы шулап жатыр.
Dialogue: 0,0:10:05.47,0:10:08.80,Default,,0,0,0,,үшін Шөпті қызғанса да, бұл үлкен мәселе...
Dialogue: 0,0:10:08.80,0:10:11.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.91,0:10:20.75,Default,,0,0,0,,<Рубидің үйінен қайтқанда мен әңгіме әлеміне әбден сіңіп кеттім. ➡
Dialogue: 0,0:10:20.75,0:10:24.15,Default,,0,0,0,,Авирил - құлаған дворян әулетінің ұрпағы. ➡
Dialogue: 0,0:10:24.15,0:10:28.49,Default,,0,0,0,,Басқа басты кейіпкер Персивал - жаңадан келе жатқан конгломераттың мұрагері. ➡
Dialogue: 0,0:10:28.49,0:10:32.99,Default,,0,0,0,,Ал Морис Авирилге әр қадамда дөрекілік танытады.
Dialogue: 0,0:10:32.99,0:10:38.27,Default,,0,0,0,,Саяси тұрақсыздықты пайдаланған жаңадан бастаушы＞
Dialogue: 0,0:10:38.27,0:10:40.50,Default,,0,0,0,,Өткен жылы Рождество кезінде➡
Dialogue: 0,0:10:40.50,0:10:44.91,Default,,0,0,0,,Спенсер Веллдегі мұғалім менің жан серігім деп ойладым.
Dialogue: 0,0:10:44.91,0:10:49.74,Default,,0,0,0,,Бірақ бұл басқаша болды. Мен одан бас тартқанымда, ол жылай бастады, мен қатты қиналдым.
Dialogue: 0,0:10:49.74,0:10:52.05,Default,,0,0,0,,Рубин⁉
Dialogue: 0,0:10:52.05,0:10:53.98,Default,,0,0,0,,Су әкел! (Рубин) Барма!
Dialogue: 0,0:10:53.98,0:10:59.45,Default,,0,0,0,,Жарайды, осында қал... Жақында жақсы болады...
Dialogue: 0,0:10:59.45,0:11:01.42,Default,,0,0,0,,Ruby-де бұрыннан бар...➡
Dialogue: 0,0:11:01.42,0:11:03.69,Default,,0,0,0,,Менің уақытым жоқ.
Dialogue: 0,0:11:03.69,0:11:06.16,Default,,0,0,0,,Әңгіме көп болуы керек.
Dialogue: 0,0:11:06.16,0:11:09.96,Default,,0,0,0,,Өмірдің мәні мен мақсаты Артында қалдырылатын сөздер...
Dialogue: 0,0:11:09.96,0:11:12.47,Default,,0,0,0,,Бірақ ей, бұл рубин.
Dialogue: 0,0:11:12.47,0:11:16.27,Default,,0,0,0,,Бұл туралы ұзақ уақыт бойы тек ұлдар айтып жүрді.
Dialogue: 0,0:11:16.27,0:11:20.78,Default,,0,0,0,,Руби танымалмын деп мақтанса, мен оның жақсы болатынына сенімдімін.
Dialogue: 0,0:11:23.14,0:11:28.38,Default,,0,0,0,,Маған ұнайтын жалғыз адам - ​​Херб Спенсер.
Dialogue: 0,0:11:28.38,0:11:31.59,Default,,0,0,0,,Шөп менің жан серігім екенін түсіндім.
Dialogue: 0,0:11:31.59,0:11:34.39,Default,,0,0,0,,Мен Хербпен құда болдым. Эх...
Dialogue: 0,0:11:34.39,0:11:36.32,Default,,0,0,0,,Жаңа жыл біткенде, бізде салтанатты шара болады...
Dialogue: 0,0:11:36.32,0:11:38.83,Default,,0,0,0,,Гохогохохо... Энн де келуі керек.
Dialogue: 0,0:11:38.83,0:11:41.63,Default,,0,0,0,,Иә... иә. Мен бос боламын.
Dialogue: 0,0:11:41.63,0:11:44.43,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:44.43,0:11:48.04,Default,,0,0,0,,Аннаға қара. Ол тіпті бақшаға да кірді ...
Dialogue: 0,0:11:50.64,0:11:52.74,Default,,0,0,0,,Ағайынды ма екен...
Dialogue: 0,0:11:54.84,0:11:57.31,Default,,0,0,0,,Жүрек үні Немесе...
Dialogue: 0,0:11:57.31,0:11:59.28,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:11:59.28,0:12:01.48,Default,,0,0,0,,(солқылдаған гүлдердің дыбысы)
Dialogue: 0,0:12:06.75,0:12:08.99,Default,,0,0,0,,Анн. а….
Dialogue: 0,0:12:08.99,0:12:11.76,Default,,0,0,0,,Сіз дұрыс ұйықтайсыз ба? Иә.
Dialogue: 0,0:12:11.76,0:12:15.60,Default,,0,0,0,,Рубинге барған сайын шаршап қайтасыз.
Dialogue: 0,0:12:15.60,0:12:18.53,Default,,0,0,0,,Сізге шынымен бару керек пе?
Dialogue: 0,0:12:18.53,0:12:22.47,Default,,0,0,0,,Мен Рубиннің көрінбейтін жаумен соғысып жатқанын көріп тұрмын.
Dialogue: 0,0:12:22.47,0:12:26.24,Default,,0,0,0,,Жіңішке қолдарымен кері итеруге тырысып...
Dialogue: 0,0:12:26.24,0:12:28.48,Default,,0,0,0,,Мен оған қарап тұрмын.
Dialogue: 0,0:12:28.48,0:12:32.28,Default,,0,0,0,,Десе де, оны біреу қадағалап отыруы керек...
Dialogue: 0,0:12:34.25,0:12:36.25,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:12:40.82,0:12:45.06,Default,,0,0,0,,Авирил мен Персивалдың кездесуінің соңы өте керемет!
Dialogue: 0,0:12:45.06,0:12:48.50,Default,,0,0,0,,Шынымен!? Бірақ... Сонымен... бірақ?
Dialogue: 0,0:12:48.50,0:12:51.50,Default,,0,0,0,,Мористі не үшін өлтірдің?
Dialogue: 0,0:12:51.50,0:12:56.84,Default,,0,0,0,,Морис жаман жігіт пе? Егер ол әлі тірі болса, ол міндетті түрде Персивалдың жолына қайта түседі.
Dialogue: 0,0:12:56.84,0:12:59.11,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:59.11,0:13:02.44,Default,,0,0,0,,Бірақ бәрібір, бұл талғампаз жұмыс екені сөзсіз.
Dialogue: 0,0:13:02.44,0:13:06.28,Default,,0,0,0,,Энн сенің атақты болатыныңа сенімдімін.
Dialogue: 0,0:13:06.28,0:13:08.95,Default,,0,0,0,,Біраз жақсарды.
Dialogue: 0,0:13:08.95,0:13:10.95,Default,,0,0,0,,Харрисон мырза айтқандай➡
Dialogue: 0,0:13:10.95,0:13:14.76,Default,,0,0,0,,Сюжетке қатысы жоқ сәнді сөздерді қиып алдым.
Dialogue: 0,0:13:14.76,0:13:17.76,Default,,0,0,0,,Алайда…. бірақ...?
Dialogue: 0,0:13:17.76,0:13:21.03,Default,,0,0,0,,Неліктен Авирил Мориспен кездеседі?
Dialogue: 0,0:13:21.03,0:13:25.67,Default,,0,0,0,,Неліктен... Неліктен барлығы Персивалдан гөрі Мористі жақсы көреді?
Dialogue: 0,0:13:25.67,0:13:27.60,Default,,0,0,0,,Жаман адам болса да.
Dialogue: 0,0:13:27.60,0:13:30.97,Default,,0,0,0,,Перцивал тым жақсы адам. Бұл өте көңілсіз.
Dialogue: 0,0:13:30.97,0:13:35.81,Default,,0,0,0,,Иә! Тыңдаңыз, романдар - бұл фантастика.
Dialogue: 0,0:13:35.81,0:13:39.31,Default,,0,0,0,,Сондықтан бұл шынымен болуы мүмкін нәрсе➡
Dialogue: 0,0:13:39.31,0:13:41.78,Default,,0,0,0,,Оқырманға сену керек. ➡
Dialogue: 0,0:13:41.78,0:13:46.22,Default,,0,0,0,,Сіздің жұмысыңызда шынайылық жоқ.
Dialogue: 0,0:13:46.22,0:13:50.09,Default,,0,0,0,,Не істеу керек? Сіз Харрисон мырзаның айтқанын орындайсыз ба?
Dialogue: 0,0:13:50.09,0:13:54.60,Default,,0,0,0,,Хмм... Дұрыс, бұл Аннаның романы.
Dialogue: 0,0:13:54.60,0:13:56.93,Default,,0,0,0,,Бұл нәтиже беретініне сенімдімін.
Dialogue: 0,0:13:56.93,0:13:58.60,Default,,0,0,0,,<Мен «Авирилдің өтеуі»➡
Dialogue: 0,0:13:58.60,0:14:03.40,Default,,0,0,0,,Мен оны әлемдегі ең танымал және ең ірі американдық журнал компаниясына жібердім. ➡
Dialogue: 0,0:14:03.40,0:14:05.84,Default,,0,0,0,,Алайда, екі аптадан кейін...＞
Dialogue: 0,0:14:05.84,0:14:09.58,Default,,0,0,0,,Ең үлкен қозғалыс қандай? Бұл өте қызық болмаса да!
Dialogue: 0,0:14:09.58,0:14:13.45,Default,,0,0,0,,Берілмеңіз. Оны «Канада әйелдерінің достарына» жіберіңіз.
Dialogue: 0,0:14:13.45,0:14:16.42,Default,,0,0,0,,Есте сақта! Тіпті Морган ханымның жұмысы➡
Dialogue: 0,0:14:16.42,0:14:18.69,Default,,0,0,0,,Маған бір рет қайтарылды.
Dialogue: 0,0:14:18.69,0:14:21.59,Default,,0,0,0,,Оқымай-ақ қайтарып жібергеніне сенімдімін.
Dialogue: 0,0:14:21.59,0:14:24.93,Default,,0,0,0,,Мен енді «Канада әйелдерінің серігін» оқымаймын!
Dialogue: 0,0:14:24.93,0:14:27.83,Default,,0,0,0,,Бұл ақымақ ой болды.
Dialogue: 0,0:14:27.83,0:14:31.73,Default,,0,0,0,,Мен Редмондты бітіргеннен кейін мен өзімді мұғалімдікке арнаймын.
Dialogue: 0,0:14:31.73,0:14:35.87,Default,,0,0,0,,Менің әдеби амбициям аяқталды.
Dialogue: 0,0:14:35.87,0:14:38.77,Default,,0,0,0,,…Сәлем, Энн. Сізге ұнаса➡
Dialogue: 0,0:14:38.77,0:14:42.38,Default,,0,0,0,,``Aviril's Redemption'' бір рет көшіріп бере аласыз ба?
Dialogue: 0,0:14:42.38,0:14:46.28,Default,,0,0,0,,Иә, егер Диана солай қаласа.
Dialogue: 0,0:14:47.92,0:14:50.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.32,0:14:52.25,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:14:52.25,0:14:55.26,Default,,0,0,0,,Энн... Маған көмектесіңізші... ➡
Dialogue: 0,0:14:55.26,0:14:57.59,Default,,0,0,0,,Келесі партия…➡
Dialogue: 0,0:14:57.59,0:14:59.53,Default,,0,0,0,,Мен шақыру жібергім келеді... ➡
Dialogue: 0,0:14:59.53,0:15:04.23,Default,,0,0,0,,Бірақ... конвертке ұқыпты келмеді...
Dialogue: 0,0:15:06.03,0:15:08.84,Default,,0,0,0,,А... Мен біраз демалуым керек.
Dialogue: 0,0:15:08.84,0:15:10.77,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:15:10.77,0:15:14.48,Default,,0,0,0,,Мен... мен саған қонаққа бармаймын...
Dialogue: 0,0:15:14.48,0:15:16.94,Default,,0,0,0,,Ruby?
Dialogue: 0,0:15:16.94,0:15:19.35,Default,,0,0,0,,Онда барыңыз...! Ах...
Dialogue: 0,0:15:19.35,0:15:22.15,Default,,0,0,0,,Келме! ➡
Dialogue: 0,0:15:22.15,0:15:24.22,Default,,0,0,0,,Келме...! Ах...
Dialogue: 0,0:15:24.22,0:15:26.69,Default,,0,0,0,,Рубин?
Dialogue: 0,0:15:26.69,0:15:29.59,Default,,0,0,0,,...
Dialogue: 0,0:15:29.59,0:15:31.89,Default,,0,0,0,,Шатастырылған шығар ➡
Dialogue: 0,0:15:31.89,0:15:34.36,Default,,0,0,0,,Ыстықтан шығар деп ойлаймын... (Рубидің анасы) О, құдай.
Dialogue: 0,0:15:34.36,0:15:37.60,Default,,0,0,0,,иә иә….
Dialogue: 0,0:15:37.60,0:15:39.53,Default,,0,0,0,,Ах. Энн!
Dialogue: 0,0:15:39.53,0:15:42.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:42.00,0:15:44.71,Default,,0,0,0,,Енді бармаймын деп уәде бер!
Dialogue: 0,0:15:44.71,0:15:47.41,Default,,0,0,0,,Егер сіз де ауырып қалсаңыз➡
Dialogue: 0,0:15:47.41,0:15:50.01,Default,,0,0,0,,Мен де сол бейшара Руби сияқты болғанымды қалаймын➡
Dialogue: 0,0:15:50.01,0:15:52.81,Default,,0,0,0,,Бұл туралы ойлау мені...
Dialogue: 0,0:15:52.81,0:15:55.15,Default,,0,0,0,,Жарайды, Марилла...
Dialogue: 0,0:15:55.15,0:15:57.15,Default,,0,0,0,,Мен қазірдің өзінде...➡
Dialogue: 0,0:15:57.15,0:16:00.12,Default,,0,0,0,,Мен Рубинді көрмеймін.
Dialogue: 0,0:16:00.12,0:16:02.76,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:16:02.76,0:16:22.78,Default,,0,0,0,,♬～
Dialogue: 0,0:16:22.78,0:16:33.45,Default,,0,0,0,,♬～
Dialogue: 0,0:16:33.45,0:16:36.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:36.79,0:16:39.69,Default,,0,0,0,,Сәлеметсіз бе! Харрисон мырза.
Dialogue: 0,0:16:41.63,0:16:43.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:43.56,0:16:48.40,Default,,0,0,0,,Сіздің арқаңызда мен мүлдем бас тарттым. Бұл қазір өте сергітеді.
Dialogue: 0,0:16:48.40,0:16:52.97,Default,,0,0,0,,Роман жазу соншалықты ауыртпалыққа айналғанына сене алар емеспін.
Dialogue: 0,0:16:52.97,0:16:56.28,Default,,0,0,0,,Мен жаза берер едім.
Dialogue: 0,0:16:56.28,0:16:58.35,Default,,0,0,0,,Е...
Dialogue: 0,0:16:58.35,0:17:02.18,Default,,0,0,0,,Мен толығымен бас тартпас едім, Энн.
Dialogue: 0,0:17:02.18,0:17:06.32,Default,,0,0,0,,Жоқ... кешіріңіз... Мен...
Dialogue: 0,0:17:06.32,0:17:09.22,Default,,0,0,0,,Маған қатты сын айтуыңызды өтінемін.
Dialogue: 0,0:17:09.22,0:17:13.33,Default,,0,0,0,,Бұл жеткілікті. Мен жеткілікті зардап шектім.
Dialogue: 0,0:17:15.43,0:17:17.93,Default,,0,0,0,,... ауырды ма?
Dialogue: 0,0:17:20.27,0:17:23.17,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:17:23.17,0:17:25.11,Default,,0,0,0,,Жүрек үні Сонда не болады? ➡
Dialogue: 0,0:17:25.11,0:17:28.81,Default,,0,0,0,,Рубин - бұл... Рубин - бұл...!
Dialogue: 0,0:17:37.69,0:17:44.26,Default,,0,0,0,,(Аяқ киім)
Dialogue: 0,0:17:44.26,0:17:46.69,Default,,0,0,0,,Рубин... Мен...
Dialogue: 0,0:17:46.69,0:17:49.00,Default,,0,0,0,,Қараңыз. сурет….
Dialogue: 0,0:17:50.67,0:17:52.67,Default,,0,0,0,,Елес бар сияқты...
Dialogue: 0,0:17:54.54,0:17:58.07,Default,,0,0,0,,Жақында мен сонда жерленемін.
Dialogue: 0,0:17:58.07,0:18:00.01,Default,,0,0,0,,Ruby? Сен не туралы айтып тұрсың?
Dialogue: 0,0:18:00.01,0:18:02.41,Default,,0,0,0,,Сіз бәрін білесіз, солай ма?
Dialogue: 0,0:18:02.41,0:18:05.85,Default,,0,0,0,,Бұл жақсы. Мен де білдім. ➡
Dialogue: 0,0:18:05.85,0:18:08.75,Default,,0,0,0,,Мен жай ғана берілгім келмеді. ➡
Dialogue: 0,0:18:08.75,0:18:11.25,Default,,0,0,0,,Мен жай ғана... қорқамын.
Dialogue: 0,0:18:11.25,0:18:14.86,Default,,0,0,0,,Е... (Рубин) Жұмаққа бару емес пе?
Dialogue: 0,0:18:14.86,0:18:18.26,Default,,0,0,0,,Аспан өте әдемі жер.
Dialogue: 0,0:18:18.26,0:18:20.93,Default,,0,0,0,,Өйткені Киелі кітапта солай жазылған.
Dialogue: 0,0:18:20.93,0:18:23.23,Default,,0,0,0,,Бірақ бұл жерде бәрі басқаша.
Dialogue: 0,0:18:23.23,0:18:25.87,Default,,0,0,0,,Мен білмейтін жер... ➡
Dialogue: 0,0:18:25.87,0:18:30.57,Default,,0,0,0,,Мен жалғыз баруым керек...
Dialogue: 0,0:18:30.57,0:18:33.87,Default,,0,0,0,,Жүрегімдегі дауыс Ах... Кішкене болса да беріңізші...➡
Dialogue: 0,0:18:33.87,0:18:36.44,Default,,0,0,0,,Маған Рубиге көмектесетін сөздер беріңіз➡
Dialogue: 0,0:18:36.44,0:18:38.45,Default,,0,0,0,,беріңізші. ➡
Dialogue: 0,0:18:38.45,0:18:42.02,Default,,0,0,0,,Авонлеа, Принц Эдвард аралы➡
Dialogue: 0,0:18:42.02,0:18:44.92,Default,,0,0,0,,Аспандағы дана ақсақалдар.
Dialogue: 0,0:18:44.92,0:18:47.46,Default,,0,0,0,,Мүмкін...➡
Dialogue: 0,0:18:47.46,0:18:49.69,Default,,0,0,0,,Аспан және қазіргі өмір➡
Dialogue: 0,0:18:49.69,0:18:52.03,Default,,0,0,0,,Менің ойымша, бұл басқаша болмайды.
Dialogue: 0,0:18:52.03,0:18:55.90,Default,,0,0,0,,Өйткені мен қазіргі өмір салтын жалғастыра аламын➡
Dialogue: 0,0:18:55.90,0:18:59.90,Default,,0,0,0,,Өзіңмен болудың еш жамандығы жоқ.
Dialogue: 0,0:18:59.90,0:19:03.24,Default,,0,0,0,,Сіз қандай болсаңыз, солай жақсы адам бола аласыз➡
Dialogue: 0,0:19:03.24,0:19:05.27,Default,,0,0,0,,Абыройлы болу➡
Dialogue: 0,0:19:05.27,0:19:07.54,Default,,0,0,0,,Енді бәрі оңайырақ болады.
Dialogue: 0,0:19:07.54,0:19:09.98,Default,,0,0,0,,Қорықпа, Руби.
Dialogue: 0,0:19:09.98,0:19:12.31,Default,,0,0,0,,Мүмкін емес. ➡
Dialogue: 0,0:19:12.31,0:19:14.25,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:14.25,0:19:19.09,Default,,0,0,0,,Тіпті егер аспан шынымен Анна айтқан жерде болса➡
Dialogue: 0,0:19:19.09,0:19:22.56,Default,,0,0,0,,Мен ол жерде ешқашан көрген емеспін...?
Dialogue: 0,0:19:22.56,0:19:24.59,Default,,0,0,0,,Тек сіздің қиялыңыз➡
Dialogue: 0,0:19:24.59,0:19:27.43,Default,,0,0,0,,Бұл тым көп болмауы мүмкін...! ➡
Dialogue: 0,0:19:27.43,0:19:32.63,Default,,0,0,0,,Олар мүлдем бірдей емес... Бірдей болуы мүмкін емес!
Dialogue: 0,0:19:34.74,0:19:38.27,Default,,0,0,0,,Мен... өмір сүргім келеді... ➡
Dialogue: 0,0:19:38.27,0:19:40.31,Default,,0,0,0,,Басқа қыздар сияқты...➡
Dialogue: 0,0:19:40.31,0:19:44.45,Default,,0,0,0,,Өмір сүр... үйлен, балалы...
Dialogue: 0,0:19:44.45,0:19:46.45,Default,,0,0,0,,(жылау)
Dialogue: 0,0:19:46.45,0:19:48.68,Default,,0,0,0,,Нашар шөп….
Dialogue: 0,0:19:48.68,0:19:50.99,Default,,0,0,0,,Ол адам мені жақсы көреді... ➡
Dialogue: 0,0:19:50.99,0:19:56.16,Default,,0,0,0,,Мен де... мен де... ол кісі...
Dialogue: 0,0:19:56.16,0:20:07.97,Default,,0,0,0,,(Рубидің жылауы)
Dialogue: 0,0:20:11.01,0:20:14.48,Default,,0,0,0,,Мен бәрі туралы сөйлескенімізге қуаныштымын, Энн. ➡
Dialogue: 0,0:20:14.48,0:20:18.35,Default,,0,0,0,,Жаз бойы сенімен сөйлескім келді. ➡
Dialogue: 0,0:20:18.35,0:20:20.71,Default,,0,0,0,,Бірақ мен мұны істей алмадым.
Dialogue: 0,0:20:20.71,0:20:26.82,Default,,0,0,0,,Мен оны дауыстап айтсам, бәрі рас болып шығатындай сезінемін.
Dialogue: 0,0:20:26.82,0:20:29.49,Default,,0,0,0,,Мен жасап көремін.
Dialogue: 0,0:20:29.49,0:20:32.03,Default,,0,0,0,,Айтқаныңыз туралы мұқият ойланыңыз➡
Dialogue: 0,0:20:32.03,0:20:35.93,Default,,0,0,0,,Сенуге тырысыңыз. Иә... Мен бұл нәтиже болатынына сенімдімін.
Dialogue: 0,0:20:35.93,0:20:40.07,Default,,0,0,0,,Рахмет сізге Анна. Осы уақытқа дейін... сурет...?
Dialogue: 0,0:20:40.07,0:20:42.50,Default,,0,0,0,,Мен достарымның арасында➡
Dialogue: 0,0:20:42.50,0:20:44.44,Default,,0,0,0,,Сен маған бәрінен де ұнадың.
Dialogue: 0,0:20:44.44,0:20:47.34,Default,,0,0,0,,Ах...! (Рубин) Қайта келіңізші.
Dialogue: 0,0:20:47.34,0:20:49.38,Default,,0,0,0,,Иә...әрине.
Dialogue: 0,0:20:49.38,0:20:54.55,Default,,0,0,0,,Мен міндетті түрде тағы келемін.
Dialogue: 0,0:20:54.55,0:20:56.85,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:20:56.85,0:20:58.79,Default,,0,0,0,,Қазір ➡
Dialogue: 0,0:20:58.79,0:21:01.39,Default,,0,0,0,,Мен енді онша қорықпаймын...
Dialogue: 0,0:21:03.26,0:21:06.99,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:21:06.99,0:21:14.47,Default,,0,0,0,,(жылау)
Dialogue: 0,0:21:14.47,0:21:19.71,Default,,0,0,0,,♬～
Dialogue: 0,0:21:19.71,0:21:23.41,Default,,0,0,0,,Руби-сан жиі күлетін адам болған.
Dialogue: 0,0:21:23.41,0:21:26.01,Default,,0,0,0,,Аспанда мен де күліп қаламын ба деп.
Dialogue: 0,0:21:26.01,0:21:29.62,Default,,0,0,0,,Аспан Авонли сияқты болса екен...
Dialogue: 0,0:21:31.39,0:21:34.62,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:34.62,0:21:36.59,Default,,0,0,0,,Күліп жатқаныңызға сенімдімін.
Dialogue: 0,0:21:36.59,0:21:38.59,Default,,0,0,0,,Мен сенімдімін...➡
Dialogue: 0,0:21:38.59,0:21:41.40,Default,,0,0,0,,Қазір де...
Dialogue: 0,0:21:41.40,0:22:03.48,Default,,0,0,0,,♬～
Dialogue: 0,0:22:05.25,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Не маңызды?»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
