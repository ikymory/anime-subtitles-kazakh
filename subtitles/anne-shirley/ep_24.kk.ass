Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:04.87,Default,,0,0,0,,Анна...махаббатымды қабыл алыңыз➡
Dialogue: 0,0:00:04.87,0:00:08.77,Default,,0,0,0,,Сен маған тұрмысқа шыға аласың ба?
Dialogue: 0,0:00:17.18,0:00:19.25,Default,,0,0,0,,Мен... суретті... алмаймын.
Dialogue: 0,0:00:19.25,0:00:23.39,Default,,0,0,0,,Мен... мен саған үйлене алмаймын.
Dialogue: 0,0:00:23.39,0:00:25.95,Default,,0,0,0,,А...?
Dialogue: 0,0:00:25.95,0:00:28.66,Default,,0,0,0,,Мен алмаймын...!
Dialogue: 0,0:00:30.39,0:00:32.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:32.33,0:00:35.26,Default,,0,0,0,,Өйткені мен сені... сүймеймін.
Dialogue: 0,0:00:35.26,0:00:38.27,Default,,0,0,0,,А... сен мені қалжыңдап тұрсың ба?
Dialogue: 0,0:00:38.27,0:00:42.00,Default,,0,0,0,,Жоқ! Жоқ, олай емес.
Dialogue: 0,0:00:42.00,0:00:45.97,Default,,0,0,0,,Мен сені шын сүйемін деп ойладым.
Dialogue: 0,0:00:45.97,0:00:49.24,Default,,0,0,0,,Бірақ... әйтпесе, қазір...➡
Dialogue: 0,0:00:49.24,0:00:52.18,Default,,0,0,0,,Мен енді түсіндім...
Dialogue: 0,0:00:52.18,0:00:55.95,Default,,0,0,0,,Сен менің өмірімді құрттың.
Dialogue: 0,0:00:55.95,0:00:59.52,Default,,0,0,0,,Ах... өтінемін, мені кешіріңіз...
Dialogue: 0,0:00:59.52,0:01:06.09,Default,,0,0,0,,♬～
Dialogue: 0,0:01:06.09,0:01:08.56,Default,,0,0,0,,Кішкене болса да үміт➡
Dialogue: 0,0:01:08.56,0:01:12.57,Default,,0,0,0,,Маған беруге рұқсат ете аласыз ба?
Dialogue: 0,0:01:16.91,0:01:19.78,Default,,0,0,0,,Мен жақсы көретін нәрсе –➡
Dialogue: 0,0:01:19.78,0:01:22.01,Default,,0,0,0,,Тек сен. ➡
Dialogue: 0,0:01:22.01,0:01:24.88,Default,,0,0,0,,Достық үшін рахмет. ➡
Dialogue: 0,0:01:24.88,0:01:27.28,Default,,0,0,0,,Қош бол. Ах...
Dialogue: 0,0:01:35.29,0:01:44.40,Default,,0,0,0,,♬～
Dialogue: 0,0:01:44.40,0:01:49.07,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:01:49.07,0:01:51.54,Default,,0,0,0,,♬ «Мүмкін болса да, болмаса да»
Dialogue: 0,0:01:51.54,0:01:53.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:01:53.51,0:01:57.38,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:01:57.38,0:01:59.75,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:01:59.75,0:02:01.78,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:01.78,0:02:06.46,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:06.46,0:02:11.66,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:11.66,0:02:13.60,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:13.60,0:02:17.47,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:17.47,0:02:20.87,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:20.87,0:02:23.31,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:23.31,0:02:25.57,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:25.57,0:02:29.81,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:29.81,0:02:32.28,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:32.28,0:02:34.62,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:34.62,0:02:38.09,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:38.09,0:02:41.39,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:41.39,0:02:43.63,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:43.63,0:02:47.90,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:02:47.90,0:02:50.40,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:50.40,0:02:52.70,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:02:52.70,0:02:54.70,Default,,0,0,0,,♬ «Мен сені алып кетейін.»
Dialogue: 0,0:02:54.70,0:02:58.31,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:02:58.31,0:03:03.01,Default,,0,0,0,,♬～
Dialogue: 0,0:03:05.58,0:03:09.89,Default,,0,0,0,,♬～
Dialogue: 0,0:03:14.79,0:03:16.99,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:22.46,0:03:24.43,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:24.43,0:03:26.84,Default,,0,0,0,,Қалай болды? а…. Хехе.
Dialogue: 0,0:03:29.07,0:03:31.01,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:03:31.01,0:03:33.71,Default,,0,0,0,,Мен айтқанымды айтпайынша, ештеңе айтпа.
Dialogue: 0,0:03:33.71,0:03:35.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:35.64,0:03:38.38,Default,,0,0,0,,Рой маған тұрмысқа шығуымды өтінді.
Dialogue: 0,0:03:38.38,0:03:40.32,Default,,0,0,0,,Ах...! Және…➡
Dialogue: 0,0:03:40.32,0:03:42.35,Default,,0,0,0,,Мен бас тарттым.
Dialogue: 0,0:03:42.35,0:03:46.02,Default,,0,0,0,,Сіз... жоқ дедіңіз бе?
Dialogue: 0,0:03:46.02,0:03:49.39,Default,,0,0,0,,Ах... Фил, өтінемін, маған ашуланба.
Dialogue: 0,0:03:49.39,0:03:51.39,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:03:51.39,0:03:53.63,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:03:53.63,0:03:56.00,Default,,0,0,0,,Сіз ұзақ уақыт бойы Ройдың назарын аударып жүрсіз➡
Dialogue: 0,0:03:56.00,0:03:58.70,Default,,0,0,0,,Енді сіз одан бас тартасыз ба?
Dialogue: 0,0:03:58.70,0:04:01.20,Default,,0,0,0,,Сіз ол адаммен ойнадыңыз ба?
Dialogue: 0,0:04:01.20,0:04:03.44,Default,,0,0,0,,Сенің мұндай әрекетке барарыңа сене алар емеспін...!
Dialogue: 0,0:04:03.44,0:04:06.78,Default,,0,0,0,,Жоқ, жоқ! Сонда неге!
Dialogue: 0,0:04:06.78,0:04:10.65,Default,,0,0,0,,Мен оны түсіндіре алмаймын. Рой үшін және сіз үшін...
Dialogue: 0,0:04:10.65,0:04:14.85,Default,,0,0,0,,...Енді саған ештеңе деудің қажеті жоқ.
Dialogue: 0,0:04:14.85,0:04:17.12,Default,,0,0,0,,Иә... Дұрыс...
Dialogue: 0,0:04:17.12,0:04:20.99,Default,,0,0,0,,Мен бәрін құрттым...
Dialogue: 0,0:04:20.99,0:04:24.79,Default,,0,0,0,,Рой менсінбеген, сені менсінбеген...➡
Dialogue: 0,0:04:24.79,0:04:28.76,Default,,0,0,0,,Сіз өзіңізді менсінбейсіз...
Dialogue: 0,0:04:28.76,0:04:30.90,Default,,0,0,0,,Бейшара...
Dialogue: 0,0:04:30.90,0:04:34.37,Default,,0,0,0,,Мені кешіріңіз, Энн. Жүр, осы жаққа кел.
Dialogue: 0,0:04:34.37,0:04:36.91,Default,,0,0,0,,Мен сізді жұбатуға рұқсат етіңіз.
Dialogue: 0,0:04:36.91,0:04:40.51,Default,,0,0,0,,Менің саған ұрысуға құқығым жоқ.
Dialogue: 0,0:04:40.51,0:04:42.94,Default,,0,0,0,,Неліктен біздің әлем ➡
Dialogue: 0,0:04:42.94,0:04:48.82,Default,,0,0,0,,Мен бәрі соншалықты күрделі және түсініксіз бе деп ойлаймын ...
Dialogue: 0,0:04:48.82,0:04:50.82,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:04:50.82,0:04:55.19,Default,,0,0,0,,Рой дәл қазір өзін қатты бақытсыз сезінеді.
Dialogue: 0,0:04:55.19,0:04:57.26,Default,,0,0,0,,Мен мұны күнде істеймін➡
Dialogue: 0,0:04:57.26,0:05:02.43,Default,,0,0,0,,Бұл сезімнің төгілуін тыңдау керек, солай ма?
Dialogue: 0,0:05:02.43,0:05:06.64,Default,,0,0,0,,Бірақ бұл да ақырында жойылады. Әрқашан солай.
Dialogue: 0,0:05:06.64,0:05:08.64,Default,,0,0,0,,Ах…. Рой бұл➡
Dialogue: 0,0:05:08.64,0:05:11.01,Default,,0,0,0,,Өткенде екі рет айырылыстық.
Dialogue: 0,0:05:11.01,0:05:13.91,Default,,0,0,0,,А...? Ал мен аяғыма тұрдым.
Dialogue: 0,0:05:13.91,0:05:16.24,Default,,0,0,0,,Еске алу Мен жақсы көретін нәрсе –➡
Dialogue: 0,0:05:16.24,0:05:18.78,Default,,0,0,0,,Тек сен.
Dialogue: 0,0:05:18.78,0:05:21.45,Default,,0,0,0,,Сондықтан алаңдаудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:05:21.45,0:05:25.29,Default,,0,0,0,,Әпкең бола алмағаным өкінішті➡
Dialogue: 0,0:05:25.29,0:05:27.59,Default,,0,0,0,,Біз дос бола аламыз, солай ма?
Dialogue: 0,0:05:27.59,0:05:31.29,Default,,0,0,0,,Иә, әрине, Дороти. жақсы!
Dialogue: 0,0:05:31.29,0:05:34.03,Default,,0,0,0,,Мен саған хат жазамын. Бұл сенің ата-анаңның үйі екеніне сенімдімін...
Dialogue: 0,0:05:34.03,0:05:36.80,Default,,0,0,0,,Принц Эдвард аралы➡
Dialogue: 0,0:05:36.80,0:05:38.73,Default,,0,0,0,,Avonlea➡ қаласында орналасқан
Dialogue: 0,0:05:38.73,0:05:41.34,Default,,0,0,0,,Жасыл Гейблдер.
Dialogue: 0,0:05:49.31,0:05:52.21,Default,,0,0,0,,Ах…. (Марилла Катберт) Энн қош келдіңіз.
Dialogue: 0,0:05:52.21,0:05:54.82,Default,,0,0,0,,Қар ханшайымы Марилла...
Dialogue: 0,0:05:54.82,0:05:58.02,Default,,0,0,0,,А... өзегі шіріген.
Dialogue: 0,0:05:58.02,0:06:02.22,Default,,0,0,0,,Наурызда қатты жел соғып құлады.
Dialogue: 0,0:06:02.22,0:06:08.13,Default,,0,0,0,,Бұл ағаш Матай екеуміздің кішкентай кезімізден бері сонда...
Dialogue: 0,0:06:09.97,0:06:12.90,Default,,0,0,0,,Бұдан былай терезеге қараған сайын➡
Dialogue: 0,0:06:12.90,0:06:17.24,Default,,0,0,0,,Сіз бұл ағаштың жоқтығынан жалғыздықты сезінуіңіз керек ...
Dialogue: 0,0:06:17.24,0:06:22.21,Default,,0,0,0,,Ал, мен сізге Avonlea туралы барлық жаңалықтарды айтып берейін.
Dialogue: 0,0:06:22.21,0:06:24.35,Default,,0,0,0,,Жаңалықтар➡
Dialogue: 0,0:06:24.35,0:06:27.68,Default,,0,0,0,,Сізге хат арқылы хабарлаудан басқа ештеңе жоқ.
Dialogue: 0,0:06:27.68,0:06:31.45,Default,,0,0,0,,Иә, Рейчел. Сіз оған Джейн туралы айттыңыз ба?
Dialogue: 0,0:06:31.45,0:06:33.52,Default,,0,0,0,,Джейнге не болды?
Dialogue: 0,0:06:33.52,0:06:35.69,Default,,0,0,0,,Джейн Эндрюс -➡
Dialogue: 0,0:06:35.69,0:06:39.56,Default,,0,0,0,,Мен сізді Виннипегтік миллионерге үйленетініңізді естідім.
Dialogue: 0,0:06:39.56,0:06:44.13,Default,,0,0,0,,Менің есімде Джейн! Мен шынымен бақыттымын.
Dialogue: 0,0:06:44.13,0:06:49.00,Default,,0,0,0,,Ол өзін осы дүниенің бақытынан ләззат алуға құқылы деп санайды.
Dialogue: 0,0:06:49.00,0:06:56.21,Default,,0,0,0,,Әрине Джейн жақсы қыз. Бірақ бұл миллиардердің стилі емес. ➡
Dialogue: 0,0:06:56.21,0:06:59.71,Default,,0,0,0,,Неке сақинасы гауһар тастардың үлкен блогы➡
Dialogue: 0,0:06:59.71,0:07:04.55,Default,,0,0,0,,Ол Джейннің қолындағы май құйылған ыдысқа ұқсайды.
Dialogue: 0,0:07:04.55,0:07:07.32,Default,,0,0,0,,Мама, сіз тым көп айтып отырсыз.
Dialogue: 0,0:07:07.32,0:07:10.23,Default,,0,0,0,,Менің ойымша. а….
Dialogue: 0,0:07:10.23,0:07:15.93,Default,,0,0,0,,Рейчел сенің әлі неке туралы сөйлеспегенің үшін уайымдап отыр.
Dialogue: 0,0:07:15.93,0:07:20.24,Default,,0,0,0,,Бұл лайықты марапат. Бәріне менің кінәм болды.
Dialogue: 0,0:07:20.24,0:07:23.24,Default,,0,0,0,,⚟Сіз Рой есімді біреу туралы айтып отырсыз ба?
Dialogue: 0,0:07:23.24,0:07:28.28,Default,,0,0,0,,⚟Иә. Енді мен істеген ісім үшін жазаланамын.
Dialogue: 0,0:07:28.28,0:07:32.15,Default,,0,0,0,,Осылай ойласаң да ештеңе өзгермейді. ➡
Dialogue: 0,0:07:32.15,0:07:36.05,Default,,0,0,0,,Гилберт Блайт немен айналысты? ➡
Dialogue: 0,0:07:36.05,0:07:38.92,Default,,0,0,0,,Мен сіздің өткен аптада қайтып келгеніңізді көрдім➡
Dialogue: 0,0:07:38.92,0:07:43.29,Default,,0,0,0,,Өңі жақсы емес, арық көрінді.
Dialogue: 0,0:07:43.29,0:07:46.13,Default,,0,0,0,,Гилберт қатты тырысты.
Dialogue: 0,0:07:46.13,0:07:49.13,Default,,0,0,0,,Мен де Редмонд медициналық колледжіне оқуға түсуді шештім...➡
Dialogue: 0,0:07:49.13,0:07:52.07,Default,,0,0,0,,Шаршағаныңыздың себебі осы деп ойлаймын.
Dialogue: 0,0:07:52.07,0:07:56.47,Default,,0,0,0,,Мен бес жыл бойы ешкім ала алмаған Купер стипендиясын жеңіп алдым.
Dialogue: 0,0:07:56.47,0:07:58.71,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:58.71,0:08:02.31,Default,,0,0,0,,Сіз әдебиетте де жоғары марапаттарға ие болдыңыз, солай ма?
Dialogue: 0,0:08:02.31,0:08:05.31,Default,,0,0,0,,Бұл Джейн Эндрюс жасай алмайтын нәрсе.
Dialogue: 0,0:08:05.31,0:08:07.55,Default,,0,0,0,,Кішкентай ана!
Dialogue: 0,0:08:07.55,0:08:09.48,Default,,0,0,0,,Диананың жағдайы қалай?
Dialogue: 0,0:08:09.48,0:08:13.22,Default,,0,0,0,,Диананың мені қарсы алмағаны өте өкінішті.
Dialogue: 0,0:08:13.22,0:08:15.16,Default,,0,0,0,,Диана көп нәрсе істеп жатыр➡
Dialogue: 0,0:08:15.16,0:08:17.56,Default,,0,0,0,,Менің бір нәрсе істеуім керек. ➡
Dialogue: 0,0:08:17.56,0:08:22.86,Default,,0,0,0,,Тыңдап тұрсың ба? Неге сонда өзіңіз бармайсыз?
Dialogue: 0,0:08:22.86,0:08:25.53,Default,,0,0,0,,Жақсы! Қандай сүйкімді!
Dialogue: 0,0:08:25.53,0:08:28.27,Default,,0,0,0,,Эй, Энн қайтып келді.
Dialogue: 0,0:08:28.27,0:08:30.31,Default,,0,0,0,,Ол Фредке мүлдем ұқсамайды.
Dialogue: 0,0:08:30.31,0:08:33.11,Default,,0,0,0,,Мен қызды қалайтынмын.
Dialogue: 0,0:08:33.11,0:08:35.38,Default,,0,0,0,,Сондықтан сіз мені Энн деп атай аласыз.
Dialogue: 0,0:08:35.38,0:08:39.18,Default,,0,0,0,,Бірақ Фред осылайша дүниеге келді➡
Dialogue: 0,0:08:39.18,0:08:42.58,Default,,0,0,0,,Мен оны миллион қызға айырбастамас едім.
Dialogue: 0,0:08:42.58,0:08:45.15,Default,,0,0,0,,Барлық сәбилер сүйкімді➡
Dialogue: 0,0:08:45.15,0:08:47.12,Default,,0,0,0,,Ол ең жақсы қыз. ➡
Dialogue: 0,0:08:47.12,0:08:50.79,Default,,0,0,0,,Мен кішкентай Анна болып туылған болсам да➡
Dialogue: 0,0:08:50.79,0:08:53.56,Default,,0,0,0,,Сіз де дәл осылай ойлағаныңызға сенімдімін.
Dialogue: 0,0:08:53.56,0:08:57.27,Default,,0,0,0,,Иә, бұл рас, Алан ханым.
Dialogue: 0,0:08:57.27,0:09:00.84,Default,,0,0,0,,Осы бала сөйлесетін жасқа жеткенше ➡
Dialogue: 0,0:09:00.84,0:09:03.20,Default,,0,0,0,,Мен күте алмаймын, Энн.
Dialogue: 0,0:09:03.20,0:09:07.08,Default,,0,0,0,,Күлімсіреп, «Анашым» деген дауысыңызды естігім келеді➡
Dialogue: 0,0:09:07.08,0:09:09.74,Default,,0,0,0,,Бұл қайтымсыз.
Dialogue: 0,0:09:09.74,0:09:11.68,Default,,0,0,0,,Мен ауырып қалсам да...
Dialogue: 0,0:09:11.68,0:09:14.05,Default,,0,0,0,,Анам бәрін төгіп жатыр. ➡
Dialogue: 0,0:09:14.05,0:09:16.02,Default,,0,0,0,,Кем дегенде Джонас➡
Dialogue: 0,0:09:16.02,0:09:20.76,Default,,0,0,0,,Бізде шіркеудің көрікті жерде болғанын қалаймын. ➡
Dialogue: 0,0:09:20.76,0:09:23.66,Default,,0,0,0,,Бірақ егер Джонас осында болса➡
Dialogue: 0,0:09:23.66,0:09:27.26,Default,,0,0,0,,Елсіз жердің соңында болса да...
Dialogue: 0,0:09:27.26,0:09:29.20,Default,,0,0,0,,О!
Dialogue: 0,0:09:29.20,0:09:31.43,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:09:31.43,0:09:33.84,Default,,0,0,0,,Бұл раушан гүлдерінің гүлдегеніндей болуы керек.
Dialogue: 0,0:09:33.84,0:09:35.77,Default,,0,0,0,,О!
Dialogue: 0,0:09:35.77,0:09:38.27,Default,,0,0,0,,Энн мен бақыттымын. ➡
Dialogue: 0,0:09:38.27,0:09:44.15,Default,,0,0,0,,Жүрегім ауырғанына қуаныштымын.
Dialogue: 0,0:09:44.15,0:09:46.95,Default,,0,0,0,,Менің айналам➡
Dialogue: 0,0:09:46.95,0:09:50.45,Default,,0,0,0,,Мен өте қуаныштымын, Мэтью.
Dialogue: 0,0:09:50.45,0:09:53.46,Default,,0,0,0,,Иә, әрине, Мэтью.
Dialogue: 0,0:09:53.46,0:09:56.19,Default,,0,0,0,,Мен де бақыттымын.
Dialogue: 0,0:09:56.19,0:09:58.16,Default,,0,0,0,,(Желде тербелген раушан гүлдерінің дыбысы)
Dialogue: 0,0:09:58.16,0:10:02.70,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:10:02.70,0:10:06.07,Default,,0,0,0,,«Мен әлемге шықтым». (Найзағай мен жаңбыр дыбысы)
Dialogue: 0,0:10:06.07,0:10:12.67,Default,,0,0,0,,«Әлем енді бұрынғы романтикасын кимейді».
Dialogue: 0,0:10:17.18,0:10:19.11,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:10:19.11,0:10:21.98,Default,,0,0,0,,О, Энн, қош келдіңіз. (Дэви Кит) Қайтадан қош келдіңіз.
Dialogue: 0,0:10:21.98,0:10:25.85,Default,,0,0,0,,Қайтадан қош келдіңіз. (Дора Кит) Үйге қош келдіңіз, Анна апа.
Dialogue: 0,0:10:25.85,0:10:29.49,Default,,0,0,0,,Сіз дымқылсыз. (Линд ханым) Рәсім қалай өтті?
Dialogue: 0,0:10:29.49,0:10:32.69,Default,,0,0,0,,Иә. Фил өте әдемі болды.
Dialogue: 0,0:10:32.69,0:10:36.23,Default,,0,0,0,,Барлығының маған жақсы қарағаны сонша, мен тым ұзақ қалдым.
Dialogue: 0,0:10:36.23,0:10:40.17,Default,,0,0,0,,Бірақ үй ең жақсысы. Тыныштандыратын нәрсе.
Dialogue: 0,0:10:40.17,0:10:43.91,Default,,0,0,0,,Дэви, сенің бойың қайта өскен жоқ па?
Dialogue: 0,0:10:43.91,0:10:47.74,Default,,0,0,0,,Иә! Содан бері ол тағы бір дюймге өсті.
Dialogue: 0,0:10:47.74,0:10:51.61,Default,,0,0,0,,Қазір мен Милти Боулдер сияқты ұзынмын.
Dialogue: 0,0:10:51.61,0:10:55.92,Default,,0,0,0,,Әй, әпке, сіз Гилберт ағаның өлетінін білесіз бе?
Dialogue: 0,0:10:55.92,0:10:57.85,Default,,0,0,0,,Ах!? (Линд ханым) Ах...!
Dialogue: 0,0:10:57.85,0:11:00.36,Default,,0,0,0,,Дэви! сурет...?
Dialogue: 0,0:11:00.36,0:11:04.56,Default,,0,0,0,,(Найзағай мен жаңбыр дыбысы)
Dialogue: 0,0:11:04.56,0:11:09.10,Default,,0,0,0,,♬～
Dialogue: 0,0:11:09.10,0:11:11.10,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:11:11.10,0:11:13.87,Default,,0,0,0,,Гилберт нені білдіреді?
Dialogue: 0,0:11:13.87,0:11:17.14,Default,,0,0,0,,Сондықтан мен өлейін деп тұрмын.
Dialogue: 0,0:11:17.14,0:11:19.81,Default,,0,0,0,,Дэви! (Линд ханым) Энн, ондай бетті жасама. ➡
Dialogue: 0,0:11:19.81,0:11:22.11,Default,,0,0,0,,Бұл бетті жасамау керек.
Dialogue: 0,0:11:22.11,0:11:26.38,Default,,0,0,0,,Біз сізді кенеттен хабардар еткіміз келмеді.
Dialogue: 0,0:11:26.38,0:11:28.32,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:11:28.32,0:11:30.82,Default,,0,0,0,,Гилберт өте нашар. ➡
Dialogue: 0,0:11:30.82,0:11:33.62,Default,,0,0,0,,Болингброкке барғаннан кейін➡
Dialogue: 0,0:11:33.62,0:11:36.12,Default,,0,0,0,,Іш сүзегімен ауырдым...
Dialogue: 0,0:11:36.12,0:11:39.63,Default,,0,0,0,,Дәрігер сенің өте әлсіз екеніңді айтады➡
Dialogue: 0,0:11:39.63,0:11:43.03,Default,,0,0,0,,Өмір болғанша, үміт бар.
Dialogue: 0,0:11:43.03,0:11:46.83,Default,,0,0,0,,Харрисон мырза Гилберттен үміт жоқ екенін айтты.
Dialogue: 0,0:11:46.83,0:11:50.07,Default,,0,0,0,,Дэви! (Дэви) Өйткені...
Dialogue: 0,0:11:50.07,0:11:53.74,Default,,0,0,0,,(Найзағай мен жаңбыр дыбысы)
Dialogue: 0,0:11:53.74,0:11:58.58,Default,,0,0,0,,Гилберт өліп жатыр... Гилберт...
Dialogue: 0,0:11:58.58,0:12:03.25,Default,,0,0,0,,Гилберт кетсе, мен де өмір сүре алмаймын...
Dialogue: 0,0:12:03.25,0:12:08.09,Default,,0,0,0,,Дұрыс... Мен енді түсіндім. Мен... Мен...
Dialogue: 0,0:12:08.09,0:12:10.36,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:12:10.36,0:12:12.36,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:12:14.86,0:12:16.83,Default,,0,0,0,,Қарапайым айтқанда, бұл бір адамның магниттік күшінің екі есесі.
Dialogue: 0,0:12:16.83,0:12:21.37,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:12:21.37,0:12:23.34,Default,,0,0,0,,Мен ойланып жүрмін… мен Эреннен шын мәнінде нені көргенмін?>
Dialogue: 0,0:12:23.34,0:12:25.87,Default,,0,0,0,,Жоқ... (Идеал жігіт) Сіз➡
Dialogue: 0,0:12:25.87,0:12:29.28,Default,,0,0,0,,Сіз Гилбертті жақсы көрдіңіз. ➡
Dialogue: 0,0:12:29.28,0:12:33.15,Default,,0,0,0,,Бала кезімнен... ➡
Dialogue: 0,0:12:33.15,0:12:35.52,Default,,0,0,0,,Қазірдің өзінде кеш. сурет….
Dialogue: 0,0:12:35.52,0:12:38.32,Default,,0,0,0,,Егер сен соншалықты ақымақ болмасаң➡
Dialogue: 0,0:12:38.32,0:12:43.16,Default,,0,0,0,,Сіздің Гилбертке дәл қазір баруға құқығыңыз бар еді. ➡
Dialogue: 0,0:12:43.16,0:12:47.40,Default,,0,0,0,,Гилберттің соңғы сәттерінде болу арқылы➡
Dialogue: 0,0:12:47.40,0:12:52.23,Default,,0,0,0,,Ауырса да, мен жұбаныш таба алар едім. ➡
Dialogue: 0,0:12:52.23,0:12:56.17,Default,,0,0,0,,Гилберт сенің оны сүйетініңді де білмеді➡
Dialogue: 0,0:12:56.17,0:12:58.17,Default,,0,0,0,,Ол жоғалады. ➡
Dialogue: 0,0:12:58.17,0:13:00.74,Default,,0,0,0,,Ақырында мен сені ешқашан сүймегенімді түсіндім...
Dialogue: 0,0:13:00.74,0:13:03.65,Default,,0,0,0,,Маған ұнамайды... (Менің идеал жігітім) Мұңды және бос жүрекпен...
Dialogue: 0,0:13:03.65,0:13:05.95,Default,,0,0,0,,Маған ұнамайды... Маған ұнамайды!
Dialogue: 0,0:13:05.95,0:13:07.88,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:13:07.88,0:13:09.85,Default,,0,0,0,,Гилберт, мен...➡
Dialogue: 0,0:13:09.85,0:13:14.46,Default,,0,0,0,,Мен сені сүйемін... Мен сені сүйемін!
Dialogue: 0,0:13:14.46,0:13:19.59,Default,,0,0,0,,Сондықтан... мені қабылдамаңыз...
Dialogue: 0,0:13:19.59,0:13:29.34,Default,,0,0,0,,♬～
Dialogue: 0,0:13:29.34,0:13:31.77,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:31.77,0:13:54.50,Default,,0,0,0,,♬～
Dialogue: 0,0:13:54.50,0:13:56.50,Default,,0,0,0,,(өзеннің ағып жатқан дыбысы)
Dialogue: 0,0:14:02.30,0:14:04.54,Default,,0,0,0,,Реминисценция (Идеал жігіт) Гилберт бұл➡
Dialogue: 0,0:14:04.54,0:14:08.64,Default,,0,0,0,,Сенің мені жақсы көретініңді білмей кетіп қалатын шығармын.
Dialogue: 0,0:14:11.98,0:14:16.18,Default,,0,0,0,,Егер Гилберт жоқ болса...➡
Dialogue: 0,0:14:16.18,0:14:19.59,Default,,0,0,0,,Оның мәні жоқ...
Dialogue: 0,0:14:19.59,0:14:23.26,Default,,0,0,0,,⚟ (ысқырық)
Dialogue: 0,0:14:23.26,0:14:27.03,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:14:27.03,0:14:33.30,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:14:33.30,0:14:35.24,Default,,0,0,0,,Ум... (ысқырық)
Dialogue: 0,0:14:35.24,0:14:38.77,Default,,0,0,0,,Ум... уф!
Dialogue: 0,0:14:38.77,0:14:40.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.71,0:14:44.58,Default,,0,0,0,,Сіз Флетчер мырзада жұмыс істемейсіз бе?
Dialogue: 0,0:14:44.58,0:14:47.82,Default,,0,0,0,,Брайс отбасымен көршілес үй. аа.
Dialogue: 0,0:14:47.82,0:14:50.25,Default,,0,0,0,,Бүгін таңертең Мистер Флетчерден келдіңіз бе?
Dialogue: 0,0:14:50.25,0:14:52.19,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:14:52.19,0:14:56.82,Default,,0,0,0,,Менен басқа күйеуім көмектесу үшін тағы бір баланы жалдады.➡
Dialogue: 0,0:14:56.82,0:14:59.43,Default,,0,0,0,,Мен бірінші пойызбен Жарқын өзенге барамын➡
Dialogue: 0,0:14:59.43,0:15:03.30,Default,,0,0,0,,Мен орман арқылы төте жолдан өтіп, оны алып кетейін.
Dialogue: 0,0:15:03.30,0:15:08.20,Default,,0,0,0,,Сонымен... бүгін таңертең Гилберт Блайттың қалай болғанын естідіңіз бе?
Dialogue: 0,0:15:08.20,0:15:12.01,Default,,0,0,0,,Иә? Гилберт? ➡
Dialogue: 0,0:15:12.01,0:15:15.88,Default,,0,0,0,,Жағдай жақсарып келеді. ➡
Dialogue: 0,0:15:15.88,0:15:17.95,Default,,0,0,0,,Тау асуынан өткен сияқтысыз➡
Dialogue: 0,0:15:17.95,0:15:20.18,Default,,0,0,0,,Дәрігер –➡
Dialogue: 0,0:15:20.18,0:15:23.89,Default,,0,0,0,,Жақында емделетінін айтады.
Dialogue: 0,0:15:23.89,0:15:26.45,Default,,0,0,0,,Қайырлы күн.
Dialogue: 0,0:15:26.45,0:15:28.79,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:15:28.79,0:15:30.73,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:15:30.73,0:15:35.36,Default,,0,0,0,,Сізге көп рахмет...!
Dialogue: 0,0:15:35.36,0:15:51.61,Default,,0,0,0,,♬～
Dialogue: 0,0:15:51.61,0:15:54.32,Default,,0,0,0,,Фалько…
Dialogue: 0,0:15:56.18,0:16:00.35,Default,,0,0,0,,«Түнде мен жылаймын немесе ештеңе істемеймін.➡
Dialogue: 0,0:16:00.35,0:16:05.19,Default,,0,0,0,,Қуаныш таңмен бірге келеді».
Dialogue: 0,0:16:05.19,0:16:11.97,Default,,0,0,0,,♬～
Dialogue: 0,0:16:11.97,0:16:14.00,Default,,0,0,0,,Сәлем Анна.
Dialogue: 0,0:16:14.00,0:16:16.87,Default,,0,0,0,,Ах... Гилберт!
Dialogue: 0,0:16:16.87,0:16:20.17,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Сізге рахмет, бұл болды.
Dialogue: 0,0:16:20.17,0:16:23.44,Default,,0,0,0,,Сонымен мен бүгін сендерді серуендеуге шақыруға келдім.
Dialogue: 0,0:16:23.44,0:16:26.25,Default,,0,0,0,,Университетке кетер алдында екеуміз де соны көруге бардық➡
Dialogue: 0,0:16:26.25,0:16:28.78,Default,,0,0,0,,Есіңізде ме, ескі алма ағашы?
Dialogue: 0,0:16:28.78,0:16:30.72,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:16:30.72,0:16:33.62,Default,,0,0,0,,Бірақ бүгін Джейннің үйлену тойы, солай ма?
Dialogue: 0,0:16:33.62,0:16:36.66,Default,,0,0,0,,Маған бұл көйлекпен тағы біраз жұмыс істеу керек...
Dialogue: 0,0:16:36.66,0:16:40.26,Default,,0,0,0,,Ертең түстен кейін ше? Иә, өтінемін.
Dialogue: 0,0:16:40.26,0:16:45.80,Default,,0,0,0,,Мен Джейнді рәсімге шақырмағаны үшін ешқашан кешірмеймін.
Dialogue: 0,0:16:45.80,0:16:50.64,Default,,0,0,0,,Хехехехе, үйіме сыймайтын туыстарымның көптігін ескерсек➡
Dialogue: 0,0:16:50.64,0:16:53.31,Default,,0,0,0,,Мен Джейнді кінәлай алмаймын.
Dialogue: 0,0:16:53.31,0:16:55.24,Default,,0,0,0,,Көп гауһар тастаңыз➡
Dialogue: 0,0:16:55.24,0:16:57.25,Default,,0,0,0,,Гауһар қайдан басталады?➡
Dialogue: 0,0:16:57.25,0:17:00.85,Default,,0,0,0,,Джейннің қайдан келгенін айта алмайтының рас па?
Dialogue: 0,0:17:00.85,0:17:03.52,Default,,0,0,0,,Келіңіздер ме? Мен оны тексеремін.
Dialogue: 0,0:17:03.52,0:17:06.49,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:06.49,0:17:10.86,Default,,0,0,0,,Ал, ертең түстен кейін. Бүгінгі кеш көңілді өтсін.
Dialogue: 0,0:17:10.86,0:17:13.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:15.83,0:17:17.97,Default,,0,0,0,,Гилберт! иә?
Dialogue: 0,0:17:17.97,0:17:20.90,Default,,0,0,0,,Әйтеуір, қазір серуендеуге барайық!
Dialogue: 0,0:17:20.90,0:17:25.74,Default,,0,0,0,,Көйлекті жөндеуге бола ма? Мен бірдеңе істеймін. Одан да көп…➡
Dialogue: 0,0:17:25.74,0:17:30.88,Default,,0,0,0,,Осындай тамаша күнде сенімен бірге серуендемейтініме сене алар емеспін...
Dialogue: 0,0:17:30.88,0:17:33.38,Default,,0,0,0,,Қазір жалғыз уақыт...
Dialogue: 0,0:17:35.72,0:17:37.82,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:45.83,0:17:49.83,Default,,0,0,0,,О! о қымбаттым!
Dialogue: 0,0:17:54.14,0:17:58.61,Default,,0,0,0,,Толық гүлдену! Әй, мен күзгі егінді асыға күтемін.
Dialogue: 0,0:17:58.61,0:18:04.15,Default,,0,0,0,,Иә. Осы көріністе менің бұрынғы армандарым қайта тірілгендей.
Dialogue: 0,0:18:04.15,0:18:09.42,Default,,0,0,0,,Орындалмаған армандарыңыз бар ма?
Dialogue: 0,0:18:09.42,0:18:12.65,Default,,0,0,0,,Әрине. Барлығы солай істейді, солай ма?
Dialogue: 0,0:18:12.65,0:18:15.42,Default,,0,0,0,,Барлық армандарымды орындасам екен➡
Dialogue: 0,0:18:15.42,0:18:18.03,Default,,0,0,0,,Біз мұны істей алмаймыз.
Dialogue: 0,0:18:18.03,0:18:21.43,Default,,0,0,0,,Ал армандайтын ештеңе қалмаса➡
Dialogue: 0,0:18:21.43,0:18:24.77,Default,,0,0,0,,Өлі сияқты жақсы.
Dialogue: 0,0:18:24.77,0:18:27.37,Default,,0,0,0,,Менің бір арманым бар.
Dialogue: 0,0:18:27.37,0:18:29.94,Default,,0,0,0,,Бірнеше рет орындалмай қала ма деп қорқамын➡
Dialogue: 0,0:18:29.94,0:18:32.21,Default,,0,0,0,,Мен тастай жаздадым➡
Dialogue: 0,0:18:32.21,0:18:36.08,Default,,0,0,0,,Мен әлі де сол арманның артынан қуып келемін.
Dialogue: 0,0:18:36.08,0:18:39.11,Default,,0,0,0,,Мен белгілі бір отбасын армандаймын.
Dialogue: 0,0:18:39.11,0:18:42.18,Default,,0,0,0,,Каминдегі от жылы жанып тұр➡
Dialogue: 0,0:18:42.18,0:18:46.49,Default,,0,0,0,,Мысық пен иттер бар, мен досымның аяқ дыбысын естіп тұрмын➡
Dialogue: 0,0:18:46.49,0:18:49.69,Default,,0,0,0,,Және сонда…➡
Dialogue: 0,0:18:49.69,0:18:53.19,Default,,0,0,0,,Сіз осындасыз.
Dialogue: 0,0:18:53.19,0:18:57.70,Default,,0,0,0,,Екі жыл бұрын мен сенен бірдеңе сұраған едім.
Dialogue: 0,0:18:57.70,0:19:01.57,Default,,0,0,0,,Мені еске түсір... Мені...➡
Dialogue: 0,0:19:01.57,0:19:04.97,Default,,0,0,0,,Мен алмаймын. (Гильберттің тыныс алуы)
Dialogue: 0,0:19:04.97,0:19:09.21,Default,,0,0,0,,Бүгін тағы сұрасаңыз➡
Dialogue: 0,0:19:09.21,0:19:13.98,Default,,0,0,0,,Маған басқаша жауап бере аласыз ба?
Dialogue: 0,0:19:13.98,0:19:16.88,Default,,0,0,0,,Ах... Бірақ... Бірақ Кристин ше?
Dialogue: 0,0:19:16.88,0:19:21.42,Default,,0,0,0,,Иә? Сізге Кристин Стюарт ұнайды деп ойладым.
Dialogue: 0,0:19:21.42,0:19:23.66,Default,,0,0,0,,Пуф... Ахахаха!
Dialogue: 0,0:19:23.66,0:19:26.33,Default,,0,0,0,,Хахахаха! а….
Dialogue: 0,0:19:26.33,0:19:29.86,Default,,0,0,0,,Кристиннің туған қаласында күйеу жігіті бар.
Dialogue: 0,0:19:29.86,0:19:33.47,Default,,0,0,0,,Иә!? Мен оның ағасын білемін➡
Dialogue: 0,0:19:33.47,0:19:35.44,Default,,0,0,0,,Маған қамқор боласың деп сенемін➡
Dialogue: 0,0:19:35.44,0:19:37.64,Default,,0,0,0,,Маған солай етуді өтінді.
Dialogue: 0,0:19:37.64,0:19:39.94,Default,,0,0,0,,Біртүрлі қауесеттер де тараған сияқты➡
Dialogue: 0,0:19:39.94,0:19:44.15,Default,,0,0,0,,Менен бас тартқаннан кейін мен онымен біттім деп ойладым➡
Dialogue: 0,0:19:44.15,0:19:48.12,Default,,0,0,0,,Өйткені Кристин де маған сенді.
Dialogue: 0,0:19:48.12,0:19:50.99,Default,,0,0,0,,Энн менің сенен басқа ешкімім жоқ➡
Dialogue: 0,0:19:50.99,0:19:53.59,Default,,0,0,0,,Ешкім болуы мүмкін емес еді.
Dialogue: 0,0:19:53.59,0:19:57.46,Default,,0,0,0,,Басыма тас тақта ұрған күннен бері➡
Dialogue: 0,0:19:57.46,0:20:01.70,Default,,0,0,0,,Мен сені мәңгілікке сүйдім.
Dialogue: 0,0:20:01.70,0:20:20.71,Default,,0,0,0,,♬～
Dialogue: 0,0:20:20.71,0:20:22.65,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:20:22.65,0:20:24.69,Default,,0,0,0,,Мен қандай ақымақпын➡
Dialogue: 0,0:20:24.69,0:20:27.02,Default,,0,0,0,,Мен сені қалай жақсы көре аламын?
Dialogue: 0,0:20:27.02,0:20:29.79,Default,,0,0,0,,Жоқ. Мен тастап кету туралы көп ойладым.
Dialogue: 0,0:20:29.79,0:20:32.69,Default,,0,0,0,,Әсіресе Рой Гарднер пайда болғаннан кейін➡
Dialogue: 0,0:20:32.69,0:20:36.43,Default,,0,0,0,,Менің мүмкіндігім жоқ екеніне көзім жетті.
Dialogue: 0,0:20:36.43,0:20:39.10,Default,,0,0,0,,Бірақ мен бас тарта алмадым.
Dialogue: 0,0:20:39.10,0:20:41.94,Default,,0,0,0,,Бір күні қызуы түсіп кетті➡
Dialogue: 0,0:20:41.94,0:20:44.64,Default,,0,0,0,,Фил Гордон... жоқ, Фил Блейктен➡
Dialogue: 0,0:20:44.64,0:20:46.91,Default,,0,0,0,,Маған хат келді.
Dialogue: 0,0:20:46.91,0:20:48.91,Default,,0,0,0,,Фил хат жіберді ме? аа.
Dialogue: 0,0:20:48.91,0:20:53.68,Default,,0,0,0,,Хатта Рой екеуіңнің араларыңда енді ешқандай қарым-қатынас жоқ екені жазылған➡
Dialogue: 0,0:20:53.68,0:20:56.58,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:20:56.58,0:21:00.79,Default,,0,0,0,,Менің одан кейін қалай тез сауығып кеткеніме дәрігерлердің өзі таң қалды.
Dialogue: 0,0:21:00.79,0:21:02.72,Default,,0,0,0,,…Анн?
Dialogue: 0,0:21:02.72,0:21:06.59,Default,,0,0,0,,Мен... Мен сені тірі қалмайтын шығар деп ойладым➡
Dialogue: 0,0:21:06.59,0:21:09.93,Default,,0,0,0,,Мен бұл түнді мәңгі есте сақтаймын деп ойлаймын.
Dialogue: 0,0:21:09.93,0:21:11.97,Default,,0,0,0,,Сол кезде мен түсіндім...
Dialogue: 0,0:21:11.97,0:21:14.47,Default,,0,0,0,,Сол кезде білдім.
Dialogue: 0,0:21:14.47,0:21:17.77,Default,,0,0,0,,Бірақ... мен уақытында үлгермеймін деп ойладым.
Dialogue: 0,0:21:17.77,0:21:21.28,Default,,0,0,0,,Біз мұны уақытында жасадық, Энн.
Dialogue: 0,0:21:21.28,0:21:26.15,Default,,0,0,0,,Иә... бүгін біздің туған күніміз құтты болсын.
Dialogue: 0,0:21:26.15,0:21:29.98,Default,,0,0,0,,Маған әрқашан алманың гүлдері ұнайтын➡
Dialogue: 0,0:21:29.98,0:21:33.79,Default,,0,0,0,,Енді мен сені бұрынғыдан да жақсы көремін.
Dialogue: 0,0:21:33.79,0:21:38.49,Default,,0,0,0,,Бірақ сізге біраз уақыт күтуге тура келеді.
Dialogue: 0,0:21:38.49,0:21:41.46,Default,,0,0,0,,Мен медициналық институтты тағы үш жылға дейін бітіре алмаймын➡
Dialogue: 0,0:21:41.46,0:21:43.63,Default,,0,0,0,,Тіпті сол кезде➡
Dialogue: 0,0:21:43.63,0:21:45.60,Default,,0,0,0,,Алмазсыз➡
Dialogue: 0,0:21:45.60,0:21:48.44,Default,,0,0,0,,Мәрмәр залға да жете алмайсың.
Dialogue: 0,0:21:48.44,0:21:50.47,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:21:50.47,0:21:53.74,Default,,0,0,0,,Мен тек сенсің, Гилберт.
Dialogue: 0,0:21:53.74,0:21:57.98,Default,,0,0,0,,Ах... Гауһар тастар мен мәрмәрден жасалған зал да тамаша болар еді➡
Dialogue: 0,0:21:57.98,0:22:01.88,Default,,0,0,0,,Егер мұндай нәрсе болмаса, қиялға көбірек орын бар.
Dialogue: 0,0:22:01.88,0:22:05.25,Default,,0,0,0,,Және сізді күту үшін➡
Dialogue: 0,0:22:05.25,0:22:07.25,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:22:07.25,0:22:11.06,Default,,0,0,0,,Бір-бірімізді күтіп, жұмыс жасаймыз➡
Dialogue: 0,0:22:11.06,0:22:14.06,Default,,0,0,0,,Сіз армандаған кезде көңіл көтере аласыз.
Dialogue: 0,0:22:14.06,0:22:19.87,Default,,0,0,0,,Ах! Менің армандарым қазір өте әдемі деп ойлаймын.
Dialogue: 0,0:22:27.07,0:22:36.75,Default,,0,0,0,,♬～
Dialogue: 0,0:22:36.75,0:22:39.62,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:39.62,0:22:46.73,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:46.73,0:22:51.40,Default,,0,0,0,,♬ «Білмей тұрып өтетін қала»
Dialogue: 0,0:22:51.40,0:22:57.94,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:57.94,0:23:01.68,Default,,0,0,0,,Матай Біз үйленеміз.
Dialogue: 0,0:23:01.68,0:23:06.18,Default,,0,0,0,,Мен айналма жолмен өттім, бірақ мен сені міндетті түрде бақытты етемін.
Dialogue: 0,0:23:08.15,0:23:10.22,Default,,0,0,0,,Рахмет сізге Мэтью.
Dialogue: 0,0:23:10.22,0:23:15.76,Default,,0,0,0,,Мен сенің қызың болғаныма қуаныштымын.
Dialogue: 0,0:23:15.76,0:23:17.69,Default,,0,0,0,,♬～
Dialogue: 0,0:23:17.69,0:23:22.53,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:22.53,0:23:28.94,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:28.94,0:23:33.27,Default,,0,0,0,,<Аллаға шүкір. ➡
Dialogue: 0,0:23:33.27,0:23:38.68,Default,,0,0,0,,Мені Green Gables➡-ге апарыңыз
Dialogue: 0,0:23:38.68,0:23:43.88,Default,,0,0,0,,Мені осы тамаша Жасыл Гейблге әкелгеніңіз үшін рахмет.
Dialogue: 0,0:23:46.32,0:23:49.22,Default,,0,0,0,,<Рахмет>
Dialogue: 0,0:23:52.73,0:23:56.23,Default,,0,0,0,,<Анн Ширлиден>
Dialogue: 0,0:23:57.73,0:24:03.73,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
