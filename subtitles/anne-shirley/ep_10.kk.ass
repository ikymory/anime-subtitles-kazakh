Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:09.10,Default,,0,0,0,,<Мен Queen академиясында студенттік өмірімді аяқтадым➡
Dialogue: 0,0:00:09.10,0:00:11.57,Default,,0,0,0,,Ағылшын әдебиетіндегі үлгеріміңіз бағаланады➡
Dialogue: 0,0:00:11.57,0:00:14.94,Default,,0,0,0,,Мен енді стипендия алуға құқығым бар. ➡
Dialogue: 0,0:00:14.94,0:00:17.95,Default,,0,0,0,,Мэтью мен Марилла да қатты қуанды➡
Dialogue: 0,0:00:17.95,0:00:20.75,Default,,0,0,0,,Университетке түсуге дайындалу➡
Dialogue: 0,0:00:20.75,0:00:24.59,Default,,0,0,0,,Жаздың бір таңы Грин Гейблде＞
Dialogue: 0,0:00:24.59,0:00:27.36,Default,,0,0,0,,(қайнаған дыбыс)
Dialogue: 0,0:00:27.36,0:00:29.32,Default,,0,0,0,,(пісіру дыбысы)
Dialogue: 0,0:00:29.32,0:00:34.13,Default,,0,0,0,,Біз де қартайдық, сондықтан Аннаның осында болуы өте пайдалы.
Dialogue: 0,0:00:34.13,0:00:36.70,Default,,0,0,0,,Қайырлы таң Матай.
Dialogue: 0,0:00:36.70,0:00:40.00,Default,,0,0,0,,Қайырлы таң Анна.
Dialogue: 0,0:00:40.00,0:00:42.37,Default,,0,0,0,,Иә. иә? иә….
Dialogue: 0,0:00:42.37,0:00:47.58,Default,,0,0,0,,Сіз қалай ойлайсыз? Иә, өте дәмді. Иә.
Dialogue: 0,0:00:49.28,0:00:52.71,Default,,0,0,0,,Бұрын тамақ дайындау өте қызық болатын.
Dialogue: 0,0:00:52.71,0:00:54.95,Default,,0,0,0,,Шынымен бе? Иә.
Dialogue: 0,0:00:54.95,0:00:57.69,Default,,0,0,0,,Менің интернат үйімдегі асүйді пайдалану қиын болды.
Dialogue: 0,0:00:57.69,0:01:02.82,Default,,0,0,0,,Олай болса, мен жазғы демалыста барлық тамақ әзірлеуді Аннаға тапсырамын деп ойлаймын.
Dialogue: 0,0:01:02.82,0:01:04.76,Default,,0,0,0,,Бұл арзан. иә?
Dialogue: 0,0:01:04.76,0:01:07.06,Default,,0,0,0,,Мм...! Мен оны жасау үшін бар күшімді саламын.
Dialogue: 0,0:01:07.06,0:01:09.00,Default,,0,0,0,,Уф... Уф...! ➡
Dialogue: 0,0:01:09.00,0:01:11.03,Default,,0,0,0,,Уф... Уф... А... Матай?
Dialogue: 0,0:01:11.03,0:01:13.84,Default,,0,0,0,,Не болды? Мен сезінемін...
Dialogue: 0,0:01:21.24,0:01:23.21,Default,,0,0,0,,(Тақталардың сынған дыбысы)
Dialogue: 0,0:01:23.21,0:01:25.48,Default,,0,0,0,,Матай!
Dialogue: 0,0:01:25.48,0:01:27.45,Default,,0,0,0,,Матай! Мэтью! Мэтью! Матай⁉
Dialogue: 0,0:01:27.45,0:01:29.65,Default,,0,0,0,,Анджелиге дәрігер шақыруын айт.
Dialogue: 0,0:01:29.65,0:01:32.19,Default,,0,0,0,,Иә. Арпа мен Рейчел де!
Dialogue: 0,0:01:32.19,0:01:34.29,Default,,0,0,0,,Түсіндім! Мэтью!
Dialogue: 0,0:01:35.92,0:01:39.19,Default,,0,0,0,,Жүрегімде дауыс Маған ұнамайды... Ұнамайды...➡
Dialogue: 0,0:01:39.19,0:01:41.13,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:01:41.13,0:01:50.37,Default,,0,0,0,,♬～
Dialogue: 0,0:01:50.37,0:01:55.04,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:01:55.04,0:01:57.58,Default,,0,0,0,,♬ «Мүмкін болса да, болмаса да»
Dialogue: 0,0:01:57.58,0:01:59.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:01:59.51,0:02:03.39,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:03.39,0:02:05.65,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:05.65,0:02:07.89,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:07.89,0:02:12.43,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:12.43,0:02:17.63,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:17.63,0:02:19.57,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:19.57,0:02:23.44,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:23.44,0:02:26.84,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:26.84,0:02:29.28,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:29.28,0:02:31.55,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:31.55,0:02:35.78,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:35.78,0:02:38.25,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:38.25,0:02:40.59,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:40.59,0:02:44.06,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:44.06,0:02:47.36,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:47.36,0:02:49.60,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:49.60,0:02:53.87,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:02:53.87,0:02:56.37,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:56.37,0:02:58.67,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:02:58.67,0:03:00.68,Default,,0,0,0,,♬ «Мен сені алып кетейін.»
Dialogue: 0,0:03:00.68,0:03:04.25,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:04.25,0:03:08.85,Default,,0,0,0,,♬～
Dialogue: 0,0:03:11.55,0:03:15.66,Default,,0,0,0,,♬～
Dialogue: 0,0:03:26.10,0:03:29.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:29.44,0:03:31.44,Default,,0,0,0,,О, Марилла➡
Dialogue: 0,0:03:31.44,0:03:36.24,Default,,0,0,0,,Енді ештеңе істей алмаймыз.
Dialogue: 0,0:03:36.24,0:03:39.11,Default,,0,0,0,,Жоқ... болмайды Матай...
Dialogue: 0,0:03:39.11,0:03:41.58,Default,,0,0,0,,Дұрыс, Энн. ➡
Dialogue: 0,0:03:41.58,0:03:44.52,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:03:44.52,0:03:47.39,Default,,0,0,0,,Өлім кенеттен келеді➡
Dialogue: 0,0:03:47.39,0:03:49.66,Default,,0,0,0,,Ешқандай ауыртпалық болмас еді. ➡
Dialogue: 0,0:03:49.66,0:03:52.39,Default,,0,0,0,,Бұл қандай да бір күйзеліс сияқты. ➡
Dialogue: 0,0:03:52.39,0:03:54.90,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:59.17,0:04:01.24,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:04:01.24,0:04:03.47,Default,,0,0,0,,Ой... ой...➡
Dialogue: 0,0:04:03.47,0:04:05.97,Default,,0,0,0,,Уф... Ағай... А...
Dialogue: 0,0:04:05.97,0:04:07.94,Default,,0,0,0,,Марилла….
Dialogue: 0,0:04:07.94,0:04:11.85,Default,,0,0,0,,(Марилланың айқайы)
Dialogue: 0,0:04:15.65,0:04:20.82,Default,,0,0,0,,(кесілген сабақтардың дыбысы)
Dialogue: 0,0:04:20.82,0:04:28.33,Default,,0,0,0,,♬～
Dialogue: 0,0:04:28.33,0:04:32.10,Default,,0,0,0,,Мен... кенеттен...
Dialogue: 0,0:04:32.10,0:04:36.57,Default,,0,0,0,,Анна…. Сенімен бәрі жақсы ма. Өз-өзіңді күт.
Dialogue: 0,0:04:36.57,0:04:40.84,Default,,0,0,0,,♬～
Dialogue: 0,0:04:40.84,0:04:43.21,Default,,0,0,0,,Бірақ... (Линд ханым) Дұрыс. (Берли ханым) Олай болса...
Dialogue: 0,0:04:43.21,0:04:46.62,Default,,0,0,0,,Мен кірейін бе?
Dialogue: 0,0:04:50.12,0:04:54.56,Default,,0,0,0,,Анн. Бүгін кешке қосыламыз ба?
Dialogue: 0,0:04:54.56,0:05:01.13,Default,,0,0,0,,Рахмет сізге Диана. Бірақ әзірге жалғыз қалғым келеді.
Dialogue: 0,0:05:01.13,0:05:03.90,Default,,0,0,0,,Мен Мэтьюдің өлгеніне сене алмаймын...
Dialogue: 0,0:05:03.90,0:05:06.90,Default,,0,0,0,,Мен оны әлі де дұрыс деп санамаймын...
Dialogue: 0,0:05:06.90,0:05:10.91,Default,,0,0,0,,Мен жай ғана үндемей, ойланғым келеді.
Dialogue: 0,0:05:12.61,0:05:17.05,Default,,0,0,0,,...Мен төменде тұрмын, егер қажет болсам, маған хабарласыңыз.
Dialogue: 0,0:05:17.05,0:05:19.95,Default,,0,0,0,,Иә….
Dialogue: 0,0:05:19.95,0:05:41.24,Default,,0,0,0,,♬～
Dialogue: 0,0:05:41.24,0:05:43.17,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:05:43.17,0:05:47.68,Default,,0,0,0,,Ол менің қызым емес пе?
Dialogue: 0,0:05:47.68,0:05:50.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:50.55,0:05:54.55,Default,,0,0,0,,Еске алу Ол менің мақтаныш қызым.
Dialogue: 0,0:05:56.45,0:05:59.19,Default,,0,0,0,,(жылау)
Dialogue: 0,0:05:59.19,0:06:01.46,Default,,0,0,0,,⚟ (Анн жылап) А...
Dialogue: 0,0:06:01.46,0:06:05.36,Default,,0,0,0,,⚟ (Анна жылап жатыр)
Dialogue: 0,0:06:05.36,0:06:11.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:11.97,0:06:14.60,Default,,0,0,0,,...Енді, жылауға болмайды.
Dialogue: 0,0:06:14.60,0:06:17.61,Default,,0,0,0,,Жыласаң да Матай қайтып келмейді.
Dialogue: 0,0:06:17.61,0:06:21.04,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:21.04,0:06:24.85,Default,,0,0,0,,Көп жылау ештеңеге әкелмейді.
Dialogue: 0,0:06:24.85,0:06:26.88,Default,,0,0,0,,Жылаған жақсы...!
Dialogue: 0,0:06:26.88,0:06:31.12,Default,,0,0,0,,Кеуде ауырып, ауырғаннан жақсы...
Dialogue: 0,0:06:31.12,0:06:35.46,Default,,0,0,0,,О, Марилла... Мен Мэтьюдің кеткеніне сене алар емеспін.
Dialogue: 0,0:06:35.46,0:06:40.16,Default,,0,0,0,,Бұдан былай не істеуіміз керек?
Dialogue: 0,0:06:40.16,0:06:42.43,Default,,0,0,0,,Тыңда, Энн.
Dialogue: 0,0:06:42.43,0:06:47.04,Default,,0,0,0,,Сенде мен бар, менде сен бар.
Dialogue: 0,0:06:47.04,0:06:50.57,Default,,0,0,0,,Егер сіз бұл үйге келмеген болсаңыз➡
Dialogue: 0,0:06:50.57,0:06:54.44,Default,,0,0,0,,Мен мүлдем адасып кетер едім... ➡
Dialogue: 0,0:06:54.44,0:06:58.08,Default,,0,0,0,,Мен саған қатты тиген шығармын. ➡
Dialogue: 0,0:06:58.08,0:07:00.12,Default,,0,0,0,,Бірақ сол себепті➡
Dialogue: 0,0:07:00.12,0:07:03.89,Default,,0,0,0,,Мен сені Мэтью сияқты жақсы көрмедім деп ойлама.
Dialogue: 0,0:07:03.89,0:07:09.16,Default,,0,0,0,,Мен мұны сізге айтамын, өйткені дәл осындай уақытта болмасаңыз, сіз адал бола алмайсыз.
Dialogue: 0,0:07:09.16,0:07:11.73,Default,,0,0,0,,Сіз туралы➡
Dialogue: 0,0:07:11.73,0:07:15.00,Default,,0,0,0,,Мен сені өз баламдай жақсы көремін. ➡
Dialogue: 0,0:07:15.00,0:07:20.30,Default,,0,0,0,,Сен менің қуанышымсың, жұбанышымсың.
Dialogue: 0,0:07:20.30,0:07:45.59,Default,,0,0,0,,♬～
Dialogue: 0,0:07:45.59,0:07:51.67,Default,,0,0,0,,Матайды қатты сағындым... Алан ханым.
Dialogue: 0,0:07:51.67,0:07:55.20,Default,,0,0,0,,Сонда да мен бақшадан кішкентай бүршік тапқанда➡
Dialogue: 0,0:07:55.20,0:07:59.74,Default,,0,0,0,,Ештеңе болмағандай қуаныштан жүрегім лүпілдейді.
Dialogue: 0,0:07:59.74,0:08:03.24,Default,,0,0,0,,Диана бүгін тағы біртүрлі нәрсе айтты➡
Dialogue: 0,0:08:03.24,0:08:05.91,Default,,0,0,0,,Мен күлгенімді баса алмадым.
Dialogue: 0,0:08:05.91,0:08:09.38,Default,,0,0,0,,Қазір күлетін уақыт емес...
Dialogue: 0,0:08:09.38,0:08:14.19,Default,,0,0,0,,...Сіздің күлкіңіз Мэтьюге ұнады, солай ма?
Dialogue: 0,0:08:14.19,0:08:16.93,Default,,0,0,0,,Иә. (Алан ханым) Сіз➡
Dialogue: 0,0:08:16.93,0:08:21.63,Default,,0,0,0,,Ұсақ-түйек нәрселерден қуаныш тапқанға қуандыңыз ғой, солай емес пе?
Dialogue: 0,0:08:21.63,0:08:23.60,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:23.60,0:08:27.30,Default,,0,0,0,,Кішкентай бүршік сізді емдей алатын болса➡
Dialogue: 0,0:08:27.30,0:08:30.11,Default,,0,0,0,,Жүрегіңді жабудың қажеті жоқ. ➡
Dialogue: 0,0:08:30.11,0:08:33.54,Default,,0,0,0,,Көңілді болыңыз. Бұл дүние. ➡
Dialogue: 0,0:08:33.54,0:08:36.24,Default,,0,0,0,,Матайдың үлесіне. иә.
Dialogue: 0,0:08:36.24,0:08:39.01,Default,,0,0,0,,Бүгін Матай бейітінің қасында➡
Dialogue: 0,0:08:39.01,0:08:41.52,Default,,0,0,0,,Ақ раушан гүлдерін отырғыздым.
Dialogue: 0,0:08:41.52,0:08:46.92,Default,,0,0,0,,Мэтью ақ шотланд раушандарын ең жақсы көретін...
Dialogue: 0,0:08:46.92,0:08:51.33,Default,,0,0,0,,Аспанда да ақ раушан гүлдер болса екен...
Dialogue: 0,0:08:51.33,0:08:55.06,Default,,0,0,0,,Мен сенімдімін... бар.
Dialogue: 0,0:08:55.06,0:08:57.33,Default,,0,0,0,,Ақ раушан гүлдері➡
Dialogue: 0,0:08:57.33,0:09:01.20,Default,,0,0,0,,Матайды көкте қарсы аласың ба?
Dialogue: 0,0:09:01.20,0:09:04.11,Default,,0,0,0,,Иә, сенейік.
Dialogue: 0,0:09:07.51,0:09:10.55,Default,,0,0,0,,Мен үйдемін~ Марилла.
Dialogue: 0,0:09:10.55,0:09:13.15,Default,,0,0,0,,Аннаға қош келдіңіз.
Dialogue: 0,0:09:17.29,0:09:21.39,Default,,0,0,0,,ырғай? Бұл дұрыс.
Dialogue: 0,0:09:21.39,0:09:25.13,Default,,0,0,0,,Мұны істегенде, ауаны әлсіз иіс тарайды➡
Dialogue: 0,0:09:25.13,0:09:27.70,Default,,0,0,0,,Жақсы сезінеді.
Dialogue: 0,0:09:27.70,0:09:30.53,Default,,0,0,0,,Бұл тәтті және жағымды иісі бар. ➡
Dialogue: 0,0:09:30.53,0:09:33.94,Default,,0,0,0,,Профессор Спенсер ертерек келді➡
Dialogue: 0,0:09:33.94,0:09:37.81,Default,,0,0,0,,Ертең қалаға көз дәрігері келеді деп естідім.
Dialogue: 0,0:09:37.81,0:09:41.08,Default,,0,0,0,,Жақсы. Сіз оны міндетті түрде тексеріп алуыңыз керек.
Dialogue: 0,0:09:41.08,0:09:44.05,Default,,0,0,0,,Ендеше ертең жалғыз қаласың➡
Dialogue: 0,0:09:44.05,0:09:46.41,Default,,0,0,0,,Мен үйде қалуым керек, бірақ...
Dialogue: 0,0:09:46.41,0:09:49.42,Default,,0,0,0,,Иә, мен Диананың келуін сұраймын.
Dialogue: 0,0:09:49.42,0:09:55.12,Default,,0,0,0,,Жарайды. Мен енді ешқашан құлпынай суын шарап деп қателеспеймін.
Dialogue: 0,0:09:55.12,0:09:57.13,Default,,0,0,0,,Уфуфуфу.
Dialogue: 0,0:09:57.13,0:10:01.36,Default,,0,0,0,,Ол кезде сіз неше түрлі шектен шыққан істер жасадыңыз.
Dialogue: 0,0:10:01.36,0:10:03.30,Default,,0,0,0,,Хехехе. Ахаха….
Dialogue: 0,0:10:03.30,0:10:07.47,Default,,0,0,0,,Шашыңызды жасыл түске бояғаныңыз есіңізде ме?
Dialogue: 0,0:10:07.47,0:10:09.54,Default,,0,0,0,,Әрине.
Dialogue: 0,0:10:09.54,0:10:13.27,Default,,0,0,0,,Сенің қызылшаға сонша көңіл бөлгеніңе сене алар емеспін...
Dialogue: 0,0:10:13.27,0:10:16.18,Default,,0,0,0,,Бірақ ол кезде мен үшін➡
Dialogue: 0,0:10:16.18,0:10:18.45,Default,,0,0,0,,Бұл үлкен мәселе болды.
Dialogue: 0,0:10:18.45,0:10:23.79,Default,,0,0,0,,Енді қызыл шаштарым мен сепкілдерім мені онша мазаламайды.
Dialogue: 0,0:10:23.79,0:10:26.49,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:10:28.26,0:10:33.13,Default,,0,0,0,,♬～
Dialogue: 0,0:10:33.13,0:10:35.83,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:10:39.37,0:10:41.34,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:41.34,0:10:45.17,Default,,0,0,0,,А... Қайтадан қош келдіңіз, Марилла.
Dialogue: 0,0:10:45.17,0:10:48.94,Default,,0,0,0,,Диана дәл қазір осында болды.
Dialogue: 0,0:10:48.94,0:10:51.28,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:10:51.28,0:10:56.08,Default,,0,0,0,,Амансың ба? Сіз шаршаған болуыңыз керек. Біраз жатқыңыз келе ме?
Dialogue: 0,0:10:56.08,0:10:59.09,Default,,0,0,0,,О... жоқ, өтінемін...
Dialogue: 0,0:10:59.09,0:11:04.79,Default,,0,0,0,,Көз дәрігеріне көріндіңіз бе? Не дедіңіз...?
Dialogue: 0,0:11:04.79,0:11:08.43,Default,,0,0,0,,…Оқу және тігу➡
Dialogue: 0,0:11:08.43,0:11:10.93,Default,,0,0,0,,Көзіңізге не ауыртпалық түсіруі мүмкін?
Dialogue: 0,0:11:10.93,0:11:13.77,Default,,0,0,0,,Ол маған ештеңе істеме деді.
Dialogue: 0,0:11:13.77,0:11:17.21,Default,,0,0,0,,Ах…. Жылау да жақсы емес сияқты. ➡
Dialogue: 0,0:11:17.21,0:11:20.54,Default,,0,0,0,,Мұғалім ұсынған көзілдірік киіп жүрсеңіз➡
Dialogue: 0,0:11:20.54,0:11:23.55,Default,,0,0,0,,Мен оның нашарлауын тоқтата аламын...➡
Dialogue: 0,0:11:23.55,0:11:26.01,Default,,0,0,0,,Олай етпесеңіз ➡
Dialogue: 0,0:11:26.01,0:11:29.25,Default,,0,0,0,,Ол алты ай ішінде соқыр болатынын айтты.
Dialogue: 0,0:11:29.25,0:11:32.49,Default,,0,0,0,,Сен соқыр боласың, Энн.
Dialogue: 0,0:11:32.49,0:11:37.89,Default,,0,0,0,,Міне... Марилла, сен маған үміт сыйладың.
Dialogue: 0,0:11:37.89,0:11:39.83,Default,,0,0,0,,Егер сіз оған қамқорлық жасасаңыз ...
Dialogue: 0,0:11:39.83,0:11:42.46,Default,,0,0,0,,Бұл үміт деп айта аласыз ба?
Dialogue: 0,0:11:42.46,0:11:45.17,Default,,0,0,0,,Мэтью өмірден озса да➡
Dialogue: 0,0:11:45.17,0:11:47.60,Default,,0,0,0,,Жылауға болмайды...➡
Dialogue: 0,0:11:47.60,0:11:49.90,Default,,0,0,0,,Төзгісіз жалғыздықты сезінгенде...➡
Dialogue: 0,0:11:49.90,0:11:52.31,Default,,0,0,0,,Мен не істеуім керек...?
Dialogue: 0,0:11:52.31,0:11:56.18,Default,,0,0,0,,(жылау)
Dialogue: 0,0:11:56.18,0:12:06.32,Default,,0,0,0,,♬～
Dialogue: 0,0:12:06.32,0:12:10.02,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:12:11.83,0:12:14.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:17.43,0:12:19.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:25.47,0:12:27.41,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:12:27.41,0:12:30.01,Default,,0,0,0,,Садлер мырза, сізге не керек еді?
Dialogue: 0,0:12:31.91,0:12:36.12,Default,,0,0,0,,...Мен Green Gables➡ сатуды жоспарлап жүргенімді естідім
Dialogue: 0,0:12:36.12,0:12:38.59,Default,,0,0,0,,Әлгі адам оны сатып алғысы келетінін айтты.
Dialogue: 0,0:12:38.59,0:12:42.46,Default,,0,0,0,,Сату⁉ Жасыл Гейблді сату⁉
Dialogue: 0,0:12:42.46,0:12:45.69,Default,,0,0,0,,Бұл көп ойланғаннан кейін болды.
Dialogue: 0,0:12:45.69,0:12:52.03,Default,,0,0,0,,Менің көзім жақсы болса, әйтеуір бір төтеп берер едім...➡
Dialogue: 0,0:12:52.03,0:12:54.70,Default,,0,0,0,,Осындай жағдайда... ➡
Dialogue: 0,0:12:54.70,0:12:57.61,Default,,0,0,0,,Сатсам да, құны көп болмайтын шығар ➡
Dialogue: 0,0:12:57.61,0:13:01.81,Default,,0,0,0,,Мен мұны өз бетімше шеше аламын.
Dialogue: 0,0:13:01.81,0:13:07.08,Default,,0,0,0,,Стипендия алғаныңызға өте ризамын.
Dialogue: 0,0:13:07.08,0:13:11.45,Default,,0,0,0,,Жай ғана... Демалыста баратын үйім жоқ➡
Dialogue: 0,0:13:11.45,0:13:13.52,Default,,0,0,0,,Бұл үшін кешірім сұраймын... ➡
Dialogue: 0,0:13:13.52,0:13:15.89,Default,,0,0,0,,үшін ...
Dialogue: 0,0:13:15.89,0:13:18.79,Default,,0,0,0,,Марилла! Green Gables сатпаңыз!
Dialogue: 0,0:13:18.79,0:13:22.33,Default,,0,0,0,,Егер мен оны сатудан құтыла алсам, мен де жасар едім.
Dialogue: 0,0:13:22.33,0:13:26.33,Default,,0,0,0,,Марилланың жалғыз болуы міндетті емес.
Dialogue: 0,0:13:28.14,0:13:31.44,Default,,0,0,0,,Мен Редмонд университетіне бармаймын.
Dialogue: 0,0:13:31.44,0:13:34.64,Default,,0,0,0,,А... Мен университетке бармаймын!?
Dialogue: 0,0:13:34.64,0:13:38.61,Default,,0,0,0,,Иә. Мен стипендияны қабылдамаймын деп шештім.
Dialogue: 0,0:13:38.61,0:13:42.38,Default,,0,0,0,,Сіз Марилланы жалғыз қалдыра аласыз ба?
Dialogue: 0,0:13:42.38,0:13:46.25,Default,,0,0,0,,Мен толық жоспар құрдым.
Dialogue: 0,0:13:46.25,0:13:50.22,Default,,0,0,0,,Арпа мырза алқапты жалға алғысы келді.
Dialogue: 0,0:13:50.22,0:13:55.86,Default,,0,0,0,,Мен балаларға мектепте сабақ беремін.
Dialogue: 0,0:13:55.86,0:13:59.30,Default,,0,0,0,,Энн, сен не туралы айтып тұрсың?
Dialogue: 0,0:13:59.30,0:14:01.24,Default,,0,0,0,,Мен шешіп қойдым.
Dialogue: 0,0:14:01.24,0:14:03.17,Default,,0,0,0,,Авонлеадағы мектеп➡
Dialogue: 0,0:14:03.17,0:14:05.54,Default,,0,0,0,,Гилберт Блайт таңдалған сияқты➡
Dialogue: 0,0:14:05.54,0:14:08.34,Default,,0,0,0,,Кармодиде әлі де орын бар.
Dialogue: 0,0:14:08.34,0:14:12.21,Default,,0,0,0,,Біраз алыс, бірақ ат арба болса, қиындық тудырмайды.
Dialogue: 0,0:14:12.21,0:14:16.08,Default,,0,0,0,,Қыста да демалыс күндері үйге келуге болады.
Dialogue: 0,0:14:16.08,0:14:21.06,Default,,0,0,0,,Мен Мариллаға жақсы шай қайнатып, оған кітап оқып беремін.
Dialogue: 0,0:14:21.06,0:14:23.66,Default,,0,0,0,,Мен сені жалғыз сезінбеймін.
Dialogue: 0,0:14:23.66,0:14:27.46,Default,,0,0,0,,Біз бірге көңіл көтереміз.
Dialogue: 0,0:14:27.46,0:14:29.43,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:14:29.43,0:14:31.67,Default,,0,0,0,,Сені құрбан ету үшін...
Dialogue: 0,0:14:31.67,0:14:33.63,Default,,0,0,0,,Бұл мүлде құрбандық емес.
Dialogue: 0,0:14:33.63,0:14:36.37,Default,,0,0,0,,Жасыл Гейблсті босатқан сайын➡
Dialogue: 0,0:14:36.37,0:14:39.07,Default,,0,0,0,,Қолдан келмейтін нәрсе жоқ.
Dialogue: 0,0:14:40.91,0:14:44.18,Default,,0,0,0,,Мен осында қалып, мұғалім боламын.
Dialogue: 0,0:14:44.18,0:14:46.11,Default,,0,0,0,,Бұл менің арманым.
Dialogue: 0,0:14:46.11,0:14:48.78,Default,,0,0,0,,Ал мен өз бетімше оқуды жалғастырамын.
Dialogue: 0,0:14:48.78,0:14:53.72,Default,,0,0,0,,Жақсы ұстаз болыңыз және Марилланың көзін қорғаңыз.
Dialogue: 0,0:14:53.72,0:14:57.56,Default,,0,0,0,,Бірақ... Мені тоқтатуға тырысқаннан пайда жоқ.
Dialogue: 0,0:14:57.56,0:14:59.99,Default,,0,0,0,,16 жыл 6 ай.
Dialogue: 0,0:14:59.99,0:15:05.30,Default,,0,0,0,,Ол Марилла сияқты қыңыр.
Dialogue: 0,0:15:05.30,0:15:08.54,Default,,0,0,0,,О, Марилла, өтінемін➡
Dialogue: 0,0:15:08.54,0:15:11.21,Default,,0,0,0,,Мені аяма.
Dialogue: 0,0:15:11.21,0:15:14.74,Default,,0,0,0,,Менің сүйікті Green Gables-те болуды ойлаймын➡
Dialogue: 0,0:15:14.74,0:15:17.75,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:15:17.75,0:15:21.12,Default,,0,0,0,,Қандай жақсылық...
Dialogue: 0,0:15:21.12,0:15:24.55,Default,,0,0,0,,Мен өзімді өмірге қайта оралғандай сезінемін.
Dialogue: 0,0:15:24.55,0:15:27.92,Default,,0,0,0,,Рас болса, қыңыр болыңыз➡
Dialogue: 0,0:15:27.92,0:15:31.66,Default,,0,0,0,,Мен сені университетке жіберуім керек...➡
Dialogue: 0,0:15:31.66,0:15:35.43,Default,,0,0,0,,Өйткені мен дәл қазір мұны істей алмаймын.
Dialogue: 0,0:15:35.43,0:15:38.83,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:15:38.83,0:15:43.34,Default,,0,0,0,,Маған осының орнын толтыруға рұқсат етіңізші, Энн.
Dialogue: 0,0:15:43.34,0:15:45.27,Default,,0,0,0,,Марилла жоқ.
Dialogue: 0,0:15:45.27,0:15:48.31,Default,,0,0,0,,Маған өтемақы қажет емес.
Dialogue: 0,0:15:48.31,0:15:50.85,Default,,0,0,0,,Матай.
Dialogue: 0,0:15:50.85,0:15:55.75,Default,,0,0,0,,Мен енді ғана жолдың бұрылыс нүктесіне жеткен сияқтымын.
Dialogue: 0,0:15:55.75,0:15:59.55,Default,,0,0,0,,Мен иілудің арғы жағында не жатқанын әлі білмеймін➡
Dialogue: 0,0:15:59.55,0:16:01.56,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:16:01.56,0:16:06.83,Default,,0,0,0,,Ендеше... мені бақылап жүр, Мэтью.
Dialogue: 0,0:16:06.83,0:16:12.33,Default,,0,0,0,,Эй, сен мұны естідің бе? Энн Ширли университетке түсуден бас тартты.
Dialogue: 0,0:16:12.33,0:16:14.30,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:16:14.30,0:16:18.01,Default,,0,0,0,,Аа, мен қатты оқығаным сонша, тіпті стипендия да алдым. ➡
Dialogue: 0,0:16:18.01,0:16:21.41,Default,,0,0,0,,Мен сізді мұғалім болып, Кармодиде сабақ береді деп естідім.
Dialogue: 0,0:16:21.41,0:16:25.11,Default,,0,0,0,,Кармоди, бұл алыс...
Dialogue: 0,0:16:27.75,0:16:30.52,Default,,0,0,0,,Сәлеметсіз бе! а….
Dialogue: 0,0:16:30.52,0:16:33.75,Default,,0,0,0,,Сәлеметсіз бе! Кешке салқын ба?
Dialogue: 0,0:16:33.75,0:16:36.02,Default,,0,0,0,,Ах. Мен сені естідім, Энн.
Dialogue: 0,0:16:36.02,0:16:39.63,Default,,0,0,0,,Сонда сіз университетке барудың орнына осында қаласыз ба?
Dialogue: 0,0:16:39.63,0:16:42.86,Default,,0,0,0,,Иә. Бұл шынымен керемет.
Dialogue: 0,0:16:42.86,0:16:47.27,Default,,0,0,0,,Мен толықтай келісемін. Рахмет, Линд ханым.
Dialogue: 0,0:16:47.27,0:16:50.94,Default,,0,0,0,,Сонда сіз мектеп мұғалімі боласыз ба?
Dialogue: 0,0:16:50.94,0:16:54.34,Default,,0,0,0,,Иә. Мен Кармодиде сабақ бердім.
Dialogue: 0,0:16:54.34,0:16:56.34,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:16:56.34,0:17:03.05,Default,,0,0,0,,Басқарма отырысында сізді Avonlea мектебіне оқуға таңдағаныңызды естідім.
Dialogue: 0,0:17:03.05,0:17:05.05,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:17:05.05,0:17:07.42,Default,,0,0,0,,Avonlea мектебінің негізін Гилберт Блайт қойған.
Dialogue: 0,0:17:07.42,0:17:10.83,Default,,0,0,0,,Гилберт Блайт бас тартты.
Dialogue: 0,0:17:10.83,0:17:13.06,Default,,0,0,0,,...иә? а….
Dialogue: 0,0:17:13.06,0:17:16.53,Default,,0,0,0,,Мен Ақ құм мектебінде сабақ беремін➡
Dialogue: 0,0:17:16.53,0:17:20.87,Default,,0,0,0,,Оның орнына Эннді жалдау үшін басқармамен келіссөздер жүргізіңіз.
Dialogue: 0,0:17:20.87,0:17:23.10,Default,,0,0,0,,Әрине, бұл Анн➡
Dialogue: 0,0:17:23.10,0:17:26.01,Default,,0,0,0,,Мен сені ойладым. ➡
Dialogue: 0,0:17:26.01,0:17:29.41,Default,,0,0,0,,Марилламен қанша болғың келеді➡
Dialogue: 0,0:17:29.41,0:17:32.31,Default,,0,0,0,,Мен Гилбертті жақсы білемін.
Dialogue: 0,0:17:32.31,0:17:35.62,Default,,0,0,0,,Егер сіз Ақ құмда тұрсаңыз, пансионаттың ақысын төлеуіңіз керек➡
Dialogue: 0,0:17:35.62,0:17:39.99,Default,,0,0,0,,Университетке жалғыз түсу үшін оқу ақысын табуым керек болса да➡
Dialogue: 0,0:17:39.99,0:17:42.22,Default,,0,0,0,,Ол өте мейірімді бала.
Dialogue: 0,0:17:42.22,0:17:44.83,Default,,0,0,0,,Міне... Міне, сол...
Dialogue: 0,0:17:44.83,0:17:47.66,Default,,0,0,0,,Мен Гилбертке рұқсат бере алмаймын. Мен үшін!
Dialogue: 0,0:17:47.66,0:17:50.57,Default,,0,0,0,,Бірдеңе айтуға кеш.
Dialogue: 0,0:17:50.57,0:17:54.37,Default,,0,0,0,,Гилберт келісімшартты орындап қойған. ➡
Dialogue: 0,0:17:54.37,0:17:57.67,Default,,0,0,0,,Сіз Avonlea-да сабақ бересіз, Энн. ➡
Dialogue: 0,0:17:57.67,0:18:02.51,Default,,0,0,0,,Бұл да Гилберттің тілегі. ➡
Dialogue: 0,0:18:02.51,0:18:06.48,Default,,0,0,0,,Ах... Ах. Құдай-ау, асығыс.
Dialogue: 0,0:18:06.48,0:18:10.15,Default,,0,0,0,,Сенің бойыңда әлі талай балалық бар.
Dialogue: 0,0:18:10.15,0:18:14.39,Default,,0,0,0,,Сіз ересек адамға айналдыңыз.
Dialogue: 0,0:18:14.39,0:18:20.63,Default,,0,0,0,,Марилла Катберт те әбден жетілген. Хехе.
Dialogue: 0,0:18:20.63,0:18:22.66,Default,,0,0,0,,Гилберт шықты.
Dialogue: 0,0:18:22.66,0:18:26.13,Default,,0,0,0,,Қайда? (Гильберттің анасы) Ал... қайда барғаныңызша...
Dialogue: 0,0:18:26.13,0:18:29.94,Default,,0,0,0,,Түсінді. Сонымен….
Dialogue: 0,0:18:33.74,0:18:36.14,Default,,0,0,0,,Мм... Иә?
Dialogue: 0,0:18:36.14,0:18:39.08,Default,,0,0,0,,Мен Avonlea мектебі туралы естідім.
Dialogue: 0,0:18:39.08,0:18:42.02,Default,,0,0,0,,Алғысымды қалай білдіруім керек?
Dialogue: 0,0:18:42.02,0:18:46.92,Default,,0,0,0,,Сізге көп рахмет. Кешіріңіз.
Dialogue: 0,0:18:49.16,0:18:51.66,Default,,0,0,0,,(Шөптің тербелген дыбысы)
Dialogue: 0,0:18:51.66,0:18:57.16,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:18:57.16,0:19:03.67,Default,,0,0,0,,Қымбатты, сағыныш әлем, қандай сұлусың.
Dialogue: 0,0:19:03.67,0:19:08.18,Default,,0,0,0,,Мен мұнда өмір сүргенім үшін бақытты бола алмадым.
Dialogue: 0,0:19:08.18,0:19:10.14,Default,,0,0,0,,⚟(Ысқырып) Ах...
Dialogue: 0,0:19:10.14,0:19:17.85,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:19:17.85,0:19:20.15,Default,,0,0,0,,…Ах.
Dialogue: 0,0:19:31.90,0:19:33.83,Default,,0,0,0,,Гилберт!
Dialogue: 0,0:19:33.83,0:19:35.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.77,0:19:38.77,Default,,0,0,0,,А... маған Авонлеадағы мектепті бергені үшін➡
Dialogue: 0,0:19:38.77,0:19:40.91,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:19:40.91,0:19:43.18,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:19:43.18,0:19:45.91,Default,,0,0,0,,Бұл үшін сізге алғыс айтқым келді.
Dialogue: 0,0:19:45.91,0:19:49.32,Default,,0,0,0,,Бұл маңызды емес, Энн.
Dialogue: 0,0:19:49.32,0:19:53.19,Default,,0,0,0,,Бірақ оның біраз көмегі тигеніне қуаныштымын.
Dialogue: 0,0:19:53.19,0:19:56.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:56.46,0:19:58.99,Default,,0,0,0,,I…. Сонымен... Ах... Ах...
Dialogue: 0,0:19:58.99,0:20:00.93,Default,,0,0,0,,Хехехе. Хехе.
Dialogue: 0,0:20:00.93,0:20:04.23,Default,,0,0,0,,Сізден, Гилберт. Иә.
Dialogue: 0,0:20:04.23,0:20:07.57,Default,,0,0,0,,Сонымен, сен қалай ойлайсың, Энн?
Dialogue: 0,0:20:07.57,0:20:11.51,Default,,0,0,0,,Бұрынғы болғаным үшін кешіре аласың ба деп ойлаймын.
Dialogue: 0,0:20:11.51,0:20:14.24,Default,,0,0,0,,Әрине. а...!
Dialogue: 0,0:20:14.24,0:20:19.11,Default,,0,0,0,,Сіз мені қайықта құтқарған кезде...
Dialogue: 0,0:20:19.11,0:20:21.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:21.15,0:20:23.38,Default,,0,0,0,,Қандай қыңыр ақымақ.
Dialogue: 0,0:20:23.38,0:20:26.89,Default,,0,0,0,,Содан бері өкініп жүрмін.
Dialogue: 0,0:20:28.89,0:20:32.76,Default,,0,0,0,,Менің ойымша, біз ең жақсы дос бола аламыз.
Dialogue: 0,0:20:32.76,0:20:39.53,Default,,0,0,0,,Біз осылай туылғанбыз, Энн.
Dialogue: 0,0:20:39.53,0:20:43.14,Default,,0,0,0,,Мен бұл тағдырға көптен бері қарсы келемін.
Dialogue: 0,0:20:43.14,0:21:01.52,Default,,0,0,0,,♬～
Dialogue: 0,0:21:01.52,0:21:04.06,Default,,0,0,0,,Енді, Марилла.
Dialogue: 0,0:21:04.06,0:21:07.76,Default,,0,0,0,,Қайтадан қош келдіңіз. Сіз кіммен сөйлестіңіз?
Dialogue: 0,0:21:07.76,0:21:12.60,Default,,0,0,0,,Гилберт. Жарқыраған көлде кездесіп, алғыс айттық.
Dialogue: 0,0:21:12.60,0:21:18.17,Default,,0,0,0,,Гилберт екеуің 30 минут тұрып сөйлесе алғаныңа сенбеймін.
Dialogue: 0,0:21:18.17,0:21:24.35,Default,,0,0,0,,Мен қазірден бастап тек жақсы дос болған дұрыс екенін түсіндім.
Dialogue: 0,0:21:24.35,0:21:27.18,Default,,0,0,0,,Эй, сен шынымен 30 минут сөйлестің бе?
Dialogue: 0,0:21:27.18,0:21:29.25,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:29.25,0:21:33.69,Default,,0,0,0,,«Маусым көктем, күндер айналып өтеді➡
Dialogue: 0,0:21:33.69,0:21:39.06,Default,,0,0,0,,Сағат жеті, төбелер інжу шықымен дымқыл➡
Dialogue: 0,0:21:39.06,0:21:41.96,Default,,0,0,0,,Хибари аспан арқылы ұшады➡
Dialogue: 0,0:21:41.96,0:21:45.70,Default,,0,0,0,,Ұлулар тікенекте жорғалайды.
Dialogue: 0,0:21:45.70,0:21:48.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.10,0:21:53.11,Default,,0,0,0,,♬～
Dialogue: 0,0:21:55.68,0:21:57.61,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:21:57.61,0:22:00.48,Default,,0,0,0,,♬～
Dialogue: 0,0:22:00.48,0:22:02.82,Default,,0,0,0,,«Құдай көкте➡
Dialogue: 0,0:22:02.82,0:22:06.42,Default,,0,0,0,,Дүниеде бәрі жақсы».
Dialogue: 0,0:22:09.72,0:22:18.90,Default,,0,0,0,,♬～
Dialogue: 0,0:22:18.90,0:22:21.77,Default,,0,0,0,,♬ «Не маңызды?»
Dialogue: 0,0:22:21.77,0:22:28.91,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:28.91,0:22:33.58,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:33.58,0:22:38.79,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:38.79,0:22:43.62,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:43.62,0:22:48.56,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:48.56,0:22:55.67,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:55.67,0:22:59.67,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:59.67,0:23:04.81,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:04.81,0:23:09.98,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:09.98,0:23:14.56,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:14.56,0:23:19.53,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:19.53,0:23:28.20,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:28.20,0:23:33.44,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:33.44,0:23:37.85,Default,,0,0,0,,♬～
Dialogue: 0,0:23:39.35,0:24:01.04,Default,,0,0,0,,♬～
