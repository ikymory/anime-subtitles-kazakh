Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:03.70,Default,,0,0,0,,<Green Gables-ке келгеннен кейін➡
Dialogue: 0,0:00:03.70,0:00:05.67,Default,,0,0,0,,Уақыт көзді ашып-жұмғанша өтеді➡
Dialogue: 0,0:00:05.67,0:00:09.27,Default,,0,0,0,,Көктем өтіп, 12 жасқа толдым. ➡
Dialogue: 0,0:00:09.27,0:00:12.17,Default,,0,0,0,,Бүгін мектеп бітті. ➡
Dialogue: 0,0:00:12.17,0:00:16.04,Default,,0,0,0,,Жазғы демалыс ертең басталады＞
Dialogue: 0,0:00:16.04,0:00:18.71,Default,,0,0,0,,(муку дыбысы)
Dialogue: 0,0:00:18.71,0:00:23.12,Default,,0,0,0,,Мен сіздің доктор Филлипсті соншалықты жақсы көретініңізді білмедім.
Dialogue: 0,0:00:23.12,0:00:27.49,Default,,0,0,0,,Мен сені шын сүйгендіктен жыламадым. Менің айналамда адамдар болды.
Dialogue: 0,0:00:27.49,0:00:30.73,Default,,0,0,0,,үшінмен қоштасу... Қоштасатын кезіміз де жетті➡
Dialogue: 0,0:00:30.73,0:00:32.66,Default,,0,0,0,,Мұғалім сөйлей бастағанда➡
Dialogue: 0,0:00:32.66,0:00:35.53,Default,,0,0,0,,Тіпті «Мен сені жек көремін!» деп айтатын Руби➡
Dialogue: 0,0:00:35.53,0:00:37.60,Default,,0,0,0,,Себебі мен жылай бастадым.
Dialogue: 0,0:00:37.60,0:00:40.40,Default,,0,0,0,,Ажырасу - жүректі ауыртатын сезім.
Dialogue: 0,0:00:40.40,0:00:42.74,Default,,0,0,0,,Хмм.
Dialogue: 0,0:00:42.74,0:00:46.01,Default,,0,0,0,,Бірақ екі айлық жазғы демалыс басталады.
Dialogue: 0,0:00:46.01,0:00:48.91,Default,,0,0,0,,Үмітсіздік қойнауында мәңгі қала алмаймын.
Dialogue: 0,0:00:48.91,0:00:51.65,Default,,0,0,0,,Бүгін мектептен қайтып келе жатқанда➡
Dialogue: 0,0:00:51.65,0:00:54.08,Default,,0,0,0,,Мен жаңа пастор мен оның әйелін кездестірдім!
Dialogue: 0,0:00:54.08,0:00:57.29,Default,,0,0,0,,Пастор өте мейірімді адам сияқты➡
Dialogue: 0,0:00:57.29,0:01:01.92,Default,,0,0,0,,Әйеліңіз өте әдемі еді.
Dialogue: 0,0:01:01.92,0:01:05.79,Default,,0,0,0,,Ол жеңі үлпілдеген әдемі көйлек киген.
Dialogue: 0,0:01:05.79,0:01:08.56,Default,,0,0,0,,Джейн: `` Пастордың әйелі үшін➡
Dialogue: 0,0:01:08.56,0:01:10.53,Default,,0,0,0,,Тым жылтыр емес пе? ” ➡
Dialogue: 0,0:01:10.53,0:01:13.14,Default,,0,0,0,,Кепті жеңді аңсау➡
Dialogue: 0,0:01:13.14,0:01:15.37,Default,,0,0,0,,Мен өте жақсы түсінемін.
Dialogue: 0,0:01:15.37,0:01:18.27,Default,,0,0,0,,Менде түсінік жоқ.
Dialogue: 0,0:01:18.27,0:01:24.15,Default,,0,0,0,,Жарайды, сенің жақсы әйел болғаныңа қуаныштымын. Мен келесі жолы жұпты шайға шақыруым керек.
Dialogue: 0,0:01:24.15,0:01:26.42,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:01:26.42,0:01:29.32,Default,,0,0,0,,Бірақ бұл Матайға қатысты емес.
Dialogue: 0,0:01:29.32,0:01:31.82,Default,,0,0,0,,Бір жерге қашып кетсем, қиналмас едім. ➡
Dialogue: 0,0:01:31.82,0:01:34.72,Default,,0,0,0,,Мэтью әдемі әйелі сияқты ұялшақ➡
Dialogue: 0,0:01:34.72,0:01:37.63,Default,,0,0,0,,Сенің діріліңді түсіретін ештеңе жоқ. (Мэтью Катберт) Хекцион!
Dialogue: 0,0:01:37.63,0:01:39.70,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:01:39.70,0:01:43.23,Default,,0,0,0,,Күзде Филлипс мырзаның орнына жаңа мұғалім келеді➡
Dialogue: 0,0:01:43.23,0:01:46.17,Default,,0,0,0,,Кездесулер керемет!
Dialogue: 0,0:01:46.17,0:01:55.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:55.41,0:02:00.08,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:00.08,0:02:02.55,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:02.55,0:02:04.49,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:04.49,0:02:08.36,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:08.36,0:02:10.69,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:10.69,0:02:12.93,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:12.93,0:02:17.47,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:17.47,0:02:22.67,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін.»
Dialogue: 0,0:02:22.67,0:02:24.61,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:02:24.61,0:02:28.48,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:28.48,0:02:31.88,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:31.88,0:02:34.32,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:34.32,0:02:36.59,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:36.59,0:02:40.82,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:40.82,0:02:43.29,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын.»
Dialogue: 0,0:02:43.29,0:02:45.63,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:45.63,0:02:49.10,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:49.10,0:02:52.40,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:52.40,0:02:54.64,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:54.64,0:02:58.91,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны».
Dialogue: 0,0:02:58.91,0:03:01.34,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:03:01.34,0:03:03.65,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:03.65,0:03:05.98,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:05.98,0:03:09.89,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:09.89,0:03:13.79,Default,,0,0,0,,♬～
Dialogue: 0,0:03:16.49,0:03:21.26,Default,,0,0,0,,♬～
Dialogue: 0,0:03:21.26,0:03:24.07,Default,,0,0,0,,Күте тұрыңыз! (күлкі)
Dialogue: 0,0:03:24.07,0:03:26.60,Default,,0,0,0,,Ұстадым! (Джейн Эндрюс) Ах!
Dialogue: 0,0:03:26.60,0:03:29.14,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:03:29.14,0:03:31.77,Default,,0,0,0,,Мен енді жүгіре алмаймын. (Руби Гиллис) Мен де.
Dialogue: 0,0:03:31.77,0:03:34.61,Default,,0,0,0,,Енді командаларды ойнаймыз.
Dialogue: 0,0:03:34.61,0:03:36.55,Default,,0,0,0,,Командалық ойын?
Dialogue: 0,0:03:36.55,0:03:40.38,Default,,0,0,0,,Ережелер қарапайым. Біреуді ұсынып, оларға бұйрық беріңіз. ➡
Dialogue: 0,0:03:40.38,0:03:43.05,Default,,0,0,0,,Пәрмен сәтті орындалса, сіз жеңесіз. ➡
Dialogue: 0,0:03:43.05,0:03:45.12,Default,,0,0,0,,Орындау мүмкін болмаса, бұйрық берген адам жеңеді.
Dialogue: 0,0:03:45.12,0:03:47.39,Default,,0,0,0,,Уау! Қызық көрінеді!
Dialogue: 0,0:03:47.39,0:03:49.32,Default,,0,0,0,,Кімнен?
Dialogue: 0,0:03:49.32,0:03:52.89,Default,,0,0,0,,Мен сізге бұйрық беремін. Диана.
Dialogue: 0,0:03:52.89,0:03:54.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:54.83,0:03:57.87,Default,,0,0,0,,Бақты бір рет тоқтамай, оң аяқпен айналып өт. ➡
Dialogue: 0,0:03:57.87,0:04:00.70,Default,,0,0,0,,Бір рет болса да сол аяқты ұстасаңыз, ұтыласыз.
Dialogue: 0,0:04:00.70,0:04:02.90,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:04:02.90,0:04:05.44,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:04:05.44,0:04:07.38,Default,,0,0,0,,Сәттілік Диана!
Dialogue: 0,0:04:07.38,0:04:11.01,Default,,0,0,0,,Бұл таңқаларлық. Осылай жалғаса берсе, Диана жеңеді.
Dialogue: 0,0:04:11.01,0:04:12.95,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:12.95,0:04:15.02,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:15.02,0:04:18.69,Default,,0,0,0,,А... аа... ой-а!
Dialogue: 0,0:04:18.69,0:04:21.96,Default,,0,0,0,,Ататата... Бұл менің шығыным.
Dialogue: 0,0:04:21.96,0:04:25.83,Default,,0,0,0,,Ах…. Хмм, маңызды емес.
Dialogue: 0,0:04:25.83,0:04:30.50,Default,,0,0,0,,Енді мен Джозиге бұйрық беремін!
Dialogue: 0,0:04:30.50,0:04:34.20,Default,,0,0,0,,Мына дуалмен жүр!
Dialogue: 0,0:04:37.71,0:04:40.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:40.98,0:04:43.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.51,0:04:46.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:46.15,0:04:49.62,Default,,0,0,0,,Бұндай бұйрық үлкен мәселе емес.
Dialogue: 0,0:04:49.62,0:04:54.39,Default,,0,0,0,,Ух... аласа қабырғамен жүру соншалықты қиын емес!
Dialogue: 0,0:04:54.39,0:04:58.26,Default,,0,0,0,,Мен төбеде жүрген қызды білемін.
Dialogue: 0,0:04:58.26,0:05:01.53,Default,,0,0,0,,Иә. Бірақ сіз жүре алмайсыз, солай емес пе?
Dialogue: 0,0:05:01.53,0:05:03.47,Default,,0,0,0,,Мен жүре аламын! Энн!
Dialogue: 0,0:05:03.47,0:05:06.77,Default,,0,0,0,,Олай болса, дәлелдеңіз. сурет?
Dialogue: 0,0:05:06.77,0:05:08.70,Default,,0,0,0,,Энн Ширли. ➡
Dialogue: 0,0:05:08.70,0:05:11.01,Default,,0,0,0,,Сол сарайдың төбесінде жүр.
Dialogue: 0,0:05:11.01,0:05:13.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:13.34,0:05:15.31,Default,,0,0,0,,Жоқ, Энн!
Dialogue: 0,0:05:15.31,0:05:17.31,Default,,0,0,0,,Егер мен сол жерден құласам, өлетін едім!
Dialogue: 0,0:05:17.31,0:05:20.45,Default,,0,0,0,,Джози, мұндай нәрсеге тапсырыс беруге қалай батылы бардың!
Dialogue: 0,0:05:20.45,0:05:24.32,Default,,0,0,0,,Әй, бұйрықты орындау-орындамау Аннаның еркі.
Dialogue: 0,0:05:24.32,0:05:28.76,Default,,0,0,0,,Әрине бас тартуға болады.
Dialogue: 0,0:05:28.76,0:05:30.69,Default,,0,0,0,,Мен мұны істеймін. Энн!
Dialogue: 0,0:05:30.69,0:05:32.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.63,0:05:36.06,Default,,0,0,0,,♬～
Dialogue: 0,0:05:36.06,0:05:38.57,Default,,0,0,0,,Эй Анна, тоқташы өтінемін!
Dialogue: 0,0:05:38.57,0:05:44.37,Default,,0,0,0,,Мен мұны істеуім керек. Бұл абырой туралы.
Dialogue: 0,0:05:44.37,0:05:47.04,Default,,0,0,0,,Мен сол төбеден өтейін бе?
Dialogue: 0,0:05:47.04,0:05:50.91,Default,,0,0,0,,Немесе құлап өл. Біреуі. а...!
Dialogue: 0,0:05:50.91,0:06:02.32,Default,,0,0,0,,♬～
Dialogue: 0,0:06:02.32,0:06:04.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:06.73,0:06:09.63,Default,,0,0,0,,Аа... Аа.
Dialogue: 0,0:06:09.63,0:06:12.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:12.00,0:06:21.48,Default,,0,0,0,,♬～
Dialogue: 0,0:06:21.48,0:06:25.18,Default,,0,0,0,,А, а.
Dialogue: 0,0:06:25.18,0:06:27.88,Default,,0,0,0,,Уау. Ах!
Dialogue: 0,0:06:27.88,0:06:29.82,Default,,0,0,0,,Ах… Ах….
Dialogue: 0,0:06:29.82,0:06:32.25,Default,,0,0,0,,Ах!? Ах... Ах... Ах, ах!
Dialogue: 0,0:06:32.25,0:06:34.19,Default,,0,0,0,,Уау! (Руби Диана Джози Джейн) Уау!
Dialogue: 0,0:06:34.19,0:06:37.09,Default,,0,0,0,,Уау! Уау... Уау!
Dialogue: 0,0:06:37.09,0:06:39.79,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:06:39.79,0:06:43.00,Default,,0,0,0,,Ах... Энн!
Dialogue: 0,0:06:43.00,0:06:47.67,Default,,0,0,0,,Анна, оян! Энн! Энн!
Dialogue: 0,0:06:47.67,0:06:51.14,Default,,0,0,0,,О, Энн... жақсысың ба?
Dialogue: 0,0:06:51.14,0:06:54.68,Default,,0,0,0,,Білмеймін... мүмкін есінен танып жатқан шығар...
Dialogue: 0,0:06:54.68,0:06:56.61,Default,,0,0,0,,Қай жері ауырады? жоқ па?
Dialogue: 0,0:06:56.61,0:06:59.61,Default,,0,0,0,,Менің тобығым...
Dialogue: 0,0:07:01.25,0:07:03.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.12,0:07:08.66,Default,,0,0,0,,Мэтью! Энн! ➡
Dialogue: 0,0:07:08.66,0:07:11.19,Default,,0,0,0,,Энн! Не болды?
Dialogue: 0,0:07:11.19,0:07:13.19,Default,,0,0,0,,Менің қорамның төбесінен құлаған сияқты.
Dialogue: 0,0:07:13.19,0:07:15.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.20,0:07:18.67,Default,,0,0,0,,Жарайды, Марилла. Мен аздап жеңілдім.
Dialogue: 0,0:07:18.67,0:07:22.34,Default,,0,0,0,,А-а... Мойным сынып кете жаздады.
Dialogue: 0,0:07:22.34,0:07:25.94,Default,,0,0,0,,Ендеше заттардың жақсы жақтарын қарастырайық.
Dialogue: 0,0:07:25.94,0:07:30.48,Default,,0,0,0,,Ал... Әйтеуір, үйге кір! Мен дәрігер шақыруым керек!
Dialogue: 0,0:07:30.48,0:07:34.25,Default,,0,0,0,,Анна? Энн⁉ Энн!
Dialogue: 0,0:07:34.25,0:07:36.32,Default,,0,0,0,,Менің тобығым сынды.
Dialogue: 0,0:07:36.32,0:07:39.69,Default,,0,0,0,,6 апта демалыңыз.
Dialogue: 0,0:07:39.69,0:07:43.56,Default,,0,0,0,,Абайлаңыз. көп рахмет.
Dialogue: 0,0:07:43.56,0:07:47.90,Default,,0,0,0,,Эй, мен жеткілікті жазаландым➡
Dialogue: 0,0:07:47.90,0:07:50.70,Default,,0,0,0,,Өтінемін, көп ұрыспа.
Dialogue: 0,0:07:50.70,0:07:53.27,Default,,0,0,0,,Сіз мені аяйсыз ба?
Dialogue: 0,0:07:53.27,0:07:57.81,Default,,0,0,0,,Мүмкін бұл менің кінәм шығар. Бірақ Марилла ше?
Dialogue: 0,0:07:57.81,0:08:01.21,Default,,0,0,0,,Егер сізге төбеде жүру бұйырылған болса.
Dialogue: 0,0:08:01.21,0:08:04.55,Default,,0,0,0,,Мен болсам, мен жерде тұрар едім ➡
Dialogue: 0,0:08:04.55,0:08:06.51,Default,,0,0,0,,Мен өзіме бұйрық беремін.
Dialogue: 0,0:08:06.51,0:08:09.75,Default,,0,0,0,,Хехе, 6 апта бойы осылай бол.
Dialogue: 0,0:08:09.75,0:08:12.69,Default,,0,0,0,,Менде қиял бар екеніне қуаныштымын.
Dialogue: 0,0:08:12.69,0:08:15.89,Default,,0,0,0,,Бұл өте пайдалы болатынына сенімдімін.
Dialogue: 0,0:08:15.89,0:08:20.33,Default,,0,0,0,,Қиялы жоқ адамның тобығы сынғанда➡
Dialogue: 0,0:08:20.33,0:08:22.93,Default,,0,0,0,,Мен не істеуім керек деп ойлаймын...
Dialogue: 0,0:08:26.10,0:08:28.47,Default,,0,0,0,,＜Одан кейін төсек тартып жатқан күндерім➡
Dialogue: 0,0:08:28.47,0:08:31.27,Default,,0,0,0,,Бұл өте жағымды емес еді...> (Рейчел Линд) Энн! аа….
Dialogue: 0,0:08:31.27,0:08:33.91,Default,,0,0,0,,Мені шошытпа! <Дегенмен, жақсы нәрселер болды>
Dialogue: 0,0:08:33.91,0:08:36.54,Default,,0,0,0,,Энн, көңіл-күйің қалай? <Бәріне ұнамды болу➡
Dialogue: 0,0:08:36.54,0:08:38.91,Default,,0,0,0,,Не білдім: Сен үшін бәрі уайымдады.
Dialogue: 0,0:08:38.91,0:08:41.28,Default,,0,0,0,,Кішкентай ана, бұл менің кінәм!
Dialogue: 0,0:08:41.28,0:08:43.65,Default,,0,0,0,,Мен тапсырыстарды ойнай бастадым!
Dialogue: 0,0:08:43.65,0:08:47.02,Default,,0,0,0,,Мен саған төбеде жүруді бұйырдым...
Dialogue: 0,0:08:47.02,0:08:49.96,Default,,0,0,0,,Өтінемін, бұдан былай Эннге ұрыспа!
Dialogue: 0,0:08:49.96,0:08:53.46,Default,,0,0,0,,Ұрысқың келсе, ұрыс! Уф!
Dialogue: 0,0:08:53.46,0:08:58.07,Default,,0,0,0,,Анна, сен бұл балалардың бойына не сіңірдің?
Dialogue: 0,0:08:58.07,0:09:00.00,Default,,0,0,0,,Джажан!
Dialogue: 0,0:09:00.00,0:09:03.64,Default,,0,0,0,,Жарайды... бұл мүмкін...! Миссис Морганның жаңа кітабы!
Dialogue: 0,0:09:03.64,0:09:09.24,Default,,0,0,0,,Соңында таң қалдыратын бұрылыс бар. Бұл қызық!
Dialogue: 0,0:09:09.24,0:09:13.11,Default,,0,0,0,,Диана маған күнде келеді, мен қалағанымша кітап оқи аламын.
Dialogue: 0,0:09:13.11,0:09:15.92,Default,,0,0,0,,Төсекке таңылғанның бәрі жаман емес.
Dialogue: 0,0:09:15.92,0:09:20.72,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жаңа семестр басталса да.
Dialogue: 0,0:09:20.72,0:09:23.63,Default,,0,0,0,,Айтпақшы, жаңа мұғаліміңіз қалай?
Dialogue: 0,0:09:23.63,0:09:28.53,Default,,0,0,0,,Профессор Стейси. Менде мұндай мейірімді, тамаша ұстаз болған емес.
Dialogue: 0,0:09:28.53,0:09:31.07,Default,,0,0,0,,Қандай әдемі ақшыл шаш➡
Dialogue: 0,0:09:31.07,0:09:34.27,Default,,0,0,0,,Оның көздері де жарқырап тұр, бұл керемет!
Dialogue: 0,0:09:34.27,0:09:38.14,Default,,0,0,0,,Әр адам екі аптада бір тақпақ айтады!
Dialogue: 0,0:09:38.14,0:09:41.04,Default,,0,0,0,,Орманға барып, гүлдер мен құстарды зерттеңіз➡
Dialogue: 0,0:09:41.04,0:09:43.95,Default,,0,0,0,,Таңертең және кешке гимнастикамен айналысамын.
Dialogue: 0,0:09:43.95,0:09:46.25,Default,,0,0,0,,Сіз мұндай мұғалімді көрдіңіз бе?
Dialogue: 0,0:09:46.25,0:09:48.58,Default,,0,0,0,,Энн Төбеден құлап кетсем де➡
Dialogue: 0,0:09:48.58,0:09:52.85,Default,,0,0,0,,Сенің тіліңе зияны тимегеніне сенімдімін.
Dialogue: 0,0:09:52.85,0:09:55.22,Default,,0,0,0,,Хэхе! Хехе.
Dialogue: 0,0:09:55.22,0:09:59.13,Default,,0,0,0,,(Диана мен Аннаның күлкілері)
Dialogue: 0,0:09:59.13,0:10:04.13,Default,,0,0,0,,♬～
Dialogue: 0,0:10:07.50,0:10:10.41,Default,,0,0,0,,Мен бұл өлеңді жаттап алуға бара жатырмын.
Dialogue: 0,0:10:10.41,0:10:13.14,Default,,0,0,0,,Һмм.
Dialogue: 0,0:10:13.14,0:10:18.95,Default,,0,0,0,,♬～
Dialogue: 0,0:10:18.95,0:10:21.52,Default,,0,0,0,,Баршаңызға қайырлы таң.
Dialogue: 0,0:10:21.52,0:10:23.49,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:10:23.49,0:10:26.49,Default,,0,0,0,,Дұрыс? Бұл өте әдемі, солай емес пе? Иә.
Dialogue: 0,0:10:26.49,0:10:32.49,Default,,0,0,0,,Бүгіннен бастап Энн Ширли аяғы жарақатынан айыққан соң мектепке қайта оралды.
Dialogue: 0,0:10:32.49,0:10:35.16,Default,,0,0,0,,Танысқаныма қуаныштымын, Энн. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:10:35.16,0:10:38.07,Default,,0,0,0,,Иә! рақмет сізге!
Dialogue: 0,0:10:38.07,0:10:42.00,Default,,0,0,0,,♬～
Dialogue: 0,0:10:42.00,0:10:44.24,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:10:44.24,0:10:46.98,Default,,0,0,0,,Мұның бәрін сіз жасадыңыз ба? Бұл дұрыс.
Dialogue: 0,0:10:46.98,0:10:49.31,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:49.31,0:10:52.88,Default,,0,0,0,,Мен де әркімнің бұйрығын орындаймын. Келіңіздер, көріңіздер.
Dialogue: 0,0:10:52.88,0:10:57.02,Default,,0,0,0,,Иә! (3 адам) Itadakimasu!
Dialogue: 0,0:10:57.02,0:10:59.92,Default,,0,0,0,,Дәмді! Ұстаз, менікі де болсын!
Dialogue: 0,0:10:59.92,0:11:01.92,Default,,0,0,0,,Менікі де!
Dialogue: 0,0:11:01.92,0:11:04.26,Default,,0,0,0,,Олай болса, оны қабылдаңыз.
Dialogue: 0,0:11:04.26,0:11:08.60,Default,,0,0,0,,♬～
Dialogue: 0,0:11:08.60,0:11:12.27,Default,,0,0,0,,А... Иә? Стейси мырза ше?
Dialogue: 0,0:11:12.27,0:11:14.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:16.47,0:11:18.57,Default,,0,0,0,,Иә! Хехе.
Dialogue: 0,0:11:18.57,0:11:20.51,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:11:20.51,0:11:22.58,Default,,0,0,0,,Осымен бүгінгі сабақ аяқталды➡
Dialogue: 0,0:11:22.58,0:11:24.98,Default,,0,0,0,,Менің ұсынысым бар. ➡
Dialogue: 0,0:11:24.98,0:11:28.72,Default,,0,0,0,,Осы Рождествода бәріміз концерт қояйық➡
Dialogue: 0,0:11:28.72,0:11:32.22,Default,,0,0,0,,Неліктен түскен қаражатты мектеп туын жасауға жұмсамасқа?
Dialogue: 0,0:11:32.22,0:11:34.82,Default,,0,0,0,,Бұл мектепте жалау жоқ, солай ма?
Dialogue: 0,0:11:34.82,0:11:38.59,Default,,0,0,0,,Сонымен қатар, концертте бәріміздің көңілді болатынымызға сенімдімін.
Dialogue: 0,0:11:38.59,0:11:41.83,Default,,0,0,0,,Менің ойымша, бұл өте жақсы! Бұл, әрине, жақсы!
Dialogue: 0,0:11:41.83,0:11:43.83,Default,,0,0,0,,Мен оны көргім келеді! (Фред Райт) Мен де!
Dialogue: 0,0:11:43.83,0:11:48.60,Default,,0,0,0,,Хехе, енді бағдарламаны шешейік.
Dialogue: 0,0:11:48.60,0:11:50.61,Default,,0,0,0,,Уау...!
Dialogue: 0,0:11:50.61,0:11:53.47,Default,,0,0,0,,Мен Стейси мырзаны жақсы көремін!
Dialogue: 0,0:11:53.47,0:11:57.31,Default,,0,0,0,,Даусың да өте әдемі. Менің атымды атасаңыз да➡
Dialogue: 0,0:11:57.31,0:12:01.32,Default,,0,0,0,,Соңындағы «е» әрпін дұрыс жазғандай болдым.
Dialogue: 0,0:12:01.32,0:12:03.59,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:03.59,0:12:06.55,Default,,0,0,0,,Сонымен, мен сол Рождестволық концертте болдым➡
Dialogue: 0,0:12:06.55,0:12:08.99,Default,,0,0,0,,Өлең оқуым керек еді!
Dialogue: 0,0:12:08.99,0:12:10.99,Default,,0,0,0,,Оқуға кеткен уақыт➡
Dialogue: 0,0:12:10.99,0:12:13.76,Default,,0,0,0,,Бұл босқа кетпейді деп үміттенемін. ➡
Dialogue: 0,0:12:13.76,0:12:15.70,Default,,0,0,0,,Егер сізде осындай уақыт болса➡
Dialogue: 0,0:12:15.70,0:12:19.57,Default,,0,0,0,,Неліктен сіз жақсы емес математикалық есептерді мүмкіндігінше шешпейсіз? ➡
Dialogue: 0,0:12:19.57,0:12:21.97,Default,,0,0,0,,Мен үшін концерт жоқ➡
Dialogue: 0,0:12:21.97,0:12:24.87,Default,,0,0,0,,Бұл бос сөз сияқты.
Dialogue: 0,0:12:24.87,0:12:28.08,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:12:30.11,0:12:32.21,Default,,0,0,0,,Хмф! (ағаштың жарылған дыбысы)
Dialogue: 0,0:12:35.92,0:12:38.15,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:12:38.15,0:12:43.73,Default,,0,0,0,,Бұл өте жақсы концерт болады.
Dialogue: 0,0:12:43.73,0:12:46.09,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:12:46.09,0:12:49.06,Default,,0,0,0,,Энн, сен өз рөліңді ойнайсың➡
Dialogue: 0,0:12:49.06,0:12:52.83,Default,,0,0,0,,Мен сенің жақсы жұмыс жасайтыныңа сенімдімін.
Dialogue: 0,0:12:52.83,0:12:55.74,Default,,0,0,0,,Хехе, рахмет сізге Мэтью.
Dialogue: 0,0:12:55.74,0:12:58.31,Default,,0,0,0,,Хехе.
Dialogue: 0,0:12:58.31,0:13:00.24,Default,,0,0,0,,(ағаштың жарылған дыбысы)
Dialogue: 0,0:13:00.24,0:13:02.24,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:13:02.24,0:13:04.78,Default,,0,0,0,,⚟“Менің туған жерімнің сағыныш бұлағы!➡
Dialogue: 0,0:13:04.78,0:13:07.68,Default,,0,0,0,,Батысқа тараған жабайы күңкіл».
Dialogue: 0,0:13:07.68,0:13:10.22,Default,,0,0,0,,Керемет Анна!
Dialogue: 0,0:13:10.22,0:13:12.69,Default,,0,0,0,,Хмм?
Dialogue: 0,0:13:12.69,0:13:16.46,Default,,0,0,0,,Ойланып көрші, Энн концерт күні не киеді?
Dialogue: 0,0:13:16.46,0:13:19.46,Default,,0,0,0,,Не? Мен мұны киемін.
Dialogue: 0,0:13:19.46,0:13:21.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:25.17,0:13:28.97,Default,,0,0,0,,Жүрек үні Ах! Жеңі шықпайтын жалғыз Анн емес пе?
Dialogue: 0,0:13:32.61,0:13:34.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:34.54,0:13:36.58,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:13:36.58,0:13:39.21,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:13:39.21,0:13:44.92,Default,,0,0,0,,Сонымен... Бұл... Йофу... Тырма...
Dialogue: 0,0:13:44.92,0:13:49.16,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:49.16,0:13:52.69,Default,,0,0,0,,Ах…. (Сатушы) Сізге тағы бір нәрсе керек пе?
Dialogue: 0,0:13:52.69,0:13:57.60,Default,,0,0,0,,Олай болса... бұл... ➡
Dialogue: 0,0:13:57.60,0:13:59.60,Default,,0,0,0,,Шөп ....
Dialogue: 0,0:13:59.60,0:14:02.77,Default,,0,0,0,,Мен шөп тұқымын көктемде ғана саламын...
Dialogue: 0,0:14:02.77,0:14:05.74,Default,,0,0,0,,А, солай ма? Ал... сонда...
Dialogue: 0,0:14:05.74,0:14:08.71,Default,,0,0,0,,Бұл ақша! Ааа...! ➡
Dialogue: 0,0:14:08.71,0:14:11.41,Default,,0,0,0,,Бұл дөрекі!
Dialogue: 0,0:14:13.25,0:14:15.18,Default,,0,0,0,,Бұл…. иә!
Dialogue: 0,0:14:15.18,0:14:18.99,Default,,0,0,0,,Егер... сізді алаңдатпаса...➡
Dialogue: 0,0:14:18.99,0:14:21.89,Default,,0,0,0,,Бұл… сәл ғана…➡
Dialogue: 0,0:14:21.89,0:14:23.86,Default,,0,0,0,,Йо…и….
Dialogue: 0,0:14:23.86,0:14:27.70,Default,,0,0,0,,Бұл қоңыр қант емес.
Dialogue: 0,0:14:27.70,0:14:32.10,Default,,0,0,0,,Мен қорада айырдың көп екеніне сенімдімін.
Dialogue: 0,0:14:32.10,0:14:34.30,Default,,0,0,0,,Бұл босқа кетпейді.
Dialogue: 0,0:14:37.27,0:14:40.17,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:14:40.17,0:14:44.78,Default,,0,0,0,,Аннаның киімі? Мен Марилладан сұрай алмаймын...
Dialogue: 0,0:14:44.78,0:14:49.28,Default,,0,0,0,,Сонымен, сіз оны жасағанда, сізде тапсырыс бар ма?
Dialogue: 0,0:14:49.28,0:14:52.02,Default,,0,0,0,,Сонымен... жеңдер….
Dialogue: 0,0:14:52.02,0:14:56.32,Default,,0,0,0,,Ол кеңейеді, солай ма? Бұл арзан! о!
Dialogue: 0,0:14:58.29,0:15:00.23,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:15:00.23,0:15:03.43,Default,,0,0,0,,Хаха. иә?
Dialogue: 0,0:15:07.57,0:15:10.51,Default,,0,0,0,,Сіз тапсырыс берген зат аяқталды.
Dialogue: 0,0:15:10.51,0:15:12.51,Default,,0,0,0,,Тапсырыс? Ах!
Dialogue: 0,0:15:12.51,0:15:14.94,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:14.94,0:15:17.78,Default,,0,0,0,,Сонымен, Мэтью соңғы екі апта бойы осында болды➡
Dialogue: 0,0:15:17.78,0:15:21.65,Default,,0,0,0,,Өздігінен күлді.
Dialogue: 0,0:15:21.65,0:15:24.55,Default,,0,0,0,,♬～
Dialogue: 0,0:15:24.55,0:15:26.55,Default,,0,0,0,,Рождество мерекесімен! Марилла!
Dialogue: 0,0:15:26.55,0:15:29.16,Default,,0,0,0,,Рождество мерекесімен! Мэтью!
Dialogue: 0,0:15:29.16,0:15:34.30,Default,,0,0,0,,Қар жауған керемет ақ Рождество!
Dialogue: 0,0:15:34.30,0:15:36.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:36.93,0:15:39.23,Default,,0,0,0,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:15:41.17,0:15:43.77,Default,,0,0,0,,Энн Бұл... не?
Dialogue: 0,0:15:43.77,0:15:48.08,Default,,0,0,0,,Маған бересің бе? Өтінемін, ашыңыз.
Dialogue: 0,0:15:49.64,0:15:53.18,Default,,0,0,0,,(ашу дыбысы)
Dialogue: 0,0:15:53.18,0:15:54.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:54.82,0:15:59.02,Default,,0,0,0,,Сен мұны бүгін кешке концертке киюің керек.
Dialogue: 0,0:16:03.46,0:16:07.06,Default,,0,0,0,,Не болды? Сізге ұнамады ма?
Dialogue: 0,0:16:07.06,0:16:12.23,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:16:12.23,0:16:15.00,Default,,0,0,0,,О, Мэтью! О, ой...
Dialogue: 0,0:16:15.00,0:16:17.07,Default,,0,0,0,,Бұдан асқан керемет ештеңе жоқ.
Dialogue: 0,0:16:17.07,0:16:20.24,Default,,0,0,0,,Қанша алғыс айтсам да аздық етеді.
Dialogue: 0,0:16:20.24,0:16:25.21,Default,,0,0,0,,Түсімде жүргендей бақыттымын.
Dialogue: 0,0:16:25.21,0:16:30.25,Default,,0,0,0,,Энн, саған мұндай киім керек емес деп ойлаймын➡
Dialogue: 0,0:16:30.25,0:16:35.02,Default,,0,0,0,,Матай мұны мен үшін жасады. Мен оны қадірлеуім керек.
Dialogue: 0,0:16:35.02,0:16:37.06,Default,,0,0,0,,Әрине.
Dialogue: 0,0:16:37.06,0:16:40.26,Default,,0,0,0,,Мынаны жеңге киіп, бар күшімді саламын.
Dialogue: 0,0:16:40.26,0:16:43.46,Default,,0,0,0,,Сондықтан міндетті түрде келіп көріңіз. Мен сенімдімін!
Dialogue: 0,0:16:43.46,0:16:45.43,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:45.43,0:16:49.04,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:49.04,0:16:52.91,Default,,0,0,0,,Бұл Руби мен Джейннің «Ертегі ханшайымы» болды.
Dialogue: 0,0:16:52.91,0:16:54.94,Default,,0,0,0,,Сәттілік. Иә.
Dialogue: 0,0:16:54.94,0:16:58.38,Default,,0,0,0,,Одан әрі ``Қайман өзенінде'' оқылады.
Dialogue: 0,0:16:58.38,0:17:02.72,Default,,0,0,0,,Энн Ширли өтінемін. (қол шапалақтау)
Dialogue: 0,0:17:02.72,0:17:09.62,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:16.26,0:17:18.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:22.47,0:17:25.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.21,0:17:27.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.98,0:17:31.85,Default,,0,0,0,,♬～
Dialogue: 0,0:17:31.85,0:17:34.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:39.92,0:17:43.36,Default,,0,0,0,,Сот… га….
Dialogue: 0,0:17:43.36,0:17:46.76,Default,,0,0,0,,«Менің туған жерімнің сағыныш бұлағы!➡
Dialogue: 0,0:17:46.76,0:17:51.20,Default,,0,0,0,,Батысқа тараған жабайы шу! ➡
Dialogue: 0,0:17:51.20,0:17:56.40,Default,,0,0,0,,Саған тақтай, Сұр тал тізілген жаға➡
Dialogue: 0,0:17:56.40,0:18:00.98,Default,,0,0,0,,Өзен арнасындағы құм әртүрлі реңктегі жолақтар түзеді➡
Dialogue: 0,0:18:00.98,0:18:05.21,Default,,0,0,0,,Мөлдір жарқырауың арқылы жарқырайды! ➡
Dialogue: 0,0:18:05.21,0:18:08.05,Default,,0,0,0,,Менің өмірімнің траекториясында➡
Dialogue: 0,0:18:08.05,0:18:12.75,Default,,0,0,0,,Менің балалық шағымның жарқын көрінісі! ➡
Dialogue: 0,0:18:12.75,0:18:17.09,Default,,0,0,0,,Жалғыздық үлкендердің жүрегін жиі жұбатасыз➡
Dialogue: 0,0:18:17.09,0:18:20.76,Default,,0,0,0,,Сағыныш сезімін оятады. ➡
Dialogue: 0,0:18:20.76,0:18:23.36,Default,,0,0,0,,Ах! Тағы да, уайымдама➡
Dialogue: 0,0:18:23.36,0:18:26.17,Default,,0,0,0,,Сол күндерге қайта оралсам ғой».
Dialogue: 0,0:18:28.04,0:18:41.58,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:41.58,0:18:44.79,Default,,0,0,0,,О, Энн! Бұл керемет болды!
Dialogue: 0,0:18:44.79,0:18:47.12,Default,,0,0,0,,үшінна рахмет.
Dialogue: 0,0:18:47.12,0:18:51.46,Default,,0,0,0,,Келесі кезекте Диана Берли айтатын «Арал гимні».
Dialogue: 0,0:18:51.46,0:18:54.80,Default,,0,0,0,,Не істеуім керек... Мен қатты қобалжыдым.
Dialogue: 0,0:18:54.80,0:18:57.13,Default,,0,0,0,,Сен осылай жақсы ән айта аласың ба?
Dialogue: 0,0:18:57.13,0:19:00.84,Default,,0,0,0,,Ондай жағдайда аудиториядан әкеңізді немесе анаңызды табыңыз.
Dialogue: 0,0:19:00.84,0:19:02.77,Default,,0,0,0,,Бұл сізді қатты тыныштандыруы керек.
Dialogue: 0,0:19:02.77,0:19:07.17,Default,,0,0,0,,Жоқ! Аудиториядағы адамдарды көргенде одан сайын қобалжыймын.
Dialogue: 0,0:19:07.17,0:19:09.11,Default,,0,0,0,,Олай болса маған қара.
Dialogue: 0,0:19:09.11,0:19:11.08,Default,,0,0,0,,Себебі мен алдыңғы орындықтамын➡
Dialogue: 0,0:19:11.08,0:19:13.08,Default,,0,0,0,,Мен оны көріп тұрмын, солай ма?
Dialogue: 0,0:19:14.95,0:19:18.19,Default,,0,0,0,,Жақсы ма? Тек маған қарап ән айт.
Dialogue: 0,0:19:18.19,0:19:21.69,Default,,0,0,0,,Иә, мен жасап көремін. Бұл нәтиже беретініне сенімдімін.
Dialogue: 0,0:19:28.43,0:19:30.87,Default,,0,0,0,,үшін жақсы өтті, солай ма?
Dialogue: 0,0:19:30.87,0:19:34.80,Default,,0,0,0,,Иә. Менің ойымша, біз 10 доллар жинадық.
Dialogue: 0,0:19:34.80,0:19:38.34,Default,,0,0,0,,Мен Диананың әнін айтып отырмын.
Dialogue: 0,0:19:38.34,0:19:41.94,Default,,0,0,0,,Бізге еңсерген кезде мен де мақтандым.
Dialogue: 0,0:19:41.94,0:19:44.45,Default,,0,0,0,,Еске алу (қол шапалақтау) Мені қазір қатты мақтап жатыр➡
Dialogue: 0,0:19:44.45,0:19:47.95,Default,,0,0,0,,Ол менің ең қымбат сырласым.
Dialogue: 0,0:19:47.95,0:19:49.92,Default,,0,0,0,,үшін Аннаға рахмет.
Dialogue: 0,0:19:49.92,0:19:52.35,Default,,0,0,0,,Себебі Энн мені дұрыс бақылап отырды.
Dialogue: 0,0:19:52.35,0:19:56.16,Default,,0,0,0,,Сіз ол кезде менімен бірдеңе туралы сөйлесетінсіз.
Dialogue: 0,0:19:57.89,0:20:00.13,Default,,0,0,0,,Онда не айтылды?
Dialogue: 0,0:20:00.13,0:20:02.23,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:04.60,0:20:06.60,Default,,0,0,0,,Еске алу Ах!
Dialogue: 0,0:20:11.14,0:20:13.71,Default,,0,0,0,,«Жарайды».
Dialogue: 0,0:20:13.71,0:20:18.55,Default,,0,0,0,,Менің ойымша, ол: «Ештеңе емес» деді.
Dialogue: 0,0:20:18.55,0:20:20.48,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:20:20.48,0:20:23.25,Default,,0,0,0,,«Мүмкін»? "Жарайды" дегенді түсінемін, бірақ➡
Dialogue: 0,0:20:23.25,0:20:28.72,Default,,0,0,0,,Өзіңіз айтыңыз «Мүмкін» нені білдіреді? Мүмкін болғандықтан шығар.
Dialogue: 0,0:20:28.72,0:20:31.69,Default,,0,0,0,,Мүмкін...➡ туралы айтатын болсақ
Dialogue: 0,0:20:31.69,0:20:34.40,Default,,0,0,0,,Сахнаға шығар алдында...
Dialogue: 0,0:20:34.40,0:20:36.50,Default,,0,0,0,,Эннді еске түсіру?
Dialogue: 0,0:20:38.27,0:20:40.70,Default,,0,0,0,,Еденде тұрған раушан➡
Dialogue: 0,0:20:40.70,0:20:42.64,Default,,0,0,0,,Гилберт оны көтеріп жатты.
Dialogue: 0,0:20:42.64,0:20:46.51,Default,,0,0,0,,Не? Бұл Энннің шашына киген раушан гүлі болса керек.
Dialogue: 0,0:20:46.51,0:20:51.15,Default,,0,0,0,,А... Маған ол кісінің не істейтіні бәрібір.
Dialogue: 0,0:20:51.15,0:20:53.08,Default,,0,0,0,,Күте тұрыңыз, Энн!
Dialogue: 0,0:20:53.08,0:20:57.05,Default,,0,0,0,,Менің ойымша, Гилберт...
Dialogue: 0,0:20:57.05,0:21:01.36,Default,,0,0,0,,Менің Аннам керемет жұмыс жасады.
Dialogue: 0,0:21:01.36,0:21:06.86,Default,,0,0,0,,Иә. Мен бұған қарсы болдым, бірақ Энн бүгін кешке тамаша жұмыс жасады.
Dialogue: 0,0:21:06.86,0:21:11.23,Default,,0,0,0,,Ол бала біз ойлағаннан да ақылды.
Dialogue: 0,0:21:11.23,0:21:17.61,Default,,0,0,0,,Иә. Avonlea мектебі енді жеткіліксіз болуы мүмкін.
Dialogue: 0,0:21:17.61,0:21:20.07,Default,,0,0,0,,Күн көру қиын болса да➡
Dialogue: 0,0:21:20.07,0:21:22.04,Default,,0,0,0,,Сол бала қаласа➡
Dialogue: 0,0:21:22.04,0:21:26.28,Default,,0,0,0,,Мен сізге көмектескім келеді, бірақ...
Dialogue: 0,0:21:26.28,0:21:30.72,Default,,0,0,0,,Бауырым, ол балаға біздің ең жақсы ісіміз➡
Dialogue: 0,0:21:30.72,0:21:35.09,Default,,0,0,0,,Оны Королева академиясына қою туралы не айтасыз?
Dialogue: 0,0:21:35.09,0:21:38.83,Default,,0,0,0,,Хмм... Дұрыс➡
Dialogue: 0,0:21:38.83,0:21:41.50,Default,,0,0,0,,Бұл мүмкін ➡
Dialogue: 0,0:21:41.50,0:21:44.06,Default,,0,0,0,,Бұл қуанышты нәрсе.
Dialogue: 0,0:21:44.06,0:21:47.70,Default,,0,0,0,,Рейчел көйлекті ұзартып қойды➡
Dialogue: 0,0:21:47.70,0:21:52.17,Default,,0,0,0,,Анна бүгін кешке өте ұзын көрінді.
Dialogue: 0,0:21:52.17,0:21:55.04,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:55.04,0:21:58.95,Default,,0,0,0,,♬～
Dialogue: 0,0:21:58.95,0:22:01.65,Default,,0,0,0,,Хехе.
Dialogue: 0,0:22:05.62,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
