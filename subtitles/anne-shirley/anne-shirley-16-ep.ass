Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.20,0:00:07.04,Default,,0,0,0,,<Осы жаз тамаша оқиғаларға толы болды. ➡
Dialogue: 0,0:00:07.04,0:00:11.87,Default,,0,0,0,,Лаванда мырзаның үйлену тойы Диананың құда түсуі. ➡
Dialogue: 0,0:00:11.87,0:00:14.51,Default,,0,0,0,,Ал мен➡
Dialogue: 0,0:00:14.51,0:00:18.38,Default,,0,0,0,,Мен Редмонд университетіне барамын＞
Dialogue: 0,0:00:18.38,0:00:24.69,Default,,0,0,0,,♬～
Dialogue: 0,0:00:24.69,0:00:27.19,Default,,0,0,0,,Ах.
Dialogue: 0,0:00:29.52,0:00:31.79,Default,,0,0,0,,Ах...хехе.
Dialogue: 0,0:00:31.79,0:00:33.73,Default,,0,0,0,,Присцилла Гранттан.
Dialogue: 0,0:00:33.73,0:00:36.23,Default,,0,0,0,,Ол да Редмондқа келеді.
Dialogue: 0,0:00:36.23,0:00:39.64,Default,,0,0,0,,Біз бірге тұруды шештік.
Dialogue: 0,0:00:39.64,0:00:41.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:41.57,0:00:45.01,Default,,0,0,0,,Редмондтағы барлық профессорлар топ-тобымен шақырса да➡
Dialogue: 0,0:00:45.01,0:00:48.84,Default,,0,0,0,,Присси осында болғанша мен өзімді қауіпсіз сезінемін. Жарайсың.
Dialogue: 0,0:00:48.84,0:00:52.71,Default,,0,0,0,,Кингспортты бәріміз жақсы көреміз деп ойлаймын.
Dialogue: 0,0:00:52.71,0:00:55.32,Default,,0,0,0,,Көңілді ескі қалада➡
Dialogue: 0,0:00:55.32,0:00:57.82,Default,,0,0,0,,Керемет табиғи саябақ бар.
Dialogue: 0,0:00:57.82,0:01:01.36,Default,,0,0,0,,Бұл қызық. Дұрыс па?
Dialogue: 0,0:01:01.36,0:01:04.93,Default,,0,0,0,,Бірақ... мұндағыдан әдемірек пе?
Dialogue: 0,0:01:04.93,0:01:06.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:06.86,0:01:09.83,Default,,0,0,0,,Мынадан да әдемі болар ма екен...
Dialogue: 0,0:01:09.83,0:01:13.67,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:01:13.67,0:01:27.12,Default,,0,0,0,,♬～
Dialogue: 0,0:01:27.12,0:01:31.62,Default,,0,0,0,,Сен тынышсыз, Энн.
Dialogue: 0,0:01:31.62,0:01:35.09,Default,,0,0,0,,Энн? Тыныштықты қазір бұзсам➡
Dialogue: 0,0:01:35.09,0:01:37.63,Default,,0,0,0,,Бұл таңғажайып сұлулық➡
Dialogue: 0,0:01:37.63,0:01:40.93,Default,,0,0,0,,Жоғалып кетуі мүмкін деп ойладым...➡
Dialogue: 0,0:01:40.93,0:01:43.03,Default,,0,0,0,,Мен қозғала алмаймын...
Dialogue: 0,0:01:45.50,0:01:47.44,Default,,0,0,0,,Ах...!
Dialogue: 0,0:01:47.44,0:01:50.14,Default,,0,0,0,,Анна….
Dialogue: 0,0:01:50.14,0:01:53.84,Default,,0,0,0,,Ах…. Мен үйге баруым керек.
Dialogue: 0,0:01:53.84,0:01:56.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:56.51,0:01:59.35,Default,,0,0,0,,Жүрегімде дауыс: Гилберт осылай жалғаса берсе➡
Dialogue: 0,0:01:59.35,0:02:03.35,Default,,0,0,0,,Достығымыз бұзылады...
Dialogue: 0,0:02:03.35,0:02:06.02,Default,,0,0,0,,Менің досымның анасы➡
Dialogue: 0,0:02:06.02,0:02:08.49,Default,,0,0,0,,Энн әпкесі университетке барады➡
Dialogue: 0,0:02:08.49,0:02:11.16,Default,,0,0,0,,Тіпті барып адам алу үшін.
Dialogue: 0,0:02:11.16,0:02:13.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:13.10,0:02:16.97,Default,,0,0,0,,Жоқ! Мен оқып, ересек адам боламын➡
Dialogue: 0,0:02:16.97,0:02:19.23,Default,,0,0,0,,Мен әртүрлі нәрселерді үйренемін.
Dialogue: 0,0:02:19.23,0:02:23.11,Default,,0,0,0,,Бірақ, бірақ, егер Энн апа еркекті ұстағысы келсе➡
Dialogue: 0,0:02:23.11,0:02:27.28,Default,,0,0,0,,Мұны қалай жасайсыз? Мен білгім келеді!
Dialogue: 0,0:02:27.28,0:02:31.71,Default,,0,0,0,,Дэви Ұйықтау уақыты келді. (Дэви) Эй.
Dialogue: 0,0:02:31.71,0:02:40.39,Default,,0,0,0,,♬～
Dialogue: 0,0:02:40.39,0:02:45.03,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:45.03,0:02:47.50,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:47.50,0:02:49.46,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:49.46,0:02:53.30,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:53.30,0:02:55.74,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:55.74,0:02:57.81,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:57.81,0:03:02.38,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:03:02.38,0:03:07.58,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін.»
Dialogue: 0,0:03:07.58,0:03:09.55,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:03:09.55,0:03:13.46,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:03:13.46,0:03:16.79,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:03:16.79,0:03:19.26,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:03:19.26,0:03:21.50,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:03:21.50,0:03:25.80,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:03:25.80,0:03:28.24,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:03:28.24,0:03:30.57,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:03:30.57,0:03:34.04,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:03:34.04,0:03:37.31,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:03:37.31,0:03:39.61,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:03:39.61,0:03:43.82,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:43.82,0:03:46.32,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:03:46.32,0:03:48.62,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:48.62,0:03:50.69,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:50.69,0:03:55.03,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:55.03,0:03:58.93,Default,,0,0,0,,♬～
Dialogue: 0,0:04:01.47,0:04:05.07,Default,,0,0,0,,♬～
Dialogue: 0,0:04:06.94,0:04:09.01,Default,,0,0,0,,Avonlea жақсарту қоғамының негізін қалаушы➡
Dialogue: 0,0:04:09.01,0:04:11.18,Default,,0,0,0,,Анна мен Гилбертке➡
Dialogue: 0,0:04:11.18,0:04:13.45,Default,,0,0,0,,Бұл бізден келген сыйлық. (қол шапалақтау)
Dialogue: 0,0:04:13.45,0:04:16.25,Default,,0,0,0,,Сәттілік. (Джози Пай) Сәттілік.
Dialogue: 0,0:04:16.25,0:04:20.12,Default,,0,0,0,,Біз бұл жақсарту тобын дұрыс қабылдаймыз➡
Dialogue: 0,0:04:20.12,0:04:23.39,Default,,0,0,0,,Жан тыныштығымен жақсы оқыңыз.
Dialogue: 0,0:04:23.39,0:04:25.33,Default,,0,0,0,,Сізді жоғары оқу орнына түсуіңізбен құттықтаймыз.
Dialogue: 0,0:04:25.33,0:04:27.56,Default,,0,0,0,,Құттықтаймыз! (қол шапалақтау)
Dialogue: 0,0:04:27.56,0:04:29.53,Default,,0,0,0,,Сау болыңыз! (Moody Spurgeon McPherson) Сау болыңыз!
Dialogue: 0,0:04:29.53,0:04:32.00,Default,,0,0,0,,Сәттілік! Мен сені сағынамын. (қол шапалақтау)
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:04:36.37,0:04:38.34,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:38.34,0:04:41.04,Default,,0,0,0,,Бұл жақсы түн. Ах...
Dialogue: 0,0:04:41.04,0:04:43.61,Default,,0,0,0,,Біз үшін өз жолыңыздан шығыңыз.
Dialogue: 0,0:04:43.61,0:04:48.45,Default,,0,0,0,,Рахмет. Бұл дұрыс. Олар тамаша достар.
Dialogue: 0,0:04:48.45,0:04:51.89,Default,,0,0,0,,Анна…. а…. Кешегі үшін кешірім сұраймын.
Dialogue: 0,0:04:51.89,0:04:54.12,Default,,0,0,0,,Бұл біз туралы ...
Dialogue: 0,0:04:54.12,0:04:56.09,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:56.09,0:04:59.69,Default,,0,0,0,,Ондай әңгіме... Дәл қазір естігім келмейді...
Dialogue: 0,0:05:06.33,0:05:08.87,Default,,0,0,0,,Гилберт Үйге бірге барайық. Ах...
Dialogue: 0,0:05:08.87,0:05:14.14,Default,,0,0,0,,А-а-а... Мен сені қуана-қуана ертіп аламын.
Dialogue: 0,0:05:14.14,0:05:16.11,Default,,0,0,0,,Иә! Ахаха!
Dialogue: 0,0:05:16.11,0:05:18.88,Default,,0,0,0,,Энн сені сонда жіберуім керек пе? сурет?
Dialogue: 0,0:05:18.88,0:05:21.78,Default,,0,0,0,,Түн болды, кеттік.
Dialogue: 0,0:05:21.78,0:05:24.79,Default,,0,0,0,,Келіңіздер. Е... иә...
Dialogue: 0,0:05:27.59,0:05:31.29,Default,,0,0,0,,Бүгінгі күн қызық болды. Бұл дұрыс...
Dialogue: 0,0:05:31.29,0:05:33.90,Default,,0,0,0,,Университетке барсақ та тату болайық.
Dialogue: 0,0:05:33.90,0:05:36.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:36.16,0:05:39.17,Default,,0,0,0,,Flashback Мен оны қазір естігім келмейді...
Dialogue: 0,0:05:41.70,0:05:46.14,Default,,0,0,0,,Бүгін қандай сыйлық алдың? Бұл дұрыс...
Dialogue: 0,0:05:46.14,0:05:49.61,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:05:49.61,0:05:54.05,Default,,0,0,0,,Қайырлы таң Марилла. Аннамен қоштас.
Dialogue: 0,0:05:54.05,0:06:00.19,Default,,0,0,0,,Менің ойымша, әйелдерге білім қажет емес.
Dialogue: 0,0:06:00.19,0:06:03.56,Default,,0,0,0,,Неге қазір оны қайта қарастырмайсың?
Dialogue: 0,0:06:03.56,0:06:06.53,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:06:06.53,0:06:10.20,Default,,0,0,0,,Сәлеметсіз бе. Анна сонда ма?
Dialogue: 0,0:06:10.20,0:06:14.07,Default,,0,0,0,,Мен Редмондта төрт жыл оқығаныма сене алар емеспін.
Dialogue: 0,0:06:14.07,0:06:16.47,Default,,0,0,0,,Бұл үлкен шығын ба?
Dialogue: 0,0:06:16.47,0:06:18.87,Default,,0,0,0,,Марилланың да жағдайы қиын.
Dialogue: 0,0:06:18.87,0:06:21.34,Default,,0,0,0,,…Иә.
Dialogue: 0,0:06:21.34,0:06:23.28,Default,,0,0,0,,Анна ше?
Dialogue: 0,0:06:23.28,0:06:25.78,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:06:25.78,0:06:28.68,Default,,0,0,0,,Kingsport➡-тен қайтқанда
Dialogue: 0,0:06:28.68,0:06:31.39,Default,,0,0,0,,Авонлеа туралы бәрі білгір тұлға➡
Dialogue: 0,0:06:31.39,0:06:34.29,Default,,0,0,0,,Мен саған менсінбей қарай бастадым деп ойламайсың ба? ➡
Dialogue: 0,0:06:34.29,0:06:36.79,Default,,0,0,0,,Мені қате түсінбеңіз. ➡
Dialogue: 0,0:06:36.79,0:06:40.10,Default,,0,0,0,,Мен мұны сен үшін айтып отырмын ба?
Dialogue: 0,0:06:44.00,0:06:45.93,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:06:45.93,0:06:48.47,Default,,0,0,0,,Бұл не? Ессіз күйде.
Dialogue: 0,0:06:48.47,0:06:52.24,Default,,0,0,0,,Біз ертең жолға шығамыз. Орау дұрыс па?
Dialogue: 0,0:06:52.24,0:06:55.24,Default,,0,0,0,,Мен мұны істеп жатырмын.
Dialogue: 0,0:06:55.24,0:06:58.58,Default,,0,0,0,,Күрсіну…. Көп. ➡
Dialogue: 0,0:06:58.58,0:07:00.52,Default,,0,0,0,,Еске алу (Көрші апа А) Маған көп рахмет➡
Dialogue: 0,0:07:00.52,0:07:02.45,Default,,0,0,0,,Әйелдерге үйрену деген жоқ➡
Dialogue: 0,0:07:02.45,0:07:05.55,Default,,0,0,0,,Бұл қажет емес деп ойлаймын.
Dialogue: 0,0:07:10.19,0:07:13.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:15.33,0:07:18.23,Default,,0,0,0,,Сол адамдар, мен Редмондқа бардым➡
Dialogue: 0,0:07:18.23,0:07:20.30,Default,,0,0,0,,Әдебиет мамандығы бойынша білім алу➡
Dialogue: 0,0:07:20.30,0:07:22.54,Default,,0,0,0,,Бұл өте ақылсыз ➡
Dialogue: 0,0:07:22.54,0:07:24.94,Default,,0,0,0,,Түсінгеніңізді қалаймын!
Dialogue: 0,0:07:24.94,0:07:26.88,Default,,0,0,0,,Сізге рахмет, мен де➡
Dialogue: 0,0:07:26.88,0:07:30.75,Default,,0,0,0,,Мен шынымен де солай деп ойлаймын...
Dialogue: 0,0:07:30.75,0:07:32.75,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:07:32.75,0:07:34.95,Default,,0,0,0,,Олар жақсы адамдар болуы керек➡
Dialogue: 0,0:07:34.95,0:07:38.59,Default,,0,0,0,,Басыңыздан өтпеген нәрсені түсіне алмайсыз.
Dialogue: 0,0:07:38.59,0:07:40.52,Default,,0,0,0,,Иә... иә!
Dialogue: 0,0:07:40.52,0:07:42.76,Default,,0,0,0,,Мен мұны түсінемін, бірақ...
Dialogue: 0,0:07:42.76,0:07:46.76,Default,,0,0,0,,Сіз Avonlea-дан университетке түскен алғашқы әйелсіз.
Dialogue: 0,0:07:46.76,0:07:51.07,Default,,0,0,0,,Барлық пионерлердің қиындықтары бар.
Dialogue: 0,0:07:53.70,0:07:57.04,Default,,0,0,0,,Жүр, Энн, менімен серуендеуге барайық.
Dialogue: 0,0:07:57.04,0:07:58.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:58.97,0:08:01.18,Default,,0,0,0,,Мен сізге бір нәрсе көрсеткім келеді.
Dialogue: 0,0:08:04.21,0:08:06.31,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:09.99,0:08:23.03,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:23.03,0:08:25.63,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:08:25.63,0:08:27.57,Default,,0,0,0,,Фалько…
Dialogue: 0,0:08:27.57,0:08:29.97,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:08:36.28,0:08:40.78,Default,,0,0,0,,Бұл алма ағашы. Сондай терең жерде...
Dialogue: 0,0:08:40.78,0:08:45.25,Default,,0,0,0,,Аа, мен көктемде таза ақ гүлдерді көп таптым.
Dialogue: 0,0:08:45.25,0:08:49.02,Default,,0,0,0,,Мен тағы келіп, алма ма, жоқ па көргім келеді.
Dialogue: 0,0:08:49.02,0:08:51.93,Default,,0,0,0,,Бұл ағаш кездейсоқ төгілген тұқымнан жасалған➡
Dialogue: 0,0:08:51.93,0:08:54.36,Default,,0,0,0,,Ол өскен болуы керек.
Dialogue: 0,0:08:54.36,0:08:59.03,Default,,0,0,0,,Мен білмейтін нәрселердің ортасында өскенім соншалық...
Dialogue: 0,0:08:59.03,0:09:02.54,Default,,0,0,0,,Бұл батыл және берік ағаш.
Dialogue: 0,0:09:02.54,0:09:07.24,Default,,0,0,0,,Мына жастықты орман тағысы деп атайық.
Dialogue: 0,0:09:07.24,0:09:09.64,Default,,0,0,0,,Орыныңызға отырыңыз.
Dialogue: 0,0:09:11.55,0:09:13.48,Default,,0,0,0,,(кеміру дыбысы)
Dialogue: 0,0:09:13.48,0:09:15.42,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:09:15.42,0:09:18.62,Default,,0,0,0,,Дәмді! Шынымен!
Dialogue: 0,0:09:18.62,0:09:21.46,Default,,0,0,0,,Тіпті Едем бағындағы тағдырлы алма➡
Dialogue: 0,0:09:21.46,0:09:24.86,Default,,0,0,0,,Мен мұндай ерекше нәрсенің дәмін татқан жоқпын деп ойлаймын.
Dialogue: 0,0:09:24.86,0:09:29.26,Default,,0,0,0,,Хаха! Бұл менің өмірімдегі ең жақсы алма болуы мүмкін.
Dialogue: 0,0:09:29.26,0:09:31.73,Default,,0,0,0,,Өзіңізді тыныш сезінесіз бе?
Dialogue: 0,0:09:31.73,0:09:34.00,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:09:34.00,0:09:36.34,Default,,0,0,0,,Бұл алма аш жанға➡
Dialogue: 0,0:09:36.34,0:09:39.67,Default,,0,0,0,,Алланың бізге берген ризығы сияқты.
Dialogue: 0,0:09:39.67,0:09:43.24,Default,,0,0,0,,Мен Редмонд университетіне ғашық болдым➡
Dialogue: 0,0:09:43.24,0:09:45.48,Default,,0,0,0,,Онда керемет төрт жыл өткізіңіз➡
Dialogue: 0,0:09:45.48,0:09:47.42,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,0:09:47.42,0:09:52.35,Default,,0,0,0,,...Осы төрт жыл өткен соң, сен не істейсің?
Dialogue: 0,0:09:52.35,0:09:56.99,Default,,0,0,0,,Мен тағы да жолдың жаңа бұрылысында тұрмын.
Dialogue: 0,0:09:56.99,0:10:02.36,Default,,0,0,0,,Мен алда не күтіп тұрғанын білмеймін. Мен тіпті білгім де келмейді.
Dialogue: 0,0:10:02.36,0:10:05.80,Default,,0,0,0,,Өйткені білмеген жақсы.
Dialogue: 0,0:10:05.80,0:10:07.77,Default,,0,0,0,,(кеміру дыбысы)
Dialogue: 0,0:10:07.77,0:10:15.91,Default,,0,0,0,,♬～
Dialogue: 0,0:10:15.91,0:10:17.85,Default,,0,0,0,,Жүрек үні Гилберт➡
Dialogue: 0,0:10:17.85,0:10:21.75,Default,,0,0,0,,Бүгінгі түндегідей бірге болу әрқашан оңай...
Dialogue: 0,0:10:21.75,0:10:24.39,Default,,0,0,0,,Жүрек үні Бұл адам➡
Dialogue: 0,0:10:24.39,0:10:26.82,Default,,0,0,0,,Мені бір күні ойлайсың деп үміттенемін➡
Dialogue: 0,0:10:26.82,0:10:29.32,Default,,0,0,0,,Бұл мүмкін емес нәрсе ме деп ойлаймын...
Dialogue: 0,0:10:32.39,0:10:37.17,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:10:37.17,0:10:41.64,Default,,0,0,0,,Не істесең де, тек денеңді күт.
Dialogue: 0,0:10:41.64,0:10:44.31,Default,,0,0,0,,Рахмет. Ана Линд те.
Dialogue: 0,0:10:44.31,0:10:46.24,Default,,0,0,0,,Ууууууууууу….
Dialogue: 0,0:10:46.24,0:10:48.18,Default,,0,0,0,,Тыныштанған кезде маған хабарлаңыз.
Dialogue: 0,0:10:48.18,0:10:50.21,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:10:50.21,0:10:53.41,Default,,0,0,0,,Мен оны бірден жазамын.
Dialogue: 0,0:10:53.41,0:10:57.75,Default,,0,0,0,,Дора. (Дора Кит) Анна әпке, сізбен келесі кезде қашан көрісеміз?
Dialogue: 0,0:10:57.75,0:11:00.59,Default,,0,0,0,,Мен Рождествода үйде боламын.
Dialogue: 0,0:11:00.59,0:11:05.19,Default,,0,0,0,,Мен сенімдімін. Сіз Дэвимен жақсы доссыз ба? Иә.
Dialogue: 0,0:11:05.19,0:11:11.00,Default,,0,0,0,,♬～
Dialogue: 0,0:11:11.00,0:11:15.20,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:11:15.20,0:11:19.14,Default,,0,0,0,,Дэви қоштасуыма рұқсат етіңіз.
Dialogue: 0,0:11:19.14,0:11:21.14,Default,,0,0,0,,Жоқ, жоқ, жоқ….
Dialogue: 0,0:11:21.14,0:11:24.05,Default,,0,0,0,,Дэви….
Dialogue: 0,0:11:24.05,0:11:26.18,Default,,0,0,0,,(Дэвидің жылауы)
Dialogue: 0,0:11:26.18,0:11:47.20,Default,,0,0,0,,♬～
Dialogue: 0,0:11:47.20,0:11:50.10,Default,,0,0,0,,(бастапқы дыбыс)
Dialogue: 0,0:11:50.10,0:11:52.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.25,0:12:02.35,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:12:05.12,0:12:09.12,Default,,0,0,0,,♬～
Dialogue: 0,0:12:10.89,0:12:12.89,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:12:12.89,0:12:15.36,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:12:15.36,0:12:17.97,Default,,0,0,0,,Бұл...➡
Dialogue: 0,0:12:17.97,0:12:19.90,Default,,0,0,0,,Kingsport!
Dialogue: 0,0:12:19.90,0:12:30.01,Default,,0,0,0,,♬～
Dialogue: 0,0:12:30.01,0:12:32.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:32.28,0:12:35.62,Default,,0,0,0,,Олай болса ертең университетте кездесейік.
Dialogue: 0,0:12:35.62,0:12:38.82,Default,,0,0,0,,Бүгін кешке демалыңыз. (Чарли) Қайырлы түн.
Dialogue: 0,0:12:38.82,0:12:41.12,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:12:43.02,0:12:45.43,Default,,0,0,0,,⚟Анн! а….
Dialogue: 0,0:12:48.33,0:12:51.23,Default,,0,0,0,,Присси! (2 адам) Ахахха!
Dialogue: 0,0:12:51.23,0:12:55.64,Default,,0,0,0,,Kingsport-қа қош келдіңіз! Ұзақ сапардан шаршадыңыз ба?
Dialogue: 0,0:12:55.64,0:12:58.34,Default,,0,0,0,,Шаршаған сияқты емеспін.
Dialogue: 0,0:12:58.34,0:13:01.94,Default,,0,0,0,,Мен саған біздің пансионатты көрсетемін. иә!
Dialogue: 0,0:13:01.94,0:13:04.85,Default,,0,0,0,,Сондай-ақ үй иелерінің тәтелеріне. «Тачи»?
Dialogue: 0,0:13:04.85,0:13:09.58,Default,,0,0,0,,Қош келдіңіз. Рақмет сізге. Мен сені күттім.
Dialogue: 0,0:13:09.58,0:13:14.12,Default,,0,0,0,,Жүрегімдегі үн Қайда барсам да егізім артымнан ереді.
Dialogue: 0,0:13:14.12,0:13:19.69,Default,,0,0,0,,Анна бөлмесі алдыңғы жағында, Ескі Әулие Джон зиратына қарайды.
Dialogue: 0,0:13:19.69,0:13:23.23,Default,,0,0,0,,Зират? Бұл қорқынышты.
Dialogue: 0,0:13:23.23,0:13:25.57,Default,,0,0,0,,Бұл дұрыс емес. ➡
Dialogue: 0,0:13:25.57,0:13:27.50,Default,,0,0,0,,Сіз әрқашан айтып жүргендей➡
Dialogue: 0,0:13:27.50,0:13:30.81,Default,,0,0,0,,Қиялға орын бар орын.
Dialogue: 0,0:13:33.34,0:13:37.48,Default,,0,0,0,,Жүрек үні: Ол ай да Грин Гейблге қарап тұр. ➡
Dialogue: 0,0:13:37.48,0:13:43.08,Default,,0,0,0,,Бірақ мен бұл туралы қазір ойламаймын. Барынша жылауды кейінге шегеремін. ➡
Dialogue: 0,0:13:43.08,0:13:47.49,Default,,0,0,0,,Бүгін түн тыныш ұйықтайық.
Dialogue: 0,0:13:47.49,0:13:53.29,Default,,0,0,0,,♬～
Dialogue: 0,0:13:53.29,0:13:56.63,Default,,0,0,0,,Барлығы жылдам... өте жанды.
Dialogue: 0,0:13:56.63,0:13:58.57,Default,,0,0,0,,Бірақ содан кейін...! Мені тыңда!
Dialogue: 0,0:13:58.57,0:14:00.50,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:00.50,0:14:05.77,Default,,0,0,0,,О, Присси. Мен үлкен шелектегі кішкене тамшы сумын.
Dialogue: 0,0:14:05.77,0:14:07.84,Default,,0,0,0,,Бұл болмашы тіршілік.
Dialogue: 0,0:14:07.84,0:14:10.88,Default,,0,0,0,,Біраз уақыт шыдаңыз.
Dialogue: 0,0:14:10.88,0:14:15.45,Default,,0,0,0,,Уақыт өте сен де солардың кез келгеніндей дүниелік боласың.
Dialogue: 0,0:14:15.45,0:14:18.25,Default,,0,0,0,,Энн!
Dialogue: 0,0:14:18.25,0:14:20.32,Default,,0,0,0,,Ал, Гилберт, біраз уақыт болды!
Dialogue: 0,0:14:20.32,0:14:23.69,Default,,0,0,0,,Присцилла! Университетте сәттілік. оқасы жоқ.
Dialogue: 0,0:14:23.69,0:14:26.59,Default,,0,0,0,,Пансионат ше? Бұл ыңғайлы.
Dialogue: 0,0:14:26.59,0:14:31.93,Default,,0,0,0,,Біз студенттермен жұмыс бөліміне тіркелеміз, бірақ сен мұны әлі жасадың ба, Гилберт?
Dialogue: 0,0:14:31.93,0:14:34.47,Default,,0,0,0,,Ах. Олай болса... ⚟Эй!
Dialogue: 0,0:14:34.47,0:14:36.97,Default,,0,0,0,,Гилберт! Міне, міне!
Dialogue: 0,0:14:36.97,0:14:39.24,Default,,0,0,0,,Енді жүр!
Dialogue: 0,0:14:39.24,0:14:43.18,Default,,0,0,0,,Мен бұрын кездескен сыныптасыммен түскі ас ішейін деп жатырмын.
Dialogue: 0,0:14:43.18,0:14:45.85,Default,,0,0,0,,Жақында кездескенше! Эх...
Dialogue: 0,0:14:45.85,0:14:47.58,Default,,0,0,0,,Сонымен, сіз достар таптыңыз.
Dialogue: 0,0:14:47.58,0:14:49.72,Default,,0,0,0,,Тез үйреніп кетесің.
Dialogue: 0,0:14:49.72,0:14:53.59,Default,,0,0,0,,Бірақ соңғы бір жылда Гилберт әлдеқайда жетілген.
Dialogue: 0,0:14:53.59,0:14:55.59,Default,,0,0,0,,О, меніңше...
Dialogue: 0,0:14:55.59,0:14:58.09,Default,,0,0,0,,Барған сайын салқындап бара жатқан жоқ па?
Dialogue: 0,0:15:01.33,0:15:03.66,Default,,0,0,0,,Енді тіркеліңіз! иә?
Dialogue: 0,0:15:03.66,0:15:06.17,Default,,0,0,0,,Келіңіздер! асылу!
Dialogue: 0,0:15:13.27,0:15:17.21,Default,,0,0,0,,Жаңа мектеп, жаңа жоғары сыныптар... ➡
Dialogue: 0,0:15:17.21,0:15:20.45,Default,,0,0,0,,Присцилланың қасымда болғанына көңілім толды➡
Dialogue: 0,0:15:20.45,0:15:24.32,Default,,0,0,0,,Бізге орын бар ма екен...
Dialogue: 0,0:15:24.32,0:15:26.92,Default,,0,0,0,,Ах…. иә?
Dialogue: 0,0:15:32.76,0:15:37.17,Default,,0,0,0,,Ол адам да жаңадан келген студент пе? Бұл өте қалалық.
Dialogue: 0,0:15:37.17,0:15:39.97,Default,,0,0,0,,Және... ол сондай әдемі...
Dialogue: 0,0:15:41.90,0:15:44.21,Default,,0,0,0,,А...? Ах...
Dialogue: 0,0:15:47.18,0:15:49.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:52.01,0:15:54.72,Default,,0,0,0,,Ах...! а….
Dialogue: 0,0:15:57.15,0:16:01.92,Default,,0,0,0,,Эй, сен бұл қалада жақсы жұмыс істей аламын деп ойлайсың ба?
Dialogue: 0,0:16:01.92,0:16:04.23,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:16:04.23,0:16:06.19,Default,,0,0,0,,Дәл қазір өзімді қалай сезінемін➡
Dialogue: 0,0:16:06.19,0:16:09.53,Default,,0,0,0,,Avonlea ханымдарының білмегеніне қуаныштымын.
Dialogue: 0,0:16:09.53,0:16:11.47,Default,,0,0,0,,«Әй, көрдің бе!» ➡
Dialogue: 0,0:16:11.47,0:16:13.43,Default,,0,0,0,,Мақтанышпен айтқанмен➡
Dialogue: 0,0:16:13.43,0:16:15.74,Default,,0,0,0,,Өйткені ешқандай айырмашылық жоқ.
Dialogue: 0,0:16:15.74,0:16:19.14,Default,,0,0,0,,Хехе, сен ақыры кәдімгі Эннге ұқсай бастадың.
Dialogue: 0,0:16:19.14,0:16:22.64,Default,,0,0,0,,Біраз уақыттан кейін сіз бұл қаламен таныс боласыз➡
Dialogue: 0,0:16:22.64,0:16:25.45,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:16:25.45,0:16:29.02,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:16:29.02,0:16:32.79,Default,,0,0,0,,Эй, түскі астан кейін барғым келетін жер бар.
Dialogue: 0,0:16:32.79,0:16:36.46,Default,,0,0,0,,Қайда? Қиялға орын бар жер.
Dialogue: 0,0:16:36.46,0:16:39.13,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:16:39.13,0:16:42.03,Default,,0,0,0,,Присси айтқандай.
Dialogue: 0,0:16:42.03,0:16:44.07,Default,,0,0,0,,Ағаштар өте көп➡
Dialogue: 0,0:16:44.07,0:16:48.47,Default,,0,0,0,,Авонлеа орманында болғаныңызды елестете алатын нәрсе.
Dialogue: 0,0:16:54.11,0:16:58.28,Default,,0,0,0,,«Бұл жерде Альберт Кроуфордтың қалдықтары жатыр➡
Dialogue: 0,0:16:58.28,0:17:01.18,Default,,0,0,0,,Ұзақ жылдар бойы Мәртебелі қару-жарақ офицері қызметін атқарды➡
Dialogue: 0,0:17:01.18,0:17:06.02,Default,,0,0,0,,Ержүрек әскери офицер, жақсы жар, жақсы әке➡
Dialogue: 0,0:17:06.02,0:17:08.89,Default,,0,0,0,,Ол менің ең жақын досым болды».
Dialogue: 0,0:17:08.89,0:17:12.76,Default,,0,0,0,,Бұл өте жақсы жазу. Иә.
Dialogue: 0,0:17:12.76,0:17:17.20,Default,,0,0,0,,Бұл өмір қандай шытырман оқиғаларға толы болды деп ойлаймын...
Dialogue: 0,0:17:17.20,0:17:20.07,Default,,0,0,0,,Ескі зираттар тамаша.
Dialogue: 0,0:17:20.07,0:17:23.77,Default,,0,0,0,,Мен мұнда жиі келемін.
Dialogue: 0,0:17:23.77,0:17:25.97,Default,,0,0,0,,Ах…. иә?
Dialogue: 0,0:17:29.64,0:17:35.38,Default,,0,0,0,,Бұл мен бүгін таңертең университетте көрген адам. Иә.
Dialogue: 0,0:17:35.38,0:17:38.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.25,0:17:41.09,Default,,0,0,0,,Сәлеметсіз бе. Сізге ұнаса...
Dialogue: 0,0:17:41.09,0:17:44.36,Default,,0,0,0,,Мен сенің есімдеріңді білуге шыдамаймын!
Dialogue: 0,0:17:44.36,0:17:46.79,Default,,0,0,0,,Мен сені бүгін таңертең университетте көрдім.
Dialogue: 0,0:17:46.79,0:17:49.50,Default,,0,0,0,,Қандай шулы, жиіркенішті жер.
Dialogue: 0,0:17:49.50,0:17:53.23,Default,,0,0,0,,Бір кезде үйде отырып, тұрмысқа шыққаным дұрыс болар деп ойладым!
Dialogue: 0,0:17:53.23,0:17:55.60,Default,,0,0,0,,Ах…. Неке...
Dialogue: 0,0:17:55.60,0:17:57.54,Default,,0,0,0,,Оқиғаның бұрышы ғажап...
Dialogue: 0,0:17:57.54,0:18:03.34,Default,,0,0,0,,Кәне, бәріміз осында отырып тату болайық!
Dialogue: 0,0:18:03.34,0:18:06.18,Default,,0,0,0,,Біз міндетті түрде жақсы дос бола аламыз➡
Dialogue: 0,0:18:06.18,0:18:09.08,Default,,0,0,0,,Жігіттер сендерді университетте көргенде бірден сезіндім.
Dialogue: 0,0:18:09.08,0:18:11.62,Default,,0,0,0,,Мен жай ғана ұшып сені құшақтап алғым келді.
Dialogue: 0,0:18:11.62,0:18:13.92,Default,,0,0,0,,Неліктен мұны істемедің?
Dialogue: 0,0:18:13.92,0:18:17.76,Default,,0,0,0,,Ах... бұл менің қорқынышты шешімсіз болғандықтан.
Dialogue: 0,0:18:17.76,0:18:19.79,Default,,0,0,0,,Бұл Филипп Гордон…➡
Dialogue: 0,0:18:19.79,0:18:22.03,Default,,0,0,0,,Ах, мені «Фил» деп атаңыз.
Dialogue: 0,0:18:22.03,0:18:23.97,Default,,0,0,0,,-да? Сіздің екі есіміңіз кім?
Dialogue: 0,0:18:23.97,0:18:27.44,Default,,0,0,0,,Бұл Присцилла Грант. Присси жақсы.
Dialogue: 0,0:18:27.44,0:18:29.40,Default,,0,0,0,,Бұл Энн Ширли.
Dialogue: 0,0:18:29.40,0:18:32.57,Default,,0,0,0,,Біз Принц Эдвард аралынанбыз.
Dialogue: 0,0:18:32.57,0:18:35.48,Default,,0,0,0,,Мен Болингбруктанмын, Жаңа Шотландия.
Dialogue: 0,0:18:35.48,0:18:37.45,Default,,0,0,0,,Ах... Болингбрук⁉
Dialogue: 0,0:18:37.45,0:18:39.68,Default,,0,0,0,,Бұл менің туған жерім.
Dialogue: 0,0:18:39.68,0:18:42.65,Default,,0,0,0,,Жақсы! Демек, сіз де Жаңа Шотландия азаматысыз.
Dialogue: 0,0:18:42.65,0:18:46.29,Default,,0,0,0,,Жоқ, мен Принц Эдвард аралының тұрғынымын.
Dialogue: 0,0:18:46.29,0:18:49.06,Default,,0,0,0,,Мен өте қуаныштымын! Жоқ, мен...
Dialogue: 0,0:18:49.06,0:18:51.03,Default,,0,0,0,,Көрші емеспіз!
Dialogue: 0,0:18:51.03,0:18:54.23,Default,,0,0,0,,Айтпақшы, менің бетіме қарасаң не ойлайсың?
Dialogue: 0,0:18:54.23,0:18:56.80,Default,,0,0,0,,Не? Шынымды айт!
Dialogue: 0,0:18:56.80,0:18:59.47,Default,,0,0,0,,Хехе.
Dialogue: 0,0:18:59.47,0:19:02.47,Default,,0,0,0,,Бүгін таңертең университетте көрген адамдар арасында➡
Dialogue: 0,0:19:02.47,0:19:05.27,Default,,0,0,0,,Мен сені ең сұлу деп ойладым.
Dialogue: 0,0:19:05.27,0:19:09.14,Default,,0,0,0,,Ах...! Мен де солай ойладым.
Dialogue: 0,0:19:09.14,0:19:11.75,Default,,0,0,0,,Не? Тек осы идея➡
Dialogue: 0,0:19:11.75,0:19:14.32,Default,,0,0,0,,Мені басқа біреу қолдағанын қаладым.
Dialogue: 0,0:19:14.32,0:19:17.82,Default,,0,0,0,,Сырт келбетіме келгенде де шешімсізмін➡
Dialogue: 0,0:19:17.82,0:19:19.75,Default,,0,0,0,,Сіз өзіңіз шешім қабылдай алмайсыз.
Dialogue: 0,0:19:19.75,0:19:23.16,Default,,0,0,0,,Сонымен, сіз Редмондқа келуді қалай шештіңіз?
Dialogue: 0,0:19:23.16,0:19:25.09,Default,,0,0,0,,Әкем шешті.
Dialogue: 0,0:19:25.09,0:19:28.00,Default,,0,0,0,,Мен үйде қалғанымда, анам мені оған үйленуге мәжбүрлейтін еді➡
Dialogue: 0,0:19:28.00,0:19:31.57,Default,,0,0,0,,Жалпы айтқанда, кімге тұрмысқа шығуым керек?➡
Dialogue: 0,0:19:31.57,0:19:34.27,Default,,0,0,0,,Мен шешім қабылдай аламын деп ойлайсыз ба?
Dialogue: 0,0:19:34.27,0:19:36.77,Default,,0,0,0,,Осыншама қарсыластарыңыз болды ма?
Dialogue: 0,0:19:36.77,0:19:38.71,Default,,0,0,0,,Өте көп.
Dialogue: 0,0:19:38.71,0:19:41.44,Default,,0,0,0,,Барлық ұлдар мені жақсы көреді.
Dialogue: 0,0:19:41.44,0:19:45.11,Default,,0,0,0,,Алайда балалардың көпшілігі тым жас немесе ақшасы жоқ. ➡
Dialogue: 0,0:19:45.11,0:19:48.55,Default,,0,0,0,,Мен бай болмасам үйлене алмаймын, солай ма?
Dialogue: 0,0:19:48.55,0:19:52.05,Default,,0,0,0,,Неліктен? Мен көп ақша жұмсаймын!
Dialogue: 0,0:19:52.05,0:19:56.22,Default,,0,0,0,,-те тек екі адам қалды, Алек пен Алонзо. Мәселе мынада...
Dialogue: 0,0:19:56.22,0:19:59.56,Default,,0,0,0,,Сіз екеуінің бірін таңдай алмайсыз. бұл дұрыс!
Dialogue: 0,0:19:59.56,0:20:04.47,Default,,0,0,0,,Сіз... екеуін де жақсы көрмейсіз бе?
Dialogue: 0,0:20:04.47,0:20:06.70,Default,,0,0,0,,Әрине.
Dialogue: 0,0:20:06.70,0:20:10.20,Default,,0,0,0,,Мен ешбір еркекті сүйе алмаймын.
Dialogue: 0,0:20:10.20,0:20:15.41,Default,,0,0,0,,Ғашық болған соң, толық құлға айналасың.
Dialogue: 0,0:20:15.41,0:20:18.31,Default,,0,0,0,,Менің жеңілдігімнен шаршадың ба?
Dialogue: 0,0:20:18.31,0:20:20.78,Default,,0,0,0,,№.
Dialogue: 0,0:20:20.78,0:20:22.82,Default,,0,0,0,,Хехехе. ➡
Dialogue: 0,0:20:22.82,0:20:26.22,Default,,0,0,0,,Сонда да бұл зират әдемі. ➡
Dialogue: 0,0:20:26.22,0:20:28.96,Default,,0,0,0,,Мен де осында жерленгім келеді.
Dialogue: 0,0:20:28.96,0:20:31.63,Default,,0,0,0,,Қараңыз! ➡
Dialogue: 0,0:20:31.63,0:20:34.66,Default,,0,0,0,,Шеннон мен Чесапик шайқасында қайтыс болды➡
Dialogue: 0,0:20:34.66,0:20:38.40,Default,,0,0,0,,Бұл жас теңіз флотының лейтенанты курсантының бейіті дейді. ➡
Dialogue: 0,0:20:38.40,0:20:43.27,Default,,0,0,0,,1813 ж Атлант мұхитындағы теңіз шайқасы.
Dialogue: 0,0:20:43.27,0:20:51.45,Default,,0,0,0,,♬～
Dialogue: 0,0:20:51.45,0:20:55.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.08,0:20:58.09,Default,,0,0,0,,А... Энн? не болды? ➡
Dialogue: 0,0:20:58.09,0:21:00.69,Default,,0,0,0,,Анн?
Dialogue: 0,0:21:02.46,0:21:04.76,Default,,0,0,0,,Мен ойлағандай…
Dialogue: 0,0:21:04.76,0:21:06.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:06.73,0:21:08.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:08.76,0:21:11.67,Default,,0,0,0,,Ах…. (Филиппаның дауысы) Энн Ширли?
Dialogue: 0,0:21:14.47,0:21:17.30,Default,,0,0,0,,Ах…. (Филиппаның дауысы) Қайтадан қош келдіңіз!
Dialogue: 0,0:21:17.30,0:21:19.67,Default,,0,0,0,,Энн Ширли! Ха!
Dialogue: 0,0:21:19.67,0:21:23.14,Default,,0,0,0,,Амансың ба? Сіз қазір➡
Dialogue: 0,0:21:23.14,0:21:28.58,Default,,0,0,0,,Мен бұл жерден 100 жыл алыста болдым.
Dialogue: 0,0:21:28.58,0:21:30.99,Default,,0,0,0,,♬～
Dialogue: 0,0:21:30.99,0:21:34.49,Default,,0,0,0,,Жаңа досымыз туралы не ойладың?
Dialogue: 0,0:21:34.49,0:21:37.16,Default,,0,0,0,,Иә...➡
Dialogue: 0,0:21:37.16,0:21:40.49,Default,,0,0,0,,Маған ұнайды. Бұл жерде мені шынымен де өзіне тартатын бір нәрсе болды.
Dialogue: 0,0:21:40.49,0:21:45.33,Default,,0,0,0,,Мен де! Сізбен кездесуді асығыспен күтем. Иә.
Dialogue: 0,0:21:45.33,0:21:50.60,Default,,0,0,0,,Жүрек дауысы Мен бүгін Kingsport-та ​​тамыр тартқандай сезінемін. ➡
Dialogue: 0,0:21:50.60,0:21:55.34,Default,,0,0,0,,Жаңа достармен танысыңыз және осы өлкенің тарихын біліңіз... ➡
Dialogue: 0,0:21:55.34,0:21:57.81,Default,,0,0,0,,Сондықтан менің қояр жерім жоқ➡
Dialogue: 0,0:21:57.81,0:22:00.15,Default,,0,0,0,,Қорықпа, мен байқап көрейін. ➡
Dialogue: 0,0:22:00.15,0:22:03.45,Default,,0,0,0,,Мен мұнда өз таңдауыммен келдім.
Dialogue: 0,0:22:05.45,0:22:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.03,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қала»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны дұрыстап тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
