Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:05.10,Default,,0,0,0,,<Редмондтағы екінші семестр Филдің сөзімен айтқанда...> болды
Dialogue: 0,0:00:05.10,0:00:08.80,Default,,0,0,0,,Иә! Айқайлап, ұшып кетті. ➡
Dialogue: 0,0:00:08.80,0:00:11.37,Default,,0,0,0,,19 жасқа толдым➡
Dialogue: 0,0:00:11.37,0:00:15.71,Default,,0,0,0,,Мен қиын сынақтан өту үшін көп оқуды жалғастырамын. ➡
Dialogue: 0,0:00:15.71,0:00:19.05,Default,,0,0,0,,Пансионат негізінен ыңғайлы, бірақ➡
Dialogue: 0,0:00:19.05,0:00:22.48,Default,,0,0,0,,Үйге кеш қайтқан күндері...>
Dialogue: 0,0:00:22.48,0:00:25.05,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:00:25.05,0:00:27.96,Default,,0,0,0,,Itata…. <Үй иесі жасаған жастықтардың үлкен көлемі➡
Dialogue: 0,0:00:27.96,0:00:31.23,Default,,0,0,0,,Өзіңізге қауіп төніп тұрғанын сезінуіңіз мүмкін. ➡
Dialogue: 0,0:00:31.23,0:00:33.83,Default,,0,0,0,,Гилбертпен де қарым-қатынас жақсы.
Dialogue: 0,0:00:33.83,0:00:35.76,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:00:35.76,0:00:38.27,Default,,0,0,0,,Иә, бұл енді маңызды емес.
Dialogue: 0,0:00:38.27,0:00:43.11,Default,,0,0,0,,Егер мен Торберн стипендиясын алсам, Марилланың жинақтарын пайдаланудың қажеті болмайды➡
Dialogue: 0,0:00:43.11,0:00:45.94,Default,,0,0,0,,Мен келесі жылы да Редмондта қала аламын.
Dialogue: 0,0:00:45.94,0:00:49.55,Default,,0,0,0,,Онда мен де бар күшімді салуым керек. Бұл дұрыс!
Dialogue: 0,0:00:49.55,0:00:52.95,Default,,0,0,0,,Гилберт әрқашан Аннамен бірге.
Dialogue: 0,0:00:52.95,0:00:54.88,Default,,0,0,0,,Мен қызғанамын...
Dialogue: 0,0:00:54.88,0:00:57.79,Default,,0,0,0,,Алайда осыған байланысты онымен мектеп ішінде сөйлесу қиын.
Dialogue: 0,0:00:57.79,0:01:00.69,Default,,0,0,0,,Ескі Сент-Джонның жанындағы Энн➡
Dialogue: 0,0:01:00.69,0:01:02.66,Default,,0,0,0,,Ол пансионатта тұрған сияқты. иә? а….
Dialogue: 0,0:01:02.66,0:01:05.46,Default,,0,0,0,,Содан кейін менде Раммус жиналысы бар.
Dialogue: 0,0:01:05.46,0:01:09.03,Default,,0,0,0,,Иә, кроссовкадан ләззат алыңыз! Өйткені олай емес...
Dialogue: 0,0:01:09.03,0:01:11.03,Default,,0,0,0,,Аха!
Dialogue: 0,0:01:11.03,0:01:14.70,Default,,0,0,0,,Ішкі дауыс Гилберттен жақсы дос жоқ. ➡
Dialogue: 0,0:01:14.70,0:01:17.01,Default,,0,0,0,,Тіпті сенің маған деген ақымақ сезімдерің➡
Dialogue: 0,0:01:17.01,0:01:19.31,Default,,0,0,0,,Бәрін лақтырып жіберген сияқты.
Dialogue: 0,0:01:21.91,0:01:24.81,Default,,0,0,0,,⚟(D студенті) Гилберт! Ах... ой!
Dialogue: 0,0:01:27.65,0:01:31.29,Default,,0,0,0,,Жүрегімнің үні Өйткені мен... Ах...
Dialogue: 0,0:01:31.29,0:01:33.82,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:01:36.09,0:01:40.30,Default,,0,0,0,,(Арба дыбысы)
Dialogue: 0,0:01:40.30,0:01:43.13,Default,,0,0,0,,Жүрегімдегі дауыстар Бірақ шын мәнінде мен жай ғана студентпін. ➡
Dialogue: 0,0:01:43.13,0:01:49.30,Default,,0,0,0,,Десе де, мен бүгінде аянбай еңбек етемін, бір күнді армандаймын.
Dialogue: 0,0:01:49.30,0:01:58.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:58.41,0:02:03.02,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:03.02,0:02:05.55,Default,,0,0,0,,♬ «Мүмкін болса да, болмаса да»
Dialogue: 0,0:02:05.55,0:02:07.49,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:07.49,0:02:11.36,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:11.36,0:02:13.70,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:13.70,0:02:15.93,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:15.93,0:02:20.47,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:20.47,0:02:25.67,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:25.67,0:02:27.61,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:27.61,0:02:31.48,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:31.48,0:02:34.88,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:34.88,0:02:37.32,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:37.32,0:02:39.59,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:39.59,0:02:43.83,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:43.83,0:02:46.29,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:46.29,0:02:48.63,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:48.63,0:02:52.10,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:52.10,0:02:55.40,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:55.40,0:02:57.64,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:57.64,0:03:01.84,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:01.84,0:03:04.35,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:03:04.35,0:03:06.65,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:06.65,0:03:08.65,Default,,0,0,0,,♬ «Мен сені алып кетейін.»
Dialogue: 0,0:03:08.65,0:03:12.35,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:12.35,0:03:16.86,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.70,0:03:24.20,Default,,0,0,0,,♬～
Dialogue: 0,0:03:26.17,0:03:29.77,Default,,0,0,0,,Ах. Күрсіну….
Dialogue: 0,0:03:29.77,0:03:32.67,Default,,0,0,0,,(Ер студент Е) Оқу ақысының көтерілуіне қатысты мен үзілді-кесілді қарсымын!
Dialogue: 0,0:03:32.67,0:03:35.98,Default,,0,0,0,,Дәл солай! Мүмкін емес! (Ер оқушы Г) Шұғыл жиналыс өткізейік.
Dialogue: 0,0:03:35.98,0:03:38.88,Default,,0,0,0,,Барлық оқушылардың пікірі – қарсылығын білдіру.
Dialogue: 0,0:03:38.88,0:03:40.98,Default,,0,0,0,,Дайындықты бастайық.
Dialogue: 0,0:03:46.29,0:03:48.22,Default,,0,0,0,,Менің бүгін жоспарым бар.
Dialogue: 0,0:03:48.22,0:03:51.13,Default,,0,0,0,,Кішкене болса да олай айтпа.
Dialogue: 0,0:03:51.13,0:03:53.73,Default,,0,0,0,,Қараңдаршы, ауа райы жақсы.
Dialogue: 0,0:03:53.73,0:03:55.66,Default,,0,0,0,,⚟Сәлеметсіз бе! а….
Dialogue: 0,0:03:55.66,0:03:57.60,Default,,0,0,0,,Күткеніңізге рахмет.
Dialogue: 0,0:03:57.60,0:03:59.67,Default,,0,0,0,,А...?
Dialogue: 0,0:03:59.67,0:04:01.77,Default,,0,0,0,,Чарли?
Dialogue: 0,0:04:01.77,0:04:04.67,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:04:06.34,0:04:08.68,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:08.68,0:04:10.61,Default,,0,0,0,,Рахмет Чарли.
Dialogue: 0,0:04:10.61,0:04:15.15,Default,,0,0,0,,Жарайды. Бірақ бұлай ізіне түсу қиын.
Dialogue: 0,0:04:15.15,0:04:17.12,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:04:17.12,0:04:21.39,Default,,0,0,0,,Энн бос емес болса да, ол менің серуендеуімде маған еріп жүруге дайын.
Dialogue: 0,0:04:21.39,0:04:23.79,Default,,0,0,0,,Мен жай ғана дем алғым келді.
Dialogue: 0,0:04:23.79,0:04:27.66,Default,,0,0,0,,Бұл жақсы. Бұл әдемі көрініс. Иә.
Dialogue: 0,0:04:27.66,0:04:30.27,Default,,0,0,0,,Анна да әдемі. сурет?
Dialogue: 0,0:04:31.97,0:04:33.94,Default,,0,0,0,,Анн.
Dialogue: 0,0:04:33.94,0:04:38.41,Default,,0,0,0,,Сіз маған болашақта Чарли Слоун ханым болатыныңызға уәде бере аласыз ба? тістері?
Dialogue: 0,0:04:38.41,0:04:41.34,Default,,0,0,0,,Басқаша айтқанда, сенің маған тұрмысқа шыққаныңды қалаймын!
Dialogue: 0,0:04:41.34,0:04:44.71,Default,,0,0,0,,Иә? Менің ойымша, бұл ұсыныс үшін тым қатал болды.
Dialogue: 0,0:04:44.71,0:04:47.52,Default,,0,0,0,,Ахахха! О, Чарли?
Dialogue: 0,0:04:47.52,0:04:50.92,Default,,0,0,0,,Біз көптен бері доспыз, солай ма?
Dialogue: 0,0:04:50.92,0:04:53.72,Default,,0,0,0,,Мен енді өз сезімдерім туралы өтірік айта алмаймын!
Dialogue: 0,0:04:53.72,0:04:55.66,Default,,0,0,0,,Энн үйленейік!
Dialogue: 0,0:04:55.66,0:04:58.29,Default,,0,0,0,,Мен бас тартамын. сурет? Неге!?
Dialogue: 0,0:04:58.29,0:05:00.66,Default,,0,0,0,,Көптеген себептер бар...
Dialogue: 0,0:05:00.66,0:05:04.43,Default,,0,0,0,,Саған менің не ұнамайды? Айтсаңыз, түзетемін.
Dialogue: 0,0:05:04.43,0:05:06.37,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:05:06.37,0:05:09.30,Default,,0,0,0,,Мен саған тұрмысқа шығуды ойламаппын➡
Dialogue: 0,0:05:09.30,0:05:12.17,Default,,0,0,0,,Мен оны болашақта ойлай алмаймын деп ойлаймын.
Dialogue: 0,0:05:12.17,0:05:14.44,Default,,0,0,0,,Маған Слоун үйіне қосылуға рұқсат етіңіз!
Dialogue: 0,0:05:14.44,0:05:16.41,Default,,0,0,0,,Бұл үлкен құрмет!
Dialogue: 0,0:05:16.41,0:05:19.21,Default,,0,0,0,,Жасалмайтын нәрсені істеу мүмкін емес! Ах~!
Dialogue: 0,0:05:19.21,0:05:22.08,Default,,0,0,0,,Менің ұсынысымнан бас тартасың ба...!?
Dialogue: 0,0:05:22.08,0:05:25.69,Default,,0,0,0,,Жетім болсам да! Ах...!
Dialogue: 0,0:05:25.69,0:05:35.80,Default,,0,0,0,,♬～
Dialogue: 0,0:05:35.80,0:05:39.27,Default,,0,0,0,,Неліктен бұлай бола береді?
Dialogue: 0,0:05:39.27,0:05:42.00,Default,,0,0,0,,Еске алу Мен үйге бара жатырмын!
Dialogue: 0,0:05:42.00,0:05:46.47,Default,,0,0,0,,Мен анама айтамын!
Dialogue: 0,0:05:46.47,0:05:48.54,Default,,0,0,0,,Тіпті әке үшін! Бұл не?
Dialogue: 0,0:05:48.54,0:05:51.31,Default,,0,0,0,,Ii~⁉ Сіз түсінбейсіз~!
Dialogue: 0,0:05:51.31,0:05:53.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:53.25,0:05:58.09,Default,,0,0,0,,♬～
Dialogue: 0,0:05:58.09,0:06:00.06,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:06:00.06,0:06:03.26,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:06:03.26,0:06:05.76,Default,,0,0,0,,Энн хаты. …иә? ➡
Dialogue: 0,0:06:05.76,0:06:09.63,Default,,0,0,0,,Амансың ба? Иә... қызық...
Dialogue: 0,0:06:09.63,0:06:11.63,Default,,0,0,0,,Стелладан.
Dialogue: 0,0:06:11.63,0:06:15.20,Default,,0,0,0,,Стелла⁉ Королева академиясының бітіру рәсімінен бері.
Dialogue: 0,0:06:15.20,0:06:19.67,Default,,0,0,0,,Иә. Біз тек соңғы жағдайды хабарлаған болатынбыз...➡
Dialogue: 0,0:06:19.67,0:06:22.64,Default,,0,0,0,,Менің ойымша, ол жергілікті мектепте сабақ береді. ➡
Dialogue: 0,0:06:22.64,0:06:26.45,Default,,0,0,0,,Оқушыларға қарағанда ата-аналарға қиынырақ болған сияқты.
Dialogue: 0,0:06:26.45,0:06:31.92,Default,,0,0,0,,Стелла бастауыш мектепті тастап, келесі жылы Редмондқа келеді!
Dialogue: 0,0:06:31.92,0:06:33.86,Default,,0,0,0,,Оның жоспары туралы не ойлайсыз?
Dialogue: 0,0:06:33.86,0:06:36.83,Default,,0,0,0,,Егер мен оны жүзеге асыра алсам, бұл керемет болар еді деп ойламаймын! а….
Dialogue: 0,0:06:36.83,0:06:39.46,Default,,0,0,0,,Эй Присси, сен қалай ойлайсың?
Dialogue: 0,0:06:39.46,0:06:43.70,Default,,0,0,0,,Не туралы айтып тұрғанымды білсеңіз, маған дұрыс жауап бере аласыз ба?
Dialogue: 0,0:06:43.70,0:06:47.67,Default,,0,0,0,,«Онда, Энн, Присцилла және мен➡
Dialogue: 0,0:06:47.67,0:06:50.54,Default,,0,0,0,,Неге шағын үй жалдап, бірге тұрмасқа? ➡
Dialogue: 0,0:06:50.54,0:06:53.94,Default,,0,0,0,,Басқа әдістерге қарағанда арзанырақ екеніне сенімдімін. ➡
Dialogue: 0,0:06:53.94,0:06:58.91,Default,,0,0,0,,Әрине, егер бұл орын алса, мен көмекші жалдауым керек➡
Dialogue: 0,0:06:58.91,0:07:03.42,Default,,0,0,0,,Менің тәтем жалғыз тұрады, өте жалғыз. ➡
Dialogue: 0,0:07:03.42,0:07:06.76,Default,,0,0,0,,Менен сұрасаң, мен Кингспортқа келіп, саған қамқор боламын.''
Dialogue: 0,0:07:06.76,0:07:11.99,Default,,0,0,0,,«Егер екеуің келіссеңдер, үй іздейсіңдер ме?»
Dialogue: 0,0:07:11.99,0:07:15.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:15.23,0:07:19.10,Default,,0,0,0,,Қолайлы үй таба аласыз ба деген сұрақ.
Dialogue: 0,0:07:19.10,0:07:23.00,Default,,0,0,0,,Бұл тым үлкен. Жалдау ақысы да жоғары.
Dialogue: 0,0:07:23.00,0:07:25.84,Default,,0,0,0,,Бұл кішкентай. Жалдау ақысы арзан болса да.
Dialogue: 0,0:07:25.84,0:07:28.68,Default,,0,0,0,,Университетке түсу қиын сияқты...
Dialogue: 0,0:07:28.68,0:07:31.08,Default,,0,0,0,,Жол жүру қиын болуы керек...
Dialogue: 0,0:07:31.08,0:07:33.45,Default,,0,0,0,,Елес пайда болатын сияқты...
Dialogue: 0,0:07:33.45,0:07:37.32,Default,,0,0,0,,Мүмкін емес, мүмкін емес, мүмкін емес!
Dialogue: 0,0:07:37.32,0:07:40.66,Default,,0,0,0,,Күзге дейін күту керек шығар... ➡
Dialogue: 0,0:07:40.66,0:07:45.26,Default,,0,0,0,,Егер бұл нәтиже бермесе, сіз пансионатта тұруыңызға болады.
Dialogue: 0,0:07:45.26,0:07:47.33,Default,,0,0,0,,Мені уайымдап отырмын➡
Dialogue: 0,0:07:47.33,0:07:50.90,Default,,0,0,0,,Мен бұл тамаша кешкі аспанды бұзатын ештеңе істемеймін!
Dialogue: 0,0:07:50.90,0:07:52.83,Default,,0,0,0,,Бірақ қараңызшы. ➡
Dialogue: 0,0:07:52.83,0:07:56.27,Default,,0,0,0,,Барлық жерде үйлер. ➡
Dialogue: 0,0:07:56.27,0:08:00.81,Default,,0,0,0,,Сонда да бір үйіміз жоқ.
Dialogue: 0,0:08:00.81,0:08:03.55,Default,,0,0,0,,Ха! Хмм!
Dialogue: 0,0:08:03.55,0:08:06.05,Default,,0,0,0,,Менің басымнан бір керемет оқиға болды➡
Dialogue: 0,0:08:06.05,0:08:09.92,Default,,0,0,0,,Мен бұл дәл қазір болатынын сезіп тұрмын! О, күт!
Dialogue: 0,0:08:09.92,0:08:16.02,Default,,0,0,0,,(Аяқ киім)
Dialogue: 0,0:08:16.02,0:08:18.46,Default,,0,0,0,,Споффорд көшесі емес. ➡
Dialogue: 0,0:08:18.46,0:08:20.40,Default,,0,0,0,,Осындай жоғары санатты тұрғын ауданда➡
Dialogue: 0,0:08:20.40,0:08:23.30,Default,,0,0,0,,Жалға алатын үй жоқ...
Dialogue: 0,0:08:25.23,0:08:27.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:27.24,0:08:30.54,Default,,0,0,0,,Сәлем Присси.
Dialogue: 0,0:08:30.54,0:08:33.98,Default,,0,0,0,,«Пэттидің үйін» жалға аламыз ба?
Dialogue: 0,0:08:33.98,0:08:36.24,Default,,0,0,0,,Хмм~⁉ Жақсы ма? Анн.
Dialogue: 0,0:08:36.24,0:08:39.48,Default,,0,0,0,,Шындықты көрейік? Жалдау ақысы сіз күткеннен де жоғары болуы мүмкін.
Dialogue: 0,0:08:39.48,0:08:42.05,Default,,0,0,0,,Менің үмітім жоқ.
Dialogue: 0,0:08:42.05,0:08:44.35,Default,,0,0,0,,Көңіліңіз қалғанына сенімдімін.
Dialogue: 0,0:08:44.35,0:08:47.76,Default,,0,0,0,,Ұмытпа. Бұл Споффорд көшесі!?
Dialogue: 0,0:08:49.66,0:08:51.86,Default,,0,0,0,,Сіз тұтынушысыз.
Dialogue: 0,0:08:56.56,0:08:58.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.97,0:09:02.97,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:09:04.64,0:09:08.34,Default,,0,0,0,,Дәл солай. Бұл дұрыс. Бұл жақсы белгі.
Dialogue: 0,0:09:08.34,0:09:12.28,Default,,0,0,0,,Мм... үстелде ілулі тұрған белгіге қарадық➡
Dialogue: 0,0:09:12.28,0:09:15.62,Default,,0,0,0,,Бұл үйді жалға беретініңді түсіндім...
Dialogue: 0,0:09:15.62,0:09:17.69,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:17.69,0:09:21.72,Default,,0,0,0,,Мен бүгін ғана сол тегті алып тастауды ойладым.
Dialogue: 0,0:09:21.72,0:09:25.73,Default,,0,0,0,,А... Сонымен кешігіп қалдық...
Dialogue: 0,0:09:25.73,0:09:29.23,Default,,0,0,0,,Жоқ. Мен оны жалға беруді тоқтатуды шештім.
Dialogue: 0,0:09:29.23,0:09:31.83,Default,,0,0,0,,Иә!? Е, бұл ұят!
Dialogue: 0,0:09:31.83,0:09:35.37,Default,,0,0,0,,Біз бұл үйді өте жақсы көреміз!
Dialogue: 0,0:09:35.37,0:09:38.01,Default,,0,0,0,,Мен сені сүйемін дейсің бе?
Dialogue: 0,0:09:38.01,0:09:40.91,Default,,0,0,0,,Жас кезімде бұл оңай болды➡
Dialogue: 0,0:09:40.91,0:09:44.25,Default,,0,0,0,,«Мен сені сүйемін» деген сөзді ешқашан қолданбадым. ➡
Dialogue: 0,0:09:44.25,0:09:49.08,Default,,0,0,0,,Дәл... қазіргі қыздар тым асыра сөйлейді➡
Dialogue: 0,0:09:49.08,0:09:51.99,Default,,0,0,0,,Мен сіздің шынайы сезімдеріңізді білмеймін.
Dialogue: 0,0:09:51.99,0:09:53.92,Default,,0,0,0,,Мен сені жақсы көремін➡
Dialogue: 0,0:09:53.92,0:09:55.86,Default,,0,0,0,,Маған бұл үйдің түрі ұнады➡\NБұл жай ғана
Dialogue: 0,0:09:55.86,0:09:58.16,Default,,0,0,0,,емес пе?
Dialogue: 0,0:09:58.16,0:10:00.10,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:00.10,0:10:02.03,Default,,0,0,0,,Мен сені шын сүйемін.
Dialogue: 0,0:10:02.03,0:10:04.70,Default,,0,0,0,,Өткен күзде көруге келгеніме көп болды.
Dialogue: 0,0:10:04.70,0:10:06.73,Default,,0,0,0,,Қазір интернатта қалма➡
Dialogue: 0,0:10:06.73,0:10:10.07,Default,,0,0,0,,Мен жақсы достарыммен үй жалдағым келді➡
Dialogue: 0,0:10:10.07,0:10:14.48,Default,,0,0,0,,Ертерек осы үйдің қақпасынан әлгі белгіні тауып алғанымда қатты қуандым.
Dialogue: 0,0:10:14.48,0:10:18.31,Default,,0,0,0,,Маған да осы үйдің аты ұнайды. «Пэттидің үйі»
Dialogue: 0,0:10:18.31,0:10:22.72,Default,,0,0,0,,Зауыт тақтасы, ілу жолы, бәрі...
Dialogue: 0,0:10:22.72,0:10:26.15,Default,,0,0,0,,Мен несие беруді тоқтатуды шештім➡
Dialogue: 0,0:10:26.15,0:10:28.49,Default,,0,0,0,,Қарыз алуды сұраған адамдар➡
Dialogue: 0,0:10:28.49,0:10:32.49,Default,,0,0,0,,Себебі бәрі сол тақтайшаны алып тастауға болатынын сұрады.
Dialogue: 0,0:10:32.49,0:10:35.26,Default,,0,0,0,,Егер сізге бұл үй ұнаса➡
Dialogue: 0,0:10:35.26,0:10:38.17,Default,,0,0,0,,Оны сізге қарызға берейік. Егер балалар➡
Dialogue: 0,0:10:38.17,0:10:41.74,Default,,0,0,0,,Бұл үйді жақсы күтетініңізге сенімдімін.
Dialogue: 0,0:10:41.74,0:10:44.54,Default,,0,0,0,,Ах... Бірақ бір мәселе бар...
Dialogue: 0,0:10:44.54,0:10:48.74,Default,,0,0,0,,Сіз айтып отырған жалдау ақысын төлей аламыз ба деп ойлаймын...
Dialogue: 0,0:10:48.74,0:10:51.41,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:51.41,0:10:53.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:53.38,0:10:55.62,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:55.62,0:10:59.25,Default,,0,0,0,,Көріп отырғаныңыздай, біз бай емеспіз...
Dialogue: 0,0:10:59.25,0:11:01.79,Default,,0,0,0,,Сіз қанша тұрады деп ойладыңыз?
Dialogue: 0,0:11:01.79,0:11:05.76,Default,,0,0,0,,Егер бұл шамамен жартысы болса...
Dialogue: 0,0:11:05.76,0:11:08.23,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:11:08.23,0:11:10.16,Default,,0,0,0,,Ах...! Бұл рас па?
Dialogue: 0,0:11:10.16,0:11:13.70,Default,,0,0,0,,Иә. Мен оған несие беруді тоқтатпақ болдым.
Dialogue: 0,0:11:13.70,0:11:16.94,Default,,0,0,0,,Рахмет! Айтпақшы...➡
Dialogue: 0,0:11:16.94,0:11:19.47,Default,,0,0,0,,Мен бұл итті аламын ба?
Dialogue: 0,0:11:19.47,0:11:21.71,Default,,0,0,0,,Сені тастап кеткенімді қалайсың ба?
Dialogue: 0,0:11:21.71,0:11:26.58,Default,,0,0,0,,Иә, маған ұнайды. Бұл шынымен керемет.
Dialogue: 0,0:11:26.58,0:11:30.12,Default,,0,0,0,,Ол иттер Гог және Магог➡ деп аталады
Dialogue: 0,0:11:30.12,0:11:33.59,Default,,0,0,0,,Менің ағам Ирон оны Лондоннан әкелді.
Dialogue: 0,0:11:33.59,0:11:37.39,Default,,0,0,0,,Үлкен аға? Менің ағама да қатты ұнады. ➡
Dialogue: 0,0:11:37.39,0:11:40.83,Default,,0,0,0,,Оны «Пэттидің үйі» деп атаған Илон болды.
Dialogue: 0,0:11:40.83,0:11:43.73,Default,,0,0,0,,Ал "Споффорд-стрит" - ➡
Dialogue: 0,0:11:43.73,0:11:47.10,Default,,0,0,0,,Илонның атымен аталған.
Dialogue: 0,0:11:47.10,0:11:49.07,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:49.07,0:11:53.88,Default,,0,0,0,,Сіз ненің жақсы екенін білесіз.
Dialogue: 0,0:11:53.88,0:11:57.18,Default,,0,0,0,,Бұл өте керемет...
Dialogue: 0,0:11:57.18,0:11:59.11,Default,,0,0,0,,Мен оянғанда сенімдімін➡
Dialogue: 0,0:11:59.11,0:12:02.98,Default,,0,0,0,,Менің ойымша, бұл өткінші түннің арманы болуы керек.
Dialogue: 0,0:12:02.98,0:12:09.09,Default,,0,0,0,,«Пэттидің үйі» шын мәнінде бар. Ал біз сонда тұра аламыз.
Dialogue: 0,0:12:09.09,0:12:14.90,Default,,0,0,0,,Мен дәл қазір қуанышты ән салған таңғы жұлдыздай сезінемін.
Dialogue: 0,0:12:14.90,0:12:18.37,Default,,0,0,0,,Ей, мен де сенімен бірге тұрайын!
Dialogue: 0,0:12:18.37,0:12:20.34,Default,,0,0,0,,Мен сенің жақсы қыз екеніңе көз жеткіземін.
Dialogue: 0,0:12:20.34,0:12:23.57,Default,,0,0,0,,Жарайды демейінше тіземді көтермеймін!
Dialogue: 0,0:12:23.57,0:12:25.54,Default,,0,0,0,,Бұл жерден қозғалма!
Dialogue: 0,0:12:25.54,0:12:28.28,Default,,0,0,0,,Фил... Біз кедейшілікте өмір сүретін боламыз.
Dialogue: 0,0:12:28.28,0:12:30.25,Default,,0,0,0,,Тамағы да қарапайым.
Dialogue: 0,0:12:30.25,0:12:32.25,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:12:32.25,0:12:35.18,Default,,0,0,0,,Көп жұмыс істеу керек.
Dialogue: 0,0:12:35.18,0:12:37.32,Default,,0,0,0,,Бірақ сізге келгенде...
Dialogue: 0,0:12:37.32,0:12:40.02,Default,,0,0,0,,Ол жұмыс істемейді де, айналмайды да.
Dialogue: 0,0:12:40.02,0:12:43.02,Default,,0,0,0,,Бірақ мен өз жұмысымды үйрене аламын ба?
Dialogue: 0,0:12:43.02,0:12:45.83,Default,,0,0,0,,Маған тек бір рет айту керек.
Dialogue: 0,0:12:45.83,0:12:48.43,Default,,0,0,0,,Жоқ десең➡
Dialogue: 0,0:12:48.43,0:12:51.93,Default,,0,0,0,,Көңіл мен түңілуден өлемін! Мен бетпердемен шығамын! ➡
Dialogue: 0,0:12:51.93,0:12:55.14,Default,,0,0,0,,Мен «Пэттидің үйінің» баспалдағында қатты жұмыс істеп жатырмын!
Dialogue: 0,0:12:55.14,0:12:58.17,Default,,0,0,0,,Балалар, менің аруағымнан сүрінбеулерің керек➡
Dialogue: 0,0:12:58.17,0:13:01.48,Default,,0,0,0,,Сіз не шыға алмайсыз, не кіре алмайсыз!
Dialogue: 0,0:13:01.48,0:13:03.41,Default,,0,0,0,,(Филиппаның гуілдеуі)
Dialogue: 0,0:13:03.41,0:13:06.05,Default,,0,0,0,,Ммм. Ммм. Ммм!
Dialogue: 0,0:13:06.05,0:13:08.35,Default,,0,0,0,,Маған Стелламен сөйлесу керек. (Филиппа мырс етіп)
Dialogue: 0,0:13:08.35,0:13:10.95,Default,,0,0,0,,Стелла қарсылық білдірмейді деп ойлаймын. (Филиппа мырс етіп)
Dialogue: 0,0:13:10.95,0:13:13.59,Default,,0,0,0,,Фил өте жақсы адам. Хаха!
Dialogue: 0,0:13:13.59,0:13:16.39,Default,,0,0,0,,Мен олай ойламаймын. Бұл дұрыс.
Dialogue: 0,0:13:16.39,0:13:18.93,Default,,0,0,0,,үшінмыз «Пэттидің үйінде»➡
Dialogue: 0,0:13:18.93,0:13:22.43,Default,,0,0,0,,Менің ойымша, сіз өте жақсы істей аласыз.
Dialogue: 0,0:13:24.57,0:13:29.57,Default,,0,0,0,,♬～
Dialogue: 0,0:13:31.04,0:13:33.81,Default,,0,0,0,,<Университет өмірінің бірінші жылынан кейінгі жазғы демалыс. ➡
Dialogue: 0,0:13:33.81,0:13:35.74,Default,,0,0,0,,Avonlea➡-ге оралмас бұрын
Dialogue: 0,0:13:35.74,0:13:38.28,Default,,0,0,0,,Мен Болингбрукқа тоқтауды жөн көрдім. ➡
Dialogue: 0,0:13:38.28,0:13:42.82,Default,,0,0,0,,Міне Филиппаның ата-анасының үйі және мен туған үй>
Dialogue: 0,0:13:42.82,0:13:47.29,Default,,0,0,0,,Мынау үй. Ол «Холли Манор тауы» деп аталады.
Dialogue: 0,0:13:47.29,0:13:52.13,Default,,0,0,0,,Бұл жақсы. Мен Аннаның туған жерін де зерттедім.
Dialogue: 0,0:13:52.13,0:13:55.16,Default,,0,0,0,,Рахмет. Не болды?
Dialogue: 0,0:13:55.16,0:14:01.14,Default,,0,0,0,,Соңғы кездері менің идеалдарым дағдарыс жағдайында болды. Ол жойылу алдында тұр.
Dialogue: 0,0:14:01.14,0:14:03.47,Default,,0,0,0,,Барған үйіңіз болса➡
Dialogue: 0,0:14:03.47,0:14:05.77,Default,,0,0,0,,Мен білетін үй болмаса...
Dialogue: 0,0:14:05.77,0:14:10.18,Default,,0,0,0,,Есіңде ме? Сіз әлі де қылшық бала едіңіз, солай ма?
Dialogue: 0,0:14:10.18,0:14:13.08,Default,,0,0,0,,Мен бәрін елестеттім.
Dialogue: 0,0:14:13.08,0:14:15.98,Default,,0,0,0,,Үй кішкентай сары үй➡
Dialogue: 0,0:14:15.98,0:14:18.05,Default,,0,0,0,,Қабырғадағы ырғай.
Dialogue: 0,0:14:18.05,0:14:20.76,Default,,0,0,0,,Бақшада сирень мен лалагүлдер гүлдейді➡
Dialogue: 0,0:14:20.76,0:14:23.29,Default,,0,0,0,,Барлық терезелерде муслин перделері бар➡
Dialogue: 0,0:14:23.29,0:14:25.86,Default,,0,0,0,,Ол қосулы болуы керек.
Dialogue: 0,0:14:25.86,0:14:27.80,Default,,0,0,0,,Сіз өмір сүресіз➡
Dialogue: 0,0:14:27.80,0:14:31.60,Default,,0,0,0,,Сіз данышпансыз.
Dialogue: 0,0:14:31.60,0:14:34.54,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:14:34.54,0:14:37.07,Default,,0,0,0,,⚟Анна Ширли? а….
Dialogue: 0,0:14:37.07,0:14:41.28,Default,,0,0,0,,Иә. екінші ойлар туралы. Фил өз хатында жазғандай, ол керемет адам.
Dialogue: 0,0:14:41.28,0:14:44.71,Default,,0,0,0,,Бұл одан да көп. Хехехе рахмет.
Dialogue: 0,0:14:44.71,0:14:46.68,Default,,0,0,0,,Мен де болжам жасайын ба?
Dialogue: 0,0:14:46.68,0:14:49.22,Default,,0,0,0,,Шашыңыз әдемі, Алек. Хехе.
Dialogue: 0,0:14:49.22,0:14:51.15,Default,,0,0,0,,Ал Алонзо, солай ма?
Dialogue: 0,0:14:51.15,0:14:53.59,Default,,0,0,0,,Әдемі мұрын иесі. Хмм.
Dialogue: 0,0:14:53.59,0:14:57.83,Default,,0,0,0,,Bolingbroke-ге қош келдіңіз. Қош келдіңіз, Энн.
Dialogue: 0,0:14:57.83,0:15:00.46,Default,,0,0,0,,Сонымен сұлу ханшайым ше?
Dialogue: 0,0:15:00.46,0:15:02.40,Default,,0,0,0,,Ата-анаңның орнында.
Dialogue: 0,0:15:02.40,0:15:05.83,Default,,0,0,0,,О! Біз қазір жақсы дос болып кеттік.
Dialogue: 0,0:15:05.83,0:15:07.77,Default,,0,0,0,,Филге қайта қош келдіңіз!
Dialogue: 0,0:15:07.77,0:15:10.10,Default,,0,0,0,,Қош келдіңіз... ri... a…. Эй Энн.
Dialogue: 0,0:15:10.10,0:15:13.01,Default,,0,0,0,,Осы екеуінің қайсысына тұрмысқа шыққаным дұрыс деп ойлайсыңдар?
Dialogue: 0,0:15:13.01,0:15:14.98,Default,,0,0,0,,Не? Хмф! Фуфу~!
Dialogue: 0,0:15:14.98,0:15:18.85,Default,,0,0,0,,Сәлем! Менің ойымша, екеуі де өте жақсы адамдар.
Dialogue: 0,0:15:18.85,0:15:22.08,Default,,0,0,0,,Бірақ бұл Филдің өзі шешуі керек нәрсе.
Dialogue: 0,0:15:22.08,0:15:24.02,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:24.02,0:15:26.25,Default,,0,0,0,,Әй, бұл үйдің орны.
Dialogue: 0,0:15:26.25,0:15:28.49,Default,,0,0,0,,Ах...! рақмет сізге!
Dialogue: 0,0:15:28.49,0:15:30.46,Default,,0,0,0,,А... ақыры келді.
Dialogue: 0,0:15:30.46,0:15:34.90,Default,,0,0,0,,Иә, мен бақыттымын, әрине. Мен оны асыға күтемін.
Dialogue: 0,0:15:34.90,0:15:37.47,Default,,0,0,0,,Қарсы болмасаңыз, мен сізге еріп жүре аламын ба?
Dialogue: 0,0:15:37.47,0:15:42.24,Default,,0,0,0,,Шынымен!? Мен сіздің идеалдарыңыз әлі де тірі және жақсы екенін көргім келеді.
Dialogue: 0,0:15:42.24,0:15:45.71,Default,,0,0,0,,Мен сізге бір жақсылық сұрағым келеді! Филмен➡
Dialogue: 0,0:15:45.71,0:15:48.24,Default,,0,0,0,,Менің қиялым қаншалықты алыс болса да➡
Dialogue: 0,0:15:48.24,0:15:51.25,Default,,0,0,0,,Орындалуы мүмкін деп ойлайтын нәрсе!
Dialogue: 0,0:15:51.25,0:15:54.05,Default,,0,0,0,,Хэхе! Ал, бүгін кешке экономика туралы сөйлесейік➡
Dialogue: 0,0:15:54.05,0:15:56.38,Default,,0,0,0,,Барынша шу шығарайық! Ахаха!
Dialogue: 0,0:15:56.38,0:15:58.32,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:15:58.32,0:16:00.32,Default,,0,0,0,,Фил Бұл тамаша! Ахаха!
Dialogue: 0,0:16:00.32,0:16:02.32,Default,,0,0,0,,Аха! Хехе! (қол шапалақтайды)
Dialogue: 0,0:16:02.32,0:16:06.19,Default,,0,0,0,,Ахахаха! Хехе! О, тамаша! Қараңдар!
Dialogue: 0,0:16:06.19,0:16:08.36,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:08.36,0:16:10.30,Default,,0,0,0,,Жүрек үні Анна... Өтінемін, сіз➡
Dialogue: 0,0:16:10.30,0:16:16.00,Default,,0,0,0,,Ертең... Сіз әдемі естеліктер табасыз деп үміттенемін. ➡
Dialogue: 0,0:16:16.00,0:16:18.84,Default,,0,0,0,,Тіпті егер бұл...➡
Dialogue: 0,0:16:18.84,0:16:24.11,Default,,0,0,0,,Сіз не күттіңіз…➡
Dialogue: 0,0:16:24.11,0:16:26.51,Default,,0,0,0,,Тіпті басқаша болса да...
Dialogue: 0,0:16:30.89,0:16:34.09,Default,,0,0,0,,Баратын жер дәл бұрышта.
Dialogue: 0,0:16:36.49,0:16:38.86,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ, солай ма?
Dialogue: 0,0:16:38.86,0:16:41.66,Default,,0,0,0,,Әлі уақыт бар. Бүгін болмаса да...
Dialogue: 0,0:16:45.47,0:16:47.54,Default,,0,0,0,,Жүрегімде үн Бұл менің кінәм. ➡
Dialogue: 0,0:16:47.54,0:16:51.27,Default,,0,0,0,,Себебі мен сізді Bolingbroke-ке шақырдым... ➡
Dialogue: 0,0:16:51.27,0:16:56.28,Default,,0,0,0,,Мен оның көңілі қалатынын білсем де шақырдым...
Dialogue: 0,0:16:59.15,0:17:01.92,Default,,0,0,0,,Ах... у... а!
Dialogue: 0,0:17:01.92,0:17:04.32,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:17:06.15,0:17:08.09,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:17:08.09,0:17:10.09,Default,,0,0,0,,А...?
Dialogue: 0,0:17:10.09,0:17:13.49,Default,,0,0,0,,Сіздің идеалдарыңыз әдемі сақталды.
Dialogue: 0,0:17:15.43,0:17:18.33,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:17:18.33,0:17:20.74,Default,,0,0,0,,Қақпа жанындағы сирень гүлдері. ➡
Dialogue: 0,0:17:20.74,0:17:23.44,Default,,0,0,0,,Бақшада лалагүл гүлдейді➡
Dialogue: 0,0:17:23.44,0:17:26.21,Default,,0,0,0,,Терезеде ырғай жоқ➡
Dialogue: 0,0:17:26.21,0:17:28.14,Default,,0,0,0,,Муслин перделері бар. ➡
Dialogue: 0,0:17:28.14,0:17:31.05,Default,,0,0,0,,үшін күткендей!
Dialogue: 0,0:17:31.05,0:17:34.35,Default,,0,0,0,,Сіз пайғамбар болдыңыз ба?
Dialogue: 0,0:17:34.35,0:17:36.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:36.32,0:17:39.92,Default,,0,0,0,,Кенеттен болғаны үшін кешіріңіз! Біраз уақыт бұрын болды➡
Dialogue: 0,0:17:39.92,0:17:43.76,Default,,0,0,0,,Бұл үйде Ширли деген отбасы тұрған жоқ па?
Dialogue: 0,0:17:43.76,0:17:46.26,Default,,0,0,0,,Иә, Ширли және басқалар➡
Dialogue: 0,0:17:46.26,0:17:49.16,Default,,0,0,0,,Мен осыдан 20 жылдай бұрын тұрдым.
Dialogue: 0,0:17:49.16,0:17:54.47,Default,,0,0,0,,Ах...! (Үй шаруасы) Бұл жалдамалы үй. Жақсы есімде.
Dialogue: 0,0:17:54.47,0:17:57.47,Default,,0,0,0,,Екеуіміздің де қызбамыз жоқ. ➡
Dialogue: 0,0:17:57.47,0:18:02.28,Default,,0,0,0,,Мен өзімді өте нашар сезіндім. Жаңа туған нәрестені артына қалдыру. ➡
Dialogue: 0,0:18:02.28,0:18:07.52,Default,,0,0,0,,Оны маған алыстағы туысы берді, бірақ ол әлсіз бала еді. ➡
Dialogue: 0,0:18:07.52,0:18:11.32,Default,,0,0,0,,Ол баяғыда қайтыс болған болуы керек.
Dialogue: 0,0:18:11.32,0:18:14.56,Default,,0,0,0,,Бала өлген жоқ. (ханым) А?
Dialogue: 0,0:18:14.56,0:18:17.43,Default,,0,0,0,,Мен ол кезде сәби едім.
Dialogue: 0,0:18:17.43,0:18:19.36,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:18:19.36,0:18:21.33,Default,,0,0,0,,Менің атым Энн Ширли.
Dialogue: 0,0:18:21.33,0:18:25.17,Default,,0,0,0,,Әй, иә! Өсіп келе жатыр...
Dialogue: 0,0:18:25.17,0:18:29.00,Default,,0,0,0,,Енді ішке кіріңіз. Сондықтан сіз мұнда келдіңіз, солай ма? ➡
Dialogue: 0,0:18:29.00,0:18:34.38,Default,,0,0,0,,Үйдің барлық жерін қараңыз. Мінеки.
Dialogue: 0,0:18:34.38,0:18:37.04,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:18:37.04,0:18:41.55,Default,,0,0,0,,Екінші қабаттағы шығыс бөлме - сіз туған бөлме. ➡
Dialogue: 0,0:18:41.55,0:18:44.15,Default,,0,0,0,,Біз көшкен кезде ➡
Dialogue: 0,0:18:44.15,0:18:47.56,Default,,0,0,0,,Киім мен жиһаздың барлығы сатылып кетті➡
Dialogue: 0,0:18:47.56,0:18:52.06,Default,,0,0,0,,Қазір бізде бар заттардың көпшілігі кейінірек қосқан заттар...
Dialogue: 0,0:18:54.33,0:18:56.26,Default,,0,0,0,,Жүрек үні Шағын бөлме... ➡
Dialogue: 0,0:18:56.26,0:19:00.37,Default,,0,0,0,,Грин Гейблстегі менің бөлмемнен жақсырақ...
Dialogue: 0,0:19:02.40,0:19:06.01,Default,,0,0,0,,Жүрек үні Анам да көрген көрініс.
Dialogue: 0,0:19:07.54,0:19:10.24,Default,,0,0,0,,Жүрек үні Осы терезеден түскен күн сәулесі➡
Dialogue: 0,0:19:10.24,0:19:15.15,Default,,0,0,0,,Мен жаңа туғанда анам екеумізге жарқырап тұрған шығар...
Dialogue: 0,0:19:17.75,0:19:20.65,Default,,0,0,0,,Жүрегімдегі дауыс: Мені анам осы бөлмеде дүниеге әкелді➡
Dialogue: 0,0:19:20.65,0:19:24.36,Default,,0,0,0,,Ол көп ұзамай қайтыс болды. ➡
Dialogue: 0,0:19:24.36,0:19:29.46,Default,,0,0,0,,Мен қазіргіден жас болуым керек еді.
Dialogue: 0,0:19:31.13,0:19:33.13,Default,,0,0,0,,Бұл. ➡
Dialogue: 0,0:19:33.13,0:19:36.77,Default,,0,0,0,,Оны екінші қабаттағы шкафтан таптым. Мына жерге қара. ➡
Dialogue: 0,0:19:36.77,0:19:39.57,Default,,0,0,0,,"Мисс Берта Уиллис" мекенжайы.
Dialogue: 0,0:19:39.57,0:19:41.54,Default,,0,0,0,,Ах... Уиллис бұл➡
Dialogue: 0,0:19:41.54,0:19:43.78,Default,,0,0,0,,Бұл менің анамның тұрмысқа шыққанға дейінгі есімі.
Dialogue: 0,0:19:43.78,0:19:46.01,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:19:46.01,0:19:49.65,Default,,0,0,0,,Менде анамның ешбір заты жоқ.
Dialogue: 0,0:19:49.65,0:19:51.59,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:19:51.59,0:19:53.65,Default,,0,0,0,,Әдептілікке жақындамайды.
Dialogue: 0,0:19:53.65,0:19:56.09,Default,,0,0,0,,Солай болса да, көздерің➡
Dialogue: 0,0:19:56.09,0:19:58.13,Default,,0,0,0,,Ол анасына ұқсайды. ➡
Dialogue: 0,0:19:58.13,0:20:00.39,Default,,0,0,0,,Менің шашымның түсі әкемдікі. ➡
Dialogue: 0,0:20:00.39,0:20:02.66,Default,,0,0,0,,Олар жақсы жұп болды. ➡
Dialogue: 0,0:20:02.66,0:20:06.10,Default,,0,0,0,,Өкінішке орай, мен көп өмір сүрген жоқпын➡
Dialogue: 0,0:20:06.10,0:20:09.77,Default,,0,0,0,,Тірі кезінде бақытты болып көрінді. ➡
Dialogue: 0,0:20:09.77,0:20:14.28,Default,,0,0,0,,Менің ойымша, бұл маңызды нәрсе.
Dialogue: 0,0:20:16.51,0:20:21.78,Default,,0,0,0,,Мүмкін мен оны шкафтан бір жерден іздеп көруім керек шығар.
Dialogue: 0,0:20:21.78,0:20:25.29,Default,,0,0,0,,<үшін 12 әріп бар. ➡
Dialogue: 0,0:20:25.29,0:20:28.79,Default,,0,0,0,,Келісілген кезде➡
Dialogue: 0,0:20:28.79,0:20:30.86,Default,,0,0,0,,Кейбіреулері менің әкем➡
Dialogue: 0,0:20:30.86,0:20:35.56,Default,,0,0,0,,Олардың кейбірін анам жазған＞
Dialogue: 0,0:20:35.56,0:20:38.07,Default,,0,0,0,,«Берта Ширли».
Dialogue: 0,0:20:38.07,0:20:43.07,Default,,0,0,0,,Бұл ананың сен үйленгеннен кейін жіберген хаты.
Dialogue: 0,0:20:45.84,0:20:47.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:54.52,0:20:57.32,Default,,0,0,0,,«Анна өте ақылды бала.➡
Dialogue: 0,0:20:57.32,0:20:59.95,Default,,0,0,0,,Жігерлі, мейірімді және жылы➡
Dialogue: 0,0:20:59.95,0:21:02.69,Default,,0,0,0,,Тізім шексіз. ➡
Dialogue: 0,0:21:02.69,0:21:05.56,Default,,0,0,0,,Мен ұйықтап жатқанда мына бала➡
Dialogue: 0,0:21:05.56,0:21:09.10,Default,,0,0,0,,Менің ойымша, бұл ең сүйкімді». Уф... Уф...
Dialogue: 0,0:21:09.10,0:21:11.13,Default,,0,0,0,,«Мен ояу болғанда➡
Dialogue: 0,0:21:11.13,0:21:13.27,Default,,0,0,0,,Менің ойымша, бұл одан да сүйкімді.''
Dialogue: 0,0:21:13.27,0:21:16.17,Default,,0,0,0,,Хехе. …а.
Dialogue: 0,0:21:21.71,0:21:24.08,Default,,0,0,0,,Рахмет Фил.
Dialogue: 0,0:21:24.08,0:21:28.48,Default,,0,0,0,,Бүгін менің өмірімдегі ең әдемі күн.
Dialogue: 0,0:21:28.48,0:21:31.72,Default,,0,0,0,,Мен әкем мен анамды таптым.
Dialogue: 0,0:21:31.72,0:21:34.76,Default,,0,0,0,,Үйдің жағдайын да тамаша таптың.
Dialogue: 0,0:21:34.76,0:21:38.29,Default,,0,0,0,,Томастың анасының айтқанына сенімдімін➡
Dialogue: 0,0:21:38.29,0:21:41.73,Default,,0,0,0,,Мен бұл жай ғана менің қиялым деп ойладым.
Dialogue: 0,0:21:41.73,0:21:45.60,Default,,0,0,0,,Бірақ мен енді жетім емеспін.
Dialogue: 0,0:21:45.60,0:21:47.60,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:47.60,0:21:52.21,Default,,0,0,0,,Кітапты ашқандай жүрек үні➡
Dialogue: 0,0:21:52.21,0:21:56.11,Default,,0,0,0,,Кешегі раушан гүлдері нәзік және сүйкімді➡
Dialogue: 0,0:21:56.11,0:21:58.98,Default,,0,0,0,,Беттердің арасында не қалды➡
Dialogue: 0,0:21:58.98,0:22:01.28,Default,,0,0,0,,Мен таптым...
Dialogue: 0,0:22:01.28,0:22:03.68,Default,,0,0,0,,♬～
Dialogue: 0,0:22:05.85,0:22:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.03,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің нені қалайды, соған қарай жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:51.43,0:23:57.23,Default,,0,0,0,,♬～
