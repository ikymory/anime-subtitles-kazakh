Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:03.60,Default,,0,0,0,,♬～
Dialogue: 0,0:00:03.60,0:00:06.50,Default,,0,0,0,,Редмонд университетіне келгеніме <3 апта болды. ➡
Dialogue: 0,0:00:06.50,0:00:09.77,Default,,0,0,0,,Мен Филиппаны кездестіріп, бірден дос болдым➡
Dialogue: 0,0:00:09.77,0:00:14.08,Default,,0,0,0,,Менің мазасыз студенттік өмірім бірқалыпты басталды>
Dialogue: 0,0:00:16.01,0:00:18.58,Default,,0,0,0,,Я~! Сен білесің бе?
Dialogue: 0,0:00:18.58,0:00:21.58,Default,,0,0,0,,Филипп - ауқатты отбасынан шыққан жас ханым.
Dialogue: 0,0:00:21.58,0:00:24.92,Default,,0,0,0,,Ол әдемі, ақылды, жақсы отбасынан шыққан.
Dialogue: 0,0:00:24.92,0:00:26.86,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:00:26.86,0:00:28.82,Default,,0,0,0,,Уф.
Dialogue: 0,0:00:28.82,0:00:31.03,Default,,0,0,0,,Уау! Хехехе.
Dialogue: 0,0:00:31.03,0:00:32.96,Default,,0,0,0,,Уау….
Dialogue: 0,0:00:32.96,0:00:37.80,Default,,0,0,0,,Әзірге Алек пен Алонцоның мықты қарсыластары жоқ сияқты.
Dialogue: 0,0:00:37.80,0:00:40.04,Default,,0,0,0,,Не? сол.
Dialogue: 0,0:00:40.04,0:00:41.97,Default,,0,0,0,,Апта сайын екеумізге➡
Dialogue: 0,0:00:41.97,0:00:45.97,Default,,0,0,0,,Ол Филге табынатын ұлдар туралы әңгімелер жазып, оларды оған жіберетінін айтады.
Dialogue: 0,0:00:45.97,0:00:48.31,Default,,0,0,0,,Бұл мені алаңдатпайды.
Dialogue: 0,0:00:48.31,0:00:53.52,Default,,0,0,0,,Иә. Бірақ мені ұнатамын деп ойлайтындар менімен санаспайды.
Dialogue: 0,0:00:53.52,0:00:56.42,Default,,0,0,0,,Кім? Гилберт Блайт бұл➡
Dialogue: 0,0:00:56.42,0:00:58.99,Default,,0,0,0,,Сіз маған тек сүйкімді котенок сияқты қарай аласыз➡
Dialogue: 0,0:00:58.99,0:01:00.92,Default,,0,0,0,,Мен олай ойламаймын. ➡
Dialogue: 0,0:01:00.92,0:01:03.96,Default,,0,0,0,,Аудармасы, әрине... Энн Ширли?
Dialogue: 0,0:01:03.96,0:01:06.19,Default,,0,0,0,,Жақсы ма? толтыру.
Dialogue: 0,0:01:06.19,0:01:08.26,Default,,0,0,0,,Гилберт екеуміздің арамызда ештеңе жоқ.
Dialogue: 0,0:01:08.26,0:01:12.47,Default,,0,0,0,,Мен білемін. Мен сені әлі де жек көремін.
Dialogue: 0,0:01:12.47,0:01:17.27,Default,,0,0,0,,Не? Мен сені одан сайын жек көруім керек➡
Dialogue: 0,0:01:17.27,0:01:20.24,Default,,0,0,0,,Мен сені шексіз жақсы көремін➡
Dialogue: 0,0:01:20.24,0:01:22.48,Default,,0,0,0,,Анна ханшайымы. ➡
Dialogue: 0,0:01:22.48,0:01:24.48,Default,,0,0,0,,Присси сен де.
Dialogue: 0,0:01:24.48,0:01:27.38,Default,,0,0,0,,Рахмет Фил. Екеуің ше?
Dialogue: 0,0:01:27.38,0:01:31.19,Default,,0,0,0,,Сен мені кішкене болса да жақсы көресің бе?
Dialogue: 0,0:01:31.19,0:01:33.16,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:01:33.16,0:01:35.16,Default,,0,0,0,,Мен сені сүйемін, Фил. Хехе.
Dialogue: 0,0:01:35.16,0:01:39.29,Default,,0,0,0,,Ол сүйкімді, жұмсақ және сүйкімді котенка.
Dialogue: 0,0:01:39.29,0:01:48.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:48.30,0:01:53.08,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:01:53.08,0:01:55.51,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:01:55.51,0:01:57.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:01:57.51,0:02:01.32,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:01.32,0:02:03.69,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:03.69,0:02:05.92,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:05.92,0:02:10.46,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:10.46,0:02:15.66,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:15.66,0:02:17.60,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:17.60,0:02:21.47,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:21.47,0:02:24.87,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:24.87,0:02:27.31,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:27.31,0:02:29.58,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:29.58,0:02:33.82,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:33.82,0:02:36.28,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:36.28,0:02:38.62,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:38.62,0:02:42.09,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:42.09,0:02:45.39,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:45.39,0:02:47.63,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:47.63,0:02:51.90,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:02:51.90,0:02:54.40,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:54.40,0:02:56.71,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:02:56.71,0:02:58.71,Default,,0,0,0,,♬ «Мен сені алып кетейін.»
Dialogue: 0,0:02:58.71,0:03:03.01,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:03.01,0:03:06.92,Default,,0,0,0,,♬～
Dialogue: 0,0:03:09.58,0:03:13.69,Default,,0,0,0,,♬～
Dialogue: 0,0:03:17.13,0:03:19.46,Default,,0,0,0,,Ауыр емес пе?
Dialogue: 0,0:03:19.46,0:03:23.33,Default,,0,0,0,,Жоқ, мүлде емес. Филипп болса...
Dialogue: 0,0:03:23.33,0:03:25.90,Default,,0,0,0,,Жарайды. Бұл жай ғана жақсы жаттығу.
Dialogue: 0,0:03:25.90,0:03:29.24,Default,,0,0,0,,Егер сіз осылай ойласаңыз, жүкті тасымалдау соншалықты жаман емес.
Dialogue: 0,0:03:29.24,0:03:31.27,Default,,0,0,0,,Онда мен осында қаламын.
Dialogue: 0,0:03:31.27,0:03:34.58,Default,,0,0,0,,А... неге? Тоқтауға болатын шағын жер...
Dialogue: 0,0:03:34.58,0:03:37.91,Default,,0,0,0,,Рахмет, Гилберт. оқасы жоқ.
Dialogue: 0,0:03:37.91,0:03:41.28,Default,,0,0,0,,Кездескенше, Энн. Хехе, ертең кездескенше.
Dialogue: 0,0:03:41.28,0:03:43.62,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:03:43.62,0:03:48.39,Default,,0,0,0,,Ол керемет. Барлық сабақтарда жақсы нәтижелер бар.
Dialogue: 0,0:03:48.39,0:03:53.36,Default,,0,0,0,,Иә, мен оқыған кезде бұл толық жұмбақ.
Dialogue: 0,0:03:53.36,0:03:57.00,Default,,0,0,0,,Мен Энннің де ағылшын әдебиеті бойынша өз сыныбының жоғарғы жағында екенін естідім.
Dialogue: 0,0:03:57.00,0:03:59.53,Default,,0,0,0,,Мүмкін Avonlea➡
Dialogue: 0,0:03:59.53,0:04:02.24,Default,,0,0,0,,Бәлкім, біреумен жанталасып жарысқандықтан шығар.
Dialogue: 0,0:04:02.24,0:04:06.11,Default,,0,0,0,,Гилберт те бірінші курстың президенті болып сайланды, солай ма?
Dialogue: 0,0:04:06.11,0:04:08.58,Default,,0,0,0,,Барлығының ұсыныстарына рахмет.
Dialogue: 0,0:04:08.58,0:04:10.95,Default,,0,0,0,,Бұл үлкен құрмет.
Dialogue: 0,0:04:10.95,0:04:15.25,Default,,0,0,0,,Сондықтан мені Рамус➡ деп аталатын түлектер қауымдастығына шақырды
Dialogue: 0,0:04:15.25,0:04:18.85,Default,,0,0,0,,Қосылу үшін белгілі бір ырым бар.
Dialogue: 0,0:04:18.85,0:04:20.79,Default,,0,0,0,,Ритуал?
Dialogue: 0,0:04:20.79,0:04:23.29,Default,,0,0,0,,Күндізгі уақытта қала орталығы...
Dialogue: 0,0:04:25.03,0:04:27.93,Default,,0,0,0,,Уф.
Dialogue: 0,0:04:27.93,0:04:30.40,Default,,0,0,0,,О! (қол шапалақтау)
Dialogue: 0,0:04:30.40,0:04:34.27,Default,,0,0,0,,Ахахха! Маған айтсаң, көруге барар едім.
Dialogue: 0,0:04:34.27,0:04:39.04,Default,,0,0,0,,Бұл бір күн, солай ма? Бір джентльмен маған қатты қиналып жатты.
Dialogue: 0,0:04:39.04,0:04:41.51,Default,,0,0,0,,Жоқ! Хехехехе! Хахаха!
Dialogue: 0,0:04:41.51,0:04:44.05,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:04:44.05,0:04:49.22,Default,,0,0,0,,Мені қазір ең бақытты ететін нәрсе – Авонлидан хат алу.
Dialogue: 0,0:04:49.22,0:04:52.69,Default,,0,0,0,,Линд ханымның хаты ерекше қызық болды.
Dialogue: 0,0:04:52.69,0:04:55.02,Default,,0,0,0,,«Орын бос болды➡
Dialogue: 0,0:04:55.02,0:04:57.93,Default,,0,0,0,,Авонлеа шіркеуінің кедей пасторы туралы➡
Dialogue: 0,0:04:57.93,0:05:00.33,Default,,0,0,0,,Мен қатты ашуландым. ➡
Dialogue: 0,0:05:00.33,0:05:04.13,Default,,0,0,0,,Ол уағыз өте қызық. ➡
Dialogue: 0,0:05:04.13,0:05:06.07,Default,,0,0,0,,Сонымен қатар, “Киелі кітап” деген не➡
Dialogue: 0,0:05:06.07,0:05:08.97,Default,,0,0,0,,Бір-біріне мүлдем қатысы жоқ нәрселер туралы айтқаныңды кешіре алмаймын».
Dialogue: 0,0:05:08.97,0:05:13.14,Default,,0,0,0,,Ал, келесі аптада біз жүзу балтасының басы туралы айтатын боламыз.
Dialogue: 0,0:05:13.14,0:05:16.58,Default,,0,0,0,,«Дегенмен, әр адамның өзінің күшті жақтары бар сияқты➡
Dialogue: 0,0:05:16.58,0:05:19.01,Default,,0,0,0,,Бір күні Харрисон мырзаның үйінде шошқа➡
Dialogue: 0,0:05:19.01,0:05:22.28,Default,,0,0,0,,Мен бірде шіркеуге кіріп кеттім».
Dialogue: 0,0:05:22.28,0:05:25.15,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:25.15,0:05:30.56,Default,,0,0,0,,Иә? (Миссис Линд) ``Мына бейшара шошқа сонша қорқып кетті...''
Dialogue: 0,0:05:30.56,0:05:33.46,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:05:33.46,0:05:38.03,Default,,0,0,0,,`` Пастор шошқаның арқасына жақсы жабысады➡
Dialogue: 0,0:05:38.03,0:05:40.37,Default,,0,0,0,,Мен басқа ештеңе көрген жоқпын. ➡
Dialogue: 0,0:05:40.37,0:05:42.90,Default,,0,0,0,,Мен оны Эннге де көрсеткім келді».
Dialogue: 0,0:05:42.90,0:05:46.27,Default,,0,0,0,,Хэхехе! Хахаха! Сізді күлдіргенім үшін кешіріңіз.
Dialogue: 0,0:05:46.27,0:05:48.91,Default,,0,0,0,,Дэвидің хаттары да сүйкімді.
Dialogue: 0,0:05:48.91,0:05:51.38,Default,,0,0,0,,«Себебі Энн апа мұнда жоқ➡
Dialogue: 0,0:05:51.38,0:05:53.82,Default,,0,0,0,,Мен өзімді өте жалғыз сезінемін. ➡
Dialogue: 0,0:05:53.82,0:05:55.78,Default,,0,0,0,,Бірақ мектеп қызық.''
Dialogue: 0,0:05:55.78,0:05:58.02,Default,,0,0,0,,Иә. (Джейн Эндрюс) Ах!
Dialogue: 0,0:05:58.02,0:06:01.56,Default,,0,0,0,,«Мистер. Джейн менің әпкемнен де қорқынышты.➡
Dialogue: 0,0:06:01.56,0:06:05.43,Default,,0,0,0,,Мен Линд анаға өзім жасаған шамдарды көрсеттім.''
Dialogue: 0,0:06:05.43,0:06:08.33,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:06:08.33,0:06:11.03,Default,,0,0,0,,«Марилла маған қатты ашуланды.➡
Dialogue: 0,0:06:11.03,0:06:14.77,Default,,0,0,0,,Жақсы жұмыс істегенде неге ашуланасың? ➡
Dialogue: 0,0:06:14.77,0:06:17.67,Default,,0,0,0,,Сосын пастор ана Линдке...''
Dialogue: 0,0:06:17.67,0:06:20.44,Default,,0,0,0,,Мен үшін дұға ет!
Dialogue: 0,0:06:20.44,0:06:22.38,Default,,0,0,0,,«Сіз айттыңыз...➡
Dialogue: 0,0:06:22.38,0:06:24.31,Default,,0,0,0,,Қандай жамандық жасады деп ойлаймын. ➡
Dialogue: 0,0:06:24.31,0:06:26.68,Default,,0,0,0,,Мен білгім келеді».
Dialogue: 0,0:06:26.68,0:06:29.22,Default,,0,0,0,,Мен де білгім келеді.
Dialogue: 0,0:06:29.22,0:06:31.15,Default,,0,0,0,,Марилланың хатынан➡
Dialogue: 0,0:06:31.15,0:06:34.36,Default,,0,0,0,,Сіз тіпті Green Gables иісін де сезе аласыз. Иә.
Dialogue: 0,0:06:34.36,0:06:36.99,Default,,0,0,0,,Диананың хаттары Фред туралы.
Dialogue: 0,0:06:36.99,0:06:39.26,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:06:39.26,0:06:41.63,Default,,0,0,0,,Жүрек үні Хэхе... Рубиден...
Dialogue: 0,0:06:41.63,0:06:45.07,Default,,0,0,0,,Рефлексия (Руби Гиллис) «Редмондта барлығы өте көңілді болып жатқан сияқты.➡
Dialogue: 0,0:06:45.07,0:06:47.47,Default,,0,0,0,,Гилберттің хатында жазылған.
Dialogue: 0,0:06:47.47,0:06:52.31,Default,,0,0,0,,Гилберт? Гилберт Рубиге хат жазып жатыр ма?
Dialogue: 0,0:06:52.31,0:06:55.08,Default,,0,0,0,,Жүрегімдегі дауыс: Әрине маңызды емес, жарай ма? ➡
Dialogue: 0,0:06:55.08,0:06:57.61,Default,,0,0,0,,Әркімнің мұндай құқығы бар.
Dialogue: 0,0:06:57.61,0:07:00.32,Default,,0,0,0,,Анна? Ах.
Dialogue: 0,0:07:00.32,0:07:03.22,Default,,0,0,0,,Ах... а, Руби бұл➡
Dialogue: 0,0:07:03.22,0:07:05.75,Default,,0,0,0,,Ол менімен кездесуге шыдамайтынын жазды.
Dialogue: 0,0:07:05.75,0:07:08.19,Default,,0,0,0,,Аха! Рубиге ұқсайды.
Dialogue: 0,0:07:08.19,0:07:11.09,Default,,0,0,0,,Барлығының жақсы болғанына қуаныштымын.
Dialogue: 0,0:07:11.09,0:07:13.43,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:13.43,0:07:16.20,Default,,0,0,0,,Авонлеа теңіздің арғы жағында.
Dialogue: 0,0:07:16.20,0:07:20.64,Default,,0,0,0,,Бұл ұзақ жол... бірақ әріптер бізді дұрыс байланыстырып тұр.
Dialogue: 0,0:07:20.64,0:07:24.24,Default,,0,0,0,,Жүрек дауысы: Мен Avonlea➡-ға жақынмын
Dialogue: 0,0:07:24.24,0:07:28.58,Default,,0,0,0,,Мүмкін бұл тек әріптердің құдіреті емес шығар.
Dialogue: 0,0:07:28.58,0:07:30.51,Default,,0,0,0,,Тіпті солай➡
Dialogue: 0,0:07:30.51,0:07:33.28,Default,,0,0,0,,Шошқа пасторды арқасына салып жүгіреді...
Dialogue: 0,0:07:33.28,0:07:35.85,Default,,0,0,0,,Ахахха! Фуфуфуфуфуфу!
Dialogue: 0,0:07:35.85,0:07:39.22,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:07:39.22,0:07:41.96,Default,,0,0,0,,О, бұл дұрыс болды.
Dialogue: 0,0:07:41.96,0:07:44.79,Default,,0,0,0,,Біз саябаққа барғалы жатырмыз.
Dialogue: 0,0:07:44.79,0:07:48.36,Default,,0,0,0,,Гилберт пен Чарли де. Бізге қосылғың келе ме, Фил?
Dialogue: 0,0:07:48.36,0:07:51.17,Default,,0,0,0,,Екі жұп құрылды➡
Dialogue: 0,0:07:51.17,0:07:53.87,Default,,0,0,0,,Сондықтан мен жай қызметшімін.
Dialogue: 0,0:07:53.87,0:07:55.80,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:07:55.80,0:07:59.04,Default,,0,0,0,,Жарайды. Филипп Гордон үшін бұл жаңа тәжірибе.
Dialogue: 0,0:07:59.04,0:08:01.41,Default,,0,0,0,,Ах…. Не болды?
Dialogue: 0,0:08:01.41,0:08:05.05,Default,,0,0,0,,Бүгін таңертең мен Алек пен Алонзодан хат алдым.
Dialogue: 0,0:08:05.05,0:08:07.08,Default,,0,0,0,,Екеуі қатты ашуланды. ➡
Dialogue: 0,0:08:07.08,0:08:11.52,Default,,0,0,0,,Менде Алонцоға арналған конвертте Алекке арналған хат бар сияқты...
Dialogue: 0,0:08:11.52,0:08:13.86,Default,,0,0,0,,Жақсы...! Алек➡ атына жазылған конвертте
Dialogue: 0,0:08:13.86,0:08:16.66,Default,,0,0,0,,Ол Алонцо үшін хат салып, жіберген сияқты.
Dialogue: 0,0:08:16.66,0:08:18.59,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:08:18.59,0:08:22.16,Default,,0,0,0,,Әрине, екеуің де көп ұзамай мұндай нәрселерге мән беруді қоясыңдар➡
Dialogue: 0,0:08:22.16,0:08:26.03,Default,,0,0,0,,Тіпті олай болмаса да, маған бәрібір ➡
Dialogue: 0,0:08:26.03,0:08:30.37,Default,,0,0,0,,Мен осында келіп, көңіліңді сәл көтерейін деп ойладым.
Dialogue: 0,0:08:30.37,0:08:32.74,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:08:32.74,0:08:35.48,Default,,0,0,0,,Иә, бұл жылдамдықтың өзгеруі болады.
Dialogue: 0,0:08:35.48,0:08:38.38,Default,,0,0,0,,Иә. Мен мұны істей аламын ба деп ойлаймын.
Dialogue: 0,0:08:38.38,0:08:41.28,Default,,0,0,0,,Бірақ Энн, сіздің Гилбертіңіз➡
Dialogue: 0,0:08:41.28,0:08:45.09,Default,,0,0,0,,Неліктен Чарли сияқты біртүрлі адамдармен бірге боласың?
Dialogue: 0,0:08:45.09,0:08:48.66,Default,,0,0,0,,Чарли мен Гилберт көптен бері дос.
Dialogue: 0,0:08:48.66,0:08:51.89,Default,,0,0,0,,Бұлай айтпа.
Dialogue: 0,0:08:51.89,0:08:57.73,Default,,0,0,0,,♬～
Dialogue: 0,0:08:57.73,0:09:00.07,Default,,0,0,0,,Бүгін өте тұман.
Dialogue: 0,0:09:00.07,0:09:02.70,Default,,0,0,0,,Бұл аймақ Гольфстриммен жылы➡
Dialogue: 0,0:09:02.70,0:09:05.61,Default,,0,0,0,,Лабрадордың суық ағысы осы жерде соқтығысады➡
Dialogue: 0,0:09:05.61,0:09:08.04,Default,,0,0,0,,Кейде айсбергтер де кездеседі.
Dialogue: 0,0:09:08.04,0:09:10.71,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:09:10.71,0:09:14.55,Default,,0,0,0,,Бұл сізге керемет емес пе? Эй?
Dialogue: 0,0:09:14.55,0:09:16.52,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:09:16.52,0:09:19.89,Default,,0,0,0,,Анна бала кезінен біреуді жақсы көрсе керек.
Dialogue: 0,0:09:19.89,0:09:23.63,Default,,0,0,0,,Керемет аранжировка ма? Бұл сәл басқаша.
Dialogue: 0,0:09:23.63,0:09:27.50,Default,,0,0,0,,Ол адам әлі пайда болған жоқ. Хмм?
Dialogue: 0,0:09:27.50,0:09:34.27,Default,,0,0,0,,♬～
Dialogue: 0,0:09:34.27,0:09:36.87,Default,,0,0,0,,Біздің пансионат қайда?
Dialogue: 0,0:09:36.87,0:09:39.77,Default,,0,0,0,,Өйткені бұл Редмонд университеті…➡
Dialogue: 0,0:09:39.77,0:09:42.08,Default,,0,0,0,,Бұл сол жерде ме? (Присцилла Энн) Хэхехе.
Dialogue: 0,0:09:42.08,0:09:45.58,Default,,0,0,0,,Иә. Неліктен үйге бара жатқанда Споффорд-стрит арқылы өтпейсіз?
Dialogue: 0,0:09:45.58,0:09:49.45,Default,,0,0,0,,Дворяндар тұратын әдемі сарайларды көруге болады.
Dialogue: 0,0:09:49.45,0:09:51.79,Default,,0,0,0,,Жақсы. Олай болса➡
Dialogue: 0,0:09:51.79,0:09:54.59,Default,,0,0,0,,Менің саған көрсеткім келетін үйім бар.
Dialogue: 0,0:09:54.59,0:09:57.36,Default,,0,0,0,,Бұл жасалған нәрсе емес.
Dialogue: 0,0:09:57.36,0:10:00.56,Default,,0,0,0,,Nyokinyoki Ол өсірілді.
Dialogue: 0,0:10:04.93,0:10:07.27,Default,,0,0,0,,Қанша жұмыс істеу керек➡
Dialogue: 0,0:10:07.27,0:10:09.87,Default,,0,0,0,,Мен осындай үйде тұра аламын ба деп ойлаймын...
Dialogue: 0,0:10:09.87,0:10:13.31,Default,,0,0,0,,Фил Бізге қандай үйді көрсеткіңіз келеді?
Dialogue: 0,0:10:13.31,0:10:15.24,Default,,0,0,0,,Бұдан былай.
Dialogue: 0,0:10:15.24,0:10:17.25,Default,,0,0,0,,Уау...!
Dialogue: 0,0:10:17.25,0:10:19.48,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:19.48,0:10:21.48,Default,,0,0,0,,Қандай сүйкімді үй!
Dialogue: 0,0:10:21.48,0:10:24.15,Default,,0,0,0,,Бұл Лаванданың тас үйіндей жақсы.
Dialogue: 0,0:10:24.15,0:10:27.79,Default,,0,0,0,,Аты да жақсы. Келіңіздер, бұл Сидаркрофттар отбасы➡
Dialogue: 0,0:10:27.79,0:10:30.63,Default,,0,0,0,,Бұл Споффорд көшесі керемет заттармен қапталған➡
Dialogue: 0,0:10:30.63,0:10:32.89,Default,,0,0,0,,«Пэттидің үйі»?
Dialogue: 0,0:10:32.89,0:10:34.83,Default,,0,0,0,,Пэттидің үйі! Апыр-ай!
Dialogue: 0,0:10:34.83,0:10:37.30,Default,,0,0,0,,Онда қандай адамдар тұрады?
Dialogue: 0,0:10:37.30,0:10:41.54,Default,,0,0,0,,Патти Споффорд деген кемпір жиенімен бірге тұрады.
Dialogue: 0,0:10:41.54,0:10:45.84,Default,,0,0,0,,Споффорд? иә. Мен оны мұқият зерттедім.
Dialogue: 0,0:10:45.84,0:10:49.41,Default,,0,0,0,,Бұл қалада 100 жыл бұрын салынған бірінші үй болды.
Dialogue: 0,0:10:49.41,0:10:51.41,Default,,0,0,0,,100 жыл? Мүмкін емес.
Dialogue: 0,0:10:51.41,0:10:54.38,Default,,0,0,0,,Одан да қысқарақ шығар➡
Dialogue: 0,0:10:54.38,0:10:56.62,Default,,0,0,0,,Асыра сілтеу - бұл ➡
Dialogue: 0,0:10:56.62,0:10:59.29,Default,,0,0,0,,Поэтикалық қиялдың секірісі, Чарли?
Dialogue: 0,0:10:59.29,0:11:02.19,Default,,0,0,0,,Бұл үй осы қаланың тарихының бір бөлігі.
Dialogue: 0,0:11:02.19,0:11:05.39,Default,,0,0,0,,Иә, қанша бай келсе де➡
Dialogue: 0,0:11:05.39,0:11:08.30,Default,,0,0,0,,Патти әже оны ешқашан сатпақ болған емес.
Dialogue: 0,0:11:08.30,0:11:11.60,Default,,0,0,0,,О, қарашы, Анн, алма бағы бар.
Dialogue: 0,0:11:11.60,0:11:16.40,Default,,0,0,0,,Жақсы! Споффорд-стритте ешкімге ұқсамайтын алма бағы бар.
Dialogue: 0,0:11:16.40,0:11:20.11,Default,,0,0,0,,Мен бүгін түнде осы үй туралы түс көремін.
Dialogue: 0,0:11:20.11,0:11:23.01,Default,,0,0,0,,Мүмкін бір күні мен үйдің ішін көретін шығармын.
Dialogue: 0,0:11:23.01,0:11:24.98,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:11:24.98,0:11:27.58,Default,,0,0,0,,Иә, мүмкін емес.
Dialogue: 0,0:11:27.58,0:11:31.59,Default,,0,0,0,,Бірақ бұл біртүрлі діріл... оны алдын ала ескерту деуге болады.
Dialogue: 0,0:11:31.59,0:11:33.79,Default,,0,0,0,,Пэттидің үйі және мен➡
Dialogue: 0,0:11:33.79,0:11:37.69,Default,,0,0,0,,Мен болашақта бұдан да жақын болатындай сезінемін.
Dialogue: 0,0:11:39.49,0:11:43.20,Default,,0,0,0,,♬～
Dialogue: 0,0:11:45.20,0:11:47.60,Default,,0,0,0,,Әйтеуір қорытынды емтиханнан аман қалдым➡
Dialogue: 0,0:11:47.60,0:11:50.31,Default,,0,0,0,,Ертеңнен бастап, бұл Рождестволық демалыс!
Dialogue: 0,0:11:50.31,0:11:54.21,Default,,0,0,0,,Мен ертең осы уақытқа дейін Грин Гейблске оралатыныма сене алар емеспін➡
Dialogue: 0,0:11:54.21,0:11:56.78,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:11:56.78,0:11:58.91,Default,,0,0,0,,Ата-анамның үйіне соңғы рет бармағаныма біраз болды.
Dialogue: 0,0:11:58.91,0:12:01.82,Default,,0,0,0,,Фил Алек пен Алонзомен бірге уақыт өткізеді, солай емес пе?
Dialogue: 0,0:12:01.82,0:12:06.22,Default,,0,0,0,,Иә, сенің үйге келгеніңді күте алмаймын.
Dialogue: 0,0:12:06.22,0:12:11.99,Default,,0,0,0,,Бітпейтін билер, ұзын атпен жүру және ішімдік ішу!
Dialogue: 0,0:12:11.99,0:12:14.70,Default,,0,0,0,,Ахахха! Анн.
Dialogue: 0,0:12:14.70,0:12:17.47,Default,,0,0,0,,Менімен бірге Болингбрукке келмегеніңді қалаймын➡
Dialogue: 0,0:12:17.47,0:12:19.40,Default,,0,0,0,,Негізі мен сені кешірмеймін.
Dialogue: 0,0:12:19.40,0:12:22.44,Default,,0,0,0,,Хехе, иә, мен бір күні сонда барғым келеді.
Dialogue: 0,0:12:22.44,0:12:26.47,Default,,0,0,0,,Олай болса...! Бірақ қазір емес. Мен үйге баруым керек.
Dialogue: 0,0:12:26.47,0:12:29.28,Default,,0,0,0,,Үйді сағындым➡
Dialogue: 0,0:12:29.28,0:12:31.35,Default,,0,0,0,,Сіз түсінбейсіз, Фил.
Dialogue: 0,0:12:31.35,0:12:33.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:33.51,0:12:35.45,Default,,0,0,0,,Әжелер бәрібір өсек айтқанды жақсы көреді➡
Dialogue: 0,0:12:35.45,0:12:38.29,Default,,0,0,0,,Алдында және артында тұрып көп сөйле, солай ма?
Dialogue: 0,0:12:38.29,0:12:41.16,Default,,0,0,0,,Сіз зерігуден өлетін шығарсыз.
Dialogue: 0,0:12:41.16,0:12:43.12,Default,,0,0,0,,Avonlea-да ма? Мүмкін емес.
Dialogue: 0,0:12:43.12,0:12:46.09,Default,,0,0,0,,Егер бұл Гилбертпен болса, мен түсінемін.
Dialogue: 0,0:12:46.09,0:12:50.93,Default,,0,0,0,,Өкінішке орай, мен онымен Рождество мерекесін өткіземін деген жоспарым жоқ.
Dialogue: 0,0:12:50.93,0:12:53.84,Default,,0,0,0,,Олай болса менімен бірге жүр! ➡
Dialogue: 0,0:12:53.84,0:12:56.54,Default,,0,0,0,,Анау шаш, анау сән➡
Dialogue: 0,0:12:56.54,0:12:58.11,Default,,0,0,0,,Сіз туралы барлығы➡
Dialogue: 0,0:12:58.11,0:13:01.68,Default,,0,0,0,,Мен Болингбруктағылардың барлығының қуанатынына сенімдімін!
Dialogue: 0,0:13:01.68,0:13:06.45,Default,,0,0,0,,Филдің әлеуметтік жаулап алуды бейнелеуі керемет әсер қалдырады.
Dialogue: 0,0:13:06.45,0:13:09.35,Default,,0,0,0,,Дұрыс? Бірақ соған ұқсас сурет➡
Dialogue: 0,0:13:09.35,0:13:11.79,Default,,0,0,0,,Мен де бір сурет сала аламын.
Dialogue: 0,0:13:11.79,0:13:14.06,Default,,0,0,0,,Мен үйге бара жатырмын➡
Dialogue: 0,0:13:14.06,0:13:16.92,Default,,0,0,0,,Ескі ферма үйі...
Dialogue: 0,0:13:16.92,0:13:21.56,Default,,0,0,0,,Бастапқыда ол жасыл түсті, бірақ қазір оның түсі айтарлықтай жоғалып кетті.
Dialogue: 0,0:13:21.56,0:13:25.07,Default,,0,0,0,,Еңіспен төмен түскенде ағып жатқан бұлақты көресіз➡
Dialogue: 0,0:13:25.07,0:13:29.30,Default,,0,0,0,,Жылдың осы уақытында жақын жердегі тоған сұр болуы керек.
Dialogue: 0,0:13:29.30,0:13:33.04,Default,,0,0,0,,Үйде сәл үлкенірек екі келіншек бар➡
Dialogue: 0,0:13:33.04,0:13:34.98,Default,,0,0,0,,Менің де егіздерім бар.
Dialogue: 0,0:13:34.98,0:13:37.05,Default,,0,0,0,,Біреуі мінсіз үлгілі оқушы.
Dialogue: 0,0:13:37.05,0:13:39.71,Default,,0,0,0,,Екіншісі – бұзық бала, тоқтаусыз.
Dialogue: 0,0:13:39.71,0:13:42.65,Default,,0,0,0,,Кіреберістің үстінде шағын бөлме бар➡
Dialogue: 0,0:13:42.65,0:13:46.42,Default,,0,0,0,,Өткен күндердің естеліктері әлі күнге дейін көз алдымда.
Dialogue: 0,0:13:46.42,0:13:49.16,Default,,0,0,0,,Мен салған сурет саған қалай ұнады?
Dialogue: 0,0:13:49.16,0:13:52.06,Default,,0,0,0,,Хмм... бұл өте қызық сияқты.
Dialogue: 0,0:13:52.06,0:13:54.40,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:13:54.40,0:13:58.20,Default,,0,0,0,,Иә, мен маңызды нәрсені айтуды ұмытып кетіппін. иә?
Dialogue: 0,0:14:00.20,0:14:05.34,Default,,0,0,0,,Дүниені өзгертетін қозғаушы күш.
Dialogue: 0,0:14:05.34,0:14:07.68,Default,,0,0,0,,Махаббат атымен...➡
Dialogue: 0,0:14:07.68,0:14:10.21,Default,,0,0,0,,Қозғаушы күш.
Dialogue: 0,0:14:10.21,0:14:12.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:12.68,0:14:18.49,Default,,0,0,0,,Анн. Менде сен сияқты болғанымды қалаймын...
Dialogue: 0,0:14:21.36,0:14:28.16,Default,,0,0,0,,♬～
Dialogue: 0,0:14:28.16,0:14:30.93,Default,,0,0,0,,Әуәуәәәәәәәәәәәә! (Дора Кит) Хаха! ➡
Dialogue: 0,0:14:30.93,0:14:33.37,Default,,0,0,0,,Не істеп жатырсың, Дэви? (Дэви) А-а-а-а.
Dialogue: 0,0:14:33.37,0:14:35.30,Default,,0,0,0,,Ах! Анна апа!
Dialogue: 0,0:14:35.30,0:14:38.27,Default,,0,0,0,,Иә? Дэви! Дора!
Dialogue: 0,0:14:38.27,0:14:41.41,Default,,0,0,0,,Аха! Қайтадан қош келдіңіз, Энн Чан!
Dialogue: 0,0:14:41.41,0:14:43.34,Default,,0,0,0,,Кейде жергілікті тұрғынды пайдаланған ыңғайлы.
Dialogue: 0,0:14:43.34,0:14:46.28,Default,,0,0,0,,Қараңдар! Бұл керемет от емес пе? Әпкеме. ➡
Dialogue: 0,0:14:46.28,0:14:48.28,Default,,0,0,0,,Менің әпкем қайтып келеді➡
Dialogue: 0,0:14:48.28,0:14:51.42,Default,,0,0,0,,Мен өте қуаныштымын! (Марилла Катберт)...Қош келдіңіз, Энн.
Dialogue: 0,0:14:51.42,0:14:54.36,Default,,0,0,0,,Сіз пастордан не сұрадыңыз?
Dialogue: 0,0:14:54.36,0:14:57.23,Default,,0,0,0,,А? (Дэви) Мен оны хатта жаздым!
Dialogue: 0,0:14:57.23,0:15:01.03,Default,,0,0,0,,Дэви, сен мұны көрдің бе? (Күлкі)
Dialogue: 0,0:15:08.00,0:15:11.07,Default,,0,0,0,,Диана оралды ма? Иә.
Dialogue: 0,0:15:11.07,0:15:15.58,Default,,0,0,0,,Түні бойы сөйлескеннен кейін көп ұйықтамайды деп ойлаймын.
Dialogue: 0,0:15:15.58,0:15:19.45,Default,,0,0,0,,Иә! Біз көп сөйлестік.
Dialogue: 0,0:15:19.45,0:15:21.78,Default,,0,0,0,,Біз алғаш кездескен кездегідей.
Dialogue: 0,0:15:21.78,0:15:25.15,Default,,0,0,0,,Ал Джейн бүгін түнде қонаққа келеді. иә?
Dialogue: 0,0:15:25.15,0:15:27.49,Default,,0,0,0,,Маған хат келді.
Dialogue: 0,0:15:27.49,0:15:31.69,Default,,0,0,0,,Ол менімен бірдеңе талқылағысы келетінін айтты.
Dialogue: 0,0:15:31.69,0:15:34.60,Default,,0,0,0,,Мүлдем емес... Жақсы емес пе?
Dialogue: 0,0:15:34.60,0:15:37.97,Default,,0,0,0,,Енді ғана оңай келіп-кетуге болады.
Dialogue: 0,0:15:37.97,0:15:40.87,Default,,0,0,0,,Шамасы, Руби Гиллис те айналысады.
Dialogue: 0,0:15:40.87,0:15:42.87,Default,,0,0,0,,О... бұл рас па?
Dialogue: 0,0:15:42.87,0:15:45.04,Default,,0,0,0,,Әй, тыңдап тұрған жоқсың ба?
Dialogue: 0,0:15:45.04,0:15:48.38,Default,,0,0,0,,Басқа адам Спенсер Веллдің мұғалімі деп айтылады. ➡
Dialogue: 0,0:15:48.38,0:15:50.71,Default,,0,0,0,,Ахахха! иә…. Бұл жақсы!
Dialogue: 0,0:15:50.71,0:15:52.68,Default,,0,0,0,,Жүрек дауысы Диана ештеңе айтқан жоқ. ➡
Dialogue: 0,0:15:52.68,0:15:57.49,Default,,0,0,0,,Джейн де құда болып, ол туралы сөйлесуге келе ме деп ойлаймын... ➡
Dialogue: 0,0:15:57.49,0:16:02.32,Default,,0,0,0,,Олай болса, мен ғана махаббатты білмейтін боламын...
Dialogue: 0,0:16:02.32,0:16:04.26,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:16:04.26,0:16:06.73,Default,,0,0,0,,Барлығы көрпеге оранған➡
Dialogue: 0,0:16:06.73,0:16:09.63,Default,,0,0,0,,Бақытыңды сана➡
Dialogue: 0,0:16:09.63,0:16:12.07,Default,,0,0,0,,Бұл эмоционалды түн.
Dialogue: 0,0:16:12.07,0:16:14.34,Default,,0,0,0,,Білесің бе, Энн. а….
Dialogue: 0,0:16:14.34,0:16:17.97,Default,,0,0,0,,Менен бір нәрсе сұрағаныңызды қалаймын.
Dialogue: 0,0:16:17.97,0:16:22.24,Default,,0,0,0,,Жүрек үні Джейн туралы не айтуым керек? Бақыттырақ көрін.
Dialogue: 0,0:16:22.24,0:16:24.18,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:16:24.18,0:16:28.75,Default,,0,0,0,,Сіз... ағам туралы не ойлайсыз?
Dialogue: 0,0:16:28.75,0:16:30.69,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:16:30.69,0:16:33.35,Default,,0,0,0,,Билли туралы не ойлайсың?
Dialogue: 0,0:16:33.35,0:16:35.46,Default,,0,0,0,,Сіз нені айтасыз...?
Dialogue: 0,0:16:40.46,0:16:42.40,Default,,0,0,0,,Сізге Билли ұнай ма?
Dialogue: 0,0:16:42.40,0:16:45.30,Default,,0,0,0,,Не? Иә... Маған ұнайды, әрине.
Dialogue: 0,0:16:45.30,0:16:48.77,Default,,0,0,0,,Сіз Биллиді күйеу ретінде қалайсыз ба?
Dialogue: 0,0:16:48.77,0:16:50.84,Default,,0,0,0,,…Кімнің күйеуі?
Dialogue: 0,0:16:50.84,0:16:53.94,Default,,0,0,0,,Бұл сенікі, солай ма?
Dialogue: 0,0:16:53.94,0:16:55.91,Default,,0,0,0,,Иә~⁉
Dialogue: 0,0:16:55.91,0:16:57.91,Default,,0,0,0,,Билли Аннаға үйленгісі келеді! ➡
Dialogue: 0,0:16:57.91,0:17:01.72,Default,,0,0,0,,Мен саған көптен бері ессіз болдым! ➡
Dialogue: 0,0:17:01.72,0:17:04.19,Default,,0,0,0,,Бірақ ағам ұялып қалды➡
Dialogue: 0,0:17:04.19,0:17:06.42,Default,,0,0,0,,Мен мұны өзім сұрай алмағандықтан...
Dialogue: 0,0:17:06.42,0:17:10.76,Default,,0,0,0,,Мен де мұндай істі қолға алғым келмеді.
Dialogue: 0,0:17:10.76,0:17:15.53,Default,,0,0,0,,Джейн... Джейн, кешіріңіз, бірақ мен Биллиге үйлене алмаймын.
Dialogue: 0,0:17:15.53,0:17:18.77,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін➡
Dialogue: 0,0:17:18.77,0:17:21.14,Default,,0,0,0,,Ешқашан?
Dialogue: 0,0:17:21.14,0:17:24.84,Default,,0,0,0,,Менің ойымша... бірақ Билли жақсы жігіт.
Dialogue: 0,0:17:24.84,0:17:27.44,Default,,0,0,0,,Ол еңбекқор және мейірімді➡
Dialogue: 0,0:17:27.44,0:17:30.24,Default,,0,0,0,,Мен де Эннді бағалайтыныма сенімдімін.
Dialogue: 0,0:17:30.24,0:17:32.18,Default,,0,0,0,,Джейн! Ах...
Dialogue: 0,0:17:32.18,0:17:34.12,Default,,0,0,0,,Сезіміңізге қуаныштымын➡
Dialogue: 0,0:17:34.12,0:17:38.35,Default,,0,0,0,,Менің Биллиге ондай сезімім жоқ.
Dialogue: 0,0:17:38.35,0:17:41.26,Default,,0,0,0,,Хмм... Менің ойымша...
Dialogue: 0,0:17:41.26,0:17:44.13,Default,,0,0,0,,Сұрасам да түкке тұрғысыз➡
Dialogue: 0,0:17:44.13,0:17:46.16,Default,,0,0,0,,Мен Билли➡-ге айттым
Dialogue: 0,0:17:46.16,0:17:49.26,Default,,0,0,0,,Мен талап етуім керек ...
Dialogue: 0,0:17:49.26,0:17:53.13,Default,,0,0,0,,♬～
Dialogue: 0,0:17:53.13,0:17:55.87,Default,,0,0,0,,(Джейннің қорылдауы)
Dialogue: 0,0:17:55.87,0:18:02.24,Default,,0,0,0,,♬～
Dialogue: 0,0:18:02.24,0:18:06.55,Default,,0,0,0,,Билли осыған байланысты депрессияға түспейді деп үміттенемін...
Dialogue: 0,0:18:06.55,0:18:08.58,Default,,0,0,0,,Менің ағам болса, жарайды.
Dialogue: 0,0:18:08.58,0:18:13.19,Default,,0,0,0,,Шынымды айтсам, Билли де Брюетт отбасынан шыққан Нестиді жақсы көреді.
Dialogue: 0,0:18:13.19,0:18:15.12,Default,,0,0,0,,Не? Анашым да➡
Dialogue: 0,0:18:15.12,0:18:18.56,Default,,0,0,0,,Тіпті Нестиге тұрмысқа шыққанымды қалайды.
Dialogue: 0,0:18:18.56,0:18:21.36,Default,,0,0,0,,Ол кісі тамақ пісіруге де шебер➡
Dialogue: 0,0:18:21.36,0:18:23.43,Default,,0,0,0,,Сіздің отбасыңыз жақсы, солай ма?
Dialogue: 0,0:18:23.43,0:18:27.20,Default,,0,0,0,,Жарайды... Жақсы болады деп үміттенемін.
Dialogue: 0,0:18:27.20,0:18:30.47,Default,,0,0,0,,Кешегі күнді ешкімге айтпа.
Dialogue: 0,0:18:30.47,0:18:33.44,Default,,0,0,0,,Иә….
Dialogue: 0,0:18:33.44,0:18:36.34,Default,,0,0,0,,Күлкілі ештеңе жоқ.
Dialogue: 0,0:18:36.34,0:18:41.22,Default,,0,0,0,,Бұл мен алған алғашқы үйлену ұсынысы.
Dialogue: 0,0:18:41.22,0:18:43.95,Default,,0,0,0,,Бір күні болады деп ойламаппын, бірақ...➡
Dialogue: 0,0:18:43.95,0:18:47.46,Default,,0,0,0,,Мен ешқашан агент арқылы болады деп ойламадым.
Dialogue: 0,0:18:47.46,0:18:49.69,Default,,0,0,0,,Менің…➡
Dialogue: 0,0:18:49.69,0:18:51.66,Default,,0,0,0,,Менің идеалым!
Dialogue: 0,0:18:51.66,0:18:55.56,Default,,0,0,0,,Қара көзді, асыл келбетті анау...!
Dialogue: 0,0:18:55.56,0:18:59.40,Default,,0,0,0,,Мен сені мәңгілікке қорғауға ант етемін.
Dialogue: 0,0:18:59.40,0:19:03.94,Default,,0,0,0,,Өтінемін, мейірімділігің, даналығың, сұлулығың➡
Dialogue: 0,0:19:03.94,0:19:06.64,Default,,0,0,0,,Барлығын тек өзім үшін сақтауға рұқсат етіңіз!
Dialogue: 0,0:19:06.64,0:19:08.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:08.58,0:19:10.51,Default,,0,0,0,,Немесе….
Dialogue: 0,0:19:10.51,0:19:13.15,Default,,0,0,0,,Мен сенсіз өмірді елестете алмаймын.
Dialogue: 0,0:19:13.15,0:19:15.52,Default,,0,0,0,,Мен сені міндетті түрде бақытты етемін.
Dialogue: 0,0:19:15.52,0:19:18.22,Default,,0,0,0,,Мәңгілік бірге өмір сүрейік!
Dialogue: 0,0:19:18.22,0:19:21.42,Default,,0,0,0,,Кешіріңіз! Ха...!
Dialogue: 0,0:19:21.42,0:19:23.92,Default,,0,0,0,,Сосын тым болмаса алыстан➡
Dialogue: 0,0:19:23.92,0:19:27.19,Default,,0,0,0,,Сізге таңданысымды жалғастырғаным үшін кешіріңіз...
Dialogue: 0,0:19:27.19,0:19:30.10,Default,,0,0,0,,Иә...!
Dialogue: 0,0:19:36.87,0:19:39.91,Default,,0,0,0,,Оған көмектесуге болмайтынына сенімдімін...
Dialogue: 0,0:19:39.91,0:19:44.75,Default,,0,0,0,,Өмір – қайта-қайта келетін бұралулар тізбегі.
Dialogue: 0,0:19:44.75,0:19:48.55,Default,,0,0,0,,Кішкентай армандар да жойылуы мүмкін ➡
Dialogue: 0,0:19:48.55,0:19:54.09,Default,,0,0,0,,Тіпті адамдар өзгереді. Джейн, Руби, Диана...
Dialogue: 0,0:19:54.09,0:19:56.29,Default,,0,0,0,,⚟Сәлем! а….
Dialogue: 0,0:19:57.99,0:20:00.49,Default,,0,0,0,,Ху, ха, ха....
Dialogue: 0,0:20:02.36,0:20:06.33,Default,,0,0,0,,Не болды? Осындай таңнан.
Dialogue: 0,0:20:06.33,0:20:11.14,Default,,0,0,0,,Жерге үйілген қар әдемі екен, сондықтан мен сендермен серуендегенім дұрыс болар деп ойладым.
Dialogue: 0,0:20:11.14,0:20:13.97,Default,,0,0,0,,Сіз ше? иә? Әсіресе...
Dialogue: 0,0:20:13.97,0:20:18.28,Default,,0,0,0,,Бірақ бұл шынымен жақсы қарлы көрініс. аа.
Dialogue: 0,0:20:18.28,0:20:23.12,Default,,0,0,0,,Маған үлкен қайғы келсе де➡
Dialogue: 0,0:20:23.12,0:20:26.99,Default,,0,0,0,,Бұл көрініс сізді жұбататынына сенімдімін.
Dialogue: 0,0:20:26.99,0:20:31.39,Default,,0,0,0,,Ешқашан қайғы-қасірет басыңа түспесін деп үміттенемін.
Dialogue: 0,0:20:31.39,0:20:35.23,Default,,0,0,0,,Иә...бірақ бұл міндетті түрде болады.
Dialogue: 0,0:20:35.23,0:20:37.63,Default,,0,0,0,,Осы уақытқа дейін және бұдан былай...
Dialogue: 0,0:20:37.63,0:20:40.30,Default,,0,0,0,,Иә. Неге менің үйіме тоқтамайсың?
Dialogue: 0,0:20:40.30,0:20:43.27,Default,,0,0,0,,Сіз Марилланы немесе Линд апайды көптен бері көрмедіңіз ғой, солай ма?
Dialogue: 0,0:20:43.27,0:20:47.84,Default,,0,0,0,,Аа, дұрыс. Дэви мен Дораның да бақытты болатынына сенімдімін.
Dialogue: 0,0:20:47.84,0:20:49.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:49.78,0:20:52.61,Default,,0,0,0,,Энн күтіңіз! а….
Dialogue: 0,0:20:52.61,0:20:54.92,Default,,0,0,0,,Аяқ бау...
Dialogue: 0,0:20:54.92,0:21:00.52,Default,,0,0,0,,Осылайша сіз бір кішкентай бақытсыздықтан құтылдыңыз.
Dialogue: 0,0:21:00.52,0:21:04.16,Default,,0,0,0,,Рахмет. Мүмкін болса...➡
Dialogue: 0,0:21:04.16,0:21:10.26,Default,,0,0,0,,Сіздің өміріңізден басқа барлық бақыт пен қуаныш➡
Dialogue: 0,0:21:10.26,0:21:13.97,Default,,0,0,0,,Мен сені өшіргім келеді.
Dialogue: 0,0:21:13.97,0:21:16.87,Default,,0,0,0,,♬～
Dialogue: 0,0:21:16.87,0:21:19.14,Default,,0,0,0,,Гилберт.
Dialogue: 0,0:21:19.14,0:21:23.71,Default,,0,0,0,,Сіз дәл қазір өте ұқыпсыз болып бара жатырсыз...
Dialogue: 0,0:21:23.71,0:21:27.95,Default,,0,0,0,,Ешбір өмір сынақ пен қайғыдан өтпейді➡
Dialogue: 0,0:21:27.95,0:21:30.02,Default,,0,0,0,,Кемелділік жоқ.
Dialogue: 0,0:21:30.02,0:21:37.29,Default,,0,0,0,,Мен мұны тек бақытты кезде айта алатын шығармын, бірақ...
Dialogue: 0,0:21:37.29,0:21:42.53,Default,,0,0,0,,♬～
Dialogue: 0,0:21:42.53,0:21:45.73,Default,,0,0,0,,Енді кеттік.
Dialogue: 0,0:21:45.73,0:21:49.30,Default,,0,0,0,,♬～
Dialogue: 0,0:21:49.30,0:21:51.51,Default,,0,0,0,,Уф….
Dialogue: 0,0:21:56.81,0:21:59.51,Default,,0,0,0,,Енді өзіңізге өтірік айтпаңыз! ➡
Dialogue: 0,0:21:59.51,0:22:03.62,Default,,0,0,0,,Күте тұрыңыз, Энн Ширли!
Dialogue: 0,0:22:05.25,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Сен білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:51.43,Default,,0,0,0,,♬～
