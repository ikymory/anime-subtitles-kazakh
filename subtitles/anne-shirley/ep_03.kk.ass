Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:07.14,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:00:07.14,0:00:09.10,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:09.10,0:00:11.77,Default,,0,0,0,,Бұл сурет Дианаға ұқсамайды деп ойлайсыз ба?
Dialogue: 0,0:00:11.77,0:00:13.71,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:13.71,0:00:17.35,Default,,0,0,0,,Хэхе! Рахмет Мэтью.
Dialogue: 0,0:00:17.35,0:00:20.18,Default,,0,0,0,,Екеуің шай уақытын ұмыттыңдар ма?
Dialogue: 0,0:00:20.18,0:00:22.12,Default,,0,0,0,,Кешіріңіз, Марилла.
Dialogue: 0,0:00:22.12,0:00:25.02,Default,,0,0,0,,Диананың маған салған суреті өте әдемі болды.
Dialogue: 0,0:00:25.02,0:00:27.46,Default,,0,0,0,,Мен мұны бұрыннан естігенмін.
Dialogue: 0,0:00:27.46,0:00:32.76,Default,,0,0,0,,Иә. Мені мектептегі жексенбілік пикникке шақырды.
Dialogue: 0,0:00:32.76,0:00:34.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:34.70,0:00:38.47,Default,,0,0,0,,...Мен бұрын ешқашан пикникке барған емеспін...➡
Dialogue: 0,0:00:38.47,0:00:41.37,Default,,0,0,0,,Барсам болады ма? Марилла.
Dialogue: 0,0:00:41.37,0:00:43.31,Default,,0,0,0,,Хэхехе….
Dialogue: 0,0:00:43.31,0:00:47.91,Default,,0,0,0,,Басқа балалар кетіп бара жатқанда, мен сені жібере алмаймын.
Dialogue: 0,0:00:47.91,0:00:50.18,Default,,0,0,0,,Ах...! Бірақ... Бірақ...
Dialogue: 0,0:00:50.18,0:00:52.25,Default,,0,0,0,,Әр адамның қоржынында тамақ бар➡
Dialogue: 0,0:00:52.25,0:00:54.38,Default,,0,0,0,,Оны өзімен бірге алып келетін сияқты...
Dialogue: 0,0:00:54.38,0:00:56.32,Default,,0,0,0,,Әрине мен оны саған дайындаймын.
Dialogue: 0,0:00:56.32,0:00:59.62,Default,,0,0,0,,О, Марилла! Қандай мейірімді!
Dialogue: 0,0:00:59.62,0:01:02.19,Default,,0,0,0,,Бұл қауіпті. Кетіңіз.
Dialogue: 0,0:01:02.19,0:01:06.09,Default,,0,0,0,,Хехе. Мені сүйудің қажеті жоқ!
Dialogue: 0,0:01:06.09,0:01:15.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:15.34,0:01:20.01,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:01:20.01,0:01:22.54,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:01:22.54,0:01:24.48,Default,,0,0,0,,♬ «Қалағаныңды жаза аласың».
Dialogue: 0,0:01:24.48,0:01:28.35,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:01:28.35,0:01:30.69,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:01:30.69,0:01:32.92,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:01:32.92,0:01:37.46,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:01:37.46,0:01:42.66,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:01:42.66,0:01:44.60,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:01:44.60,0:01:48.47,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:01:48.47,0:01:51.87,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:01:51.87,0:01:54.31,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:01:54.31,0:01:56.58,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:01:56.58,0:02:00.82,Default,,0,0,0,,♬ «Юме ұялшақ, жасырынбақшы».
Dialogue: 0,0:02:00.82,0:02:03.29,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:03.29,0:02:05.55,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:05.55,0:02:09.02,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:09.02,0:02:12.33,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:12.33,0:02:14.56,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:14.56,0:02:18.83,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны».
Dialogue: 0,0:02:18.83,0:02:21.34,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:21.34,0:02:23.64,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:02:23.64,0:02:27.51,Default,,0,0,0,,♬ «Мені біреу алып кетуге келетін сияқты».
Dialogue: 0,0:02:27.51,0:02:30.01,Default,,0,0,0,,♬ «Менде әрқашан болды».
Dialogue: 0,0:02:30.01,0:02:33.92,Default,,0,0,0,,♬～
Dialogue: 0,0:02:44.63,0:02:46.93,Default,,0,0,0,,(бұршақтарды қырып жатқан дыбыс)
Dialogue: 0,0:02:49.20,0:02:52.97,Default,,0,0,0,,Хмм…. А... Марилла, не болды?
Dialogue: 0,0:02:52.97,0:02:56.47,Default,,0,0,0,,Мен шіркеуге үнемі киетін аметист брошь➡
Dialogue: 0,0:02:56.47,0:02:58.81,Default,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:02:58.81,0:03:02.98,Default,,0,0,0,,Мен оны қолданғаннан кейін, мен оны әрқашан қалдырған жерімнен қайта қоямын...
Dialogue: 0,0:03:02.98,0:03:06.62,Default,,0,0,0,,Әлгі брошь күлгіннің жаны сияқты әдемі.
Dialogue: 0,0:03:06.62,0:03:10.15,Default,,0,0,0,,Мен оны жәшіктегі иненің тесігінен көрдім.
Dialogue: 0,0:03:10.15,0:03:12.95,Default,,0,0,0,,Ах…. Мен оны көтеріп, кеудеме қойдым!
Dialogue: 0,0:03:12.95,0:03:15.56,Default,,0,0,0,,Сен менің бөлмеме рұқсатсыз кірдің бе?
Dialogue: 0,0:03:15.56,0:03:18.43,Default,,0,0,0,,Сонымен брошь ше? Оны қайда қойдыңыз?
Dialogue: 0,0:03:18.43,0:03:21.76,Default,,0,0,0,,Мен оны қайта өзгерттім. Мен бара алмадым ба деп ойлаймын.
Dialogue: 0,0:03:21.76,0:03:26.07,Default,,0,0,0,,Бірақ менің жақсы жағым сол қателікті екі рет қайталамаймын.
Dialogue: 0,0:03:27.64,0:03:30.44,Default,,0,0,0,,Енді қайта қарайық. а….
Dialogue: 0,0:03:30.44,0:03:34.78,Default,,0,0,0,,(Іздеу дыбысы)
Dialogue: 0,0:03:34.78,0:03:37.45,Default,,0,0,0,,Хмм….
Dialogue: 0,0:03:37.45,0:03:41.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:03:44.12,0:03:46.39,Default,,0,0,0,,Маған шындықты айт.
Dialogue: 0,0:03:46.39,0:03:49.12,Default,,0,0,0,,Оны сыртқа шығарып, жоғалтып алған жоқсың ба?
Dialogue: 0,0:03:49.12,0:03:53.13,Default,,0,0,0,,Ә!? Маған гильотина кигізсе де, мен олай жасамас едім!
Dialogue: 0,0:03:53.13,0:03:56.03,Default,,0,0,0,,Мен гильотина туралы көп білмеймін...➡
Dialogue: 0,0:03:56.03,0:03:58.17,Default,,0,0,0,,Бірақ солай!
Dialogue: 0,0:03:58.17,0:04:01.17,Default,,0,0,0,,Қандай гильотина! Өтірік айтасың.
Dialogue: 0,0:04:01.17,0:04:04.01,Default,,0,0,0,,Мен шындықты айтқанша бөлмеңде бол!
Dialogue: 0,0:04:04.01,0:04:06.01,Default,,0,0,0,,Бірақ үрме бұршақ... Жарайды, бөлмеңе кет➡
Dialogue: 0,0:04:06.01,0:04:08.44,Default,,0,0,0,,Жүр! а….
Dialogue: 0,0:04:08.44,0:04:10.38,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:04:10.38,0:04:12.31,Default,,0,0,0,,Бұл анамның естелігі еді.
Dialogue: 0,0:04:12.31,0:04:16.18,Default,,0,0,0,,Мен Энннің оны ұрлауға әрекеттенбегенін білемін.
Dialogue: 0,0:04:16.18,0:04:19.45,Default,,0,0,0,,Мен оны жоғалтып алдым және сізге айтуға қатты қорықтым.
Dialogue: 0,0:04:19.45,0:04:21.72,Default,,0,0,0,,Әлгі бала өтірік айтатын...➡
Dialogue: 0,0:04:21.72,0:04:25.46,Default,,0,0,0,,Бұл брошь жоғалтқаннан әлдеқайда ауыр.
Dialogue: 0,0:04:25.46,0:04:29.33,Default,,0,0,0,,...Ол баланы бөлмеде қанша уақыт қалдырасың?
Dialogue: 0,0:04:29.33,0:04:32.00,Default,,0,0,0,,Толық мойындауым керек! Ой….
Dialogue: 0,0:04:32.00,0:04:38.47,Default,,0,0,0,,Түсіндім... Түсіндім... Ол баланың оқуына сен жауаптысың...
Dialogue: 0,0:04:38.47,0:04:42.34,Default,,0,0,0,,Жүрегімдегі дауыс Рахиламен бұл туралы сөйлесе алмаймын... ➡
Dialogue: 0,0:04:42.34,0:04:44.85,Default,,0,0,0,,Не болды...?
Dialogue: 0,0:04:47.88,0:04:50.19,Default,,0,0,0,,Сіз тамақ жеген жоқсыз.
Dialogue: 0,0:04:50.19,0:04:53.09,Default,,0,0,0,,Мен брошьді алған жоқпын.
Dialogue: 0,0:04:53.09,0:04:55.02,Default,,0,0,0,,Пикник ертең!?
Dialogue: 0,0:04:55.02,0:04:57.36,Default,,0,0,0,,Мен тек пикникке баруға рұқсат бергім келеді!
Dialogue: 0,0:04:57.36,0:04:59.29,Default,,0,0,0,,Ол мені жіберетінін айтты.
Dialogue: 0,0:04:59.29,0:05:02.86,Default,,0,0,0,,Тек брошьмен не істегеніңізді мойындаңыз!
Dialogue: 0,0:05:02.86,0:05:05.77,Default,,0,0,0,,Марилла!
Dialogue: 0,0:05:05.77,0:05:17.88,Default,,0,0,0,,♬～
Dialogue: 0,0:05:17.88,0:05:19.82,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:05:22.55,0:05:26.15,Default,,0,0,0,,Ах, Марилла, мен мойындауға дайынмын.
Dialogue: 0,0:05:26.15,0:05:29.12,Default,,0,0,0,,Мен аметист брошьін алдым.
Dialogue: 0,0:05:29.12,0:05:31.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.90,0:05:36.80,Default,,0,0,0,,Менің ойымша, сіз сөйлесуге дайынсыз.
Dialogue: 0,0:05:36.80,0:05:39.33,Default,,0,0,0,,Ақ қайың орманындағы анау брошь➡
Dialogue: 0,0:05:39.33,0:05:43.21,Default,,0,0,0,,Мен оны Корделия ханшайымы сияқты кигім келді.
Dialogue: 0,0:05:43.21,0:05:49.34,Default,,0,0,0,,Осыдан кейін мен оны Марилла кеткенше бұрынғы орнына қоюды жөн көрдім. Бірақ...
Dialogue: 0,0:05:49.34,0:05:51.31,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:05:51.31,0:05:54.18,Default,,0,0,0,,Мен ештеңе қалдырғым келмеді, сондықтан мен аздап айналма жолмен жүрдім➡
Dialogue: 0,0:05:54.18,0:05:56.75,Default,,0,0,0,,«Жарқыраған көл суы» көпірінен өткенде...➡
Dialogue: 0,0:05:56.75,0:06:00.26,Default,,0,0,0,,Қайта көргім келіп, брошьты шешіп алдым.
Dialogue: 0,0:06:00.26,0:06:02.19,Default,,0,0,0,,Дегенмен, бұл өкінішті➡
Dialogue: 0,0:06:02.19,0:06:04.49,Default,,0,0,0,,Қолымнан сырғып түсті...➡
Dialogue: 0,0:06:04.49,0:06:06.49,Default,,0,0,0,,Ал «жарқыраған көлдің» түбінде➡
Dialogue: 0,0:06:06.49,0:06:09.80,Default,,0,0,0,,Ол мәңгілікке батып кетті...
Dialogue: 0,0:06:11.70,0:06:14.60,Default,,0,0,0,,Бұл менің мойындауым, Марилла.
Dialogue: 0,0:06:14.60,0:06:17.51,Default,,0,0,0,,Энн... Бұл қорқынышты.
Dialogue: 0,0:06:17.51,0:06:21.74,Default,,0,0,0,,Мен сен сияқты жаман бала туралы естімеппін!
Dialogue: 0,0:06:21.74,0:06:24.31,Default,,0,0,0,,Иә, мен де солай ойлаймын.
Dialogue: 0,0:06:24.31,0:06:26.98,Default,,0,0,0,,Сондықтан мені жазалауыңызды өтінемін!
Dialogue: 0,0:06:26.98,0:06:30.02,Default,,0,0,0,,Түстен кейін пикникке шығуымыз үшін. мінеки біз!
Dialogue: 0,0:06:30.02,0:06:32.22,Default,,0,0,0,,Пикник?
Dialogue: 0,0:06:32.22,0:06:35.12,Default,,0,0,0,,Мен сені жібермеймін! Анна, бұл жаза!
Dialogue: 0,0:06:35.12,0:06:38.99,Default,,0,0,0,,Иә! Мен өз сезімімді мойындаған соң, сіз шыға аласыз дедіңіз!
Dialogue: 0,0:06:38.99,0:06:40.93,Default,,0,0,0,,Мені жібер, Марилла!
Dialogue: 0,0:06:40.93,0:06:43.87,Default,,0,0,0,,Себебі мен мүмкіндігімше мойындадым!
Dialogue: 0,0:06:43.87,0:06:48.00,Default,,0,0,0,,Бүгін мен үшін өмірімде бірінші рет балмұздақ жеген маңызды күн!
Dialogue: 0,0:06:48.00,0:06:52.17,Default,,0,0,0,,Мен оны енді ешқашан жей алмайтын шығармын! Өтінемін, Марилла!
Dialogue: 0,0:06:52.17,0:06:54.11,Default,,0,0,0,,Жоқ десең, жақсы емес!
Dialogue: 0,0:06:54.11,0:06:56.04,Default,,0,0,0,,А... аа....
Dialogue: 0,0:06:56.04,0:06:58.95,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:06:58.95,0:07:01.85,Default,,0,0,0,,Flashback (Рейчел Линд) Мен мұндай қорқынышты баланы ешқашан көрген емеспін. ➡
Dialogue: 0,0:07:01.85,0:07:07.96,Default,,0,0,0,,Мен ашулы емеспін, солай ма? Тек сені аяймын.
Dialogue: 0,0:07:07.96,0:07:10.39,Default,,0,0,0,,Уф... Аа...
Dialogue: 0,0:07:10.39,0:07:14.96,Default,,0,0,0,,Жүректің дауысы Мен Аннаны көтеруді шештім. Мен артыма қарамаймын.
Dialogue: 0,0:07:14.96,0:07:18.30,Default,,0,0,0,,Энн! Тамақ ішетін уақыт болды, төменге түс.
Dialogue: 0,0:07:18.30,0:07:20.24,Default,,0,0,0,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:07:20.24,0:07:22.20,Default,,0,0,0,,Маған түскі ас керек емес!
Dialogue: 0,0:07:22.20,0:07:24.44,Default,,0,0,0,,Мен қазір ештеңе жеуге тым қайғырдым!
Dialogue: 0,0:07:24.44,0:07:29.21,Default,,0,0,0,,Бір күні Марилла бұған өкінеді. Бірақ мен сені кешіремін.
Dialogue: 0,0:07:29.21,0:07:32.91,Default,,0,0,0,,Уақыты келгенде, мен сені кешіргенімді ұмытпа.
Dialogue: 0,0:07:32.91,0:07:35.45,Default,,0,0,0,,Ал енді маған тамақ іш деп айтпа!
Dialogue: 0,0:07:35.45,0:07:39.72,Default,,0,0,0,,Әсіресе, қайнатылған шошқа еті мен көкөністер сияқты шынайы нәрсе!
Dialogue: 0,0:07:39.72,0:07:42.72,Default,,0,0,0,,Хмм…. (Есіктің тарс жабылған дыбысы)
Dialogue: 0,0:07:46.96,0:07:52.53,Default,,0,0,0,,Бұл дәмді. Бұл шошқа еті мен көкөністердің шынайы бұқтырылуы.
Dialogue: 0,0:07:52.53,0:07:57.27,Default,,0,0,0,,Әрине, өтірік айтпау керек. Бірақ ол әлі бала.
Dialogue: 0,0:07:57.27,0:08:02.48,Default,,0,0,0,,Мен таң қалдым. Мен әлі де бұл тым жомарт деп ойлаймын.
Dialogue: 0,0:08:02.48,0:08:06.85,Default,,0,0,0,,Бірақ мен ешқандай тәртіп алған жоқпын.
Dialogue: 0,0:08:06.85,0:08:10.79,Default,,0,0,0,,Күрсін... Енді осылай істеп жатқаның осы емес пе?
Dialogue: 0,0:08:10.79,0:08:12.95,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:08:12.95,0:08:14.89,Default,,0,0,0,,Қаншама жөндеу жұмыстары жүріп жатыр... Дұрыс. ➡
Dialogue: 0,0:08:14.89,0:08:18.53,Default,,0,0,0,,Маған погондағы жарықшақты жөндеу керек...
Dialogue: 0,0:08:18.53,0:08:22.23,Default,,0,0,0,,Бұл жерде жарықшақ бар... а?
Dialogue: 0,0:08:23.97,0:08:25.90,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:08:25.90,0:08:28.00,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:08:29.77,0:08:31.77,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:08:31.77,0:08:33.98,Default,,0,0,0,,Энн Ширли!
Dialogue: 0,0:08:33.98,0:08:36.91,Default,,0,0,0,,Ах…. Брошь менің иық сөмкеме жабысып қалды!
Dialogue: 0,0:08:36.91,0:08:41.15,Default,,0,0,0,,Бүгін таңертең сіздің мойындауыңыз қандай болды?
Dialogue: 0,0:08:41.15,0:08:46.96,Default,,0,0,0,,Өйткені, Марилла, мен бірдеңені мойындамайынша бөлмеден шыға алмайсың.
Dialogue: 0,0:08:46.96,0:08:50.66,Default,,0,0,0,,Жақсы…. Сондықтан мен өз қиялымды қолдандым➡
Dialogue: 0,0:08:50.66,0:08:54.43,Default,,0,0,0,,Мойындау туралы мүмкіндігіңізше ойланыңыз...➡
Dialogue: 0,0:08:54.43,0:08:57.13,Default,,0,0,0,,Біз түні бойы жаттығу жасадық...
Dialogue: 0,0:08:59.00,0:09:02.64,Default,,0,0,0,,Бірақ соңында пикникке бара алмадым➡
Dialogue: 0,0:09:02.64,0:09:05.17,Default,,0,0,0,,Барлық ауыр жұмыс бекер...
Dialogue: 0,0:09:05.17,0:09:08.68,Default,,0,0,0,,Хэхе... Хехе... Ахахахаха!
Dialogue: 0,0:09:08.68,0:09:10.95,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:09:10.95,0:09:13.85,Default,,0,0,0,,Анн. Мен сенен жеңілдім.
Dialogue: 0,0:09:13.85,0:09:18.52,Default,,0,0,0,,Жаман болды. Мен сенің айтқаныңа сенуім керек еді. ➡
Dialogue: 0,0:09:18.52,0:09:22.09,Default,,0,0,0,,Бірақ жасамаған нәрсені мойындау➡
Dialogue: 0,0:09:22.09,0:09:24.03,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:09:24.03,0:09:27.03,Default,,0,0,0,,Бірақ мен бұған себепкер болдым.
Dialogue: 0,0:09:27.03,0:09:29.83,Default,,0,0,0,,Егер мені кешірсеңіз➡
Dialogue: 0,0:09:29.83,0:09:33.80,Default,,0,0,0,,Энн, мен де сені кешіремін.
Dialogue: 0,0:09:33.80,0:09:38.14,Default,,0,0,0,,Иә, Марилла. Әрине мен сені кешіремін!
Dialogue: 0,0:09:38.14,0:09:40.08,Default,,0,0,0,,Олай болса...➡
Dialogue: 0,0:09:40.08,0:09:42.11,Default,,0,0,0,,Пикник дайындаймыз.
Dialogue: 0,0:09:42.11,0:09:45.35,Default,,0,0,0,,Ах... Бірақ... Марилла: Қазірдің өзінде кеш...
Dialogue: 0,0:09:45.35,0:09:48.25,Default,,0,0,0,,Сол кезде барлығы жиналды.
Dialogue: 0,0:09:48.25,0:09:51.15,Default,,0,0,0,,Енді мынаны киіңіз. аа! Оған дейін➡
Dialogue: 0,0:09:51.15,0:09:53.62,Default,,0,0,0,,Бетімді жуып, шашымды тарауым керек. Ахахха!
Dialogue: 0,0:09:53.62,0:09:55.56,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:09:55.56,0:09:57.59,Default,,0,0,0,,Мэтью Тезірек жүр, Энн!
Dialogue: 0,0:09:57.59,0:10:01.03,Default,,0,0,0,,Ах! Тез арада вагон дайындаңыз!
Dialogue: 0,0:10:01.03,0:10:03.77,Default,,0,0,0,,♬～
Dialogue: 0,0:10:03.77,0:10:05.70,Default,,0,0,0,,Ах... Энн! Мінеки!
Dialogue: 0,0:10:05.70,0:10:07.74,Default,,0,0,0,,Диана~! Ахахха!
Dialogue: 0,0:10:07.74,0:10:09.90,Default,,0,0,0,,Энн! Ахахха!
Dialogue: 0,0:10:09.90,0:10:13.68,Default,,0,0,0,,Мен көптен күттім! Иә.
Dialogue: 0,0:10:13.68,0:10:17.05,Default,,0,0,0,,Ол Энн Ширли. Менің ең жақын досым!
Dialogue: 0,0:10:17.05,0:10:18.98,Default,,0,0,0,,Жүрек үні, жан дос...
Dialogue: 0,0:10:18.98,0:10:22.68,Default,,0,0,0,,Танысқаныма қуаныштымын! (үшін) Танысқаныма қуаныштымын!
Dialogue: 0,0:10:22.68,0:10:24.65,Default,,0,0,0,,<үшінмен бірге пикникте уақыт өткізу➡
Dialogue: 0,0:10:24.65,0:10:28.62,Default,,0,0,0,,Бұл мен елестеткеннен де керемет болды. ➡
Dialogue: 0,0:10:28.62,0:10:30.93,Default,,0,0,0,,«Жарқыраған көл суында»…>
Dialogue: 0,0:10:30.93,0:10:32.89,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:10:32.89,0:10:34.93,Default,,0,0,0,,<Кейбір балалар қайықтан құлап кете жаздады. ➡
Dialogue: 0,0:10:34.93,0:10:39.03,Default,,0,0,0,,Соңында балмұздақ! ＞
Dialogue: 0,0:10:39.03,0:10:40.97,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:10:40.97,0:10:43.00,Default,,0,0,0,,Балмұздақтың кереметтері➡
Dialogue: 0,0:10:43.00,0:10:45.31,Default,,0,0,0,,Сөзбен айтып жеткізе алмайтыным ұят!
Dialogue: 0,0:10:45.31,0:10:48.14,Default,,0,0,0,,Бұл өте керемет болды!
Dialogue: 0,0:10:48.14,0:10:50.48,Default,,0,0,0,,Бұл мүлдем асыра сілтеу.
Dialogue: 0,0:10:50.48,0:10:53.05,Default,,0,0,0,,О, Матай! Марилла!
Dialogue: 0,0:10:53.05,0:10:56.92,Default,,0,0,0,,Мен өте қызықты уақыт өткіздім!
Dialogue: 0,0:10:56.92,0:10:58.92,Default,,0,0,0,,«Өте жағымды» ➡ дегенді білдіреді
Dialogue: 0,0:10:58.92,0:11:01.89,Default,,0,0,0,,Бұл мен бүгін ғана үйренген сөз! Хехе. Мэри Белл...
Dialogue: 0,0:11:01.89,0:11:05.43,Default,,0,0,0,,Бұл керемет күн болды. ➡
Dialogue: 0,0:11:05.43,0:11:09.96,Default,,0,0,0,,Аннаның мойындауы өтірік болды.
Dialogue: 0,0:11:09.96,0:11:13.33,Default,,0,0,0,,Бұл менің кінәм екенін мойындаймын.
Dialogue: 0,0:11:13.33,0:11:15.27,Default,,0,0,0,,Содан кейін…➡
Dialogue: 0,0:11:15.27,0:11:18.04,Default,,0,0,0,,Бір нәрсе анық.
Dialogue: 0,0:11:18.04,0:11:20.44,Default,,0,0,0,,Иә? Хехе.
Dialogue: 0,0:11:20.44,0:11:23.04,Default,,0,0,0,,Ол баламен үйде зерігу деген жоқ➡
Dialogue: 0,0:11:23.04,0:11:26.88,Default,,0,0,0,,Бұл жоқ дегенді білдіреді.
Dialogue: 0,0:11:26.88,0:11:29.12,Default,,0,0,0,,Хехе….
Dialogue: 0,0:11:29.12,0:11:34.26,Default,,0,0,0,,О, саған жақсы болды, Марилла.
Dialogue: 0,0:11:34.26,0:11:39.49,Default,,0,0,0,,♬～
Dialogue: 0,0:11:39.49,0:11:41.46,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:11:41.46,0:11:44.97,Default,,0,0,0,,Жақсы Анна. Мектепке келгенде аузыңды жап.
Dialogue: 0,0:11:44.97,0:11:47.87,Default,,0,0,0,,Иә. Мұғалімнің айтқанын мұқият тыңдаңыз.
Dialogue: 0,0:11:47.87,0:11:50.31,Default,,0,0,0,,Мен білемін, Марилла.
Dialogue: 0,0:11:50.31,0:11:53.34,Default,,0,0,0,,Киім Біртүрлі емес пе? Бұл біртүрлі емес.
Dialogue: 0,0:11:53.34,0:11:55.51,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:11:55.51,0:11:57.58,Default,,0,0,0,,А, түскі ас қорабы.
Dialogue: 0,0:11:57.58,0:12:01.72,Default,,0,0,0,,Энн Үйге келгенше оқу үстелін бітіремін.
Dialogue: 0,0:12:01.72,0:12:06.22,Default,,0,0,0,,Рахмет! Матай. Ал, кеттік! Хехе.
Dialogue: 0,0:12:06.22,0:12:10.76,Default,,0,0,0,,Мен барлығымен жақсы тіл табыса аламын деп үміттенемін...
Dialogue: 0,0:12:10.76,0:12:13.66,Default,,0,0,0,,Қайырлы таң, «Ғашықтар жолы».
Dialogue: 0,0:12:13.66,0:12:17.90,Default,,0,0,0,,Хехехе, бұл сізге қоңырау шалудың романтикалық жолы ма деп ойлаймын.
Dialogue: 0,0:12:17.90,0:12:19.83,Default,,0,0,0,,Ах! Ах.
Dialogue: 0,0:12:19.83,0:12:25.07,Default,,0,0,0,,Қайырлы таң Диана! қайырлы таң. Мектепке барған алғашқы күніңізді қалай сезінесіз?
Dialogue: 0,0:12:25.07,0:12:27.11,Default,,0,0,0,,Ғажайып - бұл бір ғана сөз.
Dialogue: 0,0:12:27.11,0:12:29.24,Default,,0,0,0,,Бірақ мені бақытты ететіні➡
Dialogue: 0,0:12:29.24,0:12:31.85,Default,,0,0,0,,Мектепке бару үшін осындай жақсы жолмен жүру➡
Dialogue: 0,0:12:31.85,0:12:34.12,Default,,0,0,0,,Сіз бара аласыз!
Dialogue: 0,0:12:34.12,0:12:38.95,Default,,0,0,0,,«Күлгін алқап»! Көктем келгенде сансыз гүл болады.
Dialogue: 0,0:12:38.95,0:12:43.79,Default,,0,0,0,,«Қайың жолы»! Сіз осындай әдемі жарық сызығын көрдіңіз бе?
Dialogue: 0,0:12:43.79,0:12:47.46,Default,,0,0,0,,Мына қарағайлы орманнан өткенде, мектеп дәл сол жерде.
Dialogue: 0,0:12:47.46,0:12:49.40,Default,,0,0,0,,Ах! Қайырлы таң Джейн!
Dialogue: 0,0:12:49.40,0:12:51.47,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:51.47,0:12:54.24,Default,,0,0,0,,Тек мені тыңда. Гарди Пироғы кеше➡
Dialogue: 0,0:12:54.24,0:12:58.91,Default,,0,0,0,,Ағыстағы менің орныма сүтіңді қой. Сене аласыз ба?
Dialogue: 0,0:12:58.91,0:13:01.38,Default,,0,0,0,,Қайырлы таң Руби. (Руби Гиллис) Уау.
Dialogue: 0,0:13:01.38,0:13:05.75,Default,,0,0,0,,Доктор Филлипс Присси Эндрюстің тас планшетіне бірдеңе жазды➡
Dialogue: 0,0:13:05.75,0:13:09.22,Default,,0,0,0,,Присси мұны оқығанда, ол ашық қызылға айналды.
Dialogue: 0,0:13:09.22,0:13:12.05,Default,,0,0,0,,Неліктен? мінеки біз…?
Dialogue: 0,0:13:12.05,0:13:14.02,Default,,0,0,0,,Иә? Энн! Қараңдар!
Dialogue: 0,0:13:14.02,0:13:17.93,Default,,0,0,0,,Бұл Avonlea мектебі.
Dialogue: 0,0:13:17.93,0:13:20.86,Default,,0,0,0,,Диана және басқалары №5 оқулық.
Dialogue: 0,0:13:20.86,0:13:25.60,Default,,0,0,0,,Мен 4-ші нөмірмін. Мен өте кешігіп қалдым. Анна жақында жетеді.
Dialogue: 0,0:13:25.60,0:13:28.10,Default,,0,0,0,,Мұғалім осында! Ах.
Dialogue: 0,0:13:31.41,0:13:35.24,Default,,0,0,0,,Баршаңызға қайырлы таң. (Оқушылар) Қайырлы таң, мұғалім.
Dialogue: 0,0:13:35.24,0:13:37.88,Default,,0,0,0,,Бірінші кезең – география. ➡
Dialogue: 0,0:13:37.88,0:13:40.78,Default,,0,0,0,,Принц Эдвард аралының картасына қарау➡
Dialogue: 0,0:13:40.78,0:13:44.95,Default,,0,0,0,,Сұрақ қою…. Жүрегімде дауыс Уау...! Жарқыраған көл суын осы жерден де көруге болады!
Dialogue: 0,0:13:44.95,0:13:46.99,Default,,0,0,0,,Жаңа студент Энн Ширли! а….
Dialogue: 0,0:13:46.99,0:13:49.69,Default,,0,0,0,,Карта алдында.
Dialogue: 0,0:13:53.66,0:13:56.20,Default,,0,0,0,,Авонлеа ауылының орналасқан жерін көрсетіңіз.
Dialogue: 0,0:13:56.20,0:13:59.10,Default,,0,0,0,,Жүрек үні Картаны бірінші рет көріп тұрмын...
Dialogue: 0,0:13:59.10,0:14:01.04,Default,,0,0,0,,Жүрек дауысы (Джейн Диана) Энн Сәттілік!
Dialogue: 0,0:14:01.04,0:14:03.44,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:14:05.21,0:14:07.14,Default,,0,0,0,,А... карибу?
Dialogue: 0,0:14:07.14,0:14:10.41,Default,,0,0,0,,Ах! Карибудан қайыққа мініңіз➡
Dialogue: 0,0:14:10.41,0:14:12.41,Default,,0,0,0,,Шарлоттаун!
Dialogue: 0,0:14:12.41,0:14:14.42,Default,,0,0,0,,Ол жерден Пойызбен Жарқын өзенге!
Dialogue: 0,0:14:14.42,0:14:18.65,Default,,0,0,0,,Авонлеа жолымен солтүстікке қарай жүресіз... хехе.
Dialogue: 0,0:14:18.65,0:14:21.22,Default,,0,0,0,,Авонлеа ауылы осында!
Dialogue: 0,0:14:21.22,0:14:24.06,Default,,0,0,0,,Иә. (қол шапалақтау)
Dialogue: 0,0:14:24.06,0:14:26.96,Default,,0,0,0,,«Маусым көктем, күндер айналып өтеді➡
Dialogue: 0,0:14:26.96,0:14:30.97,Default,,0,0,0,,Сағат жеті, төбелер інжу шықымен дымқыл➡
Dialogue: 0,0:14:30.97,0:14:33.27,Default,,0,0,0,,Хибари аспан арқылы ұшады➡
Dialogue: 0,0:14:33.27,0:14:35.64,Default,,0,0,0,,Ұлулар тікенекте жорғалайды. Жүрек дауысы Анна: Сіз оқуға өте жақсы емессіз.
Dialogue: 0,0:14:35.64,0:14:38.17,Default,,0,0,0,,Жүрек үні Табиғатты көріп тұрғандай. ``Құдай көкте➡
Dialogue: 0,0:14:38.17,0:14:40.44,Default,,0,0,0,,Дүниеде бәрі жақсы».
Dialogue: 0,0:14:40.44,0:14:42.38,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:42.38,0:14:44.45,Default,,0,0,0,,Анна, сен ең жақсысың!
Dialogue: 0,0:14:44.45,0:14:46.91,Default,,0,0,0,,Тіпті Филлипс мырза таң қалды!
Dialogue: 0,0:14:46.91,0:14:49.92,Default,,0,0,0,,«Аспанда Хибари ұшады...»
Dialogue: 0,0:14:49.92,0:14:52.69,Default,,0,0,0,,Сүт Аннаның бетінен төмен қарай жорғалайды. Алақай!
Dialogue: 0,0:14:52.69,0:14:54.96,Default,,0,0,0,,Ruby осында.
Dialogue: 0,0:14:54.96,0:14:56.89,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:56.89,0:14:58.89,Default,,0,0,0,,А... Анна күте тұрыңыз! иә?
Dialogue: 0,0:14:58.89,0:15:03.16,Default,,0,0,0,,Дәмді тағамды барлығымен бөлісу біздің заңымыз!
Dialogue: 0,0:15:03.16,0:15:05.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:05.10,0:15:08.50,Default,,0,0,0,,Біз Энн Ширлидің арзан конькиге айналуына жол бере алмаймыз!
Dialogue: 0,0:15:08.50,0:15:11.64,Default,,0,0,0,,Алайық!
Dialogue: 0,0:15:11.64,0:15:14.08,Default,,0,0,0,,Марилланың пирогы үлкен хит болды!
Dialogue: 0,0:15:14.08,0:15:16.88,Default,,0,0,0,,үшінна әлі тойған жоқ!
Dialogue: 0,0:15:16.88,0:15:18.88,Default,,0,0,0,,Келесі жолы мен көбірек пісіремін.
Dialogue: 0,0:15:18.88,0:15:21.18,Default,,0,0,0,,Сабақ қалай өтеді?
Dialogue: 0,0:15:21.18,0:15:23.42,Default,,0,0,0,,Сабақтан сәл артта қалдым, бірақ➡
Dialogue: 0,0:15:23.42,0:15:25.42,Default,,0,0,0,,Жақсы нәрселер де болды!
Dialogue: 0,0:15:25.42,0:15:27.96,Default,,0,0,0,,Мұны маған Джейн айтты...➡
Dialogue: 0,0:15:27.96,0:15:30.02,Default,,0,0,0,,Марилла Сіз қалай ойлайсыз?
Dialogue: 0,0:15:30.02,0:15:33.09,Default,,0,0,0,,Келіңіздер. Хехе.
Dialogue: 0,0:15:33.09,0:15:36.96,Default,,0,0,0,,Менің мұрнымның пішіні өте жақсы!
Dialogue: 0,0:15:36.96,0:15:40.84,Default,,0,0,0,,О. Бұл менің өмірімде бірінші рет біреудің мені мақтауы болды!
Dialogue: 0,0:15:40.84,0:15:44.11,Default,,0,0,0,,Эй, Марилла, менің мұрным туралы не ойлайсың?
Dialogue: 0,0:15:44.11,0:15:47.98,Default,,0,0,0,,Шынымды айтсам. Жарайды... жарайды, мұрның жақсы екен.
Dialogue: 0,0:15:47.98,0:15:50.75,Default,,0,0,0,,Хехехе шынымен де~?
Dialogue: 0,0:15:50.75,0:15:52.68,Default,,0,0,0,,Ах ха ха!
Dialogue: 0,0:15:52.68,0:15:55.58,Default,,0,0,0,,Энн бүгін сен де көңілді жүрген сияқтысың.
Dialogue: 0,0:15:55.58,0:15:59.19,Default,,0,0,0,,Иә, бұл мектеп маған ұнайды деп ойлаймын.
Dialogue: 0,0:15:59.19,0:16:01.86,Default,,0,0,0,,Шынымен бе? Бұл жақсы.
Dialogue: 0,0:16:01.86,0:16:06.76,Default,,0,0,0,,Диана осылай бақытты көрінеді. Бірдеңе болды ма?
Dialogue: 0,0:16:06.76,0:16:11.57,Default,,0,0,0,,Бүгін... Гилберт Блайт мектепке қайтып келеді.
Dialogue: 0,0:16:11.57,0:16:14.30,Default,,0,0,0,,Гилберт?
Dialogue: 0,0:16:14.30,0:16:17.21,Default,,0,0,0,,Ол өте жақсы адам.
Dialogue: 0,0:16:18.91,0:16:22.64,Default,,0,0,0,,Жасы 14-ке таяп қалды, демек ол бізден үлкен.
Dialogue: 0,0:16:22.64,0:16:25.11,Default,,0,0,0,,⚟Гилберт! Әкең ауырып қалды➡
Dialogue: 0,0:16:25.11,0:16:27.18,Default,,0,0,0,,Мен Avonlea-дан біраз уақыт алыстап кеттім.
Dialogue: 0,0:16:27.18,0:16:29.85,Default,,0,0,0,,Біраз уақыт өтті! Қалайсың? (Гилберт Блайт) О!
Dialogue: 0,0:16:29.85,0:16:31.79,Default,,0,0,0,,Міне! Хмм!
Dialogue: 0,0:16:31.79,0:16:35.02,Default,,0,0,0,,♬～
Dialogue: 0,0:16:35.02,0:16:37.53,Default,,0,0,0,,Кя! Гилберт Қайтадан қош келдіңіз!
Dialogue: 0,0:16:37.53,0:16:39.46,Default,,0,0,0,,Гилберт!
Dialogue: 0,0:16:39.46,0:16:41.43,Default,,0,0,0,,Қарға! Хаа...!
Dialogue: 0,0:16:41.43,0:16:43.87,Default,,0,0,0,,Қарға? Өйткені менің шашым қара➡
Dialogue: 0,0:16:43.87,0:16:45.80,Default,,0,0,0,,Мен сені үнемі осылай ойнап атаймын.
Dialogue: 0,0:16:45.80,0:16:49.17,Default,,0,0,0,,Енді Гилберт. иә?
Dialogue: 0,0:16:49.17,0:16:53.34,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:16:53.34,0:16:56.08,Default,,0,0,0,,Өте жақсы. Керемет, Гилберт.
Dialogue: 0,0:16:56.08,0:16:59.01,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:16:59.01,0:17:03.35,Default,,0,0,0,,Демалысқа шығар алдында Гилберт өз сыныбында үздік болды.
Dialogue: 0,0:17:03.35,0:17:07.22,Default,,0,0,0,,көремін. Мен бәсекелес адам барына қуаныштымын.
Dialogue: 0,0:17:07.22,0:17:10.12,Default,,0,0,0,,Енді тағы бір сұраққа жауап берейін. ➡
Dialogue: 0,0:17:10.12,0:17:12.63,Default,,0,0,0,,Өзіне сенімді адам...➡
Dialogue: 0,0:17:12.63,0:17:14.56,Default,,0,0,0,,Руби Гиллис. Ах.
Dialogue: 0,0:17:14.56,0:17:18.47,Default,,0,0,0,,Иә! Жақсы….
Dialogue: 0,0:17:18.47,0:17:21.37,Default,,0,0,0,,Ах! (Рубин) Кя!
Dialogue: 0,0:17:21.37,0:17:23.64,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:17:23.64,0:17:27.11,Default,,0,0,0,,Сіздің Гилбертіңіз жақсы болуы мүмкін, бірақ➡
Dialogue: 0,0:17:27.11,0:17:29.04,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:17:29.04,0:17:32.45,Default,,0,0,0,,Кім? (Джимми Глова) Бұл қазір ең жоғары ұпай жинаған Энн Ширли.
Dialogue: 0,0:17:32.45,0:17:36.32,Default,,0,0,0,,Һмм.
Dialogue: 0,0:17:36.32,0:17:39.09,Default,,0,0,0,,Мен жаңа көйлек тіктірдім. Эй.
Dialogue: 0,0:17:39.09,0:17:41.02,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:17:41.02,0:17:43.93,Default,,0,0,0,,Тыныш оқы!
Dialogue: 0,0:17:47.23,0:17:49.33,Default,,0,0,0,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:17:51.87,0:17:53.97,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:56.34,0:17:58.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:00.14,0:18:02.74,Default,,0,0,0,,Жүрек үні Ах...
Dialogue: 0,0:18:08.85,0:18:11.59,Default,,0,0,0,,Ах. а….
Dialogue: 0,0:18:14.29,0:18:17.49,Default,,0,0,0,,Гилбертті қыздар елемейді! ➡
Dialogue: 0,0:18:17.49,0:18:20.19,Default,,0,0,0,,Сол Гилберт! Ой... ой... Қарғыс атсын!
Dialogue: 0,0:18:25.60,0:18:29.24,Default,,0,0,0,,Сәбіз. Ах.
Dialogue: 0,0:18:29.24,0:18:31.44,Default,,0,0,0,,...
Dialogue: 0,0:18:34.64,0:18:36.58,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:18:36.58,0:18:39.81,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:18:39.81,0:18:50.86,Default,,0,0,0,,♬～
Dialogue: 0,0:18:50.86,0:18:52.79,Default,,0,0,0,,Иә! (тас сынған дыбыс)
Dialogue: 0,0:18:52.79,0:18:56.16,Default,,0,0,0,,(тас жарылған дыбыс)
Dialogue: 0,0:18:56.16,0:18:58.87,Default,,0,0,0,,Ах...! О, бұл керемет! (Джимми ысқырады)
Dialogue: 0,0:18:58.87,0:19:09.28,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:19:09.28,0:19:11.21,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:19:11.21,0:19:13.95,Default,,0,0,0,,Ой, кешіріңіз, ұстаз! Бұл менің кінәм!
Dialogue: 0,0:19:13.95,0:19:17.59,Default,,0,0,0,,Энн Ширли Бұл нені білдіреді?
Dialogue: 0,0:19:17.59,0:19:20.59,Default,,0,0,0,,Энн Ширлиді түсіндіріңіз.
Dialogue: 0,0:19:23.12,0:19:25.73,Default,,0,0,0,,Жарайды. Сабақ біткенше ➡
Dialogue: 0,0:19:25.73,0:19:29.60,Default,,0,0,0,,Тақтаның алдына тұру. ➡
Dialogue: 0,0:19:29.60,0:19:32.50,Default,,0,0,0,,«Анна Ширли оқуға дейін➡
Dialogue: 0,0:19:32.50,0:19:35.04,Default,,0,0,0,,Өзіңізді ұстаңыз ➡
Dialogue: 0,0:19:35.04,0:19:39.74,Default,,0,0,0,,Сіз үйренуіңіз керек». ➡
Dialogue: 0,0:19:39.74,0:19:44.18,Default,,0,0,0,,Енді сабақты бастайық. Оқулығыңызды 25-бетке ашыңыз. ➡
Dialogue: 0,0:19:44.18,0:19:47.42,Default,,0,0,0,,Енді не болды? Алаңдамаңыз!
Dialogue: 0,0:19:47.42,0:19:49.35,Default,,0,0,0,,Жүрек үні «е» жоқ...
Dialogue: 0,0:19:49.35,0:19:51.85,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:19:51.85,0:19:54.82,Default,,0,0,0,,Энн! Энн Ширли!
Dialogue: 0,0:19:54.82,0:19:56.82,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:56.82,0:19:59.59,Default,,0,0,0,,Сізді ертерек мазақ еткенім үшін кешіріңіз.
Dialogue: 0,0:19:59.59,0:20:01.63,Default,,0,0,0,,Мен кешірім сұраймын. Кешіріңіз...➡
Dialogue: 0,0:20:01.63,0:20:03.76,Default,,0,0,0,,Ах.
Dialogue: 0,0:20:03.76,0:20:06.33,Default,,0,0,0,,Ах…. (жүгіру дыбысы)
Dialogue: 0,0:20:06.33,0:20:09.30,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:20:09.30,0:20:13.44,Default,,0,0,0,,(жүру дыбысы)
Dialogue: 0,0:20:13.44,0:20:17.31,Default,,0,0,0,,Филлипс мырза неге менің «е»-імді ұмытады?
Dialogue: 0,0:20:17.31,0:20:19.35,Default,,0,0,0,,Гилберт Блайт➡
Dialogue: 0,0:20:19.35,0:20:22.25,Default,,0,0,0,,Неге менің шашымды мазақ етесің!
Dialogue: 0,0:20:24.09,0:20:27.29,Default,,0,0,0,,Қазірдің өзінде! қазірдің өзінде! қазірдің өзінде!
Dialogue: 0,0:20:29.02,0:20:34.73,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:20:34.73,0:20:38.47,Default,,0,0,0,,(Шөптің тербелген дыбысы)
Dialogue: 0,0:20:38.47,0:20:41.14,Default,,0,0,0,,Бірге орындаймыз ба?
Dialogue: 0,0:20:41.14,0:20:43.70,Default,,0,0,0,,Сіз өзіңізді сәл жақсы сезінесіз.
Dialogue: 0,0:20:43.70,0:20:47.14,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:20:47.14,0:20:51.01,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:51.01,0:20:55.85,Default,,0,0,0,,Жоқ! уақытында болуы мүмкін емес! (Көңілсіз Чарли) Ха... ха... иә....
Dialogue: 0,0:20:55.85,0:20:57.85,Default,,0,0,0,,Ха... ха... ха...!
Dialogue: 0,0:20:57.85,0:21:00.09,Default,,0,0,0,,А-а-а-а-а!
Dialogue: 0,0:21:00.09,0:21:02.02,Default,,0,0,0,,Ой! (Энн Джимми Муди Чарли) Уау!
Dialogue: 0,0:21:02.02,0:21:05.33,Default,,0,0,0,,Уф…. ➡
Dialogue: 0,0:21:05.33,0:21:07.86,Default,,0,0,0,,Энн Ширли!
Dialogue: 0,0:21:07.86,0:21:11.87,Default,,0,0,0,,Сізге ұлдармен бірге болған ұнайтын сияқты.
Dialogue: 0,0:21:11.87,0:21:14.70,Default,,0,0,0,,Олай болса сол тілегімізді орындайық!
Dialogue: 0,0:21:14.70,0:21:17.84,Default,,0,0,0,,Бұл ер балаларға арналған орын болса да...
Dialogue: 0,0:21:17.84,0:21:21.34,Default,,0,0,0,,Нашар...
Dialogue: 0,0:21:21.34,0:21:23.28,Default,,0,0,0,,Анна….
Dialogue: 0,0:21:23.28,0:21:27.85,Default,,0,0,0,,♬～
Dialogue: 0,0:21:27.85,0:21:32.72,Default,,0,0,0,,Энн, сен оны неге тазалап жатырсың? Әлі сабақтарым қалды.
Dialogue: 0,0:21:32.72,0:21:35.06,Default,,0,0,0,,Энн!
Dialogue: 0,0:21:35.06,0:21:37.96,Default,,0,0,0,,Мен Диана үшін бәрін жасаймын.
Dialogue: 0,0:21:37.96,0:21:40.23,Default,,0,0,0,,Жарылып кетсем бәрібір.
Dialogue: 0,0:21:40.23,0:21:43.86,Default,,0,0,0,,Бірақ бұл мен ымыраға келмейтін бір нәрсе.
Dialogue: 0,0:21:43.86,0:21:46.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:46.67,0:21:50.91,Default,,0,0,0,,Қандай ақымақ! Бұл мүлдем ақымақ емес!
Dialogue: 0,0:21:50.91,0:21:53.24,Default,,0,0,0,,А... Білмеймін бе?
Dialogue: 0,0:21:53.24,0:21:55.94,Default,,0,0,0,,Мені қорлады!
Dialogue: 0,0:21:55.94,0:22:00.21,Default,,0,0,0,,Сондықтан мен енді ешқашан мектепке бармаймын.
Dialogue: 0,0:22:00.21,0:22:02.18,Default,,0,0,0,,Анна….
Dialogue: 0,0:22:02.18,0:22:04.42,Default,,0,0,0,,Жүрек үні, дәл осы жолы➡
Dialogue: 0,0:22:04.42,0:22:07.82,Default,,0,0,0,,Мен Рейчелмен сөйлесуім керек...
Dialogue: 0,0:22:09.56,0:22:19.00,Default,,0,0,0,,♬～
Dialogue: 0,0:22:19.00,0:22:21.84,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:21.84,0:22:29.11,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:29.11,0:22:33.58,Default,,0,0,0,,♬ «Сен білмей тұрып өтетін қала»
Dialogue: 0,0:22:33.58,0:22:38.89,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:38.89,0:22:43.69,Default,,0,0,0,,♬ «Таңның жарығына таң қалу»
Dialogue: 0,0:22:43.69,0:22:48.56,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:48.56,0:22:55.67,Default,,0,0,0,,♬ «Мен аңсаған дүние қабақтың сыртында»
Dialogue: 0,0:22:55.67,0:22:59.67,Default,,0,0,0,,♬ «Мен оны тауып, сонда бара аламын».
Dialogue: 0,0:22:59.67,0:23:04.81,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:04.81,0:23:09.98,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:09.98,0:23:14.56,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:14.56,0:23:19.53,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:19.53,0:23:28.20,Default,,0,0,0,,♬ «Жүрегің қалаған бағытта жүр».
Dialogue: 0,0:23:28.20,0:23:33.44,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:33.44,0:23:37.85,Default,,0,0,0,,♬～
Dialogue: 0,0:23:39.35,0:24:01.04,Default,,0,0,0,,♬～
