Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.65,0:00:05.55,Default,,0,0,0,,<Менің болашақ арманым мектеп мұғалімі болу. ➡
Dialogue: 0,0:00:05.55,0:00:07.59,Default,,0,0,0,,Иә, мен шешкен күні➡
Dialogue: 0,0:00:07.59,0:00:12.16,Default,,0,0,0,,Мэтью кенеттен жүрегін қысып құлап қалды. ➡
Dialogue: 0,0:00:12.16,0:00:15.06,Default,,0,0,0,,Бақытымызға орай, маңызды ештеңе болған жоқ➡
Dialogue: 0,0:00:15.06,0:00:17.96,Default,,0,0,0,,Мен өзімді шын жүректен жеңілдедім＞
Dialogue: 0,0:00:17.96,0:00:21.34,Default,,0,0,0,,Бұдан кейін Матай қалай?
Dialogue: 0,0:00:21.34,0:00:25.84,Default,,0,0,0,,Бұл жаман шабуыл болды, бірақ мен қазір өзімді әлдеқайда жақсы сезінемін.
Dialogue: 0,0:00:25.84,0:00:28.18,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:28.18,0:00:33.05,Default,,0,0,0,,Дәрігерлер эмоцияңызды қоздыратын нәрселерден аулақ болыңыз дейді...➡
Dialogue: 0,0:00:33.05,0:00:35.95,Default,,0,0,0,,Мэтью ынталандыруды қаламайды, солай ма?
Dialogue: 0,0:00:35.95,0:00:38.82,Default,,0,0,0,,Ахахаха! Бұл дұрыс.
Dialogue: 0,0:00:38.82,0:00:42.19,Default,,0,0,0,,Ауыр көтеруді орындаған дұрыс болар еді➡
Dialogue: 0,0:00:42.19,0:00:44.86,Default,,0,0,0,,Мэтьюге «Жұмыс істеме» деп айту➡
Dialogue: 0,0:00:44.86,0:00:48.20,Default,,0,0,0,,«Тыныс алма» дегенмен бірдей.
Dialogue: 0,0:00:48.20,0:00:51.50,Default,,0,0,0,,А, анау бала ма?
Dialogue: 0,0:00:51.50,0:00:54.30,Default,,0,0,0,,Иә. Ол Джерри Бут деп аталады.
Dialogue: 0,0:00:54.30,0:00:57.20,Default,,0,0,0,,Мен ауыр жүкті көтеруге көмектесемін.
Dialogue: 0,0:00:57.20,0:00:59.71,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:00:59.71,0:01:02.61,Default,,0,0,0,,А... Марилла Бүгінгі газетте не бар?
Dialogue: 0,0:01:02.61,0:01:05.55,Default,,0,0,0,,Ол сонда.
Dialogue: 0,0:01:05.55,0:01:09.15,Default,,0,0,0,,Не болды? Мен сондай асықтым.
Dialogue: 0,0:01:09.15,0:01:12.52,Default,,0,0,0,,Королева академиясына табысты үміткерлер жарияланды.
Dialogue: 0,0:01:12.52,0:01:16.46,Default,,0,0,0,,Жоқ... жоқ! Менің атым...!
Dialogue: 0,0:01:16.46,0:01:19.16,Default,,0,0,0,,Гилберт... 1-ші?
Dialogue: 0,0:01:19.16,0:01:23.03,Default,,0,0,0,,Жоқ... бұл... бұл өтірік, солай ма?
Dialogue: 0,0:01:23.03,0:01:24.97,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:01:24.97,0:01:27.03,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,0:01:27.03,0:01:29.17,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:29.17,0:01:34.11,Default,,0,0,0,,Ах…. (Оқушылар күледі)
Dialogue: 0,0:01:34.11,0:01:36.24,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:01:36.24,0:01:38.61,Default,,0,0,0,,Иә, иә, барлығы.
Dialogue: 0,0:01:38.61,0:01:43.45,Default,,0,0,0,,...
Dialogue: 0,0:01:43.45,0:01:45.75,Default,,0,0,0,,Олай болса түскі ас ішейік.
Dialogue: 0,0:01:45.75,0:01:48.66,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:01:48.66,0:01:57.86,Default,,0,0,0,,♬～
Dialogue: 0,0:01:57.86,0:02:02.47,Default,,0,0,0,,♬「」
Dialogue: 0,0:02:02.47,0:02:05.01,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:05.01,0:02:06.94,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:06.94,0:02:10.81,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:10.81,0:02:13.15,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:13.15,0:02:15.38,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:15.38,0:02:19.92,Default,,0,0,0,,♬「 」
Dialogue: 0,0:02:19.92,0:02:25.13,Default,,0,0,0,,♬「 」
Dialogue: 0,0:02:25.13,0:02:27.06,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:02:27.06,0:02:30.93,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:30.93,0:02:34.33,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:34.33,0:02:36.77,Default,,0,0,0,,♬ «Мен осында күтемін.»
Dialogue: 0,0:02:36.77,0:02:39.04,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:39.04,0:02:43.28,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:43.28,0:02:45.75,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:45.75,0:02:48.08,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:48.08,0:02:51.55,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:51.55,0:02:54.86,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:54.86,0:02:57.09,Default,,0,0,0,,♬ «Эй, мен күтемін.»
Dialogue: 0,0:02:57.09,0:03:01.29,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:01.29,0:03:03.80,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:03:03.80,0:03:06.10,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:06.10,0:03:08.10,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:08.10,0:03:12.47,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:12.47,0:03:16.38,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.05,0:03:23.65,Default,,0,0,0,,♬～
Dialogue: 0,0:03:26.65,0:03:31.63,Default,,0,0,0,,Сабақ кезінде ұйықтап қалудың несі жаман? Ол да Эннге ұқсамайды.
Dialogue: 0,0:03:31.63,0:03:35.73,Default,,0,0,0,,Емтиханнан өте алмай қалдым деп армандадым... жаным....
Dialogue: 0,0:03:35.73,0:03:38.70,Default,,0,0,0,,Сіз шаршаған сияқтысыз. (Анна Диана) А...
Dialogue: 0,0:03:38.70,0:03:41.13,Default,,0,0,0,,Доктор Стейси….
Dialogue: 0,0:03:41.13,0:03:44.70,Default,,0,0,0,,Емтихан келесі жазда. Әлі көп жол бар.
Dialogue: 0,0:03:44.70,0:03:48.38,Default,,0,0,0,,Тамырды көп жинасаң, басың жарылады, солай ма?
Dialogue: 0,0:03:48.38,0:03:52.25,Default,,0,0,0,,Олай болса, ұстаз, қиналып қаласыз. (Анна Диана) Хехе!
Dialogue: 0,0:03:52.25,0:03:55.15,Default,,0,0,0,,Оқу - бұл жай ғана қызық, солай ма?
Dialogue: 0,0:03:55.15,0:03:58.15,Default,,0,0,0,,Иә! Хехе.
Dialogue: 0,0:03:59.89,0:04:01.82,Default,,0,0,0,,<Маусым қызық➡
Dialogue: 0,0:04:01.82,0:04:04.66,Default,,0,0,0,,Уақыт зымырап өтіп жатыр➡
Dialogue: 0,0:04:04.66,0:04:08.23,Default,,0,0,0,,Көктем келді, мен 15 жастамын>
Dialogue: 0,0:04:08.23,0:04:11.57,Default,,0,0,0,,Хмм….
Dialogue: 0,0:04:11.57,0:04:13.50,Default,,0,0,0,,Уау. а….
Dialogue: 0,0:04:13.50,0:04:16.10,Default,,0,0,0,,Иә. рақмет сізге.
Dialogue: 0,0:04:18.34,0:04:24.14,Default,,0,0,0,,♬～
Dialogue: 0,0:04:24.14,0:04:28.58,Default,,0,0,0,,Джерри маған бәріне көмектеседі.
Dialogue: 0,0:04:28.58,0:04:30.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:30.52,0:04:34.82,Default,,0,0,0,,Марилла, не болды?
Dialogue: 0,0:04:34.82,0:04:40.73,Default,,0,0,0,,Мен Анн туралы ойладым. Мен оның соншалықты үлкен болғанына сене алмаймын ...
Dialogue: 0,0:04:40.73,0:04:44.16,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:44.16,0:04:48.94,Default,,0,0,0,,Ал келесі қыста ол мұнда болмайтын шығар.
Dialogue: 0,0:04:48.94,0:04:54.67,Default,,0,0,0,,А... келесі жолы Кармодиде жаңа станция болады, солай ма? ➡
Dialogue: 0,0:04:54.67,0:05:01.08,Default,,0,0,0,,Осы жерде. Аннаның да қазір қайтып келуі бұрынғыдан да жоғары.
Dialogue: 0,0:05:01.08,0:05:03.88,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:05:03.88,0:05:09.22,Default,,0,0,0,,♬～
Dialogue: 0,0:05:09.22,0:05:15.03,Default,,0,0,0,,Анн. Сіз бұл күндері бұрынғыдай жарты сөйлемейтінсіз.
Dialogue: 0,0:05:15.03,0:05:17.70,Default,,0,0,0,,Не болды? ➡
Dialogue: 0,0:05:17.70,0:05:21.00,Default,,0,0,0,,Мен бұдан былай тым артық сөздер айтпаймын.
Dialogue: 0,0:05:21.00,0:05:24.70,Default,,0,0,0,,Мен білмеймін. Мен көп сөйлескім келмейді.
Dialogue: 0,0:05:24.70,0:05:26.77,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:05:26.77,0:05:29.48,Default,,0,0,0,,Бұндай сөздерді қолдануға болмайды➡
Dialogue: 0,0:05:29.48,0:05:31.41,Default,,0,0,0,,Ересек болсам да.
Dialogue: 0,0:05:31.41,0:05:33.71,Default,,0,0,0,,Өсу қызық.
Dialogue: 0,0:05:33.71,0:05:36.95,Default,,0,0,0,,Бірақ істеу керек және ойланатын нәрселер бар➡
Dialogue: 0,0:05:36.95,0:05:38.92,Default,,0,0,0,,Өте көп➡
Dialogue: 0,0:05:38.92,0:05:42.22,Default,,0,0,0,,Менің асыра сөздерге уақытым жоқ.
Dialogue: 0,0:05:42.22,0:05:45.13,Default,,0,0,0,,Емтиханға жақсы дайындалып жатырсыз ба?
Dialogue: 0,0:05:45.13,0:05:49.50,Default,,0,0,0,,Мен мұны істеп көңілді жүрмін. Бірақ...
Dialogue: 0,0:05:49.50,0:05:52.23,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:05:52.23,0:05:54.73,Default,,0,0,0,,Құлап қалсам ше?➡
Dialogue: 0,0:05:54.73,0:05:56.74,Default,,0,0,0,,Кей түндер маған ұнамайды.
Dialogue: 0,0:05:56.74,0:05:59.57,Default,,0,0,0,,Егер мен Queen Academy емтиханынан өте алмасам➡
Dialogue: 0,0:05:59.57,0:06:03.44,Default,,0,0,0,,Біз мәңгілік көктемнің рахатын көре алмаймыз.
Dialogue: 0,0:06:03.44,0:06:08.28,Default,,0,0,0,,Осы жылы үлгермесеңіз де, келесі жылы неге қайта алмасқа?
Dialogue: 0,0:06:08.28,0:06:11.32,Default,,0,0,0,,Менің бұлай істеуге батылым жетпейді деп ойлаймын.
Dialogue: 0,0:06:11.32,0:06:13.69,Default,,0,0,0,,Гилба... Ах... Жоқ!
Dialogue: 0,0:06:13.69,0:06:16.46,Default,,0,0,0,,Тек басқа адамдар өтсе ғана ойлайды➡
Dialogue: 0,0:06:16.46,0:06:18.86,Default,,0,0,0,,Менің басым ауырып тұр!
Dialogue: 0,0:06:23.03,0:06:27.20,Default,,0,0,0,,Доктор Стейсидің соңғы сәлемдесу керемет болды.
Dialogue: 0,0:06:27.20,0:06:29.27,Default,,0,0,0,,үшін жылап жатты.
Dialogue: 0,0:06:29.27,0:06:33.54,Default,,0,0,0,,Иә... Бәрі біткен сияқты.
Dialogue: 0,0:06:33.54,0:06:38.14,Default,,0,0,0,,О, Диана келесі қыста әлі де қатыса алады, сондықтан жақсы.
Dialogue: 0,0:06:38.14,0:06:42.92,Default,,0,0,0,,Мен бұл ностальгиялық мектептен мәңгілікке кетемін.
Dialogue: 0,0:06:42.92,0:06:47.25,Default,,0,0,0,,Емтиханды тапсыру бақыты бұйырса...
Dialogue: 0,0:06:47.25,0:06:51.96,Default,,0,0,0,,Бірақ келесі жылы доктор Стейси, Джейн немесе Руби болмайды...
Dialogue: 0,0:06:51.96,0:06:55.36,Default,,0,0,0,,Ең бастысы, Энн, сен мұнда емессің...
Dialogue: 0,0:06:55.36,0:06:57.30,Default,,0,0,0,,О, Диана…➡
Dialogue: 0,0:06:57.30,0:06:59.87,Default,,0,0,0,,Өтінемін, өтінемін, жылама.
Dialogue: 0,0:06:59.87,0:07:03.10,Default,,0,0,0,,Әйтпесе, мен де...
Dialogue: 0,0:07:03.10,0:07:05.31,Default,,0,0,0,,(Диана мен Аннаның жылауы)
Dialogue: 0,0:07:07.77,0:07:12.31,Default,,0,0,0,,Королева академиясының емтиханы келесі аптада өтеді. Иә.
Dialogue: 0,0:07:12.31,0:07:16.92,Default,,0,0,0,,Стейси ханым қалаға келгенде емтихан туралы ойламады➡
Dialogue: 0,0:07:16.92,0:07:20.69,Default,,0,0,0,,Түнде ерте серуендеп, демалыңыз.
Dialogue: 0,0:07:20.69,0:07:23.22,Default,,0,0,0,,Мен бұл мүмкін бе деп ойлаймын ...
Dialogue: 0,0:07:23.22,0:07:26.46,Default,,0,0,0,,Мен де Аннамен бірге барғым келеді.
Dialogue: 0,0:07:26.46,0:07:28.40,Default,,0,0,0,,Бірақ жоқ...
Dialogue: 0,0:07:28.40,0:07:31.66,Default,,0,0,0,,Мен өзімді әр түнде қысып тұруға мәжбүрлей алмаймын➡
Dialogue: 0,0:07:31.66,0:07:34.57,Default,,0,0,0,,Сіз міндетті түрде үйді сағынасыз.
Dialogue: 0,0:07:34.57,0:07:36.50,Default,,0,0,0,,Мен сізге хат жіберемін.
Dialogue: 0,0:07:36.50,0:07:39.01,Default,,0,0,0,,Иә! иә! Сейсенбі түні➡
Dialogue: 0,0:07:39.01,0:07:41.64,Default,,0,0,0,,Сол күні емтихан қалай өткенін жазыңыз.
Dialogue: 0,0:07:41.64,0:07:45.55,Default,,0,0,0,,Олай болса, мен сәрсенбі күні таңертең пошта бөлімшесінде күтемін!
Dialogue: 0,0:07:45.55,0:07:49.15,Default,,0,0,0,,Диана? Мен ол жерге ерте жете алмаймын.
Dialogue: 0,0:07:49.15,0:07:53.32,Default,,0,0,0,,Дұрыс... (Анна Диана) Ахаха!
Dialogue: 0,0:07:53.32,0:07:58.22,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:07:58.22,0:08:01.53,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:01.53,0:08:03.46,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:03.46,0:08:05.70,Default,,0,0,0,,Бұл! Маған хатыңыз бар ма?
Dialogue: 0,0:08:05.70,0:08:09.87,Default,,0,0,0,,Не? Ал, Диана... Диана Берли... ➡
Dialogue: 0,0:08:09.87,0:08:13.37,Default,,0,0,0,,Иә, өтінемін. Ах... рахмет!
Dialogue: 0,0:08:16.78,0:08:22.78,Default,,0,0,0,,``Құрметті Диана. Сейсенбінің түні. Мен бұл хатты қонақ үйімде жазып отырмын.➡
Dialogue: 0,0:08:22.78,0:08:25.12,Default,,0,0,0,,Королева академиясына келгенде➡
Dialogue: 0,0:08:25.12,0:08:28.66,Default,,0,0,0,,Аралдың түкпір-түкпірінен келген студенттер көп болды. ➡
Dialogue: 0,0:08:28.66,0:08:32.56,Default,,0,0,0,,Менің қасымда отырған Джейн сондай сабырлы➡
Dialogue: 0,0:08:32.56,0:08:34.89,Default,,0,0,0,,Мен қызғаншақ болдым. ➡
Dialogue: 0,0:08:34.89,0:08:36.96,Default,,0,0,0,,Мен әлі қобалжыдым➡
Dialogue: 0,0:08:36.96,0:08:40.03,Default,,0,0,0,,Менің жүрегімнің соғуын айналамдағылар ести ме деп ойлаймын➡
Dialogue: 0,0:08:40.03,0:08:42.34,Default,,0,0,0,,Мен қатты уайымдадым. ➡
Dialogue: 0,0:08:42.34,0:08:44.80,Default,,0,0,0,,Жапон тілінен емтихан қағазын алған сәт➡
Dialogue: 0,0:08:44.80,0:08:49.34,Default,,0,0,0,,Қолым суып, басым айналып кетті».
Dialogue: 0,0:08:49.34,0:08:51.34,Default,,0,0,0,,(пломбаның сынған дыбысы)
Dialogue: 0,0:08:51.34,0:08:55.15,Default,,0,0,0,,«Біраз уақыттан кейін бәрі түсінікті болды.➡
Dialogue: 0,0:08:55.15,0:08:59.35,Default,,0,0,0,,Өйткені мен мәселені қандай да бір жолмен шеше алатынымды білдім.''
Dialogue: 0,0:09:01.25,0:09:04.26,Default,,0,0,0,,«Түскі астан кейін түстен кейін тарих пәнінен емтихан болады.➡
Dialogue: 0,0:09:04.26,0:09:06.49,Default,,0,0,0,,Бұл өте қиын болды➡
Dialogue: 0,0:09:06.49,0:09:08.43,Default,,0,0,0,,Мен өте жақсы орындадым деп ойлаймын». (Джейн Эндрюс) Қалай болды?
Dialogue: 0,0:09:08.43,0:09:10.86,Default,,0,0,0,,Менің ойымша, бәрі жақсы.
Dialogue: 0,0:09:10.86,0:09:12.80,Default,,0,0,0,,«Рубин жапон тілінен емтиханда болды➡
Dialogue: 0,0:09:12.80,0:09:15.44,Default,,0,0,0,,Мен үлкен қателік жібергенімді түсіндім➡
Dialogue: 0,0:09:15.44,0:09:17.87,Default,,0,0,0,,Мен қатты ренжідім». (Руби Гиллис) Күрсін...
Dialogue: 0,0:09:17.87,0:09:20.11,Default,,0,0,0,,«Рубидің жағдайы төмендегеннен кейін➡
Dialogue: 0,0:09:20.11,0:09:24.54,Default,,0,0,0,,Тауға шығып балмұздақ жедік! ➡
Dialogue: 0,0:09:24.54,0:09:27.35,Default,,0,0,0,,Диана сонда болғанда жақсы болар еді! ➡
Dialogue: 0,0:09:27.35,0:09:29.28,Default,,0,0,0,,О, Диана! ➡
Dialogue: 0,0:09:29.28,0:09:33.02,Default,,0,0,0,,Мен ертеңгі математика емтиханын аяқтасам, қаншалықты оңай болар еді! ➡
Dialogue: 0,0:09:33.02,0:09:36.66,Default,,0,0,0,,Бірақ математикадан сәтсіз болсам да➡
Dialogue: 0,0:09:36.66,0:09:40.46,Default,,0,0,0,,Күн әлі шығып, батады. ➡
Dialogue: 0,0:09:40.46,0:09:45.03,Default,,0,0,0,,Бір орында тұрып қалсаңыз, біраз жұбаныш болар еді...''
Dialogue: 0,0:09:45.03,0:09:49.24,Default,,0,0,0,,Хехе. «Сенің адал Аннадан».
Dialogue: 0,0:09:55.78,0:09:58.91,Default,,0,0,0,,Хмм. ➡
Dialogue: 0,0:09:58.91,0:10:01.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:02.78,0:10:07.62,Default,,0,0,0,,Бұл онжылдықтарда бірінші рет бас қосу сияқты емес.
Dialogue: 0,0:10:07.62,0:10:09.59,Default,,0,0,0,,Энн! а...!
Dialogue: 0,0:10:09.59,0:10:11.82,Default,,0,0,0,,Диана~!
Dialogue: 0,0:10:11.82,0:10:14.43,Default,,0,0,0,,Энн! Хех, мен үйдемін!
Dialogue: 0,0:10:14.43,0:10:17.33,Default,,0,0,0,,Қайтадан қош келдіңіз! Мен сені сағындым Анна!
Dialogue: 0,0:10:17.33,0:10:19.60,Default,,0,0,0,,Мен де, Диана!
Dialogue: 0,0:10:19.60,0:10:22.50,Default,,0,0,0,,Энн солай ма? Емтихан қалай өтті?
Dialogue: 0,0:10:22.50,0:10:26.37,Default,,0,0,0,,Математикадан басқасы жақсы өтті деп ойлаймын. Ал қалғандары ше?
Dialogue: 0,0:10:26.37,0:10:30.08,Default,,0,0,0,,үшін сен өте алмайсың дейді➡
Dialogue: 0,0:10:30.08,0:10:32.01,Default,,0,0,0,,Өте жақсы шыққан сияқты.
Dialogue: 0,0:10:32.01,0:10:36.28,Default,,0,0,0,,Бірақ біз нәтижелерді алмайынша білмейміз.
Dialogue: 0,0:10:36.28,0:10:40.95,Default,,0,0,0,,Хабарландыру шыққанша қатты толқыдым. Мен екі аптадан бері мазасызданып жүрмін.
Dialogue: 0,0:10:40.95,0:10:45.79,Default,,0,0,0,,Ұйықтап кетсем ғой, оянсам, хабарландыру айтылар еді.
Dialogue: 0,0:10:45.79,0:10:49.20,Default,,0,0,0,,Жарайды! үшінның өтетініне сенімдімін.
Dialogue: 0,0:10:49.20,0:10:51.13,Default,,0,0,0,,Мен солай деп үміттенемін!
Dialogue: 0,0:10:51.13,0:10:54.03,Default,,0,0,0,,Ахаха Бірақ қайтып келгеніме қуаныштымын!
Dialogue: 0,0:10:54.03,0:10:59.64,Default,,0,0,0,,Әлемде Green Gables сияқты жер жоқ!
Dialogue: 0,0:11:01.81,0:11:04.38,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:04.38,0:11:10.48,Default,,0,0,0,,Ол тізімде жоқ. Тест нәтижелері екі аптадан кейін шығады...
Dialogue: 0,0:11:10.48,0:11:14.25,Default,,0,0,0,,⚟ (Мартин Эндрюс) Эй, Queen Academy емтиханын кім тапсырады деп ойлайсың?
Dialogue: 0,0:11:14.25,0:11:17.92,Default,,0,0,0,,Менің мектебімдегі үздік оқушылар – Энн мен Гилберт.
Dialogue: 0,0:11:17.92,0:11:20.93,Default,,0,0,0,,Кім жеңетініне бәс тігейік. жақсы!
Dialogue: 0,0:11:20.93,0:11:23.46,Default,,0,0,0,,Мен де сол бәсті аламын. (2 адам) Әй?
Dialogue: 0,0:11:23.46,0:11:25.93,Default,,0,0,0,,Гилберт жеңуі керек, солай ма?
Dialogue: 0,0:11:25.93,0:11:28.23,Default,,0,0,0,,⚟(Мартин) Дұрыс. ⚟Мен де Гилберт.
Dialogue: 0,0:11:28.23,0:11:31.14,Default,,0,0,0,,⚟(Джози) Не? Бұл құмар ойын емес.
Dialogue: 0,0:11:31.14,0:11:36.74,Default,,0,0,0,,Егер мен өте жақсы баға алмасам, мен сәтсіздікке ұшырағаным артық!
Dialogue: 0,0:11:36.74,0:11:40.08,Default,,0,0,0,,Сәлем, Энн!
Dialogue: 0,0:11:40.08,0:11:42.45,Default,,0,0,0,,А, мен әлі де нәтижені көргім келеді.
Dialogue: 0,0:11:42.45,0:11:44.55,Default,,0,0,0,,Не? Расында ма? Анна күт!
Dialogue: 0,0:11:46.42,0:11:48.89,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:48.89,0:11:51.79,Default,,0,0,0,,Энн, сен тамақ ішпейсің бе? иә?
Dialogue: 0,0:11:51.79,0:11:57.73,Default,,0,0,0,,Күрсініп... Үш аптадан бері айтылмады... Тәбетім ашылды...
Dialogue: 0,0:11:57.73,0:12:00.57,Default,,0,0,0,,Дәреже енді маңызды емес.
Dialogue: 0,0:12:00.57,0:12:05.04,Default,,0,0,0,,үшін өтіп, мен ғана өтпей қалсам ше...
Dialogue: 0,0:12:05.04,0:12:09.74,Default,,0,0,0,,Сіз бүкіл аралды жеңіп, ең жақсы боласыз.
Dialogue: 0,0:12:09.74,0:12:13.05,Default,,0,0,0,,Не? Матай. Анна қанша болса да...
Dialogue: 0,0:12:13.05,0:12:14.98,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:12:14.98,0:12:17.18,Default,,0,0,0,,Хмм!
Dialogue: 0,0:12:23.16,0:12:25.63,Default,,0,0,0,,А…?
Dialogue: 0,0:12:25.63,0:12:27.63,Default,,0,0,0,,Ха... ха... ахаха!
Dialogue: 0,0:12:27.63,0:12:30.46,Default,,0,0,0,,Аха!
Dialogue: 0,0:12:30.46,0:12:32.47,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:12:32.47,0:12:36.60,Default,,0,0,0,,Диана! Әкем мұны Жарқын өзеннен әкелді.
Dialogue: 0,0:12:36.60,0:12:39.57,Default,,0,0,0,,Газеттер ертең таңертең Авонлеаға келеді!
Dialogue: 0,0:12:39.57,0:12:42.38,Default,,0,0,0,,Энн Сен біріншісің! сурет?
Dialogue: 0,0:12:42.38,0:12:46.31,Default,,0,0,0,,Біз бүкіл арал бойынша бірінші орынды жеңіп алдық! Содан кейін Гилберт бар.
Dialogue: 0,0:12:46.31,0:12:49.15,Default,,0,0,0,,Бірақ Энннің аты бірінші орында!
Dialogue: 0,0:12:49.15,0:12:51.95,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін!
Dialogue: 0,0:12:51.95,0:12:55.86,Default,,0,0,0,,Қалғандары да өтті. А... дұрыс...
Dialogue: 0,0:12:55.86,0:12:58.19,Default,,0,0,0,,Мен де аналарға айтуым керек!
Dialogue: 0,0:12:58.19,0:13:00.73,Default,,0,0,0,,Аа... (Линд ханым) Жарайды! иә?
Dialogue: 0,0:13:00.73,0:13:03.63,Default,,0,0,0,,Бұл таңқаларлық емес пе? (Линд ханым) Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:13:03.63,0:13:05.60,Default,,0,0,0,,О...
Dialogue: 0,0:13:05.60,0:13:08.40,Default,,0,0,0,,Анна, сіз бәріміз үшін құрметсіз!
Dialogue: 0,0:13:08.40,0:13:10.80,Default,,0,0,0,,Мен сені мақтан тұтамын.
Dialogue: 0,0:13:10.80,0:13:12.81,Default,,0,0,0,,Рахмет, Линд ханым!
Dialogue: 0,0:13:12.81,0:13:15.94,Default,,0,0,0,,Жарайсың Анна.
Dialogue: 0,0:13:15.94,0:13:20.25,Default,,0,0,0,,Иә. Бірақ мен бірінші орынға шығамын деп ойламадым...
Dialogue: 0,0:13:20.25,0:13:22.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:22.55,0:13:24.48,Default,,0,0,0,,Матай! Хехе!
Dialogue: 0,0:13:24.48,0:13:27.42,Default,,0,0,0,,Мен жасадым! Мен бірінші орынға қабылдандым!
Dialogue: 0,0:13:27.42,0:13:30.92,Default,,0,0,0,,Көрдіңіз бе? Дәл мен айтқандай.
Dialogue: 0,0:13:30.92,0:13:33.53,Default,,0,0,0,,Иә. Мэтью дұрыс айтты!
Dialogue: 0,0:13:37.13,0:13:42.17,Default,,0,0,0,,♬～
Dialogue: 0,0:13:42.17,0:13:44.14,Default,,0,0,0,,Концерт?
Dialogue: 0,0:13:44.14,0:13:46.94,Default,,0,0,0,,Ақ құм қонақүйінен шақыру!
Dialogue: 0,0:13:46.94,0:13:49.74,Default,,0,0,0,,Ол менің өлең оқуға қатысуымды қалады.
Dialogue: 0,0:13:49.74,0:13:53.28,Default,,0,0,0,,Керемет! Мен ешқашан концертке қатыса аламын деп ойламаппын!
Dialogue: 0,0:13:53.28,0:13:57.62,Default,,0,0,0,,Егер бұл Энн болса, онда еңсеру болатынына күмән жоқ. Иә.
Dialogue: 0,0:13:57.62,0:14:02.09,Default,,0,0,0,,Түнде қамқоршысы жоқ, жастары көп қонақүй...➡
Dialogue: 0,0:14:02.09,0:14:04.39,Default,,0,0,0,,Маған әсер еткен жоқ.
Dialogue: 0,0:14:04.39,0:14:07.29,Default,,0,0,0,,Сәлем Марилла, жарай ма?
Dialogue: 0,0:14:07.29,0:14:11.13,Default,,0,0,0,,Уф... Мен көмектесе алмаймын.
Dialogue: 0,0:14:11.13,0:14:13.63,Default,,0,0,0,,Жоқ, Энн, қозғалма!
Dialogue: 0,0:14:13.63,0:14:16.54,Default,,0,0,0,,Сондай-ақ, маңдайыңызға бұйраларды салмаңыз!
Dialogue: 0,0:14:16.54,0:14:20.04,Default,,0,0,0,,Шашыңызды екіге бөліп, өріп, ортасынан түйіңіз.
Dialogue: 0,0:14:20.04,0:14:23.08,Default,,0,0,0,,Мына інжу алқаны тағуға болады ма?
Dialogue: 0,0:14:23.08,0:14:25.85,Default,,0,0,0,,Оны мен үшін Мэтью сатып алды...
Dialogue: 0,0:14:25.85,0:14:29.72,Default,,0,0,0,,Жарайды. Бірақ көйлек үшін органды - жалғыз таңдау.
Dialogue: 0,0:14:29.72,0:14:31.65,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:14:31.65,0:14:35.25,Default,,0,0,0,,О, маған бұл бөлме қатты ұнайды.
Dialogue: 0,0:14:35.25,0:14:38.93,Default,,0,0,0,,Бірақ келесі айда сіз енді бұл жерде болмайсыз.
Dialogue: 0,0:14:38.93,0:14:41.59,Default,,0,0,0,,Біз бұл туралы бүгін кешке сөйлеспейміз.
Dialogue: 0,0:14:41.59,0:14:44.60,Default,,0,0,0,,Мен бұл туралы бүгін кешке ғана ойламаймын➡
Dialogue: 0,0:14:44.60,0:14:47.93,Default,,0,0,0,,Мен жай ғана Эннмен көңіл көтергім келеді.
Dialogue: 0,0:14:47.93,0:14:50.84,Default,,0,0,0,,Сонымен не болды? Білгіңіз келе ме?
Dialogue: 0,0:14:50.84,0:14:53.07,Default,,0,0,0,,Міне...
Dialogue: 0,0:14:53.07,0:14:59.18,Default,,0,0,0,,♬～
Dialogue: 0,0:14:59.18,0:15:01.45,Default,,0,0,0,,Ха...!
Dialogue: 0,0:15:01.45,0:15:07.65,Default,,0,0,0,,♬～
Dialogue: 0,0:15:09.26,0:15:13.59,Default,,0,0,0,,Жүрегімдегі дауыс: Не істеуім керек... Орынсыз болуым мүмкін...
Dialogue: 0,0:15:13.59,0:15:15.53,Default,,0,0,0,,Эх!
Dialogue: 0,0:15:15.53,0:15:17.53,Default,,0,0,0,,Иә? Хмм.
Dialogue: 0,0:15:20.50,0:15:23.30,Default,,0,0,0,,Сенің иісің ауылдың баласы сияқты.
Dialogue: 0,0:15:23.30,0:15:25.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:25.34,0:15:28.61,Default,,0,0,0,,Бағдарламада ел әзілкештерінің өлеңдерін жатқа оқуы тамаша болды.
Dialogue: 0,0:15:28.61,0:15:30.54,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:15:30.54,0:15:35.48,Default,,0,0,0,,Біз қазірден бастап «Ақ құм» қонақүйінде концерт өткіземіз.
Dialogue: 0,0:15:35.48,0:15:37.82,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:37.82,0:15:41.15,Default,,0,0,0,,Жүрегімде дауыс... Не істеуім керек... Психологиялық тұрғыдан дайын емеспін... ➡
Dialogue: 0,0:15:41.15,0:15:43.46,Default,,0,0,0,,Маған да солай ұнады... ➡
Dialogue: 0,0:15:43.46,0:15:47.93,Default,,0,0,0,,Ах... Мен Грин Гейблске қайта барғым келеді...
Dialogue: 0,0:15:47.93,0:15:53.63,Default,,0,0,0,,♬～
Dialogue: 0,0:15:53.63,0:15:59.51,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:59.51,0:16:04.01,Default,,0,0,0,,Қараңызшы, мистер Эванс! Мен жатқа айтудың маманымын.
Dialogue: 0,0:16:09.88,0:16:13.75,Default,,0,0,0,,«Бүгін ашқан гүлдер ертең солып қалады➡
Dialogue: 0,0:16:13.75,0:16:18.59,Default,,0,0,0,,Сол қалпында қалғым келгеннің бәрі жүрегімді шатастырып, ұшып кетеді➡
Dialogue: 0,0:16:18.59,0:16:22.56,Default,,0,0,0,,Бұл дүниенің қуанышы неде? Түнді жарып жіберетін күн күркіреуі ме?
Dialogue: 0,0:16:22.56,0:16:24.70,Default,,0,0,0,,Бірақ жылтырлығы өткінші➡
Dialogue: 0,0:16:24.70,0:16:28.37,Default,,0,0,0,,Ізгілік те, махаббат та...» Жүрегімнің үні: Бұндай біреудің қасында айту мүмкін емес! ➡
Dialogue: 0,0:16:28.37,0:16:32.10,Default,,0,0,0,,Мен дәл қазір Green Gables-ке қайта оралғым келеді!
Dialogue: 0,0:16:32.10,0:16:37.54,Default,,0,0,0,,«Түннің алдында көз өзгергенде, күндіз рахаттанғанда»➡
Dialogue: 0,0:16:37.54,0:16:39.61,Default,,0,0,0,,Сіз армандайсыз➡
Dialogue: 0,0:16:39.61,0:16:44.32,Default,,0,0,0,,Ұйқыдан оянып, жыла».
Dialogue: 0,0:16:44.32,0:16:47.52,Default,,0,0,0,,О...! (қол шапалақтау)
Dialogue: 0,0:16:47.52,0:16:49.46,Default,,0,0,0,,Уау...! (қол шапалақтау)
Dialogue: 0,0:16:49.46,0:16:53.33,Default,,0,0,0,,Содан кейін Энн Ширли «Қыздың антын» оқыды.
Dialogue: 0,0:16:53.33,0:16:55.43,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:16:58.23,0:17:01.53,Default,,0,0,0,,Жүрек үні, осындай тамаша оқудан кейін➡
Dialogue: 0,0:17:01.53,0:17:03.54,Default,,0,0,0,,Сіз ештеңе істей алмайсыз... (жүрек соғу дыбысы)
Dialogue: 0,0:17:06.71,0:17:12.01,Default,,0,0,0,,Жүрегімдегі дауыс Мәңгілік күлуге қарсы емеспін... Мүмкін қашу керек шығар... ➡
Dialogue: 0,0:17:12.01,0:17:15.05,Default,,0,0,0,,Джози Пай! Гилберт! ➡
Dialogue: 0,0:17:15.05,0:17:18.48,Default,,0,0,0,,Сіз алмайсыз... Қашып кетуге мүмкіндік жоқ! ➡
Dialogue: 0,0:17:18.48,0:17:20.42,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:17:20.42,0:17:25.26,Default,,0,0,0,,Ха… «Мен оны қалай болса да сақтаймын деп ант бердім➡
Dialogue: 0,0:17:25.26,0:17:27.99,Default,,0,0,0,,Өмір бойы үйленбе➡
Dialogue: 0,0:17:27.99,0:17:34.77,Default,,0,0,0,,Мен жақсы көретін жалғыз адам мені ешқашан ойламайды».
Dialogue: 0,0:17:34.77,0:17:37.67,Default,,0,0,0,,Уау...! ``Енді мен алыс жаққа кетіп бара жатырмын➡
Dialogue: 0,0:17:37.67,0:17:40.67,Default,,0,0,0,,Біз енді ешқашан кездеспейміз! ➡
Dialogue: 0,0:17:40.67,0:17:44.34,Default,,0,0,0,,Сонда да қайта-қайта есімде➡
Dialogue: 0,0:17:44.34,0:17:47.85,Default,,0,0,0,,Мені ешқашан ойламайтын адам! ➡
Dialogue: 0,0:17:47.85,0:17:50.55,Default,,0,0,0,,Артымнан келмеңізші➡
Dialogue: 0,0:17:50.55,0:17:57.86,Default,,0,0,0,,Мен сүйген адам теңіздің қойнауында ұйықтап жатыр...».
Dialogue: 0,0:18:01.09,0:18:03.03,Default,,0,0,0,,Уау...!
Dialogue: 0,0:18:03.03,0:18:04.96,Default,,0,0,0,,Аха! (қол шапалақтау)
Dialogue: 0,0:18:04.96,0:18:12.10,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:12.10,0:18:15.37,Default,,0,0,0,,Мен саған сұрақ қойғым келеді... (Джейн Диана) Иә?
Dialogue: 0,0:18:15.37,0:18:17.81,Default,,0,0,0,,Ах…. (қол шапалақтау)
Dialogue: 0,0:18:17.81,0:18:22.35,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:22.35,0:18:27.09,Default,,0,0,0,,Сіз өте керемет болдыңыз. Бірақ бәрі қоңырау шалып жатыр.
Dialogue: 0,0:18:27.09,0:18:31.99,Default,,0,0,0,,Мен бара алмаймын... Иә? Мен ешқашан мұндай құрметке ие болған емеспін.
Dialogue: 0,0:18:31.99,0:18:35.23,Default,,0,0,0,,Бірақ мен... га.
Dialogue: 0,0:18:35.23,0:18:39.10,Default,,0,0,0,,Реминисценция Егер бұл Энн болса, онда еңсеру болатынына күмән жоқ.
Dialogue: 0,0:18:39.10,0:18:43.50,Default,,0,0,0,,Мен бәрібір баруым керек. Мэтьюдің көңілі қалды.
Dialogue: 0,0:18:43.50,0:18:47.14,Default,,0,0,0,,Иә. Сондай-ақ Мэтью есімді адамға арналған.
Dialogue: 0,0:18:47.14,0:18:49.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:49.74,0:18:53.15,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:53.15,0:18:56.18,Default,,0,0,0,,«Бақаларға жылы қарым-қатынас жаса.➡
Dialogue: 0,0:18:56.18,0:18:59.89,Default,,0,0,0,,Басқалардың атын атама және жамандама. ➡
Dialogue: 0,0:18:59.89,0:19:02.62,Default,,0,0,0,,...
Dialogue: 0,0:19:02.62,0:19:04.62,Default,,0,0,0,,Иә! Зузузузу~. ➡
Dialogue: 0,0:19:04.62,0:19:06.86,Default,,0,0,0,,Бечабеча Отафуку Джоджожо➡
Dialogue: 0,0:19:06.86,0:19:08.86,Default,,0,0,0,,...
Dialogue: 0,0:19:08.86,0:19:12.33,Default,,0,0,0,,Ахахха! ``Сонымен қатар бақалар өте сезімтал.➡
Dialogue: 0,0:19:12.33,0:19:17.54,Default,,0,0,0,,Пикки Дьяко Гя Бизубики Гачага Чагеро! ».
Dialogue: 0,0:19:19.97,0:19:23.31,Default,,0,0,0,,Сіз шынымен керемет болдыңыз. ➡
Dialogue: 0,0:19:23.31,0:19:27.55,Default,,0,0,0,,Бала сияқты жыладым.
Dialogue: 0,0:19:27.55,0:19:29.48,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:19:29.48,0:19:32.28,Default,,0,0,0,,Керемет өлеңдеріңізді тыңдауға мүмкіндік бергеніңіз үшін рахмет➡
Dialogue: 0,0:19:32.28,0:19:34.69,Default,,0,0,0,,Мынаны саған сыйлыққа берейін.
Dialogue: 0,0:19:34.69,0:19:37.02,Default,,0,0,0,,Ал... Менде бұл мүмкін емес!
Dialogue: 0,0:19:37.02,0:19:39.69,Default,,0,0,0,,Энн Ширли. а…. (Қызғылт ханым) Иә?
Dialogue: 0,0:19:39.69,0:19:41.63,Default,,0,0,0,,Миссис Эванс...
Dialogue: 0,0:19:41.63,0:19:44.53,Default,,0,0,0,,Поэзияны терең түсінгеніңіз, әдемі дауысыңыз➡
Dialogue: 0,0:19:44.53,0:19:46.57,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:19:46.57,0:19:50.70,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:19:50.70,0:19:53.61,Default,,0,0,0,,Иә? иә….
Dialogue: 0,0:19:53.61,0:19:56.14,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:19:56.14,0:19:59.04,Default,,0,0,0,,Бұндай керемет ештеңе болмаған! ➡
Dialogue: 0,0:19:59.04,0:20:02.25,Default,,0,0,0,,Аннаның оқуы үлкен мәселе болды! ➡
Dialogue: 0,0:20:02.25,0:20:05.48,Default,,0,0,0,,Миссис Эвансқа қарағанда әлдеқайда жақсы.
Dialogue: 0,0:20:05.48,0:20:08.52,Default,,0,0,0,,Джейн Олай айтпа.
Dialogue: 0,0:20:08.52,0:20:10.66,Default,,0,0,0,,Ол адам сарапшы➡
Dialogue: 0,0:20:10.66,0:20:15.16,Default,,0,0,0,,Мен аздап жатқа айтатын оқушымын.
Dialogue: 0,0:20:15.16,0:20:20.33,Default,,0,0,0,,Бірақ менің оқуым сәл болса да барлығына ұнаса➡
Dialogue: 0,0:20:20.33,0:20:22.27,Default,,0,0,0,,Мен бұған қанағаттандым.
Dialogue: 0,0:20:22.27,0:20:24.87,Default,,0,0,0,,Біреу Аннаға құрмет көрсетті.
Dialogue: 0,0:20:24.87,0:20:28.81,Default,,0,0,0,,Артымыздағы орындықта отырған американдық...
Dialogue: 0,0:20:28.81,0:20:33.98,Default,,0,0,0,,Еске алу Тицианның керемет шашы бар қыз кім?
Dialogue: 0,0:20:33.98,0:20:37.65,Default,,0,0,0,,Ол кісі атақты суретші.
Dialogue: 0,0:20:37.65,0:20:42.09,Default,,0,0,0,,Бірақ «Тициан» дегеніміз не? Мен сенен ертерек сұрауым керек еді.
Dialogue: 0,0:20:42.09,0:20:44.99,Default,,0,0,0,,Менің ойымша, бұл қызыл шаш туралы.
Dialogue: 0,0:20:44.99,0:20:47.66,Default,,0,0,0,,Сол суретші кешкі ас кезінде➡
Dialogue: 0,0:20:47.66,0:20:49.90,Default,,0,0,0,,Себебі мен көптеген эскиздерді салатынмын➡
Dialogue: 0,0:20:49.90,0:20:53.77,Default,,0,0,0,,Менде біреуі бар.
Dialogue: 0,0:20:53.77,0:20:57.64,Default,,0,0,0,,Мен онша әдемі емеспін.
Dialogue: 0,0:20:57.64,0:20:59.67,Default,,0,0,0,,О, дәл солай.
Dialogue: 0,0:20:59.67,0:21:04.81,Default,,0,0,0,,Себебі Энн өте әдемі.
Dialogue: 0,0:21:04.81,0:21:09.15,Default,,0,0,0,,Эй, сен ханымдар киген әшекейлерді көрдің бе?
Dialogue: 0,0:21:09.15,0:21:14.39,Default,,0,0,0,,Осылай бай болғың келмей ме?
Dialogue: 0,0:21:14.39,0:21:17.26,Default,,0,0,0,,Біз қазірдің өзінде бай болдық.
Dialogue: 0,0:21:17.26,0:21:19.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:19.29,0:21:21.43,Default,,0,0,0,,Өйткені мен 15 жыл өмір сүрдім➡
Dialogue: 0,0:21:21.43,0:21:23.83,Default,,0,0,0,,Қиялға ие болыңыз➡
Dialogue: 0,0:21:23.83,0:21:26.73,Default,,0,0,0,,Сіз бұл көріністен ләззат алуды білесіз.
Dialogue: 0,0:21:26.73,0:21:29.27,Default,,0,0,0,,Мына теңізге қара.
Dialogue: 0,0:21:29.27,0:21:33.87,Default,,0,0,0,,Барлық күміс пен көлеңке. Және тек иллюзиялар.
Dialogue: 0,0:21:35.94,0:21:39.18,Default,,0,0,0,,Мен басқа ешкім болғым келмейді.
Dialogue: 0,0:21:39.18,0:21:43.05,Default,,0,0,0,,Өмір бойы қымбат әшекейлерге ие бола алмасаңыз да➡
Dialogue: 0,0:21:43.05,0:21:48.42,Default,,0,0,0,,Мен інжу алқасы бар Жасыл Гейблстің Энніне риза боламын.
Dialogue: 0,0:21:48.42,0:21:52.59,Default,,0,0,0,,Маған сай көйлекті таңдайсыз➡
Dialogue: 0,0:21:52.59,0:21:55.46,Default,,0,0,0,,Менің сүйкімді күлімсіреген сырласым бар➡
Dialogue: 0,0:21:55.46,0:21:58.16,Default,,0,0,0,,Қызыл шашты Энн Ширли➡
Dialogue: 0,0:21:58.16,0:22:00.27,Default,,0,0,0,,Мен өте ризамын.
Dialogue: 0,0:22:05.07,0:22:14.38,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.38,0:22:17.25,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.25,0:22:24.39,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.39,0:22:29.06,Default,,0,0,0,,♬ «Білмей тұрып өтетін қала»
Dialogue: 0,0:22:29.06,0:22:34.27,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.27,0:22:39.10,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.10,0:22:44.04,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.04,0:22:51.15,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.15,0:22:55.15,Default,,0,0,0,,♬ «Мен оны тауып алып, сонда бара аламын».
Dialogue: 0,0:22:55.15,0:23:00.29,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.29,0:23:05.46,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:05.46,0:23:10.04,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.04,0:23:15.01,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.01,0:23:23.68,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:23.68,0:23:28.92,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:28.92,0:23:33.33,Default,,0,0,0,,♬～
Dialogue: 0,0:23:34.83,0:23:56.52,Default,,0,0,0,,♬～
