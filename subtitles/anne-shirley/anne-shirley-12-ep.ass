Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:04.13,Default,,0,0,0,,<Avonlea мектебінде мұғалім болу➡
Dialogue: 0,0:00:04.13,0:00:06.57,Default,,0,0,0,,Бір ай өтті. ➡
Dialogue: 0,0:00:06.57,0:00:08.50,Default,,0,0,0,,Күн сайын оқушыларымның алдында тұрамын➡
Dialogue: 0,0:00:08.50,0:00:11.81,Default,,0,0,0,,Ясаки бірте-бірте үйреніп бара жатқандай сезінді➡
Dialogue: 0,0:00:11.81,0:00:16.51,Default,,0,0,0,,Өмірді кенеттен күйзелтетін таңқаларлық өзгерістер...＞
Dialogue: 0,0:00:18.31,0:00:23.15,Default,,0,0,0,,Иә? Марилла туысының жерлеу рәсімінен оралды.
Dialogue: 0,0:00:23.15,0:00:25.72,Default,,0,0,0,,Өсек егіздері де бірге.
Dialogue: 0,0:00:25.72,0:00:28.69,Default,,0,0,0,,Кішкентай болса да оны аяймын.
Dialogue: 0,0:00:31.06,0:00:35.83,Default,,0,0,0,,Иә, мен әкемнен ерте айырылдым, енді анамын. ➡
Dialogue: 0,0:00:35.83,0:00:37.77,Default,,0,0,0,,О? ➡
Dialogue: 0,0:00:37.77,0:00:39.84,Default,,0,0,0,,Бала аттың құйрығынан ұстамақ болды➡
Dialogue: 0,0:00:39.84,0:00:42.60,Default,,0,0,0,,Марилла оны ұстап тұр.
Dialogue: 0,0:00:42.60,0:00:45.51,Default,,0,0,0,,Бұл қиын. Қыздарға➡
Dialogue: 0,0:00:45.51,0:00:47.98,Default,,0,0,0,,Өте тыныш. ➡
Dialogue: 0,0:00:47.98,0:00:53.15,Default,,0,0,0,,Энн бақытты болады. Өйткені мен балаларды жақсы көремін.
Dialogue: 0,0:00:53.15,0:00:58.12,Default,,0,0,0,,Мэтью Эннді осында әкелгені кеше ғана сияқты.
Dialogue: 0,0:00:58.12,0:01:01.76,Default,,0,0,0,,Марилланың бала тәрбиелеп жатқанына күлдім➡
Dialogue: 0,0:01:01.76,0:01:04.26,Default,,0,0,0,,Енді олар егіз.
Dialogue: 0,0:01:04.26,0:01:09.13,Default,,0,0,0,,Өмірде не болатынын білмейсің.
Dialogue: 0,0:01:09.13,0:01:18.37,Default,,0,0,0,,♬～
Dialogue: 0,0:01:18.37,0:01:23.05,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:01:23.05,0:01:25.41,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:01:25.41,0:01:27.35,Default,,0,0,0,,♬ «Қалағаныңды жаза аласың».
Dialogue: 0,0:01:27.35,0:01:31.35,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:01:31.35,0:01:33.72,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:01:33.72,0:01:35.96,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:01:35.96,0:01:40.50,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:01:40.50,0:01:45.70,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:01:45.70,0:01:47.64,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:01:47.64,0:01:51.51,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:01:51.51,0:01:54.91,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:01:54.91,0:01:57.35,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:01:57.35,0:01:59.62,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:01:59.62,0:02:03.79,Default,,0,0,0,,♬ «Юме ұялшақ, жасырынбақшы».
Dialogue: 0,0:02:03.79,0:02:06.25,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:06.25,0:02:08.59,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:08.59,0:02:12.06,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:12.06,0:02:15.36,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:15.36,0:02:17.60,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:17.60,0:02:21.87,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны».
Dialogue: 0,0:02:21.87,0:02:24.37,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:02:24.37,0:02:26.68,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:02:26.68,0:02:28.68,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:02:28.68,0:02:33.05,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:02:33.05,0:02:36.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:39.69,0:02:44.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:44.29,0:02:46.23,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:02:46.23,0:02:49.20,Default,,0,0,0,,Green Gables ойынына қош келдіңіз.
Dialogue: 0,0:02:49.20,0:02:52.13,Default,,0,0,0,,Сіз Дорасыз.
Dialogue: 0,0:02:52.13,0:02:54.34,Default,,0,0,0,,Ал сен...
Dialogue: 0,0:02:54.34,0:02:57.27,Default,,0,0,0,,Мен Дэви Кит мырзамын.
Dialogue: 0,0:02:57.27,0:02:59.64,Default,,0,0,0,,Сіз энергияға толысыз.
Dialogue: 0,0:02:59.64,0:03:06.85,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:03:06.85,0:03:10.29,Default,,0,0,0,,Дэйви жақсырақ тамақтаныңыз.
Dialogue: 0,0:03:10.29,0:03:13.59,Default,,0,0,0,,Құшақта! Себебі менің қарным қатты ашты➡
Dialogue: 0,0:03:13.59,0:03:15.86,Default,,0,0,0,,Менің өзімді ұстауға уақытым жоқ. ➡
Dialogue: 0,0:03:15.86,0:03:18.46,Default,,0,0,0,,Мм! Бұл кәмпит өте дәмді!
Dialogue: 0,0:03:18.46,0:03:21.93,Default,,0,0,0,,Маған тағы біреуін беріңіз. міне, ұстаңыз.
Dialogue: 0,0:03:21.93,0:03:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.30,0:03:27.57,Default,,0,0,0,,Бұл орын алғанда, «рахмет» деп айт!
Dialogue: 0,0:03:27.57,0:03:30.07,Default,,0,0,0,,Маған берсеңіздер айтамын.
Dialogue: 0,0:03:30.07,0:03:33.38,Default,,0,0,0,,Жақсы! Сіз жеп қойғансыз!
Dialogue: 0,0:03:35.04,0:03:37.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:37.25,0:03:40.12,Default,,0,0,0,,Ах! Дэви!
Dialogue: 0,0:03:40.12,0:03:42.48,Default,,0,0,0,,Рахмет, апа...
Dialogue: 0,0:03:42.48,0:03:45.39,Default,,0,0,0,,Дэви?
Dialogue: 0,0:03:45.39,0:03:48.29,Default,,0,0,0,,Мырзалар ондай әрекеттерге бармайды.
Dialogue: 0,0:03:48.29,0:03:50.23,Default,,0,0,0,,Мен білемін. Ах.
Dialogue: 0,0:03:50.23,0:03:52.99,Default,,0,0,0,,Бірақ мен джентльмен емеспін.
Dialogue: 0,0:03:52.99,0:03:55.73,Default,,0,0,0,,Демек, сіз джентльмен болғыңыз келмейді, солай ма?
Dialogue: 0,0:03:55.73,0:03:58.00,Default,,0,0,0,,Әрине, болғым келеді.
Dialogue: 0,0:03:58.00,0:04:01.54,Default,,0,0,0,,Бірақ сіз ересек болмайынша джентльмен бола алмайсыз.
Dialogue: 0,0:04:01.54,0:04:03.47,Default,,0,0,0,,Жоқ. Мен бір бола аламын.
Dialogue: 0,0:04:03.47,0:04:06.01,Default,,0,0,0,,Кішкентай бала да джентльмен бола алады.
Dialogue: 0,0:04:06.01,0:04:09.34,Default,,0,0,0,,Бірақ джентльмен ешқашан қыздың затын алмайды➡
Dialogue: 0,0:04:09.34,0:04:11.95,Default,,0,0,0,,Мен сенің шашыңды тартпаймын.
Dialogue: 0,0:04:11.95,0:04:13.88,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:04:13.88,0:04:17.25,Default,,0,0,0,,Анн. Содан кейін «рахмет» деп айтыңыз➡
Dialogue: 0,0:04:17.25,0:04:19.35,Default,,0,0,0,,Мен тіпті ұмытып кетуім мүмкін.
Dialogue: 0,0:04:21.46,0:04:23.79,Default,,0,0,0,,Хехе.
Dialogue: 0,0:04:23.79,0:04:29.30,Default,,0,0,0,,Хмм, мырзалар онша қызық емес сияқты.
Dialogue: 0,0:04:31.57,0:04:34.04,Default,,0,0,0,,Күткендей, мен джентльмен боламын➡
Dialogue: 0,0:04:34.04,0:04:36.61,Default,,0,0,0,,Мен өскен соң жасаймын.
Dialogue: 0,0:04:36.61,0:04:39.51,Default,,0,0,0,,Бүгін ерте жатқан дұрыс.
Dialogue: 0,0:04:39.51,0:04:44.18,Default,,0,0,0,,Дора менімен, Дэви, сен жалғыз қалудан қорықпайсың, солай ма?
Dialogue: 0,0:04:44.18,0:04:46.11,Default,,0,0,0,,Қорықпа!
Dialogue: 0,0:04:46.11,0:04:48.38,Default,,0,0,0,,Бірақ мен әлі ояумын!
Dialogue: 0,0:04:48.38,0:04:51.25,Default,,0,0,0,,Жоқ, мен ұйықтаймын! неге?
Dialogue: 0,0:04:51.25,0:04:53.26,Default,,0,0,0,,Неліктен мен қазір ұйықтауым керек?
Dialogue: 0,0:04:53.26,0:04:58.16,Default,,0,0,0,,Бәрі де болады! (Дэви) Неге! ➡
Dialogue: 0,0:04:58.16,0:05:00.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:00.36,0:05:04.23,Default,,0,0,0,,Әже оны кеше ғана жуды!
Dialogue: 0,0:05:04.23,0:05:07.24,Default,,0,0,0,,Неліктен оны таза ұстау жақсы?
Dialogue: 0,0:05:07.24,0:05:09.47,Default,,0,0,0,,Мен бүгін шіркеуге барамын.
Dialogue: 0,0:05:09.47,0:05:13.01,Default,,0,0,0,,Біреумен алғаш кездескен кезде бетіңіз кір болса, ұят емес пе?
Dialogue: 0,0:05:13.01,0:05:16.58,Default,,0,0,0,,Жарайды! Мен кірлегенді жөн көремін➡
Dialogue: 0,0:05:16.58,0:05:18.65,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:05:18.65,0:05:20.78,Default,,0,0,0,,Пол Ирвинг ➡
Dialogue: 0,0:05:20.78,0:05:23.22,Default,,0,0,0,,Мен күнде өз бетімді жуамын.
Dialogue: 0,0:05:23.22,0:05:25.45,Default,,0,0,0,,Павел? Бұл кім?
Dialogue: 0,0:05:25.45,0:05:29.76,Default,,0,0,0,,Менің сыныбымдағы оқушы. Ол ересек емес, бірақ ол жақсы джентльмен.
Dialogue: 0,0:05:29.76,0:05:32.66,Default,,0,0,0,,...Анн-чанға бұл ұнай ма?
Dialogue: 0,0:05:32.66,0:05:35.26,Default,,0,0,0,,Иә, маған ұнайды.
Dialogue: 0,0:05:35.26,0:05:38.80,Default,,0,0,0,,⚟Шығатын уақыт та қалды.
Dialogue: 0,0:05:38.80,0:05:40.80,Default,,0,0,0,,Ммм!
Dialogue: 0,0:05:40.80,0:05:42.90,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:05:47.14,0:05:49.11,Default,,0,0,0,,Уа, Пауыл!
Dialogue: 0,0:05:49.11,0:05:52.81,Default,,0,0,0,,Иә? Мұғалім Анна! Ахаха.
Dialogue: 0,0:05:54.88,0:05:57.79,Default,,0,0,0,,Қайырлы таң, Марилла ана.
Dialogue: 0,0:05:57.79,0:05:59.72,Default,,0,0,0,,Қайырлы таң Пол.
Dialogue: 0,0:05:59.72,0:06:03.16,Default,,0,0,0,,Дэви мен Дора менің жаңа отбасым.
Dialogue: 0,0:06:03.16,0:06:05.09,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:06:05.09,0:06:07.73,Default,,0,0,0,,Танысқаныма қуаныштымын, Дора. Танысқаныма қуаныштымын➡
Dialogue: 0,0:06:07.73,0:06:11.70,Default,,0,0,0,,De… Ibi…. Уау!
Dialogue: 0,0:06:11.70,0:06:17.54,Default,,0,0,0,,«Әділдік пен әділдікті Құдайдың атымен бағалаймыз.➡
Dialogue: 0,0:06:17.54,0:06:22.31,Default,,0,0,0,,Дегенмен, адамның дұрыстығында әрқашан да шектеу болады. ➡
Dialogue: 0,0:06:22.31,0:06:28.78,Default,,0,0,0,,Мысалы, егер сіз өз әділдігіңізді басқаларға тым көп мәжбүрлесеңіз➡
Dialogue: 0,0:06:28.78,0:06:32.72,Default,,0,0,0,,Олардың арасында айырмашылық бар екені белгілі болады➡
Dialogue: 0,0:06:32.72,0:06:36.06,Default,,0,0,0,,Жанжал тудыруы мүмкін. ➡
Dialogue: 0,0:06:36.06,0:06:40.80,Default,,0,0,0,,Бұрышқа бұру Сізге тіпті оны кесуге тура келуі мүмкін. ➡
Dialogue: 0,0:06:40.80,0:06:43.16,Default,,0,0,0,,Дұрыс айтқан кезде➡
Dialogue: 0,0:06:43.16,0:06:45.47,Default,,0,0,0,,Біреуді ренжіту мүмкіндігі бар...».
Dialogue: 0,0:06:45.47,0:06:47.40,Default,,0,0,0,,Уф...! (ызылдаған)
Dialogue: 0,0:06:47.40,0:06:49.47,Default,,0,0,0,,Кя! (Пастор Алан) А...
Dialogue: 0,0:06:49.47,0:06:52.61,Default,,0,0,0,,Анашым! Алыңыз! Тез алыңыз! ➡
Dialogue: 0,0:06:52.61,0:06:54.58,Default,,0,0,0,,Жәндіктер! жәндік! Жәндіктер!
Dialogue: 0,0:06:54.58,0:06:58.08,Default,,0,0,0,,Ах…. Төмен! Мен түстім!
Dialogue: 0,0:06:58.08,0:07:00.08,Default,,0,0,0,,Кихихи!
Dialogue: 0,0:07:00.08,0:07:03.29,Default,,0,0,0,,Бүгін өз бөлмеңде бол!
Dialogue: 0,0:07:05.82,0:07:07.82,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:07:09.66,0:07:12.13,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:07:12.13,0:07:15.13,Default,,0,0,0,,Ах. ➡
Dialogue: 0,0:07:15.13,0:07:17.63,Default,,0,0,0,,Хэхехехе.
Dialogue: 0,0:07:21.57,0:07:24.01,Default,,0,0,0,,Пуха~! ➡
Dialogue: 0,0:07:24.01,0:07:26.04,Default,,0,0,0,,Егер Пол Ирвинг...
Dialogue: 0,0:07:26.04,0:07:30.78,Default,,0,0,0,,Сіз шіркеуде қыздың мойнына құрт түсірмес едіңіз.
Dialogue: 0,0:07:30.78,0:07:33.05,Default,,0,0,0,,Иә, жоқ.
Dialogue: 0,0:07:33.05,0:07:36.45,Default,,0,0,0,,Сонда...Мен де олай етпеуім керек еді.
Dialogue: 0,0:07:36.45,0:07:39.09,Default,,0,0,0,,Хехе. (Дэви) Бірақ...➡
Dialogue: 0,0:07:39.09,0:07:42.86,Default,,0,0,0,,Бұл өте үлкен және тамаша құрт болды.
Dialogue: 0,0:07:42.86,0:07:46.26,Default,,0,0,0,,Бұлай ысырап ету ұят болды.
Dialogue: 0,0:07:46.26,0:07:49.96,Default,,0,0,0,,Әлгі баланың ва-ва-ва дегені күлкілі емес пе? ➡
Dialogue: 0,0:07:49.96,0:07:53.67,Default,,0,0,0,,Аха! Хахахаха! Ахахха!
Dialogue: 0,0:07:56.37,0:07:58.31,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:07:58.31,0:08:01.21,Default,,0,0,0,,Бүгін біз қоғамдық залды жөндеуді жалғастырамыз➡
Dialogue: 0,0:08:01.21,0:08:04.45,Default,,0,0,0,,Мен нақты жоспар бойынша шешім қабылдауды ойлап жүрмін.
Dialogue: 0,0:08:04.45,0:08:06.51,Default,,0,0,0,,Садақа көлемін ескере отырып➡
Dialogue: 0,0:08:06.51,0:08:09.99,Default,,0,0,0,,Қабырғаларды сырлап, шатырды ауыстыратын сияқтымыз.
Dialogue: 0,0:08:09.99,0:08:12.22,Default,,0,0,0,,Олай болса түсті шешейік.
Dialogue: 0,0:08:12.22,0:08:15.46,Default,,0,0,0,,Әрине, шатырдың қою қызыл болғанын қалаймын.
Dialogue: 0,0:08:15.46,0:08:18.86,Default,,0,0,0,,Иә. Сонымен, қабырғалар туралы не деуге болады?
Dialogue: 0,0:08:18.86,0:08:21.66,Default,,0,0,0,,Әдемі жасыл түс туралы не ойлайсың?
Dialogue: 0,0:08:21.66,0:08:24.57,Default,,0,0,0,,Жақсы. Мен де солай ойладым.
Dialogue: 0,0:08:24.57,0:08:28.94,Default,,0,0,0,,Шынымен бе? О, жасыл түс сөзсіз ерекшеленеді.
Dialogue: 0,0:08:28.94,0:08:32.34,Default,,0,0,0,,Хехе. Менің ойымша, қабырғалар жасыл болуы керек.
Dialogue: 0,0:08:32.34,0:08:35.01,Default,,0,0,0,,көремін. Қайта бояу жұмыстары ➡
Dialogue: 0,0:08:35.01,0:08:37.68,Default,,0,0,0,,Мен Роджер Пайдан сұрауым керек деп ойлаймын.
Dialogue: 0,0:08:37.68,0:08:40.65,Default,,0,0,0,,Өйткені ең көп қайырымдылықты Пай отбасы жасады.
Dialogue: 0,0:08:40.65,0:08:44.35,Default,,0,0,0,,Шай ішуге ше? Мен оны аламын
Dialogue: 0,0:08:44.35,0:08:48.02,Default,,0,0,0,,Ал, келесі жолы, мен сені бір аптадан кейін көремін.
Dialogue: 0,0:08:48.02,0:08:50.93,Default,,0,0,0,,Хехе. ...Ой? иә? Дора ше?
Dialogue: 0,0:08:50.93,0:08:52.86,Default,,0,0,0,,Иә? Аа, егер бұл Дора болса➡
Dialogue: 0,0:08:52.86,0:08:55.60,Default,,0,0,0,,Мен жаңа ғана Дэвимен бірге аулаға бардым.
Dialogue: 0,0:08:55.60,0:08:57.60,Default,,0,0,0,,А...?
Dialogue: 0,0:09:01.20,0:09:03.81,Default,,0,0,0,,Дора⁉
Dialogue: 0,0:09:07.04,0:09:09.64,Default,,0,0,0,,Не болды? Ол балшыққа толы емес.
Dialogue: 0,0:09:09.64,0:09:11.71,Default,,0,0,0,,(жылау)
Dialogue: 0,0:09:11.71,0:09:15.45,Default,,0,0,0,,Дэви мені қорадағы шошқа қоршауымен жүруді өтінді.
Dialogue: 0,0:09:15.45,0:09:18.72,Default,,0,0,0,,(балшықты басқан дыбыс)
Dialogue: 0,0:09:18.72,0:09:20.99,Default,,0,0,0,,Сіз шынымен жүрдіңіз бе?
Dialogue: 0,0:09:20.99,0:09:23.56,Default,,0,0,0,,Мен жүруге тырыстым, бірақ...
Dialogue: 0,0:09:23.56,0:09:25.66,Default,,0,0,0,,Ол құлады...
Dialogue: 0,0:09:28.26,0:09:30.77,Default,,0,0,0,,Сен әпкеңе қалай солай істей аласың?
Dialogue: 0,0:09:30.77,0:09:33.33,Default,,0,0,0,,Мен қатты қайғырдым.
Dialogue: 0,0:09:33.33,0:09:35.30,Default,,0,0,0,,Дэви!
Dialogue: 0,0:09:35.30,0:09:39.21,Default,,0,0,0,,Мен бірдеңені істеп үлгермейінше, бұл жаман емес деп ойлаймын.
Dialogue: 0,0:09:39.21,0:09:42.14,Default,,0,0,0,,Дора киімінің кірленетінін айтады➡
Dialogue: 0,0:09:42.14,0:09:45.35,Default,,0,0,0,,Менімен балшықтан тұшпара жасамайсың. ➡
Dialogue: 0,0:09:45.35,0:09:49.58,Default,,0,0,0,,Бұл мені әбден ашуландырды.
Dialogue: 0,0:09:49.58,0:09:51.55,Default,,0,0,0,,Еске алу Ах... Ах!
Dialogue: 0,0:09:51.55,0:09:53.79,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:09:53.79,0:09:55.86,Default,,0,0,0,,Пол Ирвинг➡
Dialogue: 0,0:09:55.86,0:09:59.03,Default,,0,0,0,,Мен шошқаның қоршауына құлайтынымды білемін➡
Dialogue: 0,0:09:59.03,0:10:02.00,Default,,0,0,0,,Әпкеңнің жүруіне жол бермейсің.
Dialogue: 0,0:10:02.00,0:10:06.20,Default,,0,0,0,,...Павел мұндайды ешқашан ойламас еді.
Dialogue: 0,0:10:06.20,0:10:09.10,Default,,0,0,0,,О... Дэви?
Dialogue: 0,0:10:09.10,0:10:13.37,Default,,0,0,0,,Энн апа, мен Пол сияқты жақсы қыз болмасам да➡
Dialogue: 0,0:10:13.37,0:10:18.68,Default,,0,0,0,,Сен маған ғашық боласың деп үміттенемін, аз ғана уақыт.
Dialogue: 0,0:10:18.68,0:10:21.12,Default,,0,0,0,,Әрине сен маған ұнайсың.
Dialogue: 0,0:10:21.12,0:10:23.72,Default,,0,0,0,,О... шынымен бе?
Dialogue: 0,0:10:23.72,0:10:25.65,Default,,0,0,0,,Иә. Бірақ➡
Dialogue: 0,0:10:25.65,0:10:29.52,Default,,0,0,0,,Егер сен мұны жасамасаң, мен сені одан да жақсы көретін едім.
Dialogue: 0,0:10:29.52,0:10:31.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:31.46,0:10:34.73,Default,,0,0,0,,Мен бүгін ештеңе істеген жоқпын. ➡
Dialogue: 0,0:10:34.73,0:10:37.43,Default,,0,0,0,,Мен Энн-чанға айтуға қорқамын...
Dialogue: 0,0:10:37.43,0:10:41.30,Default,,0,0,0,,Дэви? Не істедің...?
Dialogue: 0,0:10:41.30,0:10:43.24,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:43.24,0:10:46.14,Default,,0,0,0,,Дэви, сен не істедің?
Dialogue: 0,0:10:46.14,0:10:48.84,Default,,0,0,0,,Апайдың төсегінде бақа бар...
Dialogue: 0,0:10:48.84,0:10:52.65,Default,,0,0,0,,Ә!? Барып алуға болады. Бірақ…➡
Dialogue: 0,0:10:52.65,0:10:56.18,Default,,0,0,0,,Бұл бұрынғыдай қызық емес пе?
Dialogue: 0,0:10:56.18,0:11:06.90,Default,,0,0,0,,♬～
Dialogue: 0,0:11:06.90,0:11:09.10,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:11:11.07,0:11:13.00,Default,,0,0,0,,(айқай)
Dialogue: 0,0:11:13.00,0:11:15.97,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:11:15.97,0:11:19.87,Default,,0,0,0,,Әй, мен бұл қызықтырақ болар деп ойладым.
Dialogue: 0,0:11:21.84,0:11:26.28,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:26.28,0:11:30.69,Default,,0,0,0,,♬～
Dialogue: 0,0:11:33.96,0:11:37.23,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:11:37.23,0:11:41.16,Default,,0,0,0,,Соңғы екі апта өте тыныш болды.
Dialogue: 0,0:11:41.16,0:11:44.97,Default,,0,0,0,,Тіпті Дэви өзін жақсы ұстады.
Dialogue: 0,0:11:44.97,0:11:49.30,Default,,0,0,0,,Мен бүгін орманның тыныштығы қандай деп ойлаймын.
Dialogue: 0,0:11:49.30,0:11:54.54,Default,,0,0,0,,Ағаш басын кесіп өткен самалдан басқа бірде-бір сыбыр естілмеймін.
Dialogue: 0,0:11:54.54,0:11:56.91,Default,,0,0,0,,О, балалар➡
Dialogue: 0,0:11:56.91,0:11:59.65,Default,,0,0,0,,Әдемі ағаштар.
Dialogue: 0,0:11:59.65,0:12:04.02,Default,,0,0,0,,Мен әрқайсыңызды жақсы көремін.
Dialogue: 0,0:12:04.02,0:12:06.59,Default,,0,0,0,,Хмм. Анн. иә?
Dialogue: 0,0:12:06.59,0:12:10.46,Default,,0,0,0,,Сіз ересек адам болып көрінесіз.
Dialogue: 0,0:12:10.46,0:12:15.03,Default,,0,0,0,,Жалғыз қалғанда, сіз бұрынғыдай кішкентай баласыз.
Dialogue: 0,0:12:15.03,0:12:19.03,Default,,0,0,0,,Дұрыс па? Менің бала болғаныма 14 жыл болды➡
Dialogue: 0,0:12:19.03,0:12:22.60,Default,,0,0,0,,Менің ересек болғаныма үш жылдай ғана болды.
Dialogue: 0,0:12:22.60,0:12:25.54,Default,,0,0,0,,Бұл мектептен үйге келе жатқанда орман арқылы өтетін жалғыз жер➡
Dialogue: 0,0:12:25.54,0:12:28.24,Default,,0,0,0,,Бұл менің армандаған жерім.
Dialogue: 0,0:12:28.24,0:12:30.81,Default,,0,0,0,,Бұл жақсы нәрсе емес.
Dialogue: 0,0:12:30.81,0:12:33.72,Default,,0,0,0,,Диана жалғыз қайда барады?
Dialogue: 0,0:12:33.72,0:12:35.65,Default,,0,0,0,,Диксон мырзаның орнында.
Dialogue: 0,0:12:35.65,0:12:38.69,Default,,0,0,0,,Альбертаға жаңа киім киюге көмектесу.
Dialogue: 0,0:12:38.69,0:12:42.72,Default,,0,0,0,,Кешке бітеді, сонда кездеспейміз бе? Бұл жақсы.
Dialogue: 0,0:12:42.72,0:12:44.66,Default,,0,0,0,,Бүгін Фред Райт➡
Dialogue: 0,0:12:44.66,0:12:46.69,Default,,0,0,0,,Сіз қалаға барған жоқсыз, солай ма?
Dialogue: 0,0:12:46.69,0:12:49.56,Default,,0,0,0,,Ах…. Сізге Фредпен бірге болу ұнайды ма?
Dialogue: 0,0:12:49.56,0:12:52.57,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:12:55.74,0:12:59.14,Default,,0,0,0,,Күте тұрыңыз~ Мені сонда қалдырмаңыз. Хехе.
Dialogue: 0,0:12:59.14,0:13:01.14,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:13:02.91,0:13:04.85,Default,,0,0,0,,Мен үйдемін~ Марилла.
Dialogue: 0,0:13:04.85,0:13:08.05,Default,,0,0,0,,Энн! Дора жоқ.
Dialogue: 0,0:13:08.05,0:13:11.59,Default,,0,0,0,,Иә!? Мен дәл қазір Рейчелге қонаққа бардым➡
Dialogue: 0,0:13:11.59,0:13:15.52,Default,,0,0,0,,Қайтып келгенімде сені көре алмадым.
Dialogue: 0,0:13:15.52,0:13:19.23,Default,,0,0,0,,Дэви, сен Дораның қайда екенін білмейсің бе?
Dialogue: 0,0:13:19.23,0:13:21.16,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:13:21.16,0:13:23.80,Default,,0,0,0,,Түскі ас ішкеннен бері сені көрмедім.
Dialogue: 0,0:13:23.80,0:13:26.20,Default,,0,0,0,,Мен көкке ант етемін. иә….
Dialogue: 0,0:13:26.20,0:13:28.60,Default,,0,0,0,,Мен үйді тінттім.
Dialogue: 0,0:13:28.60,0:13:33.91,Default,,0,0,0,,Менің ойымша, бұл өте алысқа бармайды. Жақын жерден қайта іздейік.
Dialogue: 0,0:13:33.91,0:13:35.88,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:13:35.88,0:13:37.88,Default,,0,0,0,,(Ағып жатқан өзеннің дыбысы)
Dialogue: 0,0:13:37.88,0:13:40.38,Default,,0,0,0,,Дора~!
Dialogue: 0,0:13:40.38,0:13:42.35,Default,,0,0,0,,Дора~!
Dialogue: 0,0:13:42.35,0:13:44.59,Default,,0,0,0,,Күтілгендей, олар жоқ.
Dialogue: 0,0:13:44.59,0:13:46.52,Default,,0,0,0,,Қайда кеткені қызық...
Dialogue: 0,0:13:46.52,0:13:50.49,Default,,0,0,0,,Әй, сен құдыққа түсіп кеткен шығарсың.
Dialogue: 0,0:13:50.49,0:13:52.83,Default,,0,0,0,,Көрдіңіз бе? Уф.
Dialogue: 0,0:13:52.83,0:13:57.10,Default,,0,0,0,,Бірақ сіз іздемейтін жалғыз жер құдықтың іші емес пе?
Dialogue: 0,0:13:57.10,0:13:59.03,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:13:59.03,0:14:03.87,Default,,0,0,0,,♬～
Dialogue: 0,0:14:03.87,0:14:06.91,Default,,0,0,0,,Олардың арасында Дора болса...
Dialogue: 0,0:14:06.91,0:14:09.18,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:14:09.18,0:14:13.88,Default,,0,0,0,,Харрисон мырзаға жіберіңіз. Харрисон мырза бүгін жоқ.
Dialogue: 0,0:14:13.88,0:14:16.75,Default,,0,0,0,,Берли мырзадан сұрайық.
Dialogue: 0,0:14:16.75,0:14:19.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.65,0:14:22.56,Default,,0,0,0,,Хмм…. (Су астындағы барлау дыбысы)
Dialogue: 0,0:14:22.56,0:14:28.16,Default,,0,0,0,,(Су астындағы барлау дыбысы)
Dialogue: 0,0:14:28.16,0:14:30.57,Default,,0,0,0,,Хм... Мен бұл жерде емес деп ойлаймын.
Dialogue: 0,0:14:30.57,0:14:32.53,Default,,0,0,0,,Ах... Дэви. ➡
Dialogue: 0,0:14:32.53,0:14:35.37,Default,,0,0,0,,Сіз әпкеңіздің қайда кеткенін білмейсіз бе?
Dialogue: 0,0:14:35.37,0:14:37.77,Default,,0,0,0,,Білмеймін деп айта берем!
Dialogue: 0,0:14:37.77,0:14:41.48,Default,,0,0,0,,Мен ұрлаушылардың келіп, Дораны алып кеткеніне сенімдімін.
Dialogue: 0,0:14:41.48,0:14:43.88,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:14:43.88,0:14:47.75,Default,,0,0,0,,Энн, ол Гаррисон мырзаға барды деп ойламайсың ба?
Dialogue: 0,0:14:47.75,0:14:53.19,Default,,0,0,0,,Сен мені бір күні сонда апарғалы бері тотықұстар туралы айтып келеміз.
Dialogue: 0,0:14:53.19,0:14:55.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:55.16,0:14:57.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:57.39,0:15:00.29,Default,,0,0,0,,Дора? Дора!
Dialogue: 0,0:15:00.29,0:15:03.66,Default,,0,0,0,,Хоо~ Хоо~!
Dialogue: 0,0:15:03.66,0:15:08.17,Default,,0,0,0,,Кішкентай қызыл шашты қыз. Кішкентай қызыл шашты қыз.
Dialogue: 0,0:15:09.84,0:15:11.77,Default,,0,0,0,,Дора~! ⚟(жылау)
Dialogue: 0,0:15:11.77,0:15:13.74,Default,,0,0,0,,Дора... Ах!
Dialogue: 0,0:15:13.74,0:15:16.44,Default,,0,0,0,,⚟ (жылап) Дора...?
Dialogue: 0,0:15:20.35,0:15:21.98,Default,,0,0,0,,Ах…. Дора!
Dialogue: 0,0:15:21.98,0:15:25.85,Default,,0,0,0,,Дора мен уайымдадым. Неге мұндасың?
Dialogue: 0,0:15:25.85,0:15:30.69,Default,,0,0,0,,Дэви екеуміз... Джинжерді көруге келдік...
Dialogue: 0,0:15:30.69,0:15:33.10,Default,,0,0,0,,Бірақ Харрисон мырза жоқ...➡
Dialogue: 0,0:15:33.10,0:15:37.50,Default,,0,0,0,,Содан кейін Дэйви мені осында әкелді➡
Dialogue: 0,0:15:37.50,0:15:39.43,Default,,0,0,0,,Мен есікті жауып, кетіп қалдым...
Dialogue: 0,0:15:39.43,0:15:41.77,Default,,0,0,0,,Қорыққаным сонша, қатты жыладым.
Dialogue: 0,0:15:41.77,0:15:45.24,Default,,0,0,0,,Ешкім келмейді деп ойладым...
Dialogue: 0,0:15:45.24,0:15:47.64,Default,,0,0,0,,Еске алу Көкке ант етемін.
Dialogue: 0,0:15:49.24,0:15:53.38,Default,,0,0,0,,Дора! Мистер Берли: Дора сонда болды.
Dialogue: 0,0:15:53.38,0:15:56.38,Default,,0,0,0,,Хмм... жақсы!
Dialogue: 0,0:16:01.02,0:16:03.36,Default,,0,0,0,,Дэви қайда?
Dialogue: 0,0:16:03.36,0:16:07.76,Default,,0,0,0,,Ол қорада жасырынған.
Dialogue: 0,0:16:09.83,0:16:12.03,Default,,0,0,0,,Хехе.
Dialogue: 0,0:16:16.34,0:16:19.24,Default,,0,0,0,,Сіз мұндай нәрсені қалай жасай аласыз?
Dialogue: 0,0:16:19.24,0:16:21.48,Default,,0,0,0,,Дэви! Уф...!
Dialogue: 0,0:16:21.48,0:16:24.85,Default,,0,0,0,,Мен... Мен әзілдеп едім.
Dialogue: 0,0:16:24.85,0:16:27.48,Default,,0,0,0,,Анн-чанды және басқа ересектерді таң қалдырсам ше➡
Dialogue: 0,0:16:27.48,0:16:30.15,Default,,0,0,0,,Қызық болар деп ойладым.
Dialogue: 0,0:16:30.15,0:16:33.05,Default,,0,0,0,,Бірақ сіз өтірік айттыңыз.
Dialogue: 0,0:16:33.05,0:16:35.49,Default,,0,0,0,,Өтірік? Өтірік айтасың ба?
Dialogue: 0,0:16:35.49,0:16:39.03,Default,,0,0,0,,Дұрыс емес нәрсені айту – өтірік.
Dialogue: 0,0:16:39.03,0:16:42.56,Default,,0,0,0,,Әй, бәрі осылай деп жатыр ма?
Dialogue: 0,0:16:42.56,0:16:44.20,Default,,0,0,0,,Әрине, мен де солай айттым. ➡
Dialogue: 0,0:16:44.20,0:16:47.10,Default,,0,0,0,,Әйтпесе, Эннчан, таң қалмайсың, солай ма? ➡
Dialogue: 0,0:16:47.10,0:16:50.67,Default,,0,0,0,,Мен мұны айтуым керек еді.
Dialogue: 0,0:16:50.67,0:16:52.94,Default,,0,0,0,,Мм... әпке?
Dialogue: 0,0:16:52.94,0:16:55.98,Default,,0,0,0,,Неге жылайсың? Көбірек таң қалдырыңыз! ➡
Dialogue: 0,0:16:55.98,0:16:58.75,Default,,0,0,0,,Сол себепті мен...
Dialogue: 0,0:16:58.75,0:17:03.22,Default,,0,0,0,,Сіз бұл өтіріктің қаншалықты жаман екенін білмейсіз бе?
Dialogue: 0,0:17:03.22,0:17:05.19,Default,,0,0,0,,Ах...! ➡
Dialogue: 0,0:17:05.19,0:17:07.19,Default,,0,0,0,,Энн-ни...чан...?
Dialogue: 0,0:17:07.19,0:17:09.36,Default,,0,0,0,,(Аннаның жылағаны)
Dialogue: 0,0:17:09.36,0:17:12.56,Default,,0,0,0,,А... а... а...➡
Dialogue: 0,0:17:12.56,0:17:14.53,Default,,0,0,0,,Ааа! ➡
Dialogue: 0,0:17:14.53,0:17:16.86,Default,,0,0,0,,Кешіріңіз, әпке! ➡
Dialogue: 0,0:17:16.86,0:17:19.90,Default,,0,0,0,,Өтірік айтудың дұрыс емес екенін білмедім!
Dialogue: 0,0:17:19.90,0:17:22.44,Default,,0,0,0,,Мен қайдан білемін?
Dialogue: 0,0:17:22.44,0:17:24.37,Default,,0,0,0,,Спротт мырзаның немере ағасы➡
Dialogue: 0,0:17:24.37,0:17:26.67,Default,,0,0,0,,Мен үнемі өтірік айтатынмын. ➡
Dialogue: 0,0:17:26.67,0:17:30.55,Default,,0,0,0,,Пол Ирвинг ешқашан өтірік айтпайды.
Dialogue: 0,0:17:30.55,0:17:36.35,Default,,0,0,0,,Мен Павел сияқты болсам ғой...➡
Dialogue: 0,0:17:36.35,0:17:38.69,Default,,0,0,0,,Жақсы емес...
Dialogue: 0,0:17:38.69,0:17:44.09,Default,,0,0,0,,(Дэвидің айқайы)
Dialogue: 0,0:17:44.09,0:17:46.13,Default,,0,0,0,,Анн-чан қазірдің өзінде...➡
Dialogue: 0,0:17:46.13,0:17:48.80,Default,,0,0,0,,Сен маған ғашық болмайсың... ➡
Dialogue: 0,0:17:48.80,0:17:51.70,Default,,0,0,0,,Сені жылатқаны үшін кешірім сұраймын, Эннни...
Dialogue: 0,0:17:51.70,0:17:53.77,Default,,0,0,0,,Жақсы нәрсе Дэви.
Dialogue: 0,0:17:53.77,0:17:55.90,Default,,0,0,0,,Өтірік айтпасаң да➡
Dialogue: 0,0:17:55.90,0:18:00.44,Default,,0,0,0,,Бұл дүниеде көптеген қызықты нәрселер бар.
Dialogue: 0,0:18:00.44,0:18:03.34,Default,,0,0,0,,Мен мұны айтайын.
Dialogue: 0,0:18:03.34,0:18:06.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:06.28,0:18:10.72,Default,,0,0,0,,Марилла Дэйви өтірік айтудың дұрыс емес екенін білмеді.
Dialogue: 0,0:18:10.72,0:18:14.09,Default,,0,0,0,,Енді өтірік айтпаймын деп уәде берсеңіз➡
Dialogue: 0,0:18:14.09,0:18:16.42,Default,,0,0,0,,Мен сені кешірсем жақсы болар деп ойлаймын.
Dialogue: 0,0:18:16.42,0:18:18.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:18.73,0:18:20.66,Default,,0,0,0,,Мен енді өтірік айта алмаймын.
Dialogue: 0,0:18:20.66,0:18:22.73,Default,,0,0,0,,Енді мен оның жаман екенін білемін!
Dialogue: 0,0:18:22.73,0:18:25.60,Default,,0,0,0,,Тағы бір үлкен өтірік айтсам➡
Dialogue: 0,0:18:25.60,0:18:29.87,Default,,0,0,0,,Теріні тірі кезінде жұлып алуға болады...
Dialogue: 0,0:18:29.87,0:18:33.67,Default,,0,0,0,,Хе, олай айтпау керек.
Dialogue: 0,0:18:33.67,0:18:37.35,Default,,0,0,0,,Ах...! Сонда бәрі жақсы.
Dialogue: 0,0:18:37.35,0:18:39.28,Default,,0,0,0,,Қандай жаза? ➡
Dialogue: 0,0:18:39.28,0:18:41.68,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:18:41.68,0:18:44.49,Default,,0,0,0,,Дұрыс... мен үшін➡
Dialogue: 0,0:18:44.49,0:18:48.76,Default,,0,0,0,,Менің ойыма келетін жалғыз нәрсе кешкі ассыз ұйықтау➡
Dialogue: 0,0:18:48.76,0:18:53.46,Default,,0,0,0,,Бір нәрсені ойлау үшін өз қиялыңызды пайдаланыңыз.
Dialogue: 0,0:18:53.46,0:18:56.00,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:18:56.00,0:19:00.70,Default,,0,0,0,,Мен елестеткім келетін нәрсе - жағымды нәрсе.
Dialogue: 0,0:19:00.70,0:19:03.04,Default,,0,0,0,,Дүниеде енді жоқ➡
Dialogue: 0,0:19:03.04,0:19:06.71,Default,,0,0,0,,Жағымсыз нәрселер өте көп.
Dialogue: 0,0:19:06.71,0:19:11.11,Default,,0,0,0,,Біз оны енді арттырмаймыз, солай ма?
Dialogue: 0,0:19:14.42,0:19:16.38,Default,,0,0,0,,Энн әпке➡
Dialogue: 0,0:19:16.38,0:19:18.99,Default,,0,0,0,,Ешкім өтірік айтпауы керек пе?
Dialogue: 0,0:19:18.99,0:19:21.76,Default,,0,0,0,,Иә. Тіпті ересектер ме? Бұл дұрыс.
Dialogue: 0,0:19:21.76,0:19:26.23,Default,,0,0,0,,Ондай жағдайда апай болмайды. Сен маған өтірік айттың.
Dialogue: 0,0:19:26.23,0:19:29.23,Default,,0,0,0,,Дэви Марилла өтірік айта алмайды.
Dialogue: 0,0:19:29.23,0:19:31.77,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:19:31.77,0:19:36.17,Default,,0,0,0,,Күнде намазды дұрыс оқымасаң сұмдық болады дейді. ➡
Dialogue: 0,0:19:36.17,0:19:39.07,Default,,0,0,0,,Ендеше не болады екен деп ойлаймын➡
Dialogue: 0,0:19:39.07,0:19:41.94,Default,,0,0,0,,Сынақ деп намаз оқымай күттім. ➡
Dialogue: 0,0:19:41.94,0:19:43.88,Default,,0,0,0,,Содан кейін...➡
Dialogue: 0,0:19:43.88,0:19:45.95,Default,,0,0,0,,Ештеңе болмайды, солай ма?
Dialogue: 0,0:19:45.95,0:19:48.15,Default,,0,0,0,,Хехе. (Дэви) Апай өтірікші болмаса➡
Dialogue: 0,0:19:48.15,0:19:50.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:50.08,0:19:54.86,Default,,0,0,0,,О, Дэйви. Дәл қазір қорқынышты нәрсе болып жатыр.
Dialogue: 0,0:19:54.86,0:19:57.76,Default,,0,0,0,,Кешкі ассыз төсекке жіберді ме?
Dialogue: 0,0:19:57.76,0:20:00.46,Default,,0,0,0,,Бұл мүлдем қорқынышты емес.
Dialogue: 0,0:20:00.46,0:20:03.36,Default,,0,0,0,,Ертең таңертең екі рет тамақтаныңыз.
Dialogue: 0,0:20:03.36,0:20:06.27,Default,,0,0,0,,Шын мәнінде емес. Жақсы нәрсе? Дэви.
Dialogue: 0,0:20:06.27,0:20:08.24,Default,,0,0,0,,Қорқыныштысы ➡
Dialogue: 0,0:20:08.24,0:20:10.24,Default,,0,0,0,,Тіпті жоқ өтірік айту.
Dialogue: 0,0:20:10.24,0:20:14.01,Default,,0,0,0,,Мен мұны ең қорқыныштысы деп айтуға дейін барар едім.
Dialogue: 0,0:20:14.01,0:20:17.81,Default,,0,0,0,,Сонымен Марилла шындықты айтты.
Dialogue: 0,0:20:19.81,0:20:22.48,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:22.48,0:20:26.79,Default,,0,0,0,,Бірақ апамның айтқан қорқынышты сөздері➡
Dialogue: 0,0:20:26.79,0:20:30.12,Default,,0,0,0,,Бір нәрсе… қызықты….
Dialogue: 0,0:20:30.12,0:20:32.73,Default,,0,0,0,,Ахахахахха!
Dialogue: 0,0:20:32.73,0:20:36.00,Default,,0,0,0,,Мұны Дэйвиге айтпау керек еді. ➡
Dialogue: 0,0:20:36.00,0:20:41.30,Default,,0,0,0,,Мен бірде бір пастордың балаларына осылай айтқанын естідім.
Dialogue: 0,0:20:41.30,0:20:44.51,Default,,0,0,0,,Балалар бұған қанағаттанды.
Dialogue: 0,0:20:44.51,0:20:48.01,Default,,0,0,0,,Бірақ Дэви оңай емес.
Dialogue: 0,0:20:48.01,0:20:51.85,Default,,0,0,0,,Дұрыс. Енді ол баланы не істейміз?
Dialogue: 0,0:20:51.85,0:20:54.32,Default,,0,0,0,,Дора сондай жақсы қыз.
Dialogue: 0,0:20:54.32,0:20:56.75,Default,,0,0,0,,Жақсы қыз жақсы қыз, қиын.
Dialogue: 0,0:20:56.75,0:20:59.99,Default,,0,0,0,,Оның үстіне мен мұнда келгенде...
Dialogue: 0,0:20:59.99,0:21:02.96,Default,,0,0,0,,♬～
Dialogue: 0,0:21:02.96,0:21:05.36,Default,,0,0,0,,Әрине, сіз де➡
Dialogue: 0,0:21:05.36,0:21:08.26,Default,,0,0,0,,Мен көп қиыншылыққа тап болдым.
Dialogue: 0,0:21:08.26,0:21:10.20,Default,,0,0,0,,Ах ха ха ха!
Dialogue: 0,0:21:10.20,0:21:12.17,Default,,0,0,0,,Хехехе! Хе хехе!
Dialogue: 0,0:21:12.17,0:21:14.47,Default,,0,0,0,,Көп күлудің қажеті жоқ. Ахххх! ➡
Dialogue: 0,0:21:14.47,0:21:16.47,Default,,0,0,0,,Ах, а... Хехе!
Dialogue: 0,0:21:16.47,0:21:21.21,Default,,0,0,0,,Дэйвиге оны баурап алатын бірдеңе керек екеніне сенімдімін.
Dialogue: 0,0:21:21.21,0:21:24.08,Default,,0,0,0,,Мен бұрынғыдай...
Dialogue: 0,0:21:24.08,0:21:26.11,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:21:26.11,0:21:30.62,Default,,0,0,0,,Марилла мен Мэтьюдің арқасында мен осы уақытқа дейін жеттім.
Dialogue: 0,0:21:30.62,0:21:34.05,Default,,0,0,0,,Мен бұл екеуіне де солай жасағым келеді.
Dialogue: 0,0:21:34.05,0:21:35.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:35.99,0:21:40.16,Default,,0,0,0,,Біз әрқашан бізге мұқтаж адамдармыз➡
Dialogue: 0,0:21:40.16,0:21:42.83,Default,,0,0,0,,Менің ойымша, бұл мені қызықтырады.
Dialogue: 0,0:21:42.83,0:21:46.07,Default,,0,0,0,,Біз екеуіңе керексіңдер.
Dialogue: 0,0:21:46.07,0:21:51.61,Default,,0,0,0,,...Матай да дәл қазір сіз айтқан сөзді айтты.
Dialogue: 0,0:21:51.61,0:21:53.54,Default,,0,0,0,,Матай...?
Dialogue: 0,0:21:53.54,0:21:57.24,Default,,0,0,0,,Бұл кім? Маған Мэтью керек еді.
Dialogue: 0,0:21:57.24,0:21:59.18,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:59.18,0:22:02.88,Default,,0,0,0,,Эй, айтшы.
Dialogue: 0,0:22:05.12,0:22:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.03,0:22:17.80,Default,,0,0,0,,♬ «Не маңызды?»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:45.02,Default,,0,0,0,,♬～
Dialogue: 0,0:23:45.02,0:23:57.13,Default,,0,0,0,,♬～
