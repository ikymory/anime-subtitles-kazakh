Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:05.77,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:05.77,0:00:07.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:07.70,0:00:09.77,Default,,0,0,0,,Энн Міне, сізге хат.
Dialogue: 0,0:00:09.77,0:00:13.08,Default,,0,0,0,,Рахмет, Марилла.
Dialogue: 0,0:00:13.08,0:00:15.04,Default,,0,0,0,,Филиппадан.
Dialogue: 0,0:00:15.04,0:00:19.82,Default,,0,0,0,,<Мен жазғы демалысымды 20 жасымда Авонлеада өткіздім➡
Dialogue: 0,0:00:19.82,0:00:23.05,Default,,0,0,0,,Күзде университетте үшінші курсты бастағалы жатырмын. ➡
Dialogue: 0,0:00:23.05,0:00:25.95,Default,,0,0,0,,Мұндай жағдайда...>
Dialogue: 0,0:00:25.95,0:00:29.52,Default,,0,0,0,,Фил…➡
Dialogue: 0,0:00:29.52,0:00:33.30,Default,,0,0,0,,Пастордың... әйеліне?
Dialogue: 0,0:00:33.30,0:00:42.40,Default,,0,0,0,,♬～
Dialogue: 0,0:00:42.40,0:00:47.08,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:00:47.08,0:00:49.51,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:00:49.51,0:00:51.51,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:00:51.51,0:00:55.38,Default,,0,0,0,,♬ «Мен ойларды оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:00:55.38,0:00:57.75,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:00:57.75,0:00:59.99,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:00:59.99,0:01:04.46,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:01:04.46,0:01:09.67,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін.»
Dialogue: 0,0:01:09.67,0:01:11.60,Default,,0,0,0,,♬ «Ол маған айтты».
Dialogue: 0,0:01:11.60,0:01:15.47,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:01:15.47,0:01:18.87,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:01:18.87,0:01:21.31,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:01:21.31,0:01:23.58,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:01:23.58,0:01:27.82,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:01:27.82,0:01:30.29,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:01:30.29,0:01:32.62,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:01:32.62,0:01:36.09,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:01:36.09,0:01:39.39,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:01:39.39,0:01:41.63,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:01:41.63,0:01:45.90,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:01:45.90,0:01:48.40,Default,,0,0,0,,♬ «Мен санауды күтемін.»
Dialogue: 0,0:01:48.40,0:01:50.71,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:01:50.71,0:01:52.71,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:01:52.71,0:01:56.41,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:01:56.41,0:02:00.92,Default,,0,0,0,,♬～
Dialogue: 0,0:02:03.59,0:02:08.26,Default,,0,0,0,,♬～
Dialogue: 0,0:02:08.26,0:02:11.06,Default,,0,0,0,,«Емле соңында е бар➡
Dialogue: 0,0:02:11.06,0:02:14.50,Default,,0,0,0,,Құрметті Анна, ➡
Dialogue: 0,0:02:14.50,0:02:18.80,Default,,0,0,0,,Мен қазір Кейп проспектіндемін. ➡
Dialogue: 0,0:02:18.80,0:02:21.50,Default,,0,0,0,,Маған жазда жағалауда уақыт өткізген ұнайды➡
Dialogue: 0,0:02:21.50,0:02:25.81,Default,,0,0,0,,Биыл менің туысым Эмили осы мүйіске қонаққа келеді. ➡
Dialogue: 0,0:02:25.81,0:02:27.78,Default,,0,0,0,,Эмилидің пансионатында➡
Dialogue: 0,0:02:27.78,0:02:30.51,Default,,0,0,0,,Менен басқа тағы 5 тұрғын бар➡
Dialogue: 0,0:02:30.51,0:02:34.38,Default,,0,0,0,,Төрт кемпір мен бір жас жігіт. ➡
Dialogue: 0,0:02:34.38,0:02:38.25,Default,,0,0,0,,Жас жігіттің аты Джонас Блейк. ➡
Dialogue: 0,0:02:38.25,0:02:43.16,Default,,0,0,0,,Мен келген күннен бастап Йонас үстелге қарсы отырды➡
Dialogue: 0,0:02:43.16,0:02:45.99,Default,,0,0,0,,Біз бір-бірімізді сәби кезімізден білетін сияқтымыз➡
Dialogue: 0,0:02:45.99,0:02:49.40,Default,,0,0,0,,Ол маған күлді.''
Dialogue: 0,0:02:51.30,0:02:54.00,Default,,0,0,0,,Рахмет. қош келдіңіз.
Dialogue: 0,0:02:54.00,0:02:57.21,Default,,0,0,0,,«Ол Сент-Колумбиядан келген семинарист болды➡
Dialogue: 0,0:02:57.21,0:03:01.08,Default,,0,0,0,,Мен жазда Кейп проспектіндегі шіркеуге жауаптымын. ➡
Dialogue: 0,0:03:01.08,0:03:03.58,Default,,0,0,0,,Күлкілі ұзын аяқтарымен➡
Dialogue: 0,0:03:03.58,0:03:06.05,Default,,0,0,0,,Бос және үлкен денелі➡
Dialogue: 0,0:03:06.05,0:03:08.28,Default,,0,0,0,,Сол құлақтар туралы айтсақ...➡
Dialogue: 0,0:03:08.28,0:03:10.89,Default,,0,0,0,,Мүмкін болса, Джонастың құлағы туралы➡
Dialogue: 0,0:03:10.89,0:03:12.82,Default,,0,0,0,,Мен бұл туралы ойламауға тырысамын.
Dialogue: 0,0:03:12.82,0:03:15.82,Default,,0,0,0,,Хехе. «Бірақ сенің дауысың әдемі!➡
Dialogue: 0,0:03:15.82,0:03:19.56,Default,,0,0,0,,Көзімді жұмып, тек дауысты тыңдасам...» Бұл шайдың ащысы жағымды.
Dialogue: 0,0:03:19.56,0:03:21.50,Default,,0,0,0,,Өте жақсы. (Кемпір) Бұл рас.
Dialogue: 0,0:03:21.50,0:03:24.43,Default,,0,0,0,,«Менің ойымша, сіз қандай кереметсіз.➡
Dialogue: 0,0:03:24.43,0:03:27.34,Default,,0,0,0,,Біз тез достасып кеттік. ➡
Dialogue: 0,0:03:27.34,0:03:30.04,Default,,0,0,0,,Джонас та Редмонд түлегі➡
Dialogue: 0,0:03:30.04,0:03:32.97,Default,,0,0,0,,Бұл бізді байланыстырады. ➡
Dialogue: 0,0:03:32.97,0:03:35.21,Default,,0,0,0,,Бірге балық аулау➡
Dialogue: 0,0:03:35.21,0:03:37.15,Default,,0,0,0,,Қайықпен жүзу➡
Dialogue: 0,0:03:37.15,0:03:40.38,Default,,0,0,0,,Айлы түнде құмды жағада серуенге шықтым. ➡
Dialogue: 0,0:03:40.38,0:03:42.98,Default,,0,0,0,,Ай сәулесі астында...➡
Dialogue: 0,0:03:42.98,0:03:46.39,Default,,0,0,0,,Иә, ол керемет адам еді. ➡
Dialogue: 0,0:03:46.39,0:03:50.83,Default,,0,0,0,,Джонастың бойынан сүйкімділік сезімі пайда болған сияқты.''
Dialogue: 0,0:03:50.83,0:03:53.50,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:03:53.50,0:03:55.73,Default,,0,0,0,,«Бір себептермен мен➡
Dialogue: 0,0:03:55.73,0:03:59.60,Default,,0,0,0,,Мен Джонас мені жеңілтек деп ойлағанын қаламаймын. ➡
Dialogue: 0,0:03:59.60,0:04:02.10,Default,,0,0,0,,Бұл біртүрлі, солай емес пе? ➡
Dialogue: 0,0:04:02.10,0:04:04.44,Default,,0,0,0,,Джонас➡ атты зығыр шашы бар адам
Dialogue: 0,0:04:04.44,0:04:06.84,Default,,0,0,0,,Сіздей адамды бұрын-соңды көрмеген➡
Dialogue: 0,0:04:06.84,0:04:09.18,Default,,0,0,0,,Мен туралы не ойлайсың➡
Dialogue: 0,0:04:09.18,0:04:12.18,Default,,0,0,0,,Маған неге бәрібір?''
Dialogue: 0,0:04:14.12,0:04:19.25,Default,,0,0,0,,«Басқа жексенбіде Йонас ауыл шіркеуінде уағыз айтты».
Dialogue: 0,0:04:19.25,0:04:24.06,Default,,0,0,0,,Бүгін мен бәріңмен бірге бақыт туралы ойланғым келеді. ➡
Dialogue: 0,0:04:24.06,0:04:26.96,Default,,0,0,0,,Бақыт дегеніміз не?
Dialogue: 0,0:04:26.96,0:04:29.70,Default,,0,0,0,,«10 минут басталғанша➡
Dialogue: 0,0:04:29.70,0:04:34.47,Default,,0,0,0,,Мен өзімді өте кішкентай және түкке тұрғысыз сезінемін➡
Dialogue: 0,0:04:34.47,0:04:36.40,Default,,0,0,0,,Тым кішкентай➡
Dialogue: 0,0:04:36.40,0:04:39.71,Default,,0,0,0,,Қарапайым көзге көрінбейтін шығар деп ойладым. ➡
Dialogue: 0,0:04:39.71,0:04:43.28,Default,,0,0,0,,Джонас маған ешқашан қарамады➡
Dialogue: 0,0:04:43.28,0:04:46.18,Default,,0,0,0,,Оның идеалды әйелі және мен➡
Dialogue: 0,0:04:46.18,0:04:50.02,Default,,0,0,0,,Мен үлкен айырмашылық болуы керек екенін түсіндім. ➡
Dialogue: 0,0:04:50.02,0:04:53.99,Default,,0,0,0,,Джонас байсалды, мейірімді және шынайы болды. ➡
Dialogue: 0,0:04:53.99,0:04:57.23,Default,,0,0,0,,Пастор болу үшін қажет нәрсенің барлығына ие болыңыз➡
Dialogue: 0,0:04:57.23,0:05:00.13,Default,,0,0,0,,Мен оны мәңгі тыңдай алар едім. ➡
Dialogue: 0,0:05:00.13,0:05:04.97,Default,,0,0,0,,Үйге қайтып келе жатқанда, Джонас маған әдеттегідей күлімсірей қарады➡
Dialogue: 0,0:05:04.97,0:05:06.97,Default,,0,0,0,,Мен енді алданбаймын. ➡
Dialogue: 0,0:05:06.97,0:05:11.24,Default,,0,0,0,,Мен нағыз Джонасты көрдім. ➡
Dialogue: 0,0:05:11.24,0:05:14.58,Default,,0,0,0,,Джонас нағыз мені көре ме? ➡
Dialogue: 0,0:05:14.58,0:05:17.48,Default,,0,0,0,,Нағыз Фил әлі ешкім емес➡
Dialogue: 0,0:05:17.48,0:05:20.78,Default,,0,0,0,,Энн, тіпті сен оны көрмедің.
Dialogue: 0,0:05:20.78,0:05:22.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:22.72,0:05:27.66,Default,,0,0,0,,Джонас, сен пастор болу үшін дүниеге келдің.
Dialogue: 0,0:05:27.66,0:05:31.19,Default,,0,0,0,,Иә. Негізі көптен бері➡
Dialogue: 0,0:05:31.19,0:05:34.13,Default,,0,0,0,,Мен басқа нәрсе болу үшін күрестім. ➡
Dialogue: 0,0:05:34.13,0:05:36.46,Default,,0,0,0,,Бірақ, ақырында, бұл➡
Dialogue: 0,0:05:36.46,0:05:40.27,Default,,0,0,0,,Маған берілгенін түсіндім. ➡
Dialogue: 0,0:05:40.27,0:05:42.34,Default,,0,0,0,,Құдайдың көмегімен➡
Dialogue: 0,0:05:42.34,0:05:45.24,Default,,0,0,0,,Мен бұл жұмысты жалғастыруға ниеттемін.
Dialogue: 0,0:05:45.24,0:05:47.38,Default,,0,0,0,,«Егер мен Джонастың орнында болсам➡
Dialogue: 0,0:05:47.38,0:05:51.05,Default,,0,0,0,,Ол өз жұмысын абыроймен, абыроймен атқаратын шығар деп ойладым. ➡
Dialogue: 0,0:05:51.05,0:05:55.25,Default,,0,0,0,,Ал Жүністің жұмысына көмектесетін әйел сол➡
Dialogue: 0,0:05:55.25,0:05:57.95,Default,,0,0,0,,Мен өзімді бақытты сезіндім. ➡
Dialogue: 0,0:05:57.95,0:06:00.76,Default,,0,0,0,,Құбылмалы жел соққан сайын сол әйел➡
Dialogue: 0,0:06:00.76,0:06:02.79,Default,,0,0,0,,Ұшыңыз➡
Dialogue: 0,0:06:02.79,0:06:06.09,Default,,0,0,0,,Бұл қауырсынға ұқсамайды.''
Dialogue: 0,0:06:08.63,0:06:10.63,Default,,0,0,0,,«Қандай қалпақ киюім керек➡
Dialogue: 0,0:06:10.63,0:06:12.63,Default,,0,0,0,,Сіз оны жақсы түсінетініңізге сенімдімін➡
Dialogue: 0,0:06:12.63,0:06:15.87,Default,,0,0,0,,Сізде бір ғана қалпақ болуы мүмкін. ➡
Dialogue: 0,0:06:15.87,0:06:19.57,Default,,0,0,0,,Бірақ сенде бір қалпақ бар ма, жоқ па бәрібір. ➡
Dialogue: 0,0:06:19.57,0:06:22.24,Default,,0,0,0,,Джонас осында. ➡
Dialogue: 0,0:06:22.24,0:06:25.78,Default,,0,0,0,,Анна: Мен Джонасқа ғашық болдым➡
Dialogue: 0,0:06:25.78,0:06:29.05,Default,,0,0,0,,Егер сіз бірдеңе айтсаңыз немесе тұспалдасаңыз, мен оны қабылдамаймын. ➡
Dialogue: 0,0:06:29.05,0:06:32.89,Default,,0,0,0,,Сіз кедей, зеріктіретін семинаристке ғашық бола аласыз ба? ➡
Dialogue: 0,0:06:32.89,0:06:35.49,Default,,0,0,0,,Қайырлы түн. ➡
Dialogue: 0,0:06:35.49,0:06:38.69,Default,,0,0,0,,P.S. Бұлай болуы мүмкін емес. ➡
Dialogue: 0,0:06:38.69,0:06:41.60,Default,,0,0,0,,Бірақ мен солай деп ойлаймын➡
Dialogue: 0,0:06:41.60,0:06:45.07,Default,,0,0,0,,Мен қатты қорқамын. ➡
Dialogue: 0,0:06:45.07,0:06:47.04,Default,,0,0,0,,Өйткені Джонас➡
Dialogue: 0,0:06:47.04,0:06:49.27,Default,,0,0,0,,Мені ұнатпау қиын➡
Dialogue: 0,0:06:49.27,0:06:51.24,Default,,0,0,0,,Мен түсіндім. ➡
Dialogue: 0,0:06:51.24,0:06:58.41,Default,,0,0,0,,Энн, қалай ойлайсың, мен өскенде пастордың әйелі бола аламын ба? ➡
Dialogue: 0,0:06:58.41,0:07:00.48,Default,,0,0,0,,Ал маған➡
Dialogue: 0,0:07:00.48,0:07:02.82,Default,,0,0,0,,Мен басқалардың көзінше дұға ете аламын ба? ➡
Dialogue: 0,0:07:02.82,0:07:05.42,Default,,0,0,0,,Фил Гордон».
Dialogue: 0,0:07:10.06,0:07:14.56,Default,,0,0,0,,Мен бүгін түстен кейін ешнәрсе жасамай, оңай өткізе аламын.
Dialogue: 0,0:07:14.56,0:07:17.23,Default,,0,0,0,,Каминдегі от жайлы жанып тұр➡
Dialogue: 0,0:07:17.23,0:07:20.20,Default,,0,0,0,,Дәмді қыстық алмаларға толы тәрелке бар➡
Dialogue: 0,0:07:20.20,0:07:22.47,Default,,0,0,0,,Үш мысық➡
Dialogue: 0,0:07:22.47,0:07:25.94,Default,,0,0,0,,Тату-тәтті, ырылдап, тәтті дауыс шығаратын жерде біраз уақыт өткіземіз бе?
Dialogue: 0,0:07:25.94,0:07:28.58,Default,,0,0,0,,Немесе сұр орман➡
Dialogue: 0,0:07:28.58,0:07:30.51,Default,,0,0,0,,Порттың жартастарына қарсы шайып кету➡
Dialogue: 0,0:07:30.51,0:07:33.11,Default,,0,0,0,,Боз су шақырып тұрған саябаққа барайық па?
Dialogue: 0,0:07:33.11,0:07:35.12,Default,,0,0,0,,Мен сенің жастық шағың болсам➡
Dialogue: 0,0:07:35.12,0:07:37.12,Default,,0,0,0,,Мен оны саябаққа айналдырамын.
Dialogue: 0,0:07:37.12,0:07:39.35,Default,,0,0,0,,О, мен ханымға сенімдімін➡
Dialogue: 0,0:07:39.35,0:07:41.92,Default,,0,0,0,,«Сіз де біз сияқты жассыз», ➡
Dialogue: 0,0:07:41.92,0:07:43.86,Default,,0,0,0,,Сен солай айттың ба?
Dialogue: 0,0:07:43.86,0:07:45.89,Default,,0,0,0,,Иә, жүрек. ➡
Dialogue: 0,0:07:45.89,0:07:49.46,Default,,0,0,0,,Бірақ менің аяғым сенікіндей жас емес екенін мойындаймын. ➡
Dialogue: 0,0:07:49.46,0:07:52.43,Default,,0,0,0,,Сыртқа шығып, таза ауа жұтып ал, Энн. ➡
Dialogue: 0,0:07:52.43,0:07:55.27,Default,,0,0,0,,Соңғы кездері бозарып кеттіңіз.
Dialogue: 0,0:07:55.27,0:07:58.91,Default,,0,0,0,,Ммм! Саябаққа барайық.
Dialogue: 0,0:07:58.91,0:08:02.51,Default,,0,0,0,,Мен жалғыз боламын және еркін және жабайы боламын.
Dialogue: 0,0:08:02.51,0:08:05.98,Default,,0,0,0,,Қолшатыр әкел. Жаңбыр жауатын шығар.
Dialogue: 0,0:08:05.98,0:08:08.02,Default,,0,0,0,,Жаңбыр? Мүмкін емес.
Dialogue: 0,0:08:08.02,0:08:10.82,Default,,0,0,0,,⚟(Стелла Мейнард) Блэйк мырзаны олай мазақ етудің қажеті жоқ.
Dialogue: 0,0:08:10.82,0:08:14.22,Default,,0,0,0,,Ой, мен сені мүлде мазақ етіп тұрған жоқпын.
Dialogue: 0,0:08:14.22,0:08:18.89,Default,,0,0,0,,Өтірік Эй. Сіз көңілді жүрсіз, солай емес пе?
Dialogue: 0,0:08:18.89,0:08:20.86,Default,,0,0,0,,Жақсы ма? толтыру.
Dialogue: 0,0:08:20.86,0:08:23.33,Default,,0,0,0,,Блейк мырза Алек немесе Алонцо типіндегі адам емес.
Dialogue: 0,0:08:23.33,0:08:26.74,Default,,0,0,0,,Бұл адам - ​​істерге байыппен қарайтын адам. Сіз сол адамсыз➡
Dialogue: 0,0:08:26.74,0:08:29.64,Default,,0,0,0,,Бұл тіпті жүрегіңді жаралауы мүмкін.
Dialogue: 0,0:08:29.64,0:08:31.64,Default,,0,0,0,,Ха...! Шынымен маған➡
Dialogue: 0,0:08:31.64,0:08:33.98,Default,,0,0,0,,Мен осындай нәрсені істей аламын деп ойладым!?
Dialogue: 0,0:08:33.98,0:08:37.55,Default,,0,0,0,,Филипп Гордон... Қандай жүрексіз...
Dialogue: 0,0:08:37.55,0:08:40.22,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін.
Dialogue: 0,0:08:40.22,0:08:42.75,Default,,0,0,0,,Сіз ол адамды әдейі сүйреп жүрсіз.
Dialogue: 0,0:08:42.75,0:08:44.69,Default,,0,0,0,,Одан кейін ешнәрсе істеуге ниетім болмаса да.
Dialogue: 0,0:08:44.69,0:08:46.65,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:08:46.65,0:08:50.23,Default,,0,0,0,,Мүмкін болса, мен оған үйленуге ұсыныс жасаймын.
Dialogue: 0,0:08:50.23,0:08:52.79,Default,,0,0,0,,Ах…. Ха! Мен саған көмектесе алмаймын!
Dialogue: 0,0:08:52.79,0:08:54.73,Default,,0,0,0,,Hmph. Стелла...
Dialogue: 0,0:08:54.73,0:08:57.37,Default,,0,0,0,,Хехе.
Dialogue: 0,0:08:57.37,0:08:59.43,Default,,0,0,0,,Бұл туралы кейінірек айтамыз.
Dialogue: 0,0:08:59.43,0:09:01.44,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:04.01,0:09:06.41,Default,,0,0,0,,⚟Бұл! а….
Dialogue: 0,0:09:06.41,0:09:09.81,Default,,0,0,0,,Және кенеттен... Кешіріңіз, Энн Ширли.
Dialogue: 0,0:09:09.81,0:09:11.75,Default,,0,0,0,,Аздап болса жеткілікті. ➡
Dialogue: 0,0:09:11.75,0:09:14.42,Default,,0,0,0,,Сіз мені тыңдай аласыз ба?
Dialogue: 0,0:09:14.42,0:09:19.25,Default,,0,0,0,,Мен сіздің үмітіңізді ақтай алмаймын. кешіріңіз.
Dialogue: 0,0:09:19.25,0:09:21.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.43,0:09:27.93,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:09:30.23,0:09:33.44,Default,,0,0,0,,♬～
Dialogue: 0,0:09:33.44,0:09:35.67,Default,,0,0,0,,Реминисценция О, Гилберт! ➡
Dialogue: 0,0:09:35.67,0:09:39.61,Default,,0,0,0,,Сен бәрін құрттың...
Dialogue: 0,0:09:39.61,0:09:43.41,Default,,0,0,0,,♬～
Dialogue: 0,0:09:43.41,0:09:46.68,Default,,0,0,0,,Жүрек үні: Идеал адам көрінбесе➡
Dialogue: 0,0:09:46.68,0:09:49.25,Default,,0,0,0,,Балама қандай...
Dialogue: 0,0:09:49.25,0:09:51.59,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:09:51.59,0:10:00.70,Default,,0,0,0,,(Найзағай мен жаңбыр дыбысы)
Dialogue: 0,0:10:00.70,0:10:03.06,Default,,0,0,0,,А, аа! Ах!
Dialogue: 0,0:10:03.06,0:10:05.00,Default,,0,0,0,,«Ұшырып жібереді» дегенде, ол ауада ұша ма?
Dialogue: 0,0:10:05.00,0:10:06.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:06.94,0:10:10.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:10.81,0:10:12.81,Default,,0,0,0,,Кешіріңіз, бірақ...➡
Dialogue: 0,0:10:12.81,0:10:15.41,Default,,0,0,0,,Менің қолшатырымның астына келгің келе ме?
Dialogue: 0,0:10:15.41,0:10:20.18,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:10:20.18,0:10:23.08,Default,,0,0,0,,Жүрек үні (күн күркіреуі) О... О...➡
Dialogue: 0,0:10:23.08,0:10:26.39,Default,,0,0,0,,Ханзада...?
Dialogue: 0,0:10:29.29,0:10:34.16,Default,,0,0,0,,♬～
Dialogue: 0,0:10:34.16,0:10:36.16,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:10:36.16,0:10:40.07,Default,,0,0,0,,Сіз дымқыл боласыз. Қолшатырымның астына кел.
Dialogue: 0,0:10:44.77,0:10:47.68,Default,,0,0,0,,А... аа... рахмет...
Dialogue: 0,0:10:47.68,0:10:51.85,Default,,0,0,0,,Жаңбыр тоқтағанша сонда күтуге болады.
Dialogue: 0,0:10:51.85,0:10:56.72,Default,,0,0,0,,♬～
Dialogue: 0,0:10:56.72,0:10:59.32,Default,,0,0,0,,Қолшатыр төңкерілгенде➡
Dialogue: 0,0:10:59.32,0:11:01.76,Default,,0,0,0,,Мен не істеймін деп ойладым.
Dialogue: 0,0:11:01.76,0:11:04.46,Default,,0,0,0,,Қаласаңыз. А, бар.
Dialogue: 0,0:11:04.46,0:11:07.06,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:11:10.27,0:11:13.60,Default,,0,0,0,,Менің атым Король Гарднер.
Dialogue: 0,0:11:13.60,0:11:16.27,Default,,0,0,0,,Сіз Теннисонның қағазын жаздыңыз➡
Dialogue: 0,0:11:16.27,0:11:18.57,Default,,0,0,0,,Сіз мисс Ширли емессіз бе?
Dialogue: 0,0:11:18.57,0:11:21.24,Default,,0,0,0,,Иә, дұрыс. екінші ойлар туралы.
Dialogue: 0,0:11:21.24,0:11:24.18,Default,,0,0,0,,Сонымен біз бір университетте оқитын сыныптас сияқтымыз.
Dialogue: 0,0:11:24.18,0:11:28.38,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді танымаймын.
Dialogue: 0,0:11:28.38,0:11:33.19,Default,,0,0,0,,Мен солай ойлаймын. Мен әлі ешбір сыныпқа жатпаймын.
Dialogue: 0,0:11:33.19,0:11:35.49,Default,,0,0,0,,Редмондта 2 жыл болды➡
Dialogue: 0,0:11:35.49,0:11:38.23,Default,,0,0,0,,Осыдан кейін мен Еуропаға біраз уақыт кеттім.
Dialogue: 0,0:11:38.23,0:11:41.83,Default,,0,0,0,,Енді мен әдебиет факультетіндегі оқуымды бітірдім.
Dialogue: 0,0:11:41.83,0:11:44.40,Default,,0,0,0,,Мен де биыл үшінші курс студентімін.
Dialogue: 0,0:11:44.40,0:11:47.14,Default,,0,0,0,,Сонымен біз сыныптаспыз...
Dialogue: 0,0:11:47.14,0:11:49.07,Default,,0,0,0,,Бұл да синхронды.
Dialogue: 0,0:11:49.07,0:11:51.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:51.07,0:11:54.51,Default,,0,0,0,,Хехе. Сізбен бірге өткізе алмаған екі жыл➡
Dialogue: 0,0:11:54.51,0:11:56.44,Default,,0,0,0,,Мен кенеттен мұңайып қалдым.
Dialogue: 0,0:11:56.44,0:11:58.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:01.28,0:12:06.12,Default,,0,0,0,,Біздің кездесуімізге ауа-райы жақсылық жасаған сияқты.
Dialogue: 0,0:12:06.12,0:12:09.36,Default,,0,0,0,,Кеттік. Үйіңізге жеткізіп береміз.
Dialogue: 0,0:12:09.36,0:12:11.79,Default,,0,0,0,,Е... жоқ, дәл сол жерде.
Dialogue: 0,0:12:11.79,0:12:14.40,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:12:18.10,0:12:21.40,Default,,0,0,0,,Ширли ханым, сізді қалай атасам екен?
Dialogue: 0,0:12:21.40,0:12:25.91,Default,,0,0,0,,Мүмкін болса, Anne сөзін соңында e әрпімен жазыңыз.
Dialogue: 0,0:12:25.91,0:12:28.84,Default,,0,0,0,,Анна. Бұл туралы ше?
Dialogue: 0,0:12:28.84,0:12:32.05,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:12:32.05,0:12:35.02,Default,,0,0,0,,Энн, менімен тағы кездесе аласың ба?
Dialogue: 0,0:12:35.02,0:12:37.59,Default,,0,0,0,,Мен сенімен жай сөйлескім келеді.
Dialogue: 0,0:12:37.59,0:12:42.42,Default,,0,0,0,,Иә... Иә, әрине.
Dialogue: 0,0:12:42.42,0:12:48.23,Default,,0,0,0,,♬～
Dialogue: 0,0:12:48.23,0:12:51.17,Default,,0,0,0,,Бұл Король Гарднер!?
Dialogue: 0,0:12:51.17,0:12:54.44,Default,,0,0,0,,Адал бол! Қай жерде кездестік?
Dialogue: 0,0:12:54.44,0:12:56.47,Default,,0,0,0,,Бүгін саябақта.
Dialogue: 0,0:12:56.47,0:13:00.58,Default,,0,0,0,,Жаңбыр мен желдің салдарынан қолшатырым төңкеріліп кеткенде, ол адам мені құтқарып қалды.
Dialogue: 0,0:13:00.58,0:13:04.45,Default,,0,0,0,,Иә!? О...! Осындай қарапайым оқиғаның кесірінен➡
Dialogue: 0,0:13:04.45,0:13:07.18,Default,,0,0,0,,Ондаған керемет раушан гүлдері!
Dialogue: 0,0:13:07.18,0:13:09.88,Default,,0,0,0,,Осы сияқты сентименталды өлеңмен➡
Dialogue: 0,0:13:09.88,0:13:12.85,Default,,0,0,0,,Сіз оны сол күні жеткіземін дейсіз бе?
Dialogue: 0,0:13:12.85,0:13:14.86,Default,,0,0,0,,«Анна, менің өткенім➡
Dialogue: 0,0:13:14.86,0:13:17.13,Default,,0,0,0,,Сізбен кездесудің алғы сөзі...»
Dialogue: 0,0:13:17.13,0:13:19.93,Default,,0,0,0,,Иә? Беттерің қызғылт па?
Dialogue: 0,0:13:19.93,0:13:21.86,Default,,0,0,0,,Шатаспаңыз.
Dialogue: 0,0:13:21.86,0:13:23.83,Default,,0,0,0,,Фил Гарднер мырзаны таниды ма?
Dialogue: 0,0:13:23.83,0:13:27.20,Default,,0,0,0,,Иә. Рой өте әдемі және ақылды.
Dialogue: 0,0:13:27.20,0:13:29.14,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:13:29.14,0:13:32.04,Default,,0,0,0,,Мен оның екі әпкесімен таныстым.
Dialogue: 0,0:13:32.04,0:13:34.61,Default,,0,0,0,,Жаңа Шотландиядағы Гарднер отбасы➡
Dialogue: 0,0:13:34.61,0:13:37.58,Default,,0,0,0,,Ең бай және ақсүйектер отбасы. ➡
Dialogue: 0,0:13:37.58,0:13:40.45,Default,,0,0,0,,Осыдан екі жыл бұрын анам бұзылып қалды, сондықтан➡
Dialogue: 0,0:13:40.45,0:13:44.72,Default,,0,0,0,,Сізбен бірге Еуропаға емделуге баруым керек еді.
Dialogue: 0,0:13:44.72,0:13:48.39,Default,,0,0,0,,Ня ня ня…. Мен сабағымды тоқтатуға тура келді➡
Dialogue: 0,0:13:48.39,0:13:50.36,Default,,0,0,0,,Менің көңілім қалған болуы керек➡
Dialogue: 0,0:13:50.36,0:13:55.13,Default,,0,0,0,,Оның керемет мінез-құлқы бар сияқты, ол мені мүлде сездірмейтін. ➡
Dialogue: 0,0:13:55.13,0:13:57.07,Default,,0,0,0,,Анн?
Dialogue: 0,0:13:57.07,0:13:59.13,Default,,0,0,0,,Сіз романстың иісін сезе аласыз ба?
Dialogue: 0,0:13:59.13,0:14:01.77,Default,,0,0,0,,Міне...
Dialogue: 0,0:14:01.77,0:14:04.24,Default,,0,0,0,,♬～
Dialogue: 0,0:14:04.24,0:14:06.31,Default,,0,0,0,,Хмм…. (айқай)
Dialogue: 0,0:14:06.31,0:14:08.31,Default,,0,0,0,,(айқай)
Dialogue: 0,0:14:12.38,0:14:15.28,Default,,0,0,0,,(жүрек соғу дыбысы)
Dialogue: 0,0:14:15.28,0:14:17.79,Default,,0,0,0,,Энн Бұл сыйлық.
Dialogue: 0,0:14:19.92,0:14:23.69,Default,,0,0,0,,«Көздеріңіз таңғы жұлдыздай.➡
Dialogue: 0,0:14:23.69,0:14:25.93,Default,,0,0,0,,Рой... Гарднер.
Dialogue: 0,0:14:25.93,0:14:28.00,Default,,0,0,0,,Уау….
Dialogue: 0,0:14:28.00,0:14:30.40,Default,,0,0,0,,«Сіздің бетіңіздегі қызару➡
Dialogue: 0,0:14:30.40,0:14:33.30,Default,,0,0,0,,Оны күн шыққаннан ұрлаған болуы керек. ➡
Dialogue: 0,0:14:33.30,0:14:37.17,Default,,0,0,0,,Рой... Гарднер. (Присцилла Стелла) Уау.
Dialogue: 0,0:14:37.17,0:14:39.14,Default,,0,0,0,,«Сіздің ерніңіз➡
Dialogue: 0,0:14:39.14,0:14:41.71,Default,,0,0,0,,Жұмақтың раушан гүлдерінен де қызыл. ➡
Dialogue: 0,0:14:41.71,0:14:44.51,Default,,0,0,0,,Рой... Гарднер.
Dialogue: 0,0:14:44.51,0:14:47.22,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:52.79,0:14:55.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:57.56,0:15:00.36,Default,,0,0,0,,Сұлу ханзада келді!
Dialogue: 0,0:15:00.36,0:15:02.30,Default,,0,0,0,,​​О?
Dialogue: 0,0:15:02.30,0:15:05.20,Default,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:15:05.20,0:15:10.00,Default,,0,0,0,,Он түн болса, тоғызға дейін еш себепсіз жарқырайтын едім➡
Dialogue: 0,0:15:10.00,0:15:11.94,Default,,0,0,0,,Бүгін түнде оныншы➡
Dialogue: 0,0:15:11.94,0:15:14.58,Default,,0,0,0,,Сіз кенет гүлдедіңіз.
Dialogue: 0,0:15:14.58,0:15:17.48,Default,,0,0,0,,Киімге рахмет... Бұл дұрыс емес.
Dialogue: 0,0:15:17.48,0:15:21.35,Default,,0,0,0,,Рой Аннаға әлі ғашық болмаса да➡
Dialogue: 0,0:15:21.35,0:15:24.25,Default,,0,0,0,,Мен бүгін кешке ғашық болатыныма сенімдімін. ➡
Dialogue: 0,0:15:24.25,0:15:26.32,Default,,0,0,0,,Жай... сурет?
Dialogue: 0,0:15:26.32,0:15:28.46,Default,,0,0,0,,Бұл шаш оюы….
Dialogue: 0,0:15:28.46,0:15:30.86,Default,,0,0,0,,Ройдың сыйлығы шығар...➡
Dialogue: 0,0:15:30.86,0:15:34.06,Default,,0,0,0,,Орхидея туралы не айтасыз? ➡
Dialogue: 0,0:15:34.06,0:15:36.06,Default,,0,0,0,,Ренжімеңіз. ➡
Dialogue: 0,0:15:36.06,0:15:39.00,Default,,0,0,0,,Бірақ орхидеялар аздап алғыр...➡
Dialogue: 0,0:15:39.00,0:15:42.37,Default,,0,0,0,,Бұл саған ұқсамайды...
Dialogue: 0,0:15:42.37,0:15:45.11,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:15:45.11,0:15:47.61,Default,,0,0,0,,Мен де солай сезіндім.
Dialogue: 0,0:15:47.61,0:15:51.18,Default,,0,0,0,,Орхидеялардың маған қатысы жоқ.
Dialogue: 0,0:15:51.18,0:15:54.08,Default,,0,0,0,,Бірақ бүгін ерекше күн.
Dialogue: 0,0:15:54.08,0:15:57.95,Default,,0,0,0,,Бұл төртінші курс студенттерін қабылдау кеші.
Dialogue: 0,0:15:57.95,0:16:01.19,Default,,0,0,0,,Қараңыз. Джонас: "Бүгін түнде"➡ деді
Dialogue: 0,0:16:01.19,0:16:04.89,Default,,0,0,0,,Ол маған мына әдемі раушан гүлін әкелді.
Dialogue: 0,0:16:04.89,0:16:06.86,Default,,0,0,0,,Бірақ мен келмеймін.
Dialogue: 0,0:16:06.86,0:16:12.67,Default,,0,0,0,,Маған кедейлер үшін намаз оқуға мұрындық болу керектігін айтты.
Dialogue: 0,0:16:12.67,0:16:14.27,Default,,0,0,0,,Өте жаман...
Dialogue: 0,0:16:14.27,0:16:16.67,Default,,0,0,0,,Мүмкін келгің келмейтін шығар.
Dialogue: 0,0:16:16.67,0:16:19.47,Default,,0,0,0,,Ол... шынымен де Джонс ➡
Dialogue: 0,0:16:19.47,0:16:22.04,Default,,0,0,0,,Мен саған мүлде ұнамайды деп ойлаймын...
Dialogue: 0,0:16:22.04,0:16:24.35,Default,,0,0,0,,Маған раушан гүлдерін сыйласаң да?
Dialogue: 0,0:16:24.35,0:16:28.05,Default,,0,0,0,,Иә. Бірақ мен сен үшін қатты уайымдаймын.
Dialogue: 0,0:16:28.05,0:16:31.39,Default,,0,0,0,,Шаршап өлейін деп жатырсың ба?
Dialogue: 0,0:16:31.39,0:16:33.32,Default,,0,0,0,,Әдебиет мамандығы бойынша білім алу➡
Dialogue: 0,0:16:33.32,0:16:36.06,Default,,0,0,0,,Мүмкін мен ойшыл адам болуым керек шығар...
Dialogue: 0,0:16:36.06,0:16:39.36,Default,,0,0,0,,Өйткені сіз онша ойшыл емес сияқтысыз➡
Dialogue: 0,0:16:39.36,0:16:41.33,Default,,0,0,0,,Неге тозып кетпейсің?
Dialogue: 0,0:16:41.33,0:16:44.07,Default,,0,0,0,,Қорқынышты. Филдің ақымақ.
Dialogue: 0,0:16:44.07,0:16:47.37,Default,,0,0,0,,Блейк мырза сізді қаншалықты жақсы көреді➡
Dialogue: 0,0:16:47.37,0:16:49.34,Default,,0,0,0,,Мен оны жақсы білсем де.
Dialogue: 0,0:16:49.34,0:16:52.67,Default,,0,0,0,,Иә. Бірақ мен оны сөзбен жеткізуіңізді қалаймын.
Dialogue: 0,0:16:52.67,0:16:55.08,Default,,0,0,0,,Сезімтал өлең жазу мүмкін болмаса да.
Dialogue: 0,0:16:55.08,0:16:57.01,Default,,0,0,0,,Блейк мырзаға сенімдімін➡
Dialogue: 0,0:16:57.01,0:16:59.28,Default,,0,0,0,,Мен тартынамын.
Dialogue: 0,0:16:59.28,0:17:01.22,Default,,0,0,0,,Пастор дәулетті емес➡
Dialogue: 0,0:17:01.22,0:17:03.22,Default,,0,0,0,,Сізге сәнді өмір сыйлаңыз➡
Dialogue: 0,0:17:03.22,0:17:06.55,Default,,0,0,0,,Орындауға болмайтын нәрсе.
Dialogue: 0,0:17:06.55,0:17:08.62,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:08.62,0:17:11.13,Default,,0,0,0,,Егер Джонас мұны жасамаса, мен ұсыныс жасаймын!
Dialogue: 0,0:17:11.13,0:17:14.33,Default,,0,0,0,,Иә!? Бар болғаны. Бұл нәтиже беретініне сенімдімін!
Dialogue: 0,0:17:14.33,0:17:16.56,Default,,0,0,0,,Мұқият ойланыңыз➡
Dialogue: 0,0:17:16.56,0:17:19.90,Default,,0,0,0,,Блэйктің сезімін құрметтеңіз.
Dialogue: 0,0:17:19.90,0:17:23.24,Default,,0,0,0,,Гилберттің ұсынысынан бас тартқан кезде➡
Dialogue: 0,0:17:23.24,0:17:25.74,Default,,0,0,0,,Мен қатты ашуландым. ➡
Dialogue: 0,0:17:25.74,0:17:27.98,Default,,0,0,0,,Бірақ мен қателесіппін. ➡
Dialogue: 0,0:17:27.98,0:17:31.85,Default,,0,0,0,,Анн Рой Гарднермен аяқталатын болды. ➡
Dialogue: 0,0:17:31.85,0:17:36.78,Default,,0,0,0,,Мен енді түсіндім. Сіз бәрібір дұрыс болдыңыз.
Dialogue: 0,0:17:36.78,0:17:39.05,Default,,0,0,0,,Қазір ойлап қарасам, соңғы кездері Гилберт➡ болды
Dialogue: 0,0:17:39.05,0:17:42.69,Default,,0,0,0,,Мен Кристин Стюартпен біргемін. Сен білесің бе?
Dialogue: 0,0:17:42.69,0:17:44.63,Default,,0,0,0,,…Жоқ бұл кім?
Dialogue: 0,0:17:44.63,0:17:48.23,Default,,0,0,0,,Осы қыста Кингспортқа музыка оқуға келген бала. ➡
Dialogue: 0,0:17:48.23,0:17:50.16,Default,,0,0,0,,Өте әдемі➡
Dialogue: 0,0:17:50.16,0:17:54.60,Default,,0,0,0,,Оған Гилберттің қатысы бар деген қауесет бар.
Dialogue: 0,0:17:54.60,0:17:56.54,Default,,0,0,0,,Хмм….
Dialogue: 0,0:17:56.54,0:17:59.37,Default,,0,0,0,,Гарднер мырза сияқты жақсы жігіт➡
Dialogue: 0,0:17:59.37,0:18:01.31,Default,,0,0,0,,Мен оны ешқашан көрген емеспін. (Тот басқан)
Dialogue: 0,0:18:01.31,0:18:03.31,Default,,0,0,0,,Жоқ. Олай емес.
Dialogue: 0,0:18:03.31,0:18:06.01,Default,,0,0,0,,Энн өте бақытты қыз. ➡
Dialogue: 0,0:18:06.01,0:18:08.28,Default,,0,0,0,,Гарднер мырзамен танысу.
Dialogue: 0,0:18:08.28,0:18:09.88,Default,,0,0,0,,Иә? Энн! ➡
Dialogue: 0,0:18:09.88,0:18:11.92,Default,,0,0,0,,Бүгінгі түн де өте әдемі.
Dialogue: 0,0:18:11.92,0:18:14.32,Default,,0,0,0,,Рахмет….
Dialogue: 0,0:18:14.32,0:18:18.03,Default,,0,0,0,,Шаш әшекейі де сізге жарасады.
Dialogue: 0,0:18:18.03,0:18:24.93,Default,,0,0,0,,♬～
Dialogue: 0,0:18:24.93,0:18:27.07,Default,,0,0,0,,Анн. а….
Dialogue: 0,0:18:27.07,0:18:29.00,Default,,0,0,0,,Әлі уақыт бар.
Dialogue: 0,0:18:29.00,0:18:31.41,Default,,0,0,0,,Кішкене айналма жолмен жүргіңіз келе ме?
Dialogue: 0,0:18:35.21,0:18:37.88,Default,,0,0,0,,Біз осы жерде кездестік.
Dialogue: 0,0:18:37.88,0:18:43.82,Default,,0,0,0,,Иә. Бұл өте жаңбырлы және желді болды. Бірақ бүгін ауа райы жақсы.
Dialogue: 0,0:18:43.82,0:18:47.49,Default,,0,0,0,,Мен Аннамен сол күні кездесе алдым➡
Dialogue: 0,0:18:47.49,0:18:50.39,Default,,0,0,0,,Бұл менің өмірімдегі ең жақсы оқиға болды.
Dialogue: 0,0:18:50.39,0:18:53.10,Default,,0,0,0,,Мен де, Рой.
Dialogue: 0,0:18:53.10,0:18:57.87,Default,,0,0,0,,Энн: Мен сізбен бір нәрсе туралы сөйлескім келеді. сурет?
Dialogue: 0,0:18:57.87,0:19:00.20,Default,,0,0,0,,Мен сені жақсы көремін. ➡
Dialogue: 0,0:19:00.20,0:19:03.74,Default,,0,0,0,,Мен саған жындымын.
Dialogue: 0,0:19:03.74,0:19:06.64,Default,,0,0,0,,Мен енді өз өмірімді Эннсіз елестете алмаймын.
Dialogue: 0,0:19:06.64,0:19:08.61,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:08.61,0:19:11.31,Default,,0,0,0,,Сен менің... ғашығым боласың ба?
Dialogue: 0,0:19:11.31,0:19:13.85,Default,,0,0,0,,А...?
Dialogue: 0,0:19:13.85,0:19:23.32,Default,,0,0,0,,♬～
Dialogue: 0,0:19:23.32,0:19:25.83,Default,,0,0,0,,Анна…. ➡
Dialogue: 0,0:19:25.83,0:19:28.33,Default,,0,0,0,,Анн?
Dialogue: 0,0:19:28.33,0:19:31.23,Default,,0,0,0,,Кешіріңіз... Сіз таң қалдыңыз ба?
Dialogue: 0,0:19:31.23,0:19:34.07,Default,,0,0,0,,Кішкене... Сонымен...
Dialogue: 0,0:19:34.07,0:19:37.47,Default,,0,0,0,,Иә... мен де...
Dialogue: 0,0:19:40.57,0:19:44.45,Default,,0,0,0,,<Мені енді армандарымның ханзадасы мойындады. ➡
Dialogue: 0,0:19:44.45,0:19:48.12,Default,,0,0,0,,Күшті мойындау... ➡
Dialogue: 0,0:19:48.12,0:19:51.79,Default,,0,0,0,,Бұл күн үшін үлкен баға төледі➡
Dialogue: 0,0:19:51.79,0:19:56.29,Default,,0,0,0,,Менің арманымдағы ханзаданың көптен күткен махаббатын мойындауы. ➡
Dialogue: 0,0:19:56.29,0:19:58.23,Default,,0,0,0,,Егер Ягер фракциясы осы аралды жұлын сұйықтығын пайдаланып билесе…➡
Dialogue: 0,0:19:58.23,0:20:00.59,Default,,0,0,0,,Менің бетім қызармады. ➡
Dialogue: 0,0:20:00.59,0:20:04.10,Default,,0,0,0,,Көз жасы тасымады...＞
Dialogue: 0,0:20:10.14,0:20:12.71,Default,,0,0,0,,Көңілді сияқты. Иә, дұрыс.
Dialogue: 0,0:20:12.71,0:20:14.64,Default,,0,0,0,,Иә. Хехе.
Dialogue: 0,0:20:14.64,0:20:16.58,Default,,0,0,0,,Ах…. (Гилберт Блайт) Сіз өткен күні концертке бардыңыз, солай ма?
Dialogue: 0,0:20:16.58,0:20:18.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:18.58,0:20:22.08,Default,,0,0,0,,Қалай болды? Бұл таңқаларлық болды.
Dialogue: 0,0:20:26.39,0:20:29.49,Default,,0,0,0,,Мен бір сәт дәретханаға барамын.
Dialogue: 0,0:20:29.49,0:20:32.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:32.39,0:20:34.33,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:20:34.33,0:20:38.27,Default,,0,0,0,,Сіз немен айналысасыз? ...Ах.
Dialogue: 0,0:20:38.27,0:20:41.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:45.41,0:20:47.34,Default,,0,0,0,,Энн! Мінеки.
Dialogue: 0,0:20:47.34,0:20:49.64,Default,,0,0,0,,Иә... Күткеніңізге рахмет.
Dialogue: 0,0:20:49.64,0:20:58.99,Default,,0,0,0,,♬～
Dialogue: 0,0:20:58.99,0:21:01.96,Default,,0,0,0,,Сәлем Анна. Қалдарыңыз қалай?
Dialogue: 0,0:21:01.96,0:21:06.09,Default,,0,0,0,,А... Иә, біраз болды.
Dialogue: 0,0:21:06.09,0:21:08.66,Default,,0,0,0,,Рой бізді тапты➡
Dialogue: 0,0:21:08.66,0:21:11.27,Default,,0,0,0,,Сәлем беру үшін жол бойы келді.
Dialogue: 0,0:21:11.27,0:21:14.14,Default,,0,0,0,,Мен сендерді бала кезден дос болған деп естідім.
Dialogue: 0,0:21:14.14,0:21:16.37,Default,,0,0,0,,А, мен сені таныстырамын.
Dialogue: 0,0:21:16.37,0:21:18.31,Default,,0,0,0,,Кристин Стюарт.
Dialogue: 0,0:21:18.31,0:21:20.67,Default,,0,0,0,,Ол болашақ музыкант.
Dialogue: 0,0:21:20.67,0:21:22.61,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:21:22.61,0:21:25.48,Default,,0,0,0,,Менің атым Энн Ширли. Балалық дос деген не?
Dialogue: 0,0:21:25.48,0:21:27.41,Default,,0,0,0,,Жүрек үні Бұл бала...➡
Dialogue: 0,0:21:27.41,0:21:30.32,Default,,0,0,0,,Мен әрқашан үміт еткендей көрінесің. ➡
Dialogue: 0,0:21:30.32,0:21:32.39,Default,,0,0,0,,Беттері раушан гүлдей➡
Dialogue: 0,0:21:32.39,0:21:34.52,Default,,0,0,0,,Жұлдыз тәрізді күлгін көздер➡
Dialogue: 0,0:21:34.52,0:21:36.49,Default,,0,0,0,,Қара шаш...
Dialogue: 0,0:21:36.49,0:21:39.16,Default,,0,0,0,,Иә, Анн. а….
Dialogue: 0,0:21:39.16,0:21:43.03,Default,,0,0,0,,Келесі жолы маған Avonlea-ны көрсете аласыз ба?
Dialogue: 0,0:21:43.03,0:21:45.93,Default,,0,0,0,,Қарсы болмасаң, Гилберт, менімен бара аласың.
Dialogue: 0,0:21:45.93,0:21:49.30,Default,,0,0,0,,Ах…. О, әрине Рой.
Dialogue: 0,0:21:49.30,0:21:51.24,Default,,0,0,0,,Сосын мен де➡
Dialogue: 0,0:21:51.24,0:21:55.01,Default,,0,0,0,,Мен де оны көргім келеді, Гил. Бұл жақсы ма? Анн.
Dialogue: 0,0:21:55.01,0:21:58.95,Default,,0,0,0,,Иә, әрине, Кристин.
Dialogue: 0,0:21:58.95,0:22:00.92,Default,,0,0,0,,Жүрек үні Бірақ...➡
Dialogue: 0,0:22:00.92,0:22:05.25,Default,,0,0,0,,Менің мұрын пішінім жақсырақ сияқты.
Dialogue: 0,0:22:05.25,0:22:14.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:14.93,0:22:17.80,Default,,0,0,0,,♬ «Не маңызды?»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таң жарқыраған таңға»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние менің қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны дұрыстап тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Сіздің сезінгеніңіз – бәрі».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
