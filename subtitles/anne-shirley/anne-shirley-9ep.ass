Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:05.23,Default,,0,0,0,,<Мен Queen Academy емтиханын тапсырдым➡
Dialogue: 0,0:00:05.23,0:00:11.27,Default,,0,0,0,,Мен бұл ауылдан күзде жоғары оқу орнына түсемін>
Dialogue: 0,0:00:11.27,0:00:13.71,Default,,0,0,0,,Күн сайын хат жазыңыз.
Dialogue: 0,0:00:13.71,0:00:18.08,Default,,0,0,0,,Мен сені енді ешқашан көрмейтін сияқтымын. Бірақ мен көп жазамын.
Dialogue: 0,0:00:18.08,0:00:20.42,Default,,0,0,0,,Денеңізді күтіңіз.
Dialogue: 0,0:00:20.42,0:00:23.52,Default,,0,0,0,,Иә. Мен демалыс күні қайтамын.
Dialogue: 0,0:00:26.99,0:00:29.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:29.22,0:00:31.23,Default,,0,0,0,,Аха!
Dialogue: 0,0:00:38.53,0:01:28.38,Default,,0,0,0,,♬～
Dialogue: 0,0:01:28.38,0:01:31.82,Default,,0,0,0,,Спенсердің әйелі➡
Dialogue: 0,0:01:31.82,0:01:35.09,Default,,0,0,0,,Қате жібергеніңіз үшін рахмет.
Dialogue: 0,0:01:35.09,0:01:37.49,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:01:37.49,0:01:41.36,Default,,0,0,0,,Бұл Құдайдың шақыруы екеніне сенімдімін. ➡
Dialogue: 0,0:01:41.36,0:01:48.37,Default,,0,0,0,,Құдай бізге сол баланың керек екенін білді.
Dialogue: 0,0:01:50.17,0:01:59.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.41,0:02:04.02,Default,,0,0,0,,♬ «Мен болашақты оқи алмайтыныма қуаныштымын».
Dialogue: 0,0:02:04.02,0:02:06.56,Default,,0,0,0,,♬ «Мүмкін болса да, мүмкін болмаса да»
Dialogue: 0,0:02:06.56,0:02:08.49,Default,,0,0,0,,♬ «Сіз қалағаныңызды жаза аласыз».
Dialogue: 0,0:02:08.49,0:02:12.36,Default,,0,0,0,,♬ «Ойыңызды оқи алмағаныма қуаныштымын».
Dialogue: 0,0:02:12.36,0:02:14.70,Default,,0,0,0,,♬ «Бір тыныс»
Dialogue: 0,0:02:14.70,0:02:16.93,Default,,0,0,0,,♬ «Мен сені сүйетінімді түсінемін».
Dialogue: 0,0:02:16.93,0:02:21.47,Default,,0,0,0,,♬ «Әңгімеші шөп те, бұлттар да».
Dialogue: 0,0:02:21.47,0:02:26.68,Default,,0,0,0,,♬ «Мен не үшін дүниеге келгенімді білмеймін».
Dialogue: 0,0:02:26.68,0:02:28.61,Default,,0,0,0,,♬ «Мені үйретті».
Dialogue: 0,0:02:28.61,0:02:32.48,Default,,0,0,0,,♬ «Дүние қызық нәрсе»
Dialogue: 0,0:02:32.48,0:02:35.88,Default,,0,0,0,,♬ «Алда әлі көп.»
Dialogue: 0,0:02:35.88,0:02:38.32,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:38.32,0:02:40.59,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:40.59,0:02:44.83,Default,,0,0,0,,♬ «Юме ұялшақ және жасырынбақшы».
Dialogue: 0,0:02:44.83,0:02:47.30,Default,,0,0,0,,♬ «Мен көзімді жұмып жатырмын».
Dialogue: 0,0:02:47.30,0:02:49.63,Default,,0,0,0,,♬ «Әлі емес пе?»
Dialogue: 0,0:02:49.63,0:02:53.10,Default,,0,0,0,,♬ «Себебі мен де сенімен кездескім келеді».
Dialogue: 0,0:02:53.10,0:02:56.41,Default,,0,0,0,,♬ «Мен осында күтемін».
Dialogue: 0,0:02:56.41,0:02:58.64,Default,,0,0,0,,♬ «Эй, мен күтемін».
Dialogue: 0,0:02:58.64,0:03:02.84,Default,,0,0,0,,♬ «Көңілді нәрселердің кез келген саны»
Dialogue: 0,0:03:02.84,0:03:05.35,Default,,0,0,0,,♬ «Мен санауды күтемін».
Dialogue: 0,0:03:05.35,0:03:07.65,Default,,0,0,0,,♬ «Сен күнсің»
Dialogue: 0,0:03:07.65,0:03:09.65,Default,,0,0,0,,♬ «Мен сені алып кетемін».
Dialogue: 0,0:03:09.65,0:03:14.02,Default,,0,0,0,,♬ «Менде әрқашан осындай сезім болған».
Dialogue: 0,0:03:14.02,0:03:17.93,Default,,0,0,0,,♬～
Dialogue: 0,0:03:20.70,0:03:25.30,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.30,0:03:37.51,Default,,0,0,0,,♬～
Dialogue: 0,0:03:37.51,0:03:39.45,Default,,0,0,0,,Анна керемет. ➡
Dialogue: 0,0:03:39.45,0:03:43.32,Default,,0,0,0,,Мен бір жылда 1-деңгейдегі оқытушы лицензиясын алуға мүмкіндік беретін курсты таңдағаныма сенбеймін.
Dialogue: 0,0:03:43.32,0:03:47.59,Default,,0,0,0,,Біз бір жылда 2-деңгей лицензиясын алу курсындамыз.
Dialogue: 0,0:03:47.59,0:03:51.13,Default,,0,0,0,,Бірінші сыныпты алу үшін әдетте екі жыл қажет.
Dialogue: 0,0:03:51.13,0:03:54.53,Default,,0,0,0,,Себебі оны маған доктор Стейси ұсынды.
Dialogue: 0,0:03:54.53,0:03:57.83,Default,,0,0,0,,Жарайды, мен бар күшімді саламын.
Dialogue: 0,0:03:57.83,0:04:00.44,Default,,0,0,0,,Гилберт бір сыныпта оқиды, солай ма?
Dialogue: 0,0:04:00.44,0:04:02.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.37,0:04:06.07,Default,,0,0,0,,Неге өткенді ұмытпай, дос болуға тырыспайсың?
Dialogue: 0,0:04:10.15,0:04:13.12,Default,,0,0,0,,Менің ойымша, Энн тым қыңыр. ➡
Dialogue: 0,0:04:13.12,0:04:16.35,Default,,0,0,0,,Гилберт сіздің сыныпта сіз білетін жалғыз адам, солай ма?
Dialogue: 0,0:04:16.35,0:04:18.79,Default,,0,0,0,,Ах, Гилберт! Ах...
Dialogue: 0,0:04:18.79,0:04:21.29,Default,,0,0,0,,Аха!
Dialogue: 0,0:04:21.29,0:04:25.66,Default,,0,0,0,,Қайырлы таң! Жаңа мектебіңізге сәттілік тілейміз.
Dialogue: 0,0:04:25.66,0:04:27.63,Default,,0,0,0,,О!
Dialogue: 0,0:04:27.63,0:04:30.57,Default,,0,0,0,,Ах, Гилберт, сен бүгін де сол көйлекпен жақсы көрінесің!
Dialogue: 0,0:04:30.57,0:04:32.87,Default,,0,0,0,,Ах, рахмет.
Dialogue: 0,0:04:32.87,0:04:35.77,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:04:35.77,0:04:38.61,Default,,0,0,0,,♬～
Dialogue: 0,0:04:38.61,0:04:40.54,Default,,0,0,0,,«Құрметті Диана.➡
Dialogue: 0,0:04:40.54,0:04:44.01,Default,,0,0,0,,Мен дәл қазір өзімді жалғыз сезінемін. ➡
Dialogue: 0,0:04:44.01,0:04:46.95,Default,,0,0,0,,Өйткені менің айналамда бейтаныс тұлғалар өте көп. ➡
Dialogue: 0,0:04:46.95,0:04:49.72,Default,,0,0,0,,Ах, егер Джейн мен Руби бірге болса➡
Dialogue: 0,0:04:49.72,0:04:51.75,Default,,0,0,0,,Мен мына басқа шатырға бардым➡
Dialogue: 0,0:04:51.75,0:04:54.66,Default,,0,0,0,,Сіз өзіңізді мысық сезінбеген шығарсыз. ➡
Dialogue: 0,0:04:54.66,0:04:58.49,Default,,0,0,0,,Мен осы адамдардың ішінде кіммен дос бола аламын деп ойлаймын. ➡
Dialogue: 0,0:04:58.49,0:05:03.40,Default,,0,0,0,,Ашық қызыл блузка киген қызыл көзді адамның сезімі➡
Dialogue: 0,0:05:03.40,0:05:06.17,Default,,0,0,0,,Бұл өте жанды, маған ұнайды. ➡
Dialogue: 0,0:05:06.17,0:05:11.44,Default,,0,0,0,,Сондай-ақ, мен ақшыл терісі мен әдемі шашы бар адамды қалаймын. ➡
Dialogue: 0,0:05:11.44,0:05:13.91,Default,,0,0,0,,Сіз армандау дегенді білетін сияқтысыз».
Dialogue: 0,0:05:13.91,0:05:15.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.91,0:05:19.71,Default,,0,0,0,,``Бірақ әзірге ол адамдарды танымаймын➡
Dialogue: 0,0:05:19.71,0:05:22.25,Default,,0,0,0,,Қарсы жақ та дос болғысы келеді➡
Dialogue: 0,0:05:22.25,0:05:25.15,Default,,0,0,0,,Мүмкін сіз олай ойламайтын шығарсыз.''
Dialogue: 0,0:05:25.15,0:05:28.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.02,0:05:31.23,Default,,0,0,0,,«Гилберт бекінген сияқты.➡
Dialogue: 0,0:05:31.23,0:05:34.60,Default,,0,0,0,,Мен оның медаль алатынына сенімдімін. ➡
Dialogue: 0,0:05:34.60,0:05:39.10,Default,,0,0,0,,Енді мен кем дегенде бір таныс жүзім барына ризамын. ➡
Dialogue: 0,0:05:39.10,0:05:41.90,Default,,0,0,0,,Тіпті бұл Гилберт болса да».
Dialogue: 0,0:05:41.90,0:05:48.51,Default,,0,0,0,,♬～
Dialogue: 0,0:05:48.51,0:05:52.08,Default,,0,0,0,,«Мен өз интернат үйімде осылай хат жазып отыр едім➡
Dialogue: 0,0:05:52.08,0:05:54.12,Default,,0,0,0,,Мен өзімді жалғыз сезінемін. ➡
Dialogue: 0,0:05:54.12,0:05:56.62,Default,,0,0,0,,Бірақ мен жыламаймын. ➡
Dialogue: 0,0:05:56.62,0:06:00.22,Default,,0,0,0,,Бұл өте ақымақтық».
Dialogue: 0,0:06:01.82,0:06:04.36,Default,,0,0,0,,«Мен өтірік айттым.➡
Dialogue: 0,0:06:04.36,0:06:08.20,Default,,0,0,0,,Үшінші көз жасы енді ғана төгілді. ➡
Dialogue: 0,0:06:08.20,0:06:10.23,Default,,0,0,0,,Біртүрлі нәрсе туралы ойлау➡
Dialogue: 0,0:06:10.23,0:06:12.53,Default,,0,0,0,,Оны тоқтату керек. ➡
Dialogue: 0,0:06:12.53,0:06:15.87,Default,,0,0,0,,Бірақ менің ойыма тек Авонлеа ғана келеді. ➡
Dialogue: 0,0:06:15.87,0:06:19.74,Default,,0,0,0,,А... Матай үйге келді. ➡
Dialogue: 0,0:06:19.74,0:06:22.38,Default,,0,0,0,,Марилла есік алдында күтіп тұр.
Dialogue: 0,0:06:22.38,0:06:27.08,Default,,0,0,0,,«6 дән, 7 дән... Енді санаудың қажеті жоқ.➡
Dialogue: 0,0:06:27.08,0:06:31.39,Default,,0,0,0,,Бірден толып жатқандай көрінетін нәрсе. Мен ешқашан жазылмаймын деп ойлаймын. ➡
Dialogue: 0,0:06:31.39,0:06:34.69,Default,,0,0,0,,Мұңайған дұрыс...'' (Жылап)
Dialogue: 0,0:06:34.69,0:06:36.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:36.63,0:06:39.16,Default,,0,0,0,,Күткендей~ Мен жылап жатырмын.
Dialogue: 0,0:06:39.16,0:06:43.03,Default,,0,0,0,,Не…. (Джози) Үйді сағынуға әлі ерте емес пе?
Dialogue: 0,0:06:43.03,0:06:45.37,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:06:45.37,0:06:47.97,Default,,0,0,0,,Бірақ сенің келгеніңе қуаныштымын.
Dialogue: 0,0:06:47.97,0:06:52.24,Default,,0,0,0,,Таныс жүзді көру ғана жеңілдеп қалуы мүмкін.
Dialogue: 0,0:06:52.24,0:06:57.18,Default,,0,0,0,,Мен қызықсыз Avonlea-дан шыққаныма өте қуаныштымын.
Dialogue: 0,0:06:57.18,0:07:00.02,Default,,0,0,0,,Сізде жейтін нәрсе бар ма? ➡
Dialogue: 0,0:07:00.02,0:07:06.32,Default,,0,0,0,,Менің қарным ашты. Марилла сізге көптеген тәттілер әкелді, солай ма?
Dialogue: 0,0:07:08.99,0:07:12.86,Default,,0,0,0,,Не, бұл өте кішкентай.
Dialogue: 0,0:07:12.86,0:07:15.56,Default,,0,0,0,,Дәмі ауыл сияқты.
Dialogue: 0,0:07:17.70,0:07:22.54,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:07:22.54,0:07:27.74,Default,,0,0,0,,Айтпақшы, Queen Academy Avery стипендиясын да ұсынады.
Dialogue: 0,0:07:27.74,0:07:30.28,Default,,0,0,0,,Бұл рас!? Иә.
Dialogue: 0,0:07:30.28,0:07:33.68,Default,,0,0,0,,Ресми хабарландыру келесі күні шығарылатын сияқты.
Dialogue: 0,0:07:35.25,0:07:38.95,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:07:40.92,0:07:43.83,Default,,0,0,0,,Ағылшын тілі әдебиетінен ең жоғары баға алсаңыз➡
Dialogue: 0,0:07:43.83,0:07:48.56,Default,,0,0,0,,Сіз Редмонд университетіне шәкіртақы ала аласыз.
Dialogue: 0,0:07:48.56,0:07:52.80,Default,,0,0,0,,4 жыл бойына жылына $250.
Dialogue: 0,0:07:52.80,0:07:57.47,Default,,0,0,0,,Егер мен Avery стипендиясын алып, колледжге түсе алсам➡
Dialogue: 0,0:07:57.47,0:08:00.21,Default,,0,0,0,,Матай қаншалықты бақытты болар екен деп ойлаймын.
Dialogue: 0,0:08:00.21,0:08:03.75,Default,,0,0,0,,Ағылшын әдебиетін жақсы меңгергеніңіз рас, бірақ...
Dialogue: 0,0:08:03.75,0:08:05.71,Default,,0,0,0,,Ха! Сіз мені нысанаға алуды жоспарлап отырсыз ба?
Dialogue: 0,0:08:05.71,0:08:08.32,Default,,0,0,0,,Қатты оқу➡
Dialogue: 0,0:08:08.32,0:08:11.72,Default,,0,0,0,,Алсам, міндетті түрде аламын.
Dialogue: 0,0:08:11.72,0:08:13.66,Default,,0,0,0,,Хехехе…. Ах...
Dialogue: 0,0:08:13.66,0:08:17.59,Default,,0,0,0,,А, амбицияға ие болу қызық!
Dialogue: 0,0:08:17.59,0:08:20.43,Default,,0,0,0,,Мен бір амбицияға жеттім деп ойлаған кезде➡
Dialogue: 0,0:08:20.43,0:08:22.43,Default,,0,0,0,,Тағы біреуі➡
Dialogue: 0,0:08:22.43,0:08:26.63,Default,,0,0,0,,Ол биікте жарқырап тұр!
Dialogue: 0,0:08:28.30,0:08:32.44,Default,,0,0,0,,(боранның дыбысы)
Dialogue: 0,0:08:32.44,0:08:34.38,Default,,0,0,0,,«Құрметті Диана.➡
Dialogue: 0,0:08:34.38,0:08:38.31,Default,,0,0,0,,Менің сыныбымның барлығы ақылды және қиялшыл➡
Dialogue: 0,0:08:38.31,0:08:40.68,Default,,0,0,0,,Ең бастысы, мен өршілмін. ➡
Dialogue: 0,0:08:40.68,0:08:44.02,Default,,0,0,0,,Әсіресе Стелла, қызғылт бетті қыз➡
Dialogue: 0,0:08:44.02,0:08:47.29,Default,,0,0,0,,Ол өз сыныбында ең сұлу қыз саналды➡
Dialogue: 0,0:08:47.29,0:08:50.06,Default,,0,0,0,,Прискила - арманшыл қыз➡
Dialogue: 0,0:08:50.06,0:08:52.96,Default,,0,0,0,,Ол бұзақылыққа толы.'' Хехе.
Dialogue: 0,0:08:52.96,0:08:54.90,Default,,0,0,0,,Алтын медальға үміткерлер➡
Dialogue: 0,0:08:54.90,0:08:59.50,Default,,0,0,0,,Мен оны Энн, Гилберт және Льюиске дейін қысқарттым.
Dialogue: 0,0:08:59.50,0:09:02.40,Default,,0,0,0,,Энн де Авериді көздеп отыр, солай ма?
Dialogue: 0,0:09:02.40,0:09:05.64,Default,,0,0,0,,Мұнда бәсекелестер өте көп.
Dialogue: 0,0:09:05.64,0:09:08.31,Default,,0,0,0,,Менің бәрібір істеуден басқа амалым жоқ.
Dialogue: 0,0:09:08.31,0:09:12.81,Default,,0,0,0,,Аа, мұғалімдік лицензия алу қаншалықты қиын?
Dialogue: 0,0:09:12.81,0:09:18.02,Default,,0,0,0,,Әзірше, бар күшімізді салып, Рождествода үйге қайтуды асыға күтейік!
Dialogue: 0,0:09:18.02,0:09:20.56,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:09:20.56,0:09:22.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:22.82,0:09:24.76,Default,,0,0,0,,Диана!
Dialogue: 0,0:09:24.76,0:09:26.76,Default,,0,0,0,,Аха!
Dialogue: 0,0:09:26.76,0:09:31.43,Default,,0,0,0,,Рождество мерекесімен Анна! Рождество мерекесімен Диана!
Dialogue: 0,0:09:31.43,0:09:36.57,Default,,0,0,0,,Мен мұны қайталап жатырмын. Біз апта сайын кездесеміз.
Dialogue: 0,0:09:36.57,0:09:40.44,Default,,0,0,0,,Диананың түрін көргеніме өте қуаныштымын!
Dialogue: 0,0:09:40.44,0:09:45.85,Default,,0,0,0,,Мен Аннаға Стелла мен Прискиланы көбірек ұнатады деп ойладым. а….
Dialogue: 0,0:09:45.85,0:09:50.02,Default,,0,0,0,,Стелла мен Присцилла тамаша адамдар.
Dialogue: 0,0:09:50.02,0:09:53.22,Default,,0,0,0,,Бірақ мен үшін ең маңыздысы➡
Dialogue: 0,0:09:53.22,0:09:55.92,Default,,0,0,0,,Диана Бұл тек сенсің.
Dialogue: 0,0:09:55.92,0:10:00.20,Default,,0,0,0,,Бұл бұрынғыдан да маңыздырақ.
Dialogue: 0,0:10:00.20,0:10:17.48,Default,,0,0,0,,♬～
Dialogue: 0,0:10:17.48,0:10:29.39,Default,,0,0,0,,♬～
Dialogue: 0,0:10:29.39,0:10:31.33,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:10:31.33,0:10:35.90,Default,,0,0,0,,Менің ойымша, пойыз жақында келеді. Күн суық, алдымен үйге қайт.
Dialogue: 0,0:10:35.90,0:10:38.80,Default,,0,0,0,,Хмм…. Жүр, тезірек.
Dialogue: 0,0:10:38.80,0:10:43.04,Default,,0,0,0,,Рождествоны сізбен бірге өткізу қызықты болды.
Dialogue: 0,0:10:43.04,0:10:45.94,Default,,0,0,0,,Мен сені келесі жолы көктемде көремін.
Dialogue: 0,0:10:45.94,0:10:51.85,Default,,0,0,0,,Денеңізді күтіңіз... Матайды да жылытыңыз.
Dialogue: 0,0:11:09.80,0:11:12.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.38,0:11:26.71,Default,,0,0,0,,Рождестволық мерекелер өте тез өтеді...
Dialogue: 0,0:11:26.71,0:11:32.12,Default,,0,0,0,,Сынақ біткенше үйге бара алмайсың.
Dialogue: 0,0:11:32.12,0:11:34.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:34.16,0:11:38.83,Default,,0,0,0,,Олай болса менде мұны істеуден басқа амал жоқ. Иә.
Dialogue: 0,0:11:38.83,0:11:41.73,Default,,0,0,0,,Мен жеңілмеймін.
Dialogue: 0,0:11:41.73,0:11:44.20,Default,,0,0,0,,Мен де.
Dialogue: 0,0:11:44.20,0:11:47.80,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:11:56.78,0:12:01.62,Default,,0,0,0,,♬～
Dialogue: 0,0:12:01.62,0:12:06.25,Default,,0,0,0,,Сенгісіз! Емтихан келесі аптада...
Dialogue: 0,0:12:06.25,0:12:10.66,Default,,0,0,0,,Көп ақша жұмсап, мұғалімдік лицензия ала алмасаңыз ше?➡
Dialogue: 0,0:12:10.66,0:12:12.59,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:12.59,0:12:15.23,Default,,0,0,0,,Мен сәтсіздікке ұшырасам да, келесі жылы қайтамын.
Dialogue: 0,0:12:15.23,0:12:19.93,Default,,0,0,0,,Иә? Дұрыс Анна. Профессор осылай деді.
Dialogue: 0,0:12:19.93,0:12:21.90,Default,,0,0,0,,Гилберт алтын жеңіп алды➡
Dialogue: 0,0:12:21.90,0:12:25.27,Default,,0,0,0,,Мен Эмилидің шәкіртақы алатынына сенімдімін.
Dialogue: 0,0:12:25.27,0:12:27.21,Default,,0,0,0,,Сәлем Джози!
Dialogue: 0,0:12:27.21,0:12:32.61,Default,,0,0,0,,Хехехе, оны естіген соң ертең басым ауыратынына сенімдімін.
Dialogue: 0,0:12:32.61,0:12:34.55,Default,,0,0,0,,Бірақ қазірше➡
Dialogue: 0,0:12:34.55,0:12:38.39,Default,,0,0,0,,Жасыл Гейблдің ойпаңында шегіргүлдер гүлдегенше➡
Dialogue: 0,0:12:38.39,0:12:43.12,Default,,0,0,0,,Кішкентай папоротник «ғашықтың жолына» көз салғанша➡
Dialogue: 0,0:12:43.12,0:12:46.93,Default,,0,0,0,,Стипендияны кім алатыны маған бәрібір.
Dialogue: 0,0:12:46.93,0:12:49.83,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:12:49.83,0:12:52.27,Default,,0,0,0,,Анна, әрине, қолынан келгеннің бәрін жасады.
Dialogue: 0,0:12:52.27,0:12:56.50,Default,,0,0,0,,Енді емтихан туралы әңгімені доғарайық. Бұл дұрыс.
Dialogue: 0,0:12:56.50,0:13:01.98,Default,,0,0,0,,Болашақта өзіңізді елестетіп көргеніңіз дұрыс.
Dialogue: 0,0:13:01.98,0:13:03.98,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:03.98,0:13:12.05,Default,,0,0,0,,♬～
Dialogue: 0,0:13:12.05,0:13:16.92,Default,,0,0,0,,«Қымбаттым, қымбатты Диана, менде бүгін қуанышты жаңалық бар.➡
Dialogue: 0,0:13:16.92,0:13:20.70,Default,,0,0,0,,Джейн және оның достары емтиханды сәтті тапсырды. ➡
Dialogue: 0,0:13:20.70,0:13:26.50,Default,,0,0,0,,Руби мектеп бітіру рәсіміне киетін көйлек таңдауға бірден әуестенеді. ➡
Dialogue: 0,0:13:26.50,0:13:30.81,Default,,0,0,0,,Гилберт екеуміз тапсырған 1-деңгей емтиханының нәтижелері келесі аптада шығады. ➡
Dialogue: 0,0:13:30.81,0:13:35.58,Default,,0,0,0,,Нәтижесі қандай болса да, мен хабарландыруды қабылдаймын. ➡
Dialogue: 0,0:13:35.58,0:13:40.18,Default,,0,0,0,,Соңғы кездері мен ``еңбек қуанышы'' не екенін түсіне бастадым. ➡
Dialogue: 0,0:13:40.18,0:13:44.49,Default,,0,0,0,,Тынбай еңбек ету және жеңіске жету үшін келесі ең жақсы нәрсе - ➡
Dialogue: 0,0:13:44.49,0:13:48.59,Default,,0,0,0,,Қатты тырысыңыз және жеңіліңіз».
Dialogue: 0,0:13:50.29,0:13:55.30,Default,,0,0,0,,♬～
Dialogue: 0,0:13:57.73,0:14:01.07,Default,,0,0,0,,Соңында 1-деңгей емтиханының нәтижелері жарияланды.
Dialogue: 0,0:14:01.07,0:14:06.47,Default,,0,0,0,,Жарайды. Энн алтын медальді немесе Авериді ала алады.
Dialogue: 0,0:14:06.47,0:14:08.44,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:14:08.44,0:14:12.11,Default,,0,0,0,,Барлығы: ''Эмили Эйвери алады'' дейді...
Dialogue: 0,0:14:12.11,0:14:14.65,Default,,0,0,0,,Бұндай қауесеттер маңызды емес.
Dialogue: 0,0:14:14.65,0:14:16.72,Default,,0,0,0,,Сәлем Джейн.
Dialogue: 0,0:14:16.72,0:14:20.02,Default,,0,0,0,,Көңілім түссе, жұбатпа.
Dialogue: 0,0:14:20.02,0:14:22.96,Default,,0,0,0,,Ұзақ достығымыз үшін.
Dialogue: 0,0:14:22.96,0:14:24.96,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:14:24.96,0:14:27.56,Default,,0,0,0,,Сәттілік! Ура! а….
Dialogue: 0,0:14:27.56,0:14:29.63,Default,,0,0,0,,Гилберт аман болсын!
Dialogue: 0,0:14:29.63,0:14:34.20,Default,,0,0,0,,Алтын медаль иегері Гилберт Блайт! (Оқушылар) Жарайсыңдар!
Dialogue: 0,0:14:34.20,0:14:36.77,Default,,0,0,0,,Рахмет! (Оқушылар) Жарайсыңдар! Ура!
Dialogue: 0,0:14:36.77,0:14:41.08,Default,,0,0,0,,Энн осында болыңыз. Мен оны қараймын.
Dialogue: 0,0:14:41.08,0:14:43.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:43.01,0:14:46.48,Default,,0,0,0,,Жүрек үні Ах... Матай мұңаяды... ➡
Dialogue: 0,0:14:46.48,0:14:49.88,Default,,0,0,0,,Себебі сен мені жеңемін деп ойладың...
Dialogue: 0,0:14:49.88,0:14:53.39,Default,,0,0,0,,Ах...! Аха! Энн Ширли Сәттілік! ➡
Dialogue: 0,0:14:53.39,0:14:58.23,Default,,0,0,0,,Avery сыйлығының иегері Энн Ширли Жасасын ұзақ болсын!
Dialogue: 0,0:14:58.23,0:15:01.20,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:15:01.20,0:15:04.10,Default,,0,0,0,,Энн! болды! Мен жасадым!
Dialogue: 0,0:15:04.10,0:15:07.34,Default,,0,0,0,,Керемет Энн! Энн! Хехехе!
Dialogue: 0,0:15:07.34,0:15:10.10,Default,,0,0,0,,Жүрегімдегі дауыс А... Мен армандайтын сияқтымын! ➡
Dialogue: 0,0:15:10.10,0:15:13.78,Default,,0,0,0,,Мэтью мен Марилла қандай бақытты болады!
Dialogue: 0,0:15:13.78,0:15:27.16,Default,,0,0,0,,♬～
Dialogue: 0,0:15:27.16,0:15:30.66,Default,,0,0,0,,Мен сенің университеттегі табысыңды күтемін.
Dialogue: 0,0:15:30.66,0:15:33.29,Default,,0,0,0,,Бұл бала Avery сыйлығының лауреаты➡
Dialogue: 0,0:15:33.29,0:15:37.17,Default,,0,0,0,,Ол биылғы жылдың ең жақсы қағазын жазған сияқты.
Dialogue: 0,0:15:37.17,0:15:40.03,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:15:40.03,0:15:43.91,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:43.91,0:15:48.51,Default,,0,0,0,,Мен сол баланы өсіргеніме қуаныштымын.
Dialogue: 0,0:15:48.51,0:16:01.19,Default,,0,0,0,,♬～
Dialogue: 0,0:16:01.19,0:16:06.33,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:06.33,0:16:10.03,Default,,0,0,0,,Сол баланы өсіргеніме мені не қуантты?➡
Dialogue: 0,0:16:10.03,0:16:13.07,Default,,0,0,0,,Бұл бірінші рет емес.
Dialogue: 0,0:16:13.07,0:16:15.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.87,0:16:29.35,Default,,0,0,0,,♬～
Dialogue: 0,0:16:29.35,0:16:32.09,Default,,0,0,0,,Үй жақсы ғой!
Dialogue: 0,0:16:32.09,0:16:35.79,Default,,0,0,0,,Ашық қызғылт аспанға қарсы шыршалар жарқырайды➡
Dialogue: 0,0:16:35.79,0:16:38.13,Default,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:16:38.13,0:16:41.03,Default,,0,0,0,,А... жалбыздың иісі бар.
Dialogue: 0,0:16:41.03,0:16:45.93,Default,,0,0,0,,Бұл керемет, Энн. Мен Avery стипендиясын жеңіп алдым.
Dialogue: 0,0:16:45.93,0:16:49.40,Default,,0,0,0,,Сонда бірден мұғалім болмайсың, солай ма?
Dialogue: 0,0:16:49.40,0:16:53.34,Default,,0,0,0,,Иә. Мен қыркүйекте Редмонд университетіне барамын.
Dialogue: 0,0:16:53.34,0:16:57.48,Default,,0,0,0,,Демалысыңыздан ләззат алыңыз.
Dialogue: 0,0:16:57.48,0:17:02.32,Default,,0,0,0,,Руби мен Джейн мұғалім болды және қазір сабақ беріп жатыр ма?
Dialogue: 0,0:17:02.32,0:17:06.55,Default,,0,0,0,,Джейннің Ньюбридж мектебінің барлаушысы бар.
Dialogue: 0,0:17:06.55,0:17:09.92,Default,,0,0,0,,Мен Гилберт те мұғалім болады деп естідім. сурет?
Dialogue: 0,0:17:09.92,0:17:12.56,Default,,0,0,0,,Бұл жалғыз жол.
Dialogue: 0,0:17:12.56,0:17:16.06,Default,,0,0,0,,Себебі әкем енді университет оқу ақысын төлей алмайды➡
Dialogue: 0,0:17:16.06,0:17:18.90,Default,,0,0,0,,Мен мұны өз бетімше жасауды жоспарлап отырмын.
Dialogue: 0,0:17:18.90,0:17:23.34,Default,,0,0,0,,Мүмкін мен Avonlea мектебінде мұғалім болатын шығармын.
Dialogue: 0,0:17:23.34,0:17:25.41,Default,,0,0,0,,Иә….
Dialogue: 0,0:17:25.41,0:17:27.68,Default,,0,0,0,,Жүрек үні Гилберт сізбен➡
Dialogue: 0,0:17:27.68,0:17:30.28,Default,,0,0,0,,Мен сені Редмондқа барады деп ойладым...
Dialogue: 0,0:17:33.28,0:17:35.22,Default,,0,0,0,,Уф... у...
Dialogue: 0,0:17:35.22,0:17:38.95,Default,,0,0,0,,Матай⁉ Матай!
Dialogue: 0,0:17:38.95,0:17:42.46,Default,,0,0,0,,Иә... Иә...
Dialogue: 0,0:17:42.46,0:17:45.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.36,0:17:50.20,Default,,0,0,0,,Марилла... Мэтьюдің денсаулығы әлі нашар ма?
Dialogue: 0,0:17:50.20,0:17:55.10,Default,,0,0,0,,Дұрыс. Дегенмен, әлі де аянбай еңбек етіп келемін.
Dialogue: 0,0:17:55.10,0:17:57.71,Default,,0,0,0,,Мен де уайымдап тұрмын.
Dialogue: 0,0:17:57.71,0:18:01.61,Default,,0,0,0,,Бірақ бұл күндері жағдай біршама жақсарды. ➡
Dialogue: 0,0:18:01.61,0:18:04.21,Default,,0,0,0,,Джерри де сізге көмектеседі.
Dialogue: 0,0:18:04.21,0:18:06.95,Default,,0,0,0,,Сен де оралдың.
Dialogue: 0,0:18:06.95,0:18:10.45,Default,,0,0,0,,Сіздің жүзіңізді көргенде көңілім көтеріледі.
Dialogue: 0,0:18:10.45,0:18:12.42,Default,,0,0,0,,Уа...
Dialogue: 0,0:18:12.42,0:18:16.09,Default,,0,0,0,,Марилла да онша жақсы көрінбейді.
Dialogue: 0,0:18:16.09,0:18:18.99,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:18:22.33,0:18:26.13,Default,,0,0,0,,...Е, менің басым ауырып тұр.
Dialogue: 0,0:18:26.13,0:18:28.47,Default,,0,0,0,,Менің көзімнің арты да ауырады.
Dialogue: 0,0:18:28.47,0:18:30.54,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:18:30.54,0:18:37.18,Default,,0,0,0,,Келесі жолы аралға атақты офтальмолог келеді, сондықтан мен оны көруім керек.
Dialogue: 0,0:18:37.18,0:18:39.65,Default,,0,0,0,,Мұны міндетті түрде істеу керек!
Dialogue: 0,0:18:39.65,0:18:44.49,Default,,0,0,0,,Анна... сіз шынымен де керемет жұмыс жасадыңыз.
Dialogue: 0,0:18:44.49,0:18:46.75,Default,,0,0,0,,Мұғалімдік лицензия алудан басқа➡
Dialogue: 0,0:18:46.75,0:18:49.79,Default,,0,0,0,,Мен Avery стипендиясын да алдым.
Dialogue: 0,0:18:49.79,0:18:53.76,Default,,0,0,0,,Себебі Марилла мен Мэтью мені қолдады.
Dialogue: 0,0:18:53.76,0:19:01.70,Default,,0,0,0,,Рэйчел: ''Мен әйелдердің білім алуына қатты таңданбаймын'' дейді.
Dialogue: 0,0:19:01.70,0:19:05.97,Default,,0,0,0,,Хехе. Мен олай емес деп ойлаймын.
Dialogue: 0,0:19:05.97,0:19:10.44,Default,,0,0,0,,Рейчел естіген бір нәрсені есіме түсірді➡
Dialogue: 0,0:19:10.44,0:19:14.72,Default,,0,0,0,,«Avey Bank қауіп төніп тұр» деген қауесет бар...
Dialogue: 0,0:19:14.72,0:19:16.65,Default,,0,0,0,,Сіз ештеңе білмейсіз бе?
Dialogue: 0,0:19:16.65,0:19:18.59,Default,,0,0,0,,Не? жоқ.
Dialogue: 0,0:19:18.59,0:19:22.22,Default,,0,0,0,,Менің барлық ақшам сонда сақталады.
Dialogue: 0,0:19:22.22,0:19:25.13,Default,,0,0,0,,Солай ма...? Мэтью бұл➡
Dialogue: 0,0:19:25.13,0:19:30.33,Default,,0,0,0,,Олар: ''Абхай-сан мұны істегенше, бәрі жақсы'' дейді.
Dialogue: 0,0:19:30.33,0:19:33.57,Default,,0,0,0,,Кешіріңіз, барлық оқиғалар біртүрлі.
Dialogue: 0,0:19:33.57,0:19:36.14,Default,,0,0,0,,Бүгін – қанат жаятын күн➡
Dialogue: 0,0:19:36.14,0:19:38.54,Default,,0,0,0,,Сіз Дианамен ойнауға келесіз бе? ➡
Dialogue: 0,0:19:38.54,0:19:43.94,Default,,0,0,0,,Келіңіздер. Иә... Рахмет...
Dialogue: 0,0:19:43.94,0:20:04.10,Default,,0,0,0,,♬～
Dialogue: 0,0:20:04.10,0:20:06.77,Default,,0,0,0,,Мэтью! Менде біреуі болады.
Dialogue: 0,0:20:06.77,0:20:09.17,Default,,0,0,0,,Бұл ауыр.
Dialogue: 0,0:20:13.11,0:20:15.58,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:20:15.58,0:20:19.45,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:20:19.45,0:20:23.62,Default,,0,0,0,,Матай неге сонша жұмыс істейді?
Dialogue: 0,0:20:23.62,0:20:27.09,Default,,0,0,0,,Джерри де осында, сондықтан оның көбірек демалуын қалаймын.
Dialogue: 0,0:20:27.09,0:20:32.53,Default,,0,0,0,,Менің қолымнан келгені осы ғана. ➡
Dialogue: 0,0:20:32.53,0:20:37.33,Default,,0,0,0,,Сонда да мен жасымды тез ұмытамын.
Dialogue: 0,0:20:37.33,0:20:41.74,Default,,0,0,0,,Мен де көп жұмыс жасадым➡
Dialogue: 0,0:20:41.74,0:20:45.24,Default,,0,0,0,,Мен өлгенше жұмыс істеймін.
Dialogue: 0,0:20:47.04,0:20:52.28,Default,,0,0,0,,…Егер мен ұл болсам, пайдалырақ болар еді➡
Dialogue: 0,0:20:52.28,0:20:56.55,Default,,0,0,0,,Мэтью мұны жеңілдете алар еді...
Dialogue: 0,0:20:56.55,0:21:03.29,Default,,0,0,0,,Дұрыс... Бірақ мен 12 ұлдан жақсымын➡
Dialogue: 0,0:21:03.29,0:21:07.09,Default,,0,0,0,,Жалғыз болғаныңыз жақсы.
Dialogue: 0,0:21:08.76,0:21:10.70,Default,,0,0,0,,Амансың ба? ➡
Dialogue: 0,0:21:10.70,0:21:16.64,Default,,0,0,0,,Стипендияны ұлдың орнына қыз алған жоқ па? ➡
Dialogue: 0,0:21:16.64,0:21:20.37,Default,,0,0,0,,Ол менің қызым емес пе?
Dialogue: 0,0:21:20.37,0:21:25.38,Default,,0,0,0,,Ол менің мақтан тұтатын қызым.
Dialogue: 0,0:21:28.18,0:21:30.68,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:30.68,0:21:34.09,Default,,0,0,0,,Иә. Хехе.
Dialogue: 0,0:21:34.09,0:21:42.93,Default,,0,0,0,,♬～
Dialogue: 0,0:21:42.93,0:21:49.50,Default,,0,0,0,,<Бұл менің басыма қайғы келгенге дейінгі соңғы түн болды>
Dialogue: 0,0:21:49.50,0:21:53.04,Default,,0,0,0,,Еске алу Ол менің мақтаныш қызым.
Dialogue: 0,0:21:53.04,0:21:58.98,Default,,0,0,0,,<Ал сол мұңның салқын киелілігіне бір рет қол тигізсең➡
Dialogue: 0,0:21:58.98,0:22:03.78,Default,,0,0,0,,Өмір енді ешқашан бұрынғыдай болмайды>
Dialogue: 0,0:22:05.55,0:22:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.03,0:22:17.80,Default,,0,0,0,,♬ «Маңыздысы»
Dialogue: 0,0:22:17.80,0:22:24.94,Default,,0,0,0,,♬ «Мен оны жүрегімнің жарықтарында сақтаймын».
Dialogue: 0,0:22:24.94,0:22:29.61,Default,,0,0,0,,♬ «Білмей тұрып өтетін қаладан»
Dialogue: 0,0:22:29.61,0:22:34.82,Default,,0,0,0,,♬ «Бір гүлді назардан тыс қалдырмаңыз».
Dialogue: 0,0:22:34.82,0:22:39.65,Default,,0,0,0,,♬ «Таңертеңгілік таңға таң»
Dialogue: 0,0:22:39.65,0:22:44.59,Default,,0,0,0,,♬ «Түннің қараңғылығына көзім қысылғанда».
Dialogue: 0,0:22:44.59,0:22:51.70,Default,,0,0,0,,♬ «Мен аңсаған дүние қабақтың сыртында»
Dialogue: 0,0:22:51.70,0:22:55.70,Default,,0,0,0,,♬ «Мен оны дұрыстап тауып, сонда бара аламын».
Dialogue: 0,0:22:55.70,0:23:00.84,Default,,0,0,0,,♬ «Меланхолия басталады».
Dialogue: 0,0:23:00.84,0:23:06.01,Default,,0,0,0,,♬ «Бір күні душ тоқтайды».
Dialogue: 0,0:23:06.01,0:23:10.58,Default,,0,0,0,,♬ «Көзіңмен және құлағыңмен»
Dialogue: 0,0:23:10.58,0:23:15.56,Default,,0,0,0,,♬ «Менің сезгенім бәрі болды».
Dialogue: 0,0:23:15.56,0:23:24.23,Default,,0,0,0,,♬ «Жүрегің қалаған жолмен жүр».
Dialogue: 0,0:23:24.23,0:23:29.47,Default,,0,0,0,,♬ «Сіз оңайсыз».
Dialogue: 0,0:23:29.47,0:23:33.87,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.38,0:23:42.18,Default,,0,0,0,,♬～
Dialogue: 0,0:23:42.18,0:23:57.10,Default,,0,0,0,,♬～
