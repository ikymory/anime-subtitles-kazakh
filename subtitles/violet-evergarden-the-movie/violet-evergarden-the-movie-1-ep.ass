Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.81,0:00:38.54,Default,,0000,0000,0000,,(Екінші қолдың дыбысы)
Dialogue: 0,0:01:41.00,0:01:44.00,Default,,0000,0000,0000,,Бірақ бұл кенеттен болды.
Dialogue: 0,0:01:44.00,0:01:48.11,Default,,0000,0000,0000,,Өзіңізді нашар сезінсеңіз
Dialogue: 0,0:01:44.00,0:01:48.11,Default,,0000,0000,0000,,Менімен хабарласқаныңызды қалаймын.
Dialogue: 0,0:01:50.34,0:01:55.18,Default,,0000,0000,0000,,Сенің анаң бос емес екеніне сенімдімін.
Dialogue: 0,0:01:50.34,0:01:55.18,Default,,0000,0000,0000,,Мен ештеңе айтқан жоқпын.
Dialogue: 0,0:01:55.18,0:01:57.35,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:01:57.35,0:01:59.69,Default,,0000,0000,0000,,Әже
Dialogue: 0,0:01:57.35,0:01:59.69,Default,,0000,0000,0000,,Ол солай болды.
Dialogue: 0,0:01:59.69,0:02:04.29,Default,,0000,0000,0000,,Дейзи.
Dialogue: 0,0:01:59.69,0:02:04.29,Default,,0000,0000,0000,,Сіз мені кінәлайсыз ба?
Dialogue: 0,0:02:04.29,0:02:07.96,Default,,0000,0000,0000,,Анаң туралы.
Dialogue: 0,0:02:07.96,0:02:11.97,Default,,0000,0000,0000,,Бөлек. Бірақ әже➡
Dialogue: 0,0:02:11.97,0:02:14.47,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:02:11.97,0:02:14.47,Default,,0000,0000,0000,,Менің ойымша, сіз менімен кездескіңіз келді.
Dialogue: 0,0:02:14.47,0:02:19.14,Default,,0000,0000,0000,,Маған жақынырақ бол
Dialogue: 0,0:02:14.47,0:02:19.14,Default,,0000,0000,0000,,Менің ойымша, ол мұны қалаған.
Dialogue: 0,0:02:19.14,0:02:22.31,Default,,0000,0000,0000,,Себебі әже➡
Dialogue: 0,0:02:22.31,0:02:25.51,Default,,0000,0000,0000,,Анам туралы көп...
Dialogue: 0,0:02:27.65,0:02:33.05,Default,,0000,0000,0000,,Әже
Dialogue: 0,0:02:27.65,0:02:33.05,Default,,0000,0000,0000,,Себебі мен анамнан ерте айырылдым.
Dialogue: 0,0:02:47.83,0:02:50.50,Default,,0000,0000,0000,,Хат….
Dialogue: 0,0:02:50.50,0:02:53.34,Default,,0000,0000,0000,,Әжеге
Dialogue: 0,0:02:50.50,0:02:53.34,Default,,0000,0000,0000,,Үлкен әже➡
Dialogue: 0,0:02:53.34,0:02:56.18,Default,,0000,0000,0000,,Ол қайтыс болғаннан кейін келген хат.
Dialogue: 0,0:02:56.18,0:02:59.01,Default,,0000,0000,0000,,Марқұмнан
Dialogue: 0,0:02:56.18,0:02:59.01,Default,,0000,0000,0000,,Сізге хат келді ме?
Dialogue: 0,0:02:59.01,0:03:03.95,Default,,0000,0000,0000,,Мен өлгеннен кейін де жыл сайын
Dialogue: 0,0:02:59.01,0:03:03.95,Default,,0000,0000,0000,,Сізге туған күніңізде хат келеді➡
Dialogue: 0,0:03:03.95,0:03:07.62,Default,,0000,0000,0000,,Мен Қуыршақтан сізге жазуды сұрағаныңызды естідім.
Dialogue: 0,0:03:07.62,0:03:11.62,Default,,0000,0000,0000,,Қуыршақ?
Dialogue: 0,0:03:07.62,0:03:11.62,Default,,0000,0000,0000,,Әріп жазатын қуыршақтар бар ма?
Dialogue: 0,0:03:11.62,0:03:16.80,Default,,0000,0000,0000,,Жоқ, баяғыда, менің соқыр әйелім үшін.
Dialogue: 0,0:03:11.62,0:03:16.80,Default,,0000,0000,0000,,Жазу машинкасын жасаған адам➡
Dialogue: 0,0:03:16.80,0:03:20.97,Default,,0000,0000,0000,,Машина автоматты жады қуыршақ деп аталады.
Dialogue: 0,0:03:16.80,0:03:20.97,Default,,0000,0000,0000,,Мен оған ат қойдым.
Dialogue: 0,0:03:20.97,0:03:24.30,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:03:20.97,0:03:24.30,Default,,0000,0000,0000,,Кәсібі елес жазу болып табылатын әйел➡
Dialogue: 0,0:03:24.30,0:03:26.47,Default,,0000,0000,0000,,Оларды қуыршақ деп атай бастаған сияқты.
Dialogue: 0,0:03:26.47,0:03:30.14,Default,,0000,0000,0000,,Ауыстыру? Оның орнына хат жазайын ба?
Dialogue: 0,0:03:30.14,0:03:35.65,Default,,0000,0000,0000,,Ах. Бұрынғы кезде оқу мен жазу
Dialogue: 0,0:03:30.14,0:03:35.65,Default,,0000,0000,0000,,Өйткені мұны істей алатын адамдар өте аз болды.
Dialogue: 0,0:03:35.65,0:03:40.65,Default,,0000,0000,0000,,Бірақ жаза алатындар көбейді.
Dialogue: 0,0:03:35.65,0:03:40.65,Default,,0000,0000,0000,,Телефондар да танымал болды➡
Dialogue: 0,0:03:40.65,0:03:42.99,Default,,0000,0000,0000,,Хат жіберетіндер саны азайды➡
Dialogue: 0,0:03:42.99,0:03:46.99,Default,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:03:42.99,0:03:46.99,Default,,0000,0000,0000,,Менің ойымша, ол енді жоқ.
Dialogue: 0,0:03:46.99,0:03:51.33,Default,,0000,0000,0000,,Арнайы хат жазу кезінде
Dialogue: 0,0:03:46.99,0:03:51.33,Default,,0000,0000,0000,,Жақсы жаза алмаған кезде➡
Dialogue: 0,0:03:51.33,0:03:54.03,Default,,0000,0000,0000,,Мен қуыршақтан сұрадым.
Dialogue: 0,0:03:57.00,0:04:01.77,Default,,0000,0000,0000,,Мен ол хатты қатты жақсы көрдім.
Dialogue: 0,0:03:57.00,0:04:01.77,Default,,0000,0000,0000,,Әже.
Dialogue: 0,0:04:01.77,0:04:03.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:13.12,0:04:15.46,Default,,0000,0000,0000,,Мен тезірек оралуым керек➡
Dialogue: 0,0:04:15.46,0:04:17.56,Default,,0000,0000,0000,,Науқастар күтіп тұр.
Dialogue: 0,0:04:22.80,0:04:25.80,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:22.80,0:04:25.80,Default,,0000,0000,0000,,Енді, Дейзи де.
Dialogue: 0,0:04:25.80,0:04:29.64,Default,,0000,0000,0000,,Мен осында тағы біраз боламын.
Dialogue: 0,0:04:29.64,0:04:32.81,Default,,0000,0000,0000,,Жерлеу рәсімі жақында ғана аяқталды.
Dialogue: 0,0:04:29.64,0:04:32.81,Default,,0000,0000,0000,,Ешкім қалмағанда➡
Dialogue: 0,0:04:32.81,0:04:35.64,Default,,0000,0000,0000,,Әже, сіз жалғыз емессіз бе?
Dialogue: 0,0:04:35.64,0:04:37.64,Default,,0000,0000,0000,,Дейзи….
Dialogue: 0,0:04:37.64,0:04:39.81,Default,,0000,0000,0000,,Анам үйге барсын ба?
Dialogue: 0,0:04:39.81,0:04:44.48,Default,,0000,0000,0000,,Ана қашанда отбасынан артық
Dialogue: 0,0:04:39.81,0:04:44.48,Default,,0000,0000,0000,,Жұмыс маңыздырақ.
Dialogue: 0,0:04:44.48,0:04:47.82,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:04:47.82,0:04:51.82,Default,,0000,0000,0000,,Мен және менің әжем
Dialogue: 0,0:04:47.82,0:04:51.82,Default,,0000,0000,0000,,Ал сіз туралы➡
Dialogue: 0,0:04:51.82,0:04:54.03,Default,,0000,0000,0000,,Мен саған қамқормын!
Dialogue: 0,0:04:59.00,0:05:03.44,Default,,0000,0000,0000,,Енді мен сені вокзалға апарамын.
Dialogue: 0,0:05:03.44,0:05:08.94,Default,,0000,0000,0000,,Дейзи Жұмыстан кейін
Dialogue: 0,0:05:03.44,0:05:08.94,Default,,0000,0000,0000,,Мен қайтамын.
Dialogue: 0,0:05:20.29,0:05:23.62,Default,,0000,0000,0000,,Уф... Әже.
Dialogue: 0,0:05:23.62,0:05:27.46,Default,,0000,0000,0000,,Мен анама
Dialogue: 0,0:05:23.62,0:05:27.46,Default,,0000,0000,0000,,Мен тағы бір жағымсыз нәрсе айттым.
Dialogue: 0,0:05:27.46,0:05:29.96,Default,,0000,0000,0000,,Білсем де.
Dialogue: 0,0:05:29.96,0:05:33.57,Default,,0000,0000,0000,,Ананың жұмысы
Dialogue: 0,0:05:29.96,0:05:33.57,Default,,0000,0000,0000,,Бұл қаншалықты қиын?
Dialogue: 0,0:05:51.98,0:05:55.99,Default,,0000,0000,0000,,"Анна. 8-жасың құтты болсын."
Dialogue: 0,0:05:55.99,0:05:59.83,Default,,0000,0000,0000,,[Аннаның анасы: «Бұл қайғылы.
Dialogue: 0,0:05:55.99,0:05:59.83,Default,,0000,0000,0000,,Көп болуы мүмкін.
Dialogue: 0,0:05:59.83,0:06:02.76,Default,,0000,0000,0000,,Мен көп жұмыс істеуім керек.
Dialogue: 0,0:05:59.83,0:06:02.76,Default,,0000,0000,0000,,Бәлкім, көңіліңіз түсіп кеткен шығар.
Dialogue: 0,0:06:02.76,0:06:04.76,Default,,0000,0000,0000,,Бірақ берілме.
Dialogue: 0,0:06:04.76,0:06:07.93,Default,,0000,0000,0000,,Кейде өзімді жалғыз сезініп, жылаймын
Dialogue: 0,0:06:04.76,0:06:07.93,Default,,0000,0000,0000,,Бар болуы мүмкін, бірақ➡
Dialogue: 0,0:06:07.93,0:06:10.10,Default,,0000,0000,0000,,Ұмытпа.
Dialogue: 0,0:06:10.10,0:06:14.44,Default,,0000,0000,0000,,Ана әрқашан
Dialogue: 0,0:06:10.10,0:06:14.44,Default,,0000,0000,0000,,Мен сені жақсы көремін Анна».
Dialogue: 0,0:06:14.44,0:06:30.62,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:30.62,0:06:34.96,Default,,0000,0000,0000,,``Анна. 10 жасыңыз құтты болсын.
Dialogue: 0,0:06:34.96,0:06:38.80,Default,,0000,0000,0000,,Менің бойым әлдеқайда өсті.
Dialogue: 0,0:06:34.96,0:06:38.80,Default,,0000,0000,0000,,Менің ойымша, ол үлкенірек болды.
Dialogue: 0,0:06:38.80,0:06:41.30,Default,,0000,0000,0000,,Бірақ мен әлі де кітап оқимын➡
Dialogue: 0,0:06:41.30,0:06:43.80,Default,,0000,0000,0000,,Сіз билегенді ұнататын шығарсыз.
Dialogue: 0,0:06:43.80,0:06:46.61,Default,,0000,0000,0000,,Жұмбақтар мен жәндіктердің қақпандары
Dialogue: 0,0:06:43.80,0:06:46.61,Default,,0000,0000,0000,,Сіз бітірдіңіз бе?»》
Dialogue: 0,0:06:48.64,0:06:51.98,Default,,0000,0000,0000,,《18 жасыңыз құтты болсын.
Dialogue: 0,0:06:51.98,0:06:54.48,Default,,0000,0000,0000,,Сіз қазірдің өзінде тамаша ханымсыз.
Dialogue: 0,0:06:54.48,0:06:57.32,Default,,0000,0000,0000,,Сізге ұнайтын адамды таптыңыз деп үміттенемін.
Dialogue: 0,0:06:57.32,0:07:00.09,Default,,0000,0000,0000,,Мен сенен махаббат туралы кеңес сұрай алмаймын, бірақ➡
Dialogue: 0,0:07:00.09,0:07:03.26,Default,,0000,0000,0000,,Сіз таңдаған адам екеніне сенімдімін➡
Dialogue: 0,0:07:03.26,0:07:05.56,Default,,0000,0000,0000,,Сіз өте жақсы адамсыз.''
Dialogue: 0,0:07:09.60,0:07:12.27,Default,,0000,0000,0000,,《Туған күніңмен Анна.
Dialogue: 0,0:07:12.27,0:07:16.27,Default,,0000,0000,0000,,Сіз 20 жыл өмір сүрдіңіз. Бұл керемет.
Dialogue: 0,0:07:16.27,0:07:20.94,Default,,0000,0000,0000,,Тіпті ересек адам болса да, кейде
Dialogue: 0,0:07:16.27,0:07:20.94,Default,,0000,0000,0000,,Қыңсылаудың жөні жоқ.
Dialogue: 0,0:07:20.94,0:07:26.45,Default,,0000,0000,0000,,Мазасыздық сезінсеңіз де
Dialogue: 0,0:07:20.94,0:07:26.45,Default,,0000,0000,0000,,Мен осындамын.
Dialogue: 0,0:07:26.45,0:07:29.95,Default,,0000,0000,0000,,Анн.
Dialogue: 0,0:07:29.95,0:07:37.29,Default,,0000,0000,0000,,Мен сені үнемі бақылап отырамын.''
Dialogue: 0,0:07:37.29,0:07:39.79,Default,,0000,0000,0000,,｟Аннның анасы: Энн｠
Dialogue: 0,0:07:45.80,0:07:53.31,Default,,0000,0000,0000,,Жыл сайын... туған күн сайын
Dialogue: 0,0:07:45.80,0:07:53.31,Default,,0000,0000,0000,,Сізге осындай хат келді ме?
Dialogue: 0,0:07:56.98,0:07:59.15,Default,,0000,0000,0000,,Үлкен әже➡
Dialogue: 0,0:07:59.15,0:08:03.65,Default,,0000,0000,0000,,Әже туралы
Dialogue: 0,0:07:59.15,0:08:03.65,Default,,0000,0000,0000,,Мен қатты уайымдадым.
Dialogue: 0,0:08:13.59,0:08:16.43,Default,,0000,0000,0000,,Газет үзінділері….
Dialogue: 0,0:08:16.43,0:08:19.53,Default,,0000,0000,0000,,Бұл адам….
Dialogue: 0,0:08:25.44,0:08:56.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:56.97,0:08:59.14,Default,,0000,0000,0000,,《Ромашка: Сол хатты жазған адам➡
Dialogue: 0,0:08:59.14,0:09:03.84,Default,,0000,0000,0000,,Бұл сол кезде қызу тақырып болатын.
Dialogue: 0,0:08:59.14,0:09:03.84,Default,,0000,0000,0000,,Бұл қуыршақ болған сияқты》
Dialogue: 0,0:09:07.75,0:09:10.75,Default,,0000,0000,0000,,《Кейде
Dialogue: 0,0:09:07.75,0:09:10.75,Default,,0000,0000,0000,,Ханшайымға махаббат хат жазу》
Dialogue: 0,0:09:12.75,0:09:18.46,Default,,0000,0000,0000,,《Тағы да диваның өтініші бойынша
Dialogue: 0,0:09:12.75,0:09:18.46,Default,,0000,0000,0000,,Жаңа операның сөзін жазды》
Dialogue: 0,0:09:22.93,0:09:26.43,Default,,0000,0000,0000,,《Сонымен қатар атақты драматургтер➡
Dialogue: 0,0:09:26.43,0:09:29.74,Default,,0000,0000,0000,,Сахналық сценарийлердің елес жазуы
Dialogue: 0,0:09:26.43,0:09:29.74,Default,,0000,0000,0000,,Аяқталды дейді》
Dialogue: 0,0:09:31.94,0:09:35.11,Default,,0000,0000,0000,,《Лейден пошта бөлімшесіне
Dialogue: 0,0:09:31.94,0:09:35.11,Default,,0000,0000,0000,,Мен тиесілі болсам да➡
Dialogue: 0,0:09:35.11,0:09:38.44,Default,,0000,0000,0000,,18 жаста ол жерден кеткеннен кейін➡
Dialogue: 0,0:09:38.44,0:09:41.95,Default,,0000,0000,0000,,Мен оның мақалаларын ешқашан көрмеймін.
Dialogue: 0,0:09:41.95,0:09:46.95,Default,,0000,0000,0000,,Бұл қуыршақтың аты...》
Dialogue: 0,0:09:46.95,0:10:06.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:06.97,0:10:09.64,Default,,0000,0000,0000,,｟Dietfried: Солтүстік-шығыс театрынан алынды.
Dialogue: 0,0:10:09.64,0:10:12.14,Default,,0000,0000,0000,,Аты жоқ.
Dialogue: 0,0:10:16.98,0:10:19.32,Default,,0000,0000,0000,,Әй, сәлем айт.
Dialogue: 0,0:10:19.32,0:10:23.99,Default,,0000,0000,0000,,Зорлық-зомбылықты доғар!
Dialogue: 0,0:10:19.32,0:10:23.99,Default,,0000,0000,0000,,Осындай балаға!
Dialogue: 0,0:10:23.99,0:10:27.66,Default,,0000,0000,0000,,Гил…
Dialogue: 0,0:10:23.99,0:10:27.66,Default,,0000,0000,0000,,Ол бала емес.
Dialogue: 0,0:10:27.66,0:10:34.07,Default,,0000,0000,0000,,Бұл қару. Бұл жай ғана күрес құралы.
Dialogue: 0,0:10:38.34,0:10:43.01,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:38.34,0:10:43.01,Default,,0000,0000,0000,,Мен оны атай аламын ба?
Dialogue: 0,0:10:43.01,0:10:45.34,Default,,0000,0000,0000,,Күлгін….
Dialogue: 0,0:10:45.34,0:10:47.51,Default,,0000,0000,0000,,Бұл күлгін.
Dialogue: 0,0:10:47.51,0:10:52.69,Default,,0000,0000,0000,,Өссең, міндетті түрде боласың
Dialogue: 0,0:10:47.51,0:10:52.69,Default,,0000,0000,0000,,Сол атқа лайық әйел бол.
Dialogue: 0,0:10:52.69,0:10:57.69,Default,,0000,0000,0000,,Сіз құрал емессіз
Dialogue: 0,0:10:52.69,0:10:57.69,Default,,0000,0000,0000,,Сізге есімі лайық адам болыңыз｠
Dialogue: 0,0:11:01.63,0:11:03.63,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,0:11:03.63,0:11:09.14,Default,,0000,0000,0000,,Теңізге арналған әнұран
Dialogue: 0,0:11:03.63,0:11:09.14,Default,,0000,0000,0000,,Керемет болды, Күлгін.
Dialogue: 0,0:11:09.14,0:11:12.30,Default,,0000,0000,0000,,Рас
Dialogue: 0,0:11:09.14,0:11:12.30,Default,,0000,0000,0000,,Оны жазу үшін көп күш жұмсадыңыз.
Dialogue: 0,0:11:12.30,0:11:16.98,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:11:12.30,0:11:16.98,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:11:16.98,0:11:19.28,Default,,0000,0000,0000,,⚟Күлгін мәңгілік бақша.
Dialogue: 0,0:11:22.98,0:11:26.99,Default,,0000,0000,0000,,Әкім. Әйелдер де.
Dialogue: 0,0:11:26.99,0:11:29.66,Default,,0000,0000,0000,,Виолет-чан мұнда➡
Dialogue: 0,0:11:29.66,0:11:33.16,Default,,0000,0000,0000,,Лейден мэрімен
Dialogue: 0,0:11:29.66,0:11:33.16,Default,,0000,0000,0000,,Бұл оның әйелі.
Dialogue: 0,0:11:39.67,0:11:42.37,Default,,0000,0000,0000,,Мен сені бірінші рет көремін.
Dialogue: 0,0:11:44.67,0:11:48.34,Default,,0000,0000,0000,,Қаласаңыз
Dialogue: 0,0:11:44.67,0:11:48.34,Default,,0000,0000,0000,,Мен кез келген жерге асығамын.
Dialogue: 0,0:11:48.34,0:11:51.68,Default,,0000,0000,0000,,Автоматты жад қуыршақ қызметі➡
Dialogue: 0,0:11:51.68,0:11:55.68,Default,,0000,0000,0000,,Бұл Виолет Эвергарден.
Dialogue: 0,0:11:57.68,0:12:01.95,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:57.68,0:12:01.95,Default,,0000,0000,0000,,Ол шынымен қуыршаққа ұқсайды.
Dialogue: 0,0:12:01.95,0:12:06.63,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:12:01.95,0:12:06.63,Default,,0000,0000,0000,,Мен сізді жақсы білемін.
Dialogue: 0,0:12:06.63,0:12:11.63,Default,,0000,0000,0000,,Биыл сіз
Dialogue: 0,0:12:06.63,0:12:11.63,Default,,0000,0000,0000,,Осы дәстүрлі теңізге алғыс айту фестивалінде➡
Dialogue: 0,0:12:11.63,0:12:13.80,Default,,0000,0000,0000,,Әнұранды жазуыма не себеп болды➡
Dialogue: 0,0:12:13.80,0:12:16.47,Default,,0000,0000,0000,,Себебі мен оны ұсындым.
Dialogue: 0,0:12:16.47,0:12:19.64,Default,,0000,0000,0000,,Сіз көпшілікке арналған махаббат хатын жаздыңыз➡
Dialogue: 0,0:12:19.64,0:12:24.81,Default,,0000,0000,0000,,Флугель патшалығы Дамиан патшасының анты.
Dialogue: 0,0:12:24.81,0:12:27.65,Default,,0000,0000,0000,,Ол сөйлем де әдемі➡
Dialogue: 0,0:12:27.65,0:12:31.15,Default,,0000,0000,0000,,Өзің сияқты керемет болды.
Dialogue: 0,0:12:33.82,0:12:36.32,Default,,0000,0000,0000,,Тәж кию анты – ➡
Dialogue: 0,0:12:36.32,0:12:41.66,Default,,0000,0000,0000,,Дэмиан патша болады
Dialogue: 0,0:12:36.32,0:12:41.66,Default,,0000,0000,0000,,Мен өзімнің мұраттарым мен ұмтылыстарымды жазуға салдым.
Dialogue: 0,0:12:41.66,0:12:45.00,Default,,0000,0000,0000,,Мені жақсы көр
Dialogue: 0,0:12:41.66,0:12:45.00,Default,,0000,0000,0000,,Сіз оны сипаттадыңыз➡
Dialogue: 0,0:12:45.00,0:12:49.84,Default,,0000,0000,0000,,Менің жазғандарым және өзім
Dialogue: 0,0:12:45.00,0:12:49.84,Default,,0000,0000,0000,,Мен ешқандай корреляция жоқ деп ойлаймын.
Dialogue: 0,0:12:49.84,0:12:52.00,Default,,0000,0000,0000,,Ұят жоқ.
Dialogue: 0,0:12:52.00,0:12:54.01,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:12:56.01,0:12:58.84,Default,,0000,0000,0000,,Виолет-чан дегенім...
Dialogue: 0,0:12:56.01,0:12:58.84,Default,,0000,0000,0000,,Охон.
Dialogue: 0,0:12:58.84,0:13:03.45,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:12:58.84,0:13:03.45,Default,,0000,0000,0000,,Мен сізді бағалаймын.
Dialogue: 0,0:13:03.45,0:13:07.12,Default,,0000,0000,0000,,Сіз қуыршақ ретінде де белсендісіз➡
Dialogue: 0,0:13:07.12,0:13:09.29,Default,,0000,0000,0000,,Бұрынғы жауынгер➡
Dialogue: 0,0:13:09.29,0:13:13.13,Default,,0000,0000,0000,,Бұл Лейденшафтлих те
Dialogue: 0,0:13:09.29,0:13:13.13,Default,,0000,0000,0000,,Себебі мен сені құтқардым.
Dialogue: 0,0:13:13.13,0:13:24.64,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:24.64,0:13:27.81,Default,,0000,0000,0000,,Мен сені құтқарған жоқпын.
Dialogue: 0,0:13:27.81,0:13:30.31,Default,,0000,0000,0000,,Өйткені көптеген жауынгерлер шайқасты.
Dialogue: 0,0:13:30.31,0:13:35.48,Default,,0000,0000,0000,,Бірақ шайқас бір мезгілде болды
Dialogue: 0,0:13:30.31,0:13:35.48,Default,,0000,0000,0000,,Көптеген адамдардың өмірі қиылды.
Dialogue: 0,0:13:35.48,0:13:37.82,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:13:37.82,0:13:40.32,Default,,0000,0000,0000,,Сондықтан➡
Dialogue: 0,0:13:40.32,0:13:45.52,Default,,0000,0000,0000,,Мен мақтауға лайық емеспін.
Dialogue: 0,0:13:40.32,0:13:45.52,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:13:51.33,0:14:05.54,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:14:38.98,0:14:41.15,Default,,0000,0000,0000,,Майор….
Dialogue: 0,0:14:41.15,0:14:44.35,Default,,0000,0000,0000,,(Оқ сигналының дыбысы)
Dialogue: 0,0:14:48.49,0:14:50.49,Default,,0000,0000,0000,,｟Майор? ｠
Dialogue: 0,0:14:58.16,0:15:00.17,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:15:04.27,0:15:10.11,Default,,0000,0000,0000,,｟Қаш... мені тастап қаш｠
Dialogue: 0,0:15:10.11,0:15:37.80,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:37.80,0:15:41.51,Default,,0000,0000,0000,,｟Мүлдем!
Dialogue: 0,0:15:37.80,0:15:41.51,Default,,0000,0000,0000,,Мен майордың өлуіне ешқашан жол бермеймін!
Dialogue: 0,0:15:45.14,0:15:47.15,Default,,0000,0000,0000,,Тоқта...
Dialogue: 0,0:15:49.98,0:15:52.65,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:15:52.65,0:15:55.82,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:15:55.82,0:16:01.09,Default,,0000,0000,0000,,Тікелей...
Dialogue: 0,0:15:55.82,0:16:01.09,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:16:01.09,0:16:07.43,Default,,0000,0000,0000,,Күлгін... сен тірісің...
Dialogue: 0,0:16:07.43,0:16:10.44,Default,,0000,0000,0000,,Еркін болыңыз.
Dialogue: 0,0:16:14.61,0:16:17.11,Default,,0000,0000,0000,,Құрметпен...
Dialogue: 0,0:16:22.61,0:16:25.02,Default,,0000,0000,0000,,Мен сені сүйемін...｠
Dialogue: 0,0:17:00.25,0:17:03.26,Default,,0000,0000,0000,,《Күлгін: «Құрметті майор Гилберт.
Dialogue: 0,0:17:03.26,0:17:08.26,Default,,0000,0000,0000,,Бүгін тағы да майор туралы.
Dialogue: 0,0:17:03.26,0:17:08.26,Default,,0000,0000,0000,,есіме түсті.
Dialogue: 0,0:17:08.26,0:17:12.60,Default,,0000,0000,0000,,Не көрсең де, не істесең де➡
Dialogue: 0,0:17:12.60,0:17:15.60,Default,,0000,0000,0000,,Сізде естеліктер бар
Dialogue: 0,0:17:12.60,0:17:15.60,Default,,0000,0000,0000,,Олар жалғанған.
Dialogue: 0,0:17:15.60,0:17:20.94,Default,,0000,0000,0000,,Уақыт өтіп, алысқа кететін болсақ та➡
Dialogue: 0,0:17:20.94,0:17:25.78,Default,,0000,0000,0000,,Мен сенімен өткізген естеліктер
Dialogue: 0,0:17:20.94,0:17:25.78,Default,,0000,0000,0000,,Ашық түрде жанданды.
Dialogue: 0,0:17:25.78,0:17:28.28,Default,,0000,0000,0000,,Сіз мені қасыңызда ұстайсыз➡
Dialogue: 0,0:17:28.28,0:17:33.79,Default,,0000,0000,0000,,Мен ештеңе істей алмаймын
Dialogue: 0,0:17:28.28,0:17:33.79,Default,,0000,0000,0000,,Маған қалай өмір сүру керектігін үйретші➡
Dialogue: 0,0:17:33.79,0:17:38.29,Default,,0000,0000,0000,,Ал мен үшін бірінші рет...»》
Dialogue: 0,0:17:42.13,0:17:48.47,Default,,0000,0000,0000,,《«Мен сені сүйемін»
Dialogue: 0,0:17:42.13,0:17:48.47,Default,,0000,0000,0000,,Ол бізге сөз берді.
Dialogue: 0,0:17:48.47,0:17:53.07,Default,,0000,0000,0000,,Тағы да
Dialogue: 0,0:17:48.47,0:17:53.07,Default,,0000,0000,0000,,Мен хат жазамын».
Dialogue: 0,0:17:56.48,0:18:00.91,Default,,0000,0000,0000,,《Бір күні
Dialogue: 0,0:17:56.48,0:18:00.91,Default,,0000,0000,0000,,Бұл хат сізге жетеді деп үміттенемін.
Dialogue: 0,0:18:00.91,0:18:05.02,Default,,0000,0000,0000,,Тілегіңіз орындалсын деп дұға етіңіз».
Dialogue: 0,0:18:12.09,0:18:14.79,Default,,0000,0000,0000,,3 Cors қайтарылуы.
Dialogue: 0,0:18:17.26,0:18:19.43,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:18:19.43,0:18:23.77,Default,,0000,0000,0000,,Оның салмағы 1,2 ливр, сондықтан
Dialogue: 0,0:18:19.43,0:18:23.77,Default,,0000,0000,0000,,Бұл 11-ші корсе.
Dialogue: 0,0:18:23.77,0:18:31.11,Default,,0000,0000,0000,,(телефон қоңырауы)
Dialogue: 0,0:18:31.11,0:18:33.78,Default,,0000,0000,0000,,Иә C. H Пошталық компания.
Dialogue: 0,0:18:33.78,0:18:37.12,Default,,0000,0000,0000,,Тұтынушы қаласа
Dialogue: 0,0:18:33.78,0:18:37.12,Default,,0000,0000,0000,,Мен кез келген жерге асығамын.
Dialogue: 0,0:18:37.12,0:18:41.12,Default,,0000,0000,0000,,Автоматтандырылған естелік қуыршақ қызметі
Dialogue: 0,0:18:37.12,0:18:41.12,Default,,0000,0000,0000,,Бұл қуыршақ Айрис Канар.
Dialogue: 0,0:18:41.12,0:18:46.13,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:18:53.47,0:18:55.47,Default,,0000,0000,0000,,Күткеніңізге рахмет.
Dialogue: 0,0:18:55.47,0:18:57.47,Default,,0000,0000,0000,,Өкінішке орай, сіз ұсынған қуыршақ➡
Dialogue: 0,0:18:57.47,0:19:00.24,Default,,0000,0000,0000,,3 айға дейін
Dialogue: 0,0:18:57.47,0:19:00.24,Default,,0000,0000,0000,,Біз толығымен брондадық.
Dialogue: 0,0:19:00.24,0:19:04.08,Default,,0000,0000,0000,,Мен ше?
Dialogue: 0,0:19:04.08,0:19:08.08,Default,,0000,0000,0000,,А... А, түсіндім.
Dialogue: 0,0:19:08.08,0:19:10.08,Default,,0000,0000,0000,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,0:19:10.08,0:19:13.75,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:19:10.08,0:19:13.75,Default,,0000,0000,0000,,Брондауларды 3 ай бұрын қабылдаймыз.
Dialogue: 0,0:19:13.75,0:19:16.92,Default,,0000,0000,0000,,Иә... дұрыс.
Dialogue: 0,0:19:16.92,0:19:19.42,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:19:16.92,0:19:19.42,Default,,0000,0000,0000,,(телефонның тұтқасын қою дыбысы)
Dialogue: 0,0:19:19.42,0:19:23.93,Default,,0000,0000,0000,,Ирис Тұтынушыға
Dialogue: 0,0:19:19.42,0:19:23.93,Default,,0000,0000,0000,,Қанағаттанбаған әрекет жасама.
Dialogue: 0,0:19:23.93,0:19:26.77,Default,,0000,0000,0000,,Күй көзге көрінбейді. Бұл телефон қоңырауы.
Dialogue: 0,0:19:26.77,0:19:29.10,Default,,0000,0000,0000,,Сіздің мимикаңыз дауысыңыздан көрінеді.
Dialogue: 0,0:19:29.10,0:19:33.77,Default,,0000,0000,0000,,А... иә.
Dialogue: 0,0:19:33.77,0:19:37.94,Default,,0000,0000,0000,,Сіз де
Dialogue: 0,0:19:33.77,0:19:37.94,Default,,0000,0000,0000,,Сіз толығымен брондалғансыз ба?
Dialogue: 0,0:19:37.94,0:19:41.61,Default,,0000,0000,0000,,Кэтлея сияқты жақсы емес... Ах...
Dialogue: 0,0:19:41.61,0:19:46.79,Default,,0000,0000,0000,,Бұлай жалғаса берсе, I
Dialogue: 0,0:19:41.61,0:19:46.79,Default,,0000,0000,0000,,Мәңгі менің 3 саным.
Dialogue: 0,0:19:46.79,0:19:51.79,Default,,0000,0000,0000,,(Есік жабылған дыбысы)
Dialogue: 0,0:19:51.79,0:19:53.79,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:53.79,0:19:56.96,Default,,0000,0000,0000,,Уа, Президент, ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:56.96,0:19:59.46,Default,,0000,0000,0000,,Сіз осы аптада бос емессіз, солай емес пе?
Dialogue: 0,0:19:59.46,0:20:02.30,Default,,0000,0000,0000,,Бәрің ертең жақсылап демалыңдар.
Dialogue: 0,0:20:02.30,0:20:05.97,Default,,0000,0000,0000,,Мен осы демалыста іссапардамын.
Dialogue: 0,0:20:05.97,0:20:10.98,Default,,0000,0000,0000,,Гардарикпен сауда шартын қайта қарауға арналған кездесу
Dialogue: 0,0:20:05.97,0:20:10.98,Default,,0000,0000,0000,,Сізді хатшы болуды сұрады.
Dialogue: 0,0:20:10.98,0:20:13.48,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:20:13.48,0:20:16.65,Default,,0000,0000,0000,,Мен әкімнің әйелінің кешіндемін.
Dialogue: 0,0:20:13.48,0:20:16.65,Default,,0000,0000,0000,,Мен қатысамын.
Dialogue: 0,0:20:16.65,0:20:19.82,Default,,0000,0000,0000,,Біз жаңа тұтынушыларды дамытамыз.
Dialogue: 0,0:20:19.82,0:20:23.32,Default,,0000,0000,0000,,Әркім өз жұмысына соншалықты ынталы.
Dialogue: 0,0:20:23.32,0:20:25.66,Default,,0000,0000,0000,,Мен жақында теннис ойнай бастадым➡
Dialogue: 0,0:20:25.66,0:20:29.49,Default,,0000,0000,0000,,Маған біреу көмектеседі деп үміттенемін
Dialogue: 0,0:20:25.66,0:20:29.49,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,0:20:29.49,0:20:32.00,Default,,0000,0000,0000,,Президентке
Dialogue: 0,0:20:29.49,0:20:32.00,Default,,0000,0000,0000,,Сізде дағдарыс сезімі жоқ па?
Dialogue: 0,0:20:32.00,0:20:35.30,Default,,0000,0000,0000,,Мен қазір бар күшімді салуым керек...
Dialogue: 0,0:20:37.50,0:20:40.51,Default,,0000,0000,0000,,Сол жағымсыз машинаның кесірінен➡
Dialogue: 0,0:20:40.51,0:20:43.01,Default,,0000,0000,0000,,Хаттар ақырында ескіреді.
Dialogue: 0,0:20:45.84,0:20:57.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:57.19,0:21:00.96,Default,,0000,0000,0000,,Радио мұнарасы жақында аяқталады➡
Dialogue: 0,0:21:00.96,0:21:06.63,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:21:00.96,0:21:06.63,Default,,0000,0000,0000,,Телефондар танымал бола бастайды.
Dialogue: 0,0:21:06.63,0:21:12.30,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:06.63,0:21:12.30,Default,,0000,0000,0000,,Көп нәрсе өзгереді.
Dialogue: 0,0:21:12.30,0:21:16.64,Default,,0000,0000,0000,,Тіпті осы пошта компаниясы
Dialogue: 0,0:21:12.30,0:21:16.64,Default,,0000,0000,0000,,Жағдай біртіндеп өзгереді.
Dialogue: 0,0:21:16.64,0:21:21.31,Default,,0000,0000,0000,,Ақырында ол көне кәсіпке айналады.
Dialogue: 0,0:21:16.64,0:21:21.31,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:21:21.31,0:21:23.98,Default,,0000,0000,0000,,Қуыршақтар да.
Dialogue: 0,0:21:23.98,0:21:30.16,Default,,0000,0000,0000,,Және ескірген
Dialogue: 0,0:21:23.98,0:21:30.16,Default,,0000,0000,0000,,Ол жоғалып кетуі мүмкін...
Dialogue: 0,0:21:30.16,0:21:34.33,Default,,0000,0000,0000,,Сондықтан! бұған дейін
Dialogue: 0,0:21:30.16,0:21:34.33,Default,,0000,0000,0000,,Сізге ақша табу керек!
Dialogue: 0,0:21:34.33,0:21:36.83,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:21:36.83,0:21:40.17,Default,,0000,0000,0000,,Сонымен Виолет та кешке барады ма?
Dialogue: 0,0:21:40.17,0:21:42.50,Default,,0000,0000,0000,,Жоқ, мен...
Dialogue: 0,0:21:42.50,0:21:45.17,Default,,0000,0000,0000,,Қарсыласымды да өзіммен бірге ала кетемін.
Dialogue: 0,0:21:42.50,0:21:45.17,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:21:45.17,0:21:48.34,Default,,0000,0000,0000,,Иә, бас тартуға болмайды.
Dialogue: 0,0:21:48.34,0:21:52.14,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:21:48.34,0:21:52.14,Default,,0000,0000,0000,,Менің сыртқа шығу жоспарым бар.
Dialogue: 0,0:21:58.35,0:22:00.55,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:22:02.45,0:22:05.46,Default,,0000,0000,0000,,Не деген сұмдық!
Dialogue: 0,0:22:02.45,0:22:05.46,Default,,0000,0000,0000,,Кішкене жиналыңыз!
Dialogue: 0,0:22:05.46,0:22:08.29,Default,,0000,0000,0000,,Егер сіз қызбен бірге болсаңыз
Dialogue: 0,0:22:05.46,0:22:08.29,Default,,0000,0000,0000,,Бұл қызық➡
Dialogue: 0,0:22:08.29,0:22:10.30,Default,,0000,0000,0000,,Президент екінші тарап болып табылады.
Dialogue: 0,0:22:10.30,0:22:12.30,Default,,0000,0000,0000,,Барлығы бос емес.
Dialogue: 0,0:22:12.30,0:22:14.80,Default,,0000,0000,0000,,Виолет-чан да
Dialogue: 0,0:22:12.30,0:22:14.80,Default,,0000,0000,0000,,Ол менімен бірге шықпайды.
Dialogue: 0,0:22:14.80,0:22:19.14,Default,,0000,0000,0000,,Керемет емес пе? Бұл сирек.
Dialogue: 0,0:22:14.80,0:22:19.14,Default,,0000,0000,0000,,Мен шығамын.
Dialogue: 0,0:22:19.14,0:22:21.47,Default,,0000,0000,0000,,Бірақ егер ол осында болса➡
Dialogue: 0,0:22:21.47,0:22:24.31,Default,,0000,0000,0000,,Танымайтын қызға назар аудару
Dialogue: 0,0:22:21.47,0:22:24.31,Default,,0000,0000,0000,,Оны тарту оңай.
Dialogue: 0,0:22:24.31,0:22:26.81,Default,,0000,0000,0000,,Мені жеткізу кезінде көп сұрайды.
Dialogue: 0,0:22:26.81,0:22:28.81,Default,,0000,0000,0000,,«C.H Пошта компаниясының адамы?
Dialogue: 0,0:22:28.81,0:22:32.82,Default,,0000,0000,0000,,Сіздің жеңгеңіз Күлгін - қуыршақ.
Dialogue: 0,0:22:28.81,0:22:32.82,Default,,0000,0000,0000,,Мені таныстырыңыз.''
Dialogue: 0,0:22:32.82,0:22:37.99,Default,,0000,0000,0000,,Виолет-чан
Dialogue: 0,0:22:32.82,0:22:37.99,Default,,0000,0000,0000,,Оны өз қара ниеттеріңіз үшін пайдаланбаңыз.
Dialogue: 0,0:22:37.99,0:22:39.99,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:22:39.99,0:22:43.50,Default,,0000,0000,0000,,Қайда кеткені қызық...
Dialogue: 0,0:22:47.00,0:22:49.60,Default,,0000,0000,0000,,Сіз өте қорғансыз.
Dialogue: 0,0:23:07.45,0:23:10.26,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:23:15.29,0:23:20.13,Default,,0000,0000,0000,,Полковник.
Dialogue: 0,0:23:15.29,0:23:20.13,Default,,0000,0000,0000,,Сіз болдыңыз ба?
Dialogue: 0,0:23:20.13,0:23:23.30,Default,,0000,0000,0000,,Анамның қайтыс болған күнінде әрқашан гүлдер бар...
Dialogue: 0,0:23:23.30,0:23:26.97,Default,,0000,0000,0000,,Бастапқыда
Dialogue: 0,0:23:23.30,0:23:26.97,Default,,0000,0000,0000,,Мен ертең келуім керек➡
Dialogue: 0,0:23:26.97,0:23:30.08,Default,,0000,0000,0000,,Басқа туыстар
Dialogue: 0,0:23:26.97,0:23:30.08,Default,,0000,0000,0000,,Сіз осындасыз деп үміттенемін.
Dialogue: 0,0:23:33.15,0:23:35.81,Default,,0000,0000,0000,,Сізге ыңғайсыздық туды ма?
Dialogue: 0,0:23:35.81,0:23:39.32,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:23:39.32,0:23:42.82,Default,,0000,0000,0000,,Бірақ неге алаңдайсыз?
Dialogue: 0,0:23:39.32,0:23:42.82,Default,,0000,0000,0000,,Осындай жерге келмесең де.
Dialogue: 0,0:23:42.82,0:23:45.16,Default,,0000,0000,0000,,Сіздің қымбат демалыс күніңізде.
Dialogue: 0,0:23:45.16,0:23:48.86,Default,,0000,0000,0000,,Өйткені демалыс күні.
Dialogue: 0,0:23:45.16,0:23:48.86,Default,,0000,0000,0000,,Ол келе алады.
Dialogue: 0,0:23:51.00,0:23:54.10,Default,,0000,0000,0000,,Оның орнында?
Dialogue: 0,0:23:57.34,0:24:02.11,Default,,0000,0000,0000,,Майор...
Dialogue: 0,0:23:57.34,0:24:02.11,Default,,0000,0000,0000,,Өкіл емес.
Dialogue: 0,0:24:02.11,0:24:06.31,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:24:02.11,0:24:06.31,Default,,0000,0000,0000,,Мен өз еркіммен келдім.
Dialogue: 0,0:24:09.45,0:24:13.45,Default,,0000,0000,0000,,Соғыс аяқталғаннан кейін
Dialogue: 0,0:24:09.45,0:24:13.45,Default,,0000,0000,0000,,Неше жыл болды?
Dialogue: 0,0:24:13.45,0:24:17.76,Default,,0000,0000,0000,,Сіз оның қазірдің өзінде...
Dialogue: 0,0:24:20.29,0:24:24.10,Default,,0000,0000,0000,,Гилберт туралы ұмытыңыз.
Dialogue: 0,0:24:26.30,0:24:30.64,Default,,0000,0000,0000,,Ұмыту... қиын.
Dialogue: 0,0:24:30.64,0:24:34.81,Default,,0000,0000,0000,,Мен өмір сүргенше➡
Dialogue: 0,0:24:34.81,0:24:37.14,Default,,0000,0000,0000,,Сіз ұмыта алмайсыз.
Dialogue: 0,0:24:37.14,0:24:55.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:55.33,0:24:57.33,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:25:04.10,0:25:07.77,Default,,0000,0000,0000,,《Егер біз ешқашан кездеспесек те...》
Dialogue: 0,0:25:07.77,0:25:12.28,Default,,0000,0000,0000,,Ұмыту қиын... иә?
Dialogue: 0,0:25:21.79,0:25:25.12,Default,,0000,0000,0000,,Сол екеу ме?
Dialogue: 0,0:25:25.12,0:25:28.63,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:25:51.32,0:25:54.15,Default,,0000,0000,0000,,Лента...
Dialogue: 0,0:25:54.15,0:26:02.43,Default,,0000,0000,0000,,(телефон қоңырауы)
Dialogue: 0,0:26:02.43,0:26:07.77,Default,,0000,0000,0000,,Иә C. H пошта….
Dialogue: 0,0:26:02.43,0:26:07.77,Default,,0000,0000,0000,,☎Мм, қуыршақ адамдар бар ма?
Dialogue: 0,0:26:07.77,0:26:10.10,Default,,0000,0000,0000,,Мен де қуыршақпын.
Dialogue: 0,0:26:10.10,0:26:13.61,Default,,0000,0000,0000,,☎Шынымен бе? Жарайды онда
Dialogue: 0,0:26:10.10,0:26:13.61,Default,,0000,0000,0000,,Мен жұмыс сұрағым келеді.
Dialogue: 0,0:26:13.61,0:26:16.44,Default,,0000,0000,0000,,☎Тек маған кел
Dialogue: 0,0:26:13.61,0:26:16.44,Default,,0000,0000,0000,,Келесің бе?
Dialogue: 0,0:26:16.44,0:26:19.61,Default,,0000,0000,0000,,Біздің компания бүгін жабық.
Dialogue: 0,0:26:19.61,0:26:23.28,Default,,0000,0000,0000,,☎Е, дұрыс! ? Мен көремін...
Dialogue: 0,0:26:23.28,0:26:28.29,Default,,0000,0000,0000,,Кешіріңіз, бірақ сіз айтқандай,
Dialogue: 0,0:26:23.28,0:26:28.29,Default,,0000,0000,0000,,Сіз өте жас сияқтысыз.
Dialogue: 0,0:26:28.29,0:26:31.62,Default,,0000,0000,0000,,Хат жазу
Dialogue: 0,0:26:28.29,0:26:31.62,Default,,0000,0000,0000,,Жас маңызды ма?
Dialogue: 0,0:26:31.62,0:26:34.79,Default,,0000,0000,0000,,Қуыршақтар сіз қалаған жерде болуы мүмкін
Dialogue: 0,0:26:31.62,0:26:34.79,Default,,0000,0000,0000,,Келесің бе?
Dialogue: 0,0:26:34.79,0:26:36.80,Default,,0000,0000,0000,,Бұл өтірік пе?
Dialogue: 0,0:26:36.80,0:26:41.50,Default,,0000,0000,0000,,Жоқ, бұл өтірік емес.
Dialogue: 0,0:26:36.80,0:26:41.50,Default,,0000,0000,0000,,☎Онда кел!
Dialogue: 0,0:26:44.64,0:27:00.75,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:00.75,0:27:03.25,Default,,0000,0000,0000,,Who?
Dialogue: 0,0:27:00.75,0:27:03.25,Default,,0000,0000,0000,,
Dialogue: 0,0:27:03.25,0:27:06.59,Default,,0000,0000,0000,,C. Мен H Пошта компаниясынан келдім.
Dialogue: 0,0:27:03.25,0:27:06.59,Default,,0000,0000,0000,,Бұл қуыршақ.
Dialogue: 0,0:27:06.59,0:27:08.93,Default,,0000,0000,0000,,А, кіруге болады.
Dialogue: 0,0:27:08.93,0:27:12.03,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:27:22.61,0:27:24.94,Default,,0000,0000,0000,,Мен сені бірінші рет көремін.
Dialogue: 0,0:27:24.94,0:27:29.45,Default,,0000,0000,0000,,Қаласаңыз
Dialogue: 0,0:27:24.94,0:27:29.45,Default,,0000,0000,0000,,Мен кез келген жерге асығамын.
Dialogue: 0,0:27:29.45,0:27:34.25,Default,,0000,0000,0000,,Автоматтандырылған естелік қуыршақ қызметі
Dialogue: 0,0:27:29.45,0:27:34.25,Default,,0000,0000,0000,,Бұл Виолет Эвергарден.
Dialogue: 0,0:27:37.62,0:27:40.79,Default,,0000,0000,0000,,Хамф, мен шынымен келдім.
Dialogue: 0,0:27:40.79,0:27:44.00,Default,,0000,0000,0000,,Тұтынушы оны сұрағандықтан.
Dialogue: 0,0:27:46.13,0:27:49.30,Default,,0000,0000,0000,,Сіз өте жассыз, жақсы ма?
Dialogue: 0,0:27:49.30,0:27:52.30,Default,,0000,0000,0000,,Мен бар күшімді саламын.
Dialogue: 0,0:27:52.30,0:27:56.31,Default,,0000,0000,0000,,Улиссе!
Dialogue: 0,0:27:52.30,0:27:56.31,Default,,0000,0000,0000,,Үлкен аға осында.
Dialogue: 0,0:27:52.30,0:27:56.31,Default,,0000,0000,0000,,
Dialogue: 0,0:27:56.31,0:28:01.08,Default,,0000,0000,0000,,Кірейік.
Dialogue: 0,0:27:56.31,0:28:01.08,Default,,0000,0000,0000,,А, сәл күте тұрыңыз!
Dialogue: 0,0:28:01.08,0:28:04.25,Default,,0000,0000,0000,,Жасыру! тез!
Dialogue: 0,0:28:04.25,0:28:06.25,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:28:10.09,0:28:12.92,Default,,0000,0000,0000,,Уууу~! Уф!
Dialogue: 0,0:28:12.92,0:28:16.59,Default,,0000,0000,0000,,Юрис: Мұнда біреу бар ма?
Dialogue: 0,0:28:12.92,0:28:16.59,Default,,0000,0000,0000,,№.
Dialogue: 0,0:28:16.59,0:28:21.27,Default,,0000,0000,0000,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:28:16.59,0:28:21.27,Default,,0000,0000,0000,,Мен сөйлеген дауысты естідім деп ойладым.
Dialogue: 0,0:28:21.27,0:28:23.44,Default,,0000,0000,0000,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:28:23.44,0:28:27.27,Default,,0000,0000,0000,,Менен күнде бір нәрсені сұрама.
Dialogue: 0,0:28:27.27,0:28:31.44,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:28:31.44,0:28:34.11,Default,,0000,0000,0000,,Жақсы болса
Dialogue: 0,0:28:31.44,0:28:34.11,Default,,0000,0000,0000,,Мұндай жер жоқ.
Dialogue: 0,0:28:34.11,0:28:38.95,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:28:38.95,0:28:41.79,Default,,0000,0000,0000,,Үлкен аға Үлкен аға.
Dialogue: 0,0:28:41.79,0:28:44.46,Default,,0000,0000,0000,,Мен саған суретті кітап оқып беремін.
Dialogue: 0,0:28:44.46,0:28:48.26,Default,,0000,0000,0000,,Суретті кітап оқығың келе ме? Бұл қоқыс.
Dialogue: 0,0:28:52.46,0:28:56.80,Default,,0000,0000,0000,,Ағамның жағдайы нашар.
Dialogue: 0,0:28:56.80,0:29:00.41,Default,,0000,0000,0000,,Науқас болудан алыс
Dialogue: 0,0:28:56.80,0:29:00.41,Default,,0000,0000,0000,,Үш операциядан кейін➡
Dialogue: 0,0:29:00.41,0:29:04.08,Default,,0000,0000,0000,,1 жыл
Dialogue: 0,0:29:00.41,0:29:04.08,Default,,0000,0000,0000,,Мен ауруханаға жатқызылдым.
Dialogue: 0,0:29:04.08,0:29:08.41,Default,,0000,0000,0000,,Улиссе Қазір ойлап қарасам, Лукас.
Dialogue: 0,0:29:04.08,0:29:08.41,Default,,0000,0000,0000,,Ол маған қонаққа келгісі келетінін айтты.
Dialogue: 0,0:29:08.41,0:29:11.08,Default,,0000,0000,0000,,Ол сізбен кездескісі келеді.
Dialogue: 0,0:29:11.08,0:29:13.08,Default,,0000,0000,0000,,Сізге келудің қажеті жоқ.
Dialogue: 0,0:29:13.08,0:29:15.75,Default,,0000,0000,0000,,Біз неге жақсы доспыз...
Dialogue: 0,0:29:15.75,0:29:18.92,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:29:18.92,0:29:21.26,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:29:21.26,0:29:25.10,Default,,0000,0000,0000,,Жыртылған.
Dialogue: 0,0:29:21.26,0:29:25.10,Default,,0000,0000,0000,,Маған тиіспе, ақымақ!
Dialogue: 0,0:29:25.10,0:29:27.60,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:29:27.60,0:29:32.77,Default,,0000,0000,0000,,А... келесі бөлмеге келді.
Dialogue: 0,0:29:27.60,0:29:32.77,Default,,0000,0000,0000,,Келуші ретінде.
Dialogue: 0,0:29:32.77,0:29:36.94,Default,,0000,0000,0000,,Мен оны біраз уақытқа дейін сақтаймын ...
Dialogue: 0,0:29:36.94,0:29:41.11,Default,,0000,0000,0000,,Мм... Ұйқым келіп тұр!
Dialogue: 0,0:29:41.11,0:29:43.78,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:29:43.78,0:29:46.12,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:29:46.12,0:29:48.79,Default,,0000,0000,0000,,Аналар
Dialogue: 0,0:29:46.12,0:29:48.79,Default,,0000,0000,0000,,Мен аздап серуендеуге барамын.
Dialogue: 0,0:29:48.79,0:29:52.79,Default,,0000,0000,0000,,Дұрыс, ұйықтау керек.
Dialogue: 0,0:29:54.96,0:29:57.13,Default,,0000,0000,0000,,Мен кейінірек қайтамын.
Dialogue: 0,0:29:57.13,0:30:01.13,Default,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:30:05.80,0:30:08.47,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:30:08.47,0:30:11.58,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:30:15.31,0:30:18.48,Default,,0000,0000,0000,,Мен жасырмасам
Dialogue: 0,0:30:15.31,0:30:18.48,Default,,0000,0000,0000,,Болмау себептері➡
Dialogue: 0,0:30:18.48,0:30:23.99,Default,,0000,0000,0000,,Маған айтып бере аласыз ба?
Dialogue: 0,0:30:18.48,0:30:23.99,Default,,0000,0000,0000,,Обочама.
Dialogue: 0,0:30:23.99,0:30:26.49,Default,,0000,0000,0000,,Джулис жақсы.
Dialogue: 0,0:30:26.49,0:30:30.66,Default,,0000,0000,0000,,Сонымен, Юрис мырза.
Dialogue: 0,0:30:30.66,0:30:37.00,Default,,0000,0000,0000,,Әкемге, анама және ініме
Dialogue: 0,0:30:30.66,0:30:37.00,Default,,0000,0000,0000,,Мен сенсіз жазғым келеді.
Dialogue: 0,0:30:37.00,0:30:41.17,Default,,0000,0000,0000,,Сізде хат бар ма?
Dialogue: 0,0:30:37.00,0:30:41.17,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:30:41.17,0:30:44.34,Default,,0000,0000,0000,,Бұл үш адамға жазылған хат.
Dialogue: 0,0:30:44.34,0:30:49.85,Default,,0000,0000,0000,,Барлығы мені жоғалтты
Dialogue: 0,0:30:44.34,0:30:49.85,Default,,0000,0000,0000,,Мен оны кейінірек оқығаныңызды қалаймын.
Dialogue: 0,0:30:49.85,0:30:54.69,Default,,0000,0000,0000,,Сонымен жазуды аяқтасам да
Dialogue: 0,0:30:49.85,0:30:54.69,Default,,0000,0000,0000,,Оны біраз уақытқа қалдырыңыз.
Dialogue: 0,0:30:54.69,0:30:57.36,Default,,0000,0000,0000,,Оны бірден жібермеңіз.
Dialogue: 0,0:30:57.36,0:30:59.36,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:30:59.36,0:31:03.06,Default,,0000,0000,0000,,Оның нені білдіретінін білесіз бе? Сіз мұны істей аласыз ба?
Dialogue: 0,0:31:04.96,0:31:07.47,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:31:07.47,0:31:11.97,Default,,0000,0000,0000,,Мен бұрын да осындай өтініш жасағанмын.
Dialogue: 0,0:31:07.47,0:31:11.97,Default,,0000,0000,0000,,Мен оны қабылдадым.
Dialogue: 0,0:31:11.97,0:31:14.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:31:11.97,0:31:14.64,Default,,0000,0000,0000,,Юрис мырзадан➡
Dialogue: 0,0:31:14.64,0:31:17.31,Default,,0000,0000,0000,,Жасы кіші ханымға➡
Dialogue: 0,0:31:17.31,0:31:20.31,Default,,0000,0000,0000,,Анаң саған хат жазды.
Dialogue: 0,0:31:20.31,0:31:23.15,Default,,0000,0000,0000,,Өзіңіз
Dialogue: 0,0:31:20.31,0:31:23.15,Default,,0000,0000,0000,,Бұл дүниеден кеткен соң да➡
Dialogue: 0,0:31:23.15,0:31:27.82,Default,,0000,0000,0000,,50 жыл
Dialogue: 0,0:31:23.15,0:31:27.82,Default,,0000,0000,0000,,Ол сіздің туған күніңізде жыл сайын келеді.
Dialogue: 0,0:31:27.82,0:31:32.49,Default,,0000,0000,0000,,50 жыл... 50 әріп...?
Dialogue: 0,0:31:32.49,0:31:34.66,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:31:34.66,0:31:38.83,Default,,0000,0000,0000,,Жыл сайын
Dialogue: 0,0:31:34.66,0:31:38.83,Default,,0000,0000,0000,,Сіздің туған күніңіздегі сол хат➡
Dialogue: 0,0:31:38.83,0:31:41.33,Default,,0000,0000,0000,,Ол жеткізілуі керек еді.
Dialogue: 0,0:31:44.17,0:31:49.17,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:31:44.17,0:31:49.17,Default,,0000,0000,0000,,Мен көп тапсырыс бере алмаймын.
Dialogue: 0,0:31:49.17,0:31:53.08,Default,,0000,0000,0000,,Өйткені ол банкада.
Dialogue: 0,0:31:49.17,0:31:53.08,Default,,0000,0000,0000,,Мүмкіндігінше көп жазыңыз.
Dialogue: 0,0:31:55.51,0:31:57.52,Default,,0000,0000,0000,,(құты ашылған дыбыс)
Dialogue: 0,0:31:57.52,0:31:59.68,Default,,0000,0000,0000,,Сонда сіз қанша жаза аласыз?
Dialogue: 0,0:31:59.68,0:32:04.96,Default,,0000,0000,0000,,Үш әріп
Dialogue: 0,0:31:59.68,0:32:04.96,Default,,0000,0000,0000,,Менің ойымша, бұл әр әріпке шамамен 20 таңба.
Dialogue: 0,0:32:04.96,0:32:07.46,Default,,0000,0000,0000,,20 таңба….
Dialogue: 0,0:32:07.46,0:32:12.63,Default,,0000,0000,0000,,«Анаңа, қамқор бол, Джулис».
Dialogue: 0,0:32:12.63,0:32:15.97,Default,,0000,0000,0000,,Мижика!
Dialogue: 0,0:32:12.63,0:32:15.97,Default,,0000,0000,0000,,Мен мұны жаза аламын!
Dialogue: 0,0:32:15.97,0:32:20.31,Default,,0000,0000,0000,,Артық емес
Dialogue: 0,0:32:15.97,0:32:20.31,Default,,0000,0000,0000,,Анам, әкем және інім➡
Dialogue: 0,0:32:20.31,0:32:23.47,Default,,0000,0000,0000,,Осыны оқығаннан кейін өзіңізді жақсы сезінесіз және бар күшіңізді саласыз➡
Dialogue: 0,0:32:23.47,0:32:26.28,Default,,0000,0000,0000,,Міне, осындай хат жазғым келеді!
Dialogue: 0,0:32:33.48,0:32:37.99,Default,,0000,0000,0000,,Құрметті Улисс, сіз бұрын айтқаныңыз
Dialogue: 0,0:32:33.48,0:32:37.99,Default,,0000,0000,0000,,Жалпы төлемдер.
Dialogue: 0,0:32:37.99,0:32:43.16,Default,,0000,0000,0000,,Дегенмен, біздің компания
Dialogue: 0,0:32:37.99,0:32:43.16,Default,,0000,0000,0000,,Балаларға жеңілдік бар.
Dialogue: 0,0:32:37.99,0:32:43.16,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:32:43.16,0:32:46.83,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:32:43.16,0:32:46.83,Default,,0000,0000,0000,,Мына банкадағы ақшамен➡
Dialogue: 0,0:32:46.83,0:32:50.50,Default,,0000,0000,0000,,Улиссенің көңілінен шығатын хат жаз.
Dialogue: 0,0:32:46.83,0:32:50.50,Default,,0000,0000,0000,,Сіз оны сұрай аласыз.
Dialogue: 0,0:32:50.50,0:32:53.17,Default,,0000,0000,0000,,Шынымен бе? ?
Dialogue: 0,0:32:50.50,0:32:53.17,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:32:53.17,0:32:55.17,Default,,0000,0000,0000,,Кездейсоқ нәрселерді айтпаңыз!
Dialogue: 0,0:32:55.17,0:32:58.38,Default,,0000,0000,0000,,Дұрыс айттыңыз ба?
Dialogue: 0,0:32:55.17,0:32:58.38,Default,,0000,0000,0000,,№.
Dialogue: 0,0:33:00.28,0:33:02.61,Default,,0000,0000,0000,,Миссияны орындау➡
Dialogue: 0,0:33:02.61,0:33:06.95,Default,,0000,0000,0000,,Төтенше жағдайда
Dialogue: 0,0:33:02.61,0:33:06.95,Default,,0000,0000,0000,,арнайы ережелер белгіленді.
Dialogue: 0,0:33:06.95,0:33:10.56,Default,,0000,0000,0000,,Төтенше жағдайды қамтамасыз ету.
Dialogue: 0,0:33:12.62,0:33:15.63,Default,,0000,0000,0000,,Мен бұл нені білдіретінін білмеймін, бірақ...
Dialogue: 0,0:33:15.63,0:33:19.03,Default,,0000,0000,0000,,Мен... сықпа!
Dialogue: 0,0:33:21.80,0:33:24.80,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:33:24.80,0:33:28.51,Default,,0000,0000,0000,,Олай болса, бастайық!
Dialogue: 0,0:33:40.82,0:33:44.32,Default,,0000,0000,0000,,А, анау қол...
Dialogue: 0,0:33:44.32,0:33:46.66,Default,,0000,0000,0000,,Біз оны соғыста жоғалттық.
Dialogue: 0,0:33:46.66,0:33:50.50,Default,,0000,0000,0000,,Бірнеше жыл бұрын
Dialogue: 0,0:33:46.66,0:33:50.50,Default,,0000,0000,0000,,Мен де ауруханаға түстім.
Dialogue: 0,0:33:50.50,0:33:53.33,Default,,0000,0000,0000,,Сонымен, сіз хат жаза аласыз ба?
Dialogue: 0,0:33:53.33,0:33:56.67,Default,,0000,0000,0000,,Бұл протездік қол
Dialogue: 0,0:33:53.33,0:33:56.67,Default,,0000,0000,0000,,Оны меңгергенше➡
Dialogue: 0,0:33:56.67,0:33:58.84,Default,,0000,0000,0000,,Біраз уақыт қажет болды, бірақ➡
Dialogue: 0,0:33:58.84,0:34:01.61,Default,,0000,0000,0000,,Енді проблема жоқ.
Dialogue: 0,0:34:01.61,0:34:06.11,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:34:01.61,0:34:06.11,Default,,0000,0000,0000,,Мінез-құлықтың мұндай түрі де мүмкін.
Dialogue: 0,0:34:06.11,0:34:10.45,Default,,0000,0000,0000,,Пфф... Сіз қызықсыз.
Dialogue: 0,0:34:10.45,0:34:13.28,Default,,0000,0000,0000,,Әрқашан «Өзіңді қалай сезінесің?»
Dialogue: 0,0:34:10.45,0:34:13.28,Default,,0000,0000,0000,,«Жақсысың ба?»➡
Dialogue: 0,0:34:13.28,0:34:16.79,Default,,0000,0000,0000,,Тек «қазір демалыңыз» деңіз
Dialogue: 0,0:34:13.28,0:34:16.79,Default,,0000,0000,0000,,Әке мен ана➡
Dialogue: 0,0:34:16.79,0:34:21.13,Default,,0000,0000,0000,,Олар медбикелерден біршама ерекшеленеді.
Dialogue: 0,0:34:21.13,0:34:24.63,Default,,0000,0000,0000,,Сәл басқаша болу деген нені білдіреді?
Dialogue: 0,0:34:24.63,0:34:30.80,Default,,0000,0000,0000,,Уайымдау, жанашырлық, т.б... артық қорғану?
Dialogue: 0,0:34:30.80,0:34:34.81,Default,,0000,0000,0000,,Әйтеуір, солай
Dialogue: 0,0:34:30.80,0:34:34.81,Default,,0000,0000,0000,,Мен одан шаршадым.
Dialogue: 0,0:34:34.81,0:34:38.14,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:34:38.14,0:34:41.48,Default,,0000,0000,0000,,Үшеуі
Dialogue: 0,0:34:38.14,0:34:41.48,Default,,0000,0000,0000,,Эмоцияларды мүмкіндігінше жою.
Dialogue: 0,0:34:41.48,0:34:44.82,Default,,0000,0000,0000,,Хехе... Сіз шынымен қызықсыз.
Dialogue: 0,0:34:44.82,0:34:48.32,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:34:48.32,0:34:50.62,Default,,0000,0000,0000,,Хат жазу.
Dialogue: 0,0:34:52.82,0:34:54.83,Default,,0000,0000,0000,,Әкемге.
Dialogue: 0,0:34:56.99,0:34:59.00,Default,,0000,0000,0000,,Әке.
Dialogue: 0,0:34:59.00,0:35:02.77,Default,,0000,0000,0000,,Иә, әкем соғысқа аттанған.
Dialogue: 0,0:35:02.77,0:35:06.27,Default,,0000,0000,0000,,Лейденшафтлих деп аталатын елге.
Dialogue: 0,0:35:06.27,0:35:11.28,Default,,0000,0000,0000,,Мен жақында ораламын дедім.
Dialogue: 0,0:35:06.27,0:35:11.28,Default,,0000,0000,0000,,Ол әлі оралған жоқ.
Dialogue: 0,0:35:11.28,0:35:17.11,Default,,0000,0000,0000,,Сондықтан мен, ағам, анам
Dialogue: 0,0:35:11.28,0:35:17.11,Default,,0000,0000,0000,,Мен сізге жақсы екенімді айтқым келеді.
Dialogue: 0,0:35:17.11,0:35:20.32,Default,,0000,0000,0000,,Құнды нәрсе болса, оқиғалар мен тонаулар орын алады.
Dialogue: 0,0:35:23.96,0:35:28.13,Default,,0000,0000,0000,,Виолет-чанды шақыр
Dialogue: 0,0:35:23.96,0:35:28.13,Default,,0000,0000,0000,,Біз тамақ ішеміз бе?
Dialogue: 0,0:35:28.13,0:35:31.13,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:35:28.13,0:35:31.13,Default,,0000,0000,0000,,Сол жаққа барайық.
Dialogue: 0,0:35:31.13,0:35:36.33,Default,,0000,0000,0000,,Сол мейрамхана. Виолет бірінші рет
Dialogue: 0,0:35:31.13,0:35:36.33,Default,,0000,0000,0000,,Мен мұнда келгенде барған мейрамхана.
Dialogue: 0,0:35:38.47,0:35:42.14,Default,,0000,0000,0000,,Иә? сен!
Dialogue: 0,0:35:42.14,0:35:44.64,Default,,0000,0000,0000,,Полковник Дитфрид.
Dialogue: 0,0:35:44.64,0:35:49.65,Default,,0000,0000,0000,,Подполковник Ходгинс Жоқ, ол президент болды.
Dialogue: 0,0:35:49.65,0:35:52.65,Default,,0000,0000,0000,,Мен де соғыс біткен соң.
Dialogue: 0,0:35:49.65,0:35:52.65,Default,,0000,0000,0000,,Қанша жыл өтті➡
Dialogue: 0,0:35:52.65,0:35:55.65,Default,,0000,0000,0000,,Мен ұмытып кете беремін.
Dialogue: 0,0:35:55.65,0:35:57.86,Default,,0000,0000,0000,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:36:00.09,0:36:02.29,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:36:16.44,0:36:18.44,Default,,0000,0000,0000,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:36:20.44,0:36:22.45,Default,,0000,0000,0000,,Полковник….
Dialogue: 0,0:36:24.62,0:36:27.79,Default,,0000,0000,0000,,Кешірім сұраймыз. Дөрекілік...
Dialogue: 0,0:36:27.79,0:36:32.79,Default,,0000,0000,0000,,Жоқ, бәрі жақсы. Бұл.
Dialogue: 0,0:36:36.13,0:36:38.96,Default,,0000,0000,0000,,Бұл менікі.
Dialogue: 0,0:36:38.96,0:36:40.97,Default,,0000,0000,0000,,Сен оны жеткізуге келдің бе?
Dialogue: 0,0:36:40.97,0:36:43.97,Default,,0000,0000,0000,,Мен оны тастап кетсем де.
Dialogue: 0,0:36:40.97,0:36:43.97,Default,,0000,0000,0000,,Мен байқадым.
Dialogue: 0,0:36:46.97,0:36:51.48,Default,,0000,0000,0000,,Виолет-чан қайда кетті?
Dialogue: 0,0:36:46.97,0:36:51.48,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:36:51.48,0:36:56.48,Default,,0000,0000,0000,,Зират
Dialogue: 0,0:36:51.48,0:36:56.48,Default,,0000,0000,0000,,Майордың анасының бейіті бар.
Dialogue: 0,0:36:58.48,0:37:03.42,Default,,0000,0000,0000,,Рахмет, полковник.
Dialogue: 0,0:37:03.42,0:37:07.43,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:37:03.42,0:37:07.43,Default,,0000,0000,0000,,Кәне, заттарымызды қойып, тамақтанып алайық.
Dialogue: 0,0:37:07.43,0:37:12.26,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:37:07.43,0:37:12.26,Default,,0000,0000,0000,,Виолетпен барайық.
Dialogue: 0,0:37:12.26,0:37:14.47,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:37:22.27,0:37:25.11,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:37:25.11,0:37:31.28,Default,,0000,0000,0000,,Келесі жолы бізге тиесілі кеме
Dialogue: 0,0:37:25.11,0:37:31.28,Default,,0000,0000,0000,,Мен оны жоюды шештім.
Dialogue: 0,0:37:31.28,0:37:34.62,Default,,0000,0000,0000,,Кеме...?
Dialogue: 0,0:37:34.62,0:37:41.79,Default,,0000,0000,0000,,Ах. Ол да бала еді
Dialogue: 0,0:37:34.62,0:37:41.79,Default,,0000,0000,0000,,Бұл мен жиі мінетін кеме.
Dialogue: 0,0:37:41.79,0:37:46.46,Default,,0000,0000,0000,,Інім оқитын кітаптар бар,
Dialogue: 0,0:37:41.79,0:37:46.46,Default,,0000,0000,0000,,Онда ойыншықтар бар.
Dialogue: 0,0:37:46.46,0:37:49.47,Default,,0000,0000,0000,,Егер сізге бірдеңе керек болса...
Dialogue: 0,0:37:49.47,0:37:55.14,Default,,0000,0000,0000,,Ха... мен оны ала аламын ба?
Dialogue: 0,0:37:55.14,0:37:57.31,Default,,0000,0000,0000,,Мұның бәрі қоқыс.
Dialogue: 0,0:37:57.31,0:38:01.51,Default,,0000,0000,0000,,Мен сізге барамын! кемені байлау
Dialogue: 0,0:37:57.31,0:38:01.51,Default,,0000,0000,0000,,Мен саған келемін!
Dialogue: 0,0:38:06.25,0:38:10.25,Default,,0000,0000,0000,,Қабір басын ай сайын зиярат ету
Dialogue: 0,0:38:06.25,0:38:10.25,Default,,0000,0000,0000,,Мен сенің сонда екеніңді білмедім.
Dialogue: 0,0:38:10.25,0:38:12.92,Default,,0000,0000,0000,,Бұл туралы хабарлауым керек пе еді?
Dialogue: 0,0:38:12.92,0:38:15.93,Default,,0000,0000,0000,,О, жоқ...
Dialogue: 0,0:38:12.92,0:38:15.93,Default,,0000,0000,0000,,Сізге қажеті жоқ.
Dialogue: 0,0:38:15.93,0:38:20.93,Default,,0000,0000,0000,,Бұл жеке деп аталады, солай емес пе?
Dialogue: 0,0:38:20.93,0:38:23.93,Default,,0000,0000,0000,,Сонымен, кемеде...
Dialogue: 0,0:38:23.93,0:38:26.27,Default,,0000,0000,0000,,Барғанда хабарлаймын.
Dialogue: 0,0:38:26.27,0:38:28.44,Default,,0000,0000,0000,,Сондықтан да жақсы.
Dialogue: 0,0:38:28.44,0:38:31.78,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:38:31.78,0:38:34.11,Default,,0000,0000,0000,,Біз бірге барамыз ба?
Dialogue: 0,0:38:34.11,0:38:37.78,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:38:34.11,0:38:37.78,Default,,0000,0000,0000,,Уайымдау, аяушылық және шектен тыс қорғану➡
Dialogue: 0,0:38:37.78,0:38:40.79,Default,,0000,0000,0000,,Президенттер арасынан мүмкіндігінше
Dialogue: 0,0:38:37.78,0:38:40.79,Default,,0000,0000,0000,,Мені шығарып тастаңыз➡
Dialogue: 0,0:38:40.79,0:38:42.79,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:38:42.79,0:38:57.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:38:57.13,0:38:59.64,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:38:57.13,0:38:59.64,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:38:59.64,0:39:01.91,Default,,0000,0000,0000,,Аузыңды жап, тамақ іш!
Dialogue: 0,0:39:01.91,0:39:05.08,Default,,0000,0000,0000,,Виолет дұрыс айтады.
Dialogue: 0,0:39:05.08,0:39:07.75,Default,,0000,0000,0000,,Қанша уақыт болса да
Dialogue: 0,0:39:05.08,0:39:07.75,Default,,0000,0000,0000,,Мен жай ғана уайымдап тұрмын.
Dialogue: 0,0:39:07.75,0:39:12.42,Default,,0000,0000,0000,,Сіз уайымдайсыз.
Dialogue: 0,0:39:07.75,0:39:12.42,Default,,0000,0000,0000,,Оның үстіне Дитфридтің бейбақы➡
Dialogue: 0,0:39:12.42,0:39:15.59,Default,,0000,0000,0000,,Күлгіннің жүрегіндегі саңылауда
Dialogue: 0,0:39:12.42,0:39:15.59,Default,,0000,0000,0000,,Мүмкіндіктерді пайдалану...
Dialogue: 0,0:39:15.59,0:39:19.59,Default,,0000,0000,0000,,Күлгін үшін күтпеген жерден
Dialogue: 0,0:39:15.59,0:39:19.59,Default,,0000,0000,0000,,Ол жақсы сәйкес болуы мүмкін.
Dialogue: 0,0:39:19.59,0:39:22.26,Default,,0000,0000,0000,,Майор туралы естеліктеріңізбен бөліскеніңізге рахмет.
Dialogue: 0,0:39:22.26,0:39:25.60,Default,,0000,0000,0000,,Ол Виолет-чан.
Dialogue: 0,0:39:22.26,0:39:25.60,Default,,0000,0000,0000,,Жетім болу – жақсылық➡
Dialogue: 0,0:39:25.60,0:39:29.60,Default,,0000,0000,0000,,Қабылдау
Dialogue: 0,0:39:25.60,0:39:29.60,Default,,0000,0000,0000,,Соғыс құралы ретінде пайдаланды.
Dialogue: 0,0:39:29.60,0:39:33.10,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:39:29.60,0:39:33.10,Default,,0000,0000,0000,,Мен оған жақындауым керек емес пе?
Dialogue: 0,0:39:33.10,0:39:35.31,Default,,0000,0000,0000,,Қазір олай болмаса да?
Dialogue: 0,0:39:37.27,0:39:41.28,Default,,0000,0000,0000,,Сол екеуі
Dialogue: 0,0:39:37.27,0:39:41.28,Default,,0000,0000,0000,,Бір-біріміздің жарамызды жалаймыз дейсің бе?
Dialogue: 0,0:39:41.28,0:39:43.78,Default,,0000,0000,0000,,Бұл жаман нәрсе ме?
Dialogue: 0,0:39:43.78,0:39:48.29,Default,,0000,0000,0000,,Виолет әлі
Dialogue: 0,0:39:43.78,0:39:48.29,Default,,0000,0000,0000,,Оның майорға деген сезімі бар.
Dialogue: 0,0:39:48.29,0:39:53.46,Default,,0000,0000,0000,,Іс осылай жалғаса берсе, сол сезімдер
Dialogue: 0,0:39:48.29,0:39:53.46,Default,,0000,0000,0000,,Жаншылып кете ме деп уайымдаймын.
Dialogue: 0,0:39:53.46,0:39:55.96,Default,,0000,0000,0000,,Бірақ егер сіз полковник болсаңыз...
Dialogue: 0,0:39:55.96,0:39:59.76,Default,,0000,0000,0000,,Бізге берілмейтін жұбаныш...
Dialogue: 0,0:40:02.47,0:40:07.97,Default,,0000,0000,0000,,егер болашақ
Dialogue: 0,0:40:02.47,0:40:07.97,Default,,0000,0000,0000,,Балалы болсам➡
Dialogue: 0,0:40:07.97,0:40:09.97,Default,,0000,0000,0000,,Менің балам жақсы ғой.
Dialogue: 0,0:40:09.97,0:40:13.48,Default,,0000,0000,0000,,Қыздарда менің жүйкем жоқ!
Dialogue: 0,0:40:15.48,0:40:17.48,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:40:30.66,0:40:35.17,Default,,0000,0000,0000,,Бұл оның осыған әуестенгендіктен.
Dialogue: 0,0:40:30.66,0:40:35.17,Default,,0000,0000,0000,,Бұл мен оқып жүрген кітап.
Dialogue: 0,0:40:35.17,0:40:38.07,Default,,0000,0000,0000,,Мен әкеммен жиі ойын ойнайтынмын.
Dialogue: 0,0:40:41.01,0:40:43.67,Default,,0000,0000,0000,,Бұл да магистратура.
Dialogue: 0,0:40:43.67,0:40:46.58,Default,,0000,0000,0000,,Жоқ, бұл менікі.
Dialogue: 0,0:40:49.18,0:40:52.35,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:40:52.35,0:40:55.19,Default,,0000,0000,0000,,Сізге соншалықты ақылды болудың қажеті жоқ.
Dialogue: 0,0:40:55.19,0:40:57.69,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:40:57.69,0:41:01.13,Default,,0000,0000,0000,,Бала кезіндегі полковник де, майор да➡
Dialogue: 0,0:41:01.13,0:41:04.96,Default,,0000,0000,0000,,Осы кемеде
Dialogue: 0,0:41:01.13,0:41:04.96,Default,,0000,0000,0000,,Сіз теңізге жиі шығатынсыз.
Dialogue: 0,0:41:04.96,0:41:08.47,Default,,0000,0000,0000,,О
Dialogue: 0,0:41:04.96,0:41:08.47,Default,,0000,0000,0000,,Мені сонда әкем алып кетті.
Dialogue: 0,0:41:12.47,0:41:18.14,Default,,0000,0000,0000,,Бұл кітап және ойын тақтасы
Dialogue: 0,0:41:12.47,0:41:18.14,Default,,0000,0000,0000,,Оны қалайтыныңызға сенімдісіз бе?
Dialogue: 0,0:41:18.14,0:41:20.34,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:41:26.82,0:41:29.02,Default,,0000,0000,0000,,Сіз шығасыз ба?
Dialogue: 0,0:41:40.16,0:41:42.17,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:41:45.17,0:41:47.57,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:41:49.84,0:41:52.51,Default,,0000,0000,0000,,Бұл мен жоғалтқан үлкен нәрсе...
Dialogue: 0,0:41:52.51,0:41:56.01,Default,,0000,0000,0000,,Сіз де, мен де...
Dialogue: 0,0:41:58.18,0:42:00.28,Default,,0000,0000,0000,,Өткен күн нашар болды.
Dialogue: 0,0:42:00.28,0:42:06.12,Default,,0000,0000,0000,,Мен сені енді ешқашан көрмеймін, ұмытамын, т.б.
Dialogue: 0,0:42:06.12,0:42:10.63,Default,,0000,0000,0000,,Тіпті мен ұмыта алмаймын.
Dialogue: 0,0:42:10.63,0:42:15.63,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:42:10.63,0:42:15.63,Default,,0000,0000,0000,,Өйткені ол менің інім.
Dialogue: 0,0:42:18.14,0:42:20.14,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:42:22.14,0:42:25.98,Default,,0000,0000,0000,,Қайта кездессек, кешірім сұраймын.
Dialogue: 0,0:42:25.98,0:42:29.48,Default,,0000,0000,0000,,Сондай-ақ, мен тағы бір нәрсе туралы айтқым келеді...
Dialogue: 0,0:42:29.48,0:42:33.48,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:42:37.32,0:42:40.66,Default,,0000,0000,0000,,Енді ініме көшейік.
Dialogue: 0,0:42:40.66,0:42:44.50,Default,,0000,0000,0000,,Айтсаңыз да
Dialogue: 0,0:42:40.66,0:42:44.50,Default,,0000,0000,0000,,Ініме не жазуым керек?
Dialogue: 0,0:42:44.50,0:42:46.83,Default,,0000,0000,0000,,Шион небәрі 5 жаста...
Dialogue: 0,0:42:46.83,0:42:51.17,Default,,0000,0000,0000,,Олай болса, інің
Dialogue: 0,0:42:46.83,0:42:51.17,Default,,0000,0000,0000,,Дүниеге келгенде қандай сезімде болдың➡
Dialogue: 0,0:42:51.17,0:42:53.17,Default,,0000,0000,0000,,Айтса ше?
Dialogue: 0,0:42:53.17,0:42:58.34,Default,,0000,0000,0000,,Ах... мен туғанда
Dialogue: 0,0:42:53.17,0:42:58.34,Default,,0000,0000,0000,,Мен бақытты болдым.
Dialogue: 0,0:42:58.34,0:43:03.15,Default,,0000,0000,0000,,Жаңа піскен нан сияқты
Dialogue: 0,0:42:58.34,0:43:03.15,Default,,0000,0000,0000,,Жылы және жұмсақ.
Dialogue: 0,0:43:05.95,0:43:08.45,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:43:08.45,0:43:14.96,Default,,0000,0000,0000,,Ата-аналарды біртіндеп алып кетеді
Dialogue: 0,0:43:08.45,0:43:14.96,Default,,0000,0000,0000,,Сіз осындай сезімде болдыңыз ба?
Dialogue: 0,0:43:14.96,0:43:16.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:43:16.96,0:43:21.13,Default,,0000,0000,0000,,Ініні көбірек мақтағанда
Dialogue: 0,0:43:16.96,0:43:21.13,Default,,0000,0000,0000,,Бұл қызық болмады.
Dialogue: 0,0:43:21.13,0:43:23.47,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:43:23.47,0:43:28.14,Default,,0000,0000,0000,,Бірақ менің артымнан ерсең
Dialogue: 0,0:43:23.47,0:43:28.14,Default,,0000,0000,0000,,Бұл сүйкімді болды.
Dialogue: 0,0:43:28.14,0:43:32.54,Default,,0000,0000,0000,,Иә. Неге білмейсің?
Dialogue: 0,0:43:34.65,0:43:38.05,Default,,0000,0000,0000,,Мен бәрін естідім.
Dialogue: 0,0:43:42.99,0:43:45.99,Default,,0000,0000,0000,,Олай болса, бұрын не болды?
Dialogue: 0,0:43:42.99,0:43:45.99,Default,,0000,0000,0000,,Осыны қосыңыз.
Dialogue: 0,0:43:45.99,0:43:49.49,Default,,0000,0000,0000,,«Мен мүмкіндігінше өмір сүр.
Dialogue: 0,0:43:49.49,0:43:54.50,Default,,0000,0000,0000,,Және менікі де.
Dialogue: 0,0:43:49.49,0:43:54.50,Default,,0000,0000,0000,,Әкеңмен және анаңмен жақсы қарым-қатынаста бол.
Dialogue: 0,0:43:57.67,0:44:00.27,Default,,0000,0000,0000,,Менікі де...
Dialogue: 0,0:44:00.27,0:44:03.57,Default,,0000,0000,0000,,Әке, ана
Dialogue: 0,0:44:00.27,0:44:03.57,Default,,0000,0000,0000,,Мені көп еркелетіңіз...
Dialogue: 0,0:44:06.78,0:44:11.12,Default,,0000,0000,0000,,Лорд Юрис
Dialogue: 0,0:44:06.78,0:44:11.12,Default,,0000,0000,0000,,Мен қатты еркелеткім келеді➡
Dialogue: 0,0:44:11.12,0:44:13.45,Default,,0000,0000,0000,,Шын мәнінде айтқыңыз келмейтін сөздер➡
Dialogue: 0,0:44:13.45,0:44:17.96,Default,,0000,0000,0000,,Оны лақтырып жібергендей.
Dialogue: 0,0:44:13.45,0:44:17.96,Default,,0000,0000,0000,,Біз сіздің сапарыңызды көрдік.
Dialogue: 0,0:44:17.96,0:44:22.79,Default,,0000,0000,0000,,А... Мен бәрін түсіндім.
Dialogue: 0,0:44:22.79,0:44:26.50,Default,,0000,0000,0000,,Көптеген әріптер
Dialogue: 0,0:44:22.79,0:44:26.50,Default,,0000,0000,0000,,Мен мұны жаздым.
Dialogue: 0,0:44:28.47,0:44:34.14,Default,,0000,0000,0000,,Сөзде, көзқараста және сезімде
Dialogue: 0,0:44:28.47,0:44:34.14,Default,,0000,0000,0000,,Алды мен артқы жағы бар➡
Dialogue: 0,0:44:34.14,0:44:38.48,Default,,0000,0000,0000,,Нені көруге болады
Dialogue: 0,0:44:34.14,0:44:38.48,Default,,0000,0000,0000,,Барлығы емес➡
Dialogue: 0,0:44:38.48,0:44:41.98,Default,,0000,0000,0000,,Бірте-бірте түсіне бастадым.
Dialogue: 0,0:44:41.98,0:44:45.65,Default,,0000,0000,0000,,Бірақ менің шынайы сезімдерім➡
Dialogue: 0,0:44:45.65,0:44:50.35,Default,,0000,0000,0000,,Айтпасаң
Dialogue: 0,0:44:45.65,0:44:50.35,Default,,0000,0000,0000,,Біз түсінбейтін жағдайлар көп.
Dialogue: 0,0:44:53.32,0:44:55.83,Default,,0000,0000,0000,,(Қағаздың дыбысы жойылуда)
Dialogue: 0,0:44:55.83,0:45:00.43,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:44:55.83,0:45:00.43,Default,,0000,0000,0000,,Бұл дұрыс па?
Dialogue: 0,0:45:00.43,0:45:04.27,Default,,0000,0000,0000,,Иә, рахмет.
Dialogue: 0,0:45:04.27,0:45:16.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:16.45,0:45:23.95,Default,,0000,0000,0000,,Олай болса, үш әріп.
Dialogue: 0,0:45:16.45,0:45:23.95,Default,,0000,0000,0000,,Біз оны өте мұқият сақтаймыз.
Dialogue: 0,0:45:23.95,0:45:25.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:45:25.96,0:45:31.80,Default,,0000,0000,0000,,Барлығына, мен жұмаққа бардым.
Dialogue: 0,0:45:25.96,0:45:31.80,Default,,0000,0000,0000,,Оны сол күні беріңіз.
Dialogue: 0,0:45:31.80,0:45:34.80,Default,,0000,0000,0000,,Ауруханадан
Dialogue: 0,0:45:31.80,0:45:34.80,Default,,0000,0000,0000,,Пошта бөлімшесіне хабарлаңыз➡
Dialogue: 0,0:45:34.80,0:45:37.63,Default,,0000,0000,0000,,Мен мұны істеуіңізді сұраймын.
Dialogue: 0,0:45:37.63,0:45:40.14,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:45:40.14,0:45:43.81,Default,,0000,0000,0000,,Эй, сен саусақтарыңды кесіп аласың ба?
Dialogue: 0,0:45:43.81,0:45:46.98,Default,,0000,0000,0000,,Саусақпен кесу?
Dialogue: 0,0:45:43.81,0:45:46.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:45:46.98,0:45:50.98,Default,,0000,0000,0000,,Қызғылт саусақтарыңызды біріктіріңіз.
Dialogue: 0,0:45:50.98,0:45:55.99,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:45:50.98,0:45:55.99,Default,,0000,0000,0000,,Біз уәдемізді орындауға ант етеміз.
Dialogue: 0,0:46:03.26,0:46:05.56,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:46:11.94,0:46:15.27,Default,,0000,0000,0000,,Суық саусақтар.
Dialogue: 0,0:46:15.27,0:46:17.78,Default,,0000,0000,0000,,Қолғап киіп жүрсеңіз де айта аласыз.
Dialogue: 0,0:46:20.61,0:46:25.32,Default,,0000,0000,0000,,Қыс келгенше мен де сенімдімін
Dialogue: 0,0:46:20.61,0:46:25.32,Default,,0000,0000,0000,,Күн суып барады.
Dialogue: 0,0:46:28.79,0:46:30.95,Default,,0000,0000,0000,,Әлі де...
Dialogue: 0,0:46:30.95,0:46:34.79,Default,,0000,0000,0000,,Үріссама қалдырған хат...
Dialogue: 0,0:46:34.79,0:46:39.50,Default,,0000,0000,0000,,Ата-анаң мен ініңнің жүрегі
Dialogue: 0,0:46:34.79,0:46:39.50,Default,,0000,0000,0000,,Жылытады деп ойлаймын.
Dialogue: 0,0:46:41.63,0:46:45.14,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:46:41.63,0:46:45.14,Default,,0000,0000,0000,,Мен сізге хатты беремін.
Dialogue: 0,0:46:47.80,0:46:50.11,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:46:55.31,0:46:59.52,Default,,0000,0000,0000,,Осымен менің миссиям аяқталады.
Dialogue: 0,0:47:11.09,0:47:13.10,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:47:15.27,0:47:20.10,Default,,0000,0000,0000,,Тағы бір нәрсе...
Dialogue: 0,0:47:15.27,0:47:20.10,Default,,0000,0000,0000,,Менің жазғым келген хатым бар.
Dialogue: 0,0:47:20.10,0:47:24.11,Default,,0000,0000,0000,,Сіз Лукассыз ба?
Dialogue: 0,0:47:24.11,0:47:27.61,Default,,0000,0000,0000,,Мен кереует астында тыңдадым.
Dialogue: 0,0:47:27.61,0:47:29.81,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:47:32.45,0:47:36.95,Default,,0000,0000,0000,,Айтқыңыз келген нәрсені мүмкіндігінше айтыңыз
Dialogue: 0,0:47:32.45,0:47:36.95,Default,,0000,0000,0000,,Менің ойымша, оларға айтқан дұрыс.
Dialogue: 0,0:47:36.95,0:47:40.62,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:47:36.95,0:47:40.62,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:47:40.62,0:47:47.97,Default,,0000,0000,0000,,Мен бәрін естимін
Dialogue: 0,0:47:40.62,0:47:47.97,Default,,0000,0000,0000,,Мен тіпті айта алмадым.
Dialogue: 0,0:47:47.97,0:47:49.97,Default,,0000,0000,0000,,Кімге?
Dialogue: 0,0:47:49.97,0:47:54.97,Default,,0000,0000,0000,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:47:49.97,0:47:54.97,Default,,0000,0000,0000,,«Мен сені сүйемін» деген ол.
Dialogue: 0,0:47:54.97,0:47:58.81,Default,,0000,0000,0000,,Бұл адам өлді ме?
Dialogue: 0,0:47:58.81,0:48:04.11,Default,,0000,0000,0000,,Мен бір жерде тұрамын
Dialogue: 0,0:47:58.81,0:48:04.11,Default,,0000,0000,0000,,Мен сенемін.
Dialogue: 0,0:48:06.42,0:48:09.42,Default,,0000,0000,0000,,Ол адамға не айтқыңыз келді?
Dialogue: 0,0:48:11.59,0:48:16.43,Default,,0000,0000,0000,,Мен сені жақсы көремін...бірақ мен аздап түсіндім.
Dialogue: 0,0:48:16.43,0:48:18.60,Default,,0000,0000,0000,,Сіз жаңа ғана түсіндіңіз бе?
Dialogue: 0,0:48:18.60,0:48:32.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:48:32.78,0:48:39.12,Default,,0000,0000,0000,,Мен... Лука маған қонаққа келді.
Dialogue: 0,0:48:32.78,0:48:39.12,Default,,0000,0000,0000,,Келгім келетінін айттым➡
Dialogue: 0,0:48:39.12,0:48:41.52,Default,,0000,0000,0000,,Келме...
Dialogue: 0,0:48:43.45,0:48:46.46,Default,,0000,0000,0000,,Мен Лукаспен кішкентай кезімізден жақсы доспыз➡
Dialogue: 0,0:48:46.46,0:48:50.13,Default,,0000,0000,0000,,Біз үнемі бірге жүгіретінбіз.
Dialogue: 0,0:48:50.13,0:48:55.47,Default,,0000,0000,0000,,Бірақ менің аяғым мен қолым➡
Dialogue: 0,0:48:55.47,0:48:57.97,Default,,0000,0000,0000,,Жіңішкеріп барады...
Dialogue: 0,0:48:57.97,0:49:03.74,Default,,0000,0000,0000,,Мен бұлай көрінгім келмейді.
Dialogue: 0,0:49:03.74,0:49:09.25,Default,,0000,0000,0000,,Сол сезім
Dialogue: 0,0:49:03.74,0:49:09.25,Default,,0000,0000,0000,,Мен оны хат ретінде жазамын.
Dialogue: 0,0:49:09.25,0:49:11.95,Default,,0000,0000,0000,,Құны...
Dialogue: 0,0:49:16.75,0:49:20.59,Default,,0000,0000,0000,,А... иә...
Dialogue: 0,0:49:20.59,0:49:22.59,Default,,0000,0000,0000,,Ugh... ugh!
Dialogue: 0,0:49:22.59,0:49:24.59,Default,,0000,0000,0000,,Лорд Юрис!
Dialogue: 0,0:49:24.59,0:49:26.60,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:49:26.60,0:49:28.60,Default,,0000,0000,0000,,Мен медбикені шақырамын!
Dialogue: 0,0:49:28.60,0:49:31.27,Default,,0000,0000,0000,,Лукасқа хат
Dialogue: 0,0:49:28.60,0:49:31.27,Default,,0000,0000,0000,,Келесі жолы орындайық.
Dialogue: 0,0:49:31.27,0:49:33.94,Default,,0000,0000,0000,,Уф… Уф….
Dialogue: 0,0:49:33.94,0:49:37.11,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:49:37.11,0:49:39.61,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:49:37.11,0:49:39.61,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:50:19.65,0:50:22.05,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:50:26.32,0:50:29.66,Default,,0000,0000,0000,,Осы адрестердің барлығы белгісіз бе?
Dialogue: 0,0:50:29.66,0:50:33.50,Default,,0000,0000,0000,,Роландтың атасынан
Dialogue: 0,0:50:29.66,0:50:33.50,Default,,0000,0000,0000,,Мен өз қолыма алдым.
Dialogue: 0,0:50:33.50,0:50:37.50,Default,,0000,0000,0000,,Егер сіз жіберушіні білсеңіз
Dialogue: 0,0:50:33.50,0:50:37.50,Default,,0000,0000,0000,,Мен оны қайтарып беруді ойладым.
Dialogue: 0,0:50:37.50,0:50:41.67,Default,,0000,0000,0000,,Сонда менің, президенттің сізге көмектескенін қалайсыз ба?
Dialogue: 0,0:50:41.67,0:50:45.51,Default,,0000,0000,0000,,Қазіргі жастар артық жұмысты ұнатпайды ➡
Dialogue: 0,0:50:45.51,0:50:49.51,Default,,0000,0000,0000,,Өйткені сіз көп жұмыс істеп жатырсыз
Dialogue: 0,0:50:45.51,0:50:49.51,Default,,0000,0000,0000,,Мені кем дегенде вице-президент етіп тағайындауыңызды өтінемін.
Dialogue: 0,0:50:52.52,0:50:55.19,Default,,0000,0000,0000,,Олай болса, дұрыс.
Dialogue: 0,0:50:52.52,0:50:55.19,Default,,0000,0000,0000,,Бухгалтерлік мектепке барыңыз.
Dialogue: 0,0:50:55.19,0:50:58.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:50:55.19,0:50:58.02,Default,,0000,0000,0000,,Кітапты оқи алмайтындар➡
Dialogue: 0,0:50:58.02,0:51:00.62,Default,,0000,0000,0000,,Вице-президент бола алмайды.
Dialogue: 0,0:50:58.02,0:51:00.62,Default,,0000,0000,0000,,О!
Dialogue: 0,0:51:00.62,0:51:03.13,Default,,0000,0000,0000,,Мансаптық өсудің жолы енді көз алдында!
Dialogue: 0,0:51:03.13,0:51:05.63,Default,,0000,0000,0000,,Олай болса, сәл күте тұрыңыз.
Dialogue: 0,0:51:03.13,0:51:05.63,Default,,0000,0000,0000,,Мен оны байқап көремін деп ойлаймын!
Dialogue: 0,0:51:08.13,0:51:11.64,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:51:11.64,0:51:16.84,Default,,0000,0000,0000,,Аа, бұл аймақ салыстырмалы түрде жаңа.
Dialogue: 0,0:51:11.64,0:51:16.84,Default,,0000,0000,0000,,Бұл пошта сақталатын сөре.
Dialogue: 0,0:51:18.81,0:51:20.98,Default,,0000,0000,0000,,Бұл кейіпкер….
Dialogue: 0,0:51:20.98,0:51:24.82,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:51:20.98,0:51:24.82,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:51:20.98,0:51:24.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:24.82,0:51:28.99,Default,,0000,0000,0000,,Жіберушінің мекенжайы – Экарт аралы….
Dialogue: 0,0:51:28.99,0:51:33.66,Default,,0000,0000,0000,,Оған дейін Гардарик болған.
Dialogue: 0,0:51:28.99,0:51:33.66,Default,,0000,0000,0000,,Оны басып алды.
Dialogue: 0,0:51:33.66,0:51:37.36,Default,,0000,0000,0000,,Сонда олар соғыстан кейін тәуелсіздік алды ма?
Dialogue: 0,0:51:41.00,0:51:46.50,Default,,0000,0000,0000,,Менімен кездесудегі мақсат не?
Dialogue: 0,0:51:41.00,0:51:46.50,Default,,0000,0000,0000,,Президент мырза.
Dialogue: 0,0:51:46.50,0:51:48.51,Default,,0000,0000,0000,,Өткен күні...
Dialogue: 0,0:51:48.51,0:51:52.18,Default,,0000,0000,0000,,Сіздің орныңыздағы қуыршақ туралы ма?
Dialogue: 0,0:51:52.18,0:51:54.85,Default,,0000,0000,0000,,Ол бірдеңе деді ме?
Dialogue: 0,0:51:54.85,0:51:56.85,Default,,0000,0000,0000,,А... жоқ...
Dialogue: 0,0:51:56.85,0:52:00.78,Default,,0000,0000,0000,,Уайымдамаңыз. Менің кемеме келгеннен кейін➡
Dialogue: 0,0:52:00.78,0:52:06.12,Default,,0000,0000,0000,,Өйткені президент уайымдап отыр
Dialogue: 0,0:52:00.78,0:52:06.12,Default,,0000,0000,0000,,Мен үйге қайттым.
Dialogue: 0,0:52:06.12,0:52:09.46,Default,,0000,0000,0000,,Мен барған кезде хабарлаймын.
Dialogue: 0,0:52:06.12,0:52:09.46,Default,,0000,0000,0000,,Мен осылай дедім...
Dialogue: 0,0:52:09.46,0:52:13.96,Default,,0000,0000,0000,,Сіз оның қамқоршысы емессіз.
Dialogue: 0,0:52:13.96,0:52:17.47,Default,,0000,0000,0000,,Сенің оны байлауға құқығың жоқ.
Dialogue: 0,0:52:22.81,0:52:26.11,Default,,0000,0000,0000,,Сіз...! Сіз айтасыз!
Dialogue: 0,0:52:30.98,0:52:35.29,Default,,0000,0000,0000,,Кешіріңіз, бұл менің кінәм болды.
Dialogue: 0,0:52:38.82,0:52:43.49,Default,,0000,0000,0000,,Мұны айтудың жалғыз жолы
Dialogue: 0,0:52:38.82,0:52:43.49,Default,,0000,0000,0000,,Мәселе мынада, оны орындау мүмкін емес.
Dialogue: 0,0:52:43.49,0:52:47.30,Default,,0000,0000,0000,,Бүгін Виолет-чан туралы.
Dialogue: 0,0:52:43.49,0:52:47.30,Default,,0000,0000,0000,,Мен келмедім.
Dialogue: 0,0:52:54.50,0:52:58.61,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:52:54.50,0:52:58.61,Default,,0000,0000,0000,,Сіз оны қарап шыға аласыз ба?
Dialogue: 0,0:53:04.45,0:53:06.95,Default,,0000,0000,0000,,
Dialogue: 0,0:53:11.29,0:53:13.29,Default,,0000,0000,0000,,Президент.
Dialogue: 0,0:53:13.29,0:53:15.79,Default,,0000,0000,0000,,Кеш болғаны үшін кешіріңіз.
Dialogue: 0,0:53:15.79,0:53:19.30,Default,,0000,0000,0000,,Менің саған айтар сөзім бар.
Dialogue: 0,0:53:25.97,0:53:29.81,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:53:29.81,0:53:34.48,Default,,0000,0000,0000,,Мен оны әлі растаған жоқпын.
Dialogue: 0,0:53:34.48,0:53:39.48,Default,,0000,0000,0000,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:53:34.48,0:53:39.48,Default,,0000,0000,0000,,Басқаша болуы мүмкін.
Dialogue: 0,0:53:47.66,0:53:52.50,Default,,0000,0000,0000,,Шо... Са...?
Dialogue: 0,0:53:52.50,0:53:55.60,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:54:00.44,0:54:04.61,Default,,0000,0000,0000,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:54:04.61,0:54:07.44,Default,,0000,0000,0000,,Майор Гилберт➡ туралы
Dialogue: 0,0:54:07.44,0:54:10.55,Default,,0000,0000,0000,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:54:42.81,0:54:44.98,Default,,0000,0000,0000,,Енді не болады?
Dialogue: 0,0:54:44.98,0:54:48.65,Default,,0000,0000,0000,,А, мен қателескен шығармын.
Dialogue: 0,0:54:44.98,0:54:48.65,Default,,0000,0000,0000,,Мен білмеймін, бірақ мен тырысамын.
Dialogue: 0,0:54:48.65,0:54:54.49,Default,,0000,0000,0000,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:54:48.65,0:54:54.49,Default,,0000,0000,0000,,Жұмысты маған қалдырыңыз!
Dialogue: 0,0:54:54.49,0:54:59.00,Default,,0000,0000,0000,,Виолет, жақсысың ба?
Dialogue: 0,0:54:59.00,0:55:00.93,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:55:00.93,0:55:02.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:55:02.93,0:55:05.77,Default,,0000,0000,0000,,Майормен кездессем де
Dialogue: 0,0:55:02.93,0:55:05.77,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:55:05.77,0:55:08.94,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:55:05.77,0:55:08.94,Default,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:55:08.94,0:55:11.44,Default,,0000,0000,0000,,Аздап
Dialogue: 0,0:55:08.94,0:55:11.44,Default,,0000,0000,0000,,Жылдар өтті➡
Dialogue: 0,0:55:11.44,0:55:15.11,Default,,0000,0000,0000,,Майор мен туралы айтты.
Dialogue: 0,0:55:11.44,0:55:15.11,Default,,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:55:15.11,0:55:17.45,Default,,0000,0000,0000,,Эй... Күлгін...
Dialogue: 0,0:55:17.45,0:55:21.28,Default,,0000,0000,0000,,Мен сені кездестіргенде, мен бірінші істеймін
Dialogue: 0,0:55:17.45,0:55:21.28,Default,,0000,0000,0000,,Мен не айтуым керек?
Dialogue: 0,0:55:21.28,0:55:23.29,Default,,0000,0000,0000,,Бұл қазіргі жағдай ма?
Dialogue: 0,0:55:23.29,0:55:26.29,Default,,0000,0000,0000,,Әлде бұл сезім бе?
Dialogue: 0,0:55:26.29,0:55:29.09,Default,,0000,0000,0000,,Олар
Dialogue: 0,0:55:26.29,0:55:29.09,Default,,0000,0000,0000,,Осыны жақсы жеткізе аласыз ба?
Dialogue: 0,0:55:31.13,0:55:33.13,Default,,0000,0000,0000,,Бұл сізді ыңғайсыз сезіне ме?
Dialogue: 0,0:55:35.63,0:55:38.03,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,0:55:41.81,0:55:44.64,Default,,0000,0000,0000,,Баратын жеріңе дейін ұзақ жол емес пе?
Dialogue: 0,0:55:44.64,0:55:48.14,Default,,0000,0000,0000,,Келгенше неге хат жазбайсың?
Dialogue: 0,0:55:57.82,0:56:00.09,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:56:00.09,0:56:02.09,Default,,0000,0000,0000,,Мен қайтып келдім, Дейзи.
Dialogue: 0,0:56:02.09,0:56:05.93,Default,,0000,0000,0000,,Кеш
Dialogue: 0,0:56:02.09,0:56:05.93,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:56:05.93,0:56:07.93,Default,,0000,0000,0000,,Дейзи?
Dialogue: 0,0:56:16.94,0:56:19.04,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:56:23.95,0:56:28.95,Default,,0000,0000,0000,,«Біраз уақыт
Dialogue: 0,0:56:23.95,0:56:28.95,Default,,0000,0000,0000,,Мен Лейденге барамын.''
Dialogue: 0,0:56:36.13,0:56:57.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:57.15,0:56:59.82,Default,,0000,0000,0000,,《Ромашка: Ол жұмыс істеді.
Dialogue: 0,0:56:57.15,0:56:59.82,Default,,0000,0000,0000,,Пошталық компания ➡
Dialogue: 0,0:56:59.82,0:57:03.25,Default,,0000,0000,0000,,Басқа компаниялармен бірге ұлттық бизнеске айналу➡
Dialogue: 0,0:57:03.25,0:57:06.76,Default,,0000,0000,0000,,Бастапқы ғимарат мұражайға айналдырылды》
Dialogue: 0,0:57:06.76,0:57:24.27,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:24.27,0:57:29.61,Default,,0000,0000,0000,,《Осы жерден шығыңыз.
Dialogue: 0,0:57:24.27,0:57:29.61,Default,,0000,0000,0000,,Қызық, қайда кетті...》
Dialogue: 0,0:57:29.61,0:57:32.28,Default,,0000,0000,0000,,Уақытыңызды бөліңіз.
Dialogue: 0,0:57:32.28,0:57:35.95,Default,,0000,0000,0000,,Аа... Кешіріңіз, байқамай қалдым.
Dialogue: 0,0:57:35.95,0:57:39.96,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:57:35.95,0:57:39.96,Default,,0000,0000,0000,,Сұрайтын бірдеңе болса➡
Dialogue: 0,0:57:39.96,0:57:42.96,Default,,0000,0000,0000,,Менен кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:57:42.96,0:57:45.26,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:57:48.13,0:57:54.47,Default,,0000,0000,0000,,Негізі мен де осында қабылдаудамын.
Dialogue: 0,0:57:48.13,0:57:54.47,Default,,0000,0000,0000,,Мен ол жерде бұрыннан жұмыс істегенмін.
Dialogue: 0,0:57:54.47,0:57:57.27,Default,,0000,0000,0000,,А... Солай ма?
Dialogue: 0,0:57:59.48,0:58:01.48,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:58:17.93,0:58:21.23,Default,,0000,0000,0000,,Сол мөр.
Dialogue: 0,0:58:23.43,0:58:25.44,Default,,0000,0000,0000,,Ах, бұл.
Dialogue: 0,0:58:25.44,0:58:32.04,Default,,0000,0000,0000,,Тек Экарт аралы деп аталатын аралда.
Dialogue: 0,0:58:25.44,0:58:32.04,Default,,0000,0000,0000,,Бұл шығарылған мөр.
Dialogue: 0,0:58:37.11,0:58:39.32,Default,,0000,0000,0000,,Экарт аралы.
Dialogue: 0,0:58:41.95,0:58:46.12,Default,,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:58:41.95,0:58:46.12,Default,,0000,0000,0000,,Мен осында жұмыс істедім➡
Dialogue: 0,0:58:46.12,0:58:49.53,Default,,0000,0000,0000,,Сіз мұны айттыңыз.
Dialogue: 0,0:58:46.12,0:58:49.53,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:58:53.30,0:59:00.07,Default,,0000,0000,0000,,«Ей, береке теңізі.
Dialogue: 0,0:58:53.30,0:59:00.07,Default,,0000,0000,0000,,Барлық әлемді байланыстыратын теңіз.
Dialogue: 0,0:59:00.07,0:59:04.57,Default,,0000,0000,0000,,Аспанда шағалалар ұшады.
Dialogue: 0,0:59:04.57,0:59:09.08,Default,,0000,0000,0000,,Балықтар сенің ішіңде жүзеді.
Dialogue: 0,0:59:09.08,0:59:14.08,Default,,0000,0000,0000,,Қабық сіздің түбіңізде жасырынып жатыр.
Dialogue: 0,0:59:14.08,0:59:18.25,Default,,0000,0000,0000,,Жарық бересің.
Dialogue: 0,0:59:18.25,0:59:21.59,Default,,0000,0000,0000,,Сіз өмірді тәрбиелейсіз.
Dialogue: 0,0:59:21.59,0:59:25.09,Default,,0000,0000,0000,,Махаббатты төгесің.
Dialogue: 0,0:59:25.09,0:59:30.43,Default,,0000,0000,0000,,Мен саған жақын боламын.
Dialogue: 0,0:59:30.43,0:59:33.94,Default,,0000,0000,0000,,Соңына дейін.
Dialogue: 0,0:59:33.94,0:59:38.78,Default,,0000,0000,0000,,Бүгінгіні, өткенді және болашақты қоршау➡
Dialogue: 0,0:59:38.78,0:59:41.78,Default,,0000,0000,0000,,Өзіңе беріле беремін».
Dialogue: 0,0:59:41.78,1:00:01.30,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:00:10.64,1:00:16.31,Default,,0000,0000,0000,,Негізінде біз теңізге алғысымызды білдіреміз.
Dialogue: 0,1:00:10.64,1:00:16.31,Default,,0000,0000,0000,,Бұл оқиға➡
Dialogue: 0,1:00:16.31,1:00:22.62,Default,,0000,0000,0000,,Енді қайтып келмейтіндер
Dialogue: 0,1:00:16.31,1:00:22.62,Default,,0000,0000,0000,,Жоқтау орнына айналды.
Dialogue: 0,1:00:25.49,1:00:28.99,Default,,0000,0000,0000,,Ешкім қайтып оралмады.
Dialogue: 0,1:00:28.99,1:00:32.66,Default,,0000,0000,0000,,Аралда қарт адам мен әйел ғана қалды.
Dialogue: 0,1:00:32.66,1:00:36.50,Default,,0000,0000,0000,,Қалғандары жай ғана балалар.
Dialogue: 0,1:00:36.50,1:00:40.84,Default,,0000,0000,0000,,Теңізде емес, майданда өлме➡
Dialogue: 0,1:00:40.84,1:00:45.17,Default,,0000,0000,0000,,Ата-бабаңды аяймын...
Dialogue: 0,1:00:45.17,1:00:50.18,Default,,0000,0000,0000,,Лейден жауынгерлеріне әкелер
Dialogue: 0,1:00:45.17,1:00:50.18,Default,,0000,0000,0000,,Ол өлтірілді, солай ма?
Dialogue: 0,1:00:50.18,1:00:52.35,Default,,0000,0000,0000,,Хмм… аа….
Dialogue: 0,1:00:52.35,1:00:57.02,Default,,0000,0000,0000,,Лейденнен келген біреу
Dialogue: 0,1:00:52.35,1:00:57.02,Default,,0000,0000,0000,,Мен бәрі өлсе екен.
Dialogue: 0,1:00:57.02,1:00:59.36,Default,,0000,0000,0000,,Менің дауыстап оқығаным –➡
Dialogue: 0,1:00:59.36,1:01:03.63,Default,,0000,0000,0000,,Осы жылы Лейдендегі Алғыс айту күнінде
Dialogue: 0,1:00:59.36,1:01:03.63,Default,,0000,0000,0000,,Бұл құрбандық.
Dialogue: 0,1:01:03.63,1:01:08.63,Default,,0000,0000,0000,,Атақты қуыршақтар
Dialogue: 0,1:01:03.63,1:01:08.63,Default,,0000,0000,0000,,Мен осылай жаздым.
Dialogue: 0,1:01:08.63,1:01:12.84,Default,,0000,0000,0000,,Күлгін... Оны Эвергарден деп атайды...
Dialogue: 0,1:01:15.47,1:01:19.58,Default,,0000,0000,0000,,⚟Барлығыңыз~!
Dialogue: 0,1:01:15.47,1:01:19.58,Default,,0000,0000,0000,,Енді тамақтанайық!
Dialogue: 0,1:01:23.98,1:01:26.48,Default,,0000,0000,0000,,Енді кеттік.
Dialogue: 0,1:01:36.33,1:01:39.16,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:01:39.16,1:01:44.17,Default,,0000,0000,0000,,Мен сізді жақсы көремін, ұстаз!
Dialogue: 0,1:01:44.17,1:01:47.00,Default,,0000,0000,0000,,Әй, тезірек барайық!
Dialogue: 0,1:01:47.00,1:01:50.31,Default,,0000,0000,0000,,Хехехе! Фуфуфу….
Dialogue: 0,1:01:54.01,1:01:57.85,Default,,0000,0000,0000,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,1:01:57.85,1:02:01.78,Default,,0000,0000,0000,,`` Майор, көп уақыт болды.
Dialogue: 0,1:02:01.78,1:02:07.12,Default,,0000,0000,0000,,Мен сені көрмесем де
Dialogue: 0,1:02:01.78,1:02:07.12,Default,,0000,0000,0000,,Күн сайын… Күн сайын➡
Dialogue: 0,1:02:07.12,1:02:10.79,Default,,0000,0000,0000,,Мен майор туралы ойладым.
Dialogue: 0,1:02:10.79,1:02:14.46,Default,,0000,0000,0000,,Ал... дұға арқылы...
Dialogue: 0,1:02:14.46,1:02:18.13,Default,,0000,0000,0000,,Тілегім орындалды.
Dialogue: 0,1:02:18.13,1:02:22.31,Default,,0000,0000,0000,,Егер мен сені бір күні кездестірсем...»》
Dialogue: 0,1:02:22.31,1:03:23.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:03:29.47,1:03:31.64,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,1:03:31.64,1:03:35.48,Default,,0000,0000,0000,,Сен кішкентайсың
Dialogue: 0,1:03:31.64,1:03:35.48,Default,,0000,0000,0000,,Осы жерде күте аласыз ба?
Dialogue: 0,1:03:35.48,1:03:37.48,Default,,0000,0000,0000,,Мен де барамын!
Dialogue: 0,1:03:39.98,1:03:45.32,Default,,0000,0000,0000,,Егер... Мен шынымен де осындамын.
Dialogue: 0,1:03:39.98,1:03:45.32,Default,,0000,0000,0000,,Тіпті бұл Гилберт болса да...
Dialogue: 0,1:03:45.32,1:03:50.16,Default,,0000,0000,0000,,Ол қазір
Dialogue: 0,1:03:45.32,1:03:50.16,Default,,0000,0000,0000,,Мен оның қандай жағдайда екенін білмеймін.
Dialogue: 0,1:03:50.16,1:03:53.50,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,1:03:50.16,1:03:53.50,Default,,0000,0000,0000,,Мәселе жоқ!
Dialogue: 0,1:03:53.50,1:03:58.67,Default,,0000,0000,0000,,Сізге бәрібір...
Dialogue: 0,1:03:58.67,1:04:02.27,Default,,0000,0000,0000,,Оған келсек...
Dialogue: 0,1:04:02.27,1:04:06.44,Default,,0000,0000,0000,,Міне, шын аты
Dialogue: 0,1:04:02.27,1:04:06.44,Default,,0000,0000,0000,,Атын айтпаса керек.
Dialogue: 0,1:04:06.44,1:04:08.44,Default,,0000,0000,0000,,Бұл кішкентай арал.
Dialogue: 0,1:04:08.44,1:04:11.75,Default,,0000,0000,0000,,Тым көп өсек айту
Dialogue: 0,1:04:08.44,1:04:11.75,Default,,0000,0000,0000,,Сізді көтергіңіз келмейді.
Dialogue: 0,1:04:14.45,1:04:17.25,Default,,0000,0000,0000,,Сіз мені күтесіз.
Dialogue: 0,1:04:19.29,1:04:22.46,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,1:04:22.46,1:04:26.96,Default,,0000,0000,0000,,Майормен танысқыңыз келсе
Dialogue: 0,1:04:22.46,1:04:26.96,Default,,0000,0000,0000,,Мен мәңгі күтемін.
Dialogue: 0,1:04:32.47,1:04:37.47,Default,,0000,0000,0000,,Бұл елге бірінші рет келуім...
Dialogue: 0,1:04:32.47,1:04:37.47,Default,,0000,0000,0000,,Неге айналаңа қарамайсың?
Dialogue: 0,1:04:42.81,1:04:45.01,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,1:05:15.95,1:05:20.12,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:05:20.12,1:05:24.29,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:05:24.29,1:05:30.29,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,1:05:30.29,1:05:38.80,Default,,0000,0000,0000,,(көңілді дауыс)
Dialogue: 0,1:05:38.80,1:05:40.80,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:05:38.80,1:05:40.80,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:05:44.81,1:05:46.81,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,1:05:50.31,1:05:54.32,Default,,0000,0000,0000,,Әй, мен ол қартты танымаймын.
Dialogue: 0,1:05:54.32,1:05:58.32,Default,,0000,0000,0000,,Ах... Сәлем!
Dialogue: 0,1:05:58.32,1:06:02.59,Default,,0000,0000,0000,,Ах... Сәлеметсіз бе.
Dialogue: 0,1:06:02.59,1:06:06.10,Default,,0000,0000,0000,,Кімнің әкесі?
Dialogue: 0,1:06:02.59,1:06:06.10,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,1:06:06.10,1:06:08.76,Default,,0000,0000,0000,,Сонда кім?
Dialogue: 0,1:06:06.10,1:06:08.76,Default,,0000,0000,0000,,Күдікті.
Dialogue: 0,1:06:08.76,1:06:12.10,Default,,0000,0000,0000,,Жоқ... Мен поштаданмын.
Dialogue: 0,1:06:12.10,1:06:14.94,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,1:06:12.10,1:06:14.94,Default,,0000,0000,0000,,Мен хат жеткізуге келдім!
Dialogue: 0,1:06:14.94,1:06:18.77,Default,,0000,0000,0000,,Ах... жақсы...
Dialogue: 0,1:06:14.94,1:06:18.77,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:06:18.77,1:06:21.94,Default,,0000,0000,0000,,Мен саған жақсы нәрсе беремін!
Dialogue: 0,1:06:21.94,1:06:25.45,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:06:21.94,1:06:25.45,Default,,0000,0000,0000,,Ахахха таң қалдым!
Dialogue: 0,1:06:25.45,1:06:27.95,Default,,0000,0000,0000,,Ахаха... Үйге қайт!
Dialogue: 0,1:06:25.45,1:06:27.95,Default,,0000,0000,0000,,Ахаха….
Dialogue: 0,1:06:30.79,1:06:33.79,Default,,0000,0000,0000,,Ұлдардың жүйкесі де көп.
Dialogue: 0,1:06:39.13,1:06:41.83,Default,,0000,0000,0000,,Біреудің әпкесі ме?
Dialogue: 0,1:06:45.97,1:06:48.47,Default,,0000,0000,0000,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,1:06:45.97,1:06:48.47,Default,,0000,0000,0000,,Пошташы?
Dialogue: 0,1:06:48.47,1:06:51.81,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,1:06:51.81,1:06:55.14,Default,,0000,0000,0000,,Сізден бір нәрсе сұрасам…
Dialogue: 0,1:06:51.81,1:06:55.14,Default,,0000,0000,0000,,Мен саған жақсы нәрсе беремін!
Dialogue: 0,1:06:55.14,1:06:57.15,Default,,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,1:06:57.15,1:07:01.42,Default,,0000,0000,0000,,Жәндік... Бұл манты ма?
Dialogue: 0,1:07:01.42,1:07:06.26,Default,,0000,0000,0000,,Таң қалмайсың ба?
Dialogue: 0,1:07:01.42,1:07:06.26,Default,,0000,0000,0000,,Алдыңғы аяқтар...
Dialogue: 0,1:07:06.26,1:07:11.46,Default,,0000,0000,0000,,Біреуі жоқ.
Dialogue: 0,1:07:06.26,1:07:11.46,Default,,0000,0000,0000,,Иә, бұл профессор Гилбертпен бірдей.
Dialogue: 0,1:07:14.26,1:07:18.27,Default,,0000,0000,0000,,Мұғалім...
Dialogue: 0,1:07:18.27,1:07:21.60,Default,,0000,0000,0000,,Оң көз де...
Dialogue: 0,1:07:18.27,1:07:21.60,Default,,0000,0000,0000,,Сіз мені жақсы білесіз.
Dialogue: 0,1:07:21.60,1:07:26.44,Default,,0000,0000,0000,,Мұғалім...
Dialogue: 0,1:07:21.60,1:07:26.44,Default,,0000,0000,0000,,Ол сенің мұғалімің, солай ма?
Dialogue: 0,1:07:26.44,1:07:28.44,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:07:33.12,1:07:37.12,Default,,0000,0000,0000,,Мұғалім...
Dialogue: 0,1:07:37.12,1:07:39.96,Default,,0000,0000,0000,,Қалайсың?
Dialogue: 0,1:07:39.96,1:07:44.79,Default,,0000,0000,0000,,Иә! Менің оң қолым жоқ
Dialogue: 0,1:07:39.96,1:07:44.79,Default,,0000,0000,0000,,Турникті тек сол қолыңызбен жасауға болады!
Dialogue: 0,1:07:44.79,1:07:48.63,Default,,0000,0000,0000,,Сіз де жылдам жүгіресіз!
Dialogue: 0,1:07:44.79,1:07:48.63,Default,,0000,0000,0000,,Иә! Өте тез!
Dialogue: 0,1:07:48.63,1:07:51.63,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:07:48.63,1:07:51.63,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,1:07:57.97,1:08:02.41,Default,,0000,0000,0000,,Толығырақ... қосымша
Dialogue: 0,1:07:57.97,1:08:02.41,Default,,0000,0000,0000,,Айтыңызшы?➡
Dialogue: 0,1:08:02.41,1:08:05.75,Default,,0000,0000,0000,,Мұғалім туралы.
Dialogue: 0,1:08:02.41,1:08:05.75,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:08:05.75,1:08:09.42,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:08:05.75,1:08:09.42,Default,,0000,0000,0000,,Ол сондай мейірімді мұғалім!
Dialogue: 0,1:08:09.42,1:08:13.09,Default,,0000,0000,0000,,Түсінбеген кезде
Dialogue: 0,1:08:09.42,1:08:13.09,Default,,0000,0000,0000,,Сіз маған қанша рет қаласаңыз, сонша айта аласыз.
Dialogue: 0,1:08:13.09,1:08:51.29,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:53.30,1:08:55.30,Default,,0000,0000,0000,,
Dialogue: 0,1:08:59.30,1:09:01.57,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:09:01.57,1:09:10.25,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:10.25,1:09:12.25,Default,,0000,0000,0000,,Сіз кіре аласыз.
Dialogue: 0,1:09:26.93,1:09:30.53,Default,,0000,0000,0000,,Мен бір нәрсені түсінбеймін
Dialogue: 0,1:09:26.93,1:09:30.53,Default,,0000,0000,0000,,Егер бар болса... Ха.
Dialogue: 0,1:09:32.60,1:09:36.61,Default,,0000,0000,0000,,Мен олай ойламадым...
Dialogue: 0,1:09:36.61,1:09:38.77,Default,,0000,0000,0000,,Жақсы өмір сүріңіз...
Dialogue: 0,1:09:38.77,1:09:41.28,Default,,0000,0000,0000,,Гилберт….
Dialogue: 0,1:09:44.95,1:09:50.05,Default,,0000,0000,0000,,Мұнда оның аты Гилберт.
Dialogue: 0,1:09:44.95,1:09:50.05,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:09:52.12,1:09:56.96,Default,,0000,0000,0000,,Сізге кенеттен келгенім үшін кешіріңіз.
Dialogue: 0,1:09:52.12,1:09:56.96,Default,,0000,0000,0000,,Бұл жер неге...?
Dialogue: 0,1:09:56.96,1:10:00.06,Default,,0000,0000,0000,,Баланың хаттарын елес етіп жазар еді.
Dialogue: 0,1:10:02.30,1:10:06.80,Default,,0000,0000,0000,,Адрессіз хаттар
Dialogue: 0,1:10:02.30,1:10:06.80,Default,,0000,0000,0000,,Пошта бөлімшесіне оралу.
Dialogue: 0,1:10:06.80,1:10:12.64,Default,,0000,0000,0000,,Жіберушіге қайтару алдында
Dialogue: 0,1:10:06.80,1:10:12.64,Default,,0000,0000,0000,,Мен оны қайтадан тексеремін...
Dialogue: 0,1:10:12.64,1:10:15.64,Default,,0000,0000,0000,,Мен хатты кездейсоқ көрдім.
Dialogue: 0,1:10:18.15,1:10:22.15,Default,,0000,0000,0000,,Сен... мұнда неге келдің?
Dialogue: 0,1:10:27.99,1:10:30.99,Default,,0000,0000,0000,,Сол шешуші шайқастан кейін➡
Dialogue: 0,1:10:30.99,1:10:35.33,Default,,0000,0000,0000,,Түсінген кезде
Dialogue: 0,1:10:30.99,1:10:35.33,Default,,0000,0000,0000,,Ол аурухана төсегінде жатты.
Dialogue: 0,1:10:35.33,1:10:41.04,Default,,0000,0000,0000,,Сәйкестендіру белгісі болмағандықтан
Dialogue: 0,1:10:35.33,1:10:41.04,Default,,0000,0000,0000,,Діни ауруханаға жіберілген көрінеді.
Dialogue: 0,1:10:46.34,1:10:49.35,Default,,0000,0000,0000,,Біраз уақыт ауруханада жұмыс істеді
Dialogue: 0,1:10:46.34,1:10:49.35,Default,,0000,0000,0000,,Көмек бергеннен кейін...
Dialogue: 0,1:10:49.35,1:10:59.69,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:59.69,1:11:05.46,Default,,0000,0000,0000,,Еліме қайтпай, аралап шықтым...
Dialogue: 0,1:11:05.46,1:11:09.57,Default,,0000,0000,0000,,Мен мұнда бір жыл бұрын келгенмін.
Dialogue: 0,1:11:11.63,1:11:15.47,Default,,0000,0000,0000,,Балалар сұрағандай
Dialogue: 0,1:11:11.63,1:11:15.47,Default,,0000,0000,0000,,Хат жазу кезінде➡
Dialogue: 0,1:11:15.47,1:11:17.64,Default,,0000,0000,0000,,Осы мектепте...
Dialogue: 0,1:11:17.64,1:11:23.65,Default,,0000,0000,0000,,Бастапқыда мен бұл туралы әскерилерге хабарлауым керек еді.
Dialogue: 0,1:11:17.64,1:11:23.65,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,1:11:23.65,1:11:28.65,Default,,0000,0000,0000,,Виолет-чан тірі
Dialogue: 0,1:11:23.65,1:11:28.65,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,1:11:30.99,1:11:33.16,Default,,0000,0000,0000,,Аа….
Dialogue: 0,1:11:33.16,1:11:36.49,Default,,0000,0000,0000,,Сонда неге!
Dialogue: 0,1:11:33.16,1:11:36.49,Default,,0000,0000,0000,,Мен сені көруге келген жоқпын!
Dialogue: 0,1:11:36.49,1:11:40.66,Default,,0000,0000,0000,,Виолет-чан... уф...
Dialogue: 0,1:11:40.66,1:11:43.00,Default,,0000,0000,0000,,Ол бала әрқашан➡ болды
Dialogue: 0,1:11:43.00,1:11:46.00,Default,,0000,0000,0000,,Сізді күтіңіз...
Dialogue: 0,1:11:43.00,1:11:46.00,Default,,0000,0000,0000,,Мен ол баланы бақытсыз еттім!
Dialogue: 0,1:11:48.67,1:11:53.38,Default,,0000,0000,0000,,Мен... сенің жаныңдамын.
Dialogue: 0,1:11:48.67,1:11:53.38,Default,,0000,0000,0000,,Онда болмағаны жақсы.
Dialogue: 0,1:11:57.18,1:12:00.68,Default,,0000,0000,0000,,Ол келе жатыр. Оны да.
Dialogue: 0,1:12:03.29,1:12:07.79,Default,,0000,0000,0000,,Мен сені қазір сыртта күтемін.
Dialogue: 0,1:12:07.79,1:12:11.49,Default,,0000,0000,0000,,Бізді… құтқарды ма?
Dialogue: 0,1:12:07.79,1:12:11.49,Default,,0000,0000,0000,,Ол сізбен кездескісі келді ме?
Dialogue: 0,1:12:16.63,1:12:19.64,Default,,0000,0000,0000,,Мен сізбен кездесе алмаймын.
Dialogue: 0,1:12:16.63,1:12:19.64,Default,,0000,0000,0000,,Гилберт.
Dialogue: 0,1:12:19.64,1:12:23.14,Default,,0000,0000,0000,,Мен сені... енді ешқашан көре алмаймын.
Dialogue: 0,1:12:25.97,1:12:28.81,Default,,0000,0000,0000,,Сіз….
Dialogue: 0,1:12:25.97,1:12:28.81,Default,,0000,0000,0000,,Ол қайтыс болды.
Dialogue: 0,1:12:28.81,1:12:32.65,Default,,0000,0000,0000,,Гилберт Бугенвилья қайтыс болды.
Dialogue: 0,1:12:32.65,1:12:34.98,Default,,0000,0000,0000,,Барлығы солай ойлайды➡
Dialogue: 0,1:12:34.98,1:12:40.32,Default,,0000,0000,0000,,Және жылдармен
Dialogue: 0,1:12:34.98,1:12:40.32,Default,,0000,0000,0000,,Ол өзінің өлімін мойындау керек еді.
Dialogue: 0,1:12:40.32,1:12:45.16,Default,,0000,0000,0000,,Сонымен... басқа өмір
Dialogue: 0,1:12:40.32,1:12:45.16,Default,,0000,0000,0000,,Маған өмір сүруге рұқсат етіңіз.
Dialogue: 0,1:12:45.16,1:12:49.67,Default,,0000,0000,0000,,Гильбел….
Dialogue: 0,1:12:45.16,1:12:49.67,Default,,0000,0000,0000,,Қазір... жүзім жинау уақыты.
Dialogue: 0,1:12:49.67,1:12:53.34,Default,,0000,0000,0000,,Мен саған қазірден бастап көмектесемін.
Dialogue: 0,1:12:53.34,1:13:00.78,Default,,0000,0000,0000,,Бұл аралдағы барлық адамдар соғысқа аттанды...
Dialogue: 0,1:12:53.34,1:13:00.78,Default,,0000,0000,0000,,Ешкім оралмаған сияқты.
Dialogue: 0,1:13:00.78,1:13:06.58,Default,,0000,0000,0000,,Ходгинс, қайтып келіңізші.
Dialogue: 0,1:13:12.96,1:13:17.79,Default,,0000,0000,0000,,Сондай-ақ... өзгертілді.
Dialogue: 0,1:13:17.79,1:13:20.10,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:13:24.63,1:13:27.34,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:13:31.47,1:13:34.14,Default,,0000,0000,0000,,｟Жақсы… га… га….
Dialogue: 0,1:13:34.14,1:13:38.85,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:13:34.14,1:13:38.85,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:13:40.82,1:13:42.99,Default,,0000,0000,0000,,Сіз➡
Dialogue: 0,1:13:42.99,1:13:45.59,Default,,0000,0000,0000,,Сен мені жек көресің бе?
Dialogue: 0,1:13:48.66,1:13:53.50,Default,,0000,0000,0000,,Мен сіздің сұрағыңыздың мақсатын түсінбеймін.
Dialogue: 0,1:13:48.66,1:13:53.50,Default,,0000,0000,0000,,Мен қателік жібердім бе?
Dialogue: 0,1:13:53.50,1:13:56.50,Default,,0000,0000,0000,,Егер бірдеңе дұрыс емес болса, мен оны түзетемін.
Dialogue: 0,1:13:56.50,1:14:01.10,Default,,0000,0000,0000,,Маған не қалайтыныңызды айтыңызшы.
Dialogue: 0,1:13:56.50,1:14:01.10,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:14:01.10,1:14:03.61,Default,,0000,0000,0000,,Жаман нәрсе...
Dialogue: 0,1:14:03.61,1:14:08.11,Default,,0000,0000,0000,,Құрал емеспіз деп жатқанда➡
Dialogue: 0,1:14:08.11,1:14:10.61,Default,,0000,0000,0000,,Мен... сен➡
Dialogue: 0,1:14:10.61,1:14:14.28,Default,,0000,0000,0000,,Қолдану….
Dialogue: 0,1:14:10.61,1:14:14.28,Default,,0000,0000,0000,,Әрине оны пайдалану керек!
Dialogue: 0,1:14:14.28,1:14:17.12,Default,,0000,0000,0000,,Мен майордың қаруымын!
Dialogue: 0,1:14:17.12,1:14:19.96,Default,,0000,0000,0000,,Ұрыс жағдайы бізге тиімсіз болып тұрған сияқты.
Dialogue: 0,1:14:19.96,1:14:22.29,Default,,0000,0000,0000,,Әрі қарай не болады?
Dialogue: 0,1:14:22.29,1:14:24.79,Default,,0000,0000,0000,,Майор! Өтінемін, маған тапсырыс беріңіз!
Dialogue: 0,1:14:26.80,1:14:33.60,Default,,0000,0000,0000,,Ха… ха… ха… ха…｠
Dialogue: 0,1:14:39.98,1:14:43.81,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,1:14:43.81,1:14:45.81,Default,,0000,0000,0000,,Президент!
Dialogue: 0,1:14:55.49,1:14:58.99,Default,,0000,0000,0000,,Бұл майор болды... Өйткені, бұл майор болды!
Dialogue: 0,1:14:58.99,1:15:02.10,Default,,0000,0000,0000,,Балалардың сөзін тыңдау.
Dialogue: 0,1:15:06.27,1:15:09.77,Default,,0000,0000,0000,,Мамандыққа
Dialogue: 0,1:15:06.27,1:15:09.77,Default,,0000,0000,0000,,Сіз кездестірдіңіз, солай емес пе?
Dialogue: 0,1:15:09.77,1:15:11.77,Default,,0000,0000,0000,,Аа….
Dialogue: 0,1:15:13.78,1:15:17.61,Default,,0000,0000,0000,,Қол мен көз жарақатын қоспағанда.
Dialogue: 0,1:15:13.78,1:15:17.61,Default,,0000,0000,0000,,Сіз қауіпсізсіз деп үміттенемін! ?
Dialogue: 0,1:15:17.61,1:15:20.95,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:15:17.61,1:15:20.95,Default,,0000,0000,0000,,Олай болса!
Dialogue: 0,1:15:20.95,1:15:23.45,Default,,0000,0000,0000,,Мен сені жақын арада көремін деп үміттенемін! ?
Dialogue: 0,1:15:26.96,1:15:32.26,Default,,0000,0000,0000,,Бұл... мен сені көре алмаймын...
Dialogue: 0,1:15:36.30,1:15:39.80,Default,,0000,0000,0000,,Өміріңде —
Dialogue: 0,1:15:36.30,1:15:39.80,Default,,0000,0000,0000,,Сіз миссиядасыз ба?
Dialogue: 0,1:15:39.80,1:15:42.64,Default,,0000,0000,0000,,Олай болса, ол аяқталғанша күтіңіз.
Dialogue: 0,1:15:42.64,1:15:44.64,Default,,0000,0000,0000,,Олай емес.
Dialogue: 0,1:15:44.64,1:15:47.84,Default,,0000,0000,0000,,Түнге дейін...
Dialogue: 0,1:15:44.64,1:15:47.84,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,1:15:49.98,1:15:52.78,Default,,0000,0000,0000,,Ал... онда ертең...
Dialogue: 0,1:15:56.32,1:15:58.32,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,1:15:58.32,1:16:03.09,Default,,0000,0000,0000,,Ертең мен сені тағы көремін
Dialogue: 0,1:15:58.32,1:16:03.09,Default,,0000,0000,0000,,Онымен кездесіп, сөйлесіңіз.
Dialogue: 0,1:16:03.09,1:16:07.10,Default,,0000,0000,0000,,Ол... мүлде
Dialogue: 0,1:16:03.09,1:16:07.10,Default,,0000,0000,0000,,Мен сенімен кездесуім керек.
Dialogue: 0,1:16:10.27,1:16:14.10,Default,,0000,0000,0000,,Бұл... Менің ойымша, ➡
Dialogue: 0,1:16:14.10,1:16:18.77,Default,,0000,0000,0000,,Майор кездесе алмайды деген сөз емес.
Dialogue: 0,1:16:14.10,1:16:18.77,Default,,0000,0000,0000,,Мен сені көргім келмейді... және➡
Dialogue: 0,1:16:18.77,1:16:20.98,Default,,0000,0000,0000,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,1:16:23.78,1:16:25.78,Default,,0000,0000,0000,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,1:16:27.78,1:16:33.12,Default,,0000,0000,0000,,Жақсы айта алмаймын, бірақ...
Dialogue: 0,1:16:27.78,1:16:33.12,Default,,0000,0000,0000,,Бұл екеумізге де жақсы болар еді...
Dialogue: 0,1:16:33.12,1:16:35.79,Default,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,1:16:35.79,1:16:39.29,Default,,0000,0000,0000,,Мен... Менмін!
Dialogue: 0,1:16:39.29,1:16:42.00,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,1:16:43.97,1:16:45.97,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,1:16:45.97,1:16:54.48,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:59.92,1:17:04.72,Default,,0000,0000,0000,,Егер сіз мұны істей алсаңыз
Dialogue: 0,1:16:59.92,1:17:04.72,Default,,0000,0000,0000,,Жүзімді оңай көтере аласыз.
Dialogue: 0,1:17:06.76,1:17:09.56,Default,,0000,0000,0000,,Шынымен... бұл пайдалы.
Dialogue: 0,1:17:17.93,1:17:21.77,Default,,0000,0000,0000,,Қатты жаңбыр жауады.
Dialogue: 0,1:17:21.77,1:17:23.77,Default,,0000,0000,0000,,Мейірім көрсетпе.
Dialogue: 0,1:17:27.44,1:17:29.78,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:17:29.78,1:17:31.78,Default,,0000,0000,0000,,Мейірім көрсетпе.
Dialogue: 0,1:17:33.78,1:17:39.79,Default,,0000,0000,0000,,А... ха... ха....
Dialogue: 0,1:17:47.63,1:17:49.83,Default,,0000,0000,0000,,Мен таптым.
Dialogue: 0,1:18:11.92,1:18:14.72,Default,,0000,0000,0000,,
Dialogue: 0,1:18:17.76,1:18:19.76,Default,,0000,0000,0000,,Майор.
Dialogue: 0,1:18:22.93,1:18:24.93,Default,,0000,0000,0000,,Майор.
Dialogue: 0,1:18:27.44,1:18:30.27,Default,,0000,0000,0000,,Майор... Майор!
Dialogue: 0,1:18:30.27,1:18:32.57,Default,,0000,0000,0000,,Мейірім көрсетпе.
Dialogue: 0,1:18:50.46,1:18:55.96,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,1:18:50.46,1:18:55.96,Default,,0000,0000,0000,,Үйіңізге.
Dialogue: 0,1:18:55.96,1:19:00.57,Default,,0000,0000,0000,,Майор...тірі болсаң➡
Dialogue: 0,1:19:00.57,1:19:04.24,Default,,0000,0000,0000,,Неліктен мен сізге хабарласуым керек?
Dialogue: 0,1:19:00.57,1:19:04.24,Default,,0000,0000,0000,,Маған бермедің бе?
Dialogue: 0,1:19:04.24,1:19:07.24,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:19:04.24,1:19:07.24,Default,,0000,0000,0000,,Менімен кездеспедің бе?
Dialogue: 0,1:19:09.91,1:19:13.42,Default,,0000,0000,0000,,Мен... майормен танысқым келеді.
Dialogue: 0,1:19:13.42,1:19:17.42,Default,,0000,0000,0000,,Соңғы әңгімені жалғастырғым келеді.
Dialogue: 0,1:19:17.42,1:19:20.92,Default,,0000,0000,0000,,«Мен де сені сүйемін»➡
Dialogue: 0,1:19:20.92,1:19:23.93,Default,,0000,0000,0000,,Енді мен оны аздап түсіндім.
Dialogue: 0,1:19:27.93,1:19:29.93,Default,,0000,0000,0000,,Қайта оралыңыз.
Dialogue: 0,1:19:33.60,1:19:36.44,Default,,0000,0000,0000,,Қайтып кел!
Dialogue: 0,1:19:36.44,1:19:48.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:19:48.78,1:19:52.95,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,1:19:48.78,1:19:52.95,Default,,0000,0000,0000,,Майормен кездескенше➡
Dialogue: 0,1:19:52.95,1:19:56.06,Default,,0000,0000,0000,,Осы жерде күтіңіз.
Dialogue: 0,1:19:58.29,1:20:01.50,Default,,0000,0000,0000,,Мен саған қазір керек емеспін.
Dialogue: 0,1:20:04.13,1:20:09.97,Default,,0000,0000,0000,,Және... сен осында болғанда
Dialogue: 0,1:20:04.13,1:20:09.97,Default,,0000,0000,0000,,есімде.
Dialogue: 0,1:20:09.97,1:20:14.81,Default,,0000,0000,0000,,Мен сені жас кезіңде майданға аттандырдым.
Dialogue: 0,1:20:14.81,1:20:20.65,Default,,0000,0000,0000,,Сіз… менің бұйрығымды тыңдадыңыз….
Dialogue: 0,1:20:20.65,1:20:23.99,Default,,0000,0000,0000,,Екі қолынан айырылды...
Dialogue: 0,1:20:23.99,1:20:37.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:20:37.00,1:20:41.50,Default,,0000,0000,0000,,Майор...
Dialogue: 0,1:20:37.00,1:20:41.50,Default,,0000,0000,0000,,Өкінетініңді көріп тұрмын.
Dialogue: 0,1:20:43.67,1:20:47.51,Default,,0000,0000,0000,,Менің бар болуым...
Dialogue: 0,1:20:47.51,1:20:51.85,Default,,0000,0000,0000,,I… майор….
Dialogue: 0,1:20:51.85,1:20:54.55,Default,,0000,0000,0000,,Сіз мені қинап жатырсыз.
Dialogue: 0,1:20:57.02,1:21:03.96,Default,,0000,0000,0000,,Дәл қазір өзімді... майор сияқты сезінемін.
Dialogue: 0,1:20:57.02,1:21:03.96,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:21:03.96,1:21:07.30,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:21:03.96,1:21:07.30,Default,,0000,0000,0000,,Мүмкін емес ➡
Dialogue: 0,1:21:07.30,1:21:11.63,Default,,0000,0000,0000,,Кішкене... түсіндім.
Dialogue: 0,1:21:11.63,1:21:35.66,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:21:35.66,1:21:41.83,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,1:21:41.83,1:22:29.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:22:29.98,1:22:41.99,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:23:00.28,1:23:04.78,Default,,0000,0000,0000,,Мұны пайдалану керек.
Dialogue: 0,1:23:00.28,1:23:04.78,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:23:04.78,1:23:08.95,Default,,0000,0000,0000,,Мен қайда тұра аламын?
Dialogue: 0,1:23:04.78,1:23:08.95,Default,,0000,0000,0000,,Бұл жалғыз орын.
Dialogue: 0,1:23:08.95,1:23:12.62,Default,,0000,0000,0000,,Бұл тұратын жері жоқ шағын арал.
Dialogue: 0,1:23:12.62,1:23:18.13,Default,,0000,0000,0000,,Виолет-чан, мына маяк
Dialogue: 0,1:23:12.62,1:23:18.13,Default,,0000,0000,0000,,Пошта қызметін де атқарса керек.
Dialogue: 0,1:23:26.30,1:23:28.30,Default,,0000,0000,0000,,｟Гилберт: Түсінемін...
Dialogue: 0,1:23:28.30,1:23:32.64,Default,,0000,0000,0000,,Бұл гүл қайтадан гүлдейді
Dialogue: 0,1:23:28.30,1:23:32.64,Default,,0000,0000,0000,,Бұл маусым.
Dialogue: 0,1:23:32.64,1:23:41.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:23:41.15,1:23:44.99,Default,,0000,0000,0000,,«Ханзаданың көз алдында
Dialogue: 0,1:23:41.15,1:23:44.99,Default,,0000,0000,0000,,Көк сапфир.
Dialogue: 0,1:23:44.99,1:23:48.99,Default,,0000,0000,0000,,Беліндегі қылышта
Dialogue: 0,1:23:44.99,1:23:48.99,Default,,0000,0000,0000,,Ашық қызыл рубин жарқырап тұрды».
Dialogue: 0,1:23:54.00,1:23:58.33,Default,,0000,0000,0000,,біршама
Dialogue: 0,1:23:54.00,1:23:58.33,Default,,0000,0000,0000,,Енді мен оны оңай оқи аламын...
Dialogue: 0,1:23:58.33,1:24:00.34,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:24:06.27,1:24:10.45,Default,,0000,0000,0000,,Менің қасымнан кетпе.
Dialogue: 0,1:24:06.27,1:24:10.45,Default,,0000,0000,0000,,Мен әрқашан сенің жаныңда боламын.
Dialogue: 0,1:24:10.45,1:24:12.45,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:24:14.45,1:24:16.45,Default,,0000,0000,0000,,Иә｠
Dialogue: 0,1:24:21.12,1:24:31.30,Default,,0000,0000,0000,,(Морзе коды)
Dialogue: 0,1:24:31.30,1:24:37.64,Default,,0000,0000,0000,,Сіз Лейден поштасынансыз ба?
Dialogue: 0,1:24:31.30,1:24:37.64,Default,,0000,0000,0000,,А... а... иә.
Dialogue: 0,1:24:37.64,1:24:42.48,Default,,0000,0000,0000,,Виолет Эвергарден дегеніміз не➡
Dialogue: 0,1:24:42.48,1:24:44.98,Default,,0000,0000,0000,,Бұл бұрынғы қыз ба?
Dialogue: 0,1:24:48.32,1:24:52.32,Default,,0000,0000,0000,,Пошта бөлімшесіне
Dialogue: 0,1:24:48.32,1:24:52.32,Default,,0000,0000,0000,,Ол ауруханадан қоңырау шалғанын айтты.
Dialogue: 0,1:24:52.32,1:24:56.49,Default,,0000,0000,0000,,Джулис есімді баланың жағдайы ауыр.
Dialogue: 0,1:24:56.49,1:24:59.16,Default,,0000,0000,0000,,Улисс….
Dialogue: 0,1:24:59.16,1:25:02.10,Default,,0000,0000,0000,,Жерде не…?
Dialogue: 0,1:24:59.16,1:25:02.10,Default,,0000,0000,0000,,Менің….
Dialogue: 0,1:25:02.10,1:25:05.10,Default,,0000,0000,0000,,Сіз тұтынушысыз.
Dialogue: 0,1:25:10.10,1:25:14.11,Default,,0000,0000,0000,,｟Барлығына, мен көкке бардым.
Dialogue: 0,1:25:10.10,1:25:14.11,Default,,0000,0000,0000,,Оны сол күні беріңіз.
Dialogue: 0,1:25:14.11,1:25:16.44,Default,,0000,0000,0000,,Иә｠
Dialogue: 0,1:25:16.44,1:25:36.63,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:25:36.63,1:25:39.63,Default,,0000,0000,0000,,Қайтару.
Dialogue: 0,1:25:36.63,1:25:39.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:25:39.63,1:25:42.14,Default,,0000,0000,0000,,Лейденге қайта келу.
Dialogue: 0,1:25:42.14,1:25:47.81,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,1:25:42.14,1:25:47.81,Default,,0000,0000,0000,,Артқа қайту... осылай боранда.
Dialogue: 0,1:25:47.81,1:25:51.51,Default,,0000,0000,0000,,Кем дегенде таңға дейін
Dialogue: 0,1:25:47.81,1:25:51.51,Default,,0000,0000,0000,,Кемелер жоқ.
Dialogue: 0,1:25:53.48,1:25:58.29,Default,,0000,0000,0000,,Сіз Гилбертпен кездесуге барасыз, солай ма?
Dialogue: 0,1:26:03.59,1:26:07.26,Default,,0000,0000,0000,,Мен сенімен танысқым келеді...
Dialogue: 0,1:26:07.26,1:26:09.60,Default,,0000,0000,0000,,Мен сенімен танысқым келеді!
Dialogue: 0,1:26:09.60,1:26:13.77,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:26:13.77,1:26:17.11,Default,,0000,0000,0000,,Мен саусағымды кесіп алдым!
Dialogue: 0,1:26:17.11,1:26:21.11,Default,,0000,0000,0000,,Мен Джулис-самаға уәде бердім.
Dialogue: 0,1:26:23.95,1:26:26.78,Default,,0000,0000,0000,,Ал... әлі бір әріп қалды➡
Dialogue: 0,1:26:26.78,1:26:28.98,Default,,0000,0000,0000,,Мен сіз сұраған хатты жаза алмадым.
Dialogue: 0,1:26:33.29,1:26:35.96,Default,,0000,0000,0000,,Бірақ қайтуға асығуым керек➡
Dialogue: 0,1:26:35.96,1:26:37.96,Default,,0000,0000,0000,,Үш күн қажет.
Dialogue: 0,1:26:47.14,1:26:49.14,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:26:54.64,1:26:56.64,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:26:56.64,1:26:58.65,Default,,0000,0000,0000,,Мен білемін!
Dialogue: 0,1:26:58.65,1:27:00.65,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:27:03.08,1:27:06.09,Default,,0000,0000,0000,,(Морзе коды)
Dialogue: 0,1:27:08.09,1:27:10.09,Default,,0000,0000,0000,,Дәл қазір, Бенедикт➡
Dialogue: 0,1:27:10.09,1:27:13.43,Default,,0000,0000,0000,,Мен сақтаған хатты ал
Dialogue: 0,1:27:10.09,1:27:13.43,Default,,0000,0000,0000,,Айриспен бірге ауруханаға барған сияқты.
Dialogue: 0,1:27:13.43,1:27:15.60,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:27:15.60,1:27:17.60,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,1:27:20.44,1:27:22.60,Default,,0000,0000,0000,,Ха ха ха ха....
Dialogue: 0,1:27:22.60,1:27:29.11,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:27:29.11,1:27:31.11,Default,,0000,0000,0000,,
Dialogue: 0,1:27:31.11,1:27:33.11,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:27:45.46,1:27:49.46,Default,,0000,0000,0000,,Улисс д'Ор жақсырақ
Dialogue: 0,1:27:45.46,1:27:49.46,Default,,0000,0000,0000,,Ол келді.
Dialogue: 0,1:27:51.47,1:27:53.97,Default,,0000,0000,0000,,Мен сенің жазғаныңды қалаймын
Dialogue: 0,1:27:51.47,1:27:53.97,Default,,0000,0000,0000,,Сізде хат бар, солай ма?
Dialogue: 0,1:27:57.97,1:28:00.74,Default,,0000,0000,0000,,Вио... Ретт?
Dialogue: 0,1:28:00.74,1:28:04.25,Default,,0000,0000,0000,,Сенің орныңа Айрис келді.
Dialogue: 0,1:28:04.25,1:28:08.25,Default,,0000,0000,0000,,Виолет қазір алыс.
Dialogue: 0,1:28:08.25,1:28:11.25,Default,,0000,0000,0000,,Ақырында мен үшін маңызды адамды кездестіре алдым.
Dialogue: 0,1:28:13.59,1:28:17.76,Default,,0000,0000,0000,,Саған «Мен сені сүйемін» деген адам?
Dialogue: 0,1:28:17.76,1:28:21.46,Default,,0000,0000,0000,,Иә... дұрыс.
Dialogue: 0,1:28:23.43,1:28:28.74,Default,,0000,0000,0000,,Тірі екеніңізге қуаныштымын...
Dialogue: 0,1:28:33.61,1:28:35.78,Default,,0000,0000,0000,,Мен сенің айтқаныңды естідім.
Dialogue: 0,1:28:35.78,1:28:42.28,Default,,0000,0000,0000,,Лукасқа хат жазасыз ба?
Dialogue: 0,1:28:35.78,1:28:42.28,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:28:42.28,1:28:44.79,Default,,0000,0000,0000,,Мен не жазуым керек?
Dialogue: 0,1:28:46.79,1:28:49.79,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,1:28:46.79,1:28:49.79,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:28:49.79,1:28:52.09,Default,,0000,0000,0000,,Юрис!
Dialogue: 0,1:28:49.79,1:28:52.09,Default,,0000,0000,0000,,Юрис!
Dialogue: 0,1:28:54.13,1:28:56.46,Default,,0000,0000,0000,,Аа… аа….
Dialogue: 0,1:28:56.46,1:29:05.77,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:29:07.91,1:29:14.42,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:29:14.42,1:29:16.42,Default,,0000,0000,0000,,Улисс….
Dialogue: 0,1:29:16.42,1:29:21.26,Default,,0000,0000,0000,,Қазір бәрі жақсы.
Dialogue: 0,1:29:21.26,1:30:11.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:11.97,1:30:14.64,Default,,0000,0000,0000,,Иә! Қосылыңыз.
Dialogue: 0,1:30:14.64,1:30:16.84,Default,,0000,0000,0000,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,1:30:20.31,1:30:24.02,Default,,0000,0000,0000,,Юрис-кун... Лукас-кун.
Dialogue: 0,1:30:30.49,1:30:32.49,Default,,0000,0000,0000,,Эй, мынау...
Dialogue: 0,1:30:32.49,1:30:35.00,Default,,0000,0000,0000,,☎Мен не істеуім керек! ?
Dialogue: 0,1:30:37.33,1:30:41.50,Default,,0000,0000,0000,,Сәлем, сәлем...
Dialogue: 0,1:30:41.50,1:30:44.67,Default,,0000,0000,0000,,☎Юрис! ?
Dialogue: 0,1:30:41.50,1:30:44.67,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:30:44.67,1:30:48.51,Default,,0000,0000,0000,,☎Сәлеметсіз бе...
Dialogue: 0,1:30:44.67,1:30:48.51,Default,,0000,0000,0000,,Лукас….
Dialogue: 0,1:30:48.51,1:30:51.01,Default,,0000,0000,0000,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,1:30:51.01,1:30:56.02,Default,,0000,0000,0000,,☎Мен... сізге қонаққа барамын.
Dialogue: 0,1:30:51.01,1:30:56.02,Default,,0000,0000,0000,,Келме...
Dialogue: 0,1:30:56.02,1:30:59.52,Default,,0000,0000,0000,,Мені көргің келмейтінін айт...
Dialogue: 0,1:31:06.79,1:31:09.63,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:31:09.63,1:31:13.03,Default,,0000,0000,0000,,☎Кешіріңіз...
Dialogue: 0,1:31:15.97,1:31:21.64,Default,,0000,0000,0000,,Неге кешірім сұрайсың! мен….
Dialogue: 0,1:31:21.64,1:31:25.31,Default,,0000,0000,0000,,☎Маған сені көргім келмейтінін айтты...
Dialogue: 0,1:31:21.64,1:31:25.31,Default,,0000,0000,0000,,Мен мұңайып қалдым➡
Dialogue: 0,1:31:25.31,1:31:27.32,Default,,0000,0000,0000,,Мен Юристің➡ екеніне сенімдімін
Dialogue: 0,1:31:27.32,1:31:32.15,Default,,0000,0000,0000,,Бұл жақсырақ.
Dialogue: 0,1:31:27.32,1:31:32.15,Default,,0000,0000,0000,,Мен өзімді ұстадым, өйткені мен...
Dialogue: 0,1:31:32.15,1:31:39.16,Default,,0000,0000,0000,,Бірақ... Мен оған қарсы тұра алмаймын.
Dialogue: 0,1:31:32.15,1:31:39.16,Default,,0000,0000,0000,,Мен бірнеше рет ауруханаға бардым.
Dialogue: 0,1:31:43.00,1:31:47.10,Default,,0000,0000,0000,,Содан мен терезеден Улисаның түрін көрдім.
Dialogue: 0,1:31:43.00,1:31:47.10,Default,,0000,0000,0000,,Мен оны аздап көрдім.
Dialogue: 0,1:31:50.84,1:31:55.68,Default,,0000,0000,0000,,Кешіріңіз...осы сұмдықты айтқаным үшін.
Dialogue: 0,1:31:55.68,1:31:57.68,Default,,0000,0000,0000,,☎Жоқ.
Dialogue: 0,1:31:57.68,1:32:01.78,Default,,0000,0000,0000,,Мен мүлдем ашуланбаймын.
Dialogue: 0,1:32:01.78,1:32:05.29,Default,,0000,0000,0000,,☎Улисс.
Dialogue: 0,1:32:05.29,1:32:08.79,Default,,0000,0000,0000,,Біз әрқашан дос болдық.
Dialogue: 0,1:32:08.79,1:32:12.99,Default,,0000,0000,0000,,Бұдан былай да
Dialogue: 0,1:32:08.79,1:32:12.99,Default,,0000,0000,0000,,Мәңгілік дос болайық.
Dialogue: 0,1:32:14.96,1:32:19.30,Default,,0000,0000,0000,,Иә... иә.
Dialogue: 0,1:32:19.30,1:32:27.01,Default,,0000,0000,0000,,Жақсы... Рахмет хехе.
Dialogue: 0,1:32:42.49,1:32:46.99,Default,,0000,0000,0000,,Аа... Уф...
Dialogue: 0,1:32:51.33,1:32:54.84,Default,,0000,0000,0000,,Маған ұнамайтын машина...
Dialogue: 0,1:32:51.33,1:32:54.84,Default,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,1:33:00.11,1:33:02.44,Default,,0000,0000,0000,,Юрис!
Dialogue: 0,1:33:00.11,1:33:02.44,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:33:02.44,1:33:04.95,Default,,0000,0000,0000,,Юрис!
Dialogue: 0,1:33:04.95,1:33:07.45,Default,,0000,0000,0000,,Улиссе!
Dialogue: 0,1:33:07.45,1:33:31.77,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:33:38.81,1:33:42.98,Default,,0000,0000,0000,,Мен хат жаза алмадым.
Dialogue: 0,1:33:42.98,1:33:47.82,Default,,0000,0000,0000,,А... у...
Dialogue: 0,1:33:47.82,1:33:50.16,Default,,0000,0000,0000,,Бірақ телефон арқылы➡
Dialogue: 0,1:33:50.16,1:33:53.66,Default,,0000,0000,0000,,Соңында, Лукаспен➡ сөйлесіңіз
Dialogue: 0,1:33:53.66,1:33:58.67,Default,,0000,0000,0000,,Олар дұрыс жеткізе білген сияқты.
Dialogue: 0,1:33:58.67,1:34:03.17,Default,,0000,0000,0000,,«Кешіріңіз» және «Рахмет» деп айтыңыз.
Dialogue: 0,1:34:07.61,1:34:10.95,Default,,0000,0000,0000,,Содан кейін сіз жазған хат➡
Dialogue: 0,1:34:10.95,1:34:14.75,Default,,0000,0000,0000,,Ата-анаңызға және інііңізге
Dialogue: 0,1:34:10.95,1:34:14.75,Default,,0000,0000,0000,,Сен оған дұрыстап берген сияқтысың.
Dialogue: 0,1:34:31.30,1:34:39.31,Default,,0000,0000,0000,,«Ана… құймақ пісіреді.»
Dialogue: 0,1:34:31.30,1:34:39.31,Default,,0000,0000,0000,,Бұл дәмді болды.
Dialogue: 0,1:34:39.31,1:34:47.62,Default,,0000,0000,0000,,Көкөністерді көбірек жесеңіз...
Dialogue: 0,1:34:39.31,1:34:47.62,Default,,0000,0000,0000,,Ана... Ол бақытты болды ма деп ойлаймын».
Dialogue: 0,1:34:50.65,1:34:56.32,Default,,0000,0000,0000,,«Әке. Балық аулау және кемпинг…
Dialogue: 0,1:34:50.65,1:34:56.32,Default,,0000,0000,0000,,Көңілді болды.
Dialogue: 0,1:34:56.32,1:35:03.83,Default,,0000,0000,0000,,Менің әкем мен анам...
Dialogue: 0,1:34:56.32,1:35:03.83,Default,,0000,0000,0000,,Бала болып туылғаныма қуаныштымын.''
Dialogue: 0,1:35:05.93,1:35:08.77,Default,,0000,0000,0000,,«Мен сені жақсы көремін.
Dialogue: 0,1:35:08.77,1:35:12.77,Default,,0000,0000,0000,,Улисс»….
Dialogue: 0,1:35:12.77,1:35:23.95,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:35:23.95,1:35:28.12,Default,,0000,0000,0000,,Менің ағам да хат алды.
Dialogue: 0,1:35:28.12,1:35:31.79,Default,,0000,0000,0000,,Мен?
Dialogue: 0,1:35:28.12,1:35:31.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:35:31.79,1:35:34.30,Default,,0000,0000,0000,,«Сион.
Dialogue: 0,1:35:34.30,1:35:38.97,Default,,0000,0000,0000,,Ашулану немесе дөрекі болу
Dialogue: 0,1:35:34.30,1:35:38.97,Default,,0000,0000,0000,,Сондықтан мен оны дәлелдеймін.
Dialogue: 0,1:35:38.97,1:35:42.30,Default,,0000,0000,0000,,Бірақ сіз туған кезде➡
Dialogue: 0,1:35:42.30,1:35:46.97,Default,,0000,0000,0000,,Мен шынымен бақытты болдым».
Dialogue: 0,1:35:42.30,1:35:46.97,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:35:46.97,1:35:51.31,Default,,0000,0000,0000,,«Мені үлкен аға еткені үшін.
Dialogue: 0,1:35:46.97,1:35:51.31,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:35:51.31,1:35:55.82,Default,,0000,0000,0000,,Қолымнан келгенше өмір сүр.
Dialogue: 0,1:35:55.82,1:35:57.82,Default,,0000,0000,0000,,Содан кейін...
Dialogue: 0,1:35:57.82,1:36:02.26,Default,,0000,0000,0000,,Мен үшін де әкем мен анам.
Dialogue: 0,1:35:57.82,1:36:02.26,Default,,0000,0000,0000,,Оны бағалаңыз.
Dialogue: 0,1:36:02.26,1:36:05.09,Default,,0000,0000,0000,,Жақсы бол.
Dialogue: 0,1:36:05.09,1:36:13.10,Default,,0000,0000,0000,,Мені көп еркелетіңіз. Менің асыл ініме.
Dialogue: 0,1:36:13.10,1:36:16.00,Default,,0000,0000,0000,,Менің ағамнан».
Dialogue: 0,1:36:17.94,1:36:19.94,Default,,0000,0000,0000,,Аха.
Dialogue: 0,1:36:24.28,1:36:26.78,Default,,0000,0000,0000,,Рахмет, ағайын!
Dialogue: 0,1:36:26.78,1:36:31.62,Default,,0000,0000,0000,,Мен бақыттымын!
Dialogue: 0,1:36:26.78,1:36:31.62,Default,,0000,0000,0000,,Анам мен әкем де бақытты, солай ма?
Dialogue: 0,1:36:31.62,1:36:35.12,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:36:31.62,1:36:35.12,Default,,0000,0000,0000,,Аха.
Dialogue: 0,1:36:37.12,1:36:39.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:36:42.46,1:36:46.97,Default,,0000,0000,0000,,Рахмет... Юрис.
Dialogue: 0,1:36:52.47,1:36:59.08,Default,,0000,0000,0000,,Джулис-кун - сізді жақсы көретін адам.
Dialogue: 0,1:36:52.47,1:36:59.08,Default,,0000,0000,0000,,Ол сені кездестіргеніме қуаныштымын деді.
Dialogue: 0,1:37:08.26,1:37:12.26,Default,,0000,0000,0000,,Таң атқанда
Dialogue: 0,1:37:08.26,1:37:12.26,Default,,0000,0000,0000,,Оған тағы барайық.
Dialogue: 0,1:37:12.26,1:37:15.93,Default,,0000,0000,0000,,Егер ол шықпаса
Dialogue: 0,1:37:12.26,1:37:15.93,Default,,0000,0000,0000,,Есікті сындырыңыз➡
Dialogue: 0,1:37:15.93,1:37:20.03,Default,,0000,0000,0000,,Мен оны жұдырықпен ұрсам да...
Dialogue: 0,1:37:15.93,1:37:20.03,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:37:15.93,1:37:20.03,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:37:22.44,1:37:24.44,Default,,0000,0000,0000,,Мажорды басып алсаңыз➡
Dialogue: 0,1:37:24.44,1:37:27.61,Default,,0000,0000,0000,,Мен.
Dialogue: 0,1:37:27.61,1:37:29.94,Default,,0000,0000,0000,,Va….
Dialogue: 0,1:37:27.61,1:37:29.94,Default,,0000,0000,0000,,Әзіл.
Dialogue: 0,1:37:29.94,1:37:35.28,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:37:29.94,1:37:35.28,Default,,0000,0000,0000,,Мен ертеңгі рейспен қайтамын.
Dialogue: 0,1:37:35.28,1:37:39.29,Default,,0000,0000,0000,,Пошта бөлімшесіне.
Dialogue: 0,1:37:35.28,1:37:39.29,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:37:39.29,1:37:45.29,Default,,0000,0000,0000,,Артқа қайтып хат жаз.
Dialogue: 0,1:37:39.29,1:37:45.29,Default,,0000,0000,0000,,Менің жұмысым көп.
Dialogue: 0,1:37:48.46,1:37:51.30,Default,,0000,0000,0000,,Виолет-чан...
Dialogue: 0,1:37:51.30,1:37:54.64,Default,,0000,0000,0000,,Майор қауіпсіз.
Dialogue: 0,1:37:51.30,1:37:54.64,Default,,0000,0000,0000,,Ол тірі болды.
Dialogue: 0,1:37:54.64,1:37:58.84,Default,,0000,0000,0000,,Біз енді ешқашан кездеспеуіміз мүмкін
Dialogue: 0,1:37:54.64,1:37:58.84,Default,,0000,0000,0000,,Мен солай ойладым.
Dialogue: 0,1:38:00.74,1:38:04.25,Default,,0000,0000,0000,,Мен де сенің даусыңды естіп көрейін.
Dialogue: 0,1:38:07.58,1:38:13.59,Default,,0000,0000,0000,,Мен... қазірдің өзінде...
Dialogue: 0,1:38:18.93,1:38:22.93,Default,,0000,0000,0000,,Бұл жеткілікті.
Dialogue: 0,1:38:22.93,1:39:20.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:39:20.09,1:39:23.59,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:39:25.59,1:39:28.26,Default,,0000,0000,0000,,Қайсысын қолданып көріңіз.
Dialogue: 0,1:39:28.26,1:39:51.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:39:51.45,1:39:53.45,Default,,0000,0000,0000,,Міне, келді!
Dialogue: 0,1:39:53.45,1:39:57.12,Default,,0000,0000,0000,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,1:39:53.45,1:39:57.12,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,1:39:57.12,1:40:00.63,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:39:57.12,1:40:00.63,Default,,0000,0000,0000,,Бұл істерді айтарлықтай жеңілдетеді.
Dialogue: 0,1:40:00.63,1:40:04.13,Default,,0000,0000,0000,,Аа, пошташымен.
Dialogue: 0,1:40:00.63,1:40:04.13,Default,,0000,0000,0000,,Әпке.
Dialogue: 0,1:40:04.13,1:40:06.30,Default,,0000,0000,0000,,Аға….
Dialogue: 0,1:40:06.30,1:40:10.30,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,1:40:06.30,1:40:10.30,Default,,0000,0000,0000,,Бұл машина, оны мұғалім жасады!
Dialogue: 0,1:40:12.31,1:40:23.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:40:23.98,1:40:27.59,Default,,0000,0000,0000,,Сәлем! Бұл таңқаларлық емес пе?
Dialogue: 0,1:40:30.66,1:40:33.36,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:40:46.17,1:40:48.18,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:40:48.18,1:40:51.18,Default,,0000,0000,0000,,Мұғалімге бере аласыз ба?
Dialogue: 0,1:40:54.68,1:40:57.85,Default,,0000,0000,0000,,Түсіндім! Мен оны сізге міндетті түрде беремін!
Dialogue: 0,1:40:57.85,1:41:00.65,Default,,0000,0000,0000,,Хе хи, кездескенше!
Dialogue: 0,1:41:28.15,1:41:32.65,Default,,0000,0000,0000,,Оны жалғыз сіз алып жүрмейсіз.
Dialogue: 0,1:41:32.65,1:41:37.49,Default,,0000,0000,0000,,Осы аралдың жігіттері
Dialogue: 0,1:41:32.65,1:41:37.49,Default,,0000,0000,0000,,Жоғалып кеткен адам➡
Dialogue: 0,1:41:37.49,1:41:42.00,Default,,0000,0000,0000,,Сол шайқаста
Dialogue: 0,1:41:37.49,1:41:42.00,Default,,0000,0000,0000,,Көптеген адамдар қайтыс болды ➡
Dialogue: 0,1:41:42.00,1:41:45.00,Default,,0000,0000,0000,,Бұған барлығы кінәлі болуы мүмкін.
Dialogue: 0,1:41:45.00,1:41:48.17,Default,,0000,0000,0000,,Жекпе-жек сізді бай етеді.
Dialogue: 0,1:41:48.17,1:41:51.84,Default,,0000,0000,0000,,Барлығы осылай ойлады...
Dialogue: 0,1:41:51.84,1:41:58.01,Default,,0000,0000,0000,,Лейденшафтлихтен келгендер
Dialogue: 0,1:41:51.84,1:41:58.01,Default,,0000,0000,0000,,Мен бұл жиіркенішті деп ойладым.
Dialogue: 0,1:41:58.01,1:42:07.12,Default,,0000,0000,0000,,Жоқ, бұл жарамайды. Қаш! Жылдам!
Dialogue: 0,1:41:58.01,1:42:07.12,Default,,0000,0000,0000,,Барлығы зардап шекті.
Dialogue: 0,1:42:07.12,1:42:09.32,Default,,0000,0000,0000,,Барлығы….
Dialogue: 0,1:42:13.29,1:42:17.80,Default,,0000,0000,0000,,Қайтаратын жеріңіз болса
Dialogue: 0,1:42:13.29,1:42:17.80,Default,,0000,0000,0000,,Үйге барған дұрыс.
Dialogue: 0,1:42:19.80,1:42:26.61,Default,,0000,0000,0000,,Жоқ... Мен осындамын.
Dialogue: 0,1:42:19.80,1:42:26.61,Default,,0000,0000,0000,,Әрқашан осында.
Dialogue: 0,1:42:29.14,1:42:32.65,Default,,0000,0000,0000,,Бізді құтқаруға болады, бірақ...
Dialogue: 0,1:42:50.33,1:42:52.63,Default,,0000,0000,0000,,Йо.
Dialogue: 0,1:42:58.84,1:43:00.94,Default,,0000,0000,0000,,Сіз осы аралдасыз➡
Dialogue: 0,1:43:00.94,1:43:04.24,Default,,0000,0000,0000,,Ақыры өз жолым
Dialogue: 0,1:43:00.94,1:43:04.24,Default,,0000,0000,0000,,Сізде таңдау болды ма?
Dialogue: 0,1:43:07.28,1:43:10.28,Default,,0000,0000,0000,,Бұл әрине жақсы жер.
Dialogue: 0,1:43:14.29,1:43:16.29,Default,,0000,0000,0000,,Ағай...
Dialogue: 0,1:43:16.29,1:43:19.96,Default,,0000,0000,0000,,Жалқау өмір сүрсем де➡
Dialogue: 0,1:43:19.96,1:43:24.46,Default,,0000,0000,0000,,Анамды жерлеуге арналған
Dialogue: 0,1:43:19.96,1:43:24.46,Default,,0000,0000,0000,,Сіз бетіңізді көрсетпеген шығарсыз.
Dialogue: 0,1:43:24.46,1:43:26.80,Default,,0000,0000,0000,,Маған ұқсамайды➡
Dialogue: 0,1:43:26.80,1:43:29.64,Default,,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,1:43:26.80,1:43:29.64,Default,,0000,0000,0000,,Оны жақсы көретін еді.
Dialogue: 0,1:43:29.64,1:43:31.84,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:43:34.31,1:43:39.48,Default,,0000,0000,0000,,Жарайды, сенікі де.
Dialogue: 0,1:43:34.31,1:43:39.48,Default,,0000,0000,0000,,Виолет анасына қонаққа барады➡
Dialogue: 0,1:43:39.48,1:43:42.65,Default,,0000,0000,0000,,Ай сайын
Dialogue: 0,1:43:39.48,1:43:42.65,Default,,0000,0000,0000,,Ол өзінің қабірін зиярат етуде.
Dialogue: 0,1:43:42.65,1:43:44.65,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:43:44.65,1:43:53.49,Default,,0000,0000,0000,,Бір күні тағы кездессек
Dialogue: 0,1:43:44.65,1:43:53.49,Default,,0000,0000,0000,,Мен кешірім сұрауды ойладым.
Dialogue: 0,1:43:53.49,1:43:55.66,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:43:55.66,1:43:59.17,Default,,0000,0000,0000,,Енді джут қапшыққа салынды➡
Dialogue: 0,1:43:59.17,1:44:02.67,Default,,0000,0000,0000,,Сіз Виолеттің алдындасыз
Dialogue: 0,1:43:59.17,1:44:02.67,Default,,0000,0000,0000,,Мен оны тастағым келеді!
Dialogue: 0,1:44:07.44,1:44:12.95,Default,,0000,0000,0000,,Сол кезде...
Dialogue: 0,1:44:07.44,1:44:12.95,Default,,0000,0000,0000,,Алмауы керек еді.
Dialogue: 0,1:44:12.95,1:44:17.05,Default,,0000,0000,0000,,Сонда шынымен бе?
Dialogue: 0,1:44:12.95,1:44:17.05,Default,,0000,0000,0000,,Сіз не істегіңіз келді?
Dialogue: 0,1:44:19.12,1:44:22.12,Default,,0000,0000,0000,,Ол жас еді➡
Dialogue: 0,1:44:22.12,1:44:27.13,Default,,0000,0000,0000,,Көбірек көңіл көтеріңіз
Dialogue: 0,1:44:22.12,1:44:27.13,Default,,0000,0000,0000,,Уақытыңызды өткізу үшін.
Dialogue: 0,1:44:27.13,1:44:30.13,Default,,0000,0000,0000,,Сүйкімді нәрсе➡
Dialogue: 0,1:44:30.13,1:44:32.83,Default,,0000,0000,0000,,Мейірімді бол.
Dialogue: 0,1:44:36.64,1:44:39.31,Default,,0000,0000,0000,,Әдемі нәрсеге➡
Dialogue: 0,1:44:39.31,1:44:43.61,Default,,0000,0000,0000,,Жүрегіңді секірт.
Dialogue: 0,1:44:45.65,1:44:52.32,Default,,0000,0000,0000,,Мұндай уақыт ...
Dialogue: 0,1:44:45.65,1:44:52.32,Default,,0000,0000,0000,,Мен сізге біраз уақыт өткізуге рұқсат еткім келді...
Dialogue: 0,1:44:52.32,1:44:55.62,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:44:58.16,1:45:01.66,Default,,0000,0000,0000,,(шығыр дыбысы)
Dialogue: 0,1:45:20.61,1:45:22.62,Default,,0000,0000,0000,,Бұл сізге арналған.
Dialogue: 0,1:45:22.62,1:45:24.62,Default,,0000,0000,0000,,Оқыңыз.
Dialogue: 0,1:45:45.97,1:45:49.14,Default,,0000,0000,0000,,《Күлгін: «Құрметті майор Гилберт.
Dialogue: 0,1:45:49.14,1:45:53.31,Default,,0000,0000,0000,,Сізге кенеттен не болды?
Dialogue: 0,1:45:49.14,1:45:53.31,Default,,0000,0000,0000,,Мені кешіріңіз.
Dialogue: 0,1:45:53.31,1:46:00.25,Default,,0000,0000,0000,,Менің майорға жазғаным осы.
Dialogue: 0,1:45:53.31,1:46:00.25,Default,,0000,0000,0000,,Соңғы хат.
Dialogue: 0,1:46:00.25,1:46:05.59,Default,,0000,0000,0000,,Мен қазір тірімін➡
Dialogue: 0,1:46:05.59,1:46:13.27,Default,,0000,0000,0000,,Мен біреу туралы ойлай бастадым
Dialogue: 0,1:46:05.59,1:46:13.27,Default,,0000,0000,0000,,Сізге рахмет.
Dialogue: 0,1:46:13.27,1:46:20.11,Default,,0000,0000,0000,,Мені қабылдағаныңызға рахмет.
Dialogue: 0,1:46:13.27,1:46:20.11,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,1:46:20.11,1:46:24.11,Default,,0000,0000,0000,,Кітап оқу➡
Dialogue: 0,1:46:24.11,1:46:29.28,Default,,0000,0000,0000,,Хаттар және басқа да заттар
Dialogue: 0,1:46:24.11,1:46:29.28,Default,,0000,0000,0000,,Айтыңызшы➡
Dialogue: 0,1:46:29.28,1:46:31.49,Default,,0000,0000,0000,,Сізге көп рахмет»》
Dialogue: 0,1:46:37.29,1:46:44.63,Default,,0000,0000,0000,,``Маған брошь сатып беріңізші.
Dialogue: 0,1:46:37.29,1:46:44.63,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,1:46:44.63,1:46:46.97,Default,,0000,0000,0000,,Әрқашан...
Dialogue: 0,1:46:46.97,1:46:50.97,Default,,0000,0000,0000,,Әрқашан қасымда болғаныңыз үшін рахмет➡
Dialogue: 0,1:46:50.97,1:46:53.77,Default,,0000,0000,0000,,Көп рахмет»》
Dialogue: 0,1:46:56.81,1:46:58.81,Default,,0000,0000,0000,,｟Ааа...
Dialogue: 0,1:47:00.75,1:47:03.25,Default,,0000,0000,0000,,Құрметпен...｠
Dialogue: 0,1:47:07.59,1:47:14.80,Default,,0000,0000,0000,,《“Мен сені сүйемін”...
Dialogue: 0,1:47:07.59,1:47:14.80,Default,,0000,0000,0000,,Сізге көп рахмет»》
Dialogue: 0,1:47:18.93,1:47:22.10,Default,,0000,0000,0000,,``Майор:``Мен сені жақсы көремін'' деді.
Dialogue: 0,1:47:18.93,1:47:22.10,Default,,0000,0000,0000,,Сіз не айттыңыз➡
Dialogue: 0,1:47:22.10,1:47:27.27,Default,,0000,0000,0000,,Менің өмірім
Dialogue: 0,1:47:22.10,1:47:27.27,Default,,0000,0000,0000,,Ол жол көрсетуші тірекке айналды.
Dialogue: 0,1:47:27.27,1:47:33.28,Default,,0000,0000,0000,,Және «Мен сені сүйемін»➡ үйренгендіктен
Dialogue: 0,1:47:33.28,1:47:36.45,Default,,0000,0000,0000,,«Мен сені сүйемін»
Dialogue: 0,1:47:33.28,1:47:36.45,Default,,0000,0000,0000,,Мен сізге айтқым келді.''
Dialogue: 0,1:47:36.45,1:47:46.29,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:47:46.29,1:47:48.46,Default,,0000,0000,0000,,《“Майор….
Dialogue: 0,1:47:48.46,1:47:51.57,Default,,0000,0000,0000,,Көп рахмет»》
Dialogue: 0,1:47:53.97,1:47:56.64,Default,,0000,0000,0000,,《«Осы уақытқа дейін➡
Dialogue: 0,1:47:56.64,1:48:01.24,Default,,0000,0000,0000,,Сізге көп рахмет»》
Dialogue: 0,1:48:01.24,1:48:32.77,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:48:32.77,1:48:39.28,Default,,0000,0000,0000,,Барлығы... қысқаша.
Dialogue: 0,1:48:32.77,1:48:39.28,Default,,0000,0000,0000,,Сіз шыншыл бола алмайсыз.
Dialogue: 0,1:48:39.28,1:48:51.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:48:51.96,1:48:55.63,Default,,0000,0000,0000,,Мен Бугенвиланың үйін мұраға аламын.
Dialogue: 0,1:48:55.63,1:48:58.83,Default,,0000,0000,0000,,Сіз қазір бос болуыңыз керек.
Dialogue: 0,1:49:05.41,1:49:07.41,Default,,0000,0000,0000,,Бару.
Dialogue: 0,1:49:09.91,1:49:20.09,Default,,0000,0000,0000,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:49:20.09,1:49:32.43,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:49:32.43,1:49:36.44,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,1:49:36.44,1:49:48.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:49:48.11,1:49:54.29,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,1:49:54.29,1:49:56.29,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:49:56.29,1:50:03.30,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:50:03.30,1:50:05.80,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:50:05.80,1:50:09.47,Default,,0000,0000,0000,,Ха ха ха ха ха ха….
Dialogue: 0,1:50:09.47,1:50:26.32,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:50:26.32,1:50:29.32,Default,,0000,0000,0000,,Жылдамдық көрсетілмеген.
Dialogue: 0,1:50:26.32,1:50:29.32,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,1:50:31.49,1:50:33.49,Default,,0000,0000,0000,,Ммм… Ммм….
Dialogue: 0,1:50:33.49,1:50:36.50,Default,,0000,0000,0000,,Күлгін!
Dialogue: 0,1:50:44.17,1:50:46.84,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:50:46.84,1:50:49.34,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,1:50:52.01,1:50:54.18,Default,,0000,0000,0000,,Гилберт.
Dialogue: 0,1:50:54.18,1:51:14.47,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:51:14.47,1:51:16.80,Default,,0000,0000,0000,,Хмм... Майор!
Dialogue: 0,1:51:16.80,1:51:19.47,Default,,0000,0000,0000,,Жылдамдық көрсетілмеген.
Dialogue: 0,1:51:19.47,1:51:34.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:51:34.99,1:51:40.83,Default,,0000,0000,0000,,Ха ха ха ха ха ха….
Dialogue: 0,1:51:40.83,1:51:48.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:51:48.67,1:51:54.17,Default,,0000,0000,0000,,Ха... ха... ха... ха....
Dialogue: 0,1:51:54.17,1:52:08.19,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:52:18.30,1:52:20.30,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:52:24.97,1:52:28.48,Default,,0000,0000,0000,,Күлгін... Мен қазірдің өзінде➡
Dialogue: 0,1:52:28.48,1:52:31.08,Default,,0000,0000,0000,,Сіздің қожайыныңыз немесе бастығыңыз емес.
Dialogue: 0,1:52:33.98,1:52:37.15,Default,,0000,0000,0000,,Мен сені ренжіттім.
Dialogue: 0,1:52:37.15,1:52:43.32,Default,,0000,0000,0000,,Мен...
Dialogue: 0,1:52:37.15,1:52:43.32,Default,,0000,0000,0000,,Ол сіз ойлағандай адам емес.
Dialogue: 0,1:52:43.32,1:52:48.53,Default,,0000,0000,0000,,Шебер керемет болса да...
Dialogue: 0,1:52:43.32,1:52:48.53,Default,,0000,0000,0000,,Ол тіпті жақсы адам емес.
Dialogue: 0,1:52:52.00,1:52:56.50,Default,,0000,0000,0000,,Мен сенімдімін... Мен саған лайық емеспін.
Dialogue: 0,1:53:04.11,1:53:06.31,Default,,0000,0000,0000,,Әлі де...
Dialogue: 0,1:53:13.95,1:53:19.63,Default,,0000,0000,0000,,Қазір де... сіз...
Dialogue: 0,1:53:19.63,1:53:22.13,Default,,0000,0000,0000,,Мен сені жақсы көремін.
Dialogue: 0,1:53:26.30,1:53:28.80,Default,,0000,0000,0000,,Мен….
Dialogue: 0,1:53:32.47,1:53:37.14,Default,,0000,0000,0000,,Қасымда болғаныңды қалаймын... Күлгін.
Dialogue: 0,1:53:37.14,1:53:42.15,Default,,0000,0000,0000,,Уф… Мен….
Dialogue: 0,1:53:46.82,1:53:49.62,Default,,0000,0000,0000,,Шо….
Dialogue: 0,1:53:53.66,1:53:56.06,Default,,0000,0000,0000,,Шо….
Dialogue: 0,1:53:58.00,1:54:03.10,Default,,0000,0000,0000,,Мен... аа... уф.
Dialogue: 0,1:54:03.10,1:54:05.10,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:54:05.10,1:54:07.11,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:54:05.10,1:54:07.11,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:54:07.11,1:54:10.11,Default,,0000,0000,0000,,Жылама.
Dialogue: 0,1:54:07.11,1:54:10.11,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:54:10.11,1:54:18.62,Default,,0000,0000,0000,,Сезіп тұрмын... білесің бе... Мен де жылайын деп тұрмын.
Dialogue: 0,1:54:10.11,1:54:18.62,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:54:18.62,1:54:23.12,Default,,0000,0000,0000,,Көз жасыңды сүрткім келеді.
Dialogue: 0,1:54:18.62,1:54:23.12,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:54:23.12,1:54:28.03,Default,,0000,0000,0000,,Өтінемін... жоғары қараңыз.
Dialogue: 0,1:54:32.80,1:54:35.64,Default,,0000,0000,0000,,Мен….
Dialogue: 0,1:54:35.64,1:54:41.14,Default,,0000,0000,0000,,Уау...майор...
Dialogue: 0,1:54:46.65,1:54:51.15,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:54:51.15,1:55:15.78,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:55:15.78,1:55:17.78,Default,,0000,0000,0000,,Мен сені жақсы көремін.
Dialogue: 0,1:55:17.78,1:55:21.28,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:55:21.28,1:55:25.12,Default,,0000,0000,0000,,Мен мұны әрқашан істегім келді.
Dialogue: 0,1:55:25.12,1:55:40.03,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:55:54.98,1:57:07.59,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:57:19.93,1:58:50.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:59:05.91,1:59:10.24,Default,,0000,0000,0000,,《Ол жұмысқа кірісті
Dialogue: 0,1:59:05.91,1:59:10.24,Default,,0000,0000,0000,,Барлығы аяқталғанда➡
Dialogue: 0,1:59:10.24,1:59:14.41,Default,,0000,0000,0000,,Мен жұмыс істеген пошта бөлімшесін тастаңыз➡
Dialogue: 0,1:59:14.41,1:59:20.42,Default,,0000,0000,0000,,Аралдағы маяк
Dialogue: 0,1:59:14.41,1:59:20.42,Default,,0000,0000,0000,,Пошта қызметін мұра етті.
Dialogue: 0,1:59:20.42,1:59:24.92,Default,,0000,0000,0000,,Енді сол пошта бөлімшесі де➡
Dialogue: 0,1:59:24.92,1:59:28.43,Default,,0000,0000,0000,,Қала көшесіне көшкен сияқты》
Dialogue: 0,1:59:44.11,1:59:46.11,Default,,0000,0000,0000,,《Мен телефон соғуға болады➡
Dialogue: 0,1:59:46.11,1:59:49.62,Default,,0000,0000,0000,,Қуыршақтың кәсібі
Dialogue: 0,1:59:46.11,1:59:49.62,Default,,0000,0000,0000,,Ескі болып қалды дейді...》
Dialogue: 0,1:59:51.62,1:59:54.95,Default,,0000,0000,0000,,《Мүмкін
Dialogue: 0,1:59:51.62,1:59:54.95,Default,,0000,0000,0000,,Ол осында➡
Dialogue: 0,1:59:54.95,1:59:57.12,Default,,0000,0000,0000,,Барлығына➡
Dialogue: 0,1:59:57.12,2:00:00.13,Default,,0000,0000,0000,,Көптеген әріптер
Dialogue: 0,1:59:57.12,2:00:00.13,Default,,0000,0000,0000,,Өз атынан жазған шығар》
Dialogue: 0,2:00:05.63,2:00:07.63,Default,,0000,0000,0000,,《Егер олай болмаса...》
Dialogue: 0,2:00:10.30,2:00:14.81,Default,,0000,0000,0000,,Бұл мөр
Dialogue: 0,2:00:10.30,2:00:14.81,Default,,0000,0000,0000,,Тек осы аралда сатылады➡
Dialogue: 0,2:00:14.81,2:00:18.64,Default,,0000,0000,0000,,C. H Post Memorial Foundation баспасында
Dialogue: 0,2:00:14.81,2:00:18.64,Default,,0000,0000,0000,,Бұл мөр.
Dialogue: 0,2:00:18.64,2:00:23.48,Default,,0000,0000,0000,,Бұл арал
Dialogue: 0,2:00:18.64,2:00:23.48,Default,,0000,0000,0000,,Адамның бір жылда жіберетін хаттарының саны ➡
Dialogue: 0,2:00:23.48,2:00:27.15,Default,,0000,0000,0000,,Бұл Жапонияда ең көп таралған.
Dialogue: 0,2:00:27.15,2:00:30.99,Default,,0000,0000,0000,,Бұрын қуыршақ деген жұмыс болған.
Dialogue: 0,2:00:30.99,2:00:34.83,Default,,0000,0000,0000,,Сондай-ақ осы аралда
Dialogue: 0,2:00:30.99,2:00:34.83,Default,,0000,0000,0000,,Оны бәрі жақсы көретін➡
Dialogue: 0,2:00:34.83,2:00:37.53,Default,,0000,0000,0000,,Танымал қуыршақтар
Dialogue: 0,2:00:34.83,2:00:37.53,Default,,0000,0000,0000,,Мен сонда болдым.
Dialogue: 0,2:00:45.34,2:00:47.34,Default,,0000,0000,0000,,Аты….
Dialogue: 0,2:00:47.34,2:00:49.68,Default,,0000,0000,0000,,Күлгін Эвергарден.
Dialogue: 0,2:00:49.68,2:00:51.68,Default,,0000,0000,0000,,Ах...
Dialogue: 0,2:00:54.35,2:00:56.35,Default,,0000,0000,0000,,Менің әжем де➡
Dialogue: 0,2:00:56.35,2:00:59.65,Default,,0000,0000,0000,,Оған хат жаз
Dialogue: 0,2:00:56.35,2:00:59.65,Default,,0000,0000,0000,,Бірде маған біреу жазып берді.
Dialogue: 0,2:01:07.79,2:01:09.80,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,2:01:09.80,2:01:11.80,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,2:01:15.64,2:01:21.34,Default,,0000,0000,0000,,《Сөзбен айтып жеткізе алмасаң да...
Dialogue: 0,2:01:15.64,2:01:21.34,Default,,0000,0000,0000,,Хат жіберуге болады》
Dialogue: 0,2:01:24.14,2:01:28.81,Default,,0000,0000,0000,,《Мен де өзімнің шынайы сезімімді жеткізгім келеді.
Dialogue: 0,2:01:28.81,2:01:32.65,Default,,0000,0000,0000,,Айтқыңыз келген адамға...
Dialogue: 0,2:01:32.65,2:01:38.06,Default,,0000,0000,0000,,Өйткені мен қазір ғана осындамын》
Dialogue: 0,2:01:53.51,2:01:56.51,Default,,0000,0000,0000,,``Әке.
Dialogue: 0,2:01:56.51,2:02:01.95,Default,,0000,0000,0000,,Анам.
Dialogue: 0,2:02:01.95,2:02:04.75,Default,,0000,0000,0000,,Рахмет»》
