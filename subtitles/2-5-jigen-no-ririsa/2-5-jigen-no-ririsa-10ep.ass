Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:05.00,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:13.63,0:00:15.26,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:00:15.34,0:00:16.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:16.26,0:00:19.89,Default,,0,0,0,,Өйткені, түсірілім қашан бітетіні маңызды емес.
Dialogue: 0,0:00:19.97,0:00:21.10,Default,,0,0,0,,Міне!
Dialogue: 0,0:00:21.18,0:00:23.94,Default,,0,0,0,,Егер 753♡ осылай қайтарылса, галереядағы барлық адамдар...
Dialogue: 0,0:00:27.02,0:00:30.98,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.98,0:01:54.36,Default,,0,0,0,,～♪
Dialogue: 0,0:02:02.03,0:02:04.91,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:02:09.67,0:02:12.09,Default,,0,0,0,,Әй, мен мұны тағы біраз жасайын.
Dialogue: 0,0:02:12.17,0:02:13.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:13.09,0:02:15.05,Default,,0,0,0,,Кай-сама әлі келген жоқ.
Dialogue: 0,0:02:15.13,0:02:18.01,Default,,0,0,0,,Мен... Сенің сезіміңді түсінемін.
Dialogue: 0,0:02:18.09,0:02:20.68,Default,,0,0,0,,753♡ қазірдің өзінде кәсіпқой, солай ма?
Dialogue: 0,0:02:22.05,0:02:25.43,Default,,0,0,0,,Мен басқа косплейлерден ерекшемін.
Dialogue: 0,0:02:25.52,0:02:27.68,Default,,0,0,0,,753♡chan Біткен сияқты.
Dialogue: 0,0:02:27.77,0:02:29.77,Default,,0,0,0,,Сіз корпоративтік стендтерге барасыз ба?
Dialogue: 0,0:02:29.85,0:02:31.19,Default,,0,0,0,,Басқа қабаттарды суретке түсіргіңіз келе ме?
Dialogue: 0,0:02:31.27,0:02:33.77,Default,,0,0,0,,Жоқ, вокзалда адам көп, мен үйге барамын.
Dialogue: 0,0:02:33.86,0:02:36.65,Default,,0,0,0,,Нашар! Осы адамдардың барлығы үйлеріне кеткенде!
Dialogue: 0,0:02:37.65,0:02:39.86,Default,,0,0,0,,Оны шынымен тоқтатуға бола ма?
Dialogue: 0,0:02:42.16,0:02:44.37,Default,,0,0,0,,Не істеу керек? Осылай қала берсе...
Dialogue: 0,0:02:44.45,0:02:45.29,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:47.20,0:02:48.71,Default,,0,0,0,,- Міне келдік! -(Окумура) А?
Dialogue: 0,0:02:48.79,0:02:50.08,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:02:51.04,0:02:52.79,Default,,0,0,0,,Ах! Міне бітті!
Dialogue: 0,0:03:06.97,0:03:08.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:08.98,0:03:10.14,Default,,0,0,0,,Растаротта?
Dialogue: 0,0:03:10.23,0:03:12.27,Default,,0,0,0,,- Майура-сама? -Бұл Маюра!
Dialogue: 0,0:03:12.35,0:03:14.36,Default,,0,0,0,,-Қайта тірілу? -Ескертусіз бе?
Dialogue: 0,0:03:16.11,0:03:19.19,Default,,0,0,0,,А... Маюри! неге?
Dialogue: 0,0:03:19.74,0:03:20.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:20.70,0:03:22.82,Default,,0,0,0,,Көрші стендте кездескенше...
Dialogue: 0,0:03:22.91,0:03:23.74,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:03:24.45,0:03:26.78,Default,,0,0,0,,Кешіріңіз, ол сатылып кетті.
Dialogue: 0,0:03:26.87,0:03:28.37,Default,,0,0,0,,Маюра-сама келе жатыр!
Dialogue: 0,0:03:28.45,0:03:29.58,Default,,0,0,0,,Майура-чан, шын айтасың ба?
Dialogue: 0,0:03:31.62,0:03:35.42,Default,,0,0,0,,Мм... Маюра!
Dialogue: 0,0:03:35.50,0:03:37.92,Default,,0,0,0,,Мен сенің зейнеткерлікке шыққаныңды естідім.
Dialogue: 0,0:03:38.00,0:03:40.13,Default,,0,0,0,,Енді сіз осылай көріндіңіз!
Dialogue: 0,0:03:41.67,0:03:44.18,Default,,0,0,0,,Оны қабылдаудан басқа амалың жоқ!
Dialogue: 0,0:03:44.26,0:03:45.93,Default,,0,0,0,,753♡-chan Тазарту! Бұл бөксе!
Dialogue: 0,0:03:46.01,0:03:48.51,Default,,0,0,0,,753♡-чан, сен әлі барасың. 753♡ енді қол жетімді!
Dialogue: 0,0:03:48.60,0:03:50.73,Default,,0,0,0,,Түсіруді жалғастырыңыз!
Dialogue: 0,0:03:50.81,0:03:52.35,Default,,0,0,0,,Не? 753 мырза♡?
Dialogue: 0,0:03:57.57,0:03:59.11,Default,,0,0,0,,Жарайды, Маюра.
Dialogue: 0,0:03:59.19,0:04:01.19,Default,,0,0,0,,Біздің жарысқанымызға біраз болды!
Dialogue: 0,0:04:01.28,0:04:04.03,Default,,0,0,0,,Маған қарашы, мен кәсіпқоймын!
Dialogue: 0,0:04:06.45,0:04:10.45,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:16.58,0:04:18.00,Default,,0,0,0,,Шынымды айтсам, Маюра-сама.
Dialogue: 0,0:04:18.09,0:04:20.59,Default,,0,0,0,,Және сол фантом костюмі!
Dialogue: 0,0:04:21.84,0:04:23.68,Default,,0,0,0,,753♡ теңдігі де қазір сіздің мүмкіндігіңіз!
Dialogue: 0,0:04:23.76,0:04:26.34,Default,,0,0,0,,Қарғыс атсын! Қайсысын алуым керек?
Dialogue: 0,0:04:29.01,0:04:30.31,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:04:30.39,0:04:33.48,Default,,0,0,0,,Мен не айта алмаймын, бірақ бұл керемет!
Dialogue: 0,0:04:33.56,0:04:35.90,Default,,0,0,0,,Жоқ, мен бұл туралы ойлануым керек.
Dialogue: 0,0:04:35.98,0:04:38.73,Default,,0,0,0,,Мұндай мүмкіндік ешқашан қайталанбауы мүмкін.
Dialogue: 0,0:04:38.82,0:04:39.69,Default,,0,0,0,,Мұның несі керемет?
Dialogue: 0,0:04:39.77,0:04:42.28,Default,,0,0,0,,Түсірілім басталатын сәт
Dialogue: 0,0:04:42.36,0:04:44.99,Default,,0,0,0,,Мен білетін Майури мұғалімі енді мен білетін адам емес.
Dialogue: 0,0:04:47.45,0:04:48.70,Default,,0,0,0,,Түрлі бет
Dialogue: 0,0:04:48.78,0:04:50.16,Default,,0,0,0,,Әртүрлі мимика
Dialogue: 0,0:04:50.24,0:04:52.62,Default,,0,0,0,,Әртүрлі мінез-құлық
Dialogue: 0,0:04:52.70,0:04:55.12,Default,,0,0,0,,Өрнек «басқа адам» дегенге ұқсас.
Dialogue: 0,0:04:55.83,0:04:58.67,Default,,0,0,0,,Бұл кейіпкер сізді иемденіп тұрғандай сезіледі.
Dialogue: 0,0:04:59.17,0:05:02.05,Default,,0,0,0,,Бұл жақсылықтың қайтарылуы.
Dialogue: 0,0:05:02.88,0:05:06.76,Default,,0,0,0,,Мені осылай қолдаған мына дүниеге
Dialogue: 0,0:05:08.22,0:05:09.85,Default,,0,0,0,,Ластароттаға
Dialogue: 0,0:05:11.26,0:05:12.27,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:05:14.06,0:05:16.23,Default,,0,0,0,,Келесі мен...
Dialogue: 0,0:05:16.77,0:05:20.65,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:05:20.73,0:05:24.03,Default,,0,0,0,,Күткендей, Маюра
Dialogue: 0,0:05:24.86,0:05:27.70,Default,,0,0,0,,Жоқ... Жоқ, олай емес.
Dialogue: 0,0:05:27.78,0:05:30.07,Default,,0,0,0,,Бұл кәдімгі жігіт...
Dialogue: 0,0:05:32.99,0:05:35.79,Default,,0,0,0,,Бұл Ластаротта
Dialogue: 0,0:05:37.25,0:05:39.29,Default,,0,0,0,,Бүгін де жеңе алмадым.
Dialogue: 0,0:05:39.38,0:05:42.13,Default,,0,0,0,,Маюра шынымен танымал.
Dialogue: 0,0:05:42.21,0:05:44.55,Default,,0,0,0,,Растаротта танымал.
Dialogue: 0,0:05:44.63,0:05:47.84,Default,,0,0,0,,Махаббатым саған жеткізілсе, мен бақыттымын.
Dialogue: 0,0:05:49.89,0:05:52.43,Default,,0,0,0,,Сіз әрқашан осылай жасайсыз
Dialogue: 0,0:05:52.51,0:05:54.68,Default,,0,0,0,,Менің бар болуым маңызды емес деген жүзбен
Dialogue: 0,0:05:54.77,0:05:56.81,Default,,0,0,0,,Косплейге арналған
Dialogue: 0,0:05:56.89,0:05:59.31,Default,,0,0,0,,Әрекет сияқты
Dialogue: 0,0:05:59.40,0:06:03.07,Default,,0,0,0,,Бұл дүниенің абсолютті әділдігі болып көрінетін күшпен
Dialogue: 0,0:06:04.36,0:06:06.32,Default,,0,0,0,,Мен мұны өзім білемін
Dialogue: 0,0:06:06.40,0:06:08.49,Default,,0,0,0,,Мен комплекспін
Dialogue: 0,0:06:08.57,0:06:12.70,Default,,0,0,0,,Дегенмен, мен ең жақсымын және тек өзімді қызықтырамын.
Dialogue: 0,0:06:13.58,0:06:16.12,Default,,0,0,0,,Бірақ мен өзімді қабылдай алмаймын...
Dialogue: 0,0:06:17.66,0:06:21.04,Default,,0,0,0,,Мен кейіпкерді қатты жақсы көрмесем, косплейге рұқсат етемін бе?
Dialogue: 0,0:06:21.13,0:06:24.00,Default,,0,0,0,,А... егер мен қазір косплеймен айналыспасам.
Dialogue: 0,0:06:24.09,0:06:27.51,Default,,0,0,0,,Қолымнан келгенше жерді басып, тісімді қайрап алғым келеді!
Dialogue: 0,0:06:28.55,0:06:29.47,Default,,0,0,0,,Маюра...
Dialogue: 0,0:06:30.22,0:06:33.93,Default,,0,0,0,,Сіз таңдағаныңыздан бейхабар едіңіз.
Dialogue: 0,0:06:34.01,0:06:35.89,Default,,0,0,0,,Мен мұны жек көремін!
Dialogue: 0,0:06:36.64,0:06:39.89,Default,,0,0,0,,Өзіңнен басқаға таза махаббат ұсыну
Dialogue: 0,0:06:39.98,0:06:41.69,Default,,0,0,0,,Сіздің талантыңыз қаншалықты керемет?
Dialogue: 0,0:06:41.77,0:06:44.02,Default,,0,0,0,,Менің қаншалықты бақытты екенімді білесің бе?
Dialogue: 0,0:06:44.82,0:06:48.19,Default,,0,0,0,,Мен өзімді өзімнен басқа ештеңе жасай алмаймын
Dialogue: 0,0:06:48.86,0:06:51.70,Default,,0,0,0,,Себебі мен Кай-саманы жақсы көремін.
Dialogue: 0,0:06:51.78,0:06:53.07,Default,,0,0,0,,Бейшара менмін
Dialogue: 0,0:06:53.16,0:06:55.95,Default,,0,0,0,,Сенің айналаңды қалайтын менмін!
Dialogue: 0,0:06:56.04,0:06:59.75,Default,,0,0,0,,Мен өзім үшін 2D-де мәңгі қалғым келеді.
Dialogue: 0,0:06:59.83,0:07:03.67,Default,,0,0,0,,Сондықтан мен барымды косплейге құйдым.
Dialogue: 0,0:07:05.42,0:07:10.93,Default,,0,0,0,,Өзіңе құйған махаббатың ең таза және ең күшті екені сөзсіз!
Dialogue: 0,0:07:11.88,0:07:15.64,Default,,0,0,0,,Мен бірдеңе дұрыс емес істеп жатырмын ба? Маюра
Dialogue: 0,0:07:15.72,0:07:19.85,Default,,0,0,0,,Сіз күткендей, сіз 753♡ тербелмейсіз
Dialogue: 0,0:07:19.93,0:07:22.56,Default,,0,0,0,,Рас, рас, Маюра-сама!
Dialogue: 0,0:07:22.65,0:07:24.52,Default,,0,0,0,,Аспандағы төрт патшаның екеуі бірге.
Dialogue: 0,0:07:24.61,0:07:25.52,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:07:25.61,0:07:28.99,Default,,0,0,0,,А... тұтынушылардың саны қайтпайды, бірақ тез өсуде.
Dialogue: 0,0:07:29.07,0:07:31.86,Default,,0,0,0,,Жақсылап қараңызшы, Окумура мырза.
Dialogue: 0,0:07:31.95,0:07:33.32,Default,,0,0,0,,Бұл жарыс!
Dialogue: 0,0:07:33.41,0:07:36.45,Default,,0,0,0,,Біз сізді дәл осы жерге апарғымыз келеді.
Dialogue: 0,0:07:36.53,0:07:37.87,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:40.00,0:07:42.37,Default,,0,0,0,,Бұл әлемнің шыңы!
Dialogue: 0,0:07:47.67,0:07:50.84,Default,,0,0,0,,Көз жасынан ісінген қабақ тез қайтпайды.
Dialogue: 0,0:07:51.38,0:07:54.68,Default,,0,0,0,,Керемет Лилиэль мүмкін емес.
Dialogue: 0,0:07:55.34,0:07:56.85,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:07:58.31,0:08:01.27,Default,,0,0,0,,Сіз Лилиса Аманосыз!
Dialogue: 0,0:08:01.35,0:08:05.23,Default,,0,0,0,,Маған косплей ұнайды, маған Лилиэль ұнайды
Dialogue: 0,0:08:05.31,0:08:06.23,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:08:07.32,0:08:08.65,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:08:11.03,0:08:12.53,Default,,0,0,0,,Күлкілі емес
Dialogue: 0,0:08:12.61,0:08:14.95,Default,,0,0,0,,Қанша күлкі салсам да
Dialogue: 0,0:08:15.03,0:08:16.74,Default,,0,0,0,,Жүрек күле алмайды
Dialogue: 0,0:08:16.82,0:08:17.41,Default,,0,0,0,,753♡ 753♡-чан!
Dialogue: 0,0:08:17.41,0:08:18.78,Default,,0,0,0,,753♡ 753♡-чан!
Dialogue: 0,0:08:17.41,0:08:18.78,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатсам да...
Dialogue: 0,0:08:18.78,0:08:18.87,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатсам да...
Dialogue: 0,0:08:18.87,0:08:19.70,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатсам да...
Dialogue: 0,0:08:18.87,0:08:19.70,Default,,0,0,0,,Мына жаққа қара!
Dialogue: 0,0:08:19.79,0:08:24.17,Default,,0,0,0,,Маура қасымда болғанда осы сезімді аламын.
Dialogue: 0,0:08:24.25,0:08:25.63,Default,,0,0,0,,Өкініш, бас тарту сияқты
Dialogue: 0,0:08:25.63,0:08:26.88,Default,,0,0,0,,Өкініш беру дерлік
Dialogue: 0,0:08:25.63,0:08:26.88,Default,,0,0,0,,Құрметті Маюра! Өтінемін маған қара!
Dialogue: 0,0:08:26.88,0:08:28.38,Default,,0,0,0,,Құрметті Маюра! Өтінемін маған қара!
Dialogue: 0,0:08:28.46,0:08:32.63,Default,,0,0,0,,Адамдарды менен көбірек тартып жатыр
Dialogue: 0,0:08:32.72,0:08:34.68,Default,,0,0,0,,Маман болыңыз
Dialogue: 0,0:08:34.76,0:08:36.59,Default,,0,0,0,,Ешкім еліктей алмайтын косплейлеу
Dialogue: 0,0:08:37.97,0:08:40.56,Default,,0,0,0,,Сіз әлі де бірінші бола алмайсыз ба?
Dialogue: 0,0:08:40.64,0:08:42.52,Default,,0,0,0,,Маған өте сүйкімді көрініс беріңіз!
Dialogue: 0,0:08:42.60,0:08:46.15,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім дейсіз бе?
Dialogue: 0,0:08:46.23,0:08:49.32,Default,,0,0,0,,Мен... Мен косплейді қатты жақсы көремін
Dialogue: 0,0:08:50.65,0:08:53.32,Default,,0,0,0,,Неге сонша ауырады...
Dialogue: 0,0:08:55.24,0:08:58.28,Default,,0,0,0,,753♡… Мен білемін
Dialogue: 0,0:08:59.95,0:09:01.99,Default,,0,0,0,,Әпке өте сүйкімді!
Dialogue: 0,0:09:02.08,0:09:03.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.12,0:09:05.04,Default,,0,0,0,,Мен сенімен суретке түсе аламын ба?
Dialogue: 0,0:09:05.12,0:09:08.38,Default,,0,0,0,,Мен өткен жылы Хэллоуин мерекесінде косплей ойнап көрдім, ол қызық болды~
Dialogue: 0,0:09:08.46,0:09:09.59,Default,,0,0,0,,Косплей дегеніміз не?
Dialogue: 0,0:09:08.46,0:09:09.59,Default,,0,0,0,,Бүгін мен бірінші рет іс-шараға келдім.
Dialogue: 0,0:09:09.59,0:09:09.67,Default,,0,0,0,,Бүгін мен бірінші рет іс-шараға келдім.
Dialogue: 0,0:09:09.67,0:09:10.63,Default,,0,0,0,,Мен бүгін бірінші рет іс-шараға бардым.
Dialogue: 0,0:09:09.67,0:09:10.63,Default,,0,0,0,,Жеңілдік дүкені
Dialogue: 0,0:09:10.63,0:09:10.71,Default,,0,0,0,,Мен бүгін бірінші рет іс-шараға бардым.
Dialogue: 0,0:09:10.71,0:09:11.96,Default,,0,0,0,,Мен бүгін бірінші рет іс-шараға бардым.
Dialogue: 0,0:09:10.71,0:09:11.96,Default,,0,0,0,,Қытайдың киімі емес пе?
Dialogue: 0,0:09:12.05,0:09:13.59,Default,,0,0,0,,Мазасыз болса да, сіз араласып кеттіңіз...
Dialogue: 0,0:09:13.59,0:09:14.72,Default,,0,0,0,,Мазасыздық болса да, сіз араласып кеттіңіз...
Dialogue: 0,0:09:13.59,0:09:14.72,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:09:14.80,0:09:17.43,Default,,0,0,0,,Олай болса, біз қазір доспыз!
Dialogue: 0,0:09:17.51,0:09:22.10,Default,,0,0,0,,Әуесқой косплей де, атақты косплей де
Dialogue: 0,0:09:22.18,0:09:24.14,Default,,0,0,0,,Ешқайсыларың оны жоққа шығарған жоқсыңдар.
Dialogue: 0,0:09:24.93,0:09:29.23,Default,,0,0,0,,Мен косплейшілер санының көбейгеніне шын қуандым.
Dialogue: 0,0:09:29.31,0:09:30.52,Default,,0,0,0,,Маман боласыз ба?
Dialogue: 0,0:09:30.61,0:09:33.15,Default,,0,0,0,,Иә, мен кеңсе таптым.
Dialogue: 0,0:09:33.23,0:09:35.90,Default,,0,0,0,,Мен косплейді өз жұмысыма айналдырғым келеді.
Dialogue: 0,0:09:35.99,0:09:39.24,Default,,0,0,0,,Мен нені жақсы көрсем, соны мәңгі жасағым келеді
Dialogue: 0,0:09:39.32,0:09:40.45,Default,,0,0,0,,Маюра ше?
Dialogue: 0,0:09:40.53,0:09:42.54,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:09:42.62,0:09:46.75,Default,,0,0,0,,Өйткені мен бір күні жұмыстан шығамын...
Dialogue: 0,0:09:47.71,0:09:49.83,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:09:49.92,0:09:52.96,Default,,0,0,0,,753♡ косплейді қаншалықты жақсы көреді
Dialogue: 0,0:09:53.05,0:09:56.38,Default,,0,0,0,,Косплейге қанша ой салдыңыз?
Dialogue: 0,0:09:57.63,0:10:01.89,Default,,0,0,0,,Мен туралы не ойлайтыныңызды білемін.
Dialogue: 0,0:10:02.60,0:10:07.10,Default,,0,0,0,,Бірақ бұл тек сенің маған деген ойың ғана.
Dialogue: 0,0:10:08.10,0:10:09.98,Default,,0,0,0,,Мен де қызғандым
Dialogue: 0,0:10:11.11,0:10:13.94,Default,,0,0,0,,Мен үшін косплей тек көңіл көтеру үшін болды.
Dialogue: 0,0:10:14.65,0:10:17.78,Default,,0,0,0,,753♡ көргенде қатты күйзелдім
Dialogue: 0,0:10:17.86,0:10:19.28,Default,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:10:20.41,0:10:24.24,Default,,0,0,0,,753♡ жай ғана өзін мойындауға тырыспайды.
Dialogue: 0,0:10:25.49,0:10:29.42,Default,,0,0,0,,753 мырза♡... Неге асығасыз?
Dialogue: 0,0:10:30.00,0:10:33.63,Default,,0,0,0,,Мен көлеңкеден қорқамын, өзімді көре алмаймын
Dialogue: 0,0:10:33.71,0:10:39.13,Default,,0,0,0,,Сізде әрқашан көбірек сатылымдар болды және адамдар көп болды.
Dialogue: 0,0:10:39.76,0:10:40.68,Default,,0,0,0,,Майурадан жеңілу...
Dialogue: 0,0:10:41.34,0:10:45.14,Default,,0,0,0,,Мен косплейде бірінші болуым керек...
Dialogue: 0,0:10:47.06,0:10:47.93,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:48.02,0:10:50.48,Default,,0,0,0,,Мен барлығын косплейге арнадым.
Dialogue: 0,0:10:51.06,0:10:52.56,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:10:53.23,0:10:56.03,Default,,0,0,0,,Түрлі сөзден ренжідім, солай ма?
Dialogue: 0,0:10:57.11,0:11:01.24,Default,,0,0,0,,Қорғау үшін жүрегіме тікен өсіремін
Dialogue: 0,0:11:01.32,0:11:02.62,Default,,0,0,0,,Біз ұрысып қалдық, солай емес пе?
Dialogue: 0,0:11:03.87,0:11:07.50,Default,,0,0,0,,Мен де, ешқандай айырмашылығы жоқ.
Dialogue: 0,0:11:08.25,0:11:11.42,Default,,0,0,0,,Егер біз қарсылас болмасақ, сөзсіз дос болар едік.
Dialogue: 0,0:11:11.50,0:11:15.34,Default,,0,0,0,,Біз тозақ сияқты жүгірдік.
Dialogue: 0,0:11:16.67,0:11:20.38,Default,,0,0,0,,Неге тек ұнату жеткіліксіз?
Dialogue: 0,0:11:21.43,0:11:23.68,Default,,0,0,0,,Бұл шынымен де жаман ба?
Dialogue: 0,0:11:23.76,0:11:26.85,Default,,0,0,0,,Аздап есіме түсті.
Dialogue: 0,0:11:27.52,0:11:29.06,Default,,0,0,0,,Алғашқы ойлар
Dialogue: 0,0:11:29.14,0:11:32.60,Default,,0,0,0,,Мен косплеймін!
Dialogue: 0,0:11:33.90,0:11:36.57,Default,,0,0,0,,Мен косплейді бастағанда қандай сезімде болдым
Dialogue: 0,0:11:42.36,0:11:44.12,Default,,0,0,0,,Иә! Майура-сама, бітті.
Dialogue: 0,0:11:44.20,0:11:47.24,Default,,0,0,0,,Жақсы! Мен суретке түсейін деп жатырмын... Шынайы ма?
Dialogue: 0,0:11:47.33,0:11:49.45,Default,,0,0,0,,Иә! Майура қайтып келеді?
Dialogue: 0,0:11:49.54,0:11:53.29,Default,,0,0,0,,Неліктен? Сіз мейірімділік танытуға тырысасыз ба? Бұл әзіл...
Dialogue: 0,0:11:54.71,0:11:56.63,Default,,0,0,0,,Мұның бәрі мен үшін.
Dialogue: 0,0:11:56.71,0:11:59.00,Default,,0,0,0,,Оны алдау деп атауға болады,
Dialogue: 0,0:11:59.09,0:12:01.88,Default,,0,0,0,,Менің ешқашан жарысуға ниетім болған емес.
Dialogue: 0,0:12:02.47,0:12:06.64,Default,,0,0,0,,Бірақ 753♡ Сіз де солай болдыңыз, солай ма?
Dialogue: 0,0:12:08.14,0:12:10.68,Default,,0,0,0,,Мен сені кездестіргім келетін адам бар.
Dialogue: 0,0:12:12.18,0:12:15.27,Default,,0,0,0,,Себебі мен оны да есте сақтағаныңызды қалаймын.
Dialogue: 0,0:12:15.35,0:12:16.48,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:12:21.53,0:12:25.99,Default,,0,0,0,,753♡ соңғы косплейі қандай?
Dialogue: 0,0:12:26.07,0:12:27.83,Default,,0,0,0,,Бұл өте қарама-қайшы.
Dialogue: 0,0:12:29.37,0:12:33.29,Default,,0,0,0,,Бір қарағанда әркім түсінетін шығар
Dialogue: 0,0:12:33.37,0:12:37.17,Default,,0,0,0,,Ол бұл кейіпкерді махаббаттан таңдағанын айтты.
Dialogue: 0,0:12:38.00,0:12:42.26,Default,,0,0,0,,Оқиғаларда енді көрінбейтін көне кейіпкерлер
Dialogue: 0,0:12:43.55,0:12:44.63,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:12:44.72,0:12:48.10,Default,,0,0,0,,Мен мұнда барлығына сенімдімін
Dialogue: 0,0:12:48.18,0:12:51.31,Default,,0,0,0,,Мен бір рет ғашық болуым керек еді...
Dialogue: 0,0:12:55.19,0:12:56.48,Default,,0,0,0,,Періште!
Dialogue: 0,0:13:01.11,0:13:02.57,Default,,0,0,0,,Лилиел!
Dialogue: 0,0:13:05.36,0:13:06.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.87,0:13:14.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:14.83,0:13:17.58,Default,,0,0,0,,Бұл Лилиелдің хаос формасы ма?
Dialogue: 0,0:13:17.67,0:13:21.09,Default,,0,0,0,,Иә! Лилиел күш іздеп қараңғылыққа тартылды.
Dialogue: 0,0:13:21.17,0:13:23.92,Default,,0,0,0,,Қараңғыда жеңіп, алған қайраткер!
Dialogue: 0,0:13:25.97,0:13:27.09,Default,,0,0,0,,Лилиел!
Dialogue: 0,0:13:27.84,0:13:28.76,Default,,0,0,0,,Сіз келдіңіз...
Dialogue: 0,0:13:28.84,0:13:34.10,Default,,0,0,0,,Сіз шошып кеткен сияқтысыз, бірақ бәрібір екеніне сенімдісіз бе?
Dialogue: 0,0:13:34.18,0:13:36.39,Default,,0,0,0,,Сезімсіздік? Табиғи?
Dialogue: 0,0:13:36.94,0:13:38.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:38.19,0:13:39.98,Default,,0,0,0,,Егер солай болса, онда сіз болжам жасап жатқан сияқтысыз.
Dialogue: 0,0:13:40.06,0:13:41.44,Default,,0,0,0,,Маған келесің бе?
Dialogue: 0,0:13:42.82,0:13:45.28,Default,,0,0,0,,Мен жылаудан ісіп кеткен қабақтарымды жасыра алмаймын.
Dialogue: 0,0:13:45.36,0:13:46.24,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:13:47.03,0:13:51.74,Default,,0,0,0,,Бұл бала ренжіп қалды, бірақ орнынан тұрды!
Dialogue: 0,0:13:53.91,0:13:58.29,Default,,0,0,0,,Маған! Қиындыққа бет бұрайық!
Dialogue: 0,0:14:00.08,0:14:01.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:01.29,0:14:03.09,Default,,0,0,0,,Маюра-сама
Dialogue: 0,0:14:05.05,0:14:07.68,Default,,0,0,0,,Ол өте салқынқанды…
Dialogue: 0,0:14:14.35,0:14:17.85,Default,,0,0,0,,Өте сүйкімді! Мен тезірек киімімді ауыстырып, суретке түсуім керек!
Dialogue: 0,0:14:19.81,0:14:21.56,Default,,0,0,0,,-Лилиел... -(Окумура) Ах.
Dialogue: 0,0:14:21.65,0:14:22.82,Default,,0,0,0,,Бұл Лилиэль!
Dialogue: 0,0:14:22.90,0:14:24.36,Default,,0,0,0,,Ностальгиялық!
Dialogue: 0,0:14:24.44,0:14:26.19,Default,,0,0,0,,-Кім? -Белгісіз бала
Dialogue: 0,0:14:26.28,0:14:27.57,Default,,0,0,0,,Бірақ бұл сүйкімді емес пе?
Dialogue: 0,0:14:27.65,0:14:29.53,Default,,0,0,0,,Мен қазір түсіруді бастаймын...
Dialogue: 0,0:14:29.61,0:14:30.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:30.99,0:14:32.87,Default,,0,0,0,,- (Окумура) Маған тез арада қолдау көрсету керек - Иә!
Dialogue: 0,0:14:38.87,0:14:40.79,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:14:42.33,0:14:43.59,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:14:43.67,0:14:44.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.38,0:14:46.96,Default,,0,0,0,,Лилиса…
Dialogue: 0,0:14:49.30,0:14:51.47,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:14:52.18,0:14:53.01,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:14:53.10,0:14:55.60,Default,,0,0,0,,Лилиел? Бұл сен танымайтын бала емес пе? Сүйкімді ме?
Dialogue: 0,0:14:55.68,0:14:57.06,Default,,0,0,0,,Сіз оны мына жерден көре алмайсыз!
Dialogue: 0,0:14:57.14,0:14:58.06,Default,,0,0,0,,Маюра-сама қайтып келді...
Dialogue: 0,0:14:58.14,0:15:01.44,Default,,0,0,0,,Жақында бізді қоршап алады деп үміттендім.
Dialogue: 0,0:15:01.52,0:15:04.52,Default,,0,0,0,,Менің ойымша, бұл нөлдік танымалдылықпен жақсы нәтиже бермейді...
Dialogue: 0,0:15:04.61,0:15:08.15,Default,,0,0,0,,Бұл ескі кейіпкер, сондықтан жақсы әзіл болмайды деп ойлаймын.
Dialogue: 0,0:15:08.24,0:15:09.24,Default,,0,0,0,,Әйтеуір, мен суретке түсіремін.
Dialogue: 0,0:15:09.32,0:15:10.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:13.41,0:15:15.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.12,0:15:16.58,Default,,0,0,0,,Суретке тез түсіріңіз
Dialogue: 0,0:15:17.20,0:15:20.54,Default,,0,0,0,,Косплей кезінде нені ойлау керек?
Dialogue: 0,0:15:20.62,0:15:23.38,Default,,0,0,0,,Маюра-сама мен ағаларым сабақ берді
Dialogue: 0,0:15:23.46,0:15:28.88,Default,,0,0,0,,Жауап жоқ деген жауап дәл қазір менің басымнан өтіп жатыр.
Dialogue: 0,0:15:28.96,0:15:32.76,Default,,0,0,0,,Бұл дұрыс жауап екенін білмеймін дегенді білдірмейді.
Dialogue: 0,0:15:32.84,0:15:34.51,Default,,0,0,0,,Шын мәнінде жауап бар.
Dialogue: 0,0:15:34.60,0:15:37.35,Default,,0,0,0,,Мүмкін оны әлі ешкім таппаған шығар.
Dialogue: 0,0:15:38.06,0:15:41.98,Default,,0,0,0,,Бірақ маған бірден жауап берудің қажеті жоқ.
Dialogue: 0,0:15:42.06,0:15:45.61,Default,,0,0,0,,Іздей берсең... Тек ойлана бер.
Dialogue: 0,0:15:45.69,0:15:48.98,Default,,0,0,0,,Мен әлі де косплейді жалғастырамын.
Dialogue: 0,0:15:49.07,0:15:50.61,Default,,0,0,0,,Енді ойланбаңыз
Dialogue: 0,0:15:50.69,0:15:53.49,Default,,0,0,0,,Маған Лилиэль ұнайды!
Dialogue: 0,0:15:54.41,0:15:55.62,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:15:56.12,0:15:58.04,Default,,0,0,0,,Мен косплейді жақсы көремін!
Dialogue: 0,0:16:01.71,0:16:03.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:03.67,0:16:05.79,Default,,0,0,0,,Мен сені жеңе алмаймын
Dialogue: 0,0:16:07.34,0:16:11.30,Default,,0,0,0,,Лилита енді қажетсіз нәрселер туралы ойламайтынына сенімдімін.
Dialogue: 0,0:16:12.01,0:16:14.68,Default,,0,0,0,,Мен енді ғана сүйікті Лилиэльге айналудамын!
Dialogue: 0,0:16:15.34,0:16:18.01,Default,,0,0,0,,Эй, Лилиэль сондай сүйкімді емес пе?
Dialogue: 0,0:16:18.10,0:16:20.47,Default,,0,0,0,,Не? Бұл рас, ешқандай белгі жоқ!
Dialogue: 0,0:16:20.56,0:16:22.69,Default,,0,0,0,,Ей, кеттік! Барайық!
Dialogue: 0,0:16:22.77,0:16:23.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:23.81,0:16:25.52,Default,,0,0,0,,Бұл қорап жақсы ма?
Dialogue: 0,0:16:25.60,0:16:26.65,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:16:26.73,0:16:27.98,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:16:28.07,0:16:29.40,Default,,0,0,0,,Бұл қашан болды...
Dialogue: 0,0:16:30.11,0:16:31.99,Default,,0,0,0,,О... өтінемін!
Dialogue: 0,0:16:34.78,0:16:37.87,Default,,0,0,0,,Сіз менімен осындай қорапта жарысуды жоспарлап отырсыз ба?
Dialogue: 0,0:16:37.95,0:16:39.28,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:16:39.37,0:16:41.75,Default,,0,0,0,,Мен ең жақсымын!
Dialogue: 0,0:16:41.83,0:16:45.92,Default,,0,0,0,,Өйткені мен косплейді әлемдегі барлық нәрселерден артық жақсы көремін.
Dialogue: 0,0:16:46.00,0:16:47.13,Default,,0,0,0,,Мен жақсы көремін...
Dialogue: 0,0:16:47.96,0:16:49.25,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:16:49.34,0:16:51.84,Default,,0,0,0,,Бірақ сіз неге...
Dialogue: 0,0:16:53.38,0:16:55.80,Default,,0,0,0,,Бұл соншалықты қызықты көрінеді ме?
Dialogue: 0,0:16:57.59,0:16:59.01,Default,,0,0,0,,７５３♡
Dialogue: 0,0:16:59.10,0:17:01.64,Default,,0,0,0,,Байқау керек.
Dialogue: 0,0:17:01.72,0:17:04.89,Default,,0,0,0,,Жоқ, сіз байқаған боларсыз.
Dialogue: 0,0:17:05.69,0:17:08.65,Default,,0,0,0,,Ол бала сенімен төбелесуге келмеді.
Dialogue: 0,0:17:08.73,0:17:11.82,Default,,0,0,0,,Алғашында бәрі солай болды.
Dialogue: 0,0:17:12.57,0:17:15.78,Default,,0,0,0,,Бала косплейге келді.
Dialogue: 0,0:17:17.78,0:17:19.99,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:17:20.87,0:17:21.95,Default,,0,0,0,,Лилиел?
Dialogue: 0,0:17:22.04,0:17:24.54,Default,,0,0,0,,Иә, мен оны өткен күні бір шарада көрдім.
Dialogue: 0,0:17:24.62,0:17:26.54,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:17:27.37,0:17:29.96,Default,,0,0,0,,Лилиэльдің суретін бірінші рет көргенімде
Dialogue: 0,0:17:30.46,0:17:31.67,Default,,0,0,0,,Мен бұл жиіркенішті деп ойладым.
Dialogue: 0,0:17:32.63,0:17:35.05,Default,,0,0,0,,Сіз бұлай ойламауыңыз керек.
Dialogue: 0,0:17:35.13,0:17:37.89,Default,,0,0,0,,Мен косплейді жақсы көрсем де
Dialogue: 0,0:17:37.97,0:17:41.72,Default,,0,0,0,,Мен барлық косплейлерді жақсы көруім керек.
Dialogue: 0,0:17:42.64,0:17:46.69,Default,,0,0,0,,Бірақ мен сізге жеке қарағанымда, себебін түсіндім.
Dialogue: 0,0:17:47.77,0:17:51.57,Default,,0,0,0,,Себебі менің бет-әлпетім бір болған...
Dialogue: 0,0:17:56.57,0:17:59.11,Default,,0,0,0,,Фуюка... Мен сені жақсы көремін...
Dialogue: 0,0:17:59.20,0:18:01.12,Default,,0,0,0,,Хехехе, болды, Кай-сама.
Dialogue: 0,0:18:01.20,0:18:02.53,Default,,0,0,0,,Әй, батарея!
Dialogue: 0,0:18:03.41,0:18:06.46,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:06.54,0:18:09.79,Default,,0,0,0,,Бұл... мен
Dialogue: 0,0:18:09.88,0:18:10.83,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:18:10.92,0:18:12.63,Default,,0,0,0,,Айнаның бәрін лақтырып тастасам да
Dialogue: 0,0:18:12.71,0:18:15.38,Default,,0,0,0,,Дұрыс...осылай ойдан шығару – өтірік.
Dialogue: 0,0:18:15.46,0:18:18.22,Default,,0,0,0,,Кай-саманың мені бұлай қалауы мүмкін емес...
Dialogue: 0,0:18:18.30,0:18:20.68,Default,,0,0,0,,Бірақ мен Кайсамадан бас тартатыныма сене алар емеспін.
Dialogue: 0,0:18:20.76,0:18:22.22,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:18:22.30,0:18:23.68,Default,,0,0,0,,Менің жылжымалы есігім жоқ!
Dialogue: 0,0:18:24.26,0:18:25.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.31,0:18:29.81,Default,,0,0,0,,Батыр ана болсам ғой.
Dialogue: 0,0:18:31.36,0:18:34.40,Default,,0,0,0,,Өтірікті шындыққа айналдыр...
Dialogue: 0,0:18:35.98,0:18:38.07,Default,,0,0,0,,Үш жылда бірінші рет сатып алған айна...
Dialogue: 0,0:18:39.86,0:18:42.78,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,0:18:42.87,0:18:44.16,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:18:42.87,0:18:44.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:44.16,0:18:44.24,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:44.24,0:18:45.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:44.24,0:18:45.99,Default,,0,0,0,,Ол шынымен Фую-чанға ұқсайды.
Dialogue: 0,0:18:46.08,0:18:48.21,Default,,0,0,0,,Мен сүйкімдімін бе?
Dialogue: 0,0:18:48.29,0:18:53.38,Default,,0,0,0,,Иә, мен жай ғана сүйкімді болғым келді.
Dialogue: 0,0:18:53.46,0:18:56.67,Default,,0,0,0,,Жеңгім де, жеңілгім де келмеді.
Dialogue: 0,0:18:56.76,0:18:59.47,Default,,0,0,0,,Біреу маған сүйкімді екенімді айтса қуанамын...
Dialogue: 0,0:18:59.55,0:19:00.80,Default,,0,0,0,,Мен өте қуаныштымын...
Dialogue: 0,0:19:00.88,0:19:03.85,Default,,0,0,0,,Менің өзімді жақсы көруге көбірек уақытым бар
Dialogue: 0,0:19:04.39,0:19:08.14,Default,,0,0,0,,Мен өмірімде мұндайды ешқашан бастан өткерген емеспін.
Dialogue: 0,0:19:09.43,0:19:12.69,Default,,0,0,0,,Косплей ойнау маған өте қызық болды.
Dialogue: 0,0:19:12.77,0:19:14.31,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:19:15.36,0:19:19.53,Default,,0,0,0,,Сондықтан мен әрқашан косплеймен айналысқым келетін.
Dialogue: 0,0:19:20.90,0:19:21.99,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:22.07,0:19:25.70,Default,,0,0,0,,Бақытты уақытты жалғастыру үшін
Dialogue: 0,0:19:22.07,0:19:25.70,Default,,0,0,0,,(Зұлымдық дауысы)
Dialogue: 0,0:19:25.78,0:19:32.42,Default,,0,0,0,,Мен көп қиындықпен, жанжалмен, зұлымдықпен күресуге тура келді.
Dialogue: 0,0:19:33.04,0:19:36.84,Default,,0,0,0,,Мен мұны білмей тұрып, өзімді қорғауға тырыстым.
Dialogue: 0,0:19:36.92,0:19:39.72,Default,,0,0,0,,Менің қолымнан келгені жүрегімді өлтіру болды.
Dialogue: 0,0:19:40.42,0:19:44.85,Default,,0,0,0,,Мен өзім жақсы көретін іспен айналысуды жалғастырғым келді.
Dialogue: 0,0:19:45.47,0:19:50.68,Default,,0,0,0,,Бұрын мен барлық косплейерлер менің достарым екеніне сенетінмін.
Dialogue: 0,0:19:50.77,0:19:52.85,Default,,0,0,0,,үшінна өте ұнады.
Dialogue: 0,0:19:53.77,0:19:57.73,Default,,0,0,0,,Бірақ косплей азапқа айналды
Dialogue: 0,0:19:57.82,0:20:01.90,Default,,0,0,0,,Біз доспыз деп айта берсек те, мен сенімдімін
Dialogue: 0,0:20:02.95,0:20:07.08,Default,,0,0,0,,Косплейді ұнататын адамдарды жек көре бастадым...
Dialogue: 0,0:20:08.99,0:20:11.91,Default,,0,0,0,,Мен қай жерде қателестім?
Dialogue: 0,0:20:12.00,0:20:13.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:14.63,0:20:19.92,Default,,0,0,0,,Жоқ, мен ұмытып кетіппін.
Dialogue: 0,0:20:20.51,0:20:24.18,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,0:20:28.18,0:20:29.56,Default,,0,0,0,,753 мырза♡?
Dialogue: 0,0:20:31.10,0:20:32.31,Default,,0,0,0,,７５３♡…
Dialogue: 0,0:20:32.89,0:20:36.40,Default,,0,0,0,,Косплейде де құдай бар болса
Dialogue: 0,0:20:36.48,0:20:40.28,Default,,0,0,0,,Қазір кімге күлесің, маған ма әлде Лилиелге ме?
Dialogue: 0,0:20:41.15,0:20:44.20,Default,,0,0,0,,Бұл қазірдің өзінде шешілді.
Dialogue: 0,0:20:44.28,0:20:45.82,Default,,0,0,0,,753♡chan, бітті ме?
Dialogue: 0,0:20:45.91,0:20:48.03,Default,,0,0,0,,-Иә~ -Сен өзіңді жақсы сезінбейсің...
Dialogue: 0,0:20:48.12,0:20:50.33,Default,,0,0,0,,Мен мүлде шоғырлана алмадым.
Dialogue: 0,0:20:50.41,0:20:51.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.62,0:20:55.25,Default,,0,0,0,,Уақытым таусылып, кәсіби маман ретінде дисквалификацияландым...
Dialogue: 0,0:20:55.33,0:20:56.96,Default,,0,0,0,,Мистер 753♡…
Dialogue: 0,0:20:57.04,0:21:00.92,Default,,0,0,0,,Мен 753♡-ді ренжіттім бе?
Dialogue: 0,0:21:01.00,0:21:04.93,Default,,0,0,0,,Жарайды! Қазірден асығыс болсаң, уақытында жетесің.
Dialogue: 0,0:21:05.01,0:21:06.43,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:21:06.51,0:21:07.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.47,0:21:10.76,Default,,0,0,0,,Кешіріңіз, бірақ бұл одан да көп.
Dialogue: 0,0:21:10.85,0:21:11.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.52,0:21:18.36,Default,,0,0,0,,Косплей құдайы...
Dialogue: 0,0:21:23.90,0:21:25.53,Default,,0,0,0,,Өз күшімен
Dialogue: 0,0:21:27.36,0:21:28.70,Default,,0,0,0,,Айналыңыз!
Dialogue: 0,0:21:32.04,0:21:33.87,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:21:34.71,0:21:37.21,Default,,0,0,0,,Себебі есімде қалды
Dialogue: 0,0:21:37.29,0:21:39.67,Default,,0,0,0,,Қымбатты Кай, сен маған қарап тұрсың ба?
Dialogue: 0,0:21:39.75,0:21:42.13,Default,,0,0,0,,Мен сондай сүйкімді болып кеттім
Dialogue: 0,0:21:43.26,0:21:46.05,Default,,0,0,0,,үшін маған қарайды!
Dialogue: 0,0:21:46.13,0:21:48.30,Default,,0,0,0,,Қараңдаршы, мен қандай сүйкімді болып қалдым!
Dialogue: 0,0:21:50.72,0:21:53.77,Default,,0,0,0,,Сіз шынымен мықтысыз... 753♡
Dialogue: 0,0:21:53.85,0:21:55.98,Default,,0,0,0,,Мен жеңілмеймін, Лилиэль.
Dialogue: 0,0:21:56.60,0:21:58.98,Default,,0,0,0,,Маған мұны істеу көбірек ұнайды.
Dialogue: 0,0:21:59.52,0:22:02.40,Default,,0,0,0,,Мен кәсіби маман болғандықтан...
Dialogue: 0,0:22:03.40,0:22:04.94,Default,,0,0,0,,Жүрегімде жылаймын
Dialogue: 0,0:22:06.45,0:22:07.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:13.24,0:22:15.00,Default,,0,0,0,,Себебі мен есімде...
Dialogue: 0,0:22:16.25,0:22:20.04,Default,,0,0,0,,Косплей қызық!
Dialogue: 0,0:22:26.05,0:22:30.84,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.09,0:23:55.35,Default,,0,0,0,,～♪
