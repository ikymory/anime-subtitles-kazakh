Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,0:56:22.13,0:56:23.63,CNsub,NTP,0000,0000,0000,,Ичикуна Ичиядан бері 2 жыл өтті
Dialogue: 0,0:57:17.45,0:57:22.35,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,0:51:34.29,0:51:38.55,EDJ,NTP,0000,0000,0000,,Тыныштықтан шығу
Dialogue: 0,0:51:38.67,0:51:43.10,EDJ,NTP,0000,0000,0000,,Махаббаттың көзге көрінбейтін көрінісіне қарай
Dialogue: 0,0:51:43.14,0:51:47.83,EDJ,NTP,0000,0000,0000,,Мен бұл азапқа сенгім келеді
Dialogue: 0,0:51:47.87,0:51:56.31,EDJ,NTP,0000,0000,0000,,Түннен тыс
Dialogue: 0,0:52:07.87,0:52:16.41,EDJ,NTP,0000,0000,0000,,Менің кеудемде сен түрткен нәзік жара бар.
Dialogue: 0,0:52:16.82,0:52:25.50,EDJ,NTP,0000,0000,0000,,Жасырған жасым қызыл түсті.
Dialogue: 0,0:52:25.67,0:52:34.23,EDJ,NTP,0000,0000,0000,,Жапырақтары ақыры менің салқын терімде жанды
Dialogue: 0,0:52:34.40,0:52:43.19,EDJ,NTP,0000,0000,0000,,Мен бармын, Бақытты жырлаймын
Dialogue: 0,0:52:43.34,0:52:47.46,EDJ,NTP,0000,0000,0000,,Арман бітті
Dialogue: 0,0:52:47.58,0:52:51.99,EDJ,NTP,0000,0000,0000,,Жұлдыз шаңы жоғалған кезде
Dialogue: 0,0:52:52.21,0:53:01.63,EDJ,NTP,0000,0000,0000,,Ей, мені қатты құшақтап ал, сенің тірі екеніңді білемін
Dialogue: 0,0:53:06.42,0:53:10.84,EDJ,NTP,0000,0000,0000,,Тыныштықтан туған
Dialogue: 0,0:53:10.96,0:53:15.18,EDJ,NTP,0000,0000,0000,,Мен әлі жылуды да білмеймін
Dialogue: 0,0:53:15.34,0:53:20.09,EDJ,NTP,0000,0000,0000,,Мен тек өмірге қол жеткізгім келеді
Dialogue: 0,0:53:20.16,0:53:27.38,EDJ,NTP,0000,0000,0000,,Түннен тыс
Dialogue: 0,0:53:40.13,0:53:44.14,EDJ,NTP,0000,0000,0000,,Ностальгиялық жазғы кәмпиттер
Dialogue: 0,0:53:44.49,0:53:48.87,EDJ,NTP,0000,0000,0000,,Мені шығарып салуыңызды өтінемін
Dialogue: 0,0:53:49.01,0:53:53.03,EDJ,NTP,0000,0000,0000,,Бір-біріне сенудің басталуына қарай
Dialogue: 0,0:53:53.12,0:53:57.80,EDJ,NTP,0000,0000,0000,,Мен жылап бара аламын деп.
Dialogue: 0,0:53:57.90,0:54:02.15,EDJ,NTP,0000,0000,0000,,Қуаныш та, қайғы да
Dialogue: 0,0:54:02.30,0:54:06.49,EDJ,NTP,0000,0000,0000,,Мен оны терең ойып алғым келеді
Dialogue: 0,0:54:06.51,0:54:11.19,EDJ,NTP,0000,0000,0000,,Мен сенімен біргемін
Dialogue: 0,0:54:11.22,0:54:15.81,EDJ,NTP,0000,0000,0000,,Сәттілік қалдықтарында
Dialogue: 0,0:54:19.90,0:54:25.83,EDJ,NTP,0000,0000,0000,,Жұлдыз шаңы жоғалған кезде
Dialogue: 0,0:54:28.72,0:54:39.60,EDJ,NTP,0000,0000,0000,,Жарықта мен бірінші рет көріп тұрмын
Dialogue: 0,0:54:55.37,0:54:59.67,EDJ,NTP,0000,0000,0000,,Сол көзбен, сол сүйіспен
Dialogue: 0,0:54:59.82,0:55:04.23,EDJ,NTP,0000,0000,0000,,Маған махаббатымның ізін беріңізші
Dialogue: 0,0:55:04.24,0:55:12.85,EDJ,NTP,0000,0000,0000,,Мен жылағым келеді, өйткені маған өмір еніп жатыр.
Dialogue: 0,0:55:12.99,0:55:17.44,EDJ,NTP,0000,0000,0000,,Тыныштықтан шығыңыз
Dialogue: 0,0:55:17.52,0:55:21.92,EDJ,NTP,0000,0000,0000,,Әлі көрінбеген алыстағы таңға қарай
Dialogue: 0,0:55:21.93,0:55:26.80,EDJ,NTP,0000,0000,0000,,Мен тек тілегімнің орындалғанын қалаймын
Dialogue: 0,0:55:26.86,0:55:35.30,EDJ,NTP,0000,0000,0000,,Түннен тыс
Dialogue: 0,0:51:34.29,0:51:38.55,EDC,NTP,0000,0000,0000,,Тыныштықтан бас тарту
Dialogue: 0,0:51:38.67,0:51:43.10,EDC,NTP,0000,0000,0000,,Бұрын көрмеген махаббат декорациясы
Dialogue: 0,0:51:43.14,0:51:47.83,EDC,NTP,0000,0000,0000,,Зақымдануды растау
Dialogue: 0,0:51:47.87,0:51:56.31,EDC,NTP,0000,0000,0000,,Түн
Dialogue: 0,0:52:07.87,0:52:16.41,EDC,NTP,0000,0000,0000,,Онымен ойнаған кезде кеуденің жоғарғы және төменгі бөлігіндегі тыртықтар.
Dialogue: 0,0:52:16.82,0:52:25.50,EDC,NTP,0000,0000,0000,,Судың жыртылуы және қызыл түс баптауының қалыптасуы
Dialogue: 0,0:52:25.67,0:52:34.23,EDC,NTP,0000,0000,0000,,Мұздай терінің соңында
Dialogue: 0,0:52:34.40,0:52:43.19,EDC,NTP,0000,0000,0000,,Мен осындамын, мен бақыттымын
Dialogue: 0,0:52:43.34,0:52:47.46,EDC,NTP,0000,0000,0000,,Арманның аяқталуы
Dialogue: 0,0:52:47.58,0:52:51.99,EDC,NTP,0000,0000,0000,,Гүлденген жұлдыз сөнгенде
Dialogue: 0,0:52:52.21,0:53:01.63,EDC,NTP,0000,0000,0000,,Мен өмір сүре алмайтынымды түсінетінімді түсінемін.
Dialogue: 0,0:53:06.42,0:53:10.84,EDC,NTP,0000,0000,0000,,Тыныштық кезінде қайта туылу
Dialogue: 0,0:53:10.96,0:53:15.18,EDC,NTP,0000,0000,0000,,Ширанудың ең жылы қаласы қандай?
Dialogue: 0,0:53:15.34,0:53:20.09,EDC,NTP,0000,0000,0000,,Тіршілік қай жерде бар?
Dialogue: 0,0:53:20.16,0:53:27.38,EDC,NTP,0000,0000,0000,,Түн
Dialogue: 0,0:53:40.13,0:53:44.14,EDC,NTP,0000,0000,0000,,Рейджиннің жазғы жауын-шашын
Dialogue: 0,0:53:44.49,0:53:48.87,EDC,NTP,0000,0000,0000,,Мен Будда мүсінін жібердім
Dialogue: 0,0:53:49.01,0:53:53.03,EDC,NTP,0000,0000,0000,,Өзара сенім ашу
Dialogue: 0,0:53:53.12,0:53:57.80,EDC,NTP,0000,0000,0000,,Бейнеге саяхат
Dialogue: 0,0:53:57.90,0:54:02.15,EDC,NTP,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:54:02.30,0:54:06.49,EDC,NTP,0000,0000,0000,,Цусо Абиссалды кесу ашық
Dialogue: 0,0:54:06.51,0:54:11.19,EDC,NTP,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:54:11.22,0:54:15.81,EDC,NTP,0000,0000,0000,,Бақыт іздері
Dialogue: 0,0:54:19.90,0:54:25.83,EDC,NTP,0000,0000,0000,,Гүлденген жұлдыз сөнгенде
Dialogue: 0,0:54:28.72,0:54:39.60,EDC,NTP,0000,0000,0000,,Жарық сәулесіндегі алғашқы бақылау
Dialogue: 0,0:54:55.37,0:54:59.67,EDC,NTP,0000,0000,0000,,Көзді ашатын сүйіспеншілік
Dialogue: 0,0:54:59.82,0:55:04.23,EDC,NTP,0000,0000,0000,,Келер жылы махаббат іздері
Dialogue: 0,0:55:04.24,0:55:12.85,EDC,NTP,0000,0000,0000,,Жылау өмірдің ақыры
Dialogue: 0,0:55:12.99,0:55:17.44,EDC,NTP,0000,0000,0000,,Тыныштықтан бас тарту
Dialogue: 0,0:55:17.52,0:55:21.92,EDC,NTP,0000,0000,0000,,Бұрын-соңды көрмеген алыстағы таң
Dialogue: 0,0:55:21.93,0:55:26.80,EDC,NTP,0000,0000,0000,,Нәтижесін көргім келеді
Dialogue: 0,0:55:26.86,0:55:35.30,EDC,NTP,0000,0000,0000,,Түн
Dialogue: 0,0:00:43.72,0:00:46.44,JPsub,NTP,0000,0000,0000,,Сізге қалай ұнады, жас ханым?
Dialogue: 0,0:00:47.05,0:00:51.85,JPsub,NTP,0000,0000,0000,,Қазір тоқтатыңыз. Бұл өте нашар сезіледі.
Dialogue: 0,0:00:53.14,0:00:54.70,JPsub,NTP,0000,0000,0000,,Жоқ, сен онымен жақсы емес сияқтысың.
Dialogue: 0,0:00:55.99,0:00:59.77,JPsub,NTP,0000,0000,0000,,Урус Бұл жігітте салқындық бар.
Dialogue: 0,0:01:01.52,0:01:06.46,JPsub,NTP,0000,0000,0000,,Жүр, Кейта, сен басқа әйелмен қосыласың ба?
Dialogue: 0,0:01:06.52,0:01:09.90,JPsub,NTP,0000,0000,0000,,Дұрыс, мен бұл жігітті жек көре бастадым.
Dialogue: 0,0:01:10.70,0:01:12.69,JPsub,NTP,0000,0000,0000,,Ал, сәл күтіңдер, балалар.
Dialogue: 0,0:01:13.95,0:01:18.02,JPsub,NTP,0000,0000,0000,,Енді мен оны аздап қызықтырақ етемін.
Dialogue: 0,0:02:30.32,0:02:32.26,JPsub,NTP,0000,0000,0000,,Әй, саған не болды?
Dialogue: 0,0:02:34.88,0:02:36.12,JPsub,NTP,0000,0000,0000,,Менің ішім ауырады.
Dialogue: 0,0:02:39.31,0:02:43.00,JPsub,NTP,0000,0000,0000,,Жоқ, бұл мен.
Dialogue: 0,0:02:49.42,0:02:50.89,JPsub,NTP,0000,0000,0000,,Іші ауырады
Dialogue: 0,0:02:51.82,0:02:52.73,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:02:58.27,0:03:02.50,JPsub,NTP,0000,0000,0000,,Иә, өте ауыр
Dialogue: 0,0:03:05.31,0:03:08.05,JPsub,NTP,0000,0000,0000,,Мен жылайтын сияқтымын
Dialogue: 0,0:03:09.29,0:03:11.83,JPsub,NTP,0000,0000,0000,,Жылауға бола ма?
Dialogue: 0,0:03:12.73,0:03:13.49,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:12.39,0:04:16.71,JPsub,NTP,0000,0000,0000,,Оқиға орын алған жертөледегі бар тура алты ай бойы бос тұр.
Dialogue: 0,0:04:16.96,0:04:21.21,JPsub,NTP,0000,0000,0000,,Кәмелетке толмаған жәбірленушілер жиі келіп-кетіп тұрған.
Dialogue: 0,0:04:22.30,0:04:25.80,JPsub,NTP,0000,0000,0000,,Мәйіттің аяқ-қолын біреу жұлып алған.
Dialogue: 0,0:04:26.05,0:04:29.53,JPsub,NTP,0000,0000,0000,,Полиция өлтірудің егжей-тегжейлі әдісін тергеп жатыр және
Dialogue: 0,0:04:29.76,0:04:31.93,JPsub,NTP,0000,0000,0000,,Біз қылмыскердің жүрген жерін қадағалап жатырмыз.
Dialogue: 0,0:04:41.15,0:04:44.68,JPsub,NTP,0000,0000,0000,,Менің жалақымды келесі айда жіберу деген нені білдіреді?
Dialogue: 0,0:04:45.10,0:04:47.56,JPsub,NTP,0000,0000,0000,,Менің төлеуге ақшам жоқ.
Dialogue: 0,0:04:47.71,0:04:48.89,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:04:48.96,0:04:52.52,JPsub,NTP,0000,0000,0000,,Өйткені өткен күні мен 120 000 иенді аудардым.
Dialogue: 0,0:04:52.70,0:04:54.33,JPsub,NTP,0000,0000,0000,,Сен оны не үшін пайдаландың?
Dialogue: 0,0:04:54.34,0:04:55.82,JPsub,NTP,0000,0000,0000,,Бұл шектен шыққан.
Dialogue: 0,0:04:56.40,0:04:59.45,JPsub,NTP,0000,0000,0000,,Бұл өз алдына қызықсыз.
Dialogue: 0,0:05:00.34,0:05:02.85,JPsub,NTP,0000,0000,0000,,Бұл Виктория Оуижа тақтасы.
Dialogue: 0,0:05:03.33,0:05:05.11,JPsub,NTP,0000,0000,0000,,Әсері көп күтілмесе де
Dialogue: 0,0:05:05.23,0:05:09.56,JPsub,NTP,0000,0000,0000,,Оның жүз жылдан астам болғаны оның түкке тұрғысыз екенін білдірмейді.
Dialogue: 0,0:05:09.81,0:05:15.22,JPsub,NTP,0000,0000,0000,,- Қаншалықты қызықсыз болса да, оның сиқырлы іздері бар және ұзақ уақыт бойы болған болса - түсініктеме жақсы.
Dialogue: 0,0:05:15.59,0:05:19.58,JPsub,NTP,0000,0000,0000,,Бірден пайда болды, мен оны еріксіз сатып алдым.
Dialogue: 0,0:05:19.70,0:05:20.97,JPsub,NTP,0000,0000,0000,,Бұлай ашуланба
Dialogue: 0,0:05:21.17,0:05:23.66,JPsub,NTP,0000,0000,0000,,Мен де бұдан да құтылдым.
Dialogue: 0,0:05:24.05,0:05:28.44,JPsub,NTP,0000,0000,0000,,Осыны айтып тұрсыз ба? Бұл айда қалжың жоқ, жалақы жоқ.
Dialogue: 0,0:05:28.74,0:05:32.12,JPsub,NTP,0000,0000,0000,,Иә, қызметкерлер өз қаржысын реттеуі керек.
Dialogue: 0,0:05:32.48,0:05:34.43,JPsub,NTP,0000,0000,0000,,Мен солай істеймін.
Dialogue: 0,0:05:35.16,0:05:35.95,JPsub,NTP,0000,0000,0000,,- қара пауловния
Dialogue: 0,0:05:36.35,0:05:38.06,JPsub,NTP,0000,0000,0000,,Бұл не, Токо-сан?
Dialogue: 0,0:05:38.65,0:05:40.50,JPsub,NTP,0000,0000,0000,,Маған қарызға ақша бере аласыз ба?
Dialogue: 0,0:05:40.97,0:05:42.78,JPsub,NTP,0000,0000,0000,,Көріп отырғаныңыздай, бәрі жақсы.
Dialogue: 0,0:05:43.23,0:05:45.73,JPsub,NTP,0000,0000,0000,,Бар күшіммен бас тартамын.
Dialogue: 0,0:05:50.78,0:05:55.31,JPsub,NTP,0000,0000,0000,,Дәл адамдық, Ақшадан таршылық көргенде тар болмас.
Dialogue: 0,0:05:55.47,0:05:57.86,JPsub,NTP,0000,0000,0000,,Тоуко Оқиғаның жалғасы
Dialogue: 0,0:05:58.63,0:06:02.91,JPsub,NTP,0000,0000,0000,,Дұрыс. Мен мұндай өтініштерді қабылдағанды ​​ұнатпаймын.
Dialogue: 0,0:06:03.40,0:06:05.95,JPsub,NTP,0000,0000,0000,,Оның алдында тұрған нәрсесіз көмектесуге болмайды.
Dialogue: 0,0:06:08.23,0:06:11.46,JPsub,NTP,0000,0000,0000,,Енді кеше түнгі оқиғаға тоқталайық.
Dialogue: 0,0:06:11.96,0:06:15.20,JPsub,NTP,0000,0000,0000,,Жетеді, түсіндім.
Dialogue: 0,0:06:16.76,0:06:19.65,JPsub,NTP,0000,0000,0000,,Әй, сен оқиға орнындағы жағдайды түсіндірдің ғой.
Dialogue: 0,0:06:20.10,0:06:22.46,JPsub,NTP,0000,0000,0000,,Жақсы болжам, сен
Dialogue: 0,0:06:23.16,0:06:26.18,JPsub,NTP,0000,0000,0000,,Сұраныс берушіде кінәлі туралы түсінік бар.
Dialogue: 0,0:06:26.50,0:06:30.24,JPsub,NTP,0000,0000,0000,,Сіздің міндетіңіз қылмыскерді мүмкіндігінше қорғау.
Dialogue: 0,0:06:30.62,0:06:35.28,JPsub,NTP,0000,0000,0000,,Бірақ қарсылық көрсетсең, мені ойланбастан өлтіруіңді қалаймын.
Dialogue: 0,0:06:36.36,0:06:37.14,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:06:37.66,0:06:41.49,JPsub,NTP,0000,0000,0000,,Мен не істеуім керек? Менің ойымша, бұл сізге арналған жұмыс.
Dialogue: 0,0:06:41.67,0:06:44.19,JPsub,NTP,0000,0000,0000,,Бұған жауап берудің қажеті жоқ.
Dialogue: 0,0:06:44.42,0:06:46.91,JPsub,NTP,0000,0000,0000,,Бұл сәл асығыс емес пе?
Dialogue: 0,0:06:47.37,0:06:49.42,JPsub,NTP,0000,0000,0000,,Сіз шынымен аш болдыңыз ба?
Dialogue: 0,0:06:50.97,0:06:53.50,JPsub,NTP,0000,0000,0000,,Бұл басқа адамның фотосы мен фоны.
Dialogue: 0,0:06:54.26,0:06:57.18,JPsub,NTP,0000,0000,0000,,Менің бетімді білмей не істейсің?
Dialogue: 0,0:06:57.98,0:07:02.07,JPsub,NTP,0000,0000,0000,,Қажет емес, ол да мен сияқты.
Dialogue: 0,0:07:02.67,0:07:07.11,JPsub,NTP,0000,0000,0000,,Сондықтан кездескен сәтте бір-бірімізді өлтіретінімізге сенімдімін.
Dialogue: 0,0:07:15.50,0:07:20.10,JPsub,NTP,0000,0000,0000,,Ха, эй, біреуді қарызға шақырасың.
Dialogue: 0,0:07:20.29,0:07:23.56,JPsub,NTP,0000,0000,0000,,Сіз шынымен Микия Курогирисіз бе?
Dialogue: 0,0:07:23.86,0:07:26.82,JPsub,NTP,0000,0000,0000,,Егер мен бұрышта қалсам, мен не қажет болса, соны істеймін.
Dialogue: 0,0:07:27.12,0:07:29.16,JPsub,NTP,0000,0000,0000,,Қазір жағдай осылай.
Dialogue: 0,0:07:29.28,0:07:33.88,JPsub,NTP,0000,0000,0000,,Солай болса да, меннен гөрі ата-анаңнан қарызға алу тезірек емес пе?
Dialogue: 0,0:07:34.16,0:07:36.83,JPsub,NTP,0000,0000,0000,,Мен университеттен шыққанда ұрысып қалдық, солай болды.
Dialogue: 0,0:07:37.35,0:07:39.97,JPsub,NTP,0000,0000,0000,,Неге қазір басымды иіп үйге баруым керек?
Dialogue: 0,0:07:40.15,0:07:43.55,JPsub,NTP,0000,0000,0000,,Хаха Микия бейтаныс жерлерде қыңыр.
Dialogue: 0,0:07:43.66,0:07:46.05,JPsub,NTP,0000,0000,0000,,Әкеңізбен төбелесіп қалдыңыз ба?
Dialogue: 0,0:07:46.36,0:07:49.12,JPsub,NTP,0000,0000,0000,,Мен өз жағдайыммен айналыспаймын.
Dialogue: 0,0:07:49.35,0:07:51.65,JPsub,NTP,0000,0000,0000,,Қарыз беру немесе бермеу
Dialogue: 0,0:07:51.99,0:07:54.99,JPsub,NTP,0000,0000,0000,,Не? Сіздің көңіл-күйіңіз өте нашар, солай емес пе?
Dialogue: 0,0:07:57.83,0:07:58.75,JPsub,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:08:01.61,0:08:06.18,JPsub,NTP,0000,0000,0000,,''Балық жүрегің болса, су жүрегің бар'' екенін білесің.
Dialogue: 0,0:08:08.62,0:08:11.24,JPsub,NTP,0000,0000,0000,,Кейта Минатоны есіңе түсірмейсің бе?
Dialogue: 0,0:08:11.46,0:08:16.36,JPsub,NTP,0000,0000,0000,,Сен менің кіші оқушымсың, мен саған айттым ғой, мен орта мектепте оқып жүргенімде сені қатты жақсы көретінмін.
Dialogue: 0,0:08:17.68,0:08:19.09,JPsub,NTP,0000,0000,0000,,О, оған не болды?
Dialogue: 0,0:08:19.13,0:08:21.86,JPsub,NTP,0000,0000,0000,,Кешегі түннен бері үйге келмеген сияқты.
Dialogue: 0,0:08:22.09,0:08:23.75,JPsub,NTP,0000,0000,0000,,Маған оны табуға көмектесіңіз
Dialogue: 0,0:08:25.49,0:08:29.48,JPsub,NTP,0000,0000,0000,,Мен бір қорқынышты нәрсеге тап болған сияқтымын.
Dialogue: 0,0:08:30.01,0:08:31.34,JPsub,NTP,0000,0000,0000,,Қауіпті заттар
Dialogue: 0,0:09:08.19,0:09:12.96,JPsub,NTP,0000,0000,0000,,Сіз білесіз бе? Кейта-сан қайда?
Dialogue: 0,0:09:22.83,0:09:27.38,JPsub,NTP,0000,0000,0000,,Мен шынымен Кейта-санмен кездесуім керек.
Dialogue: 0,0:09:29.67,0:09:31.94,JPsub,NTP,0000,0000,0000,,Егер мен...
Dialogue: 0,0:09:41.42,0:09:46.83,JPsub,NTP,0000,0000,0000,,Олай болса, менің ойымша, сіз ұйықтауды ұнатпайсыз. Жатақхана меңгерушісі өте ашулы.
Dialogue: 0,0:09:46.99,0:09:48.34,JPsub,NTP,0000,0000,0000,,Сондықтан мен саған айттым.
Dialogue: 0,0:09:49.04,0:09:56.10,JPsub,NTP,0000,0000,0000,,Сыныптың жоғарғы сатысында тұрған Фуджино екеуміз үлгі алып, ұйықтауға жеке барсақ, бағаларымыз жақсарады деп ойладым.
Dialogue: 0,0:09:57.56,0:10:00.72,JPsub,NTP,0000,0000,0000,,Фуджино Мүмкін сіз қобалжыған шығарсыз.
Dialogue: 0,0:10:03.02,0:10:05.06,JPsub,NTP,0000,0000,0000,,Бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:10:05.15,0:10:08.85,JPsub,NTP,0000,0000,0000,,Менің ағам – адам мен малға зиянсыз деп сөйлейтін адам.
Dialogue: 0,0:10:09.16,0:10:13.18,JPsub,NTP,0000,0000,0000,,Бірақ мен әрқашан адамдарды табуға шебер болдым, сен де мені табатыныңа сенімдімін.
Dialogue: 0,0:10:13.22,0:10:14.81,JPsub,NTP,0000,0000,0000,,Бұл да мен жақсы көретін аға
Dialogue: 0,0:10:15.34,0:10:15.93,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:16.37,0:10:17.16,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер
Dialogue: 0,0:10:20.91,0:10:26.25,JPsub,NTP,0000,0000,0000,,Рёги Шики Мен ағаммен кездесіп жатырмын.
Dialogue: 0,0:10:26.34,0:10:28.17,JPsub,NTP,0000,0000,0000,,Менің сенімен шаруам жоқ.
Dialogue: 0,0:10:28.61,0:10:30.89,JPsub,NTP,0000,0000,0000,,Бұл сол ағаның хабары.
Dialogue: 0,0:10:31.13,0:10:32.69,JPsub,NTP,0000,0000,0000,,Мен бүгін келе алмаймын.
Dialogue: 0,0:10:33.02,0:10:34.54,JPsub,NTP,0000,0000,0000,,Сізді мүлде елеусіз қалдырды.
Dialogue: 0,0:10:35.60,0:10:38.28,JPsub,NTP,0000,0000,0000,,Формула Бұл сіздің әрекетіңіз.
Dialogue: 0,0:10:38.51,0:10:41.32,JPsub,NTP,0000,0000,0000,,Бұл ақталу.
Dialogue: 0,0:10:41.32,0:10:42.79,JPsub,NTP,0000,0000,0000,,Мен де құрбанмын
Dialogue: 0,0:10:43.23,0:10:47.63,JPsub,NTP,0000,0000,0000,,Мен Сенькамен кездесе алмаймын, мені жіберіңізші. Ол қазірдің өзінде осында.
Dialogue: 0,0:10:47.65,0:10:48.63,JPsub,NTP,0000,0000,0000,,Бұл Гачан
Dialogue: 0,0:10:50.71,0:10:52.76,JPsub,NTP,0000,0000,0000,,Сол Куротоу-сан
Dialogue: 0,0:10:52.83,0:10:53.42,JPsub,NTP,0000,0000,0000,,Нани
Dialogue: 0,0:10:55.14,0:10:57.79,JPsub,NTP,0000,0000,0000,,Барлығы таң қалды.
Dialogue: 0,0:10:59.34,0:11:01.94,JPsub,NTP,0000,0000,0000,,Жоқ, мен қаламаймын.
Dialogue: 0,0:11:02.03,0:11:03.39,JPsub,NTP,0000,0000,0000,,Кешіріңіз Фуджино
Dialogue: 0,0:11:05.42,0:11:06.27,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:11:07.43,0:11:09.78,JPsub,NTP,0000,0000,0000,,Ей, сен ауырған жоқсың ба?
Dialogue: 0,0:11:15.98,0:11:18.30,JPsub,NTP,0000,0000,0000,,Жоқ, бұл сен емессің.
Dialogue: 0,0:11:18.30,0:11:20.18,JPsub,NTP,0000,0000,0000,,Эй, не?
Dialogue: 0,0:11:20.33,0:11:24.91,JPsub,NTP,0000,0000,0000,,Менің ағама ғана көңілім толмайды, енді менің ең жақын досыма да құлағымды теуіп жатырсың.
Dialogue: 0,0:11:25.34,0:11:28.88,JPsub,NTP,0000,0000,0000,,Жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:11:29.08,0:11:32.83,JPsub,NTP,0000,0000,0000,,Мен оған жету қиынға соғып жатыр. Сен не туралы айтып тұрсың?
Dialogue: 0,0:11:32.89,0:11:34.83,JPsub,NTP,0000,0000,0000,,Сондықтан олар мені аңдығалы жатыр.
Dialogue: 0,0:11:34.91,0:11:37.71,JPsub,NTP,0000,0000,0000,,Менің айтайын дегенім, сіз өзіңізді аздап санамайсыз ба?
Dialogue: 0,0:11:37.71,0:11:39.87,JPsub,NTP,0000,0000,0000,,Біреу тым өзін-өзі санайды.
Dialogue: 0,0:11:39.93,0:11:43.17,JPsub,NTP,0000,0000,0000,,Мен осылай киініп жүрген адамдардың бұлай айтқанын қаламаймын.
Dialogue: 0,0:11:43.29,0:11:46.42,JPsub,NTP,0000,0000,0000,,Бұл қажетсіз қиындық. Өтінемін, мені жалғыз қалдырыңыз.
Dialogue: 0,0:11:46.94,0:11:51.71,JPsub,NTP,0000,0000,0000,,Қалай болғанда да, бұл сізге керек. Оған хабарыңыз бар ма?
Dialogue: 0,0:11:52.01,0:11:54.58,JPsub,NTP,0000,0000,0000,,Олай болса маған бір нәрсе айтыңызшы.
Dialogue: 0,0:11:54.88,0:11:58.79,JPsub,NTP,0000,0000,0000,,Аға, бұл әйелді тезірек кесіп тастаңызшы.
Dialogue: 0,0:11:58.95,0:12:01.36,JPsub,NTP,0000,0000,0000,,Жақсы, мен саған айтамын.
Dialogue: 0,0:12:01.91,0:12:02.61,JPsub,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:12:10.70,0:12:14.99,JPsub,NTP,0000,0000,0000,,Кешіріңіз, мен Фуджино Микиямен сөйлесемін.
Dialogue: 0,0:12:17.54,0:12:19.29,JPsub,NTP,0000,0000,0000,,Ол әдемі адам еді.
Dialogue: 0,0:12:19.92,0:12:20.87,JPsub,NTP,0000,0000,0000,,Жақсы.
Dialogue: 0,0:12:21.12,0:12:24.63,JPsub,NTP,0000,0000,0000,,Бірақ мен ол адамды жек көремін.
Dialogue: 0,0:12:30.56,0:12:32.23,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл өткен түнде болды.
Dialogue: 0,0:12:32.35,0:12:35.32,JPsub,NTP,0000,0000,0000,,Әйтеуір Сакуя-кунға Кейта-кун телефон соқты.
Dialogue: 0,0:12:35.46,0:12:38.15,JPsub,NTP,0000,0000,0000,,Менің ойымша, ол өлтірілгені туралы бірдеңе айтты.
Dialogue: 0,0:12:39.52,0:12:40.78,JPsub,NTP,0000,0000,0000,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:12:41.36,0:12:44.60,JPsub,NTP,0000,0000,0000,,Кейтаның достары бірінен соң бірі өлтірілді, солай ма?
Dialogue: 0,0:12:44.75,0:12:47.05,JPsub,NTP,0000,0000,0000,,Мен сені шындап жылауыңды сұрап тұрған сияқтымын.
Dialogue: 0,0:12:50.69,0:12:53.10,JPsub,NTP,0000,0000,0000,,Есірткі ішкенім ұнамайды.
Dialogue: 0,0:12:53.38,0:12:55.64,JPsub,NTP,0000,0000,0000,,Ол жігіттер шайтандар.
Dialogue: 0,0:12:57.46,0:13:00.62,JPsub,NTP,0000,0000,0000,,Барлығы бір күні шаншып қалатынын айтты.
Dialogue: 0,0:13:02.19,0:13:05.50,JPsub,NTP,0000,0000,0000,,Мен үшін тұрақты тұтынушылардың саны азайды, бұл үлкен соққы.
Dialogue: 0,0:13:05.90,0:13:06.92,JPsub,NTP,0000,0000,0000,,О, мен не істеуім керек?
Dialogue: 0,0:13:07.04,0:13:10.34,JPsub,NTP,0000,0000,0000,,Егер сіз Гакутомен бірге болсаңыз, Pake 2000-ге жеңілесіз.
Dialogue: 0,0:13:17.68,0:13:20.62,JPsub,NTP,0000,0000,0000,,Кохэй дүкеннің сыртында болмады.
Dialogue: 0,0:13:21.49,0:13:23.78,JPsub,NTP,0000,0000,0000,,Иә, сіз әлі де істеп жатырсыз ба?
Dialogue: 0,0:13:25.29,0:13:28.55,JPsub,NTP,0000,0000,0000,,Жас келіншекке ұқсайтын бір қыз келіп, менімен сөйлескісі келетінін айтты.
Dialogue: 0,0:13:29.68,0:13:31.40,JPsub,NTP,0000,0000,0000,,Бұл мен білетін бала.
Dialogue: 0,0:13:31.66,0:13:33.73,JPsub,NTP,0000,0000,0000,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:13:34.07,0:13:36.57,JPsub,NTP,0000,0000,0000,,Ол да қолдарын жайып ойнайды.
Dialogue: 0,0:13:37.39,0:13:40.44,JPsub,NTP,0000,0000,0000,,Мен тез ораламын, ол жылдам.
Dialogue: 0,0:14:04.16,0:14:09.72,JPsub,NTP,0000,0000,0000,,Маған Кейтаның қайда екенін айтыңызшы.
Dialogue: 0,0:14:10.75,0:14:13.86,JPsub,NTP,0000,0000,0000,,Тас тас...
Dialogue: 0,0:14:21.35,0:14:23.18,JPsub,NTP,0000,0000,0000,,Менің аяғым
Dialogue: 0,0:14:23.47,0:14:25.10,JPsub,NTP,0000,0000,0000,,Неджи
Dialogue: 0,0:14:26.59,0:14:28.58,JPsub,NTP,0000,0000,0000,,Бұл бұранда, бұл менің аяғым.
Dialogue: 0,0:14:29.26,0:14:31.50,JPsub,NTP,0000,0000,0000,,Мен аяғымды бұрандамен аяқтадым.
Dialogue: 0,0:14:36.21,0:14:37.10,JPsub,NTP,0000,0000,0000,,иілу
Dialogue: 0,0:14:50.83,0:14:57.37,JPsub,NTP,0000,0000,0000,,Кешіріңіз, бірақ мен мұны істеуім керек.
Dialogue: 0,0:14:58.07,0:15:03.62,JPsub,NTP,0000,0000,0000,,Осылайша мен ақырында қарапайым адам сияқты бола аламын.
Dialogue: 0,0:15:05.36,0:15:09.90,JPsub,NTP,0000,0000,0000,,Негізі мен ешкімді өлтіргім келмейді.
Dialogue: 0,0:15:09.98,0:15:12.50,JPsub,NTP,0000,0000,0000,,Жоқ, сен.
Dialogue: 0,0:15:18.46,0:15:22.22,JPsub,NTP,0000,0000,0000,,Мен көріп тұрмын Фуджино Асагами.
Dialogue: 0,0:15:22.66,0:15:25.03,JPsub,NTP,0000,0000,0000,,Оның Асагамимен туысы болды ма?
Dialogue: 0,0:15:25.73,0:15:28.79,JPsub,NTP,0000,0000,0000,,Шики мырза, мен білмей тұрып
Dialogue: 0,0:15:29.47,0:15:34.25,JPsub,NTP,0000,0000,0000,,Сіз бұл етті алдап алғаннан бері болды.
Dialogue: 0,0:15:35.03,0:15:39.47,JPsub,NTP,0000,0000,0000,,Мені бір кесек ет демеңіз. Бұл адам адам.
Dialogue: 0,0:15:39.71,0:15:40.56,JPsub,NTP,0000,0000,0000,,Адам...
Dialogue: 0,0:15:40.56,0:15:43.98,JPsub,NTP,0000,0000,0000,,Адамдардың бұлай өлмейтіні сондықтан.
Dialogue: 0,0:15:44.31,0:15:48.04,JPsub,NTP,0000,0000,0000,,Адам болып өлмегендерді енді адам деп атауға болмайды.
Dialogue: 0,0:15:48.42,0:15:52.70,JPsub,NTP,0000,0000,0000,,Шекарасынан аластатылып, Тамырынан жұлып, мағынасынан айырылған.
Dialogue: 0,0:15:53.12,0:15:55.37,JPsub,NTP,0000,0000,0000,,Жалпы мағынаны енді қолдануға болмайды.
Dialogue: 0,0:15:55.47,0:15:57.22,JPsub,NTP,0000,0000,0000,,Сіз де.
Dialogue: 0,0:15:57.29,0:15:58.19,JPsub,NTP,0000,0000,0000,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:15:58.63,0:16:01.84,JPsub,NTP,0000,0000,0000,,Мен сен сияқты емеспін.
Dialogue: 0,0:16:04.33,0:16:06.50,JPsub,NTP,0000,0000,0000,,Біз ұқсаспыз.
Dialogue: 0,0:16:07.13,0:16:08.58,JPsub,NTP,0000,0000,0000,,Фудзино Асагами
Dialogue: 0,0:16:09.83,0:16:11.33,JPsub,NTP,0000,0000,0000,,Алданбаңыз
Dialogue: 0,0:16:22.01,0:16:25.97,JPsub,NTP,0000,0000,0000,,Саған тағы не болып жатыр?
Dialogue: 0,0:16:32.30,0:16:34.52,JPsub,NTP,0000,0000,0000,,Жетеді, ақ түсті.
Dialogue: 0,0:16:35.18,0:16:37.67,JPsub,NTP,0000,0000,0000,,Сен қазір өлтіруге тұрарлық емессің.
Dialogue: 0,0:16:38.22,0:16:42.21,JPsub,NTP,0000,0000,0000,,Үйге қайт, енді бір-бірімізді көрмейміз.
Dialogue: 0,0:16:54.35,0:17:00.10,JPsub,NTP,0000,0000,0000,,Кішкентай кезімде үй ойнап жүріп алақанымды кесіп алғанмын.
Dialogue: 0,0:17:03.84,0:17:09.38,JPsub,NTP,0000,0000,0000,,Өйткені кішкентай ыдыс-аяқтардың арасында бір ғана нағыз пышақ болды.
Dialogue: 0,0:17:13.32,0:17:16.45,JPsub,NTP,0000,0000,0000,,Фуджино, сен не істеп жатырсың?
Dialogue: 0,0:17:21.18,0:17:23.10,JPsub,NTP,0000,0000,0000,,Қаншама қан
Dialogue: 0,0:17:24.70,0:17:26.26,JPsub,NTP,0000,0000,0000,,Ауырған болуы керек
Dialogue: 0,0:17:27.78,0:17:31.12,JPsub,NTP,0000,0000,0000,,Бұл түсініксіз сөздер еді.
Dialogue: 0,0:17:31.85,0:17:35.34,JPsub,NTP,0000,0000,0000,,Бірақ мені құшақтап алғаныңызға қуаныштымын
Dialogue: 0,0:17:48.49,0:17:52.61,JPsub,NTP,0000,0000,0000,,Фуджино Жара жазылса, ол енді ауырмайды.
Dialogue: 0,0:17:53.75,0:17:57.18,JPsub,NTP,0000,0000,0000,,Мен бұл сөздің нені білдіретінін де білмеймін.
Dialogue: 0,0:17:58.07,0:18:02.74,JPsub,NTP,0000,0000,0000,,Өйткені мен ешқашан ауырған емеспін.
Dialogue: 0,0:18:05.98,0:18:10.40,JPsub,NTP,0000,0000,0000,,Бірақ мен ақыры түсіндім.
Dialogue: 0,0:18:11.74,0:18:14.77,JPsub,NTP,0000,0000,0000,,Менің ішім қатты ауырады
Dialogue: 0,0:18:18.25,0:18:20.35,JPsub,NTP,0000,0000,0000,,Ауырсынып алсам да
Dialogue: 0,0:18:21.06,0:18:22.44,JPsub,NTP,0000,0000,0000,,Мен тірі болсам да
Dialogue: 0,0:18:22.66,0:18:24.89,JPsub,NTP,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:18:25.43,0:18:26.83,JPsub,NTP,0000,0000,0000,,Мен оны шынымен жек көремін.
Dialogue: 0,0:18:26.96,0:18:29.71,JPsub,NTP,0000,0000,0000,,Менің өлтіруші екенімді білсе ше?
Dialogue: 0,0:18:30.47,0:18:35.66,JPsub,NTP,0000,0000,0000,,Сондықтан мен сені өлтіруім керек, Кейта-сан.
Dialogue: 0,0:18:35.91,0:18:38.49,JPsub,NTP,0000,0000,0000,,Тоқта, тоқта!
Dialogue: 0,0:18:41.43,0:18:44.06,JPsub,NTP,0000,0000,0000,,Күрогири-сенпай, маған көмектесіңізші.
Dialogue: 0,0:18:45.55,0:18:47.67,JPsub,NTP,0000,0000,0000,,Оның есі дұрыс емес.
Dialogue: 0,0:18:49.39,0:18:52.07,JPsub,NTP,0000,0000,0000,,Мен мұны біртүрлі деп ойладым.
Dialogue: 0,0:18:52.26,0:18:55.58,JPsub,NTP,0000,0000,0000,,Ол құбыжық болды.
Dialogue: 0,0:18:56.59,0:18:57.71,JPsub,NTP,0000,0000,0000,,Канжу Нагаре
Dialogue: 0,0:18:59.03,0:19:00.92,JPsub,NTP,0000,0000,0000,,Сіз бұған сенбейсіз.
Dialogue: 0,0:19:01.27,0:19:04.44,JPsub,NTP,0000,0000,0000,,Бар болғаны орнынан тұрды.
Dialogue: 0,0:19:04.91,0:19:06.60,JPsub,NTP,0000,0000,0000,,Барлығы бұралып қалады.
Dialogue: 0,0:19:07.11,0:19:10.04,JPsub,NTP,0000,0000,0000,,Мен сүйектердің сынған дыбысын естідім.
Dialogue: 0,0:19:10.34,0:19:11.19,JPsub,NTP,0000,0000,0000,,Барлығы
Dialogue: 0,0:19:14.05,0:19:15.99,JPsub,NTP,0000,0000,0000,,Олардың барлығы өлтірілді.
Dialogue: 0,0:19:18.70,0:19:21.62,JPsub,NTP,0000,0000,0000,,Жарайды, мен сенің айтқаныңа сенемін.
Dialogue: 0,0:19:22.72,0:19:23.61,JPsub,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:19:23.94,0:19:27.45,JPsub,NTP,0000,0000,0000,,Түсінбейтін нәрселерді қабылдауға мәжбүрлемегеніңіз дұрыс.
Dialogue: 0,0:19:32.94,0:19:37.06,JPsub,NTP,0000,0000,0000,,Одан да о бастан оғаш болды дегеніңіз не?
Dialogue: 0,0:19:39.09,0:19:44.98,JPsub,NTP,0000,0000,0000,,Мен Фудзиноны алғаш рет жарты жыл бұрын ойнадым.
Dialogue: 0,0:19:48.90,0:19:51.01,JPsub,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:19:51.48,0:19:53.50,JPsub,NTP,0000,0000,0000,,Бұл театрландырылған сияқты.
Dialogue: 0,0:19:56.90,0:20:01.26,JPsub,NTP,0000,0000,0000,,Сіз не істесеңіз де, сіздің реакцияңыз кешіктіріледі.
Dialogue: 0,0:20:04.62,0:20:07.63,JPsub,NTP,0000,0000,0000,,Мені қорқытса да, менің жүзім мүлде өзгермейді.
Dialogue: 0,0:20:08.54,0:20:10.61,JPsub,NTP,0000,0000,0000,,Мəжбүрлеп дəрі ішсе де ештеңе өзгермейді.
Dialogue: 0,0:20:11.29,0:20:13.87,JPsub,NTP,0000,0000,0000,,Таяқ жесе де сабыр сақтадым.
Dialogue: 0,0:20:16.09,0:20:19.07,JPsub,NTP,0000,0000,0000,,Сондықтан ол керемет көрінді.
Dialogue: 0,0:20:19.70,0:20:24.17,JPsub,NTP,0000,0000,0000,,Мен оны қолданып көргенімде де, бұл өте қызық болмады. Бұл қуыршақ ұстағандай болды.
Dialogue: 0,0:20:24.86,0:20:28.81,JPsub,NTP,0000,0000,0000,,Бірақ иә, ол кезде бәрі басқаша еді.
Dialogue: 0,0:20:29.45,0:20:31.22,JPsub,NTP,0000,0000,0000,,Бұл жақында болған оқиға.
Dialogue: 0,0:20:31.66,0:20:35.54,JPsub,NTP,0000,0000,0000,,Менің бір досымның күлкілі болғаны сонша, мен оның арқасынан темір таяқпен ұрдым.
Dialogue: 0,0:20:42.19,0:20:46.68,JPsub,NTP,0000,0000,0000,,Кенет әлгі жігіт ауырғанынан бетін бұрап қалды.
Dialogue: 0,0:20:47.18,0:20:50.34,JPsub,NTP,0000,0000,0000,,Керісінше жеңілдеп қалдым.
Dialogue: 0,0:20:50.64,0:20:53.30,JPsub,NTP,0000,0000,0000,,Аа, менің ойымша, бұл жігіт те ауырады.
Dialogue: 0,0:20:54.01,0:20:58.67,JPsub,NTP,0000,0000,0000,,Оның адам болғанына қуанғаным үшін сол түн есімде.
Dialogue: 0,0:21:00.30,0:21:03.36,JPsub,NTP,0000,0000,0000,,Сен, бір сәт үніңді өшір.
Dialogue: 0,0:21:05.01,0:21:06.86,JPsub,NTP,0000,0000,0000,,Бұл ақкөңіл адам
Dialogue: 0,0:21:09.87,0:21:12.79,JPsub,NTP,0000,0000,0000,,Мені осылай мазақ ететін шығар деп ойладым.
Dialogue: 0,0:21:15.92,0:21:20.28,JPsub,NTP,0000,0000,0000,,Кейтаның әңгімесін тыңдағаннан кейін де ол оны қорғайды.
Dialogue: 0,0:21:20.62,0:21:22.58,JPsub,NTP,0000,0000,0000,,Идиоттар соңынан еруі керек.
Dialogue: 0,0:21:23.41,0:21:26.57,JPsub,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес, ол жағдайға байланысты.
Dialogue: 0,0:21:27.25,0:21:30.04,JPsub,NTP,0000,0000,0000,,Бұл, әрине, ерекше жағдай.
Dialogue: 0,0:21:30.29,0:21:32.95,JPsub,NTP,0000,0000,0000,,Енді не істеуді жоспарлап отырсыз?
Dialogue: 0,0:21:33.52,0:21:36.85,JPsub,NTP,0000,0000,0000,,Менің ойымша, бізде кездесіп, сөйлесуден басқа амал жоқ.
Dialogue: 0,0:21:36.99,0:21:40.71,JPsub,NTP,0000,0000,0000,,Міне, сондықтан да сен ақкөңіл адамсың.
Dialogue: 0,0:21:41.25,0:21:43.51,JPsub,NTP,0000,0000,0000,,Мен онымен сөйлесе алмаймын.
Dialogue: 0,0:21:43.60,0:21:44.87,JPsub,NTP,0000,0000,0000,,Бұл мүлдем кеш
Dialogue: 0,0:21:45.44,0:21:47.58,JPsub,NTP,0000,0000,0000,,Мақсатыңызға жеткенше тоқтамаңыз
Dialogue: 0,0:21:47.70,0:21:50.28,JPsub,NTP,0000,0000,0000,,Жоқ, қызық, тоқтай ма?
Dialogue: 0,0:21:50.37,0:21:54.29,JPsub,NTP,0000,0000,0000,,Сіз Фуджино Асагамиді білетін сияқтысыз.
Dialogue: 0,0:21:54.29,0:21:56.10,JPsub,NTP,0000,0000,0000,,Мен білемін және кездестім.
Dialogue: 0,0:21:56.31,0:21:59.65,JPsub,NTP,0000,0000,0000,,Себебі мен сені кеше Сенькамен кездесуге ертіп бардым.
Dialogue: 0,0:21:59.75,0:22:01.05,JPsub,NTP,0000,0000,0000,,Балғын гүлдер мен
Dialogue: 0,0:22:02.12,0:22:05.64,JPsub,NTP,0000,0000,0000,,Сонымен, ол қазір мектепке бара ма?
Dialogue: 0,0:22:05.80,0:22:09.60,JPsub,NTP,0000,0000,0000,,Жоқ, оқиға болған түннен бері мен жатақханаға да, үйге де келген жоқпын.
Dialogue: 0,0:22:09.67,0:22:10.96,JPsub,NTP,0000,0000,0000,,Мектеп те жабылды
Dialogue: 0,0:22:11.69,0:22:13.85,JPsub,NTP,0000,0000,0000,,Сеньканың да кешеден бері көрмегенін естідім.
Dialogue: 0,0:22:15.68,0:22:20.78,JPsub,NTP,0000,0000,0000,,Мен алатын жалғыз нәрсе - біреуді іздеу туралы өтініш. Бұл толық жоғалған адам.
Dialogue: 0,0:22:21.43,0:22:26.17,JPsub,NTP,0000,0000,0000,,Қалғаны қиынға соғады, сондықтан Курогири осында Кейта баламен қалуы керек.
Dialogue: 0,0:22:26.47,0:22:30.41,JPsub,NTP,0000,0000,0000,,Арагото Фуджино Асагамимен не істемекші?
Dialogue: 0,0:22:30.72,0:22:33.68,JPsub,NTP,0000,0000,0000,,Кейбір жағдайларда ұрыс болмай қоймайды.
Dialogue: 0,0:22:33.78,0:22:37.60,JPsub,NTP,0000,0000,0000,,Ол кездейсоқ кісі өлтірмейді.
Dialogue: 0,0:22:37.64,0:22:39.39,JPsub,NTP,0000,0000,0000,,талқылауға болады деп ойлаймын
Dialogue: 0,0:22:39.98,0:22:41.32,JPsub,NTP,0000,0000,0000,,А, бұл мүмкін емес.
Dialogue: 0,0:22:41.90,0:22:45.67,JPsub,NTP,0000,0000,0000,,Бұрын мен Кейта Минатоны ұйықтатып жатқанда, мен оны мойындауға мәжбүрледім.
Dialogue: 0,0:22:45.90,0:22:51.09,JPsub,NTP,0000,0000,0000,,Соңғы түнде оның жетекшісі Фуджино Асагамиге пышақпен шабуыл жасағанға ұқсайды.
Dialogue: 0,0:22:51.81,0:22:55.38,JPsub,NTP,0000,0000,0000,,Сол кезде Фудзиноны пышақтап кеткен сияқты.
Dialogue: 0,0:22:55.53,0:22:57.53,JPsub,NTP,0000,0000,0000,,Бұл кек алуды тудырады.
Dialogue: 0,0:22:59.74,0:23:01.43,JPsub,NTP,0000,0000,0000,,Мәселе осы жерден басталады.
Dialogue: 0,0:23:01.76,0:23:04.66,JPsub,NTP,0000,0000,0000,,20-ға қараған түні менің ішіме пышақ сұққан.
Dialogue: 0,0:23:04.86,0:23:07.21,JPsub,NTP,0000,0000,0000,,Екі күннен кейін салтанатты жиын өтті.
Dialogue: 0,0:23:07.41,0:23:10.69,JPsub,NTP,0000,0000,0000,,Ол кезде Фуджино Асагами жарақат алмаған.
Dialogue: 0,0:23:10.72,0:23:12.18,JPsub,NTP,0000,0000,0000,,Оның толық жазылып кеткені айтылады.
Dialogue: 0,0:23:13.93,0:23:15.54,JPsub,NTP,0000,0000,0000,,Асқазандағы пышақ жарақаты
Dialogue: 0,0:23:20.37,0:23:24.16,JPsub,NTP,0000,0000,0000,,Бірақ Фуджино маған телефон арқылы оның ауырып жатқанын айтты.
Dialogue: 0,0:23:24.48,0:23:28.37,JPsub,NTP,0000,0000,0000,,Бәлкім, өткен сайын өткен қорлық естелік санамнан өшіп тұратын шығар.
Dialogue: 0,0:23:28.40,0:23:30.93,JPsub,NTP,0000,0000,0000,,Ішке пышақ салғандағы ауырсынуды еске түсіру.
Dialogue: 0,0:23:30.99,0:23:32.96,JPsub,NTP,0000,0000,0000,,Фуджино кісі өлтірді.
Dialogue: 0,0:23:33.44,0:23:36.93,JPsub,NTP,0000,0000,0000,,Пікірталас кезінде ол болмайды деп кім айта алады?
Dialogue: 0,0:23:36.99,0:23:38.42,JPsub,NTP,0000,0000,0000,,Жоқ, Туко.
Dialogue: 0,0:23:38.83,0:23:40.98,JPsub,NTP,0000,0000,0000,,Ол қатты ауырады
Dialogue: 0,0:23:41.48,0:23:44.93,JPsub,NTP,0000,0000,0000,,Фуджино Асагамидің ауруы әлі де денесінде сақталады.
Dialogue: 0,0:23:46.84,0:23:48.54,JPsub,NTP,0000,0000,0000,,Жарақат болған жоқ, солай ма?
Dialogue: 0,0:23:49.20,0:23:51.16,JPsub,NTP,0000,0000,0000,,Мен толық сауығып кетсем де
Dialogue: 0,0:23:52.46,0:23:55.41,JPsub,NTP,0000,0000,0000,,Ауырсынатын жара?
Dialogue: 0,0:24:00.81,0:24:04.15,JPsub,NTP,0000,0000,0000,,Тек ауыру сезімі ғана қалады дейсіз бе?
Dialogue: 0,0:24:07.10,0:24:11.16,JPsub,NTP,0000,0000,0000,,Мүмкін бұл анальгетиктер.
Dialogue: 0,0:24:11.45,0:24:13.04,JPsub,NTP,0000,0000,0000,,Фуджино Асагами
Dialogue: 0,0:24:13.85,0:24:18.27,JPsub,NTP,0000,0000,0000,,Кейтаның айтуы бойынша, Фудзи Асагами оған не істелсе де, қорықпаған.
Dialogue: 0,0:24:19.30,0:24:23.03,JPsub,NTP,0000,0000,0000,,Егер солай болса, онда оның жұмбақ ауру сезімі болуы мүмкін.
Dialogue: 0,0:24:23.52,0:24:25.27,JPsub,NTP,0000,0000,0000,,Егер бұл анальгезия болса, онда
Dialogue: 0,0:24:25.44,0:24:30.13,JPsub,NTP,0000,0000,0000,,Оның өзгеруіне себеп болған нәрсе болды ма?
Dialogue: 0,0:24:30.31,0:24:32.37,JPsub,NTP,0000,0000,0000,,Арқасынан ұрып, мойнына көп мөлшерде бүйрек үсті безі гормонын енгізген.
Dialogue: 0,0:24:32.37,0:24:35.76,JPsub,NTP,0000,0000,0000,,Мойынға көп мөлшерде бүйрек үсті безінің гормоны енгізілді.
Dialogue: 0,0:24:36.48,0:24:37.64,JPsub,NTP,0000,0000,0000,,Артқа
Dialogue: 0,0:24:39.12,0:24:43.29,JPsub,NTP,0000,0000,0000,,Жарақатының дәрежесін білмеймін, бірақ мен оның бір рет арқасынан ұрғанын естідім.
Dialogue: 0,0:24:45.07,0:24:53.09,JPsub,NTP,0000,0000,0000,,Хаха, менің ойымша, олардың толық күші Фуджино Асагамидің анальгезиясын уақытша емдеді.
Dialogue: 0,0:24:53.47,0:24:57.99,JPsub,NTP,0000,0000,0000,,Ол алғаш рет бастан өткерген ауыру сезімі, бәлкім, оның өлтіретін импульстарының бірі болса керек.
Dialogue: 0,0:24:58.16,0:25:00.29,JPsub,NTP,0000,0000,0000,,Сізде ауырсыну бар ма?
Dialogue: 0,0:25:00.46,0:25:01.19,JPsub,NTP,0000,0000,0000,,Ал сосын!
Dialogue: 0,0:25:01.55,0:25:06.44,JPsub,NTP,0000,0000,0000,,Сезімсіздігің, ештеңе ала алмайтыныңды білдіреді.Куротоу
Dialogue: 0,0:25:08.24,0:25:12.18,JPsub,NTP,0000,0000,0000,,Иә, дөрекі түрде айтсақ, денесі жоқ сияқты.
Dialogue: 0,0:25:12.36,0:25:15.13,JPsub,NTP,0000,0000,0000,,Тіпті шынайы сезімге ие болу қиын болуы керек.
Dialogue: 0,0:25:16.01,0:25:18.39,JPsub,NTP,0000,0000,0000,,Ол ауруды осылай білді
Dialogue: 0,0:25:18.86,0:25:21.44,JPsub,NTP,0000,0000,0000,,Бұл көбірек ауырады деп ойлайсыз.
Dialogue: 0,0:25:22.74,0:25:24.01,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:25:24.74,0:25:28.99,JPsub,NTP,0000,0000,0000,,Сіз алған ауырсыну сезімі қалай кек алудың қоздырғышына айналуы мүмкін?
Dialogue: 0,0:25:29.25,0:25:33.60,JPsub,NTP,0000,0000,0000,,Сәлем, рәсімге сүйене отырып, ол анальгезияға қайта оралды деп ойлаймын.
Dialogue: 0,0:25:33.81,0:25:35.79,JPsub,NTP,0000,0000,0000,,Маған бұл маңызды емес.
Dialogue: 0,0:25:36.07,0:25:38.54,JPsub,NTP,0000,0000,0000,,Мен Фуджино Асагамиді кешіре алмаймын
Dialogue: 0,0:25:38.95,0:25:42.40,JPsub,NTP,0000,0000,0000,,Оның тағы да біреуді өлтіруі туралы ойлаудың өзі ішім ауырады.
Dialogue: 0,0:25:43.21,0:25:44.91,JPsub,NTP,0000,0000,0000,,Туыстық жек көрушілік?
Dialogue: 0,0:25:45.06,0:25:47.50,JPsub,NTP,0000,0000,0000,,Күтілгендей, мұндай қозғалыс тобыр емес.
Dialogue: 0,0:25:48.93,0:25:51.57,JPsub,NTP,0000,0000,0000,,Асагамидің өткеніне үңілейік
Dialogue: 0,0:25:54.71,0:25:57.13,JPsub,NTP,0000,0000,0000,,Оны зерттеу керек пе?
Dialogue: 0,0:25:59.38,0:26:03.02,JPsub,NTP,0000,0000,0000,,Немесе Фуджино Асагами жәй ғана құрбан болуы мүмкін.
Dialogue: 0,0:26:03.91,0:26:07.37,JPsub,NTP,0000,0000,0000,,Сұрақ: қайсысы бірінші келді?
Dialogue: 0,0:26:08.85,0:26:10.43,JPsub,NTP,0000,0000,0000,,Мен сәл алысқа барамын.
Dialogue: 0,0:26:11.09,0:26:13.28,JPsub,NTP,0000,0000,0000,,Бүгін де, ертең де қайта алмай қалуымыз мүмкін
Dialogue: 0,0:26:13.94,0:26:15.90,JPsub,NTP,0000,0000,0000,,Жарайды, алға.
Dialogue: 0,0:26:19.70,0:26:23.66,JPsub,NTP,0000,0000,0000,,Формула Мен сонда барамын, бірақ абайсызда ештеңе жасамаңыз.
Dialogue: 0,0:26:23.84,0:26:26.61,JPsub,NTP,0000,0000,0000,,Ақылға сыймайтын адам сенсің.
Dialogue: 0,0:26:27.25,0:26:30.62,JPsub,NTP,0000,0000,0000,,Мока өлмейінше емделмейтіні рас еді.
Dialogue: 0,0:26:34.68,0:26:36.09,JPsub,NTP,0000,0000,0000,,Қатты тырысыңыз
Dialogue: 0,0:26:51.51,0:26:53.26,JPsub,NTP,0000,0000,0000,,Иә, сен 20-нан бері келмедің.
Dialogue: 0,0:26:54.02,0:26:55.37,JPsub,NTP,0000,0000,0000,,Рецепт бойынша берілетін дәрілер
Dialogue: 0,0:27:45.49,0:27:47.60,JPsub,NTP,0000,0000,0000,,сол апат туралы.
Dialogue: 0,0:27:48.87,0:27:51.98,JPsub,NTP,0000,0000,0000,,Жүргізуші апатқа дейін қайтыс болған.
Dialogue: 0,0:27:53.68,0:27:55.39,JPsub,NTP,0000,0000,0000,,Иә? Бұл байланыс апаты ма?
Dialogue: 0,0:27:55.49,0:27:57.05,JPsub,NTP,0000,0000,0000,,Басың бұралса да
Dialogue: 0,0:27:58.74,0:28:02.36,JPsub,NTP,0000,0000,0000,,Жоқ, әрине, жолаушы болмаған соң.
Dialogue: 0,0:28:03.49,0:28:07.42,JPsub,NTP,0000,0000,0000,,Қаншалықты керемет детектив болсаңыз да, жұмыс істеп тұрған құлыпталған бөлмені шешу мүмкін емес.
Dialogue: 0,0:28:08.82,0:28:11.93,JPsub,NTP,0000,0000,0000,,Жоқ, осыны айтсаң жеткілікті.
Dialogue: 0,0:28:12.45,0:28:16.94,JPsub,NTP,0000,0000,0000,,Кешіріңіз, бірақ бұл үшін сізге алғыс айтамын, детектив Акими.
Dialogue: 0,0:28:17.41,0:28:18.17,JPsub,NTP,0000,0000,0000,,Дева
Dialogue: 0,0:28:20.15,0:28:22.64,JPsub,NTP,0000,0000,0000,,Формула Жетінші адам пайда болды.
Dialogue: 0,0:28:22.93,0:28:25.69,JPsub,NTP,0000,0000,0000,,Бұл жолы ешқандай қатысы жоқ кісі өлтіру шығар.
Dialogue: 0,0:28:27.13,0:28:30.40,JPsub,NTP,0000,0000,0000,,А, Кейта Минато да таңғы құрбанның кім екенін білмейтін сияқты.
Dialogue: 0,0:28:31.19,0:28:33.82,JPsub,NTP,0000,0000,0000,,Сонда мен бұдан былай күте алмаймын.
Dialogue: 0,0:28:41.15,0:28:41.92,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:28:46.49,0:28:49.80,JPsub,NTP,0000,0000,0000,,Бұл клиент маған арнап жасаған карта кілті.
Dialogue: 0,0:28:50.31,0:28:54.06,JPsub,NTP,0000,0000,0000,,Дегенмен есімді ескі танысымнан алғанмын.
Dialogue: 0,0:28:55.04,0:28:59.26,JPsub,NTP,0000,0000,0000,,Фуджино Асагами, менің ойымша, сіз олардың біреуі сияқты нәрсені шығардыңыз.
Dialogue: 0,0:29:01.13,0:29:04.96,JPsub,NTP,0000,0000,0000,,Бұл қиыншылық, сондықтан оны Курогири қайтып келмей тұрып жасаңыз.
Dialogue: 0,0:29:17.33,0:29:19.63,JPsub,NTP,0000,0000,0000,,Куротоу уақытында жетпеді ме?
Dialogue: 0,0:29:20.31,0:29:25.66,JPsub,NTP,0000,0000,0000,,Енді алдымен дауыл соғады ма, әлде алдымен дауыл бола ма?
Dialogue: 0,0:29:27.12,0:29:31.56,JPsub,NTP,0000,0000,0000,,Жалғыз жасасаңыз, кек алуыңыз мүмкін. Риоги.
Dialogue: 0,0:30:20.93,0:30:23.13,JPsub,NTP,0000,0000,0000,,Не болды, Фуджино-чан?
Dialogue: 0,0:30:23.78,0:30:29.19,JPsub,NTP,0000,0000,0000,,Мен орамалымды ұмытып қалдым. Алдымен кері қайтыңыз.
Dialogue: 0,0:30:29.27,0:30:31.15,JPsub,NTP,0000,0000,0000,,Иә, кездескенше.
Dialogue: 0,0:30:40.45,0:30:41.35,JPsub,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:30:47.99,0:30:48.98,JPsub,NTP,0000,0000,0000,,Көрейін
Dialogue: 0,0:30:52.46,0:30:56.79,JPsub,NTP,0000,0000,0000,,Мен ауырсынуды сезе алмайтынымды ешкімге түсіндірмедім.
Dialogue: 0,0:30:57.33,0:31:02.41,JPsub,NTP,0000,0000,0000,,Егер мен Фудзиноны кәдімгі адам деп ойламасам, мен міндетті түрде жойыламын.
Dialogue: 0,0:31:03.28,0:31:04.87,JPsub,NTP,0000,0000,0000,,Сен ақымақсың.
Dialogue: 0,0:31:05.57,0:31:10.86,JPsub,NTP,0000,0000,0000,,Тыңдаңыз, жара шыдайтын нәрсе емес, ауырсыну - шағымданатын нәрсе.
Dialogue: 0,0:31:11.50,0:31:15.72,JPsub,NTP,0000,0000,0000,,Ал, Асагами Фуджино-чан
Dialogue: 0,0:31:18.78,0:31:21.21,JPsub,NTP,0000,0000,0000,,Жарайды, ауырса хабарлаңыз.
Dialogue: 0,0:31:21.76,0:31:24.82,JPsub,NTP,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:31:26.32,0:31:29.00,JPsub,NTP,0000,0000,0000,,Ойланып қарасаң, сол күннен
Dialogue: 0,0:31:36.04,0:31:39.46,JPsub,NTP,0000,0000,0000,,Сенпай I...
Dialogue: 0,0:31:48.53,0:31:51.88,JPsub,NTP,0000,0000,0000,,Бұл өте жылдам, бар болғаны бір күн болды.
Dialogue: 0,0:31:52.18,0:31:56.57,JPsub,NTP,0000,0000,0000,,Тайфун келе жатыр еді, мен үйге көлік тоқтап қалғанша жеттім.
Dialogue: 0,0:31:57.44,0:31:58.47,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:32:02.41,0:32:05.78,JPsub,NTP,0000,0000,0000,,Оның орнына, Туко-сан, мен Фуджино Асагами туралы айтқым келеді.
Dialogue: 0,0:32:05.96,0:32:07.82,JPsub,NTP,0000,0000,0000,,Әлі де анальгетик
Dialogue: 0,0:32:08.12,0:32:11.12,JPsub,NTP,0000,0000,0000,,Дегенмен, менде бастапқыда қалыпты конституция болды.
Dialogue: 0,0:32:11.72,0:32:12.88,JPsub,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:32:16.76,0:32:20.27,JPsub,NTP,0000,0000,0000,,Асагамидегі жас ханым сәл біртүрлі екен.
Dialogue: 0,0:32:20.72,0:32:24.10,JPsub,NTP,0000,0000,0000,,Мен заттарды ұстамай-ақ майыстыратын болдым.
Dialogue: 0,0:32:24.63,0:32:29.62,JPsub,NTP,0000,0000,0000,,Бұған ауыл адамдары ызаланып, қатты қорлық көрген сияқты.
Dialogue: 0,0:32:30.57,0:32:35.97,JPsub,NTP,0000,0000,0000,,Күйеуім бұған мән бермей, мені емделуге шақырды.
Dialogue: 0,0:32:36.25,0:32:39.04,JPsub,NTP,0000,0000,0000,,Ал, мен не істеп жатырмын?
Dialogue: 0,0:32:39.29,0:32:42.87,JPsub,NTP,0000,0000,0000,,Мен күйеуім сұраған дәріні бердім.
Dialogue: 0,0:32:43.29,0:32:46.15,JPsub,NTP,0000,0000,0000,,Ем оны ауыртпалықсыз етті.
Dialogue: 0,0:32:46.89,0:32:50.35,JPsub,NTP,0000,0000,0000,,Анальгезия туралы не деуге болады?
Dialogue: 0,0:32:50.71,0:32:57.86,JPsub,NTP,0000,0000,0000,,Ең алғаш кездескенде жығылсам жылап, қан кетсем жылап, үлкен шу шығаратынмын.
Dialogue: 0,0:32:58.99,0:33:02.05,JPsub,NTP,0000,0000,0000,,Туа біткен де, жүре пайда болған да емес
Dialogue: 0,0:33:02.81,0:33:05.17,JPsub,NTP,0000,0000,0000,,Мен мұндай анальгезияны естімеппін.
Dialogue: 0,0:33:05.51,0:33:09.12,JPsub,NTP,0000,0000,0000,,Жоқ, оны анальгезия деп атаудың өзі дұрыс емес.
Dialogue: 0,0:33:09.47,0:33:12.87,JPsub,NTP,0000,0000,0000,,Фуджино Асагами жасанды түрде жансыздандырылды.
Dialogue: 0,0:33:13.05,0:33:15.46,JPsub,NTP,0000,0000,0000,,Бұл толық формулаға қарама-қарсы.
Dialogue: 0,0:33:19.66,0:33:23.57,JPsub,NTP,0000,0000,0000,,Фуджиноның әкесі оның сезімін жабу арқылы оның қабілеттерін бекітуді ұйғарды.
Dialogue: 0,0:33:23.98,0:33:29.11,JPsub,NTP,0000,0000,0000,,Ол өзінің қабілеттерін көрсетуге тырысқан Рёгиге мүлдем қарама-қайшы келетін таза қанды адам.
Dialogue: 0,0:33:29.43,0:33:34.88,JPsub,NTP,0000,0000,0000,,Бірақ өкінішке орай, осыған байланысты Фудзиноның қабілеті күшейе түсті.
Dialogue: 0,0:33:35.37,0:33:38.26,JPsub,NTP,0000,0000,0000,,Таяз құдайдың қаны мен екіұштылықтың қаны
Dialogue: 0,0:33:39.90,0:33:41.38,JPsub,NTP,0000,0000,0000,,Тооко-сан формуласы
Dialogue: 0,0:33:42.51,0:33:45.23,JPsub,NTP,0000,0000,0000,,Ол әлдеқашан кетіп қалды.
Dialogue: 0,0:33:52.20,0:33:54.63,JPsub,NTP,0000,0000,0000,,Туко мырза, ол қалпына келе ме?
Dialogue: 0,0:33:59.09,0:34:03.11,JPsub,NTP,0000,0000,0000,,Оның жарасы жазылмайды, тек ауырады.
Dialogue: 0,0:34:04.08,0:34:08.11,JPsub,NTP,0000,0000,0000,,Сондықтан ол біріншіден зардап шеккен жоқ.
Dialogue: 0,0:34:08.67,0:34:13.80,JPsub,NTP,0000,0000,0000,,Ойланыңыз: Егер сіздің ішіңізге пышақ сұғып кетсе, жара өздігінен жазылар ма еді?
Dialogue: 0,0:34:14.24,0:34:16.07,JPsub,NTP,0000,0000,0000,,Бұл да бір-екі күн.
Dialogue: 0,0:34:18.90,0:34:22.44,JPsub,NTP,0000,0000,0000,,Бәрі болмашы түсініспеушіліктен басталды, Курогири.
Dialogue: 0,0:34:22.60,0:34:23.80,JPsub,NTP,0000,0000,0000,,Түсінбеу
Dialogue: 0,0:34:24.50,0:34:28.01,JPsub,NTP,0000,0000,0000,,Сол кезде Фуджино өзін пышақтайды деп ойлады.
Dialogue: 0,0:34:28.27,0:34:31.72,JPsub,NTP,0000,0000,0000,,Жоқ, пышақтап кете жаздады.
Dialogue: 0,0:34:33.90,0:34:38.68,JPsub,NTP,0000,0000,0000,,Бұл кезде оның ауыру сезімі қайта оралған болатын.
Dialogue: 0,0:34:42.44,0:34:46.24,JPsub,NTP,0000,0000,0000,,Кесу немесе бұрау, Фуджино бірінші болды.
Dialogue: 0,0:34:48.61,0:34:52.92,JPsub,NTP,0000,0000,0000,,Фуджино ішін пышақтап кетті деп ойласа керек.
Dialogue: 0,0:34:54.22,0:34:55.52,JPsub,NTP,0000,0000,0000,,Бұл біртүрлі
Dialogue: 0,0:34:55.79,0:34:59.00,JPsub,NTP,0000,0000,0000,,Егер менің ауырсыну сезімім қайта оралса, мен ондай қателік жасамас едім.
Dialogue: 0,0:34:59.15,0:35:00.64,JPsub,NTP,0000,0000,0000,,Шаспаса, ауырмайды.
Dialogue: 0,0:35:01.20,0:35:04.18,JPsub,NTP,0000,0000,0000,,Фуджино басынан бастап ауырды.
Dialogue: 0,0:35:22.74,0:35:25.18,JPsub,NTP,0000,0000,0000,,Мен сені кездестірдім, Асагами.
Dialogue: 0,0:35:26.24,0:35:28.96,JPsub,NTP,0000,0000,0000,,Риоги рәсімі
Dialogue: 0,0:35:30.24,0:35:32.92,JPsub,NTP,0000,0000,0000,,Қанның дәмін татқан хайуансың.
Dialogue: 0,0:35:33.27,0:35:35.02,JPsub,NTP,0000,0000,0000,,Адамдарды өлтіргенді ұнатады
Dialogue: 0,0:35:35.78,0:35:37.43,JPsub,NTP,0000,0000,0000,,Бұл сіз болуыңыз керек.
Dialogue: 0,0:35:38.47,0:35:40.97,JPsub,NTP,0000,0000,0000,,Мен көңілді емеспін
Dialogue: 0,0:35:41.89,0:35:45.71,JPsub,NTP,0000,0000,0000,,Бұл елде «Үшінші рет адалдық» деген сөз бар.
Dialogue: 0,0:35:47.20,0:35:49.95,JPsub,NTP,0000,0000,0000,,Қазір сен болсаң, мен сені өлтірер едім.
Dialogue: 0,0:36:09.14,0:36:14.33,JPsub,NTP,0000,0000,0000,,Сіз одан құтыла алмайсыз.
Dialogue: 0,0:36:36.29,0:36:39.26,JPsub,NTP,0000,0000,0000,,Қандай ақымақ адам!
Dialogue: 0,0:36:40.59,0:36:45.64,JPsub,NTP,0000,0000,0000,,Бірақ мен күштімін
Dialogue: 0,0:36:47.32,0:36:49.61,JPsub,NTP,0000,0000,0000,,Мен мұны Фудзиноның қазіргі дәрігерінен білдім.
Dialogue: 0,0:36:50.08,0:36:52.06,JPsub,NTP,0000,0000,0000,,Созылмалы аппендицитпен ауырады
Dialogue: 0,0:36:52.21,0:36:53.92,JPsub,NTP,0000,0000,0000,,Бұл әдетте аппендицит деп аталады.
Dialogue: 0,0:36:54.50,0:36:58.19,JPsub,NTP,0000,0000,0000,,Сол баланың ішінің ауыруы пышақ ауыруы емес еді.
Dialogue: 0,0:36:58.42,0:37:00.09,JPsub,NTP,0000,0000,0000,,Бұл ішкі ауырсыну.
Dialogue: 0,0:37:00.68,0:37:02.61,JPsub,NTP,0000,0000,0000,,Бұл түсінбеушілік пе?
Dialogue: 0,0:37:03.09,0:37:06.91,JPsub,NTP,0000,0000,0000,,Бұл жараның бір түрі, бірақ факт сақталады.
Dialogue: 0,0:37:07.22,0:37:12.25,JPsub,NTP,0000,0000,0000,,Пышақ па, пышақ жоқ па, оның оларды өлтіруден басқа амалы қалмады.
Dialogue: 0,0:37:12.87,0:37:14.88,JPsub,NTP,0000,0000,0000,,Өлтіріңіз немесе өлтіріңіз
Dialogue: 0,0:37:14.98,0:37:16.69,JPsub,NTP,0000,0000,0000,,Дене емес, ақыл
Dialogue: 0,0:37:17.30,0:37:21.57,JPsub,NTP,0000,0000,0000,,Алайда Кейта Минато өкінішке орай қашып кетті.
Dialogue: 0,0:37:22.04,0:37:26.19,JPsub,NTP,0000,0000,0000,,Егер кек сол жерде болса, мұнша дейін жетпес еді.
Dialogue: 0,0:37:27.56,0:37:32.29,JPsub,NTP,0000,0000,0000,,Немесе сол күні Сенька екеуміздің арамыздағы уәдені орындасаңдаршы.
Dialogue: 0,0:37:32.73,0:37:37.53,JPsub,NTP,0000,0000,0000,,Формула дұрыс. Қалай болғанда да, Фуджино Асагами үшін кеш.
Dialogue: 0,0:37:38.89,0:37:41.02,JPsub,NTP,0000,0000,0000,,Неліктен кеш?
Dialogue: 0,0:37:42.76,0:37:45.55,JPsub,NTP,0000,0000,0000,,Формула айтып отырған нәрсе ақылға қонымды нәрсе болса керек.
Dialogue: 0,0:37:45.77,0:37:48.86,JPsub,NTP,0000,0000,0000,,Фуджиноны өлтіру бес адамға дейін болса, кісі өлтіру болып табылады.
Dialogue: 0,0:37:48.95,0:37:51.58,JPsub,NTP,0000,0000,0000,,Кез келген басқа әрекет адам өлтіру емес, кісі өлтіру болып табылады.
Dialogue: 0,0:37:51.80,0:37:55.07,JPsub,NTP,0000,0000,0000,,Шики мұның жөнді себебі жоқ деп ашуланды.
Dialogue: 0,0:37:58.02,0:38:01.93,JPsub,NTP,0000,0000,0000,,Сіз кезек алдыңыз, Шики мырза.
Dialogue: 0,0:38:02.84,0:38:05.77,JPsub,NTP,0000,0000,0000,,Бірақ егер сіз оны көре алмасаңыз
Dialogue: 0,0:38:15.06,0:38:17.12,JPsub,NTP,0000,0000,0000,,Сен сондай бейберекетсің.
Dialogue: 0,0:38:41.28,0:38:43.23,JPsub,NTP,0000,0000,0000,,Жоғалып кетті!
Dialogue: 0,0:38:46.68,0:38:52.06,JPsub,NTP,0000,0000,0000,,Адамның қолы қандай жаншылады!
Dialogue: 0,0:38:52.88,0:38:54.86,JPsub,NTP,0000,0000,0000,,Неге тоқтамайсың?
Dialogue: 0,0:39:02.56,0:39:05.28,JPsub,NTP,0000,0000,0000,,Қазіргісі нашар.
Dialogue: 0,0:39:09.69,0:39:16.63,JPsub,NTP,0000,0000,0000,,Ол кісі өлтіруге тәуелді болса да, ол өлімнің қаншалықты маңызды екенін бейсаналық түрде сезінеді.
Dialogue: 0,0:39:17.42,0:39:21.06,JPsub,NTP,0000,0000,0000,,Сондықтан мен Фуджино Асагами сияқты бейтаныс кісі өлтірмеймін.
Dialogue: 0,0:39:21.74,0:39:26.12,JPsub,NTP,0000,0000,0000,,Шикидің көзқарасы бойынша, ол Фудзиноны қалағанын істегені үшін кешіре алмайды деп ойлаймын.
Dialogue: 0,0:39:27.14,0:39:30.17,JPsub,NTP,0000,0000,0000,,Бірақ мен тым кеш десем, мен физикалық аспекті туралы айтып отырмын.
Dialogue: 0,0:39:30.40,0:39:33.46,JPsub,NTP,0000,0000,0000,,Аппендицит емделмесе, ол тесіліп, перитонитке айналады.
Dialogue: 0,0:39:33.86,0:39:38.23,JPsub,NTP,0000,0000,0000,,Бұдан былай он екі елі ішекке барсаң, жарты күннің ішінде өлесің.
Dialogue: 0,0:39:39.14,0:39:40.97,JPsub,NTP,0000,0000,0000,,20-нан бүгінге дейінгі бес күн
Dialogue: 0,0:39:41.30,0:39:43.14,JPsub,NTP,0000,0000,0000,,Тесік әлдеқашан бұрғыланған болуы керек.
Dialogue: 0,0:39:43.74,0:39:46.78,JPsub,NTP,0000,0000,0000,,Кешіріңіз, бірақ бұл өлімге әкелетіні сөзсіз.
Dialogue: 0,0:39:47.52,0:39:51.51,JPsub,NTP,0000,0000,0000,,Әлі де кеш емес. Біз Фудзино Асагамиді асығыс қорғауымыз керек.
Dialogue: 0,0:39:51.52,0:39:54.73,JPsub,NTP,0000,0000,0000,,Бұл жолғы клиент Фуджино Асагамидің әкесі.
Dialogue: 0,0:39:55.18,0:39:58.26,JPsub,NTP,0000,0000,0000,,Ол Фудзиноның қабілетін жас кезінде білген болуы керек.
Dialogue: 0,0:39:58.61,0:40:02.69,JPsub,NTP,0000,0000,0000,,Оқиғаның трагедиясы туралы естігенде, бұл Фуджиноның ісі екенін түсіндім.
Dialogue: 0,0:40:02.75,0:40:04.95,JPsub,NTP,0000,0000,0000,,Мен саған анау құбыжықты өлтір деп айттым.
Dialogue: 0,0:40:05.20,0:40:09.30,JPsub,NTP,0000,0000,0000,,Оны қорғай алатын жалғыз әкесі оның өлгенін қалайды.
Dialogue: 0,0:40:09.71,0:40:12.29,JPsub,NTP,0000,0000,0000,,Ол сөздің барлық мағынасында дәрменсіз.
Dialogue: 0,0:40:14.09,0:40:16.05,JPsub,NTP,0000,0000,0000,,Сен ақымақ
Dialogue: 0,0:40:26.91,0:40:31.08,JPsub,NTP,0000,0000,0000,,Жарайды, Асагами, сен ең жақсысың.
Dialogue: 0,0:40:34.61,0:40:38.25,JPsub,NTP,0000,0000,0000,,Уақытты босқа кетіретінін білемін, бірақ
Dialogue: 0,0:40:39.60,0:40:44.52,JPsub,NTP,0000,0000,0000,,Кеттік. Мен сіздің сиқырлы амалыңыздың тұқымын көріп тұрмын.
Dialogue: 0,0:40:51.31,0:40:55.00,JPsub,NTP,0000,0000,0000,,Сіз ақылсыз болуыңыз керек.
Dialogue: 0,0:41:00.32,0:41:01.29,JPsub,NTP,0000,0000,0000,,Иілу
Dialogue: 0,0:41:11.10,0:41:13.85,JPsub,NTP,0000,0000,0000,,Пішіні жоқ заттарды көру қиын.
Dialogue: 0,0:41:14.50,0:41:16.55,JPsub,NTP,0000,0000,0000,,Сіз тым көп атып жатырсыз.
Dialogue: 0,0:41:18.13,0:41:20.39,JPsub,NTP,0000,0000,0000,,Сіздердің арқаларыңызда мен оны көре алдым.
Dialogue: 0,0:41:21.02,0:41:24.57,JPsub,NTP,0000,0000,0000,,Сіздің күшіңіз жасыл және қызыл спираль.
Dialogue: 0,0:41:25.42,0:41:28.49,JPsub,NTP,0000,0000,0000,,Бұл өте әдемі.
Dialogue: 0,0:41:29.34,0:41:31.61,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:41:32.29,0:41:34.52,JPsub,NTP,0000,0000,0000,,Әр нәрсенің сәтсіздіктері болады.
Dialogue: 0,0:41:35.10,0:41:36.84,JPsub,NTP,0000,0000,0000,,Адамды сөзбен айтып жеткізу мүмкін емес.
Dialogue: 0,0:41:37.07,0:41:40.62,JPsub,NTP,0000,0000,0000,,Атмосферада, ерік-жігерде, тіпті уақытында.
Dialogue: 0,0:41:41.07,0:41:44.10,JPsub,NTP,0000,0000,0000,,Менің көзім заттардың өлімін көреді.
Dialogue: 0,0:41:44.48,0:41:46.94,JPsub,NTP,0000,0000,0000,,Сіз сияқты арнайы жасалған.
Dialogue: 0,0:41:48.00,0:41:48.92,JPsub,NTP,0000,0000,0000,,иілу
Dialogue: 0,0:41:49.45,0:41:56.06,JPsub,NTP,0000,0000,0000,,Егер сен әлі тірі болсаң, мен тіпті Құдайды да өлтіремін.
Dialogue: 0,0:41:56.40,0:41:58.25,JPsub,NTP,0000,0000,0000,,Иілу
Dialogue: 0,0:41:58.48,0:42:05.76,JPsub,NTP,0000,0000,0000,,Бұрыл, бұрыл, бұрыл
Dialogue: 0,0:42:15.10,0:42:18.10,JPsub,NTP,0000,0000,0000,,Мені өлтір
Dialogue: 0,0:42:19.22,0:42:20.69,JPsub,NTP,0000,0000,0000,,Неліктен өлтіру керек?
Dialogue: 0,0:42:20.86,0:42:24.14,JPsub,NTP,0000,0000,0000,,Мен оны жарасы ауырғандықтан ғана өлтірдім.
Dialogue: 0,0:42:24.57,0:42:26.37,JPsub,NTP,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:42:26.71,0:42:29.92,JPsub,NTP,0000,0000,0000,,Онда неге күлесің?
Dialogue: 0,0:42:32.34,0:42:34.66,JPsub,NTP,0000,0000,0000,,Содан кейін және қазір
Dialogue: 0,0:42:35.64,0:42:38.42,JPsub,NTP,0000,0000,0000,,Неге сонша бақытты көрінесің?
Dialogue: 0,0:42:39.05,0:42:40.88,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:42:41.02,0:42:43.51,JPsub,NTP,0000,0000,0000,,Сіз көңілді жүрсіз
Dialogue: 0,0:42:43.96,0:42:46.93,JPsub,NTP,0000,0000,0000,,Мен адамдарды ренжіткенді жақсы көремін.
Dialogue: 0,0:42:47.26,0:42:49.59,JPsub,NTP,0000,0000,0000,,Сондықтан ауру ешқашан кетпейді
Dialogue: 0,0:42:50.25,0:42:52.87,JPsub,NTP,0000,0000,0000,,Бұл жауап
Dialogue: 0,0:42:53.50,0:42:57.94,JPsub,NTP,0000,0000,0000,,Мен саған айттым ғой, сен екеуміз ұқсаспыз.
Dialogue: 0,0:43:03.15,0:43:08.89,JPsub,NTP,0000,0000,0000,,Иілу!
Dialogue: 0,0:44:08.62,0:44:09.59,JPsub,NTP,0000,0000,0000,,Мен қашуым керек
Dialogue: 0,0:44:10.44,0:44:12.85,JPsub,NTP,0000,0000,0000,,Бұл да бұзылады
Dialogue: 0,0:44:40.65,0:44:44.33,JPsub,NTP,0000,0000,0000,,Менің әлі өлгім келмейді
Dialogue: 0,0:44:45.39,0:44:52.73,JPsub,NTP,0000,0000,0000,,Ол ауырады, ауырады, ауырады
Dialogue: 0,0:44:55.02,0:44:59.27,JPsub,NTP,0000,0000,0000,,Мен ұзақ өмір сүргім келеді
Dialogue: 0,0:45:00.89,0:45:05.80,JPsub,NTP,0000,0000,0000,,Мен көбірек сөйлескім келеді
Dialogue: 0,0:45:07.74,0:45:12.40,JPsub,NTP,0000,0000,0000,,Мен көбірек ойлағым келеді
Dialogue: 0,0:45:14.27,0:45:21.14,JPsub,NTP,0000,0000,0000,,Мен осында көбірек қалғым келеді.
Dialogue: 0,0:45:29.87,0:45:35.57,JPsub,NTP,0000,0000,0000,,Итай ауырады, Сенпай.
Dialogue: 0,0:45:36.38,0:45:46.08,JPsub,NTP,0000,0000,0000,,Ауырғаны сонша, сыздап жыладым.
Dialogue: 0,0:45:47.64,0:45:53.36,JPsub,NTP,0000,0000,0000,,Фуджино, жылауға бола ма?
Dialogue: 0,0:46:03.36,0:46:04.24,JPsub,NTP,0000,0000,0000,,Бұл ауырады ма?
Dialogue: 0,0:46:08.67,0:46:09.83,JPsub,NTP,0000,0000,0000,,Ауырса
Dialogue: 0,0:46:10.70,0:46:14.58,JPsub,NTP,0000,0000,0000,,Ауырса, ауырады деп айту керек еді.
Dialogue: 0,0:46:15.04,0:46:15.80,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:46:47.34,0:46:48.20,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:46:50.11,0:46:53.43,JPsub,NTP,0000,0000,0000,,Мен сенің сонда екеніңді білдім.
Dialogue: 0,0:46:54.12,0:46:55.84,JPsub,NTP,0000,0000,0000,,Формула Жарақат
Dialogue: 0,0:46:57.21,0:46:59.29,JPsub,NTP,0000,0000,0000,,Сіз оны бір қолмен жасадыңыз ба?
Dialogue: 0,0:46:59.57,0:47:02.99,JPsub,NTP,0000,0000,0000,,Тоуко: Ол тіпті ақырында көріпкелді дамытты.
Dialogue: 0,0:47:02.99,0:47:04.57,JPsub,NTP,0000,0000,0000,,Көпірді қирату оңай болды
Dialogue: 0,0:47:05.11,0:47:07.49,JPsub,NTP,0000,0000,0000,,Егер сіз оны жалғыз қалдырсаңыз, сіз керемет талантты боласыз.
Dialogue: 0,0:47:07.54,0:47:10.77,JPsub,NTP,0000,0000,0000,,Көріпкелдік «көріпкелдік»?
Dialogue: 0,0:47:11.13,0:47:15.10,JPsub,NTP,0000,0000,0000,,Оның қабілетіне көріпкелдік қоссаңыз, жеңілмейтіні рас.
Dialogue: 0,0:47:15.43,0:47:18.10,JPsub,NTP,0000,0000,0000,,Айналу осі нысандардың артына жасырылған кезде де жасалады.
Dialogue: 0,0:47:18.42,0:47:20.97,JPsub,NTP,0000,0000,0000,,Мені жалғыз қалдырсаң
Dialogue: 0,0:47:21.25,0:47:24.54,JPsub,NTP,0000,0000,0000,,Ақыры анальгезияға оралды.
Dialogue: 0,0:47:24.81,0:47:25.93,JPsub,NTP,0000,0000,0000,,Ол лас.
Dialogue: 0,0:47:26.25,0:47:28.92,JPsub,NTP,0000,0000,0000,,Мұндай Фуджино Асагами нысана емес.
Dialogue: 0,0:47:29.78,0:47:33.05,JPsub,NTP,0000,0000,0000,,Бақтағы ауруды өлтіруден басқа амалым қалмады.
Dialogue: 0,0:47:33.41,0:47:35.66,JPsub,NTP,0000,0000,0000,,Егер сіз асығыс болсаңыз, сізді әлі де құтқаруыңыз мүмкін.
Dialogue: 0,0:47:36.34,0:47:40.03,JPsub,NTP,0000,0000,0000,,Әй, сол қолым жарамсыз болғандықтан өлтірдім.
Dialogue: 0,0:47:40.43,0:47:42.95,JPsub,NTP,0000,0000,0000,,Тоуко: Сіз протездік қол жасай аласыз.
Dialogue: 0,0:47:43.55,0:47:46.63,JPsub,NTP,0000,0000,0000,,Жарайды, бұл жолғы сый.
Dialogue: 0,0:47:47.11,0:47:52.39,JPsub,NTP,0000,0000,0000,,Тікелей өлімнің көзі болса да, мен әрқашан сіздің сыртқы түріңіз тым қарапайым деп ойладым.
Dialogue: 0,0:47:52.64,0:47:56.68,JPsub,NTP,0000,0000,0000,,Сол қолыңызбен ең болмағанда рухты ұстай алатыныңызға көз жеткізіңіз.
Dialogue: 0,0:47:58.03,0:47:59.79,JPsub,NTP,0000,0000,0000,,Цуки… Цуки…
Dialogue: 0,0:48:00.85,0:48:02.33,JPsub,NTP,0000,0000,0000,,Жедел жәрдем келе жатыр.
Dialogue: 0,0:48:03.20,0:48:05.16,JPsub,NTP,0000,0000,0000,,Ал, кеттік.
Dialogue: 0,0:48:05.30,0:48:07.39,JPsub,NTP,0000,0000,0000,,Мұнда болу өте қиын.
Dialogue: 0,0:48:08.07,0:48:10.72,JPsub,NTP,0000,0000,0000,,Маған хабарласпас бұрын, мен соңына дейін қаламын.
Dialogue: 0,0:48:11.17,0:48:14.33,JPsub,NTP,0000,0000,0000,,Мен нәтижелерді хабарлаймын, сен үйге бара аласың, Туко-сан.
Dialogue: 0,0:48:14.44,0:48:17.23,JPsub,NTP,0000,0000,0000,,Түсіндім, жарайды, үйге қайтайық.
Dialogue: 0,0:48:17.60,0:48:18.71,JPsub,NTP,0000,0000,0000,,Бас тарту
Dialogue: 0,0:48:26.01,0:48:31.04,JPsub,NTP,0000,0000,0000,,Формула: Фуджино Асагамиді өлтіре алмағаныңыз үшін, Курогириді өлтірмеңіз.
Dialogue: 0,0:48:42.44,0:48:46.31,JPsub,NTP,0000,0000,0000,,Өрнек Мен Асагами Фудзиноны әлі де кешіре алмаймын
Dialogue: 0,0:48:48.56,0:48:51.64,JPsub,NTP,0000,0000,0000,,Мен бір рет өлтірген жігітке қызықпаймын.
Dialogue: 0,0:48:52.51,0:48:53.89,JPsub,NTP,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:48:54.44,0:48:58.18,JPsub,NTP,0000,0000,0000,,Қандай себеп болса да, біреуді өлтіру дұрыс емес.
Dialogue: 0,0:48:58.60,0:49:02.42,JPsub,NTP,0000,0000,0000,,Иә, бірақ мен оны аяймын.
Dialogue: 0,0:49:03.20,0:49:08.31,JPsub,NTP,0000,0000,0000,,Шынымды айтсам, мен оған шабуыл жасаған балалардың нәтижесіне ешқандай эмоция сезінбеймін.
Dialogue: 0,0:49:08.63,0:49:12.72,JPsub,NTP,0000,0000,0000,,Бұл таңқаларлық. Мен сіздің жалпы пікіріңізді күттім.
Dialogue: 0,0:49:12.78,0:49:13.41,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:49:13.80,0:49:14.82,JPsub,NTP,0000,0000,0000,,Бірақ формула
Dialogue: 0,0:49:15.36,0:49:19.80,JPsub,NTP,0000,0000,0000,,Мен өзімді жоғалтып алдым. Фуджино Асагами - ақылды, қарапайым бала.
Dialogue: 0,0:49:20.33,0:49:23.80,JPsub,NTP,0000,0000,0000,,Жасаған ісін бүркемелей алмай қабылдайды.
Dialogue: 0,0:49:24.30,0:49:27.75,JPsub,NTP,0000,0000,0000,,Жүрегімдегі жара көгеріп, ауыра береді.
Dialogue: 0,0:49:28.40,0:49:32.64,JPsub,NTP,0000,0000,0000,,Сол баланың дерті қалғандай, жазылмайды.
Dialogue: 0,0:49:33.45,0:49:35.01,JPsub,NTP,0000,0000,0000,,Бұл мен үшін ауыр
Dialogue: 0,0:49:35.47,0:49:37.14,JPsub,NTP,0000,0000,0000,,Бұл ақкөңіл адам
Dialogue: 0,0:49:37.69,0:49:38.48,JPsub,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:49:40.27,0:49:44.23,JPsub,NTP,0000,0000,0000,,Бірақ менде парасаттылық салтанаты жоқ.
Dialogue: 0,0:49:45.11,0:49:47.97,JPsub,NTP,0000,0000,0000,,Ондай адамды еркіндікке жіберуге бола ма?
Dialogue: 0,0:49:48.87,0:49:51.84,JPsub,NTP,0000,0000,0000,,Түсіндім, көмектесу мүмкін емес.
Dialogue: 0,0:49:52.04,0:49:55.09,JPsub,NTP,0000,0000,0000,,Мен оның орнына рәсімнің ауыртпалығын көтеремін.
Dialogue: 0,0:49:57.27,0:49:59.20,JPsub,NTP,0000,0000,0000,,Ақыры есіме түсті
Dialogue: 0,0:49:59.95,0:50:03.73,JPsub,NTP,0000,0000,0000,,Сіз әрқашан осындай әзілдерді тіке айтатынсыз.
Dialogue: 0,0:50:03.96,0:50:07.89,JPsub,NTP,0000,0000,0000,,Шынымды айтсам, мен мұндай формулаларға өте нашар болдым.
Dialogue: 0,0:50:09.11,0:50:14.75,JPsub,NTP,0000,0000,0000,,Түсіндім, ең болмағанда бір қызды қолға аламын деп ойлаймын.
Dialogue: 0,0:50:18.27,0:50:23.75,JPsub,NTP,0000,0000,0000,,Менің тағы бір мойындайтыным бар: бұған мен де кінәлімін деп ойлаймын.
Dialogue: 0,0:50:24.52,0:50:26.60,JPsub,NTP,0000,0000,0000,,Бірақ мен оның орнына бір нәрсені білдім.
Dialogue: 0,0:50:26.79,0:50:32.31,JPsub,NTP,0000,0000,0000,,Менің қалағаным өте анық емес және қауіпті.
Dialogue: 0,0:50:32.75,0:50:34.98,JPsub,NTP,0000,0000,0000,,Енді соған сүйенуден басқа амалым жоқ.
Dialogue: 0,0:50:35.56,0:50:40.04,JPsub,NTP,0000,0000,0000,,Менің жабысқаным мен ойлағандай жаман емес еді.
Dialogue: 0,0:50:40.35,0:50:42.31,JPsub,NTP,0000,0000,0000,,Мен бұған аздап қуаныштымын.
Dialogue: 0,0:50:42.70,0:50:48.68,JPsub,NTP,0000,0000,0000,,Кішкене ғана, сенен аздап өлтіретін импульс
Dialogue: 0,0:51:04.38,0:51:12.60,JPsub,NTP,0000,0000,0000,,Қазір ойлап қарасам, бұл оның оянғаннан кейін маған көрсеткен алғашқы шынайы күлкісі болды.
Dialogue: 0,0:56:39.44,0:56:41.06,JPsub,NTP,0000,0000,0000,,Тікелей өлімнің жаман көзі?
Dialogue: 0,0:56:41.40,0:56:44.23,JPsub,NTP,0000,0000,0000,,Оны жоғалту ысырап болар еді.
Dialogue: 0,0:56:44.24,0:56:45.91,JPsub,NTP,0000,0000,0000,,Бұл жерде өте әдемі
Dialogue: 0,0:56:47.50,0:56:49.36,JPsub,NTP,0000,0000,0000,,Мен сондай бақытты болсам да
Dialogue: 0,0:56:50.52,0:56:53.84,JPsub,NTP,0000,0000,0000,,Адамдар соншалықты жалғыз
Dialogue: 0,0:56:53.91,0:56:56.60,JPsub,NTP,0000,0000,0000,,Мені түсін
Dialogue: 0,0:56:57.63,0:57:01.78,JPsub,NTP,0000,0000,0000,,Орикун шынымен бекер өлді ме деп ойлаймын.
Dialogue: 0,0:57:03.80,0:57:05.99,JPsub,NTP,0000,0000,0000,,Мен әлсіздерді өлтіремін
Dialogue: 0,0:57:06.76,0:57:09.81,JPsub,NTP,0000,0000,0000,,Екеуіңе де ырым бермеймін.
Dialogue: 0,0:00:43.72,0:00:46.44,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:00:47.05,0:00:51.85,CNsub,NTP,0000,0000,0000,,Тоқта және төмен түс
Dialogue: 0,0:00:53.14,0:00:54.70,CNsub,NTP,0000,0000,0000,,Техникалық дағдылардың нашарлығы
Dialogue: 0,0:00:55.99,0:00:59.77,CNsub,NTP,0000,0000,0000,,Тірі тұмсық – бұл отбасының салқындығы
Dialogue: 0,0:01:01.52,0:01:06.46,CNsub,NTP,0000,0000,0000,,Әйелдің басқа ойыншығы
Dialogue: 0,0:01:06.52,0:01:09.90,CNsub,NTP,0000,0000,0000,,Бұл ойынның аз мөлшері.
Dialogue: 0,0:01:10.70,0:01:12.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:13.95,0:01:18.02,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта қызықты
Dialogue: 0,0:02:30.32,0:02:32.26,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:34.88,0:02:36.12,CNsub,NTP,0000,0000,0000,,Сюзи ауруы
Dialogue: 0,0:02:39.31,0:02:43.00,CNsub,NTP,0000,0000,0000,,Бір адам емес...Мен
Dialogue: 0,0:02:49.42,0:02:50.89,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:51.82,0:02:52.73,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:02:58.27,0:03:02.50,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:05.31,0:03:08.05,CNsub,NTP,0000,0000,0000,,Мен оны көріп жылап аламын.
Dialogue: 0,0:03:09.29,0:03:11.83,CNsub,NTP,0000,0000,0000,,Мен жылай аламын
Dialogue: 0,0:03:12.73,0:03:13.49,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:12.39,0:04:16.71,CNsub,NTP,0000,0000,0000,,Жер асты барының сахнасы жарты жыл бұрын аяқталған.
Dialogue: 0,0:04:16.96,0:04:21.21,CNsub,NTP,0000,0000,0000,,Келген кәмелетке толмаған жәбірленушілер саны
Dialogue: 0,0:04:22.30,0:04:25.80,CNsub,NTP,0000,0000,0000,,Белгісіз дене дегеніміз не?
Dialogue: 0,0:04:26.05,0:04:29.53,CNsub,NTP,0000,0000,0000,,Полиция бір уақытта қылмыстық әдістердің егжей-тегжейлерін бақылайды
Dialogue: 0,0:04:29.76,0:04:31.93,CNsub,NTP,0000,0000,0000,,Қылмыстық қудалау салдарынан хабар-ошарсыз кету
Dialogue: 0,0:04:41.15,0:04:44.68,CNsub,NTP,0000,0000,0000,,Айлық талант астында отын мен су.
Dialogue: 0,0:04:45.10,0:04:47.56,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:47.71,0:04:48.89,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:48.96,0:04:52.52,CNsub,NTP,0000,0000,0000,,1 120 000 шарттар мен шарттар бар.
Dialogue: 0,0:04:52.70,0:04:54.33,CNsub,NTP,0000,0000,0000,,Мүлде жоқ
Dialogue: 0,0:04:54.34,0:04:55.82,CNsub,NTP,0000,0000,0000,,1 000 000 000 000
Dialogue: 0,0:04:56.40,0:04:59.45,CNsub,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:00.34,0:05:02.85,CNsub,NTP,0000,0000,0000,,Заманның бақсысы
Dialogue: 0,0:05:03.33,0:05:05.11,CNsub,NTP,0000,0000,0000,,Күтілетін нәтижелер
Dialogue: 0,0:05:05.23,0:05:09.56,CNsub,NTP,0000,0000,0000,,Заманның басынан бері 100 жыл өтті, ол ешқашан орындалған жоқ.
Dialogue: 0,0:05:09.81,0:05:15.22,CNsub,NTP,0000,0000,0000,,－Сиқырлы әлемнің шығысы мен батысының тарихын қайта қарау... －Қажетсіз түсіндіру аяқталды.
Dialogue: 0,0:05:15.59,0:05:19.58,CNsub,NTP,0000,0000,0000,,Өйткені ол кенет Шығыс пен Батыста пайда болды
Dialogue: 0,0:05:19.70,0:05:20.97,CNsub,NTP,0000,0000,0000,,Шикізатты пайдаланбау
Dialogue: 0,0:05:21.17,0:05:23.66,CNsub,NTP,0000,0000,0000,,Мен қазір оқшауланудамын.
Dialogue: 0,0:05:24.05,0:05:28.44,CNsub,NTP,0000,0000,0000,,Дұрыс мәтін қандай? Бұл ай ма?
Dialogue: 0,0:05:28.74,0:05:32.12,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:32.48,0:05:34.43,CNsub,NTP,0000,0000,0000,,Яғни, біздің ұйымға қосылғың келе ме?
Dialogue: 0,0:05:35.16,0:05:35.95,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:05:36.35,0:05:38.06,CNsub,NTP,0000,0000,0000,,Ондық Апельсин Кішкентай апа
Dialogue: 0,0:05:38.65,0:05:40.50,CNsub,NTP,0000,0000,0000,,Ноборугатенчиго
Dialogue: 0,0:05:40.97,0:05:42.78,CNsub,NTP,0000,0000,0000,,Қай жерде екеніңізді қараңыз
Dialogue: 0,0:05:43.23,0:05:45.73,CNsub,NTP,0000,0000,0000,,Толық бас тартты
Dialogue: 0,0:05:50.78,0:05:55.31,CNsub,NTP,0000,0000,0000,,Адамдардың қолайсыз екені ақиқат.
Dialogue: 0,0:05:55.47,0:05:57.86,CNsub,NTP,0000,0000,0000,,Апельсин мәтіннен шығады
Dialogue: 0,0:05:58.63,0:06:02.91,CNsub,NTP,0000,0000,0000,,Бұл қиялсыз қабылдау комиссиясы.
Dialogue: 0,0:06:03.40,0:06:05.95,CNsub,NTP,0000,0000,0000,,Пайдалануды қалай тоқтатуға болады
Dialogue: 0,0:06:08.23,0:06:11.46,CNsub,NTP,0000,0000,0000,,Кеше түнгі оқиға
Dialogue: 0,0:06:11.96,0:06:15.20,CNsub,NTP,0000,0000,0000,,Жұмыс күшіне кіру міндетті емес.
Dialogue: 0,0:06:16.76,0:06:19.65,CNsub,NTP,0000,0000,0000,,Мен оқиға орнындағы жағдайды ғана түсіндіре аламын.
Dialogue: 0,0:06:20.10,0:06:22.46,CNsub,NTP,0000,0000,0000,,Сіздің бақылау қабілетіңіз күшті емес.
Dialogue: 0,0:06:23.16,0:06:26.18,CNsub,NTP,0000,0000,0000,,Уәкілетті тұлғаның қылмыстық тергеуі
Dialogue: 0,0:06:26.50,0:06:30.24,CNsub,NTP,0000,0000,0000,,Егер сіз өз міндеттеріңізге жауапты болсаңыз, сіз кінәлісіз.
Dialogue: 0,0:06:30.62,0:06:35.28,CNsub,NTP,0000,0000,0000,,Көтеріліс әңгіме жазудың қажеті жоқ.
Dialogue: 0,0:06:36.36,0:06:37.14,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:37.66,0:06:41.49,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:41.67,0:06:44.19,CNsub,NTP,0000,0000,0000,,Бұл қажетсіз жауап.
Dialogue: 0,0:06:44.42,0:06:46.91,CNsub,NTP,0000,0000,0000,,Кенеттен пайда болу
Dialogue: 0,0:06:47.37,0:06:49.42,CNsub,NTP,0000,0000,0000,,Юнаның мейрамханасына
Dialogue: 0,0:06:50.97,0:06:53.50,CNsub,NTP,0000,0000,0000,,Ұрлау
Dialogue: 0,0:06:54.26,0:06:57.18,CNsub,NTP,0000,0000,0000,,Сіз оны ала алмайсыз.
Dialogue: 0,0:06:57.98,0:07:02.07,CNsub,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:07:02.67,0:07:07.11,CNsub,NTP,0000,0000,0000,,Сондықтан келген сәтте өзара өлтіру
Dialogue: 0,0:07:15.50,0:07:20.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:20.29,0:07:23.56,CNsub,NTP,0000,0000,0000,,Ақиқат қара түнг құрғақ.
Dialogue: 0,0:07:23.86,0:07:26.82,CNsub,NTP,0000,0000,0000,,Мен тапсырманы орындауға асығамын.
Dialogue: 0,0:07:27.12,0:07:29.16,CNsub,NTP,0000,0000,0000,,Қазіргі жағдай қандай?
Dialogue: 0,0:07:29.28,0:07:33.88,CNsub,NTP,0000,0000,0000,,Мұны қалай есептейсіз?
Dialogue: 0,0:07:34.16,0:07:36.83,CNsub,NTP,0000,0000,0000,,Университетті бітіргеннен кейін
Dialogue: 0,0:07:37.35,0:07:39.97,CNsub,NTP,0000,0000,0000,,Айқайласаң, тағы көрем сені, басқалар
Dialogue: 0,0:07:40.15,0:07:43.55,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:43.66,0:07:46.05,CNsub,NTP,0000,0000,0000,,Жүріп келе жатқан қарт
Dialogue: 0,0:07:46.36,0:07:49.12,CNsub,NTP,0000,0000,0000,,Менің отбасымның жағдайлары қажет емес.
Dialogue: 0,0:07:49.35,0:07:51.65,CNsub,NTP,0000,0000,0000,,Сіз қарыз алсаңыз, қарызға алынбайды.
Dialogue: 0,0:07:51.99,0:07:54.99,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:57.83,0:07:58.75,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:08:01.61,0:08:06.18,CNsub,NTP,0000,0000,0000,,``Мен сенімен айналысамын, мен сенімен айналысамын.'' Бұл сіз білетін сөз тіркесі.
Dialogue: 0,0:08:08.62,0:08:11.24,CNsub,NTP,0000,0000,0000,,Ақпаратты алу жолын үйреніңіз
Dialogue: 0,0:08:11.46,0:08:16.36,CNsub,NTP,0000,0000,0000,,Мен орта және толық емес орта мектепке келгенде, мен оны ұстанғым келмеді.
Dialogue: 0,0:08:17.68,0:08:19.09,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:19.13,0:08:21.86,CNsub,NTP,0000,0000,0000,,Жақсы мүсін кеше түнде басталып, дүниеден өтті
Dialogue: 0,0:08:22.09,0:08:23.75,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:25.49,0:08:29.48,CNsub,NTP,0000,0000,0000,,Жақсы сурет
Dialogue: 0,0:08:30.01,0:08:31.34,CNsub,NTP,0000,0000,0000,,Мазу заты?
Dialogue: 0,0:09:08.19,0:09:12.96,CNsub,NTP,0000,0000,0000,,Сен Чи Доу
Dialogue: 0,0:09:22.83,0:09:27.38,CNsub,NTP,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:09:29.67,0:09:31.94,CNsub,NTP,0000,0000,0000,,Табиғи емес оқиға I...
Dialogue: 0,0:09:41.42,0:09:46.83,CNsub,NTP,0000,0000,0000,,Түнде мені көруге келгенде, тұру өте қысқа.
Dialogue: 0,0:09:46.99,0:09:48.34,CNsub,NTP,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:09:49.04,0:09:56.10,CNsub,NTP,0000,0000,0000,,Оқу жылының атауын Фуджиновага және т.б. конференцияның тұсаукесері алдында атап өтті.
Dialogue: 0,0:09:57.56,0:10:00.72,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:03.02,0:10:05.06,CNsub,NTP,0000,0000,0000,,Жауапкершіліктен бас тарту
Dialogue: 0,0:10:05.15,0:10:08.85,CNsub,NTP,0000,0000,0000,,Гого - адамдар мен жануарларға зиян келтірмейтін типтік мысал.
Dialogue: 0,0:10:09.16,0:10:13.18,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:13.22,0:10:14.81,CNsub,NTP,0000,0000,0000,,Студенттің жан-жақты академиялық ұзақтығы
Dialogue: 0,0:10:15.34,0:10:15.93,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:10:16.37,0:10:17.16,CNsub,NTP,0000,0000,0000,,Фука
Dialogue: 0,0:10:20.91,0:10:26.25,CNsub,NTP,0000,0000,0000,,Екі рәсім мен мұндамын, т.б.
Dialogue: 0,0:10:26.34,0:10:28.17,CNsub,NTP,0000,0000,0000,,Сізбен емес
Dialogue: 0,0:10:28.61,0:10:30.89,CNsub,NTP,0000,0000,0000,,Бұл сіздің хабарламаңыз
Dialogue: 0,0:10:31.13,0:10:32.69,CNsub,NTP,0000,0000,0000,,«Бұл енді мүмкін емес».
Dialogue: 0,0:10:33.02,0:10:34.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:35.60,0:10:38.28,CNsub,NTP,0000,0000,0000,,Өрнек сіздің жыныңыз
Dialogue: 0,0:10:38.51,0:10:41.32,CNsub,NTP,0000,0000,0000,,Сіз осындасыз.
Dialogue: 0,0:10:41.32,0:10:42.79,CNsub,NTP,0000,0000,0000,,Мен де жәбірленушімін.
Dialogue: 0,0:10:43.23,0:10:47.63,CNsub,NTP,0000,0000,0000,,Телефонда «Мен бетімді жоғалттым, енді мен оны күтуім керек» деген сөздерді естігенде.
Dialogue: 0,0:10:47.65,0:10:48.63,CNsub,NTP,0000,0000,0000,,Курсты аяқтағаннан кейін
Dialogue: 0,0:10:50.71,0:10:52.76,CNsub,NTP,0000,0000,0000,,Нацуки Куротоу Догаку
Dialogue: 0,0:10:52.83,0:10:53.42,CNsub,NTP,0000,0000,0000,,Дрейф
Dialogue: 0,0:10:55.14,0:10:57.79,CNsub,NTP,0000,0000,0000,,Үй иесі келді
Dialogue: 0,0:10:59.34,0:11:01.94,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:11:02.03,0:11:03.39,CNsub,NTP,0000,0000,0000,,Хоко Фуджино
Dialogue: 0,0:11:05.42,0:11:06.27,CNsub,NTP,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:11:07.43,0:11:09.78,CNsub,NTP,0000,0000,0000,,Сіз ауыртпайсыз
Dialogue: 0,0:11:15.98,0:11:18.30,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:18.30,0:11:20.18,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:20.33,0:11:24.91,CNsub,NTP,0000,0000,0000,,Жарық жақсы дос па?
Dialogue: 0,0:11:25.34,0:11:28.88,CNsub,NTP,0000,0000,0000,,Өзін-өзі ақтауға болмайды
Dialogue: 0,0:11:29.08,0:11:32.83,CNsub,NTP,0000,0000,0000,,хайку астана тәртібі өмір ауасы
Dialogue: 0,0:11:32.89,0:11:34.83,CNsub,NTP,0000,0000,0000,,Онымен күресудің тағы бір жолы
Dialogue: 0,0:11:34.91,0:11:37.71,CNsub,NTP,0000,0000,0000,,Қайтадан сөйлескенде, сіз эго мағынасын білмейсіз.
Dialogue: 0,0:11:37.71,0:11:39.87,CNsub,NTP,0000,0000,0000,,Шынымен біреу өзінің эгосын түсінуі мүмкін бе?
Dialogue: 0,0:11:39.93,0:11:43.17,CNsub,NTP,0000,0000,0000,,Мен осы уақытқа дейін не үйренгенімді елестете алмаймын.
Dialogue: 0,0:11:43.29,0:11:46.42,CNsub,NTP,0000,0000,0000,,Басқарудың көптеген мәселелері
Dialogue: 0,0:11:46.94,0:11:51.71,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:11:52.01,0:11:54.58,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:54.88,0:11:58.79,CNsub,NTP,0000,0000,0000,,«Джордж, еркін жүретін әйел»
Dialogue: 0,0:11:58.95,0:12:01.36,CNsub,NTP,0000,0000,0000,,Маған ұнайды.
Dialogue: 0,0:12:01.91,0:12:02.61,CNsub,NTP,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:12:10.70,0:12:14.99,CNsub,NTP,0000,0000,0000,,Фуджино Хананы құшақтаңыз Мен жиналыстан шықтым
Dialogue: 0,0:12:17.54,0:12:19.29,CNsub,NTP,0000,0000,0000,,Жылжымалы жарық
Dialogue: 0,0:12:19.92,0:12:20.87,CNsub,NTP,0000,0000,0000,,Есептеу
Dialogue: 0,0:12:21.12,0:12:24.63,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:30.56,0:12:32.23,CNsub,NTP,0000,0000,0000,,Бұл аспанның бірінші түнінің алдындағы.
Dialogue: 0,0:12:32.35,0:12:35.32,CNsub,NTP,0000,0000,0000,,Козо Сакуя-кунның телефоны келді
Dialogue: 0,0:12:35.46,0:12:38.15,CNsub,NTP,0000,0000,0000,,“Кездесу” сөзінің айтылуы
Dialogue: 0,0:12:39.52,0:12:40.78,CNsub,NTP,0000,0000,0000,,Өлтірілді ме?
Dialogue: 0,0:12:41.36,0:12:44.60,CNsub,NTP,0000,0000,0000,,Мені қасымда жоқ екі-үш адам өлтірді.
Dialogue: 0,0:12:44.75,0:12:47.05,CNsub,NTP,0000,0000,0000,,Жақсы бейне – шын айқай
Dialogue: 0,0:12:50.69,0:12:53.10,CNsub,NTP,0000,0000,0000,,Мен мұнда не үшін келгенімді білмедім.
Dialogue: 0,0:12:53.38,0:12:55.64,CNsub,NTP,0000,0000,0000,,Наханья шынымен де аңдар тобы.
Dialogue: 0,0:12:57.46,0:13:00.62,CNsub,NTP,0000,0000,0000,,Үй иесінің өлімі
Dialogue: 0,0:13:02.19,0:13:05.50,CNsub,NTP,0000,0000,0000,,Тұрақты тұтынушы болсаңыз, аздап шығын бар.
Dialogue: 0,0:13:05.90,0:13:06.92,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:07.04,0:13:10.34,CNsub,NTP,0000,0000,0000,,Бұл студенттің жолдас әңгімесі. Бір пакет 2000 юань тұрады.
Dialogue: 0,0:13:17.68,0:13:20.62,CNsub,NTP,0000,0000,0000,,Кохеи жоқ дүкен сыртында
Dialogue: 0,0:13:21.49,0:13:23.78,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:25.29,0:13:28.55,CNsub,NTP,0000,0000,0000,,Келе жатқан кескіндер үлкен де, кіші де болады.
Dialogue: 0,0:13:29.68,0:13:31.40,CNsub,NTP,0000,0000,0000,,Бұл растау
Dialogue: 0,0:13:31.66,0:13:33.73,CNsub,NTP,0000,0000,0000,,Күтіп тұрғаның үшін кешір. Міне, сенің құлпынайлы тортың
Dialogue: 0,0:13:34.07,0:13:36.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:37.39,0:13:40.44,CNsub,NTP,0000,0000,0000,,Жұмысқа қайта оралу арқылы басқа әрекеттерден ләззат алу
Dialogue: 0,0:14:04.16,0:14:09.72,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:10.75,0:14:13.86,CNsub,NTP,0000,0000,0000,,Құтқару...сақтау...
Dialogue: 0,0:14:21.35,0:14:23.18,CNsub,NTP,0000,0000,0000,,Менің аяғым
Dialogue: 0,0:14:23.47,0:14:25.10,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:14:26.59,0:14:28.58,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:29.26,0:14:31.50,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:14:36.21,0:14:37.10,CNsub,NTP,0000,0000,0000,,Ұсақ-түйек
Dialogue: 0,0:14:50.83,0:14:57.37,CNsub,NTP,0000,0000,0000,,Бұл болмайды, бірақ мен сонда баруым керек.
Dialogue: 0,0:14:58.07,0:15:03.62,CNsub,NTP,0000,0000,0000,,Міне, мен дарынды қарапайым адаммын.
Dialogue: 0,0:15:05.36,0:15:09.90,CNsub,NTP,0000,0000,0000,,Мен өлтіруші ретінде осылай ойладым.
Dialogue: 0,0:15:09.98,0:15:12.50,CNsub,NTP,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:15:18.46,0:15:22.22,CNsub,NTP,0000,0000,0000,,Фуджино Асагами Харараи Джоко
Dialogue: 0,0:15:22.66,0:15:25.03,CNsub,NTP,0000,0000,0000,,Бұл Асагами мен бастапқы тұлғаның аты.
Dialogue: 0,0:15:25.73,0:15:28.79,CNsub,NTP,0000,0000,0000,,Сіздің уақытыңыз қашан…
Dialogue: 0,0:15:29.47,0:15:34.25,CNsub,NTP,0000,0000,0000,,Бір уақытта бір кесек ет жеуге болады.
Dialogue: 0,0:15:35.03,0:15:39.47,CNsub,NTP,0000,0000,0000,,Басқа сөздер: «ет бөлігі»
Dialogue: 0,0:15:39.71,0:15:40.56,CNsub,NTP,0000,0000,0000,,Гуманистік…
Dialogue: 0,0:15:40.56,0:15:43.98,CNsub,NTP,0000,0000,0000,,Осыған байланысты адамдардың кездесуіне және өлуіне рұқсат етілмейді.
Dialogue: 0,0:15:44.31,0:15:48.04,CNsub,NTP,0000,0000,0000,,Белгісіз түрде қайтыс болуына байланысты үйлерінен шыға алмайтын адамдар
Dialogue: 0,0:15:48.42,0:15:52.70,CNsub,NTP,0000,0000,0000,,Шекаралық үйден бөліну немесе барлық мағынадан айыру
Dialogue: 0,0:15:53.12,0:15:55.37,CNsub,NTP,0000,0000,0000,,Тапсырысты орындау үшін ұзақ уақыт күту
Dialogue: 0,0:15:55.47,0:15:57.22,CNsub,NTP,0000,0000,0000,,Сіз осындайсыз.
Dialogue: 0,0:15:57.29,0:15:58.19,CNsub,NTP,0000,0000,0000,,Мұны істеу заңсыз.
Dialogue: 0,0:15:58.63,0:16:01.84,CNsub,NTP,0000,0000,0000,,Мені қарапайым адамдар түзейді.
Dialogue: 0,0:16:04.33,0:16:06.50,CNsub,NTP,0000,0000,0000,,Біз екі бірдей адамбыз.
Dialogue: 0,0:16:07.13,0:16:08.58,CNsub,NTP,0000,0000,0000,,Фуджино Асагами
Dialogue: 0,0:16:09.83,0:16:11.33,CNsub,NTP,0000,0000,0000,,Бөлек ойын
Dialogue: 0,0:16:22.01,0:16:25.97,CNsub,NTP,0000,0000,0000,,Қайта келіңіз.
Dialogue: 0,0:16:32.30,0:16:34.52,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:35.18,0:16:37.67,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта сіз жоқсыз.
Dialogue: 0,0:16:38.22,0:16:42.21,CNsub,NTP,0000,0000,0000,,Үйге қайтқанда тағы көрдім.
Dialogue: 0,0:16:54.35,0:17:00.10,CNsub,NTP,0000,0000,0000,,Уақыты келгенде
Dialogue: 0,0:17:03.84,0:17:09.38,CNsub,NTP,0000,0000,0000,,Бір қылышпен араласқан ұсақ-түйек ыдыстар
Dialogue: 0,0:17:13.32,0:17:16.45,CNsub,NTP,0000,0000,0000,,Фуджино, сен осындасың
Dialogue: 0,0:17:21.18,0:17:23.10,CNsub,NTP,0000,0000,0000,,Қан ағымы аяқталды...
Dialogue: 0,0:17:24.70,0:17:26.26,CNsub,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,0:17:27.78,0:17:31.12,CNsub,NTP,0000,0000,0000,,Назе хайку мо name ки myo no wa
Dialogue: 0,0:17:31.85,0:17:35.34,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:17:48.49,0:17:52.61,CNsub,NTP,0000,0000,0000,,Фуджино және басқалары жарақаттанған, ауырмайды
Dialogue: 0,0:17:53.75,0:17:57.18,CNsub,NTP,0000,0000,0000,,Мен де сөз тіркесінің мағынасын білмеймін.
Dialogue: 0,0:17:58.07,0:18:02.74,CNsub,NTP,0000,0000,0000,,Себебі мен бірінші өлімімнің азабын сеземін.
Dialogue: 0,0:18:05.98,0:18:10.40,CNsub,NTP,0000,0000,0000,,Әйтсе де, ақырында мен мұны істей алдым
Dialogue: 0,0:18:11.74,0:18:14.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:18.25,0:18:20.35,CNsub,NTP,0000,0000,0000,,Жақсы сезіну немесе ауырсынуды сезіну оңай емес
Dialogue: 0,0:18:21.06,0:18:22.44,CNsub,NTP,0000,0000,0000,,Сізге ұнаса да, ұнамаса да...
Dialogue: 0,0:18:22.66,0:18:24.89,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:18:25.43,0:18:26.83,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:26.96,0:18:29.71,CNsub,NTP,0000,0000,0000,,Қанішердің білімін білу керек, ал мен өлтіруші туралы айтып отырмын...
Dialogue: 0,0:18:30.47,0:18:35.66,CNsub,NTP,0000,0000,0000,,Сондықтан мен оны алуым керек, мырза.
Dialogue: 0,0:18:35.91,0:18:38.49,CNsub,NTP,0000,0000,0000,,Міндетті емес.
Dialogue: 0,0:18:41.43,0:18:44.06,CNsub,NTP,0000,0000,0000,,Қара Тунг Гакучо, өзін-өзі құтқарушы
Dialogue: 0,0:18:45.55,0:18:47.67,CNsub,NTP,0000,0000,0000,,Накея аномалиясы
Dialogue: 0,0:18:49.39,0:18:52.07,CNsub,NTP,0000,0000,0000,,Болған қызық оқиға
Dialogue: 0,0:18:52.26,0:18:55.58,CNsub,NTP,0000,0000,0000,,Накея – құбыжық – құбыжық
Dialogue: 0,0:18:56.59,0:18:57.71,CNsub,NTP,0000,0000,0000,,Йокай
Dialogue: 0,0:18:59.03,0:19:00.92,CNsub,NTP,0000,0000,0000,,Растау арқылы жарияланған
Dialogue: 0,0:19:01.27,0:19:04.44,CNsub,NTP,0000,0000,0000,,Вокзалға келмеу
Dialogue: 0,0:19:04.91,0:19:06.60,CNsub,NTP,0000,0000,0000,,Жалға берушіні тағайындау аяқталды
Dialogue: 0,0:19:07.11,0:19:10.04,CNsub,NTP,0000,0000,0000,,Морт тәрізді дауыс
Dialogue: 0,0:19:10.34,0:19:11.19,CNsub,NTP,0000,0000,0000,,Үй иесі…
Dialogue: 0,0:19:14.05,0:19:15.99,CNsub,NTP,0000,0000,0000,,Үй иесі қайтыс болды
Dialogue: 0,0:19:18.70,0:19:21.62,CNsub,NTP,0000,0000,0000,,Саған сенетінім анық
Dialogue: 0,0:19:22.72,0:19:23.61,CNsub,NTP,0000,0000,0000,,Осы дискідегі ақпарат Неапольде пойызға мініп жатқан кезде жазылды.
Dialogue: 0,0:19:23.94,0:19:27.45,CNsub,NTP,0000,0000,0000,,Шығыс пен батыста қажетсіз оқу
Dialogue: 0,0:19:32.94,0:19:37.06,CNsub,NTP,0000,0000,0000,,Кіріспе Әу бастан ғажаптық – ниет
Dialogue: 0,0:19:39.09,0:19:44.98,CNsub,NTP,0000,0000,0000,,Бірінші Кинайке...Фуджино Коре жарты жыл бұрын
Dialogue: 0,0:19:48.90,0:19:51.01,CNsub,NTP,0000,0000,0000,,Наоки Кайкай
Dialogue: 0,0:19:51.48,0:19:53.50,CNsub,NTP,0000,0000,0000,,Бейне суретке ұқсас.
Dialogue: 0,0:19:56.90,0:20:01.26,CNsub,NTP,0000,0000,0000,,Қабылданбасын.
Dialogue: 0,0:20:04.62,0:20:07.63,CNsub,NTP,0000,0000,0000,,Икуя бетінің өзгермеген түсі
Dialogue: 0,0:20:08.54,0:20:10.61,CNsub,NTP,0000,0000,0000,,Суару өзгерісі жоқ
Dialogue: 0,0:20:11.29,0:20:13.87,CNsub,NTP,0000,0000,0000,,Ұру немесе ұру
Dialogue: 0,0:20:16.09,0:20:19.07,CNsub,NTP,0000,0000,0000,,Оның себебі оның сыртқы келбеті жоғары деңгейде.
Dialogue: 0,0:20:19.70,0:20:24.17,CNsub,NTP,0000,0000,0000,,Келіп өлуге ниет ету
Dialogue: 0,0:20:24.86,0:20:28.81,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:29.45,0:20:31.22,CNsub,NTP,0000,0000,0000,,Бұл жақында болған мәселе.
Dialogue: 0,0:20:31.66,0:20:35.54,CNsub,NTP,0000,0000,0000,,Егер сізбен бірге жалғыз адам болса, сіз темір шарды ұрып, арқаңызға жабыса аласыз.
Dialogue: 0,0:20:42.19,0:20:46.68,CNsub,NTP,0000,0000,0000,,Юйчидің ұлы құлады.
Dialogue: 0,0:20:47.18,0:20:50.34,CNsub,NTP,0000,0000,0000,,Мен саған қарсымын
Dialogue: 0,0:20:50.64,0:20:53.30,CNsub,NTP,0000,0000,0000,,«Сізбен кездескенім ауыр».
Dialogue: 0,0:20:54.01,0:20:58.67,CNsub,NTP,0000,0000,0000,,Бір түнде Тадашиде Юкихиро Гаго мүсіні бұдан былай жазылған.
Dialogue: 0,0:21:00.30,0:21:03.36,CNsub,NTP,0000,0000,0000,,Сен мен үшін жабықсың
Dialogue: 0,0:21:05.01,0:21:06.86,CNsub,NTP,0000,0000,0000,,Сіз жақсы адамсыз
Dialogue: 0,0:21:09.87,0:21:12.79,CNsub,NTP,0000,0000,0000,,Сіз бен менің арамыздағы айырмашылық туралы не ойлайсыз?
Dialogue: 0,0:21:15.92,0:21:20.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:20.62,0:21:22.58,CNsub,NTP,0000,0000,0000,,Шынайы ойлар сенікі.
Dialogue: 0,0:21:23.41,0:21:26.57,CNsub,NTP,0000,0000,0000,,Қазіргі жағдай қандай?
Dialogue: 0,0:21:27.25,0:21:30.04,CNsub,NTP,0000,0000,0000,,Расында да жағдай ерекше.
Dialogue: 0,0:21:30.29,0:21:32.95,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:21:33.52,0:21:36.85,CNsub,NTP,0000,0000,0000,,Сондай-ақ өнімділік сынағын көруге болады
Dialogue: 0,0:21:36.99,0:21:40.71,CNsub,NTP,0000,0000,0000,,Сіз жақсы адамсыз.
Dialogue: 0,0:21:41.25,0:21:43.51,CNsub,NTP,0000,0000,0000,,Бұл түсініксіз
Dialogue: 0,0:21:43.60,0:21:44.87,CNsub,NTP,0000,0000,0000,,Түннің соңы
Dialogue: 0,0:21:45.44,0:21:47.58,CNsub,NTP,0000,0000,0000,,Кездесуді нақты мақсаттан бұрын тоқтату
Dialogue: 0,0:21:47.70,0:21:50.28,CNsub,NTP,0000,0000,0000,,Іс жүзінде орындалмаған немесе әлі кездеспеді...
Dialogue: 0,0:21:50.37,0:21:54.29,CNsub,NTP,0000,0000,0000,,Өрнек
Dialogue: 0,0:21:54.29,0:21:56.10,CNsub,NTP,0000,0000,0000,,Әрине, мен қаланы көрдім.
Dialogue: 0,0:21:56.31,0:21:59.65,CNsub,NTP,0000,0000,0000,,Кешегі ауа-райы гүлдер мен гүлдермен бірге болды.
Dialogue: 0,0:21:59.75,0:22:01.05,CNsub,NTP,0000,0000,0000,,Вабухана…
Dialogue: 0,0:22:02.12,0:22:05.64,CNsub,NTP,0000,0000,0000,,Нана
Dialogue: 0,0:22:05.80,0:22:09.60,CNsub,NTP,0000,0000,0000,,Жоспар басталғанға дейін қонақ үй немесе үй емес
Dialogue: 0,0:22:09.67,0:22:10.96,CNsub,NTP,0000,0000,0000,,Мектеп те жабылды
Dialogue: 0,0:22:11.69,0:22:13.85,CNsub,NTP,0000,0000,0000,,Соңғы аспаннан бері мен Қазухананың өлімін көрдім.
Dialogue: 0,0:22:15.68,0:22:20.78,CNsub,NTP,0000,0000,0000,,Толық және толық құлдырау белгісіз.
Dialogue: 0,0:22:21.43,0:22:26.17,CNsub,NTP,0000,0000,0000,,Келесі әрекеттер орындалды.
Dialogue: 0,0:22:26.47,0:22:30.41,CNsub,NTP,0000,0000,0000,,Зорлық... Ой мен ой таяз
Dialogue: 0,0:22:30.72,0:22:33.68,CNsub,NTP,0000,0000,0000,,Түбірлік жағдай - бұл пайдасыз.
Dialogue: 0,0:22:33.78,0:22:37.60,CNsub,NTP,0000,0000,0000,,Басқаны өлтіргің келсе, айырмашылығы жоқ.
Dialogue: 0,0:22:37.64,0:22:39.39,CNsub,NTP,0000,0000,0000,,Мен транзакцияның мүмкін екенін түсінемін.
Dialogue: 0,0:22:39.98,0:22:41.32,CNsub,NTP,0000,0000,0000,,Сен үшін тек жойылу ғана қалды
Dialogue: 0,0:22:41.90,0:22:45.67,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:45.90,0:22:51.09,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:51.81,0:22:55.38,CNsub,NTP,0000,0000,0000,,Дәл сол уақытта Фудзиноны пышақтап кетті.
Dialogue: 0,0:22:55.53,0:22:57.53,CNsub,NTP,0000,0000,0000,,Бұл қосымша себептерге байланысты.
Dialogue: 0,0:22:59.74,0:23:01.43,CNsub,NTP,0000,0000,0000,,Мәселенің басталуы
Dialogue: 0,0:23:01.76,0:23:04.66,CNsub,NTP,0000,0000,0000,,Іштің шағуы No20 түн
Dialogue: 0,0:23:04.86,0:23:07.21,CNsub,NTP,0000,0000,0000,,Салтанат 2-ші аспан императрицасына келді.
Dialogue: 0,0:23:07.41,0:23:10.69,CNsub,NTP,0000,0000,0000,,НАТО Асаги Фуджиноми қайтыс болды.
Dialogue: 0,0:23:10.72,0:23:12.18,CNsub,NTP,0000,0000,0000,,Егер сізді қанағаттандырмаса
Dialogue: 0,0:23:13.93,0:23:15.54,CNsub,NTP,0000,0000,0000,,Чузиге жаза
Dialogue: 0,0:23:20.37,0:23:24.16,CNsub,NTP,0000,0000,0000,,Дегенмен, Фуджино телефонда.
Dialogue: 0,0:23:24.48,0:23:28.37,CNsub,NTP,0000,0000,0000,,Өткен қорлау туралы қорқынышты естеліктер
Dialogue: 0,0:23:28.40,0:23:30.93,CNsub,NTP,0000,0000,0000,,Іш жарақатынан пайда болатын ауырсыну
Dialogue: 0,0:23:30.99,0:23:32.96,CNsub,NTP,0000,0000,0000,,Фуджиносайкай өлтіруші
Dialogue: 0,0:23:33.44,0:23:36.93,CNsub,NTP,0000,0000,0000,,Мәміленің уақытын растауға кім батылы барады?
Dialogue: 0,0:23:36.99,0:23:38.42,CNsub,NTP,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:23:38.83,0:23:40.98,CNsub,NTP,0000,0000,0000,,Шынайы болмыс азабы
Dialogue: 0,0:23:41.48,0:23:44.93,CNsub,NTP,0000,0000,0000,,Асагами Фудзиноның денедегі резиденциясы
Dialogue: 0,0:23:46.84,0:23:48.54,CNsub,NTP,0000,0000,0000,,Айтқым келмейді.
Dialogue: 0,0:23:49.20,0:23:51.16,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:23:52.46,0:23:55.41,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:24:00.81,0:24:04.15,CNsub,NTP,0000,0000,0000,,Тек азапты тәжірибе қалды.
Dialogue: 0,0:24:07.10,0:24:11.16,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:11.45,0:24:13.04,CNsub,NTP,0000,0000,0000,,Фуджиноя Асагами?
Dialogue: 0,0:24:13.85,0:24:18.27,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:19.30,0:24:23.03,CNsub,NTP,0000,0000,0000,,Бұл қалай мүмкін?
Dialogue: 0,0:24:23.52,0:24:25.27,CNsub,NTP,0000,0000,0000,,Ауырсыну синдромы жоқ
Dialogue: 0,0:24:25.44,0:24:30.13,CNsub,NTP,0000,0000,0000,,Жастар осындай.
Dialogue: 0,0:24:30.31,0:24:32.37,CNsub,NTP,0000,0000,0000,,Утилитаның кері штрихы
Dialogue: 0,0:24:32.37,0:24:35.76,CNsub,NTP,0000,0000,0000,,Бұл жоғарғы бездерге көп мөлшерде инъекция және тері сапасы.
Dialogue: 0,0:24:36.48,0:24:37.64,CNsub,NTP,0000,0000,0000,,Артқа…
Dialogue: 0,0:24:39.12,0:24:43.29,CNsub,NTP,0000,0000,0000,,Шираничи және клубтың салмағы
Dialogue: 0,0:24:45.07,0:24:53.09,CNsub,NTP,0000,0000,0000,,Міне, мен емдеуге бар күшімді салдым, Фуджино Асагамидің ауыруы мен көру қабілетінің жоғалуы жақсы болды.
Dialogue: 0,0:24:53.47,0:24:57.99,CNsub,NTP,0000,0000,0000,,Бірінші кездесудегі ауру сезімі.
Dialogue: 0,0:24:58.16,0:25:00.29,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:25:00.46,0:25:01.19,CNsub,NTP,0000,0000,0000,,Не деген сұмдық…
Dialogue: 0,0:25:01.55,0:25:06.44,CNsub,NTP,0000,0000,0000,,Менде ешқандай сезім жоқ.
Dialogue: 0,0:25:08.24,0:25:12.18,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:12.36,0:25:15.13,CNsub,NTP,0000,0000,0000,,Бірлестіктің өмір сүруін жүзеге асырудың қиындығы
Dialogue: 0,0:25:16.01,0:25:18.39,CNsub,NTP,0000,0000,0000,,Насадағы ауырсыну
Dialogue: 0,0:25:18.86,0:25:21.44,CNsub,NTP,0000,0000,0000,,Жиналыста көбірек ауырсыну…2
Dialogue: 0,0:25:22.74,0:25:24.01,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:24.74,0:25:28.99,CNsub,NTP,0000,0000,0000,,Жақсы немесе жаман сезімді сезінуден туындаған ауырсыну.
Dialogue: 0,0:25:29.25,0:25:33.60,CNsub,NTP,0000,0000,0000,,Алайда бұл терминнің мағынасын көру мүмкін емес.
Dialogue: 0,0:25:33.81,0:25:35.79,CNsub,NTP,0000,0000,0000,,Мен қандай әрекеттер жасай аламын?
Dialogue: 0,0:25:36.07,0:25:38.54,CNsub,NTP,0000,0000,0000,,Фуджино Асагами
Dialogue: 0,0:25:38.95,0:25:42.40,CNsub,NTP,0000,0000,0000,,Амата-қайдың өлімін ойлап отырмын
Dialogue: 0,0:25:43.21,0:25:44.91,CNsub,NTP,0000,0000,0000,,Көршіңді жек көр
Dialogue: 0,0:25:45.06,0:25:47.50,CNsub,NTP,0000,0000,0000,,Отбасының бұл бағытта өмір сүруі мүмкін емес.
Dialogue: 0,0:25:48.93,0:25:51.57,CNsub,NTP,0000,0000,0000,,Фуджино Асагамидің өткені
Dialogue: 0,0:25:54.71,0:25:57.13,CNsub,NTP,0000,0000,0000,,Қол жеткізу үшін қайда бару керек...
Dialogue: 0,0:25:59.38,0:26:03.02,CNsub,NTP,0000,0000,0000,,Түсініктеме: Фуджиноя Асагами тек құрбан.
Dialogue: 0,0:26:03.91,0:26:07.37,CNsub,NTP,0000,0000,0000,,Мәселе қайда?
Dialogue: 0,0:26:08.85,0:26:10.43,CNsub,NTP,0000,0000,0000,,Мен қақпадан шығамын
Dialogue: 0,0:26:11.09,0:26:13.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:13.94,0:26:15.90,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:19.70,0:26:23.66,CNsub,NTP,0000,0000,0000,,Өрнек: Мен кетуге келдім.
Dialogue: 0,0:26:23.84,0:26:26.61,CNsub,NTP,0000,0000,0000,,Ранрай - сіздің шынайы мағынаңыз
Dialogue: 0,0:26:27.25,0:26:30.62,CNsub,NTP,0000,0000,0000,,Бұл ауруды ешкім емдей алмайды.
Dialogue: 0,0:26:34.68,0:26:36.09,CNsub,NTP,0000,0000,0000,,…Мен күш-жігерімді күтемін.
Dialogue: 0,0:26:51.51,0:26:53.26,CNsub,NTP,0000,0000,0000,,№ 20 содан бері өтті.
Dialogue: 0,0:26:54.02,0:26:55.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:45.49,0:27:47.60,CNsub,NTP,0000,0000,0000,,Кана апаты…
Dialogue: 0,0:27:48.87,0:27:51.98,CNsub,NTP,0000,0000,0000,,Офицер апатқа дейін қаза тапты.
Dialogue: 0,0:27:53.68,0:27:55.39,CNsub,NTP,0000,0000,0000,,Бұл жанасу апаты.
Dialogue: 0,0:27:55.49,0:27:57.05,CNsub,NTP,0000,0000,0000,,Юзидің қабылданбағаны рас па?
Dialogue: 0,0:27:58.74,0:28:02.36,CNsub,NTP,0000,0000,0000,,Әлі бар болмысы жоқ адам емес, бұл оң
Dialogue: 0,0:28:03.49,0:28:07.42,CNsub,NTP,0000,0000,0000,,Адамдарға толы құпия бөлме.
Dialogue: 0,0:28:08.82,0:28:11.93,CNsub,NTP,0000,0000,0000,,Сәтсіздік туралы мүмкін емес ескерту
Dialogue: 0,0:28:12.45,0:28:16.94,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:17.41,0:28:18.17,CNsub,NTP,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:28:20.15,0:28:22.64,CNsub,NTP,0000,0000,0000,,Салтанат Жетінші адам пайда болады
Dialogue: 0,0:28:22.93,0:28:25.69,CNsub,NTP,0000,0000,0000,,Төмендегілер зиянсыз адам.
Dialogue: 0,0:28:27.13,0:28:30.40,CNsub,NTP,0000,0000,0000,,Әлі танылмаған құрбандар
Dialogue: 0,0:28:31.19,0:28:33.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:41.15,0:28:41.92,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:28:46.49,0:28:49.80,CNsub,NTP,0000,0000,0000,,Бұл комиссия мүшесі жасаған қағаз мұқаба.
Dialogue: 0,0:28:50.31,0:28:54.06,CNsub,NTP,0000,0000,0000,,Ескі досының қарызға алынбаған тегі
Dialogue: 0,0:28:55.04,0:28:59.26,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:01.13,0:29:04.96,CNsub,NTP,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:29:17.33,0:29:19.63,CNsub,NTP,0000,0000,0000,,Қара тунг өлді.
Dialogue: 0,0:29:20.31,0:29:25.66,CNsub,NTP,0000,0000,0000,,Нана - қатты жел мен жаңбыр.
Dialogue: 0,0:29:27.12,0:29:31.56,CNsub,NTP,0000,0000,0000,,Жәбірленушінің өліміне қарсы бір адамның әңгімесін білдіру.
Dialogue: 0,0:30:20.93,0:30:23.13,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:23.78,0:30:29.19,CNsub,NTP,0000,0000,0000,,Шашымды ұмытып, өткен жолы қалдырдым.
Dialogue: 0,0:30:29.27,0:30:31.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:40.45,0:30:41.35,CNsub,NTP,0000,0000,0000,,Ауырсыну
Dialogue: 0,0:30:47.99,0:30:48.98,CNsub,NTP,0000,0000,0000,,Менің көзім астында
Dialogue: 0,0:30:52.46,0:30:56.79,CNsub,NTP,0000,0000,0000,,Басқа адамды көргенде ауырсынудың не екенін білмеймін
Dialogue: 0,0:30:57.33,0:31:02.41,CNsub,NTP,0000,0000,0000,,Басқалардың тексермеуі және Фуджиноның түзетуі қарапайым адамның әңгімесі, I бекіту ассоциациясы бұзылады.
Dialogue: 0,0:31:03.28,0:31:04.87,CNsub,NTP,0000,0000,0000,,Сіз шынымен әдемісіз.
Dialogue: 0,0:31:05.57,0:31:10.86,CNsub,NTP,0000,0000,0000,,Ұят, бірақ түсіну қиын.
Dialogue: 0,0:31:11.50,0:31:15.72,CNsub,NTP,0000,0000,0000,,Нана… Фуджино Асагами
Dialogue: 0,0:31:18.78,0:31:21.21,CNsub,NTP,0000,0000,0000,,Маған не болды?
Dialogue: 0,0:31:21.76,0:31:24.82,CNsub,NTP,0000,0000,0000,,Бұл сәтсіздік.
Dialogue: 0,0:31:26.32,0:31:29.00,CNsub,NTP,0000,0000,0000,,Кина Тенки туралы естеліктер...
Dialogue: 0,0:31:36.04,0:31:39.46,CNsub,NTP,0000,0000,0000,,Гакучо I…
Dialogue: 0,0:31:48.53,0:31:51.88,CNsub,NTP,0000,0000,0000,,Нағыз ләззат пен талант
Dialogue: 0,0:31:52.18,0:31:56.57,CNsub,NTP,0000,0000,0000,,Тайваньға соңғы рет жел соқты
Dialogue: 0,0:31:57.44,0:31:58.47,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:32:02.41,0:32:05.78,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:05.96,0:32:07.82,CNsub,NTP,0000,0000,0000,,Ауырсынбайды
Dialogue: 0,0:32:08.12,0:32:11.12,CNsub,NTP,0000,0000,0000,,Бастапқы құжаттардағы бұзушылықтарды түзету
Dialogue: 0,0:32:11.72,0:32:12.88,CNsub,NTP,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:32:16.76,0:32:20.27,CNsub,NTP,0000,0000,0000,,Асагами отбасының сіңлісі біртүрлі жұмбақ
Dialogue: 0,0:32:20.72,0:32:24.10,CNsub,NTP,0000,0000,0000,,Нобучизоку Шығыс және Батыс адмиралының жинағы
Dialogue: 0,0:32:24.63,0:32:29.62,CNsub,NTP,0000,0000,0000,,Терең кездесуден бері бұл ауылдың қарғысы
Dialogue: 0,0:32:30.57,0:32:35.97,CNsub,NTP,0000,0000,0000,,Қарияның келген жері осы.
Dialogue: 0,0:32:36.25,0:32:39.04,CNsub,NTP,0000,0000,0000,,Көңілім түсіп өлдім.
Dialogue: 0,0:32:39.29,0:32:42.87,CNsub,NTP,0000,0000,0000,,Тек кәрілік комиссиясына дайындалыңыз.
Dialogue: 0,0:32:43.29,0:32:46.15,CNsub,NTP,0000,0000,0000,,Осы емнің арқасында?
Dialogue: 0,0:32:46.89,0:32:50.35,CNsub,NTP,0000,0000,0000,,Анальгезия? Ширануду
Dialogue: 0,0:32:50.71,0:32:57.86,CNsub,NTP,0000,0000,0000,,Бірінші көрген сәтте;
Dialogue: 0,0:32:58.99,0:33:02.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:02.81,0:33:05.17,CNsub,NTP,0000,0000,0000,,Ауырсынбайтын белгілердің барлық түрлері
Dialogue: 0,0:33:05.51,0:33:09.12,CNsub,NTP,0000,0000,0000,,Ауырсынбайтын симптомдардың атымен жұмыс істемеу немесе белгілі бір түзетпеу
Dialogue: 0,0:33:09.47,0:33:12.87,CNsub,NTP,0000,0000,0000,,Фуджино Асагамидің адам өмірін жоғалту сезімі
Dialogue: 0,0:33:13.05,0:33:15.46,CNsub,NTP,0000,0000,0000,,Екінші жағынан
Dialogue: 0,0:33:19.66,0:33:23.57,CNsub,NTP,0000,0000,0000,,Фуджиноның әкесінің мөрлеу қабілеті
Dialogue: 0,0:33:23.98,0:33:29.11,CNsub,NTP,0000,0000,0000,,Өмір туралы ойлау қабілеті бар адам пайда болады және толықтай өзара қандас болады.
Dialogue: 0,0:33:29.43,0:33:34.88,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл қайғылы жағдай.
Dialogue: 0,0:33:35.37,0:33:38.26,CNsub,NTP,0000,0000,0000,,Таяз құдайлық қан және басқа қан
Dialogue: 0,0:33:39.90,0:33:41.38,CNsub,NTP,0000,0000,0000,,Қызғылт сары қыз Шики 3
Dialogue: 0,0:33:42.51,0:33:45.23,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:52.20,0:33:54.63,CNsub,NTP,0000,0000,0000,,Қызғылт сары қыз
Dialogue: 0,0:33:59.09,0:34:03.11,CNsub,NTP,0000,0000,0000,,Жарақат жақсы, ауырсыну басылды.
Dialogue: 0,0:34:04.08,0:34:08.11,CNsub,NTP,0000,0000,0000,,Сондықтан түпнұсқа көшірме жойылып, бүлінген.
Dialogue: 0,0:34:08.67,0:34:13.80,CNsub,NTP,0000,0000,0000,,Қарынға шаншыған кішкентай қылыштың оқиғасы
Dialogue: 0,0:34:14.24,0:34:16.07,CNsub,NTP,0000,0000,0000,,Алайда екі аспан бар.
Dialogue: 0,0:34:18.90,0:34:22.44,CNsub,NTP,0000,0000,0000,,Триггер - қара пауловниямен микроәңгімелесу
Dialogue: 0,0:34:22.60,0:34:23.80,CNsub,NTP,0000,0000,0000,,Жиналыс
Dialogue: 0,0:34:24.50,0:34:28.01,CNsub,NTP,0000,0000,0000,,Натоки Фуджино Икай пышақталды
Dialogue: 0,0:34:28.27,0:34:31.72,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:33.90,0:34:38.68,CNsub,NTP,0000,0000,0000,,Сол кезде ауыруы басылды.
Dialogue: 0,0:34:42.44,0:34:46.24,CNsub,NTP,0000,0000,0000,,Фуджино қайда бара жатыр?
Dialogue: 0,0:34:48.61,0:34:52.92,CNsub,NTP,0000,0000,0000,,Фуджино бұл жолдың идеясы, Суко пышақталды
Dialogue: 0,0:34:54.22,0:34:55.52,CNsub,NTP,0000,0000,0000,,Натайкай Рё
Dialogue: 0,0:34:55.79,0:34:59.00,CNsub,NTP,0000,0000,0000,,Талқылауды қайталау қажет.
Dialogue: 0,0:34:59.15,0:35:00.64,CNsub,NTP,0000,0000,0000,,Инвазивті емес байланыс ауруы
Dialogue: 0,0:35:01.20,0:35:04.18,CNsub,NTP,0000,0000,0000,,Фудзино Янның басы
Dialogue: 0,0:35:22.74,0:35:25.18,CNsub,NTP,0000,0000,0000,,Асагами әңгімесінің соңы
Dialogue: 0,0:35:26.24,0:35:28.96,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:35:30.24,0:35:32.92,CNsub,NTP,0000,0000,0000,,Сіз қанға толы құбыжықсыз.
Dialogue: 0,0:35:33.27,0:35:35.02,CNsub,NTP,0000,0000,0000,,Тұрғылықты жеріндегі кісі өлтіруші
Dialogue: 0,0:35:35.78,0:35:37.43,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:38.47,0:35:40.97,CNsub,NTP,0000,0000,0000,,Мен негізі сіңіп, ләззат алдым.
Dialogue: 0,0:35:41.89,0:35:45.71,CNsub,NTP,0000,0000,0000,,Бұл мемлекеттік тіл: «Үшінші ретті»
Dialogue: 0,0:35:47.20,0:35:49.95,CNsub,NTP,0000,0000,0000,,Мен сені қазір өлтіргім келеді.
Dialogue: 0,0:36:09.14,0:36:14.33,CNsub,NTP,0000,0000,0000,,Мектепке барғың келмесе, оны жіберіп алма.
Dialogue: 0,0:36:36.29,0:36:39.26,CNsub,NTP,0000,0000,0000,,Шындық осы жерден шыққан адам.
Dialogue: 0,0:36:40.59,0:36:45.64,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл менің күшім.
Dialogue: 0,0:36:47.32,0:36:49.61,CNsub,NTP,0000,0000,0000,,Қазіргі емдеуші дәрігер келді.
Dialogue: 0,0:36:50.08,0:36:52.06,CNsub,NTP,0000,0000,0000,,Созылмалы аурит
Dialogue: 0,0:36:52.21,0:36:53.92,CNsub,NTP,0000,0000,0000,,Жалпы атауы: соқырлық
Dialogue: 0,0:36:54.50,0:36:58.19,CNsub,NTP,0000,0000,0000,,Іші ауырса да, кішкентай қылыш жасағандай.
Dialogue: 0,0:36:58.42,0:37:00.09,CNsub,NTP,0000,0000,0000,,Ауырсыну сезімі
Dialogue: 0,0:37:00.68,0:37:02.61,CNsub,NTP,0000,0000,0000,,Бұл кездесу...
Dialogue: 0,0:37:03.09,0:37:06.91,CNsub,NTP,0000,0000,0000,,Түрлері көп болғанымен, нақты өзгеріс жоқ.
Dialogue: 0,0:37:07.22,0:37:12.25,CNsub,NTP,0000,0000,0000,,Кішкентай қылышты қолдануда шек жоқ.
Dialogue: 0,0:37:12.87,0:37:14.88,CNsub,NTP,0000,0000,0000,,Әрекетке қабілетсіз адам
Dialogue: 0,0:37:14.98,0:37:16.69,CNsub,NTP,0000,0000,0000,,Бұл дене емес, ақыл.
Dialogue: 0,0:37:17.30,0:37:21.57,CNsub,NTP,0000,0000,0000,,Ринта жеңілгендіктен, ол қашып құтыла алды.
Dialogue: 0,0:37:22.04,0:37:26.19,CNsub,NTP,0000,0000,0000,,Жау бұл жерді мойындауы керек.
Dialogue: 0,0:37:27.56,0:37:32.29,CNsub,NTP,0000,0000,0000,,Кейбіреулер ережені сақтауым керек дейді...
Dialogue: 0,0:37:32.73,0:37:37.53,CNsub,NTP,0000,0000,0000,,Асахи Фуджиното Асагами Фуджино қаласы – уақыт өтті.
Dialogue: 0,0:37:38.89,0:37:41.02,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:42.76,0:37:45.55,CNsub,NTP,0000,0000,0000,,Өрнек рухани.
Dialogue: 0,0:37:45.77,0:37:48.86,CNsub,NTP,0000,0000,0000,,Фуджино Ассасин бес адамға сөйлесуді тоқтатты - бұл «Ассасин»
Dialogue: 0,0:37:48.95,0:37:51.58,CNsub,NTP,0000,0000,0000,,Осыдан кейін әрекет адамды өлтіру емес, сондықтан ол «кісі өлтіру» болып табылады.
Dialogue: 0,0:37:51.80,0:37:55.07,CNsub,NTP,0000,0000,0000,,Рәсім үлкен атау болуына байланысты.
Dialogue: 0,0:37:58.02,0:38:01.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:38:02.84,0:38:05.77,CNsub,NTP,0000,0000,0000,,Кешіріңіз...көрінбедім...
Dialogue: 0,0:38:15.06,0:38:17.12,CNsub,NTP,0000,0000,0000,,Сіз қиындыққа тап болдыңыз.
Dialogue: 0,0:38:41.28,0:38:43.23,CNsub,NTP,0000,0000,0000,,Өзін-өзі жоғалту——
Dialogue: 0,0:38:46.68,0:38:52.06,CNsub,NTP,0000,0000,0000,,Бұл жарықтың соңы...
Dialogue: 0,0:38:52.88,0:38:54.86,CNsub,NTP,0000,0000,0000,,Егер сіз түсе берсеңіз
Dialogue: 0,0:39:02.56,0:39:05.28,CNsub,NTP,0000,0000,0000,,Таланты сондай біртүрлі
31-бөлім
Dialogue: 0,0:39:09.69,0:39:16.63,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:17.42,0:39:21.06,CNsub,NTP,0000,0000,0000,,Сондықтан Аса но Ками Фуджинонаның жүріс-тұрысында ешқандай айырмашылық жоқ.
Dialogue: 0,0:39:21.74,0:39:26.12,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:27.14,0:39:30.17,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл кезде менің айтатыным физикалық аспект.
Dialogue: 0,0:39:30.40,0:39:33.46,CNsub,NTP,0000,0000,0000,,Перфорация және пластикалық перитонит
Dialogue: 0,0:39:33.86,0:39:38.23,CNsub,NTP,0000,0000,0000,,Бұл он екі саусақтың бірігуі туралы әңгіме.
Dialogue: 0,0:39:39.14,0:39:40.97,CNsub,NTP,0000,0000,0000,,20-шы шығарылымға енді 5 күн болды.
Dialogue: 0,0:39:41.30,0:39:43.14,CNsub,NTP,0000,0000,0000,,Бұрғылауға ерте кірісу
Dialogue: 0,0:39:43.74,0:39:46.78,CNsub,NTP,0000,0000,0000,,Бұл ұят, бірақ өлімге әкеледі.
Dialogue: 0,0:39:47.52,0:39:51.51,CNsub,NTP,0000,0000,0000,,Сол түні сағаттарды санамаған Асагами Фудзино туралы әңгіме...
Dialogue: 0,0:39:51.52,0:39:54.73,CNsub,NTP,0000,0000,0000,,Келесі автор - Фуджино Асагамидің әкесі мен әкесі.
Dialogue: 0,0:39:55.18,0:39:58.26,CNsub,NTP,0000,0000,0000,,Аз уақытта Фудзиноның қабілеттері туралы ойлау
Dialogue: 0,0:39:58.61,0:40:02.69,CNsub,NTP,0000,0000,0000,,Істің қайғылы жағдайы зерттелді.
Dialogue: 0,0:40:02.75,0:40:04.95,CNsub,NTP,0000,0000,0000,,Басқа сөздер: «Мен құбыжықты өлтірдім».
Dialogue: 0,0:40:05.20,0:40:09.30,CNsub,NTP,0000,0000,0000,,Нохоның жалғыз әкесі мен анасының өлімі
Dialogue: 0,0:40:09.71,0:40:12.29,CNsub,NTP,0000,0000,0000,,Жоғарыда айтылғандарды оқығыңыз келсе, бізге хабарласудан тартынбаңыз.
Dialogue: 0,0:40:14.09,0:40:16.05,CNsub,NTP,0000,0000,0000,,Яғни, сіз полиция қызметкерісіз ғой, иә? Не істеп отырсыз өзі?
Dialogue: 0,0:40:26.91,0:40:31.08,CNsub,NTP,0000,0000,0000,,Маған Асагами ұнайды, сен ең жақсысың.
Dialogue: 0,0:40:34.61,0:40:38.25,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:39.60,0:40:44.52,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:51.31,0:40:55.00,CNsub,NTP,0000,0000,0000,,Қалыпты емес
Dialogue: 0,0:41:00.32,0:41:01.29,CNsub,NTP,0000,0000,0000,,Ұсақ-түйек
Dialogue: 0,0:41:11.10,0:41:13.85,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстың жетіспейтін пішіні
Dialogue: 0,0:41:14.50,0:41:16.55,CNsub,NTP,0000,0000,0000,,Дегенмен, түсіру уақыты аяқталды.
Dialogue: 0,0:41:18.13,0:41:20.39,CNsub,NTP,0000,0000,0000,,Бұны көрмегелі көп болды.
Dialogue: 0,0:41:21.02,0:41:24.57,CNsub,NTP,0000,0000,0000,,Сіздің қабілетіңіз жасыл және түрлі-түсті спираль.
Dialogue: 0,0:41:25.42,0:41:28.49,CNsub,NTP,0000,0000,0000,,Шынайы мағына өте құбылмалы
Dialogue: 0,0:41:29.34,0:41:31.61,CNsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:41:32.29,0:41:34.52,CNsub,NTP,0000,0000,0000,,Барлық заттардың капиталының жойылуы
Dialogue: 0,0:41:35.10,0:41:36.84,CNsub,NTP,0000,0000,0000,,Адам класы емес
Dialogue: 0,0:41:37.07,0:41:40.62,CNsub,NTP,0000,0000,0000,,Ерік және қызмет ету уақыты
Dialogue: 0,0:41:41.07,0:41:44.10,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстағы «Өлім».
Dialogue: 0,0:41:44.48,0:41:46.94,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:48.00,0:41:48.92,CNsub,NTP,0000,0000,0000,,Ұсақ-түйек——
Dialogue: 0,0:41:49.45,0:41:56.06,CNsub,NTP,0000,0000,0000,,Себебі, бұл жай ғана аман қалу мәселесі.
Dialogue: 0,0:41:56.40,0:41:58.25,CNsub,NTP,0000,0000,0000,,Ұсақ-түйек
Dialogue: 0,0:41:58.48,0:42:05.76,CNsub,NTP,0000,0000,0000,,Соңғы ән, соңғы ән, соңғы ән...
Dialogue: 0,0:42:15.10,0:42:18.10,CNsub,NTP,0000,0000,0000,,Сіз мені өлтіруіңіз керек...
Dialogue: 0,0:42:19.22,0:42:20.69,CNsub,NTP,0000,0000,0000,,Мені өлтіргің келсе
Dialogue: 0,0:42:20.86,0:42:24.14,CNsub,NTP,0000,0000,0000,,Мен азаптың құрбаны болдым.
Dialogue: 0,0:42:24.57,0:42:26.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:26.71,0:42:29.92,CNsub,NTP,0000,0000,0000,,Ваказэ Нашоның әңгімесі.
Dialogue: 0,0:42:32.34,0:42:34.66,CNsub,NTP,0000,0000,0000,,Натоя қазір қатысуда.
Dialogue: 0,0:42:35.64,0:42:38.42,CNsub,NTP,0000,0000,0000,,Сатып алу бағасы
Dialogue: 0,0:42:39.05,0:42:40.88,CNsub,NTP,0000,0000,0000,,Na...бұл...
Dialogue: 0,0:42:41.02,0:42:43.51,CNsub,NTP,0000,0000,0000,,Келген кезде тек ләззат алу керек.
Dialogue: 0,0:42:43.96,0:42:46.93,CNsub,NTP,0000,0000,0000,,Басқа адамды жарақаттау.
Dialogue: 0,0:42:47.26,0:42:49.59,CNsub,NTP,0000,0000,0000,,Токойна Иташоя мәңгілікке жоғалады
Dialogue: 0,0:42:50.25,0:42:52.87,CNsub,NTP,0000,0000,0000,,Жауабы қандай?
Dialogue: 0,0:42:53.50,0:42:57.94,CNsub,NTP,0000,0000,0000,,Мен сенімен сөйлесемін және мен саған ұқсаймын.
Dialogue: 0,0:43:03.15,0:43:08.89,CNsub,NTP,0000,0000,0000,,Екі рет--! !
Dialogue: 0,0:44:08.62,0:44:09.59,CNsub,NTP,0000,0000,0000,,Еріксіз оқиға…
Dialogue: 0,0:44:10.44,0:44:12.85,CNsub,NTP,0000,0000,0000,,Бұл оқиғаның күйреуі
Dialogue: 0,0:44:40.65,0:44:44.33,CNsub,NTP,0000,0000,0000,,Өзімшілдік... күтпеген өлім
Dialogue: 0,0:44:45.39,0:44:52.73,CNsub,NTP,0000,0000,0000,,Сүйікті ауруы Сүйікті ауруы Сүйікті ауруы Сүйікті ауруы
Dialogue: 0,0:44:55.02,0:44:59.27,CNsub,NTP,0000,0000,0000,,Ойлар мен әрекеттер аяқталды
Dialogue: 0,0:45:00.89,0:45:05.80,CNsub,NTP,0000,0000,0000,,Ой толығырақ
Dialogue: 0,0:45:07.74,0:45:12.40,CNsub,NTP,0000,0000,0000,,Егжей-тегжейлі ойлау
Dialogue: 0,0:45:14.27,0:45:21.14,CNsub,NTP,0000,0000,0000,,Ойлар бұл дүниеде қалды...
Dialogue: 0,0:45:29.87,0:45:35.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:36.38,0:45:46.08,CNsub,NTP,0000,0000,0000,,Қатты ауырсыну Бұл мен үшін жақсы тәжірибе болды және мен жылап алдым.
Dialogue: 0,0:45:47.64,0:45:53.36,CNsub,NTP,0000,0000,0000,,Фуджино Кайи жылап жатыр
Dialogue: 0,0:46:03.36,0:46:04.24,CNsub,NTP,0000,0000,0000,,Азаптау
Dialogue: 0,0:46:08.67,0:46:09.83,CNsub,NTP,0000,0000,0000,,Азапты оқиға
Dialogue: 0,0:46:10.70,0:46:14.58,CNsub,NTP,0000,0000,0000,,Азапты оқиға, жарайсың.
Dialogue: 0,0:46:15.04,0:46:15.80,CNsub,NTP,0000,0000,0000,,Сені жақсы көремін
Dialogue: 0,0:46:47.34,0:46:48.20,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:46:50.11,0:46:53.43,CNsub,NTP,0000,0000,0000,,Мен өзімді осында жүргендей сезінемін
Dialogue: 0,0:46:54.12,0:46:55.84,CNsub,NTP,0000,0000,0000,,Осы жарақатты формуламен көрсетіңіз…
Dialogue: 0,0:46:57.21,0:46:59.29,CNsub,NTP,0000,0000,0000,,Жұмысты аяқтау рәсімі
Dialogue: 0,0:46:59.57,0:47:02.99,CNsub,NTP,0000,0000,0000,,Апельсин, Ная және мөлдір көру қабілетінің капиталының соңғы көрінісі.
Dialogue: 0,0:47:02.99,0:47:04.57,CNsub,NTP,0000,0000,0000,,Кешенді бақылау
21-бөлім
Dialogue: 0,0:47:05.11,0:47:07.49,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:07.54,0:47:10.77,CNsub,NTP,0000,0000,0000,,Көріпкелдік?
Dialogue: 0,0:47:11.13,0:47:15.10,CNsub,NTP,0000,0000,0000,,Көріпкелдік қабілеттерін қалпына келтіруге әрекет жасалмайды.
Dialogue: 0,0:47:15.43,0:47:18.10,CNsub,NTP,0000,0000,0000,,Өкілдің аумақта болуын және өндіріс қабілетін дереу жеткізу.
Dialogue: 0,0:47:18.42,0:47:20.97,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:21.25,0:47:24.54,CNsub,NTP,0000,0000,0000,,Накаяның ауырсыну синдромына соңғы рет оралуы
Dialogue: 0,0:47:24.81,0:47:25.93,CNsub,NTP,0000,0000,0000,,Нағыз екіжүзділік
Dialogue: 0,0:47:26.25,0:47:28.92,CNsub,NTP,0000,0000,0000,,Асагами Фуджиносакудың қолы мен үшін мүмкін емес.
Dialogue: 0,0:47:29.78,0:47:33.05,CNsub,NTP,0000,0000,0000,,Жою әдісі: аурудың тамырын жою жеткілікті
Dialogue: 0,0:47:33.41,0:47:35.66,CNsub,NTP,0000,0000,0000,,Уақытты қажет ететін әңгімелерден босату
Dialogue: 0,0:47:36.34,0:47:40.03,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:40.43,0:47:42.95,CNsub,NTP,0000,0000,0000,,Апельсиндер
Dialogue: 0,0:47:43.55,0:47:46.63,CNsub,NTP,0000,0000,0000,,Жақсы жаңалық.
Dialogue: 0,0:47:47.11,0:47:52.39,CNsub,NTP,0000,0000,0000,,Қартайған бойда ажалдың жын көзін көресің.
Dialogue: 0,0:47:52.64,0:47:56.68,CNsub,NTP,0000,0000,0000,,Сол қолды ұстау және денені қалай ұстау керек.
Dialogue: 0,0:47:58.03,0:47:59.79,CNsub,NTP,0000,0000,0000,,Бұл қате.
Dialogue: 0,0:48:00.85,0:48:02.33,CNsub,NTP,0000,0000,0000,,Жедел жәрдем көлігі бар
Dialogue: 0,0:48:03.20,0:48:05.16,CNsub,NTP,0000,0000,0000,,Наняның шығуы
Dialogue: 0,0:48:05.30,0:48:07.39,CNsub,NTP,0000,0000,0000,,Кездесуді күту
Dialogue: 0,0:48:08.07,0:48:10.72,CNsub,NTP,0000,0000,0000,,Жауапты адам менмін.
Dialogue: 0,0:48:11.17,0:48:14.33,CNsub,NTP,0000,0000,0000,,As a result, I reported that Orange was the first time I left.
Dialogue: 0,0:48:14.44,0:48:17.23,CNsub,NTP,0000,0000,0000,,Бұл жақсы өрнек.
Dialogue: 0,0:48:17.60,0:48:18.71,CNsub,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:48:26.01,0:48:31.04,CNsub,NTP,0000,0000,0000,,Өрнек Өлімнің тағы бір себебі
Dialogue: 0,0:48:42.44,0:48:46.31,CNsub,NTP,0000,0000,0000,,Expression Currently you are unable to reach Asagami Fujinoou
Dialogue: 0,0:48:48.56,0:48:51.64,CNsub,NTP,0000,0000,0000,,Бірінші басылымға деген қызығушылығым жойылды
