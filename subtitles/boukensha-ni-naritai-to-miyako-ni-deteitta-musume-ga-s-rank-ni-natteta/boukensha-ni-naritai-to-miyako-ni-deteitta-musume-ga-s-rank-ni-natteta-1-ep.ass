Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.58,Default,,0,0,0,,Ұстаз... Ауырды...
Dialogue: 0,0:00:06.67,0:00:10.34,Default,,0,0,0,,Маған көмектесші... Мен жалғызбын...
Dialogue: 0,0:00:10.42,0:00:13.30,Default,,0,0,0,,Неге... Неге...
Dialogue: 0,0:00:14.09,0:00:16.80,Default,,0,0,0,,(Шайтанның ырылдауы)
Dialogue: 0,0:00:19.64,0:00:21.14,Default,,0,0,0,,Уаааааа...
Dialogue: 0,0:00:27.98,0:00:29.15,Default,,0,0,0,,Гах ха
Dialogue: 0,0:00:29.98,0:00:31.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:32.15,0:00:37.20,Default,,0,0,0,,Сол кезді 8 жыл өтсе де әлі есіңізде сақтай аласыз ба?
Dialogue: 0,0:00:45.75,0:00:47.92,Default,,0,0,0,,О? Сәлем Белл!
Dialogue: 0,0:00:48.00,0:00:49.67,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:00:49.75,0:00:51.09,Default,,0,0,0,,Қайырлы таң Келли!
Dialogue: 0,0:00:51.17,0:00:55.22,Default,,0,0,0,,Мен пияз егіп жатырмын, маған көмектесе аласыз ба?
Dialogue: 0,0:00:55.30,0:00:57.39,Default,,0,0,0,,Мен мұны ертең жасай аламын ба?
Dialogue: 0,0:00:57.47,0:01:00.35,Default,,0,0,0,,Енді мен сіз сұраған емдік шөптерді алуға барамын.
Dialogue: 0,0:01:00.43,0:01:02.47,Default,,0,0,0,,Сіз де бос емессіз!
Dialogue: 0,0:01:02.56,0:01:04.56,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:01:04.64,0:01:05.77,Default,,0,0,0,,О!
Dialogue: 0,0:01:12.44,0:01:13.44,Default,,0,0,0,,Иә
Dialogue: 0,0:01:15.32,0:01:18.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:19.74,0:01:21.20,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:01:21.28,0:01:22.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:23.70,0:01:25.29,Default,,0,0,0,,Бала дауысы?
Dialogue: 0,0:01:26.21,0:01:28.25,Default,,0,0,0,,Пикси иллюзиясы?
Dialogue: 0,0:01:29.13,0:01:30.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:32.30,0:01:34.51,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:01:34.59,0:01:37.51,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:01:37.59,0:01:39.51,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:01:40.97,0:01:43.10,Default,,0,0,0,,Неге мұндай жерде...
Dialogue: 0,0:01:46.60,0:01:49.02,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:01:51.11,0:01:54.03,Default,,0,0,0,,Уф Ахаха... Ой?
Dialogue: 0,0:01:55.11,0:01:56.99,Default,,0,0,0,,Тұмарлы пішен
Dialogue: 0,0:01:57.65,0:02:00.62,Default,,0,0,0,,Ұнамағандықтан лақтырып жіберген сияқты емес.
Dialogue: 0,0:02:01.62,0:02:03.83,Default,,0,0,0,,Менің таңдауым жоқ...
Dialogue: 0,0:02:08.58,0:02:11.25,Default,,0,0,0,,(ағаш қылыштардың бір-біріне тиген дыбысы)
Dialogue: 0,0:02:11.33,0:02:15.76,Default,,0,0,0,,(Бір-бірімен төбелескен екі адамның дауысы)
Dialogue: 0,0:02:18.93,0:02:20.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:22.39,0:02:23.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:23.51,0:02:27.31,Default,,0,0,0,,Анджелина, сізді анық алшақтық тым көп алдап кетті.
Dialogue: 0,0:02:27.39,0:02:29.98,Default,,0,0,0,,Қарсыласыңыздың қимыл-қозғалысын сәл көбірек болжаңыз
Dialogue: 0,0:02:30.06,0:02:31.56,Default,,0,0,0,,-Бет -Не?
Dialogue: 0,0:02:31.65,0:02:34.40,Default,,0,0,0,,Әкем мені қатты ұрды!
Dialogue: 0,0:02:34.48,0:02:38.24,Default,,0,0,0,,Жоқ, жоқ, бұрыштарды қиюға болмайды...
Dialogue: 0,0:02:39.07,0:02:40.24,Default,,0,0,0,,Құшақтау
Dialogue: 0,0:02:40.32,0:02:42.62,Default,,0,0,0,,- Иә? -Мені құшақтап ал!
Dialogue: 0,0:02:42.70,0:02:43.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:44.03,0:02:48.08,Default,,0,0,0,,Жасы небәрі 12-де болса да, Андж бұзылған бала.
Dialogue: 0,0:02:49.00,0:02:50.21,Default,,0,0,0,,(Ангелиннің тыныс алу дыбысы)
Dialogue: 0,0:02:50.29,0:02:53.79,Default,,0,0,0,,Ха, әкемнің иісі жақсы.
Dialogue: 0,0:02:53.88,0:02:54.96,Default,,0,0,0,,Ахаха
Dialogue: 0,0:02:55.59,0:02:57.88,Default,,0,0,0,,Жарайды, онда кешкі ас әзірлейік.
Dialogue: 0,0:02:57.96,0:02:59.01,Default,,0,0,0,,Иә
Dialogue: 0,0:02:59.97,0:03:04.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:04.10,0:03:06.64,Default,,0,0,0,,Бұл сән-салтанат бүгін жақсы болар еді.
Dialogue: 0,0:03:06.72,0:03:10.02,Default,,0,0,0,,Уау, мен рокберрды жақсы көремін
Dialogue: 0,0:03:11.06,0:03:14.90,Default,,0,0,0,,Ендеше жердің нығметіне шүкіршілік етейік...
Dialogue: 0,0:03:14.98,0:03:17.82,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:03:22.99,0:03:24.66,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:03:24.74,0:03:27.41,Default,,0,0,0,,Жақсы, сенің әкең жасайды.
Dialogue: 0,0:03:28.54,0:03:33.79,Default,,0,0,0,,Мен ертең астанаға барамын, сонда саған көмектесе алмаймын.
Dialogue: 0,0:03:33.88,0:03:35.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:35.54,0:03:38.42,Default,,0,0,0,,Жарайды, мен оны сіз үшін сынап көрейін.
Dialogue: 0,0:03:38.50,0:03:40.84,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:03:43.55,0:03:45.30,Default,,0,0,0,,Содан бері 12 жыл
Dialogue: 0,0:03:45.39,0:03:50.56,Default,,0,0,0,,Мен сияқты авантюрист боламын деп ешқашан ойламаппын.
Dialogue: 0,0:03:51.10,0:03:52.35,Default,,0,0,0,,Әке, бітті~
Dialogue: 0,0:03:52.35,0:03:53.48,Default,,0,0,0,,Әке, бітті~
Dialogue: 0,0:03:52.35,0:03:53.48,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:03:53.48,0:03:53.56,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:03:53.56,0:03:54.40,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:03:53.56,0:03:54.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.48,0:03:55.52,Default,,0,0,0,,-Хьяха -Гуфф
Dialogue: 0,0:03:55.61,0:03:58.52,Default,,0,0,0,,Әй, менің қолым әлі дымқыл.
Dialogue: 0,0:03:58.61,0:04:00.11,Default,,0,0,0,,Тартыңыз
Dialogue: 0,0:04:05.16,0:04:06.62,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:04:06.70,0:04:08.70,Default,,0,0,0,,Жалғыз болсаңыз да бар күшіңізді салыңыз
Dialogue: 0,0:04:08.79,0:04:12.25,Default,,0,0,0,,Сіз әлсіздерді қорғай алатын керемет авантюрист боласыз.
Dialogue: 0,0:04:13.83,0:04:15.25,Default,,0,0,0,,О
Dialogue: 0,0:04:21.92,0:04:26.39,Default,,0,0,0,,Анж авантюристері – өмірі соларға тәуелді адамдар.
Dialogue: 0,0:04:26.47,0:04:28.10,Default,,0,0,0,,Өзіңізді ешқашан мәжбүрлемеңіз
Dialogue: 0,0:04:29.76,0:04:30.60,Default,,0,0,0,,Иә
Dialogue: 0,0:04:31.56,0:04:33.73,Default,,0,0,0,,Олай болса, келіңіз.
Dialogue: 0,0:04:33.81,0:04:36.23,Default,,0,0,0,,А, кеттік!
Dialogue: 0,0:04:39.07,0:04:44.07,Default,,0,0,0,,♪～
Dialogue: 0,0:06:03.65,0:06:08.91,Default,,0,0,0,,～♪
Dialogue: 0,0:06:09.70,0:06:11.45,Default,,0,0,0,,(Уайверннің күркіреуі)
Dialogue: 0,0:06:13.99,0:06:15.45,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:06:15.54,0:06:17.29,Default,,0,0,0,,Бізді әлі қолдамаңыз!
Dialogue: 0,0:06:18.25,0:06:19.50,Default,,0,0,0,,Менің қашып кетуіме жол берме. Мені қу!
Dialogue: 0,0:06:23.59,0:06:26.09,Default,,0,0,0,,Милли, биіктікті төмендетейік.
Dialogue: 0,0:06:26.17,0:06:27.01,Default,,0,0,0,,Иә
Dialogue: 0,0:06:29.38,0:06:30.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:33.72,0:06:34.64,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:06:36.47,0:06:38.52,Default,,0,0,0,,(Виверн ырылдады)
Dialogue: 0,0:06:38.60,0:06:39.89,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:06:50.74,0:06:52.45,Default,,0,0,0,,(Шытырман оқиғалылардың айқайы)
Dialogue: 0,0:06:52.53,0:06:53.95,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:06:54.03,0:06:56.99,Default,,0,0,0,,Wyvern, тіпті AA (Қос А) дәрежесімен де бағындырылуы мүмкін емес
Dialogue: 0,0:06:57.08,0:06:58.58,Default,,0,0,0,,Бір соққыда
Dialogue: 0,0:06:58.66,0:07:00.29,Default,,0,0,0,,Мен бұл қауесетті естідім.
Dialogue: 0,0:07:01.08,0:07:03.08,Default,,0,0,0,,S дәрежелі авантюрист
Dialogue: 0,0:07:03.17,0:07:05.29,Default,,0,0,0,,Қара шашты жауынгер қыз
Dialogue: 0,0:07:05.38,0:07:07.00,Default,,0,0,0,,Анджелина!
Dialogue: 0,0:07:08.13,0:07:10.55,Default,,0,0,0,,Андж, көңіл-күйің жақсы.
Dialogue: 0,0:07:10.63,0:07:13.18,Default,,0,0,0,,Бұл алдағы демалыс шынымен де маңызды ма?
Dialogue: 0,0:07:13.26,0:07:14.97,Default,,0,0,0,,♬~
Dialogue: 0,0:07:15.05,0:07:17.93,Default,,0,0,0,,Мен әкемді бес жылда бірінші рет көріп тұрмын.
Dialogue: 0,0:07:18.02,0:07:22.02,Default,,0,0,0,,Енді мен Орфенге тез оралуым керек және үйге қайтуға дайындалуым керек. Уфуфу...
Dialogue: 0,0:07:22.10,0:07:22.94,Default,,0,0,0,,Ах
Dialogue: 0,0:07:23.86,0:07:24.94,Default,,0,0,0,,-Хехе... -Хехе
Dialogue: 0,0:07:30.49,0:07:32.53,Default,,0,0,0,,Фу Атцу
Dialogue: 0,0:07:32.61,0:07:34.53,Default,,0,0,0,,Сіз не істеп жатырсыз? Мистер Белл
Dialogue: 0,0:07:34.62,0:07:35.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.53,0:07:38.24,Default,,0,0,0,,Арамшөптерді жою дегенді қалай түсінесіңдер?
Dialogue: 0,0:07:38.33,0:07:41.21,Default,,0,0,0,,Бұл менің жұмысымнан айырылатынымды білдіреді.
Dialogue: 0,0:07:41.29,0:07:43.62,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:07:43.71,0:07:46.29,Default,,0,0,0,,Одан гөрі әкем шақырып жатыр.
Dialogue: 0,0:07:46.38,0:07:47.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:47.84,0:07:50.21,Default,,0,0,0,,Саяхатшы жеткізген
Dialogue: 0,0:07:50.30,0:07:52.76,Default,,0,0,0,,Сізге Анжерстің хаты.
Dialogue: 0,0:07:52.84,0:07:54.14,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:54.22,0:07:57.81,Default,,0,0,0,,Ендеше, менің егістік жерімде шөп шабатын болдыңыз ғой?
Dialogue: 0,0:07:57.89,0:08:02.64,Default,,0,0,0,,Мен сендерге құбыжықтарды жоюды, тау жұмыстарын орындауды, тіпті балаларды оқытуды тапсырамын.
Dialogue: 0,0:08:02.73,0:08:04.65,Default,,0,0,0,,Барлығыңызға рахмет... Ах
Dialogue: 0,0:08:04.73,0:08:07.48,Default,,0,0,0,,А, мен түсіндім. Тез оқы.
Dialogue: 0,0:08:07.57,0:08:08.73,Default,,0,0,0,,О
Dialogue: 0,0:08:17.70,0:08:19.41,Default,,0,0,0,,Андж, қалыңыз қалай?
Dialogue: 0,0:08:19.49,0:08:22.75,Default,,0,0,0,,Ұзақ демалыстан кейін қайтып келе жатқан сияқты.
Dialogue: 0,0:08:22.83,0:08:25.67,Default,,0,0,0,,О, бұл қиын.
Dialogue: 0,0:08:25.75,0:08:28.38,Default,,0,0,0,,Мен сізге үлкен қонақжайлық көрсетуім керек.
Dialogue: 0,0:08:28.46,0:08:31.05,Default,,0,0,0,,Анге Бұл S дәрежесі, солай ма?
Dialogue: 0,0:08:31.13,0:08:32.38,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:08:32.47,0:08:37.60,Default,,0,0,0,,Аа, ол Жетімдер авантюристі гильдиясында бірінші орында тұрған сияқты.
Dialogue: 0,0:08:37.68,0:08:39.47,Default,,0,0,0,,Мен қызымды мақтан тұтамын.
Dialogue: 0,0:08:41.31,0:08:43.48,Default,,0,0,0,,5 жыл болды ма?
Dialogue: 0,0:08:44.60,0:08:46.31,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:08:47.56,0:08:50.48,Default,,0,0,0,,Мен үйге бара аламын~ Мен үйге бара аламын~
Dialogue: 0,0:08:50.57,0:08:53.99,Default,,0,0,0,,Сіз өзіңіздің сүйікті әкеңізді кездестіре аласыз~
Dialogue: 0,0:08:54.07,0:08:57.20,Default,,0,0,0,,Әкеңді қаншалықты жақсы көресің деп ойлаймын.
Dialogue: 0,0:08:57.28,0:08:59.49,Default,,0,0,0,,Иә, күтпеген нәрсе.
Dialogue: 0,0:09:00.24,0:09:02.20,Default,,0,0,0,,Екеуің шынымен келмейсіңдер ме?
Dialogue: 0,0:09:02.29,0:09:06.42,Default,,0,0,0,,Басқа тараптармен уақытша ынтымақтаса отырып, не істейміз?
Dialogue: 0,0:09:06.50,0:09:08.38,Default,,0,0,0,,Андждың демалысының шарттары
Dialogue: 0,0:09:08.46,0:09:12.55,Default,,0,0,0,,Маған Андждың әкесі қандай адам екені қызық.
Dialogue: 0,0:09:12.63,0:09:18.05,Default,,0,0,0,,Әй, мейірімді, күшті, салқын, мақтаншақ әке.
Dialogue: 0,0:09:18.14,0:09:21.68,Default,,0,0,0,,Сен мықты болсаң, әкең де авантюрист дегенді білдіре ме?
Dialogue: 0,0:09:21.76,0:09:23.89,Default,,0,0,0,,Иә, бұл түпнұсқа болса да.
Dialogue: 0,0:09:23.98,0:09:27.98,Default,,0,0,0,,Мен қылышымды және авантюрист болуды әкемнен үйрендім.
Dialogue: 0,0:09:28.06,0:09:29.31,Default,,0,0,0,,О...
Dialogue: 0,0:09:30.44,0:09:34.07,Default,,0,0,0,,Бірақ мен әкемді әлі бір қылышпен ұрған жоқпын.
Dialogue: 0,0:09:34.15,0:09:36.28,Default,,0,0,0,,Не, Андж?
Dialogue: 0,0:09:36.36,0:09:37.82,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:09:37.91,0:09:41.99,Default,,0,0,0,,Иә, керемет! Менің әкем өте керемет!
Dialogue: 0,0:09:41.99,0:09:42.41,Default,,0,0,0,,Иә, керемет! Менің әкем керемет!
Dialogue: 0,0:09:42.49,0:09:43.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.79,0:09:46.37,Default,,0,0,0,,Иә... Сәлем Андж.
Dialogue: 0,0:09:46.37,0:09:47.21,Default,,0,0,0,,Иә... Сәлем Андж.
Dialogue: 0,0:09:46.37,0:09:47.21,Default,,0,0,0,,Ах, Лионель-сан.
Dialogue: 0,0:09:47.21,0:09:48.12,Default,,0,0,0,,Ах, Лионель-сан.
Dialogue: 0,0:09:48.12,0:09:49.25,Default,,0,0,0,,Ах, Лионель-сан.
Dialogue: 0,0:09:48.12,0:09:49.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:49.33,0:09:52.21,Default,,0,0,0,,Неліктен гильдия шебері осында?
Dialogue: 0,0:09:52.30,0:09:55.63,Default,,0,0,0,,Негізінде... Астеринос қаласында.
Dialogue: 0,0:09:55.72,0:09:58.88,Default,,0,0,0,,Гиганттар тобы мен патшайым пайда болады...
Dialogue: 0,0:09:58.97,0:10:02.31,Default,,0,0,0,,Мен демалысымды алып қойдым, мен Торнеллаға қайтамын!
Dialogue: 0,0:10:02.39,0:10:04.14,Default,,0,0,0,,Еңкей!
Dialogue: 0,0:10:05.56,0:10:09.90,Default,,0,0,0,,Кейбір адамдар қайтыс болды, сондықтан көмектесіңізші!
Dialogue: 0,0:10:09.98,0:10:12.90,Default,,0,0,0,,Гуннуну...
Dialogue: 0,0:10:12.98,0:10:16.57,Default,,0,0,0,,Бармасақ, Астеринос жойылады.
Dialogue: 0,0:10:16.65,0:10:19.53,Default,,0,0,0,,Өкінішке орай, бұл жолы...
Dialogue: 0,0:10:19.61,0:10:23.03,Default,,0,0,0,,Гуааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:10:23.12,0:10:27.12,Default,,0,0,0,,(Гиганттардың айқайы)
Dialogue: 0,0:10:30.75,0:10:33.54,Default,,0,0,0,,(Барабан соғу дыбысы)
Dialogue: 0,0:10:34.59,0:10:36.09,Default,,0,0,0,,Олардың бәрін өлтіріңіз!
Dialogue: 0,0:10:41.72,0:10:42.55,Default,,0,0,0,,Ах
Dialogue: 0,0:10:46.14,0:10:48.56,Default,,0,0,0,,Анге! О?
Dialogue: 0,0:10:49.69,0:10:52.31,Default,,0,0,0,,Бұл Бергриф мырзаның үйі ме?
Dialogue: 0,0:10:52.40,0:10:55.32,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:10:55.40,0:10:58.74,Default,,0,0,0,,Мен Анджелинадан хат алдым.
Dialogue: 0,0:10:58.82,0:11:01.91,Default,,0,0,0,,Ах... көп рахмет
Dialogue: 0,0:11:06.62,0:11:07.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.16,0:11:13.08,Default,,0,0,0,,Мен көремін. Сізге шұғыл өтініш келді ме?
Dialogue: 0,0:11:15.88,0:11:18.71,Default,,0,0,0,,Мен сенімен жақын арада кездескім келеді...
Dialogue: 0,0:11:23.14,0:11:25.39,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:11:25.47,0:11:27.35,Default,,0,0,0,,(Гигант патшайымның айқайы)
Dialogue: 0,0:11:27.43,0:11:29.77,Default,,0,0,0,,Бұл дөрекі, Андж.
Dialogue: 0,0:11:29.85,0:11:33.35,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын. Олар менің демалысымды тағы ұрлады.
Dialogue: 0,0:11:36.19,0:11:40.11,Default,,0,0,0,,Ха ха ха ха ах...
Dialogue: 0,0:11:41.11,0:11:44.16,Default,,0,0,0,,Мен тезірек әкеммен кездескім келеді.
Dialogue: 0,0:11:51.79,0:11:53.92,Default,,0,0,0,,Бұл таңқаларлық жылдам.
Dialogue: 0,0:11:54.00,0:11:56.67,Default,,0,0,0,,Мен осыншама көп сұрауларды орындай аламын деп ешқашан ойламадым.
Dialogue: 0,0:11:56.75,0:11:59.21,Default,,0,0,0,,Үйге тез қайтқың келді.
Dialogue: 0,0:11:59.30,0:12:00.76,Default,,0,0,0,,Анджелина
Dialogue: 0,0:12:00.84,0:12:02.68,Default,,0,0,0,,Хахаха хахаха...
Dialogue: 0,0:12:07.51,0:12:12.94,Default,,0,0,0,,(Анджелинаның гуілдеуі)
Dialogue: 0,0:12:13.02,0:12:15.02,Default,,0,0,0,,Көңіл-күйіңіз жақсы.
Dialogue: 0,0:12:15.10,0:12:17.57,Default,,0,0,0,,Жүгіңізге қарап, үйге барасыз ба?
Dialogue: 0,0:12:17.65,0:12:20.07,Default,,0,0,0,,Иә, мен үйге бара аламын.
Dialogue: 0,0:12:20.15,0:12:23.32,Default,,0,0,0,,Менің Орфеннен кеткеніме бір аптаға жуықтап қалды.
Dialogue: 0,0:12:23.40,0:12:26.78,Default,,0,0,0,,Демалысымда мен одан тауарымды алып жүруін өтіндім.
Dialogue: 0,0:12:26.87,0:12:28.20,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:28.28,0:12:29.74,Default,,0,0,0,,Маңызды емес
Dialogue: 0,0:12:29.83,0:12:32.04,Default,,0,0,0,,Шұғыл жұмысқа байланысты кейінге қалдыруға тура келді.
Dialogue: 0,0:12:32.12,0:12:34.04,Default,,0,0,0,,Ақыры мен әкемді кездестіре аламын.
Dialogue: 0,0:12:34.12,0:12:37.04,Default,,0,0,0,,Сенің әкеңнің де бақытты болатынына сенімдімін.
Dialogue: 0,0:12:37.13,0:12:39.34,Default,,0,0,0,,Сәлем менің әкем
Dialogue: 0,0:12:39.42,0:12:41.63,Default,,0,0,0,,«Қызыл жын белглифі» деп аталады.
Dialogue: 0,0:12:41.71,0:12:42.72,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:12:42.80,0:12:46.18,Default,,0,0,0,,Мен мұны білмеймін, өйткені мен білімсізмін, бірақ оны есімде сақтаймын.
Dialogue: 0,0:12:46.26,0:12:50.72,Default,,0,0,0,,Тек өте белсенді авантюристтің екі аты болуы мүмкін.
Dialogue: 0,0:12:50.81,0:12:52.93,Default,,0,0,0,,Менің ойымша, ол жасырын талант.
Dialogue: 0,0:12:53.02,0:12:57.69,Default,,0,0,0,,Иә, мақтаншақ әке, бұл Белглиф Қызыл жын.
Dialogue: 0,0:12:59.52,0:13:03.94,Default,,0,0,0,,Бұл қызыл жын Бергриф мырза. Хехе, керемет көрінеді...
Dialogue: 0,0:13:04.03,0:13:04.65,Default,,0,0,0,,Иә
Dialogue: 0,0:13:04.65,0:13:05.28,Default,,0,0,0,,Иә
Dialogue: 0,0:13:04.65,0:13:05.28,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:05.28,0:13:05.36,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:05.36,0:13:06.20,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:13:05.36,0:13:06.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:08.78,0:13:10.87,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:13:10.95,0:13:12.37,Default,,0,0,0,,- (Қызметші) Уау! -Ха!
Dialogue: 0,0:13:12.45,0:13:14.46,Default,,0,0,0,,Уф, уф...
Dialogue: 0,0:13:14.54,0:13:15.87,Default,,0,0,0,,Хехе...
Dialogue: 0,0:13:15.96,0:13:18.79,Default,,0,0,0,,Өтінемін, мені жіберіңізші.
Dialogue: 0,0:13:18.88,0:13:21.42,Default,,0,0,0,,Менің төтенше жағдайларым бар...
Dialogue: 0,0:13:21.50,0:13:22.38,Default,,0,0,0,,Не?
Dialogue: 0,0:13:23.01,0:13:25.80,Default,,0,0,0,,Өлгілерің келмесе
Dialogue: 0,0:13:25.88,0:13:27.89,Default,,0,0,0,,Сол баланы тастап кет.
Dialogue: 0,0:13:27.97,0:13:31.18,Default,,0,0,0,,Ха, мұнда қанша адам барын көрмейсің бе?
Dialogue: 0,0:13:31.26,0:13:32.97,Default,,0,0,0,,Бір адаммен не істеуге болады...
Dialogue: 0,0:13:33.06,0:13:34.64,Default,,0,0,0,,-Хсу-сан-(Ұры) Иә?
Dialogue: 0,0:13:34.73,0:13:36.94,Default,,0,0,0,,Балалар сендер үшін
Dialogue: 0,0:13:38.02,0:13:40.65,Default,,0,0,0,,Әкемен кездесу уақыты қысқарды
Dialogue: 0,0:13:40.73,0:13:41.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:41.98,0:13:44.28,Default,,0,0,0,,Уф, не? Бұл жігіт
Dialogue: 0,0:13:44.86,0:13:47.99,Default,,0,0,0,,Балалар, мен сендерді ешқашан кешірмеймін!
Dialogue: 0,0:13:48.07,0:13:50.45,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:13:50.53,0:13:53.37,Default,,0,0,0,,(Ұрылардың айқайы)
Dialogue: 0,0:13:54.50,0:13:56.91,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:13:57.00,0:13:58.79,Default,,0,0,0,,Рахмет... Амансыңдар деп үміттенемін!
Dialogue: 0,0:13:58.87,0:14:02.38,Default,,0,0,0,,А, мына балаларға ұрылар шабуыл жасады.
Dialogue: 0,0:14:02.46,0:14:04.17,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:14:04.26,0:14:07.51,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:14:07.59,0:14:11.68,Default,,0,0,0,,Менің атым Серен, мен Бордо отбасының үшінші қызымын.
Dialogue: 0,0:14:11.76,0:14:14.93,Default,,0,0,0,,Иә! Граф Бордоның қызы!?
Dialogue: 0,0:14:15.02,0:14:17.14,Default,,0,0,0,,Бірақ мұндай ұлы тұлға болса
Dialogue: 0,0:14:17.23,0:14:19.02,Default,,0,0,0,,Күзетшілер көбірек болуы керек.
Dialogue: 0,0:14:19.10,0:14:21.94,Default,,0,0,0,,Ауылды аралап тексеріп жүрдім.
Dialogue: 0,0:14:22.02,0:14:25.48,Default,,0,0,0,,Мен кенеттен әкемнің құлап, ауыр халде жатқаны туралы хабар алдым.
Dialogue: 0,0:14:25.57,0:14:30.03,Default,,0,0,0,,Асыққанда, бар болғандар ғана жүйрік аттарды мініп жатты.
Dialogue: 0,0:14:30.11,0:14:33.03,Default,,0,0,0,,А... әкемді көру үшін.
Dialogue: 0,0:14:33.12,0:14:36.58,Default,,0,0,0,,Бірақ мен де атымды жоғалттым.
Dialogue: 0,0:14:36.66,0:14:40.79,Default,,0,0,0,,Жаяу жүрсеңіз, Бордоға жетуге төрт күннен артық уақыт кетеді.
Dialogue: 0,0:14:40.87,0:14:42.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:43.38,0:14:46.30,Default,,0,0,0,,Мен уақытында үлгермейтініме сенімдімін
Dialogue: 0,0:14:46.38,0:14:47.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:47.88,0:14:52.68,Default,,0,0,0,,Бірақ сіз өз өміріңізді сақтап қалуды ғана қалайсыз...
Dialogue: 0,0:14:53.80,0:14:55.56,Default,,0,0,0,,Бұл да тағдыр деп ойлаймын.
Dialogue: 0,0:14:56.14,0:14:57.81,Default,,0,0,0,,-Не айтып тұрсың! -Ах
Dialogue: 0,0:14:57.89,0:14:59.98,Default,,0,0,0,,Сіз маңызды әкесіз, солай емес пе?
Dialogue: 0,0:15:00.06,0:15:02.06,Default,,0,0,0,,Тағдыр деп жай айтпа!
Dialogue: 0,0:15:02.15,0:15:05.07,Default,,0,0,0,,Әй, Анджелина-сама...
Dialogue: 0,0:15:05.15,0:15:07.23,Default,,0,0,0,,Дереу Бордоға оралыңыз
Dialogue: 0,0:15:07.32,0:15:09.32,Default,,0,0,0,,О, бірақ... бірақ
Dialogue: 0,0:15:09.86,0:15:11.74,Default,,0,0,0,,Анджелина, әкеңе...
Dialogue: 0,0:15:11.82,0:15:14.41,Default,,0,0,0,,Мен бұл балаға науқас әкесін көрсетуім керек.
Dialogue: 0,0:15:14.49,0:15:15.33,Default,,0,0,0,,Ах
Dialogue: 0,0:15:15.41,0:15:18.37,Default,,0,0,0,,Өнімнің бағасын және еңбек ақысын төлеймін.
Dialogue: 0,0:15:18.45,0:15:20.37,Default,,0,0,0,,Неге мұны әкелдің?
Dialogue: 0,0:15:22.21,0:15:24.88,Default,,0,0,0,,Мініңіз, мен ұшамын.
Dialogue: 0,0:15:24.96,0:15:26.05,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.75,0:15:27.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:28.88,0:15:31.38,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:15:34.09,0:15:35.14,Default,,0,0,0,,Кешіріңіз, әке.
Dialogue: 0,0:15:35.22,0:15:36.10,Default,,0,0,0,,(Селеннің жылағаны)
Dialogue: 0,0:15:36.10,0:15:37.31,Default,,0,0,0,,(Селенаның жылағаны)
Dialogue: 0,0:15:36.10,0:15:37.31,Default,,0,0,0,,Бірақ келесі жолы мен міндетті түрде үйге барамын.
Dialogue: 0,0:15:37.31,0:15:39.06,Default,,0,0,0,,Бірақ келесі жолы мен міндетті түрде үйге барамын.
Dialogue: 0,0:15:44.65,0:15:49.61,Default,,0,0,0,,Түсініп тұрмын, сенің әрекетің осы...
Dialogue: 0,0:15:49.69,0:15:51.20,Default,,0,0,0,,Белл ағай
Dialogue: 0,0:15:51.28,0:15:53.11,Default,,0,0,0,,Тезірек тауға барайық!
Dialogue: 0,0:15:53.20,0:15:54.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:55.57,0:15:57.58,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:15:57.66,0:16:01.62,Default,,0,0,0,,Кешіріңіз, бұл балалар мені асығып жатыр.
Dialogue: 0,0:16:01.71,0:16:05.88,Default,,0,0,0,,Ахаха мен бірден дайындаламын, күте тұрыңыз.
Dialogue: 0,0:16:05.96,0:16:11.38,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:16:11.47,0:16:14.80,Default,,0,0,0,,Мұнда бәрі көңіл көтеру үшін келмеген.
Dialogue: 0,0:16:14.89,0:16:17.01,Default,,0,0,0,,Айналаңызға назар аударыңыз
Dialogue: 0,0:16:17.10,0:16:18.64,Default,,0,0,0,,- (Пит) Иә! -(Балалар) Иә.
Dialogue: 0,0:16:18.72,0:16:21.02,Default,,0,0,0,,Пит, жағдай қалай?
Dialogue: 0,0:16:21.64,0:16:24.14,Default,,0,0,0,,Қарап қана қоймай, бес сезіміңізді пайдаланыңыз
Dialogue: 0,0:16:25.31,0:16:29.57,Default,,0,0,0,,Желде тербелген ағаштар, аққан судың дыбысы және...
Dialogue: 0,0:16:29.65,0:16:30.57,Default,,0,0,0,,(Шымтезек иіскеген дыбыс)
Dialogue: 0,0:16:30.65,0:16:34.15,Default,,0,0,0,,Жүрегімді жібітетін сергітетін иіс бар...
Dialogue: 0,0:16:34.24,0:16:37.24,Default,,0,0,0,,Бұл Онибамизеридің иісі.
Dialogue: 0,0:16:37.32,0:16:40.54,Default,,0,0,0,,Бұл шөп тек суы таза жерде өседі.
Dialogue: 0,0:16:41.25,0:16:43.41,Default,,0,0,0,,Бұл жақын жерде су бар екенін білдіреді.
Dialogue: 0,0:16:43.50,0:16:45.33,Default,,0,0,0,,Я~
Dialogue: 0,0:16:45.42,0:16:47.67,Default,,0,0,0,,Жарайды, су тесігін іздейік.
Dialogue: 0,0:16:47.75,0:16:51.63,Default,,0,0,0,,Бірақ бұған назар аудармаңыз
Dialogue: 0,0:16:51.71,0:16:55.22,Default,,0,0,0,,Кез келген уақытта аңға немесе жынға тап болмас еді.
Dialogue: 0,0:16:55.30,0:16:56.43,Default,,0,0,0,,- (Пит) Иә! -(Балалар) Иә.
Dialogue: 0,0:17:01.01,0:17:04.18,Default,,0,0,0,,Жарайды, бәріміз Онибамисери жинап алайық.
Dialogue: 0,0:17:04.27,0:17:07.10,Default,,0,0,0,,Бірақ тым алысқа бармаңыз
Dialogue: 0,0:17:07.19,0:17:08.19,Default,,0,0,0,,- (Пит) Иә! -(Балалар) Иә.
Dialogue: 0,0:17:08.27,0:17:12.69,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:17:13.32,0:17:17.53,Default,,0,0,0,,Қазір ойлап қарасам, мен мұнда Энджмен бірге келетінмін.
Dialogue: 0,0:17:17.61,0:17:20.41,Default,,0,0,0,,Бір рет үйретсең, есіңде қалатын бала еді.
Dialogue: 0,0:17:21.24,0:17:23.54,Default,,0,0,0,,Әке, бұл солай емес пе?
Dialogue: 0,0:17:23.62,0:17:25.96,Default,,0,0,0,,Иә, жақсы таптыңыз.
Dialogue: 0,0:17:26.04,0:17:27.75,Default,,0,0,0,,Эххе
Dialogue: 0,0:17:27.83,0:17:30.71,Default,,0,0,0,,Бұл баланың жоғары сіңіру қабілеті ғана емес.
Dialogue: 0,0:17:30.79,0:17:32.30,Default,,0,0,0,,Олай болмаған сияқты...
Dialogue: 0,0:17:32.88,0:17:35.42,Default,,0,0,0,,Оның S дәрежесі болатыны мағынасы бар.
Dialogue: 0,0:17:35.51,0:17:39.39,Default,,0,0,0,,Онымен салыстырғанда мен оқудан шығып қалдым.
Dialogue: 0,0:17:40.68,0:17:42.39,Default,,0,0,0,,Мен де...
Dialogue: 0,0:17:42.47,0:17:46.14,Default,,0,0,0,,А, жоқ, мен Торнеллаға қайтуым керек.
Dialogue: 0,0:17:46.23,0:17:48.15,Default,,0,0,0,,Мен Анджды ешқашан көрмедім.
Dialogue: 0,0:17:48.73,0:17:51.57,Default,,0,0,0,,Иә, мен бұған рұқсат беруім керек.
Dialogue: 0,0:17:51.65,0:17:52.32,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:52.32,0:17:53.15,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:52.32,0:17:53.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:53.23,0:17:54.03,Default,,0,0,0,,Ах
Dialogue: 0,0:17:54.03,0:17:54.94,Default,,0,0,0,,Ах
Dialogue: 0,0:17:54.03,0:17:54.94,Default,,0,0,0,,(Линустың айқайы)
Dialogue: 0,0:17:54.94,0:17:55.03,Default,,0,0,0,,(Линустың айқайы)
Dialogue: 0,0:17:55.03,0:17:56.65,Default,,0,0,0,,(Линустың айқайы)
Dialogue: 0,0:17:55.03,0:17:56.65,Default,,0,0,0,,О, бұл жаман!
Dialogue: 0,0:17:56.74,0:17:59.16,Default,,0,0,0,,-(Пит) Уф -Уау!
Dialogue: 0,0:18:01.45,0:18:02.28,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:04.87,0:18:07.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:09.54,0:18:10.96,Default,,0,0,0,,Артында қалуым керек пе? Менің де, Жосукенің де?
Dialogue: 0,0:18:11.04,0:18:12.29,Default,,0,0,0,,Белл ағай!?
Dialogue: 0,0:18:12.38,0:18:13.46,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:18:13.55,0:18:16.17,Default,,0,0,0,,Ахаха, бұл керемет.
Dialogue: 0,0:18:16.26,0:18:20.18,Default,,0,0,0,,Анжердің бұған жол бермейтініне сенімдімін.
Dialogue: 0,0:18:22.01,0:18:25.68,Default,,0,0,0,,Ооо...
Dialogue: 0,0:18:25.77,0:18:28.02,Default,,0,0,0,,Мен өзімді күйзеліске ұшырадым.
Dialogue: 0,0:18:28.10,0:18:29.44,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:18:29.52,0:18:32.86,Default,,0,0,0,,Келесі ұзақ демалысыңызға дейін көбірек жұмыс істеңіз
Dialogue: 0,0:18:32.94,0:18:35.57,Default,,0,0,0,,Гильдияға ешқашан шағымданбаңыз!
Dialogue: 0,0:18:35.65,0:18:37.82,Default,,0,0,0,,Эй, егер сіз күйзеліске ұшырасаңыз.
Dialogue: 0,0:18:37.90,0:18:41.45,Default,,0,0,0,,Жақсы жер бар. Неге бәріміз бармаймыз?
Dialogue: 0,0:18:41.53,0:18:42.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:45.54,0:18:46.91,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:47.00,0:18:48.25,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:48.33,0:18:51.46,Default,,0,0,0,,Мынау... сіз мұның бәрін жей аласыз ба?
Dialogue: 0,0:18:54.04,0:18:56.21,Default,,0,0,0,,Хмм, дәмді
Dialogue: 0,0:18:56.30,0:18:59.97,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:19:00.05,0:19:03.22,Default,,0,0,0,,Тым тәтті емес, тым ащы емес
Dialogue: 0,0:19:03.30,0:19:05.89,Default,,0,0,0,,Хмм эй эй
Dialogue: 0,0:19:05.97,0:19:07.39,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:19:07.47,0:19:09.94,Default,,0,0,0,,-Бұл сөзсіз жақсы. -Ах.
Dialogue: 0,0:19:10.02,0:19:12.31,Default,,0,0,0,,Арне, егер оны жегің келмесе, маған бер.
Dialogue: 0,0:19:12.40,0:19:14.61,Default,,0,0,0,,Жоқ, бұл менікі.
Dialogue: 0,0:19:15.40,0:19:18.11,Default,,0,0,0,,Мен де әкемді тамақтандырғым келеді.
Dialogue: 0,0:19:18.19,0:19:20.49,Default,,0,0,0,,Өткен жолы көңілім қалды.
Dialogue: 0,0:19:20.57,0:19:23.12,Default,,0,0,0,,Сонда үйге бара алмадың ба?
Dialogue: 0,0:19:23.20,0:19:27.49,Default,,0,0,0,,Иә, келесіде қашан демалысқа шыға аламын?
Dialogue: 0,0:19:27.58,0:19:32.12,Default,,0,0,0,,Бірақ сіз құтқарған адам Бордо графының қызы еді, солай ма?
Dialogue: 0,0:19:32.21,0:19:34.38,Default,,0,0,0,,Иә, солай сияқты
Dialogue: 0,0:19:34.46,0:19:38.34,Default,,0,0,0,,Ол солтүстік аймақтың, соның ішінде Торнелланың қожасы емес пе?
Dialogue: 0,0:19:38.42,0:19:41.76,Default,,0,0,0,,Күшті ақсүйектермен қосыла алатыныңыз ғажап.
Dialogue: 0,0:19:42.63,0:19:45.64,Default,,0,0,0,,Мен мұндай нәрселерге қызықпаймын.
Dialogue: 0,0:19:45.72,0:19:49.52,Default,,0,0,0,,Бірақ мен Сереннің әкесімен танысқанына қуаныштымын.
Dialogue: 0,0:19:49.60,0:19:51.39,Default,,0,0,0,,-Hmph -Мен түсінемін.
Dialogue: 0,0:19:52.10,0:19:55.52,Default,,0,0,0,,Жақсы, келесі жолы міндетті түрде қайтамын.
Dialogue: 0,0:19:55.61,0:19:58.11,Default,,0,0,0,,Сұраныстарды қазіргі қарқыныммен орындай берсем.
Dialogue: 0,0:19:58.19,0:20:02.49,Default,,0,0,0,,Гильдия келесі ұзақ демалыс туралы өтінішіңізді қабылдамайды.
Dialogue: 0,0:20:02.57,0:20:04.03,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:20:04.11,0:20:07.20,Default,,0,0,0,,Бірақ мен үнемі өтініштерді орындадым.
Dialogue: 0,0:20:07.28,0:20:10.16,Default,,0,0,0,,Ақша өсе береді, солай емес пе?
Dialogue: 0,0:20:10.25,0:20:11.83,Default,,0,0,0,,Егер оның пайдасы болмаса
Dialogue: 0,0:20:11.91,0:20:14.96,Default,,0,0,0,,Біразын балалар үйіне берген дұрыс болар.
Dialogue: 0,0:20:15.04,0:20:18.42,Default,,0,0,0,,Иә, апа, мен бақытты боламын.
Dialogue: 0,0:20:18.50,0:20:20.42,Default,,0,0,0,,Мм, балалар үйі?
Dialogue: 0,0:20:20.51,0:20:22.88,Default,,0,0,0,,Өйткені біз балалар үйінде өстік
Dialogue: 0,0:20:22.97,0:20:25.89,Default,,0,0,0,,Әпке сенің анаң болған.
Dialogue: 0,0:20:25.97,0:20:28.68,Default,,0,0,0,,Сондықтан әкем жоқ еді.
Dialogue: 0,0:20:28.76,0:20:31.43,Default,,0,0,0,,Мен бірінші рет білемін
Dialogue: 0,0:20:31.52,0:20:34.19,Default,,0,0,0,,Жеке әңгіме Мен мүлде сөйлеспедім.
Dialogue: 0,0:20:34.27,0:20:36.56,Default,,0,0,0,,Не болды саған? Біраз қақтығысқыш болып тұрсың ғой?
Dialogue: 0,0:20:36.65,0:20:40.69,Default,,0,0,0,,Бұл әрқашан құбыжықтар мен авантюристер туралы әңгімелер болды.
Dialogue: 0,0:20:41.57,0:20:43.45,Default,,0,0,0,,Мен тастанды баламын
Dialogue: 0,0:20:43.53,0:20:45.95,Default,,0,0,0,,Әкем таудан теріп алды.
Dialogue: 0,0:20:46.87,0:20:48.78,Default,,0,0,0,,- Иә? -Уау~
Dialogue: 0,0:20:48.87,0:20:51.83,Default,,0,0,0,,Бұл не? Бұл не? Толығырақ айтыңызшы.
Dialogue: 0,0:20:54.71,0:20:56.25,Default,,0,0,0,,«Әкеме»
Dialogue: 0,0:20:56.33,0:20:59.04,Default,,0,0,0,,«Мен үйге тез келе алмағаным үшін кешірім сұраймын».
Dialogue: 0,0:20:59.75,0:21:03.76,Default,,0,0,0,,«Мен S дәрежесіне жеткеннен кейін бірінші рет партия құрдым».
Dialogue: 0,0:21:04.42,0:21:08.18,Default,,0,0,0,,«Алғашында мен достарыммен бірге төбелесуден абдырап қалдым».
Dialogue: 0,0:21:08.26,0:21:10.26,Default,,0,0,0,,«Мен өзімді қазір өте сенімді сезінемін».
Dialogue: 0,0:21:11.26,0:21:13.77,Default,,0,0,0,,«Анесса - ең ескі және өте байсалды».
Dialogue: 0,0:21:14.64,0:21:17.77,Default,,0,0,0,,«Оның садақ тарту шеберлігі бар».
Dialogue: 0,0:21:18.56,0:21:21.78,Default,,0,0,0,,«Ол сондай-ақ сұраулар бойынша қиын келіссөздермен айналысады».
Dialogue: 0,0:21:22.40,0:21:27.28,Default,,0,0,0,,«Мириам - менен жақсырақ сиқыршы және найзағай сиқырына шебер».
Dialogue: 0,0:21:27.36,0:21:31.45,Default,,0,0,0,,«Ол менен қарағанда қысқа, бірақ кеуделері үлкенірек».
Dialogue: 0,0:21:31.54,0:21:35.79,Default,,0,0,0,,«Бұл қынжылтады, бірақ мен өсу кезеңінде болғандықтан, болашағыма үлкен үміт артамын».
Dialogue: 0,0:21:37.25,0:21:40.59,Default,,0,0,0,,«Бірақ бұл әріп емес».
Dialogue: 0,0:21:40.67,0:21:43.59,Default,,0,0,0,,«Мен әкеммен тікелей сөйлескім келеді».
Dialogue: 0,0:21:45.38,0:21:48.93,Default,,0,0,0,,«Мен хатқа жаза алмайтын көп нәрсе бар, сондықтан мен қиындыққа тап болдым».
Dialogue: 0,0:21:49.47,0:21:51.30,Default,,0,0,0,,«Мен сені жақын арада көргім келеді».
Dialogue: 0,0:21:51.39,0:21:55.81,Default,,0,0,0,,"Келесі жолы келетініме сенімдімін. Мені күтіңіз."
Dialogue: 0,0:21:55.89,0:21:57.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:59.56,0:22:01.15,Default,,0,0,0,,Ашулар
Dialogue: 0,0:22:01.23,0:22:03.73,Default,,0,0,0,,Мен де сенің әкеңмен тезірек кездескім келеді.
Dialogue: 0,0:22:06.03,0:22:11.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,～♪
