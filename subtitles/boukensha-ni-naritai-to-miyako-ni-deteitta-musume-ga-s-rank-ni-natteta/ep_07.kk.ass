Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.50,0:00:07.17,Default,,0,0,0,,Неліктен Хельветица тірі?
Dialogue: 0,0:00:07.25,0:00:10.80,Default,,0,0,0,,Оны өлі етіп шығарса, оңай болар еді!
Dialogue: 0,0:00:10.88,0:00:13.68,Default,,0,0,0,,Олардың бәрі қабілетсіз!
Dialogue: 0,0:00:13.76,0:00:15.68,Default,,0,0,0,,Мен сізге ескерттім, солай ма?
Dialogue: 0,0:00:15.76,0:00:18.56,Default,,0,0,0,,Оларсыз жоспар сәтті болар еді.
Dialogue: 0,0:00:18.64,0:00:19.93,Default,,0,0,0,,Біліксіздік – ұят
Dialogue: 0,0:00:20.02,0:00:21.27,Default,,0,0,0,,-Не... -Әлі жоқ.
Dialogue: 0,0:00:21.35,0:00:22.18,Default,,0,0,0,,Ах
Dialogue: 0,0:00:22.27,0:00:25.69,Default,,0,0,0,,Мәселе мынада, сізге тек Хельветиканы өлтіру керек.
Dialogue: 0,0:00:25.77,0:00:29.82,Default,,0,0,0,,Ей, дұрыс, мен әлі сәтсіздікке ұшыраған жоқпын.
Dialogue: 0,0:00:31.36,0:00:32.57,Default,,0,0,0,,- Күте тұрыңыз - иә?
Dialogue: 0,0:00:32.65,0:00:37.41,Default,,0,0,0,,Хе хи хи Хельветиканы шайқаудың жақсы жолы бар.
Dialogue: 0,0:00:44.29,0:00:46.75,Default,,0,0,0,,Ха! Мен қалжыңдамаймын!
Dialogue: 0,0:00:46.83,0:00:48.96,Default,,0,0,0,,Сіз бұлай қатыгез бола алмайсыз!
Dialogue: 0,0:00:49.04,0:00:51.13,Default,,0,0,0,,Олай етпесең, ұтыласың.
Dialogue: 0,0:00:51.21,0:00:54.97,Default,,0,0,0,,Отбасыңыздан айырылудың сұмдығын түсінетініңізге сенімдімін.
Dialogue: 0,0:00:55.05,0:00:58.72,Default,,0,0,0,,Ха, ақымақ болма!
Dialogue: 0,0:00:58.80,0:01:01.85,Default,,0,0,0,,Уау, S дәрежелі кеш керемет болды.
Dialogue: 0,0:01:01.93,0:01:04.23,Default,,0,0,0,,А-а, зиян аз болды.
Dialogue: 0,0:01:04.31,0:01:06.60,Default,,0,0,0,,Бұл да Вена ханымның батасын білдіре ме?
Dialogue: 0,0:01:06.69,0:01:07.52,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:01:08.81,0:01:10.82,Default,,0,0,0,,Вена Хельветикасы
Dialogue: 0,0:01:12.65,0:01:16.61,Default,,0,0,0,,Менің бақытты болатыныма еш күмәнім жоқ.
Dialogue: 0,0:01:16.70,0:01:18.82,Default,,0,0,0,,Бәрін жоғалтып алсам да
Dialogue: 0,0:01:20.66,0:01:24.83,Default,,0,0,0,,Бізге хаос керек. Біз Хельветиканы өлтіруіміз керек.
Dialogue: 0,0:01:27.04,0:01:32.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:51.62,0:02:56.96,Default,,0,0,0,,～♪
Dialogue: 0,0:03:08.98,0:03:10.23,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:10.31,0:03:11.48,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:11.56,0:03:14.23,Default,,0,0,0,,Үзіліс үшін кешірім сұраймыз.
Dialogue: 0,0:03:14.31,0:03:15.94,Default,,0,0,0,,Анджелина-доно қалай?
Dialogue: 0,0:03:16.02,0:03:19.07,Default,,0,0,0,,Құрметті Эшкрофт, кешіріңіз.
Dialogue: 0,0:03:19.69,0:03:22.82,Default,,0,0,0,,Бір түн ұйықтасам, сауығып кетемін деп ойлаймын.
Dialogue: 0,0:03:22.91,0:03:24.57,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:25.07,0:03:27.41,Default,,0,0,0,,Бордоны құтқарғаныңыз үшін барлығыңызға рахмет.
Dialogue: 0,0:03:27.49,0:03:29.83,Default,,0,0,0,,Алғысымды айтып жеткізе алмаймын.
Dialogue: 0,0:03:29.91,0:03:33.58,Default,,0,0,0,,Ахаха, бұл артық бағалау деп аталады.
Dialogue: 0,0:03:33.67,0:03:36.34,Default,,0,0,0,,Алғыс белгісі ретінде
Dialogue: 0,0:03:36.42,0:03:38.34,Default,,0,0,0,,Егер сізге бұл ұнаса
Dialogue: 0,0:03:38.42,0:03:39.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:39.92,0:03:41.84,Default,,0,0,0,,Эльф эликсирі
Dialogue: 0,0:03:41.93,0:03:45.14,Default,,0,0,0,,Әсері империялық әсермен салыстырғанда үлкен айырмашылық.
Dialogue: 0,0:03:45.22,0:03:47.85,Default,,0,0,0,,Мен мұндай қымбат нәрсені қабылдай алмаймын.
Dialogue: 0,0:03:47.93,0:03:50.64,Default,,0,0,0,,Мен сізге осындай нәрсемен барлығы үшін алғыс айта алмаймын.
Dialogue: 0,0:03:50.73,0:03:53.35,Default,,0,0,0,,Өтінемін, мені бетімді бейнелейді деп ойлаңыз.
Dialogue: 0,0:03:53.94,0:03:55.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.90,0:03:58.86,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:00.44,0:04:01.49,Default,,0,0,0,,Иә
Dialogue: 0,0:04:02.45,0:04:04.82,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:04:08.41,0:04:09.62,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:04:09.70,0:04:14.00,Default,,0,0,0,,А, жай ғана иіскеу денемді жақсы сезінетін сияқты.
Dialogue: 0,0:04:14.54,0:04:16.50,Default,,0,0,0,,-Ммм... -Аа
Dialogue: 0,0:04:17.25,0:04:20.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.09,0:04:24.51,Default,,0,0,0,,Маған қолдануға рұқсат етіңіз.
Dialogue: 0,0:04:27.26,0:04:29.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:31.10,0:04:33.77,Default,,0,0,0,,Аа, бұл керемет әсер.
Dialogue: 0,0:04:33.85,0:04:35.44,Default,,0,0,0,,Угх, угх, ах…
Dialogue: 0,0:04:35.52,0:04:38.56,Default,,0,0,0,,Ертең қозғала алмасам, мәселе болар еді.
Dialogue: 0,0:04:39.86,0:04:41.78,Default,,0,0,0,,Сен Коичимен бірге портта қал.
Dialogue: 0,0:04:41.86,0:04:44.70,Default,,0,0,0,,Хахаха бұл пайдалы
Dialogue: 0,0:04:53.00,0:04:56.67,Default,,0,0,0,,Мальта графын өлтірмей, оны қамқорлыққа алуыңызды өтінемін.
Dialogue: 0,0:04:56.75,0:04:58.50,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:04:58.58,0:05:02.05,Default,,0,0,0,,Егер қарсылық көрсетсеңіз, бір, екі немесе үш қолды қолданыңыз.
Dialogue: 0,0:05:02.13,0:05:05.13,Default,,0,0,0,,Ахаха, оның үш қолы болған жоқ па?
Dialogue: 0,0:05:05.22,0:05:06.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:07.89,0:05:10.14,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:05:10.22,0:05:11.22,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:05:11.31,0:05:12.56,Default,,0,0,0,,-Аа -Мм
Dialogue: 0,0:05:12.64,0:05:14.77,Default,,0,0,0,,А, мына қыз...
Dialogue: 0,0:05:14.85,0:05:17.56,Default,,0,0,0,,Менің атым Саша Бордо.
Dialogue: 0,0:05:17.65,0:05:21.44,Default,,0,0,0,,Сол көлеңке иесін жойған сен емессің бе?
Dialogue: 0,0:05:21.52,0:05:23.28,Default,,0,0,0,,Осы сағатта қай бағытта барасыз?
Dialogue: 0,0:05:23.36,0:05:27.16,Default,,0,0,0,,А... Мен сарайға шабуыл жасалғанын естідім.
Dialogue: 0,0:05:27.24,0:05:29.70,Default,,0,0,0,,Гельветикаға көңіл айтамын.
Dialogue: 0,0:05:29.78,0:05:32.33,Default,,0,0,0,,Аа, өтінішіңізді бағалаймын.
Dialogue: 0,0:05:32.41,0:05:35.71,Default,,0,0,0,,Біздің қазіргі уақытта тұтынушыларды қарсы алатындай жағдайымыз жоқ.
Dialogue: 0,0:05:35.79,0:05:37.42,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:37.50,0:05:39.33,Default,,0,0,0,,Бұл жай ғана сәлемдесу.
Dialogue: 0,0:05:39.42,0:05:42.84,Default,,0,0,0,,Жоқ, тым болмаса таң атқаннан кейін қайталап көріңіз...
Dialogue: 0,0:05:42.92,0:05:44.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:44.51,0:05:45.67,Default,,0,0,0,,Бяку!
Dialogue: 0,0:05:45.76,0:05:47.93,Default,,0,0,0,,Байқады, оны өлтірген дұрыс.
Dialogue: 0,0:05:49.55,0:05:52.43,Default,,0,0,0,,Жартылай ақылды болғаныңыз үшін өзіңізді жек көресіз.
Dialogue: 0,0:05:52.51,0:05:53.81,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:05:55.85,0:05:56.77,Default,,0,0,0,,Га
Dialogue: 0,0:05:59.31,0:06:00.73,Default,,0,0,0,,Бар!
Dialogue: 0,0:06:03.86,0:06:06.44,Default,,0,0,0,,Бұл сиқырлы оқ болуы керек, бірақ мен ештеңе көрмеймін.
Dialogue: 0,0:06:08.07,0:06:09.91,Default,,0,0,0,,Сақтандырсаңыз, соққы аласыз.
Dialogue: 0,0:06:13.70,0:06:16.87,Default,,0,0,0,,- (Саша) Әй! - Таңдануға уақыт жоқ.
Dialogue: 0,0:06:17.54,0:06:18.79,Default,,0,0,0,,Гухаа
Dialogue: 0,0:06:23.21,0:06:24.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:25.92,0:06:27.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:27.67,0:06:29.59,Default,,0,0,0,,-Абайо-(Саша) Уф
Dialogue: 0,0:06:32.14,0:06:33.22,Default,,0,0,0,,Цк
Dialogue: 0,0:06:34.01,0:06:35.47,Default,,0,0,0,,Ха, аа!
Dialogue: 0,0:06:36.39,0:06:38.64,Default,,0,0,0,,Лорд Эш Элмор
Dialogue: 0,0:06:38.73,0:06:40.06,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:06:40.14,0:06:42.98,Default,,0,0,0,,Саша мінген ат қана қайтып келді.
Dialogue: 0,0:06:43.06,0:06:44.94,Default,,0,0,0,,Сарбаздар шуылдады.
Dialogue: 0,0:06:45.02,0:06:46.44,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:06:47.65,0:06:49.36,Default,,0,0,0,,Маған қоңырау шалмаңыз.
Dialogue: 0,0:06:50.45,0:06:51.78,Default,,0,0,0,,Ооооооооооооо...
Dialogue: 0,0:06:52.66,0:06:55.03,Default,,0,0,0,,Не істедің! Мен ештеңе көре алмаймын!
Dialogue: 0,0:06:56.29,0:06:58.20,Default,,0,0,0,,Күрсін! Күрсін!
Dialogue: 0,0:06:59.79,0:07:02.21,Default,,0,0,0,,Қарт адамдар алыс болуы керек.
Dialogue: 0,0:07:02.83,0:07:05.34,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:07:06.71,0:07:08.59,Default,,0,0,0,,Бір адам болса да қашып кетпесін
Dialogue: 0,0:07:08.67,0:07:10.59,Default,,0,0,0,,Олардың барлығын өлтіріңіз
Dialogue: 0,0:07:10.68,0:07:12.59,Default,,0,0,0,,А... хмм?
Dialogue: 0,0:07:15.01,0:07:17.60,Default,,0,0,0,,Енді шықпайды.
Dialogue: 0,0:07:20.69,0:07:24.44,Default,,0,0,0,,Қаш! Мен сенің қарсыласың емеспін!
Dialogue: 0,0:07:26.32,0:07:27.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:27.82,0:07:31.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:34.45,0:07:35.91,Default,,0,0,0,,Лорд Андж
Dialogue: 0,0:07:37.99,0:07:39.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:42.33,0:07:44.04,Default,,0,0,0,,Достарыңызды қорлау
Dialogue: 0,0:07:44.71,0:07:45.92,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:49.01,0:07:50.80,Default,,0,0,0,,Әпкеңізді де қосыңыз.
Dialogue: 0,0:07:50.88,0:07:52.30,Default,,0,0,0,,Оны жіберіңіз
Dialogue: 0,0:07:57.76,0:07:58.93,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:03.90,0:08:07.32,Default,,0,0,0,,Бірдеңе жақсы болып жатыр. Неліктен?
Dialogue: 0,0:08:09.94,0:08:11.57,Default,,0,0,0,,Түсінде
Dialogue: 0,0:08:11.65,0:08:14.82,Default,,0,0,0,,Дәл сол кездегідей мені бір қара жігіт шақырды.
Dialogue: 0,0:08:14.91,0:08:19.62,Default,,0,0,0,,Сол кезде жылы қол келді, мен әкем деп ойладым.
Dialogue: 0,0:08:19.70,0:08:22.79,Default,,0,0,0,,Жұмбақ орманның иісімен толтырылған
Dialogue: 0,0:08:22.87,0:08:24.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:29.50,0:08:32.01,Default,,0,0,0,,Мен ойлап отырмын, маған кедергі жасама.
Dialogue: 0,0:08:32.72,0:08:34.13,Default,,0,0,0,,Тамақтанып алайықшы, иә? \h
Dialogue: 0,0:08:36.84,0:08:38.72,Default,,0,0,0,,Үш өлшемді сиқырлы шеңбер
Dialogue: 0,0:08:38.80,0:08:40.89,Default,,0,0,0,,Бұл әрқашан жасырын болды ма?
Dialogue: 0,0:08:40.97,0:08:42.56,Default,,0,0,0,,Иә
Dialogue: 0,0:08:42.64,0:08:45.94,Default,,0,0,0,,Үш өлшемді сиқырлы шеңбер - бұл жетілдірілген сиқыр.
Dialogue: 0,0:08:46.02,0:08:49.40,Default,,0,0,0,,Үлкен сиқырлы күш пен ақыл-ой күшін қажет етеді
Dialogue: 0,0:08:49.48,0:08:52.86,Default,,0,0,0,,Керемет сиқырлы амалдар Осымен бітті ме?
Dialogue: 0,0:08:59.99,0:09:01.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:06.04,0:09:07.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:09.63,0:09:13.01,Default,,0,0,0,,Хмм, бұл мөлдірге қарағанда жылдамырақ және ауырырақ.
Dialogue: 0,0:09:13.09,0:09:15.13,Default,,0,0,0,,Сол қол қозғалысының траекториясы... Мм!
Dialogue: 0,0:09:15.22,0:09:17.55,Default,,0,0,0,,Қарамастан жұмыс істейтін кейбір нәрселер бар ма?
Dialogue: 0,0:09:18.89,0:09:22.81,Default,,0,0,0,,Айла керек болса, менен әлсізсің.
Dialogue: 0,0:09:23.60,0:09:26.06,Default,,0,0,0,,Иә? Бұл енді ауырмайды
Dialogue: 0,0:09:26.14,0:09:29.69,Default,,0,0,0,,Мм, әкеңнің махаббатының құдіреті шығар.
Dialogue: 0,0:09:29.77,0:09:30.69,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:35.53,0:09:36.45,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:37.53,0:09:39.07,Default,,0,0,0,,-Мм! -Ах!
Dialogue: 0,0:09:39.16,0:09:40.41,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:44.04,0:09:46.33,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:09:46.41,0:09:49.33,Default,,0,0,0,,Қарғыс атқыр... ха
Dialogue: 0,0:09:49.42,0:09:53.84,Default,,0,0,0,,Менің сізден сұрайын дегенім бар: Сіз кімсіз және мақсатыңыз қандай?
Dialogue: 0,0:09:53.92,0:09:56.38,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:09:56.47,0:09:57.84,Default,,0,0,0,,Не болды!
Dialogue: 0,0:09:57.93,0:10:01.85,Default,,0,0,0,,Мен Анджелинамын, қызыл жын Белгрифтің қызымын.
Dialogue: 0,0:10:01.93,0:10:06.98,Default,,0,0,0,,Мм, қызым саған не болды? Ақымақ болма!
Dialogue: 0,0:10:07.94,0:10:09.23,Default,,0,0,0,,Ах
Dialogue: 0,0:10:12.69,0:10:16.11,Default,,0,0,0,,Қарғыс атқыр, неге бос емессің...
Dialogue: 0,0:10:17.53,0:10:18.74,Default,,0,0,0,,Бұл жамандықтың белгісі сияқты
Dialogue: 0,0:10:18.82,0:10:21.49,Default,,0,0,0,,Не, сен адам емессің бе?
Dialogue: 0,0:10:21.57,0:10:23.99,Default,,0,0,0,,Гуггаааааааааааааааааааа!
Dialogue: 0,0:10:26.58,0:10:27.75,Default,,0,0,0,,Гах...
Dialogue: 0,0:10:29.08,0:10:32.75,Default,,0,0,0,,Бұл не? Бұл құбыжықтың жаңа түрі ме?
Dialogue: 0,0:10:32.84,0:10:35.76,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:10:35.84,0:10:39.76,Default,,0,0,0,,Уф... Теми сияқты!
Dialogue: 0,0:10:40.34,0:10:42.01,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:10:43.43,0:10:44.51,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:10:44.60,0:10:47.02,Default,,0,0,0,,Мен қашып құтылдым.
Dialogue: 0,0:10:50.10,0:10:51.40,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:10:51.48,0:10:54.02,Default,,0,0,0,,Тағы біртүрлі бұлттар пайда болды.
Dialogue: 0,0:10:54.11,0:10:57.07,Default,,0,0,0,,Шайқас әлі біткен жоқ па?
Dialogue: 0,0:10:58.69,0:10:59.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:59.61,0:11:02.03,Default,,0,0,0,,-Мм... -Андж ше?
Dialogue: 0,0:11:02.11,0:11:05.79,Default,,0,0,0,,Ол кенет оянып, сыртқа жүгірді.
Dialogue: 0,0:11:05.87,0:11:07.66,Default,,0,0,0,,Маған сәлем айтыңыз
Dialogue: 0,0:11:07.75,0:11:09.54,Default,,0,0,0,,-Аа -Ааа...
Dialogue: 0,0:11:09.62,0:11:12.54,Default,,0,0,0,,Мен Хельветика үшін уайымдап тұрмын, кеттік.
Dialogue: 0,0:11:13.25,0:11:14.54,Default,,0,0,0,,Барлығы қиыншылықта!
Dialogue: 0,0:11:14.63,0:11:16.46,Default,,0,0,0,,-Аа -Не болды?
Dialogue: 0,0:11:16.55,0:11:19.22,Default,,0,0,0,,Тағы да қара бұлттар пайда болды.
Dialogue: 0,0:11:19.30,0:11:23.34,Default,,0,0,0,,Бүгін кешке келе жатсаңыз, дәл мен ойлағандай.
Dialogue: 0,0:11:23.43,0:11:25.60,Default,,0,0,0,,Үлкен әпке, әпке...
Dialogue: 0,0:11:25.68,0:11:29.31,Default,,0,0,0,,Оны қолға алып, қолға түсіру үшін мен оны жалғыз жібердім.
Dialogue: 0,0:11:29.39,0:11:30.81,Default,,0,0,0,,Бұл сәтсіздікке ұшыраған болуы мүмкін
Dialogue: 0,0:11:30.81,0:11:31.19,Default,,0,0,0,,Бұл сәтсіз болуы мүмкін
Dialogue: 0,0:11:30.81,0:11:31.19,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:31.19,0:11:31.27,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:31.27,0:11:32.10,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:31.27,0:11:32.10,Default,,0,0,0,,Га
Dialogue: 0,0:11:32.19,0:11:33.85,Default,,0,0,0,,Ах
Dialogue: 0,0:11:34.48,0:11:37.36,Default,,0,0,0,,Ханым! Тағы бір өлмеген
Dialogue: 0,0:11:38.44,0:11:41.45,Default,,0,0,0,,Сіз осындасыз ба? Сабырлы болыңыз және онымен күресіңіз.
Dialogue: 0,0:11:41.53,0:11:42.36,Default,,0,0,0,,Га
Dialogue: 0,0:11:42.45,0:11:44.24,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:11:44.32,0:11:46.37,Default,,0,0,0,,Әлі де зорлық-зомбылық жеткіліксіз
Dialogue: 0,0:11:47.20,0:11:48.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.70,0:11:50.41,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:11:52.96,0:11:55.63,Default,,0,0,0,,А, не болды?
Dialogue: 0,0:11:55.71,0:11:59.38,Default,,0,0,0,,Мүмкін болса, жақын жерде болыңыз.
Dialogue: 0,0:11:59.46,0:12:02.72,Default,,0,0,0,,Саша мен Эш мұнда жоқ, сондықтан мен уайымдап тұрмын.
Dialogue: 0,0:12:03.47,0:12:07.85,Default,,0,0,0,,Иә, түсіндім. Кейбір күзетшілерді ұстап көрейік.
Dialogue: 0,0:12:07.93,0:12:09.14,Default,,0,0,0,,(Мириам мен Анессаның дауысы)
Dialogue: 0,0:12:09.22,0:12:11.98,Default,,0,0,0,,Осы екеуі бар болса, сыртта бәрі жақсы болады.
Dialogue: 0,0:12:12.06,0:12:14.23,Default,,0,0,0,,Бұл сенімді.
Dialogue: 0,0:12:14.85,0:12:16.31,Default,,0,0,0,,Қозғалайық
Dialogue: 0,0:12:16.40,0:12:19.23,Default,,0,0,0,,Бірдеңе болып қалса, екінші қабатта қашып құтылу мүмкін емес.
Dialogue: 0,0:12:22.78,0:12:24.36,Default,,0,0,0,,Екінші қабаттағылардың бәрі...
Dialogue: 0,0:12:24.45,0:12:25.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:25.70,0:12:27.62,Default,,0,0,0,,(Гельветика мен Селеннің айқайы)
Dialogue: 0,0:12:29.54,0:12:30.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:33.00,0:12:34.25,Default,,0,0,0,,- Ммм - (Helvetica selenium) Ах!
Dialogue: 0,0:12:34.33,0:12:38.13,Default,,0,0,0,,Сырттағы өлмегендерді тазалау керек еді.
Dialogue: 0,0:12:38.21,0:12:41.26,Default,,0,0,0,,Үйдегі адамдармен Арне мен Миллиге барыңыз.
Dialogue: 0,0:12:41.34,0:12:44.51,Default,,0,0,0,,Иә, бірақ лорд Бергриф туралы не деуге болады?
Dialogue: 0,0:12:45.93,0:12:49.56,Default,,0,0,0,,Бәрің шығып кеткенше мен оны өшіремін.
Dialogue: 0,0:12:54.14,0:12:54.98,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:55.06,0:12:58.48,Default,,0,0,0,,Сен өлсең Анджелина мұңаяды!
Dialogue: 0,0:12:58.56,0:13:03.74,Default,,0,0,0,,Сол балаға авантюристтердің өмірі бар екенін үйреткен мен едім.
Dialogue: 0,0:13:03.82,0:13:07.49,Default,,0,0,0,,Мен осында өлсем, ол қызға тең келер бетім жоқ.
Dialogue: 0,0:13:08.24,0:13:10.49,Default,,0,0,0,,Ха... сәттілік
Dialogue: 0,0:13:11.83,0:13:13.70,Default,,0,0,0,,Селен, кеттік.
Dialogue: 0,0:13:13.79,0:13:14.83,Default,,0,0,0,,Иә
Dialogue: 0,0:13:14.91,0:13:15.75,Default,,0,0,0,,Қазір...
Dialogue: 0,0:13:20.17,0:13:23.09,Default,,0,0,0,,Дене қорқынышты жеңіл
Dialogue: 0,0:13:23.17,0:13:25.09,Default,,0,0,0,,Эльф эликсирінің әсері?
Dialogue: 0,0:13:26.34,0:13:27.51,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:13:34.73,0:13:38.15,Default,,0,0,0,,Фу ​​Мынадай бірдеңе... ау?
Dialogue: 0,0:13:43.73,0:13:46.78,Default,,0,0,0,,А, сен барда болған шығарсың.
Dialogue: 0,0:13:46.86,0:13:48.99,Default,,0,0,0,,Амансың ба? Бұл жерде қауіпті...
Dialogue: 0,0:13:49.07,0:13:50.41,Default,,0,0,0,,-Алыс болыңыз! -Ах
Dialogue: 0,0:13:50.49,0:13:53.66,Default,,0,0,0,,Олардың әрқайсысы менің жолыма кедергі келтіреді.
Dialogue: 0,0:13:53.74,0:13:55.66,Default,,0,0,0,,Сіз не айтасыз!
Dialogue: 0,0:13:55.75,0:13:57.92,Default,,0,0,0,,А... сен...
Dialogue: 0,0:13:58.00,0:13:59.63,Default,,0,0,0,,Өл!
Dialogue: 0,0:14:05.26,0:14:07.84,Default,,0,0,0,,Бұл ғимаратта барлығы жиналды.
Dialogue: 0,0:14:12.01,0:14:13.35,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:13.43,0:14:16.10,Default,,0,0,0,,Оны шытырман оқиғалылар күтіп алады.
Dialogue: 0,0:14:16.18,0:14:18.14,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:14:19.98,0:14:22.90,Default,,0,0,0,,Менің қолымнан келетіні – жаныңды тыныштандыру.
Dialogue: 0,0:14:23.69,0:14:27.40,Default,,0,0,0,,Әкеңіздің ізімен біз компанияны тұрақты дамыттық.
Dialogue: 0,0:14:27.49,0:14:29.61,Default,,0,0,0,,Мен сенетін адамдар көбейді
Dialogue: 0,0:14:30.53,0:14:32.62,Default,,0,0,0,,Мен сонша мақтаншақ болдым ба?
Dialogue: 0,0:14:33.45,0:14:35.37,Default,,0,0,0,,Ақырында бірдеңе болады
Dialogue: 0,0:14:35.45,0:14:38.37,Default,,0,0,0,,Көтерілісші төрелерден назарын аударды.
Dialogue: 0,0:14:38.46,0:14:43.09,Default,,0,0,0,,Адамдардың өмірі жоғарыдағылардың мінез-құлқына байланысты.
Dialogue: 0,0:14:43.17,0:14:45.13,Default,,0,0,0,,Ол кез келген жолмен өзгереді
Dialogue: 0,0:14:45.21,0:14:48.88,Default,,0,0,0,,Билікте өлген Мальта графы саясат жүргізсе,
Dialogue: 0,0:14:48.97,0:14:51.64,Default,,0,0,0,,Нәтижелерді елестету оңай.
Dialogue: 0,0:14:51.72,0:14:56.97,Default,,0,0,0,,Бірақ тазалыққа құмар болатыным сондықтан.
Dialogue: 0,0:14:57.06,0:14:58.52,Default,,0,0,0,,Лордтар және т.б.
Dialogue: 0,0:15:00.27,0:15:04.90,Default,,0,0,0,,Әкең бұл салмаққа шыдапты.
Dialogue: 0,0:15:08.57,0:15:09.90,Default,,0,0,0,,-Аа... -Аа
Dialogue: 0,0:15:12.49,0:15:15.49,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:15:15.58,0:15:17.41,Default,,0,0,0,,О, мистер Белл ше?
Dialogue: 0,0:15:18.00,0:15:20.79,Default,,0,0,0,,Олар бізге қашуға көмектесу үшін күресіп жатыр.
Dialogue: 0,0:15:20.87,0:15:23.50,Default,,0,0,0,,Иә! Мен барып көмектесуім керек
Dialogue: 0,0:15:23.58,0:15:27.92,Default,,0,0,0,,Мистер Белл жақсы, біз бұл жерді қорғауымыз керек.
Dialogue: 0,0:15:28.01,0:15:29.88,Default,,0,0,0,,Аха, солай ма?
Dialogue: 0,0:15:29.97,0:15:32.55,Default,,0,0,0,,Эндждің жігіті қайда кетті? Не!
Dialogue: 0,0:15:35.14,0:15:37.31,Default,,0,0,0,,-Мм. Ол әлі осында. -Хм.
Dialogue: 0,0:15:37.39,0:15:39.52,Default,,0,0,0,,Ха, әпке!?
Dialogue: 0,0:15:39.60,0:15:41.06,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:15:45.56,0:15:48.07,Default,,0,0,0,,Әке... Құрметті...
Dialogue: 0,0:15:48.69,0:15:52.32,Default,,0,0,0,,А... Маған ұнамайды... Бұл өтірік
Dialogue: 0,0:15:52.40,0:15:54.49,Default,,0,0,0,,Қатыгез!
Dialogue: 0,0:15:55.53,0:15:56.37,Default,,0,0,0,,Ах
Dialogue: 0,0:15:56.45,0:15:59.08,Default,,0,0,0,,Басын езсең, өлмеген де өледі, солай ма?
Dialogue: 0,0:16:00.08,0:16:01.46,Default,,0,0,0,,33-ші эпизод: Оның аты Диабло
Dialogue: 0,0:16:01.54,0:16:03.42,Default,,0,0,0,,Лорд ретінде сіз көргіңіз келмейтін шындыққа қашпай қарсы тұруыңыз керек.
Dialogue: 0,0:16:03.42,0:16:05.92,Default,,0,0,0,,Лорд ретінде сіз көргіңіз келмейтін шындыққа қашпай қарсы тұруыңыз керек.
Dialogue: 0,0:16:03.42,0:16:05.92,Default,,0,0,0,,(Селеннің айқайы)
Dialogue: 0,0:16:05.92,0:16:06.71,Default,,0,0,0,,(Селенаның жылағаны)
Dialogue: 0,0:16:06.79,0:16:08.46,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:16:08.55,0:16:11.47,Default,,0,0,0,,Жоқ, бұл менің рөлім.
Dialogue: 0,0:16:12.47,0:16:15.47,Default,,0,0,0,,Әке, арқаңда не көтердің
Dialogue: 0,0:16:16.43,0:16:19.22,Default,,0,0,0,,Бұл жолы мен оны арқама көтеріп алайын!
Dialogue: 0,0:16:25.40,0:16:26.65,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:26.73,0:16:27.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:28.32,0:16:30.78,Default,,0,0,0,,Осылай тосқауыл қою арқылы аман қалу мүмкін емес.
Dialogue: 0,0:16:30.86,0:16:32.57,Default,,0,0,0,,Бірақ басқа адам бала.
Dialogue: 0,0:16:32.65,0:16:35.57,Default,,0,0,0,,Чокомакато... Уф
Dialogue: 0,0:16:38.16,0:16:41.04,Default,,0,0,0,,-Ха! -Ой... А?
Dialogue: 0,0:16:41.70,0:16:46.04,Default,,0,0,0,,Не, бұл маған ұнамайды!
Dialogue: 0,0:16:46.13,0:16:47.79,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:16:47.88,0:16:49.75,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:16:49.84,0:16:52.55,Default,,0,0,0,,Маған көмектес, әке мен ана!
Dialogue: 0,0:16:52.63,0:16:55.47,Default,,0,0,0,,Қолымды кесіп тастасам, анық болар еді.
Dialogue: 0,0:16:52.63,0:16:55.47,Default,,0,0,0,,(Шарлоттаның айқайы)
Dialogue: 0,0:16:55.47,0:16:55.55,Default,,0,0,0,,(Шарлоттаның айқайы)
Dialogue: 0,0:16:55.55,0:16:56.76,Default,,0,0,0,,(Шарлоттаның айқайы)
Dialogue: 0,0:16:55.55,0:16:56.76,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:16:57.85,0:16:58.72,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:17:00.47,0:17:01.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:04.14,0:17:05.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:06.23,0:17:07.06,Default,,0,0,0,,-Ei -Ah
Dialogue: 0,0:17:11.15,0:17:13.86,Default,,0,0,0,,Уф... жақсысың ба?
Dialogue: 0,0:17:14.57,0:17:16.61,Default,,0,0,0,,Уф... бұл қорқынышты болды...
Dialogue: 0,0:17:17.36,0:17:19.12,Default,,0,0,0,,Бұл қорқынышты болды~
Dialogue: 0,0:17:19.20,0:17:22.79,Default,,0,0,0,,«жарты айды көремін—»
Dialogue: 0,0:17:22.87,0:17:26.12,Default,,0,0,0,,Ол өз жасындағы бала.
Dialogue: 0,0:17:26.21,0:17:27.12,Default,,0,0,0,,Ах
Dialogue: 0,0:17:29.79,0:17:30.63,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:37.09,0:17:39.14,Default,,0,0,0,,Ах... рахмет...
Dialogue: 0,0:17:45.39,0:17:46.64,Default,,0,0,0,,- Әке! -Ой?
Dialogue: 0,0:17:46.73,0:17:48.40,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:17:48.48,0:17:49.52,Default,,0,0,0,,Кяхаха!
Dialogue: 0,0:17:49.61,0:17:51.40,Default,,0,0,0,,Андж, жақсы болдыңыз ба?
Dialogue: 0,0:17:51.48,0:17:54.94,Default,,0,0,0,,Иә, әкеңнің де аман болғанына қуаныштымын.
Dialogue: 0,0:17:55.03,0:17:56.65,Default,,0,0,0,,Мен сенің қауіпсіз екеніңді білдім.
Dialogue: 0,0:17:56.74,0:17:57.82,Default,,0,0,0,,Иә
Dialogue: 0,0:17:59.24,0:18:01.16,Default,,0,0,0,,Мына пайдасыз бейбақтар!
Dialogue: 0,0:18:01.24,0:18:05.00,Default,,0,0,0,,Байланыстың болмауы сәтсіздікті білдіреді ме?
Dialogue: 0,0:18:05.08,0:18:06.41,Default,,0,0,0,,- (Солдат) Мальта графы? -Уф
Dialogue: 0,0:18:06.50,0:18:09.75,Default,,0,0,0,,Осы сағатта қалай жалғыз қалдыңыз?
Dialogue: 0,0:18:09.83,0:18:14.51,Default,,0,0,0,,Ха, бұл өте үлкен мәселе. Мен де патрульдемін.
Dialogue: 0,0:18:14.59,0:18:18.05,Default,,0,0,0,,Бұл тамаша. Сіз қатты шаршаған болуыңыз керек.
Dialogue: 0,0:18:18.13,0:18:21.51,Default,,0,0,0,,Киінетін бөлмеде шарап бар. Неге үзіліс жасамайсың?
Dialogue: 0,0:18:21.60,0:18:23.51,Default,,0,0,0,,О? Хмм...
Dialogue: 0,0:18:24.22,0:18:26.64,Default,,0,0,0,,Егер бұл уақытша ұстау изоляторы болса, менің жауынгерлерім де сонда болады.
Dialogue: 0,0:18:26.73,0:18:29.52,Default,,0,0,0,,Біріккен дұрыс емес пе?
Dialogue: 0,0:18:29.60,0:18:32.27,Default,,0,0,0,,-Олай болса, маған жол көрсет.-(Сарбаздар) Ха!
Dialogue: 0,0:18:36.36,0:18:38.99,Default,,0,0,0,,Бұл басшыларға арналған бөлме.
Dialogue: 0,0:18:39.07,0:18:41.03,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:18:42.62,0:18:45.04,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:18:45.12,0:18:47.54,Default,,0,0,0,,Әй, Гельветика...
Dialogue: 0,0:18:47.54,0:18:48.66,Default,,0,0,0,,Ах, Гельветица...
Dialogue: 0,0:18:47.54,0:18:48.66,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:48.75,0:18:51.04,Default,,0,0,0,,А, бұл не...
Dialogue: 0,0:18:51.13,0:18:55.80,Default,,0,0,0,,Қалған тыныш өмірімді Хазелде өткізгенімді қалаймын.
Dialogue: 0,0:18:55.88,0:18:59.42,Default,,0,0,0,,Не, не туралы айтып тұрсың? Мен не істедім...
Dialogue: 0,0:18:59.51,0:19:03.43,Default,,0,0,0,,Сіз мұны өте жақсы білесіз, солай ма?
Dialogue: 0,0:19:03.51,0:19:06.60,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,0:19:07.81,0:19:09.02,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:19:09.10,0:19:12.44,Default,,0,0,0,,Мен сені дәлелсіз өлтірсем, сенімің жойылады!
Dialogue: 0,0:19:12.52,0:19:15.19,Default,,0,0,0,,Мұны кейінірек білесіз.
Dialogue: 0,0:19:15.27,0:19:17.94,Default,,0,0,0,,Мынау... бұл менмендік!
Dialogue: 0,0:19:18.03,0:19:20.07,Default,,0,0,0,,Осы уақыт туралы
Dialogue: 0,0:19:20.15,0:19:23.12,Default,,0,0,0,,Бұған менің аңғалдығым себеп болғаны рас.
Dialogue: 0,0:19:23.20,0:19:27.08,Default,,0,0,0,,Бірақ сенің сұмдық жоспарың мені дайын етті.
Dialogue: 0,0:19:27.16,0:19:31.21,Default,,0,0,0,,Сіз осындай нәрсені тегін жасай аламын деп ойлайсыз ба?
Dialogue: 0,0:19:31.29,0:19:35.34,Default,,0,0,0,,Мен князьдіктен шыққан асылмын, мен сенен басқа қандаспын!
Dialogue: 0,0:19:35.42,0:19:38.63,Default,,0,0,0,,Иә, бұл көмектеседі.
Dialogue: 0,0:19:38.71,0:19:42.22,Default,,0,0,0,,Менің қаным сізбен бірдей деп елестетіп көріңізші.
Dialogue: 0,0:19:42.30,0:19:44.22,Default,,0,0,0,,Бұл менің шашымды таратады.
Dialogue: 0,0:19:44.30,0:19:45.72,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:45.80,0:19:48.72,Default,,0,0,0,,Мәйітті жол жиегіне қалдырыңыз.
Dialogue: 0,0:19:49.43,0:19:53.31,Default,,0,0,0,,Ержүрек граф Мальта жалғыз өзі патрульдеді.
Dialogue: 0,0:19:53.40,0:19:56.44,Default,,0,0,0,,Оған ұры шабуыл жасап өлтірді.
Dialogue: 0,0:19:58.32,0:19:59.74,Default,,0,0,0,,Я...
Dialogue: 0,0:19:59.82,0:20:03.99,Default,,0,0,0,,(Мартаның айқайы)
Dialogue: 0,0:20:08.33,0:20:10.50,Default,,0,0,0,,Сіз не істеп жатырсыз? Ашулар
Dialogue: 0,0:20:11.25,0:20:14.00,Default,,0,0,0,,Сіз әке ингредиенттерімен толықтырып жатырсыз ба?
Dialogue: 0,0:20:14.92,0:20:16.67,Default,,0,0,0,,Толықтырудан кейін не болады?
Dialogue: 0,0:20:16.75,0:20:18.13,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:20:18.21,0:20:19.50,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:20:20.01,0:20:22.01,Default,,0,0,0,,Ал, кететін уақыт келді.
Dialogue: 0,0:20:22.09,0:20:25.22,Default,,0,0,0,,Ұстаз, кешіріңіз, мен оны реттей алмаймын.
Dialogue: 0,0:20:25.30,0:20:26.22,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:20:26.30,0:20:29.06,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:20:29.14,0:20:31.14,Default,,0,0,0,,Қайта келіңіз.
Dialogue: 0,0:20:31.23,0:20:35.40,Default,,0,0,0,,Қымбатты Саша, алдымен өзіңді жақсылап күт.
Dialogue: 0,0:20:35.48,0:20:38.07,Default,,0,0,0,,Сізге де рахмет, Серен-доно.
Dialogue: 0,0:20:38.15,0:20:39.15,Default,,0,0,0,,-Әке -Хмм?
Dialogue: 0,0:20:39.23,0:20:41.86,Default,,0,0,0,,Менімен бірге Орфенге келгің келе ме?
Dialogue: 0,0:20:41.94,0:20:44.66,Default,,0,0,0,,Кең жерді жалға алсаңыз, екі адам бірге тұра алады.
Dialogue: 0,0:20:44.74,0:20:47.66,Default,,0,0,0,,Хаха, жақсы сөздер айтасың.
Dialogue: 0,0:20:47.74,0:20:49.49,Default,,0,0,0,,А, онда...
Dialogue: 0,0:20:49.58,0:20:53.46,Default,,0,0,0,,Бірақ бұлай болса, мен енді Торнеллаға келмеймін.
Dialogue: 0,0:20:53.54,0:20:55.42,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:20:55.50,0:20:58.75,Default,,0,0,0,,Әкем Торнелланы өз үйі деп санайды.
Dialogue: 0,0:20:58.84,0:21:01.46,Default,,0,0,0,,Сондықтан, Андждың қайту орны ретінде.
Dialogue: 0,0:21:01.55,0:21:03.30,Default,,0,0,0,,Мен оны қорғауға тырысамын.
Dialogue: 0,0:21:03.38,0:21:05.13,Default,,0,0,0,,Андж Торнелланы ұнатады, солай ма?
Dialogue: 0,0:21:05.22,0:21:07.64,Default,,0,0,0,,А... Иә, маған ұнайды.
Dialogue: 0,0:21:08.30,0:21:09.14,Default,,0,0,0,,Иә
Dialogue: 0,0:21:09.22,0:21:10.72,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:21:10.81,0:21:13.68,Default,,0,0,0,,Еңбек етіп, күзде қайтып кел.
Dialogue: 0,0:21:13.77,0:21:15.19,Default,,0,0,0,,Мен де!
Dialogue: 0,0:21:15.27,0:21:16.56,Default,,0,0,0,,Мен сені қайта көргім келеді
Dialogue: 0,0:21:16.65,0:21:18.90,Default,,0,0,0,,-Бергриф-сама~! -иә?
Dialogue: 0,0:21:18.98,0:21:22.65,Default,,0,0,0,,Ха ха ха... Мен уақытында жасадым.
Dialogue: 0,0:21:22.73,0:21:24.36,Default,,0,0,0,,Гельветика
Dialogue: 0,0:21:24.44,0:21:27.11,Default,,0,0,0,,Бізге қайта келіңіз.
Dialogue: 0,0:21:27.20,0:21:29.03,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:21:29.12,0:21:30.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:30.49,0:21:31.49,Default,,0,0,0,,Мен құрметтімін...
Dialogue: 0,0:21:31.58,0:21:32.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:32.49,0:21:34.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:34.12,0:21:38.42,Default,,0,0,0,,Бұл жолы щек, бірақ келесі жолы болса, онда...
Dialogue: 0,0:21:38.50,0:21:41.63,Default,,0,0,0,,Өтінемін, мені көп мазақтамаңыз.
Dialogue: 0,0:21:41.71,0:21:43.17,Default,,0,0,0,,-Әке -Хмм?
Dialogue: 0,0:21:43.26,0:21:45.88,Default,,0,0,0,,Сізге кеуделер ұнай ма?
Dialogue: 0,0:21:45.97,0:21:48.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:45.97,0:21:48.30,Default,,0,0,0,,Уф, мына кеуделер...
Dialogue: 0,0:21:52.22,0:21:53.31,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:21:54.18,0:21:55.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:55.64,0:21:58.06,Default,,0,0,0,,А, мен келе жатырмын, әке!
Dialogue: 0,0:21:58.15,0:22:01.57,Default,,0,0,0,,А... аа, қош келдіңіз.
Dialogue: 0,0:22:05.99,0:22:10.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.95,0:23:35.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.45,0:23:43.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory