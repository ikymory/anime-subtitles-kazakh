Dialogue: 0,0:00:01.91,0:00:04.52,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.84,0:00:07.58,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:00:08.05,0:00:14.47,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:00:14.47,0:00:17.16,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:00:17.47,0:00:20.07,OP,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:00:20.78,0:00:24.87,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:00:26.46,0:00:28.23,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:00:36.19,0:00:37.09,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:00:38.29,0:00:39.83,,NTP,0000,0000,0000,,Қараңызшы, бұл сүт.
Dialogue: 0,0:00:40.34,0:00:41.50,,NTP,0000,0000,0000,,Сүт
Dialogue: 0,0:00:43.38,0:00:46.41,,NTP,0000,0000,0000,,...
Dialogue: 0,0:00:47.08,0:00:48.57,,NTP,0000,0000,0000,,Біраз уақыт болса болды.
Dialogue: 0,0:00:50.75,0:00:53.97,,NTP,0000,0000,0000,,?（） 「」
Dialogue: 0,0:00:55.95,0:00:56.93,,NTP,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет
Dialogue: 0,0:00:58.37,0:00:58.95,,NTP,0000,0000,0000,,Бұл! ?
Dialogue: 0,0:01:00.53,0:01:01.56,,NTP,0000,0000,0000,,Сүт
Dialogue: 0,0:01:04.09,0:01:05.86,,NTP,0000,0000,0000,,Мен сізге қол жеткізгім келеді (сізге жете алмаймын)
Dialogue: 0,0:01:06.25,0:01:08.52,,NTP,0000,0000,0000,,Йохеи Қандай тағамдар жақсы?
Dialogue: 0,0:01:09.03,0:01:09.96,,NTP,0000,0000,0000,,Бұл жақсырақ
Dialogue: 0,0:01:10.16,0:01:11.70,,NTP,0000,0000,0000,,Иә, сәл күте тұрыңыз.
Dialogue: 0,0:01:12.15,0:01:15.06,,NTP,0000,0000,0000,,Мама, сүтті ал.
Dialogue: 0,0:01:17.23,0:01:18.45,,NTP,0000,0000,0000,,Хорай
Dialogue: 0,0:01:19.55,0:01:21.03,,NTP,0000,0000,0000,,Мама, тезірек.
Dialogue: 0,0:01:21.05,0:01:21.82,,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:01:22.61,0:01:24.75,,NTP,0000,0000,0000,,Сәлем! ? Ал сүт ше?
Dialogue: 0,0:01:25.00,0:01:25.86,,NTP,0000,0000,0000,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:01:30.38,0:01:37.02,,NTP,0000,0000,0000,,Әй, сен сондай өнерлі екенсің.
Dialogue: 0,0:01:37.27,0:01:42.81,,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:43.74,0:01:44.49,,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:01:45.30,0:01:47.35,,NTP,0000,0000,0000,,Сүт
Dialogue: 0,0:01:49.49,0:01:50.33,,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:01:51.05,0:01:53.50,,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:53.79,0:01:54.89,,NTP,0000,0000,0000,,Сізге жақсы.
Dialogue: 0,0:01:55.36,0:01:57.90,,NTP,0000,0000,0000,,Олай емес???
Dialogue: 0,0:02:02.86,0:02:04.10,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:02:06.37,0:02:10.42,,NTP,0000,0000,0000,,Гю Гю Сүт Ра?
Dialogue: 0,0:02:10.95,0:02:14.14,,NTP,0000,0000,0000,,Анашым, мен сүтті қаламаймын.
Dialogue: 0,0:02:14.47,0:02:16.12,,NTP,0000,0000,0000,,Мен оны Чиге беремін.
Dialogue: 0,0:02:16.83,0:02:19.07,,NTP,0000,0000,0000,,Сүт～
Dialogue: 0,0:02:23.17,0:02:25.80,,NTP,0000,0000,0000,,Чи пластик пакеттерді жақсы көреді.
Dialogue: 0,0:02:26.48,0:02:28.99,,NTP,0000,0000,0000,,Басқаша болса да???
Dialogue: 0,0:02:29.58,0:02:33.57,,NTP,0000,0000,0000,,Бұл емес, сүт жоқ.
Dialogue: 0,0:02:43.72,0:02:44.90,,NTP,0000,0000,0000,,Сүт ішуші -
Dialogue: 0,0:02:45.24,0:02:45.79,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:02:45.95,0:02:46.67,,NTP,0000,0000,0000,,Мен де
Dialogue: 0,0:02:47.33,0:02:48.89,,NTP,0000,0000,0000,,Эй, сен ішкің келе ме?
Dialogue: 0,0:02:49.55,0:02:50.92,,NTP,0000,0000,0000,,（ ）
Dialogue: 0,0:02:49.98,0:02:52.95,,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:52.80,0:02:54.55,,NTP,0000,0000,0000,,Хахаха
Dialogue: 0,0:02:57.90,0:03:00.65,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.87,0:03:03.54,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:03:04.14,0:03:10.52,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:03:10.53,0:03:13.19,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:13.40,0:03:16.18,OP,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:03:16.94,0:03:21.39,OP,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:03:22.40,0:03:24.59,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:03:27.38,0:03:29.84,,NTP,0000,0000,0000,,Мысықтарға арналған үй тағамы?
Dialogue: 0,0:03:30.10,0:03:32.10,,NTP,0000,0000,0000,,Мен Чиге біраз жасауды ойладым.
Dialogue: 0,0:03:33.25,0:03:36.97,,NTP,0000,0000,0000,,Қараңдар, бұл денсаулыққа пайдалы дейді.
Dialogue: 0,0:03:37.25,0:03:39.85,,NTP,0000,0000,0000,,Эй, бұл қызықты көрінеді.
Dialogue: 0,0:03:40.06,0:03:41.65,,NTP,0000,0000,0000,,Nyanichiterunra?
Dialogue: 0,0:03:42.06,0:03:46.28,,NTP,0000,0000,0000,,О, Чи Чи, мен де дәмді тамақ жегім келеді.
Dialogue: 0,0:03:51.26,0:03:53.47,,NTP,0000,0000,0000,,Аяқтаған соң, осында әкеліңіз.
Dialogue: 0,0:03:54.03,0:03:56.87,,NTP,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:04:00.53,0:04:02.34,,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:02.72,0:04:05.30,,NTP,0000,0000,0000,,Чи, мен мұны біраз уақыттан кейін жасай аламын.
Dialogue: 0,0:04:06.54,0:04:08.15,,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:09.18,0:04:12.00,,NTP,0000,0000,0000,,Түсіндім – сіз оны шынымен күтесіз бе?
Dialogue: 0,0:04:17.98,0:04:19.92,,NTP,0000,0000,0000,,Қызық, қайнап бітті ме?
Dialogue: 0,0:04:27.94,0:04:29.88,,NTP,0000,0000,0000,,А, дәмді нәрсе ме?
Dialogue: 0,0:04:31.14,0:04:32.91,,NTP,0000,0000,0000,,Бұл аяқталды!
Dialogue: 0,0:04:35.78,0:04:36.87,,NTP,0000,0000,0000,,Хорай
Dialogue: 0,0:04:37.02,0:04:40.79,,NTP,0000,0000,0000,,Ааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:44.47,0:04:46.13,,NTP,0000,0000,0000,,Шорай (хорай)
Dialogue: 0,0:04:46.35,0:04:51.05,,NTP,0000,0000,0000,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:50.80,0:04:54.37,,NTP,0000,0000,0000,,Шорай Чорай Ей Чорай Чорай
Dialogue: 0,0:04:51.63,0:04:53.53,,NTP,0000,0000,0000,,Бұл да қазірдің өзінде
Dialogue: 0,0:04:52.96,0:04:54.27,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:53.90,0:04:56.23,,NTP,0000,0000,0000,,Уау, мінекей.
Dialogue: 0,0:04:56.05,0:04:57.03,,NTP,0000,0000,0000,,Чи күт
Dialogue: 0,0:04:56.86,0:04:59.33,,NTP,0000,0000,0000,,Шорай Чорай Ана
Dialogue: 0,0:04:58.80,0:05:03.24,,NTP,0000,0000,0000,,Мен Чиге тамақ жасап жатырмын. Йохе маған да көмектесіңізші.
Dialogue: 0,0:05:01.44,0:05:03.69,,NTP,0000,0000,0000,,Эй, сәлем
Dialogue: 0,0:05:07.19,0:05:09.51,,NTP,0000,0000,0000,,Мен қолымнан келгенше Чиге қамқор болыңыз.
Dialogue: 0,0:05:10.00,0:05:10.81,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:13.45,0:05:17.35,,NTP,0000,0000,0000,,Орындалды. Иә, Чи. Күткеніңізге рахмет.
Dialogue: 0,0:05:18.61,0:05:19.68,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:24.13,0:05:25.99,,NTP,0000,0000,0000,,Жақсы иіс!
Dialogue: 0,0:05:28.55,0:05:30.03,,NTP,0000,0000,0000,,Ыстық Раа
Dialogue: 0,0:05:32.88,0:05:34.07,,NTP,0000,0000,0000,,Міне.
Dialogue: 0,0:05:34.91,0:05:37.00,,NTP,0000,0000,0000,,А, мен оны суытуды ұмытып кетіппін.
Dialogue: 0,0:05:37.27,0:05:40.30,,NTP,0000,0000,0000,,Дұрыс, мысықтарда мысық тілдері болған.
Dialogue: 0,0:05:44.54,0:05:46.10,,NTP,0000,0000,0000,,Кешіріңіз Чи
Dialogue: 0,0:05:46.78,0:05:48.82,,NTP,0000,0000,0000,,Чи ашулы.
Dialogue: 0,0:05:49.02,0:05:50.02,,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:54.02,0:05:56.66,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:05:56.81,0:05:59.56,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:06:00.15,0:06:06.55,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:06:06.58,0:06:09.16,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:09.43,0:06:12.21,OP,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:06:12.88,0:06:16.94,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:06:18.50,0:06:20.28,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:06:30.74,0:06:32.03,,NTP,0000,0000,0000,,Мұнда не болып жатыр?
Dialogue: 0,0:06:43.43,0:06:44.71,,NTP,0000,0000,0000,,Кеппенлер
Dialogue: 0,0:06:52.59,0:06:54.33,,NTP,0000,0000,0000,,Ойчи иісі (дәмді иіс)
Dialogue: 0,0:06:58.42,0:07:00.31,,NTP,0000,0000,0000,,Тойы (қызықты)
Dialogue: 0,0:07:10.40,0:07:11.25,,NTP,0000,0000,0000,,Кайкая
Dialogue: 0,0:07:11.69,0:07:14.11,,NTP,0000,0000,0000,,Көп нәрсе
Dialogue: 0,0:07:17.85,0:07:19.16,,NTP,0000,0000,0000,,Понпона
Dialogue: 0,0:07:23.07,0:07:24.98,,NTP,0000,0000,0000,,Чиді тамақтандыру уақыты келді.
Dialogue: 0,0:07:29.31,0:07:31.74,,NTP,0000,0000,0000,,Бұл ірімшік күріш.
Dialogue: 0,0:07:32.34,0:07:33.70,,NTP,0000,0000,0000,,Қызық, не болды?
Dialogue: 0,0:07:34.85,0:07:37.37,,NTP,0000,0000,0000,,Е, Ци тамақ ішпейді.
Dialogue: 0,0:07:37.80,0:07:39.20,,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:07:40.25,0:07:44.61,,NTP,0000,0000,0000,,Иә, қара! Бұл ең жоғары сапалы гурман консерві.
Dialogue: 0,0:07:48.12,0:07:50.79,,NTP,0000,0000,0000,,Бұл әлі де жеткіліксіз бе?
Dialogue: 0,0:07:51.75,0:07:53.84,,NTP,0000,0000,0000,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:08:01.26,0:08:02.85,,NTP,0000,0000,0000,,Соңғы жебеге айналғанша...
Dialogue: 0,0:08:09.09,0:08:11.78,,NTP,0000,0000,0000,,Кайкайкайкай
Dialogue: 0,0:08:23.18,0:08:23.78,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:08:31.86,0:08:34.02,,NTP,0000,0000,0000,,Көптеген адамдар
Dialogue: 0,0:08:34.83,0:08:37.51,,NTP,0000,0000,0000,,Сіз осындай жерде тамақтанатын болдыңыз.
Dialogue: 0,0:08:37.67,0:08:40.21,,NTP,0000,0000,0000,,Сол себепті тамақ ішпедің.
Dialogue: 0,0:08:42.41,0:08:45.92,,NTP,0000,0000,0000,,Бұл керемет, Чи оны тапты.
Dialogue: 0,0:08:50.05,0:08:52.67,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.87,0:08:55.64,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:08:55.97,0:09:02.49,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:09:02.63,0:09:05.30,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:05.34,0:09:08.21,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:09:08.66,0:09:12.98,OP,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:09:14.47,0:09:16.44,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:09:19.48,0:09:21.46,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:21.14,0:09:22.34,,NTP,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:09:24.25,0:09:26.05,,NTP,0000,0000,0000,,Бүгін тамаша.
Dialogue: 0,0:09:35.90,0:09:38.05,,NTP,0000,0000,0000,,Йохеи Барлығы осы.
Dialogue: 0,0:09:39.91,0:09:42.35,,NTP,0000,0000,0000,,Бұл? Бұл қасық
Dialogue: 0,0:09:44.47,0:09:46.84,,NTP,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:09:50.81,0:09:52.29,,NTP,0000,0000,0000,,Тек иіс
Dialogue: 0,0:09:53.08,0:09:55.30,,NTP,0000,0000,0000,,Бұл чаванмуши де дәмді.
Dialogue: 0,0:09:55.79,0:09:56.58,,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:10:00.98,0:10:04.77,,NTP,0000,0000,0000,,Не? Бұл?
Dialogue: 0,0:10:05.42,0:10:06.95,,NTP,0000,0000,0000,,Ойчиино
Dialogue: 0,0:10:08.14,0:10:09.15,,NTP,0000,0000,0000,,Кішкене ғана.
Dialogue: 0,0:10:13.09,0:10:14.60,,NTP,0000,0000,0000,,Ойчи
Dialogue: 0,0:10:15.25,0:10:19.79,,NTP,0000,0000,0000,,Чи, оны жегің келе ме? Бұл дәмді.
Dialogue: 0,0:10:22.33,0:10:23.07,,NTP,0000,0000,0000,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:10:27.67,0:10:29.30,,NTP,0000,0000,0000,,Oichii
Dialogue: 0,0:10:31.90,0:10:36.75,,NTP,0000,0000,0000,,Мына жерде таудай ас бар.
Dialogue: 0,0:10:38.96,0:10:40.42,,NTP,0000,0000,0000,,Бұл да дәмді.
Dialogue: 0,0:10:40.54,0:10:41.64,,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:10:41.91,0:10:43.64,,NTP,0000,0000,0000,,Иә, рахмет
Dialogue: 0,0:10:43.82,0:10:45.15,,NTP,0000,0000,0000,,Қайтадан жасаңыз
Dialogue: 0,0:10:45.26,0:10:46.03,,NTP,0000,0000,0000,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:10:51.47,0:10:52.94,,NTP,0000,0000,0000,,Сіз мұны әлі де қалайсыз ба?
Dialogue: 0,0:10:53.51,0:10:55.85,,NTP,0000,0000,0000,,Мен тым көп нәрсені бердім деп ойлаймын.
Dialogue: 0,0:10:56.33,0:10:58.90,,NTP,0000,0000,0000,,Чиге тамақ беру дұрыс емес пе?
Dialogue: 0,0:10:59.68,0:11:01.98,,NTP,0000,0000,0000,,Адамның тағамында
Dialogue: 0,0:11:02.29,0:11:04.95,,NTP,0000,0000,0000,,Мысықтар жеуге болмайтын тағамдар бар.
Dialogue: 0,0:11:05.59,0:11:07.71,,NTP,0000,0000,0000,,Мя мерекесі
Dialogue: 0,0:11:08.05,0:11:09.14,,NTP,0000,0000,0000,,Жоқ, жоқ
Dialogue: 0,0:11:09.84,0:11:11.98,,NTP,0000,0000,0000,,Чи де тойлайды
Dialogue: 0,0:11:13.85,0:11:15.15,,NTP,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:11:17.33,0:11:18.20,,NTP,0000,0000,0000,,Иә Qi
Dialogue: 0,0:11:24.55,0:11:26.18,,NTP,0000,0000,0000,,Иә Чи күріші
Dialogue: 0,0:11:27.26,0:11:28.91,,NTP,0000,0000,0000,,Мереке
Dialogue: 0,0:11:30.32,0:11:32.87,,NTP,0000,0000,0000,,Мазмұны әдеттегідей.
Dialogue: 0,0:11:37.09,0:11:39.97,,NTP,0000,0000,0000,,Жақсы тамақ!
Dialogue: 0,0:11:45.99,0:11:48.70,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.82,0:11:51.61,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:11:51.97,0:11:58.70,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:11:58.78,0:12:01.29,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:12:01.30,0:12:04.31,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:12:04.77,0:12:08.94,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:12:10.66,0:12:13.18,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:12:18.01,0:12:20.21,,NTP,0000,0000,0000,,Иә? Бұл Чидің шашы ма?
Dialogue: 0,0:12:22.65,0:12:26.44,,NTP,0000,0000,0000,,Qi, не болды? Сіз қышисыз ба?
Dialogue: 0,0:12:26.55,0:12:30.20,,NTP,0000,0000,0000,,Әй, әке, бұл арқа не болды?
Dialogue: 0,0:12:35.69,0:12:37.88,,NTP,0000,0000,0000,,Уау, бұл керемет шаш.
Dialogue: 0,0:12:38.31,0:12:40.23,,NTP,0000,0000,0000,,Шаш өсетін мезгіл емес пе?
Dialogue: 0,0:12:40.97,0:12:44.00,,NTP,0000,0000,0000,,Мен щеткамен тазалауым керек пе?
Dialogue: 0,0:12:45.37,0:12:46.40,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:12:50.28,0:12:53.82,,NTP,0000,0000,0000,,Мен сізге тәттілер жібердім, менімен бірге алғыңыз келе ме?
Dialogue: 0,0:12:54.61,0:12:56.07,,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:12:56.57,0:12:57.43,,NTP,0000,0000,0000,,Күннің ортасында
Dialogue: 0,0:12:57.65,0:12:59.86,,NTP,0000,0000,0000,,Иә? Ішінде? !
Dialogue: 0,0:13:00.02,0:13:03.64,,NTP,0000,0000,0000,,Әй, дәл қазір әбігерге түстің.
Dialogue: 0,0:13:03.69,0:13:05.52,,NTP,0000,0000,0000,,Жақсы, ол үшін уайымдама.
Dialogue: 0,0:13:05.92,0:13:06.95,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:07.29,0:13:11.32,,NTP,0000,0000,0000,,А, егер олар оны тауып алса, қауіпті болар еді. Оны қайда жасыруым керек?
Dialogue: 0,0:13:12.49,0:13:14.56,,NTP,0000,0000,0000,,Әке, сіз не істеп жатырсыз?
Dialogue: 0,0:13:14.62,0:13:16.70,,NTP,0000,0000,0000,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:13:17.10,0:13:19.04,,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:13:19.44,0:13:22.20,,NTP,0000,0000,0000,,Бәрі шешілген сияқты.
Dialogue: 0,0:13:22.62,0:13:23.83,,NTP,0000,0000,0000,,Диванға барыңыз.
Dialogue: 0,0:13:25.12,0:13:28.79,,NTP,0000,0000,0000,,Қараңдар, екеуің отырыңдар. Бұл дәмді.
Dialogue: 0,0:13:29.41,0:13:32.49,,NTP,0000,0000,0000,,Ахаха мен қазір диетадамын.
Dialogue: 0,0:13:32.77,0:13:34.59,,NTP,0000,0000,0000,,Кем дегенде біреуі жақсы.
Dialogue: 0,0:13:35.01,0:13:36.62,,NTP,0000,0000,0000,,Иә, дұрыс айтасың.
Dialogue: 0,0:13:36.84,0:13:38.48,,NTP,0000,0000,0000,,Әдемі құс
Dialogue: 0,0:13:38.72,0:13:39.24,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:13:39.74,0:13:40.65,,NTP,0000,0000,0000,,Мына жаққа қара.
Dialogue: 0,0:13:41.11,0:13:42.69,,NTP,0000,0000,0000,,Е, қайда?
Dialogue: 0,0:13:43.27,0:13:44.49,,NTP,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:13:44.97,0:13:47.14,,NTP,0000,0000,0000,,Еш жерде құстар жоқ.
Dialogue: 0,0:13:47.79,0:13:49.19,,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:13:49.35,0:13:50.46,,NTP,0000,0000,0000,,Йохе, өтінемін
Dialogue: 0,0:13:53.95,0:13:59.27,,NTP,0000,0000,0000,,Уау, бұл дәмді. Менде бар.
Dialogue: 0,0:13:59.37,0:14:01.23,,NTP,0000,0000,0000,,Иә, мен шай қайнатуым керек.
Dialogue: 0,0:14:07.57,0:14:08.83,,NTP,0000,0000,0000,,Ас үшін рахмет.
Dialogue: 0,0:14:09.24,0:14:11.07,,NTP,0000,0000,0000,,Олай болса, Йохэй-чанға сәлем айтыңыз.
Dialogue: 0,0:14:13.84,0:14:14.74,,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,0:14:15.09,0:14:16.14,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:14:16.51,0:14:19.17,,NTP,0000,0000,0000,,Цидің шашы шаңды.
Dialogue: 0,0:14:19.84,0:14:22.69,,NTP,0000,0000,0000,,Ой, жарайды, мен бәрібір қарапайым киім киемін.
Dialogue: 0,0:14:22.92,0:14:23.77,,NTP,0000,0000,0000,,Жақында болады.
Dialogue: 0,0:14:28.68,0:14:30.95,,NTP,0000,0000,0000,,Олар Чи туралы білмеді.
Dialogue: 0,0:14:31.09,0:14:33.30,,NTP,0000,0000,0000,,Менің ойымша, бұл жақсы болды.
Dialogue: 0,0:14:33.86,0:14:36.04,,NTP,0000,0000,0000,,Маған бұл шашқа бірдеңе жасау керек.
Dialogue: 0,0:14:42.07,0:14:44.76,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.86,0:14:47.60,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:14:48.09,0:14:54.65,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:14:54.66,0:14:57.36,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:14:57.65,0:15:00.31,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:15:00.88,0:15:05.09,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:15:06.44,0:15:09.21,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:15:12.50,0:15:14.75,,NTP,0000,0000,0000,,Чи, қышидың ба?
Dialogue: 0,0:15:17.67,0:15:18.89,,NTP,0000,0000,0000,,Не? !
Dialogue: 0,0:15:19.52,0:15:23.67,,NTP,0000,0000,0000,,Күтіңіз хахаха чи хахаха чи
Dialogue: 0,0:15:24.72,0:15:27.12,,NTP,0000,0000,0000,,Йохеи Бұл қылқалам
Dialogue: 0,0:15:28.04,0:15:29.79,,NTP,0000,0000,0000,,Чиге қылқалам беріңіз
Dialogue: 0,0:15:31.40,0:15:34.61,,NTP,0000,0000,0000,,Бұл қымбат, сондықтан оны мысық щеткасы ретінде пайдаланбаңыз.
Dialogue: 0,0:15:38.63,0:15:39.28,,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:15:40.05,0:15:42.02,,NTP,0000,0000,0000,,Бұл мысық щеткасы ма?
Dialogue: 0,0:15:42.52,0:15:44.64,,NTP,0000,0000,0000,,Металл пластик резеңке
Dialogue: 0,0:15:44.82,0:15:48.29,,NTP,0000,0000,0000,,Тұтқаны бар, бірақ тұтқасы жоқ Бұл қолғаптың ыңғайлы түрі
Dialogue: 0,0:15:48.61,0:15:51.98,,NTP,0000,0000,0000,,Мысықтардың өздеріне үйкейтін заттары да бар.
Dialogue: 0,0:15:52.72,0:15:55.57,,NTP,0000,0000,0000,,Ал, қайсысын сатып алуым керек?
Dialogue: 0,0:15:55.78,0:15:59.81,,NTP,0000,0000,0000,,Менің ойымша, бұл жұмсақ бөлік жақсы.
Dialogue: 0,0:16:02.11,0:16:05.92,,NTP,0000,0000,0000,,Чи, кел, мен сені тазалаймын.
Dialogue: 0,0:16:06.68,0:16:07.40,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:16:09.85,0:16:13.47,,NTP,0000,0000,0000,,Иә? Иә
Dialogue: 0,0:16:16.73,0:16:17.85,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:16:17.16,0:16:19.29,,NTP,0000,0000,0000,,Қараңдаршы, бұл қылқалам.
Dialogue: 0,0:16:22.88,0:16:26.84,,NTP,0000,0000,0000,,Қараңдаршы, Куши Куши
Dialogue: 0,0:16:29.05,0:16:33.42,,NTP,0000,0000,0000,,Куши Куши Куши
Dialogue: 0,0:16:33.67,0:16:35.49,,NTP,0000,0000,0000,,Кусушии
Dialogue: 0,0:16:44.37,0:16:46.12,,NTP,0000,0000,0000,,Маған бұл ұнайды
Dialogue: 0,0:17:04.07,0:17:12.31,,NTP,0000,0000,0000,,Ци, мен мұны білемін, уф, бұл не?
Dialogue: 0,0:17:14.25,0:17:15.93,,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:17:17.78,0:17:18.88,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:17:19.96,0:17:21.14,,NTP,0000,0000,0000,,Бұл жақсы сезінеді.
Dialogue: 0,0:17:23.22,0:17:26.33,,NTP,0000,0000,0000,,Әкем көбірек
Dialogue: 0,0:17:26.60,0:17:27.43,,NTP,0000,0000,0000,,Жарайды, жарайды
Dialogue: 0,0:17:31.99,0:17:33.95,,NTP,0000,0000,0000,,Маған бұл ұнайды
Dialogue: 0,0:17:38.18,0:17:40.75,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:17:40.96,0:17:43.71,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:17:44.07,0:17:50.65,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:17:50.81,0:17:53.28,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:17:53.46,0:17:56.30,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:17:56.95,0:18:01.04,OP,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:18:02.42,0:18:05.25,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:18:06.83,0:18:08.71,,NTP,0000,0000,0000,,Тарақ
Dialogue: 0,0:18:12.75,0:18:13.80,,NTP,0000,0000,0000,,Қараңызшы, Чи.
Dialogue: 0,0:18:17.17,0:18:18.83,,NTP,0000,0000,0000,,Әке, жоқ.
Dialogue: 0,0:18:19.63,0:18:20.53,,NTP,0000,0000,0000,,Хоора хора
Dialogue: 0,0:18:20.58,0:18:21.76,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:18:20.96,0:18:21.55,,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:18:22.47,0:18:23.49,,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:18:23.37,0:18:24.43,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:18:23.73,0:18:25.05,,NTP,0000,0000,0000,,Менің ойымша, сіз ойнағыңыз келді
Dialogue: 0,0:18:26.45,0:18:28.27,,NTP,0000,0000,0000,,Бұл қызық
Dialogue: 0,0:18:30.23,0:18:31.39,,NTP,0000,0000,0000,,Бұл басқаша
Dialogue: 0,0:18:32.62,0:18:34.39,,NTP,0000,0000,0000,,Тарақ
Dialogue: 0,0:18:34.50,0:18:36.74,,NTP,0000,0000,0000,,Не, одан шаршадың ба?
Dialogue: 0,0:18:39.78,0:18:41.75,,NTP,0000,0000,0000,,Тарақ
Dialogue: 0,0:18:42.96,0:18:44.67,,NTP,0000,0000,0000,,Ана Ана
Dialogue: 0,0:18:44.96,0:18:45.52,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:18:45.75,0:18:49.27,,NTP,0000,0000,0000,,Білесің бе, Чи көңілді.
Dialogue: 0,0:18:49.38,0:18:50.06,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:18:50.11,0:18:52.70,,NTP,0000,0000,0000,,Мен тек әкеме жабысамын.
Dialogue: 0,0:18:52.92,0:18:53.95,,NTP,0000,0000,0000,,Әкеңе?
Dialogue: 0,0:18:53.97,0:18:54.65,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:56.24,0:18:56.68,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:01.27,0:19:01.89,,NTP,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:19:01.96,0:19:02.65,,NTP,0000,0000,0000,,О.
Dialogue: 0,0:19:08.79,0:19:10.63,,NTP,0000,0000,0000,,Бұл тағы да рас.
Dialogue: 0,0:19:11.96,0:19:15.07,,NTP,0000,0000,0000,,Кушикуши, әкесі.
Dialogue: 0,0:19:15.22,0:19:16.92,,NTP,0000,0000,0000,,Қызық, Чиге не болды?
Dialogue: 0,0:19:17.00,0:19:20.19,,NTP,0000,0000,0000,,Ахаха, ақыры маған байланып қалдың.
Dialogue: 0,0:19:20.30,0:19:21.38,,NTP,0000,0000,0000,,Әртүрлі
Dialogue: 0,0:19:21.52,0:19:21.91,,NTP,0000,0000,0000,,Оро
Dialogue: 0,0:19:22.06,0:19:22.87,,NTP,0000,0000,0000,,О.
Dialogue: 0,0:19:24.03,0:19:27.29,,NTP,0000,0000,0000,,Әй, әке.
Dialogue: 0,0:19:27.89,0:19:29.13,,NTP,0000,0000,0000,,Олар
Dialogue: 0,0:19:31.45,0:19:35.58,,NTP,0000,0000,0000,,Әкеңе байланғаннан гөрі, мысық щеткаларын ұнататын сияқтысың.
Dialogue: 0,0:19:36.49,0:19:37.31,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:19:38.71,0:19:40.36,,NTP,0000,0000,0000,,Чидің арқасы бұрылған.
Dialogue: 0,0:19:40.78,0:19:42.15,,NTP,0000,0000,0000,,Сіз күтіп тұрған сияқтысыз.
Dialogue: 0,0:19:48.26,0:19:55.26,,NTP,0000,0000,0000,,Тарақ, Тарақ, Тарақ, Тарақ, Тарақ, Тарақ
Dialogue: 0,0:19:55.55,0:20:00.52,,NTP,0000,0000,0000,,Кушикуши Кушикуши Кушикуши Кушикуши
Dialogue: 0,0:20:00.82,0:20:05.32,,NTP,0000,0000,0000,,Кушикуши Кушикуши Кушикуши Кушикуши
Dialogue: 0,0:20:05.74,0:20:08.18,,NTP,0000,0000,0000,,Куши Куши
Dialogue: 0,0:20:12.50,0:20:18.89,,NTP,0000,0000,0000,,Менің қолым шаршады. Ой, ақыры қанағаттандың ба?
Dialogue: 0,0:20:19.65,0:20:20.83,,NTP,0000,0000,0000,,Мұнда да
Dialogue: 0,0:20:23.47,0:20:25.10,,NTP,0000,0000,0000,,Енді оң жақта ма?
Dialogue: 0,0:20:28.39,0:20:30.55,,NTP,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:20:34.10,0:20:36.73,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:20:36.87,0:20:39.79,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:20:40.07,0:20:46.69,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:20:47.01,0:20:49.36,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:20:49.46,0:20:52.48,OP,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:20:52.97,0:20:57.31,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:20:58.60,0:21:01.30,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:21:03.07,0:21:05.03,,NTP,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:21:07.17,0:21:12.56,,NTP,0000,0000,0000,,Жарайды, солай. Менің жұмысым бар. Бүгінгі күннің бәрі осы.
Dialogue: 0,0:21:13.20,0:21:14.48,,NTP,0000,0000,0000,,Қосымша
Dialogue: 0,0:21:15.11,0:21:20.61,,NTP,0000,0000,0000,,О, бұл керемет. Мен де бүгін «көрпе» алдым. Чи
Dialogue: 0,0:21:37.15,0:21:39.16,,NTP,0000,0000,0000,,Йохеи не болды?
Dialogue: 0,0:21:42.61,0:21:46.74,,NTP,0000,0000,0000,,Бұл Чи екеуміздің арамыздағы құпия. Қарашы, бұл түкті доп, Чи.
Dialogue: 0,0:21:47.09,0:21:47.92,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:49.78,0:21:52.83,,NTP,0000,0000,0000,,Сырдың иісі
Dialogue: 0,0:21:57.54,0:22:00.12,,NTP,0000,0000,0000,,Енді Qi жоқ, ол бұзылады.
Dialogue: 0,0:22:00.95,0:22:05.61,,NTP,0000,0000,0000,,Чи-Чи Мяаааааааааааааааааааааа
Dialogue: 0,0:22:08.68,0:22:09.84,,NTP,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:22:10.41,0:22:12.74,,NTP,0000,0000,0000,,Йохеи Монополиясы Рамера
Dialogue: 0,0:22:40.43,0:22:41.40,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:22:46.67,0:22:52.35,,NTP,0000,0000,0000,,О, бұл Йохай ма?
Dialogue: 0,0:22:53.22,0:22:53.68,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:22:54.07,0:22:55.42,,NTP,0000,0000,0000,,Допқа ұқсайды
Dialogue: 0,0:22:55.98,0:22:57.23,,NTP,0000,0000,0000,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:22:57.52,0:22:58.50,,NTP,0000,0000,0000,,Не ол?
Dialogue: 0,0:22:59.65,0:23:01.57,,NTP,0000,0000,0000,,Цидің шашынан жасалған болса керек.
Dialogue: 0,0:23:02.13,0:23:02.90,,NTP,0000,0000,0000,,Енді сен агент емессің.
Dialogue: 0,0:23:03.51,0:23:08.13,,NTP,0000,0000,0000,,Бірақ сіз оны қашан жасай бастадыңыз? Бұл шынымен жақсы жасалған
Dialogue: 0,0:23:09.61,0:23:12.90,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:23:16.07,0:23:17.05,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:23:17.21,0:23:19.05,,NTP,0000,0000,0000,,Мен оны жасау үшін қиналсам да.
Dialogue: 0,0:23:19.24,0:23:21.48,,NTP,0000,0000,0000,,Тазалау қиын.
Dialogue: 0,0:23:21.64,0:23:26.79,,NTP,0000,0000,0000,,Яй, мочиои (қызықты)
Dialogue: 0,0:23:30.18,0:23:32.88,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:23:32.94,0:23:35.84,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:23:36.11,0:23:42.83,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:23:42.89,0:23:45.48,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:23:45.63,0:23:48.41,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:23:48.85,0:23:53.50,OP,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:23:54.64,0:23:57.29,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:23:58.88,0:24:00.54,,NTP,0000,0000,0000,,Йохай Ойнайық
Dialogue: 0,0:24:00.63,0:24:02.14,,NTP,0000,0000,0000,,Ци ойынын ойнайық
Dialogue: 0,0:24:04.35,0:24:05.62,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:24:05.76,0:24:10.67,,NTP,0000,0000,0000,,Чи, бұл жаңа құрылыс блоктары. Бірге құпия базаны құрайық.
Dialogue: 0,0:24:16.62,0:24:17.39,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:24:18.44,0:24:25.80,,NTP,0000,0000,0000,,Чи қызық па? Мен көмектесе алмаймын
Dialogue: 0,0:24:29.45,0:24:31.20,,NTP,0000,0000,0000,,Мочирой (қызықты)
Dialogue: 0,0:24:33.32,0:24:35.35,,NTP,0000,0000,0000,,Қараңызшы, Чи керемет көрінеді!
Dialogue: 0,0:24:36.37,0:24:38.59,,NTP,0000,0000,0000,,Йохай Раку Чио
Dialogue: 0,0:24:47.06,0:24:48.82,,NTP,0000,0000,0000,,Күлкілі болса да (күлкілі болса да)
Dialogue: 0,0:24:58.11,0:25:01.54,,NTP,0000,0000,0000,,Йохеи Қараңызшы, қызық екен.
Dialogue: 0,0:25:03.75,0:25:06.80,,NTP,0000,0000,0000,,Қараңызшы, бұл өте қымбат.
Dialogue: 0,0:25:06.89,0:25:10.71,,NTP,0000,0000,0000,,Эй, Йохеи, бұл өте ретсіз.
Dialogue: 0,0:25:17.55,0:25:20.57,,NTP,0000,0000,0000,,Гуру Гуру Лулу
Dialogue: 0,0:25:21.86,0:25:27.07,,NTP,0000,0000,0000,,Ойбай-ау, сен көп тәртіпсіздік жасадың. Тазалап болған соң, тамақ ішу уақыты келді.
Dialogue: 0,0:25:28.25,0:25:29.14,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:25:32.23,0:25:34.78,,NTP,0000,0000,0000,,Бүгін қандай тағамдар бар?
Dialogue: 0,0:25:37.50,0:25:38.84,,NTP,0000,0000,0000,,Бұл жерде өте жақсы
Dialogue: 0,0:25:39.21,0:25:41.28,,NTP,0000,0000,0000,,Ци Кірме
Dialogue: 0,0:25:41.37,0:25:42.33,,NTP,0000,0000,0000,,Енгізу
Dialogue: 0,0:25:42.89,0:25:44.23,,NTP,0000,0000,0000,,Чидами
Dialogue: 0,0:25:44.48,0:25:46.36,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:26:05.82,0:26:07.79,,NTP,0000,0000,0000,,Йохеи Орындалды.
Dialogue: 0,0:26:10.73,0:26:11.66,,NTP,0000,0000,0000,,О, құдай!
Dialogue: 0,0:26:15.89,0:26:17.86,,NTP,0000,0000,0000,,Чи көңілді.
Dialogue: 0,0:26:18.01,0:26:19.82,,NTP,0000,0000,0000,,Танохина
Dialogue: 0,0:26:26.26,0:26:28.93,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:26:29.09,0:26:31.84,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:26:32.18,0:26:38.81,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:26:39.03,0:26:41.49,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:26:41.74,0:26:44.50,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:26:45.14,0:26:49.41,OP,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:26:50.65,0:26:53.33,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:27:01.78,0:27:02.44,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:27:04.60,0:27:06.60,,NTP,0000,0000,0000,,Қандай таң қалдырды!
Dialogue: 0,0:27:06.82,0:27:08.30,,NTP,0000,0000,0000,,Тоғыз (қашу)
Dialogue: 0,0:27:18.62,0:27:22.29,,NTP,0000,0000,0000,,Эй, Йохеи мұнда жоқ.
Dialogue: 0,0:27:27.31,0:27:28.51,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:33.13,0:27:37.46,,NTP,0000,0000,0000,,Чи, сен не істеп жатырсың? Иә, бұл жасырынбақ.
Dialogue: 0,0:27:42.04,0:27:43.79,,NTP,0000,0000,0000,,Омочиой (қызықты)
Dialogue: 0,0:27:43.93,0:27:44.78,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:27:50.38,0:27:51.22,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:28:13.01,0:28:14.56,,NTP,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:28:14.98,0:28:17.69,,NTP,0000,0000,0000,,Мия, тығып ал, мия
Dialogue: 0,0:28:18.08,0:28:22.77,,NTP,0000,0000,0000,,Мен қайда жасырынуым керек? Мен қайда жасыруым керек?
Dialogue: 0,0:28:23.71,0:28:26.06,,NTP,0000,0000,0000,,Қайда жасырыну керек
Dialogue: 0,0:28:26.62,0:28:27.74,,NTP,0000,0000,0000,,Міне
Dialogue: 0,0:28:28.67,0:28:30.79,,NTP,0000,0000,0000,,Мен мұнда ештеңе таба алмаймын
Dialogue: 0,0:28:33.91,0:28:35.98,,NTP,0000,0000,0000,,Жасыру және іздеу Чи жеңеді
Dialogue: 0,0:28:38.34,0:28:40.12,,NTP,0000,0000,0000,,Мен Qi таптым.
Dialogue: 0,0:28:42.58,0:28:44.60,,NTP,0000,0000,0000,,Оны таптым
Dialogue: 0,0:28:44.63,0:28:45.11,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:28:56.69,0:29:03.19,,NTP,0000,0000,0000,,Бұл қай жерде? Youhei қайда?
Dialogue: 0,0:29:08.12,0:29:09.58,,NTP,0000,0000,0000,,Йохеиге қараңыз
Dialogue: 0,0:29:12.27,0:29:13.96,,NTP,0000,0000,0000,,Оны таптым
Dialogue: 0,0:29:15.08,0:29:17.73,,NTP,0000,0000,0000,,Жасырынбақ таночи
Dialogue: 0,0:29:22.28,0:29:25.03,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:29:25.22,0:29:27.82,OP,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:29:28.19,0:29:34.90,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:29:35.05,0:29:37.47,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:29:37.78,0:29:40.61,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:29:41.19,0:29:45.61,OP,NTP,0000,0000,0000,,Бақытты жатып
Dialogue: 0,0:29:46.73,0:29:49.39,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:29:50.88,0:29:53.23,,NTP,0000,0000,0000,,Жасыру және ойнау
Dialogue: 0,0:29:53.65,0:29:55.73,,NTP,0000,0000,0000,,Бұл жеткілікті ме?
Dialogue: 0,0:30:01.06,0:30:03.27,,NTP,0000,0000,0000,,Бұл жеткілікті ме?
Dialogue: 0,0:30:03.38,0:30:04.98,,NTP,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:30:05.86,0:30:07.99,,NTP,0000,0000,0000,,Сіз оны таба алмайсыз ба?
Dialogue: 0,0:30:08.53,0:30:11.16,,NTP,0000,0000,0000,,А Микке
Dialogue: 0,0:30:14.90,0:30:19.25,,NTP,0000,0000,0000,,Бұл жеткілікті. Чи қайда?
Dialogue: 0,0:30:20.48,0:30:26.69,,NTP,0000,0000,0000,,Бұл жерде ме? Мұнда ма? Ол қайда?
Dialogue: 0,0:30:28.52,0:30:29.66,,NTP,0000,0000,0000,,Осылай ма?
Dialogue: 0,0:30:31.46,0:30:33.36,,NTP,0000,0000,0000,,О, ол жоқ.
Dialogue: 0,0:30:37.49,0:30:38.87,,NTP,0000,0000,0000,,Жарайды, мінекей!
Dialogue: 0,0:30:47.55,0:30:48.53,,NTP,0000,0000,0000,,Міне.
Dialogue: 0,0:30:49.62,0:30:51.17,,NTP,0000,0000,0000,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:30:58.74,0:31:00.09,,NTP,0000,0000,0000,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:31:01.21,0:31:02.78,,NTP,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:31:03.57,0:31:04.75,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:31:05.29,0:31:07.46,,NTP,0000,0000,0000,,Мама, қош келдіңіз
Dialogue: 0,0:31:08.09,0:31:09.90,,NTP,0000,0000,0000,,Бүгінгі тағам - пудинг
Dialogue: 0,0:31:10.24,0:31:11.07,,NTP,0000,0000,0000,,Пудинг
Dialogue: 0,0:31:14.57,0:31:16.66,,NTP,0000,0000,0000,,Тамақ ішкеннен кейін тісіңізді тазалап, ұйықтаңыз.
Dialogue: 0,0:31:17.44,0:31:18.32,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:31:26.00,0:31:27.37,,NTP,0000,0000,0000,,Йохеи келмейді
Dialogue: 0,0:31:29.93,0:31:35.16,,NTP,0000,0000,0000,,Ци жеңді Ци жеңеді
Dialogue: 0,0:31:41.32,0:31:43.75,,NTP,0000,0000,0000,,Жоқ, мен оны ашық қалдырдым.
Dialogue: 0,0:31:56.34,0:31:56.84,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:31:58.10,0:32:00.03,,NTP,0000,0000,0000,,Эй, сен Чиді білмейсің бе?
Dialogue: 0,0:32:00.70,0:32:01.35,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:32:01.56,0:32:05.47,,NTP,0000,0000,0000,,Ха, ұмытып кетіппін.
Dialogue: 0,0:32:10.26,0:32:12.65,,NTP,0000,0000,0000,,Чидің жеңісі
Dialogue: 0,0:32:18.30,0:32:21.04,OP,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:32:21.22,0:32:23.90,OP,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:32:24.24,0:32:30.93,OP,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:32:31.16,0:32:33.54,OP,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:32:33.69,0:32:36.70,OP,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:32:37.33,0:32:42.48,OP,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:32:42.76,0:32:45.41,OP,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:32:50.81,0:32:52.22,,NTP,0000,0000,0000,,Чимен жасырынбақ?
Dialogue: 0,0:32:53.07,0:32:57.82,,NTP,0000,0000,0000,,Иә, қызық Чи қайда жасырынып жүр?
Dialogue: 0,0:32:58.05,0:33:01.50,,NTP,0000,0000,0000,,Жарайды, бәріміз бірігіп іздесек, жақын арада табамыз.
Dialogue: 0,0:33:05.82,0:33:07.93,,NTP,0000,0000,0000,,Кокорокоро?
Dialogue: 0,0:33:08.26,0:33:11.95,,NTP,0000,0000,0000,,Чиге не болды? Ерм
Dialogue: 0,0:33:12.93,0:33:15.02,,NTP,0000,0000,0000,,Сора жасырынбақ
Dialogue: 0,0:33:16.07,0:33:17.88,,NTP,0000,0000,0000,,Йохе мен Чиді таппадым.
Dialogue: 0,0:33:20.20,0:33:22.54,,NTP,0000,0000,0000,,Ху, бұрынғыдан басқаша.
Dialogue: 0,0:33:23.48,0:33:24.74,,NTP,0000,0000,0000,,Қайта айта аласыз ба?
Dialogue: 0,0:33:26.56,0:33:31.93,,NTP,0000,0000,0000,,Чи өте алмайды. Чи жасырынбақта жеңді.
Dialogue: 0,0:33:33.48,0:33:35.28,,NTP,0000,0000,0000,,Чи еш жерде жоқ.
Dialogue: 0,0:33:38.38,0:33:41.11,,NTP,0000,0000,0000,,Ештеңе етпейді, тынышталып, ойланыңыз.
Dialogue: 0,0:33:41.35,0:33:41.90,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:33:42.91,0:33:44.76,,NTP,0000,0000,0000,,Цидің сүйікті орны қайда?
Dialogue: 0,0:33:45.33,0:33:47.99,,NTP,0000,0000,0000,,Қораптар, сөмкелер және басқа да шағын орындар
Dialogue: 0,0:33:48.70,0:33:51.85,,NTP,0000,0000,0000,,Есіктің артында немесе кірдің астында.
Dialogue: 0,0:33:52.04,0:33:54.31,,NTP,0000,0000,0000,,Маған да осындай бос орындар ұнайды.
Dialogue: 0,0:33:55.28,0:33:57.03,,NTP,0000,0000,0000,,Қалай болғанда да, көбірек іздейік.
Dialogue: 0,0:33:58.23,0:33:58.96,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:34:00.09,0:34:00.64,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:34:01.78,0:34:02.65,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:34:06.69,0:34:08.59,,NTP,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:34:11.05,0:34:14.79,,NTP,0000,0000,0000,,Мен Чиді әлі таба алмаймын, не істеуім керек?
Dialogue: 0,0:34:15.73,0:34:17.53,,NTP,0000,0000,0000,,Қайтадан ойланыңыз
Dialogue: 0,0:34:19.71,0:34:25.11,,NTP,0000,0000,0000,,Бұл жәшік сияқты, мынандай бос орын бар.
Dialogue: 0,0:34:29.92,0:34:33.13,,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:34.11,0:34:34.61,,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:34:38.20,0:34:44.17,,NTP,0000,0000,0000,,Жетеді! Чи күте алмайды! Чи күте алмайды! (Мен күте алмаймын)
Dialogue: 0,0:34:47.72,0:34:48.89,,NTP,0000,0000,0000,,Пісіру сенің хоббиің бе?
Dialogue: 0,0:34:49.50,0:34:51.51,,NTP,0000,0000,0000,,Таптым!
Dialogue: 0,0:34:56.08,0:34:58.41,,NTP,0000,0000,0000,,Чидің тығылуы ғажап
Dialogue: 0,0:34:58.59,0:35:02.22,,NTP,0000,0000,0000,,Иә, кешіріңіз, мен ұмытып қалдым, Чи.
Dialogue: 0,0:35:05.61,0:35:10.77,,NTP,0000,0000,0000,,Жасырынбақ Йохеи жеңеді - Чи жеңіледі
Dialogue: 0,0:00:00.16,0:00:01.94,,NTP,0000,0000,0000,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:00.14,0:00:01.94,,NTP,0000,0000,0000,,kamigami.org шығарған, бұл субтитр білім алмасуға арналған.
Dialogue: 0,0:00:00.14,0:00:01.94,,NTP,0000,0000,0000,,Түпнұсқа бейне өндірісін қолдайтын Киёши Вакаенің түпнұсқа жұмысы
Dialogue: 0,0:00:00.16,0:00:01.94,,NTP,0000,0000,0000,,『:』 『:』 『:&Jing Lee』 『:Dy 』 『:』
