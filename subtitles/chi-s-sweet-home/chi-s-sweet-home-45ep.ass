Dialogue: 0,0:00:30.76,0:00:38.07,,NTP,0000,0000,0000,,Мама, миа мианы ойнайық
Dialogue: 0,0:00:34.90,0:00:36.57,,NTP,0000,0000,0000,,Жүр, маған кедергі жасама.
Dialogue: 0,0:00:38.58,0:00:39.78,,NTP,0000,0000,0000,,Мұндай ештеңе жоқ
Dialogue: 0,0:00:40.28,0:00:41.92,,NTP,0000,0000,0000,,Кора Чи
Dialogue: 0,0:00:42.82,0:00:43.84,,NTP,0000,0000,0000,,№.
Dialogue: 0,0:00:45.22,0:00:47.14,,NTP,0000,0000,0000,,Ци, маған кедергі жасама.
Dialogue: 0,0:00:49.39,0:00:50.24,,NTP,0000,0000,0000,,Ах, жарай берсін—
Dialogue: 0,0:00:52.05,0:00:53.81,,NTP,0000,0000,0000,,Әке, ойнайық
Dialogue: 0,0:00:54.55,0:00:58.76,,NTP,0000,0000,0000,,Иә, иә, иә
Dialogue: 0,0:01:00.68,0:01:02.60,,NTP,0000,0000,0000,,Кора Чи
Dialogue: 0,0:01:06.13,0:01:09.17,,NTP,0000,0000,0000,,Кешіріңіз, мен жұмысты біраз уақыттан кейін бітіремін.
Dialogue: 0,0:01:09.35,0:01:11.26,,NTP,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:01:12.91,0:01:14.07,,NTP,0000,0000,0000,,Ах, жарай берсін—
Dialogue: 0,0:01:16.69,0:01:17.82,,NTP,0000,0000,0000,,Сыр сыры
Dialogue: 0,0:01:17.91,0:01:20.91,,NTP,0000,0000,0000,,Ня Юхэй Ойнайық
Dialogue: 0,0:01:21.48,0:01:23.52,,NTP,0000,0000,0000,,Чи ағып кетеді
Dialogue: 0,0:01:30.81,0:01:33.52,,NTP,0000,0000,0000,,Барлығы Чиді жалғыз қалдырды.
Dialogue: 0,0:01:36.81,0:01:37.54,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:01:37.93,0:01:38.27,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:01:38.95,0:01:40.32,,NTP,0000,0000,0000,,Жұмыс аяқталды.
Dialogue: 0,0:01:41.40,0:01:42.82,,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:01:43.76,0:01:45.39,,NTP,0000,0000,0000,,Кел, Чи, кел.
Dialogue: 0,0:01:47.10,0:01:49.63,,NTP,0000,0000,0000,,Әке, сіз ойнап жатырсыз.
Dialogue: 0,0:01:50.13,0:01:52.62,,NTP,0000,0000,0000,,Фу хи хи
Dialogue: 0,0:01:52.61,0:01:54.65,,NTP,0000,0000,0000,,Чи яши ёши
Dialogue: 0,0:01:55.01,0:01:57.37,,NTP,0000,0000,0000,,Ха, мен де Чимен ойнаймын.
Dialogue: 0,0:02:00.18,0:02:01.81,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:02:02.67,0:02:05.63,,NTP,0000,0000,0000,,Ах, бұл ұйықтаудың тамаша тәсілі.
Dialogue: 0,0:02:05.94,0:02:09.26,,NTP,0000,0000,0000,,Анашым, барлығы жиналып қалды.
Dialogue: 0,0:02:10.03,0:02:11.80,,NTP,0000,0000,0000,,Иә, бәріміз ойнайық
Dialogue: 0,0:02:12.52,0:02:15.23,,NTP,0000,0000,0000,,Мен, маған Чидің құйрығы ұнайды.
Dialogue: 0,0:02:15.29,0:02:18.93,,NTP,0000,0000,0000,,Ұшы сүйір және үлпілдек.
Dialogue: 0,0:02:20.39,0:02:21.58,,NTP,0000,0000,0000,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,0:02:21.62,0:02:23.89,,NTP,0000,0000,0000,,Тефтели жақсы ғой.
Dialogue: 0,0:02:24.14,0:02:25.61,,NTP,0000,0000,0000,,Керемет көрінеді
Dialogue: 0,0:02:25.84,0:02:28.01,,NTP,0000,0000,0000,,Бұл шынымен жақсы сезінеді, солай емес пе?
Dialogue: 0,0:02:28.43,0:02:29.85,,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:29.91,0:02:30.38,,NTP,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:02:30.86,0:02:32.73,,NTP,0000,0000,0000,,Оны басқанда шегелер шығады.
Dialogue: 0,0:02:32.80,0:02:34.69,,NTP,0000,0000,0000,,Механизм керемет көрінеді.
Dialogue: 0,0:02:35.66,0:02:37.21,,NTP,0000,0000,0000,,Ха ха ха ха ха
Dialogue: 0,0:02:38.78,0:02:39.71,,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:02:45.13,0:02:45.83,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:02:48.08,0:02:49.92,,NTP,0000,0000,0000,,Мен сені жіберсем, ұят болады
Dialogue: 0,0:02:50.38,0:02:52.72,,NTP,0000,0000,0000,,Маған қатты алаңдаған ұнамайды.
Dialogue: 0,0:03:28.58,0:03:30.19,,NTP,0000,0000,0000,,Чи, ойнаймыз ба?
Dialogue: 0,0:03:31.40,0:03:33.15,,NTP,0000,0000,0000,,Мен қазір бос емеспін.
Dialogue: 0,0:03:33.31,0:03:35.74,,NTP,0000,0000,0000,,Эй Чи, ойнайық.
Dialogue: 0,0:03:36.13,0:03:37.29,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:03:39.27,0:03:40.43,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:03:40.85,0:03:41.39,,NTP,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:03:42.13,0:03:44.15,,NTP,0000,0000,0000,,Әжем маған ашық хат жазды.
Dialogue: 0,0:03:44.63,0:03:45.42,,NTP,0000,0000,0000,,Ашықхат
Dialogue: 0,0:03:46.53,0:03:48.30,,NTP,0000,0000,0000,,Эй, оқы
Dialogue: 0,0:03:48.87,0:03:52.71,,NTP,0000,0000,0000,,«Мен ағаммен Киотоға барамын».
Dialogue: 0,0:03:53.20,0:03:54.07,,NTP,0000,0000,0000,,Киото?
Dialogue: 0,0:03:54.23,0:03:56.45,,NTP,0000,0000,0000,,Көптеген ескі храмдар мен храмдар бар
Dialogue: 0,0:03:56.47,0:03:57.61,,NTP,0000,0000,0000,,Қандай керемет жер.
Dialogue: 0,0:03:57.87,0:03:58.36,,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:03:58.78,0:04:00.10,,NTP,0000,0000,0000,,Ха~
Dialogue: 0,0:04:02.29,0:04:04.04,,NTP,0000,0000,0000,,Йохеи қалай?
Dialogue: 0,0:04:04.22,0:04:05.80,,NTP,0000,0000,0000,,Иә! Менде бәрі жақсы
Dialogue: 0,0:04:06.39,0:04:08.26,,NTP,0000,0000,0000,,Әдемі Киото
Dialogue: 0,0:04:08.78,0:04:10.20,,NTP,0000,0000,0000,,Мен ол жерге баяғыда барғанмын.
Dialogue: 0,0:04:10.43,0:04:12.58,,NTP,0000,0000,0000,,Ei? есімде жоқ
Dialogue: 0,0:04:10.93,0:04:13.53,,NTP,0000,0000,0000,,Үшеуің жалғыз не істеп жатырсыңдар?
Dialogue: 0,0:04:13.08,0:04:14.99,,NTP,0000,0000,0000,,Юхэй туылғанға дейін.
Dialogue: 0,0:04:18.75,0:04:20.60,,NTP,0000,0000,0000,,Кийомизудера - кішкентай ғибадатхана, солай ма?
Dialogue: 0,0:04:20.88,0:04:22.45,,NTP,0000,0000,0000,,Киёмизу-дера?
Dialogue: 0,0:04:22.61,0:04:23.94,,NTP,0000,0000,0000,,Бұл өте қымбат
Dialogue: 0,0:04:24.11,0:04:26.14,,NTP,0000,0000,0000,,Төмен қарасаң қорқынышты.
Dialogue: 0,0:04:29.73,0:04:31.71,,NTP,0000,0000,0000,,Бірақ табиғаты тамаша.
Dialogue: 0,0:04:33.03,0:04:35.03,,NTP,0000,0000,0000,,Тек Чи Хоттаакачи
Dialogue: 0,0:04:35.71,0:04:36.32,,NTP,0000,0000,0000,,Сора
Dialogue: 0,0:04:36.84,0:04:38.63,,NTP,0000,0000,0000,,Менің де барып көргім келеді.
Dialogue: 0,0:04:42.40,0:04:44.15,,NTP,0000,0000,0000,,Чи осында
Dialogue: 0,0:04:45.32,0:04:47.65,,NTP,0000,0000,0000,,Саяхаттағаныма біраз болды.
Dialogue: 0,0:04:48.71,0:04:49.49,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:04:51.61,0:04:54.15,,NTP,0000,0000,0000,,Менің де барғым келеді, өтінемін.
Dialogue: 0,0:04:54.27,0:04:55.14,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:04:55.15,0:04:56.97,,NTP,0000,0000,0000,,Бірге саяхаттау
Dialogue: 0,0:04:56.97,0:04:58.16,,NTP,0000,0000,0000,,Анда-санда жақсы ма?
Dialogue: 0,0:04:58.52,0:04:59.62,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:04:59.87,0:05:01.55,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:05:01.67,0:05:04.52,,NTP,0000,0000,0000,,Иә? Йохай барғысы келетін жер бар ма?
Dialogue: 0,0:05:04.96,0:05:05.94,,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:05:08.52,0:05:09.32,,NTP,0000,0000,0000,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:05:09.67,0:05:12.23,,NTP,0000,0000,0000,,Әкем сонда барып көргісі келеді.
Dialogue: 0,0:05:23.08,0:05:23.69,,NTP,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:05:23.78,0:05:25.44,,NTP,0000,0000,0000,,Мен қайдан білемін?
Dialogue: 0,0:05:26.30,0:05:28.51,,NTP,0000,0000,0000,,Онда сіз көп көңілді болуыңыз мүмкін.
Dialogue: 0,0:05:30.08,0:05:31.20,,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:05:32.21,0:05:34.25,,NTP,0000,0000,0000,,Мен жалғыз қалғанды ​​ұнатпаймын.
Dialogue: 0,0:05:35.09,0:05:36.58,,NTP,0000,0000,0000,,Qi
Dialogue: 0,0:05:36.71,0:05:38.53,,NTP,0000,0000,0000,,Мен ашық хатты көре алмаймын.
Dialogue: 0,0:05:39.19,0:05:41.72,,NTP,0000,0000,0000,,Мен сыр болсам, адамдардың маған тым көп көңіл бөлгенін қаламаймын.
Dialogue: 0,0:05:41.98,0:05:43.96,,NTP,0000,0000,0000,,Мен жалғыз қалғым келмейді.
Dialogue: 0,0:05:44.80,0:05:47.65,,NTP,0000,0000,0000,,Қысқасы, сіз ортада болғысы келетін типсіз.
Dialogue: 0,0:06:24.03,0:06:25.83,,NTP,0000,0000,0000,,Чи, жақсысың ба?
Dialogue: 0,0:06:26.28,0:06:27.91,,NTP,0000,0000,0000,,Сіз пышақты тастадыңыз ба?
Dialogue: 0,0:06:28.12,0:06:29.54,,NTP,0000,0000,0000,,Мен оны тазаладым.
Dialogue: 0,0:06:29.90,0:06:32.09,,NTP,0000,0000,0000,,Ваза - ваннаның қақпағы.
Dialogue: 0,0:06:32.42,0:06:36.24,,NTP,0000,0000,0000,,Мен Qi үшін қауіпті және тәртіпсіздік жасайтын барлық нәрселерді тазаладым.
Dialogue: 0,0:06:36.94,0:06:39.48,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:06:39.76,0:06:41.27,,NTP,0000,0000,0000,,Менің бөлмемнің есігі
Dialogue: 0,0:06:42.57,0:06:44.65,,NTP,0000,0000,0000,,Жарайды, жаптым.
Dialogue: 0,0:06:44.81,0:06:46.03,,NTP,0000,0000,0000,,Смақ!
Dialogue: 0,0:06:55.40,0:06:56.20,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:07:09.28,0:07:10.30,,NTP,0000,0000,0000,,Тыңдау
Dialogue: 0,0:07:22.59,0:07:23.66,,NTP,0000,0000,0000,,Қалқымалы фарфор
Dialogue: 0,0:07:24.06,0:07:25.56,,NTP,0000,0000,0000,,Міне, міне
Dialogue: 0,0:07:30.14,0:07:31.94,,NTP,0000,0000,0000,,Чи мұны жасады
Dialogue: 0,0:07:32.21,0:07:35.27,,NTP,0000,0000,0000,,- асото
Dialogue: 0,0:07:40.33,0:07:42.92,,NTP,0000,0000,0000,,Асото Асото Асото
Dialogue: 0,0:07:43.12,0:07:46.11,,NTP,0000,0000,0000,,Асото Асото Асото
Dialogue: 0,0:07:46.26,0:07:46.78,,NTP,0000,0000,0000,,Асо…
Dialogue: 0,0:07:48.87,0:07:49.47,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:07:54.17,0:07:55.37,,NTP,0000,0000,0000,,О
Dialogue: 0,0:07:59.68,0:08:00.22,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:08:04.45,0:08:05.18,,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:05.82,0:08:07.35,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:07.89,0:08:10.09,,NTP,0000,0000,0000,,Лалалала
Dialogue: 0,0:08:12.39,0:08:13.78,,NTP,0000,0000,0000,,Дора
Dialogue: 0,0:08:15.83,0:08:19.33,,NTP,0000,0000,0000,,А... бұл!
Dialogue: 0,0:08:19.79,0:08:21.56,,NTP,0000,0000,0000,,Жоқ… жоқ.
Dialogue: 0,0:08:22.35,0:08:26.97,,NTP,0000,0000,0000,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:08:28.98,0:08:31.01,,NTP,0000,0000,0000,,Амансың ба...Чи
Dialogue: 0,0:08:31.38,0:08:32.67,,NTP,0000,0000,0000,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:08:33.19,0:08:34.39,,NTP,0000,0000,0000,,Дұрыс па, солай емес пе?
Dialogue: 0,0:08:39.59,0:08:46.11,,NTP,0000,0000,0000,,Кім... кім көмектесе алады?
Dialogue: 0,0:09:18.99,0:09:21.19,,NTP,0000,0000,0000,,Біртүрлі нәрсе болып жатыр
Dialogue: 0,0:09:22.10,0:09:23.98,,NTP,0000,0000,0000,,Ято-чан мен басқалар қайта оралған сияқты.
Dialogue: 0,0:09:24.28,0:09:24.83,,NTP,0000,0000,0000,,Сора
Dialogue: 0,0:09:29.43,0:09:30.68,,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:09:32.01,0:09:35.61,,NTP,0000,0000,0000,,Уня
Dialogue: 0,0:09:37.31,0:09:38.91,,NTP,0000,0000,0000,,Чи...Жарайды.
Dialogue: 0,0:09:39.04,0:09:40.58,,NTP,0000,0000,0000,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:09:40.58,0:09:42.33,,NTP,0000,0000,0000,,Мен сені қадағалаймын.
Dialogue: 0,0:09:46.65,0:09:52.36,,NTP,0000,0000,0000,,Уф, жібер.
Dialogue: 0,0:09:58.96,0:10:01.24,,NTP,0000,0000,0000,,Жібер!
Dialogue: 0,0:10:04.13,0:10:06.23,,NTP,0000,0000,0000,,Ахх
Dialogue: 0,0:10:06.72,0:10:09.42,,NTP,0000,0000,0000,,Жібер!
Dialogue: 0,0:10:09.87,0:10:13.39,,NTP,0000,0000,0000,,жақсы
Dialogue: 0,0:10:18.96,0:10:21.26,,NTP,0000,0000,0000,,Біртүрлі нәрсе болып жатыр
Dialogue: 0,0:10:25.13,0:10:27.66,,NTP,0000,0000,0000,,Одан да оғаш нәрсе болып жатыр.
Dialogue: 0,0:10:30.53,0:10:32.80,,NTP,0000,0000,0000,,Мя
Dialogue: 0,0:10:34.33,0:10:34.75,,NTP,0000,0000,0000,,Мия мя
Dialogue: 0,0:10:41.66,0:10:43.31,,NTP,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:10:52.31,0:10:54.15,,NTP,0000,0000,0000,,Иә? Мен таң қалдым
Dialogue: 0,0:10:58.38,0:10:59.71,,NTP,0000,0000,0000,,Ашулану
Dialogue: 0,0:10:59.96,0:11:01.37,,NTP,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:11:11.10,0:11:12.43,,NTP,0000,0000,0000,,Чанбури
Dialogue: 0,0:11:13.80,0:11:15.02,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:11:16.73,0:11:18.88,,NTP,0000,0000,0000,,Әкемнің бөлмесінің есігі ашық.
Dialogue: 0,0:11:19.22,0:11:21.15,,NTP,0000,0000,0000,,Сіз оны жабуды ұмыттыңыз ба?
Dialogue: 0,0:11:21.73,0:11:24.06,,NTP,0000,0000,0000,,Ой... бұл не?
Dialogue: 0,0:11:24.64,0:11:26.49,,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:11:27.70,0:11:28.93,,NTP,0000,0000,0000,,Ой
Dialogue: 0,0:11:30.76,0:11:32.97,,NTP,0000,0000,0000,,Ол скотч шашқа толы.
Dialogue: 0,0:11:33.68,0:11:35.25,,NTP,0000,0000,0000,,Бұл Чидің жұмысы.
Dialogue: 0,0:11:35.80,0:11:37.91,,NTP,0000,0000,0000,,Чи?
Dialogue: 0,0:11:37.97,0:11:40.34,,NTP,0000,0000,0000,,Чи ештеңе білмейді
Dialogue: 0,0:12:19.06,0:12:20.69,,NTP,0000,0000,0000,,Йохай, ойнайық?
Dialogue: 0,0:12:21.50,0:12:22.40,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:12:27.08,0:12:28.12,,NTP,0000,0000,0000,,Йохай
Dialogue: 0,0:12:30.59,0:12:31.43,,NTP,0000,0000,0000,,Уф
Dialogue: 0,0:12:34.65,0:12:35.92,,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:12:36.71,0:12:37.93,,NTP,0000,0000,0000,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:12:38.13,0:12:39.24,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:12:39.48,0:12:40.85,,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,0:12:52.40,0:12:53.65,,NTP,0000,0000,0000,,Келесі күні
Dialogue: 0,0:13:08.38,0:13:09.88,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:13:32.78,0:13:34.10,,NTP,0000,0000,0000,,Ня
Dialogue: 0,0:13:36.28,0:13:37.40,,NTP,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:13:39.55,0:13:42.71,,NTP,0000,0000,0000,,Шөп жеп жатыр. Бұл дәмді ме?
Dialogue: 0,0:13:42.91,0:13:44.28,,NTP,0000,0000,0000,,Сіз де тамақтанғыңыз келе ме?
Dialogue: 0,0:13:46.35,0:13:47.75,,NTP,0000,0000,0000,,Дәмі нашар ма?
Dialogue: 0,0:13:49.36,0:13:51.36,,NTP,0000,0000,0000,,Әй, ей, дәмі нашар ма?
Dialogue: 0,0:13:51.84,0:13:52.93,,NTP,0000,0000,0000,,Дәмі нашар ма?
Dialogue: 0,0:13:53.84,0:13:54.75,,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:13:54.96,0:13:56.04,,NTP,0000,0000,0000,,Дәмі нашар ма?
Dialogue: 0,0:13:56.53,0:13:59.21,,NTP,0000,0000,0000,,Шөп жеу және шаш шарларын шығару
Dialogue: 0,0:13:59.67,0:14:01.34,,NTP,0000,0000,0000,,Бір кезде жақсы
Dialogue: 0,0:14:01.44,0:14:02.98,,NTP,0000,0000,0000,,Біздің жарысқа
Dialogue: 0,0:14:03.66,0:14:04.88,,NTP,0000,0000,0000,,Жарыс?
Dialogue: 0,0:14:05.76,0:14:07.67,,NTP,0000,0000,0000,,Бұл «бір дос» нәрсе.
Dialogue: 0,0:14:08.47,0:14:09.50,,NTP,0000,0000,0000,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:14:11.02,0:14:14.80,,NTP,0000,0000,0000,,Аа, сіз бен біз сияқты
Dialogue: 0,0:14:17.00,0:14:18.00,,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:14:19.54,0:14:24.10,,NTP,0000,0000,0000,,Чи Юхэйдің досы, оның әкесі және анасы.
Dialogue: 0,0:15:12.34,0:15:14.17,,NTP,0000,0000,0000,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:15:15.02,0:15:16.23,,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:15:18.43,0:15:19.79,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:15:20.41,0:15:22.68,,NTP,0000,0000,0000,,Әй, қайда барасың?
Dialogue: 0,0:15:23.10,0:15:24.15,,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:15:28.61,0:15:29.96,,NTP,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:15:35.31,0:15:36.57,,NTP,0000,0000,0000,,Жасырынбақ
Dialogue: 0,0:15:37.28,0:15:39.39,,NTP,0000,0000,0000,,Ей, тығылмақшы
Dialogue: 0,0:15:40.24,0:15:42.93,,NTP,0000,0000,0000,,Мияу
Dialogue: 0,0:15:46.00,0:15:49.15,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:04.46,0:16:05.95,,NTP,0000,0000,0000,,Мен мұны жек көремін.
Dialogue: 0,0:16:06.26,0:16:10.93,,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:16:23.88,0:16:27.51,,NTP,0000,0000,0000,,Бұл қорқынышты жасырынбақ ойыны болды.
Dialogue: 0,0:16:27.92,0:16:30.60,,NTP,0000,0000,0000,,Жасырынбақта жақсы болуым керек.
Dialogue: 0,0:16:32.38,0:16:33.81,,NTP,0000,0000,0000,,Тыныштық
Dialogue: 0,0:16:36.90,0:16:38.51,,NTP,0000,0000,0000,,Егер сіз биік жерде болсаңыз
Dialogue: 0,0:16:39.05,0:16:40.80,,NTP,0000,0000,0000,,Олар қорқынышты емес
Dialogue: 0,0:16:44.03,0:16:48.68,,NTP,0000,0000,0000,,Мя мя мя
Dialogue: 0,0:16:48.87,0:16:51.03,,NTP,0000,0000,0000,,Qi көтерілмейді
Dialogue: 0,0:16:53.13,0:16:54.12,,NTP,0000,0000,0000,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:16:55.95,0:16:58.42,,NTP,0000,0000,0000,,Ақырында сіз жоғары көтеріле аласыз.
Dialogue: 0,0:16:59.26,0:17:00.21,,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:17:01.70,0:17:05.06,,NTP,0000,0000,0000,,О, сен мысықсың ғой, солай ма?
Dialogue: 0,0:17:06.46,0:17:07.66,,NTP,0000,0000,0000,,Мысық па?
Dialogue: 0,0:17:10.27,0:17:11.11,,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:17:11.78,0:17:12.90,,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,0:17:15.29,0:17:16.72,,NTP,0000,0000,0000,,Бұл мысық емес
Dialogue: 0,0:17:17.77,0:17:18.56,,NTP,0000,0000,0000,,Бұл Чи.
Dialogue: 0,0:18:14.21,0:18:16.30,,NTP,0000,0000,0000,,Бұл қай жерде?
Dialogue: 0,0:18:20.37,0:18:21.52,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:18:23.42,0:18:25.91,,NTP,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,0:18:29.62,0:18:30.86,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:18:32.78,0:18:34.88,,NTP,0000,0000,0000,,Аумақты патрульдеу
Dialogue: 0,0:18:35.47,0:18:37.26,,NTP,0000,0000,0000,,Сіз көп жерге барасыз ба?
Dialogue: 0,0:18:37.79,0:18:39.39,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:40.61,0:18:44.38,,NTP,0000,0000,0000,,Иә, адасып қалмайсың ба?
Dialogue: 0,0:18:45.11,0:18:45.93,,NTP,0000,0000,0000,,Жоғалдың ба?
Dialogue: 0,0:18:47.30,0:18:48.53,,NTP,0000,0000,0000,,Сіз мұны айтқанда
Dialogue: 0,0:18:49.72,0:18:51.39,,NTP,0000,0000,0000,,Аспанға қара
Dialogue: 0,0:18:52.18,0:18:54.34,,NTP,0000,0000,0000,,Күн қайда екенін айтады.
Dialogue: 0,0:18:56.55,0:19:00.92,,NTP,0000,0000,0000,,Күн нұрлы
Dialogue: 0,0:19:02.55,0:19:03.40,,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:19:04.75,0:19:08.46,,NTP,0000,0000,0000,,Бұл қырылдаған дауыс.
Dialogue: 0,0:19:10.12,0:19:11.69,,NTP,0000,0000,0000,,Ци үйге барады
Dialogue: 0,0:19:21.76,0:19:23.69,,NTP,0000,0000,0000,,Мен оны жек көремін
Dialogue: 0,0:19:23.96,0:19:25.36,,NTP,0000,0000,0000,,Мұнда кел
Dialogue: 0,0:19:27.93,0:19:29.41,,NTP,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:19:33.16,0:19:34.90,,NTP,0000,0000,0000,,Иә, жасырынбақ.
Dialogue: 0,0:20:12.05,0:20:19.64,,NTP,0000,0000,0000,,жасады
Dialogue: 0,0:20:20.53,0:20:22.64,,NTP,0000,0000,0000,,Жасырынбақ керемет
Dialogue: 0,0:20:25.81,0:20:27.31,,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:20:28.72,0:20:30.63,,NTP,0000,0000,0000,,Қай үй?
Dialogue: 0,0:21:03.91,0:21:05.14,,NTP,0000,0000,0000,,Қай үй?
Dialogue: 0,0:21:07.11,0:21:07.84,,NTP,0000,0000,0000,,Мұнда?
Dialogue: 0,0:21:09.34,0:21:10.71,,NTP,0000,0000,0000,,Мұнда?
Dialogue: 0,0:21:15.94,0:21:17.40,,NTP,0000,0000,0000,,Сіз мұны айтқанда
Dialogue: 0,0:21:18.16,0:21:19.49,,NTP,0000,0000,0000,,Аспанға қара
Dialogue: 0,0:21:20.40,0:21:22.72,,NTP,0000,0000,0000,,Күн қайда екенін айтады.
Dialogue: 0,0:21:41.06,0:21:43.29,,NTP,0000,0000,0000,,Қай үй?
Dialogue: 0,0:21:53.41,0:21:54.52,,NTP,0000,0000,0000,,Әрине, осында
Dialogue: 0,0:22:00.52,0:22:01.80,,NTP,0000,0000,0000,,Үйге қайт
Dialogue: 0,0:22:11.58,0:22:12.29,,NTP,0000,0000,0000,,Мұнда
Dialogue: 0,0:22:14.71,0:22:15.90,,NTP,0000,0000,0000,,Үй осында
Dialogue: 0,0:22:21.24,0:22:21.98,,NTP,0000,0000,0000,,Мұнда
Dialogue: 0,0:22:33.35,0:22:36.66,,NTP,0000,0000,0000,,- үй
Dialogue: 0,0:22:45.97,0:22:47.45,,NTP,0000,0000,0000,,Мия
Dialogue: 0,0:22:47.52,0:22:49.31,,NTP,0000,0000,0000,,Йохе мен үйдемін
Dialogue: 0,0:22:50.88,0:22:53.88,,NTP,0000,0000,0000,,Чи, мен шытырман оқиғаға бардым.
Dialogue: 0,0:22:56.34,0:22:57.57,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:22:58.41,0:23:00.34,,NTP,0000,0000,0000,,Мама, мен үйдемін.
Dialogue: 0,0:23:00.80,0:23:01.88,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:23:02.24,0:23:04.17,,NTP,0000,0000,0000,,Әке, мен үйдемін.
Dialogue: 0,0:23:04.61,0:23:07.25,,NTP,0000,0000,0000,,О Чи, қалайсың?
Dialogue: 0,0:23:07.85,0:23:09.82,,NTP,0000,0000,0000,,Жақсы нәрсе болды ма?
Dialogue: 0,0:23:10.06,0:23:12.55,,NTP,0000,0000,0000,,Әке, ана, үйге қош келдіңіз
Dialogue: 0,0:23:14.26,0:23:15.05,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:23:19.31,0:23:21.80,,NTP,0000,0000,0000,,Чидің достары және Чидің отбасы
Dialogue: 0,0:23:23.52,0:23:25.77,,NTP,0000,0000,0000,,Барлығы қазір
Dialogue: 0,0:24:00.92,0:24:02.69,,NTP,0000,0000,0000,,Ци, мен ауруханаға барамын.
Dialogue: 0,0:24:03.66,0:24:05.85,,NTP,0000,0000,0000,,Ах, вакцинация.
Dialogue: 0,0:24:06.45,0:24:07.92,,NTP,0000,0000,0000,,Ауырудан сақтаныңыз
Dialogue: 0,0:24:08.10,0:24:09.57,,NTP,0000,0000,0000,,Мен укол алуым керек.
Dialogue: 0,0:24:09.91,0:24:11.91,,NTP,0000,0000,0000,,Йохай Ойнайық
Dialogue: 0,0:24:21.09,0:24:22.07,,NTP,0000,0000,0000,,Мен осындамын ғой?
Dialogue: 0,0:24:22.14,0:24:23.14,,NTP,0000,0000,0000,,Ах Чи
Dialogue: 0,0:24:24.74,0:24:27.53,,NTP,0000,0000,0000,,Сыртқа шығар алдында қауіпсіздікті тексеріңіз
Dialogue: 0,0:24:34.89,0:24:35.76,,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:24:40.76,0:24:42.37,,NTP,0000,0000,0000,,Құрметті әкімші
Dialogue: 0,0:24:44.78,0:24:45.99,,NTP,0000,0000,0000,,Қазір...
Dialogue: 0,0:24:46.14,0:24:47.55,,NTP,0000,0000,0000,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:24:47.78,0:24:48.45,,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:24:49.18,0:24:50.47,,NTP,0000,0000,0000,,О, Ямада мырза
Dialogue: 0,0:24:51.71,0:24:52.90,,NTP,0000,0000,0000,,Асығып шығасыз ба?
Dialogue: 0,0:24:53.09,0:24:54.35,,NTP,0000,0000,0000,,Ах... жақсы
Dialogue: 0,0:24:54.74,0:24:56.68,,NTP,0000,0000,0000,,Мүлдем емес… ол… бұл…
Dialogue: 0,0:24:57.49,0:24:59.15,,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:25:01.84,0:25:03.41,,NTP,0000,0000,0000,,Мен өзімді басқара алмадым
Dialogue: 0,0:25:03.53,0:25:06.07,,NTP,0000,0000,0000,,Өсімдіктер әдемі.
Dialogue: 0,0:25:06.28,0:25:07.92,,NTP,0000,0000,0000,,Өсімдіктер жақсы.
Dialogue: 0,0:25:08.21,0:25:10.13,,NTP,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:25:10.35,0:25:12.50,,NTP,0000,0000,0000,,Хехехе
Dialogue: 0,0:25:11.65,0:25:12.94,,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:25:14.03,0:25:15.27,,NTP,0000,0000,0000,,Бірдеңе?
Dialogue: 0,0:25:15.49,0:25:18.06,,NTP,0000,0000,0000,,Киё...бүгін ауа-райы жақсы, солай емес пе?
Dialogue: 0,0:25:18.34,0:25:20.15,,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:25:26.97,0:25:27.82,,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:25:27.43,0:25:30.39,,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:25:30.53,0:25:32.35,,NTP,0000,0000,0000,,Не? Не?
Dialogue: 0,0:25:32.79,0:25:33.73,,NTP,0000,0000,0000,,Е... анау... анау...
Dialogue: 0,0:25:33.83,0:25:35.27,,NTP,0000,0000,0000,,Сондықтан тым қатты уайымдама.
Dialogue: 0,0:25:35.65,0:25:38.16,,NTP,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:25:38.89,0:25:40.27,,NTP,0000,0000,0000,,Олай болса
Dialogue: 0,0:25:41.26,0:25:44.20,,NTP,0000,0000,0000,,О... бітті.
Dialogue: 0,0:25:49.85,0:25:51.85,,NTP,0000,0000,0000,,Сол мысық
Dialogue: 0,0:25:53.21,0:25:56.59,,NTP,0000,0000,0000,,Эй, күте тұр, күте тұр.
Dialogue: 0,0:25:58.79,0:26:00.08,,NTP,0000,0000,0000,,Өте шиеленісті, иә?
Dialogue: 0,0:26:00.15,0:26:03.08,,NTP,0000,0000,0000,,Мені күндізгі мысық құтқарды.
Dialogue: 0,0:26:05.02,0:26:08.20,,NTP,0000,0000,0000,,таңғажайып қара олжаны ұстады.
Dialogue: 0,0:26:08.83,0:26:11.26,,NTP,0000,0000,0000,,Чи немен айналысты?
Dialogue: 0,0:26:12.26,0:26:13.54,,NTP,0000,0000,0000,,Қанша
Dialogue: 0,0:26:15.53,0:26:17.15,,NTP,0000,0000,0000,,Ұстаңыз!
Dialogue: 0,0:26:18.27,0:26:22.92,,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:26:55.30,0:26:58.39,,NTP,0000,0000,0000,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:26:57.68,0:27:00.12,,NTP,0000,0000,0000,,Бүгін мен ауруханаға барамын.
Dialogue: 0,0:27:01.06,0:27:09.09,,NTP,0000,0000,0000,,Жоқ, жоқ, уау!
Dialogue: 0,0:27:00.55,0:27:02.47,,NTP,0000,0000,0000,,Ауырудан сақтаныңыз
Dialogue: 0,0:27:02.64,0:27:04.03,,NTP,0000,0000,0000,,Маған инъекция керек.
Dialogue: 0,0:27:04.35,0:27:05.67,,NTP,0000,0000,0000,,Бұл Qi үшін.
Dialogue: 0,0:27:09.71,0:27:12.00,,NTP,0000,0000,0000,,Жүр, Чи, кір.
Dialogue: 0,0:27:12.06,0:27:15.37,,NTP,0000,0000,0000,,Әке, тоқтаңыз, тоқтаңыз.
Dialogue: 0,0:27:19.28,0:27:20.22,,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:27:20.59,0:27:22.66,,NTP,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:27:23.83,0:27:25.57,,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:27:26.30,0:27:29.15,,NTP,0000,0000,0000,,Ци, шығыңыз.
Dialogue: 0,0:27:29.94,0:27:30.91,,NTP,0000,0000,0000,,Ах, жарай берсін—
Dialogue: 0,0:27:31.07,0:27:33.64,,NTP,0000,0000,0000,,Чи хахаха
Dialogue: 0,0:27:33.88,0:27:34.12,,NTP,0000,0000,0000,,Чи
Dialogue: 0,0:27:34.37,0:27:38.49,,NTP,0000,0000,0000,,Сізді ветеринарлық ауруханаға сол себетке апарады.
Dialogue: 0,0:27:39.92,0:27:41.34,,NTP,0000,0000,0000,,Менің жақсы стратегиям бар.
Dialogue: 0,0:00:00.00,0:00:00.00,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:27:43.17,0:27:44.68,,NTP,0000,0000,0000,,Чи, кел.
Dialogue: 0,0:27:45.06,0:27:46.62,,NTP,0000,0000,0000,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:27:48.47,0:27:49.27,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:27:49.53,0:27:51.24,,NTP,0000,0000,0000,,Қара, қара, қара, қара.
Dialogue: 0,0:27:51.60,0:27:53.19,,NTP,0000,0000,0000,,Иә? Себет жоқ
Dialogue: 0,0:27:53.62,0:27:55.49,,NTP,0000,0000,0000,,Қараңызшы, бұл қызық.
Dialogue: 0,0:27:57.02,0:27:58.53,,NTP,0000,0000,0000,,Чи ойнап тұр
Dialogue: 0,0:27:58.76,0:27:59.17,,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:27:59.43,0:28:00.45,,NTP,0000,0000,0000,,Әке!
Dialogue: 0,0:28:04.90,0:28:06.11,,NTP,0000,0000,0000,,Әй
Dialogue: 0,0:28:13.07,0:28:14.64,,NTP,0000,0000,0000,,Үлкен жетістік
Dialogue: 0,0:28:15.51,0:28:18.10,,NTP,0000,0000,0000,,Мама, сен мені алдың.
Dialogue: 0,0:28:18.67,0:28:20.11,,NTP,0000,0000,0000,,Мен осындамын ғой?
Dialogue: 0,0:28:22.27,0:28:27.75,,NTP,0000,0000,0000,,Ауырады
Dialogue: 0,0:28:28.11,0:28:29.66,,NTP,0000,0000,0000,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:28:33.52,0:28:34.36,,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:28:36.50,0:28:38.16,,NTP,0000,0000,0000,,Дайвинг
Dialogue: 0,0:28:45.38,0:28:50.27,,NTP,0000,0000,0000,,Чи Чи, сен қайда бардың?
Dialogue: 0,0:28:55.31,0:28:56.34,,NTP,0000,0000,0000,,(Жаңа атқарушы)
Dialogue: 0,0:29:02.72,0:29:04.55,,NTP,0000,0000,0000,,Сіз жақсы орын таптыңыз, солай ма?
Dialogue: 0,0:29:05.49,0:29:08.02,,NTP,0000,0000,0000,,Сіз мені мұнда ұстай алмайсыз.
Dialogue: 0,0:29:11.45,0:29:12.45,,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:29:13.21,0:29:14.45,,NTP,0000,0000,0000,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:29:16.59,0:29:17.85,,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:29:53.77,0:29:55.66,,NTP,0000,0000,0000,,Юхэй Митагара
Dialogue: 0,0:29:56.05,0:29:58.36,,NTP,0000,0000,0000,,Жүр, ауруханаға барайық, Чи.
Dialogue: 0,0:30:02.10,0:30:04.08,,NTP,0000,0000,0000,,Мия!
Dialogue: 0,0:30:04.30,0:30:07.49,,NTP,0000,0000,0000,,Шығарыңыз! Шығарыңыз, шығарыңыз, жоқ
Dialogue: 0,0:30:07.61,0:30:08.87,,NTP,0000,0000,0000,,Мя
Dialogue: 0,0:30:10.40,0:30:13.64,,NTP,0000,0000,0000,,Чи, келіңізші.
Dialogue: 0,0:30:15.25,0:30:16.31,,NTP,0000,0000,0000,,Вакцинация – бұл
Dialogue: 0,0:30:16.58,0:30:19.18,,NTP,0000,0000,0000,,Бұл Чи ауруының алдын алу.
Dialogue: 0,0:30:19.83,0:30:22.51,,NTP,0000,0000,0000,,Иә, бұл Чиге арналған.
Dialogue: 0,0:30:23.00,0:30:24.99,,NTP,0000,0000,0000,,Инъекция Қолдан келгеннің бәрін жасаңыз
Dialogue: 0,0:30:29.51,0:30:35.04,,NTP,0000,0000,0000,,Сатқын Мен доспыз деп ойладым.
Dialogue: 0,0:30:35.90,0:30:37.23,,NTP,0000,0000,0000,,Чи-чан Ямада
Dialogue: 0,0:30:38.02,0:30:41.11,,NTP,0000,0000,0000,,Бүгін бес валентті вакцина.
Dialogue: 0,0:30:41.77,0:30:50.11,,NTP,0000,0000,0000,,Мя мыя
Dialogue: 0,0:30:44.66,0:30:46.53,,NTP,0000,0000,0000,,Мен оны ұяда сақтаймын.
Dialogue: 0,0:30:46.78,0:30:47.94,,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:30:48.07,0:30:51.79,,NTP,0000,0000,0000,,Оны сол күйінде қалдырыңыз, әсіресе зорлық-зомбылық көрсететін балалар үшін.
Dialogue: 0,0:30:56.85,0:30:58.73,,NTP,0000,0000,0000,,Кел, сен жақсы қызсың.
Dialogue: 0,0:30:59.88,0:31:00.88,,NTP,0000,0000,0000,,Уау
Dialogue: 0,0:31:01.27,0:31:02.82,,NTP,0000,0000,0000,,Иә, ауырмайды.
Dialogue: 0,0:31:03.28,0:31:07.82,,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:31:10.37,0:31:11.34,,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:31:12.58,0:31:13.74,,NTP,0000,0000,0000,,Қош келдің үйге.
Dialogue: 0,0:31:14.02,0:31:15.23,,NTP,0000,0000,0000,,Qi Бұл қалай болды?
Dialogue: 0,0:31:15.41,0:31:19.78,,NTP,0000,0000,0000,,Ааа, мен ауруханаға барсам да шаршаймын.
Dialogue: 0,0:31:22.83,0:31:24.21,,NTP,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:31:24.39,0:31:27.37,,NTP,0000,0000,0000,,Иә, не істеп жатырсың?
Dialogue: 0,0:31:28.35,0:31:30.12,,NTP,0000,0000,0000,,Чи үйден қашып кете алды.
Dialogue: 0,0:31:31.98,0:31:34.65,,NTP,0000,0000,0000,,Барлығы жағымсыз нәрсе жасады.
Dialogue: 0,0:31:34.97,0:31:38.57,,NTP,0000,0000,0000,,Мен доспыз деп ойладым, бірақ қазір
Dialogue: 0,0:31:40.47,0:31:42.56,,NTP,0000,0000,0000,,Сенбеу
Dialogue: 0,0:31:43.16,0:31:45.60,,NTP,0000,0000,0000,,Бұл сенім бе?
Dialogue: 0,0:31:45.95,0:31:50.17,,NTP,0000,0000,0000,,Әй, адамға көп сенбе.
Dialogue: 0,0:31:51.03,0:31:52.58,,NTP,0000,0000,0000,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:31:52.72,0:31:54.22,,NTP,0000,0000,0000,,Маған сенбе
Dialogue: 0,0:31:58.51,0:31:59.52,,NTP,0000,0000,0000,,Сенім?
Dialogue: 0,0:32:03.32,0:32:05.76,,NTP,0000,0000,0000,,Сенім дегеніміз не?
Dialogue: 0,0:32:08.62,0:32:12.53,,NTP,0000,0000,0000,,Ей, сен деген не?
Dialogue: 0,0:32:49.57,0:32:52.07,,NTP,0000,0000,0000,,Адамдар дос емес
Dialogue: 0,0:32:52.55,0:32:54.64,,NTP,0000,0000,0000,,Дұрыс, біз дос емеспіз.
Dialogue: 0,0:32:55.21,0:32:55.96,,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:32:56.08,0:32:57.43,,NTP,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:32:58.48,0:32:59.46,,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:32:59.68,0:33:02.10,,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:33:02.90,0:33:05.13,,NTP,0000,0000,0000,,Адамдар тұрған үйге оралу
Dialogue: 0,0:33:05.76,0:33:06.70,,NTP,0000,0000,0000,,Бұл қоңырау
Dialogue: 0,0:33:07.20,0:33:09.86,,NTP,0000,0000,0000,,Не? Дос болмасақ та
Dialogue: 0,0:33:10.45,0:33:11.99,,NTP,0000,0000,0000,,Барлығы күтіп тұр.
Dialogue: 0,0:33:13.55,0:33:14.76,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:33:15.74,0:33:18.72,,NTP,0000,0000,0000,,Бұл біреудің болуы деп аталады.
Dialogue: 0,0:33:20.94,0:33:23.70,,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:33:31.33,0:33:33.82,,NTP,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,0:33:41.59,0:33:45.01,,NTP,0000,0000,0000,,Чи үйге тамақ ішуге кетті.
Dialogue: 0,0:33:48.07,0:33:50.38,,NTP,0000,0000,0000,,Уау, бұл қолдан жасалған суши.
Dialogue: 0,0:33:51.52,0:33:52.76,,NTP,0000,0000,0000,,Очи
Dialogue: 0,0:33:53.23,0:33:56.04,,NTP,0000,0000,0000,,Бүгін инъекцияға қарсылық көрсеткеніңіз керемет болды.
Dialogue: 0,0:33:57.73,0:33:59.10,,NTP,0000,0000,0000,,Бұл сыйлық.
Dialogue: 0,0:33:59.29,0:34:00.79,,NTP,0000,0000,0000,,Чиді де қолданып көргің келе ме?
Dialogue: 0,0:34:01.33,0:34:02.75,,NTP,0000,0000,0000,,Чи де келеді.
Dialogue: 0,0:34:06.08,0:34:07.35,,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:34:10.41,0:34:12.70,,NTP,0000,0000,0000,,Сыр, бұл тунец.
Dialogue: 0,0:34:13.94,0:34:16.23,,NTP,0000,0000,0000,,Тамагояки
Dialogue: 0,0:34:16.39,0:34:18.32,,NTP,0000,0000,0000,,Мен Икурамын
Dialogue: 0,0:34:18.59,0:34:20.87,,NTP,0000,0000,0000,,Ең алдымен тунец.
Dialogue: 0,0:34:21.57,0:34:24.39,,NTP,0000,0000,0000,,Бұл Чидікі.
Dialogue: 0,0:34:29.53,0:34:30.41,,NTP,0000,0000,0000,,Үлпілдек
Dialogue: 0,0:34:32.75,0:34:34.06,,NTP,0000,0000,0000,,Үлпілдек
Dialogue: 0,0:34:37.91,0:34:39.48,,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:34:40.34,0:34:43.78,,NTP,0000,0000,0000,,Чи, бұл жақсы.
Dialogue: 0,0:34:43.92,0:34:45.73,,NTP,0000,0000,0000,,Бұл дәмді, Чи.
Dialogue: 0,0:34:45.89,0:34:47.65,,NTP,0000,0000,0000,,Сыр да дәмді
Dialogue: 0,0:34:48.17,0:34:52.65,,NTP,0000,0000,0000,,Уау Уау Уау
Dialogue: 0,0:34:54.85,0:34:57.20,,NTP,0000,0000,0000,,Бұл дәмді, бәрі.
Dialogue: 0,0:34:57.83,0:34:59.27,,NTP,0000,0000,0000,,Бұл дәмді болды ма?
Dialogue: 0,0:34:59.68,0:35:01.58,,NTP,0000,0000,0000,,Сізге жақсы, Чи.
Dialogue: 0,0:35:03.72,0:35:07.64,,NTP,0000,0000,0000,,Чи, дос болған жақсы ғой.
Dialogue: 0,0:00:01.86,0:00:04.43,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:00:04.81,0:00:07.69,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:00:07.82,0:00:14.31,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:00:14.42,0:00:17.10,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:00:17.21,0:00:20.63,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:00:20.72,0:00:25.77,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:00:26.20,0:00:28.85,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:02:58.22,0:03:00.93,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:03:00.95,0:03:04.00,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:03:04.13,0:03:10.79,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:03:10.80,0:03:13.50,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:03:13.52,0:03:16.55,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:03:17.10,0:03:22.26,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:03:22.71,0:03:25.35,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:05:53.83,0:05:56.54,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:05:56.72,0:05:59.68,,NTP,0000,0000,0000,,Мен сонша сүтке ризамын
Dialogue: 0,0:05:59.82,0:06:06.40,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:06:06.55,0:06:09.14,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:06:09.25,0:06:12.47,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:06:12.58,0:06:17.39,,NTP,0000,0000,0000,,Жатып, бақытты болу
Dialogue: 0,0:06:18.37,0:06:20.30,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:08:49.82,0:08:52.66,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:08:52.78,0:08:55.76,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:08:55.89,0:09:02.45,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:09:02.57,0:09:05.30,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:09:05.39,0:09:08.82,,NTP,0000,0000,0000,,Дәмді тағаммен толтырылған
Dialogue: 0,0:09:08.93,0:09:13.40,,NTP,0000,0000,0000,,Бақытты жату
Dialogue: 0,0:09:14.32,0:09:16.66,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:11:45.80,0:11:48.61,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:11:48.72,0:11:51.80,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:11:51.94,0:11:58.38,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:11:58.50,0:12:01.20,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:12:01.33,0:12:04.77,,NTP,0000,0000,0000,,Дәмді тағаммен сору
Dialogue: 0,0:12:04.89,0:12:09.91,,NTP,0000,0000,0000,,Жатып бақытты болу
Dialogue: 0,0:12:10.26,0:12:12.65,,NTP,0000,0000,0000,,Корори
Dialogue: 0,0:14:41.91,0:14:44.69,,NTP,0000,0000,0000,,Менің көңіл-күйім жақсы.
Dialogue: 0,0:14:44.83,0:14:47.83,,NTP,0000,0000,0000,,Сүт көп, мен бақыттымын
Dialogue: 0,0:14:47.98,0:14:54.50,,NTP,0000,0000,0000,,Ойнап болғаннан кейін сипау жақсы сезінеді
Dialogue: 0,0:14:54.61,0:14:57.33,,NTP,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:14:57.42,0:15:00.83,,NTP,0000,0000,0000,,Дәмді тағаммен сору
