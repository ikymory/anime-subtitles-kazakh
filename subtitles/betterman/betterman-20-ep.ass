Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.36,0:00:18.90,Default,,0,0,0,,Оқиғалар туралы болжамымды жоққа шығарған Қанкел апаты
Dialogue: 0,0:00:20.33,0:00:25.10,Default,,0,0,0,,Біз Сомниумның ең үлкен қаупіміз.
Dialogue: 0,0:00:26.76,0:00:29.33,Default,,0,0,0,,Канкел Бодайжуды шақырады
Dialogue: 0,0:00:29.36,0:00:32.43,Default,,0,0,0,,Ал енді мен бұл Пачираны да шақырдым.
Dialogue: 0,0:00:33.46,0:00:37.63,Default,,0,0,0,,Кінәлі күш тапқан бізді құрту.
Dialogue: 0,0:00:38.93,0:00:44.10,Default,,0,0,0,,Балалар, сендер мына пачираны ұстау үшін жүзуге жіберілген алаяқсыңдар.
Dialogue: 0,0:00:45.43,0:00:49.20,Default,,0,0,0,,-де Бодайджу ескі Пачираны да шақырады.
Dialogue: 0,0:00:50.16,0:00:53.50,Default,,0,0,0,,Осы пачираның түсінетіндей Бодайджу пайда болуы
Dialogue: 0,0:00:53.76,0:00:56.90,Default,,0,0,0,,Оны Limipid арнаңызға жіберіңіз
Dialogue: 0,0:00:59.26,0:00:59.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:05.73,0:01:08.60,Default,,0,0,0,,Бұл зұлым рух, мүмкін
Dialogue: 0,0:01:12.16,0:01:13.06,Default,,0,0,0,,Канкел
Dialogue: 0,0:01:23.83,0:01:25.76,Default,,0,0,0,,Неліктен көріну керек?
Dialogue: 0,0:01:26.26,0:01:29.70,Default,,0,0,0,,Сіз бізге Forte беруден бас тартасыз ба?
Dialogue: 0,0:01:31.40,0:01:34.10,Default,,0,0,0,,Мұны ескі Пачираға қайтару керек.
Dialogue: 0,0:01:35.10,0:01:36.80,Default,,0,0,0,,пектофораза
Dialogue: 0,0:01:37.20,0:01:37.86,Default,,0,0,0,,Өрік
Dialogue: 0,0:01:42.46,0:01:43.16,Default,,0,0,0,,Эй
Dialogue: 0,0:01:45.30,0:01:48.40,Default,,0,0,0,,Пэктофораза Т жасушаларын лезде пролиферациялайды.
Dialogue: 0,0:01:48.80,0:01:51.46,Default,,0,0,0,,Маған шабуыл жасау үшін хромосомаларыңызды өзгерттіңіз бе?
Dialogue: 0,0:01:52.20,0:01:55.40,Default,,0,0,0,,Сондықтан оны Қанкел деп атайды
Dialogue: 0,0:01:57.13,0:01:58.13,Default,,0,0,0,,Калеум
Dialogue: 0,0:02:03.26,0:02:05.06,Default,,0,0,0,,Белгісіз қабілет
Dialogue: 0,0:02:05.46,0:02:07.93,Default,,0,0,0,,Ақыр соңында, сен жойылуға тиіссің.
Dialogue: 0,0:02:08.56,0:02:10.20,Default,,0,0,0,,Осы Турба жемісімен.
Dialogue: 0,0:02:10.33,0:02:11.36,Default,,0,0,0,,Гаригари Гари
Dialogue: 0,0:02:11.66,0:02:12.23,Default,,0,0,0,,Хун
Dialogue: 0,0:02:13.83,0:02:16.93,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:02:17.10,0:02:19.66,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:02:36.73,0:02:38.46,Default,,0,0,0,,Психокалм
Dialogue: 0,0:02:38.80,0:02:41.03,Default,,0,0,0,,Гуоооо
Dialogue: 0,0:02:54.20,0:02:54.96,Default,,0,0,0,,болып табылады
Dialogue: 0,0:02:55.16,0:02:58.13,Default,,0,0,0,,Менің жасушаларымды өзгертуге жеткілікті зұлымдық
Dialogue: 0,0:02:58.16,0:02:59.66,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:03:00.03,0:03:03.93,Default,,0,0,0,,Lamia Forte жемісін сұраңыз
Dialogue: 0,0:03:05.50,0:03:07.86,Default,,0,0,0,,Ой, мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:03:08.23,0:03:10.83,Default,,0,0,0,,Сіз және осы дене
Dialogue: 0,0:03:11.56,0:03:13.70,Default,,0,0,0,,Уф
Dialogue: 0,0:03:28.00,0:03:29.66,Default,,0,0,0,,Иә, сол кезде
Dialogue: 0,0:03:31.06,0:03:33.06,Default,,0,0,0,,Форте жемісі бізге сеніп тапсырылды.
Dialogue: 0,0:03:34.16,0:03:34.60,Default,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:03:36.30,0:03:38.96,Default,,0,0,0,,Бодайжуды Қанкел қиратты
Dialogue: 0,0:03:40.86,0:03:46.43,Default,,0,0,0,,Бірақ бізге қауіп төндіретін – бастапқы күш.
Dialogue: 0,0:03:47.00,0:03:50.66,Default,,0,0,0,,Оның күшінің арқасында форте болатыны
Dialogue: 0,0:03:51.00,0:03:53.03,Default,,0,0,0,,Қанкел де күтпеген
Dialogue: 0,0:03:54.16,0:03:58.66,Default,,0,0,0,,Бұл пачира кінәлі күшті қуып келеді.
Dialogue: 0,0:03:59.00,0:04:02.56,Default,,0,0,0,,Көлеңкеде жасырынған Қанкелді жойыңыз
Dialogue: 0,0:04:03.06,0:04:06.56,Default,,0,0,0,,Үміт үзбе, мырзалар.
Dialogue: 0,0:04:10.63,0:04:11.43,Default,,0,0,0,,Ламия
Dialogue: 0,0:04:12.90,0:04:16.10,Default,,0,0,0,,Мен сен үшін соңына дейін өмір сүремін
Dialogue: 0,0:04:17.60,0:04:19.53,Default,,0,0,0,,Соңғы сәтке дейін
Dialogue: 0,0:04:24.63,0:04:34.20,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:04:36.53,0:04:44.80,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:04:46.53,0:04:55.13,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:04:58.33,0:05:06.13,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:05:09.63,0:05:18.50,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:05:18.76,0:05:26.90,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:05:28.63,0:05:38.20,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:05:38.56,0:05:51.03,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:05:56.06,0:06:00.16,Default,,0,0,0,,Бізді тастап кеткенің сұмдық.
Dialogue: 0,0:06:00.90,0:06:04.33,Default,,0,0,0,,Мен де артта қалдым.
Dialogue: 0,0:06:04.76,0:06:06.16,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:06.66,0:06:09.80,Default,,0,0,0,,Менің ойымша, егер біз осында болсақ, бұл кедергі.
Dialogue: 0,0:06:10.36,0:06:11.06,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:06:11.53,0:06:15.23,Default,,0,0,0,,Мен Хиноки-чанға және басқаларға қауіп төндіргім келмейді.
Dialogue: 0,0:06:15.43,0:06:17.20,Default,,0,0,0,,Президенттің сүйіспеншілігі
Dialogue: 0,0:06:17.36,0:06:20.20,Default,,0,0,0,,Мм, сонда неге Сара-чанды ертіп кеттің?
Dialogue: 0,0:06:20.56,0:06:22.96,Default,,0,0,0,,Әй, жау деген бір топ экстрасенс.
Dialogue: 0,0:06:23.50,0:06:26.10,Default,,0,0,0,,Сара-чансыз жеңу мүмкіндігі жоқ.
Dialogue: 0,0:06:26.50,0:06:30.26,Default,,0,0,0,,Мен енді ұрысқым келмейді деп ойлаймын.
Dialogue: 0,0:06:30.46,0:06:31.96,Default,,0,0,0,,Мен де
Dialogue: 0,0:06:32.43,0:06:35.03,Default,,0,0,0,,Мен шайқасқа барған жоқпын.
Dialogue: 0,0:06:35.46,0:06:38.06,Default,,0,0,0,,Ол бұл жай ғана талқылау екенін айтты.
Dialogue: 0,0:06:38.43,0:06:40.70,Default,,0,0,0,,Талқылау?
Dialogue: 0,0:06:51.03,0:06:54.43,Default,,0,0,0,,Дұрыс, Шуто экспресс жолында адам көп болуы керек.
Dialogue: 0,0:06:55.56,0:06:59.30,Default,,0,0,0,,Алайда, Мордиварп арнайы жасақтарды да жібереді.
Dialogue: 0,0:06:59.56,0:07:01.63,Default,,0,0,0,,Жақсы себеп бар ма?
Dialogue: 0,0:07:02.23,0:07:04.83,Default,,0,0,0,,Штаб агенттері заттай дәлелдеме алғанша
Dialogue: 0,0:07:05.26,0:07:07.16,Default,,0,0,0,,Мен жай отыра алмаймын.
Dialogue: 0,0:07:07.46,0:07:08.03,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:07:09.13,0:07:11.33,Default,,0,0,0,,Әпке, сіз ашулысыз ба?
Dialogue: 0,0:07:11.66,0:07:12.63,Default,,0,0,0,,Кеше түнгі үкім дұрыс орындалды.
Dialogue: 0,0:07:13.20,0:07:16.46,Default,,0,0,0,,Төтенше адамдық альянс Төтенше адамдық альянстың жетекшісі - Мамон-сенсей.
Dialogue: 0,0:07:16.80,0:07:18.46,Default,,0,0,0,,Ол жетекші сарапшы болды.
Dialogue: 0,0:07:19.23,0:07:21.13,Default,,0,0,0,,Каэде-санды аулау
Dialogue: 0,0:07:21.46,0:07:26.26,Default,,0,0,0,,Сен экстрасенстерді бірінен соң бірін пайдаланып, бізге қорқынышты істер жасай аласың?
Dialogue: 0,0:07:26.63,0:07:30.00,Default,,0,0,0,,Сіз ересек кезіңізде көрген галлюцинация белгілері де сол адамдардың ісі ме?
Dialogue: 0,0:07:30.56,0:07:31.83,Default,,0,0,0,,Галлюцинация емес
Dialogue: 0,0:07:32.56,0:07:36.76,Default,,0,0,0,,Осылайша біздің сезім мүшелеріміз айнадағы бейнені нақты дене ретінде таниды.
Dialogue: 0,0:07:37.06,0:07:39.00,Default,,0,0,0,,Мен виртуалды желі құрдым
Dialogue: 0,0:07:40.30,0:07:42.73,Default,,0,0,0,,Бірақ ол шын мәнінде жоқ.
Dialogue: 0,0:07:43.16,0:07:47.26,Default,,0,0,0,,Болмыстың анықтамасы тану арқылы ғана дәлелденеді.
Dialogue: 0,0:07:48.36,0:07:50.20,Default,,0,0,0,,Қорапта қамалған мысық
Dialogue: 0,0:07:51.93,0:07:52.50,Default,,0,0,0,,Ньяа
Dialogue: 0,0:07:52.56,0:07:55.30,Default,,0,0,0,,Сіз дауысты тыңдайсыз ба немесе қораптың ішіне қарайсыз ба?
Dialogue: 0,0:07:55.96,0:07:58.86,Default,,0,0,0,,Кез келген жағдайда, қандай да бір тану кезінде
Dialogue: 0,0:07:59.13,0:08:02.03,Default,,0,0,0,,Ішіндегі мысықты бірінші рет білеміз
Dialogue: 0,0:08:02.73,0:08:07.43,Default,,0,0,0,,Басқаша айтқанда, біз өзіміздің басқа болмысымыз туралы хабардар болдық.
Dialogue: 0,0:08:08.20,0:08:10.33,Default,,0,0,0,,Ми өзі танитын заттарға әрекет етеді
Dialogue: 0,0:08:11.13,0:08:14.23,Default,,0,0,0,,Мысалы, сізді ара шақпаса да.
Dialogue: 0,0:08:14.66,0:08:18.80,Default,,0,0,0,,Ми мұны таныған соң, ара шаққан сияқты реакцияға ие болады.
Dialogue: 0,0:08:19.80,0:08:24.20,Default,,0,0,0,,Біздің сезім мүшелеріміз сенімсіз, солай емес пе?
Dialogue: 0,0:08:25.86,0:08:29.56,Default,,0,0,0,,Сондықтан менің еліктеу қабілетім пайдалы.
Dialogue: 0,0:08:30.43,0:08:35.40,Default,,0,0,0,,О, құдай-ау, мені еш қауіп төндірмейтін мысық тырнап кете жаздады.
Dialogue: 0,0:08:36.30,0:08:37.26,Default,,0,0,0,,Сіз келдіңіз.
Dialogue: 0,0:08:38.53,0:08:40.80,Default,,0,0,0,,Адамгершіліктен тыс Альянстың штаб-пәтерінің ғимараты
Dialogue: 0,0:08:42.73,0:08:46.93,Default,,0,0,0,,Көп, көп, көп.
Dialogue: 0,0:08:47.93,0:08:50.70,Default,,0,0,0,,Жоқ, жауап жоқ.
Dialogue: 0,0:08:51.10,0:08:54.16,Default,,0,0,0,,Шэнми, рұқсатсыз кіре аламын ба?
Dialogue: 0,0:08:54.76,0:08:56.46,Default,,0,0,0,,Есік құлыптаулы, бірақ
Dialogue: 0,0:08:57.03,0:08:58.83,Default,,0,0,0,,Ми импульсін сканерлеу?
Dialogue: 0,0:08:59.50,0:09:01.86,Default,,0,0,0,,Бұл жеке тұлғаны танудың соңғы жүйесі ме?
Dialogue: 0,0:09:02.70,0:09:03.40,Default,,0,0,0,,Каэде-чан
Dialogue: 0,0:09:03.70,0:09:04.36,Default,,0,0,0,,Иә
Dialogue: 0,0:09:09.13,0:09:10.46,Default,,0,0,0,,Оңай оңай
Dialogue: 0,0:09:10.96,0:09:14.03,Default,,0,0,0,,Былайша айтқанда, егуді меңгере алсаңыз
Dialogue: 0,0:09:14.33,0:09:17.46,Default,,0,0,0,,Мұндағы қызметкерлер сияқты, бұл тегін жолдама.
Dialogue: 0,0:09:18.26,0:09:20.50,Default,,0,0,0,,Әй, Сара, сен өзгеріп біттің бе?
Dialogue: 0,0:09:21.33,0:09:22.30,Default,,0,0,0,,Мынаны қосыңыз
Dialogue: 0,0:09:22.63,0:09:23.26,Default,,0,0,0,,О
Dialogue: 0,0:09:23.56,0:09:26.53,Default,,0,0,0,,Бұл олардың ауқымды шабуылдарының орнын толтырады.
Dialogue: 0,0:09:26.90,0:09:29.96,Default,,0,0,0,,Амульфас рефлекторының лазерлік басы Zero One
Dialogue: 0,0:09:30.76,0:09:31.83,Default,,0,0,0,,Сіз оларды бәріңіз киесіз бе?
Dialogue: 0,0:09:32.16,0:09:32.80,Default,,0,0,0,,Наха
Dialogue: 0,0:09:37.20,0:09:39.73,Default,,0,0,0,,Ғимарат ішінде тағы бір ғимарат бар.
Dialogue: 0,0:09:40.30,0:09:41.86,Default,,0,0,0,,Қосарлы құрылым
Dialogue: 0,0:09:42.60,0:09:46.53,Default,,0,0,0,,Сақора: Жын жынның санасы қайда екенін айта аласыз ба?
Dialogue: 0,0:09:48.16,0:09:48.63,Default,,0,0,0,,Иә
Dialogue: 0,0:09:50.00,0:09:52.46,Default,,0,0,0,,Жер астында
Dialogue: 0,0:09:53.23,0:09:53.80,Default,,0,0,0,,Жер асты
Dialogue: 0,0:09:54.53,0:09:56.93,Default,,0,0,0,,Құрылымды маған қалдырыңыз
Dialogue: 0,0:09:57.43,0:10:00.40,Default,,0,0,0,,Қазіргі уақытта геофронттар танымал.
Dialogue: 0,0:10:00.56,0:10:03.36,Default,,0,0,0,,Бірақ біртүрлі тыныштық, мені мазалайды.
Dialogue: 0,0:10:03.83,0:10:05.70,Default,,0,0,0,,Мен жертөледе күтемін.
Dialogue: 0,0:10:06.16,0:10:10.36,Default,,0,0,0,,Көп адам, көп тұзақ
Dialogue: 0,0:10:11.23,0:10:12.76,Default,,0,0,0,,Адамзаттан тыс альянстан күткендей
Dialogue: 0,0:10:13.66,0:10:16.16,Default,,0,0,0,,Сіз біздің келе жатқанымызды білген сияқтысыз.
Dialogue: 0,0:10:16.76,0:10:17.53,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:10:18.10,0:10:20.73,Default,,0,0,0,,Тиранмен еденді жұдырықпен ұрып, төмен түскіңіз келе ме?
Dialogue: 0,0:10:21.63,0:10:22.73,Default,,0,0,0,,Әрі қарай жалғастырайық.
Dialogue: 0,0:10:23.63,0:10:24.96,Default,,0,0,0,,Сізді күту жаман.
Dialogue: 0,0:10:28.70,0:10:31.23,Default,,0,0,0,,Әке, мен форте жемісі болдым.
Dialogue: 0,0:10:31.73,0:10:32.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.90,0:10:36.16,Default,,0,0,0,,Сонымен, мені Беттерман жеп қойды.
Dialogue: 0,0:10:36.93,0:10:38.26,Default,,0,0,0,,Бұл менің кесірім.
Dialogue: 0,0:10:40.10,0:10:43.70,Default,,0,0,0,,Мен өткен күні айнадағы үйде адасып қалғанда,
Dialogue: 0,0:10:44.40,0:10:47.70,Default,,0,0,0,,Менің бетім жақсырақ еркектікіне ұқсай бастады.
Dialogue: 0,0:10:47.90,0:10:50.56,Default,,0,0,0,,А, бұл дұрыс емес.
Dialogue: 0,0:10:51.13,0:10:55.10,Default,,0,0,0,,Мен сенің әкең, шешең және ағаң екеніне сенімдімін.
Dialogue: 0,0:10:55.60,0:10:58.93,Default,,0,0,0,,Хечин-сан сияқты мен де анимус гүліне айналдым.
Dialogue: 0,0:10:59.03,0:10:59.73,Default,,0,0,0,,Аа-а-а
Dialogue: 0,0:11:00.50,0:11:01.96,Default,,0,0,0,,Әке гүлінің жемісі
Dialogue: 0,0:11:10.23,0:11:11.86,Default,,0,0,0,,Гаооооо
Dialogue: 0,0:11:12.30,0:11:15.16,Default,,0,0,0,,Доктор Умезаки сияқты
Dialogue: 0,0:11:15.46,0:11:17.90,Default,,0,0,0,,Аджанта үңгірлерінде Форте болды
Dialogue: 0,0:11:19.30,0:11:22.66,Default,,0,0,0,,Люме деп аталатын Беттерман анасының жемісін өсірді.
Dialogue: 0,0:11:24.36,0:11:26.63,Default,,0,0,0,,Ал ағам туралы шындық
Dialogue: 0,0:11:30.80,0:11:33.23,Default,,0,0,0,,А-а, сіз әлі сонда болдыңыз ба?
Dialogue: 0,0:11:33.86,0:11:36.73,Default,,0,0,0,,Барлық қызметкерлер үйлеріне кетті, бірақ Кейта мен оның достары не істейді?
Dialogue: 0,0:11:37.13,0:11:39.43,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:11:39.80,0:11:43.10,Default,,0,0,0,,Әй, сыртта бірдеңе бар сияқты.
Dialogue: 0,0:11:43.56,0:11:46.36,Default,,0,0,0,,Бұл басқа қате болуы мүмкін, сондықтан неге қарап көрмеске?
Dialogue: 0,0:11:46.76,0:11:47.66,Default,,0,0,0,,Жәндіктер
Dialogue: 0,0:11:51.16,0:11:53.00,Default,,0,0,0,,Бұл бейтаныс көлік.
Dialogue: 0,0:11:53.33,0:11:55.53,Default,,0,0,0,,Бұл полицияның броньды көлігі емес пе?
Dialogue: 0,0:11:58.66,0:11:59.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:03.10,0:12:04.06,Default,,0,0,0,,Керемет
Dialogue: 0,0:12:04.13,0:12:05.56,Default,,0,0,0,,Spas автоматты шолақ мылтық
Dialogue: 0,0:12:05.63,0:12:08.63,Default,,0,0,0,,Бұл Хеклер мен Кохтың снайперлік мылтығы.
Dialogue: 0,0:12:08.66,0:12:09.86,Default,,0,0,0,,39-шы эпизод: Ұйықтап жатқан құл
Dialogue: 0,0:12:10.40,0:12:12.83,Default,,0,0,0,,Ах, кем дегенде, бұл қате сияқты емес.
Dialogue: 0,0:12:21.06,0:12:24.40,Default,,0,0,0,,А-а, жоқ!
Dialogue: 0,0:12:37.53,0:12:40.03,Default,,0,0,0,,-Ой, эй - бәрің, мықтап ұстаңдар!
Dialogue: 0,0:12:46.36,0:12:47.66,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:48.16,0:12:49.50,Default,,0,0,0,,Мен өзімді ауыр сезінемін.
Dialogue: 0,0:12:49.76,0:12:50.63,Default,,0,0,0,,Ах хаха
Dialogue: 0,0:12:51.06,0:12:54.03,Default,,0,0,0,,Басқа адам жай ғана айла-шарғы жасауы мүмкін екені рас.
Dialogue: 0,0:12:54.53,0:12:56.93,Default,,0,0,0,,Оянған адамдармен күресуге болмайды.
Dialogue: 0,0:12:57.36,0:12:59.13,Default,,0,0,0,,Сіз қанша қашықтыққа жүгіресіз?
Dialogue: 0,0:12:59.86,0:13:01.50,Default,,0,0,0,,Мен барып президентті алып кетейін бе?
Dialogue: 0,0:13:02.16,0:13:03.06,Default,,0,0,0,,Ae?
Dialogue: 0,0:13:14.40,0:13:18.36,Default,,0,0,0,,Олардың бір жерде айналып-толғанып жүргені ғажап.
Dialogue: 0,0:13:18.90,0:13:21.50,Default,,0,0,0,,Менің ойымша, бұл оның бұрандалы құрылымы болғандықтан.
Dialogue: 0,0:13:22.46,0:13:26.23,Default,,0,0,0,,Қазіргі орналасқан жер жер астындағы 7-қабатта, сөзсіз төмен қарай.
Dialogue: 0,0:13:27.70,0:13:29.46,Default,,0,0,0,,спираль немесе спираль
Dialogue: 0,0:13:30.06,0:13:34.73,Default,,0,0,0,,Бұл дүниедегі барлық құбылыстардың құрылымын бір сөзбен жеткізуге болады.
Dialogue: 0,0:13:35.93,0:13:39.53,Default,,0,0,0,,Микроскопиялық әлемде электрондар атом ядросының айналасында айналады.
Dialogue: 0,0:13:40.20,0:13:43.46,Default,,0,0,0,,Немесе тіршілік көзі болып табылатын ДНҚ тізбегі
Dialogue: 0,0:13:44.40,0:13:47.90,Default,,0,0,0,,Макрокөзқарастағы тайфун Планета орбитасы
Dialogue: 0,0:13:48.66,0:13:50.33,Default,,0,0,0,,Сонымен қатар, галактикалардың құрылымы
Dialogue: 0,0:13:51.63,0:13:55.36,Default,,0,0,0,,Біз әртүрлі көлемдегі шеңберлерде өмір сүреміз.
Dialogue: 0,0:13:57.06,0:14:00.70,Default,,0,0,0,,Кагоме Кагоме
Dialogue: 0,0:14:01.03,0:14:04.46,Default,,0,0,0,,Тордағы құс
Dialogue: 0,0:14:04.73,0:14:08.23,Default,,0,0,0,,Ол қашан шығады?
Dialogue: 0,0:14:08.36,0:14:08.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:09.60,0:14:10.03,Default,,0,0,0,,Каэде
Dialogue: 0,0:14:10.80,0:14:11.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:12.16,0:14:12.93,Default,,0,0,0,,Кагоме
Dialogue: 0,0:14:13.60,0:14:15.50,Default,,0,0,0,,Superhuman Alliance-тың миға шабуылы?
Dialogue: 0,0:14:16.13,0:14:20.96,Default,,0,0,0,,Кагоме Кагоме тордағы әйелді білдіреді, солай ма?
Dialogue: 0,0:14:21.50,0:14:22.70,Default,,0,0,0,,Кагоме Кагоме
Dialogue: 0,0:14:23.23,0:14:25.00,Default,,0,0,0,,А, мен бұл туралы естідім.
Dialogue: 0,0:14:25.33,0:14:27.46,Default,,0,0,0,,Тырналар мен тасбақалар – бақыттың символы
Dialogue: 0,0:14:28.10,0:14:29.46,Default,,0,0,0,,Ол сырғып кетті ме?
Dialogue: 0,0:14:29.93,0:14:31.96,Default,,0,0,0,,Қашып кетпек болған тұтқын әйел
Dialogue: 0,0:14:32.16,0:14:34.90,Default,,0,0,0,,Оны қайтадан алып кетуі мүмкін деген теория бар.
Dialogue: 0,0:14:35.36,0:14:38.36,Default,,0,0,0,,Бұл мен туралы ма?
Dialogue: 0,0:14:43.26,0:14:44.60,Default,,0,0,0,,Төменгі қабат?
Dialogue: 0,0:14:46.43,0:14:49.10,Default,,0,0,0,,F Өйткені, Альжернонның пайда болуы туралы деректер
Dialogue: 0,0:14:49.26,0:14:51.26,Default,,0,0,0,,50%-дан астам келісім.
Dialogue: 0,0:14:52.06,0:14:56.13,Default,,0,0,0,,Қалай болғанда да, үлгі алмасақ, Mordiwarp жұмыс істемейді.
Dialogue: 0,0:14:56.90,0:14:59.63,Default,,0,0,0,,Төтенше жағдайда Tyran қолданбасын пайдаланудан басқа таңдауыңыз болмайды.
Dialogue: 0,0:15:00.20,0:15:03.16,Default,,0,0,0,,Алда көп бөлме бар.
Dialogue: 0,0:15:03.80,0:15:07.03,Default,,0,0,0,,Төменге бір ғана жол бар.
Dialogue: 0,0:15:07.96,0:15:12.76,Default,,0,0,0,,Көптеген саналар біртұтас болуға тырысады
Dialogue: 0,0:15:15.00,0:15:17.33,Default,,0,0,0,,Бұл бөлмеде ештеңе жоқ сияқты.
Dialogue: 0,0:15:20.30,0:15:20.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.56,0:15:23.16,Default,,0,0,0,,Қауіпсіздік сенсоры?
Dialogue: 0,0:15:23.70,0:15:27.10,Default,,0,0,0,,Ал, бұл Достоевский бөлшектерінің шашырауы.
Dialogue: 0,0:15:30.36,0:15:33.36,Default,,0,0,0,,Бір айла бар сияқты.
Dialogue: 0,0:15:34.26,0:15:36.50,Default,,0,0,0,,Енді сенсор қуатсыз.
Dialogue: 0,0:15:36.80,0:15:39.60,Default,,0,0,0,,Президент күткендей керемет.
Dialogue: 0,0:15:40.16,0:15:43.70,Default,,0,0,0,,Ғылымның күшімен біз суперадамдарды жеңе алмаймыз.
Dialogue: 0,0:15:45.30,0:15:47.06,Default,,0,0,0,,Бұл тұман күтпеген жерден
Dialogue: 0,0:15:47.36,0:15:48.50,Default,,0,0,0,,О, күмәнсіз.
Dialogue: 0,0:15:48.93,0:15:52.20,Default,,0,0,0,,Ингредиент - бұл өткен күні Хидеме сынаған химиялық тұман.
Dialogue: 0,0:15:52.76,0:15:55.03,Default,,0,0,0,,Барлығыңның қарның тағы ашты ма?
Dialogue: 0,0:15:56.63,0:15:57.36,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:15:58.46,0:16:00.03,Default,,0,0,0,,Әй әпке
Dialogue: 0,0:16:00.30,0:16:01.03,Default,,0,0,0,,Асами-сан
Dialogue: 0,0:16:01.50,0:16:02.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:03.10,0:16:06.46,Default,,0,0,0,,Мұнда келмес бұрын сізге иммуностимулятор енгізілді
Dialogue: 0,0:16:06.73,0:16:08.66,Default,,0,0,0,,Бұл осы уақытқа арналған алдын алу шарасы.
Dialogue: 0,0:16:09.20,0:16:10.33,Default,,0,0,0,,Секір!!
Dialogue: 0,0:16:10.76,0:16:13.10,Default,,0,0,0,,Химиялық тұманның күші жоқ.
Dialogue: 0,0:16:13.50,0:16:16.76,Default,,0,0,0,,Неліктен? Маған тезірек айтыңызшы.
Dialogue: 0,0:16:17.80,0:16:19.73,Default,,0,0,0,,Медициналық инженерияға келгенде біз ұтылмаймыз.
Dialogue: 0,0:16:23.63,0:16:27.53,Default,,0,0,0,,Бұл қабырға дыбыс өткізбейтін материалдан жасалған сияқты.
Dialogue: 0,0:16:31.43,0:16:34.56,Default,,0,0,0,,Ой, өте төмен жиілік?
Dialogue: 0,0:16:34.86,0:16:36.76,Default,,0,0,0,,Бастың бөлінуі
Dialogue: 0,0:16:38.60,0:16:40.73,Default,,0,0,0,,Гуа гу гу иә
Dialogue: 0,0:16:42.03,0:16:44.40,Default,,0,0,0,,Кей көзіңізге қараңыз.
Dialogue: 0,0:16:45.90,0:16:48.76,Default,,0,0,0,,Хехе, қарашы, мен енді ештеңеден қорықпаймын.
Dialogue: 0,0:16:49.50,0:16:50.43,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:16:51.20,0:16:51.90,Default,,0,0,0,,болып табылады
Dialogue: 0,0:16:53.00,0:16:54.70,Default,,0,0,0,,Барлығы менің көзіме қарайды
Dialogue: 0,0:16:58.36,0:17:00.70,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:17:01.00,0:17:01.70,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.66,0:17:03.10,Default,,0,0,0,,Ах ха
Dialogue: 0,0:17:03.60,0:17:04.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.23,0:17:05.70,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:17:08.73,0:17:10.46,Default,,0,0,0,,Төмен жиіліктер жоғалып кетті
Dialogue: 0,0:17:11.60,0:17:12.93,Default,,0,0,0,,Бұл қандай логика?
Dialogue: 0,0:17:13.46,0:17:16.20,Default,,0,0,0,,Иә, бұл менің еліктеу қабілетім.
Dialogue: 0,0:17:16.83,0:17:18.56,Default,,0,0,0,,Қарапайым тілмен айтқанда, автоұсыныс
Dialogue: 0,0:17:19.20,0:17:22.06,Default,,0,0,0,,Немесе гипноз да осы қабілеттің қолданылуы.
Dialogue: 0,0:17:24.43,0:17:27.80,Default,,0,0,0,,Бірыңғай ырғақты ортада адамның ми қыртысы
Dialogue: 0,0:17:28.03,0:17:30.03,Default,,0,0,0,,Транс күйіне түсу қасиеті бар
Dialogue: 0,0:17:31.46,0:17:34.96,Default,,0,0,0,,Мен бала кезімнен өзіме бірдеңе ұсыну үшін осы қабілетімді қолдандым.
Dialogue: 0,0:17:35.20,0:17:36.70,Default,,0,0,0,,Мен өзімді керемет деп көрсеттім.
Dialogue: 0,0:17:40.73,0:17:44.43,Default,,0,0,0,,BPL-де, мен бұл жерде жоқпын деп сену арқылы
Dialogue: 0,0:17:44.83,0:17:47.33,Default,,0,0,0,,Адамдар үнемі шығаратын тірі қалу сигналдарын блоктау
Dialogue: 0,0:17:47.70,0:17:51.70,Default,,0,0,0,,Олар жәндіктердің сезім мүшелерін алдап, қашып құтыла алды.
Dialogue: 0,0:17:52.73,0:17:56.43,Default,,0,0,0,,Бұл жай ғана меңзеп тұрғанымызды білдіреді.
Dialogue: 0,0:17:56.73,0:17:58.66,Default,,0,0,0,,Иә, асығайық.
Dialogue: 0,0:17:59.13,0:18:02.00,Default,,0,0,0,,Шын мәнінде, өте төмен жиіліктер әлі де жалғасуда.
Dialogue: 0,0:18:02.46,0:18:03.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:04.03,0:18:09.33,Default,,0,0,0,,Бірақ бұл жігіттің сынық болып көрінуі ұсыныс емес, бұл факт.
Dialogue: 0,0:18:09.40,0:18:09.90,Default,,0,0,0,,О
Dialogue: 0,0:18:14.03,0:18:15.96,Default,,0,0,0,,Бөлмеде сүйкімді нәрсе
Dialogue: 0,0:18:16.60,0:18:18.83,Default,,0,0,0,,Менің ойымша, бұл өте жақсы хобби емес.
Dialogue: 0,0:18:19.80,0:18:20.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:20.66,0:18:21.23,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:22.66,0:18:23.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:28.90,0:18:30.10,Default,,0,0,0,,Уау аа
Dialogue: 0,0:18:30.80,0:18:31.60,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:18:34.83,0:18:37.13,Default,,0,0,0,,Сіз роботсыз ба? Қашып кет, Сара Чан.
Dialogue: 0,0:18:44.46,0:18:46.50,Default,,0,0,0,,Нақты бейне емес
Dialogue: 0,0:18:47.13,0:18:48.46,Default,,0,0,0,,Голография
Dialogue: 0,0:18:51.76,0:18:55.83,Default,,0,0,0,,Шындық тек сіз көрген нәрсе емес
Dialogue: 0,0:18:56.23,0:18:58.83,Default,,0,0,0,,Бірінен соң бірі жылы қарсы алу.
Dialogue: 0,0:18:59.53,0:19:03.30,Default,,0,0,0,,Жарайды, бұл артқы бөлме соңғысы.
Dialogue: 0,0:19:03.96,0:19:05.10,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:19:05.96,0:19:07.20,Default,,0,0,0,,Адамнан тыс одақ
Dialogue: 0,0:19:07.70,0:19:10.66,Default,,0,0,0,,Президент қатты ашуланады.
Dialogue: 0,0:19:27.03,0:19:31.50,Default,,0,0,0,,Superhuman Alliance бас директоры Мамон Сенсей.
Dialogue: 0,0:19:32.10,0:19:34.66,Default,,0,0,0,,Бұл Цукокун.
Dialogue: 0,0:19:34.96,0:19:36.66,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:19:37.30,0:19:42.23,Default,,0,0,0,,Сізге осы уақытқа дейін аттракциондар ұнады ма?
Dialogue: 0,0:19:42.76,0:19:45.13,Default,,0,0,0,,Мен сіздің не істегіңіз келетінін білемін.
Dialogue: 0,0:19:45.80,0:19:47.63,Default,,0,0,0,,Енді сол тәжірибені тағы да жасайық.
Dialogue: 0,0:19:48.10,0:19:50.43,Default,,0,0,0,,Сүңгуірді тексеру
Dialogue: 0,0:19:54.76,0:19:58.50,Default,,0,0,0,,Таң атқан түні
Dialogue: 0,0:19:58.53,0:20:02.16,Default,,0,0,0,,Тырна мен тасбақа тайып кетті.
Dialogue: 0,0:20:02.20,0:20:06.60,Default,,0,0,0,,Бұл артқы жағының алдыңғы жағы.
Dialogue: 0,0:20:06.63,0:20:09.83,Default,,0,0,0,,Иә, сэр?
Dialogue: 0,0:20:10.86,0:20:12.20,Default,,0,0,0,,Дегенмен, меніңше, Кира осы екі нәрсенің бірін білмейді.
Dialogue: 0,0:20:13.13,0:20:14.96,Default,,0,0,0,,Ах, күткендей.
Dialogue: 0,0:20:15.93,0:20:17.63,Default,,0,0,0,,Иә? Барлығы ше?
Dialogue: 0,0:20:18.70,0:20:19.80,Default,,0,0,0,,Каэде-чан
Dialogue: 0,0:20:20.60,0:20:25.03,Default,,0,0,0,,Сіз осы мектептегі ең жоғары нәтижелі Эсперсіз.
Dialogue: 0,0:20:25.26,0:20:26.13,Default,,0,0,0,,Фуфу
Dialogue: 0,0:20:26.70,0:20:32.03,Default,,0,0,0,,Бірақ сіздің шынайы күшіңіз осы шаш оюымен жабылған.
Dialogue: 0,0:20:32.80,0:20:33.73,Default,,0,0,0,,Қақпақ?
Dialogue: 0,0:20:34.16,0:20:37.80,Default,,0,0,0,,Мен жеткілікті деп айтқанша
Dialogue: 0,0:20:38.16,0:20:40.56,Default,,0,0,0,,Бұл қақпақты алмаңыз.
Dialogue: 0,0:20:41.46,0:20:43.30,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:20:46.46,0:20:48.36,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:20:51.46,0:20:53.03,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:20:53.66,0:20:54.23,Default,,0,0,0,,Каэде
Dialogue: 0,0:20:55.06,0:20:55.60,Default,,0,0,0,,Уау
Dialogue: 0,0:20:56.43,0:20:57.23,Default,,0,0,0,,-Кэде-сан -Уау
Dialogue: 0,0:20:57.46,0:20:58.10,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:20:59.06,0:20:59.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:59.83,0:21:00.60,Default,,0,0,0,,Уау
Dialogue: 0,0:21:01.60,0:21:03.70,Default,,0,0,0,,Брахма
Dialogue: 0,0:21:04.60,0:21:06.76,Default,,0,0,0,,Ой-а-а
Dialogue: 0,0:21:07.00,0:21:08.56,Default,,0,0,0,,Каэде-сан а
Dialogue: 0,0:21:10.33,0:21:14.83,Default,,0,0,0,,Ааааааааааа
Dialogue: 0,0:21:17.36,0:21:18.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:19.06,0:21:23.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:23.23,0:21:27.33,Default,,0,0,0,,Хохохо хохохо бұл орындалды
Dialogue: 0,0:21:27.46,0:21:29.83,Default,,0,0,0,,Ең күшті адам нәсіліне эволюция
Dialogue: 0,0:21:30.66,0:21:31.96,Default,,0,0,0,,Брахман
Dialogue: 0,0:21:32.30,0:21:35.83,Default,,0,0,0,,Аа
Dialogue: 0,0:21:35.93,0:21:36.76,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:21:44.43,0:21:47.03,Default,,0,0,0,,Мм.
Dialogue: 0,0:21:47.83,0:21:48.76,Default,,0,0,0,,Құрметті
Dialogue: 0,0:21:50.46,0:21:52.73,Default,,0,0,0,,Ратнасамбхава
Dialogue: 0,0:22:00.40,0:22:01.30,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:01.36,0:22:02.20,Default,,0,0,0,,Не?
Dialogue: 0,0:22:04.53,0:22:06.36,Default,,0,0,0,,Амитабх
Dialogue: 0,0:22:17.93,0:22:18.50,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:22:24.53,0:22:26.13,Default,,0,0,0,,Жаман ойлар
Dialogue: 0,0:22:26.66,0:22:29.83,Default,,0,0,0,,Оны қазір жойыңыз
Dialogue: 0,0:22:34.80,0:22:47.60,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:48.20,0:22:54.26,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.93,0:23:01.90,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.20,0:23:05.43,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:05.73,0:23:08.80,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.03,0:23:12.36,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.63,0:23:15.83,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.80,0:23:27.53,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:27.80,0:23:37.66,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.20,0:23:49.13,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.53,0:24:03.66,Default,,0,0,0,,Тірі заттар Барлық заттар
Dialogue: 0,0:24:03.96,0:24:07.23,Default,,0,0,0,,Ол бір күні міндетті түрде жойылады
Dialogue: 0,0:24:08.20,0:24:11.66,Default,,0,0,0,,Эволюцияның соңы көрінгенде
Dialogue: 0,0:24:12.33,0:24:14.30,Default,,0,0,0,,Болашақ спираль
Dialogue: 0,0:24:15.00,0:24:18.50,Default,,0,0,0,,Шырылдау, сықырлау, шытырлату.
Dialogue: 0,0:24:20.10,0:24:22.16,Default,,0,0,0,,Сіздің гендеріңіз
Dialogue: 0,0:24:23.23,0:24:24.83,Default,,0,0,0,,Бұрылған
Dialogue: 0,0:24:26.33,0:24:32.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
