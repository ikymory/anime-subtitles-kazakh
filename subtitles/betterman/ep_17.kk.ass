Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.90,0:00:16.36,Default,,0,0,0,,Ламия сен мені естисің бе?
Dialogue: 0,0:00:17.60,0:00:18.86,Default,,0,0,0,,Якусуги пайда болды
Dialogue: 0,0:00:31.36,0:00:33.46,Default,,0,0,0,,Ратнасамбхава
Dialogue: 0,0:00:40.36,0:00:41.40,Default,,0,0,0,,Якусуги
Dialogue: 0,0:00:47.10,0:00:48.23,Default,,0,0,0,,Турбаға не болды?
Dialogue: 0,0:00:52.66,0:00:55.13,Default,,0,0,0,,Мен де солай ұйықтаймын
Dialogue: 0,0:00:55.73,0:00:57.90,Default,,0,0,0,,Ламия Бұл қайда?
Dialogue: 0,0:00:58.76,0:01:01.10,Default,,0,0,0,,Lamia арнасын ашыңыз
Dialogue: 0,0:01:22.66,0:01:32.13,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:34.53,0:01:42.73,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:01:44.40,0:01:53.33,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:56.26,0:02:04.33,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:02:07.50,0:02:16.26,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:16.76,0:02:24.73,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:26.70,0:02:36.23,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:36.43,0:02:48.23,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:57.66,0:02:58.56,Default,,0,0,0,,Хиноки?
Dialogue: 0,0:03:06.43,0:03:10.43,Default,,0,0,0,,Бүгін бізге қосылғаныңыз үшін рахмет.
Dialogue: 0,0:03:10.66,0:03:11.13,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:03:13.00,0:03:17.50,Default,,0,0,0,,Мен Кей-чанның мен өскен қаланы көруін қаладым.
Dialogue: 0,0:03:17.73,0:03:19.86,Default,,0,0,0,,Міне.
Dialogue: 0,0:03:20.96,0:03:21.76,Default,,0,0,0,,К-чан
Dialogue: 0,0:03:26.03,0:03:26.60,Default,,0,0,0,,О
Dialogue: 0,0:03:27.36,0:03:29.63,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:03:29.70,0:03:30.56,Default,,0,0,0,,Бабун
Dialogue: 0,0:03:34.23,0:03:37.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:37.60,0:03:39.13,Default,,0,0,0,,Жарайды дейсіз бе?
Dialogue: 0,0:03:39.16,0:03:41.56,Default,,0,0,0,,Иә, иә, осындай кездер.
Dialogue: 0,0:03:41.70,0:03:44.30,Default,,0,0,0,,Мен жинақталған тағамдарды жемеймін, бірақ мен оларды тіс тазалағыш деп атаймын.
Dialogue: 0,0:03:44.46,0:03:46.40,Default,,0,0,0,,Мен бүгін таңертең тісімді үш рет дұрыс тазаладым.
Dialogue: 0,0:03:46.50,0:03:49.76,Default,,0,0,0,,Сенімді болу үшін мен «Жаңадан бастаушылар үшін қалай сүйісу керек» дегенді де оқыдым.
Dialogue: 0,0:03:50.03,0:03:52.06,Default,,0,0,0,,Жоқ, бірақ күте тұрыңыз.
Dialogue: 0,0:03:52.26,0:03:57.66,Default,,0,0,0,,Егер мен бастаушы болсам, ал Хиноки болмаса ше?
Dialogue: 0,0:03:57.83,0:04:01.83,Default,,0,0,0,,Жасамағаныма өкінгеннен гөрі, мұны істегеніме өкінгенім артық.
Dialogue: 0,0:04:01.96,0:04:06.66,Default,,0,0,0,,...
Dialogue: 0,0:04:07.30,0:04:10.93,Default,,0,0,0,,Хинокидің ерні жұмсақ
Dialogue: 0,0:04:12.96,0:04:14.70,Default,,0,0,0,,Хахаха менің тынысым
Dialogue: 0,0:04:15.23,0:04:17.46,Default,,0,0,0,,Иә, неге тоқтау керек?
Dialogue: 0,0:04:17.73,0:04:18.43,Default,,0,0,0,,Hii
Dialogue: 0,0:04:19.03,0:04:19.46,Default,,0,0,0,,Уф
Dialogue: 0,0:04:19.56,0:04:22.30,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:04:22.63,0:04:24.43,Default,,0,0,0,,Тағы күтіңіз
Dialogue: 0,0:04:24.70,0:04:26.90,Default,,0,0,0,,Ува және тотото Уеах
Dialogue: 0,0:04:30.00,0:04:31.20,Default,,0,0,0,,Wa Pe
Dialogue: 0,0:04:33.33,0:04:34.80,Default,,0,0,0,,-Уу -Бучуу
Dialogue: 0,0:04:34.83,0:04:35.70,Default,,0,0,0,,Жоқ, уау.
Dialogue: 0,0:04:39.03,0:04:41.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.80,0:04:46.33,Default,,0,0,0,,Ең жаман арман
Dialogue: 0,0:04:53.70,0:04:54.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:55.03,0:04:57.66,Default,,0,0,0,,Бірақ бұл керемет арман болды.
Dialogue: 0,0:04:58.00,0:05:00.70,Default,,0,0,0,,Ушидің түрін көргенде құсып кететін сияқтымын.
Dialogue: 0,0:05:01.86,0:05:05.30,Default,,0,0,0,,Увато тото ова тотото хехе
Dialogue: 0,0:05:05.50,0:05:06.76,Default,,0,0,0,,Уау
Dialogue: 0,0:05:11.86,0:05:13.33,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:17.06,0:05:19.00,Default,,0,0,0,,Бұл менің кінәм емес
Dialogue: 0,0:05:24.43,0:05:27.50,Default,,0,0,0,,Мен уақытында болдым.
Dialogue: 0,0:05:27.63,0:05:28.80,Default,,0,0,0,,Оу Кейта
Dialogue: 0,0:05:29.00,0:05:32.53,Default,,0,0,0,,О, не? Ерніме тиме.
Dialogue: 0,0:05:33.10,0:05:36.80,Default,,0,0,0,,Саған не болды? Бүгін таңертең сіздің реакцияңыз қандай?
Dialogue: 0,0:05:37.20,0:05:40.06,Default,,0,0,0,,Хмм, менің армандарым аздап нашар деп ойлаймын.
Dialogue: 0,0:05:40.40,0:05:40.86,Default,,0,0,0,,Уф
Dialogue: 0,0:05:43.46,0:05:47.03,Default,,0,0,0,,Ка Какака Crashman моделі он бірінші…
Dialogue: 0,0:05:49.96,0:05:51.46,Default,,0,0,0,,Сәлем хехехе
Dialogue: 0,0:05:52.56,0:05:56.06,Default,,0,0,0,,Сумире Сузуран Маған ұнайды, неге?
Dialogue: 0,0:05:57.10,0:06:00.73,Default,,0,0,0,,Аяме Гортензия Ол адам келмейді
Dialogue: 0,0:06:01.60,0:06:02.06,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:03.63,0:06:04.33,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:06:12.60,0:06:14.90,Default,,0,0,0,,Охо Кичору Кичору
Dialogue: 0,0:06:15.43,0:06:16.93,Default,,0,0,0,,Карри Кишимен-чан
Dialogue: 0,0:06:17.43,0:06:19.26,Default,,0,0,0,,Фуфуфуфун
Dialogue: 0,0:06:19.60,0:06:22.33,Default,,0,0,0,,Фу Фу Фу
Dialogue: 0,0:06:24.86,0:06:26.56,Default,,0,0,0,,Ммм?
Dialogue: 0,0:06:29.56,0:06:32.16,Default,,0,0,0,,Эй, эй, бұл не?
Dialogue: 0,0:06:33.23,0:06:36.90,Default,,0,0,0,,Довааааааааааааааааааааааааааааааа
Dialogue: 0,0:06:38.50,0:06:40.93,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:06:41.00,0:06:44.26,Default,,0,0,0,,Оян, президент. Ал президент ше?
Dialogue: 0,0:06:45.13,0:06:46.10,Default,,0,0,0,,Наа
Dialogue: 0,0:06:46.30,0:06:48.30,Default,,0,0,0,,Түске таяу келемін деп уәде бердің.
Dialogue: 0,0:06:48.86,0:06:50.00,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:06:50.40,0:06:52.30,Default,,0,0,0,,Ах, кешір, кешір
Dialogue: 0,0:06:52.36,0:06:55.10,Default,,0,0,0,,Аа, мен тым көп жұмыс істеген сияқтымын.
Dialogue: 0,0:06:56.03,0:06:57.13,Default,,0,0,0,,Шай ішуге бола ма?
Dialogue: 0,0:06:57.46,0:06:59.66,Default,,0,0,0,,Иә, иә, Куми-чан, өтінемін.
Dialogue: 0,0:07:05.33,0:07:10.30,Default,,0,0,0,,Сонымен, сіз үш тиранның кімді басқарғанын білдіңіз бе?
Dialogue: 0,0:07:12.10,0:07:14.03,Default,,0,0,0,,Бұл Тиранның жетілдірілген прототипі.
Dialogue: 0,0:07:14.60,0:07:16.73,Default,,0,0,0,,Премьер-министр Дю Троа
Dialogue: 0,0:07:17.46,0:07:20.10,Default,,0,0,0,,Мен қалдықтарды егжей-тегжейлі зерттедім.
Dialogue: 0,0:07:20.90,0:07:22.33,Default,,0,0,0,,Ұшқыш болмаған
Dialogue: 0,0:07:23.50,0:07:26.10,Default,,0,0,0,,Олардың бәрі бір жерде жоғалып кетті ме?
Dialogue: 0,0:07:26.53,0:07:27.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:28.46,0:07:33.20,Default,,0,0,0,,Әу бастан үш Тиранның бортында ешкім болған жоқ.
Dialogue: 0,0:07:33.86,0:07:36.10,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:07:36.60,0:07:39.30,Default,,0,0,0,,Кеше біз француз филиалынан есеп алдық.
Dialogue: 0,0:07:40.13,0:07:41.63,Default,,0,0,0,,Бұл оқиғаның себебі
Dialogue: 0,0:07:42.16,0:07:47.10,Default,,0,0,0,,Бұл Тиранның басқару орталығы тәуелсіз шешім қабылдауды өз бетінше белгілегендіктен деп айтылады.
Dialogue: 0,0:07:48.53,0:07:51.96,Default,,0,0,0,,Нейроноидтың өз еркі бар ма?
Dialogue: 0,0:07:53.13,0:07:54.46,Default,,0,0,0,,Сену қиын, бірақ
Dialogue: 0,0:07:54.93,0:07:56.36,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:07:57.16,0:07:59.50,Default,,0,0,0,,Біз пайдаланып жатқан Тиран 4-бөлім.
Dialogue: 0,0:08:00.00,0:08:01.50,Default,,0,0,0,,Сіз Катриер сияқты бірдеңе айттыңыз.
Dialogue: 0,0:08:02.56,0:08:07.43,Default,,0,0,0,,Бұл оның бір күні өз еркімен әрекет ете бастауы мүмкін дегенді білдіре ме?
Dialogue: 0,0:08:10.33,0:08:12.10,Default,,0,0,0,,Тиранның үш бастапқы түріне жатады
Dialogue: 0,0:08:12.60,0:08:15.86,Default,,0,0,0,,Басқару орталығы ретінде арнайы биологиялық блок қолданылады.
Dialogue: 0,0:08:16.50,0:08:18.23,Default,,0,0,0,,Арнайы биологиялық бірлік?
Dialogue: 0,0:08:19.83,0:08:21.56,Default,,0,0,0,,Адамның ми қыртысы
Dialogue: 0,0:08:21.90,0:08:22.50,Default,,0,0,0,,Не
Dialogue: 0,0:08:23.40,0:08:27.53,Default,,0,0,0,,Әрине, ол жазатайым оқиғадан қайтыс болған үлгіден алынған.
Dialogue: 0,0:08:37.33,0:08:41.10,Default,,0,0,0,,Аа, менде көп пікір бар, бірақ бәрібір.
Dialogue: 0,0:08:41.60,0:08:46.70,Default,,0,0,0,,Басқаша айтқанда, сол тирандар өшпенділікпен жанданған елестер еді.
Dialogue: 0,0:08:47.23,0:08:51.23,Default,,0,0,0,,Қашқын мінез-құлықтың қауіптілігі ең басынан-ақ көрсетілген.
Dialogue: 0,0:08:52.03,0:08:55.06,Default,,0,0,0,,Сол себепті үш дене болады
Dialogue: 0,0:08:55.46,0:08:58.00,Default,,0,0,0,,Француз филиалының жертөлесінде мөрленген.
Dialogue: 0,0:08:59.23,0:09:02.83,Default,,0,0,0,,Сонымен, сіз төртіншімен бірдеңе жасадыңыз, солай ма?
Dialogue: 0,0:09:03.40,0:09:07.50,Default,,0,0,0,,Катридің биологиялық бірлігі - Заирде тұратын бонобо.
Dialogue: 0,0:09:08.23,0:09:10.36,Default,,0,0,0,,Гоминидалар тұқымдасына жататын шимпанзелердің бір түрі.
Dialogue: 0,0:09:11.06,0:09:13.13,Default,,0,0,0,,Оның ми қыртысын пайдаланады
Dialogue: 0,0:09:16.46,0:09:20.26,Default,,0,0,0,,Сізде адамдармен проблемалар болды, сондықтан сіз маймылдарды ауыстырдыңыз ба?
Dialogue: 0,0:09:21.26,0:09:22.66,Default,,0,0,0,,Бұл жиіркенішті оқиға.
Dialogue: 0,0:09:23.63,0:09:27.30,Default,,0,0,0,,Янаги-кун Кэтридің эксклюзивті бас сүңгуірі болып таңдалды.
Dialogue: 0,0:09:27.90,0:09:29.16,Default,,0,0,0,,Өз қабілеті бойынша
Dialogue: 0,0:09:29.40,0:09:32.76,Default,,0,0,0,,Бұл бақылаудан тыс мінез-құлықты басу мүмкін екендігі анықталғандықтан.
Dialogue: 0,0:09:33.60,0:09:35.13,Default,,0,0,0,,Янагидің қабілеті?
Dialogue: 0,0:09:35.73,0:09:39.50,Default,,0,0,0,,Айтпақшы, сізде модельдеу қабілеті бар екеніне сенімдімін.
Dialogue: 0,0:09:40.46,0:09:43.00,Default,,0,0,0,,Оянған адамдарды басқару орталығы іс жүзінде бар
Dialogue: 0,0:09:43.56,0:09:44.16,Default,,0,0,0,,Шынымен?
Dialogue: 0,0:09:44.86,0:09:46.63,Default,,0,0,0,,Бөтелке дельфиндері қолданылады
Dialogue: 0,0:09:47.00,0:09:50.20,Default,,0,0,0,,Су астындағы іс-әрекеттерге арналған құрал-жабдығы немесе бағдарламалық құралы жоқ оянған адам
Dialogue: 0,0:09:50.56,0:09:52.76,Default,,0,0,0,,Сондықтан сіз еркін жүзе аласыз ба?
Dialogue: 0,0:09:53.20,0:09:53.96,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:09:56.23,0:09:57.96,Default,,0,0,0,,Оянған адамның биологиялық бірлігі
Dialogue: 0,0:09:58.26,0:10:01.63,Default,,0,0,0,,Ертедегі Тиранның кемшіліктерінің орнын толтыру үшін әзірленген.
Dialogue: 0,0:10:02.83,0:10:04.10,Default,,0,0,0,,Нейрондық желі болып табылады
Dialogue: 0,0:10:04.33,0:10:08.70,Default,,0,0,0,,Қос импульстармен басқарылатын қайталама қолдау жүйелерімен шектелген.
Dialogue: 0,0:10:09.60,0:10:13.20,Default,,0,0,0,,Оянған адамның бас сүңгуірсіз іске қосылуы мүмкін емес.
Dialogue: 0,0:10:13.63,0:10:16.16,Default,,0,0,0,,Қауіпсіздік тізбегі қалпына келгенде
Dialogue: 0,0:10:16.73,0:10:17.60,Default,,0,0,0,,Мен сізді сендіре аламын
Dialogue: 0,0:10:18.76,0:10:19.23,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:10:19.53,0:10:21.66,Default,,0,0,0,,Бұл кім? Біз қазір жиналыстамыз.
Dialogue: 0,0:10:25.43,0:10:25.86,Default,,0,0,0,,болып табылады
Dialogue: 0,0:10:30.90,0:10:34.10,Default,,0,0,0,,Ууууууууууууууууууууу...
Dialogue: 0,0:10:40.16,0:10:42.46,Default,,0,0,0,,Эй, Хиноки, сен дүкен аралайсың, солай ма?
Dialogue: 0,0:10:42.80,0:10:45.36,Default,,0,0,0,,Хи хи мен де нан алуға барамын.
Dialogue: 0,0:10:45.70,0:10:46.16,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:10:46.63,0:10:47.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:48.40,0:10:49.10,Default,,0,0,0,,Бөлек
Dialogue: 0,0:10:49.83,0:10:52.10,Default,,0,0,0,,Кечан сәл жағымсыз түс көрді.
Dialogue: 0,0:10:52.56,0:10:54.00,Default,,0,0,0,,Мен жай ғана сөйлескім келмейді
Dialogue: 0,0:10:54.50,0:10:57.90,Default,,0,0,0,,Жаман түс көру дегеніміз не? Сәлем, Хиноки.
Dialogue: 0,0:10:59.86,0:11:01.76,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:11:02.56,0:11:03.43,Default,,0,0,0,,Не?
Dialogue: 0,0:11:03.96,0:11:07.53,Default,,0,0,0,,Чика-чан таң қалды
Dialogue: 0,0:11:07.73,0:11:08.30,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:08.33,0:11:09.46,Default,,0,0,0,,Содан кейін мәселе
Dialogue: 0,0:11:09.63,0:11:14.10,Default,,0,0,0,,Басында төрт аяқты, кейін екі аяқты, ең соңында үш аяқты болды.
Dialogue: 0,0:11:14.13,0:11:14.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.80,0:11:15.26,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:15.56,0:11:17.76,Default,,0,0,0,,3 2 1 0 boo
Dialogue: 0,0:11:17.80,0:11:19.16,Default,,0,0,0,,-Ах жоқ аа -Жауап адам
Dialogue: 0,0:11:19.30,0:11:21.10,Default,,0,0,0,,Балалар сендер тозаққа барасыңдар
Dialogue: 0,0:11:21.13,0:11:22.43,Default,,0,0,0,,Ооо
Dialogue: 0,0:11:22.46,0:11:23.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:28.20,0:11:31.60,Default,,0,0,0,,Хахахаха хахахаха ахахаха
Dialogue: 0,0:11:41.53,0:11:42.33,Default,,0,0,0,,Ламия
Dialogue: 0,0:11:42.86,0:11:45.76,Default,,0,0,0,,Мен күткендей ертерек ояндым.
Dialogue: 0,0:11:46.66,0:11:48.50,Default,,0,0,0,,Біз үшін сомниумдар
Dialogue: 0,0:11:49.10,0:11:51.13,Default,,0,0,0,,Ұйқы - сіздің ең үлкен әлсіздігіңіз
Dialogue: 0,0:11:51.90,0:11:54.00,Default,,0,0,0,,Сақтандырдың, Ламия.
Dialogue: 0,0:11:58.13,0:11:58.60,Default,,0,0,0,,болып табылады
Dialogue: 0,0:12:03.66,0:12:04.96,Default,,0,0,0,,Аберрациялар
Dialogue: 0,0:12:06.10,0:12:07.43,Default,,0,0,0,,Неге қазір мұнда?
Dialogue: 0,0:12:11.06,0:12:12.50,Default,,0,0,0,,Гаргари Гаргари
Dialogue: 0,0:12:14.83,0:12:18.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:32.40,0:12:34.13,Default,,0,0,0,,Гуу
Dialogue: 0,0:12:48.30,0:12:48.86,Default,,0,0,0,,Гууу
Dialogue: 0,0:12:51.40,0:12:53.06,Default,,0,0,0,,Гууууу
Dialogue: 0,0:12:53.43,0:12:54.63,Default,,0,0,0,,Иллюзиядан айырмашылығы
Dialogue: 0,0:12:55.33,0:12:58.30,Default,,0,0,0,,Мөлдір арнам аз емес
Dialogue: 0,0:12:58.70,0:13:00.63,Default,,0,0,0,,Жан түршігерлік сананы басып алу
Dialogue: 0,0:13:01.00,0:13:02.86,Default,,0,0,0,,Гууууууу...
Dialogue: 0,0:13:23.36,0:13:25.46,Default,,0,0,0,,Қос синапсты бомбалау
Dialogue: 0,0:13:32.16,0:13:33.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:36.83,0:13:37.43,Default,,0,0,0,,Кей
Dialogue: 0,0:13:38.96,0:13:39.70,Default,,0,0,0,,Шо
Dialogue: 0,0:13:40.70,0:13:44.13,Default,,0,0,0,,Мен Кейді екі рет өлтірдім.
Dialogue: 0,0:13:44.86,0:13:47.50,Default,,0,0,0,,Шо, бұл сенің кінәң емес.
Dialogue: 0,0:13:49.93,0:13:52.43,Default,,0,0,0,,Жоқ, аға, су кіріп кетті.
Dialogue: 0,0:13:52.66,0:13:53.66,Default,,0,0,0,,Сабыр ет, Кей.
Dialogue: 0,0:13:54.30,0:13:56.20,Default,,0,0,0,,Су асты жабдықтарына релелік реле
Dialogue: 0,0:13:56.43,0:13:59.60,Default,,0,0,0,,Жоқ, көмектесіңізші, аға.
Dialogue: 0,0:13:59.83,0:14:02.46,Default,,0,0,0,,Кей, қолыңды сақина капсуласына қайта сал.
Dialogue: 0,0:14:02.50,0:14:03.96,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:14:04.06,0:14:06.76,Default,,0,0,0,,Аға
Dialogue: 0,0:14:06.83,0:14:11.80,Default,,0,0,0,,Сіздің ағаңыздың қос импульсі өте жақсы болды.
Dialogue: 0,0:14:12.66,0:14:15.10,Default,,0,0,0,,Премьерадағы апат өкінішті болды, бірақ
Dialogue: 0,0:14:15.53,0:14:17.83,Default,,0,0,0,,Мен де оның өлімі бекер болғанын қаламаймын.
Dialogue: 0,0:14:22.03,0:14:27.53,Default,,0,0,0,,Премьера сияқты, ол басқа 11 тірі бірлікпен бірге
Dialogue: 0,0:14:27.70,0:14:30.33,Default,,0,0,0,,Дуджиде тұруды жалғастыр
Dialogue: 0,0:14:32.46,0:14:35.13,Default,,0,0,0,,Шоның еліктеу қабілетіне кім кедергі келтірді?
Dialogue: 0,0:14:35.53,0:14:37.36,Default,,0,0,0,,Бұл Дудзидің қос импульсі болды
Dialogue: 0,0:14:38.63,0:14:41.43,Default,,0,0,0,,Бірақ неге маған қоңырау шалдың?
Dialogue: 0,0:14:42.16,0:14:45.23,Default,,0,0,0,,Мұның бәрі жаман түс болды
Dialogue: 0,0:14:46.00,0:14:48.86,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:14:49.96,0:14:50.73,Default,,0,0,0,,Каэде
Dialogue: 0,0:14:51.66,0:14:52.60,Default,,0,0,0,,О
Dialogue: 0,0:14:56.26,0:14:58.16,Default,,0,0,0,,Ааа аа
Dialogue: 0,0:14:58.80,0:15:02.50,Default,,0,0,0,,Танысқаныма қуаныштымын, хехе, аға.
Dialogue: 0,0:15:03.60,0:15:06.26,Default,,0,0,0,,Уау ха-ха
Dialogue: 0,0:15:07.56,0:15:08.96,Default,,0,0,0,,Шо, не болды?
Dialogue: 0,0:15:09.13,0:15:11.03,Default,,0,0,0,,Иә Иә Иә
Dialogue: 0,0:15:11.16,0:15:13.60,Default,,0,0,0,,Не, сен жартылай ұйықтап жатырсың ба?
Dialogue: 0,0:15:14.03,0:15:15.66,Default,,0,0,0,,Қорқынышты түс көрдің бе?
Dialogue: 0,0:15:16.13,0:15:18.83,Default,,0,0,0,,Президент мырза, Шо шаршады.
Dialogue: 0,0:15:19.50,0:15:21.33,Default,,0,0,0,,Күлсең мен сені аяймын.
Dialogue: 0,0:15:22.60,0:15:23.46,Default,,0,0,0,,Кактус
Dialogue: 0,0:15:24.30,0:15:27.20,Default,,0,0,0,,Не болды, Шо, бозарып тұрсың ба?
Dialogue: 0,0:15:28.00,0:15:31.53,Default,,0,0,0,,Сіз әлемнің түбінде өлуіңіз керек еді.
Dialogue: 0,0:15:32.13,0:15:34.63,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:35.00,0:15:36.50,Default,,0,0,0,,Мені өлтірмесең де
Dialogue: 0,0:15:36.96,0:15:40.13,Default,,0,0,0,,Мен Каеданы сенен алмас едім.
Dialogue: 0,0:15:40.23,0:15:41.30,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:41.53,0:15:42.83,Default,,0,0,0,,-Уфуфуфу -Ахахаха...
Dialogue: 0,0:15:42.96,0:15:46.60,Default,,0,0,0,,Ахахаха хахаха…
Dialogue: 0,0:15:46.76,0:15:49.13,Default,,0,0,0,,Сіз жай ғана шаршадыңыз
Dialogue: 0,0:15:50.06,0:15:51.43,Default,,0,0,0,,Мен жай ғана шаршадым
Dialogue: 0,0:15:51.83,0:15:52.63,Default,,0,0,0,,Хахаха хахаха
Dialogue: 0,0:15:52.70,0:15:56.00,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:15:56.13,0:15:58.00,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:16.50,0:16:18.30,Default,,0,0,0,,Гуоооо
Dialogue: 0,0:16:20.90,0:16:21.76,Default,,0,0,0,,Гуар
Dialogue: 0,0:16:23.90,0:16:24.53,Default,,0,0,0,,Тұмандық
Dialogue: 0,0:16:25.13,0:16:27.33,Default,,0,0,0,,Турба Не болып жатыр?
Dialogue: 0,0:16:27.70,0:16:28.53,Default,,0,0,0,,Гуон
Dialogue: 0,0:16:28.73,0:16:30.43,Default,,0,0,0,,Гаун
Dialogue: 0,0:16:50.03,0:16:51.23,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:16:52.23,0:16:53.23,Default,,0,0,0,,Кяхаха
Dialogue: 0,0:17:03.00,0:17:05.56,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:17:13.30,0:17:15.00,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:17:20.70,0:17:24.70,Default,,0,0,0,,Уф, бұл ауыр.
Dialogue: 0,0:17:25.20,0:17:27.36,Default,,0,0,0,,Мені бұл жерден кетіріңіз
Dialogue: 0,0:17:35.06,0:17:37.06,Default,,0,0,0,,Неліктен кактус?
Dialogue: 0,0:17:37.90,0:17:38.80,Default,,0,0,0,,Алджернон
Dialogue: 0,0:17:47.80,0:17:51.03,Default,,0,0,0,,Оянғым келсе де, тұра алмаймын.
Dialogue: 0,0:17:58.16,0:17:59.86,Default,,0,0,0,,Барлығы қайда?
Dialogue: 0,0:18:01.56,0:18:03.10,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:04.13,0:18:05.50,Default,,0,0,0,,Сіз жалғыз боласыз ба?
Dialogue: 0,0:18:08.66,0:18:11.33,Default,,0,0,0,,Әке анашым
Dialogue: 0,0:18:15.63,0:18:16.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.70,0:18:18.33,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:19.40,0:18:20.66,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:18:21.46,0:18:22.26,Default,,0,0,0,,Кактус?
Dialogue: 0,0:18:22.83,0:18:24.63,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:18:25.63,0:18:30.00,Default,,0,0,0,,Бізге келсең, жалғыздығыңды, мұңыңды кетіреміз.
Dialogue: 0,0:18:30.26,0:18:31.13,Default,,0,0,0,,Сауықты
Dialogue: 0,0:18:37.30,0:18:38.30,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:18:39.00,0:18:40.00,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:18:40.63,0:18:41.76,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:18:42.66,0:18:44.60,Default,,0,0,0,,Бізге келіңіз
Dialogue: 0,0:18:48.73,0:18:50.66,Default,,0,0,0,,Бізге келіңіз
Dialogue: 0,0:18:54.30,0:18:54.86,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:18:55.43,0:18:58.93,Default,,0,0,0,,Арман мен шындық Шындық пен арман
Dialogue: 0,0:19:00.26,0:19:04.53,Default,,0,0,0,,Түсіме кірген жаман ойлар жойылуы керек.
Dialogue: 0,0:19:05.36,0:19:06.33,Default,,0,0,0,,Фуфу
Dialogue: 0,0:19:14.86,0:19:18.93,Default,,0,0,0,,Бұл чакра барлық кеңістік құбылыстарын қабылдайды.
Dialogue: 0,0:19:20.10,0:19:21.23,Default,,0,0,0,,Валочана
Dialogue: 0,0:19:25.06,0:19:25.53,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:19:26.03,0:19:31.03,Default,,0,0,0,,Ұйқы сиқырынан ешкім құтыла алмайды.
Dialogue: 0,0:19:31.43,0:19:34.50,Default,,0,0,0,,Бізді жерлеген сен бе?
Dialogue: 0,0:19:34.90,0:19:38.50,Default,,0,0,0,,Менің чакраның басшылығымен ұсынылған.
Dialogue: 0,0:19:39.00,0:19:39.46,Default,,0,0,0,,Уф
Dialogue: 0,0:19:40.76,0:19:44.20,Default,,0,0,0,,Оны осы Аучакраның заңды күшімен жойыңыз.
Dialogue: 0,0:19:44.63,0:19:46.23,Default,,0,0,0,,Амитабх
Dialogue: 0,0:19:47.43,0:19:47.90,Default,,0,0,0,,Иә
Dialogue: 0,0:19:48.53,0:19:49.10,Default,,0,0,0,,Уау
Dialogue: 0,0:19:51.60,0:19:52.86,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:19:53.13,0:19:53.93,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:19:54.53,0:19:55.56,Default,,0,0,0,,U га
Dialogue: 0,0:19:56.26,0:19:58.90,Default,,0,0,0,,Гяаа
Dialogue: 0,0:20:08.93,0:20:09.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:10.53,0:20:11.40,Default,,0,0,0,,Кактус?
Dialogue: 0,0:20:23.26,0:20:26.90,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:27.00,0:20:27.53,Default,,0,0,0,,...
Dialogue: 0,0:20:27.70,0:20:31.10,Default,,0,0,0,,Гррр... гррр...
Dialogue: 0,0:20:31.80,0:20:32.96,Default,,0,0,0,,Хмм аа
Dialogue: 0,0:20:34.03,0:20:37.13,Default,,0,0,0,,Уф, мен шаршадым.
Dialogue: 0,0:20:37.30,0:20:39.63,Default,,0,0,0,,А, менің есімде жоқ.
Dialogue: 0,0:20:40.53,0:20:43.06,Default,,0,0,0,,Мен шынымен жаман түс көргендей болдым.
Dialogue: 0,0:20:43.56,0:20:44.66,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:44.70,0:20:46.53,Default,,0,0,0,,Аа, менің басым ауырып тұр.
Dialogue: 0,0:20:48.13,0:20:49.80,Default,,0,0,0,,Қандай да бір қайғылы сезім
Dialogue: 0,0:20:50.63,0:20:52.26,Default,,0,0,0,,Әй, құсқым келеді
Dialogue: 0,0:20:53.16,0:20:56.63,Default,,0,0,0,,А, мен Тиран туралы жиналыста болдым.
Dialogue: 0,0:20:57.40,0:21:01.06,Default,,0,0,0,,Ұйқым келіп, түс көріп ұйықтап жатырмын.
Dialogue: 0,0:21:01.83,0:21:04.16,Default,,0,0,0,,Мидағы ацетилхолинді нейрондар
Dialogue: 0,0:21:04.96,0:21:07.20,Default,,0,0,0,,Ұйқы кезінде есте сақтауды ұйымдастыру арқылы
Dialogue: 0,0:21:07.53,0:21:09.50,Default,,0,0,0,,Түс көрген оқиғалар орын алады деп айтылады.
Dialogue: 0,0:21:10.50,0:21:11.93,Default,,0,0,0,,Бұл ми толқынының сигналдары
Dialogue: 0,0:21:12.30,0:21:16.80,Default,,0,0,0,,Оны мөлдір арна сияқты сырттай манипуляциялау мүмкін емес.
Dialogue: 0,0:21:17.66,0:21:21.26,Default,,0,0,0,,Бұл Бегемоттың шақыруы сияқты галлюцинациядан өзгеше.
Dialogue: 0,0:21:22.53,0:21:27.06,Default,,0,0,0,,Мелатонин мені сергек ұстау үшін үнемі бөлініп тұратындай болды.
Dialogue: 0,0:21:27.56,0:21:29.56,Default,,0,0,0,,Демек, бұл ұжымдық қорқынышты түс пе?
Dialogue: 0,0:21:30.20,0:21:31.76,Default,,0,0,0,,Маған мұндай пайымдаулар маңызды емес.
Dialogue: 0,0:21:31.96,0:21:34.16,Default,,0,0,0,,Менің біраз уақыт ұйықтағым келмейді
Dialogue: 0,0:21:35.83,0:21:36.70,Default,,0,0,0,,Біреу
Dialogue: 0,0:21:38.13,0:21:39.26,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,0:21:39.56,0:21:42.30,Default,,0,0,0,,Хмм, жақсы адам?
Dialogue: 0,0:21:43.16,0:21:45.90,Default,,0,0,0,,Жоқ, ол басқаша.
Dialogue: 0,0:21:47.13,0:21:49.80,Default,,0,0,0,,Қоңыраудың шырылдағанын естідім.
Dialogue: 0,0:21:50.90,0:21:54.20,Default,,0,0,0,,Ол адам сол адам
Dialogue: 0,0:21:59.16,0:22:01.23,Default,,0,0,0,,Ламия Бодайджу
Dialogue: 0,0:22:02.10,0:22:04.06,Default,,0,0,0,,Егер Якусуги пайда болмаса
Dialogue: 0,0:22:04.60,0:22:07.56,Default,,0,0,0,,Сіз ешқашан оянған жоқсыз
Dialogue: 0,0:22:08.86,0:22:13.20,Default,,0,0,0,,Өзгелерден зардап шегіп, басқалар құтқару деген нені білдіреді?
Dialogue: 0,0:22:14.20,0:22:17.86,Default,,0,0,0,,Алда - кінәлі күш
Dialogue: 0,0:22:19.03,0:22:21.20,Default,,0,0,0,,Қиындыққа ұшырайтын кез емес.
Dialogue: 0,0:22:22.43,0:22:25.53,Default,,0,0,0,,Біз өз қабілеттерімізді біріктіруіміз керек
Dialogue: 0,0:22:26.36,0:22:29.36,Default,,0,0,0,,Үмітімізді сақтау үшін
Dialogue: 0,0:22:35.46,0:22:48.06,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:48.66,0:22:54.90,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:55.40,0:23:02.43,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.73,0:23:06.03,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:06.23,0:23:09.43,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.60,0:23:12.80,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:13.13,0:23:16.40,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:18.30,0:23:27.96,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:28.53,0:23:38.06,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.80,0:23:49.73,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.50,0:24:02.66,Default,,0,0,0,,Көп шырын ағып жатыр
Dialogue: 0,0:24:03.26,0:24:06.66,Default,,0,0,0,,Өте дәмді көрінеді
Dialogue: 0,0:24:07.36,0:24:10.80,Default,,0,0,0,,Белоктар үшін бәсеке
Dialogue: 0,0:24:11.63,0:24:14.86,Default,,0,0,0,,Аштықтан тамақ ішпей жазылмайды.
Dialogue: 0,0:24:15.90,0:24:19.20,Default,,0,0,0,,Мен сізді жеуге рұқсат етіңіз
Dialogue: 0,0:24:20.43,0:24:22.63,Default,,0,0,0,,Сізді сүйекке дейін кесіңіз
Dialogue: 0,0:24:23.16,0:24:24.73,Default,,0,0,0,,Мен оны сорайын
Dialogue: 0,0:24:26.23,0:24:32.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
