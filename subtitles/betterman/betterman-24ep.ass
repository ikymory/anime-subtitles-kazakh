Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.93,0:00:15.23,Default,,0,0,0,,Мен Хинокиді жалғыз қалдырмаймын.
Dialogue: 0,0:00:16.90,0:00:19.36,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын деп уәде бердім.
Dialogue: 0,0:00:20.46,0:00:21.43,Default,,0,0,0,,Және де
Dialogue: 0,0:00:21.93,0:00:25.30,Default,,0,0,0,,Төтенше адамдық одақ жойылды, сондықтан мен күзетімді түсірдім.
Dialogue: 0,0:00:25.66,0:00:29.40,Default,,0,0,0,,Хиноки-чан, сіз Беттерманды балық аулауға жем ретінде пайдалануды жоспарлап отырған шығарсыз.
Dialogue: 0,0:00:29.93,0:00:30.46,Default,,0,0,0,,Жем?
Dialogue: 0,0:00:31.30,0:00:35.16,Default,,0,0,0,,Cherry Hinopy қайда екенін білмейсіз бе?
Dialogue: 0,0:00:35.86,0:00:37.20,Default,,0,0,0,,Теңізде
Dialogue: 0,0:00:37.90,0:00:39.60,Default,,0,0,0,,Асылған арал
Dialogue: 0,0:00:40.53,0:00:41.86,Default,,0,0,0,,ромб
Dialogue: 0,0:00:42.10,0:00:42.83,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:00:43.10,0:00:43.80,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:00:44.36,0:00:45.86,Default,,0,0,0,,Алмаз тәрізді арал дегеніміз не?
Dialogue: 0,0:00:46.33,0:00:47.93,Default,,0,0,0,,Мордиварптың штаб-пәтері?
Dialogue: 0,0:00:48.20,0:00:49.33,Default,,0,0,0,,Хиноки болды.
Dialogue: 0,0:00:50.00,0:00:51.90,Default,,0,0,0,,-Олай болса, асығуымыз керек. -Хмм?
Dialogue: 0,0:00:52.03,0:00:52.93,Default,,0,0,0,,-Иә -Уау
Dialogue: 0,0:00:53.00,0:00:54.33,Default,,0,0,0,,Енді сегіз сағаттан кейін
Dialogue: 0,0:00:55.50,0:00:56.63,Default,,0,0,0,,Мордиварптың штаб-пәтері
Dialogue: 0,0:00:57.56,0:00:58.53,Default,,0,0,0,,Сөндіру
Dialogue: 0,0:01:01.80,0:01:11.20,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:13.66,0:01:21.80,Default,,0,0,0,,Қалқымалы күміс қайық
Dialogue: 0,0:01:23.63,0:01:32.36,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:35.36,0:01:43.30,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:01:46.63,0:01:55.43,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:55.90,0:02:03.96,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:05.76,0:02:15.30,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:15.73,0:02:27.90,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:35.23,0:02:36.96,Default,,0,0,0,,Мордиварптың штаб-пәтері қайда орналасқан?
Dialogue: 0,0:02:37.36,0:02:40.73,Default,,0,0,0,,Бастапқыда мұхит түбінде жатқан метангидратты өндіру негізі
Dialogue: 0,0:02:41.53,0:02:45.93,Default,,0,0,0,,Тосыннан болған апат салдарынан көп мөлшерде сақталған метангидрат жарылған.
Dialogue: 0,0:02:46.30,0:02:48.60,Default,,0,0,0,,Штаб – теңіздің қоқысына айналатын учаске
Dialogue: 0,0:02:49.03,0:02:50.83,Default,,0,0,0,,Сюжет туралы не деуге болады?
Dialogue: 0,0:02:51.33,0:02:55.00,Default,,0,0,0,,Шындығында, бомбалау рейдін Біріккен Ұлттар Ұйымының күштері орындайтын болады.
Dialogue: 0,0:02:55.96,0:03:01.00,Default,,0,0,0,,Мәселелері бар басқа нысандар да дәл осылай жойылған сияқты.
Dialogue: 0,0:03:02.06,0:03:04.86,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:03:05.26,0:03:06.93,Default,,0,0,0,,Штабтың барлық қызметкерлері
Dialogue: 0,0:03:07.03,0:03:11.70,Default,,0,0,0,,NEO оны Альджернон жұқтырған деп шешті.
Dialogue: 0,0:03:12.36,0:03:13.76,Default,,0,0,0,,NEO?
Dialogue: 0,0:03:15.30,0:03:17.80,Default,,0,0,0,,Келесі зиянды қорғау ұйымы
Dialogue: 0,0:03:18.70,0:03:22.23,Default,,0,0,0,,Келесі ұрпақтың қоршаған ортаны қорғау агенттігі, Mordiwarp бас ұйымы
Dialogue: 0,0:03:23.06,0:03:26.56,Default,,0,0,0,,NEO-мен байланысып, әуе шабуылынан бас тарта алмайсыз ба?
Dialogue: 0,0:03:27.10,0:03:30.26,Default,,0,0,0,,Бұл мүмкін емес. Тіпті бізді өшіріп тастауға болады.
Dialogue: 0,0:03:30.96,0:03:31.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:32.00,0:03:34.60,Default,,0,0,0,,Менің де NEO-ға хабарлайтын досым бар.
Dialogue: 0,0:03:34.76,0:03:37.36,Default,,0,0,0,,Мен электрондық пошта арқылы құпия ақпаратты алдым.
Dialogue: 0,0:03:38.56,0:03:41.33,Default,,0,0,0,,Мен оны тоқтату үшін бұқаралық ақпарат құралдарын пайдалану туралы ойладым.
Dialogue: 0,0:03:41.46,0:03:45.03,Default,,0,0,0,,Күрсін, уақытымыз аз.
Dialogue: 0,0:03:45.50,0:03:47.10,Default,,0,0,0,,Бірақ мен сенімді емеспін.
Dialogue: 0,0:03:48.33,0:03:49.10,Default,,0,0,0,,Жын қақпасының жігіті
Dialogue: 0,0:03:50.20,0:03:53.26,Default,,0,0,0,,Неліктен Хинокиді Мордиварптың штаб-пәтеріне әкелдіңіз?
Dialogue: 0,0:03:53.80,0:03:55.63,Default,,0,0,0,,Хиноки-чанның өмірлік энергиясы
Dialogue: 0,0:03:56.26,0:03:59.80,Default,,0,0,0,,Ол өте жақсы анимус гүлін гүлдейді.
Dialogue: 0,0:04:00.40,0:04:01.20,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:04:01.60,0:04:04.00,Default,,0,0,0,,Бұл билік Беттерман руына арналған.
Dialogue: 0,0:04:05.23,0:04:06.80,Default,,0,0,0,,Бұл маңызды тағам көзі.
Dialogue: 0,0:04:08.06,0:04:10.90,Default,,0,0,0,,Мен Ламияны елес қалада кездестірдім.
Dialogue: 0,0:04:11.33,0:04:12.63,Default,,0,0,0,,Маған солай айтты
Dialogue: 0,0:04:13.06,0:04:15.86,Default,,0,0,0,,Шынында да, Хиноки-санның қос импульсі
Dialogue: 0,0:04:16.10,0:04:18.33,Default,,0,0,0,,Орташа мәннен әлдеқайда жоғары
Dialogue: 0,0:04:19.26,0:04:21.06,Default,,0,0,0,,Мүмкін мұны растау үшін
Dialogue: 0,0:04:21.50,0:04:25.63,Default,,0,0,0,,Менің ойымша, Мамон мырза сандарды өлшеу үшін оянған адамды пайдаланды.
Dialogue: 0,0:04:27.83,0:04:31.26,Default,,0,0,0,,Осы уақытқа дейін Беттерман бізге көмектесті.
Dialogue: 0,0:04:31.80,0:04:34.13,Default,,0,0,0,,Өйткені Хинокиді қорғау керек болды
Dialogue: 0,0:04:34.93,0:04:36.56,Default,,0,0,0,,Өзімізді қорғау үшін
Dialogue: 0,0:04:37.23,0:04:40.43,Default,,0,0,0,,Брахман – ең күшті адам нәсілінің эволюциясы
Dialogue: 0,0:04:40.80,0:04:45.06,Default,,0,0,0,,Бірақ тұтас болу үшін бізге тағы бір ырым керек.
Dialogue: 0,0:04:45.80,0:04:48.03,Default,,0,0,0,,Мен Каэде-санды қолданған кездегідей
Dialogue: 0,0:04:48.66,0:04:49.93,Default,,0,0,0,,Сүңгуірді тексеру
Dialogue: 0,0:04:50.56,0:04:52.06,Default,,0,0,0,,7 жыл бұрын жасалған
Dialogue: 0,0:04:52.36,0:04:54.80,Default,,0,0,0,,Ең күшті денені іздеудегі тәжірибелер
Dialogue: 0,0:04:55.53,0:04:59.46,Default,,0,0,0,,Мен оны Беттерманның ДНҚ-сын пайдаланып, қазір қайталауды жоспарлап отырмын.
Dialogue: 0,0:04:59.96,0:05:02.06,Default,,0,0,0,,Құрылыстар қайда орналасқан
Dialogue: 0,0:05:02.90,0:05:04.16,Default,,0,0,0,,Мордиварптың штаб-пәтері
Dialogue: 0,0:05:05.03,0:05:07.86,Default,,0,0,0,,Тәжірибе үшін Беттерман қажет
Dialogue: 0,0:05:08.30,0:05:12.03,Default,,0,0,0,,Сізге жақсырақ адамды шақыру үшін Хиноки керек пе?
Dialogue: 0,0:05:12.33,0:05:13.13,Default,,0,0,0,,үшін
Dialogue: 0,0:05:13.16,0:05:13.63,Default,,0,0,0,,Ах
Dialogue: 0,0:05:13.80,0:05:15.13,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:05:16.16,0:05:21.66,Default,,0,0,0,,Беттерман Хиноки-санды жоғалтса, аман қала алмайды.
Dialogue: 0,0:05:22.50,0:05:25.63,Default,,0,0,0,,Бірақ Беттерман кеткенде
Dialogue: 0,0:05:26.60,0:05:30.23,Default,,0,0,0,,Біз адамдар да өмір сүре алмаймыз.
Dialogue: 0,0:05:31.53,0:05:34.66,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:05:35.06,0:05:40.56,Default,,0,0,0,,Алджернонды тудырған зұлымдық көзі
Dialogue: 0,0:05:41.60,0:05:43.50,Default,,0,0,0,,Өйткені мен оны өшіруге тырысамын
Dialogue: 0,0:05:43.70,0:05:44.16,Default,,0,0,0,,Га
Dialogue: 0,0:05:44.63,0:05:47.63,Default,,0,0,0,,Сондықтан оны тез табыңыз
Dialogue: 0,0:05:48.40,0:05:51.00,Default,,0,0,0,,Жылдам іздеу
Dialogue: 0,0:05:51.66,0:05:54.36,Default,,0,0,0,,маңызды
Dialogue: 0,0:05:54.40,0:05:55.10,Default,,0,0,0,,Уф
Dialogue: 0,0:05:55.53,0:05:58.06,Default,,0,0,0,,маңызды
Dialogue: 0,0:06:00.73,0:06:01.46,Default,,0,0,0,,OK
Dialogue: 0,0:06:01.53,0:06:02.80,Default,,0,0,0,,Иә, көңіл-күйіңізді көтеріңіз.
Dialogue: 0,0:06:02.83,0:06:03.86,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:06:05.30,0:06:06.46,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:06:06.73,0:06:08.03,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:06:23.96,0:06:25.80,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:06:40.56,0:06:43.83,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:44.06,0:06:45.90,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:06:46.30,0:06:48.63,Default,,0,0,0,,Мен сізге сенемін, Президент.
Dialogue: 0,0:06:49.33,0:06:51.33,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,0:06:59.60,0:07:02.33,Default,,0,0,0,,Керемет, тым керемет
Dialogue: 0,0:07:03.06,0:07:04.90,Default,,0,0,0,,Сара-чан, жақсысың ба?
Dialogue: 0,0:07:05.33,0:07:05.80,Default,,0,0,0,,Иә
Dialogue: 0,0:07:06.23,0:07:07.60,Default,,0,0,0,,Ұшу қозғағышы және
Dialogue: 0,0:07:07.73,0:07:12.33,Default,,0,0,0,,Бұл линкер-гель диализ жүйесі бар нейроноидты қолдау механизмі ме?
Dialogue: 0,0:07:12.90,0:07:16.86,Default,,0,0,0,,Бұл глианоид нейроноидпен 90% байланысқан.
Dialogue: 0,0:07:17.76,0:07:22.06,Default,,0,0,0,,Бұл мен сияқты екі жақты емес адамдар да сізге ілесе алады деген сөз.
Dialogue: 0,0:07:22.66,0:07:25.63,Default,,0,0,0,,Осы арқылы біз қысқа уақытта штабқа жете аламыз.
Dialogue: 0,0:07:26.06,0:07:28.43,Default,,0,0,0,,Гельдік диализ де жұмыс істей ме?
Dialogue: 0,0:07:28.83,0:07:32.86,Default,,0,0,0,,Әрекет уақытында шектеу жоқ және синаптикалық оқтарды қалағаныңызша атуға болады.
Dialogue: 0,0:07:33.23,0:07:34.03,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:07:34.40,0:07:38.60,Default,,0,0,0,,Үйге аман-есен жетсем, әкеме немеремнің бетін көрсетуім керек.
Dialogue: 0,0:07:52.60,0:07:54.03,Default,,0,0,0,,Күте тұрыңыз, Хиноки
Dialogue: 0,0:07:55.03,0:07:58.93,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін.
Dialogue: 0,0:08:23.50,0:08:25.06,Default,,0,0,0,,Әлі жауап жоқ
Dialogue: 0,0:08:26.30,0:08:28.63,Default,,0,0,0,,Барлық бөлімдер үнсіз қалады
Dialogue: 0,0:08:29.60,0:08:34.56,Default,,0,0,0,,Ғимараттың ішінде электромагниттік толқындар барлық жерде айналады.
Dialogue: 0,0:08:35.26,0:08:38.23,Default,,0,0,0,,Ішкі күйді разряд арқылы зерттеу мүмкін емес пе?
Dialogue: 0,0:08:39.00,0:08:40.56,Default,,0,0,0,,Мұңды дауыс
Dialogue: 0,0:08:41.33,0:08:44.90,Default,,0,0,0,,Бұл көп, көп жаңғырық.
Dialogue: 0,0:08:45.46,0:08:46.16,Default,,0,0,0,,Жарақат салып жүріп, Магистрдің Қызына дәл ұқсайтын мүсін ойып тастапсың.
Dialogue: 0,0:08:46.70,0:08:48.70,Default,,0,0,0,,Мен бәрібір кетуім керек.
Dialogue: 0,0:08:49.86,0:08:51.43,Default,,0,0,0,,Алдын ала орнатылған навигацияны пайдаланыңыз
Dialogue: 0,0:09:19.30,0:09:20.80,Default,,0,0,0,,Онда ешкім жоқ сияқты
Dialogue: 0,0:09:21.00,0:09:22.40,Default,,0,0,0,,Бұл қорқынышты жағдай.
Dialogue: 0,0:09:22.76,0:09:24.83,Default,,0,0,0,,Бұл менің соңғы келгенімнен мүлде басқаша.
Dialogue: 0,0:09:36.16,0:09:38.03,Default,,0,0,0,,Сара-чанның жағдайы қалай?
Dialogue: 0,0:09:38.23,0:09:38.93,Default,,0,0,0,,Иә
Dialogue: 0,0:09:39.63,0:09:42.86,Default,,0,0,0,,Бауырым, егер жағдай қиындаса, сол жаққа көш.
Dialogue: 0,0:09:43.40,0:09:46.83,Default,,0,0,0,,Өйткені саған асыл өмір сеніп тапсырылған.
Dialogue: 0,0:09:47.46,0:09:49.20,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:09:49.83,0:09:50.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:50.83,0:09:53.80,Default,,0,0,0,,Менің ойымша, мен Хинопиді жағдай нашарлағанша табуым керек.
Dialogue: 0,0:09:54.46,0:09:56.86,Default,,0,0,0,,Бомбалаудың басталуына 4 сағат қалды
Dialogue: 0,0:09:57.16,0:09:58.50,Default,,0,0,0,,Мәселе шұғыл.
Dialogue: 0,0:09:58.76,0:10:02.40,Default,,0,0,0,,Бірақ бұл ғимарат шынымен үлкен, солай емес пе?
Dialogue: 0,0:10:02.80,0:10:04.43,Default,,0,0,0,,Мен оны бір жерде бақылап отыруым керек.
Dialogue: 0,0:10:05.33,0:10:07.46,Default,,0,0,0,,Сен бірдеңені түсіндің бе, Каэде-сан?
Dialogue: 0,0:10:08.20,0:10:08.93,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:10.96,0:10:12.73,Default,,0,0,0,,Шие маған қарағанда жақсы
Dialogue: 0,0:10:13.10,0:10:16.03,Default,,0,0,0,,Тыйым салынған дүние
Dialogue: 0,0:10:16.76,0:10:20.23,Default,,0,0,0,,Жер қойнауы, қираған жер
Dialogue: 0,0:10:20.76,0:10:23.10,Default,,0,0,0,,Қарама Қарама
Dialogue: 0,0:10:23.56,0:10:25.43,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:26.00,0:10:27.70,Default,,0,0,0,,Хиноки қайда орналасқан?
Dialogue: 0,0:10:28.26,0:10:30.40,Default,,0,0,0,,Жердің тереңдігі
Dialogue: 0,0:10:34.46,0:10:36.80,Default,,0,0,0,,Метангидратты өндіру жұмыстары кезінде
Dialogue: 0,0:10:37.13,0:10:39.56,Default,,0,0,0,,Байланыстырғыш гельдің кездейсоқ табылуына байланысты.
Dialogue: 0,0:10:40.20,0:10:44.33,Default,,0,0,0,,Бұл мекеме қазір Мордиварптың штаб-пәтері қызметін атқарады.
Dialogue: 0,0:10:44.90,0:10:46.00,Default,,0,0,0,,Ал байланыстырушы гель болып табылады
Dialogue: 0,0:10:46.30,0:10:50.13,Default,,0,0,0,,Бұл ғимараттың ең терең бөлігінде қатаң бақылауда.
Dialogue: 0,0:10:50.46,0:10:52.03,Default,,0,0,0,,Бұл жүрек
Dialogue: 0,0:10:52.20,0:10:55.00,Default,,0,0,0,,Жүректен гөрі аналық безге ұқсайтын шығар.
Dialogue: 0,0:10:55.33,0:10:56.13,Default,,0,0,0,,Аналық без?
Dialogue: 0,0:10:56.83,0:10:59.86,Default,,0,0,0,,Жұмыртқа ұрықтанғаннан кейін ол бөліне бастайды.
Dialogue: 0,0:11:00.70,0:11:01.80,Default,,0,0,0,,Сондай-ақ байланыстырушы гель
Dialogue: 0,0:11:02.10,0:11:04.96,Default,,0,0,0,,Қос түрдегі қос импульсті қабылдау арқылы
Dialogue: 0,0:11:05.40,0:11:07.16,Default,,0,0,0,,Оның сипаттамалары шығарылады
Dialogue: 0,0:11:08.50,0:11:12.00,Default,,0,0,0,,Брахмандар линкер гелін де пайдаланды.
Dialogue: 0,0:11:12.43,0:11:15.06,Default,,0,0,0,,ырым сол жерде орындалатынын айтады.
Dialogue: 0,0:11:16.40,0:11:18.26,Default,,0,0,0,,Линкер гелі?
Dialogue: 0,0:11:19.23,0:11:19.73,Default,,0,0,0,,Ішек
Dialogue: 0,0:11:20.50,0:11:21.63,Default,,0,0,0,,Эй, не болды?
Dialogue: 0,0:11:25.70,0:11:27.36,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:11:36.73,0:11:38.73,Default,,0,0,0,,-Хахахахахаха -Сәлем
Dialogue: 0,0:11:38.80,0:11:40.93,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:11:42.36,0:11:43.36,Default,,0,0,0,,Қайтару
Dialogue: 0,0:11:43.63,0:11:44.26,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:11:48.53,0:11:51.73,Default,,0,0,0,,Грианоидтың төмен түсу мүмкіндігін пайдаланыңыз.
Dialogue: 0,0:11:51.83,0:11:52.36,Default,,0,0,0,,Иә
Dialogue: 0,0:12:07.30,0:12:07.96,Default,,0,0,0,,Уау
Dialogue: 0,0:12:08.23,0:12:09.73,Default,,0,0,0,,Гиогиогё
Dialogue: 0,0:12:10.13,0:12:11.96,Default,,0,0,0,,тунец басына толы
Dialogue: 0,0:12:12.23,0:12:13.13,Default,,0,0,0,,Ол келеді.
Dialogue: 0,0:12:13.83,0:12:16.23,Default,,0,0,0,,Бізге бір нәрсе жақындап келеді.
Dialogue: 0,0:12:17.60,0:12:18.46,Default,,0,0,0,,Брахман?
Dialogue: 0,0:12:18.90,0:12:21.40,Default,,0,0,0,,Жоқ. Бұл сәйкестендіру сигналы
Dialogue: 0,0:12:23.26,0:12:24.10,Default,,0,0,0,,Гүл
Dialogue: 0,0:12:30.46,0:12:31.56,Default,,0,0,0,,Мен ауырдым
Dialogue: 0,0:12:32.06,0:12:35.93,Default,,0,0,0,,Қос тайпа ғана емес, Гүлдер де белсенді бола алады.
Dialogue: 0,0:12:37.33,0:12:40.33,Default,,0,0,0,,Бұл бұрынғы жауынгерлік нейроноид.
Dialogue: 0,0:12:40.76,0:12:42.30,Default,,0,0,0,,Ал саны 12
Dialogue: 0,0:12:42.96,0:12:45.50,Default,,0,0,0,,Тактикалық дайындығы бар қос тайпа
Dialogue: 0,0:12:46.06,0:12:48.33,Default,,0,0,0,,Бір-бірлеріңмен дұрыс төбелессеңдер, жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:12:52.06,0:12:53.96,Default,,0,0,0,,Барған сайын қоршап бара жатқан сияқтымын.
Dialogue: 0,0:12:55.43,0:12:57.43,Default,,0,0,0,,Егер сіз бұл ғимаратты денемен салыстырсаңыз
Dialogue: 0,0:12:58.50,0:13:01.40,Default,,0,0,0,,Біз оған вирус сияқты кірдік.
Dialogue: 0,0:13:02.03,0:13:05.86,Default,,0,0,0,,Және олар вирустарға шабуыл жасайтын иммундық антиденелер
Dialogue: 0,0:13:06.56,0:13:09.03,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:13:10.06,0:13:12.66,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:13:13.20,0:13:13.93,Default,,0,0,0,,Сакора-чан
Dialogue: 0,0:13:14.60,0:13:16.50,Default,,0,0,0,,Себебі маниджи машинасы жоқ
Dialogue: 0,0:13:17.13,0:13:19.73,Default,,0,0,0,,Лимипидті арналар шамадан тыс әрекет етеді.
Dialogue: 0,0:13:25.83,0:13:28.00,Default,,0,0,0,,Кетан, жоқ, тоқта.
Dialogue: 0,0:13:28.33,0:13:30.53,Default,,0,0,0,,Басқару мүмкін емес
Dialogue: 0,0:13:32.56,0:13:34.30,Default,,0,0,0,,Уау
Dialogue: 0,0:13:36.70,0:13:37.83,Default,,0,0,0,,Төтенше жағдайдағы бақылау
Dialogue: 0,0:13:41.96,0:13:43.56,Default,,0,0,0,,Фуу
Dialogue: 0,0:13:50.80,0:13:52.26,Default,,0,0,0,,Кел, көтерілейік
Dialogue: 0,0:13:53.80,0:13:54.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:59.30,0:14:00.06,Default,,0,0,0,,Иә
Dialogue: 0,0:14:00.73,0:14:02.06,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:02.23,0:14:03.66,Default,,0,0,0,,О, жоқ, ой
Dialogue: 0,0:14:06.23,0:14:08.76,Default,,0,0,0,,Кей Чан, мен күтіп тұрмын.
Dialogue: 0,0:14:09.73,0:14:12.26,Default,,0,0,0,,Кечан келе береді
Dialogue: 0,0:14:20.23,0:14:22.10,Default,,0,0,0,,Оянған адам кетті
Dialogue: 0,0:14:22.80,0:14:24.73,Default,,0,0,0,,Мұнда басынан бастап жету стратегиясы
Dialogue: 0,0:14:25.30,0:14:27.26,Default,,0,0,0,,Арт жақтан көбірек келе жатыр
Dialogue: 0,0:14:34.23,0:14:34.83,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:14:41.60,0:14:43.80,Default,,0,0,0,,Қарғыс атқыр, алды-арты да жақсы емес.
Dialogue: 0,0:14:44.20,0:14:47.50,Default,,0,0,0,,Шо: Төмендегі еденде өткел бар сияқты.
Dialogue: 0,0:14:48.00,0:14:49.26,Default,,0,0,0,,Үзіліс синтезі
Dialogue: 0,0:14:51.73,0:14:53.63,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:15:01.70,0:15:03.30,Default,,0,0,0,,Глианоид шығысы OK
Dialogue: 0,0:15:11.66,0:15:14.03,Default,,0,0,0,,Жоқ, мен сені әлі күтіп жүрмін
Dialogue: 0,0:15:14.33,0:15:14.83,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:15:26.26,0:15:28.16,Default,,0,0,0,,Толық қоршалған?
Dialogue: 0,0:15:28.56,0:15:30.96,Default,,0,0,0,,Қашу жолы жоқ
Dialogue: 0,0:15:41.66,0:15:44.73,Default,,0,0,0,,Қорғамасаң ана боласың.
Dialogue: 0,0:15:46.10,0:15:48.76,Default,,0,0,0,,Жұмыртқаға жете алмайтын сперматозоид
Dialogue: 0,0:15:49.46,0:15:51.53,Default,,0,0,0,,Жаңа ғана өліп жатырмын
Dialogue: 0,0:15:54.90,0:15:56.30,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:16:21.56,0:16:25.33,Default,,0,0,0,,Мұндағы химиялық заттардың көпшілігі сіңірілген сияқты.
Dialogue: 0,0:16:26.03,0:16:27.00,Default,,0,0,0,,TM бронь
Dialogue: 0,0:16:27.76,0:16:31.83,Default,,0,0,0,,Зиянды химиялық заттар ТМ жүйесі арқылы жұтып, ыдырайды
Dialogue: 0,0:16:32.33,0:16:34.30,Default,,0,0,0,,Мен оның аяқталғанын білмедім.
Dialogue: 0,0:16:35.53,0:16:38.60,Default,,0,0,0,,Бұл оны синаптикалық оқтармен жеңе алмайтыныңызды білдіре ме?
Dialogue: 0,0:16:42.63,0:16:43.30,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:16:45.06,0:16:46.40,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:17:12.33,0:17:13.53,Default,,0,0,0,,9 дене қалды
Dialogue: 0,0:17:19.56,0:17:22.66,Default,,0,0,0,,Әуе шабуылының басталуына бір сағаттан аз уақыт қалды.
Dialogue: 0,0:17:23.66,0:17:25.90,Default,,0,0,0,,Оған нүкте қоятын кез келді.
Dialogue: 0,0:17:33.33,0:17:33.80,Default,,0,0,0,,Уф
Dialogue: 0,0:17:37.23,0:17:39.76,Default,,0,0,0,,Қос синапсты бомбалау
Dialogue: 0,0:17:51.10,0:17:51.76,Default,,0,0,0,,Асами-сан
Dialogue: 0,0:17:52.23,0:17:53.26,Default,,0,0,0,,Толық шығу
Dialogue: 0,0:18:06.40,0:18:06.86,Default,,0,0,0,,Құт
Dialogue: 0,0:18:12.13,0:18:13.10,Default,,0,0,0,,Ооо
Dialogue: 0,0:18:15.36,0:18:16.73,Default,,0,0,0,,Бөлменің басқару элементтеріне қол жеткізу
Dialogue: 0,0:18:18.13,0:18:20.76,Default,,0,0,0,,Су қысымының деңгейін арттыру үшін гүлді оқшаулаңыз
Dialogue: 0,0:18:23.03,0:18:24.43,Default,,0,0,0,,Уау
Dialogue: 0,0:18:27.33,0:18:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.03,0:18:38.73,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:18:45.20,0:18:46.73,Default,,0,0,0,,Маған сенетініне сенімді емеспін.
Dialogue: 0,0:18:47.33,0:18:47.90,Default,,0,0,0,,Шо
Dialogue: 0,0:18:48.40,0:18:48.93,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:18:49.20,0:18:49.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.13,0:18:55.06,Default,,0,0,0,,Уау
Dialogue: 0,0:18:55.56,0:18:56.30,Default,,0,0,0,,Асами-сан
Dialogue: 0,0:19:03.63,0:19:05.10,Default,,0,0,0,,Әлі де біразы қалды.
Dialogue: 0,0:19:09.43,0:19:11.20,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:19:25.10,0:19:25.86,Default,,0,0,0,,Модель! Модель! Менің не болып жатқанын түсіндірші!
Dialogue: 0,0:19:28.26,0:19:29.73,Default,,0,0,0,,Тіпті TM броньымен де
Dialogue: 0,0:19:29.90,0:19:31.46,Default,,0,0,0,,Су астындағы ортада
Dialogue: 0,0:19:32.53,0:19:36.00,Default,,0,0,0,,Синаптикалық оқтар манипуляциялық қорапқа тікелей атылады.
Dialogue: 0,0:19:36.83,0:19:38.40,Default,,0,0,0,,Бұған тосқауыл қоюдың жолы болмаған сияқты.
Dialogue: 0,0:19:39.93,0:19:41.83,Default,,0,0,0,,Алджернон шабуыл жасағанымен
Dialogue: 0,0:19:42.33,0:19:45.13,Default,,0,0,0,,Қос тайпа да бастапқыда Мордиварптың мүшесі болған.
Dialogue: 0,0:19:46.10,0:19:48.70,Default,,0,0,0,,Сығылған күйде Гүлге отырғызу
Dialogue: 0,0:19:51.66,0:19:52.53,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:19:53.60,0:19:57.30,Default,,0,0,0,,Біз Асами-санның глианоидтарын тауып, оянған адамдарды құтқаруымыз керек.
Dialogue: 0,0:19:57.83,0:19:59.00,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:19:59.90,0:20:01.20,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:20:02.00,0:20:02.53,Default,,0,0,0,,Каэде
Dialogue: 0,0:20:03.23,0:20:05.16,Default,,0,0,0,,Ухухуфуахахах
Dialogue: 0,0:20:05.73,0:20:07.66,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:20:08.00,0:20:09.56,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:20:09.63,0:20:10.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:11.90,0:20:16.20,Default,,0,0,0,,Күлді Күлді үшін күледі
Dialogue: 0,0:20:17.00,0:20:18.86,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:20:19.03,0:20:20.40,Default,,0,0,0,,Каэде, не болды?
Dialogue: 0,0:20:21.06,0:20:22.66,Default,,0,0,0,,Тс. Олардың қаншасы бар?
Dialogue: 0,0:20:23.16,0:20:25.36,Default,,0,0,0,,Ахахахахахахаха
Dialogue: 0,0:20:26.43,0:20:28.00,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:20:28.33,0:20:29.60,Default,,0,0,0,,Тоқташы Каэде
Dialogue: 0,0:20:32.60,0:20:36.46,Default,,0,0,0,,Неліктен? ТМ жүйесі тоқтамайды
Dialogue: 0,0:20:39.33,0:20:42.56,Default,,0,0,0,,Түсіндім, Каеданың баласы
Dialogue: 0,0:20:43.03,0:20:44.76,Default,,0,0,0,,Ол қос импульс шығарады ма?
Dialogue: 0,0:20:46.40,0:20:46.93,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:21:00.30,0:21:01.13,Default,,0,0,0,,Уф
Dialogue: 0,0:21:03.80,0:21:05.40,Default,,0,0,0,,Каэде Жарайды.
Dialogue: 0,0:21:06.00,0:21:08.63,Default,,0,0,0,,Сізге Алджернон әсер еткен жоқ.
Dialogue: 0,0:21:09.56,0:21:10.33,Default,,0,0,0,,Түсінесің бе?
Dialogue: 0,0:21:11.50,0:21:17.63,Default,,0,0,0,,Каэденің екі баласы дүниеге келеді.
Dialogue: 0,0:21:18.63,0:21:21.43,Default,,0,0,0,,Құдай соншалықты қатыгез бола алмайды.
Dialogue: 0,0:21:22.90,0:21:23.73,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:21:28.36,0:21:30.83,Default,,0,0,0,,Енді менің көзіме қара
Dialogue: 0,0:21:32.10,0:21:35.63,Default,,0,0,0,,Мен Кейді еліктеу қабілетіммен сендіремін.
Dialogue: 0,0:21:36.53,0:21:37.13,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:42.96,0:21:43.66,Default,,0,0,0,,Шо
Dialogue: 0,0:21:44.23,0:21:44.86,Default,,0,0,0,,Каэде
Dialogue: 0,0:21:46.33,0:21:46.90,Default,,0,0,0,,Шо
Dialogue: 0,0:21:47.93,0:21:48.50,Default,,0,0,0,,Каэде
Dialogue: 0,0:21:49.10,0:21:49.66,Default,,0,0,0,,Шо
Dialogue: 0,0:21:52.80,0:21:55.73,Default,,0,0,0,,Үшеуміз әрқашан бірге боламыз.
Dialogue: 0,0:21:56.66,0:21:59.66,Default,,0,0,0,,Шо: Сәби де сенің жаныңда.
Dialogue: 0,0:22:07.50,0:22:08.93,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:22:09.43,0:22:09.90,Default,,0,0,0,,На
Dialogue: 0,0:22:35.23,0:22:47.90,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:48.56,0:22:54.70,Default,,0,0,0,,Жалынды құшақтап алу
Dialogue: 0,0:22:55.16,0:23:02.20,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.50,0:23:05.76,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:06.06,0:23:09.30,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.46,0:23:12.73,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.96,0:23:16.20,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:18.06,0:23:27.73,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:28.20,0:23:37.93,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.53,0:23:49.60,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.26,0:24:03.23,Default,,0,0,0,,Біреу Кибоға жетеді
Dialogue: 0,0:24:03.63,0:24:07.53,Default,,0,0,0,,Мидан тыс көрінетін заттар
Dialogue: 0,0:24:08.16,0:24:10.50,Default,,0,0,0,,Кінәлінің қайнар көзі
Dialogue: 0,0:24:11.76,0:24:15.50,Default,,0,0,0,,Оны ешкім тоқтата алмайды
Dialogue: 0,0:24:16.50,0:24:20.03,Default,,0,0,0,,Бұл да Кибуды қорғай алмайды.
Dialogue: 0,0:24:21.36,0:24:23.43,Default,,0,0,0,,Сізде де ми бар
Dialogue: 0,0:24:24.26,0:24:25.93,Default,,0,0,0,,Күле бастаңыз
Dialogue: 0,0:24:27.43,0:24:33.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
