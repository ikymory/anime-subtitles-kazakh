Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.50,0:00:12.13,Default,,0,0,0,,Міне!
Dialogue: 0,0:00:22.93,0:00:24.80,Default,,0,0,0,,Гаригаригаригари
Dialogue: 0,0:00:25.30,0:00:28.03,Default,,0,0,0,,Ах аааааааааааааааааааааааа
Dialogue: 0,0:00:36.00,0:00:37.06,Default,,0,0,0,,Уау
Dialogue: 0,0:00:40.43,0:00:44.43,Default,,0,0,0,,Нуааах
Dialogue: 0,0:00:44.73,0:00:49.66,Default,,0,0,0,,Ах аа
Dialogue: 0,0:00:52.06,0:00:57.70,Default,,0,0,0,,Ах— Ах—
Dialogue: 0,0:00:59.30,0:01:05.46,Default,,0,0,0,,Ахх
Dialogue: 0,0:01:05.56,0:01:08.16,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:01:14.20,0:01:14.63,Default,,0,0,0,,Га
Dialogue: 0,0:01:14.76,0:01:15.30,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:01:15.36,0:01:15.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:15.93,0:01:16.43,Default,,0,0,0,,Га
Dialogue: 0,0:01:16.63,0:01:21.30,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:01:23.70,0:01:33.00,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:35.73,0:01:43.73,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:01:45.56,0:01:54.20,Default,,0,0,0,,Аты белгісіз адамдар
Dialogue: 0,0:01:57.46,0:02:05.13,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:02:08.60,0:02:17.40,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:02:17.86,0:02:25.83,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:02:27.76,0:02:37.23,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:37.53,0:02:49.53,Default,,0,0,0,,Ағып жатқанда қозғалмаңыз...
Dialogue: 0,0:02:54.56,0:02:58.33,Default,,0,0,0,,Чика-чан таң қалды
Dialogue: 0,0:03:00.56,0:03:04.13,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
Dialogue: 0,0:03:04.36,0:03:08.63,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:03:08.90,0:03:11.30,Default,,0,0,0,,Үлкен Чика-чаннан кейін құбыжық келе ме?
Dialogue: 0,0:03:11.73,0:03:14.20,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:03:15.30,0:03:17.66,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:03:18.23,0:03:19.03,Default,,0,0,0,,Гах!
Dialogue: 0,0:03:20.70,0:03:22.03,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:03:23.30,0:03:26.26,Default,,0,0,0,,Хахахахахахаха
Dialogue: 0,0:03:33.80,0:03:34.46,Default,,0,0,0,,Төбе
Dialogue: 0,0:03:36.96,0:03:38.46,Default,,0,0,0,,Дио…
Dialogue: 0,0:03:42.53,0:03:43.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:43.33,0:03:45.03,Default,,0,0,0,,Байланыс тізбегі үзілген
Dialogue: 0,0:03:45.43,0:03:46.93,Default,,0,0,0,,Сыртқы мониторды тасымалдау мүмкін емес
Dialogue: 0,0:03:47.43,0:03:49.63,Default,,0,0,0,,Оянған адамдардың жағдайын мүлде түсінбеймін.
Dialogue: 0,0:03:49.93,0:03:53.10,Default,,0,0,0,,Куууу Сакора Сіз бірдеңе білесіз бе?
Dialogue: 0,0:03:55.40,0:03:58.13,Default,,0,0,0,,Даусыңды естимін
Dialogue: 0,0:04:00.03,0:04:01.93,Default,,0,0,0,,Барлығы төменгі қабатқа түседі.
Dialogue: 0,0:04:02.30,0:04:05.80,Default,,0,0,0,,Оянғандарды жинауға еш қарсылығыңыз болмайтынына сенімдімін, апа.
Dialogue: 0,0:04:06.83,0:04:09.16,Default,,0,0,0,,Бірақ Алджернон әлі де қауіпті.
Dialogue: 0,0:04:09.23,0:04:13.33,Default,,0,0,0,,Жиіііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііі iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii!
Dialogue: 0,0:04:13.63,0:04:15.66,Default,,0,0,0,,Барлығы, Барьер-кунды ұмытпа!
Dialogue: 0,0:04:23.80,0:04:26.86,Default,,0,0,0,,Хиноки Хиноки
Dialogue: 0,0:04:27.13,0:04:27.60,Default,,0,0,0,,Не?
Dialogue: 0,0:04:28.00,0:04:31.90,Default,,0,0,0,,Біраз уақыт өтті, бірақ ауа жақсы ма екен?
Dialogue: 0,0:04:32.43,0:04:33.06,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:04:33.93,0:04:36.30,Default,,0,0,0,,Дүниенің түбіндегі біртүрлі аттракциондар
Dialogue: 0,0:04:37.10,0:04:42.03,Default,,0,0,0,,Үлкен Чика-чан мен адамнан шыққан құбыжық?
Dialogue: 0,0:04:43.43,0:04:45.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:50.66,0:04:51.93,Default,,0,0,0,,Гао
Dialogue: 0,0:04:52.00,0:04:52.70,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:04:53.16,0:04:57.96,Default,,0,0,0,,Осы No1 оянған адамға қалай қарасаңыз да, ол жұмыс істейтін қару емес сияқты.
Dialogue: 0,0:04:58.33,0:05:01.46,Default,,0,0,0,,Мен дауыстық командаларды және ойды басқару жүйелерін де қолданамын.
Dialogue: 0,0:05:01.66,0:05:03.40,Default,,0,0,0,,Қандай керемет робот.
Dialogue: 0,0:05:04.13,0:05:04.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:05.80,0:05:07.73,Default,,0,0,0,,Бұл мемлекеттік құпия ма?
Dialogue: 0,0:05:08.46,0:05:12.40,Default,,0,0,0,,Мен шынымен түсінбеймін, өйткені мен ақымақпын
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Сен ақымақсың, Хиноки.
Dialogue: 0,0:05:16.13,0:05:19.16,Default,,0,0,0,,Құдай-ау, ақымақтықты бірден айтпа.
Dialogue: 0,0:05:19.30,0:05:22.20,Default,,0,0,0,,Ахахаха хахаха
Dialogue: 0,0:05:24.40,0:05:26.80,Default,,0,0,0,,Хиноки естеріңізде ме?
Dialogue: 0,0:05:27.30,0:05:29.63,Default,,0,0,0,,Бақаларды жақсы көрсең де, қолыңды тигізбес едің.
Dialogue: 0,0:05:30.23,0:05:32.90,Default,,0,0,0,,Сондықтан мен бірдеңемен мақтанғым келді.
Dialogue: 0,0:05:33.66,0:05:36.26,Default,,0,0,0,,Ол өзімен жиі бақа алып жүретін.
Dialogue: 0,0:05:38.93,0:05:40.96,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:05:41.26,0:05:43.23,Default,,0,0,0,,10 жылдан астам уақыт өтті.
Dialogue: 0,0:05:44.00,0:05:47.93,Default,,0,0,0,,Ол кезде менің қолым үнемі тайғақ болатын.
Dialogue: 0,0:05:50.33,0:05:51.00,Default,,0,0,0,,О
Dialogue: 0,0:05:51.80,0:05:54.30,Default,,0,0,0,,Slimy Uff?
Dialogue: 0,0:05:58.93,0:06:00.46,Default,,0,0,0,,Сізді қайтадан көргеніме қуаныштымын.
Dialogue: 0,0:06:00.76,0:06:01.83,Default,,0,0,0,,-Хаа -Жарайды.
Dialogue: 0,0:06:02.06,0:06:03.53,Default,,0,0,0,,Техникалық қызмет көрсетуші тасымалдаушыны жіберіңіз
Dialogue: 0,0:06:08.70,0:06:11.33,Default,,0,0,0,,Президент, сіздің жарақаттарыңыз тайыз сияқты.
Dialogue: 0,0:06:11.83,0:06:12.86,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:06:13.23,0:06:17.13,Default,,0,0,0,,Мен осындай нәрсе үшін банкрот боламын. Perfect Wear атауы жойылады.
Dialogue: 0,0:06:18.43,0:06:20.20,Default,,0,0,0,,Мордиварптың әпкесі не болды?
Dialogue: 0,0:06:20.86,0:06:22.73,Default,,0,0,0,,Артқы жағына бармадың ба?
Dialogue: 0,0:06:23.20,0:06:24.66,Default,,0,0,0,,Шлагбаумды киіңіз.
Dialogue: 0,0:06:24.76,0:06:25.56,Default,,0,0,0,,-Мм -Мен өлемін
Dialogue: 0,0:06:25.90,0:06:28.70,Default,,0,0,0,,Нууууу ой апа
Dialogue: 0,0:06:29.36,0:06:31.16,Default,,0,0,0,,Кактус сонда болды ма? Уф
Dialogue: 0,0:06:35.26,0:06:36.60,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:06:37.03,0:06:38.80,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:06:39.53,0:06:41.93,Default,,0,0,0,,Ху, шамамен 5-6 метр.
Dialogue: 0,0:06:42.50,0:06:45.33,Default,,0,0,0,,Чика-чан бұдан 5 еседей үлкен болды.
Dialogue: 0,0:06:46.00,0:06:47.70,Default,,0,0,0,,Сен қайда тығылып жүрсің?
Dialogue: 0,0:06:48.86,0:06:50.53,Default,,0,0,0,,Иә? Ой
Dialogue: 0,0:06:50.96,0:06:51.60,Default,,0,0,0,,Иә
Dialogue: 0,0:06:56.83,0:06:57.40,Default,,0,0,0,,Ой
Dialogue: 0,0:06:58.00,0:06:58.50,Default,,0,0,0,,Уф
Dialogue: 0,0:07:01.66,0:07:03.20,Default,,0,0,0,,Уау уау
Dialogue: 0,0:07:07.40,0:07:10.30,Default,,0,0,0,,Кехо Кехо Кехо
Dialogue: 0,0:07:10.43,0:07:11.46,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:07:11.80,0:07:15.46,Default,,0,0,0,,Мордиварптың мақтаншақ тұмар костюмі пайдасыз болды.
Dialogue: 0,0:07:16.66,0:07:18.26,Default,,0,0,0,,Иә, күткендей.
Dialogue: 0,0:07:25.03,0:07:26.16,Default,,0,0,0,,тасталған
Dialogue: 0,0:07:32.90,0:07:34.23,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:07:34.80,0:07:36.16,Default,,0,0,0,,Кактусқа дейін
Dialogue: 0,0:07:38.43,0:07:40.90,Default,,0,0,0,,Янаги-кун және басқалары әлі оралған жоқ.
Dialogue: 0,0:07:41.40,0:07:46.13,Default,,0,0,0,,Жағдайға байланысты мен ол баланы алмастыратын бас сүңгуір ретінде қарастырғым келеді.
Dialogue: 0,0:07:46.63,0:07:47.83,Default,,0,0,0,,Толықтыру
Dialogue: 0,0:07:48.06,0:07:51.53,Default,,0,0,0,,Бас сүңгуір өлгенше, болды.
Dialogue: 0,0:07:52.80,0:07:53.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:54.50,0:07:55.46,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:07:56.53,0:08:00.60,Default,,0,0,0,,Құрбандардың көп болғаны сонша, бұл түсініксіз болды.
Dialogue: 0,0:08:01.56,0:08:04.36,Default,,0,0,0,,Әйтеуір, мен ол баланы өз компаниясыма апарамын.
Dialogue: 0,0:08:04.86,0:08:05.60,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:06.76,0:08:08.53,Default,,0,0,0,,Мен де кейінірек барамын.
Dialogue: 0,0:08:09.80,0:08:13.00,Default,,0,0,0,,Ой, аа, аа, ой, күт!
Dialogue: 0,0:08:13.36,0:08:14.93,Default,,0,0,0,,Мені артымда қалдырмаңыз!
Dialogue: 0,0:08:18.86,0:08:21.30,Default,,0,0,0,,Ал, хаха, сені тағы көргеніме қуаныштымын.
Dialogue: 0,0:08:21.86,0:08:25.46,Default,,0,0,0,,Мен Кейта Аоакимін, мен Хинокидің бала кезден досымын.
Dialogue: 0,0:08:25.96,0:08:29.20,Default,,0,0,0,,Сіз үнемі сонда отырасыз ба?
Dialogue: 0,0:08:31.16,0:08:33.30,Default,,0,0,0,,Өйткені Сакора қарапайым адамдардан ерекше.
Dialogue: 0,0:08:34.43,0:08:35.56,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:08:35.83,0:08:36.26,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:36.46,0:08:38.06,Default,,0,0,0,,Мен әлі жақын жердемін
Dialogue: 0,0:08:38.70,0:08:39.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:41.16,0:08:41.83,Default,,0,0,0,,Не?
Dialogue: 0,0:08:42.56,0:08:46.36,Default,,0,0,0,,Иә, полиция мұны қарапайым жазатайым оқиға ретінде қабылдады.
Dialogue: 0,0:08:47.30,0:08:48.66,Default,,0,0,0,,Аттракциондар бақылаудан шығады
Dialogue: 0,0:08:48.83,0:08:52.13,Default,,0,0,0,,Бұл кешенді басқару бағдарламасын қайта құруға байланысты деп болжануда.
Dialogue: 0,0:08:53.06,0:08:58.30,Default,,0,0,0,,Тірі қалғандардың айғақтары бойынша, жәбірленушілердің 90%-ы бір-біріне қарсы кісі өлтіру және жарақаттау әрекеттерін жасаған.
Dialogue: 0,0:08:59.70,0:09:01.96,Default,,0,0,0,,Тікелей тарту арқылы өлтірілді
Dialogue: 0,0:09:02.30,0:09:04.00,Default,,0,0,0,,Тек бірнеше адам, соның ішінде Кактус
Dialogue: 0,0:09:04.93,0:09:09.40,Default,,0,0,0,,Қалай болғанда да, одан әрі зақымдануы екіталай.
Dialogue: 0,0:09:10.10,0:09:10.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.66,0:09:16.13,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:19.00,0:09:20.60,Default,,0,0,0,,Мен профессормен кездесейін деп жатырмын.
Dialogue: 0,0:09:26.30,0:09:29.13,Default,,0,0,0,,Akamatsu Industries компаниясына қош келдіңіз
Dialogue: 0,0:09:29.70,0:09:34.00,Default,,0,0,0,,Уау! Никотин лотының №28 жаңа өнімі
Dialogue: 0,0:09:34.96,0:09:36.90,Default,,0,0,0,,Hopping Bucket Shoe MK-II шектеулі нұсқасы
Dialogue: 0,0:09:37.80,0:09:39.86,Default,,0,0,0,,Бұл қылмыстық ұйымның баспанасы іспетті.
Dialogue: 0,0:09:39.90,0:09:41.30,Default,,0,0,0,,Нахахахаха
Dialogue: 0,0:09:41.66,0:09:43.80,Default,,0,0,0,,Далаптан локомотивтерге дейін.
Dialogue: 0,0:09:44.13,0:09:47.66,Default,,0,0,0,,Біздің компанияның көлемі шағын болғанымен, біздің технологиялық мүмкіндіктеріміз Жапониядағы ең үздік болып табылады.
Dialogue: 0,0:09:48.40,0:09:50.66,Default,,0,0,0,,Роботтарды әзірлеу, фарт каппа.
Dialogue: 0,0:09:50.80,0:09:54.46,Default,,0,0,0,,Бірақ №1 оянған адам қалай жұмыс істейді?
Dialogue: 0,0:09:55.40,0:09:58.20,Default,,0,0,0,,А? Бұл негізгі сұрақ
Dialogue: 0,0:09:58.36,0:10:00.60,Default,,0,0,0,,Бұл коммерциялық құпия, бірақ бұл жақсы.
Dialogue: 0,0:10:01.10,0:10:02.60,Default,,0,0,0,,Риччан, маған айтыңызшы.
Dialogue: 0,0:10:02.80,0:10:04.86,Default,,0,0,0,,Иә, мен?
Dialogue: 0,0:10:04.96,0:10:06.20,Default,,0,0,0,,Мен бос емеспін
Dialogue: 0,0:10:06.73,0:10:08.13,Default,,0,0,0,,Сіз Шизукудың жерлеуіне келмедіңіз бе?
Dialogue: 0,0:10:08.33,0:10:10.73,Default,,0,0,0,,Ха ха ха ха рахмет
Dialogue: 0,0:10:11.36,0:10:12.53,Default,,0,0,0,,Уф
Dialogue: 0,0:10:13.93,0:10:19.56,Default,,0,0,0,,№1 Оянған адам, бұл шын мәнінде нейроноид деп аталатын сияқты.
Dialogue: 0,0:10:21.26,0:10:24.56,Default,,0,0,0,,Бастапқыда адамға зиянды орта.
Dialogue: 0,0:10:24.80,0:10:28.93,Default,,0,0,0,,Бұл қауіпті жерлерді зерттеп, талдайтын көлік.
Dialogue: 0,0:10:29.03,0:10:29.66,Default,,0,0,0,,т.б.
Dialogue: 0,0:10:30.16,0:10:35.13,Default,,0,0,0,,Адамдағы қанға ұқсас линкер гелі деп аталатын зат бүкіл денеге таралады.
Dialogue: 0,0:10:35.40,0:10:40.20,Default,,0,0,0,,Бұл шабандоздың бүкіл денеге таралатын ми импульстары.
Dialogue: 0,0:10:40.33,0:10:40.96,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:10:41.36,0:10:43.56,Default,,0,0,0,,Атмосферадан қажетті заттарды алу
Dialogue: 0,0:10:43.76,0:10:46.73,Default,,0,0,0,,Синтездейтін ТМ жүйесі де осылай жұмыс істейді.
Dialogue: 0,0:10:46.86,0:10:48.26,Default,,0,0,0,,ТМ жүйесі?
Dialogue: 0,0:10:48.70,0:10:53.40,Default,,0,0,0,,Сіз бастан кешірген синаптикалық бомбалау - синтезделген химиялық заттардың кенеттен бөлінуі.
Dialogue: 0,0:10:54.06,0:10:55.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:57.13,0:10:59.43,Default,,0,0,0,,Гельді шамадан тыс қолданғанда қоспалар жиналады.
Dialogue: 0,0:10:59.46,0:11:02.86,Default,,0,0,0,,Кейде оянған адам мұндай диализсіз қозғала алмайды.
Dialogue: 0,0:11:03.30,0:11:04.70,Default,,0,0,0,,Қайта өңдеу керек пе?
Dialogue: 0,0:11:05.46,0:11:07.83,Default,,0,0,0,,Күрсін, Akamatsu Industries керемет.
Dialogue: 0,0:11:08.40,0:11:12.16,Default,,0,0,0,,Бірақ орталық блок Мордиварптан алынған.
Dialogue: 0,0:11:12.63,0:11:13.93,Default,,0,0,0,,Мордиварп?
Dialogue: 0,0:11:14.83,0:11:18.60,Default,,0,0,0,,Ал сіз оны екі жақты болмаса, жылжыта алмайсыз.
Dialogue: 0,0:11:19.23,0:11:19.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:20.10,0:11:22.40,Default,,0,0,0,,Жақсы, ол жұмыс істеді.
Dialogue: 0,0:11:22.50,0:11:22.96,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:23.30,0:11:24.50,Default,,0,0,0,,Деректерді тіркеуші
Dialogue: 0,0:11:24.73,0:11:26.93,Default,,0,0,0,,Келіңіздер, барлығын жазу керек.
Dialogue: 0,0:11:27.83,0:11:30.90,Default,,0,0,0,,Әлгі жігіт Чика-чанмен соғысып жатқан Беттерманға телефон соқты.
Dialogue: 0,0:11:31.43,0:11:32.20,Default,,0,0,0,,Беттерман
Dialogue: 0,0:11:39.96,0:11:42.40,Default,,0,0,0,,Бауыр жасушалары?
Dialogue: 0,0:11:42.60,0:11:45.70,Default,,0,0,0,,Аа, бұл петрификациядан гөрі фиброзға ұқсайды.
Dialogue: 0,0:11:46.43,0:11:48.73,Default,,0,0,0,,Адамның циррозына ұқсас
Dialogue: 0,0:11:49.80,0:11:50.36,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:51.26,0:11:54.73,Default,,0,0,0,,Әрі қарай талдау біраз уақытты алады.
Dialogue: 0,0:11:55.33,0:11:56.16,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:58.93,0:12:01.70,Default,,0,0,0,,Шынында да, бауыр жасушаларында екі ядро ​​болады.
Dialogue: 0,0:12:02.20,0:12:05.90,Default,,0,0,0,,Генетикалық ақпарат екі есе артады, ал регенерация күші жылдамырақ.
Dialogue: 0,0:12:07.40,0:12:08.30,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:12:09.06,0:12:09.76,Default,,0,0,0,,Цуко-кун
Dialogue: 0,0:12:09.93,0:12:10.40,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:12:10.93,0:12:13.36,Default,,0,0,0,,Сіз әлі зертхана қызметкерісіз.
Dialogue: 0,0:12:13.76,0:12:15.83,Default,,0,0,0,,Сенің мұнда қайтып келу ойың жоқ па?
Dialogue: 0,0:12:22.86,0:12:24.46,Default,,0,0,0,,Орындау керек нәрсені аяқтағаннан кейін
Dialogue: 0,0:12:25.60,0:12:27.36,Default,,0,0,0,,Әзірше айта алатыным осы ғана.
Dialogue: 0,0:12:47.56,0:12:48.46,Default,,0,0,0,,Кактус
Dialogue: 0,0:12:51.73,0:12:53.73,Default,,0,0,0,,Ах аа
Dialogue: 0,0:12:59.26,0:13:00.00,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:02.16,0:13:02.63,Default,,0,0,0,,Га
Dialogue: 0,0:13:06.63,0:13:10.76,Default,,0,0,0,,Ааа аааааааааааааааааааа
Dialogue: 0,0:13:14.33,0:13:15.16,Default,,0,0,0,,Бұл шешуші шайқас!
Dialogue: 0,0:13:16.86,0:13:19.93,Default,,0,0,0,,Хмм, менің DigiRobo өте күшті.
Dialogue: 0,0:13:20.30,0:13:24.46,Default,,0,0,0,,Хехе, модемді Akamatsu Industries жасаған. Жоғалтуға шыдай алмаймыз ба?
Dialogue: 0,0:13:25.16,0:13:27.30,Default,,0,0,0,,Ах, ол шабуылдарды қабылдайды.
Dialogue: 0,0:13:27.70,0:13:29.80,Default,,0,0,0,,Мен бұл қулық туралы ешқашан естіген емеспін.
Dialogue: 0,0:13:29.83,0:13:33.33,Default,,0,0,0,,Няхахаха, сен үлкендердің құдіретін түсіндің бе?
Dialogue: 0,0:13:34.33,0:13:36.80,Default,,0,0,0,,Күтілгендей, бұл MIL стандартына сай өнім.
Dialogue: 0,0:13:37.20,0:13:38.50,Default,,0,0,0,,Бүтін дерлік
Dialogue: 0,0:13:38.83,0:13:41.33,Default,,0,0,0,,Мордиварптың ақшасы бар.
Dialogue: 0,0:13:41.76,0:13:43.13,Default,,0,0,0,,Бір нәрсе орындалатын сияқты.
Dialogue: 0,0:13:43.80,0:13:47.06,Default,,0,0,0,,Бірақ басқа схемалар қорқынышты.
Dialogue: 0,0:13:47.56,0:13:50.86,Default,,0,0,0,,Мен барлық экрандалмаған блоктарды ауыстырамын.
Dialogue: 0,0:13:51.06,0:13:52.26,Default,,0,0,0,,Электромагниттік импульс?
Dialogue: 0,0:13:52.60,0:13:53.33,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:53.83,0:13:57.43,Default,,0,0,0,,Болашақта біз NBC-ге қарсы құрал-жабдықты күшейтуіміз керек.
Dialogue: 0,0:13:57.93,0:13:59.23,Default,,0,0,0,,Бұл қымбат
Dialogue: 0,0:13:59.53,0:14:02.63,Default,,0,0,0,,Ха, бәрібір, есепшот Мордиварпқа түседі.
Dialogue: 0,0:14:02.80,0:14:06.33,Default,,0,0,0,,Сондай-ақ жазғы компания сапарының жол ақысын қосу керек пе?
Dialogue: 0,0:14:06.43,0:14:09.63,Default,,0,0,0,,- -
Dialogue: 0,0:14:10.10,0:14:13.73,Default,,0,0,0,,Ей, эй, эй, чачача, о, үйге ерте кел.
Dialogue: 0,0:14:14.13,0:14:18.16,Default,,0,0,0,,Ой-ой, бұл Көк Балта күн болды.
Dialogue: 0,0:14:19.10,0:14:19.96,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:20.93,0:14:24.36,Default,,0,0,0,,Ах аа хааа аха аха
Dialogue: 0,0:14:25.33,0:14:29.30,Default,,0,0,0,,Менің атым Майо Цуко, мен Мордиварптың инспекциялық бөлімінен жіберілдім.
Dialogue: 0,0:14:29.93,0:14:31.80,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:14:32.50,0:14:34.43,Default,,0,0,0,,Бұл Мордиварп па?
Dialogue: 0,0:14:35.20,0:14:39.33,Default,,0,0,0,,Маған сенің таңғажайып екі жақты қабілеттеріңді көрсеттім.
Dialogue: 0,0:14:39.96,0:14:42.50,Default,,0,0,0,,Қос түр?
Dialogue: 0,0:14:42.66,0:14:44.90,Default,,0,0,0,,-Аа, Кей-чан екі жақты ма? -Ой
Dialogue: 0,0:14:44.93,0:14:45.43,Default,,0,0,0,,Тек
Dialogue: 0,0:14:45.66,0:14:48.03,Default,,0,0,0,,Не болды? Хинокидің беті көк
Dialogue: 0,0:14:48.73,0:14:51.16,Default,,0,0,0,,Мен кактус үшін қобалжыдым.
Dialogue: 0,0:14:51.53,0:14:52.90,Default,,0,0,0,,Түсініп, қолданыңыз
Dialogue: 0,0:14:52.96,0:14:54.40,Default,,0,0,0,,Жерлеу туралы не деуге болады?
Dialogue: 0,0:14:54.66,0:14:56.60,Default,,0,0,0,,Кеңседегі Куми-чан келісім жасап жатыр.
Dialogue: 0,0:14:57.20,0:15:01.06,Default,,0,0,0,,Ум, мен біраз уақыттан бері бір нәрсені түсінбедім.
Dialogue: 0,0:15:01.96,0:15:06.16,Default,,0,0,0,,Ах, Мордиварп немесе қос түр деп аталатын нәрсе.
Dialogue: 0,0:15:06.90,0:15:11.23,Default,,0,0,0,,Адамдар бірге өмір сүрген кезде феромондарды, алыс инфрақызыл сәулелерді және т.б.
Dialogue: 0,0:15:11.56,0:15:15.10,Default,,0,0,0,,Біз әртүрлі сигналдармен алмасып, бір-бірімізге әсер етеміз.
Dialogue: 0,0:15:15.83,0:15:19.73,Default,,0,0,0,,Мысалы, бір хоббиі бар досыңызбен қызу әңгімелесу жақсы емес пе?
Dialogue: 0,0:15:20.20,0:15:21.30,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:15:21.86,0:15:25.86,Default,,0,0,0,,Менімен бір сыныпта оқитын Уссимен бірге болғанымда, біз әскери мәселелер туралы сөйлесіп, қуанатынбыз.
Dialogue: 0,0:15:25.96,0:15:28.10,Default,,0,0,0,,Хехе, сабақ үстінде мені айғайлай береді.
Dialogue: 0,0:15:29.00,0:15:29.90,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:15:30.86,0:15:34.76,Default,,0,0,0,,Қос түр дегеніміз не? Екі адам қосылса, мидағы импульс күшейеді.
Dialogue: 0,0:15:35.20,0:15:37.76,Default,,0,0,0,,Ерекше энергия шығару қабілетінің иесі
Dialogue: 0,0:15:38.23,0:15:43.00,Default,,0,0,0,,Ал Neuronoid Dual Kind қабілетін ондаған мың рет күшейтеді.
Dialogue: 0,0:15:43.30,0:15:45.53,Default,,0,0,0,,Оны қуат көзі ретінде пайдалана отырып жұмыс істейді.
Dialogue: 0,0:15:46.26,0:15:49.10,Default,,0,0,0,,Күшті аналитикалық дағдылары бар тергеуді қабылдау режимі
Dialogue: 0,0:15:49.76,0:15:52.80,Default,,0,0,0,,Жетілдірілген ат күші бар Қозғалыс белсенді режимі
Dialogue: 0,0:15:53.70,0:15:56.13,Default,,0,0,0,,Осы қабілеттердің шығуын қамтамасыз ету
Dialogue: 0,0:15:56.46,0:16:00.80,Default,,0,0,0,,Бортта бас сүңгуір ретінде екі қос түр қажет.
Dialogue: 0,0:16:02.50,0:16:03.06,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:04.23,0:16:09.03,Default,,0,0,0,,Штаб тексеру жүргізгеннен кейін және Көк Балта ресми түрде қос түр ретінде танылады.
Dialogue: 0,0:16:09.73,0:16:12.33,Default,,0,0,0,,Біздің жұмысымызға көмектесуіңізді қалаймыз.
Dialogue: 0,0:16:12.80,0:16:13.93,Default,,0,0,0,,Әлде мен ерекшемін бе?
Dialogue: 0,0:16:14.10,0:16:14.60,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:16:15.30,0:16:18.03,Default,,0,0,0,,Үлкен Чика-чанды жеңесіз бе?
Dialogue: 0,0:16:18.86,0:16:19.70,Default,,0,0,0,,Алджернон
Dialogue: 0,0:16:20.30,0:16:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:22.00,0:16:23.46,Default,,0,0,0,,Бұл оқиғаның көзі
Dialogue: 0,0:16:24.23,0:16:26.83,Default,,0,0,0,,Қазіргі уақытта адамзат алдында тұрған ең үлкен дағдарыс
Dialogue: 0,0:16:26.86,0:16:28.23,Default,,0,0,0,,О, солай.
Dialogue: 0,0:16:29.13,0:16:32.53,Default,,0,0,0,,Біздің білетініміз – адамдар өледі.
Dialogue: 0,0:16:32.90,0:16:33.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.96,0:16:39.10,Default,,0,0,0,,Ұйым Алджернонның шынайы тұлғасын ашу үшін құрылды.
Dialogue: 0,0:16:39.66,0:16:41.03,Default,,0,0,0,,Бұл Мордиварп.
Dialogue: 0,0:16:41.13,0:16:42.10,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:16:42.93,0:16:46.70,Default,,0,0,0,,А, бірақ мен көмектесетін бірдеңе істей аламын ба?
Dialogue: 0,0:16:47.63,0:16:48.13,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:16:48.60,0:16:49.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:49.40,0:16:52.46,Default,,0,0,0,,Жоқ, сен де өлесің.
Dialogue: 0,0:16:52.83,0:16:53.80,Default,,0,0,0,,Хиноки
Dialogue: 0,0:16:54.60,0:16:57.10,Default,,0,0,0,,Осы уақытқа дейін қанша адам қайтыс болды деп ойлайсың?
Dialogue: 0,0:16:57.53,0:16:58.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:58.70,0:17:00.30,Default,,0,0,0,,Ах, Сара
Dialogue: 0,0:17:02.13,0:17:05.50,Default,,0,0,0,,Кейта-санның жақсы болатынына сенімдімін.
Dialogue: 0,0:17:06.40,0:17:08.93,Default,,0,0,0,,Әй, Сара, мен сергек тұрсам болады ма?
Dialogue: 0,0:17:09.46,0:17:09.93,Default,,0,0,0,,Иә
Dialogue: 0,0:17:10.46,0:17:11.53,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:11.73,0:17:12.26,Default,,0,0,0,,Э?
Dialogue: 0,0:17:12.56,0:17:14.03,Default,,0,0,0,,Деректерді ойнатуға болады.
Dialogue: 0,0:17:14.33,0:17:16.30,Default,,0,0,0,,Жарайды, қарайық.
Dialogue: 0,0:17:16.76,0:17:20.73,Default,,0,0,0,,Мордиварп - Алджернонның шынайы болмысының анықтамасы.
Dialogue: 0,0:17:21.30,0:17:23.06,Default,,0,0,0,,Беттерман және осының бәрі.
Dialogue: 0,0:17:27.56,0:17:30.60,Default,,0,0,0,,Мен оны оянған адамның гель шегіне жіберемін.
Dialogue: 0,0:17:30.96,0:17:32.76,Default,,0,0,0,,Қалыпты бояуға түзету
Dialogue: 0,0:17:41.96,0:17:44.30,Default,,0,0,0,,күрсіну
Dialogue: 0,0:17:49.73,0:17:53.40,Default,,0,0,0,,Уааааааа
Dialogue: 0,0:17:53.46,0:17:55.20,Default,,0,0,0,,Хахахахахахахахахахахахаха
Dialogue: 0,0:17:58.53,0:18:00.90,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:18:02.40,0:18:03.13,Default,,0,0,0,,О
Dialogue: 0,0:18:12.03,0:18:13.03,Default,,0,0,0,,О
Dialogue: 0,0:18:20.26,0:18:22.96,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:18:23.03,0:18:24.40,Default,,0,0,0,,Соғыс
Dialogue: 0,0:18:25.26,0:18:29.30,Default,,0,0,0,,Уау
Dialogue: 0,0:18:29.36,0:18:33.16,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:18:35.50,0:18:36.80,Default,,0,0,0,,Дыбыстық толқын?
Dialogue: 0,0:18:37.13,0:18:38.96,Default,,0,0,0,,Бұл микротолқынды пеш сияқты.
Dialogue: 0,0:18:39.56,0:18:42.96,Default,,0,0,0,,Чика-чан, маған қатты әсер етті!
Dialogue: 0,0:18:46.63,0:18:47.20,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:18:47.26,0:18:51.26,Default,,0,0,0,,Біз ультрадыбыстық қысым қабатын жасап, жарықтың сыну көрсеткішін өзгерттік.
Dialogue: 0,0:18:51.60,0:18:54.33,Default,,0,0,0,,Хахахахахахахахахахаха
Dialogue: 0,0:18:54.40,0:18:57.60,Default,,0,0,0,,Айналадағы ылғал ультрадыбыстық тербеліс әсерінен тұманға айнала ма?
Dialogue: 0,0:18:57.80,0:18:59.63,Default,,0,0,0,,Бұл ылғалдандырғыш сияқты.
Dialogue: 0,0:18:59.76,0:19:02.33,Default,,0,0,0,,Хахахахахахахахахаха
Dialogue: 0,0:19:02.36,0:19:05.33,Default,,0,0,0,,Жарқанаттар мен дельфиндерде көрінетін дыбыс толқындары арқылы сезіну
Dialogue: 0,0:19:05.76,0:19:07.96,Default,,0,0,0,,Функция өте дамыған ба?
Dialogue: 0,0:19:10.46,0:19:14.46,Default,,0,0,0,,Оянған адамның жүйесі күйіп кеткеніне сене алмадым.
Dialogue: 0,0:19:14.76,0:19:16.53,Default,,0,0,0,,Ультрадыбыстық және электромагниттік импульстар
Dialogue: 0,0:19:16.93,0:19:19.86,Default,,0,0,0,,Атмосфера мен өрістің жалғыз айырмашылығы - екеуі де тербеліс.
Dialogue: 0,0:19:20.40,0:19:23.23,Default,,0,0,0,,Хахахахахахахахахаха
Dialogue: 0,0:19:29.20,0:19:31.56,Default,,0,0,0,,Хахахахахахахахахаха
Dialogue: 0,0:19:31.66,0:19:33.93,Default,,0,0,0,,Бақаның бетіне бірдеңе.
Dialogue: 0,0:19:34.33,0:19:35.03,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:19:37.30,0:19:39.16,Default,,0,0,0,,Хахахахахахахаха
Dialogue: 0,0:19:41.83,0:19:45.60,Default,,0,0,0,,Егер бұл қабілет эхолокацияның экстремалды дамуы болса.
Dialogue: 0,0:19:47.10,0:19:48.73,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,0:19:52.16,0:19:54.36,Default,,0,0,0,,Гяаа
Dialogue: 0,0:19:54.43,0:19:55.43,Default,,0,0,0,,Психо дауысы
Dialogue: 0,0:19:57.33,0:20:02.43,Default,,0,0,0,,Біздің эрамызға дейінгі 2500 жылы арийлер оны жеу арқылы сома бөлген дейді.
Dialogue: 0,0:20:02.50,0:20:04.63,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,0:20:04.76,0:20:09.63,Default,,0,0,0,,Сықырлау
Dialogue: 0,0:20:32.10,0:20:34.00,Default,,0,0,0,,Даусыңызбен Чика-чанды жойдыңыз ба?
Dialogue: 0,0:20:34.46,0:20:38.80,Default,,0,0,0,,Бұрынғы қамшы шабуылы қарсыластың құрылымын талдауға арналған.
Dialogue: 0,0:20:39.03,0:20:42.13,Default,,0,0,0,,Табиғи дірілге сәйкес ультра жоғары жиілікті шығарыңыз
Dialogue: 0,0:20:42.66,0:20:44.86,Default,,0,0,0,,Бұл материяның күйреуіне әкелді дегенді білдіре ме?
Dialogue: 0,0:20:50.06,0:20:50.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:54.40,0:20:55.03,Default,,0,0,0,,Фиброз
Dialogue: 0,0:20:58.56,0:20:59.43,Default,,0,0,0,,Ламия
Dialogue: 0,0:21:00.30,0:21:00.93,Default,,0,0,0,,Сакура?
Dialogue: 0,0:21:01.30,0:21:03.03,Default,,0,0,0,,Сіз бірдеңе алдыңыз ба?
Dialogue: 0,0:21:03.60,0:21:06.50,Default,,0,0,0,,Біздің үмітімізді тыңда
Dialogue: 0,0:21:07.43,0:21:08.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:08.40,0:21:09.73,Default,,0,0,0,,Сакораның ерекше қабілеті
Dialogue: 0,0:21:10.13,0:21:10.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.10,0:21:12.80,Default,,0,0,0,,Далада бар сана толқындары
Dialogue: 0,0:21:13.33,0:21:17.26,Default,,0,0,0,,Мөлдір арнадан әртүрлі ақпараттар алынады.
Dialogue: 0,0:21:17.46,0:21:18.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.03,0:21:21.50,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:21:27.16,0:21:27.70,Default,,0,0,0,,Га
Dialogue: 0,0:21:32.90,0:21:33.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:34.43,0:21:36.20,Default,,0,0,0,,Ұқсас, бірақ әртүрлі
Dialogue: 0,0:21:36.50,0:21:37.20,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:21:51.10,0:21:54.03,Default,,0,0,0,,Бұл жігіт қалдырылған заттардың арасында болды дейсіз бе?
Dialogue: 0,0:21:54.63,0:21:56.26,Default,,0,0,0,,Иә, мен оны сезінемін.
Dialogue: 0,0:21:56.73,0:22:00.13,Default,,0,0,0,,Мен бұл бұрын-соңды болмаған материал деп ойлап, біраз зерттедім.
Dialogue: 0,0:22:00.83,0:22:02.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:03.16,0:22:07.00,Default,,0,0,0,,Негізінен ол адамның тырнақтары сияқты нәрседен жасалған.
Dialogue: 0,0:22:09.33,0:22:11.90,Default,,0,0,0,,Иә, бірақ тырнақтарға қарағанда.
Dialogue: 0,0:22:12.26,0:22:14.76,Default,,0,0,0,,Бұл қатайған бауыр жасушаларына ұқсас.
Dialogue: 0,0:22:34.90,0:22:47.43,Default,,0,0,0,,Шексіз теломераларға ойылған Құдайдың күнәсі
Dialogue: 0,0:22:48.10,0:22:54.23,Default,,0,0,0,,Жалын құшағында
Dialogue: 0,0:22:54.83,0:23:02.00,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.23,0:23:05.43,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:05.66,0:23:08.90,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.10,0:23:12.33,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.53,0:23:15.86,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.73,0:23:27.43,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:27.80,0:23:37.66,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.23,0:23:49.23,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:24:00.73,0:24:02.20,Default,,0,0,0,,Барма
Dialogue: 0,0:24:02.76,0:24:04.43,Default,,0,0,0,,Сіз қашып кете алмайсыз
Dialogue: 0,0:24:06.16,0:24:08.46,Default,,0,0,0,,Көптеген қуыршақтар
Dialogue: 0,0:24:09.20,0:24:11.83,Default,,0,0,0,,Нашар қуыршақтар
Dialogue: 0,0:24:12.93,0:24:14.73,Default,,0,0,0,,Ауада
Dialogue: 0,0:24:16.26,0:24:17.66,Default,,0,0,0,,Жақындау
Dialogue: 0,0:24:18.76,0:24:20.30,Default,,0,0,0,,үйір
Dialogue: 0,0:24:21.80,0:24:23.76,Default,,0,0,0,,Сіздің ішектеріңіз
Dialogue: 0,0:24:24.53,0:24:26.00,Default,,0,0,0,,Шығару
Dialogue: 0,0:24:27.50,0:24:33.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
