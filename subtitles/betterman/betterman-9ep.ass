Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.03,0:00:13.86,Default,,0,0,0,,Тағы да Беттерман тұмандығы?
Dialogue: 0,0:00:14.40,0:00:14.86,Default,,0,0,0,,Иә
Dialogue: 0,0:00:15.60,0:00:19.86,Default,,0,0,0,,Бұл біздің ауданда бірнеше айдың ішінде төрт рет расталғанын білдіреді.
Dialogue: 0,0:00:21.60,0:00:22.86,Default,,0,0,0,,Әлемнің төменгі жағы
Dialogue: 0,0:00:23.86,0:00:25.33,Default,,0,0,0,,Нансей аралдарының үстінде
Dialogue: 0,0:00:26.70,0:00:28.30,Default,,0,0,0,,Үндістанның Аджанта үңгірлері
Dialogue: 0,0:00:28.83,0:00:31.70,Default,,0,0,0,,Ал бұл жолы Рэнд медициналық орталығы
Dialogue: 0,0:00:32.90,0:00:35.06,Default,,0,0,0,,Бұл жолы Кейтаға және басқаларға көмектесесіз бе?
Dialogue: 0,0:00:35.73,0:00:36.20,Default,,0,0,0,,Иә
Dialogue: 0,0:00:36.83,0:00:38.16,Default,,0,0,0,,Сол балалар мен Беттерман
Dialogue: 0,0:00:38.73,0:00:41.13,Default,,0,0,0,,Мен олардың қандай да бір байланысы бар екеніне сенімдімін.
Dialogue: 0,0:00:43.43,0:00:47.10,Default,,0,0,0,,Маған тұмандықтың кеудесінен шыққан ақ жарық бөлшектері әсер еткен сияқты.
Dialogue: 0,0:00:47.90,0:00:49.40,Default,,0,0,0,,Құтқарылғаннан кейінгі емтиханда
Dialogue: 0,0:00:49.93,0:00:53.00,Default,,0,0,0,,Иммундық функцияның лезде жақсаруының дәлелі байқалды.
Dialogue: 0,0:00:55.16,0:00:58.46,Default,,0,0,0,,Беттерман оларды үнемі бақылап тұратын сияқты.
Dialogue: 0,0:00:59.96,0:01:01.60,Default,,0,0,0,,Үндістандағы Бегемоттың артынан
Dialogue: 0,0:01:02.03,0:01:05.83,Default,,0,0,0,,Арнайы сұйықтық шығаратын саламандр деп аталатын құбыжық.
Dialogue: 0,0:01:07.20,0:01:10.10,Default,,0,0,0,,Сұйықтық тірі заттардың орталық жүйке жүйесін сал етеді.
Dialogue: 0,0:01:10.70,0:01:13.83,Default,,0,0,0,,Құрамында жасуша деңгейіндегі өзгерістерге ықпал ететін көптеген ингредиенттер бар
Dialogue: 0,0:01:15.10,0:01:17.36,Default,,0,0,0,,Ауруларды емдеуде тиімді сияқты.
Dialogue: 0,0:01:17.96,0:01:21.70,Default,,0,0,0,,Аурухана клиникалық экспериментті жасырын жүргізіп жатқан шығар.
Dialogue: 0,0:01:23.56,0:01:25.50,Default,,0,0,0,,Нейроноидтық зерттеулердің көпшілігі
Dialogue: 0,0:01:25.86,0:01:31.20,Default,,0,0,0,,Персонал, соның ішінде директор және оның астындағылар, капсулаға қысылып қалған пациенттер.
Dialogue: 0,0:01:31.40,0:01:36.26,Default,,0,0,0,,Олардың әрқайсысы жоғалып кетті, дәлірек айтсақ, олар буланып кетті.
Dialogue: 0,0:01:37.93,0:01:39.56,Default,,0,0,0,,Шындық әлі қараңғыда
Dialogue: 0,0:01:41.46,0:01:45.30,Default,,0,0,0,,Олар кәріз жүйесіне қосылған бір адамның көлеміндей тесіктен қашып кеткен сияқты.
Dialogue: 0,0:01:46.00,0:01:49.23,Default,,0,0,0,,Олардың 100-ден астам капсуланы қалай шығарғаны жұмбақ.
Dialogue: 0,0:01:50.43,0:01:52.66,Default,,0,0,0,,Иә, дәл сол тесіктің ішінде.
Dialogue: 0,0:01:52.90,0:01:55.43,Default,,0,0,0,,Бұл мен Аджантадағы жер астында көрген үңгірге қатты ұқсайтын.
Dialogue: 0,0:01:57.46,0:01:59.56,Default,,0,0,0,,Алджернонның ізін көрдіңіз бе?
Dialogue: 0,0:02:01.33,0:02:04.60,Default,,0,0,0,,Жоқ, Каэде дозингтік талдау жасады.
Dialogue: 0,0:02:05.03,0:02:06.33,Default,,0,0,0,,Барлық деректер теріс
Dialogue: 0,0:02:06.86,0:02:09.46,Default,,0,0,0,,Әй, Көк Балта біртүрлі нәрсе істеп жатыр.
Dialogue: 0,0:02:10.13,0:02:10.73,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:02:11.90,0:02:15.03,Default,,0,0,0,,Мен Үндістанда көрген кесіртке мен қыз Жапонияға келген.
Dialogue: 0,0:02:16.43,0:02:18.60,Default,,0,0,0,,Қызды жалғыз өзі анықтағанымен.
Dialogue: 0,0:02:19.43,0:02:22.96,Default,,0,0,0,,Менің естуімше, оның оқиғаға қатысы бар-жоғы түсініксіз.
Dialogue: 0,0:02:25.23,0:02:29.40,Default,,0,0,0,,Мүмкін бұл Хота мектептің жертөлесінде көрген адам тәрізді жарыққа қатысы бар шығар.
Dialogue: 0,0:02:30.33,0:02:32.80,Default,,0,0,0,,Немесе Беттерманның серігі
Dialogue: 0,0:02:36.13,0:02:36.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:40.36,0:02:42.03,Default,,0,0,0,,Не болды? Янаги-кун
Dialogue: 0,0:02:53.16,0:02:54.00,Default,,0,0,0,,Янаги-кун?
Dialogue: 0,0:02:54.76,0:02:55.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.03,0:02:57.46,Default,,0,0,0,,Га
Dialogue: 0,0:03:07.63,0:03:08.36,Default,,0,0,0,,Ашуымды келтіргенің – мен тағы да дәл тигіздім деген сөз ғой, иә? Ақымақ патшаның немересі сияқты.
Dialogue: 0,0:03:09.96,0:03:10.63,Default,,0,0,0,,Кей
Dialogue: 0,0:03:12.66,0:03:21.90,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:03:24.53,0:03:32.56,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:03:34.50,0:03:43.23,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:03:46.33,0:03:54.33,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:03:57.56,0:04:06.30,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:04:06.76,0:04:14.76,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:04:16.76,0:04:26.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:04:26.53,0:04:39.13,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:04:44.26,0:04:48.16,Default,,0,0,0,,Екі сағат бұрын Йокосукадан үлкен жүк кемесі аттанды.
Dialogue: 0,0:04:48.46,0:04:53.53,Default,,0,0,0,,Иказучи Марудың күдікті бағытын өзгерткенін анықтаған Үшінші аймақтық жағалау күзеті штабы,
Dialogue: 0,0:04:53.90,0:04:56.26,Default,,0,0,0,,Үш патрульдік қайық жіберілді.
Dialogue: 0,0:04:57.13,0:05:00.76,Default,,0,0,0,,42 минуттан кейін Иказучимару теңізде ұсталды.
Dialogue: 0,0:05:01.43,0:05:05.16,Default,,0,0,0,,Ұшқышсыз кемеге отырды және автопилотты өшірді.
Dialogue: 0,0:05:05.93,0:05:07.50,Default,,0,0,0,,Бірақ одан кейін бірден
Dialogue: 0,0:05:07.66,0:05:11.60,Default,,0,0,0,,Барлық патрульдік қайықтардың байланысы кенеттен тоқтады.
Dialogue: 0,0:05:22.23,0:05:26.76,Default,,0,0,0,,Жоғалған капсула қарастырылып отырған жүк кемесінің бортында деп ойлайсыз ба?
Dialogue: 0,0:05:27.80,0:05:31.36,Default,,0,0,0,,Бүгін таңертең мен Firefly Squid-ге келгенде маған да қоңырау түсті.
Dialogue: 0,0:05:32.06,0:05:33.26,Default,,0,0,0,,Сайтта кездесейік
Dialogue: 0,0:05:33.80,0:05:34.36,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:05:34.83,0:05:38.03,Default,,0,0,0,,Сондай-ақ, Янаги-кунды таптыңыз ба?
Dialogue: 0,0:05:38.96,0:05:39.76,Default,,0,0,0,,Сол жексұрын Аводл әлі тірі ғой, иә?
Dialogue: 0,0:05:40.80,0:05:43.73,Default,,0,0,0,,Қызық, ол жігіт қайда кетті?
Dialogue: 0,0:05:44.30,0:05:45.96,Default,,0,0,0,,Шо қайда?
Dialogue: 0,0:05:46.76,0:05:48.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:50.76,0:05:53.86,Default,,0,0,0,,Бұл адам жай ғана шаршады.
Dialogue: 0,0:05:55.50,0:05:57.10,Default,,0,0,0,,Хаа
Dialogue: 0,0:05:57.80,0:05:59.93,Default,,0,0,0,,Кей, мені кешірші.
Dialogue: 0,0:06:01.83,0:06:04.70,Default,,0,0,0,,Кей, мені кешірші, Кей.
Dialogue: 0,0:06:06.76,0:06:09.23,Default,,0,0,0,,Шо Жарайды.
Dialogue: 0,0:06:09.46,0:06:12.00,Default,,0,0,0,,Сен шаршадың, Шо.
Dialogue: 0,0:06:22.83,0:06:27.66,Default,,0,0,0,,Ухёу, Ширануй, Кагеру және Такао, солай ма?
Dialogue: 0,0:06:32.56,0:06:34.16,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:06:34.83,0:06:37.70,Default,,0,0,0,,Тек сенімді болу үшін мен басқа жиіліктерді де қолданып көрдім.
Dialogue: 0,0:06:38.56,0:06:40.53,Default,,0,0,0,,Иә немесе жоқ деп айта алмаймын.
Dialogue: 0,0:06:43.16,0:06:44.73,Default,,0,0,0,,Мұнда ешқандай ауытқу жоқ.
Dialogue: 0,0:06:45.36,0:06:48.10,Default,,0,0,0,,Экипаж мүшелері әп-сәтте буланып кетті
Dialogue: 0,0:06:48.70,0:06:50.83,Default,,0,0,0,,Бұл Мари Селесте сияқты.
Dialogue: 0,0:06:52.36,0:06:53.40,Default,,0,0,0,,Ммм?
Dialogue: 0,0:06:54.93,0:06:56.60,Default,,0,0,0,,Сіздің әпкеңіз осында ма?
Dialogue: 0,0:07:01.53,0:07:03.40,Default,,0,0,0,,Асамисан
Dialogue: 0,0:07:03.90,0:07:05.33,Default,,0,0,0,,Yahoo
Dialogue: 0,0:07:07.20,0:07:09.50,Default,,0,0,0,,Уау, хохохо
Dialogue: 0,0:07:09.90,0:07:10.66,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:13.20,0:07:13.83,Default,,0,0,0,,Кяах!
Dialogue: 0,0:07:13.93,0:07:14.43,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:07:17.56,0:07:19.63,Default,,0,0,0,,Аа, кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:20.30,0:07:24.13,Default,,0,0,0,,Көп жағдайда бәрі жақсы.
Dialogue: 0,0:07:27.10,0:07:27.56,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:28.10,0:07:29.36,Default,,0,0,0,,...
Dialogue: 0,0:07:37.80,0:07:42.20,Default,,0,0,0,,Бұл жағдайда Тиран жақсырақ болар еді, өйткені ол ұзақ уақыт бойы белсенді бола алады.
Dialogue: 0,0:07:43.06,0:07:45.20,Default,,0,0,0,,Янаги адасып қалды.
Dialogue: 0,0:07:45.76,0:07:48.73,Default,,0,0,0,,Сіз тек бір нейроноидты да жылжыта аласыз.
Dialogue: 0,0:07:53.73,0:07:55.80,Default,,0,0,0,,Дозалауды меңгерген Каэдемен
Dialogue: 0,0:07:56.23,0:07:59.13,Default,,0,0,0,,Сіз Тиран бортында тәжірибесі бар Хинокимен жұпсыз ба?
Dialogue: 0,0:07:59.63,0:08:00.13,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:08:00.76,0:08:02.33,Default,,0,0,0,,Бұл жақсы таңдау.
Dialogue: 0,0:08:28.46,0:08:30.43,Default,,0,0,0,,Хинопи Сіз қорқасыз ба?
Dialogue: 0,0:08:31.00,0:08:32.60,Default,,0,0,0,,Аздап қорқынышты
Dialogue: 0,0:08:32.96,0:08:35.16,Default,,0,0,0,,Ех хе хе мен де
Dialogue: 0,0:08:35.60,0:08:38.83,Default,,0,0,0,,Мен Кейденің аяғын тартып аламын деп ойладым.
Dialogue: 0,0:08:39.36,0:08:42.00,Default,,0,0,0,,Не? Сіз қорқасыз ба?
Dialogue: 0,0:08:42.70,0:08:47.20,Default,,0,0,0,,Мен Тиранның тек Янаги мырзаға арналғанын естідім.
Dialogue: 0,0:08:47.96,0:08:50.23,Default,,0,0,0,,Соңғы рет мінгенде қатты шаршадым.
Dialogue: 0,0:08:51.10,0:08:55.43,Default,,0,0,0,,Дұрыс, Шо, қайда бардың деп ойлаймын.
Dialogue: 0,0:09:03.03,0:09:04.10,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:09:04.53,0:09:08.06,Default,,0,0,0,,Онда Rand Medical Center қызметкерлері жасырынып қалуы мүмкін.
Dialogue: 0,0:09:08.70,0:09:10.36,Default,,0,0,0,,Төмен түсейік
Dialogue: 0,0:09:11.06,0:09:13.66,Default,,0,0,0,,Бір ұйымның қатысы бар ма деп ойлаймын.
Dialogue: 0,0:09:14.46,0:09:15.26,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:09:16.23,0:09:20.36,Default,,0,0,0,,Полиция сенімсіз, бірақ Мордиварп те сенімсіз.
Dialogue: 0,0:09:42.86,0:09:43.53,Default,,0,0,0,,Тоқта
Dialogue: 0,0:09:45.03,0:09:45.73,Default,,0,0,0,,Талдау
Dialogue: 0,0:09:50.40,0:09:54.26,Default,,0,0,0,,Температура 29 градус Цельсий Ылғалдылығы 88%
Dialogue: 0,0:09:54.70,0:09:55.93,Default,,0,0,0,,Қалыпты атмосфералық концентрация
Dialogue: 0,0:09:56.63,0:09:59.70,Default,,0,0,0,,Вирустар мен улы химикаттар анықталмады
Dialogue: 0,0:10:33.76,0:10:35.66,Default,,0,0,0,,Капсулада шаршы әріп те жоқ.
Dialogue: 0,0:10:36.40,0:10:37.30,Default,,0,0,0,,-Сезіну -Мм
Dialogue: 0,0:10:38.56,0:10:42.33,Default,,0,0,0,,Мен Хинопиден сол қыз сияқты рухты сезінемін.
Dialogue: 0,0:10:43.36,0:10:44.10,Default,,0,0,0,,Каэде-сан
Dialogue: 0,0:10:48.30,0:10:48.80,Default,,0,0,0,,Ах
Dialogue: 0,0:10:51.20,0:10:52.06,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:10:52.86,0:10:55.36,Default,,0,0,0,,А, бірдеңе бар.
Dialogue: 0,0:10:58.26,0:10:59.06,Default,,0,0,0,,Доузинг
Dialogue: 0,0:11:00.60,0:11:01.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:17.10,0:11:18.10,Default,,0,0,0,,Ол екі еселенген
Dialogue: 0,0:11:20.73,0:11:21.20,Default,,0,0,0,,Га
Dialogue: 0,0:11:21.26,0:11:21.73,Default,,0,0,0,,Ах
Dialogue: 0,0:11:25.96,0:11:27.20,Default,,0,0,0,,- Бинго - Хое
Dialogue: 0,0:11:29.50,0:11:30.93,Default,,0,0,0,,Хэчин де сонда
Dialogue: 0,0:11:31.50,0:11:33.16,Default,,0,0,0,,Жапон жағалауындағы адамдар туралы не деуге болады?
Dialogue: 0,0:11:33.60,0:11:34.56,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:11:35.46,0:11:38.60,Default,,0,0,0,,Сара-чан, отыруың керек пе?
Dialogue: 0,0:11:39.03,0:11:41.16,Default,,0,0,0,,Маниж машинасы
Dialogue: 0,0:11:41.63,0:11:44.76,Default,,0,0,0,,Жарайды, сәл ғана.
Dialogue: 0,0:11:45.56,0:11:46.10,Default,,0,0,0,,Аан
Dialogue: 0,0:11:47.33,0:11:49.83,Default,,0,0,0,,Білесің бе, Хотата-сан.
Dialogue: 0,0:11:50.80,0:11:51.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.00,0:11:53.56,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:11:54.03,0:11:54.63,Default,,0,0,0,,Уф
Dialogue: 0,0:11:57.86,0:11:59.16,Default,,0,0,0,,Уф, э, һии
Dialogue: 0,0:11:59.63,0:12:03.83,Default,,0,0,0,,Біртүрлі нәрсе, бұл мен бірінші рет
Dialogue: 0,0:12:09.66,0:12:10.60,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:12:10.80,0:12:13.76,Default,,0,0,0,,Дүрбелеңге салынбаңыз. Су астындағы іс-әрекеттер үшін жабдықты пайдаланыңыз.
Dialogue: 0,0:12:14.36,0:12:16.10,Default,,0,0,0,,Хинопиялық бақылау
Dialogue: 0,0:12:16.46,0:12:17.13,Default,,0,0,0,,Сіз…
Dialogue: 0,0:12:18.50,0:12:19.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:30.30,0:12:31.63,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:32.23,0:12:34.36,Default,,0,0,0,,Йотто о
Dialogue: 0,0:12:36.30,0:12:39.86,Default,,0,0,0,,Иә, оянған адамдарға су астындағы әрекеттерге арналған құрал-жабдықтарды алып жүруге болмайды.
Dialogue: 0,0:12:43.23,0:12:44.76,Default,,0,0,0,,Аа.
Dialogue: 0,0:12:45.23,0:12:49.60,Default,,0,0,0,,Уайымдама, оянған адам жауап береді.
Dialogue: 0,0:12:49.73,0:12:53.93,Default,,0,0,0,,Иә, тоқтатыңыз! Уау, ой, ой.
Dialogue: 0,0:12:54.83,0:12:56.20,Default,,0,0,0,,Тиран қызметін тоқтату
Dialogue: 0,0:12:56.63,0:12:58.20,Default,,0,0,0,,Қысымдағы байланыстырушы гель
Dialogue: 0,0:12:58.23,0:13:01.03,Default,,0,0,0,,Ағын манипуляциялық қорапқа кері ағып жатқан сияқты.
Dialogue: 0,0:13:02.33,0:13:05.83,Default,,0,0,0,,Тиран бас сүңгуірдің екпінін көтере алмайды.
Dialogue: 0,0:13:17.33,0:13:19.50,Default,,0,0,0,,Ха, керемет жүзу.
Dialogue: 0,0:13:19.76,0:13:22.16,Default,,0,0,0,,Акамацудың әкесі өтірікші болған.
Dialogue: 0,0:13:23.90,0:13:27.06,Default,,0,0,0,,Әй, бірақ Сара-чан да екі жақты болды.
Dialogue: 0,0:13:27.66,0:13:32.26,Default,,0,0,0,,Мен бас сүңгуір болуға жарамаймын, өйткені мен әлсізмін.
Dialogue: 0,0:13:32.63,0:13:35.76,Default,,0,0,0,,Түсініп тұрмын, сіз бүкіл уақыт бойы ауруханада болдыңыз, солай ма?
Dialogue: 0,0:13:36.76,0:13:38.46,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:39.86,0:13:41.93,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:13:43.23,0:13:46.83,Default,,0,0,0,,Уф, әйтеуір теңізді сағындым.
Dialogue: 0,0:13:48.06,0:13:52.13,Default,,0,0,0,,Хотата мырза, менде СДВГ өте ауыр.
Dialogue: 0,0:13:52.36,0:13:54.20,Default,,0,0,0,,Уф СДВГ?
Dialogue: 0,0:13:54.60,0:13:58.16,Default,,0,0,0,,D4 рецепторының құрылысы адамнан өзгеше.
Dialogue: 0,0:13:58.73,0:13:59.16,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:59.83,0:14:02.66,Default,,0,0,0,,Сонымен маниджи машинасында отыр
Dialogue: 0,0:14:02.93,0:14:08.00,Default,,0,0,0,,Риталинді қабылдамайынша немесе биокері байланыс импульстарын алмасаңыз.
Dialogue: 0,0:14:09.20,0:14:10.16,Default,,0,0,0,,Мен оны алуым керек пе?
Dialogue: 0,0:14:11.20,0:14:15.76,Default,,0,0,0,,Бірақ сіз білесіз бе, мен осында болғанда өте тыныш сезінемін.
Dialogue: 0,0:14:16.20,0:14:17.96,Default,,0,0,0,,Себебі оянған адам
Dialogue: 0,0:14:18.00,0:14:19.26,Default,,0,0,0,,-Уаа -ха
Dialogue: 0,0:14:21.40,0:14:23.76,Default,,0,0,0,,Я, тағы бір құбыжық
Dialogue: 0,0:14:38.73,0:14:41.03,Default,,0,0,0,,Тыныш болыңыз.
Dialogue: 0,0:14:41.86,0:14:42.76,Default,,0,0,0,,Талдау
Dialogue: 0,0:14:47.36,0:14:49.93,Default,,0,0,0,,Нектон және бентос гендері бар.
Dialogue: 0,0:14:50.76,0:14:51.50,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:14:52.13,0:14:54.23,Default,,0,0,0,,Балықтар мен медузалар сияқты жүзетін тіршілік иелері
Dialogue: 0,0:14:54.50,0:14:58.70,Default,,0,0,0,,Теңіз жұлдыздары мен теңіз балдырлары сияқты жорғалаушылар. Екеуінің де ерекшеліктерін көруге болады.
Dialogue: 0,0:14:58.86,0:15:01.93,Default,,0,0,0,,А, бұл теңіз құбыжығы ма?
Dialogue: 0,0:15:02.76,0:15:04.73,Default,,0,0,0,,Саламандар оның достарының бірі ме?
Dialogue: 0,0:15:05.03,0:15:06.80,Default,,0,0,0,,Енді деректерді жүйелеу
Dialogue: 0,0:15:07.16,0:15:08.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:09.26,0:15:11.16,Default,,0,0,0,,Не істесең де, соны істе.
Dialogue: 0,0:15:11.60,0:15:13.10,Default,,0,0,0,,UHUB БАСҚАРУ
Dialogue: 0,0:15:13.66,0:15:14.93,Default,,0,0,0,,iHub басқаруы
Dialogue: 0,0:15:28.66,0:15:29.73,Default,,0,0,0,,Үзіліс синтезі
Dialogue: 0,0:15:33.30,0:15:33.96,Default,,0,0,0,,G-жиынтығы
Dialogue: 0,0:15:35.33,0:15:36.73,Default,,0,0,0,,Синапсты бомбалау
Dialogue: 0,0:15:47.93,0:15:49.00,Default,,0,0,0,,Сәлем Яяа
Dialogue: 0,0:15:51.90,0:15:52.60,Default,,0,0,0,,Денең біраз жазылып қалыпты ғой, иә?
Dialogue: 0,0:15:55.50,0:15:56.90,Default,,0,0,0,,Уваа
Dialogue: 0,0:15:59.10,0:16:00.90,Default,,0,0,0,,Хмм ха ха ха ха ха ха
Dialogue: 0,0:16:07.20,0:16:08.33,Default,,0,0,0,,Сіз Ламияға барасыз ба?
Dialogue: 0,0:16:08.93,0:16:09.90,Default,,0,0,0,,Теңіз түбіне дейін
Dialogue: 0,0:16:10.83,0:16:14.13,Default,,0,0,0,,Ах, Aqua Fruit-ті пайдалану уақыты келді.
Dialogue: 0,0:16:56.33,0:16:58.63,Default,,0,0,0,,Мына балалар нешеу?
Dialogue: 0,0:17:03.13,0:17:04.53,Default,,0,0,0,,Хмм, мені жіберіңізші.
Dialogue: 0,0:17:08.03,0:17:09.70,Default,,0,0,0,,Хаах
Dialogue: 0,0:17:15.30,0:17:16.80,Default,,0,0,0,,Сакора Сакора
Dialogue: 0,0:17:17.56,0:17:18.10,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:19.00,0:17:19.50,Default,,0,0,0,,О
Dialogue: 0,0:17:19.63,0:17:20.23,Default,,0,0,0,,Ой
Dialogue: 0,0:17:22.53,0:17:24.46,Default,,0,0,0,,Жапония жағалау күзетінің адамдары да бар ма?
Dialogue: 0,0:17:26.06,0:17:30.23,Default,,0,0,0,,Ой, мына балалар мұхит түбінен келе жатыр.
Dialogue: 0,0:17:31.13,0:17:31.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.00,0:17:34.50,Default,,0,0,0,,Маған бір нәрсе келе жатыр.
Dialogue: 0,0:17:36.00,0:17:36.66,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:37.76,0:17:41.80,Default,,0,0,0,,600 түйін 1000 км/сағ жоғары
Dialogue: 0,0:17:49.20,0:17:49.70,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:55.03,0:17:55.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:56.96,0:17:57.73,Default,,0,0,0,,Жер
Dialogue: 0,0:18:03.53,0:18:05.33,Default,,0,0,0,,Ааа
Dialogue: 0,0:18:05.66,0:18:06.70,Default,,0,0,0,,Сара-чан
Dialogue: 0,0:18:11.40,0:18:12.06,Default,,0,0,0,,Яғни
Dialogue: 0,0:18:16.03,0:18:16.93,Default,,0,0,0,,Су
Dialogue: 0,0:18:19.63,0:18:21.73,Default,,0,0,0,,Беттермен күткендей
Dialogue: 0,0:18:51.96,0:18:52.50,Default,,0,0,0,,Ах
Dialogue: 0,0:18:53.16,0:18:53.76,Default,,0,0,0,,Тиран
Dialogue: 0,0:18:55.80,0:18:57.40,Default,,0,0,0,,Акамацу мырза тапты
Dialogue: 0,0:18:57.60,0:19:00.96,Default,,0,0,0,,Асықпасаң, оянғандар да қозғала алмайды.
Dialogue: 0,0:19:01.33,0:19:04.86,Default,,0,0,0,,Хиноки-сан да, Каэде-сан да есін жоғалтты.
Dialogue: 0,0:19:05.03,0:19:06.90,Default,,0,0,0,,Тиранмен бірге тез оралыңыз.
Dialogue: 0,0:19:07.03,0:19:10.33,Default,,0,0,0,,Мұхит қаншама өмір қазынасы болса да, бұл...
Dialogue: 0,0:19:11.53,0:19:13.76,Default,,0,0,0,,Ондаған түрлер қатар тіршілік етеді
Dialogue: 0,0:19:39.43,0:19:43.90,Default,,0,0,0,,Urr...
Dialogue: 0,0:19:48.76,0:19:51.23,Default,,0,0,0,,Психо... Сұйықтық...
Dialogue: 0,0:20:01.96,0:20:03.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:06.16,0:20:07.96,Default,,0,0,0,,Ах та та та та та Келме, Келме, Келме
Dialogue: 0,0:20:08.03,0:20:09.93,Default,,0,0,0,,-Келме, келме, келме -Қорықпа, Хота-кун
Dialogue: 0,0:20:10.00,0:20:10.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.10,0:20:14.96,Default,,0,0,0,,Беттерман жаудың ұрыс кезіндегі ерекшеліктерін талдаған.
Dialogue: 0,0:20:15.23,0:20:19.53,Default,,0,0,0,,Мен тек сол кездегі пішінге сәйкес келетін функцияларды қолдана отырып, жеңуім керек қарсыластарды жеңе алдым.
Dialogue: 0,0:20:22.83,0:20:25.96,Default,,0,0,0,,Бәлкім, дәл осы ереже мұнда да қолданылады.
Dialogue: 0,0:20:50.90,0:20:52.13,Default,,0,0,0,,Ааа
Dialogue: 0,0:20:54.96,0:20:56.63,Default,,0,0,0,,Бұл уақыт қанша?
Dialogue: 0,0:20:57.00,0:21:01.53,Default,,0,0,0,,Ой, бұл не? Теңіз түбі көтеріліп жатыр ма?
Dialogue: 0,0:21:24.70,0:21:28.50,Default,,0,0,0,,О, бүкіл мұхит түбі құбыжық болды ма?
Dialogue: 0,0:21:29.13,0:21:31.03,Default,,0,0,0,,Көптеген тірі заттар қатар тіршілік етеді
Dialogue: 0,0:21:31.33,0:21:35.53,Default,,0,0,0,,Оны бір үлкен тіршілік иесі ретінде бекіткен деп ойлауымыз керек.
Dialogue: 0,0:21:44.80,0:21:46.46,Default,,0,0,0,,Сара-чан, жақсысың ба?
Dialogue: 0,0:21:46.96,0:21:47.43,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.20,0:21:50.06,Default,,0,0,0,,Кешіріңіз, Кейта-сан.
Dialogue: 0,0:21:50.50,0:21:53.46,Default,,0,0,0,,Өйткені, бұл Хиноки-сан болуы керек сияқты.
Dialogue: 0,0:21:53.66,0:21:54.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.56,0:21:57.53,Default,,0,0,0,,Үзіліс синтезі әлсіз болды, солай ма?
Dialogue: 0,0:21:57.70,0:21:59.26,Default,,0,0,0,,Ой, солай ма?
Dialogue: 0,0:21:59.40,0:22:01.80,Default,,0,0,0,,Менің ойымша, бұл басқаша емес.
Dialogue: 0,0:22:03.03,0:22:03.56,Default,,0,0,0,,...
Dialogue: 0,0:22:09.60,0:22:15.50,Default,,0,0,0,,Мирна Мирна Жер түбі қираған ел
Dialogue: 0,0:22:16.43,0:22:20.76,Default,,0,0,0,,Мирна Мирна Мирна
Dialogue: 0,0:22:21.06,0:22:21.56,Default,,0,0,0,,Ах
Dialogue: 0,0:22:23.16,0:22:23.73,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:22:27.96,0:22:28.76,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:22:35.40,0:22:47.96,Default,,0,0,0,,Құдайдың күнәсі шексіз теломерлерге ойылған
Dialogue: 0,0:22:48.70,0:22:54.80,Default,,0,0,0,,Жалын құшақтап
Dialogue: 0,0:22:55.23,0:23:02.46,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.73,0:23:06.00,Default,,0,0,0,,Жан рухы Жалғыз дауыс
Dialogue: 0,0:23:06.30,0:23:09.40,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.56,0:23:12.80,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:13.03,0:23:16.43,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:18.30,0:23:28.00,Default,,0,0,0,,Алыстағы күннің сәулесін табыңыз!
Dialogue: 0,0:23:28.60,0:23:38.00,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.83,0:23:49.83,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:24:01.13,0:24:03.86,Default,,0,0,0,,Түн ортасында шу көп
Dialogue: 0,0:24:04.56,0:24:07.50,Default,,0,0,0,,Қашыңыз немесе қашыңыз немесе жақындаңыз
Dialogue: 0,0:24:07.83,0:24:09.96,Default,,0,0,0,,Тару толып жатыр
Dialogue: 0,0:24:10.93,0:24:15.60,Default,,0,0,0,,Келме, келме, келме, келме
Dialogue: 0,0:24:16.90,0:24:18.86,Default,,0,0,0,,Пича Пича Пича Пича
Dialogue: 0,0:24:19.43,0:24:20.93,Default,,0,0,0,,Үйіп-қонатын жәндіктер
Dialogue: 0,0:24:22.06,0:24:23.73,Default,,0,0,0,,сіздің денеңіз
Dialogue: 0,0:24:24.56,0:24:25.90,Default,,0,0,0,,Тексеру
Dialogue: 0,0:24:27.40,0:24:33.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
