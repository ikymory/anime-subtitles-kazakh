Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.50,0:00:15.60,Default,,0,0,0,,Хота-кунның Эносимадан сатып алған тұмары
Dialogue: 0,0:00:16.66,0:00:20.16,Default,,0,0,0,,Аморфты туындылар ішінен ұсақ тоқылған.
Dialogue: 0,0:00:21.30,0:00:22.03,Default,,0,0,0,,Премьер
Dialogue: 0,0:00:22.63,0:00:23.23,Default,,0,0,0,,Дуджи
Dialogue: 0,0:00:24.00,0:00:24.53,Default,,0,0,0,,Троя
Dialogue: 0,0:00:25.53,0:00:28.26,Default,,0,0,0,,Осы ерте Тирандардың өзегінде қолданылған.
Dialogue: 0,0:00:28.43,0:00:30.50,Default,,0,0,0,,Биопроцесс материалымен бірдей
Dialogue: 0,0:00:33.50,0:00:35.00,Default,,0,0,0,,Алдыңғы жағдайлармен бірдей
Dialogue: 0,0:00:35.26,0:00:38.16,Default,,0,0,0,,Қылмысты Альжернон жұқтырған адам жасады ма?
Dialogue: 0,0:00:39.03,0:00:41.90,Default,,0,0,0,,Бұл бізге қиындық туғызатыны анық
Dialogue: 0,0:00:42.90,0:00:45.90,Default,,0,0,0,,Қатысқан адамдарды анықтауға асығыңыз. офицер
Dialogue: 0,0:00:51.73,0:01:01.40,Default,,0,0,0,,Көк домалақ үнсіздік
Dialogue: 0,0:01:03.60,0:01:11.66,Default,,0,0,0,,Жүзетін күміс қайық
Dialogue: 0,0:01:13.53,0:01:22.20,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:25.33,0:01:33.46,Default,,0,0,0,,Қай жерде теңселіп тұрсың?
Dialogue: 0,0:01:36.53,0:01:45.46,Default,,0,0,0,,Рух тағы оянды
Dialogue: 0,0:01:45.73,0:01:53.80,Default,,0,0,0,,Жанға бағыт-бағдар беру
Dialogue: 0,0:01:55.73,0:02:05.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:05.56,0:02:17.50,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:33.06,0:02:36.56,Default,,0,0,0,,автокөлік
Dialogue: 0,0:02:42.33,0:02:45.23,Default,,0,0,0,,Мұнда қанша адам қамауда?
Dialogue: 0,0:02:45.80,0:02:49.00,Default,,0,0,0,,Бүгінгі күні 437 дене бар.
Dialogue: 0,0:02:49.33,0:02:51.86,Default,,0,0,0,,21-і жұмысқа жіберілді
Dialogue: 0,0:02:54.23,0:02:58.83,Default,,0,0,0,,Адамдар өлгенде, олар жай бөлшектерге айналады, солай емес пе?
Dialogue: 0,0:03:00.33,0:03:02.63,Default,,0,0,0,,Ескі этикаға бой алдырмаңыз
Dialogue: 0,0:03:03.30,0:03:06.43,Default,,0,0,0,,Мұндағы нәтижелер аурудан зардап шегетін адамдарға көмектеседі.
Dialogue: 0,0:03:06.76,0:03:10.10,Default,,0,0,0,,Жаңа дәрілік заттардың дамуына да ықпал етеді.
Dialogue: 0,0:03:10.76,0:03:12.36,Default,,0,0,0,,Бұл биоматериал ма?
Dialogue: 0,0:03:15.03,0:03:18.20,Default,,0,0,0,,Америкада венчурлық бизнес ретінде қазірдің өзінде кең таралған.
Dialogue: 0,0:03:19.06,0:03:23.13,Default,,0,0,0,,Жапонияда тіркелген донорлар саны жылдан жылға артып келеді.
Dialogue: 0,0:03:29.93,0:03:32.13,Default,,0,0,0,,Дегенмен, органдарды трансплантациялау үшін
Dialogue: 0,0:03:32.26,0:03:35.06,Default,,0,0,0,,Басқа адамдардың жасушаларымен бас тарту жиі кездеседі.
Dialogue: 0,0:03:38.56,0:03:41.00,Default,,0,0,0,,Тіндік инженерия да айтарлықтай жетістіктерге жетті.
Dialogue: 0,0:03:41.70,0:03:46.60,Default,,0,0,0,,Иммуносупрессиялық препараттардың реципиенттердің үйлесімділігін жеңілдету үшін тиімділігі де артып келеді.
Dialogue: 0,0:03:47.80,0:03:50.83,Default,,0,0,0,,Әр адамға әртүрлі қарау керек пе?
Dialogue: 0,0:03:51.33,0:03:55.30,Default,,0,0,0,,Сондықтан мен сияқты регенерация үйлестірушілеріміз бар.
Dialogue: 0,0:03:56.76,0:03:58.10,Default,,0,0,0,,Кактус болып табылады
Dialogue: 0,0:03:59.43,0:04:00.83,Default,,0,0,0,,Бұл жерде артқы жағында ұйықтау
Dialogue: 0,0:04:01.46,0:04:04.83,Default,,0,0,0,,Алджернонның көптеген құрбандарымен бірге.
Dialogue: 0,0:04:12.76,0:04:13.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:13.93,0:04:14.56,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:16.76,0:04:17.83,Default,,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:04:18.10,0:04:18.56,Default,,0,0,0,,болып табылады
Dialogue: 0,0:04:21.00,0:04:22.03,Default,,0,0,0,,Анимус гүлі
Dialogue: 0,0:04:22.60,0:04:23.96,Default,,0,0,0,,Сонымен қатар, бұл
Dialogue: 0,0:04:25.20,0:04:26.56,Default,,0,0,0,,Forte жемісі
Dialogue: 0,0:04:28.33,0:04:31.23,Default,,0,0,0,,Доктор Умезакимен бірдей
Dialogue: 0,0:04:35.73,0:04:36.96,Default,,0,0,0,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:04:37.53,0:04:39.83,Default,,0,0,0,,Барлық Forte-ға ортақ нәрсе
Dialogue: 0,0:04:41.10,0:04:43.76,Default,,0,0,0,,Доктор Сай мен оның достары жоғалған Аджанта үңгірлері
Dialogue: 0,0:04:45.90,0:04:47.60,Default,,0,0,0,,BPL докторы Умезаки
Dialogue: 0,0:04:49.20,0:04:50.26,Default,,0,0,0,,Және кактус
Dialogue: 0,0:04:52.73,0:04:53.43,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:54.33,0:04:55.50,Default,,0,0,0,,Сүңгуірді тексеру
Dialogue: 0,0:04:59.40,0:04:59.86,Default,,0,0,0,,(Камо) Жылдам! Ол қалай болғанда да тез арада жазылып кетеді.
Dialogue: 0,0:05:00.86,0:05:01.43,Default,,0,0,0,,(Камо) Жылдам! Ол қалай болғанда да тез арада жазылып кетеді.
Dialogue: 0,0:05:02.13,0:05:03.36,Default,,0,0,0,,Эй, маған да көмектес.
Dialogue: 0,0:05:03.43,0:05:03.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:04.23,0:05:04.80,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:05:05.23,0:05:06.00,Default,,0,0,0,,Эххехе
Dialogue: 0,0:05:12.13,0:05:15.56,Default,,0,0,0,,Менің ойымша, Кейтаның жігіті тым жақсы жүр.
Dialogue: 0,0:05:15.96,0:05:18.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:23.66,0:05:26.33,Default,,0,0,0,,Я, бұл үлкен мәселе.
Dialogue: 0,0:05:27.46,0:05:29.03,Default,,0,0,0,,Ұзақ уақыт жалғыз тұру
Dialogue: 0,0:05:29.56,0:05:32.56,Default,,0,0,0,,Менің ойымша, ол жақсы әйел болады.
Dialogue: 0,0:05:33.16,0:05:33.83,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:33.96,0:05:36.26,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:05:36.40,0:05:39.63,Default,,0,0,0,,Акамацу мырза мен оның достары да осында келе жатқандарын айтты.
Dialogue: 0,0:05:51.30,0:05:53.00,Default,,0,0,0,,...
Dialogue: 0,0:05:54.20,0:05:55.00,Default,,0,0,0,,...
Dialogue: 0,0:05:56.23,0:05:56.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:59.36,0:06:01.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:01.30,0:06:02.03,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:04.30,0:06:08.33,Default,,0,0,0,,Күндізгі стейк өте жақсы.
Dialogue: 0,0:06:08.53,0:06:10.56,Default,,0,0,0,,...
Dialogue: 0,0:06:11.56,0:06:14.96,Default,,0,0,0,,Бұл жұмсақ иіс те тамаша.
Dialogue: 0,0:06:15.40,0:06:16.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:17.76,0:06:20.10,Default,,0,0,0,,Жақын жерде шарап зауыты бар.
Dialogue: 0,0:06:20.83,0:06:22.90,Default,,0,0,0,,Бұл жергілікті мамандық.
Dialogue: 0,0:06:24.73,0:06:27.43,Default,,0,0,0,,Шарап ашық қызыл
Dialogue: 0,0:06:28.36,0:06:30.96,Default,,0,0,0,,Қанның түсі сияқты
Dialogue: 0,0:06:32.76,0:06:35.76,Default,,0,0,0,,Хмм хмм ой
Dialogue: 0,0:06:50.03,0:06:50.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.86,0:06:54.70,Default,,0,0,0,,А-а-а
Dialogue: 0,0:06:57.60,0:06:58.90,Default,,0,0,0,,бұл хехе
Dialogue: 0,0:06:59.26,0:07:00.93,Default,,0,0,0,,Ешкім қарап тұрған жоқ
Dialogue: 0,0:07:02.70,0:07:04.80,Default,,0,0,0,,Хиноки
Dialogue: 0,0:07:05.63,0:07:07.53,Default,,0,0,0,,Хидаа
Dialogue: 0,0:07:08.03,0:07:11.10,Default,,0,0,0,,Уау, бұл ауқымнан тыс болса да, бұл біртүрлі.
Dialogue: 0,0:07:14.43,0:07:16.63,Default,,0,0,0,,Мм, сынып қалды ма деп ойлаймын.
Dialogue: 0,0:07:16.90,0:07:18.66,Default,,0,0,0,,Кез келген жағдайда, Акамацу мырза және басқалар?
Dialogue: 0,0:07:18.86,0:07:21.56,Default,,0,0,0,,Таудың ортасында бұлай қабылдауға болмайды.
Dialogue: 0,0:07:22.26,0:07:22.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.30,0:07:26.46,Default,,0,0,0,,Бұл қандай сан?
Dialogue: 0,0:07:29.06,0:07:31.76,Default,,0,0,0,,Маған көмектесші, Каэде?
Dialogue: 0,0:07:32.13,0:07:32.63,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:33.06,0:07:33.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:33.86,0:07:34.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:59.26,0:08:02.16,Default,,0,0,0,,Радиотолқындардың осы жерден келгеніне күмән жоқ сияқты.
Dialogue: 0,0:08:02.96,0:08:05.96,Default,,0,0,0,,Өйткені, мульти-сирек ішінде ешкім жоқ.
Dialogue: 0,0:08:06.76,0:08:08.76,Default,,0,0,0,,Рычаг ғимарат ішінде ме?
Dialogue: 0,0:08:09.06,0:08:10.56,Default,,0,0,0,,Өткен күні не болды?
Dialogue: 0,0:08:12.10,0:08:15.06,Default,,0,0,0,,Мүмкін тағы бір жаман нәрсе болып жатқан шығар.
Dialogue: 0,0:08:16.03,0:08:18.53,Default,,0,0,0,,Біз не істеуіміз керек? Полицияға айтайын ба?
Dialogue: 0,0:08:18.86,0:08:19.86,Default,,0,0,0,,Менің ойымша, бұл ауқымнан тыс.
Dialogue: 0,0:08:20.46,0:08:21.76,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:08:22.40,0:08:23.53,Default,,0,0,0,,Кеттік, Кей Чан
Dialogue: 0,0:08:23.80,0:08:24.26,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:08:25.10,0:08:27.56,Default,,0,0,0,,Ішінде телефон болуы мүмкін.
Dialogue: 0,0:08:29.70,0:08:31.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:36.33,0:08:38.43,Default,,0,0,0,,Қараңызшы, онда ешкім жоқ.
Dialogue: 0,0:08:38.70,0:08:39.20,Default,,0,0,0,,Иә
Dialogue: 0,0:09:01.53,0:09:03.60,Default,,0,0,0,,Өте қауіпті көрінеді
Dialogue: 0,0:09:04.90,0:09:06.70,Default,,0,0,0,,А-а, бәрібір кері бұрылған дұрыс.
Dialogue: 0,0:09:07.03,0:09:07.63,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:08.56,0:09:10.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:10.33,0:09:11.23,Default,,0,0,0,,Бұл дыбыс
Dialogue: 0,0:09:11.40,0:09:11.93,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:13.03,0:09:13.86,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:09:13.93,0:09:14.66,Default,,0,0,0,,Не?
Dialogue: 0,0:09:15.36,0:09:16.03,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:20.40,0:09:21.60,Default,,0,0,0,,«Изако кепілге босатылды. Кепіл ретінде 70 миллион лира белгіленді»
Dialogue: 0,0:09:24.36,0:09:26.16,Default,,0,0,0,,Ол бірдеңе жеп жатқан сияқты
Dialogue: 0,0:09:27.66,0:09:28.80,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:09:29.06,0:09:29.53,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:32.00,0:09:35.50,Default,,0,0,0,,Кей-чан, бірдеңе болып қалса, мені қорғашы.
Dialogue: 0,0:09:36.66,0:09:37.13,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:09:37.16,0:09:37.76,Default,,0,0,0,,Эй
Dialogue: 0,0:09:45.53,0:09:46.00,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:09:48.20,0:09:53.06,Default,,0,0,0,,Уау аа Уау аа
Dialogue: 0,0:09:53.50,0:09:53.96,Default,,0,0,0,,Уф
Dialogue: 0,0:09:55.86,0:09:56.63,Default,,0,0,0,,К-чан
Dialogue: 0,0:09:57.03,0:09:59.93,Default,,0,0,0,,Уаа
Dialogue: 0,0:10:00.33,0:10:05.46,Default,,0,0,0,,Ух ха ха уһ ой жоқ ой жоқ ой
Dialogue: 0,0:10:06.03,0:10:08.50,Default,,0,0,0,,Ахххх
Dialogue: 0,0:10:08.53,0:10:11.06,Default,,0,0,0,,Kyaah
Dialogue: 0,0:10:11.20,0:10:14.00,Default,,0,0,0,,Уау уау уау
Dialogue: 0,0:10:14.23,0:10:16.73,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:16.93,0:10:19.20,Default,,0,0,0,,Мені тастап қашу жиіркенішті.
Dialogue: 0,0:10:19.33,0:10:23.33,Default,,0,0,0,,Жоқ, жоқ, жоқ, мен сені олай тастаған жоқпын.
Dialogue: 0,0:10:23.93,0:10:26.46,Default,,0,0,0,,Кір жуудан неге қорқасың?
Dialogue: 0,0:10:26.70,0:10:28.46,Default,,0,0,0,,Ол шынымен де ақымақ.
Dialogue: 0,0:10:28.63,0:10:31.96,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:10:32.83,0:10:33.36,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:34.93,0:10:35.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.00,0:10:36.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:42.56,0:10:43.70,Default,,0,0,0,,Каваки
Dialogue: 0,0:10:44.56,0:10:45.60,Default,,0,0,0,,Каваки
Dialogue: 0,0:10:45.76,0:10:46.53,Default,,0,0,0,,Сакура?
Dialogue: 0,0:10:47.26,0:10:49.56,Default,,0,0,0,,Уау, мен таң қалдым.
Dialogue: 0,0:10:51.16,0:10:52.16,Default,,0,0,0,,Каваки
Dialogue: 0,0:10:52.96,0:10:54.56,Default,,0,0,0,,үшін сүйкімді
Dialogue: 0,0:10:55.46,0:10:56.56,Default,,0,0,0,,Сара-чан?
Dialogue: 0,0:10:56.83,0:10:58.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:10:58.16,0:11:01.23,Default,,0,0,0,,үшін сүйкімді
Dialogue: 0,0:11:01.30,0:11:01.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.56,0:11:09.16,Default,,0,0,0,,Мен сені аяймын, бәрің, о
Dialogue: 0,0:11:09.23,0:11:11.03,Default,,0,0,0,,және О және Сара-чан
Dialogue: 0,0:11:11.43,0:11:12.90,Default,,0,0,0,,Не болды, Сара?
Dialogue: 0,0:11:13.16,0:11:14.23,Default,,0,0,0,,Иә, нық.
Dialogue: 0,0:11:16.03,0:11:16.53,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:18.53,0:11:20.13,Default,,0,0,0,,Дәл қазір не болды?
Dialogue: 0,0:11:21.00,0:11:21.56,Default,,0,0,0,,болып табылады
Dialogue: 0,0:11:25.50,0:11:27.06,Default,,0,0,0,,Аа, жақсысың ба?
Dialogue: 0,0:11:28.40,0:11:30.16,Default,,0,0,0,,Акамацу мырзаға және басқаларға не болды?
Dialogue: 0,0:11:30.63,0:11:31.20,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:11:32.90,0:11:36.10,Default,,0,0,0,,Жеу керек Жеу керек
Dialogue: 0,0:11:37.06,0:11:40.33,Default,,0,0,0,,Жеу керек
Dialogue: 0,0:11:49.46,0:11:52.33,Default,,0,0,0,,Осы жерден сәл төменірек.
Dialogue: 0,0:11:52.53,0:11:53.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:53.66,0:11:55.23,Default,,0,0,0,,Сәлем Хиноки
Dialogue: 0,0:11:55.66,0:11:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.16,0:11:58.90,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:00.03,0:12:02.43,Default,,0,0,0,,Мәйіттер сақталатын жер.\NМенің ойымша,
Dialogue: 0,0:12:02.70,0:12:04.03,Default,,0,0,0,,...
Dialogue: 0,0:12:04.46,0:12:05.63,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:12:07.76,0:12:09.86,Default,,0,0,0,,үшін бос па?
Dialogue: 0,0:12:15.80,0:12:18.26,Default,,0,0,0,,Мәйіттер өздігінен қозғалады.
Dialogue: 0,0:12:18.73,0:12:19.50,Default,,0,0,0,,Зомби?
Dialogue: 0,0:12:20.56,0:12:22.43,Default,,0,0,0,,Мүмкін олардың барлығын жеп қойған шығар
Dialogue: 0,0:12:22.90,0:12:23.96,Default,,0,0,0,,Мұндағы адамдар
Dialogue: 0,0:12:25.36,0:12:27.60,Default,,0,0,0,,Акамацу мырза және т.б.
Dialogue: 0,0:12:28.43,0:12:30.43,Default,,0,0,0,,Каэде-санның хабары қандай?
Dialogue: 0,0:12:31.86,0:12:32.80,Default,,0,0,0,,Кейта мырза
Dialogue: 0,0:12:33.20,0:12:34.30,Default,,0,0,0,,Не?
Dialogue: 0,0:12:35.76,0:12:38.26,Default,,0,0,0,,Өтінемін, мен мұны қалаймын.
Dialogue: 0,0:12:38.96,0:12:39.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:40.43,0:12:41.40,Default,,0,0,0,,Маған тамақ ішуге рұқсат етіңіз
Dialogue: 0,0:12:41.73,0:12:43.73,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:44.36,0:12:44.90,Default,,0,0,0,,Hii
Dialogue: 0,0:12:46.50,0:12:47.60,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:12:48.70,0:12:49.56,Default,,0,0,0,,Ке-чан?
Dialogue: 0,0:12:50.73,0:12:53.33,Default,,0,0,0,,Не істеп жатырсың, Сара?
Dialogue: 0,0:12:56.33,0:12:58.76,Default,,0,0,0,,Сара-чанның өзі зомбиге айналды
Dialogue: 0,0:13:00.26,0:13:03.66,Default,,0,0,0,,Маған тамақ ішуге рұқсат етіңіз, иә.
Dialogue: 0,0:13:03.73,0:13:05.36,Default,,0,0,0,,Уау, сәлем Хиноки
Dialogue: 0,0:13:06.66,0:13:07.16,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:07.73,0:13:08.23,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:09.50,0:13:11.03,Default,,0,0,0,,Ууух
Dialogue: 0,0:13:11.76,0:13:13.53,Default,,0,0,0,,Неміс армиясы Страиццомен және сол қарт Спидвагонмен байланысты ма—
Dialogue: 0,0:13:14.26,0:13:16.93,Default,,0,0,0,,...
Dialogue: 0,0:13:17.20,0:13:17.63,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:17.83,0:13:19.26,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,0:13:19.33,0:13:20.86,Default,,0,0,0,,А-а-а
Dialogue: 0,0:13:21.10,0:13:22.40,Default,,0,0,0,,Умаджи...
Dialogue: 0,0:13:25.20,0:13:25.83,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:13:27.40,0:13:29.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:30.23,0:13:31.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.96,0:13:39.33,Default,,0,0,0,,Акамацу мырза, Асами мырза
Dialogue: 0,0:13:39.56,0:13:41.43,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:13:47.33,0:13:47.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:48.50,0:13:50.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:50.20,0:13:51.23,Default,,0,0,0,,Ах
Dialogue: 0,0:13:51.93,0:13:52.46,Default,,0,0,0,,болып табылады
Dialogue: 0,0:13:52.50,0:13:52.96,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:54.73,0:13:57.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:00.46,0:14:01.26,Default,,0,0,0,,О
Dialogue: 0,0:14:01.63,0:14:02.20,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:14:05.20,0:14:06.93,Default,,0,0,0,,Хинокиннің үйінде кездестірген қарт
Dialogue: 0,0:14:07.43,0:14:09.43,Default,,0,0,0,,Нәзік жүрек
Dialogue: 0,0:14:13.26,0:14:15.30,Default,,0,0,0,,Босатылған
Dialogue: 0,0:14:19.16,0:14:20.33,Default,,0,0,0,,Уф
Dialogue: 0,0:14:20.40,0:14:21.23,Default,,0,0,0,,-Енді -Уф
Dialogue: 0,0:14:25.43,0:14:27.03,Default,,0,0,0,,Ақшобя
Dialogue: 0,0:14:27.70,0:14:31.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:32.33,0:14:32.96,Default,,0,0,0,,Уф
Dialogue: 0,0:14:33.23,0:14:37.53,Default,,0,0,0,,О, жоқ, о...
Dialogue: 0,0:14:41.10,0:14:41.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.93,0:15:10.90,Default,,0,0,0,,Вайрочана
Dialogue: 0,0:15:16.10,0:15:16.60,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:15:18.36,0:15:18.93,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:20.06,0:15:20.63,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:15:21.60,0:15:22.20,Default,,0,0,0,,О
Dialogue: 0,0:15:40.36,0:15:42.20,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:15:42.33,0:15:46.43,Default,,0,0,0,,Хаа, Сара-чан мен басқалары неге бұлай істеді?
Dialogue: 0,0:15:46.70,0:15:50.26,Default,,0,0,0,,Ха, мен түсінбедім, бұл ақымақтық.
Dialogue: 0,0:15:50.40,0:15:52.13,Default,,0,0,0,,-у-а-а
Dialogue: 0,0:15:56.00,0:15:57.33,Default,,0,0,0,,А, ол осында.
Dialogue: 0,0:15:57.46,0:15:59.10,Default,,0,0,0,,Биологиялық бөліктер дегеніміз не?
Dialogue: 0,0:16:00.33,0:16:03.86,Default,,0,0,0,,Бұл электронды түрде құлыпталған сияқты.
Dialogue: 0,0:16:06.50,0:16:06.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.63,0:16:08.13,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:10.70,0:16:11.56,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:16:15.53,0:16:16.26,Default,,0,0,0,,О
Dialogue: 0,0:16:17.50,0:16:19.00,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:16:20.96,0:16:22.73,Default,,0,0,0,,Мм, мүмкін
Dialogue: 0,0:16:25.23,0:16:25.66,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:16:26.23,0:16:26.66,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:30.16,0:16:33.93,Default,,0,0,0,,Уау хаха аа ах аа
Dialogue: 0,0:16:34.23,0:16:35.53,Default,,0,0,0,,Иә
Dialogue: 0,0:16:38.00,0:16:40.36,Default,,0,0,0,,Янаги-сан Каэде-сан
Dialogue: 0,0:16:43.33,0:16:45.36,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:16:45.63,0:16:46.96,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:16:47.40,0:16:50.70,Default,,0,0,0,,Мен жақсымын, өйткені Шо мені жылытады.
Dialogue: 0,0:16:51.93,0:16:54.00,Default,,0,0,0,,Бірақ сен мұнда не үшін келдің?
Dialogue: 0,0:16:54.33,0:16:56.46,Default,,0,0,0,,Ешқандай қашып құтыла алмай секіріп кіруге болады.
Dialogue: 0,0:16:56.76,0:16:57.93,Default,,0,0,0,,Құлыпталған
Dialogue: 0,0:16:58.53,0:17:03.33,Default,,0,0,0,,Мен шығарылым нөмірін оқи алдым, бірақ ішінен ештеңе істей алмадым.
Dialogue: 0,0:17:04.40,0:17:06.53,Default,,0,0,0,,Электромагниттік толқын пішіндерін разрядпен құру
Dialogue: 0,0:17:06.96,0:17:10.20,Default,,0,0,0,,Кетанға әрең дегенде хабар жібердім.
Dialogue: 0,0:17:10.30,0:17:11.73,Default,,0,0,0,,Каэде-сан күткендей
Dialogue: 0,0:17:12.76,0:17:14.96,Default,,0,0,0,,Неліктен Асами-сан және басқалары мұндай әрекетке барды?
Dialogue: 0,0:17:15.36,0:17:18.80,Default,,0,0,0,,Түскі ас ішіп отырғанымызда, бәрі кенет есінен танып қалды.
Dialogue: 0,0:17:18.96,0:17:21.10,Default,,0,0,0,,Бұл шынымен де Алджернон ба?
Dialogue: 0,0:17:21.50,0:17:23.63,Default,,0,0,0,,Қалай болғанда да, қауіпсіз жерде.
Dialogue: 0,0:17:23.80,0:17:24.26,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:26.00,0:17:27.43,Default,,0,0,0,,-жегің келеді -кел
Dialogue: 0,0:17:31.73,0:17:32.96,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:17:33.03,0:17:34.90,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:17:35.86,0:17:37.96,Default,,0,0,0,,Аа, біз шығуға жақын қалдық.
Dialogue: 0,0:17:38.13,0:17:41.00,Default,,0,0,0,,Иә, бірақ не?
Dialogue: 0,0:17:42.20,0:17:44.93,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:17:46.56,0:17:51.20,Default,,0,0,0,,Менің де тамағым кепті.
Dialogue: 0,0:17:52.13,0:17:52.60,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:17:53.43,0:17:54.46,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:54.76,0:17:55.93,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:56.16,0:17:57.63,Default,,0,0,0,,"Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:18:00.23,0:18:01.80,Default,,0,0,0,,...
Dialogue: 0,0:18:02.33,0:18:03.40,Default,,0,0,0,,Уау
Dialogue: 0,0:18:04.36,0:18:05.16,Default,,0,0,0,,Уф
Dialogue: 0,0:18:05.93,0:18:07.96,Default,,0,0,0,,Кетан Хинопиге
Dialogue: 0,0:18:09.40,0:18:10.50,Default,,0,0,0,,Не істеуім керек, Шо?
Dialogue: 0,0:18:12.06,0:18:13.20,Default,,0,0,0,,О, дұрыс, мен Буггарати мен басқалармен байланысуым керек
Dialogue: 0,0:18:13.83,0:18:14.30,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:18:15.40,0:18:17.06,Default,,0,0,0,,О, дұрыс, мен Буггарати мен басқалармен байланысуым керек
Dialogue: 0,0:18:20.76,0:18:21.76,Default,,0,0,0,,...
Dialogue: 0,0:18:22.80,0:18:24.63,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:18:24.73,0:18:27.56,Default,,0,0,0,,У ха ха ха ха ха
Dialogue: 0,0:18:27.70,0:18:30.13,Default,,0,0,0,,Хмм ха ха ха ха
Dialogue: 0,0:18:30.70,0:18:33.30,Default,,0,0,0,,Хмм ха ха ха ха
Dialogue: 0,0:18:33.86,0:18:38.13,Default,,0,0,0,,Енді тек сен екеуміз ғана парасаттымыз.
Dialogue: 0,0:18:38.70,0:18:39.23,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:18:39.86,0:18:42.56,Default,,0,0,0,,Сіз басқа адамдардан ерекшесіз.
Dialogue: 0,0:18:42.93,0:18:43.86,Default,,0,0,0,,Ах ха
Dialogue: 0,0:18:43.90,0:18:47.53,Default,,0,0,0,,Қандай адамдар хайуанға айналды?
Dialogue: 0,0:18:47.96,0:18:50.10,Default,,0,0,0,,күрсіну
Dialogue: 0,0:18:53.00,0:18:53.50,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:18:54.40,0:18:56.76,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:18:56.83,0:18:57.40,Default,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:18:57.96,0:19:00.20,Default,,0,0,0,,О, дұрыс, мен Буггарати мен басқалармен байланысуым керек
Dialogue: 0,0:19:02.03,0:19:02.50,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:19:03.73,0:19:05.30,Default,,0,0,0,,Сіз біліктісіз.
Dialogue: 0,0:19:06.50,0:19:07.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:19:11.40,0:19:13.13,Default,,0,0,0,,Кәне, жиналайық.
Dialogue: 0,0:19:13.40,0:19:14.93,Default,,0,0,0,,Мұғалімнің қол астында
Dialogue: 0,0:19:15.83,0:19:18.30,Default,,0,0,0,,Бізбен бірге аман бол.
Dialogue: 0,0:19:20.23,0:19:21.56,Default,,0,0,0,,Мені кім шақырды?
Dialogue: 0,0:19:21.96,0:19:25.40,Default,,0,0,0,,Бұл премьер Дуджи емес, кактус та емес еді.
Dialogue: 0,0:19:26.40,0:19:28.06,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:28.90,0:19:29.73,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:30.63,0:19:33.23,Default,,0,0,0,,-Кэдені жалғыз қалдырсам, ол пайда болады деп ойладым. -Е.
Dialogue: 0,0:19:33.36,0:19:34.43,Default,,0,0,0,,Пьеса ойнады
Dialogue: 0,0:19:35.03,0:19:35.86,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:19:36.86,0:19:37.53,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:39.83,0:19:41.23,Default,,0,0,0,,Сіз құйрығыңызды көрсеттіңіз.
Dialogue: 0,0:19:41.80,0:19:43.13,Default,,0,0,0,,Шо Бұл адам
Dialogue: 0,0:19:44.26,0:19:46.80,Default,,0,0,0,,Сіз нені меңзеп тұрғаныңызды түсіндіре аласыз ба?
Dialogue: 0,0:19:47.16,0:19:50.40,Default,,0,0,0,,Жоқ, мен сізді төмен бағаладым.
Dialogue: 0,0:19:51.20,0:19:52.63,Default,,0,0,0,,Бұл химиялық тұман
Dialogue: 0,0:19:52.96,0:19:56.76,Default,,0,0,0,,Органдарды трансплантациялау кезінде қолданылатын иммуносупрессанттың түрі
Dialogue: 0,0:19:57.56,0:19:59.46,Default,,0,0,0,,Мақсаты Т жасушаларын бақылау.
Dialogue: 0,0:20:00.10,0:20:02.76,Default,,0,0,0,,Ұзақ уақыт темекі шегудің жанама әсері
Dialogue: 0,0:20:03.10,0:20:07.73,Default,,0,0,0,,Мидағы гипоталамус маңызды аминқышқылдарын қабылдаудан басқа амалы жоқ.
Dialogue: 0,0:20:07.80,0:20:09.40,Default,,0,0,0,,Бұйрықтар шығаруды жалғастырыңыз.
Dialogue: 0,0:20:09.66,0:20:11.13,Default,,0,0,0,,Және солай ма?
Dialogue: 0,0:20:11.50,0:20:12.16,Default,,0,0,0,,О
Dialogue: 0,0:20:12.23,0:20:15.40,Default,,0,0,0,,Кейде мен сияқты адамдар аш болмайды.
Dialogue: 0,0:20:15.60,0:20:18.60,Default,,0,0,0,,Тек мидың разрядын басқара алатындар
Dialogue: 0,0:20:19.60,0:20:20.70,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:20:21.30,0:20:22.73,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:23.10,0:20:25.56,Default,,0,0,0,,Неліктен оған химиялық тұман әсер етпейді?
Dialogue: 0,0:20:26.16,0:20:28.76,Default,,0,0,0,,Мен табиғи миметикалық адаммын.
Dialogue: 0,0:20:29.30,0:20:30.30,Default,,0,0,0,,Еліктеу қабілеті?
Dialogue: 0,0:20:32.86,0:20:36.03,Default,,0,0,0,,Енді на ah
Dialogue: 0,0:20:36.53,0:20:39.80,Default,,0,0,0,,Жеке тұлғаңыз бен мақсатыңызға жауап беріңіз
Dialogue: 0,0:20:40.60,0:20:42.83,Default,,0,0,0,,Және оның Каедені тартуға тырысуының себебі.
Dialogue: 0,0:20:43.33,0:20:44.30,Default,,0,0,0,,Менікі не?
Dialogue: 0,0:20:46.23,0:20:47.26,Default,,0,0,0,,Жауабы
Dialogue: 0,0:20:48.40,0:20:51.60,Default,,0,0,0,,Адамзат Алджерноннан шыққан.
Dialogue: 0,0:20:51.73,0:20:55.63,Default,,0,0,0,,Бұл құтылмас тағдыр, бірақ біз
Dialogue: 0,0:20:56.03,0:21:00.06,Default,,0,0,0,,-ги гу ех ах -ах аа
Dialogue: 0,0:21:00.20,0:21:00.73,Default,,0,0,0,,Каэде
Dialogue: 0,0:21:02.36,0:21:03.06,Default,,0,0,0,,U га
Dialogue: 0,0:21:09.76,0:21:11.96,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:21:13.06,0:21:14.66,Default,,0,0,0,,Беттермен Неліктен?
Dialogue: 0,0:21:15.33,0:21:17.63,Default,,0,0,0,,Limipid Channel бұл аймаққа жете алмайтынына көз жеткізіңіз.
Dialogue: 0,0:21:17.66,0:21:20.40,Default,,0,0,0,,Аморфты туындылардан жасалған тосқауыл орнатылуы керек еді.
Dialogue: 0,0:21:21.43,0:21:21.90,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:21:23.56,0:21:24.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:28.93,0:21:31.10,Default,,0,0,0,,Кедергілер бізге жете алмайды.
Dialogue: 0,0:21:32.13,0:21:33.16,Default,,0,0,0,,пектофораза
Dialogue: 0,0:21:34.20,0:21:34.86,Default,,0,0,0,,Фраум
Dialogue: 0,0:21:36.80,0:21:39.33,Default,,0,0,0,,Гухаа аа аа аа аа аа
Dialogue: 0,0:21:41.03,0:21:46.03,Default,,0,0,0,,Тимустан шығарылатын иммундық бөлшектер тамаша Т жасушалары болып табылады.
Dialogue: 0,0:21:46.76,0:21:48.16,Default,,0,0,0,,Әлі басқаша.
Dialogue: 0,0:21:48.50,0:21:52.36,Default,,0,0,0,,Бізді өлтірген Беттерман емес сияқты.
Dialogue: 0,0:21:52.66,0:21:53.33,Default,,0,0,0,,Гуха
Dialogue: 0,0:22:02.13,0:22:05.10,Default,,0,0,0,,Бодайджу Мен үмітті қорғауға барамын
Dialogue: 0,0:22:05.76,0:22:09.20,Default,,0,0,0,,Түсіндім, мен Forte жемісін алдым.
Dialogue: 0,0:22:10.40,0:22:12.13,Default,,0,0,0,,Мен мұны ескі Пачираға апарамын.
Dialogue: 0,0:22:13.13,0:22:14.30,Default,,0,0,0,,Маған бәрібір, Ламия.
Dialogue: 0,0:22:16.63,0:22:17.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:22.60,0:22:24.10,Default,,0,0,0,,Бұл зұлым рух
Dialogue: 0,0:22:25.86,0:22:26.76,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:22:29.23,0:22:29.93,Default,,0,0,0,,Канкел
Dialogue: 0,0:22:35.50,0:22:48.20,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:48.80,0:22:54.80,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:55.33,0:23:02.50,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:02.76,0:23:06.06,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:06.40,0:23:09.53,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:09.63,0:23:12.96,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:13.16,0:23:16.40,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:18.36,0:23:28.03,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:28.30,0:23:38.10,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:38.83,0:23:49.93,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:59.50,0:24:03.70,Default,,0,0,0,,Жақсы қыз болып өтірік айту
Dialogue: 0,0:24:04.30,0:24:06.13,Default,,0,0,0,,Мен енді көре алмаймын
Dialogue: 0,0:24:06.73,0:24:08.43,Default,,0,0,0,,Нағыз мен
Dialogue: 0,0:24:09.60,0:24:12.70,Default,,0,0,0,,Өзіңізді шақыратын сіз
Dialogue: 0,0:24:13.36,0:24:16.46,Default,,0,0,0,,Өтірік айтасың
Dialogue: 0,0:24:17.50,0:24:20.70,Default,,0,0,0,,Тербеліп, дірілдеп шығады.
Dialogue: 0,0:24:22.00,0:24:23.96,Default,,0,0,0,,Сіздің көзіңізде
Dialogue: 0,0:24:25.00,0:24:26.50,Default,,0,0,0,,тесу
Dialogue: 0,0:24:28.00,0:24:34.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
