Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.96,0:00:17.93,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:00:19.20,0:00:21.16,Default,,0,0,0,,Ақыры келді
Dialogue: 0,0:00:22.00,0:00:24.46,Default,,0,0,0,,Жақында келеді Ол жақында келеді
Dialogue: 0,0:00:59.03,0:00:59.70,Default,,0,0,0,,Жабу
Dialogue: 0,0:01:03.76,0:01:13.36,Default,,0,0,0,,Көгілдір жылжымалы тыныштық
Dialogue: 0,0:01:15.63,0:01:23.63,Default,,0,0,0,,Күміс қайықтың жүзуі
Dialogue: 0,0:01:25.56,0:01:34.03,Default,,0,0,0,,Аты жоқ адамдар
Dialogue: 0,0:01:37.33,0:01:45.13,Default,,0,0,0,,Қай жерде теңселіп жүрсің?
Dialogue: 0,0:01:48.56,0:01:57.36,Default,,0,0,0,,Қайтадан оянған рух
Dialogue: 0,0:01:57.83,0:02:06.03,Default,,0,0,0,,Жанға бағыт беру
Dialogue: 0,0:02:07.73,0:02:17.33,Default,,0,0,0,,Аригатово Юменокакера
Dialogue: 0,0:02:17.56,0:02:29.46,Default,,0,0,0,,Ағыспен қозғалма...
Dialogue: 0,0:02:33.13,0:02:36.86,Default,,0,0,0,,Кагоме Кагоме
Dialogue: 0,0:02:37.26,0:02:41.06,Default,,0,0,0,,Тордағы құс
Dialogue: 0,0:02:41.40,0:02:45.00,Default,,0,0,0,,Ол қашан шығады?
Dialogue: 0,0:02:45.53,0:02:49.33,Default,,0,0,0,,Таң атқан түні
Dialogue: 0,0:02:49.66,0:02:53.46,Default,,0,0,0,,Тырна мен тасбақа тайып кетті.
Dialogue: 0,0:02:53.53,0:02:57.53,Default,,0,0,0,,Бұл артқы жағының алдыңғы жағы.
Dialogue: 0,0:02:58.06,0:02:59.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:02.66,0:03:03.86,Default,,0,0,0,,Эй, дұрыс түсіндің бе?
Dialogue: 0,0:03:05.53,0:03:07.60,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:03:08.63,0:03:10.83,Default,,0,0,0,,Барлығы қайда?
Dialogue: 0,0:03:11.80,0:03:14.13,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:03:14.63,0:03:16.80,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:03:17.16,0:03:19.16,Default,,0,0,0,,Оны алып кетіңіз
Dialogue: 0,0:03:19.76,0:03:21.33,Default,,0,0,0,,Алып тастаңыз
Dialogue: 0,0:03:21.40,0:03:22.00,Default,,0,0,0,,Га
Dialogue: 0,0:03:25.86,0:03:27.13,Default,,0,0,0,,Қайырлы таң Каэде
Dialogue: 0,0:03:27.96,0:03:32.33,Default,,0,0,0,,Шо мен түс көрдім
Dialogue: 0,0:03:33.26,0:03:33.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:34.86,0:03:37.26,Default,,0,0,0,,Мүмкін бұл түс көргеннен басқа нәрсе шығар
Dialogue: 0,0:03:37.73,0:03:38.83,Default,,0,0,0,,Фу Каэде
Dialogue: 0,0:03:39.73,0:03:41.23,Default,,0,0,0,,Мен де ұйықтай алмадым.
Dialogue: 0,0:03:42.33,0:03:45.86,Default,,0,0,0,,Менің еліктеу қабілетіме бір нәрсе кедергі келтіруде.
Dialogue: 0,0:03:46.83,0:03:49.36,Default,,0,0,0,,Оның үстіне ол күннен күнге күшейіп келеді.
Dialogue: 0,0:03:51.60,0:03:54.70,Default,,0,0,0,,Бұл шулы, цикаданың дауысы
Dialogue: 0,0:03:57.93,0:04:00.33,Default,,0,0,0,,Бұл жерде Эноден жұмыс істейді
Dialogue: 0,0:04:00.86,0:04:03.06,Default,,0,0,0,,Камакураға бірінші рет келіп тұрсыз ба?
Dialogue: 0,0:04:03.46,0:04:06.60,Default,,0,0,0,,Не? О, жоқ хаха Айтпақшы, түскі асқа не істейміз?
Dialogue: 0,0:04:07.46,0:04:08.83,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:04:09.10,0:04:10.50,Default,,0,0,0,,...
Dialogue: 0,0:04:10.73,0:04:14.26,Default,,0,0,0,,Эносиманың жанында жақсы жапон соба мейрамханасы бар сияқты.
Dialogue: 0,0:04:14.80,0:04:15.90,Default,,0,0,0,,Шигараки, солай ма?
Dialogue: 0,0:04:16.30,0:04:16.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:17.66,0:04:18.90,Default,,0,0,0,,Соба мейрамханасының атауы
Dialogue: 0,0:04:19.50,0:04:21.33,Default,,0,0,0,,Ах, мм.
Dialogue: 0,0:04:21.93,0:04:23.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.66,0:04:24.53,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:25.23,0:04:27.96,Default,,0,0,0,,О, жоқ, бұл Шинраку деген дүкен.
Dialogue: 0,0:04:28.43,0:04:31.76,Default,,0,0,0,,«шинраку» деп жазылып, «шигараки» деп оқылады.
Dialogue: 0,0:04:31.83,0:04:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.43,0:04:37.93,Default,,0,0,0,,Нхахаха Дұрыс Шигараки Шигараки олай айтпа хаха хахаха
Dialogue: 0,0:04:37.96,0:04:41.33,Default,,0,0,0,,Жоқ, бәрібір ыстық, хахаха
Dialogue: 0,0:04:45.26,0:04:48.20,Default,,0,0,0,,Мордиварп туралы аралық есеп келді.
Dialogue: 0,0:04:49.00,0:04:51.03,Default,,0,0,0,,Бөліп, түсіндірейін.
Dialogue: 0,0:04:51.80,0:04:53.83,Default,,0,0,0,,Күрсін, бірақ ыстық.
Dialogue: 0,0:04:54.03,0:04:56.63,Default,,0,0,0,,Биыл аномальды ауа райының үздіксіз шабуылы
Dialogue: 0,0:04:56.86,0:05:00.36,Default,,0,0,0,,Екі ай бұрын тұман болды емес пе?
Dialogue: 0,0:05:01.03,0:05:05.00,Default,,0,0,0,,Сара-чан, ауырып қалсаң, маған айтудан тартынба.
Dialogue: 0,0:05:05.80,0:05:08.13,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:05:09.03,0:05:10.43,Default,,0,0,0,,бастайық
Dialogue: 0,0:05:11.53,0:05:14.06,Default,,0,0,0,,Куширо оқиғасынан төрт жыл бұрын
Dialogue: 0,0:05:14.86,0:05:17.53,Default,,0,0,0,,Барлығына таныс Үндістанның Аджанта үңгірлері
Dialogue: 0,0:05:18.23,0:05:21.26,Default,,0,0,0,,Мен сізге жаңа шындықты кезең-кезеңімен айтамын.
Dialogue: 0,0:05:23.03,0:05:25.30,Default,,0,0,0,,Тергеу тобы, оның ішінде Хинокидің отбасы
Dialogue: 0,0:05:25.70,0:05:28.13,Default,,0,0,0,,Жер асты қирандыларында жоғалып кеткеннен кейін көп ұзамай
Dialogue: 0,0:05:28.76,0:05:32.66,Default,,0,0,0,,Іздестіру жұмыстарына жергілікті полициямен бірге бір адам қатысқан.
Dialogue: 0,0:05:34.76,0:05:38.13,Default,,0,0,0,,BPL Raw Food Research институтының президенті
Dialogue: 0,0:05:39.16,0:05:40.23,Default,,0,0,0,,Бұл доктор Умезаки.
Dialogue: 0,0:05:41.70,0:05:44.60,Default,,0,0,0,,Әрине, дәрігер тек жерде күтіп тұрды.
Dialogue: 0,0:05:45.26,0:05:47.96,Default,,0,0,0,,Полицейлер қайтып келгенде тауып алған анимус гүлі.
Dialogue: 0,0:05:48.43,0:05:50.36,Default,,0,0,0,,Кейінірек BPL-ге қайтарылды
Dialogue: 0,0:05:51.86,0:05:53.30,Default,,0,0,0,,Және көп ұзамай
Dialogue: 0,0:05:53.83,0:05:57.66,Default,,0,0,0,,Полицейлер бір-бірін өлтіріп, барлығы өлі табылды.
Dialogue: 0,0:05:58.50,0:05:59.06,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.70,0:06:03.50,Default,,0,0,0,,Аутопсия нәтижелері жүйке тінінің қалыптан тыс дамуын растады
Dialogue: 0,0:06:05.03,0:06:09.40,Default,,0,0,0,,Бірнеше жылдар бойы әлемнің әртүрлі бөліктерінде орын алып жатқан жаппай өлтірулердің себебі
Dialogue: 0,0:06:09.76,0:06:13.16,Default,,0,0,0,,Бұған мидағы өзгерістер себеп болуы мүмкін бе?
Dialogue: 0,0:06:14.23,0:06:16.70,Default,,0,0,0,,Жұмысты құрастырған зерттеушінің атымен аталған
Dialogue: 0,0:06:17.30,0:06:20.80,Default,,0,0,0,,Бұл синдромдар бұдан былай Алджернон деп аталды.
Dialogue: 0,0:06:21.46,0:06:21.93,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.50,0:06:26.80,Default,,0,0,0,,Сонда бұл зерттеуші қазір Мордиварпта жұмыс істейді ме?
Dialogue: 0,0:06:27.30,0:06:29.20,Default,,0,0,0,,Жоқ, ол қайтыс болды.
Dialogue: 0,0:06:29.96,0:06:30.76,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:06:31.33,0:06:32.46,Default,,0,0,0,,Алджернонда?
Dialogue: 0,0:06:33.10,0:06:33.56,Default,,0,0,0,,Иә
Dialogue: 0,0:06:33.80,0:06:34.50,Default,,0,0,0,,О
Dialogue: 0,0:06:35.73,0:06:37.00,Default,,0,0,0,,Ендеше, негізгі мәселемізге қайта оралайық.
Dialogue: 0,0:06:37.83,0:06:41.80,Default,,0,0,0,,Доктор Умезаки BPL-де анимус гүлдеріне зерттеу жүргізді.
Dialogue: 0,0:06:42.40,0:06:43.76,Default,,0,0,0,,Бұл гүл жеміс бергенде
Dialogue: 0,0:06:44.16,0:06:49.36,Default,,0,0,0,,Ол аминқышқылдарының L-түрінен D-түріне ауысу қасиеті бар екенін ашты.
Dialogue: 0,0:06:49.90,0:06:51.56,Default,,0,0,0,,L түрі және D түрі?
Dialogue: 0,0:06:52.33,0:06:53.80,Default,,0,0,0,,Оптикалық изомерлер деп те аталады
Dialogue: 0,0:06:54.33,0:06:57.96,Default,,0,0,0,,Барлық органикалық қосылыстар симметриялы құрылымға ие.
Dialogue: 0,0:06:58.83,0:07:01.60,Default,,0,0,0,,Алайда жердегі барлық тіршілік иелері
Dialogue: 0,0:07:02.00,0:07:02.73,Default,,0,0,0,,Тек бір жағында
Dialogue: 0,0:07:03.70,0:07:05.16,Default,,0,0,0,,L типті аминқышқылдарынан жасалған
Dialogue: 0,0:07:05.86,0:07:09.13,Default,,0,0,0,,Оптикалық изомер болып табылатын D типті амин қышқылын берсек те,
Dialogue: 0,0:07:09.50,0:07:10.83,Default,,0,0,0,,Оны пайдалануға тырыспаңыз
Dialogue: 0,0:07:11.63,0:07:16.60,Default,,0,0,0,,Доктор Умезаки - анимустың амин қышқылына айналуы кезінде түзілетін ерекше фермент.
Dialogue: 0,0:07:17.06,0:07:19.46,Default,,0,0,0,,Теломераза сәтті шығарылды
Dialogue: 0,0:07:20.26,0:07:23.43,Default,,0,0,0,,Жасушаның бөліну саны организмнің өмір сүру ұзақтығын анықтайды
Dialogue: 0,0:07:24.06,0:07:28.50,Default,,0,0,0,,Өмір сүру ұзақтығы ДНҚ түйіндері болып табылатын теломерлердің төзімділігімен анықталады.
Dialogue: 0,0:07:29.13,0:07:32.73,Default,,0,0,0,,Ал төзімділік теломеразамен толықтырылады.
Dialogue: 0,0:07:33.33,0:07:34.26,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:07:34.86,0:07:39.00,Default,,0,0,0,,Сонымен, жемісті жеп, түрлендіретін Беттермен дегеніміз не?
Dialogue: 0,0:07:41.63,0:07:42.86,Default,,0,0,0,,Сомний
Dialogue: 0,0:07:44.00,0:07:44.63,Default,,0,0,0,,Гари Гари
Dialogue: 0,0:07:44.80,0:07:46.73,Default,,0,0,0,,Уау
Dialogue: 0,0:07:51.10,0:07:52.83,Default,,0,0,0,,Буах
Dialogue: 0,0:07:53.46,0:07:54.23,Default,,0,0,0,,Иа ой
Dialogue: 0,0:07:55.03,0:07:57.96,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:08:05.00,0:08:06.60,Default,,0,0,0,,Гуар
Dialogue: 0,0:08:08.73,0:08:09.30,Default,,0,0,0,,Хиноки?
Dialogue: 0,0:08:09.60,0:08:10.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.76,0:08:12.66,Default,,0,0,0,,Біз Эносимаға жеттік
Dialogue: 0,0:08:14.20,0:08:16.73,Default,,0,0,0,,Беттерман трансформация катализаторы ретінде
Dialogue: 0,0:08:17.00,0:08:19.36,Default,,0,0,0,,Мен олардың анимус жемісін жейтінін білемін.
Dialogue: 0,0:08:20.13,0:08:23.63,Default,,0,0,0,,Сонымен қатар олардың денесін құрайтын аминқышқылдары
Dialogue: 0,0:08:24.00,0:08:28.63,Default,,0,0,0,,Сондай-ақ біздің оптикалық изомерлер екендігіміз анықталды, олар айна бейнесі болып табылады.
Dialogue: 0,0:08:30.26,0:08:31.43,Default,,0,0,0,,Рычаг дегеніміз не?
Dialogue: 0,0:08:32.13,0:08:35.76,Default,,0,0,0,,Олар амин қышқылдарын тек анимус жемісінен ала алады.
Dialogue: 0,0:08:36.33,0:08:38.43,Default,,0,0,0,,Ал анимус гүлі
Dialogue: 0,0:08:39.06,0:08:40.76,Default,,0,0,0,,Адамдарды питомник ретінде пайдалану арқылы өсіңіз
Dialogue: 0,0:08:42.93,0:08:44.36,Default,,0,0,0,,Яғни, Беттерман
Dialogue: 0,0:08:45.13,0:08:46.93,Default,,0,0,0,,Бұл адамдарды жейді дегенді білдіре ме?
Dialogue: 0,0:08:47.26,0:08:49.73,Default,,0,0,0,,Ха, мен жедім, жедім.
Dialogue: 0,0:08:49.96,0:08:52.76,Default,,0,0,0,,Мен үш үлкен кесек жей алдым.
Dialogue: 0,0:08:52.86,0:08:57.03,Default,,0,0,0,,Жақсы, дәмді собаны қалағаныңызша жеуге болады, солай ма?
Dialogue: 0,0:08:57.56,0:09:01.20,Default,,0,0,0,,Мен солай деп ойлаймын, бірақ бұрынғыға қарағанда хош иісі азырақ сияқты.
Dialogue: 0,0:09:01.50,0:09:02.10,Default,,0,0,0,,Бұлп
Dialogue: 0,0:09:03.00,0:09:05.80,Default,,0,0,0,,Кейта: Ерлер жалаңаштауда әлсіз, бірақ
Dialogue: 0,0:09:06.20,0:09:08.50,Default,,0,0,0,,Әйелдердің көңіл-күйге қатысты әлсіздігі бар.
Dialogue: 0,0:09:10.40,0:09:12.26,Default,,0,0,0,,Атмосфера құруды ұмытпаңыз
Dialogue: 0,0:09:14.83,0:09:17.70,Default,,0,0,0,,Хаа Хиноки Ивая Иваяға кірейік
Dialogue: 0,0:09:18.56,0:09:19.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.66,0:09:25.26,Default,,0,0,0,,-Эношима Ивая... -Үңгірлер романтикалық.
Dialogue: 0,0:09:25.56,0:09:29.50,Default,,0,0,0,,Менің ойымша, бұл маған Үндістанды еске түсіреді.
Dialogue: 0,0:09:29.70,0:09:31.16,Default,,0,0,0,,Не? Үндістан?
Dialogue: 0,0:09:32.56,0:09:34.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:34.50,0:09:36.50,Default,,0,0,0,,Жоқ, қазір бәрі жақсы.
Dialogue: 0,0:09:37.26,0:09:40.40,Default,,0,0,0,,Мен өз отбасымды мәңгілікке уайымдай алмаймын.
Dialogue: 0,0:09:44.46,0:09:45.13,Default,,0,0,0,,-a -hii
Dialogue: 0,0:09:46.80,0:09:48.66,Default,,0,0,0,,Қош келдіңіздер, жас жұбайлар
Dialogue: 0,0:09:49.10,0:09:53.06,Default,,0,0,0,,А-а-а, біз әлі мектеп оқушысымыз.
Dialogue: 0,0:09:53.56,0:09:54.76,Default,,0,0,0,,Ах, кешіріңіз.
Dialogue: 0,0:09:55.60,0:09:58.00,Default,,0,0,0,,Болашақ жас жұбайлар үшін
Dialogue: 0,0:09:58.53,0:10:03.20,Default,,0,0,0,,Ғажайып сəйкестік сүйкімділігі туралы не деуге болады?
Dialogue: 0,0:10:03.73,0:10:04.73,Default,,0,0,0,,Сәйкестік?
Dialogue: 0,0:10:06.13,0:10:06.60,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:10:06.80,0:10:07.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.76,0:10:08.40,Default,,0,0,0,,Ниннн
Dialogue: 0,0:10:08.76,0:10:10.86,Default,,0,0,0,,О, бұл ақылсыз.
Dialogue: 0,0:10:11.26,0:10:11.86,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:10:12.46,0:10:12.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.80,0:10:15.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:19.63,0:10:20.76,Default,,0,0,0,,Ракшаса
Dialogue: 0,0:10:29.90,0:10:32.13,Default,,0,0,0,,Кейта Кәмпит деп атаған қыз
Dialogue: 0,0:10:34.36,0:10:37.80,Default,,0,0,0,,Ол доктор Умезакидің келесі ұрпағы жетілдірілген адамы.
Dialogue: 0,0:10:37.90,0:10:39.80,Default,,0,0,0,,Бұл эксперименттен өтіп жатқан клон болды.
Dialogue: 0,0:10:41.06,0:10:43.80,Default,,0,0,0,,Адамгершілік жағынан мұндай нәрсеге рұқсат па?
Dialogue: 0,0:10:44.06,0:10:44.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:45.96,0:10:48.00,Default,,0,0,0,,Үндістаннан оралған доктор Умезакиге
Dialogue: 0,0:10:48.50,0:10:51.36,Default,,0,0,0,,Ол Альджернон симптомдары бұрыннан болған болуы керек.
Dialogue: 0,0:10:52.00,0:10:52.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.56,0:10:57.66,Default,,0,0,0,,Алджернон гүл феромондарынан болатын ауру емес пе?
Dialogue: 0,0:10:58.16,0:10:59.76,Default,,0,0,0,,Симптомдары өте ұқсас болғанымен
Dialogue: 0,0:11:00.16,0:11:04.23,Default,,0,0,0,,Бұрынғы зардап шеккендерден феромон негізіндегі химиялық заттар анықталмаған.
Dialogue: 0,0:11:05.83,0:11:07.66,Default,,0,0,0,,Сондай-ақ, доктор Умезаки
Dialogue: 0,0:11:07.80,0:11:11.06,Default,,0,0,0,,Сіз жай ғана Алджернон биінің құрбанысыз ба?
Dialogue: 0,0:11:12.40,0:11:14.63,Default,,0,0,0,,Бөлім бұл туралы қорытынды жасайды
Dialogue: 0,0:11:15.36,0:11:18.60,Default,,0,0,0,,Сонымен, Алджернонның шынайы тұлғасы белгісіз болып қалады ма?
Dialogue: 0,0:11:19.06,0:11:19.53,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:11:20.06,0:11:24.30,Default,,0,0,0,,Беттерман да BPL жасаған жетілдірілген адам емес пе?
Dialogue: 0,0:11:24.83,0:11:25.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:26.70,0:11:31.46,Default,,0,0,0,,Бетермендер мыңдаған жылдар бойы олардың өмір сүргендігі туралы дәлелдер қалдырды.
Dialogue: 0,0:11:33.06,0:11:34.30,Default,,0,0,0,,Ал өзіміз
Dialogue: 0,0:11:34.80,0:11:37.30,Default,,0,0,0,,Олар көпше екенін растады
Dialogue: 0,0:11:39.60,0:11:43.06,Default,,0,0,0,,Қанша жақсы еркек бар?
Dialogue: 0,0:11:53.43,0:11:55.36,Default,,0,0,0,,Ламияны тапты
Dialogue: 0,0:12:02.30,0:12:07.16,Default,,0,0,0,,Кей-чан, мен барғым келетін жер бар.
Dialogue: 0,0:12:08.03,0:12:08.66,Default,,0,0,0,,Мен шын мәнінде бұны киюім керек пе?
Dialogue: 0,0:12:11.83,0:12:12.96,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:12:13.50,0:12:16.26,Default,,0,0,0,,Сен қаншаға барасың, Хиноки?
Dialogue: 0,0:12:16.43,0:12:17.43,Default,,0,0,0,,Сәл әрі қарай
Dialogue: 0,0:12:17.93,0:12:19.76,Default,,0,0,0,,Қазірдің өзінде бұлтты бола бастады.
Dialogue: 0,0:12:20.30,0:12:22.83,Default,,0,0,0,,Душ келе жатқан сияқты, бірақ жақсы бола ма?
Dialogue: 0,0:12:23.46,0:12:27.60,Default,,0,0,0,,Беттерман Хиноки-санға көмектесуге келеді.
Dialogue: 0,0:12:28.33,0:12:30.33,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:12:30.76,0:12:34.30,Default,,0,0,0,,Бірақ ішімнен жасырын оқы
Dialogue: 0,0:12:34.73,0:12:38.70,Default,,0,0,0,,Мен әрқашан Хиноки-санның жүрген жерін іздеймін.
Dialogue: 0,0:12:40.93,0:12:44.50,Default,,0,0,0,,Жоқ, жаңбыр жауып тұр ғой.
Dialogue: 0,0:12:44.53,0:12:47.00,Default,,0,0,0,,Аа, мұнда не болып жатыр?
Dialogue: 0,0:12:49.66,0:12:52.50,Default,,0,0,0,,Менің… үйім
Dialogue: 0,0:12:58.36,0:13:00.46,Default,,0,0,0,,Анимус гүлдерінің көп мөлшерін алыңыз.
Dialogue: 0,0:13:00.90,0:13:03.53,Default,,0,0,0,,Доктор Умезаки ең жақсы тағамды іздеді.
Dialogue: 0,0:13:03.86,0:13:06.63,Default,,0,0,0,,Өзіңізді феромон генераторының ортасына қойыңыз
Dialogue: 0,0:13:07.13,0:13:09.20,Default,,0,0,0,,Көптеген биологиялық организмдерді пайдалану
Dialogue: 0,0:13:09.53,0:13:11.56,Default,,0,0,0,,Күлкілі әрекетті бастады
Dialogue: 0,0:13:13.50,0:13:17.96,Default,,0,0,0,,Алайда, Аджантаға жіберілген күшейтілген адамдарға Алджернон жұқтырған.
Dialogue: 0,0:13:18.40,0:13:22.06,Default,,0,0,0,,Достар бірін-бірі өлтірді, бір адамнан басқаның бәрі қалды
Dialogue: 0,0:13:24.73,0:13:28.63,Default,,0,0,0,,Олардың біреуі әйтеуір сауығып кеткен сияқты, бірақ оның өмірі немесе өлімі әзірге белгісіз.
Dialogue: 0,0:13:31.23,0:13:32.53,Default,,0,0,0,,Доктор Умезакидің қате есептеуі болды
Dialogue: 0,0:13:32.93,0:13:36.60,Default,,0,0,0,,Жетілдірілген адамдарды бақылау үшін жасалған бактериялық тіршілік формасы.
Dialogue: 0,0:13:36.93,0:13:40.26,Default,,0,0,0,,Керісінше, ол жақсартылған адамдарда жетіспейтін SOD т.б. орнын толтырады.
Dialogue: 0,0:13:40.76,0:13:43.83,Default,,0,0,0,,Бұл сіздің эгоңызды оятып, оған қарсы шығуыңызға себеп болды ма?
Dialogue: 0,0:13:51.66,0:13:53.80,Default,,0,0,0,,Анимус гүлдері адамдарды питомник ретінде пайдаланады
Dialogue: 0,0:13:54.23,0:13:58.20,Default,,0,0,0,,Доктор Умезаки олардың Аджанта үңгірлері сияқты орталарда көптеп өсетінін білді.
Dialogue: 0,0:13:58.70,0:14:02.53,Default,,0,0,0,,Адамдарды тарту және галлюцинацияны тудыру үшін ультрадыбысты шығарыңыз
Dialogue: 0,0:14:02.83,0:14:04.40,Default,,0,0,0,,Жіберілген Бегемот
Dialogue: 0,0:14:06.03,0:14:08.20,Default,,0,0,0,,Аджантадағы жер астында көрінетін жасыл жарық
Dialogue: 0,0:14:08.53,0:14:10.93,Default,,0,0,0,,Бегемоттың негізгі тағамы болып табылатын люминесцентті саңырауқұлақтар
Dialogue: 0,0:14:11.90,0:14:16.20,Default,,0,0,0,,Ол тез өседі және келесі ұрпақ тағамы ретінде әзірленді.
Dialogue: 0,0:14:17.73,0:14:20.73,Default,,0,0,0,,Ал жиналғандар жерасты өткелін пайдаланды.
Dialogue: 0,0:14:21.33,0:14:25.76,Default,,0,0,0,,Ол тасымалдаушымен Рэнд медициналық орталығына, трансфер станциясына жеткізілді.
Dialogue: 0,0:14:27.80,0:14:31.03,Default,,0,0,0,,Мұндағы қызметкерлер BPL зерттеушілерімен бірдей.
Dialogue: 0,0:14:31.66,0:14:37.16,Default,,0,0,0,,Оны нейротоксин қолданатын имплант деп аталатын жәндік өз қалауы бойынша басқарды.
Dialogue: 0,0:14:43.56,0:14:46.03,Default,,0,0,0,,Медициналық пункт адамдарды жинайды
Dialogue: 0,0:14:46.23,0:14:49.70,Default,,0,0,0,,Саламандр өндіретін арнайы сұйықтықта сақтау арқылы.
Dialogue: 0,0:14:50.06,0:14:52.43,Default,,0,0,0,,бастап толық питомникке дейін.
Dialogue: 0,0:14:54.50,0:14:58.63,Default,,0,0,0,,Бірақ олар оны BPL-ге тым тез ауыстырғандықтан шығар?
Dialogue: 0,0:14:58.83,0:15:01.20,Default,,0,0,0,,Жүк кемесін пайдалану кері әсер етті
Dialogue: 0,0:15:02.53,0:15:06.83,Default,,0,0,0,,Теңіз тағамы ретінде ондаған түрлерді синтездеу арқылы жасалған
Dialogue: 0,0:15:06.86,0:15:10.13,Default,,0,0,0,,Мен Левиді де пайдаланудан басқа амалым жоқ жағдайға тап болдым.
Dialogue: 0,0:15:12.76,0:15:14.96,Default,,0,0,0,,Олар бізді соншалықты сүймейтін деп ойласа керек.
Dialogue: 0,0:15:16.16,0:15:18.23,Default,,0,0,0,,Олар тіпті жәндіктермен қорқытуға тырысты.
Dialogue: 0,0:15:19.86,0:15:22.13,Default,,0,0,0,,Қалғандары мүлде тәртіпсіз болды.
Dialogue: 0,0:16:12.60,0:16:16.86,Default,,0,0,0,,Перне
Dialogue: 0,0:16:17.30,0:16:19.26,Default,,0,0,0,,Гуоорн
Dialogue: 0,0:16:46.10,0:16:47.16,Default,,0,0,0,,Гуооун
Dialogue: 0,0:17:02.03,0:17:05.46,Default,,0,0,0,,Бірақ ол енді үйіне бармайды.
Dialogue: 0,0:17:06.30,0:17:10.76,Default,,0,0,0,,Осы қарқынмен бәріміз Алджернонда өлеміз.
Dialogue: 0,0:17:11.70,0:17:12.90,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:17:13.86,0:17:17.06,Default,,0,0,0,,Мен соңғы болып тұрсам да
Dialogue: 0,0:17:22.76,0:17:27.66,Default,,0,0,0,,Мен мұнда 5 жасымда отбасымның маңайынан көшіп келген сияқтымын.
Dialogue: 0,0:17:28.23,0:17:31.66,Default,,0,0,0,,Мен бұл вилла деп ойладым. Бұл вокзалдан біршама қашықтықта.
Dialogue: 0,0:17:32.16,0:17:35.13,Default,,0,0,0,,Әкемнің университетіне жақын болғандықтан осы жерді таңдадым деп ойлаймын.
Dialogue: 0,0:17:35.76,0:17:39.13,Default,,0,0,0,,А, Хинокидің ата-анасы университет профессоры ма?
Dialogue: 0,0:17:40.00,0:17:41.20,Default,,0,0,0,,Ха, неге?
Dialogue: 0,0:17:41.63,0:17:46.60,Default,,0,0,0,,Отбасыңды уайымдай алмайсың деп айта бересің.
Dialogue: 0,0:17:47.20,0:17:50.23,Default,,0,0,0,,Менің ойымша, сіз мұнда отбасыңыз қайтып келеді деп ойлағандықтан келдіңіз.
Dialogue: 0,0:17:50.80,0:17:52.80,Default,,0,0,0,,Бұл Марио-нии-чан ба?
Dialogue: 0,0:17:53.66,0:17:55.93,Default,,0,0,0,,Сізбен кездесе бастағаным үшін кешіріңіз.
Dialogue: 0,0:17:56.23,0:17:57.80,Default,,0,0,0,,туралы алаңдамаңыз
Dialogue: 0,0:17:58.36,0:18:01.73,Default,,0,0,0,,Мен Хинокиге отбасын табуға көмектесемін деп уәде бердім.
Dialogue: 0,0:18:02.33,0:18:05.30,Default,,0,0,0,,Бұл күн Хиноки үшін кездейсоқ болуы мүмкін.
Dialogue: 0,0:18:05.53,0:18:06.66,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:18:07.26,0:18:08.13,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:08.63,0:18:12.90,Default,,0,0,0,,Екі жылдан бері бармағаным үшін жалғыз келуге қорқамын.
Dialogue: 0,0:18:13.60,0:18:17.33,Default,,0,0,0,,Сондықтан мен Кей-чанды пайдаланбадым.
Dialogue: 0,0:18:18.00,0:18:20.70,Default,,0,0,0,,Бұлай ойлама\NМен
Dialogue: 0,0:18:21.46,0:18:22.96,Default,,0,0,0,,білемін
Dialogue: 0,0:18:23.43,0:18:27.13,Default,,0,0,0,,Сенің де маған сенім арта алатыныңды білгеніме қуаныштымын.
Dialogue: 0,0:18:27.76,0:18:29.43,Default,,0,0,0,,Мен оған көп сенемін.
Dialogue: 0,0:18:30.16,0:18:34.13,Default,,0,0,0,,Бүгінгі күн көңілді өтті.
Dialogue: 0,0:18:35.30,0:18:36.20,Default,,0,0,0,,Хиноки
Dialogue: 0,0:18:41.76,0:18:44.00,Default,,0,0,0,,Бұл несие қымбат.
Dialogue: 0,0:18:44.06,0:18:44.66,Default,,0,0,0,,Иә
Dialogue: 0,0:18:45.00,0:18:48.80,Default,,0,0,0,,Мына қыз, жақсы емес пе? Жақсы емес пе?
Dialogue: 0,0:18:48.83,0:18:53.23,Default,,0,0,0,,Әй, судья-сама, мені кешіріңіз, хехе.
Dialogue: 0,0:18:53.26,0:18:54.80,Default,,0,0,0,,Мен сені кешіремін хаха
Dialogue: 0,0:18:54.86,0:18:55.40,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:19:03.83,0:19:04.43,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:19:04.90,0:19:06.80,Default,,0,0,0,,Бұл қандай қоңырау?
Dialogue: 0,0:19:07.43,0:19:09.66,Default,,0,0,0,,Келе жатқан күн үшін
Dialogue: 0,0:19:10.30,0:19:13.70,Default,,0,0,0,,Енді бұл жерден көшпеген дұрыс.
Dialogue: 0,0:19:14.26,0:19:16.00,Default,,0,0,0,,Көлеңке жақындап келеді
Dialogue: 0,0:19:16.70,0:19:20.53,Default,,0,0,0,,Оның көлеңкесі – нағыз көлеңке
Dialogue: 0,0:19:39.46,0:19:42.00,Default,,0,0,0,,жалған, мүмкін емес
Dialogue: 0,0:19:42.56,0:19:43.83,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:19:45.80,0:19:48.36,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:19:51.00,0:19:52.80,Default,,0,0,0,,Иә Akamatsu Industries
Dialogue: 0,0:19:53.60,0:19:54.46,Default,,0,0,0,,Президент мырза?
Dialogue: 0,0:19:54.76,0:19:56.40,Default,,0,0,0,,Шо кетіп қалды.
Dialogue: 0,0:19:56.60,0:19:57.86,Default,,0,0,0,,Не?
Dialogue: 0,0:19:58.53,0:20:00.33,Default,,0,0,0,,Сіз сонда барасыз ба?
Dialogue: 0,0:20:00.83,0:20:03.86,Default,,0,0,0,,Қызық, бұл ыңғайлы дүкен бе?
Dialogue: 0,0:20:05.33,0:20:06.76,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:20:07.30,0:20:09.10,Default,,0,0,0,,Жинақтау
Dialogue: 0,0:20:14.40,0:20:17.73,Default,,0,0,0,,Бір нәрсе теңізді кесіп өтті
Dialogue: 0,0:20:19.10,0:20:21.56,Default,,0,0,0,,Жақын жерде
Dialogue: 0,0:20:22.23,0:20:24.50,Default,,0,0,0,,Үш қара көлеңке
Dialogue: 0,0:20:24.96,0:20:25.93,Default,,0,0,0,,Және
Dialogue: 0,0:20:33.03,0:20:36.83,Default,,0,0,0,,Forte қолданбасын екі рет пайдаланып жатқаныңызға сенімдісіз бе? Ламия
Dialogue: 0,0:20:37.93,0:20:41.30,Default,,0,0,0,,Сен оны атмосфера ағынынан сездің бе?
Dialogue: 0,0:20:41.96,0:20:43.00,Default,,0,0,0,,Барлығын білу
Dialogue: 0,0:20:43.16,0:20:46.86,Default,,0,0,0,,Бәрін басқаратын Пачира ақсақалымыздың бұйрығымен.
Dialogue: 0,0:20:47.30,0:20:48.80,Default,,0,0,0,,Мен келдім
Dialogue: 0,0:20:49.36,0:20:52.70,Default,,0,0,0,,Қанкелді қууға ниетіңіз жоқ сияқты.
Dialogue: 0,0:20:53.30,0:20:55.36,Default,,0,0,0,,Сіз айтып отырған Қаңкелді іздегенше.
Dialogue: 0,0:20:55.90,0:20:57.73,Default,,0,0,0,,Үмітімізді сақтау
Dialogue: 0,0:20:58.90,0:21:01.50,Default,,0,0,0,,Мен бұған басымдық беруім керек деп шештім.
Dialogue: 0,0:21:02.23,0:21:05.43,Default,,0,0,0,,Сіз Кәрі Пачираның өсиетін орындамаймын дейсіз бе?
Dialogue: 0,0:21:05.90,0:21:06.66,Default,,0,0,0,,Бодайджу
Dialogue: 0,0:21:07.60,0:21:09.73,Default,,0,0,0,,Қиындыққа ұшырайтын кез емес
Dialogue: 0,0:21:10.70,0:21:11.83,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:21:12.16,0:21:14.16,Default,,0,0,0,,пектофораза қара өрік
Dialogue: 0,0:21:16.86,0:21:18.33,Default,,0,0,0,,Мені құртасың ба?
Dialogue: 0,0:21:19.16,0:21:21.76,Default,,0,0,0,,Егер сіз мойынсұнбасаңыз, сіз ештеңе істей алмайсыз
Dialogue: 0,0:21:22.56,0:21:23.13,Default,,0,0,0,,Семе
Dialogue: 0,0:21:24.03,0:21:26.96,Default,,0,0,0,,Уайымдама, мен үмітті бақылаймын.
Dialogue: 0,0:21:27.76,0:21:28.36,Default,,0,0,0,,Ламия
Dialogue: 0,0:21:28.96,0:21:32.50,Default,,0,0,0,,Тұрбамның жемісімен жерленесің.
Dialogue: 0,0:21:34.43,0:21:34.90,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:21:36.70,0:21:38.03,Default,,0,0,0,,Гари Гари Гари Гари
Dialogue: 0,0:21:38.76,0:21:39.33,Default,,0,0,0,,Ха ха
Dialogue: 0,0:21:41.10,0:21:45.23,Default,,0,0,0,,Хааааааааааааааааааааааааа
Dialogue: 0,0:21:53.76,0:21:56.30,Default,,0,0,0,,Гуао
Dialogue: 0,0:22:02.56,0:22:05.06,Default,,0,0,0,,Гуаааааааааа
Dialogue: 0,0:22:11.30,0:22:12.93,Default,,0,0,0,,Aa
Dialogue: 0,0:22:13.96,0:22:14.83,Default,,0,0,0,,Aa
Dialogue: 0,0:22:15.56,0:22:16.96,Default,,0,0,0,,Aa
Dialogue: 0,0:22:20.40,0:22:21.76,Default,,0,0,0,,Aa
Dialogue: 0,0:22:22.63,0:22:24.60,Default,,0,0,0,,Ууу
Dialogue: 0,0:22:34.53,0:22:47.06,Default,,0,0,0,,Құдайдың күнәсі шексіз теломераларға жазылды
Dialogue: 0,0:22:47.76,0:22:53.90,Default,,0,0,0,,Жалынды құшақтау
Dialogue: 0,0:22:54.26,0:23:01.46,Default,,0,0,0,,Ояну мақсатының құлпытасы
Dialogue: 0,0:23:01.73,0:23:05.00,Default,,0,0,0,,Жан рух Жалғыз дауыс
Dialogue: 0,0:23:05.30,0:23:08.46,Default,,0,0,0,,Өмір Өлім Қараңғы түнгі түс
Dialogue: 0,0:23:08.66,0:23:11.90,Default,,0,0,0,,Ашаршылық Тағдырлы уақыт
Dialogue: 0,0:23:12.20,0:23:15.36,Default,,0,0,0,,Айқай! Айқай! Өміріңді құрт!
Dialogue: 0,0:23:17.33,0:23:27.23,Default,,0,0,0,,Алыстағы күннің сәулесін тап!
Dialogue: 0,0:23:27.53,0:23:37.10,Default,,0,0,0,,Жүрегіңдегі өсиетті босат!
Dialogue: 0,0:23:37.76,0:23:48.80,Default,,0,0,0,,Өсіп келе жатқан үмітті ән сал!
Dialogue: 0,0:23:58.56,0:24:02.03,Default,,0,0,0,,Пю пюу жел бұрқырайды
Dialogue: 0,0:24:02.76,0:24:06.66,Default,,0,0,0,,Мені шақырған дауыс арман сияқты
Dialogue: 0,0:24:07.26,0:24:08.56,Default,,0,0,0,,Өйткені суық
Dialogue: 0,0:24:08.93,0:24:12.26,Default,,0,0,0,,Себебі мен жалғызбын, өйткені бұл азап
Dialogue: 0,0:24:13.00,0:24:14.90,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:24:15.56,0:24:19.16,Default,,0,0,0,,Кілтті алыңыз.
Dialogue: 0,0:24:20.46,0:24:22.56,Default,,0,0,0,,Жұлын сұйықтығы
Dialogue: 0,0:24:23.26,0:24:24.66,Default,,0,0,0,,толып жатыр
Dialogue: 0,0:24:26.16,0:24:32.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
