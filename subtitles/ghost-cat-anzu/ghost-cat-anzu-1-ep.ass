Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.10,0:00:38.44,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:00:38.44,0:00:47.28,Default,,0000,0000,0000,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:00:47.28,0:00:58.79,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:00:58.79,0:01:01.19,Default,,0000,0000,0000,,Карин Кішкене тезек.
Dialogue: 0,0:01:07.97,0:01:10.97,Default,,0000,0000,0000,,күрсіну...
Dialogue: 0,0:01:18.65,0:01:21.31,Default,,0000,0000,0000,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:01:18.65,0:01:21.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:01:21.31,0:01:23.32,Default,,0000,0000,0000,,Бұл ғибадатхана.
Dialogue: 0,0:01:25.65,0:01:28.32,Default,,0000,0000,0000,,Ол әлі тірі ме деп ойлаймын.
Dialogue: 0,0:01:28.32,0:01:30.82,Default,,0000,0000,0000,,Содан бері неше жыл өтті?
Dialogue: 0,0:01:30.82,0:01:32.83,Default,,0000,0000,0000,,20 жылға жуық?
Dialogue: 0,0:01:32.83,0:01:36.26,Default,,0000,0000,0000,,Хехехе, жақсысың ба?
Dialogue: 0,0:01:32.83,0:01:36.26,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:01:36.26,0:01:38.26,Default,,0000,0000,0000,,О.
Dialogue: 0,0:01:41.60,0:01:44.10,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:01:48.94,0:01:51.28,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:01:48.94,0:01:51.28,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:01:51.28,0:01:54.78,Default,,0000,0000,0000,,Мен үйдемін. I.
Dialogue: 0,0:01:54.78,0:01:58.28,Default,,0000,0000,0000,,Тецуя Түсінесіз бе?
Dialogue: 0,0:01:54.78,0:01:58.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:08.96,0:02:11.97,Default,,0000,0000,0000,,А, мынау... Қарин қызы.
Dialogue: 0,0:02:11.97,0:02:14.30,Default,,0000,0000,0000,,Сіз үйленгенсіз бе?
Dialogue: 0,0:02:14.30,0:02:17.14,Default,,0000,0000,0000,,Баяғыда.
Dialogue: 0,0:02:17.14,0:02:19.64,Default,,0000,0000,0000,,Карин-чан неше жаста?
Dialogue: 0,0:02:19.64,0:02:23.48,Default,,0000,0000,0000,,Мен 5-сынып оқушысымын.
Dialogue: 0,0:02:19.64,0:02:23.48,Default,,0000,0000,0000,,5-сынып...
Dialogue: 0,0:02:23.48,0:02:27.15,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:27.15,0:02:30.82,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:02:27.15,0:02:30.82,Default,,0000,0000,0000,,Мен осында біраз тұра аламын ба?
Dialogue: 0,0:02:30.82,0:02:34.25,Default,,0000,0000,0000,,Жарайды, бірақ сіздің жұмысыңыз ше?
Dialogue: 0,0:02:34.25,0:02:38.76,Default,,0000,0000,0000,,Жақсы…. Ал, анау-мынау? Не?
Dialogue: 0,0:02:40.76,0:02:42.76,Default,,0000,0000,0000,,Сіздің әйеліңіз ше?
Dialogue: 0,0:02:42.76,0:02:44.76,Default,,0000,0000,0000,,Үш жыл бұрын қайтыс болды.
Dialogue: 0,0:02:56.78,0:03:06.29,Default,,0000,0000,0000,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:03:12.46,0:03:17.80,Default,,0000,0000,0000,,🖁
Dialogue: 0,0:03:17.80,0:03:19.80,Default,,0000,0000,0000,,Сәлеметсіз бе?
Dialogue: 0,0:03:19.80,0:03:23.14,Default,,0000,0000,0000,,Әй, бәрі, бәрі...
Dialogue: 0,0:03:19.80,0:03:23.14,Default,,0000,0000,0000,,Иә иә иә иә.
Dialogue: 0,0:03:23.14,0:03:25.97,Default,,0000,0000,0000,,А, иә, сағат 2-де басталады.
Dialogue: 0,0:03:23.14,0:03:25.97,Default,,0000,0000,0000,,Иә, иә, иә.
Dialogue: 0,0:03:25.97,0:03:28.17,Default,,0000,0000,0000,,Түсінікті. Иә.
Dialogue: 0,0:03:32.31,0:03:35.58,Default,,0000,0000,0000,,Сіз қайдансыз?
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,Бұл жерде сіз көрмеген бет.
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,Сіз рұқсатсыз кіре алмайсыз.
Dialogue: 0,0:04:00.27,0:04:04.48,Default,,0000,0000,0000,,Сіз туралы соңына дейін
Dialogue: 0,0:04:00.27,0:04:04.48,Default,,0000,0000,0000,,Мен уайымдадым. Бақатаре.
Dialogue: 0,0:04:11.12,0:04:13.79,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:04:11.12,0:04:13.79,Default,,0000,0000,0000,,Маған қарызға ақша беруіңізді қалаймын.
Dialogue: 0,0:04:13.79,0:04:15.96,Default,,0000,0000,0000,,Қандай ақша?
Dialogue: 0,0:04:15.96,0:04:17.96,Default,,0000,0000,0000,,Жалақы ақшасы.
Dialogue: 0,0:04:17.96,0:04:20.46,Default,,0000,0000,0000,,Өлтіруге жақын
Dialogue: 0,0:04:17.96,0:04:20.46,Default,,0000,0000,0000,,Ол ақыры құтылды.
Dialogue: 0,0:04:20.46,0:04:23.80,Default,,0000,0000,0000,,Мен оны бірден қайтарамын, өтінемін.
Dialogue: 0,0:04:20.46,0:04:23.80,Default,,0000,0000,0000,,Сен не істеп жатырсың?
Dialogue: 0,0:04:23.80,0:04:26.80,Default,,0000,0000,0000,,Жақсы. Маған бұл маңызды емес.
Dialogue: 0,0:04:26.80,0:04:29.64,Default,,0000,0000,0000,,Қанша?
Dialogue: 0,0:04:29.64,0:04:31.64,Default,,0000,0000,0000,,1 миллион жеткілікті.
Dialogue: 0,0:04:31.64,0:04:34.07,Default,,0000,0000,0000,,Шық кет!
Dialogue: 0,0:04:31.64,0:04:34.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:34.07,0:04:37.41,Default,,0000,0000,0000,,Қайтып келе салысымен қарыздарыңыз бар ма? Шығу!
Dialogue: 0,0:04:37.41,0:04:40.75,Default,,0000,0000,0000,,Сонда 500 000. Эй, өтінемін!
Dialogue: 0,0:04:40.75,0:04:45.15,Default,,0000,0000,0000,,Үйге қайт! Ешқашан қайтып келме!
Dialogue: 0,0:04:51.92,0:04:55.43,Default,,0000,0000,0000,,Karin! Карин... О...
Dialogue: 0,0:04:55.43,0:04:57.43,Default,,0000,0000,0000,,You wait here for a while.
Dialogue: 0,0:04:57.43,0:04:59.93,Default,,0000,0000,0000,,Мен ақшаны қайтарамын да, сені дереу алып кетейін.
Dialogue: 0,0:04:59.93,0:05:04.10,Default,,0000,0000,0000,,Жақсы қыз бол, жарай ма? Сонда кездескенше.
Dialogue: 0,0:05:04.10,0:05:06.11,Default,,0000,0000,0000,,Э…?—
Dialogue: 0,0:05:09.61,0:05:11.78,Default,,0000,0000,0000,,Тецуя Сізде ақша бар ма?
Dialogue: 0,0:05:11.78,0:05:13.98,Default,,0000,0000,0000,,Иә? Жарайды, жарайды.
Dialogue: 0,0:05:15.95,0:05:18.65,Default,,0000,0000,0000,,Мен мұны істемедім, өйткені ол жақсы болды.
Dialogue: 0,0:05:26.96,0:05:28.96,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:05:28.96,0:05:40.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:40.07,0:05:42.08,Default,,0000,0000,0000,,Бұл жалғыз нұсқа.
Dialogue: 0,0:05:42.08,0:05:44.88,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:05:49.92,0:05:53.75,Default,,0000,0000,0000,,Анамның қайтыс болғанына
Dialogue: 0,0:05:49.92,0:05:53.75,Default,,0000,0000,0000,,I'll be back➡
Dialogue: 0,0:05:53.75,0:05:57.42,Default,,0000,0000,0000,,Қабір басына бірге барайық.
Dialogue: 0,0:05:57.42,0:05:59.59,Default,,0000,0000,0000,,Бұл анық.
Dialogue: 0,0:05:59.59,0:06:10.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:10.94,0:06:14.14,Default,,0000,0000,0000,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:06:17.11,0:06:19.71,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:06:32.63,0:06:34.56,Default,,0000,0000,0000,,Ішуге болмайды.
Dialogue: 0,0:06:34.56,0:06:37.56,Default,,0000,0000,0000,,Itadadakimasu.
Dialogue: 0,0:06:34.56,0:06:37.56,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:06:41.90,0:06:47.74,Default,,0000,0000,0000,,Осындай сүйкімді баланы жалғыз қалдыру
Dialogue: 0,0:06:41.90,0:06:47.74,Default,,0000,0000,0000,,Әлгі ақымақ...
Dialogue: 0,0:06:47.74,0:06:49.91,Default,,0000,0000,0000,,Karin-chan
Dialogue: 0,0:06:47.74,0:06:49.91,Default,,0000,0000,0000,,If you have any trouble➡
Dialogue: 0,0:06:49.91,0:06:51.91,Default,,0000,0000,0000,,Сіз кез келген нәрсені айта аласыз.
Dialogue: 0,0:06:51.91,0:06:54.08,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:06:54.08,0:06:56.25,Default,,0000,0000,0000,,Karin-chan is a good girl.
Dialogue: 0,0:06:56.25,0:06:59.75,Default,,0000,0000,0000,,Иә, бұл туралы жиі айтылады.
Dialogue: 0,0:06:56.25,0:06:59.75,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:06:59.75,0:07:03.59,Default,,0000,0000,0000,,Ошо-сан, мен жұмысқа барамын.
Dialogue: 0,0:06:59.75,0:07:03.59,Default,,0000,0000,0000,,О, келіңдер.
Dialogue: 0,0:07:03.59,0:07:05.59,Default,,0000,0000,0000,,Anzu-chan!
Dialogue: 0,0:07:05.59,0:07:09.26,Default,,0000,0000,0000,,This child is Karin-chan. Tetsuya's daughter.
Dialogue: 0,0:07:09.26,0:07:12.60,Default,,0000,0000,0000,,Мен осында біраз уақыт боламын.
Dialogue: 0,0:07:09.26,0:07:12.60,Default,,0000,0000,0000,,Take care of me.
Dialogue: 0,0:07:12.60,0:07:16.10,Default,,0000,0000,0000,,Мен түсіндім. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:07:19.44,0:07:22.44,Default,,0000,0000,0000,,Grandfather
Dialogue: 0,0:07:19.44,0:07:22.44,Default,,0000,0000,0000,,Мынау не мысық?
Dialogue: 0,0:07:22.44,0:07:26.95,Default,,0000,0000,0000,,Anzu-chan?
Dialogue: 0,0:07:22.44,0:07:26.95,Default,,0000,0000,0000,,Менің үйде мысық бар...
Dialogue: 0,0:07:26.95,0:07:30.45,Default,,0000,0000,0000,,Бірақ бұл біртүрлі, солай емес пе?
Dialogue: 0,0:07:26.95,0:07:30.45,Default,,0000,0000,0000,,Адам сияқты сөйлесу.
Dialogue: 0,0:07:30.45,0:07:33.22,Default,,0000,0000,0000,,Hahahaha…!
Dialogue: 0,0:07:33.22,0:07:37.22,Default,,0000,0000,0000,,Өйткені Анзу-чан - құбыжық мысық.
Dialogue: 0,0:07:37.22,0:07:39.89,Default,,0000,0000,0000,,Nyaha!
Dialogue: 0,0:07:39.89,0:07:43.40,Default,,0000,0000,0000,,Nyahahahaha…!
Dialogue: 0,0:07:49.40,0:07:56.74,Default,,0000,0000,0000,,(котенка мияу)
Dialogue: 0,0:07:56.74,0:07:59.08,Default,,0000,0000,0000,,((Хмм?
Dialogue: 0,0:07:59.08,0:08:09.76,Default,,0000,0000,0000,,(котенка мияу)
Dialogue: 0,0:08:09.76,0:08:12.46,Default,,0000,0000,0000,,Хахахаха! ))
Dialogue: 0,0:08:15.43,0:08:19.10,Default,,0000,0000,0000,,＜ Osho-san: That cat
Dialogue: 0,0:08:15.43,0:08:19.10,Default,,0000,0000,0000,,Анзу-чан.
Dialogue: 0,0:08:19.10,0:08:24.77,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:08:19.10,0:08:24.77,Default,,0000,0000,0000,,I raised her with care, but...
Dialogue: 0,0:08:24.77,0:08:27.77,Default,,0000,0000,0000,,Strangely, Anzu-chan➡
Dialogue: 0,0:08:27.77,0:08:32.28,Default,,0000,0000,0000,,Ол ешқашан өлмеген.
Dialogue: 0,0:08:32.28,0:08:38.89,Default,,0000,0000,0000,,10 немесе 20 жылдан кейін де сау болыңыз.
Dialogue: 0,0:08:38.89,0:08:44.22,Default,,0000,0000,0000,,30 жылдан кейін
Dialogue: 0,0:08:38.89,0:08:44.22,Default,,0000,0000,0000,,Не болды деп ойлаймын...
Dialogue: 0,0:08:44.22,0:08:49.13,Default,,0000,0000,0000,,Анзу-чан
Dialogue: 0,0:08:44.22,0:08:49.13,Default,,0000,0000,0000,,Мен құбыжық мысыққа айналдым＞
Dialogue: 0,0:08:54.57,0:08:57.90,Default,,0000,0000,0000,,А, бұл аздап келеді.
Dialogue: 0,0:08:57.90,0:09:01.07,Default,,0000,0000,0000,,Аа, солай...
Dialogue: 0,0:08:57.90,0:09:01.07,Default,,0000,0000,0000,,Мұғалім мен оны суытып жібердім.
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Usu.
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Сонымен, Цурумаки мырза, 30 минуттық курс туралы не айтасыз?
Dialogue: 0,0:09:05.08,0:09:07.88,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:09:05.08,0:09:07.88,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:10.58,0:09:12.59,Default,,0000,0000,0000,,Гвааах!
Dialogue: 0,0:09:12.59,0:09:15.76,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:09:15.76,0:09:18.76,Default,,0000,0000,0000,,О...
Dialogue: 0,0:09:15.76,0:09:18.76,Default,,0000,0000,0000,,Хмм... міне!
Dialogue: 0,0:09:18.76,0:09:21.59,Default,,0000,0000,0000,,А, міне, ұстаз!
Dialogue: 0,0:09:21.59,0:09:26.10,Default,,0000,0000,0000,,The teacher knows my pressure points.
Dialogue: 0,0:09:21.59,0:09:26.10,Default,,0000,0000,0000,,Мен білемін...
Dialogue: 0,0:09:26.10,0:09:29.70,Default,,0000,0000,0000,,Гррррр… gggggggg….
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:09:43.22,0:09:45.22,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:09:45.22,0:09:49.42,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:09:45.22,0:09:49.42,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:09:54.06,0:09:58.06,Default,,0000,0000,0000,,Няхахахахаха!
Dialogue: 0,0:09:58.06,0:10:00.57,Default,,0000,0000,0000,,О, Соджи храмының құбыжық мысығы.
Dialogue: 0,0:10:00.57,0:10:02.57,Default,,0000,0000,0000,,Бірден
Dialogue: 0,0:10:00.57,0:10:02.57,Default,,0000,0000,0000,,Сәлем беруім керек сияқты.
Dialogue: 0,0:10:02.57,0:10:04.57,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:10:04.57,0:10:09.24,Default,,0000,0000,0000,,Өлу.
Dialogue: 0,0:10:09.24,0:10:11.24,Default,,0000,0000,0000,,Өлу….
Dialogue: 0,0:10:11.24,0:10:14.75,Default,,0000,0000,0000,,Карин-чан
Dialogue: 0,0:10:11.24,0:10:14.75,Default,,0000,0000,0000,,Бір жерде ойнағың келе ме?
Dialogue: 0,0:10:14.75,0:10:18.08,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:14.75,0:10:18.08,Default,,0000,0000,0000,,Жалғыз өзім үйреніп қалдым.
Dialogue: 0,0:10:18.08,0:10:20.59,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:10:20.59,0:10:23.92,Default,,0000,0000,0000,,Ал мен….
Dialogue: 0,0:10:23.92,0:10:28.26,Default,,0000,0000,0000,,Себебі менде ақша жоқ...
Dialogue: 0,0:10:28.26,0:10:31.66,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:40.61,0:10:44.61,Default,,0000,0000,0000,,Ах! Инуэ!
Dialogue: 0,0:10:44.61,0:10:46.78,Default,,0000,0000,0000,,Өрік.
Dialogue: 0,0:10:46.78,0:10:49.18,Default,,0000,0000,0000,,Оши….
Dialogue: 0,0:10:51.78,0:10:54.45,Default,,0000,0000,0000,,Вис!
Dialogue: 0,0:10:51.78,0:10:54.45,Default,,0000,0000,0000,,Ойсу!
Dialogue: 0,0:10:54.45,0:10:57.29,Default,,0000,0000,0000,,Не? Сіз жігіттер.
Dialogue: 0,0:10:57.29,0:11:02.96,Default,,0000,0000,0000,,Бұл Иноуэ, Икетеру бастауыш мектебінің 5-сынып оқушысы!
Dialogue: 0,0:10:57.29,0:11:02.96,Default,,0000,0000,0000,,Хаяши!
Dialogue: 0,0:11:02.96,0:11:06.97,Default,,0000,0000,0000,,Ння….
Dialogue: 0,0:11:02.96,0:11:06.97,Default,,0000,0000,0000,,Мм... солай ма?
Dialogue: 0,0:11:06.97,0:11:09.30,Default,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:11:09.30,0:11:12.47,Default,,0000,0000,0000,,Бірдеңе ішуді қалайсыз ба?
Dialogue: 0,0:11:09.30,0:11:12.47,Default,,0000,0000,0000,,Кофе алғыңыз келе ме?
Dialogue: 0,0:11:12.47,0:11:15.47,Default,,0000,0000,0000,,Емделу?
Dialogue: 0,0:11:12.47,0:11:15.47,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:15.47,0:11:18.31,Default,,0000,0000,0000,,Екеуміз құқық бұзушы топпыз➡
Dialogue: 0,0:11:18.31,0:11:20.81,Default,,0000,0000,0000,,«Аманояку»
Dialogue: 0,0:11:18.31,0:11:20.81,Default,,0000,0000,0000,,Мен істеп жатырмын➡
Dialogue: 0,0:11:20.81,0:11:23.48,Default,,0000,0000,0000,,Бірге қыдырғыларыңыз келе ме?
Dialogue: 0,0:11:23.48,0:11:27.82,Default,,0000,0000,0000,,Мен әлемге қарсы барамын.
Dialogue: 0,0:11:27.82,0:11:30.52,Default,,0000,0000,0000,,Мені қызықтырмайды.
Dialogue: 0,0:11:35.93,0:11:38.23,Default,,0000,0000,0000,,Иә! Карин-чан!
Dialogue: 0,0:11:46.94,0:11:49.44,Default,,0000,0000,0000,,Бұл кім? ?
Dialogue: 0,0:11:49.44,0:11:52.14,Default,,0000,0000,0000,,Бауырым, айтшы!
Dialogue: 0,0:11:56.12,0:11:59.12,Default,,0000,0000,0000,,Карин-чан...?
Dialogue: 0,0:11:59.12,0:12:02.96,Default,,0000,0000,0000,,Жоқ, бұл періште.
Dialogue: 0,0:12:02.96,0:12:04.96,Default,,0000,0000,0000,,Менімен сөйлес.
Dialogue: 0,0:12:04.96,0:12:06.96,Default,,0000,0000,0000,,Мүмкін емес Мүмкін емес!
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:12:14.13,0:12:16.94,Default,,0000,0000,0000,,Жарайды, іш. Өйткені мен оны сатып аламын.
Dialogue: 0,0:12:26.98,0:12:33.09,Default,,0000,0000,0000,,Білесіз бе, әлгі құбыжық мысық туралы.
Dialogue: 0,0:12:26.98,0:12:33.09,Default,,0000,0000,0000,,Маған айта аласыз ба?
Dialogue: 0,0:12:33.09,0:12:36.76,Default,,0000,0000,0000,,Сондай-ақ, осы қала туралы.
Dialogue: 0,0:12:36.76,0:12:40.26,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:12:47.93,0:12:50.74,Default,,0000,0000,0000,,Няхахаха!
Dialogue: 0,0:12:53.44,0:12:57.24,Default,,0000,0000,0000,,Няхахаха….
Dialogue: 0,0:13:00.95,0:13:02.95,Default,,0000,0000,0000,,🔊Велосипед сонда
Dialogue: 0,0:13:00.95,0:13:02.95,Default,,0000,0000,0000,,Солға жылжып, тоқтаңыз.
Dialogue: 0,0:13:02.95,0:13:05.65,Default,,0000,0000,0000,,Мияу….
Dialogue: 0,0:13:13.46,0:13:15.63,Default,,0000,0000,0000,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:13:15.63,0:13:19.80,Default,,0000,0000,0000,,Иә Сәлем.
Dialogue: 0,0:13:15.63,0:13:19.80,Default,,0000,0000,0000,,Сіз көп ұшып жүрсіз.
Dialogue: 0,0:13:19.80,0:13:23.30,Default,,0000,0000,0000,,Маған лицензияңызды көрсетіңіз.
Dialogue: 0,0:13:19.80,0:13:23.30,Default,,0000,0000,0000,,Няхахаха! Мен оны үйде ұмытып кеттім.
Dialogue: 0,0:13:23.30,0:13:26.81,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:13:23.30,0:13:26.81,Default,,0000,0000,0000,,Негізі менде жоқ Няхахаха!
Dialogue: 0,0:13:26.81,0:13:29.71,Default,,0000,0000,0000,,Жоқ! Сіздің атыңыз кім?
Dialogue: 0,0:13:32.65,0:13:34.58,Default,,0000,0000,0000,,Бұл Хачико.
Dialogue: 0,0:13:34.58,0:13:37.92,Default,,0000,0000,0000,,Анзу-чан, солай ма?
Dialogue: 0,0:13:34.58,0:13:37.92,Default,,0000,0000,0000,,Ол Соджи храмының асырап алған ұлы, солай ма?
Dialogue: 0,0:13:37.92,0:13:40.75,Default,,0000,0000,0000,,Мен тыңдаймын.
Dialogue: 0,0:13:37.92,0:13:40.75,Default,,0000,0000,0000,,Иә, полиция көлігінде.
Dialogue: 0,0:13:40.75,0:13:43.59,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:13:40.75,0:13:43.59,Default,,0000,0000,0000,,Жол қозғалысы ережесін бұзу.
Dialogue: 0,0:13:43.59,0:13:47.26,Default,,0000,0000,0000,,Өйткені мен адам емеспін
Dialogue: 0,0:13:43.59,0:13:47.26,Default,,0000,0000,0000,,Мен лицензияның қажеті жоқ деп ойладым...
Dialogue: 0,0:13:47.26,0:13:49.43,Default,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:13:47.26,0:13:49.43,Default,,0000,0000,0000,,Жыл?
Dialogue: 0,0:13:49.43,0:13:53.43,Default,,0000,0000,0000,,37.
Dialogue: 0,0:13:49.43,0:13:53.43,Default,,0000,0000,0000,,Лицензияңызды алыңыз, содан кейін мотоцикл мініңіз.
Dialogue: 0,0:13:53.43,0:13:57.60,Default,,0000,0000,0000,,Оны 16-дан алуға болады.
Dialogue: 0,0:13:53.43,0:13:57.60,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,0:13:57.60,0:13:59.71,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:14:06.11,0:14:08.11,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:14:08.11,0:14:22.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:22.96,0:14:24.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:24.96,0:14:31.77,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:14:37.91,0:14:42.41,Default,,0000,0000,0000,,Няхаха. Үстінде лай бар.
Dialogue: 0,0:14:45.75,0:14:48.45,Default,,0000,0000,0000,,Піскенше, жарайды.
Dialogue: 0,0:15:04.27,0:15:08.27,Default,,0000,0000,0000,,Анзу-чан
Dialogue: 0,0:15:04.27,0:15:08.27,Default,,0000,0000,0000,,Сонда сіз бүгін лицензиясыз қамауға алындыңыз ба?
Dialogue: 0,0:15:08.27,0:15:11.78,Default,,0000,0000,0000,,Кетті, мияу.
Dialogue: 0,0:15:11.78,0:15:14.45,Default,,0000,0000,0000,,Велосипедті пайдалануға болады.
Dialogue: 0,0:15:14.45,0:15:16.78,Default,,0000,0000,0000,,Мазасыз мияу.
Dialogue: 0,0:15:16.78,0:15:19.49,Default,,0000,0000,0000,,Сән-салтанат туралы айтпа.
Dialogue: 0,0:15:22.12,0:15:25.79,Default,,0000,0000,0000,,Карин-чан, сен тамақ ішпейсің бе?
Dialogue: 0,0:15:25.79,0:15:29.80,Default,,0000,0000,0000,,Кальмар Бұл дәмді. кальмар жейік.
Dialogue: 0,0:15:29.80,0:15:35.07,Default,,0000,0000,0000,,Мен кальмарды ұнатпаймын.
Dialogue: 0,0:15:29.80,0:15:35.07,Default,,0000,0000,0000,,Бұл кальмар заты ма?
Dialogue: 0,0:15:35.07,0:15:37.90,Default,,0000,0000,0000,,Няхахахаха!
Dialogue: 0,0:15:35.07,0:15:37.90,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:15:37.90,0:15:40.41,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:15:37.90,0:15:40.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:40.41,0:15:42.57,Default,,0000,0000,0000,,(ысқыру дыбысы)
Dialogue: 0,0:15:42.57,0:15:44.88,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:15:47.25,0:15:49.95,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:15:56.76,0:15:59.93,Default,,0000,0000,0000,,Мұнда және мұнда
Dialogue: 0,0:15:56.76,0:15:59.93,Default,,0000,0000,0000,,Ондай жерге сипаңыз.
Dialogue: 0,0:15:59.93,0:16:02.73,Default,,0000,0000,0000,,Меухахаха...!
Dialogue: 0,0:16:07.10,0:16:10.94,Default,,0000,0000,0000,,Сәлем Анзу-чан
Dialogue: 0,0:16:07.10,0:16:10.94,Default,,0000,0000,0000,,Толық емес жұмыс күнімен жұмыс істегіңіз келе ме?
Dialogue: 0,0:16:10.94,0:16:12.94,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:12.94,0:16:15.11,Default,,0000,0000,0000,,Соңғы кездері өзен қарасаты көбейіп кетті➡
Dialogue: 0,0:16:15.11,0:16:18.44,Default,,0000,0000,0000,,Босатылған тәтті балық
Dialogue: 0,0:16:15.11,0:16:18.44,Default,,0000,0000,0000,,Мен бәрін жеймін.
Dialogue: 0,0:16:18.44,0:16:23.12,Default,,0000,0000,0000,,Анзу-чан
Dialogue: 0,0:16:18.44,0:16:23.12,Default,,0000,0000,0000,,Сіз өзен қарақатын айдай аласыз ба?
Dialogue: 0,0:16:23.12,0:16:26.29,Default,,0000,0000,0000,,Ошо-сан
Dialogue: 0,0:16:23.12,0:16:26.29,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:16:26.29,0:16:28.45,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:28.45,0:16:31.12,Default,,0000,0000,0000,,Мен адамдар сияқты өмір сүремін.
Dialogue: 0,0:16:28.45,0:16:31.12,Default,,0000,0000,0000,,Иә, бірақ➡
Dialogue: 0,0:16:31.12,0:16:34.39,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:16:31.12,0:16:34.39,Default,,0000,0000,0000,,Құстар мен аңдардың одақтасы.
Dialogue: 0,0:16:34.39,0:16:39.23,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:16:34.39,0:16:39.23,Default,,0000,0000,0000,,Ал, жоқ дейік.
Dialogue: 0,0:16:39.23,0:16:43.57,Default,,0000,0000,0000,,Күніне 3000 иен береміз дейді...
Dialogue: 0,0:16:43.57,0:16:47.07,Default,,0000,0000,0000,,Е, 3000 иен! ?
Dialogue: 0,0:16:47.07,0:16:54.58,Default,,0000,0000,0000,,(Өріктің шуылдауы)
Dialogue: 0,0:16:54.58,0:16:57.08,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:17:00.75,0:17:03.46,Default,,0000,0000,0000,,Онда ештеңе жоқ...
Dialogue: 0,0:17:08.59,0:17:10.93,Default,,0000,0000,0000,,Сол жаққа барайық.
Dialogue: 0,0:17:10.93,0:17:14.27,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:17:10.93,0:17:14.27,Default,,0000,0000,0000,,Үйге бара аламын ба?
Dialogue: 0,0:17:14.27,0:17:18.27,Default,,0000,0000,0000,,Иә? Бұл 3000 иен бе? Жарайды ма?
Dialogue: 0,0:17:21.77,0:17:23.78,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:17:28.95,0:17:31.28,Default,,0000,0000,0000,,Эй, сен осындасың!
Dialogue: 0,0:17:31.28,0:17:34.79,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:31.28,0:17:34.79,Default,,0000,0000,0000,,Өте көп!
Dialogue: 0,0:17:36.89,0:17:40.59,Default,,0000,0000,0000,,Ах! Барлық тәтті балықты жеп қойыңыз!
Dialogue: 0,0:17:42.56,0:17:45.73,Default,,0000,0000,0000,,(Труба дыбысы)
Dialogue: 0,0:17:45.73,0:17:47.73,Default,,0000,0000,0000,,№.
Dialogue: 0,0:17:47.73,0:17:51.74,Default,,0000,0000,0000,,Карин-чан Зымыран отшашуы.
Dialogue: 0,0:17:51.74,0:17:54.14,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:17:59.08,0:18:01.75,Default,,0000,0000,0000,,Тұтану!
Dialogue: 0,0:18:01.75,0:18:03.75,Default,,0000,0000,0000,,Өрт!
Dialogue: 0,0:18:03.75,0:18:05.75,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:18:09.92,0:18:12.76,Default,,0000,0000,0000,,Ол қашып кетті!
Dialogue: 0,0:18:09.92,0:18:12.76,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:12.76,0:18:15.26,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:12.76,0:18:15.26,Default,,0000,0000,0000,,Вахахаха!
Dialogue: 0,0:18:15.26,0:18:17.26,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:18:15.26,0:18:17.26,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:17.26,0:18:19.67,Default,,0000,0000,0000,,Иә, иә! Алақай!
Dialogue: 0,0:18:21.60,0:18:29.27,Default,,0000,0000,0000,,Мен тым көп оқимын
Dialogue: 0,0:18:21.60,0:18:29.27,Default,,0000,0000,0000,,Сен ақымақ болып кеттің.
Dialogue: 0,0:18:29.27,0:18:31.28,Default,,0000,0000,0000,,Міне, кеттіңіз.
Dialogue: 0,0:18:40.05,0:18:42.15,Default,,0000,0000,0000,,3000 иен.
Dialogue: 0,0:18:47.73,0:18:53.23,Default,,0000,0000,0000,,(Монеталар дыбысы)
Dialogue: 0,0:18:53.23,0:18:55.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:55.23,0:18:57.57,Default,,0000,0000,0000,,Беру
Dialogue: 0,0:18:55.23,0:18:57.57,Default,,0000,0000,0000,,Сіз мұның бәрін пайдаланасыз, солай ма?
Dialogue: 0,0:18:57.57,0:18:59.91,Default,,0000,0000,0000,,Қалғанын өзім шешемін.
Dialogue: 0,0:18:59.91,0:19:02.41,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:02.41,0:19:05.91,Default,,0000,0000,0000,,Маған қамқор болыңыз, өйткені сіз мені сұрағансыз.
Dialogue: 0,0:19:05.91,0:19:08.91,Default,,0000,0000,0000,,Қайтарыңыз! Қайтарыңыз!
Dialogue: 0,0:19:05.91,0:19:08.91,Default,,0000,0000,0000,,№.
Dialogue: 0,0:19:08.91,0:19:11.25,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,0:19:08.91,0:19:11.25,Default,,0000,0000,0000,,№.
Dialogue: 0,0:19:11.25,0:19:14.59,Default,,0000,0000,0000,,Даме, жоқ, жоқ.
Dialogue: 0,0:19:14.59,0:19:18.42,Default,,0000,0000,0000,,Қайтарыңыз!
Dialogue: 0,0:19:18.42,0:19:20.43,Default,,0000,0000,0000,,Сіз қанша биіктікке көтерілесіз?
Dialogue: 0,0:19:20.43,0:19:22.59,Default,,0000,0000,0000,,Няхаха!
Dialogue: 0,0:19:20.43,0:19:22.59,Default,,0000,0000,0000,,Қарғыс атқыр мысық!
Dialogue: 0,0:19:22.59,0:19:24.60,Default,,0000,0000,0000,,Nyahahahahaha!
Dialogue: 0,0:19:24.60,0:19:28.93,Default,,0000,0000,0000,,А, бұл қызықсыз...
Dialogue: 0,0:19:28.93,0:19:31.14,Default,,0000,0000,0000,,Карин-чан!
Dialogue: 0,0:19:33.71,0:19:35.87,Default,,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:19:35.87,0:19:38.04,Default,,0000,0000,0000,,Патруль!
Dialogue: 0,0:19:38.04,0:19:40.55,Default,,0000,0000,0000,,Қызықты жерде
Dialogue: 0,0:19:38.04,0:19:40.55,Default,,0000,0000,0000,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:19:40.55,0:19:43.88,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:19:40.55,0:19:43.88,Default,,0000,0000,0000,,Артқа мініңіз!
Dialogue: 0,0:19:43.88,0:19:46.39,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:19:43.88,0:19:46.39,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:20:00.57,0:20:04.07,Default,,0000,0000,0000,,Бұл қызықсыз. Мен ешқандай балық ұстай алмаймын.
Dialogue: 0,0:20:04.07,0:20:06.57,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:20:06.57,0:20:09.91,Default,,0000,0000,0000,,Аа... қыздар өте қиын...
Dialogue: 0,0:20:09.91,0:20:13.41,Default,,0000,0000,0000,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:20:13.41,0:20:15.41,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:20:15.41,0:20:17.42,Default,,0000,0000,0000,,Рассела ~
Dialogue: 0,0:20:15.41,0:20:17.42,Default,,0000,0000,0000,,Ласера.
Dialogue: 0,0:20:17.42,0:20:20.75,Default,,0000,0000,0000,,Рассела~ Рассела~
Dialogue: 0,0:20:17.42,0:20:20.75,Default,,0000,0000,0000,,Рассела ~ Рассела.
Dialogue: 0,0:20:20.75,0:20:25.76,Default,,0000,0000,0000,,Рассела ~ Рассела.
Dialogue: 0,0:20:20.75,0:20:25.76,Default,,0000,0000,0000,,Барлығы~ Сіз бірдеңе ұстадыңыз ба~?
Dialogue: 0,0:20:25.76,0:20:27.76,Default,,0000,0000,0000,,Мүлде жоқ.
Dialogue: 0,0:20:27.76,0:20:31.76,Default,,0000,0000,0000,,Міне, кеттіңіз. Рассела~ Рассела~
Dialogue: 0,0:20:27.76,0:20:31.76,Default,,0000,0000,0000,,Ласера….
Dialogue: 0,0:20:31.76,0:20:33.77,Default,,0000,0000,0000,,Жоқ, Йо Чан.
Dialogue: 0,0:20:33.77,0:20:39.27,Default,,0000,0000,0000,,Соқ! Апыр-ай!
Dialogue: 0,0:20:39.27,0:20:41.61,Default,,0000,0000,0000,,Не болды? Үлкен аға.
Dialogue: 0,0:20:41.61,0:20:45.61,Default,,0000,0000,0000,,Үй орталығындағы Донабедегі Йоччан
Dialogue: 0,0:20:41.61,0:20:45.61,Default,,0000,0000,0000,,Мен сіздің жұмысқа орналасқаныңызды естідім.
Dialogue: 0,0:20:45.61,0:20:47.78,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:20:45.61,0:20:47.78,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:20:47.78,0:20:50.62,Default,,0000,0000,0000,,Мұнда бәрі бар.
Dialogue: 0,0:20:47.78,0:20:50.62,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:50.62,0:20:53.29,Default,,0000,0000,0000,,Үй орталығында және т.б.
Dialogue: 0,0:20:50.62,0:20:53.29,Default,,0000,0000,0000,,Тым қобалжымаңыз.
Dialogue: 0,0:20:53.29,0:20:56.12,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:20:53.29,0:20:56.12,Default,,0000,0000,0000,,Ең жақсы!
Dialogue: 0,0:20:56.12,0:20:58.12,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:20:58.12,0:21:02.29,Default,,0000,0000,0000,,Иә! Алақай!
Dialogue: 0,0:21:02.29,0:21:04.30,Default,,0000,0000,0000,,Буаккуши!
Dialogue: 0,0:21:07.47,0:21:09.47,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:21:12.80,0:21:17.48,Default,,0000,0000,0000,,Мені оқудың бірінші күні кенеттен жұмыстан шығарды.
Dialogue: 0,0:21:17.48,0:21:21.98,Default,,0000,0000,0000,,Не істесеңіз де
Dialogue: 0,0:21:17.48,0:21:21.98,Default,,0000,0000,0000,,Бұл жұмыс істемейді.
Dialogue: 0,0:21:21.98,0:21:26.99,Default,,0000,0000,0000,,Мен... Өлгенім жақсы болар.
Dialogue: 0,0:21:32.99,0:21:35.29,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:40.93,0:21:43.14,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:21:46.44,0:21:48.64,Default,,0000,0000,0000,,Хакушон!
Dialogue: 0,0:21:50.61,0:21:52.91,Default,,0000,0000,0000,,Күрсін... Менің өлгім келеді...
Dialogue: 0,0:22:27.15,0:22:31.15,Default,,0000,0000,0000,,Дыбыстық сигнал сигналдық сигнал.
Dialogue: 0,0:22:31.15,0:22:33.42,Default,,0000,0000,0000,,Анзу-чан, бұл не?
Dialogue: 0,0:22:33.42,0:22:36.92,Default,,0000,0000,0000,,Ошо-сан, сен ақымақсың.
Dialogue: 0,0:22:33.42,0:22:36.92,Default,,0000,0000,0000,,Сіз бөденені білмейсіз бе?
Dialogue: 0,0:22:36.92,0:22:41.26,Default,,0000,0000,0000,,Мен тек бөдене туралы білемін.
Dialogue: 0,0:22:36.92,0:22:41.26,Default,,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:22:41.26,0:22:45.10,Default,,0000,0000,0000,,Артымда тауға шығып бара жатыр едім.
Dialogue: 0,0:22:41.26,0:22:45.10,Default,,0000,0000,0000,,Мен оны таптым, сондықтан мен оны осында әкелдім.
Dialogue: 0,0:22:45.10,0:22:47.43,Default,,0000,0000,0000,,Менің ойымша, сіз ата-анаңыздан айырылдыңыз.
Dialogue: 0,0:22:47.43,0:22:49.60,Default,,0000,0000,0000,,Дыбыстық сигнал! Бип!
Dialogue: 0,0:22:47.43,0:22:49.60,Default,,0000,0000,0000,,Үлкен өсу➡
Dialogue: 0,0:22:49.60,0:22:52.27,Default,,0000,0000,0000,,Оны қасапшыға сатсам ба деп ойладым.
Dialogue: 0,0:22:52.27,0:22:55.94,Default,,0000,0000,0000,,Э~?
Dialogue: 0,0:22:52.27,0:22:55.94,Default,,0000,0000,0000,,Бұл өтірік!
Dialogue: 0,0:22:55.94,0:22:58.11,Default,,0000,0000,0000,,Тезірек орманға қайтсын.
Dialogue: 0,0:22:58.11,0:23:01.78,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:23:01.78,0:23:04.28,Default,,0000,0000,0000,,Егер Итачи мені тапса
Dialogue: 0,0:23:01.78,0:23:04.28,Default,,0000,0000,0000,,Бұл үлкен мәселе.
Dialogue: 0,0:23:04.28,0:23:07.99,Default,,0000,0000,0000,,Осы жерде біраз уақыт ойнаңыз.
Dialogue: 0,0:23:04.28,0:23:07.99,Default,,0000,0000,0000,,Пи Пи.
Dialogue: 0,0:23:10.12,0:23:14.23,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:23:17.96,0:23:20.27,Default,,0000,0000,0000,,Карин-чан, қайда бара жатырсың?
Dialogue: 0,0:23:24.80,0:23:27.64,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:23:27.64,0:23:29.74,Default,,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:23:36.75,0:23:38.95,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:23:44.09,0:23:54.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:54.10,0:23:56.43,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:23:56.43,0:23:59.60,Default,,0000,0000,0000,,Ах! Гуаа...
Dialogue: 0,0:23:59.60,0:24:02.61,Default,,0000,0000,0000,,Уау... Ару!
Dialogue: 0,0:24:02.61,0:24:05.28,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:24:05.28,0:24:07.28,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:24:07.28,0:24:10.18,Default,,0000,0000,0000,,Кедейлік құдайы, солай ма? Менің әңгімем бар.
Dialogue: 0,0:24:12.12,0:24:14.29,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:24:14.29,0:24:16.62,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:24:16.62,0:24:22.13,Default,,0000,0000,0000,,Соджожи храмындағы құбыжық мысық
Dialogue: 0,0:24:16.62,0:24:22.13,Default,,0000,0000,0000,,Анзу Накамура.
Dialogue: 0,0:24:22.13,0:24:24.80,Default,,0000,0000,0000,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:24:24.80,0:24:28.13,Default,,0000,0000,0000,,Мен охаги әкелдім. Өтінемін жей бер.
Dialogue: 0,0:24:28.13,0:24:30.24,Default,,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:24:32.97,0:24:37.08,Default,,0000,0000,0000,,Сұрау. Өтінемін, Йоччаннан алыс болыңыз.
Dialogue: 0,0:24:37.08,0:24:39.41,Default,,0000,0000,0000,,Жоқ, өйткені біз доспыз➡
Dialogue: 0,0:24:39.41,0:24:43.42,Default,,0000,0000,0000,,Тым көп қиындық
Dialogue: 0,0:24:39.41,0:24:43.42,Default,,0000,0000,0000,,Сенің маған тап болғаныңды қаламаймын.
Dialogue: 0,0:24:43.42,0:24:47.25,Default,,0000,0000,0000,,Мен де жұмыс істеуім керек.
Dialogue: 0,0:24:47.25,0:24:49.75,Default,,0000,0000,0000,,Жоқ, жақсы
Dialogue: 0,0:24:47.25,0:24:49.75,Default,,0000,0000,0000,,Әртүрлі себептер бар екеніне сенімдімін➡
Dialogue: 0,0:24:49.75,0:24:52.92,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:24:49.75,0:24:52.92,Default,,0000,0000,0000,,Бұл жерден кет, жарай ма?
Dialogue: 0,0:24:52.92,0:24:57.26,Default,,0000,0000,0000,,Йокчанның жолы түсіп қалады.
Dialogue: 0,0:24:52.92,0:24:57.26,Default,,0000,0000,0000,,Оған да сен кінәлісің, себебі мен сені таптым.
Dialogue: 0,0:24:57.26,0:25:01.17,Default,,0000,0000,0000,,Әйтеуір, міне... артқа тарт.
Dialogue: 0,0:25:08.94,0:25:12.24,Default,,0000,0000,0000,,Ммм... мм.
Dialogue: 0,0:25:15.28,0:25:17.45,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:25:17.45,0:25:21.62,Default,,0000,0000,0000,,Ммммм...
Dialogue: 0,0:25:21.62,0:25:28.63,Default,,0000,0000,0000,,(телефонның қоңырау үні)
Dialogue: 0,0:25:28.63,0:25:32.30,Default,,0000,0000,0000,,📱Мен қазір телефондамын...
Dialogue: 0,0:25:28.63,0:25:32.30,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:25:32.30,0:25:35.73,Default,,0000,0000,0000,,📱Ол сигнал бергенде
Dialogue: 0,0:25:32.30,0:25:35.73,Default,,0000,0000,0000,,Сіздің атыңыз бен мақсатыңыз...
Dialogue: 0,0:25:35.73,0:25:37.74,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,0:25:54.92,0:26:00.09,Default,,0000,0000,0000,,Бұл ойын.
Dialogue: 0,0:25:54.92,0:26:00.09,Default,,0000,0000,0000,,Кім қысқасын тартса, сол жеңіледі.
Dialogue: 0,0:26:00.09,0:26:02.76,Default,,0000,0000,0000,,Үніңді жап, бұл қаладан кет.
Dialogue: 0,0:26:02.76,0:26:06.93,Default,,0000,0000,0000,,Адамның алдаусыз ойыны. Жабыңыз!
Dialogue: 0,0:26:06.93,0:26:08.93,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:26:11.60,0:26:16.61,Default,,0000,0000,0000,,Бұл не? Тездетіп, жабыңыз, кедейліктің Құдайы.
Dialogue: 0,0:26:11.60,0:26:16.61,Default,,0000,0000,0000,,Бұл еркектік емес, солай ма? Эй!
Dialogue: 0,0:26:16.61,0:26:20.61,Default,,0000,0000,0000,,Шатаспаңыз!
Dialogue: 0,0:26:16.61,0:26:20.61,Default,,0000,0000,0000,,Мен кейін ешқандай шағым естімеймін, құбыжық мысық!
Dialogue: 0,0:26:31.46,0:26:33.76,Default,,0000,0000,0000,,Осы жолмен.
Dialogue: 0,0:26:42.90,0:26:46.40,Default,,0000,0000,0000,,Қ–… Сен, порноман!
Dialogue: 0,0:26:42.90,0:26:46.40,Default,,0000,0000,0000,,Бұл Оменің жоғалуы, Кедейлік Құдайы.
Dialogue: 0,0:26:46.40,0:26:48.41,Default,,0000,0000,0000,,Менікі ұзын.
Dialogue: 0,0:26:48.41,0:26:50.71,Default,,0000,0000,0000,,Ах! Қарғыс атқыр...
Dialogue: 0,0:26:56.08,0:26:58.25,Default,,0000,0000,0000,,Сіз жеңдіңіз, Йокчан!
Dialogue: 0,0:26:58.25,0:27:01.25,Default,,0000,0000,0000,,Осымен сіздің сәттіліктеріңіз қалпына келеді!
Dialogue: 0,0:27:01.25,0:27:06.66,Default,,0000,0000,0000,,А... қарғыс атсын!
Dialogue: 0,0:27:20.77,0:27:22.97,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:27:28.78,0:27:43.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:43.06,0:27:48.40,Default,,0000,0000,0000,,Кішкене ғана.
Dialogue: 0,0:27:43.06,0:27:48.40,Default,,0000,0000,0000,,Соңғы пойыз жүрді, бірақ?
Dialogue: 0,0:27:48.40,0:27:50.40,Default,,0000,0000,0000,,Хмм... әлдеқашан?
Dialogue: 0,0:27:50.40,0:27:52.90,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:27:52.90,0:27:55.41,Default,,0000,0000,0000,,Сізді біреу күтіп тұрды ма?
Dialogue: 0,0:27:55.41,0:27:58.11,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:28:07.92,0:28:10.22,Default,,0000,0000,0000,,Сізге қолшатыр бере аламын ба?
Dialogue: 0,0:28:23.10,0:28:25.20,Default,,0000,0000,0000,,Не істеп жүрсің?
Dialogue: 0,0:28:29.77,0:28:31.78,Default,,0000,0000,0000,,Сіз қарбыз жейсіз бе?
Dialogue: 0,0:28:31.78,0:28:35.21,Default,,0000,0000,0000,,Қажет емес.
Dialogue: 0,0:28:35.21,0:28:37.22,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:28:37.22,0:28:39.42,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:28:43.56,0:28:46.16,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:28:51.73,0:28:56.07,Default,,0000,0000,0000,,♬ «Үй барған сайын алыстап барады».
Dialogue: 0,0:28:56.07,0:29:00.74,Default,,0000,0000,0000,,♬ «Ол неғұрлым алыс болса, соғұрлым алыстайды».
Dialogue: 0,0:29:00.74,0:29:05.24,Default,,0000,0000,0000,,♬ «Үй барған сайын алыстап барады».
Dialogue: 0,0:29:07.25,0:29:11.58,Default,,0000,0000,0000,,Балалар сендер осында болдыңдар, солай ма?
Dialogue: 0,0:29:11.58,0:29:14.19,Default,,0000,0000,0000,,Ол үлкейіп бара жатқан жоқ па?
Dialogue: 0,0:29:16.42,0:29:18.42,Default,,0000,0000,0000,,P. Piyo pipi.
Dialogue: 0,0:29:18.42,0:29:20.76,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:29:20.76,0:29:23.60,Default,,0000,0000,0000,,Әйтеуір, 5 күн ұстадым.
Dialogue: 0,0:29:20.76,0:29:23.60,Default,,0000,0000,0000,,Мен сені аяймын.
Dialogue: 0,0:29:23.60,0:29:25.76,Default,,0000,0000,0000,,Пиопио.
Dialogue: 0,0:29:25.76,0:29:29.10,Default,,0000,0000,0000,,Пё.
Dialogue: 0,0:29:25.76,0:29:29.10,Default,,0000,0000,0000,,Ал, мен не істерімді білмеймін.
Dialogue: 0,0:29:29.10,0:29:31.44,Default,,0000,0000,0000,,Жақында кездескенше, Пи Пи.
Dialogue: 0,0:29:31.44,0:29:35.21,Default,,0000,0000,0000,,Дыбыстық сигнал… дыбыстық сигнал!
Dialogue: 0,0:29:31.44,0:29:35.21,Default,,0000,0000,0000,,Ауырды. Ол аурады. не?
Dialogue: 0,0:29:35.21,0:29:37.38,Default,,0000,0000,0000,,Пиопио.
Dialogue: 0,0:29:35.21,0:29:37.38,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:29:37.38,0:29:40.21,Default,,0000,0000,0000,,Дыбыстық сигнал. Пиё пиё пи…
Dialogue: 0,0:29:40.21,0:29:43.21,Default,,0000,0000,0000,,Ой, ойық?
Dialogue: 0,0:29:43.21,0:29:48.89,Default,,0000,0000,0000,,Пипиё пипиё….
Dialogue: 0,0:29:48.89,0:29:52.06,Default,,0000,0000,0000,,Ах~ Артқы тауда
Dialogue: 0,0:29:48.89,0:29:52.06,Default,,0000,0000,0000,,Мен мұндай жерасты өткелі болады деп ойламаппын➡
Dialogue: 0,0:29:52.06,0:29:54.36,Default,,0000,0000,0000,,Мен мұны білмедім.
Dialogue: 0,0:29:58.90,0:30:02.07,Default,,0000,0000,0000,,Няха!
Dialogue: 0,0:30:02.07,0:30:04.07,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:30:04.07,0:30:06.07,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:30:08.91,0:30:12.41,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:30:12.41,0:30:15.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:30:12.41,0:30:15.41,Default,,0000,0000,0000,,Дабыл!
Dialogue: 0,0:30:15.41,0:30:18.92,Default,,0000,0000,0000,,Әй, не? Не?
Dialogue: 0,0:30:18.92,0:30:21.42,Default,,0000,0000,0000,,Пипиё. Бип!
Dialogue: 0,0:30:21.42,0:30:23.76,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:30:23.76,0:30:29.09,Default,,0000,0000,0000,,
Dialogue: 0,0:30:29.09,0:30:33.26,Default,,0000,0000,0000,,Не? Бұл үлкен бақа.
Dialogue: 0,0:30:33.26,0:30:35.60,Default,,0000,0000,0000,,🗧Жақсы.
Dialogue: 0,0:30:33.26,0:30:35.60,Default,,0000,0000,0000,,🗧Жақсы.
Dialogue: 0,0:30:35.60,0:30:39.10,Default,,0000,0000,0000,,Күтілгендей.
Dialogue: 0,0:30:35.60,0:30:39.10,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:30:39.10,0:30:43.11,Default,,0000,0000,0000,,Ах... Қаланың арғы жағындағы гольф алаңы?
Dialogue: 0,0:30:43.11,0:30:46.41,Default,,0000,0000,0000,,Фуга! Не!
Dialogue: 0,0:30:48.45,0:30:51.78,Default,,0000,0000,0000,,Сен ештеңе емессің.
Dialogue: 0,0:30:51.78,0:30:56.29,Default,,0000,0000,0000,,Мен ұлы құбыжық бақамын! Джеро Джеро!
Dialogue: 0,0:30:56.29,0:30:58.62,Default,,0000,0000,0000,,Жоқ, мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:30:58.62,0:31:02.96,Default,,0000,0000,0000,,Дыбыстық сигнал. Дыбыстық сигнал дыбыстық сигнал.
Dialogue: 0,0:31:02.96,0:31:04.96,Default,,0000,0000,0000,,Храмдық мысық?
Dialogue: 0,0:31:04.96,0:31:07.13,Default,,0000,0000,0000,,Пи Пи Чан
Dialogue: 0,0:31:04.96,0:31:07.13,Default,,0000,0000,0000,,Мен сізге кіруіңізді айтамын➡
Dialogue: 0,0:31:07.13,0:31:09.30,Default,,0000,0000,0000,,Мен сенімен бірге келдім.
Dialogue: 0,0:31:09.30,0:31:14.64,Default,,0000,0000,0000,,Пи Пи Чан?
Dialogue: 0,0:31:09.30,0:31:14.64,Default,,0000,0000,0000,,А, бұл орман перісі.
Dialogue: 0,0:31:14.64,0:31:17.94,Default,,0000,0000,0000,,Ал, отырыңыз.
Dialogue: 0,0:31:24.65,0:31:26.82,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:31:26.82,0:31:30.99,Default,,0000,0000,0000,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:31:26.82,0:31:30.99,Default,,0000,0000,0000,,Ұйқы және ояту...
Dialogue: 0,0:31:30.99,0:31:33.76,Default,,0000,0000,0000,,Ал, ішіңіз.
Dialogue: 0,0:31:33.76,0:31:38.43,Default,,0000,0000,0000,,Өйткені ор қазу – менің хоббиім.
Dialogue: 0,0:31:33.76,0:31:38.43,Default,,0000,0000,0000,,Жалықсам ор қазып ойнаймын.
Dialogue: 0,0:31:38.43,0:31:40.77,Default,,0000,0000,0000,,Уау, бұл керемет.
Dialogue: 0,0:31:40.77,0:31:43.27,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:31:47.77,0:31:50.28,Default,,0000,0000,0000,,Мен оны өткен айда таптым.
Dialogue: 0,0:31:50.28,0:31:54.28,Default,,0000,0000,0000,,Керемет. ыстық көктем?
Dialogue: 0,0:31:50.28,0:31:54.28,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:31:54.28,0:31:56.61,Default,,0000,0000,0000,,Няха!
Dialogue: 0,0:31:56.61,0:32:00.79,Default,,0000,0000,0000,,Құсу!
Dialogue: 0,0:32:00.79,0:32:03.96,Default,,0000,0000,0000,,Бұл тамаша ыстық бұлақ! Құсу!
Dialogue: 0,0:32:03.96,0:32:09.29,Default,,0000,0000,0000,,Няхахахаха! Бұл керемет, мияу!
Dialogue: 0,0:32:09.29,0:32:13.30,Default,,0000,0000,0000,,(телефонның қоңырау үні)
Dialogue: 0,0:32:13.30,0:32:15.70,Default,,0000,0000,0000,,📱Мен қазір телефондамын...
Dialogue: 0,0:32:13.30,0:32:15.70,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:32:19.97,0:32:23.64,Default,,0000,0000,0000,,Екеуің де осылай тұрсыңдар.
Dialogue: 0,0:32:23.64,0:32:26.81,Default,,0000,0000,0000,,(Анасы мен қызының күлкісі)
Dialogue: 0,0:32:26.81,0:32:28.98,Default,,0000,0000,0000,,Сіз оны көре аласыз ба? Эй.
Dialogue: 0,0:32:28.98,0:32:32.98,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:32:28.98,0:32:32.98,Default,,0000,0000,0000,,Кяхаха!
Dialogue: 0,0:32:52.27,0:32:54.94,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:32:52.27,0:32:54.94,Default,,0000,0000,0000,,Біз де бара аламыз ба?
Dialogue: 0,0:32:54.94,0:32:57.64,Default,,0000,0000,0000,,Бұл жақсы емес пе? Джеро Джеро.
Dialogue: 0,0:33:00.45,0:33:02.95,Default,,0000,0000,0000,,Қайырлы кеш!
Dialogue: 0,0:33:05.78,0:33:09.69,Default,,0000,0000,0000,,Олар көптеп келді.
Dialogue: 0,0:33:05.78,0:33:09.69,Default,,0000,0000,0000,,Енгізу.
Dialogue: 0,0:33:19.13,0:33:22.30,Default,,0000,0000,0000,,Дыбыстық сигнал.
Dialogue: 0,0:33:22.30,0:33:25.30,Default,,0000,0000,0000,,Керот Керот.
Dialogue: 0,0:33:31.64,0:33:34.75,Default,,0000,0000,0000,,Саған ғибадатхананы көрсетейін бе?
Dialogue: 0,0:33:45.26,0:33:47.76,Default,,0000,0000,0000,,Барлығы жарасып жатыр ма?
Dialogue: 0,0:33:47.76,0:33:50.26,Default,,0000,0000,0000,,Жақын болмасақ та ➡
Dialogue: 0,0:33:50.26,0:33:54.27,Default,,0000,0000,0000,,Мен қазған шұңқырда тұрады.
Dialogue: 0,0:33:54.27,0:33:58.27,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:33:58.27,0:34:00.94,Default,,0000,0000,0000,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:34:00.94,0:34:03.61,Default,,0000,0000,0000,,Түнде не істеп жатырсың?
Dialogue: 0,0:34:03.61,0:34:06.91,Default,,0000,0000,0000,,Иә? Банкет.
Dialogue: 0,0:34:11.28,0:34:13.68,Default,,0000,0000,0000,,Who?
Dialogue: 0,0:34:20.96,0:34:23.96,Default,,0000,0000,0000,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:34:20.96,0:34:23.96,Default,,0000,0000,0000,,Карин-чан, сен жалғызсың ба?
Dialogue: 0,0:34:23.96,0:34:26.13,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:34:23.96,0:34:26.13,Default,,0000,0000,0000,,(Құбыжықтардың жылаған дауыстары)
Dialogue: 0,0:34:26.13,0:34:29.80,Default,,0000,0000,0000,,Каринді әкесі тастап кеткен
Dialogue: 0,0:34:26.13,0:34:29.80,Default,,0000,0000,0000,,Мен жалғызбын.
Dialogue: 0,0:34:29.80,0:34:33.81,Default,,0000,0000,0000,,Уф... байғұс...
Dialogue: 0,0:34:35.74,0:34:39.08,Default,,0000,0000,0000,,Осыдан үш жыл бұрын менің анам да қайтыс болды➡
Dialogue: 0,0:34:39.08,0:34:41.75,Default,,0000,0000,0000,,Бұрылатын ешкім жоқ.
Dialogue: 0,0:34:41.75,0:34:46.75,Default,,0000,0000,0000,,(Құбыжықтардың жылаған дауыстары)
Dialogue: 0,0:34:46.75,0:34:50.76,Default,,0000,0000,0000,,Ал менде мүлде ақша жоқ.
Dialogue: 0,0:34:57.60,0:34:59.60,Default,,0000,0000,0000,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:34:59.60,0:35:05.10,Default,,0000,0000,0000,,(Құбыжықтардың жылаған дауыстары)
Dialogue: 0,0:35:05.10,0:35:07.77,Default,,0000,0000,0000,,Біз... сіздің артыңыздан келе жатырмыз.
Dialogue: 0,0:35:07.77,0:35:09.77,Default,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:35:09.77,0:35:13.44,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:35:09.77,0:35:13.44,Default,,0000,0000,0000,,Барлығы мейірімді көрінеді.
Dialogue: 0,0:35:13.44,0:35:20.75,Default,,0000,0000,0000,,(Құбыжықтардың жылаған дауыстары)
Dialogue: 0,0:35:24.79,0:35:26.79,Default,,0000,0000,0000,,Ння….
Dialogue: 0,0:35:28.96,0:35:31.16,Default,,0000,0000,0000,,Тағы да оралып келдім
Dialogue: 0,0:35:34.73,0:35:38.24,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:35:48.08,0:35:50.25,Default,,0000,0000,0000,,Барлығы үйіне кетті ме?
Dialogue: 0,0:35:50.25,0:35:52.92,Default,,0000,0000,0000,,Ей, мен саған қоңырау шалу үшін қиналдым➡
Dialogue: 0,0:35:52.92,0:35:56.59,Default,,0000,0000,0000,,Мүлде араласпаңыз
Dialogue: 0,0:35:52.92,0:35:56.59,Default,,0000,0000,0000,,Қалағаныңды істе.
Dialogue: 0,0:35:56.59,0:35:59.19,Default,,0000,0000,0000,,Олар қызықсыз.
Dialogue: 0,0:35:56.59,0:35:59.19,Default,,0000,0000,0000,,Енді маған қоңырау шалмаңыз.
Dialogue: 0,0:36:01.59,0:36:05.20,Default,,0000,0000,0000,,Иә? Дегенмен олар жақсы адамдар еді.
Dialogue: 0,0:36:08.60,0:36:11.20,Default,,0000,0000,0000,,Өтірікші Карин-чан.
Dialogue: 0,0:36:13.44,0:36:15.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:36:15.61,0:36:19.78,Default,,0000,0000,0000,,Әкең сені тастап кетті ме?
Dialogue: 0,0:36:15.61,0:36:19.78,Default,,0000,0000,0000,,Бұл өтірік.
Dialogue: 0,0:36:19.78,0:36:22.28,Default,,0000,0000,0000,,Иә? Бұл өтірік емес.
Dialogue: 0,0:36:22.28,0:36:24.28,Default,,0000,0000,0000,,Бұл өтірік.
Dialogue: 0,0:36:28.29,0:36:31.62,Default,,0000,0000,0000,,Ол мүлде қайтып келмейді.
Dialogue: 0,0:36:31.62,0:36:34.43,Default,,0000,0000,0000,,Қайдасың? Айтып көріңіз!
Dialogue: 0,0:36:37.56,0:36:40.40,Default,,0000,0000,0000,,Ол уәдесін бұзды.
Dialogue: 0,0:36:40.40,0:36:42.57,Default,,0000,0000,0000,,Анамның дүниеден өткен күнінде
Dialogue: 0,0:36:40.40,0:36:42.57,Default,,0000,0000,0000,,Қайтып келу➡
Dialogue: 0,0:36:42.57,0:36:45.90,Default,,0000,0000,0000,,Кездейсоқ нәрселерді айту.
Dialogue: 0,0:36:45.90,0:36:49.74,Default,,0000,0000,0000,,Бір жерде тіпті әйел де жасау керек.
Dialogue: 0,0:36:45.90,0:36:49.74,Default,,0000,0000,0000,,Мен ойнап жатырмын.
Dialogue: 0,0:36:49.74,0:36:51.94,Default,,0000,0000,0000,,Мүлдем.
Dialogue: 0,0:36:54.08,0:36:58.08,Default,,0000,0000,0000,,Бұл солай емес пе?
Dialogue: 0,0:36:58.08,0:37:00.92,Default,,0000,0000,0000,,Нені білмейсің?
Dialogue: 0,0:37:00.92,0:37:04.09,Default,,0000,0000,0000,,Мен әрқашан онымен бірге болдым.
Dialogue: 0,0:37:04.09,0:37:07.59,Default,,0000,0000,0000,,Мен ең жақсымын
Dialogue: 0,0:37:04.09,0:37:07.59,Default,,0000,0000,0000,,Сіз ол туралы білесіз бе?
Dialogue: 0,0:37:07.59,0:37:12.10,Default,,0000,0000,0000,,Құбыжық мысық болғанына қарамастан
Dialogue: 0,0:37:07.59,0:37:12.10,Default,,0000,0000,0000,,Бастық болмаңыз!
Dialogue: 0,0:37:23.94,0:37:25.94,Default,,0000,0000,0000,,Киотодан келген вице-канцлер де сол жоғары лауазымды тұлғалардың бірі ғой, иә?
Dialogue: 0,0:37:29.61,0:37:31.72,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:37:36.39,0:37:39.09,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:37:49.90,0:37:52.07,Default,,0000,0000,0000,,Бұл Карин-чандікі
Dialogue: 0,0:37:49.90,0:37:52.07,Default,,0000,0000,0000,,Себебі бұл толық емес жұмыс күні ➡
Dialogue: 0,0:37:52.07,0:37:54.07,Default,,0000,0000,0000,,Оны қолданбаңыз.
Dialogue: 0,0:37:54.07,0:37:57.17,Default,,0000,0000,0000,,Мүлдем жоқ!
Dialogue: 0,0:37:59.41,0:38:02.61,Default,,0000,0000,0000,,Майка.
Dialogue: 0,0:37:59.41,0:38:02.61,Default,,0000,0000,0000,,Тек оны көбейтіңіз, nya.
Dialogue: 0,0:38:07.08,0:38:12.39,Default,,0000,0000,0000,,Жоқ, мен жеңілдім.
Dialogue: 0,0:38:07.08,0:38:12.39,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:38:15.76,0:38:19.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:38:19.60,0:38:24.90,Default,,0000,0000,0000,,Иә? Бұл біртүрлі. велосипед….
Dialogue: 0,0:38:29.94,0:38:34.88,Default,,0000,0000,0000,,Не? Жоқ, жоқ, жоқ... жоқ
Dialogue: 0,0:38:29.94,0:38:34.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:38:34.88,0:38:38.08,Default,,0000,0000,0000,,Мынау... иә, бұл өтірік! ?
Dialogue: 0,0:38:46.89,0:38:49.59,Default,,0000,0000,0000,,Олар ұқсас, бірақ әртүрлі...
Dialogue: 0,0:38:53.23,0:38:55.90,Default,,0000,0000,0000,,Бауырым, не болды?
Dialogue: 0,0:38:55.90,0:38:58.74,Default,,0000,0000,0000,,Инуэдегі Хаяши?
Dialogue: 0,0:38:58.74,0:39:02.24,Default,,0000,0000,0000,,Менің велосипедімді ұрлап кетті.
Dialogue: 0,0:39:02.24,0:39:04.91,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:39:04.91,0:39:07.91,Default,,0000,0000,0000,,Қарғыс атсын, бұл еш жерде емес.
Dialogue: 0,0:39:07.91,0:39:10.25,Default,,0000,0000,0000,,Біз де сені іздейміз.
Dialogue: 0,0:39:10.25,0:39:14.59,Default,,0000,0000,0000,,№.
Dialogue: 0,0:39:10.25,0:39:14.59,Default,,0000,0000,0000,,Не? А... иә.
Dialogue: 0,0:39:14.59,0:39:17.76,Default,,0000,0000,0000,,Хаяши, не болды?
Dialogue: 0,0:39:17.76,0:39:19.76,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:39:17.76,0:39:19.76,Default,,0000,0000,0000,,Диарея?
Dialogue: 0,0:39:19.76,0:39:23.16,Default,,0000,0000,0000,,Аа… ааа….
Dialogue: 0,0:39:25.43,0:39:28.93,Default,,0000,0000,0000,,Әзіл.
Dialogue: 0,0:39:28.93,0:39:31.77,Default,,0000,0000,0000,,Адамдардың заттары не деп ойлайсыңдар?
Dialogue: 0,0:39:31.77,0:39:34.37,Default,,0000,0000,0000,,Не... Пышақ не болды?
Dialogue: 0,0:39:34.37,0:39:37.71,Default,,0000,0000,0000,,Қылмыскер бейбақ...
Dialogue: 0,0:39:34.37,0:39:37.71,Default,,0000,0000,0000,,Тапсаң, жетпейді.
Dialogue: 0,0:39:37.71,0:39:39.71,Default,,0000,0000,0000,,Мен сені өлтіремін...
Dialogue: 0,0:39:43.55,0:39:46.55,Default,,0000,0000,0000,,Сәлем! Ах...
Dialogue: 0,0:39:46.55,0:39:49.72,Default,,0000,0000,0000,,Бейбақ, өл, өл, өл.
Dialogue: 0,0:39:49.72,0:39:53.22,Default,,0000,0000,0000,,Міне! Міне осы!
Dialogue: 0,0:39:49.72,0:39:53.22,Default,,0000,0000,0000,,Міне! Бұл...
Dialogue: 0,0:39:53.22,0:39:55.23,Default,,0000,0000,0000,,Мен саған жаңасын сатып аламын!
Dialogue: 0,0:39:55.23,0:39:57.39,Default,,0000,0000,0000,,Мәселе бұл емес.
Dialogue: 0,0:39:55.23,0:39:57.39,Default,,0000,0000,0000,,Ошо-сан.
Dialogue: 0,0:39:57.39,0:40:00.73,Default,,0000,0000,0000,,Біреудің велосипедін ұрлау
Dialogue: 0,0:39:57.39,0:40:00.73,Default,,0000,0000,0000,,Мен мұндай ашуланшақтықты кешіре алмаймын.
Dialogue: 0,0:40:00.73,0:40:03.07,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:40:00.73,0:40:03.07,Default,,0000,0000,0000,,Өл, мені өлтір! Мен сені өлтіремін!
Dialogue: 0,0:40:03.07,0:40:05.24,Default,,0000,0000,0000,,Мені өлтір! Мені өлтір...
Dialogue: 0,0:40:05.24,0:40:07.24,Default,,0000,0000,0000,,Анзу-чан түсіндім!
Dialogue: 0,0:40:05.24,0:40:07.24,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:40:07.24,0:40:09.91,Default,,0000,0000,0000,,Дұрыс, Ошо-сан➡
Dialogue: 0,0:40:09.91,0:40:12.41,Default,,0000,0000,0000,,Менің көңілім қалды!
Dialogue: 0,0:40:12.41,0:40:16.58,Default,,0000,0000,0000,,Түсіндім, түсіндім! Тоқта, тоқта!
Dialogue: 0,0:40:12.41,0:40:16.58,Default,,0000,0000,0000,,Міне! Коньяро….
Dialogue: 0,0:40:16.58,0:40:18.75,Default,,0000,0000,0000,,Өл! Өл...
Dialogue: 0,0:40:18.75,0:40:20.95,Default,,0000,0000,0000,,Гү… гүг… Дұрыс.
Dialogue: 0,0:40:18.75,0:40:20.95,Default,,0000,0000,0000,,Өл! Өл!
Dialogue: 0,0:40:23.75,0:40:25.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:40:30.93,0:40:33.23,Default,,0000,0000,0000,,Өйткені, эй.
Dialogue: 0,0:40:35.60,0:40:37.60,Default,,0000,0000,0000,,Бақа-чан?
Dialogue: 0,0:40:39.77,0:40:41.77,Default,,0000,0000,0000,,Бұл алғаш рет.
Dialogue: 0,0:40:43.94,0:40:46.11,Default,,0000,0000,0000,,Керемет кадр!
Dialogue: 0,0:40:46.11,0:40:51.12,Default,,0000,0000,0000,,Жоқ, сен шынымен жақсысың.
Dialogue: 0,0:40:46.11,0:40:51.12,Default,,0000,0000,0000,,Күтілгендей!
Dialogue: 0,0:40:56.29,0:40:58.29,Default,,0000,0000,0000,,Аа, қашаннан бері?
Dialogue: 0,0:40:58.29,0:41:00.29,Default,,0000,0000,0000,,Кеше.
Dialogue: 0,0:41:00.29,0:41:06.13,Default,,0000,0000,0000,,Карин-чанның мүмкіндігінше көп ақша табыңыз
Dialogue: 0,0:41:00.29,0:41:06.13,Default,,0000,0000,0000,,Бұл пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:41:06.13,0:41:08.97,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:41:08.97,0:41:12.47,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:41:08.97,0:41:12.47,Default,,0000,0000,0000,,Мен мұны сатып алдым.
Dialogue: 0,0:41:12.47,0:41:14.47,Default,,0000,0000,0000,,Лотерея.
Dialogue: 0,0:41:21.81,0:41:26.15,Default,,0000,0000,0000,,Балалар... жақсы балалар сияқтысыңдар.
Dialogue: 0,0:41:26.15,0:41:29.15,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ….
Dialogue: 0,0:41:31.16,0:41:33.46,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:41:35.76,0:41:39.76,Default,,0000,0000,0000,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:41:35.76,0:41:39.76,Default,,0000,0000,0000,,Менің айтатын нәрсем бар...
Dialogue: 0,0:41:39.76,0:41:42.27,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:41:42.27,0:41:49.17,Default,,0000,0000,0000,,А... аа... у...
Dialogue: 0,0:42:04.29,0:42:06.46,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:42:06.46,0:42:11.46,Default,,0000,0000,0000,,Кешіріңіз, аға!
Dialogue: 0,0:42:11.46,0:42:14.63,Default,,0000,0000,0000,,Велосипедті мен алғанмын.
Dialogue: 0,0:42:14.63,0:42:18.97,Default,,0000,0000,0000,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:42:18.97,0:42:20.97,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:42:20.97,0:42:25.14,Default,,0000,0000,0000,,Карин-чан сұрады
Dialogue: 0,0:42:20.97,0:42:25.14,Default,,0000,0000,0000,,Менің таңдауым жоқ...
Dialogue: 0,0:42:25.14,0:42:30.15,Default,,0000,0000,0000,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,0:42:25.14,0:42:30.15,Default,,0000,0000,0000,,Уф, кешіріңіз...
Dialogue: 0,0:42:30.15,0:42:33.15,Default,,0000,0000,0000,,Мен түсіндім. Бұл жеткілікті.
Dialogue: 0,0:42:35.09,0:42:40.89,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:42:35.09,0:42:40.89,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:42:49.77,0:42:54.10,Default,,0000,0000,0000,,Tsk! Бұл қайда?
Dialogue: 0,0:42:54.10,0:42:58.28,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:42:54.10,0:42:58.28,Default,,0000,0000,0000,,Токиоға жаяу баруға болады.
Dialogue: 0,0:42:58.28,0:43:00.61,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:43:00.61,0:43:05.22,Default,,0000,0000,0000,,(жабайы иттің үруі)
Dialogue: 0,0:43:12.29,0:43:14.79,Default,,0000,0000,0000,,Мен Карин-чанды көрмеймін
Dialogue: 0,0:43:12.29,0:43:14.79,Default,,0000,0000,0000,,Сен қайда бардың?
Dialogue: 0,0:43:14.79,0:43:16.96,Default,,0000,0000,0000,,Ал, мен білмеймін.
Dialogue: 0,0:43:16.96,0:43:21.63,Default,,0000,0000,0000,,Жақында кешкі ас беріледі.
Dialogue: 0,0:43:16.96,0:43:21.63,Default,,0000,0000,0000,,Маған қоңырау шалыңыз.
Dialogue: 0,0:43:21.63,0:43:24.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:43:26.80,0:43:29.01,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:43:36.75,0:43:40.95,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:43:44.42,0:43:46.42,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:43:46.42,0:43:48.43,Default,,0000,0000,0000,,(Қариннің айқайы)
Dialogue: 0,0:43:51.93,0:43:56.73,Default,,0000,0000,0000,,Карин-чан, кешкі астың уақыты.
Dialogue: 0,0:43:51.93,0:43:56.73,Default,,0000,0000,0000,,Каринчан.
Dialogue: 0,0:44:01.11,0:44:05.11,Default,,0000,0000,0000,,Хахаха…. Қат!
Dialogue: 0,0:44:05.11,0:44:08.28,Default,,0000,0000,0000,,Мен осындай жерде өлсем бола ма?
Dialogue: 0,0:44:08.28,0:44:11.48,Default,,0000,0000,0000,,Уау! Ақымақ!
Dialogue: 0,0:44:13.45,0:44:15.45,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:44:15.45,0:44:18.46,Default,,0000,0000,0000,,Каринчан?
Dialogue: 0,0:44:31.30,0:44:35.91,Default,,0000,0000,0000,,Карин-чан? Каринчан?
Dialogue: 0,0:44:35.91,0:44:51.26,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:44:51.26,0:44:54.09,Default,,0000,0000,0000,,((🎙️Карин Накамура
Dialogue: 0,0:44:51.26,0:44:54.09,Default,,0000,0000,0000,,Тұр!
Dialogue: 0,0:44:54.09,0:44:57.09,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін жаса, барыңды істе!
Dialogue: 0,0:44:57.09,0:45:09.27,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:09.27,0:45:11.78,Default,,0000,0000,0000,,Анашым! Хехехе! ))
Dialogue: 0,0:45:11.78,0:45:28.79,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:28.79,0:45:33.56,Default,,0000,0000,0000,,Құсу. Джеро Джеро.
Dialogue: 0,0:45:33.56,0:45:35.57,Default,,0000,0000,0000,,Уау! Карин-чан! ?
Dialogue: 0,0:45:35.57,0:45:38.40,Default,,0000,0000,0000,,Құсу құсу құсу
Dialogue: 0,0:45:35.57,0:45:38.40,Default,,0000,0000,0000,,Не болды? Карин-чан.
Dialogue: 0,0:45:38.40,0:45:41.24,Default,,0000,0000,0000,,Құсу құсу құсу.
Dialogue: 0,0:45:41.24,0:45:45.08,Default,,0000,0000,0000,,Каринчан?
Dialogue: 0,0:45:45.08,0:45:47.18,Default,,0000,0000,0000,,Карин-чан?
Dialogue: 0,0:45:51.58,0:45:54.08,Default,,0000,0000,0000,,Каринчан.
Dialogue: 0,0:45:57.92,0:46:00.12,Default,,0000,0000,0000,,Каринчан!
Dialogue: 0,0:46:02.09,0:46:04.09,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:46:04.09,0:46:07.10,Default,,0000,0000,0000,,Е, Карин-чан! ?
Dialogue: 0,0:46:07.10,0:46:13.44,Default,,0000,0000,0000,,А, ыстық су жақсы...
Dialogue: 0,0:46:07.10,0:46:13.44,Default,,0000,0000,0000,,Мұндағы сияқты. Хехе!
Dialogue: 0,0:46:13.44,0:46:15.44,Default,,0000,0000,0000,,Ваннаға түскеннен кейін бақа-чан➡
Dialogue: 0,0:46:15.44,0:46:17.78,Default,,0000,0000,0000,,суық нәрсе
Dialogue: 0,0:46:15.44,0:46:17.78,Default,,0000,0000,0000,,Мен сусын алғым келеді.
Dialogue: 0,0:46:17.78,0:46:21.48,Default,,0000,0000,0000,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:46:17.78,0:46:21.48,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:46:23.45,0:46:27.75,Default,,0000,0000,0000,,Жұмақ Жұмақ! Ах~.
Dialogue: 0,0:46:30.62,0:46:33.89,Default,,0000,0000,0000,,Ах! Итита Карин-чан.
Dialogue: 0,0:46:33.89,0:46:36.89,Default,,0000,0000,0000,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:46:36.89,0:46:39.56,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:46:39.56,0:46:42.90,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:46:42.90,0:46:47.91,Default,,0000,0000,0000,,Қазірдің өзінде кеш. Эй, үйге барайық.
Dialogue: 0,0:46:42.90,0:46:47.91,Default,,0000,0000,0000,,Ошо-сан уайымдап отыр.
Dialogue: 0,0:46:47.91,0:46:49.91,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:46:53.91,0:46:57.08,Default,,0000,0000,0000,,Иә! Уи неге?
Dialogue: 0,0:46:57.08,0:46:59.38,Default,,0000,0000,0000,,Янано - Янано.
Dialogue: 0,0:47:03.75,0:47:06.59,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:47:06.59,0:47:09.09,Default,,0000,0000,0000,,Сіз менің велосипедімді алдыңыз.
Dialogue: 0,0:47:09.09,0:47:11.09,Default,,0000,0000,0000,,Мен оны алған жоқпын.
Dialogue: 0,0:47:11.09,0:47:13.93,Default,,0000,0000,0000,,Өтірікші Карин-чан.
Dialogue: 0,0:47:13.93,0:47:17.27,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:47:13.93,0:47:17.27,Default,,0000,0000,0000,,Ұры Карин-чан.
Dialogue: 0,0:47:17.27,0:47:20.77,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:47:20.77,0:47:23.61,Default,,0000,0000,0000,,күрсіну...
Dialogue: 0,0:47:23.61,0:47:27.44,Default,,0000,0000,0000,,Сен өте қиын бала екенсің.
Dialogue: 0,0:47:27.44,0:47:30.95,Default,,0000,0000,0000,,Карин-чан
Dialogue: 0,0:47:27.44,0:47:30.95,Default,,0000,0000,0000,,Үйге бару керек.
Dialogue: 0,0:47:33.22,0:47:35.92,Default,,0000,0000,0000,,Мен не істеуім керек...?
Dialogue: 0,0:47:40.89,0:47:43.09,Default,,0000,0000,0000,,Маған қарызға ақша беріңіз.
Dialogue: 0,0:47:45.56,0:47:47.73,Default,,0000,0000,0000,,Жоқ, сондықтан...
Dialogue: 0,0:47:47.73,0:47:51.44,Default,,0000,0000,0000,,Мен Токиоға барамын.
Dialogue: 0,0:47:47.73,0:47:51.44,Default,,0000,0000,0000,,Менің кетуім керек!
Dialogue: 0,0:48:00.24,0:48:02.95,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:48:13.26,0:48:15.26,Default,,0000,0000,0000,,Анзу-чан, мен оны сұрадым.
Dialogue: 0,0:48:15.26,0:48:17.26,Default,,0000,0000,0000,,Бұл тітіркендіргіш.
Dialogue: 0,0:48:17.26,0:48:19.26,Default,,0000,0000,0000,,(Ошо-сан)
Dialogue: 0,0:48:17.26,0:48:19.26,Default,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:48:19.26,0:48:22.77,Default,,0000,0000,0000,,Өйткені сіз ересексіз
Dialogue: 0,0:48:19.26,0:48:22.77,Default,,0000,0000,0000,,Өтінемін, маған қамқорлық жасаңыз.
Dialogue: 0,0:48:22.77,0:48:24.77,Default,,0000,0000,0000,,Ошо-сан, өзің жақсысың ба?
Dialogue: 0,0:48:24.77,0:48:29.94,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:48:24.77,0:48:29.94,Default,,0000,0000,0000,,Екеуің де ыстықтан сақ болыңдар.
Dialogue: 0,0:48:29.94,0:48:32.94,Default,,0000,0000,0000,,Иә. Мен барамын!
Dialogue: 0,0:48:32.94,0:48:35.65,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:48:32.94,0:48:35.65,Default,,0000,0000,0000,,О.
Dialogue: 0,0:48:38.22,0:48:41.39,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:48:41.39,0:48:44.22,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:48:44.22,0:48:46.22,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:48:46.22,0:48:50.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:46.22,0:48:50.23,Default,,0000,0000,0000,,Қазір кетіңіз.
Dialogue: 0,0:49:05.08,0:49:07.08,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:49:07.08,0:49:10.25,Default,,0000,0000,0000,,Тецуя!
Dialogue: 0,0:49:10.25,0:49:12.75,Default,,0000,0000,0000,,Тецуя! Сен ондасың ба?
Dialogue: 0,0:49:12.75,0:49:14.75,Default,,0000,0000,0000,,Мен!
Dialogue: 0,0:49:43.55,0:49:47.22,Default,,0000,0000,0000,,Күтілгендей, ол қайтып келген жоқ.
Dialogue: 0,0:49:47.22,0:49:50.39,Default,,0000,0000,0000,,Қайда кетті деп ойлаймын.
Dialogue: 0,0:49:50.39,0:49:53.09,Default,,0000,0000,0000,,Ол жігіт өлуі керек.
Dialogue: 0,0:50:00.23,0:50:03.13,Default,,0000,0000,0000,,Таку….
Dialogue: 0,0:50:27.76,0:50:32.60,Default,,0000,0000,0000,,Анашым, кешіріңіз.
Dialogue: 0,0:50:32.60,0:50:48.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:50:48.95,0:50:51.62,Default,,0000,0000,0000,,♬ «Қайда бара жатырсың?»
Dialogue: 0,0:50:51.62,0:50:53.62,Default,,0000,0000,0000,,♬ «Әй, қайда барасың?»
Dialogue: 0,0:50:53.62,0:50:56.45,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:50:56.45,0:50:59.26,Default,,0000,0000,0000,,♬ «Қайда бара жатырсың?»
Dialogue: 0,0:51:05.30,0:51:07.30,Default,,0000,0000,0000,,Не? Мұнда.
Dialogue: 0,0:51:07.30,0:51:09.30,Default,,0000,0000,0000,,Ананың бейіті.
Dialogue: 0,0:51:09.30,0:51:11.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:21.48,0:51:25.32,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:51:25.32,0:51:28.49,Default,,0000,0000,0000,,Бұл шкаф стилі.
Dialogue: 0,0:51:28.49,0:51:31.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:28.49,0:51:31.82,Default,,0000,0000,0000,,Біраз ашық емес пе?
Dialogue: 0,0:51:31.82,0:51:33.76,Default,,0000,0000,0000,,Біраз ашық емес пе?
Dialogue: 0,0:51:33.76,0:51:37.26,Default,,0000,0000,0000,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:51:37.26,0:51:39.26,Default,,0000,0000,0000,,Біраз ашық емес пе?
Dialogue: 0,0:51:39.26,0:51:41.26,Default,,0000,0000,0000,,Иә? Не болды деп ойлаймын...
Dialogue: 0,0:51:41.26,0:51:44.17,Default,,0000,0000,0000,,Тұтынушы, не болды?
Dialogue: 0,0:51:53.11,0:51:56.45,Default,,0000,0000,0000,,Ішке кіре алмаймын дегеніңіз не?
Dialogue: 0,0:51:56.45,0:51:58.95,Default,,0000,0000,0000,,Ол ақша төлеген жоқ.
Dialogue: 0,0:52:00.95,0:52:05.79,Default,,0000,0000,0000,,Олай болса, осы жерден бастауға болады.
Dialogue: 0,0:52:00.95,0:52:05.79,Default,,0000,0000,0000,,Қолдарыңызды біріктіріңіз?
Dialogue: 0,0:52:05.79,0:52:08.29,Default,,0000,0000,0000,,Анамның алдында
Dialogue: 0,0:52:05.79,0:52:08.29,Default,,0000,0000,0000,,Қолды дұрыс ұстағым келеді.
Dialogue: 0,0:52:08.29,0:52:10.69,Default,,0000,0000,0000,,Сен ақымақ емессің бе?
Dialogue: 0,0:52:14.13,0:52:16.97,Default,,0000,0000,0000,,Олай болса, Тецуя-кунды іздейік.
Dialogue: 0,0:52:16.97,0:52:20.97,Default,,0000,0000,0000,,Жетеді.
Dialogue: 0,0:52:16.97,0:52:20.97,Default,,0000,0000,0000,,Не? Бірақ ...
Dialogue: 0,0:52:20.97,0:52:23.14,Default,,0000,0000,0000,,Қаласаңыз, жақсы!
Dialogue: 0,0:52:23.14,0:52:26.98,Default,,0000,0000,0000,,Өйткені басқа істейтін ештеңе жоқ
Dialogue: 0,0:52:23.14,0:52:26.98,Default,,0000,0000,0000,,Бір жерде ойнағың келе ме?
Dialogue: 0,0:52:26.98,0:52:29.31,Default,,0000,0000,0000,,Токио Бұл сіздің бірінші ретіңіз, солай ма?
Dialogue: 0,0:52:29.31,0:52:34.08,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:52:29.31,0:52:34.08,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ... Солай ма?
Dialogue: 0,0:52:34.08,0:52:36.09,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:52:34.08,0:52:36.09,Default,,0000,0000,0000,,Менің барғым келетін жер жоқ...
Dialogue: 0,0:52:36.09,0:52:39.26,Default,,0000,0000,0000,,Мен жалғыз қалғым келеді!
Dialogue: 0,0:52:39.26,0:52:41.26,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:52:41.26,0:52:45.16,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:52:59.28,0:53:01.44,Default,,0000,0000,0000,,Шуйчи-кун.
Dialogue: 0,0:53:01.44,0:53:04.45,Default,,0000,0000,0000,,Карин-чан.
Dialogue: 0,0:53:01.44,0:53:04.45,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:53:04.45,0:53:08.12,Default,,0000,0000,0000,,Сіз бұл жерде соңғы кездері мүлде болмағансыз.
Dialogue: 0,0:53:08.12,0:53:13.46,Default,,0000,0000,0000,,Көп нәрсе болды...
Dialogue: 0,0:53:08.12,0:53:13.46,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:53:13.46,0:53:15.66,Default,,0000,0000,0000,,Уақытыңыз бар ма?
Dialogue: 0,0:53:17.63,0:53:19.80,Default,,0000,0000,0000,,Жоқ, Токиодағы крептер
Dialogue: 0,0:53:17.63,0:53:19.80,Default,,0000,0000,0000,,Бұл сәл басқаша!
Dialogue: 0,0:53:19.80,0:53:22.97,Default,,0000,0000,0000,,Бұл жаңа өнім.
Dialogue: 0,0:53:22.97,0:53:26.30,Default,,0000,0000,0000,,А, бұл дәмді көрінеді.
Dialogue: 0,0:53:22.97,0:53:26.30,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:53:26.30,0:53:28.97,Default,,0000,0000,0000,,Иә, тегіс.
Dialogue: 0,0:53:26.30,0:53:28.97,Default,,0000,0000,0000,,Танжироның дәрісін ішу оңай ғой, иә? Иә?
Dialogue: 0,0:53:28.97,0:53:33.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:53:28.97,0:53:33.08,Default,,0000,0000,0000,,Жаңа.
Dialogue: 0,0:53:33.08,0:53:35.38,Default,,0000,0000,0000,,Сіз көп жеген болуыңыз керек.
Dialogue: 0,0:53:33.08,0:53:35.38,Default,,0000,0000,0000,,Не? бұл….
Dialogue: 0,0:53:39.42,0:53:43.75,Default,,0000,0000,0000,,Ол әлі тірі ме?
Dialogue: 0,0:53:39.42,0:53:43.75,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:53:43.75,0:53:46.26,Default,,0000,0000,0000,,«Қашайық»
Dialogue: 0,0:53:43.75,0:53:46.26,Default,,0000,0000,0000,,Мен айттым ғой.
Dialogue: 0,0:53:46.26,0:53:49.26,Default,,0000,0000,0000,,Бір жерде үлкендер жоқ
Dialogue: 0,0:53:46.26,0:53:49.26,Default,,0000,0000,0000,,Оңтүстік аралға барыңыз➡
Dialogue: 0,0:53:49.26,0:53:51.43,Default,,0000,0000,0000,,Кел, үйленейік.
Dialogue: 0,0:53:51.43,0:53:53.63,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:53:56.60,0:53:59.10,Default,,0000,0000,0000,,Сіз мені бір жерге апара аласыз ба?
Dialogue: 0,0:53:59.10,0:54:02.11,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:53:59.10,0:54:02.11,Default,,0000,0000,0000,,Қазір.
Dialogue: 0,0:54:06.61,0:54:08.61,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:54:08.61,0:54:11.62,Default,,0000,0000,0000,,Емтихан аяқталғаннан кейін
Dialogue: 0,0:54:08.61,0:54:11.62,Default,,0000,0000,0000,,Міне — жер астында.
Dialogue: 0,0:54:11.62,0:54:15.42,Default,,0000,0000,0000,,Енді мен оқуым керек.
Dialogue: 0,0:54:11.62,0:54:15.42,Default,,0000,0000,0000,,Менің ойымша, бұл ең маңызды нәрсе.
Dialogue: 0,0:54:20.46,0:54:24.29,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:54:20.46,0:54:24.29,Default,,0000,0000,0000,,Шуйчи-кун жеке мектепке барады ма?
Dialogue: 0,0:54:24.29,0:54:27.80,Default,,0000,0000,0000,,Бұл менің ниетім.
Dialogue: 0,0:54:27.80,0:54:31.47,Default,,0000,0000,0000,,Жарайды, өйткені сен данышпансың.
Dialogue: 0,0:54:31.47,0:54:33.74,Default,,0000,0000,0000,,Карин-чан не істейді?
Dialogue: 0,0:54:33.74,0:54:37.74,Default,,0000,0000,0000,,Жазғы демалыста көп жұмыс істеуім керек
Dialogue: 0,0:54:33.74,0:54:37.74,Default,,0000,0000,0000,,Бұл үлкен мәселе болады.
Dialogue: 0,0:54:47.75,0:54:50.15,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:54:53.92,0:54:57.76,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:54:57.76,0:55:00.60,Default,,0000,0000,0000,,Бір күні үйленейік.
Dialogue: 0,0:55:00.60,0:55:04.60,Default,,0000,0000,0000,,Иә. Бірге оқып, қолымыздан келгенді жасайық.
Dialogue: 0,0:55:16.78,0:55:19.18,Default,,0000,0000,0000,,О, солай болды.
Dialogue: 0,0:55:28.46,0:55:30.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:55:32.63,0:55:35.73,Default,,0000,0000,0000,,Нишишишишиши.
Dialogue: 0,0:55:35.73,0:55:39.57,Default,,0000,0000,0000,,Әлі көрінбеген «Қиыршықтарға» сақ болайық.
Dialogue: 0,0:55:35.73,0:55:39.57,Default,,0000,0000,0000,,Не? неге?
Dialogue: 0,0:55:39.57,0:55:42.24,Default,,0000,0000,0000,,О, біз тағы да кездестік.
Dialogue: 0,0:55:42.24,0:55:44.57,Default,,0000,0000,0000,,Карин-чан емес пе?
Dialogue: 0,0:55:44.57,0:55:47.08,Default,,0000,0000,0000,,Өйткені бұл жұмыс.
Dialogue: 0,0:55:47.08,0:55:50.58,Default,,0000,0000,0000,,Эй, сен кіммен сөйлесіп тұрсың?
Dialogue: 0,0:55:47.08,0:55:50.58,Default,,0000,0000,0000,,Оны біраз уақыт ұстаңыз.
Dialogue: 0,0:55:50.58,0:55:52.58,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:55:52.58,0:55:54.92,Default,,0000,0000,0000,,Аа, солай...
Dialogue: 0,0:55:54.92,0:55:56.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:55:56.92,0:55:59.92,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:56:01.93,0:56:06.43,Default,,0000,0000,0000,,Мені жібер, құбыжық мысық!
Dialogue: 0,0:56:06.43,0:56:09.60,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ….
Dialogue: 0,0:56:09.60,0:56:11.77,Default,,0000,0000,0000,,Карин-чан жаман.
Dialogue: 0,0:56:11.77,0:56:13.94,Default,,0000,0000,0000,,Не? Неліктен?
Dialogue: 0,0:56:13.94,0:56:17.77,Default,,0000,0000,0000,,Хмм, сен баласың ба?
Dialogue: 0,0:56:17.77,0:56:20.44,Default,,0000,0000,0000,,Жоқ, өтінемін.
Dialogue: 0,0:56:17.77,0:56:20.44,Default,,0000,0000,0000,,Осы жолы артқа шегініңіз.
Dialogue: 0,0:56:20.44,0:56:23.95,Default,,0000,0000,0000,,Тағы да! ? Егер сізге ұнамаса, мен бұл жолы қайтпаймын.
Dialogue: 0,0:56:23.95,0:56:27.95,Default,,0000,0000,0000,,Не айтсаң да тыңдаймын.
Dialogue: 0,0:56:27.95,0:56:32.62,Default,,0000,0000,0000,,Жоқ! Достар, балалар, т.б.➡
Dialogue: 0,0:56:32.62,0:56:34.72,Default,,0000,0000,0000,,Жылы сөз айтсаң
Dialogue: 0,0:56:32.62,0:56:34.72,Default,,0000,0000,0000,,Ешбір жұмысты аяқтамаңыз!
Dialogue: 0,0:56:34.72,0:56:37.43,Default,,0000,0000,0000,,Жарайды, мұны істейік.
Dialogue: 0,0:56:45.90,0:56:47.90,Default,,0000,0000,0000,,Жабу!
Dialogue: 0,0:56:47.90,0:56:50.74,Default,,0000,0000,0000,,Мен оның қолына қайта түсемін бе?
Dialogue: 0,0:56:47.90,0:56:50.74,Default,,0000,0000,0000,,«Сол қол» дегеніміз не?
Dialogue: 0,0:56:50.74,0:56:53.91,Default,,0000,0000,0000,,Қара, қара, қара, қара.
Dialogue: 0,0:56:50.74,0:56:53.91,Default,,0000,0000,0000,,Бұл ұзағырақ.
Dialogue: 0,0:56:53.91,0:56:56.25,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:56:53.91,0:56:56.25,Default,,0000,0000,0000,,Бұл қысқарақ.
Dialogue: 0,0:56:56.25,0:56:59.92,Default,,0000,0000,0000,,Неге сонша қорқасың? Артқа тарт, міне.
Dialogue: 0,0:56:59.92,0:57:03.59,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:56:59.92,0:57:03.59,Default,,0000,0000,0000,,Тынш-тш... т-ш!
Dialogue: 0,0:57:03.59,0:57:08.09,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:57:03.59,0:57:08.09,Default,,0000,0000,0000,,Сіз бұрын кіммен сөйлестіңіз?
Dialogue: 0,0:57:08.09,0:57:12.26,Default,,0000,0000,0000,,Иә. Кедейлік Құдайымен аздап.
Dialogue: 0,0:57:08.09,0:57:12.26,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:12.26,0:57:14.66,Default,,0000,0000,0000,,Жоқ, мен қазір осындамын.
Dialogue: 0,0:57:16.60,0:57:18.94,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Сен ақымақсың ба?
Dialogue: 0,0:57:18.94,0:57:23.14,Default,,0000,0000,0000,,Жоқ, жоқ...
Dialogue: 0,0:57:18.94,0:57:23.14,Default,,0000,0000,0000,,Негізгі: Өйткені адам оны көре алмайды.
Dialogue: 0,0:57:27.44,0:57:30.45,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:57:30.45,0:57:33.38,Default,,0000,0000,0000,,«Адамдарға көрінбейді».
Dialogue: 0,0:57:33.38,0:57:36.89,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:57:33.38,0:57:36.89,Default,,0000,0000,0000,,Онда кедейліктің құдайы бар, солай ма?
Dialogue: 0,0:57:36.89,0:57:40.72,Default,,0000,0000,0000,,Өйткені сен де құбыжық мысықсың
Dialogue: 0,0:57:36.89,0:57:40.72,Default,,0000,0000,0000,,Кейде солай болады.
Dialogue: 0,0:57:40.72,0:57:45.56,Default,,0000,0000,0000,,Олай болса, менің сенен бір жақсылығым бар.
Dialogue: 0,0:57:40.72,0:57:45.56,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:57:45.56,0:57:48.06,Default,,0000,0000,0000,,Мен анамды көргім келеді.
Dialogue: 0,0:57:45.56,0:57:48.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:48.06,0:57:51.40,Default,,0000,0000,0000,,Бұл жай ғана елес болса да, бәрібір
Dialogue: 0,0:57:48.06,0:57:51.40,Default,,0000,0000,0000,,Мен анамды көргім келеді.
Dialogue: 0,0:57:51.40,0:57:54.07,Default,,0000,0000,0000,,Кедейлік Құдайынан сұрап көріңіз.
Dialogue: 0,0:57:54.07,0:57:56.37,Default,,0000,0000,0000,,Кедейлердің Құдайы да Құдай, солай ма?
Dialogue: 0,0:57:58.41,0:58:00.41,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:58:04.75,0:58:06.75,Default,,0000,0000,0000,,Өйткені.
Dialogue: 0,0:58:12.92,0:58:16.09,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:58:12.92,0:58:16.09,Default,,0000,0000,0000,,Неліктен анаңның моласы?
Dialogue: 0,0:58:16.09,0:58:18.09,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:58:18.09,0:58:20.20,Default,,0000,0000,0000,,Осы жолмен.
Dialogue: 0,0:58:28.77,0:58:30.97,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:58:38.38,0:58:41.58,Default,,0000,0000,0000,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:58:38.38,0:58:41.58,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:58:51.90,0:58:55.40,Default,,0000,0000,0000,,Бұл тозаққа кіретін есік.
Dialogue: 0,0:58:51.90,0:58:55.40,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:55.40,0:58:58.40,Default,,0000,0000,0000,,Үйге бара алмасам да
Dialogue: 0,0:58:55.40,0:58:58.40,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:58:58.40,0:59:02.41,Default,,0000,0000,0000,,Е. Шынайы ма?
Dialogue: 0,0:59:02.41,0:59:05.58,Default,,0000,0000,0000,,Не? Сен не айтып тұрсың?
Dialogue: 0,0:59:05.58,0:59:07.91,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:59:07.91,0:59:11.41,Default,,0000,0000,0000,,Бұл кіреберіс.
Dialogue: 0,0:59:11.41,0:59:14.12,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:59:19.09,0:59:23.43,Default,,0000,0000,0000,,Бұл аяқталғаннан кейін
Dialogue: 0,0:59:19.09,0:59:23.43,Default,,0000,0000,0000,,Себебі мен Карин-чанға қатты батып кеттім.
Dialogue: 0,0:59:23.43,0:59:25.43,Default,,0000,0000,0000,,Сіз түсіндіңіз деп ойлаймын.
Dialogue: 0,0:59:25.43,0:59:28.23,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:59:25.43,0:59:28.23,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:30.27,0:59:32.44,Default,,0000,0000,0000,,Угиджиги….
Dialogue: 0,0:59:32.44,0:59:35.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:59:43.88,0:59:46.18,Default,,0000,0000,0000,,Няаааа!
Dialogue: 0,0:59:48.22,0:59:50.62,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:59:56.06,0:59:58.06,Default,,0000,0000,0000,,Урья... Ах!
Dialogue: 0,0:59:58.06,1:00:00.40,Default,,0000,0000,0000,,Чи чи чи чи чи....
Dialogue: 0,1:00:00.40,1:00:10.57,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:00:10.57,1:00:13.58,Default,,0000,0000,0000,,Шайнау.
Dialogue: 0,1:00:13.58,1:00:17.58,Default,,0000,0000,0000,,Туту….
Dialogue: 0,1:00:17.58,1:00:19.75,Default,,0000,0000,0000,,Цк.
Dialogue: 0,1:00:19.75,1:00:21.75,Default,,0000,0000,0000,,(Лифттің келу дыбысы)
Dialogue: 0,1:00:21.75,1:00:24.09,Default,,0000,0000,0000,,🔊7-қабатта.
Dialogue: 0,1:00:24.09,1:00:26.09,Default,,0000,0000,0000,,Құт.
Dialogue: 0,1:00:26.09,1:00:28.09,Default,,0000,0000,0000,,Chuttu tututu….
Dialogue: 0,1:00:28.09,1:00:32.43,Default,,0000,0000,0000,,Чучучу….
Dialogue: 0,1:00:32.43,1:00:36.23,Default,,0000,0000,0000,,Шайнаңыз! Шайнаңыз!
Dialogue: 0,1:00:38.27,1:00:43.61,Default,,0000,0000,0000,,Чучучу….
Dialogue: 0,1:00:38.27,1:00:43.61,Default,,0000,0000,0000,,Крук Курук….
Dialogue: 0,1:00:43.61,1:00:45.61,Default,,0000,0000,0000,,Курукуру Курукуру….
Dialogue: 0,1:00:45.61,1:00:49.45,Default,,0000,0000,0000,,Чучучу…чу….
Dialogue: 0,1:00:49.45,1:00:51.45,Default,,0000,0000,0000,,Шайнау.
Dialogue: 0,1:00:53.78,1:00:58.79,Default,,0000,0000,0000,,Хмм... Уау! Апыр-ай!
Dialogue: 0,1:00:58.79,1:01:01.62,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,1:01:01.62,1:01:06.96,Default,,0000,0000,0000,,Уау! Уф... ауырады...
Dialogue: 0,1:01:06.96,1:01:10.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:01:10.13,1:01:12.14,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,1:01:12.14,1:01:14.30,Default,,0000,0000,0000,,Тозақ.
Dialogue: 0,1:01:14.30,1:01:17.97,Default,,0000,0000,0000,,Уау! Мүмкін кедейліктің құдайы шығар?
Dialogue: 0,1:01:17.97,1:01:20.14,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:01:20.14,1:01:23.48,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,1:01:23.48,1:01:25.48,Default,,0000,0000,0000,,Ня?
Dialogue: 0,1:01:25.48,1:01:29.15,Default,,0000,0000,0000,,Иә! ? Анзу-чан? неге?
Dialogue: 0,1:01:29.15,1:01:31.45,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,1:01:29.15,1:01:31.45,Default,,0000,0000,0000,,Менің ойымша, бұл дәл солай.
Dialogue: 0,1:01:33.42,1:01:35.93,Default,,0000,0000,0000,,Эх! ?
Dialogue: 0,1:01:35.93,1:01:38.63,Default,,0000,0000,0000,,Менің артымнан жүр.
Dialogue: 0,1:01:41.43,1:01:43.43,Default,,0000,0000,0000,,Мияу.
Dialogue: 0,1:01:45.44,1:02:14.30,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:02:14.30,1:02:17.00,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:02:14.30,1:02:17.00,Default,,0000,0000,0000,,Қараңыз!
Dialogue: 0,1:02:25.81,1:02:27.98,Default,,0000,0000,0000,,Не? Мұнда.
Dialogue: 0,1:02:27.98,1:02:30.18,Default,,0000,0000,0000,,Осы көпірден өтейік.
Dialogue: 0,1:02:39.26,1:02:43.16,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,1:02:50.10,1:02:52.10,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,1:02:52.10,1:02:56.44,Default,,0000,0000,0000,,Эй, сәлем.
Dialogue: 0,1:02:52.10,1:02:56.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:02:56.44,1:02:59.94,Default,,0000,0000,0000,,Не істеп жүрсің?
Dialogue: 0,1:02:59.94,1:03:03.95,Default,,0000,0000,0000,,А, менің курсым.
Dialogue: 0,1:02:59.94,1:03:03.95,Default,,0000,0000,0000,,Шешілді.
Dialogue: 0,1:03:03.95,1:03:06.15,Default,,0000,0000,0000,,Ня….
Dialogue: 0,1:03:09.45,1:03:11.79,Default,,0000,0000,0000,,Инелі тау тозақсың.
Dialogue: 0,1:03:11.79,1:03:14.12,Default,,0000,0000,0000,,Сол баспалдақтан
Dialogue: 0,1:03:11.79,1:03:14.12,Default,,0000,0000,0000,,200-ші қабатқа көтеріліңіз.
Dialogue: 0,1:03:14.12,1:03:16.13,Default,,0000,0000,0000,,Лифтпен 7-қабатқа...
Dialogue: 0,1:03:16.13,1:03:18.23,Default,,0000,0000,0000,,Аты мен мекенжайы
Dialogue: 0,1:03:16.13,1:03:18.23,Default,,0000,0000,0000,,Жазыңыз.
Dialogue: 0,1:03:43.59,1:03:45.59,Default,,0000,0000,0000,,Бұл тозақ па?
Dialogue: 0,1:03:45.59,1:03:47.59,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:03:47.59,1:03:50.93,Default,,0000,0000,0000,,Тозақ үшін
Dialogue: 0,1:03:47.59,1:03:50.93,Default,,0000,0000,0000,,Бұл өте тыныш.
Dialogue: 0,1:03:50.93,1:03:55.13,Default,,0000,0000,0000,,Бейбіт нәрсе. Қазір барайық.
Dialogue: 0,1:03:59.27,1:04:01.44,Default,,0000,0000,0000,,Сіздер өз өнерлеріңізді көрсеттіңіздер.
Dialogue: 0,1:03:59.27,1:04:01.44,Default,,0000,0000,0000,,Сіз оны маған бердіңіз, солай ма?
Dialogue: 0,1:04:01.44,1:04:03.44,Default,,0000,0000,0000,,Маған мына сойылмен соққы беріңіз.
Dialogue: 0,1:04:03.44,1:04:06.11,Default,,0000,0000,0000,,Мен алдымен душқа түсемін.
Dialogue: 0,1:04:03.44,1:04:06.11,Default,,0000,0000,0000,,Мен кіргім келеді, кіргім келеді!
Dialogue: 0,1:04:06.11,1:04:08.44,Default,,0000,0000,0000,,Өтінемін, мен бүгін түстен кейін қатты жұмыс істеймін.
Dialogue: 0,1:04:08.44,1:04:10.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:04:18.29,1:04:21.29,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,1:04:18.29,1:04:21.29,Default,,0000,0000,0000,,Сәлем! Эй...
Dialogue: 0,1:04:21.29,1:04:26.20,Default,,0000,0000,0000,,Ахахха!
Dialogue: 0,1:04:21.29,1:04:26.20,Default,,0000,0000,0000,,А, мен түсіндім! Ахахха.
Dialogue: 0,1:04:31.47,1:04:33.40,Default,,0000,0000,0000,,Тығыз.
Dialogue: 0,1:04:33.40,1:04:35.40,Default,,0000,0000,0000,,Гюгюгю….
Dialogue: 0,1:04:33.40,1:04:35.40,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:04:35.40,1:04:38.07,Default,,0000,0000,0000,,Қысу...
Dialogue: 0,1:04:38.07,1:04:40.24,Default,,0000,0000,0000,,Иә, Карин-чан?
Dialogue: 0,1:04:40.24,1:04:43.91,Default,,0000,0000,0000,,Гюгю Гюгю...!
Dialogue: 0,1:04:43.91,1:04:45.92,Default,,0000,0000,0000,,Тозақ?
Dialogue: 0,1:04:45.92,1:04:49.92,Default,,0000,0000,0000,,Жарайды. Дас барлығын жинайды!
Dialogue: 0,1:04:49.92,1:04:52.42,Default,,0000,0000,0000,,Гю гю гю гю….
Dialogue: 0,1:04:59.10,1:05:01.40,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,1:04:59.10,1:05:01.40,Default,,0000,0000,0000,,Адамның иісі бар.
Dialogue: 0,1:05:04.43,1:05:06.64,Default,,0000,0000,0000,,Ол қай қабатта?
Dialogue: 0,1:05:04.43,1:05:06.64,Default,,0000,0000,0000,,10-қабат.
Dialogue: 0,1:05:09.94,1:05:11.94,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,1:05:16.11,1:05:21.28,Default,,0000,0000,0000,,Мм, осы жерде
Dialogue: 0,1:05:16.11,1:05:21.28,Default,,0000,0000,0000,,Онда болуы керек...
Dialogue: 0,1:05:21.28,1:05:23.62,Default,,0000,0000,0000,,Сенің анаң осында ма?
Dialogue: 0,1:05:23.62,1:05:27.62,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:05:23.62,1:05:27.62,Default,,0000,0000,0000,,Няняня….
Dialogue: 0,1:05:27.62,1:05:29.73,Default,,0000,0000,0000,,Ана?
Dialogue: 0,1:05:40.40,1:05:43.57,Default,,0000,0000,0000,,Ана?
Dialogue: 0,1:05:43.57,1:05:45.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:05:43.57,1:05:45.74,Default,,0000,0000,0000,,Тағы да оралып келдім
Dialogue: 0,1:05:45.74,1:05:48.24,Default,,0000,0000,0000,,Маған көмектес!
Dialogue: 0,1:05:48.24,1:05:53.08,Default,,0000,0000,0000,,Карин!
Dialogue: 0,1:05:48.24,1:05:53.08,Default,,0000,0000,0000,,Өлтірілді! Маған көмектесші!
Dialogue: 0,1:05:53.08,1:05:56.59,Default,,0000,0000,0000,,Тецуя! ?
Dialogue: 0,1:05:53.08,1:05:56.59,Default,,0000,0000,0000,,Олардың жартысы ғана өлген.
Dialogue: 0,1:05:56.59,1:05:59.69,Default,,0000,0000,0000,,Мен өліп қала жаздадым.
Dialogue: 0,1:05:56.59,1:05:59.69,Default,,0000,0000,0000,,Маған көмектес!
Dialogue: 0,1:05:56.59,1:05:59.69,Default,,0000,0000,0000,,Не!
Dialogue: 0,1:06:01.76,1:06:04.76,Default,,0000,0000,0000,,Иә? Бұл көмектескен сияқты.
Dialogue: 0,1:06:04.76,1:06:06.93,Default,,0000,0000,0000,,Уф... маған көмектесіңізші...
Dialogue: 0,1:06:06.93,1:06:08.93,Default,,0000,0000,0000,,Бұл нәзік нүкте.
Dialogue: 0,1:06:08.93,1:06:11.93,Default,,0000,0000,0000,,Не не? Бұл не? ?
Dialogue: 0,1:06:08.93,1:06:11.93,Default,,0000,0000,0000,,Маған көмектесіңізші...
Dialogue: 0,1:06:11.93,1:06:15.27,Default,,0000,0000,0000,,Мияу Мияу. Мияу.
Dialogue: 0,1:06:15.27,1:06:21.11,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:06:15.27,1:06:21.11,Default,,0000,0000,0000,,Тек… мүлде емес….
Dialogue: 0,1:06:21.11,1:06:23.11,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:06:26.12,1:06:28.12,Default,,0000,0000,0000,,Мен сені ұмытып кеттім.
Dialogue: 0,1:06:28.12,1:06:33.22,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? ?
Dialogue: 0,1:06:33.22,1:06:36.23,Default,,0000,0000,0000,,Өлді ме? Сен өлдің бе?
Dialogue: 0,1:06:36.23,1:06:38.39,Default,,0000,0000,0000,,Жоқ. Мен тірімін.
Dialogue: 0,1:06:38.39,1:06:45.60,Default,,0000,0000,0000,,Күрсіну… Иә…. Сен тірісің бе?
Dialogue: 0,1:06:48.07,1:06:51.41,Default,,0000,0000,0000,,Жарайсың, осы уақытқа дейін келдің.
Dialogue: 0,1:06:51.41,1:06:55.08,Default,,0000,0000,0000,,Ана. Бүгін менің қайтыс болғаныма бір жыл болды.
Dialogue: 0,1:06:55.08,1:06:57.75,Default,,0000,0000,0000,,Әкеммен
Dialogue: 0,1:06:55.08,1:06:57.75,Default,,0000,0000,0000,,Мен баруды ойладым➡
Dialogue: 0,1:06:57.75,1:07:00.08,Default,,0000,0000,0000,,Ол келмеді...
Dialogue: 0,1:07:00.08,1:07:02.08,Default,,0000,0000,0000,,Сондықтан мен оны дәлелдеймін.
Dialogue: 0,1:07:02.08,1:07:04.75,Default,,0000,0000,0000,,Түсіндім, мүлде ұмытып қалдым.
Dialogue: 0,1:07:04.75,1:07:06.76,Default,,0000,0000,0000,,Мен осында болғанда
Dialogue: 0,1:07:04.75,1:07:06.76,Default,,0000,0000,0000,,Уақыт және сол сияқты нәрселер➡
Dialogue: 0,1:07:06.76,1:07:09.93,Default,,0000,0000,0000,,Сіз көп нәрсені ұмытасыз.
Dialogue: 0,1:07:09.93,1:07:12.13,Default,,0000,0000,0000,,Мен...
Dialogue: 0,1:07:14.76,1:07:17.27,Default,,0000,0000,0000,,Қариннің жүзі есімде.
Dialogue: 0,1:07:17.27,1:07:22.10,Default,,0000,0000,0000,,Хехе, мен ұмытпауым керек.
Dialogue: 0,1:07:22.10,1:07:26.11,Default,,0000,0000,0000,,Дәмді де есте сақтаңыз. Хехехе.
Dialogue: 0,1:07:26.11,1:07:28.94,Default,,0000,0000,0000,,Кешіріңіз, мен сөйлеп тұрмын.
Dialogue: 0,1:07:26.11,1:07:28.94,Default,,0000,0000,0000,,Уақытыңыз жоқ.
Dialogue: 0,1:07:28.94,1:07:32.62,Default,,0000,0000,0000,,Сені жын тапса, қиналып қаласың.
Dialogue: 0,1:07:28.94,1:07:32.62,Default,,0000,0000,0000,,Ережелерді бұзу – үлкен күнә.
Dialogue: 0,1:07:32.62,1:07:36.39,Default,,0000,0000,0000,,Біз бұрыннан танысқанбыз, сондықтан бәрі жақсы, солай ма?
Dialogue: 0,1:07:32.62,1:07:36.39,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:07:36.39,1:07:39.39,Default,,0000,0000,0000,,Юки-сан, сен не істеп жатырсың?
Dialogue: 0,1:07:39.39,1:07:43.56,Default,,0000,0000,0000,,Ерінбей, еңбектен...
Dialogue: 0,1:07:43.56,1:07:46.90,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,1:07:46.90,1:07:49.57,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:07:46.90,1:07:49.57,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:07:49.57,1:07:52.40,Default,,0000,0000,0000,,Қайда бара жатырсыңдар?
Dialogue: 0,1:07:49.57,1:07:52.40,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:07:52.40,1:07:56.21,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:07:52.40,1:07:56.21,Default,,0000,0000,0000,,Тағы да оралып келдім
Dialogue: 0,1:07:59.41,1:08:01.58,Default,,0000,0000,0000,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,1:07:59.41,1:08:01.58,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,1:08:01.58,1:08:03.58,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:08:08.75,1:08:10.75,Default,,0000,0000,0000,,🗧Лорд Энма.
Dialogue: 0,1:08:14.09,1:08:17.43,Default,,0000,0000,0000,,Қашқын бар.
Dialogue: 0,1:08:17.43,1:08:19.76,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:08:19.76,1:08:24.77,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,1:08:19.76,1:08:24.77,Default,,0000,0000,0000,,(Карин мен Юдзукидің айқайы)
Dialogue: 0,1:08:24.77,1:08:26.77,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:08:28.77,1:08:33.54,Default,,0000,0000,0000,,Мяу аааа аааа....
Dialogue: 0,1:08:33.54,1:08:37.05,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,1:08:33.54,1:08:37.05,Default,,0000,0000,0000,,Енді қайда?
Dialogue: 0,1:08:37.05,1:08:41.38,Default,,0000,0000,0000,,Балалар
Dialogue: 0,1:08:37.05,1:08:41.38,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,1:08:41.38,1:08:43.59,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,1:08:48.22,1:08:51.13,Default,,0000,0000,0000,,Барлығың тозаққа барасыңдар.
Dialogue: 0,1:08:53.90,1:08:56.90,Default,,0000,0000,0000,,Ах, ня... Эй...
Dialogue: 0,1:08:56.90,1:09:01.74,Default,,0000,0000,0000,,Уау! Демалыс!
Dialogue: 0,1:08:56.90,1:09:01.74,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,1:09:01.74,1:09:04.24,Default,,0000,0000,0000,,Шабая Шабая.
Dialogue: 0,1:09:01.74,1:09:04.24,Default,,0000,0000,0000,,Ухихихихихи!
Dialogue: 0,1:09:04.24,1:09:07.91,Default,,0000,0000,0000,,Хяхахаха!
Dialogue: 0,1:09:04.24,1:09:07.91,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:09:07.91,1:09:11.21,Default,,0000,0000,0000,,Адамның иісі бар!
Dialogue: 0,1:09:15.08,1:09:17.39,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:09:21.09,1:09:24.19,Default,,0000,0000,0000,,Мен фушаба ішпегеніме көп болды...
Dialogue: 0,1:09:26.26,1:09:29.27,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:09:34.04,1:09:36.54,Default,,0000,0000,0000,,А... жүре бер.
Dialogue: 0,1:09:40.54,1:09:42.88,Default,,0000,0000,0000,,Эй... бұл менің велосипедім!
Dialogue: 0,1:09:42.88,1:09:44.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:09:44.88,1:09:48.55,Default,,0000,0000,0000,,Сәлем! Қарғыс атсын.
Dialogue: 0,1:09:48.55,1:09:51.35,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,1:09:48.55,1:09:51.35,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,1:09:57.39,1:09:59.40,Default,,0000,0000,0000,,Сіз мені қуып алғыңыз келе ме?
Dialogue: 0,1:09:59.40,1:10:01.90,Default,,0000,0000,0000,,Ах... Иә!
Dialogue: 0,1:09:59.40,1:10:01.90,Default,,0000,0000,0000,,Әй, мінекей!
Dialogue: 0,1:10:01.90,1:10:04.70,Default,,0000,0000,0000,,Бар, жүр, жүр!
Dialogue: 0,1:10:01.90,1:10:04.70,Default,,0000,0000,0000,,Бар, жүр, жүр!
Dialogue: 0,1:10:10.57,1:10:12.58,Default,,0000,0000,0000,,
Dialogue: 0,1:10:22.08,1:10:24.09,Default,,0000,0000,0000,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:10:24.09,1:10:26.09,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,1:10:24.09,1:10:26.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:10:30.59,1:10:33.10,Default,,0000,0000,0000,,(Карин мен Юдзукидің айқайы)
Dialogue: 0,1:10:33.10,1:10:35.20,Default,,0000,0000,0000,,...
Dialogue: 0,1:10:37.27,1:10:39.27,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:10:41.94,1:10:44.44,Default,,0000,0000,0000,,Нях ха ха!
Dialogue: 0,1:10:47.78,1:10:50.45,Default,,0000,0000,0000,,Бұл туралы не істеуім керек...? Хмм….
Dialogue: 0,1:10:50.45,1:10:52.78,Default,,0000,0000,0000,,Менен түс!
Dialogue: 0,1:10:50.45,1:10:52.78,Default,,0000,0000,0000,,Сонымен, Ватару да ұтылды ма? Қайран-ай
Dialogue: 0,1:10:52.78,1:10:57.62,Default,,0000,0000,0000,,Өйткені жындардың мақсаты мен.
Dialogue: 0,1:10:52.78,1:10:57.62,Default,,0000,0000,0000,,Мені түсіріп жібер, екеуің жүгіріңдер.
Dialogue: 0,1:10:57.62,1:11:00.96,Default,,0000,0000,0000,,Бұл жақсы емес!
Dialogue: 0,1:11:00.96,1:11:04.96,Default,,0000,0000,0000,,Мүлдем жоқ!
Dialogue: 0,1:11:00.96,1:11:04.96,Default,,0000,0000,0000,,Карин!
Dialogue: 0,1:11:04.96,1:11:08.96,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ...!
Dialogue: 0,1:11:04.96,1:11:08.96,Default,,0000,0000,0000,,Карин!
Dialogue: 0,1:11:08.96,1:11:11.27,Default,,0000,0000,0000,,Әзірше... Уау!
Dialogue: 0,1:11:13.30,1:11:15.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:11:17.64,1:11:19.64,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:11:22.14,1:11:24.65,Default,,0000,0000,0000,,Хмм... кеш!
Dialogue: 0,1:11:24.65,1:11:26.65,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,1:11:29.49,1:11:31.49,Default,,0000,0000,0000,,Жүгір!
Dialogue: 0,1:11:36.93,1:11:39.63,Default,,0000,0000,0000,,Н-Няха!
Dialogue: 0,1:11:41.60,1:11:44.43,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:11:44.43,1:11:47.27,Default,,0000,0000,0000,,Nyahoo!
Dialogue: 0,1:11:44.43,1:11:47.27,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:11:47.27,1:11:49.77,Default,,0000,0000,0000,,Yahoho!
Dialogue: 0,1:11:47.27,1:11:49.77,Default,,0000,0000,0000,,Yahohoho!
Dialogue: 0,1:11:49.77,1:11:53.44,Default,,0000,0000,0000,,
Dialogue: 0,1:11:53.44,1:11:56.11,Default,,0000,0000,0000,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,1:11:56.11,1:11:58.11,Default,,0000,0000,0000,,Мінекей! Эй!
Dialogue: 0,1:11:58.11,1:12:01.22,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:11:58.11,1:12:01.22,Default,,0000,0000,0000,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,1:12:03.79,1:12:06.46,Default,,0000,0000,0000,,Рачи түсініксіз! Мінеки біз!
Dialogue: 0,1:12:06.46,1:12:09.46,Default,,0000,0000,0000,,Иә! ? Чо, чо, чо....
Dialogue: 0,1:12:11.96,1:12:14.76,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:12:16.80,1:12:18.80,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,1:12:21.64,1:12:23.81,Default,,0000,0000,0000,,Ей, құбыжық мысық.
Dialogue: 0,1:12:23.81,1:12:28.14,Default,,0000,0000,0000,,Бұл шынымен ұнайды
Dialogue: 0,1:12:23.81,1:12:28.14,Default,,0000,0000,0000,,Сіз қашып құтыла аламын деп ойлайсыз ба?
Dialogue: 0,1:12:28.14,1:12:32.15,Default,,0000,0000,0000,,Бұл қанша дегенді білдіреді?
Dialogue: 0,1:12:28.14,1:12:32.15,Default,,0000,0000,0000,,Сіз мұны білесіз.
Dialogue: 0,1:12:32.15,1:12:34.08,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:12:32.15,1:12:34.08,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:12:34.08,1:12:37.42,Default,,0000,0000,0000,,Мияу! Күрсіну….
Dialogue: 0,1:12:37.42,1:12:39.42,Default,,0000,0000,0000,,Пап.
Dialogue: 0,1:12:39.42,1:12:41.62,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:12:46.10,1:12:49.10,Default,,0000,0000,0000,,Карин-чан!
Dialogue: 0,1:12:49.10,1:12:51.10,Default,,0000,0000,0000,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,1:12:49.10,1:12:51.10,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:12:53.94,1:12:57.14,Default,,0000,0000,0000,,Құбыжық мысық!
Dialogue: 0,1:12:53.94,1:12:57.14,Default,,0000,0000,0000,,Тоқта, бейбақ...
Dialogue: 0,1:12:59.78,1:13:02.68,Default,,0000,0000,0000,,Алдымен Хона.
Dialogue: 0,1:13:08.45,1:13:10.45,Default,,0000,0000,0000,,Сол жігіттер!
Dialogue: 0,1:13:10.45,1:13:13.46,Default,,0000,0000,0000,,Сіз не туралы үрейленесіз?
Dialogue: 0,1:13:10.45,1:13:13.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:13:13.46,1:13:17.13,Default,,0000,0000,0000,,Бізде сізден де көп адам бар.
Dialogue: 0,1:13:13.46,1:13:17.13,Default,,0000,0000,0000,,Мұрны жақсы адамдар көп.
Dialogue: 0,1:13:17.13,1:13:21.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:13:17.13,1:13:21.46,Default,,0000,0000,0000,,Өлген жігіттер сасық.
Dialogue: 0,1:13:21.46,1:13:23.97,Default,,0000,0000,0000,,Мияу ха ха!
Dialogue: 0,1:13:23.97,1:13:26.47,Default,,0000,0000,0000,,Бакенеко-сан ең жақсысы!
Dialogue: 0,1:13:26.47,1:13:29.64,Default,,0000,0000,0000,,Анзу-чан
Dialogue: 0,1:13:26.47,1:13:29.64,Default,,0000,0000,0000,,Енді не істейсіз?
Dialogue: 0,1:13:29.64,1:13:34.58,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:13:29.64,1:13:34.58,Default,,0000,0000,0000,,Мен бұл дүниенің соңына барамын, няа!
Dialogue: 0,1:13:34.58,1:13:36.58,Default,,0000,0000,0000,,Хехе, сен ақымақсың.
Dialogue: 0,1:13:36.58,1:13:38.91,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:13:38.91,1:13:40.92,Default,,0000,0000,0000,,Мияу хаха...!
Dialogue: 0,1:13:40.92,1:13:43.62,Default,,0000,0000,0000,,
Dialogue: 0,1:13:47.09,1:13:49.09,Default,,0000,0000,0000,,Эй, мұны қалайсың ба?
Dialogue: 0,1:13:49.09,1:13:51.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:13:51.09,1:13:55.26,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,1:13:55.26,1:13:58.10,Default,,0000,0000,0000,,Мен, сумо күресі... Уау!
Dialogue: 0,1:13:58.10,1:14:00.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:14:00.94,1:14:04.94,Default,,0000,0000,0000,,Няняня?
Dialogue: 0,1:14:00.94,1:14:04.94,Default,,0000,0000,0000,,Бұл не! ?
Dialogue: 0,1:14:04.94,1:14:07.61,Default,,0000,0000,0000,,Мүмкін ол мені қуып келе жатқан шығар.
Dialogue: 0,1:14:07.61,1:14:09.61,Default,,0000,0000,0000,,Не айтып тұрсың! ?
Dialogue: 0,1:14:09.61,1:14:11.61,Default,,0000,0000,0000,,Қалай болғанда да, маку ня!
Dialogue: 0,1:14:11.61,1:14:15.62,Default,,0000,0000,0000,,Хехе, мен қалдырамын.
Dialogue: 0,1:14:11.61,1:14:15.62,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,1:14:15.62,1:14:17.62,Default,,0000,0000,0000,,Няаа!
Dialogue: 0,1:14:17.62,1:14:21.29,Default,,0000,0000,0000,,Да... бұл жақсы емес!
Dialogue: 0,1:14:21.29,1:14:24.13,Default,,0000,0000,0000,,Көздер... Көздер аздап...
Dialogue: 0,1:14:24.13,1:14:27.46,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:14:27.46,1:14:30.47,Default,,0000,0000,0000,,Біреуін қалайсыз ба?
Dialogue: 0,1:14:27.46,1:14:30.47,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:14:30.47,1:14:32.63,Default,,0000,0000,0000,,Күткендей, екі... Гяа!
Dialogue: 0,1:14:32.63,1:14:34.57,Default,,0000,0000,0000,,🔊Бүгінгі сәлем.
Dialogue: 0,1:14:34.57,1:14:36.74,Default,,0000,0000,0000,,🔊Жоқ~
Dialogue: 0,1:14:34.57,1:14:36.74,Default,,0000,0000,0000,,Қызықтырақ болып барады.
Dialogue: 0,1:14:36.74,1:14:40.24,Default,,0000,0000,0000,,Өтінемін, жастар да.
Dialogue: 0,1:14:36.74,1:14:40.24,Default,,0000,0000,0000,,Шеңберге шығыңыз.
Dialogue: 0,1:14:40.24,1:14:43.41,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,1:14:43.41,1:14:48.08,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,1:14:48.08,1:14:50.09,Default,,0000,0000,0000,,болды.
Dialogue: 0,1:14:50.09,1:14:52.09,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:14:52.09,1:14:56.59,Default,,0000,0000,0000,,Уф, уф…
Dialogue: 0,1:14:56.59,1:14:58.76,Default,,0000,0000,0000,,Жарайды….
Dialogue: 0,1:14:58.76,1:15:01.10,Default,,0000,0000,0000,,Қашайық.
Dialogue: 0,1:15:01.10,1:15:04.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:15:04.10,1:15:07.10,Default,,0000,0000,0000,,Анзу-чан! Мұнда!
Dialogue: 0,1:15:07.10,1:15:09.10,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:15:11.77,1:15:14.18,Default,,0000,0000,0000,,Міне, сіз!
Dialogue: 0,1:15:11.77,1:15:14.18,Default,,0000,0000,0000,,Онда мен бүгінге кетемін.
Dialogue: 0,1:15:11.77,1:15:14.18,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,1:15:16.45,1:15:18.45,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,1:15:24.62,1:15:27.12,Default,,0000,0000,0000,,Балалар...
Dialogue: 0,1:15:27.12,1:15:29.96,Default,,0000,0000,0000,,Барлығы тозаққа барады!
Dialogue: 0,1:15:29.96,1:15:31.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:15:31.96,1:15:33.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:15:33.90,1:15:36.40,Default,,0000,0000,0000,,Енді болды.
Dialogue: 0,1:15:33.90,1:15:36.40,Default,,0000,0000,0000,,(Жындардың күлкісі)
Dialogue: 0,1:15:36.40,1:15:39.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:15:36.40,1:15:39.10,Default,,0000,0000,0000,,(көліктің жүгіру дыбысы)
Dialogue: 0,1:15:49.08,1:15:51.08,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:15:55.58,1:15:57.75,Default,,0000,0000,0000,,Пиппи пиппи.
Dialogue: 0,1:15:57.75,1:16:00.76,Default,,0000,0000,0000,,Анзу-чан, мен саған көмектесуге келдім.
Dialogue: 0,1:16:03.26,1:16:05.26,Default,,0000,0000,0000,,Балалар...
Dialogue: 0,1:16:07.26,1:16:10.43,Default,,0000,0000,0000,,Пиё! ?
Dialogue: 0,1:16:07.26,1:16:10.43,Default,,0000,0000,0000,,Міне.
Dialogue: 0,1:16:07.26,1:16:10.43,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:16:10.43,1:16:13.27,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:16:13.27,1:16:17.27,Default,,0000,0000,0000,,Уа! Джерогеро Джерогеро!
Dialogue: 0,1:16:17.27,1:16:19.61,Default,,0000,0000,0000,,Құсу….
Dialogue: 0,1:16:17.27,1:16:19.61,Default,,0000,0000,0000,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,1:16:19.61,1:16:21.61,Default,,0000,0000,0000,,Дыбыстық сигнал!
Dialogue: 0,1:16:19.61,1:16:21.61,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:16:21.61,1:16:23.61,Default,,0000,0000,0000,,Барлығы кетсін!
Dialogue: 0,1:16:23.61,1:16:25.61,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:16:25.61,1:16:33.72,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:33.72,1:16:35.72,Default,,0000,0000,0000,,Уау Уау….
Dialogue: 0,1:16:35.72,1:16:39.90,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:16:39.90,1:16:43.10,Default,,0000,0000,0000,,Пиё Пиё... Пиё!
Dialogue: 0,1:16:46.07,1:16:48.74,Default,,0000,0000,0000,,Иә... мұны істегіңіз келе ме? Не?
Dialogue: 0,1:16:48.74,1:16:50.91,Default,,0000,0000,0000,,О, сен мұны істейсің бе? Апыр-ай!
Dialogue: 0,1:16:50.91,1:16:53.58,Default,,0000,0000,0000,,А... орындаймыз ба? Уф….
Dialogue: 0,1:16:53.58,1:16:55.58,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:16:55.58,1:16:58.91,Default,,0000,0000,0000,,Se-no….
Dialogue: 0,1:16:55.58,1:16:58.91,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:16:58.91,1:17:02.72,Default,,0000,0000,0000,,Уау, у... аа...
Dialogue: 0,1:17:08.92,1:17:10.93,Default,,0000,0000,0000,,Әлсіз...
Dialogue: 0,1:17:10.93,1:17:12.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:17:12.93,1:17:20.24,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,1:17:25.11,1:17:27.11,Default,,0000,0000,0000,,Шо... бұл ойын!
Dialogue: 0,1:17:27.11,1:17:31.95,Default,,0000,0000,0000,,Кім қысқасын тартса, сол жеңіледі!
Dialogue: 0,1:17:27.11,1:17:31.95,Default,,0000,0000,0000,,Үніңді жап, бұл қаладан кет.
Dialogue: 0,1:17:31.95,1:17:35.72,Default,,0000,0000,0000,,Адамның алдаусыз ойыны.
Dialogue: 0,1:17:31.95,1:17:35.72,Default,,0000,0000,0000,,Сәлем... Жабыңыз!
Dialogue: 0,1:17:35.72,1:17:37.72,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:17:37.72,1:17:41.72,Default,,0000,0000,0000,,Ння….
Dialogue: 0,1:17:37.72,1:17:41.72,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:17:41.72,1:17:44.73,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:17:41.72,1:17:44.73,Default,,0000,0000,0000,,Иә, жасайық!
Dialogue: 0,1:17:44.73,1:17:48.93,Default,,0000,0000,0000,,Шо... Шо... Ня!
Dialogue: 0,1:18:01.24,1:18:04.75,Default,,0000,0000,0000,,Ой... уау!
Dialogue: 0,1:18:01.24,1:18:04.75,Default,,0000,0000,0000,,Карин!
Dialogue: 0,1:18:04.75,1:18:07.58,Default,,0000,0000,0000,,～
Dialogue: 0,1:18:07.58,1:18:10.59,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:18:07.58,1:18:10.59,Default,,0000,0000,0000,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,1:18:10.59,1:18:13.19,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:18:15.76,1:18:17.76,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:18:15.76,1:18:17.76,Default,,0000,0000,0000,,Карин!
Dialogue: 0,1:18:17.76,1:18:20.10,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:18:20.10,1:18:22.76,Default,,0000,0000,0000,,Уф! Уф….
Dialogue: 0,1:18:22.76,1:18:24.77,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз.
Dialogue: 0,1:18:24.77,1:18:27.67,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:18:24.77,1:18:27.67,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:18:31.44,1:18:33.94,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:18:39.05,1:18:42.05,Default,,0000,0000,0000,,Лорд Энма, тоқтаңыз.
Dialogue: 0,1:18:42.05,1:18:44.89,Default,,0000,0000,0000,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,1:18:44.89,1:18:46.89,Default,,0000,0000,0000,,Сіз шығуға болады➡
Dialogue: 0,1:18:46.89,1:18:49.59,Default,,0000,0000,0000,,Мен қайтқанда не болады?
Dialogue: 0,1:18:46.89,1:18:49.59,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,1:18:51.73,1:18:54.40,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:18:54.40,1:18:58.70,Default,,0000,0000,0000,,Сіз бұған дайынсыз ба?
Dialogue: 0,1:19:12.91,1:19:14.92,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:19:24.26,1:19:26.26,Default,,0000,0000,0000,,Жарайды, үйге қайтайық.
Dialogue: 0,1:19:26.26,1:19:28.66,Default,,0000,0000,0000,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:19:30.60,1:19:32.77,Default,,0000,0000,0000,,Барып салқындатқышыңызды алыңыз➡
Dialogue: 0,1:19:32.77,1:19:34.77,Default,,0000,0000,0000,,Тек жалғастырыңыз.
Dialogue: 0,1:19:32.77,1:19:34.77,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:19:38.87,1:19:41.38,Default,,0000,0000,0000,,Баратын уақыт келді.
Dialogue: 0,1:19:41.38,1:19:43.88,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:19:41.38,1:19:43.88,Default,,0000,0000,0000,,Карин.
Dialogue: 0,1:19:43.88,1:19:46.05,Default,,0000,0000,0000,,Мүлдем жоқ.
Dialogue: 0,1:19:46.05,1:19:49.15,Default,,0000,0000,0000,,Өлген адамдар
Dialogue: 0,1:19:46.05,1:19:49.15,Default,,0000,0000,0000,,Бұл жерге келуге болмайды.
Dialogue: 0,1:19:51.89,1:19:53.89,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:19:53.89,1:19:55.89,Default,,0000,0000,0000,,Онда мен сол жаққа барамын.
Dialogue: 0,1:19:55.89,1:19:58.39,Default,,0000,0000,0000,,Сіз осында болсаңыз да
Dialogue: 0,1:19:55.89,1:19:58.39,Default,,0000,0000,0000,,Мұның жақсы жағы жоқ.
Dialogue: 0,1:19:58.39,1:20:00.73,Default,,0000,0000,0000,,Сіз келе алмайсыз!
Dialogue: 0,1:20:00.73,1:20:03.40,Default,,0000,0000,0000,,Жоқ, кеттік!
Dialogue: 0,1:20:00.73,1:20:03.40,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:20:03.40,1:20:06.40,Default,,0000,0000,0000,,Мен осылайша қызықтырақ екеніне сенімдімін.
Dialogue: 0,1:20:03.40,1:20:06.40,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:20:06.40,1:20:08.90,Default,,0000,0000,0000,,Бұл жақсырақ
Dialogue: 0,1:20:06.40,1:20:08.90,Default,,0000,0000,0000,,Бұл қызық болатыны сөзсіз.
Dialogue: 0,1:20:08.90,1:20:11.07,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,1:20:11.07,1:20:15.91,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:20:11.07,1:20:15.91,Default,,0000,0000,0000,,Қарин ұзақ өмір сүретіні сөзсіз.
Dialogue: 0,1:20:15.91,1:20:19.25,Default,,0000,0000,0000,,Ұзақ өмір сүр
Dialogue: 0,1:20:15.91,1:20:19.25,Default,,0000,0000,0000,,Көптеген қызықты нәрселерді жасаңыз.
Dialogue: 0,1:20:19.25,1:20:21.92,Default,,0000,0000,0000,,Әртүрлі адамдармен кездесу
Dialogue: 0,1:20:19.25,1:20:21.92,Default,,0000,0000,0000,,Дәмді нәрсе жеңіз➡
Dialogue: 0,1:20:21.92,1:20:23.92,Default,,0000,0000,0000,,Сосын көп...
Dialogue: 0,1:20:23.92,1:20:26.09,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,1:20:26.09,1:20:29.09,Default,,0000,0000,0000,,Анашым, осында мәңгі қалуыңызды өтінемін.
Dialogue: 0,1:20:32.26,1:20:35.10,Default,,0000,0000,0000,,Кешіріңіз Карин
Dialogue: 0,1:20:32.26,1:20:35.10,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:20:35.10,1:20:37.20,Default,,0000,0000,0000,,Ана, ол қайтыс болды.
Dialogue: 0,1:20:39.27,1:20:41.67,Default,,0000,0000,0000,,Бір жерде тағы кездесе аламыз ба?
Dialogue: 0,1:20:44.61,1:20:47.71,Default,,0000,0000,0000,,Кездесетінімізге сенімдімін.
Dialogue: 0,1:20:51.45,1:20:53.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:21:04.29,1:21:08.00,Default,,0000,0000,0000,,Рахмет, Бакенеко мырза.
Dialogue: 0,1:21:10.47,1:21:13.27,Default,,0000,0000,0000,,Уау...
Dialogue: 0,1:21:26.15,1:21:28.25,Default,,0000,0000,0000,,Анашым!
Dialogue: 0,1:21:32.65,1:21:35.26,Default,,0000,0000,0000,,Мен қол ұстай аламын
Dialogue: 0,1:21:32.65,1:21:35.26,Default,,0000,0000,0000,,Бұл болды.
Dialogue: 0,1:21:38.59,1:21:40.70,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:21:45.77,1:21:47.94,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:21:47.94,1:21:51.24,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,1:21:47.94,1:21:51.24,Default,,0000,0000,0000,,Пайдасыз нәрселерді есте сақтаңыз...
Dialogue: 0,1:21:54.61,1:21:57.11,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:21:57.11,1:22:00.42,Default,,0000,0000,0000,,Мені жеңуге әлі 100 жыл ерте.
Dialogue: 0,1:22:06.12,1:22:11.29,Default,,0000,0000,0000,,Қош бол анашым!
Dialogue: 0,1:22:11.29,1:22:13.30,Default,,0000,0000,0000,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:22:13.30,1:22:42.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:22:42.09,1:22:45.59,Default,,0000,0000,0000,,Мен осындамын.
Dialogue: 0,1:22:45.59,1:22:47.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:22:47.60,1:22:52.43,Default,,0000,0000,0000,,Мен құбыжық мысық болғандықтан, мен өлмеймін.
Dialogue: 0,1:22:52.43,1:22:55.14,Default,,0000,0000,0000,,Ня әрқашан менің жанымда.
Dialogue: 0,1:22:58.77,1:23:00.78,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:23:04.95,1:23:09.45,Default,,0000,0000,0000,,Жоқ! Хмм...!
Dialogue: 0,1:23:11.45,1:23:14.29,Default,,0000,0000,0000,,～
Dialogue: 0,1:23:11.45,1:23:14.29,Default,,0000,0000,0000,,Бұл көлікке не болды?
Dialogue: 0,1:23:14.29,1:23:16.46,Default,,0000,0000,0000,,Оны әжем сатып алған.
Dialogue: 0,1:23:14.29,1:23:16.46,Default,,0000,0000,0000,,Мен лотерея ұтып алдым.
Dialogue: 0,1:23:16.46,1:23:20.46,Default,,0000,0000,0000,,Бұл 300 миллион иен.
Dialogue: 0,1:23:16.46,1:23:20.46,Default,,0000,0000,0000,,Эй, Мацуу!
Dialogue: 0,1:23:20.46,1:23:24.80,Default,,0000,0000,0000,,Ал, қайталап көрейік.
Dialogue: 0,1:23:20.46,1:23:24.80,Default,,0000,0000,0000,,Мен байсалды боламын!
Dialogue: 0,1:23:24.80,1:23:27.64,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:23:27.64,1:23:29.80,Default,,0000,0000,0000,,Уф….
Dialogue: 0,1:23:29.80,1:23:31.81,Default,,0000,0000,0000,,Төмендету
Dialogue: 0,1:23:29.80,1:23:31.81,Default,,0000,0000,0000,,Төмен, төмен, төмен….
Dialogue: 0,1:23:31.81,1:23:33.74,Default,,0000,0000,0000,,Өзіңізді қатты итермеңіз.
Dialogue: 0,1:23:33.74,1:23:44.42,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:23:44.42,1:23:47.09,Default,,0000,0000,0000,,(Өріктің шуылдауы)
Dialogue: 0,1:23:47.09,1:23:52.43,Default,,0000,0000,0000,,♬ «Шабадабада Бадабада»
Dialogue: 0,1:23:52.43,1:23:54.73,Default,,0000,0000,0000,,♬ «Дадарара»
Dialogue: 0,1:24:00.44,1:24:03.64,Default,,0000,0000,0000,,Сіз балық аулап жүрсіз бе?
Dialogue: 0,1:24:00.44,1:24:03.64,Default,,0000,0000,0000,,Мүлдем емес.
Dialogue: 0,1:24:09.28,1:24:11.95,Default,,0000,0000,0000,,Хаяши-кун.
Dialogue: 0,1:24:09.28,1:24:11.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:24:11.95,1:24:15.78,Default,,0000,0000,0000,,Барлығы үшін кешірім сұраймын.
Dialogue: 0,1:24:15.78,1:24:19.45,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:24:19.45,1:24:23.79,Default,,0000,0000,0000,,Жоқ, бәрібір.
Dialogue: 0,1:24:19.45,1:24:23.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:24:23.79,1:24:29.80,Default,,0000,0000,0000,,Мен сізден тұрақты қолдау күтемін.
Dialogue: 0,1:24:23.79,1:24:29.80,Default,,0000,0000,0000,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,1:24:29.80,1:24:33.57,Default,,0000,0000,0000,,Бұл қажет болды!
Dialogue: 0,1:24:33.57,1:24:36.57,Default,,0000,0000,0000,,Ой, не?
Dialogue: 0,1:24:36.57,1:24:38.57,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:24:38.57,1:24:41.91,Default,,0000,0000,0000,,Хаяши Үлкен!
Dialogue: 0,1:24:38.57,1:24:41.91,Default,,0000,0000,0000,,Бұл кальмар! Бұл кальмар!
Dialogue: 0,1:24:41.91,1:24:45.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:24:45.41,1:24:48.42,Default,,0000,0000,0000,,Енді жоқ... Мен кальмарды жек көремін...
Dialogue: 0,1:24:48.42,1:24:53.25,Default,,0000,0000,0000,,Мен кальмарды ұнатпаймын.
Dialogue: 0,1:24:48.42,1:24:53.25,Default,,0000,0000,0000,,Бұл кальмар сияқты ма? Мияу ха!
Dialogue: 0,1:24:53.25,1:24:56.09,Default,,0000,0000,0000,,Толық кауль!
Dialogue: 0,1:24:53.25,1:24:56.09,Default,,0000,0000,0000,,Сіз өлмейсіз, солай ма?
Dialogue: 0,1:24:56.09,1:24:58.26,Default,,0000,0000,0000,,Өйткені мен құбыжық мысықпын.
Dialogue: 0,1:24:58.26,1:25:00.26,Default,,0000,0000,0000,,(ысқыру дыбысы)
Dialogue: 0,1:25:00.26,1:25:04.10,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,1:25:00.26,1:25:04.10,Default,,0000,0000,0000,,Няхахахаха!
Dialogue: 0,1:25:04.10,1:25:06.27,Default,,0000,0000,0000,,Қарғыс атқыр мысық! Шынымен өл!
Dialogue: 0,1:25:06.27,1:25:08.94,Default,,0000,0000,0000,,Иіс иісі….
Dialogue: 0,1:25:06.27,1:25:08.94,Default,,0000,0000,0000,,О, мен әлі бара алмаймын.
Dialogue: 0,1:25:08.94,1:25:10.94,Default,,0000,0000,0000,,(ысқыру дыбысы)
Dialogue: 0,1:25:10.94,1:25:14.24,Default,,0000,0000,0000,,Сіз не жедіңіз?
Dialogue: 0,1:25:10.94,1:25:14.24,Default,,0000,0000,0000,,Няхахаха!
Dialogue: 0,1:25:18.95,1:25:21.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:25:21.28,1:25:23.45,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:25:23.45,1:25:27.26,Default,,0000,0000,0000,,Иә! Қалайсың?
Dialogue: 0,1:25:29.62,1:25:31.79,Default,,0000,0000,0000,,Мен өліп қала жаздадым➡
Dialogue: 0,1:25:31.79,1:25:36.73,Default,,0000,0000,0000,,Маған дәл ақшаны қайтарыңыз
Dialogue: 0,1:25:31.79,1:25:36.73,Default,,0000,0000,0000,,Күн ашық, мен сені алып кетуге келдім.
Dialogue: 0,1:25:36.73,1:25:39.40,Default,,0000,0000,0000,,Жүр, заттарыңды жина. Барайық.
Dialogue: 0,1:25:39.40,1:25:43.24,Default,,0000,0000,0000,,Кенеттен не болды? Мен бармаймын.
Dialogue: 0,1:25:43.24,1:25:46.74,Default,,0000,0000,0000,,Бұлай ашуланба.
Dialogue: 0,1:25:46.74,1:25:50.15,Default,,0000,0000,0000,,Маған ұнайтын нәрсе
Dialogue: 0,1:25:46.74,1:25:50.15,Default,,0000,0000,0000,,Мен саған кез келген нәрсені сатып аламын.
Dialogue: 0,1:26:15.60,1:26:17.94,Default,,0000,0000,0000,,Іс жүзінде...
Dialogue: 0,1:26:17.94,1:26:20.78,Default,,0000,0000,0000,,Мен оны Карин-чаннан сақтадым.
Dialogue: 0,1:26:17.94,1:26:20.78,Default,,0000,0000,0000,,Толық емес жұмыс күні үшін төлем➡
Dialogue: 0,1:26:20.78,1:26:23.11,Default,,0000,0000,0000,,Сіз мұның бәрін қолдандыңыз, солай емес пе?
Dialogue: 0,1:26:23.11,1:26:26.78,Default,,0000,0000,0000,,Иә? Сіз оны не үшін пайдаландыңыз?
Dialogue: 0,1:26:26.78,1:26:30.79,Default,,0000,0000,0000,,Пачинко. Мен оны көбейтуді ойлап отырмын.
Dialogue: 0,1:26:30.79,1:26:34.06,Default,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:26:34.06,1:26:38.16,Default,,0000,0000,0000,,Мен сізге келесі жолы төлеймін. Өтінемін, мені кешірші.
Dialogue: 0,1:26:42.06,1:26:44.37,Default,,0000,0000,0000,,Сіз мені кешіресіз бе?
Dialogue: 0,1:26:48.40,1:26:50.71,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:26:57.25,1:26:59.95,Default,,0000,0000,0000,,«Кешіріңіз, ақымақ!
Dialogue: 0,1:27:03.92,1:27:07.22,Default,,0000,0000,0000,,Мен сені жек көремін!
Dialogue: 0,1:27:18.43,1:27:34.22,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:27:34.22,1:27:37.39,Default,,0000,0000,0000,,Қолдарың жақсы ма?
Dialogue: 0,1:27:37.39,1:27:40.89,Default,,0000,0000,0000,,Есегіңді сүрту қиын.
Dialogue: 0,1:27:37.39,1:27:40.89,Default,,0000,0000,0000,,Хехе, жарайды, жарайды.
Dialogue: 0,1:27:40.89,1:27:45.56,Default,,0000,0000,0000,,Мен мұны дұрыс деп ойламадым.
Dialogue: 0,1:27:45.56,1:27:47.56,Default,,0000,0000,0000,,Жоқ, бірақ бұл ақылсыз болды.
Dialogue: 0,1:27:47.56,1:27:49.90,Default,,0000,0000,0000,,Мен қатты өліп жатырмын➡
Dialogue: 0,1:27:49.90,1:27:52.40,Default,,0000,0000,0000,,Біртүрлі дүние көрдім.
Dialogue: 0,1:27:52.40,1:27:57.91,Default,,0000,0000,0000,,Тозақ сияқты, жұмақтай.
Dialogue: 0,1:27:52.40,1:27:57.91,Default,,0000,0000,0000,,Мен бұл не болды деп ойлаймын ...
Dialogue: 0,1:27:57.91,1:28:01.41,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,1:27:57.91,1:28:01.41,Default,,0000,0000,0000,,Не? Бұл не?
Dialogue: 0,1:28:01.41,1:28:03.71,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,1:28:15.42,1:29:02.90,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:29:02.90,1:29:06.07,Default,,0000,0000,0000,,(кету ысқырығы)
Dialogue: 0,1:29:06.07,1:29:10.08,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,1:29:06.07,1:29:10.08,Default,,0000,0000,0000,,Күте тұрыңыз! О, мен оны уақытында жасадым.
Dialogue: 0,1:29:10.08,1:29:12.68,Default,,0000,0000,0000,,А, ыстық...
Dialogue: 0,1:29:10.08,1:29:12.68,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,1:29:19.25,1:29:21.42,Default,,0000,0000,0000,,Әке, кешіріңіз.
Dialogue: 0,1:29:21.42,1:29:23.76,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:29:23.76,1:29:26.76,Default,,0000,0000,0000,,Мен тез есейемін.
Dialogue: 0,1:29:26.76,1:29:28.76,Default,,0000,0000,0000,,Бір минут күте тұрыңыз, Карин!
Dialogue: 0,1:29:30.93,1:29:32.93,Default,,0000,0000,0000,,Мен қайтып келетініме сенімдімін!
Dialogue: 0,1:29:32.93,1:29:37.04,Default,,0000,0000,0000,,Мектеп пен мектепке үнемі барыңыз
Dialogue: 0,1:29:32.93,1:29:37.04,Default,,0000,0000,0000,,Сен жақсы қыз боласың!
Dialogue: 0,1:29:37.04,1:29:42.04,Default,,0000,0000,0000,,Сонымен… Демек, сондықтан….
Dialogue: 0,1:29:42.04,1:29:44.35,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,1:29:46.88,1:29:49.88,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:29:49.88,1:29:52.89,Default,,0000,0000,0000,,Шапалақ!
Dialogue: 0,1:29:52.89,1:29:55.22,Default,,0000,0000,0000,,Қытырлақ.
Dialogue: 0,1:29:55.22,1:29:57.23,Default,,0000,0000,0000,,Бұл да!
Dialogue: 0,1:29:57.23,1:30:15.58,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:15.58,1:30:22.08,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,1:30:22.08,1:30:24.09,Default,,0000,0000,0000,,Анзу-чан!
Dialogue: 0,1:30:25.59,1:30:31.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory