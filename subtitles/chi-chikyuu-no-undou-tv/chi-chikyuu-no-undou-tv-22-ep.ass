Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.16,0:00:04.79,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:06.25,0:00:08.80,Default,,0,0,0,,Бұл барлық керек-жарақтар.
Dialogue: 0,0:00:15.72,0:00:17.05,Default,,0,0,0,,Қылышты алыңыз
Dialogue: 0,0:00:21.22,0:00:23.52,Default,,0,0,0,,Жарайды, Дурака мырза, кеттік.
Dialogue: 0,0:00:23.60,0:00:25.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:26.48,0:00:29.65,Default,,0,0,0,,Сіз бұған ризасыз ба?
Dialogue: 0,0:00:29.73,0:00:31.23,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:00:32.44,0:00:34.45,Default,,0,0,0,,Жақсы да, жаман да емес
Dialogue: 0,0:00:39.28,0:00:41.45,Default,,0,0,0,,Біз кеше ғана кездестік.
Dialogue: 0,0:00:41.54,0:00:46.33,Default,,0,0,0,,Мен бәрін танымаймын және мені бәрі де танымайды
Dialogue: 0,0:00:47.83,0:00:51.84,Default,,0,0,0,,Бірақ біз Джолентаны білеміз.
Dialogue: 0,0:00:52.96,0:00:54.63,Default,,0,0,0,,Ол адам менмін
Dialogue: 0,0:00:54.72,0:00:57.59,Default,,0,0,0,,Ол маған баспаханасын қарызға беруді ұсынды...
Dialogue: 0,0:00:58.51,0:01:01.68,Default,,0,0,0,,Нені сататыныңыз жаңа ашқандарыңызға байланысты.
Dialogue: 0,0:01:02.56,0:01:06.94,Default,,0,0,0,,Жағдайы жаман емес деп ойлаймын, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:01:08.77,0:01:10.57,Default,,0,0,0,,Бұл бір сөз
Dialogue: 0,0:01:10.65,0:01:13.94,Default,,0,0,0,,Кітап мазмұнының орнына алынған сөздер
Dialogue: 0,0:01:14.03,0:01:15.78,Default,,0,0,0,,Йолентаның көзқарасы бойынша
Dialogue: 0,0:01:15.86,0:01:19.32,Default,,0,0,0,,Бұл жеңіл пікір болуы мүмкін, бірақ
Dialogue: 0,0:01:19.41,0:01:23.79,Default,,0,0,0,,Бірақ мен үшін бұл дауыс
Dialogue: 0,0:01:23.87,0:01:29.63,Default,,0,0,0,,Бұл менің құндылықтарым мен болашағымды растау сияқты болды.
Dialogue: 0,0:01:30.92,0:01:33.42,Default,,0,0,0,,Мен мұнда да адамдар екеніне сенімдімін
Dialogue: 0,0:01:33.51,0:01:37.68,Default,,0,0,0,,Йолентаға, бұл ұйымда менде осындай сезім болған сәт болды.
Dialogue: 0,0:01:37.76,0:01:39.55,Default,,0,0,0,,Мен осындамын деп ойлаймын.
Dialogue: 0,0:01:41.35,0:01:44.56,Default,,0,0,0,,Сонымен менің айтқым келгені
Dialogue: 0,0:01:50.40,0:01:52.27,Default,,0,0,0,,Мен де жұмыс істеймін
Dialogue: 0,0:01:53.27,0:01:55.19,Default,,0,0,0,,О, мен сұрадым.
Dialogue: 0,0:01:55.78,0:01:56.82,Default,,0,0,0,,Иә
Dialogue: 0,0:01:59.41,0:02:04.16,Default,,0,0,0,,♪~
Dialogue: 0,0:03:23.53,0:03:27.91,Default,,0,0,0,,~♪
Dialogue: 0,0:03:33.21,0:03:35.42,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:03:36.88,0:03:39.92,Default,,0,0,0,,Өткен жолғы өзімді-өзім жоюды санамнан шығара алмаймын.
Dialogue: 0,0:03:40.84,0:03:45.76,Default,,0,0,0,,Олар өз мақсаттары үшін бәрін жасайтын шығар.
Dialogue: 0,0:03:46.26,0:03:48.51,Default,,0,0,0,,Бұл... қорқынышты
Dialogue: 0,0:03:52.02,0:03:56.52,Default,,0,0,0,,Таңертең әдеттегідей бірнеше сағаттан кейін қайталанады.
Dialogue: 0,0:03:57.27,0:03:58.57,Default,,0,0,0,,Бір күні саған да
Dialogue: 0,0:03:58.65,0:04:01.69,Default,,0,0,0,,Таңертеңгі шуақпен күлетін күн туар деп сенемін.
Dialogue: 0,0:04:02.36,0:04:03.95,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:04:04.03,0:04:06.82,Default,,0,0,0,,Сондықтан таңғы күнді ұнатпаймын...
Dialogue: 0,0:04:06.91,0:04:10.16,Default,,0,0,0,,Бір нәрсені қайта-қайта айтуды тоқтата аласыз ба?
Dialogue: 0,0:04:06.91,0:04:10.16,Default,,0,0,0,,(болттың алыну дыбысы)
Dialogue: 0,0:04:10.25,0:04:11.83,Default,,0,0,0,,Бұл қиыншылық
Dialogue: 0,0:04:11.91,0:04:13.58,Default,,0,0,0,,Жоқ, ол бірдей емес.
Dialogue: 0,0:04:14.37,0:04:16.33,Default,,0,0,0,,Мен бұл жолы байыптымын
Dialogue: 0,0:04:16.42,0:04:17.71,Default,,0,0,0,,ше? Шын айтасың ба?
Dialogue: 0,0:04:20.13,0:04:21.76,Default,,0,0,0,,Бұл қудалау ма?
Dialogue: 0,0:04:21.84,0:04:26.09,Default,,0,0,0,,Бұл мүмкін, бірақ бұл менің рахмет айту тәсілім.
Dialogue: 0,0:04:26.18,0:04:29.01,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:04:32.77,0:04:35.40,Default,,0,0,0,,Тіпті ол сізге тартымды болмаса да
Dialogue: 0,0:04:35.48,0:04:39.36,Default,,0,0,0,,Мен үшін бұл әлемдегі ең керемет уақыт.
Dialogue: 0,0:04:40.15,0:04:42.15,Default,,0,0,0,,Мен мұны сізге айтқым келеді.
Dialogue: 0,0:04:42.94,0:04:45.36,Default,,0,0,0,,күрсініп... неге?
Dialogue: 0,0:04:46.41,0:04:47.24,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:04:47.99,0:04:50.03,Default,,0,0,0,,Бірақ мүмкін
Dialogue: 0,0:04:50.12,0:04:54.25,Default,,0,0,0,,Сіз екеуміз кездейсоқ кездескендіктен болар.
Dialogue: 0,0:04:56.04,0:04:57.67,Default,,0,0,0,,(каретаның тоқтаған дыбысы)
Dialogue: 0,0:05:11.93,0:05:13.77,Default,,0,0,0,,Өте тыныш.
Dialogue: 0,0:05:14.31,0:05:16.73,Default,,0,0,0,,Мен... Мен инквизитормын.
Dialogue: 0,0:05:17.31,0:05:19.48,Default,,0,0,0,,Мен сенің не үшін барғаныңды білемін.
Dialogue: 0,0:05:19.56,0:05:21.77,Default,,0,0,0,,Момындықпен беріл!
Dialogue: 0,0:05:26.49,0:05:27.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:36.04,0:05:37.50,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:05:40.54,0:05:41.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:41.88,0:05:43.67,Default,,0,0,0,,Testudo?
Dialogue: 0,0:05:44.17,0:05:48.51,Default,,0,0,0,,Дүрбелеңге түспеңіз. Ол құрама қоян-қолтық ұрыста әлсіз.
Dialogue: 0,0:05:48.59,0:05:50.22,Default,,0,0,0,,- (Новак) Сонымен... - Жақын!
Dialogue: 0,0:05:50.30,0:05:51.55,Default,,0,0,0,,Оны қоян-қолтық ұрысқа әкелу.
Dialogue: 0,0:05:51.64,0:05:52.47,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:05:52.56,0:05:54.47,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:05:54.56,0:05:55.85,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:05:55.93,0:05:57.89,Default,,0,0,0,,(рыцарлардың ұрыс айқайы)
Dialogue: 0,0:05:58.85,0:05:59.98,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:06:04.03,0:06:05.19,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:06:05.28,0:06:06.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:07.90,0:06:09.53,Default,,0,0,0,,Оң жақтан көбірек шабуыл жасаңыз!
Dialogue: 0,0:06:09.53,0:06:10.41,Default,,0,0,0,,Оң жақтан көбірек шабуыл жасаңыз!
Dialogue: 0,0:06:09.53,0:06:10.41,Default,,0,0,0,,(аттан құлаған дыбыс)
Dialogue: 0,0:06:10.41,0:06:10.49,Default,,0,0,0,,(аттан құлаған дыбыс)
Dialogue: 0,0:06:10.49,0:06:11.32,Default,,0,0,0,,(аттан құлаған дыбыс)
Dialogue: 0,0:06:10.49,0:06:11.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.04,0:06:17.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:17.54,0:06:18.54,Default,,0,0,0,,Уау
Dialogue: 0,0:06:19.37,0:06:20.33,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:20.92,0:06:22.96,Default,,0,0,0,,Ештеңе, мынау алдау ма?
Dialogue: 0,0:06:24.30,0:06:27.47,Default,,0,0,0,,Арбаны бөліп, аттармен жалғыз қалдыр.
Dialogue: 0,0:06:28.38,0:06:29.22,Default,,0,0,0,,Аш-кун
Dialogue: 0,0:06:30.30,0:06:31.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:31.55,0:06:34.39,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:06:37.27,0:06:40.90,Default,,0,0,0,,Бұл менің жұмысым ба?
Dialogue: 0,0:06:41.52,0:06:42.86,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:06:42.94,0:06:44.23,Default,,0,0,0,,
Dialogue: 0,0:06:50.49,0:06:52.78,Default,,0,0,0,,Шүкір, олар қуып жетті!
Dialogue: 0,0:06:52.87,0:06:55.12,Default,,0,0,0,,Аа, солай сияқты.
Dialogue: 0,0:06:55.62,0:06:57.04,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:59.91,0:07:03.00,Default,,0,0,0,,Мен өз таңдауымнан ешқашан қорықпадым
Dialogue: 0,0:07:03.08,0:07:03.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:04.75,0:07:09.88,Default,,0,0,0,,Өйткені мен бәрі Құдайдың мен үшін белгілеген тағдырымен жүреді деп ойладым.
Dialogue: 0,0:07:11.68,0:07:15.56,Default,,0,0,0,,Бірақ қазір бірінші рет қорқамын
Dialogue: 0,0:07:15.64,0:07:16.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:18.39,0:07:20.39,Default,,0,0,0,,Сәттілік тілеймін!
Dialogue: 0,0:07:21.14,0:07:22.60,Default,,0,0,0,,Шмидт мырза!
Dialogue: 0,0:07:25.40,0:07:26.40,Default,,0,0,0,,Уф
Dialogue: 0,0:07:27.28,0:07:29.28,Default,,0,0,0,,
Dialogue: 0,0:07:33.16,0:07:34.57,Default,,0,0,0,,-Ах! - (Рыцарлар) Уау.
Dialogue: 0,0:07:36.58,0:07:37.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:37.62,0:07:38.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.58,0:07:40.41,Default,,0,0,0,,Уф
Dialogue: 0,0:07:41.83,0:07:42.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:48.63,0:07:51.92,Default,,0,0,0,,Мен көптеген достарыңды өлтірдім.
Dialogue: 0,0:07:52.72,0:07:55.76,Default,,0,0,0,,Менің мотивім – менің діни себебім.
Dialogue: 0,0:07:56.26,0:08:00.68,Default,,0,0,0,,Бірақ қазір сол сенім ішімде дірілдеп тұр.
Dialogue: 0,0:08:01.18,0:08:05.44,Default,,0,0,0,,Енді сізді өлтіруге ешқандай негіз жоқ.
Dialogue: 0,0:08:05.52,0:08:08.44,Default,,0,0,0,,Бірақ мен сені бәрібір өлтіремін
Dialogue: 0,0:08:08.52,0:08:11.07,Default,,0,0,0,,Мотив – менің ыңғайлылығым.
Dialogue: 0,0:08:11.15,0:08:12.20,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:08:12.28,0:08:13.95,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:08:14.03,0:08:15.95,Default,,0,0,0,,Бұл еретик!
Dialogue: 0,0:08:16.03,0:08:17.20,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:08:17.28,0:08:18.41,Default,,0,0,0,,Гах…
Dialogue: 0,0:08:24.25,0:08:27.54,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:27.63,0:08:28.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:27.63,0:08:28.46,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:08:33.17,0:08:36.09,Default,,0,0,0,,Әй, тозаққа кет.
Dialogue: 0,0:08:40.81,0:08:43.43,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:48.44,0:08:50.69,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:51.44,0:08:53.61,Default,,0,0,0,,Гах... Гах...
Dialogue: 0,0:08:53.69,0:08:57.95,Default,,0,0,0,,А, өз қаныңа батып бара жатырсың ба?
Dialogue: 0,0:08:58.03,0:09:02.16,Default,,0,0,0,,Гелиоцентристік сенушіге жарасатын аянышты тағдыр.
Dialogue: 0,0:09:02.25,0:09:04.87,Default,,0,0,0,,(Шмидттің ыңырсыуы)
Dialogue: 0,0:09:05.54,0:09:08.00,Default,,0,0,0,,бірақ онымен бәсекеге түсер ешкім қалмады ма?
Dialogue: 0,0:09:08.08,0:09:12.80,Default,,0,0,0,,Бұл мен таңдаған тағдыр...
Dialogue: 0,0:09:27.06,0:09:30.69,Default,,0,0,0,,(Күзетшінің есінеу)
Dialogue: 0,0:09:31.19,0:09:32.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.36,0:09:38.49,Default,,0,0,0,,Осы сағатта сіз кімсіз?
Dialogue: 0,0:09:41.03,0:09:42.91,Default,,0,0,0,,Мен саяхатшымын.
Dialogue: 0,0:09:42.99,0:09:45.71,Default,,0,0,0,,Хмм, сертификат ше?
Dialogue: 0,0:09:47.58,0:09:48.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:48.50,0:09:50.04,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:09:53.59,0:09:55.30,Default,,0,0,0,,Епископ
Dialogue: 0,0:09:55.38,0:09:56.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:56.88,0:09:59.64,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:09:59.72,0:10:03.43,Default,,0,0,0,,Менің ұйқымды бұзуға қалай дәтің бар?
Dialogue: 0,0:10:03.51,0:10:07.56,Default,,0,0,0,,Мен қонақпын. Саған айтар маңызды нәрсем бар.
Dialogue: 0,0:10:07.64,0:10:08.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.90,0:10:11.31,Default,,0,0,0,,Ол қандай жігіт?
Dialogue: 0,0:10:11.40,0:10:13.02,Default,,0,0,0,,Мен әйелмін.
Dialogue: 0,0:10:13.11,0:10:16.32,Default,,0,0,0,,Сыртына қарағанда, көшпелі тайпадан шыққан көрінеді.
Dialogue: 0,0:10:17.78,0:10:19.20,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:19.28,0:10:21.91,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:24.29,0:10:26.33,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:10:27.16,0:10:28.91,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:10:29.42,0:10:31.58,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:10:33.84,0:10:35.50,Default,,0,0,0,,Болашақ
Dialogue: 0,0:10:35.59,0:10:38.09,Default,,0,0,0,,Бұл табысты әңгіме деп айтуға болады...
Dialogue: 0,0:10:40.76,0:10:42.60,Default,,0,0,0,,-Сен төмен түс.-(Дьякон) А?
Dialogue: 0,0:10:43.30,0:10:45.26,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:10:47.43,0:10:50.73,Default,,0,0,0,,Ах... Хмм...
Dialogue: 0,0:11:09.62,0:11:11.50,Default,,0,0,0,,Аяқ іздері…
Dialogue: 0,0:11:20.84,0:11:22.26,Default,,0,0,0,,Бұл пайда туралы әңгіме ме?
Dialogue: 0,0:11:22.89,0:11:24.39,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:11:24.47,0:11:27.01,Default,,0,0,0,,Қалай ақша табуға болады?
Dialogue: 0,0:11:27.60,0:11:29.64,Default,,0,0,0,,Мен сізге қысқаша айтып беремін.
Dialogue: 0,0:11:30.73,0:11:32.19,Default,,0,0,0,,Кітап
Dialogue: 0,0:11:32.27,0:11:36.02,Default,,0,0,0,,Мен бұл фьючерсті жеке иеленуге дайынмын.
Dialogue: 0,0:11:36.11,0:11:38.15,Default,,0,0,0,,Кітап жақсы сатылатын уақыт келеді деп ойлаймын.
Dialogue: 0,0:11:39.74,0:11:44.41,Default,,0,0,0,,Азаматтар енді дінді емес, ойын-сауықты қалайды.
Dialogue: 0,0:11:44.99,0:11:47.58,Default,,0,0,0,,Көшедегі қойылымдардан өлім жазасына дейін
Dialogue: 0,0:11:47.66,0:11:50.87,Default,,0,0,0,,Сені жалмау үшін жиналып жатқан олардың қаншалықты құмар екенін білесің.
Dialogue: 0,0:11:51.37,0:11:54.33,Default,,0,0,0,,Барлығы ынталандыруға ашты.
Dialogue: 0,0:11:55.13,0:11:57.04,Default,,0,0,0,,Кітап бар.
Dialogue: 0,0:11:57.13,0:12:01.09,Default,,0,0,0,,Хат – ойға тікелей жететін өрнектер.
Dialogue: 0,0:12:01.17,0:12:05.22,Default,,0,0,0,,Азаматтардың оқуын жеңілдетсеңіз, ол міндетті түрде тәуелділікке айналады.
Dialogue: 0,0:12:05.30,0:12:08.01,Default,,0,0,0,,Бұл ыңғайлы, себебі оны кез келген уақытта немесе кез келген жерде пайдалануға болады.
Dialogue: 0,0:12:08.10,0:12:13.52,Default,,0,0,0,,Кітаптарды баспа арқылы басып шығару арзан және керемет оңай.
Dialogue: 0,0:12:14.06,0:12:18.07,Default,,0,0,0,,Жанса, орасан зор пайда болады.
Dialogue: 0,0:12:18.15,0:12:21.32,Default,,0,0,0,,Сондықтан мен сіздердің ынтымақтастықтарыңызды қалаймын.
Dialogue: 0,0:12:21.90,0:12:25.57,Default,,0,0,0,,Мен баспа машинасын пайдалануға және кітап шығаруға рұқсат алғым келеді.
Dialogue: 0,0:12:25.66,0:12:27.83,Default,,0,0,0,,Біз сізге ешқашан шығын келтірмейміз.
Dialogue: 0,0:12:29.20,0:12:30.58,Default,,0,0,0,,Хо
Dialogue: 0,0:12:30.66,0:12:33.46,Default,,0,0,0,,Сонымен кітаптың мазмұны қандай?
Dialogue: 0,0:12:33.54,0:12:36.17,Default,,0,0,0,,Аа... мәселе осында.
Dialogue: 0,0:12:36.25,0:12:37.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.17,0:12:40.80,Default,,0,0,0,,Космологиялық идея...
Dialogue: 0,0:12:40.88,0:12:44.09,Default,,0,0,0,,Табиғат туралы белгілі бір гипотеза
Dialogue: 0,0:12:44.76,0:12:49.43,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл «жердің қозғалысы туралы»
Dialogue: 0,0:12:50.97,0:12:53.06,Default,,0,0,0,,Не дедіңіз...
Dialogue: 0,0:12:53.14,0:12:55.10,Default,,0,0,0,,Бұл адасушылық идеология ма?
Dialogue: 0,0:12:55.19,0:12:58.90,Default,,0,0,0,,Бірақ мен бұл туралы айтқым келеді.
Dialogue: 0,0:12:59.94,0:13:01.78,Default,,0,0,0,,Ойлан
Dialogue: 0,0:13:01.86,0:13:07.32,Default,,0,0,0,,Сіз тарихта гелиоцентрлік теория басылған кез келген прецедент туралы естідіңіз бе?
Dialogue: 0,0:13:07.95,0:13:11.79,Default,,0,0,0,,Бұл теория шынымен бидғат па?
Dialogue: 0,0:13:12.41,0:13:15.62,Default,,0,0,0,,Иә? Әрине бидғат
Dialogue: 0,0:13:15.71,0:13:17.46,Default,,0,0,0,,Жай ғана әзіл айтыңыз
Dialogue: 0,0:13:17.54,0:13:20.00,Default,,0,0,0,,Мен уақытымды босқа өткіздім.
Dialogue: 0,0:13:20.09,0:13:22.96,Default,,0,0,0,,Мен сені түрмеге жіберер алдында бірдеңе айтайын.
Dialogue: 0,0:13:23.05,0:13:27.76,Default,,0,0,0,,Менің әкем бір кездері гелиоцентрлік теорияға қатысты көптеген адамдарды соттады.
Dialogue: 0,0:13:27.84,0:13:31.51,Default,,0,0,0,,Қуғын-сүргінге байланысты…
Dialogue: 0,0:13:32.56,0:13:33.97,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:34.06,0:13:39.48,Default,,0,0,0,,Бірақ басқа жерде қысымшылық дегенді естімегенім рас.
Dialogue: 0,0:13:39.56,0:13:40.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:40.82,0:13:42.23,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:13:43.40,0:13:48.24,Default,,0,0,0,,Сөздің әсері басым болып, бәрі қорқып, қашып кетеді.
Dialogue: 0,0:13:48.32,0:13:52.37,Default,,0,0,0,,Мен бұл туралы алғаш білгенде, мен бұл қауіпті деп ойладым.
Dialogue: 0,0:13:52.45,0:13:56.87,Default,,0,0,0,,Шынында да, космология – Құдайдың жаратылысына қайшы келетін тақырып.
Dialogue: 0,0:13:56.96,0:13:59.67,Default,,0,0,0,,Әдетте одан аулақ болу керек.
Dialogue: 0,0:13:59.75,0:14:02.67,Default,,0,0,0,,Осы негізде үкім шығаруға болады.
Dialogue: 0,0:14:02.75,0:14:04.38,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:14:05.05,0:14:07.68,Default,,0,0,0,,бірақ
Dialogue: 0,0:14:07.76,0:14:09.89,Default,,0,0,0,,Керісінше, сақ болғанша
Dialogue: 0,0:14:10.51,0:14:14.64,Default,,0,0,0,,Оған міндетті түрде тыйым салу керек емес пе?
Dialogue: 0,0:14:14.72,0:14:19.52,Default,,0,0,0,,Бұл қызықты ойын-сауық емес пе?
Dialogue: 0,0:14:21.11,0:14:22.19,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:23.86,0:14:26.40,Default,,0,0,0,,Қысқасы, сіздің ойыңызша
Dialogue: 0,0:14:26.49,0:14:28.53,Default,,0,0,0,,Гелиоцентризм бидғат па
Dialogue: 0,0:14:28.61,0:14:33.03,Default,,0,0,0,,Сол кездегі билік басындағылардың еркіне қарай қалағаныңызша өзгертуге бола ма?
Dialogue: 0,0:14:33.12,0:14:35.54,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:14:37.71,0:14:39.04,Default,,0,0,0,,-Жарайды. -Ах.
Dialogue: 0,0:14:39.12,0:14:41.67,Default,,0,0,0,,Тек бір нәрсені түсініңіз.
Dialogue: 0,0:14:43.00,0:14:47.17,Default,,0,0,0,,Мен сені желдің бағытына қарай қалағанымша кесемін
Dialogue: 0,0:14:48.88,0:14:51.39,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:14:51.47,0:14:52.55,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:14:52.64,0:14:55.56,Default,,0,0,0,,Пайданың маңызды бөлінуі қандай?
Dialogue: 0,0:14:56.22,0:14:57.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.65,0:15:04.06,Default,,0,0,0,,5-5
Dialogue: 0,0:15:04.15,0:15:06.36,Default,,0,0,0,,Ха, қалжыңдама.
Dialogue: 0,0:15:06.44,0:15:08.86,Default,,0,0,0,,Менің келісімімді қарастырыңыз.
Dialogue: 0,0:15:09.90,0:15:12.16,Default,,0,0,0,,Бұл 8-ден 2-ге дейін.
Dialogue: 0,0:15:12.24,0:15:13.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.62,0:15:17.66,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:19.71,0:15:23.04,Default,,0,0,0,,Сонымен, әңгіме аяқталды.
Dialogue: 0,0:15:24.25,0:15:26.46,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:15:31.68,0:15:32.84,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:15:32.93,0:15:33.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:34.35,0:15:38.14,Default,,0,0,0,,Мен жарияланғаннан кейін хат жібергім келеді.
Dialogue: 0,0:15:38.22,0:15:39.27,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:15:40.18,0:15:43.06,Default,,0,0,0,,Олай болса менің тасымалдаушы көгершінімді пайдаланыңыз.
Dialogue: 0,0:15:43.15,0:15:45.02,Default,,0,0,0,,Қазір әкелейін.
Dialogue: 0,0:15:46.32,0:15:47.07,Default,,0,0,0,,(Найза ұстаған дыбыс)
Dialogue: 0,0:15:47.07,0:15:48.03,Default,,0,0,0,,(Найза ұстаған дыбыс)
Dialogue: 0,0:15:47.07,0:15:48.03,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:15:49.99,0:15:52.74,Default,,0,0,0,,Ол бидғат тергеуімен ынтымақтасады.
Dialogue: 0,0:15:52.82,0:15:54.16,Default,,0,0,0,,Бұл рұқсат
Dialogue: 0,0:15:55.03,0:15:57.99,Default,,0,0,0,,Егер сіз күдіктінің ізімен жүрсеңіз, осында өтіңіз
Dialogue: 0,0:15:58.08,0:16:00.66,Default,,0,0,0,,Күдікті біреу келді ме?
Dialogue: 0,0:16:00.75,0:16:04.17,Default,,0,0,0,,А... Енді ойлап қарасам, әйел болды
Dialogue: 0,0:16:04.25,0:16:06.79,Default,,0,0,0,,Әйел? қайда бардың
Dialogue: 0,0:16:06.88,0:16:10.09,Default,,0,0,0,,Не? шіркеуге қарай
Dialogue: 0,0:16:10.17,0:16:11.63,Default,,0,0,0,,Шіркеу…
Dialogue: 0,0:16:15.43,0:16:18.64,Default,,0,0,0,,Бұл жерде күшті алкоголь сататын дүкендер бар ма?
Dialogue: 0,0:16:29.57,0:16:30.40,Default,,0,0,0,,Ах
Dialogue: 0,0:16:32.53,0:16:33.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:33.61,0:16:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:35.36,0:16:37.78,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:16:38.91,0:16:40.79,Default,,0,0,0,,Епископ Антони?
Dialogue: 0,0:16:46.75,0:16:49.88,Default,,0,0,0,,Енді сіз мұнда епископсыз.
Dialogue: 0,0:16:49.96,0:16:54.01,Default,,0,0,0,,Мен Новакпын, мен бұрын инквизитор болғанмын...
Dialogue: 0,0:16:54.51,0:16:56.55,Default,,0,0,0,,А, есімде.
Dialogue: 0,0:16:56.64,0:16:59.64,Default,,0,0,0,,Ендеше... өтінемін, ол әйелден аулақ болыңыз.
Dialogue: 0,0:16:59.72,0:17:00.56,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:17:00.64,0:17:02.27,Default,,0,0,0,,Бұл бидғатшы
Dialogue: 0,0:17:02.35,0:17:05.02,Default,,0,0,0,,Сол гелиоцентрлік теория...
Dialogue: 0,0:17:06.56,0:17:07.77,Default,,0,0,0,,О
Dialogue: 0,0:17:07.86,0:17:10.07,Default,,0,0,0,,Ах... «Ах»...
Dialogue: 0,0:17:10.57,0:17:12.07,Default,,0,0,0,,Гелиоцентрлік теория.
Dialogue: 0,0:17:12.15,0:17:16.24,Default,,0,0,0,,Әкең осыдан ерекше сақ болған!
Dialogue: 0,0:17:16.32,0:17:17.66,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:17:17.74,0:17:20.95,Default,,0,0,0,,Сондықтан тез кетіңізші...
Dialogue: 0,0:17:23.66,0:17:24.66,Default,,0,0,0,,А...
Dialogue: 0,0:17:25.25,0:17:27.29,Default,,0,0,0,,Не?
Dialogue: 0,0:17:27.96,0:17:29.92,Default,,0,0,0,,Сен неге үндемейсің?
Dialogue: 0,0:17:31.71,0:17:33.92,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:17:34.51,0:17:36.68,Default,,0,0,0,,Бұл қалжың ба?
Dialogue: 0,0:17:37.34,0:17:40.76,Default,,0,0,0,,Мен сенің күпірлік жасағаныңа сенбеймін...
Dialogue: 0,0:17:41.26,0:17:43.93,Default,,0,0,0,,Сізден бір нәрсе сұрайын.
Dialogue: 0,0:17:44.52,0:17:47.94,Default,,0,0,0,,Гелиоцентрлік теорияның мәселесі неде деп ойлайсыз?
Dialogue: 0,0:17:49.27,0:17:50.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.69,0:17:54.32,Default,,0,0,0,,Сонымен... Сонымен... Осымен.
Dialogue: 0,0:17:54.40,0:17:57.91,Default,,0,0,0,,Космология – Құдайдың жаратуымен байланысты сұрақ.
Dialogue: 0,0:17:57.99,0:18:00.53,Default,,0,0,0,,Толығырақ...
Dialogue: 0,0:18:01.45,0:18:02.66,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:18:03.16,0:18:04.87,Default,,0,0,0,,Алдыңғы епископ...
Dialogue: 0,0:18:04.95,0:18:06.87,Default,,0,0,0,,Бұл анық емес.
Dialogue: 0,0:18:06.96,0:18:08.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:08.29,0:18:09.83,Default,,0,0,0,,Тыңдаңыз, Новак мырза.
Dialogue: 0,0:18:09.92,0:18:12.88,Default,,0,0,0,,Түсінбесеңіз, анық айтыңыз.
Dialogue: 0,0:18:12.96,0:18:17.01,Default,,0,0,0,,Біреуді бидғатшы десең, азаптап өлтір
Dialogue: 0,0:18:17.09,0:18:19.68,Default,,0,0,0,,Осы себепті негіз бар ма?
Dialogue: 0,0:18:19.76,0:18:21.26,Default,,0,0,0,,Өзіңіз анықтаңыз
Dialogue: 0,0:18:21.35,0:18:23.76,Default,,0,0,0,,Өз әрекеттеріңіз үшін жауапкершілікті алыңыз
Dialogue: 0,0:18:23.85,0:18:26.56,Default,,0,0,0,,Жоқ... жоқ, заңдылық?
Dialogue: 0,0:18:27.18,0:18:29.77,Default,,0,0,0,,Иә... Киелі кітапта да бар екеніне сенімдімін.
Dialogue: 0,0:18:30.98,0:18:32.02,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:32.52,0:18:36.86,Default,,0,0,0,,«Жер берік, оны жылжыту мүмкін емес».
Dialogue: 0,0:18:36.94,0:18:42.24,Default,,0,0,0,,Немесе «Әлем берік орнықты және ешқашан шайқалмайды».
Dialogue: 0,0:18:42.87,0:18:46.04,Default,,0,0,0,,Дәл қазір менің ойыма осы ма?
Dialogue: 0,0:18:46.87,0:18:49.71,Default,,0,0,0,,Дегенмен, сабырмен ойласаңыз, мұны түсінуге болады
Dialogue: 0,0:18:49.79,0:18:54.55,Default,,0,0,0,,Бұл гелиоцентрлік теорияны жоққа шығарудың абсолютті негіздері емес.
Dialogue: 0,0:18:55.75,0:19:02.39,Default,,0,0,0,,Өйткені гелиоцентрлік теория жай ғана гипотеза.
Dialogue: 0,0:19:02.47,0:19:06.43,Default,,0,0,0,,Бір ғана ақиқат бар деп айту қауіпті болуы мүмкін.
Dialogue: 0,0:19:07.02,0:19:10.31,Default,,0,0,0,,Идея жай ғана математикалық болжам.
Dialogue: 0,0:19:10.81,0:19:13.81,Default,,0,0,0,,Бұнда қандай мәселе бар?
Dialogue: 0,0:19:14.73,0:19:19.70,Default,,0,0,0,,Жер кездейсоқ қозғалса да.
Dialogue: 0,0:19:19.78,0:19:22.95,Default,,0,0,0,,Осы алғышартпен Киелі кітапты қайта оқыңыз
Dialogue: 0,0:19:23.03,0:19:26.87,Default,,0,0,0,,Біздің рөліміз – оны қайта түсіндіруге тырысу.
Dialogue: 0,0:19:28.54,0:19:32.12,Default,,0,0,0,,Жаңа пікірлер мен жаңалықтарды жоққа шығарудың орнына
Dialogue: 0,0:19:32.21,0:19:36.04,Default,,0,0,0,,Киелі кітапты тереңірек түсініп, ойлан
Dialogue: 0,0:19:36.13,0:19:41.05,Default,,0,0,0,,Дәл қазір иман үшін ең қажет нәрсе осы емес пе?
Dialogue: 0,0:19:41.68,0:19:43.14,Default,,0,0,0,,Керісінше
Dialogue: 0,0:19:43.22,0:19:46.85,Default,,0,0,0,,Күн – центр деген гелиоцентрлік идея
Dialogue: 0,0:19:46.93,0:19:50.98,Default,,0,0,0,,Үшбірлікті натуралистік қолдау ретінде де қарастыруға болады.
Dialogue: 0,0:19:51.48,0:19:53.23,Default,,0,0,0,,Бұл теологиялық тұрғыдан да қолданылады.
Dialogue: 0,0:19:53.31,0:19:56.65,Default,,0,0,0,,Құдайды мадақтаңыз Бұл керемет іске асуы мүмкін.
Dialogue: 0,0:19:57.73,0:20:00.28,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:20:00.78,0:20:03.95,Default,,0,0,0,,Сонда әкең...
Dialogue: 0,0:20:04.78,0:20:09.58,Default,,0,0,0,,Әй, менің әкем космологияға қатал еді.
Dialogue: 0,0:20:09.66,0:20:11.29,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:20:11.79,0:20:14.21,Default,,0,0,0,,Бірақ сіз мұны білесіз
Dialogue: 0,0:20:14.29,0:20:18.50,Default,,0,0,0,,Ол кезінде астрономиямен де айналысқанға ұқсайды.
Dialogue: 0,0:20:19.92,0:20:23.22,Default,,0,0,0,,Қандай да бір сәтсіздікке ұшырасаңыз,
Dialogue: 0,0:20:23.30,0:20:28.31,Default,,0,0,0,,Менің аспанға деген сүйсінуім төмендік сезіміне айналған шығар.
Dialogue: 0,0:20:29.01,0:20:33.85,Default,,0,0,0,,Қалай болғанда да, мен осылай аяқталады деп ойлаймын.
Dialogue: 0,0:20:35.23,0:20:39.73,Default,,0,0,0,,Бір кездері билік басында космологияға ерекше қатал адам болыпты.
Dialogue: 0,0:20:39.82,0:20:44.74,Default,,0,0,0,,Өкінішке орай, оның юрисдикциясы шегінде гелиоцентрлік теорияны оқығандар
Dialogue: 0,0:20:44.82,0:20:46.95,Default,,0,0,0,,Еретик деп аталды
Dialogue: 0,0:20:48.33,0:20:53.66,Default,,0,0,0,,Адамдар гелиоцентризм тыйым салынған деген әңгімеге сенді.
Dialogue: 0,0:20:55.08,0:20:57.83,Default,,0,0,0,,Ал лас жұмыс
Dialogue: 0,0:20:57.92,0:21:01.34,Default,,0,0,0,,Діни бұйрықтан шыққан кәдімгі инквизитор емес.
Dialogue: 0,0:21:02.05,0:21:07.59,Default,,0,0,0,,Бөтен адамға, бұрынғы жалдамалыға сеніп тапсырылған.
Dialogue: 0,0:21:09.35,0:21:12.35,Default,,0,0,0,,Егер солай болса, онда бұл дүрбелең болар еді
Dialogue: 0,0:21:12.43,0:21:16.35,Default,,0,0,0,,Қасиетті соғыс емес, шіркеу мен халықтың сенімін қорғау
Dialogue: 0,0:21:16.44,0:21:18.86,Default,,0,0,0,,Кейбір адамдардан туындаған
Dialogue: 0,0:21:18.94,0:21:22.23,Default,,0,0,0,,Бұл жай ғана «түсінбеушілік» болды.
Dialogue: 0,0:21:23.44,0:21:27.07,Default,,0,0,0,,А... түсінбеушілік...
Dialogue: 0,0:21:27.16,0:21:31.33,Default,,0,0,0,,Түсініспеушіліктен құтылу мүмкін бе?
Dialogue: 0,0:21:33.04,0:21:36.29,Default,,0,0,0,,Хуберт Раффау Окзи Бадени
Dialogue: 0,0:21:36.37,0:21:39.13,Default,,0,0,0,,Бұл гелиоцентрлік теория бойынша өлім жазасына кесілген адамның аты.
Dialogue: 0,0:21:39.21,0:21:41.46,Default,,0,0,0,,Мен оны өлтірдім!
Dialogue: 0,0:21:42.38,0:21:44.51,Default,,0,0,0,,Сонымен... және...
Dialogue: 0,0:21:45.92,0:21:48.72,Default,,0,0,0,,Менің қызым да
Dialogue: 0,0:21:51.30,0:21:53.56,Default,,0,0,0,,Иә, жазбалар, олардың жазбалары...
Dialogue: 0,0:21:53.64,0:21:56.81,Default,,0,0,0,,Барлық орындаулар жеке болып табылады.
Dialogue: 0,0:21:57.94,0:22:01.15,Default,,0,0,0,,Мұның бәрі 25 жыл бұрын болған.
Dialogue: 0,0:22:01.23,0:22:03.94,Default,,0,0,0,,Жазбалардың қалғанына күмәнім бар.
Dialogue: 0,0:22:04.03,0:22:06.36,Default,,0,0,0,,Өткенге қарасам, біртүрлі болды.
Dialogue: 0,0:22:06.45,0:22:10.87,Default,,0,0,0,,Космологияға қатысты бизнесіңізде жеке өлім жазасына кесілгендер тым көп болды.
Dialogue: 0,0:22:11.45,0:22:13.99,Default,,0,0,0,,Мен абайлап отырмын.
Dialogue: 0,0:22:14.08,0:22:18.37,Default,,0,0,0,,Мен жай ғана сіз туралы жазбалар бар-жоғын білуді сұрадым.
Dialogue: 0,0:22:18.46,0:22:21.38,Default,,0,0,0,,Маған оны тапқан бойда жоюды тапсырды.
Dialogue: 0,0:22:21.96,0:22:25.13,Default,,0,0,0,,Ертең таңертең бәрі жойылады
Dialogue: 0,0:22:25.88,0:22:27.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:33.76,0:22:35.39,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:22:35.97,0:22:39.35,Default,,0,0,0,,Мен шынымен жалғызбын ба?
Dialogue: 0,0:22:39.85,0:22:43.02,Default,,0,0,0,,Гелиоцентрлік қудалауды кім жүргізді?
Dialogue: 0,0:22:44.48,0:22:47.36,Default,,0,0,0,,Бұл дүниеде жалғыз мен бе?
Dialogue: 0,0:22:47.86,0:22:51.03,Default,,0,0,0,,А, менің білуімше
Dialogue: 0,0:22:51.11,0:22:55.24,Default,,0,0,0,,тым кеш... тым кеш...
Dialogue: 0,0:22:57.95,0:23:00.42,Default,,0,0,0,,Егер басқа жерде туылған болса
Dialogue: 0,0:23:00.50,0:23:03.29,Default,,0,0,0,,Егер мен басқа заманда туған болсам
Dialogue: 0,0:23:03.92,0:23:06.67,Default,,0,0,0,,Әртүрлі мүмкіндіктер болды.
Dialogue: 0,0:23:07.38,0:23:09.55,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:23:10.59,0:23:13.10,Default,,0,0,0,,Тағдыр деген осы.
Dialogue: 0,0:23:14.39,0:23:18.31,Default,,0,0,0,,Мен сені аяймын, бірақ оны қабылдаудан басқа амалым жоқ сияқты.
Dialogue: 0,0:23:18.39,0:23:22.40,Default,,0,0,0,,Сіз және сіз басқарған бидғатшылар.
Dialogue: 0,0:23:24.86,0:23:28.69,Default,,0,0,0,,Сіз тарихи кейіпкер емессіз.
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.07,0:24:59.08,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.58,0:25:06.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory