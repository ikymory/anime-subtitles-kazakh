Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.46,0:00:05.75,Default,,0,0,0,,Мұны келесі орынға апарыңыз
Dialogue: 0,0:00:10.71,0:00:12.92,Default,,0,0,0,,Дурака мырзадан естідім—
Dialogue: 0,0:00:13.01,0:00:17.51,Default,,0,0,0,,Қолжазбалары, түрі, аталық түрі, аналық түрі, қалып
Dialogue: 0,0:00:18.10,0:00:21.39,Default,,0,0,0,,Егер сізде бұл болса, тіпті түрі бұзылса да, оны сол жерде жасауға болады.
Dialogue: 0,0:00:22.52,0:00:24.27,Default,,0,0,0,,Кітаптың мазмұны туралы не ойладың?
Dialogue: 0,0:00:24.94,0:00:26.40,Default,,0,0,0,,Оның өтірігі ше?
Dialogue: 0,0:00:27.94,0:00:29.90,Default,,0,0,0,,Жоқ, мен сенемін.
Dialogue: 0,0:00:29.98,0:00:34.49,Default,,0,0,0,,Сонда ол қыз өз рөлін орындап үлгерді ме?
Dialogue: 0,0:00:35.78,0:00:36.66,Default,,0,0,0,,Оны жойғыңыз келе ме?
Dialogue: 0,0:00:36.74,0:00:37.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:40.08,0:00:41.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:42.41,0:00:46.96,Default,,0,0,0,,Мен бұл туралы ойладым, бірақ мен сізге баспахананы қарызға беруге уәде бердім.
Dialogue: 0,0:00:48.04,0:00:49.88,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:49.96,0:00:53.09,Default,,0,0,0,,Ол мен жаңа танысқан, оның кім екенін білмейтін қыз.
Dialogue: 0,0:00:56.13,0:00:59.55,Default,,0,0,0,,Мен мұндай адамға мүмкіндік бергім келеді.
Dialogue: 0,0:01:01.81,0:01:03.48,Default,,0,0,0,,Адамдарға сізбен ынтымақтасу қиын болады.
Dialogue: 0,0:01:09.06,0:01:10.86,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:01:11.78,0:01:14.57,Default,,0,0,0,,Ал ұйымның болашағы
Dialogue: 0,0:01:15.78,0:01:16.99,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:01:18.11,0:01:20.66,Default,,0,0,0,,Мұның бәрі мен үшін
Dialogue: 0,0:01:21.83,0:01:25.21,Default,,0,0,0,,Сіз бұл кітап үшін шынымен де ұзаққа барасыз ба?
Dialogue: 0,0:01:26.29,0:01:27.21,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.00,0:01:30.29,Default,,0,0,0,,Бұл кітап... жоқ
Dialogue: 0,0:01:30.38,0:01:33.05,Default,,0,0,0,,Осындай нәрсені жариялауға не мүмкіндік береді?
Dialogue: 0,0:01:34.76,0:01:36.59,Default,,0,0,0,,Өйткені бұл менің арманым
Dialogue: 0,0:01:39.39,0:01:44.14,Default,,0,0,0,,♪~
Dialogue: 0,0:03:03.51,0:03:07.89,Default,,0,0,0,,~♪
Dialogue: 0,0:03:10.56,0:03:11.39,Default,,0,0,0,,Новак мырза!
Dialogue: 0,0:03:13.23,0:03:14.15,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:03:14.77,0:03:17.28,Default,,0,0,0,,Мен бірнеше ай бұрын шеберлерден сұрадым.
Dialogue: 0,0:03:17.36,0:03:19.49,Default,,0,0,0,,Күдікті әрекет ететін қора туралы мәлімет...
Dialogue: 0,0:03:19.57,0:03:21.40,Default,,0,0,0,,Әскерлерді жинаңыз
Dialogue: 0,0:03:23.91,0:03:25.87,Default,,0,0,0,,Орнымызға келейік
Dialogue: 0,0:03:27.24,0:03:28.75,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:34.88,0:03:36.13,Default,,0,0,0,,О
Dialogue: 0,0:03:38.63,0:03:39.51,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:03:39.59,0:03:41.05,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:03:41.13,0:03:43.68,Default,,0,0,0,,Шыбын қалада сатып алынды.
Dialogue: 0,0:03:43.76,0:03:45.76,Default,,0,0,0,,Дәмін татып жеу
Dialogue: 0,0:03:45.85,0:03:47.26,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:03:59.86,0:04:01.53,Default,,0,0,0,,-Мм... -(Левандровски) Иә?
Dialogue: 0,0:04:02.28,0:04:06.37,Default,,0,0,0,,Неліктен сен өз өміріңді және жәннатты лақтырып тастайсың?
Dialogue: 0,0:04:06.45,0:04:08.49,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:04:13.08,0:04:14.75,Default,,0,0,0,,Өлім
Dialogue: 0,0:04:14.83,0:04:17.17,Default,,0,0,0,,Өлімді қабылдау
Dialogue: 0,0:04:17.25,0:04:18.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:20.13,0:04:22.92,Default,,0,0,0,,Менің қарындасым бар еді.
Dialogue: 0,0:04:23.68,0:04:26.34,Default,,0,0,0,,Мен 10 жасымда ауырдым.
Dialogue: 0,0:04:27.39,0:04:30.31,Default,,0,0,0,,Бұл өте кең таралған оқиға.
Dialogue: 0,0:04:33.14,0:04:36.65,Default,,0,0,0,,Өлер алдында әлгі жігіт бір сөз айтты.
Dialogue: 0,0:04:36.73,0:04:41.86,Default,,0,0,0,,Ақырғы сұрақты өте қысқа және үнсіз қойды.
Dialogue: 0,0:04:43.32,0:04:46.86,Default,,0,0,0,,«Мен не үшін дүниеге келдім?»
Dialogue: 0,0:04:48.12,0:04:50.08,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:04:50.16,0:04:53.79,Default,,0,0,0,,Құдай үшін, жәннатқа бару үшін.
Dialogue: 0,0:04:54.29,0:04:58.04,Default,,0,0,0,,Адамдар өледі, сонда олар не үшін дүниеге келді?
Dialogue: 0,0:04:58.13,0:05:01.71,Default,,0,0,0,,Бұл сұраққа жауап беру үшін құдайлар мен діндер бар.
Dialogue: 0,0:05:02.71,0:05:05.09,Default,,0,0,0,,Бірақ мен айта алмадым
Dialogue: 0,0:05:05.17,0:05:09.39,Default,,0,0,0,,Ал мен ештеңе айта алмай жатып, апам қайтыс болды.
Dialogue: 0,0:05:09.47,0:05:10.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.10,0:05:16.35,Default,,0,0,0,,Сол күннен бастап мен мұны Құдай үшін жасадым деп мақтанышпен айта аламын.
Dialogue: 0,0:05:16.44,0:05:19.15,Default,,0,0,0,,Мен не істеу керектігін ойладым.
Dialogue: 0,0:05:20.11,0:05:23.23,Default,,0,0,0,,Соның нәтижесінде мен қазір мұны істеп жатырмын.
Dialogue: 0,0:05:23.32,0:05:24.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.07,0:05:29.20,Default,,0,0,0,,Ең болмаса бидғатты қудалайтын Құдай емес.
Dialogue: 0,0:05:29.28,0:05:30.78,Default,,0,0,0,,Адамдар
Dialogue: 0,0:05:30.87,0:05:34.29,Default,,0,0,0,,Ешкім талап етпесе, мен айтамын.
Dialogue: 0,0:05:35.16,0:05:39.63,Default,,0,0,0,,Олай етпесем, Алла разылығы үшін деп апама айта алмаймын.
Dialogue: 0,0:05:42.25,0:05:46.09,Default,,0,0,0,,Капитанға айтпа, бірақ дін маңызды.
Dialogue: 0,0:05:47.30,0:05:51.89,Default,,0,0,0,,Дінсіз адамдар мұндай күшті болмас еді.
Dialogue: 0,0:05:53.93,0:05:58.85,Default,,0,0,0,,Алыс жерде бір Құдайға сенетін адамдар бар.
Dialogue: 0,0:05:59.48,0:06:02.57,Default,,0,0,0,,Осының өзі қаншалықты сенімді?
Dialogue: 0,0:06:04.15,0:06:07.07,Default,,0,0,0,,Бірақ шіркеу құрылғаннан бері
Dialogue: 0,0:06:07.15,0:06:09.78,Default,,0,0,0,,Көп уақыт өтті
Dialogue: 0,0:06:09.86,0:06:13.03,Default,,0,0,0,,Егер бұл орын алса, уақыт өте келе нашарлауды болдырмау мүмкін емес.
Dialogue: 0,0:06:14.16,0:06:17.00,Default,,0,0,0,,Көп заттар енді бір-біріне сәйкес келмейді
Dialogue: 0,0:06:17.08,0:06:20.29,Default,,0,0,0,,Уақыт мұнда-мұнда сықырлап жатыр.
Dialogue: 0,0:06:20.37,0:06:24.17,Default,,0,0,0,,Біз өзгеру кезеңіне куә болып отырмыз.
Dialogue: 0,0:06:24.67,0:06:27.88,Default,,0,0,0,,Сондықтан мен өз миссиямды іздеймін
Dialogue: 0,0:06:27.97,0:06:30.05,Default,,0,0,0,,Мен оны іс жүзінде қолдануға тырысамын.
Dialogue: 0,0:06:31.09,0:06:35.81,Default,,0,0,0,,Мен осы жолды жалғастырсам, апамның өлімін қабылдай алатыныма сенемін.
Dialogue: 0,0:06:35.89,0:06:39.23,Default,,0,0,0,,Мен өлімнен аулақ болғым келмейді, мен оны растағым келеді.
Dialogue: 0,0:06:40.69,0:06:44.52,Default,,0,0,0,,Бұл менің өмірлік миссиям.
Dialogue: 0,0:06:46.98,0:06:49.36,Default,,0,0,0,,Иә? жай ғана дұрыс жерде
Dialogue: 0,0:06:49.45,0:06:50.28,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.62,0:07:00.83,Default,,0,0,0,,Бірақ олар мұндай құрылғыны пайдаланады.
Dialogue: 0,0:07:01.54,0:07:03.84,Default,,0,0,0,,Сізге мұндай технология ұнамайды, солай ма?
Dialogue: 0,0:07:03.92,0:07:05.13,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:05.21,0:07:08.71,Default,,0,0,0,,Біз технологияны технологияны жеңу үшін қолданамыз.
Dialogue: 0,0:07:09.80,0:07:13.97,Default,,0,0,0,,Жасанды заттарды неге сонша жек көресің?
Dialogue: 0,0:07:15.01,0:07:16.47,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:07:17.18,0:07:21.64,Default,,0,0,0,,Менің туған жерімде Құдайды әртүрлі түсінгендіктен адамдар бір-бірін өлтірді.
Dialogue: 0,0:07:21.73,0:07:23.23,Default,,0,0,0,,Отбасы өлтірілді
Dialogue: 0,0:07:25.82,0:07:29.19,Default,,0,0,0,,Мұндай жағдайлар барлық жерде болады.
Dialogue: 0,0:07:29.28,0:07:31.82,Default,,0,0,0,,Бұл қалыпты емес сияқты.
Dialogue: 0,0:07:31.90,0:07:35.74,Default,,0,0,0,,Мәселенің себебі Түпкі себепті жоюдан басқа амалымыз жоқ
Dialogue: 0,0:07:36.49,0:07:40.50,Default,,0,0,0,,Бұлардың барлығы техногендік апаттар.
Dialogue: 0,0:07:40.58,0:07:45.00,Default,,0,0,0,,Халық қоныстанған қоғам, жасанды ережелер, жасанды құдайлар
Dialogue: 0,0:07:50.09,0:07:54.34,Default,,0,0,0,,Адам жасаған нәрселерге тек ұсқынсыз еліктеуіштер ғана бар.
Dialogue: 0,0:07:55.14,0:07:58.01,Default,,0,0,0,,Мына ғажайып табиғатқа қарасаңыз, түсінесіз.
Dialogue: 0,0:08:00.14,0:08:01.56,Default,,0,0,0,,Мен сәйкестендіруім керек
Dialogue: 0,0:08:05.98,0:08:08.65,Default,,0,0,0,,Адамдар нөлден ештеңе жасай алмайды.
Dialogue: 0,0:08:08.73,0:08:12.95,Default,,0,0,0,,Сонымен қатар, адамдар табиғаттың күшін алу арқылы не жасайды
Dialogue: 0,0:08:13.03,0:08:16.03,Default,,0,0,0,,Ишиуми мылтығы арбасы
Dialogue: 0,0:08:16.12,0:08:18.16,Default,,0,0,0,,Бұлардың бәрі шіркін қару
Dialogue: 0,0:08:18.74,0:08:19.99,Default,,0,0,0,,Платон дейді
Dialogue: 0,0:08:20.08,0:08:23.33,Default,,0,0,0,,«Адамдар жасаған еліктеу ойын сияқты».
Dialogue: 0,0:08:23.41,0:08:26.42,Default,,0,0,0,,«Бұл шындап айналысу туралы емес».
Dialogue: 0,0:08:26.50,0:08:29.71,Default,,0,0,0,,Алланың жаратылысы ғана шынайы
Dialogue: 0,0:08:30.76,0:08:32.38,Default,,0,0,0,,Адамдар көтеріледі
Dialogue: 0,0:08:32.47,0:08:36.55,Default,,0,0,0,,Адамдарды табиғатты түсінеді деп адастыратын әдістердің қажеті жоқ.
Dialogue: 0,0:08:38.64,0:08:43.43,Default,,0,0,0,,Тағы да айтамын, мен адам интеллектіне сенбеймін.
Dialogue: 0,0:08:45.56,0:08:47.19,Default,,0,0,0,,Хмм, бұл жақсы.
Dialogue: 0,0:08:47.98,0:08:50.15,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:08:50.23,0:08:52.61,Default,,0,0,0,,көремін. Содан кейін
Dialogue: 0,0:08:58.24,0:08:59.45,Default,,0,0,0,,Ойлан
Dialogue: 0,0:09:00.08,0:09:02.66,Default,,0,0,0,,Интеллект процесте орналасады
Dialogue: 0,0:09:06.75,0:09:08.75,Default,,0,0,0,,Аристотель де...
Dialogue: 0,0:09:08.83,0:09:09.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:09.88,0:09:11.80,Default,,0,0,0,,Аристотель де
Dialogue: 0,0:09:11.88,0:09:15.05,Default,,0,0,0,,«Технология табиғатқа еліктейді» дейді
Dialogue: 0,0:09:15.80,0:09:18.43,Default,,0,0,0,,Бірақ екінші жағынан, ол былай дейді:
Dialogue: 0,0:09:19.10,0:09:23.31,Default,,0,0,0,,«Технология табиғат жасай алмайтын нәрселерді жасайды».
Dialogue: 0,0:09:28.40,0:09:33.82,Default,,0,0,0,,Мына шүберек пен қанды ақша әкемнің естелігі.
Dialogue: 0,0:09:34.82,0:09:38.11,Default,,0,0,0,,Бұл менің сенімдерімді еске түсіреді
Dialogue: 0,0:09:38.20,0:09:39.82,Default,,0,0,0,,Әкемді еске алу
Dialogue: 0,0:09:40.49,0:09:43.79,Default,,0,0,0,,Бұл екі нәрсе табиғи түрде өскен жоқ.
Dialogue: 0,0:09:43.87,0:09:46.33,Default,,0,0,0,,Адамның жасанды түрде жасағаны
Dialogue: 0,0:09:46.96,0:09:49.13,Default,,0,0,0,,Бұл оның түкке тұрғысыз екенін білдірмейді.
Dialogue: 0,0:09:49.21,0:09:51.50,Default,,0,0,0,,Адамдар жасаған еліктеушілік кейде болады
Dialogue: 0,0:09:51.59,0:09:54.38,Default,,0,0,0,,Табиғат орындай алмағанды біз орындаймыз.
Dialogue: 0,0:09:57.72,0:09:58.88,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:09.48,0:10:12.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:14.32,0:10:16.19,Default,,0,0,0,,Астрономиялық бақылау?
Dialogue: 0,0:10:16.28,0:10:18.11,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:10:19.07,0:10:23.20,Default,,0,0,0,,Мен нақты уақытты білмеймін, сондықтан бұл пайдасыз жазба.
Dialogue: 0,0:10:23.70,0:10:25.12,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:25.20,0:10:29.79,Default,,0,0,0,,Біз кететін сияқтымыз, сондықтан қоштасқым келеді.
Dialogue: 0,0:10:29.87,0:10:33.84,Default,,0,0,0,,Сіз өте сыпайысыз. Сізде қандай да бір жасырын ниет бар ма?
Dialogue: 0,0:10:33.92,0:10:38.59,Default,,0,0,0,,Жоқ... жоқ, мен онша ашулы емеспін.
Dialogue: 0,0:10:38.67,0:10:43.39,Default,,0,0,0,,Әй, бірақ мен айту керек болса, бұл сорғыш жақсы деп ойлаймын.
Dialogue: 0,0:10:43.47,0:10:44.97,Default,,0,0,0,,Иә? Жарайды, мен саған беремін.
Dialogue: 0,0:10:45.06,0:10:45.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.97,0:10:48.48,Default,,0,0,0,,Мен оны енді қолданбаймын.
Dialogue: 0,0:10:48.56,0:10:49.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.48,0:10:53.27,Default,,0,0,0,,Мен сізге бергім келетін тағы бір нәрсе бар.
Dialogue: 0,0:10:55.32,0:10:58.11,Default,,0,0,0,,Иә? бөтелке?
Dialogue: 0,0:10:58.19,0:10:59.45,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:10:59.53,0:11:01.28,Default,,0,0,0,,Ішінде хат бар.
Dialogue: 0,0:11:02.03,0:11:06.41,Default,,0,0,0,,Бұл кітап басылып, таратылғаннан кейін, оны маған пошта арқылы жіберуіңізді сұраймын.
Dialogue: 0,0:11:07.50,0:11:09.41,Default,,0,0,0,,Хат… Мазмұны қандай?
Dialogue: 0,0:11:10.54,0:11:12.42,Default,,0,0,0,,Ата-бабаларды еске алу
Dialogue: 0,0:11:12.50,0:11:13.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.79,0:11:17.42,Default,,0,0,0,,Бұл сіз айтқан кітапта жазылған, солай ма?
Dialogue: 0,0:11:17.51,0:11:20.67,Default,,0,0,0,,«Мен сізге осы кітаптан түскен пайданың бір бөлігін беремін»
Dialogue: 0,0:11:21.30,0:11:24.60,Default,,0,0,0,,Қазіргі уақытта пайда табу жоспары жоқ.
Dialogue: 0,0:11:24.68,0:11:26.68,Default,,0,0,0,,Бірақ неге мен?
Dialogue: 0,0:11:26.76,0:11:29.56,Default,,0,0,0,,Иә? Бұл қиын болды ма?
Dialogue: 0,0:11:29.64,0:11:31.94,Default,,0,0,0,,Өйткені сен мен үшін маңызды нәрсені өртеп жібердің.
Dialogue: 0,0:11:32.02,0:11:34.31,Default,,0,0,0,,Осыншама көп сұраған дұрыс емес пе?
Dialogue: 0,0:11:34.40,0:11:36.27,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:11:38.07,0:11:40.40,Default,,0,0,0,,Маған сене аласыз ба?
Dialogue: 0,0:11:41.74,0:11:46.91,Default,,0,0,0,,Мен үшін сенің өткенің де, тарихың да маңызды емес.
Dialogue: 0,0:11:46.99,0:11:49.54,Default,,0,0,0,,Шмидт мырзадан және басқалардан неге сұрамайсыз?
Dialogue: 0,0:11:49.62,0:11:53.04,Default,,0,0,0,,Жақында тағы да осындай нәрсені өртеп жіберуім мүмкін.
Dialogue: 0,0:11:53.12,0:11:54.54,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:11:55.54,0:11:57.13,Default,,0,0,0,,Өйткені сен жассың
Dialogue: 0,0:11:57.21,0:11:58.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:58.13,0:12:01.01,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:12:01.09,0:12:04.39,Default,,0,0,0,,Өйткені қазір сендер тарихтың кейіпкерлерісіңдер.
Dialogue: 0,0:12:04.89,0:12:06.85,Default,,0,0,0,,Сондықтан мен оны саған тапсырамын
Dialogue: 0,0:12:07.35,0:12:08.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.64,0:12:11.27,Default,,0,0,0,,Олай болса, мені бұл жағдайға қоспай аласыз ба?
Dialogue: 0,0:12:11.35,0:12:13.31,Default,,0,0,0,,Менің бұл тарихқа қатысым жоқ...
Dialogue: 0,0:12:13.39,0:12:15.02,Default,,0,0,0,,Қатысты
Dialogue: 0,0:12:16.23,0:12:19.53,Default,,0,0,0,,Адамдар өзінен бұрынғылардың ашқан жаңалықтарын мұра етеді
Dialogue: 0,0:12:19.61,0:12:22.82,Default,,0,0,0,,Және кенеттен, табиғи түрде
Dialogue: 0,0:12:23.32,0:12:27.78,Default,,0,0,0,,Демек, қазіргі кезде өмір сүретіндерге өткеннің барлығы кіреді.
Dialogue: 0,0:12:27.87,0:12:31.20,Default,,0,0,0,,Неліктен адамдар есте сақтау қабілетіне мән береді?
Dialogue: 0,0:12:31.29,0:12:35.75,Default,,0,0,0,,Неліктен адамдар жеке оқиғаларды хронологиялық ретпен қабылдайды?
Dialogue: 0,0:12:36.25,0:12:39.17,Default,,0,0,0,,Адамдар тарихты не үшін ашады?
Dialogue: 0,0:12:39.25,0:12:42.72,Default,,0,0,0,,Сізде мәжбүрлеп тану құрылымы бар ма?
Dialogue: 0,0:12:43.59,0:12:48.80,Default,,0,0,0,,Құдайдың адамдарға үйреткені деп ойлаймын.
Dialogue: 0,0:12:48.89,0:12:52.77,Default,,0,0,0,,Басқаша айтқанда, тарих Құдайдың еркіне негізделген.
Dialogue: 0,0:12:53.35,0:12:54.77,Default,,0,0,0,,Құдайдың еркі?
Dialogue: 0,0:12:54.85,0:12:57.56,Default,,0,0,0,,Не? Бұл ерік
Dialogue: 0,0:12:57.65,0:12:59.48,Default,,0,0,0,,Киелі кітапта жазылған
Dialogue: 0,0:13:00.69,0:13:04.49,Default,,0,0,0,,«Құдай бұл дүниедегі жамандықты жақсылыққа айналдырады»
Dialogue: 0,0:13:04.57,0:13:06.86,Default,,0,0,0,,Бұл Құдайдың қалауы
Dialogue: 0,0:13:06.95,0:13:10.87,Default,,0,0,0,,Құдай адамдар арқылы әлемді өзгертуге тырысады
Dialogue: 0,0:13:10.95,0:13:13.79,Default,,0,0,0,,Ұзақ уақыт ішінде аз-аздан
Dialogue: 0,0:13:13.87,0:13:17.75,Default,,0,0,0,,Бұл «қазір» сол үлкен ағында.
Dialogue: 0,0:13:17.83,0:13:21.75,Default,,0,0,0,,Туылу деген нені білдіреді?
Dialogue: 0,0:13:21.84,0:13:25.13,Default,,0,0,0,,Сол жоспарға, сол сынақ пен қателікке
Dialogue: 0,0:13:25.22,0:13:27.97,Default,,0,0,0,,Жақсылыққа баяу және шексіз бетбұрыс.
Dialogue: 0,0:13:28.05,0:13:30.26,Default,,0,0,0,,Менің ойымша, бұл қатысу туралы.
Dialogue: 0,0:13:31.10,0:13:35.18,Default,,0,0,0,,Жамандыққа лақтырмай жұтып, қарсы тұру арқылы
Dialogue: 0,0:13:35.27,0:13:38.10,Default,,0,0,0,,Кейде одан да үлкен жақсылық пайда болады
Dialogue: 0,0:13:38.60,0:13:42.53,Default,,0,0,0,,Екі жол жоқ, жамандық пен жақсылық.
Dialogue: 0,0:13:42.61,0:13:46.20,Default,,0,0,0,,Барлығы бір сызыққа қосылған
Dialogue: 0,0:13:46.28,0:13:47.70,Default,,0,0,0,,Егер сіз солай ойласаңыз
Dialogue: 0,0:13:47.78,0:13:51.53,Default,,0,0,0,,Өткен күндердің қайғылы күндері де мағынасыз емес.
Dialogue: 0,0:13:52.20,0:13:55.91,Default,,0,0,0,,Бірақ тарихты бөліп алсақ, енді оны көре алмаймыз.
Dialogue: 0,0:13:56.00,0:13:57.87,Default,,0,0,0,,Адам өлсе, бітті.
Dialogue: 0,0:13:57.96,0:14:00.54,Default,,0,0,0,,Шектілік уайымынан қорқу
Dialogue: 0,0:14:01.13,0:14:03.05,Default,,0,0,0,,Тарихты тексеру
Dialogue: 0,0:14:03.13,0:14:07.05,Default,,0,0,0,,Құдайдың бізді жетелеуге тырысып жатқан бағытын растауға тең.
Dialogue: 0,0:14:07.13,0:14:11.05,Default,,0,0,0,,Сондықтан өткенді елемейтін болсаңыз, адасып кетесіз.
Dialogue: 0,0:14:12.64,0:14:14.56,Default,,0,0,0,,Тым дерексіз
Dialogue: 0,0:14:15.14,0:14:17.18,Default,,0,0,0,,Менде нақты мәселе бар
Dialogue: 0,0:14:17.27,0:14:18.19,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:14:18.27,0:14:21.94,Default,,0,0,0,,Өйткені тарихи хабардарлық менің шешімдеріммен байланысты.
Dialogue: 0,0:14:23.65,0:14:25.03,Default,,0,0,0,,Мысалы—
Dialogue: 0,0:14:25.53,0:14:27.95,Default,,0,0,0,,Менің әкем инквизитор болған
Dialogue: 0,0:14:28.03,0:14:28.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:29.03,0:14:32.99,Default,,0,0,0,,Мен әкемнен мүлде басқа жолмен жүрдім.
Dialogue: 0,0:14:33.08,0:14:36.25,Default,,0,0,0,,Мен әкемнің қазір не істеп жатқанын білмеймін.
Dialogue: 0,0:14:36.33,0:14:39.46,Default,,0,0,0,,Сен тірісің бе, жоқ па?
Dialogue: 0,0:14:40.75,0:14:43.84,Default,,0,0,0,,Біз енді ешқашан кездеспейміз деп ойлаймын
Dialogue: 0,0:14:43.92,0:14:45.96,Default,,0,0,0,,кейде елестетеді
Dialogue: 0,0:14:46.05,0:14:49.72,Default,,0,0,0,,Егер мен қазір әкеммен бетпе-бет келсем,
Dialogue: 0,0:14:49.80,0:14:52.97,Default,,0,0,0,,Менің жолым бөгелсе не болар еді?
Dialogue: 0,0:14:54.51,0:14:58.35,Default,,0,0,0,,Ойлап қарасам, бұл менің өмірімдегі ең жаман сәт болды.
Dialogue: 0,0:14:58.43,0:15:00.77,Default,,0,0,0,,Мен абдырап қалдым, байсалдылығымды жоғалттым.
Dialogue: 0,0:15:02.19,0:15:04.77,Default,,0,0,0,,Бірақ сонда ғана
Dialogue: 0,0:15:04.86,0:15:07.61,Default,,0,0,0,,Сіз дұрыс деп санайтын таңдауды жасауыңыз керек.
Dialogue: 0,0:15:08.32,0:15:13.62,Default,,0,0,0,,Менің біртүрлі өмірім сол сәттік таңдаудың арқасында бар екеніне сенімдімін.
Dialogue: 0,0:15:13.70,0:15:18.66,Default,,0,0,0,,Жинаған тарихым менің күйзелісімді басады.
Dialogue: 0,0:15:18.75,0:15:20.66,Default,,0,0,0,,Қорқақтықты жеңу
Dialogue: 0,0:15:20.75,0:15:22.50,Default,,0,0,0,,Өз ойларыңызды қозғаңыз
Dialogue: 0,0:15:23.96,0:15:26.25,Default,,0,0,0,,Уақыты келгенде, мен сені қайтармаймын
Dialogue: 0,0:15:30.17,0:15:33.01,Default,,0,0,0,,Барлық тарих мені кері итермелейді
Dialogue: 0,0:15:36.10,0:15:37.10,Default,,0,0,0,,Неге...
Dialogue: 0,0:15:37.18,0:15:38.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:38.10,0:15:42.14,Default,,0,0,0,,Неліктен дәл осы кітапқа қатысты барлық ой-пікірлерден өттіңіз?
Dialogue: 0,0:15:42.85,0:15:43.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.94,0:15:45.02,Default,,0,0,0,,Иә
Dialogue: 0,0:15:45.61,0:15:48.32,Default,,0,0,0,,Мен гелиоцентрлік теорияны жақсы көремін
Dialogue: 0,0:15:50.11,0:15:54.87,Default,,0,0,0,,Ал мен сені сүйгенің үшін бата бергім келеді.
Dialogue: 0,0:15:55.87,0:15:57.66,Default,,0,0,0,,Бұл балалық
Dialogue: 0,0:15:58.33,0:16:01.37,Default,,0,0,0,,Иә, сондықтан сіз оны жеңесіз.
Dialogue: 0,0:16:03.25,0:16:05.17,Default,,0,0,0,,-Ұйым басшысы! - (Джолента Дурака) Иә?
Dialogue: 0,0:16:07.84,0:16:09.92,Default,,0,0,0,,Осы бағытта екі вагон бар.
Dialogue: 0,0:16:10.84,0:16:11.67,Default,,0,0,0,,Рыцарлар
Dialogue: 0,0:16:13.01,0:16:13.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.01,0:16:17.30,Default,,0,0,0,,Қазірдің өзінде анықталған
Dialogue: 0,0:16:17.39,0:16:19.06,Default,,0,0,0,,Бұл мен ойлағаннан да жылдам.
Dialogue: 0,0:16:20.52,0:16:24.02,Default,,0,0,0,,Енді барлығыңыз артқы есіктен қашыңыз.
Dialogue: 0,0:16:24.10,0:16:26.94,Default,,0,0,0,,Арба орманның дәл сыртында тұр.
Dialogue: 0,0:16:27.02,0:16:31.11,Default,,0,0,0,,Егер сіз мұны жақсы орындасаңыз, сіз байқамай құтыла аласыз.
Dialogue: 0,0:16:31.19,0:16:33.20,Default,,0,0,0,,Барлығы межелі жерге бара жатыр
Dialogue: 0,0:16:34.24,0:16:37.32,Default,,0,0,0,,Мен осында қалып, оларды тартамын
Dialogue: 0,0:16:37.41,0:16:38.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.28,0:16:42.08,Default,,0,0,0,,Өйткені олардың мақсаты мен, ұйым жетекшісі.
Dialogue: 0,0:16:42.16,0:16:46.29,Default,,0,0,0,,Бірақ... Бірақ оны тартқаннан кейін ше?
Dialogue: 0,0:16:46.38,0:16:49.04,Default,,0,0,0,,Бұл сіз ойлағандай емес
Dialogue: 0,0:16:52.13,0:16:52.97,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:16:58.26,0:17:00.31,Default,,0,0,0,,Біз де қозғала бастаймыз
Dialogue: 0,0:17:08.65,0:17:09.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:16.78,0:17:18.03,Default,,0,0,0,,Я...
Dialogue: 0,0:17:40.35,0:17:44.31,Default,,0,0,0,,Мен міндетті түрде жаудан кек аламын.
Dialogue: 0,0:17:45.52,0:17:46.52,Default,,0,0,0,,Мен оны көріп тұрмын!
Dialogue: 0,0:17:49.94,0:17:50.90,Default,,0,0,0,,Мен әйелмін.
Dialogue: 0,0:17:50.98,0:17:52.90,Default,,0,0,0,,Бұл ұйым жетекшісі ме?
Dialogue: 0,0:18:01.41,0:18:04.04,Default,,0,0,0,,Біз инквизиторлармыз
Dialogue: 0,0:18:04.58,0:18:06.91,Default,,0,0,0,,Құдай атымен тергеу
Dialogue: 0,0:18:07.00,0:18:10.92,Default,,0,0,0,,Сіз еретиктерді азат ету майданының ұйымының жетекшісісіз бе?
Dialogue: 0,0:18:12.00,0:18:15.55,Default,,0,0,0,,Мен ұйым жетекшісімін.
Dialogue: 0,0:18:16.26,0:18:18.47,Default,,0,0,0,,Өзіңізді дайындаңыз!
Dialogue: 0,0:19:02.72,0:19:05.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:10.02,0:19:13.36,Default,,0,0,0,,
Dialogue: 0,0:19:14.69,0:19:17.86,Default,,0,0,0,,Не? Әлде... мылтық па?
Dialogue: 0,0:19:19.24,0:19:21.86,Default,,0,0,0,,Өзіңіз бе?
Dialogue: 0,0:19:28.79,0:19:32.12,Default,,0,0,0,,Жоқ... Новак мырза, бұл не...
Dialogue: 0,0:19:33.75,0:19:35.75,Default,,0,0,0,,Енді бір сәт...
Dialogue: 0,0:19:35.84,0:19:36.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.98,0:19:53.56,Default,,0,0,0,,Новак мырза, бұл...
Dialogue: 0,0:19:54.61,0:19:57.19,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:19:57.27,0:20:01.20,Default,,0,0,0,,Әрине, жаңа технологияны қолдану
Dialogue: 0,0:20:01.28,0:20:04.91,Default,,0,0,0,,Менің көз алдымда сұмдық оқиға болды.
Dialogue: 0,0:20:05.74,0:20:06.91,Default,,0,0,0,,Және—
Dialogue: 0,0:20:08.20,0:20:11.41,Default,,0,0,0,,Ұйым жетекшісі қайтыс болды.
Dialogue: 0,0:20:23.38,0:20:25.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:32.60,0:20:35.19,Default,,0,0,0,,Ах! Қорадан түтін шығып жатыр
Dialogue: 0,0:20:35.27,0:20:37.31,Default,,0,0,0,,Йолента, сізге шабуыл жасалды.
Dialogue: 0,0:20:38.32,0:20:40.44,Default,,0,0,0,,Жоқ, бұл өзін-өзі жою.
Dialogue: 0,0:20:40.53,0:20:42.95,Default,,0,0,0,,Джиба... иә?
Dialogue: 0,0:20:43.03,0:20:44.20,Default,,0,0,0,,Өзін-өзі жою?
Dialogue: 0,0:20:44.28,0:20:46.91,Default,,0,0,0,,Бұл да жоспардың бір бөлігі.
Dialogue: 0,0:20:46.99,0:20:51.58,Default,,0,0,0,,Біз баратын баспахананы қорғау үшін жанкешті бомбаны қақпақ ретінде пайдалану.
Dialogue: 0,0:20:53.00,0:20:56.63,Default,,0,0,0,,Жаудың мақсаты - Азаттық майданының басшысын талқандау.
Dialogue: 0,0:20:57.13,0:20:58.96,Default,,0,0,0,,Енді ол орындалды
Dialogue: 0,0:20:59.04,0:21:02.46,Default,,0,0,0,,Әзірге ешқандай ақпарат жарияланбайды, оның артынан қуу қиын болады.
Dialogue: 0,0:21:02.55,0:21:06.22,Default,,0,0,0,,Сонымен қатар, жанкешті бомбалар басып шығарылғаннан кейін таратылады.
Dialogue: 0,0:21:06.30,0:21:09.64,Default,,0,0,0,,Сондай-ақ реформаторлардан ынтымақтастық іздеу үшін маңызды
Dialogue: 0,0:21:10.14,0:21:14.94,Default,,0,0,0,,Оларға бидғатшылар ретінде қаралғанымен, олар әлі де адалдардың бөлігі болып табылады.
Dialogue: 0,0:21:15.02,0:21:18.36,Default,,0,0,0,,Біздікі сияқты ұйымдармен ешқандай байланысы болғысы келмейді.
Dialogue: 0,0:21:19.61,0:21:22.36,Default,,0,0,0,,Міне, ұйым жетекшісінің өлімі өмірге келеді.
Dialogue: 0,0:21:22.44,0:21:25.61,Default,,0,0,0,,Азаттық майданы қирады.
Dialogue: 0,0:21:26.41,0:21:29.66,Default,,0,0,0,,Бір-бірімен байланысы жоқ жаңа ұйым болып көріну арқылы біз
Dialogue: 0,0:21:29.74,0:21:32.37,Default,,0,0,0,,Реформашыларға қол жеткізу
Dialogue: 0,0:21:33.20,0:21:36.37,Default,,0,0,0,,Бұл жағдайда ұйым жай ғана таратылғандай көрінуі мүмкін ...
Dialogue: 0,0:21:36.46,0:21:39.84,Default,,0,0,0,,Күдік тудырмау үшін фактілер жақсы
Dialogue: 0,0:21:40.71,0:21:43.71,Default,,0,0,0,,Қалай болғанда да ұйым басшысы ойланды
Dialogue: 0,0:21:43.80,0:21:45.26,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:21:45.34,0:21:51.01,Default,,0,0,0,,Егер өзін-өзі жою сол кітаптың сәл болса да аман қалу мүмкіндігін арттырса.
Dialogue: 0,0:21:51.10,0:21:52.76,Default,,0,0,0,,Егер сіз оны таңдасаңыз
Dialogue: 0,0:21:52.85,0:21:54.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:56.18,0:21:58.44,Default,,0,0,0,,Сен оны тоқтатпадың ба?
Dialogue: 0,0:21:58.52,0:22:01.06,Default,,0,0,0,,Иә? Махаббат па?
Dialogue: 0,0:22:01.57,0:22:04.19,Default,,0,0,0,,Миссияны орындау үшін сентименталдылықтың қажеті жоқ.
Dialogue: 0,0:22:04.28,0:22:06.53,Default,,0,0,0,,Алып кетсең, шешіміңнен жаңылып қаласың.
Dialogue: 0,0:22:06.61,0:22:09.36,Default,,0,0,0,,Өлім біз үшін күнделікті нәрсе
Dialogue: 0,0:22:09.45,0:22:12.20,Default,,0,0,0,,Қай жерде өлетініңіз маңызды.
Dialogue: 0,0:22:12.70,0:22:15.79,Default,,0,0,0,,Оның шешімі – Құдайдың шешімі.
Dialogue: 0,0:22:16.62,0:22:19.54,Default,,0,0,0,,Сенімдерің үшін абыроймен өл.
Dialogue: 0,0:22:23.34,0:22:25.05,Default,,0,0,0,,Сенім…
Dialogue: 0,0:22:25.13,0:22:28.22,Default,,0,0,0,,Ойланып қарасам, сен де солай айттың ғой?
Dialogue: 0,0:22:28.30,0:22:32.43,Default,,0,0,0,,Сол тиынмен бейнеленген «табыс» деген сенім бар, солай емес пе?
Dialogue: 0,0:22:32.51,0:22:33.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:33.51,0:22:36.18,Default,,0,0,0,,Олай болса, ақыры онымен бетпе-бет келу керек.
Dialogue: 0,0:22:36.27,0:22:38.94,Default,,0,0,0,,Өз сенімдеріңізді ұстанудың қиындығы
Dialogue: 0,0:22:39.52,0:22:41.90,Default,,0,0,0,,Сенім үшін баға керек
Dialogue: 0,0:22:41.98,0:22:44.86,Default,,0,0,0,,Өміріңді қатерге тіге алмасаң, аузыңды пайдалан.
Dialogue: 0,0:22:44.94,0:22:49.45,Default,,0,0,0,,Бұдан былай бұл жанашырлықпен үйлесетін жолмен жүре алатын сала емес.
Dialogue: 0,0:22:50.49,0:22:51.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:51.62,0:22:52.45,Default,,0,0,0,,Ой
Dialogue: 0,0:22:52.53,0:22:53.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:53.78,0:22:55.83,Default,,0,0,0,,Барлықтарыңыз, қобалжымаңыздар.
Dialogue: 0,0:22:58.16,0:23:00.83,Default,,0,0,0,,Бұл рыцарьлар. Бір-бірімізден өтеміз.
Dialogue: 0,0:23:00.92,0:23:02.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:02.21,0:23:04.38,Default,,0,0,0,,Түрді орындықтың артына жасырыңыз
Dialogue: 0,0:23:16.56,0:23:17.39,Default,,0,0,0,,Я...
Dialogue: 0,0:23:17.47,0:23:18.89,Default,,0,0,0,,
Dialogue: 0,0:23:19.77,0:23:21.48,Default,,0,0,0,,Мына вагонды тоқтатыңыз!
Dialogue: 0,0:23:27.11,0:23:28.90,Default,,0,0,0,,Барлығың төмен түсіңдер.
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.03,0:24:59.03,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.53,0:25:06.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory