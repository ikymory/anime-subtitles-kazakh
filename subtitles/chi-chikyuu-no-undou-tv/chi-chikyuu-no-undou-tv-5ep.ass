Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.67,0:00:11.13,Default,,0,0,0,,(Новактың есінеу)
Dialogue: 0,0:00:11.92,0:00:14.51,Default,,0,0,0,,Өтінемін, Дэмиен.
Dialogue: 0,0:00:15.34,0:00:17.76,Default,,0,0,0,,Бұл маған керек пе?
Dialogue: 0,0:00:17.85,0:00:21.39,Default,,0,0,0,,Бүгінгі бидғатқа Петр жауапты, солай ма?
Dialogue: 0,0:00:21.89,0:00:25.27,Default,,0,0,0,,Сізді тасымалдау кезінде ғана мәжбүрлі түрде шығарылады.
Dialogue: 0,0:00:25.98,0:00:29.94,Default,,0,0,0,,Новак мырза, мен біраздан бері осыны ойлап жүрмін.
Dialogue: 0,0:00:30.03,0:00:31.61,Default,,0,0,0,,Бұл қандай көзқарас?
Dialogue: 0,0:00:31.69,0:00:32.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:33.11,0:00:34.82,Default,,0,0,0,,Біз Құдайға қызмет етеміз
Dialogue: 0,0:00:34.90,0:00:38.62,Default,,0,0,0,,Сіз өзіңіздің сеніміңіздің тұрақтылығын қорғау үшін жұмыс істеп жатырсыз, солай ма?
Dialogue: 0,0:00:38.70,0:00:40.62,Default,,0,0,0,,Инерцияға жол берілмейді
Dialogue: 0,0:00:40.70,0:00:41.87,Default,,0,0,0,,Егер бірдеңе болса —
Dialogue: 0,0:00:41.95,0:00:44.71,Default,,0,0,0,,Бұған Новак мырза жауапты болатынын білесіз бе?
Dialogue: 0,0:00:44.79,0:00:48.29,Default,,0,0,0,,Аа, жоқ, бұл...
Dialogue: 0,0:00:53.97,0:00:54.80,Default,,0,0,0,,Ах
Dialogue: 0,0:00:56.30,0:00:57.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:57.80,0:00:59.47,Default,,0,0,0,,ше? Эй
Dialogue: 0,0:01:00.72,0:01:01.97,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:01:02.60,0:01:03.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:03.64,0:01:07.23,Default,,0,0,0,,Мен вагоншы алдыңғы вагоннан секіріп түсті деп ойладым...
Dialogue: 0,0:01:07.94,0:01:09.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:09.27,0:01:12.44,Default,,0,0,0,,Қауіпсіздік кәсіподақ жігіттері маған опасыздық жасады.
Dialogue: 0,0:01:13.44,0:01:15.15,Default,,0,0,0,,Осы жерден тоқтаңыз
Dialogue: 0,0:01:20.62,0:01:22.62,Default,,0,0,0,,Сонымен... Оны пайдалануға рұқсат етілген бе?
Dialogue: 0,0:01:22.70,0:01:24.62,Default,,0,0,0,,Бұл төтенше жағдай.
Dialogue: 0,0:01:24.70,0:01:26.71,Default,,0,0,0,,Бір рет ату жақсы, солай ма?
Dialogue: 0,0:01:29.75,0:01:32.63,Default,,0,0,0,,
Dialogue: 0,0:01:33.71,0:01:36.01,Default,,0,0,0,,(Төңкерілген дыбыс)
Dialogue: 0,0:01:38.34,0:01:40.26,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:01:40.35,0:01:42.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:43.35,0:01:44.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:45.35,0:01:46.85,Default,,0,0,0,,- (Еретикалық) Уф... - (Окжи) Хах.
Dialogue: 0,0:01:46.94,0:01:50.15,Default,,0,0,0,,(Еретиктер мұңы)
Dialogue: 0,0:01:50.23,0:01:54.11,Default,,0,0,0,,Ача~ Бұл жарқыраған мүк.
Dialogue: 0,0:01:54.19,0:01:55.28,Default,,0,0,0,,Бұл енді мүмкін емес пе?
Dialogue: 0,0:01:55.36,0:01:56.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:59.07,0:02:01.32,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:02:01.41,0:02:02.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:02.33,0:02:07.75,Default,,0,0,0,,(Окджидің ауыр тыныс алуы)
Dialogue: 0,0:02:09.50,0:02:10.58,Default,,0,0,0,,Уау
Dialogue: 0,0:02:11.46,0:02:13.50,Default,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:02:13.59,0:02:15.13,Default,,0,0,0,,Мені қорқытты...
Dialogue: 0,0:02:15.21,0:02:17.84,Default,,0,0,0,,Сіз бұған сенесіз бе?
Dialogue: 0,0:02:17.92,0:02:20.34,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:02:25.81,0:02:27.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:28.27,0:02:29.85,Default,,0,0,0,,Мүмкіндік жоқ.
Dialogue: 0,0:02:34.15,0:02:36.23,Default,,0,0,0,,Бұл адам күшті
Dialogue: 0,0:02:36.32,0:02:38.57,Default,,0,0,0,,Ұрыссаң өлетін шығарсың.
Dialogue: 0,0:02:39.36,0:02:41.70,Default,,0,0,0,,Егер бұл орын алса ше?
Dialogue: 0,0:02:43.74,0:02:44.91,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:02:44.99,0:02:47.70,Default,,0,0,0,,Бұл менің кінәм, мені кешіріңіз!
Dialogue: 0,0:02:48.37,0:02:49.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:49.83,0:02:51.17,Default,,0,0,0,,Е...
Dialogue: 0,0:02:51.25,0:02:57.21,Default,,0,0,0,,Иә? Ұрыс кезінде берілумен қалай күресуім керек?
Dialogue: 0,0:02:57.30,0:02:59.38,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:59.47,0:03:02.64,Default,,0,0,0,,«Мұны әркімнің өз шешіміне қалдырыңыз»
Dialogue: 0,0:03:02.72,0:03:05.10,Default,,0,0,0,,Бұл ең қиыны.
Dialogue: 0,0:03:06.22,0:03:09.18,Default,,0,0,0,,Жарайды, бірақ ол маған бір рет опасыздық жасады.
Dialogue: 0,0:03:09.73,0:03:11.64,Default,,0,0,0,,Жол босатыңыз. Енді мен қосымша күштерді ұйымдастыруды өз мойныма аламын.
Dialogue: 0,0:03:11.73,0:03:13.86,Default,,0,0,0,,Сен маған енді керек емессің
Dialogue: 0,0:03:13.94,0:03:14.94,Default,,0,0,0,,А...
Dialogue: 0,0:03:15.94,0:03:16.69,Default,,0,0,0,,Уау
Dialogue: 0,0:03:16.69,0:03:17.36,Default,,0,0,0,,Уау
Dialogue: 0,0:03:16.69,0:03:17.36,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:03:17.36,0:03:17.98,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:03:20.36,0:03:23.16,Default,,0,0,0,,... Иә? неге?
Dialogue: 0,0:03:24.53,0:03:27.87,Default,,0,0,0,,Өйткені тарих сізге керек еді
Dialogue: 0,0:03:27.95,0:03:29.16,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:03:29.87,0:03:31.54,Default,,0,0,0,,А... А?
Dialogue: 0,0:03:34.67,0:03:35.88,Default,,0,0,0,,Иә
Dialogue: 0,0:03:39.09,0:03:40.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:40.51,0:03:42.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:42.13,0:03:43.22,Default,,0,0,0,,О
Dialogue: 0,0:03:54.44,0:03:55.56,Default,,0,0,0,,Tsk
Dialogue: 0,0:03:55.65,0:03:57.15,Default,,0,0,0,,- Новак мырза - (Новак) А?
Dialogue: 0,0:03:57.23,0:03:59.57,Default,,0,0,0,,Арбалетті алайын ба?
Dialogue: 0,0:03:59.65,0:04:02.40,Default,,0,0,0,,А, жарайды, жарайды.
Dialogue: 0,0:04:02.49,0:04:04.66,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:04:04.74,0:04:06.37,Default,,0,0,0,,Ақаулық…
Dialogue: 0,0:04:07.78,0:04:12.46,Default,,0,0,0,,Жоқ, жебелерді қолдансаңыз, ашуланасыз.
Dialogue: 0,0:04:12.54,0:04:14.92,Default,,0,0,0,,Ал біз түсіруіміз керек нәрсе
Dialogue: 0,0:04:15.50,0:04:17.92,Default,,0,0,0,,Мен енді осыдан шаршадым.
Dialogue: 0,0:04:21.01,0:04:24.30,Default,,0,0,0,,Мен де бұрынғы жалдамалымын, сондықтан түсінемін.
Dialogue: 0,0:04:24.38,0:04:27.55,Default,,0,0,0,,Олар бәрібір бір әріпті оқи алмайтын шығар.
Dialogue: 0,0:04:27.64,0:04:30.06,Default,,0,0,0,,Еретикке айналуға қабілетсіз
Dialogue: 0,0:04:31.81,0:04:34.77,Default,,0,0,0,,Мен сені жалғыз қалдырсам да, сен ештеңе істей алмайсың.
Dialogue: 0,0:04:38.40,0:04:43.15,Default,,0,0,0,,♪~
Dialogue: 0,0:06:02.52,0:06:06.86,Default,,0,0,0,,~♪
Dialogue: 0,0:06:06.94,0:06:09.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:25.17,0:06:27.01,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:06:27.09,0:06:30.76,Default,,0,0,0,,Қашпағандықтан, қазір қылышыңды қоюға болады.
Dialogue: 0,0:06:30.84,0:06:33.26,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:06:37.85,0:06:40.39,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,0:06:40.98,0:06:44.90,Default,,0,0,0,,Бірақ одан басынан бастағыңыз келе ме деп сұрағанда, ол жоқ деп жауап берді.
Dialogue: 0,0:06:44.98,0:06:49.32,Default,,0,0,0,,Қанша рет қайталасаңыз да, дәл солай таңдау жасаған боларсыз.
Dialogue: 0,0:06:49.40,0:06:51.91,Default,,0,0,0,,Бұл кешірім сұрауда шынайылық жоқ
Dialogue: 0,0:06:51.99,0:06:55.58,Default,,0,0,0,,Мен бұған да қатты өкінемін.
Dialogue: 0,0:06:55.66,0:06:56.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:57.33,0:07:00.42,Default,,0,0,0,,А, иә, түсіндім.
Dialogue: 0,0:07:00.92,0:07:04.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:13.80,0:07:16.47,Default,,0,0,0,,Ол аздап ашылды.
Dialogue: 0,0:07:16.56,0:07:19.48,Default,,0,0,0,,Бұл аймақ төбенің жартысында болуы мүмкін.
Dialogue: 0,0:07:19.56,0:07:20.73,Default,,0,0,0,,Ізденейік
Dialogue: 0,0:07:33.03,0:07:33.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.04,0:07:40.41,Default,,0,0,0,,Мистер Гласс!
Dialogue: 0,0:07:44.58,0:07:45.50,Default,,0,0,0,,Ах
Dialogue: 0,0:07:46.29,0:07:48.71,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0,0,0,,(Қақпақ ашылған дыбыс)
Dialogue: 0,0:08:10.03,0:08:11.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:12.11,0:08:13.65,Default,,0,0,0,,Бұл қандай фигура?
Dialogue: 0,0:08:14.74,0:08:17.16,Default,,0,0,0,,Бұл әріпке ұқсайды.
Dialogue: 0,0:08:17.24,0:08:21.41,Default,,0,0,0,,Екі, біреуі соңғы күні...
Dialogue: 0,0:08:22.33,0:08:23.92,Default,,0,0,0,,10 жыл бұрын?
Dialogue: 0,0:08:25.54,0:08:27.38,Default,,0,0,0,,Маған соңғысын бере аласыз ба?
Dialogue: 0,0:08:27.46,0:08:29.67,Default,,0,0,0,,Бұл еретикке тиесілі болуы мүмкін.
Dialogue: 0,0:08:34.05,0:08:36.80,Default,,0,0,0,,Ммм... қарғыс атқыр көздер
Dialogue: 0,0:08:37.60,0:08:39.10,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:08:40.26,0:08:45.81,Default,,0,0,0,,Біріншіден, мен бұл тас жәшіктің жасаушысы емеспін.
Dialogue: 0,0:08:45.90,0:08:47.48,Default,,0,0,0,,Ашушы
Dialogue: 0,0:08:48.19,0:08:50.94,Default,,0,0,0,,Бұл қорап қалай ашылды
Dialogue: 0,0:08:51.03,0:08:52.99,Default,,0,0,0,,Мен жазып аламын деп ойлаймын.
Dialogue: 0,0:08:54.03,0:08:59.08,Default,,0,0,0,,Астролог ретінде мен күнделікті аспан денелерін бақылайтынмын.
Dialogue: 0,0:08:59.62,0:09:02.50,Default,,0,0,0,,Кейде көріну мен биіктікті ескере отырып
Dialogue: 0,0:09:02.58,0:09:05.75,Default,,0,0,0,,Мен осы аймақтағы ең жақсы бақылау орнын таптым.
Dialogue: 0,0:09:06.54,0:09:09.25,Default,,0,0,0,,Сонда мен біртүрлі нәрсені байқадым.
Dialogue: 0,0:09:09.34,0:09:12.63,Default,,0,0,0,,Екі үлкен жартастың әрқайсысында
Dialogue: 0,0:09:12.71,0:09:15.63,Default,,0,0,0,,Ортасында белгіленген үш жұлдыз—
Dialogue: 0,0:09:16.38,0:09:19.18,Default,,0,0,0,,Орионның белбеуі ойылған.
Dialogue: 0,0:09:19.85,0:09:22.64,Default,,0,0,0,,Және сәйкесінше
Dialogue: 0,0:09:22.72,0:09:27.52,Default,,0,0,0,,Екі жартастың арасынан тура қарсы жақтан таудың баурайы көрінеді.
Dialogue: 0,0:09:28.10,0:09:30.11,Default,,0,0,0,,Жер бетінде не бар?
Dialogue: 0,0:09:30.19,0:09:32.53,Default,,0,0,0,,Кім? Не үшін?
Dialogue: 0,0:09:33.48,0:09:37.24,Default,,0,0,0,,Қызығудың жетегінде кетіп, тауға қарай беттедім.
Dialogue: 0,0:09:39.53,0:09:42.49,Default,,0,0,0,,Сосын мен мына қорапты кездестірдім.
Dialogue: 0,0:09:43.37,0:09:48.58,Default,,0,0,0,,«Соңында қорапты кім тастап кетті және неліктен сонда қалды?»
Dialogue: 0,0:09:48.67,0:09:50.54,Default,,0,0,0,,«Мен мұның қалай болғанын білмеймін».
Dialogue: 0,0:09:50.63,0:09:52.34,Default,,0,0,0,,«Бірақ ішінде не бар?»
Dialogue: 0,0:09:52.42,0:09:57.26,Default,,0,0,0,,«Толық болмаса да, адамзат тарихы мен тағдырын өзгертеді».
Dialogue: 0,0:09:57.34,0:09:58.43,Default,,0,0,0,,«Мен анық түсінемін»
Dialogue: 0,0:09:59.22,0:10:02.22,Default,,0,0,0,,«Осы жаңалық үшін өлсем де».
Dialogue: 0,0:10:02.31,0:10:07.02,Default,,0,0,0,,«Осы жаңалықтың арқасында мен бақытты өмір сүрдім деп айта аламын».
Dialogue: 0,0:10:07.10,0:10:07.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:12.52,0:10:16.40,Default,,0,0,0,,«Толық ақпарат алу үшін берілген материалдарды тексеріңіз»
Dialogue: 0,0:10:16.49,0:10:21.12,Default,,0,0,0,,«Мен де рұқсатсыз бірнеше есептеулерді түзетіп қойдым».
Dialogue: 0,0:10:21.74,0:10:22.95,Default,,0,0,0,,«Артық»
Dialogue: 0,0:10:24.20,0:10:26.08,Default,,0,0,0,,Бұл хатта не айтылған?
Dialogue: 0,0:10:26.16,0:10:27.20,Default,,0,0,0,,А...
Dialogue: 0,0:10:30.00,0:10:32.13,Default,,0,0,0,,Я... Мен оны оқи алмаймын.
Dialogue: 0,0:10:32.21,0:10:34.50,Default,,0,0,0,,Кейіпкерлер Мен оларды дұрыс меңгермедім.
Dialogue: 0,0:10:35.00,0:10:39.09,Default,,0,0,0,,Аа, бірақ бұл жай ғана тақырып болса, бәрібір.
Dialogue: 0,0:10:39.18,0:10:40.43,Default,,0,0,0,,Не?
Dialogue: 0,0:10:42.39,0:10:43.55,Default,,0,0,0,,«Жер»
Dialogue: 0,0:10:53.69,0:10:56.36,Default,,0,0,0,,Жоқ, бұл көпір де құлаған.
Dialogue: 0,0:10:56.44,0:10:57.90,Default,,0,0,0,,Айналмалы жолмен жүрейік
Dialogue: 0,0:10:58.44,0:11:00.15,Default,,0,0,0,,Осы жерден...
Dialogue: 0,0:11:02.53,0:11:03.49,Default,,0,0,0,,Ах
Dialogue: 0,0:11:05.58,0:11:07.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:12.12,0:11:13.50,Default,,0,0,0,,Мен оны тастауым керек пе?
Dialogue: 0,0:11:13.58,0:11:16.96,Default,,0,0,0,,Иә, бұл еретикалық және қорқынышты.
Dialogue: 0,0:11:17.80,0:11:20.51,Default,,0,0,0,,Бірақ бұл маңызды анықтама.
Dialogue: 0,0:11:20.59,0:11:22.18,Default,,0,0,0,,Мен басшылықты аламын.
Dialogue: 0,0:11:26.18,0:11:27.93,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:11:33.02,0:11:34.06,Default,,0,0,0,,Жер?
Dialogue: 0,0:11:34.15,0:11:36.73,Default,,0,0,0,,Иә, мұның бәрі мұқабада
Dialogue: 0,0:11:37.32,0:11:39.03,Default,,0,0,0,,Қарыз берші, оқып берейін.
Dialogue: 0,0:11:41.20,0:11:42.66,Default,,0,0,0,,Е...
Dialogue: 0,0:11:42.74,0:11:45.49,Default,,0,0,0,,«Осы жұлдызды аспанның құпиясын арнаңыз»
Dialogue: 0,0:11:45.57,0:11:48.99,Default,,0,0,0,,«Егер бұл пайда әкелсе»
Dialogue: 0,0:11:49.08,0:11:52.50,Default,,0,0,0,,«Оның 10% Потоцукиге беру»
Dialogue: 0,0:11:52.58,0:11:55.50,Default,,0,0,0,,«Оның ынтымақтастығы сенімді болды»
Dialogue: 0,0:11:55.58,0:11:57.42,Default,,0,0,0,,«Мекенжай…»
Dialogue: 0,0:11:57.50,0:12:00.92,Default,,0,0,0,,...Мазмұны жазылмаған ғой.
Dialogue: 0,0:12:02.01,0:12:04.22,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:12:06.10,0:12:10.93,Default,,0,0,0,,Біріншіден, бұл кітап астрономия туралы болса керек.
Dialogue: 0,0:12:11.56,0:12:15.77,Default,,0,0,0,,Алайда негізгі мазмұны латын және математикалық формулалармен жазылған және оқуға қиын.
Dialogue: 0,0:12:16.48,0:12:19.28,Default,,0,0,0,,Ал біздің болашағымыз туралы.
Dialogue: 0,0:12:19.78,0:12:24.16,Default,,0,0,0,,Менің кесірімнен қалаға да, одаққа да қайта алмайсың.
Dialogue: 0,0:12:24.91,0:12:27.07,Default,,0,0,0,,Бірақ егер сіз өзіңізді қорғасаңыз
Dialogue: 0,0:12:27.87,0:12:32.16,Default,,0,0,0,,Мүмкін біз қазіргі жағдайды пайдаланып, бәрін айналдыра аламыз.
Dialogue: 0,0:12:32.75,0:12:34.50,Default,,0,0,0,,Осы жазбаның көлемін қарастыру
Dialogue: 0,0:12:34.58,0:12:37.42,Default,,0,0,0,,Бұл жай идея немесе биік әңгіме емес.
Dialogue: 0,0:12:37.50,0:12:39.67,Default,,0,0,0,,Маңызды нәрсе болуы керек
Dialogue: 0,0:12:40.38,0:12:44.80,Default,,0,0,0,,Егер сіз оны дұрыс адамға көрсетсеңіз, олар сізге үлкен ат беруі мүмкін.
Dialogue: 0,0:12:44.88,0:12:47.72,Default,,0,0,0,,Сондай-ақ қораптың мазмұнын білуге ​​болады.
Dialogue: 0,0:12:47.80,0:12:50.68,Default,,0,0,0,,Сіздің лайықты серіктесіңіз бар ма?
Dialogue: 0,0:12:52.27,0:12:55.31,Default,,0,0,0,,Негізі менің ойымда бір адам бар.
Dialogue: 0,0:12:56.06,0:12:59.15,Default,,0,0,0,,Бұл мен планета туралы сұраған монах.
Dialogue: 0,0:12:59.73,0:13:01.82,Default,,0,0,0,,Мен атына сенімдімін—
Dialogue: 0,0:13:01.90,0:13:03.07,Default,,0,0,0,,Бадени
Dialogue: 0,0:13:03.15,0:13:06.95,Default,,0,0,0,,Иә! Монах бидғат туралы айтып жатыр...
Dialogue: 0,0:13:07.03,0:13:09.45,Default,,0,0,0,,Бұл жай ғана монах емес.
Dialogue: 0,0:13:09.95,0:13:12.70,Default,,0,0,0,,Біраз уақыт бұрын ол төмендетілді.
Dialogue: 0,0:13:13.54,0:13:15.71,Default,,0,0,0,,Себеп - нашар мінез-құлық.
Dialogue: 0,0:13:16.29,0:13:18.00,Default,,0,0,0,,Идеологиялық тыйымдар
Dialogue: 0,0:13:18.08,0:13:18.96,Default,,0,0,0,,Ha
Dialogue: 0,0:13:19.79,0:13:21.42,Default,,0,0,0,,Сіз біліктісіз бе?
Dialogue: 0,0:13:21.50,0:13:23.88,Default,,0,0,0,,Егер сіз солай шешсеңіз, дереу кеттік.
Dialogue: 0,0:13:26.01,0:13:28.72,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:13:29.30,0:13:32.72,Default,,0,0,0,,Жоқ, мен абдырап қалдым.
Dialogue: 0,0:13:33.31,0:13:35.64,Default,,0,0,0,,Біз осы уақытқа дейін келдік, бірақ
Dialogue: 0,0:13:35.73,0:13:37.73,Default,,0,0,0,,Егер мен тынышталсам, мен—
Dialogue: 0,0:13:38.31,0:13:41.98,Default,,0,0,0,,Маған қазірден бастап сізбен бірге жүрудің қажеті жоқ.
Dialogue: 0,0:13:45.03,0:13:47.40,Default,,0,0,0,,Мистер Гласс шешеді ме?
Dialogue: 0,0:13:47.49,0:13:48.66,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:13:53.12,0:13:58.00,Default,,0,0,0,,Екі адам болса қауіпсіз, сондықтан менімен бірге жүрсеңіз риза болар едім.
Dialogue: 0,0:13:58.62,0:14:01.17,Default,,0,0,0,,Сонымен... онда мен мұны істеймін.
Dialogue: 0,0:14:09.26,0:14:10.51,Default,,0,0,0,,Оқзы-күн
Dialogue: 0,0:14:10.59,0:14:11.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.10,0:14:15.18,Default,,0,0,0,,Солтүстік жұлдызға назар аудара аласыз ба?
Dialogue: 0,0:14:15.27,0:14:16.64,Default,,0,0,0,,Мен бағытты көргім келеді
Dialogue: 0,0:14:17.27,0:14:19.90,Default,,0,0,0,,Мен жай ғана көзімді жасадым.
Dialogue: 0,0:14:19.98,0:14:23.40,Default,,0,0,0,,А... кешіріңіз, бұл мүмкін емес.
Dialogue: 0,0:14:24.11,0:14:26.90,Default,,0,0,0,,ше? Егер сіздің көзіңіз...
Dialogue: 0,0:14:26.99,0:14:29.74,Default,,0,0,0,,Жарайды... Аспанды көре алмаймын.
Dialogue: 0,0:14:29.82,0:14:30.66,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:14:32.16,0:14:33.91,Default,,0,0,0,,Бұл... Мен қорқамын.
Dialogue: 0,0:14:34.95,0:14:37.91,Default,,0,0,0,,Баяғыда мен діни қызметкерден үйрендім.
Dialogue: 0,0:14:38.00,0:14:40.08,Default,,0,0,0,,Түнгі аспан әдемі
Dialogue: 0,0:14:40.17,0:14:44.00,Default,,0,0,0,,Өйткені мен жердің лас түбінен жоғары қараймын
Dialogue: 0,0:14:44.59,0:14:48.13,Default,,0,0,0,,Содан бері мен аспанға қарасам, жұлдыздарды көремін...
Dialogue: 0,0:14:49.01,0:14:52.89,Default,,0,0,0,,Оның көздері жер бетінде өмір сүретін адамдарды менсінбейтін сияқты.
Dialogue: 0,0:14:54.01,0:14:55.89,Default,,0,0,0,,Бұл біртүрлі әңгіме, бірақ
Dialogue: 0,0:14:57.22,0:15:00.02,Default,,0,0,0,,Бұған дейін аспанды көре алдыңыз ба?
Dialogue: 0,0:15:00.60,0:15:02.10,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:02.61,0:15:04.48,Default,,0,0,0,,Немесе...
Dialogue: 0,0:15:06.07,0:15:08.03,Default,,0,0,0,,Маған ұнаған шығар.
Dialogue: 0,0:15:08.11,0:15:09.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:09.99,0:15:11.16,Default,,0,0,0,,Тағы да —
Dialogue: 0,0:15:11.24,0:15:13.66,Default,,0,0,0,,Аспанды көргің келмей ме?
Dialogue: 0,0:15:14.99,0:15:18.16,Default,,0,0,0,,Иә, бәрі жақсы, өйткені мен қорқамын.
Dialogue: 0,0:15:18.25,0:15:20.50,Default,,0,0,0,,Сен маған қатты ұнадың
Dialogue: 0,0:15:20.58,0:15:22.71,Default,,0,0,0,,Бас тарту өте жаман емес пе?
Dialogue: 0,0:15:23.21,0:15:24.96,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:15:25.54,0:15:26.80,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:26.88,0:15:30.09,Default,,0,0,0,,Бірақ мұның Глас мырзаға еш қатысы жоқ.
Dialogue: 0,0:15:31.13,0:15:32.97,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:15:33.05,0:15:36.64,Default,,0,0,0,,Бірақ мен де баяғыда отбасымнан айырылдым.
Dialogue: 0,0:15:36.72,0:15:39.39,Default,,0,0,0,,Мен жақсы көретін нәрсеңнен айырылудың азабын түсінемін.
Dialogue: 0,0:15:39.89,0:15:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:41.10,0:15:45.90,Default,,0,0,0,,Ал... мұнымен салыстырғанда бұл ештеңе емес.
Dialogue: 0,0:15:45.98,0:15:48.73,Default,,0,0,0,,Өйткені, бұл дүние туралы.
Dialogue: 0,0:15:49.65,0:15:51.53,Default,,0,0,0,,That's not true.
Dialogue: 0,0:15:51.61,0:15:54.41,Default,,0,0,0,,Адамның көзқарасы бойынша бұл үлкен мәселе.
Dialogue: 0,0:15:54.49,0:15:56.58,Default,,0,0,0,,Жоқ, және...
Dialogue: 0,0:15:57.08,0:16:00.91,Default,,0,0,0,,Мистер Гласс адаспағанына сенімдімін.
Dialogue: 0,0:16:01.00,0:16:02.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.25,0:16:05.54,Default,,0,0,0,,Сіздің отбасыңыз қазір жұмақта болуы керек.
Dialogue: 0,0:16:05.63,0:16:08.30,Default,,0,0,0,,Бір күні көкте тағы кездесеміз.
Dialogue: 0,0:16:10.05,0:16:13.22,Default,,0,0,0,,Рахмет, мен де солай ойлаймын.
Dialogue: 0,0:16:14.01,0:16:20.27,Default,,0,0,0,,Бірақ мен жоғалтқаным бұл дүниеде үмітті сезген жүрек болды.
Dialogue: 0,0:16:20.35,0:16:21.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:22.23,0:16:24.94,Default,,0,0,0,,Біраз уақыт бұрын
Dialogue: 0,0:16:25.02,0:16:28.27,Default,,0,0,0,,Асыл отбасымды алып кеткен мына дүниені қарғадым.
Dialogue: 0,0:16:29.02,0:16:30.78,Default,,0,0,0,,Бірақ ойланып қарасаңыз
Dialogue: 0,0:16:30.86,0:16:33.74,Default,,0,0,0,,Мен ең қымбатты отбасымды осы дүниеде кездестірдім.
Dialogue: 0,0:16:34.82,0:16:36.66,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:16:36.74,0:16:39.49,Default,,0,0,0,,Отбасыммен өткізген дүниені жоққа шығарғым келмейді.
Dialogue: 0,0:16:39.99,0:16:42.62,Default,,0,0,0,,Бұл қиын болуы мүмкін
Dialogue: 0,0:16:42.71,0:16:45.79,Default,,0,0,0,,Мен бұл дүниені тағы бір рет растағым келеді.
Dialogue: 0,0:16:47.92,0:16:50.96,Default,,0,0,0,,Бұл қатыгез, бірақ мүмкін емес.
Dialogue: 0,0:16:51.05,0:16:52.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:53.88,0:16:56.26,Default,,0,0,0,,Үміт тек көкте
Dialogue: 0,0:16:56.34,0:16:58.30,Default,,0,0,0,,Бұл дүние таза емес
Dialogue: 0,0:16:58.39,0:17:02.73,Default,,0,0,0,,Өйткені Құдай оны осылай жаратқан.
Dialogue: 0,0:17:02.81,0:17:06.19,Default,,0,0,0,,Бұл тарихтағы ең ақылды адамдардан алынған факт.
Dialogue: 0,0:17:07.73,0:17:09.19,Default,,0,0,0,,Сен…
Dialogue: 0,0:17:10.40,0:17:14.78,Default,,0,0,0,,Сіз бұл дүниеден толығымен бас тарттыңыз ба?
Dialogue: 0,0:17:18.24,0:17:22.37,Default,,0,0,0,,Иә, бұл дүниеде бізді күтіп тұрғанның бәрі – жоғалту.
Dialogue: 0,0:17:22.45,0:17:26.58,Default,,0,0,0,,Оның үстіне адамдар бірден өліп, бәрібір жұмаққа немесе тозаққа барады.
Dialogue: 0,0:17:26.67,0:17:28.92,Default,,0,0,0,,Сіз бұл туралы алаңдауыңыз керек.
Dialogue: 0,0:17:31.38,0:17:32.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.05,0:17:41.76,Default,,0,0,0,,Үміт тек көкте
Dialogue: 0,0:17:42.85,0:17:44.73,Default,,0,0,0,,Бірақ неге бұл күпірлік?
Dialogue: 0,0:17:44.81,0:17:50.11,Default,,0,0,0,,Аспанды ығыстырып, өміріңді қатерге тігіп, бұл дүниені мақтадың ба?
Dialogue: 0,0:17:51.82,0:17:53.65,Default,,0,0,0,,Адамдар өледі
Dialogue: 0,0:17:53.73,0:17:56.78,Default,,0,0,0,,Бір күні шығатын бұл дүниеге деген сезімнің болуы
Dialogue: 0,0:17:56.86,0:17:58.41,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:59.53,0:18:02.99,Default,,0,0,0,,Өлгеннен кейін сенсіз дүние ғана қалады.
Dialogue: 0,0:18:04.04,0:18:06.16,Default,,0,0,0,,Үміт жоқ...
Dialogue: 0,0:18:07.66,0:18:08.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.51,0:18:19.64,Default,,0,0,0,,Жоқ, мүмкін бұл...
Dialogue: 0,0:18:21.55,0:18:26.43,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:18:26.52,0:18:29.06,Default,,0,0,0,,Көпірдің қалғаны жақсы.
Dialogue: 0,0:18:29.14,0:18:31.52,Default,,0,0,0,,Бұл жерден өткенде, сіз қазірдің өзінде ауылдасыз.
Dialogue: 0,0:18:32.11,0:18:34.69,Default,,0,0,0,,Енді, мен әзірге жеңілдеп қалдым.
Dialogue: 0,0:18:49.96,0:18:51.79,Default,,0,0,0,,-Окуджи-кун - (Окуджи) Иә.
Dialogue: 0,0:18:52.54,0:18:55.50,Default,,0,0,0,,Осы уақытқа дейін мен өзімді соған мәжбүрледім.
Dialogue: 0,0:18:55.59,0:18:58.92,Default,,0,0,0,,Сондықтан қазірден бастап мен сенің таңдағаныңды қалаймын.
Dialogue: 0,0:18:59.01,0:19:00.05,Default,,0,0,0,,А...
Dialogue: 0,0:19:00.13,0:19:02.68,Default,,0,0,0,,Алда екі нұсқа бар.
Dialogue: 0,0:19:02.76,0:19:04.68,Default,,0,0,0,,Біреуі – ауылға жеткенде.
Dialogue: 0,0:19:04.76,0:19:08.56,Default,,0,0,0,,Оқиға мен тас жәшік туралы шіркеуге хабарлаңыз.
Dialogue: 0,0:19:08.64,0:19:11.81,Default,,0,0,0,,Сонда мен қалаға қайтатын шығармын.
Dialogue: 0,0:19:11.90,0:19:14.06,Default,,0,0,0,,Аспанға жақындайсың
Dialogue: 0,0:19:14.15,0:19:16.82,Default,,0,0,0,,Бірақ мұны істесеңіз, Мистер Гласс...
Dialogue: 0,0:19:20.20,0:19:21.03,Default,,0,0,0,,Екінші нәрсе...
Dialogue: 0,0:19:21.11,0:19:22.07,Default,,0,0,0,,Ах
Dialogue: 0,0:19:24.91,0:19:26.33,Default,,0,0,0,,- Уау - (Окджи) Ах!
Dialogue: 0,0:19:30.08,0:19:31.37,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:32.58,0:19:34.33,Default,,0,0,0,,Гу... Гласс мырза!
Dialogue: 0,0:19:36.92,0:19:38.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:38.92,0:19:40.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:41.93,0:19:42.93,Default,,0,0,0,,Ах
Dialogue: 0,0:19:43.72,0:19:45.55,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:19:46.60,0:19:48.02,Default,,0,0,0,,Екінші тармақ қысқаша.
Dialogue: 0,0:19:48.10,0:19:51.10,Default,,0,0,0,,Иә? Мұндай жағдайда қазір...
Dialogue: 0,0:19:51.19,0:19:56.61,Default,,0,0,0,,Екіншісі, біріншісін елемеу және бұл дүниеден күту.
Dialogue: 0,0:19:56.69,0:19:57.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.90,0:20:01.86,Default,,0,0,0,,Күндердің күнінде тағы да сол көздермен аспанға қарашы.
Dialogue: 0,0:20:03.95,0:20:04.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:06.45,0:20:07.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:07.95,0:20:09.29,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:20:10.45,0:20:12.41,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:20:12.50,0:20:13.87,Default,,0,0,0,,Шырмауық сындырады
Dialogue: 0,0:20:13.96,0:20:16.08,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:20:16.17,0:20:18.34,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:20:19.42,0:20:20.34,Default,,0,0,0,,Сеніп тапсырылған
Dialogue: 0,0:20:20.42,0:20:21.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.30,0:20:24.55,Default,,0,0,0,,Осы қарқынмен екеуміз де өлеміз.
Dialogue: 0,0:20:24.64,0:20:26.01,Default,,0,0,0,,Барлығы 1965 жылғы жазға барып тіреледі
Dialogue: 0,0:20:26.09,0:20:28.56,Default,,0,0,0,,Мен дінбұзардың өз өмірін қия алғанына сенімдімін.
Dialogue: 0,0:20:28.64,0:20:30.77,Default,,0,0,0,,Өйткені сеніп тапсыратын адам бар еді
Dialogue: 0,0:20:31.77,0:20:35.56,Default,,0,0,0,,Өзіңіз айтқандай, бұл дүние жоғалтқанға толы.
Dialogue: 0,0:20:36.15,0:20:39.57,Default,,0,0,0,,Оның үстіне адамдар бір күні өліп, осы жерден кетеді.
Dialogue: 0,0:20:39.65,0:20:43.82,Default,,0,0,0,,Бірақ мен өлсем де бұл дүние жалғасады
Dialogue: 0,0:20:43.90,0:20:46.95,Default,,0,0,0,,Онда бір нәрсені сеніп тапсыруға болады.
Dialogue: 0,0:20:47.03,0:20:49.03,Default,,0,0,0,,Бұл жоғалтуға толы.
Dialogue: 0,0:20:49.12,0:20:52.87,Default,,0,0,0,,Бұл дүниеден туған үміттің бір түрі.
Dialogue: 0,0:20:53.54,0:20:56.96,Default,,0,0,0,,А... кімге сеніп тапсырасың? Мен бе?
Dialogue: 0,0:20:57.04,0:20:58.54,Default,,0,0,0,,Мен үміт артқым келмейді
Dialogue: 0,0:20:58.63,0:21:00.71,Default,,0,0,0,,Мен мұны істейтініме кепілдік жоқ!
Dialogue: 0,0:21:00.80,0:21:02.71,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:21:02.80,0:21:04.55,Default,,0,0,0,,Бірақ сіз мұны істейсіз
Dialogue: 0,0:21:04.63,0:21:06.89,Default,,0,0,0,,Сен әлі жұмаққа бармауың керек.
Dialogue: 0,0:21:06.97,0:21:08.72,Default,,0,0,0,,Дегенмен, бұл аянышты көрініс әдемі
Dialogue: 0,0:21:08.80,0:21:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.56,0:21:14.73,Default,,0,0,0,,Өйткені сенің жүзің әлі де өлімнен қорқады.
Dialogue: 0,0:21:14.81,0:21:15.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:19.31,0:21:20.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:25.36,0:21:28.57,Default,,0,0,0,,Бұл менің тағдырым
Dialogue: 0,0:21:30.87,0:21:32.41,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:21:34.66,0:21:39.08,Default,,0,0,0,,(Окджидің ауыр тыныс алуы)
Dialogue: 0,0:21:48.18,0:21:52.10,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:52.18,0:21:53.85,Default,,0,0,0,,Мен... қайтыс болдым.
Dialogue: 0,0:22:02.94,0:22:07.86,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:22:09.03,0:22:11.16,Default,,0,0,0,,(қарттардың күлкісі)
Dialogue: 0,0:22:11.24,0:22:14.87,Default,,0,0,0,,Крабовский мырза мейірімді.
Dialogue: 0,0:22:14.95,0:22:17.91,Default,,0,0,0,,Әрқашан сөйлесетін адам болу үшін.
Dialogue: 0,0:22:18.42,0:22:21.13,Default,,0,0,0,,Өйткені әркімнің әңгімесі қызық.
Dialogue: 0,0:22:21.21,0:22:23.55,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:22:23.63,0:22:26.76,Default,,0,0,0,,Күні кеше келген субдиакон...
Dialogue: 0,0:22:26.84,0:22:28.88,Default,,0,0,0,,Қараңдаршы, бұл кім?
Dialogue: 0,0:22:28.97,0:22:31.26,Default,,0,0,0,,Ол кісіден мүлде басқаша.
Dialogue: 0,0:22:31.34,0:22:35.47,Default,,0,0,0,,Қалада қанша жақсы болсаң да,
Dialogue: 0,0:22:35.56,0:22:37.60,Default,,0,0,0,,Жанашырлық болуы керек
Dialogue: 0,0:22:37.68,0:22:40.52,Default,,0,0,0,,Ахаха, олай айтпа.
Dialogue: 0,0:22:42.61,0:22:43.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:44.19,0:22:45.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:47.24,0:22:48.70,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:22:48.78,0:22:50.20,Default,,0,0,0,,
Dialogue: 0,0:22:51.57,0:22:52.91,Default,,0,0,0,,
Dialogue: 0,0:22:53.41,0:22:54.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:55.37,0:22:58.00,Default,,0,0,0,,Сіз тұтынушысыз, Бадени мырза.
Dialogue: 0,0:22:58.71,0:23:00.79,Default,,0,0,0,,Ондай жоспарлар жоқ па?
Dialogue: 0,0:23:01.79,0:23:04.13,Default,,0,0,0,,Тіпті...
Dialogue: 0,0:23:04.63,0:23:05.75,Default,,0,0,0,,Я...
Dialogue: 0,0:23:15.18,0:23:17.64,Default,,0,0,0,,Қайсысы? Қандай мақсатпен?
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:54.03,0:24:59.03,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.53,0:25:06.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory