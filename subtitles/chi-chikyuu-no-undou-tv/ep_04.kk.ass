Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.04,0:00:07.75,Default,,0,0,0,,Қашан қарасаң да, аспан әлемі әдемі.
Dialogue: 0,0:00:08.92,0:00:10.13,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:00:27.44,0:00:31.82,Default,,0,0,0,,Бірақ біздің әлем неге сонша лас?
Dialogue: 0,0:00:32.32,0:00:36.36,Default,,0,0,0,,Бұл Жер ғаламның орталығы болғандықтан.
Dialogue: 0,0:00:36.45,0:00:39.87,Default,,0,0,0,,Сосын мен бұл ерекше сезім сияқты боламын.
Dialogue: 0,0:00:39.95,0:00:45.37,Default,,0,0,0,,Орталық төменгі дегенді білдіреді.
Dialogue: 0,0:00:45.46,0:00:49.09,Default,,0,0,0,,Ауыр заттарды жердің кез келген жерінде кездестіруге болады
Dialogue: 0,0:00:49.17,0:00:51.84,Default,,0,0,0,,әрқашан төмен қарай түседі
Dialogue: 0,0:00:51.92,0:00:53.88,Default,,0,0,0,,Өйткені жердің орталығы
Dialogue: 0,0:00:53.97,0:00:57.39,Default,,0,0,0,,Өйткені ол ғаламның түбінде.
Dialogue: 0,0:00:57.47,0:01:01.06,Default,,0,0,0,,Құдай оны осылай жаратқан
Dialogue: 0,0:01:01.14,0:01:02.64,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:01:02.72,0:01:05.89,Default,,0,0,0,,Жер төмен және таза емес.
Dialogue: 0,0:01:06.48,0:01:12.03,Default,,0,0,0,,Бұл жерде тұратын адамдардың күшсіз және күнәкар екенін адамдарға еске салу.
Dialogue: 0,0:01:12.11,0:01:15.90,Default,,0,0,0,,Сен қараған түнгі аспан әрқашан әдемі.
Dialogue: 0,0:01:15.99,0:01:19.62,Default,,0,0,0,,Өйткені мен мына таза емес жерден қарап тұрмын.
Dialogue: 0,0:01:20.12,0:01:23.62,Default,,0,0,0,,Жер ғаламның түбінде болса
Dialogue: 0,0:01:23.70,0:01:26.79,Default,,0,0,0,,Аспандағы жұлдыздар неге түспейді?
Dialogue: 0,0:01:27.75,0:01:29.21,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:01:29.29,0:01:33.55,Default,,0,0,0,,Өйткені, адамдар бұл жер туралы ғана біледі.
Dialogue: 0,0:01:34.13,0:01:37.63,Default,,0,0,0,,Аспан әлемі асқақ, айбынды.
Dialogue: 0,0:01:37.72,0:01:39.80,Default,,0,0,0,,ұлы және кең
Dialogue: 0,0:01:39.89,0:01:43.72,Default,,0,0,0,,Төменгі жермен үйлесімді емес
Dialogue: 0,0:01:56.11,0:01:59.03,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Окудзи-кун.
Dialogue: 0,0:01:59.11,0:02:01.16,Default,,0,0,0,,А, жоқ, Мистер Гласс.
Dialogue: 0,0:02:01.78,0:02:05.45,Default,,0,0,0,,Бүгін түн ашық күн, мен жұлдыздарды жақсы көре алмаймын.
Dialogue: 0,0:02:05.54,0:02:07.46,Default,,0,0,0,,Түнгі аспан ғажап
Dialogue: 0,0:02:08.04,0:02:11.96,Default,,0,0,0,,Әр түнде өзінің мол нұрын жомарттықпен көрсетеді.
Dialogue: 0,0:02:13.92,0:02:15.51,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:02:16.05,0:02:19.18,Default,,0,0,0,,Сол көздермен түнгі аспан да таза болады.
Dialogue: 0,0:02:19.26,0:02:21.59,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:02:22.93,0:02:25.10,Default,,0,0,0,,Мен аспанға қарауға жарамсызмын
Dialogue: 0,0:02:25.18,0:02:27.27,Default,,0,0,0,,Кино түсірілім алаңында алыстан-ақ ол басты рөлдегі актерді байқады
Dialogue: 0,0:02:27.77,0:02:29.14,Default,,0,0,0,,Иә
Dialogue: 0,0:02:29.23,0:02:32.86,Default,,0,0,0,,Бүгін Оқзы-күннің осы филиалға көшкеніне бір жыл толды.
Dialogue: 0,0:02:33.44,0:02:36.07,Default,,0,0,0,,Жұмыстан кейін тойлайық
Dialogue: 0,0:02:36.15,0:02:38.15,Default,,0,0,0,,Әрине, бұл менің сыйлығым.
Dialogue: 0,0:02:38.24,0:02:40.49,Default,,0,0,0,,Ах... көп рахмет
Dialogue: 0,0:02:44.28,0:02:46.95,Default,,0,0,0,,Енді жұмысқа кірісейік.
Dialogue: 0,0:02:49.41,0:02:54.17,Default,,0,0,0,,♪~
Dialogue: 0,0:04:13.54,0:04:17.92,Default,,0,0,0,,~♪
Dialogue: 0,0:04:21.51,0:04:23.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:23.34,0:04:24.18,Default,,0,0,0,,Ах
Dialogue: 0,0:04:27.76,0:04:29.06,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:29.14,0:04:30.22,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:04:32.43,0:04:34.44,Default,,0,0,0,,Мен жеке қауіпсіздік қауымдастығының мүшесімін.
Dialogue: 0,0:04:35.06,0:04:37.61,Default,,0,0,0,,Мен сізге куә боламын.
Dialogue: 0,0:04:38.19,0:04:43.53,Default,,0,0,0,,Жеке сәйкестендіруге байланысты кек алуды болдырмау үшін бетперде киіңіз.
Dialogue: 0,0:04:46.91,0:04:49.16,Default,,0,0,0,,Ал, енді бірден бастайық.
Dialogue: 0,0:04:49.24,0:04:50.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.25,0:04:56.37,Default,,0,0,0,,Дуэльдің басталуы
Dialogue: 0,0:05:00.80,0:05:01.71,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:05:07.84,0:05:08.93,Default,,0,0,0,,Уф
Dialogue: 0,0:05:12.77,0:05:13.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:16.19,0:05:17.06,Default,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:05:17.65,0:05:20.82,Default,,0,0,0,,Мен дуэльге бірінші рет шақырған адамым граф Настура болатын.
Dialogue: 0,0:05:20.90,0:05:25.65,Default,,0,0,0,,Мен неге сен сияқты бейшара адамдармен күресуім керек?
Dialogue: 0,0:05:25.74,0:05:28.20,Default,,0,0,0,,Граф Настураның өтініші бойынша
Dialogue: 0,0:05:28.28,0:05:31.62,Default,,0,0,0,,Біз сіздің атыңыздан күресетін алмастырушы жауынгерлерміз.
Dialogue: 0,0:05:32.33,0:05:35.04,Default,,0,0,0,,Келісетініңізге сенімдімін.
Dialogue: 0,0:05:37.04,0:05:39.42,Default,,0,0,0,,Жарайды... егер мен жеңілсем...
Dialogue: 0,0:05:39.92,0:05:42.05,Default,,0,0,0,,Жеңілсең өлмейсің бе?
Dialogue: 0,0:05:42.13,0:05:44.67,Default,,0,0,0,,Иә, бұл солай.
Dialogue: 0,0:05:44.76,0:05:45.97,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:47.38,0:05:48.93,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:05:49.01,0:05:50.60,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:05:51.39,0:05:52.81,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:57.06,0:05:58.48,Default,,0,0,0,,Ах
Dialogue: 0,0:05:59.31,0:06:00.19,Default,,0,0,0,,Уау
Dialogue: 0,0:06:05.32,0:06:06.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.70,0:06:12.45,Default,,0,0,0,,Жоқ... Менің өлгім келмейді.
Dialogue: 0,0:06:13.66,0:06:17.00,Default,,0,0,0,,Иә, бұл ақша мәмілесі.
Dialogue: 0,0:06:17.08,0:06:20.12,Default,,0,0,0,,Сен... Сенің маған еш кекің жоқ, солай ма?
Dialogue: 0,0:06:20.21,0:06:22.79,Default,,0,0,0,,Біреуді өлтіру – күнә
Dialogue: 0,0:06:22.88,0:06:25.38,Default,,0,0,0,,Шындығында, сіз де мұны қаламайтын шығарсыз.
Dialogue: 0,0:06:26.09,0:06:30.01,Default,,0,0,0,,Жоқ, шынымды айтсам, бұл рас.
Dialogue: 0,0:06:30.09,0:06:31.43,Default,,0,0,0,,Сонымен… онда
Dialogue: 0,0:06:33.85,0:06:35.64,Default,,0,0,0,,Өйткені бұл жұмыс
Dialogue: 0,0:06:38.94,0:06:41.27,Default,,0,0,0,,Уф... Уау.
Dialogue: 0,0:06:43.31,0:06:46.78,Default,,0,0,0,,Тозаққа...
Dialogue: 0,0:06:46.86,0:06:48.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.24,0:06:51.70,Default,,0,0,0,,Очи... Ло...
Dialogue: 0,0:07:01.25,0:07:03.50,Default,,0,0,0,,Маған өлі денені аманат етті.
Dialogue: 0,0:07:04.00,0:07:06.42,Default,,0,0,0,,Осымен бүгінгі жұмысымыз аяқталды.
Dialogue: 0,0:07:06.50,0:07:09.26,Default,,0,0,0,,Соған қарамастан, бұл таңғаларлық реакция болды.
Dialogue: 0,0:07:09.34,0:07:11.43,Default,,0,0,0,,Жақсы көздер күткендей.
Dialogue: 0,0:07:12.01,0:07:14.30,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:07:14.39,0:07:18.77,Default,,0,0,0,,Әлде... ол жұмаққа бара алар ма еді?
Dialogue: 0,0:07:21.27,0:07:22.69,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:07:23.27,0:07:24.94,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:07:25.02,0:07:28.53,Default,,0,0,0,,Мен бұл жұмыста көп адамның өлгенін көрдім.
Dialogue: 0,0:07:29.78,0:07:33.45,Default,,0,0,0,,Бірақ ешкім риза болып өлген жоқ.
Dialogue: 0,0:07:35.32,0:07:38.54,Default,,0,0,0,,Олардың бәрі өте қорқынышты жүздермен қайтыс болды.
Dialogue: 0,0:07:39.20,0:07:42.00,Default,,0,0,0,,Мен тозақтың кіретін жерін көріп тұрғандай болдым
Dialogue: 0,0:07:43.04,0:07:45.21,Default,,0,0,0,,Мүмкін жәннатқа бара алатын адам
Dialogue: 0,0:07:45.29,0:07:47.96,Default,,0,0,0,,Бұл өте сирек емес пе?
Dialogue: 0,0:07:48.05,0:07:51.72,Default,,0,0,0,,Олай болса, көп адамды өлтірген мен өте...
Dialogue: 0,0:07:51.80,0:07:56.22,Default,,0,0,0,,Окджи-кун, бұл дүниеде саған ұнайтын нәрсе бар ма?
Dialogue: 0,0:07:56.30,0:07:57.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.81,0:07:59.81,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:08:00.43,0:08:03.90,Default,,0,0,0,,Мына арам дүниені жақсы сезіну орынсыз емес пе?
Dialogue: 0,0:08:03.98,0:08:05.73,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:08:05.81,0:08:07.61,Default,,0,0,0,,«Маған ұнайды» деген сөздің қате болуының себебі жоқ.
Dialogue: 0,0:08:08.27,0:08:13.11,Default,,0,0,0,,Бұл дүниеден күтуді қойғанда, көзді ашып-жұмғанша жан дүниеміз бұлыңғыр болады.
Dialogue: 0,0:08:13.20,0:08:18.37,Default,,0,0,0,,Ұнату, арман, үміт сияқты нәрселерді тастамаңыз!
Dialogue: 0,0:08:20.79,0:08:23.25,Default,,0,0,0,,Ал... бұл да рас.
Dialogue: 0,0:08:23.75,0:08:25.63,Default,,0,0,0,,Ойыңызды өзгертіңіз
Dialogue: 0,0:08:25.71,0:08:26.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.79,0:08:30.50,Default,,0,0,0,,Аа, кешіріңіз, мен сізді алаңдаттым.
Dialogue: 0,0:08:30.59,0:08:34.38,Default,,0,0,0,,Адал сезімдеріңізді естуге рұқсат етіңізші.
Dialogue: 0,0:08:34.47,0:08:37.30,Default,,0,0,0,,Сонымен... бұл менің пікірім емес.
Dialogue: 0,0:08:37.39,0:08:39.26,Default,,0,0,0,,Сулы емес пе?
Dialogue: 0,0:08:39.35,0:08:42.73,Default,,0,0,0,,Танысқанымызға бір жыл болды. Ұялмаңыз, келіңіз.
Dialogue: 0,0:08:49.19,0:08:52.69,Default,,0,0,0,,Егер сіз үлкен үміт күтсеңіз, көңіліңіз қалады.
Dialogue: 0,0:08:52.78,0:08:54.03,Default,,0,0,0,,Бұл менің сезімім
Dialogue: 0,0:08:54.11,0:08:56.36,Default,,0,0,0,,Егер сіз жай ғана бас тартсаңыз, ауыртпалық азырақ болар еді.
Dialogue: 0,0:08:56.45,0:08:58.37,Default,,0,0,0,,Дәлірек айтқанда, өмір деген не?
Dialogue: 0,0:08:58.45,0:09:00.62,Default,,0,0,0,,Қызықты ештеңе болмайды, солай ма?
Dialogue: 0,0:09:00.70,0:09:02.70,Default,,0,0,0,,Бұл дүниеде кім бақытты бола алады?
Dialogue: 0,0:09:02.79,0:09:05.83,Default,,0,0,0,,Тек кейбір адамдарда бұл біліктілік туғаннан бері болады.
Dialogue: 0,0:09:05.92,0:09:08.58,Default,,0,0,0,,Таңдалмағандар бақыт тілейді
Dialogue: 0,0:09:08.67,0:09:09.84,Default,,0,0,0,,Бұл мүлдем мағынасыз.
Dialogue: 0,0:09:10.42,0:09:11.34,Default,,0,0,0,,Бұл дүние бітті
Dialogue: 0,0:09:11.42,0:09:14.92,Default,,0,0,0,,Демек, үміт тек көкте.
Dialogue: 0,0:09:15.01,0:09:18.05,Default,,0,0,0,,Аспан ең жақсысы Аспанның ең жақсысы Аспанның ең жақсысы
Dialogue: 0,0:09:18.14,0:09:20.93,Default,,0,0,0,,Тез кеткім келеді Тез кеткім келеді Тез кеткім келеді
Dialogue: 0,0:09:23.47,0:09:24.48,Default,,0,0,0,,Ах
Dialogue: 0,0:09:25.77,0:09:27.44,Default,,0,0,0,,Айт...
Dialogue: 0,0:09:27.52,0:09:29.06,Default,,0,0,0,,Яғни, сіз
Dialogue: 0,0:09:29.15,0:09:34.07,Default,,0,0,0,,Бұл дүниеде мәңгілік те, кемелдік те болмағандықтан, ештеңеге сенуге болмайды дейсіз бе?
Dialogue: 0,0:09:34.15,0:09:35.95,Default,,0,0,0,,Не? Мүлдем олай айтпа...
Dialogue: 0,0:09:36.03,0:09:37.32,Default,,0,0,0,,Мен түсінемін!
Dialogue: 0,0:09:37.41,0:09:41.20,Default,,0,0,0,,Не жасырарымды білмеймін, бірақ мен де біраз бұрын солай ойладым.
Dialogue: 0,0:09:41.78,0:09:44.08,Default,,0,0,0,,Бірақ мен оны таптым.
Dialogue: 0,0:09:44.70,0:09:47.46,Default,,0,0,0,,Сіз өзіңіздің толық сенім арта аласыз деп үміттенемін.
Dialogue: 0,0:09:48.21,0:09:49.08,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:09:49.17,0:09:50.84,Default,,0,0,0,,Жоқ... арнайы
Dialogue: 0,0:09:50.92,0:09:54.05,Default,,0,0,0,,Енді неден қорқатыныңды айт.
Dialogue: 0,0:09:56.01,0:09:57.55,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:09:57.63,0:10:00.80,Default,,0,0,0,,(шулы дауыстар)
Dialogue: 0,0:10:00.89,0:10:02.05,Default,,0,0,0,,Эй, олар
Dialogue: 0,0:10:02.14,0:10:04.02,Default,,0,0,0,,Әй, қанішер.
Dialogue: 0,0:10:04.10,0:10:04.85,Default,,0,0,0,,Енді екі сусын.
Dialogue: 0,0:10:04.85,0:10:06.31,Default,,0,0,0,,Енді екі сусын.
Dialogue: 0,0:10:04.85,0:10:06.31,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:06.31,0:10:06.39,Default,,0,0,0,,Енді екі сусын.
Dialogue: 0,0:10:06.39,0:10:07.02,Default,,0,0,0,,Енді екі сусын.
Dialogue: 0,0:10:06.39,0:10:07.02,Default,,0,0,0,,(есептегішті түрту дыбысы)
Dialogue: 0,0:10:07.02,0:10:07.10,Default,,0,0,0,,(есептегішті түрту дыбысы)
Dialogue: 0,0:10:07.10,0:10:07.94,Default,,0,0,0,,(есептегішті түрту дыбысы)
Dialogue: 0,0:10:07.10,0:10:07.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:08.02,0:10:11.06,Default,,0,0,0,,Бұл жоғары санаттағы азаматтар жиі келетін дүкен.
Dialogue: 0,0:10:11.15,0:10:13.90,Default,,0,0,0,,Ауыстырушы жауынгер стилін қабылдаңыз.
Dialogue: 0,0:10:13.98,0:10:16.94,Default,,0,0,0,,Ренжіткен болсам кешіріңіз.
Dialogue: 0,0:10:17.03,0:10:21.03,Default,,0,0,0,,Дегенмен, біздің кәсіподақ бұл дүкенге кіруге және шығуға рұқсат етілген.
Dialogue: 0,0:10:21.62,0:10:23.45,Default,,0,0,0,,Біраз уақыт кешіруіңізді өтінемін.
Dialogue: 0,0:10:23.53,0:10:25.08,Default,,0,0,0,,Жоқ, Глас мырза.
Dialogue: 0,0:10:25.16,0:10:26.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:26.08,0:10:29.08,Default,,0,0,0,,Осындай адамдарға түсініктірек сөйлеу керек.
Dialogue: 0,0:10:30.83,0:10:31.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:32.29,0:10:33.79,Default,,0,0,0,,Туғаныма өкінемін Туғаныма өкінемін
Dialogue: 0,0:10:33.88,0:10:34.84,Default,,0,0,0,,Мен туғаныма өкінемін...
Dialogue: 0,0:10:34.92,0:10:37.92,Default,,0,0,0,,Жоқ... Жоқ... Тоқта! Жетеді!
Dialogue: 0,0:10:40.13,0:10:44.89,Default,,0,0,0,,Қараңызшы, осылай шын жүректен кешірім сұрасаңыз, сізге береді.
Dialogue: 0,0:10:44.97,0:10:48.48,Default,,0,0,0,,А... а, бәрібір рахмет.
Dialogue: 0,0:10:49.06,0:10:51.69,Default,,0,0,0,,Енді ертегіні жалғастырсақ.
Dialogue: 0,0:10:51.77,0:10:52.69,Default,,0,0,0,,Дәл қазір ме?
Dialogue: 0,0:10:52.77,0:10:57.53,Default,,0,0,0,,Не? Білесің бе, мен тапқан үміт туралы.
Dialogue: 0,0:10:57.61,0:11:00.45,Default,,0,0,0,,Ах... әрине есіме түсті.
Dialogue: 0,0:11:05.70,0:11:07.20,Default,,0,0,0,,Міне
Dialogue: 0,0:11:07.79,0:11:09.79,Default,,0,0,0,,Марсты бақылау жазбасы
Dialogue: 0,0:11:10.29,0:11:13.58,Default,,0,0,0,,Касей? бұл не
Dialogue: 0,0:11:13.67,0:11:15.80,Default,,0,0,0,,А, сол жерден?
Dialogue: 0,0:11:17.13,0:11:21.51,Default,,0,0,0,,Сіз әр түнде аспандағы бірдей шоқжұлдыздарды бірдей орналасумен көресіз бе?
Dialogue: 0,0:11:21.59,0:11:23.39,Default,,0,0,0,,Және ол өзгеріссіз қалады
Dialogue: 0,0:11:23.47,0:11:25.72,Default,,0,0,0,,Бір түнде шығыстан батысқа көшті
Dialogue: 0,0:11:25.81,0:11:27.77,Default,,0,0,0,,Жақында таң атады
Dialogue: 0,0:11:28.31,0:11:30.10,Default,,0,0,0,,Бірақ бір сәтте
Dialogue: 0,0:11:30.18,0:11:35.23,Default,,0,0,0,,Жұлдыздарға бей-жай қарап отырып, бір таңғаларлық фактіні байқадым.
Dialogue: 0,0:11:35.31,0:11:36.98,Default,,0,0,0,,Қандай аспан!
Dialogue: 0,0:11:37.07,0:11:40.36,Default,,0,0,0,,Кейбір жұлдыздар қозғалмайтын шоқжұлдыздардың ішінде қозғалады.
Dialogue: 0,0:11:41.36,0:11:44.12,Default,,0,0,0,,Бір түнде өте аз қозғалыс
Dialogue: 0,0:11:44.20,0:11:48.29,Default,,0,0,0,,Алайда, егер сіз оны бірнеше күн ішінде қарасаңыз, орын анық өзгереді.
Dialogue: 0,0:11:48.87,0:11:52.29,Default,,0,0,0,,Қызықты, мен монахтан сұрадым.
Dialogue: 0,0:11:52.79,0:11:55.29,Default,,0,0,0,,Сол қозғалатын жұлдыздарды планеталар деп атайды.
Dialogue: 0,0:11:55.38,0:11:58.13,Default,,0,0,0,,Аспанда 5-ке жуық бар екенін білдім.
Dialogue: 0,0:11:58.21,0:12:02.51,Default,,0,0,0,,Мен қимылды түсінуге оңай деп таптым.
Dialogue: 0,0:12:02.59,0:12:06.14,Default,,0,0,0,,Бұл жалындай қызыл болып жарқыраған Марс.
Dialogue: 0,0:12:06.22,0:12:10.14,Default,,0,0,0,,Содан кейін мен Марстың траекториясын жазуды шештім.
Dialogue: 0,0:12:10.73,0:12:12.56,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:12:12.64,0:12:16.40,Default,,0,0,0,,Марс шоқжұлдыздардың айналасында шеңбер тәрізді қозғалмайды ма?
Dialogue: 0,0:12:16.48,0:12:18.57,Default,,0,0,0,,1 ай 6 ай 1 жыл
Dialogue: 0,0:12:18.65,0:12:22.65,Default,,0,0,0,,Траектория іркілмей, ойланбастан, әрқашан шеңбер пішіні бойынша жүреді.
Dialogue: 0,0:12:22.74,0:12:26.07,Default,,0,0,0,,Тербелген шөп, ағып жатқан өзен, жыпылықтаған от
Dialogue: 0,0:12:26.16,0:12:28.87,Default,,0,0,0,,Табиғатта қозғалатын заттар көп.
Dialogue: 0,0:12:28.95,0:12:32.16,Default,,0,0,0,,Еш нәрсе соншалықты тұрақты қозғалмайды.
Dialogue: 0,0:12:32.25,0:12:34.08,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:34.17,0:12:35.88,Default,,0,0,0,,Сонда мен түсіндім
Dialogue: 0,0:12:35.96,0:12:38.75,Default,,0,0,0,,Расында да бұл жер таза емес, тәртіпсіз.
Dialogue: 0,0:12:38.84,0:12:42.01,Default,,0,0,0,,Асыл да кемел аспанға да жете алмаймын.
Dialogue: 0,0:12:42.09,0:12:46.51,Default,,0,0,0,,Бірақ! Біз де кемелді көре алмаймыз ба?
Dialogue: 0,0:12:46.59,0:12:48.80,Default,,0,0,0,,Адамдар кемелдікті тани алады
Dialogue: 0,0:12:48.89,0:12:52.48,Default,,0,0,0,,Оның үстіне Күннен айырмашылығы Марсты тікелей көруге болады.
Dialogue: 0,0:12:52.56,0:12:55.85,Default,,0,0,0,,Бұл жер тамаша бақылау үшін ерекше орын.
Dialogue: 0,0:12:55.94,0:12:59.44,Default,,0,0,0,,Осылай ойласаң, адам да, жер де тасталған жоқ.
Dialogue: 0,0:13:01.11,0:13:04.70,Default,,0,0,0,,Енді осымен біз бұл дүниедегі барлық нәрсені растай аламыз.
Dialogue: 0,0:13:04.78,0:13:07.11,Default,,0,0,0,,Ал екі жылдық бақылаудан кейін
Dialogue: 0,0:13:07.20,0:13:10.62,Default,,0,0,0,,Марстың орбитасы жақын арада бір айналымды аяқтап, сақинаны жабады.
Dialogue: 0,0:13:10.70,0:13:13.50,Default,,0,0,0,,Жақында үлкен финал келеді.
Dialogue: 0,0:13:13.58,0:13:14.58,Default,,0,0,0,,Хаха хахаха...
Dialogue: 0,0:13:14.66,0:13:17.25,Default,,0,0,0,,-ге... Эй, бұл керемет.
Dialogue: 0,0:13:17.75,0:13:19.50,Default,,0,0,0,,Бұл өте түсініксіз түсінік...
Dialogue: 0,0:13:19.59,0:13:21.42,Default,,0,0,0,,Бұл өте қисынды түсіндіру.
Dialogue: 0,0:13:21.50,0:13:22.96,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:13:23.05,0:13:25.30,Default,,0,0,0,,Сіз бұл қиын деп айта аласыз ба?
Dialogue: 0,0:13:25.80,0:13:28.72,Default,,0,0,0,,Марстың орбитасы тамаша шеңбер ме?
Dialogue: 0,0:13:28.80,0:13:32.56,Default,,0,0,0,,Мен күткендей, төменгі топтағы азаматтардың білімінің жоқтығына қызғанышпен қараймын.
Dialogue: 0,0:13:33.06,0:13:36.52,Default,,0,0,0,,Сізбен ертерек хабарласқаным үшін кешірім сұраймын.
Dialogue: 0,0:13:36.60,0:13:39.61,Default,,0,0,0,,Не істесең де, менің сезімімді ала алмайсың.
Dialogue: 0,0:13:39.69,0:13:41.48,Default,,0,0,0,,Қалағаныңызша күліңіз
Dialogue: 0,0:13:41.57,0:13:44.36,Default,,0,0,0,,Жоқ, жоқ, кедергі жасағаным үшін менің кінәм болды.
Dialogue: 0,0:13:44.44,0:13:46.45,Default,,0,0,0,,Тек ләззат алыңыз.
Dialogue: 0,0:13:47.20,0:13:50.70,Default,,0,0,0,,Алайда бақылаудың уақыты дұрыс болмады.
Dialogue: 0,0:13:50.78,0:13:53.95,Default,,0,0,0,,Әйтпесе, ертерек байқаған болар едім.
Dialogue: 0,0:13:54.04,0:13:56.71,Default,,0,0,0,,Әй, орынды нәрсе.
Dialogue: 0,0:14:00.88,0:14:02.80,Default,,0,0,0,,А... бұл мүмкін емес.
Dialogue: 0,0:14:02.88,0:14:04.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:05.30,0:14:06.80,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:14:07.93,0:14:12.43,Default,,0,0,0,,Күн сайын... Екі жыл бойы күн сайын қозғалдым.
Dialogue: 0,0:14:13.31,0:14:18.23,Default,,0,0,0,,Алайда менің қозғалыс жылдамдығым соңғы кездері қатты баяулап барады...
Dialogue: 0,0:14:19.35,0:14:23.23,Default,,0,0,0,,Марс бүгін ақыры тоқтады.
Dialogue: 0,0:14:23.32,0:14:24.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.53,0:14:27.32,Default,,0,0,0,,Кешеден бері мүлде қозғалған жоқ.
Dialogue: 0,0:14:27.95,0:14:29.82,Default,,0,0,0,,Бұл неліктен болып жатыр?
Dialogue: 0,0:14:30.99,0:14:35.24,Default,,0,0,0,,Оған екі жыл қажет болды, бірақ ол аяқталмай тұрып.
Dialogue: 0,0:14:35.74,0:14:39.21,Default,,0,0,0,,Неліктен... неге
Dialogue: 0,0:14:43.25,0:14:45.88,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,0:14:45.88,0:14:47.80,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,0:14:45.88,0:14:47.80,Default,,0,0,0,,Сәлем Окзы
Dialogue: 0,0:14:47.80,0:14:48.76,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,0:14:48.84,0:14:50.63,Default,,0,0,0,,Жұмыс бітті ме?
Dialogue: 0,0:14:50.72,0:14:53.76,Default,,0,0,0,,А... жоқ, бұл болғалы тұр.
Dialogue: 0,0:14:53.85,0:14:55.72,Default,,0,0,0,,Бірақ бұл қиын.
Dialogue: 0,0:14:55.81,0:14:58.77,Default,,0,0,0,,Мен Гласс сияқты оғашпен жұптастым.
Dialogue: 0,0:14:58.85,0:15:02.40,Default,,0,0,0,,Жоқ... Жоқ, сіз әрқашан позитивті адамсыз.
Dialogue: 0,0:15:02.48,0:15:03.81,Default,,0,0,0,,Өйткені бұл оң!
Dialogue: 0,0:15:03.90,0:15:05.19,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:15:07.11,0:15:11.28,Default,,0,0,0,,Шыны бұрын қарапайым жігіт болған.
Dialogue: 0,0:15:11.36,0:15:13.82,Default,,0,0,0,,Жиі шағымданбаңыз.
Dialogue: 0,0:15:14.33,0:15:19.25,Default,,0,0,0,,Бір күні менің бүкіл отбасым індеттен қайтыс болды.
Dialogue: 0,0:15:19.33,0:15:21.75,Default,,0,0,0,,Оның үстіне, үмітсіздікте
Dialogue: 0,0:15:21.83,0:15:24.88,Default,,0,0,0,,Мен де өмірімді аяқтауға тырыстым.
Dialogue: 0,0:15:24.96,0:15:28.01,Default,,0,0,0,,Сонымен... осындай трагедия.
Dialogue: 0,0:15:29.34,0:15:33.01,Default,,0,0,0,,Ең үлкен қасірет сол жерде өле алмадым.
Dialogue: 0,0:15:35.72,0:15:38.52,Default,,0,0,0,,Сол күнә шіркеуде кешірілді, бірақ
Dialogue: 0,0:15:38.60,0:15:42.02,Default,,0,0,0,,Шыны керек, өле алмағанына өкінді.
Dialogue: 0,0:15:42.10,0:15:45.61,Default,,0,0,0,,«Бұл менің тағдырым ба?»
Dialogue: 0,0:15:46.11,0:15:50.24,Default,,0,0,0,,Бірақ соңғы бір-екі жылдың ішінде кенет жарқырай бастады.
Dialogue: 0,0:15:50.32,0:15:53.86,Default,,0,0,0,,Аударманы естігенде, бақылауға кірістім деді.
Dialogue: 0,0:15:53.95,0:15:57.99,Default,,0,0,0,,«Бұл аспаннан келген отбасылық хабар» деген сияқты сөздерді айтпаңыз.
Dialogue: 0,0:15:58.08,0:15:59.91,Default,,0,0,0,,Оны да тесіп өтесің бе?
Dialogue: 0,0:16:00.00,0:16:03.25,Default,,0,0,0,,Сіз соншалықты тұрақсыз нәрсемен не істеріңізді білмейсіз.
Dialogue: 0,0:16:05.33,0:16:10.46,Default,,0,0,0,,Ұнату, арман, үміт сияқты нәрселерді тастамаңыз!
Dialogue: 0,0:16:12.88,0:16:13.72,Default,,0,0,0,,Ах
Dialogue: 0,0:16:13.80,0:16:15.51,Default,,0,0,0,,(Гласстың дірілдеген дауысы)
Dialogue: 0,0:16:15.59,0:16:18.60,Default,,0,0,0,,А... Хахаха...
Dialogue: 0,0:16:20.35,0:16:21.60,Default,,0,0,0,,иілген
Dialogue: 0,0:16:22.10,0:16:23.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.73,0:16:27.15,Default,,0,0,0,,келесі күнге қарай иілді
Dialogue: 0,0:16:27.23,0:16:28.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.61,0:16:32.49,Default,,0,0,0,,Керемет шеңбер бұзылған
Dialogue: 0,0:16:32.99,0:16:35.82,Default,,0,0,0,,ұсқынсыз және бұрмаланған
Dialogue: 0,0:16:35.91,0:16:36.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:39.37,0:16:44.00,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:16:44.08,0:16:48.59,Default,,0,0,0,,Бұл менің тағдырым ба?
Dialogue: 0,0:16:57.01,0:16:57.93,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:58.01,0:17:00.47,Default,,0,0,0,,Олай болса барайық.
Dialogue: 0,0:17:04.06,0:17:06.19,Default,,0,0,0,,Бүгін бақылаулар жоқ па?
Dialogue: 0,0:17:06.27,0:17:07.81,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:08.31,0:17:13.19,Default,,0,0,0,,Дұрыс айтасыз, мен бұл дүниеде аспаннан басқа ешнәрсе күтпеймін.
Dialogue: 0,0:17:13.28,0:17:15.49,Default,,0,0,0,,Мен қателескен шығармын деп ойладым.
Dialogue: 0,0:17:15.57,0:17:17.95,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,0:17:18.03,0:17:20.78,Default,,0,0,0,,Ал, бүгінгі жұмыс...
Dialogue: 0,0:17:21.79,0:17:25.08,Default,,0,0,0,,Бұл әдеттен тыс. Бұл бидғатшылардың тасымалдауын күзетеді ме?
Dialogue: 0,0:17:25.16,0:17:27.08,Default,,0,0,0,,Мен... еретик пе?
Dialogue: 0,0:17:27.17,0:17:29.63,Default,,0,0,0,,Шайтанмен байланыста болуы мүмкін
Dialogue: 0,0:17:29.71,0:17:31.00,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:17:31.09,0:17:32.13,Default,,0,0,0,,А...
Dialogue: 0,0:17:32.67,0:17:35.34,Default,,0,0,0,,Сіз жеке қауіпсіздік одағының мүшесісіз бе?
Dialogue: 0,0:17:37.63,0:17:40.47,Default,,0,0,0,,Бұл Дэмиен, инквизитор.
Dialogue: 0,0:17:52.44,0:17:55.36,Default,,0,0,0,,Жеке қауіпсіздік одағы келді
Dialogue: 0,0:17:55.44,0:17:58.11,Default,,0,0,0,,Біз де барайық, Новак мырза.
Dialogue: 0,0:17:58.70,0:18:00.16,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:18:00.24,0:18:01.70,Default,,0,0,0,,Тұмар
Dialogue: 0,0:18:02.24,0:18:03.62,Default,,0,0,0,,
Dialogue: 0,0:18:04.37,0:18:07.33,Default,,0,0,0,,Бұл лас жұмыстың басы ма?
Dialogue: 0,0:18:07.41,0:18:11.08,Default,,0,0,0,,(қатты жаңбыр дыбысы)
Dialogue: 0,0:18:14.09,0:18:15.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:15.38,0:18:17.55,Default,,0,0,0,,Мен маскамды шешсем бола ма?
Dialogue: 0,0:18:17.63,0:18:18.80,Default,,0,0,0,,Ах
Dialogue: 0,0:18:19.59,0:18:22.68,Default,,0,0,0,,Өлейін деп жатқан адасушы көрсе де, қиналмаймын.
Dialogue: 0,0:18:23.31,0:18:25.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.23,0:18:28.52,Default,,0,0,0,,Сонда да жаңбыр дегеніміз не?
Dialogue: 0,0:18:28.60,0:18:30.77,Default,,0,0,0,,Аспанды көрмесең жақсы емес
Dialogue: 0,0:18:36.28,0:18:38.95,Default,,0,0,0,,Аспанға қызықпайсың ба?
Dialogue: 0,0:18:39.45,0:18:41.95,Default,,0,0,0,,Жұлдыздарға қарау жақсы
Dialogue: 0,0:18:43.28,0:18:44.28,Default,,0,0,0,,Біз
Dialogue: 0,0:18:44.37,0:18:46.95,Default,,0,0,0,,Сізбен сөйлеспеу - бұл ереже.
Dialogue: 0,0:18:47.04,0:18:49.12,Default,,0,0,0,,Өтінемін, тыныш отыра аласыз ба?
Dialogue: 0,0:18:49.83,0:18:52.46,Default,,0,0,0,,Бас тартсам, мені ұрып-соғады ма?
Dialogue: 0,0:18:52.54,0:18:56.38,Default,,0,0,0,,Жоқ, шынымды айтсам, мен оны аяймын, ұрғым келмейді.
Dialogue: 0,0:18:56.88,0:19:00.47,Default,,0,0,0,,Неге адамзатты құтқаратын шіркеуге шабуыл жасайсың?
Dialogue: 0,0:19:00.55,0:19:04.89,Default,,0,0,0,,Неліктен жұмаққа баруға кедергі болатын нәрсені жасайсың?
Dialogue: 0,0:19:05.81,0:19:09.52,Default,,0,0,0,,Кешіріңіз, бірақ сіз өлім жазасынан құтыла алмайсыз.
Dialogue: 0,0:19:09.60,0:19:13.69,Default,,0,0,0,,Әйтсе де, неге қазір қайта қарап, өкінбейсіз?
Dialogue: 0,0:19:13.77,0:19:16.36,Default,,0,0,0,,Я, бұл мейірімді.
Dialogue: 0,0:19:16.86,0:19:20.70,Default,,0,0,0,,Бірақ балалар, қайта ойлану керек емес пе?
Dialogue: 0,0:19:20.78,0:19:24.12,Default,,0,0,0,,Шіркеу сізді шынымен құтқара ма?
Dialogue: 0,0:19:24.20,0:19:29.08,Default,,0,0,0,,Олар айтып отырған аспан шынымен бар ма?
Dialogue: 0,0:19:29.16,0:19:30.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:30.91,0:19:34.54,Default,,0,0,0,,Әй, сен дінбұзар болғанда түсінбейсің.
Dialogue: 0,0:19:34.63,0:19:38.17,Default,,0,0,0,,Сендер не білесіңдер?
Dialogue: 0,0:19:38.67,0:19:42.47,Default,,0,0,0,,Сізді бұл дүниенің үмітсіздігінен алшақтату үшін
Dialogue: 0,0:19:42.55,0:19:46.51,Default,,0,0,0,,Бар-жоғын білмейтін аспанға қашып бара жатқан жоқсың ба?
Dialogue: 0,0:19:47.43,0:19:50.31,Default,,0,0,0,,Я, мен сенің нені көздегеніңді білемін.
Dialogue: 0,0:19:50.39,0:19:52.81,Default,,0,0,0,,Мазасыздықты осылай қоздырасың
Dialogue: 0,0:19:52.90,0:19:55.98,Default,,0,0,0,,Бізді үмітсіздікке итергіңіз келе ме?
Dialogue: 0,0:19:56.52,0:19:57.82,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:58.40,0:20:01.82,Default,,0,0,0,,Үмітсіздікті итеріп жіберетін сенсің.
Dialogue: 0,0:20:03.28,0:20:07.62,Default,,0,0,0,,2000 жыл бұрын афиналық кәрі адам уланған ыдысты желдетіп жіберді.
Dialogue: 0,0:20:07.70,0:20:10.33,Default,,0,0,0,,Қазіргі философия дүниеге келді
Dialogue: 0,0:20:10.41,0:20:11.91,Default,,0,0,0,,1500 жыл бұрын
Dialogue: 0,0:20:12.00,0:20:14.96,Default,,0,0,0,,Айқышқа шегеленген жас жігіттің өкініші
Dialogue: 0,0:20:15.04,0:20:17.84,Default,,0,0,0,,Қазіргі шіркеуді қалыптастырды
Dialogue: 0,0:20:17.92,0:20:20.17,Default,,0,0,0,,Адамдар трагедиямен қоректенеді
Dialogue: 0,0:20:20.26,0:20:23.09,Default,,0,0,0,,Анда-санда жаңа үміт тудырады
Dialogue: 0,0:20:24.43,0:20:28.68,Default,,0,0,0,,Уақытша жайлылық шындықты өзгертпейді
Dialogue: 0,0:20:28.76,0:20:31.43,Default,,0,0,0,,Бірақ өзегінен көтерілген азап
Dialogue: 0,0:20:31.52,0:20:33.19,Default,,0,0,0,,Қайнаған көңілсіздік
Dialogue: 0,0:20:33.27,0:20:35.77,Default,,0,0,0,,Немесе сіздің үмітсіздігіңіз
Dialogue: 0,0:20:35.85,0:20:38.32,Default,,0,0,0,,Оны үмітке айналдыруға болады.
Dialogue: 0,0:20:38.40,0:20:41.44,Default,,0,0,0,,Сонда да үмітсіз көзіңді жұмып қаласың
Dialogue: 0,0:20:41.53,0:20:45.28,Default,,0,0,0,,Маған біреу сыйлаған өлгеннен кейін кепілдендірілген өмір сүру
Dialogue: 0,0:20:45.36,0:20:48.83,Default,,0,0,0,,Ондай адамға үміт жоқ.
Dialogue: 0,0:20:49.33,0:20:50.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:50.79,0:20:54.33,Default,,0,0,0,,Үндемей қалсаң, бос сөз айтасың! ештеңе білмеймін
Dialogue: 0,0:20:54.41,0:20:56.38,Default,,0,0,0,,Мистер Гласс, сабыр етіңіз.
Dialogue: 0,0:20:56.46,0:20:58.42,Default,,0,0,0,,Бұл еретикалық жоспар болуы мүмкін
Dialogue: 0,0:20:58.50,0:21:00.88,Default,,0,0,0,,Иә, бидғат?
Dialogue: 0,0:21:00.96,0:21:05.34,Default,,0,0,0,,Мен сізді осылай атайтын адамнан неге қорқатыныңызды түсінемін.
Dialogue: 0,0:21:05.43,0:21:08.89,Default,,0,0,0,,Бұл мені түсінбегендіктен емес
Dialogue: 0,0:21:08.97,0:21:10.35,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:21:10.89,0:21:16.35,Default,,0,0,0,,Өйткені сен көкке толық сенбейсің.
Dialogue: 0,0:21:16.44,0:21:18.73,Default,,0,0,0,,Өзімшіл ештеңе айтпа
Dialogue: 0,0:21:18.81,0:21:23.40,Default,,0,0,0,,«Шын мәнінде, аспан жоқ, мүмкін сіз өлетін шығарсыз».
Dialogue: 0,0:21:23.49,0:21:25.11,Default,,0,0,0,,Сіз осылай ойлайсыз, солай ма?
Dialogue: 0,0:21:25.20,0:21:26.61,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:21:26.70,0:21:29.03,Default,,0,0,0,,Мен сіздің неліктен мазасызданғаныңызды түсіндім.
Dialogue: 0,0:21:29.12,0:21:31.87,Default,,0,0,0,,Өлгеннен кейін жоспарларыңызды өзгерту ауыр болуы керек.
Dialogue: 0,0:21:31.95,0:21:33.75,Default,,0,0,0,,Өтінемін, қазір үндемеңіз.
Dialogue: 0,0:21:33.83,0:21:35.33,Default,,0,0,0,,Бірақ сіз
Dialogue: 0,0:21:35.41,0:21:38.38,Default,,0,0,0,,Жоқ, адамзат онымен бетпе-бет келуі керек.
Dialogue: 0,0:21:38.46,0:21:39.50,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:21:39.58,0:21:44.42,Default,,0,0,0,,Әдемі аспан туралы жұмбақ болмауы мүмкін.
Dialogue: 0,0:21:45.01,0:21:46.80,Default,,0,0,0,,Сіз мені тоқтатуымды өтініп тұрсыз!
Dialogue: 0,0:21:48.93,0:21:49.85,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:49.93,0:21:54.27,Default,,0,0,0,,Бұл жер аспаннан да әдемі.
Dialogue: 0,0:21:55.23,0:21:56.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:57.02,0:21:59.31,Default,,0,0,0,,Не... сен не ақымақсың?
Dialogue: 0,0:21:59.40,0:22:02.07,Default,,0,0,0,,Сіз шынымен сенгіңіз келеді, солай емес пе?
Dialogue: 0,0:22:02.69,0:22:07.28,Default,,0,0,0,,Бұл жер өмір сүруге тұрарлық керемет нәрсе.
Dialogue: 0,0:22:08.99,0:22:09.91,Default,,0,0,0,,Иә
Dialogue: 0,0:22:10.41,0:22:13.08,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:22:13.16,0:22:14.70,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:22:14.79,0:22:18.17,Default,,0,0,0,,Сабырмен ойласаңыз, мұның бәрі негізсіз адасушылық.
Dialogue: 0,0:22:18.67,0:22:20.04,Default,,0,0,0,,Дәлел бар
Dialogue: 0,0:22:20.13,0:22:21.71,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:21.79,0:22:23.96,Default,,0,0,0,,Болса да, қазір жоқ.
Dialogue: 0,0:22:24.05,0:22:26.47,Default,,0,0,0,,Жоқ, ол қазір осында.
Dialogue: 0,0:22:27.38,0:22:30.22,Default,,0,0,0,,Мен сол жақтағы тауды көріп тұрмын.
Dialogue: 0,0:22:30.93,0:22:32.80,Default,,0,0,0,,Барлық дәлелдер
Dialogue: 0,0:22:32.89,0:22:36.43,Default,,0,0,0,,Жарты жолдағы тас жәшікте.
Dialogue: 0,0:22:37.43,0:22:40.85,Default,,0,0,0,,Енді жағдайды түсіндің бе?
Dialogue: 0,0:22:41.44,0:22:45.15,Default,,0,0,0,,Бүгін кешке, балалар, біраз уақытқа.
Dialogue: 0,0:22:45.23,0:22:47.11,Default,,0,0,0,,Өмірімде бірінші рет болған шығар
Dialogue: 0,0:22:47.19,0:22:51.16,Default,,0,0,0,,Өз тағдырын өзгертуге қарсы шығуға құқығы бар
Dialogue: 0,0:22:51.24,0:22:52.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:52.16,0:22:55.29,Default,,0,0,0,,Сіз өміріңіздің соңына дейін өзіңізге ыңғайлы түрде бас тартасыз ба?
Dialogue: 0,0:22:55.37,0:22:59.37,Default,,0,0,0,,Мен бәрін тастап, өзін-өзі растау үшін құмар ойнауым керек пе?
Dialogue: 0,0:22:59.46,0:23:02.58,Default,,0,0,0,,Сіз таңдай аласыз
Dialogue: 0,0:23:02.67,0:23:05.17,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:23:06.92,0:23:08.88,Default,,0,0,0,,Не... білмеймін...
Dialogue: 0,0:23:11.47,0:23:12.84,Default,,0,0,0,,А...
Dialogue: 0,0:23:18.98,0:23:19.98,Default,,0,0,0,,Ах
Dialogue: 0,0:23:20.06,0:23:20.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:22.90,0:23:24.15,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:23:30.99,0:23:35.99,Default,,0,0,0,,♪~
Dialogue: 0,0:24:53.95,0:24:58.95,Default,,0,0,0,,~♪
Dialogue: 0,0:25:00.45,0:25:06.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory