Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.35,0:00:27.61,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:37.28,0:00:42.50,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:00:44.12,0:00:44.96,Default,,0,0,0,,Уф
Dialogue: 0,0:00:45.29,0:00:47.63,Default,,0,0,0,,Хахаха
Dialogue: 0,0:00:54.34,0:00:56.59,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:13.03,0:01:18.03,Default,,0,0,0,,(Судың жақындаған дыбысы)
Dialogue: 0,0:01:27.08,0:01:32.84,Default,,0,0,0,,♪～
Dialogue: 0,0:01:43.06,0:01:45.68,Default,,0,0,0,,Майор Эй майор
Dialogue: 0,0:01:48.10,0:01:50.36,Default,,0,0,0,,Қазір бұл не? Бұл виртуалды шындық па?
Dialogue: 0,0:01:50.48,0:01:54.15,Default,,0,0,0,,Мен демалыстамын. Кибер лоббиге кездейсоқ кірмеңіз.
Dialogue: 0,0:01:54.28,0:01:55.90,Default,,0,0,0,,Көңіл айтуыңызға рахмет
Dialogue: 0,0:01:56.44,0:01:57.90,Default,,0,0,0,,Нишинучидегі бомбалы лаңкестік әрекет
Dialogue: 0,0:01:58.03,0:02:00.49,Default,,0,0,0,,Жәбірленуші – шетелдік су компаниясының басшысы
Dialogue: 0,0:02:00.62,0:02:03.87,Default,,0,0,0,,Өнеркәсіп министрлігінің қызметкерлері Отандық қару өндірушілер
Dialogue: 0,0:02:04.74,0:02:09.83,Default,,0,0,0,,Қоғамдық қауіпсіздікке майор ұсынған лаңкестік болжам тізіміндегі бірінші кезектегі тармақ дұрыс.
Dialogue: 0,0:02:10.33,0:02:13.50,Default,,0,0,0,,Су құны туралы келісім бойынша құпия жиналыс.
Dialogue: 0,0:02:13.63,0:02:15.80,Default,,0,0,0,,Сыртқы істер министрлігінің бүкіл гвардиясы бөлінген.
Dialogue: 0,0:02:17.13,0:02:19.80,Default,,0,0,0,,Яманоте бөгетінде де жарылыс болды.
Dialogue: 0,0:02:19.93,0:02:20.76,Default,,0,0,0,,Бөгет?
Dialogue: 0,0:02:20.84,0:02:24.35,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:02:24.47,0:02:26.22,Default,,0,0,0,,Сәйкестігі белгісіз
Dialogue: 0,0:02:26.35,0:02:31.77,Default,,0,0,0,,Дегенмен, ол Индустрия министрлігіне тиесілі және іс жүзінде шетелдік су компаниясына тиесілі.
Dialogue: 0,0:02:35.32,0:02:38.40,Default,,0,0,0,,Бұл бюрократтардың арасындағы шиеленіс соғыстары қатал болатын сала.
Dialogue: 0,0:02:40.16,0:02:42.57,Default,,0,0,0,,Бізден сұрау қайда?
Dialogue: 0,0:02:42.87,0:02:44.53,Default,,0,0,0,,Қоғамдық қауіпсіздік бөлімі 9
Dialogue: 0,0:02:45.45,0:02:49.25,Default,,0,0,0,,Майор тізімді пайдаланбағанына қарамастан, қылмыскер ізіне түсті.
Dialogue: 0,0:02:49.37,0:02:52.54,Default,,0,0,0,,Бірақ соңында қаруланудағы айырмашылыққа байланысты олар оны қамтамасыз ете алмады.
Dialogue: 0,0:02:54.59,0:02:55.50,Default,,0,0,0,,Ах! ?
Dialogue: 0,0:02:55.63,0:02:57.05,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:02:57.59,0:03:00.51,Default,,0,0,0,,Барлығын шақыр, мен де барамын.
Dialogue: 0,0:03:01.34,0:03:02.89,Default,,0,0,0,,Сіз жұмыс істейсіз бе?
Dialogue: 0,0:03:05.43,0:03:06.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:07.31,0:03:08.73,Default,,0,0,0,,5 сағат 7 минут
Dialogue: 0,0:03:09.52,0:03:11.98,Default,,0,0,0,,Бұл сіздің демалыстағы ең ұзақ рекордыңыз.
Dialogue: 0,0:03:12.10,0:03:14.06,Default,,0,0,0,,Бүгінгі кеңес полиция ма?
Dialogue: 0,0:03:14.19,0:03:16.11,Default,,0,0,0,,Әлде кибер даму бюросы ма?
Dialogue: 0,0:03:17.40,0:03:19.40,Default,,0,0,0,,Мен мұның орнын толтырамын.
Dialogue: 0,0:03:19.86,0:03:21.74,Default,,0,0,0,,Мысалды ұмытпаңыз
Dialogue: 0,0:03:21.86,0:03:24.03,Default,,0,0,0,,О... шын айтасың ба?
Dialogue: 0,0:03:24.16,0:03:25.03,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:25.16,0:03:27.54,Default,,0,0,0,,Тез кеткеніңіз жөн.
Dialogue: 0,0:03:27.66,0:03:30.00,Default,,0,0,0,,Олардың барлығы ашушаң тұтынушылар ма?
Dialogue: 0,0:03:31.62,0:03:32.46,Default,,0,0,0,,Иә
Dialogue: 0,0:03:32.96,0:03:36.09,Default,,0,0,0,,Ол жігітпен жүргеніңізге үш ай болды.
Dialogue: 0,0:03:36.21,0:03:37.75,Default,,0,0,0,,Жазба жаңартылды
Dialogue: 0,0:03:37.88,0:03:39.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:42.01,0:03:45.30,Default,,0,0,0,,Елес енгізу пернелерін кездейсоқ пайдаланбаңыз
Dialogue: 0,0:03:49.27,0:03:55.27,Default,,0,0,0,,♪～
Dialogue: 0,0:04:53.75,0:04:57.54,Default,,0,0,0,,Мен полиция бөлімшесінен сұрағанымда, олар бұл детектив Наохару Мизуки екенін айтты.
Dialogue: 0,0:04:57.83,0:04:58.96,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:04:59.63,0:05:02.30,Default,,0,0,0,,Әй, аға.
Dialogue: 0,0:05:07.93,0:05:09.89,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:05:10.18,0:05:11.81,Default,,0,0,0,,Сізде бар нәрсе осы ма?
Dialogue: 0,0:05:12.22,0:05:13.77,Default,,0,0,0,,Қалта бос болды
Dialogue: 0,0:05:14.52,0:05:17.23,Default,,0,0,0,,Оны су шайып кетті ме? Оны біреу ұрлаған ба?
Dialogue: 0,0:05:17.65,0:05:20.15,Default,,0,0,0,,Қалтаңыздағы мылтық шайылып кететінін елестету қиын.
Dialogue: 0,0:05:20.65,0:05:23.61,Default,,0,0,0,,Әмияныңыз қауіпсіз болса, мылтықты алсаңыз, біртүрлі болар еді.
Dialogue: 0,0:05:23.74,0:05:24.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.99,0:05:31.74,Default,,0,0,0,,«Техник протездеушісі»…
Dialogue: 0,0:05:31.87,0:05:32.79,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:05:33.33,0:05:35.66,Default,,0,0,0,,Бұл протездік мәйітке ұқсамайды.
Dialogue: 0,0:05:35.79,0:05:39.25,Default,,0,0,0,,Лейтенант, сіз жақын маңдағы жоғалған заттарды жинап, басқарып жатырсыз ба?
Dialogue: 0,0:05:39.33,0:05:41.79,Default,,0,0,0,,Оған байланысты басқа нәрселерді іздеңіз
Dialogue: 0,0:05:41.92,0:05:43.71,Default,,0,0,0,,Сіз тапсырмаларды орындауға тырысасыз ба?
Dialogue: 0,0:05:43.84,0:05:46.34,Default,,0,0,0,,Егер бөгет оқиғасы нағыз апат болса ше?
Dialogue: 0,0:05:46.47,0:05:47.76,Default,,0,0,0,,Инспектор
Dialogue: 0,0:05:48.47,0:05:50.01,Default,,0,0,0,,Мен біртүрлі нәрсе таптым
Dialogue: 0,0:05:53.64,0:05:55.02,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:05:55.14,0:05:56.43,Default,,0,0,0,,Бұл протездік денеге ұқсайды...
Dialogue: 0,0:06:05.86,0:06:07.99,Default,,0,0,0,,Су перісі аяқтары…
Dialogue: 0,0:06:15.33,0:06:16.20,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:06:17.79,0:06:21.67,Default,,0,0,0,,Көптеген полиция қызметкерлері жарақат алды, 6 қылмыскер әлі тірі
Dialogue: 0,0:06:22.00,0:06:23.67,Default,,0,0,0,,4-ауданға көшу
Dialogue: 0,0:06:23.80,0:06:26.13,Default,,0,0,0,,Сіз полицияның қимылдарын тамаша оқисыз.
Dialogue: 0,0:06:26.38,0:06:29.34,Default,,0,0,0,,Қашу жолын бекіткеннен кейін шегіну әрекеті
Dialogue: 0,0:06:29.68,0:06:31.80,Default,,0,0,0,,Олар өте жақсы дайындалған.
Dialogue: 0,0:06:32.22,0:06:34.76,Default,,0,0,0,,Бір жерде операция командирі Ишикава бар.
Dialogue: 0,0:06:37.60,0:06:39.27,Default,,0,0,0,,Олардың сызығын ұстады
Dialogue: 0,0:06:43.06,0:06:45.90,Default,,0,0,0,,Жетінші адам, бұл бас.
Dialogue: 0,0:06:46.32,0:06:52.32,Default,,0,0,0,,♪～
Dialogue: 0,0:07:02.21,0:07:03.33,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:07:05.55,0:07:06.67,Default,,0,0,0,,Ууууууууууууууууууууууу
Dialogue: 0,0:07:07.30,0:07:08.17,Default,,0,0,0,,Гуаа!
Dialogue: 0,0:07:10.26,0:07:11.76,Default,,0,0,0,,Гуа!
Dialogue: 0,0:07:12.30,0:07:13.93,Default,,0,0,0,,Уф!Уф...
Dialogue: 0,0:07:14.39,0:07:15.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:16.51,0:07:17.35,Default,,0,0,0,,Гуах
Dialogue: 0,0:07:18.10,0:07:21.06,Default,,0,0,0,,Бұл ең соңғы Ghost Rock. Бекер қарсылық көрсетпе.
Dialogue: 0,0:07:23.15,0:07:25.11,Default,,0,0,0,,Одақтастарыңызға берілуге бұйрық беріңіз
Dialogue: 0,0:07:25.23,0:07:28.03,Default,,0,0,0,,Ишикава Мәжбүрлеп тану бағдарламасын іске қосыңыз
Dialogue: 0,0:07:28.15,0:07:28.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:30.36,0:07:31.40,Default,,0,0,0,,Жұмысты тоқтату
Dialogue: 0,0:07:31.70,0:07:33.07,Default,,0,0,0,,Мылтықты тастап, беріл.
Dialogue: 0,0:07:33.20,0:07:34.45,Default,,0,0,0,,А... (Партизан 3) Мм...
Dialogue: 0,0:07:34.57,0:07:37.37,Default,,0,0,0,,Қайталанатын операцияны тоқтату
Dialogue: 0,0:07:37.79,0:07:39.16,Default,,0,0,0,,Бағыну
Dialogue: 0,0:07:42.58,0:07:44.04,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:07:46.67,0:07:48.59,Default,,0,0,0,,Донпачи жоқ па?
Dialogue: 0,0:07:50.30,0:07:52.55,Default,,0,0,0,,Мен оны ұстадым!
Dialogue: 0,0:07:52.93,0:07:56.89,Default,,0,0,0,,Уа, сен өте пайдалысың.
Dialogue: 0,0:07:57.01,0:07:58.26,Default,,0,0,0,,Эххе
Dialogue: 0,0:07:58.56,0:08:00.39,Default,,0,0,0,,Соңғы адамды тұтқынға алды
Dialogue: 0,0:08:00.52,0:08:03.10,Default,,0,0,0,,Жарайды, барлығың қоғамдық қауіпсіздікке тапсырыңдар.
Dialogue: 0,0:08:03.10,0:08:03.48,Default,,0,0,0,,Жарайды, барлығың қоғамдық қауіпсіздікке тапсырыңдар.
Dialogue: 0,0:08:03.10,0:08:03.48,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:03.48,0:08:03.60,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:03.60,0:08:04.65,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:03.60,0:08:04.65,Default,,0,0,0,,Га
Dialogue: 0,0:08:04.65,0:08:05.61,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:05.61,0:08:07.40,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:05.61,0:08:07.40,Default,,0,0,0,,Инфекция туралы ескерту?
Dialogue: 0,0:08:07.40,0:08:08.02,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:08:09.90,0:08:11.24,Default,,0,0,0,,Сіз ұстап алған адам!
Dialogue: 0,0:08:14.91,0:08:17.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:18.99,0:08:22.66,Default,,0,0,0,,Уф! Ах... уф
Dialogue: 0,0:08:23.71,0:08:24.83,Default,,0,0,0,,Иә! Ха...
Dialogue: 0,0:08:26.71,0:08:27.75,Default,,0,0,0,,Бұл ауырсыну...
Dialogue: 0,0:08:29.55,0:08:30.21,Default,,0,0,0,,Құт
Dialogue: 0,0:08:34.55,0:08:36.39,Default,,0,0,0,,Ghost құлпы сынған ба?
Dialogue: 0,0:08:37.51,0:08:38.35,Default,,0,0,0,,Майор! ?
Dialogue: 0,0:08:38.47,0:08:39.30,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:08:39.43,0:08:40.56,Default,,0,0,0,,Сайт! (Сайт) Ах!
Dialogue: 0,0:08:41.18,0:08:42.02,Default,,0,0,0,,Уф
Dialogue: 0,0:08:44.39,0:08:45.98,Default,,0,0,0,,Мені өлтірме! (Сайт) Ug…
Dialogue: 0,0:08:46.06,0:08:47.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:57.11,0:08:59.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:59.95,0:09:01.79,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:09:06.62,0:09:07.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:14.38,0:09:15.84,Default,,0,0,0,,Осымен
Dialogue: 0,0:09:19.47,0:09:20.35,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:09:20.56,0:09:21.68,Default,,0,0,0,,Қаншалықты маман болсаңыз да...
Dialogue: 0,0:09:21.81,0:09:24.43,Default,,0,0,0,,Аруақтар басып алғаны жақсы емес.
Dialogue: 0,0:09:24.56,0:09:25.81,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:09:26.06,0:09:27.65,Default,,0,0,0,,Басты көздеу.
Dialogue: 0,0:09:28.48,0:09:30.02,Default,,0,0,0,,Оны әлі бермеңіз.
Dialogue: 0,0:09:30.15,0:09:33.23,Default,,0,0,0,,Барлығын компьютерлік техникасы бар уақытша ұстау изоляторына апарыңыз.
Dialogue: 0,0:09:33.36,0:09:35.15,Default,,0,0,0,,Сізді жауапқа тартасыз ба?
Dialogue: 0,0:09:35.28,0:09:37.36,Default,,0,0,0,,Жалған естеліктердің пайдасы жоқ
Dialogue: 0,0:09:37.86,0:09:39.37,Default,,0,0,0,,Жад?
Dialogue: 0,0:09:39.70,0:09:42.91,Default,,0,0,0,,Бұл ластанған елестердің пайдасы бар.
Dialogue: 0,0:09:51.63,0:09:54.38,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:54.92,0:09:57.59,Default,,0,0,0,,Бұл біздің азамат ретіндегі табиғи парызымыз.
Dialogue: 0,0:09:57.72,0:09:59.84,Default,,0,0,0,,Сіз бөгет басқарушысысыз.
Dialogue: 0,0:10:00.39,0:10:01.72,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:02.64,0:10:05.52,Default,,0,0,0,,Доктор Зинджи Бекка Аль Саид
Dialogue: 0,0:10:05.64,0:10:07.10,Default,,0,0,0,,Мені Саид деп атаңыз.
Dialogue: 0,0:10:07.23,0:10:10.86,Default,,0,0,0,,Әй, мынау мықты хатшы екен.
Dialogue: 0,0:10:11.23,0:10:12.77,Default,,0,0,0,,Мен сенімді бағыныңқысымын.
Dialogue: 0,0:10:13.15,0:10:17.82,Default,,0,0,0,,Отаның Құзан республикасында қақтығыс жалғасуда.
Dialogue: 0,0:10:17.95,0:10:20.78,Default,,0,0,0,,Әсіресе халдис азшылығы...
Dialogue: 0,0:10:20.91,0:10:23.49,Default,,0,0,0,,Сіз Тәуелсіздік соғысын жалғастыруға тырысасыз ба?
Dialogue: 0,0:10:24.37,0:10:26.45,Default,,0,0,0,,Бұл ауыр жанжал.
Dialogue: 0,0:10:26.58,0:10:28.91,Default,,0,0,0,,Сіз де халдейсіз, солай ма?
Dialogue: 0,0:10:29.21,0:10:34.88,Default,,0,0,0,,Иә, көптеген отандастарым сияқты мен де мәселені бейбіт жолмен шешуді қалаймын.
Dialogue: 0,0:10:36.71,0:10:38.34,Default,,0,0,0,,Бөгет жарылысына келсек...
Dialogue: 0,0:10:38.47,0:10:40.89,Default,,0,0,0,,Мен клапан ақауы деп естідім.
Dialogue: 0,0:10:41.01,0:10:44.31,Default,,0,0,0,,Сіздің компания суды сатып алу және сатумен айналысады, солай ма?
Dialogue: 0,0:10:44.43,0:10:46.10,Default,,0,0,0,,Қолдану мақсаты қандай?
Dialogue: 0,0:10:46.22,0:10:48.14,Default,,0,0,0,,Дәл өнеркәсіптік су
Dialogue: 0,0:10:48.27,0:10:52.10,Default,,0,0,0,,100% таза су өте қажет
Dialogue: 0,0:10:52.23,0:10:55.98,Default,,0,0,0,,Дәлдік өнеркәсібі... протездік денелерді өндіру?
Dialogue: 0,0:10:56.11,0:10:57.07,Default,,0,0,0,,Иә
Dialogue: 0,0:10:57.07,0:10:57.23,Default,,0,0,0,,Иә
Dialogue: 0,0:10:59.53,0:11:00.82,Default,,0,0,0,,Директор…
Dialogue: 0,0:11:02.37,0:11:03.20,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:11:03.87,0:11:06.95,Default,,0,0,0,,Бұл компанияны Индустрия министрлігі тартты.
Dialogue: 0,0:11:07.08,0:11:09.62,Default,,0,0,0,,Сіз тіпті учаскелік полиция қызметкерлерін де жау еткіңіз келе ме?
Dialogue: 0,0:11:09.75,0:11:11.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:15.75,0:11:18.30,Default,,0,0,0,,Эй, бұл дәлел.
Dialogue: 0,0:11:18.88,0:11:22.30,Default,,0,0,0,,Біздің қоймадан ұрланған заттарды анықтағаныңыз үшін рахмет.
Dialogue: 0,0:11:22.55,0:11:24.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:24.89,0:11:26.60,Default,,0,0,0,,Арнайы сынып!
Dialogue: 0,0:11:26.72,0:11:28.14,Default,,0,0,0,,Е-е... Бастық!
Dialogue: 0,0:11:28.27,0:11:29.64,Default,,0,0,0,,Йосанка
Dialogue: 0,0:11:30.81,0:11:32.60,Default,,0,0,0,,Детектив қайтыс болды, солай ма?
Dialogue: 0,0:11:32.73,0:11:34.27,Default,,0,0,0,,Айтпасаң да түсінемін
Dialogue: 0,0:11:34.69,0:11:37.19,Default,,0,0,0,,Сіз Нишинучиде ақпарат жинауыңыз керек.
Dialogue: 0,0:11:37.86,0:11:39.65,Default,,0,0,0,,Нишинучи дегеніміз не?
Dialogue: 0,0:11:39.78,0:11:41.24,Default,,0,0,0,,Террористік бомбалау
Dialogue: 0,0:11:41.36,0:11:43.78,Default,,0,0,0,,Қалдилар отбасының жұмысы сияқты.
Dialogue: 0,0:11:43.91,0:11:46.74,Default,,0,0,0,,Тыңдаңыздар, бұл мәселені басшыларыңызбен талқылаңыздар...
Dialogue: 0,0:11:46.87,0:11:48.04,Default,,0,0,0,,Терроризм…
Dialogue: 0,0:11:49.20,0:11:53.62,Default,,0,0,0,,Егер жарылыс қасақана болса және жәбірленуші...
Dialogue: 0,0:11:54.38,0:11:55.33,Default,,0,0,0,,Не?
Dialogue: 0,0:11:55.46,0:11:58.00,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:12:00.46,0:12:02.55,Default,,0,0,0,,Қажетсіз ақша жасамаңыз.
Dialogue: 0,0:12:06.76,0:12:09.01,Default,,0,0,0,,Калдис типті қару контрабандасы ұйымы.
Dialogue: 0,0:12:09.27,0:12:11.23,Default,,0,0,0,,Мен оны жасырын тергеу кезінде кездестірдім.
Dialogue: 0,0:12:11.68,0:12:15.02,Default,,0,0,0,,Олардың мақсаты - үйдегі жолдастарына қару жіберу.
Dialogue: 0,0:12:15.15,0:12:17.31,Default,,0,0,0,,Бұл елге шабуыл жасауға ешқандай себеп жоқ.
Dialogue: 0,0:12:17.44,0:12:19.40,Default,,0,0,0,,Өтініште шатасу жоқ
Dialogue: 0,0:12:19.53,0:12:23.24,Default,,0,0,0,,Су бағасы туралы келісімге қарсы кездесу орнын бомбалады
Dialogue: 0,0:12:23.53,0:12:26.28,Default,,0,0,0,,Мұның өзі отырғызылған жалған естелік пе?
Dialogue: 0,0:12:26.41,0:12:28.70,Default,,0,0,0,,Мен барлығына жұқтыратынына сенімдімін.
Dialogue: 0,0:12:29.16,0:12:31.70,Default,,0,0,0,,Сондай-ақ, ол Ghost Rock-қа кедергі келтірді.
Dialogue: 0,0:12:33.12,0:12:34.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:38.50,0:12:40.71,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Бұл тамаша басу болды.
Dialogue: 0,0:12:40.96,0:12:43.84,Default,,0,0,0,,Егер сіз өзіңіздің байланыс стандарттарыңызды біздің стандарттарымызға бейімдесеңіз...
Dialogue: 0,0:12:43.97,0:12:45.68,Default,,0,0,0,,Оны оңай басқаруға болады.
Dialogue: 0,0:12:46.30,0:12:47.85,Default,,0,0,0,,Баяндама оқылды.
Dialogue: 0,0:12:47.97,0:12:49.31,Default,,0,0,0,,Елес шабуылы бұзуы
Dialogue: 0,0:12:49.43,0:12:53.18,Default,,0,0,0,,Бұл миды жууды бір уақытта жасайтын жалған жады вирусы ма?
Dialogue: 0,0:12:53.60,0:12:56.10,Default,,0,0,0,,Өзін-өзі бұзатын Stuxnet түрі.
Dialogue: 0,0:12:56.23,0:12:59.15,Default,,0,0,0,,Инфекцияның бастапқы белгілерінен басқа із қалдырмайды.
Dialogue: 0,0:12:59.57,0:13:03.32,Default,,0,0,0,,Электрондық жады манипуляциясы үш еселік әдіс болып табылады.
Dialogue: 0,0:13:03.44,0:13:05.65,Default,,0,0,0,,Әлемде дәлелденген табыс тарихы жоқ.
Dialogue: 0,0:13:05.78,0:13:07.28,Default,,0,0,0,,Бірақ өткен оқиғалардан...
Dialogue: 0,0:13:07.41,0:13:10.03,Default,,0,0,0,,Жасаушы мен делдал бар екені анық
Dialogue: 0,0:13:10.53,0:13:13.29,Default,,0,0,0,,Иә, мен жетілдірілген кибервирус жасадым.
Dialogue: 0,0:13:13.41,0:13:15.25,Default,,0,0,0,,Супер шебер деңгейіндегі бағдарламашы -
Dialogue: 0,0:13:15.37,0:13:17.96,Default,,0,0,0,,Бір жерде өрт сөндіру құрылғысы бар.
Dialogue: 0,0:13:18.46,0:13:21.84,Default,,0,0,0,,Бірақ әлемдегі бірде-бір ұйым шынайы тұлғаны анықтай алмады.
Dialogue: 0,0:13:21.96,0:13:22.92,Default,,0,0,0,,Сіз оны ұстадыңыз ба?
Dialogue: 0,0:13:23.51,0:13:25.38,Default,,0,0,0,,Бір шолу
Dialogue: 0,0:13:30.97,0:13:31.81,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:32.43,0:13:35.06,Default,,0,0,0,,Барлық қылмыскерлер үшін бірдей татуировкасы
Dialogue: 0,0:13:35.18,0:13:37.73,Default,,0,0,0,,Кезінде Қалдис тәуелсіздік армиясын басқарған батыр.
Dialogue: 0,0:13:37.85,0:13:40.48,Default,,0,0,0,,Бұл Скрасус қолданатын таңба.
Dialogue: 0,0:13:40.77,0:13:44.61,Default,,0,0,0,,Мен электронды соғыс туралы қауесетті естідім.
Dialogue: 0,0:13:44.74,0:13:46.36,Default,,0,0,0,,Бұл өрт сөндіргіш пе?
Dialogue: 0,0:13:46.49,0:13:48.99,Default,,0,0,0,,Мүмкін емес. Соғыс кезінде қайтыс болған болуы керек.
Dialogue: 0,0:13:49.24,0:13:51.49,Default,,0,0,0,,Түпнұсқалығын растаңыз
Dialogue: 0,0:13:51.62,0:13:54.75,Default,,0,0,0,,9-бөлім дерекқорына шектеулі қол жеткізуге рұқсат беріңіз
Dialogue: 0,0:13:54.87,0:13:56.41,Default,,0,0,0,,Толық ақпаратты мына жерден қараңыз.
Dialogue: 0,0:13:56.54,0:13:57.46,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:13:57.79,0:13:59.00,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:13:59.12,0:14:01.29,Default,,0,0,0,,Логикома мүмкіндігінше көп қамтамасыз етілген
Dialogue: 0,0:14:01.42,0:14:03.92,Default,,0,0,0,,Атыс қаруы мен оларды пайдалануға рұқсат беруге де тыйым салынады.
Dialogue: 0,0:14:04.17,0:14:05.88,Default,,0,0,0,,Мен тізім жасасам да—
Dialogue: 0,0:14:06.01,0:14:08.38,Default,,0,0,0,,Ұйым оны пайдалана алмаса, бұл мағынасыз.
Dialogue: 0,0:14:08.84,0:14:10.05,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:14:10.18,0:14:12.30,Default,,0,0,0,,Арнайы өкілеттіктер және бюджетті бекіту
Dialogue: 0,0:14:12.43,0:14:15.10,Default,,0,0,0,,Айтпақшы, сол әлсіз байланыс желісінен...
Dialogue: 0,0:14:15.22,0:14:17.35,Default,,0,0,0,,Оны біздің желіге жоғары қарай үйлесімді етіп жасаңыз.
Dialogue: 0,0:14:17.48,0:14:19.81,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:14:20.35,0:14:23.44,Default,,0,0,0,,Көрсетілген адамдар саны кездескенше көзіңізді жұмыңыз.
Dialogue: 0,0:14:23.90,0:14:28.40,Default,,0,0,0,,Бұл мінсіз стандарттарға біріктірілген бірлік. Қосымша әскердің қажеті жоқ.
Dialogue: 0,0:14:28.53,0:14:31.32,Default,,0,0,0,,Егер сізді бұзып кетсе, сіз жойыласыз.
Dialogue: 0,0:14:31.45,0:14:33.70,Default,,0,0,0,,Сол қылмыскер сияқты.
Dialogue: 0,0:14:34.49,0:14:37.12,Default,,0,0,0,,Мінсіз стандарттарға сенуге болмайды.
Dialogue: 0,0:14:37.83,0:14:41.00,Default,,0,0,0,,Егер сізге көбірек бюджет пен өкілеттік қажет болса, кем дегенде тағы бір адамды қосыңыз.
Dialogue: 0,0:14:41.13,0:14:44.42,Default,,0,0,0,,Бірлесіп жұмыс істеу керек әртүрлі стандарттарды қабылдаңыз
Dialogue: 0,0:14:45.92,0:14:47.34,Default,,0,0,0,,Бюджет түспесе...
Dialogue: 0,0:14:47.46,0:14:50.84,Default,,0,0,0,,Мен бұл қоқыс жәшігімен әлі де араласа алмаймын.
Dialogue: 0,0:14:52.64,0:14:54.89,Default,,0,0,0,,Мен зертхананы пайдалана алатыныма ризамын.
Dialogue: 0,0:14:56.64,0:14:59.23,Default,,0,0,0,,Сайып келгенде, протездік дененің жұмысын қолдайтын нәрсе...
Dialogue: 0,0:14:59.35,0:15:01.06,Default,,0,0,0,,Өйткені бұл тамаша техникалық қызмет көрсету.
Dialogue: 0,0:15:03.11,0:15:05.90,Default,,0,0,0,,Нұсқаны өзіңіз жаңартудан басқа амалыңыз жоқ.
Dialogue: 0,0:15:06.03,0:15:07.23,Default,,0,0,0,,Ақшаны қажет етсе де
Dialogue: 0,0:15:09.40,0:15:11.91,Default,,0,0,0,,Оқу орталығында нұсқаушы болу жақсы ақша табады.
Dialogue: 0,0:15:13.91,0:15:16.16,Default,,0,0,0,,Жетілдірілген техникалық қызмет көрсету жабдығына уәкілетті
Dialogue: 0,0:15:16.29,0:15:17.91,Default,,0,0,0,,Барлығын алыңыз
Dialogue: 0,0:15:18.04,0:15:19.91,Default,,0,0,0,,Шағым беруге уақытыңыз болған кезде істі алыңыз
Dialogue: 0,0:15:21.00,0:15:22.29,Default,,0,0,0,,Ұлты белгісіз
Dialogue: 0,0:15:22.42,0:15:23.54,Default,,0,0,0,,Бірнеше протездік денені пайдалану -
Dialogue: 0,0:15:23.67,0:15:27.46,Default,,0,0,0,,Оның лақап аты «Скрас», өйткені ол өзінің шынайы тұлғасын жасырады.
Dialogue: 0,0:15:27.59,0:15:29.26,Default,,0,0,0,,Скилла деп те белгілі
Dialogue: 0,0:15:29.38,0:15:31.84,Default,,0,0,0,,Бұл грек мифологиясында кездесетін құбыжықтың аты.
Dialogue: 0,0:15:32.34,0:15:36.14,Default,,0,0,0,,Тәуелсіздік армиясын басқарған кәсіби жауынгер және білікті хакер.
Dialogue: 0,0:15:36.26,0:15:38.89,Default,,0,0,0,,Оның мамандығы туннельдік стратегия.
Dialogue: 0,0:15:39.02,0:15:40.06,Default,,0,0,0,,Туннель дегеніміз не?
Dialogue: 0,0:15:40.39,0:15:42.39,Default,,0,0,0,,Бомбалармен құтқару сымдарына шабуыл жасау -
Dialogue: 0,0:15:42.52,0:15:45.52,Default,,0,0,0,,Қалпына келтіру процесі кезінде электронды ену.
Dialogue: 0,0:15:45.98,0:15:50.07,Default,,0,0,0,,Сайып келгенде, мақсатты негізгі қоршауға жойқын электрондық соғыс шабуылын бастаңыз.
Dialogue: 0,0:15:50.19,0:15:52.15,Default,,0,0,0,,Тәуелсіздікке жол бермеуге тырысқандар -
Dialogue: 0,0:15:52.28,0:15:54.74,Default,,0,0,0,,Керісінше үлкен соққыға ұшырады.
Dialogue: 0,0:15:54.87,0:15:58.58,Default,,0,0,0,,Алайда, Кузан республикасы төңіректегі елдерді тексеру үшін...
Dialogue: 0,0:15:58.70,0:16:01.00,Default,,0,0,0,,Дамыған елдермен бірлесіп қолданылды.
Dialogue: 0,0:16:01.37,0:16:05.67,Default,,0,0,0,,Әсіресе осы ел қатысқан бір реттік тәуелсіздік соғысы.
Dialogue: 0,0:16:05.79,0:16:08.17,Default,,0,0,0,,Соғыстан кейін Қалдыс тәуелсіздігі мойындалмады.
Dialogue: 0,0:16:08.30,0:16:10.80,Default,,0,0,0,,Партизандар жойылды, олардың барлығы жойылды.
Dialogue: 0,0:16:10.92,0:16:14.93,Default,,0,0,0,,Қайтыс болған басшы шын мәнінде тірі және дүниежүзілік зерттеу институттарынан айласын асырды.
Dialogue: 0,0:16:15.05,0:16:17.22,Default,,0,0,0,,Арнайы вирустың дамуы
Dialogue: 0,0:16:17.35,0:16:20.77,Default,,0,0,0,,Ол өз атын Fire Starter деп өзгертіп, кек ала бастады...
Dialogue: 0,0:16:20.89,0:16:22.94,Default,,0,0,0,,Мен логиканы түсіндім, бірақ бұл мүмкін бе?
Dialogue: 0,0:16:23.23,0:16:24.14,Default,,0,0,0,,Қақтығыс аймағы?
Dialogue: 0,0:16:24.27,0:16:27.52,Default,,0,0,0,,Кибервирус бойынша адам эксперименттерімен қалағаныңызды жасаңыз.
Dialogue: 0,0:16:27.65,0:16:29.19,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:16:29.32,0:16:31.40,Default,,0,0,0,,Скрас өлген болуы керек.
Dialogue: 0,0:16:31.90,0:16:33.45,Default,,0,0,0,,Бұл мұрагер ме?
Dialogue: 0,0:16:33.57,0:16:36.03,Default,,0,0,0,,Өнімнің өнімділігін білмей, кез келген нәрсені сату.
Dialogue: 0,0:16:36.16,0:16:37.95,Default,,0,0,0,,Брокер емес
Dialogue: 0,0:16:38.28,0:16:39.54,Default,,0,0,0,,Партизандарды манипуляциялау -
Dialogue: 0,0:16:39.66,0:16:43.12,Default,,0,0,0,,Сіз бұл елде сол кездегі туннель жұмысын қайта жасағыңыз келе ме?
Dialogue: 0,0:16:43.46,0:16:47.42,Default,,0,0,0,,Маған қызық, ешкімде бомбаға арналған детонатор болмаған.
Dialogue: 0,0:16:48.38,0:16:50.13,Default,,0,0,0,,Бома Оқиға болған жерді зерттеңіз.
Dialogue: 0,0:16:50.25,0:16:51.09,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:51.21,0:16:53.42,Default,,0,0,0,,Паз Сайто мен ұйымға соққы беріңіз
Dialogue: 0,0:16:53.55,0:16:55.59,Default,,0,0,0,,Мен оларды кім дайындағанын білгім келеді.
Dialogue: 0,0:16:56.05,0:16:58.76,Default,,0,0,0,,Бату мен Исикава туннель операциясының мүмкіндігін түсінеді.
Dialogue: 0,0:16:59.30,0:17:03.27,Default,,0,0,0,,Сен сол партизанның киберкеңістігіне кіріп, вирустарды іздейсің бе?
Dialogue: 0,0:17:05.81,0:17:07.56,Default,,0,0,0,,Оған дейін мен протездік денемді күтемін.
Dialogue: 0,0:17:07.69,0:17:10.23,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:12.03,0:17:13.15,Default,,0,0,0,,Техникалық қызмет көрсету?
Dialogue: 0,0:17:13.40,0:17:16.61,Default,,0,0,0,,Ол менің жігітім, бұрынғы әскери протез техникі.
Dialogue: 0,0:17:16.74,0:17:18.32,Default,,0,0,0,,Әскери-теңіз флотының матросы, солай ма?
Dialogue: 0,0:17:18.45,0:17:19.99,Default,,0,0,0,,Дұрыс, бұрынғы адам.
Dialogue: 0,0:17:20.37,0:17:23.75,Default,,0,0,0,,Мен кездесуде ұрысып қалдым, майор бөксемді тепті де, ауруханаға түстім.
Dialogue: 0,0:17:23.87,0:17:25.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:25.12,0:17:27.04,Default,,0,0,0,,Кибербюродағы жоғары жалақы қандай?
Dialogue: 0,0:17:27.17,0:17:29.29,Default,,0,0,0,,Бұл екі аптаға созылмады.
Dialogue: 0,0:17:29.54,0:17:32.17,Default,,0,0,0,,Бұл 6 айда 6-шы науқас емес пе?
Dialogue: 0,0:17:32.30,0:17:35.80,Default,,0,0,0,,Бұл инстинкт. Мен енді ешқашан сол әйелді ұстамаймын.
Dialogue: 0,0:17:36.26,0:17:38.64,Default,,0,0,0,,Бұл олардың кепілге алынғандығынан ба, әлде кек алуына байланысты ма?
Dialogue: 0,0:17:38.76,0:17:40.35,Default,,0,0,0,,Жоқ, бұл принцип.
Dialogue: 0,0:17:40.68,0:17:42.89,Default,,0,0,0,,Кем дегенде басқа адамның ақпаратын сақтаңыз
Dialogue: 0,0:17:43.02,0:17:44.43,Default,,0,0,0,,Егер бұл қақпан болса ше?
Dialogue: 0,0:17:44.56,0:17:46.98,Default,,0,0,0,,«Мен отбасын құрғым келеді» дегеннен гөрі жақсырақ
Dialogue: 0,0:17:47.10,0:17:49.31,Default,,0,0,0,,Сіз бәрібір кез келген уақытта өле аласыз.
Dialogue: 0,0:17:49.44,0:17:52.52,Default,,0,0,0,,Бұл жұмыс отбасын асырауға жарамайды.
Dialogue: 0,0:17:58.07,0:18:01.33,Default,,0,0,0,,Өлген детективтің мылтығы табылмады...
Dialogue: 0,0:18:01.45,0:18:03.99,Default,,0,0,0,,Егер детектив Мизуки мылтық қолданған болса...
Dialogue: 0,0:18:04.12,0:18:06.75,Default,,0,0,0,,Бұл апат емес, оқиға болғанын дәлелдейді.
Dialogue: 0,0:18:07.08,0:18:09.46,Default,,0,0,0,,Біреу мұны жазатайым оқиғаға ұқсатқысы келді ме?
Dialogue: 0,0:18:09.92,0:18:13.71,Default,,0,0,0,,Өлімнің себебі суға бату болды, бірақ тірі кезінде көп мөлшерде қан кеткен.
Dialogue: 0,0:18:13.84,0:18:16.42,Default,,0,0,0,,Сүйектің бір бөлігі жетіспейді және денеден жоғалады.
Dialogue: 0,0:18:16.97,0:18:19.97,Default,,0,0,0,,Денеге қатты зақым келген, бірақ анық емес...
Dialogue: 0,0:18:20.09,0:18:22.68,Default,,0,0,0,,Сізге оқ ату мүмкіндігі бар ма?
Dialogue: 0,0:18:22.81,0:18:26.06,Default,,0,0,0,,Детектив Мизуки қару контрабандасының артынан қуып жүрді.
Dialogue: 0,0:18:26.18,0:18:29.02,Default,,0,0,0,,Біздің ең соңғы қарсыласымыз - Kaldis ұйымы.
Dialogue: 0,0:18:29.14,0:18:32.40,Default,,0,0,0,,Мүмкін ол дәлелді алғаны үшін өлтірілген шығар...
Dialogue: 0,0:18:33.07,0:18:38.36,Default,,0,0,0,,Бөгеттің жарылысы қасақана болды ма, оның мақсаты дәлелдемелерді жою болды ма?
Dialogue: 0,0:18:39.07,0:18:41.37,Default,,0,0,0,,Менің қиялым көп.
Dialogue: 0,0:18:41.49,0:18:43.62,Default,,0,0,0,,Сіз көмектесе аласыз ба?
Dialogue: 0,0:18:43.74,0:18:46.20,Default,,0,0,0,,Жоқ, қызық. Тергеуге рұқсат етіңіз.
Dialogue: 0,0:18:46.58,0:18:48.91,Default,,0,0,0,,Сол жағдайдың байланысын табуға тырысыңыз.
Dialogue: 0,0:18:50.04,0:18:51.58,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:18:51.71,0:18:53.21,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:18:53.63,0:18:55.05,Default,,0,0,0,,(Көпшіліктің сыбыры) «Ал мен сені, құштарлығымның нысаны, жасырып жүрген сезімдерім—»
Dialogue: 0,0:18:58.88,0:19:02.47,Default,,0,0,0,,Адамның дәл осындай қозғалыстар жасауы мүмкін емес.
Dialogue: 0,0:19:02.59,0:19:05.35,Default,,0,0,0,,Аздап еңкейту Объектіге дейінгі қашықтық -
Dialogue: 0,0:19:05.47,0:19:07.56,Default,,0,0,0,,Салмағы миллиграмм -
Dialogue: 0,0:19:07.68,0:19:11.98,Default,,0,0,0,,Осы заттарды есептей отырып, ми белгісіз қозғалыстарды жасай береді.
Dialogue: 0,0:19:12.27,0:19:14.40,Default,,0,0,0,,Сіздің миыңыз басқаларға қарағанда ерекше...
Dialogue: 0,0:19:14.52,0:19:17.32,Default,,0,0,0,,Бірыңғай стандарттардың әдемілігін түсіну
Dialogue: 0,0:19:19.40,0:19:20.57,Default,,0,0,0,,Өсіру
Dialogue: 0,0:19:20.95,0:19:22.41,Default,,0,0,0,,Қалыпты ештеңе жоқ.
Dialogue: 0,0:19:22.53,0:19:23.53,Default,,0,0,0,,Эй...!
Dialogue: 0,0:19:23.66,0:19:24.53,Default,,0,0,0,,Әлі де ауырады ма?
Dialogue: 0,0:19:25.08,0:19:26.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:26.79,0:19:29.54,Default,,0,0,0,,Ахаха... Оң аяғыңызды қозғалтып көріңіз.
Dialogue: 0,0:19:32.25,0:19:33.67,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:19:35.21,0:19:36.55,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:19:36.67,0:19:38.09,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:19:38.21,0:19:39.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:41.47,0:19:45.60,Default,,0,0,0,,Ауырды, маған есепшотты жібер.
Dialogue: 0,0:19:45.72,0:19:48.93,Default,,0,0,0,,Арзан ұста, бірақ уәдеңді ұмытпа.
Dialogue: 0,0:19:49.06,0:19:50.68,Default,,0,0,0,,Сіз өзгердіңіз.
Dialogue: 0,0:19:50.81,0:19:52.44,Default,,0,0,0,,Сіз сияқты жақсы емес
Dialogue: 0,0:20:06.78,0:20:09.12,Default,,0,0,0,,Эй, бұл сканерлеуге кедергі келтіруде.
Dialogue: 0,0:20:09.24,0:20:10.70,Default,,0,0,0,,Олар кездескісі келеді.
Dialogue: 0,0:20:11.54,0:20:14.58,Default,,0,0,0,,Осы күндері өз көзіңмен не істемексің?
Dialogue: 0,0:20:14.71,0:20:17.54,Default,,0,0,0,,Жарылыс болған жерді табу біртүрлі қиын.
Dialogue: 0,0:20:17.67,0:20:20.46,Default,,0,0,0,,Жану процестері туралы біліміңіз бар ма?
Dialogue: 0,0:20:20.59,0:20:23.09,Default,,0,0,0,,Нұсқаулықты соғыс кезінде шетелде үйрендім.
Dialogue: 0,0:20:23.22,0:20:24.43,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:20:25.55,0:20:26.85,Default,,0,0,0,,Сізде толық дене протезі бар ма?
Dialogue: 0,0:20:26.97,0:20:29.10,Default,,0,0,0,,О, дерлік.
Dialogue: 0,0:20:29.72,0:20:31.81,Default,,0,0,0,,Мен шынымен түсінбеймін...
Dialogue: 0,0:20:31.93,0:20:35.85,Default,,0,0,0,,Арнайы қаңқа болмаса, ол негізінен адам денесімен бірдей.
Dialogue: 0,0:20:35.98,0:20:38.44,Default,,0,0,0,,Бірақ күйіп қалсаңыз да, қолыңызды ашық ұстайсыз ба?
Dialogue: 0,0:20:38.57,0:20:39.40,Default,,0,0,0,,Не?
Dialogue: 0,0:20:39.94,0:20:42.11,Default,,0,0,0,,Тірі адам өртеніп өлгенде...
Dialogue: 0,0:20:42.24,0:20:45.82,Default,,0,0,0,,Бұлшықеттер жиырылып, алға еңкейгенде жұдырықтарыңызды түйіңіз.
Dialogue: 0,0:20:45.95,0:20:48.49,Default,,0,0,0,,Ұрықтың қалпы немесе боксшының қалпы
Dialogue: 0,0:20:48.62,0:20:51.37,Default,,0,0,0,,Жылу қаттылығы? Бұған не болды?
Dialogue: 0,0:20:51.83,0:20:53.83,Default,,0,0,0,,Күзетшінің мәйіті табылды -
Dialogue: 0,0:20:55.04,0:20:57.79,Default,,0,0,0,,Қолдарын ашып өлі тұр.
Dialogue: 0,0:20:58.04,0:21:01.30,Default,,0,0,0,,Мүмкін протездік дене немесе бомба.
Dialogue: 0,0:21:01.42,0:21:02.84,Default,,0,0,0,,Протездік дене…
Dialogue: 0,0:21:06.64,0:21:07.39,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:21:07.39,0:21:08.85,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:21:07.39,0:21:08.85,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:21:08.85,0:21:09.89,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:21:11.89,0:21:13.73,Default,,0,0,0,,А, тексеру?
Dialogue: 0,0:21:14.02,0:21:15.52,Default,,0,0,0,,Екі аптадан кейін бе?
Dialogue: 0,0:21:16.19,0:21:19.77,Default,,0,0,0,,Жарайды, жоқ, мен жұмыстамын, кешіріңіз.
Dialogue: 0,0:21:20.32,0:21:21.78,Default,,0,0,0,,Тексеру?
Dialogue: 0,0:21:23.57,0:21:24.95,Default,,0,0,0,,Кешіріңіз, мазаладым.
Dialogue: 0,0:21:33.79,0:21:35.58,Default,,0,0,0,,C4-дегі динамит
Dialogue: 0,0:21:35.71,0:21:37.33,Default,,0,0,0,,Глицериндегі химиялық тыңайтқыш
Dialogue: 0,0:21:37.67,0:21:40.09,Default,,0,0,0,,Қандай жасырыну.
Dialogue: 0,0:21:40.79,0:21:43.59,Default,,0,0,0,,Мен өзімді бомбалық маньяк сияқты сезінемін.
Dialogue: 0,0:21:44.13,0:21:47.26,Default,,0,0,0,,Мен нені пайдаланғанымды білмеймін.
Dialogue: 0,0:21:47.63,0:21:49.22,Default,,0,0,0,,Олардың сызықтарына нұсқау!
Dialogue: 0,0:21:50.01,0:21:52.93,Default,,0,0,0,,Скрасс атымен екінші топқа нақты бұйрықтар!
Dialogue: 0,0:21:53.22,0:21:56.14,Default,,0,0,0,,Қарғыс атсын, қоғамдық қауіпсіздік қозғалыстары ағып жатыр.
Dialogue: 0,0:22:02.27,0:22:05.32,Default,,0,0,0,,Су шаруашылығы бюросының серверінің бүкіл қабаты ұшып кетті.
Dialogue: 0,0:22:05.44,0:22:06.70,Default,,0,0,0,,Сіз не қолдандыңыз?
Dialogue: 0,0:22:06.82,0:22:08.32,Default,,0,0,0,,Нишинучидегі көрініс...
Dialogue: 0,0:22:08.45,0:22:11.70,Default,,0,0,0,,Жануды жеделдету төбелер мен арналарға таралады
Dialogue: 0,0:22:11.83,0:22:13.70,Default,,0,0,0,,Барлық бағыттағы жарылыс
Dialogue: 0,0:22:13.83,0:22:16.16,Default,,0,0,0,,Басқаша айтқанда, ғарыштың өзі жарылды.
Dialogue: 0,0:22:16.29,0:22:17.41,Default,,0,0,0,,Бұл бу бомбасы ма?
Dialogue: 0,0:22:17.71,0:22:19.25,Default,,0,0,0,,Сонда бұл манекен.
Dialogue: 0,0:22:19.37,0:22:22.38,Default,,0,0,0,,Жетілдірілген бомбалар жасайтын жер бар.
Dialogue: 0,0:22:24.59,0:22:26.34,Default,,0,0,0,,Иә? Хмф
Dialogue: 0,0:22:27.30,0:22:30.59,Default,,0,0,0,,Партизан батыры тапсырманы орындайды.
Dialogue: 0,0:22:37.23,0:22:39.27,Default,,0,0,0,,Су бөлімі қалпына келтіру жұмыстарын бастады
Dialogue: 0,0:22:39.39,0:22:42.23,Default,,0,0,0,,Хакер жасырын түрде кіріп кеткен болуы мүмкін.
Dialogue: 0,0:22:42.36,0:22:43.98,Default,,0,0,0,,Келесі мақсатты анықтаңыз
Dialogue: 0,0:22:44.11,0:22:46.07,Default,,0,0,0,,Мені енді туннель қазуға мәжбүрлеме.
Dialogue: 0,0:22:46.19,0:22:47.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:49.36,0:22:50.78,Default,,0,0,0,,Чии…
Dialogue: 0,0:23:06.42,0:23:07.76,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:23:08.55,0:23:10.76,Default,,0,0,0,,Мен полицияның сұхбатына үйреніп қалдым.
Dialogue: 0,0:23:10.88,0:23:13.22,Default,,0,0,0,,Соңғы уақытта протездік денелерді ұрлау көп орын алуда.
Dialogue: 0,0:23:13.93,0:23:16.72,Default,,0,0,0,,Су перісі… Су перісі аяқтары?
Dialogue: 0,0:23:17.27,0:23:19.94,Default,,0,0,0,,Бұл ақымақ есім, бірақ оны түсіну оңай емес пе?
Dialogue: 0,0:23:20.35,0:23:22.40,Default,,0,0,0,,Әйел тұтынушылар арасында жақсы беделге ие.
Dialogue: 0,0:23:22.52,0:23:24.65,Default,,0,0,0,,Мына аяқтарды танисың ба?
Dialogue: 0,0:23:27.32,0:23:28.82,Default,,0,0,0,,Бұл жаппай шығарылатын түрі сияқты.
Dialogue: 0,0:23:29.32,0:23:31.20,Default,,0,0,0,,Тегке қараңыз
Dialogue: 0,0:23:32.86,0:23:33.74,Default,,0,0,0,,«Ариэль»
Dialogue: 0,0:23:34.37,0:23:38.08,Default,,0,0,0,,Мен оны қарап шықтым, бірақ нарықта мұндай өнімдер жоқ сияқты.
Dialogue: 0,0:23:38.20,0:23:41.71,Default,,0,0,0,,Оны да алып жүрмейміз.Бұл дизайнер берген бренд шығар.
Dialogue: 0,0:23:42.42,0:23:46.84,Default,,0,0,0,,Жаппай өндірілген модель негізінде біз оны тұтынушы сұраулары негізінде жаңа пішіндерге өңдейміз.
Dialogue: 0,0:23:46.96,0:23:48.05,Default,,0,0,0,,туындаған сияқты,
Dialogue: 0,0:23:48.17,0:23:50.76,Default,,0,0,0,,Хмм... Мен сізге тізімімді беремін.
Dialogue: 0,0:23:51.30,0:23:53.05,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:23:53.68,0:23:54.68,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:23:57.60,0:23:59.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:24:03.94,0:24:05.40,Default,,0,0,0,,Полицияның махаббат тізімдері.
Dialogue: 0,0:24:05.94,0:24:07.65,Default,,0,0,0,,Ол сізді біраз уақыт жұмыста ұстайды.
Dialogue: 0,0:24:07.77,0:24:10.28,Default,,0,0,0,,Қоғамдық қауіпсіздік жасанды үйді басып алды.
Dialogue: 0,0:24:10.53,0:24:13.57,Default,,0,0,0,,Мұндағы сызық дұрыс па? Полковник Хозуми
Dialogue: 0,0:24:13.99,0:24:17.16,Default,,0,0,0,,Бұл тәуелсіз барлау желісі. Уайымдама.
Dialogue: 0,0:24:17.28,0:24:19.54,Default,,0,0,0,,Неге сол детективтен құтылмайсың?
Dialogue: 0,0:24:19.79,0:24:22.50,Default,,0,0,0,,Ол біртүрлі детектив, бірақ оның білімі күшті емес.
Dialogue: 0,0:24:23.12,0:24:25.21,Default,,0,0,0,,Мәселе ауаның ағуында.
Dialogue: 0,0:24:25.33,0:24:28.17,Default,,0,0,0,,Талдаудан бұрын қалпына келтірілген өндірістік зауыттар.
Dialogue: 0,0:24:28.30,0:24:29.34,Default,,0,0,0,,Жою
Dialogue: 0,0:24:29.46,0:24:31.72,Default,,0,0,0,,Жарылу үшін асықпаңыз.
Dialogue: 0,0:24:31.84,0:24:34.80,Default,,0,0,0,,Бұл жақсы, өйткені әуеден іске асыру уақытында орындалды.
Dialogue: 0,0:24:34.93,0:24:37.72,Default,,0,0,0,,Бұл операцияға қауіп төндіре жаздады.
Dialogue: 0,0:24:38.14,0:24:41.68,Default,,0,0,0,,Антенналар Кальдиске жарылғыш заттарды заңсыз алып өту құралы болып табылады.
Dialogue: 0,0:24:42.23,0:24:43.27,Default,,0,0,0,,Жанкешті емес!
Dialogue: 0,0:24:44.14,0:24:45.94,Default,,0,0,0,,Жағдайлардың өзгеруі
Dialogue: 0,0:24:46.06,0:24:49.57,Default,,0,0,0,,Егер кәдімгі қару-жарақтың шетелде дамуы ел ішінде қозғалса...
Dialogue: 0,0:24:49.69,0:24:51.48,Default,,0,0,0,,Тарату жолы жоғалады
Dialogue: 0,0:24:52.07,0:24:53.95,Default,,0,0,0,,Калдис сарбаздары бір реттік қолданыла ма?
Dialogue: 0,0:24:54.40,0:24:55.78,Default,,0,0,0,,Нұсқаны жаңарту
Dialogue: 0,0:24:55.91,0:24:59.41,Default,,0,0,0,,Fire Starter көмегімен сіз қалағаныңызша көп сарбаз жасай аласыз.
Dialogue: 0,0:24:59.53,0:25:01.66,Default,,0,0,0,,Тұтқынға алынған әскерлерді босату
Dialogue: 0,0:25:02.37,0:25:04.71,Default,,0,0,0,,Осы уақытқа дейін деректерді жіберу мүмкін емес.
Dialogue: 0,0:25:05.29,0:25:07.13,Default,,0,0,0,,Сіздің жерлестеріңіз емес
Dialogue: 0,0:25:07.83,0:25:10.30,Default,,0,0,0,,Скрасс оларды тастамайды.
Dialogue: 0,0:25:12.21,0:25:13.34,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:25:13.47,0:25:16.05,Default,,0,0,0,,Қолдануға болатын тағы 3 антенна бар.
Dialogue: 0,0:25:16.51,0:25:19.01,Default,,0,0,0,,Олардың бірі сіздің санатыңызда.
Dialogue: 0,0:25:20.01,0:25:21.47,Default,,0,0,0,,Бұл шынымен де ол ма?
Dialogue: 0,0:25:22.02,0:25:25.69,Default,,0,0,0,,Сезімдерің өзгерді ме? Әйелдің антеннасын іске қосыңыз.
Dialogue: 0,0:25:26.23,0:25:29.36,Default,,0,0,0,,Алдымен достарымды босатуым керек, жарай ма?
Dialogue: 0,0:25:54.63,0:25:55.47,Default,,0,0,0,,Маған мін.
Dialogue: 0,0:26:02.01,0:26:04.47,Default,,0,0,0,,Сен екеуміз Скрассты жерлегенбіз...
Dialogue: 0,0:26:04.60,0:26:05.89,Default,,0,0,0,,Сіз сөйлеп тұрған жоқсыз, солай ма?
Dialogue: 0,0:26:06.02,0:26:06.94,Default,,0,0,0,,Иә
Dialogue: 0,0:26:07.06,0:26:09.69,Default,,0,0,0,,Бұл екі жақтың беделін түсіретін стратегия.
Dialogue: 0,0:26:09.81,0:26:12.32,Default,,0,0,0,,Қазір қыздыру ыңғайлы емес.
Dialogue: 0,0:26:12.44,0:26:16.36,Default,,0,0,0,,Сонымен, сіз подполковник дәрежесіне көтерілдіңіз және бірден күшті ойындарды ұнатасыз.
Dialogue: 0,0:26:17.03,0:26:21.03,Default,,0,0,0,,Соғыс бизнесінде өз өмірін ақшаға айырбастағандарды жойыңыз.
Dialogue: 0,0:26:21.16,0:26:23.41,Default,,0,0,0,,Қару-жарақ жасауды отандық мақсатқа айналдыру.
Dialogue: 0,0:26:23.54,0:26:27.25,Default,,0,0,0,,Шетелдік картельдерге сүйенетін сауда жолдарын жою
Dialogue: 0,0:26:27.37,0:26:29.58,Default,,0,0,0,,Командир Мамуро осыны қалады.
Dialogue: 0,0:26:30.08,0:26:32.25,Default,,0,0,0,,Сіздің ойыныңызға қатысу ниетім жоқ.
Dialogue: 0,0:26:32.75,0:26:35.34,Default,,0,0,0,,Скрасс - бұл сіз түсе алмайтын ойын.
Dialogue: 0,0:26:35.46,0:26:37.88,Default,,0,0,0,,Ол өлген болуы керек
Dialogue: 0,0:26:38.51,0:26:39.97,Default,,0,0,0,,Бұл сіз пайдаланған элемент.
Dialogue: 0,0:26:41.26,0:26:44.68,Default,,0,0,0,,Осы жолы өзін Скрас деп атайтын адаммен бірге жерлеңіз.
Dialogue: 0,0:26:44.81,0:26:48.48,Default,,0,0,0,,Әйтпесе, әскер сізді бұрынғы әрекеттеріңізге сәйкес жерлейді.
Dialogue: 0,0:26:56.69,0:27:00.11,Default,,0,0,0,,Жүйеге тәуелсіз болу сізді еркін етпейді.
Dialogue: 0,0:27:00.24,0:27:04.49,Default,,0,0,0,,Ғаламтордың пайда болуы кезінде шамадан тыс күткен өткен ғасырдың бағдарламашылары сияқты.
Dialogue: 0,0:27:05.29,0:27:08.87,Default,,0,0,0,,9-ші қоғамдық қауіпсіздік бөлімі сізді өз бетінше жүгіруге мүмкіндік беру арқылы сынап жатыр.
Dialogue: 0,0:27:09.00,0:27:11.33,Default,,0,0,0,,Төтенше жағдайда мені Ghost Intrusion Key арқылы ұстаңыз.
Dialogue: 0,0:27:11.46,0:27:13.04,Default,,0,0,0,,Бір рет қолданылатын етіп жасаңыз
Dialogue: 0,0:27:13.17,0:27:16.38,Default,,0,0,0,,Мен енді аруағымның саған басып кіруіне жол бермеймін.
Dialogue: 0,0:27:16.50,0:27:18.21,Default,,0,0,0,,Қарсы тарап кім болса да
Dialogue: 0,0:27:21.55,0:27:23.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:27:24.97,0:27:27.52,Default,,0,0,0,,Бұл адам Мотоко Кусанаги
Dialogue: 0,0:27:27.77,0:27:30.64,Default,,0,0,0,,Мен сенің ағаңмын. Сіз жеңе аласыз ба?
Dialogue: 0,0:27:34.31,0:27:36.40,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,0:27:51.66,0:27:52.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:53.92,0:27:54.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:54.83,0:27:56.29,Default,,0,0,0,,Ах
Dialogue: 0,0:28:02.38,0:28:04.05,Default,,0,0,0,,Сіз шынымен келдіңіз бе?
Dialogue: 0,0:28:04.80,0:28:06.14,Default,,0,0,0,,Өйткені бұл уәде
Dialogue: 0,0:28:07.10,0:28:08.85,Default,,0,0,0,,Мен ештеңе дайындаған жоқпын.
Dialogue: 0,0:28:08.97,0:28:10.10,Default,,0,0,0,,деп ойладым
Dialogue: 0,0:28:16.77,0:28:18.98,Default,,0,0,0,,Бірақ алдымен осы жерден.
Dialogue: 0,0:28:20.03,0:28:21.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:30.83,0:28:32.75,Default,,0,0,0,,Мен Калдис үлгісіндегі ұйымның соңынан ердім...
Dialogue: 0,0:28:32.87,0:28:35.63,Default,,0,0,0,,Тактиканы үйреткен адамның көлеңкесі де, пішіні де жоқ.
Dialogue: 0,0:28:35.75,0:28:39.00,Default,,0,0,0,,Мен оның орнына олар пайдаланған жалға беру серверін түсірдім.
Dialogue: 0,0:28:39.71,0:28:41.76,Default,,0,0,0,,Қоғамдық орындарға бірнеше рет қол сұғу
Dialogue: 0,0:28:41.88,0:28:44.05,Default,,0,0,0,,Мен соған тең туннель қазып жатырмын.
Dialogue: 0,0:28:44.18,0:28:45.97,Default,,0,0,0,,Сіз әлі мақсатты көре алмайсыз ба?
Dialogue: 0,0:28:46.34,0:28:48.81,Default,,0,0,0,,Суға және дәлме-дәл машиналарға қатысты орын.
Dialogue: 0,0:28:48.93,0:28:51.77,Default,,0,0,0,,Қалада 78 қолданыстағы нысан бар.
Dialogue: 0,0:28:51.89,0:28:53.48,Default,,0,0,0,,Оны сындырыңыз
Dialogue: 0,0:28:54.27,0:28:58.44,Default,,0,0,0,,Барлау бөлімінен қосалқы мердігер болу әлдеқайда оңай және тиімдірек.
Dialogue: 0,0:28:59.02,0:29:01.44,Default,,0,0,0,,-де? Сіз әлі де техникалық қызмет көрсетудесіз бе?
Dialogue: 0,0:29:01.57,0:29:03.90,Default,,0,0,0,,Иә, мен оны біраз уақытқа кесемін.
Dialogue: 0,0:29:05.03,0:29:06.78,Default,,0,0,0,,Мен шу естимін
Dialogue: 0,0:29:06.91,0:29:10.20,Default,,0,0,0,,Сіздің киберлоббиіңіз үнемі жұмыс істеуге болатын адамдарға толы.
Dialogue: 0,0:29:10.33,0:29:11.75,Default,,0,0,0,,Мен барлығын қуып шықтым.
Dialogue: 0,0:29:12.20,0:29:14.71,Default,,0,0,0,,Мүмкін мен вестибюльге кіре алатын шығармын.
Dialogue: 0,0:29:16.00,0:29:18.42,Default,,0,0,0,,Менімен жұмыс істегіңіз келсе
Dialogue: 0,0:29:18.54,0:29:21.38,Default,,0,0,0,,Егер маған тағы бір адам керек десем, келер ме едің?
Dialogue: 0,0:29:23.59,0:29:26.13,Default,,0,0,0,,Сізге кез келген уақытта қолдау көрсете білу тартымды, бірақ...
Dialogue: 0,0:29:27.09,0:29:29.80,Default,,0,0,0,,Мен әскерге немесе полицияға араласпаймын деп шештім.
Dialogue: 0,0:29:30.60,0:29:31.81,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:29:34.73,0:29:38.44,Default,,0,0,0,,Сенсорлық элементтерге алғашқы көмек көрсету шараларын жасадық. Зертханада дәл баптауды жасаймыз.
Dialogue: 0,0:29:39.52,0:29:42.82,Default,,0,0,0,,Ауырсыну басылды, қалғанын өзім істей аламын.
Dialogue: 0,0:29:47.41,0:29:48.66,Default,,0,0,0,,бастайық
Dialogue: 0,0:29:55.75,0:29:58.00,Default,,0,0,0,,Сізбен кездескен кезім есімде.
Dialogue: 0,0:29:59.17,0:30:00.92,Default,,0,0,0,,Барлық басқа инженерлер -
Dialogue: 0,0:30:01.04,0:30:03.71,Default,,0,0,0,,Сіз қорқынышты шағымданушы екенсіз деген қауесет тарады.
Dialogue: 0,0:30:04.05,0:30:06.42,Default,,0,0,0,,Сондықтан мен сізге фрилансер ретінде ауыстым.
Dialogue: 0,0:30:07.18,0:30:09.39,Default,,0,0,0,,Жоқ, маған бір берілді.
Dialogue: 0,0:30:10.35,0:30:11.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:12.35,0:30:14.22,Default,,0,0,0,,Сіз адасып қалдыңыз
Dialogue: 0,0:30:14.52,0:30:19.31,Default,,0,0,0,,Біз денемізді зат ретінде қарастыруымыз керек пе, әлде адам ретінде ме?
Dialogue: 0,0:30:19.69,0:30:22.02,Default,,0,0,0,,Мен саған қызығамын.
Dialogue: 0,0:30:28.03,0:30:31.57,Default,,0,0,0,,Мен бұрын болған мекемеде маған төсекте ұйықтап, душ қабылдағым келетінін айтты.
Dialogue: 0,0:30:31.70,0:30:33.16,Default,,0,0,0,,Мені жек көрді.
Dialogue: 0,0:30:33.79,0:30:36.58,Default,,0,0,0,,Маған да ұрыс даласында протездік дене болғанымда да айтылды.
Dialogue: 0,0:30:36.70,0:30:40.17,Default,,0,0,0,,Киборгтарға өмір емес, техника керек.
Dialogue: 0,0:30:41.46,0:30:43.34,Default,,0,0,0,,Сондықтан мен протез жасаушыға жүгіндім.
Dialogue: 0,0:30:44.67,0:30:47.80,Default,,0,0,0,,Мен протездік денелерге адам сияқты қарайтын инженер болғым келеді.
Dialogue: 0,0:30:49.59,0:30:54.31,Default,,0,0,0,,Мен бала кезімде мекемеден тыс жерде тұруға машықтандым.
Dialogue: 0,0:30:54.43,0:30:57.02,Default,,0,0,0,,Адамгершілік туралы білім алу
Dialogue: 0,0:30:57.77,0:31:02.36,Default,,0,0,0,,Менің есімде көп жоқ. Барлығы өте жарқын болды ...
Dialogue: 0,0:31:02.98,0:31:05.86,Default,,0,0,0,,Жоспарланған уақыттан ертерек оралғаным есімде.
Dialogue: 0,0:31:07.65,0:31:09.11,Default,,0,0,0,,Тек... сонда-
Dialogue: 0,0:31:09.24,0:31:11.82,Default,,0,0,0,,Мен ортодоксалды протездік денеге ие болуды шештім.
Dialogue: 0,0:31:12.28,0:31:14.37,Default,,0,0,0,,Маған адамның пішіні ұнайды
Dialogue: 0,0:31:14.49,0:31:18.33,Default,,0,0,0,,Сіздің протездік денеңіз зат емес, ол сіздің денеңіз.
Dialogue: 0,0:31:18.45,0:31:21.58,Default,,0,0,0,,Ешкімге зат ретінде қарамау.
Dialogue: 0,0:31:23.42,0:31:25.04,Default,,0,0,0,,Тіпті менен
Dialogue: 0,0:31:26.50,0:31:28.38,Default,,0,0,0,,Мен солай тілеймін.
Dialogue: 0,0:31:28.51,0:31:30.13,Default,,0,0,0,,Маған дәлелді көрсетіңіз
Dialogue: 0,0:31:30.26,0:31:31.22,Default,,0,0,0,,L-дің ізбасары… Мен әлі де L-пен күресіп жатырмын,
Dialogue: 0,0:31:34.30,0:31:36.22,Default,,0,0,0,,Көру қызық
Dialogue: 0,0:31:39.39,0:31:41.27,Default,,0,0,0,,Мен маңызды бомбаны түсінбеймін
Dialogue: 0,0:31:41.69,0:31:45.44,Default,,0,0,0,,Олар қатты күзетілетін кездесу орнына қалай лақтырылды?
Dialogue: 0,0:31:45.57,0:31:46.48,Default,,0,0,0,,Қылмыскер кім?
Dialogue: 0,0:31:46.77,0:31:48.94,Default,,0,0,0,,Олар жарып жібердік дейді.
Dialogue: 0,0:31:49.53,0:31:52.41,Default,,0,0,0,,Бомбаны есте сақтамағанына қарамастан
Dialogue: 0,0:31:52.70,0:31:56.12,Default,,0,0,0,,Олар алдамшы болды, мүмкін, бомбаға қатысы жоқ.
Dialogue: 0,0:31:56.24,0:32:00.25,Default,,0,0,0,,Мақсатты тарылтқанша барлық 78 орынды бақылаңыз
Dialogue: 0,0:32:00.37,0:32:02.00,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:32:02.12,0:32:04.25,Default,,0,0,0,,Сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 0,0:32:06.09,0:32:07.59,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:32:07.59,0:32:09.05,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:32:07.59,0:32:09.05,Default,,0,0,0,,Өкше киіңіз!
Dialogue: 0,0:32:09.17,0:32:13.26,Default,,0,0,0,,Бұрынғы әскери протез жасаушы инженер мүше бола ма?
Dialogue: 0,0:32:13.89,0:32:15.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:16.64,0:32:18.22,Default,,0,0,0,,Мүмкін бұл таңқаларлықтай маңызды шығар?
Dialogue: 0,0:32:18.35,0:32:24.06,Default,,0,0,0,,(Үйлену наурызы)
Dialogue: 0,0:32:24.15,0:32:27.02,Default,,0,0,0,,(Барлығы қол соғып, қол шапалақтайды)
Dialogue: 0,0:32:30.23,0:32:32.57,Default,,0,0,0,,Бұл сіздің көрсеткіңіз келген нәрсе ме?
Dialogue: 0,0:32:32.70,0:32:34.32,Default,,0,0,0,,Менің адал тұтынушыларым
Dialogue: 0,0:32:34.78,0:32:36.78,Default,,0,0,0,,Орташа жасы 70 жас
Dialogue: 0,0:32:38.12,0:32:39.74,Default,,0,0,0,,Барлығы, толық дене протезі...
Dialogue: 0,0:32:40.16,0:32:42.16,Default,,0,0,0,,Қазіргі уақытта киборгтардың дамуына кім жауапты?
Dialogue: 0,0:32:42.29,0:32:43.71,Default,,0,0,0,,Ол егде тартқан ауқатты адам.
Dialogue: 0,0:32:43.83,0:32:44.96,Default,,0,0,0,,Солдат емес
Dialogue: 0,0:32:45.33,0:32:49.67,Default,,0,0,0,,Бұл протездік дене арқылы екінші өмір мен бай өмірді іздейтін адамдар.
Dialogue: 0,0:32:50.76,0:32:54.55,Default,,0,0,0,,Олардың қажеттіліктерін қанағаттандыру үшін протездік денелерге арналған тағамдар да әзірленуде.
Dialogue: 0,0:33:02.43,0:33:03.81,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:33:10.90,0:33:11.73,Default,,0,0,0,,Иә
Dialogue: 0,0:33:16.32,0:33:17.28,Default,,0,0,0,,Дәмді
Dialogue: 0,0:33:18.03,0:33:20.87,Default,,0,0,0,,Дәм қабылдау үшін жадты бірінші рет пайдаланып жатырсыз ба?
Dialogue: 0,0:33:22.41,0:33:25.25,Default,,0,0,0,,Айтпақшы, анау келін жүкті.
Dialogue: 0,0:33:26.42,0:33:28.04,Default,,0,0,0,,Қызықты, солай ма?
Dialogue: 0,0:33:28.17,0:33:31.71,Default,,0,0,0,,Протездік денелер мен физикалық денелер арасында ешқандай айырмашылық жоқ жаңа адам әлемі дегеніміз не?
Dialogue: 0,0:33:33.26,0:33:35.93,Default,,0,0,0,,Сіз шынымен өзгердіңіз.
Dialogue: 0,0:33:43.10,0:33:46.31,Default,,0,0,0,,Кейбір адамдар болашақтан бас тартады.
Dialogue: 0,0:33:46.44,0:33:49.90,Default,,0,0,0,,Ал болашақта артта қалатындар
Dialogue: 0,0:33:54.07,0:33:57.41,Default,,0,0,0,,Мен протездік денелердің болашағын үшінші елдерге жеткізгім келеді
Dialogue: 0,0:33:59.57,0:34:01.24,Default,,0,0,0,,Менімен бірге барғың келе ме?
Dialogue: 0,0:34:02.62,0:34:06.08,Default,,0,0,0,,Сіз өз күшіңізді еркін пайдалануыңыз керек.
Dialogue: 0,0:34:06.21,0:34:09.50,Default,,0,0,0,,Адамдарды басқаруға шеберлердің астында емес...
Dialogue: 0,0:34:11.71,0:34:13.76,Default,,0,0,0,,Соғыс аяқталды.
Dialogue: 0,0:34:13.88,0:34:14.96,Default,,0,0,0,,Ол жалғасады
Dialogue: 0,0:34:15.63,0:34:19.30,Default,,0,0,0,,Егер ел қолайсыз болса, ол жай ғана біржақты тәртіппен кетеді.
Dialogue: 0,0:34:22.10,0:34:25.39,Default,,0,0,0,,Менің бұл елде істейтін жұмысым бар.
Dialogue: 0,0:34:26.52,0:34:27.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:28.31,0:34:29.85,Default,,0,0,0,,Осыдан кейін уақытыңыз бар ма?
Dialogue: 0,0:34:30.15,0:34:33.73,Default,,0,0,0,,Егер біз вестибюльді бөліссек, кез келген уақытта кездесе аламыз, солай ма?
Dialogue: 0,0:34:33.86,0:34:35.82,Default,,0,0,0,,Мен сіздің елесіңізге тиісуім мүмкін
Dialogue: 0,0:34:36.07,0:34:37.78,Default,,0,0,0,,Мен тосқауылды алып тастаймын.
Dialogue: 0,0:34:37.90,0:34:38.74,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:34:38.86,0:34:41.45,Default,,0,0,0,,Егер сіз ішке кірсеңіз, миыңызды күйдіріп алуыңыз мүмкін.
Dialogue: 0,0:34:41.57,0:34:43.62,Default,,0,0,0,,Бұл тұрарлық сияқты.
Dialogue: 0,0:34:44.74,0:34:50.75,Default,,0,0,0,,♪～
Dialogue: 0,0:35:06.43,0:35:08.35,Default,,0,0,0,,Бұл сіздің денеңіз...
Dialogue: 0,0:35:10.23,0:35:12.27,Default,,0,0,0,,Бұл сенің қолың...
Dialogue: 0,0:35:15.82,0:35:17.03,Default,,0,0,0,,Цу...! Қарғыс атқыр...
Dialogue: 0,0:35:18.32,0:35:19.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:34.04,0:35:35.92,Default,,0,0,0,,Не... Уф!
Dialogue: 0,0:35:36.46,0:35:37.88,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:35:38.01,0:35:39.72,Default,,0,0,0,,Қаш, Мотоко!
Dialogue: 0,0:35:49.85,0:35:51.35,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:35:51.64,0:35:53.31,Default,,0,0,0,,Сүртіңіз!
Dialogue: 0,0:35:54.11,0:35:54.94,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:36:07.83,0:36:09.83,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:36:11.75,0:36:12.58,Default,,0,0,0,,Уф
Dialogue: 0,0:36:14.71,0:36:16.34,Default,,0,0,0,,Акира... Ух...
Dialogue: 0,0:36:17.59,0:36:18.42,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:36:18.55,0:36:20.88,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:36:22.26,0:36:23.13,Default,,0,0,0,,Ах! !
Dialogue: 0,0:36:27.35,0:36:28.72,Default,,0,0,0,,Уф
Dialogue: 0,0:36:29.27,0:36:31.81,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм...
Dialogue: 0,0:36:31.93,0:36:37.90,Default,,0,0,0,,♪～
Dialogue: 0,0:36:47.49,0:36:51.45,Default,,0,0,0,,Тек қалдық ластануға сүйеніп, нақты растай алмадым.
Dialogue: 0,0:36:51.58,0:36:57.59,Default,,0,0,0,,♪～
Dialogue: 0,0:37:07.93,0:37:10.81,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:37:10.81,0:37:12.06,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:37:10.81,0:37:12.06,Default,,0,0,0,,Көңіл айтуыңызға рахмет
Dialogue: 0,0:37:13.39,0:37:15.27,Default,,0,0,0,,Паз 9-бөліммен оқиға орнында тексеру жүргізуде
Dialogue: 0,0:37:16.02,0:37:18.48,Default,,0,0,0,,Қарсыласым – кәсіпқой, мен шатассам да.
Dialogue: 0,0:37:19.07,0:37:21.23,Default,,0,0,0,,Оның оқиғаға қатысы бар-жоғы белгісіз болса да...
Dialogue: 0,0:37:21.36,0:37:23.99,Default,,0,0,0,,Қалыпты жауап сізге қауіпсіздікті қамтамасыз ету болып табылады.
Dialogue: 0,0:37:24.11,0:37:26.45,Default,,0,0,0,,Маған керек емес. Ал ол адам ше?
Dialogue: 0,0:37:26.57,0:37:28.95,Default,,0,0,0,,Тыңдау аяқталысымен үйге жіберіледі.
Dialogue: 0,0:37:29.08,0:37:30.95,Default,,0,0,0,,Уайымдамаңыз, біз қызметкерлерді аламыз.
Dialogue: 0,0:37:31.20,0:37:32.25,Default,,0,0,0,,Иә
Dialogue: 0,0:37:32.37,0:37:35.54,Default,,0,0,0,,Әскерилер Скрасс туралы ақпаратты жариялаудан бас тартады.
Dialogue: 0,0:37:35.67,0:37:37.79,Default,,0,0,0,,Оның сізге қандай қатысы бар?
Dialogue: 0,0:37:39.96,0:37:41.92,Default,,0,0,0,,Көмек қажет болған кезде оны шақырыңыз.
Dialogue: 0,0:37:42.84,0:37:45.72,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:37:45.84,0:37:49.89,Default,,0,0,0,,Бұл Скрастың кек алуы ма? Жігітімнің қарапайым адам болғаны бір жеңілдеді.
Dialogue: 0,0:37:50.26,0:37:52.52,Default,,0,0,0,,Ағып кетті деп күдіктенудің қажеті жоқ
Dialogue: 0,0:37:54.31,0:37:55.23,Default,,0,0,0,,Сізді ұрып-соқты
Dialogue: 0,0:37:55.94,0:37:59.23,Default,,0,0,0,,Үшіншісі – жағалаудағы материалдарды басқару орталығы.
Dialogue: 0,0:37:59.77,0:38:03.90,Default,,0,0,0,,Жарылыстан 30 секунд бұрын Скрасстың атына орындау туралы бұйрық ұсталды.
Dialogue: 0,0:38:04.03,0:38:05.44,Default,,0,0,0,,Барлық сызық жоғалып кетті
Dialogue: 0,0:38:05.57,0:38:07.49,Default,,0,0,0,,Бұл бақылауды білдірмейді.
Dialogue: 0,0:38:07.61,0:38:08.82,Default,,0,0,0,,Материалдарды басқару тізімінен -
Dialogue: 0,0:38:08.95,0:38:11.41,Default,,0,0,0,,Қосылған қару жасаушыны табыңыз
Dialogue: 0,0:38:11.53,0:38:12.74,Default,,0,0,0,,Қару жасау?
Dialogue: 0,0:38:12.87,0:38:14.95,Default,,0,0,0,,Алғашқы құрбан болса да, асығыңыз.
Dialogue: 0,0:38:15.50,0:38:17.87,Default,,0,0,0,,Вирус бомбасының тактикалық жетекшісі
Dialogue: 0,0:38:18.00,0:38:20.84,Default,,0,0,0,,Скрасс деп мәлімдеген байланыс көзі: Кез келген дереккөз жақсы.
Dialogue: 0,0:38:20.96,0:38:22.13,Default,,0,0,0,,Бір нәрсені алыңыз
Dialogue: 0,0:38:22.80,0:38:24.63,Default,,0,0,0,,Енді неге сөйлеспейміз?
Dialogue: 0,0:38:25.09,0:38:27.38,Default,,0,0,0,,Скрасстың өліміне неге сонша сенімдісің?
Dialogue: 0,0:38:27.38,0:38:28.30,Default,,0,0,0,,Скрасстың өліміне неге сонша сенімдісің?
Dialogue: 0,0:38:27.38,0:38:28.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:38:28.30,0:38:28.43,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:38:28.43,0:38:29.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:38:28.43,0:38:29.26,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:38:31.39,0:38:32.39,Default,,0,0,0,,Сіз...
Dialogue: 0,0:38:32.51,0:38:35.43,Default,,0,0,0,,Майор Құсанағы осында деп естідім.
Dialogue: 0,0:38:35.56,0:38:36.73,Default,,0,0,0,,Не?
Dialogue: 0,0:38:42.77,0:38:44.15,Default,,0,0,0,,Маған өз ісіңді айт
Dialogue: 0,0:38:44.48,0:38:47.82,Default,,0,0,0,,Оның маған берген тізімі жалған болды.
Dialogue: 0,0:38:48.28,0:38:50.53,Default,,0,0,0,,Қару-жарақ саудасы жолында өлтірілген детектив...
Dialogue: 0,0:38:50.66,0:38:53.12,Default,,0,0,0,,Одан мәлімет алған соң өлтірілді.
Dialogue: 0,0:38:53.53,0:38:55.20,Default,,0,0,0,,Бұл кең таралған.
Dialogue: 0,0:38:55.33,0:38:59.58,Default,,0,0,0,,Протез жасаушы техникке қатысты протездік денелерге қатысты оқиғаларға жауаптылық
Dialogue: 0,0:39:00.54,0:39:03.84,Default,,0,0,0,,Мен кеше жарылыс болған бөгеттің меңгерушісімін.
Dialogue: 0,0:39:05.00,0:39:06.84,Default,,0,0,0,,Ол оққағарды да ұстайды.
Dialogue: 0,0:39:06.96,0:39:08.30,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:39:09.26,0:39:12.26,Default,,0,0,0,,Сіздің сүйіктіңізге көз алдыңызда шабуыл жасағанда қандай сезімде болдыңыз?
Dialogue: 0,0:39:14.18,0:39:17.89,Default,,0,0,0,,Қылмыскерге деген ашу мен кінәні сезінесіз.
Dialogue: 0,0:39:18.02,0:39:20.23,Default,,0,0,0,,Менің ғашығыма мен үшін шабуыл жасалды...
Dialogue: 0,0:39:23.61,0:39:25.48,Default,,0,0,0,,Ол да сен сияқты еді.
Dialogue: 0,0:39:25.61,0:39:27.23,Default,,0,0,0,,Ашу және кінә
Dialogue: 0,0:39:27.86,0:39:29.90,Default,,0,0,0,,Ол бірдеңені жасырып тұр
Dialogue: 0,0:39:30.03,0:39:32.32,Default,,0,0,0,,Дамбаның өлі детектив протездік денесі
Dialogue: 0,0:39:32.45,0:39:34.20,Default,,0,0,0,,Сіз де, майор.
Dialogue: 0,0:39:34.95,0:39:37.50,Default,,0,0,0,,Барлығы Хосе Акиламен байланысты
Dialogue: 0,0:39:37.79,0:39:38.62,Default,,0,0,0,,Ішек
Dialogue: 0,0:39:39.75,0:39:40.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:40.92,0:39:43.38,Default,,0,0,0,,Жан-жағына өз көзімен қарайтын детектив!
Dialogue: 0,0:39:43.50,0:39:45.04,Default,,0,0,0,,Енді ешқашан бетіңізді көрсетпеңіз!
Dialogue: 0,0:39:47.25,0:39:51.51,Default,,0,0,0,,Ах... итте~
Dialogue: 0,0:39:51.63,0:39:57.64,Default,,0,0,0,,♪～
Dialogue: 0,0:40:13.07,0:40:14.70,Default,,0,0,0,,Сіз ақымақсыз, полковник!
Dialogue: 0,0:40:15.03,0:40:17.03,Default,,0,0,0,,Ааа! !
Dialogue: 0,0:40:17.16,0:40:18.49,Default,,0,0,0,,Агрессивті кедергі!
Dialogue: 0,0:40:18.62,0:40:19.66,Default,,0,0,0,,Біртүрлі. Шынында да, бәрі біртүрлі.
Dialogue: 0,0:40:20.37,0:40:23.25,Default,,0,0,0,,Егер қару-жарақ өнеркәсібіне құқықтарды отандық фракциялар тартып алса...
Dialogue: 0,0:40:23.37,0:40:25.46,Default,,0,0,0,,Сізді картель өлтіреді
Dialogue: 0,0:40:25.58,0:40:28.84,Default,,0,0,0,,Бірақ сіз менен құтылуға және менің деректерімді ұрлауға асығасыз ба?
Dialogue: 0,0:40:28.96,0:40:32.63,Default,,0,0,0,,Сіз үлкен іс болып, достарыңызды босата алмайсыз ба?
Dialogue: 0,0:40:33.05,0:40:34.80,Default,,0,0,0,,Деректер қайда?
Dialogue: 0,0:40:35.30,0:40:36.93,Default,,0,0,0,,Мәміле жасалды.
Dialogue: 0,0:40:37.05,0:40:41.23,Default,,0,0,0,,Оның ақпараты үшін және Скрассты қайтарғаныңыз үшін рахмет.
Dialogue: 0,0:40:41.35,0:40:42.89,Default,,0,0,0,,Мен бұл елден кетемін
Dialogue: 0,0:40:43.02,0:40:44.35,Default,,0,0,0,,Сіз де солай істеуіңіз керек.
Dialogue: 0,0:40:44.48,0:40:45.48,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:40:45.60,0:40:47.40,Default,,0,0,0,,Ах... Жоқ!
Dialogue: 0,0:40:48.23,0:40:49.48,Default,,0,0,0,,Ga!
Dialogue: 0,0:40:52.32,0:40:56.03,Default,,0,0,0,,Біз вирус пен компьютерді орауда сәтті болдық.
Dialogue: 0,0:40:56.16,0:40:58.41,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:40:58.62,0:41:01.87,Default,,0,0,0,,Компьютермен соңғы нұсқаны жаңартуды орындаңыз
Dialogue: 0,0:41:02.29,0:41:04.37,Default,,0,0,0,,Қалағаныңызша Скрасс болыңыз.
Dialogue: 0,0:41:04.50,0:41:06.63,Default,,0,0,0,,Уау~
Dialogue: 0,0:41:13.80,0:41:16.47,Default,,0,0,0,,Қолы ашық өлді...
Dialogue: 0,0:41:16.59,0:41:22.60,Default,,0,0,0,,♪～
Dialogue: 0,0:41:29.61,0:41:30.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:36.70,0:41:37.62,Default,,0,0,0,,На
Dialogue: 0,0:41:38.20,0:41:39.49,Default,,0,0,0,,Нұсқау бойынша.
Dialogue: 0,0:41:39.62,0:41:42.62,Default,,0,0,0,,Екі қоғамдық қауіпсіздік қызметкері қаза тапты, Хосе Акила хабарсыз кетті
Dialogue: 0,0:41:42.95,0:41:44.66,Default,,0,0,0,,Нысанаға түскен майор емес пе?
Dialogue: 0,0:41:44.79,0:41:46.71,Default,,0,0,0,,Әй, тізімге қара.
Dialogue: 0,0:41:46.79,0:41:48.50,Default,,0,0,0,,Бұл жай ғана болжам, бірақ...
Dialogue: 0,0:41:48.63,0:41:52.34,Default,,0,0,0,,Булану бомбасының шынайы тұлғасы протездік дененің мүшелері болып табылады.
Dialogue: 0,0:41:52.46,0:41:55.72,Default,,0,0,0,,Ғимарат жарылыс болған жерде толық протез киген күзетші де болған.
Dialogue: 0,0:41:55.84,0:41:58.68,Default,,0,0,0,,Сол адамның қолтаңбасы аяқ-қолды басқару жазбаларында кездеседі.
Dialogue: 0,0:42:02.10,0:42:03.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:42:03.64,0:42:04.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:42:06.69,0:42:07.85,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:42:10.44,0:42:12.27,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:42:12.69,0:42:15.49,Default,,0,0,0,,Бұл әр секунд сайын дамып келе жатқан шабуыл қабырғасы.
Dialogue: 0,0:42:15.61,0:42:17.24,Default,,0,0,0,,Миыңның қуырылғанын қаламасаң, айт!
Dialogue: 0,0:42:17.45,0:42:18.99,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:42:19.66,0:42:21.99,Default,,0,0,0,,Әй... сен бізге билік бердің!
Dialogue: 0,0:42:22.24,0:42:23.99,Default,,0,0,0,,Жаңа Scrassus!
Dialogue: 0,0:42:24.66,0:42:26.41,Default,,0,0,0,,Бұл сиқыр сияқты болды
Dialogue: 0,0:42:26.54,0:42:30.33,Default,,0,0,0,,Өлген Скрасстың артында қалған жауынгерлік оқу бағдарламасы
Dialogue: 0,0:42:30.46,0:42:34.00,Default,,0,0,0,,Мен оны компьютеріме вируспен бірге жібердім.
Dialogue: 0,0:42:34.13,0:42:38.34,Default,,0,0,0,,Дайындығы жоқ мен енді сенімен күресе аламын.
Dialogue: 0,0:42:38.63,0:42:39.80,Default,,0,0,0,,Есіміңді айт!
Dialogue: 0,0:42:40.51,0:42:42.05,Default,,0,0,0,,Хосе Акила
Dialogue: 0,0:42:42.18,0:42:44.27,Default,,0,0,0,,Мен де сен сияқты жапонмын!
Dialogue: 0,0:42:52.77,0:42:55.44,Default,,0,0,0,,Хосе қашып кетті. Сіздің ойыңыз бар ма?
Dialogue: 0,0:42:55.57,0:42:57.03,Default,,0,0,0,,Неге мен...
Dialogue: 0,0:42:57.15,0:42:59.78,Default,,0,0,0,,Қазір көздерің не көріп тұр?
Dialogue: 0,0:43:01.74,0:43:03.74,Default,,0,0,0,,Зинджи Бекка Аль Саид
Dialogue: 0,0:43:04.62,0:43:07.79,Default,,0,0,0,,Құзан су кәсіпорнының бастығы...
Dialogue: 0,0:43:08.29,0:43:10.67,Default,,0,0,0,,Қару-жарақ сату тобына демеушілік жасау
Dialogue: 0,0:43:10.92,0:43:12.92,Default,,0,0,0,,Бұл ма? туннельден шығу
Dialogue: 0,0:43:13.63,0:43:16.59,Default,,0,0,0,,Отандық қару жасаушы Harimadara Heavy Industries
Dialogue: 0,0:43:17.46,0:43:20.80,Default,,0,0,0,,Басшылар мен Қорғаныс министрінің орынбасары бірінші зауытты тексеріп жатыр.
Dialogue: 0,0:43:21.39,0:43:22.89,Default,,0,0,0,,Ұсынылатын кедергілер
Dialogue: 0,0:43:23.01,0:43:24.47,Default,,0,0,0,,Деректерді 9-бөлімге беріңіз
Dialogue: 0,0:43:24.60,0:43:26.72,Default,,0,0,0,,Пазу Бома Сайто Сайтқа өтіңіз
Dialogue: 0,0:43:29.64,0:43:32.61,Default,,0,0,0,,Жарылғыш заттарды залалсыздандыру тобын және кибертехниктерді шақырыңыз.
Dialogue: 0,0:43:32.73,0:43:35.19,Default,,0,0,0,,Деструктивті электрондық шабуылдың жоғары мүмкіндігі
Dialogue: 0,0:43:40.07,0:43:42.28,Default,,0,0,0,,Сіз нені айтасыз? Режиссер Арамаки
Dialogue: 0,0:43:42.41,0:43:43.74,Default,,0,0,0,,Қазір эвакуациялаңыз
Dialogue: 0,0:43:44.33,0:43:46.70,Default,,0,0,0,,Сіз және осы нысан нысана болып табылады.
Dialogue: 0,0:43:47.41,0:43:49.16,Default,,0,0,0,,Не... не? бұл!
Dialogue: 0,0:43:49.37,0:43:51.58,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:43:51.71,0:43:52.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:52.96,0:43:54.63,Default,,0,0,0,,Бұл бомба! Жүгіріп кету!
Dialogue: 0,0:43:55.71,0:43:57.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:00.76,0:44:02.64,Default,,0,0,0,,Жоқ! (Сайт) Қарғыс атсын!
Dialogue: 0,0:44:02.76,0:44:05.10,Default,,0,0,0,,Пазу Бома осылай!
Dialogue: 0,0:44:08.10,0:44:09.77,Default,,0,0,0,,Көмектесіңіз! маған көмектесші!
Dialogue: 0,0:44:11.35,0:44:13.81,Default,,0,0,0,,Уау! !
Dialogue: 0,0:44:18.73,0:44:21.11,Default,,0,0,0,,Шүкір, жалыннан дыбыс шығара алмаймын.
Dialogue: 0,0:44:21.24,0:44:23.70,Default,,0,0,0,,Бұл да ақылсыз болды.
Dialogue: 0,0:44:24.62,0:44:26.24,Default,,0,0,0,,Министрдің орынбасары, аман болыңыз.
Dialogue: 0,0:44:26.37,0:44:28.29,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:44:33.92,0:44:35.04,Default,,0,0,0,,Логикома
Dialogue: 0,0:44:35.17,0:44:36.04,Default,,0,0,0,,Уа!
Dialogue: 0,0:44:38.63,0:44:40.46,Default,,0,0,0,,Біздің өнімдер...
Dialogue: 0,0:44:44.13,0:44:45.43,Default,,0,0,0,,Ішке кір!
Dialogue: 0,0:44:46.22,0:44:47.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:50.27,0:44:52.48,Default,,0,0,0,,Полковник Хозуми туралы мәліметтердің барлығы осы.
Dialogue: 0,0:44:52.77,0:44:53.89,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:44:54.02,0:44:57.19,Default,,0,0,0,,Біз картаны аламыз, сіз мерзімін аласыз.
Dialogue: 0,0:44:57.65,0:45:00.90,Default,,0,0,0,,Скрасс екеуінің қарым-қатынасы туралы айтыңыз.
Dialogue: 0,0:45:01.36,0:45:02.95,Default,,0,0,0,,Оны одан тыңдаңыз.
Dialogue: 0,0:45:03.07,0:45:08.24,Default,,0,0,0,,Ластанған компьютерлік миыңыз қызық, бірақ мен оны жұқтырмай тұрып кесіп тастаймын.
Dialogue: 0,0:45:13.50,0:45:14.58,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:45:24.55,0:45:26.01,Default,,0,0,0,,Ластану...
Dialogue: 0,0:45:26.51,0:45:29.56,Default,,0,0,0,,Шетелдік компания арнайы салық салу салдарынан банкротқа ұшыраса...
Dialogue: 0,0:45:30.22,0:45:32.56,Default,,0,0,0,,Бұған рұқсат етілген бе?
Dialogue: 0,0:45:32.68,0:45:35.27,Default,,0,0,0,,Үйдегілер осылай істеуі мүмкін.
Dialogue: 0,0:45:36.44,0:45:40.32,Default,,0,0,0,,Сіз не істемексіз? Сіз полковникті өлтіресіз бе?
Dialogue: 0,0:45:40.69,0:45:41.78,Default,,0,0,0,,Бітті
Dialogue: 0,0:45:41.78,0:45:42.19,Default,,0,0,0,,Бітті
Dialogue: 0,0:45:41.78,0:45:42.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:45:42.19,0:45:42.32,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:45:42.32,0:45:43.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:45:42.32,0:45:43.44,Default,,0,0,0,,Мен де сен
Dialogue: 0,0:45:43.44,0:45:44.40,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:45:47.24,0:45:48.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:50.95,0:45:52.79,Default,,0,0,0,,Қашып, ішкі фракцияға бағын.
Dialogue: 0,0:45:53.66,0:45:57.50,Default,,0,0,0,,Сіздің компанияңыз осы елдің салықтары атынан жойылады.
Dialogue: 0,0:45:58.13,0:46:00.46,Default,,0,0,0,,Егер сіз осылай жүрсеңіз, сізді картель өлтіреді.
Dialogue: 0,0:46:01.00,0:46:02.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:03.26,0:46:04.84,Default,,0,0,0,,Майор, жақсысың ба?
Dialogue: 0,0:46:04.97,0:46:06.26,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:46:06.38,0:46:09.18,Default,,0,0,0,,Сіз және детектив күзетшіні басып тұруыңыз керек.
Dialogue: 0,0:46:10.18,0:46:13.39,Default,,0,0,0,,Скрасс... Мен мұны істеймін.
Dialogue: 0,0:46:18.81,0:46:20.86,Default,,0,0,0,,Қыңыр бол Жарайды... Қорқынышты
Dialogue: 0,0:46:26.70,0:46:27.91,Default,,0,0,0,,Не?
Dialogue: 0,0:46:28.03,0:46:29.57,Default,,0,0,0,,Бұл әлі күнге дейін Матеба ма?
Dialogue: 0,0:46:29.70,0:46:30.95,Default,,0,0,0,,Менің кетуім керек…
Dialogue: 0,0:46:31.07,0:46:32.95,Default,,0,0,0,,Ең сенімді
Dialogue: 0,0:46:33.08,0:46:34.08,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:46:40.71,0:46:41.54,Default,,0,0,0,,Га
Dialogue: 0,0:46:43.84,0:46:44.76,Default,,0,0,0,,Қан ізі
Dialogue: 0,0:46:45.30,0:46:47.13,Default,,0,0,0,,Біреу атып кетті.
Dialogue: 0,0:46:53.10,0:46:53.93,Default,,0,0,0,,Таңба…
Dialogue: 0,0:47:03.40,0:47:04.36,Default,,0,0,0,,Ммм...
Dialogue: 0,0:47:12.78,0:47:15.99,Default,,0,0,0,,Антенна... Бұл протездік бомба ма?
Dialogue: 0,0:47:16.33,0:47:18.00,Default,,0,0,0,,Арх! (Бато) А...
Dialogue: 0,0:47:19.04,0:47:20.54,Default,,0,0,0,,Цу… уф…
Dialogue: 0,0:47:20.67,0:47:22.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:22.79,0:47:23.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:26.71,0:47:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:29.42,0:47:31.01,Default,,0,0,0,,Керемет
Dialogue: 0,0:47:34.43,0:47:36.35,Default,,0,0,0,,Қазір бұл әділ емес.
Dialogue: 0,0:47:36.60,0:47:38.93,Default,,0,0,0,,Менің көзіме кім басып кірді?
Dialogue: 0,0:47:39.35,0:47:40.64,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:47:43.19,0:47:44.48,Default,,0,0,0,,Скрассус –
Dialogue: 0,0:47:44.61,0:47:48.36,Default,,0,0,0,,Соғыс батпағына ұшыраған жалғыз солдат сол еді.
Dialogue: 0,0:47:48.90,0:47:52.07,Default,,0,0,0,,Мен сенен неге өлтірілдің деп сұрағым келді.
Dialogue: 0,0:47:53.82,0:47:57.58,Default,,0,0,0,,Скрассты сен өлтірген жоқсың, ақыры түсіндім.
Dialogue: 0,0:47:58.04,0:47:59.20,Default,,0,0,0,,Ах
Dialogue: 0,0:48:00.33,0:48:03.92,Default,,0,0,0,,Үйге барыңыз, антеннаңыз осы жылдамдықпен қосылады.
Dialogue: 0,0:48:05.25,0:48:07.05,Default,,0,0,0,,Мен оны тоқтата алмаймын
Dialogue: 0,0:48:07.17,0:48:10.59,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:48:16.56,0:48:17.72,Default,,0,0,0,,Уау
Dialogue: 0,0:48:17.85,0:48:18.93,Default,,0,0,0,,Уф
Dialogue: 0,0:48:21.39,0:48:23.90,Default,,0,0,0,,Уф... уау
Dialogue: 0,0:48:24.19,0:48:27.23,Default,,0,0,0,,Жосуке—
Dialogue: 0,0:48:32.36,0:48:33.36,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:48:33.49,0:48:36.41,Default,,0,0,0,,Сіз менің көзқарасыма өзіңіздің көзқарасыңызға ұқсас жолмен кірдіңіз.
Dialogue: 0,0:48:36.53,0:48:38.91,Default,,0,0,0,,Қарғыс атсын! Маған жауап беріңізші, майор!
Dialogue: 0,0:48:39.04,0:48:45.04,Default,,0,0,0,,♪～
Dialogue: 0,0:48:51.47,0:48:53.13,Default,,0,0,0,,Уа, ау...
Dialogue: 0,0:48:57.43,0:49:00.56,Default,,0,0,0,,Әскерилер не істейді? Осы қарқынмен біз жойыламыз!
Dialogue: 0,0:49:00.89,0:49:02.64,Default,,0,0,0,,Әуе кемесі тәркіленді
Dialogue: 0,0:49:02.77,0:49:05.81,Default,,0,0,0,,Қаптамадағы нәрсені кесіп алмасаңыз, ол тоқтамайды.
Dialogue: 0,0:49:05.94,0:49:07.44,Default,,0,0,0,,Трансплантацияланған жады
Dialogue: 0,0:49:07.56,0:49:08.40,Default,,0,0,0,,Не?
Dialogue: 0,0:49:08.86,0:49:11.61,Default,,0,0,0,,Пакеттік киберкеңістік – вирустың иесі
Dialogue: 0,0:49:12.32,0:49:16.11,Default,,0,0,0,,Мен Калдиста таратқан тактикалық бағдарламаны жаттап алдым.
Dialogue: 0,0:49:16.70,0:49:18.03,Default,,0,0,0,,Менің көшірмесім
Dialogue: 0,0:49:22.75,0:49:24.75,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:49:26.29,0:49:27.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:32.76,0:49:34.01,Default,,0,0,0,,Элемент…
Dialogue: 0,0:49:48.94,0:49:50.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:55.57,0:49:56.61,Default,,0,0,0,,Фу…
Dialogue: 0,0:50:01.99,0:50:06.04,Default,,0,0,0,,Ақырында қуып жетіп, қолға түстім.
Dialogue: 0,0:50:07.67,0:50:10.29,Default,,0,0,0,,Буып-түйілген нәрсе - менің компьютерім.
Dialogue: 0,0:50:10.42,0:50:13.88,Default,,0,0,0,,Егер сіз триггерді тартсаңыз, сіз және сіздің достарыңыз құтқарылады.
Dialogue: 0,0:50:17.38,0:50:20.01,Default,,0,0,0,,Ғашық болған осы дүние.
Dialogue: 0,0:50:23.81,0:50:27.44,Default,,0,0,0,,Сатып кететін күнге дейін жүре бер
Dialogue: 0,0:50:31.77,0:50:33.11,Default,,0,0,0,,Скрасс…
Dialogue: 0,0:50:34.15,0:50:36.07,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:50:41.03,0:50:42.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:56.26,0:50:57.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:03.93,0:51:05.27,Default,,0,0,0,,Жек көру?
Dialogue: 0,0:51:05.56,0:51:07.48,Default,,0,0,0,,Тоқтатылды...
Dialogue: 0,0:51:16.44,0:51:17.69,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:51:17.82,0:51:20.11,Default,,0,0,0,,Ұлы Отан соғысынан аман өтсек те...
Dialogue: 0,0:51:20.24,0:51:22.45,Default,,0,0,0,,Біз бәріміз бітпейтін соғыста қалдық...
Dialogue: 0,0:51:22.57,0:51:24.53,Default,,0,0,0,,Өмірге қамқорлық жасау
Dialogue: 0,0:51:24.66,0:51:27.54,Default,,0,0,0,,Одан басқа оны тоқтатудың амалы жоқ сияқты.
Dialogue: 0,0:51:27.91,0:51:29.71,Default,,0,0,0,,Сіз де солай болдыңыз, солай ма?
Dialogue: 0,0:51:31.29,0:51:33.67,Default,,0,0,0,,Скрасстың шынайы тұлғасы сізсіз.
Dialogue: 0,0:51:33.79,0:51:37.17,Default,,0,0,0,,Тәуелсіздік күштерін қолдап, жалған өлім
Dialogue: 0,0:51:37.30,0:51:40.18,Default,,0,0,0,,Осыдан кейін сіз басқарған партизандар түгелдей жойылды.
Dialogue: 0,0:51:41.09,0:51:43.68,Default,,0,0,0,,Бұл тіпті есіме түсіргім де келмейтін стратегия шығар.
Dialogue: 0,0:51:45.14,0:51:48.64,Default,,0,0,0,,Содан бері мен протезді жиі ауыстыруды қойдым.
Dialogue: 0,0:51:49.23,0:51:51.14,Default,,0,0,0,,Мен өзімді жоғалтуға шабуыл жасадым.
Dialogue: 0,0:51:51.65,0:51:54.11,Default,,0,0,0,,Мен кім екенімді білмеймін...
Dialogue: 0,0:51:54.40,0:51:58.44,Default,,0,0,0,,Мен біреудің робот емес екенімді айтқанын қалаймын
Dialogue: 0,0:52:01.57,0:52:02.45,Default,,0,0,0,,Жаппай өндіріске негізделген -
Dialogue: 0,0:52:02.57,0:52:05.12,Default,,0,0,0,,Түпнұсқа күйге келтіруге неге ерекше көңіл бөлесіз?
Dialogue: 0,0:52:05.99,0:52:09.54,Default,,0,0,0,,Осыншама көп протездік денені қысқа уақыт ішінде басқара алуыңыздың өзі таң қалдырады.
Dialogue: 0,0:52:10.00,0:52:12.54,Default,,0,0,0,,Мен ұйықтайын деп жатырмын. Үйге бара аласыз.
Dialogue: 0,0:52:13.17,0:52:15.00,Default,,0,0,0,,Протездік дененің пайдасы
Dialogue: 0,0:52:15.13,0:52:18.05,Default,,0,0,0,,Ешбір оғаш бөліктер пайдаланылмауы үшін мен сізді қадағалаймын.
Dialogue: 0,0:52:18.80,0:52:21.34,Default,,0,0,0,,Иә, қалағаныңды істе.
Dialogue: 0,0:52:21.76,0:52:24.47,Default,,0,0,0,,Ха, тек рахмет айт.
Dialogue: 0,0:52:24.85,0:52:25.68,Default,,0,0,0,,Гуу
Dialogue: 0,0:52:28.31,0:52:31.60,Default,,0,0,0,,Оқиға орнындағы оқ лейтенанттың мылтығынан атылған.
Dialogue: 0,0:52:32.31,0:52:35.06,Default,,0,0,0,,Детектив Мизукидің мылтығы да оның үйінен табылды.
Dialogue: 0,0:52:35.19,0:52:37.57,Default,,0,0,0,,Және шотқа үлкен соманы аударыңыз
Dialogue: 0,0:52:39.94,0:52:42.49,Default,,0,0,0,,Хмм... қолайсыздық үшін кешіріңіз.
Dialogue: 0,0:52:42.99,0:52:44.66,Default,,0,0,0,,Үйге бара аласыз (есіктің ашылған дыбысы)
Dialogue: 0,0:52:54.71,0:52:56.04,Default,,0,0,0,,Аа, аа...
Dialogue: 0,0:52:56.17,0:52:58.67,Default,,0,0,0,,Бір саладағы біреуді қамауға алу наразылық тудырады.
Dialogue: 0,0:52:59.00,0:53:00.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:01.72,0:53:04.63,Default,,0,0,0,,Жергілікті полиция сізді арқаңыздан атып өлтіреді.
Dialogue: 0,0:53:05.01,0:53:07.76,Default,,0,0,0,,Ең дұрысы, арқаңызды бақылаңыз.
Dialogue: 0,0:53:07.89,0:53:09.35,Default,,0,0,0,,Неге бұлай айту керек?
Dialogue: 0,0:53:10.47,0:53:12.31,Default,,0,0,0,,Менің бөлімшеге қосылғыңыз келе ме?
Dialogue: 0,0:53:12.81,0:53:13.81,Default,,0,0,0,,Е...
Dialogue: 0,0:53:14.52,0:53:16.73,Default,,0,0,0,,Тәуелсіз шабуылдың басымдылығы...
Dialogue: 0,0:53:16.73,0:53:17.31,Default,,0,0,0,,Тәуелсіз шабуылдың басымдылығы...
Dialogue: 0,0:53:16.73,0:53:17.31,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:53:17.31,0:53:17.44,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:53:17.44,0:53:20.03,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:53:17.44,0:53:20.03,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:53:21.11,0:53:22.32,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:53:22.86,0:53:24.15,Default,,0,0,0,,Не! ? (Мотоко) А?
Dialogue: 0,0:53:24.28,0:53:25.61,Default,,0,0,0,,Екі аптадан кейін...?
Dialogue: 0,0:53:25.74,0:53:29.28,Default,,0,0,0,,А, жоқ, түсіндім, мен бірден барамын.
Dialogue: 0,0:53:29.78,0:53:31.87,Default,,0,0,0,,Қиын... суым жарылып кетті.
Dialogue: 0,0:53:33.00,0:53:33.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:34.08,0:53:36.04,Default,,0,0,0,,Бала дүниеге келді.
Dialogue: 0,0:53:36.17,0:53:38.21,Default,,0,0,0,,Күте тұрыңыз, мен бірден жетемін!
Dialogue: 0,0:53:38.34,0:53:39.79,Default,,0,0,0,,Тағы да сөйлесейік
Dialogue: 0,0:53:40.30,0:53:41.46,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,0:53:41.55,0:53:44.72,Default,,0,0,0,,（）
Dialogue: 0,0:53:44.84,0:53:49.10,Default,,0,0,0,,Үйленгенсіз және балаларыңыз бар ма? Хехе
Dialogue: 0,0:53:49.22,0:53:55.23,Default,,0,0,0,,♪
Dialogue: 0,0:57:45.96,0:57:51.13,Default,,0,0,0,,♪～
Dialogue: 0,0:57:52.63,0:57:58.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory