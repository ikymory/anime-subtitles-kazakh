Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.46,0:00:05.67,Default,,0,0,0,,Бұл... Миброның негізі ме?
Dialogue: 0,0:00:06.38,0:00:08.88,Default,,0,0,0,,Бұл Яги мырзаның үйі, мен оған қарыздармын.
Dialogue: 0,0:00:08.96,0:00:11.67,Default,,0,0,0,,Тамағыңызды да, ұйықтауыңызды да бөлісесіз.
Dialogue: 0,0:00:11.76,0:00:16.47,Default,,0,0,0,,Енді ойлап қарасам, көрші балалар осы үй туралы айтып жатыр екен.
Dialogue: 0,0:00:16.55,0:00:19.18,Default,,0,0,0,,Не? Не айтылып жатыр?
Dialogue: 0,0:00:21.31,0:00:22.77,Default,,0,0,0,,Жындардың үйі
Dialogue: 0,0:00:23.27,0:00:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:24.52,0:00:26.52,Default,,0,0,0,,Бұл біз туралы.
Dialogue: 0,0:00:28.82,0:00:32.19,Default,,0,0,0,,Хиджиката мырза мені қорқытып қойған.
Dialogue: 0,0:00:32.28,0:00:34.78,Default,,0,0,0,,Ым, бәрі қайда?
Dialogue: 0,0:00:34.86,0:00:37.03,Default,,0,0,0,,Яги мырза жиналыста болды ма?
Dialogue: 0,0:00:37.12,0:00:38.53,Default,,0,0,0,,Сіз бақшада күтесіз.
Dialogue: 0,0:00:40.04,0:00:42.66,Default,,0,0,0,,Ироха әже
Dialogue: 0,0:00:43.37,0:00:47.83,Default,,0,0,0,,Мүмкін мен қауіпті жерге келген шығармын.
Dialogue: 0,0:00:49.04,0:00:54.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:13.92,0:02:18.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:25.01,0:02:26.52,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:02:26.60,0:02:29.52,Default,,0,0,0,,Не? Жіңішке иіс бар
Dialogue: 0,0:02:30.02,0:02:31.94,Default,,0,0,0,,Ах
Dialogue: 0,0:02:32.02,0:02:34.07,Default,,0,0,0,,(Сарбаздардың айқайы)
Dialogue: 0,0:02:34.15,0:02:35.82,Default,,0,0,0,,Гуааах
Dialogue: 0,0:02:35.90,0:02:37.86,Default,,0,0,0,,О, жақсысың ба?
Dialogue: 0,0:02:37.94,0:02:39.24,Default,,0,0,0,,үшінн қайта әкелу – басты мақсат.
Dialogue: 0,0:02:39.32,0:02:41.03,Default,,0,0,0,,Бұл тәтті, Саносуке!
Dialogue: 0,0:02:41.11,0:02:45.24,Default,,0,0,0,,Сауда-саттықтың айлалары Шинпачи Нагакураға ұқсамайды деп ойлаймын!
Dialogue: 0,0:02:45.33,0:02:47.45,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:02:47.95,0:02:49.71,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:02:49.79,0:02:50.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:50.71,0:02:51.62,Default,,0,0,0,,Ах
Dialogue: 0,0:02:51.71,0:02:55.25,Default,,0,0,0,,Иә? Сен несің, неге рұқсатсыз кірдің?
Dialogue: 0,0:02:55.34,0:02:57.17,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:02:57.26,0:02:58.46,Default,,0,0,0,,Жаңадан келген
Dialogue: 0,0:03:00.01,0:03:01.47,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:03:02.14,0:03:03.55,Default,,0,0,0,,Жаңадан келген адам?
Dialogue: 0,0:03:03.64,0:03:07.97,Default,,0,0,0,,Хиджиката: Мені қалжыңдап тұрсың ба? Бұл ойын емес.
Dialogue: 0,0:03:08.06,0:03:10.02,Default,,0,0,0,,Менің азу тістерім шайнап жатыр!
Dialogue: 0,0:03:10.10,0:03:12.65,Default,,0,0,0,,Қалжыңдап тұрған сенсің, Саносуке.
Dialogue: 0,0:03:12.73,0:03:15.15,Default,,0,0,0,,Бетіңізді жуып, басыңызды суытыңыз.
Dialogue: 0,0:03:15.23,0:03:16.32,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:03:16.40,0:03:20.95,Default,,0,0,0,,Соудзи... Мен сенің әзілдеріңнен шаршадым.
Dialogue: 0,0:03:21.53,0:03:23.03,Default,,0,0,0,,Бірақ не болды?
Dialogue: 0,0:03:23.11,0:03:26.08,Default,,0,0,0,,Егер сен мені жалайтын болсаң, мен саған азапты көзқараспен қараймын, Нагакура-сан.
Dialogue: 0,0:03:26.16,0:03:29.70,Default,,0,0,0,,(Харада және басқалардың даулары)
Dialogue: 0,0:03:29.79,0:03:32.08,Default,,0,0,0,,Нашар ұрыс басталады
Dialogue: 0,0:03:32.17,0:03:34.83,Default,,0,0,0,,- (Харада) Жарайды, сумодан жарысайық - иә?
Dialogue: 0,0:03:34.92,0:03:36.25,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:36.34,0:03:37.88,Default,,0,0,0,,Өз күшіңізді көрсетіңіз
Dialogue: 0,0:03:37.96,0:03:39.26,Default,,0,0,0,,Үштің ең жақсысы
Dialogue: 0,0:03:39.34,0:03:40.97,Default,,0,0,0,,Жасайық
Dialogue: 0,0:03:41.67,0:03:45.97,Default,,0,0,0,,ше? Сумо? неге?
Dialogue: 0,0:03:46.89,0:03:49.81,Default,,0,0,0,,Кешіріңіз, бұл осылай.
Dialogue: 0,0:03:49.89,0:03:51.60,Default,,0,0,0,,Сонда мен Джодзи боламын.
Dialogue: 0,0:03:51.68,0:03:53.35,Default,,0,0,0,,Бұл бастама!
Dialogue: 0,0:03:53.44,0:03:55.48,Default,,0,0,0,,Мен... иә? Неге!
Dialogue: 0,0:03:55.56,0:03:57.19,Default,,0,0,0,,Балаларды балалар емдеуі керек.
Dialogue: 0,0:03:57.27,0:03:58.98,Default,,0,0,0,,Маған бала сияқты қарама!
Dialogue: 0,0:03:59.07,0:04:02.74,Default,,0,0,0,,Ха, мен ашуландым! Бала ғой, хехе
Dialogue: 0,0:04:02.82,0:04:03.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:08.03,0:04:10.45,Default,,0,0,0,,Чиринуни! Мен жасаймын!
Dialogue: 0,0:04:10.54,0:04:13.16,Default,,0,0,0,,А, бұл ересектер.
Dialogue: 0,0:04:13.25,0:04:14.46,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:14.54,0:04:18.54,Default,,0,0,0,,Иә, жасаймын! Жеңілсек, жүгіреміз.
Dialogue: 0,0:04:18.63,0:04:21.26,Default,,0,0,0,,Мен ешқашан жеңілмеймін!
Dialogue: 0,0:04:21.34,0:04:23.17,Default,,0,0,0,,- Иә! -(Окита) Ахахха
Dialogue: 0,0:04:23.26,0:04:26.05,Default,,0,0,0,,Жарайды, жеңілсем, мен де жүгіремін.
Dialogue: 0,0:04:26.72,0:04:28.22,Default,,0,0,0,,Жеңілсең, ұтыласың!
Dialogue: 0,0:04:28.30,0:04:30.06,Default,,0,0,0,,Оны ұсақтаңыз! артта қалды артта қалды
Dialogue: 0,0:04:30.64,0:04:33.48,Default,,0,0,0,,О! Таңқаларлықтай жақсы өнер көрсеткен бала
Dialogue: 0,0:04:33.56,0:04:35.10,Default,,0,0,0,,Маваши алыңыз!
Dialogue: 0,0:04:35.19,0:04:36.73,Default,,0,0,0,,Аяғыңызды төмен түсіріңіз! бастау!
Dialogue: 0,0:04:36.81,0:04:38.56,Default,,0,0,0,,(Екі адамның ауыр дауысы)
Dialogue: 0,0:04:39.73,0:04:40.90,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:04:43.40,0:04:45.03,Default,,0,0,0,,Ұтыс ойыны!
Dialogue: 0,0:04:45.11,0:04:46.41,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:04:47.37,0:04:48.20,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:04:48.28,0:04:50.12,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:04:51.04,0:04:51.87,Default,,0,0,0,,Ябба
Dialogue: 0,0:04:51.95,0:04:53.83,Default,,0,0,0,,Не?
Dialogue: 0,0:04:58.63,0:05:00.92,Default,,0,0,0,,Айла... Сумо
Dialogue: 0,0:05:03.38,0:05:04.76,Default,,0,0,0,,Әй, мұнда!
Dialogue: 0,0:05:04.84,0:05:05.84,Default,,0,0,0,,Біреу тоқтатсын!
Dialogue: 0,0:05:05.93,0:05:07.30,Default,,0,0,0,,Сізді лақтырып жібереді!
Dialogue: 0,0:05:07.39,0:05:09.39,Default,,0,0,0,,Хмм, мен қарсыласпын.
Dialogue: 0,0:05:10.51,0:05:12.39,Default,,0,0,0,,Өкінішті!
Dialogue: 0,0:05:12.47,0:05:15.52,Default,,0,0,0,,Сен бейбақ! Әрқашан соққыға ұшыраймын деп ойламаңыз!
Dialogue: 0,0:05:15.60,0:05:16.73,Default,,0,0,0,,Ах
Dialogue: 0,0:05:16.81,0:05:17.94,Default,,0,0,0,,Невилл Буффет!
Dialogue: 0,0:05:18.02,0:05:19.48,Default,,0,0,0,,Сасаюки де жеңілді!
Dialogue: 0,0:05:19.56,0:05:21.52,Default,,0,0,0,,-Жоқ -тым... тым күшті
Dialogue: 0,0:05:21.61,0:05:25.19,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:05:25.28,0:05:31.28,Default,,0,0,0,,Кондо мырза! Сіздің серіктесіңіз Серизава Камо деп естідім.
Dialogue: 0,0:05:31.37,0:05:32.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:32.62,0:05:33.66,Default,,0,0,0,,Га
Dialogue: 0,0:05:37.25,0:05:40.67,Default,,0,0,0,,Нуоо...
Dialogue: 0,0:05:40.75,0:05:43.38,Default,,0,0,0,,... 10 қолы бар ма?
Dialogue: 0,0:05:46.01,0:05:48.34,Default,,0,0,0,,Біз Серизава бестікпіз!
Dialogue: 0,0:05:48.43,0:05:51.35,Default,,0,0,0,,Артқы жағында тұр! (Тодоның күлкісі)
Dialogue: 0,0:05:51.43,0:05:54.93,Default,,0,0,0,,Бес дене, бірақ бір болады!
Dialogue: 0,0:05:55.02,0:05:58.60,Default,,0,0,0,,Фухахахахаха Кондо қорқасың ба?
Dialogue: 0,0:06:00.94,0:06:02.77,Default,,0,0,0,,- (Хирама) Ах~ - (Хираяма) Уау~
Dialogue: 0,0:06:02.86,0:06:04.82,Default,,0,0,0,,Оны жинаңыз!
Dialogue: 0,0:06:05.65,0:06:07.70,Default,,0,0,0,,Қалай! (Ниими) О!
Dialogue: 0,0:06:07.78,0:06:09.70,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:15.12,0:06:17.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:17.21,0:06:20.79,Default,,0,0,0,,Пуф Ахахахаха! Ахахаха
Dialogue: 0,0:06:20.88,0:06:22.29,Default,,0,0,0,,- (Яминами) Ой... - (Окита) Мен бардым.
Dialogue: 0,0:06:22.38,0:06:24.30,Default,,0,0,0,,-Уау! -(Todo) Мен лақтырылдым!
Dialogue: 0,0:06:25.09,0:06:26.30,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:28.38,0:06:29.88,Default,,0,0,0,,Бұл Мибро ма?
Dialogue: 0,0:06:30.38,0:06:33.51,Default,,0,0,0,,Қала тұрғындары қорқатын зұлым топ?
Dialogue: 0,0:06:36.52,0:06:38.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:38.14,0:06:40.10,Default,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:06:40.19,0:06:43.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:43.15,0:06:44.65,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:06:44.73,0:06:46.32,Default,,0,0,0,,Мен күлемін...
Dialogue: 0,0:06:46.40,0:06:48.44,Default,,0,0,0,,Басыңды ұрдың ба?
Dialogue: 0,0:06:50.03,0:06:51.66,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,0:06:55.79,0:06:57.62,Default,,0,0,0,,Ногучи қайтадан қамауға алынды.
Dialogue: 0,0:06:57.70,0:07:00.21,Default,,0,0,0,,- (Ногучи) Уау! Ах! -(Ниими) Ногучи...
Dialogue: 0,0:07:00.29,0:07:03.50,Default,,0,0,0,,Кондо мырза! Сонымен, бәсекелестік қандай?
Dialogue: 0,0:07:04.92,0:07:05.75,Default,,0,0,0,,Иә
Dialogue: 0,0:07:07.88,0:07:10.59,Default,,0,0,0,,Сіз мұны қайтадан жасадыңыз! Бұл Санджо Охаши көпірі.
Dialogue: 0,0:07:12.97,0:07:14.51,Default,,0,0,0,,Санджо Охаши?
Dialogue: 0,0:07:15.26,0:07:16.43,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:07:17.52,0:07:18.43,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:07:19.18,0:07:21.14,Default,,0,0,0,,Сен де келесің бе?
Dialogue: 0,0:07:21.23,0:07:22.85,Default,,0,0,0,,Түсінесіз деп ойлаймын.
Dialogue: 0,0:07:23.48,0:07:25.69,Default,,0,0,0,,Сіз өзіңізге ұнамайтын нәрсені көресіз.
Dialogue: 0,0:07:27.90,0:07:29.11,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:07:29.82,0:07:32.24,Default,,0,0,0,,Мен де Киотода тұрамын.
Dialogue: 0,0:07:40.54,0:07:42.50,Default,,0,0,0,,Сондай-ақ, ашық бас
Dialogue: 0,0:07:42.58,0:07:44.13,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:07:44.21,0:07:45.63,Default,,0,0,0,,Занзанжо?
Dialogue: 0,0:07:45.71,0:07:47.25,Default,,0,0,0,,Өсиеттерді бұзу діни қызметкер
Dialogue: 0,0:07:48.05,0:07:52.26,Default,,0,0,0,,Тағы да айта кетейін, өткен жыл осындай оқиғаларға толы болды.
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0,0,0,,Каригото Йейт
Dialogue: 0,0:07:54.43,0:07:56.01,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:07:56.89,0:07:59.02,Default,,0,0,0,,Әділет тенчу
Dialogue: 0,0:07:59.60,0:08:01.35,Default,,0,0,0,,Мен бір жамандық жасаған болуым керек.
Dialogue: 0,0:08:01.43,0:08:03.52,Default,,0,0,0,,Қандай сұмдық дүние
Dialogue: 0,0:08:05.06,0:08:06.19,Default,,0,0,0,,Хиджиката-сан
Dialogue: 0,0:08:07.36,0:08:10.23,Default,,0,0,0,,Мен шынымен түсінбеймін...
Dialogue: 0,0:08:10.32,0:08:14.78,Default,,0,0,0,,Өлтірген адам жаман, оны өлтірген адам жақсы ма?
Dialogue: 0,0:08:15.82,0:08:18.28,Default,,0,0,0,,Әлемді жақсырақ етуге тырысатын адамдар
Dialogue: 0,0:08:18.37,0:08:20.79,Default,,0,0,0,,Сіз мұны шынымен істеп жатырсыз ба?
Dialogue: 0,0:08:24.92,0:08:27.54,Default,,0,0,0,,Экстремистер келіп-кететін қонақ үй бар.
Dialogue: 0,0:08:28.29,0:08:30.00,Default,,0,0,0,,Бүгін кешке кіріңіз
Dialogue: 0,0:08:30.50,0:08:33.42,Default,,0,0,0,,Оны өзіңіз көріңіз.
Dialogue: 0,0:08:36.64,0:08:37.68,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:38.18,0:08:40.43,Default,,0,0,0,,Өзің көрмейінше білмейсің
Dialogue: 0,0:08:40.51,0:08:42.93,Default,,0,0,0,,Сен осында келдің емес пе?
Dialogue: 0,0:08:52.28,0:08:54.45,Default,,0,0,0,,Бұл шынымен де жақсы ма?
Dialogue: 0,0:08:54.53,0:08:56.11,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:08:56.20,0:08:57.70,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:08:58.45,0:09:01.70,Default,,0,0,0,,Дәл қазір бұл астанада не болып жатыр?
Dialogue: 0,0:09:02.50,0:09:05.21,Default,,0,0,0,,Жарайды, сен артта қал.
Dialogue: 0,0:09:06.42,0:09:07.88,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:09.17,0:09:12.21,Default,,0,0,0,,Айналаңызға қараңыз! үшінмыз құдайшыл болайық!
Dialogue: 0,0:09:16.30,0:09:20.72,Default,,0,0,0,,Біртүрлі... Қонақ үй болса да, жарық мүлде жоқ.
Dialogue: 0,0:09:30.69,0:09:31.82,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:09:31.90,0:09:32.98,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,0:09:37.07,0:09:40.16,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:09:40.24,0:09:42.62,Default,,0,0,0,,Мен кесіп алдым... Расымен де кесіп алдым!
Dialogue: 0,0:09:42.70,0:09:44.50,Default,,0,0,0,,- (Роши) А-а-а... -Ха!
Dialogue: 0,0:09:46.79,0:09:47.79,Default,,0,0,0,,Окита мырза
Dialogue: 0,0:09:50.00,0:09:54.01,Default,,0,0,0,,Ха ха ха... Бұл басқа әңгіме!
Dialogue: 0,0:09:54.92,0:09:55.76,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:09:57.26,0:10:00.43,Default,,0,0,0,,Егер сіз бір ұрыны өлтірсеңіз, оңай ақша аласыз.
Dialogue: 0,0:10:00.51,0:10:02.76,Default,,0,0,0,,Алкогольмен және әйелдермен қалағанның бәрін ала аласыз.
Dialogue: 0,0:10:04.35,0:10:06.10,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:10:06.18,0:10:08.77,Default,,0,0,0,,Қандай сергітетін сұмдық.
Dialogue: 0,0:10:08.85,0:10:10.81,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:10:10.90,0:10:14.53,Default,,0,0,0,,Өлген адамның құлағын маған айтқан сарайға лақтырдым.
Dialogue: 0,0:10:15.44,0:10:17.53,Default,,0,0,0,,Жаңа ашу
Dialogue: 0,0:10:17.61,0:10:20.99,Default,,0,0,0,,Ешбір сенімі, әділдігі жоқ адам
Dialogue: 0,0:10:21.62,0:10:23.28,Default,,0,0,0,,Мен сен сияқты бола аламын ба?
Dialogue: 0,0:10:23.37,0:10:24.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:25.45,0:10:28.08,Default,,0,0,0,,Уууу!
Dialogue: 0,0:10:32.21,0:10:33.38,Default,,0,0,0,,Гаха
Dialogue: 0,0:10:34.17,0:10:35.42,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:10:37.51,0:10:39.43,Default,,0,0,0,,Ах, Хиджиката-сан
Dialogue: 0,0:10:40.51,0:10:43.10,Default,,0,0,0,,Мен қайтып келетін қан туралы ойлауым керек.
Dialogue: 0,0:10:43.18,0:10:44.43,Default,,0,0,0,,Шулы
Dialogue: 0,0:10:48.02,0:10:51.23,Default,,0,0,0,,Үйге ертерек барып, бойымызды сергітіп алайық.
Dialogue: 0,0:11:03.78,0:11:06.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.72,0:11:21.93,Default,,0,0,0,,Ұйықтау мүмкін емес пе?
Dialogue: 0,0:11:23.30,0:11:26.56,Default,,0,0,0,,Кез келген зұлым адамның тірі болғанын қалайсыз ба?
Dialogue: 0,0:11:26.64,0:11:29.68,Default,,0,0,0,,Не? А... жоқ, жоқ
Dialogue: 0,0:11:30.43,0:11:34.02,Default,,0,0,0,,Мен біреудің біреуді өлтіру үшін ақша алуына ешқашан шыдамас едім.
Dialogue: 0,0:11:35.31,0:11:36.94,Default,,0,0,0,,Сонда сізді не уайымдады?
Dialogue: 0,0:11:37.44,0:11:40.61,Default,,0,0,0,,Мен уайымдадым, дәлірек айтсам, соны ойлап жүрдім.
Dialogue: 0,0:11:40.70,0:11:42.28,Default,,0,0,0,,Не?
Dialogue: 0,0:11:42.99,0:11:45.70,Default,,0,0,0,,Егер мен өлтіретін адам менімен бірдей болса
Dialogue: 0,0:11:46.20,0:11:48.54,Default,,0,0,0,,Егер сіз әлемді жақсы орынға айналдырғыңыз келсе
Dialogue: 0,0:11:49.29,0:11:52.37,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:11:55.13,0:11:58.13,Default,,0,0,0,,Хиджиката мырза, мен әрқашан болдым
Dialogue: 0,0:11:58.21,0:12:01.42,Default,,0,0,0,,Ақша ұрлап, адам өлтіретін жаман адамдар бар.
Dialogue: 0,0:12:01.51,0:12:03.93,Default,,0,0,0,,Оны тоқтатуға тырысатын жақсы адамдар бар.
Dialogue: 0,0:12:04.01,0:12:07.60,Default,,0,0,0,,Мен бұл астананы әбігерге салған шығар деп ойладым.
Dialogue: 0,0:12:11.60,0:12:13.31,Default,,0,0,0,,Бірақ шын мәнінде
Dialogue: 0,0:12:13.39,0:12:15.90,Default,,0,0,0,,Әділдік пен зұлымдық соғыспайды
Dialogue: 0,0:12:16.40,0:12:21.15,Default,,0,0,0,,Әділдік пен әділдік күресіп, қан жауады.
Dialogue: 0,0:12:22.86,0:12:26.32,Default,,0,0,0,,Хмф... зұлымдық деген жоқ.
Dialogue: 0,0:12:26.82,0:12:30.66,Default,,0,0,0,,Ең болмаса өзін зұлым санайтындар.
Dialogue: 0,0:12:31.50,0:12:33.41,Default,,0,0,0,,Өте сирек
Dialogue: 0,0:12:33.50,0:12:36.88,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:36.96,0:12:37.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:37.88,0:12:41.51,Default,,0,0,0,,Мен Хиджиката-сан мен Окита-сан сияқты қалай қозғаламын?
Dialogue: 0,0:12:43.26,0:12:45.72,Default,,0,0,0,,Қарапайым әңгіме
Dialogue: 0,0:12:46.51,0:12:48.93,Default,,0,0,0,,Ішіңізде мызғымас сенім бар.
Dialogue: 0,0:12:50.47,0:12:54.02,Default,,0,0,0,,Ешбір қиындық немесе ештеңе қорқытпайды.
Dialogue: 0,0:12:54.10,0:12:55.94,Default,,0,0,0,,Соңында не қалады
Dialogue: 0,0:12:57.23,0:12:59.19,Default,,0,0,0,,Бұл сіздің әділдігіңіз.
Dialogue: 0,0:13:00.15,0:13:03.19,Default,,0,0,0,,Сізде бұл бар болса, сіз өлтірмейтін ештеңе жоқ.
Dialogue: 0,0:13:05.28,0:13:06.61,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:07.28,0:13:10.70,Default,,0,0,0,,Жоқ, ұйықтап жатырмын, ұйықтайын деп жатырмын
Dialogue: 0,0:13:14.91,0:13:16.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:16.17,0:13:19.38,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:13:19.46,0:13:22.17,Default,,0,0,0,,Бұл үйге әлсіз иіс шығады.
Dialogue: 0,0:13:24.22,0:13:25.42,Default,,0,0,0,,Бұл қан.
Dialogue: 0,0:13:26.01,0:13:27.51,Default,,0,0,0,,Бұл не, жексұрын?
Dialogue: 0,0:13:29.43,0:13:31.64,Default,,0,0,0,,Мен әлі ештеңе білмеймін
Dialogue: 0,0:13:32.18,0:13:36.89,Default,,0,0,0,,Әртүрлі нәрселерді қарап, өзіңіз ойлап, растауыңыз керек.
Dialogue: 0,0:13:39.06,0:13:40.94,Default,,0,0,0,,Әділеттілік дегеніміз не?
Dialogue: 0,0:13:41.48,0:13:44.69,Default,,0,0,0,,Нені дұрыс және нені келісуге болмайды?
Dialogue: 0,0:13:46.57,0:13:48.91,Default,,0,0,0,,Мен өмір сүргенше ойланып қаламын
Dialogue: 0,0:13:49.95,0:13:53.58,Default,,0,0,0,,Әділдігімді тапқанша
Dialogue: 0,0:13:55.91,0:13:57.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:59.12,0:14:02.00,Default,,0,0,0,,Нии-кун, сен бірдеңе ойлап тұрсың ба?
Dialogue: 0,0:14:02.09,0:14:04.71,Default,,0,0,0,,Окита мырза, дұрыс.
Dialogue: 0,0:14:04.80,0:14:07.05,Default,,0,0,0,,Әділеттілік дегеніміз не?
Dialogue: 0,0:14:07.13,0:14:08.88,Default,,0,0,0,,Әділдік
Dialogue: 0,0:14:09.43,0:14:10.51,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:14:11.30,0:14:13.31,Default,,0,0,0,,Өзіңіз ойланыңыз.
Dialogue: 0,0:14:13.39,0:14:15.10,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:14:15.18,0:14:17.23,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:14:17.73,0:14:20.86,Default,,0,0,0,,Бұл басқалардан үйренетін нәрсе емес.
Dialogue: 0,0:14:20.94,0:14:22.36,Default,,0,0,0,,Аа, қазір ойлап қарасам
Dialogue: 0,0:14:22.44,0:14:25.07,Default,,0,0,0,,Мен Яги отбасына әлі сәлем айтқан жоқпын.
Dialogue: 0,0:14:25.15,0:14:28.11,Default,,0,0,0,,Дженнохо-сан ертерек шықты.
Dialogue: 0,0:14:28.20,0:14:30.07,Default,,0,0,0,,Жарайды, мен оны ақырында кездестіремін.
Dialogue: 0,0:14:30.16,0:14:33.08,Default,,0,0,0,,Бұл өте орынды, Окита мырза.
Dialogue: 0,0:14:33.16,0:14:34.74,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:34.83,0:14:37.79,Default,,0,0,0,,Менің әділдігім қандай болса да солай!
Dialogue: 0,0:14:37.87,0:14:39.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:39.50,0:14:41.42,Default,,0,0,0,,! Жақында кел!
Dialogue: 0,0:14:41.50,0:14:45.75,Default,,0,0,0,,А... енді ойлап қарасам, Хиджиката-сан маған телефон соқты.
Dialogue: 0,0:14:45.84,0:14:46.84,Default,,0,0,0,,Не!
Dialogue: 0,0:14:46.92,0:14:49.43,Default,,0,0,0,,бұл... Иә, қазір!
Dialogue: 0,0:14:50.76,0:14:53.43,Default,,0,0,0,,Үшеуміз қаланы аралаймыз.
Dialogue: 0,0:14:53.51,0:14:56.35,Default,,0,0,0,,Айналаңызға қарап тұрсыз ба? Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:14:56.43,0:14:57.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.89,0:15:00.23,Default,,0,0,0,,Үш адам туралы айтсақ...
Dialogue: 0,0:15:01.90,0:15:03.48,Default,,0,0,0,,Кондо мырза...
Dialogue: 0,0:15:03.56,0:15:06.73,Default,,0,0,0,,Ах... Танысқаныма қуаныштымын.
Dialogue: 0,0:15:06.82,0:15:08.24,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:15:08.32,0:15:11.49,Default,,0,0,0,,Иә, мен Исаму Кондомын.
Dialogue: 0,0:15:12.24,0:15:13.12,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:15:13.20,0:15:15.08,Default,,0,0,0,,Ах ха... иә!
Dialogue: 0,0:15:25.59,0:15:29.13,Default,,0,0,0,,Эй, эй, мұны істесең бір секундқа шыдамайсың.
Dialogue: 0,0:15:29.21,0:15:31.26,Default,,0,0,0,,Иықтарыңызды аздап босатыңыз.
Dialogue: 0,0:15:31.34,0:15:33.01,Default,,0,0,0,,А... иә
Dialogue: 0,0:15:33.68,0:15:37.51,Default,,0,0,0,,Мен Киото астанасы Охохоуфуфу дворян отбасыларына толы деп ойладым.
Dialogue: 0,0:15:38.14,0:15:42.02,Default,,0,0,0,,Неліктен көптеген самурайлар екі қылыш киеді?
Dialogue: 0,0:15:42.10,0:15:45.44,Default,,0,0,0,,Өткен желтоқсанда Айзу мырзасы
Dialogue: 0,0:15:45.52,0:15:48.23,Default,,0,0,0,,1000 солдатпен Киотоға жіберілгеннен кейін
Dialogue: 0,0:15:48.32,0:15:51.03,Default,,0,0,0,,Мен самурайлардың саны айтарлықтай өскен сияқты әсер алдым.
Dialogue: 0,0:15:51.11,0:15:52.07,Default,,0,0,0,,Хо
Dialogue: 0,0:15:52.15,0:15:54.87,Default,,0,0,0,,Өйткені, Киото керемет жер.
Dialogue: 0,0:15:54.95,0:15:57.16,Default,,0,0,0,,Тоши сенің келгеніңе қуаныштымын.
Dialogue: 0,0:15:57.24,0:15:58.08,Default,,0,0,0,,Иә
Dialogue: 0,0:15:58.74,0:16:00.79,Default,,0,0,0,,Бұл сенімді.
Dialogue: 0,0:16:00.87,0:16:04.67,Default,,0,0,0,,Сіз сияқты Киотомен таныс үш адам бізге қосылды.
Dialogue: 0,0:16:05.67,0:16:08.25,Default,,0,0,0,,Жоқ, бұл соншалықты үлкен мәселе емес...
Dialogue: 0,0:16:08.34,0:16:10.38,Default,,0,0,0,,Аа, енді ойлап қарасам, тағы екі адам...
Dialogue: 0,0:16:10.46,0:16:11.63,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:16:14.09,0:16:15.47,Default,,0,0,0,,Мен сені қуамын
Dialogue: 0,0:16:15.55,0:16:16.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:20.85,0:16:23.52,Default,,0,0,0,,жылдам... ересек адам күткендей!
Dialogue: 0,0:16:24.14,0:16:25.69,Default,,0,0,0,,А, кеш болды!
Dialogue: 0,0:16:25.77,0:16:28.11,Default,,0,0,0,,Қарсы емес! Оның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:16:28.19,0:16:29.69,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:16:30.94,0:16:33.32,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:34.57,0:16:38.33,Default,,0,0,0,,Сіз оған тап болдыңыз. Мұнда көптеген тар жолдар бар.
Dialogue: 0,0:16:39.66,0:16:41.33,Default,,0,0,0,,Бөліп алған дұрыс сияқты.
Dialogue: 0,0:16:42.08,0:16:43.58,Default,,0,0,0,,Мен сол жақтан барамын
Dialogue: 0,0:16:43.66,0:16:45.58,Default,,0,0,0,,Кондо мырза, тура жүре беріңіз.
Dialogue: 0,0:16:45.67,0:16:46.54,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:16:47.08,0:16:48.59,Default,,0,0,0,,Егер тапсаңыз, дауыстап шақырыңыз.
Dialogue: 0,0:16:48.67,0:16:51.84,Default,,0,0,0,,-Иә - (Кондо) Ух Хух
Dialogue: 0,0:16:52.55,0:16:54.34,Default,,0,0,0,,Мен не істегенімді білмеймін
Dialogue: 0,0:16:54.43,0:16:56.80,Default,,0,0,0,,Егер сіз бұрышта тұрсаңыз, сіз кездескен адамға қауіп төнеді.
Dialogue: 0,0:16:57.93,0:16:59.85,Default,,0,0,0,,(Қыздың жылауы)
Dialogue: 0,0:17:00.85,0:17:02.02,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:17:02.10,0:17:04.77,Default,,0,0,0,,Бірақ бұл іздеу аймағы емес...
Dialogue: 0,0:17:04.85,0:17:06.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:06.69,0:17:10.15,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:17:10.23,0:17:11.36,Default,,0,0,0,,Ах
Dialogue: 0,0:17:13.40,0:17:14.49,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:14.57,0:17:16.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:18.16,0:17:18.99,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:17:20.91,0:17:23.54,Default,,0,0,0,,Уф уау
Dialogue: 0,0:17:23.62,0:17:25.75,Default,,0,0,0,,Жарайды, сөйлесудің қажеті жоқ.
Dialogue: 0,0:17:28.79,0:17:30.21,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:32.09,0:17:33.42,Default,,0,0,0,,Мына сандалдар
Dialogue: 0,0:17:33.51,0:17:36.05,Default,,0,0,0,,Әпкеңнің саған бергені маңызды нәрсе болса керек.
Dialogue: 0,0:17:36.13,0:17:37.80,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:17:37.89,0:17:40.30,Default,,0,0,0,,Қош келдіңіз. Үйге жалғыз бара аламын ба?
Dialogue: 0,0:17:40.39,0:17:41.22,Default,,0,0,0,,Иә
Dialogue: 0,0:17:42.22,0:17:44.52,Default,,0,0,0,,- (Ер адам) Хитокири! -(Әйел) Кя!
Dialogue: 0,0:17:44.60,0:17:45.77,Default,,0,0,0,,Ол қашып кетті!
Dialogue: 0,0:17:45.85,0:17:48.15,Default,,0,0,0,,-(Хитокири) -Ах
Dialogue: 0,0:17:48.23,0:17:50.73,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:17:54.82,0:17:55.65,Default,,0,0,0,,!
Dialogue: 0,0:17:55.74,0:17:57.15,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:17:59.74,0:18:00.82,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:06.50,0:18:08.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:08.29,0:18:09.50,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:18:09.58,0:18:11.42,Default,,0,0,0,,Ах
Dialogue: 0,0:18:11.50,0:18:16.51,Default,,0,0,0,,Оңай қашып кететін және самурайдың жел жағына қоюға болмайтындар.
Dialogue: 0,0:18:16.59,0:18:20.18,Default,,0,0,0,,Бірақ мен Тошидің жын аяқтарынан құтыла алмаймын
Dialogue: 0,0:18:21.01,0:18:22.68,Default,,0,0,0,,Невилл Буффет!
Dialogue: 0,0:18:27.02,0:18:29.69,Default,,0,0,0,,Киото қаласында тек Зако ғана бар емес пе?
Dialogue: 0,0:18:33.52,0:18:36.74,Default,,0,0,0,,(Қыздың жылауы)
Dialogue: 0,0:18:48.87,0:18:50.46,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:50.54,0:18:53.00,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:18:53.09,0:18:55.13,Default,,0,0,0,,Бұйрықтарға бағынбау
Dialogue: 0,0:18:55.63,0:18:57.67,Default,,0,0,0,,Оның үстіне мен қашып кеттім.
Dialogue: 0,0:18:57.76,0:19:00.47,Default,,0,0,0,,А, сен ол қызды қорғадың ғой, солай ма?
Dialogue: 0,0:19:01.18,0:19:04.60,Default,,0,0,0,,Баламның жылағанын көріп, жалғыз қалдыра алмадым...
Dialogue: 0,0:19:05.31,0:19:08.23,Default,,0,0,0,,Мен оны қорғауым керек
Dialogue: 0,0:19:10.85,0:19:11.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:12.65,0:19:14.98,Default,,0,0,0,,Менің ата-анам өлтірілген сияқты.
Dialogue: 0,0:19:15.57,0:19:17.82,Default,,0,0,0,,«Шамасы» нені білдіреді?
Dialogue: 0,0:19:17.90,0:19:22.36,Default,,0,0,0,,Әй, есіме түссе, мені ғибадатханада ұстады.
Dialogue: 0,0:19:22.87,0:19:25.91,Default,,0,0,0,,Мен сияқты 10 шақты бала болды деп ойлаймын.
Dialogue: 0,0:19:27.12,0:19:30.50,Default,,0,0,0,,Мені сонда жыламауды, күлуді үйретті.
Dialogue: 0,0:19:31.62,0:19:32.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:33.08,0:19:35.04,Default,,0,0,0,,Өйткені оны алатын ешкім болмайды.
Dialogue: 0,0:19:35.13,0:19:36.17,Default,,0,0,0,,Иә
Dialogue: 0,0:19:36.25,0:19:38.34,Default,,0,0,0,,Шындығында, сіз дұрыс айттыңыз деп ойлаймын.
Dialogue: 0,0:19:38.84,0:19:42.38,Default,,0,0,0,,Соның арқасында мен әжем мен әпкеммен бірге тұрдым.
Dialogue: 0,0:19:43.80,0:19:48.02,Default,,0,0,0,,Бірақ... қатты жылағым келді.
Dialogue: 0,0:19:48.77,0:19:49.77,Default,,0,0,0,,Жылағанда
Dialogue: 0,0:19:50.73,0:19:53.23,Default,,0,0,0,,Мен біреудің мені құшақтап алғанын қаладым
Dialogue: 0,0:19:55.86,0:19:57.15,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:57.73,0:20:00.49,Default,,0,0,0,,Әлемді жақсырақ орынға айналдырғыңыз келетін сияқты үлкен бір нәрсе айтыңыз.
Dialogue: 0,0:20:00.57,0:20:02.78,Default,,0,0,0,,Мен үйден қашып кеттім
Dialogue: 0,0:20:02.86,0:20:05.16,Default,,0,0,0,,Шындығында, бұл жай ғана...
Dialogue: 0,0:20:06.45,0:20:10.83,Default,,0,0,0,,Балалар тыныштықта жылайтын дүние болса екен.
Dialogue: 0,0:20:12.12,0:20:16.04,Default,,0,0,0,,Сол кезде қолымды созғым келді.
Dialogue: 0,0:20:16.71,0:20:18.63,Default,,0,0,0,,Мен мұндай дүниенің болғанын қалаймын
Dialogue: 0,0:20:23.26,0:20:25.64,Default,,0,0,0,,Кешіріңіз, пайдалы емес
Dialogue: 0,0:20:26.14,0:20:28.01,Default,,0,0,0,,Бұл шынымен аянышты
Dialogue: 0,0:20:30.97,0:20:32.64,Default,,0,0,0,,- (Кондо) Толық бағалар - Иә?
Dialogue: 0,0:20:33.14,0:20:36.69,Default,,0,0,0,,Мен ол қызды құтқардым, бұл толық баға.
Dialogue: 0,0:20:36.77,0:20:38.86,Default,,0,0,0,,Маэда мырза.
Dialogue: 0,0:20:39.94,0:20:41.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:42.40,0:20:44.15,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:20:45.53,0:20:46.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:50.91,0:20:53.16,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:20:54.71,0:20:57.58,Default,,0,0,0,,Бұл сіздің әділдігіңіз емес пе?
Dialogue: 0,0:20:58.84,0:21:01.55,Default,,0,0,0,,Хиджикатаның сол кездегі сөздері және
Dialogue: 0,0:21:02.42,0:21:04.30,Default,,0,0,0,,Кондо мырзаның өлшемі
Dialogue: 0,0:21:06.30,0:21:08.47,Default,,0,0,0,,Mibro-ға қош келдіңіз
Dialogue: 0,0:21:09.64,0:21:12.93,Default,,0,0,0,,(Нио жылап)
Dialogue: 0,0:21:15.56,0:21:16.85,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:21:16.94,0:21:20.86,Default,,0,0,0,,Ол кезде менің әлі білуге мүмкіндігім жоқ еді.
Dialogue: 0,0:21:20.94,0:21:23.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:25.70,0:21:28.37,Default,,0,0,0,,Бұл сюжет болды...
Dialogue: 0,0:21:33.50,0:21:35.16,Default,,0,0,0,,Серизава!
Dialogue: 0,0:21:35.25,0:21:37.83,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:21:38.83,0:21:42.38,Default,,0,0,0,,Миброда бірінші тазарту басталды.
Dialogue: 0,0:21:50.93,0:21:55.93,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.14,0:23:19.14,Default,,0,0,0,,～♪
Dialogue: 0,0:23:24.06,0:23:25.86,Default,,0,0,0,,Бұл Чиринуни.
Dialogue: 0,0:23:25.94,0:23:28.15,Default,,0,0,0,,Мибродағы өмір енді ғана басталып жатыр
Dialogue: 0,0:23:28.24,0:23:32.32,Default,,0,0,0,,Әжесі мен Ирохадан бөлек тұратын жалғыздық.
Dialogue: 0,0:23:32.41,0:23:35.24,Default,,0,0,0,,үшін өте көңілді, сондықтан бәрі жақсы.
Dialogue: 0,0:23:35.74,0:23:39.58,Default,,0,0,0,,Бірақ менде аздап алаңдаушылық бар.
Dialogue: 0,0:23:39.66,0:23:43.79,Default,,0,0,0,,Менімен құрдас Таро Танака туралы...
Dialogue: 0,0:23:44.50,0:23:46.92,Default,,0,0,0,,Келесі жолы «Жан қайда»
Dialogue: 0,0:23:47.00,0:23:48.00,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:23:49.50,0:23:55.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
