Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:04.33,Default,,0,0,0,,Осылайша, біз және Мибро
Dialogue: 0,0:00:04.42,0:00:09.71,Default,,0,0,0,,Қаланы өртеп жіберуді жоспарлаған қанды Рисшиданға қарсы шайқас басталды.
Dialogue: 0,0:00:09.80,0:00:10.92,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:00:11.01,0:00:13.34,Default,,0,0,0,,Исаму Кондо кіммен жұдырықтасады?
Dialogue: 0,0:00:13.43,0:00:15.47,Default,,0,0,0,,Мен Соудзи Окитаның жетістіктері туралы естігім келеді!
Dialogue: 0,0:00:15.55,0:00:17.14,Default,,0,0,0,,Тосизо Хиджиката ше?
Dialogue: 0,0:00:18.47,0:00:20.89,Default,,0,0,0,,Сізді бүркіт қызықтырмай ма?
Dialogue: 0,0:00:20.97,0:00:24.27,Default,,0,0,0,,Иә! Шинпачидің атасы да соғысқан ба?
Dialogue: 0,0:00:24.35,0:00:25.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:25.65,0:00:28.23,Default,,0,0,0,,Егер сол түні шайқас болмаса
Dialogue: 0,0:00:28.31,0:00:30.11,Default,,0,0,0,,Мен де солай істеймін
Dialogue: 0,0:00:30.19,0:00:34.49,Default,,0,0,0,,Ол самурай сияқты өмір сүрмеген шығар.
Dialogue: 0,0:00:34.57,0:00:36.20,Default,,0,0,0,,Керемет көрінеді!
Dialogue: 0,0:00:36.28,0:00:38.45,Default,,0,0,0,,Қалғанын тезірек тыңдағым келеді, ұстаз!
Dialogue: 0,0:00:40.58,0:00:46.08,Default,,0,0,0,,Бұл күн желді, айсыз түн болды.
Dialogue: 0,0:00:49.63,0:00:54.97,Default,,0,0,0,,♪～
Dialogue: 0,0:02:12.88,0:02:17.88,Default,,0,0,0,,～♪
Dialogue: 0,0:02:24.01,0:02:26.56,Default,,0,0,0,,Басқаша айтқанда, сол Наги-санның қарнында.
Dialogue: 0,0:02:26.64,0:02:29.69,Default,,0,0,0,,Балаңызды көргіңіз келеді, өйткені ол үшін алаңдайсыз.
Dialogue: 0,0:02:29.77,0:02:32.52,Default,,0,0,0,,Ал, мен өз сезімімді айтайын.
Dialogue: 0,0:02:32.61,0:02:34.19,Default,,0,0,0,,Міне, осыны білдіреді.
Dialogue: 0,0:02:34.27,0:02:35.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:35.23,0:02:37.86,Default,,0,0,0,,Егжей-тегжейлі айтпай-ақ, кеттік!
Dialogue: 0,0:02:37.94,0:02:39.61,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:02:39.70,0:02:43.12,Default,,0,0,0,,Бұл қарапайым. Бұл жақсы ма?
Dialogue: 0,0:02:43.20,0:02:45.16,Default,,0,0,0,,Соудзи Хэйсуке
Dialogue: 0,0:02:45.24,0:02:49.08,Default,,0,0,0,,Бізде қылыш жоқ. Қысқа қылыш жақсы. Бізге қарызға беріңізші.
Dialogue: 0,0:02:49.16,0:02:50.25,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:02:50.33,0:02:51.62,Default,,0,0,0,,Неге... неге!
Dialogue: 0,0:02:51.71,0:02:53.92,Default,,0,0,0,,Екеуің ойлап көріңдерші
Dialogue: 0,0:02:54.00,0:02:57.51,Default,,0,0,0,,Сонда сен Бакучиден жеңіліп, қылышыңды ломбардқа алдың ба?
Dialogue: 0,0:02:57.59,0:02:59.59,Default,,0,0,0,,Өте қатты ашуландырады—
Dialogue: 0,0:02:59.67,0:03:01.26,Default,,0,0,0,,Мен риза боламын
Dialogue: 0,0:03:01.34,0:03:02.30,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:03:02.39,0:03:04.05,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:03:04.14,0:03:06.64,Default,,0,0,0,,Киото қаласын өртеп жіберсеңіз ше?
Dialogue: 0,0:03:06.72,0:03:08.35,Default,,0,0,0,,Көрінетін
Dialogue: 0,0:03:08.43,0:03:10.81,Default,,0,0,0,,Мен саған Миброның күшін көрсетемін
Dialogue: 0,0:03:10.89,0:03:13.40,Default,,0,0,0,,Яманами Сақтықты төмендетпеңіз.
Dialogue: 0,0:03:13.48,0:03:14.81,Default,,0,0,0,,Бұл қажетсіз көмек.
Dialogue: 0,0:03:14.90,0:03:17.65,Default,,0,0,0,,Уау, менің өлгім келмейді!
Dialogue: 0,0:03:17.73,0:03:19.44,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:03:19.53,0:03:20.65,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:03:21.24,0:03:22.74,Default,,0,0,0,,Бұл бұрылыстан кейінгі екінші көпір.
Dialogue: 0,0:03:22.82,0:03:23.91,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:03:23.99,0:03:27.37,Default,,0,0,0,,Ногучи Сен менімен біргесің, артта қалма.
Dialogue: 0,0:03:27.45,0:03:29.33,Default,,0,0,0,,бұл... Иә, кешіріңіз.
Dialogue: 0,0:03:35.00,0:03:36.54,Default,,0,0,0,,Ах
Dialogue: 0,0:03:41.34,0:03:43.05,Default,,0,0,0,,Мына жел жаман.
Dialogue: 0,0:03:43.80,0:03:47.43,Default,,0,0,0,,Көпірден өтіп, қаланы өртеп жіберсеңіз, ол тез таралады.
Dialogue: 0,0:03:49.81,0:03:53.10,Default,,0,0,0,,Қараңдар! Бұл Санджо Охаши көпірі.
Dialogue: 0,0:03:53.19,0:03:54.10,Default,,0,0,0,,Баяу
Dialogue: 0,0:03:54.19,0:03:56.06,Default,,0,0,0,,Мұнда және мұнда өсті.
Dialogue: 0,0:03:56.15,0:03:58.73,Default,,0,0,0,,Бұл келе жатыр! Шашырау!
Dialogue: 0,0:03:58.82,0:04:00.11,Default,,0,0,0,,О!
Dialogue: 0,0:04:17.09,0:04:20.34,Default,,0,0,0,,Осылайша Мибро жеті топқа бөлінді.
Dialogue: 0,0:04:20.42,0:04:24.97,Default,,0,0,0,,Қанды Рисшидан нысанаға алған жеті көпірге барды.
Dialogue: 0,0:04:26.01,0:04:31.35,Default,,0,0,0,,Жылдам Тодо Окитаны алыстағы Коджин көпіріне апарыңыз.
Dialogue: 0,0:04:32.18,0:04:37.15,Default,,0,0,0,,Жаудың Хонмару Кейхачиканға, оған апаратын Санджо Охаши көпіріне\NБізді
Dialogue: 0,0:04:37.23,0:04:39.48,Default,,0,0,0,,-ге не әкелді
Dialogue: 0,0:04:39.57,0:04:42.11,Default,,0,0,0,,Хиджиката басшылық етті
Dialogue: 0,0:04:42.19,0:04:45.11,Default,,0,0,0,,Адамдар! Жалғастыру!
Dialogue: 0,0:04:45.20,0:04:46.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:47.20,0:04:48.12,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:04:48.20,0:04:50.62,Default,,0,0,0,,Маған енді бәрібір
Dialogue: 0,0:04:53.71,0:04:55.62,Default,,0,0,0,,Өрт келе жатыр!
Dialogue: 0,0:04:58.71,0:05:04.34,Default,,0,0,0,,Да ха ха! Батырлармен танысыңыз!
Dialogue: 0,0:05:04.97,0:05:06.88,Default,,0,0,0,,Жолдан
Dialogue: 0,0:05:06.97,0:05:09.39,Default,,0,0,0,,Аспаз Аспаз аспаз
Dialogue: 0,0:05:11.47,0:05:14.89,Default,,0,0,0,,Құттықтаймыз, сіз джекпотты жеңдіңіз.
Dialogue: 0,0:05:14.98,0:05:16.23,Default,,0,0,0,,Наозуми-сан!
Dialogue: 0,0:05:16.31,0:05:17.15,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:17.23,0:05:20.52,Default,,0,0,0,,Уау! Сіз ұрылардың артында тұрған адамсыз ба?
Dialogue: 0,0:05:20.61,0:05:22.82,Default,,0,0,0,,Серизава мырза, өтінемін!
Dialogue: 0,0:05:26.61,0:05:30.07,Default,,0,0,0,,Сіз кіммен сөйлесесіз? Бар!
Dialogue: 0,0:05:30.16,0:05:31.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:33.12,0:05:35.04,Default,,0,0,0,,Сол қылыш...
Dialogue: 0,0:05:37.12,0:05:39.04,Default,,0,0,0,,Тоқтамаңыз! Жүгір!
Dialogue: 0,0:05:39.67,0:05:40.63,Default,,0,0,0,,Уау
Dialogue: 0,0:05:41.13,0:05:44.01,Default,,0,0,0,,Және... Серпіліс! Серпіліс!
Dialogue: 0,0:05:44.09,0:05:45.42,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:05:45.51,0:05:46.51,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:05:47.51,0:05:49.51,Default,,0,0,0,,Мені жалғыз қалдыр!
Dialogue: 0,0:05:56.52,0:05:59.02,Default,,0,0,0,,Бұл анық емес адам қауіпті болуы мүмкін.
Dialogue: 0,0:05:59.10,0:05:59.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.03,0:06:08.20,Default,,0,0,0,,Хехехе...жақсысын ал.
Dialogue: 0,0:06:08.78,0:06:10.95,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:06:11.62,0:06:14.95,Default,,0,0,0,,Сол күміс бөренені менің қожайыным жасағаны сөзсіз.
Dialogue: 0,0:06:15.54,0:06:17.96,Default,,0,0,0,,Бұл дүниедегі жалғыз ұзын қылыш
Dialogue: 0,0:06:18.04,0:06:21.88,Default,,0,0,0,,«Анна» қара қылыш
Dialogue: 0,0:06:27.55,0:06:28.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.76,0:06:30.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:33.72,0:06:39.39,Default,,0,0,0,,Ұзын қылышты көру қиын, ал ол жаңа ай күндерінде ең күшті.
Dialogue: 0,0:06:39.48,0:06:41.23,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:06:41.31,0:06:43.65,Default,,0,0,0,,Егер сіз оны көре алмасаңыз, оны болдырмаудың жолы жоқ.
Dialogue: 0,0:06:43.73,0:06:46.86,Default,,0,0,0,,Мен бұл ауыр қылышты қолдана алатын адам бар екеніне сене алмаймын.
Dialogue: 0,0:06:49.86,0:06:51.86,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:51.95,0:06:54.83,Default,,0,0,0,,Уа, артқа тұр! Сіз оған түсіп қаласыз.
Dialogue: 0,0:06:55.91,0:07:00.04,Default,,0,0,0,,Серизава Камо, сен атақтысың.
Dialogue: 0,0:07:00.12,0:07:01.79,Default,,0,0,0,,Хо
Dialogue: 0,0:07:03.84,0:07:04.88,Default,,0,0,0,,Әй
Dialogue: 0,0:07:04.96,0:07:08.71,Default,,0,0,0,,Митоның Өтенгу Миброның алтын белгісі
Dialogue: 0,0:07:08.80,0:07:11.72,Default,,0,0,0,,Бірақ қайшылық бар.
Dialogue: 0,0:07:11.80,0:07:13.22,Default,,0,0,0,,Не?
Dialogue: 0,0:07:13.30,0:07:18.22,Default,,0,0,0,,Кедергілерді жою. Жеке мүдделерді жою.
Dialogue: 0,0:07:18.31,0:07:22.23,Default,,0,0,0,,Ол бір кездері Жой қозғалысының авангарды емес пе еді?
Dialogue: 0,0:07:24.81,0:07:29.78,Default,,0,0,0,,Қазір қалай? Сегунаттың иті керісінше.
Dialogue: 0,0:07:35.32,0:07:37.91,Default,,0,0,0,,Достарыңызға жол ашыңыз ба?
Dialogue: 0,0:07:37.99,0:07:40.66,Default,,0,0,0,,Әлсіздерге көмектесу?
Dialogue: 0,0:07:41.75,0:07:45.63,Default,,0,0,0,,Сенің әділдігің қайда?
Dialogue: 0,0:07:48.71,0:07:49.67,Default,,0,0,0,,Nu
Dialogue: 0,0:07:49.76,0:07:52.05,Default,,0,0,0,,Ал... тоқтады.
Dialogue: 0,0:07:52.13,0:07:54.76,Default,,0,0,0,,Ақымақ! Сіз бұл қылыш сызығын көре аласыз ба?
Dialogue: 0,0:07:55.26,0:07:57.89,Default,,0,0,0,,Әділет орны?
Dialogue: 0,0:07:58.64,0:08:00.81,Default,,0,0,0,,Сіз қателесесіз
Dialogue: 0,0:08:01.73,0:08:06.19,Default,,0,0,0,,Сіздің ұстанымыңыз өзгерсе, әділдік сияқты нәрселер өзгеруі мүмкін.
Dialogue: 0,0:08:14.24,0:08:15.07,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:15.66,0:08:16.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.62,0:08:18.83,Default,,0,0,0,,Серизава мырза жеңілмейді
Dialogue: 0,0:08:19.49,0:08:24.50,Default,,0,0,0,,Енді бұл Серизава Камо Мибу Роши тобында.
Dialogue: 0,0:08:25.00,0:08:29.34,Default,,0,0,0,,Жалғыз абсолютті әділеттілік
Dialogue: 0,0:08:34.38,0:08:35.34,Default,,0,0,0,,Сәлем Шинпачи!
Dialogue: 0,0:08:35.43,0:08:38.60,Default,,0,0,0,,Біз Ниджо Охаши көпірі, бірінші көпірміз.
Dialogue: 0,0:08:38.68,0:08:40.31,Default,,0,0,0,,Қате жасамаңыз
Dialogue: 0,0:08:40.39,0:08:41.85,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:08:41.93,0:08:44.60,Default,,0,0,0,,Саносуке, мұқият қарау керек.
Dialogue: 0,0:08:45.44,0:08:48.44,Default,,0,0,0,,Балалар, жақсы болатындарыңа сенімдімін.
Dialogue: 0,0:08:48.52,0:08:49.82,Default,,0,0,0,,Хирамадағы Хираяма
Dialogue: 0,0:08:49.90,0:08:53.65,Default,,0,0,0,,Бұл үлкен мәселеде қылыштың жоқтығы ұят.
Dialogue: 0,0:08:53.74,0:08:55.36,Default,,0,0,0,,Миброның шұңқыры!
Dialogue: 0,0:08:55.45,0:08:56.82,Default,,0,0,0,,Шу шығарыңыз!
Dialogue: 0,0:08:56.91,0:09:00.03,Default,,0,0,0,,Балалар, сендер Серизаваның алтын балық нәжісін алып жүрсіңдер!
Dialogue: 0,0:09:00.12,0:09:02.33,Default,,0,0,0,,Бұл басып кіру емес!
Dialogue: 0,0:09:02.41,0:09:07.83,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:09:07.92,0:09:09.59,Default,,0,0,0,,- (Окита) Иә, кешіріңіз - (Тодо) Кешіріңіз!
Dialogue: 0,0:09:10.25,0:09:12.46,Default,,0,0,0,,Біз артқы жағындамыз, сондықтан алдымен барайық.
Dialogue: 0,0:09:12.55,0:09:13.84,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:09:13.92,0:09:16.51,Default,,0,0,0,,Бұл балалар өте жылдам.
Dialogue: 0,0:09:16.59,0:09:18.68,Default,,0,0,0,,Сәтсіздікке ұшырамаңыздар.
Dialogue: 0,0:09:18.76,0:09:21.18,Default,,0,0,0,,Шулы! Бұл өте ерекше
Dialogue: 0,0:09:30.23,0:09:32.36,Default,,0,0,0,,Бұл Ниджо Охаши көпірі
Dialogue: 0,0:09:34.94,0:09:37.41,Default,,0,0,0,,Балалар сендер миброссыңдар.
Dialogue: 0,0:09:37.49,0:09:38.61,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,0:09:38.70,0:09:41.99,Default,,0,0,0,,А... 3 адам?
Dialogue: 0,0:09:42.08,0:09:43.87,Default,,0,0,0,,Мен күткеннен азырақ
Dialogue: 0,0:09:43.95,0:09:46.96,Default,,0,0,0,,Қараңдаршы, олардың қылыштары жоқ.
Dialogue: 0,0:09:47.04,0:09:49.29,Default,,0,0,0,,Бұл рас, жалғыз нұсқа - Вакизаши.
Dialogue: 0,0:09:49.38,0:09:51.13,Default,,0,0,0,,Ол самурай емес пе?
Dialogue: 0,0:09:52.50,0:09:54.71,Default,,0,0,0,,Енді қайсысы орындайтынын шешейік.
Dialogue: 0,0:09:54.80,0:09:55.63,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:55.72,0:09:57.63,Default,,0,0,0,,Хмм, бұл жақсы.
Dialogue: 0,0:10:01.97,0:10:02.81,Default,,0,0,0,,Артқа!
Dialogue: 0,0:10:03.89,0:10:05.56,Default,,0,0,0,,Кешіріңіз, бұл кесте.
Dialogue: 0,0:10:05.64,0:10:07.31,Default,,0,0,0,,Хмм... түсіндім.
Dialogue: 0,0:10:09.90,0:10:11.61,Default,,0,0,0,,Қайсысы алдыңғы?
Dialogue: 0,0:10:11.69,0:10:14.07,Default,,0,0,0,,Мен білмеймін! Шешім қабылдағаннан кейін!
Dialogue: 0,0:10:14.15,0:10:17.03,Default,,0,0,0,,Бұл Ниотароның ақшасы, солай ма?
Dialogue: 0,0:10:17.11,0:10:18.86,Default,,0,0,0,,Немесе... Мен оны жаңа ғана алдым.
Dialogue: 0,0:10:18.95,0:10:23.24,Default,,0,0,0,,Үнемі солай болсаң, келген сайын шайқаста қалып қоясың.
Dialogue: 0,0:10:23.33,0:10:25.58,Default,,0,0,0,,Сендіріп, менің артымнан ердің, солай ма?
Dialogue: 0,0:10:26.16,0:10:27.75,Default,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:10:28.87,0:10:30.00,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:10:32.08,0:10:33.09,Default,,0,0,0,,Гуах
Dialogue: 0,0:10:33.17,0:10:35.55,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:10:36.84,0:10:37.67,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:39.18,0:10:40.68,Default,,0,0,0,,Ой
Dialogue: 0,0:10:41.18,0:10:45.56,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:10:45.64,0:10:46.89,Default,,0,0,0,,Сора
Dialogue: 0,0:10:49.73,0:10:50.56,Default,,0,0,0,,Уф
Dialogue: 0,0:10:58.49,0:10:59.90,Default,,0,0,0,,Аузыңыздай жақсы емес
Dialogue: 0,0:10:59.99,0:11:02.24,Default,,0,0,0,,Менің дайындығым жеткіліксіз.
Dialogue: 0,0:11:02.32,0:11:04.95,Default,,0,0,0,,Ха, Саносуке! Жанып жатыр
Dialogue: 0,0:11:05.03,0:11:08.62,Default,,0,0,0,,Ах... Уа! Ачичи, оны тез өшіріп тастаңыз!
Dialogue: 0,0:11:08.70,0:11:11.00,Default,,0,0,0,,Фуфуфу
Dialogue: 0,0:11:11.08,0:11:13.54,Default,,0,0,0,,Уау, мен үрейленіп тұрмын.
Dialogue: 0,0:11:13.63,0:11:15.50,Default,,0,0,0,,Салмасы тым тәтті!
Dialogue: 0,0:11:16.84,0:11:18.05,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:19.34,0:11:20.84,Default,,0,0,0,,Сіз мұнда бастықсыз ба?
Dialogue: 0,0:11:21.68,0:11:22.51,Default,,0,0,0,,Сіз!
Dialogue: 0,0:11:26.60,0:11:30.18,Default,,0,0,0,,Мүмкін болса, сенің мұнда келгеніңді қаламадым.
Dialogue: 0,0:11:30.27,0:11:33.65,Default,,0,0,0,,Жоқ, сен мұны шынымен қаладың ба?
Dialogue: 0,0:11:33.73,0:11:35.73,Default,,0,0,0,,Ойын үйіндегі қария!
Dialogue: 0,0:11:35.82,0:11:39.15,Default,,0,0,0,,Сәтсіздіктен гөрі, бұл тағдыр.
Dialogue: 0,0:11:39.24,0:11:41.95,Default,,0,0,0,,Сіз Рисшидан болдыңыз ба?
Dialogue: 0,0:11:42.03,0:11:45.66,Default,,0,0,0,,Мен... білмедім. Біз дос болдық, солай ма?
Dialogue: 0,0:11:45.74,0:11:48.79,Default,,0,0,0,,Мен Мибро туралы естідім.
Dialogue: 0,0:11:48.87,0:11:52.16,Default,,0,0,0,,Жау болатынымызды да білмедік.
Dialogue: 0,0:11:52.79,0:11:55.21,Default,,0,0,0,,Мен сенімен жақсы сөйлестім.
Dialogue: 0,0:11:55.29,0:11:57.67,Default,,0,0,0,,Кенеттен төбелесіп кеткім келмейді.
Dialogue: 0,0:11:58.55,0:12:01.26,Default,,0,0,0,,Тіпті бірге ішімдік іштік!
Dialogue: 0,0:12:06.85,0:12:09.35,Default,,0,0,0,,Енді қайсысы?
Dialogue: 0,0:12:09.43,0:12:12.85,Default,,0,0,0,,Бір уақытта екі адам болғаны маңызды емес.
Dialogue: 0,0:12:12.94,0:12:14.85,Default,,0,0,0,,Найза? Уф...
Dialogue: 0,0:12:15.73,0:12:18.36,Default,,0,0,0,,Еріксіз шайқас
Dialogue: 0,0:12:18.44,0:12:21.36,Default,,0,0,0,,Бұл Мибро мен Рисшидандікі
Dialogue: 0,0:12:21.44,0:12:24.36,Default,,0,0,0,,Жалпы соғыс және жергілікті соғыс
Dialogue: 0,0:12:24.45,0:12:27.37,Default,,0,0,0,,Егер сіз кем дегенде бір нәрсені жоғалтсаңыз
Dialogue: 0,0:12:27.45,0:12:30.37,Default,,0,0,0,,Бұл сіздің жеңілісіңіз.
Dialogue: 0,0:12:30.45,0:12:33.37,Default,,0,0,0,,Сіздің достарыңыз да қазір айналаңызда.
Dialogue: 0,0:12:33.46,0:12:37.88,Default,,0,0,0,,Көптеген ерекшеліктері бар мысықтар сізді қарсы алады.
Dialogue: 0,0:12:39.59,0:12:40.88,Default,,0,0,0,,Мен қарапайым жүкші едім.
Dialogue: 0,0:12:43.97,0:12:46.89,Default,,0,0,0,,Қазіргі самурайлар шіріген
Dialogue: 0,0:12:46.97,0:12:48.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.47,0:12:50.43,Default,,0,0,0,,Адамдар жалқаулықты іздейді
Dialogue: 0,0:12:50.51,0:12:54.89,Default,,0,0,0,,Жалғыз позицияңызға қарап өзіңізді бақылауды жалғастыру мүмкін емес!
Dialogue: 0,0:12:54.98,0:12:56.85,Default,,0,0,0,,Қарапайым халықты тепкіле
Dialogue: 0,0:12:56.94,0:13:01.40,Default,,0,0,0,,Қаншама самурай жауынгерлері желді иығымен кесті!
Dialogue: 0,0:13:01.48,0:13:04.61,Default,,0,0,0,,Самурайлардың ойлайтыны бар сияқты.
Dialogue: 0,0:13:04.70,0:13:07.91,Default,,0,0,0,,Сен кімсің, қария?
Dialogue: 0,0:13:13.83,0:13:18.58,Default,,0,0,0,,Менің ата-бабам - Кудо Юцунэ, Хэйан самурайы.
Dialogue: 0,0:13:18.67,0:13:21.17,Default,,0,0,0,,Нағыз самурай тұқымы.
Dialogue: 0,0:13:22.13,0:13:26.63,Default,,0,0,0,,Дегенмен, мен өзім Тохокуда күріш өсіремін.
Dialogue: 0,0:13:26.72,0:13:29.14,Default,,0,0,0,,Ол тек төмен дәрежелі самурай болды
Dialogue: 0,0:13:35.23,0:13:39.65,Default,,0,0,0,,Ұлы мен немересін самурай өлтірді
Dialogue: 0,0:13:40.73,0:13:44.32,Default,,0,0,0,,Әрине, мен ол сеппуку жасайды деп ойладым.
Dialogue: 0,0:13:45.24,0:13:48.16,Default,,0,0,0,,Бұл самурайдың өрескел шабуылы болды.
Dialogue: 0,0:13:48.24,0:13:52.16,Default,,0,0,0,,Оған жеңіл жаза ретінде шығару жазасы тағайындалды.
Dialogue: 0,0:13:53.24,0:13:57.37,Default,,0,0,0,,Бүркіт кек алу үшін ауылдан шықты.
Dialogue: 0,0:13:59.38,0:14:00.92,Default,,0,0,0,,Мен сонда не көрдім
Dialogue: 0,0:14:01.88,0:14:07.38,Default,,0,0,0,,Жолда жүрген қарт монахты әкеліп, сынақтан өту.
Dialogue: 0,0:14:08.47,0:14:13.31,Default,,0,0,0,,Ашкөздік үшін зорлық-зомбылықты қайталайтын бейбақтар.
Dialogue: 0,0:14:14.52,0:14:16.06,Default,,0,0,0,,Жағымсыз күлкі
Dialogue: 0,0:14:16.14,0:14:18.89,Default,,0,0,0,,Самурай - бұл жай ғана атау
Dialogue: 0,0:14:19.40,0:14:24.32,Default,,0,0,0,,Осындай адамдардың кесірінен әлсіздер құрбан болады.
Dialogue: 0,0:14:25.69,0:14:27.90,Default,,0,0,0,,Олай болса, ол жойылады.
Dialogue: 0,0:14:28.90,0:14:30.87,Default,,0,0,0,,Ол жойылады
Dialogue: 0,0:14:35.41,0:14:39.42,Default,,0,0,0,,Тозаққа барынша көп самурай жіберу
Dialogue: 0,0:14:39.50,0:14:41.83,Default,,0,0,0,,Кен-сан сөзін жалғастырды
Dialogue: 0,0:14:41.92,0:14:46.34,Default,,0,0,0,,Күндіз оққағар, түнде өлтіру
Dialogue: 0,0:14:46.42,0:14:51.72,Default,,0,0,0,,Мен өз жолыммен 20-дан астам адамды таңдап өлтірдім.
Dialogue: 0,0:14:52.93,0:14:56.64,Default,,0,0,0,,Қанағаттандым, бірақ күлмедім.
Dialogue: 0,0:14:57.43,0:14:59.77,Default,,0,0,0,,Бір адамды өлтірген сайын
Dialogue: 0,0:14:59.85,0:15:05.27,Default,,0,0,0,,Өйткені азғантай ғана кінә сезімі тор сияқты жиналып қалған еді.
Dialogue: 0,0:15:06.44,0:15:09.95,Default,,0,0,0,,Сол кезде мен ол кісімен таныстым.
Dialogue: 0,0:15:10.45,0:15:13.95,Default,,0,0,0,,Бұл қарттың кінәсі емес.
Dialogue: 0,0:15:14.03,0:15:17.37,Default,,0,0,0,,Бір қарағанда біздің шешіміміз басқаша екенін аңғардым.
Dialogue: 0,0:15:17.95,0:15:20.37,Default,,0,0,0,,Уақыт нашар.
Dialogue: 0,0:15:20.46,0:15:23.13,Default,,0,0,0,,Оны өзгерткіңіз келе ме?
Dialogue: 0,0:15:24.96,0:15:29.21,Default,,0,0,0,,Ол кісінің айтқаны анахронизм.
Dialogue: 0,0:15:29.30,0:15:33.64,Default,,0,0,0,,Бұл арман оқиғасы немесе жалған мәлімдемеден басқа ештеңе болмауы мүмкін.
Dialogue: 0,0:15:34.35,0:15:39.64,Default,,0,0,0,,Бірақ майдан даласына шықпай өлгенім артық.
Dialogue: 0,0:15:39.73,0:15:43.65,Default,,0,0,0,,Бұл адасушылықтың ақиқаты бар.
Dialogue: 0,0:15:43.73,0:15:47.40,Default,,0,0,0,,Хехехе... Анау қарт күшті екен.
Dialogue: 0,0:15:47.48,0:15:49.40,Default,,0,0,0,,Ақыр соңында, Доджода ешкім жоқ...
Dialogue: 0,0:15:49.49,0:15:51.74,Default,,0,0,0,,Гах гах!
Dialogue: 0,0:15:52.49,0:15:54.78,Default,,0,0,0,,Менің атым Таза
Dialogue: 0,0:15:54.87,0:15:57.45,Default,,0,0,0,,Жануарды аулайтындар самурай деп аталады
Dialogue: 0,0:15:57.53,0:15:59.66,Default,,0,0,0,,Енді қаруларыңды алыңдар!
Dialogue: 0,0:15:59.75,0:16:02.29,Default,,0,0,0,,Егер сіз нағыз самурай болсаңыз!
Dialogue: 0,0:16:05.92,0:16:07.29,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:16:07.38,0:16:09.71,Default,,0,0,0,,Не болса да істеймін дейсің.
Dialogue: 0,0:16:09.80,0:16:11.05,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:11.13,0:16:13.13,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:16:14.09,0:16:15.89,Default,,0,0,0,,- (Нагакура) Түсіндім - (Харада) Иә?
Dialogue: 0,0:16:18.14,0:16:21.10,Default,,0,0,0,,Мен мұны осы мойынмен қалағандай жасаймын
Dialogue: 0,0:16:21.18,0:16:22.35,Default,,0,0,0,,Уф
Dialogue: 0,0:16:22.98,0:16:26.90,Default,,0,0,0,,Сәлем! Сен не деп әзілдеп тұрсың, Шинпачи?
Dialogue: 0,0:16:26.98,0:16:28.07,Default,,0,0,0,,Қалжың емес
Dialogue: 0,0:16:28.86,0:16:30.73,Default,,0,0,0,,Уа, бұл қауіпті.
Dialogue: 0,0:16:32.74,0:16:34.78,Default,,0,0,0,,Ол шұбарланған болар еді.
Dialogue: 0,0:16:34.86,0:16:35.82,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:35.91,0:16:37.41,Default,,0,0,0,,Бастың қарғыс атқан рухы қай жерде екен?
Dialogue: 0,0:16:37.49,0:16:39.16,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:16:39.24,0:16:42.66,Default,,0,0,0,,Ұлым мен немеремнен кек алдым.
Dialogue: 0,0:16:43.41,0:16:48.67,Default,,0,0,0,,Дегенмен, ата-анаға балаларының жауларынан кек алуға сегунат тыйым салған.
Dialogue: 0,0:16:48.75,0:16:53.34,Default,,0,0,0,,Иә, сондықтан доменді тастап, ауылдан шықтым.
Dialogue: 0,0:16:53.97,0:16:57.47,Default,,0,0,0,,Бірақ бұл 30 жыл бұрын болды.
Dialogue: 0,0:16:57.55,0:17:01.43,Default,,0,0,0,,Дәл қазір жау далада өліп қалады.
Dialogue: 0,0:17:01.52,0:17:03.52,Default,,0,0,0,,Самурайларға деген өшпенділік
Dialogue: 0,0:17:03.60,0:17:06.31,Default,,0,0,0,,Мен мүмкіндігінше көп адамды өлтіре алсам, бәрі жақсы.
Dialogue: 0,0:17:06.40,0:17:08.02,Default,,0,0,0,,солай дейді.
Dialogue: 0,0:17:08.52,0:17:11.82,Default,,0,0,0,,Бірақ Миброда бізде самурай жоқ.
Dialogue: 0,0:17:11.90,0:17:13.07,Default,,0,0,0,,Ах
Dialogue: 0,0:17:16.41,0:17:20.83,Default,,0,0,0,,Олардың көпшілігі фермерлер мен рониндер, қалғандары белгісіз.
Dialogue: 0,0:17:20.91,0:17:22.41,Default,,0,0,0,,Бірақ олардың арасында
Dialogue: 0,0:17:22.49,0:17:26.33,Default,,0,0,0,,Мен және Серизава, Камо ғана беделді самурайлар отбасынан шыққанбыз.
Dialogue: 0,0:17:27.17,0:17:29.42,Default,,0,0,0,,Мен сенің кекіңді көтере аламын.
Dialogue: 0,0:17:30.34,0:17:32.46,Default,,0,0,0,,Мен сені істей алмаймын
Dialogue: 0,0:17:33.42,0:17:36.34,Default,,0,0,0,,Сіз істеп жатқан нәрсе дұрыс емес.
Dialogue: 0,0:17:37.09,0:17:40.14,Default,,0,0,0,,Бірақ мен оны аяқтай алмау сезімін де түсінемін.
Dialogue: 0,0:17:40.22,0:17:45.48,Default,,0,0,0,,Қызық, Шинпачи Нагакураның басы найзаны орнында ұстай ала ма?
Dialogue: 0,0:17:45.56,0:17:47.44,Default,,0,0,0,,Онда алдымен өл!
Dialogue: 0,0:17:49.61,0:17:50.77,Default,,0,0,0,,Ой
Dialogue: 0,0:17:51.61,0:17:54.03,Default,,0,0,0,,Саносуке не істейді?
Dialogue: 0,0:17:56.11,0:17:57.78,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:18:00.66,0:18:03.54,Default,,0,0,0,,Ақсақал, жолың жоқ.
Dialogue: 0,0:18:03.62,0:18:04.79,Default,,0,0,0,,Не?
Dialogue: 0,0:18:04.87,0:18:09.50,Default,,0,0,0,,Сіз мұны неше ондаған жыл бойы істеп жүрсіз? сенде талант жоқ
Dialogue: 0,0:18:09.58,0:18:11.96,Default,,0,0,0,,Сен қарғыс атқыр!
Dialogue: 0,0:18:16.13,0:18:17.13,Default,,0,0,0,,Не!
Dialogue: 0,0:18:18.93,0:18:20.05,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:18:20.14,0:18:22.14,Default,,0,0,0,,Сіз оны көре аласыз.
Dialogue: 0,0:18:22.97,0:18:25.06,Default,,0,0,0,,Менің көзім жақсы көретін сияқты.
Dialogue: 0,0:18:29.73,0:18:31.36,Default,,0,0,0,,Уау
Dialogue: 0,0:18:31.44,0:18:32.48,Default,,0,0,0,,Гухаа
Dialogue: 0,0:18:33.40,0:18:34.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.07,0:18:37.40,Default,,0,0,0,,Мен Шинпачи сияқты тәтті емеспін.
Dialogue: 0,0:18:37.90,0:18:39.95,Default,,0,0,0,,Сіздің жағдайыңыз маңызды емес.
Dialogue: 0,0:18:40.66,0:18:42.53,Default,,0,0,0,,Мен өлтіргенде, мен оны шынымен жасаймын.
Dialogue: 0,0:18:49.04,0:18:51.00,Default,,0,0,0,,Не!
Dialogue: 0,0:18:51.08,0:18:53.00,Default,,0,0,0,,Қылыш та жаман емес.
Dialogue: 0,0:18:53.09,0:18:56.46,Default,,0,0,0,,Өйткені, бұл маған көбірек жарасады.
Dialogue: 0,0:18:56.55,0:18:57.71,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:00.34,0:19:03.30,Default,,0,0,0,,Мен бала кезімнен жабайы адаммын.
Dialogue: 0,0:19:03.39,0:19:07.98,Default,,0,0,0,,Ол зорлық-зомбылық көрсетіп, төбелесті және барлық жерде бәрі жақсы болмады.
Dialogue: 0,0:19:08.06,0:19:10.69,Default,,0,0,0,,Мен мұны ақыры таптым
Dialogue: 0,0:19:11.19,0:19:13.61,Default,,0,0,0,,Сіздің әдеттегі орныңыз қандай?
Dialogue: 0,0:19:17.65,0:19:18.61,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.69,0:19:21.61,Default,,0,0,0,,Бұл қандай топ?
Dialogue: 0,0:19:22.24,0:19:25.87,Default,,0,0,0,,Неге сақал қойып, шашыңды байламайсың?
Dialogue: 0,0:19:25.95,0:19:29.12,Default,,0,0,0,,Ол самурайға ұқсамайды ма?
Dialogue: 0,0:19:32.04,0:19:33.29,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:19:33.38,0:19:34.38,Default,,0,0,0,,Уф
Dialogue: 0,0:19:34.96,0:19:37.46,Default,,0,0,0,,Көп адамға айтқым келмейді, бірақ
Dialogue: 0,0:19:38.05,0:19:42.13,Default,,0,0,0,,Самурай ретінде мен Мибурода болғаным үшін өзімді нашар сезіндім.
Dialogue: 0,0:19:42.72,0:19:44.93,Default,,0,0,0,,Сіз ниет етпесеңіз де
Dialogue: 0,0:19:45.01,0:19:47.06,Default,,0,0,0,,Ынтымақ пен қабырға деген не?
Dialogue: 0,0:19:47.14,0:19:50.48,Default,,0,0,0,,Олай ойламағандар біртүрлі болады.
Dialogue: 0,0:19:51.23,0:19:55.98,Default,,0,0,0,,Тым болмаса ронинге ұқсатқан дұрыс деп ойладым.
Dialogue: 0,0:19:56.06,0:19:57.15,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:58.15,0:20:01.40,Default,,0,0,0,,Ол келгеннен бері мен өзімді ақымақ сезінемін.
Dialogue: 0,0:20:01.49,0:20:02.65,Default,,0,0,0,,Әлгі жігіт?
Dialogue: 0,0:20:02.74,0:20:05.66,Default,,0,0,0,,Ах, тұшпара цехының баласы.
Dialogue: 0,0:20:06.24,0:20:08.24,Default,,0,0,0,,Данго дүкені? Бала?
Dialogue: 0,0:20:08.33,0:20:09.49,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:20:09.58,0:20:11.91,Default,,0,0,0,,Бұл аңғал.
Dialogue: 0,0:20:12.62,0:20:14.92,Default,,0,0,0,,Ұрысқа аттанғалы жатыр
Dialogue: 0,0:20:15.00,0:20:18.42,Default,,0,0,0,,Сонда да мен қобалжыдым, оңай жыламаңыз.
Dialogue: 0,0:20:18.50,0:20:22.26,Default,,0,0,0,,Ол икемді емес болғандықтан кейбір жерлерде қиындық тудыруы мүмкін.
Dialogue: 0,0:20:22.34,0:20:25.93,Default,,0,0,0,,Бұл көк және қауіпті, Көзімді алмаймын
Dialogue: 0,0:20:26.01,0:20:27.39,Default,,0,0,0,,Таро, кешігіп қалдыңыз!
Dialogue: 0,0:20:26.01,0:20:27.39,Default,,0,0,0,,Ешқашан орталықта болмаса да
Dialogue: 0,0:20:27.39,0:20:27.47,Default,,0,0,0,,Ешқашан орталықта болмаса да
Dialogue: 0,0:20:27.47,0:20:28.93,Default,,0,0,0,,Ешқашан орталықта болмаса да
Dialogue: 0,0:20:27.47,0:20:28.93,Default,,0,0,0,,Сіз баяусыз!
Dialogue: 0,0:20:29.01,0:20:30.72,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:20:29.01,0:20:30.72,Default,,0,0,0,,Біреу барда бірге болу қызық
Dialogue: 0,0:20:30.72,0:20:31.93,Default,,0,0,0,,Біреу жүргенде бірге болу қызық.
Dialogue: 0,0:20:35.02,0:20:38.44,Default,,0,0,0,,Әй, мұңайғандары да көп.
Dialogue: 0,0:20:38.52,0:20:39.94,Default,,0,0,0,,Кішкентай самурай
Dialogue: 0,0:20:40.03,0:20:45.20,Default,,0,0,0,,Бір кездері қайыршы болған адамдар бар, оларды алып, жасырын көмек көрсеткен.
Dialogue: 0,0:20:46.03,0:20:50.16,Default,,0,0,0,,Бізді қабылдамау мүмкін, бірақ Миброда бізде орын бар.
Dialogue: 0,0:20:53.29,0:20:57.58,Default,,0,0,0,,Маған сіздей емес, туған-туысым, өскен ортам бәрібір.
Dialogue: 0,0:21:00.17,0:21:01.71,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:21:01.80,0:21:04.59,Default,,0,0,0,,Менің үйіме де келсең болды.
Dialogue: 0,0:21:04.68,0:21:06.89,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:21:10.35,0:21:11.56,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:21:12.27,0:21:13.60,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:21:13.68,0:21:16.56,Default,,0,0,0,,Иә, солай істейік!
Dialogue: 0,0:21:16.65,0:21:18.86,Default,,0,0,0,,Менің үйіме келсең, мен сенімен сөйлесемін.
Dialogue: 0,0:21:18.94,0:21:24.15,Default,,0,0,0,,Біз Мибростардың бәрі ескірген қылышшылар екеніміз рас.
Dialogue: 0,0:21:24.24,0:21:27.86,Default,,0,0,0,,Сіз дайындаған жекпе-жек өнеріңіз бекер болмайды.
Dialogue: 0,0:21:30.91,0:21:32.12,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.20,0:21:34.37,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:21:37.46,0:21:39.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.96,0:21:44.51,Default,,0,0,0,,Ах
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:11.55,0:23:16.56,Default,,0,0,0,,～♪
Dialogue: 0,0:23:23.90,0:23:25.98,Default,,0,0,0,,Хиджиката Тосизо
Dialogue: 0,0:23:26.07,0:23:30.20,Default,,0,0,0,,Нагакура мен Саносуке де басқа көпірде күшті жаулармен соғысуда.
Dialogue: 0,0:23:30.28,0:23:32.70,Default,,0,0,0,,Менің де жеңілуге шамасы жоқ
Dialogue: 0,0:23:32.78,0:23:35.45,Default,,0,0,0,,Сакура жасаған қылыштың да сапасы жоғары.
Dialogue: 0,0:23:35.95,0:23:38.25,Default,,0,0,0,,Қарсылас қаншалықты шебер болса да
Dialogue: 0,0:23:38.33,0:23:43.21,Default,,0,0,0,,Қылышымды өз жолыммен сермеп жүре беремін.
Dialogue: 0,0:23:43.83,0:23:46.42,Default,,0,0,0,,Келесі жолы «Топырақ адамы»
Dialogue: 0,0:23:46.50,0:23:48.84,Default,,0,0,0,,Қараңдаршы, солай.
Dialogue: 0,0:23:50.34,0:23:56.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
