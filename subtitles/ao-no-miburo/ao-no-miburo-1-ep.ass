Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:02.91,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:00:03.00,0:00:05.21,Default,,0,0,0,,Мұғалім! Нагакура мырза!
Dialogue: 0,0:00:05.29,0:00:09.38,Default,,0,0,0,,Шинпачи атасы, тезірек әңгімені жалғастырыңыз.
Dialogue: 0,0:00:09.46,0:00:12.67,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:00:12.76,0:00:16.34,Default,,0,0,0,,Шинсенгуми туралы естігіңіз келсе, сіз заттарды жақсы көретін адам болуыңыз керек.
Dialogue: 0,0:00:16.43,0:00:20.06,Default,,0,0,0,,Гукен бюросының басшысы Исаму Кондоның оқиғасы.
Dialogue: 0,0:00:20.14,0:00:21.47,Default,,0,0,0,,Хиджиката Тосизо жақсы
Dialogue: 0,0:00:21.56,0:00:24.31,Default,,0,0,0,,Бұл Окита Суджи, данышпан Окита.
Dialogue: 0,0:00:24.39,0:00:26.27,Default,,0,0,0,,Бүркіт туралы әңгіме ше?
Dialogue: 0,0:00:27.65,0:00:28.69,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:00:29.82,0:00:33.40,Default,,0,0,0,,Мен сізге басқа жерде айтпаған ерекше оқиғаны айтқым келеді.
Dialogue: 0,0:00:33.49,0:00:35.91,Default,,0,0,0,,- (Бала) Ой! Қоймада жоқ па? -қызық!
Dialogue: 0,0:00:35.99,0:00:37.24,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:00:37.32,0:00:39.28,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:00:40.12,0:00:42.70,Default,,0,0,0,,Ол кісілер тарихта қалмайды.
Dialogue: 0,0:00:43.20,0:00:46.62,Default,,0,0,0,,Бірақ сол себепті мен оны жақсы есте сақтаймын.
Dialogue: 0,0:00:54.51,0:00:57.01,Default,,0,0,0,,Үш қасқыр
Dialogue: 0,0:00:58.09,0:01:01.22,Default,,0,0,0,,Әсіресе сол ақ шаш.
Dialogue: 0,0:01:02.39,0:01:07.40,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.93,0:02:31.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:56.42,0:02:58.97,Default,,0,0,0,,О, мен істеп жатырмын.
Dialogue: 0,0:02:59.05,0:03:00.01,Default,,0,0,0,,Мен сізге кедергі келтіремін
Dialogue: 0,0:03:00.09,0:03:00.97,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:03:01.05,0:03:02.89,Default,,0,0,0,,Екеуі де керемет, екіншісі.
Dialogue: 0,0:03:02.97,0:03:04.22,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:03:04.80,0:03:06.47,Default,,0,0,0,,Бұл хит, Соуджи.
Dialogue: 0,0:03:06.56,0:03:09.52,Default,,0,0,0,,Сол үшін айттым, Хиджиката-сан.
Dialogue: 0,0:03:09.60,0:03:11.35,Default,,0,0,0,,Менің болжамым дұрыс.
Dialogue: 0,0:03:11.44,0:03:13.44,Default,,0,0,0,,Іші толып қалды.
Dialogue: 0,0:03:13.52,0:03:15.69,Default,,0,0,0,,Сыртта күтіңіз
Dialogue: 0,0:03:21.36,0:03:22.82,Default,,0,0,0,,Бізге қонаққа келіңіз
Dialogue: 0,0:03:22.91,0:03:25.28,Default,,0,0,0,,Күн ыстық, абай болыңыз
Dialogue: 0,0:03:25.37,0:03:28.33,Default,,0,0,0,,Әй, бұл сүйкімді қыз.
Dialogue: 0,0:03:28.41,0:03:31.54,Default,,0,0,0,,Эхехе, рахмет...
Dialogue: 0,0:03:32.67,0:03:35.21,Default,,0,0,0,,Хиджикатаның жүзі
Dialogue: 0,0:03:35.29,0:03:37.13,Default,,0,0,0,,О? Мен баламын...
Dialogue: 0,0:03:37.21,0:03:40.88,Default,,0,0,0,,Білемін, сен балаларды жек көресің.
Dialogue: 0,0:03:40.97,0:03:43.93,Default,,0,0,0,,Жоқ, олар мені жек көреді.
Dialogue: 0,0:03:44.43,0:03:47.76,Default,,0,0,0,,Балалар жақсы мен жаманды ажырата алады.
Dialogue: 0,0:03:50.02,0:03:51.73,Default,,0,0,0,,Ироха~!
Dialogue: 0,0:03:51.81,0:03:53.14,Default,,0,0,0,,Иә
Dialogue: 0,0:03:54.35,0:03:56.36,Default,,0,0,0,,Бірақ сіз байқадыңыз ба?
Dialogue: 0,0:03:57.02,0:03:59.86,Default,,0,0,0,,Бұл дүкенде тағы бір кемпір жұмыс істейді.
Dialogue: 0,0:04:00.61,0:04:02.61,Default,,0,0,0,,- (Хиджиката) Мынау бала - (Окита) Не!
Dialogue: 0,0:04:04.74,0:04:05.74,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:04:09.04,0:04:10.25,Default,,0,0,0,,Оданго
Dialogue: 0,0:04:10.33,0:04:12.62,Default,,0,0,0,,А, ол шынымен де бала ғой.
Dialogue: 0,0:04:12.71,0:04:15.75,Default,,0,0,0,,Оның үстіне мұқият қарасаңыз, қорықпайтын түрі бар.
Dialogue: 0,0:04:15.83,0:04:17.00,Default,,0,0,0,,Бұл ұл бала ма?
Dialogue: 0,0:04:17.09,0:04:19.75,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:04:19.84,0:04:21.05,Default,,0,0,0,,Тыңдармандар, танысуға қуаныштымын.
Dialogue: 0,0:04:21.13,0:04:24.55,Default,,0,0,0,,Әдемі, жұқа қардай таза аппақ.
Dialogue: 0,0:04:25.22,0:04:27.93,Default,,0,0,0,,Ахаха рахмет
Dialogue: 0,0:04:28.01,0:04:29.81,Default,,0,0,0,,Мүмкін мен де солай істеуім керек шығар.
Dialogue: 0,0:04:29.89,0:04:30.72,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:04:30.81,0:04:32.02,Default,,0,0,0,,(Нио күлді)
Dialogue: 0,0:04:32.10,0:04:33.27,Default,,0,0,0,,Кадовакаши?
Dialogue: 0,0:04:33.98,0:04:38.15,Default,,0,0,0,,Жақсы, соңғы кездері адам ұрлау көп болды.
Dialogue: 0,0:04:38.23,0:04:40.27,Default,,0,0,0,,Олар тек жас балаларды нысанаға алатын сияқты.
Dialogue: 0,0:04:40.36,0:04:43.78,Default,,0,0,0,,Бұл қорқынышты, бұл қазірдің өзінде тозақ
Dialogue: 0,0:04:45.03,0:04:48.28,Default,,0,0,0,,Мен келдім, балалар сендер де дүкенге бара беріңдер~
Dialogue: 0,0:04:49.12,0:04:50.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:50.62,0:04:53.96,Default,,0,0,0,,Неге екені белгісіз, Киото халқы мені жек көреді.
Dialogue: 0,0:04:54.04,0:04:57.67,Default,,0,0,0,,Әпкем Киотоға барғанда да хат жазуымды айтты.
Dialogue: 0,0:04:57.75,0:05:00.17,Default,,0,0,0,,Менің жазуға уақытым жоқ.
Dialogue: 0,0:05:00.25,0:05:02.21,Default,,0,0,0,,Данго Қалай болды?
Dialogue: 0,0:05:02.71,0:05:04.38,Default,,0,0,0,,А, дәмді
Dialogue: 0,0:05:04.47,0:05:05.80,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:08.39,0:05:10.05,Default,,0,0,0,,Сіздің атыңыз кім?\NСізге хабарлаймын,
Dialogue: 0,0:05:10.14,0:05:12.22,Default,,0,0,0,,...
Dialogue: 0,0:05:12.31,0:05:14.68,Default,,0,0,0,,үшін? Бұл біртүрлі атау
Dialogue: 0,0:05:14.77,0:05:16.35,Default,,0,0,0,,Учиха Ироха
Dialogue: 0,0:05:16.44,0:05:19.19,Default,,0,0,0,,Ироха! Бұл әдемі есім
Dialogue: 0,0:05:19.27,0:05:21.94,Default,,0,0,0,,(Ироханың күлкісі)
Dialogue: 0,0:05:22.73,0:05:24.78,Default,,0,0,0,,Жақсы аға мен апа жақсы араласады
Dialogue: 0,0:05:24.86,0:05:26.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:26.53,0:05:28.20,Default,,0,0,0,,Әженің есебі
Dialogue: 0,0:05:28.28,0:05:31.87,Default,,0,0,0,,Хун, мен оны 5 тұшпарамен жасадым.
Dialogue: 0,0:05:31.95,0:05:34.20,Default,,0,0,0,,Кешіріңіз, бұл жақсы болды.
Dialogue: 0,0:05:35.50,0:05:36.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:37.00,0:05:40.21,Default,,0,0,0,,Бұл сәнді кимоно. Сіз оны өзіңіз жасадыңыз ба?
Dialogue: 0,0:05:40.29,0:05:42.75,Default,,0,0,0,,А, түсіндің.
Dialogue: 0,0:05:43.84,0:05:47.05,Default,,0,0,0,,Тәттілерді ұнатпасаңыз, қайнатылған тофуды да жеуге болады.
Dialogue: 0,0:05:50.14,0:05:52.43,Default,,0,0,0,,Сіз заттарды жақсы көресіз.
Dialogue: 0,0:05:54.10,0:05:57.27,Default,,0,0,0,,Келесі жолы оширукоға тапсырыс беремін деп ойлаймын.
Dialogue: 0,0:05:57.35,0:06:00.73,Default,,0,0,0,,Окини! Қайта келіңіз!
Dialogue: 0,0:06:00.81,0:06:02.57,Default,,0,0,0,,Оны тоқтатқан дұрыс.
Dialogue: 0,0:06:02.65,0:06:03.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.07,0:06:06.24,Default,,0,0,0,,Канто екпіні арқылы тануға болады
Dialogue: 0,0:06:06.32,0:06:08.24,Default,,0,0,0,,Иә, соңғы уақытта қауесеттер болды.
Dialogue: 0,0:06:09.20,0:06:10.62,Default,,0,0,0,,«Mibro» және
Dialogue: 0,0:06:10.70,0:06:12.28,Default,,0,0,0,,Хо Хонмакай
Dialogue: 0,0:06:12.37,0:06:14.12,Default,,0,0,0,,О, сөзсіз.
Dialogue: 0,0:06:14.20,0:06:16.62,Default,,0,0,0,,«Мибро» деген не?
Dialogue: 0,0:06:17.21,0:06:20.54,Default,,0,0,0,,Мибу ауылына қоныстанған Нами ретінде жазылған
Dialogue: 0,0:06:20.63,0:06:21.63,Default,,0,0,0,,«Мибу толқыны»
Dialogue: 0,0:06:22.13,0:06:25.67,Default,,0,0,0,,Сіз Эдодан көптеген Роши-гуми шыққанын білесіз бе?
Dialogue: 0,0:06:25.76,0:06:27.13,Default,,0,0,0,,Иә, тыңдап жатырмын.
Dialogue: 0,0:06:27.76,0:06:32.05,Default,,0,0,0,,Киотоға баратын генералды қорғау үшін Киотоға келді.
Dialogue: 0,0:06:32.60,0:06:34.56,Default,,0,0,0,,Бірақ сіз бірден үйге кеткеніңізді айттыңыз.
Dialogue: 0,0:06:34.64,0:06:35.93,Default,,0,0,0,,Көбінесе
Dialogue: 0,0:06:36.02,0:06:39.27,Default,,0,0,0,,Өкінішке орай, олардың кейбіреулері қалды.
Dialogue: 0,0:06:39.35,0:06:41.73,Default,,0,0,0,,Бұл Мибро
Dialogue: 0,0:06:41.81,0:06:45.07,Default,,0,0,0,,Мынау: адамдарды себепсіз өлтіру.
Dialogue: 0,0:06:45.15,0:06:47.61,Default,,0,0,0,,Дүкенді бұзып, ақша бопсалау
Dialogue: 0,0:06:47.69,0:06:49.40,Default,,0,0,0,,Біраз зорлық-зомбылық болатын сияқты.
Dialogue: 0,0:06:49.49,0:06:50.57,Default,,0,0,0,,-Иә... -Сонымен...
Dialogue: 0,0:06:50.66,0:06:52.53,Default,,0,0,0,,Бұл тәртіпсіздік.
Dialogue: 0,0:06:53.12,0:06:55.66,Default,,0,0,0,,Сегунаттың әлсіздігі басты себеп
Dialogue: 0,0:06:55.74,0:06:59.21,Default,,0,0,0,,Қара кемелер келгеннен кейін тауарлардың бағасы көтерілді.
Dialogue: 0,0:06:59.29,0:07:02.00,Default,,0,0,0,,Джойды шақырып, қылыш сермеу
Dialogue: 0,0:07:02.08,0:07:04.54,Default,,0,0,0,,Не керек, егер Канто бүлікшілері кірсе,
Dialogue: 0,0:07:04.63,0:07:07.46,Default,,0,0,0,,Өмір жетпейді
Dialogue: 0,0:07:07.55,0:07:09.26,Default,,0,0,0,,Ендеше, араласпағаныңыз жөн.
Dialogue: 0,0:07:09.34,0:07:11.38,Default,,0,0,0,,Иә, ол еркек, иә!
Dialogue: 0,0:07:11.47,0:07:12.30,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.39,0:07:15.60,Default,,0,0,0,,Дүкен жабық. Тезірек үйге қайт!
Dialogue: 0,0:07:17.72,0:07:21.06,Default,,0,0,0,,Қандай үлкен көмек.
Dialogue: 0,0:07:21.14,0:07:23.10,Default,,0,0,0,,Қауіпті адам...
Dialogue: 0,0:07:24.02,0:07:26.90,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:07:36.24,0:07:37.08,Default,,0,0,0,,Аға
Dialogue: 0,0:07:37.91,0:07:40.45,Default,,0,0,0,,Миброс қорқынышты адамдар ма?
Dialogue: 0,0:07:41.16,0:07:44.13,Default,,0,0,0,,Дұрыс. Ироха не ойлады?
Dialogue: 0,0:07:44.21,0:07:45.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:45.92,0:07:49.34,Default,,0,0,0,,Мен бізді қызықты адамдар деп ойладым.
Dialogue: 0,0:07:49.80,0:07:51.42,Default,,0,0,0,,-Ироха -Иә?
Dialogue: 0,0:07:53.26,0:07:56.93,Default,,0,0,0,,Менің ойымша, алдымен көргендеріңізге және естігендеріңізге сенсеңіздер жақсы болады.
Dialogue: 0,0:07:58.01,0:08:01.85,Default,,0,0,0,,Уау! Менің ағам керемет
Dialogue: 0,0:08:01.93,0:08:02.81,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:08:02.89,0:08:05.19,Default,,0,0,0,,- (Әже) Әй! - (Нии/Ироха) Ауырды!
Dialogue: 0,0:08:06.11,0:08:09.40,Default,,0,0,0,,Сәлеметсіз бе, мен бүгін тағы келдім.
Dialogue: 0,0:08:09.48,0:08:11.40,Default,,0,0,0,,Бізге қонаққа келіңіз
Dialogue: 0,0:08:12.07,0:08:14.41,Default,,0,0,0,,О? Бүгін бос.
Dialogue: 0,0:08:14.49,0:08:16.03,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:16.12,0:08:17.70,Default,,0,0,0,,Канкодори Ява
Dialogue: 0,0:08:20.24,0:08:21.91,Default,,0,0,0,,Фуфу, дәмді, дәмді
Dialogue: 0,0:08:22.00,0:08:24.96,Default,,0,0,0,,Арнайы шируко және қайнатылған тофу.
Dialogue: 0,0:08:25.04,0:08:26.21,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:08:26.83,0:08:29.88,Default,,0,0,0,,Әже, бұл екеуі аға-қарындас емес.
Dialogue: 0,0:08:29.96,0:08:30.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.30,0:08:33.34,Default,,0,0,0,,Не? Сіз қалай білесіз?
Dialogue: 0,0:08:33.42,0:08:36.80,Default,,0,0,0,,Ирохатоның реті дұрыс емес.
Dialogue: 0,0:08:33.42,0:08:36.80,Default,,0,0,0,,(Балалар әні)
Dialogue: 0,0:08:36.80,0:08:36.89,Default,,0,0,0,,(Балалар әні)
Dialogue: 0,0:08:36.89,0:08:38.47,Default,,0,0,0,,(Балалар әні)
Dialogue: 0,0:08:36.89,0:08:38.47,Default,,0,0,0,,Сіз артта қалдыңыз
Dialogue: 0,0:08:38.55,0:08:40.14,Default,,0,0,0,,Тапсырыс…
Dialogue: 0,0:08:40.22,0:08:42.56,Default,,0,0,0,,Ах, Ироханихото
Dialogue: 0,0:08:42.64,0:08:45.31,Default,,0,0,0,,Түсіндім, жақында Ироха келеді.
Dialogue: 0,0:08:45.39,0:08:47.27,Default,,0,0,0,,Жоқ, олар аға-әпке.
Dialogue: 0,0:08:47.36,0:08:48.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:48.86,0:08:53.07,Default,,0,0,0,,Ироха туылғаннан кейін бірден ата-анасының қайтыс болғанын көрді.
Dialogue: 0,0:08:53.15,0:08:56.41,Default,,0,0,0,,Таңертең мені ғибадатханада ұстады.
Dialogue: 0,0:08:56.49,0:08:58.20,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:08:59.28,0:09:03.70,Default,,0,0,0,,Екеуі де өмір бойы жетім, жалғыз қалды.
Dialogue: 0,0:09:03.79,0:09:06.83,Default,,0,0,0,,Үшеуміз 10 жыл бірге жұмыс істеп келеміз.
Dialogue: 0,0:09:06.92,0:09:10.21,Default,,0,0,0,,Қандас болмасақ та
Dialogue: 0,0:09:11.55,0:09:14.22,Default,,0,0,0,,Бұл екеуі аға мен апа.
Dialogue: 0,0:09:15.34,0:09:17.34,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:09:17.93,0:09:21.14,Default,,0,0,0,,Дүкен де өте пайдалы болды.
Dialogue: 0,0:09:21.22,0:09:24.68,Default,,0,0,0,,Сіз әсіресе ұшқыр сияқтысыз.
Dialogue: 0,0:09:26.52,0:09:30.19,Default,,0,0,0,,Ол бала өте өнерлі, зерек.
Dialogue: 0,0:09:30.27,0:09:33.86,Default,,0,0,0,,Мен тым шебер болып, балаға ұқсамайтын кездер болады.
Dialogue: 0,0:09:34.61,0:09:39.62,Default,,0,0,0,,Үш жылдан кейін менсіз өз қолыңмен жасайсың.
Dialogue: 0,0:09:40.20,0:09:44.12,Default,,0,0,0,,Көріп отырғаныңыздай, Ироха жігерлі және сымбатты.
Dialogue: 0,0:09:44.20,0:09:48.12,Default,,0,0,0,,Күні кеше маған бір асыл кісі сыйлық береді деп шешті.
Dialogue: 0,0:09:48.21,0:09:52.63,Default,,0,0,0,,Мен бұған өте қуаныштымын...
Dialogue: 0,0:09:53.21,0:09:55.63,Default,,0,0,0,,Нағыз әже мен немере сияқты.
Dialogue: 0,0:09:55.72,0:09:56.55,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:57.72,0:10:01.39,Default,,0,0,0,,Ақымақ болма! Мүлдем
Dialogue: 0,0:10:02.31,0:10:04.56,Default,,0,0,0,,Жоқ, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:10:04.64,0:10:06.10,Default,,0,0,0,,Ах
Dialogue: 0,0:10:06.18,0:10:07.73,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:09.27,0:10:11.06,Default,,0,0,0,,Iroha ni
Dialogue: 0,0:10:11.15,0:10:14.03,Default,,0,0,0,,Қараңғы түспей үйге бірінші келгенде
Dialogue: 0,0:10:14.11,0:10:15.48,Default,,0,0,0,,Иә
Dialogue: 0,0:10:16.28,0:10:17.86,Default,,0,0,0,,-Ах!-(Хиджиката) Кешіріңіз.
Dialogue: 0,0:10:17.95,0:10:19.91,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:19.99,0:10:21.78,Default,,0,0,0,,Ішіндегі киімімізді ауыстырайық, сосын үйге қайтайық.
Dialogue: 0,0:10:21.87,0:10:23.24,Default,,0,0,0,,Иә
Dialogue: 0,0:10:24.49,0:10:27.12,Default,,0,0,0,,Қазір мүлде қараңғы.
Dialogue: 0,0:10:27.20,0:10:29.87,Default,,0,0,0,,Жарайды, інім осында.
Dialogue: 0,0:10:29.96,0:10:30.79,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.30,0:10:35.42,Default,,0,0,0,,Аға
Dialogue: 0,0:10:35.50,0:10:39.38,Default,,0,0,0,,Учине, мен ұлы асылдың баласы боламын.
Dialogue: 0,0:10:39.47,0:10:42.09,Default,,0,0,0,,Кейде мен баратын жерге тұшпара жеткізіп беремін.
Dialogue: 0,0:10:42.18,0:10:43.43,Default,,0,0,0,,А, мен мұны естідім.
Dialogue: 0,0:10:43.93,0:10:48.14,Default,,0,0,0,,Негізі мен үшеумізбен мәңгі өмір сүргім келді, бірақ...
Dialogue: 0,0:10:49.31,0:10:50.39,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:50.48,0:10:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.98,0:10:54.94,Default,,0,0,0,,Ол адамның жанында өзіңізді қауіпсіз сезінесіз, Ироха.
Dialogue: 0,0:10:57.78,0:10:59.82,Default,,0,0,0,,Бірақ сіздің ағаңыз?
Dialogue: 0,0:10:59.90,0:11:02.41,Default,,0,0,0,,Көп нәрсеге шыдап жүргеніңізге сенімдімін.
Dialogue: 0,0:11:02.49,0:11:04.99,Default,,0,0,0,,Мен ғана...
Dialogue: 0,0:11:05.58,0:11:07.29,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:11:07.37,0:11:09.21,Default,,0,0,0,,Мен Чиринуяда керемет жұмыс істеймін.
Dialogue: 0,0:11:09.91,0:11:13.00,Default,,0,0,0,,Мен нақты істегім немесе болғым келетін ештеңе жоқ.
Dialogue: 0,0:11:13.50,0:11:15.96,Default,,0,0,0,,Бұл дүниеде біз бақытты өмір сүруіміз керек емес пе?
Dialogue: 0,0:11:17.71,0:11:20.88,Default,,0,0,0,,Оның үстіне әжемді жалғыз қалдырсам, ол жылайтын шығар.
Dialogue: 0,0:11:20.97,0:11:23.59,Default,,0,0,0,,Ироха, Чиринуяға анда-санда тоқтауыңызды өтінемін.
Dialogue: 0,0:11:24.47,0:11:25.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:33.73,0:11:36.69,Default,,0,0,0,,О, жоқ, мен сені сағынатын боламын, әже.
Dialogue: 0,0:11:37.40,0:11:42.20,Default,,0,0,0,,Қолжазбаға шебер болсам, хат жазып жіберер едім.
Dialogue: 0,0:11:42.28,0:11:44.82,Default,,0,0,0,,Маған жаттығу керек пе?
Dialogue: 0,0:11:44.91,0:11:47.20,Default,,0,0,0,,-Ироха осылай! -Е!?
Dialogue: 0,0:11:48.49,0:11:49.66,Default,,0,0,0,,Иә
Dialogue: 0,0:11:52.83,0:11:55.54,Default,,0,0,0,,Жоқ, ай сәулесінде жарқырайды
Dialogue: 0,0:12:04.22,0:12:06.30,Default,,0,0,0,,Не?
Dialogue: 0,0:12:06.39,0:12:07.22,Default,,0,0,0,,Га
Dialogue: 0,0:12:07.30,0:12:11.31,Default,,0,0,0,,Соңғы кездері адам ұрлау көп болды.
Dialogue: 0,0:12:11.39,0:12:13.60,Default,,0,0,0,,Олар тек жас балаларды нысанаға алатын сияқты.
Dialogue: 0,0:12:14.44,0:12:16.11,Default,,0,0,0,,Адам ұрлау?
Dialogue: 0,0:12:17.57,0:12:18.77,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:12:19.28,0:12:20.86,Default,,0,0,0,,Ироха ағамның артында!
Dialogue: 0,0:12:21.57,0:12:22.49,Default,,0,0,0,,Ga!
Dialogue: 0,0:12:24.74,0:12:25.82,Default,,0,0,0,,Уф
Dialogue: 0,0:12:26.82,0:12:28.58,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:12:29.16,0:12:29.99,Default,,0,0,0,,Ироха!
Dialogue: 0,0:12:30.08,0:12:32.46,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:32.54,0:12:33.71,Default,,0,0,0,,Га
Dialogue: 0,0:12:33.79,0:12:38.96,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:40.09,0:12:41.84,Default,,0,0,0,,-(Хиджиката) Ақыры шықты ма? -Ха!
Dialogue: 0,0:12:43.26,0:12:45.09,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:12:49.64,0:12:52.02,Default,,0,0,0,,Ол қазірдің өзінде қосылған.
Dialogue: 0,0:12:52.10,0:12:53.02,Default,,0,0,0,,Гуа…
Dialogue: 0,0:12:55.39,0:12:56.81,Default,,0,0,0,,Артқа қалыңыз
Dialogue: 0,0:12:56.90,0:12:58.56,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:12:58.65,0:13:00.82,Default,,0,0,0,,О, сен білмейсің бе?
Dialogue: 0,0:13:01.90,0:13:03.53,Default,,0,0,0,,Жылайтын бала да көп жылайды...
Dialogue: 0,0:13:03.61,0:13:04.99,Default,,0,0,0,,«Тыныш»
Dialogue: 0,0:13:05.07,0:13:07.82,Default,,0,0,0,,Жек көретін Ронин тобы.
Dialogue: 0,0:13:09.91,0:13:12.20,Default,,0,0,0,,Еш қағыспа, тек солай істе!
Dialogue: 0,0:13:15.37,0:13:17.04,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:13:19.38,0:13:21.05,Default,,0,0,0,,Ах, Тосиро
Dialogue: 0,0:13:21.13,0:13:22.17,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:22.25,0:13:25.17,Default,,0,0,0,,Сіз оны қалай шығарғаныңызды түсінесіз.
Dialogue: 0,0:13:26.76,0:13:31.47,Default,,0,0,0,,Мен оны жұлып алмаймын, ол қылышты тот басады.
Dialogue: 0,0:13:32.35,0:13:34.48,Default,,0,0,0,,Ата…
Dialogue: 0,0:13:40.86,0:13:42.53,Default,,0,0,0,,Ұрланған балалар қайда?
Dialogue: 0,0:13:42.61,0:13:46.57,Default,,0,0,0,,Миброс, бейтаныс адамдар сені жек көреді.
Dialogue: 0,0:13:47.66,0:13:48.70,Default,,0,0,0,,Гухаа
Dialogue: 0,0:13:50.74,0:13:52.33,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:13:53.33,0:13:55.87,Default,,0,0,0,,Мен мұны ұнату үшін істемеймін.
Dialogue: 0,0:14:00.33,0:14:02.04,Default,,0,0,0,,Соуджиден айырмашылығы
Dialogue: 0,0:14:02.13,0:14:04.38,Default,,0,0,0,,Менің мінезім қорқынышты.
Dialogue: 0,0:14:06.84,0:14:11.76,Default,,0,0,0,,Ааа аа...
Dialogue: 0,0:14:12.35,0:14:15.77,Default,,0,0,0,,Сіз оны тартып алуға дайын болуыңыз керек.
Dialogue: 0,0:14:18.81,0:14:20.73,Default,,0,0,0,,Хиджиката-сан, жоқ!
Dialogue: 0,0:14:31.66,0:14:32.95,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:14:35.95,0:14:38.62,Default,,0,0,0,,Сізді кепілге алып жатқан жоқсыз ба?
Dialogue: 0,0:14:38.71,0:14:39.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.83,0:14:42.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.38,0:14:45.38,Default,,0,0,0,,Жер
Dialogue: 0,0:14:46.34,0:14:47.34,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:14:49.26,0:14:50.34,Default,,0,0,0,,Менің қызым...
Dialogue: 0,0:14:53.72,0:14:54.56,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:14:55.06,0:14:55.97,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:14:56.77,0:14:58.52,Default,,0,0,0,,Бұл кісінің қылышы
Dialogue: 0,0:14:58.60,0:15:01.02,Default,,0,0,0,,Өйткені мен ешқашан өмір бойы қиылған емеспін.
Dialogue: 0,0:15:03.61,0:15:04.90,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.57,0:15:07.65,Default,,0,0,0,,Мен олардың бекінісін түсінемін.
Dialogue: 0,0:15:08.15,0:15:11.24,Default,,0,0,0,,Шиджо-доридегі ломбардтың қасында
Dialogue: 0,0:15:11.78,0:15:13.41,Default,,0,0,0,,Қанша жау бар?
Dialogue: 0,0:15:13.95,0:15:16.99,Default,,0,0,0,,Мен білмеймін, бірақ 10 адам...
Dialogue: 0,0:15:17.08,0:15:19.58,Default,,0,0,0,,10… тым көп
Dialogue: 0,0:15:20.16,0:15:22.88,Default,,0,0,0,,Жарайды, тезірек барайық.
Dialogue: 0,0:15:23.46,0:15:24.88,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:15:24.96,0:15:26.96,Default,,0,0,0,,Таңға дейін күтіп, көмекке шақырған дұрыс...
Dialogue: 0,0:15:27.05,0:15:27.88,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:15:31.93,0:15:33.64,Default,,0,0,0,,Таң атқанша заттар құлап кетеді
Dialogue: 0,0:15:35.60,0:15:38.06,Default,,0,0,0,,Біз сізге міндетті түрде көмектесеміз
Dialogue: 0,0:15:40.73,0:15:43.77,Default,,0,0,0,,Қайтып келгенде қызыңды мақта.
Dialogue: 0,0:15:44.52,0:15:46.11,Default,,0,0,0,,Сіз аш болуыңыз керек.
Dialogue: 0,0:15:46.77,0:15:48.78,Default,,0,0,0,,Оған күріш шарларын берген дұрыс.
Dialogue: 0,0:15:49.49,0:15:52.24,Default,,0,0,0,,ni Ироха Үйге бірге бара аламыз.
Dialogue: 0,0:15:52.32,0:15:53.66,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:15:53.74,0:15:55.28,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:15:55.37,0:15:56.99,Default,,0,0,0,,Мен ертең тағы да тоқтаймын.
Dialogue: 0,0:16:04.71,0:16:06.42,Default,,0,0,0,,Жоқ, мен естідім.
Dialogue: 0,0:16:06.50,0:16:11.42,Default,,0,0,0,,Ойроха менің үйімде мұндай қорқынышты жағдайды бастан өткереді деп ешқашан ойламадым.
Dialogue: 0,0:16:11.51,0:16:16.18,Default,,0,0,0,,Самурайлар өте күшті және сізге ештеңе көмектесе алмайды.
Dialogue: 0,0:16:16.26,0:16:18.93,Default,,0,0,0,,Иә, жігіт үздік болып шықты!
Dialogue: 0,0:16:19.01,0:16:20.35,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:16:20.43,0:16:23.19,Default,,0,0,0,,Барлық ұрланған балалар қауіпсіз болды.
Dialogue: 0,0:16:23.27,0:16:25.56,Default,,0,0,0,,Олар шашырап кетті
Dialogue: 0,0:16:26.48,0:16:28.82,Default,,0,0,0,,Менің ойымша, ол енді ешқандай жамандық жасамайды.
Dialogue: 0,0:16:28.90,0:16:30.69,Default,,0,0,0,,Рахмет, Соуджи!
Dialogue: 0,0:16:30.78,0:16:32.74,Default,,0,0,0,,Ахахха бұл жақсы болды.
Dialogue: 0,0:16:32.82,0:16:34.66,Default,,0,0,0,,-Иә! -Бұл шай.
Dialogue: 0,0:16:34.74,0:16:35.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:36.37,0:16:37.20,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:16:40.20,0:16:42.91,Default,,0,0,0,,Көңіл-күйіңіз нашар сияқты.
Dialogue: 0,0:16:45.87,0:16:46.71,Default,,0,0,0,,Келгеніңе қуаныштымын.
Dialogue: 0,0:16:47.33,0:16:50.21,Default,,0,0,0,,Мибуға келіп, Роши-гумиге қосылғың келе ме?
Dialogue: 0,0:16:50.30,0:16:51.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:53.09,0:16:56.09,Default,,0,0,0,,Сен әлі баласың, бірақ жұмыс істеуге қабілеттісің.
Dialogue: 0,0:16:56.68,0:16:59.89,Default,,0,0,0,,Мен сендерге бір-біріңді кесіңдер деп тұрған жоқпын.
Dialogue: 0,0:16:59.97,0:17:04.56,Default,,0,0,0,,Тамақтандыру, тазалау, кір жуу сияқты жұмыс көп.
Dialogue: 0,0:17:09.19,0:17:10.36,Default,,0,0,0,,О...
Dialogue: 0,0:17:10.94,0:17:12.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:14.99,0:17:16.99,Default,,0,0,0,,Гочисуу мырза тағы келеді.
Dialogue: 0,0:17:18.53,0:17:19.74,Default,,0,0,0,,Біреуін ала аламын ба?
Dialogue: 0,0:17:21.70,0:17:22.75,Default,,0,0,0,,- (Хиджиката) Не? - (Окита) А?
Dialogue: 0,0:17:24.66,0:17:27.12,Default,,0,0,0,,Мен және Ироха алаяқ едік, солай емес пе?
Dialogue: 0,0:17:27.21,0:17:28.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.54,0:17:30.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:31.04,0:17:35.05,Default,,0,0,0,,Олардың кім екені белгісіз, уақыт маңызды болды.
Dialogue: 0,0:17:36.05,0:17:38.64,Default,,0,0,0,,Баланы тез жеуге әкелді.
Dialogue: 0,0:17:39.89,0:17:41.01,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:41.10,0:17:44.64,Default,,0,0,0,,Сол себепті түнде біраз уақыт көшеде жүре алмай қалуым мүмкін.
Dialogue: 0,0:17:46.73,0:17:49.81,Default,,0,0,0,,Кешіріңіз, бұл менің ұсынысым еді.
Dialogue: 0,0:17:49.90,0:17:51.98,Default,,0,0,0,,Мен басымды бұлай орап кете алмадым.
Dialogue: 0,0:17:52.07,0:17:55.19,Default,,0,0,0,,Бұл жақсы нәрсе емес пе? Менің жүруім керек емес.
Dialogue: 0,0:17:55.28,0:17:56.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.28,0:17:58.41,Default,,0,0,0,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:17:58.95,0:18:01.16,Default,,0,0,0,,Ах, міне...
Dialogue: 0,0:18:01.70,0:18:04.70,Default,,0,0,0,,Сонымен, у-о... болды.
Dialogue: 0,0:18:04.79,0:18:07.29,Default,,0,0,0,,Жақын арада жүре аласыз.
Dialogue: 0,0:18:07.79,0:18:10.88,Default,,0,0,0,,Өйткені біз осындай дүниені жасаймыз.
Dialogue: 0,0:18:11.42,0:18:13.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.30,0:18:20.89,Default,,0,0,0,,Итке ұқсайды
Dialogue: 0,0:18:23.47,0:18:25.97,Default,,0,0,0,,Адамдар маған бірдеңе береді, себебі ол пайдалы болатын сияқты.
Dialogue: 0,0:18:26.06,0:18:28.39,Default,,0,0,0,,Бақытты болғаны үшін үйден қуылу
Dialogue: 0,0:18:30.48,0:18:34.11,Default,,0,0,0,,Ертең ауырып қалсам, өліп қалуым мүмкін.
Dialogue: 0,0:18:34.61,0:18:37.15,Default,,0,0,0,,Ата-анамды да көре алмаймын
Dialogue: 0,0:18:37.24,0:18:38.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.74,0:18:42.66,Default,,0,0,0,,Күндіз жабайы болып, түнде көшені нысанаға алатындар бар.
Dialogue: 0,0:18:42.74,0:18:44.91,Default,,0,0,0,,Жерді ұрлау Ақшаны ұрлау
Dialogue: 0,0:18:45.49,0:18:49.33,Default,,0,0,0,,Өмірді ал, күрес, жаса, өлтір
Dialogue: 0,0:18:51.13,0:18:52.33,Default,,0,0,0,,Біз
Dialogue: 0,0:18:53.25,0:18:55.42,Default,,0,0,0,,Мен көптен бері ұстадым
Dialogue: 0,0:18:55.50,0:18:57.01,Default,,0,0,0,,Күлдім де, шыдадым.
Dialogue: 0,0:18:57.09,0:18:58.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:58.47,0:19:00.38,Default,,0,0,0,,Әрқашан солай емес пе?
Dialogue: 0,0:19:00.47,0:19:03.39,Default,,0,0,0,,Жәбірленуші әрқашан анықталады.
Dialogue: 0,0:19:04.35,0:19:06.77,Default,,0,0,0,,Бұл әрқашан ренжітеді
Dialogue: 0,0:19:07.98,0:19:10.89,Default,,0,0,0,,Ол ең әлсіз бала!
Dialogue: 0,0:19:12.44,0:19:15.40,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:15.48,0:19:17.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:23.82,0:19:24.91,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:26.24,0:19:28.16,Default,,0,0,0,,Мен жек көретін нәрсе
Dialogue: 0,0:19:29.16,0:19:31.17,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:19:35.84,0:19:36.92,Default,,0,0,0,,Мен де
Dialogue: 0,0:19:38.76,0:19:40.80,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:19:44.14,0:19:46.10,Default,,0,0,0,,Мұндай дүние
Dialogue: 0,0:19:48.64,0:19:50.56,Default,,0,0,0,,Мен өзгергім келеді
Dialogue: 0,0:19:50.64,0:19:56.57,Default,,0,0,0,,(Нио жылап жатыр)
Dialogue: 0,0:20:10.04,0:20:11.33,Default,,0,0,0,,Қабылданды
Dialogue: 0,0:20:26.18,0:20:27.68,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:20:28.93,0:20:31.85,Default,,0,0,0,,Мен мұны кәдесый ретінде әкелемін деп ойладым.
Dialogue: 0,0:20:31.93,0:20:33.23,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:20:34.27,0:20:36.52,Default,,0,0,0,,Басыңызды дұрыстап иіңіз!
Dialogue: 0,0:20:36.61,0:20:39.78,Default,,0,0,0,,«Көмегің үшін рахмет!»
Dialogue: 0,0:20:39.86,0:20:41.24,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:20:41.32,0:20:42.82,Default,,0,0,0,,Не айтсаң да
Dialogue: 0,0:20:42.90,0:20:46.24,Default,,0,0,0,,Мен сенің ата-анаңмын.
Dialogue: 0,0:20:46.32,0:20:47.70,Default,,0,0,0,,Әже
Dialogue: 0,0:20:50.62,0:20:52.20,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:20:53.12,0:20:54.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:58.46,0:20:59.75,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:00.63,0:21:05.13,Default,,0,0,0,,Сіз Киотода бізге қосылған үшінші қасқырсыз.
Dialogue: 0,0:21:06.34,0:21:11.22,Default,,0,0,0,,(Сарбаздардың айқайы)
Dialogue: 0,0:21:11.31,0:21:12.27,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:21:14.27,0:21:16.14,Default,,0,0,0,,Mibro мүшесі болды
Dialogue: 0,0:21:18.86,0:21:22.15,Default,,0,0,0,,Онда кездескен барлық адамдар
Dialogue: 0,0:21:29.20,0:21:32.12,Default,,0,0,0,,Сіз басынан өткерген әрбір сәт
Dialogue: 0,0:21:35.62,0:21:38.79,Default,,0,0,0,,Бұл дүние және менің өмірім
Dialogue: 0,0:21:40.46,0:21:42.84,Default,,0,0,0,,Ол көп өзгереді.
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.22,0:23:19.23,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.48,0:23:24.77,Default,,0,0,0,,Шие гүлдегенде
Dialogue: 0,0:23:24.86,0:23:27.78,Default,,0,0,0,,Бала Миброның мүшесі болды.
Dialogue: 0,0:23:27.86,0:23:30.49,Default,,0,0,0,,Менің серіктеріммен бірге көргенім
Dialogue: 0,0:23:31.03,0:23:34.28,Default,,0,0,0,,Қан иісі аңқып тұрған аяусыз дүние
Dialogue: 0,0:23:34.87,0:23:38.33,Default,,0,0,0,,Жас қасқыр қашудың алдында тұрса да,
Dialogue: 0,0:23:38.41,0:23:40.37,Default,,0,0,0,,Менің шын ниетім
Dialogue: 0,0:23:40.46,0:23:43.25,Default,,0,0,0,,Өзіңіз үшін әділдік іздей беріңіз
Dialogue: 0,0:23:44.79,0:23:47.67,Default,,0,0,0,,Келесі жолы «Жылауға болатын әлем»
Dialogue: 0,0:23:48.17,0:23:49.55,Default,,0,0,0,,Бізбен бірге болыңыз
Dialogue: 0,0:23:51.05,0:23:57.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
