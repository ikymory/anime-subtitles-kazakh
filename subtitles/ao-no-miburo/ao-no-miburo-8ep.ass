Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:03.62,Default,,0,0,0,,Таа!
Dialogue: 0,0:00:06.33,0:00:09.63,Default,,0,0,0,,Не болды? Әділдік одақтасы!
Dialogue: 0,0:00:11.42,0:00:15.34,Default,,0,0,0,,Ха-ку-ха! Уф!
Dialogue: 0,0:00:16.85,0:00:18.72,Default,,0,0,0,,- (Серизава) Уф - (Роппей) Арх!
Dialogue: 0,0:00:25.52,0:00:26.69,Default,,0,0,0,,В... Құбыжық!
Dialogue: 0,0:00:26.77,0:00:31.61,Default,,0,0,0,,Сіз оны беруіңіз керек емес пе еді? Тенчу
Dialogue: 0,0:00:32.69,0:00:35.45,Default,,0,0,0,,Онда мен сізге үлгі көрсетемін.
Dialogue: 0,0:00:35.53,0:00:37.45,Default,,0,0,0,,О, күте тұрыңыз! Тоқта...
Dialogue: 0,0:00:37.53,0:00:39.70,Default,,0,0,0,,Жоқ, жоқ, басып ал! (Рокухэйдің айқайы)
Dialogue: 0,0:00:39.78,0:00:40.95,Default,,0,0,0,,Уау
Dialogue: 0,0:00:41.04,0:00:46.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.91,0:02:10.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:14.21,0:02:17.13,Default,,0,0,0,,Оны жалғыз Ронин тобына қалдыра алмаймыз.
Dialogue: 0,0:02:17.22,0:02:21.26,Default,,0,0,0,,Мен Айзудан қорлық көріп жатқан қалған үшеуін ұстаймын.
Dialogue: 0,0:02:27.39,0:02:29.81,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:02:30.48,0:02:32.31,Default,,0,0,0,,Уф
Dialogue: 0,0:02:33.98,0:02:34.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:35.44,0:02:37.57,Default,,0,0,0,,Хо... Тұтқынға алынды!
Dialogue: 0,0:02:37.65,0:02:41.82,Default,,0,0,0,,Сағындым... Мен маспын.
Dialogue: 0,0:02:47.91,0:02:50.54,Default,,0,0,0,,Позицияңызды солға өзгерткен бойда
Dialogue: 0,0:02:50.62,0:02:52.58,Default,,0,0,0,,Барлық мүмкіндіктер жойылды
Dialogue: 0,0:02:55.67,0:03:00.09,Default,,0,0,0,,Бірақ мен жұмыстан бас тарта алмаймын.
Dialogue: 0,0:03:06.81,0:03:08.22,Default,,0,0,0,,Бір бөтелке жеткілікті ме?
Dialogue: 0,0:03:08.93,0:03:13.65,Default,,0,0,0,,Кез келген жағдайда бір матч арқылы шешіледі. Екі болғанның мәні жоқ.
Dialogue: 0,0:03:16.48,0:03:17.73,Default,,0,0,0,,Дәл уақытында!
Dialogue: 0,0:03:19.86,0:03:20.70,Default,,0,0,0,,Ах
Dialogue: 0,0:03:26.45,0:03:27.41,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:03:27.49,0:03:29.83,Default,,0,0,0,,Сәтсіздікке ұшырағандар өледі.
Dialogue: 0,0:03:30.33,0:03:32.21,Default,,0,0,0,,Бұл ниндзялардың заңы.
Dialogue: 0,0:03:32.29,0:03:33.42,Default,,0,0,0,,Ах
Dialogue: 0,0:03:33.92,0:03:35.17,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:03:38.00,0:03:40.38,Default,,0,0,0,,Шиноби заңы қандай?
Dialogue: 0,0:03:40.92,0:03:42.55,Default,,0,0,0,,Менімен бетпе-бет келме, сен.
Dialogue: 0,0:03:43.51,0:03:45.97,Default,,0,0,0,,(Сусукенің ауыр тыныс алуы)
Dialogue: 0,0:03:46.64,0:03:48.85,Default,,0,0,0,,Кездесу орнына ешкім келмейді.
Dialogue: 0,0:03:48.93,0:03:51.98,Default,,0,0,0,,Жол көрсетуші көгершіндер келмеді, қонақ үйді басып алды.
Dialogue: 0,0:03:52.60,0:03:55.52,Default,,0,0,0,,Кёсиро мен Гонцоның қарт адамы
Dialogue: 0,0:03:55.61,0:03:57.98,Default,,0,0,0,,Сіз Рокухэй мырзаны да қамауға алды дейсіз бе?
Dialogue: 0,0:03:58.65,0:04:00.61,Default,,0,0,0,,Джутаро өлтірілді
Dialogue: 0,0:04:00.69,0:04:03.86,Default,,0,0,0,,Біз бұл астанадан тезірек қашуымыз керек.
Dialogue: 0,0:04:06.66,0:04:07.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.50,0:04:11.33,Default,,0,0,0,,Ах
Dialogue: 0,0:04:11.87,0:04:15.46,Default,,0,0,0,,Шай ішу рәсіміндегі қария оң көзі жойылған бір адам бар екенін айтты.
Dialogue: 0,0:04:15.54,0:04:17.84,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:04:17.92,0:04:20.34,Default,,0,0,0,,Бірақ бір адам болса...
Dialogue: 0,0:04:26.18,0:04:28.76,Default,,0,0,0,,Сіз бұл құбыжықпен күресе аласыз ба?
Dialogue: 0,0:04:28.85,0:04:30.60,Default,,0,0,0,,-(Харада) Ой -(Сусуке) Уф
Dialogue: 0,0:04:31.22,0:04:33.60,Default,,0,0,0,,Мен бұл жерден өте алмаймын.
Dialogue: 0,0:04:33.69,0:04:34.52,Default,,0,0,0,,Уф
Dialogue: 0,0:04:35.44,0:04:36.27,Default,,0,0,0,,Уф
Dialogue: 0,0:04:38.19,0:04:41.53,Default,,0,0,0,,Уау, бұл көңілді қалдырады.
Dialogue: 0,0:04:41.61,0:04:45.70,Default,,0,0,0,,Соңына дейін қарсы тұруға ерік-жігеріңізді көрсетсеңіз екен.
Dialogue: 0,0:04:45.78,0:04:49.49,Default,,0,0,0,,Олай деме, Соуджи, адамдардың көбі осындай.
Dialogue: 0,0:04:49.58,0:04:51.20,Default,,0,0,0,,үшін осы.
Dialogue: 0,0:04:52.45,0:04:55.54,Default,,0,0,0,,Мен сені барлық қателіктерің үшін төлеймін.
Dialogue: 0,0:04:55.62,0:04:56.87,Default,,0,0,0,,Иә
Dialogue: 0,0:04:59.13,0:05:00.88,Default,,0,0,0,,Ух...эй
Dialogue: 0,0:05:00.96,0:05:04.97,Default,,0,0,0,,Қайсысы? Мен оны бірден кесіп көруім керек пе?
Dialogue: 0,0:05:05.05,0:05:05.88,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:05:05.97,0:05:09.05,Default,,0,0,0,,Жоқ... бұл балалар қандай?
Dialogue: 0,0:05:09.14,0:05:10.39,Default,,0,0,0,,Бұл Мибро ма?
Dialogue: 0,0:05:11.14,0:05:12.81,Default,,0,0,0,,Қашатын жер жоқ
Dialogue: 0,0:05:12.89,0:05:15.98,Default,,0,0,0,,Бір сұмдық жасайсың, бейшара.
Dialogue: 0,0:05:16.73,0:05:18.40,Default,,0,0,0,,Балалар да бар!
Dialogue: 0,0:05:18.48,0:05:21.73,Default,,0,0,0,,Бұл тапсыру. Бұл сіздің шығыныңыз.
Dialogue: 0,0:05:23.48,0:05:26.90,Default,,0,0,0,,Ол лас. Мен көп адамдар тобы тоқтады деп ойладым!
Dialogue: 0,0:05:26.99,0:05:30.95,Default,,0,0,0,,Бірден болса, мен мұнда ешкімге ұтыла алмаймын.
Dialogue: 0,0:05:31.03,0:05:33.12,Default,,0,0,0,,Маған қараған бейбақ.
Dialogue: 0,0:05:33.20,0:05:34.45,Default,,0,0,0,,Не?
Dialogue: 0,0:05:34.54,0:05:35.75,Default,,0,0,0,,Әзірге
Dialogue: 0,0:05:35.83,0:05:39.96,Default,,0,0,0,,Сіз жасаған нәрсе үшін өз өміріңізді қатерге тігуге дайын емессіз.
Dialogue: 0,0:05:40.04,0:05:40.88,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:41.38,0:05:45.47,Default,,0,0,0,,Олай болса, бәріңізде бар дейсіз бе?
Dialogue: 0,0:05:45.55,0:05:48.26,Default,,0,0,0,,Әрине.
Dialogue: 0,0:05:50.60,0:05:53.47,Default,,0,0,0,,Сіз тіпті бұл ваппаны жеңе алмайсыз.
Dialogue: 0,0:05:55.06,0:05:56.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.10,0:05:58.44,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:05:58.52,0:06:00.48,Default,,0,0,0,,Менің баламен қатты ұрысуым мүмкін емес...
Dialogue: 0,0:06:01.11,0:06:02.19,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:06:03.86,0:06:05.32,Default,,0,0,0,,Егер маған бәрібір
Dialogue: 0,0:06:05.82,0:06:09.82,Default,,0,0,0,,Ағаш қылыш? Ха ха ха! Бұл тамаша!
Dialogue: 0,0:06:09.91,0:06:11.53,Default,,0,0,0,,Бұл Чанбара ойыны.
Dialogue: 0,0:06:11.62,0:06:13.24,Default,,0,0,0,,-Менің бір ұсынысым бар-(Сусуке) Иә?
Dialogue: 0,0:06:13.79,0:06:16.50,Default,,0,0,0,,Мен жеңсем, момын ұстайсың.
Dialogue: 0,0:06:17.04,0:06:20.17,Default,,0,0,0,,Жеңіске жетсең, Мен осылай қашуды сағынамын.
Dialogue: 0,0:06:20.25,0:06:21.33,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,0:06:22.21,0:06:23.63,Default,,0,0,0,,Шехер астрономиялық кітапханасының басқарма бастығы, «Юстиция» обсерваториясында
Dialogue: 0,0:06:23.71,0:06:26.88,Default,,0,0,0,,Бұл ставканы басқа ешкім қабылдамайды.
Dialogue: 0,0:06:26.96,0:06:29.38,Default,,0,0,0,,- (Окита) Жеңіске жету үшін бір дауыс - (Сусуке) Жоқ...
Dialogue: 0,0:06:29.47,0:06:31.14,Default,,0,0,0,,Бүркіт те 1 дауысқа ие
Dialogue: 0,0:06:31.22,0:06:32.89,Default,,0,0,0,,- (Харада) Мен де - (Яманами) Мен де
Dialogue: 0,0:06:34.76,0:06:36.85,Default,,0,0,0,,Мен екі адамды өлтірдім.
Dialogue: 0,0:06:36.93,0:06:39.89,Default,,0,0,0,,Менің шыншыл екенімді біліп келсең.
Dialogue: 0,0:06:39.98,0:06:42.86,Default,,0,0,0,,Өліп қалсаң, шағым айта алмайсың.
Dialogue: 0,0:06:45.19,0:06:46.40,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:06:46.48,0:06:47.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:48.49,0:06:50.41,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:50.49,0:06:51.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:53.62,0:06:54.83,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:54.91,0:06:58.20,Default,,0,0,0,,Хахахахаха! Мені таң қалдыру үшін не істедің?
Dialogue: 0,0:06:58.29,0:06:59.54,Default,,0,0,0,,Тек дауыс па?
Dialogue: 0,0:06:59.62,0:07:02.04,Default,,0,0,0,,Жоқ, бұл жаман емес.
Dialogue: 0,0:07:02.13,0:07:03.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:04.79,0:07:06.05,Default,,0,0,0,,Ах
Dialogue: 0,0:07:12.14,0:07:15.05,Default,,0,0,0,,Мынау не бала...
Dialogue: 0,0:07:16.60,0:07:18.43,Default,,0,0,0,,Дегенмен сен оның сыртқы түріне де, әрекетіне де мүлде ұқсамайсың—
Dialogue: 0,0:07:19.02,0:07:22.02,Default,,0,0,0,,Басың жарылып кетсе, шағым айта алмайсың, солай ма?
Dialogue: 0,0:07:22.52,0:07:24.44,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:07:24.52,0:07:25.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:29.86,0:07:31.65,Default,,0,0,0,,Иә, мен оны ұстадым.
Dialogue: 0,0:07:31.74,0:07:33.57,Default,,0,0,0,,Түсіру!
Dialogue: 0,0:07:37.45,0:07:39.08,Default,,0,0,0,,Тіпті бала
Dialogue: 0,0:07:39.16,0:07:42.00,Default,,0,0,0,,Мибро соншалықты белді ме...
Dialogue: 0,0:07:42.08,0:07:43.58,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:07:43.67,0:07:47.59,Default,,0,0,0,,Біз, Мибро, осы Киото қаласында тұрамыз.
Dialogue: 0,0:07:47.67,0:07:49.80,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:07:49.88,0:07:50.84,Default,,0,0,0,,Құрылғы
Dialogue: 0,0:07:50.92,0:07:52.09,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:52.59,0:07:54.01,Default,,0,0,0,,О... мен жасадым.
Dialogue: 0,0:07:54.09,0:07:55.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:56.72,0:07:58.60,Default,,0,0,0,,О, сен қандайсың?
Dialogue: 0,0:07:58.68,0:08:01.85,Default,,0,0,0,,Сіз тым жалқаусыз ба? Сіз сондай өрескел едіңіз.
Dialogue: 0,0:08:01.93,0:08:04.85,Default,,0,0,0,,Меніңше, олар әлсіздік танытса, жеңілеміз деп ойлады.
Dialogue: 0,0:08:04.94,0:08:06.11,Default,,0,0,0,,Мына жігітке ұқсайды
Dialogue: 0,0:08:06.19,0:08:10.94,Default,,0,0,0,,Жоқ, бірақ олай етпесем, қабілетіммен жеңе алмаймын.
Dialogue: 0,0:08:11.03,0:08:13.24,Default,,0,0,0,,(Көше саудагері) Ей, сендер бұған дейін бұл сусынды естімедіңдер ме?
Dialogue: 0,0:08:13.32,0:08:15.95,Default,,0,0,0,,Айтпақшы, қылыш ұстағаныңызға қанша уақыт болды?
Dialogue: 0,0:08:16.74,0:08:19.20,Default,,0,0,0,,Иә, оның жабысқақ болғаны сонша, мен оны шеше алмадым...
Dialogue: 0,0:08:20.37,0:08:21.41,Default,,0,0,0,,Кондо мырза
Dialogue: 0,0:08:21.50,0:08:23.33,Default,,0,0,0,,Қобалжығаныңыз сонша, қатайғансыз.
Dialogue: 0,0:08:26.71,0:08:30.09,Default,,0,0,0,,Маған неге сендің?
Dialogue: 0,0:08:30.76,0:08:34.38,Default,,0,0,0,,Сіз күн сайын байыпты әрекет еттіңіз.
Dialogue: 0,0:08:34.88,0:08:39.22,Default,,0,0,0,,Мен рух, рух сияқты қарапайым көзбен көруге болмайтын нәрселерді бағалаймын.
Dialogue: 0,0:08:39.31,0:08:40.35,Default,,0,0,0,,Бүгінгі күн басқаша болды
Dialogue: 0,0:08:41.39,0:08:43.35,Default,,0,0,0,,Мен бұл қозғалысқа сендім
Dialogue: 0,0:08:44.19,0:08:46.10,Default,,0,0,0,,Бұл сіздің көп еңбек еткеніңіздің дәлелі.
Dialogue: 0,0:08:50.69,0:08:51.86,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:51.94,0:08:54.11,Default,,0,0,0,,- (Кондо) Өзіңізді жігерлендіре беріңіз - Иә!
Dialogue: 0,0:08:54.20,0:08:55.20,Default,,0,0,0,,үшінна солай!
Dialogue: 0,0:08:55.28,0:08:58.12,Default,,0,0,0,,- (Таро) Таро, кептірілген кальмар сатып ал - (Таро) Иә, мен келдім.
Dialogue: 0,0:08:59.37,0:09:02.75,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:09:02.83,0:09:04.12,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:04.21,0:09:06.12,Default,,0,0,0,,- (Айдзу самурай) Міне келдік! - (Айзу клан самурай) Не? Тағы да!
Dialogue: 0,0:09:06.21,0:09:07.38,Default,,0,0,0,,О
Dialogue: 0,0:09:07.46,0:09:10.38,Default,,0,0,0,,Соңғысын түсіріңіз, енді бәріміз осындамыз
Dialogue: 0,0:09:11.13,0:09:12.63,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:09:12.71,0:09:16.88,Default,,0,0,0,,Бізге Айзу кланына адамды ұстау үшін үш ай қажет болды.
Dialogue: 0,0:09:16.97,0:09:19.22,Default,,0,0,0,,Бар болғаны екі күнде...
Dialogue: 0,0:09:25.35,0:09:26.98,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:09:28.35,0:09:29.40,Default,,0,0,0,,Уф
Dialogue: 0,0:09:30.02,0:09:33.99,Default,,0,0,0,,Ұйқым келіп тұр... Таудың басына неге бұлай шықтың?
Dialogue: 0,0:09:34.07,0:09:36.36,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Таро-кун, тағы да
Dialogue: 0,0:09:36.45,0:09:38.16,Default,,0,0,0,,Цк, әлсіздер
Dialogue: 0,0:09:38.24,0:09:40.16,Default,,0,0,0,,Кейбір балалар
Dialogue: 0,0:09:44.08,0:09:44.91,Default,,0,0,0,,Фудзита
Dialogue: 0,0:09:45.00,0:09:47.92,Default,,0,0,0,,Өзіңнен озып кеткенің өкінішті.
Dialogue: 0,0:09:51.59,0:09:53.17,Default,,0,0,0,,Бұл Мибро...
Dialogue: 0,0:10:00.22,0:10:02.64,Default,,0,0,0,,Бұл жолы жасаған жұмысым керемет болды!
Dialogue: 0,0:10:02.72,0:10:04.60,Default,,0,0,0,,Мен өте ризамын.
Dialogue: 0,0:10:04.68,0:10:05.64,Default,,0,0,0,,Хаха!
Dialogue: 0,0:10:06.56,0:10:08.56,Default,,0,0,0,,Бұл Айзудың мырзасы
Dialogue: 0,0:10:08.64,0:10:10.77,Default,,0,0,0,,Бұл сәл басқаша ма?
Dialogue: 0,0:10:10.86,0:10:11.73,Default,,0,0,0,,- Аздап - (Таро) Тынш!
Dialogue: 0,0:10:11.81,0:10:14.11,Default,,0,0,0,,-(Хиросава)-доно -(Кабо) Иә.
Dialogue: 0,0:10:17.32,0:10:21.74,Default,,0,0,0,,Халық үшін аянбай еңбек ете берулеріңізге тілектеспін.
Dialogue: 0,0:10:22.41,0:10:26.37,Default,,0,0,0,,Мибу Роши-гуми ресми түрде Aizu доменіне сеніп тапсырылды.
Dialogue: 0,0:10:26.45,0:10:28.50,Default,,0,0,0,,Болашақта қолдау көрсетуге уәде беріңіз
Dialogue: 0,0:10:31.08,0:10:32.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:32.67,0:10:35.09,Default,,0,0,0,,Ризашылық бақыт
Dialogue: 0,0:10:35.17,0:10:37.80,Default,,0,0,0,,Бұл... бұл лордтың алдында.
Dialogue: 0,0:10:37.88,0:10:41.22,Default,,0,0,0,,Хахахахаха! Жақсы жақсы!
Dialogue: 0,0:10:41.93,0:10:44.97,Default,,0,0,0,,Бірақ сендер өте күштісіңдер.
Dialogue: 0,0:10:45.06,0:10:49.23,Default,,0,0,0,,Қылыш шеберлігіңмен қаншалықты мықты екеніңді көрсетейін.
Dialogue: 0,0:10:49.89,0:10:51.56,Default,,0,0,0,,Хирама Хираяма!
Dialogue: 0,0:10:51.65,0:10:52.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:52.98,0:10:54.02,Default,,0,0,0,,О!
Dialogue: 0,0:10:54.57,0:10:55.48,Default,,0,0,0,,Цк
Dialogue: 0,0:10:55.57,0:10:57.99,Default,,0,0,0,,- (Кондо) Тоқаш! Тоқаш! -(Таро) Уау!
Dialogue: 0,0:10:58.07,0:10:59.49,Default,,0,0,0,,Сіз ең мотивациясыз ба?
Dialogue: 0,0:11:00.95,0:11:02.11,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:11:02.20,0:11:03.49,Default,,0,0,0,,Жасайық
Dialogue: 0,0:11:03.57,0:11:05.87,Default,,0,0,0,,Біз сізге өз күшімізді көрсетеміз!
Dialogue: 0,0:11:05.95,0:11:08.00,Default,,0,0,0,,Мен мырзаны таң қалдырамын!
Dialogue: 0,0:11:08.08,0:11:09.08,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:11:09.16,0:11:10.00,Default,,0,0,0,,Кондо мырза!
Dialogue: 0,0:11:11.04,0:11:15.59,Default,,0,0,0,,Фудзита: Неліктен сен таң қалып, даяшы болып жұмыс істемейсің?
Dialogue: 0,0:11:27.60,0:11:28.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:32.10,0:11:33.31,Default,,0,0,0,,Бұл Мибро.
Dialogue: 0,0:11:34.06,0:11:35.98,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:11:36.77,0:11:39.44,Default,,0,0,0,,Мен марқұмның зиратының орнын сұрадым.
Dialogue: 0,0:11:39.53,0:11:41.11,Default,,0,0,0,,Маған қолдарымды біріктіру тапсырылды.
Dialogue: 0,0:11:41.65,0:11:42.49,Default,,0,0,0,,Иә
Dialogue: 0,0:11:42.57,0:11:44.45,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:11:44.53,0:11:45.62,Default,,0,0,0,,Фудзита деп аталады
Dialogue: 0,0:11:45.70,0:11:48.58,Default,,0,0,0,,Аа, кешігіп қалдым кешіріңіз.
Dialogue: 0,0:11:48.66,0:11:51.25,Default,,0,0,0,,Қайтыс болғандардың есімдері кім?
Dialogue: 0,0:11:53.17,0:11:54.25,Default,,0,0,0,,Неліктен білгің келеді?
Dialogue: 0,0:11:54.33,0:11:57.63,Default,,0,0,0,,Жоқ, марқұм қандай адам болды?
Dialogue: 0,0:11:57.71,0:12:00.76,Default,,0,0,0,,Екеуміз қол ұстасқанда, мен бұл туралы аздап білгім келеді деп ойладым.
Dialogue: 0,0:12:02.34,0:12:04.93,Default,,0,0,0,,бөліміне өтіңіз… Бұл біртүрлі ме?
Dialogue: 0,0:12:05.51,0:12:06.39,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:08.47,0:12:09.89,Default,,0,0,0,,Өлгендердің бірі
Dialogue: 0,0:12:09.97,0:12:13.64,Default,,0,0,0,,Сол ауылда Күшібе деген кісі өскен.
Dialogue: 0,0:12:14.90,0:12:15.98,Default,,0,0,0,,Кушибе мырза...
Dialogue: 0,0:12:16.48,0:12:19.11,Default,,0,0,0,,Біз бірге көп жаттығу жасадық.
Dialogue: 0,0:12:19.19,0:12:21.61,Default,,0,0,0,,Ол қылыш шеберлігімен сүйкімді адам еді.
Dialogue: 0,0:12:22.53,0:12:25.36,Default,,0,0,0,,Біз Киотоға жұмыс істеу үшін бірге келдік.
Dialogue: 0,0:12:25.87,0:12:28.95,Default,,0,0,0,,Бірақ ол ештеңеге қол жеткізбей қайтыс болды.
Dialogue: 0,0:12:29.03,0:12:33.04,Default,,0,0,0,,Күшібе мырзаның сүйікті тағамдары болды ма?
Dialogue: 0,0:12:33.12,0:12:36.13,Default,,0,0,0,,Енді... ойлап қарасам, сирек кездеседі.
Dialogue: 0,0:12:36.21,0:12:40.05,Default,,0,0,0,,Әпкемнің үйлену тойында жеген леф дәмді болды...
Dialogue: 0,0:12:40.13,0:12:43.05,Default,,0,0,0,,Бұл теңіз басы ма? рақмет сізге!
Dialogue: 0,0:12:53.64,0:12:55.27,Default,,0,0,0,,Жақында қайтайық
Dialogue: 0,0:12:55.35,0:12:56.19,Default,,0,0,0,,Иә
Dialogue: 0,0:12:57.86,0:12:58.94,Default,,0,0,0,,Уау
Dialogue: 0,0:12:59.52,0:13:02.94,Default,,0,0,0,,Мен оны байқамадым. Бұл керемет көрініс.
Dialogue: 0,0:13:03.57,0:13:07.95,Default,,0,0,0,,Лордтың өтініші бойынша ол Киотоның панорамалық көрінісін көруге болатын жерге қабір тұрғызды.
Dialogue: 0,0:13:08.70,0:13:11.04,Default,,0,0,0,,Дүниеден сәл алшақтап кетсең де.
Dialogue: 0,0:13:11.12,0:13:13.45,Default,,0,0,0,,Менің мырзам осындай құрметпен қарайды.
Dialogue: 0,0:13:14.16,0:13:16.46,Default,,0,0,0,,Түсініспеушілік болмасын.
Dialogue: 0,0:13:20.13,0:13:23.80,Default,,0,0,0,,Кушибе мырза, сіз Буддалық дәрежесіне жеттіңіз бе және сіз қазір аспанның үстіндесіз бе?
Dialogue: 0,0:13:24.30,0:13:27.89,Default,,0,0,0,,Жоқ, ол жеңілгенді жек көретін, қызғанатын.
Dialogue: 0,0:13:27.97,0:13:30.22,Default,,0,0,0,,Таяқ жесе де, қарсы шықтым.
Dialogue: 0,0:13:30.30,0:13:33.47,Default,,0,0,0,,Кушибе әлі де осы Киото қаласында серуендеп жүр.
Dialogue: 0,0:13:33.97,0:13:35.73,Default,,0,0,0,,Кек болып кетсе де, ол әрқашан болады
Dialogue: 0,0:13:38.02,0:13:39.52,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:13:39.61,0:13:41.98,Default,,0,0,0,,Сен де осында жұмыс істесең.
Dialogue: 0,0:13:44.32,0:13:47.74,Default,,0,0,0,,Мен Кушибе мырза туралы тағы бір нәрсе білдім
Dialogue: 0,0:13:47.82,0:13:50.99,Default,,0,0,0,,Аа, мен маңызды нәрсені ұмытып қалдым.
Dialogue: 0,0:13:52.16,0:13:52.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:53.74,0:13:57.00,Default,,0,0,0,,Осы мәселеге түсіністікпен қарағаныңыз үшін көп рахмет.
Dialogue: 0,0:13:57.58,0:14:01.04,Default,,0,0,0,,Жоқ... жоқ, мен көп ештеңе істемеймін.
Dialogue: 0,0:14:01.13,0:14:02.50,Default,,0,0,0,,Төмендегілердің барлығы...
Dialogue: 0,0:14:02.59,0:14:03.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:03.96,0:14:07.42,Default,,0,0,0,,Жауды тек мықтылар алған жоқ.
Dialogue: 0,0:14:07.51,0:14:09.93,Default,,0,0,0,,Біз Айзудың жүрегіне жақынбыз.
Dialogue: 0,0:14:10.01,0:14:13.01,Default,,0,0,0,,Мен сіздей болғаныма өте қуаныштымын.
Dialogue: 0,0:14:13.72,0:14:16.52,Default,,0,0,0,,Мибро жай ғана заңсыздық деп түсінбедім.
Dialogue: 0,0:14:16.60,0:14:17.98,Default,,0,0,0,,Ха...
Dialogue: 0,0:14:23.73,0:14:25.82,Default,,0,0,0,,Эй... сәлем
Dialogue: 0,0:14:26.74,0:14:29.03,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:14:29.11,0:14:32.24,Default,,0,0,0,,Біздің істегеніміз қате болған жоқ
Dialogue: 0,0:14:32.32,0:14:34.03,Default,,0,0,0,,Мен енді растай аламын
Dialogue: 0,0:14:36.20,0:14:40.50,Default,,0,0,0,,Келесі жолы мен саған құйрығы бар бұл үлкен апельсин әкелемін.
Dialogue: 0,0:14:41.75,0:14:45.88,Default,,0,0,0,,Келесіге келмес бұрын қалған үшеуін тексеріп алайық.
Dialogue: 0,0:14:45.96,0:14:47.21,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:49.76,0:14:51.68,Default,,0,0,0,,(Әскерилердің сөйлеген дыбыстары)
Dialogue: 0,0:14:51.76,0:14:53.43,Default,,0,0,0,,Тым-ау!
Dialogue: 0,0:14:53.51,0:14:55.18,Default,,0,0,0,,Охххх
Dialogue: 0,0:14:55.26,0:14:56.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:00.77,0:15:03.44,Default,,0,0,0,,! Қылыш шеберлігіңізге де көз жүгіртіңізші.
Dialogue: 0,0:15:03.52,0:15:05.32,Default,,0,0,0,,Сіз тек қана тербелуге жаттыға аласыз.
Dialogue: 0,0:15:05.40,0:15:07.03,Default,,0,0,0,,Жетеді, орында!
Dialogue: 0,0:15:07.11,0:15:09.49,Default,,0,0,0,,Бұл тақсыр, бәрі мұны істемейінше бітпейді!
Dialogue: 0,0:15:10.03,0:15:12.32,Default,,0,0,0,,Ал... олай болса, тербелуге жаттығамыз.
Dialogue: 0,0:15:12.41,0:15:13.32,Default,,0,0,0,,Ой
Dialogue: 0,0:15:15.37,0:15:19.58,Default,,0,0,0,,-1 2 3… -(Фудзита) Хаха
Dialogue: 0,0:15:20.33,0:15:23.17,Default,,0,0,0,,４ ５…
Dialogue: 0,0:15:27.21,0:15:30.30,Default,,0,0,0,,Мибуро Айзу руының қамқорлығында.
Dialogue: 0,0:15:30.38,0:15:32.26,Default,,0,0,0,,Мен не өзгеретінін сұрадым...
Dialogue: 0,0:15:32.34,0:15:34.51,Default,,0,0,0,,Самурайға ұқсайды
Dialogue: 0,0:15:35.39,0:15:37.51,Default,,0,0,0,,Мен шынымен түсінбедім
Dialogue: 0,0:15:38.10,0:15:41.27,Default,,0,0,0,,Бізге қарыздар Яги отбасының қуанышында шек жоқ.
Dialogue: 0,0:15:41.35,0:15:44.02,Default,,0,0,0,,Үнемі тойлайтын адамдар бар.
Dialogue: 0,0:15:44.10,0:15:46.57,Default,,0,0,0,,Бұл жақсы нәрсе екеніне сенімдімін.
Dialogue: 0,0:15:48.86,0:15:50.03,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:15:50.90,0:15:53.03,Default,,0,0,0,,Турдағы қажырлы еңбегіңіз үшін рахмет, Тодо...
Dialogue: 0,0:15:53.11,0:15:55.53,Default,,0,0,0,,Ааа~
Dialogue: 0,0:15:55.62,0:15:58.08,Default,,0,0,0,,Шие гүлдері толығымен шашырап кетті...
Dialogue: 0,0:15:58.16,0:15:59.04,Default,,0,0,0,,Я...
Dialogue: 0,0:15:59.12,0:16:01.21,Default,,0,0,0,,Бұл үйеңкі.
Dialogue: 0,0:16:01.29,0:16:02.87,Default,,0,0,0,,Дәлірек айтсақ, не болды?
Dialogue: 0,0:16:02.96,0:16:05.29,Default,,0,0,0,,Мен қатты күйзеліске ұшырадым.
Dialogue: 0,0:16:06.34,0:16:08.34,Default,,0,0,0,,! Бірдеңе жасаңыз
Dialogue: 0,0:16:08.42,0:16:09.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.59,0:16:14.76,Default,,0,0,0,,Оңай көтеру
Dialogue: 0,0:16:14.84,0:16:16.39,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:16.47,0:16:18.43,Default,,0,0,0,,Иә, өте жақсы.
Dialogue: 0,0:16:19.06,0:16:22.81,Default,,0,0,0,,Жарқын және мұқият, Дүкенге қуат қосады
Dialogue: 0,0:16:22.89,0:16:24.81,Default,,0,0,0,,Айтқыңыз келгені бұл емес!
Dialogue: 0,0:16:24.90,0:16:25.73,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,0:16:25.81,0:16:28.61,Default,,0,0,0,,Одан гөрі біз серік болсақ ше?
Dialogue: 0,0:16:28.69,0:16:30.19,Default,,0,0,0,,Хайсуке мұны істей алмайды.
Dialogue: 0,0:16:30.28,0:16:31.44,Default,,0,0,0,,Менде жыныстық тартымдылық жоқ.
Dialogue: 0,0:16:31.53,0:16:34.28,Default,,0,0,0,,Мен жинайтын shunga туралы айтсам...
Dialogue: 0,0:16:35.61,0:16:37.03,Default,,0,0,0,,Шулы!
Dialogue: 0,0:16:37.12,0:16:38.95,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:39.03,0:16:40.45,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:16:40.54,0:16:42.91,Default,,0,0,0,,Сіздің не істеп жатқаныңыз анық!
Dialogue: 0,0:16:43.00,0:16:45.92,Default,,0,0,0,,Мына ақымақтар!
Dialogue: 0,0:16:46.00,0:16:49.21,Default,,0,0,0,,Менен бірдеңе істеуді өтіну дегенді қалай түсінесіңдер?
Dialogue: 0,0:16:49.29,0:16:50.30,Default,,0,0,0,,Иә
Dialogue: 0,0:16:50.80,0:16:51.92,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:16:52.01,0:16:54.43,Default,,0,0,0,,Түсіндім! Мен сені қолдаймын
Dialogue: 0,0:16:54.51,0:16:55.68,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:16:55.76,0:16:59.64,Default,,0,0,0,,Сіз барлық жастағы ерлер мен әйелдерді тартатын беделге иесіз, сондықтан мен сізге қол ұшын беруіңізді өтінемін.
Dialogue: 0,0:16:59.72,0:17:01.93,Default,,0,0,0,,Айтуыңызда бірдеңе дұрыс емес...
Dialogue: 0,0:17:02.02,0:17:04.44,Default,,0,0,0,,- (Соба дүкенінің қызы) Сізді күткенім үшін кешіріңіз - (Todo) Ха!
Dialogue: 0,0:17:05.02,0:17:07.44,Default,,0,0,0,,Собаны жақсы көресің.
Dialogue: 0,0:17:07.52,0:17:10.44,Default,,0,0,0,,Бұл Харудың бүгін бесінші сапары.
Dialogue: 0,0:17:10.52,0:17:11.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:11.53,0:17:14.11,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:17:14.19,0:17:16.07,Default,,0,0,0,,Ал... Маған соба ұнайды, көзім жоқ.
Dialogue: 0,0:17:18.45,0:17:19.41,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:21.58,0:17:25.46,Default,,0,0,0,,Уау, бұл өте дәмді. Ууууу...
Dialogue: 0,0:17:26.04,0:17:28.29,Default,,0,0,0,,Өтінемін, дөрекі болуды доғарыңыз, Тодо мырза.
Dialogue: 0,0:17:28.38,0:17:31.55,Default,,0,0,0,,Ха... не істеуім керек?
Dialogue: 0,0:17:31.63,0:17:34.30,Default,,0,0,0,,- (Әйел) Миброя - (Ер) Көз тигізбе
Dialogue: 0,0:17:34.38,0:17:37.72,Default,,0,0,0,,Біз Айзудың қамауындамыз, солай ма?
Dialogue: 0,0:17:37.80,0:17:40.30,Default,,0,0,0,,Қала тұрғындары бұл туралы білмейтін сияқты.
Dialogue: 0,0:17:40.39,0:17:42.43,Default,,0,0,0,,Ха! Иә, киім.
Dialogue: 0,0:17:42.51,0:17:44.43,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:17:44.52,0:17:47.94,Default,,0,0,0,,Мүмкін сәйкес келетін хаориге ие болу барлығына тыныштық сыйлайтын шығар.
Dialogue: 0,0:17:48.02,0:17:48.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:49.06,0:17:52.94,Default,,0,0,0,,Әдемі киімің болса, қылышың болса, ер адам шығып, тағы бір қарайтынына сенімдімін.
Dialogue: 0,0:17:53.03,0:17:54.49,Default,,0,0,0,,Осылайша?
Dialogue: 0,0:18:02.12,0:18:05.20,Default,,0,0,0,,Бұл адамнан сұрасаңыз да, ол сізге қарызға бере алмайды.
Dialogue: 0,0:18:05.29,0:18:08.54,Default,,0,0,0,,Қылыш – самурайдың жаны
Dialogue: 0,0:18:08.62,0:18:09.71,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:18:09.79,0:18:11.84,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:18:11.92,0:18:12.96,Default,,0,0,0,,Серизава мырза
Dialogue: 0,0:18:13.92,0:18:15.21,Default,,0,0,0,,Бұл махаббат
Dialogue: 0,0:18:18.22,0:18:19.47,Default,,0,0,0,,Мен оны саған қарызға беремін
Dialogue: 0,0:18:19.55,0:18:21.22,Default,,0,0,0,,Хаори де әкеліңіз!
Dialogue: 0,0:18:21.85,0:18:23.97,Default,,0,0,0,,- (Тодо) Иә! -Рахмет
Dialogue: 0,0:18:24.93,0:18:26.48,Default,,0,0,0,,Оокини~
Dialogue: 0,0:18:27.98,0:18:29.73,Default,,0,0,0,,Мен... Мен күлдім.
Dialogue: 0,0:18:29.81,0:18:31.48,Default,,0,0,0,,Дахахахаха!
Dialogue: 0,0:18:31.56,0:18:33.57,Default,,0,0,0,,Бұл тым үлкен болды.
Dialogue: 0,0:18:33.65,0:18:36.44,Default,,0,0,0,,Шүкір, бұл менің соңғы амалым.
Dialogue: 0,0:18:36.53,0:18:37.74,Default,,0,0,0,,Мұнда да кел!
Dialogue: 0,0:18:37.82,0:18:39.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:42.45,0:18:46.04,Default,,0,0,0,,Келесі бұрышқа бұрылғанда, Саносуке сізге қосылады.
Dialogue: 0,0:18:46.12,0:18:48.00,Default,,0,0,0,,Мен сізге көмектесемін.
Dialogue: 0,0:18:48.08,0:18:49.79,Default,,0,0,0,,Керемет стратегия
Dialogue: 0,0:18:49.87,0:18:51.29,Default,,0,0,0,,Бұл ең нашар стратегия.
Dialogue: 0,0:18:58.42,0:19:02.09,Default,,0,0,0,,Тодо-сан неге Миброға қосылды?
Dialogue: 0,0:19:02.18,0:19:03.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.10,0:19:06.93,Default,,0,0,0,,Мен сізді Кондо мырзаның Эдодағы дойдосында болғаныңызды естідім.
Dialogue: 0,0:19:10.31,0:19:12.31,Default,,0,0,0,,үшін менің артымнан ерген жоқ, солай ма?
Dialogue: 0,0:19:12.40,0:19:15.36,Default,,0,0,0,,Негізі мен адасып қалдым.
Dialogue: 0,0:19:15.44,0:19:17.82,Default,,0,0,0,,Бұл өте күшті.
Dialogue: 0,0:19:17.90,0:19:19.24,Default,,0,0,0,,Егер менің шарттарыма келіссең, мен жүрегіңді жазып, қайта тірілтамын.
Dialogue: 0,0:19:19.32,0:19:22.70,Default,,0,0,0,,Мен күштірек болсам, әйелдер арасында танымал боламын деп ойладым.
Dialogue: 0,0:19:22.78,0:19:24.99,Default,,0,0,0,,Бұл үлкен мәселе емес, солай ма?
Dialogue: 0,0:19:25.08,0:19:28.95,Default,,0,0,0,,Жоқ, менің ойымша, бұл тірі заттар үшін қалыпты жағдай.
Dialogue: 0,0:19:29.04,0:19:31.71,Default,,0,0,0,,Сіз өзгерген жоқсыз.
Dialogue: 0,0:19:31.79,0:19:35.71,Default,,0,0,0,,Мұны маған анам жасырып айтатын.
Dialogue: 0,0:19:35.79,0:19:39.63,Default,,0,0,0,,«Сіз феодалдың ұрпағысыз, Изуми но ками».
Dialogue: 0,0:19:39.72,0:19:42.22,Default,,0,0,0,,«Лайық бол және ұялма».
Dialogue: 0,0:19:42.30,0:19:46.10,Default,,0,0,0,,Бұл керемет емес пе! Сенің әкең ұлы адам.
Dialogue: 0,0:19:46.18,0:19:48.43,Default,,0,0,0,,Мен бұған сенбеймін
Dialogue: 0,0:19:48.52,0:19:51.48,Default,,0,0,0,,Неліктен сіз бұл үшін құрмет көрсетпейсіз?
Dialogue: 0,0:19:51.56,0:19:52.85,Default,,0,0,0,,Анам бақытты болады.
Dialogue: 0,0:19:55.98,0:19:57.27,Default,,0,0,0,,Синсуке-сан
Dialogue: 0,0:19:57.36,0:19:58.86,Default,,0,0,0,,Күте тұрыңыз ба?
Dialogue: 0,0:19:58.94,0:20:00.15,Default,,0,0,0,,- (Тодо) Иә! -Ах!
Dialogue: 0,0:20:01.70,0:20:02.86,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:20:02.95,0:20:04.62,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:20:07.70,0:20:09.33,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:20:09.41,0:20:11.37,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:20:12.08,0:20:15.38,Default,,0,0,0,,Әй, сен дүниені шарлап жүріп жақсы жүрсің ғой, солай ма?
Dialogue: 0,0:20:15.38,0:20:16.38,Default,,0,0,0,,Әй, сен дүниені шарлап жүріп жақсы жүрсің ғой, солай ма?
Dialogue: 0,0:20:15.38,0:20:16.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:17.04,0:20:18.88,Default,,0,0,0,,Мені де қосыңыз.
Dialogue: 0,0:20:18.96,0:20:20.63,Default,,0,0,0,,Немесе маған ақшаны беріңіз.
Dialogue: 0,0:20:20.71,0:20:23.01,Default,,0,0,0,,Жоқ... бұл Саносуке-сан емес!
Dialogue: 0,0:20:23.09,0:20:24.72,Default,,0,0,0,,Бұл жаман, Тодо-сан!
Dialogue: 0,0:20:24.80,0:20:25.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:26.80,0:20:28.01,Default,,0,0,0,,Бізбен болыңыз...
Dialogue: 0,0:20:28.10,0:20:28.97,Default,,0,0,0,,Не!
Dialogue: 0,0:20:29.06,0:20:32.31,Default,,0,0,0,,Иә, тоқтат, жек көремін.
Dialogue: 0,0:20:32.39,0:20:33.23,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:34.39,0:20:35.23,Default,,0,0,0,,-Мен... -(Алаяқ) Мен бас тартамын!
Dialogue: 0,0:20:36.44,0:20:38.77,Default,,0,0,0,,- (Алаяқ) Қарғыс атсын - (Алаяқ) Не деген сұмдық?
Dialogue: 0,0:20:38.86,0:20:41.28,Default,,0,0,0,,Бұл Мибро, есіңізде болсын.
Dialogue: 0,0:20:42.32,0:20:43.78,Default,,0,0,0,,- (Алаяқ) Қарғыс атсын... - (Алаяқ) Қарғыс атсын.
Dialogue: 0,0:20:44.91,0:20:46.99,Default,,0,0,0,,Аа... көп рахмет.
Dialogue: 0,0:20:49.62,0:20:51.54,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:52.16,0:20:53.08,Default,,0,0,0,,Тодо мырза
Dialogue: 0,0:20:53.16,0:20:55.54,Default,,0,0,0,,Ха~ Бұл жақсы нәрсе.
Dialogue: 0,0:20:55.62,0:20:57.25,Default,,0,0,0,,Тодо мырза, Тодо мырза
Dialogue: 0,0:20:57.33,0:20:59.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:59.13,0:21:01.05,Default,,0,0,0,,Өте керемет болды!
Dialogue: 0,0:21:03.38,0:21:06.39,Default,,0,0,0,,Ni~! Мен сені жақсы көремін!\NМен
Dialogue: 0,0:21:06.47,0:21:07.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:09.14,0:21:11.31,Default,,0,0,0,,туралы шешім қабылдадым
Dialogue: 0,0:21:15.14,0:21:17.69,Default,,0,0,0,,Мен жаңа мен боламын
Dialogue: 0,0:21:17.77,0:21:20.32,Default,,0,0,0,,Бүгіннен бастап мен Киото халқы үшін өмір сүремін!
Dialogue: 0,0:21:21.90,0:21:22.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:23.61,0:21:25.57,Default,,0,0,0,,Балаңызға қамқорлық жасағаннан кейін қандай өзгерістер болады?
Dialogue: 0,0:21:26.57,0:21:28.12,Default,,0,0,0,,Ойыңызды жаңартыңыз
Dialogue: 0,0:21:28.20,0:21:31.16,Default,,0,0,0,,Біз қаладағы барлық адамдар үшін қолдан келгеннің бәрін жасаймыз!
Dialogue: 0,0:21:31.24,0:21:32.58,Default,,0,0,0,,Бұл жақсы, солай емес пе?
Dialogue: 0,0:21:33.08,0:21:34.41,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:21:34.50,0:21:35.33,Default,,0,0,0,,Сояна
Dialogue: 0,0:21:35.41,0:21:36.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:36.54,0:21:39.25,Default,,0,0,0,,Сіздің тағы бір жақсы қызыңыз болады деп үміттенемін.
Dialogue: 0,0:21:39.33,0:21:41.38,Default,,0,0,0,,Цу... Келесі жолы барымызды салайық!
Dialogue: 0,0:21:41.46,0:21:42.96,Default,,0,0,0,,Тағы кездескенше~
Dialogue: 0,0:21:43.05,0:21:44.09,Default,,0,0,0,,Жақында кездесеміз.
Dialogue: 0,0:21:44.17,0:21:45.88,Default,,0,0,0,,(Окита мен Харада күлді)
Dialogue: 0,0:21:50.97,0:21:55.98,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.18,0:23:19.18,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.40,0:23:24.86,Default,,0,0,0,,Aizu доменін сақтау
Dialogue: 0,0:23:24.94,0:23:28.86,Default,,0,0,0,,Бұл Мибро тек Ронин тобы емес дегенді білдіреді.
Dialogue: 0,0:23:28.94,0:23:34.87,Default,,0,0,0,,Бұл Айзу доменінің және тіпті сегунаттың бұйрықтарымен жұмыс істеуді білдіреді.
Dialogue: 0,0:23:35.49,0:23:40.29,Default,,0,0,0,,Содан кейін дәуір біртіндеп жылжи бастайды.
Dialogue: 0,0:23:40.37,0:23:43.13,Default,,0,0,0,,Бірақ нағыз Мибролар
Dialogue: 0,0:23:43.21,0:23:46.50,Default,,0,0,0,,Менің күндерім жастық шағымда өтті.
Dialogue: 0,0:23:47.25,0:23:49.21,Default,,0,0,0,,Келесі жолы «Қазына»
Dialogue: 0,0:23:49.30,0:23:50.88,Default,,0,0,0,,Бізбен бірге болыңыз
Dialogue: 0,0:23:52.38,0:23:58.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
