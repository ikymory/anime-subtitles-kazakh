Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:06.08,Default,,0,0,0,,Данго қосылған, яғни өрік дәндері.
Dialogue: 0,0:00:06.17,0:00:08.04,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:00:08.13,0:00:09.80,Default,,0,0,0,,Әжем айтқандай
Dialogue: 0,0:00:09.88,0:00:11.92,Default,,0,0,0,,Егер кездесулер қазына болса
Dialogue: 0,0:00:12.01,0:00:13.13,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:13.22,0:00:14.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:15.14,0:00:16.93,Default,,0,0,0,,Сол кезде мен таныстым
Dialogue: 0,0:00:17.72,0:00:19.39,Default,,0,0,0,,Менің өмірімде
Dialogue: 0,0:00:20.56,0:00:23.48,Default,,0,0,0,,Бұл ең үлкен қазына болса керек.
Dialogue: 0,0:00:25.02,0:00:30.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:49.94,0:01:54.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:55.69,0:01:57.95,Default,,0,0,0,,О... а...
Dialogue: 0,0:02:01.37,0:02:02.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:02.91,0:02:05.70,Default,,0,0,0,,Су... Су сұраңыз!
Dialogue: 0,0:02:05.79,0:02:07.41,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:07.50,0:02:10.00,Default,,0,0,0,,Су, мен түсінемін.
Dialogue: 0,0:02:15.05,0:02:17.17,Default,,0,0,0,,Пуха! Қайта толтырыңыз!
Dialogue: 0,0:02:18.72,0:02:19.72,Default,,0,0,0,,Егер сіз екінші көмек алғыңыз келсе
Dialogue: 0,0:02:19.80,0:02:20.93,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:02:21.01,0:02:22.47,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:02:26.27,0:02:27.60,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:28.27,0:02:30.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:32.44,0:02:33.94,Default,,0,0,0,,Бұл тұшпара дүкені ме?
Dialogue: 0,0:02:34.02,0:02:36.32,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:02:36.40,0:02:38.65,Default,,0,0,0,,Мені танымай кірдің бе?
Dialogue: 0,0:02:38.74,0:02:41.91,Default,,0,0,0,,Мен кенеттен қатты аштық сезінемін.
Dialogue: 0,0:02:41.99,0:02:43.62,Default,,0,0,0,,Бұл сенің орның.
Dialogue: 0,0:02:46.20,0:02:48.04,Default,,0,0,0,,Жоқ, мен артқы орындық алғым келеді.
Dialogue: 0,0:02:48.12,0:02:50.25,Default,,0,0,0,,Сәлем! Өзімшіл болмаңыз
Dialogue: 0,0:02:50.33,0:02:52.33,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:02:52.42,0:02:54.54,Default,,0,0,0,,Ол жер әлі тазаланбаған...
Dialogue: 0,0:02:54.63,0:02:58.05,Default,,0,0,0,,Маған ұнамайды, ұнамайды! Маған ол жер ұнайды.
Dialogue: 0,0:02:58.13,0:03:00.22,Default,,0,0,0,,Сен сыпайы бейбақ.
Dialogue: 0,0:03:00.30,0:03:02.34,Default,,0,0,0,,Бонбон - шлюха.
Dialogue: 0,0:03:02.43,0:03:03.64,Default,,0,0,0,,Таро, сіз қонақсыз!
Dialogue: 0,0:03:03.72,0:03:06.18,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:03:06.26,0:03:08.06,Default,,0,0,0,,- (Кикучиё) Таро! -(Таро) А?
Dialogue: 0,0:03:08.14,0:03:09.68,Default,,0,0,0,,Маған шай әкел
Dialogue: 0,0:03:09.77,0:03:12.06,Default,,0,0,0,,Мені Таро деп атама!
Dialogue: 0,0:03:13.06,0:03:14.73,Default,,0,0,0,,Дангоның 4 түрі бар
Dialogue: 0,0:03:14.81,0:03:16.82,Default,,0,0,0,,Үш түсті данго да бар.
Dialogue: 0,0:03:16.90,0:03:19.65,Default,,0,0,0,,Әй, мен бәрін аламын, бәрі болды.
Dialogue: 0,0:03:19.74,0:03:20.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:20.65,0:03:23.20,Default,,0,0,0,,Менің тәттіге көзім жоқ.
Dialogue: 0,0:03:23.28,0:03:24.57,Default,,0,0,0,,Мен бәрін жеймін.
Dialogue: 0,0:03:24.66,0:03:26.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:26.66,0:03:31.08,Default,,0,0,0,,Ой! Менің тісім ауырады! Менде қуыстар бар екенін ұмытып кеттім.
Dialogue: 0,0:03:31.16,0:03:32.46,Default,,0,0,0,,Ах~ Шай беріңізші.
Dialogue: 0,0:03:32.54,0:03:33.96,Default,,0,0,0,,! Тәтті болма!
Dialogue: 0,0:03:34.79,0:03:37.75,Default,,0,0,0,,Тек сұрайын дегенім, сізде ақша бар ма?
Dialogue: 0,0:03:38.76,0:03:39.84,Default,,0,0,0,,Ақша?
Dialogue: 0,0:03:44.43,0:03:46.39,Default,,0,0,0,,Жоқ, оны қосулы қалдырыңыз.
Dialogue: 0,0:03:46.47,0:03:47.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:47.85,0:03:49.14,Default,,0,0,0,,Тамақ іш, жүгір!
Dialogue: 0,0:03:49.72,0:03:51.64,Default,,0,0,0,,Мен саған бір қадам болса да қашып кетпеймін!
Dialogue: 0,0:03:51.73,0:03:54.73,Default,,0,0,0,,Басталуы! Сіз оны түзетесіз!
Dialogue: 0,0:03:54.81,0:03:56.52,Default,,0,0,0,,Мен сізге нұсқау бермеймін.
Dialogue: 0,0:03:59.61,0:04:02.07,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:04:02.15,0:04:04.53,Default,,0,0,0,,Сол қолыңыз жарақат алды ма?
Dialogue: 0,0:04:05.95,0:04:07.95,Default,,0,0,0,,Бұл жай ғана көгерген жер
Dialogue: 0,0:04:08.03,0:04:09.16,Default,,0,0,0,,Шу шығармаңыз
Dialogue: 0,0:04:09.24,0:04:10.54,Default,,0,0,0,,Е...
Dialogue: 0,0:04:12.58,0:04:14.04,Default,,0,0,0,,Иә? о?
Dialogue: 0,0:04:14.67,0:04:17.21,Default,,0,0,0,,Йо... Чиринуяға қош келдіңіз.
Dialogue: 0,0:04:21.88,0:04:22.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:23.01,0:04:26.05,Default,,0,0,0,,дегендер қашып кетіңдер!
Dialogue: 0,0:04:26.14,0:04:28.43,Default,,0,0,0,,Олар болашақта бізден тағы да көп нәрсені тартып алады.
Dialogue: 0,0:04:33.06,0:04:36.35,Default,,0,0,0,,Ол қандай адам, бәрі ақ...
Dialogue: 0,0:04:37.52,0:04:39.19,Default,,0,0,0,,Қазір осы жерден кетіңіз.
Dialogue: 0,0:04:39.27,0:04:40.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.74,0:04:44.78,Default,,0,0,0,,Не!
Dialogue: 0,0:04:48.53,0:04:50.37,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:04:50.87,0:04:53.79,Default,,0,0,0,,Ақымақ! Біз оны осында қолданамыз ба?
Dialogue: 0,0:04:55.33,0:04:56.79,Default,,0,0,0,,Бұл өте маңызды
Dialogue: 0,0:04:57.92,0:04:59.09,Default,,0,0,0,,!
Dialogue: 0,0:05:01.71,0:05:03.13,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:05:03.21,0:05:05.88,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:05:05.97,0:05:07.22,Default,,0,0,0,,Уф
Dialogue: 0,0:05:10.56,0:05:11.76,Default,,0,0,0,,Уф
Dialogue: 0,0:05:11.85,0:05:15.48,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:05:15.56,0:05:16.64,Default,,0,0,0,,Гаки
Dialogue: 0,0:05:16.73,0:05:19.15,Default,,0,0,0,,Қашайық Қашайық
Dialogue: 0,0:05:19.23,0:05:21.65,Default,,0,0,0,,Барлығың, тезірек қашыңдар!
Dialogue: 0,0:05:29.32,0:05:30.78,Default,,0,0,0,,Қылышын ұстау
Dialogue: 0,0:05:32.20,0:05:33.75,Default,,0,0,0,,Бұл сіздің жоғалтыңыз.
Dialogue: 0,0:05:35.04,0:05:37.92,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:05:38.00,0:05:39.58,Default,,0,0,0,,Мибро
Dialogue: 0,0:05:39.67,0:05:41.75,Default,,0,0,0,,Біз Киото қаласын қорғаймыз.
Dialogue: 0,0:05:43.21,0:05:44.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:51.64,0:05:53.26,Default,,0,0,0,,Ха, түсіндім.
Dialogue: 0,0:05:56.89,0:05:58.64,Default,,0,0,0,,Ой... орындайық!
Dialogue: 0,0:06:00.69,0:06:02.27,Default,,0,0,0,,Сіз сонда бардыңыз ба?
Dialogue: 0,0:06:02.36,0:06:05.78,Default,,0,0,0,,Не істеп жатырсың! Оны менің дүкенімде шатастырып алайық
Dialogue: 0,0:06:06.65,0:06:07.99,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:08.82,0:06:10.24,Default,,0,0,0,,- (Кикучиё) Мибро... -Ах.
Dialogue: 0,0:06:10.32,0:06:12.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:12.16,0:06:15.04,Default,,0,0,0,,Тіпті сен сияқты балалардың барына сене алар емеспін.
Dialogue: 0,0:06:15.12,0:06:16.75,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,0:06:16.83,0:06:18.75,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:20.00,0:06:22.04,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:06:22.13,0:06:23.00,Default,,0,0,0,,Ах
Dialogue: 0,0:06:26.09,0:06:27.01,Default,,0,0,0,,Уф
Dialogue: 0,0:06:28.34,0:06:30.97,Default,,0,0,0,,Таро! Оны да тез жабыңыз!
Dialogue: 0,0:06:31.05,0:06:33.14,Default,,0,0,0,,Иә? Маған бұйрық бермеңіз
Dialogue: 0,0:06:33.22,0:06:35.01,Default,,0,0,0,,Ол әлі сол жерде отыр.
Dialogue: 0,0:06:35.10,0:06:35.93,Default,,0,0,0,,На
Dialogue: 0,0:06:36.02,0:06:37.02,Default,,0,0,0,,Не?
Dialogue: 0,0:06:37.10,0:06:38.64,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:06:39.14,0:06:41.77,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:06:43.11,0:06:44.27,Default,,0,0,0,,Кикучио
Dialogue: 0,0:06:44.36,0:06:46.82,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:46.90,0:06:48.28,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:06:48.36,0:06:50.53,Default,,0,0,0,,Неліктен сізді нысанаға алады?
Dialogue: 0,0:06:51.36,0:06:54.78,Default,,0,0,0,,Иә
Dialogue: 0,0:06:56.16,0:06:59.29,Default,,0,0,0,,Енді кешкі фестиваль басталады.
Dialogue: 0,0:07:02.88,0:07:04.54,Default,,0,0,0,,Кикучио мырза
Dialogue: 0,0:07:05.09,0:07:07.34,Default,,0,0,0,,Не, сен соншалықты бел байладың ба?
Dialogue: 0,0:07:07.42,0:07:09.92,Default,,0,0,0,,Тез жауап бер, еріншек!
Dialogue: 0,0:07:10.63,0:07:12.97,Default,,0,0,0,,Өтінемін, Кикучио мырза.
Dialogue: 0,0:07:13.05,0:07:15.60,Default,,0,0,0,,Мен бұл жағдайдан қалай да өткім келеді.
Dialogue: 0,0:07:15.68,0:07:18.68,Default,,0,0,0,,Ол үшін маған білетіндеріңді айтыңдар.
Dialogue: 0,0:07:19.35,0:07:20.60,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:21.10,0:07:24.69,Default,,0,0,0,,Күн ортасында мен өтіп бара жатқанда кенет болды.
Dialogue: 0,0:07:26.07,0:07:28.15,Default,,0,0,0,,Майданнан шабуыл жасалды
Dialogue: 0,0:07:28.23,0:07:31.53,Default,,0,0,0,,Хабаршылар да соғысты, бірақ тәртіпсіздік болды.
Dialogue: 0,0:07:32.28,0:07:34.95,Default,,0,0,0,,Мен өз өмірім үшін жүгірдім
Dialogue: 0,0:07:35.03,0:07:37.70,Default,,0,0,0,,Біз осы данго дүкеніне келдік.
Dialogue: 0,0:07:37.79,0:07:40.50,Default,,0,0,0,,Адамдар тұрған жерде мақтанышпен тұрып...
Dialogue: 0,0:07:40.58,0:07:41.96,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:07:42.04,0:07:44.08,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:07:44.17,0:07:47.46,Default,,0,0,0,,Сіз ақылсыз болуыңыз керек. Оны талқылауға мүмкіндік жоқ.
Dialogue: 0,0:07:48.55,0:07:52.22,Default,,0,0,0,,Артында қалғандар жақсы болды ма?
Dialogue: 0,0:07:52.30,0:07:54.72,Default,,0,0,0,,Сіз басқа адамның не ойлайтынын түсінесіз бе?
Dialogue: 0,0:07:55.93,0:07:58.22,Default,,0,0,0,,Жоқ, мен түсінбеймін.
Dialogue: 0,0:07:59.39,0:08:04.23,Default,,0,0,0,,Дегенмен, менің өмірімнің нысанаға алынуының көптеген себептері бар.
Dialogue: 0,0:08:04.31,0:08:05.27,Default,,0,0,0,,На
Dialogue: 0,0:08:05.35,0:08:06.40,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:06.48,0:08:08.48,Default,,0,0,0,,О... сен не істедің?
Dialogue: 0,0:08:08.57,0:08:09.40,Default,,0,0,0,,(шу)
Dialogue: 0,0:08:09.48,0:08:10.49,Default,,0,0,0,,- (басында) Ха! -(Таро) Эй!
Dialogue: 0,0:08:10.57,0:08:13.53,Default,,0,0,0,,Эй... кірме!
Dialogue: 0,0:08:13.61,0:08:15.24,Default,,0,0,0,,- (Хиджиката) Не істеп жатырсың? Оны ашыңыз! -(Таро) Гуджиджиги
Dialogue: 0,0:08:15.32,0:08:16.62,Default,,0,0,0,,Ах
Dialogue: 0,0:08:18.20,0:08:19.58,Default,,0,0,0,,Қалжыңдамаңыз!
Dialogue: 0,0:08:19.66,0:08:22.29,Default,,0,0,0,,Хехе, сен қандай ойын ойнап жүрсің?
Dialogue: 0,0:08:22.37,0:08:24.37,Default,,0,0,0,,Балалар түндейтін болсаңыздар, маған хабарлаңыздар.
Dialogue: 0,0:08:24.46,0:08:25.63,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:08:25.71,0:08:29.38,Default,,0,0,0,,Хиджиката мырзаға, Окита мырзаға және Тодо мырзаға.
Dialogue: 0,0:08:29.46,0:08:30.71,Default,,0,0,0,,Күте тұрыңыз! Хаха
Dialogue: 0,0:08:30.80,0:08:32.47,Default,,0,0,0,,Әже, біраз болды.
Dialogue: 0,0:08:32.55,0:08:35.26,Default,,0,0,0,,Ахихи, ол әрқашан әдемі көрінеді
Dialogue: 0,0:08:35.34,0:08:38.47,Default,,0,0,0,,Дүкеннің жабылуына сәл ерте сияқты...
Dialogue: 0,0:08:38.55,0:08:40.01,Default,,0,0,0,,Жарайды, жабыңыз!
Dialogue: 0,0:08:40.10,0:08:43.02,Default,,0,0,0,,Дәл сол жерде ақ киімді қауіпті жігіт отыр.
Dialogue: 0,0:08:43.10,0:08:45.02,Default,,0,0,0,,Ақ киімді қауіпті жігіт?
Dialogue: 0,0:08:45.94,0:08:47.73,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:08:47.81,0:08:49.73,Default,,0,0,0,,Иә? Қайда бардың?
Dialogue: 0,0:08:51.82,0:08:55.03,Default,,0,0,0,,Ақ киім киген адамды көрмедім.
Dialogue: 0,0:08:55.95,0:08:59.41,Default,,0,0,0,,Неге екені белгісіз, мені жан-жақтан бақылап жатыр.
Dialogue: 0,0:08:59.49,0:09:01.04,Default,,0,0,0,,々
Dialogue: 0,0:09:01.12,0:09:02.29,Default,,0,0,0,,-(Таро) Иә?
Dialogue: 0,0:09:02.37,0:09:04.29,Default,,0,0,0,,Сенің достарың бар ма?
Dialogue: 0,0:09:04.37,0:09:06.75,Default,,0,0,0,,Шамамен 6 адам.
Dialogue: 0,0:09:06.83,0:09:09.84,Default,,0,0,0,,Бір қарағанда, олардың ұрылар тобы екенін түсінуге болады.
Dialogue: 0,0:09:09.92,0:09:13.17,Default,,0,0,0,,7 адам. Мен артта бір адамды көрдім.
Dialogue: 0,0:09:13.26,0:09:18.05,Default,,0,0,0,,Мен мұны кірер алдында түсіндім, бірақ кенеттен сізге шабуыл жасай алмаймын.
Dialogue: 0,0:09:18.14,0:09:20.93,Default,,0,0,0,,жағдай қандай?
Dialogue: 0,0:09:21.01,0:09:24.06,Default,,0,0,0,,Бір қызық нәрсе болып жатыр, солай емес пе?
Dialogue: 0,0:09:24.14,0:09:26.81,Default,,0,0,0,,Ах, бұл Кикучио.
Dialogue: 0,0:09:27.65,0:09:31.32,Default,,0,0,0,,Маған кенет сыртта ақ киім киген қорқынышты адам шабуыл жасады.
Dialogue: 0,0:09:31.40,0:09:35.32,Default,,0,0,0,,Иә? иә? Қорқыныш деген қандай сезім?
Dialogue: 0,0:09:35.40,0:09:38.41,Default,,0,0,0,,Ол сондай ұзын қылышты қолданады!
Dialogue: 0,0:09:38.49,0:09:40.83,Default,,0,0,0,,Мен оны бір қолмен сілкіп алмақ болдым!
Dialogue: 0,0:09:40.91,0:09:43.62,Default,,0,0,0,,Е! Бұл қылыш па?
Dialogue: 0,0:09:43.70,0:09:45.33,Default,,0,0,0,,Оны қалай шайқауға болады?
Dialogue: 0,0:09:45.41,0:09:48.08,Default,,0,0,0,,Эй, 6 шаку бар емес пе?
Dialogue: 0,0:09:48.17,0:09:50.08,Default,,0,0,0,,Кикучио…
Dialogue: 0,0:09:50.79,0:09:53.09,Default,,0,0,0,,Не болды? Хиджиката мырза
Dialogue: 0,0:09:53.17,0:09:56.76,Default,,0,0,0,,Жоқ, мен оны ешқашан көрген емеспін.
Dialogue: 0,0:09:56.84,0:09:59.51,Default,,0,0,0,,Мен оның бала кездегі есімі екенін естідім.
Dialogue: 0,0:09:59.59,0:10:01.76,Default,,0,0,0,,Не... Бұл нені білдіреді?
Dialogue: 0,0:10:01.85,0:10:04.10,Default,,0,0,0,,Мен сене алмаймын
Dialogue: 0,0:10:04.18,0:10:06.02,Default,,0,0,0,,Генерал Токугава Иемочи?
Dialogue: 0,0:10:06.10,0:10:07.85,Default,,0,0,0,,Шо... Жалпы?
Dialogue: 0,0:10:10.44,0:10:12.86,Default,,0,0,0,,Күте тұрыңыз... Сіз нені айтасыз, генерал?
Dialogue: 0,0:10:12.94,0:10:15.74,Default,,0,0,0,,Идиот Генерал – генерал.
Dialogue: 0,0:10:15.82,0:10:17.82,Default,,0,0,0,,Ол осы елдегі ең ұлы адам.
Dialogue: 0,0:10:17.90,0:10:19.61,Default,,0,0,0,,- (Кикучиё) Бұл дұрыс емес - (Тодо) Иә?
Dialogue: 0,0:10:20.82,0:10:26.58,Default,,0,0,0,,Мен императордың бұйрығымен үкімет сеніп тапсырылған генералмын.
Dialogue: 0,0:10:26.66,0:10:29.12,Default,,0,0,0,,Токугава бір доменнің генералы болғанымен.
Dialogue: 0,0:10:29.21,0:10:31.13,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,0:10:31.21,0:10:33.13,Default,,0,0,0,,Шынымен солай ма?
Dialogue: 0,0:10:33.21,0:10:37.13,Default,,0,0,0,,Лорд Токугава Иемочи қазір Киотоға келе жатыр ма?
Dialogue: 0,0:10:37.21,0:10:38.55,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:38.63,0:10:39.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:39.88,0:10:42.47,Default,,0,0,0,,Не!? Жоғарғы орган?
Dialogue: 0,0:10:42.55,0:10:44.89,Default,,0,0,0,,Неге! Ол Ниджо қамалында болуы керек!
Dialogue: 0,0:10:44.97,0:10:45.93,Default,,0,0,0,,Хаха!
Dialogue: 0,0:10:46.02,0:10:47.14,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:10:47.22,0:10:48.89,Default,,0,0,0,,Ах... Ахах...
Dialogue: 0,0:10:48.98,0:10:52.31,Default,,0,0,0,,Мен солай ойладым...
Dialogue: 0,0:10:52.40,0:10:55.27,Default,,0,0,0,,Я, Жапониядағы нөмірі бірінші! Мен сенің соңынан еремін
Dialogue: 0,0:10:55.36,0:10:57.53,Default,,0,0,0,,Маған не қалайтыныңызды айтыңыз.
Dialogue: 0,0:10:57.61,0:11:00.99,Default,,0,0,0,,Қалай аман қалу керек... Тез өзгер!
Dialogue: 0,0:11:01.07,0:11:02.91,Default,,0,0,0,,Сіз дүниені шарлауда жақсысыз.
Dialogue: 0,0:11:02.99,0:11:04.91,Default,,0,0,0,,Жоқ, мен бұған нашармын.
Dialogue: 0,0:11:04.99,0:11:06.95,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:11:07.04,0:11:09.66,Default,,0,0,0,,Жағдай барған сайын қиындап бара жатқан жоқ па?
Dialogue: 0,0:11:09.75,0:11:13.29,Default,,0,0,0,,Иә, жағдай шұғыл.
Dialogue: 0,0:11:13.38,0:11:14.29,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:14.38,0:11:16.96,Default,,0,0,0,,Қазіргі заманда генералдың өмірін мақсат еткен адамдар бар.
Dialogue: 0,0:11:17.05,0:11:18.42,Default,,0,0,0,,Ит бар
Dialogue: 0,0:11:18.51,0:11:22.59,Default,,0,0,0,,Ми... Миброның достарын шақырайық. Біреу жүгірсе...
Dialogue: 0,0:11:22.68,0:11:24.89,Default,,0,0,0,,- Біз бұны жеңеміз деп үміттенемін - (Таро) А...
Dialogue: 0,0:11:24.97,0:11:26.89,Default,,0,0,0,,Бірінші кірсең, бітті.
Dialogue: 0,0:11:26.97,0:11:27.89,Default,,0,0,0,,Уф
Dialogue: 0,0:11:27.97,0:11:31.35,Default,,0,0,0,,Nijo Castle осы жерден жақынырақ.
Dialogue: 0,0:11:31.44,0:11:34.02,Default,,0,0,0,,Жаяу жүруге жарты сағаттан аз уақыт кетеді.
Dialogue: 0,0:11:36.27,0:11:37.65,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:11:38.73,0:11:40.15,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:11:40.24,0:11:45.37,Default,,0,0,0,,Біз генералды Ниджо қамалына аман-есен жеткіземіз.
Dialogue: 0,0:11:45.45,0:11:46.66,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:11:46.74,0:11:49.16,Default,,0,0,0,,Бірақ мен оны араластыра алмаймын...
Dialogue: 0,0:11:49.25,0:11:51.16,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:51.25,0:11:53.12,Default,,0,0,0,,Біріншіден, біз Миброда
Dialogue: 0,0:11:53.21,0:11:56.04,Default,,0,0,0,,Ол сегунды қорғау үшін Эдодан келген.
Dialogue: 0,0:11:56.13,0:11:57.42,Default,,0,0,0,,Ах
Dialogue: 0,0:11:57.50,0:12:00.63,Default,,0,0,0,,Енді нақты не істеуіміз керек?
Dialogue: 0,0:12:00.72,0:12:02.80,Default,,0,0,0,,Кешке дейін біраз күтейік.
Dialogue: 0,0:12:03.80,0:12:05.80,Default,,0,0,0,,Менің бір ойым бар.
Dialogue: 0,0:12:05.89,0:12:07.26,Default,,0,0,0,,Жоқ, балаға...
Dialogue: 0,0:12:07.35,0:12:08.81,Default,,0,0,0,,- (Хиджиката) Жарайды, тыңдайық - (Кикучиё) Хмм...
Dialogue: 0,0:12:08.89,0:12:12.31,Default,,0,0,0,,Стратегия мынадай: Алдымен екі топқа бөліну...
Dialogue: 0,0:12:20.36,0:12:23.57,Default,,0,0,0,,Жарайды, қазір уақыт. Дайынсыз ба?
Dialogue: 0,0:12:23.65,0:12:24.49,Default,,0,0,0,,Иә
Dialogue: 0,0:12:24.57,0:12:26.16,Default,,0,0,0,,Сәтсіздік опция емес
Dialogue: 0,0:12:26.24,0:12:27.74,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:12:27.83,0:12:29.33,Default,,0,0,0,,Ол жанып жатыр.
Dialogue: 0,0:12:29.41,0:12:30.33,Default,,0,0,0,,Хун
Dialogue: 0,0:12:30.41,0:12:34.58,Default,,0,0,0,,А... әйтеуір, әйтеуір, аман-есен жетеміз деп үміттенемін.
Dialogue: 0,0:12:36.54,0:12:37.59,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:12:38.46,0:12:41.01,Default,,0,0,0,,Ханым, кешіріңіз.
Dialogue: 0,0:12:41.09,0:12:44.13,Default,,0,0,0,,Мен бұл дүкенді қажетсіз нәрсеге араластырдым.
Dialogue: 0,0:12:44.22,0:12:46.59,Default,,0,0,0,,Хмф! Мен оны ұнатпаймын.
Dialogue: 0,0:12:46.68,0:12:49.56,Default,,0,0,0,,Әже, бұл генерал!
Dialogue: 0,0:12:50.14,0:12:53.39,Default,,0,0,0,,Генерал немесе император боласың ба, бәрібір.
Dialogue: 0,0:12:53.48,0:12:55.81,Default,,0,0,0,,Қате болу - қателесу!
Dialogue: 0,0:12:55.90,0:12:59.32,Default,,0,0,0,,Шабуыл жасаған кезде қарсылық көрсетуге тырыспадың.
Dialogue: 0,0:12:59.40,0:13:02.32,Default,,0,0,0,,Кез келген уақытта өлетін сияқтымын!
Dialogue: 0,0:13:02.40,0:13:05.99,Default,,0,0,0,,Бізден жоғары тұрғандар өмірін босқа өткізсе, жақсы емес!
Dialogue: 0,0:13:06.07,0:13:07.57,Default,,0,0,0,,Менің астымдағылар қиындыққа тап болады.
Dialogue: 0,0:13:09.66,0:13:13.62,Default,,0,0,0,,Сонымен қатар бағыныңқылардың заттарын бағыныңқыларға қалдыр.
Dialogue: 0,0:13:13.70,0:13:15.58,Default,,0,0,0,,Бұл сенің кінәң емес!
Dialogue: 0,0:13:15.66,0:13:18.00,Default,,0,0,0,,Басшы басшының жұмысына жауапты.
Dialogue: 0,0:13:18.08,0:13:20.84,Default,,0,0,0,,Адамдар өз орындарында берік тұруы керек.
Dialogue: 0,0:13:20.92,0:13:24.09,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:13:26.18,0:13:27.59,Default,,0,0,0,,- (Әже) Хмф! - (Кикучиё)!
Dialogue: 0,0:13:27.68,0:13:30.10,Default,,0,0,0,,Жалпы! Қытырлақ!
Dialogue: 0,0:13:32.39,0:13:33.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:34.89,0:13:36.60,Default,,0,0,0,,Бұл елдің бақытсыздығы
Dialogue: 0,0:13:36.69,0:13:39.48,Default,,0,0,0,,Мен сияқты жас жігіт генерал болды.
Dialogue: 0,0:13:39.56,0:13:41.02,Default,,0,0,0,,Әже керемет
Dialogue: 0,0:13:41.11,0:13:42.19,Default,,0,0,0,,Бірақ менің жолым...
Dialogue: 0,0:13:42.19,0:13:44.11,Default,,0,0,0,,Бірақ менің жолым...
Dialogue: 0,0:13:42.19,0:13:44.11,Default,,0,0,0,,Әже, мен таң қалдым.
Dialogue: 0,0:13:44.19,0:13:45.99,Default,,0,0,0,,Әрқашан өз өміріңізге қауіп төндіріңіз!
Dialogue: 0,0:13:46.07,0:13:46.90,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:13:46.99,0:13:49.99,Default,,0,0,0,,Мұндай адамдар болуы мүмкін.
Dialogue: 0,0:13:55.08,0:13:56.79,Default,,0,0,0,,Шам бар...
Dialogue: 0,0:13:56.87,0:13:57.75,Default,,0,0,0,,Ол шығып жатыр.
Dialogue: 0,0:13:59.00,0:14:01.50,Default,,0,0,0,,Иемоның басын алыңыз
Dialogue: 0,0:14:02.55,0:14:03.88,Default,,0,0,0,,Сіз өмір сүресіз бе?
Dialogue: 0,0:14:06.42,0:14:07.26,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:09.34,0:14:10.72,Default,,0,0,0,,Ол шықты
Dialogue: 0,0:14:10.80,0:14:11.76,Default,,0,0,0,,Бұл Иемо!
Dialogue: 0,0:14:13.10,0:14:13.93,Default,,0,0,0,,Не!
Dialogue: 0,0:14:14.89,0:14:16.14,Default,,0,0,0,,Не? Секонд-хенд?
Dialogue: 0,0:14:16.23,0:14:17.77,Default,,0,0,0,,Қайсысы Иемо?
Dialogue: 0,0:14:17.85,0:14:20.31,Default,,0,0,0,,Екеуіңіз де қашып кетпеңіздер! Қуда, қу!
Dialogue: 0,0:14:27.07,0:14:28.03,Default,,0,0,0,,Мен бардым
Dialogue: 0,0:14:28.11,0:14:30.41,Default,,0,0,0,,Түсіндім, бұл тамаша идея.
Dialogue: 0,0:14:31.03,0:14:33.83,Default,,0,0,0,,Бірақ олар жақсы бола ма?
Dialogue: 0,0:14:33.91,0:14:35.16,Default,,0,0,0,,Менің алмастырушы жұмбақ
Dialogue: 0,0:14:35.79,0:14:38.29,Default,,0,0,0,,О, бұл туралы уайымдама.
Dialogue: 0,0:14:38.37,0:14:40.92,Default,,0,0,0,,Ол адамдар жын сияқты күшті.
Dialogue: 0,0:14:43.25,0:14:45.46,Default,,0,0,0,,Жалпы! Генерал!
Dialogue: 0,0:14:45.55,0:14:47.67,Default,,0,0,0,,- (Хиджиката) Тыныштыр, Құсобаба - Ха...
Dialogue: 0,0:14:47.76,0:14:49.47,Default,,0,0,0,,Охохохо...
Dialogue: 0,0:14:49.55,0:14:52.97,Default,,0,0,0,,Керемет, Хейсуке! Сіздің күлімсіреуіңіз әдемі~
Dialogue: 0,0:14:53.05,0:14:54.18,Default,,0,0,0,,Қаш!
Dialogue: 0,0:14:54.97,0:14:59.14,Default,,0,0,0,,30-ға дейін санағаннан кейін, артқы жолдар арқылы Ниджо қамалына қарай бет алайық.
Dialogue: 0,0:14:59.23,0:15:00.06,Default,,0,0,0,,Иә (есіктің ашылған дыбысы)
Dialogue: 0,0:15:00.14,0:15:01.19,Default,,0,0,0,,- (Кикучиё) Ах - Ха!
Dialogue: 0,0:15:05.77,0:15:08.44,Default,,0,0,0,,Мынау.
Dialogue: 0,0:15:09.99,0:15:11.20,Default,,0,0,0,,Сіз мұны қалай білдіңіз?
Dialogue: 0,0:15:11.28,0:15:13.12,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:15:13.20,0:15:16.83,Default,,0,0,0,,Түсіндім, бұл екі топ алаяқтар.
Dialogue: 0,0:15:16.91,0:15:21.96,Default,,0,0,0,,Мен адам санын санадым, бірақ анау қарт қаңбақ?
Dialogue: 0,0:15:22.04,0:15:24.50,Default,,0,0,0,,Ағыс суыған және ешкім қалмаған жер
Dialogue: 0,0:15:24.59,0:15:28.76,Default,,0,0,0,,Лорд Иемочимен бірге қашу жоспары ма?
Dialogue: 0,0:15:28.84,0:15:31.72,Default,,0,0,0,,Қызық екен, ойланып қалдым.
Dialogue: 0,0:15:33.55,0:15:36.76,Default,,0,0,0,,Бұл шынымен сәтсіздік болды.
Dialogue: 0,0:15:37.39,0:15:38.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:39.06,0:15:41.73,Default,,0,0,0,,Мен мұны алу үшін келдім.
Dialogue: 0,0:15:42.81,0:15:44.52,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:15:44.61,0:15:47.23,Default,,0,0,0,,Бәрі бұзылды
Dialogue: 0,0:15:48.44,0:15:49.49,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:15:49.57,0:15:50.74,Default,,0,0,0,,Ах
Dialogue: 0,0:15:51.74,0:15:57.16,Default,,0,0,0,,10-ға дейін санау Уақытты орындаңыз Хехехехе...
Dialogue: 0,0:15:57.66,0:15:58.49,Default,,0,0,0,,Құт
Dialogue: 0,0:15:59.50,0:16:03.00,Default,,0,0,0,,Мен ойнаймын, аңға шығамын.
Dialogue: 0,0:16:03.67,0:16:04.50,Default,,0,0,0,,Кикучио-сан!
Dialogue: 0,0:16:05.58,0:16:06.79,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:06.88,0:16:07.92,Default,,0,0,0,,Ичи
Dialogue: 0,0:16:08.00,0:16:13.01,Default,,0,0,0,,Нии-сан...
Dialogue: 0,0:16:18.93,0:16:19.77,Default,,0,0,0,,Хун
Dialogue: 0,0:16:19.85,0:16:25.27,Default,,0,0,0,,Фуфухахаха... Қаш! Жүгіріп кету!
Dialogue: 0,0:16:27.61,0:16:31.03,Default,,0,0,0,,Қайда бара жатырсың? Сіз Ниджо қамалына барасыз ба?
Dialogue: 0,0:16:31.65,0:16:33.28,Default,,0,0,0,,Кішкене айналма жол
Dialogue: 0,0:16:33.36,0:16:35.53,Default,,0,0,0,,Әзірше мен ол кісіні тамақтандыруым керек.
Dialogue: 0,0:16:38.08,0:16:39.54,Default,,0,0,0,,иілу
Dialogue: 0,0:16:42.12,0:16:44.79,Default,,0,0,0,,О… Они… И-чан
Dialogue: 0,0:16:46.42,0:16:47.92,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:52.26,0:16:53.55,Default,,0,0,0,,Осы жерден өтіңіз
Dialogue: 0,0:16:53.63,0:16:57.05,Default,,0,0,0,,Уау, сіз егжей-тегжейлі жолдарды жақсы білесіз.
Dialogue: 0,0:16:58.05,0:16:59.89,Default,,0,0,0,,Мен Киото қаласында дүниеге келдім.
Dialogue: 0,0:16:59.97,0:17:01.43,Default,,0,0,0,,Бақ сияқты
Dialogue: 0,0:17:01.52,0:17:04.44,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:05.73,0:17:07.81,Default,,0,0,0,,Осы жерде біраз тығылып, не болатынын көрейік.
Dialogue: 0,0:17:07.90,0:17:11.57,Default,,0,0,0,,Маған ұнамайды, шаршадым! себетті шақыр, себетті шақыр
Dialogue: 0,0:17:11.65,0:17:13.94,Default,,0,0,0,,Дөрекі болмаңыз.
Dialogue: 0,0:17:14.53,0:17:16.45,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:17:16.53,0:17:19.49,Default,,0,0,0,,Мен дұрыс ойнап жеңіске жетемін деп ойламаймын.
Dialogue: 0,0:17:19.58,0:17:22.04,Default,,0,0,0,,Мен пайдалы нәрсеге үміттендім.
Dialogue: 0,0:17:24.20,0:17:26.92,Default,,0,0,0,,Мен де қылышта шебермін.
Dialogue: 0,0:17:27.00,0:17:28.71,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:17:29.84,0:17:32.17,Default,,0,0,0,,- Анау Кикучио-сан - (Кикучиё) Иә?
Dialogue: 0,0:17:32.25,0:17:33.96,Default,,0,0,0,,А, бұл генерал болды.
Dialogue: 0,0:17:35.34,0:17:37.09,Default,,0,0,0,,Кикучио жақсы
Dialogue: 0,0:17:37.18,0:17:39.05,Default,,0,0,0,,Кикучио мырза
Dialogue: 0,0:17:39.14,0:17:44.14,Default,,0,0,0,,Сіздің өміріңізге қауіп төніп тұрғанда, сіз Ниджо сарайынан неліктен кетіп қалдыңыз?
Dialogue: 0,0:17:44.22,0:17:46.10,Default,,0,0,0,,Сізде маңызды нәрсе болды ма?
Dialogue: 0,0:17:46.98,0:17:49.61,Default,,0,0,0,,Менің айналамдағы адамдар мұны істеуге өте құлықсыз болды.
Dialogue: 0,0:17:49.69,0:17:52.65,Default,,0,0,0,,Соңында олар дұрыс болды.
Dialogue: 0,0:17:52.73,0:17:53.57,Default,,0,0,0,,(шу)
Dialogue: 0,0:17:53.65,0:17:55.49,Default,,0,0,0,,Ах
Dialogue: 0,0:17:59.24,0:18:00.41,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:18:00.49,0:18:03.29,Default,,0,0,0,,Жылқы? Неге мұндасың?
Dialogue: 0,0:18:03.37,0:18:05.25,Default,,0,0,0,,- (Кикучиё) Ху - Ах.
Dialogue: 0,0:18:07.87,0:18:10.25,Default,,0,0,0,,Жарайды, жарайды, жақсы болдыңыз ба?
Dialogue: 0,0:18:11.50,0:18:15.30,Default,,0,0,0,,Сондай-ақ... бұл Кикучио мінген ат болуы мүмкін бе?
Dialogue: 0,0:18:15.38,0:18:16.80,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:18:16.88,0:18:18.22,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:18:18.30,0:18:19.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.93,0:18:21.80,Default,,0,0,0,,Не болды? Сіз жылқыдан қорқасыз ба?
Dialogue: 0,0:18:22.39,0:18:26.18,Default,,0,0,0,,Жоқ... жоқ, жақыннан көргенде әсерлі...
Dialogue: 0,0:18:26.27,0:18:29.77,Default,,0,0,0,,Негізі мен құстар мен балықтарға тамсанып өмір сүргім келді.
Dialogue: 0,0:18:29.85,0:18:30.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.44,0:18:33.69,Default,,0,0,0,,Жаңбырдан шыққан генералдық
Dialogue: 0,0:18:33.77,0:18:36.03,Default,,0,0,0,,Сізде сенімділік немесе өзін-өзі тану жоқ.
Dialogue: 0,0:18:37.74,0:18:40.45,Default,,0,0,0,,Мен сіздей адамдарды көргім келді.
Dialogue: 0,0:18:40.53,0:18:44.20,Default,,0,0,0,,Бұл сізді алаңдатуы мүмкін, бірақ төмен адамдарға қамқорлық жасамаңыз.
Dialogue: 0,0:18:45.49,0:18:48.46,Default,,0,0,0,,Мен кімнің үстінде тұрмын?
Dialogue: 0,0:18:48.54,0:18:51.21,Default,,0,0,0,,Кімді қорғау керек?
Dialogue: 0,0:18:52.25,0:18:55.67,Default,,0,0,0,,Осы жерде күте аласыз ба? Мен сені бірден алып кетемін
Dialogue: 0,0:18:55.75,0:18:57.21,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:18:58.88,0:18:59.72,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:59.80,0:19:01.47,Default,,0,0,0,,Кикучио мырза
Dialogue: 0,0:19:01.55,0:19:04.30,Default,,0,0,0,,Император ретінде шетелдіктерді қуып шығуға уәде беру үшін.
Dialogue: 0,0:19:04.39,0:19:06.72,Default,,0,0,0,,Мен сізді Эдодан келгеніңізді естідім.
Dialogue: 0,0:19:06.81,0:19:08.18,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:19:08.27,0:19:10.48,Default,,0,0,0,,Кем дегенде, айналамдағы адамдар осылай ойлайды.
Dialogue: 0,0:19:10.56,0:19:11.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.85,0:19:13.98,Default,,0,0,0,,Кикучио мырза басқаша ойлайды ма?
Dialogue: 0,0:19:15.77,0:19:17.36,Default,,0,0,0,,Джойды жоя алмайсың.
Dialogue: 0,0:19:17.44,0:19:18.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:19.44,0:19:21.45,Default,,0,0,0,,Сонымен... мүмкін емес пе?
Dialogue: 0,0:19:21.53,0:19:22.36,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:22.45,0:19:25.41,Default,,0,0,0,,Аа, кешіріңіз, мен жай ғана...
Dialogue: 0,0:19:25.49,0:19:27.87,Default,,0,0,0,,Порт әлдеқашан ашық
Dialogue: 0,0:19:29.04,0:19:31.25,Default,,0,0,0,,Олардың барлығын қуып жіберіңіз
Dialogue: 0,0:19:31.33,0:19:34.38,Default,,0,0,0,,Елге бір шетелдікті де кіргізбеу мүмкін емес.
Dialogue: 0,0:19:35.17,0:19:39.09,Default,,0,0,0,,Елімізді жауып тастасақ, әлем елдерімен арадағы алшақтық одан әрі кеңейеді.
Dialogue: 0,0:19:39.17,0:19:40.88,Default,,0,0,0,,Уақыт өте маңызды.
Dialogue: 0,0:19:41.93,0:19:43.84,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:19:43.93,0:19:44.89,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:19:45.47,0:19:48.93,Default,,0,0,0,,Елдің басын ашу қиын емес пе?
Dialogue: 0,0:19:49.02,0:19:50.35,Default,,0,0,0,,Жұмыс істейді
Dialogue: 0,0:19:50.43,0:19:53.40,Default,,0,0,0,,Ішінде жаман дәрілер бар деп естідім.
Dialogue: 0,0:19:53.48,0:19:55.40,Default,,0,0,0,,Ел ашылады
Dialogue: 0,0:19:55.48,0:19:57.90,Default,,0,0,0,,Бірақ мен сияқты бейтаныс адамға жол бермеймін
Dialogue: 0,0:19:58.61,0:20:02.11,Default,,0,0,0,,Осы мақсатта барлығына бастарын пайдаланатын кез келді.
Dialogue: 0,0:20:02.20,0:20:04.53,Default,,0,0,0,,Даналығымызбен бөлісетін кез келді
Dialogue: 0,0:20:04.62,0:20:06.91,Default,,0,0,0,,Кем дегенде, мен қазір солай ойлаймын.
Dialogue: 0,0:20:09.08,0:20:12.66,Default,,0,0,0,,Мен осындай көпір салсам деп едім.
Dialogue: 0,0:20:12.75,0:20:14.92,Default,,0,0,0,,Кейбіреулер тыңдамауы мүмкін.
Dialogue: 0,0:20:15.58,0:20:17.54,Default,,0,0,0,,Елдің қуанышы немесе ашылуы?
Dialogue: 0,0:20:17.63,0:20:22.42,Default,,0,0,0,,Ел екіге бөлінуі мүмкін, ол бір немесе басқа болмаса да.
Dialogue: 0,0:20:23.47,0:20:27.39,Default,,0,0,0,,Алайда, ол әлсіз және қабілетсіз генерал болғандықтан,
Dialogue: 0,0:20:27.47,0:20:29.77,Default,,0,0,0,,Менің ойымша, сіз жасай алатын нәрселер бар.
Dialogue: 0,0:20:33.14,0:20:34.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:35.19,0:20:37.52,Default,,0,0,0,,Тұрмыстық даулардың туындауына жол бермеу
Dialogue: 0,0:20:37.61,0:20:39.61,Default,,0,0,0,,Менің қара көзім
Dialogue: 0,0:20:40.23,0:20:42.57,Default,,0,0,0,,Өміріңізге қауіп төнсе де
Dialogue: 0,0:20:44.24,0:20:46.70,Default,,0,0,0,,Бұл менің міндетім.
Dialogue: 0,0:20:47.91,0:20:49.37,Default,,0,0,0,,Кикучио мырза
Dialogue: 0,0:20:50.33,0:20:53.46,Default,,0,0,0,,Ах, бірақ маған ұнамайды.
Dialogue: 0,0:20:53.54,0:20:56.63,Default,,0,0,0,,Негізі мен жай ғана атпен ойнағым келеді.
Dialogue: 0,0:20:56.71,0:21:00.63,Default,,0,0,0,,Кесу ауырады, солай ма? О, маған ұнамайды~
Dialogue: 0,0:21:00.71,0:21:02.80,Default,,0,0,0,,Шаршадым, жүргім келмейді.
Dialogue: 0,0:21:03.38,0:21:05.47,Default,,0,0,0,,Атқа мінуге қайта оралу?
Dialogue: 0,0:21:05.55,0:21:07.47,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:21:08.35,0:21:11.60,Default,,0,0,0,,Мен бұл сол қолмен тізгінді жақсы басқара алмаймын.
Dialogue: 0,0:21:11.68,0:21:13.43,Default,,0,0,0,,Жылқыға зақым келтіруі мүмкін
Dialogue: 0,0:21:13.52,0:21:16.31,Default,,0,0,0,,Жылқылар? Сіз бұл туралы алаңдайсыз ба?
Dialogue: 0,0:21:16.40,0:21:17.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:18.06,0:21:19.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:19.94,0:21:21.73,Default,,0,0,0,,Ахаха
Dialogue: 0,0:21:21.82,0:21:23.99,Default,,0,0,0,,- Кикучио-сан - (Кикучиё) Иә?
Dialogue: 0,0:21:24.07,0:21:25.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:27.03,0:21:28.66,Default,,0,0,0,,Біз, Мибро...
Dialogue: 0,0:21:34.58,0:21:36.29,Default,,0,0,0,,Мен мүлдем қорғаймын
Dialogue: 0,0:21:38.63,0:21:41.09,Default,,0,0,0,,О, мен оны сұрадым.
Dialogue: 0,0:21:51.05,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:14.26,0:23:19.27,Default,,0,0,0,,～♪
Dialogue: 0,0:23:24.02,0:23:25.69,Default,,0,0,0,,Бұл Суджи Окита.
Dialogue: 0,0:23:25.77,0:23:29.40,Default,,0,0,0,,Уау, мен генералмен кездесемін деп ойламаппын.
Dialogue: 0,0:23:29.49,0:23:34.78,Default,,0,0,0,,Оның үстіне, оны бандиттерден қорғау қызық болатын сияқты.
Dialogue: 0,0:23:34.87,0:23:38.91,Default,,0,0,0,,Эдодан келген теңіз тасбақасы болғаны рас.
Dialogue: 0,0:23:39.54,0:23:44.50,Default,,0,0,0,,Менің кейбір ерекше дағдыларымды пайдалану мүмкіндігі болмағанына көп уақыт болды.
Dialogue: 0,0:23:45.21,0:23:47.59,Default,,0,0,0,,Келесі жолы «Нағыз күш»
Dialogue: 0,0:23:47.67,0:23:49.38,Default,,0,0,0,,Оны жіберіп алмаңыз
Dialogue: 0,0:23:50.88,0:23:56.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
