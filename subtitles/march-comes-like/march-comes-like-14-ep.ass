Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.99,0:00:09.49,signs,,0,0,0,,Рыцарь
Dialogue: 1,0:00:07.99,0:00:09.49,signs,,0,0,0,,Рыцарь
Dialogue: 0,0:00:13.33,0:00:14.33,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:00:15.45,0:00:18.96,Default-ja,,0,0,0,,Күрсін... Әй.
Dialogue: 5,0:00:17.24,0:00:18.98,Default,,0,0,0,,Капыпа
Dialogue: 5,0:00:18.98,0:00:21.11,Default,,0,0,0,,Сіз ақырында осылай қарайсыз.
Dialogue: 0,0:00:19.08,0:00:21.04,Default-ja,,0,0,0,,Сіз мені ақыры көрдіңіз.
Dialogue: 0,0:00:32.65,0:00:35.73,OP,,0,0,0,,Өзеннің жағасында келе жатқан пойыздың дыбысы
Dialogue: 0,0:00:35.73,0:00:38.61,OP,,0,0,0,,Төменге қарап гүлдеген күнбағыстың түсі
Dialogue: 0,0:00:38.61,0:00:42.24,OP,,0,0,0,,Күннің батуы жолақты жиекке айналады
Dialogue: 0,0:00:44.46,0:00:51.25,OP,,0,0,0,,«Рахмет» деген сайын неге жылағым келеді?
Dialogue: 0,0:00:51.25,0:00:53.92,OP,,0,0,0,,Мен бала сияқтымын
Dialogue: 0,0:00:53.92,0:01:02.21,OP,,0,0,0,,Мен барлық көз жасымды тоңазытқышта қалдырдым деп ойладым
Dialogue: 0,0:01:02.21,0:01:07.07,OP,,0,0,0,,Қызыл ровер, қызыл ровер, сол қызды дәл жанына жібер
Dialogue: 0,0:01:07.44,0:01:10.12,OP,,0,0,0,,Қош бол, көруші
Dialogue: 0,0:01:10.12,0:01:12.82,OP,,0,0,0,,Біз жүре береміз
Dialogue: 0,0:01:12.82,0:01:20.25,OP,,0,0,0,,Бұл жолдың соңында аспан немесе басқа нәрсе болмаса да
Dialogue: 0,0:01:20.25,0:01:24.64,OP,,0,0,0,,Мен тек сенімен бірге болып, бірге күліп жүргім келеді
Dialogue: 0,0:01:24.64,0:01:29.00,OP,,0,0,0,,Мақтаныш, тілек және үміт
Dialogue: 0,0:01:29.00,0:01:32.13,OP,,0,0,0,,Менде сіз сияқты олар әрқашан болады
Dialogue: 0,0:01:32.13,0:01:38.05,OP,,0,0,0,,Сіз қорқып, қатты қорқып, депрессияға түскенде
Dialogue: 0,0:01:38.05,0:01:43.98,OP,,0,0,0,,Мен сені қорғаймын, Мен сені әрқашан қолымда бар нәрсемен қорғаймын
Dialogue: 0,0:01:43.98,0:01:46.77,OP,,0,0,0,,Мен сізге бетіңізге уәде беремін
Dialogue: 0,0:01:53.64,0:01:55.89,Default-ja,,0,0,0,,Иә, менің ағам...
Dialogue: 5,0:01:53.66,0:01:55.95,Default,,0,0,0,,Иә. Негізі, Үлкен аға...
Dialogue: 5,0:01:57.07,0:01:58.02,Default,,0,0,0,,Мен сізге...
Dialogue: 0,0:01:57.10,0:01:58.18,Default-ja,,0,0,0,,Менің ағама...
Dialogue: 5,0:02:00.06,0:02:03.17,Default,,0,0,0,,Кирияманың басын екіге бөлді.
Dialogue: 0,0:02:00.06,0:02:03.23,Default-ja,,0,0,0,,Кирияманың басын кесуіңізді қалаймын.
Dialogue: 5,0:02:06.90,0:02:08.28,Default,,0,0,0,,Қой, балақай.
Dialogue: 0,0:02:06.94,0:02:12.11,Default-ja,,0,0,0,,Бала, тағы не айтар екен...
Dialogue: 5,0:02:09.33,0:02:12.14,Default,,0,0,0,,Мен не айтасың деп ойладым.
Dialogue: 0,0:02:15.16,0:02:17.41,Default-ja,,0,0,0,,Мазасыз нәрселер...
Dialogue: 5,0:02:15.17,0:02:17.16,Default,,0,0,0,,Сіз мені шынында да тұздыққа салып жібердіңіз.
Dialogue: 0,0:02:19.96,0:02:23.05,titles,,0,0,0,,Соқыр қараңғылық
Dialogue: 5,0:02:27.44,0:02:28.55,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:02:27.46,0:02:28.80,Default-ja,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 5,0:02:31.50,0:02:32.99,Default,,0,0,0,,Біз жалғастырамыз ба?
Dialogue: 0,0:02:31.51,0:02:33.05,Default-ja,,0,0,0,,Ол слайдер лақтырды! Ақымақ! Ол қисық бағыт алды
Dialogue: 5,0:02:40.49,0:02:43.56,Default,,0,0,0,,Оның нұсқауымен мен тақтаға қарадым...
Dialogue: 0,0:02:40.52,0:02:44.19,Default-ja,,0,0,0,,Осы нұсқауда мен тақтаға қарадым...
Dialogue: 0,0:02:44.56,0:02:47.52,Default-ja,,0,0,0,,Мені әп-сәтте ес жиды.
Dialogue: 5,0:02:44.57,0:02:47.07,Default,,0,0,0,,және тез есін жидым.
Dialogue: 0,0:02:51.40,0:02:52.99,Default-ja,,0,0,0,,Мен жалғастыра алмаймын
Dialogue: 5,0:02:51.41,0:02:53.08,Default,,0,0,0,,Мен жалғастыра алмаймын.
Dialogue: 5,0:02:55.49,0:02:58.58,Default,,0,0,0,,Бұл қаншалықты жаман.
Dialogue: 0,0:02:55.49,0:02:58.33,Default-ja,,0,0,0,,Бұл қаншалықты жаман ...
Dialogue: 0,0:03:04.00,0:03:06.79,Default-ja,,0,0,0,,Мен ең бірінші шок болдым.
Dialogue: 5,0:03:04.03,0:03:07.07,Default,,0,0,0,,Мен ең бірінші шок болдым.
Dialogue: 5,0:03:07.07,0:03:14.00,Default,,0,0,0,,Сосын мені ұят толқыны басып алды.
Dialogue: 0,0:03:07.13,0:03:09.96,Default-ja,,0,0,0,,Ал әрі қарай не болды...
Dialogue: 0,0:03:10.96,0:03:14.09,Default-ja,,0,0,0,,Ұяттың дауылы болды.
Dialogue: 5,0:03:18.50,0:03:22.98,Default,,0,0,0,,Мен оны дәл осы уақытқа дейін қандай адам деп ойладым?
Dialogue: 0,0:03:18.60,0:03:22.89,Default-ja,,0,0,0,,Осы уақытқа дейін бұл адам туралы не ойладым?
Dialogue: 0,0:03:25.44,0:03:28.69,Default-ja,,0,0,0,,Мұндай адамға қарсы ойнау үшін көп уақыт қажет.
Dialogue: 5,0:03:25.44,0:03:28.96,Default,,0,0,0,,Мұндай адамдарға қарсы матчтар әдетте ұзаққа созылатын шайқастар болып табылады.
Dialogue: 5,0:03:28.96,0:03:30.24,Default,,0,0,0,,Мен жанкүйер емеспін.
Dialogue: 0,0:03:29.06,0:03:30.15,Default-ja,,0,0,0,,Мен бұған жақсы емеспін
Dialogue: 5,0:03:30.24,0:03:31.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:30.52,0:03:33.28,Default-ja,,0,0,0,,«Бұл түр» дегеніміз не?
Dialogue: 5,0:03:31.49,0:03:33.24,Default,,0,0,0,,«Адамдарға ұнайды»?
Dialogue: 5,0:03:33.89,0:03:35.87,Default,,0,0,0,,Мен оның тері астына түсуіне жол бере алмаймын.
Dialogue: 0,0:03:33.90,0:03:37.74,Default-ja,,0,0,0,,Тітіркенсең жақсы емес, жеп кетесің.
Dialogue: 5,0:03:35.87,0:03:37.87,Default,,0,0,0,,Міне, ол мені тірідей жейді.
Dialogue: 5,0:03:38.19,0:03:39.41,Default,,0,0,0,,Мен қалайша тәкаппар бола аламын?
Dialogue: 0,0:03:38.24,0:03:39.37,Default-ja,,0,0,0,,Сен кімсің, мен?
Dialogue: 5,0:03:39.88,0:03:41.37,Default,,0,0,0,,«Мен оның тері астына түсуіне жол бере алмаймын»?
Dialogue: 0,0:03:39.91,0:03:41.70,Default-ja,,0,0,0,,«Егер сіз тітіркенсеңіз» сияқты бірдеңе айтыңыз—
Dialogue: 5,0:03:41.77,0:03:44.37,Default,,0,0,0,,Оның шеберлік деңгейін қалайша қате оқимын?!
Dialogue: 0,0:03:41.79,0:03:44.16,Default-ja,,0,0,0,,Сіз қанша деңгейді қате оқыдыңыз?
Dialogue: 5,0:03:46.66,0:03:53.02,Default,,0,0,0,,Мен жай ғана жеңгім келді, сондықтан мен оның қателесуін күтіп, ойынды теңестірдім,
Dialogue: 0,0:03:46.71,0:03:50.00,Default-ja,,0,0,0,,Тек жеңгіңіз келеді, ойынды басқарыңыз—
Dialogue: 0,0:03:50.09,0:03:52.80,Default-ja,,0,0,0,,Қарсыласының қателесуін күтетін ойыншы түрі...
Dialogue: 5,0:03:53.02,0:03:56.26,Default,,0,0,0,,мен оны рейтинг парағындағы саннан басқа ештеңе деп ойладым.
Dialogue: 0,0:03:53.13,0:03:56.13,Default-ja,,0,0,0,,Қарсыластарыңызды кездейсоқ ретпен санаңыз
Dialogue: 5,0:03:59.58,0:04:02.23,Default,,0,0,0,,Мен бұл жерде жеңіле алмаймын.
Dialogue: 0,0:03:59.59,0:04:01.85,Default-ja,,0,0,0,,Біз бұл жерде ұтыла алмаймыз.
Dialogue: 5,0:04:02.23,0:04:03.52,Default,,0,0,0,,Не болса да.
Dialogue: 0,0:04:02.35,0:04:03.43,Default-ja,,0,0,0,,Қалай болғанда да
Dialogue: 5,0:04:04.35,0:04:07.69,Default,,0,0,0,,Мен тіпті алдымдағы ойыншының күшін дәл өлшей алмадым,
Dialogue: 0,0:04:04.39,0:04:07.64,Default-ja,,0,0,0,,Алдымдағы қарсыластың қабілетін өлшей алмасам да
Dialogue: 5,0:04:09.26,0:04:11.97,Default,,0,0,0,,мен басымды жеке кекпен толтырдым.
Dialogue: 0,0:04:09.31,0:04:11.86,Default-ja,,0,0,0,,Менің басымды өшпенділік алып кетті.
Dialogue: 5,0:04:12.40,0:04:15.34,Default,,0,0,0,,Ол А сыныбында, мен оған жанама кейіпкер ретінде қараймын ба?
Dialogue: 0,0:04:12.57,0:04:15.28,Default-ja,,0,0,0,,А класындағы шоги ойыншысын ұстаңыз. Қосымша кейіпкер ретінде қарастырылады
Dialogue: 5,0:04:17.76,0:04:19.66,Default,,0,0,0,,Мен ақымақпын ба?!
Dialogue: 0,0:04:17.78,0:04:19.41,Default-ja,,0,0,0,,Өмірдің құны—
Dialogue: 5,0:04:27.49,0:04:29.21,Default,,0,0,0,,Мен қашып кеткім келеді.
Dialogue: 0,0:04:27.50,0:04:29.21,Default-ja,,0,0,0,,Уф... Мен қашып кеткім келеді.
Dialogue: 0,0:04:29.83,0:04:31.42,Default-ja,,0,0,0,,Менің жоғалып кеткім келеді
Dialogue: 5,0:04:29.84,0:04:31.46,Default,,0,0,0,,Менің жоғалып кеткім келеді.
Dialogue: 5,0:04:33.16,0:04:34.42,Default,,0,0,0,,Мен қайда...
Dialogue: 0,0:04:33.17,0:04:34.17,Default-ja,,0,0,0,,Осы жерден
Dialogue: 5,0:04:35.38,0:04:36.68,Default,,0,0,0,,Мен қайда...
Dialogue: 0,0:04:35.42,0:04:36.51,Default-ja,,0,0,0,,Осы жерден...
Dialogue: 5,0:04:37.36,0:04:38.58,Default,,0,0,0,,Мен қайда...
Dialogue: 0,0:04:37.42,0:04:38.63,Default-ja,,0,0,0,,Осы жерден
Dialogue: 5,0:04:51.13,0:04:53.92,Default,,0,0,0,,Қатты қара, бірақ соқыр...
Dialogue: 0,0:04:51.19,0:04:53.90,Default-ja,,0,0,0,,Бұл тас қараңғы және жарық еді...
Dialogue: 5,0:04:55.82,0:04:57.89,Default,,0,0,0,,Мен дем ала алмаймын...
Dialogue: 0,0:04:56.11,0:04:57.82,Default-ja,,0,0,0,,Мен дем ала алмаймын...
Dialogue: 0,0:05:15.30,0:05:17.96,Default-ja,,0,0,0,,Сол бір кішкене ағынмен...
Dialogue: 5,0:05:15.32,0:05:18.09,Default,,0,0,0,,Тамағын қысқаша тазартып,
Dialogue: 5,0:05:19.39,0:05:23.48,Default,,0,0,0,,Мен оның сабыр ет деп айтып тұрғанын түсіндім.
Dialogue: 0,0:05:19.42,0:05:23.35,Default-ja,,0,0,0,,Мен сен мені сабырға шақырып тұрғаныңды түсіндім.
Dialogue: 5,0:05:37.11,0:05:39.07,Default,,0,0,0,,Оның нұсқауы бойынша,
Dialogue: 0,0:05:37.40,0:05:38.94,Default-ja,,0,0,0,,Нұсқау бойынша…
Dialogue: 5,0:05:42.72,0:05:45.11,Default,,0,0,0,,менің санам абдырап тұрса да,
Dialogue: 0,0:05:42.74,0:05:44.99,Default-ja,,0,0,0,,Абыржыған басымен —
Dialogue: 5,0:05:47.66,0:05:49.54,Default,,0,0,0,,Мен келесі қадамымды іздедім.
Dialogue: 0,0:05:47.66,0:05:49.62,Default-ja,,0,0,0,,Келесі қадамды іздеу
Dialogue: 5,0:05:51.27,0:05:52.49,Default,,0,0,0,,Мен іздедім.
Dialogue: 0,0:05:51.33,0:05:52.62,Default-ja,,0,0,0,,Іздеу...
Dialogue: 0,0:05:57.05,0:05:58.67,Default-ja,,0,0,0,,Мен түсіндім
Dialogue: 5,0:05:57.05,0:05:58.71,Default,,0,0,0,,Сосын мен бір нәрсені түсіндім.
Dialogue: 5,0:05:59.63,0:06:01.91,Default,,0,0,0,,Менің оған немқұрайлы қарағаным...
Dialogue: 0,0:05:59.71,0:06:01.88,Default-ja,,0,0,0,,Оны да жалап алды.
Dialogue: 5,0:06:03.20,0:06:09.17,Default,,0,0,0,,Қаншалықты қателескенімді енді ғана түсіндім және менің ренжігенім...
Dialogue: 0,0:06:03.26,0:06:04.59,Default-ja,,0,0,0,,Ал қазір—
Dialogue: 0,0:06:05.43,0:06:09.10,Default-ja,,0,0,0,,Соны кейде байқап қалыппын.
Dialogue: 5,0:06:10.89,0:06:15.32,Default,,0,0,0,,Ол мұның бәрін көрді.
Dialogue: 0,0:06:10.89,0:06:12.35,Default-ja,,0,0,0,,Бұл адам бәрі
Dialogue: 0,0:06:13.31,0:06:15.02,Default-ja,,0,0,0,,Барлығын көргеннен кейін—
Dialogue: 5,0:06:15.91,0:06:19.22,Default,,0,0,0,,Сонда да ол сонда үнсіз отыр.
Dialogue: 0,0:06:15.94,0:06:19.19,Default-ja,,0,0,0,,Міне осылай тыныш отырасың.
Dialogue: 5,0:06:28.20,0:06:32.96,Default,,0,0,0,,Егер мен ренжігендіктен матчтың ортасында қашып кетсем,
Dialogue: 0,0:06:28.24,0:06:29.24,Default-ja,,0,0,0,,Қайда...
Dialogue: 0,0:06:29.58,0:06:32.87,Default-ja,,0,0,0,,Егер мен өзімнің ақымақтығым үшін жарты жолда қашып кетсем...
Dialogue: 5,0:06:32.96,0:06:38.21,Default,,0,0,0,,бұл шынымен өзімшілдік болар еді және ол мұны да біледі.
Dialogue: 0,0:06:33.16,0:06:34.25,Default-ja,,0,0,0,,Міне…
Dialogue: 0,0:06:34.87,0:06:38.29,Default-ja,,0,0,0,,Сөздің шын мағынасында өзімшілмін.
Dialogue: 0,0:06:46.73,0:06:49.23,signs,,0,0,0,,Шоги залы
Dialogue: 1,0:06:46.73,0:06:49.23,signs,,0,0,0,,Шоги залы
Dialogue: 5,0:06:53.02,0:06:59.36,Default,,0,0,0,,Осылайша мен соңғы шарасыздықты жойып, ойнауды жалғастырдым.
Dialogue: 0,0:06:53.02,0:06:54.39,Default-ja,,0,0,0,,Сонда мен—
Dialogue: 0,0:06:55.35,0:06:59.02,Default-ja,,0,0,0,,Бар шарасыздықты жинап, нұсқай бердім.
Dialogue: 5,0:07:00.15,0:07:04.98,Default,,0,0,0,,Бірақ мен мүлде қалпына келе алмай матч аяқталды.
Dialogue: 0,0:07:00.19,0:07:04.78,Default-ja,,0,0,0,,Бірақ... ойын ештеңе қалпына келтірілмей аяқталды.
Dialogue: 5,0:07:07.11,0:07:08.19,Default,,0,0,0,,Дәл солай! Ицумида!
Dialogue: 0,0:07:07.12,0:07:08.20,Default-ja,,0,0,0,,Және—
Dialogue: 5,0:07:10.55,0:07:12.47,Default,,0,0,0,,матчтан кейінгі шолу басталды.
Dialogue: 0,0:07:10.58,0:07:12.70,Default-ja,,0,0,0,,Әсер үшін шайқас басталды
Dialogue: 5,0:07:20.69,0:07:23.26,Default,,0,0,0,,Қашан болды?
Dialogue: 0,0:07:20.71,0:07:22.76,Default-ja,,0,0,0,,Қайдан… қайдан…
Dialogue: 5,0:07:25.12,0:07:26.26,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:25.13,0:07:26.26,Default-ja,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 5,0:07:27.01,0:07:29.64,Default,,0,0,0,,Неліктен осы жерден біраз қайталамасқа?
Dialogue: 0,0:07:27.01,0:07:29.76,Default-ja,,0,0,0,,Осы жерден аздап алға жылжайық.
Dialogue: 5,0:07:30.21,0:07:32.64,Default,,0,0,0,,R-5h бастап?
Dialogue: 0,0:07:30.22,0:07:32.68,Default-ja,,0,0,0,,5-сегізінші... Сол жерден?
Dialogue: 5,0:07:33.31,0:07:38.15,Default,,0,0,0,,Ол оны бірден орнатты, бұл бұрылыс нүктесі болуы керек.
Dialogue: 0,0:07:33.31,0:07:35.52,Default-ja,,0,0,0,,Олардың бірден реттелгені мынаны білдіреді:
Dialogue: 0,0:07:35.60,0:07:38.10,Default-ja,,0,0,0,,Бұл жолдың бұрылысы еді.
Dialogue: 5,0:07:38.90,0:07:39.77,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:07:38.90,0:07:39.77,Default-ja,,0,0,0,,Бірақ...
Dialogue: 0,0:07:40.57,0:07:42.48,Default-ja,,0,0,0,,Бұл... осы жерден?
Dialogue: 5,0:07:40.59,0:07:42.65,Default,,0,0,0,,F-осы жерден?
Dialogue: 0,0:07:43.32,0:07:44.94,Default-ja,,0,0,0,,Осы жерден?
Dialogue: 5,0:07:43.33,0:07:44.91,Default,,0,0,0,,Осындай басқарма күйінен?
Dialogue: 5,0:07:46.28,0:07:49.04,Default,,0,0,0,,Ол кезде мен үшін нашар болды ма?
Dialogue: 0,0:07:46.32,0:07:48.87,Default-ja,,0,0,0,,Сіз қазірдің өзінде нашарлап кетті дейсіз бе?
Dialogue: 5,0:07:50.16,0:07:52.54,Default,,0,0,0,,Жарайды, егер мен P*5d ойнасам ше?
Dialogue: 0,0:07:50.20,0:07:52.58,Default-ja,,0,0,0,,Сонымен, 5 және 4 қадамдар ше?
Dialogue: 0,0:07:57.54,0:07:58.75,Default-ja,,0,0,0,,Бірдей ақша
Dialogue: 5,0:07:57.57,0:07:58.95,Default,,0,0,0,,Gx5d.
Dialogue: 5,0:07:59.76,0:08:01.38,Default,,0,0,0,,Sx5d.
Dialogue: 0,0:07:59.79,0:08:01.00,Default-ja,,0,0,0,,Дәл сол банк
Dialogue: 5,0:08:02.52,0:08:04.02,Default,,0,0,0,,Sx5d.
Dialogue: 0,0:08:02.55,0:08:03.67,Default-ja,,0,0,0,,Дәл сол банк
Dialogue: 5,0:08:05.54,0:08:07.43,Default,,0,0,0,,B*2d.
Dialogue: 0,0:08:05.59,0:08:07.13,Default-ja,,0,0,0,,2 шаршы
Dialogue: 5,0:08:07.43,0:08:08.68,Default,,0,0,0,,Px2d.
Dialogue: 0,0:08:07.47,0:08:08.72,Default-ja,,0,0,0,,Дәл осындай қадам
Dialogue: 5,0:08:12.12,0:08:14.56,Default,,0,0,0,,Th-Егер мен мұны орнына істеген болсам...
Dialogue: 0,0:08:12.18,0:08:14.72,Default-ja,,0,0,0,,Ендеше... сонда былай болса ше?
Dialogue: 5,0:08:15.40,0:08:16.99,Default,,0,0,0,,P-1e.
Dialogue: 0,0:08:15.48,0:08:16.73,Default-ja,,0,0,0,,15 қадам
Dialogue: 0,0:08:18.56,0:08:19.52,Default-ja,,0,0,0,,Дәл осындай қадам
Dialogue: 5,0:08:18.58,0:08:20.24,Default,,0,0,0,,Px1e.
Dialogue: 5,0:08:20.24,0:08:22.40,Default,,0,0,0,,Сонда S-3e ше?
Dialogue: 0,0:08:20.40,0:08:22.11,Default-ja,,0,0,0,,3-ші күміс ше?
Dialogue: 5,0:08:23.67,0:08:25.18,Default,,0,0,0,,Sx3e.
Dialogue: 0,0:08:23.73,0:08:24.94,Default-ja,,0,0,0,,Дәл сол банк
Dialogue: 5,0:08:25.18,0:08:26.85,Default,,0,0,0,,Bx3e.
Dialogue: 0,0:08:25.24,0:08:26.57,Default-ja,,0,0,0,,Бірдей бұрыш
Dialogue: 5,0:08:26.85,0:08:29.04,Default,,0,0,0,,P-3g+.
Dialogue: 0,0:08:26.90,0:08:28.91,Default-ja,,0,0,0,,37 қадам
Dialogue: 0,0:08:29.61,0:08:31.12,Default-ja,,0,0,0,,1 бес хош иісті зат
Dialogue: 5,0:08:29.64,0:08:31.21,Default,,0,0,0,,L-1e.
Dialogue: 0,0:08:31.20,0:08:32.28,Default-ja,,0,0,0,,Дока
Dialogue: 5,0:08:31.21,0:08:32.45,Default,,0,0,0,,Lx1e.
Dialogue: 5,0:08:32.45,0:08:34.34,Default,,0,0,0,,P-3d.
Dialogue: 0,0:08:32.45,0:08:34.04,Default-ja,,0,0,0,,Үш және төрт қадам
Dialogue: 5,0:08:34.34,0:08:36.59,Default,,0,0,0,,S-4b.
Dialogue: 0,0:08:34.41,0:08:36.20,Default-ja,,0,0,0,,42 күміс
Dialogue: 5,0:08:36.59,0:08:42.91,Default,,0,0,0,,Th-Сонда P-1e, Px1e, P*6e ше?
Dialogue: 0,0:08:36.62,0:08:39.54,Default-ja,,0,0,0,,Ал... онда 15 қадам.
Dialogue: 0,0:08:39.87,0:08:41.00,Default-ja,,0,0,0,,Дәл осындай қадам
Dialogue: 0,0:08:41.50,0:08:42.84,Default-ja,,0,0,0,,6 бес қадам дегеніміз не?
Dialogue: 5,0:08:42.91,0:08:48.57,Default,,0,0,0,,B-5g+, Sx5g, B-3g...
Dialogue: 0,0:08:42.92,0:08:44.71,Default-ja,,0,0,0,,5 жеті бұрыш
Dialogue: 0,0:08:45.00,0:08:46.17,Default-ja,,0,0,0,,Дәл сол банк
Dialogue: 0,0:08:46.51,0:08:48.42,Default-ja,,0,0,0,,3 жетібұрыш
Dialogue: 0,0:08:55.93,0:08:57.31,Default-ja,,0,0,0,,Толық жеңілу...
Dialogue: 5,0:08:55.94,0:08:57.56,Default,,0,0,0,,Толық жеңіліс.
Dialogue: 0,0:08:58.23,0:08:59.48,Default-ja,,0,0,0,,Ойын да
Dialogue: 5,0:08:58.26,0:09:01.44,Default,,0,0,0,,Сәйкестік те, менің көзқарасым да...
Dialogue: 0,0:08:59.98,0:09:01.35,Default-ja,,0,0,0,,Бұл көзқарас...
Dialogue: 5,0:09:06.81,0:09:09.37,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:09:06.90,0:09:09.24,Default-ja,,0,0,0,,Рахмет... Сізге көп рахмет
Dialogue: 0,0:09:15.12,0:09:17.41,Default-ja,,0,0,0,,Ұялғанымнан дауысым дірілдеп кетті.
Dialogue: 5,0:09:15.20,0:09:17.63,Default,,0,0,0,,Ұялғаным сонша, дауысым дірілдеп кетті.
Dialogue: 5,0:09:19.46,0:09:22.55,Default,,0,0,0,,Менің алдымда бәрі ақ-қара болып жыпылықтайды.
Dialogue: 0,0:09:19.54,0:09:22.63,Default-ja,,0,0,0,,Көз алдымдағы көрініс ақ-қара болып жарқ етті.
Dialogue: 5,0:09:24.68,0:09:26.47,Default,,0,0,0,,Менің түсінігім, бәрі...
Dialogue: 0,0:09:24.71,0:09:26.30,Default-ja,,0,0,0,,Оқу және бәрі
Dialogue: 0,0:09:28.13,0:09:28.97,Default-ja,,0,0,0,,Менің...
Dialogue: 5,0:09:28.19,0:09:28.97,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 5,0:09:30.22,0:09:31.60,Default,,0,0,0,,толығымен жоғалды.
Dialogue: 0,0:09:30.43,0:09:31.59,Default-ja,,0,0,0,,Атуға үлгермей тұрып байқап қалды.
Dialogue: 0,0:09:35.43,0:09:38.10,Default-ja,,0,0,0,,Уа, жүгіріп жатыр, жүгіріп келеді
Dialogue: 5,0:09:36.36,0:09:37.98,Default,,0,0,0,,Оған қараңдаршы.
Dialogue: 0,0:09:38.43,0:09:39.85,Default-ja,,0,0,0,,О, Смит
Dialogue: 5,0:09:38.44,0:09:39.99,Default,,0,0,0,,О, Смит.
Dialogue: 0,0:09:39.93,0:09:41.44,Default-ja,,0,0,0,,Бүгін ше?
Dialogue: 5,0:09:39.99,0:09:41.43,Default,,0,0,0,,Күте тұрыңыз, сізде...
Dialogue: 5,0:09:41.43,0:09:43.75,Default,,0,0,0,,Жоқ, бұл жерде аздап жаттығамын.
Dialogue: 0,0:09:41.52,0:09:43.40,Default-ja,,0,0,0,,Жоқ, мен біраз жаттығу жасағым келеді.
Dialogue: 5,0:09:43.75,0:09:46.64,Default,,0,0,0,,Исса екеуміз сіздің матчыңызды талқыладық.
Dialogue: 0,0:09:43.86,0:09:46.19,Default-ja,,0,0,0,,Мен бұл туралы біраз уақыт бұрын ойладым.
Dialogue: 5,0:09:46.64,0:09:49.24,Default,,0,0,0,,Мен Кирияма үшін ренжідім.
Dialogue: 0,0:09:46.73,0:09:48.94,Default-ja,,0,0,0,,Тұзды, Кирияма-кун.
Dialogue: 5,0:09:59.71,0:10:07.12,Default,,0,0,0,,Тәжірибесіздігінен ол қарсыласының шеберлігіне қате баға берді, есеңгіреп қалды, енді бәрін жоғалтқандай сезінеді.
Dialogue: 0,0:09:59.75,0:10:03.33,Default-ja,,0,0,0,,Тәжірибе ұпайларының болмауына байланысты қарсыластың қабілетін қате оқу
Dialogue: 0,0:10:03.58,0:10:06.88,Default-ja,,0,0,0,,Мен өзімді желге ұшырып, толығымен ашылғандай сезінемін.
Dialogue: 5,0:10:08.17,0:10:10.51,Default,,0,0,0,,I totally get it. The rashness of youth.
Dialogue: 0,0:10:08.17,0:10:09.59,Default-ja,,0,0,0,,Мен түсіндім, түсінемін
Dialogue: 0,0:10:09.67,0:10:12.34,Default-ja,,0,0,0,,Youthful rashness
Dialogue: 5,0:10:11.00,0:10:12.43,Default,,0,0,0,,How embarrassing.
Dialogue: 0,0:10:12.47,0:10:16.26,Default-ja,,0,0,0,,Уау, о, солай істейік.
Dialogue: 5,0:10:13.26,0:10:14.76,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 5,0:10:15.12,0:10:21.04,Default,,0,0,0,,Осы матчқа дейін бұл панк тек Готу мен сіздің матч жазбаларыңыздың көшірмелерін жасаған.
Dialogue: 0,0:10:16.35,0:10:19.14,Default-ja,,0,0,0,,Ойын алдында Гото мырза мен Шимада мырзаның ойын жазбалары.
Dialogue: 0,0:10:19.22,0:10:20.89,Default-ja,,0,0,0,,Мен көшірме жасамадым.
Dialogue: 0,0:10:20.98,0:10:23.94,Default-ja,,0,0,0,,Хахаха... Әйтеуір, солай.
Dialogue: 5,0:10:22.27,0:10:28.03,Default,,0,0,0,,Мен ол Готудың жиырма матчты қалай ойнағанына назар аударғанына сенімдімін, бірақ мен бес ойын ғана ойнадым.
Dialogue: 0,0:10:24.23,0:10:29.07,Default-ja,,0,0,0,,Гото мырзада 20 ойын бар, ал менде 5 ойын бар хахаха
Dialogue: 0,0:10:28.03,0:10:35.54,signs,,0,0,0,,Ағаштан ою
Dialogue: 1,0:10:28.03,0:10:35.54,signs,,0,0,0,,Wood carving
Dialogue: 0,0:10:30.69,0:10:31.86,Default-ja,,0,0,0,,Түсіндім!
Dialogue: 5,0:10:30.71,0:10:32.45,Default,,0,0,0,,What, I'm right?!
Dialogue: 5,0:10:32.45,0:10:35.54,Default,,0,0,0,,Ой, мына бала мені ренжітті.
Dialogue: 0,0:10:32.70,0:10:35.16,Default-ja,,0,0,0,,Ой, маған ашуланба, анау бала.
Dialogue: 5,0:10:35.94,0:10:39.95,Default,,0,0,0,,Жарайды, мен бұрын да осындай әрекет жасадым.
Dialogue: 0,0:10:35.95,0:10:39.83,Default-ja,,0,0,0,,Ал, мен бұған дейін де осындай әрекет жасағанмын.
Dialogue: 5,0:10:39.95,0:10:42.38,Default,,0,0,0,,Бұл соншалықты айқын болмаса да.
Dialogue: 0,0:10:39.95,0:10:42.37,Default-ja,,0,0,0,,Бұл анық емес еді.
Dialogue: 5,0:10:42.38,0:10:45.73,Default,,0,0,0,,Иә, иә. Everyone has. Біраз, бәрібір.
Dialogue: 0,0:10:42.46,0:10:45.50,Default-ja,,0,0,0,,Жақсы, әркім белгілі бір дәрежеде жасайды.
Dialogue: 5,0:10:45.73,0:10:47.86,Default,,0,0,0,,Мен мұны қашан істегенімді есіме түсіргім келмейді.
Dialogue: 0,0:10:45.75,0:10:47.75,Default-ja,,0,0,0,,Оны есіме түсіргім де келмейді.
Dialogue: 5,0:10:49.78,0:10:52.13,Default,,0,0,0,,Сонда сізде келесі Gotou бар, иә?
Dialogue: 0,0:10:49.80,0:10:51.80,Default-ja,,0,0,0,,Next Mr. Goto.
Dialogue: 5,0:10:52.13,0:10:53.54,Default,,0,0,0,,Бар күшіңізді салыңыз.
Dialogue: 0,0:10:52.26,0:10:53.55,Default-ja,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 5,0:10:53.54,0:10:55.74,Default,,0,0,0,,Оның жүзі қорқынышты.
Dialogue: 0,0:10:53.63,0:10:54.59,Default-ja,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:54.68,0:10:55.64,Default-ja,,0,0,0,,Бет...
Dialogue: 5,0:10:55.74,0:10:58.28,Default,,0,0,0,,Иә. I want to win.
Dialogue: 0,0:10:55.80,0:10:57.97,Default-ja,,0,0,0,,А, мен жеңгім келеді.
Dialogue: 5,0:10:58.28,0:11:00.81,Default,,0,0,0,,Дегенмен оның жүзі қорқынышты.
Dialogue: 0,0:10:58.39,0:10:59.64,Default-ja,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:59.72,0:11:00.77,Default-ja,,0,0,0,,Дұрыс емес пе, Ято-но-ками?
Dialogue: 5,0:11:02.25,0:11:05.82,Default,,0,0,0,,Мен жеңгім келеді, сосын Соуяға қарсы ойнағым келеді.
Dialogue: 0,0:11:02.31,0:11:05.73,Default-ja,,0,0,0,,Мен жеңіп, Соямен ойнағым келеді...
Dialogue: 5,0:11:07.33,0:11:08.61,Default,,0,0,0,,The title match...
Dialogue: 0,0:11:07.40,0:11:08.56,Default-ja,,0,0,0,,Тақырып сәйкестігі
Dialogue: 5,0:11:14.56,0:11:17.08,Default,,0,0,0,,I'm starving. Бір жерде тоқтағың келе ме?
Dialogue: 0,0:11:14.57,0:11:16.82,Default-ja,,0,0,0,,Менің қарным ашты. Мен бір жерге тоқтауым керек пе?
Dialogue: 0,0:11:17.45,0:11:19.62,Default-ja,,0,0,0,,А... Мен сәл...
Dialogue: 5,0:11:18.48,0:11:19.71,Default,,0,0,0,,Менде бірдеңе бар...
Dialogue: 5,0:11:19.71,0:11:21.01,Default,,0,0,0,,Не, дос қыз?
Dialogue: 0,0:11:19.87,0:11:20.91,Default-ja,,0,0,0,,What is she?
Dialogue: 0,0:11:20.99,0:11:23.12,Default-ja,,0,0,0,,А, жоқ, олай емес...
Dialogue: 5,0:11:21.01,0:11:23.25,Default,,0,0,0,,Дұрыс емес...
Dialogue: 5,0:11:23.25,0:11:26.84,Default,,0,0,0,,Fine, then. Go on. Shoo, shoo.
Dialogue: 0,0:11:23.33,0:11:26.71,Default-ja,,0,0,0,,Әй, болды, жүр, жүр! Shh shush
Dialogue: 0,0:11:27.17,0:11:28.84,Default-ja,,0,0,0,,Aha, thank you.
Dialogue: 5,0:11:27.75,0:11:29.05,Default,,0,0,0,,Онда мен сені кейін көремін.
Dialogue: 5,0:11:29.05,0:11:31.18,Default,,0,0,0,,Good match today.
Dialogue: 0,0:11:29.09,0:11:31.00,Default-ja,,0,0,0,,Еңбегіңіз үшін рахмет~
Dialogue: 0,0:11:40.97,0:11:42.64,Default-ja,,0,0,0,,Hello, boy
Dialogue: 5,0:11:40.98,0:11:42.94,Default,,0,0,0,,Hello? Kiddo?
Dialogue: 5,0:11:42.94,0:11:44.37,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:11:42.97,0:11:44.27,Default-ja,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 5,0:11:46.14,0:11:47.36,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:11:46.14,0:11:47.15,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 5,0:11:48.09,0:11:50.55,Default,,0,0,0,,Yeah, I won. Uh-huh.
Dialogue: 0,0:11:48.10,0:11:49.65,Default-ja,,0,0,0,,Ah, I won.
Dialogue: 0,0:11:52.44,0:11:55.70,Default-ja,,0,0,0,,Түсіндім, сіз оны әлі интернеттен көрдіңіз бе?
Dialogue: 5,0:11:52.45,0:11:55.84,Default,,0,0,0,,Мен көремін. Сіз оны желіде көрдіңіз, иә?
Dialogue: 5,0:11:59.20,0:12:01.54,Default,,0,0,0,,Сонда да ол қызық жігіт.
Dialogue: 0,0:11:59.24,0:12:01.28,Default-ja,,0,0,0,,Бірақ бұл жігіт күлкілі.
Dialogue: 5,0:12:01.54,0:12:04.37,Default,,0,0,0,,Қыңырлық пен адалдықтың шатасуы.
Dialogue: 0,0:12:01.62,0:12:04.04,Default-ja,,0,0,0,,Қыңырлық пен мойынсұнушылықтың қиылысы.
Dialogue: 5,0:12:04.96,0:12:07.90,Default,,0,0,0,,Мен оның басын жарып жібергенімді білмеймін.
Dialogue: 0,0:12:05.00,0:12:07.71,Default-ja,,0,0,0,,Жарылып кетті ме, білмеймін.
Dialogue: 5,0:12:09.44,0:12:14.51,Default,,0,0,0,,Иә. Мен сенің не айтып тұрғаныңды түсіндім, балақай.
Dialogue: 0,0:12:09.50,0:12:11.84,Default-ja,,0,0,0,,Иә, баланың айтқаны...
Dialogue: 0,0:12:12.46,0:12:14.51,Default-ja,,0,0,0,,Мен аздап түсіндім деп ойлаймын.
Dialogue: 0,0:12:16.22,0:12:17.51,Default-ja,,0,0,0,,That's right.
Dialogue: 5,0:12:16.24,0:12:17.76,Default,,0,0,0,,Эй, менде бір идея бар.
Dialogue: 5,0:12:17.76,0:12:21.51,Default,,0,0,0,,Сіз оны семинарға шақыруымыз керек деп ойлайсыз ба?
Dialogue: 0,0:12:17.80,0:12:19.55,Default-ja,,0,0,0,,Мен сізді шақыруым керек пе?
Dialogue: 0,0:12:20.14,0:12:21.55,Default-ja,,0,0,0,,Оқу тобына…
Dialogue: 0,0:12:26.19,0:12:27.65,signs,,0,0,0,,Осы уақытта, Смиттің пәтерінде
Dialogue: 1,0:12:26.19,0:12:27.65,signs,,0,0,0,,Осы уақытта, Смиттің пәтерінде
Dialogue: 5,0:12:28.38,0:12:30.44,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:12:28.39,0:12:30.23,Default-ja,,0,0,0,,Мен үйдемін~
Dialogue: 5,0:12:33.91,0:12:36.39,Default,,0,0,0,,Strawberry!
Dialogue: 0,0:12:34.11,0:12:36.36,Default-ja,,0,0,0,,Strawberry chuwan
Dialogue: 5,0:12:36.39,0:12:38.79,Default,,0,0,0,,Кешіріңіз, мен сізді күттім! Time for num-nums!
Dialogue: 0,0:12:36.44,0:12:39.11,Default-ja,,0,0,0,,I've been waiting. Тамақ ішейік!
Dialogue: 5,0:12:39.46,0:12:40.54,Default,,0,0,0,,Kissy-kissy!
Dialogue: 0,0:12:39.49,0:12:40.62,Default-ja,,0,0,0,,Hmm, chut chut
Dialogue: 5,0:12:40.54,0:12:42.33,Default,,0,0,0,,Сіз сондай тәтті бәлішсіз!
Dialogue: 0,0:12:40.70,0:12:42.28,Default-ja,,0,0,0,,Don't be so cute!
Dialogue: 5,0:12:42.33,0:12:44.49,Default,,0,0,0,,Мені сағындың ба?
Dialogue: 0,0:12:42.37,0:12:44.08,Default-ja,,0,0,0,,Тотты кішкентай дечука~
Dialogue: 0,0:12:44.16,0:12:47.33,Default-ja,,0,0,0,,Me meow me...
Dialogue: 0,0:12:47.63,0:12:51.01,titles,,0,0,0,,Соқыр қараңғылық
Dialogue: 0,0:12:51.01,0:12:55.01,titles,,0,0,0,,Аз ғана су
Dialogue: 0,0:13:12.19,0:13:13.77,Default-ja,,0,0,0,,Оянғанда...
Dialogue: 5,0:13:12.22,0:13:19.65,Default,,0,0,0,,Мен ояу болсам, мен әр нәрсені ойлауды тоқтата алмадым, сондықтан мен ұйықтап, ұйықтадым.
Dialogue: 0,0:13:14.23,0:13:16.53,Default-ja,,0,0,0,,Өйткені мен көп нәрсені ойлаймын
Dialogue: 0,0:13:17.11,0:13:18.03,Default-ja,,0,0,0,,Мен ұйықтадым
Dialogue: 0,0:13:18.49,0:13:19.65,Default-ja,,0,0,0,,Мен көп ұйықтадым
Dialogue: 5,0:13:23.13,0:13:25.79,Default,,0,0,0,,Мен әрқашан Готуға қарсы шығамын деп ойладым.
Dialogue: 0,0:13:23.16,0:13:25.91,Default-ja,,0,0,0,,Готомен кездесемін деп ойладым...
Dialogue: 5,0:13:26.93,0:13:32.80,Default,,0,0,0,,Сондықтан мен қалыпты ұйықтаудың орнына, мен барлық уақытымды матч жазбаларын құюға жұмсадым.
Dialogue: 0,0:13:26.95,0:13:29.83,Default-ja,,0,0,0,,Соңғы кездері көп ұйықтамай жүрмін.
Dialogue: 0,0:13:29.91,0:13:32.33,Default-ja,,0,0,0,,Мен ойын жазбаларын үнемі зерттеп жүрдім, сондықтан...
Dialogue: 5,0:13:33.50,0:13:38.23,Default,,0,0,0,,Мен бірнеше күн бойы ішіп-жеуге немқұрайлы қарадым, сондықтан мен бөренелер сияқты құладым.
Dialogue: 0,0:13:33.50,0:13:34.63,Default-ja,,0,0,0,,Бірнеше күн
Dialogue: 0,0:13:35.09,0:13:38.30,Default-ja,,0,0,0,,Ішпей-жемей, лай боп ұйықтай бердім.
Dialogue: 0,0:13:53.23,0:13:54.23,Default-ja,,0,0,0,,Бірақ...
Dialogue: 5,0:13:53.24,0:13:57.75,Default,,0,0,0,,Бірақ қазір ұйықтау мүмкін емес болып қалды.
Dialogue: 0,0:13:54.56,0:13:57.69,Default-ja,,0,0,0,,Ақыры ұйықтау мүмкін болмады.
Dialogue: 0,0:14:12.54,0:14:14.04,Default-ja,,0,0,0,,А, мінеки...
Dialogue: 5,0:14:13.34,0:14:14.32,Default,,0,0,0,,Ой!
Dialogue: 5,0:14:14.32,0:14:16.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:14.38,0:14:17.25,Default-ja,,0,0,0,,Не... Бұл не?
Dialogue: 5,0:14:21.66,0:14:23.51,Default,,0,0,0,,Мен сусыздандым.
Dialogue: 0,0:14:21.72,0:14:23.47,Default-ja,,0,0,0,,Мен сусыздандым.
Dialogue: 5,0:14:24.14,0:14:26.85,Default,,0,0,0,,Егер мен суды қалпына келтіре алсам, симптомдар жойылар еді.
Dialogue: 0,0:14:24.18,0:14:26.80,Default-ja,,0,0,0,,Егер сіз сұйықтықты толтыра алсаңыз, ол жазылуы керек.
Dialogue: 0,0:14:27.05,0:14:29.81,Default-ja,,0,0,0,,Puh ha ha ha ha
Dialogue: 0,0:14:33.39,0:14:35.77,Default-ja,,0,0,0,,Goho oh goho
Dialogue: 0,0:14:35.86,0:14:39.86,Default-ja,,0,0,0,,Бірақ мен оны аузымнан ішсем де, қалыпты жағдайға оралады.
Dialogue: 5,0:14:35.89,0:14:40.21,Default,,0,0,0,,Бірақ мен ішкеннің бәрі сол күйінде шықты.
Dialogue: 0,0:14:42.36,0:14:43.32,Default-ja,,0,0,0,,шыдамсыз
Dialogue: 5,0:14:42.46,0:14:43.62,Default,,0,0,0,,Мен шошып кеттім.
Dialogue: 5,0:14:45.12,0:14:46.11,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:14:45.20,0:14:47.83,Default-ja,,0,0,0,,Бұл қорқынышты... Не істеуім керек?
Dialogue: 5,0:14:46.74,0:14:47.80,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 5,0:14:48.43,0:14:51.19,Default,,0,0,0,,Егер мен тағы да су жоғалтсам...
Dialogue: 0,0:14:48.45,0:14:51.08,Default-ja,,0,0,0,,Тағы су жоғалтсаңыз...
Dialogue: 5,0:14:56.44,0:15:04.62,Default,,0,0,0,,Спорттық сусынды бір шымшым тұзбен асықпай ішкенімді есіме түсірдім.
Dialogue: 0,0:14:56.46,0:14:58.25,Default-ja,,0,0,0,,Бұлыңғыр біліммен...
Dialogue: 0,0:14:58.54,0:15:01.34,Default-ja,,0,0,0,,Спорттық сусын және аздап тұз
Dialogue: 0,0:15:01.51,0:15:04.68,Default-ja,,0,0,0,,Баяу және баяу жалауды жалғастырыңыз.
Dialogue: 5,0:15:06.68,0:15:10.77,Default,,0,0,0,,Тұру үшін энергияны жинауға жарты күннен астам уақыт кетті.
Dialogue: 0,0:15:06.72,0:15:10.47,Default-ja,,0,0,0,,Тұруға жарты күннен астам уақыт кетті.
Dialogue: 0,0:15:11.56,0:15:16.06,Default-ja,,0,0,0,,Келесі күні мен ақыры жақын маңдағы дүкенге бардым.
Dialogue: 5,0:15:11.58,0:15:16.10,Default,,0,0,0,,Келесі күні мен жақын маңдағы дүкенге бардым.
Dialogue: 5,0:15:18.35,0:15:20.03,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:15:18.36,0:15:19.69,Default-ja,,0,0,0,,Хироко, неге осындай жағдайға жеттік?
Dialogue: 5,0:15:21.23,0:15:23.49,Default,,0,0,0,,Мен депрессияда тіпті қорқыныштымын.
Dialogue: 0,0:15:21.23,0:15:23.40,Default-ja,,0,0,0,,Мен құлауға да шебер емеспін.
Dialogue: 0,0:15:32.66,0:15:33.75,Default-ja,,0,0,0,,Сату
Dialogue: 5,0:15:32.67,0:15:37.80,Default,,0,0,0,,Бөлшек сауда, кеңсе жұмысы, бағдарламашы...
Dialogue: 0,0:15:34.58,0:15:35.54,Default-ja,,0,0,0,,Әкімшілік
Dialogue: 0,0:15:36.17,0:15:37.46,Default-ja,,0,0,0,,Бағдарламашы
Dialogue: 5,0:15:38.16,0:15:44.14,Default,,0,0,0,,Зал қызметкерлері, күзетші, жүргізуші, асхана қызметкерлері...
Dialogue: 0,0:15:38.17,0:15:39.46,Default-ja,,0,0,0,,Зал кезекшісі
Dialogue: 0,0:15:40.09,0:15:41.17,Default-ja,,0,0,0,,Қауіпсіздік
Dialogue: 0,0:15:41.25,0:15:42.46,Default-ja,,0,0,0,,Жүргізуші
Dialogue: 0,0:15:42.55,0:15:44.13,Default-ja,,0,0,0,,Аспаздық персонал
Dialogue: 5,0:15:44.14,0:15:48.33,Default,,0,0,0,,Жұмыстың түрлері өте көп.
Dialogue: 0,0:15:44.22,0:15:48.39,Default-ja,,0,0,0,,Дүниеде неше түрлі жұмыс бар.
Dialogue: 0,0:15:49.43,0:15:51.43,Default-ja,,0,0,0,,Бірақ барлығы дерлік...
Dialogue: 5,0:15:49.44,0:15:51.47,Default,,0,0,0,,Бірақ олардың барлығы дерлік...
Dialogue: 0,0:15:52.06,0:15:57.32,signs,,0,0,0,,Тәжірибе қажет емес!
Dialogue: 1,0:15:52.06,0:15:57.32,signs,,0,0,0,,Тәжірибе қажет емес!
Dialogue: 0,0:15:52.06,0:15:57.32,signs,,0,0,0,,*Орта мектеп түлектері (18 және одан жоғары)
Dialogue: 1,0:15:52.06,0:15:57.32,signs,,0,0,0,,*Орта мектеп түлектері (18 және одан жоғары)
Dialogue: 0,0:15:52.06,0:15:57.32,signs,,0,0,0,,Қалағаныңызша киініңіз
Dialogue: 1,0:15:52.06,0:15:57.32,signs,,0,0,0,,Қалағаныңызша киініңіз
Dialogue: 5,0:15:54.07,0:15:57.32,Default,,0,0,0,,Иә. Бұл табиғи нәрсе.
Dialogue: 0,0:15:54.10,0:15:57.06,Default-ja,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:57.81,0:15:59.98,Default-ja,,0,0,0,,Мектеп бітіруіне екі жыл қалды
Dialogue: 5,0:15:57.82,0:16:00.45,Default,,0,0,0,,Мен орта мектепті екі жылда бітіремін.
Dialogue: 5,0:16:00.45,0:16:05.57,Default,,0,0,0,,Осы уақытқа дейін мен сияқты студент жалдау ақысын төлей алатын жалғыз жол
Dialogue: 0,0:16:00.65,0:16:05.15,Default-ja,,0,0,0,,Осы уақытқа дейін студенттер жалдау ақысын төлеу үшін ақша табуы керек...
Dialogue: 5,0:16:06.39,0:16:09.96,Default,,0,0,0,,- шоги ойнауды жалғастыру.
Dialogue: 0,0:16:06.40,0:16:09.74,Default-ja,,0,0,0,,Өйткені, менде шоги ойнауды жалғастырудан басқа амал жоқ.
Dialogue: 5,0:16:11.93,0:16:15.90,Default,,0,0,0,,Менде сіріңкелердің көптігі сонша, мен мектепте тым көп күнді жіберіп алу қаупі бар.
Dialogue: 0,0:16:11.95,0:16:15.91,Default-ja,,0,0,0,,Ойындар көп, сондықтан мен қатыса алатын күндер саны қауіпті.
Dialogue: 5,0:16:16.53,0:16:19.25,Default,,0,0,0,,Бірақ мен кем дегенде орта мектепті бітіруім керек.
Dialogue: 0,0:16:16.58,0:16:19.13,Default-ja,,0,0,0,,Әйтеуір, ең болмағанда орта мектепте...
Dialogue: 5,0:16:29.95,0:16:33.46,Default,,0,0,0,,Осылайша мен өмірде өз жолымды таңдай аламын.
Dialogue: 0,0:16:29.97,0:16:33.35,Default-ja,,0,0,0,,Өз жолымды таңдай білу
Dialogue: 5,0:16:36.57,0:16:39.32,Default,,0,0,0,,Мен де солай ойладым да, мектепке келдім.
Dialogue: 0,0:16:36.60,0:16:38.98,Default-ja,,0,0,0,,Мен мектепке келгенде...
Dialogue: 5,0:16:39.32,0:16:41.11,Default,,0,0,0,,Өтіңіз! Өткізіңіз!
Dialogue: 0,0:16:39.35,0:16:41.23,Default-ja,,0,0,0,,Иә өту Иә өту
Dialogue: 5,0:16:41.11,0:16:42.49,Default,,0,0,0,,Сандар командасы, міне!
Dialogue: 0,0:16:41.36,0:16:42.57,Default-ja,,0,0,0,,Биб тобы Осы жолмен!
Dialogue: 5,0:16:42.49,0:16:43.32,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:16:42.65,0:16:44.32,Default-ja,,0,0,0,,Кеттік! (3-оқушы) О!
Dialogue: 5,0:16:43.32,0:16:44.32,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 5,0:16:44.82,0:16:46.41,Default,,0,0,0,,П.Е. бірден ?!
Dialogue: 0,0:16:44.86,0:16:46.36,Default-ja,,0,0,0,,Дене тәрбиесі кенеттен?
Dialogue: 5,0:16:47.33,0:16:48.83,Default,,0,0,0,,Ал баскетбол?!
Dialogue: 0,0:16:47.45,0:16:48.82,Default-ja,,0,0,0,,Ал баскетбол?
Dialogue: 0,0:16:49.16,0:16:51.16,Default-ja,,0,0,0,,Мен қайда болуым керек?
Dialogue: 5,0:16:49.18,0:16:50.95,Default,,0,0,0,,Мен қайда болуым керек?
Dialogue: 0,0:16:53.74,0:16:56.29,Default-ja,,0,0,0,,Әзірше көзге түспей жүгіріңіз...
Dialogue: 5,0:16:53.75,0:16:56.42,Default,,0,0,0,,Әзірше мен ерекшеленбеу үшін жүгіремін.
Dialogue: 0,0:16:56.37,0:16:58.41,Default-ja,,0,0,0,,Мм... бұл кім?
Dialogue: 5,0:16:56.42,0:16:57.56,Default,,0,0,0,,Мм, сен сонда!
Dialogue: 5,0:16:57.56,0:16:58.64,Default,,0,0,0,,Ол тағы кім болды?
Dialogue: 5,0:16:58.64,0:17:00.17,Default,,0,0,0,,Көзілдіріктің ішінде! Мұның бәрі сіздің қолыңызда!
Dialogue: 0,0:16:58.71,0:17:00.17,Default-ja,,0,0,0,,Көзілдірік таққан адам, өтінемін!
Dialogue: 5,0:17:00.17,0:17:01.17,Default,,0,0,0,,Не-не?!
Dialogue: 0,0:17:00.25,0:17:01.13,Default-ja,,0,0,0,,Иә?
Dialogue: 5,0:17:02.42,0:17:04.13,Default,,0,0,0,,Доп маған келді ме?!
Dialogue: 0,0:17:02.46,0:17:04.05,Default-ja,,0,0,0,,Е, доп келді.
Dialogue: 5,0:17:04.13,0:17:06.14,Default,,0,0,0,,Уф, мен не істеуім керек?
Dialogue: 0,0:17:04.30,0:17:06.01,Default-ja,,0,0,0,,Ал, мен не істеуім керек...
Dialogue: 5,0:17:06.14,0:17:07.30,Default,,0,0,0,,Себет ана жерде,
Dialogue: 0,0:17:06.21,0:17:07.72,Default-ja,,0,0,0,,Мақсат сонда.
Dialogue: 0,0:17:08.17,0:17:09.63,Default-ja,,0,0,0,,Біреуге рұқсат беру... т.б.
Dialogue: 5,0:17:08.18,0:17:09.93,Default,,0,0,0,,сондықтан оны біреуге беруім керек, солай ма?
Dialogue: 0,0:17:09.72,0:17:10.89,Default-ja,,0,0,0,,Келіңіздер!
Dialogue: 5,0:17:09.93,0:17:10.93,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:17:10.97,0:17:12.51,Default-ja,,0,0,0,,Уф... Гах!
Dialogue: 0,0:17:12.68,0:17:13.85,Default-ja,,0,0,0,,Ах, ақымақ!
Dialogue: 5,0:17:13.18,0:17:13.72,Default,,0,0,0,,Ақымақ!
Dialogue: 5,0:17:16.23,0:17:19.23,Default,,0,0,0,,Қарғыс атсын, Төрт көз! Не істеп жатырсың?!
Dialogue: 0,0:17:16.39,0:17:19.06,Default-ja,,0,0,0,,Эй, сен көзілдірігіңмен не істеп жатырсың?
Dialogue: 0,0:17:21.81,0:17:23.31,Default-ja,,0,0,0,,Шынымен...
Dialogue: 5,0:17:21.85,0:17:23.40,Default,,0,0,0,,Жақсы сұрақ.
Dialogue: 0,0:17:36.83,0:17:40.25,Default-ja,,0,0,0,,Шынымен, мен не істеп жатырмын?
Dialogue: 5,0:17:36.86,0:17:40.39,Default,,0,0,0,,Шынымен, мен не істеп жатырмын?
Dialogue: 5,0:17:46.87,0:17:49.90,Default,,0,0,0,,Жақсы емес. Мен ештеңенің дәмін татпаймын.
Dialogue: 0,0:17:46.88,0:17:47.96,Default-ja,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:48.21,0:17:49.67,Default-ja,,0,0,0,,Дәмі ештеңеге ұқсамайды.
Dialogue: 5,0:17:49.90,0:17:51.93,Default,,0,0,0,,Құмды шайнағандай.
Dialogue: 0,0:17:50.01,0:17:51.84,Default-ja,,0,0,0,,Құм Шайнап жатқан сияқты.
Dialogue: 0,0:17:53.68,0:17:57.22,Default-ja,,0,0,0,,Бұл оның шынымен қашып кетпегенін білдіре ме?
Dialogue: 5,0:17:53.73,0:17:57.81,Default,,0,0,0,,«Қашып кетпеу» деген осы ма?
Dialogue: 5,0:17:58.65,0:18:02.57,Default,,0,0,0,,Мен қашып кетпеу туралы естеліктерді алғым келді деп ойлаймын.
Dialogue: 0,0:17:58.68,0:18:02.39,Default-ja,,0,0,0,,Мен қашпағанымды есіме түсіргім келді.
Dialogue: 0,0:18:03.65,0:18:07.15,Default-ja,,0,0,0,,Мен қашып кетпеймін деп жүрсем ше?
Dialogue: 5,0:18:03.67,0:18:07.57,Default,,0,0,0,,Мен қашып кетпеймін деп жүрсем не істеймін?
Dialogue: 5,0:18:11.51,0:18:12.70,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:18:11.53,0:18:12.66,Default-ja,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 5,0:18:13.39,0:18:15.43,Default,,0,0,0,,Мен енді білмейтін сияқтымын.
Dialogue: 0,0:18:13.49,0:18:15.41,Default-ja,,0,0,0,,Мен енді бір нәрсені түсінбеймін
Dialogue: 5,0:18:17.03,0:18:18.44,Default,,0,0,0,,Бір нәрсе басқаша.
Dialogue: 0,0:18:17.03,0:18:18.29,Default-ja,,0,0,0,,Басқа нәрсе
Dialogue: 0,0:18:19.75,0:18:22.29,Default-ja,,0,0,0,,Ол мен ойлаған мектеп оқушысынан басқаша.
Dialogue: 5,0:18:19.83,0:18:22.37,Default,,0,0,0,,Мен өзім ойлаған орта мектеп оқушысы емеспін.
Dialogue: 5,0:18:24.73,0:18:28.70,Default,,0,0,0,,Мен оны жеңе аламын деп ойладым.
Dialogue: 0,0:18:24.75,0:18:28.88,Default-ja,,0,0,0,,Мен мұны дұрысырақ орындаймын деп ойладым.
Dialogue: 5,0:18:33.11,0:18:40.10,Default,,0,0,0,,Мен үйден шығып, пәтер ақысын төлеп, өзімді тамақтандырсам ба деп ойладым.
Dialogue: 0,0:18:33.13,0:18:34.89,Default-ja,,0,0,0,,Үйден жалғыз шық...
Dialogue: 0,0:18:35.34,0:18:36.89,Default-ja,,0,0,0,,Жалдау ақысын төлеңіз...
Dialogue: 0,0:18:37.35,0:18:39.60,Default-ja,,0,0,0,,Бір рет күрішті жеуге болады
Dialogue: 5,0:18:40.10,0:18:42.68,Default,,0,0,0,,Мен ересек болар едім.
Dialogue: 0,0:18:40.27,0:18:42.56,Default-ja,,0,0,0,,Мен ересек боламын деп ойладым.
Dialogue: 5,0:18:45.81,0:18:47.37,Default,,0,0,0,,Мен ересек болсам деп ойладым.
Dialogue: 0,0:18:45.86,0:18:47.31,Default-ja,,0,0,0,,Ересек болған кезде...
Dialogue: 5,0:18:53.40,0:18:58.44,Default,,0,0,0,,Мен енді жыламас едім.
Dialogue: 0,0:18:53.45,0:18:56.62,Default-ja,,0,0,0,,Мен енді жылаудың қажеті жоқ...
Dialogue: 0,0:18:57.20,0:18:58.45,Default-ja,,0,0,0,,Мен ойладым...
Dialogue: 5,0:19:02.00,0:19:03.67,Default,,0,0,0,,Кирияма!
Dialogue: 0,0:19:02.29,0:19:03.66,Default-ja,,0,0,0,,Кирияма
Dialogue: 5,0:19:03.67,0:19:04.55,Default,,0,0,0,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 5,0:19:04.55,0:19:06.42,Default,,0,0,0,,Не болды?! Сіз жылап жатырсыз!
Dialogue: 0,0:19:04.67,0:19:06.50,Default-ja,,0,0,0,,Не болды? мен жылап жатырмын
Dialogue: 0,0:19:06.42,0:19:06.46,signs,,0,0,0,,Гаххх!
