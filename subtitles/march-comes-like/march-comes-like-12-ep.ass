Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.12,0:00:15.21,OP,,0,0,0,,Өзеннің жағасында келе жатқан пойыздың дыбысы
Dialogue: 0,0:00:15.21,0:00:18.08,OP,,0,0,0,,Төменге қарап гүлдеген күнбағыстың түсі
Dialogue: 0,0:00:18.08,0:00:21.71,OP,,0,0,0,,Күннің батуы жолақты жиекке айналады
Dialogue: 0,0:00:23.93,0:00:30.72,OP,,0,0,0,,«Рахмет» деген сайын неге жылағым келеді?
Dialogue: 0,0:00:30.72,0:00:33.39,OP,,0,0,0,,Мен бала сияқтымын
Dialogue: 0,0:00:33.39,0:00:41.68,OP,,0,0,0,,Мен барлық көз жасымды тоңазытқышта қалдырдым деп ойладым
Dialogue: 0,0:00:41.68,0:00:46.54,OP,,0,0,0,,Қызыл ровер, қызыл ровер, сол қызды дәл жанына жібер
Dialogue: 0,0:00:46.91,0:00:49.59,OP,,0,0,0,,Қош бол, көруші
Dialogue: 0,0:00:49.59,0:00:52.29,OP,,0,0,0,,Біз жүре береміз
Dialogue: 0,0:00:52.29,0:00:59.72,OP,,0,0,0,,Бұл жолдың соңында аспан немесе басқа нәрсе болмаса да
Dialogue: 0,0:00:59.72,0:01:04.11,OP,,0,0,0,,Мен тек сенімен бірге болып, бірге күлкім келеді
Dialogue: 0,0:01:04.11,0:01:08.47,OP,,0,0,0,,Мақтаныш, тілек және үміт
Dialogue: 0,0:01:08.47,0:01:11.60,OP,,0,0,0,,Менде сіз сияқты олар әрқашан болады
Dialogue: 0,0:01:11.60,0:01:17.52,OP,,0,0,0,,Сіз қорқып, қатты қорқып, депрессияға түскенде
Dialogue: 0,0:01:17.52,0:01:23.45,OP,,0,0,0,,Мен сені қорғаймын, Мен сені әрқашан қолымда бар нәрсемен қорғаймын
Dialogue: 0,0:01:23.45,0:01:26.24,OP,,0,0,0,,Мен саған жүзіңе сөз беремін
Dialogue: 0,0:01:49.09,0:01:52.18,titles,,0,0,0,,Қарсы жағада не жатыр
Dialogue: 0,0:01:53.52,0:01:57.44,Default-ja,,0,0,0,,Үш күн өтті, денсаулығым қалпына келді.
Dialogue: 5,0:01:53.56,0:01:57.56,Default,,0,0,0,,Жаңа жылдың үшінші күнінен кейін денсаулығым қалпына келді.
Dialogue: 5,0:01:57.56,0:02:00.19,Default,,0,0,0,,Үйге келгеніме бірнеше күн өтті.
Dialogue: 0,0:01:57.69,0:02:00.06,Default-ja,,0,0,0,,Үйге келгеніме бірнеше күн болды.
Dialogue: 0,0:02:43.27,0:02:45.15,Default-ja,,0,0,0,,Ха… Хакушон
Dialogue: 0,0:02:50.36,0:02:51.99,Default-ja,,0,0,0,,Біз оның жайлы өте аз білеміз…
Dialogue: 5,0:02:50.38,0:02:51.94,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 5,0:02:55.33,0:02:57.33,Default,,0,0,0,,Екі күн бұрын,
Dialogue: 0,0:02:55.58,0:02:57.20,Default-ja,,0,0,0,,Бір күн бұрын
Dialogue: 5,0:03:00.12,0:03:02.58,Default,,0,0,0,,болды... Солай болды...
Dialogue: 0,0:03:00.12,0:03:02.33,Default-ja,,0,0,0,,Сонша, сонша...
Dialogue: 0,0:03:04.38,0:03:05.21,Default-ja,,0,0,0,,Сәлем!
Dialogue: 5,0:03:04.42,0:03:05.34,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 5,0:03:05.86,0:03:07.67,Default,,0,0,0,,Бұл өте жанды болды.
Dialogue: 0,0:03:06.00,0:03:07.67,Default-ja,,0,0,0,,Жанды болса да...
Dialogue: 5,0:03:15.85,0:03:16.93,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:15.89,0:03:16.72,Default-ja,,0,0,0,,Иә?
Dialogue: 5,0:03:16.93,0:03:20.98,Default,,0,0,0,,Кондиционер әрқашан осылай қатты болды ма?
Dialogue: 0,0:03:17.10,0:03:21.06,Default-ja,,0,0,0,,Кондиционер соншалықты қатты болды ма?
Dialogue: 5,0:03:32.81,0:03:35.57,Default,,0,0,0,,Сағат әрқашан сонша шулы болды ма?
Dialogue: 0,0:03:32.82,0:03:35.45,Default-ja,,0,0,0,,Сағат шынымен де қатты болды ма?
Dialogue: 5,0:03:49.41,0:03:50.09,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:49.55,0:03:50.38,Default-ja,,0,0,0,,Ұсыныс
Dialogue: 5,0:03:53.40,0:03:54.33,Default,,0,0,0,,Жаяу жүру.
Dialogue: 0,0:03:53.43,0:03:54.34,Default-ja,,0,0,0,,Жаяу
Dialogue: 5,0:03:55.95,0:03:56.60,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:03:55.97,0:03:57.01,Default-ja,,0,0,0,,№
Dialogue: 0,0:03:57.64,0:03:59.52,Default-ja,,0,0,0,,Мен бұл сезімді білемін
Dialogue: 5,0:03:57.68,0:03:59.47,Default,,0,0,0,,Мен бұл сезімді білемін.
Dialogue: 0,0:03:59.81,0:04:01.43,Default-ja,,0,0,0,,Бірақ көз тигізбеңіз
Dialogue: 5,0:03:59.85,0:04:01.48,Default,,0,0,0,,Бірақ мен оған көз жібере алмаймын.
Dialogue: 0,0:04:02.98,0:04:03.85,Default-ja,,0,0,0,,Жаяу
Dialogue: 5,0:04:03.10,0:04:03.98,Default,,0,0,0,,Жаяу.
Dialogue: 0,0:04:15.53,0:04:18.62,Default-ja,,0,0,0,,Мен білемін, бірақ есімді ойлама.
Dialogue: 5,0:04:15.61,0:04:18.52,Default,,0,0,0,,Мен оны білемін, бірақ бұл атауды ойламауым керек.
Dialogue: 5,0:04:18.99,0:04:21.24,Default,,0,0,0,,Мен бұл есімді айтсам,
Dialogue: 0,0:04:19.12,0:04:23.87,Default-ja,,0,0,0,,Сол есімді айтсаң, сені жұлып алатын соққы келеді.
Dialogue: 5,0:04:21.70,0:04:24.00,Default,,0,0,0,,Менің ішімді жыртатын соққы болады.
Dialogue: 0,0:04:29.80,0:04:32.09,Default-ja,,0,0,0,,Ойланба, жүр
Dialogue: 5,0:04:29.82,0:04:30.88,Default,,0,0,0,,Ойланба.
Dialogue: 5,0:04:31.16,0:04:32.38,Default,,0,0,0,,Жаяу.
Dialogue: 5,0:04:32.67,0:04:34.20,Default,,0,0,0,,P-2e.
Dialogue: 0,0:04:32.72,0:04:35.64,Default-ja,,0,0,0,,25 қадам 8 сегіз қырлы түзілімдер
Dialogue: 5,0:04:34.20,0:04:35.93,Default,,0,0,0,,Bx8h+.
Dialogue: 5,0:04:35.93,0:04:37.19,Default,,0,0,0,,Sx8h+.
Dialogue: 0,0:04:35.97,0:04:38.26,Default-ja,,0,0,0,,Сол күміс 22 күміс
Dialogue: 5,0:04:37.19,0:04:38.43,Default,,0,0,0,,S-2b.
Dialogue: 5,0:04:38.43,0:04:39.76,Default,,0,0,0,,S-4h.
Dialogue: 0,0:04:38.55,0:04:42.31,Default-ja,,0,0,0,,4 8 күміс 3 3 күміс 7 7 күміс
Dialogue: 5,0:04:39.76,0:04:41.16,Default,,0,0,0,,S-3c.
Dialogue: 5,0:04:41.16,0:04:42.39,Default,,0,0,0,,S-7g.
Dialogue: 5,0:04:43.10,0:04:44.39,Default,,0,0,0,,Мен тұрсам,
Dialogue: 0,0:04:43.10,0:04:44.48,Default-ja,,0,0,0,,Мен тоқтаған кезде...
Dialogue: 5,0:04:46.67,0:04:48.27,Default,,0,0,0,,Мен енді қозғала алмаймын.
Dialogue: 0,0:04:46.69,0:04:48.15,Default-ja,,0,0,0,,Кетіліп қалу
Dialogue: 0,0:04:50.90,0:04:54.40,Default-ja,,0,0,0,,Әй, кетті, сүт кетті.
Dialogue: 5,0:04:50.95,0:04:54.15,Default,,0,0,0,,Түсіру. Сүтіміз бітті.
Dialogue: 0,0:04:54.53,0:04:55.74,Default-ja,,0,0,0,,Жоқ, жоқ...
Dialogue: 5,0:04:54.60,0:04:58.32,Default,,0,0,0,,Қараңғы. Неліктен мен көбірек сатып алмадым?
Dialogue: 0,0:04:55.82,0:04:58.45,Default-ja,,0,0,0,,Мен неге көп сатып алмадым деп ойлаймын.
Dialogue: 5,0:04:58.32,0:05:00.22,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:04:58.53,0:05:02.37,Default-ja,,0,0,0,,Мен не істеуім керек? Сыртта шынымен суық көрінеді.
Dialogue: 5,0:05:00.22,0:05:02.49,Default,,0,0,0,,Сыртта қатып тұрғанына бәс тігемін.
Dialogue: 0,0:05:02.45,0:05:03.96,Default-ja,,0,0,0,,Мен оны сатып аламын.
Dialogue: 5,0:05:02.49,0:05:04.03,Default,,0,0,0,,Мен барып сатып аламын.
Dialogue: 5,0:05:04.03,0:05:06.67,Default,,0,0,0,,Мүмкін емес. Сенің суығың қайтып келер еді.
Dialogue: 0,0:05:04.04,0:05:06.75,Default-ja,,0,0,0,,Жоқ! Менің суығым қайтады
Dialogue: 5,0:05:06.67,0:05:09.13,Default,,0,0,0,,Жылытылған үстелдер қорқынышты, иә?
Dialogue: 0,0:05:06.87,0:05:09.04,Default-ja,,0,0,0,,Окота қорқынышты, солай емес пе?
Dialogue: 5,0:05:09.13,0:05:11.67,Default,,0,0,0,,Бірінің астына отырсаң, кете алмайсың.
Dialogue: 0,0:05:09.17,0:05:11.92,Default-ja,,0,0,0,,Бір кіргеннен кейін шыға алмайсың.
Dialogue: 0,0:05:12.17,0:05:15.26,Default-ja,,0,0,0,,Ішінде шынымен де жылы сезіледі...
Dialogue: 5,0:05:12.18,0:05:14.92,Default,,0,0,0,,Сіз оның астында болсаңыз, ол сізді шынымен жылытады,
Dialogue: 0,0:05:15.34,0:05:18.55,Default-ja,,0,0,0,,Мен шыққанда үш есе суық болды.
Dialogue: 5,0:05:15.35,0:05:18.68,Default,,0,0,0,,бірақ тұрғанда үш есе суық болады.
Dialogue: 5,0:05:20.68,0:05:24.68,Default,,0,0,0,,Не болатынын білесің, бірақ одан қалыс қала алмайсың, иә?
Dialogue: 0,0:05:20.81,0:05:24.56,Default-ja,,0,0,0,,Білемін, бірақ ішке кірмей тұра алмаймын.
Dialogue: 5,0:05:26.43,0:05:29.25,Default,,0,0,0,,Дұрыс? Айтайын дегенім, өте жылы.
Dialogue: 0,0:05:26.44,0:05:31.02,Default-ja,,0,0,0,,Ей, мен жылы және бақыттымын.
Dialogue: 5,0:05:29.25,0:05:31.19,Default,,0,0,0,,Және бұл сізді бақытты етеді.
Dialogue: 5,0:05:35.44,0:05:36.44,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:05:35.53,0:05:40.70,Default-ja,,0,0,0,,Иә, ол үй котацуға ұқсайды.
Dialogue: 5,0:05:37.13,0:05:40.74,Default,,0,0,0,,Олардың үйі жылытылатын үстел сияқты.
Dialogue: 5,0:05:43.29,0:05:47.96,Default,,0,0,0,,Ішке кірсем, жылы әрі жайлы болғаны сонша, еріп кете жаздадым.
Dialogue: 0,0:05:43.33,0:05:44.62,Default-ja,,0,0,0,,Ішінде болғанда—
Dialogue: 0,0:05:44.70,0:05:47.83,Default-ja,,0,0,0,,Ол өте жылы және ыңғайлы.
Dialogue: 0,0:05:52.46,0:05:56.30,Default-ja,,0,0,0,,Көшеге шықсам, осы уақытқа дейін қалыпты болған күнделікті өмірім...
Dialogue: 5,0:05:52.48,0:05:58.47,Default,,0,0,0,,Бірақ мен кеткенде, мен бұрын жақсы болған күнделікті өмірдің шынымен аязды екенін түсінемін.
Dialogue: 0,0:05:56.38,0:06:00.60,Default-ja,,0,0,0,,Оның шынымен суық жер екенін түсіндім.
Dialogue: 5,0:05:58.94,0:06:00.72,Default,,0,0,0,,Мен бұл фактіні еске түсірдім.
Dialogue: 0,0:06:03.64,0:06:08.10,Default-ja,,0,0,0,,Терең ойласам, қорқып, тұла бойым суып кетеді.
Dialogue: 5,0:06:03.69,0:06:08.23,Default,,0,0,0,,Мен бұл туралы терең ойласам, қорқатыным сонша, бүкіл денем қалтырап кетеді.
Dialogue: 0,0:06:08.64,0:06:09.48,Default-ja,,0,0,0,,Бірақ...
Dialogue: 5,0:06:08.70,0:06:09.48,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 5,0:06:12.22,0:06:14.18,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:12.23,0:06:13.61,Default-ja,,0,0,0,,Мен не істеуім керек?
Dialogue: 5,0:06:14.18,0:06:16.48,Default,,0,0,0,,Мен сенімді емеспін, бірақ мен бұл туралы ойлануым керек.
Dialogue: 0,0:06:14.32,0:06:16.40,Default-ja,,0,0,0,,Мен білмеймін, бірақ бұл туралы ойлануым керек
Dialogue: 0,0:06:16.94,0:06:18.03,Default-ja,,0,0,0,,Сабыр сақта.
Dialogue: 5,0:06:16.96,0:06:18.07,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:06:19.03,0:06:21.66,Default-ja,,0,0,0,,Дұрыс, алдымен қазіргі жағдайды реттеп алайық.
Dialogue: 5,0:06:19.08,0:06:21.74,Default,,0,0,0,,Дұрыс. Мен қазіргі жағдайды сұрыптаудан бастау керек.
Dialogue: 5,0:06:23.44,0:06:28.00,Default,,0,0,0,,Дәл қазір ойымды қойып, бір орында тұрсам, тығырыққа тірелемін.
Dialogue: 0,0:06:23.45,0:06:26.58,Default-ja,,0,0,0,,Ойлауды қазір қойып, тоқтатсаңыз...
Dialogue: 0,0:06:26.75,0:06:27.87,Default-ja,,0,0,0,,Тұйыққа тірелу
Dialogue: 0,0:06:30.42,0:06:32.96,Default-ja,,0,0,0,,Осы маусымда тек үш рейтингтік ойын бар.
Dialogue: 5,0:06:30.43,0:06:33.21,Default,,0,0,0,,Осы маусымда менде тағы үш сыныптық матч бар.
Dialogue: 5,0:06:33.21,0:06:35.39,Default,,0,0,0,,Қазіргі уақытта менің рекордым – төрт жеңіс және үш жеңіліс.
Dialogue: 0,0:06:33.34,0:06:35.25,Default-ja,,0,0,0,,Осы уақытқа дейін 4 жеңіс, 3 жеңіліс
Dialogue: 5,0:06:35.39,0:06:40.51,Default,,0,0,0,,Мен осы маусымда сабаққа бара алмаймын, бірақ мен жолға оралуым керек, содан кейін оны келесі жылы жалғастыруым керек.
Dialogue: 0,0:06:35.42,0:06:37.38,Default-ja,,0,0,0,,Енді жарнамалар болмайды, бірақ...
Dialogue: 0,0:06:37.55,0:06:40.34,Default-ja,,0,0,0,,Мен қайтадан жолға түсіп, келесі жылы тырысуым керек.
Dialogue: 5,0:06:41.41,0:06:42.89,Default,,0,0,0,,Содан кейін тақырып сәйкес келеді.
Dialogue: 0,0:06:41.43,0:06:42.76,Default-ja,,0,0,0,,Және титулдық күрес
Dialogue: 0,0:06:50.19,0:06:52.56,Default-ja,,0,0,0,,Жеңіске жеткен жалғыз нәрсе...
Dialogue: 5,0:06:50.20,0:06:55.25,Default,,0,0,0,,Мен ұтатын жалғыз нәрсе келесі аптада келеді.
Dialogue: 0,0:06:52.65,0:06:57.24,Default-ja,,0,0,0,,Келесі аптада Шишиох қарсыласын анықтау турнирі өтеді
Dialogue: 5,0:06:55.25,0:06:57.36,Default,,0,0,0,,Арыстан патша турнирінің іріктеу кезеңі.
Dialogue: 0,0:06:59.20,0:07:01.82,Default-ja,,0,0,0,,Әзірге осыған тоқталайық.
Dialogue: 5,0:06:59.25,0:07:01.99,Default,,0,0,0,,Әзірше мен осыған назар аударуым керек.
Dialogue: 0,0:07:02.66,0:07:04.37,Default-ja,,0,0,0,,Егер жеңістер саны азайса —
Dialogue: 5,0:07:02.67,0:07:08.18,Default,,0,0,0,,Егер мен сонша матчта жеңіске жетуді тоқтатсам, мен өз орнымды жоғалтамын, дәл солай.
Dialogue: 0,0:07:04.83,0:07:08.25,Default-ja,,0,0,0,,Бір күні мен орнымды оңай жоғалтамын
Dialogue: 5,0:07:09.37,0:07:11.12,Default,,0,0,0,,Бұл бір нәрсе...
Dialogue: 0,0:07:09.62,0:07:13.00,Default-ja,,0,0,0,,Бұл мүлдем... мүлде жоқ!
Dialogue: 5,0:07:11.88,0:07:13.12,Default,,0,0,0,,Мен бұған жол бермеймін!
Dialogue: 0,0:07:16.55,0:07:17.80,Default-ja,,0,0,0,,Арыстан патшаның шайқасы...
Dialogue: 5,0:07:16.59,0:07:17.59,Default,,0,0,0,,«Арыстан патша» турнирі.
Dialogue: 0,0:07:18.92,0:07:22.59,Default-ja,,0,0,0,,Бұл газет компаниясының демеушілігімен Жапониядағы ең үлкен шоги турнирі болды.
Dialogue: 5,0:07:19.05,0:07:22.05,Default,,0,0,0,,Бұл Жапониядағы ең үлкен газет демеушілік ететін шоги турнирі.
Dialogue: 5,0:07:22.75,0:07:25.80,Default,,0,0,0,,Бұл және Мастер турнирі екі негізгі титулдық турнир болып табылады.
Dialogue: 0,0:07:22.76,0:07:25.56,Default-ja,,0,0,0,,Бұл Мейжинсенмен бірге екі негізгі атаудың бірі.
Dialogue: 5,0:07:26.87,0:07:31.81,Default,,0,0,0,,Турнирде өткен жылғы рекордтар бойынша бөлінген алты ойыншы тобы бар.
Dialogue: 0,0:07:26.89,0:07:29.98,Default-ja,,0,0,0,,Өткен жылға дейінгі алған бағалары бойынша 6 топқа бөлінеді.
Dialogue: 0,0:07:30.06,0:07:31.98,Default-ja,,0,0,0,,Турнир өткізілді
Dialogue: 5,0:07:32.17,0:07:36.06,Default,,0,0,0,,Негізгі турнирге әр сыныптың жоғары дәрежелі ойыншылары қатыса алады.
Dialogue: 0,0:07:32.19,0:07:35.94,Default-ja,,0,0,0,,Әр сыныптағы үздік ойыншылар негізгі турнирге қатыса алады
Dialogue: 0,0:07:37.98,0:07:40.70,Default-ja,,0,0,0,,Қайырлы таң (нөл) Қайырлы таң
Dialogue: 5,0:07:38.04,0:07:40.61,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:07:41.61,0:07:46.28,Default-ja,,0,0,0,,Демеушілер саны көп болғандықтан, басқа шоги турнирлеріне қарағанда ауқымы үлкен.
Dialogue: 5,0:07:41.69,0:07:46.39,Default,,0,0,0,,Оның үлкен демеушілері болғандықтан, ауқымы басқа шоги турнирлеріне қарағанда әлдеқайда үлкен,
Dialogue: 5,0:07:46.39,0:07:48.99,Default,,0,0,0,,және ол бұқаралық ақпарат құралдарының назарын аударады.
Dialogue: 0,0:07:46.49,0:07:48.70,Default-ja,,0,0,0,,Көпшілік назарының жоғары деңгейі...
Dialogue: 5,0:07:48.99,0:07:52.17,Default,,0,0,0,,Әрине, бұл ойыншылардың да рухын көтереді.
Dialogue: 0,0:07:49.04,0:07:52.25,Default-ja,,0,0,0,,Олай болса... Әрине, ойыншылардың рухы көтеріледі.
Dialogue: 5,0:07:55.88,0:07:59.84,Default,,0,0,0,,Бірақ шоги ойыншыларын одан да қызықтыратын нәрсе...
Dialogue: 0,0:07:55.92,0:07:59.80,Default-ja,,0,0,0,,Бірақ одан да артық, шоги ойыншыларын құмар ететін себеп бар...
