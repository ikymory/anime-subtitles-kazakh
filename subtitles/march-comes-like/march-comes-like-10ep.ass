Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.84,0:00:19.75,OP,,0,0,0,,Сиқырлы заклинание есімде
Dialogue: 0,0:00:19.75,0:00:23.11,OP,,0,0,0,,Артынан кемпірқосақ аспанға созылғанда
Dialogue: 0,0:00:23.11,0:00:27.03,OP,,0,0,0,,Әп-сәтте әлемнің әр түкпірінде
Dialogue: 0,0:00:27.03,0:00:30.56,OP,,0,0,0,,Жарқын реңкке ие болды
Dialogue: 0,0:00:30.56,0:00:34.18,OP,,0,0,0,,Жүрегімнің үні
Dialogue: 0,0:00:34.18,0:00:37.69,OP,,0,0,0,,Әрқашан менің жүруім керек жолды жарықтандырады
Dialogue: 0,0:00:37.69,0:00:41.59,OP,,0,0,0,,Себебі мен бәріне күмәнданамын
Dialogue: 0,0:00:41.59,0:00:45.36,OP,,0,0,0,,Мен мұның рас екенін білемін
Dialogue: 0,0:00:45.36,0:00:49.07,OP,,0,0,0,,Менің жүрегім неге соғады?
Dialogue: 0,0:00:49.07,0:00:52.70,OP,,0,0,0,,Неліктен менің өкпем әлі де тыныс алады?
Dialogue: 0,0:00:52.70,0:00:56.33,OP,,0,0,0,,Неліктен кеудем құмарлықтан өртенеді?
Dialogue: 0,0:00:56.33,0:00:59.56,OP,,0,0,0,,Мұның бәрінің себебі бар
Dialogue: 0,0:00:59.92,0:01:03.05,OP,,0,0,0,,Және бұлттардың артына тығылған жұлдызды аспан сияқты
Dialogue: 0,0:01:03.33,0:01:05.71,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.71,0:01:05.83,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.83,0:01:05.96,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.96,0:01:06.08,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:06.08,0:01:06.22,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:06.95,0:01:10.36,OP,,0,0,0,,Мен дүниеге келгенге дейінгі дүние тарихы сияқты
Dialogue: 0,0:01:10.78,0:01:14.36,OP,,0,0,0,,Сіз жауапты менің қолымнан келмейді
Dialogue: 0,0:01:14.52,0:01:20.99,OP,,0,0,0,,Басқа ештеңе болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:21.87,0:01:28.57,OP,,0,0,0,,Басқа ешкім болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:41.75,0:01:44.01,titles,,0,0,0,,Берілген нәрсе (1-бөлім)
Dialogue: 0,0:02:00.55,0:02:01.39,Default-ja,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:04.81,0:02:05.98,Default-ja,,0,0,0,,желтоқсан
Dialogue: 5,0:02:04.83,0:02:06.22,Default,,0,0,0,,желтоқсан.
Dialogue: 5,0:02:06.22,0:02:08.53,Default,,0,0,0,,Рождество жақындағанда,
Dialogue: 0,0:02:06.31,0:02:08.31,Default-ja,,0,0,0,,Рождество жақындағанда
Dialogue: 0,0:02:08.85,0:02:11.23,Default-ja,,0,0,0,,Коко апам маған тағы телефон соқты.
Dialogue: 5,0:02:08.86,0:02:11.37,Default,,0,0,0,,Маған қамқоршы әпкем Киоуко тағы қоңырау шалды.
Dialogue: 5,0:02:12.78,0:02:14.29,Default,,0,0,0,,Сіз бірдеңені ұмыттыңыз ба?
Dialogue: 0,0:02:12.86,0:02:15.15,Default-ja,,0,0,0,,Бірдеңені жоғалттыңыз ба? сағат?
Dialogue: 5,0:02:14.29,0:02:15.54,Default,,0,0,0,,Сағат?
Dialogue: 0,0:02:22.03,0:02:24.20,Default-ja,,0,0,0,,There was
Dialogue: 5,0:02:23.30,0:02:23.96,Default,,0,0,0,,Міне.
Dialogue: 5,0:02:48.53,0:02:50.33,Default,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:02:48.77,0:02:49.85,Default-ja,,0,0,0,,Жақсы
Dialogue: 5,0:02:50.33,0:02:52.41,Default,,0,0,0,,Готу оны маған берді.
Dialogue: 0,0:02:50.48,0:02:52.44,Default-ja,,0,0,0,,Мен оны Готодан алдым.
Dialogue: 0,0:02:53.19,0:02:54.98,Default-ja,,0,0,0,,Олай етпесең, ұрысады.
Dialogue: 5,0:02:53.22,0:02:55.00,Default,,0,0,0,,Мен кимесем ашуланады.
Dialogue: 0,0:02:56.32,0:02:57.19,Default-ja,,0,0,0,,Хакш!
Dialogue: 5,0:02:57.20,0:02:59.82,Default,,0,0,0,,Эй, мен суық тиіп қалған шығармын.
Dialogue: 0,0:02:57.28,0:02:59.74,Default-ja,,0,0,0,,Мен суық тиіп алған шығармын деп ойлаймын.
Dialogue: 5,0:02:59.82,0:03:01.04,Default,,0,0,0,,Ал сен кінәлісің!
Dialogue: 0,0:02:59.82,0:03:01.03,Default-ja,,0,0,0,,Бұл сенің кінәң
Dialogue: 5,0:03:01.04,0:03:03.42,Default,,0,0,0,,Мен саған вокзал алдындағы Мек-де күт дедім.
Dialogue: 0,0:03:01.11,0:03:03.41,Default-ja,,0,0,0,,Сондықтан мен одан станцияның алдындағы машинада күтуін өтіндім...
Dialogue: 5,0:03:03.42,0:03:05.75,Default,,0,0,0,,Жоқ. Бұл жер өте шулы.
Dialogue: 0,0:03:03.49,0:03:06.04,Default-ja,,0,0,0,,Маған ол шулы жер ұнамайды.
Dialogue: 5,0:03:06.26,0:03:08.51,Default,,0,0,0,,Мен неге сенің үйіңе бара алмадым?
Dialogue: 0,0:03:06.29,0:03:08.50,Default-ja,,0,0,0,,Сен неге жақсы емессің?
Dialogue: 5,0:03:10.51,0:03:12.19,Default,,0,0,0,,«Неге»?
Dialogue: 0,0:03:10.71,0:03:12.08,Default-ja,,0,0,0,,(Кугисаки мен Итадори) Токио! Токио! Токио!
Dialogue: 5,0:03:17.34,0:03:21.06,Default,,0,0,0,,Рей, сен не ойлап тұрғаныңды тапсам қалай болады?
Dialogue: 0,0:03:17.34,0:03:20.88,Default-ja,,0,0,0,,Дәл қазір не ойлағаныңызды болжай аламын ба? Нөл
Dialogue: 0,0:03:23.14,0:03:24.26,Default-ja,,0,0,0,,Уау
Dialogue: 0,0:03:24.35,0:03:26.51,Default-ja,,0,0,0,,Әзіл, қорқынышты бет
Dialogue: 5,0:03:24.35,0:03:26.77,Default,,0,0,0,,Мен жай қалжыңдап тұрмын. Қорқынышты бет қажет емес.
Dialogue: 5,0:03:32.59,0:03:35.20,Default,,0,0,0,,Әй, сен Жаңа жылға не істеп жатырсың?
Dialogue: 0,0:03:32.60,0:03:35.19,Default-ja,,0,0,0,,Әй, жыл аяғында не істейсің?
Dialogue: 5,0:03:35.65,0:03:36.95,Default,,0,0,0,,Үйге келе жатырсың, солай ма?
Dialogue: 0,0:03:35.69,0:03:36.82,Default-ja,,0,0,0,,Сіз қайтып келесіз, солай ма?
Dialogue: 5,0:03:36.95,0:03:38.21,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:03:37.19,0:03:40.32,Default-ja,,0,0,0,,Жоқ, ойындар өте көп.
Dialogue: 5,0:03:38.21,0:03:40.29,Default,,0,0,0,,Менде көптеген матчтар бар,
Dialogue: 5,0:03:40.86,0:03:42.34,Default,,0,0,0,,сондықтан мен тәжірибеге назар аударуым керек.
Dialogue: 0,0:03:40.86,0:03:42.24,Default-ja,,0,0,0,,Себебі мен оқуым керек
Dialogue: 0,0:03:42.32,0:03:43.70,Default-ja,,0,0,0,,Ойын?
Dialogue: 5,0:03:42.34,0:03:43.75,Default,,0,0,0,,Сәйкестіктер?
Dialogue: 5,0:03:43.75,0:03:49.05,Default,,0,0,0,,Сіздің жылдағы соңғы матчыңыз 24-і күні Ясуиге қарсы класстық көтеріліс, солай ма?
Dialogue: 0,0:03:43.78,0:03:45.53,Default-ja,,0,0,0,,Биылғы ойыныңыз қандай?
Dialogue: 0,0:03:45.62,0:03:48.95,Default-ja,,0,0,0,,24-ші күні Ясуи мырзаға қарсы рейтингтік матч соңғысы болады, солай емес пе?
Dialogue: 5,0:03:50.34,0:03:51.73,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:03:50.41,0:03:53.04,Default-ja,,0,0,0,,Иә, Ясуи-сан туралы айтсақ.
Dialogue: 5,0:03:51.73,0:03:55.85,Default,,0,0,0,,Ясуи туралы айтсам, ол ақыры ажырасып жатқан сияқты.
Dialogue: 0,0:03:53.12,0:03:55.58,Default-ja,,0,0,0,,Ажырасу ақыры шешілген сияқты.
Dialogue: 5,0:03:55.85,0:03:58.83,Default,,0,0,0,,Ол әдетте қарапайым, момын жігіт.
Dialogue: 0,0:03:56.09,0:03:58.80,Default-ja,,0,0,0,,Мен әдетте әлсіз және әлсіз болсам да.
Dialogue: 5,0:03:58.83,0:04:01.47,Default,,0,0,0,,Бірақ жеңілген кезде ішеді, есінен танып қалады, құмар ойнайды.
Dialogue: 0,0:03:58.88,0:04:01.47,Default-ja,,0,0,0,,Жеңілгенде ішесің, жабайысың, құмар ойнайсың, солай ма?
Dialogue: 5,0:04:01.47,0:04:03.94,Default,,0,0,0,,Мен оның әйелінің осынша уақыт бойы шыдап жүргеніне таң қалдым.
Dialogue: 0,0:04:01.55,0:04:04.13,Default-ja,,0,0,0,,Әйеліңіз де осы уақытқа дейін шыдамды болды.
Dialogue: 5,0:04:04.81,0:04:07.32,Default,,0,0,0,,Мен оның қызын қатты аяймын.
Dialogue: 0,0:04:04.84,0:04:07.30,Default-ja,,0,0,0,,Бейшара қыз, солай ма?
Dialogue: 5,0:04:07.32,0:04:09.17,Default,,0,0,0,,Ол қорқып кеткен болуы керек.
Dialogue: 0,0:04:07.47,0:04:09.14,Default-ja,,0,0,0,,Бұл қорқынышты болса керек.
Dialogue: 5,0:04:09.17,0:04:14.11,Default,,0,0,0,,Менің айтайын дегенім, ол әкесі жеңілген сайын ренжіп тұратын әкесімен бір шаңырақтың астында тұрған.
Dialogue: 0,0:04:09.22,0:04:11.85,Default-ja,,0,0,0,,Жеңілген сайын басқа боп кететін әкеммен.
Dialogue: 0,0:04:11.93,0:04:14.27,Default-ja,,0,0,0,,Олар бір шаңырақ астында болды, солай ма?
Dialogue: 5,0:04:15.24,0:04:17.24,Default,,0,0,0,,Мен мұны жек көремін.
Dialogue: 0,0:04:15.52,0:04:17.23,Default-ja,,0,0,0,,саған бір нәрсені түсіндіргім келеді.
Dialogue: 5,0:04:17.24,0:04:20.08,Default,,0,0,0,,Бірақ қызының бір тілегі бар деп естідім.
Dialogue: 0,0:04:17.44,0:04:20.44,Default-ja,,0,0,0,,Бірақ, қызым айтты.
Dialogue: 0,0:04:20.94,0:04:24.11,Default-ja,,0,0,0,,Ол Рождествоға дейін әкесімен бірге болғысы келеді.
Dialogue: 5,0:04:20.95,0:04:23.79,Default,,0,0,0,,Ол: «Мен Рождествоға дейін әкеммен бірге болғым келеді», - деді.
Dialogue: 0,0:04:24.53,0:04:26.07,Default-ja,,0,0,0,,Мен оны қатты жек көремін
Dialogue: 5,0:04:24.54,0:04:27.13,Default,,0,0,0,,Мен бұған шыдай алмаймын...
Dialogue: 0,0:04:26.28,0:04:27.12,Default-ja,,0,0,0,,Бұл…
Dialogue: 5,0:04:27.13,0:04:30.13,Default,,0,0,0,,Көзіңе жас үйірмей ме?
Dialogue: 0,0:04:27.20,0:04:28.99,Default-ja,,0,0,0,,Бұл сізді жылатады.
Dialogue: 0,0:04:29.08,0:04:30.45,Default-ja,,0,0,0,,Мен «махаббат» ұғымы туралы ойланып жүрмін
Dialogue: 5,0:04:31.00,0:04:34.26,Default,,0,0,0,,Сөйлеу тәсілі, сөзі маған желімдей жабысады...
Dialogue: 0,0:04:31.12,0:04:34.08,Default-ja,,0,0,0,,Әпкемнің сөзі маған жабысады
Dialogue: 0,0:04:34.58,0:04:36.83,Default-ja,,0,0,0,,Эй Нөл, тыңдап тұрсың ба?
Dialogue: 5,0:04:34.59,0:04:36.59,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 5,0:04:37.22,0:04:38.26,Default,,0,0,0,,Бірақ бәрінен де көп...
Dialogue: 0,0:04:37.33,0:04:38.34,Default-ja,,0,0,0,,Ең бастысы...
Dialogue: 5,0:04:39.10,0:04:40.14,Default,,0,0,0,,Та-да!
Dialogue: 0,0:04:39.17,0:04:40.13,Default-ja,,0,0,0,,Эй...
Dialogue: 5,0:04:40.14,0:04:43.14,Default,,0,0,0,,...оның улы тамшылаған сөздері...
Dialogue: 0,0:04:40.21,0:04:42.76,Default-ja,,0,0,0,,Тіпті осындай улы сөздер
Dialogue: 5,0:04:44.12,0:04:45.18,Default,,0,0,0,,Шиш.
Dialogue: 5,0:04:47.81,0:04:49.94,Default,,0,0,0,,Орамалың ұшып кетеді.
Dialogue: 0,0:04:47.89,0:04:49.60,Default-ja,,0,0,0,,Глушитель ұшып кетеді.
Dialogue: 5,0:04:49.94,0:04:51.86,Default,,0,0,0,,Оны дұрыс орау керек.
Dialogue: 0,0:04:49.97,0:04:51.93,Default-ja,,0,0,0,,Егер сіз оны домалататын болсаңыз, оны дұрыс ораңыз.
Dialogue: 5,0:04:51.86,0:04:54.61,Default,,0,0,0,,Оларды тыңдағым келгені үшін өзімді жек көремін.
Dialogue: 0,0:04:52.14,0:04:54.56,Default-ja,,0,0,0,,Мен тыңдағым келетін адам
Dialogue: 5,0:04:55.99,0:04:58.68,Default,,0,0,0,,Балалар дөрекі.
Dialogue: 0,0:04:56.27,0:04:58.23,Default-ja,,0,0,0,,Балаларды аяймын.
Dialogue: 5,0:04:58.68,0:05:01.41,Default,,0,0,0,,Өйткені, олар ата-анасын таңдай алмайды.
Dialogue: 0,0:04:58.77,0:05:01.32,Default-ja,,0,0,0,,Себебі сен ата-анаңды таңдай алмайсың.
Dialogue: 0,0:05:03.28,0:05:05.57,Default-ja,,0,0,0,,А, бірақ иә.
Dialogue: 5,0:05:04.26,0:05:07.63,Default,,0,0,0,,Ойланып қарасаңыз, бұл сізге қатысы жоқ.
Dialogue: 0,0:05:05.74,0:05:07.53,Default-ja,,0,0,0,,Сіз қателескенсіз, солай емес пе?
Dialogue: 5,0:05:07.63,0:05:10.50,Default,,0,0,0,,Сіз өз ата-анаңызды таңдадыңыз.
Dialogue: 0,0:05:07.87,0:05:10.28,Default-ja,,0,0,0,,Ата-анаңды өзің таңдадың.
Dialogue: 0,0:05:10.78,0:05:13.37,Default-ja,,0,0,0,,Басқа біреудің үйінің әкесі.
Dialogue: 5,0:05:10.81,0:05:13.46,Default,,0,0,0,,Сіз біреудің әкесін таңдадыңыз.
Dialogue: 0,0:05:16.00,0:05:18.92,Default-ja,,0,0,0,,Уау, ахах...
Dialogue: 5,0:05:18.93,0:05:21.42,Default,,0,0,0,,Әй, әке, енді оларды аша аламыз ба?
Dialogue: 0,0:05:19.00,0:05:21.25,Default-ja,,0,0,0,,Әй, әке, қазір ашсам бола ма?
Dialogue: 5,0:05:21.42,0:05:22.93,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:05:21.50,0:05:22.80,Default-ja,,0,0,0,,О, жақсы.
Dialogue: 5,0:05:27.14,0:05:29.73,Default,,0,0,0,,Әй, мына алып қонжық несі?!
Dialogue: 0,0:05:27.18,0:05:29.55,Default-ja,,0,0,0,,Әй, не? бұл үлкен аю
