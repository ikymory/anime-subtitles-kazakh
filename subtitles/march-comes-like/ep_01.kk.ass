Dialogue: 1,0:14:24.27,0:14:24.31,signs,,0,0,0,,Масштабтау
Dialogue: 5,0:14:25.40,0:14:26.64,Default,,0,0,0,,Мен саған сүт жылытып берейін!
Dialogue: 0,0:14:25.43,0:14:26.55,Default-ja,,0,0,0,,Мен сені жылытамын.
Dialogue: 5,0:14:26.34,0:14:27.78,Default,,0,0,0,,Ух, мм...
Dialogue: 0,0:14:26.63,0:14:28.14,Default-ja,,0,0,0,,Сондай-ақ, дәрі-дәрмекті әкеліңіз.
Dialogue: 5,0:14:26.64,0:14:28.23,Default,,0,0,0,,Мен де дәрі әкелемін!
Dialogue: 0,0:14:33.98,0:14:35.89,Default-ja,,0,0,0,,Кешіріңіз...
Dialogue: 5,0:14:34.00,0:14:35.98,Default,,0,0,0,,Кешіріңіз.
Dialogue: 5,0:14:36.66,0:14:39.30,Default,,0,0,0,,Бәрі дұрыс. Барлығын жеудің қажеті жоқ.
Dialogue: 0,0:14:36.69,0:14:40.94,Default-ja,,0,0,0,,Ештеңе етпейді, сонда қалдыруға болады, асықпа.
Dialogue: 5,0:14:39.30,0:14:41.22,Default,,0,0,0,,Тек уақытыңызды алыңыз.
Dialogue: 5,0:14:41.22,0:14:42.87,Default,,0,0,0,,Бірақ аздап жеу керек.
Dialogue: 0,0:14:41.27,0:14:42.78,Default-ja,,0,0,0,,Бірақ аздап тамақтаныңыз.
Dialogue: 5,0:14:51.90,0:14:52.86,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:14:51.95,0:14:52.99,Default-ja,,0,0,0,,Иә
Dialogue: 5,0:15:00.88,0:15:02.39,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:15:01.13,0:15:02.25,Default-ja,,0,0,0,,О
Dialogue: 5,0:15:03.60,0:15:07.07,Default,,0,0,0,,Не, бала ұйықтап жатыр ма?
Dialogue: 0,0:15:03.63,0:15:06.97,Default-ja,,0,0,0,,Не, балам, ұйықтап қалдың ба?
Dialogue: 0,0:15:07.05,0:15:10.43,Default-ja,,0,0,0,,Бұл жаман мінез. Тамақ жеу керек пе, ұйықтау керек пе?
Dialogue: 5,0:15:07.07,0:15:08.75,Default,,0,0,0,,Дөрекі туралы айту.
Dialogue: 5,0:15:08.75,0:15:10.46,Default,,0,0,0,,Тамақтанып, басын изеді, солай ма?
Dialogue: 5,0:15:10.46,0:15:13.43,Default,,0,0,0,,Тамағын ішіп болған соң жатты.
Dialogue: 0,0:15:10.51,0:15:13.39,Default-ja,,0,0,0,,Тамақ ішіп болған соң, менде қос нүкте қалды.
Dialogue: 5,0:15:13.43,0:15:15.15,Default,,0,0,0,,Ол есінен танып қалғандай болды.
Dialogue: 0,0:15:13.47,0:15:15.10,Default-ja,,0,0,0,,Есімнен адасып кеткендей
Dialogue: 0,0:15:15.48,0:15:17.98,Default-ja,,0,0,0,,Ойын қалай өтті?
Dialogue: 5,0:15:15.54,0:15:18.14,Default,,0,0,0,,Ол қалай болды?
Dialogue: 5,0:15:18.14,0:15:19.69,Default,,0,0,0,,Ол жеңді, шамасы.
Dialogue: 0,0:15:18.19,0:15:22.07,Default-ja,,0,0,0,,Жеңіске жеткендей болдым, бірақ мұңаймай кірдім.
Dialogue: 5,0:15:19.69,0:15:22.31,Default,,0,0,0,,Бірақ ол мұнда келгенде бозарып кетті.
Dialogue: 5,0:15:22.31,0:15:24.41,Default,,0,0,0,,және ол әрең тамақтанды.
Dialogue: 0,0:15:22.40,0:15:24.32,Default-ja,,0,0,0,,Мен аз ғана күріш жедім.
Dialogue: 5,0:15:25.21,0:15:28.67,Default,,0,0,0,,Иә, оны кінәлай алмаймын.
Dialogue: 0,0:15:25.23,0:15:28.49,Default-ja,,0,0,0,,Хмм, бұл негізсіз емес деп ойлаймын.
Dialogue: 5,0:15:28.67,0:15:32.54,Default,,0,0,0,,Ол да кеше түнде ұйықтай алмады деп ойлаймын.
Dialogue: 0,0:15:28.70,0:15:32.53,Default-ja,,0,0,0,,Түсіндім, бәрібір кешке ұйықтай алмадым.
Dialogue: 5,0:15:32.90,0:15:36.14,Default,,0,0,0,,Жарайды, түнде осында демалсын.
Dialogue: 0,0:15:32.91,0:15:36.04,Default-ja,,0,0,0,,Маған бүгін ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:15:36.12,0:15:39.46,Default-ja,,0,0,0,,Жарайды, мен де сонда қайтайын.
Dialogue: 5,0:15:36.14,0:15:39.53,Default,,0,0,0,,Мен дүкенге қайтып барып, сонда ұйықтаймын.
Dialogue: 5,0:15:39.53,0:15:42.05,Default,,0,0,0,,Ертең бұршақ қуыратын күн.
Dialogue: 0,0:15:39.54,0:15:42.09,Default-ja,,0,0,0,,Ертең қызыл бұршақ пастасын пісіру күні.
Dialogue: 5,0:15:42.05,0:15:43.95,Default,,0,0,0,,Құлыптауды ұмытпаңыз.
Dialogue: 0,0:15:42.17,0:15:43.92,Default-ja,,0,0,0,,Есікті дұрыс бекітіңіз.
Dialogue: 5,0:15:43.95,0:15:44.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:44.00,0:15:46.09,Default-ja,,0,0,0,,Иә, қайырлы түн, ата.
Dialogue: 5,0:15:44.75,0:15:46.10,Default,,0,0,0,,Қайырлы түн, ата.
Dialogue: 5,0:15:46.10,0:15:47.93,Default,,0,0,0,,Ертең құймақ толтыруға көмектесеміз.
Dialogue: 0,0:15:46.17,0:15:47.84,Default-ja,,0,0,0,,Мен ертең дораяки орауға барамын.
Dialogue: 0,0:15:47.92,0:15:51.30,Default-ja,,0,0,0,,Өтінемін, қайырлы түн.
Dialogue: 5,0:15:47.93,0:15:49.22,Default,,0,0,0,,Иә, өтінемін!
Dialogue: 5,0:15:49.22,0:15:51.56,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:15:52.47,0:15:54.47,Default-ja,,0,0,0,,Мен орамал көрпе әкелдім.
Dialogue: 5,0:15:52.52,0:15:54.56,Default,,0,0,0,,Мен саған көрпе әкелдім.
Dialogue: 0,0:15:55.72,0:15:58.06,Default-ja,,0,0,0,,Аа, мен әлі көзілдірікті киіп жүрмін.
Dialogue: 5,0:15:55.76,0:15:57.87,Default,,0,0,0,,Әй, көзілдірігін шешуді ұмытып кетіпті.
Dialogue: 0,0:16:20.08,0:16:20.92,Default-ja,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 5,0:16:20.15,0:16:21.14,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:16:29.47,0:16:33.72,Default-ja,,0,0,0,,Рей Кирияма Бұл менің атым
Dialogue: 5,0:16:29.48,0:16:30.81,Default,,0,0,0,,Кирияма Рей.
Dialogue: 5,0:16:31.98,0:16:33.85,Default,,0,0,0,,Бұл менің атым.
Dialogue: 0,0:16:34.60,0:16:39.73,Default-ja,,0,0,0,,Бұдан былай мен үлкен өзен жағасындағы шағын қалашықта тұрамын.
Dialogue: 5,0:16:34.62,0:16:39.63,Default,,0,0,0,,Үлкен өзен жағасындағы шағын қалада мен қазірден бастап тұратын боламын.
Dialogue: 0,0:16:40.81,0:16:47.82,Default-ja,,0,0,0,,С сыныбы 1-сынып, 5-дан, 17 жаста Мамандығы: Кәсіби шоги ойыншысы
Dialogue: 5,0:16:40.85,0:16:43.43,Default,,0,0,0,,С1 сыныбы, 5-дан.
Dialogue: 5,0:16:43.43,0:16:44.57,Default,,0,0,0,,Он жеті жаста.
Dialogue: 5,0:16:45.56,0:16:47.92,Default,,0,0,0,,Кәсіби шоги ойыншысы.
Dialogue: 0,0:16:48.99,0:16:51.00,titles,,0,0,0,,Кирияма Рей
Dialogue: 0,0:16:51.00,0:16:55.00,titles,,0,0,0,,Өзен жағасындағы қала
Dialogue: 0,0:17:00.51,0:17:02.63,signs,,0,0,0,,Қарау
Dialogue: 1,0:17:00.51,0:17:02.63,signs,,0,0,0,,Қарау
Dialogue: 5,0:17:03.83,0:17:05.76,Default,,0,0,0,,А-Үкі ме?
Dialogue: 0,0:17:03.83,0:17:05.67,Default-ja,,0,0,0,,А... Үкі ме?
Dialogue: 0,0:17:06.64,0:17:20.40,signs,,0,0,0,,Қарау
Dialogue: 1,0:17:06.64,0:17:20.40,signs,,0,0,0,,Қарау
Dialogue: 5,0:17:07.03,0:17:09.53,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес.
Dialogue: 0,0:17:07.05,0:17:09.51,Default-ja,,0,0,0,,...Оған еш себеп жоқ, солай ма?
Dialogue: 5,0:17:09.53,0:17:14.30,Default,,0,0,0,,Керемет ақ үкі біреудің үйінде жайдан-жай көрінбейді.
Dialogue: 0,0:17:09.59,0:17:10.97,Default-ja,,0,0,0,,Кенеттен жеке үйде —
Dialogue: 0,0:17:11.05,0:17:14.05,Default-ja,,0,0,0,,Мұндай керемет қарлы үкі жоқ.
Dialogue: 5,0:17:14.30,0:17:17.17,Default,,0,0,0,,Оған қоса, ол сабан төсенішінде тұр.
Dialogue: 0,0:17:14.30,0:17:17.22,Default-ja,,0,0,0,,Және кенет, тікелей татамиде
Dialogue: 5,0:17:17.89,0:17:20.40,Default,,0,0,0,,Мен сіздің мысық екеніңізге сенімдімін, солай ма?
Dialogue: 0,0:17:17.89,0:17:20.31,Default-ja,,0,0,0,,Сіз мысықсыз, солай ма? Мүмкін
Dialogue: 5,0:17:20.40,0:17:22.82,Default,,0,0,0,,Жоқ! Мен кешігіп қаламын!
Dialogue: 0,0:17:20.43,0:17:21.43,Default-ja,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:17:21.52,0:17:23.64,Default-ja,,0,0,0,,Мен кешігіп барамын! Апыр-ай!
Dialogue: 0,0:17:23.73,0:17:24.73,Default-ja,,0,0,0,,Қайырлы таң, Нөл!
Dialogue: 5,0:17:23.78,0:17:24.81,Default,,0,0,0,,Қайырлы таң, Рей!
Dialogue: 5,0:17:24.81,0:17:26.53,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:17:24.81,0:17:26.44,Default-ja,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:17:26.61,0:17:26.82,signs,,0,0,0,,Масштабтау
Dialogue: 5,0:17:26.87,0:17:27.27,Default,,0,0,0,,түн
Dialogue: 0,0:17:26.90,0:17:27.90,Default-ja,,0,0,0,,Иә! (Нөл) А, иә!
Dialogue: 5,0:17:27.27,0:17:28.07,Default,,0,0,0,,5 йен
Dialogue: 0,0:17:27.70,0:17:28.99,signs,,0,0,0,,Төсек басы
Dialogue: 1,0:17:27.70,0:17:28.99,signs,,0,0,0,,Төсек басы
Dialogue: 0,0:17:27.98,0:17:29.07,Default-ja,,0,0,0,,Араластырыңыз!
Dialogue: 5,0:17:28.07,0:17:28.99,Default,,0,0,0,,Оны араластырыңыз!
Dialogue: 0,0:17:30.23,0:17:32.99,Default-ja,,0,0,0,,Та... жұмыртқа да, өтінемін! (Нөл) Иә, иә...
Dialogue: 5,0:17:30.26,0:17:31.53,Default,,0,0,0,,G-Жұмыртқаларды да ал, өтінемін!
Dialogue: 5,0:17:31.53,0:17:32.29,Default,,0,0,0,,Y-Иә!
Dialogue: 0,0:17:33.21,0:17:33.70,signs,,0,0,0,,Блант
Dialogue: 1,0:17:33.21,0:17:33.70,signs,,0,0,0,,Блант
Dialogue: 5,0:17:33.53,0:17:36.28,Default,,0,0,0,,Жарайды, мен сені айтқанымдай ояттым.
Dialogue: 0,0:17:33.53,0:17:36.24,Default-ja,,0,0,0,,Олай болса, апа, мен сізді дұрыстап ояттым.
Dialogue: 5,0:17:36.28,0:17:37.40,Default,,0,0,0,,Кеттік, Момо.
Dialogue: 0,0:17:36.32,0:17:39.66,Default-ja,,0,0,0,,Енді кеттік, Момо, мен де қазір тұрамын.
Dialogue: 5,0:17:36.97,0:17:40.01,Default,,0,0,0,,Мен қазір тұрамын, уайымдама.
Dialogue: 5,0:17:37.40,0:17:39.70,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 5,0:17:39.70,0:17:43.21,Default,,0,0,0,,Сис мені оятса да...
Dialogue: 0,0:17:39.74,0:17:42.79,Default-ja,,0,0,0,,Әпкем мені оятса да...
Dialogue: 5,0:17:40.01,0:17:42.43,Default,,0,0,0,,Сапарыңыз сәтті болсын!
Dialogue: 5,0:17:43.21,0:17:45.13,Default,,0,0,0,,Мен неге қайта ұйықтап қалдым?!
Dialogue: 0,0:17:43.25,0:17:45.04,Default-ja,,0,0,0,,Мен неге тағы ұйықтап қалдым деп ойлаймын.
Dialogue: 5,0:17:45.13,0:17:46.22,Default,,0,0,0,,Мен кешігіп қаламын!
Dialogue: 0,0:17:45.17,0:17:47.42,Default-ja,,0,0,0,,Кеш болды, бірақ дәмді.
Dialogue: 5,0:17:46.22,0:17:47.51,Default,,0,0,0,,Бірақ бұл өте жақсы!
Dialogue: 5,0:17:47.51,0:17:50.15,Default,,0,0,0,,Жоқ, менің уақытым таусылып барады!
Dialogue: 0,0:17:47.92,0:17:51.13,Default-ja,,0,0,0,,Қиын~ Уақыт~ Бірақ тағы бір сусын~
Dialogue: 5,0:17:50.15,0:17:51.30,Default,,0,0,0,,Бірақ тағы бір тостаған!
Dialogue: 0,0:17:51.21,0:17:52.84,Default-ja,,0,0,0,,Не? Сіз әлі тамақтанып жатырсыз ба?
Dialogue: 5,0:17:51.30,0:17:53.56,Default,,0,0,0,,Не?! Сізде көбірек болады ма?
Dialogue: 0,0:17:52.92,0:17:54.84,Default-ja,,0,0,0,,Уау, Зеро-кун, мынаны ал.
Dialogue: 5,0:17:53.56,0:17:54.93,Default,,0,0,0,,Рей, мынаны ал!
Dialogue: 5,0:17:54.93,0:17:58.31,Default,,0,0,0,,Түскі асыңыз! Бұл сәл үлкен, бірақ мен оны қатты қыстым, сондықтан бәрі жақсы болуы керек!
Dialogue: 0,0:17:55.13,0:17:58.18,Default-ja,,0,0,0,,Түскі қорап сәл үлкен, бірақ мен оны қатты ұстадым, сондықтан бәрі жақсы болды.
Dialogue: 0,0:17:58.26,0:17:59.85,Default-ja,,0,0,0,,Не? Ах, рахмет
Dialogue: 5,0:17:58.31,0:17:59.94,Default,,0,0,0,,Рахмет!
Dialogue: 5,0:17:59.94,0:18:02.69,Default,,0,0,0,,Ал бұл жалпы біртүрлі гарнир, бірақ жақсы!
Dialogue: 0,0:18:00.06,0:18:01.39,Default-ja,,0,0,0,,Сонымен қатар гарнир дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:00.44,0:18:00.48,signs,,0,0,0,,Ба-Баааам!
Dialogue: 1,0:18:00.44,0:18:00.48,signs,,0,0,0,,Ба-Баааам!
