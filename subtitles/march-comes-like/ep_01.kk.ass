Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.74,0:00:38.65,OP,,0,0,0,,Сиқырлы заклинание есімде
Dialogue: 0,0:00:38.65,0:00:42.01,OP,,0,0,0,,Артынан кемпірқосақ аспанға созылғанда
Dialogue: 0,0:00:42.01,0:00:45.93,OP,,0,0,0,,Әп-сәтте әлемнің әр түкпірінде
Dialogue: 0,0:00:45.93,0:00:49.46,OP,,0,0,0,,Жарқын реңкке ие болды
Dialogue: 0,0:00:49.46,0:00:53.08,OP,,0,0,0,,Жүрегімнің үні
Dialogue: 0,0:00:53.08,0:00:56.58,OP,,0,0,0,,Әрқашан менің жүруім керек жолды жарықтандырады
Dialogue: 0,0:00:56.58,0:01:00.49,OP,,0,0,0,,Себебі мен бәріне күмәнданамын
Dialogue: 0,0:01:00.49,0:01:04.26,OP,,0,0,0,,Мен мұның рас екенін білемін
Dialogue: 0,0:01:04.26,0:01:07.97,OP,,0,0,0,,Менің жүрегім неге соғады?
Dialogue: 0,0:01:07.97,0:01:11.60,OP,,0,0,0,,Неліктен менің өкпем әлі де тыныс алады?
Dialogue: 0,0:01:11.60,0:01:15.23,OP,,0,0,0,,Неліктен кеудем құмарлықтан өртенеді?
Dialogue: 0,0:01:15.23,0:01:18.46,OP,,0,0,0,,Мұның бәрінің себебі бар
Dialogue: 0,0:01:18.81,0:01:21.95,OP,,0,0,0,,Және бұлттардың артына тығылған жұлдызды аспан сияқты
Dialogue: 0,0:01:22.23,0:01:24.61,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:24.61,0:01:24.73,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:24.73,0:01:24.86,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:24.86,0:01:24.98,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:24.98,0:01:25.11,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:25.85,0:01:29.26,OP,,0,0,0,,Мен дүниеге келгенге дейінгі дүние тарихы сияқты
Dialogue: 0,0:01:29.68,0:01:33.26,OP,,0,0,0,,Сіз жауапты менің қолымнан келмейді
Dialogue: 0,0:01:33.35,0:01:39.89,OP,,0,0,0,,Басқа ештеңе болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:40.77,0:01:47.47,OP,,0,0,0,,Басқа ешкім болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:51.26,0:01:54.39,titles,,0,0,0,,Кирияма Рей
Dialogue: 0,0:01:54.93,0:01:58.18,Default-ja,,0,0,0,,Нөл... біртүрлі есім
Dialogue: 5,0:01:55.00,0:01:56.35,Default,,0,0,0,,Нөл?
Dialogue: 5,0:01:56.70,0:01:58.27,Default,,0,0,0,,Қандай қызық есім.
Dialogue: 5,0:01:58.79,0:02:00.77,Default,,0,0,0,,Бірақ бұл сізге сәйкес келеді.
Dialogue: 0,0:01:58.80,0:02:02.77,Default-ja,,0,0,0,,Бірақ бұл сізге өте ыңғайлы... солай ма?
Dialogue: 5,0:02:01.29,0:02:02.77,Default,,0,0,0,,солай емес пе?
Dialogue: 0,0:02:03.81,0:02:06.19,Default-ja,,0,0,0,,Үй жоқ, отбасы жоқ
Dialogue: 5,0:02:03.87,0:02:04.98,Default,,0,0,0,,Сіздің үйіңіз жоқ.
Dialogue: 5,0:02:04.98,0:02:06.28,Default,,0,0,0,,Сіздің отбасыңыз жоқ.
Dialogue: 0,0:02:06.52,0:02:08.52,Default-ja,,0,0,0,,Мен мектепке де бармаймын.
Dialogue: 5,0:02:06.57,0:02:08.37,Default,,0,0,0,,Сіз мектепке бармайсыз.
Dialogue: 5,0:02:08.78,0:02:10.78,Default,,0,0,0,,Сіздің достарыңыз жоқ.
Dialogue: 0,0:02:09.02,0:02:10.69,Default-ja,,0,0,0,,Менің достарым жоқ...
Dialogue: 5,0:02:12.03,0:02:16.78,Default,,0,0,0,,Көрдіңіз бе? Бұл дүниеде саған орын жоқ.
Dialogue: 0,0:02:12.19,0:02:16.95,Default-ja,,0,0,0,,Қарашы, бұл дүниеде саған орын жоқ.
Dialogue: 0,0:02:24.08,0:02:26.04,Default-ja,,0,0,0,,Ах, а...
Dialogue: 0,0:03:49.41,0:03:55.90,Insert,,0,0,0,,Мен өзімді тыныштандыру үшін көзімді жұмдым
Dialogue: 0,0:03:55.90,0:03:58.11,Insert,,0,0,0,,Ай сәулесі астында
Dialogue: 0,0:03:58.11,0:04:01.49,Insert,,0,0,0,,Мен бұл жерді қалай жақсы көремін
Dialogue: 0,0:04:02.45,0:04:05.73,Insert,,0,0,0,,Мен бірден кетуім керек
Dialogue: 0,0:04:05.73,0:04:08.52,Insert,,0,0,0,,Мен түсінген шығармын
Dialogue: 0,0:04:08.93,0:04:12.82,Insert,,0,0,0,,Қайғыдан мөр басылды
Dialogue: 0,0:04:13.24,0:04:16.91,Insert,,0,0,0,,Негізі мен өз үйімде де қорқамын
Dialogue: 0,0:04:16.91,0:04:21.16,Insert,,0,0,0,,Әрбір күн қандай қайғылы болды
Dialogue: 0,0:04:21.16,0:04:24.37,Insert,,0,0,0,,Мен махаббатқа толымын
Dialogue: 0,0:04:24.37,0:04:27.82,Insert,,0,0,0,,Менің көзіме жас келді
Dialogue: 0,0:04:28.42,0:04:38.14,Insert,,0,0,0,,Бірақ қазір мен өмірімнің күңгірт түстерін өзгерте аламын
Dialogue: 0,0:04:39.60,0:04:43.01,Insert,,0,0,0,,Мен қанша қашықтыққа жүзуді жалғастыруым керек?
Dialogue: 0,0:04:43.01,0:04:49.65,Insert,,0,0,0,,Жаңбыр қашан тоқтайды?
Dialogue: 0,0:04:49.65,0:04:55.63,Insert,,0,0,0,,Мен дымқыл болсам да, қалай жүруді білмеймін
Dialogue: 0,0:04:55.63,0:05:02.92,Insert,,0,0,0,,Осы қараңғы қаладан ұямды іздеймін
Dialogue: 0,0:05:02.92,0:05:07.86,Insert,,0,0,0,,Мен алып кемпірқосақ көріп тұрмын
Dialogue: 0,0:05:04.33,0:05:06.33,signs,,0,0,0,,Шоги залы
Dialogue: 1,0:05:04.33,0:05:06.33,signs,,0,0,0,,Шоги залы
Dialogue: 0,0:05:47.00,0:05:49.25,signs,,0,0,0,,Сабырлы ақыл – жол
Dialogue: 1,0:05:47.00,0:05:49.25,signs,,0,0,0,,Сабырлы ақыл – жол
Dialogue: 5,0:06:07.80,0:06:10.50,Default,,0,0,0,,Қалайсың, Рей?
Dialogue: 0,0:06:07.80,0:06:10.56,Default-ja,,0,0,0,,Қалайсың? Нөл
Dialogue: 5,0:06:20.17,0:06:22.14,Default,,0,0,0,,Әрине ыстық, иә?
Dialogue: 0,0:06:20.19,0:06:21.90,Default-ja,,0,0,0,,Ыстық...
Dialogue: 5,0:06:22.14,0:06:25.24,Default,,0,0,0,,Біз әлі жаңбырлы маусымда да емеспіз.
Dialogue: 0,0:06:22.19,0:06:25.15,Default-ja,,0,0,0,,Жаңбырлы маусым әлі болмаса да...
Dialogue: 5,0:06:30.65,0:06:31.92,Default,,0,0,0,,Ей, мен не айтып тұрмын?
Dialogue: 0,0:06:30.66,0:06:31.83,Default-ja,,0,0,0,,Кешіріңіз...
Dialogue: 5,0:06:33.59,0:06:37.84,Default,,0,0,0,,Ауа-райы туралы ғана айта аламын ба?
Dialogue: 0,0:06:33.75,0:06:37.75,Default-ja,,0,0,0,,Осындай уақытта да ауа-райы туралы ғана естиміз...
Dialogue: 0,0:06:37.84,0:06:40.09,signs,,0,0,0,,Шоги бойынша балалар турнирі
Dialogue: 1,0:06:37.84,0:06:40.09,signs,,0,0,0,,Шоги бойынша балалар турнирі
Dialogue: 5,0:06:45.54,0:06:47.63,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:06:45.55,0:06:47.72,Default-ja,,0,0,0,,Олай болса, бастайық па?
Dialogue: 0,0:07:55.50,0:07:57.50,signs,,0,0,0,,Жеңімпаз
Dialogue: 1,0:07:55.50,0:07:57.50,signs,,0,0,0,,Жеңімпаз
Dialogue: 0,0:07:55.50,0:07:57.50,signs,,0,0,0,,Кирияма Рей
Dialogue: 1,0:07:55.50,0:07:57.50,signs,,0,0,0,,Кирияма Рей
Dialogue: 0,0:07:55.50,0:07:57.50,signs,,0,0,0,,Шоги бойынша балалар турнирі
Dialogue: 1,0:07:55.50,0:07:57.50,signs,,0,0,0,,Шоги бойынша балалар турнирі
Dialogue: 0,0:08:20.60,0:08:23.19,Default-ja,,0,0,0,,Жоқ...
Dialogue: 5,0:08:21.91,0:08:23.32,Default,,0,0,0,,Ештеңе жоқ.
Dialogue: 5,0:08:29.05,0:08:30.94,Default,,0,0,0,,Иә. Ештеңе.
Dialogue: 0,0:08:29.07,0:08:31.03,Default-ja,,0,0,0,,Иә Жоқ
Dialogue: 0,0:08:35.87,0:08:37.04,Default-ja,,0,0,0,,Жоғалған
Dialogue: 5,0:08:35.88,0:08:37.08,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 5,0:08:41.31,0:08:42.67,Default,,0,0,0,,You've gotten better.
Dialogue: 0,0:08:41.33,0:08:42.87,Default-ja,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 5,0:08:47.16,0:08:49.60,Default,,0,0,0,,Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:08:47.17,0:08:49.46,Default-ja,,0,0,0,,Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 5,0:08:52.09,0:08:54.10,Default,,0,0,0,,You left so suddenly.
Dialogue: 0,0:08:52.09,0:08:57.35,Default-ja,,0,0,0,,Аюму мен Коко сенің кенет кетіп қалғаныңа алаңдап отыр.
Dialogue: 5,0:08:54.79,0:08:57.38,Default,,0,0,0,,Аюму мен Киоуко да сені уайымдап отыр.
Dialogue: 0,0:09:24.42,0:09:25.42,Default-ja,,0,0,0,,Бұл өтірік
Dialogue: 5,0:09:24.44,0:09:25.31,Default,,0,0,0,,Бұл өтірік.
Dialogue: 5,0:09:28.68,0:09:31.85,Default,,0,0,0,,Next stop: Tsukishima. Цукишима.
