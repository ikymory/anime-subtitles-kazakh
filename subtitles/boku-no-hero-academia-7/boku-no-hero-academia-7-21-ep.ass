Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.75,0:00:08.38,Default,,0,0,0,,Зардап шеккен адамды ішке кіргізіңіз!
Dialogue: 0,0:00:08.46,0:00:10.88,Default,,0,0,0,,Әй, жау ма, одақтас па, бәрібір!
Dialogue: 0,0:00:10.97,0:00:13.34,Default,,0,0,0,,Асығыңыз! Жаңбыр күшейіп барады!
Dialogue: 0,0:00:13.97,0:00:14.93,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:00:15.01,0:00:18.85,Default,,0,0,0,,Қозғалмаңыз. Егер жара ашылса, бұл өмірді немесе өлімді білдіруі мүмкін!
Dialogue: 0,0:00:20.31,0:00:21.68,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:23.31,0:00:25.48,Default,,0,0,0,,Маған жаудың тұрған жерін айт
Dialogue: 0,0:00:25.56,0:00:28.15,Default,,0,0,0,,Хмм... мені айтуға мәжбүрлеме.
Dialogue: 0,0:00:28.23,0:00:31.11,Default,,0,0,0,,Сіз қашып кеткен тұтқынсыз.
Dialogue: 0,0:00:31.19,0:00:35.20,Default,,0,0,0,,Изуку Мидория маған...
Dialogue: 0,0:00:36.28,0:00:39.12,Default,,0,0,0,,Бізбен күресіңізші
Dialogue: 0,0:00:39.20,0:00:43.29,Default,,0,0,0,,Сенің жүрегің әлі батыр!
Dialogue: 0,0:00:43.91,0:00:48.92,Default,,0,0,0,,Ол менен төбелесуімді өтінді...
Dialogue: 0,0:00:50.13,0:00:51.63,Default,,0,0,0,,Мені жіберіңізші (Дәрігер) А.
Dialogue: 0,0:00:52.30,0:00:53.34,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:00:54.26,0:00:56.30,Default,,0,0,0,,Мен жауапкершілікті аламын
Dialogue: 0,0:00:57.89,0:01:00.10,Default,,0,0,0,,Сіз бұл жігітпен шайқас күйін тексере аласыз
Dialogue: 0,0:01:00.72,0:01:03.43,Default,,0,0,0,,Батырлардың орналасқан жері, жау позициялары, т.б.
Dialogue: 0,0:01:03.52,0:01:04.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:04.69,0:01:06.69,Default,,0,0,0,,Наган ханым
Dialogue: 0,0:01:06.77,0:01:12.11,Default,,0,0,0,,Бұл жан-жақты соғыс, сайып келгенде, Изуку Мидорияға сенетін шайқасқа айналады.
Dialogue: 0,0:01:12.19,0:01:16.41,Default,,0,0,0,,Сол балаға көңіл бөлсеңіз
Dialogue: 0,0:01:17.36,0:01:19.70,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:01:29.59,0:01:31.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:31.55,0:01:37.47,Default,,0,0,0,,Тағы бір ату... Бір ату артық!
Dialogue: 0,0:01:39.55,0:01:41.47,Default,,0,0,0,,Сұр аспан
Dialogue: 0,0:01:42.26,0:01:46.39,Default,,0,0,0,,Қара жамылған, Сене алмаймын жарыққа
Dialogue: 0,0:01:46.48,0:01:49.44,Default,,0,0,0,,Сен және сенің кішілерің осыны есіме түсірдің.
Dialogue: 0,0:01:51.65,0:01:56.36,Default,,0,0,0,,Сол күндердің ойлары, Жарқыраған сағыныш
Dialogue: 0,0:01:58.07,0:02:00.37,Default,,0,0,0,,Өмірдің мәні
Dialogue: 0,0:02:01.45,0:02:06.71,Default,,0,0,0,,Оны Изуку Мидорияға жеткізіңіз, Наган ханым!
Dialogue: 0,0:02:06.79,0:02:08.79,Default,,0,0,0,,Нагаон!
Dialogue: 0,0:02:11.00,0:02:12.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:18.13,0:02:19.55,Default,,0,0,0,,Шынында да осылай болып жатыр ма? Әлсіздің жеңісі ме?
Dialogue: 0,0:02:19.64,0:02:23.76,Default,,0,0,0,,Енді Шигараги өзінің «индивидуалдылығын» еркін пайдалана алады.
Dialogue: 0,0:02:23.85,0:02:25.93,Default,,0,0,0,,Табыттың үстінде соғысуға болмайды
Dialogue: 0,0:02:26.02,0:02:28.10,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:02:28.94,0:02:33.57,Default,,0,0,0,,♪～
Dialogue: 0,0:03:53.94,0:03:58.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:59.03,0:04:01.53,Default,,0,0,0,,Бір рет қолданылатын қоқыс!
Dialogue: 0,0:04:02.20,0:04:06.03,Default,,0,0,0,,Өлтіруші жолдастардың өздерін құрбан болғандай етіп көрсетуі әділдік пе?
Dialogue: 0,0:04:06.12,0:04:08.33,Default,,0,0,0,,Әлсіздер ағынды жібереді!
Dialogue: 0,0:04:08.95,0:04:10.20,Default,,0,0,0,,Хаха
Dialogue: 0,0:04:10.29,0:04:13.71,Default,,0,0,0,,Ол эмоциялар мен байланыстарды пайдалануы керек.
Dialogue: 0,0:04:13.79,0:04:15.08,Default,,0,0,0,,Бұл жағымсыз
Dialogue: 0,0:04:15.17,0:04:18.34,Default,,0,0,0,,Қолыңызды алыңыз.
Dialogue: 0,0:04:19.34,0:04:22.63,Default,,0,0,0,,Мені солай өсірдің.
Dialogue: 0,0:04:22.72,0:04:28.14,Default,,0,0,0,,Шимура: Бұл оның Бүкіл Құдірет-пен байланысын пайдаланып қудалау.
Dialogue: 0,0:04:29.31,0:04:34.98,Default,,0,0,0,,Сіз менің ойым мен денемді жаулап алу жоспарыңызды жалғастырдыңыз.
Dialogue: 0,0:04:35.98,0:04:37.73,Default,,0,0,0,,Менің жек көруімді қабыл алыңыз
Dialogue: 0,0:04:38.44,0:04:41.69,Default,,0,0,0,,«Біреуі бәрі үшін» алуға тырысты
Dialogue: 0,0:04:42.19,0:04:47.28,Default,,0,0,0,,Мен сенімен араласып, бір бөлшегіне айналдым.
Dialogue: 0,0:04:48.66,0:04:50.49,Default,,0,0,0,,Бірақ, сэр.
Dialogue: 0,0:04:50.58,0:04:56.29,Default,,0,0,0,,Маған ұнамады, өзегін жүрегімнің түбіне тығып қойдым.
Dialogue: 0,0:04:57.00,0:04:59.38,Default,,0,0,0,,Сіз байқамау үшін
Dialogue: 0,0:04:59.46,0:05:03.51,Default,,0,0,0,,Ядро ішінен қайта қалпына келді.
Dialogue: 0,0:05:05.05,0:05:08.26,Default,,0,0,0,,«Мен» саяхат жасадым
Dialogue: 0,0:05:08.35,0:05:10.93,Default,,0,0,0,,Курогири!
Dialogue: 0,0:05:11.64,0:05:14.14,Default,,0,0,0,,Мен өз денемді еркін пайдалана алмаймын!
Dialogue: 0,0:05:14.23,0:05:17.56,Default,,0,0,0,,Мені Барлығына Бірге жеткізіңіз!
Dialogue: 0,0:05:17.65,0:05:20.07,Default,,0,0,0,,Ах... Ши...
Dialogue: 0,0:05:20.15,0:05:23.61,Default,,0,0,0,,Мен... бірақ... Мамору... жоқ...
Dialogue: 0,0:05:23.69,0:05:26.07,Default,,0,0,0,,Өлі ағаш... Ши... Йо...
Dialogue: 0,0:05:26.16,0:05:29.03,Default,,0,0,0,,Кім... қайда...
Dialogue: 0,0:05:29.12,0:05:32.45,Default,,0,0,0,,Ши… Мен доспын… Чи…
Dialogue: 0,0:05:33.62,0:05:36.71,Default,,0,0,0,,Маған «бәрі үшін бір» керек емес
Dialogue: 0,0:05:37.88,0:05:39.84,Default,,0,0,0,,Бөлшекке айналмайды
Dialogue: 0,0:05:40.71,0:05:44.30,Default,,0,0,0,,Сіз бәрін басқара аласыз деп ойлайсыз ба?
Dialogue: 0,0:05:45.01,0:05:50.39,Default,,0,0,0,,Менің жүрегім олар сияқты өзгермейді.
Dialogue: 0,0:05:50.47,0:05:56.39,Default,,0,0,0,,Бұл дүниеде көргеннің бәрі сол үйдің себебі.
Dialogue: 0,0:05:59.65,0:06:02.48,Default,,0,0,0,,Мен бір ғана нәрсені қалаймын!
Dialogue: 0,0:06:04.07,0:06:07.70,Default,,0,0,0,,Сол үйден басталған қираудың бәрі.
Dialogue: 0,0:06:07.78,0:06:09.11,Default,,0,0,0,,Га
Dialogue: 0,0:06:09.91,0:06:15.12,Default,,0,0,0,,Мені сол ғана құтқара алады, батыр.
Dialogue: 0,0:06:16.16,0:06:17.50,Default,,0,0,0,,Бала!?
Dialogue: 0,0:06:19.00,0:06:20.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:21.92,0:06:25.13,Default,,0,0,0,,Мен мұны істеуге рұқсат бермеймін, бірақ
Dialogue: 0,0:06:26.84,0:06:30.89,Default,,0,0,0,,Мен сенің жылағаныңды көрмедім деп кейіп танытпаймын!
Dialogue: 0,0:06:30.97,0:06:32.51,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:37.06,0:06:39.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:40.02,0:06:42.86,Default,,0,0,0,,«Икемділік» төтеп бере алмайды
Dialogue: 0,0:06:43.44,0:06:47.32,Default,,0,0,0,,Бұл «махаббат» емес, менің шегім
Dialogue: 0,0:06:47.40,0:06:49.57,Default,,0,0,0,,Кішкене тырысыңыз
Dialogue: 0,0:06:49.66,0:06:53.24,Default,,0,0,0,,Мен көтерілу бағдарламасын жіберуге дайынмын.
Dialogue: 0,0:06:54.54,0:06:56.95,Default,,0,0,0,,Жылдам болғаны сонша, мен анық көре алмадым.
Dialogue: 0,0:06:57.04,0:07:00.50,Default,,0,0,0,,Бұл бала екені сөзсіз.
Dialogue: 0,0:07:00.58,0:07:02.96,Default,,0,0,0,,Бұл жерден алыс болу дегенді білдіреді
Dialogue: 0,0:07:03.04,0:07:06.17,Default,,0,0,0,,Маған сеніп тапсырылған ба?
Dialogue: 0,0:07:06.26,0:07:10.30,Default,,0,0,0,,Жоқ, сіз менің осында екенімді ешқашан білмейсіз.
Dialogue: 0,0:07:10.80,0:07:14.18,Default,,0,0,0,,Камера жоқ, аудитория жоқ
Dialogue: 0,0:07:14.26,0:07:19.43,Default,,0,0,0,,Бұл жерде не істесем де, сын да, қошемет те болмайды.
Dialogue: 0,0:07:20.19,0:07:21.44,Default,,0,0,0,,Иә
Dialogue: 0,0:07:21.52,0:07:25.90,Default,,0,0,0,,Менің жүрегімде өмірдің қуанышы ғана...
Dialogue: 0,0:07:25.98,0:07:26.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:31.07,0:07:33.99,Default,,0,0,0,,Камера және аудитория
Dialogue: 0,0:07:34.07,0:07:34.99,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:07:35.58,0:07:37.04,Default,,0,0,0,,Ішке кіріңіз!
Dialogue: 0,0:07:37.12,0:07:40.08,Default,,0,0,0,,Ол түрмеде жау (зұлым) болуы керек.
Dialogue: 0,0:07:40.16,0:07:43.96,Default,,0,0,0,,Бірақ дәл қазір бұл табытты ұстап тұрған ол.
Dialogue: 0,0:07:44.04,0:07:45.17,Default,,0,0,0,,Сіз тыңдамайсыз!
Dialogue: 0,0:07:45.25,0:07:48.59,Default,,0,0,0,,Мен қазір үмітсізмін! Ішке кір!
Dialogue: 0,0:07:49.46,0:07:51.34,Default,,0,0,0,,Маған суретке түсуге рұқсат етіңіз!
Dialogue: 0,0:07:51.43,0:07:52.30,Default,,0,0,0,,Эмоция!
Dialogue: 0,0:07:52.89,0:07:54.64,Default,,0,0,0,,Біздің де амалымыз жоқ!
Dialogue: 0,0:07:55.47,0:08:00.52,Default,,0,0,0,,Жапония осылай болды, оған Endeavour жауапты.
Dialogue: 0,0:08:00.60,0:08:03.52,Default,,0,0,0,,Біз оны шығаруымыз керек еді.
Dialogue: 0,0:08:03.60,0:08:08.15,Default,,0,0,0,,Сол күні батырлар мен қоғамды байланыстыруымыз керек еді.
Dialogue: 0,0:08:08.23,0:08:09.53,Default,,0,0,0,,Мен мұны істей алмадым!
Dialogue: 0,0:08:10.15,0:08:13.07,Default,,0,0,0,,Сондықтан келесі жолы суретке түсіріп, оны қосыңыз!
Dialogue: 0,0:08:13.16,0:08:14.66,Default,,0,0,0,,Бұл Іскерлік басқару департаменті...
Dialogue: 0,0:08:15.28,0:08:18.49,Default,,0,0,0,,Бұл біздің кейіпкеріміздің әрекеті!
Dialogue: 0,0:08:21.12,0:08:23.21,Default,,0,0,0,,Бұл Юэй...
Dialogue: 0,0:08:24.25,0:08:28.96,Default,,0,0,0,,Мен қай жерді бұзбақ болдым?
Dialogue: 0,0:08:29.50,0:08:31.51,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:08:34.30,0:08:36.85,Default,,0,0,0,,Балалар сендер өте жақсысыңдар!
Dialogue: 0,0:08:36.93,0:08:39.18,Default,,0,0,0,,Ұялы телефон ашық болды!?
Dialogue: 0,0:08:39.26,0:08:41.81,Default,,0,0,0,,Иә? Жоқ... ол жұмыс істемейді.
Dialogue: 0,0:08:41.89,0:08:43.77,Default,,0,0,0,,Ұрланған!? Бұл жау (зұлым) ба?
Dialogue: 0,0:08:43.85,0:08:46.73,Default,,0,0,0,,Өйткені Юэйдің электромагниттік кедергісі әлсірейді.
Dialogue: 0,0:08:46.81,0:08:48.11,Default,,0,0,0,,Маған кіруге рұқсат берілді.
Dialogue: 0,0:08:48.19,0:08:50.98,Default,,0,0,0,,Нарықтық баға Не істеп жатырсың! Юэй тез...
Dialogue: 0,0:08:51.07,0:08:53.11,Default,,0,0,0,,Бұл квотаға қол жеткізілді.
Dialogue: 0,0:08:53.20,0:08:55.36,Default,,0,0,0,,Келесімен жұмыс істеп жатыр
Dialogue: 0,0:08:55.45,0:08:58.20,Default,,0,0,0,,Оқтай бер, батыр
Dialogue: 0,0:09:00.16,0:09:04.33,Default,,0,0,0,,Мұндай керемет джентльмен туралы ешкім білмейді?
Dialogue: 0,0:09:04.41,0:09:08.42,Default,,0,0,0,,Жақсылық жасаса да мен оны кешірмеймін.
Dialogue: 0,0:09:10.30,0:09:12.67,Default,,0,0,0,,Ха! жеңілірек болды
Dialogue: 0,0:09:13.92,0:09:16.26,Default,,0,0,0,,Иә! Махаббат Махаббат!
Dialogue: 0,0:09:17.76,0:09:23.93,Default,,0,0,0,,Кім қорғайды... нені... мен...
Dialogue: 0,0:09:24.52,0:09:28.98,Default,,0,0,0,,Батырлар жойылды
Dialogue: 0,0:09:31.90,0:09:35.57,Default,,0,0,0,,Ой, өзімді ұстап қалдым ба?
Dialogue: 0,0:09:36.95,0:09:41.83,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:09:45.54,0:09:48.88,Default,,0,0,0,,Мұғалімге көмектестіңіз бе?
Dialogue: 0,0:09:48.96,0:09:51.67,Default,,0,0,0,,немесе «алып тастауды» алып тастау
Dialogue: 0,0:09:51.75,0:09:54.76,Default,,0,0,0,,Шигараги үшін ең үлкен қолдау болады.
Dialogue: 0,0:09:55.51,0:09:59.80,Default,,0,0,0,,Әйтеуір, енді сеніп, күресуден басқа амалым жоқ.
Dialogue: 0,0:09:59.89,0:10:04.02,Default,,0,0,0,,Осы шайқаста бәрі аман болып, жеңіске жетсін.
Dialogue: 0,0:10:08.19,0:10:09.81,Default,,0,0,0,,Мидория-кун!
Dialogue: 0,0:10:22.03,0:10:23.87,Default,,0,0,0,,Ааа!
Dialogue: 0,0:10:25.58,0:10:26.41,Default,,0,0,0,,Сан...
Dialogue: 0,0:10:26.50,0:10:27.87,Default,,0,0,0,,Жоқ, біз уақытында үлгермейміз!
Dialogue: 0,0:10:28.79,0:10:30.46,Default,,0,0,0,,Біріншіден, бастапқыда
Dialogue: 0,0:10:30.54,0:10:33.55,Default,,0,0,0,,Бұл толығымен «мен» болуы керек еді
Dialogue: 0,0:10:34.34,0:10:37.84,Default,,0,0,0,,Кім жерлеу рәсімімен қосылып, жаңа тұлға болады?
Dialogue: 0,0:10:37.92,0:10:40.22,Default,,0,0,0,,Бұл ең жақсы емес еді
Dialogue: 0,0:10:40.30,0:10:45.27,Default,,0,0,0,,Морнингтің жойқын екпіні мен күткеннен де асып түсті.
Dialogue: 0,0:10:45.35,0:10:48.14,Default,,0,0,0,,Бірақ бұл өкінішті нәрсе
Dialogue: 0,0:10:48.23,0:10:52.56,Default,,0,0,0,,Мен өз рөлін аяқтаған факторымды қоссам,
Dialogue: 0,0:10:52.65,0:10:56.53,Default,,0,0,0,,Менің доменім ұлғайып, мен жерлеуге қақпақ қоя аламын.
Dialogue: 0,0:10:56.61,0:10:59.78,Default,,0,0,0,,Жын патшасының аяқталуы
Dialogue: 0,0:11:00.36,0:11:04.28,Default,,0,0,0,,Бұл менің оқиғам
Dialogue: 0,0:11:05.08,0:11:07.41,Default,,0,0,0,,Мен сені қураған ағашқа жібермеймін.
Dialogue: 0,0:11:07.50,0:11:11.67,Default,,0,0,0,,Бұл біздің тарихымыз!
Dialogue: 0,0:11:12.33,0:11:18.30,Default,,0,0,0,,Біздің... болашағымыз үшін... сол балалар үшін!
Dialogue: 0,0:11:18.88,0:11:21.09,Default,,0,0,0,,Тек адамдарды жейтін сендер үшін
Dialogue: 0,0:11:21.18,0:11:22.89,Default,,0,0,0,,Оны бермеңіз!
Dialogue: 0,0:11:23.51,0:11:25.47,Default,,0,0,0,,Бұдан басқа
Dialogue: 0,0:11:27.27,0:11:30.89,Default,,0,0,0,,Болашақтың жарқын болғаны сонша, мені күлдіреді!
Dialogue: 0,0:11:31.77,0:11:35.77,Default,,0,0,0,,Бірақ маған жел соғып тұр
Dialogue: 0,0:11:40.90,0:11:42.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:49.20,0:11:52.00,Default,,0,0,0,,Ааа... аа... а...
Dialogue: 0,0:11:52.08,0:11:55.29,Default,,0,0,0,,Мен тым жылдам жүрдім.
Dialogue: 0,0:11:55.38,0:11:56.59,Default,,0,0,0,,Себебі мен сенімен танысқым келді...
Dialogue: 0,0:11:58.21,0:11:59.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.13,0:12:02.43,Default,,0,0,0,,Абуна~ Күрделі иллюзия~
Dialogue: 0,0:12:02.51,0:12:04.51,Default,,0,0,0,,Теюука Каничи!
Dialogue: 0,0:12:04.59,0:12:08.52,Default,,0,0,0,,Роттың Реммен Косы - супер шакотан.
Dialogue: 0,0:12:08.60,0:12:11.89,Default,,0,0,0,,Юэйден келген босқындарды қабылдау
Dialogue: 0,0:12:11.98,0:12:15.31,Default,,0,0,0,,Маған ерекше қорғаныс міндеттері сеніп тапсырылды.
Dialogue: 0,0:12:15.40,0:12:17.07,Default,,0,0,0,,Әлі келген жоқ
Dialogue: 0,0:12:17.61,0:12:23.41,Default,,0,0,0,,Мен қазіргі тенденцияның қайталану қаупі бар деген қорытындыға келдім...
Dialogue: 0,0:12:24.07,0:12:27.58,Default,,0,0,0,,Шикецу орта мектебінің батыр бөлімі
Dialogue: 0,0:12:27.66,0:12:31.46,Default,,0,0,0,,Сәлем! (Никукура) Мен саған көмектесемін!
Dialogue: 0,0:12:31.54,0:12:36.13,Default,,0,0,0,,Жел соқпайды, соғу үшін жаралған!
Dialogue: 0,0:12:37.00,0:12:39.46,Default,,0,0,0,,Әлде бәрі біреу үшін бе?
Dialogue: 0,0:12:39.55,0:12:40.67,Default,,0,0,0,,Бет бар ма?
Dialogue: 0,0:12:40.76,0:12:44.38,Default,,0,0,0,,Әкемнің жауы, өлтіргім келеді.
Dialogue: 0,0:12:44.47,0:12:46.93,Default,,0,0,0,,Мен өшпенділік пен жиіркеніштілікке батпаймын
Dialogue: 0,0:12:47.01,0:12:49.56,Default,,0,0,0,,Өйткені ол дәл осылай ойлайды.
Dialogue: 0,0:12:49.64,0:12:55.35,Default,,0,0,0,,Мен әкемнің түрме күзетшісі ретінде қорғағанын жай ғана байланыстырамын!
Dialogue: 0,0:12:55.44,0:12:58.98,Default,,0,0,0,,Сисыкрос! Сондай-ақ OB OG бар.
Dialogue: 0,0:12:59.07,0:13:01.36,Default,,0,0,0,,Деку Юэйден кетіп қалған сияқты.
Dialogue: 0,0:13:02.07,0:13:05.61,Default,,0,0,0,,Жағдай ретсіз. Біз оны тоқтату үшін бәрін жасаймыз!
Dialogue: 0,0:13:06.32,0:13:07.28,Default,,0,0,0,,Иә
Dialogue: 0,0:13:08.07,0:13:11.58,Default,,0,0,0,,Тым кеш болмай тұрып Тоға мөрін сал
Dialogue: 0,0:13:12.25,0:13:17.96,Default,,0,0,0,,Барлық ұзақ қашықтықтағы шабуылдар Барлығы бір үшін!
Dialogue: 0,0:13:20.96,0:13:22.51,Default,,0,0,0,,Амансың ба? Hawks!
Dialogue: 0,0:13:22.59,0:13:23.80,Default,,0,0,0,,Цукаучи мырза
Dialogue: 0,0:13:23.88,0:13:28.18,Default,,0,0,0,,Күшейту уақыты жақсы болды, менің өмірім сақталды.
Dialogue: 0,0:13:28.26,0:13:33.23,Default,,0,0,0,,Жоқ, олар біз сұрағанша әрекет етті.
Dialogue: 0,0:13:34.06,0:13:37.48,Default,,0,0,0,,Мен «Бәрі бір адамның денесі үшін» оралды деп естідім.
Dialogue: 0,0:13:37.56,0:13:41.53,Default,,0,0,0,,Дегенмен, көпшіліктің күмәнін бақылау жеңіске немесе жеңіліске тікелей байланысты.
Dialogue: 0,0:13:41.61,0:13:45.45,Default,,0,0,0,,Барлығын бір үшін тоқтатыңыз.
Dialogue: 0,0:13:48.07,0:13:51.37,Default,,0,0,0,,«Индивидуалдылық» денеге қол тигізу арқылы алынады
Dialogue: 0,0:13:52.54,0:13:57.00,Default,,0,0,0,,Сіз мені сандармен сынау қаупін ескеруіңіз керек еді.
Dialogue: 0,0:13:57.62,0:14:01.80,Default,,0,0,0,,Тәуекелді хеджирлеуді тоқтатқыңыз келсе де, ол одан бас тартуды білдіреді
Dialogue: 0,0:14:01.88,0:14:04.42,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:14:05.76,0:14:07.43,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:14.39,0:14:17.56,Default,,0,0,0,,«жеке тұлғаларды» көбірек қолдана бастады
Dialogue: 0,0:14:19.23,0:14:21.61,Default,,0,0,0,,Аман қалғандарды жіберме!
Dialogue: 0,0:14:21.69,0:14:24.36,Default,,0,0,0,,Қорғанысыңыз болса, итермеңіз! Қараңдар!
Dialogue: 0,0:14:25.07,0:14:28.66,Default,,0,0,0,,Ол тоқтады, шабуылды жалғастыр!
Dialogue: 0,0:14:29.91,0:14:34.66,Default,,0,0,0,,Осы кезеңде де, мен әлі күнге дейін қандай да бір нәрсені жасауға болады деп ойлаймын.
Dialogue: 0,0:14:35.45,0:14:39.71,Default,,0,0,0,,Маған жеткен жалғыз адам жоқ, әлі
Dialogue: 0,0:14:41.00,0:14:43.09,Default,,0,0,0,,Батыл емес
Dialogue: 0,0:14:43.17,0:14:47.30,Default,,0,0,0,,Бұл менің алтын жасымды білмегендіктен.
Dialogue: 0,0:14:48.43,0:14:53.89,Default,,0,0,0,,Барлық Құдірет есіне түспес бұрын көтеріле бастаған ұрпақ.
Dialogue: 0,0:14:53.97,0:14:59.19,Default,,0,0,0,,Олар туылған сәттен бастап барлық күш-қуат өсіп келе жатқан ұрпақ.
Dialogue: 0,0:15:01.69,0:15:04.57,Default,,0,0,0,,Ештеңе көрінбейтін қараңғыда
Dialogue: 0,0:15:04.65,0:15:09.53,Default,,0,0,0,,Алайда, «бір нәрседен» бәрі шошып кеткен кез болды.
Dialogue: 0,0:15:10.11,0:15:12.28,Default,,0,0,0,,Күдік пен реніш
Dialogue: 0,0:15:12.37,0:15:17.41,Default,,0,0,0,,Қанау мен кемсітушілікпен көмкерілген алтын қараңғылық!
Dialogue: 0,0:15:17.50,0:15:20.17,Default,,0,0,0,,Уф (Яраши) Жоқ, мен білемін!
Dialogue: 0,0:15:20.25,0:15:22.33,Default,,0,0,0,,Сіз білмедіңіз
Dialogue: 0,0:15:22.42,0:15:26.46,Default,,0,0,0,,Бұл қазіргі тарихта жақсы жасалған нәрсе.
Dialogue: 0,0:15:27.09,0:15:32.05,Default,,0,0,0,,Мен ең жақын досым Тодороки мен оның әкесі Эндеворға қарадым.
Dialogue: 0,0:15:32.14,0:15:33.89,Default,,0,0,0,,Мен сені қолдаймын деп шештім!
Dialogue: 0,0:15:33.97,0:15:38.27,Default,,0,0,0,,Қан ағымы қорқыныштан асып түседі!
Dialogue: 0,0:15:38.35,0:15:40.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:44.19,0:15:47.78,Default,,0,0,0,,Шабуылыңызды жел түрмесіне қойыңыз...
Dialogue: 0,0:15:48.78,0:15:51.95,Default,,0,0,0,,Сіз оны ұрлайсыз ба?
Dialogue: 0,0:15:53.87,0:15:54.95,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:55.03,0:15:57.45,Default,,0,0,0,,Инаса! Демалмаңыз!
Dialogue: 0,0:15:57.54,0:16:00.21,Default,,0,0,0,,Тоганы орау кезінде үрлеңіз!
Dialogue: 0,0:16:00.29,0:16:01.83,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.92,0:16:07.42,Default,,0,0,0,,Жел қатты соққанда менің «даралығым» күшейеді.
Dialogue: 0,0:16:08.05,0:16:10.34,Default,,0,0,0,,Ескі даңқыңнан
Dialogue: 0,0:16:10.42,0:16:16.55,Default,,0,0,0,,Мені қолдайтындардың жасаған болашағын көргім келеді!
Dialogue: 0,0:16:17.18,0:16:18.85,Default,,0,0,0,,Шынында…
Dialogue: 0,0:16:18.93,0:16:21.35,Default,,0,0,0,,Прогресс болады.
Dialogue: 0,0:16:22.39,0:16:24.40,Default,,0,0,0,,Бұл жерде болды
Dialogue: 0,0:16:25.40,0:16:26.98,Default,,0,0,0,,«Біреуі бәрі үшін»
Dialogue: 0,0:16:27.07,0:16:30.61,Default,,0,0,0,,Адамдардың жүрегінен иірілген күш кристалы
Dialogue: 0,0:16:31.15,0:16:33.45,Default,,0,0,0,,«Біреуі бәрі үшін» ғана емес
Dialogue: 0,0:16:33.53,0:16:36.20,Default,,0,0,0,,Сіз де байланыста болыңыз!
Dialogue: 0,0:16:38.37,0:16:40.37,Default,,0,0,0,,Бұл жаман көрініс.
Dialogue: 0,0:16:41.04,0:16:45.75,Default,,0,0,0,,Маған қарама, нұрыңды жоғалтпа
Dialogue: 0,0:16:46.58,0:16:48.84,Default,,0,0,0,,Жоқ, мен оны жоғалтып алдым.
Dialogue: 0,0:16:49.80,0:16:53.34,Default,,0,0,0,,Отын сияқты қосылып жатыр.
Dialogue: 0,0:16:56.18,0:17:01.06,Default,,0,0,0,,Бірақ мен "даралығымды" алып қоя ма деп қорқып, жақындай алмаймын
Dialogue: 0,0:17:01.14,0:17:04.06,Default,,0,0,0,,Жетеді, баратын жерің...
Dialogue: 0,0:17:07.56,0:17:09.32,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:17:11.48,0:17:14.36,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:17:15.28,0:17:18.78,Default,,0,0,0,,) Тіпті қараңғылықтың да дәмі әртүрлі.
Dialogue: 0,0:17:20.41,0:17:22.75,Default,,0,0,0,,Қараңғылықты айтпайсың ба
Dialogue: 0,0:17:24.37,0:17:28.29,Default,,0,0,0,,Сіз тудырған қараңғылықтың дәмі арық сияқты.
Dialogue: 0,0:17:28.38,0:17:29.67,Default,,0,0,0,,) Барлығы қазірдің өзінде
Dialogue: 0,0:17:29.75,0:17:31.63,Default,,0,0,0,,Мен оны жедім.
Dialogue: 0,0:17:33.72,0:17:38.14,Default,,0,0,0,,Кенет қара бұлттар жиналып, жарықты жауып тастады.
Dialogue: 0,0:17:38.22,0:17:40.51,Default,,0,0,0,,Қуаттың ұзақтығын арттырады
Dialogue: 0,0:17:41.14,0:17:45.64,Default,,0,0,0,,Ағаштарды аралап өткен шайқаста жалын азайып барады.
Dialogue: 0,0:17:47.69,0:17:49.56,Default,,0,0,0,,Бүкіл Құдірет айтты
Dialogue: 0,0:17:50.52,0:17:52.94,Default,,0,0,0,,Еңдеудің жалынын ұстасам да
Dialogue: 0,0:17:53.03,0:17:55.65,Default,,0,0,0,,Оның «даралығын» алып тастауға болмайды.
Dialogue: 0,0:17:56.74,0:18:01.03,Default,,0,0,0,,Сондықтан мен Хоуксты қолдау үшін таңдалдым.
Dialogue: 0,0:18:02.12,0:18:05.12,Default,,0,0,0,,Қараңғы көлеңке толығымен шығарылды!
Dialogue: 0,0:18:05.71,0:18:11.75,Default,,0,0,0,,Сіз Токоями-кун, жауынгерлерден қосымша көмек алғаннан кейін бірден осы жағдайға дайындалдыңыз ба?
Dialogue: 0,0:18:11.84,0:18:13.71,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:18:13.80,0:18:16.59,Default,,0,0,0,,Артқы жел!
Dialogue: 0,0:18:22.76,0:18:26.81,Default,,0,0,0,,Егер мен сенімен аз да болса қосыла алсам
Dialogue: 0,0:18:26.89,0:18:29.56,Default,,0,0,0,,Менде мына лас қауырсындар бар екеніне қуаныштымын!
Dialogue: 0,0:18:30.36,0:18:34.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:37.61,0:18:40.87,Default,,0,0,0,,Тұңғиық қараңғы, жарық!
Dialogue: 0,0:18:42.99,0:18:48.29,Default,,0,0,0,,♪～
Dialogue: 0,0:20:07.95,0:20:12.96,Default,,0,0,0,,～♪
Dialogue: 0,0:20:14.46,0:20:16.63,Default,,0,0,0,,Уақыт кері кетеді
Dialogue: 0,0:20:16.71,0:20:19.09,Default,,0,0,0,,Сол сәт...
Dialogue: 0,0:20:20.38,0:20:21.88,Default,,0,0,0,,Барлығын қатыстыру
Dialogue: 0,0:20:21.97,0:20:24.80,Default,,0,0,0,,Өкпесін кетіргісі келетін адам
Dialogue: 0,0:20:25.39,0:20:28.81,Default,,0,0,0,,Қызға елге аттанған.
Dialogue: 0,0:20:28.89,0:20:30.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:30.81,0:20:32.73,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:20:34.15,0:20:36.69,Default,,0,0,0,,Екі адам білген
Dialogue: 0,0:20:39.03,0:20:42.15,Default,,0,0,0,,Жағдай әлі жақсы емес.
Dialogue: 0,0:20:42.24,0:20:47.08,Default,,0,0,0,,Жағдай әлі нашар емес.
Dialogue: 0,0:20:49.70,0:20:50.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.70,0:20:52.62,Default,,0,0,0,,Хамф!
Dialogue: 0,0:21:03.30,0:21:05.93,Default,,0,0,0,,Бұл жай ғана тілек.
Dialogue: 0,0:21:06.01,0:21:09.14,Default,,0,0,0,,Бұл ең нашар, бірақ әлі де ең нашар емес.
Dialogue: 0,0:21:09.97,0:21:12.73,Default,,0,0,0,,Бірінші қозғалыста Барлығы бір үшін немесе Дабиге түрлендіру
Dialogue: 0,0:21:12.81,0:21:15.40,Default,,0,0,0,,Егер ол «қос» деп шығарылса, біткен болар еді.
Dialogue: 0,0:21:15.98,0:21:18.52,Default,,0,0,0,,Бірақ бұл болмады.
Dialogue: 0,0:21:18.61,0:21:21.90,Default,,0,0,0,,Онда бізде сол жерден жеңіске жету мүмкіндігін табудан басқа амал жоқ.
Dialogue: 0,0:21:23.03,0:21:25.61,Default,,0,0,0,,Адамдар екі есе «қос» өсті
Dialogue: 0,0:21:25.70,0:21:26.78,Default,,0,0,0,,«Индивидуалдылықты» қолдана алады
Dialogue: 0,0:21:27.87,0:21:30.54,Default,,0,0,0,,Бірақ егер Уравиттілік мен естігендей болса.
Dialogue: 0,0:21:30.62,0:21:35.46,Default,,0,0,0,,Химико-чанның «өзгеруі» өзіне ұнайтын адамның «индивидуалдылығын» ғана пайдалана алады.
Dialogue: 0,0:21:36.83,0:21:38.71,Default,,0,0,0,,Менің ойымша, бұл үйлесімділік пе?
Dialogue: 0,0:21:38.79,0:21:41.38,Default,,0,0,0,,«Трансформациядан» «қос» адамдарға
Dialogue: 0,0:21:41.46,0:21:42.67,Default,,0,0,0,,Химико-чанның шарттары
Dialogue: 0,0:21:42.76,0:21:45.47,Default,,0,0,0,,Егер сіз бортқа отыра бастасаңыз.
Dialogue: 0,0:21:45.55,0:21:47.01,Default,,0,0,0,,Химиконың «ұнауы»
Dialogue: 0,0:21:47.09,0:21:50.64,Default,,0,0,0,,Мүмкін, ол қураған ағаштарға қатысты емес және қолдануға болмайды.
Dialogue: 0,0:21:51.76,0:21:54.60,Default,,0,0,0,,Бұл белгіден мүлдем тыс болуы мүмкін.
Dialogue: 0,0:21:54.68,0:21:56.81,Default,,0,0,0,,Бірақ бұл төтенше жағдай
Dialogue: 0,0:21:57.56,0:22:01.82,Default,,0,0,0,,Шарттар бір ғана сезіммен бір секундта өзгерсе, таң қалмас еді.
Dialogue: 0,0:22:02.44,0:22:06.40,Default,,0,0,0,,Бұған жол бермеу үшін біз тез арада нақты нәрсені табуымыз керек.
Dialogue: 0,0:22:07.82,0:22:09.45,Default,,0,0,0,,Хмм. Нацу-кун, сен жақсы көрінесің.
Dialogue: 0,0:22:11.53,0:22:14.62,Default,,0,0,0,,Енді Химико Тога...
Dialogue: 0,0:22:17.08,0:22:20.38,Default,,0,0,0,,Неге... Неге...
Dialogue: 0,0:22:21.75,0:22:24.09,Default,,0,0,0,,Садманның шеруі
Dialogue: 0,0:22:24.17,0:22:28.18,Default,,0,0,0,,Аянышты марш жалғаса берсін.
Dialogue: 0,0:22:28.26,0:22:31.72,Default,,0,0,0,,Батырлар жойылады
Dialogue: 0,0:22:32.31,0:22:33.68,Default,,0,0,0,,Неге...
Dialogue: 0,0:22:34.97,0:22:38.06,Default,,0,0,0,,Мен Су-кунды да, Туя-кунды да жақсы көремін.
Dialogue: 0,0:22:38.14,0:22:42.48,Default,,0,0,0,,Ол Джин мен Очако сияқты өзінің «даралығын» көрсете алмайды.
Dialogue: 0,0:22:42.57,0:22:45.49,Default,,0,0,0,,Батырлар жойылды
Dialogue: 0,0:22:47.07,0:22:49.66,Default,,0,0,0,,Мен мұны осы шайқас алдында сынап көрдім.
Dialogue: 0,0:22:49.74,0:22:51.57,Default,,0,0,0,,Оны шығару мүмкін болмады
Dialogue: 0,0:22:51.66,0:22:55.62,Default,,0,0,0,,Мен сені сүйсем де... Мен сені "сүйе" алуым керек болса да
Dialogue: 0,0:22:55.70,0:22:58.62,Default,,0,0,0,,Батырлар жойылады!
Dialogue: 0,0:23:00.42,0:23:03.42,Default,,0,0,0,,Джин-кун мұны істей алады.
Dialogue: 0,0:23:04.34,0:23:06.71,Default,,0,0,0,,Батырлар жойылды
Dialogue: 0,0:23:06.80,0:23:09.18,Default,,0,0,0,,Батырлар жойылды Батырлар жойылды
Dialogue: 0,0:23:09.26,0:23:11.64,Default,,0,0,0,,Батырлар жойылды...
Dialogue: 0,0:23:13.85,0:23:18.27,Default,,0,0,0,,Мен неге Джинкун бола алмаймын?
Dialogue: 0,0:23:22.31,0:23:23.82,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:24.32,0:23:28.95,Default,,0,0,0,,Батырлардың алдында сорақы келеді.
Dialogue: 0,0:23:29.57,0:23:31.95,Default,,0,0,0,,Бәрін басым күшпен жойыңыз
Dialogue: 0,0:23:32.57,0:23:36.24,Default,,0,0,0,,Адамдардың жүрегінде талай із қалдырған болмыс.
Dialogue: 0,0:23:36.33,0:23:39.58,Default,,0,0,0,,Иә, ол кісі...
Dialogue: 0,0:23:40.37,0:23:43.54,Default,,0,0,0,,Келесі жолы «Бұл кішкентай әлем»
Dialogue: 0,0:23:44.13,0:23:46.92,Default,,0,0,0,,Жоқ, жағдай әлі нашар емес.
Dialogue: 0,0:23:47.67,0:23:50.93,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.43,0:23:58.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
