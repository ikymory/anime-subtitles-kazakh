Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.83,0:00:04.00,Default,,0,0,0,,Жапонияның өтініші бойынша
Dialogue: 0,0:00:04.08,0:00:06.38,Default,,0,0,0,,Жапонияға төтенше жағдайда келген Американың бірінші батыры
Dialogue: 0,0:00:06.46,0:00:08.00,Default,,0,0,0,,Жұлдыздар мен жолақтар
Dialogue: 0,0:00:08.09,0:00:11.63,Default,,0,0,0,,Содан Шигараки Соу оған шабуыл жасады.
Dialogue: 0,0:00:12.76,0:00:15.97,Default,,0,0,0,,Жұлдыз – әлем ережелерін өзгертетін «тұлға».
Dialogue: 0,0:00:16.05,0:00:18.97,Default,,0,0,0,,Өлі ағашты бұрышқа қою үшін «Жаңа тәртіпті» пайдалану
Dialogue: 0,0:00:19.81,0:00:22.94,Default,,0,0,0,,Жіңішке есеппен жеңілу
Dialogue: 0,0:00:23.73,0:00:26.69,Default,,0,0,0,,Бірақ жұлдыз өмірдің шоғын жағады
Dialogue: 0,0:00:27.36,0:00:28.61,Default,,0,0,0,,Өлген ағаштың “даралығына”
Dialogue: 0,0:00:28.69,0:00:32.45,Default,,0,0,0,,Бұл орасан зор зиян келтіргені белгілі болды.
Dialogue: 0,0:00:33.53,0:00:36.91,Default,,0,0,0,,Өлген ағаш кем дегенде бір апта қозғала алмайды.
Dialogue: 0,0:00:36.99,0:00:40.95,Default,,0,0,0,,Бұл Жұлдыздар мен Жолақтар қалдырған соңғы қайтару.
Dialogue: 0,0:00:41.70,0:00:45.79,Default,,0,0,0,,Өзіңізді және қорғағыңыз келетін нәрсені қорғау үшін
Dialogue: 0,0:00:45.88,0:00:50.96,Default,,0,0,0,,Күшіңізді аз да болса жақсарту үшін осы жеңілдік кезеңін пайдаланыңыз.
Dialogue: 0,0:00:51.05,0:00:56.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:15.92,0:02:20.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.27,0:02:28.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:28.52,0:02:30.94,Default,,0,0,0,,А... Уф...
Dialogue: 0,0:02:31.02,0:02:32.77,Default,,0,0,0,,Ол әлі тірі ғана емес, сонымен бірге Уэсато орта мектебінде болуы ықтимал.
Dialogue: 0,0:02:32.86,0:02:35.94,Default,,0,0,0,,Жарайды, басқасы мен.
Dialogue: 0,0:02:36.03,0:02:38.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:36.03,0:02:38.20,Default,,0,0,0,,(Өлі ағаш жылайды)
Dialogue: 0,0:02:38.20,0:02:38.28,Default,,0,0,0,,(Өлі ағаш жылайды)
Dialogue: 0,0:02:38.28,0:02:41.03,Default,,0,0,0,,(Өлі ағаш жылайды)
Dialogue: 0,0:02:38.28,0:02:41.03,Default,,0,0,0,,Тек факторлар араласып, дұрыс жұмыс істемейді.
Dialogue: 0,0:02:41.03,0:02:41.95,Default,,0,0,0,,Бұл жай ғана факторлар араласып, қиындықтар туғызады.
Dialogue: 0,0:02:42.70,0:02:46.66,Default,,0,0,0,,Уақыт өте келе, сіз өзіңіздің «даралығыңызды» қайтадан пайдалана аласыз.
Dialogue: 0,0:02:47.37,0:02:52.17,Default,,0,0,0,,Мен сені өлтіремін, сені өлтіремін, сені жек көремін...
Dialogue: 0,0:02:53.04,0:02:57.09,Default,,0,0,0,,Біреу Бүкіл Құдірет жағын есіне алғанша
Dialogue: 0,0:02:57.17,0:02:59.47,Default,,0,0,0,,Бұл тітіркену кетпейді!
Dialogue: 0,0:02:59.55,0:03:00.55,Default,,0,0,0,,Сана бірігуде
Dialogue: 0,0:03:00.55,0:03:02.80,Default,,0,0,0,,Сана бірігуде
Dialogue: 0,0:03:00.55,0:03:02.80,Default,,0,0,0,,Ол әлі тірі ғана емес, сонымен бірге Уэсато орта мектебінде болуы ықтимал.
Dialogue: 0,0:03:02.80,0:03:03.26,Default,,0,0,0,,Сана бірігуде
Dialogue: 0,0:03:03.35,0:03:04.93,Default,,0,0,0,,Ол жіберіледі
Dialogue: 0,0:03:05.51,0:03:07.64,Default,,0,0,0,,зорлық-зомбылық ашу
Dialogue: 0,0:03:07.73,0:03:11.94,Default,,0,0,0,,Жоқтаушылардың өшпенділігіне ортақпын.
Dialogue: 0,0:03:12.02,0:03:15.61,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:03:16.36,0:03:18.53,Default,,0,0,0,,«Жаңа тәртіпті» алып тастау мүмкін болмады, бірақ
Dialogue: 0,0:03:18.61,0:03:22.62,Default,,0,0,0,,Ең үлкен кедергі жойылды деп айтуға болады.
Dialogue: 0,0:03:22.70,0:03:24.83,Default,,0,0,0,,Менің алғашқы шайқас жаттығуым…
Dialogue: 0,0:03:24.91,0:03:29.08,Default,,0,0,0,,Бір жоспарды ұстану жақсы емес.
Dialogue: 0,0:03:30.04,0:03:33.42,Default,,0,0,0,,Дайындалу үшін қиналғаныңа мен кінәлімін.
Dialogue: 0,0:03:33.50,0:03:35.29,Default,,0,0,0,,Мен біраз уақыт тұрамын.
Dialogue: 0,0:03:35.38,0:03:37.42,Default,,0,0,0,,Бұл мүмкін емес, бұл шек.
Dialogue: 0,0:03:37.50,0:03:41.30,Default,,0,0,0,,Қарт бүгін де ұшады. Мен шыдай алмаймын.
Dialogue: 0,0:03:41.38,0:03:43.34,Default,,0,0,0,,Тоя-кун
Dialogue: 0,0:03:43.43,0:03:46.68,Default,,0,0,0,,Сіз бен біз ұқсаспыз, бірақ бір айырмашылығы бар.
Dialogue: 0,0:03:46.76,0:03:47.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:48.47,0:03:49.48,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:50.27,0:03:53.48,Default,,0,0,0,,Адам ретінде менің бір мақсатым бар.
Dialogue: 0,0:03:53.56,0:03:58.44,Default,,0,0,0,,Алдын ала бірнеше маршрут жасаңыз
Dialogue: 0,0:03:59.19,0:04:02.57,Default,,0,0,0,,Төтенше жағдайда қолдануға болатын маршруттар
Dialogue: 0,0:04:02.66,0:04:06.99,Default,,0,0,0,,Ол жылдар немесе ондаған жылдар бойы жасалған.
Dialogue: 0,0:04:07.08,0:04:12.37,Default,,0,0,0,,Ең жақсы жолды таңдап, оны мақсатыңызға қосыңыз.
Dialogue: 0,0:04:12.46,0:04:13.87,Default,,0,0,0,,Иә
Dialogue: 0,0:04:14.58,0:04:16.25,Default,,0,0,0,,Сансыз маршруттар бар
Dialogue: 0,0:04:17.75,0:04:20.76,Default,,0,0,0,,Артында мінсіз дене қалды.
Dialogue: 0,0:04:20.84,0:04:25.22,Default,,0,0,0,,Изуку Мидория күшті қаһарманға айналды.
Dialogue: 0,0:04:26.05,0:04:31.68,Default,,0,0,0,,Тоядан айырмашылығы менің достарым көп.
Dialogue: 0,0:04:36.52,0:04:38.65,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:04:39.23,0:04:40.48,Default,,0,0,0,,Құстар!
Dialogue: 0,0:04:41.49,0:04:43.03,Default,,0,0,0,,О, ау!
Dialogue: 0,0:04:43.11,0:04:44.74,Default,,0,0,0,,Тұңғиық қара дене!
Dialogue: 0,0:04:45.49,0:04:47.24,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:04:47.32,0:04:49.03,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:04:49.12,0:04:50.95,Default,,0,0,0,,Ол бұның пайдасыз екенін ауыр тәжірибе арқылы үйренген болар еді
Dialogue: 0,0:04:51.04,0:04:52.79,Default,,0,0,0,,Ол Гран Торинодан әлдеқайда жылдам.
Dialogue: 0,0:04:52.87,0:04:55.17,Default,,0,0,0,,Хмф! О ла ла ла!
Dialogue: 0,0:04:56.21,0:04:57.04,Default,,0,0,0,,Zuma-ны зарядтаңыз!
Dialogue: 0,0:04:57.13,0:04:59.13,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:01.59,0:05:04.59,Default,,0,0,0,,Ораора, ораора, ораора, ораора!
Dialogue: 0,0:05:05.63,0:05:07.26,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:05:07.89,0:05:08.72,Default,,0,0,0,,FROPPY!
Dialogue: 0,0:05:08.80,0:05:10.06,Default,,0,0,0,,Уравитациялық!
Dialogue: 0,0:05:10.14,0:05:12.56,Default,,0,0,0,,Метеор... (бақаның үрлеуі) Фафроки!
Dialogue: 0,0:05:15.44,0:05:16.40,Default,,0,0,0,,«Қара қамшы»!
Dialogue: 0,0:05:16.48,0:05:17.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:18.98,0:05:19.90,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:05:19.98,0:05:21.82,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:05:22.90,0:05:24.32,Default,,0,0,0,,Бұл қажет болды!
Dialogue: 0,0:05:24.40,0:05:26.03,Default,,0,0,0,,Ах
Dialogue: 0,0:05:27.53,0:05:29.49,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:34.29,0:05:38.00,Default,,0,0,0,,Мен Endeavour бағдарламасында не білдім: Сақтау және босату
Dialogue: 0,0:05:38.08,0:05:40.09,Default,,0,0,0,,Бір ғана ату емес
Dialogue: 0,0:05:40.17,0:05:43.55,Default,,0,0,0,,Тер моншақтарын жасап, оларды бір уақытта бірнеше рет қайталау
Dialogue: 0,0:05:43.63,0:05:45.88,Default,,0,0,0,,Бұл жаңа шекаралық кластер
Dialogue: 0,0:05:45.97,0:05:49.89,Default,,0,0,0,,Бұдан былай менің барлық дағдыларым шыңдалады.
Dialogue: 0,0:05:49.97,0:05:52.06,Default,,0,0,0,,Денені қыздыруға көп уақыт кетеді.
Dialogue: 0,0:05:52.14,0:05:54.81,Default,,0,0,0,,А, сондықтан қыстық киім.
Dialogue: 0,0:05:54.89,0:05:58.60,Default,,0,0,0,,Ыстық, дене күшім азайып кетті, сондықтан қайсысын таңдау керек?
Dialogue: 0,0:05:58.69,0:06:03.07,Default,,0,0,0,,Тодороки-кунның да атмосферасы бұрынғыдан өзгеше.
Dialogue: 0,0:06:03.94,0:06:06.40,Default,,0,0,0,,Мен оны әлі түсініп жүрмін.
Dialogue: 0,0:06:06.49,0:06:09.70,Default,,0,0,0,,Сол жақ басқару оң жаққа жетуі керек еді.
Dialogue: 0,0:06:10.57,0:06:12.37,Default,,0,0,0,,Дабидің отынан күймейтін дене...
Dialogue: 0,0:06:15.37,0:06:16.83,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:16.91,0:06:19.75,Default,,0,0,0,,Бір дененің оң және сол жағы
Dialogue: 0,0:06:22.25,0:06:23.92,Default,,0,0,0,,Я...
Dialogue: 0,0:06:24.00,0:06:26.72,Default,,0,0,0,,Бүкіл Құдірет жаппай соғысты.
Dialogue: 0,0:06:26.80,0:06:27.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.84,0:06:31.10,Default,,0,0,0,,Екі жау (жауыз) генерал қазір әлсіз шығар.
Dialogue: 0,0:06:31.18,0:06:35.43,Default,,0,0,0,,Гигантомахия да ұстамды және ұйықтап қалды, солай ма?
Dialogue: 0,0:06:35.52,0:06:38.77,Default,,0,0,0,,Екі генералды тапсақ, бұл жолы барамыз, солай ма?
Dialogue: 0,0:06:38.85,0:06:40.52,Default,,0,0,0,,Шамамен 3 ұпай Амае
Dialogue: 0,0:06:40.60,0:06:42.56,Default,,0,0,0,,Иә? Үш тым тәтті ме?
Dialogue: 0,0:06:42.65,0:06:45.69,Default,,0,0,0,,Біріншіден, мен оны таба алмайтын шығармын.
Dialogue: 0,0:06:46.28,0:06:49.53,Default,,0,0,0,,Осы уақытқа дейін мисыз ангар мен қураған ағаштың жасырынуы
Dialogue: 0,0:06:49.61,0:06:51.82,Default,,0,0,0,,Тіпті зерттеу нысаны табылса да
Dialogue: 0,0:06:51.91,0:06:53.49,Default,,0,0,0,,Бүкіл Құдірет-тен жеңілгеннен кейін
Dialogue: 0,0:06:53.58,0:06:57.12,Default,,0,0,0,,Мен оны ешқашан таба алмадым.
Dialogue: 0,0:06:57.20,0:06:59.75,Default,,0,0,0,,Жүгіріп, тығыла алсаң, дүниедегі ең жақсысың.
Dialogue: 0,0:06:59.83,0:07:01.67,Default,,0,0,0,,Ол жүзі алтын
Dialogue: 0,0:07:01.75,0:07:03.00,Default,,0,0,0,,Симо, тоқтат.
Dialogue: 0,0:07:03.59,0:07:04.46,Default,,0,0,0,,2-бөлім
Dialogue: 0,0:07:05.09,0:07:09.72,Default,,0,0,0,,Алдымен, біз соңғы рет шайқасқан қураған ағаш толық емес күйде болды...
Dialogue: 0,0:07:10.80,0:07:14.01,Default,,0,0,0,,Біздің әскери күшіміздің айтарлықтай қысқаруын ескере отырып,
Dialogue: 0,0:07:14.10,0:07:16.77,Default,,0,0,0,,Қазіргі жағдай 50% деп айтуға бола ма...
Dialogue: 0,0:07:16.85,0:07:17.68,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:07:18.52,0:07:19.69,Default,,0,0,0,,Сонымен 3
Dialogue: 0,0:07:20.31,0:07:23.36,Default,,0,0,0,,Екінші жағы қақпақты кесу уақытын басқарады.
Dialogue: 0,0:07:23.44,0:07:25.40,Default,,0,0,0,,Рагдолл ұрланған -
Dialogue: 0,0:07:25.48,0:07:28.78,Default,,0,0,0,,«Тұлғаны» алыстан анықтауға мүмкіндік беретін «Іздеу».
Dialogue: 0,0:07:29.44,0:07:32.20,Default,,0,0,0,,Тіпті американдық соғыс кезінде бұл «индивидуалдылық» жоғалып кетсе де
Dialogue: 0,0:07:32.28,0:07:34.78,Default,,0,0,0,,Екінші қадам болмай қалса керек
Dialogue: 0,0:07:34.87,0:07:38.66,Default,,0,0,0,,Сондықтан бізде қазіргі үмітсіз адам толқынының тактикасы бар.
Dialogue: 0,0:07:38.75,0:07:40.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:40.12,0:07:42.37,Default,,0,0,0,,Ендеше, ең болмағанда, қалай екенін айтыңыз
Dialogue: 0,0:07:42.46,0:07:44.96,Default,,0,0,0,,Енді сіз қураған ағаштардың қозғалысын бағыттай аласыз.
Dialogue: 0,0:07:45.04,0:07:46.88,Default,,0,0,0,,Мен де бірден іздеуге шықтым...
Dialogue: 0,0:07:46.96,0:07:49.26,Default,,0,0,0,,«Біз», солай ма?
Dialogue: 0,0:07:49.34,0:07:51.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:51.30,0:07:53.39,Default,,0,0,0,,Дұрыс, Мидория! (Изуку) Ха...
Dialogue: 0,0:08:02.85,0:08:04.02,Default,,0,0,0,,Иә
Dialogue: 0,0:08:05.44,0:08:08.61,Default,,0,0,0,,Хмм... Дұрыс.
Dialogue: 0,0:08:08.69,0:08:10.53,Default,,0,0,0,,Серуендеуге болады, солай ма?
Dialogue: 0,0:08:10.61,0:08:12.11,Default,,0,0,0,,Белгілі бір дәрежеде
Dialogue: 0,0:08:12.20,0:08:14.45,Default,,0,0,0,,Ұрақаның сөзіне жауап ретінде
Dialogue: 0,0:08:14.53,0:08:17.20,Default,,0,0,0,,Батырлар класы мен босқындар арасындағы байланыс жеңілдетілді.
Dialogue: 0,0:08:17.20,0:08:18.04,Default,,0,0,0,,Батырлар класы мен босқындар арасындағы байланыс жеңілдетілді.
Dialogue: 0,0:08:17.20,0:08:18.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:19.70,0:08:20.70,Default,,0,0,0,,Соңында...
Dialogue: 0,0:08:21.37,0:08:24.88,Default,,0,0,0,,Мен сені бұрыштасам да, сені бұрыштамасам да, Барлығы бір үшін
Dialogue: 0,0:08:25.75,0:08:27.50,Default,,0,0,0,,Күлесің бе?
Dialogue: 0,0:08:30.34,0:08:35.01,Default,,0,0,0,,Гуншо/Хебукуро шайқасы аяқталғаннан бері өзімді жақсы сезінбеймін.
Dialogue: 0,0:08:35.51,0:08:37.76,Default,,0,0,0,,Барлығына бірдей болды.
Dialogue: 0,0:08:38.64,0:08:40.52,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:08:40.60,0:08:43.48,Default,,0,0,0,,Әлгі адам тағы да нұсқау берді.
Dialogue: 0,0:08:43.56,0:08:45.69,Default,,0,0,0,,Жарайды, бұрынғыдай.
Dialogue: 0,0:08:45.77,0:08:48.40,Default,,0,0,0,,Ұсталса да, оны азаматтық күнделікті өмірде қолдануға болады.
Dialogue: 0,0:08:48.48,0:08:50.28,Default,,0,0,0,,Ол шифрланған.
Dialogue: 0,0:08:50.36,0:08:53.11,Default,,0,0,0,,Бұл бақылау үшін соқыр нүкте болар еді, солай ма?
Dialogue: 0,0:08:53.74,0:08:55.36,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:08:55.45,0:08:57.87,Default,,0,0,0,,Мидория-кун қайтып келгеннен кейін де
Dialogue: 0,0:08:57.95,0:09:01.87,Default,,0,0,0,,Сен күлмедің, сондықтан мен уайымдадым...
Dialogue: 0,0:09:01.95,0:09:03.12,Default,,0,0,0,,Каминоға дейін
Dialogue: 0,0:09:03.21,0:09:06.29,Default,,0,0,0,,Сіз «Барлығы бір үшін» айтқанын орындадыңыз.
Dialogue: 0,0:09:06.38,0:09:09.21,Default,,0,0,0,,Олай етпесек, бізді өлтіреді.
Dialogue: 0,0:09:10.00,0:09:11.00,Default,,0,0,0,,Талғампаздық
Dialogue: 0,0:09:11.09,0:09:12.46,Default,,0,0,0,,(Аояманың жылауы)
Dialogue: 0,0:09:12.55,0:09:14.30,Default,,0,0,0,,Мектепке кіргеннен кейін көп ұзамай
Dialogue: 0,0:09:14.38,0:09:16.80,Default,,0,0,0,,Сіз сол адамның сұрауына сәтті жауап бердіңіз.
Dialogue: 0,0:09:16.89,0:09:21.31,Default,,0,0,0,,Тіпті оқу-жаттығу жиынында да сен маған қайда екеніңді ешкім білмей айта алдың.
Dialogue: 0,0:09:22.81,0:09:25.56,Default,,0,0,0,,АҚШ-та кенеттен жау (жауыз) пайда болды
Dialogue: 0,0:09:26.19,0:09:29.40,Default,,0,0,0,,Орман мектебінде оқып жүрген кезімде де мен орналасқан жерді құпия ұстадым.
Dialogue: 0,0:09:29.48,0:09:31.36,Default,,0,0,0,,Жау (жауыз) келді
Dialogue: 0,0:09:32.11,0:09:33.57,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:09:33.65,0:09:38.20,Default,,0,0,0,,Біз мұны ешқашан махаббат үшін жасаған емеспіз.
Dialogue: 0,0:09:38.28,0:09:42.79,Default,,0,0,0,,Бірақ тым кеш, тым кеш
Dialogue: 0,0:09:43.29,0:09:45.79,Default,,0,0,0,,Маман папан
Dialogue: 0,0:09:45.87,0:09:48.21,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:09:48.96,0:09:51.46,Default,,0,0,0,,Бұл... бұл өтірік.
Dialogue: 0,0:09:51.55,0:09:55.42,Default,,0,0,0,,Өтірік Аояма-кун... Аояма-кун...
Dialogue: 0,0:09:55.51,0:10:01.72,Default,,0,0,0,,Біз сенің бақытыңды табуыңды қаладық.
Dialogue: 0,0:10:01.81,0:10:03.97,Default,,0,0,0,,Басқалармен талғампаз болған жақсы ма?
Dialogue: 0,0:10:04.06,0:10:09.52,Default,,0,0,0,,Иә, өйткені басқалардан ерекше болу өте қорқынышты.
Dialogue: 0,0:10:09.60,0:10:12.40,Default,,0,0,0,,Сіз «даралығысыз» туылғансыз
Dialogue: 0,0:10:12.48,0:10:14.32,Default,,0,0,0,,Барлығынан тыс қалмаңыз
Dialogue: 0,0:10:15.07,0:10:18.07,Default,,0,0,0,,Біз армандарымызға барлығымен бірге жету үшін.
Dialogue: 0,0:10:18.16,0:10:21.37,Default,,0,0,0,,Тек соны тілеймін...
Dialogue: 0,0:10:21.45,0:10:22.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:23.08,0:10:25.25,Default,,0,0,0,,Егер мен бұлай болатынын білсем
Dialogue: 0,0:10:25.33,0:10:27.79,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:10:27.87,0:10:31.13,Default,,0,0,0,,Біреу үшін Барлығы «даралығын» алады
Dialogue: 0,0:10:31.21,0:10:33.71,Default,,0,0,0,,Бірақ біз...
Dialogue: 0,0:10:34.42,0:10:36.76,Default,,0,0,0,,Сіз қатысқаннан кейін,
Dialogue: 0,0:10:36.84,0:10:39.38,Default,,0,0,0,,Біреу үшін барлығынан қашып құтыла алмайсыз.
Dialogue: 0,0:10:39.47,0:10:41.39,Default,,0,0,0,,Міне, бастаймыз! Ал, қабыл ал!
Dialogue: 0,0:10:41.47,0:10:44.18,Default,,0,0,0,,Біреу... Мұғалімге біреу...
Dialogue: 0,0:10:44.26,0:10:45.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:45.72,0:10:48.77,Default,,0,0,0,,Ол үнемі ауыратын.
Dialogue: 0,0:10:48.85,0:10:52.81,Default,,0,0,0,,Мен әрқашан күдік тудырмайтындай әрекет еттім.
Dialogue: 0,0:10:52.90,0:10:54.98,Default,,0,0,0,,Себебі, мен кінәлі сезіммен жаншылдым.
Dialogue: 0,0:10:55.07,0:10:56.36,Default,,0,0,0,,(Аояманың жұтып қойған дыбысы)
Dialogue: 0,0:10:56.44,0:10:59.28,Default,,0,0,0,,Мен өзімді батыл әрекетке мәжбүр еттім.
Dialogue: 0,0:11:00.78,0:11:02.99,Default,,0,0,0,,«Барлығы бір үшін» Джиннода қолға түскенде
Dialogue: 0,0:11:04.03,0:11:07.75,Default,,0,0,0,,Менде қорқынышты түсінбеушілік болды.
Dialogue: 0,0:11:08.54,0:11:11.25,Default,,0,0,0,,«Енді біз барлығымен бірге бола аламыз»...
Dialogue: 0,0:11:11.33,0:11:12.83,Default,,0,0,0,,Әй, әсемдік
Dialogue: 0,0:11:12.92,0:11:16.13,Default,,0,0,0,,Мені кешіріңіз. Біздің ақымақтығымызды кешіре көр...
Dialogue: 0,0:11:16.21,0:11:19.80,Default,,0,0,0,,Маман мен Папанды қорғағым келеді.
Dialogue: 0,0:11:20.51,0:11:22.43,Default,,0,0,0,,Мен сенің өлгеніңді қаламаймын!
Dialogue: 0,0:11:23.26,0:11:24.55,Default,,0,0,0,,Талғампаздық
Dialogue: 0,0:11:24.64,0:11:29.68,Default,,0,0,0,,Бізге көмектесші, рақым!
Dialogue: 0,0:11:29.77,0:11:31.02,Default,,0,0,0,,Хмм (Аояманың анасы) Ха!
Dialogue: 0,0:11:35.15,0:11:36.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.65,0:11:44.28,Default,,0,0,0,,Мм... Хагакуре мырзадан бірдеңе естідім...
Dialogue: 0,0:11:44.37,0:11:47.29,Default,,0,0,0,,Енді, инсайдер... у...
Dialogue: 0,0:11:47.37,0:11:48.75,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:48.83,0:11:51.04,Default,,0,0,0,,Мен бірдеңені қате естідім бе?
Dialogue: 0,0:11:52.58,0:11:54.17,Default,,0,0,0,,Мидория-кун...
Dialogue: 0,0:11:55.25,0:11:56.92,Default,,0,0,0,,Мидория-кун...
Dialogue: 0,0:11:57.75,0:11:58.80,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:11:59.67,0:12:01.97,Default,,0,0,0,,Мен ғана ештеңе айта алмай қалдым.
Dialogue: 0,0:12:03.30,0:12:06.81,Default,,0,0,0,,Сыныптағылардың барлығы бірінен соң бірі сізді шақырып жатқанда,
Dialogue: 0,0:12:08.18,0:12:11.27,Default,,0,0,0,,Барлығы көмекке ұмтылуда
Dialogue: 0,0:12:12.35,0:12:15.31,Default,,0,0,0,,Ол кезде мен жалғыз едім...
Dialogue: 0,0:12:16.94,0:12:18.78,Default,,0,0,0,,Аояма-кун, мен...
Dialogue: 0,0:12:18.86,0:12:20.11,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:12:21.15,0:12:22.57,Default,,0,0,0,,«Менің күшім»
Dialogue: 0,0:12:22.65,0:12:27.12,Default,,0,0,0,,«Бұл маған Бүкіл Құдірет берген ерекше нәрсе...»
Dialogue: 0,0:12:27.20,0:12:28.54,Default,,0,0,0,,Сізге...
Dialogue: 0,0:12:29.20,0:12:32.29,Default,,0,0,0,,Мен әрқашан тең болғым келді.
Dialogue: 0,0:12:32.37,0:12:34.17,Default,,0,0,0,,Сізге...
Dialogue: 0,0:12:34.25,0:12:36.13,Default,,0,0,0,,Мен... (Аояма) Ах.
Dialogue: 0,0:12:36.21,0:12:39.25,Default,,0,0,0,,Жалғыз Аояма-кунның жүзі мұңайып тұрды.
Dialogue: 0,0:12:40.26,0:12:43.59,Default,,0,0,0,,Мен сонда бірдеңе бар деп ойлап, іздеп келдім.
Dialogue: 0,0:12:44.18,0:12:45.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:46.18,0:12:50.35,Default,,0,0,0,,Иә, тек мен...
Dialogue: 0,0:12:51.14,0:12:53.06,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:12:54.31,0:12:56.61,Default,,0,0,0,,USJ және оқу-жаттығу лагері...
Dialogue: 0,0:12:56.69,0:12:57.69,Default,,0,0,0,,Талғампаздық!
Dialogue: 0,0:12:57.77,0:13:00.53,Default,,0,0,0,,Мен басшылық жасадым
Dialogue: 0,0:13:01.44,0:13:04.03,Default,,0,0,0,,Мидория-кун, мен...
Dialogue: 0,0:13:05.28,0:13:07.41,Default,,0,0,0,,Скамның жауы (зұлым)
Dialogue: 0,0:13:16.79,0:13:19.42,Default,,0,0,0,,(Өлі ағаш жылайды)
Dialogue: 0,0:13:20.38,0:13:24.51,Default,,0,0,0,,Тоядан айырмашылығы менің достарым көп.
Dialogue: 0,0:13:24.59,0:13:25.97,Default,,0,0,0,,Сәлем досым
Dialogue: 0,0:13:26.64,0:13:30.22,Default,,0,0,0,,Егер бұл анықталса, бұл бізге жаман болмай ма?
Dialogue: 0,0:13:30.31,0:13:31.68,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:13:32.43,0:13:36.94,Default,,0,0,0,,100 иендік шақпақ жұмыс істемей қалса, сіз не істер едіңіз?
Dialogue: 0,0:13:38.02,0:13:40.52,Default,,0,0,0,,Егер олар сәтті болса, мен бақытты боламын
Dialogue: 0,0:13:40.61,0:13:44.53,Default,,0,0,0,,Егер ол жұмыс істемесе, көңіліңіз түсіп, «Әй, бұл жұмыс істемеді» деп айтасыз.
Dialogue: 0,0:13:44.61,0:13:47.86,Default,,0,0,0,,Келесі жол туралы ойланыңыз
Dialogue: 0,0:13:47.95,0:13:52.20,Default,,0,0,0,,Дұрыс, бұл тек «бір рет қолданылатын құрал»
Dialogue: 0,0:13:52.29,0:13:57.21,Default,,0,0,0,,Егер сіз бұл жерді сәл де болса рахатқа бөлесеңіз, мен бақытты боламын.
Dialogue: 0,0:13:57.29,0:13:58.63,Default,,0,0,0,,Талғампаздық! (Aoyama's father) Run away!
Dialogue: 0,0:13:58.71,0:14:00.13,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:01.59,0:14:03.21,Default,,0,0,0,,Маман мен Папан
Dialogue: 0,0:14:03.30,0:14:06.84,Default,,0,0,0,,Мен өзімнің «даралығымды» қатты шатастырдым.
Dialogue: 0,0:14:06.93,0:14:09.80,Default,,0,0,0,,Екеуі ауқатты отбасылардан шыққан.
Dialogue: 0,0:14:09.89,0:14:12.85,Default,,0,0,0,,Өйткені мен ешбір ыңғайсыздықсыз қамқорлықпен өстім.
Dialogue: 0,0:14:13.47,0:14:15.56,Default,,0,0,0,,Менен жақсырақ шығар
Dialogue: 0,0:14:15.64,0:14:18.85,Default,,0,0,0,,Мен басқалардан ерекше екенімді уайымдадым деп ойлаймын.
Dialogue: 0,0:14:19.52,0:14:20.36,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:21.11,0:14:25.65,Default,,0,0,0,,Менің бақытымнан үміт күтетініңізге сенімдімін.
Dialogue: 0,0:14:26.32,0:14:29.24,Default,,0,0,0,,Сізге «индивидуалдылықты» еркін беретін болмыс
Dialogue: 0,0:14:29.32,0:14:31.16,Default,,0,0,0,,Мен сол қауесетке ердім.
Dialogue: 0,0:14:33.66,0:14:37.79,Default,,0,0,0,,Мен алған «индивидуалдылық» менің конституцияма сәйкес келмеді, сондықтан қиын болды.
Dialogue: 0,0:14:40.13,0:14:45.80,Default,,0,0,0,,Маман мен Папан мені үлкен қамқорлықпен өсірді.
Dialogue: 0,0:14:45.88,0:14:49.55,Default,,0,0,0,,Оның басқаша болуының себебі өте қорқынышты.
Dialogue: 0,0:14:49.63,0:14:53.01,Default,,0,0,0,,Менің арманым осындай психологиядан басталды
Dialogue: 0,0:14:53.10,0:14:56.27,Default,,0,0,0,,Маман мен Папанның бір күні маған жасағаны сияқты
Dialogue: 0,0:14:58.35,0:14:59.35,Default,,0,0,0,,Барлығы мүмкін
Dialogue: 0,0:14:59.44,0:15:01.61,Default,,0,0,0,,«Мұғалім болады» деген қауесет бар.
Dialogue: 0,0:15:01.69,0:15:03.82,Default,,0,0,0,,Оны Юэйге қойыңыз
Dialogue: 0,0:15:03.90,0:15:05.32,Default,,0,0,0,,Адамдарға...
Dialogue: 0,0:15:05.94,0:15:09.49,Default,,0,0,0,,Сынып қашан оқшауланғанын айтыңызшы.
Dialogue: 0,0:15:09.57,0:15:11.49,Default,,0,0,0,,Адамдарды бақытты ету үшін...
Dialogue: 0,0:15:11.57,0:15:14.49,Default,,0,0,0,,Оқу-жаттығу жиынының орнын айтыңызшы.
Dialogue: 0,0:15:14.58,0:15:16.04,Default,,0,0,0,,Барлығы үшін, өзім...
Dialogue: 0,0:15:16.79,0:15:19.08,Default,,0,0,0,,Изуку Мидория Юэйге оралады
Dialogue: 0,0:15:19.16,0:15:23.04,Default,,0,0,0,,Мені жалғыз қалдыр
Dialogue: 0,0:15:24.00,0:15:25.34,Default,,0,0,0,,Сол хатта
Dialogue: 0,0:15:25.42,0:15:28.84,Default,,0,0,0,,Сенің мен сияқты «ереңсіз» екеніңді білгенде
Dialogue: 0,0:15:29.51,0:15:30.34,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:15:30.43,0:15:32.68,Default,,0,0,0,,Ха! (Аояма) Барлығы!
Dialogue: 0,0:15:32.76,0:15:35.81,Default,,0,0,0,,Тоқта, Аояма-кун! (Аояма) Мен үмітсіз болдым!
Dialogue: 0,0:15:36.72,0:15:37.64,Default,,0,0,0,,«Невиль»…
Dialogue: 0,0:15:38.73,0:15:40.27,Default,,0,0,0,,“Барлығы үшін Біреу”…
Dialogue: 0,0:15:40.35,0:15:42.19,Default,,0,0,0,,«Лазер»!
Dialogue: 0,0:15:44.15,0:15:45.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:46.65,0:15:51.45,Default,,0,0,0,,Менің денемнің жарықты сындыратын қасиеті бар.
Dialogue: 0,0:15:52.99,0:15:55.45,Default,,0,0,0,,Бәрі өлсе, таң қалмас еді.
Dialogue: 0,0:15:56.70,0:15:59.12,Default,,0,0,0,,Бүкіл Жапония есінен танып қалды.
Dialogue: 0,0:16:01.00,0:16:03.54,Default,,0,0,0,,Сыныпта не ойладың!?
Dialogue: 0,0:16:03.63,0:16:07.21,Default,,0,0,0,,Сіз жатақханада барлығымен бірге тұрдыңыз ба?
Dialogue: 0,0:16:03.63,0:16:07.21,Default,,0,0,0,,Ааа!
Dialogue: 0,0:16:07.21,0:16:07.30,Default,,0,0,0,,Ааа!
Dialogue: 0,0:16:07.30,0:16:08.96,Default,,0,0,0,,Ааа!
Dialogue: 0,0:16:07.30,0:16:08.96,Default,,0,0,0,,Эй, Аояма-кун!
Dialogue: 0,0:16:09.05,0:16:10.76,Default,,0,0,0,,Жоқ! (Aoyama's mother) Elegance!
Dialogue: 0,0:16:16.30,0:16:19.18,Default,,0,0,0,,Аояма-кун, Хагакуре-сан.
Dialogue: 0,0:16:19.77,0:16:24.73,Default,,0,0,0,,Сен мені енді ешкімге ренжітуден сақтадың.
Dialogue: 0,0:16:25.52,0:16:27.73,Default,,0,0,0,,Енді тоқтайық
Dialogue: 0,0:16:27.82,0:16:30.74,Default,,0,0,0,,Ух... у... (Изуку) Бұл қазірдің өзінде...
Dialogue: 0,0:16:31.49,0:16:33.49,Default,,0,0,0,,Тоқтатайық
Dialogue: 0,0:16:40.04,0:16:41.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:41.50,0:16:44.50,Default,,0,0,0,,Біреу үшін Барлығы gave me “individuality”
Dialogue: 0,0:16:44.58,0:16:47.34,Default,,0,0,0,,Ол басқарылатын болды...
Dialogue: 0,0:16:47.42,0:16:50.30,Default,,0,0,0,,«Индивидуалдылық» шамамен 10 жыл бұрын берілген?
Dialogue: 0,0:16:50.38,0:16:52.26,Default,,0,0,0,,Қазір қауіпсіз болу дегенді білдіреді
Dialogue: 0,0:16:52.34,0:16:56.51,Default,,0,0,0,,Саған Наган сияқты опасыздық жасасам жарылып кететін құрылғы жоқ сияқты...
Dialogue: 0,0:16:56.59,0:16:59.10,Default,,0,0,0,,Бұл жолы шешуші.
Dialogue: 0,0:16:59.18,0:17:01.98,Default,,0,0,0,,Инсайдер бар.
Dialogue: 0,0:17:02.73,0:17:05.02,Default,,0,0,0,,Мен оны студент деп ойламаппын.
Dialogue: 0,0:17:07.23,0:17:10.61,Default,,0,0,0,,Мүмкін болса, сендер артта қалыңдар.
Dialogue: 0,0:17:10.69,0:17:14.86,Default,,0,0,0,,Артында қалуға болады... (Каменари) Оның мағынасы жоқ.
Dialogue: 0,0:17:14.95,0:17:19.45,Default,,0,0,0,,Хагакуре-сан таппаса, не істеуді жоспарладыңыз?
Dialogue: 0,0:17:19.53,0:17:21.16,Default,,0,0,0,,Аояма мырза...
Dialogue: 0,0:17:21.24,0:17:23.41,Default,,0,0,0,,Аояма: Айтшы өтірік!
Dialogue: 0,0:17:23.50,0:17:27.42,Default,,0,0,0,,Сіз алданып қалдыңыз, солай емес пе? Бұл әдейі емес, солай ма?
Dialogue: 0,0:17:28.21,0:17:30.71,Default,,0,0,0,,Теми де бұрын «еркінсіз» болған
Dialogue: 0,0:17:30.80,0:17:33.09,Default,,0,0,0,,Әлемді тым кішкентай етпе
Dialogue: 0,0:17:33.72,0:17:37.76,Default,,0,0,0,,Өкінішке орай, біз әлі де тәртіппен өмір сүруге тырысамыз.
Dialogue: 0,0:17:37.84,0:17:40.39,Default,,0,0,0,,Барлығы бір үшін туралы не білеміз
Dialogue: 0,0:17:40.47,0:17:42.81,Default,,0,0,0,,Жуылмаған Біреудің сөйлесуін сұраңыз
Dialogue: 0,0:17:42.89,0:17:45.81,Default,,0,0,0,,Білетін ештеңе жоқ
Dialogue: 0,0:17:45.89,0:17:50.27,Default,,0,0,0,,Біз тек бізден сұралған нәрсені орындаймыз.
Dialogue: 0,0:17:50.36,0:17:55.20,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз, сіз өлтіресіз. Өтірік айтсаң өлтіресің.
Dialogue: 0,0:17:55.28,0:17:56.49,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:17:57.11,0:18:01.79,Default,,0,0,0,,Маған мұндай адамның қалай кәдеге жаратылатыны көрсетілді.
Dialogue: 0,0:18:02.83,0:18:07.37,Default,,0,0,0,,Полициядан қашқандар түрмеден шыққан соң өлтірілді.
Dialogue: 0,0:18:07.46,0:18:09.29,Default,,0,0,0,,Қашып құтыла алмадым
Dialogue: 0,0:18:09.88,0:18:12.71,Default,,0,0,0,,Қай жерде болсаңыз да, сіздің орналасқан жеріңіз анықталады.
Dialogue: 0,0:18:12.80,0:18:16.09,Default,,0,0,0,,Өлімге айдау керек
Dialogue: 0,0:18:16.63,0:18:20.26,Default,,0,0,0,,Талғампаз оның айтқанын орындаса не боларын білмеді.
Dialogue: 0,0:18:20.35,0:18:24.18,Default,,0,0,0,,Ешкімге байқамау...
Dialogue: 0,0:18:24.27,0:18:26.23,Default,,0,0,0,,Бұл біздің кінәміз
Dialogue: 0,0:18:26.94,0:18:29.19,Default,,0,0,0,,Сыныпта не ойладың!?
Dialogue: 0,0:18:31.19,0:18:35.82,Default,,0,0,0,,Мен өлтірген адамдармен
Dialogue: 0,0:18:35.90,0:18:39.32,Default,,0,0,0,,Достарыма қарап, бірге күлдім.
Dialogue: 0,0:18:40.45,0:18:42.83,Default,,0,0,0,,Бірге күле алдық.
Dialogue: 0,0:18:42.91,0:18:45.29,Default,,0,0,0,,Бұрынғы «Сапасыз»
Dialogue: 0,0:18:45.37,0:18:49.33,Default,,0,0,0,,Барлығы бір үшін күресу ауыртпалығының өзіне артылғанын білу
Dialogue: 0,0:18:50.29,0:18:53.09,Default,,0,0,0,,Мен өз қасіретімнен үмітімді үздім.
Dialogue: 0,0:18:53.88,0:18:55.84,Default,,0,0,0,,Оның уайымы алдында
Dialogue: 0,0:18:56.71,0:18:58.63,Default,,0,0,0,,Үмітсіз қалған өзіме
Dialogue: 0,0:18:59.38,0:19:01.59,Default,,0,0,0,,Мен үмітсіз болдым.
Dialogue: 0,0:19:01.68,0:19:05.47,Default,,0,0,0,,Менің жыныс мүшелерім шіріп кетті.
Dialogue: 0,0:19:05.56,0:19:09.23,Default,,0,0,0,,Юга Аояма нағыз жау (жауыз) болды.
Dialogue: 0,0:19:09.31,0:19:10.60,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:19:11.65,0:19:14.32,Default,,0,0,0,,Сіз Каччан мен Токоямиге оқу-жаттығу жиынында көмектесуге тырыстыңыз, солай ма?
Dialogue: 0,0:19:14.40,0:19:15.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:17.24,0:19:18.95,Default,,0,0,0,,Сол түндегі ірімшік
Dialogue: 0,0:19:19.03,0:19:21.87,Default,,0,0,0,,Мұны «Барлығы бір үшін» деп айтқандықтан жасадыңыз ба?
Dialogue: 0,0:19:22.78,0:19:26.74,Default,,0,0,0,,Қиын істермен бетпе-бет келіп, жарқырай алмайтыныңызға сенімдімін!
Dialogue: 0,0:19:26.83,0:19:28.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:29.75,0:19:36.00,Default,,0,0,0,,Бұл мен байқамаған SOS болды.
Dialogue: 0,0:19:36.09,0:19:36.92,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:19:38.80,0:19:42.05,Default,,0,0,0,,Түзетпей жылап тұрған кім?
Dialogue: 0,0:19:42.14,0:19:46.31,Default,,0,0,0,,Бәрі бір үшін айтқанын орындай алмағандықтан емес.
Dialogue: 0,0:19:47.06,0:19:50.06,Default,,0,0,0,,Менің жүрегімді Барлығы бір үшін пайдаланса да
Dialogue: 0,0:19:50.14,0:19:53.23,Default,,0,0,0,,Мен бәріне берілмейтін батырды білемін.
Dialogue: 0,0:19:54.23,0:19:56.15,Default,,0,0,0,,Менің жүрегім енді ғана езіліп кетті.
Dialogue: 0,0:19:57.19,0:19:58.74,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:19:58.82,0:20:03.11,Default,,0,0,0,,Қылмыс жасасаң, өмір бойы жау (жауыз) болмайсың!
Dialogue: 0,0:20:03.95,0:20:06.83,Default,,0,0,0,,Қолымды ұста, Аояма-кун.
Dialogue: 0,0:20:06.91,0:20:08.58,Default,,0,0,0,,Түсіндім, Деку
Dialogue: 0,0:20:09.45,0:20:13.96,Default,,0,0,0,,Сіз әлі де батыр бола аласыз.
Dialogue: 0,0:20:14.04,0:20:15.92,Default,,0,0,0,,Күте тұрыңыз, Мидориа-кун.
Dialogue: 0,0:20:16.00,0:20:18.46,Default,,0,0,0,,Санча: Аояманың аузын жап.
Dialogue: 0,0:20:18.55,0:20:21.22,Default,,0,0,0,,Мен ұсталып жатырмын. Мен сенен қолымды ала алмаймын.
Dialogue: 0,0:20:21.30,0:20:23.09,Default,,0,0,0,,Қандай жағдай болмасын
Dialogue: 0,0:20:23.18,0:20:25.64,Default,,0,0,0,,«Барлығы бір үшін» акциясына қатысушы болу күнәсі ешқашан кетпейді.
Dialogue: 0,0:20:25.72,0:20:29.31,Default,,0,0,0,,Мен бұл жағдайды ескере отырып, қауіпсіз деп есептеймін.
Dialogue: 0,0:20:29.39,0:20:32.48,Default,,0,0,0,,Бізде Наган сияқты құрылғы әлі жоқ деп нақты айта алмаймын.
Dialogue: 0,0:20:33.27,0:20:35.61,Default,,0,0,0,,Орталық сынақ нәтижелері қолжетімді болғанша.
Dialogue: 0,0:20:35.69,0:20:38.82,Default,,0,0,0,,Оған бұдан былай сөйлесу жақсы емес.
Dialogue: 0,0:20:38.90,0:20:40.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:42.65,0:20:44.57,Default,,0,0,0,,Ана әке
Dialogue: 0,0:20:45.24,0:20:49.87,Default,,0,0,0,,Каминоға шабуыл жасайтынымызды неге хабарламадың?
Dialogue: 0,0:20:49.95,0:20:52.62,Default,,0,0,0,,Біз бұл жерден сізбен байланыса алмаймыз.
Dialogue: 0,0:20:52.71,0:20:57.71,Default,,0,0,0,,Байланыс ақпараты басқа тарап сұраған жағдайда ғана беріледі.
Dialogue: 0,0:20:57.79,0:21:00.09,Default,,0,0,0,,Ол аяқтала салысымен ол жарамсыз болып қалады.
Dialogue: 0,0:21:00.17,0:21:03.17,Default,,0,0,0,,Ұсталып қалсаңыз да, ізіңіз қалмас үшін...
Dialogue: 0,0:21:03.26,0:21:04.80,Default,,0,0,0,,Сосын... (Изуку) Цукаучи мырза
Dialogue: 0,0:21:04.88,0:21:06.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.05,0:21:09.60,Default,,0,0,0,,Барлығы бір үшін табылмады
Dialogue: 0,0:21:09.68,0:21:12.81,Default,,0,0,0,,Сен қазір солай емес пе?
Dialogue: 0,0:21:12.89,0:21:14.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:14.69,0:21:16.90,Default,,0,0,0,,Мүмкін, екінші қадам сөзсіз
Dialogue: 0,0:21:16.98,0:21:20.07,Default,,0,0,0,,Сол себепті бұл адамның үмітсіз толқын тактикасы.
Dialogue: 0,0:21:21.19,0:21:22.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:22.15,0:21:24.03,Default,,0,0,0,,Демек, кем дегенде...
Dialogue: 0,0:21:24.65,0:21:28.83,Default,,0,0,0,,Қалай шығу керек... Құраған ағаштардың қозғалысына бағыт-бағдар беру үшін.
Dialogue: 0,0:21:28.91,0:21:30.83,Default,,0,0,0,,Ах (Минета) Түсінемін.
Dialogue: 0,0:21:30.91,0:21:35.96,Default,,0,0,0,,Егер сіз басқа көзқараспен қарасаңыз, қазіргі жағдай бір ғана адам, Аояма мырза.
Dialogue: 0,0:21:36.04,0:21:39.09,Default,,0,0,0,,Барлығы бір үшін-ді алдауға болады
Dialogue: 0,0:21:39.17,0:21:40.55,Default,,0,0,0,,Иә
Dialogue: 0,0:21:42.01,0:21:44.92,Default,,0,0,0,,Аояма-кун, мен тағы айтамын.
Dialogue: 0,0:21:45.97,0:21:50.14,Default,,0,0,0,,Сіз әлі де батыр бола аласыз
Dialogue: 0,0:21:51.06,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.93,0:23:20.94,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.77,0:23:22.94,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.02,0:23:25.07,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:23:25.15,0:23:27.28,Default,,0,0,0,,Менің жүрегімді Барлығы бір үшін пайдаланса да
Dialogue: 0,0:23:27.36,0:23:30.24,Default,,0,0,0,,Барын бермеген батыр
Dialogue: 0,0:23:30.32,0:23:34.53,Default,,0,0,0,,Қараңғылыққа боялған жүрекке нұр әкелу
Dialogue: 0,0:23:34.62,0:23:39.29,Default,,0,0,0,,Құлап қалсаң да, қайта тұруға болады
Dialogue: 0,0:23:39.37,0:23:43.25,Default,,0,0,0,,Келесі жолы «Барлығының қалай батыр болғаны туралы әңгіме»
Dialogue: 0,0:23:43.33,0:23:46.92,Default,,0,0,0,,Аояма-кун, біз ешқашан жалғыз емеспіз.
Dialogue: 0,0:23:47.88,0:23:50.93,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.43,0:23:58.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
