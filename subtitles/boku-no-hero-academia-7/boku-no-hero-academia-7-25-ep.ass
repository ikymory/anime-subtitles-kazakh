Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.38,0:00:08.71,Default,,0,0,0,,Сіз маған белгі беріп отырсаңыз да...
Dialogue: 0,0:00:09.59,0:00:12.38,Default,,0,0,0,,Мен мұны кеш түсіндім
Dialogue: 0,0:00:14.22,0:00:17.72,Default,,0,0,0,,А... уақыт таяп қалды...
Dialogue: 0,0:00:18.31,0:00:20.89,Default,,0,0,0,,Джиннің қаны ағып жатыр...
Dialogue: 0,0:00:23.56,0:00:26.02,Default,,0,0,0,,Джин-кун жоғалып кетеді
Dialogue: 0,0:00:28.02,0:00:31.32,Default,,0,0,0,,Жау (зұлым) одағын алмастыра алмасам да.
Dialogue: 0,0:00:31.94,0:00:36.49,Default,,0,0,0,,Сенің күлкің қандай әдемі екенін айтайын деп ойладым.
Dialogue: 0,0:00:36.57,0:00:40.58,Default,,0,0,0,,Уф... мен...
Dialogue: 0,0:00:41.91,0:00:45.46,Default,,0,0,0,,Мен Изуку-кунды да, Очако-чанды да жақсы көремін.
Dialogue: 0,0:00:46.67,0:00:48.59,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:50.21,0:00:51.88,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:00:53.59,0:00:55.55,Default,,0,0,0,,Әлемдегі №1
Dialogue: 0,0:00:59.05,0:01:03.60,Default,,0,0,0,,♪～
Dialogue: 0,0:02:23.97,0:02:28.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:00.76,0:03:02.55,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:03:02.64,0:03:07.14,Default,,0,0,0,,Бубайгавара жақсы жігіт еді.
Dialogue: 0,0:03:08.43,0:03:10.48,Default,,0,0,0,,Химико Тога…
Dialogue: 0,0:03:18.03,0:03:22.41,Default,,0,0,0,,Мен өзім қалағандай болғым келді, сондықтан мен пышақты ұстадым
Dialogue: 0,0:03:23.28,0:03:26.41,Default,,0,0,0,,Мен оны ашу мен жек көрушілікпен ұстадым.
Dialogue: 0,0:03:27.24,0:03:31.92,Default,,0,0,0,,Маған өмір сүруді жеңілдету үшін
Dialogue: 0,0:03:32.75,0:03:34.63,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:34.71,0:03:36.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:37.05,0:03:41.09,Default,,0,0,0,,Енді «индивидуалдылықпен» «трансформация» ауыртпалығы болды
Dialogue: 0,0:03:41.68,0:03:44.85,Default,,0,0,0,,Ха ха ха... аа
Dialogue: 0,0:03:46.35,0:03:49.93,Default,,0,0,0,,«Нөлдік гравитацияға» қатысқан кейіпкерлер
Dialogue: 0,0:03:50.02,0:03:51.52,Default,,0,0,0,,Жұмсақ қону
Dialogue: 0,0:03:52.69,0:03:57.23,Default,,0,0,0,,Адамдар арқылы өтетін шығарылым баяу жүреді.
Dialogue: 0,0:03:57.32,0:03:59.03,Default,,0,0,0,,Очако-чан
Dialogue: 0,0:03:59.78,0:04:04.45,Default,,0,0,0,,Өйткені, қанша жүрсең де, тастай алмайсың.
Dialogue: 0,0:04:05.74,0:04:09.62,Default,,0,0,0,,Суық... Қансырап тұр.
Dialogue: 0,0:04:09.70,0:04:14.83,Default,,0,0,0,,Басым мен денем байланыспағандай, мүлде қозғала алмаймын.
Dialogue: 0,0:04:15.54,0:04:17.34,Default,,0,0,0,,Маған көшу керек...
Dialogue: 0,0:04:18.67,0:04:19.84,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:04:22.72,0:04:25.64,Default,,0,0,0,,Мен саған өмір бойы қанымды беремін!
Dialogue: 0,0:04:26.64,0:04:31.06,Default,,0,0,0,,Сенің күлкің қандай әдемі екенін айтайын деп ойладым.
Dialogue: 0,0:04:34.27,0:04:36.02,Default,,0,0,0,,Каайы?
Dialogue: 0,0:04:37.40,0:04:39.36,Default,,0,0,0,,Әлемдегі №1
Dialogue: 0,0:04:42.07,0:04:44.24,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:04:44.32,0:04:47.24,Default,,0,0,0,,Өлімге әкелетін қан кетуде.
Dialogue: 0,0:04:47.32,0:04:51.08,Default,,0,0,0,,Мен оны пышақтап алған соң да ол осылай қозғала берді.
Dialogue: 0,0:04:52.62,0:04:54.54,Default,,0,0,0,,Очако-чан
Dialogue: 0,0:04:54.62,0:04:57.75,Default,,0,0,0,,Бүкіл жау (зұлым) альянсы жойылады.
Dialogue: 0,0:04:58.46,0:05:01.51,Default,,0,0,0,,Сынықтың арғы жағында не бар екені сөзсіз...
Dialogue: 0,0:05:03.01,0:05:05.68,Default,,0,0,0,,Мен оңай өмір сүретін әлем
Dialogue: 0,0:05:16.94,0:05:18.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:18.73,0:05:23.11,Default,,0,0,0,,Очако-чанның бұлай айтқанына қуандым.
Dialogue: 0,0:05:23.19,0:05:26.74,Default,,0,0,0,,Мен бұл өмір сүру үшін күрес дедім.
Dialogue: 0,0:05:27.74,0:05:30.12,Default,,0,0,0,,Сәлем! Қарғыс атқыр...
Dialogue: 0,0:05:31.16,0:05:35.12,Default,,0,0,0,,Мен Очако-чанның жоғалғанын қаламаймын.
Dialogue: 0,0:05:37.62,0:05:40.75,Default,,0,0,0,,Өйткені бұл сезім шын
Dialogue: 0,0:05:43.21,0:05:47.51,Default,,0,0,0,,Мен саған барлық қанымды беремін
Dialogue: 0,0:05:50.47,0:05:52.18,Default,,0,0,0,,Жылы...
Dialogue: 0,0:05:52.26,0:05:56.98,Default,,0,0,0,,Бірақ жоқ... егер мұны істесеңіз...
Dialogue: 0,0:05:57.85,0:05:59.65,Default,,0,0,0,,Бұрын өле жаздадым
Dialogue: 0,0:06:00.56,0:06:03.57,Default,,0,0,0,,Джин маған осылай көмектесті.
Dialogue: 0,0:06:04.53,0:06:09.57,Default,,0,0,0,,Джин-кунның қаны кеткендіктен, мен Очако-чан боламын.
Dialogue: 0,0:06:09.66,0:06:15.04,Default,,0,0,0,,Адамның «даралығын» қолдануға болатын болса, оның қаны сол адаммен бірдей болады.
Dialogue: 0,0:06:15.12,0:06:16.83,Default,,0,0,0,,Жоқ... көз...
Dialogue: 0,0:06:18.25,0:06:20.21,Default,,0,0,0,,Егер ұсталса
Dialogue: 0,0:06:20.29,0:06:24.09,Default,,0,0,0,,Мені көріп, өлгенімше қан әкелуді ойладың ба?
Dialogue: 0,0:06:24.17,0:06:27.09,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:06:28.88,0:06:30.84,Default,,0,0,0,,Мен жараны жабамын.
Dialogue: 0,0:06:31.85,0:06:37.18,Default,,0,0,0,,Очако-чан жаңа ғана жауды қолға түсіруі керек еді (зұлым).
Dialogue: 0,0:06:37.89,0:06:41.65,Default,,0,0,0,,Аномальды адамдарды жойған дұрыс болар еді.
Dialogue: 0,0:06:42.52,0:06:47.24,Default,,0,0,0,,Бар болғаны қаһарман болу және дұрыс әрекет жасау болды.
Dialogue: 0,0:06:48.11,0:06:49.28,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:49.36,0:06:50.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:51.57,0:06:53.45,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:54.28,0:06:57.50,Default,,0,0,0,,Тым көп ойлау
Dialogue: 0,0:06:59.21,0:07:04.88,Default,,0,0,0,,Досым, мені ренжіткен, көп пышақ салған адам.
Dialogue: 0,0:07:06.05,0:07:09.30,Default,,0,0,0,,Бұл біртүрлі, Очако-чан.
Dialogue: 0,0:07:09.38,0:07:13.89,Default,,0,0,0,,Сіз... осындайсыз...
Dialogue: 0,0:07:14.81,0:07:17.56,Default,,0,0,0,,Мен өзім қалағандай өмір сүремін
Dialogue: 0,0:07:17.64,0:07:20.64,Default,,0,0,0,,Сондықтан мен сені ұстай алмаймын.
Dialogue: 0,0:07:20.73,0:07:23.90,Default,,0,0,0,,Очако-чанның «аулауымен» бірдей
Dialogue: 0,0:07:24.52,0:07:25.40,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:27.03,0:07:28.90,Default,,0,0,0,,Сізді пышақтап алғаным үшін кешіріңіз.
Dialogue: 0,0:07:29.90,0:07:31.95,Default,,0,0,0,,Сізге айқайлағаным үшін кешіріңіз.
Dialogue: 0,0:07:32.53,0:07:34.45,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:07:35.12,0:07:39.20,Default,,0,0,0,,Туя-кун менің үйімді өртеп жіберді.
Dialogue: 0,0:07:39.29,0:07:42.96,Default,,0,0,0,,Жағымсыз заттарға толы кәдімгі үй
Dialogue: 0,0:07:43.04,0:07:45.21,Default,,0,0,0,,Сіз бұл ешқашан болмаған сияқты көріндіңіз.
Dialogue: 0,0:07:46.63,0:07:47.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:48.92,0:07:51.18,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:07:51.26,0:07:52.43,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:53.34,0:07:56.39,Default,,0,0,0,,Кетсе де, Жүрегімде қалады
Dialogue: 0,0:07:57.10,0:08:00.73,Default,,0,0,0,,Очако-чан бұл болмағандай сыңай танытпады.
Dialogue: 0,0:08:00.81,0:08:03.15,Default,,0,0,0,,Бұл ауыр және ауыр, бірақ
Dialogue: 0,0:08:04.52,0:08:06.77,Default,,0,0,0,,Қол тигізгенде
Dialogue: 0,0:08:06.86,0:08:11.57,Default,,0,0,0,,Өйткені менің жүрегім жеңіл, жұмсақ
Dialogue: 0,0:08:13.20,0:08:15.49,Default,,0,0,0,,Тіпті ұрыс сөзсіз болса да
Dialogue: 0,0:08:15.57,0:08:19.12,Default,,0,0,0,,Мен тереңде жатқан нәрсені елеусіз қалдырғым келмейді.
Dialogue: 0,0:08:22.54,0:08:26.17,Default,,0,0,0,,Рахмет, Очако-чан.
Dialogue: 0,0:08:26.25,0:08:28.17,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:08:28.25,0:08:30.92,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:08:31.01,0:08:32.84,Default,,0,0,0,,Очако-чан
Dialogue: 0,0:08:34.72,0:08:37.80,Default,,0,0,0,,Мен сол адам болғым келеді.
Dialogue: 0,0:08:37.89,0:08:42.89,Default,,0,0,0,,Қызғандым, сені сүйдім, Қаныңды іштім.
Dialogue: 0,0:08:42.98,0:08:46.40,Default,,0,0,0,,Химико...чан...
Dialogue: 0,0:08:47.23,0:08:49.90,Default,,0,0,0,,Иә
Dialogue: 0,0:08:52.32,0:08:56.95,Default,,0,0,0,,Егер мен бұрын білген болсам
Dialogue: 0,0:08:59.99,0:09:03.46,Default,,0,0,0,,Қанша қан ішсем деймін
Dialogue: 0,0:09:03.54,0:09:05.75,Default,,0,0,0,,Қан тапсырғым келеді
Dialogue: 0,0:09:08.42,0:09:11.46,Default,,0,0,0,,Егер мен осындай адамды кездестірсем
Dialogue: 0,0:09:13.26,0:09:16.59,Default,,0,0,0,,Дүниеде өмір сүру оңайырақ болар ма еді?
Dialogue: 0,0:09:18.97,0:09:20.56,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:09:25.10,0:09:27.60,Default,,0,0,0,,Мен Химико Тогамын
Dialogue: 0,0:09:27.69,0:09:31.40,Default,,0,0,0,,Қалағаныңызша өмір сүріңіз, қалағаныңызша өмір сүріңіз
Dialogue: 0,0:09:31.48,0:09:35.61,Default,,0,0,0,,Дүниедегі ең сүйкімді күлкің сенде
Dialogue: 0,0:09:35.70,0:09:39.53,Default,,0,0,0,,Қарапайым қыз
Dialogue: 0,0:09:52.75,0:09:56.17,Default,,0,0,0,,Мен біртүрлі сенімдімін, Түнгі көз.
Dialogue: 0,0:09:56.76,0:09:59.97,Default,,0,0,0,,Осылай жүрсең, жауға (жауызға) тап болады.
Dialogue: 0,0:10:00.05,0:10:03.93,Default,,0,0,0,,үшін емес, бірақ миллион…
Dialogue: 0,0:10:05.60,0:10:06.89,Default,,0,0,0,,Жау (зұлым)...
Dialogue: 0,0:10:08.35,0:10:10.81,Default,,0,0,0,,Бұл жас жігіт бәрі бір үшін.
Dialogue: 0,0:10:10.90,0:10:12.65,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:10:14.82,0:10:17.78,Default,,0,0,0,,Егер сіздің алдын ала тануыңыз әлі тірі болса.
Dialogue: 0,0:10:17.86,0:10:20.16,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:10:21.33,0:10:23.49,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:10:39.55,0:10:44.14,Default,,0,0,0,,Бұл дүниеде күліп тұрғандар ең күшті.
Dialogue: 0,0:10:45.02,0:10:48.81,Default,,0,0,0,,Бетіңізді көрсету керек.
Dialogue: 0,0:10:51.27,0:10:54.40,Default,,0,0,0,,Бронды бар күш!
Dialogue: 0,0:10:59.49,0:11:01.57,Default,,0,0,0,,Геркулес туралы бейне
Dialogue: 0,0:11:01.66,0:11:03.74,Default,,0,0,0,,Мен суретті түсіріп қойғанмын.
Dialogue: 0,0:11:03.83,0:11:06.58,Default,,0,0,0,,Соғыс жағдайын міндетті түрде айтып беремін.
Dialogue: 0,0:11:07.62,0:11:09.08,Default,,0,0,0,,Цукаучи мырза
Dialogue: 0,0:11:09.16,0:11:13.09,Default,,0,0,0,,Автокөлік токпен жұмыс істейтін костюмнің тірегі ме?
Dialogue: 0,0:11:13.67,0:11:14.80,Default,,0,0,0,,үшін қарсы
Dialogue: 0,0:11:14.88,0:11:17.01,Default,,0,0,0,,үшін біреу үшін!?
Dialogue: 0,0:11:17.09,0:11:18.59,Default,,0,0,0,,Тарату!
Dialogue: 0,0:11:19.42,0:11:21.72,Default,,0,0,0,,А, міне! Интернетке ештеңе салмаңыз!
Dialogue: 0,0:11:21.80,0:11:23.60,Default,,0,0,0,,Банкай сияқты жүктеп салмаңыз!
Dialogue: 0,0:11:23.68,0:11:25.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:25.18,0:11:26.01,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:11:26.10,0:11:27.56,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:11:27.64,0:11:29.56,Default,,0,0,0,,үшінның қолдауы
Dialogue: 0,0:11:29.64,0:11:33.48,Default,,0,0,0,,Тірек – бұл дене...
Dialogue: 0,0:11:34.73,0:11:38.36,Default,,0,0,0,,Қай жерде өлетініңді шештің бе?
Dialogue: 0,0:11:38.44,0:11:41.07,Default,,0,0,0,,Қанша құрал болса да
Dialogue: 0,0:11:41.95,0:11:46.45,Default,,0,0,0,,«Қызықсыз» адамның сізге қарсылас болуы мүмкін емес.
Dialogue: 0,0:11:47.99,0:11:50.16,Default,,0,0,0,,Таратуды тоқтату Нарықтық баға
Dialogue: 0,0:11:51.33,0:11:52.92,Default,,0,0,0,,Бұдан былай не көрсетіледі
Dialogue: 0,0:11:53.67,0:11:57.21,Default,,0,0,0,,Шәкірттің тартысын бұзбау үшін
Dialogue: 0,0:11:57.30,0:12:01.68,Default,,0,0,0,,үшін бір адам үшін бірнеше минут пен секундты ұрлау үшін
Dialogue: 0,0:12:01.76,0:12:06.43,Default,,0,0,0,,Бұл бұрынғы батырдың жала жабылған түрі.
Dialogue: 0,0:12:08.89,0:12:10.85,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:12:11.77,0:12:15.06,Default,,0,0,0,,Менің өмірімдегі ең алаңдатарлық нәрсе
Dialogue: 0,0:12:15.15,0:12:18.90,Default,,0,0,0,,Ойнайтын ең қызықты ойыншық
Dialogue: 0,0:12:18.98,0:12:22.53,Default,,0,0,0,,Тоқтау... Таяз нысана...
Dialogue: 0,0:12:22.61,0:12:24.66,Default,,0,0,0,,Мен түсінсем де
Dialogue: 0,0:12:25.66,0:12:26.58,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:27.16,0:12:29.95,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:12:30.04,0:12:32.46,Default,,0,0,0,,Геркулес «Ренге Йориюто»!
Dialogue: 0,0:12:43.88,0:12:44.84,Default,,0,0,0,,Аман қалдыңыз!?
Dialogue: 0,0:12:45.55,0:12:49.60,Default,,0,0,0,,Hercules Shield жалпы жоғалтқанның 66%
Dialogue: 0,0:12:49.68,0:12:51.31,Default,,0,0,0,,Келесісі жоқ
Dialogue: 0,0:12:51.39,0:12:52.64,Default,,0,0,0,,(Сатсуки) Наги! (Кохару) Уау!
Dialogue: 0,0:12:52.73,0:12:57.86,Default,,0,0,0,,Жалтармай алға ұмтыл... Қалай күресуге болады!
Dialogue: 0,0:12:58.73,0:13:01.61,Default,,0,0,0,,«Біріміз бәріміз үшін» болғандықтан шығар!
Dialogue: 0,0:13:02.24,0:13:04.45,Default,,0,0,0,,Қара қамшы!
Dialogue: 0,0:13:05.78,0:13:07.28,Default,,0,0,0,,На
Dialogue: 0,0:13:07.37,0:13:08.99,Default,,0,0,0,,«Зуманы зарядтаңыз»!
Dialogue: 0,0:13:10.08,0:13:11.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:11.58,0:13:14.66,Default,,0,0,0,,Электр тогы арқылы көбеюді бұзу...
Dialogue: 0,0:13:14.75,0:13:18.46,Default,,0,0,0,,Шебермен соңғы шайқастан бері
Dialogue: 0,0:13:18.54,0:13:21.30,Default,,0,0,0,,Біріншіден, бұл алыс қашықтықтан шабуыл!
Dialogue: 0,0:13:21.38,0:13:22.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:22.34,0:13:24.55,Default,,0,0,0,,Сіз оны әлсіретесіз, содан кейін оның «даралығын» алып тастайсыз!
Dialogue: 0,0:13:24.63,0:13:25.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:25.76,0:13:29.93,Default,,0,0,0,,Оның жекпе-жек стилі «тұлғасы» бар адамға ұқсайды.
Dialogue: 0,0:13:30.01,0:13:31.97,Default,,0,0,0,,Қалай күрессең де!
Dialogue: 0,0:13:32.81,0:13:36.73,Default,,0,0,0,,Келесіде не көрсетіледі? Полиция қызметкері
Dialogue: 0,0:13:38.10,0:13:40.69,Default,,0,0,0,,Мен не көрдім?
Dialogue: 0,0:13:40.77,0:13:43.74,Default,,0,0,0,,Бізді не қорғады?
Dialogue: 0,0:13:44.74,0:13:46.91,Default,,0,0,0,,Бұл костюм және Геркулес
Dialogue: 0,0:13:46.99,0:13:52.12,Default,,0,0,0,,Мен бір идеяны ойлап, аз да болса күресу үшін дизайнды сұрадым.
Dialogue: 0,0:13:52.74,0:13:56.83,Default,,0,0,0,,Бірде сенен жеңіліп, Америкаға қашуға мәжбүр болдым.
Dialogue: 0,0:13:56.92,0:14:01.17,Default,,0,0,0,,Ол жерде кездескен досыммен ас ішу!
Dialogue: 0,0:14:01.88,0:14:06.63,Default,,0,0,0,,Маған берілгеннің бәрін беремін!
Dialogue: 0,0:14:08.01,0:14:09.55,Default,,0,0,0,,Бұл құшақтағы тағдыр т.б
Dialogue: 0,0:14:09.64,0:14:12.39,Default,,0,0,0,,Мен оны сізге ұнайтын кез келген пішінге айналдырамын.
Dialogue: 0,0:14:12.47,0:14:16.35,Default,,0,0,0,,Біз бір-бірімізді бұрыннан танимыз, білесің бе? Ең жақын дос!
Dialogue: 0,0:14:17.56,0:14:22.86,Default,,0,0,0,,Мен ешқашан жеңілемін деп ұрысқан емеспін!
Dialogue: 0,0:14:24.23,0:14:27.03,Default,,0,0,0,,«Целлофан» орау!
Dialogue: 0,0:14:27.90,0:14:29.20,Default,,0,0,0,,Құрастыру!
Dialogue: 0,0:14:29.99,0:14:31.78,Default,,0,0,0,,«Қант адам»!
Dialogue: 0,0:14:33.37,0:14:34.91,Default,,0,0,0,,Түсіру стилі
Dialogue: 0,0:14:35.00,0:14:35.95,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:36.96,0:14:38.79,Default,,0,0,0,,Smash!
Dialogue: 0,0:14:40.25,0:14:42.42,Default,,0,0,0,,Бұл мүлдем көңілсіз.
Dialogue: 0,0:14:42.50,0:14:47.17,Default,,0,0,0,,50-ден асқан жас жігітпен сырласу!
Dialogue: 0,0:14:48.17,0:14:49.26,Default,,0,0,0,,Бұл... Денемдегі барлық күш-қуат бірден кетіп қалды
Dialogue: 0,0:14:49.34,0:14:51.47,Default,,0,0,0,,«Біреуі бәрі үшін» алу үшін
Dialogue: 0,0:14:51.55,0:14:53.81,Default,,0,0,0,,Қатты ашуға тұнған
Dialogue: 0,0:14:53.89,0:14:56.18,Default,,0,0,0,,оны сол жерге қойыңыз
Dialogue: 0,0:14:56.27,0:15:00.52,Default,,0,0,0,,Бұл шайқастың орындалуына ықпал ететін жалғыз нәрсе.
Dialogue: 0,0:15:00.60,0:15:03.06,Default,,0,0,0,,Менің және сенің тамағың
Dialogue: 0,0:15:03.15,0:15:05.57,Default,,0,0,0,,Жын патшасы мұны естіп шошып кетеді!
Dialogue: 0,0:15:05.65,0:15:09.03,Default,,0,0,0,,Сіз «еркінсіз» болсаңыз да, қанша күресе аласыз?
Dialogue: 0,0:15:09.11,0:15:13.28,Default,,0,0,0,,Мен сені өзіме қатты ғашық етемін, сен менен көзіңді ала алмай қаласың!
Dialogue: 0,0:15:14.53,0:15:16.12,Default,,0,0,0,,«Хатсука» плюс
Dialogue: 0,0:15:16.20,0:15:18.16,Default,,0,0,0,,«Дене күшін нығайту» плюс
Dialogue: 0,0:15:18.25,0:15:20.29,Default,,0,0,0,,«Экструзия» плюс «Тойтарма» плюс
Dialogue: 0,0:15:20.37,0:15:23.08,Default,,0,0,0,,«Қара шар» плюс «Ашық шаң»!
Dialogue: 0,0:15:23.17,0:15:24.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:40.60,0:15:43.52,Default,,0,0,0,,Бұл өрескел ұйымдастырылған шабуыл.
Dialogue: 0,0:15:44.19,0:15:46.02,Default,,0,0,0,,Айла жұмыс істеп тұрғанының дәлелі
Dialogue: 0,0:15:46.11,0:15:50.03,Default,,0,0,0,,Тошинориді сөйле, сөйлес, араластыра бер
Dialogue: 0,0:15:50.11,0:15:53.99,Default,,0,0,0,,«Цукуёми» автоматтық қорғаныс плащы!
Dialogue: 0,0:15:54.07,0:15:57.95,Default,,0,0,0,,Мантияның зақымдалуы Сол жақ иық сүйегі Клавикул сынған
Dialogue: 0,0:15:58.04,0:16:00.37,Default,,0,0,0,,Қозғалыс көмегінің макс!
Dialogue: 0,0:16:00.46,0:16:03.04,Default,,0,0,0,,Сіз ұрысып жатырсыз ба?
Dialogue: 0,0:16:03.12,0:16:05.54,Default,,0,0,0,,Сіз нені түсінбедіңіз?
Dialogue: 0,0:16:05.63,0:16:08.25,Default,,0,0,0,,Қоқыс қалдықтары!
Dialogue: 0,0:16:08.34,0:16:13.26,Default,,0,0,0,,Қоқыс дорбасын кию сізді үлкенірек сезінді ме? Ах!?
Dialogue: 0,0:16:13.93,0:16:16.26,Default,,0,0,0,,Тек сыныңыз және жоғалтыңыз
Dialogue: 0,0:16:16.35,0:16:18.64,Default,,0,0,0,,Ол шектен аспайды!
Dialogue: 0,0:16:20.31,0:16:21.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:21.23,0:16:24.06,Default,,0,0,0,,Артық сенім артпаңыз
Dialogue: 0,0:16:24.15,0:16:27.19,Default,,0,0,0,,Егер сіз затты жоғалтсаңыз, сіз өз күшіңізді пайдалана алмайсыз.
Dialogue: 0,0:16:27.27,0:16:28.27,Default,,0,0,0,,Сондай батыр
Dialogue: 0,0:16:28.90,0:16:30.65,Default,,0,0,0,,Алайда, Айзава-кун
Dialogue: 0,0:16:31.86,0:16:33.41,Default,,0,0,0,,Не? бала
Dialogue: 0,0:16:35.74,0:16:39.74,Default,,0,0,0,,Сол бір таяқпен жеңіске жетуді көздедің бе?
Dialogue: 0,0:16:42.33,0:16:44.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.83,0:16:47.75,Default,,0,0,0,,Екеуміз жақсы араласамыз, ең жақын досым.
Dialogue: 0,0:16:49.25,0:16:50.80,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:51.46,0:16:54.88,Default,,0,0,0,,Мен сіздің уақытты сатып алу амалыңызға алданып қалмадым.
Dialogue: 0,0:16:55.51,0:17:00.85,Default,,0,0,0,,Менің қоқыс жинауға бос уақытым жеткілікті!
Dialogue: 0,0:17:02.39,0:17:04.48,Default,,0,0,0,,Мен жағдайды түзетуге тырыспаймын.
Dialogue: 0,0:17:04.56,0:17:05.52,Default,,0,0,0,,Масқара!
Dialogue: 0,0:17:10.73,0:17:11.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:11.86,0:17:13.53,Default,,0,0,0,,Суперқышқылды инъекция
Dialogue: 0,0:17:14.28,0:17:15.28,Default,,0,0,0,,«Қызғылт түсті»!
Dialogue: 0,0:17:15.36,0:17:16.53,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:17:16.61,0:17:18.41,Default,,0,0,0,,Домаланған жағынан
Dialogue: 0,0:17:18.49,0:17:20.37,Default,,0,0,0,,Тот басуға жол бермеңіз!
Dialogue: 0,0:17:20.45,0:17:23.20,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,0:17:23.29,0:17:27.00,Default,,0,0,0,,«Қоқыс» емес пе еді?
Dialogue: 0,0:17:30.67,0:17:32.21,Default,,0,0,0,,Мені өзіңе шәкірт ет
Dialogue: 0,0:17:32.88,0:17:34.30,Default,,0,0,0,,Сізге көмектесуге рұқсат етіңіз
Dialogue: 0,0:17:34.38,0:17:36.89,Default,,0,0,0,,Ей, ақымақ, сенде тіпті "даралығың" жоқ қой, солай ма?
Dialogue: 0,0:17:36.97,0:17:38.47,Default,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:17:38.55,0:17:39.80,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:39.89,0:17:42.85,Default,,0,0,0,,Таяқшалармен радиусы 3 метрді қорғаңыз.
Dialogue: 0,0:17:42.93,0:17:46.02,Default,,0,0,0,,Менің отбасым баяғыда өлтірілді.
Dialogue: 0,0:17:46.10,0:17:47.19,Default,,0,0,0,,Мен де
Dialogue: 0,0:17:47.27,0:17:50.57,Default,,0,0,0,,Басқалардан кек алуға менің бос уақытым жетпейді.
Dialogue: 0,0:17:52.98,0:17:54.24,Default,,0,0,0,,Мен сені кешіре алмаймын.
Dialogue: 0,0:17:55.03,0:17:58.36,Default,,0,0,0,,Ұрлық жасағандар пайда табатын дүние
Dialogue: 0,0:17:58.45,0:18:02.16,Default,,0,0,0,,Тоналған адамның мұңы өшпенділікке айналады.
Dialogue: 0,0:18:02.99,0:18:04.95,Default,,0,0,0,,Бұл спираль...
Dialogue: 0,0:18:05.04,0:18:08.08,Default,,0,0,0,,-да? Мұнымен не істеу керек ...
Dialogue: 0,0:18:08.17,0:18:11.96,Default,,0,0,0,,Мен әркім өз өмірін күліп өткізетін әлем құрғым келеді.
Dialogue: 0,0:18:12.05,0:18:14.71,Default,,0,0,0,,Ол үшін таңбалар қажет.
Dialogue: 0,0:18:17.26,0:18:18.09,Default,,0,0,0,,Не?
Dialogue: 0,0:18:20.80,0:18:22.26,Default,,0,0,0,,бейбітшілік
Dialogue: 0,0:18:23.85,0:18:27.81,Default,,0,0,0,,Қанша ғимарат қалпына келтірілген болып көрінсе де,
Dialogue: 0,0:18:27.89,0:18:30.94,Default,,0,0,0,,Адамдар әлі күнге дейін қорқынышпен өмір сүреді
Dialogue: 0,0:18:31.02,0:18:33.86,Default,,0,0,0,,Менің жүрегім қараңғылықта қалады
Dialogue: 0,0:18:35.94,0:18:38.78,Default,,0,0,0,,Өз күшіңізді көрсетіңіз бе?
Dialogue: 0,0:18:39.41,0:18:42.95,Default,,0,0,0,,үшінның қолдары 3 метр радиуста толы.
Dialogue: 0,0:18:43.03,0:18:44.79,Default,,0,0,0,,Сондықтан мен мұны істеймін
Dialogue: 0,0:18:46.54,0:18:50.79,Default,,0,0,0,,Өйткені мен «жеке тұлғасызмын» және ешқандай рөлім жоқ.
Dialogue: 0,0:19:01.43,0:19:04.22,Default,,0,0,0,,үшін бір үшін Юэйге жақынырақ болыңыз!
Dialogue: 0,0:19:04.31,0:19:06.22,Default,,0,0,0,,Бірақ траектория өшірулі.
Dialogue: 0,0:19:06.85,0:19:08.23,Default,,0,0,0,,Мен Бүкіл Құдірет-ті қуып келемін!
Dialogue: 0,0:19:08.31,0:19:09.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:10.27,0:19:12.86,Default,,0,0,0,,Қабырғаның сынуы, бүкіл денесінің көгеруі
Dialogue: 0,0:19:13.52,0:19:15.57,Default,,0,0,0,,Тыныс алудың бұзылуы
Dialogue: 0,0:19:20.49,0:19:22.03,Default,,0,0,0,,Тіпті «индивидуалдылық» болмаса да
Dialogue: 0,0:19:22.12,0:19:24.20,Default,,0,0,0,,Батыр мұны істей ала ма?
Dialogue: 0,0:19:25.12,0:19:30.46,Default,,0,0,0,,Менің де жастық шағым бір кездері болды.
Dialogue: 0,0:19:31.04,0:19:32.46,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:32.54,0:19:34.50,Default,,0,0,0,,Құдірет атты адам
Dialogue: 0,0:19:34.59,0:19:37.26,Default,,0,0,0,,Бұл өмір сүрудің жалғыз жолы!
Dialogue: 0,0:19:37.34,0:19:39.17,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:19:42.34,0:19:43.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:43.72,0:19:45.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.22,0:19:49.52,Default,,0,0,0,,Сіз қайтадан жастайсыз ба?
Dialogue: 0,0:19:49.60,0:19:51.94,Default,,0,0,0,,Сіз бұл туралы білесіз бе?
Dialogue: 0,0:19:52.02,0:19:56.19,Default,,0,0,0,,Мені тексеріп, ес жиғым келмейді.
Dialogue: 0,0:19:56.98,0:20:00.40,Default,,0,0,0,,Пинкиді денеден шығару
Dialogue: 0,0:20:00.49,0:20:04.12,Default,,0,0,0,,Мен өзімнің «даралығымды» өзіме зиян келтіретін дәрежеде пайдаландым ...
Dialogue: 0,0:20:04.20,0:20:05.99,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:20:06.08,0:20:10.54,Default,,0,0,0,,Зақымға байланысты кері орау жылдамдай ма?
Dialogue: 0,0:20:11.71,0:20:12.54,Default,,0,0,0,,Хаха
Dialogue: 0,0:20:13.17,0:20:14.54,Default,,0,0,0,,А? (үшін мүмкін) Хахаха
Dialogue: 0,0:20:14.63,0:20:17.00,Default,,0,0,0,,Хахаха
Dialogue: 0,0:20:17.59,0:20:19.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:19.55,0:20:23.34,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:20:23.43,0:20:25.76,Default,,0,0,0,,Міндетті түрде әкел, Геркулес!
Dialogue: 0,0:20:26.89,0:20:29.18,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:20:29.27,0:20:31.23,Default,,0,0,0,,(үшінның күлкісі)
Dialogue: 0,0:20:31.23,0:20:34.27,Default,,0,0,0,,(үшінның күлкісі)
Dialogue: 0,0:20:31.23,0:20:34.27,Default,,0,0,0,,Мен адамдарға көмектесе алатыныма қуаныштымын
Dialogue: 0,0:20:34.27,0:20:34.60,Default,,0,0,0,,Мен адамдарға көмектесе алатыныма қуаныштымын
Dialogue: 0,0:20:35.19,0:20:37.86,Default,,0,0,0,,Сәттілік! Барымызды салайық!
Dialogue: 0,0:20:37.94,0:20:42.36,Default,,0,0,0,,«Uravity» итергіші «Ingenium» толық шығу!
Dialogue: 0,0:20:43.70,0:20:48.37,Default,,0,0,0,,А сыныбы, маған күшіңді бер!
Dialogue: 0,0:21:09.10,0:21:12.02,Default,,0,0,0,,Ми… Мидория…
Dialogue: 0,0:21:15.73,0:21:16.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:18.48,0:21:20.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.36,0:21:23.40,Default,,0,0,0,,Ұрыс...
Dialogue: 0,0:21:25.82,0:21:28.07,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,0:21:28.70,0:21:34.37,Default,,0,0,0,,Ей, жеңеміз, Мидорий бала!
Dialogue: 0,0:21:39.96,0:21:45.26,Default,,0,0,0,,♪～
Dialogue: 0,0:23:04.84,0:23:09.84,Default,,0,0,0,,～♪
