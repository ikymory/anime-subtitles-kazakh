Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:05.92,Default,,0,0,0,,Құрғаған ағаштарға көмектесу
Dialogue: 0,0:00:06.92,0:00:12.05,Default,,0,0,0,,Тога Химико, не істегіңіз келеді?
Dialogue: 0,0:00:12.68,0:00:16.93,Default,,0,0,0,,Барлық кейіпкерлерді, соның ішінде Хоксты да жойыңыз
Dialogue: 0,0:00:21.52,0:00:22.56,Default,,0,0,0,,Бұл Тога.
Dialogue: 0,0:00:23.44,0:00:26.02,Default,,0,0,0,,Бубайгавараның қаны... Сток!?
Dialogue: 0,0:00:26.11,0:00:26.94,Default,,0,0,0,,Аһ!
Dialogue: 0,0:00:28.02,0:00:30.48,Default,,0,0,0,,Бұл Дабидің жұмысы болды ма?
Dialogue: 0,0:00:31.07,0:00:33.11,Default,,0,0,0,,Енді кеш қалды.
Dialogue: 0,0:00:34.11,0:00:39.41,Default,,0,0,0,,Кім жыласа да, күлсе де ертеңгі күні тең келеді.
Dialogue: 0,0:00:39.49,0:00:43.54,Default,,0,0,0,,Олай болса күлейік, Химико Тога
Dialogue: 0,0:00:44.75,0:00:48.04,Default,,0,0,0,,Аянышты марш жалғасын тапсын.
Dialogue: 0,0:00:49.59,0:00:54.43,Default,,0,0,0,,Шексіз таралу Садманның өлім шеруі
Dialogue: 0,0:00:54.51,0:00:57.68,Default,,0,0,0,,Соңында күлген адам
Dialogue: 0,0:00:58.68,0:01:00.43,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:01:02.98,0:01:05.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:06.35,0:01:11.32,Default,,0,0,0,,Бұл жиі бүктелетін ара ма?
Dialogue: 0,0:01:12.44,0:01:16.41,Default,,0,0,0,,Қайтадан көз алдымнан кетуге шыдай алмаймын!
Dialogue: 0,0:01:21.37,0:01:23.33,Default,,0,0,0,,Сізді аулақ ұстаған сезімдер
Dialogue: 0,0:01:25.92,0:01:29.17,Default,,0,0,0,,Очако-чан, сен...
Dialogue: 0,0:01:30.42,0:01:33.71,Default,,0,0,0,,Мен саған әлі ғашық болған жоқпын!
Dialogue: 0,0:01:36.84,0:01:38.59,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:01:39.72,0:01:43.06,Default,,0,0,0,,Ғашық қыз енді жоқ.
Dialogue: 0,0:01:43.14,0:01:45.14,Default,,0,0,0,,Батыр
Dialogue: 0,0:01:47.56,0:01:49.65,Default,,0,0,0,,Бразилияда көбелектер қанаттарын қағады
Dialogue: 0,0:01:49.73,0:01:52.65,Default,,0,0,0,,Техас штатында дауыл болады ма?
Dialogue: 0,0:01:52.73,0:01:55.65,Default,,0,0,0,,Жарқыраған сәбиден басталған адамнан тыс қоғам
Dialogue: 0,0:01:55.74,0:01:58.86,Default,,0,0,0,,Бейбітшілікке жұтылатыны ма?
Dialogue: 0,0:01:59.49,0:02:03.04,Default,,0,0,0,,Әлемді бір адам өзгерте алады
Dialogue: 0,0:02:03.99,0:02:08.54,Default,,0,0,0,,♪～
Dialogue: 0,0:03:28.91,0:03:33.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:36.84,0:03:42.09,Default,,0,0,0,,(Қаһармандардың айқайлары)
Dialogue: 0,0:03:42.18,0:03:44.30,Default,,0,0,0,,Әлем үшін, өзгелер үшін—
Dialogue: 0,0:03:45.47,0:03:48.43,Default,,0,0,0,,Балшық қабырғаның артына өтіңіз! үшінңыз, қазір артқа тұрыңыз!
Dialogue: 0,0:03:49.02,0:03:52.02,Default,,0,0,0,,Сондай-ақ, жалынның әсерінен спора тарамайтын ара.
Dialogue: 0,0:03:52.10,0:03:54.73,Default,,0,0,0,,Тұтқынға алынған жауларды (зұлымдарды) да жылжытыңыз!
Dialogue: 0,0:03:54.81,0:03:56.48,Default,,0,0,0,,Өртеніп өлесің!
Dialogue: 0,0:03:58.78,0:04:01.49,Default,,0,0,0,,Бұл тек Химико Тога мен Курогири емес.
Dialogue: 0,0:04:02.07,0:04:04.07,Default,,0,0,0,,Мұнда Дабиге дейін
Dialogue: 0,0:04:05.53,0:04:09.79,Default,,0,0,0,,Тодороки-чан, Шоджи-чан, бәрі...
Dialogue: 0,0:04:09.87,0:04:11.29,Default,,0,0,0,,Уравиттілік! (Бақа үрлеу) Керо
Dialogue: 0,0:04:11.37,0:04:13.08,Default,,0,0,0,,FROPPY!
Dialogue: 0,0:04:14.00,0:04:16.67,Default,,0,0,0,,Цукуйоми! Құлаққап = Джек!
Dialogue: 0,0:04:18.38,0:04:22.72,Default,,0,0,0,,Шайқас хаосқа түсіп жатқан сияқты.
Dialogue: 0,0:04:22.80,0:04:24.97,Default,,0,0,0,,Киока-чан, сенің құлағың...
Dialogue: 0,0:04:25.05,0:04:26.30,Default,,0,0,0,,Ах... (Рейхи) Иә?
Dialogue: 0,0:04:26.39,0:04:28.47,Default,,0,0,0,,Бұл жын патшамен күресуге жеткілікті болса
Dialogue: 0,0:04:29.10,0:04:30.98,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:04:32.39,0:04:35.98,Default,,0,0,0,,Екеуің бір қақпадан шықтыңдар деген сөз.
Dialogue: 0,0:04:36.06,0:04:38.94,Default,,0,0,0,,Бұл Twice тобы - Тога.
Dialogue: 0,0:04:39.02,0:04:42.57,Default,,0,0,0,,Бұлай жалғаса берсе, Жапония толығымен оккупацияланады.
Dialogue: 0,0:04:43.49,0:04:44.95,Default,,0,0,0,,Тоқтау керек
Dialogue: 0,0:04:45.03,0:04:48.28,Default,,0,0,0,,Бірақ Дабидің қызуы тым күшті.
Dialogue: 0,0:04:49.66,0:04:51.91,Default,,0,0,0,,Тога қарамастан өседі
Dialogue: 0,0:04:52.50,0:04:56.21,Default,,0,0,0,,Біз қашудан басқа ештеңе істей алмаймыз
Dialogue: 0,0:04:57.13,0:04:59.46,Default,,0,0,0,,Бұл енді шайқас емес
Dialogue: 0,0:05:00.88,0:05:03.13,Default,,0,0,0,,Бөліну стратегиясы жеңіліске ұшырады.
Dialogue: 0,0:05:03.22,0:05:06.05,Default,,0,0,0,,Қарғыс атсын! Ха! Ха! Уф!
Dialogue: 0,0:05:06.14,0:05:07.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:07.89,0:05:10.22,Default,,0,0,0,,Кеудемдегі сол жалын...
Dialogue: 0,0:05:10.31,0:05:12.89,Default,,0,0,0,,Шото айтқан «фосфор» ма?
Dialogue: 0,0:05:12.98,0:05:16.65,Default,,0,0,0,,Шотоға не болды? Туя!
Dialogue: 0,0:05:17.44,0:05:20.27,Default,,0,0,0,,Мен оны кәдесый ретінде алғым келді.
Dialogue: 0,0:05:20.36,0:05:22.82,Default,,0,0,0,,Бұл күшті болды
Dialogue: 0,0:05:22.90,0:05:27.41,Default,,0,0,0,,Менің армандарым енді ешқашан орындалмайды
Dialogue: 0,0:05:27.99,0:05:34.41,Default,,0,0,0,,Сондықтан кем дегенде сіз үшін маңызды нәрсені қорғауға тырысыңыз.
Dialogue: 0,0:05:35.37,0:05:38.42,Default,,0,0,0,,Бірдей...
Dialogue: 0,0:05:39.84,0:05:41.71,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:42.67,0:05:44.97,Default,,0,0,0,,Маған жел соғып тұр
Dialogue: 0,0:05:45.92,0:05:51.14,Default,,0,0,0,,Бәрі бір-біріне тізбектелген, Қалағанымдай жұмыс істейді.
Dialogue: 0,0:05:51.68,0:05:56.27,Default,,0,0,0,,Курогиридің өзі жерлеу үйіне барса керек.
Dialogue: 0,0:05:56.98,0:06:01.57,Default,,0,0,0,,Ол менің жетілмеген балшықты бұрылысыма қарағанда әлдеқайда ұзағырақ тиімді диапазонға ие.
Dialogue: 0,0:06:01.65,0:06:05.99,Default,,0,0,0,,Мен сол «индивидуалдылықты» алғаным жақсы болар еді.
Dialogue: 0,0:06:06.07,0:06:07.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:07.65,0:06:09.70,Default,,0,0,0,,Осы хаосты пайдаланып
Dialogue: 0,0:06:10.32,0:06:12.91,Default,,0,0,0,,Мен жоқтаушының алдына барамын
Dialogue: 0,0:06:13.91,0:06:15.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:17.33,0:06:18.58,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:21.88,0:06:23.84,Default,,0,0,0,,Бүркіттер
Dialogue: 0,0:06:24.51,0:06:28.09,Default,,0,0,0,,Бубегавараның еркіне қарсы тұрыңыз.
Dialogue: 0,0:06:28.93,0:06:31.51,Default,,0,0,0,,Қайта орау ыңғайлылығына қарамастан
Dialogue: 0,0:06:31.60,0:06:33.89,Default,,0,0,0,,Сіз қатты асығып тұрған сияқтысыз.
Dialogue: 0,0:06:34.43,0:06:37.18,Default,,0,0,0,,Сіз Шигаракиге сенбейсіз бе?
Dialogue: 0,0:06:40.06,0:06:43.44,Default,,0,0,0,,Жақсы болжам, солай ма?
Dialogue: 0,0:06:44.40,0:06:48.20,Default,,0,0,0,,Бұл әлі толық емес.
Dialogue: 0,0:06:48.78,0:06:52.41,Default,,0,0,0,,Маған бұл қызметші керек болуының себебі бар.
Dialogue: 0,0:06:54.03,0:06:55.87,Default,,0,0,0,,Мистер Индевор!
Dialogue: 0,0:06:55.95,0:06:59.33,Default,,0,0,0,,Бөлу стратегиясы әлдеқашан жұмысын тоқтатты.
Dialogue: 0,0:06:59.41,0:07:02.54,Default,,0,0,0,,Осылай жалғаса берсе, аптап ыстықтан төбелесе алмаймыз.
Dialogue: 0,0:07:02.63,0:07:06.38,Default,,0,0,0,,Егер бұл жер жойылса, бәрі Деку мен қураған ағашқа айналады.
Dialogue: 0,0:07:07.09,0:07:08.84,Default,,0,0,0,,Туяны тоқтатыңыз!
Dialogue: 0,0:07:08.92,0:07:10.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:10.43,0:07:13.47,Default,,0,0,0,,Хахахахаха бұл қорқынышты.
Dialogue: 0,0:07:13.55,0:07:17.22,Default,,0,0,0,,Қолынан айырылып, есінен танып қалды
Dialogue: 0,0:07:17.31,0:07:19.98,Default,,0,0,0,,Оған қоса, сен солай айттың ғой, солай ма?
Dialogue: 0,0:07:20.60,0:07:25.57,Default,,0,0,0,,Оның міндеті – мені тез жеңу.
Dialogue: 0,0:07:25.65,0:07:26.82,Default,,0,0,0,,Міндеттерден бас тартқанға дейін…
Dialogue: 0,0:07:26.90,0:07:28.82,Default,,0,0,0,,Өте шулы!
Dialogue: 0,0:07:29.95,0:07:35.58,Default,,0,0,0,,Сіз біздің бірінші нөмірімізге бір рет ұтылған шығарсыз.
Dialogue: 0,0:07:35.66,0:07:38.50,Default,,0,0,0,,Демек, бұл бас тарту емес!
Dialogue: 0,0:07:39.71,0:07:41.54,Default,,0,0,0,,себебі
Dialogue: 0,0:07:48.84,0:07:50.22,Default,,0,0,0,,Миссия…
Dialogue: 0,0:07:56.97,0:07:59.98,Default,,0,0,0,,Бұл жолы мен
Dialogue: 0,0:08:01.23,0:08:02.73,Default,,0,0,0,,Мультфильмдерді көруге қатысты
Dialogue: 0,0:08:14.03,0:08:15.99,Default,,0,0,0,,Ах Ямада
Dialogue: 0,0:08:17.33,0:08:18.79,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:08:19.58,0:08:20.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:35.93,0:08:39.22,Default,,0,0,0,,...
Dialogue: 0,0:08:39.31,0:08:40.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:40.93,0:08:42.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:40.93,0:08:42.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:42.10,0:08:43.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:45.31,0:08:49.90,Default,,0,0,0,,(Өлі ағаштың айқайы)
Dialogue: 0,0:08:57.16,0:08:58.70,Default,,0,0,0,,Телефон бағанасы қирап қалды!
Dialogue: 0,0:08:58.78,0:09:01.58,Default,,0,0,0,,Қосалқы бөлікті шығару мүмкін емес! Шылдыр келеді!
Dialogue: 0,0:09:01.66,0:09:03.50,Default,,0,0,0,,Өте асқынудың бағасы келді!
Dialogue: 0,0:09:03.58,0:09:06.46,Default,,0,0,0,,Уф... электромагниттік тосқауыл ше!?
Dialogue: 0,0:09:06.54,0:09:09.00,Default,,0,0,0,,Қалған бөліктің өзі жеткіліксіз шығарылым!
Dialogue: 0,0:09:10.09,0:09:11.26,Default,,0,0,0,,Мұнда Мандалай
Dialogue: 0,0:09:11.34,0:09:13.34,Default,,0,0,0,,Жоғары көтерілуді басқару енді жұмыс істемейді
Dialogue: 0,0:09:13.42,0:09:14.26,Default,,0,0,0,,Иә!?
Dialogue: 0,0:09:15.18,0:09:16.09,Default,,0,0,0,,Бұл бұзу. Бақылау алынып жатыр.
Dialogue: 0,0:09:16.09,0:09:18.89,Default,,0,0,0,,Бұл бұзу. Бақылау алынып жатыр.
Dialogue: 0,0:09:16.09,0:09:18.89,Default,,0,0,0,,Қат! Қарғы сатқыр!
Dialogue: 0,0:09:19.89,0:09:22.39,Default,,0,0,0,,Ақыры оны қабылдадым
Dialogue: 0,0:09:23.93,0:09:26.48,Default,,0,0,0,,Құла, батыр!
Dialogue: 0,0:09:26.56,0:09:27.77,Default,,0,0,0,,Уау! (Яойорозу) Қарғыс атсын...
Dialogue: 0,0:09:27.85,0:09:31.32,Default,,0,0,0,,Сонымен бірге бақылау аралы қазір шабуылда.
Dialogue: 0,0:09:31.40,0:09:34.61,Default,,0,0,0,,Фантомды ұры Миссияны жалғастыру қиын!
Dialogue: 0,0:09:36.11,0:09:38.16,Default,,0,0,0,,«Өшіру» қиыршықталды
Dialogue: 0,0:09:38.24,0:09:42.29,Default,,0,0,0,,Бұлай жалғаса берсе, ең қасірет жау (жауыз) табиғатқа жіберіледі.
Dialogue: 0,0:09:42.37,0:09:46.46,Default,,0,0,0,,Ха ха ха... Курогири...
Dialogue: 0,0:09:46.54,0:09:49.13,Default,,0,0,0,,Сонымен Орталық ше!?
Dialogue: 0,0:09:49.21,0:09:54.34,Default,,0,0,0,,Юэй құласа, Жапония... жоқ, дүние...
Dialogue: 0,0:09:55.13,0:09:58.18,Default,,0,0,0,,Оны жалғыз өзі жояды!
Dialogue: 0,0:10:00.64,0:10:01.85,Default,,0,0,0,,Төңкерілді!
Dialogue: 0,0:10:01.93,0:10:05.39,Default,,0,0,0,,Қалыптау? Ол қозғалмайды
Dialogue: 0,0:10:07.44,0:10:10.69,Default,,0,0,0,,Мен сонда болсам да
Dialogue: 0,0:10:11.73,0:10:13.86,Default,,0,0,0,,Сіз не істегіңіз келді?
Dialogue: 0,0:10:13.94,0:10:14.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:16.65,0:10:21.91,Default,,0,0,0,,Ол жерде әлі қураған ағаштар бар ма?
Dialogue: 0,0:10:22.49,0:10:25.87,Default,,0,0,0,,Сауда орталығында сөйлесе аламыз ба?
Dialogue: 0,0:10:26.50,0:10:28.54,Default,,0,0,0,,Бұл бекер, батыр.
Dialogue: 0,0:10:28.62,0:10:32.25,Default,,0,0,0,,Мен сенің жауыңмын (зұлым)!
Dialogue: 0,0:10:33.13,0:10:34.42,Default,,0,0,0,,Қарғыс атсын... ха!
Dialogue: 0,0:10:35.26,0:10:39.22,Default,,0,0,0,,Шигаракидің... тұлғасы
Dialogue: 0,0:10:41.55,0:10:43.56,Default,,0,0,0,,Фуфуфухахаха...
Dialogue: 0,0:10:43.64,0:10:47.27,Default,,0,0,0,,Менің қолымда Юэй жүйесі осылай жұмыс істейді.
Dialogue: 0,0:10:47.89,0:10:51.15,Default,,0,0,0,,Жер асты эвакуация жүйесі қазірдің өзінде біздің қолымызда.
Dialogue: 0,0:10:51.23,0:10:54.61,Default,,0,0,0,,Ескі жолға жабысқан ақымақ та, батыр да
Dialogue: 0,0:10:54.69,0:10:58.70,Default,,0,0,0,,Азаттық үшін шашыраңдар!
Dialogue: 0,0:10:58.78,0:11:03.16,Default,,0,0,0,,(күлкі жанында)
Dialogue: 0,0:11:04.33,0:11:06.95,Default,,0,0,0,,Мен Юэйдің құлауын тоқтатуым керек.
Dialogue: 0,0:11:07.04,0:11:11.54,Default,,0,0,0,,Егер ол құлай берсе, Яойорозу-сан және оның астындағылардың бәрі өлтіріледі!
Dialogue: 0,0:11:11.63,0:11:16.17,Default,,0,0,0,,Бұл кезде Курогири де қураған ағаш қашып кетпеу үшін бақылап тұрды...
Dialogue: 0,0:11:16.25,0:11:22.09,Default,,0,0,0,,Жоқ, қарғыс атсын! Тыныс ала алмаймын... Дем ала алмаймын...
Dialogue: 0,0:11:23.22,0:11:25.85,Default,,0,0,0,,Жетілдірілген «ауысым» кері қайтару
Dialogue: 0,0:11:26.64,0:11:31.48,Default,,0,0,0,,Жасушалар демалмаса, олар оттегін қабылдай алмайды.
Dialogue: 0,0:11:31.56,0:11:34.77,Default,,0,0,0,,Мен саған әлі құлама дедім.
Dialogue: 0,0:11:34.86,0:11:36.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:36.65,0:11:40.32,Default,,0,0,0,,... дегенді бата деп айту керек пе?
Dialogue: 0,0:11:41.24,0:11:44.32,Default,,0,0,0,,Онда да интеграция айтарлықтай бұзылған сияқты.
Dialogue: 0,0:11:45.33,0:11:47.41,Default,,0,0,0,,«Біріміз бәріміз үшін» және «бәріміз біріміз үшін»
Dialogue: 0,0:11:47.49,0:11:52.04,Default,,0,0,0,,Бір-бірімізді сезіну арқылы енді бір-біріміздің ішімізді көре аламыз.
Dialogue: 0,0:11:53.13,0:11:56.67,Default,,0,0,0,,Денеңізді емін-еркін қимылдата алатындай жағдайда емес сияқтысыз.
Dialogue: 0,0:11:57.30,0:12:01.55,Default,,0,0,0,,Денеңізді мүмкіндігінше тезірек қозғалтуға тырысыңыз, тіпті бір секунд болса да.
Dialogue: 0,0:12:02.80,0:12:05.68,Default,,0,0,0,,Осы нүктеге дейінгі реттілік
Dialogue: 0,0:12:05.76,0:12:08.52,Default,,0,0,0,,Мен міндетті түрде сенің күшің боламын
Dialogue: 0,0:12:09.47,0:12:11.27,Default,,0,0,0,,Оны жазып алма~
Dialogue: 0,0:12:11.35,0:12:16.02,Default,,0,0,0,,Ақыры құйрығын көрсетті, өйткені оны табу өте қиын болды.
Dialogue: 0,0:12:17.19,0:12:18.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:18.11,0:12:21.61,Default,,0,0,0,,Бірақ, бірақ, менде мүлде қиындық жоқ.
Dialogue: 0,0:12:21.70,0:12:24.91,Default,,0,0,0,,Өйткені бұл мырзаларға арналған.
Dialogue: 0,0:12:33.87,0:12:35.46,Default,,0,0,0,,Эвакуация жүйесі тоқтатылды!
Dialogue: 0,0:12:35.54,0:12:37.79,Default,,0,0,0,,Радио кедергіге байланысты байланыс орнату мүмкін емес!
Dialogue: 0,0:12:37.88,0:12:40.21,Default,,0,0,0,,Көпшіліктен қолдау сұраңыз!
Dialogue: 0,0:12:40.30,0:12:42.59,Default,,0,0,0,,Бұл менің хикикомори күндерімді еске түсіреді.
Dialogue: 0,0:12:43.18,0:12:46.85,Default,,0,0,0,,Тәжірибе үшін Feel Good Inc. серверіне кіріңіз
Dialogue: 0,0:12:46.93,0:12:50.14,Default,,0,0,0,,Сіз барлық қатысты жарнамаларды «ГАНРИКИ☆НЕКО» деп өзгерттіңіз бе?
Dialogue: 0,0:12:50.72,0:12:51.27,Default,,0,0,0,,Ұзын функциялар үшін тым кең айнымалылар аумағы
Dialogue: 0,0:12:51.27,0:12:54.35,Default,,0,0,0,,Ұзын функциялар үшін тым кең айнымалылар аумағы
Dialogue: 0,0:12:51.27,0:12:54.35,Default,,0,0,0,,А... а... а... а... а...
Dialogue: 0,0:12:54.85,0:12:57.15,Default,,0,0,0,,Сол күндер және менің кодтау әдеттерім
Dialogue: 0,0:12:57.23,0:12:59.40,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:13:00.28,0:13:02.90,Default,,0,0,0,,Трипофобия~!
Dialogue: 0,0:13:02.99,0:13:05.70,Default,,0,0,0,,Ха! Сіз!
Dialogue: 0,0:13:05.78,0:13:08.24,Default,,0,0,0,,Бұл қанша зиян келтірді...
Dialogue: 0,0:13:08.33,0:13:10.24,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:13:11.33,0:13:12.95,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:13:14.54,0:13:17.04,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:13:17.13,0:13:21.00,Default,,0,0,0,,Тоқта! THE Pump биін жасамаңыз!
Dialogue: 0,0:13:21.63,0:13:24.80,Default,,0,0,0,,Нашар! Жүйелер бірінен соң бірі ұрлануда
Dialogue: 0,0:13:24.88,0:13:25.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:26.76,0:13:29.35,Default,,0,0,0,,Юэй және эвакуация жүйесі
Dialogue: 0,0:13:29.43,0:13:34.56,Default,,0,0,0,,Мен бұл ең жиіркенішті екі нәрседен бас тартпаймын.
Dialogue: 0,0:13:34.64,0:13:36.81,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:13:37.40,0:13:41.53,Default,,0,0,0,,Сіздің тұрған жеріңіз анықталса да, қашып кету керек.
Dialogue: 0,0:13:41.61,0:13:44.90,Default,,0,0,0,,Революцияның жалыны ешқашан сөнбейді!
Dialogue: 0,0:13:45.57,0:13:47.28,Default,,0,0,0,,Цукаучи мырза! (Цукаучи) Иә?
Dialogue: 0,0:13:47.36,0:13:49.95,Default,,0,0,0,,Юэйдің биіктігі одан да төмендейді!
Dialogue: 0,0:13:50.03,0:13:52.62,Default,,0,0,0,,Біз жерге барамыз және тоқтамаймыз!
Dialogue: 0,0:13:53.20,0:13:55.62,Default,,0,0,0,,Нарықтық баға Бірдеңені тез жасаңыз!
Dialogue: 0,0:13:55.71,0:13:59.38,Default,,0,0,0,,Жаңа ғана соққы бүкіл жүйенің күйреуіне әкелді.
Dialogue: 0,0:13:59.46,0:14:05.01,Default,,0,0,0,,Мен қазір тек қалған бөліктерді пайдалана отырып, жаңа бағдарламаны құрастырып жатырмын.
Dialogue: 0,0:14:05.09,0:14:07.34,Default,,0,0,0,,Мен уақытында үлгере алмаймын!
Dialogue: 0,0:14:08.05,0:14:10.85,Default,,0,0,0,,Бұл қателік болса керек...
Dialogue: 0,0:14:10.93,0:14:16.31,Default,,0,0,0,,Қорғаныстың соңғы шебі ретінде түрмедегі жауға (зұлымға) сүйену?
Dialogue: 0,0:14:18.06,0:14:21.86,Default,,0,0,0,,Күнә - күнә... өткенді өшіру мүмкін емес
Dialogue: 0,0:14:23.57,0:14:24.86,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:26.19,0:14:28.95,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:14:39.04,0:14:39.83,Default,,0,0,0,,Ол Жалпы курсқа да өтініш бергендіктен, олар бұған алдын ала дайын болған шығар.
Dialogue: 0,0:14:39.83,0:14:43.46,Default,,0,0,0,,Ол Жалпы курсқа да өтініш бергендіктен, олар бұған алдын ала дайын болған шығар.
Dialogue: 0,0:14:39.83,0:14:43.46,Default,,0,0,0,,Мен сенің жауыңмын (зұлым)
Dialogue: 0,0:14:43.46,0:14:44.13,Default,,0,0,0,,Ол Жалпы курсқа да өтініш бергендіктен, олар бұған алдын ала дайын болған шығар.
Dialogue: 0,0:14:44.13,0:14:45.05,Default,,0,0,0,,Ол Жалпы курсқа да өтініш бергендіктен, олар бұған алдын ала дайын болған шығар.
Dialogue: 0,0:14:44.13,0:14:45.05,Default,,0,0,0,,Түсінбесеңіз жақсы
Dialogue: 0,0:14:45.05,0:14:46.46,Default,,0,0,0,,Түсінбесеңіз жақсы
Dialogue: 0,0:14:47.13,0:14:52.10,Default,,0,0,0,,Қолынан келмейтіндіктен, оларды «батырлар» және «жаулар (жауыздар)» деп атайды.
Dialogue: 0,0:14:52.18,0:14:54.22,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:14:54.31,0:14:57.06,Default,,0,0,0,,Жоқ, сигнал қабылданбады!
Dialogue: 0,0:14:57.14,0:14:57.52,Default,,0,0,0,,Қайталап көріңіз (Оператор) Бұл мүмкін емес.
Dialogue: 0,0:14:57.52,0:14:58.69,Default,,0,0,0,,Қайталап көріңіз (Оператор) Бұл мүмкін емес.
Dialogue: 0,0:14:57.52,0:14:58.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:58.69,0:14:59.14,Default,,0,0,0,,Қайталап көріңіз (Оператор) Бұл мүмкін емес.
Dialogue: 0,0:14:59.23,0:15:02.23,Default,,0,0,0,,Басқаруды жоғалту Апатқа дайындалыңыз!
Dialogue: 0,0:15:02.31,0:15:03.65,Default,,0,0,0,,Ұрысқа дайындал!
Dialogue: 0,0:15:03.73,0:15:04.94,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:15:05.03,0:15:06.03,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:15:06.11,0:15:08.03,Default,,0,0,0,,Не, не, не, не!?
Dialogue: 0,0:15:10.53,0:15:11.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:13.70,0:15:15.62,Default,,0,0,0,,Екі рет!?
Dialogue: 0,0:15:15.70,0:15:17.45,Default,,0,0,0,,Монома~!
Dialogue: 0,0:15:17.54,0:15:18.62,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:15:19.50,0:15:23.38,Default,,0,0,0,,Қарғыс атсын... Бұл туралы не істеуім керек!
Dialogue: 0,0:15:23.96,0:15:26.55,Default,,0,0,0,,Этан! Лазермен жауларды (зұлымдарды) атыңыз
Dialogue: 0,0:15:26.63,0:15:29.30,Default,,0,0,0,,Одақтас па?! Қарғыс атсын!
Dialogue: 0,0:15:29.88,0:15:33.01,Default,,0,0,0,,Іштен басып кірсе, ол біз...
Dialogue: 0,0:15:33.09,0:15:33.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:35.18,0:15:36.39,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:15:44.40,0:15:45.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:46.32,0:15:48.69,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:15:50.11,0:15:52.49,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:15:52.57,0:15:53.91,Default,,0,0,0,,Ха! Уф!?
Dialogue: 0,0:15:54.91,0:15:57.12,Default,,0,0,0,,Орын әлдеқашан бөлісілген.
Dialogue: 0,0:15:57.20,0:15:59.08,Default,,0,0,0,,Скептик мырза
Dialogue: 0,0:15:59.83,0:16:03.63,Default,,0,0,0,,Бізге ең жақыны - біз ұстауға келгеніміз.
Dialogue: 0,0:16:03.71,0:16:05.84,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:16:06.67,0:16:08.34,Default,,0,0,0,,Таку… Гуруруру
Dialogue: 0,0:16:09.30,0:16:11.59,Default,,0,0,0,,Қандай себеп-салдар?
Dialogue: 0,0:16:12.63,0:16:17.47,Default,,0,0,0,,Мен оларға өз болашағымды сеніп тапсырамын...
Dialogue: 0,0:16:17.97,0:16:19.77,Default,,0,0,0,,Өтінемін, Тобита.
Dialogue: 0,0:16:19.85,0:16:21.18,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:16:21.27,0:16:26.56,Default,,0,0,0,,Жұмсақ~!
Dialogue: 0,0:16:26.65,0:16:28.44,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:29.61,0:16:32.90,Default,,0,0,0,,Оны өтеу үшін
Dialogue: 0,0:16:36.99,0:16:39.49,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:41.75,0:16:44.21,Default,,0,0,0,,Сыртқы қабырға бұзылған!
Dialogue: 0,0:16:44.29,0:16:46.13,Default,,0,0,0,,Уау! (Қызметкер) Сәлем!
Dialogue: 0,0:16:46.21,0:16:47.29,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:47.38,0:16:49.50,Default,,0,0,0,,Бұл айтарлықтай зиян келтірген сияқты. Мүмкін осылай жалғастыра береміз бе?
Dialogue: 0,0:16:49.59,0:16:50.51,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:56.30,0:16:58.72,Default,,0,0,0,,Енді сіз боссыз!
Dialogue: 0,0:17:01.73,0:17:03.85,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз!
Dialogue: 0,0:17:06.69,0:17:10.53,Default,,0,0,0,,Қалағаныңызша, қалағаныңызша!
Dialogue: 0,0:17:11.65,0:17:13.24,Default,,0,0,0,,Бостандық?
Dialogue: 0,0:17:13.32,0:17:15.03,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:17:16.11,0:17:18.37,Default,,0,0,0,,Бұл арман емес пе?
Dialogue: 0,0:17:18.45,0:17:22.25,Default,,0,0,0,,Мені сатқан жігіттен кек аламын.
Dialogue: 0,0:17:22.33,0:17:25.54,Default,,0,0,0,,Сол кезде пышақты сағынған адам болды.
Dialogue: 0,0:17:25.62,0:17:28.84,Default,,0,0,0,,Хахахаха Дүниеде не болып жатыр?
Dialogue: 0,0:17:28.92,0:17:30.59,Default,,0,0,0,,Хехехе... (Тұтқын) Әйел ғой. Бұл әйел.
Dialogue: 0,0:17:30.67,0:17:32.59,Default,,0,0,0,,Жабайы жүрейік
Dialogue: 0,0:17:33.67,0:17:35.30,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:17:36.09,0:17:39.89,Default,,0,0,0,,Ал... күтіңдер, балалар.
Dialogue: 0,0:17:40.68,0:17:44.06,Default,,0,0,0,,Өміріңді қайта бастай алмаймын деген адам болма.
Dialogue: 0,0:17:44.14,0:17:49.69,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,0:17:50.90,0:17:53.57,Default,,0,0,0,,Мен бұрыс бұрылдым
Dialogue: 0,0:17:54.19,0:17:57.11,Default,,0,0,0,,Тоқтауға да батылым жетпеді.
Dialogue: 0,0:17:58.32,0:18:02.16,Default,,0,0,0,,Жігіттер, сендер бұған жақсысыңдар ма?
Dialogue: 0,0:18:02.24,0:18:03.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.70,0:18:09.96,Default,,0,0,0,,Мен оның жақсы екеніне сенімдімін, солай емес пе? Бұлыңғыр!
Dialogue: 0,0:18:10.92,0:18:14.84,Default,,0,0,0,,Болашақ... Мен саған жарқын болашақты көрсете аламын.
Dialogue: 0,0:18:14.92,0:18:17.34,Default,,0,0,0,,Мен адам болғым келеді!
Dialogue: 0,0:18:31.27,0:18:33.44,Default,,0,0,0,,Жеті түрмеге шабуыл жасалды
Dialogue: 0,0:18:34.32,0:18:38.95,Default,,0,0,0,,Бұл түрмеден ешкім қашпаған жалғыз орын.
Dialogue: 0,0:18:40.53,0:18:41.70,Default,,0,0,0,,Тобита
Dialogue: 0,0:18:43.87,0:18:45.83,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:18:49.25,0:18:51.25,Default,,0,0,0,,Мен Лаваны көргім келеді
Dialogue: 0,0:18:52.92,0:18:54.59,Default,,0,0,0,,Және…
Dialogue: 0,0:19:02.97,0:19:07.43,Default,,0,0,0,,Мен сенімен бірге болсам, бақытты боламын деп ойладым
Dialogue: 0,0:19:08.23,0:19:10.81,Default,,0,0,0,,Мен болсам, ашуланар едім.
Dialogue: 0,0:19:11.60,0:19:12.94,Default,,0,0,0,,Өйткені
Dialogue: 0,0:19:14.69,0:19:17.69,Default,,0,0,0,,Джентельмен бақытты болса, мен—
Dialogue: 0,0:19:18.53,0:19:21.45,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:19:23.37,0:19:25.79,Default,,0,0,0,,Біз кездесе алмаған уақыт
Dialogue: 0,0:19:26.74,0:19:29.75,Default,,0,0,0,,Махаббатты одан сайын күшейтіңіз
Dialogue: 0,0:19:38.46,0:19:43.05,Default,,0,0,0,,...
Dialogue: 0,0:19:48.68,0:19:49.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:49.98,0:19:53.31,Default,,0,0,0,,Уф... мм!
Dialogue: 0,0:19:53.40,0:19:54.94,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:55.02,0:19:56.57,Default,,0,0,0,,(Айзава) Егер ол тағы да солай болса, мен дереу тоқтатып, Мидорияны шетке шығарамын
Dialogue: 0,0:19:58.44,0:20:00.15,Default,,0,0,0,,Сіз әлі
Dialogue: 0,0:20:00.99,0:20:05.91,Default,,0,0,0,,Сіз біреудің күлкісі үшін күресесіз бе?
Dialogue: 0,0:20:06.41,0:20:11.33,Default,,0,0,0,,Сол кезде мен құлап бара жатқан адамға көмектескім келді.
Dialogue: 0,0:20:12.42,0:20:17.71,Default,,0,0,0,,Бұл сезімде өтірік болған жоқ!
Dialogue: 0,0:20:20.38,0:20:22.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:27.10,0:20:29.64,Default,,0,0,0,,Ол сақталды ма? не?
Dialogue: 0,0:20:31.06,0:20:33.94,Default,,0,0,0,,Ауа батут сияқты...
Dialogue: 0,0:20:34.48,0:20:38.11,Default,,0,0,0,,Ауа... Батут...
Dialogue: 0,0:20:38.19,0:20:40.15,Default,,0,0,0,,Ха! Ахх
Dialogue: 0,0:20:44.99,0:20:50.45,Default,,0,0,0,,Мен жай ғана көмектескім келді.
Dialogue: 0,0:20:51.45,0:20:56.21,Default,,0,0,0,,Жұмсақ... Жұмсақ қылмыскер
Dialogue: 0,0:20:56.29,0:20:58.17,Default,,0,0,0,,Бала, бұл жаман! (Изуку) Ха!
Dialogue: 0,0:20:58.75,0:21:02.17,Default,,0,0,0,,Зат қозғала бастады, тепе-теңдік қазірдің өзінде...
Dialogue: 0,0:21:04.13,0:21:08.93,Default,,0,0,0,,Құлау тоқтаса да, сол қол жерге тисе
Dialogue: 0,0:21:09.76,0:21:11.68,Default,,0,0,0,,Куу… Куу…
Dialogue: 0,0:21:17.81,0:21:18.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:23.70,0:21:25.07,Default,,0,0,0,,Қанша жерден жүрсек те
Dialogue: 0,0:21:26.28,0:21:28.57,Default,,0,0,0,,Жау (жауыз) да адам.
Dialogue: 0,0:21:29.66,0:21:34.21,Default,,0,0,0,,Біз мұны қарастыруымыз керек.
Dialogue: 0,0:21:35.12,0:21:37.71,Default,,0,0,0,,Достың сөзімен
Dialogue: 0,0:21:42.55,0:21:45.76,Default,,0,0,0,,Олардың жүрегінде -
Dialogue: 0,0:21:46.68,0:21:49.05,Default,,0,0,0,,«Шығу тегі» деген не?
Dialogue: 0,0:21:51.01,0:21:56.31,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.89,0:23:20.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.15,0:23:23.65,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:24.23,0:23:28.78,Default,,0,0,0,,Леди Наган атқан оқ қураған ағашты шарпыды.
Dialogue: 0,0:23:28.86,0:23:30.66,Default,,0,0,0,,Ол жалғыз емес
Dialogue: 0,0:23:30.74,0:23:35.54,Default,,0,0,0,,Pro Heroes Heroic Hero бөлімі Басқару бөлімі
Dialogue: 0,0:23:35.62,0:23:40.41,Default,,0,0,0,,Олар да шайқасқа қатысады
Dialogue: 0,0:23:40.50,0:23:43.00,Default,,0,0,0,,Келесі жолы «үміт»
Dialogue: 0,0:23:43.08,0:23:47.80,Default,,0,0,0,,Әрбір тілек үмітке айналады, шынжырланып, таралады.
Dialogue: 0,0:23:47.88,0:23:50.88,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.38,0:23:58.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
