Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 10,0:00:11.40,0:00:13.32,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:00:11.45,0:00:12.94,JPO-ja,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 10,0:00:14.99,0:00:17.24,Default,,0,0,0,,Ято-чан! Хиорин! Юкки!
Dialogue: 0,0:00:15.18,0:00:17.40,JPO-ja,,0,0,0,,Ято-чан Хиори Юкки
Dialogue: 0,0:00:17.58,0:00:19.41,JPO-ja,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 10,0:00:17.62,0:00:19.95,Default,,0,0,0,,Жақсы екеніңізге өте қуаныштымын!
Dialogue: 10,0:00:22.08,0:00:24.92,Default,,0,0,0,,Сонымен, Бишамон-сан мен оның Регалиясы қалай?
Dialogue: 0,0:00:22.12,0:00:24.56,JPO-ja,,0,0,0,,Сонымен Бишамон және басқалары
Dialogue: 10,0:00:24.92,0:00:28.54,Default,,0,0,0,,Оның бәрі жақсы. Және оның өткенге қатысты түсінбеушіліктері жойылды.
Dialogue: 0,0:00:25.18,0:00:26.18,JPO-ja,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:00:26.76,0:00:28.41,JPO-ja,,0,0,0,,Өткен түсінбеушілік жойылды
Dialogue: 0,0:00:29.10,0:00:31.27,JPO-ja,,0,0,0,,Бұл да оның Сукуонмен байланысы.
Dialogue: 10,0:00:29.13,0:00:34.22,Default,,0,0,0,,Енді мен оның маған деген кекінен құтылатын шығармын.
Dialogue: 0,0:00:32.23,0:00:33.63,JPO-ja,,0,0,0,,Ол ақырында бұзылады.
Dialogue: 10,0:00:34.22,0:00:36.80,Default,,0,0,0,,Сен туралы білмеймін, бірақ мен көктемін!
Dialogue: 0,0:00:34.54,0:00:36.54,JPO-ja,,0,0,0,,Мен үшін бәрі жақсы.
Dialogue: 10,0:00:36.80,0:00:39.35,Default,,0,0,0,,Бұл жынды балапан енді мені аңдымайды,
Dialogue: 0,0:00:36.85,0:00:39.34,JPO-ja,,0,0,0,,Енді шлюхалар қумайды.
Dialogue: 10,0:00:39.35,0:00:44.06,Default,,0,0,0,,және жақсы Юкин мен үшін императорлық регалияға айналды!
Dialogue: 0,0:00:39.63,0:00:41.10,JPO-ja,,0,0,0,,О, құдай, Юкине
Dialogue: 0,0:00:41.65,0:00:43.94,JPO-ja,,0,0,0,,Өйткені ол мерекенің сауытына айналды.
Dialogue: 10,0:00:44.06,0:00:45.60,Default,,0,0,0,,Не?!
Dialogue: 0,0:00:45.54,0:00:46.18,JPO-ja,,0,0,0,,Ах.
Dialogue: 10,0:00:45.60,0:00:46.15,Default,,0,0,0,,Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 10,0:00:46.15,0:00:46.52,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:00:46.18,0:00:46.67,JPO-ja,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 10,0:00:46.52,0:00:47.31,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:00:46.67,0:00:47.23,JPO-ja,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:00:47.30,0:00:48.47,JPO-ja,,0,0,0,,Мына масқараға ма?
Dialogue: 10,0:00:47.31,0:00:48.82,Default,,0,0,0,,Сол бейшара үшін бе?!
Dialogue: 10,0:00:50.07,0:00:52.36,Default,,0,0,0,,Осы аянышты шебер үшін бе?
Dialogue: 0,0:00:50.24,0:00:52.41,JPO-ja,,0,0,0,,Мына қарғыс атқыр қожайын үшін...
Dialogue: 10,0:00:52.36,0:00:54.53,Default,,0,0,0,,Әлгі сұмдық шын мәнінде...
Dialogue: 0,0:00:52.41,0:00:54.54,JPO-ja,,0,0,0,,Әлгі қарғыс атқыр бала...
Dialogue: 10,0:00:55.32,0:00:57.37,Default,,0,0,0,,Императорлық регалия?
Dialogue: 0,0:00:55.36,0:00:56.76,JPO-ja,,0,0,0,,Құттықтау ыдысы?
Dialogue: 10,0:00:57.37,0:01:01.33,Default,,0,0,0,,Бұл Юккидің қожайынын қорғау үшін өз атын тәуекел еткенін көрсетеді.
Dialogue: 0,0:00:57.38,0:01:01.32,JPO-ja,,0,0,0,,Бұл Юккидің қожайынын қорғау үшін өз атын тәуекел еткенінің дәлелі.
Dialogue: 0,0:01:01.41,0:01:02.25,JPO UP-ja,,0,0,0,,Аякароза
Dialogue: 10,0:01:02.00,0:01:04.08,Default,,0,0,0,,Кадзу-кунның Бишаға жасағаны сияқты.
Dialogue: 0,0:01:02.05,0:01:04.09,JPO-ja,,0,0,0,,Бишаның немере ағасы Чо-кунмен бірдей
Dialogue: 0,0:01:02.25,0:01:02.95,JPO UP-ja,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:01:03.05,0:01:04.16,JPO UP-ja,,0,0,0,,Жарайсың
Dialogue: 10,0:01:04.08,0:01:06.83,Default,,0,0,0,,Олар өте ерекше Регалия.
Dialogue: 0,0:01:04.34,0:01:06.61,JPO-ja,,0,0,0,,Бұл өте ерекше қасиетті қазына.
Dialogue: 0,0:01:07.72,0:01:08.41,JPO-ja,,0,0,0,,Жақсы
Dialogue: 0,0:01:09.96,0:01:10.87,JPO-ja,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:01:11.38,0:01:13.01,JPO-ja,,0,0,0,,Сіз оны таптыңыз.
Dialogue: 10,0:01:11.38,0:01:15.13,Default,,0,0,0,,Сіз өзіңіздің ерекше адамыңызды таптыңыз, Ято.
Dialogue: 0,0:01:13.45,0:01:14.87,JPO-ja,,0,0,0,,Ято жалғыз және жалғыз
Dialogue: 10,0:01:16.80,0:01:17.64,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:01:18.76,0:01:21.25,JPO-ja,,0,0,0,,Жарайды, бүгін банкет.
Dialogue: 10,0:01:18.76,0:01:21.26,Default,,0,0,0,,Жарайды! Біз бүгін кешті тойлаймыз!
Dialogue: 10,0:01:21.26,0:01:23.18,Default,,0,0,0,,Кешке дайындалайық!
Dialogue: 0,0:01:21.32,0:01:23.25,JPO-ja,,0,0,0,,Мен үйге барып дайындалайын.
Dialogue: 10,0:01:23.18,0:01:24.02,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:01:23.96,0:01:24.92,JPO-ja,,0,0,0,,Дайындық…
Dialogue: 10,0:01:24.02,0:01:25.39,Default,,0,0,0,,Дайындық...
Dialogue: 10,0:01:25.39,0:01:28.86,Default,,0,0,0,,О, жоқ! Менің біліктілікті арттыру емтиханым бүгін!
Dialogue: 0,0:01:25.98,0:01:28.14,JPO-ja,,0,0,0,,Жоқ, менде бүгін жоғарылау емтиханы болды.
Dialogue: 10,0:01:28.86,0:01:30.82,Default,,0,0,0,,Кешіріңіз! Мен шынымен баруым керек!
Dialogue: 0,0:01:28.90,0:01:30.94,JPO-ja,,0,0,0,,Кешіріңіз. Алдымен кешіріңізші.
Dialogue: 10,0:01:30.82,0:01:32.98,Default,,0,0,0,,Бір сәт, Хиори-сан.
Dialogue: 0,0:01:30.96,0:01:32.89,JPO-ja,,0,0,0,,Сәл күте тұрыңыз, Хиори-сан.
Dialogue: 10,0:01:32.98,0:01:34.44,Default,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:01:33.01,0:01:33.74,JPO-ja,,0,0,0,,Иә?
Dialogue: 10,0:01:35.65,0:01:36.99,Default,,0,0,0,,Ято-кун...
Dialogue: 0,0:01:35.67,0:01:38.50,JPO-ja,,0,0,0,,Ято-кун, сол кездегі уәде
Dialogue: 10,0:01:36.99,0:01:40.37,Default,,0,0,0,,Біздің келісіміміз есіңізде ме?
Dialogue: 0,0:01:39.36,0:01:40.25,JPO-ja,,0,0,0,,Естеріңізде.
Dialogue: 2,0:01:46.33,0:01:48.25,oprom-kfx5,,0,0,0,,Не істейсің?
Dialogue: 4,0:01:46.40,0:01:46.57,OP-JP-ja,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 3,0:01:46.49,0:01:46.90,OP-JP-ja,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
