Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.04,0:00:13.03,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:00:14.09,0:00:17.02,Default,,0,0,0,,Ято-чан! Хиорин! Юкки!
Dialogue: 0,0:00:15.01,0:00:17.04,Default,,0,0,0,,Ято-чан Хиори Юкки
Dialogue: 0,0:00:17.05,0:00:19.04,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:00:22.00,0:00:24.09,Default,,0,0,0,,Сонымен, Бишамон-сан мен оның Регалиясы қалай? Сонымен Бишамон және басқалары
Dialogue: 0,0:00:24.09,0:00:28.05,Default,,0,0,0,,Оның бәрі жақсы. Және оның өткенге қатысты түсінбеушіліктері жойылды.
Dialogue: 0,0:00:25.01,0:00:26.01,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:00:26.07,0:00:28.04,Default,,0,0,0,,Өткен түсінбеушілік жойылды
Dialogue: 0,0:00:29.01,0:00:34.02,Default,,0,0,0,,Бұл да оның Сукуонмен байланысы. Енді мен оның маған деген кекінен құтылатын шығармын.
Dialogue: 0,0:00:32.02,0:00:33.06,Default,,0,0,0,,Ол ақырында бұзылады.
Dialogue: 0,0:00:34.02,0:00:36.08,Default,,0,0,0,,Сен туралы білмеймін, бірақ мен көктемін! Мен үшін бәрі жақсы.
Dialogue: 0,0:00:36.08,0:00:39.03,Default,,0,0,0,,Бұл жынды балапан енді мені аңдымайды, Енді шлюхалар қумайды.
Dialogue: 0,0:00:39.03,0:00:44.00,Default,,0,0,0,,және жақсы Юкин мен үшін императорлық регалияға айналды! О, құдай, Юкине
Dialogue: 0,0:00:41.06,0:00:43.09,Default,,0,0,0,,Өйткені ол мерекенің сауытына айналды.
Dialogue: 0,0:00:44.00,0:00:45.06,Default,,0,0,0,,Не?!
Dialogue: 0,0:00:45.05,0:00:46.01,Default,,0,0,0,,Ах. Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 0,0:00:46.01,0:00:47.03,Default,,0,0,0,,Мен көптен бері өлі болсам да Бұл… (Бакуго) Э? Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой. Ешқашан қайталанбасын
Dialogue: 0,0:00:47.03,0:00:48.04,Default,,0,0,0,,Мына масқараға ма? Сол бейшара үшін бе?!
Dialogue: 0,0:00:50.00,0:00:52.03,Default,,0,0,0,,Осы аянышты шебер үшін бе? Мына қарғыс атқыр қожайын үшін...
Dialogue: 0,0:00:52.03,0:00:54.05,Default,,0,0,0,,Әлгі сұмдық шын мәнінде... Әлгі қарғыс атқыр бала...
Dialogue: 0,0:00:55.03,0:00:57.03,Default,,0,0,0,,Императорлық регалия? Құттықтау ыдысы?
Dialogue: 0,0:00:57.03,0:01:01.03,Default,,0,0,0,,Бұл Юккидің қожайынын қорғау үшін өз атын тәуекел еткенін көрсетеді. Бұл Юккидің қожайынын қорғау үшін өз атын тәуекел еткенінің дәлелі.
Dialogue: 0,0:01:01.04,0:01:02.02,Default,,0,0,0,,Аякароза
Dialogue: 0,0:01:02.00,0:01:04.00,Default,,0,0,0,,Кадзу-кунның Бишаға жасағаны сияқты. Бишаның немере ағасы Чо-кунмен бірдей Мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:01:03.00,0:01:04.01,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:01:04.00,0:01:06.08,Default,,0,0,0,,Олар өте ерекше Регалия. Бұл өте ерекше қасиетті қазына.
Dialogue: 0,0:01:07.07,0:01:08.04,Default,,0,0,0,,Жақсы
Dialogue: 0,0:01:09.09,0:01:10.08,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:01:11.03,0:01:15.01,Default,,0,0,0,,Сіз оны таптыңыз. Сіз өзіңіздің ерекше адамыңызды таптыңыз, Ято.
Dialogue: 0,0:01:13.04,0:01:14.08,Default,,0,0,0,,Ято жалғыз және жалғыз
Dialogue: 0,0:01:16.08,0:01:17.06,Default,,0,0,0,,Оқу, оқу
Dialogue: 0,0:01:18.07,0:01:21.02,Default,,0,0,0,,Жарайды, бүгін банкет. Жарайды! Біз бүгін кешті тойлаймыз!
Dialogue: 0,0:01:21.02,0:01:23.01,Default,,0,0,0,,Кешке дайындалайық! Мен үйге барып дайындалайын.
Dialogue: 0,0:01:23.09,0:01:24.09,Default,,0,0,0,,Дайындық…
Dialogue: 0,0:01:24.00,0:01:25.03,Default,,0,0,0,,Дайындық...
Dialogue: 0,0:01:25.03,0:01:28.08,Default,,0,0,0,,О, жоқ! Менің біліктілікті арттыру емтиханым бүгін!
Dialogue: 0,0:01:28.08,0:01:30.08,Default,,0,0,0,,Кешіріңіз! Мен шынымен баруым керек! Кешіріңіз. Алдымен кешіріңізші.
Dialogue: 0,0:01:30.08,0:01:32.09,Default,,0,0,0,,Бір сәт, Хиори-сан. Сәл күте тұрыңыз, Хиори-сан.
Dialogue: 0,0:01:32.09,0:01:34.04,Default,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:01:33.00,0:01:33.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:35.06,0:01:38.05,Default,,0,0,0,,Ято-кун... Ято-кун, сол кездегі уәде
Dialogue: 0,0:01:36.09,0:01:40.03,Default,,0,0,0,,Біздің келісіміміз есіңізде ме?
Dialogue: 0,0:01:39.03,0:01:40.02,Default,,0,0,0,,Естеріңізде.
Dialogue: 0,0:01:46.03,0:01:48.02,Default,,0,0,0,,Не істейсің?
Dialogue: 0,0:01:48.03,0:02:00.03,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:02:01.00,0:02:04.05,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды Тартымды дәм, дәм, дәм
Dialogue: 0,0:02:02.07,0:02:04.04,Default,,0,0,0,,Не істейсің? Жетуге таяп қалдық па?
Dialogue: 0,0:02:04.04,0:02:07.08,Default,,0,0,0,,Қош келдіңіз. Артына отызыңыз. Қанша рет тырыссам да, дұрыс байлай алмаймын. Өтіріктер, мен оларды жек көремін, құлдырау, әр күн сайын лақтыру
Dialogue: 0,0:02:07.08,0:02:11.02,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы "Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:02:09.05,0:02:13.06,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:11.02,0:02:13.08,Default,,0,0,0,,Жетуге таяп қалдық па?
Dialogue: 0,0:02:13.07,0:02:17.01,Default,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:02:15.03,0:02:15.53,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:02:17.01,0:02:20.05,Default,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:02:18.07,0:02:18.57,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:02:20.05,0:02:25.00,Default,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:02:21.04,0:02:27.02,Default,,0,0,0,,Өтіріктер, мен оларды жек көремін, құлдырау, әр күн сайын лақтыру
Dialogue: 0,0:02:22.01,0:02:22.51,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:02:27.07,0:02:32.02,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:29.04,0:02:34.05,Default,,0,0,0,,Тартымды дәм, дәм, дәм
Dialogue: 0,0:02:32.02,0:02:34.04,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы Жарық жасыл, Ято-сан.
Dialogue: 0,0:02:34.04,0:02:36.02,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:36.02,0:02:41.01,Default,,0,0,0,,Тартымды дәм, дәм, дәм Эбису
Dialogue: 0,0:02:39.05,0:02:41.01,Default,,0,0,0,,Жетуге таяп қалдық па?
Dialogue: 0,0:02:41.01,0:02:43.00,Default,,0,0,0,,Сенің аяқ киім бауың ашылып кеткен. Ято-сан, жарық сигналдары жасыл. Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:42.08,0:02:45.06,Default,,0,0,0,,Қош келдіңіз. Артына отызыңыз. Қанша рет тырыссам да, дұрыс байлай алмаймын.
Dialogue: 0,0:02:43.00,0:02:48.00,Default,,0,0,0,,Өтіріктер, мен оларды жек көремін, құлдырау, әр күн сайын лақтыру
Dialogue: 0,0:02:47.09,0:02:49.06,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:48.00,0:02:49.07,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:02:49.07,0:02:53.07,Default,,0,0,0,,Не істейсің?
Dialogue: 0,0:02:54.08,0:02:59.03,Default,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:02:59.04,0:03:01.05,Default,,0,0,0,,Өтіріктер, мен оларды жек көремін, құлдырау, әр күн сайын лақтыру Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:03:01.05,0:03:06.08,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы "Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:03:03.01,0:03:07.04,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:03:06.08,0:03:09.05,Default,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:03:11.05,0:03:14.07,Default,,0,0,0,,Өтінемін, Тенжин. Бізді сол жерге апарыңыз. Өтінемін, Тэнжин, бізді аспанға көтер.
Dialogue: 0,0:03:15.03,0:03:17.00,Default,,0,0,0,,Хиори бізге керек. Осы қарқынмен Хиори...
Dialogue: 0,0:03:18.00,0:03:20.03,Default,,0,0,0,,Ному үшін екі шарт бар. Мен екі шартпен келісемін.
Dialogue: 0,0:03:20.08,0:03:24.06,Default,,0,0,0,,Біріншіден, менің қандай да бір жолмен қатысқанымды ешкім білмеуі керек. Біріншіден, бұл мәселеге менің қатысым жоқ.
Dialogue: 0,0:03:25.01,0:03:27.00,Default,,0,0,0,,Екінші шартқа келсек... Ал басқа нәрсе
Dialogue: 0,0:03:27.06,0:03:31.09,Default,,0,0,0,,Аман-есен оралған соң, онымен байланысыңды үзу керек. Аман-есен оралған соң, Хиори-санмен байланысты үз.
Dialogue: 0,0:03:35.08,0:03:37.02,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:03:37.06,0:03:39.09,Default,,0,0,0,,Сіз бұған келістіңіз бе?
Dialogue: 0,0:03:39.09,0:03:44.04,Default,,0,0,0,,Ято сізді Қиыр жағалауға тым көп қатыстырды.
Dialogue: 0,0:03:40.02,0:03:44.05,Default,,0,0,0,,Хиори-сан Ято-кун арқылы Хиганға тым терең араласты.
Dialogue: 0,0:03:44.04,0:03:48.07,Default,,0,0,0,,Бұл шиеленіс сізді жаңа ғана бастан өткерген қауіп түріне ұшыратады. Сондықтан мен осындай қауіпті жағдайға тап болдым.
Dialogue: 0,0:03:49.01,0:03:50.00,Default,,0,0,0,,Бірақ, Тенжин-сама... Бірақ Тенжи...
Dialogue: 0,0:03:50.00,0:03:52.00,Default,,0,0,0,,Хиори-сан өлген жоқ. Хиори өлген жоқ.
Dialogue: 0,0:03:52.07,0:03:55.09,Default,,0,0,0,,Оны тиесілі жеріне қайтарыңыз.
Dialogue: 0,0:03:55.09,0:03:58.09,Default,,0,0,0,,Бұл сіз үшін дұрыс әрекет.
Dialogue: 0,0:03:56.00,0:03:58.07,Default,,0,0,0,,Міне, солай істеу керек
Dialogue: 0,0:04:01.04,0:04:02.03,Default,,0,0,0,,Секки. Есеп бер.
Dialogue: 0,0:04:07.08,0:04:09.03,Default,,0,0,0,,Байланыстарымызды кесеміз бе? О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:04:09.09,0:04:11.00,Default,,0,0,0,,Ято жақсы ма? Сен мұнымен жақсысың ба, Ято?
Dialogue: 0,0:04:11.05,0:04:14.05,Default,,0,0,0,,Мен бірге істегеніміздің бәрін ұмытамын, солай ма? Сіз Ято және басқалар туралы бәрін ұмытатын шығарсыз.
Dialogue: 0,0:04:15.00,0:04:16.05,Default,,0,0,0,,Сен бұған шынымен жарайсың ба?! Бұл әлі де жақсы ма?
Dialogue: 0,0:04:18.02,0:04:19.06,Default,,0,0,0,,Мен олай емеспін. Мен...
Dialogue: 0,0:04:20.05,0:04:21.05,Default,,0,0,0,,Кеспеңіз Өтінемін, мұны жасамаңыз.
Dialogue: 0,0:04:22.05,0:04:24.09,Default,,0,0,0,,Мен сізге бұрын айтқанмын. мен... Мен саған айттым...
Dialogue: 0,0:04:24.09,0:04:28.02,Default,,0,0,0,,Мен әлі де саған жақын болғым келеді!
Dialogue: 0,0:04:25.02,0:04:28.02,Default,,0,0,0,,Мен Ятомен көбірек уақыт өткізгім келеді.
Dialogue: 0,0:04:34.06,0:04:38.06,Default,,0,0,0,,Жетуге таяп қалдық па? Құдайға қалай құлшылық ету керек Құдайға қалай құлшылық ету керек
Dialogue: 0,0:04:40.00,0:04:45.00,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды. Эй, менің формасым қазір өте жақсы көріне бастады, солай емес пе?
Dialogue: 0,0:04:41.05,0:04:45.00,Default,,0,0,0,,Біз бұл формада жақсы көріне бастадық, иә?
Dialogue: 0,0:04:45.00,0:04:50.00,Default,,0,0,0,,Иә! Алғашында біраз ұялдым, бірақ мен оларды жақсы көретінмін. Иә, мен басында біраз ұялдым.
Dialogue: 0,0:04:48.04,0:04:50.00,Default,,0,0,0,,Мен үйреніп қалған шығармын.
Dialogue: 0,0:04:50.00,0:04:54.03,Default,,0,0,0,,Жігіт, сенің орта мектепке түскеніңе қуаныштымын. Хиоридің аман-есен орта мектеп оқушысы атанғанына қуаныштымын.
Dialogue: 0,0:04:54.03,0:04:57.00,Default,,0,0,0,,Сіз емтиханға әрең дегенде ояндыңыз. Менің ойымша, ол жоғарылау емтиханының соңғы минутына дейін ұйықтады.
Dialogue: 0,0:04:59.00,0:05:02.04,Default,,0,0,0,,Денсаулығыңыз болмаса да, өзіңізге әрең кірдіңіз, иә, Яма? Ямада ештеңе болмаса да, әрең дегенде көтерілді.
Dialogue: 0,0:05:02.04,0:05:04.04,Default,,0,0,0,,Мұны қайдан білесіз? Сен оны не үшін білесің?
Dialogue: 0,0:05:05.04,0:05:07.04,Default,,0,0,0,,Сонымен, сіз қай клубқа қосыласыз? Оның орнына клубтық іс-шаралар туралы не айтасыз?
Dialogue: 0,0:05:07.04,0:05:09.02,Default,,0,0,0,,Мен әлі де сенімді емеспін! Сіз әлі абдырап тұрсыз, солай емес пе?
Dialogue: 0,0:05:09.02,0:05:12.08,Default,,0,0,0,,Мүмкін теннис немесе баскетбол немесе гуманитарлық ғылымдар немесе өнер саласындағы бір нәрсе болуы мүмкін. Теннис клубы немесе баскетбол клубы?
Dialogue: 0,0:05:11.01,0:05:12.05,Default,,0,0,0,,Либералды өнерді де тастау қиын.
Dialogue: 0,0:05:12.08,0:05:14.03,Default,,0,0,0,,Сен ше, Хиори?
Dialogue: 0,0:05:13.00,0:05:13.50,Default,,0,0,0,,Хиори ше?
Dialogue: 0,0:05:14.03,0:05:16.07,Default,,0,0,0,,Хм, мен...
Dialogue: 0,0:05:15.00,0:05:18.09,Default,,0,0,0,,Мен... Неге, ол Ято клубына қосылмақшы, әрине! Әрине Хиори
Dialogue: 0,0:05:17.01,0:05:18.03,Default,,0,0,0,,Бұл түнгі клуб.
Dialogue: 0,0:05:20.01,0:05:21.04,Default,,0,0,0,,Не болды, Хиори? Ештеңе болмаса да, кем дегенде орташа баға алса.
Dialogue: 0,0:05:21.04,0:05:24.07,Default,,0,0,0,,Ято клубына қазір қосылыңыз, сонда сіз біздің форманы аласыз: Бүгін кешке клубқа қосылсаңыз
Dialogue: 0,0:05:23.03,0:05:26.09,Default,,0,0,0,,Сізге сәйкес форма мен кең шарф беріледі.
Dialogue: 0,0:05:24.07,0:05:27.04,Default,,0,0,0,,үлпілдек шарф!
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Иә? Неге жылдамдаттың?
Dialogue: 0,0:05:30.00,0:05:32.06,Default,,0,0,0,,Сіз фут-жарыс клубына қосыласыз ба?! Сонымен, сіз жүгіру үйірмесіне қатысуды жоспарлап отырсыз ба?
Dialogue: 0,0:05:32.06,0:05:35.08,Default,,0,0,0,,Ято клубы! Ято клубы! Ято клубы! Түнгі бөлім Түнгі бөлім Түнгі бөлім
Dialogue: 0,0:05:33.06,0:05:35.08,Default,,0,0,0,,Ято клубы! Ято клубы! Ято клубы!
Dialogue: 0,0:05:38.01,0:05:41.06,Default,,0,0,0,,Міне! Оның алғашқы орта мектебінің Insta-Snooze! Орта мектептегі өмірімнің алғашқы қойылымы
Dialogue: 0,0:05:42.08,0:05:45.06,Default,,0,0,0,,Иә! Сіз дәл Ято клубы іздейтін нәрсесіз!
Dialogue: 0,0:05:43.00,0:05:45.05,Default,,0,0,0,,Йо, Түнгі клубқа жаңадан келген келешегі зор.
Dialogue: 0,0:05:45.06,0:05:47.08,Default,,0,0,0,,Менің артымнан жүруді тоқтатасыз ба?! Менің артымнан ерме
Dialogue: 0,0:05:47.08,0:05:50.02,Default,,0,0,0,,Жүр! Не істеп жатырсың, шебердің ақымақ?! Әй, сен не істеп жатырсың, ақымақ?
Dialogue: 0,0:05:50.02,0:05:53.09,Default,,0,0,0,,Ято клубы! Ято клубы! Түнгі бөлім Түнгі бөлім Түнгі бөлім
Dialogue: 0,0:05:52.04,0:05:54.02,Default,,0,0,0,,Уф! Саған не керек?! Бұл не?
Dialogue: 0,0:05:54.01,0:05:55.03,Default,,0,0,0,,Түнгі бөлім Түнгі бөлім Оны өшіріңіз! Сабыр етіңіз.
Dialogue: 0,0:05:55.06,0:05:59.03,Default,,0,0,0,,Олар байланыстарын мүлде үзбеген сияқты. Үшеулеріңнің араларыңдағы байланыс мүлдем үзілген жоқ.
Dialogue: 0,0:06:00.01,0:06:03.04,Default,,0,0,0,,Ято-кун шынымен де жақсы емес. Шынымды айтсам, қазір. Ято шынымен үмітсіз.
Dialogue: 0,0:06:04.02,0:06:06.06,Default,,0,0,0,,Маған қызық, сіз не істеуді жоспарлап отырсыз. Оның не істемекші болғаны маған таң қалды.
Dialogue: 0,0:06:06.05,0:06:07.02,Default,,0,0,0,,Мырзам. Кофуку, біраз уақытқа мұнда менің орныма келші?
Dialogue: 0,0:06:08.07,0:06:11.02,Default,,0,0,0,,Біз қазір кетуіміз керек. Басудың уақыты келді.
Dialogue: 0,0:06:14.00,0:06:15.02,Default,,0,0,0,,Бишамон-доно. Бишамонден
Dialogue: 0,0:06:15.09,0:06:19.08,Default,,0,0,0,,Сіз соғыс құдайы болсаңыз да, сіздің соңғы әрекеттеріңіз қабылданбайды.
Dialogue: 0,0:06:16.00,0:06:17.00,Default,,0,0,0,,Ол соғыс құдайы болғанымен
Dialogue: 0,0:06:17.07,0:06:19.08,Default,,0,0,0,,Мен бұл жолы тым мас болдым.
Dialogue: 0,0:06:19.08,0:06:24.09,Default,,0,0,0,,Ал қазір бізде Құдайлар айынан тыс жерде ауызекі әңгіме өтіп жатыр.
Dialogue: 0,0:06:20.00,0:06:22.03,Default,,0,0,0,,Тәңірде ай бар сияқты
Dialogue: 0,0:06:22.04,0:06:24.06,Default,,0,0,0,,Құдайдың ақыл-кеңестері басқа нәрсе.
Dialogue: 0,0:06:25.09,0:06:28.02,Default,,0,0,0,,Бірақ құдайлар құлап, аспан бұзылды. Жемқорлығың көкті шайқады.
Dialogue: 0,0:06:28.06,0:06:30.04,Default,,0,0,0,,Неліктен басқа құдайларды араластырдың? Басқа құдайларды қатыстыру
Dialogue: 0,0:06:30.04,0:06:32.09,Default,,0,0,0,,және осындай үлкен толқу тудырды? Неліктен ол соншалықты қираған?
Dialogue: 0,0:06:34.01,0:06:38.01,Default,,0,0,0,,Менің әрекеттерім Ято құдайының шабуылына нашар жауап болды. Бұл Ятогамидің шабуылына жауап берудегі епсіздігім болды.
Dialogue: 0,0:06:38.01,0:06:41.01,Default,,0,0,0,,Ято құдайы? Жылан құдай, Ято-но-ками? Ято құдайы? Жылан құдайының Ято Құдайы ма?
Dialogue: 0,0:06:40.09,0:06:43.01,Default,,0,0,0,,Бір сәт! Бұл туралы менің білімім жоқ.
Dialogue: 0,0:06:41.01,0:06:43.02,Default,,0,0,0,,Күте тұрыңыз, бұл есімде жоқ.
Dialogue: 0,0:06:43.05,0:06:46.00,Default,,0,0,0,,Алаяқ менің атымды пайдаланып жүрген болуы керек! Бұл менің атым болып көрінетін жалған.
Dialogue: 0,0:06:46.00,0:06:48.06,Default,,0,0,0,,Шынында да, мен сені айтқым келмейді, Ято-но-Ками. Бұл Ятогами емес.
Dialogue: 0,0:06:48.06,0:06:51.02,Default,,0,0,0,,Мен ғибадатханасы жоқ аты жоқ құдайды айтып отырмын. Компаниясы жоқ анонимді құдай.
Dialogue: 0,0:06:51.02,0:06:54.00,Default,,0,0,0,,О, иә. Ондайлар бар.
Dialogue: 0,0:06:52.05,0:06:53.09,Default,,0,0,0,,Кейде Орноу
Dialogue: 0,0:06:54.00,0:06:57.01,Default,,0,0,0,,Басқалардың мәртебесінен пайда табуға тырысатын жаңадан бастағандар. Өзгенің қылышымен атақ іздегендер
Dialogue: 0,0:06:57.01,0:06:58.04,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:06:58.04,0:07:02.02,Default,,0,0,0,,Менің ойымша, кедейлік құдайы Эбису-саманың атын пайдаланады. Ебісу-саманың атын да кедейлік құдайы қолданғанына сенімдімін.
Dialogue: 0,0:07:02.02,0:07:07.00,Default,,0,0,0,,Бірақ ғибадатханасы жоқ не'ер-до-құдық Такамахараға қалай көтеріле алды? Бірақ ғибадатханасы жоқ бағана Такамахараға қалай жетті?
Dialogue: 0,0:07:08.06,0:07:12.00,Default,,0,0,0,,Ұсақ-түйек культтің аты жоқ құдайына қарсы болмаңыз. Аты жоқ ұятсыз және зұлым табынушылық құдайлардан бас тартыңыз.
Dialogue: 0,0:07:12.00,0:07:13.09,Default,,0,0,0,,Бетперде кигендер – нағыз алаңдаушылық. Мені алаңдататын нәрсе - маска.
Dialogue: 0,0:07:14.06,0:07:18.05,Default,,0,0,0,,Маскалылар - алтылық нүктелерінде қолданылатын фантомдар. Қарғыс қолданатын жындар
Dialogue: 0,0:07:17.04,0:07:21.04,Default,,0,0,0,,Ер адамдар Такамахарада бұрын-соңды болмаған.
Dialogue: 0,0:07:18.05,0:07:21.07,Default,,0,0,0,,Такамахарада бұрын-соңды ешқайсысы пайда болған емес.
Dialogue: 0,0:07:21.07,0:07:25.09,Default,,0,0,0,,Оларды осында әкелген «Кугаханы» не үшін босаттың?
Dialogue: 0,0:07:22.00,0:07:25.08,Default,,0,0,0,,Неліктен Лукуба бетін шақырғаннан кейін босатылды?
Dialogue: 0,0:07:25.09,0:07:31.03,Default,,0,0,0,,Шынымен. Біз оларды жасаған сиқыршы туралы біле алар едік.
Dialogue: 0,0:07:26.00,0:07:26.50,Default,,0,0,0,,Сол жақ мырза
Dialogue: 0,0:07:27.02,0:07:30.07,Default,,0,0,0,,Мен масканы басқаратын сиқыршыға жақындасам болар еді.
Dialogue: 0,0:07:31.03,0:07:33.03,Default,,0,0,0,,Мен асығыс әрекет еткенімді мойындаймын. Бұл, әрине, ойланбаған.
Dialogue: 0,0:07:34.02,0:07:39.00,Default,,0,0,0,,Менің бір адамым оны «Куга» деген атпен байланыстыра алмағанын кейін білдім. Менің отбасымды «Рику» деген атпен байланыстыруға болмайтынын кейін білдім.
Dialogue: 0,0:07:39.06,0:07:42.03,Default,,0,0,0,,Менің ойымша, ол сиқыршы Нора болды. Ол сиқыршының адасқаны болуы мүмкін.
Dialogue: 0,0:07:45.00,0:07:46.07,Default,,0,0,0,,А Нора, сен не айтасың? «Бұл адасқан» деген нені білдіреді?
Dialogue: 0,0:07:47.08,0:07:51.04,Default,,0,0,0,,Сіз мұнда біреуді оған ат берді деп айыптап жатқан сияқтысыз. Мұнда біреудің аты бар ма?
Dialogue: 0,0:07:50.02,0:07:51.05,Default,,0,0,0,,Бұл солай естіледі.
Dialogue: 0,0:07:51.04,0:07:55.09,Default,,0,0,0,,Мұндай ештеңе жоқ! Мен ешкімді кінәлағым келмейді! Мен бір нәрсеге сенімдімін: полиция араласқан күнде де өзімді қорғай аламын.
Dialogue: 0,0:07:53.01,0:07:55.08,Default,,0,0,0,,Мен барлығын кінәлауға тырыспаймын.
Dialogue: 0,0:07:55.09,0:08:01.03,Default,,0,0,0,,Мені мазалайтыны – бұл сиқыршының құдайларды алдаудағы тапқырлығы мен тапқырлығы!
Dialogue: 0,0:07:56.01,0:08:00.07,Default,,0,0,0,,Менің қорқатыным – тіпті Құдайды да алдауға тырысатын сиқыршылардың айлалары.
Dialogue: 0,0:08:02.07,0:08:05.04,Default,,0,0,0,,Бұл оқиға көкте де, жерде де дауыл соқты. Жақында болған шу аспан мен жерді дүр сілкіндірді.
Dialogue: 0,0:08:05.04,0:08:09.02,Default,,0,0,0,,Фантомдардың көбеюі Төменгі патшалықты тыныштандыратыны сөзсіз. Жындар көбейді.
Dialogue: 0,0:08:07.07,0:08:09.01,Default,,0,0,0,,Төменгі дүние де қиыншылыққа ұшырайды.
Dialogue: 0,0:08:09.02,0:08:13.02,Default,,0,0,0,,Фантомдардың кез келген қимылына бәріңіз назар аударуыңыз керек Жындардың қимылдарына назар аудара отырып,
Dialogue: 0,0:08:13.02,0:08:16.06,Default,,0,0,0,,және сіз тапқан маскалылар туралы хабарлауды жалғастырыңыз. Әдеттегідей, кез келген көргендер туралы хабарлаңыз.
Dialogue: 0,0:08:17.04,0:08:19.05,Default,,0,0,0,,Мен осы Кугаха үшін іздеу хабарламасын шығарамын. Рикубаға және басқаларға сұрау формасын жіберейік.
Dialogue: 0,0:08:20.06,0:08:22.03,Default,,0,0,0,,Әңгімелесу үзіліс жариялады. Мұның бәрі Құдай кеңесі үшін.
Dialogue: 0,0:08:24.07,0:08:26.05,Default,,0,0,0,,Сонда ол шынымен бұзылған ба? Құдайдың құлауы шынымен болды ма?
Dialogue: 0,0:08:26.05,0:08:30.03,Default,,0,0,0,,Ол екі рет сәтсіздікке ұшыраса да, оның жетекші дауысы болып қала ма? Қожамды екі рет жоғалтқаннан кейін, әлі де жолбасшы деген не?
Dialogue: 0,0:08:31.06,0:08:33.07,Default,,0,0,0,,Мен қайтып келдім, Казума.
Dialogue: 0,0:08:34.04,0:08:35.06,Default,,0,0,0,,Сіз шаршаған болуыңыз керек. Еңбегіңіз үшін рахмет
Dialogue: 0,0:08:36.02,0:08:37.09,Default,,0,0,0,,Бұл, әрине, шаршатады. Күткендей жауап бермеңіз.
Dialogue: 0,0:08:37.09,0:08:40.03,Default,,0,0,0,,Мен кінәлі екенімді білсем де,
Dialogue: 0,0:08:38.03,0:08:40.04,Default,,0,0,0,,Бұл өз кінәңіз екенін білсеңіз де
Dialogue: 0,0:08:40.07,0:08:44.00,Default,,0,0,0,,Тәңір ретінде басқаларға бас иуге шамам жоқ. Құдай басын төмен салып айнала алмайды.
Dialogue: 0,0:08:44.00,0:08:45.07,Default,,0,0,0,,Мен олардың наразылығын түсінемін. Мен олардың көңілсіздігін түсінемін.
Dialogue: 0,0:08:48.01,0:08:51.04,Default,,0,0,0,,Бізде әлі күнге дейін Кугаханың қайда екені туралы мәлімет жоқ. Рикубаның тұрған жеріне келсек?
Dialogue: 0,0:08:50.00,0:08:51.02,Default,,0,0,0,,...
Dialogue: 0,0:08:51.08,0:08:54.04,Default,,0,0,0,,Егер ол шынымен Нора болса, Егер ол шынымен адасушы болса
Dialogue: 0,0:08:54.04,0:08:57.01,Default,,0,0,0,,ол өзінің басқа қожайынына оралған болуы мүмкін. Сіз басқа шебермен біргесіз бе?
Dialogue: 0,0:08:57.08,0:09:00.04,Default,,0,0,0,,Бетперделерді жасаған сиқыршы... Масканы жасаған сиқыршыда?
Dialogue: 0,0:09:00.08,0:09:04.03,Default,,0,0,0,,Фантомдарды атау және қолдану... Бірақ жындардың атын қойып, оларды қуыршақ ретінде пайдалану, т.б.
Dialogue: 0,0:09:04.03,0:09:07.02,Default,,0,0,0,,негізінен бүлінуді сұрайды. Өзімді пышақтап алуымды сұрағандай.
Dialogue: 0,0:09:07.02,0:09:08.06,Default,,0,0,0,,Әдетте мұны ешкім жасамас еді. Әдетте мүмкін емес
Dialogue: 0,0:09:08.06,0:09:12.05,Default,,0,0,0,,Мұндай құдайдың өмір сүруі мүмкін емес еді. Құдай болса, ол өмір сүре алмайды.
Dialogue: 0,0:09:12.05,0:09:17.04,Default,,0,0,0,,Бұл немесе олар болмауы керек нәрсе. Әлде болмауы керек болмыс па...?
Dialogue: 0,0:09:17.04,0:09:18.05,Default,,0,0,0,,Әрине, оның қасиетті қазыналарының басым бөлігі адасқандардан тұрған болар, иә? Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:09:19.05,0:09:21.02,Default,,0,0,0,,Сізді көргеніме қуаныштымын! Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:21.02,0:09:24.05,Default,,0,0,0,,Окунинуши! Ал басқалары, Окунинуши?
Dialogue: 0,0:09:23.03,0:09:24.00,Default,,0,0,0,,Барлығы да
Dialogue: 0,0:09:24.05,0:09:25.04,Default,,0,0,0,,сызық!
Dialogue: 0,0:09:25.07,0:09:27.05,Default,,0,0,0,,Барлық жеті бақыт құдайы! Жеті бақытты құдай сәйкес келеді
Dialogue: 0,0:09:27.09,0:09:33.00,Default,,0,0,0,,Мен олардың сенің ішіңнен айнып кететінін білдім!
Dialogue: 0,0:09:28.00,0:09:29.02,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:29.05,0:09:32.07,Default,,0,0,0,,Ащы сарказмға толы болды.
Dialogue: 0,0:09:33.00,0:09:36.02,Default,,0,0,0,,Құлағыма көгергенім жетеді! Дұрыс, Инаба-чан? Құлақта көгереді
Dialogue: 0,0:09:34.08,0:09:36.03,Default,,0,0,0,,Ноу Инаба-чан
Dialogue: 0,0:09:37.02,0:09:38.06,Default,,0,0,0,,Сізді барлығы ести алады. Оны айналаңыздағы адамдар ести алады.
Dialogue: 0,0:09:38.06,0:09:40.03,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:09:40.03,0:09:41.05,Default,,0,0,0,,Қалай болғанда да, Бишамон! Одан да көп, Бишамон
Dialogue: 0,0:09:41.05,0:09:43.06,Default,,0,0,0,,Өйткені біз қайтадан біргеміз, Жеті бақытты Құдайдың жиналғанына көп уақыт болды.
Dialogue: 0,0:09:43.06,0:09:46.05,Default,,0,0,0,,Мен Гавайидегі филиал ғибадатханада кеш ұйымдастырып жатырмын! Менің Гавайидегі филиалымда кеш өткізіп жатырмыз.
Dialogue: 0,0:09:46.05,0:09:48.00,Default,,0,0,0,,Келгіңіз келе ме?! Келесің бе?
Dialogue: 0,0:09:48.00,0:09:49.02,Default,,0,0,0,,Ебису ше?
Dialogue: 0,0:09:49.02,0:09:52.02,Default,,0,0,0,,Иә? Ол дәл осында болды.
Dialogue: 0,0:09:50.03,0:09:51.09,Default,,0,0,0,,Картоп біраз бұрын болды
Dialogue: 0,0:09:52.02,0:09:53.07,Default,,0,0,0,,Оның қайда кеткенін кім біледі?! Сен қайда бардың?
Dialogue: 0,0:09:54.07,0:09:58.01,Default,,0,0,0,,Мен мүлде таз жігіттің не ойлайтынын білмеймін. Балды не ойлайтынын түсінсем, тозақ!
Dialogue: 0,0:09:58.01,0:10:00.02,Default,,0,0,0,,Әйтеуір, мүмкін болса, келіңіз, Бишамон! Жарайды, егер келе аламын деп ойласаң, кел, Бишамон.
Dialogue: 0,0:10:00.02,0:10:02.02,Default,,0,0,0,,Біз құлағанша тоқтамаймыз! Бүгін түнде
Dialogue: 0,0:10:02.07,0:10:04.03,Default,,0,0,0,,Сіз барасыз ба? Вина Сіз қатысасыз ба, Вена?
Dialogue: 0,0:10:04.06,0:10:06.04,Default,,0,0,0,,Хм? Жоқ.
Dialogue: 0,0:10:05.04,0:10:06.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:06.04,0:10:08.03,Default,,0,0,0,,Бақыт құдайы Ебису
Dialogue: 0,0:10:08.03,0:10:10.05,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын, Ято құдай. Танысқаныма қуаныштымын Ятогами
Dialogue: 0,0:10:10.08,0:10:13.02,Default,,0,0,0,,Мен Ебисумын, жеті құдайдың бірімін. Мен Ебисумын, жеті бақытты Құдайдың бірімін.
Dialogue: 0,0:10:13.02,0:10:16.06,Default,,0,0,0,,Мен сен туралы біраз әңгіме естідім, көрдің бе, Мен бұрын сіз туралы өсек естідім.
Dialogue: 0,0:10:16.06,0:10:18.03,Default,,0,0,0,,сондықтан мен сізге өтінішпен келдім. Мен сенен көмек сұрауға асықтым.
Dialogue: 0,0:10:18.08,0:10:19.08,Default,,0,0,0,,Ивами. Ол аспанды еш себепсіз дүрліктірмейді.
Dialogue: 0,0:10:19.08,0:10:20.05,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр. Иә
Dialogue: 0,0:10:22.08,0:10:25.01,Default,,0,0,0,,Мен сіздің Император Регалияңызды сатып алғым келеді. Мен мұнымен мерекелік ыдыс алғым келеді.
Dialogue: 0,0:10:27.04,0:10:31.01,Default,,0,0,0,,Бұл жеткіліксіз болса, маған хабарлаңыз. Егер жеткіліксіз болса
Dialogue: 0,0:10:28.09,0:10:30.08,Default,,0,0,0,,Бізге айтуыңызды өтінемін
Dialogue: 0,0:10:34.00,0:10:35.01,Default,,0,0,0,,B-Бастық! Вака... вака
Dialogue: 0,0:10:35.01,0:10:36.05,Default,,0,0,0,,Оян, Ято құдайы. Оян, Ятогами
Dialogue: 0,0:10:36.05,0:10:40.01,Default,,0,0,0,,Мен Юкинді қалаймын. Мен кез келген бағаны төлеуге дайынмын.
Dialogue: 0,0:10:38.02,0:10:39.09,Default,,0,0,0,,Мен бұл мақсатқа кез келген соманы жұмсаймын
Dialogue: 0,0:10:40.08,0:10:41.08,Default,,0,0,0,,Бағасы бар ма?! Кез келген сома?
Dialogue: 0,0:10:41.08,0:10:43.09,Default,,0,0,0,,Уа, Ято! Сіз байсалды бола алмайсыз!
Dialogue: 0,0:10:42.00,0:10:43.09,Default,,0,0,0,,Эй Ято, мазалама.
Dialogue: 0,0:10:43.09,0:10:45.06,Default,,0,0,0,,Сіз мені шынымен сатасыз ба?! Эй, сен мені сатпақшысың ба?
Dialogue: 0,0:10:45.06,0:10:46.05,Default,,0,0,0,,Юкине-кун
Dialogue: 0,0:10:46.09,0:10:49.05,Default,,0,0,0,,Маған қосылсаң, мен саған айына бір миллион төлеймін. Менің үйіме келсең, мен саған айына 1 миллион иен беремін.
Dialogue: 0,0:10:50.00,0:10:50.50,Default,,0,0,0,,Профессор, шай ішесіз бе? Қ-қайда жүрміз?
Dialogue: 0,0:10:51.00,0:10:54.07,Default,,0,0,0,,Сіз ашкөздіктің бақылауына алуға мүмкіндік бересіз! Мен бұл өткір шағуды сезіндім! Әй, менің басымнан шайтан болды.
Dialogue: 0,0:10:52.08,0:10:54.06,Default,,0,0,0,,Ол дірілдей бастады. Ол дірілдей бастайды.
Dialogue: 0,0:10:54.07,0:10:56.05,Default,,0,0,0,,A-Бұл статикалық соққы емес екеніне сенімдісіз бе? Бұл статикалық электр емес.
Dialogue: 0,0:10:56.05,0:10:59.01,Default,,0,0,0,,Бұл әдепсіз әрекет, Юкине-доно. Бұл көріксіз, Юкине-доно.
Dialogue: 0,0:10:59.01,0:11:01.04,Default,,0,0,0,,Осы сияқты бірдеңе үшін шу шығару... Осындай нәрселерді шу шығару, т.б.
Dialogue: 0,0:11:01.04,0:11:03.07,Default,,0,0,0,,Бұл бағыттаушы дауысқа лайық емес. Бағытшы ретінде құқығы жоқ
Dialogue: 0,0:11:04.06,0:11:06.07,Default,,0,0,0,,Бағыттаушы дауыс? Көрсеткіш...
Dialogue: 0,0:11:06.07,0:11:07.09,Default,,0,0,0,,Мен?! Мен?
Dialogue: 0,0:11:07.09,0:11:12.03,Default,,0,0,0,,Дұрыс. Сіз Ято-саманың бірегей және құнды Регалиясысыз.
Dialogue: 0,0:11:08.02,0:11:12.01,Default,,0,0,0,,Дұрыс, сіз Ято Құдайдың жалғыз және жалғыз қасиетті қазынасысыз.
Dialogue: 0,0:11:13.03,0:11:16.02,Default,,0,0,0,,Бұл сізді бағыттаушы дауыспен бірдей етеді. Ол енді бағдаршамен бірдей емес
Dialogue: 0,0:11:16.02,0:11:21.00,Default,,0,0,0,,Жетекші дауыс құдайына қызмет етіп, ізгілікке жол көрсетеді. Көрсеткіш – ізгілікке жол сілтейтін және Құдайға еретін жолбасшы.
Dialogue: 0,0:11:21.00,0:11:23.09,Default,,0,0,0,,Сіз оны құдайдың екінші тұлғасы деп айта аласыз.
Dialogue: 0,0:11:23.09,0:11:28.01,Default,,0,0,0,,Жолыңнан адассаң, қожайын құлап, ақырында жоқ болады.
Dialogue: 0,0:11:24.01,0:11:26.05,Default,,0,0,0,,Жолыңнан адассаң, Тәңірім құдай болады.
Dialogue: 0,0:11:26.06,0:11:27.07,Default,,0,0,0,,Соңы жойылады
Dialogue: 0,0:11:28.01,0:11:32.08,Default,,0,0,0,,Ято-саманың атын қорғау әдетте оның жетекші дауысының міндеті болып табылады. Бастапқыда Ято Құдайының есімі жол көрсетуші бағанамен қорғалуы керек.
Dialogue: 0,0:11:34.04,0:11:38.03,Default,,0,0,0,,Мүмкін сіз басқа бағыттаушы дауысты қолдана аласыз, Ято құдайы. Неліктен Ятогами Юкинеден басқа бағыттаушы тірек орнатпайды?
Dialogue: 0,0:11:38.03,0:11:41.00,Default,,0,0,0,,Немесе тіпті Юкинді бөлісе аламыз. Немесе сіз Yukine-ді бөлісе аласыз.
Dialogue: 0,0:11:41.00,0:11:43.06,Default,,0,0,0,,Мен оның талантын, тіпті Нора ретінде де қуана қарсы алар едім. Мен адасқандарды мүмкіндігінше қарсы аламын.
Dialogue: 0,0:11:44.07,0:11:51.03,Default,,0,0,0,,Императорлық регалия басқа құдайдың үйінде тұруға мәжбүр болған қожайынға жұмсалады. Қандай болса да, мерекелік ыдысқа ие болу ысырап.
Dialogue: 0,0:11:48.04,0:11:51.01,Default,,0,0,0,,Басқа құдайға қарыз болған Ие
Dialogue: 0,0:11:51.03,0:11:53.09,Default,,0,0,0,,Сіздің жеке қасиетті жеріңіз де жоқ па? Кем дегенде компания бар емес пе?
Dialogue: 0,0:11:54.09,0:11:57.07,Default,,0,0,0,,Факторизацияны қолдану
Dialogue: 0,0:12:01.04,0:12:03.06,Default,,0,0,0,,Ято клубының отырысы 16:00-де. Мен білмеймін Хабар Жолтайым Құдай Мәліметтер
Dialogue: 0,0:12:03.06,0:12:05.04,Default,,0,0,0,,пинг Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат Соба-Данго Соба-Данго Шируко Шируко Кофуку, Хиёри-чанды ластан тазала. Кофуку, Хиёри-чанды ластан тазала. Кофуку, Хиёри-чанды ластан тазала. m 135 45.375 b 135 45.375 145.625 36.875 146.625 56.625 147.375 71.5 146.75 75.625 143 80.827.5. 140,625 82,625 138,625 82,125 135,75 81,625 132 79,375 131,5 71,375 л 136,375 71,625 б 136,375 71,625 714. 140,75 59,875 138,25 45,625 138 48,125 135 45,375 м 3,5 8,5 б 3,5 8,5 14,125 0 15,125 19,875 15,125 134,85,2 11,5 44,125 10,875 45 9,125 45,75 7,125 45,375 4,25 44,75 0,5 42,5 0 34,625 л 4,875 34,875 б 4,875 34,875. 9,25 23 6,75 8,75 6,5 11,25 3,5 8,5 m 135 45.375 b 135 45.375 145.625 36.875 146.625 56.625 147.375 71.5 146.75 75.625 143 80.827.5. 140,625 82,625 138,625 82,125 135,75 81,625 132 79,375 131,5 71,375 л 136,375 71,625 б 136,375 71,625 714. 140,75 59,875 138,25 45,625 138 48,125 135 45,375 м 3,5 8,5 б 3,5 8,5 14,125 0 15,125 19,875 15,125 134,85,2 11,5 44,125 10,875 45 9,125 45,75 7,125 45,375 4,25 44,75 0,5 42,5 0 34,625 л 4,875 34,875 б 4,875 34,875. 9,25 23 6,75 8,75 6,5 11,25 3,5 8,5 м 0 64,5 л 168,375 99,5 168,375 106,75 0 72,625 м 0 0 л 168,375 44,875 168,375 52,125 0 8,125 м 59 25,875 б 55,75 22,625 55,625 20,5 57,375 18,875 59,5 17,25 62 16,625 65,125 17,125 6165725. 70,875 15,5 72,625 15,75 73,875 16,875 74,75 18,625 77,625 17,625 79,125 18,625 80,125 20,5 821825. 80,125 25,625 81,75 27,5 81,625 29,375 80,375 31,375 78,125 34 75,875 34,625 73,875 33,75 73,875 33,1875. 68,625 36,125 66,625 36,125 65,125 35,25 64,125 33,875 62,375 34,625 60,75 33,875 59,125 35 525812,5 27,375 59 25,875 м 31 17,875 б 27,75 14,875 27,75 12,625 29,375 10,875 31,5 9,375 34,125 8,8125 37,5 37,5 27,375 41,875 7,125 43 7,625 44,625 7,875 45,875 9 46,875 10,875 49,625 9,75 51,125 10,875 52,125 12,65325. 16,875 52,125 17,875 53,875 19,625 53,625 21,5 52,375 23,375 50,125 26,125 47,875 26,875 45,8725 24,875 43,375 28,625 40,625 28,25 