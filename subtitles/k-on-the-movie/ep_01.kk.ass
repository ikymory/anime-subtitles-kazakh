Dialogue: 0,1:20:25.37,1:20:27.98,Song-JP,,0000,0000,0000,,Лондон көпірі Темза өзені
Dialogue: 0,1:20:27.98,1:20:30.47,Song-JP,,0000,0000,0000,,london Tower London Eye
Dialogue: 0,1:20:30.46,1:20:35.06,Song-JP,,0000,0000,0000,,Лондон Лондон Ақыр соңында, окономияки және күріш
Dialogue: 0,1:20:35.06,1:20:38.07,Song-JP,,0000,0000,0000,,Мен өзім лондондықпын.
Dialogue: 0,1:20:38.07,1:20:39.68,Song-JP,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:20:43.07,1:20:45.67,Song-JP,,0000,0000,0000,,1 2 3 4 Күріш
Dialogue: 0,1:20:48.12,1:20:50.64,Song-JP,,0000,0000,0000,,1 2 3 4 Күріш
Dialogue: 0,1:20:53.10,1:20:55.71,Song-JP,,0000,0000,0000,,1 2 3 4 Күріш
Dialogue: 0,1:20:58.18,1:21:01.63,Song-JP,,0000,0000,0000,,1 2 3 4 Күріш
Dialogue: 0,1:21:08.74,1:21:09.92,Song-JP,,0000,0000,0000,,Биік аспан
Dialogue: 0,1:48:36.68,1:48:40.73,OP-JP,,0000,0000,0000,,Саған қарасам жүрегім DOKI DOKIi
Dialogue: 0,1:48:41.94,1:48:46.36,OP-JP,,0000,0000,0000,,Тербелген ойларым зефир сияқты үлпілдек
Dialogue: 0,1:48:46.36,1:48:51.68,OP-JP,,0000,0000,0000,,Тіке жүзің, Үнемі еңбектеніп
Dialogue: 0,1:48:51.68,1:48:56.97,OP-JP,,0000,0000,0000,,Қарап отырсаң да, байқамайсың.
Dialogue: 0,1:48:56.97,1:48:59.65,OP-JP,,0000,0000,0000,,Түсінде
Dialogue: 0,1:48:59.65,1:49:07.35,OP-JP,,0000,0000,0000,,Арамыздағы қашықтықты қысқартуға болады
Dialogue: 0,1:49:07.82,1:49:10.77,OP-JP,,0000,0000,0000,,Ах, Камисама, өтінемін.
Dialogue: 0,1:49:10.77,1:49:18.48,OP-JP,,0000,0000,0000,,Бізге тек екеумізге арналған Dream Time сыйлаңыз☆
Dialogue: 0,1:49:18.48,1:49:23.81,OP-JP,,0000,0000,0000,,Сүйікті қояныңызды ұстаңыз
Dialogue: 0,1:49:23.81,1:49:28.52,OP-JP,,0000,0000,0000,,Оясуми бүгін кешке де
Dialogue: 0,1:49:29.12,1:49:31.84,OP-JP,,0000,0000,0000,,Үлпілдек уақыт
Dialogue: 0,1:49:31.84,1:49:34.51,OP-JP,,0000,0000,0000,,Үлпілдек уақыт
Dialogue: 0,1:49:34.51,1:49:37.86,OP-JP,,0000,0000,0000,,Үлпілдек уақыт
Dialogue: 0,1:26:35.76,1:26:42.01,Song-JP,,0000,0000,0000,,Жаңбыр тамшылары Жаңбыр қандай әдемі жауып тұр
Dialogue: 0,1:26:42.01,1:26:48.42,Song-JP,,0000,0000,0000,,Газдалған су сияқты, қаланың есінеуін тоқтатады.
Dialogue: 0,1:26:48.42,1:26:54.64,Song-JP,,0000,0000,0000,,Үш дәнді санап, үлкенін маңдайыңмен ұста.
Dialogue: 0,1:26:55.00,1:27:00.20,Song-JP,,0000,0000,0000,,Жаңбыр менімен сөйлеседі
Dialogue: 0,1:27:56.84,1:28:01.42,Song-JP,,0000,0000,0000,,Мен сенсіз ештеңе істей алмаймын
Dialogue: 0,1:28:01.42,1:28:05.31,Song-JP,,0000,0000,0000,,Мен сенің тамағыңды жегім келеді.
Dialogue: 0,1:28:05.96,1:28:08.29,Song-JP,,0000,0000,0000,,Қайтып келсеңіз
Dialogue: 0,1:28:08.29,1:28:14.17,Song-JP,,0000,0000,0000,,Мен сені күлімдеп құшақтаймын
Dialogue: 0,1:28:14.53,1:28:19.33,Song-JP,,0000,0000,0000,,Мен сенсіз кешірім сұрай алмаймын
Dialogue: 0,1:28:19.33,1:28:23.45,Song-JP,,0000,0000,0000,,Даусыңды естігім келеді
Dialogue: 0,1:28:23.67,1:28:32.85,Song-JP,,0000,0000,0000,,Сіздің күлкіңізді көру жеткілікті
Dialogue: 0,1:28:32.85,1:28:42.29,Song-JP,,0000,0000,0000,,Сенің қасымда болғаның маған әрқашан батылдық берді
Dialogue: 0,1:28:42.29,1:28:46.84,Song-JP,,0000,0000,0000,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,1:28:46.84,1:28:51.13,Song-JP,,0000,0000,0000,,Мен осы сезімді жеткізгім келеді
Dialogue: 0,1:28:51.13,1:28:55.62,Song-JP,,0000,0000,0000,,Шуақты және жаңбырлы күндері
Dialogue: 0,1:28:55.62,1:29:00.53,Song-JP,,0000,0000,0000,,Сен менің жанымда болдың
Dialogue: 0,1:29:00.53,1:29:09.70,Song-JP,,0000,0000,0000,,Көзімді жұмсам күлкің жарқырайды
Dialogue: 0,1:29:32.30,1:29:41.54,Song-JP,,0000,0000,0000,,Жүрегіңізге жете ме? Мен қазір сенімді болмасам да
Dialogue: 0,1:29:41.70,1:29:46.27,Song-JP,,0000,0000,0000,,Күлме, тыңда.
Dialogue: 0,1:29:46.27,1:29:50.55,Song-JP,,0000,0000,0000,,Себебі мен өз сезімімді әнге салдым
Dialogue: 0,1:29:50.55,1:29:55.11,Song-JP,,0000,0000,0000,,«Рахмет» мүмкіндігінше
Dialogue: 0,1:29:55.11,1:29:59.99,Song-JP,,0000,0000,0000,,Оны өлеңмен жеткізгім келеді
Dialogue: 0,1:29:59.99,1:30:08.61,Song-JP,,0000,0000,0000,,Мен бұл сезімді ешқашан ұмытпаймын
Dialogue: 0,1:30:09.05,1:30:16.86,Song-JP,,0000,0000,0000,,Өз ойларыңызды жеткізіңіз
Dialogue: 0,0:01:23.84,0:01:24.58,JP,,0000,0000,0000,,Таң
Dialogue: 0,0:02:02.23,0:02:03.51,JP,,0000,0000,0000,,Ал, клуб бөлмесіне барайық.
Dialogue: 0,0:02:04.15,0:02:05.23,JP,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:02:05.23,0:02:06.01,JP,,0000,0000,0000,,Қош бол
Dialogue: 0,0:02:32.44,0:02:34.09,JP,,0000,0000,0000,,Аспан Сәлем
Dialogue: 0,0:02:37.43,0:02:38.28,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:02:40.15,0:02:42.75,JP,,0000,0000,0000,,Houkago Tea Time бағдарламасы қандай музыканы көздейді?
Dialogue: 0,0:02:43.94,0:02:45.54,JP,,0000,0000,0000,,Бұлай емес
Dialogue: 0,0:02:46.79,0:02:50.18,JP,,0000,0000,0000,,Бірақ мен осы жолмен жүргім келеді.
Dialogue: 0,0:02:50.94,0:02:52.15,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:52.76,0:02:56.03,JP,,0000,0000,0000,,Юидің әдетіне қарамастан, Юидің әдеті...
Dialogue: 0,0:02:56.03,0:02:57.99,JP,,0000,0000,0000,,Екеуің доғарыңдар.
Dialogue: 0,0:02:58.89,0:03:01.95,JP,,0000,0000,0000,,Мм... бірдеңе болды ма?
Dialogue: 0,0:03:04.30,0:03:07.46,JP,,0000,0000,0000,,Жеңіл музыка клубы қазірдің өзінде таратылуы мүмкін.
Dialogue: 0,0:03:07.78,0:03:10.26,JP,,0000,0000,0000,,Неліктен мұндай уақытта таратылды?
Dialogue: 0,0:03:10.61,0:03:13.70,JP,,0000,0000,0000,,Әр адамның мақсаты әртүрлі болды.
Dialogue: 0,0:03:14.45,0:03:17.15,JP,,0000,0000,0000,,Бұл музыкалық ерекшелігі, Азу-нян.
Dialogue: 0,0:03:17.51,0:03:19.28,JP,,0000,0000,0000,,Мұның несі музыкалық!
Dialogue: 0,0:03:19.28,0:03:23.60,JP,,0000,0000,0000,,Музыкалық – бір аккордты үйреніп, үшеуін ұмыту сияқты.
Dialogue: 0,0:03:23.60,0:03:26.67,JP,,0000,0000,0000,,Тіпті Мио Чан құлап, трусисын көрсетті.
Dialogue: 0,0:03:26.67,0:03:28.47,JP,,0000,0000,0000,,Эй, бұл маңызды емес.
Dialogue: 0,0:03:28.47,0:03:31.29,JP,,0000,0000,0000,,Мм, сіз музыкалық туралы айттыңыз...
Dialogue: 0,0:03:32.26,0:03:33.94,JP,,0000,0000,0000,,Азуса-чан туралы не ойлайсың?
Dialogue: 0,0:03:34.12,0:03:35.27,JP,,0000,0000,0000,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:03:35.27,0:03:39.73,JP,,0000,0000,0000,,Біз күткендей, мектептен кейін шай уақытында жарқын және жігерлі әндер тыңдаймыз...
Dialogue: 0,0:03:39.73,0:03:40.58,JP,,0000,0000,0000,,Шынымды айтсам...
Dialogue: 0,0:03:41.74,0:03:43.27,JP,,0000,0000,0000,,Ол әлдеқашан үлпілдек
Dialogue: 0,0:03:45.00,0:03:46.05,JP,,0000,0000,0000,,Бұл қиын, солай емес пе?
Dialogue: 0,0:03:46.05,0:03:47.39,JP,,0000,0000,0000,,Қай ауыз сөйлейді
Dialogue: 0,0:03:47.54,0:03:48.87,JP,,0000,0000,0000,,Сіз клубқа қосылдыңыз
Dialogue: 0,0:03:48.87,0:03:51.94,JP,,0000,0000,0000,,Маған: «Жеңіл музыка үйірмесі жеңіл музыка ойнайды, солай емес пе?» деп айтқан күні.
Dialogue: 0,0:03:51.94,0:03:53.73,JP,,0000,0000,0000,,Мен мені ұстап алды деп ойладым.
Dialogue: 0,0:03:53.73,0:03:54.26,JP,,0000,0000,0000,,Баба...
Dialogue: 0,0:03:54.26,0:03:58.37,JP,,0000,0000,0000,,«Жалқаулыққа қарсы емеспін?» деген Рикчан емес пе?
Dialogue: 0,0:03:58.37,0:04:00.15,JP,,0000,0000,0000,,Сол кемпірді кетіргіңіз келе ме?
Dialogue: 0,0:04:00.15,0:04:01.46,JP,,0000,0000,0000,,Бакайару Азуса
Dialogue: 0,0:04:01.86,0:04:05.21,JP,,0000,0000,0000,,Біз жеңіл музыка клубының өмір сүретіні немесе өлетіні туралы маңызды әңгіме жүргізіп жатырмыз.
Dialogue: 0,0:04:05.36,0:04:06.08,JP,,0000,0000,0000,,Азунян
Dialogue: 0,0:04:06.27,0:04:06.94,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:04:07.44,0:04:08.96,JP,,0000,0000,0000,,Кейінірек жасайық
Dialogue: 0,0:04:09.53,0:04:10.04,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:10.49,0:04:15.01,JP,,0000,0000,0000,,Үйірмеге қосылғаныма қуаныштымын, бірақ гитарада немесе гармоникада ойнай алмаймын.
Dialogue: 0,0:04:15.01,0:04:17.28,JP,,0000,0000,0000,,Гармонияда ойнауға болады.
Dialogue: 0,0:04:17.28,0:04:19.58,JP,,0000,0000,0000,,О, дұрыс, сосын үрлеп көріңіз.
Dialogue: 0,0:04:19.58,0:04:21.01,JP,,0000,0000,0000,,Кешіріңіз, мен ойнай алмаймын.
Dialogue: 0,0:04:21.27,0:04:22.80,JP,,0000,0000,0000,,Чанчара біртүрлі екен.
Dialogue: 0,0:04:23.79,0:04:24.67,JP,,0000,0000,0000,,Муги-чан
Dialogue: 0,0:04:24.74,0:04:25.68,JP,,0000,0000,0000,,Бидай
Dialogue: 0,0:04:27.57,0:04:29.40,JP,,0000,0000,0000,,Сондай-ақ... бастапқыда
Dialogue: 0,0:04:29.40,0:04:32.04,JP,,0000,0000,0000,,Муги-чан тәттілер әкеледі, сондықтан мен бара алмаймын.
Dialogue: 0,0:04:32.04,0:04:33.86,JP,,0000,0000,0000,,Сіз ең көп ішіп-жейсіз, солай ма?
Dialogue: 0,0:04:33.86,0:04:35.95,JP,,0000,0000,0000,,Бұл менің кінәм, өйткені мен саған дәмді нәрсе әкелдім.
Dialogue: 0,0:04:35.95,0:04:37.68,JP,,0000,0000,0000,,Бұл үшін кешіріңіз.
Dialogue: 0,0:04:37.90,0:04:38.90,JP,,0000,0000,0000,,Не болса да
Dialogue: 0,0:04:38.90,0:04:40.41,JP,,0000,0000,0000,,Мио-чан, бірдеңе айт.
Dialogue: 0,0:04:40.41,0:04:41.98,JP,,0000,0000,0000,,Е... бұл жаман заң.
Dialogue: 0,0:04:42.04,0:04:44.13,JP,,0000,0000,0000,,Дұрыс, дұрыс, бұл Риччан болса да.
Dialogue: 0,0:04:44.13,0:04:45.52,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:48.62,0:04:49.99,JP,,0000,0000,0000,,Бұл бұрынғы ән.
Dialogue: 0,0:05:03.51,0:05:04.98,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:05.77,0:05:06.75,JP,,0000,0000,0000,,Мен білдім
Dialogue: 0,0:05:07.43,0:05:08.99,JP,,0000,0000,0000,,Бұл өзін ӨЛІМ ШАЙТАН етіп көрсету.
Dialogue: 0,0:05:09.36,0:05:11.00,JP,,0000,0000,0000,,Бұл көңілді болды.
Dialogue: 0,0:05:11.99,0:05:15.20,JP,,0000,0000,0000,,Кәне, неге жаттығу сабақтарының арасында кішігірім ойындарды тоқтатпайсыз?
Dialogue: 0,0:05:15.45,0:05:17.64,JP,,0000,0000,0000,,Мио-чанның да көңіл-күйі жақсы болды.
Dialogue: 0,0:05:18.51,0:05:19.68,JP,,0000,0000,0000,,Бұл пьеса ма?
Dialogue: 0,0:05:19.85,0:05:22.08,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:22.25,0:05:26.26,JP,,0000,0000,0000,,Мен оны кем дегенде бір рет көргім келеді. Бұл музыкалық конфликт деп аталады.
Dialogue: 0,0:05:26.62,0:05:28.61,JP,,0000,0000,0000,,Бұл жолақтарға арналған стандарт.
Dialogue: 0,0:05:29.10,0:05:30.38,JP,,0000,0000,0000,,Эй
Dialogue: 0,0:05:29.21,0:05:31.47,JP,,0000,0000,0000,,Мен солай деп ойладым.
Dialogue: 0,0:05:32.11,0:05:34.30,JP,,0000,0000,0000,,Сонымен Азуса-чан да келді.
Dialogue: 0,0:05:34.30,0:05:35.60,JP,,0000,0000,0000,,А, күте тұрыңыз.
Dialogue: 0,0:05:38.37,0:05:39.60,JP,,0000,0000,0000,,Шай ішейік пе?
Dialogue: 0,0:05:39.80,0:05:41.41,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:26.84,0:07:28.93,JP,,0000,0000,0000,,Тексеру жиналысын ертерек өткіземіз бе?
Dialogue: 0,0:07:28.93,0:07:33.25,JP,,0000,0000,0000,,Мен Азунянды аздап толқытып аламын деп ойладым.
Dialogue: 0,0:07:33.79,0:07:36.15,JP,,0000,0000,0000,,Бұл тәжірибені қайталау сессиясы емес.
Dialogue: 0,0:07:36.57,0:07:39.21,JP,,0000,0000,0000,,Ах, Тон-чанға тамақ болды.
Dialogue: 0,0:07:40.85,0:07:42.19,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:07:42.43,0:07:44.36,JP,,0000,0000,0000,,Бәрі де жақсы болмады.
Dialogue: 0,0:07:44.79,0:07:47.66,JP,,0000,0000,0000,,Менің ойымша, Мугидің «чанчара таңқаларлық» сөзі де жарайды.
Dialogue: 0,0:07:48.60,0:07:49.28,JP,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:51.00,0:07:51.84,JP,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:07:51.84,0:07:53.09,JP,,0000,0000,0000,,Өзіңіз айтпаңыз
Dialogue: 0,0:07:53.78,0:07:58.49,JP,,0000,0000,0000,,Үйірмеге оның соншалықты шала клуб екенін білмей кірдім.
Dialogue: 0,0:07:58.62,0:08:00.53,JP,,0000,0000,0000,,О, сен ақымақсың.
Dialogue: 0,0:08:00.74,0:08:01.77,JP,,0000,0000,0000,,Шай
Dialogue: 0,0:08:02.50,0:08:06.20,JP,,0000,0000,0000,,Егер мен жеңіл музыка үйірмесіне қатыспасам, іше алмас едім.
Dialogue: 0,0:08:07.35,0:08:09.44,JP,,0000,0000,0000,,Котобуки отбасының мақтан тұтатын шайы.
Dialogue: 0,0:08:10.02,0:08:11.74,JP,,0000,0000,0000,,Кешіріңіз, бұл дәмді.
Dialogue: 0,0:08:11.84,0:08:14.26,JP,,0000,0000,0000,,А, бидай, бұл Баумкучен.
Dialogue: 0,0:08:14.54,0:08:16.59,JP,,0000,0000,0000,,Теріні бір-бірлеп аршып жеу.
Dialogue: 0,0:08:16.59,0:08:18.48,JP,,0000,0000,0000,,Тоқта, бірдеңе ауырған сияқты.
Dialogue: 0,0:08:18.48,0:08:20.25,JP,,0000,0000,0000,,Муги, тез аш!
Dialogue: 0,0:08:20.81,0:08:22.35,JP,,0000,0000,0000,,Бірақ бұл қиын...
Dialogue: 0,0:08:22.35,0:08:28.30,JP,,0000,0000,0000,,Мен осында үш жыл бойы тәтті жеп, шай ішіп, барлығымен жаттығып жүрмін.
Dialogue: 0,0:08:25.17,0:08:25.97,JP,,0000,0000,0000,,Мен сені ауыстырайын ба?
Dialogue: 0,0:08:26.57,0:08:27.44,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:30.87,0:08:33.35,JP,,0000,0000,0000,,Бар болғаны оқу бітіру.
Dialogue: 0,0:08:33.79,0:08:37.86,JP,,0000,0000,0000,,Бұл дұрыс, бірақ осылай босаңсуға бола ма?
Dialogue: 0,0:08:37.86,0:08:40.27,JP,,0000,0000,0000,,Себебі мен университетке қабылдандым.
Dialogue: 0,0:08:40.50,0:08:41.69,JP,,0000,0000,0000,,Неричан
Dialogue: 0,0:08:42.02,0:08:43.50,JP,,0000,0000,0000,,Бұл ғажайып, солай емес пе?
Dialogue: 0,0:08:43.72,0:08:46.23,JP,,0000,0000,0000,,Мио-сенпай мен Муги-чаннан басқа
Dialogue: 0,0:08:46.23,0:08:49.15,JP,,0000,0000,0000,,Тоқта, мына бала не деді?
Dialogue: 0,0:08:47.24,0:08:50.00,JP,,0000,0000,0000,,Мүгі-сенпай, менде қайшы бар.
Dialogue: 0,0:08:53.71,0:08:54.64,JP,,0000,0000,0000,,Юи Сенпай
Dialogue: 0,0:08:54.95,0:08:56.68,JP,,0000,0000,0000,,Айқай, сүйкімді емес пе?
Dialogue: 0,0:08:58.18,0:08:59.95,JP,,0000,0000,0000,,Аа, ол ашық.
Dialogue: 0,0:09:01.64,0:09:03.07,JP,,0000,0000,0000,,Тағы да
Dialogue: 0,0:09:03.66,0:09:06.51,JP,,0000,0000,0000,,Бәріміз бір университетке түскенімізге қуаныштымын.
Dialogue: 0,0:09:06.75,0:09:08.43,JP,,0000,0000,0000,,Ендеше тост айтайық.
Dialogue: 0,0:09:09.19,0:09:10.70,JP,,0000,0000,0000,,Қарашы, Азуньянмо
Dialogue: 0,0:09:10.70,0:09:12.71,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:09:14.44,0:09:15.99,JP,,0000,0000,0000,,Қанпай
Dialogue: 0,0:09:17.12,0:09:18.34,JP,,0000,0000,0000,,Қанпай
Dialogue: 0,0:09:20.13,0:09:20.89,JP,,0000,0000,0000,,Сава-чан
Dialogue: 0,0:09:23.07,0:09:25.33,JP,,0000,0000,0000,,Жарайды, мен де жеңілдеп қалдым.
Dialogue: 0,0:09:25.73,0:09:27.50,JP,,0000,0000,0000,,Барлығы емтиханды сәтті тапсырды.
Dialogue: 0,0:09:28.35,0:09:31.09,JP,,0000,0000,0000,,Үшінші сынып оқушылары үшін сынып жетекшісі болу қиын, солай емес пе?
Dialogue: 0,0:09:32.48,0:09:34.86,JP,,0000,0000,0000,,Бірақ бәрі тез өтті.
Dialogue: 0,0:09:35.15,0:09:37.41,JP,,0000,0000,0000,,Юй-чан және басқалары оқуын бітіріп қойған.
Dialogue: 0,0:09:38.15,0:09:42.00,JP,,0000,0000,0000,,Қызық, біз үш жылда қанша шай іштік?
Dialogue: 0,0:09:42.29,0:09:44.31,JP,,0000,0000,0000,,Мүмкін мың кесе.
Dialogue: 0,0:09:44.52,0:09:45.68,JP,,0000,0000,0000,,Мың
Dialogue: 0,0:09:45.81,0:09:47.60,JP,,0000,0000,0000,,Сабақтан кейін шай уақыты
Dialogue: 0,0:09:48.07,0:09:50.82,JP,,0000,0000,0000,,Топ атауын көрсету үшін денеңізді сызыққа қоясыз.
Dialogue: 0,0:09:51.68,0:09:55.28,JP,,0000,0000,0000,,Әйтеуір, енді оны жөнелтуіміз керек.
Dialogue: 0,0:09:55.56,0:09:56.96,JP,,0000,0000,0000,,Егер сіз бағаны қайталамасаңыз
Dialogue: 0,0:09:57.34,0:09:58.23,JP,,0000,0000,0000,,Бағаны қайталау
Dialogue: 0,0:10:02.32,0:10:03.81,JP,,0000,0000,0000,,Менің келесі аптада кездесуім бар.
Dialogue: 0,0:10:04.93,0:10:09.93,JP,,0000,0000,0000,,Біз сіздің жеткілікті күндер барғаныңызды және тым көп қызыл баға алғаныңызды тексереміз.
Dialogue: 0,0:10:10.06,0:10:11.90,JP,,0000,0000,0000,,Өте маңызды кездесу!
Dialogue: 0,0:10:16.39,0:10:20.91,JP,,0000,0000,0000,,Сасаса...Сава-чан, біз бұрын ӨЛІМ ШАЙТАНҒА еліктеуші едік.
Dialogue: 0,0:10:20.91,0:10:22.51,JP,,0000,0000,0000,,ӨЛІМ ШАЙТАН ең жақсы
Dialogue: 0,0:10:22.51,0:10:24.69,JP,,0000,0000,0000,,Сава-чан тобынан күткендей
Dialogue: 0,0:10:24.69,0:10:25.75,JP,,0000,0000,0000,,Сонымен
Dialogue: 0,0:10:25.75,0:10:27.12,JP,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:10:27.96,0:10:31.31,JP,,0000,0000,0000,,Ке Кэ Ке Жеңіл музыка клубының аға мүшесі ретінде бұл бір орын.
Dialogue: 0,0:10:31.31,0:10:32.67,JP,,0000,0000,0000,,Түнгі шық өлім азабы
Dialogue: 0,0:10:32.67,0:10:34.00,JP,,0000,0000,0000,,Мен жаңа ғана канжи дедім.
Dialogue: 0,0:10:34.00,0:10:35.67,JP,,0000,0000,0000,,Мен қазір бас тартқым келмейді.
Dialogue: 0,0:10:35.67,0:10:36.66,JP,,0000,0000,0000,,Бұл туралы бірдеңе
Dialogue: 0,0:10:36.66,0:10:38.97,JP,,0000,0000,0000,,Профессор Савако Яманака
Dialogue: 0,0:10:52.61,0:10:53.41,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:10:55.49,0:10:57.17,JP,,0000,0000,0000,,Сава-чанның бұрынғы әңгімесі
Dialogue: 0,0:10:57.37,0:10:58.71,JP,,0000,0000,0000,,емес
Dialogue: 0,0:11:02.28,0:11:04.21,JP,,0000,0000,0000,,Бұл, әрине, менің ағам...
Dialogue: 0,0:11:09.88,0:11:14.96,JP,,0000,0000,0000,,Бәлкім, біз үлкендер ретінде лайықты абыройсыз оқуды бітірерміз.
Dialogue: 0,0:11:14.96,0:11:16.18,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:16.59,0:11:18.05,JP,,0000,0000,0000,,Бұл болмайды.
Dialogue: 0,0:11:18.05,0:11:19.42,JP,,0000,0000,0000,,Біз...
Dialogue: 0,0:11:19.42,0:11:20.52,JP,,0000,0000,0000,,Биік
Dialogue: 0,0:11:20.52,0:11:21.57,JP,,0000,0000,0000,,Үлкенірек
Dialogue: 0,0:11:21.57,0:11:22.34,JP,,0000,0000,0000,,Генки
Dialogue: 0,0:11:23.17,0:11:24.34,JP,,0000,0000,0000,,Басқалары бар ма?
Dialogue: 0,0:11:24.53,0:11:29.36,JP,,0000,0000,0000,,Мен соңында аға сияқты бірдеңе жасағым келеді.
Dialogue: 0,0:11:32.89,0:11:34.71,JP,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:11:34.89,0:11:36.64,JP,,0000,0000,0000,,Керемет.
Dialogue: 0,0:11:38.02,0:11:39.73,JP,,0000,0000,0000,,Сіз не істейсіз? Сіз не істейсіз?
Dialogue: 0,0:11:39.96,0:11:42.09,JP,,0000,0000,0000,,Мүмкін сыйлық жақсы болар.
Dialogue: 0,0:11:42.24,0:11:44.48,JP,,0000,0000,0000,,Маған Азунянға ұқсайтын нәрсе ұнайды.
Dialogue: 0,0:11:47.25,0:11:48.01,JP,,0000,0000,0000,,Ах, міне ол.
Dialogue: 0,0:11:48.45,0:11:50.26,JP,,0000,0000,0000,,Бұл қызықты.
Dialogue: 0,0:11:50.42,0:11:52.04,JP,,0000,0000,0000,,Мен мұны құпия ұстауым керек.
Dialogue: 0,0:11:52.04,0:11:52.93,JP,,0000,0000,0000,,Аға
Dialogue: 0,0:11:53.70,0:11:54.96,JP,,0000,0000,0000,,А Азунян
Dialogue: 0,0:11:55.08,0:11:58.35,JP,,0000,0000,0000,,Мен қоқыс төгіп жатырмын.
Dialogue: 0,0:11:58.37,0:12:01.66,JP,,0000,0000,0000,,Мен клуб бөлмесіне қалай оралу керектігін білмеймін деп ойладым.
Dialogue: 0,0:12:02.44,0:12:03.84,JP,,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:12:03.91,0:12:06.67,JP,,0000,0000,0000,,А, мен енді клуб бөлмесіне қайта алмаймын.
Dialogue: 0,0:12:06.80,0:12:08.30,JP,,0000,0000,0000,,Бұл мүлде мүмкін емес
Dialogue: 0,0:12:08.53,0:12:09.53,JP,,0000,0000,0000,,Кеттік
Dialogue: 0,0:12:20.24,0:12:22.38,JP,,0000,0000,0000,,Азуса-чан қуанатын нәрселер
Dialogue: 0,0:12:22.49,0:12:26.35,JP,,0000,0000,0000,,Иә, бұл бір нәрсе немесе бір нәрсе болуы мүмкін.
Dialogue: 0,0:12:27.29,0:12:29.35,JP,,0000,0000,0000,,Хмм, дұрыс.
Dialogue: 0,0:12:30.49,0:12:34.07,JP,,0000,0000,0000,,Мен Юуға және басқаларға ештеңе айтқан жоқпын, біз бір сыныпта оқимыз.
Dialogue: 0,0:12:34.37,0:12:37.94,JP,,0000,0000,0000,,«Менің үлкендерім сондай керемет» деген сияқты.
Dialogue: 0,0:12:38.14,0:12:39.45,JP,,0000,0000,0000,,Э-э-э—
Dialogue: 0,0:12:39.69,0:12:41.80,JP,,0000,0000,0000,,Иә, айта беріңіз.
Dialogue: 0,0:12:42.72,0:12:47.09,JP,,0000,0000,0000,,«Мүмкін мен біршама байыпты жаттығуым керек шығар».
Dialogue: 0,0:12:47.53,0:12:51.81,JP,,0000,0000,0000,,«Клуб бөлмесін сәл жинап алсаңыз екен.»
Dialogue: 0,0:12:52.22,0:12:55.69,JP,,0000,0000,0000,,«Мені сонша құшақтап алғаныңды ұнатпаймын».
Dialogue: 0,0:12:56.00,0:12:57.50,JP,,0000,0000,0000,,Әй, әпке!
Dialogue: 0,0:12:58.12,0:13:00.35,JP,,0000,0000,0000,,Бұл әдеттегі стандарт.
Dialogue: 0,0:13:04.15,0:13:08.37,JP,,0000,0000,0000,,Азунян, ол жеңіл музыкалық үйірмеде ұзақ болатын.
Dialogue: 0,0:13:08.46,0:13:09.23,JP,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:13:09.97,0:13:14.00,JP,,0000,0000,0000,,Азуса-чан үнемі жеңіл музыка клубы туралы айтады.
Dialogue: 0,0:13:14.35,0:13:15.35,JP,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:13:15.43,0:13:16.52,JP,,0000,0000,0000,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:13:18.51,0:13:21.86,JP,,0000,0000,0000,,Сонымен қатар, Азуса-чан жеңіл музыка үйірмесіне қосылды.
Dialogue: 0,0:13:22.16,0:13:24.59,JP,,0000,0000,0000,,Өйткені мен әпкелерімнің ойнағанын естідім.
Dialogue: 0,0:13:25.93,0:13:27.89,JP,,0000,0000,0000,,Сіз осылай айттыңыз.
Dialogue: 0,0:13:30.26,0:13:34.54,JP,,0000,0000,0000,,Аа, апалар бірге бітірер ме екен.
Dialogue: 0,0:13:34.74,0:13:35.39,JP,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:13:38.10,0:13:38.64,JP,,0000,0000,0000,,Иә...
Dialogue: 0,0:13:38.96,0:13:41.73,JP,,0000,0000,0000,,Әпке, сіз қалжыңдап тұрсыз.
Dialogue: 0,0:13:58.04,0:13:59.06,JP,,0000,0000,0000,,Азунян...
Dialogue: 0,0:14:02.32,0:14:04.40,JP,,0000,0000,0000,,Сізге не керек?
Dialogue: 0,0:14:20.04,0:14:21.18,JP,,0000,0000,0000,,Юй-чан
Dialogue: 0,0:14:22.26,0:14:24.78,JP,,0000,0000,0000,,О, Муги-чан, қайырлы таң.
Dialogue: 0,0:14:26.14,0:14:28.02,JP,,0000,0000,0000,,Ах, Гита-чанның ізі бар.
Dialogue: 0,0:14:28.29,0:14:29.89,JP,,0000,0000,0000,,Біз бірге жаттық
Dialogue: 0,0:14:31.14,0:14:32.39,JP,,0000,0000,0000,,Самусаму
Dialogue: 0,0:14:33.54,0:14:35.49,JP,,0000,0000,0000,,Муги-чан маған тиіссін
Dialogue: 0,0:14:35.49,0:14:36.21,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:14:36.79,0:14:37.86,JP,,0000,0000,0000,,Құқық құқығы
Dialogue: 0,0:14:37.86,0:14:38.62,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:38.62,0:14:41.46,JP,,0000,0000,0000,,Кеше түнде ұйықтар алдында мен жаңа өлең жолдарын жаздым.
Dialogue: 0,0:14:41.46,0:14:44.76,JP,,0000,0000,0000,,О, «Балмұздақ жігіт» жаңа әні
Dialogue: 0,0:14:45.24,0:14:47.27,JP,,0000,0000,0000,,Ән шығаруды Мугиге тапсырайық.
Dialogue: 0,0:14:47.86,0:14:49.38,JP,,0000,0000,0000,,Рикчан Миочан
Dialogue: 0,0:14:50.39,0:14:51.48,JP,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:14:51.53,0:14:52.58,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:14:53.09,0:14:55.98,JP,,0000,0000,0000,,Муги-чанның қолдары жылы, тер
Dialogue: 0,0:14:56.16,0:14:59.35,JP,,0000,0000,0000,,Акияма мырзаның қолдары тоңып, тоңып қалды.
Dialogue: 0,0:14:59.64,0:15:00.67,JP,,0000,0000,0000,,Мен есімде сақтамасам да,
Dialogue: 0,0:15:01.69,0:15:03.92,JP,,0000,0000,0000,,Мен Азунянға сыйлық ойладым.
Dialogue: 0,0:15:04.09,0:15:04.87,JP,,0000,0000,0000,,Юиха
Dialogue: 0,0:15:05.07,0:15:07.27,JP,,0000,0000,0000,,Осыны ойлап ұйықтап қалдым.
Dialogue: 0,0:15:07.27,0:15:09.91,JP,,0000,0000,0000,,Мен де шұлықтарымды қалдырдым.
Dialogue: 0,0:15:09.91,0:15:11.43,JP,,0000,0000,0000,,Киімімді шешіп, ұйықтаймын
Dialogue: 0,0:15:11.49,0:15:12.53,JP,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:15:12.53,0:15:14.54,JP,,0000,0000,0000,,Мио-чан жуан
Dialogue: 0,0:15:14.54,0:15:15.98,JP,,0000,0000,0000,,Бұл шұлық туралы.
Dialogue: 0,0:15:16.45,0:15:19.77,JP,,0000,0000,0000,,Ертерек тапсырған дұрыс.
Dialogue: 0,0:15:17.79,0:15:19.45,JP,,0000,0000,0000,,Қайырлы таң, ерте келдің.
Dialogue: 0,0:15:19.90,0:15:22.61,JP,,0000,0000,0000,,Бұл мектептің бірінші күні, сондықтан мен барлығын көре алмаймын.
Dialogue: 0,0:15:23.73,0:15:25.02,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:15:25.28,0:15:26.67,JP,,0000,0000,0000,,Қайырлы таң Каззу-чан
Dialogue: 0,0:15:26.67,0:15:27.57,JP,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:15:28.43,0:15:30.69,JP,,0000,0000,0000,,Онда сіз ертең өтініш бере аласыз.
Dialogue: 0,0:15:30.69,0:15:32.54,JP,,0000,0000,0000,,Одан кейін купальник сатып алайық.
Dialogue: 0,0:15:32.91,0:15:35.16,JP,,0000,0000,0000,,Бұл менің Гавайиде бірінші рет болуым.
Dialogue: 0,0:15:35.67,0:15:37.88,JP,,0000,0000,0000,,Тіпті Гавайиде Муги-чан
Dialogue: 0,0:15:38.15,0:15:38.74,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:15:39.38,0:15:41.52,JP,,0000,0000,0000,,Эй, мен Гавайиге барамын.
Dialogue: 0,0:15:41.76,0:15:43.67,JP,,0000,0000,0000,,Иә, бұл мектеп бітірушілерге саяхат.
Dialogue: 0,0:15:44.13,0:15:46.52,JP,,0000,0000,0000,,Жарық бөлімі ешқайда кетпейді.
Dialogue: 0,0:15:48.62,0:15:49.61,JP,,0000,0000,0000,,Мм... Риччан
Dialogue: 0,0:15:49.65,0:15:50.78,JP,,0000,0000,0000,,Нанджарахой
Dialogue: 0,0:15:50.78,0:15:51.89,JP,,0000,0000,0000,,Нұсқаулық...
Dialogue: 0,0:15:52.08,0:15:54.67,JP,,0000,0000,0000,,Волейбол үйірмесінің бітірушілерге саяхаты.
Dialogue: 0,0:15:54.88,0:15:55.91,JP,,0000,0000,0000,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:15:55.91,0:15:57.52,JP,,0000,0000,0000,,Біз де барайық
Dialogue: 0,0:15:58.04,0:15:59.25,JP,,0000,0000,0000,,Қашан барасыз?
Dialogue: 0,0:15:59.97,0:16:01.77,JP,,0000,0000,0000,,Мектеп бітіру рәсіміне бір апта қалғанда
Dialogue: 0,0:16:01.97,0:16:03.53,JP,,0000,0000,0000,,Бұл арзанырақ.
Dialogue: 0,0:16:03.84,0:16:05.15,JP,,0000,0000,0000,,Датте Риччан
Dialogue: 0,0:16:05.29,0:16:07.14,JP,,0000,0000,0000,,Көктемгі каникулдың алдында болғандықтан ба?
Dialogue: 0,0:16:07.44,0:16:09.41,JP,,0000,0000,0000,,Біз...
Dialogue: 0,0:16:09.62,0:16:14.31,JP,,0000,0000,0000,,Хмф... дермех, сырты - сырты, іші - іші.
Dialogue: 0,0:16:14.40,0:16:16.15,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:16.99,0:16:21.41,JP,,0000,0000,0000,,Оның орнына, сіз Азуса үшін не істей алатыныңызды ойлауыңыз керек.
Dialogue: 0,0:16:21.41,0:16:22.84,JP,,0000,0000,0000,,Барлығы сәл жақсы
Dialogue: 0,0:16:23.07,0:16:27.35,JP,,0000,0000,0000,,Бүкіл сынып бітіру күні Савако-сенсейге бірдеңе жасағысы келеді.
Dialogue: 0,0:16:27.68,0:16:28.75,JP,,0000,0000,0000,,Сіздің ойыңызша не жақсы?
Dialogue: 0,0:16:28.89,0:16:30.84,JP,,0000,0000,0000,,А, мен бұл туралы мұғалімге айтқан жоқпын.
Dialogue: 0,0:16:30.84,0:16:32.01,JP,,0000,0000,0000,,Әй, сен не қалайсың?
Dialogue: 0,0:16:32.01,0:16:33.38,JP,,0000,0000,0000,,Бұл мені жылатады
Dialogue: 0,0:16:34.15,0:16:35.53,JP,,0000,0000,0000,,Мектеп әнін айту
Dialogue: 0,0:16:35.54,0:16:36.65,JP,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:37.70,0:16:40.00,JP,,0000,0000,0000,,Савако-сенсейдің сізге не ұнайды?
Dialogue: 0,0:16:40.00,0:16:41.23,JP,,0000,0000,0000,,Ғай...
Dialogue: 0,0:16:41.54,0:16:43.13,JP,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:16:43.13,0:16:45.93,JP,,0000,0000,0000,,Мен дипломдық сапарға баруды ойлап жүрмін.
Dialogue: 0,0:16:45.93,0:16:47.86,JP,,0000,0000,0000,,А... басталды.
Dialogue: 0,0:16:47.86,0:16:51.60,JP,,0000,0000,0000,,Ойланып қарасаңыз, бәріміз бірге төлқұжат алдық.
Dialogue: 0,0:16:51.80,0:16:54.97,JP,,0000,0000,0000,,Алдымен Азусаның сыйлығын ойлау керек емес пе?
Dialogue: 0,0:16:55.32,0:16:58.65,JP,,0000,0000,0000,,Иә, мен де бұл туралы ойлаймын.
Dialogue: 0,0:16:58.65,0:16:59.79,JP,,0000,0000,0000,,Ханым
Dialogue: 0,0:17:00.25,0:17:03.40,JP,,0000,0000,0000,,Осылайша сіз бәрін бірден артқы жағына қоясыз.
Dialogue: 0,0:17:03.84,0:17:05.97,JP,,0000,0000,0000,,Бұл аздап жақсы.
Dialogue: 0,0:17:06.45,0:17:09.13,JP,,0000,0000,0000,,Мен Уиден сұхбат алдым.
Dialogue: 0,0:17:09.79,0:17:11.41,JP,,0000,0000,0000,,Мен сұрасам болады ма?
Dialogue: 0,0:17:11.63,0:17:13.71,JP,,0000,0000,0000,,Иә, мен қайғырамын.
Dialogue: 0,0:17:14.09,0:17:15.82,JP,,0000,0000,0000,,Бір минут күте тұрыңыз, бұл не?
Dialogue: 0,0:17:16.07,0:17:17.87,JP,,0000,0000,0000,,«Чоджугига»
Dialogue: 0,0:17:18.02,0:17:20.05,JP,,0000,0000,0000,,Білесіз бе, мен өткен күні оқулығымды қарап отыр едім...
Dialogue: 0,0:17:20.05,0:17:21.81,JP,,0000,0000,0000,,Сонымен Ю-чан дегеніміз не?
Dialogue: 0,0:17:21.99,0:17:26.65,JP,,0000,0000,0000,,Әй, мектеп табалдырығын аттағанымызға тағы бір жыл болды.
Dialogue: 0,0:17:27.12,0:17:30.50,JP,,0000,0000,0000,,Мен Азунянмен бірге бітірсем жақсы болар еді деп ойладым.
Dialogue: 0,0:17:30.95,0:17:33.02,JP,,0000,0000,0000,,Сыйлықтар қайталанады
Dialogue: 0,0:17:33.51,0:17:35.94,JP,,0000,0000,0000,,Иә, бағаны қайталау
Dialogue: 0,0:17:39.67,0:17:40.83,JP,,0000,0000,0000,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:17:41.22,0:17:42.05,JP,,0000,0000,0000,,Бөлек
Dialogue: 0,0:17:42.19,0:17:43.98,JP,,0000,0000,0000,,Сіз асығып тұрғаныңыз анық.
Dialogue: 0,0:17:43.98,0:17:44.91,JP,,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,0:17:45.14,0:17:47.75,JP,,0000,0000,0000,,Оның үстіне мен қазір «бағаны қайталау» деп айтқан жоқпын.
Dialogue: 0,0:17:47.88,0:17:50.44,JP,,0000,0000,0000,,Біз үшін де көп нәрсе бар, солай ма?
Dialogue: 0,0:17:50.44,0:17:52.47,JP,,0000,0000,0000,,Мұны қайдан естідің, Азуса-чан?
Dialogue: 0,0:17:52.71,0:17:54.99,JP,,0000,0000,0000,,Мен тыңдадым, дәлірек айтсам, естідім.
Dialogue: 0,0:17:54.99,0:17:58.96,JP,,0000,0000,0000,,Сорамими, мүмкін Сорамими Сорамими
Dialogue: 0,0:17:58.96,0:18:00.36,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:00.36,0:18:03.97,JP,,0000,0000,0000,,Білесіз бе, біз дипломдық сапарға қайда бару керектігін талқыладық.
Dialogue: 0,0:18:04.38,0:18:07.50,JP,,0000,0000,0000,,Германия Федеративтік Республикасында «Лунен» деген қала бар.
Dialogue: 0,0:18:07.50,0:18:09.73,JP,,0000,0000,0000,,Мұндай қорқынышты қала қандай?
Dialogue: 0,0:18:09.73,0:18:10.88,JP,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:18:11.18,0:18:13.55,JP,,0000,0000,0000,,Әй, бұл мектеп бітірушілер сапары ма?
Dialogue: 0,0:18:20.72,0:18:21.54,JP,,0000,0000,0000,,Дубай
Dialogue: 0,0:18:22.57,0:18:24.77,JP,,0000,0000,0000,,Гавайиге барғыңыз келмейді ме?
Dialogue: 0,0:18:25.04,0:18:25.81,JP,,0000,0000,0000,,Дубай
Dialogue: 0,0:18:26.31,0:18:27.58,JP,,0000,0000,0000,,Еуропа
Dialogue: 0,0:18:27.96,0:18:30.46,JP,,0000,0000,0000,,Ыстық көктем Мен үстел теннисін ойнағым келеді
Dialogue: 0,0:18:31.12,0:18:32.14,JP,,0000,0000,0000,,Мио-чан
Dialogue: 0,0:18:32.55,0:18:33.42,JP,,0000,0000,0000,,Мен
Dialogue: 0,0:18:36.01,0:18:37.39,JP,,0000,0000,0000,,Хмм... Лондон, меніңше.
Dialogue: 0,0:18:37.75,0:18:40.05,JP,,0000,0000,0000,,Әртүрлі музыканттардың туған қаласы.
Dialogue: 0,0:18:40.43,0:18:41.95,JP,,0000,0000,0000,,Музыка тарихы да бар.
Dialogue: 0,0:18:42.20,0:18:43.64,JP,,0000,0000,0000,,Мұның бәрі бөлек.
Dialogue: 0,0:18:43.64,0:18:44.74,JP,,0000,0000,0000,,Азунянха
Dialogue: 0,0:18:45.20,0:18:48.55,JP,,0000,0000,0000,,Мен әлі бітірген жоқпын, сондықтан еш жерде
Dialogue: 0,0:18:53.87,0:18:57.00,JP,,0000,0000,0000,,Сіз дипломдық сапарға қашан баруды шештіңіз?
Dialogue: 0,0:18:57.27,0:18:58.70,JP,,0000,0000,0000,,Ол жерде ағып жатыр.
Dialogue: 0,0:18:59.44,0:19:01.42,JP,,0000,0000,0000,,Ақыл-есіңді сақта.
Dialogue: 0,0:19:01.49,0:19:03.17,JP,,0000,0000,0000,,Мио-чан, мен барғым келмейді.
Dialogue: 0,0:19:03.49,0:19:05.67,JP,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:19:06.10,0:19:09.88,JP,,0000,0000,0000,,Сонда кім дипломдық сапарға барғысы келмейді?
Dialogue: 0,0:19:10.36,0:19:11.46,JP,,0000,0000,0000,,(Жолаушы) Сен таңқаларлықтай кішкентай екенсің ғой? (Изуку) Ә… иә…
Dialogue: 0,0:19:11.74,0:19:12.81,JP,,0000,0000,0000,,Тон-чан
Dialogue: 0,0:19:13.00,0:19:14.07,JP,,0000,0000,0000,,Шешілді.
Dialogue: 0,0:19:14.07,0:19:15.57,JP,,0000,0000,0000,,Керемет шешім
Dialogue: 0,0:19:15.94,0:19:19.08,JP,,0000,0000,0000,,Олай болса, Amida лотереясын пайдаланып қайда бару керектігін шешейік.
Dialogue: 0,0:19:19.08,0:19:22.70,JP,,0000,0000,0000,,Мен осындай болсам да, Амидакуджиге жақсы адаммын.
Dialogue: 0,0:19:22.70,0:19:24.30,JP,,0000,0000,0000,,Оның қай түрі?
Dialogue: 0,0:19:25.78,0:19:27.45,JP,,0000,0000,0000,,Дайын, хехе
Dialogue: 0,0:19:27.64,0:19:30.80,JP,,0000,0000,0000,,Енді, директор Рицу Тайнака, өтінемін.
Dialogue: 0,0:19:30.80,0:19:34.38,JP,,0000,0000,0000,,Ал, мен, онда бұл.
Dialogue: 0,0:19:34.38,0:19:37.73,JP,,0000,0000,0000,,Иә, иә, енді қайда боламыз?
Dialogue: 0,0:19:53.07,0:19:55.90,JP,,0000,0000,0000,,Бұл шешілді, Еуропа.
Dialogue: 0,0:19:57.90,0:19:59.61,JP,,0000,0000,0000,,Юй-чан, саған жақсы.
Dialogue: 0,0:20:00.47,0:20:03.12,JP,,0000,0000,0000,,Еуропаның қай жеріне барасыз?
Dialogue: 0,0:20:03.12,0:20:04.50,JP,,0000,0000,0000,,Юиден сұраңыз
Dialogue: 0,0:20:04.50,0:20:05.28,JP,,0000,0000,0000,,Юи Сенпай
Dialogue: 0,0:20:05.70,0:20:06.27,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:06.27,0:20:08.94,JP,,0000,0000,0000,,Маған сол қағазды көрсете аласыз ба?
Dialogue: 0,0:20:09.30,0:20:11.40,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:11.40,0:20:13.18,JP,,0000,0000,0000,,Жоқ, әйтеуір
Dialogue: 0,0:20:18.06,0:20:18.78,JP,,0000,0000,0000,,қашып кетті
Dialogue: 0,0:20:24.28,0:20:25.26,JP,,0000,0000,0000,,құлады
Dialogue: 0,0:20:25.87,0:20:26.35,JP,,0000,0000,0000,,Юи
Dialogue: 0,0:20:26.35,0:20:27.28,JP,,0000,0000,0000,,Юй-чан
Dialogue: 0,0:20:27.95,0:20:30.00,JP,,0000,0000,0000,,Тек... тек
Dialogue: 0,0:20:32.29,0:20:33.80,JP,,0000,0000,0000,,Тек...
Dialogue: 0,0:20:34.53,0:20:36.75,JP,,0000,0000,0000,,Ух... Риччан
Dialogue: 0,0:20:37.64,0:20:38.47,JP,,0000,0000,0000,,Юи
Dialogue: 0,0:20:38.84,0:20:41.66,JP,,0000,0000,0000,,Мен мұны жасадым.
Dialogue: 0,0:20:41.82,0:20:43.94,JP,,0000,0000,0000,,Хин... имбирь...
Dialogue: 0,0:20:44.42,0:20:46.59,JP,,0000,0000,0000,,Ақыры, ақыры, Юи
Dialogue: 0,0:20:49.85,0:20:52.86,JP,,0000,0000,0000,,Әй, бұл келіссөздер ғой.
Dialogue: 0,0:20:52.86,0:20:53.87,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:20:54.07,0:20:55.06,JP,,0000,0000,0000,,Сақтау
Dialogue: 0,0:20:55.28,0:20:57.83,JP,,0000,0000,0000,,Мен ағаларымның барлығын көріп тұрмын.
Dialogue: 0,0:20:58.21,0:20:59.88,JP,,0000,0000,0000,,Сіз алдадыңыз ба?
Dialogue: 0,0:20:59.88,0:21:01.97,JP,,0000,0000,0000,,Уау, бұл керемет, Юй Чан.
Dialogue: 0,0:21:03.68,0:21:04.58,JP,,0000,0000,0000,,Ұялмаңыз
Dialogue: 0,0:21:04.88,0:21:07.56,JP,,0000,0000,0000,,Мен кішкене қателік жібердім.
Dialogue: 0,0:21:11.43,0:21:13.30,JP,,0000,0000,0000,,Біраз уақыт осылай қаларсың деп үміттенемін.
Dialogue: 0,0:21:13.58,0:21:14.26,JP,,0000,0000,0000,,Юи
Dialogue: 0,0:21:18.43,0:21:20.63,JP,,0000,0000,0000,,Олай болса дұрыс шешім қабылдау керек.
Dialogue: 0,0:21:21.27,0:21:24.17,JP,,0000,0000,0000,,Әркім әрқалай барғысы келеді.
Dialogue: 0,0:21:24.93,0:21:26.06,JP,,0000,0000,0000,,Көпшіліктің шешімі т.б.
Dialogue: 0,0:21:26.52,0:21:27.32,JP,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:21:28.07,0:21:30.32,JP,,0000,0000,0000,,Тон-чанға шешім қабылдауға қалай болады?
Dialogue: 0,0:21:32.78,0:21:34.08,JP,,0000,0000,0000,,О, сондай табанды
Dialogue: 0,0:21:35.81,0:21:38.14,JP,,0000,0000,0000,,Тон-чан қай шыныаяқты таңдайды?
Dialogue: 0,0:21:39.02,0:21:41.30,JP,,0000,0000,0000,,Ойын-сауық саябағы сияқты сүйкімді.
Dialogue: 0,0:21:41.82,0:21:43.00,JP,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:21:43.38,0:21:43.95,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:21:44.12,0:21:47.64,JP,,0000,0000,0000,,Неге екені белгісіз, Еуропа кішкентай сияқты.
Dialogue: 0,0:21:47.75,0:21:49.76,JP,,0000,0000,0000,,Алдаған балаға берілетін жаза
Dialogue: 0,0:21:49.87,0:21:51.01,JP,,0000,0000,0000,,Бұл үлкен бе?
Dialogue: 0,0:21:55.15,0:21:58.94,JP,,0000,0000,0000,,Тон-чанға мұндай маңызды рөл берілгеніне сене алмаймын.
Dialogue: 0,0:21:59.90,0:22:03.72,JP,,0000,0000,0000,,Бүгін Тон-чанды бірдеңе іздеп жатыр.
Dialogue: 0,0:22:03.97,0:22:06.40,JP,,0000,0000,0000,,Сіз шайға тым қызықсыз.
Dialogue: 0,0:22:11.93,0:22:13.75,JP,,0000,0000,0000,,Ауа райы жақсы.
Dialogue: 0,0:22:14.41,0:22:16.64,JP,,0000,0000,0000,,Ха, бәрі зерікті.
Dialogue: 0,0:22:18.73,0:22:23.44,JP,,0000,0000,0000,,Уау, Тотото... Тон-чан, Еуропаның алдында.
Dialogue: 0,0:22:23.96,0:22:26.41,JP,,0000,0000,0000,,О, бірақ бұл Лондонға әсер етеді.
Dialogue: 0,0:22:26.47,0:22:27.32,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:28.02,0:22:30.46,JP,,0000,0000,0000,,Бұл Лондон ба?
Dialogue: 0,0:22:30.46,0:22:31.00,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:22:33.58,0:22:36.24,JP,,0000,0000,0000,,Лондон да Еуропада, сондықтан жақсы емес пе?
Dialogue: 0,0:22:36.37,0:22:39.98,JP,,0000,0000,0000,,Дұрыс, Еуропа Еуропаның қанша бөлігін құрайды?
Dialogue: 0,0:22:40.98,0:22:43.95,JP,,0000,0000,0000,,Мен аға курсқа баратын университетті аяй бастадым.
Dialogue: 0,0:22:44.53,0:22:47.22,JP,,0000,0000,0000,,Мио, бұл Лондон.
Dialogue: 0,0:22:47.48,0:22:49.47,JP,,0000,0000,0000,,Саған жақсы, Мио Чан
Dialogue: 0,0:22:49.87,0:22:52.69,JP,,0000,0000,0000,,Иә!
Dialogue: 0,0:22:52.69,0:22:53.76,JP,,0000,0000,0000,,Мио Мио-чан
Dialogue: 0,0:22:54.06,0:22:57.41,JP,,0000,0000,0000,,Ия... Лондон... Ия!
Dialogue: 0,0:22:57.89,0:23:00.03,JP,,0000,0000,0000,,Түсіндім, сабыр етіңіз.
Dialogue: 0,0:23:00.03,0:23:03.40,JP,,0000,0000,0000,,Ха-лол лол... Дон Дон
Dialogue: 0,0:23:04.71,0:23:07.72,JP,,0000,0000,0000,,Сен барғың келді, Мио-чан.
Dialogue: 0,0:23:08.86,0:23:10.72,JP,,0000,0000,0000,,Түстен кейін шай ішуге болады.
Dialogue: 0,0:23:12.17,0:23:13.91,JP,,0000,0000,0000,,Лондонда шай ішуге болады ма?
Dialogue: 0,0:23:14.21,0:23:15.71,JP,,0000,0000,0000,,Бұл шай елі.
Dialogue: 0,0:23:16.12,0:23:19.10,JP,,0000,0000,0000,,Керемет, біз үшін тамаша
Dialogue: 0,0:23:20.39,0:23:23.31,JP,,0000,0000,0000,,Бес адам болса, екі бөлме болады.
Dialogue: 0,0:23:23.61,0:23:24.58,JP,,0000,0000,0000,,Үштен екіге дейін
Dialogue: 0,0:23:24.70,0:23:25.34,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:23:26.50,0:23:28.04,JP,,0000,0000,0000,,Азуса-чан да барады, солай ма?
Dialogue: 0,0:23:28.49,0:23:31.83,JP,,0000,0000,0000,,Жоқ, бұл үлкендерге арналған бітіру сапары.
Dialogue: 0,0:23:31.97,0:23:33.64,JP,,0000,0000,0000,,Мен төлқұжатымды жоғалтып алдым.
Dialogue: 0,0:23:33.64,0:23:36.72,JP,,0000,0000,0000,,Иә, бірақ менің мектебім жоқ.
Dialogue: 0,0:23:36.80,0:23:39.39,JP,,0000,0000,0000,,Қорытынды емтиханнан кейін демалыс күні болады.
Dialogue: 0,0:23:39.84,0:23:42.34,JP,,0000,0000,0000,,Есімде болса, бес күндік демалыс болуы керек...
Dialogue: 0,0:23:42.34,0:23:44.27,JP,,0000,0000,0000,,Онда ешқандай проблема жоқ.
Dialogue: 0,0:23:44.27,0:23:45.10,JP,,0000,0000,0000,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:23:45.74,0:23:50.40,JP,,0000,0000,0000,,Мен сенімен бірге барғым келеді. Азунянсыз жеңіл музыка клубы болмас еді.
Dialogue: 0,0:23:54.14,0:23:56.52,JP,,0000,0000,0000,,Азуса Менің барғым келмейді
Dialogue: 0,0:23:57.09,0:23:59.77,JP,,0000,0000,0000,,Менің барғым келеді...
Dialogue: 0,0:24:00.30,0:24:02.33,JP,,0000,0000,0000,,Сіз мені шынымен мазалайды ма?
Dialogue: 0,0:24:02.98,0:24:03.86,JP,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:24:07.46,0:24:08.81,JP,,0000,0000,0000,,Жарайды... бәрібір.
Dialogue: 0,0:24:09.03,0:24:11.29,JP,,0000,0000,0000,,орындалған шешім
Dialogue: 0,0:24:11.29,0:24:14.81,JP,,0000,0000,0000,,Аа, бірақ оған дейін мен үйде тексеруім керек.
Dialogue: 0,0:24:18.16,0:24:21.35,JP,,0000,0000,0000,,Аа, Сәлем анашым, Азуса.
Dialogue: 0,0:24:22.26,0:24:23.96,JP,,0000,0000,0000,,Иә, көріп тұрсыз.
Dialogue: 0,0:24:28.84,0:24:30.15,JP,,0000,0000,0000,,Рахмет анашым
Dialogue: 0,0:24:37.37,0:24:39.72,JP,,0000,0000,0000,,Менің анам да ''Жарайды'' деді, сондықтан...
Dialogue: 0,0:24:39.91,0:24:41.43,JP,,0000,0000,0000,,Иә Лондон
Dialogue: 0,0:24:41.67,0:24:43.77,JP,,0000,0000,0000,,Білесің бе, бұл мектеп бітіруге арналған саяхат.
Dialogue: 0,0:24:44.60,0:24:45.76,JP,,0000,0000,0000,,О, анашым
Dialogue: 0,0:24:46.06,0:24:48.14,JP,,0000,0000,0000,,Анашым, өмірлік тілегім
Dialogue: 0,0:24:48.62,0:24:51.13,JP,,0000,0000,0000,,Иә, Рицу да осында, олай емес.
Dialogue: 0,0:24:49.69,0:24:50.60,JP,,0000,0000,0000,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:24:51.87,0:24:53.71,JP,,0000,0000,0000,,Рахмет, көріскенше
Dialogue: 0,0:24:59.40,0:25:01.17,JP,,0000,0000,0000,,Мен бар күшімді саламын
Dialogue: 0,0:25:03.82,0:25:07.70,JP,,0000,0000,0000,,Не, Лондон нағыз Лондон болды ма?
Dialogue: 0,0:25:08.05,0:25:10.44,JP,,0000,0000,0000,,Бұл анық.
Dialogue: 0,0:25:10.80,0:25:14.26,JP,,0000,0000,0000,,Сіз Лондонның қай жерінде болдым деп ойладыңыз, Кадзу-чан?
Dialogue: 0,0:25:15.67,0:25:20.37,JP,,0000,0000,0000,,Мен кенеттен электрондық хат алдым, сондықтан мен мұндай дүкен мұны істей ала ма деп ойладым.
Dialogue: 0,0:25:20.57,0:25:24.21,JP,,0000,0000,0000,,Ертең бәріміз туристік агенттікке құжат тапсырамыз.
Dialogue: 0,0:25:24.36,0:25:29.77,JP,,0000,0000,0000,,Жеңіл музыка үйірмесіндегілердің барлығы Англияға барғысы келетінін білмедім.
Dialogue: 0,0:25:31.57,0:25:34.25,JP,,0000,0000,0000,,Хмм, бұл біртүрлі және керемет.
Dialogue: 0,0:25:34.92,0:25:38.16,JP,,0000,0000,0000,,Көрдіңіз бе, мен барғым келген адам Мио Чан болды.
Dialogue: 0,0:25:38.16,0:25:40.00,JP,,0000,0000,0000,,Шешім қабылдаған Тон-чан болды.
Dialogue: 0,0:25:40.29,0:25:41.85,JP,,0000,0000,0000,,Жұмсақ қабықты тасбақа шешті
Dialogue: 0,0:25:42.21,0:25:43.91,JP,,0000,0000,0000,,Жұмсақ қабықты тасбақа
Dialogue: 0,0:25:43.91,0:25:47.24,JP,,0000,0000,0000,,Ал мен Англияға емес, Лондонға барамын.
Dialogue: 0,0:25:49.61,0:25:52.32,JP,,0000,0000,0000,,Юи Шынымен де айту қиын.
Dialogue: 0,0:25:53.62,0:25:55.27,JP,,0000,0000,0000,,Лондон – Англия.
Dialogue: 0,0:25:57.78,0:25:59.30,JP,,0000,0000,0000,,Кенеттен не болды?
Dialogue: 0,0:25:59.67,0:26:01.82,JP,,0000,0000,0000,,Сенің маған дейін баратыныңа сене алар емеспін.
Dialogue: 0,0:26:02.41,0:26:03.98,JP,,0000,0000,0000,,Мен көп сатып аламын.
Dialogue: 0,0:26:05.17,0:26:08.47,JP,,0000,0000,0000,,Себебі мен біраз зерттеу жүргізуім керек.
Dialogue: 0,0:26:12.37,0:26:14.20,JP,,0000,0000,0000,,Апаңызға қамқор болыңыз.
Dialogue: 0,0:26:14.52,0:26:18.38,JP,,0000,0000,0000,,Мм, мен сол үлкен апаны айтып отырмын.
Dialogue: 0,0:26:19.49,0:26:22.93,JP,,0000,0000,0000,,Менен бірдеңе жасырып тұрған сияқтысың.
Dialogue: 0,0:26:23.96,0:26:25.84,JP,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:26:26.68,0:26:30.35,JP,,0000,0000,0000,,Менің ойымша, сен апаңнан ештеңе жасыра алмайсың.
Dialogue: 0,0:26:31.42,0:26:32.88,JP,,0000,0000,0000,,Дұрыс па, солай емес пе?
Dialogue: 0,0:26:33.86,0:26:34.96,JP,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:26:35.41,0:26:37.40,JP,,0000,0000,0000,,Сіз саяхат туралы сұрайсыз ба?
Dialogue: 0,0:26:37.65,0:26:38.67,JP,,0000,0000,0000,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:26:39.02,0:26:41.63,JP,,0000,0000,0000,,Лондонда шамамен бес күн болды.
Dialogue: 0,0:26:42.10,0:26:44.37,JP,,0000,0000,0000,,Лондонда үш түн бес күн.
Dialogue: 0,0:26:44.37,0:26:46.57,JP,,0000,0000,0000,,Үш... Е, азайған жоқ.
Dialogue: 0,0:26:46.81,0:26:48.83,JP,,0000,0000,0000,,Мен сол жаққа және кері қайтар жолда бір түн өткіземін.
Dialogue: 0,0:26:49.03,0:26:50.22,JP,,0000,0000,0000,,А... иә
Dialogue: 0,0:26:50.22,0:26:50.97,JP,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:26:50.97,0:26:51.57,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:26:51.57,0:26:53.54,JP,,0000,0000,0000,,Мен Лондонда ғана қалсам болады ма?
Dialogue: 0,0:26:54.06,0:26:54.86,JP,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:26:55.14,0:26:56.17,JP,,0000,0000,0000,,Жақсы емес пе?
Dialogue: 0,0:26:56.38,0:26:57.61,JP,,0000,0000,0000,,Бұл мен Май-санды енді ешқашан көре алмайтынымды білдіре ме?
Dialogue: 0,0:26:57.61,0:26:59.23,JP,,0000,0000,0000,,Көретін жерлер көп.
Dialogue: 0,0:26:59.95,0:27:01.19,JP,,0000,0000,0000,,А, мен мұны мінгім келеді.
Dialogue: 0,0:27:01.19,0:27:02.73,JP,,0000,0000,0000,,Шайханаға барайық.
Dialogue: 0,0:27:02.87,0:27:04.95,JP,,0000,0000,0000,,Бұл дәмді көрінеді.
Dialogue: 0,0:27:04.95,0:27:05.27,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:27:05.27,0:27:06.60,JP,,0000,0000,0000,,Әй, бұл керемет.
Dialogue: 0,0:27:06.60,0:27:10.63,JP,,0000,0000,0000,,Мен Джими Хен мен Джимми Пейдж тұрған үйге барғым келеді.
Dialogue: 0,0:27:10.78,0:27:11.69,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:27:11.80,0:27:12.99,JP,,0000,0000,0000,,Дэвид Боуидің үйі де
Dialogue: 0,0:27:12.99,0:27:14.42,JP,,0000,0000,0000,,А, мұнда музыка дүкені бар.
Dialogue: 0,0:27:14.42,0:27:15.32,JP,,0000,0000,0000,,Abbey Road
Dialogue: 0,0:27:15.32,0:27:16.12,JP,,0000,0000,0000,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:27:16.63,0:27:20.98,JP,,0000,0000,0000,,Бұл жағдайда мен бәрін өз бетімен жасауға болатын жеке саяхатты ұсынамын.
Dialogue: 0,0:27:20.98,0:27:23.25,JP,,0000,0000,0000,,Бұл біраз түсінікті.
Dialogue: 0,0:27:23.57,0:27:25.39,JP,,0000,0000,0000,,Олай болса, өтінемін.
Dialogue: 0,0:27:41.69,0:27:42.87,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:27:43.60,0:27:45.02,JP,,0000,0000,0000,,Ах, жеңіл музыка клубы.
Dialogue: 0,0:27:45.65,0:27:47.05,JP,,0000,0000,0000,,Суық.
Dialogue: 0,0:27:47.92,0:27:50.57,JP,,0000,0000,0000,,Оккульттік зертхана әлі де клубтық іс-шараларды жүргізуде.
Dialogue: 0,0:27:50.76,0:27:55.80,JP,,0000,0000,0000,,Иә, мен төбесінде ғаламмен біраз уақыт сөйлесуге тырысамын.
Dialogue: 0,0:27:56.20,0:27:59.80,JP,,0000,0000,0000,,Аа, дұрыс. Мен келесі жолы жеңіл музыка клубымен Англияға барамын.
Dialogue: 0,0:27:59.98,0:28:00.77,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:28:01.32,0:28:03.10,JP,,0000,0000,0000,,Бұл мектеп бітірушілерге саяхат.
Dialogue: 0,0:28:03.29,0:28:04.81,JP,,0000,0000,0000,,Ең жақсы сувенир қандай?
Dialogue: 0,0:28:07.38,0:28:08.42,JP,,0000,0000,0000,,Несси...
Dialogue: 0,0:28:08.71,0:28:09.50,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:28:12.15,0:28:14.54,JP,,0000,0000,0000,,Хехехехе... Несси
Dialogue: 0,0:28:16.11,0:28:18.97,JP,,0000,0000,0000,,Нессиді суретке түсіріңізші.
Dialogue: 0,0:28:18.97,0:28:22.65,JP,,0000,0000,0000,,Иә, түсіндім, маған қалдырыңыз.
Dialogue: 0,0:28:22.68,0:28:25.94,JP,,0000,0000,0000,,Е, жеңіл музыка клубы
Dialogue: 0,0:28:26.61,0:28:28.56,JP,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:28:28.81,0:28:30.55,JP,,0000,0000,0000,,Мен оны жоспарлай аламын ба?
Dialogue: 0,0:28:31.32,0:28:32.59,JP,,0000,0000,0000,,Бұл Несси ме?
Dialogue: 0,0:28:34.84,0:28:37.00,JP,,0000,0000,0000,,Күтілгендей, Лох Несс алыс.
Dialogue: 0,0:28:37.61,0:28:40.56,JP,,0000,0000,0000,,Оның үстіне Несси де жоқ сияқты.
Dialogue: 0,0:28:40.92,0:28:43.29,JP,,0000,0000,0000,,Мүмкін Occult Lab Gag
Dialogue: 0,0:28:43.49,0:28:46.63,JP,,0000,0000,0000,,Деңгей тым жоғары, сондықтан мен түсінбеймін.
Dialogue: 0,0:28:47.16,0:28:49.00,JP,,0000,0000,0000,,Хирасава мырза
Dialogue: 0,0:28:49.16,0:28:49.82,JP,,0000,0000,0000,,О.
Dialogue: 0,0:28:49.99,0:28:52.50,JP,,0000,0000,0000,,Баршаңызға, менің басқа өтінішім жоқ.
Dialogue: 0,0:28:52.70,0:28:54.00,JP,,0000,0000,0000,,№
Dialogue: 0,0:28:54.13,0:28:58.99,JP,,0000,0000,0000,,Олай болса, осы жадынамаға сүйене отырып, сіз тиімді саяхаттауыңыз үшін маршрутты қорытындылаймын.
Dialogue: 0,0:29:00.13,0:29:01.60,JP,,0000,0000,0000,,Мен сұрай аламын ба?
Dialogue: 0,0:29:01.60,0:29:04.30,JP,,0000,0000,0000,,Иә, маған мұндай нәрсе ұнайды.
Dialogue: 0,0:29:04.49,0:29:05.35,JP,,0000,0000,0000,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:29:05.68,0:29:07.72,JP,,0000,0000,0000,,Азуса-чан ше?
Dialogue: 0,0:29:07.72,0:29:09.02,JP,,0000,0000,0000,,А, қазір бәрі жақсы.
Dialogue: 0,0:29:09.37,0:29:10.99,JP,,0000,0000,0000,,Менің қарным тоқ.
Dialogue: 0,0:29:10.99,0:29:15.41,JP,,0000,0000,0000,,Егер Азу-нян кесте жасаса, жеңіл тағамдарға уақыт болмайды.
Dialogue: 0,0:29:15.89,0:29:19.67,JP,,0000,0000,0000,,Бұл еркін әрекет, сондықтан сіз еркін әрекет етуіңіз керек.
Dialogue: 0,0:29:20.41,0:29:21.53,JP,,0000,0000,0000,,Азуса, үйге қайт
Dialogue: 0,0:29:21.62,0:29:24.47,JP,,0000,0000,0000,,Иә, бәрің әлі үйге бармайсыңдар ма?
Dialogue: 0,0:29:24.94,0:29:26.98,JP,,0000,0000,0000,,А, мен үйге бара жатырмын.
Dialogue: 0,0:29:29.31,0:29:32.78,JP,,0000,0000,0000,,А...Түстен кейінгі шай жаттығуы, сосын үйге қайт.
Dialogue: 0,0:29:33.39,0:29:34.20,JP,,0000,0000,0000,,Біз
Dialogue: 0,0:29:34.20,0:29:34.83,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:29:35.26,0:29:37.91,JP,,0000,0000,0000,,Мен тағы бір шыны шай ішіп алайын, үйге барайын, Азуса-чан.
Dialogue: 0,0:29:38.21,0:29:39.47,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:29:39.93,0:29:41.57,JP,,0000,0000,0000,,Бұл кәдесый
Dialogue: 0,0:29:41.57,0:29:43.08,JP,,0000,0000,0000,,Жалықтырды, бірақ мен де кесе жуайын.
Dialogue: 0,0:29:43.46,0:29:46.17,JP,,0000,0000,0000,,Кешіріңіз, рахмет
Dialogue: 0,0:29:46.25,0:29:47.62,JP,,0000,0000,0000,,Абайлаңыз, Азуса.
Dialogue: 0,0:29:47.62,0:29:49.34,JP,,0000,0000,0000,,Тамақтану уақытын қосыңыз
Dialogue: 0,0:29:49.34,0:29:51.01,JP,,0000,0000,0000,,Олай болса, алдымен кешірім сұраймын.
Dialogue: 0,0:29:51.20,0:29:53.09,JP,,0000,0000,0000,,Ертең кездескенше
Dialogue: 0,0:29:53.92,0:29:57.65,JP,,0000,0000,0000,,Енді нақты нәрсе басталады.
Dialogue: 0,0:29:57.88,0:29:59.21,JP,,0000,0000,0000,,Не
Dialogue: 0,0:29:59.39,0:30:01.41,JP,,0000,0000,0000,,Ой, сен әлі сондасың ба?
Dialogue: 0,0:30:01.41,0:30:02.75,JP,,0000,0000,0000,,Аздап
Dialogue: 0,0:30:02.75,0:30:04.54,JP,,0000,0000,0000,,Жоқ, Сава-чан
Dialogue: 0,0:30:04.54,0:30:06.06,JP,,0000,0000,0000,,Бұл қызықсыз, бірақ...
Dialogue: 0,0:30:06.21,0:30:09.64,JP,,0000,0000,0000,,Аа, дұрыс, бүгін кездесу болды емес пе?
Dialogue: 0,0:30:09.64,0:30:11.14,JP,,0000,0000,0000,,Мұндай жоспар жоқ.
Dialogue: 0,0:30:11.14,0:30:12.91,JP,,0000,0000,0000,,О, тағы да
Dialogue: 0,0:30:15.13,0:30:15.90,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:30:16.50,0:30:18.52,JP,,0000,0000,0000,,«Азунянға сыйлық»
Dialogue: 0,0:30:20.63,0:30:22.04,JP,,0000,0000,0000,,Сіз нені қалайсыз?
Dialogue: 0,0:30:22.13,0:30:24.34,JP,,0000,0000,0000,,Ол маған үнемі қамқорлық жасайды.
Dialogue: 0,0:30:24.79,0:30:29.76,JP,,0000,0000,0000,,Күнделікті ризашылығымды өз жолыммен білдіруге келгенде
Dialogue: 0,0:30:30.58,0:30:31.43,JP,,0000,0000,0000,,Драма т.б.
Dialogue: 0,0:30:31.43,0:30:32.98,JP,,0000,0000,0000,,Мен енді ойнағым келмейді.
Dialogue: 0,0:30:31.79,0:30:33.86,JP,,0000,0000,0000,,Бірдеңе бар ма?
Dialogue: 0,0:30:34.68,0:30:39.37,JP,,0000,0000,0000,,А, Азунян, мен Муттанды ұмытып кетіппін. Қиын, қиын.
Dialogue: 0,0:30:39.56,0:30:40.84,JP,,0000,0000,0000,,Бұл Мустанг.
Dialogue: 0,0:30:41.77,0:30:43.72,JP,,0000,0000,0000,,Мио-чандікі Элизабет, солай ма?
Dialogue: 0,0:30:47.26,0:30:49.30,JP,,0000,0000,0000,,Ой... Муттан сұрайын ба?
Dialogue: 0,0:30:50.51,0:30:55.72,JP,,0000,0000,0000,,Моттан Азунянға қандай жақсы сыйлық бар?
Dialogue: 0,0:30:57.05,0:30:58.94,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:30:59.73,0:31:00.93,JP,,0000,0000,0000,,Муттан
Dialogue: 0,0:31:00.93,0:31:03.25,JP,,0000,0000,0000,,Ой, күте тұрыңыз...
Dialogue: 0,0:31:04.81,0:31:07.00,JP,,0000,0000,0000,,...
Dialogue: 0,0:31:08.71,0:31:09.87,JP,,0000,0000,0000,,Мен «ән» дедім
Dialogue: 0,0:31:10.14,0:31:12.43,JP,,0000,0000,0000,,Жаман жер болды ма?
Dialogue: 0,0:31:13.01,0:31:13.81,JP,,0000,0000,0000,,Арктика
Dialogue: 0,0:31:14.01,0:31:15.85,JP,,0000,0000,0000,,№.
Dialogue: 0,0:31:15.85,0:31:16.78,JP,,0000,0000,0000,,бап
Dialogue: 0,0:31:16.78,0:31:19.01,JP,,0000,0000,0000,,Киоку емес
Dialogue: 0,0:31:19.01,0:31:19.66,JP,,0000,0000,0000,,Шет
Dialogue: 0,0:31:19.95,0:31:23.63,JP,,0000,0000,0000,,Сондықтан оны ән деп атайды, дәлірек айтсақ, музыка...
Dialogue: 0,0:31:24.40,0:31:28.07,JP,,0000,0000,0000,,Әй, осы уақытқа дейін неге байқамадым деп ойлаймын.
Dialogue: 0,0:31:28.19,0:31:30.81,JP,,0000,0000,0000,,Сонда сен Азусаға ән сыйлайсың ба?
Dialogue: 0,0:31:31.78,0:31:34.04,JP,,0000,0000,0000,,Иә, ол да қобалжығанын айтты.
Dialogue: 0,0:31:34.55,0:31:39.25,JP,,0000,0000,0000,,Азунян жеңіл музыка үйірмесін және жеңіл музыка клубының музыкасын жақсы көреді.
Dialogue: 0,0:31:41.53,0:31:43.32,JP,,0000,0000,0000,,Азуса-чанға арналған ән...
Dialogue: 0,0:31:45.39,0:31:46.93,JP,,0000,0000,0000,,Хмм... Жақсы.
Dialogue: 0,0:31:46.93,0:31:49.77,JP,,0000,0000,0000,,Бұл жақсы. Үлкеннен кішіге дейінгі ән.
Dialogue: 0,0:31:49.77,0:31:51.33,JP,,0000,0000,0000,,Бұл өте керемет
Dialogue: 0,0:31:51.33,0:31:52.72,JP,,0000,0000,0000,,Иә, бұл тамаша.
Dialogue: 0,0:31:53.54,0:31:55.93,JP,,0000,0000,0000,,Эй Юи, қандай ән таңдауымыз керек?
Dialogue: 0,0:31:56.31,0:32:00.18,JP,,0000,0000,0000,,Иә, бұл менің ағамның жасаған әні.
Dialogue: 0,0:32:00.27,0:32:05.06,JP,,0000,0000,0000,,Шап-шұңқыр болып, дүбірдей.
Dialogue: 0,0:32:05.60,0:32:06.44,JP,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:32:06.85,0:32:13.19,JP,,0000,0000,0000,,Басқаша айтқанда, бұл біз бұрын-соңды көрген нәрселерден де үлкен ауқымдағы ән.
Dialogue: 0,0:32:15.02,0:32:16.62,JP,,0000,0000,0000,,-де, мысалы, не
Dialogue: 0,0:32:22.88,0:32:24.16,JP,,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,0:32:24.79,0:32:26.88,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:32:27.57,0:32:28.72,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:32:30.65,0:32:32.35,JP,,0000,0000,0000,,Аа Азунян, сен ол жерде қанша болды?
Dialogue: 0,0:32:32.35,0:32:34.17,JP,,0000,0000,0000,,Мм... мен үйдемін.
Dialogue: 0,0:32:34.48,0:32:35.24,JP,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:32:35.24,0:32:36.51,JP,,0000,0000,0000,,Иә иә
Dialogue: 0,0:32:40.43,0:32:41.44,JP,,0000,0000,0000,,Бұл қауіпті болды.
Dialogue: 0,0:32:41.76,0:32:45.03,JP,,0000,0000,0000,,Ой, түсіндім, Муттанды ұмытып кетіпсің.
Dialogue: 0,0:32:46.30,0:32:48.86,JP,,0000,0000,0000,,Жоқ, мен оны ұмытамын.
Dialogue: 0,0:32:48.95,0:32:49.97,JP,,0000,0000,0000,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:32:51.17,0:32:52.30,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:32:52.80,0:32:54.18,JP,,0000,0000,0000,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:33:02.95,0:33:03.97,JP,,0000,0000,0000,,Аномалия жоқ
Dialogue: 0,0:33:05.02,0:33:05.92,JP,,0000,0000,0000,,Азунян
Dialogue: 0,0:33:06.17,0:33:08.22,JP,,0000,0000,0000,,Ха, жоқ, егер мен
Dialogue: 0,0:33:08.22,0:33:10.37,JP,,0000,0000,0000,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:33:10.56,0:33:11.61,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:33:17.79,0:33:22.34,JP,,0000,0000,0000,,Бұрынғы қарттардың мен бұрын көрмеген ауыр жүздері болды.
Dialogue: 0,0:33:28.39,0:33:29.39,JP,,0000,0000,0000,,Ресми құжаттарды жариялаған екен.
Dialogue: 0,0:33:37.88,0:33:38.52,JP,,0000,0000,0000,,Бұл бидай.
Dialogue: 0,0:33:45.80,0:33:47.41,JP,,0000,0000,0000,,Мына жігіт көңіл көтеріп отыр
Dialogue: 0,0:33:48.07,0:33:49.87,JP,,0000,0000,0000,,Мен қорқамын
Dialogue: 0,0:33:58.53,0:34:01.57,JP,,0000,0000,0000,,Whew, сіз бүкіл әлем бойынша ән жасай аласыз.
Dialogue: 0,0:34:07.69,0:34:09.93,JP,,0000,0000,0000,,Әпке, осы жерден сәл тұрыңыз.
Dialogue: 0,0:34:12.12,0:34:13.66,JP,,0000,0000,0000,,Уф... Мен кіре алмаймын.
Dialogue: 0,0:34:13.91,0:34:15.66,JP,,0000,0000,0000,,Көптеген жапон тағамдары.
Dialogue: 0,0:34:16.11,0:34:17.73,JP,,0000,0000,0000,,Менің оны жегім келетін сияқты.
Dialogue: 0,0:34:19.29,0:34:21.04,JP,,0000,0000,0000,,Сіз де формаңызды әкелесіз, солай ма?
Dialogue: 0,0:34:21.32,0:34:22.73,JP,,0000,0000,0000,,Барлығы да алып келеді.
Dialogue: 0,0:34:22.97,0:34:23.81,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:34:24.14,0:34:27.86,JP,,0000,0000,0000,,Юи Сапарыңызға ағылшын тіліндегі сөйлесу кітабын да алып келуіңіз керек.
Dialogue: 0,0:34:27.93,0:34:29.04,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:34:29.18,0:34:31.14,JP,,0000,0000,0000,,Сондай-ақ розетка және трансформатор.
Dialogue: 0,0:34:31.35,0:34:32.02,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:34:32.02,0:34:33.47,JP,,0000,0000,0000,,Менің жүгім тағы көбейді.
Dialogue: 0,0:34:33.93,0:34:35.93,JP,,0000,0000,0000,,Сіз де ерте жатыңыз.
Dialogue: 0,0:34:36.32,0:34:37.52,JP,,0000,0000,0000,,Yes
Dialogue: 0,0:34:40.44,0:34:42.71,JP,,0000,0000,0000,,Мен ертең Лондонға барамын.
Dialogue: 0,0:34:44.25,0:34:45.48,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:34:45.85,0:34:48.00,JP,,0000,0000,0000,,Мұң да келсе, жеңіл боламын.
Dialogue: 0,0:34:50.61,0:34:51.95,JP,,0000,0000,0000,,Сіз мұңаймайсыз ба?
Dialogue: 0,0:34:51.95,0:34:52.61,JP,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:34:52.61,0:34:53.59,JP,,0000,0000,0000,,Өтірік
Dialogue: 0,0:34:53.73,0:34:55.20,JP,,0000,0000,0000,,Әрине, ол жай ғана дос қой.
Dialogue: 0,0:34:55.57,0:34:57.00,JP,,0000,0000,0000,,Кеттік
Dialogue: 0,0:34:58.49,0:35:00.74,JP,,0000,0000,0000,,Сау болыңыз, апа.
Dialogue: 0,0:35:01.68,0:35:03.15,JP,,0000,0000,0000,,Мен саған шырын сатып аламын.
Dialogue: 0,0:35:03.83,0:35:05.05,JP,,0000,0000,0000,,Жүкті сұрамаңыз
Dialogue: 0,0:35:05.20,0:35:06.13,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:35:11.32,0:35:12.96,JP,,0000,0000,0000,,Рикчан Риччан
Dialogue: 0,0:35:13.04,0:35:14.65,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:35:14.65,0:35:17.29,JP,,0000,0000,0000,,О... Гита
Dialogue: 0,0:35:17.65,0:35:20.82,JP,,0000,0000,0000,,Мен бірге естелік суретке түсуді ойладым.
Dialogue: 0,0:35:21.05,0:35:22.60,JP,,0000,0000,0000,,Мио мен Юи
Dialogue: 0,0:35:22.60,0:35:23.35,JP,,0000,0000,0000,,Не
Dialogue: 0,0:35:23.35,0:35:24.01,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:35:25.34,0:35:26.33,JP,,0000,0000,0000,,Мока Азуса
Dialogue: 0,0:35:29.95,0:35:31.13,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:35:31.31,0:35:32.36,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:35:33.78,0:35:35.60,JP,,0000,0000,0000,,Сіз Мустанг әкелдіңіз.
Dialogue: 0,0:35:35.76,0:35:38.00,JP,,0000,0000,0000,,А, иә, мен абдырап қалдым.
Dialogue: 0,0:35:38.20,0:35:40.60,JP,,0000,0000,0000,,Мен Юй-сенпай міндетті түрде аяқ киімін өзі әкелсін деп ойладым.
Dialogue: 0,0:35:40.99,0:35:42.62,JP,,0000,0000,0000,,Ах, күткендей.
Dialogue: 0,0:35:42.82,0:35:44.44,JP,,0000,0000,0000,,Юи мен Азуса бірге.
Dialogue: 0,0:35:46.10,0:35:47.01,JP,,0000,0000,0000,,Күтілгендей...
Dialogue: 0,0:35:47.88,0:35:51.65,JP,,0000,0000,0000,,Егер сіз музыкантты кездестірсеңіз, одан қолтаңба сұраңыз.
Dialogue: 0,0:35:51.87,0:35:52.79,JP,,0000,0000,0000,,Иә иә
Dialogue: 0,0:35:53.29,0:35:55.33,JP,,0000,0000,0000,,Олай болса Муги станциясына барайық.
Dialogue: 0,0:36:00.55,0:36:02.58,JP,,0000,0000,0000,,Жақсы кадр, бұл не, Ричан да?
Dialogue: 0,0:36:03.23,0:36:05.19,JP,,0000,0000,0000,,Сіз бірдеңені ұмыттыңыз ба?
Dialogue: 0,0:36:05.61,0:36:07.44,JP,,0000,0000,0000,,Аа, мен төлқұжатымды ұмытып қалдым.
Dialogue: 0,0:36:08.09,0:36:10.10,JP,,0000,0000,0000,,Жарайды, мен Юй-сенпайды қалдырамын.
Dialogue: 0,0:36:10.10,0:36:10.83,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:36:10.83,0:36:12.69,JP,,0000,0000,0000,,Сіз оны мойныңызға тағып жүрсіз, солай ма?
Dialogue: 0,0:36:14.80,0:36:16.43,JP,,0000,0000,0000,,Мен мұны уәде деп ойладым
Dialogue: 0,0:36:31.60,0:36:33.16,JP,,0000,0000,0000,,Қайырлы таң Муги Чан
Dialogue: 0,0:36:33.61,0:36:34.76,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:36:35.24,0:36:39.46,JP,,0000,0000,0000,,Бұл жалқау. Мен де әкелуім керек еді.
Dialogue: 0,0:36:44.38,0:36:45.17,JP,,0000,0000,0000,,Кең
Dialogue: 0,0:36:45.19,0:36:46.30,JP,,0000,0000,0000,,Керемет
Dialogue: 0,0:36:46.59,0:36:48.18,JP,,0000,0000,0000,,Шай ішейік...
Dialogue: 0,0:36:48.22,0:36:49.69,JP,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:36:49.69,0:36:51.46,JP,,0000,0000,0000,,Алдымен жүктерімізді түсіріп алайық.
Dialogue: 0,0:36:51.64,0:36:53.07,JP,,0000,0000,0000,,А, бұл жақсы.
Dialogue: 0,0:36:54.68,0:36:56.33,JP,,0000,0000,0000,,Біз өте өкінеміз.
Dialogue: 0,0:36:56.89,0:36:59.76,JP,,0000,0000,0000,,Бүгін ұшақта адам көп болды.
Dialogue: 0,0:37:00.10,0:37:03.99,JP,,0000,0000,0000,,Қарсы болмасаңыз, мен жүктеріңізді өзіңізге қалдырғым келеді...
Dialogue: 0,0:37:04.47,0:37:05.41,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:37:08.47,0:37:10.39,JP,,0000,0000,0000,,Гита Лондонда кездескенше
Dialogue: 0,0:37:11.10,0:37:14.00,JP,,0000,0000,0000,,Маған бұл ұнайды. Оның мектепте қолжетімді болғанын қалаймын.
Dialogue: 0,0:37:14.34,0:37:15.55,JP,,0000,0000,0000,,Жаяу дәліз
Dialogue: 0,0:37:15.73,0:37:17.01,JP,,0000,0000,0000,,Ол қозғалады.
Dialogue: 0,0:37:18.00,0:37:19.87,JP,,0000,0000,0000,,Мен аяғымды көремін Мен оларды көремін
Dialogue: 0,0:37:20.33,0:37:22.47,JP,,0000,0000,0000,,Өсекші жігіт не болып жатыр?
Dialogue: 0,0:37:22.47,0:37:23.83,JP,,0000,0000,0000,,Сіз кездесіп жүрсіз бе?
Dialogue: 0,0:37:24.29,0:37:25.35,JP,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:37:25.35,0:37:26.53,JP,,0000,0000,0000,,Котобуки-сан
Dialogue: 0,0:37:29.26,0:37:31.16,JP,,0000,0000,0000,,Айда серуендеу
Dialogue: 0,0:37:31.55,0:37:32.92,JP,,0000,0000,0000,,Сіз тым көңілді болып жатырсыз.
Dialogue: 0,0:37:33.11,0:37:34.53,JP,,0000,0000,0000,,А, қараңдаршы
Dialogue: 0,0:37:35.84,0:37:37.12,JP,,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,0:37:44.16,0:37:45.56,JP,,0000,0000,0000,,Хаа Рицу Рицу
Dialogue: 0,0:37:44.73,0:37:46.38,JP,,0000,0000,0000,,Тағам сатып алудың қажеті жоқ
Dialogue: 0,0:37:46.59,0:37:48.37,JP,,0000,0000,0000,,Мен бірден ұшақта тамақтанамын.
Dialogue: 0,0:37:48.70,0:37:50.54,JP,,0000,0000,0000,,Азуса-чан, сен мені жақсы білесің.
Dialogue: 0,0:37:51.23,0:37:52.64,JP,,0000,0000,0000,,Мен біраз зерттеу жүргіздім.
Dialogue: 0,0:37:55.61,0:37:57.30,JP,,0000,0000,0000,,Бір нәрсе өтірік сияқты
Dialogue: 0,0:37:58.27,0:37:59.74,JP,,0000,0000,0000,,Ұшақта
Dialogue: 0,0:37:59.74,0:38:01.53,JP,,0000,0000,0000,,Түскенде сіз Лондонда боласыз.
Dialogue: 0,0:38:01.90,0:38:03.57,JP,,0000,0000,0000,,Бұл басқа ел.
Dialogue: 0,0:38:04.31,0:38:07.05,JP,,0000,0000,0000,,Мен бәріміз бірге шетелге шыға алатынымызға сене алмаймын.
Dialogue: 0,0:38:07.46,0:38:10.02,JP,,0000,0000,0000,,Мен өткенге немесе болашаққа бардым.
Dialogue: 0,0:38:10.42,0:38:12.22,JP,,0000,0000,0000,,Бұл уақыт машинасы емес.
Dialogue: 0,0:38:13.48,0:38:15.33,JP,,0000,0000,0000,,Бірақ мен уақытты кері қайтарамын
Dialogue: 0,0:38:15.33,0:38:16.67,JP,,0000,0000,0000,,Уау, Мүгі-сенпай
Dialogue: 0,0:38:18.39,0:38:20.22,JP,,0000,0000,0000,,Хэхехе иә бұл көзге арналған маска
Dialogue: 0,0:38:20.32,0:38:21.24,JP,,0000,0000,0000,,А, сәлем
Dialogue: 0,0:38:21.24,0:38:22.40,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:38:22.80,0:38:24.87,JP,,0000,0000,0000,,Ей, бидай, мен мұны қалай пайдаланамын?
Dialogue: 0,0:38:23.27,0:38:24.79,JP,,0000,0000,0000,,Уақыт кері кетеді
Dialogue: 0,0:38:25.16,0:38:28.17,JP,,0000,0000,0000,,Өйткені ол Жердің айналуына қарама-қарсы бағытта жүреді...
Dialogue: 0,0:38:28.81,0:38:31.19,JP,,0000,0000,0000,,Артқа бұрылсаң, уақыт кері кетеді.
Dialogue: 0,0:38:31.68,0:38:32.31,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:38:32.55,0:38:33.78,JP,,0000,0000,0000,,Олай болса
Dialogue: 0,0:38:35.97,0:38:38.36,JP,,0000,0000,0000,,Аға, қауіпсіздік белбеуіңізді байлаңыз.
Dialogue: 0,0:38:40.98,0:38:44.94,JP,,0000,0000,0000,,Олай болса, артқа кете берсең, өткенге барасың.
Dialogue: 0,0:38:45.17,0:38:46.86,JP,,0000,0000,0000,,Мен онша алысқа бармаймын.
Dialogue: 0,0:38:47.56,0:38:49.20,JP,,0000,0000,0000,,Сонда қанша...
Dialogue: 0,0:38:49.24,0:38:50.47,JP,,0000,0000,0000,,А, мен ұшып бара жатырмын.
Dialogue: 0,0:38:51.18,0:38:52.51,JP,,0000,0000,0000,,Бұл ұшып бара жатыр ма?
Dialogue: 0,0:38:52.77,0:38:55.02,JP,,0000,0000,0000,,Азунян қозғалады
Dialogue: 0,0:39:02.71,0:39:08.24,JP,,0000,0000,0000,,Ооо, бұлт о
Dialogue: 0,0:39:15.38,0:39:18.24,JP,,0000,0000,0000,,Азунян, жапондық бұл жерден кіруге тыйым салынады.
Dialogue: 0,0:39:19.36,0:39:20.15,JP,,0000,0000,0000,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:39:22.68,0:39:24.28,JP,,0000,0000,0000,,Көзбен түсіну
Dialogue: 0,0:39:25.32,0:39:26.26,JP,,0000,0000,0000,,Azcat
Dialogue: 0,0:39:26.99,0:39:27.59,JP,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:39:28.58,0:39:29.83,JP,,0000,0000,0000,,Жапон тілі жоқ
Dialogue: 0,0:39:30.09,0:39:30.85,JP,,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:39:32.99,0:39:35.43,JP,,0000,0000,0000,,Ағылшын тіліндегі Azcat ұшағындағы тағам
Dialogue: 0,0:39:35.43,0:39:36.73,JP,,0000,0000,0000,,Ұшу тамағы
Dialogue: 0,0:39:37.09,0:39:38.80,JP,,0000,0000,0000,,Тауық немесе сиыр еті
Dialogue: 0,0:39:40.50,0:39:41.62,JP,,0000,0000,0000,,Жаттығулар
Dialogue: 0,0:39:43.44,0:39:44.87,JP,,0000,0000,0000,,Тауық етіңіз
Dialogue: 0,0:39:45.20,0:39:46.91,JP,,0000,0000,0000,,Бұл сол адам үшін бірдеңе жасағың келуі туралы—
Dialogue: 0,0:39:47.42,0:39:49.11,JP,,0000,0000,0000,,Ал мен
Dialogue: 0,0:39:49.97,0:39:51.59,JP,,0000,0000,0000,,Тауық немесе сиыр еті
Dialogue: 0,0:39:52.23,0:39:53.60,JP,,0000,0000,0000,,Сиыр еті өтінемін
Dialogue: 0,0:39:53.96,0:39:54.98,JP,,0000,0000,0000,,Бұл сол адам үшін бірдеңе жасағың келуі туралы—
Dialogue: 0,0:39:55.19,0:39:56.09,JP,,0000,0000,0000,,Тұтынушы
Dialogue: 0,0:39:56.09,0:39:57.14,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:39:56.80,0:39:59.63,JP,,0000,0000,0000,,Сізге қайсысы ұнайды: жапондық тағам немесе батыс тағамы?
Dialogue: 0,0:40:26.64,0:40:28.46,JP,,0000,0000,0000,,О, Азунян Азунян
Dialogue: 0,0:40:36.35,0:40:39.35,JP,,0000,0000,0000,,Дұрыс, Азунянның лирикасы туралы ойланып көрейік.
Dialogue: 0,0:41:12.53,0:41:15.81,JP,,0000,0000,0000,,Бұл не? Дүние жүзі бойынша
Dialogue: 0,0:41:21.03,0:41:22.99,JP,,0000,0000,0000,,Азунян, мен бірдеңені көрдім
Dialogue: 0,0:41:23.41,0:41:24.89,JP,,0000,0000,0000,,Иә, жоқ
Dialogue: 0,0:41:28.77,0:41:29.48,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:41:29.67,0:41:31.79,JP,,0000,0000,0000,,Аа, бірдеңе жаздыңыз ба?
Dialogue: 0,0:41:32.28,0:41:36.00,JP,,0000,0000,0000,,Ах, менің болашақ өмір салтым туралы.
Dialogue: 0,0:41:37.11,0:41:40.35,JP,,0000,0000,0000,,Мен...Мен көп нәрсені ойлауым керек.
Dialogue: 0,0:41:42.49,0:41:45.40,JP,,0000,0000,0000,,Хехехе жақсы соққы
Dialogue: 0,0:41:58.36,0:41:59.35,JP,,0000,0000,0000,,Мен қызық...
Dialogue: 0,0:42:00.22,0:42:02.38,JP,,0000,0000,0000,,Қазір сонша кеш екеніне сене алар емеспін.
Dialogue: 0,0:42:02.53,0:42:06.02,JP,,0000,0000,0000,,Сіз шынымен сабақтан кейінгі шай уақытының бағытын өзгертуді жоспарлап отырсыз ба?
Dialogue: 0,0:42:06.87,0:42:11.66,JP,,0000,0000,0000,,Немесе сіз шынымен бағаны қайталап, болашағыңызды ойлауыңыз керек шығар.
Dialogue: 0,0:42:12.74,0:42:16.40,JP,,0000,0000,0000,,Заңсыз және үлкен рок аға кім?
Dialogue: 0,0:42:18.31,0:42:18.98,JP,,0000,0000,0000,,Пу
Dialogue: 0,0:42:23.22,0:42:24.81,JP,,0000,0000,0000,,Азунян оянады
Dialogue: 0,0:42:25.95,0:42:26.78,JP,,0000,0000,0000,,Мен келемін
Dialogue: 0,0:42:38.56,0:42:41.34,JP,,0000,0000,0000,,Англия қазірдің өзінде осында Англия
Dialogue: 0,0:42:43.77,0:42:45.54,JP,,0000,0000,0000,,Бұл таңқаларлық жылдам болды.
Dialogue: 0,0:42:45.54,0:42:49.31,JP,,0000,0000,0000,,Эй, бұл керемет. Ол халықаралық жігіт. Ол ауада ұшты.
Dialogue: 0,0:42:49.31,0:42:50.92,JP,,0000,0000,0000,,Сенпай, сабыр ет!
Dialogue: 0,0:42:50.92,0:42:52.44,JP,,0000,0000,0000,,Бұл шынымен де келді
Dialogue: 0,0:42:52.51,0:42:54.06,JP,,0000,0000,0000,,Келесі - иммиграциялық тексеру.
Dialogue: 0,0:42:54.06,0:42:55.04,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:42:55.30,0:42:58.81,JP,,0000,0000,0000,,Иә, көбіне сапарыңыздың мақсатын сұрайтын сияқты.
Dialogue: 0,0:42:59.05,0:43:00.56,JP,,0000,0000,0000,,О, мақсат.
Dialogue: 0,0:43:00.87,0:43:04.30,JP,,0000,0000,0000,,Иә, «көрікті жерлерді аралау» деп жауап беріңіз, сонда бәрі жақсы болады.
Dialogue: 0,0:43:04.37,0:43:05.39,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:43:06.08,0:43:07.27,JP,,0000,0000,0000,,Қосымша бизнес
Dialogue: 0,0:43:07.59,0:43:08.78,JP,,0000,0000,0000,,Қосымша бизнес
Dialogue: 0,0:43:09.00,0:43:09.77,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:43:10.52,0:43:11.24,JP,,0000,0000,0000,,I Иса
Dialogue: 0,0:43:11.37,0:43:12.33,JP,,0000,0000,0000,,Төрт күн
Dialogue: 0,0:43:12.59,0:43:15.74,JP,,0000,0000,0000,,Иә, мен он жетімін
Dialogue: 0,0:43:21.97,0:43:25.33,JP,,0000,0000,0000,,Ақыры Гитамен таныстым, енді жеңілдеп қалдым.
Dialogue: 0,0:43:25.33,0:43:28.89,JP,,0000,0000,0000,,Бірақ сабырмен ойласаң, неге әкелдің?
Dialogue: 0,0:43:29.03,0:43:31.13,JP,,0000,0000,0000,,Мио, менің жүгім келді.
Dialogue: 0,0:43:31.54,0:43:32.37,JP,,0000,0000,0000,,Өміріңде —
Dialogue: 0,0:43:32.82,0:43:33.86,JP,,0000,0000,0000,,Әлі жоқ
Dialogue: 0,0:43:33.86,0:43:35.26,JP,,0000,0000,0000,,Жақында келеді.
Dialogue: 0,0:43:35.36,0:43:36.20,JP,,0000,0000,0000,,Иә...
Dialogue: 0,0:43:39.35,0:43:41.34,JP,,0000,0000,0000,,Бұл шынымен де шықпайды.
Dialogue: 0,0:43:42.12,0:43:43.74,JP,,0000,0000,0000,,Неге тек мен?
Dialogue: 0,0:43:44.43,0:43:46.01,JP,,0000,0000,0000,,Қызық, кетті ме?
Dialogue: 0,0:43:46.42,0:43:50.01,JP,,0000,0000,0000,,Акияма-санның ханым ретіндегі шалбары
Dialogue: 0,0:43:50.41,0:43:52.51,JP,,0000,0000,0000,,Мио-чан өтпелі адам, солай ма?
Dialogue: 0,0:43:52.51,0:43:55.05,JP,,0000,0000,0000,,Иә, ол труси киген жоқ.
Dialogue: 0,0:43:55.05,0:43:57.61,JP,,0000,0000,0000,,Бұл ұйықтаған кездегі шұлық туралы.
Dialogue: 0,0:43:57.62,0:43:59.42,JP,,0000,0000,0000,,А, ана жерде.
Dialogue: 0,0:43:59.58,0:44:00.82,JP,,0000,0000,0000,,Аа, бұл рас.
Dialogue: 0,0:44:01.62,0:44:03.89,JP,,0000,0000,0000,,Маған біреу сақтап қойған ба деп ойлаймын.
Dialogue: 0,0:44:03.89,0:44:05.59,JP,,0000,0000,0000,,Таңғыш Бұл ер адам.
Dialogue: 0,0:44:05.76,0:44:07.50,JP,,0000,0000,0000,,Сізге жақсы
Dialogue: 0,0:44:09.52,0:44:10.64,JP,,0000,0000,0000,,Уау, суық.
Dialogue: 0,0:44:10.65,0:44:12.16,JP,,0000,0000,0000,,Лондонда күн суық.
Dialogue: 0,0:44:13.80,0:44:15.00,JP,,0000,0000,0000,,О, Лондон аспаны
Dialogue: 0,0:44:15.85,0:44:17.13,JP,,0000,0000,0000,,Лондондағы таксилер
Dialogue: 0,0:44:18.39,0:44:19.64,JP,,0000,0000,0000,,Лондон ағылшын тілі
Dialogue: 0,0:44:20.36,0:44:22.25,JP,,0000,0000,0000,,Біз Лондондамыз
Dialogue: 0,0:44:23.53,0:44:24.22,JP,,0000,0000,0000,,Эй
Dialogue: 0,0:44:25.20,0:44:26.60,JP,,0000,0000,0000,,Такси
Dialogue: 0,0:44:26.74,0:44:27.65,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:44:28.05,0:44:28.85,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:44:29.14,0:44:34.63,JP,,0000,0000,0000,,Білесің бе, әкем Лондонда такси есігін өзі ашатынын айтты.
Dialogue: 0,0:44:34.68,0:44:35.50,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:44:35.58,0:44:37.16,JP,,0000,0000,0000,,Оның тұтқасы жоқ.
Dialogue: 0,0:44:37.54,0:44:39.43,JP,,0000,0000,0000,,Бұл автоматты қақпа емес.
Dialogue: 0,0:44:39.79,0:44:41.48,JP,,0000,0000,0000,,Риччаннан сұраңыз.
Dialogue: 0,0:44:43.41,0:44:45.95,JP,,0000,0000,0000,,Дұрыс...осылай
Dialogue: 0,0:44:45.95,0:44:47.64,JP,,0000,0000,0000,,Міне, жүктеріңізді сол жерге қойыңыз
Dialogue: 0,0:44:47.64,0:44:48.62,JP,,0000,0000,0000,,О, балалар
Dialogue: 0,0:44:50.08,0:44:50.98,JP,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:44:51.40,0:44:54.37,JP,,0000,0000,0000,,Киім... A Hotel Ibis, өтінемін
Dialogue: 0,0:44:54.69,0:44:56.76,JP,,0000,0000,0000,,Иә, Ібис. Қайсысы
Dialogue: 0,0:44:57.18,0:44:59.30,JP,,0000,0000,0000,,Қайда екенін сұрағандай.
Dialogue: 0,0:44:59.51,0:45:02.97,JP,,0000,0000,0000,,Лондон қайда, солай ма?
Dialogue: 0,0:45:03.17,0:45:04.72,JP,,0000,0000,0000,,Лондонның әзілдері
Dialogue: 0,0:45:04.74,0:45:05.97,JP,,0000,0000,0000,,Лондон қаласы
Dialogue: 0,0:45:06.21,0:45:07.33,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:45:07.80,0:45:09.21,JP,,0000,0000,0000,,Артқа қарау
Dialogue: 0,0:45:09.21,0:45:10.32,JP,,0000,0000,0000,,Біртүрлі сезім
Dialogue: 0,0:45:12.90,0:45:14.73,JP,,0000,0000,0000,,Әй, сенпай, жақсысың ба?
Dialogue: 0,0:45:15.12,0:45:16.21,JP,,0000,0000,0000,,Кешіріңіз Юи
Dialogue: 0,0:45:16.21,0:45:18.08,JP,,0000,0000,0000,,Өйткені мен оны кенет жауып тастадым.
Dialogue: 0,0:45:18.29,0:45:22.73,JP,,0000,0000,0000,,Жарайды, жарайды, Муги-чан жұмсақ болды, мен құтқарылдым.
Dialogue: 0,0:45:22.80,0:45:23.79,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:45:24.53,0:45:26.64,JP,,0000,0000,0000,,Жоқ, жоқ, мен таң қалдым.
Dialogue: 0,0:45:26.99,0:45:29.16,JP,,0000,0000,0000,,Бұл сызық.
Dialogue: 0,0:45:29.74,0:45:31.51,JP,,0000,0000,0000,,Шет елден күткендей.
Dialogue: 0,0:45:42.02,0:45:47.41,JP,,0000,0000,0000,,Рон Рон Рон Рон До Даун Ахахаха...
Dialogue: 0,0:45:50.98,0:45:52.77,JP,,0000,0000,0000,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:45:54.36,0:45:57.90,JP,,0000,0000,0000,,Артқа қарасам... сәл қиын...
Dialogue: 0,0:45:58.20,0:45:59.78,JP,,0000,0000,0000,,Юй Чан, бәрі жақсы.
Dialogue: 0,0:45:59.78,0:46:01.59,JP,,0000,0000,0000,,Мен жақсымын, мен жақсымын, а...
Dialogue: 0,0:46:01.96,0:46:04.03,JP,,0000,0000,0000,,Ал, мен біраз отыра аламын ба?
Dialogue: 0,0:46:06.27,0:46:07.36,JP,,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:46:08.42,0:46:09.68,JP,,0000,0000,0000,,Кешкі асқа не жеу керек?
Dialogue: 0,0:46:09.99,0:46:11.28,JP,,0000,0000,0000,,Иә, кешкі ас.
Dialogue: 0,0:46:11.87,0:46:15.62,JP,,0000,0000,0000,,Қуырылған сиыр еті жақсы, ал балмұздақ
Dialogue: 0,0:46:15.98,0:46:17.66,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:17.66,0:46:19.16,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:46:20.29,0:46:22.42,JP,,0000,0000,0000,,Қонақ үй брондалмаған сияқты.
Dialogue: 0,0:46:22.93,0:46:24.24,JP,,0000,0000,0000,,Бұл сіздің түнеуге болмайды дегенді білдіре ме?
Dialogue: 0,0:46:24.85,0:46:26.23,JP,,0000,0000,0000,,Табиғаттағы лагерь
Dialogue: 0,0:46:27.19,0:46:28.28,JP,,0000,0000,0000,,Мен не істеуім керек...
Dialogue: 0,0:46:28.46,0:46:29.52,JP,,0000,0000,0000,,Соны көрейін бе?
Dialogue: 0,0:46:30.23,0:46:31.30,JP,,0000,0000,0000,,I Иә
Dialogue: 0,0:46:35.86,0:46:38.66,JP,,0000,0000,0000,,Сіз Ibis Earl сотына тапсырыс бердіңіз
Dialogue: 0,0:46:39.36,0:46:40.64,JP,,0000,0000,0000,,Эрл соты
Dialogue: 0,0:46:41.23,0:46:44.15,JP,,0000,0000,0000,,Иә Бұл Ibis London City.
Dialogue: 0,0:46:44.50,0:46:46.75,JP,,0000,0000,0000,,Біздің Лондонда көптеген орындар бар
Dialogue: 0,0:46:46.95,0:46:48.37,JP,,0000,0000,0000,,Муги-сенпай, не?
Dialogue: 0,0:46:49.41,0:46:50.35,JP,,0000,0000,0000,,Бұл жылдам.
Dialogue: 0,0:46:50.35,0:46:51.11,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:46:51.61,0:46:54.70,JP,,0000,0000,0000,,Бұл қонақүй...Қалада бірнеше бар деп естідім.
Dialogue: 0,0:46:54.84,0:46:55.96,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:46:56.09,0:47:00.38,JP,,0000,0000,0000,,Олар Эрл соты деп аталатын жерде тапсырыстар алып жатқан сияқты.
Dialogue: 0,0:47:00.58,0:47:02.71,JP,,0000,0000,0000,,Бұл тамаша.
Dialogue: 0,0:47:02.97,0:47:04.93,JP,,0000,0000,0000,,Жарайды, рахмет.
Dialogue: 0,0:47:04.93,0:47:07.24,JP,,0000,0000,0000,,Қош келдіңіздер, күндеріңіз сәтті өтсін
Dialogue: 0,0:47:08.62,0:47:10.94,JP,,0000,0000,0000,,Ум, Эрл соты...
Dialogue: 0,0:47:11.19,0:47:12.90,JP,,0000,0000,0000,,Бұл осында болды.
Dialogue: 0,0:47:13.59,0:47:15.38,JP,,0000,0000,0000,,Себебі мен қазір осындамын...
Dialogue: 0,0:47:15.62,0:47:19.01,JP,,0000,0000,0000,,Бұл өте алыс. Мен тағы такси ұстаймын.
Dialogue: 0,0:47:19.10,0:47:21.42,JP,,0000,0000,0000,,Юи Моккайдың ұшып бара жатқанын көресіз бе?
Dialogue: 0,0:47:21.45,0:47:23.26,JP,,0000,0000,0000,,Менің де сонда отырғым келеді.
Dialogue: 0,0:47:23.75,0:47:26.50,JP,,0000,0000,0000,,Әй, қызық, автобуспен немесе бір нәрсемен барамыз ба?
Dialogue: 0,0:47:26.50,0:47:27.74,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:47:30.38,0:47:32.23,JP,,0000,0000,0000,,Түсіндім, Мио-сенпай.
Dialogue: 0,0:47:32.68,0:47:34.67,JP,,0000,0000,0000,,Мен ол жерге тікелей бара алмаймын деп ойлаймын.
Dialogue: 0,0:47:35.24,0:47:36.18,JP,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:47:36.86,0:47:39.74,JP,,0000,0000,0000,,Әй, метро болса, мен оған бір-ақ барамын деп ойлаймын.
Dialogue: 0,0:47:41.77,0:47:43.25,JP,,0000,0000,0000,,Азунянға не болды?
Dialogue: 0,0:47:43.75,0:47:47.45,JP,,0000,0000,0000,,Мм... Мен мұнда жаңа аяқ киіммен келдім.
Dialogue: 0,0:47:47.98,0:47:49.43,JP,,0000,0000,0000,,Менің аяғым ауырады.
Dialogue: 0,0:47:49.98,0:47:50.89,JP,,0000,0000,0000,,Біраз
Dialogue: 0,0:47:50.89,0:47:52.16,JP,,0000,0000,0000,,Сіздің аяқ киіміңіз тайып кетті ме?
Dialogue: 0,0:47:52.39,0:47:53.93,JP,,0000,0000,0000,,Ол үнемі ауырады.
Dialogue: 0,0:47:53.93,0:47:56.43,JP,,0000,0000,0000,,Жоқ, әйтеуір қазірден.
Dialogue: 0,0:47:57.90,0:48:00.41,JP,,0000,0000,0000,,Ал, енді жаңа аяқ киім алайық.
Dialogue: 0,0:48:00.41,0:48:01.79,JP,,0000,0000,0000,,Е, жоқ, жоқ
Dialogue: 0,0:48:01.79,0:48:05.03,JP,,0000,0000,0000,,Барлығы шаршады, бірақ бізде де жүк бар.
Dialogue: 0,0:48:05.30,0:48:06.94,JP,,0000,0000,0000,,Онда мен осында барғым келеді.
Dialogue: 0,0:48:07.34,0:48:08.36,JP,,0000,0000,0000,,Қай жерде
Dialogue: 0,0:48:08.36,0:48:11.08,JP,,0000,0000,0000,,Бұл жерде тас киім бар сияқты.
Dialogue: 0,0:48:12.49,0:48:13.64,JP,,0000,0000,0000,,Жақсы Азуса
Dialogue: 0,0:48:29.35,0:48:31.04,JP,,0000,0000,0000,,Азунян қозғалады
Dialogue: 0,0:48:36.30,0:48:39.19,JP,,0000,0000,0000,,Уау, бұл тамаша
Dialogue: 0,0:48:40.76,0:48:42.52,JP,,0000,0000,0000,,Мен Хаггитамен суретке түсуім керек.
Dialogue: 0,0:48:44.44,0:48:45.82,JP,,0000,0000,0000,,О...бұл
Dialogue: 0,0:48:45.82,0:48:48.34,JP,,0000,0000,0000,,Юй-чан, мен сенің жүгіңді мысық ретінде аламын.
Dialogue: 0,0:48:48.48,0:48:49.22,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:49.89,0:48:51.22,JP,,0000,0000,0000,,Ду Азунян
Dialogue: 0,0:48:51.74,0:48:53.46,JP,,0000,0000,0000,,Онда бәрі жақсы сияқты.
Dialogue: 0,0:48:53.89,0:48:55.82,JP,,0000,0000,0000,,Иә, қазір бәрі жақсы.
Dialogue: 0,0:48:56.33,0:48:57.50,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:48:57.50,0:48:59.51,JP,,0000,0000,0000,,Сен маған жақсы көрінесің, Азунян
Dialogue: 0,0:49:01.27,0:49:02.46,JP,,0000,0000,0000,,О, құдайым
Dialogue: 0,0:49:02.97,0:49:03.89,JP,,0000,0000,0000,,Суши
Dialogue: 0,0:49:04.79,0:49:06.15,JP,,0000,0000,0000,,Ах, конвейер суши.
Dialogue: 0,0:49:06.15,0:49:07.05,JP,,0000,0000,0000,,Бұрылыс
Dialogue: 0,0:49:07.44,0:49:08.09,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:49:08.16,0:49:09.37,JP,,0000,0000,0000,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:49:09.37,0:49:11.41,JP,,0000,0000,0000,,Муги Сіз ол жерде ешқашан болғансыз ба?
Dialogue: 0,0:49:11.41,0:49:13.30,JP,,0000,0000,0000,,Ал, кеттік.
Dialogue: 0,0:49:13.30,0:49:14.73,JP,,0000,0000,0000,,Мен Лондонға келгенше
Dialogue: 0,0:49:14.73,0:49:17.01,JP,,0000,0000,0000,,Жоқ, бұл Лондон болғандықтан.
Dialogue: 0,0:49:17.55,0:49:21.50,JP,,0000,0000,0000,,Орналастыруларыңызды қарап шығуға болады ма? Лондон
Dialogue: 0,0:49:24.82,0:49:25.92,JP,,0000,0000,0000,,Бұл не
Dialogue: 0,0:49:28.08,0:49:29.22,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:49:30.08,0:49:31.93,JP,,0000,0000,0000,,Бұл шынымен де сәнді нәрсе.
Dialogue: 0,0:49:32.08,0:49:34.97,JP,,0000,0000,0000,,Міне, айналады.
Dialogue: 0,0:49:35.12,0:49:38.13,JP,,0000,0000,0000,,Айналып жатыр... Менде жағымсыз сезім бар.
Dialogue: 0,0:49:38.77,0:49:41.23,JP,,0000,0000,0000,,Әуежайдағы жарақат қайта оралды ма?
Dialogue: 0,0:49:41.75,0:49:44.30,JP,,0000,0000,0000,,Бірақ бұл мен күткеннен сәл өзгеше.
Dialogue: 0,0:49:44.72,0:49:48.13,JP,,0000,0000,0000,,Мен сушиді балерина сияқты елестететінмін.
Dialogue: 0,0:49:48.24,0:49:49.68,JP,,0000,0000,0000,,Кейбір кезең...
Dialogue: 0,0:49:49.73,0:49:50.37,JP,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:49:51.58,0:49:53.51,JP,,0000,0000,0000,,Сіз Жапониядан келгенсіз
Dialogue: 0,0:49:54.09,0:49:56.92,JP,,0000,0000,0000,,Қайдан... дедім.
Dialogue: 0,0:49:57.73,0:49:59.57,JP,,0000,0000,0000,,деді Жапония.
Dialogue: 0,0:50:01.14,0:50:01.81,JP,,0000,0000,0000,,I Иә
Dialogue: 0,0:50:02.18,0:50:04.43,JP,,0000,0000,0000,,Мен осы мекеменің менеджерімін
Dialogue: 0,0:50:05.01,0:50:07.95,JP,,0000,0000,0000,,Сіз бүгін өнер көрсететін адамдарсыз, дұрыс
Dialogue: 0,0:50:08.33,0:50:12.06,JP,,0000,0000,0000,,Ум, м... Иса
Dialogue: 0,0:50:12.26,0:50:13.31,JP,,0000,0000,0000,,Биіктігі
Dialogue: 0,0:50:13.31,0:50:14.84,JP,,0000,0000,0000,,Менің суши барыма қош келдіңіз
Dialogue: 0,0:50:15.11,0:50:16.65,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:50:17.01,0:50:19.02,JP,,0000,0000,0000,,Иә деп оңай айтпаңыз
Dialogue: 0,0:50:19.68,0:50:22.03,JP,,0000,0000,0000,,Бірақ бұл жерде қуантарлық нәрсе бар.
Dialogue: 0,0:50:22.34,0:50:23.59,JP,,0000,0000,0000,,Осылай өтінемін.
Dialogue: 0,0:50:23.59,0:50:25.19,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:50:30.30,0:50:33.83,JP,,0000,0000,0000,,Бұл таңқаларлық. Лондондағы суши мейрамханаларында сіз бақытты киіммен тамақтанасыз.
Dialogue: 0,0:50:34.43,0:50:36.99,JP,,0000,0000,0000,,Якинику мейрамханасының алжапқышы сияқты ма?
Dialogue: 0,0:50:38.54,0:50:40.91,JP,,0000,0000,0000,,Жарайды Сахнаға шыққанды ұнатсаңыз
Dialogue: 0,0:50:46.34,0:50:47.30,JP,,0000,0000,0000,,Гита
Dialogue: 0,0:50:47.81,0:50:49.05,JP,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:50:49.74,0:50:50.70,JP,,0000,0000,0000,,Сондықтан ол қазірдің өзінде қаза тапқан болар деп ойлаймын.
Dialogue: 0,0:50:50.83,0:50:51.54,JP,,0000,0000,0000,,Муги-чан
Dialogue: 0,0:50:51.54,0:50:52.31,JP,,0000,0000,0000,,(Көрермен С) Отбасында осындай қарт адамның болуы – нағыз қорқынышты түс қой.
Dialogue: 0,0:50:55.75,0:50:57.14,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:51:01.97,0:51:06.92,JP,,0000,0000,0000,,Муги-чан, сен суши жеуге келдім деп бардың.
Dialogue: 0,0:51:07.25,0:51:10.13,JP,,0000,0000,0000,,Өйткені, бізде бидай болуы керек.
Dialogue: 0,0:51:10.13,0:51:11.08,JP,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:51:15.10,0:51:16.75,JP,,0000,0000,0000,,Не істеп жатырсың, Муги?
Dialogue: 0,0:51:17.00,0:51:18.78,JP,,0000,0000,0000,,Өйткені ол жоқ еді.
Dialogue: 0,0:51:19.21,0:51:22.03,JP,,0000,0000,0000,,Бұны маған қалдыр, эй сен.
Dialogue: 0,0:51:22.44,0:51:23.81,JP,,0000,0000,0000,,Мен Бучомын
Dialogue: 0,0:51:24.77,0:51:26.91,JP,,0000,0000,0000,,Біз Окакусанбыз
Dialogue: 0,0:51:27.10,0:51:28.98,JP,,0000,0000,0000,,Шимасен спектаклі
Dialogue: 0,0:51:28.98,0:51:31.85,JP,,0000,0000,0000,,Риччан, мен бар күшімді салып жатырмын, бірақ бұл негізінен жапондықтар.
Dialogue: 0,0:51:32.86,0:51:34.56,JP,,0000,0000,0000,,Риччан тағы бір итермеледі
Dialogue: 0,0:51:35.40,0:51:41.18,JP,,0000,0000,0000,,А...Мен...А...Мен сушиді жақсы көремін
Dialogue: 0,0:51:42.83,0:51:44.29,JP,,0000,0000,0000,,Ғажайып Лондон
Dialogue: 0,0:51:45.91,0:51:49.00,JP,,0000,0000,0000,,Рикчан, сен әлі маған қарап тұрсың ба?
Dialogue: 0,0:51:49.15,0:51:51.32,JP,,0000,0000,0000,,Мен бәрібір қашып құтыла алмаймын деп ойлаймын.
Dialogue: 0,0:51:52.55,0:51:55.03,JP,,0000,0000,0000,,Менің бәрібір істеуден басқа амалым жоқ.
Dialogue: 0,0:51:55.60,0:51:57.52,JP,,0000,0000,0000,,Иә, әйтпесе
Dialogue: 0,0:51:57.63,0:51:59.87,JP,,0000,0000,0000,,Маған суши жеуге рұқсат етілмеуі мүмкін.
Dialogue: 0,0:51:59.99,0:52:03.10,JP,,0000,0000,0000,,Суши жеу үшін мұндай тексеру қажет пе?
Dialogue: 0,0:52:03.26,0:52:04.15,JP,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:52:04.33,0:52:05.55,JP,,0000,0000,0000,,Юидің несі жақсы?
Dialogue: 0,0:52:07.84,0:52:11.99,JP,,0000,0000,0000,,ой-оу
Dialogue: 0,0:52:16.80,0:52:18.02,JP,,0000,0000,0000,,«Карри, содан кейін күріш».
Dialogue: 0,0:52:18.38,0:52:19.56,JP,,0000,0000,0000,,Бұл суши мейрамханасы болса да
Dialogue: 0,0:52:19.66,0:52:21.40,JP,,0000,0000,0000,,кешкі ас
Dialogue: 0,0:52:21.73,0:52:23.27,JP,,0000,0000,0000,,Ах
Dialogue: 0,0:52:23.84,0:52:26.59,JP,,0000,0000,0000,,Сондай-ақ, ол жақсы адам сияқты.
Dialogue: 0,0:52:26.91,0:52:27.58,JP,,0000,0000,0000,,болып табылады
Dialogue: 0,0:52:36.14,0:52:36.94,JP,,0000,0000,0000,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:52:37.40,0:52:38.57,JP,,0000,0000,0000,,Бұл қандай ақша?
Dialogue: 0,0:52:38.87,0:52:40.47,JP,,0000,0000,0000,,Оны артта қалдырмаңыз
Dialogue: 0,0:52:40.57,0:52:44.86,JP,,0000,0000,0000,,Уау Уау... Кешіріңіз, кешіріңіз, мен толқып тұрмын...
Dialogue: 0,0:52:46.56,0:52:48.72,JP,,0000,0000,0000,,Әйтеуір, мен асығуым керек.
Dialogue: 0,0:52:50.66,0:52:53.82,JP,,0000,0000,0000,,Аа Азунян, мен өзімді жарты қадам қалдырғандай сезінемін.
Dialogue: 0,0:52:53.82,0:52:55.75,JP,,0000,0000,0000,,Баптауға кеткен уақыт
Dialogue: 0,0:52:56.40,0:52:58.13,JP,,0000,0000,0000,,Үлкеннің дыбысын сәйкестендіріңіз
Dialogue: 0,0:53:20.38,0:53:22.34,JP,,0000,0000,0000,,Бір екі бір екі үш төрт
Dialogue: 0,0:53:27.09,0:53:29.24,JP,,0000,0000,0000,,Сәлеметсіз бе, сабақтан кейін шай уақыты.
Dialogue: 0,0:54:32.43,0:54:35.74,JP,,0000,0000,0000,,Аригатогозаимашита рахмет
Dialogue: 0,0:54:35.74,0:54:36.90,JP,,0000,0000,0000,,Керемет
Dialogue: 0,0:54:36.90,0:54:37.92,JP,,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:54:38.18,0:54:39.29,JP,,0000,0000,0000,,Күріш
Dialogue: 0,0:54:39.52,0:54:43.62,JP,,0000,0000,0000,,Рақмет, рахмет, ол суши.
Dialogue: 0,0:54:43.62,0:54:45.95,JP,,0000,0000,0000,,Рахмет сізге Love Crycis
Dialogue: 0,0:54:47.31,0:54:50.63,JP,,0000,0000,0000,,Әй, ол соңында не деді?
Dialogue: 0,0:54:51.07,0:54:53.43,JP,,0000,0000,0000,,Сіз «махаббат дағдарысы» дедіңіз
Dialogue: 0,0:54:55.01,0:54:57.41,JP,,0000,0000,0000,,Бұл есімді бұрын бір жерден естігенмін.
Dialogue: 0,0:54:57.66,0:54:59.85,JP,,0000,0000,0000,,Атричанның досының тобы
Dialogue: 0,0:55:00.03,0:55:00.95,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:55:02.29,0:55:06.52,JP,,0000,0000,0000,,Сонда Рикчанның досы Жапонияның махаббат дағдарысы, солай ма?
Dialogue: 0,0:55:07.67,0:55:10.61,JP,,0000,0000,0000,,Өйткені иіру жақсы емес...
Dialogue: 0,0:55:11.38,0:55:15.85,JP,,0000,0000,0000,,Қазір... Қарным ашты.
Dialogue: 0,0:55:16.47,0:55:17.50,JP,,0000,0000,0000,,Оны айтпа
Dialogue: 0,0:55:17.75,0:55:19.05,JP,,0000,0000,0000,,Мен айттым.
Dialogue: 0,0:55:19.21,0:55:20.84,JP,,0000,0000,0000,,Суши
Dialogue: 0,0:55:21.07,0:55:22.72,JP,,0000,0000,0000,,Мен оны жегім келеді.
Dialogue: 0,0:55:22.83,0:55:25.96,JP,,0000,0000,0000,,Алайда... қайта кіруге батылым жетпейді.
Dialogue: 0,0:55:27.41,0:55:31.34,JP,,0000,0000,0000,,Әй, бәрі ойнап болған соң тамақ ішеді ме екен.
Dialogue: 0,0:55:33.48,0:55:36.21,JP,,0000,0000,0000,,Әзірше кедергі болады, енді бір жерге барайық.
Dialogue: 0,0:55:36.31,0:55:37.27,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:55:37.87,0:55:41.06,JP,,0000,0000,0000,,Қалай болғанда да, бұл суши мейрамханасы қандай болды?
Dialogue: 0,0:55:41.20,0:55:43.40,JP,,0000,0000,0000,,Ах, Риччан, Мио-чан
Dialogue: 0,0:55:43.40,0:55:44.52,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:55:44.52,0:55:46.99,JP,,0000,0000,0000,,Сапарыңызда сізді не таң қалдырды?
Dialogue: 0,0:55:46.99,0:55:49.10,JP,,0000,0000,0000,,IACE Sightseeing
Dialogue: 0,0:55:49.10,0:55:50.77,JP,,0000,0000,0000,,Хаха, бәріміз келдік.
Dialogue: 0,0:55:50.77,0:55:52.40,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:55:53.74,0:55:56.19,JP,,0000,0000,0000,,О, құдай, мен ағылшынша сөйлей аламын.
Dialogue: 0,0:55:56.19,0:55:58.06,JP,,0000,0000,0000,,Бірақ екінші адам жапон...
Dialogue: 0,0:55:59.81,0:56:00.97,JP,,0000,0000,0000,,Маки-чан
Dialogue: 0,0:56:01.24,0:56:02.80,JP,,0000,0000,0000,,Жапонияның махаббат дағдарысы
Dialogue: 0,0:56:03.01,0:56:06.66,JP,,0000,0000,0000,,Е, неге, неге, неге келдің?
Dialogue: 0,0:56:07.08,0:56:08.67,JP,,0000,0000,0000,,Мен түсінбеймін
Dialogue: 0,0:56:10.36,0:56:11.33,JP,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:56:11.58,0:56:15.33,JP,,0000,0000,0000,,Мен суши жегелі тұрғанымда, маған музыка ойнауды өтінді.
Dialogue: 0,0:56:15.33,0:56:18.60,JP,,0000,0000,0000,,Ойнап болған соң суши жей алмадым.
Dialogue: 0,0:56:18.60,0:56:20.51,JP,,0000,0000,0000,,Шаршадым ба деп ойлаймын.
Dialogue: 0,0:56:20.51,0:56:21.81,JP,,0000,0000,0000,,Иә? Солай ма?
Dialogue: 0,0:56:22.11,0:56:25.97,JP,,0000,0000,0000,,Біз ашылуды тойлау үшін осында өнер көрсетеміз.
Dialogue: 0,0:56:26.22,0:56:30.19,JP,,0000,0000,0000,,Әй, бізді махаббат дағдарысы деп қателестік.
Dialogue: 0,0:56:30.43,0:56:32.33,JP,,0000,0000,0000,,Муги-чан күткендей, керемет пайымдау
Dialogue: 0,0:56:32.86,0:56:34.58,JP,,0000,0000,0000,,Каваками мырза есімде.
Dialogue: 0,0:56:34.92,0:56:36.09,JP,,0000,0000,0000,,Тұрғын үй
Dialogue: 0,0:56:36.38,0:56:39.04,JP,,0000,0000,0000,,Иә, мені Каваками мырза таныстырды.
Dialogue: 0,0:56:39.77,0:56:42.22,JP,,0000,0000,0000,,Бұл жерде менеджерді танитын сияқты.
Dialogue: 0,0:56:43.85,0:56:46.58,JP,,0000,0000,0000,,Дүниенің кішігірім болуының да шегі бар.
Dialogue: 0,0:56:46.95,0:56:48.87,JP,,0000,0000,0000,,Мен біртүрлі нәрсені сезіндім.
Dialogue: 0,0:56:48.94,0:56:50.44,JP,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:56:50.55,0:56:52.76,JP,,0000,0000,0000,,Суши мейрамханасындағы адам әлі де дұрыс түсінбеді.
Dialogue: 0,0:56:52.89,0:56:55.35,JP,,0000,0000,0000,,Аа, дұрыс, мен ішке кіріп жатырмын.
Dialogue: 0,0:56:55.58,0:56:56.93,JP,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:56:57.03,0:56:58.25,JP,,0000,0000,0000,,Көріскенше сау болыңыз
Dialogue: 0,0:56:59.41,0:57:01.07,JP,,0000,0000,0000,,Тамаша, салқын таң, иә?
Dialogue: 0,0:57:02.04,0:57:02.81,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:57:06.40,0:57:08.89,JP,,0000,0000,0000,,Ақыры тіркеле алдыңыз.
Dialogue: 0,0:57:10.32,0:57:13.72,JP,,0000,0000,0000,,Екеуміз жалғыз қалдық, Азу-нян.
Dialogue: 0,0:57:14.36,0:57:16.40,JP,,0000,0000,0000,,Иә, еңбегіңіз үшін рахмет.
Dialogue: 0,0:57:16.70,0:57:20.75,JP,,0000,0000,0000,,Менің қарным ашты. Мен ваннаға түскім келеді.
Dialogue: 0,0:57:20.92,0:57:23.20,JP,,0000,0000,0000,,Иә, суық болды.
Dialogue: 0,0:57:26.21,0:57:28.47,JP,,0000,0000,0000,,Кешкі асқа не жеу керек?
Dialogue: 0,0:57:31.56,0:57:32.93,JP,,0000,0000,0000,,Сонымен, бұл?
Dialogue: 0,0:57:34.37,0:57:36.05,JP,,0000,0000,0000,,Ю-чанға рахмет
Dialogue: 0,0:57:36.74,0:57:39.02,JP,,0000,0000,0000,,Мен қайтып келгенде бір нәрсе үшін сізге алғыс айтуым керек.
Dialogue: 0,0:57:39.02,0:57:41.87,JP,,0000,0000,0000,,Бірақ мен мұны микротолқынды пешсіз жей алмаймын.
Dialogue: 0,0:57:43.43,0:57:46.05,JP,,0000,0000,0000,,Сіз үлкендер бөлмесінде не істеп жүрдіңіз?
Dialogue: 0,0:57:46.46,0:57:47.93,JP,,0000,0000,0000,,Бұл естелік сурет.
Dialogue: 0,0:57:48.03,0:57:48.86,JP,,0000,0000,0000,,Формада
Dialogue: 0,0:57:49.02,0:57:51.55,JP,,0000,0000,0000,,Сондықтан мен әкелдім.
Dialogue: 0,0:57:51.86,0:57:53.90,JP,,0000,0000,0000,,Өйткені сіз оңай бақыттысыз
Dialogue: 0,0:57:54.01,0:57:56.82,JP,,0000,0000,0000,,Мио-сенпай да дұрыс киінген.
Dialogue: 0,0:57:57.12,0:57:59.01,JP,,0000,0000,0000,,А, бұл сергітетін болды.
Dialogue: 0,0:57:59.48,0:58:01.98,JP,,0000,0000,0000,,Ui Сіз шынымен дайынсыз.
Dialogue: 0,0:58:02.19,0:58:03.88,JP,,0000,0000,0000,,Бұл мақтаныш
Dialogue: 0,0:58:06.50,0:58:07.34,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:58:08.03,0:58:09.81,JP,,0000,0000,0000,,Өрт сөнді
Dialogue: 0,0:58:09.95,0:58:10.47,JP,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:58:10.47,0:58:12.75,JP,,0000,0000,0000,,Юй-чан, маған трансформатор орнату керек.
Dialogue: 0,0:58:12.75,0:58:15.88,JP,,0000,0000,0000,,Енді жоқ, қорқынышты
Dialogue: 0,0:58:17.21,0:58:18.49,JP,,0000,0000,0000,,Кешкі ас ішіңіз
Dialogue: 0,0:58:18.84,0:58:19.53,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:58:24.00,0:58:26.20,JP,,0000,0000,0000,,Азунян, мен бағаны қайталадым.
Dialogue: 0,0:58:26.39,0:58:26.92,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:58:26.92,0:58:29.12,JP,,0000,0000,0000,,Бұдан былай біз сыныптаспыз.
Dialogue: 0,0:58:29.21,0:58:30.12,JP,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:58:30.12,0:58:31.26,JP,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:58:31.52,0:58:34.57,JP,,0000,0000,0000,,Олай болса, Юй-сенпайды қалай атайын?
Dialogue: 0,0:58:34.72,0:58:36.86,JP,,0000,0000,0000,,Менің ойымша, «Юй» жақсы.
Dialogue: 0,0:58:37.94,0:58:38.57,JP,,0000,0000,0000,,Тек...
Dialogue: 0,0:58:38.77,0:58:39.49,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:58:40.09,0:58:41.61,JP,,0000,0000,0000,,Юи...
Dialogue: 0,0:58:41.87,0:58:43.47,JP,,0000,0000,0000,,«Юй» қаттырақ
Dialogue: 0,0:58:43.96,0:58:46.05,JP,,0000,0000,0000,,Тек тоқтатыңыз!
Dialogue: 0,0:58:46.05,0:58:47.31,JP,,0000,0000,0000,,Осындай нәрсе
Dialogue: 0,0:58:47.50,0:58:49.19,JP,,0000,0000,0000,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:58:49.19,0:58:53.22,JP,,0000,0000,0000,,Өйткені мен енді сенің ағаң емеспін.
Dialogue: 0,0:58:53.22,0:58:57.12,JP,,0000,0000,0000,,Ол жерде жоқ. Ол жерде жоқ.
Dialogue: 0,0:59:14.05,0:59:15.24,JP,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:59:15.85,0:59:18.22,JP,,0000,0000,0000,,Ю... Юй-сенпай қорқынышты!
Dialogue: 0,0:59:23.60,0:59:25.00,JP,,0000,0000,0000,,Қайырлы түн.
Dialogue: 0,1:01:02.89,1:01:05.00,JP,,0000,0000,0000,,Бұл пайдалы болды.
Dialogue: 0,1:01:06.38,1:01:09.84,JP,,0000,0000,0000,,Ум, мен бір нәрсені көргім келеді.
Dialogue: 0,1:01:10.45,1:01:12.85,JP,,0000,0000,0000,,Менің ағам оны пәнаралық пьесада пайдаланды...
Dialogue: 0,1:01:13.18,1:01:14.71,JP,,0000,0000,0000,,Бұл Ричканның моласы.
Dialogue: 0,1:01:14.71,1:01:15.23,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:01:15.23,1:01:15.84,JP,,0000,0000,0000,,Эй
Dialogue: 0,1:01:16.25,1:01:19.21,JP,,0000,0000,0000,,Occult Lab-тың да өте жоғары қайталану мүмкіндігі бар.
Dialogue: 0,1:01:19.43,1:01:20.40,JP,,0000,0000,0000,,Бұл махаббат
Dialogue: 0,1:01:20.60,1:01:22.02,JP,,0000,0000,0000,,Бұл да көшірме
Dialogue: 0,1:01:22.45,1:01:24.30,JP,,0000,0000,0000,,Сіз көп жүрдіңіз!
Dialogue: 0,1:01:24.48,1:01:25.75,JP,,0000,0000,0000,,Демалайық па?
Dialogue: 0,1:01:26.21,1:01:29.49,JP,,0000,0000,0000,,Бұл жерде түстен кейінгі шай ішуге болатын жер бар екеніне сенімдімін...
Dialogue: 0,1:01:29.49,1:01:33.91,JP,,0000,0000,0000,,Түстен кейінгі шай Азунян Бұл біздің жанымыз
Dialogue: 0,1:01:34.57,1:01:36.96,JP,,0000,0000,0000,,Брондау қажет болды...
Dialogue: 0,1:01:49.52,1:01:51.28,JP,,0000,0000,0000,,Бұл үлкен.
Dialogue: 0,1:01:51.71,1:01:53.67,JP,,0000,0000,0000,,Айналып жатыр...
Dialogue: 0,1:01:54.83,1:01:55.96,JP,,0000,0000,0000,,Айналып жатыр...
Dialogue: 0,1:01:56.37,1:01:59.19,JP,,0000,0000,0000,,Тез мінейік, Муги-чан
Dialogue: 0,1:01:59.19,1:01:59.99,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:01:59.99,1:02:01.41,JP,,0000,0000,0000,,Сәлем Мио Чан
Dialogue: 0,1:02:01.78,1:02:05.26,JP,,0000,0000,0000,,Төменгі қабаттағы барлығының жүктерін реттеймін.
Dialogue: 0,1:02:06.75,1:02:08.61,JP,,0000,0000,0000,,Олай болса, көңіл көтерейік.
Dialogue: 0,1:02:10.14,1:02:10.79,JP,,0000,0000,0000,,Мио...
Dialogue: 0,1:02:10.79,1:02:11.58,JP,,0000,0000,0000,,Мио-чан
Dialogue: 0,1:02:11.67,1:02:13.25,JP,,0000,0000,0000,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,1:02:13.25,1:02:15.80,JP,,0000,0000,0000,,Жоқ, айналдыру жақсы емес.
Dialogue: 0,1:02:16.00,1:02:18.51,JP,,0000,0000,0000,,Жарайды, бәрі сенімен бірге.
Dialogue: 0,1:02:18.51,1:02:19.80,JP,,0000,0000,0000,,Қатты Мио-чан
Dialogue: 0,1:02:19.80,1:02:21.30,JP,,0000,0000,0000,,Айналады
Dialogue: 0,1:02:21.44,1:02:24.71,JP,,0000,0000,0000,,Керемет! Сіз бүкіл Лондонды көре аласыз.
Dialogue: 0,1:02:25.10,1:02:26.78,JP,,0000,0000,0000,,Қарашы, Азуса, мынаны қара.
Dialogue: 0,1:02:25.74,1:02:27.64,JP,,0000,0000,0000,,Мио-чан көңілді жүрген сияқты
Dialogue: 0,1:02:26.93,1:02:28.62,JP,,0000,0000,0000,,Бұл театр немесе басқа нәрсе ме?
Dialogue: 0,1:02:27.63,1:02:30.86,JP,,0000,0000,0000,,Ендеше, мінсең, айналып тұрғанын көре алмайсың.
Dialogue: 0,1:02:31.12,1:02:34.59,JP,,0000,0000,0000,,Бұл таңқаларлық. Фотоға түсейік.
Dialogue: 0,1:02:36.34,1:02:38.96,JP,,0000,0000,0000,,А, Мио, мен жүктеріңді өзіңмен бірге алып кетемін.
Dialogue: 0,1:02:43.43,1:02:45.29,JP,,0000,0000,0000,,Риччан анау және анау
Dialogue: 0,1:02:49.68,1:02:52.54,JP,,0000,0000,0000,,Муги, тоқтаңыз.
Dialogue: 0,1:02:52.76,1:02:53.56,JP,,0000,0000,0000,,Yes
Dialogue: 0,1:02:53.56,1:02:54.82,JP,,0000,0000,0000,,Ол танымал болды
Dialogue: 0,1:02:57.07,1:02:58.07,JP,,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,1:02:58.28,1:02:59.36,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,1:02:59.36,1:03:00.71,JP,,0000,0000,0000,,Мен де сонда
Dialogue: 0,1:03:00.71,1:03:02.10,JP,,0000,0000,0000,,Азунян осында, солай ма?
Dialogue: 0,1:03:05.02,1:03:07.40,JP,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,1:03:15.16,1:03:17.29,JP,,0000,0000,0000,,Кешіріңіз, жақсысыз ба?
Dialogue: 0,1:03:17.50,1:03:21.65,JP,,0000,0000,0000,,Бірақ мен ол емеспін.
Dialogue: 0,1:03:22.30,1:03:23.79,JP,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:03:23.94,1:03:27.92,JP,,0000,0000,0000,,Мен Гитаны құшақтайын деп жатыр едім.
Dialogue: 0,1:03:30.96,1:03:34.07,JP,,0000,0000,0000,,Кешіріңіз, мен қате түсіндім. Кешіріңіз.
Dialogue: 0,1:03:35.17,1:03:41.38,JP,,0000,0000,0000,,Жоқ, жоқ... Қолыма түскен өзін-өзі қорғау кітабының пайдалы болғанына қуаныштымын.
Dialogue: 0,1:03:42.22,1:03:44.11,JP,,0000,0000,0000,,А, Азунян, ұйықта.
Dialogue: 0,1:03:44.90,1:03:49.65,JP,,0000,0000,0000,,Саған бесік жырын айтайын ба?
Dialogue: 0,1:03:51.38,1:03:59.35,JP,,0000,0000,0000,,Нененкорориё Окорири...
Dialogue: 0,1:03:53.76,1:03:55.40,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:04:11.13,1:04:14.44,JP,,0000,0000,0000,,Біз мұнда мұндай фотоларды көру үшін жиналмадық.
Dialogue: 0,1:04:15.36,1:04:18.94,JP,,0000,0000,0000,,Азуса-чанға оны жасаған адам берген ән туралы түсінік
Dialogue: 0,1:04:19.59,1:04:21.06,JP,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,1:04:21.87,1:04:27.15,JP,,0000,0000,0000,,Мен Лондонға келсем, ауқымды әндер ойлап таба аламын деп ойладым.
Dialogue: 0,1:04:28.12,1:04:28.88,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:04:29.64,1:04:34.45,JP,,0000,0000,0000,,Биг Бен, Лондон көз, Темза өзені және т.б.
Dialogue: 0,1:04:34.95,1:04:38.16,JP,,0000,0000,0000,,Бұл жай ғана әйгілі жерлерді айқайлау.
Dialogue: 0,1:04:38.55,1:04:42.55,JP,,0000,0000,0000,,Өйткені бұрын-соңды жасалмаған ғажайып әндер шығарғым келеді.
Dialogue: 0,1:04:43.03,1:04:46.11,JP,,0000,0000,0000,,Сол әнді біз кеткеннен кейін де тыңдасаң
Dialogue: 0,1:04:46.11,1:04:48.79,JP,,0000,0000,0000,,Мен мұны істейтін сияқтымын.
Dialogue: 0,1:04:48.79,1:04:50.38,JP,,0000,0000,0000,,Жеңілмейтін сияқты
Dialogue: 0,1:04:50.76,1:04:52.28,JP,,0000,0000,0000,,Жеңілмейтін бе?
Dialogue: 0,1:04:57.26,1:04:58.01,JP,,0000,0000,0000,,Не?
Dialogue: 0,1:04:59.94,1:05:03.27,JP,,0000,0000,0000,,Эй, мен бөлмемнің кілтін алып келуді ұмытып кетіппін.
Dialogue: 0,1:05:05.58,1:05:07.62,JP,,0000,0000,0000,,Ол жерден кете алмайсың ба?
Dialogue: 0,1:05:20.56,1:05:23.71,JP,,0000,0000,0000,,Бұл жолы шынында да бағдаршам...
Dialogue: 0,1:05:25.16,1:05:28.80,JP,,0000,0000,0000,,Содан кейін мен Азу-нянға қайтайын.
Dialogue: 0,1:05:29.03,1:05:30.96,JP,,0000,0000,0000,,А, кәмпит түсіп жатыр.
Dialogue: 0,1:05:31.24,1:05:33.95,JP,,0000,0000,0000,,А, мен саған беремін. Жеңдер.
Dialogue: 0,1:05:33.95,1:05:35.21,JP,,0000,0000,0000,,Қайырлы түн Юй Чан
Dialogue: 0,1:05:35.21,1:05:36.55,JP,,0000,0000,0000,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:05:36.63,1:05:37.97,JP,,0000,0000,0000,,Кез келген қолайлы адам
Dialogue: 0,1:05:40.34,1:05:43.51,JP,,0000,0000,0000,,Осы сағатта біреу көтеріле ме?
Dialogue: 0,1:05:49.46,1:05:51.42,JP,,0000,0000,0000,,Ха, Азуса келді. Азуса
Dialogue: 0,1:05:51.79,1:05:53.85,JP,,0000,0000,0000,,Сәлем, қош келдіңіз.
Dialogue: 0,1:05:53.85,1:05:55.00,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,1:05:55.31,1:05:56.34,JP,,0000,0000,0000,,Азуса-чан
Dialogue: 0,1:05:56.49,1:05:57.58,JP,,0000,0000,0000,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,1:06:07.17,1:06:08.87,JP,,0000,0000,0000,,А, сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,1:06:20.50,1:06:21.75,JP,,0000,0000,0000,,Риччан қатты
Dialogue: 0,1:06:22.10,1:06:23.41,JP,,0000,0000,0000,,өте қиын
Dialogue: 0,1:06:23.41,1:06:24.63,JP,,0000,0000,0000,,Юи тынышталсын
Dialogue: 0,1:06:24.63,1:06:25.86,JP,,0000,0000,0000,,Азунян жоқ
Dialogue: 0,1:06:25.86,1:06:27.03,JP,,0000,0000,0000,,Мен жаңа ғана келдім.
Dialogue: 0,1:06:27.95,1:06:29.28,JP,,0000,0000,0000,,Бірақ мен қайта оралдым
Dialogue: 0,1:06:29.37,1:06:30.21,JP,,0000,0000,0000,,Қалай
Dialogue: 0,1:06:36.90,1:06:38.57,JP,,0000,0000,0000,,Рицу-сенпай, бұл біртүрлі.
Dialogue: 0,1:06:38.57,1:06:39.61,JP,,0000,0000,0000,,А, мен ояндым.
Dialogue: 0,1:06:39.97,1:06:41.35,JP,,0000,0000,0000,,Аға Юи жоқ.
Dialogue: 0,1:06:45.02,1:06:48.69,JP,,0000,0000,0000,,Риччан, ол жерде жоқ. Бұл өте қиын.
Dialogue: 0,1:06:48.69,1:06:52.71,JP,,0000,0000,0000,,Қатты, Азу-нян, Азу-нян мұнда жоқ.
Dialogue: 0,1:06:53.17,1:06:54.86,JP,,0000,0000,0000,,О, міне сен.
Dialogue: 0,1:06:54.86,1:06:55.84,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:06:55.96,1:06:59.01,JP,,0000,0000,0000,,Сіз қайда бардыңыз? Мен уайымдадым.
Dialogue: 0,1:06:59.01,1:07:00.45,JP,,0000,0000,0000,,Жоқ, бұл
Dialogue: 0,1:07:02.50,1:07:03.32,JP,,0000,0000,0000,,Бұл оңай-ақ өзгертіле қоймайды.
Dialogue: 0,1:07:03.61,1:07:04.72,JP,,0000,0000,0000,,Қайдан
Dialogue: 0,1:07:04.84,1:07:06.13,JP,,0000,0000,0000,,Мүмкін майданнан шығар?
Dialogue: 0,1:07:06.13,1:07:07.30,JP,,0000,0000,0000,,Түн ортасында осылай
Dialogue: 0,1:07:07.68,1:07:08.98,JP,,0000,0000,0000,,Жапониядан емес пе?
Dialogue: 0,1:07:09.27,1:07:11.52,JP,,0000,0000,0000,,Жапонияда таңғы сағат алты.
Dialogue: 0,1:07:12.11,1:07:14.38,JP,,0000,0000,0000,,Юй-чан, енді сіз уақыт айырмашылығы туралы көбірек білесіз.
Dialogue: 0,1:07:16.36,1:07:18.27,JP,,0000,0000,0000,,Иә, сәлем
Dialogue: 0,1:07:18.69,1:07:21.02,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,1:07:21.61,1:07:22.87,JP,,0000,0000,0000,,Не өлтіреді?
Dialogue: 0,1:07:23.65,1:07:24.68,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,1:07:24.68,1:07:26.54,JP,,0000,0000,0000,,Шыққан бойда сынды.
Dialogue: 0,1:07:26.92,1:07:27.61,JP,,0000,0000,0000,,Ауырды
Dialogue: 0,1:07:27.72,1:07:29.98,JP,,0000,0000,0000,,Тіліңді тістейсің... Сақ бол.
Dialogue: 0,1:07:27.98,1:07:29.48,JP,,0000,0000,0000,,Ол қайдан шыққан?
Dialogue: 0,1:07:30.35,1:07:33.19,JP,,0000,0000,0000,,Маңызды болса, мен сізге қайта қоңырау шаламын.
Dialogue: 0,1:07:33.52,1:07:34.67,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:07:38.91,1:07:40.66,JP,,0000,0000,0000,,Жеңілмейтін ән
Dialogue: 0,1:07:47.62,1:07:50.77,JP,,0000,0000,0000,,Олай болса, Юй-сенпайды қалай атайын...
Dialogue: 0,1:07:51.11,1:07:52.08,JP,,0000,0000,0000,,Азунян
Dialogue: 0,1:07:54.97,1:07:56.19,JP,,0000,0000,0000,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,1:08:01.08,1:08:04.63,JP,,0000,0000,0000,,Сенпай, көзіңді жыпылықта.
Dialogue: 0,1:08:05.63,1:08:07.47,JP,,0000,0000,0000,,Азунянға арналған ән...
Dialogue: 0,1:08:08.44,1:08:09.43,JP,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:08:09.68,1:08:12.31,JP,,0000,0000,0000,,Азу мияу мияу Азу мияу мияу
Dialogue: 0,1:08:12.54,1:08:15.86,JP,,0000,0000,0000,,Енді маған олай қарама.
Dialogue: 0,1:08:17.30,1:08:18.75,JP,,0000,0000,0000,,Мен ашуландым
Dialogue: 0,1:08:20.94,1:08:24.10,JP,,0000,0000,0000,,Әннің ұғымын мүлде ойлай алмаймын.
Dialogue: 0,1:08:25.34,1:08:28.31,JP,,0000,0000,0000,,Азу мияу мияу Азу мияу мияу
Dialogue: 0,1:08:29.14,1:08:31.70,JP,,0000,0000,0000,,Мен бұл сөз тіркесінен қашуым керек
Dialogue: 0,1:08:33.78,1:08:35.20,JP,,0000,0000,0000,,Лондон Лондон
Dialogue: 0,1:08:36.35,1:08:37.95,JP,,0000,0000,0000,,Тек қайта өңдеу
Dialogue: 0,1:08:38.44,1:08:39.46,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,1:08:41.24,1:08:42.49,JP,,0000,0000,0000,,Юи Сенпай
Dialogue: 0,1:08:44.92,1:08:46.75,JP,,0000,0000,0000,,Сыртқа шығатын уақыт келді.
Dialogue: 0,1:08:46.97,1:08:48.16,JP,,0000,0000,0000,,Азунян
Dialogue: 0,1:08:55.02,1:08:56.85,JP,,0000,0000,0000,,Бұл Лондон сияқты.
Dialogue: 0,1:08:56.99,1:08:59.28,JP,,0000,0000,0000,,Бұл Юй-сенпайдың гитарасымен бірдей.
Dialogue: 0,1:08:59.42,1:09:00.48,JP,,0000,0000,0000,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,1:09:01.54,1:09:05.83,JP,,0000,0000,0000,,Азунянға арналған ән... Үлкенірек ауқымда...
Dialogue: 0,1:09:06.29,1:09:10.08,JP,,0000,0000,0000,,Үлкен үлкен үлкен
Dialogue: 0,1:09:10.30,1:09:11.28,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,1:09:16.11,1:09:17.90,JP,,0000,0000,0000,,Азунянға арналған ән
Dialogue: 0,1:09:24.35,1:09:27.69,JP,,0000,0000,0000,,Лондон сияқты керемет ән
Dialogue: 0,1:09:32.02,1:09:33.70,JP,,0000,0000,0000,,Бұл Каваками мырзадан.
Dialogue: 0,1:09:37.46,1:09:39.60,JP,,0000,0000,0000,,Өткен күні мен жақсымын.
Dialogue: 0,1:09:40.19,1:09:41.63,JP,,0000,0000,0000,,Мен сені кейін ауыстырамын.
Dialogue: 0,1:09:42.92,1:09:46.42,JP,,0000,0000,0000,,Мен Маки-чаннан сендердің де Лондондасыңдар деп естідім.
Dialogue: 0,1:09:46.71,1:09:47.56,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:09:47.95,1:09:50.11,JP,,0000,0000,0000,,Менің сізге өтінішім бар.
Dialogue: 0,1:09:51.67,1:09:55.38,JP,,0000,0000,0000,,Онда жапон поп-мәдениетін таныстыру шарасы өтті.
Dialogue: 0,1:09:56.06,1:09:59.24,JP,,0000,0000,0000,,Love Crisis және Black Frill ойнайды.
Dialogue: 0,1:09:59.70,1:10:01.63,JP,,0000,0000,0000,,Мен де сенен сұрай алмаймын.
Dialogue: 0,1:10:03.81,1:10:04.76,JP,,0000,0000,0000,,Попкорн
Dialogue: 0,1:10:04.88,1:10:05.77,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,1:10:06.06,1:10:08.29,JP,,0000,0000,0000,,Ертең түстен кейін мен сонда боламын.
Dialogue: 0,1:10:08.55,1:10:09.20,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:10:09.56,1:10:12.19,JP,,0000,0000,0000,,Мен сізге мәліметтерді электрондық пошта арқылы жіберемін.
Dialogue: 0,1:10:17.19,1:10:20.40,JP,,0000,0000,0000,,Олар бізді орта мектептегі қыздар тобы ретінде таныстырғысы келеді.
Dialogue: 0,1:10:20.77,1:10:21.61,JP,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,1:10:22.71,1:10:27.26,JP,,0000,0000,0000,,Егер сіз Жапониядан электрондық хат жіберсеңіз, сіз оны өткенге жібересіз.
Dialogue: 0,1:10:27.62,1:10:28.94,JP,,0000,0000,0000,,Бұл болмайды.
Dialogue: 0,1:10:29.06,1:10:33.70,JP,,0000,0000,0000,,Өйткені бұл әлі де бүгін, ал Жапонияда ертең.
Dialogue: 0,1:10:34.14,1:10:35.07,JP,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,1:10:36.09,1:10:37.38,JP,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,1:10:37.57,1:10:39.30,JP,,0000,0000,0000,,Қарапайым айтсаң да
Dialogue: 0,1:10:39.55,1:10:43.99,JP,,0000,0000,0000,,Аа, бұл жерден электрондық пошта болашаққа жіберіледі.
Dialogue: 0,1:10:44.44,1:10:48.50,JP,,0000,0000,0000,,Юй-сенпай, әңгiме бiр-бiрiн бiр-бiрiне бiтiрiп кетедi, аузыңды жап.
Dialogue: 0,1:10:48.90,1:10:50.21,JP,,0000,0000,0000,,Содан кейін мен бас тартамын.
Dialogue: 0,1:10:50.89,1:10:52.87,JP,,0000,0000,0000,,Мен ойнағым келеді
Dialogue: 0,1:10:54.41,1:10:55.19,JP,,0000,0000,0000,,No
Dialogue: 0,1:10:55.93,1:10:59.43,JP,,0000,0000,0000,,Неге екенін білмеймін, бірақ жолым жоқ.
Dialogue: 0,1:10:59.63,1:11:03.82,JP,,0000,0000,0000,,Жарайды, суши мейрамханасындағыдай болмайтынына сенімдімін.
Dialogue: 0,1:11:04.29,1:11:06.63,JP,,0000,0000,0000,,Мені бұл алаңдатпайды.
Dialogue: 0,1:11:07.17,1:11:08.60,JP,,0000,0000,0000,,Менің де солай жасағым келеді
Dialogue: 0,1:11:10.06,1:11:12.79,JP,,0000,0000,0000,,Жарайды, Каваками мырзаға жауап бермеңіз.
Dialogue: 0,1:11:22.26,1:11:24.14,JP,,0000,0000,0000,,Қараңдар, тезірек мені көріңдер
Dialogue: 0,1:11:25.99,1:11:26.62,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:11:28.43,1:11:30.83,JP,,0000,0000,0000,,OK Жіберу
Dialogue: 0,1:11:31.53,1:11:34.56,JP,,0000,0000,0000,,Әй, мен оны болашаққа жібердім.
Dialogue: 0,1:11:35.75,1:11:36.67,JP,,0000,0000,0000,,Бұл
Dialogue: 0,1:11:38.12,1:11:39.94,JP,,0000,0000,0000,,Ертең мен үйге баратын күн...
Dialogue: 0,1:11:40.31,1:11:41.65,JP,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,1:11:42.02,1:11:43.87,JP,,0000,0000,0000,,Ұшаққа уақытында жетемін бе?
Dialogue: 0,1:11:46.30,1:11:47.98,JP,,0000,0000,0000,,Ұшу сағат нешеде?
Dialogue: 0,1:11:47.98,1:11:50.13,JP,,0000,0000,0000,,Мен әуежайға сағат 5 шамасында жетуім керек.
Dialogue: 0,1:11:50.91,1:11:52.85,JP,,0000,0000,0000,,Қойылым кешкі сағат төртте басталады.
Dialogue: 0,1:11:52.85,1:11:55.95,JP,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,1:11:56.48,1:11:57.75,JP,,0000,0000,0000,,Бұл бөлік пе?
Dialogue: 0,1:11:58.09,1:12:00.53,JP,,0000,0000,0000,,Иә, Бейбітшілік
Dialogue: 0,1:12:00.65,1:12:04.09,JP,,0000,0000,0000,,Мен Юй-сенпайдың жақсылығы өте қауіпті сияқты.
Dialogue: 0,1:12:05.67,1:12:08.48,JP,,0000,0000,0000,,Әзірге мен ``Күріш - гарнир'' дегенді ағылшын тіліне аударуға тырыстым.
Dialogue: 0,1:12:08.48,1:12:09.23,JP,,0000,0000,0000,,Не?
Dialogue: 0,1:12:09.23,1:12:10.47,JP,,0000,0000,0000,,Ағылшын тілінде ән айту
Dialogue: 0,1:12:10.76,1:12:12.25,JP,,0000,0000,0000,,Халықаралық.
Dialogue: 0,1:12:12.60,1:12:13.74,JP,,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,1:12:13.74,1:12:15.16,JP,,0000,0000,0000,,Оны қалай аудардыңыз?
Dialogue: 0,1:12:18.44,1:12:22.15,JP,,0000,0000,0000,,«Күріш керемет» «Күріш керемет» дегенді білдіреді
Dialogue: 0,1:12:22.85,1:12:24.14,JP,,0000,0000,0000,,Бұл тым тура аударма емес пе?
Dialogue: 0,1:12:24.55,1:12:25.94,JP,,0000,0000,0000,,«Бәрі де болады»
Dialogue: 0,1:12:26.76,1:12:28.52,JP,,0000,0000,0000,,«Тамаша сәйкестік»
Dialogue: 0,1:12:28.88,1:12:31.00,JP,,0000,0000,0000,,``бачири'' жапон тілі емес пе?
Dialogue: 0,1:12:31.46,1:12:33.79,JP,,0000,0000,0000,,«Дұрыс, күріш гарнир.»
Dialogue: 0,1:12:33.79,1:12:37.09,JP,,0000,0000,0000,,Керісінше... «А емес, В...»
Dialogue: 0,1:12:37.52,1:12:39.17,JP,,0000,0000,0000,,Бұл стандартты синтаксис.
Dialogue: 0,1:12:39.68,1:12:42.12,JP,,0000,0000,0000,,А Азунян көп емес
Dialogue: 0,1:12:43.60,1:12:47.75,JP,,0000,0000,0000,,Күріш негізгі тағам емес, гарнир...
Dialogue: 0,1:12:47.95,1:12:51.00,JP,,0000,0000,0000,,Қандай да бір себептермен күріш негізгі тағамнан гарнирге айналды.
Dialogue: 0,1:12:51.22,1:12:53.28,JP,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,1:12:53.28,1:12:55.30,JP,,0000,0000,0000,,Шулы Келесі Келесі
Dialogue: 0,1:13:01.77,1:13:05.16,JP,,0000,0000,0000,,Енді бір нәрсе есіме түсті, Азунянға арналған ән
Dialogue: 0,1:13:05.51,1:13:06.48,JP,,0000,0000,0000,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,1:13:07.35,1:13:10.99,JP,,0000,0000,0000,,Мен үлкен жаңалық ашқандай болдым...
Dialogue: 0,1:13:12.21,1:13:16.60,JP,,0000,0000,0000,,Олай болса, Юй-сенпайды қалай атайын?
Dialogue: 0,1:13:25.55,1:13:27.17,JP,,0000,0000,0000,,Менің ұйықтағым келеді, Азунян
Dialogue: 0,1:13:27.34,1:13:30.94,JP,,0000,0000,0000,,Түсімде Юй-сенпай көріп, ұйықтай алмадым.
Dialogue: 0,1:13:32.53,1:13:34.30,JP,,0000,0000,0000,,Қандай арман?
Dialogue: 0,1:13:34.30,1:13:36.88,JP,,0000,0000,0000,,Бұл шынымен біртүрлі түс.
Dialogue: 0,1:13:37.87,1:13:39.00,JP,,0000,0000,0000,,Бұл құпия.
Dialogue: 0,1:13:41.33,1:13:42.79,JP,,0000,0000,0000,,О, сәл күте тұрыңыз.
Dialogue: 0,1:13:44.09,1:13:45.69,JP,,0000,0000,0000,,Не болды, Муги-чан?
Dialogue: 0,1:13:47.32,1:13:48.98,JP,,0000,0000,0000,,Уау, Муги-чан
Dialogue: 0,1:13:48.98,1:13:51.06,JP,,0000,0000,0000,,Муги пернетақтасы болуы мүмкін
Dialogue: 0,1:13:51.68,1:13:54.12,JP,,0000,0000,0000,,Өйткені оны бәрі әкелді.
Dialogue: 0,1:13:54.20,1:13:55.82,JP,,0000,0000,0000,,Бай адамдар керемет
Dialogue: 0,1:13:56.08,1:13:58.32,JP,,0000,0000,0000,,Мен олардың көбін көргеніме қуаныштымын.
Dialogue: 0,1:14:13.17,1:14:15.46,JP,,0000,0000,0000,,Қанша көрсем де үлкен.
Dialogue: 0,1:14:15.73,1:14:17.43,JP,,0000,0000,0000,,Қанша қарасам да айнала береді.
Dialogue: 0,1:14:17.43,1:14:19.56,JP,,0000,0000,0000,,Аа, бұл орынға ұқсайды.
Dialogue: 0,1:14:31.21,1:14:32.17,JP,,0000,0000,0000,,Қайсысы?
Dialogue: 0,1:14:32.41,1:14:34.92,JP,,0000,0000,0000,,Ах, якисоба дүңгіршегі бар.
Dialogue: 0,1:14:35.07,1:14:37.81,JP,,0000,0000,0000,,Бұл жолы да тамақ іше алмағаны үшін 5000 ұпай
Dialogue: 0,1:14:40.43,1:14:42.30,JP,,0000,0000,0000,,Сәлем Маки-чан
Dialogue: 0,1:14:42.85,1:14:45.71,JP,,0000,0000,0000,,О, Риччан
Dialogue: 0,1:14:47.43,1:14:49.07,JP,,0000,0000,0000,,Маки және басқалары қашан бастады?
Dialogue: 0,1:14:49.60,1:14:50.53,JP,,0000,0000,0000,,Үш жарым
Dialogue: 0,1:14:51.11,1:14:52.73,JP,,0000,0000,0000,,Біздің алдымызда
Dialogue: 0,1:14:53.04,1:14:54.80,JP,,0000,0000,0000,,Қара бүліктер
Dialogue: 0,1:14:56.35,1:14:57.65,JP,,0000,0000,0000,,Сағат төрт болды
Dialogue: 0,1:14:57.90,1:15:00.26,JP,,0000,0000,0000,,Біз сағат төрттен бері емеспіз бе?
Dialogue: 0,1:15:00.65,1:15:01.92,JP,,0000,0000,0000,,Иә, мен сенімдімін
Dialogue: 0,1:15:02.14,1:15:04.19,JP,,0000,0000,0000,,Риччан, сен қателескен жоқсың.
Dialogue: 0,1:15:04.31,1:15:05.13,JP,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,1:15:05.58,1:15:07.62,JP,,0000,0000,0000,,Жоқ, уақыт дұрыс.
Dialogue: 0,1:15:08.86,1:15:12.63,JP,,0000,0000,0000,,Black Frill және біз ішкі сахнада өнер көрсетеміз.
Dialogue: 0,1:15:13.01,1:15:15.55,JP,,0000,0000,0000,,Риччан және басқалары бұл ашық сахна деп айтады.
Dialogue: 0,1:15:16.15,1:15:17.11,JP,,0000,0000,0000,,Сыртта
Dialogue: 0,1:15:17.74,1:15:18.98,JP,,0000,0000,0000,,Мұнда емес
Dialogue: 0,1:15:19.27,1:15:20.18,JP,,0000,0000,0000,,Мұнда
Dialogue: 0,1:15:26.68,1:15:28.46,JP,,0000,0000,0000,,Бұл өте жақсы көрініс.
Dialogue: 0,1:15:28.72,1:15:31.94,JP,,0000,0000,0000,,Мұнда ойнау жақсы.
Dialogue: 0,1:15:31.94,1:15:32.51,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:15:32.83,1:15:35.82,JP,,0000,0000,0000,,Мен бір сәт далада жалғыз біз екенбіз деп ойладым.
Dialogue: 0,1:15:35.82,1:15:36.62,JP,,0000,0000,0000,,Жақсы болуы мүмкін
Dialogue: 0,1:15:36.90,1:15:37.52,JP,,0000,0000,0000,,Жоғары
Dialogue: 0,1:15:38.49,1:15:39.73,JP,,0000,0000,0000,,шай уақыты
Dialogue: 0,1:15:40.35,1:15:41.24,JP,,0000,0000,0000,,Аударма: Xianyu Experience, Dabu Lu; Кейіпкер дизайны: Xiao Wu, Gen, Cuonan, AB
Dialogue: 0,1:15:41.68,1:15:43.72,JP,,0000,0000,0000,,Құралдарыңызды қазір орната аласыз ба, өтінемін
Dialogue: 0,1:15:44.33,1:15:45.16,JP,,0000,0000,0000,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,1:15:45.21,1:15:47.40,JP,,0000,0000,0000,,Реттеуді бастаңыз.
Dialogue: 0,1:16:11.69,1:16:13.97,JP,,0000,0000,0000,,Мен мұны енгізе аламын ба?
Dialogue: 0,1:16:15.06,1:16:16.78,JP,,0000,0000,0000,,Ұшқындар жоқ
Dialogue: 0,1:16:16.78,1:16:20.02,JP,,0000,0000,0000,,Бұлай болуы мүмкін емес, солай ма?
Dialogue: 0,1:16:20.28,1:16:21.36,JP,,0000,0000,0000,,Эй, Мио-сенпай
Dialogue: 0,1:16:21.72,1:16:25.00,JP,,0000,0000,0000,,Дұрыс, менде жағымсыз сезім бар.
Dialogue: 0,1:16:25.46,1:16:26.93,JP,,0000,0000,0000,,Мио-сенпайға
Dialogue: 0,1:16:28.92,1:16:31.43,JP,,0000,0000,0000,,Біреу біледі ме?
Dialogue: 0,1:16:31.43,1:16:33.12,JP,,0000,0000,0000,,Сіз тұтынушылардың қатарындасыз ба?
Dialogue: 0,1:16:34.18,1:16:36.59,JP,,0000,0000,0000,,Қызметкерді шақырайын ба?
Dialogue: 0,1:16:38.16,1:16:40.32,JP,,0000,0000,0000,,Оны сол күйінде енгізіңіз.
Dialogue: 0,1:16:40.91,1:16:42.24,JP,,0000,0000,0000,,Гита
Dialogue: 0,1:16:48.96,1:16:50.17,JP,,0000,0000,0000,,Сава-чан
Dialogue: 0,1:16:50.22,1:16:53.48,JP,,0000,0000,0000,,Біріншіден, бұл гитара жапондық өндіруші емес шығар.
Dialogue: 0,1:16:54.69,1:16:56.42,JP,,0000,0000,0000,,Қандай елес
Dialogue: 0,1:16:56.67,1:16:57.75,JP,,0000,0000,0000,,Неліктен мұнда?
Dialogue: 0,1:16:58.06,1:16:59.03,JP,,0000,0000,0000,,Оның аяқтары бар.
Dialogue: 0,1:16:59.16,1:17:01.18,JP,,0000,0000,0000,,Не, бұл елес емес.
Dialogue: 0,1:17:01.73,1:17:03.05,JP,,0000,0000,0000,,Неліктен Лондон?
Dialogue: 0,1:17:03.46,1:17:04.51,JP,,0000,0000,0000,,Бал айы
Dialogue: 0,1:17:05.05,1:17:06.69,JP,,0000,0000,0000,,Мильдер жиналды.
Dialogue: 0,1:17:07.98,1:17:10.93,JP,,0000,0000,0000,,Мен ішімдік ішуге картаммен ақша төлеп, ақша жинадым.
Dialogue: 0,1:17:11.20,1:17:13.74,JP,,0000,0000,0000,,Оның мерзімі аяқталуға жақын.
Dialogue: 0,1:17:14.01,1:17:16.25,JP,,0000,0000,0000,,Мен жеңіл музыка клубының кеңесшісімін.
Dialogue: 0,1:17:16.74,1:17:17.92,JP,,0000,0000,0000,,Қашан келдің?
Dialogue: 0,1:17:17.92,1:17:19.00,JP,,0000,0000,0000,,Ол кеше келді.
Dialogue: 0,1:17:19.23,1:17:20.16,JP,,0000,0000,0000,,Үйге бару
Dialogue: 0,1:17:20.48,1:17:21.19,JP,,0000,0000,0000,,Бүгін түнде
Dialogue: 0,1:17:21.26,1:17:22.68,JP,,0000,0000,0000,,Үлкендер ғажап
Dialogue: 0,1:17:22.76,1:17:24.72,JP,,0000,0000,0000,,Маған бірдеңе айтсаңызшы.
Dialogue: 0,1:17:25.08,1:17:28.12,JP,,0000,0000,0000,,Қонақ үйге қоңырау шалдым, бірақ сендер жауап бермедіңдер.
Dialogue: 0,1:17:28.47,1:17:30.76,JP,,0000,0000,0000,,А, бұл Сава-чан болды ма?
Dialogue: 0,1:17:31.12,1:17:33.94,JP,,0000,0000,0000,,Жүр, мен де арнайы киімімді ала келдім.
Dialogue: 0,1:17:34.73,1:17:37.07,JP,,0000,0000,0000,,Жапон ханымының ниндзясы
Dialogue: 0,1:17:37.07,1:17:38.08,JP,,0000,0000,0000,,Кунойчи?
Dialogue: 0,1:17:38.13,1:17:40.47,JP,,0000,0000,0000,,Уау Браво Браво
Dialogue: 0,1:17:40.47,1:17:41.93,JP,,0000,0000,0000,,No, no, no, no
Dialogue: 0,1:17:41.93,1:17:43.04,JP,,0000,0000,0000,,Мынау және анау
Dialogue: 0,1:17:43.90,1:17:45.00,JP,,0000,0000,0000,,Нодока-чан
Dialogue: 0,1:17:45.70,1:17:46.71,JP,,0000,0000,0000,,Қайғыға дейін
Dialogue: 0,1:17:47.19,1:17:48.13,JP,,0000,0000,0000,,Таза болғанша
Dialogue: 0,1:17:48.66,1:17:49.43,JP,,0000,0000,0000,,Таныстырулар!
Dialogue: 0,1:17:51.63,1:17:54.01,JP,,0000,0000,0000,,Иә Иә Күту режимі
Dialogue: 0,1:18:22.05,1:18:25.43,JP,,0000,0000,0000,,Сонымен, мен Лондонда өте қызық болдым.
Dialogue: 0,1:18:25.66,1:18:27.68,JP,,0000,0000,0000,,Өте қызықты
Dialogue: 0,1:18:27.80,1:18:29.91,JP,,0000,0000,0000,,бірдей мағынаны білдіреді, солай емес пе?
Dialogue: 0,1:18:30.77,1:18:32.91,JP,,0000,0000,0000,,Юи Ұшу уақыты жақындап қалды
Dialogue: 0,1:18:33.13,1:18:34.31,JP,,0000,0000,0000,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,1:18:40.69,1:18:42.67,JP,,0000,0000,0000,,Енді соңғы әнге.
Dialogue: 0,1:18:43.31,1:18:44.70,JP,,0000,0000,0000,,Күріш – гарнир
Dialogue: 0,1:18:45.67,1:18:46.94,JP,,0000,0000,0000,,1 2 3 4
Dialogue: 0,1:19:03.34,1:19:05.99,JP,,0000,0000,0000,,Бұл жапондық.
Dialogue: 0,1:20:20.63,1:20:21.73,JP,,0000,0000,0000,,Тағы да
Dialogue: 0,1:20:27.99,1:20:29.46,JP,,0000,0000,0000,,Бұл жерде ағылшынша ма?
Dialogue: 0,1:20:29.46,1:20:30.46,JP,,0000,0000,0000,,Аға
Dialogue: 0,1:20:38.11,1:20:39.35,JP,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:21:16.06,1:21:17.92,JP,,0000,0000,0000,,Биік аспан дегеніміз не?
Dialogue: 0,1:21:18.38,1:21:19.76,JP,,0000,0000,0000,,Мен шектен шығып кеттім
Dialogue: 0,1:21:19.76,1:21:21.91,JP,,0000,0000,0000,,Бала өте сүйкімді болды
Dialogue: 0,1:21:22.32,1:21:24.41,JP,,0000,0000,0000,,Мен мұнымен келісемін.
Dialogue: 0,1:21:24.55,1:21:26.40,JP,,0000,0000,0000,,Оның алдында отырған қыз
Dialogue: 0,1:21:26.67,1:21:28.71,JP,,0000,0000,0000,,Соңында бұл соңғы минут, солай емес пе?
Dialogue: 0,1:21:28.71,1:21:31.73,JP,,0000,0000,0000,,Мен саған өзімнің қандай керемет екенімді көрсеткім келді.
Dialogue: 0,1:21:31.99,1:21:33.13,JP,,0000,0000,0000,,Сәлем такси
Dialogue: 0,1:21:42.12,1:21:43.20,JP,,0000,0000,0000,,Мен ұйықтап қалдым.
Dialogue: 0,1:21:43.78,1:21:48.77,JP,,0000,0000,0000,,Азуса-чан, сіз саяхатта бар күшіңізді салып, әртүрлі нәрселерді зерттедіңіз.
Dialogue: 0,1:21:50.87,1:21:52.27,JP,,0000,0000,0000,,Шаршаған шығармын
Dialogue: 0,1:22:09.82,1:22:11.02,JP,,0000,0000,0000,,Қар
Dialogue: 0,1:22:11.80,1:22:12.99,JP,,0000,0000,0000,,Бұл рас
Dialogue: 0,1:22:25.36,1:22:28.08,JP,,0000,0000,0000,,Эй, мен таңғажайып нәрсені байқадым.
Dialogue: 0,1:22:34.48,1:22:37.30,JP,,0000,0000,0000,,Кәдімгі әндеріміз жақсы, солай ма?
Dialogue: 0,1:22:37.64,1:22:39.46,JP,,0000,0000,0000,,О, мен мұны енді ғана түсіндім.
Dialogue: 0,1:22:40.32,1:22:42.77,JP,,0000,0000,0000,,Мен де солай ойладым, Юй Чан.
Dialogue: 0,1:22:42.82,1:22:44.07,JP,,0000,0000,0000,,Эх Муги-чан
Dialogue: 0,1:22:44.22,1:22:46.71,JP,,0000,0000,0000,,Мұны мен де баяғыда байқадым.
Dialogue: 0,1:23:03.76,1:23:06.00,JP,,0000,0000,0000,,Нодока-чан, өзіңе ұнайтын нәрсені ал.
Dialogue: 0,1:23:06.53,1:23:08.25,JP,,0000,0000,0000,,Бұл он жылға жуық уақыт.
Dialogue: 0,1:23:08.98,1:23:12.13,JP,,0000,0000,0000,,Лондонда түстен кейінгі шәй ішуге болмайтынын естідім.
Dialogue: 0,1:23:12.53,1:23:14.03,JP,,0000,0000,0000,,Бұл ұят.
Dialogue: 0,1:23:14.17,1:23:15.75,JP,,0000,0000,0000,,Сабарудың арқасында болар.
Dialogue: 0,1:23:15.75,1:23:17.65,JP,,0000,0000,0000,,Бірақ сен ойнадың ғой, солай ма?
Dialogue: 0,1:23:17.93,1:23:19.89,JP,,0000,0000,0000,,Мен естідім, көрдім.
Dialogue: 0,1:23:20.23,1:23:21.74,JP,,0000,0000,0000,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,1:23:21.91,1:23:24.55,JP,,0000,0000,0000,,Сыныптағылардың барлығы да көргісі келетінін айтты.
Dialogue: 0,1:23:25.06,1:23:26.15,JP,,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,1:23:27.17,1:23:29.84,JP,,0000,0000,0000,,Эй, эй, сен Лондонда тікелей шоу көрсеттің ғой, солай ма?
Dialogue: 0,1:23:30.00,1:23:30.93,JP,,0000,0000,0000,,Қалай болды?
Dialogue: 0,1:23:31.17,1:23:32.24,JP,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,1:23:32.24,1:23:33.79,JP,,0000,0000,0000,,Күріш – гарнир.
Dialogue: 0,1:23:33.98,1:23:35.01,JP,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:23:35.50,1:23:37.00,JP,,0000,0000,0000,,Міне, Ичиго.
Dialogue: 0,1:23:37.66,1:23:40.58,JP,,0000,0000,0000,,Мен оны бітірер алдында тағы бір рет тыңдағым келеді.
Dialogue: 0,1:23:40.99,1:23:42.35,JP,,0000,0000,0000,,Юидің орындауы
Dialogue: 0,1:23:42.49,1:23:44.93,JP,,0000,0000,0000,,Jazz Lab тікелей эфирде бітіру кешін өткізетін емес пе еді?
Dialogue: 0,1:23:45.02,1:23:45.63,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:23:45.63,1:23:46.50,JP,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:23:46.81,1:23:47.81,JP,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,1:23:47.81,1:23:49.47,JP,,0000,0000,0000,,Мен білмедім.
Dialogue: 0,1:23:49.47,1:23:50.78,JP,,0000,0000,0000,,Мен бірдеңе істегім келеді
Dialogue: 0,1:23:51.77,1:23:52.90,JP,,0000,0000,0000,,Мұны қайда істеуіміз керек?
Dialogue: 0,1:23:53.21,1:23:53.88,JP,,0000,0000,0000,,Клуб бөлмесі
Dialogue: 0,1:23:55.64,1:23:58.06,JP,,0000,0000,0000,,Олай болса, өтініш жасай аласыз.
Dialogue: 0,1:24:00.34,1:24:01.77,JP,,0000,0000,0000,,Сыныпта тұру
Dialogue: 0,1:24:02.22,1:24:04.43,JP,,0000,0000,0000,,Иә, мектептің соңғы күні
Dialogue: 0,1:24:04.85,1:24:07.08,JP,,0000,0000,0000,,Орта мектептегі соңғы естеліктерді жасау
Dialogue: 0,1:24:07.08,1:24:09.43,JP,,0000,0000,0000,,Ия, сағыныш.
Dialogue: 0,1:24:09.43,1:24:10.86,JP,,0000,0000,0000,,Біз де солай жасадық
Dialogue: 0,1:24:11.52,1:24:14.70,JP,,0000,0000,0000,,Жоқ, бұл басқа сыныптарға кедергі болады.
Dialogue: 0,1:24:15.84,1:24:19.45,JP,,0000,0000,0000,,Сыныптарда ансамбльдер мен үрмелі аспаптар оркестрлері өнер көрсетеді.
Dialogue: 0,1:24:19.65,1:24:21.62,JP,,0000,0000,0000,,Сава-чан, кенет не болды?
Dialogue: 0,1:24:21.62,1:24:25.20,JP,,0000,0000,0000,,Қалай болғанда да, сендер ерекше емессіңдер.
Dialogue: 0,1:24:27.34,1:24:28.87,JP,,0000,0000,0000,,Бармайсыз ба?
Dialogue: 0,1:24:35.86,1:24:37.19,JP,,0000,0000,0000,,Түсіндім, Сава-чан.
Dialogue: 0,1:24:37.33,1:24:39.37,JP,,0000,0000,0000,,Иә, түсінесіз деп үміттенемін.
Dialogue: 0,1:24:39.84,1:24:40.99,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:24:44.26,1:24:48.38,JP,,0000,0000,0000,,Мен ол кезде не болғанын білмеймін, бірақ мен қатты ашуландым.
Dialogue: 0,1:24:48.88,1:24:53.05,JP,,0000,0000,0000,,Ол балалар, ол кезде бізбен салыстырғанда, мүлде рок емес еді.
Dialogue: 0,1:24:53.45,1:24:55.00,JP,,0000,0000,0000,,Бұл үлпілдек балапан
Dialogue: 0,1:24:55.53,1:24:57.43,JP,,0000,0000,0000,,Мен оларға шыдай алмайтыныма сенімдімін.
Dialogue: 0,1:24:57.78,1:24:59.14,JP,,0000,0000,0000,,Мен міндетті түрде жылаймын
Dialogue: 0,1:25:00.02,1:25:01.27,JP,,0000,0000,0000,,Содан кейін I
Dialogue: 0,1:25:01.65,1:25:03.04,JP,,0000,0000,0000,,Оны қорғаудан басқа амалымыз жоқ.
Dialogue: 0,1:25:05.20,1:25:07.48,JP,,0000,0000,0000,,Корсаждың соңғы мерзімі ертең.
Dialogue: 0,1:25:07.56,1:25:09.17,JP,,0000,0000,0000,,Yes
Dialogue: 0,1:25:10.29,1:25:12.52,JP,,0000,0000,0000,,Азуса, қайшыны маған берші.
Dialogue: 0,1:25:13.09,1:25:15.14,JP,,0000,0000,0000,,Жақсы, иә.
Dialogue: 0,1:25:15.27,1:25:16.09,JP,,0000,0000,0000,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:25:18.89,1:25:20.13,JP,,0000,0000,0000,,Азуса
Dialogue: 0,1:25:20.40,1:25:21.34,JP,,0000,0000,0000,,Не?
Dialogue: 0,1:25:22.42,1:25:24.00,JP,,0000,0000,0000,,Сіз қызықты нәрсе жасайсыз.
Dialogue: 0,1:25:24.11,1:25:25.26,JP,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,1:25:25.41,1:25:27.44,JP,,0000,0000,0000,,Жоқ, бұл менің ағам.
Dialogue: 0,1:25:29.58,1:25:31.93,JP,,0000,0000,0000,,Шіркін Қарашы, қарашы, Азуса
Dialogue: 0,1:25:31.93,1:25:32.89,JP,,0000,0000,0000,,Не болды, Джун Чан?
Dialogue: 0,1:25:32.89,1:25:34.67,JP,,0000,0000,0000,,Мына қайшыларға қараңдар.
Dialogue: 0,1:25:32.88,1:25:34.75,JP,,0000,0000,0000,,Қазір басқаша болса да
Dialogue: 0,1:25:38.16,1:25:39.45,JP,,0000,0000,0000,,Жоғары
Dialogue: 0,1:25:39.75,1:25:41.45,JP,,0000,0000,0000,,Сыныпта тікелей көрсетіле ме?
Dialogue: 0,1:25:41.71,1:25:42.27,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:25:42.63,1:25:44.92,JP,,0000,0000,0000,,Бірақ эй, бұл біздің сынып.
Dialogue: 0,1:25:45.28,1:25:50.37,JP,,0000,0000,0000,,Мен мұны өзіміз жасауымыз керек шығар деп ойлаймын.
Dialogue: 0,1:25:51.57,1:25:52.93,JP,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,1:25:53.61,1:25:55.12,JP,,0000,0000,0000,,Менің де солай жасағым келеді
Dialogue: 0,1:25:55.35,1:25:56.29,JP,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:25:56.55,1:25:57.16,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:25:58.16,1:26:02.73,JP,,0000,0000,0000,,Бұл сіздің үлкендеріңіздің алдында соңғы рет өнер көрсетуіңіз емес пе?
Dialogue: 0,1:26:03.05,1:26:04.33,JP,,0000,0000,0000,,Ал мектепте
Dialogue: 0,1:26:04.70,1:26:05.84,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,1:26:05.84,1:26:07.76,JP,,0000,0000,0000,,Рахмет сізге Азунян
Dialogue: 0,1:26:08.51,1:26:11.33,JP,,0000,0000,0000,,Ендеше, оны қашан жасайсың, Рицу-сенпай?
Dialogue: 0,1:26:16.98,1:26:18.96,JP,,0000,0000,0000,,Мектептің соңғы күні де келіп жетті
Dialogue: 0,1:26:19.81,1:26:22.00,JP,,0000,0000,0000,,Мен ол балаларды қорғаймын.
Dialogue: 0,1:26:25.79,1:26:27.24,JP,,0000,0000,0000,,Бізге тағы бір жол керек сияқты.
Dialogue: 0,1:26:27.61,1:26:28.97,JP,,0000,0000,0000,,О, жарайды.
Dialogue: 0,1:26:29.33,1:26:29.99,JP,,0000,0000,0000,,О.
Dialogue: 0,1:26:30.56,1:26:32.10,JP,,0000,0000,0000,,Оны кейінірек сүртіңіз.
Dialogue: 0,1:26:58.97,1:27:00.40,JP,,0000,0000,0000,,Ол мәңгі сақталады.
Dialogue: 0,1:27:05.96,1:27:07.81,JP,,0000,0000,0000,,Профессор Яманака, сіз ерте келдіңіз.
Dialogue: 0,1:27:08.01,1:27:10.59,JP,,0000,0000,0000,,Иә, менің істерім көп.
Dialogue: 0,1:27:11.68,1:27:13.34,JP,,0000,0000,0000,,О, бұл дыбыс
Dialogue: 0,1:27:13.44,1:27:16.63,JP,,0000,0000,0000,,Е, қызық, құрылыс жүріп жатыр ма?
Dialogue: 0,1:27:16.68,1:27:19.39,JP,,0000,0000,0000,,Қарасам, құрылыс қарқынды жүріп жатыр.
Dialogue: 0,1:27:21.57,1:27:22.46,JP,,0000,0000,0000,,Не?
Dialogue: 0,1:27:22.46,1:27:24.34,JP,,0000,0000,0000,,Өткенде айтып отырғаныңыз осы ма?
Dialogue: 0,1:27:24.34,1:27:25.44,JP,,0000,0000,0000,,Мен бұл күдікті деп ойладым.
Dialogue: 0,1:27:25.44,1:27:26.48,JP,,0000,0000,0000,,Келесі шайқас үшін!
Dialogue: 0,1:27:27.81,1:27:28.52,JP,,0000,0000,0000,,Тікелей
Dialogue: 0,1:27:28.73,1:27:29.38,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:27:30.19,1:27:31.32,JP,,0000,0000,0000,,Көргім келеді Көргім келеді
Dialogue: 0,1:27:35.51,1:27:38.96,JP,,0000,0000,0000,,Ал, әзірге осымен.
Dialogue: 0,1:27:51.20,1:27:52.12,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,1:27:52.23,1:27:53.31,JP,,0000,0000,0000,,Мұнда
Dialogue: 0,1:27:53.31,1:27:54.30,JP,,0000,0000,0000,,Басталып жатыр
Dialogue: 0,1:28:15.96,1:28:18.04,JP,,0000,0000,0000,,Мұғалім, күте тұрыңыз.
Dialogue: 0,1:28:19.00,1:28:20.82,JP,,0000,0000,0000,,Сұрақтар қойылмаған
Dialogue: 0,1:28:20.82,1:28:23.48,JP,,0000,0000,0000,,Үй бөлмесіне дейін бітіремін.
Dialogue: 0,1:28:58.07,1:28:59.70,JP,,0000,0000,0000,,Маған кейінірек біреуін беріңіз
Dialogue: 0,1:28:59.86,1:29:00.57,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,1:29:59.63,1:30:04.02,JP,,0000,0000,0000,,Жарайсыңдар, бұрынғылармен салыстырғанда, сендер сүйкімді екенсіңдер.
Dialogue: 0,1:31:11.71,1:31:15.73,JP,,0000,0000,0000,,Енді Азунянның әнін аяқтау ғана қалды.
Dialogue: 0,1:31:15.91,1:31:18.57,JP,,0000,0000,0000,,Бұл ең маңыздысы шығар.
Dialogue: 0,1:31:18.97,1:31:21.30,JP,,0000,0000,0000,,Иә, әуен дайын.
Dialogue: 0,1:31:21.40,1:31:22.50,JP,,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз
Dialogue: 0,1:31:50.64,1:31:52.88,JP,,0000,0000,0000,,Муги Бұл керемет
Dialogue: 0,1:31:54.75,1:31:57.09,JP,,0000,0000,0000,,Тек ән мәтінін жинап алу ғана қалды және ол орындалды.
Dialogue: 0,1:31:57.38,1:31:58.04,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:31:59.63,1:32:03.48,JP,,0000,0000,0000,,Азунянмен көп уақыт өткізуге қиналып жүрмін.
Dialogue: 0,1:32:04.56,1:32:06.60,JP,,0000,0000,0000,,Бұл біздің қазынамыз.
Dialogue: 0,1:32:07.08,1:32:08.26,JP,,0000,0000,0000,,Оны қолданайық.
Dialogue: 0,1:32:11.95,1:32:12.89,JP,,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,1:32:12.89,1:32:13.71,JP,,0000,0000,0000,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:32:27.88,1:32:29.01,JP,,0000,0000,0000,,Әпке тағамы
Dialogue: 0,1:32:32.14,1:32:33.42,JP,,0000,0000,0000,,Не?
Dialogue: 0,1:32:33.89,1:32:35.14,JP,,0000,0000,0000,,Бойыңыз өсті.
Dialogue: 0,1:32:35.14,1:32:36.07,JP,,0000,0000,0000,,Маджи
Dialogue: 0,1:32:54.51,1:32:55.27,JP,,0000,0000,0000,,Дайын
Dialogue: 0,1:32:56.34,1:32:57.11,JP,,0000,0000,0000,,Дайын
Dialogue: 0,1:32:58.28,1:33:00.46,JP,,0000,0000,0000,,Жақсы, мен оны уақытында жасадым.
Dialogue: 0,1:33:00.94,1:33:04.50,JP,,0000,0000,0000,,Юи Мен олай ойламаймын, бірақ мен бұл туралы Азусаға әлі айтқан жоқпын.
Dialogue: 0,1:33:04.50,1:33:05.68,JP,,0000,0000,0000,,Ал Кира
Dialogue: 0,1:33:05.80,1:33:07.54,JP,,0000,0000,0000,,Мен мұны құпия ұстаймын
Dialogue: 0,1:33:08.99,1:33:10.06,JP,,0000,0000,0000,,Осындай нәрсе
Dialogue: 0,1:33:10.88,1:33:11.80,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,1:33:12.39,1:33:14.09,JP,,0000,0000,0000,,Бұл әрқашан біртүрлі болды, солай емес пе?
Dialogue: 0,1:33:15.35,1:33:16.62,JP,,0000,0000,0000,,Үлкендер
Dialogue: 0,1:33:17.05,1:33:18.92,JP,,0000,0000,0000,,Бұл әрқашан біртүрлі болды.
Dialogue: 0,1:33:23.23,1:33:24.74,JP,,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,1:33:25.84,1:33:27.24,JP,,0000,0000,0000,,Не қызық?
Dialogue: 0,1:33:28.21,1:33:32.26,JP,,0000,0000,0000,,Мен барсам кенет істеп жатқан ісін тоқтатты.
Dialogue: 0,1:33:33.55,1:33:35.00,JP,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,1:33:35.31,1:33:37.35,JP,,0000,0000,0000,,Мен оның не істеп жатқанын сұрадым.
Dialogue: 0,1:33:37.54,1:33:38.85,JP,,0000,0000,0000,,Кенет басқа жаққа қараңыз
Dialogue: 0,1:33:39.35,1:33:42.09,JP,,0000,0000,0000,,Біз ғаламмен байланыспаймыз.
Dialogue: 0,1:33:43.04,1:33:43.95,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,1:33:43.95,1:33:48.16,JP,,0000,0000,0000,,Немесе ол Азусаға тығылып, ғажайып тәттілерді жеп жатқан шығар.
Dialogue: 0,1:33:48.64,1:33:52.46,JP,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,1:33:54.08,1:33:56.38,JP,,0000,0000,0000,,Мен көптен бері бір нәрсені жасырып жүрген сияқтымын.
Dialogue: 0,1:33:58.76,1:33:59.70,JP,,0000,0000,0000,,Мен қайғылымын
Dialogue: 0,1:34:00.16,1:34:05.48,JP,,0000,0000,0000,,Мен олай ойламаймын, бірақ жоғары сынып оқушылары бағаны қайталап жатқан жоқ деп ойлаймын.
Dialogue: 0,1:34:06.51,1:34:07.54,JP,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:34:07.85,1:34:08.78,JP,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:34:09.18,1:34:11.98,JP,,0000,0000,0000,,Ол мектеп бітіру рәсіміне колготки сатып алғанын айтты.
Dialogue: 0,1:34:12.13,1:34:13.07,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:34:14.15,1:34:15.19,JP,,0000,0000,0000,,Олай болса
Dialogue: 0,1:34:15.43,1:34:17.34,JP,,0000,0000,0000,,Менің ойымша, мен университеттен өте алмадым.
Dialogue: 0,1:34:18.25,1:34:19.57,JP,,0000,0000,0000,,Мен сенімді болдым
Dialogue: 0,1:34:20.80,1:34:22.18,JP,,0000,0000,0000,,Сонда ше?
Dialogue: 0,1:34:28.93,1:34:30.91,JP,,0000,0000,0000,,Жарайды, Азуса-чан.
Dialogue: 0,1:34:32.39,1:34:41.36,JP,,0000,0000,0000,,Бірақ мен сені кездестірдім, сен кереметсің.
Dialogue: 0,1:34:46.57,1:34:49.65,JP,,0000,0000,0000,,Мұндағы өлең сөздері көңіл көншітпейді.
Dialogue: 0,1:34:54.86,1:34:56.35,JP,,0000,0000,0000,,Әпке, кіріңіз.
Dialogue: 0,1:34:56.99,1:34:58.05,JP,,0000,0000,0000,,Yes
Dialogue: 0,1:35:01.22,1:35:03.20,JP,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,1:35:07.30,1:35:09.06,JP,,0000,0000,0000,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,1:35:15.02,1:35:18.10,JP,,0000,0000,0000,,Әпке, сіздің бетіңізде тағы да жіп ізі бар.
Dialogue: 0,1:35:18.10,1:35:19.66,JP,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,1:35:22.31,1:35:25.01,JP,,0000,0000,0000,,А, сен ертеңге дайынсың.
Dialogue: 0,1:35:27.97,1:35:29.80,JP,,0000,0000,0000,,Ақырында бітірдіңіз бе?
Dialogue: 0,1:35:30.39,1:35:31.63,JP,,0000,0000,0000,,Ерте ұйықтаңыз.
Dialogue: 0,1:35:31.98,1:35:32.96,JP,,0000,0000,0000,,Қайғы да
Dialogue: 0,1:35:32.96,1:35:33.51,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:35:35.15,1:35:36.00,JP,,0000,0000,0000,,Қайғы
Dialogue: 0,1:35:36.18,1:35:36.97,JP,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:35:39.18,1:35:40.22,JP,,0000,0000,0000,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,1:35:42.34,1:35:45.60,JP,,0000,0000,0000,,Мен оқуды дұрыс бітіре аламын.
Dialogue: 0,1:35:49.56,1:35:50.22,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:35:51.98,1:35:53.22,JP,,0000,0000,0000,,Қайырлы түн.
Dialogue: 0,1:35:53.53,1:35:54.55,JP,,0000,0000,0000,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:35:55.01,1:35:56.54,JP,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,1:35:57.84,1:35:58.50,JP,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:35:58.92,1:36:02.45,JP,,0000,0000,0000,,Университетке түссек те бәріміз бірге шай ішеміз.
Dialogue: 0,1:36:04.79,1:36:07.14,JP,,0000,0000,0000,,Әрине, менің ойымша.
Dialogue: 0,1:36:07.55,1:36:09.99,JP,,0000,0000,0000,,Өлім төсегінде жатқан Командантан хат бар
Dialogue: 0,1:36:10.75,1:36:12.52,JP,,0000,0000,0000,,Олай болса, бұл жолы қайырлы түн.
Dialogue: 0,1:36:16.02,1:36:17.11,JP,,0000,0000,0000,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,1:36:31.09,1:36:39.95,JP,,0000,0000,0000,,Бірақ мен керемет котенканы кездестірдім.
Dialogue: 0,1:36:52.02,1:36:53.85,JP,,0000,0000,0000,,Әй, тез, тез!
Dialogue: 0,1:36:53.85,1:36:55.13,JP,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,1:36:55.22,1:36:56.35,JP,,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,1:37:19.83,1:37:20.48,JP,,0000,0000,0000,,Юи
Dialogue: 0,1:37:23.18,1:37:24.15,JP,,0000,0000,0000,,Ашық болды.
Dialogue: 0,1:37:54.81,1:37:56.05,JP,,0000,0000,0000,,Неричан
Dialogue: 0,1:37:56.05,1:37:56.86,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:37:57.68,1:37:59.71,JP,,0000,0000,0000,,Мен жақсы ойнай аламын ба?
Dialogue: 0,1:38:00.57,1:38:04.98,JP,,0000,0000,0000,,Мен бұрын-соңды болмаған қобалжыдым.
Dialogue: 0,1:38:08.40,1:38:09.36,JP,,0000,0000,0000,,Мен де
Dialogue: 0,1:38:11.60,1:38:13.84,JP,,0000,0000,0000,,Менің қолым қатты суық.
Dialogue: 0,1:38:15.72,1:38:16.80,JP,,0000,0000,0000,,Бұл рас
Dialogue: 0,1:38:18.91,1:38:21.27,JP,,0000,0000,0000,,Мен қобалжыдым.
Dialogue: 0,1:38:23.17,1:38:24.64,JP,,0000,0000,0000,,Қауіпті
Dialogue: 0,1:38:25.37,1:38:26.51,JP,,0000,0000,0000,,Мен бәрібір тоқтаймын
Dialogue: 0,1:38:26.51,1:38:27.39,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,1:38:28.06,1:38:29.85,JP,,0000,0000,0000,,Азуса-чан, сен қалай ойлайсың?
Dialogue: 0,1:38:29.85,1:38:31.73,JP,,0000,0000,0000,,Мен сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,1:38:34.54,1:38:38.02,JP,,0000,0000,0000,,Жақсы, барлығының көңілдері көтерілді.
Dialogue: 0,1:38:38.28,1:38:39.58,JP,,0000,0000,0000,,Әрине
Dialogue: 0,1:39:17.57,1:39:23.39,JP,,0000,0000,0000,,Мен Риччан мен басқалардың ойнағанын бірінші рет естігенімде «Маған қанат беріңіз» болды.
Dialogue: 0,1:39:24.02,1:39:26.71,JP,,0000,0000,0000,,Сонымен төртеуміз жеңіл музыка бөлімін бастадық.
Dialogue: 0,1:39:27.59,1:39:29.26,JP,,0000,0000,0000,,Азуса кіріп келді
Dialogue: 0,1:39:29.60,1:39:31.49,JP,,0000,0000,0000,,Сіз әлдеқайда көп күшке ие болдыңыз, солай емес пе?
Dialogue: 0,1:39:32.14,1:39:34.86,JP,,0000,0000,0000,,Азусаның кесу дыбысты қаттырақ етеді.
Dialogue: 0,1:39:35.21,1:39:37.42,JP,,0000,0000,0000,,Юи – күшті техника.
Dialogue: 0,1:39:37.42,1:39:38.59,JP,,0000,0000,0000,,Сіз оны айтпайсыз.
Dialogue: 0,1:39:39.37,1:39:44.56,JP,,0000,0000,0000,,Қарасам, маған қанат берген Азунян болды.
Dialogue: 0,1:39:46.67,1:39:50.00,JP,,0000,0000,0000,,Азунян бізді қуантты
Dialogue: 0,1:39:50.12,1:39:52.49,JP,,0000,0000,0000,,Бұл кішкентай және сүйкімді періште.
Dialogue: 0,1:39:52.92,1:39:54.08,JP,,0000,0000,0000,,Періште дегеніміз не?
Dialogue: 0,1:39:54.08,1:39:55.55,JP,,0000,0000,0000,,Мүмкін солай шығар.
Dialogue: 0,1:39:59.77,1:40:00.43,JP,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:40:02.15,1:40:12.14,JP,,0000,0000,0000,,Бірақ, мен керемет періштені кездестірдім.
Dialogue: 0,1:40:12.81,1:40:13.90,JP,,0000,0000,0000,,Бұл шынымен де…
Dialogue: 0,1:40:13.90,1:40:14.79,JP,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,1:40:15.15,1:40:17.03,JP,,0000,0000,0000,,Кішкене ұялмайсың ба?
Dialogue: 0,1:40:17.03,1:40:18.99,JP,,0000,0000,0000,,Жоқ, менің ойымша, бұл өте жақсы.
Dialogue: 0,1:40:19.13,1:40:21.82,JP,,0000,0000,0000,,Қызық, бұл ән де Азунянның қанаты бола ма?
Dialogue: 0,1:40:23.80,1:40:26.42,JP,,0000,0000,0000,,айналады деп ойлағым келеді
Dialogue: 0,1:40:26.92,1:40:29.68,JP,,0000,0000,0000,,Көрдім, мен көп жинадым.
Dialogue: 0,1:40:30.02,1:40:33.09,JP,,0000,0000,0000,,Азуса-чанға көп сезім
Dialogue: 0,1:40:35.37,1:40:37.22,JP,,0000,0000,0000,,Сізге ұнайды деп үміттенемін.
Dialogue: 0,1:40:42.00,1:40:43.37,JP,,0000,0000,0000,,Шай ішейік пе?
Dialogue: 0,1:40:43.63,1:40:44.43,JP,,0000,0000,0000,,That's right.
Dialogue: 0,1:40:49.29,1:40:51.00,JP,,0000,0000,0000,,Қызыл және ақ манжу жейміз
Dialogue: 0,1:40:51.14,1:40:52.66,JP,,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,1:40:53.45,1:40:55.54,JP,,0000,0000,0000,,Аа, бұл Азунянға арналған.
Dialogue: 0,1:40:57.73,1:40:59.81,JP,,0000,0000,0000,,Эй, оны қалай қиып аламын?
Dialogue: 0,1:41:01.25,1:41:02.88,JP,,0000,0000,0000,,Менен, менеджерден бастайық.
Dialogue: 0,1:41:03.32,1:41:06.14,JP,,0000,0000,0000,,Азуса: Мен сенің тыңдағаныңды қалайтын ән бар.
Dialogue: 0,1:41:07.81,1:41:08.97,JP,,0000,0000,0000,,Келесі бидай болады.
Dialogue: 0,1:41:09.26,1:41:12.04,JP,,0000,0000,0000,,Мен оны Азуса-чанға жасадым.
Dialogue: 0,1:41:12.27,1:41:14.22,JP,,0000,0000,0000,,Жақсы, жақсы айта аламын ба?
Dialogue: 0,1:41:14.22,1:41:16.44,JP,,0000,0000,0000,,Күлме, Муги-чан
Dialogue: 0,1:41:18.41,1:41:19.48,JP,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:41:20.57,1:41:23.00,JP,,0000,0000,0000,,Біз бұл туралы сөйлескен сайын
Dialogue: 0,1:41:24.76,1:41:26.01,JP,,0000,0000,0000,,Азуса
Dialogue: 0,1:41:26.78,1:41:27.90,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:41:28.93,1:41:32.08,JP,,0000,0000,0000,,Мен бүгін шәй қайнатсам ба деп ойладым.
Dialogue: 0,1:41:33.81,1:41:35.08,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,1:41:46.00,1:41:48.14,JP,,0000,0000,0000,,Азунян, мұнда кел
Dialogue: 0,1:42:32.43,1:42:33.49,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:45:15.74,1:45:18.25,JP,,0000,0000,0000,,Азунян, сен бақытты едің ғой?
Dialogue: 0,1:45:18.32,1:45:19.03,JP,,0000,0000,0000,,Иә
Dialogue: 0,1:45:20.24,1:45:22.30,JP,,0000,0000,0000,,Ой, Акияма-сан, сен жылап тұрсың ба?
Dialogue: 0,1:45:22.30,1:45:24.86,JP,,0000,0000,0000,,Эй, менің мұрным бітеліп қалды.
Dialogue: 0,1:45:25.02,1:45:27.18,JP,,0000,0000,0000,,Менің жылауға уақытым жоқ, Мио-чан.
Dialogue: 0,1:45:27.38,1:45:30.26,JP,,0000,0000,0000,,Иә, біз университет студенттеріміз.
Dialogue: 0,1:45:30.49,1:45:32.64,JP,,0000,0000,0000,,Балалар, сендер оң көзқарастасыңдар.
Dialogue: 0,1:45:32.99,1:45:36.64,JP,,0000,0000,0000,,Шай кезінде жейтін тәттілер де сәл пісіп-жетілген болуы керек.
Dialogue: 0,1:45:36.64,1:45:37.58,JP,,0000,0000,0000,,Рас
Dialogue: 0,1:45:37.58,1:45:38.64,JP,,0000,0000,0000,,Бұл бар ма?
Dialogue: 0,1:45:40.50,1:45:41.97,JP,,0000,0000,0000,,Аа, мен аяғымнан тұрдым.
Dialogue: 0,1:45:42.10,1:45:46.82,JP,,0000,0000,0000,,Ойланып қарасам, «Өлім Ібіліс» әні де менің кіші сынып оқушыларым үшін жасалған.
Dialogue: 0,1:45:46.82,1:45:47.87,JP,,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,1:45:47.99,1:45:50.40,JP,,0000,0000,0000,,Адамдардың сезімталдығы әртүрлі.
Dialogue: 0,1:45:50.94,1:45:54.88,JP,,0000,0000,0000,,Міне, біз дәстүрді дұрыс мұра етіп алдық.
Dialogue: 0,1:45:54.88,1:45:56.51,JP,,0000,0000,0000,,Қандай кездейсоқтық.
Dialogue: 0,1:45:59.14,1:46:01.59,JP,,0000,0000,0000,,Иә, келесі жылы қайда барасың?
Dialogue: 0,1:46:01.59,1:46:02.57,JP,,0000,0000,0000,,Келесі жыл
Dialogue: 0,1:46:02.98,1:46:04.96,JP,,0000,0000,0000,,Азунянның дипломдық сапары
Dialogue: 0,1:46:05.26,1:46:06.68,JP,,0000,0000,0000,,Сіз барасыз ба?
Dialogue: 0,1:46:07.09,1:46:08.14,JP,,0000,0000,0000,,Кеттік
Dialogue: 0,0:01:23.84,0:01:24.58,CN,,0000,0000,0000,,Ерте бітірді
Dialogue: 0,0:02:02.23,0:02:03.51,CN,,0000,0000,0000,,Нагаго клубының бөлмесі Ryo
Dialogue: 0,0:02:04.15,0:02:05.23,CN,,0000,0000,0000,,Жақсы жүгіру
Dialogue: 0,0:02:05.23,0:02:06.01,CN,,0000,0000,0000,,Хобо
Dialogue: 0,0:02:32.44,0:02:34.09,CN,,0000,0000,0000,,биік аспан
Dialogue: 0,0:02:37.43,0:02:38.28,CN,,0000,0000,0000,,Фуку
Dialogue: 0,0:02:40.15,0:02:42.75,CN,,0000,0000,0000,,«Мектептен кейінгі шай ішу» музыкасы
Dialogue: 0,0:02:43.94,0:02:45.54,CN,,0000,0000,0000,,Мұны істеу заңсыз.
Dialogue: 0,0:02:46.79,0:02:50.18,CN,,0000,0000,0000,,Дегенмен, бұл менің қиялымның жолы.
Dialogue: 0,0:02:50.94,0:02:52.15,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:02:52.76,0:02:56.03,CN,,0000,0000,0000,,Юйоу позицияда Юи позициясында...
Dialogue: 0,0:02:56.03,0:02:57.99,CN,,0000,0000,0000,,Сіздің демалысыңыздан ләззат алу
Dialogue: 0,0:02:58.89,0:03:01.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:04.30,0:03:07.46,CN,,0000,0000,0000,,Цюнеон клубы таратылуы мүмкін
Dialogue: 0,0:03:07.78,0:03:10.26,CN,,0000,0000,0000,,Еріту
Dialogue: 0,0:03:10.61,0:03:13.70,CN,,0000,0000,0000,,Қожайынның бағытқа ұмтылуы.
Dialogue: 0,0:03:14.45,0:03:17.15,CN,,0000,0000,0000,,Міне, сіз айырмашылықты сезінесіз.
Dialogue: 0,0:03:17.51,0:03:19.28,CN,,0000,0000,0000,,Ләззат сезімі
Dialogue: 0,0:03:19.28,0:03:23.60,CN,,0000,0000,0000,,Мен бір жазбаны ұмытып қалдым, бірақ маған үш нота қатты әсер етті.
Dialogue: 0,0:03:23.60,0:03:26.67,CN,,0000,0000,0000,,Сяо Мио - Тайваньдағы дарынды адам.
Dialogue: 0,0:03:26.67,0:03:28.47,CN,,0000,0000,0000,,N...
Dialogue: 0,0:03:28.47,0:03:31.29,CN,,0000,0000,0000,,Оны оқығанда мен өзімді ыңғайсыз сезінемін.
Dialogue: 0,0:03:32.26,0:03:33.94,CN,,0000,0000,0000,,Сяо Азуса
Dialogue: 0,0:03:34.12,0:03:35.27,CN,,0000,0000,0000,,Осымен
Dialogue: 0,0:03:35.27,0:03:39.73,CN,,0000,0000,0000,,Мен ``Мектептен кейінгі шай кешін'' көрдім және оның жақсы сәйкестік екені анық...
Dialogue: 0,0:03:39.73,0:03:40.58,CN,,0000,0000,0000,,Ескі әңгіме
Dialogue: 0,0:03:41.74,0:03:43.27,CN,,0000,0000,0000,,Әртүрлі әндер
Dialogue: 0,0:03:45.00,0:03:46.05,CN,,0000,0000,0000,,Егер батырманы бассам, орындықтың электрлік арқалығы артқа қисайады
Dialogue: 0,0:03:46.05,0:03:47.39,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:03:47.54,0:03:48.87,CN,,0000,0000,0000,,Сіз тілді енгіздіңіз
Dialogue: 0,0:03:48.87,0:03:51.94,CN,,0000,0000,0000,,«Музыкалық клуб музыка ойнап жатыр».
Dialogue: 0,0:03:51.94,0:03:53.73,CN,,0000,0000,0000,,Менің ойым рас.
Dialogue: 0,0:03:53.73,0:03:54.26,CN,,0000,0000,0000,,Они тақтайшасы
40-бөлім
Dialogue: 0,0:03:54.26,0:03:58.37,CN,,0000,0000,0000,,「 」
Dialogue: 0,0:03:58.37,0:04:00.15,CN,,0000,0000,0000,,Бөлім...Мен лотереядан келдім
Dialogue: 0,0:04:00.15,0:04:01.46,CN,,0000,0000,0000,,Коазуса
Dialogue: 0,0:04:01.86,0:04:05.21,CN,,0000,0000,0000,,Мен үшін қатысу, коммерциялық дыбысты тыңдай алу, өмір немесе өлім болсын, музыканы тыңдай алу маңызды.
Dialogue: 0,0:04:05.36,0:04:06.08,CN,,0000,0000,0000,,Азуса
Dialogue: 0,0:04:06.27,0:04:06.94,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:07.44,0:04:08.96,CN,,0000,0000,0000,,Мен ойнауға келдім.
Dialogue: 0,0:04:09.53,0:04:10.04,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:10.49,0:04:15.01,CN,,0000,0000,0000,,Шыны керек, клубқа сенбей кірдім.
Dialogue: 0,0:04:15.01,0:04:17.28,CN,,0000,0000,0000,,Котоба Фукигучи
Dialogue: 0,0:04:17.28,0:04:19.58,CN,,0000,0000,0000,,Менің айтып отырғаным осы.
Dialogue: 0,0:04:19.58,0:04:21.01,CN,,0000,0000,0000,,Төтенше жағдайда тоқтату
Dialogue: 0,0:04:21.27,0:04:22.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:23.79,0:04:24.67,CN,,0000,0000,0000,,Шағын қорап
Dialogue: 0,0:04:24.74,0:04:25.68,CN,,0000,0000,0000,,䌷
Dialogue: 0,0:04:27.57,0:04:29.40,CN,,0000,0000,0000,,Әңгіменің шығу тегі
Dialogue: 0,0:04:29.40,0:04:32.04,CN,,0000,0000,0000,,Шағын жеткізу
Dialogue: 0,0:04:32.04,0:04:33.86,CN,,0000,0000,0000,,Сіз алуға болатын ең жоғары деңгей
Dialogue: 0,0:04:33.86,0:04:35.95,CN,,0000,0000,0000,,Шығыс пен батыстан шығыс пен батыстан
Dialogue: 0,0:04:35.95,0:04:37.68,CN,,0000,0000,0000,,Нама құшақтап жатыр
Dialogue: 0,0:04:37.90,0:04:38.90,CN,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:04:38.90,0:04:40.41,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:40.41,0:04:41.98,CN,,0000,0000,0000,,Бұл...бұл...бұл кішкентай ереже, оған тұрарлық емес.
Dialogue: 0,0:04:42.04,0:04:44.13,CN,,0000,0000,0000,,Аспанда жоғалған
Dialogue: 0,0:04:44.13,0:04:45.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:48.62,0:04:49.99,CN,,0000,0000,0000,,Бұл дұрыс ән емес.
Dialogue: 0,0:05:03.51,0:05:04.98,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:05:05.77,0:05:06.75,CN,,0000,0000,0000,,Ол пайда болды ма?
Dialogue: 0,0:05:07.43,0:05:08.99,CN,,0000,0000,0000,,«Өлім шайтан» ойынын ойнаймын
Dialogue: 0,0:05:09.36,0:05:11.00,CN,,0000,0000,0000,,Жүректі жақсы ашады
Dialogue: 0,0:05:11.99,0:05:15.20,CN,,0000,0000,0000,,Тренингтің қайталануын күтудің қажеті жоқ.
Dialogue: 0,0:05:15.45,0:05:17.64,CN,,0000,0000,0000,,Сіз ақшаңызды салған кезде
Dialogue: 0,0:05:18.51,0:05:19.68,CN,,0000,0000,0000,,Сіз спектакльдесіз
Dialogue: 0,0:05:19.85,0:05:22.08,CN,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:22.25,0:05:26.26,CN,,0000,0000,0000,,1-ші сынақ музыкалық философияда ерте аяқталды
Dialogue: 0,0:05:26.62,0:05:28.61,CN,,0000,0000,0000,,Әр адамның капиталы болады.
Dialogue: 0,0:05:29.10,0:05:30.38,CN,,0000,0000,0000,,артқа
Dialogue: 0,0:05:29.21,0:05:31.47,CN,,0000,0000,0000,,Мен бұл жолы осылай ойладым.
Dialogue: 0,0:05:32.11,0:05:34.30,CN,,0000,0000,0000,,На Коазуса келді...
Dialogue: 0,0:05:34.30,0:05:35.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:38.37,0:05:39.60,CN,,0000,0000,0000,,Шай шыныаяқ шай
Dialogue: 0,0:05:39.80,0:05:41.41,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:26.84,0:07:28.93,CN,,0000,0000,0000,,Ерекше дарындылықты дамыту туралы рефлексия кездесуі
Dialogue: 0,0:07:28.93,0:07:33.25,CN,,0000,0000,0000,,Кішкентай Азуса есіме тағы келді.
Dialogue: 0,0:07:33.79,0:07:36.15,CN,,0000,0000,0000,,Жаттығудан бас тарту туралы рефлексия
Dialogue: 0,0:07:36.57,0:07:39.21,CN,,0000,0000,0000,,Мен кішкентай шошқа жазуға қаншалықты дарынды екенімді білгенде
Dialogue: 0,0:07:40.85,0:07:42.19,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:07:42.43,0:07:44.36,CN,,0000,0000,0000,,Жалға берушінің қызметі
Dialogue: 0,0:07:44.79,0:07:47.66,CN,,0000,0000,0000,,Мен «Тайко Шоурё» деген шағын фразаны көріп тұрмын, оның да сәйкес келмейтін тұстары бар.
Dialogue: 0,0:07:48.60,0:07:49.28,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:07:51.00,0:07:51.84,CN,,0000,0000,0000,,Қарсы болма
Dialogue: 0,0:07:51.84,0:07:53.09,CN,,0000,0000,0000,,Өздігінен бөлек әңгімелеу
Dialogue: 0,0:07:53.78,0:07:58.49,CN,,0000,0000,0000,,Мен белгісіз шындыққа кірдім, бірақ бұл дискурсивті бөлік.
Басқа түсініктеме алу үшін
Dialogue: 0,0:07:58.62,0:08:00.53,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:00.74,0:08:01.77,CN,,0000,0000,0000,,Накача
Dialogue: 0,0:08:02.50,0:08:06.20,CN,,0000,0000,0000,,Қоңырауыңызды алмасаңыз, бізге хабарласыңыз.
Dialogue: 0,0:08:07.35,0:08:09.44,CN,,0000,0000,0000,,Котобуки отбасы көшкеннен бері тәкаппар қызыл түсті
Dialogue: 0,0:08:10.02,0:08:11.74,CN,,0000,0000,0000,,Хохо
Dialogue: 0,0:08:11.84,0:08:14.26,CN,,0000,0000,0000,,䌷
Dialogue: 0,0:08:14.54,0:08:16.59,CN,,0000,0000,0000,,Терінің әр қабатын пиллинг
Dialogue: 0,0:08:16.59,0:08:18.48,CN,,0000,0000,0000,,Тағы бір түсініктеме
Dialogue: 0,0:08:18.48,0:08:20.25,CN,,0000,0000,0000,,Нүктенің шағын және оңай ашылуы
Dialogue: 0,0:08:20.81,0:08:22.35,CN,,0000,0000,0000,,Мүмкін... алуға болады...
Dialogue: 0,0:08:22.35,0:08:28.30,CN,,0000,0000,0000,,Үш жылдан бері сол үй иесі бұл жерде дим-сам, шай, музыка ұсынып жүр...
Dialogue: 0,0:08:25.17,0:08:25.97,CN,,0000,0000,0000,,Келесі кездескенше.
Dialogue: 0,0:08:26.57,0:08:27.44,CN,,0000,0000,0000,,Пайдаланылмаған
Dialogue: 0,0:08:30.87,0:08:33.35,CN,,0000,0000,0000,,Егер сізге қысым көрсетілсе, бұл сіздің бизнесіңіз.
Dialogue: 0,0:08:33.79,0:08:37.86,CN,,0000,0000,0000,,Шындығында бұл мәселеден құтылу мүмкін емес.
Dialogue: 0,0:08:37.86,0:08:40.27,CN,,0000,0000,0000,,Осының арқасында мен академиялық оқуымды аяқтадым.
Dialogue: 0,0:08:40.50,0:08:41.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:42.02,0:08:43.50,CN,,0000,0000,0000,,Шындық – ғажайып
Dialogue: 0,0:08:43.72,0:08:46.23,CN,,0000,0000,0000,,䌷...
Dialogue: 0,0:08:46.23,0:08:49.15,CN,,0000,0000,0000,,т.б.
Dialogue: 0,0:08:47.24,0:08:50.00,CN,,0000,0000,0000,,䌷
Dialogue: 0,0:08:53.71,0:08:54.64,CN,,0000,0000,0000,,Юигакуджи...
Dialogue: 0,0:08:54.95,0:08:56.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:58.18,0:08:59.95,CN,,0000,0000,0000,,ашылды
Dialogue: 0,0:09:01.64,0:09:03.07,CN,,0000,0000,0000,,Нана Келесі қайталаймын
Dialogue: 0,0:09:03.66,0:09:06.51,CN,,0000,0000,0000,,Сол университетті құттықтаймыз
Dialogue: 0,0:09:06.75,0:09:08.43,CN,,0000,0000,0000,,Ганпай
Dialogue: 0,0:09:09.19,0:09:10.70,CN,,0000,0000,0000,,Келесі Азусая Казуки
Dialogue: 0,0:09:10.70,0:09:12.71,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:14.44,0:09:15.99,CN,,0000,0000,0000,,Ганпай
Dialogue: 0,0:09:17.12,0:09:18.34,CN,,0000,0000,0000,,Ганпай
Dialogue: 0,0:09:20.13,0:09:20.89,CN,,0000,0000,0000,,Саваки
Dialogue: 0,0:09:23.07,0:09:25.33,CN,,0000,0000,0000,,Гая Мацугучи аяқталды
Dialogue: 0,0:09:25.73,0:09:27.50,CN,,0000,0000,0000,,Сіз процедураны аяқтадыңыз.
Dialogue: 0,0:09:28.35,0:09:31.09,CN,,0000,0000,0000,,Үшінші курстың сынып жетекшісі өте қатал болды.
Dialogue: 0,0:09:32.48,0:09:34.86,CN,,0000,0000,0000,,Дегенмен, бұл бір көзді табыс.
Dialogue: 0,0:09:35.15,0:09:37.41,CN,,0000,0000,0000,,Шағын бизнеске қойылатын талаптар
Dialogue: 0,0:09:38.15,0:09:42.00,CN,,0000,0000,0000,,Үш жыл ішіп жүрмін, аздап қызарып кетті
Dialogue: 0,0:09:42.29,0:09:44.31,CN,,0000,0000,0000,,1000 шыныаяқ аяқталды
Dialogue: 0,0:09:44.52,0:09:45.68,CN,,0000,0000,0000,,Мың
Dialogue: 0,0:09:45.81,0:09:47.60,CN,,0000,0000,0000,,Әйгілі «Мектептен кейінгі шай кеші»
Dialogue: 0,0:09:48.07,0:09:50.82,CN,,0000,0000,0000,,Жер бетінде пайда болатын физикалық күштердің атаулары
Dialogue: 0,0:09:51.68,0:09:55.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:55.56,0:09:56.96,CN,,0000,0000,0000,,Әңгіме қалай өрбіді?
Dialogue: 0,0:09:57.34,0:09:58.23,CN,,0000,0000,0000,,Сақтау
Dialogue: 0,0:10:02.32,0:10:03.81,CN,,0000,0000,0000,,Төменгі аймақ жиналысы
Dialogue: 0,0:10:04.93,0:10:09.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:10.06,0:10:11.90,CN,,0000,0000,0000,,Маңызды кездесу
Dialogue: 0,0:10:16.39,0:10:20.91,CN,,0000,0000,0000,,... Death devil...
Dialogue: 0,0:10:20.91,0:10:22.51,CN,,0000,0000,0000,,Өлім шайтан Сайбо Рё
Dialogue: 0,0:10:22.51,0:10:24.69,CN,,0000,0000,0000,,Савамен не істерімді білмеймін...
Dialogue: 0,0:10:24.69,0:10:25.75,CN,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:10:25.75,0:10:27.12,CN,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:10:27.96,0:10:31.31,CN,,0000,0000,0000,,Мен сізді осында көруді асыға күтемін.
Dialogue: 0,0:10:31.31,0:10:32.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:32.67,0:10:34.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:34.00,0:10:35.67,CN,,0000,0000,0000,,Қазіргі уақытта мен өлдім.
Dialogue: 0,0:10:35.67,0:10:36.66,CN,,0000,0000,0000,,Мұны қалай айтасыз?
Dialogue: 0,0:10:36.66,0:10:38.97,CN,,0000,0000,0000,,Ересек Савако Яманака Роши
Dialogue: 0,0:10:52.61,0:10:53.41,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:10:55.49,0:10:57.17,CN,,0000,0000,0000,,Зайсу Сайсай Саватаки хикаясы
Dialogue: 0,0:10:57.37,0:10:58.71,CN,,0000,0000,0000,,Мұнда емес...
Dialogue: 0,0:11:02.28,0:11:04.21,CN,,0000,0000,0000,,Бұл сіздің екінші таңдауыңыз.
Dialogue: 0,0:11:09.88,0:11:14.96,CN,,0000,0000,0000,,Студент болып жұмыс істеудің де артықшылығы бар.
Dialogue: 0,0:11:14.96,0:11:16.18,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:11:16.59,0:11:18.05,CN,,0000,0000,0000,,Дарындылықтың жоқтығына байланысты мәселелер
Dialogue: 0,0:11:18.05,0:11:19.42,CN,,0000,0000,0000,,Мен...
Dialogue: 0,0:11:19.42,0:11:20.52,CN,,0000,0000,0000,,Орта мектеп
Dialogue: 0,0:11:20.52,0:11:21.57,CN,,0000,0000,0000,,Ұзындығы
Dialogue: 0,0:11:21.57,0:11:22.34,CN,,0000,0000,0000,,Аричоки
Dialogue: 0,0:11:23.17,0:11:24.34,CN,,0000,0000,0000,,Өлім бөлігі
Dialogue: 0,0:11:24.53,0:11:29.36,CN,,0000,0000,0000,,Мен ойлайтын ең тривиальды нәрсе
Dialogue: 0,0:11:32.89,0:11:34.71,CN,,0000,0000,0000,,Нанако Махаббат
Dialogue: 0,0:11:34.89,0:11:36.64,CN,,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:38.02,0:11:39.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:39.96,0:11:42.09,CN,,0000,0000,0000,,Жеткізу және сыйлық заттарын салыстыру
Dialogue: 0,0:11:42.24,0:11:44.48,CN,,0000,0000,0000,,Шығыс пен Батыс үшін ең қолайлы
Dialogue: 0,0:11:47.25,0:11:48.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:48.45,0:11:50.26,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:11:50.42,0:11:52.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:52.04,0:11:52.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:53.70,0:11:54.96,CN,,0000,0000,0000,,Азуса... Азуса
Dialogue: 0,0:11:55.08,0:11:58.35,CN,,0000,0000,0000,,Шынайы мағына
Dialogue: 0,0:11:58.37,0:12:01.66,CN,,0000,0000,0000,,Мен қайта белсендіру бөлмесін ұмытып кетіппін...
Dialogue: 0,0:12:02.44,0:12:03.84,CN,,0000,0000,0000,,Мұнда келдім
Dialogue: 0,0:12:03.91,0:12:06.67,CN,,0000,0000,0000,,Мен бөлмеде белсенді емеспін.
Dialogue: 0,0:12:06.80,0:12:08.30,CN,,0000,0000,0000,,О тобы, сондай-ақ Балықтар белгісі.
Dialogue: 0,0:12:08.53,0:12:09.53,CN,,0000,0000,0000,,Өсу әлеуеті
Dialogue: 0,0:12:20.24,0:12:22.38,CN,,0000,0000,0000,,Жағдайды түсіну қабілетіне байланысты жағдайлар
Dialogue: 0,0:12:22.49,0:12:26.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:27.29,0:12:29.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:30.49,0:12:34.07,CN,,0000,0000,0000,,Сұрақтарыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:12:34.37,0:12:37.94,CN,,0000,0000,0000,,``үйрендім және үйрендім'' деген сөздер көп.
Dialogue: 0,0:12:38.14,0:12:39.45,CN,,0000,0000,0000,,Ұйқы...
Dialogue: 0,0:12:39.69,0:12:41.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:42.72,0:12:47.09,CN,,0000,0000,0000,,«Нағыз үміт, сіздің жаттығудың шынайы нүктесін растау қабілетіңіз».
Dialogue: 0,0:12:47.53,0:12:51.81,CN,,0000,0000,0000,,``Аз мөлшердегі энергияны жинау мақсатында жұмыс бөлмесі сәтті аяқталды.''
Dialogue: 0,0:12:52.22,0:12:55.69,CN,,0000,0000,0000,,«Басқа адам - өмір сүретін және өмір сүретін».
Dialogue: 0,0:12:56.00,0:12:57.50,CN,,0000,0000,0000,,Әпке
Dialogue: 0,0:12:58.12,0:13:00.35,CN,,0000,0000,0000,,Бұл әдеттегі уақытта жиі кездесетін әңгіме.
Dialogue: 0,0:13:04.15,0:13:08.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:08.46,0:13:09.23,CN,,0000,0000,0000,,Мен де ондай нәрсені түсінемін
Dialogue: 0,0:13:09.97,0:13:14.00,CN,,0000,0000,0000,,Аудио бөлімінің жағдайлары
Dialogue: 0,0:13:14.35,0:13:15.35,CN,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:13:15.43,0:13:16.52,CN,,0000,0000,0000,,Шын мән
Dialogue: 0,0:13:18.51,0:13:21.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:22.16,0:13:24.59,CN,,0000,0000,0000,,Музыка бөліміне қосылған таланттар
Dialogue: 0,0:13:25.93,0:13:27.89,CN,,0000,0000,0000,,Мәліметтерді растаңыз.
Dialogue: 0,0:13:30.26,0:13:34.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:34.74,0:13:35.39,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:13:38.10,0:13:38.64,CN,,0000,0000,0000,,Ой...
Dialogue: 0,0:13:38.96,0:13:41.73,CN,,0000,0000,0000,,Менің әпкем менімен ойнап жүр.
Dialogue: 0,0:13:58.04,0:13:59.06,CN,,0000,0000,0000,,Азуса
Dialogue: 0,0:14:02.32,0:14:04.40,CN,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:20.04,0:14:21.18,CN,,0000,0000,0000,,Кіші Юи
Dialogue: 0,0:14:22.26,0:14:24.78,CN,,0000,0000,0000,,䌷
Dialogue: 0,0:14:26.14,0:14:28.02,CN,,0000,0000,0000,,Ариошита мөрі
Dialogue: 0,0:14:28.29,0:14:29.89,CN,,0000,0000,0000,,Мен оянып, ұйықтап қалдым
Dialogue: 0,0:14:31.14,0:14:32.39,CN,,0000,0000,0000,,Суық сүйгіш Суық сүйгіш
Dialogue: 0,0:14:33.54,0:14:35.49,CN,,0000,0000,0000,,Кішкентай шебердің қолы
Dialogue: 0,0:14:35.49,0:14:36.21,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:14:36.79,0:14:37.86,CN,,0000,0000,0000,,Шағын құқық Кіші құқық
Dialogue: 0,0:14:37.86,0:14:38.62,CN,,0000,0000,0000,,Ондық
Dialogue: 0,0:14:38.62,0:14:41.46,CN,,0000,0000,0000,,Менің бұрынғы әнімнің жаңа сөзі
Dialogue: 0,0:14:41.46,0:14:44.76,CN,,0000,0000,0000,,「TA」
Dialogue: 0,0:14:45.24,0:14:47.27,CN,,0000,0000,0000,,Әнді тыңдау
Dialogue: 0,0:14:47.86,0:14:49.38,CN,,0000,0000,0000,,Комио шағын заңы
Dialogue: 0,0:14:50.39,0:14:51.48,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:14:51.53,0:14:52.58,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:14:53.09,0:14:55.98,CN,,0000,0000,0000,,Когионың қолдары жылы, тер.
Dialogue: 0,0:14:56.16,0:14:59.35,CN,,0000,0000,0000,,Акияма Коджидің қолдары салқын және суық.
Dialogue: 0,0:14:59.64,0:15:00.67,CN,,0000,0000,0000,,Бэбифейс
Dialogue: 0,0:15:01.69,0:15:03.92,CN,,0000,0000,0000,,Сыйлықты сыйлыққа жіберу кезінде
Dialogue: 0,0:15:04.09,0:15:04.87,CN,,0000,0000,0000,,Кішкентай қыз
Dialogue: 0,0:15:05.07,0:15:07.27,CN,,0000,0000,0000,,Менің ойыма бір ой келді де, ұйқыға кеттім.
Dialogue: 0,0:15:07.27,0:15:09.91,CN,,0000,0000,0000,,Мен ұйықтауға дайынмын.
Dialogue: 0,0:15:09.91,0:15:11.43,CN,,0000,0000,0000,,Менің ұйқым келіп тұр
Dialogue: 0,0:15:11.49,0:15:12.53,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:15:12.53,0:15:14.54,CN,,0000,0000,0000,,Комио Макото Кайхатсу
Dialogue: 0,0:15:14.54,0:15:15.98,CN,,0000,0000,0000,,Мен жай ғана айтып тұрмын.
Dialogue: 0,0:15:16.45,0:15:19.77,CN,,0000,0000,0000,,Ерте шығу
Dialogue: 0,0:15:17.79,0:15:19.45,CN,,0000,0000,0000,,Хаяками Йоши Райтоку Шинсая
Dialogue: 0,0:15:19.90,0:15:22.61,CN,,0000,0000,0000,,Мектепте бүгінгі дарынды жапон шеберлері көрінеді.
Dialogue: 0,0:15:23.73,0:15:25.02,CN,,0000,0000,0000,,Өлмеген...
Dialogue: 0,0:15:25.28,0:15:26.67,CN,,0000,0000,0000,,Кова Хаяками
Dialogue: 0,0:15:26.67,0:15:27.57,CN,,0000,0000,0000,,Йоши Хаяками
Dialogue: 0,0:15:28.43,0:15:30.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:30.69,0:15:32.54,CN,,0000,0000,0000,,Мен кеткен соң суға түстім.
Dialogue: 0,0:15:32.91,0:15:35.16,CN,,0000,0000,0000,,Мен бірінші өткен жаз Вэймін.
Dialogue: 0,0:15:35.67,0:15:37.88,CN,,0000,0000,0000,,䌷
Dialogue: 0,0:15:38.15,0:15:38.74,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:15:39.38,0:15:41.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:41.76,0:15:43.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:44.13,0:15:46.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:48.62,0:15:49.61,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:49.65,0:15:50.78,CN,,0000,0000,0000,,ретке келтіру
Dialogue: 0,0:15:50.78,0:15:51.89,CN,,0000,0000,0000,,Нұсқаулық...
Dialogue: 0,0:15:52.08,0:15:54.67,CN,,0000,0000,0000,,Волейбол клубына іссапар қажет
Dialogue: 0,0:15:54.88,0:15:55.91,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:15:55.91,0:15:57.52,CN,,0000,0000,0000,,Мен кеткен кезде
Dialogue: 0,0:15:58.04,0:15:59.25,CN,,0000,0000,0000,,Сіз кеткен кезде
Dialogue: 0,0:15:59.97,0:16:01.77,CN,,0000,0000,0000,,Литургияға дейінгі бір жұлдызды кезең
Dialogue: 0,0:16:01.97,0:16:03.53,CN,,0000,0000,0000,,Уақыт қатынасының қолайлылығы
Dialogue: 0,0:16:03.84,0:16:05.15,CN,,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:16:05.29,0:16:07.14,CN,,0000,0000,0000,,Көктемнің аяғына дейін
Dialogue: 0,0:16:07.44,0:16:09.41,CN,,0000,0000,0000,,Мен кеткен кезде
Dialogue: 0,0:16:09.62,0:16:14.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:14.40,0:16:16.15,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:16:16.99,0:16:21.41,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:21.41,0:16:22.84,CN,,0000,0000,0000,,Үй иесі: Назар аударыңыз
Dialogue: 0,0:16:23.07,0:16:27.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:27.68,0:16:28.75,CN,,0000,0000,0000,,Жалға берушінің келісімі
Dialogue: 0,0:16:28.89,0:16:30.84,CN,,0000,0000,0000,,Әрине, құпияны сақтау маңызды.
Dialogue: 0,0:16:30.84,0:16:32.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:32.01,0:16:33.38,CN,,0000,0000,0000,,Міндетті оқу
Dialogue: 0,0:16:34.15,0:16:35.53,CN,,0000,0000,0000,,Мектеп әнін айту
Dialogue: 0,0:16:37.70,0:16:40.00,CN,,0000,0000,0000,,Савако ескі мектебінің мұғалімі
Dialogue: 0,0:16:40.00,0:16:41.23,CN,,0000,0000,0000,,Персонал
Dialogue: 0,0:16:41.54,0:16:43.13,CN,,0000,0000,0000,,Inko
Dialogue: 0,0:16:43.13,0:16:45.93,CN,,0000,0000,0000,,Біздің іссапарымыз
Dialogue: 0,0:16:45.93,0:16:47.86,CN,,0000,0000,0000,,Басталды
Dialogue: 0,0:16:47.86,0:16:51.60,CN,,0000,0000,0000,,Егжей-тегжейлі ойлау
Dialogue: 0,0:16:51.80,0:16:54.97,CN,,0000,0000,0000,,Алғашқы ойды сыйлық дүкеніне жіберудің қажеті жоқ.
Dialogue: 0,0:16:55.32,0:16:58.65,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:58.65,0:16:59.79,CN,,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:17:00.25,0:17:03.40,CN,,0000,0000,0000,,Қаладағы заттар туралы әңгімелеу және қалаға қайту
Dialogue: 0,0:17:03.84,0:17:05.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:06.45,0:17:09.13,CN,,0000,0000,0000,,Мен сені тыңдау үшін келдім.
Dialogue: 0,0:17:09.79,0:17:11.41,CN,,0000,0000,0000,,Жақында
Dialogue: 0,0:17:11.63,0:17:13.71,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:14.09,0:17:15.82,CN,,0000,0000,0000,,Төменде сіз суреттесіз.
Dialogue: 0,0:17:16.07,0:17:17.87,CN,,0000,0000,0000,,Құстардың суреті
Dialogue: 0,0:17:18.02,0:17:20.05,CN,,0000,0000,0000,,Тақырып бойынша соңғы зерттеу...
Dialogue: 0,0:17:20.05,0:17:21.81,CN,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:17:21.99,0:17:26.65,CN,,0000,0000,0000,,Менің мектепте оқығаныма бір жыл болды.
