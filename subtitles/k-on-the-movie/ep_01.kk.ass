Dialogue: 0,1:16:56.67,1:16:57.75,CN,,0000,0000,0000,,Дүкен қай жерде
Dialogue: 0,1:16:58.06,1:16:59.03,CN,,0000,0000,0000,,Аяқты
Dialogue: 0,1:16:59.16,1:17:01.18,CN,,0000,0000,0000,,...
Dialogue: 0,1:17:01.73,1:17:03.05,CN,,0000,0000,0000,,Ацушимен кездесудің уақыты келді ме?
Dialogue: 0,1:17:03.46,1:17:04.51,CN,,0000,0000,0000,,Келесі бал айы?
Dialogue: 0,1:17:05.05,1:17:06.69,CN,,0000,0000,0000,,Себебі менде көбірек саяхат бағыты бар
Dialogue: 0,1:17:07.98,1:17:10.93,CN,,0000,0000,0000,,Саке клубының ережелері және клуб мүшелерін пайдалану.
Dialogue: 0,1:17:11.20,1:17:13.74,CN,,0000,0000,0000,,Қабылдамау әрекет ету мерзімінің соңында келу үшін қажет
Dialogue: 0,1:17:14.01,1:17:16.25,CN,,0000,0000,0000,,Дегенмен, мен музыка бөлімін пайдалана аламын.
Dialogue: 0,1:17:16.74,1:17:17.92,CN,,0000,0000,0000,,Ол қашан келеді?
Dialogue: 0,1:17:17.92,1:17:19.00,CN,,0000,0000,0000,,Өткен жылғы келу
Dialogue: 0,1:17:19.23,1:17:20.16,CN,,0000,0000,0000,,Уақыты келгенде
Dialogue: 0,1:17:20.48,1:17:21.19,CN,,0000,0000,0000,,Бүгін кеш
Dialogue: 0,1:17:21.26,1:17:22.68,CN,,0000,0000,0000,,Ересектердің шынайы зияны
Dialogue: 0,1:17:22.76,1:17:24.72,CN,,0000,0000,0000,,Мен өзімнен озғым келмейді.
Dialogue: 0,1:17:25.08,1:17:28.12,CN,,0000,0000,0000,,Қонақ үйге хабарлассам, сізбен байланыса алмаймын.
Dialogue: 0,1:17:28.47,1:17:30.76,CN,,0000,0000,0000,,...
Dialogue: 0,1:17:31.12,1:17:33.94,CN,,0000,0000,0000,,Мен мұнда келгенде ерекше киімдерді көруге келдім.
Dialogue: 0,1:17:34.73,1:17:37.07,CN,,0000,0000,0000,,Жапон ханымының ниндзясы
Dialogue: 0,1:17:37.07,1:17:38.08,CN,,0000,0000,0000,,Әйел Ниндзя аузы
Dialogue: 0,1:17:38.13,1:17:40.47,CN,,0000,0000,0000,,Уау Браво Браво
Dialogue: 0,1:17:40.47,1:17:41.93,CN,,0000,0000,0000,,...
Dialogue: 0,1:17:41.93,1:17:43.04,CN,,0000,0000,0000,,Осы бетті қараңыз
Dialogue: 0,1:17:43.90,1:17:45.00,CN,,0000,0000,0000,,Кова
