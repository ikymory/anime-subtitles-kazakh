Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.63,0:00:12.80,Default,,0,0,0,,Эй
Dialogue: 0,0:00:13.30,0:00:15.05,Default,,0,0,0,,Бұл секундына 5 сантиметр.
Dialogue: 0,0:00:15.22,0:00:16.97,Default,,0,0,0,,Не?
Dialogue: 0,0:00:17.10,0:00:21.47,Default,,0,0,0,,Шие гүлінің түсу жылдамдығы секундына 5 сантиметр.
Dialogue: 0,0:00:21.60,0:00:22.98,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:00:23.31,0:00:25.65,Default,,0,0,0,,Акари Сіз мұны өте жақсы білесіз.
Dialogue: 0,0:00:25.81,0:00:26.65,Default,,0,0,0,,Фуфун
Dialogue: 0,0:00:28.15,0:00:31.90,Default,,0,0,0,,Әй, бұл қарға ұқсайды, солай емес пе?
Dialogue: 0,0:00:32.32,0:00:33.65,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:00:33.82,0:00:34.49,Default,,0,0,0,,Ах
Dialogue: 0,0:00:34.65,0:00:36.32,Default,,0,0,0,,Хахаха
Dialogue: 0,0:00:36.70,0:00:37.41,Default,,0,0,0,,Эй!
Dialogue: 0,0:00:37.91,0:00:39.58,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:00:40.91,0:00:45.33,Default,,0,0,0,,(Темір жол өткелінің дыбысы)
Dialogue: 0,0:00:45.71,0:00:46.54,Default,,0,0,0,,Акари!
Dialogue: 0,0:00:46.71,0:00:47.42,Default,,0,0,0,,Такаки-кун
Dialogue: 0,0:00:50.17,0:00:54.42,Default,,0,0,0,,Келесі жылы шие гүлдерін бірге көреміз деп сенемін!
Dialogue: 0,0:01:07.69,0:01:11.73,Default,,0,0,0,,«Құрметті Такаки Тоно, бұл өте ұзақ уақыт болды.»
Dialogue: 0,0:01:16.70,0:01:18.91,Default,,0,0,0,,«Бұл жерде жазда да ыстық.»
Dialogue: 0,0:01:19.37,0:01:22.62,Default,,0,0,0,,«Бұл Токиоға қарағанда әлдеқайда ыңғайлы».
Dialogue: 0,0:01:22.79,0:01:24.70,Default,,0,0,0,,«Бірақ кейіннен»
Dialogue: 0,0:01:24.83,0:01:28.29,Default,,0,0,0,,«Маған Токиодағы өте ыстық жаз да ұнады.»
Dialogue: 0,0:01:28.54,0:01:30.96,Default,,0,0,0,,«Асфальттың ыстық болғаны сонша, еріп кете жаздады».
Dialogue: 0,0:01:31.13,0:01:33.38,Default,,0,0,0,,«Тіпті тұманның арғы жағындағы зәулім ғимараттар»
Dialogue: 0,0:01:33.51,0:01:36.88,Default,,0,0,0,,«Әмбебап дүкендердегі және метродағы кондиционерлер жеткілікті суық».
Dialogue: 0,0:01:37.51,0:01:41.97,Default,,0,0,0,,«Біз соңғы рет бастауыш мектепті бітіру рәсімінде кездестік.»
Dialogue: 0,0:01:42.10,0:01:44.31,Default,,0,0,0,,«Содан бері жарты жыл өтті».
Dialogue: 0,0:01:44.77,0:01:47.14,Default,,0,0,0,,«Эй Такаки-кун»
Dialogue: 0,0:01:47.39,0:01:50.65,Default,,0,0,0,,«Мені есіңізде ме?»
Dialogue: 0,0:01:54.32,0:01:56.99,Default,,0,0,0,,«Такаки-кунға»
Dialogue: 0,0:01:57.11,0:02:00.32,Default,,0,0,0,,"Жауабыңызға рахмет! Мен бақытты болдым."
Dialogue: 0,0:02:00.87,0:02:05.50,Default,,0,0,0,,«Күз келді. Мұнда күзгі жапырақтар әдемі.»
Dialogue: 0,0:02:05.62,0:02:08.75,Default,,0,0,0,,«Кеше мен жылдың алғашқы жемпірін шығардым».
Dialogue: 0,0:02:08.87,0:02:10.13,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:10.58,0:02:11.50,Default,,0,0,0,,Тоно-кун!
Dialogue: 0,0:02:11.67,0:02:12.84,Default,,0,0,0,,Аға
Dialogue: 0,0:02:13.00,0:02:14.67,Default,,0,0,0,,Не? Махаббат хаты ма?
Dialogue: 0,0:02:14.84,0:02:15.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:15.80,0:02:17.42,Default,,0,0,0,,Барлығын сұрағаным үшін кешіріңіз.
Dialogue: 0,0:02:17.55,0:02:18.76,Default,,0,0,0,,Жоқ, ол көп ұзамай аяқталды.
Dialogue: 0,0:02:18.88,0:02:21.51,Default,,0,0,0,,Рахмет. Ей, сен мектептерді ауыстырып жатқаның рас па?
Dialogue: 0,0:02:21.68,0:02:23.81,Default,,0,0,0,,А, иә, үшінші семестр толық.
Dialogue: 0,0:02:23.93,0:02:24.68,Default,,0,0,0,,Қайда?
Dialogue: 0,0:02:24.85,0:02:27.02,Default,,0,0,0,,Кагосима. Ата-анамның жағдайына байланысты.
Dialogue: 0,0:02:27.18,0:02:28.98,Default,,0,0,0,,Көремін, жалғыз қаламын.
Dialogue: 0,0:02:29.10,0:02:31.69,Default,,0,0,0,,«Жақында мен үйірме жұмыстарына байланысты таңертең ерте тұрамын».
Dialogue: 0,0:02:31.86,0:02:34.69,Default,,0,0,0,,«Мен бұл хатты қазір пойызда жазып жатырмын.»
Dialogue: 0,0:02:34.86,0:02:37.15,Default,,0,0,0,,«Мен басқа күні шашымды алдырдым».
Dialogue: 0,0:02:37.28,0:02:39.45,Default,,0,0,0,,«Мен оны қысқа етіп кесіп алғаным сонша, құлағым шығып кетеді».
Dialogue: 0,0:02:39.95,0:02:41.99,Default,,0,0,0,,«Біз кездессек те, мені танымауың мүмкін».
Dialogue: 0,0:02:41.99,0:02:43.70,Default,,0,0,0,,«Біз кездессек те, мені танымауың мүмкін».
Dialogue: 0,0:02:41.99,0:02:43.70,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:43.87,0:02:44.53,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:02:44.70,0:02:45.70,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:02:46.04,0:02:49.71,Default,,0,0,0,,(Кір жуғыш машинаны басқару дыбысы)
Dialogue: 0,0:02:54.67,0:02:59.63,Default,,0,0,0,,«Такаки-кунның біртіндеп өзгеретініне сенімдімін».
Dialogue: 0,0:03:13.98,0:03:18.90,Default,,0,0,0,,«Құрметті мырза, суық күндер жалғасуда. Қалдарыңыз қалай?»
Dialogue: 0,0:03:19.32,0:03:20.82,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:23.66,0:03:26.20,Default,,0,0,0,,«Мұнда бірнеше рет қар жауды».
Dialogue: 0,0:03:26.33,0:03:27.66,Default,,0,0,0,,«Мен жасаған сайын»
Dialogue: 0,0:03:27.79,0:03:30.71,Default,,0,0,0,,«Мен мектепке өте ауыр техникамен барамын».
Dialogue: 0,0:03:31.33,0:03:34.25,Default,,0,0,0,,«Токиоға қар әлі жауған жоқ, солай ма?»
Dialogue: 0,0:03:34.42,0:03:36.50,Default,,0,0,0,,«Мен көшіп келгеннен кейін де бұл әдетке айналды».
Dialogue: 0,0:03:36.67,0:03:39.92,Default,,0,0,0,,«Мен тіпті Токиодағы ауа райы болжамын да қараймын».
Dialogue: 0,0:03:41.72,0:03:42.76,Default,,0,0,0,,Хахаха
Dialogue: 0,0:03:44.18,0:03:45.93,Default,,0,0,0,,Жаңбыр жаумай ма деп ойлаймын
Dialogue: 0,0:03:46.05,0:03:48.10,Default,,0,0,0,,Бірақ үй ішінде де қиын.
Dialogue: 0,0:03:48.26,0:03:51.27,Default,,0,0,0,,Эй, сен Точигиде болдың ба?
Dialogue: 0,0:03:51.43,0:03:52.73,Default,,0,0,0,,Иә? қайда?
Dialogue: 0,0:03:52.85,0:03:53.52,Default,,0,0,0,,Точиги
Dialogue: 0,0:03:53.69,0:03:54.60,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:03:54.73,0:03:56.36,Default,,0,0,0,,Біз оған қалай жетеміз?
Dialogue: 0,0:03:56.48,0:03:59.23,Default,,0,0,0,,Енді... Шинкансен немесе бірдеңе ме?
Dialogue: 0,0:03:59.57,0:04:01.07,Default,,0,0,0,,Ол алыс.
Dialogue: 0,0:04:03.11,0:04:03.86,Default,,0,0,0,,Бір жыл!
Dialogue: 0,0:04:03.99,0:04:05.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:05.70,0:04:07.12,Default,,0,0,0,,Соңғы үш айналым!
Dialogue: 0,0:04:07.24,0:04:08.70,Default,,0,0,0,,Ұрыс! О! Ұрыс! О!
Dialogue: 0,0:04:08.87,0:04:13.62,Default,,0,0,0,,«Мен Такаки-кунның басқа мектепке ауысуды шешкеніне таң қалдым».
Dialogue: 0,0:04:13.75,0:04:17.79,Default,,0,0,0,,«Екеуміз де көптен бері мектептерді ауыстыруға үйреніп қалғанбыз».
Dialogue: 0,0:04:17.92,0:04:20.05,Default,,0,0,0,,«Солай болса да, бұл Кагосима».
Dialogue: 0,0:04:20.17,0:04:23.30,Default,,0,0,0,,«Бұл жолы сәл алыста».
Dialogue: 0,0:04:24.13,0:04:25.47,Default,,0,0,0,,«Төтенше жағдайда»
Dialogue: 0,0:04:25.59,0:04:29.22,Default,,0,0,0,,«Мен сені көру үшін пойызбен бара алатындай жақын емес.»
Dialogue: 0,0:04:29.35,0:04:30.47,Default,,0,0,0,,«Күтілгендей...»
Dialogue: 0,0:04:30.64,0:04:31.72,Default,,0,0,0,,«Кішкене...»
Dialogue: 0,0:04:31.98,0:04:34.64,Default,,0,0,0,,«Мен өзімді аздап жалғыз сезінемін».
Dialogue: 0,0:04:34.77,0:04:38.82,Default,,0,0,0,,«Өтінемін, өтінемін, Такаки-кун жақсы деп үміттенемін».
Dialogue: 0,0:04:43.57,0:04:45.91,Default,,0,0,0,,(Қызыл бас тоқылдақ дыбысы)
Dialogue: 0,0:04:53.12,0:04:55.67,Default,,0,0,0,,«Такаки-кунға»
Dialogue: 0,0:04:56.54,0:05:00.17,Default,,0,0,0,,«Мен 4 наурызда берілген уәдеге өте қуаныштымын».
Dialogue: 0,0:05:00.30,0:05:03.01,Default,,0,0,0,,«Біздің танысқанымызға бір жыл болды».
Dialogue: 0,0:05:03.17,0:05:05.93,Default,,0,0,0,,«Мен қатты қобалжыдым».
Dialogue: 0,0:05:12.72,0:05:15.85,Default,,0,0,0,,«Менің үйімнің жанында үлкен шие ағашы бар».
Dialogue: 0,0:05:16.02,0:05:18.44,Default,,0,0,0,,«Мүмкін көктемде бар шығар».
Dialogue: 0,0:05:18.56,0:05:22.19,Default,,0,0,0,,«Гүл жапырақшалары секундына 5 сантиметр жылдамдықпен жерге түседі».
Dialogue: 0,0:05:23.48,0:05:25.61,Default,,0,0,0,,«Такаки-кунмен»
Dialogue: 0,0:05:25.74,0:05:29.78,Default,,0,0,0,,«Көктем де келсе екен.»
Dialogue: 0,0:05:46.84,0:05:50.22,Default,,0,0,0,,Үйге барар жолда бір жерге тоқтайсыз ба? (Ер оқушы А) Иә, жаңбыр жауып тұр.
Dialogue: 0,0:05:46.84,0:05:50.22,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:05:50.43,0:05:52.89,Default,,0,0,0,,Болжам бойынша кешке қар жауады.
Dialogue: 0,0:05:53.10,0:05:56.39,Default,,0,0,0,,Уау, наурыз айы болса да салқын деп ойладым.
Dialogue: 0,0:05:56.52,0:05:58.06,Default,,0,0,0,,Сіз суық тиетін сияқтысыз.
Dialogue: 0,0:05:58.19,0:06:01.40,Default,,0,0,0,,Ей, жылы бірдеңе ішейік. Шимокитадан түсіңіз.
Dialogue: 0,0:06:01.61,0:06:02.57,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:03.02,0:06:04.15,Default,,0,0,0,,Тоно
Dialogue: 0,0:06:04.61,0:06:05.53,Default,,0,0,0,,Үйірме жұмыстарына барайық
Dialogue: 0,0:06:05.65,0:06:06.82,Default,,0,0,0,,Ах
Dialogue: 0,0:06:08.45,0:06:11.07,Default,,0,0,0,,Білесіз бе, мен бүгін үйірме жұмыстарына жақсы емеспін.
Dialogue: 0,0:06:11.24,0:06:12.37,Default,,0,0,0,,Сіз көшуге дайындалып жатырсыз ба?
Dialogue: 0,0:06:12.49,0:06:14.58,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:06:14.70,0:06:19.04,Default,,0,0,0,,«Менің бекетіме келсеңіз, үлкен көмек болар еді».
Dialogue: 0,0:06:19.17,0:06:22.42,Default,,0,0,0,,«Ол алыс, сондықтан абай болыңыз.»
Dialogue: 0,0:06:22.88,0:06:26.71,Default,,0,0,0,,«Мен уәде етілгендей кешкі сағат 19:00-де станцияның күту залында күтемін.»
Dialogue: 0,0:06:31.72,0:06:33.60,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:06:46.23,0:06:51.45,Default,,0,0,0,,Мен Акаримен уәделескен күні түстен кейін қар жауа бастады.
Dialogue: 0,0:06:53.70,0:06:55.95,Default,,0,0,0,,Әй, Такаки-кун!
Dialogue: 0,0:06:56.12,0:06:57.95,Default,,0,0,0,,Мысық! Бұл Чоби!
Dialogue: 0,0:06:58.12,0:07:00.29,Default,,0,0,0,,Бұл жігіт үнемі осында.
Dialogue: 0,0:07:00.41,0:07:02.46,Default,,0,0,0,,Бірақ мен бүгін жалғыз қалғандай сезінемін
Dialogue: 0,0:07:02.58,0:07:06.42,Default,,0,0,0,,Мимиге не болды? Жалғыз болу жалғыздық
Dialogue: 0,0:07:10.17,0:07:12.72,Default,,0,0,0,,Хахаха
Dialogue: 0,0:07:13.18,0:07:15.81,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:07:16.76,0:07:18.31,Default,,0,0,0,,Бұл кітап туралы не ойлайсыз?
Dialogue: 0,0:07:18.52,0:07:21.98,Default,,0,0,0,,Мен кеше бір түнде шамамен 4 миллиард жылды оқыдым!
Dialogue: 0,0:07:22.15,0:07:22.90,Default,,0,0,0,,Қайда?
Dialogue: 0,0:07:23.02,0:07:24.81,Default,,0,0,0,,Anomalocaris пайда болатын жердің айналасында
Dialogue: 0,0:07:25.02,0:07:26.11,Default,,0,0,0,,Кембрий!
Dialogue: 0,0:07:27.65,0:07:31.15,Default,,0,0,0,,Маған Галлюцигения ұнайды.
Dialogue: 0,0:07:31.32,0:07:32.49,Default,,0,0,0,,Бұл ұқсас болуы мүмкін.
Dialogue: 0,0:07:32.66,0:07:34.24,Default,,0,0,0,,Такаки-кун қандай жанкүйер?
Dialogue: 0,0:07:34.37,0:07:35.49,Default,,0,0,0,,Бұл Опабиния ма?
Dialogue: 0,0:07:35.62,0:07:37.99,Default,,0,0,0,,Әй, бұл бес көзді адам ғой!
Dialogue: 0,0:07:38.20,0:07:42.67,Default,,0,0,0,,Менің ойымша, Акари екеуміз ақыл-ой жағынан қандай да бір жағынан өте ұқсас едік.
Dialogue: 0,0:07:44.04,0:07:46.59,Default,,0,0,0,,Мен Токиоға ауысқаннан кейін бір жылдан кейін...
Dialogue: 0,0:07:46.88,0:07:50.01,Default,,0,0,0,,Акари сол сыныпқа ауыстырылды.
Dialogue: 0,0:07:51.01,0:07:54.14,Default,,0,0,0,,Біз әлі кішкентай едік және жиі ауыратынбыз.
Dialogue: 0,0:07:54.26,0:07:56.85,Default,,0,0,0,,Маған үлкен кітапханадан гөрі кітапхана ұнайды.
Dialogue: 0,0:07:57.22,0:07:59.68,Default,,0,0,0,,Сондықтан біз табиғи түрде дос болдық.
Dialogue: 0,0:07:59.85,0:08:03.44,Default,,0,0,0,,Сол себепті сыныптастарым мені кейде мазақтайтын.
Dialogue: 0,0:08:03.60,0:08:04.69,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:08:06.06,0:08:08.27,Default,,0,0,0,,Бірге болсақ біртүрлі болар еді.
Dialogue: 0,0:08:08.40,0:08:12.20,Default,,0,0,0,,Мұндай нәрсе соншалықты қорқынышты емес еді.
Dialogue: 0,0:08:12.78,0:08:16.20,Default,,0,0,0,,(дауысты көтеру)
Dialogue: 0,0:08:16.57,0:08:19.33,Default,,0,0,0,,Бір күні бәріміз бір орта мектепке барамыз.
Dialogue: 0,0:08:19.45,0:08:21.54,Default,,0,0,0,,Біз мәңгі бірге боламыз
Dialogue: 0,0:08:21.70,0:08:25.00,Default,,0,0,0,,Неліктен? Мен осылай ойладым.
Dialogue: 0,0:08:29.09,0:08:31.71,Default,,0,0,0,,Шиндзюку Синдзюку – соңғы аялдама.
Dialogue: 0,0:08:31.88,0:08:33.22,Default,,0,0,0,,Түсетін жолаушылар үшін...
Dialogue: 0,0:08:35.30,0:08:38.89,Default,,0,0,0,,JR желісі, Кейо желісі немесе метро үшін ауыстырыңыз.
Dialogue: 0,0:08:42.35,0:08:45.39,Default,,0,0,0,,Мен Шиндзюку станциясына бірінші рет жалғыз келдім.
Dialogue: 0,0:08:45.69,0:08:49.69,Default,,0,0,0,,Мен жүремін деп жүрген маршруттардың бәрі мен үшін жаңа.
Dialogue: 0,0:08:54.45,0:08:55.53,Default,,0,0,0,,Я...
Dialogue: 0,0:08:56.41,0:08:58.74,Default,,0,0,0,,Менің жүрегім дүрсілдеп кетті
Dialogue: 0,0:09:01.62,0:09:05.41,Default,,0,0,0,,Енді мен Акаримен кездесуге барамын.
Dialogue: 0,0:09:11.21,0:09:13.09,Default,,0,0,0,,Бала соңғы рет қалай болды?
Dialogue: 0,0:09:13.30,0:09:14.09,Default,,0,0,0,,Кім?
Dialogue: 0,0:09:14.30,0:09:15.26,Default,,0,0,0,,Қараңыз, Western Commercial!
Dialogue: 0,0:09:15.38,0:09:16.26,Default,,0,0,0,,Иә? Оның дәмі нашар емес пе?
Dialogue: 0,0:09:16.26,0:09:17.89,Default,,0,0,0,,Иә? Оның дәмі нашар емес пе?
Dialogue: 0,0:09:16.26,0:09:17.89,Default,,0,0,0,,Жақында Мусаши Урава келеді
Dialogue: 0,0:09:17.89,0:09:18.26,Default,,0,0,0,,Жақында Мусаши Урава келеді
Dialogue: 0,0:09:18.43,0:09:20.22,Default,,0,0,0,,Біз Мусаши Ураваға жетеміз.
Dialogue: 0,0:09:20.81,0:09:23.39,Default,,0,0,0,,Келесі аялдама – Мусаши Урава, онда біз жылдам пойызға жолығамыз...
Dialogue: 0,0:09:23.52,0:09:28.27,Default,,0,0,0,,Жылдам пойыз Бұл пойыз кездесу үшін шамамен 4 минут тоқтайды.
Dialogue: 0,0:09:28.44,0:09:32.44,Default,,0,0,0,,Егер сіз асығыс болсаңыз, жолдың арғы жағындағы Йонохонмачи Омияға барыңыз...
Dialogue: 0,0:09:42.74,0:09:48.08,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:09:48.71,0:09:53.80,Default,,0,0,0,,(Телефон қоңырау үні)
Dialogue: 0,0:09:54.01,0:09:56.88,Default,,0,0,0,,Мм... Менің атым Шинохара.
Dialogue: 0,0:09:57.22,0:10:00.14,Default,,0,0,0,,Такаки-кун осында ма?
Dialogue: 0,0:10:00.85,0:10:02.10,Default,,0,0,0,,Акари-чан
Dialogue: 0,0:10:03.47,0:10:05.81,Default,,0,0,0,,А... аудару?
Dialogue: 0,0:10:06.85,0:10:10.73,Default,,0,0,0,,Нишинака ше? Емтихан тапсырсам да
Dialogue: 0,0:10:11.23,0:10:14.78,Default,,0,0,0,,Точигидегі мемлекеттік кеңсеге өтініш беру...
Dialogue: 0,0:10:14.90,0:10:16.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:16.99,0:10:19.99,Default,,0,0,0,,Жоқ... Акари кешірім сұрамайды.
Dialogue: 0,0:10:20.20,0:10:23.66,Default,,0,0,0,,Кацушикадағы тәтем мектепке келгісі келетінін айтты.
Dialogue: 0,0:10:24.04,0:10:27.83,Default,,0,0,0,,Ол қартаймайынша жұмыс істемейді...
Dialogue: 0,0:10:29.12,0:10:30.00,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:10:30.17,0:10:31.17,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:10:31.71,0:10:33.17,Default,,0,0,0,,Жетеді
Dialogue: 0,0:10:36.09,0:10:37.51,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:10:38.88,0:10:42.26,Default,,0,0,0,,Ресивер арқылы мен оны қатты басқаным сонша, құлағым ауырды.
Dialogue: 0,0:10:42.60,0:10:46.85,Default,,0,0,0,,Мен Акаридің жараланғанын сездім, бірақ...
Dialogue: 0,0:10:47.56,0:10:49.69,Default,,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:10:57.57,0:11:02.03,Default,,0,0,0,,Трансфер терминалы үйіне қарай бет алған адамдарға лық толы болды.
Dialogue: 0,0:11:02.20,0:11:05.20,Default,,0,0,0,,Барлығының аяқ киімдері қардан су болып жатыр.
Dialogue: 0,0:11:05.66,0:11:06.70,Default,,0,0,0,,Ауа –
Dialogue: 0,0:11:06.83,0:11:10.54,Default,,0,0,0,,Қарлы күні қала салқын, ерекше иіске бөленді.
Dialogue: 0,0:11:10.96,0:11:13.04,Default,,0,0,0,,...
Dialogue: 0,0:11:13.25,0:11:16.46,Default,,0,0,0,,Уцуномия линиясы Ояма пойызы Уцуномияға барады
Dialogue: 0,0:11:16.59,0:11:19.72,Default,,0,0,0,,Қарға байланысты біздің келуіміз шамамен 8 минутқа кешіктіріледі.
Dialogue: 0,0:11:19.92,0:11:22.80,Default,,0,0,0,,Тұтынушыларымызға келтірілген қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:11:22.93,0:11:26.89,Default,,0,0,0,,Осы уақытқа дейін мен пойыздың кешігіп қалу мүмкіндігін ешқашан ойлаған емеспін.
Dialogue: 0,0:11:27.10,0:11:29.02,Default,,0,0,0,,ойыма да келмеген
Dialogue: 0,0:11:29.14,0:11:32.52,Default,,0,0,0,,Мазасыздық кенет күшейді
Dialogue: 0,0:11:36.65,0:11:41.49,Default,,0,0,0,,Бұл пойыз қазір қарға байланысты шамамен 10 минутқа кешігіп жүр.
Dialogue: 0,0:11:41.74,0:11:45.74,Default,,0,0,0,,Пойызыңыздың кешігуі үшін кешірім сұраймыз.
Dialogue: 0,0:11:47.87,0:11:51.25,Default,,0,0,0,,Біраз уақыттан кейін Омия станциясынан өткеннен кейін
Dialogue: 0,0:11:51.37,0:11:55.42,Default,,0,0,0,,Ғимараттар ландшафттан тез жоғалып кетті.
Dialogue: 0,0:12:06.60,0:12:09.27,Default,,0,0,0,,Келесіде Куки Куки
Dialogue: 0,0:12:10.68,0:12:14.19,Default,,0,0,0,,Өте кеш келгеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:12:15.02,0:12:19.61,Default,,0,0,0,,Егер сіз Tobu Isesaki желісіне ауыстырып жатсаңыз, 5-шығысқа өтіңіз.
Dialogue: 0,0:12:21.28,0:12:23.11,Default,,0,0,0,,Себебі келесі пойыз кешікті
Dialogue: 0,0:12:23.32,0:12:26.57,Default,,0,0,0,,Бұл пойыз осы станцияда шамамен 10 минут тоқтайды.
Dialogue: 0,0:12:26.95,0:12:29.45,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:12:29.66,0:12:33.08,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:12:34.87,0:12:35.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:36.13,0:12:37.79,Default,,0,0,0,,Себебі келесі пойыз кешікті
Dialogue: 0,0:12:37.92,0:12:41.26,Default,,0,0,0,,Бұл пойыз осы станцияда шамамен 10 минут тоқтайды.
Dialogue: 0,0:12:41.67,0:12:44.47,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз, бірақ...
Dialogue: 0,0:12:44.59,0:12:51.06,Default,,0,0,0,,(Темір жол өткелінің дыбысы)
Dialogue: 0,0:13:03.69,0:13:06.74,Default,,0,0,0,,(пойыздың тоқтаған дыбысы)
Dialogue: 0,0:13:07.36,0:13:09.83,Default,,0,0,0,,Ноги Ноги
Dialogue: 0,0:13:10.03,0:13:12.66,Default,,0,0,0,,Тапсырыс берушіден бас тартқанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:13:12.83,0:13:17.08,Default,,0,0,0,,Келесі пойыздың кешігуіне байланысты бұл пойыз осы станцияда біраз уақыт тоқтайды.
Dialogue: 0,0:13:17.21,0:13:18.29,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:13:18.42,0:13:22.67,Default,,0,0,0,,Станциялар арасындағы қашықтық адам сенгісіз.
Dialogue: 0,0:13:22.88,0:13:24.30,Default,,0,0,0,,Әрбір вокзал
Dialogue: 0,0:13:24.42,0:13:28.01,Default,,0,0,0,,Мен ұзақ уақыт тоқтадым.
Dialogue: 0,0:13:48.66,0:13:52.87,Default,,0,0,0,,Терезенің сыртында мен бұрын-соңды көрмеген қарлы шөл дала жатыр.
Dialogue: 0,0:13:53.08,0:13:57.37,Default,,0,0,0,,Уақыт баяу өтіп, азапты аштық
Dialogue: 0,0:13:57.50,0:14:00.63,Default,,0,0,0,,Бұл мені одан сайын алаңдатты.
Dialogue: 0,0:14:02.42,0:14:04.55,Default,,0,0,0,,Белгіленген уақыттан кейін
Dialogue: 0,0:14:04.67,0:14:09.22,Default,,0,0,0,,Менің ойымша, Акари қазір қобалжи бастаған шығар.
Dialogue: 0,0:14:13.39,0:14:16.98,Default,,0,0,0,,Сол күні... телефон соққан күні—
Dialogue: 0,0:14:17.23,0:14:21.02,Default,,0,0,0,,Маған қарағанда көбірек уайымдайтын Акари үшін.
Dialogue: 0,0:14:21.15,0:14:24.73,Default,,0,0,0,,Саған жылы сөз айта алмадым.
Dialogue: 0,0:14:24.90,0:14:27.74,Default,,0,0,0,,Мен қатты ұялдым.
Dialogue: 0,0:14:28.65,0:14:33.03,Default,,0,0,0,,♪Көтерсең құрметке...
Dialogue: 0,0:14:34.45,0:14:35.58,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:14:35.83,0:14:38.41,Default,,0,0,0,,Бүгін қоштасамыз.
Dialogue: 0,0:14:40.96,0:14:43.38,Default,,0,0,0,,Акариден бірінші хат келді
Dialogue: 0,0:14:43.50,0:14:44.92,Default,,0,0,0,,Алты айдан кейін
Dialogue: 0,0:14:45.30,0:14:47.38,Default,,0,0,0,,Бұл менің орта мектептің бірінші жылының жазы болатын.
Dialogue: 0,0:14:47.97,0:14:51.89,Default,,0,0,0,,...
Dialogue: 0,0:14:52.14,0:14:54.51,Default,,0,0,0,,Уәде етілген күнге дейін екі апта өтті
Dialogue: 0,0:14:55.26,0:14:58.35,Default,,0,0,0,,Мен Акариге беру үшін хат жаздым.
Dialogue: 0,0:14:58.64,0:15:02.35,Default,,0,0,0,,Мен Акариге не айтуым керек Мен оның естігенін қалаймын
Dialogue: 0,0:15:02.65,0:15:05.44,Default,,0,0,0,,Менде көп нәрсе болды.
Dialogue: 0,0:15:05.61,0:15:10.11,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Жақында пойыз Уцуномияға жол тартады.
Dialogue: 0,0:15:23.04,0:15:24.96,Default,,0,0,0,,Кояма Кояма
Dialogue: 0,0:15:25.09,0:15:27.88,Default,,0,0,0,,Тохоку Шинкансенді пайдалансаңыз, осы жерден өзгертіңіз.
Dialogue: 0,0:15:29.30,0:15:33.43,Default,,0,0,0,,Тохоку Синкансеннен Мориокаға ауысатын болсаңыз, 1-платформаны алыңыз.
Dialogue: 0,0:15:33.80,0:15:38.27,Default,,0,0,0,,Егер сіз Токиоға келетін кіріс тасымалдайтын болсаңыз, 5-платформаға өтіңіз.
Dialogue: 0,0:15:39.18,0:15:41.44,Default,,0,0,0,,...
Dialogue: 0,0:15:41.56,0:15:44.10,Default,,0,0,0,,Дәл қазір Ryomo Line қар жауып тұр.
Dialogue: 0,0:15:44.23,0:15:46.94,Default,,0,0,0,,Біз айтарлықтай кідіріспен келе жатырмыз.
Dialogue: 0,0:15:47.36,0:15:50.49,Default,,0,0,0,,Тұтынушыларымызға келтірілген қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:15:51.07,0:15:54.49,Default,,0,0,0,,Пойыз келгенше біраз күтіңіз.
Dialogue: 0,0:15:56.20,0:15:58.16,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:15:58.33,0:16:02.33,Default,,0,0,0,,Акари күтіп тұрған вокзалға барудан басқа амалым қалмады.
Dialogue: 0,0:16:42.04,0:16:45.79,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:16:56.09,0:17:01.14,Default,,0,0,0,,8-платформа Ашикага/Маэбаши бағыты Такасакиге баратын пойыз келе жатыр.
Dialogue: 0,0:17:01.27,0:17:04.56,Default,,0,0,0,,Ақ жолдың ішіне өтіңіз...
Dialogue: 0,0:17:25.41,0:17:29.42,Default,,0,0,0,,(пойыздың тоқтаған дыбысы)
Dialogue: 0,0:17:35.13,0:17:37.26,Default,,0,0,0,,Біз тұтынушыларға хабарлаймыз
Dialogue: 0,0:17:37.43,0:17:40.26,Default,,0,0,0,,Қар жаууына байланысты кестенің бұзылуына байланысты.
Dialogue: 0,0:17:40.39,0:17:42.10,Default,,0,0,0,,Біз аз уақытқа тоқтаймыз.
Dialogue: 0,0:17:42.31,0:17:44.60,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:17:44.73,0:17:47.35,Default,,0,0,0,,Қазіргі уақытта қалпына келтіру перспективасы жоқ.
Dialogue: 0,0:17:47.85,0:17:49.44,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:17:49.61,0:17:52.11,Default,,0,0,0,,Қар жаууына байланысты кестенің бұзылуына байланысты.
Dialogue: 0,0:17:52.27,0:17:54.19,Default,,0,0,0,,Біз аз уақытқа тоқтаймыз.
Dialogue: 0,0:17:54.32,0:17:56.28,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:17:56.57,0:17:59.95,Default,,0,0,0,,Қазіргі уақытта қалпына келтіру перспективасы жоқ.
Dialogue: 0,0:18:03.79,0:18:06.71,Default,,0,0,0,,«Такаки-кун, қалайсың?»
Dialogue: 0,0:18:07.16,0:18:11.21,Default,,0,0,0,,«Мен бұл хатты пойызда жазып отырмын, себебі үйірме жұмыстарына байланысты таңертең ерте шықтым».
Dialogue: 0,0:18:11.34,0:18:16.80,Default,,0,0,0,,Мен хаттағы Акари қандай да бір себептермен әрқашан жалғыз болатын.
Dialogue: 0,0:18:20.47,0:18:22.72,Default,,0,0,0,,Пойыз аяқталды
Dialogue: 0,0:18:22.89,0:18:26.64,Default,,0,0,0,,Біз бос далада екі сағат аялдадық.
Dialogue: 0,0:18:27.35,0:18:30.73,Default,,0,0,0,,Бір минут өте ұзақ
Dialogue: 0,0:18:30.85,0:18:33.82,Default,,0,0,0,,Уақыттың анық зұлымдығы бар
Dialogue: 0,0:18:33.94,0:18:37.15,Default,,0,0,0,,Менің үстімнен жайлап ағып өтті
Dialogue: 0,0:18:37.69,0:18:40.32,Default,,0,0,0,,Мен тісімді қатты қысамын
Dialogue: 0,0:18:40.45,0:18:45.41,Default,,0,0,0,,Мен жыламай, ұстап тұрсам болды.
Dialogue: 0,0:18:46.79,0:18:48.33,Default,,0,0,0,,Акари…
Dialogue: 0,0:18:49.21,0:18:51.46,Default,,0,0,0,,Өтінемін... қазірдің өзінде...
Dialogue: 0,0:18:51.58,0:18:52.75,Default,,0,0,0,,Үйде...
Dialogue: 0,0:18:54.96,0:18:58.30,Default,,0,0,0,,Қайтып келгеніңді қалаймын...
Dialogue: 0,0:19:11.73,0:19:16.69,Default,,0,0,0,,3-платформа Ашикага/Маэбаши бағыты бойынша Такасакиге қатынайтын пойыз келеді.
Dialogue: 0,0:19:18.90,0:19:22.16,Default,,0,0,0,,Бұл пойыз қар жауғандықтан біраз уақыт тоқтайды.
Dialogue: 0,0:19:42.47,0:19:43.22,Default,,0,0,0,,Әй
Dialogue: 0,0:19:46.43,0:19:47.72,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:59.23,0:20:00.74,Default,,0,0,0,,Акали
Dialogue: 0,0:20:10.45,0:20:13.21,Default,,0,0,0,,(Акаридің жылағаны)
Dialogue: 0,0:20:30.02,0:20:31.60,Default,,0,0,0,,Дәмді
Dialogue: 0,0:20:32.14,0:20:34.56,Default,,0,0,0,,Иә? Бұл қалыпты қожа
Dialogue: 0,0:20:34.69,0:20:37.40,Default,,0,0,0,,Ходжича? Мен оны бірінші рет іштім
Dialogue: 0,0:20:37.69,0:20:40.07,Default,,0,0,0,,Өтірік Мен оны міндетті түрде іштім!
Dialogue: 0,0:20:40.19,0:20:40.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:41.03,0:20:42.53,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:20:43.07,0:20:48.53,Default,,0,0,0,,Ал мынау... Мен жасадым, сондықтан дәміне кепілдік бере алмаймын.
Dialogue: 0,0:20:48.83,0:20:50.58,Default,,0,0,0,,Қаласаң же.
Dialogue: 0,0:20:50.70,0:20:52.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:53.33,0:20:55.96,Default,,0,0,0,,Менің қарным қатты ашты.
Dialogue: 0,0:20:59.29,0:21:00.21,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:04.51,0:21:07.64,Default,,0,0,0,,Мен жеген ең дәмді нәрсе
Dialogue: 0,0:21:07.80,0:21:08.97,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:21:09.18,0:21:10.10,Default,,0,0,0,,Ой…
Dialogue: 0,0:21:10.22,0:21:11.89,Default,,0,0,0,,Оның аш болғанына сенімдімін.
Dialogue: 0,0:21:12.02,0:21:13.06,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:21:13.18,0:21:14.10,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:21:14.23,0:21:16.48,Default,,0,0,0,,Мен де жеймін
Dialogue: 0,0:21:20.86,0:21:23.15,Default,,0,0,0,,Жақында көшу келеді, солай емес пе?
Dialogue: 0,0:21:23.28,0:21:24.65,Default,,0,0,0,,Иә, келесі аптада
Dialogue: 0,0:21:24.86,0:21:26.32,Default,,0,0,0,,Кагосима, иә?
Dialogue: 0,0:21:26.49,0:21:27.16,Default,,0,0,0,,Ол алыс
Dialogue: 0,0:21:27.32,0:21:28.49,Default,,0,0,0,,Иә
Dialogue: 0,0:21:29.20,0:21:30.83,Default,,0,0,0,,Точиги де алыста еді.
Dialogue: 0,0:21:30.95,0:21:34.00,Default,,0,0,0,,Хехе, мен қазір үйге бара алмаймын.
Dialogue: 0,0:21:35.66,0:21:36.50,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:21:36.62,0:21:39.84,Default,,0,0,0,,Жабуға жақын. Енді пойыздар жоқ.
Dialogue: 0,0:21:40.04,0:21:40.84,Default,,0,0,0,,Жоғары
Dialogue: 0,0:21:40.96,0:21:42.96,Default,,0,0,0,,Міне осылай қар жауып тұр, абай болыңыз.
Dialogue: 0,0:21:43.09,0:21:44.01,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:07.90,0:22:10.03,Default,,0,0,0,,Сіз оны көре аласыз ба? Сол ағаш?
Dialogue: 0,0:22:10.24,0:22:11.49,Default,,0,0,0,,Әріптер ағашы?
Dialogue: 0,0:22:11.62,0:22:14.49,Default,,0,0,0,,Иә, шие ағашы
Dialogue: 0,0:22:20.92,0:22:22.34,Default,,0,0,0,,Эй
Dialogue: 0,0:22:23.05,0:22:25.55,Default,,0,0,0,,Бұл... қар сияқты, солай емес пе?
Dialogue: 0,0:22:33.18,0:22:34.85,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:22:44.73,0:22:46.40,Default,,0,0,0,,Сол сәт—
Dialogue: 0,0:22:47.07,0:22:51.07,Default,,0,0,0,,Мәңгілік, жүрек, жан қайда?
Dialogue: 0,0:22:51.20,0:22:52.74,Default,,0,0,0,,Мен түсіндім деп ойладым.
Dialogue: 0,0:22:53.28,0:22:57.41,Default,,0,0,0,,Мен 13 жыл бойы өмір сүргенімнің бәрін бөліскендей сезінемін.
Dialogue: 0,0:22:57.54,0:23:00.25,Default,,0,0,0,,Содан кейін келесі сәт
Dialogue: 0,0:23:00.96,0:23:01.92,Default,,0,0,0,,Төзгісіз...
Dialogue: 0,0:23:02.13,0:23:04.09,Default,,0,0,0,,Мен мұңайдым.
Dialogue: 0,0:23:05.63,0:23:09.26,Default,,0,0,0,,Ақәлінің жылуы, жан дүниесі
Dialogue: 0,0:23:09.38,0:23:13.01,Default,,0,0,0,,Мен оны қалай өңдеуім керек? Мен оны қайда апаруым керек?
Dialogue: 0,0:23:13.30,0:23:16.01,Default,,0,0,0,,Себебі мен мұны түсінбедім.
Dialogue: 0,0:23:18.77,0:23:22.27,Default,,0,0,0,,Біз мәңгі бірге бола алмаймыз
Dialogue: 0,0:23:22.44,0:23:24.27,Default,,0,0,0,,Бұл түсінікті болды
Dialogue: 0,0:23:25.15,0:23:28.44,Default,,0,0,0,,Алдымызда әлі үлкен өмір күтіп тұр.
Dialogue: 0,0:23:28.65,0:23:33.45,Default,,0,0,0,,Ешқандай қаңырап бос қалған уақыт
Dialogue: 0,0:23:35.83,0:23:37.08,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:23:37.20,0:23:41.96,Default,,0,0,0,,Мені басып алған уайым ақырында баяу еріді.
Dialogue: 0,0:23:42.12,0:23:47.25,Default,,0,0,0,,Акаридің жұмсақ ерндері ғана қалды.
Dialogue: 0,0:24:04.77,0:24:06.31,Default,,0,0,0,,Сол түн
Dialogue: 0,0:24:06.48,0:24:11.15,Default,,0,0,0,,Егіннің жанындағы шағын қорада тұрдық.
Dialogue: 0,0:24:11.95,0:24:15.66,Default,,0,0,0,,Ескі көрпеге оранып, ұзақ сөйлеседі
Dialogue: 0,0:24:15.87,0:24:18.49,Default,,0,0,0,,Мен білмей тұрып ұйықтап қалдым.
Dialogue: 0,0:24:19.54,0:24:22.83,Default,,0,0,0,,Таңертең жүріп келе жатқан пойызға отырдым.
Dialogue: 0,0:24:23.00,0:24:26.17,Default,,0,0,0,,Мен Акаримен ажырастым
Dialogue: 0,0:24:28.21,0:24:29.63,Default,,0,0,0,,Ум...
Dialogue: 0,0:24:30.01,0:24:30.84,Default,,0,0,0,,Такаки-кун...
Dialogue: 0,0:24:31.05,0:24:32.01,Default,,0,0,0,,Фалько…
Dialogue: 0,0:24:32.92,0:24:34.68,Default,,0,0,0,,Такаки-кун...
Dialogue: 0,0:24:35.47,0:24:39.10,Default,,0,0,0,,Бұдан былай бәрі жақсы болатынына сенімдімін!
Dialogue: 0,0:24:39.47,0:24:41.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:42.06,0:24:43.35,Default,,0,0,0,,Акари де жақсы жүр!
Dialogue: 0,0:24:44.06,0:24:45.69,Default,,0,0,0,,Хат жаз! Телефон да!
Dialogue: 0,0:24:45.90,0:24:48.52,Default,,0,0,0,,(Қызыл тоқылдақтың өткір және таза дауысы)
Dialogue: 0,0:24:59.24,0:25:02.04,Default,,0,0,0,,Мен Ақалиға хатты жоғалтып алдым.
Dialogue: 0,0:25:02.25,0:25:04.46,Default,,0,0,0,,Мен Акариге айтқан жоқпын
Dialogue: 0,0:25:06.46,0:25:08.63,Default,,0,0,0,,Осы сүйіспеншілікке дейін және кейін
Dialogue: 0,0:25:09.25,0:25:11.05,Default,,0,0,0,,Дүниедегі барлық нәрсе
Dialogue: 0,0:25:11.17,0:25:14.22,Default,,0,0,0,,Өйткені мен өзгергендей болдым.
Dialogue: 0,0:25:21.39,0:25:25.89,Default,,0,0,0,,Мен оны қорғайтын күшке ие болғым келді.
Dialogue: 0,0:25:26.60,0:25:29.98,Default,,0,0,0,,Соны ғана ойлап, Мәңгі боламын
Dialogue: 0,0:25:30.44,0:25:33.57,Default,,0,0,0,,Терезенің сыртындағы табиғатқа қарай бердім.
Dialogue: 0,0:26:42.55,0:26:44.97,Default,,0,0,0,,(садақ тарту дыбысы)
Dialogue: 0,0:26:45.52,0:26:46.31,Default,,0,0,0,,(жебенің ату дыбысы)
Dialogue: 0,0:26:46.47,0:26:48.14,Default,,0,0,0,,(Нысанаға тиген жебенің дыбысы)
Dialogue: 0,0:27:02.49,0:27:04.49,Default,,0,0,0,,Кана, сен сабақтан кейін барасың ба?
Dialogue: 0,0:27:04.70,0:27:06.16,Default,,0,0,0,,Иә, әпкеңнің жағдайы жақсы ма?
Dialogue: 0,0:27:06.33,0:27:08.83,Default,,0,0,0,,Жарайды, бірақ сіз де жақсы оқыңыз.
Dialogue: 0,0:27:09.04,0:27:10.29,Default,,0,0,0,,Иә
Dialogue: 0,0:27:19.88,0:27:21.93,Default,,0,0,0,,(Мотоциклдің тоқтау дыбысы)
Dialogue: 0,0:27:35.44,0:27:36.86,Default,,0,0,0,,(жебенің соғу дыбысы)
Dialogue: 0,0:27:39.57,0:27:41.03,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:27:54.04,0:27:54.71,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:27:55.42,0:27:56.71,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:27:57.30,0:28:00.34,Default,,0,0,0,,Қайырлы таң Тонокун, бүгін де таң ерте.
Dialogue: 0,0:28:00.47,0:28:02.55,Default,,0,0,0,,Сумита да теңізге кетті, солай ма?
Dialogue: 0,0:28:02.76,0:28:03.72,Default,,0,0,0,,Иә
Dialogue: 0,0:28:04.18,0:28:05.01,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасайсыз.
Dialogue: 0,0:28:05.14,0:28:05.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:06.89,0:28:09.56,Default,,0,0,0,,Онша емес... хехехе
Dialogue: 0,0:28:09.68,0:28:11.14,Default,,0,0,0,,Жақында кездескенше! Тоно-кун
Dialogue: 0,0:28:11.27,0:28:12.39,Default,,0,0,0,,О
Dialogue: 0,0:28:14.65,0:28:17.19,Default,,0,0,0,,Жарайсың ба? Шешетін уақыт келді
Dialogue: 0,0:28:17.44,0:28:19.36,Default,,0,0,0,,Оны дүйсенбіге дейін жіберіңіз.
Dialogue: 0,0:28:19.65,0:28:22.36,Default,,0,0,0,,Жазбас бұрын отбасыңызбен кеңесіңіз.
Dialogue: 0,0:28:24.36,0:28:26.87,Default,,0,0,0,,Сасаки-сан, мен Токиодағы университетке түскім келеді.
Dialogue: 0,0:28:27.20,0:28:30.70,Default,,0,0,0,,Мен Кумамотодағы кіші колледжге бардым деп ойлаймын.
Dialogue: 0,0:28:30.83,0:28:31.91,Default,,0,0,0,,Кана ше?
Dialogue: 0,0:28:32.12,0:28:34.08,Default,,0,0,0,,Не? Хмм...
Dialogue: 0,0:28:34.29,0:28:35.42,Default,,0,0,0,,Сіз жұмысқа тұрасыз ба?
Dialogue: 0,0:28:35.58,0:28:36.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:37.04,0:28:39.50,Default,,0,0,0,,Сіз шынымен ештеңе туралы ойламайсыз, солай ма?
Dialogue: 0,0:28:39.63,0:28:41.26,Default,,0,0,0,,Тоно-кун туралы.
Dialogue: 0,0:28:41.38,0:28:43.38,Default,,0,0,0,,Оның шынымен Токиода қызы бар.
Dialogue: 0,0:28:43.51,0:28:44.43,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:28:44.63,0:28:45.89,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:28:46.09,0:28:52.27,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:29:09.16,0:29:10.62,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:29:10.95,0:29:11.70,Default,,0,0,0,,Ах
Dialogue: 0,0:29:12.54,0:29:14.29,Default,,0,0,0,,Әлі жұмыс істемейсіз бе?
Dialogue: 0,0:29:14.41,0:29:17.21,Default,,0,0,0,,Иә, маған не болды...
Dialogue: 0,0:29:17.42,0:29:21.30,Default,,0,0,0,,Көп уайымдамау керек, жақын арада қайта мінуге болады.
Dialogue: 0,0:29:21.46,0:29:23.63,Default,,0,0,0,,Сіз әпкеңізді жеңілдете аласыз.
Dialogue: 0,0:29:23.76,0:29:25.80,Default,,0,0,0,,Неге асығасың?
Dialogue: 0,0:29:27.39,0:29:30.47,Default,,0,0,0,,Осы қарқынмен оқу бітіргенше ештеңе айта алмаймын.
Dialogue: 0,0:29:34.68,0:29:35.98,Default,,0,0,0,,(жебенің соғу дыбысы)
Dialogue: 0,0:29:48.82,0:29:49.74,Default,,0,0,0,,(Қол тежегішті тарту дыбысы)
Dialogue: 0,0:29:49.87,0:29:51.33,Default,,0,0,0,,Рахмет, әпке
Dialogue: 0,0:29:51.53,0:29:52.49,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,0:29:52.66,0:29:54.75,Default,,0,0,0,,Жоқ, мен үйге шалқанмен барамын!
Dialogue: 0,0:30:11.39,0:30:13.43,Default,,0,0,0,,Уф
Dialogue: 0,0:30:18.27,0:30:19.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:20.10,0:30:21.69,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:30:21.90,0:30:24.15,Default,,0,0,0,,Аа, Сумита, сен қазір үйге келесің бе?
Dialogue: 0,0:30:24.36,0:30:26.36,Default,,0,0,0,,Иә, Тоно-кун да?
Dialogue: 0,0:30:26.57,0:30:27.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:27.74,0:30:29.53,Default,,0,0,0,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:30:30.03,0:30:32.78,Default,,0,0,0,,Иттей құйрығым болса
Dialogue: 0,0:30:33.08,0:30:37.37,Default,,0,0,0,,Қуанғанымды жасыра алмай, басымды шайқадым.
Dialogue: 0,0:30:37.96,0:30:40.83,Default,,0,0,0,,А, мен ит емеспін деп қуанамын.
Dialogue: 0,0:30:40.96,0:30:42.88,Default,,0,0,0,,Бедерлі ойлау
Dialogue: 0,0:30:43.04,0:30:46.71,Default,,0,0,0,,Сол кезде мен өзімнің ақымақ болғаныма таң қалдым.
Dialogue: 0,0:30:46.92,0:30:47.88,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:30:48.09,0:30:51.51,Default,,0,0,0,,Тонокунмен үйге бару жолы бақытты болды.
Dialogue: 0,0:30:54.31,0:30:57.56,Default,,0,0,0,,Басынан бастап Тоно-кун басқа ұлдармен бірге болды.
Dialogue: 0,0:30:57.73,0:31:00.02,Default,,0,0,0,,Бір нәрсе басқаша болды
Dialogue: 0,0:31:01.02,0:31:02.40,Default,,0,0,0,,Бұл Такаки Тоно.
Dialogue: 0,0:31:02.52,0:31:07.40,Default,,0,0,0,,Мен ата-анамның жұмысына байланысты мектеп ауыстыруға үйренгенмін, бірақ мен бұл аралға әлі үйренбегенмін.
Dialogue: 0,0:31:07.53,0:31:08.70,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:31:08.82,0:31:13.03,Default,,0,0,0,,Мен оған орта мектептің екінші курсында сол күні ғашық болдым және онымен бір орта мектепке барғым келді.
Dialogue: 0,0:31:13.91,0:31:17.00,Default,,0,0,0,,Мен өте қатты оқып, емтиханнан сүрінбей өттім.
Dialogue: 0,0:31:17.25,0:31:20.21,Default,,0,0,0,,Сонда да мен Тохно-кунды көрген сайын,
Dialogue: 0,0:31:20.33,0:31:22.42,Default,,0,0,0,,Мен саған одан сайын ғашық болдым
Dialogue: 0,0:31:22.58,0:31:25.42,Default,,0,0,0,,Мен одан қорқамын, әр күнім азапты.
Dialogue: 0,0:31:25.63,0:31:27.76,Default,,0,0,0,,Бірақ мен сені көрген сайын қуанамын
Dialogue: 0,0:31:27.92,0:31:31.01,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:31:32.64,0:31:34.39,Default,,0,0,0,,Тоно-кун, тағы да солай.
Dialogue: 0,0:31:34.51,0:31:36.68,Default,,0,0,0,,Хехе, бұл дәмді.
Dialogue: 0,0:31:36.81,0:31:40.10,Default,,0,0,0,,Сумита әрқашан өте байсалды.
Dialogue: 0,0:31:40.23,0:31:41.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:43.44,0:31:45.11,Default,,0,0,0,,Мен алдамын
Dialogue: 0,0:31:45.32,0:31:46.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:31:46.48,0:31:47.61,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:31:47.82,0:31:49.44,Default,,0,0,0,,90 иен.
Dialogue: 0,0:31:49.65,0:31:50.28,Default,,0,0,0,,Жоғары
Dialogue: 0,0:31:50.45,0:31:51.78,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:31:55.12,0:31:55.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:02.62,0:32:04.63,Default,,0,0,0,,Қош келдіңіз, сіз не сатып алдыңыз?
Dialogue: 0,0:32:04.83,0:32:06.09,Default,,0,0,0,,Иә, мен абдырап қалдым...
Dialogue: 0,0:32:06.21,0:32:09.63,Default,,0,0,0,,Тоно-кун кейде біреуге хабарлама жібереді.
Dialogue: 0,0:32:09.80,0:32:11.42,Default,,0,0,0,,Әр жолы мен
Dialogue: 0,0:32:11.55,0:32:14.97,Default,,0,0,0,,Бұл электрондық пошта маған жіберілгенін қалаймын.
Dialogue: 0,0:32:15.18,0:32:19.10,Default,,0,0,0,,Мен бұл туралы үнемі ойламай тұра алмаймын.
Dialogue: 0,0:32:24.15,0:32:25.31,Default,,0,0,0,,Бір!
Dialogue: 0,0:32:26.56,0:32:28.32,Default,,0,0,0,,Уф уф! бір!
Dialogue: 0,0:32:28.65,0:32:29.94,Default,,0,0,0,,Шалғам! Мен үйдемін!
Dialogue: 0,0:32:30.19,0:32:32.99,Default,,0,0,0,,Кабукабу Мен қайтып келдім!
Dialogue: 0,0:32:33.20,0:32:34.28,Default,,0,0,0,,Уау
Dialogue: 0,0:32:53.26,0:32:55.59,Default,,0,0,0,,Мэриядан хабарлама
Dialogue: 0,0:32:55.72,0:32:58.85,Default,,0,0,0,,Келесі кезекші стенд Сақай ауылшаруашылық кооперативінің жанар-жағар май құю...
Dialogue: 0,0:32:59.06,0:33:01.64,Default,,0,0,0,,Канаэ Сумита, 3 курс 1 сынып
Dialogue: 0,0:33:01.77,0:33:04.52,Default,,0,0,0,,Сізге Ито мырза қоңырау шалып жатыр. Студенттік бағыттағы кабинетке келіңіз.
Dialogue: 0,0:33:04.64,0:33:06.52,Default,,0,0,0,,Тононың құрбысы
Dialogue: 0,0:33:06.65,0:33:08.02,Default,,0,0,0,,Бұл қыз немесе басқа нәрсе емес.
Dialogue: 0,0:33:11.73,0:33:14.32,Default,,0,0,0,,Сумита – сыныпта тапсырмаған жалғыз адам.
Dialogue: 0,0:33:14.53,0:33:15.99,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:33:16.11,0:33:18.37,Default,,0,0,0,,Білесің бе, мұны айтқанның несі жаман?
Dialogue: 0,0:33:18.53,0:33:20.87,Default,,0,0,0,,Бұл соншалықты алаңдайтын нәрсе емес.
Dialogue: 0,0:33:21.24,0:33:23.33,Default,,0,0,0,,Сумита мырза не айтып тұр?
Dialogue: 0,0:33:23.45,0:33:24.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:33:25.21,0:33:26.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:33:27.42,0:33:31.05,Default,,0,0,0,,Егер сіз шынымен шеше алмасаңыз, префектурадағы кіші колледждер туралы не айтасыз?
Dialogue: 0,0:33:31.25,0:33:32.55,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:33:32.67,0:33:33.38,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:33:34.17,0:33:36.88,Default,,0,0,0,,Әпкеңнің бұған еш қатысы болмаса да...
Dialogue: 0,0:33:39.35,0:33:40.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:45.64,0:33:47.31,Default,,0,0,0,,Хахаха
Dialogue: 0,0:33:48.44,0:33:49.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:54.07,0:33:55.24,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:33:57.11,0:33:59.91,Default,,0,0,0,,Мен әпкеме жалынғандықтан серфингпен айналыса бастадым.
Dialogue: 0,0:34:00.24,0:34:03.24,Default,,0,0,0,,Сондай-ақ, менің ойымша, бұл адам туралы ең маңыздысы.
Dialogue: 0,0:34:03.45,0:34:06.83,Default,,0,0,0,,Мен әлі мүлде жоқпын...
Dialogue: 0,0:34:23.39,0:34:26.60,Default,,0,0,0,,(құрғақ қозғалтқыш дыбысы)
Dialogue: 0,0:34:27.39,0:34:28.90,Default,,0,0,0,,(қозғалтқыштың қалыпты дыбысы)
Dialogue: 0,0:34:31.77,0:34:33.52,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:34:33.65,0:34:36.36,Default,,0,0,0,,Жоқ, кездескенше.
Dialogue: 0,0:34:55.34,0:34:59.30,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:35:04.76,0:35:06.93,Default,,0,0,0,,Тоно-кун жатқан жерге келгенде
Dialogue: 0,0:35:07.06,0:35:10.98,Default,,0,0,0,,Кеудемнің тереңінде... аздап ауырады.
Dialogue: 0,0:35:11.65,0:35:12.61,Default,,0,0,0,,Тоно-кун!
Dialogue: 0,0:35:12.73,0:35:15.48,Default,,0,0,0,,Сумита? Мен не болғанын түсіндім.
Dialogue: 0,0:35:15.69,0:35:18.99,Default,,0,0,0,,Хехехе Тонокунның мотоциклі сонда болды.
Dialogue: 0,0:35:19.11,0:35:20.66,Default,,0,0,0,,Мен осындамын, жарай ма?
Dialogue: 0,0:35:20.82,0:35:23.16,Default,,0,0,0,,Иә, түсіндім, мен бақыттымын.
Dialogue: 0,0:35:23.37,0:35:26.08,Default,,0,0,0,,Мен сені бүгін мотоцикл алаңында кездестіре алмадым.
Dialogue: 0,0:35:26.20,0:35:27.45,Default,,0,0,0,,Мен де!
Dialogue: 0,0:35:27.58,0:35:29.16,Default,,0,0,0,,Ол мейірімді
Dialogue: 0,0:35:29.79,0:35:33.25,Default,,0,0,0,,Кейде жылағым келеді
Dialogue: 0,0:35:36.05,0:35:38.01,Default,,0,0,0,,Эй, Тоно-кун, сен қабылдау емтиханын тапсырып жатырсың ба?
Dialogue: 0,0:35:38.21,0:35:40.84,Default,,0,0,0,,Иә, Токиодағы университетке түс.
Dialogue: 0,0:35:41.22,0:35:45.85,Default,,0,0,0,,Токио... Түсіндім, мен солай ойладым.
Dialogue: 0,0:35:46.47,0:35:47.52,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:35:47.68,0:35:50.69,Default,,0,0,0,,Әйтеуір алысқа кеткен сияқтысың
Dialogue: 0,0:35:51.19,0:35:52.35,Default,,0,0,0,,Сумита ше?
Dialogue: 0,0:35:52.52,0:35:53.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:53.77,0:35:57.02,Default,,0,0,0,,Мен ертең туралы білмеймін.
Dialogue: 0,0:35:57.23,0:35:59.03,Default,,0,0,0,,Барлығы солай істейтін шығар.
Dialogue: 0,0:35:59.19,0:36:01.03,Default,,0,0,0,,Өтірік! Тоно-кун да?
Dialogue: 0,0:36:01.20,0:36:02.03,Default,,0,0,0,,Әрине
Dialogue: 0,0:36:02.95,0:36:05.49,Default,,0,0,0,,Ешқандай тартыну жоқ сияқты.
Dialogue: 0,0:36:05.91,0:36:09.00,Default,,0,0,0,,Жоқ, мен жай ғана абдырап қалдым.
Dialogue: 0,0:36:09.25,0:36:12.67,Default,,0,0,0,,Қолымнан келгенін істеп жатырмын, қолымнан келмейді
Dialogue: 0,0:36:13.42,0:36:14.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:36:15.63,0:36:17.17,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:36:24.30,0:36:25.51,Default,,0,0,0,,Ұшақ?
Dialogue: 0,0:36:25.64,0:36:26.72,Default,,0,0,0,,Иә
Dialogue: 0,0:36:51.29,0:36:58.25,Default,,0,0,0,,(Дизель қозғалтқышының қатты шуы)
Dialogue: 0,0:37:16.90,0:37:18.44,Default,,0,0,0,,…Тамаша
Dialogue: 0,0:37:19.44,0:37:21.07,Default,,0,0,0,,5км/сағ.
Dialogue: 0,0:37:21.19,0:37:22.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:22.94,0:37:24.90,Default,,0,0,0,,Минамитан ұшыру алаңына
Dialogue: 0,0:37:25.03,0:37:26.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:26.45,0:37:29.20,Default,,0,0,0,,Биылғы жылы іске қосылғанымызға көп уақыт болды.
Dialogue: 0,0:37:29.37,0:37:32.95,Default,,0,0,0,,А, біз күн жүйесіне өте алысқа барамыз.
Dialogue: 0,0:37:33.08,0:37:34.62,Default,,0,0,0,,Жылдар бойы
Dialogue: 0,0:37:54.06,0:37:57.81,Default,,0,0,0,,Сіз Канэймен оның мансап жолы туралы кеңесуіңіз керек.
Dialogue: 0,0:37:58.02,0:37:59.48,Default,,0,0,0,,Ол – санасыз бала.
Dialogue: 0,0:37:59.65,0:38:02.98,Default,,0,0,0,,Жарайды, ол енді бала емес.
Dialogue: 0,0:38:07.03,0:38:08.99,Default,,0,0,0,,Мен де солай едім...
Dialogue: 0,0:38:11.03,0:38:15.08,Default,,0,0,0,,Эй Кабу, Тоно-кун да түсінбейді.
Dialogue: 0,0:38:15.20,0:38:18.67,Default,,0,0,0,,Біз біргеміз...Тоно-кун да.
Dialogue: 0,0:38:18.96,0:38:21.17,Default,,0,0,0,,Бұл шынымен...
Dialogue: 0,0:38:21.50,0:38:25.01,Default,,0,0,0,,Бұл елестете алмайтын жалғыз саяхат болуы керек.
Dialogue: 0,0:38:26.05,0:38:29.34,Default,,0,0,0,,Нағыз қараңғылықта, тек бір оймен
Dialogue: 0,0:38:29.47,0:38:33.14,Default,,0,0,0,,Тіпті жалғыз сутегі атомы да сирек кездеседі
Dialogue: 0,0:38:33.76,0:38:39.52,Default,,0,0,0,,Мен тұңғиықтың тереңінде жатқан дүниелік құпияларға жақындағым келеді.
Dialogue: 0,0:38:44.73,0:38:48.61,Default,,0,0,0,,Осылай қанша уақытқа барамыз?
Dialogue: 0,0:38:49.03,0:38:51.78,Default,,0,0,0,,Біз қаншалықты алыс жүре аламыз?
Dialogue: 0,0:38:57.25,0:39:01.71,Default,,0,0,0,,(электрондық поштаны теру дыбысы)
Dialogue: 0,0:39:10.76,0:39:15.39,Default,,0,0,0,,Мен мақсатсыз хаттарды жіберуді қашан әдетке айналдырдым деп ойлаймын.
Dialogue: 0,0:39:52.68,0:39:54.76,Default,,0,0,0,,Кана, сен мансап жолыңды шештің бе?
Dialogue: 0,0:39:54.93,0:39:57.52,Default,,0,0,0,,Жоқ, мен әлі білмеймін.
Dialogue: 0,0:39:57.64,0:39:59.85,Default,,0,0,0,,Бірақ бәрібір, мен шештім!
Dialogue: 0,0:40:00.23,0:40:03.77,Default,,0,0,0,,Қолымыздан келгенді бір-бірден жасайық. Барайық!
Dialogue: 0,0:40:21.00,0:40:25.08,Default,,0,0,0,,Сол күннен бері бірнеше тайфун өтті.
Dialogue: 0,0:40:25.21,0:40:28.80,Default,,0,0,0,,Әр жолы арал сәл салқындай бастады.
Dialogue: 0,0:40:30.71,0:40:33.97,Default,,0,0,0,,Қантты тербеткен жел аздап салқындайды.
Dialogue: 0,0:40:34.14,0:40:36.30,Default,,0,0,0,,Аспан сәл биік
Dialogue: 0,0:40:36.43,0:40:38.81,Default,,0,0,0,,Бұлттардың контурлары жұмсақ болады.
Dialogue: 0,0:40:38.97,0:40:40.98,Default,,0,0,0,,Шалқан мінген сыныптастары
Dialogue: 0,0:40:41.10,0:40:43.44,Default,,0,0,0,,Енді жұқа секіргіш киеді
Dialogue: 0,0:40:55.99,0:40:57.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:59.03,0:41:02.16,Default,,0,0,0,,Жарты жыл ішінде мен алғаш рет толқын үстінде тұрдым
Dialogue: 0,0:41:02.37,0:41:06.75,Default,,0,0,0,,Қазан айының ортасы еді, жазға аз ғана уақыт қалды.
Dialogue: 0,0:41:17.72,0:41:20.18,Default,,0,0,0,,Бүгін кештен бастап күн ашық болады.
Dialogue: 0,0:41:20.31,0:41:22.35,Default,,0,0,0,,Желдің максималды жылдамдығы 8 м болады деп болжануда.
Dialogue: 0,0:41:22.52,0:41:25.64,Default,,0,0,0,,Сасаки мырза, Ямада оны мойындаған сияқты.
Dialogue: 0,0:41:25.81,0:41:27.52,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:41:27.73,0:41:30.19,Default,,0,0,0,,Иә? Кана бүгін бақытты сияқты.
Dialogue: 0,0:41:30.32,0:41:32.19,Default,,0,0,0,,Тоно-кунмен бірдеңе болды ма?
Dialogue: 0,0:41:32.82,0:41:33.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:33.65,0:41:34.49,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:41:36.11,0:41:38.49,Default,,0,0,0,,Бүгін мен үшін де күн...
Dialogue: 0,0:41:38.62,0:41:40.83,Default,,0,0,0,,Тоно-кунды мойындау.
Dialogue: 0,0:41:45.37,0:41:47.54,Default,,0,0,0,,Толқынды міндім деп бүгін айтуым керек.
Dialogue: 0,0:41:47.71,0:41:51.38,Default,,0,0,0,,Мен де қазірден бастап сенімдімін...Мәңгі айта алмаймын
Dialogue: 0,0:42:01.18,0:42:02.18,Default,,0,0,0,,Сумита
Dialogue: 0,0:42:02.39,0:42:03.39,Default,,0,0,0,,Және…
Dialogue: 0,0:42:04.39,0:42:05.89,Default,,0,0,0,,Тоно-кун...
Dialogue: 0,0:42:06.02,0:42:06.73,Default,,0,0,0,,Енді үйге барасың ба?
Dialogue: 0,0:42:06.89,0:42:07.85,Default,,0,0,0,,Иә
Dialogue: 0,0:42:08.02,0:42:08.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:42:09.02,0:42:11.57,Default,,0,0,0,,Олай болса үйге бірге барайық.
Dialogue: 0,0:42:33.67,0:42:36.09,Default,,0,0,0,,Эй, Сумита, бүгін шешілді ме?
Dialogue: 0,0:42:36.30,0:42:37.72,Default,,0,0,0,,Иә
Dialogue: 0,0:42:41.80,0:42:42.51,Default,,0,0,0,,Ах…
Dialogue: 0,0:42:43.64,0:42:44.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:44.68,0:42:45.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:48.48,0:42:49.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:50.77,0:42:51.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:56.53,0:42:57.86,Default,,0,0,0,,...Оны нашарлатпа
Dialogue: 0,0:42:57.99,0:42:59.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:00.82,0:43:01.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:43:02.24,0:43:04.74,Default,,0,0,0,,Кешіріңіз... бұл ештеңе емес.
Dialogue: 0,0:43:05.62,0:43:07.12,Default,,0,0,0,,(құрғақ қозғалтқыш дыбысы)
Dialogue: 0,0:43:10.58,0:43:11.25,Default,,0,0,0,,Ах
Dialogue: 0,0:43:12.17,0:43:13.38,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:43:13.50,0:43:15.46,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:43:16.84,0:43:17.63,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:43:17.84,0:43:20.97,Default,,0,0,0,,Иә... Менің ойымша, бұл штепсельдің қызмет ету мерзімі.
Dialogue: 0,0:43:21.14,0:43:22.30,Default,,0,0,0,,Бұл қолма-қол жұмыс па?
Dialogue: 0,0:43:22.43,0:43:23.64,Default,,0,0,0,,Иә, сіздің әпкеңіздікі
Dialogue: 0,0:43:23.76,0:43:25.47,Default,,0,0,0,,Сіз үдеуден дем алған жоқсыз ба?
Dialogue: 0,0:43:25.60,0:43:27.14,Default,,0,0,0,,Мен мұны істеген болармын.
Dialogue: 0,0:43:28.23,0:43:32.48,Default,,0,0,0,,Бүгінге қалдырыңыз, үйдегілер оны кейінірек келіп алып кетсін.
Dialogue: 0,0:43:32.65,0:43:33.90,Default,,0,0,0,,Бүгін серуендейміз
Dialogue: 0,0:43:34.02,0:43:38.32,Default,,0,0,0,,Е, мен жалғыз жүремін! Тоно-кун, алдымен үйге бар.
Dialogue: 0,0:43:38.49,0:43:40.32,Default,,0,0,0,,Осылай келсең, жақынсың.
Dialogue: 0,0:43:40.49,0:43:43.57,Default,,0,0,0,,Ал мен жай ғана... жаяу жүргім келеді.
Dialogue: 0,0:43:43.87,0:43:58.01,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:44:05.55,0:44:13.19,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:44:18.61,0:44:19.86,Default,,0,0,0,,Тоно-кун...
Dialogue: 0,0:44:20.15,0:44:21.49,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:44:29.66,0:44:31.87,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:44:32.50,0:44:33.46,Default,,0,0,0,,Не болды! ?
Dialogue: 0,0:44:33.58,0:44:36.88,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:44:37.04,0:44:38.50,Default,,0,0,0,,Эй… Өзіңді қолыңнан келсін!!
Dialogue: 0,0:44:40.38,0:44:41.30,Default,,0,0,0,,Сумита…
Dialogue: 0,0:44:41.84,0:44:43.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:43.47,0:44:46.05,Default,,0,0,0,,Өтінемін... қазірдің өзінде...
Dialogue: 0,0:44:46.26,0:44:47.39,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:44:48.14,0:44:49.81,Default,,0,0,0,,Маған оңай болма...!
Dialogue: 0,0:44:50.89,0:44:54.23,Default,,0,0,0,,(Кенеттен аққудың айқайын үзді)
Dialogue: 0,0:44:58.77,0:45:00.40,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:46:24.65,0:46:28.45,Default,,0,0,0,,Амалсыз, аспанға соқыр ғана қол созу
Dialogue: 0,0:46:28.57,0:46:31.45,Default,,0,0,0,,Осындай үлкен катамариді ұшыру
Dialogue: 0,0:46:31.58,0:46:35.45,Default,,0,0,0,,Алыстағы нәрсеге қадала қарау
Dialogue: 0,0:46:40.38,0:46:43.84,Default,,0,0,0,,Тоно-кунның басқа адамдардан ерекшеленуінің себебі
Dialogue: 0,0:46:43.96,0:46:46.17,Default,,0,0,0,,Мен аздап түсінгендей болдым.
Dialogue: 0,0:46:46.51,0:46:48.18,Default,,0,0,0,,Сонымен қатар
Dialogue: 0,0:46:48.63,0:46:51.85,Default,,0,0,0,,Мен Тонокунның маған қарамай тұрғанын түсіндім.
Dialogue: 0,0:46:52.05,0:46:54.43,Default,,0,0,0,,Мен анық байқадым
Dialogue: 0,0:46:58.69,0:47:03.36,Default,,0,0,0,,Сол күні мен Тоноға ештеңе айта алмадым.
Dialogue: 0,0:47:08.03,0:47:09.86,Default,,0,0,0,,Уф уф! бір!
Dialogue: 0,0:47:13.74,0:47:16.20,Default,,0,0,0,,(Такакидің ізі)
Dialogue: 0,0:47:17.08,0:47:19.54,Default,,0,0,0,,Тоно-кун мейірімді, бірақ
Dialogue: 0,0:47:19.75,0:47:21.71,Default,,0,0,0,,Өте мейірімді болса да
Dialogue: 0,0:47:22.83,0:47:23.88,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:47:24.00,0:47:25.50,Default,,0,0,0,,Тоно-кун әрқашан
Dialogue: 0,0:47:25.63,0:47:30.38,Default,,0,0,0,,Менен алыс... Одан да алыс бірдеңеге қарап тұрмын
Dialogue: 0,0:47:41.10,0:47:45.19,Default,,0,0,0,,Тоно-кунға тілегім орындалмайды.
Dialogue: 0,0:47:45.32,0:47:47.07,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:47:47.23,0:47:50.03,Default,,0,0,0,,Сонда да мен Тоно-кун туралы ойлаймын.
Dialogue: 0,0:47:50.15,0:47:52.41,Default,,0,0,0,,Әрине, ертең, арғы күні және одан әрі
Dialogue: 0,0:47:52.57,0:47:55.08,Default,,0,0,0,,Мен оны не болса да жақсы көремін деп ойлаймын.
Dialogue: 0,0:47:57.83,0:48:00.75,Default,,0,0,0,,Тоно-кунды ғана ойлау
Dialogue: 0,0:48:01.12,0:48:04.08,Default,,0,0,0,,Мен жылап ұйықтап қалдым
Dialogue: 0,0:49:17.20,0:49:24.50,Default,,0,0,0,,(Темір жол өткелінің дыбысы)
Dialogue: 0,0:49:25.75,0:49:26.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:30.09,0:49:32.34,Default,,0,0,0,,Қазір артқа қарасақ
Dialogue: 0,0:49:32.46,0:49:36.64,Default,,0,0,0,,Ол кісі де артына қараса қатты сезгеніне сенімдімін.
Dialogue: 0,0:49:50.02,0:49:54.53,Default,,0,0,0,,Токиоға бара жатқан соңғы Чуо/Собу пойызы келді.
Dialogue: 0,0:50:21.56,0:50:27.35,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:50:35.15,0:50:46.20,Default,,0,0,0,,(Ұялы қоңырау үні)
Dialogue: 0,0:51:10.23,0:51:12.27,Default,,0,0,0,,Жаңа жылға дейін қалсам ғой
Dialogue: 0,0:51:12.48,0:51:15.44,Default,,0,0,0,,Иә...бірақ түрлі дайындықтар да бар.
Dialogue: 0,0:51:15.61,0:51:19.07,Default,,0,0,0,,Дұрыс, оған жақсы нәрсе жасаңыз.
Dialogue: 0,0:51:19.20,0:51:19.95,Default,,0,0,0,,Иә
Dialogue: 0,0:51:20.07,0:51:22.91,Default,,0,0,0,,Егер саған бірдеңе керек болса, маған хабарлас, Акари.
Dialogue: 0,0:51:23.03,0:51:24.12,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:51:24.24,0:51:27.62,Default,,0,0,0,,Біз келесі айда салтанатты жағдайда кездесеміз, сондықтан көп уайымдамаңыз.
Dialogue: 0,0:51:28.50,0:51:30.62,Default,,0,0,0,,Күн суық, енді қайтайық.
Dialogue: 0,0:51:51.02,0:51:54.48,Default,,0,0,0,,Мен ескі түс көрдім
Dialogue: 0,0:51:55.27,0:51:58.65,Default,,0,0,0,,Ол екеуміз әлі бала едік.
Dialogue: 0,0:51:59.24,0:52:02.61,Default,,0,0,0,,Кеше тапқан хаттың арқасы екеніне сенімдімін.
Dialogue: 0,0:52:28.27,0:52:30.52,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:52:56.29,0:52:57.21,Default,,0,0,0,,Мизуно мырза
Dialogue: 0,0:52:57.38,0:52:58.17,Default,,0,0,0,,Иә
Dialogue: 0,0:52:58.30,0:52:59.34,Default,,0,0,0,,Жиналыс өткізуге болады ма?
Dialogue: 0,0:52:59.46,0:53:00.55,Default,,0,0,0,,Иә
Dialogue: 0,0:53:08.97,0:53:14.23,Default,,0,0,0,,Тек өмір сүрген сайын мұң мен жерде жиналады.
Dialogue: 0,0:53:15.40,0:53:18.86,Default,,0,0,0,,Жуынатын бөлмеде кептірілген парақтарда да, тіс щеткаларында да.
Dialogue: 0,0:53:19.15,0:53:21.40,Default,,0,0,0,,Сондай-ақ ұялы телефон тарихында
Dialogue: 0,0:53:29.66,0:53:31.75,Default,,0,0,0,,(Кілттің құлаған дыбысы)
Dialogue: 0,0:53:43.63,0:53:46.55,Default,,0,0,0,,«Мен сені әлі де жақсы көремін»
Dialogue: 0,0:53:46.68,0:53:50.68,Default,,0,0,0,,Мен үш жыл кездескен әйел электронды поштаға осылай жазды.
Dialogue: 0,0:53:51.72,0:53:53.93,Default,,0,0,0,,«Бірақ біз сөзсіз»
Dialogue: 0,0:53:54.10,0:53:56.23,Default,,0,0,0,,«1000 рет электрондық хат алмасу»
Dialogue: 0,0:53:56.44,0:54:01.61,Default,,0,0,0,,«Мүмкін біздің жүрегіміз бір сантиметрге жақын болған шығар».
Dialogue: 0,0:54:09.28,0:54:12.62,Default,,0,0,0,,Соңғы бірнеше жылда мен тек алға ұмтылғым келді.
Dialogue: 0,0:54:12.74,0:54:17.62,Default,,0,0,0,,Мен қолым жетпейтін нәрсені ұстағым келеді, бірақ бұл нені білдіреді?
Dialogue: 0,0:54:18.12,0:54:20.79,Default,,0,0,0,,Бұл сезімді қорқыту деп атауға болады.
Dialogue: 0,0:54:21.00,0:54:24.97,Default,,0,0,0,,Қайдан шыққанын білмей, жұмыс істей беремін.
Dialogue: 0,0:54:25.17,0:54:30.14,Default,,0,0,0,,Мен білмей тұрып, жүрегім күннен-күнге икемділігін жоғалтып, тек ауыратын болды.
Dialogue: 0,0:54:31.64,0:54:33.31,Default,,0,0,0,,Және бір таң
Dialogue: 0,0:54:33.43,0:54:36.48,Default,,0,0,0,,Менің сезімдерім бір кездері соншалықты салмақты және шынайы болды.
Dialogue: 0,0:54:36.64,0:54:39.48,Default,,0,0,0,,Мен оның мүлдем жоғалғанын түсіндім.
Dialogue: 0,0:54:39.85,0:54:42.11,Default,,0,0,0,,Сіз өз шегіңізге жеткеніңізді білсеңіз
Dialogue: 0,0:54:42.23,0:54:44.15,Default,,0,0,0,,Компаниядан шығу
Dialogue: 0,0:54:49.32,0:54:53.62,Default,,0,0,0,,（♪「Тағы бір рет, тағы бір мүмкіндік」）
Dialogue: 0,0:55:07.51,0:55:09.80,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:55:09.93,0:55:12.30,Default,,0,0,0,,Мен кеше түс көрдім
Dialogue: 0,0:55:12.51,0:55:14.81,Default,,0,0,0,,Бұрынғы арман
Dialogue: 0,0:55:14.97,0:55:18.94,Default,,0,0,0,,Сол түсте біз небәрі 13 жаста едік
Dialogue: 0,0:55:19.10,0:55:23.15,Default,,0,0,0,,Қар басқан кең дала еді.
Dialogue: 0,0:55:23.31,0:55:27.36,Default,,0,0,0,,Үйлердің шамдары алыстан көрінеді, аз ғана көрінеді.
Dialogue: 0,0:55:27.53,0:55:29.53,Default,,0,0,0,,Жаңа жауған қарда
Dialogue: 0,0:55:29.70,0:55:32.87,Default,,0,0,0,,Біз басып өткен аяқтың іздері ғана қалды.
Dialogue: 0,0:55:33.03,0:55:34.33,Default,,0,0,0,,Осылайша
Dialogue: 0,0:55:34.45,0:55:37.87,Default,,0,0,0,,Бір күні шие гүлін бірге көреміз деп үміттенемін.
Dialogue: 0,0:55:38.00,0:55:41.37,Default,,0,0,0,,Ол да, мен де іркілмейміз.
Dialogue: 0,0:55:41.50,0:55:43.33,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:55:43.54,0:55:50.55,Default,,0,0,0,,♪Мен сені әрқашан бір жерден іздеймін
Dialogue: 0,0:55:50.68,0:55:54.39,Default,,0,0,0,,♪ Қарсы платформа, артқы аллеядағы терезе
Dialogue: 0,0:55:54.60,0:55:58.02,Default,,0,0,0,,♪Бұл жерде болуым мүмкін емес
Dialogue: 0,0:55:58.35,0:56:05.32,Default,,0,0,0,,♪Егер тілегім орындалса, мен саған дәл қазір келер едім
Dialogue: 0,0:56:05.52,0:56:08.90,Default,,0,0,0,,♪Мен істей алмайтын ештеңе жоқ
Dialogue: 0,0:56:09.15,0:56:15.16,Default,,0,0,0,,♪Бәрін беріп, құшақтаймын
Dialogue: 0,0:56:24.29,0:56:31.38,Default,,0,0,0,,♪Жалғыздығыңызды жеңілдету үшін мұны кез келген адам жасай алады.
Dialogue: 0,0:56:31.80,0:56:38.68,Default,,0,0,0,,♪Жұлдыздар құлағалы тұрған түн, сондықтан мен өзімді бағалай алмаймын
Dialogue: 0,0:56:38.89,0:56:46.27,Default,,0,0,0,,♪Тағы бір маусым, жалықпа
Dialogue: 0,0:56:46.56,0:56:53.61,Default,,0,0,0,,♪Тағы бір рет Ойнайтын кез келді
Dialogue: 0,0:56:53.95,0:57:01.12,Default,,0,0,0,,♪Мен сені әрқашан бір жерден іздеймін
Dialogue: 0,0:57:01.29,0:57:04.79,Default,,0,0,0,,♪Қиылыста, тіпті түсінде
Dialogue: 0,0:57:04.96,0:57:08.13,Default,,0,0,0,,♪Мұндай жерде болуым мүмкін емес
Dialogue: 0,0:57:08.71,0:57:15.64,Default,,0,0,0,,♪Егер бір керемет орын алса, мен оны дәл қазір көрсеткім келеді
Dialogue: 0,0:57:15.84,0:57:19.31,Default,,0,0,0,,♪Жаңа таң, менің болашақ өзім
Dialogue: 0,0:57:19.56,0:57:26.15,Default,,0,0,0,,♪Мен сені сүйемін деген сөзді де айта алмадым
Dialogue: 0,0:57:34.70,0:57:41.16,Default,,0,0,0,,♪Жаз туралы естеліктер айналады
Dialogue: 0,0:57:42.66,0:57:48.84,Default,,0,0,0,,♪Кенеттен өшіп қалған жүрек соғысы
Dialogue: 0,0:57:49.67,0:57:57.09,Default,,0,0,0,,♪Мен сені әрқашан бір жерден іздеймін
Dialogue: 0,0:57:57.26,0:58:00.85,Default,,0,0,0,,♪Сакурагичо қаласында таң ата
Dialogue: 0,0:58:00.97,0:58:04.68,Default,,0,0,0,,♪Осындай жерге келмеуім керек еді.
Dialogue: 0,0:58:04.85,0:58:11.98,Default,,0,0,0,,♪Егер тілегім орындалса, мен саған дәл қазір келер едім
Dialogue: 0,0:58:12.11,0:58:15.53,Default,,0,0,0,,♪Мен істей алмайтын ештеңе жоқ
Dialogue: 0,0:58:15.65,0:58:19.32,Default,,0,0,0,,♪Бәрін беріп, құшақтаймын
Dialogue: 0,0:58:19.49,0:58:26.50,Default,,0,0,0,,♪Мен әрқашан бір жерден сіздің шығармаларыңызды іздеймін
Dialogue: 0,0:58:26.66,0:58:30.04,Default,,0,0,0,,♪Саяхат дүкенінің газет бұрышы
Dialogue: 0,0:58:30.25,0:58:33.88,Default,,0,0,0,,♪Мұндай жерде болуы мүмкін емес.
Dialogue: 0,0:58:34.05,0:58:41.01,Default,,0,0,0,,♪Егер бір ғажайып орын алса, мен оны дәл қазір көрсеткім келеді
Dialogue: 0,0:58:41.18,0:58:44.68,Default,,0,0,0,,♪Жаңа таң, менің болашақ өзім
Dialogue: 0,0:58:44.81,0:58:48.23,Default,,0,0,0,,♪Мен сені сүйемін деген сөзді де айта алмадым
Dialogue: 0,0:58:48.65,0:58:55.69,Default,,0,0,0,,♪Мен сенің күлкіңді бір жерден іздеймін
Dialogue: 0,0:58:55.86,0:58:59.24,Default,,0,0,0,,♪Темір жол өткелінде жедел пойызды күту
Dialogue: 0,0:58:59.41,0:59:03.08,Default,,0,0,0,,♪Осындай жерде болуым мүмкін емес
Dialogue: 0,0:59:03.24,0:59:10.50,Default,,0,0,0,,♪Өмір қайталанса, Мен саған қайта-қайта келемін
Dialogue: 0,0:59:10.63,0:59:14.09,Default,,0,0,0,,♪Енді мен қалаған ештеңе жоқ
