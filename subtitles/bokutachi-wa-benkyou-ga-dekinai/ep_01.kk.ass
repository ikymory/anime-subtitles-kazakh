Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.04,Default,,0,0,0,,Түсіндім, Кирису-кун.
Dialogue: 0,0:00:05.79,0:00:06.92,Default,,0,0,0,,Тіпті сенің қолыңнан келмейді.
Dialogue: 0,0:00:07.96,0:00:10.38,Default,,0,0,0,,Кешіріңіз, директор.
Dialogue: 0,0:00:10.84,0:00:13.17,Default,,0,0,0,,Бірақ мен одан да көпмін.
Dialogue: 0,0:00:13.30,0:00:16.55,Default,,0,0,0,,Біз студенттерге босқа күш жұмсауға көмектесе алмаймыз.
Dialogue: 0,0:00:19.35,0:00:22.23,Default,,0,0,0,,Тағы қате болды ма?
Dialogue: 0,0:00:23.31,0:00:25.69,Default,,0,0,0,,Сонымен, келесі…
Dialogue: 0,0:00:30.48,0:00:36.49,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:51.44,0:01:57.45,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:02.87,0:02:04.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:09.92,0:02:13.67,Default,,0,0,0,,Бұл дүниеде данышпан деп аталатын адамдар бар.
Dialogue: 0,0:02:15.17,0:02:16.92,Default,,0,0,0,,Мұғалім, орындалды.
Dialogue: 0,0:02:17.88,0:02:20.09,Default,,0,0,0,,Барлық сұрақтар дұрыс.
Dialogue: 0,0:02:20.30,0:02:22.10,Default,,0,0,0,,Бірақ Огата мырза, ортаңғы рәсім туралы не деуге болады?
Dialogue: 0,0:02:22.97,0:02:24.26,Default,,0,0,0,,Мидуэй рәсімі?
Dialogue: 0,0:02:25.18,0:02:26.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:26.47,0:02:29.60,Default,,0,0,0,,Мен жауапты көргенде-ақ білдім, сондықтан оны өткізіп жібердім.
Dialogue: 0,0:02:31.31,0:02:34.86,Default,,0,0,0,,Математика мен физика бойынша теңдесі жоқ
Dialogue: 0,0:02:35.48,0:02:37.94,Default,,0,0,0,,Таңғажайып биіктігі 143 см
Dialogue: 0,0:02:38.19,0:02:42.28,Default,,0,0,0,,«Механикалық бас бармақ ханшайымы» Ризу Огата
Dialogue: 0,0:02:43.37,0:02:44.62,Default,,0,0,0,,Фурухаши!
Dialogue: 0,0:02:44.74,0:02:49.29,Default,,0,0,0,,Қандай... Не деген әсерлі, әсерлі эссе.
Dialogue: 0,0:02:49.66,0:02:53.38,Default,,0,0,0,,Не? Мм... Мен оны әдеттегідей жаздым.
Dialogue: 0,0:02:53.88,0:02:55.04,Default,,0,0,0,,Тағы да айтайын
Dialogue: 0,0:02:55.46,0:02:58.26,Default,,0,0,0,,Бұл дүниеде данышпан деп аталатын адамдар бар.
Dialogue: 0,0:02:58.59,0:03:02.26,Default,,0,0,0,,Фурухаши мырза, мен тапсырудан 10 минут бұрын ұйықтап қалдым.
Dialogue: 0,0:03:02.97,0:03:05.14,Default,,0,0,0,,Данышпандар әр түрлі.
Dialogue: 0,0:03:05.22,0:03:07.52,Default,,0,0,0,,Оның үстіне ол әдемі, мен оған тәнтімін.
Dialogue: 0,0:03:09.31,0:03:12.98,Default,,0,0,0,,Қазіргі, көне және қытай әдебиетіндегі жетекші
Dialogue: 0,0:03:13.69,0:03:17.98,Default,,0,0,0,,«Әдебиет орманының ұйықтап жатқан ханшайымы» Фумино Фурухаши
Dialogue: 0,0:03:20.74,0:03:23.95,Default,,0,0,0,,Әрине, данышпан емес адамдар бар.
Dialogue: 0,0:03:24.82,0:03:27.54,Default,,0,0,0,,Кішкентай кезімнен есте сақтау қабілетім мен ептілігім нашар болды.
Dialogue: 0,0:03:27.99,0:03:32.12,Default,,0,0,0,,«Қарапайым адамдардан шыққан тамаша талант», басқалардан бірнеше есе көп тырыспай ештеңеге қол жеткізе алмайды.
Dialogue: 0,0:03:33.25,0:03:34.54,Default,,0,0,0,,Бұл Шехер астрономиялық басқармасы—
Dialogue: 0,0:03:45.68,0:03:46.93,Default,,0,0,0,,Нари-чан (Нариюки) Иә?
Dialogue: 0,0:03:47.14,0:03:49.22,Default,,0,0,0,,Сіз кітапханада оқисыз ба?
Dialogue: 0,0:03:49.35,0:03:50.43,Default,,0,0,0,,Ууух!
Dialogue: 0,0:03:50.56,0:03:52.64,Default,,0,0,0,,Бізбен ара-тұра сыртқа шығайық.
Dialogue: 0,0:03:53.27,0:03:54.35,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:03:54.48,0:03:57.36,Default,,0,0,0,,Сей Чан арнайы VIP ұсынысын алуды көздеп отыр.\NБұл
Dialogue: 0,0:03:57.48,0:04:01.19,Default,,0,0,0,,ма? Әсіресе, дарынды оқушылар іріктелетін болады.
Dialogue: 0,0:04:01.44,0:04:02.28,Default,,0,0,0,,Иә
Dialogue: 0,0:04:02.45,0:04:04.57,Default,,0,0,0,,Арнайы VIP ұсынысы үшін таңдалған болса
Dialogue: 0,0:04:04.70,0:04:07.33,Default,,0,0,0,,Ешқандай емтихансыз еншілес университетке түсуге болады.
Dialogue: 0,0:04:07.45,0:04:10.37,Default,,0,0,0,,Менің мектебім барлық оқу ақысын төлейді.
Dialogue: 0,0:04:10.50,0:04:11.66,Default,,0,0,0,,Армандар жүйесі!
Dialogue: 0,0:04:12.08,0:04:13.37,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:04:13.54,0:04:16.50,Default,,0,0,0,,Мен өте кедеймін, сондықтан ...
Dialogue: 0,0:04:16.63,0:04:18.34,Default,,0,0,0,,Сәлем! сөздерді таңдау
Dialogue: 0,0:04:18.46,0:04:20.88,Default,,0,0,0,,Сіз қаржылық қиындықтарға тап болуыңыз мүмкін.
Dialogue: 0,0:04:21.01,0:04:25.01,Default,,0,0,0,,３‐Ｂ
Dialogue: 0,0:04:25.51,0:04:28.64,Default,,0,0,0,,３‐Ｂ…
Dialogue: 0,0:04:34.23,0:04:36.98,Default,,0,0,0,,...
Dialogue: 0,0:04:37.11,0:04:40.36,Default,,0,0,0,,８
Dialogue: 0,0:04:40.61,0:04:43.28,Default,,0,0,0,,Сіздің өмір салтыңыз мінсіз бе?
Dialogue: 0,0:04:43.95,0:04:45.32,Default,,0,0,0,,Нанана... Не?
Dialogue: 0,0:04:45.45,0:04:47.95,Default,,0,0,0,,…
Dialogue: 0,0:04:48.45,0:04:49.62,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:49.74,0:04:53.37,Default,,0,0,0,,ＶＩＰ
Dialogue: 0,0:04:53.54,0:04:55.12,Default,,0,0,0,,H... Шынымен бе?
Dialogue: 0,0:04:55.25,0:04:57.42,Default,,0,0,0,,Дегенмен, бір шарт бар.
Dialogue: 0,0:04:59.59,0:05:00.75,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:05:00.88,0:05:01.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:01.84,0:05:03.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:04.05,0:05:05.30,Default,,0,0,0,,Бұл екі...
Dialogue: 0,0:05:06.09,0:05:10.14,Default,,0,0,0,,Өзіңіз білетін шығарсыз, біздің мектеп өзінің кемеңгерлігімен мақтанады.
Dialogue: 0,0:05:10.47,0:05:12.02,Default,,0,0,0,,Фумино Фурухашимен
Dialogue: 0,0:05:12.14,0:05:13.77,Default,,0,0,0,,Бұл Ризу Огата.
Dialogue: 0,0:05:13.98,0:05:16.02,Default,,0,0,0,,Нариюки Юига
Dialogue: 0,0:05:16.44,0:05:19.44,Default,,0,0,0,,Сізді арнайы VIP ұсынысына қосу шарты ретінде
Dialogue: 0,0:05:19.94,0:05:24.61,Default,,0,0,0,,...
Dialogue: 0,0:05:25.40,0:05:26.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:30.33,0:05:32.58,Default,,0,0,0,,Білім? Бұл данышпандарға?
Dialogue: 0,0:05:32.70,0:05:34.12,Default,,0,0,0,,Мен? Не?
Dialogue: 0,0:05:34.58,0:05:37.37,Default,,0,0,0,,...
Dialogue: 0,0:05:37.50,0:05:38.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.67,0:05:40.67,Default,,0,0,0,,...
Dialogue: 0,0:05:40.79,0:05:43.55,Default,,0,0,0,,Сіз өзіңізден бұрынғы мұғалімдер сияқтысыз.
Dialogue: 0,0:05:43.67,0:05:46.26,Default,,0,0,0,,...
Dialogue: 0,0:05:50.09,0:05:52.72,Default,,0,0,0,,...
Dialogue: 0,0:05:53.35,0:05:55.39,Default,,0,0,0,,...
Dialogue: 0,0:05:55.52,0:05:58.44,Default,,0,0,0,,Мен де арнайы VIP ұсыныс алдым.
Dialogue: 0,0:05:58.90,0:06:00.90,Default,,0,0,0,,Шынымен бе? Саған Риччан
Dialogue: 0,0:06:03.07,0:06:05.36,Default,,0,0,0,,〜
Dialogue: 0,0:06:06.11,0:06:07.78,Default,,0,0,0,,Мен бәрібір бастауым керек пе?
Dialogue: 0,0:06:08.45,0:06:10.41,Default,,0,0,0,,Алдымен мен сізден сұрайын, сіз қай мектепке барғыңыз келеді?
Dialogue: 0,0:06:10.82,0:06:13.16,Default,,0,0,0,,…
Dialogue: 0,0:06:13.28,0:06:14.12,Default,,0,0,0,,Гуманитарлық пәндер
Dialogue: 0,0:06:14.24,0:06:15.08,Default,,0,0,0,,Ғылым
Dialogue: 0,0:06:15.20,0:06:16.20,Default,,0,0,0,,университетке
Dialogue: 0,0:06:16.33,0:06:17.16,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:17.91,0:06:19.58,Default,,0,0,0,,Керісінше, ақымақ!
Dialogue: 0,0:06:20.04,0:06:20.92,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:21.04,0:06:23.54,Default,,0,0,0,,Мына жігіттер өз қимылдарын түсінбей ме?
Dialogue: 0,0:06:24.42,0:06:26.17,Default,,0,0,0,,Жоқ, сабыр ет, Нариюки Юига.
Dialogue: 0,0:06:26.30,0:06:27.76,Default,,0,0,0,,Бұл жігіттер данышпан.
Dialogue: 0,0:06:27.88,0:06:31.05,Default,,0,0,0,,...
Dialogue: 0,0:06:33.60,0:06:35.47,Default,,0,0,0,,Осы мәселені шешуге тырысыңыз ба?
Dialogue: 0,0:06:36.02,0:06:37.35,Default,,0,0,0,,қателеспеген еді
Dialogue: 0,0:06:37.48,0:06:39.39,Default,,0,0,0,,Жарайды, мен бар күшімді саламын.
Dialogue: 0,0:06:56.74,0:06:58.16,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:06:58.41,0:06:59.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:59.50,0:07:01.37,Default,,0,0,0,,Бұл қате сұрақ
Dialogue: 0,0:07:01.50,0:07:03.79,Default,,0,0,0,,«Кейіпкерлердің сезімдеріне жауап беру»
Dialogue: 0,0:07:03.92,0:07:05.25,Default,,0,0,0,,Тіпті ғылым түсіндірмейді
Dialogue: 0,0:07:05.38,0:07:08.05,Default,,0,0,0,,Бұл мидың бүкіл құрылымын шешуді сұрау сияқты.
Dialogue: 0,0:07:08.26,0:07:09.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:09.34,0:07:11.55,Default,,0,0,0,,Жоқ! Қарама!
Dialogue: 0,0:07:11.68,0:07:13.59,Default,,0,0,0,,Формулаға қарасам, санам өшеді.
Dialogue: 0,0:07:13.72,0:07:16.14,Default,,0,0,0,,Маған қарама!
Dialogue: 0,0:07:16.97,0:07:21.52,Default,,0,0,0,,Мен жәндіктен артық емеспін.
Dialogue: 0,0:07:22.31,0:07:24.36,Default,,0,0,0,,Жарайды, Нариюки Юига
Dialogue: 0,0:07:24.86,0:07:27.11,Default,,0,0,0,,Керісінше, бұл тәрбиеші не үшін?
Dialogue: 0,0:07:27.23,0:07:28.90,Default,,0,0,0,,Түсінсең де, солай емес пе?
Dialogue: 0,0:07:29.49,0:07:33.32,Default,,0,0,0,,Мәселе мынада, біз бұл жігіттердің әлсіз жерлерін жақсартуымыз керек.
Dialogue: 0,0:07:33.70,0:07:35.91,Default,,0,0,0,,Әзірше, бүгінгі күні осы.
Dialogue: 0,0:07:36.03,0:07:36.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:37.33,0:07:40.71,Default,,0,0,0,,Мен қазір сұрақтардың көлемін көрсетемін, сондықтан оларға дайындалыңыз.
Dialogue: 0,0:07:41.04,0:07:43.25,Default,,0,0,0,,Мен оны ертең тексеремін
Dialogue: 0,0:07:46.00,0:07:46.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:48.59,0:07:50.38,Default,,0,0,0,,Басында осылай
Dialogue: 0,0:07:50.55,0:07:53.72,Default,,0,0,0,,Осы жолы қате жіберген бөліктерді қарап шығуға назар аударыңыз.
Dialogue: 0,0:07:53.89,0:07:55.55,Default,,0,0,0,,Мен ертең қайталап көремін.
Dialogue: 0,0:07:57.68,0:07:59.22,Default,,0,0,0,,Жақсы... жақсы.
Dialogue: 0,0:07:59.35,0:08:02.98,Default,,0,0,0,,Егер сіз сол қателерді жойсаңыз, сіз міндетті түрде көбірек ұпай аласыз.
Dialogue: 0,0:08:05.44,0:08:08.19,Default,,0,0,0,,Күн сайын бір ұпай шебер...
Dialogue: 0,0:08:11.19,0:08:13.91,Default,,0,0,0,,Неліктен азайып барады! Мен мағынасын түсінбеймін!
Dialogue: 0,0:08:14.03,0:08:16.41,Default,,0,0,0,,Бір апта бойы күн сайын бірдей сынақ жүргіздік.
Dialogue: 0,0:08:16.53,0:08:18.37,Default,,0,0,0,,Дафния үшін кешіріңіз. Кешіріңіз.
Dialogue: 0,0:08:18.78,0:08:20.54,Default,,0,0,0,,Эй, бұл қандай да бір қателік.
Dialogue: 0,0:08:21.41,0:08:23.37,Default,,0,0,0,,Мен бұл екі данышпанды ешқашан күтпедім
Dialogue: 0,0:08:23.50,0:08:26.54,Default,,0,0,0,,Мен өзімнің әлсіз жерімде осы уақытқа дейін түбіне жетемін деп ешқашан ойламадым.
Dialogue: 0,0:08:26.88,0:08:28.67,Default,,0,0,0,,Жарайды, мені айналып өтеді.
Dialogue: 0,0:08:29.34,0:08:30.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:30.63,0:08:33.34,Default,,0,0,0,,Екеуіңіз де қазір пайдаланып жатқан мәселелер жинағын беріңіздерші.
Dialogue: 0,0:08:35.64,0:08:38.51,Default,,0,0,0,,Балалар, серіктесіңіз қалаған салада мінсізсіз.
Dialogue: 0,0:08:38.64,0:08:41.22,Default,,0,0,0,,Ендеше неге бір-бірімізді оқытпаймыз?
Dialogue: 0,0:08:42.73,0:08:43.56,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:08:43.68,0:08:44.60,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:08:44.73,0:08:45.94,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:08:46.31,0:08:48.90,Default,,0,0,0,,Мен білмегенді білмеймін
Dialogue: 0,0:08:49.32,0:08:50.73,Default,,0,0,0,,Генийлер
Dialogue: 0,0:08:51.73,0:08:52.57,Default,,0,0,0,,Хаа
Dialogue: 0,0:08:52.90,0:08:54.99,Default,,0,0,0,,Сәлем Фурухаши Огата
Dialogue: 0,0:08:55.70,0:08:58.16,Default,,0,0,0,,Өйткені, өзіңізді тым қатты итермеңіз және өз мамандығыңыз бойынша емтихан тапсырыңыз.
Dialogue: 0,0:08:58.41,0:08:59.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.41,0:09:03.96,Default,,0,0,0,,Кешіріңіз, бірақ менің ойымша, бұл үшінші курс студентінің бірінші семестрі үшін өте қиын.
Dialogue: 0,0:09:04.29,0:09:07.54,Default,,0,0,0,,Оның үстіне екеуінің де таланты бар.
Dialogue: 0,0:09:07.67,0:09:09.67,Default,,0,0,0,,Бұл мүмкіндікті пайдалану әлдеқайда жылдамырақ болар еді.
Dialogue: 0,0:09:09.96,0:09:10.88,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:09:11.30,0:09:13.51,Default,,0,0,0,,Сен де мені тастап кетесің деп ойлаймын.
Dialogue: 0,0:09:13.84,0:09:15.76,Default,,0,0,0,,Талантты ма, жоқ па?
Dialogue: 0,0:09:15.88,0:09:16.72,Default,,0,0,0,,Осы сөздермен
Dialogue: 0,0:09:16.84,0:09:19.30,Default,,0,0,0,,Сіздің өміріңізді басқа адамдарға шешуге мүмкіндік беретін көптеген нәрселер бар!
Dialogue: 0,0:09:19.51,0:09:20.35,Default,,0,0,0,,Ах
Dialogue: 0,0:09:22.01,0:09:22.85,Default,,0,0,0,,Риччан!
Dialogue: 0,0:09:24.73,0:09:26.39,Default,,0,0,0,,Мен сені тастамаймын дедім
Dialogue: 0,0:09:26.52,0:09:27.35,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:09:30.69,0:09:33.78,Default,,0,0,0,,Бірақ сіз дұрыс шығарсыз.
Dialogue: 0,0:09:34.36,0:09:39.53,Default,,0,0,0,,Менің ата-анам да, бұрынғы білім беру мұғалімдерім де бір нәрсені айтты.
Dialogue: 0,0:09:40.24,0:09:43.45,Default,,0,0,0,,Бірақ бәрібір біз...
Dialogue: 0,0:09:45.25,0:09:46.16,Default,,0,0,0,,1 апта Рахмет
Dialogue: 0,0:09:46.29,0:09:48.25,Default,,0,0,0,,Фурухаши! Эй!
Dialogue: 0,0:09:51.25,0:09:52.09,Default,,0,0,0,,Ах
Dialogue: 0,0:09:56.97,0:09:58.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:59.14,0:10:00.55,Default,,0,0,0,,Мен баспасөзде хабарланғандай, осы қылмыскерлерді жоюды тапсырамын.
Dialogue: 0,0:10:00.85,0:10:03.85,Default,,0,0,0,,Шындығында, мен таңдаған мектепті өзгертуден басқа амалым жоқ.
Dialogue: 0,0:10:04.43,0:10:06.73,Default,,0,0,0,,Менің арнайы VIP ұсынысым үшін
Dialogue: 0,0:10:07.06,0:10:10.31,Default,,0,0,0,,Ертең мен ұмытқанымды қайтарамын, сондықтан мен сізді тағы да көндіруге тырысамын...
Dialogue: 0,0:10:11.77,0:10:15.48,Default,,0,0,0,,Олардың екі мәселе жинағы да әбден тозған.
Dialogue: 0,0:10:15.94,0:10:17.53,Default,,0,0,0,,Сіз граффити жасайсыз ба?
Dialogue: 0,0:10:17.95,0:10:18.78,Default,,0,0,0,,Ах
Dialogue: 0,0:10:24.24,0:10:28.04,Default,,0,0,0,,Фурухаши де, Огата да әр беттің әр бұрышына жазады.
Dialogue: 0,0:10:28.87,0:10:31.04,Default,,0,0,0,,Жалықтыратын болса да, мазмұны бейберекет
Dialogue: 0,0:10:31.71,0:10:35.59,Default,,0,0,0,,Огата қазіргі ел үшін жауапты есептеуге тырысуда.
Dialogue: 0,0:10:42.72,0:10:44.72,Default,,0,0,0,,Талантты ма, жоқ па?
Dialogue: 0,0:10:44.85,0:10:45.68,Default,,0,0,0,,Осы сөздермен
Dialogue: 0,0:10:45.81,0:10:48.48,Default,,0,0,0,,Сіздің өміріңізді басқа адамдар шеше алатын көптеген нәрселер бар!
Dialogue: 0,0:10:49.44,0:10:52.48,Default,,0,0,0,,Бірақ бәрібір біз...
Dialogue: 0,0:10:54.36,0:10:56.90,Default,,0,0,0,,А, мен оны көрмеуім керек еді.
Dialogue: 0,0:10:57.49,0:11:00.03,Default,,0,0,0,,Олар мұны шындап істегісі келеді ме?
Dialogue: 0,0:11:05.08,0:11:06.91,Default,,0,0,0,,Әке, көңілім қалды.
Dialogue: 0,0:11:07.04,0:11:10.04,Default,,0,0,0,,Мен қанша тырыссам да, бәрібір нәтиже бермеді.
Dialogue: 0,0:11:10.29,0:11:12.33,Default,,0,0,0,,Не? 4 ұпай?
Dialogue: 0,0:11:13.33,0:11:14.75,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,0:11:15.04,0:11:16.84,Default,,0,0,0,,Өсуге көп орын бар.
Dialogue: 0,0:11:17.42,0:11:19.97,Default,,0,0,0,,Мұны нөлден жасай алатын адамнан әлдеқайда жақсы
Dialogue: 0,0:11:20.42,0:11:21.72,Default,,0,0,0,,Сәлем Нариюки
Dialogue: 0,0:11:22.05,0:11:25.01,Default,,0,0,0,,Тек қазір сезінетін өкінішті ұмытпа.
Dialogue: 0,0:11:25.51,0:11:29.23,Default,,0,0,0,,Түсінетін, қолынан келмейтіндерді істей алатын адам бол.
Dialogue: 0,0:11:29.77,0:11:33.52,Default,,0,0,0,,Мұны істей алмау дегеннің не екенін түсінетін адамдар - мұны істей алмағандар.
Dialogue: 0,0:11:36.32,0:11:37.61,Default,,0,0,0,,Қарт
Dialogue: 0,0:11:39.82,0:11:41.49,Default,,0,0,0,,Ол дауыстап айтады.
Dialogue: 0,0:11:51.16,0:11:52.00,Default,,0,0,0,,Нашар
Dialogue: 0,0:11:52.50,0:11:53.83,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:11:53.96,0:11:54.79,Default,,0,0,0,,Не!
Dialogue: 0,0:11:55.58,0:11:57.21,Default,,0,0,0,,Уау~
Dialogue: 0,0:11:57.38,0:11:58.46,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:58.63,0:12:01.26,Default,,0,0,0,,Ұмытуға біздің де кінәміз бар.
Dialogue: 0,0:12:01.97,0:12:05.72,Default,,0,0,0,,Одан басқа шаруамыз болмаса, бізге керегі осы.
Dialogue: 0,0:12:06.26,0:12:08.35,Default,,0,0,0,,Жоқ, күте тұрыңыз! Тағы айтатын нәрсе бар
Dialogue: 0,0:12:08.60,0:12:11.85,Default,,0,0,0,,Менде ол жоқ, мен ешқандай көндіруді қабылдағым келмейді.
Dialogue: 0,0:12:12.06,0:12:14.35,Default,,0,0,0,,Ронин атансаңыз да, таңдау саласын өзгертпейсіз.
Dialogue: 0,0:12:14.73,0:12:15.86,Default,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:12:16.06,0:12:19.23,Default,,0,0,0,,Қанша рет ронин болып, бар күшіңізді салсаңыз да, бекер болуы мүмкін.
Dialogue: 0,0:12:20.11,0:12:21.57,Default,,0,0,0,,Сіз ұрыс таңдауға тырысып жатырсыз ба?
Dialogue: 0,0:12:23.95,0:12:26.28,Default,,0,0,0,,Иә, мүлде.
Dialogue: 0,0:12:27.53,0:12:28.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:29.16,0:12:30.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:30.95,0:12:34.37,Default,,0,0,0,,Әйтпесе, бұл еңбектің бәрі зая кетеді.
Dialogue: 0,0:12:34.87,0:12:35.71,Default,,0,0,0,,Дәптер ме?
Dialogue: 0,0:12:35.92,0:12:37.25,Default,,0,0,0,,Жерде не...
Dialogue: 0,0:12:38.25,0:12:39.09,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.63,0:12:47.89,Default,,0,0,0,,Бұл тұтас кітап...
Dialogue: 0,0:12:48.18,0:12:51.31,Default,,0,0,0,,Біз үшін жасалған кеңестер?
Dialogue: 0,0:12:51.43,0:12:53.48,Default,,0,0,0,,Кеше ұмытып кеткен сұрақтар дәптерін қараңыз.
Dialogue: 0,0:12:53.60,0:12:57.27,Default,,0,0,0,,Балалар, сендердің қай жерде сүрінетіндеріңді енді білемін.
Dialogue: 0,0:12:57.40,0:13:00.52,Default,,0,0,0,,Сонымен... бұл сіз мұны бір түнде жасай аласыз дегенді білдіре ме?
Dialogue: 0,0:13:00.73,0:13:01.61,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:13:02.07,0:13:04.20,Default,,0,0,0,,Мен мұны түсінбеймін, менде оны жақсы емес деп санаймын.
Dialogue: 0,0:13:04.32,0:13:05.61,Default,,0,0,0,,Мен мұны күшпен істесем де
Dialogue: 0,0:13:06.07,0:13:08.28,Default,,0,0,0,,Одан да түсіну қиын.
Dialogue: 0,0:13:08.41,0:13:09.37,Default,,0,0,0,,Қандай ашуландырарлық, бірақ жасырынған жер табуым керек
Dialogue: 0,0:13:10.16,0:13:13.41,Default,,0,0,0,,Мен бұрын сабақта өте нашар болдым, бұл мені күлдірді.
Dialogue: 0,0:13:13.95,0:13:16.75,Default,,0,0,0,,Қанша оқысам да, үлгерімім мүлде көтерілмейді.
Dialogue: 0,0:13:17.25,0:13:18.42,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:18.50,0:13:22.00,Default,,0,0,0,,Балалар, сендердің қолдарыңнан келмейтін ренішті түсінемін.
Dialogue: 0,0:13:22.88,0:13:24.22,Default,,0,0,0,,Қаншалықты дарынды болсаң да
Dialogue: 0,0:13:24.42,0:13:26.43,Default,,0,0,0,,Сіз шынымен істегіңіз келетін нәрсені жасай алмайсыз.
Dialogue: 0,0:13:26.55,0:13:28.47,Default,,0,0,0,,Мен бақыттымын деп айта алмаймын.
Dialogue: 0,0:13:29.18,0:13:30.10,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:13:30.93,0:13:33.60,Default,,0,0,0,,Мен сені бақытты етемін
Dialogue: 0,0:13:33.72,0:13:35.52,Default,,0,0,0,,Маған сеніп, менімен бірге бол!
Dialogue: 0,0:13:36.02,0:13:37.23,Default,,0,0,0,,Уф... (Фумино) Хаа!
Dialogue: 0,0:13:39.23,0:13:40.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.19,0:13:41.23,Default,,0,0,0,,Эх!
Dialogue: 0,0:13:41.36,0:13:43.73,Default,,0,0,0,,А... Бір уақытта екі адам махаббатын мойындап жатыр ма?
Dialogue: 0,0:13:44.15,0:13:45.28,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:13:45.40,0:13:48.03,Default,,0,0,0,,Мен сені соншалықты беймаза деп ойламаппын.
Dialogue: 0,0:13:48.36,0:13:50.12,Default,,0,0,0,,Иә! Чичи... Жоқ!
Dialogue: 0,0:13:50.24,0:13:52.91,Default,,0,0,0,,Таңдаған салаңды өзгертпе, бар күшімізді бірге жасайық.
Dialogue: 0,0:13:53.04,0:13:55.87,Default,,0,0,0,,Алдымен кітапханадағы негізгі мәліметтерден бастайық... хахаха
Dialogue: 0,0:13:56.00,0:13:57.37,Default,,0,0,0,,40 000! Хех, хех, хехехехе
Dialogue: 0,0:14:00.29,0:14:01.84,Default,,0,0,0,,Мм, бірақ...
Dialogue: 0,0:14:02.88,0:14:03.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:03.96,0:14:05.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:15.64,0:14:19.65,Default,,0,0,0,,Екеуің оқып жатқанда мен де үй тапсырмасын орындауым керек.
Dialogue: 0,0:14:20.52,0:14:23.07,Default,,0,0,0,,Мен оны арнайы VIP ұсынысына енгіземін.
Dialogue: 0,0:14:23.44,0:14:26.69,Default,,0,0,0,,Егер мен осында бағамды түсірсем, мен назар аудара алмаймын.
Dialogue: 0,0:14:27.11,0:14:27.95,Default,,0,0,0,,Уф
Dialogue: 0,0:14:29.45,0:14:31.12,Default,,0,0,0,,Уау! Фурухаши!
Dialogue: 0,0:14:31.24,0:14:33.66,Default,,0,0,0,,Ах! Кешіріңіз, Юйга-кун.
Dialogue: 0,0:14:33.78,0:14:36.16,Default,,0,0,0,,Математикалық формулаларды қарасам, ұйқым келеді.
Dialogue: 0,0:14:36.45,0:14:37.75,Default,,0,0,0,,О, о...\NОл
Dialogue: 0,0:14:37.87,0:14:40.17,Default,,0,0,0,,Уау, өте жақсы иіс шықты. Уау, өте жақсы иіс шықты.
Dialogue: 0,0:14:40.83,0:14:42.75,Default,,0,0,0,,Ой... Сабыр ет, Юига Нариюки.
Dialogue: 0,0:14:42.88,0:14:44.75,Default,,0,0,0,,Егер мен осы дәрежеде шатассам, не істеуім керек?
Dialogue: 0,0:14:45.25,0:14:46.51,Default,,0,0,0,,Юига-сан (Нариюки) Иә?
Dialogue: 0,0:14:47.01,0:14:47.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:48.09,0:14:50.51,Default,,0,0,0,,Мен бұл сұрақтың мағынасын түсінбеймін.
Dialogue: 0,0:14:50.63,0:14:53.10,Default,,0,0,0,,О? Қайда... қайда? Огата
Dialogue: 0,0:14:53.35,0:14:55.14,Default,,0,0,0,,Сондықтан бұл сұрақ 2...
Dialogue: 0,0:14:55.97,0:14:57.02,Default,,0,0,0,,О!
Dialogue: 0,0:14:57.14,0:14:58.81,Default,,0,0,0,,Шектеулі мүшенің мағынасы бірдей сөйлем болуы керек.
Dialogue: 0,0:14:58.93,0:15:01.31,Default,,0,0,0,,Менің ойымша, бұл «Келесі опциялардың ішінен таңдаңыз!» дегенді білдіреді.
Dialogue: 0,0:15:01.60,0:15:03.61,Default,,0,0,0,,Мен оны дәл қазір алдым! Мен оны дәл қазір алдым!
Dialogue: 0,0:15:04.44,0:15:05.44,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:15:05.57,0:15:08.53,Default,,0,0,0,,Юйга-кун, сәл бозарған сияқтысың, жақсысың ба?
Dialogue: 0,0:15:08.65,0:15:09.95,Default,,0,0,0,,Иә... шынымен бе?
Dialogue: 0,0:15:10.78,0:15:11.82,Default,,0,0,0,,Бұл да қызба емес пе?
Dialogue: 0,0:15:12.03,0:15:12.95,Default,,0,0,0,,Жабу Жабу Жабу!
Dialogue: 0,0:15:13.87,0:15:15.83,Default,,0,0,0,,Бұл, әрине, біртүрлі болып көрінеді.
Dialogue: 0,0:15:16.16,0:15:17.66,Default,,0,0,0,,Сондықтан да жақын!
Dialogue: 0,0:15:21.17,0:15:22.96,Default,,0,0,0,,Бұл халық тәрбиешілері
Dialogue: 0,0:15:23.13,0:15:26.34,Default,,0,0,0,,Психикалық кедергілер мен күткеннен де жоғары...
Dialogue: 0,0:15:26.71,0:15:29.05,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:15:33.80,0:15:35.97,Default,,0,0,0,,Кешіріңіз. Алдымен кешіріңізші.
Dialogue: 0,0:15:36.26,0:15:39.10,Default,,0,0,0,,Ах, Рикчан, бүгін дүкенде көмектесетін күн бе?
Dialogue: 0,0:15:39.35,0:15:40.14,Default,,0,0,0,,(Питбуль) Э? (Доберман) Э?
Dialogue: 0,0:15:40.39,0:15:43.02,Default,,0,0,0,,Риччанның үйі - удон мейрамханасы.
Dialogue: 0,0:15:43.52,0:15:44.36,Default,,0,0,0,,О
Dialogue: 0,0:15:46.23,0:15:47.61,Default,,0,0,0,,Дұрыс, мен
Dialogue: 0,0:15:47.73,0:15:50.28,Default,,0,0,0,,Тек бұл жігіттер қандай да бір жағынан данышпан.
Dialogue: 0,0:15:50.40,0:15:51.82,Default,,0,0,0,,Мен мүлде білмеймін
Dialogue: 0,0:15:56.03,0:15:58.20,Default,,0,0,0,,Сен менімен ұзақ тұрсаң да.
Dialogue: 0,0:15:58.41,0:16:00.75,Default,,0,0,0,,Кешіріңіз, мен бүгін жәндіктен артық емеспін.
Dialogue: 0,0:16:00.87,0:16:02.08,Default,,0,0,0,,Ой, жай ғана оларды атаңның бөлмесіне қайта қой.
Dialogue: 0,0:16:02.33,0:16:05.33,Default,,0,0,0,,Басынан бастап жасай алғанша, өсу үшін көп орын болғаны жақсы.
Dialogue: 0,0:16:05.46,0:16:06.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:06.75,0:16:08.84,Default,,0,0,0,,Бұл қарттың саудасы.
Dialogue: 0,0:16:09.38,0:16:12.17,Default,,0,0,0,,Дұрыс! Юига-кун жақсы сөздер айтады!
Dialogue: 0,0:16:12.30,0:16:13.51,Default,,0,0,0,,Тез қалпына келтіріңіз!
Dialogue: 0,0:16:14.13,0:16:16.05,Default,,0,0,0,,Жарайды, мен бар күшімді саламын!
Dialogue: 0,0:16:16.18,0:16:17.26,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:21.06,0:16:21.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.61,0:16:31.74,Default,,0,0,0,,Не болды? ескі көпір
Dialogue: 0,0:16:32.11,0:16:35.32,Default,,0,0,0,,А, жоқ, кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:16:35.57,0:16:36.78,Default,,0,0,0,,О, о...\NОл
Dialogue: 0,0:16:41.37,0:16:42.41,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:16:42.71,0:16:44.75,Default,,0,0,0,,Сізге жұлдыздар ұнайды ма?
Dialogue: 0,0:16:45.42,0:16:47.46,Default,,0,0,0,,Эхехе Шынында...
Dialogue: 0,0:16:51.30,0:16:55.30,Default,,0,0,0,,Мен кішкентай кезімнен жұлдыздарды жақсы көремін.
Dialogue: 0,0:16:55.97,0:16:57.51,Default,,0,0,0,,Жұлдыздар көрікті түнде
Dialogue: 0,0:16:57.64,0:17:01.56,Default,,0,0,0,,Қайтыс болған анамның жұлдызын таппасқа амалым жоқ, солай ма?
Dialogue: 0,0:17:07.81,0:17:08.94,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:17:09.06,0:17:11.69,Default,,0,0,0,,Мен ақымақтық айтып тұрғандай болдым.
Dialogue: 0,0:17:12.65,0:17:16.20,Default,,0,0,0,,Бірақ арман осыдан басталды.
Dialogue: 0,0:17:16.32,0:17:17.32,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:17:18.20,0:17:21.04,Default,,0,0,0,,Мен жұлдыздармен байланысты өмір сүргім келеді
Dialogue: 0,0:17:21.41,0:17:25.21,Default,,0,0,0,,Ол үшін жаратылыстану пәнінен емтихан тапсыру керек, солай ма?
Dialogue: 0,0:17:26.46,0:17:27.29,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:27.67,0:17:30.42,Default,,0,0,0,,Мен немен айналыспасам да, оны жеңе аламын.
Dialogue: 0,0:17:30.54,0:17:33.26,Default,,0,0,0,,Астрономияны шындап үйреніңіз
Dialogue: 0,0:17:35.09,0:17:37.97,Default,,0,0,0,,Анамның жұлдызын таба аламын деп үміттенемін
Dialogue: 0,0:17:40.01,0:17:43.14,Default,,0,0,0,,Біртүрлі екен. Ұмыт оны, ұмыт!
Dialogue: 0,0:17:43.27,0:17:46.06,Default,,0,0,0,,Қазір мен жоғары сынып оқушысы болсам, сол бала сияқтымын...
Dialogue: 0,0:17:46.19,0:17:47.27,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:48.77,0:17:52.44,Default,,0,0,0,,Негізі, мен осыған ұқсас нәрсені біраз бұрын ойладым.
Dialogue: 0,0:17:53.03,0:17:54.23,Default,,0,0,0,,Ой, жай ғана оларды атаңның бөлмесіне қайта қой.
Dialogue: 0,0:17:54.36,0:17:58.91,Default,,0,0,0,,Мен саған күшімді беремін, сонда сен ғылыммен айналысасың.
Dialogue: 0,0:18:00.12,0:18:01.24,Default,,0,0,0,,Юига-кун
Dialogue: 0,0:18:05.50,0:18:07.54,Default,,0,0,0,,Сөзіңді дәл қазір қабылдадым.
Dialogue: 0,0:18:08.04,0:18:08.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:13.34,0:18:14.55,Default,,0,0,0,,Бұл таң қалдырды.
Dialogue: 0,0:18:15.17,0:18:18.05,Default,,0,0,0,,Мен Фурухашидің не істегісі келетінін соншалықты анық түсінетінін ешқашан ойламадым.
Dialogue: 0,0:18:19.18,0:18:22.14,Default,,0,0,0,,Мүмкін Огатада да осындай нәрсе бар шығар?
Dialogue: 0,0:18:22.43,0:18:23.26,Default,,0,0,0,,Бұл Огата ма?
Dialogue: 0,0:18:25.10,0:18:26.10,Default,,0,0,0,,Юига-сан
Dialogue: 0,0:18:26.60,0:18:30.27,Default,,0,0,0,,Сіз не істеп жатырсыз? Осы уақытта саябақта
Dialogue: 0,0:18:30.73,0:18:32.69,Default,,0,0,0,,Жеткізу сапарынан оралған соң ғана дем алу.
Dialogue: 0,0:18:32.98,0:18:33.82,Default,,0,0,0,,Жеткізу?
Dialogue: 0,0:18:34.32,0:18:36.49,Default,,0,0,0,,Қарасам, бұл удон мейрамханасы еді.
Dialogue: 0,0:18:37.19,0:18:38.78,Default,,0,0,0,,Демалу үшін не істейсіз?
Dialogue: 0,0:18:39.95,0:18:42.53,Default,,0,0,0,,2-10 ойыншыға арналған карта ойындары...
Dialogue: 0,0:18:43.62,0:18:44.45,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:18:44.62,0:18:45.70,Default,,0,0,0,,Мен сондай жалғызбын!
Dialogue: 0,0:18:46.54,0:18:50.08,Default,,0,0,0,,Негізі аналогтық ойындар ұнайды.
Dialogue: 0,0:18:50.21,0:18:52.50,Default,,0,0,0,,Менің айналамда ойнайтын адамдар көп емес.
Dialogue: 0,0:18:53.04,0:18:56.42,Default,,0,0,0,,Мен түсінбеймін, бірақ екі адам жасай алады, солай ма?
Dialogue: 0,0:18:56.76,0:18:57.97,Default,,0,0,0,,Ережені айт.
Dialogue: 0,0:18:58.42,0:19:01.39,Default,,0,0,0,,Юйга-сан, сен мені жеңуді жоспарлап отырсың ба?
Dialogue: 0,0:19:01.64,0:19:03.97,Default,,0,0,0,,Қандай сенімді мәлімдеме!
Dialogue: 0,0:19:04.72,0:19:07.68,Default,,0,0,0,,Бұл жігіт қиын шайқасқа мәжбүр болатын сияқты.
Dialogue: 0,0:19:09.39,0:19:10.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:11.44,0:19:13.15,Default,,0,0,0,,20 матчта жеңіске жетті
Dialogue: 0,0:19:13.98,0:19:16.86,Default,,0,0,0,,Огата: Мүмкін сіз...
Dialogue: 0,0:19:17.23,0:19:18.36,Default,,0,0,0,,Өте әлсіз?
Dialogue: 0,0:19:18.57,0:19:19.57,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:20.15,0:19:21.74,Default,,0,0,0,,Иә, өте көп
Dialogue: 0,0:19:21.95,0:19:26.16,Default,,0,0,0,,Сол себепті мен бұрын айттым: «Мені ұрып-соғуды жоспарлап жүрсіз бе?
Dialogue: 0,0:19:26.45,0:19:27.58,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:19:29.96,0:19:35.04,Default,,0,0,0,,Мен тек ықтималдық немесе есептеу арқылы жауап таба алмаған сияқтымын.
Dialogue: 0,0:19:35.71,0:19:37.00,Default,,0,0,0,,Жарыс ойындары және т.б.
Dialogue: 0,0:19:37.13,0:19:40.13,Default,,0,0,0,,Ол адамдардың эмоциясын қамтитын нәрселерден қиналған сияқты.
Dialogue: 0,0:19:41.18,0:19:43.30,Default,,0,0,0,,Сондықтан мен оны жақсырақ түсінгім келеді.
Dialogue: 0,0:19:44.22,0:19:46.39,Default,,0,0,0,,Осы мақсатта мен гуманитарлық пәндер бойынша емтихан тапсырдым.
Dialogue: 0,0:19:46.47,0:19:48.43,Default,,0,0,0,,Мен психологияны оқығым келеді
Dialogue: 0,0:19:49.14,0:19:52.39,Default,,0,0,0,,Менің ойымша, сіз бірдеңе жасағыңыз келеді.
Dialogue: 0,0:19:53.10,0:19:55.06,Default,,0,0,0,,Өзіңіз қалаған нәрсені жасаңыз.
Dialogue: 0,0:19:55.23,0:19:58.73,Default,,0,0,0,,Түнде саябақта жалғыз қалма.
Dialogue: 0,0:19:59.15,0:20:01.70,Default,,0,0,0,,Егер сізге осылай үзіліс керек болса, мен сізге әрқашан еріп жүремін.
Dialogue: 0,0:20:01.99,0:20:02.78,Default,,0,0,0,,Кез келген уақытта?
Dialogue: 0,0:20:03.11,0:20:05.95,Default,,0,0,0,,Жоқ... «Әрқашан» сөз ойыны.
Dialogue: 0,0:20:06.07,0:20:07.28,Default,,0,0,0,,Жоқ (Нариюки) А?
Dialogue: 0,0:20:07.91,0:20:10.62,Default,,0,0,0,,Егер сіз мұны анда-санда орындасаңыз, мен қуаныштымын.
Dialogue: 0,0:20:10.75,0:20:12.37,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:20:12.79,0:20:14.21,Default,,0,0,0,,О, о...\NОл
Dialogue: 0,0:20:14.33,0:20:15.92,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:20:29.10,0:20:30.06,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:20:30.47,0:20:31.77,Default,,0,0,0,,Қош келдіңіз, аға~
Dialogue: 0,0:20:32.23,0:20:34.81,Default,,0,0,0,,Мен бүгін көп жеуге жарамды шөп таптым.
Dialogue: 0,0:20:35.10,0:20:37.19,Default,,0,0,0,,Ей, бұл жетістік.
Dialogue: 0,0:20:37.81,0:20:38.94,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:20:40.32,0:20:42.03,Default,,0,0,0,,Бүгін кешіктің.
Dialogue: 0,0:20:42.74,0:20:44.66,Default,,0,0,0,,Кешкі ас жақын арада дайын болады.
Dialogue: 0,0:20:45.28,0:20:47.41,Default,,0,0,0,,Інім бөтен әйелдің иісі.
Dialogue: 0,0:20:47.53,0:20:48.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.83,0:20:51.66,Default,,0,0,0,,(Каэбуки) Кучида мен Киришима—
Dialogue: 0,0:20:52.08,0:20:53.41,Default,,0,0,0,,Міне! Және...
Dialogue: 0,0:20:53.54,0:20:54.37,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:20:55.67,0:20:57.13,Default,,0,0,0,,Сіз не айттыңыз, Мизуки?
Dialogue: 0,0:20:57.38,0:20:58.59,Default,,0,0,0,,Уф
Dialogue: 0,0:20:59.00,0:21:01.63,Default,,0,0,0,,Әпке, сіз бұрынғыдай әлі де жанкүйерсіз.
Dialogue: 0,0:21:01.76,0:21:02.76,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:21:07.09,0:21:08.72,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:08.97,0:21:10.18,Default,,0,0,0,,Егер ол адам болса, мені кісі өлтіру айыбымен айыптайтын еді—
Dialogue: 0,0:21:10.64,0:21:12.18,Default,,0,0,0,,Юйга-сан, сен осындасың ба?
Dialogue: 0,0:21:12.98,0:21:14.77,Default,,0,0,0,,Әдеби ұйықтап жатқан ханшайыммен
Dialogue: 0,0:21:15.23,0:21:17.06,Default,,0,0,0,,Ғылымның бас бармақ ханшайымы?
Dialogue: 0,0:21:18.02,0:21:19.31,Default,,0,0,0,,Иә? Сізге бірдеңе керек пе?
Dialogue: 0,0:21:19.44,0:21:20.27,Default,,0,0,0,,Иә
Dialogue: 0,0:21:20.86,0:21:21.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:24.15,0:21:26.32,Default,,0,0,0,,Ым... Юйга-кун
Dialogue: 0,0:21:32.33,0:21:35.08,Default,,0,0,0,,Мен кеше болған оқиғадан біраз ыңғайсызданып тұрмын.
Dialogue: 0,0:21:35.71,0:21:38.92,Default,,0,0,0,,Мектепте мұны ешкім жасамайды.
Dialogue: 0,0:21:39.29,0:21:40.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:41.71,0:21:43.71,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:48.34,0:21:54.35,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:11.01,0:23:17.02,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:26.27,0:23:28.94,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:23:36.54,0:23:40.16,Default,,0,0,0,,Келесі жолы «Балық жүрегің болса
Dialogue: 0,0:23:41.66,0:23:47.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory