Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.36,0:00:32.24,Default,,0,0,0,,(Фуюкидің ауыр тыныс алуы)
Dialogue: 0,0:00:36.16,0:00:37.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:37.70,0:00:38.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:42.75,0:00:43.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:46.37,0:00:48.17,Default,,0,0,0,,Әй, бәрі...
Dialogue: 0,0:00:48.25,0:00:50.55,Default,,0,0,0,,Қалайша...
Dialogue: 0,0:00:51.05,0:00:51.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:52.30,0:00:55.26,Default,,0,0,0,,Сержант: Бұл қиын, Жироро және басқалары...
Dialogue: 0,0:00:55.34,0:00:55.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:57.55,0:00:58.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:59.18,0:01:00.14,Default,,0,0,0,,Сержант!
Dialogue: 0,0:01:02.89,0:01:03.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:05.23,0:01:10.02,Default,,0,0,0,,Вахахахаха...
Dialogue: 0,0:01:17.74,0:01:18.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:24.33,0:01:27.46,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:01:28.71,0:01:31.34,Default,,0,0,0,,Бұл арман болды ма? Жақсы... хаха
Dialogue: 0,0:01:31.42,0:01:34.42,Default,,0,0,0,,Қанша тырыссаң да, аспаннан моайдың түсуіне жол жоқ...
Dialogue: 0,0:01:34.51,0:01:35.76,Default,,0,0,0,,О!
Dialogue: 0,0:01:36.26,0:01:38.59,Default,,0,0,0,,Ата... Не? Не...
Dialogue: 0,0:01:39.09,0:01:41.18,Default,,0,0,0,,Ах... Ариса-чан!
Dialogue: 0,0:01:41.26,0:01:42.81,Default,,0,0,0,,Алиса Оңтүстік Кросс-чан
Dialogue: 0,0:01:42.89,0:01:44.52,Default,,0,0,0,,Құбыжықтармен күресетін жұмбақ қыз
Dialogue: 0,0:01:44.60,0:01:47.19,Default,,0,0,0,,Фуюки-кунның сәл ерекше досы.
Dialogue: 0,0:01:47.69,0:01:48.35,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:01:48.44,0:01:49.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:49.52,0:01:51.52,Default,,0,0,0,,Себебі маған Фуюки ұнайды.
Dialogue: 0,0:01:51.61,0:01:55.19,Default,,0,0,0,,Мына тас мүсін ше? Сержантқа ұқсайды.
Dialogue: 0,0:01:55.69,0:01:56.90,Default,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,0:01:56.99,0:01:59.86,Default,,0,0,0,,Тынық мұхитының бұрышындағы шағын арал
Dialogue: 0,0:02:00.70,0:02:02.33,Default,,0,0,0,,Бұл Рапа Нуи деген жер.
Dialogue: 0,0:02:02.41,0:02:03.24,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:02:03.74,0:02:05.33,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:02:06.83,0:02:08.04,Default,,0,0,0,,Ариса-чан!
Dialogue: 0,0:02:10.58,0:02:11.92,Default,,0,0,0,,Рапа Нуи...
Dialogue: 0,0:02:12.96,0:02:13.67,Default,,0,0,0,,А...
Dialogue: 0,0:02:14.38,0:02:16.71,Default,,0,0,0,,Сіз Пасха аралы туралы айтып отырсыз ба?
Dialogue: 0,0:02:17.34,0:02:21.72,Default,,0,0,0,,Ал... Бұл... моай ма?
Dialogue: 0,0:02:22.35,0:02:23.85,Default,,0,0,0,,Фу... Юки...
Dialogue: 0,0:02:23.93,0:02:24.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:25.56,0:02:27.10,Default,,0,0,0,,Фуюки-доно…
Dialogue: 0,0:02:27.93,0:02:29.10,Default,,0,0,0,,Сержант?
Dialogue: 0,0:02:38.28,0:02:39.65,Default,,0,0,0,,(айқай)
Dialogue: 0,0:02:42.07,0:02:42.82,Default,,0,0,0,,Уау...
Dialogue: 0,0:02:42.91,0:02:44.49,Default,,0,0,0,,(Нацумидің айқайы)
Dialogue: 0,0:02:44.58,0:02:46.62,Default,,0,0,0,,Жер сілкінісі, өрт! Тыныштал, Фуюки!
Dialogue: 0,0:02:46.70,0:02:48.41,Default,,0,0,0,,Сабыр ет, асығып, жасырын!
Dialogue: 0,0:02:48.50,0:02:50.71,Default,,0,0,0,,Әпке, сабыр етіңіз!
Dialogue: 0,0:02:50.79,0:02:52.13,Default,,0,0,0,,Ой... Мен сабырлымын.
Dialogue: 0,0:02:52.21,0:02:53.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:53.92,0:02:55.88,Default,,0,0,0,,Бұл... енді ше?
Dialogue: 0,0:02:56.55,0:02:57.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:58.38,0:02:59.42,Default,,0,0,0,,-Арх! - Гебо!
Dialogue: 0,0:02:59.51,0:03:01.38,Default,,0,0,0,,- Шок! - Құсу!
Dialogue: 0,0:03:01.47,0:03:03.93,Default,,0,0,0,,(Батып бара жатқан адамдардың дауысы)
Dialogue: 0,0:03:04.01,0:03:06.43,Default,,0,0,0,,Ойық... құсу!
Dialogue: 0,0:03:07.81,0:03:09.64,Default,,0,0,0,,Ол сержант Кероро
Dialogue: 0,0:03:09.73,0:03:12.73,Default,,0,0,0,,Мұнда Хюга отбасында тұрып, Жерге басып кіруді жоспарлайды.
Dialogue: 0,0:03:12.81,0:03:14.27,Default,,0,0,0,,Қорқынышты бөгде адам
Dialogue: 0,0:03:15.69,0:03:16.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.82,0:03:18.03,Default,,0,0,0,,(Өтіп бара жатқандардың айқайы)
Dialogue: 0,0:03:19.36,0:03:21.78,Default,,0,0,0,,Сәлем! Қазірдің өзінде не болып жатыр?
Dialogue: 0,0:03:21.86,0:03:24.28,Default,,0,0,0,,Ас қорыту су жүйесі бақылаудан шықты!
Dialogue: 0,0:03:24.78,0:03:25.45,Default,,0,0,0,,Жылдам әңгіме
Dialogue: 0,0:03:25.53,0:03:26.70,Default,,0,0,0,,Гунтанк
Dialogue: 0,0:03:27.37,0:03:29.00,Default,,0,0,0,,(Нацуми жылайды)
Dialogue: 0,0:03:29.08,0:03:30.96,Default,,0,0,0,,Жаңа басқыншылық қаруларды жасау кезінде
Dialogue: 0,0:03:31.04,0:03:32.75,Default,,0,0,0,,Жарылыс жалыны
Dialogue: 0,0:03:32.83,0:03:34.54,Default,,0,0,0,,Маған қол тигізбе деді.
Dialogue: 0,0:03:34.63,0:03:36.46,Default,,0,0,0,,Әлгі ақымақ мидори~
Dialogue: 0,0:03:36.54,0:03:37.17,Default,,0,0,0,,Кез келген адам
Dialogue: 0,0:03:37.25,0:03:39.92,Default,,0,0,0,,Кейде біз бейқамдық жасаймыз.
Dialogue: 0,0:03:40.01,0:03:42.63,Default,,0,0,0,,Өтірікші! Мен жай ғана тез қозғалғым келді.
Dialogue: 0,0:03:42.72,0:03:45.09,Default,,0,0,0,,Маңызды емес, оны тоқтатыңыз.
Dialogue: 0,0:03:45.18,0:03:46.64,Default,,0,0,0,,Бұлыңғыр бақа!
Dialogue: 0,0:03:47.26,0:03:49.64,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:49.72,0:03:51.85,Default,,0,0,0,,(балғаның соғу дыбысы)
Dialogue: 0,0:03:51.94,0:03:54.27,Default,,0,0,0,,Бүгін істерді қалпына келтіріңіз!
Dialogue: 0,0:03:54.35,0:03:55.90,Default,,0,0,0,,Иә
Dialogue: 0,0:03:57.40,0:03:59.90,Default,,0,0,0,,Гунтанк кінәлі емес.
Dialogue: 0,0:03:59.98,0:04:02.82,Default,,0,0,0,,Қабілеттері жетіспейтін бір-біріне көмектесу жоспары жетіспеді.
Dialogue: 0,0:04:02.90,0:04:04.57,Default,,0,0,0,,Бұл менің қателігім болды.
Dialogue: 0,0:04:04.66,0:04:06.12,Default,,0,0,0,,Қараңызшы! Тиімдірек болыңыз!
Dialogue: 0,0:04:06.20,0:04:06.99,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:08.28,0:04:10.12,Default,,0,0,0,,О, бұл сержант еді!
Dialogue: 0,0:04:10.20,0:04:12.16,Default,,0,0,0,,О ~ Фуюки-доно
Dialogue: 0,0:04:12.25,0:04:14.54,Default,,0,0,0,,Мен кірді жууға тура келді.
Dialogue: 0,0:04:14.62,0:04:16.38,Default,,0,0,0,,Мен қайтпаспын
Dialogue: 0,0:04:16.46,0:04:18.46,Default,,0,0,0,,Мен ойлағаннан да қиын сияқты.
Dialogue: 0,0:04:18.54,0:04:19.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:19.59,0:04:22.01,Default,,0,0,0,,Біраз уақытқа басқыншылық әрекеттерді жүзеге асыру мүмкін емес сияқты.
Dialogue: 0,0:04:22.80,0:04:26.05,Default,,0,0,0,,Негізгі функциялар қашан қалпына келтіріледі...
Dialogue: 0,0:04:26.14,0:04:27.89,Default,,0,0,0,,Бұл аянышты оқиға.
Dialogue: 0,0:04:27.97,0:04:29.14,Default,,0,0,0,,сержант.
Dialogue: 0,0:04:29.22,0:04:31.06,Default,,0,0,0,,Бос емеспін
Dialogue: 0,0:04:31.14,0:04:32.56,Default,,0,0,0,,Осыны қарап шыға аласыз ба?
Dialogue: 0,0:04:32.64,0:04:34.52,Default,,0,0,0,,Құсу? Не?
Dialogue: 0,0:04:35.06,0:04:36.23,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:04:36.73,0:04:39.82,Default,,0,0,0,,Қарапайым, бірақ талғампаз дизайн
Dialogue: 0,0:04:39.90,0:04:41.86,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:04:41.94,0:04:44.03,Default,,0,0,0,,Менің ойымша, бұл моаи шығар.
Dialogue: 0,0:04:44.11,0:04:44.99,Default,,0,0,0,,«Моаи»?
Dialogue: 0,0:04:45.07,0:04:47.37,Default,,0,0,0,,Сіз Лорд Моаның туысысыз ба немесе басқа нәрсе ме?
Dialogue: 0,0:04:47.45,0:04:48.37,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:48.45,0:04:51.83,Default,,0,0,0,,Бұл Пасха аралында баяғыда салынған жұмбақ тас мүсін.
Dialogue: 0,0:04:51.91,0:04:54.33,Default,,0,0,0,,О, Пасха аралы?
Dialogue: 0,0:04:55.58,0:04:56.46,Default,,0,0,0,,Пасха аралы
Dialogue: 0,0:04:56.54,0:04:58.25,Default,,0,0,0,,Халқы: 4000-нан астам адам
Dialogue: 0,0:04:58.75,0:05:00.63,Default,,0,0,0,,Тынық мұхитында Чили аумағында орналасқан —
Dialogue: 0,0:05:00.71,0:05:05.05,Default,,0,0,0,,Шеңбері шамамен 60 км, субтропиктік климаты бар шағын арал.
Dialogue: 0,0:05:06.72,0:05:07.43,Default,,0,0,0,,Ариса-чан
Dialogue: 0,0:05:07.51,0:05:10.26,Default,,0,0,0,,Ол оны Пасха аралынан әкелгенін айтты.
Dialogue: 0,0:05:10.35,0:05:13.68,Default,,0,0,0,,Бірақ мен мұндай моайды көрген де, естіген де емеспін.
Dialogue: 0,0:05:13.77,0:05:15.10,Default,,0,0,0,,Құсу…
Dialogue: 0,0:05:15.18,0:05:18.02,Default,,0,0,0,,Басқаша айтқанда, сіз мұны растағыңыз келеді.
Dialogue: 0,0:05:18.10,0:05:19.23,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.31,0:05:22.32,Default,,0,0,0,,Егер ол шынайы болса, мен оны бастапқы орнына қайтарғым келеді.
Dialogue: 0,0:05:22.40,0:05:23.40,Default,,0,0,0,,-Хохо! - (Фуюки) А?
Dialogue: 0,0:05:23.48,0:05:27.70,Default,,0,0,0,,Көк аспан, көк теңіз! Ал домалап жатқан дала!
Dialogue: 0,0:05:27.78,0:05:29.07,Default,,0,0,0,,Пасха аралы
Dialogue: 0,0:05:29.16,0:05:31.37,Default,,0,0,0,,Қандай керемет арал!
Dialogue: 0,0:05:31.87,0:05:33.79,Default,,0,0,0,,Джеро Джероли Маған ұнады.
Dialogue: 0,0:05:34.29,0:05:38.46,Default,,0,0,0,,Мұндай өзгертулер, осындай өзгертулер...
Dialogue: 0,0:05:43.17,0:05:45.17,Default,,0,0,0,,Джеро Джеро Джеро Джеро Джеро!
Dialogue: 0,0:05:45.26,0:05:46.30,Default,,0,0,0,,Шын мәнінде, қазірдің өзінде
Dialogue: 0,0:05:46.38,0:05:49.22,Default,,0,0,0,,Біз екінші құпия базаны дайындадық.
Dialogue: 0,0:05:50.47,0:05:52.85,Default,,0,0,0,,Сержанттың амбициясы кенет күшейе түсті.
Dialogue: 0,0:05:52.93,0:05:54.31,Default,,0,0,0,,Сержант, не болды?
Dialogue: 0,0:05:54.39,0:05:55.02,Default,,0,0,0,,Құсу!
Dialogue: 0,0:05:55.52,0:05:57.85,Default,,0,0,0,,Фуюки-доно, мен шештім.
Dialogue: 0,0:05:57.94,0:05:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.52,0:06:01.90,Default,,0,0,0,,Мен Фуюки-дономен Пасха аралына барамын!
Dialogue: 0,0:06:01.98,0:06:02.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.19,0:06:04.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.90,0:06:06.19,Default,,0,0,0,,(иттің ұлыуы)
Dialogue: 0,0:06:06.28,0:06:07.57,Default,,0,0,0,,(Мотоцикл қозғалтқышының дыбысы)
Dialogue: 0,0:06:09.82,0:06:10.45,Default,,0,0,0,,(Құлыптың жабылу дыбысы)
Dialogue: 0,0:06:10.53,0:06:11.95,Default,,0,0,0,,Сержант, күткеніңізге рахмет!
Dialogue: 0,0:06:12.03,0:06:15.87,Default,,0,0,0,,Фуюки-доно, сен дайынсың ба?
Dialogue: 0,0:06:15.95,0:06:17.87,Default,,0,0,0,,Айтпақшы, Мама-доно мен Нацуми-доно...
Dialogue: 0,0:06:17.96,0:06:19.17,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:06:19.25,0:06:21.00,Default,,0,0,0,,Жарайды, онда мен отырдым, отырдым!
Dialogue: 0,0:06:21.50,0:06:22.59,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:23.54,0:06:24.59,Default,,0,0,0,,Сонымен, Мор.
Dialogue: 0,0:06:24.67,0:06:27.13,Default,,0,0,0,,Мұны мүшелерден құпия сақтаңыз.
Dialogue: 0,0:06:27.22,0:06:29.34,Default,,0,0,0,,Түсіндім, ағай.
Dialogue: 0,0:06:29.43,0:06:31.64,Default,,0,0,0,,Сіз мені кейін таң қалдырғыңыз келеді, солай ма?
Dialogue: 0,0:06:31.72,0:06:33.43,Default,,0,0,0,,Бұл қатаң құпия ма?
Dialogue: 0,0:06:33.51,0:06:35.06,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,0:06:35.14,0:06:36.35,Default,,0,0,0,,Пасха аралына!
Dialogue: 0,0:06:36.43,0:06:38.31,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:06:39.31,0:06:40.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:40.56,0:06:41.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:48.78,0:06:51.07,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:06:51.91,0:06:53.12,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:06:53.20,0:06:56.66,Default,,0,0,0,,Иә... Мама, қашан айттыңыз?
Dialogue: 0,0:06:56.74,0:06:57.33,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:06:58.00,0:06:59.37,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:06:59.46,0:07:01.96,Default,,0,0,0,,Бұл күндіз-түні жұмыс істеудің қиын бөлігі.
Dialogue: 0,0:07:02.04,0:07:04.46,Default,,0,0,0,,Ым, ол ашуланған шығар...
Dialogue: 0,0:07:04.54,0:07:07.51,Default,,0,0,0,,Жоқ, мүлде емес, хехехе
Dialogue: 0,0:07:07.59,0:07:08.46,Default,,0,0,0,,Тіпті сол бала
Dialogue: 0,0:07:08.55,0:07:10.80,Default,,0,0,0,,Кейде ата-анама айтпай үйден қашып кеткім келеді.
Dialogue: 0,0:07:10.88,0:07:12.09,Default,,0,0,0,,Мен оның бар екеніне сене алмаймын.
Dialogue: 0,0:07:12.18,0:07:12.93,Default,,0,0,0,,Сәл таң қалды
Dialogue: 0,0:07:15.01,0:07:17.89,Default,,0,0,0,,Керо-чан, Фуюкиге қамқор бол.
Dialogue: 0,0:07:18.60,0:07:20.60,Default,,0,0,0,,♪～
Dialogue: 0,0:08:47.52,0:08:49.52,Default,,0,0,0,,～♪
Dialogue: 0,0:08:49.61,0:08:51.61,Default,,0,0,0,,(Мотоцикл қозғалтқышының дыбысы)
Dialogue: 0,0:08:56.16,0:08:58.45,Default,,0,0,0,,Енді біз экватордан өттік.
Dialogue: 0,0:08:58.53,0:09:00.41,Default,,0,0,0,,Ақырында, Пасха аралы?
Dialogue: 0,0:09:00.49,0:09:02.25,Default,,0,0,0,,Дегенмен, Фуюки-доно
Dialogue: 0,0:09:02.33,0:09:04.75,Default,,0,0,0,,Сізге Пасха аралы неге сонша ұнайды?
Dialogue: 0,0:09:04.83,0:09:08.46,Default,,0,0,0,,Не? Дұрыс...неге?
Dialogue: 0,0:09:09.34,0:09:11.80,Default,,0,0,0,,Әкемнің бөлмесінде ілінген күнтізбенің суреті
Dialogue: 0,0:09:12.30,0:09:13.80,Default,,0,0,0,,Алыс, алыс теңіздің арғы жағында
Dialogue: 0,0:09:14.30,0:09:16.05,Default,,0,0,0,,Мен тұратын жер бетінде
Dialogue: 0,0:09:16.13,0:09:18.30,Default,,0,0,0,,Мұнда көптеген таңғажайып нәрселер бар.
Dialogue: 0,0:09:18.80,0:09:20.64,Default,,0,0,0,,Мүмкін сонда.
Dialogue: 0,0:09:20.72,0:09:22.85,Default,,0,0,0,,Мен оккультизмге қызыға бастадым.
Dialogue: 0,0:09:22.93,0:09:24.43,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:24.52,0:09:26.98,Default,,0,0,0,,Бұл шынымен де тағдырлы кездесу болды.
Dialogue: 0,0:09:27.06,0:09:28.23,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:09:28.31,0:09:30.23,Default,,0,0,0,,Мен де бірінші рет.
Dialogue: 0,0:09:30.31,0:09:34.86,Default,,0,0,0,,«1/144-ші Char's Zaku» кездескен кезде қандай әсер алдыңыз?
Dialogue: 0,0:09:34.94,0:09:37.07,Default,,0,0,0,,Мен оны әлі ұмыта алмаймын.
Dialogue: 0,0:09:37.15,0:09:39.78,Default,,0,0,0,,Хаха, дәл солай.
Dialogue: 0,0:09:40.41,0:09:41.41,Default,,0,0,0,,Рахмет, сержант.
Dialogue: 0,0:09:42.08,0:09:43.12,Default,,0,0,0,,Бұл әрқашан арман болды
Dialogue: 0,0:09:43.20,0:09:43.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Сержанттың арқасында мен бара аламын.
Dialogue: 0,0:09:47.08,0:09:50.84,Default,,0,0,0,,Армандар міндетті түрде орындалады, егер сен бас тартпасаң.
Dialogue: 0,0:09:51.42,0:09:54.59,Default,,0,0,0,,Иә, менің де екінші құпия база туралы арманым...
Dialogue: 0,0:09:55.17,0:09:58.09,Default,,0,0,0,,Джеро Джеро Джеро Джеро Джеро Рин!
Dialogue: 0,0:09:59.51,0:10:02.18,Default,,0,0,0,,Aqua Aqua…
Dialogue: 0,0:10:03.60,0:10:08.02,Default,,0,0,0,,(Байланыс дыбысы)
Dialogue: 0,0:10:11.69,0:10:12.36,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:10:12.86,0:10:15.69,Default,,0,0,0,,Биологиялық реакцияның кенеттен пайда болуы – бұл
Dialogue: 0,0:10:15.78,0:10:18.49,Default,,0,0,0,,А, бұл керемет энергия мөлшері.
Dialogue: 0,0:10:18.57,0:10:20.95,Default,,0,0,0,,Бұл тегін емес, Кук!
Dialogue: 0,0:10:21.03,0:10:21.87,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:10:21.95,0:10:22.62,Default,,0,0,0,,Ол алыс.
Dialogue: 0,0:10:23.20,0:10:25.62,Default,,0,0,0,,Оңтүстік Тынық мұхиты, Пасха аралына жақын.
Dialogue: 0,0:10:26.20,0:10:28.08,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:10:30.04,0:10:32.67,Default,,0,0,0,,Сержант, дөрекі болатын сияқты.
Dialogue: 0,0:10:33.17,0:10:35.92,Default,,0,0,0,,Бұлттардың үстінен пана аламыз ба?
Dialogue: 0,0:10:36.01,0:10:36.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:39.09,0:10:39.80,Default,,0,0,0,,Құсу!
Dialogue: 0,0:10:39.88,0:10:41.51,Default,,0,0,0,,(Бала) Уау! (Бала) Уау~
Dialogue: 0,0:10:42.97,0:10:43.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:46.18,0:10:47.89,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:10:47.98,0:10:49.81,Default,,0,0,0,,Менің естігім келетіні осы.
Dialogue: 0,0:10:50.39,0:10:51.27,Default,,0,0,0,,Құсу?
Dialogue: 0,0:10:51.35,0:10:53.52,Default,,0,0,0,,Әй, болмайды... ол тағы да осында!
Dialogue: 0,0:11:00.03,0:11:01.61,Default,,0,0,0,,Тезірек, тезірек!
Dialogue: 0,0:11:01.70,0:11:03.66,Default,,0,0,0,,Әлі де қызып кету алдында...
Dialogue: 0,0:11:03.74,0:11:04.62,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:11:04.70,0:11:06.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:12.25,0:11:13.54,Default,,0,0,0,,Аку Аку!
Dialogue: 0,0:11:13.63,0:11:15.29,Default,,0,0,0,,Ugggggggggg...
Dialogue: 0,0:11:15.38,0:11:17.42,Default,,0,0,0,,Aku Aku~!
Dialogue: 0,0:11:17.51,0:11:19.59,Default,,0,0,0,,Аку~!
Dialogue: 0,0:11:22.13,0:11:24.47,Default,,0,0,0,,Сержант! Уау... Бұған дейін!
Dialogue: 0,0:11:28.43,0:11:30.31,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:30.39,0:11:33.10,Default,,0,0,0,,Сержант~!
Dialogue: 0,0:11:54.54,0:11:57.38,Default,,0,0,0,,Фуюки-доно Фуюки-доно...
Dialogue: 0,0:11:57.88,0:11:59.30,Default,,0,0,0,,Гу… Сержант…
Dialogue: 0,0:11:59.80,0:12:00.97,Default,,0,0,0,,А... Сержант?
Dialogue: 0,0:12:01.05,0:12:04.14,Default,,0,0,0,,Сержант, сіз қайдасыз? Сержант!
Dialogue: 0,0:12:04.93,0:12:07.68,Default,,0,0,0,,Сержант, солай ма? Сержант!
Dialogue: 0,0:12:08.26,0:12:10.64,Default,,0,0,0,,Ха ха ха... Сержант...
Dialogue: 0,0:12:10.73,0:12:15.31,Default,,0,0,0,,(Фуюкидің ауыр тыныс алуы)
Dialogue: 0,0:12:15.40,0:12:19.32,Default,,0,0,0,,А-а, болмайды... Бұл жерде болады деп ойламадым...
Dialogue: 0,0:12:48.55,0:12:50.60,Default,,0,0,0,,Бұл шынымен де келді
Dialogue: 0,0:12:51.22,0:12:52.48,Default,,0,0,0,,Пасха аралына!
Dialogue: 0,0:12:52.56,0:12:53.98,Default,,0,0,0,,Міне
Dialogue: 0,0:12:54.06,0:12:56.48,Default,,0,0,0,,Пасха аралындағы жалғыз ауыл, Ханга Роа
Dialogue: 0,0:12:57.06,0:13:00.44,Default,,0,0,0,,Ғимарат моайдан биік болмауы керек деген келісім бар.
Dialogue: 0,0:13:00.52,0:13:02.69,Default,,0,0,0,,Олардың көпшілігі бір қабатты үйлер.
Dialogue: 0,0:13:04.78,0:13:06.66,Default,,0,0,0,,Әйтеуір, мен сержантты табуым керек.
Dialogue: 0,0:13:07.16,0:13:09.87,Default,,0,0,0,,Иә, бір жерде полиция болуы керек.
Dialogue: 0,0:13:10.37,0:13:12.79,Default,,0,0,0,,Бірақ мен не айта аламын?
Dialogue: 0,0:13:13.37,0:13:16.71,Default,,0,0,0,,Менің бөтен досым жоғалып кетті.
Dialogue: 0,0:13:16.79,0:13:19.42,Default,,0,0,0,,Бірінші мен тіпті тілін де түсінбеймін...
Dialogue: 0,0:13:19.50,0:13:20.42,Default,,0,0,0,,Конничиха!
Dialogue: 0,0:13:20.50,0:13:21.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.05,0:13:23.13,Default,,0,0,0,,Иолана!
Dialogue: 0,0:13:23.21,0:13:25.30,Default,,0,0,0,,- (Фуюки) А... Мен... Иолана - (Бала А) Достар!
Dialogue: 0,0:13:25.38,0:13:26.47,Default,,0,0,0,,Аригато!
Dialogue: 0,0:13:26.55,0:13:27.59,Default,,0,0,0,,Омиаж Атчи
Dialogue: 0,0:13:27.68,0:13:32.06,Default,,0,0,0,,Жоқ... жоқ, мм... біртүрлі тіршілік иелерін көрмедің бе?
Dialogue: 0,0:13:32.14,0:13:33.35,Default,,0,0,0,,Икимоно?
Dialogue: 0,0:13:33.43,0:13:34.31,Default,,0,0,0,,Хна?
Dialogue: 0,0:13:34.39,0:13:36.52,Default,,0,0,0,,Бұл жұмыс істеуге мүмкіндік жоқ... Иә?
Dialogue: 0,0:13:38.48,0:13:39.61,Default,,0,0,0,,-Мана - (Фуюки) Иә?
Dialogue: 0,0:13:39.69,0:13:42.23,Default,,0,0,0,,-Мана - (Фуюки) Уау!
Dialogue: 0,0:13:43.90,0:13:46.90,Default,,0,0,0,,Не... бұл не? Сіз оны көрмейсіз бе?
Dialogue: 0,0:13:46.99,0:13:49.82,Default,,0,0,0,,Олай болса... онда сау бол!
Dialogue: 0,0:13:49.91,0:13:51.20,Default,,0,0,0,,Иолана!
Dialogue: 0,0:13:52.28,0:13:53.16,Default,,0,0,0,,О...
Dialogue: 0,0:13:53.66,0:13:54.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:54.95,0:13:57.87,Default,,0,0,0,,Уау! Кешіріңіз... Кешіріңіз!
Dialogue: 0,0:13:57.96,0:14:00.38,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:14:07.05,0:14:08.84,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:11.47,0:14:11.97,Default,,0,0,0,,Мана?
Dialogue: 0,0:14:12.05,0:14:13.81,Default,,0,0,0,,Әрі қарай
Dialogue: 0,0:14:18.35,0:14:21.31,Default,,0,0,0,,Сержант, сіз қайдасыз?
Dialogue: 0,0:14:21.40,0:14:25.61,Default,,0,0,0,,Армандар міндетті түрде орындалады, егер сен бас тартпасаң.
Dialogue: 0,0:14:25.69,0:14:26.78,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:14:28.03,0:14:28.95,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:29.03,0:14:29.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:32.49,0:14:33.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.45,0:14:35.08,Default,,0,0,0,,Кім?
Dialogue: 0,0:14:35.16,0:14:36.66,Default,,0,0,0,,- (Қыз) Хи хи - (Фуюки) Уау!
Dialogue: 0,0:14:36.75,0:14:38.37,Default,,0,0,0,,Не? Онда біреу бар ма?
Dialogue: 0,0:14:42.42,0:14:43.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:43.17,0:14:44.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:45.42,0:14:46.96,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:14:48.30,0:14:49.05,Default,,0,0,0,,- (Бала) Уф! - (Фуюки) Ах!
Dialogue: 0,0:14:49.13,0:14:50.55,Default,,0,0,0,,Уф! Хехехе
Dialogue: 0,0:14:51.93,0:14:52.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:53.35,0:14:53.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:55.31,0:14:57.06,Default,,0,0,0,,Ал сендер ше...
Dialogue: 0,0:14:57.14,0:14:58.64,Default,,0,0,0,,Кук... хехе
Dialogue: 0,0:14:58.73,0:15:01.65,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:15:08.28,0:15:09.28,Default,,0,0,0,,Иолана
Dialogue: 0,0:15:10.11,0:15:12.07,Default,,0,0,0,,Мен... Иолана
Dialogue: 0,0:15:12.57,0:15:15.24,Default,,0,0,0,,Жақсы, олар жаман балалар сияқты емес.
Dialogue: 0,0:15:15.33,0:15:16.99,Default,,0,0,0,,Олар бір-біріне ұқсайды, бірақ егіз бе?
Dialogue: 0,0:15:17.08,0:15:17.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.66,0:15:21.12,Default,,0,0,0,,Иә? Менің басым айналады әйтеуір...
Dialogue: 0,0:15:28.13,0:15:32.34,Default,,0,0,0,,Фуюки-доно, мен сені күтемін.
Dialogue: 0,0:15:32.43,0:15:33.55,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:15:35.26,0:15:36.89,Default,,0,0,0,,Сержант?
Dialogue: 0,0:15:37.97,0:15:38.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.02,0:15:43.35,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:43.44,0:15:47.78,Default,,0,0,0,,А... балалар қайдасыңдар?
Dialogue: 0,0:15:48.28,0:15:49.32,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:50.65,0:15:51.53,Default,,0,0,0,,Сержант?
Dialogue: 0,0:15:52.20,0:15:54.74,Default,,0,0,0,,Құсу... Аа... Фуюки-доно
Dialogue: 0,0:15:56.03,0:15:58.12,Default,,0,0,0,,Гу... Сержант!
Dialogue: 0,0:15:58.20,0:16:01.50,Default,,0,0,0,,Фую... фуйу... Фуюки-доно?
Dialogue: 0,0:16:01.58,0:16:03.92,Default,,0,0,0,,Сержант~!
Dialogue: 0,0:16:04.00,0:16:05.75,Default,,0,0,0,,Фуюки-доно~!
Dialogue: 0,0:16:05.83,0:16:07.71,Default,,0,0,0,,Құсу... Гёе~!
Dialogue: 0,0:16:07.80,0:16:08.92,Default,,0,0,0,,Аджиджиджиджиджиджиджи…
Dialogue: 0,0:16:09.00,0:16:10.17,Default,,0,0,0,,Уау! Күтіңіз, күтіңіз!
Dialogue: 0,0:16:10.26,0:16:11.76,Default,,0,0,0,,Бұл тамақ емес!
Dialogue: 0,0:16:26.98,0:16:28.73,Default,,0,0,0,,Сәлем, сержант.
Dialogue: 0,0:16:28.82,0:16:29.32,Default,,0,0,0,,Құсу?
Dialogue: 0,0:16:29.40,0:16:31.90,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:16:32.44,0:16:34.15,Default,,0,0,0,,Мен де өзімді сергек сезінемін.
Dialogue: 0,0:16:34.24,0:16:37.95,Default,,0,0,0,,Сіздің киген киіміңіз осы аралдың ескі костюміне ұқсайды.
Dialogue: 0,0:16:38.45,0:16:39.08,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:40.83,0:16:43.37,Default,,0,0,0,,Ең жылдам жол – адамның өзінен сұрау.
Dialogue: 0,0:16:43.46,0:16:45.17,Default,,0,0,0,,Не? Бірақ сөздер...
Dialogue: 0,0:16:45.25,0:16:47.08,Default,,0,0,0,,Осындай кездерде бұл солай.
Dialogue: 0,0:16:47.17,0:16:48.96,Default,,0,0,0,,“Хоньякукон…”
Dialogue: 0,0:16:49.04,0:16:51.84,Default,,0,0,0,,Motoi «Керон армиясының әмбебап белгісі»!
Dialogue: 0,0:16:52.59,0:16:54.93,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:16:55.01,0:16:58.85,Default,,0,0,0,,Коммутаторды қосып, кез келген сөзді лезде аударыңыз
Dialogue: 0,0:16:59.76,0:17:00.31,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:01.22,0:17:02.14,Default,,0,0,0,,Практикалық емтиханға келесі қай команда шығады екен?
Dialogue: 0,0:17:02.64,0:17:05.64,Default,,0,0,0,,Балалар, менің айтқанымды түсіндіңдер ме?
Dialogue: 0,0:17:05.73,0:17:09.65,Default,,0,0,0,,Ах... Түсінгенім таңқаларлық.
Dialogue: 0,0:17:09.73,0:17:13.36,Default,,0,0,0,,Керемет, мм... менің атым Фуюки.
Dialogue: 0,0:17:13.44,0:17:15.11,Default,,0,0,0,,Сонымен, сіздің есімдеріңіз кім?
Dialogue: 0,0:17:15.70,0:17:16.53,Default,,0,0,0,,Io
Dialogue: 0,0:17:16.61,0:17:17.16,Default,,0,0,0,,Лана
Dialogue: 0,0:17:17.66,0:17:18.57,Default,,0,0,0,,Иолана!
Dialogue: 0,0:17:18.66,0:17:20.78,Default,,0,0,0,,Бұл Ио-кун мен Лана-чан.
Dialogue: 0,0:17:20.87,0:17:22.66,Default,,0,0,0,,Ең алдымен көмегіңіз үшін рахмет.
Dialogue: 0,0:17:24.16,0:17:27.17,Default,,0,0,0,,Ах... Демек, бұл сержант Кероро.
Dialogue: 0,0:17:27.25,0:17:28.79,Default,,0,0,0,,Ол менің сенімді досым.
Dialogue: 0,0:17:28.88,0:17:30.17,Default,,0,0,0,,Кероро?
Dialogue: 0,0:17:30.25,0:17:31.30,Default,,0,0,0,,Достар?
Dialogue: 0,0:17:31.38,0:17:33.17,Default,,0,0,0,,Иә? Мен білмеймін?
Dialogue: 0,0:17:33.26,0:17:34.42,Default,,0,0,0,,Достар!
Dialogue: 0,0:17:34.51,0:17:36.38,Default,,0,0,0,,Бұл дұрыс емес шығар.
Dialogue: 0,0:17:36.47,0:17:39.05,Default,,0,0,0,,Кероро Бұл аралдың тілінде «Кайнене»
Dialogue: 0,0:17:39.14,0:17:40.60,Default,,0,0,0,,Иә, Кайнена
Dialogue: 0,0:17:40.68,0:17:41.81,Default,,0,0,0,,Кейне...
Dialogue: 0,0:17:41.89,0:17:42.93,Default,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:17:43.02,0:17:45.06,Default,,0,0,0,,Қорқынышты басқыншы дейсіз бе?
Dialogue: 0,0:17:45.14,0:17:47.81,Default,,0,0,0,,Жоқ Бұл дәмді тағамды білдіреді.
Dialogue: 0,0:17:48.31,0:17:50.19,Default,,0,0,0,,-Кейнене! -Кейнене!
Dialogue: 0,0:17:50.27,0:17:52.07,Default,,0,0,0,,Ас кім!
Dialogue: 0,0:17:52.15,0:17:55.28,Default,,0,0,0,,Айтпақшы, біз де осындамыз.
Dialogue: 0,0:17:55.36,0:17:58.41,Default,,0,0,0,,Маған біраз уақыт қызық болды, бірақ бұл не?
Dialogue: 0,0:17:58.49,0:18:00.24,Default,,0,0,0,,Мана~! Мана?
Dialogue: 0,0:18:00.32,0:18:03.20,Default,,0,0,0,,Манамана Манамана Манамана...
Dialogue: 0,0:18:03.29,0:18:04.16,Default,,0,0,0,,Құсу!
Dialogue: 0,0:18:04.24,0:18:04.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:05.04,0:18:06.58,Default,,0,0,0,,Мана мана мана... мана!
Dialogue: 0,0:18:07.37,0:18:08.08,Default,,0,0,0,,Мана!
Dialogue: 0,0:18:08.17,0:18:12.13,Default,,0,0,0,,Мана
Dialogue: 0,0:18:12.21,0:18:15.84,Default,,0,0,0,,Бұл... бұл аралдың рухы болуы мүмкін бе?
Dialogue: 0,0:18:15.92,0:18:17.88,Default,,0,0,0,,Мана — мана — бәрі — мана
Dialogue: 0,0:18:17.97,0:18:21.93,Default,,0,0,0,,Мен мананың моайда тұратын тылсым күш екеніне сенімдімін...
Dialogue: 0,0:18:22.43,0:18:23.93,Default,,0,0,0,,Міне осылай...
Dialogue: 0,0:18:24.01,0:18:24.93,Default,,0,0,0,,Мана!
Dialogue: 0,0:18:25.02,0:18:26.31,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:26.39,0:18:28.27,Default,,0,0,0,,Фуюки және басқалары мананы көре алады
Dialogue: 0,0:18:28.35,0:18:29.48,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:18:29.56,0:18:30.94,Default,,0,0,0,,Сонда... шынымен бе?
Dialogue: 0,0:18:31.02,0:18:32.61,Default,,0,0,0,,Әдетте көрінбейді
Dialogue: 0,0:18:32.69,0:18:35.36,Default,,0,0,0,,Сонымен Мана мен басқалары қуанып, Фуюкидің артынан қуды.
Dialogue: 0,0:18:35.94,0:18:37.69,Default,,0,0,0,,Мана бұл аралды жақсы көреді
Dialogue: 0,0:18:37.78,0:18:40.95,Default,,0,0,0,,Сондықтан мен сені ұзақ бақылап жүрдім.
Dialogue: 0,0:18:41.03,0:18:44.87,Default,,0,0,0,,Иә 100 жыл 200 жыл 300 жыл
Dialogue: 0,0:18:44.95,0:18:48.96,Default,,0,0,0,,Баяғыдан бері Ио мен Лана барлығымен бірге.
Dialogue: 0,0:18:49.04,0:18:51.17,Default,,0,0,0,,О... сендер балалар?
Dialogue: 0,0:18:51.25,0:18:53.50,Default,,0,0,0,,Ио және мана Лана және мана
Dialogue: 0,0:18:53.59,0:18:55.13,Default,,0,0,0,,Адам кейпіндегі манна
Dialogue: 0,0:18:57.26,0:18:59.01,Default,,0,0,0,,Бұл сіздің адам емес екеніңізді білдіре ме?
Dialogue: 0,0:18:59.09,0:19:01.05,Default,,0,0,0,,Хе, таң қаларлық емес.
Dialogue: 0,0:19:01.14,0:19:04.64,Default,,0,0,0,,Қазір мұндағы адамдардың ішінде Фуюки жалғыз адам.
Dialogue: 0,0:19:04.72,0:19:05.85,Default,,0,0,0,,Құсу…
Dialogue: 0,0:19:06.60,0:19:07.22,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:19:07.93,0:19:10.73,Default,,0,0,0,,Балалар, түсінетіндеріңізге сенімдімін.
Dialogue: 0,0:19:12.65,0:19:13.69,Default,,0,0,0,,Міне...
Dialogue: 0,0:19:13.77,0:19:14.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:22.57,0:19:23.24,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.32,0:19:26.74,Default,,0,0,0,,Не... ше? Бұл өте керемет емес пе?
Dialogue: 0,0:19:26.83,0:19:28.16,Default,,0,0,0,,Жоқ, гепоко
Dialogue: 0,0:19:28.25,0:19:28.79,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:19:29.37,0:19:30.58,Default,,0,0,0,,Бірақ сөзсіз
Dialogue: 0,0:19:30.66,0:19:33.04,Default,,0,0,0,,Мен мұнда туған моайды ешқашан көрген емеспін.
Dialogue: 0,0:19:33.13,0:19:34.71,Default,,0,0,0,,Мана Мана
Dialogue: 0,0:19:34.79,0:19:35.84,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:19:36.34,0:19:39.30,Default,,0,0,0,,Бірақ неге ол дәл сержантқа ұқсайды?
Dialogue: 0,0:19:39.38,0:19:40.63,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:40.72,0:19:42.47,Default,,0,0,0,,Сіз бұл заттың қайда екенін білмейсіз бе?
Dialogue: 0,0:19:42.55,0:19:43.80,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:19:43.89,0:19:44.97,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:19:45.05,0:19:45.72,Default,,0,0,0,,Олай болса
Dialogue: 0,0:19:45.80,0:19:47.31,Default,,0,0,0,,Оны қайтару үшін қайда баруым керек?
Dialogue: 0,0:19:47.39,0:19:48.64,Default,,0,0,0,,- (Ио Лана) Жоқ! -(Фуюки) А...
Dialogue: 0,0:19:48.72,0:19:50.31,Default,,0,0,0,,Сыртта серуендеу қауіпті!
Dialogue: 0,0:19:50.39,0:19:52.19,Default,,0,0,0,,Жаман Аку Аку қайтып келді!
Dialogue: 0,0:19:52.27,0:19:53.40,Default,,0,0,0,,«Ақу Ақу»?
Dialogue: 0,0:19:53.48,0:19:54.35,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:19:54.44,0:19:56.40,Default,,0,0,0,,Бұл жаман ат.
Dialogue: 0,0:19:56.48,0:19:58.36,Default,,0,0,0,,Рапа Нуи тілінде: рухани күш
Dialogue: 0,0:19:58.44,0:20:00.28,Default,,0,0,0,,Бұзық пері туралы.
Dialogue: 0,0:20:00.90,0:20:02.32,Default,,0,0,0,,Аку Аку үлкен
Dialogue: 0,0:20:02.40,0:20:03.86,Default,,0,0,0,,Акуаку Ережесіз бала!
Dialogue: 0,0:20:03.95,0:20:04.62,Default,,0,0,0,,Мана көрінеді
Dialogue: 0,0:20:04.70,0:20:07.87,Default,,0,0,0,,Фуюки және басқалары міндетті түрде Аку Акудың назарын аударады!
Dialogue: 0,0:20:07.95,0:20:10.95,Default,,0,0,0,,Қозғалмаңыз. Мұнда тек қауіпсіз!
Dialogue: 0,0:20:11.04,0:20:14.46,Default,,0,0,0,,Сол Моаиды Лана мен басқаларға беріп, үйге ерте қайт!
Dialogue: 0,0:20:14.54,0:20:16.17,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:20:17.67,0:20:18.96,Default,,0,0,0,,Я... Фуюки-доно...
Dialogue: 0,0:20:19.05,0:20:22.01,Default,,0,0,0,,Егер мен оны қайтаруым керек болса, бұл Рано Рараку болар еді деп ойлаймын.
Dialogue: 0,0:20:22.09,0:20:23.59,Default,,0,0,0,,«Рано Рараку»?
Dialogue: 0,0:20:23.68,0:20:26.80,Default,,0,0,0,,Пасха аралындағы барлық моайлар қай жерде құрылған
Dialogue: 0,0:20:26.89,0:20:29.31,Default,,0,0,0,,Менің ойымша, бұл моай зауыты.
Dialogue: 0,0:20:29.39,0:20:32.02,Default,,0,0,0,,Құсу! Бұл зауыт па?
Dialogue: 0,0:20:33.02,0:20:35.69,Default,,0,0,0,,Рапа Нуи… қауіп механизмі
Dialogue: 0,0:20:35.77,0:20:36.98,Default,,0,0,0,,Рано Рараку
Dialogue: 0,0:20:37.06,0:20:39.52,Default,,0,0,0,,Менің екінші құпия базамның дәл ортасында
Dialogue: 0,0:20:39.61,0:20:40.86,Default,,0,0,0,,Бұл орынды емес пе?
Dialogue: 0,0:20:40.94,0:20:43.36,Default,,0,0,0,,Бірақ мен тоқтауым керек пе?
Dialogue: 0,0:20:43.45,0:20:44.61,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:20:45.24,0:20:49.37,Default,,0,0,0,,Зұлым рухтармен күресуде біз жалғыз емеспіз.
Dialogue: 0,0:20:49.45,0:20:51.12,Default,,0,0,0,,Бұл тас мүсін күткендей...
Dialogue: 0,0:20:51.20,0:20:52.75,Default,,0,0,0,,Оны Io-ға қалдырыңыз
Dialogue: 0,0:20:52.83,0:20:54.25,Default,,0,0,0,,Оны Ланаға қалдырыңыз
Dialogue: 0,0:20:54.33,0:20:55.50,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:20:55.58,0:20:58.50,Default,,0,0,0,,Балалар, сіздердің арал туралы менен көбірек білетіндеріңізге сенімдімін.
Dialogue: 0,0:20:59.09,0:21:01.51,Default,,0,0,0,,Кешіріңіз, бірақ бас тартқан дұрыс...
Dialogue: 0,0:21:03.26,0:21:04.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:04.17,0:21:05.68,Default,,0,0,0,,Кешіріңіз?
Dialogue: 0,0:21:05.76,0:21:08.51,Default,,0,0,0,,Ге~рогеро! Бұл комедиялық әзіл
Dialogue: 0,0:21:08.60,0:21:09.81,Default,,0,0,0,,Қандай өкінішті?
Dialogue: 0,0:21:09.89,0:21:12.64,Default,,0,0,0,,Бұл бәрін істеген адамның сөзі!
Dialogue: 0,0:21:12.72,0:21:14.02,Default,,0,0,0,,Гу… Сержант…
Dialogue: 0,0:21:14.10,0:21:17.31,Default,,0,0,0,,Пекопонның арғы бетіне келе жатқанда
Dialogue: 0,0:21:17.40,0:21:20.23,Default,,0,0,0,,Барар жер алдыңда, құтты болсын...
Dialogue: 0,0:21:20.73,0:21:21.36,Default,,0,0,0,,«Уау!»
Dialogue: 0,0:21:21.44,0:21:24.65,Default,,0,0,0,,«Мен армандаған аралымның топырағын басқаныма қуаныштымын».
Dialogue: 0,0:21:25.45,0:21:27.61,Default,,0,0,0,,Осыған көңіліңіз тола ма, Фуюки-доно?
Dialogue: 0,0:21:28.49,0:21:29.20,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:21:29.28,0:21:32.16,Default,,0,0,0,,Осында келе жатқанда да бөлек шықтым.
Dialogue: 0,0:21:32.24,0:21:34.33,Default,,0,0,0,,Сіз не болып жатқанын білмейсіз.
Dialogue: 0,0:21:34.41,0:21:36.12,Default,,0,0,0,,Бұл анық!
Dialogue: 0,0:21:36.21,0:21:36.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.33,0:21:38.88,Default,,0,0,0,,Мен бұл арман деп айттым
Dialogue: 0,0:21:39.38,0:21:40.79,Default,,0,0,0,,Фуюки-дононың арманы
Dialogue: 0,0:21:40.88,0:21:43.13,Default,,0,0,0,,Бұл шынымен де арзан болды ма?
Dialogue: 0,0:21:43.71,0:21:44.92,Default,,0,0,0,,Сержант...
Dialogue: 0,0:21:48.43,0:21:49.34,Default,,0,0,0,,- (Фуюки) Фуфу - Гей...
Dialogue: 0,0:21:49.43,0:21:52.39,Default,,0,0,0,,Хехе... хехехе хаха...
Dialogue: 0,0:21:53.93,0:21:56.60,Default,,0,0,0,,Мен сержант қорқып, үйіне қайтқысы келді деп ойладым.
Dialogue: 0,0:21:56.69,0:21:58.02,Default,,0,0,0,,Мен мұны әдейі айттым.
Dialogue: 0,0:21:58.10,0:21:59.35,Default,,0,0,0,,Не... Фуюки-доно
Dialogue: 0,0:21:59.44,0:22:01.27,Default,,0,0,0,,Сержант дұрыс айтады.
Dialogue: 0,0:22:01.77,0:22:04.74,Default,,0,0,0,,Егер мен қазір үйге барсам, осы уақытқа дейін келудің пайдасы жоқ.
Dialogue: 0,0:22:05.94,0:22:08.70,Default,,0,0,0,,Кеттік, сержант! Рано Раракуға бірге барайық!
Dialogue: 0,0:22:08.78,0:22:11.45,Default,,0,0,0,,Жарайсыңдар! Дұрыс!
Dialogue: 0,0:22:11.53,0:22:12.53,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:12.62,0:22:14.79,Default,,0,0,0,,Бұл Аку Аку немесе Вару Валу болсын.
Dialogue: 0,0:22:14.87,0:22:16.79,Default,,0,0,0,,Мен оларды қуып жіберемін.
Dialogue: 0,0:22:16.87,0:22:18.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:18.17,0:22:19.67,Default,,0,0,0,,Кайнена керемет!
Dialogue: 0,0:22:19.75,0:22:21.21,Default,,0,0,0,,Кайнена Батыл!
Dialogue: 0,0:22:21.29,0:22:23.13,Default,,0,0,0,,Ас кім!
Dialogue: 0,0:22:24.09,0:22:24.67,Default,,0,0,0,,Куруру
Dialogue: 0,0:22:25.17,0:22:27.38,Default,,0,0,0,,Керороның қайда екенін білдіңіз бе?
Dialogue: 0,0:22:27.47,0:22:29.34,Default,,0,0,0,,-Туралы? -Хмм?
Dialogue: 0,0:22:29.93,0:22:33.81,Default,,0,0,0,,Ағай мен Фуюки-сан Пасха аралына бармады.
Dialogue: 0,0:22:33.89,0:22:35.43,Default,,0,0,0,,Ағай мен Фуюки-сан...
Dialogue: 0,0:22:35.52,0:22:37.68,Default,,0,0,0,,Мына жаңалықты қараңыз.
Dialogue: 0,0:22:38.19,0:22:40.48,Default,,0,0,0,,«Пасха аралындағы жанартаулық көлдің түбінде»
Dialogue: 0,0:22:40.56,0:22:43.11,Default,,0,0,0,,«Зерттеу тобы жаңа моаи ашты»
Dialogue: 0,0:22:43.82,0:22:45.78,Default,,0,0,0,,«Көшбасшының айтуынша, доктор Хюши»
Dialogue: 0,0:22:45.86,0:22:49.61,Default,,0,0,0,,«Моай көтерілген кезде оның астынан үлкен көлеңке секірді».
Dialogue: 0,0:22:49.70,0:22:51.62,Default,,0,0,0,,Ал... Мен бұны күтпедім...
Dialogue: 0,0:22:51.70,0:22:52.74,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:22:53.24,0:22:54.08,Default,,0,0,0,,Джироро!
Dialogue: 0,0:22:54.16,0:22:54.91,Default,,0,0,0,,- Сәлем! -Аа...
Dialogue: 0,0:22:56.20,0:22:57.37,Default,,0,0,0,,Не болды? Нацуми
Dialogue: 0,0:22:57.45,0:22:58.91,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:22:59.00,0:23:02.67,Default,,0,0,0,,Сіз бізден сұрамай бірнеше күнге шығамын дедіңіз.
Dialogue: 0,0:23:02.75,0:23:04.63,Default,,0,0,0,,Менің ойымша, Фуюки де онымен бірге!
Dialogue: 0,0:23:04.71,0:23:06.00,Default,,0,0,0,,Сіз
Dialogue: 0,0:23:06.09,0:23:09.51,Default,,0,0,0,,Фуюки мен Бокегаэру қайда кеткенін білесіз бе?
Dialogue: 0,0:23:09.59,0:23:10.93,Default,,0,0,0,,Эй... Жироро!
Dialogue: 0,0:23:11.84,0:23:14.60,Default,,0,0,0,,Төтенше қоңырау үшін Тамама мен Доророға қоңырау шалыңыз.
Dialogue: 0,0:23:15.10,0:23:17.14,Default,,0,0,0,,Біз де Пасха аралына барамыз
Dialogue: 0,0:23:17.22,0:23:20.23,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:23:24.36,0:23:25.73,Default,,0,0,0,,Момокки
Dialogue: 0,0:23:25.82,0:23:28.78,Default,,0,0,0,,Бүгін мен сені толығымен талқандаймын.
Dialogue: 0,0:23:28.86,0:23:29.82,Default,,0,0,0,,Хан!
Dialogue: 0,0:23:29.90,0:23:32.28,Default,,0,0,0,,Бұл менің жолым, Тама мырза!
Dialogue: 0,0:23:32.95,0:23:34.16,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:34.24,0:23:35.41,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:35.49,0:23:37.24,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:23:37.33,0:23:38.33,Default,,0,0,0,,(Тамаманың ауыр тыныс алуы)
Dialogue: 0,0:23:38.41,0:23:39.62,Default,,0,0,0,,- Сай - (Момока) Шоха...
Dialogue: 0,0:23:39.70,0:23:40.33,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:23:40.41,0:23:41.33,Default,,0,0,0,,(Исуми Миямура) Иә (Ишикава) Маған беріп тұрсың ба?
Dialogue: 0,0:23:41.42,0:23:44.13,Default,,0,0,0,,Бұл Айко! Бұл Айко! Бұл Айко!
Dialogue: 0,0:23:44.21,0:23:45.71,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:23:46.34,0:23:49.42,Default,,0,0,0,,- (Момока) Папапапа! -Апыр-ай!
Dialogue: 0,0:23:49.51,0:23:52.84,Default,,0,0,0,,Уф... Ал... мен жеңілдім...
Dialogue: 0,0:23:53.34,0:23:55.10,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:23:55.93,0:23:57.81,Default,,0,0,0,,Әлі жоқ, лорд Тама.
Dialogue: 0,0:23:57.89,0:23:59.18,Default,,0,0,0,,(Байланыс жүйесінің қоңырау үні)
Dialogue: 0,0:23:59.27,0:24:01.89,Default,,0,0,0,,Ханым, мен жаттығып жатырмын. Кешіріңіз.
Dialogue: 0,0:24:01.98,0:24:02.94,Default,,0,0,0,,Неліктен? Павел
Dialogue: 0,0:24:03.02,0:24:05.98,Default,,0,0,0,,Тамама мырзаға шұғыл қоңырау бар.
Dialogue: 0,0:24:06.06,0:24:08.19,Default,,0,0,0,,Тама? Мен үшін?
Dialogue: 0,0:24:08.94,0:24:11.07,Default,,0,0,0,,Капитан ше?
Dialogue: 0,0:24:11.15,0:24:12.99,Default,,0,0,0,,Білемін, мен жақында боламын.
Dialogue: 0,0:24:13.07,0:24:13.66,Default,,0,0,0,,(телефонның тұтқасын қою дыбысы)
Dialogue: 0,0:24:13.74,0:24:15.41,Default,,0,0,0,,Не болды? Дороро
Dialogue: 0,0:24:15.49,0:24:17.66,Default,,0,0,0,,Коюки-доно, бұл кенеттен болды.
Dialogue: 0,0:24:17.74,0:24:20.12,Default,,0,0,0,,Мен біраз уақыт боламын.
Dialogue: 0,0:24:20.20,0:24:23.04,Default,,0,0,0,,Капитанға бірдеңе болды, солай ма?
Dialogue: 0,0:24:23.12,0:24:24.83,Default,,0,0,0,,Дәмі сулы. Сосын мен де...
Dialogue: 0,0:24:24.92,0:24:26.13,Default,,0,0,0,,Нарандагозару
Dialogue: 0,0:24:26.21,0:24:26.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:26.96,0:24:29.55,Default,,0,0,0,,Бұл тек біздің взводқа ғана қатысты мәселе.
Dialogue: 0,0:24:30.05,0:24:32.88,Default,,0,0,0,,Және сол Коюки-доно тапқан қарлығаш ұясы.
Dialogue: 0,0:24:33.72,0:24:35.97,Default,,0,0,0,,Балапан ақыры шықты, солай емес пе?
Dialogue: 0,0:24:36.47,0:24:38.72,Default,,0,0,0,,Қайтадан қалжыңдамау үшін.
Dialogue: 0,0:24:38.81,0:24:42.43,Default,,0,0,0,,Мен Коюки-дононың мені біраз уақытқа бақылағанын қалаймын.
Dialogue: 0,0:24:42.93,0:24:44.85,Default,,0,0,0,,Бірақ... аа...
Dialogue: 0,0:24:49.02,0:24:50.98,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:24:51.82,0:24:53.99,Default,,0,0,0,,Сонда Крул барады, солай ма?
Dialogue: 0,0:24:54.07,0:24:55.95,Default,,0,0,0,,О, мен көмектесе алмаймын.
Dialogue: 0,0:24:56.03,0:24:59.41,Default,,0,0,0,,Сіз капитан болсаңыз да, қосымша жұмыс қосып жатырсыз.
Dialogue: 0,0:24:59.49,0:25:01.33,Default,,0,0,0,,Сіз осылай айтса да
Dialogue: 0,0:25:01.41,0:25:02.95,Default,,0,0,0,,Көңілді сияқты ма?
Dialogue: 0,0:25:03.04,0:25:04.00,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:25:04.08,0:25:06.25,Default,,0,0,0,,Жарайды, бұл жерде әбігерге түскеннен гөрі жақсы.
Dialogue: 0,0:25:06.33,0:25:07.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:25:07.29,0:25:09.13,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:25:09.21,0:25:11.25,Default,,0,0,0,,Тамама мен Дороро қазірдің өзінде осында!
Dialogue: 0,0:25:11.34,0:25:13.01,Default,,0,0,0,,Аа, мен бірден барамын.
Dialogue: 0,0:25:13.09,0:25:14.72,Default,,0,0,0,,Қайтып келгеннен кейін жалғастыру керек пе?
Dialogue: 0,0:25:14.80,0:25:17.39,Default,,0,0,0,,Жоқ, мұның қажеті жоқ.
Dialogue: 0,0:25:18.47,0:25:19.64,Default,,0,0,0,,Ой…
Dialogue: 0,0:25:19.72,0:25:21.01,Default,,0,0,0,,Бұл соңы.
Dialogue: 0,0:25:21.56,0:25:24.06,Default,,0,0,0,,Не болды? Сабуро: сенің қолың қызарып бара жатқан жоқ па?
Dialogue: 0,0:25:24.14,0:25:25.64,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:25:26.14,0:25:28.06,Default,,0,0,0,,Мен саған үйреткен ойын болса да
Dialogue: 0,0:25:28.77,0:25:31.32,Default,,0,0,0,,Менің ойымша, бұл олардың шетелдіктер болып көрінбейтінін білдіреді.
Dialogue: 0,0:25:33.07,0:25:35.57,Default,,0,0,0,,Осы уақытта сержант Кероро мен Фуюки-кун
Dialogue: 0,0:25:35.65,0:25:38.95,Default,,0,0,0,,Моаи салынған делінетін Рано Раракуға ұмтылу.
Dialogue: 0,0:25:39.45,0:25:41.20,Default,,0,0,0,,Ей, мен тұрмын!
Dialogue: 0,0:25:41.83,0:25:44.16,Default,,0,0,0,,Фуюки! Әлі көп жол бар!
Dialogue: 0,0:25:44.25,0:25:46.08,Default,,0,0,0,,Мен оны қалдырамын!
Dialogue: 0,0:25:46.16,0:25:47.62,Default,,0,0,0,,Иә, қазір кеттік!
Dialogue: 0,0:25:50.50,0:25:53.26,Default,,0,0,0,,Кешіріңіз, кешіріңіз, Рано Раракуға асығыңыз.
Dialogue: 0,0:25:53.76,0:25:55.59,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:25:55.67,0:25:57.97,Default,,0,0,0,,Моаи туған тау...
Dialogue: 0,0:25:58.05,0:26:00.76,Default,,0,0,0,,Рано Рараку Қасиетті күшінің жері
Dialogue: 0,0:26:00.85,0:26:05.35,Default,,0,0,0,,Ұлы тәңір Макемакенің құдіреті сол топырақта жатыр.
Dialogue: 0,0:26:05.43,0:26:09.06,Default,,0,0,0,,Мен бұл аралда бәрін жаратқан құдай туралы екеніне сенімдімін.
Dialogue: 0,0:26:09.15,0:26:13.07,Default,,0,0,0,,Макемаке, бұл әлсіз есім сияқты.
Dialogue: 0,0:26:13.15,0:26:14.48,Default,,0,0,0,,Құсу, құсу... А?
Dialogue: 0,0:26:14.57,0:26:17.32,Default,,0,0,0,,Мәкемаке-сама, мені мазақ етпе!
Dialogue: 0,0:26:17.40,0:26:20.91,Default,,0,0,0,,Макемаке-сама қазіргі заманда бар болса, Ақу Ақу керемет болар еді!
Dialogue: 0,0:26:20.99,0:26:22.24,Default,,0,0,0,,Өйткені қазір
Dialogue: 0,0:26:22.33,0:26:25.83,Default,,0,0,0,,Қалай ойласаң да, Мәкемаке жеңілгеннің аты ғой, солай ма?
Dialogue: 0,0:26:25.91,0:26:27.66,Default,,0,0,0,,Жаман тіл Жақсы емес!
Dialogue: 0,0:26:27.75,0:26:30.33,Default,,0,0,0,,Макемаке-саманың жазасы дұрыс па?
Dialogue: 0,0:26:30.42,0:26:32.34,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:26:33.92,0:26:37.22,Default,,0,0,0,,Сержант: Макемаке-самадан кешірім сұрау керек...
Dialogue: 0,0:26:37.30,0:26:40.18,Default,,0,0,0,,Сәлем! Мен жаңбырды жақсы көремін
Dialogue: 0,0:26:40.26,0:26:42.30,Default,,0,0,0,,Жаңбыр одан сайын жауады
Dialogue: 0,0:26:45.64,0:26:46.77,Default,,0,0,0,,Пуха~
Dialogue: 0,0:26:47.43,0:26:50.19,Default,,0,0,0,,Иә, сержант, сізге су керек емес...?
Dialogue: 0,0:26:50.27,0:26:52.61,Default,,0,0,0,,Аралдағы ауа-райы өте құбылмалы
Dialogue: 0,0:26:52.69,0:26:53.94,Default,,0,0,0,,Бірақ бұл қызық
Dialogue: 0,0:26:54.02,0:26:54.86,Default,,0,0,0,,Сонда... шынымен бе?
Dialogue: 0,0:26:54.94,0:26:55.98,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:26:56.07,0:26:58.70,Default,,0,0,0,,Әй, сержант... Сержант!
Dialogue: 0,0:26:59.24,0:27:00.49,Default,,0,0,0,,Жаза
Dialogue: 0,0:27:10.87,0:27:12.00,Default,,0,0,0,,Ороро?
Dialogue: 0,0:27:12.08,0:27:14.29,Default,,0,0,0,,Барлығы ұйықтап жатыр ма?
Dialogue: 0,0:27:14.38,0:27:17.92,Default,,0,0,0,,Бұл жердегі моайлардың бәрі басында тұрды.
Dialogue: 0,0:27:18.01,0:27:19.01,Default,,0,0,0,,Артымда теңіз бар
Dialogue: 0,0:27:19.51,0:27:20.43,Default,,0,0,0,,Артыңызда теңіз бар ма?
Dialogue: 0,0:27:20.93,0:27:21.80,Default,,0,0,0,,Иә
Dialogue: 0,0:27:21.89,0:27:24.85,Default,,0,0,0,,Шындығында, біз осы уақытқа дейін көрген моаи
Dialogue: 0,0:27:24.93,0:27:26.60,Default,,0,0,0,,Қазіргі қалпына келтіруге дейін
Dialogue: 0,0:27:26.68,0:27:28.85,Default,,0,0,0,,Олардың барлығы жеңіліске ұшырады.
Dialogue: 0,0:27:29.35,0:27:31.52,Default,,0,0,0,,Моаи әдетте теңіз жағасында орналасқан.
Dialogue: 0,0:27:31.60,0:27:34.31,Default,,0,0,0,,Олардың көпшілігі аралдың ішіне қараған.
Dialogue: 0,0:27:35.11,0:27:37.36,Default,,0,0,0,,Мен осылай жеңілгенше
Dialogue: 0,0:27:37.44,0:27:40.40,Default,,0,0,0,,Мен жеңілсем де, ол қандай заңсыздық болар еді...
Dialogue: 0,0:27:40.49,0:27:42.07,Default,,0,0,0,,- (Фуюки) Ах! - Құсу?
Dialogue: 0,0:27:42.16,0:27:44.20,Default,,0,0,0,,Жоқ, моайға тиіспе!
Dialogue: 0,0:27:44.28,0:27:46.24,Default,,0,0,0,,Егер сіз адам болсаңыз...
Dialogue: 0,0:27:46.74,0:27:49.16,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:27:49.25,0:27:51.37,Default,,0,0,0,,Фуюки қол ұстасып
Dialogue: 0,0:27:51.87,0:27:52.71,Default,,0,0,0,,Кейне де
Dialogue: 0,0:27:53.29,0:27:55.79,Default,,0,0,0,,Сондықтан мен тамақ емеспін.
Dialogue: 0,0:27:59.88,0:28:01.55,Default,,0,0,0,,-құсу~? - (Фуюки) Уау... Уау!
Dialogue: 0,0:28:03.34,0:28:05.68,Default,,0,0,0,,Құсу! Сонда... сен қайсысысың?
Dialogue: 0,0:28:05.76,0:28:07.06,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:28:07.56,0:28:11.18,Default,,0,0,0,,Ол әлі күнге дейін Моаи ішінде қалған санаулы Маналардың бірі.
Dialogue: 0,0:28:11.27,0:28:14.02,Default,,0,0,0,,Ол бір қарап алсын.
Dialogue: 0,0:28:14.10,0:28:15.73,Default,,0,0,0,,Осы арал туралы естеліктер
Dialogue: 0,0:28:17.69,0:28:18.69,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:28:19.48,0:28:20.40,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:28:20.49,0:28:21.15,Default,,0,0,0,,​​Джунгли?
Dialogue: 0,0:28:22.03,0:28:23.61,Default,,0,0,0,,Үлкен пальма ағашы...
Dialogue: 0,0:28:24.11,0:28:24.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:30.50,0:28:31.87,Default,,0,0,0,,Бір кездері
Dialogue: 0,0:28:31.96,0:28:34.71,Default,,0,0,0,,Аралда әлі де бай орман болған кезде
Dialogue: 0,0:28:35.29,0:28:37.71,Default,,0,0,0,,Әрбір моай қасиетті манаға толы.
Dialogue: 0,0:28:38.21,0:28:39.80,Default,,0,0,0,,Бұзық Ақу Ақу
Dialogue: 0,0:28:39.88,0:28:42.30,Default,,0,0,0,,Ол ұзақ уақыт бойы жер астында жабылған.
Dialogue: 0,0:28:42.80,0:28:47.10,Default,,0,0,0,,Бірақ бір күні адамдар арасында төбелес басталады.
Dialogue: 0,0:28:47.18,0:28:47.93,Default,,0,0,0,,- (Фуюки) Иә? - Құсу...
Dialogue: 0,0:28:48.01,0:28:51.56,Default,,0,0,0,,Моаи әр тайпаның символы болды.
Dialogue: 0,0:28:51.64,0:28:54.44,Default,,0,0,0,,Барлық жау тайпалардан жеңілген...
Dialogue: 0,0:28:55.15,0:28:55.85,Default,,0,0,0,,Жерде
Dialogue: 0,0:28:55.94,0:28:58.69,Default,,0,0,0,,Қашып кеткен Ақуақұсқа толды.
Dialogue: 0,0:28:59.19,0:29:03.15,Default,,0,0,0,,Бірақ осы уақытқа дейін барлық акуакустар кішкентай және әлсіз болды.
Dialogue: 0,0:29:03.24,0:29:06.91,Default,,0,0,0,,Ендеше бәріміз бөлініп,...
Dialogue: 0,0:29:06.99,0:29:10.45,Default,,0,0,0,,Қауіпті жоя білдік.
Dialogue: 0,0:29:11.20,0:29:12.08,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:29:12.75,0:29:13.91,Default,,0,0,0,,ең үлкені
Dialogue: 0,0:29:14.00,0:29:16.92,Default,,0,0,0,,Ақу Акудың ең зұлым жүрегі бар...
Dialogue: 0,0:29:17.96,0:29:20.80,Default,,0,0,0,,Алыстан келген адамдардың қолымен
Dialogue: 0,0:29:20.88,0:29:23.21,Default,,0,0,0,,Пломба ақыры бұзылды.
Dialogue: 0,0:29:26.72,0:29:28.85,Default,,0,0,0,,Мен оны басуға тырыстым, бірақ мүмкін болмады.
Dialogue: 0,0:29:28.93,0:29:31.35,Default,,0,0,0,,Сенің қазір қайда екеніңді ешкім білмейді.
Dialogue: 0,0:29:33.43,0:29:36.19,Default,,0,0,0,,Ең бұзақы Ақу Ақу
Dialogue: 0,0:29:36.69,0:29:39.06,Default,,0,0,0,,Ол қай жерде қаңғып жүр?
Dialogue: 0,0:29:39.56,0:29:40.82,Default,,0,0,0,,- (Фуюки) Сержант -?
Dialogue: 0,0:29:40.90,0:29:43.32,Default,,0,0,0,,Мүмкін біз бұрыннан кездескен шығармыз...
Dialogue: 0,0:29:43.40,0:29:44.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:44.36,0:29:45.15,Default,,0,0,0,,Құсу?
Dialogue: 0,0:29:45.24,0:29:48.49,Default,,0,0,0,,Қараңдаршы, біз осы аралға, теңізге келгенге дейін...
Dialogue: 0,0:29:48.57,0:29:49.53,Default,,0,0,0,,О... анау жігіт пе?
Dialogue: 0,0:29:49.62,0:29:50.91,Default,,0,0,0,,Сіз Аку Акумен кездестіңіз бе?
Dialogue: 0,0:29:50.99,0:29:51.49,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:29:51.58,0:29:54.45,Default,,0,0,0,,Олай болса, Ақу Акудың сені жақын арада табатынына сенімдімін.
Dialogue: 0,0:29:54.54,0:29:56.66,Default,,0,0,0,,Мүмкін ол қазірдің өзінде осында...
Dialogue: 0,0:29:57.17,0:29:57.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:57.87,0:29:59.38,Default,,0,0,0,,Не? Жарайды... мүмкін емес...
Dialogue: 0,0:29:59.46,0:30:00.59,Default,,0,0,0,,Е...
Dialogue: 0,0:30:00.67,0:30:03.63,Default,,0,0,0,,Ой... зәр шығару қаупі жоқ.
Dialogue: 0,0:30:04.46,0:30:06.30,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:30:08.93,0:30:10.39,Default,,0,0,0,,Аку Аку!
Dialogue: 0,0:30:10.47,0:30:11.93,Default,,0,0,0,,Уау! екінші ойлар туралы!
Dialogue: 0,0:30:17.10,0:30:18.52,Default,,0,0,0,,ЖОҚ!
Dialogue: 0,0:30:19.02,0:30:21.69,Default,,0,0,0,,Сен... сен... Ариса-чан!
Dialogue: 0,0:30:21.77,0:30:23.23,Default,,0,0,0,,Сіз күткендей, Фуюки.
Dialogue: 0,0:30:23.32,0:30:25.44,Default,,0,0,0,,Маған осындай үлкен адамды әкелгеніңізге сене алар емеспін.
Dialogue: 0,0:30:25.53,0:30:26.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:30:27.28,0:30:27.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:30:31.66,0:30:32.66,Default,,0,0,0,,Aqua~!
Dialogue: 0,0:30:32.74,0:30:35.08,Default,,0,0,0,,Егер кесу ысырап болса, онда бұл...
Dialogue: 0,0:30:35.16,0:30:35.79,Default,,0,0,0,,Әке
Dialogue: 0,0:30:35.87,0:30:38.79,Default,,0,0,0,,Біздің міндетіміз - қараңғылықтан құбыжықтарды аулау.
Dialogue: 0,0:30:38.87,0:30:39.50,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:30:39.58,0:30:40.92,Default,,0,0,0,,Аку~!
Dialogue: 0,0:30:42.63,0:30:43.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:30:47.84,0:30:49.72,Default,,0,0,0,,Сержант, не істеуіміз керек?
Dialogue: 0,0:30:49.80,0:30:51.09,Default,,0,0,0,,Тіпті...
Dialogue: 0,0:30:51.18,0:30:51.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:53.05,0:30:55.31,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:30:56.52,0:30:57.68,Default,,0,0,0,,Ичи немесе барабан таяқшасы?
Dialogue: 0,0:30:58.18,0:30:59.73,Default,,0,0,0,,Моайға бәрінің күші!
Dialogue: 0,0:31:02.77,0:31:03.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:06.23,0:31:08.78,Default,,0,0,0,,Алиса, ол мен күткеннен де үлкен.
Dialogue: 0,0:31:08.86,0:31:11.28,Default,,0,0,0,,Мен мұндай нәрсені жей алмаймын деп ойлаймын.
Dialogue: 0,0:31:15.16,0:31:17.20,Default,,0,0,0,,Бұл Фуюки азғырған олжа.
Dialogue: 0,0:31:17.29,0:31:18.66,Default,,0,0,0,,Жеу керек Ах...
Dialogue: 0,0:31:18.75,0:31:20.16,Default,,0,0,0,,Аку~!
Dialogue: 0,0:31:23.54,0:31:24.63,Default,,0,0,0,,Гуа~!
Dialogue: 0,0:31:24.71,0:31:26.59,Default,,0,0,0,,Ариса-чан! Ах...
Dialogue: 0,0:31:29.05,0:31:29.92,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:31:30.43,0:31:31.68,Default,,0,0,0,,Мана нұры
Dialogue: 0,0:31:31.76,0:31:34.05,Default,,0,0,0,,Енді Ақу Ақуды жерлейтін кез!
Dialogue: 0,0:31:36.68,0:31:37.60,Default,,0,0,0,,Аку?
Dialogue: 0,0:31:38.68,0:31:40.44,Default,,0,0,0,,Aku Aku~!
Dialogue: 0,0:31:42.19,0:31:43.81,Default,,0,0,0,,Ариса-чан!
Dialogue: 0,0:31:44.31,0:31:45.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:48.03,0:31:48.65,Default,,0,0,0,,Аку!
Dialogue: 0,0:31:48.74,0:31:51.03,Default,,0,0,0,,Не! Бұл мүлдем жұмыс істемейді!
Dialogue: 0,0:31:51.11,0:31:52.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:52.11,0:31:53.99,Default,,0,0,0,,Бұл Аку Аку тым үлкен
Dialogue: 0,0:31:54.07,0:31:56.62,Default,,0,0,0,,Бұл моайдың өзінде мана күші жеткіліксіз.
Dialogue: 0,0:31:56.70,0:31:57.91,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:31:57.99,0:31:58.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:58.66,0:31:59.58,Default,,0,0,0,,Aku Aku~!
Dialogue: 0,0:31:59.66,0:32:00.54,Default,,0,0,0,,Міне!
Dialogue: 0,0:32:01.12,0:32:01.71,Default,,0,0,0,,Гуа~!
Dialogue: 0,0:32:03.42,0:32:04.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:04.38,0:32:06.04,Default,,0,0,0,,Aqua~!
Dialogue: 0,0:32:07.21,0:32:09.59,Default,,0,0,0,,Гехо... Джеро Бұл не?
Dialogue: 0,0:32:11.93,0:32:12.59,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:32:14.76,0:32:17.18,Default,,0,0,0,,Сержант пен Гукиді тексеру!
Dialogue: 0,0:32:17.26,0:32:17.81,Default,,0,0,0,,Куруру
Dialogue: 0,0:32:18.31,0:32:21.35,Default,,0,0,0,,Бұл қара жігіт энергетикалық реакцияның орталығы ма?
Dialogue: 0,0:32:21.43,0:32:22.60,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:32:22.69,0:32:24.60,Default,,0,0,0,,Мен әлі бәрін шығарған жоқпын.
Dialogue: 0,0:32:24.69,0:32:27.19,Default,,0,0,0,,Бұл потенциалдық энергияның керемет мөлшері.
Dialogue: 0,0:32:27.27,0:32:29.44,Default,,0,0,0,,Жарайды, инверсия және тік түсу!
Dialogue: 0,0:32:29.53,0:32:31.69,Default,,0,0,0,,Тағы да шабуыл!
Dialogue: 0,0:32:35.32,0:32:36.82,Default,,0,0,0,,Не... бірдеңе келе жатыр!
Dialogue: 0,0:32:36.91,0:32:38.37,Default,,0,0,0,,Ақу~!
Dialogue: 0,0:32:40.12,0:32:43.04,Default,,0,0,0,,Күткендей, олар менің бағыныштыларым.
Dialogue: 0,0:32:43.75,0:32:45.46,Default,,0,0,0,,Бұл арман екеніне сенімдімін...
Dialogue: 0,0:32:46.67,0:32:47.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:52.84,0:32:54.38,Default,,0,0,0,,Сержант!
Dialogue: 0,0:32:54.47,0:32:55.97,Default,,0,0,0,,Аман-есен екеніңізге қуаныштымын.
Dialogue: 0,0:32:56.05,0:32:56.72,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:32:56.80,0:32:58.18,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:32:58.26,0:33:00.85,Default,,0,0,0,,Жоқ, мен жер астынан қашып құтылдым.
Dialogue: 0,0:33:00.93,0:33:01.89,Default,,0,0,0,,Құсу?
Dialogue: 0,0:33:01.98,0:33:03.43,Default,,0,0,0,,Мен қатысуды өшіре аламын ба, білмеймін.
Dialogue: 0,0:33:03.52,0:33:05.65,Default,,0,0,0,,Иә! Сіз қазірдің өзінде не істеп жатырсыз?
Dialogue: 0,0:33:05.73,0:33:06.81,Default,,0,0,0,,Барлығына Бонус жоқ!
Dialogue: 0,0:33:06.90,0:33:07.56,Default,,0,0,0,,Кітаптар туралы айту
Dialogue: 0,0:33:07.65,0:33:09.02,Default,,0,0,0,,Барлығы өз еркіңізде...
Dialogue: 0,0:33:09.11,0:33:10.44,Default,,0,0,0,,-Ой! -иә?
Dialogue: 0,0:33:10.53,0:33:12.19,Default,,0,0,0,,Кейне өсті
Dialogue: 0,0:33:12.28,0:33:14.36,Default,,0,0,0,,Аранжировка жасаған Кайнена!
Dialogue: 0,0:33:14.45,0:33:16.36,Default,,0,0,0,,Бұл балалар кімдер?
Dialogue: 0,0:33:16.45,0:33:17.70,Default,,0,0,0,,Io
Dialogue: 0,0:33:17.78,0:33:18.74,Default,,0,0,0,,Лана
Dialogue: 0,0:33:19.53,0:33:20.37,Default,,0,0,0,,Иолана!
Dialogue: 0,0:33:20.45,0:33:21.54,Default,,0,0,0,,Иолана…
Dialogue: 0,0:33:21.62,0:33:24.41,Default,,0,0,0,,Сіз бізді Кайнена деп атайтынсыз...
Dialogue: 0,0:33:24.50,0:33:27.25,Default,,0,0,0,,Мен... Жарайды, жарайды, кейін сөйлесемін.
Dialogue: 0,0:33:27.33,0:33:28.21,Default,,0,0,0,,Аспаз ~
Dialogue: 0,0:33:28.29,0:33:31.09,Default,,0,0,0,,Қайта келгенде маңызды емес.
Dialogue: 0,0:33:31.17,0:33:32.09,Default,,0,0,0,,Сол құбыжық
Dialogue: 0,0:33:32.17,0:33:32.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:32.76,0:33:33.92,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:33:34.01,0:33:36.59,Default,,0,0,0,,Мұның бәрі N-2 бомбаларымен бірге...
Dialogue: 0,0:33:36.68,0:33:37.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:33:39.39,0:33:39.89,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:33:40.47,0:33:41.31,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:33:41.39,0:33:42.81,Default,,0,0,0,,Ио-кун, сен не істеп жатырсың?
Dialogue: 0,0:33:42.89,0:33:43.81,Default,,0,0,0,,О...
Dialogue: 0,0:33:43.89,0:33:44.85,Default,,0,0,0,,Барлығың жүгіріңдер!
Dialogue: 0,0:33:44.93,0:33:46.27,Default,,0,0,0,,Aku Aku Төменде!
Dialogue: 0,0:33:46.35,0:33:48.27,Default,,0,0,0,,-Аку~! -Апыр-ай!
Dialogue: 0,0:33:48.77,0:33:49.27,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:33:49.36,0:33:50.82,Default,,0,0,0,,Аку Аку~
Dialogue: 0,0:33:50.90,0:33:52.82,Default,,0,0,0,,Әй, бұл мен үшін бе?
Dialogue: 0,0:33:53.32,0:33:54.28,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:33:54.36,0:33:55.82,Default,,0,0,0,,Екінші тарап осында!
Dialogue: 0,0:33:55.90,0:33:57.41,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,0:33:57.49,0:33:58.87,Default,,0,0,0,,Aqua~!
Dialogue: 0,0:33:58.95,0:33:59.91,Default,,0,0,0,,Не!
Dialogue: 0,0:33:59.99,0:34:01.78,Default,,0,0,0,,Kururu Beam!
Dialogue: 0,0:34:01.87,0:34:04.87,Default,,0,0,0,,Аммммммммм…
Dialogue: 0,0:34:04.95,0:34:05.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:07.21,0:34:08.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:08.17,0:34:10.46,Default,,0,0,0,,Мама…
Dialogue: 0,0:34:10.54,0:34:12.09,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:34:12.59,0:34:14.01,Default,,0,0,0,,Карри дәмі?
Dialogue: 0,0:34:15.38,0:34:17.13,Default,,0,0,0,,– деді Джосукэ Хигасиката. Гү…
Dialogue: 0,0:34:17.22,0:34:20.47,Default,,0,0,0,,Ку…ку… Сержант Крул~!
Dialogue: 0,0:34:20.55,0:34:21.60,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:34:21.68,0:34:22.43,Default,,0,0,0,,Гах...
Dialogue: 0,0:34:23.51,0:34:24.81,Default,,0,0,0,,- Куруру! -Аа...
Dialogue: 0,0:34:26.23,0:34:28.35,Default,,0,0,0,,Куруру! Аман болдың ба?
Dialogue: 0,0:34:28.44,0:34:29.48,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:34:29.56,0:34:30.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:30.19,0:34:34.23,Default,,0,0,0,,Сізді алаңдатқанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:34:34.32,0:34:35.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:35.15,0:34:37.49,Default,,0,0,0,,Бұл қауіпсіз емес сияқты!
Dialogue: 0,0:34:37.57,0:34:38.32,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:34:38.40,0:34:39.61,Default,,0,0,0,,- Барлығына қараңдар! -Иә?
Dialogue: 0,0:34:39.70,0:34:41.16,Default,,0,0,0,,Aku Aku...
Dialogue: 0,0:34:42.07,0:34:43.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:47.83,0:34:49.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:55.96,0:34:57.47,Default,,0,0,0,,Aku Aku~!
Dialogue: 0,0:34:57.55,0:34:58.55,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:34:58.63,0:34:59.63,Default,,0,0,0,,Сіз керондықсыз ба?
Dialogue: 0,0:35:00.22,0:35:01.59,Default,,0,0,0,,Куккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:35:01.68,0:35:03.64,Default,,0,0,0,,Сіз осылай күлдіңіз бе?
Dialogue: 0,0:35:03.72,0:35:05.35,Default,,0,0,0,,Тынш... мен үндемедім!
Dialogue: 0,0:35:05.43,0:35:07.52,Default,,0,0,0,,Сол сары жігіттің даналығы мен білімі
Dialogue: 0,0:35:07.60,0:35:08.60,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:35:08.68,0:35:09.35,Default,,0,0,0,,Охохо…
Dialogue: 0,0:35:09.44,0:35:12.48,Default,,0,0,0,,Енді сіз бұдан да таңғажайып пранктерді жасай аласыз.
Dialogue: 0,0:35:12.56,0:35:14.90,Default,,0,0,0,,Аку Аку өте сараң
Dialogue: 0,0:35:14.98,0:35:18.74,Default,,0,0,0,,Сондықтан мен өзім сияқты еркенің күшін алдым.
Dialogue: 0,0:35:18.82,0:35:21.36,Default,,0,0,0,,Менің киімім өте әлсіз
Dialogue: 0,0:35:21.45,0:35:22.70,Default,,0,0,0,,Кешірім сұраймыз...
Dialogue: 0,0:35:22.78,0:35:23.70,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:35:23.78,0:35:26.24,Default,,0,0,0,,Қарғыс атсын... Мен бәрібір блеф жасап жатырмын!
Dialogue: 0,0:35:26.33,0:35:27.50,Default,,0,0,0,,Жасайық, Дороро!
Dialogue: 0,0:35:27.58,0:35:28.16,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:35:28.25,0:35:29.83,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:35:31.42,0:35:33.04,Default,,0,0,0,,Бос орын бар! Нөлдік өлшемді қиғаш сызық!
Dialogue: 0,0:35:35.13,0:35:35.92,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:35:36.00,0:35:36.67,Default,,0,0,0,,Бұл болар ма…
Dialogue: 0,0:35:36.75,0:35:39.17,Default,,0,0,0,,Доророның нөлдік өлшемді қиғаш сызық оқылды ма?
Dialogue: 0,0:35:40.01,0:35:41.68,Default,,0,0,0,,Уау! Гуха…
Dialogue: 0,0:35:41.76,0:35:43.30,Default,,0,0,0,,Ах... Арх!
Dialogue: 0,0:35:43.39,0:35:44.35,Default,,0,0,0,,Гррр…
Dialogue: 0,0:35:44.43,0:35:47.43,Default,,0,0,0,,Хмф... Мен келесі қарсыласпын!
Dialogue: 0,0:35:47.52,0:35:48.06,Default,,0,0,0,,Тамама!
Dialogue: 0,0:35:49.18,0:35:51.19,Default,,0,0,0,,Барма! Сіз де...
Dialogue: 0,0:35:51.27,0:35:53.06,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:35:53.15,0:35:54.06,Default,,0,0,0,,О!
Dialogue: 0,0:35:54.65,0:35:55.52,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:35:56.02,0:36:00.57,Default,,0,0,0,,Бұл... шынайы тропикалық грильдегі банан!
Dialogue: 0,0:36:01.65,0:36:03.36,Default,,0,0,0,,Мм, тәтті, тым тәтті
Dialogue: 0,0:36:03.45,0:36:05.03,Default,,0,0,0,,Әму Әму Әму…
Dialogue: 0,0:36:05.12,0:36:06.33,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:36:07.45,0:36:08.45,Default,,0,0,0,,Хмм!
Dialogue: 0,0:36:08.95,0:36:09.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:10.33,0:36:11.04,Default,,0,0,0,,Балалар...
Dialogue: 0,0:36:11.12,0:36:12.79,Default,,0,0,0,,Тіпті біздің әлсіз тұстарымызға да
Dialogue: 0,0:36:12.87,0:36:14.58,Default,,0,0,0,,Куруру білімі ретінде сіңеді
Dialogue: 0,0:36:15.25,0:36:17.88,Default,,0,0,0,,Ал енді Тамаманың қабілетіне тоқталсақ...
Dialogue: 0,0:36:17.96,0:36:18.50,Default,,0,0,0,,Поо!
Dialogue: 0,0:36:18.59,0:36:20.38,Default,,0,0,0,,Хаффхохе…
Dialogue: 0,0:36:20.46,0:36:24.22,Default,,0,0,0,,Ух... өшпенділік пен реніштен ештеңе шықпайды.
Dialogue: 0,0:36:24.30,0:36:25.97,Default,,0,0,0,,Енді қызғаныш болмайды
Dialogue: 0,0:36:26.05,0:36:27.56,Default,,0,0,0,,Пома...
Dialogue: 0,0:36:28.06,0:36:29.39,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:36:29.89,0:36:30.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:30.52,0:36:34.02,Default,,0,0,0,,Хахаха Ахахха... Ия!
Dialogue: 0,0:36:38.65,0:36:40.53,Default,,0,0,0,,～
Dialogue: 0,0:36:41.11,0:36:43.53,Default,,0,0,0,,Қарғыс атсын... қандай ебедейсіз еліктеу...
Dialogue: 0,0:36:43.61,0:36:44.57,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:36:44.66,0:36:46.20,Default,,0,0,0,,Барлығы төмен түсуі керек.
Dialogue: 0,0:36:46.28,0:36:46.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:46.87,0:36:48.12,Default,,0,0,0,,Мұны маған қалдырыңыз
Dialogue: 0,0:36:49.16,0:36:51.75,Default,,0,0,0,,Куруру-доно мен Тамама-дононы қауіпсіз жерге апарыңыз.
Dialogue: 0,0:36:51.83,0:36:53.87,Default,,0,0,0,,Ха... Сіз, мүмкін емес...
Dialogue: 0,0:36:53.96,0:36:54.58,Default,,0,0,0,,Құсу?
Dialogue: 0,0:36:55.08,0:36:57.21,Default,,0,0,0,,Түсіндім, мен саған қалдырамын, Дороро.
Dialogue: 0,0:36:57.29,0:36:57.96,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:36:58.54,0:36:59.59,Default,,0,0,0,,Сәлем Джироро!
Dialogue: 0,0:36:59.67,0:37:01.46,Default,,0,0,0,,Барлық қызметкерлер көлік ұшағына эвакуациялансын!
Dialogue: 0,0:37:01.55,0:37:04.63,Default,,0,0,0,,Aku Aku… Әсер!
Dialogue: 0,0:37:10.39,0:37:11.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:37:12.06,0:37:13.31,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:37:14.19,0:37:15.44,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:37:15.52,0:37:16.77,Default,,0,0,0,,Хмм... хе!
Dialogue: 0,0:37:21.90,0:37:22.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:22.61,0:37:24.07,Default,,0,0,0,,Хахаха хаха...
Dialogue: 0,0:37:24.74,0:37:25.82,Default,,0,0,0,,Тезірек кіріңіз!
Dialogue: 0,0:37:26.74,0:37:29.28,Default,,0,0,0,,Асығыңыз! Жүр, асығыңыз!
Dialogue: 0,0:37:29.37,0:37:32.29,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:37:32.37,0:37:33.08,Default,,0,0,0,,Керемет!
Dialogue: 0,0:37:33.16,0:37:34.29,Default,,0,0,0,,-Сен қайда қарап тұрсың? -иә?
Dialogue: 0,0:37:34.37,0:37:37.12,Default,,0,0,0,,Мені төмен бағаласаң, өкінесің!
Dialogue: 0,0:37:38.17,0:37:39.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:37:39.84,0:37:43.46,Default,,0,0,0,,Керемет... Қандай еркелік!
Dialogue: 0,0:37:45.09,0:37:47.47,Default,,0,0,0,,Oboro Split Slash!
Dialogue: 0,0:37:47.55,0:37:50.14,Default,,0,0,0,,Andromeda Impact~!
Dialogue: 0,0:37:56.14,0:37:57.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:58.94,0:37:59.69,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:37:59.77,0:38:02.57,Default,,0,0,0,,Бұл еркелік болса, бұл ең жақсы болды.
Dialogue: 0,0:38:02.65,0:38:06.57,Default,,0,0,0,,Олай болса, сенің күшің маған болсын!
Dialogue: 0,0:38:07.07,0:38:08.45,Default,,0,0,0,,Не?
Dialogue: 0,0:38:09.45,0:38:10.49,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:38:11.74,0:38:12.62,Default,,0,0,0,,Дороро!
Dialogue: 0,0:38:13.54,0:38:14.91,Default,,0,0,0,,Тез секір!
Dialogue: 0,0:38:15.00,0:38:16.50,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:38:16.58,0:38:17.16,Default,,0,0,0,,О...
Dialogue: 0,0:38:17.25,0:38:19.67,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:38:20.25,0:38:21.67,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:38:22.17,0:38:25.34,Default,,0,0,0,,Тіпті Доророның жын стилі де сәйкес келмейді...
Dialogue: 0,0:38:25.42,0:38:26.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:26.67,0:38:28.38,Default,,0,0,0,,Нгга Ана…
Dialogue: 0,0:38:31.85,0:38:33.60,Default,,0,0,0,,Маған бәрібір...
Dialogue: 0,0:38:34.10,0:38:35.10,Default,,0,0,0,,Не... бірдеңе?
Dialogue: 0,0:38:35.18,0:38:37.10,Default,,0,0,0,,Дороро бұрынғыдай болып көрінеді.
Dialogue: 0,0:38:37.18,0:38:37.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:39.27,0:38:42.06,Default,,0,0,0,,Хэхехе... Тамақ бергеніңізге рахмет.
Dialogue: 0,0:38:42.57,0:38:43.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:38:44.44,0:38:46.32,Default,,0,0,0,,Кероро, бақылауды қолға ал
Dialogue: 0,0:38:46.40,0:38:48.24,Default,,0,0,0,,Құсу! Жер бетінде не ...
Dialogue: 0,0:38:48.74,0:38:49.41,Default,,0,0,0,,Әй, Жироро!
Dialogue: 0,0:38:50.61,0:38:52.32,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:38:52.41,0:38:53.74,Default,,0,0,0,,Күте тұрыңыз, ефрейтор Жироро!
Dialogue: 0,0:38:54.41,0:38:55.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:38:55.45,0:38:58.66,Default,,0,0,0,,Осылай жалғаса берсе, бәрі мен көрген түсімдей болады...
Dialogue: 0,0:38:59.17,0:39:00.92,Default,,0,0,0,,Мен бұрын айтқанымдай,
Dialogue: 0,0:39:01.00,0:39:03.17,Default,,0,0,0,,Бұл арман не туралы?
Dialogue: 0,0:39:03.67,0:39:04.59,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:39:05.17,0:39:07.09,Default,,0,0,0,,Куруру мен Тамаманы ұрып-соғу
Dialogue: 0,0:39:07.17,0:39:10.47,Default,,0,0,0,,Сосын Дороро мен Жиророға... сержантқа.
Dialogue: 0,0:39:10.55,0:39:12.18,Default,,0,0,0,,Мен... Мен де?
Dialogue: 0,0:39:12.26,0:39:12.85,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:39:12.93,0:39:15.43,Default,,0,0,0,,Тезірек жүр, Кероро-кун.
Dialogue: 0,0:39:15.51,0:39:16.97,Default,,0,0,0,,Немесе... сүйкімді
Dialogue: 0,0:39:23.56,0:39:26.57,Default,,0,0,0,,Гироро Кероро Робо Мк (Марк)-III (Үш) шығады!
Dialogue: 0,0:39:31.16,0:39:33.95,Default,,0,0,0,,Бұл жолы темір қуыршақ па... Қызық
Dialogue: 0,0:39:41.71,0:39:42.25,Default,,0,0,0,,Тс!
Dialogue: 0,0:39:43.29,0:39:44.21,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:39:50.76,0:39:52.64,Default,,0,0,0,,Барған сайын қызықты!
Dialogue: 0,0:39:57.31,0:39:58.93,Default,,0,0,0,,Мен Жироны қолдаймын.
Dialogue: 0,0:39:59.02,0:39:59.52,Default,,0,0,0,,Құсу?
Dialogue: 0,0:40:00.43,0:40:01.10,Default,,0,0,0,,Хмф, сағ!
Dialogue: 0,0:40:01.19,0:40:02.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:05.06,0:40:06.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:07.07,0:40:08.86,Default,,0,0,0,,Кероро! Ха…
Dialogue: 0,0:40:11.90,0:40:12.86,Default,,0,0,0,,Гуах...
Dialogue: 0,0:40:12.95,0:40:14.45,Default,,0,0,0,,- Құсу~! -(Фуюки) Уау!
Dialogue: 0,0:40:16.28,0:40:16.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:31.01,0:40:32.09,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:40:32.17,0:40:33.18,Default,,0,0,0,,О?
Dialogue: 0,0:40:33.26,0:40:36.26,Default,,0,0,0,,Бұл керемет, сержант! Сіз одан жақсы құтылдыңыз.
Dialogue: 0,0:40:36.35,0:40:36.93,Default,,0,0,0,,Лана…
Dialogue: 0,0:40:37.01,0:40:37.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:37.89,0:40:39.56,Default,,0,0,0,,(Жануарлар дүкенінің сатушысы) Хмм… Таныс итті өсірушімнен сұрайын ба?
Dialogue: 0,0:40:40.06,0:40:42.39,Default,,0,0,0,,Бұл қуатты тым көп пайдаланбаңыз!
Dialogue: 0,0:40:42.48,0:40:44.40,Default,,0,0,0,,Лана-чан, не болды?
Dialogue: 0,0:40:44.48,0:40:45.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:47.57,0:40:48.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:48.77,0:40:50.73,Default,,0,0,0,,Егер бұл орын алса, жерге құлаудан басқа амал қалмайды!
Dialogue: 0,0:40:55.49,0:40:57.07,Default,,0,0,0,,Бұл өте қыңыр.
Dialogue: 0,0:40:57.58,0:40:59.49,Default,,0,0,0,,Бірақ бәрі осы!
Dialogue: 0,0:40:59.58,0:41:01.75,Default,,0,0,0,,Уа... мынау... бұл не?
Dialogue: 0,0:41:08.46,0:41:10.34,Default,,0,0,0,,Мен де сені сорамын!
Dialogue: 0,0:41:10.42,0:41:11.96,Default,,0,0,0,,Жарайды, қазір!
Dialogue: 0,0:41:16.64,0:41:17.72,Default,,0,0,0,,Не! Гррр...
Dialogue: 0,0:41:17.80,0:41:19.93,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:41:22.85,0:41:23.73,Default,,0,0,0,,Рано Рараку.
Dialogue: 0,0:41:25.69,0:41:28.02,Default,,0,0,0,,Мен мұны білмей тұрып, осы деңгейге жеттім ...
Dialogue: 0,0:41:29.32,0:41:31.57,Default,,0,0,0,,Мынау Жироро жігіті не істеп жүр?
Dialogue: 0,0:41:41.87,0:41:45.58,Default,,0,0,0,,Қанша болсаң да, етің магмаға төтеп бере алмайды!
Dialogue: 0,0:41:45.66,0:41:46.17,Default,,0,0,0,,Әй?
Dialogue: 0,0:41:46.25,0:41:48.75,Default,,0,0,0,,Енді бұл туралы не деуге болады?
Dialogue: 0,0:41:54.13,0:41:54.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:58.80,0:42:00.30,Default,,0,0,0,,Құсу! Міне бітті!
Dialogue: 0,0:42:00.39,0:42:01.18,Default,,0,0,0,,Жиро...
Dialogue: 0,0:42:01.68,0:42:02.43,Default,,0,0,0,,- (Фуюки) Иә? -Аа...
Dialogue: 0,0:42:12.27,0:42:13.78,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:13.86,0:42:15.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:16.07,0:42:18.11,Default,,0,0,0,,Мені артымда қалдырмаңыз
Dialogue: 0,0:42:18.20,0:42:20.91,Default,,0,0,0,,Ой... балалар, ұшақта күтулерің керек...
Dialogue: 0,0:42:20.99,0:42:21.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:21.58,0:42:24.91,Default,,0,0,0,,Гя~ хахахаха
Dialogue: 0,0:42:25.58,0:42:30.29,Default,,0,0,0,,Біз жақсы соғыстық, бірақ сен менің жауым болмаған сияқтысың.
Dialogue: 0,0:42:30.38,0:42:30.92,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:42:31.00,0:42:31.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:31.79,0:42:34.30,Default,,0,0,0,,(Дороро және басқалары ренжіді)
Dialogue: 0,0:42:34.38,0:42:35.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:35.13,0:42:36.22,Default,,0,0,0,,Гррр…
Dialogue: 0,0:42:36.30,0:42:39.39,Default,,0,0,0,,Нацуми... Мені осылай жазалаңызшы.
Dialogue: 0,0:42:39.47,0:42:41.10,Default,,0,0,0,,Соңында, Джиророға дейін...
Dialogue: 0,0:42:41.18,0:42:43.85,Default,,0,0,0,,Қуат... Қуат асып кетеді.
Dialogue: 0,0:42:47.18,0:42:48.60,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:42:48.69,0:42:52.61,Default,,0,0,0,,Менде қазір бар күштің арқасында мен керемет еркелік жасай аламын деп ойлаймын.
Dialogue: 0,0:42:52.69,0:42:54.32,Default,,0,0,0,,Әзірге ешкім байқамаған сияқты
Dialogue: 0,0:42:54.40,0:42:55.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:55.57,0:42:59.28,Default,,0,0,0,,Сайып келгенде, менде капитан ретінде... қабілетім бар.
Dialogue: 0,0:43:00.61,0:43:01.20,Default,,0,0,0,,Е...
Dialogue: 0,0:43:01.28,0:43:03.37,Default,,0,0,0,,Менің ойымда сержант жоқ деп ойлаймын.
Dialogue: 0,0:43:03.45,0:43:05.66,Default,,0,0,0,,Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:43:05.74,0:43:07.16,Default,,0,0,0,,-Мүлдем жақсы емес-(Фуюки) Иә?
Dialogue: 0,0:43:07.75,0:43:09.50,Default,,0,0,0,,Акуаку Курано Рараку кетті
Dialogue: 0,0:43:09.58,0:43:12.21,Default,,0,0,0,,Мен оның үлкен еркелік жасайтынына сенімдімін.
Dialogue: 0,0:43:12.29,0:43:12.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:21.51,0:43:24.97,Default,,0,0,0,,Қараның күші мен қызылдың құмарлығы
Dialogue: 0,0:43:25.06,0:43:26.35,Default,,0,0,0,,Көк жігіттің техникасы
Dialogue: 0,0:43:26.43,0:43:30.44,Default,,0,0,0,,Ал енді менде сары жігіттің даналығы бар
Dialogue: 0,0:43:30.52,0:43:32.69,Default,,0,0,0,,Бір ғана нәрсе істеу керек
Dialogue: 0,0:43:32.77,0:43:36.44,Default,,0,0,0,,Ең керемет еркелік... басып кіру.
Dialogue: 0,0:43:42.32,0:43:44.16,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:44:00.97,0:44:02.84,Default,,0,0,0,,Қандай керемет еркелік...
Dialogue: 0,0:44:02.93,0:44:04.18,Default,,0,0,0,,О...
Dialogue: 0,0:44:04.76,0:44:06.35,Default,,0,0,0,,-Ағатай - Лорд Тағы
Dialogue: 0,0:44:06.43,0:44:09.60,Default,,0,0,0,,Кешіріңіз, мен Пасха аралында болдым...
Dialogue: 0,0:44:09.68,0:44:11.19,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:44:11.27,0:44:13.56,Default,,0,0,0,,А... одан да, мен мұны қазір ғана жасадым.
Dialogue: 0,0:44:13.65,0:44:17.40,Default,,0,0,0,,Пекопонның геостационарлық орбитасында сингулярлық реакция расталды...
Dialogue: 0,0:44:17.48,0:44:19.15,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:44:19.23,0:44:21.03,Default,,0,0,0,,Кеңістіктегі жарықшақ
Dialogue: 0,0:44:21.11,0:44:24.41,Default,,0,0,0,,Ол Пекопонды қоршау үшін тез кеңейіп жатыр.
Dialogue: 0,0:44:24.49,0:44:25.62,Default,,0,0,0,,-Ах! - (Фуюки және т.б.) Иә!
Dialogue: 0,0:44:25.70,0:44:28.62,Default,,0,0,0,,Сонымен... Сол жарықшақтан сансыз жұмбақ заттар...
Dialogue: 0,0:44:28.70,0:44:31.00,Default,,0,0,0,,Бұл паранормальдық құбылыс па?
Dialogue: 0,0:44:35.13,0:44:36.34,Default,,0,0,0,,Мырзалар көбірек!
Dialogue: 0,0:44:36.42,0:44:37.88,Default,,0,0,0,,Жұмбақ заттың мәні неде?
Dialogue: 0,0:44:37.96,0:44:40.09,Default,,0,0,0,,Құсу?
Dialogue: 0,0:44:40.96,0:44:41.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:45.22,0:44:46.55,Default,,0,0,0,,Мо... Моай?
Dialogue: 0,0:44:47.26,0:44:50.14,Default,,0,0,0,,Құсу! Мен тез қашып кетемін
Dialogue: 0,0:44:51.06,0:44:52.43,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:44:52.52,0:44:53.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:54.23,0:44:55.19,Default,,0,0,0,,Хехе...
Dialogue: 0,0:44:55.69,0:44:58.90,Default,,0,0,0,,Бұл жұлдыз қоқысынан жасалған тас мүсін.
Dialogue: 0,0:44:58.98,0:45:00.94,Default,,0,0,0,,Көріп отырғаныңыздай, жойқын күш
Dialogue: 0,0:45:01.03,0:45:03.61,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:45:03.70,0:45:05.53,Default,,0,0,0,,Барлығы қазір басталады
Dialogue: 0,0:45:05.61,0:45:08.24,Default,,0,0,0,,Мен сізден оны соңына дейін көруіңізді сұраймын.
Dialogue: 0,0:45:08.33,0:45:10.37,Default,,0,0,0,,Бұл менің ең керемет еркелігім...
Dialogue: 0,0:45:10.87,0:45:13.08,Default,,0,0,0,,Басқаша айтқанда, Пекопон шапқыншылығы!
Dialogue: 0,0:45:13.16,0:45:14.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:14.67,0:45:16.92,Default,,0,0,0,,Осы аралдағы тас мүсіндерден бастаңыз.
Dialogue: 0,0:45:17.00,0:45:19.59,Default,,0,0,0,,Мен соңғысын талқандаймын!
Dialogue: 0,0:45:19.67,0:45:20.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:22.92,0:45:27.09,Default,,0,0,0,,Бұл... Бұлай етпе! Бұлай істеме!
Dialogue: 0,0:45:28.39,0:45:29.01,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:29.10,0:45:30.76,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:45:30.85,0:45:31.85,Default,,0,0,0,,Нану?
Dialogue: 0,0:45:42.90,0:45:43.74,Default,,0,0,0,,Құсу…
Dialogue: 0,0:45:43.82,0:45:47.91,Default,,0,0,0,,Ол... жоғалып кетті.
Dialogue: 0,0:45:56.50,0:45:59.54,Default,,0,0,0,,Бұл... Фуюки-доно көрген түс осы ма?
Dialogue: 0,0:45:59.63,0:46:01.88,Default,,0,0,0,,Иә, бұл сөзсіз шындық.
Dialogue: 0,0:46:01.96,0:46:03.46,Default,,0,0,0,,Рахмет Куруру
Dialogue: 0,0:46:03.55,0:46:04.72,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз!
Dialogue: 0,0:46:04.80,0:46:05.84,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:46:05.92,0:46:07.55,Default,,0,0,0,,Өйткені, бұл арман
Dialogue: 0,0:46:07.63,0:46:10.85,Default,,0,0,0,,Бұл моай маған болашақтың пейзажын көрсетті.
Dialogue: 0,0:46:11.47,0:46:13.68,Default,,0,0,0,,Ақу Ақудың қайта тірілгені туралы
Dialogue: 0,0:46:14.18,0:46:15.81,Default,,0,0,0,,Болғалы тұрған үлкен істер
Dialogue: 0,0:46:15.89,0:46:17.52,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:46:17.60,0:46:20.77,Default,,0,0,0,,Манаға ұнағандар Мананың пішінін көре алады.
Dialogue: 0,0:46:20.86,0:46:22.19,Default,,0,0,0,,Мен тіпті мананың түстерін де көремін
Dialogue: 0,0:46:22.27,0:46:24.36,Default,,0,0,0,,Сол моайда тұратын мана сөзсіз
Dialogue: 0,0:46:24.44,0:46:25.78,Default,,0,0,0,,Мен Фуюкиді жақсы көремін
Dialogue: 0,0:46:25.86,0:46:27.70,Default,,0,0,0,,Иә, мен оны өте жақсы көремін!
Dialogue: 0,0:46:28.32,0:46:30.91,Default,,0,0,0,,Бірақ бұл жолы Ақу Ақу өте күшті.
Dialogue: 0,0:46:30.99,0:46:31.74,Default,,0,0,0,,…
Dialogue: 0,0:46:31.83,0:46:34.54,Default,,0,0,0,,Жаңбыр басылғанда, Ақу Ақу қайтадан дүбірлей бастайды.
Dialogue: 0,0:46:34.62,0:46:37.54,Default,,0,0,0,,Жаңбырдың тоқтауы нені білдіреді?
Dialogue: 0,0:46:37.62,0:46:39.58,Default,,0,0,0,,Аку Аку Мен суды ұнатпаймын.
Dialogue: 0,0:46:39.67,0:46:41.79,Default,,0,0,0,,Мен адамдарды бақытты ететін нәрселерді жек көремін.
Dialogue: 0,0:46:41.88,0:46:43.34,Default,,0,0,0,,Сондықтан мен қазір қозғала алмаймын.
Dialogue: 0,0:46:43.42,0:46:46.38,Default,,0,0,0,,Егер солай болса, мен әлгі бейбаққа су беремін...
Dialogue: 0,0:46:46.47,0:46:48.22,Default,,0,0,0,,Жоқ, мен оны жек көремін.
Dialogue: 0,0:46:48.30,0:46:49.38,Default,,0,0,0,,Сумен жеңілу мүмкін емес
Dialogue: 0,0:46:50.47,0:46:52.51,Default,,0,0,0,,Оны таңбалаудың жалғыз жолы - мана күші.
Dialogue: 0,0:46:52.60,0:46:54.93,Default,,0,0,0,,Бірақ герметикалық шам да жұмыс істемеді.
Dialogue: 0,0:46:55.02,0:46:56.89,Default,,0,0,0,,Сонда мен не істеуім керек...
Dialogue: 0,0:46:56.98,0:46:58.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:03.40,0:47:04.90,Default,,0,0,0,,-Нуха~ -Ханя~
Dialogue: 0,0:47:04.98,0:47:06.24,Default,,0,0,0,,Ахахе
Dialogue: 0,0:47:13.66,0:47:15.62,Default,,0,0,0,,Мен жай ғана баламын
Dialogue: 0,0:47:16.16,0:47:18.41,Default,,0,0,0,,Бұл аралды құтқаратын күш жоқ.
Dialogue: 0,0:47:19.41,0:47:20.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:21.50,0:47:22.67,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:47:22.75,0:47:25.13,Default,,0,0,0,,Бізде, Кероро взводында, мұны істеуден басқа амал жоқ!
Dialogue: 0,0:47:25.21,0:47:27.34,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:47:27.84,0:47:28.76,Default,,0,0,0,,Құсу…
Dialogue: 0,0:47:28.84,0:47:31.18,Default,,0,0,0,,Ей, бәріміз, біз осында сияқты әрекет етейік!
Dialogue: 0,0:47:31.26,0:47:32.72,Default,,0,0,0,,Мұны қазір жасамаңыз. Қашан жасайсың?
Dialogue: 0,0:47:32.80,0:47:36.14,Default,,0,0,0,,Сержант-сан, жарайды, өйткені сен ғана жақсысың.
Dialogue: 0,0:47:36.22,0:47:37.18,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:47:37.27,0:47:39.69,Default,,0,0,0,,Құпия база қауіпсіз болса...
Dialogue: 0,0:47:39.77,0:47:42.27,Default,,0,0,0,,Әйтеуір, басында осылай сөйлестік.
Dialogue: 0,0:47:42.35,0:47:43.69,Default,,0,0,0,,Сүт қышқылы да түзілмейді.
Dialogue: 0,0:47:43.77,0:47:44.65,Default,,0,0,0,,Ахе~
Dialogue: 0,0:47:44.73,0:47:47.32,Default,,0,0,0,,Неліктен осы аралда өмір сүруді жалғастырмайсың?
Dialogue: 0,0:47:47.40,0:47:48.28,Default,,0,0,0,,Керемет идея емес.
Dialogue: 0,0:47:48.36,0:47:50.95,Default,,0,0,0,,Мен бәрібір оған үйлене алмаймын.
Dialogue: 0,0:47:51.03,0:47:53.41,Default,,0,0,0,,Vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit vomit
Dialogue: 0,0:47:53.49,0:47:56.41,Default,,0,0,0,,құсу құсу құсу құсу құсу құсу құсу...
Dialogue: 0,0:47:58.50,0:48:00.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:06.96,0:48:07.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:08.17,0:48:09.72,Default,,0,0,0,,Кейне керемет
Dialogue: 0,0:48:11.17,0:48:12.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:48:13.68,0:48:14.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:15.30,0:48:17.14,Default,,0,0,0,,Сержанттар резонансы?
Dialogue: 0,0:48:21.52,0:48:22.44,Default,,0,0,0,,Мен мұны істеуге дайынмын.
Dialogue: 0,0:48:23.02,0:48:25.06,Default,,0,0,0,,Бар күшім дерлік таусылған болса да
Dialogue: 0,0:48:25.15,0:48:29.23,Default,,0,0,0,,Жүрегімізде лаулаған Керондық әскери рухты сөндіру мүмкін емес.
Dialogue: 0,0:48:29.74,0:48:31.45,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:48:31.53,0:48:32.82,Default,,0,0,0,,Сержант мырза!
Dialogue: 0,0:48:32.90,0:48:35.20,Default,,0,0,0,,Мен ояндым.
Dialogue: 0,0:48:35.28,0:48:38.16,Default,,0,0,0,,Мұны айтқанда капитан да айтады.
Dialogue: 0,0:48:38.24,0:48:39.83,Default,,0,0,0,,- (Ио Лана) О! -иә?
Dialogue: 0,0:48:39.91,0:48:42.21,Default,,0,0,0,,Күткендей, Кайнена керемет!
Dialogue: 0,0:48:42.29,0:48:44.04,Default,,0,0,0,,Кайнена керемет!
Dialogue: 0,0:48:44.12,0:48:44.88,Default,,0,0,0,,Гелори!
Dialogue: 0,0:48:44.96,0:48:47.09,Default,,0,0,0,,Капитан ретінде бұл табиғи нәрсе.
Dialogue: 0,0:48:47.17,0:48:48.42,Default,,0,0,0,,Бірақ Кероро
Dialogue: 0,0:48:48.92,0:48:51.97,Default,,0,0,0,,Бұл біздің әлсіреп бара жатқанымызды өзгертпейді.
Dialogue: 0,0:48:52.05,0:48:55.72,Default,,0,0,0,,Ендеше, мұндай нәрсе тек ішегі бар жамылғы.
Dialogue: 0,0:48:55.80,0:48:56.93,Default,,0,0,0,,На Тамама!
Dialogue: 0,0:48:57.01,0:48:58.06,Default,,0,0,0,,-Хара~ -Хоро~
Dialogue: 0,0:48:58.14,0:48:59.01,Default,,0,0,0,,-Фин~ -Жақсы~
Dialogue: 0,0:48:59.10,0:49:00.14,Default,,0,0,0,,Әй, өте сүйкімді
Dialogue: 0,0:49:01.10,0:49:01.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:02.48,0:49:05.44,Default,,0,0,0,,Сержанттар қайтып келді.
Dialogue: 0,0:49:05.52,0:49:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:11.99,0:49:13.20,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:49:25.46,0:49:26.83,Default,,0,0,0,,Қайырлы таң, сержант.
Dialogue: 0,0:49:27.33,0:49:28.34,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:49:28.42,0:49:30.13,Default,,0,0,0,,Ұйқыңыз келді ме?
Dialogue: 0,0:49:30.21,0:49:31.05,Default,,0,0,0,,Иә
Dialogue: 0,0:49:31.13,0:49:32.76,Default,,0,0,0,,Жаңбыр толығымен тоқтады.
Dialogue: 0,0:49:32.84,0:49:35.26,Default,,0,0,0,,Сосын шайқастың уақыты келді.
Dialogue: 0,0:49:35.34,0:49:37.39,Default,,0,0,0,,Иә, мен дайынмын.
Dialogue: 0,0:49:38.14,0:49:41.22,Default,,0,0,0,,Бірақ сіз тамаша стратегия ойлап таптыңыз.
Dialogue: 0,0:49:41.31,0:49:42.06,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:49:42.64,0:49:45.19,Default,,0,0,0,,Сол тауда, Теребака, осы аралдағы ең биік тау.
Dialogue: 0,0:49:45.27,0:49:46.69,Default,,0,0,0,,Ақу Аку
Dialogue: 0,0:49:46.77,0:49:49.61,Default,,0,0,0,,Аралдағы барлық Моаи сәулелеріне отты шоғырландырыңыз.
Dialogue: 0,0:49:50.32,0:49:51.48,Default,,0,0,0,,Перпеки
Dialogue: 0,0:49:51.57,0:49:54.40,Default,,0,0,0,,Бірақ ең бастысы - оны азғыратын қару...
Dialogue: 0,0:49:54.49,0:49:56.32,Default,,0,0,0,,Джеро Джеро Джеро Джеро~
Dialogue: 0,0:49:56.41,0:49:58.07,Default,,0,0,0,,Құсу туралы уайымдаудың қажеті жоқ!
Dialogue: 0,0:49:58.16,0:49:59.91,Default,,0,0,0,,Ол жақындап қалды.
Dialogue: 0,0:49:59.99,0:50:01.87,Default,,0,0,0,,Ағай~!
Dialogue: 0,0:50:01.95,0:50:02.70,Default,,0,0,0,,Мырзалар көбірек!
Dialogue: 0,0:50:02.79,0:50:05.04,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:50:05.12,0:50:06.50,Default,,0,0,0,,Жүк түсіп қалды!
Dialogue: 0,0:50:19.22,0:50:21.81,Default,,0,0,0,,V операциялық өрт сөндіру бригадасы келді.
Dialogue: 0,0:50:21.89,0:50:23.89,Default,,0,0,0,,Дұрыс, сіз мұны пайдалана аласыз.
Dialogue: 0,0:50:24.60,0:50:27.94,Default,,0,0,0,,Пайдалы болады деп ойламаппын.
Dialogue: 0,0:50:28.44,0:50:29.52,Default,,0,0,0,,Әрине
Dialogue: 0,0:50:29.60,0:50:31.65,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:50:31.73,0:50:33.07,Default,,0,0,0,,Күтілгендей, капитан-доно.
Dialogue: 0,0:50:33.15,0:50:34.48,Default,,0,0,0,,-Уау~ -Уау~
Dialogue: 0,0:50:34.57,0:50:35.82,Default,,0,0,0,,Гелори
Dialogue: 0,0:50:35.90,0:50:37.74,Default,,0,0,0,,Қазір барлық дайындық жұмыстары аяқталды.
Dialogue: 0,0:50:37.82,0:50:39.11,Default,,0,0,0,,О!
Dialogue: 0,0:50:39.70,0:50:42.16,Default,,0,0,0,,Мен жыртқышқа бірінші қадам жасаймын.
Dialogue: 0,0:50:42.24,0:50:44.04,Default,,0,0,0,,Жұмыс басталады!
Dialogue: 0,0:50:46.20,0:50:47.58,Default,,0,0,0,,Ағай~!
Dialogue: 0,0:50:47.66,0:50:50.63,Default,,0,0,0,,Мор мырза, сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:50:50.71,0:50:51.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:51.46,0:50:52.42,Default,,0,0,0,,Сонда мен де.
Dialogue: 0,0:50:52.92,0:50:54.25,Default,,0,0,0,,О, күте тұрыңыз, сержант.
Dialogue: 0,0:50:54.34,0:50:55.88,Default,,0,0,0,,Жарайды
Dialogue: 0,0:50:55.96,0:50:59.43,Default,,0,0,0,,Мен Фуюки-дононың стратегиясына және біздің күшімізге сенемін.
Dialogue: 0,0:50:59.51,0:51:00.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:51:03.39,0:51:05.10,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:51:11.27,0:51:12.98,Default,,0,0,0,,Ағай, мықты болыңыз!
Dialogue: 0,0:51:24.03,0:51:25.74,Default,,0,0,0,,Хэхе, ауа райы жақсы.
Dialogue: 0,0:51:26.24,0:51:28.58,Default,,0,0,0,,Қайта бастаймыз ба?
Dialogue: 0,0:51:28.66,0:51:31.37,Default,,0,0,0,,Бұл менің ең керемет еркелігім
Dialogue: 0,0:51:31.46,0:51:32.88,Default,,0,0,0,,Құсу, құсу, құсу, құсу!
Dialogue: 0,0:51:32.96,0:51:33.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:33.59,0:51:37.05,Default,,0,0,0,,Бұл деңгейде ең соңғысы - асқазанның ауыруы.
Dialogue: 0,0:51:37.13,0:51:38.92,Default,,0,0,0,,Бұл Кероро сержанты
Dialogue: 0,0:51:39.01,0:51:42.05,Default,,0,0,0,,Мен қазір сізге жас еркеліктерді көрсетемін.
Dialogue: 0,0:51:42.55,0:51:44.01,Default,,0,0,0,,Жүр, менің артымнан жүр!
Dialogue: 0,0:51:44.10,0:51:44.93,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:51:45.01,0:51:45.81,Default,,0,0,0,,Гелот…
Dialogue: 0,0:51:45.89,0:51:48.68,Default,,0,0,0,,А, мен түсіндім! Жоғалтудан қорқатындықтан ба?
Dialogue: 0,0:51:49.48,0:51:51.73,Default,,0,0,0,,Салқын емес
Dialogue: 0,0:51:51.81,0:51:54.19,Default,,0,0,0,,Шынымен, термиттер!
Dialogue: 0,0:51:54.73,0:51:57.90,Default,,0,0,0,,Құсу... сонда ғана осында бітір.
Dialogue: 0,0:51:58.40,0:52:00.49,Default,,0,0,0,,Үш сәулені белгілеңіз!
Dialogue: 0,0:52:00.57,0:52:01.20,Default,,0,0,0,,Пә!
Dialogue: 0,0:52:01.70,0:52:04.49,Default,,0,0,0,,Бұл босқа! Бұл мен үшін қандай сәулелік шабуыл...
Dialogue: 0,0:52:04.57,0:52:05.66,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:52:05.74,0:52:07.04,Default,,0,0,0,,Джеро Джеро Джеро
Dialogue: 0,0:52:07.12,0:52:09.16,Default,,0,0,0,,Қандай проблема!
Dialogue: 0,0:52:09.25,0:52:11.00,Default,,0,0,0,,Үлкен жетістік!
Dialogue: 0,0:52:11.08,0:52:13.33,Default,,0,0,0,,Хмф! Жарайды
Dialogue: 0,0:52:13.83,0:52:16.00,Default,,0,0,0,,Сонша азапты көргің келсе
Dialogue: 0,0:52:16.09,0:52:17.25,Default,,0,0,0,,Мен сенімен айналысамын!
Dialogue: 0,0:52:17.34,0:52:18.71,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:52:22.80,0:52:23.80,Default,,0,0,0,,Ол қозғалды!
Dialogue: 0,0:52:23.89,0:52:26.81,Default,,0,0,0,,Аспазшы~ Бірінші кезең тазартылады.
Dialogue: 0,0:52:26.89,0:52:28.47,Default,,0,0,0,,Бірақ әлі алда.
Dialogue: 0,0:52:28.56,0:52:30.10,Default,,0,0,0,,Мен босаңсуға болмайды~
Dialogue: 0,0:52:30.18,0:52:30.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:32.73,0:52:35.86,Default,,0,0,0,,Жарайды, жарайды, «ханым, бұл осында».
Dialogue: 0,0:52:35.94,0:52:37.44,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:52:37.52,0:52:38.07,Default,,0,0,0,,Құсу?
Dialogue: 0,0:52:39.65,0:52:41.65,Default,,0,0,0,,Осындай уақытта... да!
Dialogue: 0,0:52:41.74,0:52:43.70,Default,,0,0,0,,Мен мұнда тек жын-перілерді өлтіруге келдім.
Dialogue: 0,0:52:45.12,0:52:45.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:45.78,0:52:47.78,Default,,0,0,0,,Мұның бәрі бос сөз!
Dialogue: 0,0:52:49.04,0:52:49.70,Default,,0,0,0,,Құсу!
Dialogue: 0,0:52:51.45,0:52:52.37,Default,,0,0,0,,Не?
Dialogue: 0,0:52:55.42,0:52:57.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:57.09,0:52:58.04,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:52:58.59,0:52:59.38,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:53:01.34,0:53:02.09,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:53:03.26,0:53:04.09,Default,,0,0,0,,Фуюки-сан
Dialogue: 0,0:53:04.18,0:53:07.39,Default,,0,0,0,,Менің... ағам осылай ұрысады.
Dialogue: 0,0:53:07.47,0:53:08.22,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:53:08.85,0:53:11.22,Default,,0,0,0,,Ио, сен мені естисің бе? Io…
Dialogue: 0,0:53:11.85,0:53:13.23,Default,,0,0,0,,Лананы тыңдаңыз
Dialogue: 0,0:53:13.31,0:53:17.77,Default,,0,0,0,,Аралдағы моаи мен мана бізге күш береді.
Dialogue: 0,0:53:19.57,0:53:21.90,Default,,0,0,0,,Фуюки Ио жақсы.
Dialogue: 0,0:53:21.99,0:53:24.15,Default,,0,0,0,,Егер сіз маған белгі берсеңіз, мен мұны кез келген уақытта істей аламын.
Dialogue: 0,0:53:24.24,0:53:24.86,Default,,0,0,0,,Иә
Dialogue: 0,0:53:25.36,0:53:27.45,Default,,0,0,0,,Тағы да... Сәттілік, сержант.
Dialogue: 0,0:53:27.95,0:53:29.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:30.29,0:53:33.00,Default,,0,0,0,,Сіз алға қойған мақсат дәл сіздің алдыңызда!
Dialogue: 0,0:53:33.08,0:53:34.58,Default,,0,0,0,,Құсу!
Dialogue: 0,0:53:34.66,0:53:36.21,Default,,0,0,0,,Фуюки-сан!
Dialogue: 0,0:53:36.29,0:53:39.34,Default,,0,0,0,,Менің... ағам осылай құлап жатыр.
Dialogue: 0,0:53:39.42,0:53:39.96,Default,,0,0,0,,Куруру!
Dialogue: 0,0:53:40.05,0:53:42.26,Default,,0,0,0,,Жоқ, әлі ерте~
Dialogue: 0,0:53:42.34,0:53:45.80,Default,,0,0,0,,Қандай жағдай болмасын мен оны шыңға шығаруым керек.
Dialogue: 0,0:53:46.30,0:53:48.72,Default,,0,0,0,,Баратын жер сол таудың басы ма?
Dialogue: 0,0:53:48.80,0:53:49.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:54.43,0:53:55.94,Default,,0,0,0,,Хмф! Солай ма?
Dialogue: 0,0:53:56.02,0:53:58.98,Default,,0,0,0,,Нысананың қозғалысы тоқтатылды
Dialogue: 0,0:53:59.06,0:54:01.57,Default,,0,0,0,,Бұл қауіпті~ Мені байқадым~
Dialogue: 0,0:54:01.65,0:54:02.19,Default,,0,0,0,,Куруру!
Dialogue: 0,0:54:02.28,0:54:04.15,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:54:04.90,0:54:07.49,Default,,0,0,0,,V операциясы Өрт сөндіру бригадасы қатысуда.
Dialogue: 0,0:54:07.57,0:54:08.41,Default,,0,0,0,,О...
Dialogue: 0,0:54:09.20,0:54:09.82,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:54:09.91,0:54:11.53,Default,,0,0,0,,Иә?Иә?
Dialogue: 0,0:54:11.62,0:54:13.58,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:54:14.20,0:54:15.58,Default,,0,0,0,,Су бүркуді бастаңыз!
Dialogue: 0,0:54:16.08,0:54:16.71,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:54:18.04,0:54:19.92,Default,,0,0,0,,Ату! Ат!
Dialogue: 0,0:54:20.00,0:54:22.17,Default,,0,0,0,,Маған қашып кетуге жол берме!
Dialogue: 0,0:54:22.25,0:54:24.34,Default,,0,0,0,,Арх! Эй, эй...
Dialogue: 0,0:54:24.97,0:54:27.01,Default,,0,0,0,,Қарғыс атсын... Неге су!
Dialogue: 0,0:54:27.09,0:54:29.64,Default,,0,0,0,,Уф... уф... Кешіріңіз!
Dialogue: 0,0:54:29.72,0:54:33.01,Default,,0,0,0,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,0:54:33.10,0:54:37.02,Default,,0,0,0,,Ха ха ха... Ақыры осында...
Dialogue: 0,0:54:37.10,0:54:39.65,Default,,0,0,0,,Келіңіздер, келіңіздер...
Dialogue: 0,0:54:39.73,0:54:40.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:40.90,0:54:43.57,Default,,0,0,0,,Айналыңыз! Оның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:54:43.65,0:54:45.74,Default,,0,0,0,,Неге сырттасың?
Dialogue: 0,0:54:45.82,0:54:46.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:48.91,0:54:51.78,Default,,0,0,0,,Гехо... сендер сияқты жігіттер!
Dialogue: 0,0:54:53.41,0:54:55.20,Default,,0,0,0,,Жарайды, ол дерлік қалды.
Dialogue: 0,0:54:55.87,0:54:58.42,Default,,0,0,0,,Аты-жөніме шыдай алмаймын!
Dialogue: 0,0:54:59.21,0:55:00.46,Default,,0,0,0,,Құсу!
Dialogue: 0,0:55:00.54,0:55:01.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:55:01.13,0:55:02.84,Default,,0,0,0,,Не? Уау...
Dialogue: 0,0:55:02.92,0:55:03.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:03.59,0:55:04.46,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:55:04.55,0:55:06.76,Default,,0,0,0,,Қапшықтар!
Dialogue: 0,0:55:10.97,0:55:12.26,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:55:12.35,0:55:13.89,Default,,0,0,0,,Джироро! Ха…
Dialogue: 0,0:55:14.93,0:55:15.68,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:55:15.77,0:55:17.52,Default,,0,0,0,,Тама~!
Dialogue: 0,0:55:17.60,0:55:19.94,Default,,0,0,0,,Дороро! Тамама!
Dialogue: 0,0:55:20.02,0:55:21.69,Default,,0,0,0,,Нухахахаха!
Dialogue: 0,0:55:22.27,0:55:24.73,Default,,0,0,0,,Біреуді уайымдаған кезде ме?
Dialogue: 0,0:55:26.23,0:55:28.36,Default,,0,0,0,,Енді Лана! Ио-кунға...
Dialogue: 0,0:55:28.45,0:55:29.57,Default,,0,0,0,,- Күтіңіз - (Фуюки) А...
Dialogue: 0,0:55:29.65,0:55:31.07,Default,,0,0,0,,Мұнда шатыры бар. Садақ пен жебелер осында болуы мүмкін.
Dialogue: 0,0:55:31.16,0:55:32.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:35.16,0:55:36.29,Default,,0,0,0,,Құсу...
Dialogue: 0,0:55:41.17,0:55:43.04,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:55:43.13,0:55:45.09,Default,,0,0,0,,Бұл қасиетті нұр...
Dialogue: 0,0:55:45.67,0:55:47.42,Default,,0,0,0,,Ио, қарап тұрсың ба?
Dialogue: 0,0:55:47.51,0:55:48.92,Default,,0,0,0,,Бір қорқынышты нәрсе болды!
Dialogue: 0,0:55:49.01,0:55:50.84,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:55:50.93,0:55:53.51,Default,,0,0,0,,Keroro Danger Io Go!
Dialogue: 0,0:55:55.56,0:55:56.72,Default,,0,0,0,,Io, мүмкін емес...
Dialogue: 0,0:55:56.81,0:55:59.23,Default,,0,0,0,,Лана, өтінемін!
Dialogue: 0,0:55:59.85,0:56:00.81,Default,,0,0,0,,Io!
Dialogue: 0,0:56:01.31,0:56:02.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:56:02.31,0:56:03.69,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:03.77,0:56:05.86,Default,,0,0,0,,Бұл өте күлкілі еркелік болды.
Dialogue: 0,0:56:05.94,0:56:08.74,Default,,0,0,0,,Соңғы әсерлер тым жұмсақ болған сияқты.
Dialogue: 0,0:56:09.32,0:56:12.07,Default,,0,0,0,,Олай болса, осымен аяқтаймыз.
Dialogue: 0,0:56:12.16,0:56:14.74,Default,,0,0,0,,Ең керемет еркелік, мен жеңемін.
Dialogue: 0,0:56:14.82,0:56:16.95,Default,,0,0,0,,Қарғыс атсын... бұл...
Dialogue: 0,0:56:17.04,0:56:19.79,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,0:56:20.29,0:56:21.75,Default,,0,0,0,,Біз қауіпсіз жердеміз, сондықтан…
Dialogue: 0,0:56:23.83,0:56:25.63,Default,,0,0,0,,Фу... Фугайнай
Dialogue: 0,0:56:26.13,0:56:27.75,Default,,0,0,0,,Ол дұрыс.
Dialogue: 0,0:56:29.84,0:56:32.68,Default,,0,0,0,,Ешкімді бұлай қорғауға болмайды.
Dialogue: 0,0:56:33.18,0:56:35.60,Default,,0,0,0,,Егер менде көбірек күш болса...
Dialogue: 0,0:56:35.68,0:56:36.55,Default,,0,0,0,,Кероро!
Dialogue: 0,0:56:36.64,0:56:38.14,Default,,0,0,0,,Не? Құсу?
Dialogue: 0,0:56:39.85,0:56:40.93,Default,,0,0,0,,Лорд Ио?
Dialogue: 0,0:56:42.77,0:56:43.69,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:56:44.27,0:56:45.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:46.02,0:56:47.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:56:47.86,0:56:49.94,Default,,0,0,0,,Құсу!
Dialogue: 0,0:56:54.86,0:56:57.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:56:57.37,0:56:58.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:58.74,0:56:59.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:02.25,0:57:04.25,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:57:05.04,0:57:06.54,Default,,0,0,0,,Сержант мырза...
Dialogue: 0,0:57:06.63,0:57:08.84,Default,,0,0,0,,(Джиророның дірілдеген тынысы)
Dialogue: 0,0:57:09.34,0:57:11.38,Default,,0,0,0,,Ке… Кероро?
Dialogue: 0,0:57:12.42,0:57:14.09,Default,,0,0,0,,Кероро~!
Dialogue: 0,0:57:14.18,0:57:15.84,Default,,0,0,0,,Барудың қажеті жоқ.
Dialogue: 0,0:57:15.93,0:57:18.64,Default,,0,0,0,,Егер ол болса, енді көлеңке де, пішін де жоқ.
Dialogue: 0,0:57:19.22,0:57:21.93,Default,,0,0,0,,Бұл дүниеден мүлде ғайып болды
Dialogue: 0,0:57:22.43,0:57:24.27,Default,,0,0,0,,Бір үзінді де қалдырмаңыз.
Dialogue: 0,0:57:24.77,0:57:28.19,Default,,0,0,0,,Барлығыңыз белгілі бір мөлшерде жұмыс істедіңіздер ме?
Dialogue: 0,0:57:28.27,0:57:30.19,Default,,0,0,0,,Бірақ капитан қабілетсіз болды.
Dialogue: 0,0:57:30.28,0:57:31.82,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:57:31.90,0:57:34.82,Default,,0,0,0,,Гирогирогиро, тама тама тама, лай...
Dialogue: 0,0:57:34.90,0:57:36.20,Default,,0,0,0,,Ах~ Курукуру
Dialogue: 0,0:57:36.28,0:57:37.66,Default,,0,0,0,,(Аня) Аня, маған бұлар ұнамайды.
Dialogue: 0,0:57:37.74,0:57:40.87,Default,,0,0,0,,Нааааааааааааа!
Dialogue: 0,0:57:43.16,0:57:45.71,Default,,0,0,0,,Мен мұны тоқтатуым керек еді.
Dialogue: 0,0:57:47.29,0:57:49.38,Default,,0,0,0,,Мен үшін сержант...
Dialogue: 0,0:57:49.88,0:57:51.42,Default,,0,0,0,,Басынан бастап, И
Dialogue: 0,0:57:51.50,0:57:53.42,Default,,0,0,0,,Мен Пасха аралына келгім келетінін айтуым керек...
Dialogue: 0,0:57:55.47,0:57:56.72,Default,,0,0,0,,Осының арқасында!
Dialogue: 0,0:57:57.30,0:57:58.76,Default,,0,0,0,,Осыған байланысты, сержант!
Dialogue: 0,0:57:59.26,0:58:00.56,Default,,0,0,0,,Сержант - бұл ~!
Dialogue: 0,0:58:01.43,0:58:02.35,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:58:02.43,0:58:03.31,Default,,0,0,0,,Ха…
Dialogue: 0,0:58:07.65,0:58:08.61,Default,,0,0,0,,Музика мүлде шайтанға ұқсамайды.
Dialogue: 0,0:58:08.69,0:58:09.36,Default,,0,0,0,,Иә
Dialogue: 0,0:58:09.44,0:58:10.82,Default,,0,0,0,,Мен сержанттың даусын естідім!
Dialogue: 0,0:58:10.90,0:58:11.69,Default,,0,0,0,,-Аа? -Аа...
Dialogue: 0,0:58:11.77,0:58:14.40,Default,,0,0,0,,Енді Лана түсінді.
Dialogue: 0,0:58:14.49,0:58:16.57,Default,,0,0,0,,Мен моайдың даусын естідім
Dialogue: 0,0:58:16.65,0:58:17.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:18.11,0:58:19.66,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:58:19.74,0:58:21.62,Default,,0,0,0,,Темір құсқа бәріміз міндік
Dialogue: 0,0:58:21.70,0:58:24.04,Default,,0,0,0,,Темір қуыршақ мені қағып кете жаздады
Dialogue: 0,0:58:29.08,0:58:32.09,Default,,0,0,0,,Ол кезде мен бәрін болашаққа сәл де болса жібердім.
Dialogue: 0,0:58:32.88,0:58:35.97,Default,,0,0,0,,Бізде уақыт арқылы секіру мүмкіндігі бар.
Dialogue: 0,0:58:36.05,0:58:37.09,Default,,0,0,0,,Моаи
Dialogue: 0,0:58:37.18,0:58:41.51,Default,,0,0,0,,Жарылыс алдында Ио өткенге жіберген Керороның жаны
Dialogue: 0,0:58:41.60,0:58:43.60,Default,,0,0,0,,Өткенге аттап кетсең де...
Dialogue: 0,0:58:44.10,0:58:47.39,Default,,0,0,0,,Сосын Ариса-чан оны көтеріп алды.
Dialogue: 0,0:58:47.89,0:58:49.15,Default,,0,0,0,,Маған дейін...
Dialogue: 0,0:58:50.15,0:58:51.56,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:58:52.07,0:58:53.61,Default,,0,0,0,,Сіз тірісіз, сержант!
Dialogue: 0,0:58:53.69,0:58:54.44,Default,,0,0,0,,- Уф... - (Фуюки) Ах.
Dialogue: 0,0:58:54.53,0:58:56.15,Default,,0,0,0,,Кеше түнгі үкім дұрыс орындалды.
Dialogue: 0,0:58:56.24,0:58:58.78,Default,,0,0,0,,Ағаның жоғалып кетуі мүмкін емес.
Dialogue: 0,0:58:58.86,0:59:01.24,Default,,0,0,0,,Мәңгілік және өлмейтін!
Dialogue: 0,0:59:01.32,0:59:03.20,Default,,0,0,0,,Сол Кероро тұқымы
Dialogue: 0,0:59:03.28,0:59:06.75,Default,,0,0,0,,Егер сіз оны барлық моайлар туған Рано Рараку топырағына жерлесеңіз.
Dialogue: 0,0:59:06.83,0:59:07.91,Default,,0,0,0,,Кероро қайта тіріледі!
Dialogue: 0,0:59:08.67,0:59:09.58,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:59:09.67,0:59:11.79,Default,,0,0,0,,Мен Рано Раракуға барамын
Dialogue: 0,0:59:11.88,0:59:13.75,Default,,0,0,0,,Олай болса асығыңыз.
Dialogue: 0,0:59:13.84,0:59:15.09,Default,,0,0,0,,Жігіт
Dialogue: 0,0:59:15.17,0:59:15.71,Default,,0,0,0,,Қайтадан кез келген сәт
Dialogue: 0,0:59:15.80,0:59:17.51,Default,,0,0,0,,Сіз бастаған сияқтысыз.
Dialogue: 0,0:59:17.59,0:59:18.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:18.34,0:59:20.89,Default,,0,0,0,,Мен сені бұл жолы талқандаймын
Dialogue: 0,0:59:20.97,0:59:22.93,Default,,0,0,0,,Никкуки моаи осы аралда
Dialogue: 0,0:59:23.01,0:59:24.26,Default,,0,0,0,,Әрқайсысы қалды!
Dialogue: 0,0:59:41.70,0:59:42.95,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:59:43.03,0:59:44.83,Default,,0,0,0,,Күзге 20 минуттан аз уақыт қалды.
Dialogue: 0,0:59:46.87,0:59:48.29,Default,,0,0,0,,Барлығың тыңдаңдар!
Dialogue: 0,0:59:48.37,0:59:51.62,Default,,0,0,0,,Мен сержантты қайтарып жатырмын. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:59:51.71,0:59:52.54,Default,,0,0,0,,Мочи курсы!
Dialogue: 0,0:59:52.63,0:59:53.42,Default,,0,0,0,,Фуюки…
Dialogue: 0,0:59:55.71,0:59:56.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:57.71,0:59:58.38,Default,,0,0,0,,Уф!
Dialogue: 0,1:00:02.68,1:00:05.93,Default,,0,0,0,,Бұл аралдағы Алланың елшісі: Құс адам
Dialogue: 0,1:00:06.47,1:00:08.35,Default,,0,0,0,,Бұл Фуюки ме?
Dialogue: 0,1:00:08.93,1:00:10.60,Default,,0,0,0,,Мен естідім, балалар.
Dialogue: 0,1:00:10.69,1:00:11.48,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,1:00:11.56,1:00:12.60,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,1:00:12.69,1:00:14.69,Default,,0,0,0,,Кероро әлі тірі
Dialogue: 0,1:00:14.77,1:00:17.19,Default,,0,0,0,,Мен Фуюкиді шын жүректен қолдаймын!
Dialogue: 0,1:00:17.28,1:00:18.32,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:00:18.40,1:00:19.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:23.66,1:00:25.24,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,1:00:25.74,1:00:28.33,Default,,0,0,0,,Жарайды, мен енді аямаймын.
Dialogue: 0,1:00:28.95,1:00:30.79,Default,,0,0,0,,Жақында болады, сержант.
Dialogue: 0,1:00:31.29,1:00:31.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:33.88,1:00:35.84,Default,,0,0,0,,Ең көне моай?
Dialogue: 0,1:00:36.34,1:00:37.59,Default,,0,0,0,,Сонда мен білемін
Dialogue: 0,1:00:37.67,1:00:39.09,Default,,0,0,0,,Моаи Туритури
Dialogue: 0,1:00:39.17,1:00:40.55,Default,,0,0,0,,Оны сол жерге көм.
Dialogue: 0,1:00:40.63,1:00:41.13,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:00:41.22,1:00:42.93,Default,,0,0,0,,Себебі менде қажет емес білім бар
Dialogue: 0,1:00:43.01,1:00:44.01,Default,,0,0,0,,Сіз күйіп кетесіз.
Dialogue: 0,1:00:44.09,1:00:47.01,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:51.60,1:00:53.02,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:00:53.10,1:00:54.52,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:00:54.60,1:00:55.81,Default,,0,0,0,,Ой~!
Dialogue: 0,1:00:57.82,1:00:58.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:59.19,1:01:00.11,Default,,0,0,0,,Угаачачача...
Dialogue: 0,1:01:00.82,1:01:01.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:01.57,1:01:02.86,Default,,0,0,0,,Енді уақыт келді, Фуюки!
Dialogue: 0,1:01:02.95,1:01:04.03,Default,,0,0,0,,Әй, Жироро!
Dialogue: 0,1:01:04.11,1:01:06.74,Default,,0,0,0,,Біз мұны тоқтатамыз!
Dialogue: 0,1:01:06.82,1:01:08.58,Default,,0,0,0,,(Үшеуі) Қане, бастаймыз~! (Танжиро) Уа!
Dialogue: 0,1:01:09.08,1:01:09.74,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:01:09.83,1:01:13.33,Default,,0,0,0,,Ату! Бар күшіңізбен атуды жалғастырыңыз!
Dialogue: 0,1:01:13.41,1:01:13.92,Default,,0,0,0,,О...
Dialogue: 0,1:01:14.00,1:01:15.46,Default,,0,0,0,,Ууууах!
Dialogue: 0,1:01:17.67,1:01:18.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:21.01,1:01:23.30,Default,,0,0,0,,Қай жолмен уақыт босқа кетті?
Dialogue: 0,1:01:23.80,1:01:27.43,Default,,0,0,0,,Жорғалап, менің шыбындарды өлтіргенімді көрдім!
Dialogue: 0,1:01:28.55,1:01:30.93,Default,,0,0,0,,Кероро, қалғанын сұрадым.
Dialogue: 0,1:01:31.02,1:01:32.64,Default,,0,0,0,,- Жоқ! -(Дороро Тамама) Ах...
Dialogue: 0,1:01:33.56,1:01:35.31,Default,,0,0,0,,-Арх! - Гироро-доно!
Dialogue: 0,1:01:35.40,1:01:38.06,Default,,0,0,0,,Ой... Тама!
Dialogue: 0,1:01:38.98,1:01:40.82,Default,,0,0,0,,Көріксіз қабықтар!
Dialogue: 0,1:01:40.90,1:01:46.57,Default,,0,0,0,,(Фуюкидің ауыр тыныс алуы)
Dialogue: 0,1:01:51.33,1:01:53.75,Default,,0,0,0,,Бұл жақсы болуы керек.
Dialogue: 0,1:02:08.76,1:02:11.64,Default,,0,0,0,,Сержант, сіз не істеп жатырсыз?
Dialogue: 0,1:02:12.64,1:02:14.35,Default,,0,0,0,,Не болды, сержант?
Dialogue: 0,1:02:14.43,1:02:15.52,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,1:02:16.10,1:02:19.19,Default,,0,0,0,,Өтінемін, мен сені қайта көргім келеді!
Dialogue: 0,1:02:19.27,1:02:20.69,Default,,0,0,0,,Сержант!
Dialogue: 0,1:02:23.99,1:02:24.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:31.28,1:02:32.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:39.92,1:02:40.50,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:41.59,1:02:43.80,Default,,0,0,0,,О, сізді күткенім үшін кешіріңіз!
Dialogue: 0,1:02:43.88,1:02:47.72,Default,,0,0,0,,Сержант Кероро қайтып келді!
Dialogue: 0,1:02:47.80,1:02:50.47,Default,,0,0,0,,Эй... бұл әдеттегіден сәл басқаша!
Dialogue: 0,1:02:51.05,1:02:51.97,Default,,0,0,0,,Сержант!
Dialogue: 0,1:02:52.05,1:02:53.26,Default,,0,0,0,,Жақсы
Dialogue: 0,1:02:53.35,1:02:54.81,Default,,0,0,0,,Мен сені енді көре алмаймын ба деп қорқамын...
Dialogue: 0,1:02:54.89,1:02:55.85,Default,,0,0,0,,-Фуюки-доно-(Фуюки) Ах!
Dialogue: 0,1:02:55.93,1:02:57.94,Default,,0,0,0,,Бұл туралы кейінірек.
Dialogue: 0,1:02:58.02,1:02:58.94,Default,,0,0,0,,Енді бұл!
Dialogue: 0,1:03:01.02,1:03:03.23,Default,,0,0,0,,Уау! Қашан?
Dialogue: 0,1:03:03.73,1:03:04.36,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,1:03:09.86,1:03:12.78,Default,,0,0,0,,Аспанда, теңізде және жерде мәңгі сақталады
Dialogue: 0,1:03:12.87,1:03:14.12,Default,,0,0,0,,O шикі қуат
Dialogue: 0,1:03:15.75,1:03:19.25,Default,,0,0,0,,Енді менің денемде тұратын уақыт!
Dialogue: 0,1:03:19.75,1:03:21.54,Default,,0,0,0,,Иә? не!
Dialogue: 0,1:03:21.63,1:03:24.55,Default,,0,0,0,,Ал... болмайды... ол жігіт пе?
Dialogue: 0,1:03:27.63,1:03:29.80,Default,,0,0,0,,-10 секунд қалды -Уф... Ағай!
Dialogue: 0,1:03:31.89,1:03:32.85,Default,,0,0,0,,Сержант...
Dialogue: 0,1:03:35.85,1:03:36.52,Default,,0,0,0,,Каа!
Dialogue: 0,1:03:36.60,1:03:40.85,Default,,0,0,0,,Торнадо жасаңыз!
Dialogue: 0,1:03:49.53,1:03:50.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:01.54,1:04:06.42,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:04:07.00,1:04:08.71,Default,,0,0,0,,Ах... уау...
Dialogue: 0,1:04:09.34,1:04:10.72,Default,,0,0,0,,-Уау -Уау!
Dialogue: 0,1:04:10.80,1:04:11.34,Default,,0,0,0,,Dobe!
Dialogue: 0,1:04:11.43,1:04:13.30,Default,,0,0,0,,Ол... жоғалады.
Dialogue: 0,1:04:13.39,1:04:16.56,Default,,0,0,0,,Ғаламдағы жарықтар азайып барады!
Dialogue: 0,1:04:25.65,1:04:26.82,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:04:27.32,1:04:29.11,Default,,0,0,0,,Ешқандай жарақат жоқ сияқты.
Dialogue: 0,1:04:29.19,1:04:29.86,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,1:04:29.94,1:04:30.53,Default,,0,0,0,,Сержант!
Dialogue: 0,1:04:31.24,1:04:34.78,Default,,0,0,0,,Онда мен онымен істі шешемін.
Dialogue: 0,1:04:34.87,1:04:37.37,Default,,0,0,0,,Сержант күтіңіз! Мен де!
Dialogue: 0,1:04:37.87,1:04:38.62,Default,,0,0,0,,Фуюки!
Dialogue: 0,1:04:39.12,1:04:40.29,Default,,0,0,0,,Лана-чан
Dialogue: 0,1:04:40.79,1:04:43.67,Default,,0,0,0,,Қараңыз! Дәл сіз айтқандай болды
Dialogue: 0,1:04:43.75,1:04:45.21,Default,,0,0,0,,Сержант осылай болды...
Dialogue: 0,1:04:45.29,1:04:46.88,Default,,0,0,0,,Макемаке-сама қайта жанданды.
Dialogue: 0,1:04:46.96,1:04:47.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:48.05,1:04:50.76,Default,,0,0,0,,Қазіргі Кероро, осы аралдың қамқоршы құдайы
Dialogue: 0,1:04:50.84,1:04:53.01,Default,,0,0,0,,Барлық мананың шебері
Dialogue: 0,1:04:53.76,1:04:56.55,Default,,0,0,0,,Сержант Макемаке құдайы ма?
Dialogue: 0,1:05:01.10,1:05:03.02,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,1:05:03.10,1:05:04.65,Default,,0,0,0,,-Бұл ұят болды. -Хмм?
Dialogue: 0,1:05:04.73,1:05:09.53,Default,,0,0,0,,Хмм... Біліксіз капитаннан жеңілу қандай сезімде?
Dialogue: 0,1:05:10.03,1:05:11.19,Default,,0,0,0,,Гуора~!
Dialogue: 0,1:05:11.28,1:05:13.03,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:05:13.53,1:05:17.24,Default,,0,0,0,,Иә? Не... не? Ол жігіт...
Dialogue: 0,1:05:17.33,1:05:18.78,Default,,0,0,0,,Ке... Кероро...
Dialogue: 0,1:05:18.87,1:05:19.83,Default,,0,0,0,,Гелори
Dialogue: 0,1:05:20.75,1:05:22.58,Default,,0,0,0,,Та... Капитан...
Dialogue: 0,1:05:22.66,1:05:24.17,Default,,0,0,0,,Сержант мырза...
Dialogue: 0,1:05:24.25,1:05:25.46,Default,,0,0,0,,(Тамаманың айқайы)
Dialogue: 0,1:05:25.54,1:05:28.21,Default,,0,0,0,,Сіздің Керондық әскери жаныңыз
Dialogue: 0,1:05:28.29,1:05:30.13,Default,,0,0,0,,Маған оны анық көрсетті.
Dialogue: 0,1:05:30.21,1:05:31.30,Default,,0,0,0,,Мені күлдірме!
Dialogue: 0,1:05:31.38,1:05:34.18,Default,,0,0,0,,Осындай қызықсыз адамдардың жаны қайда...
Dialogue: 0,1:05:34.26,1:05:34.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:34.88,1:05:38.14,Default,,0,0,0,,Gengero Gengero Gengerori~!
Dialogue: 0,1:05:42.22,1:05:44.52,Default,,0,0,0,,Сіз қызықсыз!
Dialogue: 0,1:05:52.32,1:05:53.94,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,1:05:54.95,1:05:55.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:58.03,1:06:00.45,Default,,0,0,0,,Өзіңізді алдамаңыз! Қандай жасау!
Dialogue: 0,1:06:01.12,1:06:03.96,Default,,0,0,0,,Бұл Аку Аку-саманың басынан бірдеңе болып жатыр...
Dialogue: 0,1:06:08.08,1:06:09.46,Default,,0,0,0,,Бұл орындалады ма?
Dialogue: 0,1:06:11.80,1:06:13.46,Default,,0,0,0,,Замамиро
Dialogue: 0,1:06:15.51,1:06:16.88,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,1:06:17.47,1:06:19.89,Default,,0,0,0,,Бұл ұят. Бұл макияж сияқты.
Dialogue: 0,1:06:19.97,1:06:22.26,Default,,0,0,0,,Енді сіздің күшіңізді алып кететін уақыт.
Dialogue: 0,1:06:22.89,1:06:24.27,Default,,0,0,0,,Сен жалғызсың
Dialogue: 0,1:06:24.35,1:06:27.14,Default,,0,0,0,,Мен сені жеңемін деп ойладым...
Dialogue: 0,1:06:27.23,1:06:28.35,Default,,0,0,0,,- Жоқ! -сурет?
Dialogue: 0,1:06:28.44,1:06:29.81,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,1:06:30.44,1:06:31.02,Default,,0,0,0,,Гуааа…
Dialogue: 0,1:06:31.11,1:06:32.86,Default,,0,0,0,,Әрине мен
Dialogue: 0,1:06:32.94,1:06:35.53,Default,,0,0,0,,Жалғыз соғысқан ешкім болған жоқ.
Dialogue: 0,1:06:35.61,1:06:37.53,Default,,0,0,0,,Не... не айтып тұрсың...
Dialogue: 0,1:06:37.61,1:06:38.95,Default,,0,0,0,,Уа!
Dialogue: 0,1:06:39.45,1:06:42.37,Default,,0,0,0,,Жоқ! Бұл... міне!
Dialogue: 0,1:06:42.87,1:06:43.66,Default,,0,0,0,,- Қазір! -Қазір!
Dialogue: 0,1:06:43.74,1:06:44.79,Default,,0,0,0,,Лана-чан!
Dialogue: 0,1:06:44.87,1:06:47.83,Default,,0,0,0,,Өтінемін... Моаи аралда, барлық мана!
Dialogue: 0,1:06:47.92,1:06:50.08,Default,,0,0,0,,Қазір бәрінің күш-қуатының уақыты!
Dialogue: 0,1:06:50.17,1:06:53.30,Default,,0,0,0,,Жамандықты кетіретін қасиетті нұр!
Dialogue: 0,1:07:05.93,1:07:08.94,Default,,0,0,0,,Гуах! Жоқ... тоқтатыңыз...
Dialogue: 0,1:07:09.02,1:07:10.86,Default,,0,0,0,,Уау...
Dialogue: 0,1:07:17.95,1:07:19.53,Default,,0,0,0,,Ке… Кероро…
Dialogue: 0,1:07:21.95,1:07:23.53,Default,,0,0,0,,Кероро~!
Dialogue: 0,1:07:23.62,1:07:24.95,Default,,0,0,0,,Сержант!
Dialogue: 0,1:07:25.45,1:07:26.50,Default,,0,0,0,,Капитан!
Dialogue: 0,1:07:27.04,1:07:28.71,Default,,0,0,0,,Сержант~!
Dialogue: 0,1:07:33.50,1:07:34.55,Default,,0,0,0,,Кероро!
Dialogue: 0,1:07:34.63,1:07:35.63,Default,,0,0,0,,Сержант!
Dialogue: 0,1:07:35.71,1:07:38.80,Default,,0,0,0,,Жауап беріңіз! Сержант~!
Dialogue: 0,1:07:38.88,1:07:42.09,Default,,0,0,0,,Әй, сержант! Сержант!
Dialogue: 0,1:07:42.85,1:07:43.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:57.69,1:07:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:00.74,1:08:02.41,Default,,0,0,0,,Сержант қатты...
Dialogue: 0,1:08:02.49,1:08:03.78,Default,,0,0,0,,Құсу... Фуюки-доно
Dialogue: 0,1:08:03.87,1:08:04.91,Default,,0,0,0,,Кероро
Dialogue: 0,1:08:04.99,1:08:06.83,Default,,0,0,0,,Бұл Лана-доноға арналған...
Dialogue: 0,1:08:07.75,1:08:08.58,Default,,0,0,0,,Шамасы
Dialogue: 0,1:08:08.66,1:08:10.75,Default,,0,0,0,,Стратегия жақсы өткен сияқты.
Dialogue: 0,1:08:11.67,1:08:12.29,Default,,0,0,0,,Иә
Dialogue: 0,1:08:12.79,1:08:14.67,Default,,0,0,0,,Сержантқа рахмет.
Dialogue: 0,1:08:14.75,1:08:16.17,Default,,0,0,0,,Сержант!
Dialogue: 0,1:08:16.96,1:08:18.09,Default,,0,0,0,,Кероро!
Dialogue: 0,1:08:18.17,1:08:19.51,Default,,0,0,0,,Капитан!
Dialogue: 0,1:08:19.59,1:08:21.80,Default,,0,0,0,,Кероро, сен тірісің!
Dialogue: 0,1:08:21.88,1:08:24.14,Default,,0,0,0,,Жарайсыңдар, сержант!
Dialogue: 0,1:08:24.22,1:08:27.68,Default,,0,0,0,,Ах! Барлығы қалыпты жағдайға орала алды.
Dialogue: 0,1:08:28.18,1:08:29.85,Default,,0,0,0,,О... бұл рас.
Dialogue: 0,1:08:29.93,1:08:33.31,Default,,0,0,0,,Бірақ бұл жолы жақсы болар деп ойлаймын?
Dialogue: 0,1:08:33.40,1:08:34.69,Default,,0,0,0,,Бұл Ақу Ақу ма?
Dialogue: 0,1:08:34.77,1:08:35.77,Default,,0,0,0,,На~ни
Dialogue: 0,1:08:35.86,1:08:38.98,Default,,0,0,0,,Осыншама жарыққа түсу қанша тұрады...
Dialogue: 0,1:08:39.07,1:08:39.78,Default,,0,0,0,,Уау!
Dialogue: 0,1:08:39.86,1:08:41.49,Default,,0,0,0,,Ағай! артта!
Dialogue: 0,1:08:41.57,1:08:43.20,Default,,0,0,0,,Аку Ақудан аман қалған адам!
Dialogue: 0,1:08:43.28,1:08:43.78,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:08:44.57,1:08:45.45,Default,,0,0,0,,Aku Aku~!
Dialogue: 0,1:08:45.53,1:08:46.95,Default,,0,0,0,,Құсу!
Dialogue: 0,1:08:47.79,1:08:48.54,Default,,0,0,0,,Аку?
Dialogue: 0,1:08:49.54,1:08:51.83,Default,,0,0,0,,(Аку Акудың күресіп жатқан дыбысы)
Dialogue: 0,1:08:51.91,1:08:53.00,Default,,0,0,0,,Ариса-чан!
Dialogue: 0,1:08:53.58,1:08:55.84,Default,,0,0,0,,Бұл жақсы өлшем. Мен мұны жей аламын.
Dialogue: 0,1:08:55.92,1:08:57.46,Default,,0,0,0,,-Итадаки -Ау!
Dialogue: 0,1:08:57.55,1:09:00.13,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,1:09:01.63,1:09:03.47,Default,,0,0,0,,(Фуюкидің күлкісі)
Dialogue: 0,1:09:03.55,1:09:04.68,Default,,0,0,0,,Джеро герори
Dialogue: 0,1:09:04.76,1:09:07.68,Default,,0,0,0,,(Фуюки мен оның достарының күлкісі)
Dialogue: 0,1:09:07.76,1:09:10.27,Default,,0,0,0,,(Джиророның күлкісі)
Dialogue: 0,1:09:11.31,1:09:12.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:12.31,1:09:17.86,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:09:23.45,1:09:25.99,Default,,0,0,0,,Не? Иокун кетіп қалды ма?
Dialogue: 0,1:09:26.07,1:09:27.70,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,1:09:28.20,1:09:29.62,Default,,0,0,0,,Ішінде бір жерде.
Dialogue: 0,1:09:29.70,1:09:31.66,Default,,0,0,0,,Бір кездері Io болған адам
Dialogue: 0,1:09:31.75,1:09:32.79,Default,,0,0,0,,Құсу…
Dialogue: 0,1:09:33.33,1:09:34.71,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:09:34.79,1:09:35.42,Default,,0,0,0,,Сол кезде...
Dialogue: 0,1:09:42.46,1:09:46.76,Default,,0,0,0,,Керороны өткенге жіберу үшін Ионың барлық күші қажет болды.
Dialogue: 0,1:09:46.84,1:09:49.35,Default,,0,0,0,,Ал мен адам кейпімді бұдан былай сақтай алмадым.
Dialogue: 0,1:09:49.43,1:09:51.77,Default,,0,0,0,,Мен... Бұл менің кінәм...
Dialogue: 0,1:09:51.85,1:09:52.73,Default,,0,0,0,,Мұндай жерде дүкен ашу—
Dialogue: 0,1:09:53.43,1:09:55.02,Default,,0,0,0,,Ионың тілегі орындалды
Dialogue: 0,1:09:55.10,1:09:56.56,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,1:09:56.65,1:09:58.52,Default,,0,0,0,,Лана... Лана-доно...
Dialogue: 0,1:09:59.02,1:10:00.86,Default,,0,0,0,,Бірақ бұл ұят.
Dialogue: 0,1:10:01.36,1:10:03.15,Default,,0,0,0,,Дос бола білсек те...
Dialogue: 0,1:10:03.65,1:10:05.82,Default,,0,0,0,,Достар? Бұл не?
Dialogue: 0,1:10:05.91,1:10:08.24,Default,,0,0,0,,Достарыңызды білмейсіз бе?
Dialogue: 0,1:10:08.32,1:10:09.99,Default,,0,0,0,,Ойланып қарасам, мен бұл туралы бұрын айттым...
Dialogue: 0,1:10:10.08,1:10:13.33,Default,,0,0,0,,Құсу... Біз доспыз.
Dialogue: 0,1:10:13.83,1:10:16.75,Default,,0,0,0,,Ұрысқан кездер болады, жүзіңді көргім келмейді.
Dialogue: 0,1:10:17.42,1:10:20.25,Default,,0,0,0,,Түсініспеушілікті жоя алсаңыз, ол шын мәнінде жақсы жігіт.
Dialogue: 0,1:10:20.34,1:10:22.50,Default,,0,0,0,,Сіз осында болғаныңызда сонда болатыныңызға сенімдімін.
Dialogue: 0,1:10:23.09,1:10:24.22,Default,,0,0,0,,Сол үшін
Dialogue: 0,1:10:24.30,1:10:26.97,Default,,0,0,0,,Сіз бәрін ұмытып, қолыңыздан келгеннің бәрін жасай аласыз...
Dialogue: 0,1:10:27.05,1:10:28.01,Default,,0,0,0,,- Не? - (Фуюки/Кероро) Иә?
Dialogue: 0,1:10:28.09,1:10:30.55,Default,,0,0,0,,Бұл барлығына қалыпты жағдай.
Dialogue: 0,1:10:30.64,1:10:31.97,Default,,0,0,0,,Сонда бәріміз доспыз
Dialogue: 0,1:10:32.60,1:10:34.48,Default,,0,0,0,,Барлығы достар...
Dialogue: 0,1:10:34.56,1:10:36.10,Default,,0,0,0,,Осы аралда
Dialogue: 0,1:10:36.19,1:10:40.65,Default,,0,0,0,,Жерде өмір сүретіндер Теңізде өмір сүретіндер Ғарышта өмір сүретіндер
Dialogue: 0,1:10:41.27,1:10:44.32,Default,,0,0,0,,Ио, Лана, Фуюки және Кероро
Dialogue: 0,1:10:44.40,1:10:47.66,Default,,0,0,0,,Ал Макемейк екеуі дос!
Dialogue: 0,1:10:49.53,1:10:50.91,Default,,0,0,0,,Негізі, Ақу Ақу да.
Dialogue: 0,1:10:50.99,1:10:52.66,Default,,0,0,0,,Аку Ақуға дейін?
Dialogue: 0,1:10:52.74,1:10:53.45,Default,,0,0,0,,Иә
Dialogue: 0,1:10:54.12,1:10:56.37,Default,,0,0,0,,Аку Аку, Мана, Мәке де
Dialogue: 0,1:10:56.46,1:10:58.04,Default,,0,0,0,,Біз бәріміз бірге туылғанбыз
Dialogue: 0,1:10:58.12,1:10:58.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:58.75,1:11:02.00,Default,,0,0,0,,Ақу Ақу жаңғыртылса, Мана т.б.
Dialogue: 0,1:11:02.09,1:11:04.96,Default,,0,0,0,,Аку Аку жоғалғанда, Мана және басқалар да жоғалады.
Dialogue: 0,1:11:05.05,1:11:06.92,Default,,0,0,0,,Ла... Лана-чан?
Dialogue: 0,1:11:08.05,1:11:11.72,Default,,0,0,0,,Бірақ Лана мен басқалары мені мәңгі бақылап отырады.
Dialogue: 0,1:11:11.80,1:11:13.72,Default,,0,0,0,,Әркім туралы мәңгілік
Dialogue: 0,1:11:13.81,1:11:16.89,Default,,0,0,0,,Фуюки Керороға рахмет
Dialogue: 0,1:11:17.43,1:11:19.98,Default,,0,0,0,,Бір күні кездескенше! Иолана!
Dialogue: 0,1:11:20.06,1:11:21.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:22.82,1:11:24.86,Default,,0,0,0,,Иолана~!
Dialogue: 0,1:11:27.82,1:11:28.82,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:37.29,1:11:37.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:38.91,1:11:39.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:41.04,1:11:41.58,Default,,0,0,0,,Хехе
Dialogue: 0,1:11:42.08,1:11:43.46,Default,,0,0,0,,Құсу
Dialogue: 0,1:11:45.17,1:11:45.96,Default,,0,0,0,,Кероро!
Dialogue: 0,1:11:48.47,1:11:51.84,Default,,0,0,0,,Иолана~!
Dialogue: 0,1:11:51.93,1:11:53.93,Default,,0,0,0,,♪～
Dialogue: 0,1:14:13.03,1:14:15.03,Default,,0,0,0,,～♪
Dialogue: 0,1:14:15.65,1:14:20.41,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,1:14:21.91,1:14:27.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory