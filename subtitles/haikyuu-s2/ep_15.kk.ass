Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.83,0:00:38.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:38.87,0:00:42.77,Default,,0,0,0,,≪Бұл позиция дұрыс➡
Dialogue: 0,0:00:42.77,0:00:44.77,Default,,0,0,0,,Бұл бұрыш…≫
Dialogue: 0,0:00:46.31,0:00:48.41,Default,,0,0,0,,≪Don Smack! ≫
Dialogue: 0,0:00:56.89,0:00:59.05,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:00:59.05,0:01:01.22,Default,,0,0,0,,Уау, мен мұны шындап жасадым.
Dialogue: 0,0:01:01.22,0:01:04.29,Default,,0,0,0,,Тобио-кун сияқты дәл болу мүмкін емес.➡
Dialogue: 0,0:01:04.29,0:01:08.83,Default,,0,0,0,,Керемет заттарды көшіргіңіз келе ме? Хехе!
Dialogue: 0,0:01:08.83,0:01:12.40,Default,,0,0,0,,Бұл тек егіздер ғана болатын сенім. ➡
Dialogue: 0,0:01:12.40,0:01:15.17,Default,,0,0,0,,Бауырлар керемет.
Dialogue: 0,0:01:15.17,0:01:17.17,Default,,0,0,0,,≪Сенім...≫
Dialogue: 0,0:01:17.17,0:01:20.94,Default,,0,0,0,,≪Мен Цумға шынымен сенбеймін. ➡
Dialogue: 0,0:01:20.94,0:01:22.95,Default,,0,0,0,,Адамдардың айтқанын тыңдағанды ұнатпаймын≫
Dialogue: 0,0:01:22.95,0:01:25.91,Default,,0,0,0,,Сэм, сен қайда бардың? Мені оят! ))
Dialogue: 0,0:01:25.91,0:01:28.95,Default,,0,0,0,,((Мен сені ояттым. Мен кезекшілікте болдым, бірінші барыңдар дедім))
Dialogue: 0,0:01:28.95,0:01:31.29,Default,,0,0,0,,≪қарызға бергеніңізді қайтарыңыз≫
Dialogue: 0,0:01:31.29,0:01:33.99,Default,,0,0,0,,((Менің курткам)) ((Маған қарызға бер))
Dialogue: 0,0:01:33.99,0:01:37.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:37.13,0:01:39.10,Default,,0,0,0,,) ()
Dialogue: 0,0:01:39.10,0:01:42.00,Default,,0,0,0,,≪Өтірікші. ➡
Dialogue: 0,0:01:42.00,0:01:45.00,Default,,0,0,0,,Бірақ сенудің қажеті жоқ.
Dialogue: 0,0:01:45.00,0:01:48.34,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:48.34,0:01:50.74,Default,,0,0,0,,≪Мен доптың келе жатқанын білемін≫
Dialogue: 0,0:01:52.14,0:02:11.29,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:11.29,0:02:15.66,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:02:15.66,0:02:20.67,Default,,0,0,0,,♬ Мен ең төменгі талаптарды білемін.
Dialogue: 0,0:02:20.67,0:02:25.04,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:02:25.04,0:02:31.51,Default,,0,0,0,,♬ Тоқтасаң, орындалмайды.
Dialogue: 0,0:02:31.51,0:02:35.85,Default,,0,0,0,,♬ Егер сіз тырыспасаңыз, сіз одан ләззат ала алмайсыз.
Dialogue: 0,0:02:35.85,0:02:40.69,Default,,0,0,0,,♬ Ең қызық нәрсе
Dialogue: 0,0:02:40.69,0:02:45.23,Default,,0,0,0,,♬ жеткіліксіз артық емес
Dialogue: 0,0:02:45.23,0:02:49.13,Default,,0,0,0,,♬ Ей, сен аштан өліп жатырсың ғой?
Dialogue: 0,0:02:51.73,0:02:54.27,Default,,0,0,0,,♬ Әділ және әділ
Dialogue: 0,0:02:54.27,0:02:57.04,Default,,0,0,0,,♬ Қазір «қазір» алдында
Dialogue: 0,0:02:57.04,0:03:01.04,Default,,0,0,0,,♬ Ащы да, тәтті де шындықтан ләззат алыңыз.
Dialogue: 0,0:03:01.04,0:03:03.08,Default,,0,0,0,,♬ ұлы мәртебе
Dialogue: 0,0:03:03.08,0:03:06.05,Default,,0,0,0,,♬ Мен фронтальды серпіліс жасағым келеді.
Dialogue: 0,0:03:06.05,0:03:11.69,Default,,0,0,0,,♬ Қызықты көрінеді. Сізге ұнайтын сияқты.
Dialogue: 0,0:03:11.69,0:03:17.29,Default,,0,0,0,,♬ Қазір тоқтап қалмаңыз, одан толық рахат алыңыз және күліңіз
Dialogue: 0,0:03:17.29,0:03:20.80,Default,,0,0,0,,♬ Күлейік
Dialogue: 0,0:03:22.20,0:03:24.17,Default,,0,0,0,,Қара!
Dialogue: 0,0:03:26.27,0:03:28.60,Default,,0,0,0,,Дайчи-сан! (Савамура) Қарғыс атсын!
Dialogue: 0,0:03:28.60,0:03:30.61,Default,,0,0,0,,Асахи мырза!
Dialogue: 0,0:03:30.61,0:03:34.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:34.44,0:03:36.45,Default,,0,0,0,,Ах... Бип!
Dialogue: 0,0:03:36.45,0:03:38.45,Default,,0,0,0,,Жоооооооооуу!
Dialogue: 0,0:03:40.45,0:03:43.29,Default,,0,0,0,,Бұл да жылдам! Карасуно бірінші курс дуэті➡
Dialogue: 0,0:03:43.29,0:03:46.22,Default,,0,0,0,,Жылдамдық сезімі ешкімнен кем емес.
Dialogue: 0,0:03:46.22,0:03:49.79,Default,,0,0,0,,Сіз жиіркеніштісіз. Мені көп мақтамаңыз.
Dialogue: 0,0:03:52.23,0:03:54.20,Default,,0,0,0,,Қара!
Dialogue: 0,0:03:55.86,0:03:57.87,Default,,0,0,0,,Рай!
Dialogue: 0,0:04:00.40,0:04:03.57,Default,,0,0,0,,Уау! (Савамура) Арх! Кешіріңіз қақпақ!
Dialogue: 0,0:04:05.11,0:04:07.81,Default,,0,0,0,,≪Тобио-кун, қабылдау ретсіз болғанда➡
Dialogue: 0,0:04:07.81,0:04:09.81,Default,,0,0,0,,Асықты қолданады. ➡
Dialogue: 0,0:04:09.81,0:04:12.81,Default,,0,0,0,,Олар бізге жылдам шабуылымызды көрсеткеннен кейін➡
Dialogue: 0,0:04:12.81,0:04:15.82,Default,,0,0,0,,Мұнда біз...➡ қолданамыз
Dialogue: 0,0:04:15.82,0:04:17.82,Default,,0,0,0,,Шойо-кун≫
Dialogue: 0,0:04:17.82,0:04:20.86,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:20.86,0:04:23.86,Default,,0,0,0,,Дыбыстық сигнал! Хехе.
Dialogue: 0,0:04:23.86,0:04:28.83,Default,,0,0,0,,Өшір! Инаризаки: Бұл жолы біз негізгі отбасын мөрлеп алдық!
Dialogue: 0,0:04:28.83,0:04:33.37,Default,,0,0,0,,Қазіргі блок Хината-кунның таңдайтынына сенімді болдым.
Dialogue: 0,0:04:33.37,0:04:37.21,Default,,0,0,0,,Хината Кагеяма Қал! Тым қызып кетпеңіз.
Dialogue: 0,0:04:37.21,0:04:40.34,Default,,0,0,0,,Уф... Мен қалыптымын.
Dialogue: 0,0:04:40.34,0:04:42.34,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,0:04:44.01,0:04:47.02,Default,,0,0,0,,Дабыл! (Диктор) Мия ағалары тоқтамайды! ➡
Dialogue: 0,0:04:47.02,0:04:49.99,Default,,0,0,0,,Ең мықты қарсылас!
Dialogue: 0,0:04:49.99,0:04:54.69,Default,,0,0,0,,Бұл №10 шағын, бірақ таңғажайып ұпай жинайтын күші бар➡
Dialogue: 0,0:04:54.69,0:04:58.69,Default,,0,0,0,,Бірегей шабуыл оңай қолданылады➡
Dialogue: 0,0:04:58.69,0:05:02.23,Default,,0,0,0,,Ол шұңқыр болады. (Гибарида) Хмм…. ➡
Dialogue: 0,0:05:02.23,0:05:04.37,Default,,0,0,0,,Мен солай ойлаймын. ➡
Dialogue: 0,0:05:04.37,0:05:06.94,Default,,0,0,0,,Ол осы уақытқа дейін Кагеямасыз болды➡
Dialogue: 0,0:05:06.94,0:05:10.81,Default,,0,0,0,,Менің ойымша, онша бағаланған жоқ. ➡
Dialogue: 0,0:05:10.81,0:05:13.54,Default,,0,0,0,,Ал бұдан былай Кагеяма тек сетер болады➡
Dialogue: 0,0:05:13.54,0:05:15.54,Default,,0,0,0,,Өтетін сияқты емеспіз. ➡
Dialogue: 0,0:05:15.54,0:05:19.41,Default,,0,0,0,,Шойо Хината➡ үшін жылдам шабуылға қатысты
Dialogue: 0,0:05:19.41,0:05:23.32,Default,,0,0,0,,Юудың допты оған жеткізетін ойыншысы бар➡
Dialogue: 0,0:05:23.32,0:05:26.15,Default,,0,0,0,,Басқалар бар екенін дәлелдеу.
Dialogue: 0,0:05:26.15,0:05:28.56,Default,,0,0,0,,Бірегей емес➡
Dialogue: 0,0:05:28.56,0:05:31.56,Default,,0,0,0,,Менің ойымша, бұл ол үшін жақсы жаңалық.
Dialogue: 0,0:05:31.56,0:05:33.56,Default,,0,0,0,,Сонымен қатар…➡
Dialogue: 0,0:05:33.56,0:05:37.43,Default,,0,0,0,,Бұл батып кеткен бет емес.
Dialogue: 0,0:05:37.43,0:05:45.21,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:45.21,0:05:47.78,Default,,0,0,0,,Уф... Кешіріңіз қақпақ!
Dialogue: 0,0:05:49.84,0:05:53.28,Default,,0,0,0,,≪Бұл тұрақты және тұрақты емес, Тобио-кун≫
Dialogue: 0,0:05:53.28,0:05:57.92,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:57.92,0:05:59.92,Default,,0,0,0,,Шығар! Бип!
Dialogue: 0,0:05:59.92,0:06:02.99,Default,,0,0,0,,Не? Қара!
Dialogue: 0,0:06:02.99,0:06:06.63,Default,,0,0,0,,Блокты соғу. Карасуно орта мектебінің ұпайы!
Dialogue: 0,0:06:06.63,0:06:08.63,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:06:08.63,0:06:10.63,Default,,0,0,0,,Корай-кун, енді...
Dialogue: 0,0:06:10.63,0:06:13.67,Default,,0,0,0,,Әлгі жігіт көрінді. (Барлығы) Жарайды!
Dialogue: 0,0:06:13.67,0:06:17.14,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:17.14,0:06:19.14,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:19.14,0:06:22.14,Default,,0,0,0,,≪Бұл батылдық немесе басқа нәрсе емес еді➡
Dialogue: 0,0:06:22.14,0:06:25.71,Default,,0,0,0,,Ең жақсы деп санайтын лақтырыңыз. ➡
Dialogue: 0,0:06:25.71,0:06:30.72,Default,,0,0,0,,Бұл нүктеден кейінгінің бәрі сіздің қолыңызда емес дегенді білдіреді. ➡
Dialogue: 0,0:06:30.72,0:06:34.29,Default,,0,0,0,,Бұрын Кагеяма болса, мен бәрін өзім жасайтын едім➡
Dialogue: 0,0:06:34.29,0:06:37.89,Default,,0,0,0,,Мен бұл туралы бірдеңе жасауға тырысқан шығармын≫
Dialogue: 0,0:06:37.89,0:06:39.89,Default,,0,0,0,,Қара!
Dialogue: 0,0:06:39.89,0:06:43.97,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:43.97,0:06:47.00,Default,,0,0,0,,Қарғыс атсын! (Ю) Бұрын! күміс!
Dialogue: 0,0:06:47.00,0:06:49.07,Default,,0,0,0,,Рай!
Dialogue: 0,0:06:49.07,0:06:54.48,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:54.48,0:06:56.48,Default,,0,0,0,,басыңыз! Бип!
Dialogue: 0,0:06:56.48,0:06:58.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:58.98,0:07:02.15,Default,,0,0,0,,Бұл жолы Карасуно тоқтатты! ➡
Dialogue: 0,0:07:02.15,0:07:05.99,Default,,0,0,0,,Мен ағайынды Мияны, 1 курс студенті Кей Цукишиманы тоқтаттым!
Dialogue: 0,0:07:05.99,0:07:09.93,Default,,0,0,0,,Сіз мұны жасадыңыз! Біртүрлі асығыстықтың ең үлкен жауы – ➡
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0,0,0,,Блокаторлардың дағдылануы. иә?
Dialogue: 0,0:07:11.93,0:07:15.93,Default,,0,0,0,,Сонымен, біртүрлі жылдам шабуыл өлтіруші болса➡
Dialogue: 0,0:07:15.93,0:07:17.97,Default,,0,0,0,,Бұл Хинатаны қатты тоқтатты➡
Dialogue: 0,0:07:17.97,0:07:22.50,Default,,0,0,0,,Датекодан Аоне немесе Некомадан Инуока➡
Dialogue: 0,0:07:22.50,0:07:26.17,Default,,0,0,0,,Мен күнделікті оғаш асығысты көретінмін➡
Dialogue: 0,0:07:26.17,0:07:30.18,Default,,0,0,0,,Мен оғаш асықты жек көретін шығармын➡
Dialogue: 0,0:07:30.18,0:07:32.18,Default,,0,0,0,,Цукишима, солай ма?
Dialogue: 0,0:07:32.18,0:07:35.12,Default,,0,0,0,,Мен мұны тоқтатқым келді.
Dialogue: 0,0:07:35.12,0:07:37.85,Default,,0,0,0,,Хмм…. Нану?
Dialogue: 0,0:07:37.85,0:07:42.19,Default,,0,0,0,,Уф! Хмм…. Уф!
Dialogue: 0,0:07:42.19,0:07:44.19,Default,,0,0,0,,Қара!
Dialogue: 0,0:07:52.30,0:07:55.84,Default,,0,0,0,,Onech! Карасуно➡ туралы бірінші рет естіп тұрмын
Dialogue: 0,0:07:55.84,0:07:58.21,Default,,0,0,0,,Дәндері біркелкі.
Dialogue: 0,0:07:58.21,0:08:02.14,Default,,0,0,0,,Сол жылдам шабуыл қорқынышты, самурай күшті, либеро дәмді.
Dialogue: 0,0:08:02.14,0:08:04.15,Default,,0,0,0,,Солға~! (2 адам) Уа.
Dialogue: 0,0:08:04.15,0:08:07.72,Default,,0,0,0,,Сол монахтың 5 саны ше? (Бала) А~ Генки кадры?
Dialogue: 0,0:08:07.72,0:08:10.32,Default,,0,0,0,,Буха! Бұл не!
Dialogue: 0,0:08:10.32,0:08:12.59,Default,,0,0,0,,Хахаха.
Dialogue: 0,0:08:18.23,0:08:20.80,Default,,0,0,0,,Қарғыс атсын... Арх!
Dialogue: 0,0:08:23.10,0:08:25.57,Default,,0,0,0,,Иә!? Бип!
Dialogue: 0,0:08:25.57,0:08:28.90,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:08:28.90,0:08:31.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:31.91,0:08:34.94,Default,,0,0,0,,Менде бәрі жақсы! Хахаха! (Нияма қыздары) Ахаха.
Dialogue: 0,0:08:34.94,0:08:37.58,Default,,0,0,0,,Қараңдар! (Диктор) Инаризаки орта мектебі➡
Dialogue: 0,0:08:37.58,0:08:41.72,Default,,0,0,0,,Дереу күту уақыты. Ағынды физикалық түрде кесіңіз.
Dialogue: 0,0:08:41.72,0:08:44.62,Default,,0,0,0,,Сен сенімдісің, Цукишима емес пе? Эй!
Dialogue: 0,0:08:44.62,0:08:46.69,Default,,0,0,0,,Алдыңғыны түсіну оңай болды➡
Dialogue: 0,0:08:46.69,0:08:49.59,Default,,0,0,0,,Мен оны тоқтата алдым, бірақ бұл жылдам шабуыл қаншалықты қиын➡
Dialogue: 0,0:08:49.59,0:08:52.59,Default,,0,0,0,,Ол өзгермейді. (Танака) Дұрыс.
Dialogue: 0,0:08:52.59,0:08:54.63,Default,,0,0,0,,Хината. иә.
Dialogue: 0,0:08:54.63,0:08:58.60,Default,,0,0,0,,Егіздердің бірін саған қалдырамын. иә?
Dialogue: 0,0:08:58.60,0:09:02.04,Default,,0,0,0,,Мен сенің Инуоканы ойнағаныңды қалаймын.
Dialogue: 0,0:09:02.04,0:09:04.04,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:04.04,0:09:08.44,Default,,0,0,0,,♬～ (жапондық барабан мен шинобэ орындауы)
Dialogue: 0,0:09:08.44,0:09:10.41,Default,,0,0,0,,Қара!
Dialogue: 0,0:09:13.05,0:09:15.95,Default,,0,0,0,,Дыбыстық сигнал! (Барлығы) Ах....
Dialogue: 0,0:09:15.95,0:09:19.09,Default,,0,0,0,,Ештеңе жоқ! (Барлығы) Ха!
Dialogue: 0,0:09:19.09,0:09:21.92,Default,,0,0,0,,Қара!
Dialogue: 0,0:09:21.92,0:09:23.93,Default,,0,0,0,,Дайчи-сан! (Савамура) Қарғыс атсын!
Dialogue: 0,0:09:23.93,0:09:27.90,Default,,0,0,0,,≪Барлығы күшті сервті соғып жатыр≫
Dialogue: 0,0:09:30.93,0:09:33.94,Default,,0,0,0,,Уа, Цукки секірмекші. (Акааши) Иә.
Dialogue: 0,0:09:33.94,0:09:38.67,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:38.67,0:09:42.68,Default,,0,0,0,,≪Мұнда келіңіз! ≫
Dialogue: 0,0:09:42.68,0:09:44.68,Default,,0,0,0,,≪Бұл! ≫
Dialogue: 0,0:09:44.68,0:09:47.85,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:47.85,0:09:51.95,Default,,0,0,0,,≪Tsk... бұл Шираторизавадан≫ қымбат екені сөзсіз
Dialogue: 0,0:09:54.49,0:09:58.33,Default,,0,0,0,,Дабыл! (2 адам) Уау!
Dialogue: 0,0:09:58.33,0:10:01.46,Default,,0,0,0,,Шабуыл мен қорғаныста тамаша өнер көрсетті, Хотару Цукишима!
Dialogue: 0,0:10:01.46,0:10:03.50,Default,,0,0,0,,Қазіргісі қымбат болды.
Dialogue: 0,0:10:03.50,0:10:06.30,Default,,0,0,0,,Олар қандай? Маған жоғары бестік беріңіз.
Dialogue: 0,0:10:06.30,0:10:10.44,Default,,0,0,0,,Цукишиманың жүзі: ``Барлығы жақсы болып жатыр, бірақ мен оны мойындағым келмейді'' деді. ➡
Dialogue: 0,0:10:10.44,0:10:14.31,Default,,0,0,0,,Кагеяманың жүзі: «Мылтық ұшып кетті, мен оны қазір қайтарып беремін» деген.
Dialogue: 0,0:10:14.31,0:10:17.71,Default,,0,0,0,,Энношита Сіз қайдан білдіңіз?
Dialogue: 0,0:10:17.71,0:10:22.12,Default,,0,0,0,,≪Жастар оқу-жаттығу жиынынан бері көп уақыт өтті. ➡
Dialogue: 0,0:10:22.12,0:10:24.19,Default,,0,0,0,,Тобио-кунға не болды≫
Dialogue: 0,0:10:24.19,0:10:29.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:29.12,0:10:31.89,Default,,0,0,0,,Қара!
Dialogue: 0,0:10:31.89,0:10:34.80,Default,,0,0,0,,≪Енді ойын уақыты келді≫
Dialogue: 0,0:10:38.03,0:10:43.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:46.79,0:12:50.70,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:52.13,0:12:54.17,Default,,0,0,0,,Қараңдар! (Киношита) ≪Уф... бұл➡
Dialogue: 0,0:12:54.17,0:12:57.17,Default,,0,0,0,,Қанша рет қолдансам да, үйреніп кететін сияқты емеспін≫
Dialogue: 0,0:12:57.17,0:12:59.51,Default,,0,0,0,,Нейссер. ≪Ал басқа адам➡
Dialogue: 0,0:12:59.51,0:13:04.08,Default,,0,0,0,,Бұл сіз теледидардан, журналдардан көрген жігіттер, солай ма? ≫
Dialogue: 0,0:13:04.08,0:13:08.18,Default,,0,0,0,,Эй Хисаши Киношита, 16 жаста. (Киношита) Мен...
Dialogue: 0,0:13:08.18,0:13:10.52,Default,,0,0,0,,Ағымдағы Инаризаки қабылдағышы –➡
Dialogue: 0,0:13:10.52,0:13:14.52,Default,,0,0,0,,Юи Гиндзима 17 жаста. Мияджи 16 жаста.
Dialogue: 0,0:13:14.52,0:13:17.63,Default,,0,0,0,,Мичинари Акаги 18 жаста. ➡
Dialogue: 0,0:13:17.63,0:13:19.63,Default,,0,0,0,,Міне! Ах.
Dialogue: 0,0:13:22.00,0:13:26.63,Default,,0,0,0,,≪Басқа адам университет студенті, қоғам мүшесі немесе шетелдік емес≫
Dialogue: 0,0:13:26.63,0:13:29.54,Default,,0,0,0,,Қара!
Dialogue: 0,0:13:29.54,0:13:31.51,Default,,0,0,0,,Уф….
Dialogue: 0,0:13:33.54,0:13:36.08,Default,,0,0,0,,Цк... мм! (Сугавара/Ямагучи) Керемет қызмет!
Dialogue: 0,0:13:36.08,0:13:38.08,Default,,0,0,0,,Ах.
Dialogue: 0,0:13:38.08,0:13:40.72,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:40.72,0:13:42.75,Default,,0,0,0,,) ((Сізге➡
Dialogue: 0,0:13:42.75,0:13:46.59,Default,,0,0,0,,Мен оны Инуокаға тапсырамын деп ойлаймын)) ()
Dialogue: 0,0:13:46.59,0:13:49.39,Default,,0,0,0,,((Хината Мияджиді тамаша белгілейді.➡
Dialogue: 0,0:13:49.39,0:13:52.36,Default,,0,0,0,,Оның орнына, сол жақ орталықтан шабуылдар үшін ➡
Dialogue: 0,0:13:52.36,0:13:56.53,Default,,0,0,0,,Хинатадан басқа екі адам міндетті түрде екі алады)) ((Шаа!))
Dialogue: 0,0:13:56.53,0:13:58.70,Default,,0,0,0,,((Жүгелуі бар блоктар үшін ➡
Dialogue: 0,0:13:58.70,0:14:01.84,Default,,0,0,0,,Хинатаның жетістіктері командадағы ең жоғары деңгей➡
Dialogue: 0,0:14:01.84,0:14:05.07,Default,,0,0,0,,Реакция да жылдам. Біз жақсы бәсекелесе аламыз))
Dialogue: 0,0:14:05.07,0:14:12.41,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:14:12.41,0:14:14.45,Default,,0,0,0,,() (Танака)((Цукишима➡
Dialogue: 0,0:14:14.45,0:14:16.45,Default,,0,0,0,,Маза бермеңіз))
Dialogue: 0,0:14:18.95,0:14:21.42,Default,,0,0,0,,≪Мен мұны істей аламын! ≫
Dialogue: 0,0:14:21.42,0:14:23.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.79,0:14:29.26,Default,,0,0,0,,Хината Мияджиге міндеттенеді! Гах...
Dialogue: 0,0:14:29.26,0:14:31.23,Default,,0,0,0,,басыңыз!
Dialogue: 0,0:14:33.27,0:14:35.94,Default,,0,0,0,,≪Мен түсіндім! ≫
Dialogue: 0,0:14:35.94,0:14:37.94,Default,,0,0,0,,Дыбыстық сигнал! (Диктор) Шешілді! ➡
Dialogue: 0,0:14:37.94,0:14:42.44,Default,,0,0,0,,164см блоктар 183см!
Dialogue: 0,0:14:42.44,0:14:44.45,Default,,0,0,0,,♬~
Dialogue: 0,0:14:44.45,0:14:48.95,Default,,0,0,0,,Карасуно орта мектебі бірінші рет тең түсті!
Dialogue: 0,0:14:48.95,0:14:52.59,Default,,0,0,0,,Мимими... Көрдің бе? Кагеяма-кун!
Dialogue: 0,0:14:52.59,0:14:54.59,Default,,0,0,0,,Бұл кездейсоқтық! Сіз ең жақсысыз➡
Dialogue: 0,0:14:54.59,0:14:57.39,Default,,0,0,0,,Сіз таң қалуыңыз керек. Уф!
Dialogue: 0,0:14:57.39,0:15:00.26,Default,,0,0,0,,≪Тағы да көктем қандай керемет≫
Dialogue: 0,0:15:00.26,0:15:03.23,Default,,0,0,0,,≪Кенеттен көзге келеді≫
Dialogue: 0,0:15:03.23,0:15:06.87,Default,,0,0,0,,Міндеттеме Мен таң қалдым. Мен оны істедім.
Dialogue: 0,0:15:06.87,0:15:09.97,Default,,0,0,0,,Сен істедің, Хината-кун. Иә.
Dialogue: 0,0:15:09.97,0:15:12.71,Default,,0,0,0,,≪Бірақ қазір бұл тосын шабуыл сияқты. ➡
Dialogue: 0,0:15:12.71,0:15:14.71,Default,,0,0,0,,Енді менімен бірге болыңыз≫
Dialogue: 0,0:15:14.71,0:15:17.75,Default,,0,0,0,,Қара!
Dialogue: 0,0:15:17.75,0:15:20.62,Default,,0,0,0,,Жарайсыңдар! Тон (дыбыс қабылдау)
Dialogue: 0,0:15:20.62,0:15:22.75,Default,,0,0,0,,Дыбыстық сигнал! Қарғыс атсын!
Dialogue: 0,0:15:22.75,0:15:24.82,Default,,0,0,0,,Оған жай ғана жол бермеңіз. ➡
Dialogue: 0,0:15:24.82,0:15:27.39,Default,,0,0,0,,Менің ойымша, бұл екі рет қатарынан батылдық шығар, Юукун.
Dialogue: 0,0:15:28.79,0:15:31.59,Default,,0,0,0,,Nisser Nisser! (Киношита) Қондырғышқа➡
Dialogue: 0,0:15:31.59,0:15:35.10,Default,,0,0,0,,Мен оны астына пайдалануға да жете алмадым.
Dialogue: 0,0:15:35.10,0:15:38.13,Default,,0,0,0,,≪Сіз жақынырақ жерді көздеуіңіз керек еді≫
Dialogue: 0,0:15:38.13,0:15:40.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:40.10,0:15:42.14,Default,,0,0,0,,Мүмкіндік добы! Тонна!
Dialogue: 0,0:15:42.14,0:15:46.17,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:46.17,0:15:49.18,Default,,0,0,0,,Уф! Қарғыс атсын!
Dialogue: 0,0:15:49.18,0:15:53.51,Default,,0,0,0,,Хмф! (Диктор) Доп тордың үстінде!
Dialogue: 0,0:15:53.51,0:15:58.02,Default,,0,0,0,,≪Басқа адам университет студенті, қоғам мүшесі немесе шетелдік емес. ➡
Dialogue: 0,0:15:58.02,0:16:02.02,Default,,0,0,0,,Бірақ мен түсіндім. Біз бір мектеп оқушылары емеспіз. ➡
Dialogue: 0,0:16:02.02,0:16:06.79,Default,,0,0,0,,Ол маған қарағанда көп жұмыс істейтін, тәжірибесі мол орта мектеп оқушысы. ➡
Dialogue: 0,0:16:06.79,0:16:09.50,Default,,0,0,0,,Мүмкіндіктер тең емес. ➡
Dialogue: 0,0:16:09.50,0:16:12.50,Default,,0,0,0,,Бірақ бар! Егер менің оғаш адамым бірінші курста болса➡
Dialogue: 0,0:16:12.50,0:16:14.47,Default,,0,0,0,,Тағы да бар! ≫
Dialogue: 0,0:16:16.04,0:16:19.11,Default,,0,0,0,,≪Бұл шынымен де керемет көктем≫
Dialogue: 0,0:16:21.04,0:16:25.01,Default,,0,0,0,,Дыбыстық сигнал! ≪Ештеңе артық, кем емес≫
Dialogue: 0,0:16:26.55,0:16:30.72,Default,,0,0,0,,Инаризаки шабуылда және торда қорғаныста басым болды!
Dialogue: 0,0:16:30.72,0:16:34.56,Default,,0,0,0,,Иә? Менің ойымша, бұл мен ойлағандай жауап бермейді.
Dialogue: 0,0:16:34.56,0:16:39.06,Default,,0,0,0,,Хмм... уф. (Ямагучи) Ах~!
Dialogue: 0,0:16:39.06,0:16:42.93,Default,,0,0,0,,Оған көмектесу мүмкін емес, тәжірибе ұпайлары әртүрлі. ➡
Dialogue: 0,0:16:42.93,0:16:44.93,Default,,0,0,0,,Ал, қазіргі ұрыс-керіс жай ғана кездейсоқтық болды➡
Dialogue: 0,0:16:44.93,0:16:47.07,Default,,0,0,0,,Жеке матчтарда сізді бұғаттаудың себебі неде?
Dialogue: 0,0:16:47.07,0:16:49.57,Default,,0,0,0,,Бұл стресс болуы керек. ➡
Dialogue: 0,0:16:49.57,0:16:53.31,Default,,0,0,0,,Менің жолым түсіп, біріншісін тоқтаттым, тіпті одан да көп.
Dialogue: 0,0:16:53.31,0:16:57.21,Default,,0,0,0,,Инаризаки оғаштың жылдам шабуылдарына жауап берді. ➡
Dialogue: 0,0:16:57.21,0:17:00.85,Default,,0,0,0,,«Адасқан» тыйымды босатайық. Ах!
Dialogue: 0,0:17:00.85,0:17:03.89,Default,,0,0,0,,Иә? Эй! Жоспарлағандай.
Dialogue: 0,0:17:03.89,0:17:07.36,Default,,0,0,0,,Сіз ұмыттыңыз. Уф...
Dialogue: 0,0:17:07.36,0:17:11.69,Default,,0,0,0,,Басында ойланып қалдым, егіздердің жылдам шабуылын көрген соң➡
Dialogue: 0,0:17:11.69,0:17:14.83,Default,,0,0,0,,Менің бар ойым, мен жылдамырақ болдым...➡
Dialogue: 0,0:17:14.83,0:17:18.27,Default,,0,0,0,,сияқты нәрсе бар ма? Куу~!
Dialogue: 0,0:17:18.27,0:17:21.34,Default,,0,0,0,,Тым қызып кетпеңіз. Бүгін екінші рет.
Dialogue: 0,0:17:21.34,0:17:24.64,Default,,0,0,0,,Иә. (Цунашин) Төбелер немесе блоктар жоқ.
Dialogue: 0,0:17:24.64,0:17:26.64,Default,,0,0,0,,Қара!
Dialogue: 0,0:17:29.71,0:17:33.78,Default,,0,0,0,,Арх! (Сугавара) Тағы бір рет Тағы бір рет!
Dialogue: 0,0:17:33.78,0:17:35.78,Default,,0,0,0,,Керемет қабыл алыңыздар!
Dialogue: 0,0:17:38.29,0:17:41.26,Default,,0,0,0,,Onech! (Савамура) Кешіріңіз, жақын қалды!
Dialogue: 0,0:17:42.82,0:17:47.26,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:17:47.26,0:17:50.33,Default,,0,0,0,,Ах~. (Одзиро) Қарғыс атқыр, мен өзімді күштеп көрдім.
Dialogue: 0,0:17:50.33,0:17:53.63,Default,,0,0,0,,Жалқаулықты доғар, Сэм! Жақсы! Босаңсу біртүрлі.
Dialogue: 0,0:17:53.63,0:17:57.44,Default,,0,0,0,,Өтірікші! Мен әзірге алдамшы ретінде әрекет етемін➡
Dialogue: 0,0:17:57.44,0:18:00.11,Default,,0,0,0,,Сіз қалай енгізесіз? Бұл анық! (Хару) Бұл тітіркендіргіш! ➡
Dialogue: 0,0:18:00.11,0:18:02.81,Default,,0,0,0,,Бар күшіммен жол бойына секірсем, мен оны аяғына дейін жеткізе аламын.
Dialogue: 0,0:18:02.81,0:18:05.65,Default,,0,0,0,,Соқсаң, шешілді, абай бол! Немесе➡
Dialogue: 0,0:18:05.65,0:18:09.42,Default,,0,0,0,,Сол кішкентай блоктан қорқасың ба?! (Осаму) Қорқынышқа себеп бар ма!
Dialogue: 0,0:18:09.42,0:18:12.35,Default,,0,0,0,,Шынымен?! Ах. О... ой.
Dialogue: 0,0:18:12.35,0:18:14.36,Default,,0,0,0,,Қарғыс атсын... Иә?
Dialogue: 0,0:18:15.79,0:18:17.79,Default,,0,0,0,,≪Қорықпайсың ба? ≫
Dialogue: 0,0:18:17.79,0:18:20.06,Default,,0,0,0,,≪Егер сіз қорқынышты блок алсаңыз...➡
Dialogue: 0,0:18:21.53,0:18:24.53,Default,,0,0,0,,Мистер Аоне. Бірақ Датеко бұл➡
Dialogue: 0,0:18:24.53,0:18:27.13,Default,,0,0,0,,Әдетте екі немесе одан да көп дана...≫
Dialogue: 0,0:18:27.13,0:18:29.14,Default,,0,0,0,,Қара!
Dialogue: 0,0:18:32.17,0:18:34.18,Default,,0,0,0,,≪1 – 1…≫
Dialogue: 0,0:18:34.18,0:18:37.45,Default,,0,0,0,,≪Жеке матчта ең жек көретін блокатор кім болды? ≫
Dialogue: 0,0:18:39.18,0:18:43.68,Default,,0,0,0,,≪Бұл кім? Ол кім? Жиренішті блок≫
Dialogue: 0,0:18:43.68,0:18:46.52,Default,,0,0,0,,≪Бұл кім? Маған ұнамайды... Бұл кім? Ол кім? ≫
Dialogue: 0,0:18:46.52,0:18:48.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:48.52,0:18:52.53,Default,,0,0,0,,≪Босаңсытпаңыз, ерінбеңіз≫ ≪Мен түсінемін≫
Dialogue: 0,0:18:52.53,0:18:56.53,Default,,0,0,0,,≪1-on-1, мен ең жек көретін блок...≫
Dialogue: 0,0:18:56.53,0:18:59.00,Default,,0,0,0,,((Айқышты соқпа, жарай ма?➡
Dialogue: 0,0:18:59.00,0:19:01.00,Default,,0,0,0,,Сіз соғуға болмайды, солай ма? ))
Dialogue: 0,0:19:01.00,0:19:09.51,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:09.51,0:19:11.58,Default,,0,0,0,,Ах! (Нишитани) Олай болса!
Dialogue: 0,0:19:11.58,0:19:14.32,Default,,0,0,0,,≪Тура соққы≫
Dialogue: 0,0:19:14.32,0:19:18.42,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:18.42,0:19:21.32,Default,,0,0,0,,≪Хмм? 10 саны кірмейді≫
Dialogue: 0,0:19:21.32,0:19:24.33,Default,,0,0,0,,≪Араласыңыз≫
Dialogue: 0,0:19:24.33,0:19:26.29,Default,,0,0,0,,≪Синхрондалған шабуыл! ≫
Dialogue: 0,0:19:26.29,0:19:29.83,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:29.83,0:19:32.17,Default,,0,0,0,,Дыбыстық сигнал! (2 адам) Тынш!
Dialogue: 0,0:19:32.17,0:19:36.50,Default,,0,0,0,,Карасуно орта мектебінде үзіліс! Тағы байлаңыз!
Dialogue: 0,0:19:36.50,0:19:39.91,Default,,0,0,0,,Шойо Әдейі солай ма? Жұқа.
Dialogue: 0,0:19:39.91,0:19:43.24,Default,,0,0,0,,Мен ол блокты қатты жек көретінмін... (Нишитани) Әй?
Dialogue: 0,0:19:43.24,0:19:46.85,Default,,0,0,0,,Хеппушун! (Ханамаки) Өтінемін, өзіңді күт.
Dialogue: 0,0:19:46.85,0:19:48.85,Default,,0,0,0,,Мен мұны не болса да істеймін.
Dialogue: 0,0:19:48.85,0:19:51.92,Default,,0,0,0,,Ассу! Дәл қазір шешім қабылдаған сен емессің.
Dialogue: 0,0:19:51.92,0:19:56.19,Default,,0,0,0,,Иә. Мен енді тек шабуыл жасайтын адам емеспін...
Dialogue: 0,0:19:56.19,0:19:59.23,Default,,0,0,0,,Тыңдаңыз! Сәлем Кагеяма!
Dialogue: 0,0:19:59.23,0:20:02.83,Default,,0,0,0,,Менің қарным ашылып жатыр. иә?
Dialogue: 0,0:20:02.83,0:20:04.83,Default,,0,0,0,,Қара!
Dialogue: 0,0:20:04.83,0:20:08.54,Default,,0,0,0,,Карасуно күткеннен де жақсы жұмыс істейді.
Dialogue: 0,0:20:08.54,0:20:12.61,Default,,0,0,0,,Шайқас құрамы - жаңадан келген адам, ол жоғарырақ тапсырманы көтереді➡
Dialogue: 0,0:20:12.61,0:20:16.31,Default,,0,0,0,,Инаризаки Карасуномен күресуге тырысады➡
Dialogue: 0,0:20:16.31,0:20:18.31,Default,,0,0,0,,Әзірге. ➡
Dialogue: 0,0:20:18.31,0:20:21.25,Default,,0,0,0,,Профессор Уёның немересі де біледі. ➡
Dialogue: 0,0:20:21.25,0:20:24.79,Default,,0,0,0,,Снарядтарды лақтыруды жалғастыру арқылы тепе-теңдікті сақтаймын➡
Dialogue: 0,0:20:24.79,0:20:27.35,Default,,0,0,0,,Егер сіз тоқтасаңыз, сізді бірден шетке итеріп жібереді. ➡
Dialogue: 0,0:20:27.35,0:20:29.99,Default,,0,0,0,,Снаряд таусылған жерінен➡
Dialogue: 0,0:20:29.99,0:20:32.39,Default,,0,0,0,,Мұнда нағыз шайқас бар.
Dialogue: 0,0:20:34.03,0:20:36.46,Default,,0,0,0,,Сол №10 үлгі де шығады➡
Dialogue: 0,0:20:36.46,0:20:39.20,Default,,0,0,0,,Бар ма деп ойлаймын. Әлде бұл жай ғана кездейсоқтық па?
Dialogue: 0,0:20:39.20,0:20:43.20,Default,,0,0,0,,Шираторизава шайқасының соңында ұқсас нәрсе болды.
Dialogue: 0,0:20:43.20,0:20:46.14,Default,,0,0,0,,Әй, айтар сөзім жоқ. ➡
Dialogue: 0,0:20:46.14,0:20:49.78,Default,,0,0,0,,Егер сіз 10 санына алаңдай бастасаңыз, бұл олардың ойлағанындай. ➡
Dialogue: 0,0:20:49.78,0:20:53.15,Default,,0,0,0,,Нені икемді етіп, нені ілулі етпей істеу керек➡
Dialogue: 0,0:20:53.15,0:20:55.52,Default,,0,0,0,,Айырмашылық. Қорғасын блогы ➡
Dialogue: 0,0:20:55.52,0:20:59.52,Default,,0,0,0,,Ол тек екінші жартысында жұмыс істейді. (Барлығы) Уау!
Dialogue: 0,0:20:59.52,0:21:03.02,Default,,0,0,0,,♬～ (жапондық барабан орындауы)
Dialogue: 0,0:21:04.53,0:21:06.53,Default,,0,0,0,,Қара!
Dialogue: 0,0:21:12.17,0:21:15.10,Default,,0,0,0,,Tsk! Алан!
Dialogue: 0,0:21:15.10,0:21:17.10,Default,,0,0,0,,3 блок!
Dialogue: 0,0:21:17.10,0:21:19.17,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:21:19.17,0:21:21.18,Default,,0,0,0,,Дыбыстық сигнал! Жақсы!
Dialogue: 0,0:21:21.18,0:21:26.08,Default,,0,0,0,,Уау... Ол қазіргі 3 блокты блоктың үстінде ме?
Dialogue: 0,0:21:26.08,0:21:28.85,Default,,0,0,0,,Асахи мырза да осындай нәрсені тере алады.
Dialogue: 0,0:21:28.85,0:21:31.15,Default,,0,0,0,,Жоқ. Мүмкін емес. Мүмкін емес. Жоғарыға шығу мүмкін емес.
Dialogue: 0,0:21:33.82,0:21:35.79,Default,,0,0,0,,Уф.
Dialogue: 0,0:21:35.79,0:21:38.26,Default,,0,0,0,,Ниссер!
Dialogue: 0,0:21:38.26,0:21:40.26,Default,,0,0,0,,Қара!
Dialogue: 0,0:21:41.86,0:21:44.63,Default,,0,0,0,,Оны кесіңіз. Оны кесіңіз.
Dialogue: 0,0:21:44.63,0:21:47.70,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:47.70,0:21:51.47,Default,,0,0,0,,Арх! Шүкір…. (Диктор) Күшті қызмет!
Dialogue: 0,0:21:51.47,0:21:53.91,Default,,0,0,0,,Оны көтеру үшін ғана қолыңыздан келеді.
Dialogue: 0,0:21:53.91,0:21:56.54,Default,,0,0,0,,Солға! Асахи мырза!
Dialogue: 0,0:21:56.54,0:21:59.55,Default,,0,0,0,,≪Жақсы! Маған жақсы көрінетін екі қадамдық лақтыру≫
Dialogue: 0,0:21:59.55,0:22:01.55,Default,,0,0,0,,>
Dialogue: 0,0:22:01.55,0:22:03.55,Default,,0,0,0,,3 блок!
Dialogue: 0,0:22:05.59,0:22:07.59,Default,,0,0,0,,О!
Dialogue: 0,0:22:09.16,0:22:11.33,Default,,0,0,0,,≪О, жоқ! ≫
Dialogue: 0,0:22:11.33,0:22:14.56,Default,,0,0,0,,Уау! Не болды!
Dialogue: 0,0:22:14.56,0:22:16.56,Default,,0,0,0,,О! (Ямагучи) Жарайды!
Dialogue: 0,0:22:16.56,0:22:18.57,Default,,0,0,0,,Аха!
Dialogue: 0,0:22:18.57,0:22:20.57,Default,,0,0,0,,≪Кешіріңіз...≫
Dialogue: 0,0:22:22.07,0:22:25.07,Default,,0,0,0,,Сіз осында келгеннен кейін әлі де жаңа нәрсені байқап жатырсыз ба?
Dialogue: 0,0:22:25.07,0:22:27.88,Default,,0,0,0,,Не? Қарға!
Dialogue: 0,0:22:30.81,0:22:33.21,Default,,0,0,0,,≪Бағалы артқы бұрылыс≫
Dialogue: 0,0:22:34.58,0:22:37.38,Default,,0,0,0,,Сәлем! Тынш! Шаа!
Dialogue: 0,0:22:37.38,0:22:40.25,Default,,0,0,0,,Хината: Сіз әдеттегіден қатты қызып кеттіңіз.
Dialogue: 0,0:22:40.25,0:22:43.26,Default,,0,0,0,,Бұл қарапайым қызмет болса да. (Сугавара) Көңілдің ба?
Dialogue: 0,0:22:43.26,0:22:45.96,Default,,0,0,0,,Бұл қызмет көрсетуден гөрі қабылдау емес пе?
Dialogue: 0,0:22:45.96,0:22:48.43,Default,,0,0,0,,Иә? (Сугавара) А, бірақ...
Dialogue: 0,0:22:48.43,0:22:50.90,Default,,0,0,0,,Иә! (Сугавара) Ямагучиге қызмет етеді.
Dialogue: 0,0:22:50.90,0:22:53.90,Default,,0,0,0,,Оши кел, шайқас. (Ямагучи) Иә.
Dialogue: 0,0:22:53.90,0:22:55.94,Default,,0,0,0,,10 ұпай Барыңыз, алыңыз...
Dialogue: 0,0:22:55.94,0:22:58.94,Default,,0,0,0,,Неге көзің жас? Арх!
Dialogue: 0,0:22:58.94,0:23:01.44,Default,,0,0,0,,Барыңыз. Мен бара аламын.
Dialogue: 0,0:23:01.44,0:23:05.15,Default,,0,0,0,,Дәл қазір жақсы атмосфера бар.
Dialogue: 0,0:23:07.45,0:23:09.95,Default,,0,0,0,,≪Әдеттегідей бір-бірден. ➡
Dialogue: 0,0:23:11.45,0:23:15.56,Default,,0,0,0,,Қалай жүру керек Допты қалай ұстау керек≫
Dialogue: 0,0:23:18.23,0:23:20.23,Default,,0,0,0,,≪Мақсат – Эйс. ➡
Dialogue: 0,0:23:20.23,0:23:22.63,Default,,0,0,0,,Идеал – тізерлеп отыру≫
Dialogue: 0,0:23:26.00,0:23:29.10,Default,,0,0,0,,≪Цубакихара шайқасы сияқты қалпына келтіру перспективасы≫
Dialogue: 0,0:23:30.47,0:23:32.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:32.47,0:23:35.08,Default,,0,0,0,,≪Мен оны қыздыру кезінде көрдім≫
Dialogue: 0,0:23:36.48,0:23:40.48,Default,,0,0,0,,≪Тынышталыңыз. Қалғанының бәрі жақсы≫
Dialogue: 0,0:23:40.48,0:23:42.58,Default,,0,0,0,,Керемет кілт! (Көрермендер) Тағы бір!
Dialogue: 0,0:23:42.58,0:23:45.15,Default,,0,0,0,,🔈🗧 (Залдағы хабарландыру) Onida Women's Academy менеджерлеріне➡
Dialogue: 0,0:23:45.15,0:23:48.82,Default,,0,0,0,,Кіру парағын бас кеңсеге тапсырыңыз.
Dialogue: 0,0:23:48.82,0:23:51.63,Default,,0,0,0,,Бу!
Dialogue: 0,0:23:51.63,0:23:55.03,Default,,0,0,0,,≪Концентрация…. Сіз кеше жақсы болдыңыз. ➡
Dialogue: 0,0:23:55.03,0:23:57.63,Default,,0,0,0,,Reset Reset…≫
Dialogue: 0,0:23:57.63,0:23:59.90,Default,,0,0,0,,Тадаши~! Ах.
Dialogue: 0,0:24:01.54,0:24:05.14,Default,,0,0,0,,Ах! Ха ха ха ха…. ➡
Dialogue: 0,0:24:05.14,0:24:07.11,Default,,0,0,0,,Тадаши~!
Dialogue: 0,0:24:13.21,0:24:15.22,Default,,0,0,0,,Қара!
Dialogue: 0,0:24:26.16,0:24:28.16,Default,,0,0,0,,Бип!
Dialogue: 0,0:24:28.16,0:24:30.80,Default,,0,0,0,,Тынш! (Диктор) Қызметші!
Dialogue: 0,0:24:30.80,0:24:33.47,Default,,0,0,0,,Иә! А-а... Кешіріңіз.
Dialogue: 0,0:24:34.80,0:24:37.71,Default,,0,0,0,,О! (Диктор) Карасуно кері!
Dialogue: 0,0:24:37.71,0:24:40.71,Default,,0,0,0,,Жарайсың Ямагучи! (Танака) Мен жасадым! Хахаха! ➡
Dialogue: 0,0:24:40.71,0:24:43.48,Default,,0,0,0,,Жарайсыңдар! Бұл керемет...
Dialogue: 0,0:24:43.48,0:24:48.22,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:48.22,0:24:50.78,Default,,0,0,0,,Қара!
Dialogue: 0,0:24:50.78,0:24:53.39,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:24:58.56,0:25:01.53,Default,,0,0,0,,♬ Белгілі болған нәрсе бір күні болады
Dialogue: 0,0:25:01.53,0:25:04.43,Default,,0,0,0,,♬ Түсінетін уақыт келеді
Dialogue: 0,0:25:04.43,0:25:06.57,Default,,0,0,0,,♬ Қателескен дұрыс
Dialogue: 0,0:25:06.57,0:25:11.34,Default,,0,0,0,,♬ Қазір ойлануды тоқтатпа
Dialogue: 0,0:25:11.34,0:25:21.92,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:21.92,0:25:27.02,Default,,0,0,0,,♬ Мен шындықты ұшыратын арманды қаладым
Dialogue: 0,0:25:28.42,0:25:31.26,Default,,0,0,0,,♬ Тек мағынасы бар
Dialogue: 0,0:25:31.26,0:25:34.93,Default,,0,0,0,,♬ Күндер жайбарақат
Dialogue: 0,0:25:34.93,0:25:37.53,Default,,0,0,0,,♬ Қорқатын ештеңе жоқ
Dialogue: 0,0:25:37.53,0:25:40.23,Default,,0,0,0,,♬ Жаңа ғана мықты болған бала
Dialogue: 0,0:25:40.23,0:25:44.27,Default,,0,0,0,,♬ Арқам әлі терлеп жатыр
Dialogue: 0,0:25:44.27,0:25:46.57,Default,,0,0,0,,♬ Себебі мен саған қарап тұрмын
Dialogue: 0,0:25:46.57,0:25:50.98,Default,,0,0,0,,♬ Енді маған ғажайыптардың керегі жоқ
Dialogue: 0,0:25:50.98,0:25:54.92,Default,,0,0,0,,♬ Біз кез келген жерге бара аламыз
Dialogue: 0,0:25:54.92,0:25:57.79,Default,,0,0,0,,♬ Бір күні армандар да орындалады
Dialogue: 0,0:25:57.79,0:26:00.79,Default,,0,0,0,,♬ Біз осы уақытқа дейін не істедік
Dialogue: 0,0:26:00.79,0:26:04.46,Default,,0,0,0,,♬ Бұл кездейсоқтық емес
Dialogue: 0,0:26:04.46,0:26:06.79,Default,,0,0,0,,♬ сахнадан кету
Dialogue: 0,0:26:06.79,0:26:09.50,Default,,0,0,0,,♬ Тұрғым келген кезде
Dialogue: 0,0:26:09.50,0:26:12.63,Default,,0,0,0,,♬ Мен қатты тілек тілеп жүрдім
Dialogue: 0,0:26:12.63,0:26:16.30,Default,,0,0,0,,♬ Өйткені сіз сонда болдыңыз
Dialogue: 0,0:26:16.30,0:26:25.61,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:26:27.11,0:26:32.11,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
