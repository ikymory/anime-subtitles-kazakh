Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.03,0:00:44.94,Default,,0,0,0,,♬～ (Жел диапазонының өнімділігі)
Dialogue: 0,0:00:47.71,0:00:49.71,Default,,0,0,0,,Қара!
Dialogue: 0,0:00:51.35,0:00:54.98,Default,,0,0,0,,Нишиноя! (Нишитани) А... Қарғыс атсын!
Dialogue: 0,0:00:54.98,0:00:56.99,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:00:56.99,0:00:59.99,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:00:59.99,0:01:02.99,Default,,0,0,0,,Күткендей... (Такинуэ) Ах. ➡
Dialogue: 0,0:01:02.99,0:01:06.50,Default,,0,0,0,,Мия Ю 2-топ➡
Dialogue: 0,0:01:06.50,0:01:08.90,Default,,0,0,0,,Ол Нишинояны көздеп отыр.
Dialogue: 0,0:01:08.90,0:01:10.90,Default,,0,0,0,,≪Қандай да бір ниет болмаса➡
Dialogue: 0,0:01:10.90,0:01:14.60,Default,,0,0,0,,Барлық серверлер Нишиноядан аулақ болғысы келеді. ➡
Dialogue: 0,0:01:14.60,0:01:18.61,Default,,0,0,0,,Нишитани➡ үшін бірінші рет болуы мүмкін
Dialogue: 0,0:01:18.61,0:01:20.61,Default,,0,0,0,,Нысанаға түскенді қорлау≫
Dialogue: 0,0:01:22.08,0:01:41.43,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:41.43,0:01:45.57,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:01:45.57,0:01:50.77,Default,,0,0,0,,♬ Мен ең төменгі талаптарды білемін.
Dialogue: 0,0:01:50.77,0:01:54.91,Default,,0,0,0,,♬ Қазір тоқтама Тоқтатпа Тоқтатпа
Dialogue: 0,0:01:54.91,0:02:01.42,Default,,0,0,0,,♬ Тоқтасаң, орындалмайды.
Dialogue: 0,0:02:01.42,0:02:05.85,Default,,0,0,0,,♬ Егер сіз тырыспасаңыз, сіз одан ләззат ала алмайсыз.
Dialogue: 0,0:02:05.85,0:02:10.53,Default,,0,0,0,,♬ Ең қызық нәрсе
Dialogue: 0,0:02:10.53,0:02:15.23,Default,,0,0,0,,♬ жеткіліксіз артық емес
Dialogue: 0,0:02:15.23,0:02:19.00,Default,,0,0,0,,♬ Ей, сен аштан өліп жатырсың ғой?
Dialogue: 0,0:02:21.70,0:02:24.27,Default,,0,0,0,,♬ Әділ және әділ
Dialogue: 0,0:02:24.27,0:02:26.91,Default,,0,0,0,,♬ Қазір «қазір» алдында
Dialogue: 0,0:02:26.91,0:02:31.08,Default,,0,0,0,,♬ Ащы да, тәтті де шындықтан ләззат алыңыз.
Dialogue: 0,0:02:31.08,0:02:33.25,Default,,0,0,0,,♬ ұлы мәртебелі
Dialogue: 0,0:02:33.25,0:02:35.95,Default,,0,0,0,,♬ Мен фронтальды серпіліс жасағым келеді.
Dialogue: 0,0:02:35.95,0:02:41.79,Default,,0,0,0,,♬ Қызықты көрінеді. Сізге ұнайтын сияқты.
Dialogue: 0,0:02:41.79,0:02:47.40,Default,,0,0,0,,♬ Қазір тоқтап қалмай, рахаттаныңыз, күліңіз
Dialogue: 0,0:02:47.40,0:02:50.57,Default,,0,0,0,,♬ Күлейік
Dialogue: 0,0:02:52.07,0:02:55.07,Default,,0,0,0,,Қараңдар! (Нишитани) Қуат➡
Dialogue: 0,0:02:55.07,0:02:58.47,Default,,0,0,0,,Таспаға түсіру. Өйткені мен оған нашармын.
Dialogue: 0,0:02:58.47,0:03:02.01,Default,,0,0,0,,Ах~ Иә. (Танака) Көрсететін саусақ? Сенімен бәрі жақсы ма?
Dialogue: 0,0:03:02.01,0:03:04.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:05.45,0:03:08.62,Default,,0,0,0,,Инаризакидің №7 сервисі керемет.
Dialogue: 0,0:03:08.62,0:03:10.79,Default,,0,0,0,,Ах. Міне, мен де соны мақсат етіп отырмын➡
Dialogue: 0,0:03:10.79,0:03:12.92,Default,,0,0,0,,Ол қорғанысқа маманданған либеро.
Dialogue: 0,0:03:12.92,0:03:16.46,Default,,0,0,0,,Иә. Бұл либеро жақсы және жігерлі➡
Dialogue: 0,0:03:16.46,0:03:20.30,Default,,0,0,0,,Егер ол жігіт құласа, команда қиыншылыққа ұшырайды. Солай ма?
Dialogue: 0,0:03:20.30,0:03:24.50,Default,,0,0,0,,Либеро ала алмайтын нәрсені алудың жолы жоқ. ➡
Dialogue: 0,0:03:25.93,0:03:28.84,Default,,0,0,0,,Мұны Мия Ю түсінетін шығар➡
Dialogue: 0,0:03:28.84,0:03:32.21,Default,,0,0,0,,Бүкіл қарсыласқа қысым көрсету.
Dialogue: 0,0:03:32.21,0:03:34.98,Default,,0,0,0,,Күшті жігіттен қызмет көрсетуші алсаңыз➡
Dialogue: 0,0:03:34.98,0:03:36.95,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:03:38.98,0:03:40.98,Default,,0,0,0,,шықты. (Юу) А? не?
Dialogue: 0,0:03:40.98,0:03:42.98,Default,,0,0,0,,Ю кейде➡
Dialogue: 0,0:03:42.98,0:03:45.79,Default,,0,0,0,,Бұл оқиға таңқаларлық ойсыз.
Dialogue: 0,0:03:45.79,0:03:47.79,Default,,0,0,0,,күрсін!? Бұл не? Бұл дөрекі!
Dialogue: 0,0:03:47.79,0:03:50.86,Default,,0,0,0,,Қараңдар! Шаа!
Dialogue: 0,0:03:50.86,0:03:54.53,Default,,0,0,0,,Ух... Нишитани-сан, барыңды сал.
Dialogue: 0,0:03:56.87,0:03:58.83,Default,,0,0,0,,Уф….
Dialogue: 0,0:04:00.80,0:04:02.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:02.80,0:04:05.97,Default,,0,0,0,,♬～ (Жел диапазонының өнімділігі)
Dialogue: 0,0:04:05.97,0:04:08.14,Default,,0,0,0,,Ниссер!
Dialogue: 0,0:04:08.14,0:04:15.15,Default,,0,0,0,,♬～ (Жел диапазонының өнімділігі)
Dialogue: 0,0:04:15.15,0:04:18.05,Default,,0,0,0,,≪4 қадам. Күтілгендей, Janfro≫
Dialogue: 0,0:04:18.05,0:04:21.16,Default,,0,0,0,,♬～(Үлдік оркестрдің орындауы) Қараңыз!
Dialogue: 0,0:04:29.56,0:04:32.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.23,0:04:34.24,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:04:34.24,0:04:38.91,Default,,0,0,0,,Ю Мияның либеросына қарсы қатарынан екі қызметтік эйс!
Dialogue: 0,0:04:38.91,0:04:42.78,Default,,0,0,0,,Бар, жүр, Юу! Тағы біреуі!
Dialogue: 0,0:04:44.21,0:04:46.38,Default,,0,0,0,,Уф….
Dialogue: 0,0:04:46.38,0:04:50.22,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:50.22,0:04:52.95,Default,,0,0,0,,Мен оны жаңа ғана алдым деп ойладым.
Dialogue: 0,0:04:52.95,0:04:56.39,Default,,0,0,0,,Менің ойымша, орбита қолмен өзгерді. ➡
Dialogue: 0,0:04:56.39,0:04:59.39,Default,,0,0,0,,Астында, себебі доппен жердің жанасуы тар➡
Dialogue: 0,0:04:59.39,0:05:01.56,Default,,0,0,0,,Егер нүкте сәл ғана жылжыса➡
Dialogue: 0,0:05:01.56,0:05:05.40,Default,,0,0,0,,Сіз дұрыс емес бағытта бара жатырсыз. (Лиев) Түсінемін!
Dialogue: 0,0:05:05.40,0:05:08.74,Default,,0,0,0,,Нишитани екі рет қатарынан қате жіберді➡
Dialogue: 0,0:05:08.74,0:05:11.74,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын. (Такинуэ) Хмм...
Dialogue: 0,0:05:11.74,0:05:15.74,Default,,0,0,0,,Волейбол – бір адам аяқтай алмайтын доп ойыны➡
Dialogue: 0,0:05:15.74,0:05:17.81,Default,,0,0,0,,Бірінші қабылдау жоғары көтерілмесе➡
Dialogue: 0,0:05:17.81,0:05:22.15,Default,,0,0,0,,Бұл ештеңені бастай алмайтыныңызды білдіреді. ➡
Dialogue: 0,0:05:22.15,0:05:24.59,Default,,0,0,0,,Демек, қызмет көрсету/қабылдау қатесі ➡
Dialogue: 0,0:05:24.59,0:05:28.36,Default,,0,0,0,,Психологиялық зақым көбірек. ➡
Dialogue: 0,0:05:28.36,0:05:32.36,Default,,0,0,0,,Оның үстіне қорғанысқа маманданған либеро қорғай алмайды.
Dialogue: 0,0:05:32.36,0:05:34.83,Default,,0,0,0,,Сотта болудың қажеті жоқ.
Dialogue: 0,0:05:34.83,0:05:38.80,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:38.80,0:05:42.90,Default,,0,0,0,,≪Нишитани мені қанша рет жігерлендіргенін санай алмаймын≫
Dialogue: 0,0:05:42.90,0:05:46.07,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:47.68,0:05:51.08,Default,,0,0,0,,≪Қандай сөздер айтуым керек...≫
Dialogue: 0,0:05:51.08,0:05:53.45,Default,,0,0,0,,Ноясса... Уф!
Dialogue: 0,0:05:53.45,0:05:55.52,Default,,0,0,0,,Хун хун хун хун!
Dialogue: 0,0:05:55.52,0:05:57.52,Default,,0,0,0,,Ахаха. Не? ше?
Dialogue: 0,0:05:59.05,0:06:02.62,Default,,0,0,0,,≪Жаттығу кезінде мен айып соққысын жасай бердім. ➡
Dialogue: 0,0:06:02.62,0:06:06.49,Default,,0,0,0,,Нишитани қалыпты болып қалуға тырысады≫
Dialogue: 0,0:06:08.36,0:06:10.37,Default,,0,0,0,,Хмф! Дон!
Dialogue: 0,0:06:12.00,0:06:15.17,Default,,0,0,0,,Уф….
Dialogue: 0,0:06:15.17,0:06:17.34,Default,,0,0,0,,Хаха.
Dialogue: 0,0:06:17.34,0:06:19.34,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:06:20.78,0:06:22.78,Default,,0,0,0,,Қара!
Dialogue: 0,0:06:22.78,0:06:28.52,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:28.52,0:06:30.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:32.49,0:06:35.22,Default,,0,0,0,,Жақсы! Бақылаңыз!
Dialogue: 0,0:06:35.22,0:06:38.23,Default,,0,0,0,,Мұқаба! Шобо қабылдайды!
Dialogue: 0,0:06:39.69,0:06:41.70,Default,,0,0,0,,Асахи мырза!
Dialogue: 0,0:06:43.87,0:06:46.84,Default,,0,0,0,,≪Қатты соққылар мүмкін емес≫
Dialogue: 0,0:06:46.84,0:06:49.24,Default,,0,0,0,,Әй! Ах.
Dialogue: 0,0:06:49.24,0:06:52.24,Default,,0,0,0,,Қондырғышқа бағытталған! Бірінші жанасу - Мия Ю. ➡
Dialogue: 0,0:06:52.24,0:06:55.24,Default,,0,0,0,,-мен бір уақытта Мияджи допты тез түсірді.
Dialogue: 0,0:06:58.18,0:07:02.88,Default,,0,0,0,,≪Орнатушы емес, C⁉ Және есептегіш≫
Dialogue: 0,0:07:02.88,0:07:04.85,Default,,0,0,0,,≪Егіз толықтауыш...≫
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,>
Dialogue: 0,0:07:09.69,0:07:11.69,Default,,0,0,0,,Ах. Ах!
Dialogue: 0,0:07:11.69,0:07:13.66,Default,,0,0,0,,≪Тоқта! ≫
Dialogue: 0,0:07:19.20,0:07:21.67,Default,,0,0,0,,Дабыл! (Диктор) Жаңа ғана лақтырған адам –➡
Dialogue: 0,0:07:21.67,0:07:25.01,Default,,0,0,0,,Сетер емес Осаму Мия болды.
Dialogue: 0,0:07:25.01,0:07:27.91,Default,,0,0,0,,Қазір бұл не? ➡
Dialogue: 0,0:07:27.91,0:07:30.55,Default,,0,0,0,,Блок мықтап бекітілді.
Dialogue: 0,0:07:30.55,0:07:35.15,Default,,0,0,0,,Жарайды. Сіз блоктауды жақсы білесіз.
Dialogue: 0,0:07:35.15,0:07:38.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:38.95,0:07:40.96,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:07:43.49,0:07:45.63,Default,,0,0,0,,Мен тағы да шешім қабылдадым.
Dialogue: 0,0:07:45.63,0:07:49.50,Default,,0,0,0,,Жарайды, Кадо мырза, алдымен шабуыл ерекше байқалды➡
Dialogue: 0,0:07:49.50,0:07:53.84,Default,,0,0,0,,Сіз міндіңіз бе? Ринтаро - баяу бастаушы.
Dialogue: 0,0:07:53.84,0:07:57.17,Default,,0,0,0,,Не? Айтпақшы, сол жігіт➡
Dialogue: 0,0:07:57.17,0:07:59.77,Default,,0,0,0,,Қарсыластың блокаторын басқару. ➡
Dialogue: 0,0:08:01.64,0:08:05.81,Default,,0,0,0,,Ринтаро қаруы - соққы нүктесінің ені.
Dialogue: 0,0:08:05.81,0:08:09.72,Default,,0,0,0,,Егер қарапайым жігіт осы енге соқса➡
Dialogue: 0,0:08:09.72,0:08:11.82,Default,,0,0,0,,Ринтаро осындай.
Dialogue: 0,0:08:11.82,0:08:14.42,Default,,0,0,0,,Ол шыбықтарға соққанда нені пайдаланады - ➡
Dialogue: 0,0:08:14.42,0:08:17.93,Default,,0,0,0,,Қол немесе иық емес, бүкіл дене. ➡
Dialogue: 0,0:08:17.93,0:08:20.30,Default,,0,0,0,,Оны діңгек деп атайды. ➡
Dialogue: 0,0:08:20.30,0:08:24.10,Default,,0,0,0,,Соғу үшін бүкіл денені пайдаланатындықтан, қуат күшті болып қалады. ➡
Dialogue: 0,0:08:24.10,0:08:26.63,Default,,0,0,0,,Қолмен доппен аздап ойнау➡
Dialogue: 0,0:08:26.63,0:08:29.27,Default,,0,0,0,,Айырмашылық бар. (Еркек) О. ➡
Dialogue: 0,0:08:29.27,0:08:33.74,Default,,0,0,0,,Мен түсінбеймін, бірақ мені Блок➡ ұстап алған соң
Dialogue: 0,0:08:33.74,0:08:37.31,Default,,0,0,0,,Кейбір блоктар жойылды.
Dialogue: 0,0:08:39.58,0:08:42.95,Default,,0,0,0,,А, блок-манипуляциялық кейіпкер туралы не деуге болады?
Dialogue: 0,0:08:42.95,0:08:44.95,Default,,0,0,0,,Хаха, жарайды, мен саған тәнті болдым.
Dialogue: 0,0:08:44.95,0:08:50.02,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:50.02,0:08:52.96,Default,,0,0,0,,Уф….
Dialogue: 0,0:08:52.96,0:08:54.93,Default,,0,0,0,,Қара!
Dialogue: 0,0:08:58.63,0:09:00.64,Default,,0,0,0,,A... Шығар!
Dialogue: 0,0:09:00.64,0:09:04.27,Default,,0,0,0,,Дабыл! Хмм!
Dialogue: 0,0:09:04.27,0:09:07.11,Default,,0,0,0,,Қарғыс атсын! (Савамура) Жарайды!
Dialogue: 0,0:09:07.11,0:09:10.11,Default,,0,0,0,,≪Осы қателік үшін неге өкінбейсіз?≫
Dialogue: 0,0:09:10.11,0:09:12.11,Default,,0,0,0,,Өрт, күй, Карасуно! ➡
Dialogue: 0,0:09:12.11,0:09:15.02,Default,,0,0,0,,Шеш, шеш, Карасуно! Өрт, күйдір...
Dialogue: 0,0:09:15.02,0:09:18.62,Default,,0,0,0,,Қараңдар! (Карасуно қолдау тобы) Шеш, шеш, Карасуно!
Dialogue: 0,0:09:21.02,0:09:22.99,Default,,0,0,0,,Алан!
Dialogue: 0,0:09:25.06,0:09:27.13,Default,,0,0,0,,Дабыл! Шаа~!
Dialogue: 0,0:09:27.13,0:09:30.03,Default,,0,0,0,,Өте сенімді қызмет көрсетуші!
Dialogue: 0,0:09:30.03,0:09:32.97,Default,,0,0,0,,2-ші сет Карасуноның сервиі онша жақсы болмады➡
Dialogue: 0,0:09:32.97,0:09:36.24,Default,,0,0,0,,Осы жерден бәрі жақсы болады деп үміттенемін. Қара!
Dialogue: 0,0:09:38.67,0:09:40.64,Default,,0,0,0,,Алан!
Dialogue: 0,0:09:46.01,0:09:51.02,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:51.02,0:09:53.69,Default,,0,0,0,,Жүр! Цукки тоқта!
Dialogue: 0,0:09:56.39,0:09:58.99,Default,,0,0,0,,≪2 дана! ≫
Dialogue: 0,0:09:58.99,0:10:01.00,Default,,0,0,0,,≪Жақсы≫
Dialogue: 0,0:10:01.00,0:10:04.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:04.00,0:10:06.00,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:06.00,0:10:09.70,Default,,0,0,0,,Уау! Бип!
Dialogue: 0,0:10:09.70,0:10:12.47,Default,,0,0,0,,Керемет Ринтаро! Секір, секір, Ринтаро! ➡
Dialogue: 0,0:10:12.47,0:10:14.48,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:10:17.18,0:10:20.35,Default,,0,0,0,,≪Блокатор деңгейі неғұрлым жоғары болса➡
Dialogue: 0,0:10:20.35,0:10:23.82,Default,,0,0,0,,Мен Канамның қалауымен қозғалмаймын≫
Dialogue: 0,0:10:26.05,0:10:31.03,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:34.68,0:12:38.45,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:47.20,0:12:49.20,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:49.20,0:12:52.37,Default,,0,0,0,,Дыбыстық сигнал! қазір! Сіз оны дәл қазір көрдіңіз бе?
Dialogue: 0,0:12:52.37,0:12:55.20,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:12:55.20,0:12:57.71,Default,,0,0,0,,Уф….
Dialogue: 0,0:12:57.71,0:13:00.54,Default,,0,0,0,,Түсіндіңіз бе? (Куро) Аа... ➡
Dialogue: 0,0:13:00.54,0:13:04.38,Default,,0,0,0,,10 саны айқышты соғу үшін өте жақсы жағдайда болды. ➡
Dialogue: 0,0:13:04.38,0:13:08.02,Default,,0,0,0,,Цукки бірден жауап беріп, курсты бөгеп тастады➡
Dialogue: 0,0:13:08.02,0:13:10.99,Default,,0,0,0,,Кагеяма да мені қолдауға тез келді.
Dialogue: 0,0:13:10.99,0:13:14.99,Default,,0,0,0,,Бірақ дененің жүгіруі де, бағыты да жалған. ➡
Dialogue: 0,0:13:14.99,0:13:19.86,Default,,0,0,0,,Блокаторды көлденең жағына шақырыңыз және оны ауада кері айналдырыңыз.
Dialogue: 0,0:13:19.86,0:13:23.87,Default,,0,0,0,,Сонымен қатар, ол мұны шиптердің қуатын төмендетпей жасайды.
Dialogue: 0,0:13:23.87,0:13:26.27,Default,,0,0,0,,Ортаңғы блокатордың жылдам шабуылы ➡
Dialogue: 0,0:13:26.27,0:13:29.14,Default,,0,0,0,,Ол басқа шабуылдарға қарағанда ықшам болады.
Dialogue: 0,0:13:29.14,0:13:32.47,Default,,0,0,0,,Тек жылдамдықты пайдалану арқылы блоктан қашып бара жатқандай сезінесіз.
Dialogue: 0,0:13:32.47,0:13:35.24,Default,,0,0,0,,Бірақ Ринтароның жылдам шабуылы ➡
Dialogue: 0,0:13:35.24,0:13:37.41,Default,,0,0,0,,Егер лақтыру дұрыс орындалса, блоктау және ➡
Dialogue: 0,0:13:37.41,0:13:41.58,Default,,0,0,0,,Бұл сіз бәсекелесуге болатын жылдам шабуыл. (Еркек) О!
Dialogue: 0,0:13:43.25,0:13:46.22,Default,,0,0,0,,Бүкіл ел бойынша қорқынышты!
Dialogue: 0,0:13:46.22,0:13:48.79,Default,,0,0,0,,Қалай болғанда да, екінші тарап асықты пайдалана алмайтынына көз жеткізіңіз➡
Dialogue: 0,0:13:48.79,0:13:51.36,Default,,0,0,0,,Жою. Күшті қызмет және шабуыл!
Dialogue: 0,0:13:51.36,0:13:53.36,Default,,0,0,0,,Иә. (Танака, Нишитани, Томине) Усу!
Dialogue: 0,0:13:53.36,0:13:55.33,Default,,0,0,0,,Қара!
Dialogue: 0,0:13:57.97,0:13:59.97,Default,,0,0,0,,Нишиноя! ➡
Dialogue: 0,0:13:59.97,0:14:02.80,Default,,0,0,0,,Керемет қабыл алыңыздар! (Диктор) Күшті қызмет!
Dialogue: 0,0:14:02.80,0:14:04.81,Default,,0,0,0,,Оны көтерген адам да ғажап.
Dialogue: 0,0:14:06.27,0:14:09.21,Default,,0,0,0,,Onech! Бақылаңыз!
Dialogue: 0,0:14:09.21,0:14:11.25,Default,,0,0,0,,Солға!
Dialogue: 0,0:14:11.25,0:14:13.21,Default,,0,0,0,,3 блок!
Dialogue: 0,0:14:15.32,0:14:17.55,Default,,0,0,0,,Оджиро Алан Интенсивті өсу! ➡
Dialogue: 0,0:14:17.55,0:14:20.56,Default,,0,0,0,,Доп тордың үстінде!
Dialogue: 0,0:14:20.56,0:14:24.36,Default,,0,0,0,,Кагеяма ішке кіреді! (Қатты) Солға!
Dialogue: 0,0:14:24.36,0:14:27.80,Default,,0,0,0,,Қатарынан сол жақтан Алан Оджиро! (3 адам) Тоқта!
Dialogue: 0,0:14:27.80,0:14:30.80,Default,,0,0,0,,≪Шапалақтауға қатаң тыйым салынады! ≫
Dialogue: 0,0:14:30.80,0:14:32.80,Default,,0,0,0,,3 блок!
Dialogue: 0,0:14:35.14,0:14:37.14,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:14:38.64,0:14:41.61,Default,,0,0,0,,Үш қабырғаға тиген соққы!
Dialogue: 0,0:14:41.61,0:14:44.45,Default,,0,0,0,,Бұл блокта ма? қымбат.
Dialogue: 0,0:14:44.45,0:14:46.51,Default,,0,0,0,,Дегенмен, Карасуно да қарсы шабуылға мүмкіндік іздейді...
Dialogue: 0,0:14:46.51,0:14:48.52,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:14:51.15,0:14:53.22,Default,,0,0,0,,Бип! (Оджиро) Шаа~!
Dialogue: 0,0:14:53.22,0:14:55.86,Default,,0,0,0,,Ален Оджиро тікелей шешім қабылдады! ➡
Dialogue: 0,0:14:55.86,0:15:00.29,Default,,0,0,0,,Бір адам оңай соқпайтын жағдайда қатарынан 3 рет шабуыл жасайды. ➡
Dialogue: 0,0:15:00.29,0:15:02.80,Default,,0,0,0,,Күшпен ұстауға болатын бір ғана нүкте!
Dialogue: 0,0:15:04.30,0:15:07.27,Default,,0,0,0,,Керемет Алан! Секір, секір, Алан! ➡
Dialogue: 0,0:15:07.27,0:15:09.74,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:15:09.74,0:15:13.17,Default,,0,0,0,,Әлі жоқ, сэр. Дәл қазір бұл ұтылған ұпай ғана.
Dialogue: 0,0:15:13.17,0:15:16.28,Default,,0,0,0,,Оны менің жігіттерім де біледі. Қазір одан да көп➡
Dialogue: 0,0:15:16.28,0:15:19.78,Default,,0,0,0,,Мен Алан Оджироның 30 секунд болса да демалғанын қаламаймын.
Dialogue: 0,0:15:19.78,0:15:23.75,Default,,0,0,0,,Иә! Ол жақтағы 4 саны Ушивакаға ұқсайды.
Dialogue: 0,0:15:23.75,0:15:26.29,Default,,0,0,0,,Ушивакадан айырмашылығы – бұл қызмет алу➡
Dialogue: 0,0:15:26.29,0:15:28.32,Default,,0,0,0,,Қатысу. ➡
Dialogue: 0,0:15:28.32,0:15:30.66,Default,,0,0,0,,Сервис➡ арқылы көздеуге болады
Dialogue: 0,0:15:30.66,0:15:34.66,Default,,0,0,0,,Шындығында, мен осы уақытқа дейін №4 қарсыласқа қарсы бірнеше қызмет эйстерін алдым. ➡
Dialogue: 0,0:15:34.66,0:15:36.93,Default,,0,0,0,,Менің ойымша, бұл өте стресстік. ➡
Dialogue: 0,0:15:38.40,0:15:42.20,Default,,0,0,0,,-де қиын доп бірқалыпты көтеріледі➡
Dialogue: 0,0:15:42.20,0:15:45.04,Default,,0,0,0,,Блоктар да мұқият бақыланады. ➡
Dialogue: 0,0:15:45.04,0:15:48.64,Default,,0,0,0,,Шаршау мен ашуланшақтық дұрыс жинақталады...➡
Dialogue: 0,0:15:48.64,0:15:51.68,Default,,0,0,0,,Болу керек! Қара!
Dialogue: 0,0:15:51.68,0:15:55.05,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:55.05,0:15:57.05,Default,,0,0,0,,Кешіріңіз, орындаңыз!
Dialogue: 0,0:15:57.05,0:15:59.02,Default,,0,0,0,,Танака мырза!
Dialogue: 0,0:16:01.06,0:16:03.06,Default,,0,0,0,,Дабыл! Крааа~!
Dialogue: 0,0:16:03.06,0:16:05.06,Default,,0,0,0,,Айдаһар~! Күшті!
Dialogue: 0,0:16:05.06,0:16:07.90,Default,,0,0,0,,Карасуно орта мектебі Рюносуке Танака! (Сугавара) Тамаша, Танака!
Dialogue: 0,0:16:07.90,0:16:10.90,Default,,0,0,0,,Бұл Инаризаки Йоши атмосферасын кесіп тастайды!
Dialogue: 0,0:16:10.90,0:16:13.27,Default,,0,0,0,,Қараңдар! (Диктор) Карасуно орта мектебі➡
Dialogue: 0,0:16:13.27,0:16:16.44,Default,,0,0,0,,Енді үшінші курс студенті Сугавараны таныстырып өтейік.
Dialogue: 0,0:16:16.44,0:16:18.87,Default,,0,0,0,,Нишитанидің жаулары оны алады!
Dialogue: 0,0:16:18.87,0:16:21.24,Default,,0,0,0,,Бұл өлген жоқ!
Dialogue: 0,0:16:21.24,0:16:24.25,Default,,0,0,0,,≪Mr. Цукишима≫ атынан Сугавара келді
Dialogue: 0,0:16:24.25,0:16:28.08,Default,,0,0,0,,≪Сонымен Киношита қызмет етпеген шығар≫
Dialogue: 0,0:16:28.08,0:16:30.05,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:36.09,0:16:39.13,Default,,0,0,0,,≪Миға қызмет көрсету ace 25th≫
Dialogue: 0,0:16:39.13,0:16:41.23,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:41.23,0:16:44.80,Default,,0,0,0,,Сәлем! Менде бір жинақ бар➡
Dialogue: 0,0:16:44.80,0:16:48.77,Default,,0,0,0,,Екінші жиынды тастасаңыз да, бәрібір дұрыс емес деп ойлайсыз!?
Dialogue: 0,0:16:48.77,0:16:51.51,Default,,0,0,0,,Мен сені 2-0 есебімен жеңемін!
Dialogue: 0,0:16:51.51,0:16:53.51,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:16:56.71,0:16:58.68,Default,,0,0,0,,Хмм….
Dialogue: 0,0:17:00.98,0:17:04.92,Default,,0,0,0,,((Мен Алан Ошироның оған бәрібір қысым жасағанын қалаймын))
Dialogue: 0,0:17:04.92,0:17:06.92,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:06.92,0:17:09.92,Default,,0,0,0,,((Әрине, шағымы жоқ - бұл Service Ace...➡
Dialogue: 0,0:17:11.63,0:17:14.76,Default,,0,0,0,,Ең дұрысы, тізерлеп отырып))
Dialogue: 0,0:17:14.76,0:17:16.80,Default,,0,0,0,,≪Мен сотта бола аламын➡
Dialogue: 0,0:17:16.80,0:17:20.00,Default,,0,0,0,,20 секунд немесе 10 секунд... ➡
Dialogue: 0,0:17:20.00,0:17:22.00,Default,,0,0,0,,Бар болғаны 5 секунд болса да...≫ Дыбыстық сигнал!
Dialogue: 0,0:17:22.00,0:17:25.11,Default,,0,0,0,,≪Мен Инаризакиді тітіркендіремін! ≫
Dialogue: 0,0:17:25.11,0:17:27.14,Default,,0,0,0,,Алдыңғы Алдыңғы!
Dialogue: 0,0:17:27.14,0:17:31.08,Default,,0,0,0,,Мен қауіпті жер Карасуно Сугавараны көздеймін!
Dialogue: 0,0:17:31.08,0:17:33.05,Default,,0,0,0,,Емдеу!
Dialogue: 0,0:17:36.02,0:17:39.22,Default,,0,0,0,,Қарғыс атсын! (2 адам) Не!
Dialogue: 0,0:17:40.99,0:17:42.96,Default,,0,0,0,,Кагеяма соңғы!
Dialogue: 0,0:17:44.99,0:17:47.16,Default,,0,0,0,,Солға! Иә, иә!
Dialogue: 0,0:17:49.63,0:17:51.63,Default,,0,0,0,,≪Төмен бе? ≫
Dialogue: 0,0:17:51.63,0:17:58.51,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:58.51,0:18:01.98,Default,,0,0,0,,Дыбыстық сигнал! (Көрермендер) Уау!
Dialogue: 0,0:18:01.98,0:18:04.45,Default,,0,0,0,,♬~
Dialogue: 0,0:18:04.45,0:18:07.21,Default,,0,0,0,,Алан, сабыр ет! (Одзиро) Усу!
Dialogue: 0,0:18:07.21,0:18:09.55,Default,,0,0,0,,Қара!
Dialogue: 0,0:18:09.55,0:18:12.19,Default,,0,0,0,,Инаризаки бұл жолы қысқыш сервер болып табылады. ➡
Dialogue: 0,0:18:12.19,0:18:15.69,Default,,0,0,0,,Менің атым Хэйсуке Риши, мен бірінші курс студентімін.
Dialogue: 0,0:18:15.69,0:18:18.69,Default,,0,0,0,,≪3 жылдық орта мектептегі мәңгілік орындық≫
Dialogue: 0,0:18:18.69,0:18:22.83,Default,,0,0,0,,≪Мен қысқышпен ойнаған жалғыз матч қызмет көрсету қателігімен аяқталды≫
Dialogue: 0,0:18:22.83,0:18:26.67,Default,,0,0,0,,Керемет! Қара!
Dialogue: 0,0:18:26.67,0:18:29.44,Default,,0,0,0,,≪Қателік жасасаң, балаң болмайды≫
Dialogue: 0,0:18:29.44,0:18:32.04,Default,,0,0,0,,≪Біріншіден, бір бөтелке➡
Dialogue: 0,0:18:32.04,0:18:34.51,Default,,0,0,0,,Кірістіру≫
Dialogue: 0,0:18:34.51,0:18:36.68,Default,,0,0,0,,Бұл тасты мен міндетті түрде салып қойдым.
Dialogue: 0,0:18:38.21,0:18:40.18,Default,,0,0,0,,Асахи! (Томина) Шаа!
Dialogue: 0,0:18:43.15,0:18:45.25,Default,,0,0,0,,Уф... Бип!
Dialogue: 0,0:18:45.25,0:18:47.32,Default,,0,0,0,,Әңгімелесейік! (Нишитани) Шаа~!
Dialogue: 0,0:18:47.32,0:18:50.89,Default,,0,0,0,,Боу! Боу! Боу!
Dialogue: 0,0:18:50.89,0:18:52.89,Default,,0,0,0,,Уау! (Савамура/Томина) Иә?
Dialogue: 0,0:18:52.89,0:18:55.73,Default,,0,0,0,,Ағымдағы қызмет дегеніміз не? (Еркек) Сен мұнда не үшін келдің?
Dialogue: 0,0:18:55.73,0:19:00.10,Default,,0,0,0,,Допты ұстаушыны шақырмаңыз! (Какунаме) Мұны естігеніме біраз болды.
Dialogue: 0,0:19:00.10,0:19:03.44,Default,,0,0,0,,Не? Не? Боо? Инаризаки сенің жаныңда ма?
Dialogue: 0,0:19:03.44,0:19:05.44,Default,,0,0,0,,Сервис қателері жоқ, солай ма?
Dialogue: 0,0:19:05.44,0:19:09.78,Default,,0,0,0,,Бұл не? Инаризакидің жындарын қолдау.
Dialogue: 0,0:19:09.78,0:19:12.25,Default,,0,0,0,,Егер сіз әлсіз ойнасаңыз, сізге қолдау көрсету тобынан қолдау көрсетіледі➡
Dialogue: 0,0:19:12.25,0:19:15.25,Default,,0,0,0,,Мен қатты қауіп бар деп естідім.
Dialogue: 0,0:19:15.25,0:19:18.25,Default,,0,0,0,,Мүмкін солай шығар. иә!
Dialogue: 0,0:19:18.25,0:19:20.92,Default,,0,0,0,,Кәсіби маман болмаса да, оны аяймын.
Dialogue: 0,0:19:20.92,0:19:23.52,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:23.52,0:19:26.53,Default,,0,0,0,,Маған төбелесу керек деп айтпадың ба?
Dialogue: 0,0:19:26.53,0:19:30.03,Default,,0,0,0,,Сіз әрқашан тым көп ойлайсыз.
Dialogue: 0,0:19:30.03,0:19:33.13,Default,,0,0,0,,Маған үйіме қою үшін порция керек емес.
Dialogue: 0,0:19:33.13,0:19:35.80,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:35.80,0:19:38.71,Default,,0,0,0,,Сен артықсың ба, кемсің бе.
Dialogue: 0,0:19:40.78,0:19:42.78,Default,,0,0,0,,Usu….
Dialogue: 0,0:19:42.78,0:19:51.89,Default,,0,0,0,,♬～ (жапондық барабан орындауы)
Dialogue: 0,0:19:53.59,0:19:55.56,Default,,0,0,0,,Қара!
Dialogue: 0,0:20:02.73,0:20:04.70,Default,,0,0,0,,Бас!
Dialogue: 0,0:20:06.60,0:20:09.00,Default,,0,0,0,,Жоқ! (Куросу) Хмм….
Dialogue: 0,0:20:09.00,0:20:12.47,Default,,0,0,0,,Бип! (Диктор) Еш жанасу жоқ!
Dialogue: 0,0:20:12.47,0:20:14.48,Default,,0,0,0,,О! (Диктор) Қандай жылдамдық! ➡
Dialogue: 0,0:20:14.48,0:20:17.14,Default,,0,0,0,,Қандай курс! (Акаги) Оны жіберіп алмаңыз!
Dialogue: 0,0:20:17.14,0:20:19.68,Default,,0,0,0,,Мен мұны қабылдай алмаймын!
Dialogue: 0,0:20:19.68,0:20:22.55,Default,,0,0,0,,Бұл... тыныш Кагеяма.
Dialogue: 0,0:20:22.55,0:20:24.59,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:20:24.59,0:20:27.49,Default,,0,0,0,,Аты айтып тұрғандай, Кагеяма сабырлы.
Dialogue: 0,0:20:27.49,0:20:30.49,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:30.49,0:20:33.26,Default,,0,0,0,,Көзді жұмбайтын жылдам шабуыл сәтті болған кезде...
Dialogue: 0,0:20:35.63,0:20:39.20,Default,,0,0,0,,Бұл Цукишиманың RBI көтерілген кездегідей сезім.
Dialogue: 0,0:20:40.87,0:20:44.67,Default,,0,0,0,,Ол әртүрлі өткір жағдайларды білдіреді.
Dialogue: 0,0:20:44.67,0:20:47.34,Default,,0,0,0,,Дегенмен жай ғана сабырлы жүз➡
Dialogue: 0,0:20:47.34,0:20:50.34,Default,,0,0,0,,Қатыгездік өзгеріссіз қалады, сондықтан сақтық қажет.
Dialogue: 0,0:20:50.34,0:20:54.12,Default,,0,0,0,,Көбінесе күшті адаммен бетпе-бет келгенде белсендіріледі.
Dialogue: 0,0:20:54.12,0:20:56.28,Default,,0,0,0,,Бір жерде ол нұсқаулық нұсқаулығына ұқсай бастады.
Dialogue: 0,0:20:58.65,0:21:01.19,Default,,0,0,0,,>
Dialogue: 0,0:21:01.19,0:21:04.19,Default,,0,0,0,,Қара!
Dialogue: 0,0:21:04.19,0:21:07.26,Default,,0,0,0,,Инаризаки орта мектебі Бірінші рет шығу. ➡
Dialogue: 0,0:21:07.26,0:21:10.10,Default,,0,0,0,,Екі мектептің де қызметі күшті.
Dialogue: 0,0:21:10.10,0:21:13.20,Default,,0,0,0,,Екі мектепте де әртүрлі және күшті шабуылдар бар. ➡
Dialogue: 0,0:21:13.20,0:21:17.14,Default,,0,0,0,,Сервиспен шабуыл жасаңыз және жылдам шабуылдар➡ сияқты жылдам шабуылдардан аулақ болыңыз
Dialogue: 0,0:21:17.14,0:21:19.11,Default,,0,0,0,,Демек, сізге шабуыл жасалуда.
Dialogue: 0,0:21:19.11,0:21:22.44,Default,,0,0,0,,Дәл солай екінші жаққа да қатысты. Ағын қазір осы жаққа келіп жатыр.
Dialogue: 0,0:21:22.44,0:21:26.55,Default,,0,0,0,,Кагеяманың қызметі Карасуно орта мектебінің қарсы шабуылына кінәлі бола ма?
Dialogue: 0,0:21:26.55,0:21:29.15,Default,,0,0,0,,Иә! Қара!
Dialogue: 0,0:21:31.89,0:21:33.89,Default,,0,0,0,,Қара!
Dialogue: 0,0:21:36.39,0:21:38.96,Default,,0,0,0,,Қарғыс атсын! (Көрермендер) Уау!
Dialogue: 0,0:21:38.96,0:21:41.83,Default,,0,0,0,,Дыбыстық сигнал! Шаа!
Dialogue: 0,0:21:41.83,0:21:43.86,Default,,0,0,0,,Тыныш! (Диктор) Тағы да шешілді! ➡
Dialogue: 0,0:21:43.86,0:21:48.20,Default,,0,0,0,,Тайм-ауттан кейін де оның зейіні бұзылмады.
Dialogue: 0,0:21:48.20,0:21:50.20,Default,,0,0,0,,Уау... Қарғыс атсын!
Dialogue: 0,0:21:50.20,0:21:53.21,Default,,0,0,0,,Қара!
Dialogue: 0,0:21:53.21,0:21:56.38,Default,,0,0,0,,Тағы біреуі!
Dialogue: 0,0:21:56.38,0:21:58.55,Default,,0,0,0,,Күміс! (Гиндзима) Қарғыс атсын!
Dialogue: 0,0:21:58.55,0:22:01.05,Default,,0,0,0,,Алан!
Dialogue: 0,0:22:01.05,0:22:04.15,Default,,0,0,0,,≪Ақыл-ойы бұзылмаса да➡
Dialogue: 0,0:22:04.15,0:22:07.05,Default,,0,0,0,,Аздап тітіркену➡
Dialogue: 0,0:22:07.05,0:22:10.59,Default,,0,0,0,,Егер сіз шыбықты сәл қаттырақ соқсаңыз...≫
Dialogue: 0,0:22:10.59,0:22:12.76,Default,,0,0,0,,Солға солға! (Yuu) 3 блок!
Dialogue: 0,0:22:12.76,0:22:19.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:19.10,0:22:21.10,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:22:21.10,0:22:24.71,Default,,0,0,0,,Қарғыс атсын! Хмм….
Dialogue: 0,0:22:26.57,0:22:29.14,Default,,0,0,0,,≪Бұл үлкен бетбұрыс болады≫
Dialogue: 0,0:22:30.58,0:22:33.95,Default,,0,0,0,,Кита Кита Кита Кита! Бұл жерде!
Dialogue: 0,0:22:33.95,0:22:37.95,Default,,0,0,0,,О, мүмкін бе? Мен келісемін. ➡
Dialogue: 0,0:22:37.95,0:22:40.96,Default,,0,0,0,,Бұл жиіркенішті. Уф….
Dialogue: 0,0:22:40.96,0:22:43.12,Default,,0,0,0,,Карасуно! Өрт, күй!
Dialogue: 0,0:22:43.12,0:22:45.69,Default,,0,0,0,,Қарғыс атсын! Қара!
Dialogue: 0,0:22:47.63,0:22:50.06,Default,,0,0,0,,Тәтті... Тәтті! (Диктор) Доп Карасуно кортына барады➡
Dialogue: 0,0:22:50.06,0:22:52.07,Default,,0,0,0,,Бір бөтелкемен оралыңыз!
Dialogue: 0,0:22:52.07,0:22:56.64,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:56.64,0:22:58.64,Default,,0,0,0,,≪Асығыңыз! ≫
Dialogue: 0,0:23:00.64,0:23:03.31,Default,,0,0,0,,≪Ондай сиқырлама≫
Dialogue: 0,0:23:03.31,0:23:05.28,Default,,0,0,0,,Ах. (Юу) Сэм!
Dialogue: 0,0:23:06.85,0:23:09.68,Default,,0,0,0,,Дыбыстық сигнал! Эй!
Dialogue: 0,0:23:09.68,0:23:12.69,Default,,0,0,0,,Бұл жолы мен Оджиро Алан туралы шешім қабылдадым! ➡
Dialogue: 0,0:23:12.69,0:23:15.06,Default,,0,0,0,,Өзіңіздің ерік-жігеріңізді көрсетіңіз.
Dialogue: 0,0:23:15.06,0:23:19.09,Default,,0,0,0,,Ю-ның қазуы ғажап болды.
Dialogue: 0,0:23:19.09,0:23:23.03,Default,,0,0,0,,Кагеяма Тобио мен Мия Ю екеуі де жастар құрамасына үміткер. ➡
Dialogue: 0,0:23:23.03,0:23:26.13,Default,,0,0,0,,Олар перспективалы орнатушылар, бірақ оларда орнатудан басқа нәрсе бар ➡
Dialogue: 0,0:23:26.13,0:23:28.87,Default,,0,0,0,,Ұшқындар ұшып жатыр!
Dialogue: 0,0:23:28.87,0:23:31.84,Default,,0,0,0,,Емдеу! Аяқтау соққыларының екінші жинағын алыңыз! ➡
Dialogue: 0,0:23:31.84,0:23:35.28,Default,,0,0,0,,Сондай-ақ, бүгінгі қызмет көрсету - менің басым жеңісім!
Dialogue: 0,0:23:35.28,0:23:38.25,Default,,0,0,0,,Бұл өте қатты. Қара!
Dialogue: 0,0:23:41.68,0:23:43.68,Default,,0,0,0,,≪О, жоқ! ≫
Dialogue: 0,0:23:43.68,0:23:45.69,Default,,0,0,0,,Өртен! (Ячи) Эй!
Dialogue: 0,0:23:45.69,0:23:48.02,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:23:48.02,0:23:51.69,Default,,0,0,0,,Мен тым көп күш қолдандым ба? Үлкен шықты.
Dialogue: 0,0:23:51.69,0:23:54.19,Default,,0,0,0,,Иә! Ол ұшты.
Dialogue: 0,0:23:54.19,0:23:56.33,Default,,0,0,0,,Бұл үйге жүгіру сайысы болады!
Dialogue: 0,0:23:56.33,0:23:58.67,Default,,0,0,0,,≪Сіз де мұны кейде жасайсыз! ≫
Dialogue: 0,0:23:58.67,0:24:00.67,Default,,0,0,0,,Өйткені қажет емес нәрселерді айтасыз.
Dialogue: 0,0:24:00.67,0:24:03.30,Default,,0,0,0,,Atta. Осаму➡
Dialogue: 0,0:24:03.30,0:24:05.97,Default,,0,0,0,,Ол сабырлы болып көрінуі мүмкін, бірақ ол жеңілуді жек көреді.
Dialogue: 0,0:24:05.97,0:24:09.34,Default,,0,0,0,,Бұл оның жартысы ғана.
Dialogue: 0,0:24:09.34,0:24:11.81,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:24:11.81,0:24:14.62,Default,,0,0,0,,≪Аздап психикалық ауытқу➡
Dialogue: 0,0:24:14.62,0:24:18.59,Default,,0,0,0,,Кәдімгі ойынды аздап араластырайық➡
Dialogue: 0,0:24:18.59,0:24:21.59,Default,,0,0,0,,Бір-бірін қайталайтын кейбір бұзушылықтар бар...≫
Dialogue: 0,0:24:21.59,0:24:23.59,Default,,0,0,0,,Күміс!
Dialogue: 0,0:24:23.59,0:24:27.59,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:27.59,0:24:29.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:32.37,0:24:35.00,Default,,0,0,0,,>
Dialogue: 0,0:24:35.00,0:24:37.00,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:24:38.97,0:24:41.01,Default,,0,0,0,,Уау! (Томина) Кешіріңіз.
Dialogue: 0,0:24:41.01,0:24:43.18,Default,,0,0,0,,Оны жіберіп алмаңыз! Асахи-сан, уайымдама.
Dialogue: 0,0:24:43.18,0:24:45.38,Default,,0,0,0,,Кешіріңіз. (Акаги) Бір рет ырғақты дұрыстап алайық. ➡
Dialogue: 0,0:24:45.38,0:24:48.08,Default,,0,0,0,,Тынышталыңыз. Қара!
Dialogue: 0,0:24:48.08,0:24:50.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:50.08,0:24:56.89,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:58.43,0:25:01.43,Default,,0,0,0,,♬ Белгілі нәрсе бір күні болады
Dialogue: 0,0:25:01.43,0:25:04.43,Default,,0,0,0,,♬ Түсінетін уақыт келеді
Dialogue: 0,0:25:04.43,0:25:06.43,Default,,0,0,0,,♬ Қателескен дұрыс
Dialogue: 0,0:25:06.43,0:25:11.37,Default,,0,0,0,,♬ Енді ойлануды тоқтатпа
Dialogue: 0,0:25:11.37,0:25:21.92,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:21.92,0:25:26.89,Default,,0,0,0,,♬ Мен шындықты ұшыратын арманды қаладым
Dialogue: 0,0:25:28.32,0:25:31.23,Default,,0,0,0,,♬ Тек мағыналы болу үшін
Dialogue: 0,0:25:31.23,0:25:34.33,Default,,0,0,0,,♬ Күндер жайбарақат
Dialogue: 0,0:25:34.33,0:25:37.60,Default,,0,0,0,,♬ Қорқатын ештеңе жоқ
Dialogue: 0,0:25:37.60,0:25:40.13,Default,,0,0,0,,♬ Жаңа ғана мықты болған бала
Dialogue: 0,0:25:40.13,0:25:44.24,Default,,0,0,0,,♬ Менің арқам әлі тершіл
Dialogue: 0,0:25:44.24,0:25:46.64,Default,,0,0,0,,♬ Себебі мен саған қарап тұрмын
Dialogue: 0,0:25:46.64,0:25:50.81,Default,,0,0,0,,♬ Енді маған ғажайыптардың керегі жоқ
Dialogue: 0,0:25:50.81,0:25:54.98,Default,,0,0,0,,♬ Біз кез келген жерге бара аламыз
Dialogue: 0,0:25:54.98,0:25:57.68,Default,,0,0,0,,♬ Бір күні армандар орындалады
Dialogue: 0,0:25:57.68,0:26:00.75,Default,,0,0,0,,♬ Біз осы уақытқа дейін не істедік
Dialogue: 0,0:26:00.75,0:26:04.43,Default,,0,0,0,,♬ Бұл кездейсоқтық емес
Dialogue: 0,0:26:04.43,0:26:06.86,Default,,0,0,0,,♬ сахнаға шығу
Dialogue: 0,0:26:06.86,0:26:09.50,Default,,0,0,0,,♬ Тұрғым келген кезде
Dialogue: 0,0:26:09.50,0:26:12.67,Default,,0,0,0,,♬ Мен қатты тілек тілеп жүрдім
Dialogue: 0,0:26:12.67,0:26:16.34,Default,,0,0,0,,♬ Өйткені сіз сонда болдыңыз
Dialogue: 0,0:26:16.34,0:26:25.35,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
