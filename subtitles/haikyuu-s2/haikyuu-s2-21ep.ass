Dialogue: 0,0:19:38.47,0:19:41.88,Default,,0,0,0,,Өзгелерге мейірімділікпен өмір сүр)) (Ю) ((Не айтып тұрсың?))
Dialogue: 0,0:19:43.54,0:19:47.45,Default,,0,0,0,,＜Біз бір-бірімізді кішкентай кезімізден білеміз➡
Dialogue: 0,0:19:47.45,0:19:50.82,Default,,0,0,0,,Мен Юуды кейде қорқынышты деп ойладым＞
Dialogue: 0,0:19:56.76,0:19:59.83,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:19:59.83,0:20:03.23,Default,,0,0,0,,((Осындай күндер бар)) (Какунаме)()
Dialogue: 0,0:20:03.23,0:20:05.23,Default,,0,0,0,,((Біз бәріміз өте жаманбыз.➡
Dialogue: 0,0:20:05.23,0:20:08.24,Default,,0,0,0,,Жаттығу жасайық)) (Какунаме) ((Ыстық...))
Dialogue: 0,0:20:08.24,0:20:10.34,Default,,0,0,0,,() (Гиндзима/Какуна/Оджиро)((иә?))
Dialogue: 0,0:20:12.34,0:20:17.21,Default,,0,0,0,,((Бұл параметрмен мен ұштарды ➡ жасай алмаймын
Dialogue: 0,0:20:17.21,0:20:19.68,Default,,0,0,0,,Асығыңыз және позицияны ашыңыз))
Dialogue: 0,0:20:23.35,0:20:29.19,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:29.19,0:20:33.36,Default,,0,0,0,,((Бұл... қорлайтын шошқа!)) ((Уф!))
Dialogue: 0,0:20:35.80,0:20:37.80,Default,,0,0,0,,((Сіз тамаша формада болсаңыз да➡
Dialogue: 0,0:20:37.80,0:20:41.30,Default,,0,0,0,,Олай етпесеңіз де, уайымдамаңыз! ➡
Dialogue: 0,0:20:41.30,0:20:44.21,Default,,0,0,0,,Бірдеңе дұрыс болмаса, бірдеңе дұрыс емес➡
Dialogue: 0,0:20:44.21,0:20:46.94,Default,,0,0,0,,Бұл өте ақымақ! )) (Одзиро) ((Дене немесе қақпақ жоқ))
Dialogue: 0,0:20:46.94,0:20:53.88,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:53.88,0:20:56.88,Default,,0,0,0,,((Мінезі шала жігіт бұлай айтпасын!➡
Dialogue: 0,0:20:56.88,0:20:59.29,Default,,0,0,0,,Боке! )) (Ер студент) ((Мия ағалары төбелеседі!))
Dialogue: 0,0:20:59.29,0:21:05.96,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:05.96,0:21:12.97,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:12.97,0:21:17.10,Default,,0,0,0,,((PES ойнағыңыз келе ме?)) (Ю)()
Dialogue: 0,0:21:17.10,0:21:21.61,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:23.01,0:21:26.61,Default,,0,0,0,,＜Бәлкім, Ю-ның ең құтты нүктесі➡
Dialogue: 0,0:21:26.61,0:21:30.58,Default,,0,0,0,,Менің ойымша, «емдеу» дене бітімі немесе әртүрлі қабілеттерге қарағанда маңызды>
Dialogue: 0,0:21:32.25,0:21:35.66,Default,,0,0,0,,＜ Басқалар сізді қаншалықты жылдам қуып жететініне қарамастан ➡
Dialogue: 0,0:21:35.66,0:21:38.16,Default,,0,0,0,,Олар міндетті түрде бір-бірін қуып жетеді＞
Dialogue: 0,0:21:38.16,0:21:40.53,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:40.53,0:21:43.03,Default,,0,0,0,,＜Менің ойымша, бұл кейде көңілсіз болуы мүмкін...＞
Dialogue: 0,0:21:43.03,0:21:46.03,Default,,0,0,0,,)) ((Бух! Гух! ➡
Dialogue: 0,0:21:46.03,0:21:49.64,Default,,0,0,0,,Қайта істедің, ебедейсіз бейбақ! Күтіңіз Сэм! ))
Dialogue: 0,0:21:55.71,0:21:58.71,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
