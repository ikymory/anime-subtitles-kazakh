Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.21,0:00:08.50,*Default,NTP,0000,0000,0000,,менің әкем
Dialogue: 0,0:00:08.74,0:00:12.18,*Default,NTP,0000,0000,0000,,Норико Такаян, 3/4 сынып 2 сынып
Dialogue: 0,0:00:12.58,0:00:17.38,*Default,NTP,0000,0000,0000,,Менің әкем өте керемет адам деп ойлаймын.
Dialogue: 0,0:00:17.38,0:00:21.41,*Default,NTP,0000,0000,0000,,Ғарышта Жерді қорғау жұмысы
Dialogue: 0,0:00:21.79,0:00:26.73,*Default,NTP,0000,0000,0000,,Менің әкем мінген ғарыш кемесі – әлемдегі ең жылдам.
Dialogue: 0,0:00:26.73,0:00:29.96,*Default,NTP,0000,0000,0000,,Маған әрқашан мақтан
Dialogue: 0,0:00:29.96,0:00:35.03,*Default,NTP,0000,0000,0000,,Менің әкем «Люксион» ғарыш кемесінің капитаны.
Dialogue: 0,0:00:35.03,0:00:39.07,*Default,NTP,0000,0000,0000,,Мен де өскенде ғарышкер боламын.
Dialogue: 0,0:00:39.07,0:00:42.51,*Default,NTP,0000,0000,0000,,Мен әкеммен бірге ғарышқа ұшқым келеді.
Dialogue: 0,0:00:47.75,0:00:52.88,*Default,NTP,0000,0000,0000,,20 желтоқсан 2015 жыл Бұлтты, кейін жаңбыр жауады
Dialogue: 0,0:00:53.39,0:00:55.72,*Default,NTP,0000,0000,0000,,Әкесі қайтыс болды
Dialogue: 0,0:00:55.82,0:00:57.42,*Default,NTP,0000,0000,0000,,Нақтырақ айтсақ
Dialogue: 0,0:00:57.42,0:01:00.59,*Default,NTP,0000,0000,0000,,19 желтоқсанда қайтыс болды
Dialogue: 0,0:01:00.59,0:01:07.20,*Default,NTP,0000,0000,0000,,Менің әкем мінген ғарыш кемесіне алыс ғарышта ғарыштық құбыжық шабуыл жасады.
Dialogue: 0,0:01:07.70,0:01:13.24,*Default,NTP,0000,0000,0000,,Әкем қайтыс болса да, мен оны шынымен сезбедім.
Dialogue: 0,0:01:13.24,0:01:17.51,*Default,NTP,0000,0000,0000,,Мен өзімді ғаламның бір жерінде әлі тірі жүргендей сезінемін.
Dialogue: 0,0:01:17.94,0:01:22.21,*Default,NTP,0000,0000,0000,,Мен де әкем болған ғаламға барамын.
Dialogue: 0,0:01:22.62,0:01:26.52,*Default,NTP,0000,0000,0000,,Мен де ғарыш ұшқышы боламын.
Dialogue: 0,0:01:47.51,0:01:53.41,*Default,NTP,0000,0000,0000,,Артыңыздан төбеге жүгіру
Dialogue: 0,0:01:53.45,0:01:59.32,*Default,NTP,0000,0000,0000,,Ыстық күн сәулесін басып озу
Dialogue: 0,0:01:59.32,0:02:05.05,*Default,NTP,0000,0000,0000,,Арқамды қуып жеткенде үлкен секіреді.
Dialogue: 0,0:02:05.26,0:02:11.26,*Default,NTP,0000,0000,0000,,Мен сенің демалуыңды сеземін.
Dialogue: 0,0:02:11.26,0:02:16.90,*Default,NTP,0000,0000,0000,,Жел соққан сайын көңілді сезінеді
Dialogue: 0,0:02:16.90,0:02:21.37,*Default,NTP,0000,0000,0000,,Жүрегім асқақ үмітпен
Dialogue: 0,0:02:21.37,0:02:23.24,*Default,NTP,0000,0000,0000,,ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ!
Dialogue: 0,0:02:24.24,0:02:29.98,*Default,NTP,0000,0000,0000,,Оранып қалғым келеді, алаңсыз.
Dialogue: 0,0:02:30.22,0:02:36.29,*Default,NTP,0000,0000,0000,,Біз бірге қалғанда қашықтық нөлге айналады
Dialogue: 0,0:02:36.29,0:02:39.92,*Default,NTP,0000,0000,0000,,МЕН СЕНІ ЖАҚСЫ КӨРЕМІН
Dialogue: 0,0:03:28.88,0:03:31.71,*Default,NTP,0000,0000,0000,,Бұл не, Кимико?
Dialogue: 0,0:03:31.71,0:03:34.38,*Default,NTP,0000,0000,0000,,Неге сен мұңая қарап тұрсың?
Dialogue: 0,0:03:34.38,0:03:36.51,*Default,NTP,0000,0000,0000,,Әй, әпке.
Dialogue: 0,0:03:36.95,0:03:39.25,*Default,NTP,0000,0000,0000,,Иә, менің арманым
Dialogue: 0,0:03:39.62,0:03:41.75,*Default,NTP,0000,0000,0000,,Мен де сондай болсам ғой
Dialogue: 0,0:03:44.46,0:03:47.86,*Default,NTP,0000,0000,0000,,Бір болу мүмкін емес, сізде талант жоқ.
Dialogue: 0,0:03:47.86,0:03:52.20,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Сіз әлі бір ай бойы аппараттасыз.
Dialogue: 0,0:03:52.20,0:03:55.17,*Default,NTP,0000,0000,0000,,Сіз бастаушысыз, сондықтан қазірден бастап жақсы боласыз.
Dialogue: 0,0:03:55.54,0:03:57.44,*Default,NTP,0000,0000,0000,,Осы аптада Бикеш кім?
Dialogue: 0,0:03:57.44,0:04:00.41,*Default,NTP,0000,0000,0000,,Алты күн сәтті болды, қарапайым кездесу күтіп тұр.
Dialogue: 0,0:04:00.51,0:04:01.47,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:01.74,0:04:04.74,*Default,NTP,0000,0000,0000,,Ымырт қанша уақыт болады?
Dialogue: 0,0:04:04.74,0:04:08.35,*Default,NTP,0000,0000,0000,,5-6-кезеңдердегі машиналық жаттығуларды бүкіл мектеп бірлесіп өткізеді деп естідім.
Dialogue: 0,0:04:08.35,0:04:10.75,*Default,NTP,0000,0000,0000,,Жаңа жаттықтырушы да келеді.
Dialogue: 0,0:04:10.75,0:04:12.69,*Default,NTP,0000,0000,0000,,Киіміңізді тез ауыстырып, жаттығу жасаңыз.
Dialogue: 0,0:04:12.69,0:04:14.15,*Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:04:18.09,0:04:24.03,*Default,NTP,0000,0000,0000,,188 189 190 191 192 193
Dialogue: 0,0:04:24.03,0:04:25.77,*Default,NTP,0000,0000,0000,,194 195…
Dialogue: 0,0:04:25.77,0:04:28.10,*Default,NTP,0000,0000,0000,,196 197
Dialogue: 0,0:04:28.10,0:04:32.00,*Default,NTP,0000,0000,0000,,198 199 200!
Dialogue: 0,0:04:32.74,0:04:35.31,*Default,NTP,0000,0000,0000,,Сіз шынайы өмірде мінсізсіз.
Dialogue: 0,0:04:35.31,0:04:38.74,*Default,NTP,0000,0000,0000,,Сіз мұны қалай жасай алдыңыз? Машина мүлдем жарамсыз.
Dialogue: 0,0:04:39.31,0:04:41.31,*Default,NTP,0000,0000,0000,,Мен механы ұнатпаймын.
Dialogue: 0,0:04:41.31,0:04:44.32,*Default,NTP,0000,0000,0000,,Ендеше екі нәрсені бір уақытта орындауға болмайды.
Dialogue: 0,0:04:44.32,0:04:48.29,*Default,NTP,0000,0000,0000,,Мониторға қарап отырып, қолдар мен аяқтарды жылжыту - бұл ...
Dialogue: 0,0:04:48.29,0:04:50.08,*Default,NTP,0000,0000,0000,,А, сіз оны төлей аласыз.
Dialogue: 0,0:04:52.29,0:04:55.06,*Default,NTP,0000,0000,0000,,Секіргіш арқанмен жаттығу
Dialogue: 0,0:04:55.06,0:04:56.46,*Default,NTP,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:04:56.46,0:04:58.09,*Default,NTP,0000,0000,0000,,Себебі мен оған үйреніп қалдым
Dialogue: 0,0:04:58.40,0:05:00.07,*Default,NTP,0000,0000,0000,,Сіз бізбен мақтанасыз ба?
Dialogue: 0,0:05:00.07,0:05:02.74,*Default,NTP,0000,0000,0000,,Адмиралдың қызынан күткендей, мен қызғанамын.
Dialogue: 0,0:05:02.74,0:05:04.40,*Default,NTP,0000,0000,0000,,Байланыстарға байланысты қайтадан қабылдауды жоспарлайсыз ба?
Dialogue: 0,0:05:04.40,0:05:06.71,*Default,NTP,0000,0000,0000,,Кешіріңіз! Бұл сіздің шеберлігіңіз!
Dialogue: 0,0:05:06.71,0:05:08.20,*Default,NTP,0000,0000,0000,,О, солай деп ойлаймын.
Dialogue: 0,0:05:10.78,0:05:12.61,*Default,NTP,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:05:12.61,0:05:14.34,*Default,NTP,0000,0000,0000,,Әпке!
Dialogue: 0,0:05:16.02,0:05:18.42,*Default,NTP,0000,0000,0000,,Егер сіз де ұшқыш болғыңыз келсе
Dialogue: 0,0:05:18.42,0:05:21.02,*Default,NTP,0000,0000,0000,,Өзіңізге пууидо жасаңыз!
Dialogue: 0,0:05:21.02,0:05:23.22,*Default,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:37.60,0:05:39.74,*Default,NTP,0000,0000,0000,,Норико Такая?
Dialogue: 0,0:05:41.41,0:05:43.40,*Default,NTP,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:05:44.08,0:05:48.17,*Default,NTP,0000,0000,0000,,Иә, сіз адмирал Такаяның қызы едіңіз.
Dialogue: 0,0:05:48.61,0:05:52.68,*Default,NTP,0000,0000,0000,,Кешіріңіз, көп қиналсаңыз керек.
Dialogue: 0,0:05:53.39,0:05:56.36,*Default,NTP,0000,0000,0000,,Жоқ, мен үйреніп қалдым.
Dialogue: 0,0:05:58.22,0:06:02.06,*Default,NTP,0000,0000,0000,,Машинаның 6 балансирмен жұмыс істеуі
Dialogue: 0,0:06:02.06,0:06:05.46,*Default,NTP,0000,0000,0000,,Екі мүшеңіздің кері байланысына назар аударсаңыз, бәрі жақсы болады.
Dialogue: 0,0:06:06.57,0:06:08.47,*Default,NTP,0000,0000,0000,,Өте көп
Dialogue: 0,0:06:08.70,0:06:12.66,*Default,NTP,0000,0000,0000,,Эй, сен мониторды қалай басқарасың?
Dialogue: 0,0:06:13.54,0:06:17.34,*Default,NTP,0000,0000,0000,,Ал... Бір қарап алайын, ойланып көрейін.
Dialogue: 0,0:06:17.34,0:06:23.35,*Default,NTP,0000,0000,0000,,Бірақ келесі сәтте демалу қажет нәрсені жасайды.
Dialogue: 0,0:06:23.35,0:06:26.42,*Default,NTP,0000,0000,0000,,Керемет! Бұл гений
Dialogue: 0,0:06:26.42,0:06:30.76,*Default,NTP,0000,0000,0000,,Керемет, Такая-сан, сен бұған күш саласың.
Dialogue: 0,0:06:30.76,0:06:35.16,*Default,NTP,0000,0000,0000,,Не? Бұл талпыныс па? Джо, сен күш-жігердің генийісің.
Dialogue: 0,0:06:37.26,0:06:40.49,*Default,NTP,0000,0000,0000,,Мен де бірінші күні станокқа құладым.
Dialogue: 0,0:06:40.77,0:06:44.22,*Default,NTP,0000,0000,0000,,Бірақ келесі күні мен құлап қалмауға жаттықтым.
Dialogue: 0,0:06:44.37,0:06:47.21,*Default,NTP,0000,0000,0000,,Сіз де біраз күш жұмсай аласыз.
Dialogue: 0,0:06:47.21,0:06:51.64,*Default,NTP,0000,0000,0000,,Эйчи! Эх! Ее! Міне бітті!
Dialogue: 0,0:06:53.61,0:06:57.01,*Default,NTP,0000,0000,0000,,Әй, шашың аздап кедергі жасап тұрған сияқты.
Dialogue: 0,0:07:02.79,0:07:04.48,*Default,NTP,0000,0000,0000,,Мен мұны көтеремін.
Dialogue: 0,0:07:04.49,0:07:08.02,*Default,NTP,0000,0000,0000,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:07:08.39,0:07:11.52,*Default,NTP,0000,0000,0000,,Сәттілік, Такая-сан.
Dialogue: 0,0:07:13.17,0:07:14.29,*Default,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:07:22.58,0:07:24.68,*Default,NTP,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:07:24.68,0:07:28.04,*Default,NTP,0000,0000,0000,,Кимико! Осы аптада Бикеш кім?
Dialogue: 0,0:07:28.31,0:07:31.41,*Default,NTP,0000,0000,0000,,Алты күн сәтті, тамаша кездесулер күтіп тұр.
Dialogue: 0,0:07:31.58,0:07:36.04,*Default,NTP,0000,0000,0000,,Шынымен! Бүгін менің өмірімдегі ең жақсы күн
Dialogue: 0,0:07:45.26,0:07:47.13,*Default,NTP,0000,0000,0000,,Алға ұмтыл!
Dialogue: 0,0:07:48.60,0:07:49.73,*Default,NTP,0000,0000,0000,,Түзет!
Dialogue: 0,0:07:52.54,0:07:55.61,*Default,NTP,0000,0000,0000,,Сол Люксион трагедиясынан бері алты жыл өтті.
Dialogue: 0,0:07:55.61,0:08:02.61,*Default,NTP,0000,0000,0000,,Бүкіл әлемді жаудың ғарыштық құбыжығына қарсы көтеру үшін «RX» жобасын бастағанымызға бес жыл болды.
Dialogue: 0,0:08:05.15,0:08:09.18,*Default,NTP,0000,0000,0000,,Әй, эй, көрші жігіттердің командасындағы екі жігіт кеше шешілген сияқты.
Dialogue: 0,0:08:09.72,0:08:12.16,*Default,NTP,0000,0000,0000,,Сенің мұнда да әпке болатыныңа сенімдімін.
Dialogue: 0,0:08:12.16,0:08:14.99,*Default,NTP,0000,0000,0000,,Ал, сұрақ басқа адам туралы.
Dialogue: 0,0:08:14.99,0:08:18.93,*Default,NTP,0000,0000,0000,,Барлық мектептерден таңдау бар сияқты, сондықтан бізде де мүмкіндік бар.
Dialogue: 0,0:08:19.37,0:08:23.97,*Default,NTP,0000,0000,0000,,Сүйікті әпкеммен ғарышқа ұшатын болсам, өлуге қарсы емеспін.
Dialogue: 0,0:08:23.97,0:08:27.07,*Default,NTP,0000,0000,0000,,Парка Шешу мүмкін емес.
Dialogue: 0,0:08:27.07,0:08:29.51,*Default,NTP,0000,0000,0000,,Мен үшінші курс студенті Кашихара мырза туралы шешім қабылдадым.
Dialogue: 0,0:08:29.51,0:08:32.34,*Default,NTP,0000,0000,0000,,Келесі жаттықтырушы подполковник.
Dialogue: 0,0:08:32.34,0:08:35.64,*Default,NTP,0000,0000,0000,,Мен сізді осы жоспар бойынша жұмыс істеуге келгеніңізді естідім.
Dialogue: 0,0:08:37.18,0:08:38.71,*Default,NTP,0000,0000,0000,,Тынш! Жаттықтырушы!
Dialogue: 0,0:08:40.02,0:08:45.65,*Default,NTP,0000,0000,0000,,Мен бүгіннен бастап сізге машиналар мен қаруларды пайдалануды үйрететін отакумын!
Dialogue: 0,0:08:46.06,0:08:48.96,*Default,NTP,0000,0000,0000,,Көтере алмағандар аяусыз құлатылады!
Dialogue: 0,0:08:50.33,0:08:53.53,*Default,NTP,0000,0000,0000,,Алдымен, барлығының авто балансизаторын өшіріңіз!
Dialogue: 0,0:08:54.57,0:08:57.37,*Default,NTP,0000,0000,0000,,Бұдан былай оны қайта пайдалануға рұқсат етілмейді!
Dialogue: 0,0:09:03.71,0:09:05.71,*Default,NTP,0000,0000,0000,,Нақты шайқас негізінен қолмен жүргізіледі!
Dialogue: 0,0:09:05.71,0:09:09.22,*Default,NTP,0000,0000,0000,,Егер сіз өзіңізді қорғай алмасаңыз, басынан бастаңыз!
Dialogue: 0,0:09:09.22,0:09:11.62,*Default,NTP,0000,0000,0000,,Дәл солай, барлығы 50 айналымнан өтеді!
Dialogue: 0,0:09:13.32,0:09:15.18,*Default,NTP,0000,0000,0000,,Шығар!
Dialogue: 0,0:09:16.69,0:09:20.65,*Default,NTP,0000,0000,0000,,Айқайлаңыз! Ұрыс! күрес
Dialogue: 0,0:09:26.20,0:09:29.97,*Default,NTP,0000,0000,0000,,Иә? иә? Ал, жүгір, жүгір...
Dialogue: 0,0:09:29.97,0:09:31.44,*Default,NTP,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:09:45.52,0:09:47.05,*Default,NTP,0000,0000,0000,,Бір жыл!
Dialogue: 0,0:09:47.05,0:09:51.11,*Default,NTP,0000,0000,0000,,Машинадан түсіңіз! Өз бетіңізше 50 айналым жасаңыз!
Dialogue: 0,0:09:59.50,0:10:01.73,*Default,NTP,0000,0000,0000,,Мектептен кететін уақыт келді.
Dialogue: 0,0:10:02.00,0:10:05.16,*Default,NTP,0000,0000,0000,,Студенттер кампуста әлі де бар
Dialogue: 0,0:10:05.24,0:10:07.71,*Default,NTP,0000,0000,0000,,Мектепті дереу тастаңыз.
Dialogue: 0,0:10:08.71,0:10:10.28,*Default,NTP,0000,0000,0000,,Сәлем Норико
Dialogue: 0,0:10:10.28,0:10:13.11,*Default,NTP,0000,0000,0000,,Норико, үйге тез қайт.
Dialogue: 0,0:10:13.11,0:10:16.21,*Default,NTP,0000,0000,0000,,Жоқ, мұндай жерде ұйықтауға болмайды.
Dialogue: 0,0:10:17.75,0:10:20.98,*Default,NTP,0000,0000,0000,,Мен енді қозғала алмаймын
Dialogue: 0,0:10:22.25,0:10:26.38,*Default,NTP,0000,0000,0000,,Қаласам 50 рет жасаймын.
Dialogue: 0,0:10:26.76,0:10:31.06,*Default,NTP,0000,0000,0000,,Эй, эй, тез киіміңді ауыстыр да, үйге қайт.
Dialogue: 0,0:10:46.28,0:10:47.40,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:49.55,0:10:52.35,*Default,NTP,0000,0000,0000,,Е! Мен!?
Dialogue: 0,0:10:53.12,0:10:56.58,*Default,NTP,0000,0000,0000,,Маған қарашы, өтірік айтамын~ Мен сенбеймін.
Dialogue: 0,0:11:02.73,0:11:04.33,*Default,NTP,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:11:04.33,0:11:06.07,*Default,NTP,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:11:06.07,0:11:08.00,*Default,NTP,0000,0000,0000,,Мына қызды қарашы.
Dialogue: 0,0:11:08.00,0:11:11.40,*Default,NTP,0000,0000,0000,,Менің әкем жойылған флоттың адмиралы болса керек.
Dialogue: 0,0:11:11.40,0:11:13.34,*Default,NTP,0000,0000,0000,,Сонымен, қосылымдар арқылы ұшқыш болғың келе ме?
Dialogue: 0,0:11:13.44,0:11:17.93,*Default,NTP,0000,0000,0000,,Білесің бе ғажап, Кеше көрдің.
Dialogue: 0,0:11:18.08,0:11:20.51,*Default,NTP,0000,0000,0000,,Сондай-ақ жаттықтырушыға қамқорлық жасау керек. Жоқ.
Dialogue: 0,0:11:20.51,0:11:22.08,*Default,NTP,0000,0000,0000,,Мен олардың бұған қалай кіргеніне таң қаламын.
Dialogue: 0,0:11:22.08,0:11:25.98,*Default,NTP,0000,0000,0000,,Жойылған қыз болса да, апасына жақындау үшін соншалықты алысқа барғысы келе ме деп ойлаймын.
Dialogue: 0,0:11:27.29,0:11:32.52,*Default,NTP,0000,0000,0000,,Жойылған қыз менің жарым, Ағамды аяймын~
Dialogue: 0,0:11:35.69,0:11:37.06,*Default,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:11:42.37,0:11:45.04,*Default,NTP,0000,0000,0000,,Бапкер не ойлап отыр екен...
Dialogue: 0,0:11:45.04,0:11:48.73,*Default,NTP,0000,0000,0000,,Мен жаттықтырушы не ойлап тұрғанын білмеймін!
Dialogue: 0,0:11:49.01,0:11:53.04,*Default,NTP,0000,0000,0000,,Ол баланың автомат мінгеніне - айлар ғана болды.
Dialogue: 0,0:11:53.45,0:11:58.18,*Default,NTP,0000,0000,0000,,Менің ойымша, үшінші курс студенті Кашихара мырза ғарышқа ұшуға ең лайықты адам.
Dialogue: 0,0:12:00.62,0:12:04.65,*Default,NTP,0000,0000,0000,,Ол адмирал Такаяның жалғыз қызы сияқты.
Dialogue: 0,0:12:09.23,0:12:14.03,*Default,NTP,0000,0000,0000,,Мен «Адмиралдың Люксион» ғарыш кемесінен аман қалдым.
Dialogue: 0,0:12:16.97,0:12:19.74,*Default,NTP,0000,0000,0000,,Ендеше ол ұшқыш болсын... Идиот!
Dialogue: 0,0:12:19.74,0:12:24.74,*Default,NTP,0000,0000,0000,,Қараңызшы, бұл жоспар сіз ойлағаннан да маңыздырақ.
Dialogue: 0,0:12:24.74,0:12:27.18,*Default,NTP,0000,0000,0000,,Бұл адамзаттың аман қалу мәселесі.
Dialogue: 0,0:12:27.18,0:12:28.48,*Default,NTP,0000,0000,0000,,Сонда неге...
Dialogue: 0,0:12:29.68,0:12:31.71,*Default,NTP,0000,0000,0000,,Мен жауаптымын
Dialogue: 0,0:12:32.42,0:12:34.69,*Default,NTP,0000,0000,0000,,Ол мұны істей алатын шығар...
Dialogue: 0,0:12:34.69,0:12:36.76,*Default,NTP,0000,0000,0000,,Жерде не бар?
Dialogue: 0,0:12:36.76,0:12:40.16,*Default,NTP,0000,0000,0000,,Пастер машинасы... Ғарышта болған соң түсінесіз.
Dialogue: 0,0:12:41.36,0:12:46.13,*Default,NTP,0000,0000,0000,,Жаттықтырушы папаның кемесінен аман қалған...
Dialogue: 0,0:12:54.14,0:12:56.87,*Default,NTP,0000,0000,0000,,Сонымен, сен не істейсің, Норико?
Dialogue: 0,0:12:57.58,0:13:00.41,*Default,NTP,0000,0000,0000,,Әпкем мені мүлдем жек көреді.
Dialogue: 0,0:13:00.41,0:13:05.85,*Default,NTP,0000,0000,0000,,Әкемнің байланысымен мен ұшқыш болдым және мектепте барлығына жау болдым.
Dialogue: 0,0:13:07.25,0:13:10.59,*Default,NTP,0000,0000,0000,,Не істеуім керек... бұл ең нашар...
Dialogue: 0,0:13:10.59,0:13:15.96,*Default,NTP,0000,0000,0000,,Осы аптада Бикеште басқалармен түсініспеушілік пен қиыншылықтардан сақ болыңыз!
Dialogue: 0,0:13:17.40,0:13:19.40,*Default,NTP,0000,0000,0000,,Жақсы, ол бәрібір тағайындалды.
Dialogue: 0,0:13:19.40,0:13:23.03,*Default,NTP,0000,0000,0000,,Қозғалыс үшін жаттығу жасаған дұрыс емес пе?
Dialogue: 0,0:13:29.04,0:13:30.28,*Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:13:45.86,0:13:48.88,*Default,NTP,0000,0000,0000,,Бар күшіңізді салмаңыз, иә...
Dialogue: 0,0:13:52.60,0:13:54.07,*Default,NTP,0000,0000,0000,,Иаа!
Dialogue: 0,0:13:55.47,0:13:56.99,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:58.84,0:14:00.13,*Default,NTP,0000,0000,0000,,Маған бұл енді ұнамайды
Dialogue: 0,0:14:01.41,0:14:04.31,*Default,NTP,0000,0000,0000,,Маған енді ұнамайды~
Dialogue: 0,0:14:09.08,0:14:09.95,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:14:11.05,0:14:15.35,*Default,NTP,0000,0000,0000,,Өтінемін, мені қорлауды доғарыңыз!
Dialogue: 0,0:14:15.89,0:14:18.12,*Default,NTP,0000,0000,0000,,Мен сені тағайындадым ба?
Dialogue: 0,0:14:18.49,0:14:20.56,*Default,NTP,0000,0000,0000,,Неліктен бұл қорлау деп ойлайсыз?
Dialogue: 0,0:14:20.56,0:14:23.23,*Default,NTP,0000,0000,0000,,Өйткені менде талант жоқ.
Dialogue: 0,0:14:23.23,0:14:26.17,*Default,NTP,0000,0000,0000,,Мүлдем жоқ! Үміт жоқ
Dialogue: 0,0:14:26.17,0:14:28.87,*Default,NTP,0000,0000,0000,,Әркім қамқорлық жасап жатқанын айтады.
Dialogue: 0,0:14:28.87,0:14:32.53,*Default,NTP,0000,0000,0000,,Ал сен Амано-сенпайдың серігісің.
Dialogue: 0,0:14:33.11,0:14:36.51,*Default,NTP,0000,0000,0000,,Сұмдық, қатыгездік.
Dialogue: 0,0:14:37.28,0:14:39.34,*Default,NTP,0000,0000,0000,,Айтқыңыз келгені осы ғана ма?
Dialogue: 0,0:14:44.85,0:14:48.15,*Default,NTP,0000,0000,0000,,Ұшқыш болу үшін не қажет емес
Dialogue: 0,0:14:48.52,0:14:50.99,*Default,NTP,0000,0000,0000,,Аманода бар.
Dialogue: 0,0:14:51.42,0:14:53.05,*Default,NTP,0000,0000,0000,,Менің артымнан жүр!
Dialogue: 0,0:15:02.50,0:15:03.49,*Default,NTP,0000,0000,0000,,Мынаны қараңыз!
Dialogue: 0,0:15:04.50,0:15:07.20,*Default,NTP,0000,0000,0000,,Бұл сізде жоқ!
Dialogue: 0,0:15:10.81,0:15:13.33,*Default,NTP,0000,0000,0000,,Менің әпкем темір гета киеді!
Dialogue: 0,0:15:13.81,0:15:15.84,*Default,NTP,0000,0000,0000,,Аманоның таланты бар!
Dialogue: 0,0:15:16.88,0:15:19.89,*Default,NTP,0000,0000,0000,,Бірақ одан да артық, оның талантын айқындайтын нәрсе
Dialogue: 0,0:15:19.89,0:15:21.94,*Default,NTP,0000,0000,0000,,Өзінің күш-жігері!
Dialogue: 0,0:15:22.39,0:15:26.06,*Default,NTP,0000,0000,0000,,Иә, мен мұны істеуге бар күшімді саламын.
Dialogue: 0,0:15:26.06,0:15:28.53,*Default,NTP,0000,0000,0000,,Расында да, сізде талант жоқ!
Dialogue: 0,0:15:29.16,0:15:31.90,*Default,NTP,0000,0000,0000,,Өйткені күш толығымен жойылды.
Dialogue: 0,0:15:31.90,0:15:35.86,*Default,NTP,0000,0000,0000,,Бірақ сенде талант бар, сондықтан мен сені таңдадым.
Dialogue: 0,0:15:37.10,0:15:40.84,*Default,NTP,0000,0000,0000,,Такая! Талпыныс жасаңыз, талантыңызды шыңдаңыз және басқаларға сенбеңіз!
Dialogue: 0,0:15:40.84,0:15:44.58,*Default,NTP,0000,0000,0000,,Тыңда, бүкіл денеңмен сезін, баспен ойла, жүрегіңмен бағала!
Dialogue: 0,0:15:44.58,0:15:46.87,*Default,NTP,0000,0000,0000,,Әлемде сенуге болатын жалғыз адам ол өзіңсің!
Dialogue: 0,0:15:49.18,0:15:50.08,*Default,NTP,0000,0000,0000,,Жаттықтырушы…
Dialogue: 0,0:15:50.08,0:15:53.52,*Default,NTP,0000,0000,0000,,Аманомен бірге ғарышқа ұшыңыз!
Dialogue: 0,0:15:53.52,0:15:57.08,*Default,NTP,0000,0000,0000,,Сізде бір нәрсе істеу керек.
Dialogue: 0,0:17:18.80,0:17:22.74,*Default,NTP,0000,0000,0000,,Мен ол бірден бас тартады деп ойладым, бірақ ол таң қаларлықтай тырысып жатыр.
Dialogue: 0,0:17:23.04,0:17:24.27,*Default,NTP,0000,0000,0000,,Мұны істеу мүмкін емес.
Dialogue: 0,0:17:26.04,0:17:28.34,*Default,NTP,0000,0000,0000,,Негіздер жақсарды.
Dialogue: 0,0:17:29.31,0:17:33.22,*Default,NTP,0000,0000,0000,,Дұрыс, жанымда үнемі жаттықтырушы болады.
Dialogue: 0,0:17:33.22,0:17:35.85,*Default,NTP,0000,0000,0000,,Жақсырақ болатының табиғи нәрсе.
Dialogue: 0,0:17:57.01,0:18:01.11,*Default,NTP,0000,0000,0000,,Жаттықтырушы! Мен Такая-саннан төменмін деп не айтасың?
Dialogue: 0,0:18:01.11,0:18:02.98,*Default,NTP,0000,0000,0000,,Айтыңызшы, жаттықтырушы!
Dialogue: 0,0:18:04.28,0:18:05.81,*Default,NTP,0000,0000,0000,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:18:06.85,0:18:07.98,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:18:08.35,0:18:10.08,*Default,NTP,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:18:11.26,0:18:15.28,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:22.37,0:18:24.89,*Default,NTP,0000,0000,0000,,Сізді екінші лейтенант лауазымына тағайындалуыңызбен құттықтаймыз, Такая-сан
Dialogue: 0,0:18:27.31,0:18:29.31,*Default,NTP,0000,0000,0000,,Біз ертең жолға шығамыз.
Dialogue: 0,0:18:29.31,0:18:33.38,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:33.38,0:18:34.94,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:18:37.22,0:18:40.12,*Default,NTP,0000,0000,0000,,Келіңіз, өз машинаңызды мініңіз.
Dialogue: 0,0:18:46.86,0:18:51.49,*Default,NTP,0000,0000,0000,,Кетер алдында тоқтайсың деп ойладым, бірақ таң қаларлықтай жұмыс істедің.
Dialogue: 0,0:18:53.03,0:18:56.23,*Default,NTP,0000,0000,0000,,Бірақ сен тоқтамасаң, мен сені тоқтатамын!
Dialogue: 0,0:18:56.23,0:18:58.36,*Default,NTP,0000,0000,0000,,Кеттік! Жойылған қыз!
Dialogue: 0,0:19:00.51,0:19:04.20,*Default,NTP,0000,0000,0000,,Қашықтық 9,7 8,5… уф…
Dialogue: 0,0:19:21.49,0:19:25.79,*Default,NTP,0000,0000,0000,,Қолыңыздан тек жүгіру ғана қалғанда қоян-қолтық ұрыста күресу мүмкін емес сияқты.
Dialogue: 0,0:19:31.37,0:19:32.17,*Default,NTP,0000,0000,0000,,Сізге!
Dialogue: 0,0:19:35.31,0:19:37.00,*Default,NTP,0000,0000,0000,,Өз қабілетіңізді көрсетіңіз!
Dialogue: 0,0:19:42.78,0:19:43.98,*Default,NTP,0000,0000,0000,,Барлығына!
Dialogue: 0,0:19:45.58,0:19:49.49,*Default,NTP,0000,0000,0000,,Қараңдар! Түсіндің бе!
Dialogue: 0,0:19:58.13,0:20:00.83,*Default,NTP,0000,0000,0000,,Норико Норико Жақсысың ба?
Dialogue: 0,0:20:03.34,0:20:05.84,*Default,NTP,0000,0000,0000,,Жаттықтырушы! Өтінемін, қазір тоқтатуға рұқсат етіңіз.
Dialogue: 0,0:20:05.84,0:20:09.27,*Default,NTP,0000,0000,0000,,Мен енді мұны істей алмаймын! Мен Нориконы аяймын!
Dialogue: 0,0:20:09.81,0:20:13.01,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Шынайы шайқас бұлай емес!
Dialogue: 0,0:20:13.21,0:20:14.18,*Default,NTP,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:20:16.88,0:20:19.11,*Default,NTP,0000,0000,0000,,Басқа кім мойындаса да
Dialogue: 0,0:20:19.89,0:20:22.51,*Default,NTP,0000,0000,0000,,Мен мұны құптамаймын.
Dialogue: 0,0:20:23.99,0:20:25.89,*Default,NTP,0000,0000,0000,,Жаттықтырушы… Жаттықтырушы…
Dialogue: 0,0:20:25.89,0:20:28.49,*Default,NTP,0000,0000,0000,,Мен не істеуім керек, жаттықтырушы?
Dialogue: 0,0:20:28.49,0:20:33.12,*Default,NTP,0000,0000,0000,,Басқаларға сенбе. Бүкіл денеңмен сезініп, жүрегіңмен бағала!
Dialogue: 0,0:20:33.33,0:20:36.46,*Default,NTP,0000,0000,0000,,Дұрыс, мен Намаджи мониторына алаңдаймын...
Dialogue: 0,0:20:39.47,0:20:40.96,*Default,NTP,0000,0000,0000,,Байқап көріңіз!
Dialogue: 0,0:20:43.24,0:20:44.84,*Default,NTP,0000,0000,0000,,Мен мониторды өшірдім!
Dialogue: 0,0:20:44.84,0:20:46.21,*Default,NTP,0000,0000,0000,,Не деген...
Dialogue: 0,0:20:52.35,0:20:57.25,*Default,NTP,0000,0000,0000,,Пуф! Папа! Па, бака кашитейчи!
Dialogue: 0,0:20:57.66,0:20:59.18,*Default,NTP,0000,0000,0000,,Міне!
Dialogue: 0,0:21:00.79,0:21:04.92,*Default,NTP,0000,0000,0000,,Үшбұрыштың бір парағы!
Dialogue: 0,0:21:06.13,0:21:07.10,*Default,NTP,0000,0000,0000,,Қазір!
Dialogue: 0,0:21:10.00,0:21:12.06,*Default,NTP,0000,0000,0000,,Toto Fly Aichi
Dialogue: 0,0:21:13.97,0:21:15.06,*Default,NTP,0000,0000,0000,,Жоқ!?
Dialogue: 0,0:21:18.38,0:21:23.37,*Default,NTP,0000,0000,0000,,Найзағай соғуы!
Dialogue: 0,0:21:41.33,0:21:42.93,*Default,NTP,0000,0000,0000,,Мен жеңілдім
Dialogue: 0,0:21:43.24,0:21:48.07,*Default,NTP,0000,0000,0000,,Автоматқа мініп, ай баласы сол найзағай тепті...
Dialogue: 0,0:21:48.07,0:21:49.97,*Default,NTP,0000,0000,0000,,Мен сене алар емеспін.
Dialogue: 0,0:22:03.12,0:22:05.32,*Default,NTP,0000,0000,0000,,Такая Амано
Dialogue: 0,0:22:06.29,0:22:10.03,*Default,NTP,0000,0000,0000,,Сіз бірінші болып машиналық қару бөліміне шабуыл жасайсыз.
Dialogue: 0,0:22:10.03,0:22:12.12,*Default,NTP,0000,0000,0000,,Жоғарғы топтың мүшесі болыңыз
Dialogue: 0,0:22:14.37,0:22:17.96,*Default,NTP,0000,0000,0000,,Бірақ нағыз қиындық әлі алда.
Dialogue: 0,0:22:18.54,0:22:20.44,*Default,NTP,0000,0000,0000,,Нағыз шың болу
Dialogue: 0,0:22:21.97,0:22:26.50,*Default,NTP,0000,0000,0000,,Адамдарды шынайы қорғай алатын және достарын құтқара алатын ғарыш жауынгері болу.
Dialogue: 0,0:22:28.88,0:22:31.82,*Default,NTP,0000,0000,0000,,Талпынуды тоқтатпаңыз, оны жеңіңіз
Dialogue: 0,0:22:31.82,0:22:34.18,*Default,NTP,0000,0000,0000,,Және күрес!
Dialogue: 0,0:23:15.43,0:23:18.95,*Default,NTP,0000,0000,0000,,Әдемі Фудзи тауы
Dialogue: 0,0:23:22.37,0:23:26.10,*Default,NTP,0000,0000,0000,,Иә! Биікке ұмтылыңыз!
Dialogue: 0,0:23:56.94,0:24:01.65,*Default,NTP,0000,0000,0000,,Ол кішкентай қарындасы сияқты
Dialogue: 0,0:24:01.65,0:24:06.48,*Default,NTP,0000,0000,0000,,Жауапты күбірлеп айттыңыз.
Dialogue: 0,0:24:06.48,0:24:11.19,*Default,NTP,0000,0000,0000,,Шарасыз мойындау
Dialogue: 0,0:24:11.19,0:24:15.19,*Default,NTP,0000,0000,0000,,Желге шашылған жексенбі
Dialogue: 0,0:24:15.19,0:24:19.76,*Default,NTP,0000,0000,0000,,Егер сізді күн астында тастап кетсе
Dialogue: 0,0:24:19.76,0:24:24.54,*Default,NTP,0000,0000,0000,,Көз жасына орын жоқ
Dialogue: 0,0:24:24.54,0:24:31.94,*Default,NTP,0000,0000,0000,,Мен Бозеннің арқасына қолымды қыстым...
Dialogue: 0,0:24:31.94,0:24:33.95,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:33.95,0:24:42.49,*Default,NTP,0000,0000,0000,,Содан кейін қараңғы күндер
Dialogue: 0,0:24:42.49,0:24:46.96,*Default,NTP,0000,0000,0000,,Бірақ, ғашық болу күші
Dialogue: 0,0:24:46.96,0:24:51.40,*Default,NTP,0000,0000,0000,,Кеудеде жазықсыз ұрыс
Dialogue: 0,0:24:51.40,0:24:55.83,*Default,NTP,0000,0000,0000,,Жүректің тереңінде, қылқалам
Dialogue: 0,0:24:55.83,0:25:01.07,*Default,NTP,0000,0000,0000,,Мен бір күні қайталап көремін
Dialogue: 0,0:25:02.57,0:25:08.57,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
