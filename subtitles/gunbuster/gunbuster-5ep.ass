Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.63,0:00:19.66,*Default,NTP,0000,0000,0000,,Дипломдық марапат
Dialogue: 0,0:00:21.00,0:00:23.53,*Default,NTP,0000,0000,0000,,Жер империясының ғарыш күштеріне қосылған
Dialogue: 0,0:00:23.71,0:00:29.61,*Default,NTP,0000,0000,0000,,Окинава әйелдер ғарыштық орта мектебі 3-сынып 2 Сабаққа қатысу саны 2
Dialogue: 0,0:00:29.75,0:00:31.54,*Default,NTP,0000,0000,0000,,Казуми Амано
Dialogue: 0,0:00:31.68,0:00:32.61,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:00:35.25,0:00:38.25,*Default,NTP,0000,0000,0000,,Ғарыштан оралғанда бізді не күтіп тұрды?
Dialogue: 0,0:00:38.25,0:00:40.55,*Default,NTP,0000,0000,0000,,Бұл Окинаның бітіру рәсімі болды.
Dialogue: 0,0:00:42.69,0:00:44.79,*Default,NTP,0000,0000,0000,,Аа, тым ерте бітіру рәсімі.
Dialogue: 0,0:00:46.33,0:00:50.96,*Default,NTP,0000,0000,0000,,Бұл мектеп ғимаратында менің тек 4 айлық естеліктерім бар.
Dialogue: 0,0:00:51.40,0:00:55.96,*Default,NTP,0000,0000,0000,,Бірақ Жерде он жыл өтті.
Dialogue: 0,0:00:58.31,0:01:02.71,*Default,NTP,0000,0000,0000,,Кашихара мырза да қазір осы мектепте мұғалім.
Dialogue: 0,0:01:03.81,0:01:07.37,*Default,NTP,0000,0000,0000,,Сыныптастар енді жоқ...
Dialogue: 0,0:01:08.32,0:01:09.79,*Default,NTP,0000,0000,0000,,Кимико да жоқ
Dialogue: 0,0:01:10.52,0:01:13.79,*Default,NTP,0000,0000,0000,,Ғалам тіпті біздің естеліктерімізді де сіңіреді...
Dialogue: 0,0:01:15.56,0:01:17.89,*Default,NTP,0000,0000,0000,,Сонымен қатар, 3-сынып, 1-сынып
Dialogue: 0,0:01:19.10,0:01:20.86,*Default,NTP,0000,0000,0000,,Норико Такая
Dialogue: 0,0:01:20.86,0:01:21.92,*Default,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:01:32.54,0:01:34.98,*Default,NTP,0000,0000,0000,,Сіз 17 жаста бітірдіңіз бе?
Dialogue: 0,0:01:34.98,0:01:37.67,*Default,NTP,0000,0000,0000,,Сіз өміріңізде пайда тапқан сияқтысыз.
Dialogue: 0,0:01:38.65,0:01:40.62,*Default,NTP,0000,0000,0000,,Сіз ештеңе түсінбейсіз.
Dialogue: 0,0:01:40.82,0:01:44.12,*Default,NTP,0000,0000,0000,,Сіздің отбасыңыздың тізімі бойынша сіз 27 жастасыз.
Dialogue: 0,0:01:44.92,0:01:50.36,*Default,NTP,0000,0000,0000,,Жарайды, мен балалы болатын жастамын.
Dialogue: 0,0:01:56.37,0:01:57.60,*Default,NTP,0000,0000,0000,,А, бұл~
Dialogue: 0,0:01:57.60,0:01:58.73,*Default,NTP,0000,0000,0000,,Сіз…
Dialogue: 0,0:02:00.27,0:02:01.74,*Default,NTP,0000,0000,0000,,Норико Такая?
Dialogue: 0,0:02:04.67,0:02:06.07,*Default,NTP,0000,0000,0000,,Кимико?
Dialogue: 0,0:02:12.62,0:02:15.91,*Default,NTP,0000,0000,0000,,Сонымен, Хи Чан мен Рикко үйленді ме?
Dialogue: 0,0:02:16.35,0:02:18.65,*Default,NTP,0000,0000,0000,,Мен ғана қалдым деп ойлаймын.
Dialogue: 0,0:02:19.49,0:02:22.33,*Default,NTP,0000,0000,0000,,Оның үстіне, Кимико ана болды...
Dialogue: 0,0:02:22.33,0:02:23.99,*Default,NTP,0000,0000,0000,,Эй, Таками неше жаста?
Dialogue: 0,0:02:24.23,0:02:26.46,*Default,NTP,0000,0000,0000,,Келесі жолы мен үш жаста боламын.
Dialogue: 0,0:02:32.74,0:02:34.03,*Default,NTP,0000,0000,0000,,Не? иә?
Dialogue: 0,0:02:35.24,0:02:36.51,*Default,NTP,0000,0000,0000,,Элтрий
Dialogue: 0,0:02:36.51,0:02:38.24,*Default,NTP,0000,0000,0000,,Иә, солай ма?
Dialogue: 0,0:02:38.24,0:02:43.20,*Default,NTP,0000,0000,0000,,Иә, тіпті осы жерден дүрбімен пішінді анық көруге болады.
Dialogue: 0,0:02:46.52,0:02:48.08,*Default,NTP,0000,0000,0000,,Бұл үлкен!
Dialogue: 0,0:02:48.08,0:02:51.21,*Default,NTP,0000,0000,0000,,Жалпы ұзындығы 70 км-ден астам деп айтылады.
Dialogue: 0,0:02:51.52,0:02:55.01,*Default,NTP,0000,0000,0000,,Бұл Жерден қашуға арналған кеме сияқты.
Dialogue: 0,0:02:55.59,0:02:56.62,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:02:57.19,0:02:59.99,*Default,NTP,0000,0000,0000,,Сыбыс әскери қызметкерлерге басымдық береді.
Dialogue: 0,0:03:00.30,0:03:03.66,*Default,NTP,0000,0000,0000,,4000 бейбіт тұрғынның 1-і ғана міне алады.
Dialogue: 0,0:03:04.53,0:03:05.66,*Default,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:03:06.54,0:03:08.60,*Default,NTP,0000,0000,0000,,Мені менсінбеуге болады
Dialogue: 0,0:03:10.47,0:03:15.43,*Default,NTP,0000,0000,0000,,Норико, сіздің байланыстарыңызбен Такамидің орны туралы бірдеңе істей алмаймыз ба?
Dialogue: 0,0:03:15.65,0:03:19.27,*Default,NTP,0000,0000,0000,,Мен ол баланың...болашағын қалаймын.
Dialogue: 0,0:03:20.82,0:03:22.01,*Default,NTP,0000,0000,0000,,Кимико…
Dialogue: 0,0:03:31.03,0:03:32.72,*Default,NTP,0000,0000,0000,,Сәлем, Кимико!
Dialogue: 0,0:03:33.10,0:03:37.03,*Default,NTP,0000,0000,0000,,Жоқ, жоқ... Кимико-сан, қош келдіңіз. Атаками-чан?
Dialogue: 0,0:03:37.03,0:03:39.00,*Default,NTP,0000,0000,0000,,Мен Норико-оне-чан
Dialogue: 0,0:03:39.20,0:03:42.01,*Default,NTP,0000,0000,0000,,Жоқ! Ол әлі апай емес пе?
Dialogue: 0,0:03:42.01,0:03:43.63,*Default,NTP,0000,0000,0000,,Дұрыс? Анаң сонда ма?
Dialogue: 0,0:03:44.17,0:03:46.64,*Default,NTP,0000,0000,0000,,Аа, әкеммен шығу~
Dialogue: 0,0:03:46.74,0:03:50.68,*Default,NTP,0000,0000,0000,,Олай болса, Таками-чан үйде жалғыз қалады.
Dialogue: 0,0:03:50.68,0:03:55.64,*Default,NTP,0000,0000,0000,,Жарайды, Таками-чан, Норико анасына кешірім сұрады.
Dialogue: 0,0:03:57.02,0:04:00.05,*Default,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:04:02.56,0:04:04.96,*Default,NTP,0000,0000,0000,,Такамидің болашағы...
Dialogue: 0,0:04:05.66,0:04:08.29,*Default,NTP,0000,0000,0000,,Кимико толығымен ана
Dialogue: 0,0:04:09.73,0:04:13.19,*Default,NTP,0000,0000,0000,,Мен ғарышта болғанша қаншама уақыт өтті.
Dialogue: 0,0:04:14.24,0:04:16.64,*Default,NTP,0000,0000,0000,,Мен жалғыз қалдым
Dialogue: 0,0:04:18.67,0:04:19.54,*Default,NTP,0000,0000,0000,,Увааах! Оох…
Dialogue: 0,0:04:22.01,0:04:26.52,*Default,NTP,0000,0000,0000,,Әкең ғарыштан оралған сайын осылай сезінді ме?
Dialogue: 0,0:04:26.52,0:04:28.61,*Default,NTP,0000,0000,0000,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,0:04:48.27,0:04:49.61,*Default,NTP,0000,0000,0000,,Не? Не?
Dialogue: 0,0:04:49.61,0:04:51.16,*Default,NTP,0000,0000,0000,,Мен сізді естімеймін! сурет?
Dialogue: 0,0:04:51.97,0:04:52.94,*Default,NTP,0000,0000,0000,,Котоза?
Dialogue: 0,0:04:54.28,0:04:56.05,*Default,NTP,0000,0000,0000,,326 шамасында?
Dialogue: 0,0:04:56.05,0:04:57.55,*Default,NTP,0000,0000,0000,,Жаулардың үлкен тобы!
Dialogue: 0,0:04:57.55,0:05:02.05,*Default,NTP,0000,0000,0000,,Иә! Дұшпанның көптігі сонша, ғалам қара болып көрінбейді.
Dialogue: 0,0:05:02.05,0:05:04.05,*Default,NTP,0000,0000,0000,,Жау – 7 минут, қара – 3 минут
Dialogue: 0,0:05:04.05,0:05:07.61,*Default,NTP,0000,0000,0000,,Жарайсың ба? Жау 7 минут, қара 3 минут!
Dialogue: 0,0:05:09.09,0:05:13.15,*Default,NTP,0000,0000,0000,,Дегенерацияланған радар арқылы өлшенген мәндер, өйткені нысаналар тығыз түзілімде.
Dialogue: 0,0:05:13.20,0:05:15.43,*Default,NTP,0000,0000,0000,,Нақты санды анықтау мүмкін емес
Dialogue: 0,0:05:15.43,0:05:17.52,*Default,NTP,0000,0000,0000,,Ол 100 миллионнан асады деген болжам бар.
Dialogue: 0,0:05:17.80,0:05:20.17,*Default,NTP,0000,0000,0000,,Қанаттар шамамен 80 астрономиялық бірлік
Dialogue: 0,0:05:20.17,0:05:24.34,*Default,NTP,0000,0000,0000,,Соңғы қорғаныс сызығына қашан жететіні әзірге белгісіз.
Dialogue: 0,0:05:24.34,0:05:29.71,*Default,NTP,0000,0000,0000,,80 астрономиялық бірлік Pin және бұл... Плутон орбитасының шамамен диаметрі
Dialogue: 0,0:05:30.35,0:05:31.31,*Default,NTP,0000,0000,0000,,Мен бұл туралы ойлана алмаймын.
Dialogue: 0,0:05:31.58,0:05:35.25,*Default,NTP,0000,0000,0000,,Олар... жаңа ғана келді ме?
Dialogue: 0,0:05:35.25,0:05:36.59,*Default,NTP,0000,0000,0000,,Келесі жаңалықтар
Dialogue: 0,0:05:36.59,0:05:39.12,*Default,NTP,0000,0000,0000,,11 жыл бұрын ғарыштық құбыжықтармен күресу үшін Ғарыш күштерінің құрамында құрылған жоғарғы бөлімше таратылды.
Dialogue: 0,0:05:39.12,0:05:42.13,*Default,NTP,0000,0000,0000,,11 жыл бұрын ғарыштық құбыжықтармен күресу үшін Ғарыш күштерінің құрамында құрылған жоғарғы бөлімше таратылды.
Dialogue: 0,0:05:42.13,0:05:44.42,*Default,NTP,0000,0000,0000,,Қазір ресми түрде жарияланды
Dialogue: 0,0:05:45.63,0:05:49.30,*Default,NTP,0000,0000,0000,,Подполковник Такая лейтенант Такая подполковник Ота шақырып жатыр.
Dialogue: 0,0:05:49.30,0:05:51.70,*Default,NTP,0000,0000,0000,,Тез арада қызметкерлер бөлмесіне келіңіз.
Dialogue: 0,0:05:55.40,0:05:56.27,*Default,NTP,0000,0000,0000,,Жаңбыр?
Dialogue: 0,0:06:02.68,0:06:04.25,*Default,NTP,0000,0000,0000,,Сіз тым өзімшілсіз.
Dialogue: 0,0:06:04.25,0:06:07.15,*Default,NTP,0000,0000,0000,,Тек солай істе! Мен саған мүлдем мән бермеймін
Dialogue: 0,0:06:07.15,0:06:10.18,*Default,NTP,0000,0000,0000,,Онда маған келме!
Dialogue: 0,0:06:47.82,0:06:48.76,*Default,NTP,0000,0000,0000,,Әпке...
Dialogue: 0,0:06:53.50,0:06:54.52,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:06:55.13,0:06:55.76,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:06:57.40,0:06:59.30,*Default,NTP,0000,0000,0000,,Сәлеметсіз бе! сәлем!
Dialogue: 0,0:06:59.30,0:07:02.29,*Default,NTP,0000,0000,0000,,Ах! Бұл Окинава қыздарының ғарыштық орта мектебі...
Dialogue: 0,0:07:03.57,0:07:05.54,*Default,NTP,0000,0000,0000,,Жаттықтырушы! Сен не істеп жатырсың?
Dialogue: 0,0:07:06.08,0:07:08.48,*Default,NTP,0000,0000,0000,,А... Аманоға айтпа.
Dialogue: 0,0:07:09.25,0:07:11.71,*Default,NTP,0000,0000,0000,,Айтсаң өлтіремін!
Dialogue: 0,0:07:13.68,0:07:14.98,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:07:15.25,0:07:16.55,*Default,NTP,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,0:07:17.35,0:07:19.72,*Default,NTP,0000,0000,0000,,Жаттықтырушы! жаттықтырушы!
Dialogue: 0,0:07:23.03,0:07:24.89,*Default,NTP,0000,0000,0000,,Норико Аташин Хажиме
Dialogue: 0,0:07:25.19,0:07:28.10,*Default,NTP,0000,0000,0000,,Мен жаңа махаббатта өмір сүруді шештім~
Dialogue: 0,0:07:29.30,0:07:31.36,*Default,NTP,0000,0000,0000,,Жаттықтырушыдан бас тарту
Dialogue: 0,0:07:32.07,0:07:34.70,*Default,NTP,0000,0000,0000,,Нағыз адамдар сіз сияқты өмір сүре алмайды.
Dialogue: 0,0:07:35.81,0:07:39.43,*Default,NTP,0000,0000,0000,,Сонымен, біз қаншалықты көп кездессек, соғұрлым қоштасу болады.
Dialogue: 0,0:07:40.81,0:07:43.55,*Default,NTP,0000,0000,0000,,Сізде бір ғана өмір бар.
Dialogue: 0,0:07:43.55,0:07:47.35,*Default,NTP,0000,0000,0000,,Бір минутты да босқа өткізгім келмейді. Уақыт ешқашан тоқтамайды.
Dialogue: 0,0:07:48.58,0:07:52.52,*Default,NTP,0000,0000,0000,,Ей, мұңайып едің ғой? Сол күні?
Dialogue: 0,0:07:53.09,0:07:54.08,*Default,NTP,0000,0000,0000,,Байчи?
Dialogue: 0,0:08:07.87,0:08:11.77,*Default,NTP,0000,0000,0000,,Нағыз адамдар сіз сияқты өмір сүре алмайды.
Dialogue: 0,0:08:12.04,0:08:16.74,*Default,NTP,0000,0000,0000,,Сондықтан мен өз өміріммен өмір сүремін...
Dialogue: 0,0:08:20.32,0:08:22.34,*Default,NTP,0000,0000,0000,,Жаттықтырушы! жаттықтырушы!
Dialogue: 0,0:08:23.15,0:08:24.12,*Default,NTP,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,0:08:25.42,0:08:26.51,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:08:26.86,0:08:31.52,*Default,NTP,0000,0000,0000,,Такая Адамзат қазіргі уақытта уақыт басынан бергі ең үлкен дағдарыспен бетпе-бет келіп отыр.
Dialogue: 0,0:08:31.73,0:08:33.06,*Default,NTP,0000,0000,0000,,Одан да көп...
Dialogue: 0,0:08:33.06,0:08:33.76,*Default,NTP,0000,0000,0000,,Аузыңды жап, тыңда!
Dialogue: 0,0:08:39.24,0:08:44.76,*Default,NTP,0000,0000,0000,,Бір топ жау келді. Бұл ең үлкен шабуыл.
Dialogue: 0,0:08:44.97,0:08:48.10,*Default,NTP,0000,0000,0000,,Адамзаттың аман қалу мүмкіндігі ғана бар!
Dialogue: 0,0:08:49.28,0:08:51.25,*Default,NTP,0000,0000,0000,,Бұл сіздің қарусыз қаруыңыз!
Dialogue: 0,0:08:52.15,0:08:53.12,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:08:53.32,0:08:54.37,*Default,NTP,0000,0000,0000,,Такая
Dialogue: 0,0:08:54.65,0:08:55.62,*Default,NTP,0000,0000,0000,,Жеңіс!
Dialogue: 0,0:08:57.25,0:09:00.48,*Default,NTP,0000,0000,0000,,Жерді сақтап, достарымызға көмектесу
Dialogue: 0,0:09:02.56,0:09:05.49,*Default,NTP,0000,0000,0000,,Gunbaster жеңуі керек!
Dialogue: 0,0:09:07.06,0:09:08.59,*Default,NTP,0000,0000,0000,,Тыңда, Такая.
Dialogue: 0,0:09:09.17,0:09:09.53,*Default,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:09:09.67,0:09:13.29,*Default,NTP,0000,0000,0000,,Жалғыз, Амано екеуің жай отсыңдар.
Dialogue: 0,0:09:14.34,0:09:16.31,*Default,NTP,0000,0000,0000,,Екі адам қосылса, жалынға айналады.
Dialogue: 0,0:09:16.74,0:09:18.64,*Default,NTP,0000,0000,0000,,Мылтық атқылаушы жалынға айналды
Dialogue: 0,0:09:19.51,0:09:20.37,*Default,NTP,0000,0000,0000,,Жеңілмейтін!
Dialogue: 0,0:09:20.98,0:09:21.60,*Default,NTP,0000,0000,0000,,Жаттықтырушы…
Dialogue: 0,0:09:22.04,0:09:23.67,*Default,NTP,0000,0000,0000,,Мен таңдағандар сендерсіңдер.
Dialogue: 0,0:09:24.98,0:09:26.72,*Default,NTP,0000,0000,0000,,Сіз міндетті түрде жеңесіз!
Dialogue: 0,0:09:26.72,0:09:28.18,*Default,NTP,0000,0000,0000,,Сәлем! жаттықтырушы!
Dialogue: 0,0:09:31.05,0:09:31.95,*Default,NTP,0000,0000,0000,,Такая…
Dialogue: 0,0:09:32.22,0:09:32.95,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:09:33.52,0:09:37.69,*Default,NTP,0000,0000,0000,,Сол кезде мен адмирал Такаяны өлгенше қорғауға бел байладым.
Dialogue: 0,0:09:38.09,0:09:40.39,*Default,NTP,0000,0000,0000,,Бірақ шындық керісінше.
Dialogue: 0,0:09:41.10,0:09:43.73,*Default,NTP,0000,0000,0000,,Менің ойымша, сіз оны жеңе алмайсыз.
Dialogue: 0,0:09:44.03,0:09:47.40,*Default,NTP,0000,0000,0000,,Бұл...Тренер, мен мұны қаламаймын...
Dialogue: 0,0:09:47.80,0:09:52.37,*Default,NTP,0000,0000,0000,,Осы уақытқа дейін мен адмирал сеніп тапсырған болашақта өмір сүріп келемін.
Dialogue: 0,0:09:52.44,0:09:56.50,*Default,NTP,0000,0000,0000,,Бұл оны сізге Хеган Бастермен бірге тапсыру.
Dialogue: 0,0:09:57.45,0:09:59.74,*Default,NTP,0000,0000,0000,,Бұл да жақында бітеді.
Dialogue: 0,0:10:01.28,0:10:02.25,*Default,NTP,0000,0000,0000,,Такая…
Dialogue: 0,0:10:02.72,0:10:03.18,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:10:03.79,0:10:08.29,*Default,NTP,0000,0000,0000,,Менің денем туралы үндемеңіз.
Dialogue: 0,0:10:08.29,0:10:14.53,*Default,NTP,0000,0000,0000,,Ол әлсіз. Осыны білсе, төбелесе алмас еді.
Dialogue: 0,0:10:16.47,0:10:18.02,*Default,NTP,0000,0000,0000,,Такая өтінемін
Dialogue: 0,0:10:18.80,0:10:21.27,*Default,NTP,0000,0000,0000,,Аманоны қорғаңыз...
Dialogue: 0,0:10:22.64,0:10:23.76,*Default,NTP,0000,0000,0000,,Мені қорға!
Dialogue: 0,0:10:34.65,0:10:38.45,*Default,NTP,0000,0000,0000,,Мен оны қорғаймын ба? Сіздің әпкеңіз?
Dialogue: 0,0:10:40.46,0:10:41.45,*Default,NTP,0000,0000,0000,,Көз жасы?
Dialogue: 0,0:10:52.80,0:10:55.77,*Default,NTP,0000,0000,0000,,Мен сенің істегеніңді білдім...Әпке.
Dialogue: 0,0:11:06.22,0:11:08.34,*Default,NTP,0000,0000,0000,,Әйтеуір, жау келді!
Dialogue: 0,0:11:09.62,0:11:13.05,*Default,NTP,0000,0000,0000,,Бар күш-қуатымызды көтеріп, оның жолын кесуден басқа амалымыз жоқ!
Dialogue: 0,0:11:13.39,0:11:16.79,*Default,NTP,0000,0000,0000,,Мен сұраған эрутория не болып жатыр?
Dialogue: 0,0:11:17.89,0:11:20.62,*Default,NTP,0000,0000,0000,,Қазіргі уақытта құмырсқаларды дайындау 16%-ға өсті, ал қолдау бөлімшелері ертеңнен бастап қол жетімді болады.
Dialogue: 0,0:11:20.90,0:11:25.27,*Default,NTP,0000,0000,0000,,1500 жаңа адам Жоқ! Жоқ! Жоқ!
Dialogue: 0,0:11:25.27,0:11:27.17,*Default,NTP,0000,0000,0000,,Сұрыптау мүмкін емес!
Dialogue: 0,0:11:27.37,0:11:30.46,*Default,NTP,0000,0000,0000,,Бұл жабдықталмаған жауынгерлік кеме. Бұл тас енот ит.
Dialogue: 0,0:11:30.77,0:11:34.90,*Default,NTP,0000,0000,0000,,Дегенмен, бар әскери күшпен жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:11:35.21,0:11:36.84,*Default,NTP,0000,0000,0000,,Сонымен не істейміз?
Dialogue: 0,0:11:37.08,0:11:40.91,*Default,NTP,0000,0000,0000,,Қарсылас ертең абсолютті қорғаныс шебінен өтуі мүмкін.
Dialogue: 0,0:11:51.89,0:11:52.88,*Default,NTP,0000,0000,0000,,Мен ұсынамын!
Dialogue: 0,0:11:55.23,0:11:56.16,*Default,NTP,0000,0000,0000,,Подполковник Ота...
Dialogue: 0,0:11:58.90,0:12:01.37,*Default,NTP,0000,0000,0000,,Ұшқышсыз Exelion жойылды.
Dialogue: 0,0:12:01.74,0:12:03.30,*Default,NTP,0000,0000,0000,,Қарсыластың ортасына қадам бас
Dialogue: 0,0:12:03.91,0:12:08.81,*Default,NTP,0000,0000,0000,,Корольдік клапанды шығарып алыңыз да, деградациялық қозғалтқышқа айналатын азғын реакторды жабайы етіп жіберіңіз.
Dialogue: 0,0:12:09.08,0:12:12.98,*Default,NTP,0000,0000,0000,,Бос әсерге байланысты азғындаған реактор 2 минут 40 секундтан кейін бақылаудан шығып қалды.
Dialogue: 0,0:12:13.52,0:12:18.04,*Default,NTP,0000,0000,0000,,Жасанды қара дырға айналады және найзағай ханзадасымен бірге жаудың Дайфэнін жұтады.
Dialogue: 0,0:12:20.39,0:12:23.19,*Default,NTP,0000,0000,0000,,Оны қорғау үшін бұзатын машинаны пайдаланыңыз.
Dialogue: 0,0:12:24.06,0:12:25.05,*Default,NTP,0000,0000,0000,,Ота-кун...
Dialogue: 0,0:12:26.30,0:12:28.09,*Default,NTP,0000,0000,0000,,Ақылға қонымсыз болма
Dialogue: 0,0:12:28.86,0:12:30.63,*Default,NTP,0000,0000,0000,,Жүздеген миллион жаулар бар!
Dialogue: 0,0:12:30.63,0:12:34.63,*Default,NTP,0000,0000,0000,,Аяқталған Gunbuster бір ғана бірлік, сізде тағы қандай стратегиялар бар?
Dialogue: 0,0:12:35.00,0:12:36.13,*Default,NTP,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:12:49.85,0:12:51.62,*Default,NTP,0000,0000,0000,,Кондуктор бөлмесінен хабарлама
Dialogue: 0,0:12:51.62,0:12:55.16,*Default,NTP,0000,0000,0000,,Жаңа ғана Шин-Окаяма станциясынан уақытында өтті.
Dialogue: 0,0:12:55.16,0:13:01.10,*Default,NTP,0000,0000,0000,,Келесі аялдамаға, Шин-Осакаға жету 9:31-ге жоспарланған.
Dialogue: 0,0:13:02.16,0:13:08.07,*Default,NTP,0000,0000,0000,,Окаяманың атақты тары тұшпаралары мен күзгі жапырақ манжу телефон карталары туралы не деуге болады?
Dialogue: 0,0:13:09.10,0:13:12.23,*Default,NTP,0000,0000,0000,,Әпке, кететін кез келді.
Dialogue: 0,0:13:22.62,0:13:25.78,*Default,NTP,0000,0000,0000,,Мм... сізде көп жүк жоқ.
Dialogue: 0,0:13:27.06,0:13:28.25,*Default,NTP,0000,0000,0000,,Сіз де
Dialogue: 0,0:13:29.06,0:13:31.96,*Default,NTP,0000,0000,0000,,Өйткені мен бұл жолы жақын арада қайтамын.
Dialogue: 0,0:13:35.16,0:13:38.40,*Default,NTP,0000,0000,0000,,Жақында емес, Жерде...
Dialogue: 0,0:13:38.97,0:13:40.09,*Default,NTP,0000,0000,0000,,Жарты жыл болды
Dialogue: 0,0:13:50.18,0:13:51.15,*Default,NTP,0000,0000,0000,,Әпке
Dialogue: 0,0:13:52.35,0:13:54.91,*Default,NTP,0000,0000,0000,,Мм... жаттықтырушының денесі туралы...
Dialogue: 0,0:13:57.69,0:13:58.81,*Default,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,0:14:00.09,0:14:04.03,*Default,NTP,0000,0000,0000,,Бірақ қазір бір адамнан да көп уайым бар.
Dialogue: 0,0:14:04.03,0:14:07.43,*Default,NTP,0000,0000,0000,,Миллиардтаған адамдардың өміріне алаңдайтын кез келді.
Dialogue: 0,0:14:08.03,0:14:09.83,*Default,NTP,0000,0000,0000,,Мен бас тарта алмаймын.
Dialogue: 0,0:14:10.20,0:14:12.17,*Default,NTP,0000,0000,0000,,Д-Дұрыс, сен дұрыс айтасың.
Dialogue: 0,0:14:12.17,0:14:14.97,*Default,NTP,0000,0000,0000,,Жақсы нәрсе А, сен үлкен апаға ұқсайсың.
Dialogue: 0,0:14:49.61,0:14:51.07,*Default,NTP,0000,0000,0000,,Иә? жаттықтырушы?
Dialogue: 0,0:14:52.27,0:14:53.24,*Default,NTP,0000,0000,0000,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:14:55.01,0:14:57.14,*Default,NTP,0000,0000,0000,,Әпке, жаттықтырушы осында.
Dialogue: 0,0:14:57.45,0:14:59.31,*Default,NTP,0000,0000,0000,,Жаттықтырушы, сіз жақсы жұмыс жасайсыз деп үміттенемін.
Dialogue: 0,0:14:59.72,0:15:03.59,*Default,NTP,0000,0000,0000,,Әй, апа, қайтып келгенде жаттықтырушыға үйленетін шығарсыз.
Dialogue: 0,0:15:03.59,0:15:06.55,*Default,NTP,0000,0000,0000,,Солай ма деп ойлаймын.
Dialogue: 0,0:15:08.12,0:15:10.02,*Default,NTP,0000,0000,0000,,Сіз қалай ойлайсыз? Жұлдыз емес пе?
Dialogue: 0,0:15:12.23,0:15:14.32,*Default,NTP,0000,0000,0000,,Екеуің тамаша жұпсыңдар.
Dialogue: 0,0:15:14.60,0:15:18.23,*Default,NTP,0000,0000,0000,,Бапкерлерге де оларға қамқорлық жасайтын адам керек, солай ма?
Dialogue: 0,0:15:20.07,0:15:22.09,*Default,NTP,0000,0000,0000,,Сіз түсінбейсіз.
Dialogue: 0,0:15:23.24,0:15:26.54,*Default,NTP,0000,0000,0000,,Жаттықтырушының денесі ғарыштық сәуле ауруымен ауырады.
Dialogue: 0,0:15:28.31,0:15:30.87,*Default,NTP,0000,0000,0000,,Бұл тағы алты айға созылмайды деп ойлаймын.
Dialogue: 0,0:15:35.58,0:15:38.09,*Default,NTP,0000,0000,0000,,Біз қайта кездесе алмауымыз мүмкін...
Dialogue: 0,0:15:38.09,0:15:40.11,*Default,NTP,0000,0000,0000,,Міне... жаттықтырушы
Dialogue: 0,0:15:40.52,0:15:42.42,*Default,NTP,0000,0000,0000,,Коши
Dialogue: 0,0:16:05.88,0:16:09.22,*Default,NTP,0000,0000,0000,,Біз қайта кездесе алмауымыз мүмкін.
Dialogue: 0,0:16:16.99,0:16:19.43,*Default,NTP,0000,0000,0000,,Эй, Норико, сенің әпкең сонда ма?
Dialogue: 0,0:16:20.00,0:16:23.00,*Default,NTP,0000,0000,0000,,Иә, анамның ең жақын досы
Dialogue: 0,0:16:23.00,0:16:25.63,*Default,NTP,0000,0000,0000,,Соған мініп, болашағыңды жаса.
Dialogue: 0,0:16:26.67,0:16:30.23,*Default,NTP,0000,0000,0000,,Мен өскенде Такамиге де айтамын.
Dialogue: 0,0:16:32.44,0:16:33.91,*Default,NTP,0000,0000,0000,,Иә? Анам жылап жатыр ма?
Dialogue: 0,0:16:35.18,0:16:36.24,*Default,NTP,0000,0000,0000,,Бұл ештеңе емес...
Dialogue: 0,0:16:37.51,0:16:38.88,*Default,NTP,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:17:09.21,0:17:11.20,*Default,NTP,0000,0000,0000,,үдеудің басталуына 15 минут қалғанда
Dialogue: 0,0:17:11.51,0:17:14.38,*Default,NTP,0000,0000,0000,,Әр машина өзінің жоспарланған орнына асығуы керек.
Dialogue: 0,0:17:17.59,0:17:18.95,*Default,NTP,0000,0000,0000,,Жер уақыты жоғарыда
Dialogue: 0,0:17:20.02,0:17:22.29,*Default,NTP,0000,0000,0000,,Әлі де басқалармен бір уақытта өмір сүреді
Dialogue: 0,0:17:23.46,0:17:26.92,*Default,NTP,0000,0000,0000,,Бұдан былай уақыт тек мен және менің әпкем ағыла бастайды.
Dialogue: 0,0:17:31.50,0:17:33.30,*Default,NTP,0000,0000,0000,,үдеуден 10 секунд бұрын
Dialogue: 0,0:17:34.00,0:17:38.04,*Default,NTP,0000,0000,0000,,8 7 6 5
Dialogue: 0,0:17:38.04,0:17:41.64,*Default,NTP,0000,0000,0000,,4 3 2 1
Dialogue: 0,0:17:54.99,0:17:57.65,*Default,NTP,0000,0000,0000,,216 астрономиялық бірлік орталыққа қалдырылды
Dialogue: 0,0:17:59.56,0:18:03.29,*Default,NTP,0000,0000,0000,,Қазірдің өзінде Жерде үшінші күн! Міне төртінші күн!
Dialogue: 0,0:18:23.32,0:18:24.22,*Default,NTP,0000,0000,0000,,Жау тобы тұтқынға алынды!
Dialogue: 0,0:18:24.99,0:18:26.96,*Default,NTP,0000,0000,0000,,Мен алдыңғы бөлікті осылай түртемін.
Dialogue: 0,0:18:27.36,0:18:28.65,*Default,NTP,0000,0000,0000,,Жау көлеңкесі Шамамен 250 миллион!
Dialogue: 0,0:18:28.96,0:18:31.29,*Default,NTP,0000,0000,0000,,Алдыңғы жағын бекітіңіз! Кеттік, Норико!
Dialogue: 0,0:18:31.36,0:18:32.09,*Default,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:18:51.98,0:18:53.95,*Default,NTP,0000,0000,0000,,3,8 миллиард километр қалды
Dialogue: 0,0:18:54.35,0:18:56.41,*Default,NTP,0000,0000,0000,,Норико! Орталыққа қарай жүріңіз!
Dialogue: 0,0:18:56.49,0:18:57.18,*Default,NTP,0000,0000,0000,,Сәлем!
Dialogue: 0,0:19:15.17,0:19:16.40,*Default,NTP,0000,0000,0000,,1 миллиард километр қалды!
Dialogue: 0,0:19:18.51,0:19:19.63,*Default,NTP,0000,0000,0000,,4 ай болды!
Dialogue: 0,0:19:26.35,0:19:29.48,*Default,NTP,0000,0000,0000,,Енді жоқ! Мен одан әрі барғым келмейді!
Dialogue: 0,0:19:32.69,0:19:33.92,*Default,NTP,0000,0000,0000,,Әпке!
Dialogue: 0,0:19:38.16,0:19:41.56,*Default,NTP,0000,0000,0000,,Мен қозғала алмаймын! Мен енді қозғала алмаймын!
Dialogue: 0,0:19:41.56,0:19:42.56,*Default,NTP,0000,0000,0000,,Әпке...
Dialogue: 0,0:19:42.56,0:19:47.02,*Default,NTP,0000,0000,0000,,Мен ол адам өлген жерге оралсам да, ол адам енді ол жерде болмайды.
Dialogue: 0,0:19:47.57,0:19:49.57,*Default,NTP,0000,0000,0000,,Мен әлі ештеңе айтқан жоқпын!
Dialogue: 0,0:19:49.57,0:19:53.34,*Default,NTP,0000,0000,0000,,Мен сені ұнатамын деп айтпадым, сүймедім, құшақтап та көрмедім.
Dialogue: 0,0:19:53.78,0:19:57.51,*Default,NTP,0000,0000,0000,,Не деген сұмдық...айта алмадым.
Dialogue: 0,0:20:07.69,0:20:10.49,*Default,NTP,0000,0000,0000,,Негізі сол кезде мені сүйгеніңді қаладым.
Dialogue: 0,0:20:11.59,0:20:13.19,*Default,NTP,0000,0000,0000,,Мен сені ұстағаныңды қаладым
Dialogue: 0,0:20:14.20,0:20:16.22,*Default,NTP,0000,0000,0000,,Мен сені жақсы көретініңді айтқың келді.
Dialogue: 0,0:20:18.10,0:20:19.00,*Default,NTP,0000,0000,0000,,Сонда да...
Dialogue: 0,0:20:20.37,0:20:21.50,*Default,NTP,0000,0000,0000,,Сонда да...
Dialogue: 0,0:20:22.27,0:20:27.17,*Default,NTP,0000,0000,0000,,Мен сені бұлай қайта көргім келмейді...
Dialogue: 0,0:20:30.28,0:20:32.55,*Default,NTP,0000,0000,0000,,Мықты болыңыз, апа!
Dialogue: 0,0:20:32.55,0:20:34.38,*Default,NTP,0000,0000,0000,,Осы қарқынмен мен жеңілемін!
Dialogue: 0,0:20:34.38,0:20:36.45,*Default,NTP,0000,0000,0000,,6 айда жаттықтырушы не болады?
Dialogue: 0,0:20:36.45,0:20:39.45,*Default,NTP,0000,0000,0000,,Негізі, жаттықтырушы болсаң да, әпкеңмен бірге болғың келеді!
Dialogue: 0,0:20:39.45,0:20:40.82,*Default,NTP,0000,0000,0000,,Соңғы алты ай!
Dialogue: 0,0:20:40.82,0:20:44.13,*Default,NTP,0000,0000,0000,,Негізі мен сені құшақтап, барма деп айтуым керек еді!
Dialogue: 0,0:20:44.13,0:20:46.13,*Default,NTP,0000,0000,0000,,Дәл сол кезде жаттықтырушы өзін тастап кетеді.
Dialogue: 0,0:20:46.13,0:20:50.06,*Default,NTP,0000,0000,0000,,Сіз бізге Gunbuster-ге жарты жыл бәс тіктіңіз!
Dialogue: 0,0:20:50.80,0:20:54.20,*Default,NTP,0000,0000,0000,,Бұл 6 ай! Әпке!
Dialogue: 0,0:20:56.41,0:20:58.57,*Default,NTP,0000,0000,0000,,Жоқ! Бұл жай ғана жаттықтырушылар емес!
Dialogue: 0,0:20:58.57,0:21:03.53,*Default,NTP,0000,0000,0000,,Кимико да, Юнги де өз болашағын екеумізге сеніп тапсырды!
Dialogue: 0,0:21:04.08,0:21:08.54,*Default,NTP,0000,0000,0000,,Жеңілсек, осы уақытқа дейін бәріміз не үшін өмір сүрдік?
Dialogue: 0,0:21:09.42,0:21:11.65,*Default,NTP,0000,0000,0000,,Біз!
Dialogue: 0,0:21:12.19,0:21:14.38,*Default,NTP,0000,0000,0000,,Біз жеңуіміз керек!
Dialogue: 0,0:21:15.56,0:21:17.65,*Default,NTP,0000,0000,0000,,Өтінемін! Казуми!
Dialogue: 0,0:21:18.23,0:21:20.16,*Default,NTP,0000,0000,0000,,Ұрыс!
Dialogue: 0,0:21:23.63,0:21:25.53,*Default,NTP,0000,0000,0000,,Түсіндім, Норико.
Dialogue: 0,0:21:26.47,0:21:27.57,*Default,NTP,0000,0000,0000,,Бірлейік!
Dialogue: 0,0:21:27.57,0:21:28.76,*Default,NTP,0000,0000,0000,,Әпке!
Dialogue: 0,0:21:43.55,0:21:45.02,*Default,NTP,0000,0000,0000,,Сіздің 6 айыңыз
Dialogue: 0,0:21:45.22,0:21:48.59,*Default,NTP,0000,0000,0000,,Мен сіз үшін келесі алты ай бойы күресемін.
Dialogue: 0,0:21:49.26,0:21:53.56,*Default,NTP,0000,0000,0000,,Бұл... сізбен бір уақытта өмір сүрудің жалғыз жолы.
Dialogue: 0,0:22:19.62,0:22:23.15,*Default,NTP,0000,0000,0000,,Мылтық ұрушы!
Dialogue: 0,0:22:26.83,0:22:29.40,*Default,NTP,0000,0000,0000,,Норико Экселион тірі және жақсы
Dialogue: 0,0:22:29.40,0:22:31.19,*Default,NTP,0000,0000,0000,,Ол біздің төменгі сол жақта.
Dialogue: 0,0:22:31.63,0:22:33.80,*Default,NTP,0000,0000,0000,,Әпке, мен оны қолданамын!
Dialogue: 0,0:22:33.80,0:22:35.43,*Default,NTP,0000,0000,0000,,Иә! Сау болыңыз
Dialogue: 0,0:22:42.48,0:22:46.08,*Default,NTP,0000,0000,0000,,Суиппацу Инагума!
Dialogue: 0,0:22:46.08,0:22:48.78,*Default,NTP,0000,0000,0000,,Киііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііііі iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii.
Dialogue: 0,0:22:55.29,0:22:59.39,*Default,NTP,0000,0000,0000,,Біріктірілген Gunbuster-ді жай машина деп ойламаңыз!
Dialogue: 0,0:23:01.86,0:23:04.57,*Default,NTP,0000,0000,0000,,Жаттықтырушының!
Dialogue: 0,0:23:04.57,0:23:08.66,*Default,NTP,0000,0000,0000,,Бапкердің жүрегі менің жүрегімде, солай аааа.
Dialogue: 0,0:23:14.44,0:23:17.07,*Default,NTP,0000,0000,0000,,Норико! Тікелей жау ұшақтарының үстінде! тік түсу
Dialogue: 0,0:23:20.72,0:23:22.74,*Default,NTP,0000,0000,0000,,Ол төменнен келеді! 3000-ға жуық!
Dialogue: 0,0:23:23.85,0:23:27.79,*Default,NTP,0000,0000,0000,,Үйге бару! Лазер нөмірі бірінші!
Dialogue: 0,0:23:36.77,0:23:39.27,*Default,NTP,0000,0000,0000,,Әр адамның болашағы! Біздің болашағымыз!
Dialogue: 0,0:23:39.27,0:23:41.17,*Default,NTP,0000,0000,0000,,Оны Gunbuster-пен жасайық!
Dialogue: 0,0:23:41.17,0:23:44.04,*Default,NTP,0000,0000,0000,,Дұрыс! Сондықтан маған кедергі жасамаңыз!
Dialogue: 0,0:23:44.04,0:23:46.56,*Default,NTP,0000,0000,0000,,«Бастер» ракетасы
Dialogue: 0,0:23:56.42,0:23:58.78,*Default,NTP,0000,0000,0000,,Норико, аулақ жүр! Мен Наоиге қосыламын!
Dialogue: 0,0:24:00.82,0:24:03.22,*Default,NTP,0000,0000,0000,,Қарсы шабуыл келе жатыр. Жауды өзіңізге қарай тартыңыз!
Dialogue: 0,0:24:03.63,0:24:06.15,*Default,NTP,0000,0000,0000,,мүмкіндігінше
Dialogue: 0,0:24:06.96,0:24:09.26,*Default,NTP,0000,0000,0000,,Тосқауыл келе жатыр! 20 мыңға жуық!
Dialogue: 0,0:24:09.73,0:24:12.26,*Default,NTP,0000,0000,0000,,Buster Shield!
Dialogue: 0,0:24:15.64,0:24:19.10,*Default,NTP,0000,0000,0000,,Мен осындай нәрседен жеңілеміз деп ойладым!
Dialogue: 0,0:24:25.75,0:24:28.55,*Default,NTP,0000,0000,0000,,20 миллион километр қалды, тек сол уақытқа дейін.
Dialogue: 0,0:24:30.09,0:24:31.11,*Default,NTP,0000,0000,0000,,Төменде!
Dialogue: 0,0:24:38.49,0:24:41.72,*Default,NTP,0000,0000,0000,,Мен мұндай нәрсе бар деп ешқашан ойламадым.
Dialogue: 0,0:24:42.00,0:24:43.56,*Default,NTP,0000,0000,0000,,Мен мұны ешқашан күткен емеспін.
Dialogue: 0,0:24:52.17,0:24:53.17,*Default,NTP,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:24:53.17,0:24:57.63,*Default,NTP,0000,0000,0000,,Бірақ жаттықтырушы жасаған Gunbaster-ді жеңіл қабылдамаңыз!
Dialogue: 0,0:24:58.11,0:25:00.74,*Default,NTP,0000,0000,0000,,Қос Бустааа Коредаааа!
Dialogue: 0,0:25:17.77,0:25:20.29,*Default,NTP,0000,0000,0000,,Exelion орталығына жетіңіз
Dialogue: 0,0:25:20.67,0:25:22.40,*Default,NTP,0000,0000,0000,,Гравитациялық радиустан асып түседі
Dialogue: 0,0:25:23.34,0:25:24.20,*Default,NTP,0000,0000,0000,,Бұл басталғалы жатыр...
Dialogue: 0,0:25:26.71,0:25:29.34,*Default,NTP,0000,0000,0000,,Қош бол... Exelion
Dialogue: 0,0:25:56.87,0:25:57.97,*Default,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:25:57.97,0:25:59.04,*Default,NTP,0000,0000,0000,,Бүгін 22:45.
Dialogue: 0,0:25:59.04,0:26:00.17,*Default,NTP,0000,0000,0000,,Бүгін 22:45.
Dialogue: 0,0:26:00.31,0:26:03.21,*Default,NTP,0000,0000,0000,,Палома обсерваториясында байқалған G-типті рентген
Dialogue: 0,0:26:03.58,0:26:07.52,*Default,NTP,0000,0000,0000,,Қазіргі уақытта жаудың 99,89% жойылды.
Dialogue: 0,0:26:07.52,0:26:10.97,*Default,NTP,0000,0000,0000,,Соққы толқыны алты айдан кейін келеді.
Dialogue: 0,0:26:13.19,0:26:15.49,*Default,NTP,0000,0000,0000,,Бұл жолы сізді құтқарды ма?
Dialogue: 0,0:26:56.66,0:26:58.06,*Default,NTP,0000,0000,0000,,Жаттықтырушы…
Dialogue: 0,0:26:59.03,0:27:00.36,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:27:06.78,0:27:09.40,*Default,NTP,0000,0000,0000,,Мен сені сүйемін, Коичиро-сан.
Dialogue: 0,0:27:31.47,0:27:32.40,*Default,NTP,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:27:32.40,0:27:36.36,*Default,NTP,0000,0000,0000,,Кешіріңіз, Смит... Сіз енді жыламауға уәде бердіңіз.
Dialogue: 0,0:27:36.74,0:27:42.27,*Default,NTP,0000,0000,0000,,Бірақ Кимико сені мақтайды, солай ма? Папа...
Dialogue: 0,0:27:43.77,0:27:49.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
