Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.27,0:00:06.56,*Default,NTP,0000,0000,0000,,менің әкем
Dialogue: 0,0:00:06.80,0:00:10.24,*Default,NTP,0000,0000,0000,,Норико Такаян, 3/4 сынып 2 сынып
Dialogue: 0,0:00:10.64,0:00:15.44,*Default,NTP,0000,0000,0000,,Менің әкем өте керемет адам деп ойлаймын.
Dialogue: 0,0:00:15.44,0:00:19.47,*Default,NTP,0000,0000,0000,,Ғарышта Жерді қорғау жұмысы
Dialogue: 0,0:00:19.85,0:00:24.79,*Default,NTP,0000,0000,0000,,Менің әкем мінген ғарыш кемесі – әлемдегі ең жылдам.
Dialogue: 0,0:00:24.79,0:00:28.02,*Default,NTP,0000,0000,0000,,Маған әрқашан мақтан
Dialogue: 0,0:00:28.02,0:00:33.09,*Default,NTP,0000,0000,0000,,Менің әкем «Люксион» ғарыш кемесінің капитаны.
Dialogue: 0,0:00:33.09,0:00:37.13,*Default,NTP,0000,0000,0000,,Мен де өскенде ғарышкер боламын.
Dialogue: 0,0:00:37.13,0:00:40.57,*Default,NTP,0000,0000,0000,,Мен әкеммен бірге ғарышқа ұшқым келеді.
Dialogue: 0,0:00:45.81,0:00:50.94,*Default,NTP,0000,0000,0000,,20 желтоқсан 2015 жыл Бұлтты, кейін жаңбыр жауады
Dialogue: 0,0:00:51.45,0:00:53.78,*Default,NTP,0000,0000,0000,,Әкесі қайтыс болды
Dialogue: 0,0:00:53.88,0:00:55.48,*Default,NTP,0000,0000,0000,,Нақтырақ айтсақ
Dialogue: 0,0:00:55.48,0:00:58.65,*Default,NTP,0000,0000,0000,,19 желтоқсанда қайтыс болды
Dialogue: 0,0:00:58.65,0:01:05.26,*Default,NTP,0000,0000,0000,,Менің әкем мінген ғарыш кемесіне алыс ғарышта ғарыштық құбыжық шабуыл жасады.
Dialogue: 0,0:01:05.76,0:01:11.30,*Default,NTP,0000,0000,0000,,Әкем қайтыс болса да, мен оны шынымен сезбедім.
Dialogue: 0,0:01:11.30,0:01:15.57,*Default,NTP,0000,0000,0000,,Мен өзімді ғаламның бір жерінде әлі тірі жүргендей сезінемін.
Dialogue: 0,0:01:16.00,0:01:20.27,*Default,NTP,0000,0000,0000,,Мен де әкем болған ғаламға барамын.
Dialogue: 0,0:01:20.68,0:01:24.58,*Default,NTP,0000,0000,0000,,Мен де ғарыш ұшқышы боламын.
Dialogue: 0,0:01:45.57,0:01:51.47,*Default,NTP,0000,0000,0000,,Артыңыздан төбеге жүгіру
Dialogue: 0,0:01:51.51,0:01:57.38,*Default,NTP,0000,0000,0000,,Ыстық күн сәулесін басып озу
Dialogue: 0,0:01:57.38,0:02:03.11,*Default,NTP,0000,0000,0000,,Арқамды қуып жеткенде үлкен секіреді.
Dialogue: 0,0:02:03.32,0:02:09.32,*Default,NTP,0000,0000,0000,,Мен сенің демалуыңды сеземін.
Dialogue: 0,0:02:09.32,0:02:14.96,*Default,NTP,0000,0000,0000,,Жел соққан сайын көңілді сезінеді
Dialogue: 0,0:02:14.96,0:02:19.43,*Default,NTP,0000,0000,0000,,Жүрегім асқақ үмітпен
Dialogue: 0,0:02:19.43,0:02:21.30,*Default,NTP,0000,0000,0000,,ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ ЖОҒАРЫ!
Dialogue: 0,0:02:22.30,0:02:28.04,*Default,NTP,0000,0000,0000,,Оранып қалғым келеді, алаңсыз.
Dialogue: 0,0:02:28.28,0:02:34.35,*Default,NTP,0000,0000,0000,,Біз бірге қалғанда қашықтық нөлге айналады
Dialogue: 0,0:02:34.35,0:02:37.98,*Default,NTP,0000,0000,0000,,МЕН СЕНІ ЖАҚСЫ КӨРЕМІН
Dialogue: 0,0:03:26.94,0:03:29.77,*Default,NTP,0000,0000,0000,,Бұл не, Кимико?
Dialogue: 0,0:03:29.77,0:03:32.44,*Default,NTP,0000,0000,0000,,Неге сен мұңая қарап тұрсың?
Dialogue: 0,0:03:32.44,0:03:34.57,*Default,NTP,0000,0000,0000,,Әй, әпке.
Dialogue: 0,0:03:35.01,0:03:37.31,*Default,NTP,0000,0000,0000,,Иә, менің арманым
Dialogue: 0,0:03:37.68,0:03:39.81,*Default,NTP,0000,0000,0000,,Мен де сондай болсам ғой
Dialogue: 0,0:03:42.52,0:03:45.92,*Default,NTP,0000,0000,0000,,Бір болу мүмкін емес, сізде талант жоқ.
Dialogue: 0,0:03:45.92,0:03:50.26,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Сіз әлі бір ай бойы аппараттасыз.
Dialogue: 0,0:03:50.26,0:03:53.23,*Default,NTP,0000,0000,0000,,Сіз бастаушысыз, сондықтан қазірден бастап жақсы боласыз.
Dialogue: 0,0:03:53.60,0:03:55.50,*Default,NTP,0000,0000,0000,,Осы аптада Бикеш кім?
Dialogue: 0,0:03:55.50,0:03:58.47,*Default,NTP,0000,0000,0000,,Алты күн сәтті болды, қарапайым кездесу күтіп тұр.
Dialogue: 0,0:03:58.57,0:03:59.53,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:03:59.80,0:04:02.80,*Default,NTP,0000,0000,0000,,Ымырт қанша уақыт болады?
Dialogue: 0,0:04:02.80,0:04:06.41,*Default,NTP,0000,0000,0000,,5-6-кезеңдердегі машиналық жаттығуларды бүкіл мектеп бірлесіп өткізеді деп естідім.
Dialogue: 0,0:04:06.41,0:04:08.81,*Default,NTP,0000,0000,0000,,Жаңа жаттықтырушы да келеді.
Dialogue: 0,0:04:08.81,0:04:10.75,*Default,NTP,0000,0000,0000,,Киіміңізді тез ауыстырып, жаттығу жасаңыз.
Dialogue: 0,0:04:10.75,0:04:12.21,*Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:04:16.15,0:04:22.09,*Default,NTP,0000,0000,0000,,188 189 190 191 192 193
Dialogue: 0,0:04:22.09,0:04:23.83,*Default,NTP,0000,0000,0000,,194 195…
Dialogue: 0,0:04:23.83,0:04:26.16,*Default,NTP,0000,0000,0000,,196 197
Dialogue: 0,0:04:26.16,0:04:30.06,*Default,NTP,0000,0000,0000,,198 199 200!
Dialogue: 0,0:04:30.80,0:04:33.37,*Default,NTP,0000,0000,0000,,Сіз шынайы өмірде мінсізсіз.
Dialogue: 0,0:04:33.37,0:04:36.80,*Default,NTP,0000,0000,0000,,Сіз мұны қалай жасай алдыңыз? Машина мүлдем жарамсыз.
Dialogue: 0,0:04:37.37,0:04:39.37,*Default,NTP,0000,0000,0000,,Мен механы ұнатпаймын.
Dialogue: 0,0:04:39.37,0:04:42.38,*Default,NTP,0000,0000,0000,,Ендеше екі нәрсені бір уақытта орындауға болмайды.
Dialogue: 0,0:04:42.38,0:04:46.35,*Default,NTP,0000,0000,0000,,Мониторға қарап отырып, қолдар мен аяқтарды жылжыту - бұл ...
Dialogue: 0,0:04:46.35,0:04:48.14,*Default,NTP,0000,0000,0000,,А, сіз оны төлей аласыз.
Dialogue: 0,0:04:50.35,0:04:53.12,*Default,NTP,0000,0000,0000,,Секіргіш арқанмен жаттығу
Dialogue: 0,0:04:53.12,0:04:54.52,*Default,NTP,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:04:54.52,0:04:56.15,*Default,NTP,0000,0000,0000,,Себебі мен оған үйреніп қалдым
Dialogue: 0,0:04:56.46,0:04:58.13,*Default,NTP,0000,0000,0000,,Сіз бізбен мақтанасыз ба?
Dialogue: 0,0:04:58.13,0:05:00.80,*Default,NTP,0000,0000,0000,,Адмиралдың қызынан күткендей, мен қызғанамын.
Dialogue: 0,0:05:00.80,0:05:02.46,*Default,NTP,0000,0000,0000,,Байланыстарға байланысты қайтадан қабылдауды жоспарлайсыз ба?
Dialogue: 0,0:05:02.46,0:05:04.77,*Default,NTP,0000,0000,0000,,Кешіріңіз! Бұл сіздің шеберлігіңіз!
Dialogue: 0,0:05:04.77,0:05:06.26,*Default,NTP,0000,0000,0000,,О, солай деп ойлаймын.
Dialogue: 0,0:05:08.84,0:05:10.67,*Default,NTP,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:05:10.67,0:05:12.40,*Default,NTP,0000,0000,0000,,Әпке!
Dialogue: 0,0:05:14.08,0:05:16.48,*Default,NTP,0000,0000,0000,,Егер сіз де ұшқыш болғыңыз келсе
Dialogue: 0,0:05:16.48,0:05:19.08,*Default,NTP,0000,0000,0000,,Өзіңізге пууидо жасаңыз!
Dialogue: 0,0:05:19.08,0:05:21.28,*Default,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:35.66,0:05:37.80,*Default,NTP,0000,0000,0000,,Норико Такая?
Dialogue: 0,0:05:39.47,0:05:41.46,*Default,NTP,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:05:42.14,0:05:46.23,*Default,NTP,0000,0000,0000,,Иә, сіз адмирал Такаяның қызы едіңіз.
Dialogue: 0,0:05:46.67,0:05:50.74,*Default,NTP,0000,0000,0000,,Кешіріңіз, көп қиналсаңыз керек.
Dialogue: 0,0:05:51.45,0:05:54.42,*Default,NTP,0000,0000,0000,,Жоқ, мен үйреніп қалдым.
Dialogue: 0,0:05:56.28,0:06:00.12,*Default,NTP,0000,0000,0000,,Машинаның 6 балансирмен жұмыс істеуі
Dialogue: 0,0:06:00.12,0:06:03.52,*Default,NTP,0000,0000,0000,,Екі мүшеңіздің кері байланысына назар аударсаңыз, бәрі жақсы болады.
Dialogue: 0,0:06:04.63,0:06:06.53,*Default,NTP,0000,0000,0000,,Өте көп
Dialogue: 0,0:06:06.76,0:06:10.72,*Default,NTP,0000,0000,0000,,Эй, сен мониторды қалай басқарасың?
Dialogue: 0,0:06:11.60,0:06:15.40,*Default,NTP,0000,0000,0000,,Ал... Бір қарап алайын, ойланып көрейін.
Dialogue: 0,0:06:15.40,0:06:21.41,*Default,NTP,0000,0000,0000,,Бірақ келесі сәтте демалу қажет нәрсені жасайды.
Dialogue: 0,0:06:21.41,0:06:24.48,*Default,NTP,0000,0000,0000,,Керемет! Бұл гений
Dialogue: 0,0:06:24.48,0:06:28.82,*Default,NTP,0000,0000,0000,,Керемет, Такая-сан, сен бұған күш саласың.
Dialogue: 0,0:06:28.82,0:06:33.22,*Default,NTP,0000,0000,0000,,Не? Бұл талпыныс па? Джо, сен күш-жігердің генийісің.
Dialogue: 0,0:06:35.32,0:06:38.55,*Default,NTP,0000,0000,0000,,Мен де бірінші күні станокқа құладым.
Dialogue: 0,0:06:38.83,0:06:42.28,*Default,NTP,0000,0000,0000,,Бірақ келесі күні мен құлап қалмауға жаттықтым.
Dialogue: 0,0:06:42.43,0:06:45.27,*Default,NTP,0000,0000,0000,,Сіз де біраз күш жұмсай аласыз.
Dialogue: 0,0:06:45.27,0:06:49.70,*Default,NTP,0000,0000,0000,,Эйчи! Эх! Ее! Міне бітті!
Dialogue: 0,0:06:51.67,0:06:55.07,*Default,NTP,0000,0000,0000,,Әй, шашың аздап кедергі жасап тұрған сияқты.
Dialogue: 0,0:07:00.85,0:07:02.54,*Default,NTP,0000,0000,0000,,Мен мұны көтеремін.
Dialogue: 0,0:07:02.55,0:07:06.08,*Default,NTP,0000,0000,0000,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:07:06.45,0:07:09.58,*Default,NTP,0000,0000,0000,,Сәттілік, Такая-сан.
Dialogue: 0,0:07:11.23,0:07:12.35,*Default,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:07:20.64,0:07:22.74,*Default,NTP,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:07:22.74,0:07:26.10,*Default,NTP,0000,0000,0000,,Кимико! Осы аптада Бикеш кім?
Dialogue: 0,0:07:26.37,0:07:29.47,*Default,NTP,0000,0000,0000,,Алты күн сәтті, тамаша кездесулер күтіп тұр.
Dialogue: 0,0:07:29.64,0:07:34.10,*Default,NTP,0000,0000,0000,,Шынымен! Бүгін менің өмірімдегі ең жақсы күн
Dialogue: 0,0:07:43.32,0:07:45.19,*Default,NTP,0000,0000,0000,,Алға ұмтыл!
Dialogue: 0,0:07:46.66,0:07:47.79,*Default,NTP,0000,0000,0000,,Түзет!
Dialogue: 0,0:07:50.60,0:07:53.67,*Default,NTP,0000,0000,0000,,Сол Люксион трагедиясынан бері алты жыл өтті.
Dialogue: 0,0:07:53.67,0:08:00.67,*Default,NTP,0000,0000,0000,,Бүкіл әлемді жаудың ғарыштық құбыжығына қарсы көтеру үшін «RX» жобасын бастағанымызға бес жыл болды.
Dialogue: 0,0:08:03.21,0:08:07.24,*Default,NTP,0000,0000,0000,,Әй, эй, көрші жігіттердің командасындағы екі жігіт кеше шешілген сияқты.
Dialogue: 0,0:08:07.78,0:08:10.22,*Default,NTP,0000,0000,0000,,Сенің мұнда да әпке болатыныңа сенімдімін.
Dialogue: 0,0:08:10.22,0:08:13.05,*Default,NTP,0000,0000,0000,,Ал, сұрақ басқа адам туралы.
Dialogue: 0,0:08:13.05,0:08:16.99,*Default,NTP,0000,0000,0000,,Барлық мектептерден таңдау бар сияқты, сондықтан бізде де мүмкіндік бар.
Dialogue: 0,0:08:17.43,0:08:22.03,*Default,NTP,0000,0000,0000,,Сүйікті әпкеммен ғарышқа ұшатын болсам, өлуге қарсы емеспін.
Dialogue: 0,0:08:22.03,0:08:25.13,*Default,NTP,0000,0000,0000,,Парка Шешу мүмкін емес.
Dialogue: 0,0:08:25.13,0:08:27.57,*Default,NTP,0000,0000,0000,,Мен үшінші курс студенті Кашихара мырза туралы шешім қабылдадым.
Dialogue: 0,0:08:27.57,0:08:30.40,*Default,NTP,0000,0000,0000,,Келесі жаттықтырушы подполковник.
Dialogue: 0,0:08:30.40,0:08:33.70,*Default,NTP,0000,0000,0000,,Мен сізді осы жоспар бойынша жұмыс істеуге келгеніңізді естідім.
Dialogue: 0,0:08:35.24,0:08:36.77,*Default,NTP,0000,0000,0000,,Тынш! Жаттықтырушы!
Dialogue: 0,0:08:38.08,0:08:43.71,*Default,NTP,0000,0000,0000,,Мен бүгіннен бастап сізге машиналар мен қаруларды пайдалануды үйрететін отакумын!
Dialogue: 0,0:08:44.12,0:08:47.02,*Default,NTP,0000,0000,0000,,Көтере алмағандар аяусыз құлатылады!
Dialogue: 0,0:08:48.39,0:08:51.59,*Default,NTP,0000,0000,0000,,Алдымен, барлығының авто балансизаторын өшіріңіз!
Dialogue: 0,0:08:52.63,0:08:55.43,*Default,NTP,0000,0000,0000,,Бұдан былай оны қайта пайдалануға рұқсат етілмейді!
Dialogue: 0,0:09:01.77,0:09:03.77,*Default,NTP,0000,0000,0000,,Нақты шайқас негізінен қолмен жүргізіледі!
Dialogue: 0,0:09:03.77,0:09:07.28,*Default,NTP,0000,0000,0000,,Егер сіз өзіңізді қорғай алмасаңыз, басынан бастаңыз!
Dialogue: 0,0:09:07.28,0:09:09.68,*Default,NTP,0000,0000,0000,,Дәл солай, барлығы 50 айналымнан өтеді!
Dialogue: 0,0:09:11.38,0:09:13.24,*Default,NTP,0000,0000,0000,,Шығар!
Dialogue: 0,0:09:14.75,0:09:18.71,*Default,NTP,0000,0000,0000,,Айқайлаңыз! Ұрыс! күрес
Dialogue: 0,0:09:24.26,0:09:28.03,*Default,NTP,0000,0000,0000,,Иә? иә? Ал, жүгір, жүгір...
Dialogue: 0,0:09:28.03,0:09:29.50,*Default,NTP,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:09:43.58,0:09:45.11,*Default,NTP,0000,0000,0000,,Бір жыл!
Dialogue: 0,0:09:45.11,0:09:49.17,*Default,NTP,0000,0000,0000,,Машинадан түсіңіз! Өз бетіңізше 50 айналым жасаңыз!
Dialogue: 0,0:09:57.56,0:09:59.79,*Default,NTP,0000,0000,0000,,Мектептен кететін уақыт келді.
Dialogue: 0,0:10:00.06,0:10:03.22,*Default,NTP,0000,0000,0000,,Студенттер кампуста әлі де бар
Dialogue: 0,0:10:03.30,0:10:05.77,*Default,NTP,0000,0000,0000,,Мектепті дереу тастаңыз.
Dialogue: 0,0:10:06.77,0:10:08.34,*Default,NTP,0000,0000,0000,,Сәлем Норико
Dialogue: 0,0:10:08.34,0:10:11.17,*Default,NTP,0000,0000,0000,,Норико, үйге тез қайт.
Dialogue: 0,0:10:11.17,0:10:14.27,*Default,NTP,0000,0000,0000,,Жоқ, мұндай жерде ұйықтауға болмайды.
Dialogue: 0,0:10:15.81,0:10:19.04,*Default,NTP,0000,0000,0000,,Мен енді қозғала алмаймын
Dialogue: 0,0:10:20.31,0:10:24.44,*Default,NTP,0000,0000,0000,,Қаласам 50 рет жасаймын.
Dialogue: 0,0:10:24.82,0:10:29.12,*Default,NTP,0000,0000,0000,,Эй, эй, тез киіміңді ауыстыр да, үйге қайт.
Dialogue: 0,0:10:44.34,0:10:45.46,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:47.61,0:10:50.41,*Default,NTP,0000,0000,0000,,Е! Мен!?
Dialogue: 0,0:10:51.18,0:10:54.64,*Default,NTP,0000,0000,0000,,Маған қарашы, өтірік айтамын~ Мен сенбеймін.
Dialogue: 0,0:11:00.79,0:11:02.39,*Default,NTP,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:11:02.39,0:11:04.13,*Default,NTP,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:11:04.13,0:11:06.06,*Default,NTP,0000,0000,0000,,Мына қызды қарашы.
Dialogue: 0,0:11:06.06,0:11:09.46,*Default,NTP,0000,0000,0000,,Менің әкем жойылған флоттың адмиралы болса керек.
Dialogue: 0,0:11:09.46,0:11:11.40,*Default,NTP,0000,0000,0000,,Сонымен, қосылымдар арқылы ұшқыш болғың келе ме?
Dialogue: 0,0:11:11.50,0:11:15.99,*Default,NTP,0000,0000,0000,,Білесің бе ғажап, Кеше көрдің.
Dialogue: 0,0:11:16.14,0:11:18.57,*Default,NTP,0000,0000,0000,,Сондай-ақ жаттықтырушыға қамқорлық жасау керек. Жоқ.
Dialogue: 0,0:11:18.57,0:11:20.14,*Default,NTP,0000,0000,0000,,Мен олардың бұған қалай кіргеніне таң қаламын.
Dialogue: 0,0:11:20.14,0:11:24.04,*Default,NTP,0000,0000,0000,,Жойылған қыз болса да, апасына жақындау үшін соншалықты алысқа барғысы келе ме деп ойлаймын.
Dialogue: 0,0:11:25.35,0:11:30.58,*Default,NTP,0000,0000,0000,,Жойылған қыз менің жарым, Ағамды аяймын~
Dialogue: 0,0:11:33.75,0:11:35.12,*Default,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:11:40.43,0:11:43.10,*Default,NTP,0000,0000,0000,,Бапкер не ойлап отыр екен...
Dialogue: 0,0:11:43.10,0:11:46.79,*Default,NTP,0000,0000,0000,,Мен жаттықтырушы не ойлап тұрғанын білмеймін!
Dialogue: 0,0:11:47.07,0:11:51.10,*Default,NTP,0000,0000,0000,,Ол баланың автомат мінгеніне - айлар ғана болды.
Dialogue: 0,0:11:51.51,0:11:56.24,*Default,NTP,0000,0000,0000,,Менің ойымша, үшінші курс студенті Кашихара мырза ғарышқа ұшуға ең лайықты адам.
Dialogue: 0,0:11:58.68,0:12:02.71,*Default,NTP,0000,0000,0000,,Ол адмирал Такаяның жалғыз қызы сияқты.
Dialogue: 0,0:12:07.29,0:12:12.09,*Default,NTP,0000,0000,0000,,Мен «Адмиралдың Люксион» ғарыш кемесінен аман қалдым.
Dialogue: 0,0:12:15.03,0:12:17.80,*Default,NTP,0000,0000,0000,,Ендеше ол ұшқыш болсын... Идиот!
Dialogue: 0,0:12:17.80,0:12:22.80,*Default,NTP,0000,0000,0000,,Қараңызшы, бұл жоспар сіз ойлағаннан да маңыздырақ.
Dialogue: 0,0:12:22.80,0:12:25.24,*Default,NTP,0000,0000,0000,,Бұл адамзаттың аман қалу мәселесі.
Dialogue: 0,0:12:25.24,0:12:26.54,*Default,NTP,0000,0000,0000,,Сонда неге...
Dialogue: 0,0:12:27.74,0:12:29.77,*Default,NTP,0000,0000,0000,,Мен жауаптымын
Dialogue: 0,0:12:30.48,0:12:32.75,*Default,NTP,0000,0000,0000,,Ол мұны істей алатын шығар...
Dialogue: 0,0:12:32.75,0:12:34.82,*Default,NTP,0000,0000,0000,,Жерде не бар?
Dialogue: 0,0:12:34.82,0:12:38.22,*Default,NTP,0000,0000,0000,,Пастер машинасы... Ғарышта болған соң түсінесіз.
Dialogue: 0,0:12:39.42,0:12:44.19,*Default,NTP,0000,0000,0000,,Жаттықтырушы папаның кемесінен аман қалған...
Dialogue: 0,0:12:52.20,0:12:54.93,*Default,NTP,0000,0000,0000,,Сонымен, сен не істейсің, Норико?
Dialogue: 0,0:12:55.64,0:12:58.47,*Default,NTP,0000,0000,0000,,Әпкем мені мүлдем жек көреді.
Dialogue: 0,0:12:58.47,0:13:03.91,*Default,NTP,0000,0000,0000,,Әкемнің байланысымен мен ұшқыш болдым және мектепте барлығына жау болдым.
Dialogue: 0,0:13:05.31,0:13:08.65,*Default,NTP,0000,0000,0000,,Не істеуім керек... бұл ең нашар...
Dialogue: 0,0:13:08.65,0:13:14.02,*Default,NTP,0000,0000,0000,,Осы аптада Бикеште басқалармен түсініспеушілік пен қиыншылықтардан сақ болыңыз!
Dialogue: 0,0:13:15.46,0:13:17.46,*Default,NTP,0000,0000,0000,,Жақсы, ол бәрібір тағайындалды.
Dialogue: 0,0:13:17.46,0:13:21.09,*Default,NTP,0000,0000,0000,,Қозғалыс үшін жаттығу жасаған дұрыс емес пе?
Dialogue: 0,0:13:27.10,0:13:28.34,*Default,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:13:43.92,0:13:46.94,*Default,NTP,0000,0000,0000,,Бар күшіңізді салмаңыз, иә...
Dialogue: 0,0:13:50.66,0:13:52.13,*Default,NTP,0000,0000,0000,,Иаа!
Dialogue: 0,0:13:53.53,0:13:55.05,*Default,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:56.90,0:13:58.19,*Default,NTP,0000,0000,0000,,Маған бұл енді ұнамайды
Dialogue: 0,0:13:59.47,0:14:02.37,*Default,NTP,0000,0000,0000,,Маған енді ұнамайды~
Dialogue: 0,0:14:07.14,0:14:08.01,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:14:09.11,0:14:13.41,*Default,NTP,0000,0000,0000,,Өтінемін, мені қорлауды доғарыңыз!
Dialogue: 0,0:14:13.95,0:14:16.18,*Default,NTP,0000,0000,0000,,Мен сені тағайындадым ба?
Dialogue: 0,0:14:16.55,0:14:18.62,*Default,NTP,0000,0000,0000,,Неліктен бұл қорлау деп ойлайсыз?
Dialogue: 0,0:14:18.62,0:14:21.29,*Default,NTP,0000,0000,0000,,Өйткені менде талант жоқ.
Dialogue: 0,0:14:21.29,0:14:24.23,*Default,NTP,0000,0000,0000,,Мүлдем жоқ! Үміт жоқ
Dialogue: 0,0:14:24.23,0:14:26.93,*Default,NTP,0000,0000,0000,,Әркім қамқорлық жасап жатқанын айтады.
Dialogue: 0,0:14:26.93,0:14:30.59,*Default,NTP,0000,0000,0000,,Ал сен Амано-сенпайдың серігісің.
Dialogue: 0,0:14:31.17,0:14:34.57,*Default,NTP,0000,0000,0000,,Сұмдық, қатыгездік.
Dialogue: 0,0:14:35.34,0:14:37.40,*Default,NTP,0000,0000,0000,,Айтқыңыз келгені осы ғана ма?
Dialogue: 0,0:14:42.91,0:14:46.21,*Default,NTP,0000,0000,0000,,Ұшқыш болу үшін не қажет емес
Dialogue: 0,0:14:46.58,0:14:49.05,*Default,NTP,0000,0000,0000,,Аманода бар.
Dialogue: 0,0:14:49.48,0:14:51.11,*Default,NTP,0000,0000,0000,,Менің артымнан жүр!
Dialogue: 0,0:15:00.56,0:15:01.55,*Default,NTP,0000,0000,0000,,Мынаны қараңыз!
Dialogue: 0,0:15:02.56,0:15:05.26,*Default,NTP,0000,0000,0000,,Бұл сізде жоқ!
Dialogue: 0,0:15:08.87,0:15:11.39,*Default,NTP,0000,0000,0000,,Менің әпкем темір гета киеді!
Dialogue: 0,0:15:11.87,0:15:13.90,*Default,NTP,0000,0000,0000,,Аманоның таланты бар!
Dialogue: 0,0:15:14.94,0:15:17.95,*Default,NTP,0000,0000,0000,,Бірақ одан да артық, оның талантын айқындайтын нәрсе
Dialogue: 0,0:15:17.95,0:15:20.00,*Default,NTP,0000,0000,0000,,Өзінің күш-жігері!
Dialogue: 0,0:15:20.45,0:15:24.12,*Default,NTP,0000,0000,0000,,Иә, мен мұны істеуге бар күшімді саламын.
Dialogue: 0,0:15:24.12,0:15:26.59,*Default,NTP,0000,0000,0000,,Расында да, сізде талант жоқ!
Dialogue: 0,0:15:27.22,0:15:29.96,*Default,NTP,0000,0000,0000,,Өйткені күш толығымен жойылды.
Dialogue: 0,0:15:29.96,0:15:33.92,*Default,NTP,0000,0000,0000,,Бірақ сенде талант бар, сондықтан мен сені таңдадым.
Dialogue: 0,0:15:35.16,0:15:38.90,*Default,NTP,0000,0000,0000,,Такая! Талпыныс жасаңыз, талантыңызды шыңдаңыз және басқаларға сенбеңіз!
Dialogue: 0,0:15:38.90,0:15:42.64,*Default,NTP,0000,0000,0000,,Тыңда, бүкіл денеңмен сезін, баспен ойла, жүрегіңмен бағала!
Dialogue: 0,0:15:42.64,0:15:44.93,*Default,NTP,0000,0000,0000,,Әлемде сенуге болатын жалғыз адам ол өзіңсің!
Dialogue: 0,0:15:47.24,0:15:48.14,*Default,NTP,0000,0000,0000,,Жаттықтырушы…
Dialogue: 0,0:15:48.14,0:15:51.58,*Default,NTP,0000,0000,0000,,Аманомен бірге ғарышқа ұшыңыз!
Dialogue: 0,0:15:51.58,0:15:55.14,*Default,NTP,0000,0000,0000,,Сізде бір нәрсе істеу керек.
Dialogue: 0,0:17:16.86,0:17:20.80,*Default,NTP,0000,0000,0000,,Мен ол бірден бас тартады деп ойладым, бірақ ол таң қаларлықтай тырысып жатыр.
Dialogue: 0,0:17:21.10,0:17:22.33,*Default,NTP,0000,0000,0000,,Мұны істеу мүмкін емес.
Dialogue: 0,0:17:24.10,0:17:26.40,*Default,NTP,0000,0000,0000,,Негіздер жақсарды.
Dialogue: 0,0:17:27.37,0:17:31.28,*Default,NTP,0000,0000,0000,,Дұрыс, жанымда үнемі жаттықтырушы болады.
Dialogue: 0,0:17:31.28,0:17:33.91,*Default,NTP,0000,0000,0000,,Жақсырақ болатының табиғи нәрсе.
Dialogue: 0,0:17:55.07,0:17:59.17,*Default,NTP,0000,0000,0000,,Жаттықтырушы! Мен Такая-саннан төменмін деп не айтасың?
Dialogue: 0,0:17:59.17,0:18:01.04,*Default,NTP,0000,0000,0000,,Айтыңызшы, жаттықтырушы!
Dialogue: 0,0:18:02.34,0:18:03.87,*Default,NTP,0000,0000,0000,,Т… Мені ешкім қудалап жүрген жоқ еді.
Dialogue: 0,0:18:04.91,0:18:06.04,*Default,NTP,0000,0000,0000,,Жаттықтырушы!
Dialogue: 0,0:18:06.41,0:18:08.14,*Default,NTP,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:18:09.32,0:18:13.34,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:20.43,0:18:22.95,*Default,NTP,0000,0000,0000,,Сізді екінші лейтенант лауазымына тағайындалуыңызбен құттықтаймыз, Такая-сан
Dialogue: 0,0:18:25.37,0:18:27.37,*Default,NTP,0000,0000,0000,,Біз ертең жолға шығамыз.
Dialogue: 0,0:18:27.37,0:18:31.44,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:31.44,0:18:33.00,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:18:35.28,0:18:38.18,*Default,NTP,0000,0000,0000,,Келіңіз, өз машинаңызды мініңіз.
Dialogue: 0,0:18:44.92,0:18:49.55,*Default,NTP,0000,0000,0000,,Кетер алдында тоқтайсың деп ойладым, бірақ таң қаларлықтай жұмыс істедің.
Dialogue: 0,0:18:51.09,0:18:54.29,*Default,NTP,0000,0000,0000,,Бірақ сен тоқтамасаң, мен сені тоқтатамын!
Dialogue: 0,0:18:54.29,0:18:56.42,*Default,NTP,0000,0000,0000,,Кеттік! Жойылған қыз!
Dialogue: 0,0:18:58.57,0:19:02.26,*Default,NTP,0000,0000,0000,,Қашықтық 9,7 8,5… уф…
Dialogue: 0,0:19:19.55,0:19:23.85,*Default,NTP,0000,0000,0000,,Қолыңыздан тек жүгіру ғана қалғанда қоян-қолтық ұрыста күресу мүмкін емес сияқты.
Dialogue: 0,0:19:29.43,0:19:30.23,*Default,NTP,0000,0000,0000,,Сізге!
Dialogue: 0,0:19:33.37,0:19:35.06,*Default,NTP,0000,0000,0000,,Өз қабілетіңізді көрсетіңіз!
Dialogue: 0,0:19:40.84,0:19:42.04,*Default,NTP,0000,0000,0000,,Барлығына!
Dialogue: 0,0:19:43.64,0:19:47.55,*Default,NTP,0000,0000,0000,,Қараңдар! Түсіндің бе!
Dialogue: 0,0:19:56.19,0:19:58.89,*Default,NTP,0000,0000,0000,,Норико Норико Жақсысың ба?
Dialogue: 0,0:20:01.40,0:20:03.90,*Default,NTP,0000,0000,0000,,Жаттықтырушы! Өтінемін, қазір тоқтатуға рұқсат етіңіз.
Dialogue: 0,0:20:03.90,0:20:07.33,*Default,NTP,0000,0000,0000,,Мен енді мұны істей алмаймын! Мен Нориконы аяймын!
Dialogue: 0,0:20:07.87,0:20:11.07,*Default,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Шынайы шайқас бұлай емес!
Dialogue: 0,0:20:11.27,0:20:12.24,*Default,NTP,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:20:14.94,0:20:17.17,*Default,NTP,0000,0000,0000,,Басқа кім мойындаса да
Dialogue: 0,0:20:17.95,0:20:20.57,*Default,NTP,0000,0000,0000,,Мен мұны құптамаймын.
Dialogue: 0,0:20:22.05,0:20:23.95,*Default,NTP,0000,0000,0000,,Жаттықтырушы… Жаттықтырушы…
Dialogue: 0,0:20:23.95,0:20:26.55,*Default,NTP,0000,0000,0000,,Мен не істеуім керек, жаттықтырушы?
Dialogue: 0,0:20:26.55,0:20:31.18,*Default,NTP,0000,0000,0000,,Басқаларға сенбе. Бүкіл денеңмен сезініп, жүрегіңмен бағала!
Dialogue: 0,0:20:31.39,0:20:34.52,*Default,NTP,0000,0000,0000,,Дұрыс, мен Намаджи мониторына алаңдаймын...
Dialogue: 0,0:20:37.53,0:20:39.02,*Default,NTP,0000,0000,0000,,Байқап көріңіз!
Dialogue: 0,0:20:41.30,0:20:42.90,*Default,NTP,0000,0000,0000,,Мен мониторды өшірдім!
Dialogue: 0,0:20:42.90,0:20:44.27,*Default,NTP,0000,0000,0000,,Не деген...
Dialogue: 0,0:20:50.41,0:20:55.31,*Default,NTP,0000,0000,0000,,Пуф! Папа! Па, бака кашитейчи!
Dialogue: 0,0:20:55.72,0:20:57.24,*Default,NTP,0000,0000,0000,,Міне!
Dialogue: 0,0:20:58.85,0:21:02.98,*Default,NTP,0000,0000,0000,,Үшбұрыштың бір парағы!
Dialogue: 0,0:21:04.19,0:21:05.16,*Default,NTP,0000,0000,0000,,Қазір!
Dialogue: 0,0:21:08.06,0:21:10.12,*Default,NTP,0000,0000,0000,,Toto Fly Aichi
Dialogue: 0,0:21:12.03,0:21:13.12,*Default,NTP,0000,0000,0000,,Жоқ!?
Dialogue: 0,0:21:16.44,0:21:21.43,*Default,NTP,0000,0000,0000,,Найзағай соғуы!
Dialogue: 0,0:21:39.39,0:21:40.99,*Default,NTP,0000,0000,0000,,Мен жеңілдім
Dialogue: 0,0:21:41.30,0:21:46.13,*Default,NTP,0000,0000,0000,,Автоматқа мініп, ай баласы сол найзағай тепті...
Dialogue: 0,0:21:46.13,0:21:48.03,*Default,NTP,0000,0000,0000,,Мен сене алар емеспін.
Dialogue: 0,0:22:01.18,0:22:03.38,*Default,NTP,0000,0000,0000,,Такая Амано
Dialogue: 0,0:22:04.35,0:22:08.09,*Default,NTP,0000,0000,0000,,Сіз бірінші болып машиналық қару бөліміне шабуыл жасайсыз.
Dialogue: 0,0:22:08.09,0:22:10.18,*Default,NTP,0000,0000,0000,,Жоғарғы топтың мүшесі болыңыз
Dialogue: 0,0:22:12.43,0:22:16.02,*Default,NTP,0000,0000,0000,,Бірақ нағыз қиындық әлі алда.
Dialogue: 0,0:22:16.60,0:22:18.50,*Default,NTP,0000,0000,0000,,Нағыз шың болу
Dialogue: 0,0:22:20.03,0:22:24.56,*Default,NTP,0000,0000,0000,,Адамдарды шынайы қорғай алатын және достарын құтқара алатын ғарыш жауынгері болу.
Dialogue: 0,0:22:26.94,0:22:29.88,*Default,NTP,0000,0000,0000,,Талпынуды тоқтатпаңыз, оны жеңіңіз
Dialogue: 0,0:22:29.88,0:22:32.24,*Default,NTP,0000,0000,0000,,Және күрес!
Dialogue: 0,0:23:13.49,0:23:17.01,*Default,NTP,0000,0000,0000,,Әдемі Фудзи тауы
Dialogue: 0,0:23:20.43,0:23:24.16,*Default,NTP,0000,0000,0000,,Иә! Биікке ұмтылыңыз!
Dialogue: 0,0:23:55.00,0:23:59.71,*Default,NTP,0000,0000,0000,,Ол кішкентай қарындасы сияқты
Dialogue: 0,0:23:59.71,0:24:04.54,*Default,NTP,0000,0000,0000,,Жауапты күбірлеп айттыңыз.
Dialogue: 0,0:24:04.54,0:24:09.25,*Default,NTP,0000,0000,0000,,Шарасыз мойындау
Dialogue: 0,0:24:09.25,0:24:13.25,*Default,NTP,0000,0000,0000,,Желге шашылған жексенбі
Dialogue: 0,0:24:13.25,0:24:17.82,*Default,NTP,0000,0000,0000,,Егер сізді күн астында тастап кетсе
Dialogue: 0,0:24:17.82,0:24:22.60,*Default,NTP,0000,0000,0000,,Көз жасына орын жоқ
Dialogue: 0,0:24:22.60,0:24:30.00,*Default,NTP,0000,0000,0000,,Мен Бозеннің арқасына қолымды қыстым...
Dialogue: 0,0:24:30.00,0:24:32.01,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:32.01,0:24:40.55,*Default,NTP,0000,0000,0000,,Содан кейін қараңғы күндер
Dialogue: 0,0:24:40.55,0:24:45.02,*Default,NTP,0000,0000,0000,,Бірақ, ғашық болу күші
Dialogue: 0,0:24:45.02,0:24:49.46,*Default,NTP,0000,0000,0000,,Кеудеде жазықсыз ұрыс
Dialogue: 0,0:24:49.46,0:24:53.89,*Default,NTP,0000,0000,0000,,Жүректің тереңінде, қылқалам
Dialogue: 0,0:24:53.89,0:24:59.13,*Default,NTP,0000,0000,0000,,Мен бір күні қайталап көремін
Dialogue: 0,0:25:00.63,0:25:06.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
