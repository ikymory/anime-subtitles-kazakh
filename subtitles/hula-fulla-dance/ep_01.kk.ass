Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.10,0:00:25.19,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:00:29.86,0:00:31.28,Default,,0,0,0,,Гүлдер жайқалып тұрды
Dialogue: 0,0:00:31.65,0:00:32.99,Default,,0,0,0,,Хиуа (Хиуа) Иә?
Dialogue: 0,0:00:34.53,0:00:35.82,Default,,0,0,0,,Гүлдер әрқашан қол жетімді
Dialogue: 0,0:00:36.66,0:00:38.58,Default,,0,0,0,,Хива да оны көруге келеді, солай ма?
Dialogue: 0,0:00:39.03,0:00:41.62,Default,,0,0,0,,Әпке, бүгін мен жеке билеп жатырмын.
Dialogue: 0,0:00:42.87,0:00:43.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:43.71,0:00:44.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:51.34,0:00:52.76,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:57.97,0:00:58.72,Default,,0,0,0,,Хехехе
Dialogue: 0,0:01:02.22,0:01:04.27,Default,,0,0,0,,Бірақ гүл...
Dialogue: 0,0:01:15.70,0:01:20.95,Default,,0,0,0,,(Дабыл әні)
Dialogue: 0,0:01:21.04,0:01:21.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:22.08,0:01:26.71,Default,,0,0,0,,(Дабыл әні)
Dialogue: 0,0:01:26.79,0:01:29.79,Default,,0,0,0,,Хива Хиваны оят!
Dialogue: 0,0:01:33.71,0:01:36.97,Default,,0,0,0,,Эй Хиуа, уақыт болды, оян.
Dialogue: 0,0:01:37.72,0:01:38.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:39.85,0:01:40.89,Default,,0,0,0,,Хиба?
Dialogue: 0,0:01:43.10,0:01:44.14,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:44.35,0:01:46.06,Default,,0,0,0,,Таңғы ас ше? (Хиба) Жақсы
Dialogue: 0,0:01:46.85,0:01:48.40,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:01:51.73,0:01:52.90,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:01:59.49,0:02:00.99,Default,,0,0,0,,А, мен барамын.
Dialogue: 0,0:02:01.58,0:02:03.54,Default,,0,0,0,,О, абай бол.
Dialogue: 0,0:02:29.90,0:02:30.65,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:02:49.58,0:02:51.08,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:02:52.25,0:02:53.92,Default,,0,0,0,,Бұл тағы да тәртіпсіз~
Dialogue: 0,0:02:54.00,0:02:55.55,Default,,0,0,0,,Әрең
Dialogue: 0,0:02:55.63,0:02:58.26,Default,,0,0,0,,Сіз қалай ойлайсыз? Сәнді салондағы қыз ретінде
Dialogue: 0,0:02:59.55,0:03:00.51,Default,,0,0,0,,Хэхехе~
Dialogue: 0,0:03:01.47,0:03:02.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:02.89,0:03:04.85,Default,,0,0,0,,Ең болмағанда ұйықтау әдетіңізді түзетіңіз.
Dialogue: 0,0:03:05.31,0:03:06.64,Default,,0,0,0,,Аукцион шешілсе де
Dialogue: 0,0:03:06.85,0:03:09.35,Default,,0,0,0,,Шаштараз болу үшін кәсіптік-техникалық училищеге бару
Dialogue: 0,0:03:09.64,0:03:10.77,Default,,0,0,0,,О~
Dialogue: 0,0:03:11.19,0:03:14.48,Default,,0,0,0,,Хиуамен де барайық. Біз дүкенді алуымыз керек.
Dialogue: 0,0:03:16.19,0:03:17.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:17.94,0:03:19.36,Default,,0,0,0,,Нако шешім қабылдады ма? курс
Dialogue: 0,0:03:19.86,0:03:21.11,Default,,0,0,0,,Мен шештім...
Dialogue: 0,0:03:21.20,0:03:24.37,Default,,0,0,0,,Мен өзімнің бірінші таңдауымды қабылдайтыныма сенімдімін!
Dialogue: 0,0:03:24.45,0:03:25.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:30.21,0:03:31.50,Default,,0,0,0,,Мен келесі аптада сұхбаттасамын.
Dialogue: 0,0:03:31.87,0:03:34.29,Default,,0,0,0,,Емтихан тапсыратын болсаңыз, жазғы демалыс кілті.
Dialogue: 0,0:03:34.38,0:03:36.25,Default,,0,0,0,,Сіз бұл сөздерді өзіңізге айтасыз ба?
Dialogue: 0,0:03:36.34,0:03:37.42,Default,,0,0,0,,Куууу…
Dialogue: 0,0:03:37.84,0:03:38.92,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:39.42,0:03:40.72,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:03:41.09,0:03:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:42.26,0:03:45.35,Default,,0,0,0,,А, мен не істеуім керек? Хехе...
Dialogue: 0,0:03:47.22,0:03:50.23,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:54.23,0:03:54.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.65,0:04:01.99,Default,,0,0,0,,(Хула биі)
Dialogue: 0,0:04:02.07,0:04:03.86,Default,,0,0,0,,О, дәмді, дәмді
Dialogue: 0,0:04:04.74,0:04:07.24,Default,,0,0,0,,Би билегенде, күл, күл
Dialogue: 0,0:04:08.12,0:04:09.16,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:09.66,0:04:12.21,Default,,0,0,0,,Хива болашақта кәсіби биші бола ма?
Dialogue: 0,0:04:12.79,0:04:14.00,Default,,0,0,0,,Олай болса, әпке-
Dialogue: 0,0:04:14.12,0:04:16.92,Default,,0,0,0,,Хиба ішке кіргенше барымды саламын!
Dialogue: 0,0:04:18.25,0:04:21.55,Default,,0,0,0,,(Смартфоннан ойналатын ән)
Dialogue: 0,0:04:31.98,0:04:33.73,Default,,0,0,0,,Атта! Уф...
Dialogue: 0,0:04:37.15,0:04:38.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:41.11,0:04:42.90,Default,,0,0,0,,Хива, не болды?
Dialogue: 0,0:04:45.36,0:04:46.49,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:04:46.91,0:04:48.87,Default,,0,0,0,,Амансың ба? не болды?
Dialogue: 0,0:04:49.24,0:04:50.33,Default,,0,0,0,,Хмм... Былай деуге болады
Dialogue: 0,0:04:50.95,0:04:53.29,Default,,0,0,0,,Кішкене хула билеу
Dialogue: 0,0:04:54.67,0:04:56.29,Default,,0,0,0,,Хиуа? (Хиба) Иә?
Dialogue: 0,0:04:56.83,0:05:00.84,Default,,0,0,0,,А, иә, сондықтан мен құладым...
Dialogue: 0,0:05:01.38,0:05:04.59,Default,,0,0,0,,Қазірдің өзінде... не істеп жатырсың?
Dialogue: 0,0:05:04.84,0:05:06.34,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:05:06.43,0:05:07.47,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:05:10.43,0:05:11.22,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:20.77,0:05:21.65,Default,,0,0,0,,Эххе
Dialogue: 0,0:05:33.58,0:05:35.08,Default,,0,0,0,,Сіз күлдіңіз.
Dialogue: 0,0:05:36.08,0:05:39.00,Default,,0,0,0,,Екеуміздің осылай күлгенімізге көп болды.
Dialogue: 0,0:05:50.68,0:05:51.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:01.44,0:06:02.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:02.40,0:06:04.40,Default,,0,0,0,,Күлімде, күлімде
Dialogue: 0,0:06:04.86,0:06:05.53,Default,,0,0,0,,А...
Dialogue: 0,0:06:09.49,0:06:10.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.74,0:06:13.83,Default,,0,0,0,,Кокоо Коко Коко~
Dialogue: 0,0:06:14.12,0:06:14.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:19.50,0:06:21.00,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:06:23.84,0:06:27.05,Default,,0,0,0,,Жүр, бірге барайық.
Dialogue: 0,0:06:32.35,0:06:33.01,Default,,0,0,0,,А...
Dialogue: 0,0:06:36.02,0:06:37.10,Default,,0,0,0,,Уффун
Dialogue: 0,0:06:54.20,0:07:00.21,Default,,0,0,0,,♪～
Dialogue: 0,0:07:49.51,0:07:55.51,Default,,0,0,0,,～♪
Dialogue: 0,0:08:03.15,0:08:06.94,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:08:07.48,0:08:09.78,Default,,0,0,0,,КоКо Ни-сан Бұл тұмар кейіпкері
Dialogue: 0,0:08:10.40,0:08:12.40,Default,,0,0,0,,♪Мен кокос пальмасымын...
Dialogue: 0,0:08:12.49,0:08:13.49,Default,,0,0,0,,♪Ертегі
Dialogue: 0,0:08:13.57,0:08:15.20,Default,,0,0,0,,А, сен білесің бе?
Dialogue: 0,0:08:15.28,0:08:16.53,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:16.87,0:08:19.49,Default,,0,0,0,,Менің бала кезімде сатып алған тұлып бар.
Dialogue: 0,0:08:19.58,0:08:20.45,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:24.00,0:08:26.34,Default,,0,0,0,,Оны индукция рәсіміне әкелгіңіз келе ме?
Dialogue: 0,0:08:26.42,0:08:28.88,Default,,0,0,0,,Оны Гавайидегі әпкеме жіберіңіз~
Dialogue: 0,0:08:29.76,0:08:31.42,Default,,0,0,0,,Биыл бірінші рет—
Dialogue: 0,0:08:31.51,0:08:34.51,Default,,0,0,0,,Гавайиден жаңа адам қосылады деп естідім.
Dialogue: 0,0:08:34.64,0:08:36.51,Default,,0,0,0,,Иә, мияу
Dialogue: 0,0:08:36.64,0:08:37.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:38.26,0:08:39.39,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:08:39.72,0:08:42.18,Default,,0,0,0,,Әй, бәрі де биші ретінде емтихан тапсырды.
Dialogue: 0,0:08:42.31,0:08:43.69,Default,,0,0,0,,«Мо»... сіз де?
Dialogue: 0,0:08:43.77,0:08:44.44,Default,,0,0,0,,Иә
Dialogue: 0,0:08:44.65,0:08:47.61,Default,,0,0,0,,Сумо тұрақты жаңа шәкірт емтиханынан өтті
Dialogue: 0,0:08:47.69,0:08:48.86,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:08:48.94,0:08:51.94,Default,,0,0,0,,Ранко Такигава хула бишісі болу үшін емтихан тапсырды
Dialogue: 0,0:08:52.15,0:08:52.82,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:08:53.36,0:08:55.36,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:08:56.66,0:08:58.33,Default,,0,0,0,,Мен бір уақытта 5 адам болғанын естідім...
Dialogue: 0,0:09:00.95,0:09:02.37,Default,,0,0,0,,Сіз де? (Шион Ширасава) Иә...
Dialogue: 0,0:09:06.63,0:09:08.79,Default,,0,0,0,,Аа, сіз КоКо-нидің печеньесін жегіңіз келе ме?
Dialogue: 0,0:09:09.29,0:09:12.97,Default,,0,0,0,,Мен көрдім. CoCo-nee - кокос жаңғағы ертегісі.
Dialogue: 0,0:09:13.51,0:09:14.88,Default,,0,0,0,,Өйткені ол пері...
Dialogue: 0,0:09:17.76,0:09:18.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:19.14,0:09:22.56,Default,,0,0,0,,Иә, мен ол кезде армандаған шығармын.
Dialogue: 0,0:09:23.68,0:09:26.23,Default,,0,0,0,,Не болды? (Хиба) А, бәрі де...
Dialogue: 0,0:09:26.31,0:09:29.65,Default,,0,0,0,,Барлығына! Индукция рәсімі өтетін жерге көшіңіз
Dialogue: 0,0:09:29.77,0:09:30.44,Default,,0,0,0,,Иә
Dialogue: 0,0:09:34.24,0:09:34.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.03,0:09:35.95,Default,,0,0,0,,(билборд құлаған дыбыс)
Dialogue: 0,0:09:36.95,0:09:37.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:43.29,0:09:44.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:45.62,0:09:48.00,Default,,0,0,0,,Мен өтемін деп ойламаппын.
Dialogue: 0,0:09:55.30,0:09:57.72,Default,,0,0,0,,Содан бастап мен бар күш-жігеріммен арызымды бердім.
Dialogue: 0,0:09:59.26,0:10:02.10,Default,,0,0,0,,Қоғамдық орталықтағы хула би сабағына қатысу
Dialogue: 0,0:10:02.89,0:10:05.68,Default,,0,0,0,,Әңгімелесу мен тәжірибелік тестті тапсырғаннан кейін
Dialogue: 0,0:10:06.64,0:10:07.81,Default,,0,0,0,,Хула бишісіне...
Dialogue: 0,0:10:09.56,0:10:10.77,Default,,0,0,0,,өтті—
Dialogue: 0,0:10:11.36,0:10:15.32,Default,,0,0,0,,Мен индукция рәсіміне мұндай костюм киемін деп ешқашан ойламаппын.
Dialogue: 0,0:10:15.74,0:10:16.61,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:10:17.20,0:10:18.99,Default,,0,0,0,,Ендеше тұлыптарыңды тастаңдар!
Dialogue: 0,0:10:19.53,0:10:20.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.53,0:10:21.62,Default,,0,0,0,,Cookie файлдары да!
Dialogue: 0,0:10:22.16,0:10:23.04,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:10:25.04,0:10:26.66,Default,,0,0,0,,Мм... жақсысың ба?
Dialogue: 0,0:10:27.75,0:10:30.88,Default,,0,0,0,,Енді біз биылғы жаңалыққа шақыру рәсімін өткіземіз.
Dialogue: 0,0:10:31.84,0:10:34.30,Default,,0,0,0,,Барлығыңызды компанияға қосылуыңызбен құттықтаймыз
Dialogue: 0,0:10:34.50,0:10:35.88,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:10:36.21,0:10:38.72,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:10:39.80,0:10:40.64,Default,,0,0,0,,Аро... (Президент) Барлығы...
Dialogue: 0,0:10:41.22,0:10:42.93,Default,,0,0,0,,Бұдан былай қоғам мүшесі ретінде—
Dialogue: 0,0:10:43.10,0:10:47.18,Default,,0,0,0,,Сіз Spa Resort Hawaiians мүшесі ретінде жұмыс істейсіз.
Dialogue: 0,0:10:47.56,0:10:51.86,Default,,0,0,0,,Біз көмір өндіруден басқа жаңа кәсіп ашуға тырысамыз.
Dialogue: 0,0:10:52.11,0:10:55.03,Default,,0,0,0,,Токива Юмотоның бай ыстық көздерін пайдалану —
Dialogue: 0,0:10:55.48,0:10:59.78,Default,,0,0,0,,Гавайи арманындағы аралдан шабыттанған курорттық нысан ретінде дүниеге келген...
Dialogue: 0,0:11:02.28,0:11:05.79,Default,,0,0,0,,Келесі кіру салтанаты, солай ма?
Dialogue: 0,0:11:05.87,0:11:07.54,Default,,0,0,0,,Өтінемін, бұлай сөйлесуді тоқтата аласыз ба?
Dialogue: 0,0:11:08.00,0:11:10.50,Default,,0,0,0,,Жапон қыздарының үштен біріне жуығы...
Dialogue: 0,0:11:10.58,0:11:12.75,Default,,0,0,0,,Мен сені осылай сөйлейді деп ойладым.
Dialogue: 0,0:11:12.83,0:11:13.79,Default,,0,0,0,,Себебі мен емес.
Dialogue: 0,0:11:15.13,0:11:18.30,Default,,0,0,0,,Сонымен, мектебіміз құрылғаннан бері кім оқытушы болды?
Dialogue: 0,0:11:18.38,0:11:19.80,Default,,0,0,0,,Сахнаға жалпы бақылау...
Dialogue: 0,0:11:19.88,0:11:22.64,Default,,0,0,0,,Хула бишісі болып жұмысқа алынған кезде...
Dialogue: 0,0:11:22.97,0:11:25.43,Default,,0,0,0,,Филиалдағы академияға қабылданады
Dialogue: 0,0:11:26.06,0:11:26.97,Default,,0,0,0,,Барлығы –
Dialogue: 0,0:11:27.10,0:11:30.64,Default,,0,0,0,,Біздің компанияға қосылуыңыз және тіркелуіңізбен құттықтаймыз.
Dialogue: 0,0:11:31.06,0:11:34.36,Default,,0,0,0,,Өйткені бұдан былай барлығың би тобының мүшесі боласыңдар.
Dialogue: 0,0:11:34.56,0:11:37.19,Default,,0,0,0,,Хула биі ғана емес, сонымен қатар Полинезия биі...
Dialogue: 0,0:11:37.28,0:11:40.49,Default,,0,0,0,,Мұнда екі жыл түрлі сабақтардан өткен соң...
Dialogue: 0,0:11:40.86,0:11:44.95,Default,,0,0,0,,Сіз академияны бітіріп, ресми биші бола аласыз.
Dialogue: 0,0:11:46.37,0:11:51.33,Default,,0,0,0,,Біздің жоғары сынып оқушыларына мектеп бітіру рәсімі оқуға түсу рәсімімен бір уақытта өтті...
Dialogue: 0,0:11:51.83,0:11:55.96,Default,,0,0,0,,Осымен мен екі жылдық курсты аяқтағанымды растаймын.
Dialogue: 0,0:11:56.21,0:11:59.55,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:00.26,0:12:01.30,Default,,0,0,0,,Содан кейін жалғастырыңыз—
Dialogue: 0,0:12:01.80,0:12:04.80,Default,,0,0,0,,Биылғы жылы жаңа студенттерге өзімізді таныстырамыз.
Dialogue: 0,0:12:08.60,0:12:11.27,Default,,0,0,0,,Менің атым Канна Камакура, мен Канагава префектурасынанмын.
Dialogue: 0,0:12:11.98,0:12:14.98,Default,,0,0,0,,Орта мектепте хула клубының мүшесі болдым және клуб президенті қызметін атқардым.
Dialogue: 0,0:12:15.23,0:12:19.15,Default,,0,0,0,,Үшінші сыныпта оқып жүргенімде Hula Dance Koshien-де бірінші орынды жеңіп алдым.
Dialogue: 0,0:12:21.36,0:12:26.24,Default,,0,0,0,,10 жыл бұрын мен ағаларым елдің түкпір-түкпірінде гастрольдік сапармен жүрген Кизуна сахнасын көрдім.
Dialogue: 0,0:12:26.74,0:12:29.24,Default,,0,0,0,,Енді мен мұнда билегім келеді.
Dialogue: 0,0:12:30.12,0:12:32.58,Default,,0,0,0,,Мен бұрынғы тәжірибемді пайдалана отырып, бар күшімді саламын.
Dialogue: 0,0:12:37.50,0:12:41.01,Default,,0,0,0,,Мен Гавайиден келген Охана Кааихуэмін.
Dialogue: 0,0:12:41.17,0:12:43.55,Default,,0,0,0,,Гавайидегі қарттардың өнерін көру —
Dialogue: 0,0:12:43.63,0:12:46.80,Default,,0,0,0,,Мен Гавайиде, Жапонияда билеу туралы ойлана бастадым.
Dialogue: 0,0:12:47.18,0:12:50.77,Default,,0,0,0,,Мен Жапонияда тұруды асыға күтемін.
Dialogue: 0,0:12:50.85,0:12:51.73,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:12:52.52,0:12:54.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:54.90,0:12:57.15,Default,,0,0,0,,Мен Акитадан келген Ранко Такигавамын.
Dialogue: 0,0:12:57.40,0:12:59.02,Default,,0,0,0,,Менің сүйікті спортым - сумо күресі
Dialogue: 0,0:12:59.11,0:13:01.19,Default,,0,0,0,,Жоқ, жоқ, билеу
Dialogue: 0,0:13:01.44,0:13:03.20,Default,,0,0,0,,Маған ұнамайтыны қорқынышты фильмдер.
Dialogue: 0,0:13:03.53,0:13:04.95,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:13:08.99,0:13:10.04,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:12.04,0:13:14.87,Default,,0,0,0,,Менің атым Хива Нацунаги, Иваки қаласынан...
Dialogue: 0,0:13:15.62,0:13:17.92,Default,,0,0,0,,Менің биде тәжірибем өте аз, бірақ мен бар күшімді саламын...
Dialogue: 0,0:13:18.13,0:13:18.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:19.04,0:13:19.96,Default,,0,0,0,,Міне болды~
Dialogue: 0,0:13:20.05,0:13:22.26,Default,,0,0,0,,(Қызметкерлердің күлкісі)
Dialogue: 0,0:13:24.80,0:13:25.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.77,0:13:38.23,Default,,0,0,0,,Я... Ямагатадан
Dialogue: 0,0:13:38.36,0:13:40.61,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:13:41.61,0:13:42.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.86,0:13:45.95,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:13:46.74,0:13:47.41,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:48.11,0:13:49.24,Default,,0,0,0,,Иә? аздап!
Dialogue: 0,0:13:51.62,0:13:53.08,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:13:55.91,0:13:59.08,Default,,0,0,0,,Сондай-ақ... Мен қазір жұмыстан шығамын.
Dialogue: 0,0:13:59.17,0:14:00.79,Default,,0,0,0,,Жоқ, жоқ, Ширасава мырза
Dialogue: 0,0:14:01.34,0:14:03.26,Default,,0,0,0,,Кез келген адам сәтсіздікке ұшырауы мүмкін...
Dialogue: 0,0:14:03.76,0:14:05.47,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:14:06.47,0:14:07.88,Default,,0,0,0,,Ах, атмосфераны оқи алмағаным үшін кешіріңіз.
Dialogue: 0,0:14:08.43,0:14:10.05,Default,,0,0,0,,Сонымен, сіз жұмысты тастап жатырсыз ба?
Dialogue: 0,0:14:10.93,0:14:13.93,Default,,0,0,0,,Мен көпшілік алдында сөйлей алмаймын...
Dialogue: 0,0:14:14.27,0:14:15.81,Default,,0,0,0,,Бірақ сен билейсің бе?
Dialogue: 0,0:14:16.18,0:14:18.81,Default,,0,0,0,,Практикалық емтихан кезінде өте жақсы болды.
Dialogue: 0,0:14:20.31,0:14:22.94,Default,,0,0,0,,Мен билегенді ұнатамын...
Dialogue: 0,0:14:27.86,0:14:28.95,Default,,0,0,0,,Сізге ұнаса жақсы, бірақ—
Dialogue: 0,0:14:29.11,0:14:31.74,Default,,0,0,0,,Енді біз көпшілік алдында билейміз!
Dialogue: 0,0:14:32.20,0:14:33.62,Default,,0,0,0,,Сіз мұны осылай жасай аласыз ба?
Dialogue: 0,0:14:39.62,0:14:45.51,Default,,0,0,0,,(Хула биі)
Dialogue: 0,0:14:48.93,0:14:50.55,Default,,0,0,0,,Ақыр соңында, мен кеттім...
Dialogue: 0,0:14:54.39,0:14:57.23,Default,,0,0,0,,Кокоо~ Коко Коко
Dialogue: 0,0:14:57.35,0:14:59.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:59.94,0:15:00.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.81,0:15:03.94,Default,,0,0,0,,CoCo-nee!
Dialogue: 0,0:15:04.02,0:15:05.57,Default,,0,0,0,,Нацунаги-сан, отыр!
Dialogue: 0,0:15:05.65,0:15:07.36,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:15:13.83,0:15:16.54,Default,,0,0,0,,Сахнаның ар жағында осылай көрінеді.
Dialogue: 0,0:15:17.08,0:15:19.04,Default,,0,0,0,,Мен өте аламын, солай ма?
Dialogue: 0,0:15:20.17,0:15:22.42,Default,,0,0,0,,Бұл жерде сіз киім ауыстырып, боянасыз.
Dialogue: 0,0:15:23.08,0:15:25.67,Default,,0,0,0,,Қойылым аяқталды, үлкендер киімдерін ауыстырып жатыр.
Dialogue: 0,0:15:33.64,0:15:35.22,Default,,0,0,0,,Хааа~
Dialogue: 0,0:15:36.72,0:15:37.39,Default,,0,0,0,,Ах
Dialogue: 0,0:15:37.85,0:15:40.44,Default,,0,0,0,,Мен шоуды тамашалауды аяқтадым, бүгінгі күн осымен аяқталды.
Dialogue: 0,0:15:40.60,0:15:41.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.56,0:15:46.94,Default,,0,0,0,,Би командасының капитаны Пуара Аяме мен...
Dialogue: 0,0:15:47.28,0:15:49.28,Default,,0,0,0,,Бұл Назуна Капилина, вице-капитан.
Dialogue: 0,0:15:49.69,0:15:51.70,Default,,0,0,0,,Алдын ала рахмет (Хиба) Алдын ала рахмет.
Dialogue: 0,0:15:53.66,0:15:56.91,Default,,0,0,0,,Аа... Ертеде кешіріңіз.
Dialogue: 0,0:15:56.99,0:16:00.50,Default,,0,0,0,,А, мен сенің айқайлағаныңды бұрын естідім.
Dialogue: 0,0:16:00.71,0:16:01.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:02.58,0:16:05.25,Default,,0,0,0,,Сізге КоКо Нидің биі қатты ұнады ма?
Dialogue: 0,0:16:05.42,0:16:09.21,Default,,0,0,0,,А, жоқ, менің әпкем бар...
Dialogue: 0,0:16:09.76,0:16:12.51,Default,,0,0,0,,Әпкем маған тұлып сатып берді.
Dialogue: 0,0:16:13.39,0:16:16.93,Default,,0,0,0,,Біраз бұрын әлгі тұлып кенет менімен сөйлесе бастады...
Dialogue: 0,0:16:21.56,0:16:23.02,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:16:25.27,0:16:26.73,Default,,0,0,0,,сол әйелдің еркі еді, иә?
Dialogue: 0,0:16:27.11,0:16:30.49,Default,,0,0,0,,Биыл таңғажайып нәрсе келді.
Dialogue: 0,0:16:30.65,0:16:34.61,Default,,0,0,0,,А, жоқ, мен түс көріп тұрған шығармын.
Dialogue: 0,0:16:34.70,0:16:36.74,Default,,0,0,0,,Жақында сізге үміттенеміз
Dialogue: 0,0:16:36.83,0:16:39.16,Default,,0,0,0,,Мен толыққанды биші болуды армандаймын.
Dialogue: 0,0:16:39.83,0:16:41.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:41.33,0:16:43.21,Default,,0,0,0,,Сәттілік! Жұмбақ-чан да
Dialogue: 0,0:16:43.46,0:16:44.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:48.50,0:16:50.38,Default,,0,0,0,,Бұрынғы аға буын өкілдері ше?
Dialogue: 0,0:16:50.67,0:16:52.84,Default,,0,0,0,,Пуара? Капилина?
Dialogue: 0,0:16:53.34,0:16:57.76,Default,,0,0,0,,Жеке биші болған кезде сахналық ат ретінде сіз Гавай есімін аласыз.
Dialogue: 0,0:16:58.26,0:16:59.68,Default,,0,0,0,,Капилин – «байланыс»
Dialogue: 0,0:16:59.93,0:17:02.10,Default,,0,0,0,,Пуара – «күн гүлі»
Dialogue: 0,0:17:02.56,0:17:04.10,Default,,0,0,0,,Күн гүлі…
Dialogue: 0,0:17:04.73,0:17:06.31,Default,,0,0,0,,Күнбағысқа қараңдар
Dialogue: 0,0:17:07.15,0:17:08.48,Default,,0,0,0,,Күнбағыс…
Dialogue: 0,0:17:09.73,0:17:10.40,Default,,0,0,0,,Ах
Dialogue: 0,0:17:14.32,0:17:18.49,Default,,0,0,0,,Пуара... апам қойған есім
Dialogue: 0,0:17:21.41,0:17:23.04,Default,,0,0,0,,Әпкеммен синхрондалған...
Dialogue: 0,0:17:24.58,0:17:26.96,Default,,0,0,0,,Менің ойымша, ол әпкесінің атын иемденді.
Dialogue: 0,0:17:27.58,0:17:28.42,Default,,0,0,0,,(төсекте отырған дыбысы)
Dialogue: 0,0:17:29.67,0:17:30.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:36.76,0:17:39.26,Default,,0,0,0,,Сенің арқаңда мен «жұмбақ қыз» болдым.
Dialogue: 0,0:17:44.48,0:17:48.15,Default,,0,0,0,,Сәлем бәріңе, бұл Макана Охно, би нұсқаушысы.
Dialogue: 0,0:17:48.35,0:17:49.40,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:17:49.81,0:17:51.15,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:17:51.61,0:17:52.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.53,0:17:54.78,Default,,0,0,0,,О, ана жақтағы жаңа жігіттер.
Dialogue: 0,0:17:55.07,0:17:57.91,Default,,0,0,0,,Менің сәлемдесуім "Алоха~"
Dialogue: 0,0:17:58.49,0:17:59.66,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:17:59.95,0:18:01.66,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:18:01.95,0:18:04.50,Default,,0,0,0,,Иә, онда мынаны қарай аласыз ба?
Dialogue: 0,0:18:06.71,0:18:09.46,Default,,0,0,0,,Олай болса... Охана-чан
Dialogue: 0,0:18:09.83,0:18:12.30,Default,,0,0,0,,Сіз Гавайиденсіз, сондықтан мен түсінемін.
Dialogue: 0,0:18:12.63,0:18:13.55,Default,,0,0,0,,Маған оқып бере аласыз ба?
Dialogue: 0,0:18:13.71,0:18:14.96,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:15.92,0:18:17.84,Default,,0,0,0,,Акахай (Макана Сенсэй) Мейірімділік
Dialogue: 0,0:18:18.34,0:18:19.97,Default,,0,0,0,,Локахи (Макана Сенсей) Гармониясы
Dialogue: 0,0:18:20.47,0:18:22.60,Default,,0,0,0,,Оруору~ (Макана Сенсэй) Ыңғайлы
Dialogue: 0,0:18:23.14,0:18:25.60,Default,,0,0,0,,Хахахаха... (Макана Сенсэй) Кішіпейілділік
Dialogue: 0,0:18:26.02,0:18:27.85,Default,,0,0,0,,Ахонуй (Макана Сенсей) Сабыр
Dialogue: 0,0:18:28.48,0:18:30.44,Default,,0,0,0,,Иә, рахмет Охана-чан.
Dialogue: 0,0:18:31.19,0:18:33.53,Default,,0,0,0,,«Алоха» көп мағынаға ие.
Dialogue: 0,0:18:33.94,0:18:36.95,Default,,0,0,0,,«Қош келдіңіз» «Қош болыңыз» «Рахмет»
Dialogue: 0,0:18:37.70,0:18:40.66,Default,,0,0,0,,Бұл «мен сені сүйемін» дегенді де білдіруі мүмкін.
Dialogue: 0,0:18:40.82,0:18:41.70,Default,,0,0,0,,Мен жақсы көремін...
Dialogue: 0,0:18:42.33,0:18:44.37,Default,,0,0,0,,Иә, содан кейін көріңіз.
Dialogue: 0,0:18:44.70,0:18:46.04,Default,,0,0,0,,Ало~ха~
Dialogue: 0,0:18:46.50,0:18:48.71,Default,,0,0,0,,Аро~ха~ Аро… га…
Dialogue: 0,0:18:49.21,0:18:51.42,Default,,0,0,0,,Осы сәлемдесуге дағдыланыңыз.
Dialogue: 0,0:18:52.04,0:18:54.63,Default,,0,0,0,,Негізгі қадамдардан бастайық.
Dialogue: 0,0:18:55.09,0:18:55.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:56.05,0:18:58.88,Default,,0,0,0,,(Компоненттен орындалатын ән)
Dialogue: 0,0:18:59.63,0:19:02.64,Default,,0,0,0,,Отыр ~ Кахородан
Dialogue: 0,0:19:03.01,0:19:05.68,Default,,0,0,0,,1 қадам солға 2 қадам солға
Dialogue: 0,0:19:06.52,0:19:09.89,Default,,0,0,0,,Енді оңға қарай бір немесе екі қадам жасаңыз.
Dialogue: 0,0:19:10.56,0:19:12.23,Default,,0,0,0,,Еңкейіп ~
Dialogue: 0,0:19:14.48,0:19:18.24,Default,,0,0,0,,Бір екі үш төрт бір екі
Dialogue: 0,0:19:18.40,0:19:19.53,Default,,0,0,0,,Күлімсіреу~
Dialogue: 0,0:19:21.03,0:19:23.53,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,0:19:24.95,0:19:28.12,Default,,0,0,0,,Енді қол қимылдарын қосамыз.
Dialogue: 0,0:19:28.54,0:19:29.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.46,0:19:31.88,Default,,0,0,0,,Өз қалпыңызды қадағалаңыз
Dialogue: 0,0:19:34.13,0:19:38.42,Default,,0,0,0,,Бір екі үш төрт Бір екі үш төрт
Dialogue: 0,0:19:38.59,0:19:43.01,Default,,0,0,0,,Бір екі үш төрт Бір екі үш төрт
Dialogue: 0,0:19:46.76,0:19:48.02,Default,,0,0,0,,Күлімсіреу~
Dialogue: 0,0:19:50.64,0:19:52.02,Default,,0,0,0,,Иә Жарайды
Dialogue: 0,0:19:52.85,0:19:55.19,Default,,0,0,0,,Ал, келесі жолы тек екінші курс студенттері.
Dialogue: 0,0:19:55.86,0:19:57.69,Default,,0,0,0,,Жаңа студенттер, қараңыздар
Dialogue: 0,0:19:59.19,0:20:01.24,Default,,0,0,0,,Жарайсыңдар, 2 курс студенттері, кеттік. (2 курс студенттері) Иә!
Dialogue: 0,0:20:04.24,0:20:06.41,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,0:20:06.49,0:20:10.96,Default,,0,0,0,,Бір екі үш төрт Бір екі үш төрт
Dialogue: 0,0:20:20.01,0:20:21.51,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:20:21.59,0:20:22.26,Default,,0,0,0,,Иә
Dialogue: 0,0:20:42.45,0:20:43.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:43.32,0:20:44.24,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:44.53,0:20:46.91,Default,,0,0,0,,Ая~ Не істеп жатырсың?
Dialogue: 0,0:20:47.45,0:20:49.04,Default,,0,0,0,,А, рамен
Dialogue: 0,0:20:49.66,0:20:51.54,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:20:52.87,0:20:56.17,Default,,0,0,0,,Мен гарнир сатып алдым, тамақтанайық!
Dialogue: 0,0:20:58.63,0:21:01.80,Default,,0,0,0,,Хиба-чан менің туған жерім, бірақ ол жатақханаға көшті.
Dialogue: 0,0:21:02.51,0:21:04.72,Default,,0,0,0,,Мен ол жерге жете алмаймын, бірақ...
Dialogue: 0,0:21:05.13,0:21:06.68,Default,,0,0,0,,Менде әлі лицензия жоқ.
Dialogue: 0,0:21:07.26,0:21:08.18,Default,,0,0,0,,Охана-чан —
Dialogue: 0,0:21:08.26,0:21:11.06,Default,,0,0,0,,Неліктен Гавайидің орнына осында билеуді шештіңіз?
Dialogue: 0,0:21:11.72,0:21:15.77,Default,,0,0,0,,Гавайи бишілерінің барлығы ұзын және сәнді.
Dialogue: 0,0:21:16.23,0:21:19.52,Default,,0,0,0,,Бірақ бұл жерде кішкентай болса да, жарайды~
Dialogue: 0,0:21:21.61,0:21:24.49,Default,,0,0,0,,Ал, мен өтемін.
Dialogue: 0,0:21:27.70,0:21:29.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:38.84,0:21:40.88,Default,,0,0,0,,Канканға не істеуім керек?
Dialogue: 0,0:21:41.34,0:21:42.21,Default,,0,0,0,,Болады ма?
Dialogue: 0,0:21:42.59,0:21:44.34,Default,,0,0,0,,Өйткені Камакура мырза канна.
Dialogue: 0,0:21:44.84,0:21:46.88,Default,,0,0,0,,Өйткені мен Ранкомын, Ранранмын
Dialogue: 0,0:21:49.43,0:21:50.68,Default,,0,0,0,,Бұл панда емес.
Dialogue: 0,0:21:57.19,0:21:59.73,Default,,0,0,0,,А, Ширасава-сан? бөлме?
Dialogue: 0,0:22:00.23,0:22:02.57,Default,,0,0,0,,А, мен велосипедпен шықтым.
Dialogue: 0,0:22:02.82,0:22:04.94,Default,,0,0,0,,Дүкеннен түскі ас қорабын сатып алмайсыз ба?
Dialogue: 0,0:22:05.24,0:22:06.03,Default,,0,0,0,,Е...
Dialogue: 0,0:22:09.12,0:22:11.45,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:22:12.12,0:22:13.87,Default,,0,0,0,,Жақын жерде ыңғайлы дүкен болды ма?
Dialogue: 0,0:22:14.25,0:22:16.33,Default,,0,0,0,,Велосипедпен шамамен 10 минут?
Dialogue: 0,0:22:17.83,0:22:20.88,Default,,0,0,0,,Мен кеше супермаркетте дүкен аралауға бардым.
Dialogue: 0,0:22:21.75,0:22:25.01,Default,,0,0,0,,А, мен көкөністерді микротолқынды пеште пісірдім.
Dialogue: 0,0:22:25.09,0:22:26.63,Default,,0,0,0,,Бұл тамақ пісіріп жатқан жоқ.
Dialogue: 0,0:22:26.72,0:22:28.34,Default,,0,0,0,,Өйткені маған айтқаныңды қаламаймын!
Dialogue: 0,0:22:29.14,0:22:31.39,Default,,0,0,0,,Бізде әлі күріш бар, оны неге жемейсің?
Dialogue: 0,0:22:31.72,0:22:35.14,Default,,0,0,0,,Акита да күріш өндіретін аймақ, бірақ мұндағы күріш те дәмді.
Dialogue: 0,0:22:35.77,0:22:38.31,Default,,0,0,0,,Түнде көмірсу жемеуге тырысамын.
Dialogue: 0,0:22:38.60,0:22:40.31,Default,,0,0,0,,Cancan Professional
Dialogue: 0,0:22:41.19,0:22:44.94,Default,,0,0,0,,Стильді және физикалық күйді сақтау - сіздің жұмысыңыздың бір бөлігі, солай емес пе?
Dialogue: 0,0:22:45.19,0:22:48.95,Default,,0,0,0,,Үш айдан кейін мен алғаш рет сахнаға шығамын!
Dialogue: 0,0:22:51.07,0:22:53.45,Default,,0,0,0,,Хиба-чан, сенің әлі үш айың бар.
Dialogue: 0,0:22:53.87,0:22:55.29,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:23:21.35,0:23:22.02,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:23:24.82,0:23:25.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:38.41,0:23:39.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:45.17,0:23:45.84,Default,,0,0,0,,Ха...
Dialogue: 0,0:23:50.42,0:23:51.43,Default,,0,0,0,,Қазір тұр!
Dialogue: 0,0:23:51.84,0:23:52.84,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:23:59.10,0:24:02.98,Default,,0,0,0,,Жоқ, мен өзімді өмірде сәтсіздікке ұшырағандай сезінемін.
Dialogue: 0,0:24:03.27,0:24:05.73,Default,,0,0,0,,Мен ол жаққа барған сайын есіме түседі.
Dialogue: 0,0:24:06.19,0:24:09.24,Default,,0,0,0,,Таңдаған оқу орнына түспегендер ғана жиналатын орын.
Dialogue: 0,0:24:09.74,0:24:11.53,Default,,0,0,0,,Кейбір жоғары сынып оқушылары өте ақылды!
Dialogue: 0,0:24:11.61,0:24:13.41,Default,,0,0,0,,Накодан кіші... иә?
Dialogue: 0,0:24:13.49,0:24:14.62,Default,,0,0,0,,Куу~!
Dialogue: 0,0:24:15.28,0:24:16.78,Default,,0,0,0,,Мендікін жеуге болады.
Dialogue: 0,0:24:16.95,0:24:18.37,Default,,0,0,0,,Не десең де жеймін.
Dialogue: 0,0:24:24.71,0:24:25.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:26.00,0:24:29.51,Default,,0,0,0,,Не? Хива таңдалды, солай ма?
Dialogue: 0,0:24:29.76,0:24:32.30,Default,,0,0,0,,А... Қызық, сізді неге таңдады?
Dialogue: 0,0:24:33.30,0:24:34.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:34.93,0:24:38.35,Default,,0,0,0,,Менен басқаның бәрі хула биімен айналысады.
Dialogue: 0,0:24:39.10,0:24:40.47,Default,,0,0,0,,Бірақ бұл мен ғана...
Dialogue: 0,0:24:42.06,0:24:46.19,Default,,0,0,0,,Менің өтуіме үлкен әпкем себеп болған шығар...
Dialogue: 0,0:24:50.07,0:24:51.74,Default,,0,0,0,,Мен сол жерде билеп жүргендіктен...
Dialogue: 0,0:24:54.66,0:24:55.91,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:24:56.20,0:24:59.49,Default,,0,0,0,,Созыңыз! Олар оны өсіру үшін сатып алғанына сенімдімін.
Dialogue: 0,0:25:00.70,0:25:01.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:02.33,0:25:04.04,Default,,0,0,0,,Қараңдар, күнді жеп, оны да жеңдер.
Dialogue: 0,0:25:08.46,0:25:09.25,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:25:09.71,0:25:10.76,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:25:13.67,0:25:16.55,Default,,0,0,0,,Менің басым айналып кетті...
Dialogue: 0,0:25:18.35,0:25:22.35,Default,,0,0,0,,(Смартфоннан ойналатын ән)
Dialogue: 0,0:25:23.94,0:25:24.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:25.19,0:25:26.10,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:25:34.49,0:25:36.91,Default,,0,0,0,,Бұл хула биі емес...
Dialogue: 0,0:25:37.45,0:25:39.20,Default,,0,0,0,,Кезбе би…
Dialogue: 0,0:25:46.87,0:25:47.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:56.22,0:25:57.13,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:25:59.93,0:26:01.31,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:26:02.64,0:26:03.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:04.81,0:26:05.52,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:26:06.69,0:26:07.44,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:26:08.02,0:26:10.06,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:26:10.94,0:26:12.15,Default,,0,0,0,,Кеш болды!
Dialogue: 0,0:26:12.98,0:26:15.15,Default,,0,0,0,,Бұл кезең болса ше?
Dialogue: 0,0:26:19.91,0:26:23.70,Default,,0,0,0,,Сіз уақытында дайын болмадыңыз, сондықтан кешігіп келген жалғыз сіз болдыңыз.
Dialogue: 0,0:26:24.25,0:26:26.33,Default,,0,0,0,,Бұл кешірім сұрауға болатын нәрсе ме?
Dialogue: 0,0:26:28.71,0:26:30.88,Default,,0,0,0,,Өзін-өзі басқара алмайтын адамдар...
Dialogue: 0,0:26:31.38,0:26:33.96,Default,,0,0,0,,Бұдан былай сіз күн сайын сахнада тұра аласыз ба?
Dialogue: 0,0:26:35.13,0:26:37.80,Default,,0,0,0,,Жазда температура 40 градустан жоғары болуы мүмкін.
Dialogue: 0,0:26:38.13,0:26:40.68,Default,,0,0,0,,Қыста сыртта және сыртта үлкен температура айырмашылығы болады.
Dialogue: 0,0:26:41.22,0:26:42.72,Default,,0,0,0,,Мұндай ортада—
Dialogue: 0,0:26:43.01,0:26:45.52,Default,,0,0,0,,Әр адам жылына 300 кезең жасайды.
Dialogue: 0,0:26:47.73,0:26:51.44,Default,,0,0,0,,Біз жұмыс ретінде билейміз. Көбірек хабардар болыңыз!
Dialogue: 0,0:26:55.69,0:26:57.95,Default,,0,0,0,,Бірінші кезеңдегі би жаттығуы:
Dialogue: 0,0:26:58.03,0:26:59.91,Default,,0,0,0,,Мен Пуара Аямеден қарауын сұраймын.
Dialogue: 0,0:27:00.87,0:27:02.70,Default,,0,0,0,,Мен мұның бәрін қазір сынап көремін, бірақ...
Dialogue: 0,0:27:03.08,0:27:05.37,Default,,0,0,0,,Біріншіден, денеңізге барлық тербелістерді енгізіңіз.
Dialogue: 0,0:27:06.16,0:27:10.67,Default,,0,0,0,,Көзіңізді, құлағыңызды, басыңызды және бүкіл денеңізді толық пайдаланыңыз.
Dialogue: 0,0:27:11.96,0:27:12.96,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:27:13.54,0:27:14.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:27:14.84,0:27:16.71,Default,,0,0,0,,(Компоненттен орындалатын ән)
Dialogue: 0,0:27:16.84,0:27:18.13,Default,,0,0,0,,Иә Иә Иә Иә…
Dialogue: 0,0:27:30.23,0:27:31.60,Default,,0,0,0,,Иә Иә Иә Иә…
Dialogue: 0,0:27:38.32,0:27:39.90,Default,,0,0,0,,Саусағыңыздың ұшына мұқият қараңыз
Dialogue: 0,0:27:40.15,0:27:41.61,Default,,0,0,0,,Биде деталь жоқ!
Dialogue: 0,0:27:46.91,0:27:48.70,Default,,0,0,0,,Барлық билер сондай көңілді!
Dialogue: 0,0:27:48.91,0:27:51.12,Default,,0,0,0,,«Ылғалды» деп сипаттаудың жолы бар емес пе?
Dialogue: 0,0:27:52.21,0:27:54.38,Default,,0,0,0,,Биіңді тым көп билейсің
Dialogue: 0,0:27:54.46,0:27:55.59,Default,,0,0,0,,Айналаңызды сәйкестендіріңіз!
Dialogue: 0,0:27:56.50,0:27:59.09,Default,,0,0,0,,Күлімсіре! Сіз әрқашан күліп жүресіз!
Dialogue: 0,0:28:01.13,0:28:04.80,Default,,0,0,0,,Қадам! Бел! Қол қозғалысы! поза!
Dialogue: 0,0:28:04.89,0:28:07.77,Default,,0,0,0,,Барлығы ыңғайсыз. Қаттырақ билеңіз!
Dialogue: 0,0:29:13.91,0:29:15.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:16.08,0:29:18.59,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:29:28.60,0:29:29.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:32.39,0:29:33.98,Default,,0,0,0,,Мен дұрыс билей алмаймын
Dialogue: 0,0:29:34.98,0:29:37.48,Default,,0,0,0,,Мен билей алмаймын... Мен билей алмаймын!
Dialogue: 0,0:29:37.81,0:29:39.61,Default,,0,0,0,,Ха...
Dialogue: 0,0:29:40.27,0:29:40.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:42.61,0:29:47.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:29:50.66,0:29:51.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:55.50,0:29:56.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:30:02.13,0:30:04.01,Default,,0,0,0,,Гяаа! (Ранко) Гяаааа!
Dialogue: 0,0:30:06.13,0:30:06.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:07.47,0:30:09.76,Default,,0,0,0,,Ранран? Охана-чан?
Dialogue: 0,0:30:10.26,0:30:11.47,Default,,0,0,0,,Хиба-чан?
Dialogue: 0,0:30:11.68,0:30:13.89,Default,,0,0,0,,Ақыр аяғында бұл сискин болды~
Dialogue: 0,0:30:13.97,0:30:15.60,Default,,0,0,0,,Түсіндім~
Dialogue: 0,0:30:16.02,0:30:18.94,Default,,0,0,0,,Ранран сабақ өтетін жерде елес бар дейді.
Dialogue: 0,0:30:19.02,0:30:22.27,Default,,0,0,0,,А... кешіріңіз, мен электр қуатын үнемдеуге тырыстым.
Dialogue: 0,0:30:22.69,0:30:25.65,Default,,0,0,0,,Егер жаттығуға баратын болсаңыз, маған айтуыңыз керек еді.
Dialogue: 0,0:30:25.74,0:30:27.82,Default,,0,0,0,,Біз де мұны әлі жасаған жоқпыз.
Dialogue: 0,0:30:29.37,0:30:33.24,Default,,0,0,0,,Аа, бірақ мен жете алмаған деңгей бар...
Dialogue: 0,0:30:33.58,0:30:35.00,Default,,0,0,0,,Барлығы үнемі хуламен айналысты...
Dialogue: 0,0:30:35.08,0:30:38.92,Default,,0,0,0,,Осы сияқты сөздерді айтудан гөрі, аз да болса жаттығу тезірек болар еді.
Dialogue: 0,0:30:42.09,0:30:43.92,Default,,0,0,0,,Мен менеджер Тайра мырзадан естідім.
Dialogue: 0,0:30:44.71,0:30:48.09,Default,,0,0,0,,Соңғы кезде әр түнде түн ортасында біреу сабақ беріп жатқан сияқты.
Dialogue: 0,0:30:49.13,0:30:53.76,Default,,0,0,0,,Сұхбат барысында сізден өтініш беруге мотивацияңыз туралы сұрақ қойылды, сіз осылай дедіңіз, солай емес пе?
Dialogue: 0,0:30:53.93,0:30:54.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:56.14,0:30:58.10,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:30:58.81,0:31:02.31,Default,,0,0,0,,Сізге өтініш беруге не түрткі болды...
Dialogue: 0,0:31:03.73,0:31:06.86,Default,,0,0,0,,Себебі мен сенің күлгеніңді қалаймын...
Dialogue: 0,0:31:07.40,0:31:09.41,Default,,0,0,0,,Менің билеп жатқаныма қара
Dialogue: 0,0:31:09.49,0:31:12.12,Default,,0,0,0,,Күнбағыстай күлімдегеніңді қалаймын.
Dialogue: 0,0:31:12.70,0:31:14.79,Default,,0,0,0,,Күнбағыс сияқты күлімсіреу дегеніміз не?
Dialogue: 0,0:31:14.99,0:31:17.66,Default,,0,0,0,,Не? А, бұл...
Dialogue: 0,0:31:20.29,0:31:23.88,Default,,0,0,0,,Ей, сенде күлкі бар...
Dialogue: 0,0:31:26.13,0:31:27.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:30.84,0:31:32.22,Default,,0,0,0,,Қарап отырғандарға —
Dialogue: 0,0:31:32.51,0:31:34.31,Default,,0,0,0,,Менің осылай күлгенімді қалайсың, солай ма?
Dialogue: 0,0:31:35.60,0:31:39.31,Default,,0,0,0,,Менің дағдыларым әлі де басқа табысты үміткерлерден төмен болса да...
Dialogue: 0,0:31:39.73,0:31:41.77,Default,,0,0,0,,Сіз бұл сезімді жеткізе аласыз, солай ма?
Dialogue: 0,0:31:44.19,0:31:45.23,Default,,0,0,0,,Жарықты қосыңыз
Dialogue: 0,0:31:45.40,0:31:46.23,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:31:48.99,0:31:49.78,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:31:49.90,0:31:51.20,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:32:09.63,0:32:11.59,Default,,0,0,0,,Менің балам бүгін шығады.
Dialogue: 0,0:32:11.68,0:32:12.76,Default,,0,0,0,,Әке!
Dialogue: 0,0:32:12.84,0:32:14.39,Default,,0,0,0,,(Хула биі)
Dialogue: 0,0:32:14.51,0:32:18.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:32:22.56,0:32:23.23,Default,,0,0,0,,Әй!
Dialogue: 0,0:32:25.48,0:32:27.44,Default,,0,0,0,,Ранранның ерін далабы шығып тұр
Dialogue: 0,0:32:27.52,0:32:28.90,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:32:29.99,0:32:31.53,Default,,0,0,0,,Охана-чан және керісінше
Dialogue: 0,0:32:32.20,0:32:33.66,Default,,0,0,0,,Aore!
Dialogue: 0,0:32:35.03,0:32:37.12,Default,,0,0,0,,Ширасава мырза ше? (Ранко) Иә?
Dialogue: 0,0:32:39.70,0:32:40.83,Default,,0,0,0,,Ширасава мырза?
Dialogue: 0,0:32:41.33,0:32:43.54,Default,,0,0,0,,Мен бұған қосылғым келеді... (Хиба) Иә?
Dialogue: 0,0:32:45.29,0:32:46.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:47.17,0:32:48.71,Default,,0,0,0,,Не істеп жатырсың! Басталып жатыр
Dialogue: 0,0:32:49.05,0:32:51.26,Default,,0,0,0,,Мен КоКо Ниге қосылып билеймін.
Dialogue: 0,0:32:51.34,0:32:53.51,Default,,0,0,0,,Ширасава мырза... (Ранко) Тезірек!
Dialogue: 0,0:32:55.05,0:32:56.26,Default,,0,0,0,,Фаааай!
Dialogue: 0,0:32:58.43,0:32:59.10,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:32:59.47,0:33:02.35,Default,,0,0,0,,Тұтынушылар сіздің алаңдаулы екеніңізді көргісі келмейді.
Dialogue: 0,0:33:03.14,0:33:05.73,Default,,0,0,0,,Сеніммен және күлімдеп билеңіз.
Dialogue: 0,0:33:08.90,0:33:11.49,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:33:11.57,0:33:14.03,Default,,0,0,0,,Жаңадан келгендер, Уау!
Dialogue: 0,0:33:16.57,0:33:18.24,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:33:18.87,0:33:22.08,Default,,0,0,0,,Енді бұл биылғы жаңадан келгендер үшін дебюттік кезең.
Dialogue: 0,0:33:23.12,0:33:24.67,Default,,0,0,0,,Иә, жүр!
Dialogue: 0,0:33:24.87,0:33:26.17,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:33:35.72,0:33:36.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:41.22,0:33:43.06,Default,,0,0,0,,Онда Хиуа (әке) ах
Dialogue: 0,0:33:43.93,0:33:45.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:33:51.23,0:33:52.94,Default,,0,0,0,,Сәлем... Хиба-чан юбка!
Dialogue: 0,0:33:56.36,0:33:57.03,Default,,0,0,0,,Эй!
Dialogue: 0,0:33:57.24,0:33:59.91,Default,,0,0,0,,Әпкеңнің бөксесінде бірдеңе бар!
Dialogue: 0,0:33:59.99,0:34:00.66,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:34:10.17,0:34:11.42,Default,,0,0,0,,Бұл ілгіш!
Dialogue: 0,0:34:11.50,0:34:14.42,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:34:49.79,0:34:56.80,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:34:58.93,0:35:01.64,Default,,0,0,0,,Сіз өткен күні сонда бардыңыз, солай ма? Гавайлықтар
Dialogue: 0,0:35:03.47,0:35:05.64,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:35:06.02,0:35:07.64,Default,,0,0,0,,Хиба-чан, қалай болды?
Dialogue: 0,0:35:07.73,0:35:09.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:09.81,0:35:11.44,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:35:11.52,0:35:13.02,Default,,0,0,0,,Сіз дұрыс биледіңіз бе?
Dialogue: 0,0:35:17.32,0:35:19.49,Default,,0,0,0,,Иә! Бұлай қысқартпаңыз
Dialogue: 0,0:35:19.70,0:35:21.37,Default,,0,0,0,,Ах, кешіріңіз!
Dialogue: 0,0:35:35.38,0:35:37.67,Default,,0,0,0,,Біріншіден, бұл қорқынышты дебют болды.
Dialogue: 0,0:35:39.84,0:35:40.63,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:35:41.13,0:35:43.14,Default,,0,0,0,,Әр адам қателеседі...
Dialogue: 0,0:35:43.55,0:35:45.10,Default,,0,0,0,,Бұл сіз айта алатын нәрсе емес.
Dialogue: 0,0:35:45.18,0:35:45.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:46.43,0:35:49.02,Default,,0,0,0,,Ең болмағанда барлығын күлкіге айналдыра алдық.
Dialogue: 0,0:35:49.31,0:35:51.60,Default,,0,0,0,,Мен тіпті жаңа лақап ат алдым!
Dialogue: 0,0:35:52.15,0:35:54.90,Default,,0,0,0,,Дұрыс, «Фушиги-чан» болып өзгертілді...
Dialogue: 0,0:35:58.07,0:35:59.70,Default,,0,0,0,,Әлгі қыз, Хунгер-чан!
Dialogue: 0,0:36:01.41,0:36:02.16,Default,,0,0,0,,«Аш-чан»
Dialogue: 0,0:36:03.62,0:36:04.78,Default,,0,0,0,,Сонымен қатар, «Нох маскасы қыз»
Dialogue: 0,0:36:05.74,0:36:07.08,Default,,0,0,0,,«Сүйген биші»
Dialogue: 0,0:36:07.45,0:36:11.42,Default,,0,0,0,,Сол үш адам, жүздерінде күлкі билеген екі жақсы адам болды.
Dialogue: 0,0:36:12.08,0:36:12.96,Default,,0,0,0,,«Қорқынышты»
Dialogue: 0,0:36:13.79,0:36:15.59,Default,,0,0,0,,Қорқынышты! Қорқынышты!
Dialogue: 0,0:36:16.17,0:36:16.84,Default,,0,0,0,,Noh маскасы…
Dialogue: 0,0:36:17.55,0:36:18.34,Default,,0,0,0,,Досукой...
Dialogue: 0,0:36:19.17,0:36:20.42,Default,,0,0,0,,Аш-чан...
Dialogue: 0,0:36:21.17,0:36:23.89,Default,,0,0,0,,Жақсы сөзбен айтқанда, бұл ең бірегей нәрсе.
Dialogue: 0,0:36:24.39,0:36:25.39,Default,,0,0,0,,Түсінікті болу үшін—
Dialogue: 0,0:36:25.93,0:36:29.47,Default,,0,0,0,,Ең көңілі қалған жаңадан келгендер...
Dialogue: 0,0:36:29.73,0:36:31.73,Default,,0,0,0,,Бұндай нәрселерді көру жақсы емес.
Dialogue: 0,0:36:32.02,0:36:33.48,Default,,0,0,0,,«Ня~» деуді доғарыңыз!
Dialogue: 0,0:36:33.73,0:36:35.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:36:39.07,0:36:41.36,Default,,0,0,0,,Менің хула клубымдағы достарым мен жасөспірімдерім—
Dialogue: 0,0:36:41.65,0:36:43.07,Default,,0,0,0,,Бұл бейнені көріп отырғаныңызға сенімдімін
Dialogue: 0,0:36:44.07,0:36:46.12,Default,,0,0,0,,Мені осында қабылдағанын естігенде...
Dialogue: 0,0:36:46.58,0:36:50.79,Default,,0,0,0,,Барлығы Hula Dance Koshien-де жеңіске жеткенімізге қарағанда бақыттырақ болды.
Dialogue: 0,0:36:51.71,0:36:54.00,Default,,0,0,0,,Бір-бірімізден алшақ болсақ та, біз сізді әлі де іздейміз
Dialogue: 0,0:36:55.29,0:36:58.46,Default,,0,0,0,,Жазғы каникулда сахнаны көруге келетінін айтады...
Dialogue: 0,0:37:01.42,0:37:05.43,Default,,0,0,0,,Бірақ егер олай болса... Мен сізден мені көруге шақыра алмаймын.
Dialogue: 0,0:37:10.97,0:37:12.52,Default,,0,0,0,,E maikai
Dialogue: 0,0:37:13.52,0:37:14.77,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:37:15.10,0:37:15.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:25.91,0:37:28.87,Default,,0,0,0,,Уайымдамаңыз, бұл аралық бақылау сияқты.
Dialogue: 0,0:37:29.20,0:37:31.58,Default,,0,0,0,,Шуды босаңсу... Шуды босаңсу...
Dialogue: 0,0:37:31.66,0:37:33.50,Default,,0,0,0,,Не? Мен... Мен сөйлей алмаймын.
Dialogue: 0,0:37:33.66,0:37:35.04,Default,,0,0,0,,Мен қобалжыдым!
Dialogue: 0,0:37:35.12,0:37:35.79,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:37:36.46,0:37:38.59,Default,,0,0,0,,Менеджер Бұл менмін, солай ма?
Dialogue: 0,0:37:38.96,0:37:40.30,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:37:41.96,0:37:43.17,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:37:43.47,0:37:44.80,Default,,0,0,0,,Енді хуладан бастайық.
Dialogue: 0,0:37:50.76,0:37:54.39,Default,,0,0,0,,Бишілер жарты жылда бір рет бағаланады
Dialogue: 0,0:37:55.31,0:37:57.19,Default,,0,0,0,,Нұсқаушылар алдында—
Dialogue: 0,0:37:57.31,0:38:00.86,Default,,0,0,0,,Бір хула әні, бір Таити би әні—
Dialogue: 0,0:38:01.65,0:38:05.53,Default,,0,0,0,,Олардың нәтижелерін және тұрақты кезеңдердегі көрсеткіштерін қараңыз...
Dialogue: 0,0:38:07.74,0:38:10.45,Default,,0,0,0,,Барлығына рейтинг қоюға болады.
Dialogue: 0,0:38:13.83,0:38:17.83,Default,,0,0,0,,Мен әлі де жаңадан келген маман болғандықтан, жоғары орындарда аға буын өкілдері тұрады.
Dialogue: 0,0:38:19.17,0:38:21.21,Default,,0,0,0,,Бағалау наурыз айында да өтеді
Dialogue: 0,0:38:21.80,0:38:24.51,Default,,0,0,0,,Нәтижеден гөрі өзіңізді қанағаттандыру үшін бар күшіңізді салыңыз
Dialogue: 0,0:38:24.92,0:38:26.59,Default,,0,0,0,,Биле, биле!
Dialogue: 0,0:38:27.97,0:38:28.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:28.72,0:38:31.39,Default,,0,0,0,,Аа, сіз одан да қатты толқып кеттіңіз бе? Хахаха...
Dialogue: 0,0:38:32.64,0:38:33.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:00.88,0:39:05.76,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:39:07.26,0:39:07.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:10.39,0:39:12.35,Default,,0,0,0,,Амансың ба? Өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:39:12.80,0:39:13.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:15.18,0:39:16.81,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:39:20.60,0:39:21.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:29.78,0:39:30.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:49.17,0:39:51.13,Default,,0,0,0,,Бәлкім, мен оған қарсы емеспін
Dialogue: 0,0:39:52.26,0:39:54.35,Default,,0,0,0,,Бұл барлығына қиындық туғызуда...
Dialogue: 0,0:39:55.81,0:39:58.18,Default,,0,0,0,,Күлімсіре, күл (Хиба) А?
Dialogue: 0,0:39:58.85,0:40:00.94,Default,,0,0,0,,Кокоо~ Коко Коко
Dialogue: 0,0:40:01.10,0:40:03.11,Default,,0,0,0,,Ху... (КоКо Ни-сан) Ах~ Гульп
Dialogue: 0,0:40:03.23,0:40:04.86,Default,,0,0,0,,Хе... э... ә?
Dialogue: 0,0:40:05.23,0:40:06.32,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:40:06.82,0:40:09.15,Default,,0,0,0,,Күлімде, күлімде
Dialogue: 0,0:40:10.28,0:40:12.78,Default,,0,0,0,,Гү…
Dialogue: 0,0:40:13.99,0:40:15.70,Default,,0,0,0,,Не болды? Нацунаги-сан
Dialogue: 0,0:40:17.49,0:40:20.75,Default,,0,0,0,,Шуш, шуш, шуш... сөйледі.
Dialogue: 0,0:40:21.58,0:40:22.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:26.34,0:40:27.38,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:40:31.55,0:40:32.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:34.30,0:40:35.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:35.76,0:40:36.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:40:42.73,0:40:45.19,Default,,0,0,0,,Егер сіз топта болсаңыз, бір қатарға тұрыңыз.
Dialogue: 0,0:40:45.73,0:40:47.86,Default,,0,0,0,,Өнімді сатудың соңы осы жерден болады.
Dialogue: 0,0:40:48.57,0:40:50.78,Default,,0,0,0,,Әрбір кассаға арналған баған
Dialogue: 0,0:40:50.99,0:40:52.86,Default,,0,0,0,,Егер сіз топта болсаңыз, бір қатарға тұрыңыз.
Dialogue: 0,0:40:53.28,0:40:55.41,Default,,0,0,0,,Жоқ, мен билет алдым.
Dialogue: 0,0:40:55.49,0:40:58.12,Default,,0,0,0,,Бұл өте көп орын, Нако, ол дайындық мектебінің оқушысы болса да.
Dialogue: 0,0:40:58.20,0:40:59.20,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:41:00.70,0:41:01.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:41:02.00,0:41:04.37,Default,,0,0,0,,Негізі, мен де гавайлықтарға барғым келеді.
Dialogue: 0,0:41:04.46,0:41:05.17,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:41:05.58,0:41:06.92,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:41:07.21,0:41:09.75,Default,,0,0,0,,Мен қазір келмегенім жөн...
Dialogue: 0,0:41:09.84,0:41:10.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:11.05,0:41:12.30,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:41:14.18,0:41:16.64,Default,,0,0,0,,Күн сайын кешке дейін өз бетімше жаттығамын.
Dialogue: 0,0:41:20.47,0:41:21.18,Default,,0,0,0,,Мен де!
Dialogue: 0,0:41:21.85,0:41:25.60,Default,,0,0,0,,Сынақ емтиханнан кейінгі сынақ Сынақ емтиханнан кейінгі сынақ емтихан...
Dialogue: 0,0:41:26.31,0:41:27.31,Default,,0,0,0,,Уф
Dialogue: 0,0:41:27.86,0:41:30.73,Default,,0,0,0,,Мен... бәріне қиын, солай емес пе?
Dialogue: 0,0:41:31.40,0:41:33.03,Default,,0,0,0,,Хиба күнде сахнада ма?
Dialogue: 0,0:41:33.45,0:41:35.45,Default,,0,0,0,,Иә?Мм... иә
Dialogue: 0,0:41:35.66,0:41:37.62,Default,,0,0,0,,Мен бір ғана әнге билеймін
Dialogue: 0,0:41:38.20,0:41:41.16,Default,,0,0,0,,Би билеп, ақы алған жақсы.
Dialogue: 0,0:41:42.20,0:41:42.87,Default,,0,0,0,,Хехе...
Dialogue: 0,0:41:43.29,0:41:47.00,Default,,0,0,0,,Жеңілгеннің ініне ұқсамайтын жарық жұмыс орны.
Dialogue: 0,0:41:47.25,0:41:48.92,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:41:51.63,0:41:55.01,Default,,0,0,0,,А, бірақ менде әлі сабақтар бар, сондықтан қиын, солай емес пе?
Dialogue: 0,0:41:55.09,0:41:57.18,Default,,0,0,0,,Басқалардың демалатын күндерінің өзінде де жұмыс істеуге тура келеді.
Dialogue: 0,0:42:00.22,0:42:02.81,Default,,0,0,0,,Бірақ сен мені шақыруға қиналмай,
Dialogue: 0,0:42:02.89,0:42:04.60,Default,,0,0,0,,Бүгін өте қызықты болады!
Dialogue: 0,0:42:04.77,0:42:05.44,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:42:05.52,0:42:08.19,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,0:42:08.52,0:42:11.23,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,0:42:11.65,0:42:14.24,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,0:42:14.69,0:42:17.11,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,0:42:18.24,0:42:23.33,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:42:30.09,0:42:32.71,Default,,0,0,0,,♪Күнде бір көрініс
Dialogue: 0,0:42:33.00,0:42:35.88,Default,,0,0,0,,♪Күнделікті заттарды жинасаң
Dialogue: 0,0:42:36.13,0:42:38.68,Default,,0,0,0,,♪Жүрегім кенет біртүрлі болып кетті
Dialogue: 0,0:42:38.80,0:42:42.10,Default,,0,0,0,,♪Мен оны сондай сүйкімді деп ойладым
Dialogue: 0,0:42:42.22,0:42:45.31,Default,,0,0,0,,♪Тіпті кездейсоқ нәрселерде және заттар ағып жатқанда
Dialogue: 0,0:42:45.73,0:42:46.81,Default,,0,0,0,,♪Мағынасы бар, солай ма?
Dialogue: 0,0:42:46.94,0:42:48.31,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,0:42:48.40,0:42:51.52,Default,,0,0,0,,♪Сізбен кездесіп, бір-біріңізді түсіну
Dialogue: 0,0:42:51.65,0:42:53.11,Default,,0,0,0,,♪Бұл қазына
Dialogue: 0,0:42:53.23,0:42:54.61,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,0:42:54.73,0:42:57.24,Default,,0,0,0,,♪Көңіл күйде немесе күйзелгенде
Dialogue: 0,0:42:57.65,0:43:00.53,Default,,0,0,0,,♪Себебі мен жалғыз емес екенімді түсіндім
Dialogue: 0,0:43:00.70,0:43:02.28,Default,,0,0,0,,♪ Қазір (Хай!) Бірден (Хай!)
Dialogue: 0,0:43:02.41,0:43:03.74,Default,,0,0,0,,♪ Суна (хай!) Они (хай!)
Dialogue: 0,0:43:03.91,0:43:07.16,Default,,0,0,0,,♪Рахмет айтқым келеді
Dialogue: 0,0:43:08.50,0:43:11.38,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,0:43:11.50,0:43:14.09,Default,,0,0,0,,♪Егер сөз жеткіліксіз болса, не істеуім керек?
Dialogue: 0,0:43:14.55,0:43:17.38,Default,,0,0,0,,♪ «Мен тірімін» сізді кездестірген қуанышпен
Dialogue: 0,0:43:17.51,0:43:20.47,Default,,0,0,0,,♪ Мен осылай ойлай алғаныма өте қуаныштымын.
Dialogue: 0,0:43:20.89,0:43:23.64,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,0:43:23.93,0:43:26.77,Default,,0,0,0,,♪Мен сені сүйетінімді түсінгенде не істеуім керек?
Dialogue: 0,0:43:26.89,0:43:29.56,Default,,0,0,0,,♪Менің күндерім тек сенің арқаңда мүмкін
Dialogue: 0,0:43:29.69,0:43:32.77,Default,,0,0,0,,♪Одан да әдемі жарқырайды
Dialogue: 0,0:43:34.15,0:43:36.53,Default,,0,0,0,,♪Уф! Ха! Ха! Ха!
Dialogue: 0,0:43:37.78,0:43:39.36,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,0:44:00.59,0:44:03.97,Default,,0,0,0,,Қайсы курорттық қонақ үй? Тұтынушы?
Dialogue: 0,0:44:04.51,0:44:05.89,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:44:06.06,0:44:08.39,Default,,0,0,0,,Гавайлықтар? Монолитті мұнара?
Dialogue: 0,0:44:08.98,0:44:10.89,Default,,0,0,0,,Гавайлықтарда (жүргізуші) Иә.
Dialogue: 0,0:44:14.19,0:44:14.90,Default,,0,0,0,,Бүгін қазірдің өзінде
Dialogue: 0,0:44:15.15,0:44:16.94,Default,,0,0,0,,Шоу мен бассейн аяқталды, солай ма?
Dialogue: 0,0:44:17.78,0:44:19.99,Default,,0,0,0,,бітті...?
Dialogue: 0,0:44:20.32,0:44:22.36,Default,,0,0,0,,Бірақ мен мұны күнде істеймін.
Dialogue: 0,0:44:22.91,0:44:25.49,Default,,0,0,0,,Күн сайын...?
Dialogue: 0,0:45:03.66,0:45:05.24,Default,,0,0,0,,Иә? Сіз...
Dialogue: 0,0:45:07.28,0:45:08.91,Default,,0,0,0,,Аа, кешіріңіз!
Dialogue: 0,0:45:13.04,0:45:14.29,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:45:14.75,0:45:16.46,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:45:24.80,0:45:27.35,Default,,0,0,0,,Жұмыс уақытынан кейінгі ғимараттың іші де әдемі, солай емес пе?
Dialogue: 0,0:45:28.43,0:45:29.60,Default,,0,0,0,,Ұсынылады
Dialogue: 0,0:45:32.48,0:45:33.44,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:45:37.27,0:45:39.61,Default,,0,0,0,,Біз мұражай жабылғаннан кейін жұмыс істейміз, сондықтан...
Dialogue: 0,0:45:39.94,0:45:41.90,Default,,0,0,0,,Мен әрқашан осының ішінде жұмыс істеймін.
Dialogue: 0,0:45:44.32,0:45:45.16,Default,,0,0,0,,Ум...
Dialogue: 0,0:45:45.78,0:45:48.66,Default,,0,0,0,,А, мен Риота Сузукакемін
Dialogue: 0,0:45:49.37,0:45:51.29,Default,,0,0,0,,Ғимарат ішінде техникалық қызмет көрсетуге жауапты.
Dialogue: 0,0:45:51.70,0:45:53.00,Default,,0,0,0,,Техникалық қызмет көрсету…
Dialogue: 0,0:45:53.16,0:45:53.83,Default,,0,0,0,,Иә
Dialogue: 0,0:45:54.25,0:45:57.46,Default,,0,0,0,,Мысалы, бассейндегі немесе ыстық бұлақтағы ыстық суды ауыстыру
Dialogue: 0,0:46:02.63,0:46:04.92,Default,,0,0,0,,Ыстық бұлақтар биіктік айырмашылығын пайдаланады —
Dialogue: 0,0:46:05.01,0:46:06.97,Default,,0,0,0,,Ыстық суды 3 сағатта өзгертуге болады.
Dialogue: 0,0:46:09.14,0:46:11.60,Default,,0,0,0,,Басқа тазалау жұмыстары (Хиуа) Хе...
Dialogue: 0,0:46:12.27,0:46:15.19,Default,,0,0,0,,Тазалау роботтары айтарлықтай белсенді.
Dialogue: 0,0:46:18.35,0:46:19.73,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:46:19.90,0:46:22.69,Default,,0,0,0,,Мен бәрі ұмытып кеткен қалтқыларды сөндіремін.
Dialogue: 0,0:46:23.19,0:46:25.24,Default,,0,0,0,,Сақтау көлемі үлкен болғандықтан
Dialogue: 0,0:46:25.32,0:46:25.99,Default,,0,0,0,,А...
Dialogue: 0,0:46:26.57,0:46:29.70,Default,,0,0,0,,Кейбір адамдар оны енді қажет етпейтіндіктен тастап кетеді.
Dialogue: 0,0:46:30.33,0:46:33.33,Default,,0,0,0,,Ауаны шығару процесі біршама уақытты алды...
Dialogue: 0,0:46:34.00,0:46:36.16,Default,,0,0,0,,Бұл... күн сайын
Dialogue: 0,0:46:36.46,0:46:37.25,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:46:37.58,0:46:40.46,Default,,0,0,0,,Балалар сендер күнде билейтіндей
Dialogue: 0,0:46:42.59,0:46:47.63,Default,,0,0,0,,Бірақ мен күн сайын ашық болатынымызға сене алмаймын және бәрі келеді...
Dialogue: 0,0:46:47.72,0:46:48.89,Default,,0,0,0,,Сіз бақыттысыз, солай емес пе?
Dialogue: 0,0:46:59.06,0:46:59.85,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:47:00.56,0:47:03.07,Default,,0,0,0,,Мұнда бір қадам бар.
Dialogue: 0,0:47:05.99,0:47:07.78,Default,,0,0,0,,Жер сілкінісі кезінде ығысқан.
Dialogue: 0,0:47:07.86,0:47:08.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:09.61,0:47:12.53,Default,,0,0,0,,Ол кезде мен компанияда үшінші курста оқитынмын.
Dialogue: 0,0:47:13.16,0:47:17.04,Default,,0,0,0,,А, мен бұл жер қазір жабылған шығар деп ойладым.
Dialogue: 0,0:47:18.71,0:47:21.29,Default,,0,0,0,,Бишілердің бәрі сахнаны пайдалана алмайды...
Dialogue: 0,0:47:21.63,0:47:23.17,Default,,0,0,0,,Ел аралап керуенге шықтым.
Dialogue: 0,0:47:24.00,0:47:28.34,Default,,0,0,0,,Жарты жыл Солтүстіктегі Аомориден оңтүстіктегі Миядзакиге дейін —
Dialogue: 0,0:47:28.88,0:47:32.55,Default,,0,0,0,,Республика бойынша 125 жерде 247 қойылым
Dialogue: 0,0:47:33.01,0:47:35.85,Default,,0,0,0,,Біздің сахнадан тыс жерде өнер көрсету –
Dialogue: 0,0:47:36.35,0:47:37.73,Default,,0,0,0,,Бұл бірінші рет болған сияқты.
Dialogue: 0,0:47:38.52,0:47:40.23,Default,,0,0,0,,Бірақ соның арқасында
Dialogue: 0,0:47:40.65,0:47:43.98,Default,,0,0,0,,Біз бизнесті қайта бастаған кезде еліміздің түкпір-түкпірінен клиенттер келді.
Dialogue: 0,0:47:44.86,0:47:47.69,Default,,0,0,0,,Мұнда би билегісі келетін бишілер де бар.
Dialogue: 0,0:47:47.78,0:47:49.24,Default,,0,0,0,,Олар еліміздің түкпір-түкпірінен келе бастады.
Dialogue: 0,0:47:53.74,0:47:55.24,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:47:55.83,0:47:58.04,Default,,0,0,0,,Қайта кездессем саған беремін деп ойладым.
Dialogue: 0,0:47:59.37,0:48:00.04,Default,,0,0,0,,Ха...
Dialogue: 0,0:48:00.92,0:48:01.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:03.67,0:48:04.34,Default,,0,0,0,,А...
Dialogue: 0,0:48:07.30,0:48:08.38,Default,,0,0,0,,Сіз оны жеңе аласыз.
Dialogue: 0,0:48:08.80,0:48:09.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:10.26,0:48:13.68,Default,,0,0,0,,Міне, сол кезде бәрі де жеңді.
Dialogue: 0,0:48:47.34,0:48:49.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:49.59,0:48:51.97,Default,,0,0,0,,А... (Ранко) Ой, қош келдіңіз.
Dialogue: 0,0:48:52.30,0:48:54.05,Default,,0,0,0,,Ранран жүгіресің бе?
Dialogue: 0,0:48:54.55,0:48:57.35,Default,,0,0,0,,Иә, менің тағамдарым негізінен көкөністерден тұрады.
Dialogue: 0,0:48:57.72,0:49:00.56,Default,,0,0,0,,Бірақ ол 300 грамм ғана жоғалтады.
Dialogue: 0,0:49:01.06,0:49:03.39,Default,,0,0,0,,Мен одан да көп тырысуым керек!
Dialogue: 0,0:49:03.85,0:49:04.98,Default,,0,0,0,,А... иә
Dialogue: 0,0:49:16.37,0:49:17.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:17.95,0:49:18.62,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:49:24.83,0:49:25.63,Default,,0,0,0,,Нико…
Dialogue: 0,0:49:25.92,0:49:26.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:31.21,0:49:33.76,Default,,0,0,0,,Күлімсіреу... Жаттығу
Dialogue: 0,0:49:33.97,0:49:34.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:35.26,0:49:40.43,Default,,0,0,0,,Бағалау: Такигава мырза жаңадан келгендер арасында үздік болды.
Dialogue: 0,0:49:41.93,0:49:44.10,Default,,0,0,0,,Би билеу шеберлігі бойынша әлі де көп жолым бар.
Dialogue: 0,0:49:44.64,0:49:46.35,Default,,0,0,0,,Ол жігерлі және күшті.
Dialogue: 0,0:49:46.98,0:49:50.65,Default,,0,0,0,,Сахнадан түскеннен кейін де күлімдеп амандасуды жалғастырдың.
Dialogue: 0,0:49:51.15,0:49:53.15,Default,,0,0,0,,Басқа қызметкерлерге...
Dialogue: 0,0:49:55.28,0:49:58.57,Default,,0,0,0,,Менің биім бағаланды, бірақ...
Dialogue: 0,0:49:59.12,0:50:01.91,Default,,0,0,0,,Бірақ бұл Биллиден екінші.
Dialogue: 0,0:50:01.99,0:50:03.45,Default,,0,0,0,,А... А?
Dialogue: 0,0:50:05.08,0:50:05.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:09.79,0:50:12.17,Default,,0,0,0,,Сәтсіздік – жаңа қадам
Dialogue: 0,0:50:15.17,0:50:18.01,Default,,0,0,0,,Жарайды, мен де бар күшімді саламын.
Dialogue: 0,0:50:18.26,0:50:18.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:19.51,0:50:20.60,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:50:22.89,0:50:23.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:28.35,0:50:30.36,Default,,0,0,0,,Егер Нацунаги-сан қолынан келгеннің бәрін жасаса...
Dialogue: 0,0:50:30.73,0:50:33.53,Default,,0,0,0,,Мен келесі бағалаудың соңында тұрмын ба?
Dialogue: 0,0:50:33.90,0:50:34.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:39.57,0:50:40.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:45.50,0:50:46.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:46.54,0:50:47.79,Default,,0,0,0,,Хахаха (Бала) Мен оны асыға күтемін.
Dialogue: 0,0:50:48.58,0:50:50.00,Default,,0,0,0,,Орталық осында, сондықтан
Dialogue: 0,0:50:50.38,0:50:51.75,Default,,0,0,0,,Ортадағы (Канна) Иә.
Dialogue: 0,0:50:54.13,0:50:55.88,Default,,0,0,0,,Барлығың да сапқа тұра аласыңдар ма?
Dialogue: 0,0:50:55.97,0:50:56.63,Default,,0,0,0,,Иә
Dialogue: 0,0:51:03.35,0:51:04.93,Default,,0,0,0,,Сәлем! сурет?
Dialogue: 0,0:51:05.60,0:51:07.02,Default,,0,0,0,,Өз позицияңызды алыңыз
Dialogue: 0,0:51:16.24,0:51:19.32,Default,,0,0,0,,Нақты орындалғанша осында күтіңіз.
Dialogue: 0,0:51:19.41,0:51:21.03,Default,,0,0,0,,Киіміңізді ауыстырыңыз.
Dialogue: 0,0:51:21.12,0:51:21.78,Default,,0,0,0,,Иә
Dialogue: 0,0:51:23.08,0:51:24.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:25.87,0:51:27.66,Default,,0,0,0,,Иә? Охана ше?
Dialogue: 0,0:51:27.75,0:51:28.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:33.54,0:51:34.30,Default,,0,0,0,,Охана-чан
Dialogue: 0,0:51:38.55,0:51:40.93,Default,,0,0,0,,Кеттік. Мен түзелуім және өзгеруім керек.
Dialogue: 0,0:51:43.01,0:51:44.81,Default,,0,0,0,,Мен үйге барғым келеді... (Ранко/Хиба) Иә?
Dialogue: 0,0:51:45.64,0:51:46.77,Default,,0,0,0,,Ерен, көрдің бе?
Dialogue: 0,0:51:48.48,0:51:50.39,Default,,0,0,0,,О, күте тұрыңыз... (Ранко) Эй...
Dialogue: 0,0:51:52.15,0:51:54.02,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:51:54.32,0:51:55.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:01.20,0:52:03.28,Default,,0,0,0,,Нақты қойылым алдында неге жүзіп жатырсың?
Dialogue: 0,0:52:03.66,0:52:05.08,Default,,0,0,0,,Қазір күз!
Dialogue: 0,0:52:05.41,0:52:06.79,Default,,0,0,0,,Сонымен мен жүздім...
Dialogue: 0,0:52:06.87,0:52:10.04,Default,,0,0,0,,Мықты болыңыз. 30 минуттан кейін сахнаға шығамыз.
Dialogue: 0,0:52:12.42,0:52:15.88,Default,,0,0,0,,Жоқ, сен бүгін КоКо-нидің костюмін киесің, солай ма?
Dialogue: 0,0:52:16.09,0:52:17.80,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:52:25.18,0:52:27.81,Default,,0,0,0,,Гавайиялық анаға ұқсайды (4 адам) Иә?
Dialogue: 0,0:52:29.27,0:52:30.18,Default,,0,0,0,,Анама...
Dialogue: 0,0:52:30.94,0:52:33.94,Default,,0,0,0,,Соңғы кездері өзіңізді жақсы сезінбей жүрсіз деп ойладым...
Dialogue: 0,0:52:34.02,0:52:34.98,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:52:37.07,0:52:39.15,Default,,0,0,0,,Мен көптен бері ұстадым, бірақ...
Dialogue: 0,0:52:39.74,0:52:41.99,Default,,0,0,0,,Теңізге қарасам, бірдеңені...
Dialogue: 0,0:52:42.45,0:52:45.16,Default,,0,0,0,,Жақсы, жақсы, өзіңді ұстап тұрудың қажеті жоқ.
Dialogue: 0,0:52:45.32,0:52:47.16,Default,,0,0,0,,Кешіріңіз, мен байқамадым.
Dialogue: 0,0:52:49.70,0:52:51.29,Default,,0,0,0,,Барлығы~ Сіз дайынсыз ба?
Dialogue: 0,0:52:51.83,0:52:54.63,Default,,0,0,0,,А-а, ә... дерлік.
Dialogue: 0,0:52:54.79,0:52:56.21,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:52:57.13,0:52:59.30,Default,,0,0,0,,Охана-чан, сен осында демалып жатырсың ба?
Dialogue: 0,0:52:59.38,0:53:00.51,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:53:00.80,0:53:03.18,Default,,0,0,0,,Бүгінгі кезең Өзіміз жасаймыз
Dialogue: 0,0:53:03.34,0:53:04.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:06.35,0:53:08.51,Default,,0,0,0,,Кешіріңіз, жарайды, мен кетемін!
Dialogue: 0,0:53:11.85,0:53:12.52,Default,,0,0,0,,Иә
Dialogue: 0,0:53:14.23,0:53:15.52,Default,,0,0,0,,(гүл шайнайтын дыбыс)
Dialogue: 0,0:53:16.86,0:53:17.86,Default,,0,0,0,,Конока-сан
Dialogue: 0,0:53:18.15,0:53:20.74,Default,,0,0,0,,Мен Иваки қаласынан келген әнші-композитормын.
Dialogue: 0,0:53:21.36,0:53:24.53,Default,,0,0,0,,Енді «Мереке» әнін айтайық.
Dialogue: 0,0:53:24.86,0:53:30.08,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:53:42.38,0:53:44.88,Default,,0,0,0,,Сондықтан сен мені жек көресің…
Dialogue: 0,0:53:45.01,0:53:47.80,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:53:53.77,0:53:54.77,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:54:01.36,0:54:02.32,Default,,0,0,0,,Отбасы?
Dialogue: 0,0:54:04.24,0:54:04.90,Default,,0,0,0,,(жөтел жөтел)
Dialogue: 0,0:54:19.59,0:54:21.71,Default,,0,0,0,,Эй... көңіліңді көтер мияу~
Dialogue: 0,0:54:22.09,0:54:23.05,Default,,0,0,0,,Не? (Ранко/Шион) Ах...
Dialogue: 0,0:54:23.26,0:54:24.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:24.76,0:54:28.09,Default,,0,0,0,,Эй... Жыласаң, макияжың ыдырап қалады~
Dialogue: 0,0:54:31.51,0:54:35.43,Default,,0,0,0,,Ал егер сіз охана болсаңыз, сіз осындасыз.
Dialogue: 0,0:54:37.48,0:54:40.52,Default,,0,0,0,,Охана гавай тілінде «отбасы» дегенді білдіреді, солай емес пе?
Dialogue: 0,0:54:41.52,0:54:43.90,Default,,0,0,0,,Бірақ менің нағыз отбасым ғана емес...
Dialogue: 0,0:54:44.44,0:54:46.70,Default,,0,0,0,,Менің достарым да мені Охана деп атайды.
Dialogue: 0,0:54:50.70,0:54:53.66,Default,,0,0,0,,Не! Мен де үнемі хуламен айналыстым.
Dialogue: 0,0:54:53.79,0:54:55.83,Default,,0,0,0,,Мен гавай тіліндегі көптеген сөздерді білемін.
Dialogue: 0,0:54:56.71,0:54:59.96,Default,,0,0,0,,«Ня~» деп 3 рет қатарынан айтудың орнына
Dialogue: 0,0:55:00.25,0:55:01.09,Default,,0,0,0,,Осылайша?
Dialogue: 0,0:55:01.34,0:55:05.30,Default,,0,0,0,,Иә! Бұдан былай мен канкан Ohana no Ohana nya жасаймын
Dialogue: 0,0:55:05.67,0:55:08.47,Default,,0,0,0,,А, мен сенің бұлай істеуіңді доғарғаныңды қалаймын!
Dialogue: 0,0:55:08.93,0:55:10.89,Default,,0,0,0,,Барлығы жақсы күлді.
Dialogue: 0,0:55:11.10,0:55:12.22,Default,,0,0,0,,Сахна да солай.
Dialogue: 0,0:55:12.35,0:55:14.60,Default,,0,0,0,,Клиенттеріңізді күлдіріңіз!
Dialogue: 0,0:55:14.89,0:55:17.06,Default,,0,0,0,,Біз комедиялық топ емеспіз.
Dialogue: 0,0:55:17.14,0:55:18.19,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:55:19.48,0:55:22.48,Default,,0,0,0,,Енді осы жылы дебют жасаған келесі.
Dialogue: 0,0:55:22.73,0:55:26.28,Default,,0,0,0,,Біздің жаңа бишілеріміздің билерін көріңіз!
Dialogue: 0,0:55:26.82,0:55:33.03,Default,,0,0,0,,(Хула биі)
Dialogue: 0,0:55:37.87,0:55:39.79,Default,,0,0,0,,(Хибэннің айқайы)
Dialogue: 0,0:55:39.92,0:55:42.13,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:55:42.96,0:55:44.50,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:55:48.88,0:55:54.89,Default,,0,0,0,,♪～
Dialogue: 0,0:55:56.93,0:56:00.27,Default,,0,0,0,,♪Мен кокос перісімін
Dialogue: 0,0:56:00.56,0:56:03.90,Default,,0,0,0,,♪ Гавайиде туып, Ивакиде өскен
Dialogue: 0,0:56:04.44,0:56:07.23,Default,,0,0,0,,♪Мен сенің күлкіңді көргім келеді
Dialogue: 0,0:56:07.61,0:56:10.74,Default,,0,0,0,,♪Бүгін де хула билеу
Dialogue: 0,0:56:11.28,0:56:14.74,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:14.95,0:56:17.91,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:19.37,0:56:22.63,Default,,0,0,0,,♪Менің арманым - үйге оралу
Dialogue: 0,0:56:22.96,0:56:26.38,Default,,0,0,0,,♪Көгілдір теңіз және ақ құмды жағажай
Dialogue: 0,0:56:26.80,0:56:29.80,Default,,0,0,0,,♪Күн нұры төгілген жұмақ
Dialogue: 0,0:56:29.97,0:56:32.97,Default,,0,0,0,,♪Бірақ мен күнге күйіп қалудан қорқамын.
Dialogue: 0,0:56:33.80,0:56:37.35,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:37.47,0:56:41.02,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:41.19,0:56:44.52,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:44.77,0:56:48.23,Default,,0,0,0,,♪Кокойо Коко Коко
Dialogue: 0,0:56:50.86,0:56:56.87,Default,,0,0,0,,～♪
Dialogue: 0,0:56:56.99,0:57:01.25,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:57:03.08,0:57:04.58,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:57:04.96,0:57:06.21,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:57:07.84,0:57:09.59,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:57:12.01,0:57:12.88,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:57:13.30,0:57:14.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:14.30,0:57:16.22,Default,,0,0,0,,Қараңдаршы... Мен қарап тұрдым.
Dialogue: 0,0:57:18.14,0:57:18.81,Default,,0,0,0,,Камакура мырза
Dialogue: 0,0:57:19.52,0:57:20.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:57:21.35,0:57:23.31,Default,,0,0,0,,Қозғалыстарың да, өрнектерің де жұмсақ болды.
Dialogue: 0,0:57:25.35,0:57:26.81,Default,,0,0,0,,Такигава-сан (Ранко) Иә!
Dialogue: 0,0:57:27.23,0:57:29.32,Default,,0,0,0,,Өрнек ауқымы кеңейді (Ранко) Ах...
Dialogue: 0,0:57:30.19,0:57:31.11,Default,,0,0,0,,Охана Иә!
Dialogue: 0,0:57:31.74,0:57:34.03,Default,,0,0,0,,Енді сіз ұқыпты қозғалыстар жасай аласыз.
Dialogue: 0,0:57:34.16,0:57:35.66,Default,,0,0,0,,А... иә
Dialogue: 0,0:57:35.74,0:57:37.74,Default,,0,0,0,,Ширасава мырза... Иә.
Dialogue: 0,0:57:38.16,0:57:40.24,Default,,0,0,0,,Сіздің CoCo-nee, қызық болды.
Dialogue: 0,0:57:41.00,0:57:43.12,Default,,0,0,0,,Енді маған күлімдеген жүзіңізді көрсетіңіз
Dialogue: 0,0:57:48.29,0:57:50.00,Default,,0,0,0,,Нацунаги-сан (Хиба) А... иә!
Dialogue: 0,0:57:50.96,0:57:53.01,Default,,0,0,0,,Мен сізге әлі өту ұпайын бере алмаймын.
Dialogue: 0,0:58:00.14,0:58:00.81,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:58:04.06,0:58:07.48,Default,,0,0,0,,Сіздің биіңіз қатты және түзу.
Dialogue: 0,0:58:07.73,0:58:09.27,Default,,0,0,0,,Қарасам күлімсірейді
Dialogue: 0,0:58:14.74,0:58:16.82,Default,,0,0,0,,Барлығы өте жақсы болды.
Dialogue: 0,0:58:18.20,0:58:19.24,Default,,0,0,0,,Эй
Dialogue: 0,0:58:21.99,0:58:22.95,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,0:58:25.21,0:58:28.67,Default,,0,0,0,,Кәсіпкерлік бөлімдегі Сузукаке мырза мені көлігіне мінгізді.
Dialogue: 0,0:58:29.13,0:58:30.63,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:58:33.30,0:58:35.17,Default,,0,0,0,,Жүр, ішіп алайық.
Dialogue: 0,0:58:35.42,0:58:37.93,Default,,0,0,0,,А... тағы да араласасың ба?
Dialogue: 0,0:58:43.35,0:58:44.48,Default,,0,0,0,,Хивахива!
Dialogue: 0,0:58:45.43,0:58:47.90,Default,,0,0,0,,Олар маған аквариум жабылғанша оны көруге рұқсат етеміз деді.
Dialogue: 0,0:58:48.15,0:58:49.27,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:58:49.56,0:58:50.81,Default,,0,0,0,,А... иә
Dialogue: 0,0:59:56.96,1:00:00.09,Default,,0,0,0,,(Отты пышақ биі)
Dialogue: 0,1:00:19.32,1:00:19.99,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:20.07,1:00:21.24,Default,,0,0,0,,Фаааай!
Dialogue: 0,1:00:21.70,1:00:23.03,Default,,0,0,0,,Мен... Мен келемін!
Dialogue: 0,1:00:29.16,1:00:30.12,Default,,0,0,0,,Өрт!
Dialogue: 0,1:00:40.88,1:00:41.59,Default,,0,0,0,,Фаааай!
Dialogue: 0,1:00:57.19,1:00:58.07,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:00:59.19,1:01:00.07,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:01:08.79,1:01:09.45,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,1:01:12.46,1:01:13.50,Default,,0,0,0,,Хааах!
Dialogue: 0,1:01:21.84,1:01:22.59,Default,,0,0,0,,Өрт!
Dialogue: 0,1:01:27.43,1:01:28.93,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:30.85,1:01:32.64,Default,,0,0,0,,Бұл қызықты болды, бірақ
Dialogue: 0,1:01:33.14,1:01:36.02,Default,,0,0,0,,Бірақ бұл менің бірінші жол жүруім үшін жақсы нәтиже болды.
Dialogue: 0,1:01:36.23,1:01:37.82,Default,,0,0,0,,Барлығы тірі.
Dialogue: 0,1:01:37.90,1:01:40.73,Default,,0,0,0,,Менің компанияма сатуға келген сақтандыру компаниясына...
Dialogue: 0,1:01:40.82,1:01:41.74,Default,,0,0,0,,Мен кіремін.
Dialogue: 0,1:01:42.03,1:01:42.95,Default,,0,0,0,,Бірақ~
Dialogue: 0,1:01:43.03,1:01:44.78,Default,,0,0,0,,Эххехе~
Dialogue: 0,1:01:53.21,1:01:54.79,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,1:02:01.71,1:02:03.92,Default,,0,0,0,,Бұл Хиба-чанның ұсынылатын жері ме?
Dialogue: 0,1:02:04.80,1:02:05.47,Default,,0,0,0,,Иә
Dialogue: 0,1:02:05.76,1:02:09.26,Default,,0,0,0,,Мен лицензия алған кезде барлығын осында әкелгім келеді.
Dialogue: 0,1:02:09.51,1:02:10.47,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:02:10.93,1:02:12.31,Default,,0,0,0,,Мен мінгім келеді
Dialogue: 0,1:02:13.98,1:02:15.19,Default,,0,0,0,,Басуға болады
Dialogue: 0,1:02:15.31,1:02:16.40,Default,,0,0,0,,Құлап қалма
Dialogue: 0,1:02:19.06,1:02:20.23,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:20.94,1:02:21.65,Default,,0,0,0,,Уау...
Dialogue: 0,1:02:21.86,1:02:22.82,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,1:02:24.49,1:02:26.49,Default,,0,0,0,,Күшті бола алады!
Dialogue: 0,1:02:26.70,1:02:28.28,Default,,0,0,0,,Эй... ашуланба!
Dialogue: 0,1:02:33.29,1:02:33.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:37.79,1:02:38.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:04.86,1:03:06.74,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:03:16.00,1:03:17.41,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:44.02,1:03:45.65,Default,,0,0,0,,Мен де мұздатылған мочи пісірдім
Dialogue: 0,1:03:45.82,1:03:46.86,Default,,0,0,0,,Шимимочи?
Dialogue: 0,1:03:47.07,1:03:49.99,Default,,0,0,0,,Күріш тортын суға салып, мұздатыңыз.
Dialogue: 0,1:03:50.07,1:03:51.87,Default,,0,0,0,,Суық желге ұшыраған
Dialogue: 0,1:03:51.99,1:03:55.70,Default,,0,0,0,,Тіпті күріш торттары қатал ортаға төтеп беріп, дәмді болады.
Dialogue: 0,1:03:55.79,1:03:57.54,Default,,0,0,0,,Жүр, же, же.
Dialogue: 0,1:03:57.87,1:03:59.71,Default,,0,0,0,,Итадакимасу
Dialogue: 0,1:04:06.05,1:04:07.21,Default,,0,0,0,,Не, оны киесің бе?
Dialogue: 0,1:04:07.30,1:04:08.42,Default,,0,0,0,,Не, маған телефон соқпайсың ба?
Dialogue: 0,1:04:08.51,1:04:10.18,Default,,0,0,0,,Біз де бәріне майонезді саламыз.
Dialogue: 0,1:04:10.26,1:04:11.59,Default,,0,0,0,,Калорияны көбейтіңіз!
Dialogue: 0,1:04:11.72,1:04:15.14,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,1:04:15.22,1:04:16.27,Default,,0,0,0,,Оны сол жерде қалдырыңыз
Dialogue: 0,1:04:16.35,1:04:17.02,Default,,0,0,0,,Иә
Dialogue: 0,1:04:17.35,1:04:20.85,Default,,0,0,0,,Ұзақ уақыттан кейін үйдегі дәм дәмді болды~
Dialogue: 0,1:04:20.94,1:04:22.19,Default,,0,0,0,,Гавайиге қайтып бармайсыз ба?
Dialogue: 0,1:04:22.65,1:04:24.98,Default,,0,0,0,,Көктем келгенде мен демаламын да, үйге барамын.
Dialogue: 0,1:04:25.07,1:04:26.69,Default,,0,0,0,,А, мен де
Dialogue: 0,1:04:26.98,1:04:28.03,Default,,0,0,0,,Консерві ше?
Dialogue: 0,1:04:28.78,1:04:31.03,Default,,0,0,0,,Мен жеке биші болмайынша үйге бармаймын.
Dialogue: 0,1:04:31.11,1:04:31.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:32.53,1:04:35.66,Default,,0,0,0,,Ата-анам қарсы болды, мен оларға университетке барыңдар дедім.
Dialogue: 0,1:04:36.08,1:04:36.79,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:04:37.20,1:04:39.96,Default,,0,0,0,,Қолыңнан келсе, жеке биші бола аласың.
Dialogue: 0,1:04:40.54,1:04:42.75,Default,,0,0,0,,Мен де сондай болсам ғой.
Dialogue: 0,1:04:43.21,1:04:47.21,Default,,0,0,0,,Мен билегенді жақсы көремін, сондықтан бір күні мен...
Dialogue: 0,1:04:47.71,1:04:48.71,Default,,0,0,0,,Хула ханымға
Dialogue: 0,1:04:50.72,1:04:54.89,Default,,0,0,0,,Ыстық бұлақ қонақ үйінің иесі болыңыз және мәңгі билеңіз
Dialogue: 0,1:04:55.51,1:04:56.85,Default,,0,0,0,,Я~
Dialogue: 0,1:04:56.93,1:04:57.81,Default,,0,0,0,,Ранран ше?
Dialogue: 0,1:04:57.93,1:04:59.39,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:04:59.73,1:05:03.06,Default,,0,0,0,,Туған жеріме оралып, хула биінің мұғалімі болсам ғой.
Dialogue: 0,1:05:03.27,1:05:04.40,Default,,0,0,0,,Мен Гавайидемін—
Dialogue: 0,1:05:04.48,1:05:06.77,Default,,0,0,0,,Мен гавайлықтар сияқты жер жасағым келеді!
Dialogue: 0,1:05:06.86,1:05:09.28,Default,,0,0,0,,Гавайи филиалы? (Хиба) Менің барғым келеді!
Dialogue: 0,1:05:13.66,1:05:15.07,Default,,0,0,0,,Сіз түнемейсіз бе?
Dialogue: 0,1:05:15.20,1:05:17.41,Default,,0,0,0,,Иә, ертең сахна бар.
Dialogue: 0,1:05:18.62,1:05:19.62,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін істеп жатырсыз.
Dialogue: 0,1:05:23.04,1:05:24.29,Default,,0,0,0,,Мені қолымнан келгеннің бәрін жасауға мәжбүр еткен...
Dialogue: 0,1:05:25.29,1:05:26.42,Default,,0,0,0,,Барлығына рахмет
Dialogue: 0,1:05:27.63,1:05:30.01,Default,,0,0,0,,Олай болса, аға буын өкілдері
Dialogue: 0,1:05:41.27,1:05:45.06,Default,,0,0,0,,(5 адам сөйлейді)
Dialogue: 0,1:05:47.86,1:05:48.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:49.23,1:05:50.11,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:05:50.53,1:05:52.03,Default,,0,0,0,,Ало~ха~
Dialogue: 0,1:05:52.61,1:05:53.32,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:59.12,1:06:00.45,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,1:06:02.66,1:06:05.17,Default,,0,0,0,,Өткен күн үшін көп рахмет.
Dialogue: 0,1:06:05.92,1:06:09.00,Default,,0,0,0,,Мен мұны қандай да бір жолмен жеңе алатын сияқтымын...
Dialogue: 0,1:06:09.88,1:06:11.25,Default,,0,0,0,,Биді көргенде түсінесіз
Dialogue: 0,1:06:11.63,1:06:12.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:12.46,1:06:14.97,Default,,0,0,0,,Нацунагидің биі тамаша және әдемі
Dialogue: 0,1:06:15.13,1:06:15.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:16.26,1:06:18.85,Default,,0,0,0,,Бірақ мен баяу әндерге билегенде, бұл рас...
Dialogue: 0,1:06:21.18,1:06:22.93,Default,,0,0,0,,Әпке, сіз білесіз бе?
Dialogue: 0,1:06:23.60,1:06:25.94,Default,,0,0,0,,Иә, өйткені біз бір уақытта болдық.
Dialogue: 0,1:06:26.94,1:06:29.02,Default,,0,0,0,,Синхрондау... Бұл болды ма?
Dialogue: 0,1:06:31.53,1:06:34.07,Default,,0,0,0,,А, сонда Аяме-сенпай екеуің бе?
Dialogue: 0,1:06:34.15,1:06:35.40,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,1:06:36.11,1:06:39.62,Default,,0,0,0,,Өткен күні мені Аквамаринге апаруды өтінді.
Dialogue: 0,1:06:40.53,1:06:42.79,Default,,0,0,0,,Менің жігітім бір күн демалыс ала алмаған сияқты.
Dialogue: 0,1:06:42.87,1:06:45.46,Default,,0,0,0,,Е, Аяме-сенпай, менің жігітім...
Dialogue: 0,1:06:45.71,1:06:46.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:46.67,1:06:49.92,Default,,0,0,0,,Жоғары мақтау Мен кеңселік романтикадамын, сондықтан бұл құпияны сақтаңыз.
Dialogue: 0,1:06:51.13,1:06:52.21,Default,,0,0,0,,А... иә
Dialogue: 0,1:06:53.67,1:06:54.34,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,1:06:54.63,1:06:56.93,Default,,0,0,0,,А-а... (Сузукаке) Иә?
Dialogue: 0,1:06:57.51,1:06:59.09,Default,,0,0,0,,Сондай-ақ... иә...
Dialogue: 0,1:07:00.22,1:07:02.51,Default,,0,0,0,,Маған компанияңыз туралы айтып беріңізші.
Dialogue: 0,1:07:03.64,1:07:05.23,Default,,0,0,0,,Иә, әрине
Dialogue: 0,1:07:12.15,1:07:13.23,Default,,0,0,0,,Саса (Ранко) Ойо?
Dialogue: 0,1:07:13.32,1:07:14.48,Default,,0,0,0,,Уау... (Канна) Иә?
Dialogue: 0,1:07:16.28,1:07:17.57,Default,,0,0,0,,Кім? (Ранко) Кім?
Dialogue: 0,1:07:17.65,1:07:19.32,Default,,0,0,0,,Бұл кім? Иә иә
Dialogue: 0,1:07:19.74,1:07:20.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:21.03,1:07:24.12,Default,,0,0,0,,Маған бұрын мұражайдың іші туралы көп айтылды.
Dialogue: 0,1:07:24.20,1:07:25.83,Default,,0,0,0,,Мен сізді ынталандыруға рұқсат етіңіз...
Dialogue: 0,1:07:25.91,1:07:27.08,Default,,0,0,0,,Неге тек сен?
Dialogue: 0,1:07:27.83,1:07:31.63,Default,,0,0,0,,Бағалау парағы... Мен оны тастадым, бірақ алып кеткен сияқты.
Dialogue: 0,1:07:32.42,1:07:33.63,Default,,0,0,0,,Ах~
Dialogue: 0,1:07:34.21,1:07:37.17,Default,,0,0,0,,Бірақ! Менің биім жақсы болады деп үміттенемін
Dialogue: 0,1:07:37.26,1:07:38.18,Default,,0,0,0,,О!
Dialogue: 0,1:07:38.59,1:07:42.97,Default,,0,0,0,,Әй, бірақ мен қайтадан сау болып қалғаным Сузукаке-санның арқасында.
Dialogue: 0,1:07:43.05,1:07:44.47,Default,,0,0,0,,Я~
Dialogue: 0,1:07:44.56,1:07:48.02,Default,,0,0,0,,Аа, әрине бәрінің және менің ағаларымның арқасы.
Dialogue: 0,1:07:48.10,1:07:49.52,Default,,0,0,0,,Я~
Dialogue: 0,1:07:50.90,1:07:52.31,Default,,0,0,0,,Махаббат... (Хиуа) Махаббат?
Dialogue: 0,1:07:52.40,1:07:55.07,Default,,0,0,0,,Бірлік болу үшін не істеуім керек?
Dialogue: 0,1:07:55.23,1:07:57.32,Default,,0,0,0,,Бәріміз ойланып көрейік~
Dialogue: 0,1:07:57.44,1:08:00.74,Default,,0,0,0,,Әй, тоқта! Жақсы!
Dialogue: 0,1:08:09.54,1:08:13.46,Default,,0,0,0,,Мен көремін. Сіз Сузукакемен бір кезеңненсіз бе?
Dialogue: 0,1:08:15.09,1:08:15.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:21.01,1:08:26.77,Default,,0,0,0,,(Смартфоннан ойналатын ән)
Dialogue: 0,1:09:36.71,1:09:37.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:42.51,1:09:45.43,Default,,0,0,0,,Түсіндім, Валентин күні жақындап қалды.
Dialogue: 0,1:09:46.68,1:09:50.14,Default,,0,0,0,,Сатып алу керек пе? жасау? Мен оны уақытында жасаймын ба?
Dialogue: 0,1:09:50.68,1:09:53.06,Default,,0,0,0,,Мм, бүгін қай күн?
Dialogue: 0,1:09:55.02,1:09:55.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:21.25,1:10:21.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:36.77,1:10:38.02,Default,,0,0,0,,Сузукаке мырза...
Dialogue: 0,1:10:39.94,1:10:42.11,Default,,0,0,0,,Өйткені бүгін Цукидің қайтыс болған күні.
Dialogue: 0,1:10:43.57,1:10:47.07,Default,,0,0,0,,Мен компанияға келгеннен бері бұл жерде болған жоқпын...
Dialogue: 0,1:10:49.91,1:10:52.62,Default,,0,0,0,,Мен сені үнемі уайымдайтынмын.
Dialogue: 0,1:10:53.58,1:10:57.87,Default,,0,0,0,,Бастауыш сыныпта оқитын үлкен әпкесін жақсы көретін сіңлісі.
Dialogue: 0,1:11:00.09,1:11:03.17,Default,,0,0,0,,Сіздің әңгімеңізді тыңдау қызықты болды.
Dialogue: 0,1:11:05.30,1:11:07.84,Default,,0,0,0,,Аналар үзіліс жасай алмайды
Dialogue: 0,1:11:08.26,1:11:10.26,Default,,0,0,0,,Мен оның орнына сыныпты бақылауға бардым.
Dialogue: 0,1:11:11.22,1:11:13.72,Default,,0,0,0,,Хиуаға барсаң, мен осындамын деп қуанасың.
Dialogue: 0,1:11:14.39,1:11:16.73,Default,,0,0,0,,Жауабын білмесем де, қолымды көтердім.
Dialogue: 0,1:11:19.15,1:11:21.73,Default,,0,0,0,,Мен кеше сахнаны көруге келдім.
Dialogue: 0,1:11:22.11,1:11:25.24,Default,,0,0,0,,Бірақ менің ойымша, бұл КоКо-ниге көбірек ұнады.
Dialogue: 0,1:11:29.41,1:11:32.33,Default,,0,0,0,,Уақыт көпке тоқтағандай болды, бірақ...
Dialogue: 0,1:11:32.95,1:11:38.04,Default,,0,0,0,,Сол бастауыш сынып оқушысының компанияға келгеніне көп уақыт болды.
Dialogue: 0,1:11:40.75,1:11:44.13,Default,,0,0,0,,Менің уақытым ақыры жылжи бастады
Dialogue: 0,1:11:45.84,1:11:49.26,Default,,0,0,0,,Мен осы айдың соңында жұмыстан шығып, үйіме қайтамын.
Dialogue: 0,1:11:49.34,1:11:50.01,Default,,0,0,0,,А...
Dialogue: 0,1:11:50.59,1:11:53.22,Default,,0,0,0,,Мен ұрпақтар бойы Кориямада саке сыра зауытын басқардым.
Dialogue: 0,1:11:53.81,1:11:57.18,Default,,0,0,0,,Менің әкем де жасы ұлғайып барады, сондықтан мен оның міндетін атқаруды ойлап жүрмін.
Dialogue: 0,1:12:06.32,1:12:09.36,Default,,0,0,0,,...сонымен бірге жоғалады ма?
Dialogue: 0,1:12:10.99,1:12:14.49,Default,,0,0,0,,Сузукаке-сан да жоғалып кете ме?
Dialogue: 0,1:12:39.48,1:12:43.27,Default,,0,0,0,,Сен осылай билей алсаң, бәрі жақсы болады
Dialogue: 0,1:12:44.19,1:12:48.44,Default,,0,0,0,,Сіз Мариге де есеп беріп, бар күшіңізді салып жатқаныңызды айтуыңыз керек.
Dialogue: 0,1:12:49.36,1:12:51.24,Default,,0,0,0,,Шындық та қуанары сөзсіз.
Dialogue: 0,1:13:07.84,1:13:11.26,Default,,0,0,0,,Қабірге бармағаныма біраз болды, сөзіңізді бөлгенім үшін кешіріңіз.
Dialogue: 0,1:13:37.78,1:13:41.96,Default,,0,0,0,,(Смартфоннан ойналатын ән)
Dialogue: 0,1:14:02.64,1:14:03.81,Default,,0,0,0,,Фуфу сасаса
Dialogue: 0,1:14:06.65,1:14:08.15,Default,,0,0,0,,Хивахива~!
Dialogue: 0,1:14:08.61,1:14:09.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:10.65,1:14:11.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:13.95,1:14:15.32,Default,,0,0,0,,Уау! (2 адам) Әй...
Dialogue: 0,1:14:15.70,1:14:17.91,Default,,0,0,0,,Не, не, не? не болды?
Dialogue: 0,1:14:29.54,1:14:30.88,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:14:30.96,1:14:31.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:32.59,1:14:33.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:34.63,1:14:36.76,Default,,0,0,0,,Ммм… ммм… ммм…
Dialogue: 0,1:14:47.60,1:14:48.90,Default,,0,0,0,,А, шоколад?
Dialogue: 0,1:14:49.98,1:14:50.65,Default,,0,0,0,,Ол солай деді де, бізді біраз уақыт күттіріп қойды
Dialogue: 0,1:14:50.77,1:14:51.90,Default,,0,0,0,,А... иә
Dialogue: 0,1:14:52.07,1:14:53.57,Default,,0,0,0,,Нацунаги үлгерді ме?
Dialogue: 0,1:14:53.65,1:14:55.28,Default,,0,0,0,,Жоқ, бәрі.
Dialogue: 0,1:14:56.07,1:14:58.57,Default,,0,0,0,,Рахмет! От бақытты!
Dialogue: 0,1:15:01.16,1:15:03.49,Default,,0,0,0,,Мен сен үшін өте қуаныштымын, бірақ...
Dialogue: 0,1:15:04.08,1:15:05.75,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,1:15:05.83,1:15:07.92,Default,,0,0,0,,Мен барлығына күлкі сыйлай алдым~
Dialogue: 0,1:15:08.00,1:15:10.67,Default,,0,0,0,,Бұл да Хибаның жүрегімді жаралағаны.
Dialogue: 0,1:15:10.75,1:15:11.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:14.34,1:15:15.76,Default,,0,0,0,,Ех! Керемет-чан...
Dialogue: 0,1:15:15.92,1:15:17.34,Default,,0,0,0,,А, бұл дұрыс емес, Хунгер-чан.
Dialogue: 0,1:15:17.43,1:15:20.01,Default,,0,0,0,,Рахмет, Нацунаги-сан!
Dialogue: 0,1:15:20.51,1:15:21.39,Default,,0,0,0,,А... иә
Dialogue: 0,1:15:22.47,1:15:24.02,Default,,0,0,0,,Әй... Аяме-сенпай да.
Dialogue: 0,1:15:24.85,1:15:27.52,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,1:15:27.60,1:15:29.81,Default,,0,0,0,,Жоқ, көмегіңіз үшін рахмет.
Dialogue: 0,1:15:31.36,1:15:33.73,Default,,0,0,0,,Менің де саған беретін бірдеңе бар еді.
Dialogue: 0,1:15:34.15,1:15:35.86,Default,,0,0,0,,Не? иә бұл
Dialogue: 0,1:15:38.36,1:15:41.49,Default,,0,0,0,,«Барлығының Хула чемпионаты/Ұлттық турнирі»
Dialogue: 0,1:15:41.91,1:15:44.16,Default,,0,0,0,,Елдің түкпір-түкпірінен Хула бишілері жиналып, сайысқа түседі.
Dialogue: 0,1:15:44.54,1:15:45.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:45.83,1:15:48.87,Default,,0,0,0,,Жеке топ Жасына байланысты...
Dialogue: 0,1:15:49.12,1:15:51.21,Default,,0,0,0,,Топтар 5 немесе одан да көп адамнан тұруы мүмкін.
Dialogue: 0,1:15:52.09,1:15:55.26,Default,,0,0,0,,Хаясака мырза биыл судья ретінде шақырылғандықтан...
Dialogue: 0,1:15:55.92,1:15:59.34,Default,,0,0,0,,Бізге де бір топқа қосылуды сұрады.
Dialogue: 0,1:15:59.93,1:16:02.14,Default,,0,0,0,,Сондай-ақ 45 жастан асқан адамдарға арналған санат бар.
Dialogue: 0,1:16:02.35,1:16:05.43,Default,,0,0,0,,Жыл сайын Юмотодан хула ханымдар командасы қатысады.
Dialogue: 0,1:16:06.81,1:16:07.60,Default,,0,0,0,,Неге шықпайсың?
Dialogue: 0,1:16:08.06,1:16:10.44,Default,,0,0,0,,Біз ше? (Хиба) Неге...
Dialogue: 0,1:16:14.32,1:16:15.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:15.78,1:16:18.90,Default,,0,0,0,,Стигманы қайтару, абыройды қайтару, қарымта матч!
Dialogue: 0,1:16:19.20,1:16:19.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:20.41,1:16:23.16,Default,,0,0,0,,Осы уақытқа дейін ең көңілі қалған жаңадан келгендер
Dialogue: 0,1:16:23.70,1:16:27.95,Default,,0,0,0,,Бұл бейнеден, мүмкін, ересек фигура—
Dialogue: 0,1:16:28.45,1:16:30.08,Default,,0,0,0,,Елдің бәріне көрсет!
Dialogue: 0,1:16:30.54,1:16:31.46,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:33.63,1:16:35.04,Default,,0,0,0,,Хула чемпионаты…
Dialogue: 0,1:16:35.67,1:16:37.67,Default,,0,0,0,,Жанып жатыр (4 адам) Иә?
Dialogue: 0,1:16:37.96,1:16:40.59,Default,,0,0,0,,Мен мұндай хула жарысын енді күтпедім.
Dialogue: 0,1:16:41.59,1:16:44.10,Default,,0,0,0,,Мен көрінуге мүмкіндігім болады деп ешқашан ойламадым.
Dialogue: 0,1:16:44.43,1:16:46.89,Default,,0,0,0,,Жанып жатыр... (Ранко) Жанып тұр
Dialogue: 0,1:16:46.97,1:16:48.10,Default,,0,0,0,,Өрт күйі
Dialogue: 0,1:16:48.43,1:16:52.56,Default,,0,0,0,,Бірақ мен Хула Кошиенде канкан жеңіп алдым...
Dialogue: 0,1:17:08.83,1:17:10.91,Default,,0,0,0,,Сыртқа шығайық... Шықайық
Dialogue: 0,1:17:11.25,1:17:11.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:12.00,1:17:13.58,Default,,0,0,0,,Аяме-сенпай айтқандай—
Dialogue: 0,1:17:13.67,1:17:16.34,Default,,0,0,0,,Адамдарға біздің биімізді көруге жақсы мүмкіндік.
Dialogue: 0,1:17:16.71,1:17:17.38,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:18.17,1:17:20.01,Default,,0,0,0,,Иә, шығып жатыр~
Dialogue: 0,1:17:20.59,1:17:23.63,Default,,0,0,0,,Олай болса, қандай ән мен би билеуіміз керек?
Dialogue: 0,1:17:23.72,1:17:24.80,Default,,0,0,0,,Шион-чан?
Dialogue: 0,1:17:24.89,1:17:27.31,Default,,0,0,0,,Өйткені хула ханымдар да сонда болады, солай ма?
Dialogue: 0,1:17:30.06,1:17:32.23,Default,,0,0,0,,Мен саған жақындағым келеді...
Dialogue: 0,1:17:33.90,1:17:35.19,Default,,0,0,0,,Алдымен әнді шешейік.
Dialogue: 0,1:17:35.52,1:17:37.82,Default,,0,0,0,,Олай болса, бізге ұқсайтын ән алғымыз келеді~
Dialogue: 0,1:17:38.23,1:17:40.49,Default,,0,0,0,,Олай болса, баяу және нәзік әннен гөрі.
Dialogue: 0,1:17:40.57,1:17:42.45,Default,,0,0,0,,Жігерлі, көңілді ән болғаны дұрыс емес пе?
Dialogue: 0,1:17:43.45,1:17:45.70,Default,,0,0,0,,Осы уақытқа дейін билеген әндеріңізді тізімдей аласыз ба?
Dialogue: 0,1:17:45.87,1:17:49.08,Default,,0,0,0,,Осы уақытқа дейін билеген әндерім қызық емес.
Dialogue: 0,1:17:49.20,1:17:51.16,Default,,0,0,0,,Жаңа ән шығарайық!
Dialogue: 0,1:17:51.25,1:17:53.33,Default,,0,0,0,,Мысалы, жаңа ән дегеніміз не?
Dialogue: 0,1:17:53.41,1:17:54.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:54.75,1:17:55.63,Default,,0,0,0,,Гавайиде—
Dialogue: 0,1:17:55.71,1:17:58.38,Default,,0,0,0,,«Рок-А-Хула» атты танымал шоу болды—
Dialogue: 0,1:17:58.46,1:17:59.59,Default,,0,0,0,,Майкл Джексон және—
Dialogue: 0,1:17:59.67,1:18:01.96,Default,,0,0,0,,Леди Гагаға ұқсайды...
Dialogue: 0,1:18:02.05,1:18:05.01,Default,,0,0,0,,Фонда бишілер билеп жатыр.
Dialogue: 0,1:18:05.26,1:18:06.55,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,1:18:07.05,1:18:09.89,Default,,0,0,0,,Сонымен танымал әндер мен J-pop әндері ше?
Dialogue: 0,1:18:09.97,1:18:11.68,Default,,0,0,0,,Ол әлі билеп жатыр.
Dialogue: 0,1:18:11.77,1:18:13.73,Default,,0,0,0,,Сіз аспапта ойнай отырып билейсіз бе?
Dialogue: 0,1:18:13.81,1:18:16.73,Default,,0,0,0,,Мен тек домбыра мен маракада ойнай аламын.
Dialogue: 0,1:18:16.81,1:18:18.82,Default,,0,0,0,,Зомби жақшаларымен билеу
Dialogue: 0,1:18:18.90,1:18:20.69,Default,,0,0,0,,Мен қорқынышты емеспін
Dialogue: 0,1:18:20.78,1:18:22.69,Default,,0,0,0,,Жаман болмас бұрын бұл мәселе.
Dialogue: 0,1:18:22.82,1:18:25.49,Default,,0,0,0,,А, онда... е-е~
Dialogue: 0,1:18:25.91,1:18:27.62,Default,,0,0,0,,Әзірге, хуладан басқа
Dialogue: 0,1:18:27.70,1:18:30.91,Default,,0,0,0,,Шынымен көңілді немесе қызықты музыка бар ма?
Dialogue: 0,1:18:31.45,1:18:32.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:33.54,1:18:34.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:34.75,1:18:35.87,Default,,0,0,0,,Хехехе
Dialogue: 0,1:18:46.26,1:18:47.51,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:18:50.22,1:18:50.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:52.81,1:18:54.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:10.41,1:19:11.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:13.95,1:19:14.91,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,1:19:45.86,1:19:47.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:48.24,1:19:49.74,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:19:49.82,1:19:50.57,Default,,0,0,0,,Керемет!
Dialogue: 0,1:19:51.20,1:19:53.28,Default,,0,0,0,,Керемет! Жақсы!
Dialogue: 0,1:19:53.41,1:19:55.58,Default,,0,0,0,,Керемет! тамаша! Сондай сүйкімді!
Dialogue: 0,1:19:56.20,1:19:57.71,Default,,0,0,0,,Чемпионат Сәттілік!
Dialogue: 0,1:20:00.71,1:20:01.67,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:20:02.00,1:20:07.09,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:20:22.02,1:20:25.23,Default,,0,0,0,,Бізге қосылғандарыңыз үшін барлығыңызға рахмет.
Dialogue: 0,1:20:25.86,1:20:29.07,Default,,0,0,0,,Бұл турнирге еліміздің түкпір-түкпірінен келген кәсіпқойлар да, әуесқойлар да қатыса алады.
Dialogue: 0,1:20:29.28,1:20:31.61,Default,,0,0,0,,Хула биін жақсы көретін адамдар жиналады—
Dialogue: 0,1:20:31.70,1:20:33.78,Default,,0,0,0,,Тұрақты тәжірибе нәтижелерін көрсету—
Dialogue: 0,1:20:34.16,1:20:35.83,Default,,0,0,0,,Би жарысады.
Dialogue: 0,1:20:36.87,1:20:40.37,Default,,0,0,0,,Кеше көрме мен жеке бөлімдерге арналған көрсетілім болды.
Dialogue: 0,1:20:40.46,1:20:43.00,Default,,0,0,0,,Бүгін топқа бөлу өтеді.
Dialogue: 0,1:20:43.67,1:20:46.92,Default,,0,0,0,,Үш бөлімге бөлінеді: кіші, генерал және аға.
Dialogue: 0,1:20:47.05,1:20:49.26,Default,,0,0,0,,Жеңімпаз және екінші орын алған 2 топ—
Dialogue: 0,1:20:49.42,1:20:53.01,Default,,0,0,0,,Қазылар алқасының арнайы жүлдесі және Көрермендер сыйлығы сияқты жүлделер үшін жарысыңыз
Dialogue: 0,1:20:54.05,1:20:57.27,Default,,0,0,0,,Сондықтан мен кіші бөлімнен бастағым келеді.
Dialogue: 0,1:20:57.97,1:20:59.68,Default,,0,0,0,,№1 жазба
Dialogue: 0,1:20:59.93,1:21:03.19,Default,,0,0,0,,Хоккайдо Мисаки Хула би сыныбының барлығы.
Dialogue: 0,1:21:03.85,1:21:05.48,Default,,0,0,0,,Уау~
Dialogue: 0,1:21:05.94,1:21:07.94,Default,,0,0,0,,Қатысушылар өте көп.
Dialogue: 0,1:21:09.11,1:21:10.57,Default,,0,0,0,,Иә? Ал Шиошио ше?
Dialogue: 0,1:21:10.99,1:21:13.07,Default,,0,0,0,,Ол тағы да қашып кетті ме?
Dialogue: 0,1:21:13.57,1:21:15.95,Default,,0,0,0,,Мен хула қожайынына қайран қаламын...
Dialogue: 0,1:21:16.45,1:21:18.16,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,1:21:19.83,1:21:20.71,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,1:21:22.16,1:21:24.46,Default,,0,0,0,,А, келдің. (Кіші) Иә!
Dialogue: 0,1:21:25.08,1:21:27.04,Default,,0,0,0,,Орта мектептің кіші оқушылары (Хиба/Ранко) Ах
Dialogue: 0,1:21:27.13,1:21:29.26,Default,,0,0,0,,Канкан саған қарыздар~
Dialogue: 0,1:21:29.34,1:21:30.01,Default,,0,0,0,,Болады ма?
Dialogue: 0,1:21:30.46,1:21:32.80,Default,,0,0,0,,Жастарыңыздың көзінше олай етпеңіз!
Dialogue: 0,1:21:32.88,1:21:36.55,Default,,0,0,0,,Иә? Өйткені бұл Канкан болса да, Ранран Ранран деп аталады.
Dialogue: 0,1:21:36.93,1:21:38.47,Default,,0,0,0,,Кейде мен «Ня~» деймін.
Dialogue: 0,1:21:38.56,1:21:40.60,Default,,0,0,0,,Олар мұны сізге қолайлы етіп жасап жатыр!
Dialogue: 0,1:21:41.98,1:21:43.23,Default,,0,0,0,,(Кіші балалардың күлкісі)
Dialogue: 0,1:21:43.89,1:21:46.19,Default,,0,0,0,,А... бәрі менің сыныптастарым.
Dialogue: 0,1:21:46.27,1:21:47.27,Default,,0,0,0,,Мен білемін!
Dialogue: 0,1:21:47.69,1:21:49.82,Default,,0,0,0,,Досукой-сан мен (Кіші) Хангер-чан
Dialogue: 0,1:21:49.90,1:21:50.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:50.65,1:21:52.61,Default,,0,0,0,,Гавайиден келген адаммен...
Dialogue: 0,1:21:52.70,1:21:53.61,Default,,0,0,0,,Но Маск мырза!
Dialogue: 0,1:21:53.82,1:21:55.57,Default,,0,0,0,,Бұл атау емес.
Dialogue: 0,1:21:56.41,1:21:58.87,Default,,0,0,0,,ОГ-лар да кейін келетін сияқты.
Dialogue: 0,1:21:59.54,1:22:02.33,Default,,0,0,0,,Мен аға хуланы көрмегелі біраз болды, сондықтан оны асыға күтемін.
Dialogue: 0,1:22:02.41,1:22:04.87,Default,,0,0,0,,Қаңқан-сенпай мен саған түкіремін.
Dialogue: 0,1:22:04.96,1:22:06.71,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:22:06.88,1:22:07.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:07.71,1:22:08.46,Default,,0,0,0,,(жөтел жөтел)
Dialogue: 0,1:22:08.75,1:22:11.17,Default,,0,0,0,,Жарайды, менің сенен бір жақсылығым бар.
Dialogue: 0,1:22:12.01,1:22:12.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:14.05,1:22:14.84,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:22:14.93,1:22:17.22,Default,,0,0,0,,Осымен жоғарғы бөлім аяқталады.
Dialogue: 0,1:22:17.39,1:22:19.26,Default,,0,0,0,,20 минуттық үзілістен кейін—
Dialogue: 0,1:22:19.68,1:22:23.23,Default,,0,0,0,,Енді мен жалпы санат бойынша емтиханды бастағым келеді.
Dialogue: 0,1:22:24.89,1:22:25.85,Default,,0,0,0,,Енді 12-ші жұп?
Dialogue: 0,1:22:26.48,1:22:29.77,Default,,0,0,0,,Біз қандай топта болдық? (Хиба) 14 топ
Dialogue: 0,1:22:30.40,1:22:32.36,Default,,0,0,0,,Тағы екі топ қалды!
Dialogue: 0,1:22:32.90,1:22:34.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:34.61,1:22:36.16,Default,,0,0,0,,Үлкен қошемет
Dialogue: 0,1:22:36.53,1:22:38.16,Default,,0,0,0,,Өткен жылдың жүлдегері
Dialogue: 0,1:22:38.74,1:22:42.54,Default,,0,0,0,,Токиода 40 жыл бойы жұмыс істеп келе жатқан хула мектебінің оқушылары.
Dialogue: 0,1:22:42.83,1:22:46.08,Default,,0,0,0,,Барлығы өзін ортодоксалды хула биі сияқты сезінеді...
Dialogue: 0,1:22:46.50,1:22:48.88,Default,,0,0,0,,Бізде бәрі жақсы ма?
Dialogue: 0,1:22:49.21,1:22:50.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:52.34,1:22:54.88,Default,,0,0,0,,Православиелік хула жасасақ та, біз бәрібір...
Dialogue: 0,1:22:55.26,1:22:57.93,Default,,0,0,0,,Сіз мұны бұрыннан істеп жүрген адамдармен бәсекеге түсе алмайсыз, солай ма?
Dialogue: 0,1:23:01.39,1:23:02.77,Default,,0,0,0,,Біз...
Dialogue: 0,1:23:03.43,1:23:06.02,Default,,0,0,0,,Біздің ғана қолымыздан келетін хуланы билейік!
Dialogue: 0,1:23:10.06,1:23:12.02,Default,,0,0,0,,Болады... Сенпай!
Dialogue: 0,1:23:12.11,1:23:14.19,Default,,0,0,0,,Мен сенің ағаң емеспін.
Dialogue: 0,1:23:14.28,1:23:17.41,Default,,0,0,0,,Охана-чан, сен жақсы нәрсе айттың.
Dialogue: 0,1:23:17.49,1:23:18.24,Default,,0,0,0,,...
Dialogue: 0,1:23:19.74,1:23:21.16,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,1:23:22.45,1:23:23.62,Default,,0,0,0,,Бірақ мен—
Dialogue: 0,1:23:24.54,1:23:26.46,Default,,0,0,0,,Мен сендермен бір уақытта болғаныма қуаныштымын.
Dialogue: 0,1:23:40.59,1:23:42.39,Default,,0,0,0,,Кеттік (4 адам) Иә!
Dialogue: 0,1:23:43.39,1:23:47.44,Default,,0,0,0,,Енді жалпы бөлімнің жазбасы № 14.
Dialogue: 0,1:23:47.81,1:23:51.19,Default,,0,0,0,,Фукусима курортының гавайиялықтардың жаңа командасы
Dialogue: 0,1:23:51.40,1:23:52.48,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,1:24:09.00,1:24:11.67,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:24:12.13,1:24:14.59,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:24:15.17,1:24:17.84,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:24:18.30,1:24:20.93,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:24:33.65,1:24:35.86,Default,,0,0,0,,♪Күнде бір көрініс
Dialogue: 0,1:24:36.65,1:24:38.94,Default,,0,0,0,,♪Күнделікті заттарды жинасаң
Dialogue: 0,1:24:39.07,1:24:39.74,Default,,0,0,0,,♪Уф! Ха!
Dialogue: 0,1:24:39.86,1:24:42.28,Default,,0,0,0,,♪Жүрегім кенет біртүрлі болып кетті
Dialogue: 0,1:24:42.41,1:24:44.37,Default,,0,0,0,,♪Мен оны сондай сүйкімді деп ойладым
Dialogue: 0,1:24:44.49,1:24:45.99,Default,,0,0,0,,♪Ой!
Dialogue: 0,1:24:46.12,1:24:48.95,Default,,0,0,0,,♪Тіпті кездейсоқ заттарда және заттар өтіп бара жатқанда
Dialogue: 0,1:24:49.25,1:24:50.37,Default,,0,0,0,,♪Мағынасы бар, солай ма?
Dialogue: 0,1:24:50.50,1:24:52.00,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,1:24:52.12,1:24:55.29,Default,,0,0,0,,♪Сізбен кездесіп, бір-біріңізді түсіну
Dialogue: 0,1:24:55.42,1:24:56.55,Default,,0,0,0,,♪Бұл қазына
Dialogue: 0,1:24:56.67,1:24:58.26,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,1:24:58.38,1:25:00.67,Default,,0,0,0,,♪Көңіл күйде немесе күйзелгенде
Dialogue: 0,1:25:01.38,1:25:04.18,Default,,0,0,0,,♪Мен жалғыз емес екенімді түсіндім
Dialogue: 0,1:25:04.35,1:25:05.81,Default,,0,0,0,,♪ Қазір (Хай!) Бірден (Хай!)
Dialogue: 0,1:25:05.93,1:25:07.35,Default,,0,0,0,,♪ Суна (хай!) Они (хай!)
Dialogue: 0,1:25:07.47,1:25:10.43,Default,,0,0,0,,♪Рахмет айтқым келеді
Dialogue: 0,1:25:10.56,1:25:11.85,Default,,0,0,0,,♪Ой!
Dialogue: 0,1:25:11.98,1:25:14.48,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,1:25:15.23,1:25:17.27,Default,,0,0,0,,♪Егер сөз жеткіліксіз болса, не істеуім керек?
Dialogue: 0,1:25:17.40,1:25:18.11,Default,,0,0,0,,♪Мен не істеуім керек?
Dialogue: 0,1:25:18.23,1:25:20.90,Default,,0,0,0,,♪ «Мен тірімін» сізді кездестірген қуанышпен
Dialogue: 0,1:25:21.03,1:25:23.70,Default,,0,0,0,,♪Осылай ойлағаныма өте қуаныштымын.
Dialogue: 0,1:25:24.45,1:25:27.16,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,1:25:27.28,1:25:29.62,Default,,0,0,0,,♪Мен сені жақсы көретінімді түсінгенде не істеуім керек?
Dialogue: 0,1:25:29.75,1:25:30.62,Default,,0,0,0,,♪Мен не істеуім керек?
Dialogue: 0,1:25:30.75,1:25:33.33,Default,,0,0,0,,♪Менің күндерім тек сенің арқаңда
Dialogue: 0,1:25:33.46,1:25:36.46,Default,,0,0,0,,♪Одан да әдемі жарқырайды
Dialogue: 0,1:25:37.67,1:25:39.80,Default,,0,0,0,,♪Уау! Ха! Ха! Ха!
Dialogue: 0,1:25:41.30,1:25:42.76,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,1:25:43.88,1:25:46.05,Default,,0,0,0,,♪Уф! Ха! Ха! Ха!
Dialogue: 0,1:25:47.39,1:25:48.97,Default,,0,0,0,,♪ Өте жұмсақ!
Dialogue: 0,1:25:49.10,1:25:50.02,Default,,0,0,0,,♪Рахмет, Рахмет
Dialogue: 0,1:25:50.14,1:25:52.02,Default,,0,0,0,,♪Ерлігім тасып бара жатқандай.
Dialogue: 0,1:25:52.14,1:25:53.35,Default,,0,0,0,,♪Рахмет, рахмет
Dialogue: 0,1:25:53.48,1:25:55.19,Default,,0,0,0,,♪Мен көп нәрсені істей алатынымды сезінемін.
Dialogue: 0,1:25:55.31,1:25:56.44,Default,,0,0,0,,♪Рахмет, рахмет
Dialogue: 0,1:25:56.56,1:25:58.11,Default,,0,0,0,,♪ Сенің қасымда болғаным
Dialogue: 0,1:25:58.23,1:25:59.48,Default,,0,0,0,,♪Әдеттегідей рахмет
Dialogue: 0,1:25:59.61,1:26:01.11,Default,,0,0,0,,♪Рахмет
Dialogue: 0,1:26:01.24,1:26:06.28,Default,,0,0,0,,♪Айтқанда ғана жүрегім толады
Dialogue: 0,1:26:07.41,1:26:10.29,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,1:26:10.41,1:26:12.71,Default,,0,0,0,,♪Егер сөз жеткіліксіз болса, не істеуім керек?
Dialogue: 0,1:26:12.83,1:26:13.71,Default,,0,0,0,,♪Мен не істеуім керек?
Dialogue: 0,1:26:13.83,1:26:16.21,Default,,0,0,0,,♪ «Мен тірімін» сізді кездестірген қуанышпен
Dialogue: 0,1:26:16.33,1:26:19.71,Default,,0,0,0,,♪ Мен осылай ойлай алғаныма өте қуаныштымын.
Dialogue: 0,1:26:19.88,1:26:22.46,Default,,0,0,0,,♪Достарым үшін рахмет (teru)
Dialogue: 0,1:26:22.59,1:26:25.47,Default,,0,0,0,,♪Мен сені жақсы көретінімді түсінгенде не істеуім керек?
Dialogue: 0,1:26:25.80,1:26:28.55,Default,,0,0,0,,♪Менің күндерім тек сенің арқаңда
Dialogue: 0,1:26:28.68,1:26:31.72,Default,,0,0,0,,♪Одан да әдемі жарқырайды
Dialogue: 0,1:26:32.27,1:26:33.48,Default,,0,0,0,,♪СІЗ ҮШІН РАХМЕТ
Dialogue: 0,1:26:33.68,1:26:35.06,Default,,0,0,0,,♪СІЗ ҮШІН РАХМЕТ
Dialogue: 0,1:26:35.19,1:26:38.02,Default,,0,0,0,,♪Аа, Құдай шынымен жақсы жұмыс істеп жатыр
Dialogue: 0,1:26:38.19,1:26:39.40,Default,,0,0,0,,♪СІЗ ҮШІН РАХМЕТ
Dialogue: 0,1:26:39.61,1:26:40.82,Default,,0,0,0,,♪СІЗ ҮШІН РАХМЕТ
Dialogue: 0,1:26:41.03,1:26:44.49,Default,,0,0,0,,♪Мен ертеңді күте алмаймын
Dialogue: 0,1:26:44.82,1:26:47.28,Default,,0,0,0,,♪Сәлем! жоғары! жоғары! жоғары!
Dialogue: 0,1:26:47.91,1:26:50.66,Default,,0,0,0,,♪ Сәлем! жоғары! жоғары! жоғары!
Dialogue: 0,1:26:51.04,1:26:53.50,Default,,0,0,0,,♪Сәлем! жоғары! жоғары! жоғары!
Dialogue: 0,1:26:54.12,1:26:56.42,Default,,0,0,0,,♪Сәлем! жоғары! жоғары! жоғары!
Dialogue: 0,1:26:56.75,1:26:59.34,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:26:59.79,1:27:02.46,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:27:02.88,1:27:05.63,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:27:05.93,1:27:09.01,Default,,0,0,0,,♪Бақытты, Бақытты, Яппи! Жаппи!
Dialogue: 0,1:27:09.39,1:27:15.23,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:27:16.31,1:27:17.81,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:27:17.90,1:27:23.36,Default,,0,0,0,,Хуладан 8-ші Ұлттық чемпионаттың жабылу салтанаты аяқталды.
Dialogue: 0,1:27:32.95,1:27:35.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:27:37.92,1:27:39.88,Default,,0,0,0,,Мен киімімді ауыстырып, үйге баруым керек.
Dialogue: 0,1:27:40.08,1:27:40.75,Default,,0,0,0,,Иә
Dialogue: 0,1:27:41.29,1:27:44.46,Default,,0,0,0,,Хитачидің Токио вокзалындағы соңғы аялдамасы сағат 9-да?
Dialogue: 0,1:27:45.84,1:27:48.30,Default,,0,0,0,,Аяме-сенпайға не айтайын...
Dialogue: 0,1:27:48.93,1:27:51.55,Default,,0,0,0,,Нәтижені білетініңізге сенімдімін.
Dialogue: 0,1:27:51.85,1:27:54.72,Default,,0,0,0,,Біз қатты итермеледік пе?
Dialogue: 0,1:27:54.81,1:27:58.19,Default,,0,0,0,,Әділқазылар алқасындағы мұғалімдер аң-таң қалды.
Dialogue: 0,1:28:00.31,1:28:02.61,Default,,0,0,0,,Бірақ өте...
Dialogue: 0,1:28:03.44,1:28:05.07,Default,,0,0,0,,Бұл өте қызық болды
Dialogue: 0,1:28:07.53,1:28:08.20,Default,,0,0,0,,Иә
Dialogue: 0,1:28:08.28,1:28:09.91,Default,,0,0,0,,Мен шын жүрегіммен билей алдым!
Dialogue: 0,1:28:10.32,1:28:11.91,Default,,0,0,0,,Сіз мұны орындағаныңызға сенімдімін.
Dialogue: 0,1:28:11.99,1:28:13.62,Default,,0,0,0,,Өкінбеймін!
Dialogue: 0,1:28:13.70,1:28:14.83,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:28:14.91,1:28:15.91,Default,,0,0,0,,Сендер
Dialogue: 0,1:28:18.37,1:28:20.29,Default,,0,0,0,,бұл...Мыр. Хаясака
Dialogue: 0,1:28:20.62,1:28:22.50,Default,,0,0,0,,Балалар сендер бұл туралы ойладыңдар ма?
Dialogue: 0,1:28:22.71,1:28:24.00,Default,,0,0,0,,А... иә
Dialogue: 0,1:28:24.59,1:28:27.42,Default,,0,0,0,,Бұл қызықты және жаңа болды.
Dialogue: 0,1:28:27.97,1:28:30.72,Default,,0,0,0,,Бәрінен бұрын бәрімізді бақытты етейік.
Dialogue: 0,1:28:30.80,1:28:33.18,Default,,0,0,0,,Аудиториямен бір болу рухы...
Dialogue: 0,1:28:33.26,1:28:34.85,Default,,0,0,0,,Дұрыс жеткізілді
Dialogue: 0,1:28:35.81,1:28:38.35,Default,,0,0,0,,Бірақ ренжімеңіз.
Dialogue: 0,1:28:39.10,1:28:42.94,Default,,0,0,0,,Әрқашан тұтынушыларыңызды тыңдаңыз және айналаңыздағылардың пікірін тыңдаңыз.
Dialogue: 0,1:28:43.73,1:28:45.57,Default,,0,0,0,,Достарыңмен бірге ойлан
Dialogue: 0,1:28:46.73,1:28:47.82,Default,,0,0,0,,Өмір сияқты
Dialogue: 0,1:28:48.53,1:28:53.66,Default,,0,0,0,,Хула биі - бұл жерде-мұнда адасып, уайымдап, кезіп жүру.
Dialogue: 0,1:28:54.03,1:28:54.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:55.91,1:28:56.83,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,1:28:57.45,1:28:59.16,Default,,0,0,0,,Нәтиже көңілсіз болды.
Dialogue: 0,1:28:59.58,1:29:01.87,Default,,0,0,0,,Бірақ бұл өте қызық болды!
Dialogue: 0,1:29:02.46,1:29:03.25,Default,,0,0,0,,Онда!
Dialogue: 0,1:29:03.83,1:29:07.05,Default,,0,0,0,,Біз Spa Resort Gawaiians жаңа командасымыз.
Dialogue: 0,1:29:07.13,1:29:08.76,Default,,0,0,0,,Көңіліңіз көтерілсе, біз сізге сыйлық береміз.
Dialogue: 0,1:29:09.34,1:29:10.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:10.38,1:29:11.13,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:29:14.30,1:29:15.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:15.51,1:29:16.60,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,1:29:19.56,1:29:22.39,Default,,0,0,0,,Қоңырау шалу өте қызықты болды.
Dialogue: 0,1:29:22.64,1:29:24.31,Default,,0,0,0,,Сіздің сахнаңыз ең жақсы болды
Dialogue: 0,1:29:24.98,1:29:25.90,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:26.27,1:29:28.11,Default,,0,0,0,,Ол тіпті лей дайындауға барын салды.
Dialogue: 0,1:29:28.57,1:29:32.28,Default,,0,0,0,,А, жоқ, біз бұл лейді сатып алған жоқпыз...
Dialogue: 0,1:29:33.11,1:29:33.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:34.95,1:29:37.99,Default,,0,0,0,,Мм, мына ағаның анасы...
Dialogue: 0,1:29:38.33,1:29:38.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:40.33,1:29:42.54,Default,,0,0,0,,Менің анам... ол осында болды ма?
Dialogue: 0,1:29:43.37,1:29:44.12,Default,,0,0,0,,Иә
Dialogue: 0,1:29:44.29,1:29:48.63,Default,,0,0,0,,Лей сатып алмақ болғанымызда, ол бізге ақша берді...
Dialogue: 0,1:29:48.88,1:29:50.26,Default,,0,0,0,,жақын жерде болуы мүмкін
Dialogue: 0,1:29:59.14,1:30:00.52,Default,,0,0,0,,Ех... кеттік!
Dialogue: 0,1:30:00.60,1:30:01.73,Default,,0,0,0,,О, күт!
Dialogue: 0,1:30:03.89,1:30:05.56,Default,,0,0,0,,Біз де барайық (Ранко) Иә.
Dialogue: 0,1:30:05.81,1:30:07.77,Default,,0,0,0,,Мен Канканның анасына алғыс айтуым керек.
Dialogue: 0,1:30:08.69,1:30:09.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:30:10.15,1:30:12.24,Default,,0,0,0,,Оны да іздеп көрейік (кішілер) Иә!
Dialogue: 0,1:30:26.13,1:30:26.96,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,1:30:28.67,1:30:31.63,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:30:38.30,1:30:40.64,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:30:40.72,1:30:43.52,Default,,0,0,0,,Қазірдің өзінде... осындай салқынқандылықпен
Dialogue: 0,1:30:43.98,1:30:45.14,Default,,0,0,0,,Мен суық тигіземін.
Dialogue: 0,1:30:48.44,1:30:50.77,Default,,0,0,0,,Сау көрінгеніңізге қуаныштымын.
Dialogue: 0,1:30:51.65,1:30:56.36,Default,,0,0,0,,Әкем жаңа жыл күні үйге келмеді, сондықтан мен оны сағындым.
Dialogue: 0,1:30:58.12,1:30:59.07,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,1:30:59.74,1:31:01.33,Default,,0,0,0,,Сіз ешқашан кешірім сұрамайсыз
Dialogue: 0,1:31:01.95,1:31:02.66,Default,,0,0,0,,А...
Dialogue: 0,1:31:03.70,1:31:05.16,Default,,0,0,0,,Аналар-
Dialogue: 0,1:31:05.37,1:31:08.83,Default,,0,0,0,,Каннаның сезімін ескермей қарсы болғаным үшін кешірім сұраймын.
Dialogue: 0,1:31:10.71,1:31:12.71,Default,,0,0,0,,Мен келесі жолы сахнаға барамын.
Dialogue: 0,1:31:13.38,1:31:14.17,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:31:14.59,1:31:17.68,Default,,0,0,0,,Кейде әкемнен мені сапарға шығарып салуын сұрауға тура келеді.
Dialogue: 0,1:31:20.51,1:31:23.81,Default,,0,0,0,,Иә, күтемін... Күтемін!
Dialogue: 0,1:31:25.85,1:31:28.44,Default,,0,0,0,,(Канна жылайды)
Dialogue: 0,1:31:30.48,1:31:31.44,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:31:52.92,1:31:53.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:54.42,1:31:55.30,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,1:32:07.98,1:32:08.69,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,1:32:08.77,1:32:11.31,Default,,0,0,0,,Мен сіздің сахнаңызды интернеттен көрдім.
Dialogue: 0,1:32:11.48,1:32:12.56,Default,,0,0,0,,Не? (4 адам) А...
Dialogue: 0,1:32:12.98,1:32:14.90,Default,,0,0,0,,Барлық бишілер де көңілді.
Dialogue: 0,1:32:15.48,1:32:18.20,Default,,0,0,0,,Біздің де ойнағымыз келетін ән түрі
Dialogue: 0,1:32:20.53,1:32:21.70,Default,,0,0,0,,Әсіресе Аяме...
Dialogue: 0,1:32:22.49,1:32:23.28,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:23.58,1:32:24.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:26.04,1:32:27.91,Default,,0,0,0,,Жоғары бағаланған үй ішіндегі романс...
Dialogue: 0,1:32:28.00,1:32:28.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:28.96,1:32:30.08,Default,,0,0,0,,Өтірікші! (Хиба және т.б.) Иә!
Dialogue: 0,1:32:30.17,1:32:32.75,Default,,0,0,0,,Мен оны мүлде байқамадым Уау~
Dialogue: 0,1:32:32.83,1:32:34.80,Default,,0,0,0,,Ало~ха~ (жалпақ) Өтінемін, үндемеңіз!
Dialogue: 0,1:32:34.88,1:32:36.59,Default,,0,0,0,,Аямеге айтпа...
Dialogue: 0,1:32:37.71,1:32:38.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:39.47,1:32:40.76,Default,,0,0,0,,Ihihi…
Dialogue: 0,1:32:41.51,1:32:42.34,Default,,0,0,0,,Не?
Dialogue: 0,1:32:42.43,1:32:45.31,Default,,0,0,0,,Жеңіске жетпегеніңмен неге сонша бақытты көрінесің?
Dialogue: 0,1:32:45.60,1:32:46.47,Default,,0,0,0,,Бұл...
Dialogue: 0,1:32:46.93,1:32:50.81,Default,,0,0,0,,Себебі... біз өзімізше билей алдық.
Dialogue: 0,1:32:52.65,1:32:53.69,Default,,0,0,0,,Шынында да, иә.
Dialogue: 0,1:32:54.65,1:32:58.40,Default,,0,0,0,,Мен зейнеткерлікке шыққанға дейін барлығының өскенін көргеніме қуаныштымын.
Dialogue: 0,1:32:58.74,1:32:59.53,Default,,0,0,0,,Зейнеткерлікке шығу?
Dialogue: 0,1:33:00.07,1:33:00.74,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:33:01.11,1:33:03.37,Default,,0,0,0,,Наурыздың аяғында би болудан шығамын.
Dialogue: 0,1:33:05.70,1:33:08.20,Default,,0,0,0,,Кіші балаларыма жол беретін кез келді.
Dialogue: 0,1:33:08.95,1:33:12.75,Default,,0,0,0,,Пуара Аямеден мен өзімнің шын атыма, Аяме Шиоязакиге қайта ораламын.
Dialogue: 0,1:33:13.50,1:33:14.46,Default,,0,0,0,,Е...
Dialogue: 0,1:33:38.69,1:33:39.82,Default,,0,0,0,,Аяме Сенпай
Dialogue: 0,1:33:46.28,1:33:49.83,Default,,0,0,0,,Мен бұл ағадан бір нәрсе сұрағым келді...
Dialogue: 0,1:33:50.29,1:33:50.95,Default,,0,0,0,,Не?
Dialogue: 0,1:33:51.83,1:33:55.88,Default,,0,0,0,,Менің үлкенімнің сахналық есімі - Пуара...
Dialogue: 0,1:33:57.04,1:33:58.55,Default,,0,0,0,,Оны әпкем киген...
Dialogue: 0,1:33:59.71,1:34:00.46,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:34:01.09,1:34:02.67,Default,,0,0,0,,Мен жеке биші болған кезде—
Dialogue: 0,1:34:02.84,1:34:05.47,Default,,0,0,0,,Маған Мари қойған есім берілді.
Dialogue: 0,1:34:11.27,1:34:15.02,Default,,0,0,0,,Мари де осында мәңгі билейтін болады...
Dialogue: 0,1:34:17.11,1:34:19.61,Default,,0,0,0,,Бірақ сіз кірдіңіз.
Dialogue: 0,1:34:20.03,1:34:20.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:34:21.49,1:34:24.45,Default,,0,0,0,,Қуандым қатты қуандым
Dialogue: 0,1:34:25.41,1:34:26.41,Default,,0,0,0,,Өйткені шындық...
Dialogue: 0,1:34:27.24,1:34:30.20,Default,,0,0,0,,Менің әпкемнің де хула биіне қызығушылығы бар сияқты.
Dialogue: 0,1:34:30.66,1:34:34.79,Default,,0,0,0,,Болашақта осында қосылсам, апаларыммен билей аламын ба?
Dialogue: 0,1:34:38.38,1:34:40.34,Default,,0,0,0,,Себебі сіз осылай дедіңіз.
Dialogue: 0,1:34:42.96,1:34:46.05,Default,,0,0,0,,Ақиқат атын алған мен сенімен билеймін.
Dialogue: 0,1:34:46.68,1:34:49.47,Default,,0,0,0,,Мен шындық туралы арманымды орындағандай болдым.
Dialogue: 0,1:34:50.76,1:34:52.31,Default,,0,0,0,,Өйткені Пуара...
Dialogue: 0,1:34:54.94,1:34:55.98,Default,,0,0,0,,Шындық пен күн...
Dialogue: 0,1:34:57.90,1:35:02.65,Default,,0,0,0,,Екеуің жалғызсыңдар, Күннің гүлі
Dialogue: 0,1:35:03.78,1:35:04.53,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:05.90,1:35:08.24,Default,,0,0,0,,Үлкен әпке… Үлкен әпке
Dialogue: 0,1:35:08.57,1:35:09.24,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,1:35:21.63,1:35:22.71,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,1:35:24.05,1:35:25.42,Default,,0,0,0,,Ало~ха~
Dialogue: 0,1:35:28.76,1:35:30.68,Default,,0,0,0,,Бұл сіздің әпкеңіз болды ма...?
Dialogue: 0,1:35:31.14,1:35:33.56,Default,,0,0,0,,Сіз байқадыңыз.
Dialogue: 0,1:35:34.47,1:35:35.23,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:35:35.35,1:35:38.06,Default,,0,0,0,,Мен әпкемнің аузын скотчпен жауып, қоқыс салатын қапқа салдым.
Dialogue: 0,1:35:38.69,1:35:42.23,Default,,0,0,0,,Ал, егер тұлып сөйлей алса, мен солай істер едім.
Dialogue: 0,1:35:42.32,1:35:43.23,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:35:43.32,1:35:44.44,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,1:35:44.53,1:35:47.07,Default,,0,0,0,,Одан гөрі аузыңызға скотч жаппаңыз.
Dialogue: 0,1:35:47.15,1:35:47.82,Default,,0,0,0,,Е...
Dialogue: 0,1:35:47.90,1:35:49.45,Default,,0,0,0,,Оны қоқыс салатын қаптарға салуға болмайды
Dialogue: 0,1:35:49.70,1:35:50.37,Default,,0,0,0,,Иә...
Dialogue: 0,1:35:50.45,1:35:52.37,Default,,0,0,0,,Шкаф та кішкене кішкентай болды.
Dialogue: 0,1:35:52.45,1:35:53.33,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:35:53.58,1:35:56.16,Default,,0,0,0,,Сонда мен жай ғана тұлыпқа қайта ораламын.
Dialogue: 0,1:35:56.50,1:35:58.00,Default,,0,0,0,,Иә... Иә?
Dialogue: 0,1:35:58.71,1:36:00.00,Default,,0,0,0,,Ало~ха~
Dialogue: 0,1:36:04.09,1:36:05.63,Default,,0,0,0,,Ало~ха~
Dialogue: 0,1:36:07.47,1:36:10.18,Default,,0,0,0,,Хиуа сәлемдесу~
Dialogue: 0,1:36:10.39,1:36:11.26,Default,,0,0,0,,Оны айтпа
Dialogue: 0,1:36:11.85,1:36:14.51,Default,,0,0,0,,Өйткені aloha «қош бол» дегенді де білдіреді...
Dialogue: 0,1:36:16.98,1:36:22.19,Default,,0,0,0,,Әпкеңмен кездесе де, қайта қоштасқым келмейді.
Dialogue: 0,1:36:22.90,1:36:23.73,Default,,0,0,0,,Хиуа…
Dialogue: 0,1:36:27.07,1:36:28.15,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,1:36:29.20,1:36:32.28,Default,,0,0,0,,Эй Хива, маған гүлді әшекейлеп бере аласың ба?
Dialogue: 0,1:36:32.66,1:36:34.28,Default,,0,0,0,,Өтіп кеткен сияқты
Dialogue: 0,1:36:34.78,1:36:35.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:42.08,1:36:42.96,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:01.23,1:37:01.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:09.36,1:37:10.07,Default,,0,0,0,,Уф...
Dialogue: 0,1:37:18.37,1:37:19.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:34.26,1:37:36.10,Default,,0,0,0,,Қазір бәрі жақсы, Хива.
Dialogue: 0,1:37:38.18,1:37:41.43,Default,,0,0,0,,Қатты жел соқса, құлап кететін сияқтымын.
Dialogue: 0,1:37:41.52,1:37:43.44,Default,,0,0,0,,Мен өз басым уайымдадым, бірақ
Dialogue: 0,1:37:44.35,1:37:46.86,Default,,0,0,0,,Сіз кішкентай бүршік сияқты болдың
Dialogue: 0,1:37:47.40,1:37:49.11,Default,,0,0,0,,Гүлдер дұрыс гүлдеді
Dialogue: 0,1:38:00.04,1:38:03.08,Default,,0,0,0,,Мен осындамын... мында.
Dialogue: 0,1:38:04.08,1:38:07.46,Default,,0,0,0,,Хибаның жүрегінде, күлімдеуінде
Dialogue: 0,1:38:09.42,1:38:14.22,Default,,0,0,0,,Ұмытпа, Хиба мен Мари екеуміз...
Dialogue: 0,1:38:19.35,1:38:21.52,Default,,0,0,0,,Бос уақыт...
Dialogue: 0,1:38:25.10,1:38:28.27,Default,,0,0,0,,Сонымен Хиба Алоха~
Dialogue: 0,1:38:30.65,1:38:31.65,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,1:38:41.45,1:38:43.37,Default,,0,0,0,,Ало~ха…
Dialogue: 0,1:39:00.68,1:39:03.73,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:39:15.95,1:39:17.66,Default,,0,0,0,,Ало~ха~!
Dialogue: 0,1:39:18.24,1:39:19.74,Default,,0,0,0,,Ало~ха~!
Dialogue: 0,1:39:23.45,1:39:24.58,Default,,0,0,0,,Пуара-сан!
Dialogue: 0,1:39:25.00,1:39:26.79,Default,,0,0,0,,Аяме-сан! Аямечан!
Dialogue: 0,1:39:31.75,1:39:33.42,Default,,0,0,0,,Мен бүгін бос емеспін.
Dialogue: 0,1:39:33.80,1:39:36.13,Default,,0,0,0,,Spa Resort Hawaiians-ке қош келдіңіз—
Dialogue: 0,1:39:36.47,1:39:37.55,Default,,0,0,0,,Рахмет
Dialogue: 0,1:39:37.68,1:39:39.72,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:39:40.43,1:39:43.31,Default,,0,0,0,,Қызықты нәрселер, ауыртпалықтар, көңілсіз нәрселер
Dialogue: 0,1:39:43.89,1:39:45.31,Default,,0,0,0,,Әртүрлі заттар болды...
Dialogue: 0,1:39:46.06,1:39:49.02,Default,,0,0,0,,Биші болғаныма 14 жыл болды...
Dialogue: 0,1:39:49.56,1:39:53.36,Default,,0,0,0,,Өйткені мұндағылардың бәрі бізге үлкен қолдау көрсетті.
Dialogue: 0,1:39:55.28,1:39:56.99,Default,,0,0,0,,Менің достарым да...
Dialogue: 0,1:39:57.99,1:40:01.12,Default,,0,0,0,,Кіші балаларым да мені қолдады.
Dialogue: 0,1:40:02.37,1:40:04.08,Default,,0,0,0,,Би зейнетке шығады, бірақ—
Dialogue: 0,1:40:04.54,1:40:07.12,Default,,0,0,0,,Өмір кезеңдері жалғасады.
Dialogue: 0,1:40:07.37,1:40:10.17,Default,,0,0,0,,Аяме~ Бұл әдемі~
Dialogue: 0,1:40:10.38,1:40:14.50,Default,,0,0,0,,Барлығыңыз өз сахналарыңызда жарқырайды деп сенемін.
Dialogue: 0,1:40:17.05,1:40:21.26,Default,,0,0,0,,Енді бұл менің Пуара Аяме ретіндегі соңғы кезеңім.
Dialogue: 0,1:40:22.43,1:40:27.06,Default,,0,0,0,,Бұл ән байланыстарыңды жалғайтын кемпірқосақ болсын.
Dialogue: 0,1:40:34.73,1:40:40.74,Default,,0,0,0,,♪～
Dialogue: 0,1:42:22.38,1:42:28.39,Default,,0,0,0,,～♪
Dialogue: 0,1:42:28.47,1:42:30.93,Default,,0,0,0,,Жүр! Хула қыз!
Dialogue: 0,1:43:01.80,1:43:03.13,Default,,0,0,0,,Гүлдер гүлдейді
Dialogue: 0,1:43:05.30,1:43:06.51,Default,,0,0,0,,Қазірдің өзінде гүлдер...
Dialogue: 0,1:43:14.18,1:43:17.73,Default,,0,0,0,,Аспанға қарай гүлдейді
Dialogue: 0,1:43:37.92,1:43:41.21,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,1:43:42.75,1:43:48.68,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,1:44:38.81,1:44:39.89,Default,,0,0,0,,Хехе
Dialogue: 0,1:44:40.10,1:44:46.11,Default,,0,0,0,,♪～
Dialogue: 0,1:48:42.51,1:48:48.52,Default,,0,0,0,,～♪
