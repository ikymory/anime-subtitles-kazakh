Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:54.84,0:00:56.68,Default,,0,0,0,,Орманның тереңінде
Dialogue: 0,0:00:57.55,0:01:00.51,Default,,0,0,0,,Жәндіктер үшін жұмақ бар
Dialogue: 0,0:01:02.14,0:01:05.52,Default,,0,0,0,,Мұнда орман перілері мен жәндіктер
Dialogue: 0,0:01:05.64,0:01:08.02,Default,,0,0,0,,Олар тату-тәтті, тату-тәтті өмір сүрді.
Dialogue: 0,0:01:08.86,0:01:13.28,Default,,0,0,0,,Бірақ бұл орманның тыныштығын бұзатын бірдеңе пайда болды.
Dialogue: 0,0:01:17.57,0:01:18.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:19.12,0:01:19.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:25.08,0:01:27.62,Default,,0,0,0,,Уау! Міне бітті!
Dialogue: 0,0:01:28.17,0:01:29.58,Default,,0,0,0,,Ня? (1-ші қоңыз) Эй!
Dialogue: 0,0:01:30.84,0:01:33.05,Default,,0,0,0,,Хмф (Кокусвагата 3) Уф... Уау.
Dialogue: 0,0:01:34.05,0:01:35.88,Default,,0,0,0,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:01:36.42,0:01:38.68,Default,,0,0,0,,Фуфуфуфуфу… Жақсы.
Dialogue: 0,0:01:39.43,0:01:40.85,Default,,0,0,0,,Олардың ешқайсысы қашып кетпесін!
Dialogue: 0,0:01:41.97,0:01:42.81,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:01:44.77,0:01:45.73,Default,,0,0,0,,Хамф!
Dialogue: 0,0:01:45.85,0:01:46.98,Default,,0,0,0,,Уау
Dialogue: 0,0:01:47.94,0:01:49.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:49.15,0:01:50.23,Default,,0,0,0,,Тоқта! (2-қоңыз) Иә?
Dialogue: 0,0:01:57.74,0:01:59.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:01.20,0:02:03.08,Default,,0,0,0,,Осы орманның тыныштығын бұзған адам —
Dialogue: 0,0:02:03.45,0:02:04.91,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:02:04.99,0:02:07.62,Default,,0,0,0,,(Қоңыз 2 үреді)
Dialogue: 0,0:02:07.87,0:02:10.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:11.84,0:02:12.71,Default,,0,0,0,,Хмф! (2-қоңыз) Уа!
Dialogue: 0,0:02:13.00,0:02:13.92,Default,,0,0,0,,Га
Dialogue: 0,0:02:16.21,0:02:17.76,Default,,0,0,0,,Амансың ба? Кішкентай бұғы қоңызы
Dialogue: 0,0:02:17.97,0:02:20.47,Default,,0,0,0,,Ух... у... попо
Dialogue: 0,0:02:24.97,0:02:25.97,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:02:29.44,0:02:31.35,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:02:33.40,0:02:36.53,Default,,0,0,0,,Король Торнадо лақтыру!
Dialogue: 0,0:02:39.15,0:02:40.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:40.16,0:02:41.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:57.84,0:02:59.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:59.34,0:03:02.43,Default,,0,0,0,,Орман перісі Попо мен Мушикинг күш біріктіреді
Dialogue: 0,0:03:02.55,0:03:06.14,Default,,0,0,0,,Біз бүгін де орманды қорғау үшін күресіп жатырмыз.
Dialogue: 0,0:03:06.26,0:03:07.68,Default,,0,0,0,,Аня Форджер
Dialogue: 0,0:03:07.89,0:03:11.94,Default,,0,0,0,,Мен, қарғыс атқыр Мушикинг
Dialogue: 0,0:03:14.36,0:03:16.77,Default,,0,0,0,,Қазір қуаныңыз.
Dialogue: 0,0:03:16.90,0:03:20.32,Default,,0,0,0,,Бірақ бұл жігіт аяқталғанша ғана.
Dialogue: 0,0:03:20.74,0:03:25.49,Default,,0,0,0,,Мен сені міндетті түрде жеңіп, мына орманды кеніш етемін.
Dialogue: 0,0:03:25.62,0:03:28.75,Default,,0,0,0,,Хехе... хахаха...
Dialogue: 0,0:03:29.20,0:03:33.04,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:03:57.36,0:03:58.78,Default,,0,0,0,,Попо
Dialogue: 0,0:03:59.36,0:04:01.36,Default,,0,0,0,,Оян, таң атқан
Dialogue: 0,0:04:01.49,0:04:03.53,Default,,0,0,0,,Хмм... сәл ғана
Dialogue: 0,0:04:04.07,0:04:07.49,Default,,0,0,0,,Таңертеңгілік тамақты жинау Попоның міндеті.
Dialogue: 0,0:04:07.62,0:04:09.45,Default,,0,0,0,,Эй, оян.
Dialogue: 0,0:04:09.58,0:04:10.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:10.79,0:04:12.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:14.25,0:04:15.88,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:04:17.13,0:04:18.84,Default,,0,0,0,,Попо! иә?
Dialogue: 0,0:04:19.25,0:04:20.80,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:04:21.71,0:04:23.13,Default,,0,0,0,,Уа!
Dialogue: 0,0:04:24.55,0:04:27.68,Default,,0,0,0,,Хей... Хаа... Хаа...
Dialogue: 0,0:04:27.80,0:04:30.14,Default,,0,0,0,,Мен аштан өліп бара жатырмын…
Dialogue: 0,0:04:30.27,0:04:32.23,Default,,0,0,0,,Ой, уау, уау!
Dialogue: 0,0:04:32.56,0:04:33.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:33.73,0:04:35.69,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:04:35.94,0:04:38.82,Default,,0,0,0,,Ха... Кваккккккккккккккккккк солай...
Dialogue: 0,0:04:39.02,0:04:40.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:42.11,0:04:43.90,Default,,0,0,0,,Мен... жек көремін!
Dialogue: 0,0:04:44.07,0:04:45.86,Default,,0,0,0,,Міне... маған біреу көмектессін!
Dialogue: 0,0:04:45.95,0:04:49.12,Default,,0,0,0,,Ха ха ха хо хо хо
Dialogue: 0,0:04:49.24,0:04:50.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:50.79,0:04:52.58,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:04:52.87,0:04:57.42,Default,,0,0,0,,Уау! Ах! Ах!
Dialogue: 0,0:04:57.50,0:04:59.13,Default,,0,0,0,,Окабе мырза, өтінемін, тоқтаңыз…
Dialogue: 0,0:04:59.34,0:05:01.84,Default,,0,0,0,,Ах! Уф! Бум…
Dialogue: 0,0:05:01.96,0:05:03.59,Default,,0,0,0,,А-а-а-ай
Dialogue: 0,0:05:03.72,0:05:05.38,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:05.51,0:05:07.34,Default,,0,0,0,,өтіңіз… Тыныштық
Dialogue: 0,0:05:07.64,0:05:10.47,Default,,0,0,0,,Қарғыс атсын... бұл... Каа!
Dialogue: 0,0:05:10.60,0:05:12.77,Default,,0,0,0,,Қарауды доғар!
Dialogue: 0,0:05:12.89,0:05:13.77,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:05:14.06,0:05:15.73,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:05:15.81,0:05:18.69,Default,,0,0,0,,Иә! Хехе... бұл не деген нәрсе! Бум…
Dialogue: 0,0:05:18.81,0:05:19.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.48,0:05:22.90,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:05:23.03,0:05:25.11,Default,,0,0,0,,Эй, сен өзіңнің жақсы екеніне сенімдісің бе?
Dialogue: 0,0:05:25.19,0:05:27.24,Default,,0,0,0,,Сіз жақсы екеніңізді айттыңыз.
Dialogue: 0,0:05:27.36,0:05:29.20,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:29.32,0:05:30.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:30.66,0:05:33.20,Default,,0,0,0,,А... күт, күт, күт
Dialogue: 0,0:05:36.21,0:05:38.50,Default,,0,0,0,,Маған аздап көмектесіңізші.
Dialogue: 0,0:05:39.42,0:05:42.09,Default,,0,0,0,,Күрсін... Менде бір қорқынышты оқиға болды.
Dialogue: 0,0:05:42.21,0:05:43.59,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:05:43.71,0:05:45.17,Default,,0,0,0,,олар сен сияқты жігітті көтереді. Ал содан кейін—
Dialogue: 0,0:05:45.30,0:05:47.26,Default,,0,0,0,,О... сәл күте тұрыңыз.
Dialogue: 0,0:05:47.38,0:05:48.34,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:05:48.47,0:05:50.09,Default,,0,0,0,,А... енді жоқ, а
Dialogue: 0,0:05:50.22,0:05:51.85,Default,,0,0,0,,Не болды? Мықты болыңыз!
Dialogue: 0,0:05:52.14,0:05:54.72,Default,,0,0,0,,Менің қарным ашты, бірдеңе жеймін.
Dialogue: 0,0:05:54.85,0:05:57.23,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:05:57.35,0:05:58.81,Default,,0,0,0,,Алда қорек бар...
Dialogue: 0,0:05:58.90,0:05:59.81,Default,,0,0,0,,Азық беретін жер? кет!
Dialogue: 0,0:05:59.90,0:06:01.06,Default,,0,0,0,,Кеттік! Барайық!
Dialogue: 0,0:06:01.19,0:06:02.90,Default,,0,0,0,,Иә, иә... хаха
Dialogue: 0,0:06:03.02,0:06:05.28,Default,,0,0,0,,Көңіл-күйіңіз жақсы, хехехе...
Dialogue: 0,0:06:06.11,0:06:07.82,Default,,0,0,0,,Тренинг? Иә
Dialogue: 0,0:06:07.95,0:06:11.24,Default,,0,0,0,,Мен болған орманда мықты адамдар жоқ.
Dialogue: 0,0:06:11.37,0:06:13.24,Default,,0,0,0,,Сондықтан мен барған сайын
Dialogue: 0,0:06:13.37,0:06:14.83,Default,,0,0,0,,Мен күшті біреумен күрескім келеді...
Dialogue: 0,0:06:14.95,0:06:16.70,Default,,0,0,0,,Мен оқу сапарымен келдім.
Dialogue: 0,0:06:16.83,0:06:18.25,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:06:18.37,0:06:20.54,Default,,0,0,0,,Хе... бұл маңызды емес.
Dialogue: 0,0:06:20.67,0:06:22.88,Default,,0,0,0,,Менің атым Попо Сіз ше?
Dialogue: 0,0:06:23.00,0:06:25.17,Default,,0,0,0,,Мен бұғы қоңызымын
Dialogue: 0,0:06:25.25,0:06:27.09,Default,,0,0,0,,Мені Судзибуто деп атаңыз.
Dialogue: 0,0:06:27.22,0:06:28.59,Default,,0,0,0,,Құрметпен, Судзибуто!
Dialogue: 0,0:06:28.72,0:06:30.13,Default,,0,0,0,,Қайырлы таң Попо
Dialogue: 0,0:06:30.55,0:06:32.51,Default,,0,0,0,,Қайырлы таң аралар
Dialogue: 0,0:06:32.64,0:06:33.60,Default,,0,0,0,,О Попо-чан
Dialogue: 0,0:06:33.76,0:06:34.93,Default,,0,0,0,,Сәлем Канабун
Dialogue: 0,0:06:35.06,0:06:36.56,Default,,0,0,0,,Сіз не істеп жатырсыз? Осындай жерде
Dialogue: 0,0:06:36.81,0:06:38.14,Default,,0,0,0,,Барып тамақ ал.
Dialogue: 0,0:06:38.27,0:06:39.27,Default,,0,0,0,,Қайырлы таң Попо
Dialogue: 0,0:06:39.60,0:06:41.10,Default,,0,0,0,,Қайырлы таң қарлығаш құйрықты көбелек
Dialogue: 0,0:06:41.23,0:06:42.73,Default,,0,0,0,,Жақында кездескенше Попо
Dialogue: 0,0:06:42.86,0:06:44.40,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:06:44.52,0:06:45.73,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:46.57,0:06:49.20,Default,,0,0,0,,Керемет, иә?
Dialogue: 0,0:06:49.28,0:06:51.95,Default,,0,0,0,,Жоқ, бәрі Попомен амандасып жатты, солай ма?
Dialogue: 0,0:06:52.07,0:06:54.24,Default,,0,0,0,,Попо танымал.
Dialogue: 0,0:06:54.37,0:06:55.91,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:55.99,0:06:59.75,Default,,0,0,0,,Жоқ, бұл керемет. Попо осы орманның бастығы ма?
Dialogue: 0,0:06:59.87,0:07:01.37,Default,,0,0,0,,Жер
Dialogue: 0,0:07:01.46,0:07:03.58,Default,,0,0,0,,Хехе... Мүмкін Попо шығар?
Dialogue: 0,0:07:03.71,0:07:05.55,Default,,0,0,0,,Ол Мушикингпен таныс болған.
Dialogue: 0,0:07:05.67,0:07:07.38,Default,,0,0,0,,Иә, біз доспыз.
Dialogue: 0,0:07:07.51,0:07:08.46,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:07:08.92,0:07:10.88,Default,,0,0,0,,Әй... не?
Dialogue: 0,0:07:11.01,0:07:13.14,Default,,0,0,0,,Мен Мушикингпен жарысқым келеді.
Dialogue: 0,0:07:13.26,0:07:13.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.05,0:07:15.30,Default,,0,0,0,,Мушикингпен жарысу—
Dialogue: 0,0:07:15.43,0:07:18.89,Default,,0,0,0,,Мен ормандағы барлық адамдарға өзімнің күшті екенімді дәлелдегім келеді.
Dialogue: 0,0:07:19.02,0:07:21.44,Default,,0,0,0,,Әй, мен Мушикингпен танысуға рұқсат етіңізші.
Dialogue: 0,0:07:21.56,0:07:22.65,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:07:22.77,0:07:27.40,Default,,0,0,0,,Менің ойымша, Мушикинг мұндай нәрсе үшін сенімен төбелеседі деп ойламаймын.
Dialogue: 0,0:07:27.90,0:07:29.86,Default,,0,0,0,,Мен қиындыққа тап болдым. А, онда...
Dialogue: 0,0:07:29.99,0:07:31.36,Default,,0,0,0,,Сіз мені таныстырсаңыз болғаны.
Dialogue: 0,0:07:31.61,0:07:32.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:33.11,0:07:34.87,Default,,0,0,0,,Сізді таныстыру үшін.
Dialogue: 0,0:07:34.99,0:07:37.41,Default,,0,0,0,,Сіз маған ұрыспаймын деп уәде бере аласыз ба?
Dialogue: 0,0:07:37.54,0:07:39.50,Default,,0,0,0,,Уәде беремін, өтінемін.
Dialogue: 0,0:07:39.62,0:07:40.79,Default,,0,0,0,,Сәлем, өтінемін
Dialogue: 0,0:07:40.91,0:07:42.50,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:42.62,0:07:46.46,Default,,0,0,0,,Рахмет! Жарайды, ең алдымен тамақтандыру аймағынан бастайық!
Dialogue: 0,0:07:46.59,0:07:49.09,Default,,0,0,0,,Сәлем! Күте тұрыңыз!
Dialogue: 0,0:07:49.51,0:07:53.01,Default,,0,0,0,,А-а... соңғы кездері жарқырауын жоғалтқан сияқты.
Dialogue: 0,0:07:53.22,0:07:57.22,Default,,0,0,0,,(қоңыздар сөйлейді)
Dialogue: 0,0:08:02.10,0:08:04.81,Default,,0,0,0,,Мен осылай дедім.
Dialogue: 0,0:08:05.31,0:08:08.44,Default,,0,0,0,,Менің шеберлігімді шынымен пайдаланғыңыз келе ме?
Dialogue: 0,0:08:08.86,0:08:12.11,Default,,0,0,0,,Сосын меннен әлдеқайда үлкен бұғылар мен қоңыздар бар.
Dialogue: 0,0:08:12.24,0:08:14.41,Default,,0,0,0,,Мен қалтырай бастадым.
Dialogue: 0,0:08:14.61,0:08:16.87,Default,,0,0,0,,Сәлем! салқын суджибуто
Dialogue: 0,0:08:17.03,0:08:18.53,Default,,0,0,0,,Хэхе! мен...
Dialogue: 0,0:08:18.66,0:08:21.04,Default,,0,0,0,,Тіпті шетелдік мүйізтұмсықтар мен бұғы қоңыздары...
Dialogue: 0,0:08:21.16,0:08:23.33,Default,,0,0,0,,Мен аздап қорықпаймын.
Dialogue: 0,0:08:23.62,0:08:26.96,Default,,0,0,0,,Бұл жуан төменгі жақ сүйегімен кез келген мықты мақтанатын.
Dialogue: 0,0:08:27.08,0:08:29.21,Default,,0,0,0,,Мен сені қанша алысқа барсаң да ұшырып жіберемін!
Dialogue: 0,0:08:29.34,0:08:30.76,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:08:30.84,0:08:32.59,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:08:32.72,0:08:33.67,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:08:33.76,0:08:36.18,Default,,0,0,0,,(Бұғы қоңызының айқайы)
Dialogue: 0,0:08:36.26,0:08:37.55,Default,,0,0,0,,Ах-хэй
Dialogue: 0,0:08:37.68,0:08:38.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:39.01,0:08:40.35,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:08:40.47,0:08:41.77,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:08:42.77,0:08:44.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:44.60,0:08:46.85,Default,,0,0,0,,Қызыл… көз…
Dialogue: 0,0:08:47.06,0:08:47.94,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:48.06,0:08:49.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.58,0:09:01.66,Default,,0,0,0,,Бұл Геркулес Рики Блу!
Dialogue: 0,0:09:01.79,0:09:03.00,Default,,0,0,0,,Барлығының назарына!
Dialogue: 0,0:09:03.91,0:09:05.79,Default,,0,0,0,,Судзибутодан бірдеңе сұрайық!
Dialogue: 0,0:09:05.92,0:09:06.62,Default,,0,0,0,,Не? Дұрыс!
Dialogue: 0,0:09:06.71,0:09:08.38,Default,,0,0,0,,Сіз бөтен қоңыздардан қорықпайсыз, солай ма?
Dialogue: 0,0:09:08.46,0:09:09.04,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:09:09.46,0:09:11.42,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:11.71,0:09:13.63,Default,,0,0,0,,Жақсысың ба? Мықты болыңыз!
Dialogue: 0,0:09:13.76,0:09:15.22,Default,,0,0,0,,Өтінемін, Судзибуто!
Dialogue: 0,0:09:16.01,0:09:16.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.05,0:09:19.05,Default,,0,0,0,,Судзибуто! Қайда бардың?
Dialogue: 0,0:09:19.18,0:09:22.01,Default,,0,0,0,,Ол дәл қазір сол жаққа қашып кетер еді.
Dialogue: 0,0:09:22.14,0:09:23.64,Default,,0,0,0,,Не? Сол сияқты...
Dialogue: 0,0:09:23.77,0:09:25.06,Default,,0,0,0,,Ах
Dialogue: 0,0:09:25.77,0:09:26.77,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:09:28.52,0:09:30.44,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:09:31.48,0:09:32.65,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:09:34.94,0:09:36.82,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,0:09:36.90,0:09:38.32,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:09:41.37,0:09:42.74,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:09:42.87,0:09:44.45,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:09:54.09,0:09:55.55,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:09:56.67,0:10:00.30,Default,,0,0,0,,Осы орманның тыныштығын бұзған адамды кешіремін!
Dialogue: 0,0:10:01.18,0:10:02.26,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:05.02,0:10:06.77,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:10:08.89,0:10:09.73,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:12.69,0:10:14.07,Default,,0,0,0,,Мушикинг Сіз жасадыңыз!
Dialogue: 0,0:10:14.19,0:10:15.74,Default,,0,0,0,,Әлі жоқ! иә?
Dialogue: 0,0:10:18.53,0:10:19.36,Default,,0,0,0,,Уау! Ах
Dialogue: 0,0:10:19.53,0:10:20.36,Default,,0,0,0,,Уау! қауіпті!
Dialogue: 0,0:10:22.37,0:10:24.08,Default,,0,0,0,,Мушикинг Попо, артта қал.
Dialogue: 0,0:10:24.20,0:10:25.04,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:27.08,0:10:27.91,Default,,0,0,0,,Уаааа
Dialogue: 0,0:10:28.83,0:10:29.67,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:30.08,0:10:30.92,Default,,0,0,0,,Уау
Dialogue: 0,0:10:31.08,0:10:32.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:32.92,0:10:33.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:35.17,0:10:36.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:36.67,0:10:38.63,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:39.18,0:10:41.09,Default,,0,0,0,,Ах... Ах... Кешіріңіз.
Dialogue: 0,0:10:41.47,0:10:42.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:47.93,0:10:49.73,Default,,0,0,0,,Сіз мұны әлі де жасай аласыз ба?
Dialogue: 0,0:10:50.35,0:10:53.73,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:10:53.86,0:10:55.98,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:10:56.11,0:10:58.11,Default,,0,0,0,,Ніл бойындағы барлық базар саудагерлері
Dialogue: 0,0:10:58.19,0:11:01.07,Default,,0,0,0,,Рики, саған жарайды.
Dialogue: 0,0:11:01.91,0:11:03.78,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:11:04.28,0:11:05.49,Default,,0,0,0,,Қазір! Бар!
Dialogue: 0,0:11:05.70,0:11:08.20,Default,,0,0,0,,Жирафа ара тісті бұғы қоңызы!
Dialogue: 0,0:11:08.50,0:11:09.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:10.21,0:11:11.62,Default,,0,0,0,,Қауіпті! Мушикинг!
Dialogue: 0,0:11:11.87,0:11:13.58,Default,,0,0,0,,Мені жебе таңдағанына қарамастан, ол маған тимей, қайта қайтты.
Dialogue: 0,0:11:14.34,0:11:15.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:16.88,0:11:18.42,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:11:19.17,0:11:20.80,Default,,0,0,0,,Не деген, тіпті Рикки, хехехе...
Dialogue: 0,0:11:20.93,0:11:22.47,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:11:22.84,0:11:24.89,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:26.35,0:11:28.06,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,0:11:28.35,0:11:29.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:29.27,0:11:31.14,Default,,0,0,0,,Хехе...
Dialogue: 0,0:11:31.27,0:11:33.48,Default,,0,0,0,,Иә, жақсы, Жираф.
Dialogue: 0,0:11:33.69,0:11:36.44,Default,,0,0,0,,Ол жігітпен енді төбелесуге болмайды. Оны құрал ретінде пайдаланыңыз.
Dialogue: 0,0:11:36.65,0:11:37.53,Default,,0,0,0,,Бұл жасырын!
Dialogue: 0,0:11:37.65,0:11:40.49,Default,,0,0,0,,Әлсіз Риккиді қалқан етіп қолдануға қалай дәтің бар!
Dialogue: 0,0:11:43.57,0:11:44.41,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:45.16,0:11:47.37,Default,,0,0,0,,Хи хи хи... Эй
Dialogue: 0,0:11:49.62,0:11:50.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:50.87,0:11:52.21,Default,,0,0,0,,Қайда жоғалып кетті?
Dialogue: 0,0:11:52.33,0:11:54.42,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:11:56.50,0:11:57.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:58.71,0:12:01.13,Default,,0,0,0,,Мен сенің осындай сөздер айтқаныңды ұнатпаймын, Маюши.
Dialogue: 0,0:12:01.38,0:12:03.09,Default,,0,0,0,,Бұл кір! Жирафа!
Dialogue: 0,0:12:03.18,0:12:04.59,Default,,0,0,0,,Сорори Сорори... Иә?
Dialogue: 0,0:12:04.68,0:12:05.55,Default,,0,0,0,,Сорори Сорори…
Dialogue: 0,0:12:05.68,0:12:07.05,Default,,0,0,0,,Судзибуто Сәлем!
Dialogue: 0,0:12:07.43,0:12:09.85,Default,,0,0,0,,Мен Мушикингпен қиналып жатырмын, маған көмектесіңізші!
Dialogue: 0,0:12:09.97,0:12:11.73,Default,,0,0,0,,А, жоқ, жоқ... болды...
Dialogue: 0,0:12:11.85,0:12:15.69,Default,,0,0,0,,Не болды? Сіз шетелдік қоңыздардан қорықпайсыз, солай ма?
Dialogue: 0,0:12:15.81,0:12:17.52,Default,,0,0,0,,Мен қорықпаймын мен қорықпаймын
Dialogue: 0,0:12:17.61,0:12:20.07,Default,,0,0,0,,Бірақ бүгін өзімді жақсы сезінбеймін...
Dialogue: 0,0:12:20.19,0:12:21.99,Default,,0,0,0,,Сіз осындай уақытта не туралы айтып отырсыз?
Dialogue: 0,0:12:25.74,0:12:26.41,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:26.53,0:12:28.03,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,0:12:28.41,0:12:31.75,Default,,0,0,0,,Тоқта, Жираф, мұндай күлкілі күрес әдісі.
Dialogue: 0,0:12:34.29,0:12:34.96,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:12:35.04,0:12:35.92,Default,,0,0,0,,Қалғандары жақсы ілгерілеп жатыр ма екен?
Dialogue: 0,0:12:41.63,0:12:44.26,Default,,0,0,0,,Тұр, Качан (Бакуго), маған ерме!
Dialogue: 0,0:12:46.22,0:12:48.30,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:12:48.55,0:12:50.26,Default,,0,0,0,,Жүр! Аралар!
Dialogue: 0,0:12:55.02,0:12:55.85,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:55.98,0:12:56.81,Default,,0,0,0,,Попо!
Dialogue: 0,0:12:57.06,0:12:58.90,Default,,0,0,0,,Бұл! Тоқта!
Dialogue: 0,0:12:59.11,0:13:01.07,Default,,0,0,0,,Ол балаға тиіспе! Апыр-ай!
Dialogue: 0,0:13:01.94,0:13:02.78,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:13:03.03,0:13:04.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:04.61,0:13:07.74,Default,,0,0,0,,Сіз тек лас жолмен ғана күресе аласыз ба?
Dialogue: 0,0:13:07.87,0:13:09.70,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:13:09.95,0:13:12.16,Default,,0,0,0,,Кешіріңіз! ау
Dialogue: 0,0:13:12.33,0:13:14.12,Default,,0,0,0,,Күте тұрыңыз! Мушикинг!
Dialogue: 0,0:13:14.75,0:13:15.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:15.83,0:13:19.75,Default,,0,0,0,,Аа, егер балаға көмектескің келсе, қарсылық көрсетуді доғар.
Dialogue: 0,0:13:19.88,0:13:20.79,Default,,0,0,0,,Не?
Dialogue: 0,0:13:20.92,0:13:23.71,Default,,0,0,0,,Мушикинг Мен үшін уайымдама, Жирафаны жең!
Dialogue: 0,0:13:23.84,0:13:24.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:24.84,0:13:26.47,Default,,0,0,0,,Қазір! Жирафа!
Dialogue: 0,0:13:28.01,0:13:29.30,Default,,0,0,0,,Уа! Уау
Dialogue: 0,0:13:29.43,0:13:32.89,Default,,0,0,0,,(Мушикингтің ыңырануы)
Dialogue: 0,0:13:33.18,0:13:34.35,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:36.23,0:13:37.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:38.81,0:13:40.52,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,0:13:42.02,0:13:44.49,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,0:13:44.65,0:13:47.53,Default,,0,0,0,,Мушикинг! Уайымдама Попо
Dialogue: 0,0:13:48.28,0:13:49.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:50.32,0:13:52.41,Default,,0,0,0,,Қосқыш Маған не болып жатқаны маңызды емес.
Dialogue: 0,0:13:53.08,0:13:56.50,Default,,0,0,0,,Бірақ Попоға ешқашан тиіспеңіз!
Dialogue: 0,0:13:56.75,0:13:58.62,Default,,0,0,0,,Әрине Мушикинг
Dialogue: 0,0:13:58.75,0:14:00.38,Default,,0,0,0,,Егер сіз қарсы болмасаңыз—
Dialogue: 0,0:14:00.58,0:14:01.79,Default,,0,0,0,,Попо сізге көмектеседі
Dialogue: 0,0:14:01.92,0:14:03.05,Default,,0,0,0,,Біркөз…
Dialogue: 0,0:14:03.17,0:14:03.84,Default,,0,0,0,,Хун
Dialogue: 0,0:14:03.92,0:14:06.80,Default,,0,0,0,,Өтірік деп ойласаңыз, неге қарсылық көрсетпеске?
Dialogue: 0,0:14:07.05,0:14:08.97,Default,,0,0,0,,Попоға не болады?
Dialogue: 0,0:14:09.39,0:14:10.76,Default,,0,0,0,,Ха! Түсіндім
Dialogue: 0,0:14:11.14,0:14:13.06,Default,,0,0,0,,Мен ешқашан қарсылық көрсетпеймін
Dialogue: 0,0:14:13.18,0:14:15.14,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:14:15.27,0:14:16.93,Default,,0,0,0,,Жасай бер! Жирафа!
Dialogue: 0,0:14:17.31,0:14:18.73,Default,,0,0,0,,Ах! Мушикинг!
Dialogue: 0,0:14:18.89,0:14:20.44,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:14:21.23,0:14:22.06,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:14:22.31,0:14:23.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:24.48,0:14:25.32,Default,,0,0,0,,Өте беделді адамды әкеліпсің ғой, иә?
Dialogue: 0,0:14:25.82,0:14:27.19,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:14:28.90,0:14:30.61,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:14:31.03,0:14:32.32,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:14:34.24,0:14:36.29,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:14:39.50,0:14:40.92,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:14:41.04,0:14:42.50,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:14:43.00,0:14:47.46,Default,,0,0,0,,Енді бұл орман менікі хахахаха...
Dialogue: 0,0:14:47.76,0:14:50.43,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:14:50.55,0:14:53.10,Default,,0,0,0,,Ах... Мушикинг!
Dialogue: 0,0:14:54.01,0:14:57.10,Default,,0,0,0,,Мушикинг! Мықты болыңыз
Dialogue: 0,0:14:57.39,0:14:58.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:58.56,0:15:00.73,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:15:01.06,0:15:03.94,Default,,0,0,0,,Жарайды, Мушикингті апарыңыз.
Dialogue: 0,0:15:04.06,0:15:06.53,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:15:06.65,0:15:09.78,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:15:09.90,0:15:12.91,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:15:12.99,0:15:16.87,Default,,0,0,0,,Хяхахаха... хи хи хи хи...
Dialogue: 0,0:15:18.12,0:15:19.83,Default,,0,0,0,,Мушикинг…
Dialogue: 0,0:15:30.76,0:15:31.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:32.30,0:15:33.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:37.35,0:15:38.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:38.35,0:15:40.23,Default,,0,0,0,,Попо Ах...
Dialogue: 0,0:15:43.06,0:15:45.19,Default,,0,0,0,,Амансың ба? Попо
Dialogue: 0,0:15:45.31,0:15:47.73,Default,,0,0,0,,Хмм... Судзибуто
Dialogue: 0,0:15:47.86,0:15:50.15,Default,,0,0,0,,Попо... Кешіріңіз!
Dialogue: 0,0:15:50.24,0:15:51.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:51.57,0:15:55.62,Default,,0,0,0,,Мен шынымен қорқақпын.
Dialogue: 0,0:15:55.74,0:15:58.79,Default,,0,0,0,,Шетелдік қоңыздардан қорықпаймын дедіңіз...
Dialogue: 0,0:15:58.91,0:16:03.04,Default,,0,0,0,,Негізі мен басқа қоңыздармен ешқашан күрескен емеспін.
Dialogue: 0,0:16:03.17,0:16:04.38,Default,,0,0,0,,Суджибут
Dialogue: 0,0:16:04.50,0:16:05.71,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:16:06.17,0:16:08.38,Default,,0,0,0,,Мен Мушикингке көмектескім келді, бірақ...
Dialogue: 0,0:16:08.50,0:16:11.67,Default,,0,0,0,,Мен мұны өзім істей алмаймын деп ойладым.
Dialogue: 0,0:16:11.80,0:16:12.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:13.80,0:16:16.18,Default,,0,0,0,,Кешіріңіз! Ах...
Dialogue: 0,0:16:18.93,0:16:20.93,Default,,0,0,0,,Түсіндім, Судзибуто.
Dialogue: 0,0:16:21.77,0:16:22.77,Default,,0,0,0,,Попо?
Dialogue: 0,0:16:22.89,0:16:26.40,Default,,0,0,0,,Басында Мушикингтей күшті ешкім жоқ.
Dialogue: 0,0:16:26.56,0:16:29.15,Default,,0,0,0,,Сен де солайсың, Попо.
Dialogue: 0,0:16:29.27,0:16:31.15,Default,,0,0,0,,Ах! Мушикинг ше?
Dialogue: 0,0:16:31.28,0:16:32.36,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:16:33.49,0:16:35.32,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:16:35.45,0:16:37.32,Default,,0,0,0,,Мушикингті ара алып кетті!
Dialogue: 0,0:16:37.95,0:16:39.79,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:16:41.66,0:16:43.25,Default,,0,0,0,,Не? Не не?
Dialogue: 0,0:16:43.83,0:16:45.08,Default,,0,0,0,,Рики
Dialogue: 0,0:16:45.21,0:16:48.04,Default,,0,0,0,,Олар бұл жігітті тастап, кетіп қалды.
Dialogue: 0,0:16:48.17,0:16:49.29,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:16:49.75,0:16:50.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:50.55,0:16:52.34,Default,,0,0,0,,Бұл жігіт әлі тірі... (Рикки) Уф...
Dialogue: 0,0:16:52.46,0:16:53.38,Default,,0,0,0,,А? Эй!
Dialogue: 0,0:16:53.51,0:16:54.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:54.51,0:16:56.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:56.76,0:16:58.97,Default,,0,0,0,,Мушикинг осы жігіттің арқасы!
Dialogue: 0,0:16:59.10,0:17:00.22,Default,,0,0,0,,Тоқта, Судзибуто!
Dialogue: 0,0:17:00.31,0:17:01.31,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:01.60,0:17:04.35,Default,,0,0,0,,Қозғалмайтын қарсыласқа шабуыл жасау қауіпті.
Dialogue: 0,0:17:04.48,0:17:06.02,Default,,0,0,0,,Бұлай істесең жақсы емес.
Dialogue: 0,0:17:06.31,0:17:09.61,Default,,0,0,0,,Біз де Аддер сияқты болғымыз келмейді.
Dialogue: 0,0:17:10.90,0:17:12.36,Default,,0,0,0,,Попо
Dialogue: 0,0:17:17.82,0:17:18.91,Default,,0,0,0,,Бұл шырын.
Dialogue: 0,0:17:19.41,0:17:21.29,Default,,0,0,0,,Жүр, ішіп ал.
Dialogue: 0,0:17:21.66,0:17:22.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:23.75,0:17:24.58,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:24.71,0:17:27.08,Default,,0,0,0,,Уау! Жәндік сөйледі!
Dialogue: 0,0:17:27.21,0:17:28.04,Default,,0,0,0,,Иә? Бұл ештеңе емес
Dialogue: 0,0:17:28.71,0:17:31.00,Default,,0,0,0,,Маған неге сонша мейірімдісің?
Dialogue: 0,0:17:32.09,0:17:34.21,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:17:34.42,0:17:37.80,Default,,0,0,0,,Бірақ Мушикинг мұны істейтініне сенімдімін.
Dialogue: 0,0:17:37.93,0:17:38.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.64,0:17:40.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:52.11,0:17:53.57,Default,,0,0,0,,Маған не болатыны маңызды емес.
Dialogue: 0,0:17:53.69,0:17:55.90,Default,,0,0,0,,Попоға ешқашан тиіспеңіз!
Dialogue: 0,0:17:58.45,0:18:00.91,Default,,0,0,0,,Иә? Ах... Попо!
Dialogue: 0,0:18:01.49,0:18:04.29,Default,,0,0,0,,Мен Мушикингке көмектесуім керек!
Dialogue: 0,0:18:06.21,0:18:07.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.21,0:18:11.63,Default,,0,0,0,,Кешіріңіз Попо...
Dialogue: 0,0:18:12.59,0:18:15.63,Default,,0,0,0,,Күрсін... Мен олай істей алмаймын.
Dialogue: 0,0:18:23.85,0:18:24.68,Default,,0,0,0,,Попо
Dialogue: 0,0:18:25.14,0:18:29.69,Default,,0,0,0,,Қандай жағдай болса да, мен бұл жерге міндетті түрде қайтамын.
Dialogue: 0,0:18:35.11,0:18:36.40,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:18:38.03,0:18:38.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:38.95,0:18:42.66,Default,,0,0,0,,Бұл бізге орман перілеріне жеткен ежелгі дәрі.
Dialogue: 0,0:18:43.03,0:18:45.08,Default,,0,0,0,,Бар жүрегіммен жасадым.
Dialogue: 0,0:18:45.49,0:18:48.00,Default,,0,0,0,,Оны Мушикингке беріңіз.
Dialogue: 0,0:18:48.12,0:18:50.58,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:18:54.04,0:18:55.96,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:18:59.76,0:19:00.88,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:06.31,0:19:08.52,Default,,0,0,0,,Қалай болды? Кішкентай бұғы қоңызы
Dialogue: 0,0:19:08.64,0:19:11.69,Default,,0,0,0,,Жоқ, Мушикинг табылмады.
Dialogue: 0,0:19:11.81,0:19:13.77,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесе алмаймын
Dialogue: 0,0:19:14.11,0:19:15.02,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:19:15.15,0:19:17.15,Default,,0,0,0,,Мұнда да Мушикинг жоқ.
Dialogue: 0,0:19:17.28,0:19:18.69,Default,,0,0,0,,Кешіріңіз Попо
Dialogue: 0,0:19:18.82,0:19:20.36,Default,,0,0,0,,Мен көп іздесем де...
Dialogue: 0,0:19:20.49,0:19:23.53,Default,,0,0,0,,Мушикингті қайда апарғанын білмеймін.
Dialogue: 0,0:19:23.66,0:19:25.49,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:19:27.12,0:19:28.58,Default,,0,0,0,,Маған жол көрсетуге рұқсат етіңіз
Dialogue: 0,0:19:28.70,0:19:29.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.12,0:19:33.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:35.79,0:19:37.80,Default,,0,0,0,,Геркулес Рики Блу
Dialogue: 0,0:19:37.92,0:19:38.92,Default,,0,0,0,,Попо!
Dialogue: 0,0:19:39.05,0:19:40.92,Default,,0,0,0,,Сіз маған жол көрсетесіз бе? Ой ой!
Dialogue: 0,0:19:41.05,0:19:42.72,Default,,0,0,0,,Сен мұнда не істедің, бейбақ?
Dialogue: 0,0:19:42.84,0:19:43.80,Default,,0,0,0,,Алып бұғы қоңызы!
Dialogue: 0,0:19:43.97,0:19:46.18,Default,,0,0,0,,Попо, бұл жігітке сенбе!
Dialogue: 0,0:19:46.31,0:19:47.97,Default,,0,0,0,,Бұл жігіт Аддердің қолбасшысы.
Dialogue: 0,0:19:48.10,0:19:50.27,Default,,0,0,0,,Мені Аддер басқарды.
Dialogue: 0,0:19:50.81,0:19:52.48,Default,,0,0,0,,Сізге айла-шарғы жасалды ма?
Dialogue: 0,0:19:52.60,0:19:54.10,Default,,0,0,0,,Мен қазір есіме оралдым.
Dialogue: 0,0:19:54.23,0:19:55.86,Default,,0,0,0,,Бұған кім сенеді?
Dialogue: 0,0:19:55.98,0:19:57.48,Default,,0,0,0,,Иә, иә, бәрің күтіңдер!
Dialogue: 0,0:19:59.36,0:20:01.95,Default,,0,0,0,,Сіз мені Аддердің жасырынған жеріне апарасыз, солай ма?
Dialogue: 0,0:20:02.07,0:20:02.91,Default,,0,0,0,,О
Dialogue: 0,0:20:03.03,0:20:04.45,Default,,0,0,0,,Попо Алданбаңыз!
Dialogue: 0,0:20:05.24,0:20:06.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:06.37,0:20:07.49,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:20:09.83,0:20:11.87,Default,,0,0,0,,Тіпті алданып қалсаңыз да—
Dialogue: 0,0:20:14.46,0:20:17.29,Default,,0,0,0,,Мен Мушикингке баруым керек.
Dialogue: 0,0:20:17.88,0:20:19.25,Default,,0,0,0,,Мушикинг…
Dialogue: 0,0:20:19.55,0:20:21.80,Default,,0,0,0,,Жүр, маған көрсетші, Рики.
Dialogue: 0,0:20:21.92,0:20:23.72,Default,,0,0,0,,Жарайды, бортқа мін.
Dialogue: 0,0:20:25.22,0:20:26.39,Default,,0,0,0,,Попо!
Dialogue: 0,0:20:39.40,0:20:41.36,Default,,0,0,0,,Уау! Қарғыс атқыр...
Dialogue: 0,0:20:49.28,0:20:50.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:51.12,0:20:52.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:52.66,0:20:54.25,Default,,0,0,0,,Кешіріңіз Попо
Dialogue: 0,0:20:54.79,0:20:57.67,Default,,0,0,0,,Мен кешегі шайқаста жарақат алдым, әлі ұша алмаймын.
Dialogue: 0,0:20:59.46,0:21:00.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.51,0:21:02.63,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:03.47,0:21:04.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:05.30,0:21:08.05,Default,,0,0,0,,Мен саған әлі сенбеймін.
Dialogue: 0,0:21:09.22,0:21:10.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:13.35,0:21:16.23,Default,,0,0,0,,Рики, жарай ма?
Dialogue: 0,0:21:16.35,0:21:21.15,Default,,0,0,0,,Сіздің жауыңыз Мушикинг және оның достары.
Dialogue: 0,0:21:21.90,0:21:24.11,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:21:24.19,0:21:25.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:27.07,0:21:28.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:29.24,0:21:30.24,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:32.83,0:21:33.70,Default,,0,0,0,,Рики?
Dialogue: 0,0:21:34.16,0:21:36.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:36.54,0:21:38.17,Default,,0,0,0,,Не болды? Рики?
Dialogue: 0,0:21:38.29,0:21:42.46,Default,,0,0,0,,(Риккидің айқайы)
Dialogue: 0,0:21:42.80,0:21:43.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:44.88,0:21:46.68,Default,,0,0,0,,Ааа! Уф
Dialogue: 0,0:21:47.22,0:21:48.72,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:21:48.84,0:21:49.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:50.22,0:21:51.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:52.35,0:21:53.85,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:21:53.97,0:21:56.69,Default,,0,0,0,,Уф, мен оны жек көремін.
Dialogue: 0,0:21:56.81,0:21:58.98,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:59.10,0:22:00.81,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:22:00.98,0:22:02.48,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:02.61,0:22:03.78,Default,,0,0,0,,Бұл өте керемет
Dialogue: 0,0:22:03.90,0:22:04.57,Default,,0,0,0,,Суджибут?
Dialogue: 0,0:22:04.69,0:22:06.65,Default,,0,0,0,,Попо Уайымдама, біз келдік!
Dialogue: 0,0:22:06.78,0:22:07.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:07.82,0:22:10.12,Default,,0,0,0,,Кеттік, дайындал!
Dialogue: 0,0:22:10.24,0:22:10.91,Default,,0,0,0,,Судзибуто
Dialogue: 0,0:22:10.99,0:22:12.12,Default,,0,0,0,,Даа! (Рикки) Хмм.
Dialogue: 0,0:22:12.58,0:22:13.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:14.04,0:22:17.08,Default,,0,0,0,,Әй, сұмдық! Жеңдер... Уау!
Dialogue: 0,0:22:17.41,0:22:18.25,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:22:18.37,0:22:19.96,Default,,0,0,0,,Сонда сен маған шабуыл жасайсың ба?
Dialogue: 0,0:22:20.08,0:22:22.54,Default,,0,0,0,,Не? Хм... Қарғыс атсын!
Dialogue: 0,0:22:22.79,0:22:24.50,Default,,0,0,0,,Гуа!
Dialogue: 0,0:22:24.76,0:22:27.47,Default,,0,0,0,,Судзибуто итеріп жатыр ма?
Dialogue: 0,0:22:27.76,0:22:29.97,Default,,0,0,0,,Қарғыс атсын... Кешегі жарақат...
Dialogue: 0,0:22:30.09,0:22:32.60,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл менің қабілетім!
Dialogue: 0,0:22:32.72,0:22:33.93,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:22:34.26,0:22:36.39,Default,,0,0,0,,Эй, өтінемін, тоқтатшы.
Dialogue: 0,0:22:36.48,0:22:38.39,Default,,0,0,0,,Маған кедергі жасама, Попо.
Dialogue: 0,0:22:38.48,0:22:39.44,Default,,0,0,0,,Уау, Судзибуто!
Dialogue: 0,0:22:39.56,0:22:40.85,Default,,0,0,0,,Бум…
Dialogue: 0,0:22:40.94,0:22:42.77,Default,,0,0,0,,Ха... ха... ха... Амансың ба?
Dialogue: 0,0:22:42.90,0:22:45.32,Default,,0,0,0,,Неге мені тоқтатасың, Попо? Өйткені...
Dialogue: 0,0:22:45.40,0:22:48.20,Default,,0,0,0,,Бұл бізге шабуыл жасады.
Dialogue: 0,0:22:48.32,0:22:50.49,Default,,0,0,0,,Өйткені сен жасырын тығылып жүрдің.
Dialogue: 0,0:22:50.61,0:22:51.99,Default,,0,0,0,,Мен олар Попоның артынан жүр деп ойладым.
Dialogue: 0,0:22:52.12,0:22:54.83,Default,,0,0,0,,Попоға опасыздық жасауыңыз мүмкін деп ойладық...
Dialogue: 0,0:22:54.95,0:22:56.29,Default,,0,0,0,,Мен жасырын қарап отырдым.
Dialogue: 0,0:22:56.41,0:22:58.00,Default,,0,0,0,,Мен саған опасыздық жасамаймын
Dialogue: 0,0:22:58.08,0:23:00.46,Default,,0,0,0,,Уф... маған опасыздық жаса! Сіз!
Dialogue: 0,0:23:00.54,0:23:02.25,Default,,0,0,0,,Маған опасыздық жасама! сатқындық!
Dialogue: 0,0:23:02.38,0:23:03.09,Default,,0,0,0,,Маған опасыздық жасама!
Dialogue: 0,0:23:03.21,0:23:04.42,Default,,0,0,0,,Сатқындық... Тоқта.
Dialogue: 0,0:23:04.50,0:23:05.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:05.75,0:23:07.80,Default,,0,0,0,,Бұл өзара түсініспеушілік болды.
Dialogue: 0,0:23:07.92,0:23:09.47,Default,,0,0,0,,Енді төбелесудің қажеті жоқ
Dialogue: 0,0:23:09.59,0:23:12.18,Default,,0,0,0,,Мм, қарашы, Рики, маған да көмектес.
Dialogue: 0,0:23:12.30,0:23:13.60,Default,,0,0,0,,Иә, көмектес.
Dialogue: 0,0:23:13.72,0:23:14.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:15.10,0:23:17.39,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:23:17.97,0:23:19.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:19.56,0:23:21.06,Default,,0,0,0,,Жақсы (Рикки) Әрине.
Dialogue: 0,0:23:21.39,0:23:25.27,Default,,0,0,0,,Қараңызшы, бояну үшін қол алысу, иә?
Dialogue: 0,0:23:25.61,0:23:27.19,Default,,0,0,0,,Е...
Dialogue: 0,0:23:27.57,0:23:29.65,Default,,0,0,0,,Хмм... Мен көмектесе алмаймын.
Dialogue: 0,0:23:29.78,0:23:30.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:31.20,0:23:32.66,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:23:32.74,0:23:34.53,Default,,0,0,0,,Судзибуто Ах...
Dialogue: 0,0:23:36.62,0:23:39.58,Default,,0,0,0,,Мен жәндіктердің қол алысуын естіген емеспін.
Dialogue: 0,0:23:41.71,0:23:42.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:23:43.63,0:23:44.79,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:46.55,0:23:48.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:49.05,0:23:49.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:50.05,0:23:51.93,Default,,0,0,0,,Судзибуто Не?
Dialogue: 0,0:23:53.05,0:23:54.89,Default,,0,0,0,,Біз ұрысып қалдық, иә?
Dialogue: 0,0:23:55.93,0:23:58.14,Default,,0,0,0,,Ал... Жарайды... Жарайды.
Dialogue: 0,0:23:58.27,0:23:59.81,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:23:59.93,0:24:03.27,Default,,0,0,0,,Хехехе... Жоқ... Солай ма? Фуфуфу…
Dialogue: 0,0:24:03.73,0:24:04.98,Default,,0,0,0,,Рики
Dialogue: 0,0:24:05.52,0:24:09.03,Default,,0,0,0,,Сен мені қорғау үшін дәл қазір соғыстың.
Dialogue: 0,0:24:09.15,0:24:10.19,Default,,0,0,0,,Иә
Dialogue: 0,0:24:12.24,0:24:13.86,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:24:14.70,0:24:17.83,Default,,0,0,0,,Бұл анамның маған жасаған дәрісі.
Dialogue: 0,0:24:18.20,0:24:20.62,Default,,0,0,0,,Бұл жарақаттарға өте тиімді.
Dialogue: 0,0:24:24.71,0:24:26.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:26.29,0:24:27.25,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:24:27.46,0:24:30.09,Default,,0,0,0,,Иә, бұл менің анамның иісі.
Dialogue: 0,0:24:30.21,0:24:31.72,Default,,0,0,0,,Ана?
Dialogue: 0,0:24:32.30,0:24:35.01,Default,,0,0,0,,Менің де отбасым болды.
Dialogue: 0,0:24:35.26,0:24:36.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:37.26,0:24:40.14,Default,,0,0,0,,Бәріміз тату-тәтті өмір сүрдік.
Dialogue: 0,0:24:46.10,0:24:50.11,Default,,0,0,0,,(Қоңыздардың күлкісі)
Dialogue: 0,0:24:50.73,0:24:53.86,Default,,0,0,0,,Бірақ бір күні бірдеңе келді...
Dialogue: 0,0:24:54.61,0:24:57.32,Default,,0,0,0,,Сен мені және менің отбасымды ажыраттың.
Dialogue: 0,0:25:02.33,0:25:03.75,Default,,0,0,0,,Мені қараңғы жерге апарды -
Dialogue: 0,0:25:04.71,0:25:07.33,Default,,0,0,0,,ұзақ уақыт қамауға алынды
Dialogue: 0,0:25:08.17,0:25:12.55,Default,,0,0,0,,Қош келдіңіз, бүгіннен бастап бұл сіздің үйіңіз.
Dialogue: 0,0:25:15.76,0:25:17.80,Default,,0,0,0,,Ахх... Уф...
Dialogue: 0,0:25:20.43,0:25:24.98,Default,,0,0,0,,Эмма!
Dialogue: 0,0:25:25.52,0:25:26.35,Default,,0,0,0,,Сол уақыттан бастап—
Dialogue: 0,0:25:27.23,0:25:30.27,Default,,0,0,0,,Біз өз еркімізді жоғалттық.
Dialogue: 0,0:25:31.36,0:25:34.24,Default,,0,0,0,,Хехе... хахаха...
Dialogue: 0,0:25:34.36,0:25:37.36,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:25:40.33,0:25:41.74,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:25:42.79,0:25:44.50,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,0:25:45.87,0:25:47.17,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:25:47.83,0:25:51.13,Default,,0,0,0,,Аддердің мақсаты - Мушикингті басқару.
Dialogue: 0,0:25:51.59,0:25:53.63,Default,,0,0,0,,Бізге асығу керек.
Dialogue: 0,0:25:53.76,0:25:54.59,Default,,0,0,0,,О
Dialogue: 0,0:25:55.59,0:25:56.97,Default,,0,0,0,,Суджибут
Dialogue: 0,0:25:57.63,0:25:58.55,Default,,0,0,0,,Рики
Dialogue: 0,0:25:58.76,0:25:59.80,Default,,0,0,0,,Иә
Dialogue: 0,0:26:02.22,0:26:05.98,Default,,0,0,0,,Мушикингке көмектесу үшін маған күш бересіз бе?
Dialogue: 0,0:26:06.10,0:26:07.48,Default,,0,0,0,,Әрине, Попо.
Dialogue: 0,0:26:07.73,0:26:09.44,Default,,0,0,0,,Ой, мен ренжідім.
Dialogue: 0,0:26:11.02,0:26:12.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:26:14.86,0:26:17.65,Default,,0,0,0,,Аман болыңыз Мушикинг
Dialogue: 0,0:26:21.24,0:26:23.62,Default,,0,0,0,,Попоның анасының дәрісі әсер етті.
Dialogue: 0,0:26:23.74,0:26:25.29,Default,,0,0,0,,Енді бәрі жақсы!
Dialogue: 0,0:26:25.54,0:26:27.16,Default,,0,0,0,,Бірден ұшайық!
Dialogue: 0,0:26:27.33,0:26:29.75,Default,,0,0,0,,Біз де жасаймыз!
Dialogue: 0,0:26:33.34,0:26:36.92,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:26:37.67,0:26:39.18,Default,,0,0,0,,Тырнақтарыңды қадалама.
Dialogue: 0,0:26:39.30,0:26:42.68,Default,,0,0,0,,Жақында Мушикинг те менің қызметшім болады.
Dialogue: 0,0:26:42.76,0:26:44.97,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:26:45.81,0:26:47.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:47.56,0:26:50.27,Default,,0,0,0,,Уау... Ах!
Dialogue: 0,0:26:51.27,0:26:52.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:54.52,0:26:56.03,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:26:56.53,0:27:00.82,Default,,0,0,0,,Фуфуфуфуфуфу… Хахахахаха…
Dialogue: 0,0:27:00.95,0:27:01.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:02.70,0:27:04.33,Default,,0,0,0,,Не болып жатыр? Уф...
Dialogue: 0,0:27:07.83,0:27:08.87,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:27:09.00,0:27:10.08,Default,,0,0,0,,Не? Қосқыш!
Dialogue: 0,0:27:10.37,0:27:12.79,Default,,0,0,0,,Мушикингті қайтарыңыз! Қайтарыңыз!
Dialogue: 0,0:27:13.13,0:27:14.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:15.17,0:27:16.05,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:27:17.17,0:27:18.21,Default,,0,0,0,,Мен...
Dialogue: 0,0:27:18.34,0:27:21.18,Default,,0,0,0,,Жираф, мына жігіттерге қамқор бол.
Dialogue: 0,0:27:21.80,0:27:23.30,Default,,0,0,0,,Ах
Dialogue: 0,0:27:23.43,0:27:24.80,Default,,0,0,0,,Қауіпті попо! Қарғыс атқыр...
Dialogue: 0,0:27:25.93,0:27:26.77,Default,,0,0,0,,Рики!
Dialogue: 0,0:27:27.85,0:27:30.56,Default,,0,0,0,,Жираф Бұл менмін, түсіндің бе?
Dialogue: 0,0:27:31.31,0:27:32.40,Default,,0,0,0,,Рики!
Dialogue: 0,0:27:33.19,0:27:34.15,Default,,0,0,0,,Уф
Dialogue: 0,0:27:34.27,0:27:36.65,Default,,0,0,0,,Сізді жай ғана Adder басқарып жатыр.
Dialogue: 0,0:27:37.40,0:27:38.36,Default,,0,0,0,,Конняро! Ах...!
Dialogue: 0,0:27:39.15,0:27:39.82,Default,,0,0,0,,Уау
Dialogue: 0,0:27:40.45,0:27:42.61,Default,,0,0,0,,Уау! Қарғыс атсын!
Dialogue: 0,0:27:42.82,0:27:43.49,Default,,0,0,0,,Судзибуто!
Dialogue: 0,0:27:43.78,0:27:45.37,Default,,0,0,0,,Уау, а... Уау, ә!
Dialogue: 0,0:27:45.49,0:27:46.33,Default,,0,0,0,,Судзибуто!
Dialogue: 0,0:27:46.79,0:27:47.49,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:27:48.66,0:27:50.21,Default,,0,0,0,,Не... Уау!
Dialogue: 0,0:27:55.04,0:27:55.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:56.04,0:27:57.50,Default,,0,0,0,,Амансың ба? суджибуто
Dialogue: 0,0:27:57.63,0:27:58.84,Default,,0,0,0,,Уф... менде бәрі жақсы.
Dialogue: 0,0:27:59.38,0:28:02.01,Default,,0,0,0,,Тезірек, Попо, Мушикингті қазір құтқарайық.
Dialogue: 0,0:28:02.13,0:28:02.80,Default,,0,0,0,,Иә
Dialogue: 0,0:28:03.80,0:28:06.47,Default,,0,0,0,,Есіңе кел, Жираф!
Dialogue: 0,0:28:09.10,0:28:10.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:10.98,0:28:13.35,Default,,0,0,0,,Жираф, оян.
Dialogue: 0,0:28:15.56,0:28:17.57,Default,,0,0,0,,Мушикинг Мықты бол
Dialogue: 0,0:28:17.65,0:28:19.98,Default,,0,0,0,,Қарғыс атсын... Конняро!
Dialogue: 0,0:28:21.03,0:28:21.95,Default,,0,0,0,,Бар!
Dialogue: 0,0:28:22.11,0:28:23.82,Default,,0,0,0,,Жүр, менің иығыма
Dialogue: 0,0:28:23.95,0:28:25.53,Default,,0,0,0,,Сәттілік Мушикинг
Dialogue: 0,0:28:25.66,0:28:26.66,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін Ах!
Dialogue: 0,0:28:26.95,0:28:30.12,Default,,0,0,0,,Бала, сен осы уақытқа дейін келдің. Мен сіздің батылдығыңызды мадақтаймын.
Dialogue: 0,0:28:30.25,0:28:35.00,Default,,0,0,0,,Бірақ мұның түкке тұрғысыз екенін айтуым керек!
Dialogue: 0,0:28:35.63,0:28:36.46,Default,,0,0,0,,Уау! Апыр-ай! Ах!
Dialogue: 0,0:28:40.13,0:28:41.59,Default,,0,0,0,,Не... бұл не? Бұл жігіт
Dialogue: 0,0:28:41.72,0:28:42.59,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:28:42.72,0:28:44.09,Default,,0,0,0,,Ия, иә, иә!
Dialogue: 0,0:28:44.22,0:28:45.18,Default,,0,0,0,,Судзибуто! Апыр-ай!
Dialogue: 0,0:28:47.55,0:28:49.76,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:28:49.85,0:28:52.23,Default,,0,0,0,,Судзибуто! Мушикинг!
Dialogue: 0,0:28:52.31,0:28:54.19,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:28:54.64,0:28:55.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:55.60,0:28:57.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:04.03,0:29:06.57,Default,,0,0,0,,Бұл қоңыз қуыршақ
Dialogue: 0,0:29:06.70,0:29:09.28,Default,,0,0,0,,Хахаха... Сіз таң қалдыңыз ба?
Dialogue: 0,0:29:09.41,0:29:11.49,Default,,0,0,0,,Бұл менің басты қаруым.
Dialogue: 0,0:29:12.12,0:29:13.50,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:29:13.62,0:29:16.88,Default,,0,0,0,,Кел, Кавказ қоңызы!
Dialogue: 0,0:29:17.00,0:29:18.50,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:29:19.71,0:29:20.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:21.00,0:29:22.59,Default,,0,0,0,,Уа! (Рикки) Уф.
Dialogue: 0,0:29:23.59,0:29:25.76,Default,,0,0,0,,Қарғыс атсын... Жирафа Кешіріңіз.
Dialogue: 0,0:29:25.84,0:29:27.30,Default,,0,0,0,,Гуааах
Dialogue: 0,0:29:27.39,0:29:29.14,Default,,0,0,0,,Бүйірлік құлыпты бомба!
Dialogue: 0,0:29:29.68,0:29:32.18,Default,,0,0,0,,Джиееееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:29:48.62,0:29:51.49,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:29:52.37,0:29:54.50,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:29:54.70,0:29:57.83,Default,,0,0,0,,Жүр! Кавказ қоңызы!
Dialogue: 0,0:29:58.50,0:30:01.38,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:30:01.50,0:30:02.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:30:03.51,0:30:04.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:06.09,0:30:07.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:10.18,0:30:12.01,Default,,0,0,0,,Кетчуппен бүтіндей бүркелген—
Dialogue: 0,0:30:12.47,0:30:13.35,Default,,0,0,0,,Рики
Dialogue: 0,0:30:13.47,0:30:15.31,Default,,0,0,0,,Оны да айла-шарғы жасауда.
Dialogue: 0,0:30:15.43,0:30:16.48,Default,,0,0,0,,Мен сені оятамын
Dialogue: 0,0:30:17.06,0:30:18.94,Default,,0,0,0,,Қарғыс атсын... О!
Dialogue: 0,0:30:23.57,0:30:25.32,Default,,0,0,0,,Айқас секіру!
Dialogue: 0,0:30:30.91,0:30:32.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:34.62,0:30:36.58,Default,,0,0,0,,Өйткені қауырсындары әлі кеппеген —
Dialogue: 0,0:30:36.70,0:30:39.00,Default,,0,0,0,,Бар күшіңізді жұмсай алмайсыз ба?
Dialogue: 0,0:30:39.25,0:30:39.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:40.12,0:30:42.42,Default,,0,0,0,,Бітір, Кавказ! Ха!
Dialogue: 0,0:30:43.00,0:30:43.88,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:30:44.34,0:30:45.34,Default,,0,0,0,,Уау
Dialogue: 0,0:30:45.63,0:30:46.55,Default,,0,0,0,,Рики!
Dialogue: 0,0:30:46.63,0:30:50.18,Default,,0,0,0,,(Риккидің айқайы)
Dialogue: 0,0:30:51.80,0:30:52.97,Default,,0,0,0,,Рики!
Dialogue: 0,0:30:53.10,0:30:55.27,Default,,0,0,0,,Рики?
Dialogue: 0,0:30:57.93,0:30:59.39,Default,,0,0,0,,Эмма!
Dialogue: 0,0:30:59.48,0:31:02.86,Default,,0,0,0,,Жүр, Рики, мен үшін күрес.
Dialogue: 0,0:31:04.07,0:31:05.32,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:31:05.53,0:31:06.82,Default,,0,0,0,,Рики!
Dialogue: 0,0:31:07.44,0:31:09.36,Default,,0,0,0,,О... тоқта, Рики.
Dialogue: 0,0:31:09.99,0:31:10.82,Default,,0,0,0,,Уау
Dialogue: 0,0:31:12.16,0:31:13.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:17.08,0:31:18.96,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:31:19.66,0:31:20.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:22.00,0:31:24.38,Default,,0,0,0,,Оян! Рики!
Dialogue: 0,0:31:29.92,0:31:30.80,Default,,0,0,0,,Рики?
Dialogue: 0,0:31:33.47,0:31:34.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:34.97,0:31:37.22,Default,,0,0,0,,Ақымақ! Сен не істеп жатырсың!
Dialogue: 0,0:31:39.60,0:31:41.10,Default,,0,0,0,,Рики…
Dialogue: 0,0:31:41.39,0:31:44.15,Default,,0,0,0,,Барлығына ана
Dialogue: 0,0:31:45.32,0:31:45.98,Default,,0,0,0,,Не?
Dialogue: 0,0:31:46.23,0:31:49.94,Default,,0,0,0,,Мен Геркулес Рики Блумын!
Dialogue: 0,0:31:50.07,0:31:51.82,Default,,0,0,0,,Уау! (Кавказ) Ух...
Dialogue: 0,0:31:51.95,0:31:52.91,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:31:53.16,0:31:54.62,Default,,0,0,0,,Уф Рики!
Dialogue: 0,0:31:54.78,0:31:56.08,Default,,0,0,0,,Жарайды, а...
Dialogue: 0,0:31:57.12,0:31:58.79,Default,,0,0,0,,Жарайды, Попо.
Dialogue: 0,0:31:58.87,0:32:01.50,Default,,0,0,0,,Мен енді ешқашан айла-шарғы жасамаймын!
Dialogue: 0,0:32:02.71,0:32:03.37,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:32:03.79,0:32:06.92,Default,,0,0,0,,Жер сілкінісі!
Dialogue: 0,0:32:08.38,0:32:09.38,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:32:12.34,0:32:13.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:32:13.80,0:32:15.76,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:32:17.31,0:32:20.06,Default,,0,0,0,,Өз күшіңізді толық пайдалана алу үшін—
Dialogue: 0,0:32:20.18,0:32:22.64,Default,,0,0,0,,Сізге көбірек уақыт керек пе?
Dialogue: 0,0:32:22.73,0:32:23.98,Default,,0,0,0,,Жарайсың Рики
Dialogue: 0,0:32:24.10,0:32:26.11,Default,,0,0,0,,Уф... аа... у...
Dialogue: 0,0:32:26.31,0:32:27.82,Default,,0,0,0,,Ах... Рики!
Dialogue: 0,0:32:28.73,0:32:29.78,Default,,0,0,0,,Рики!
Dialogue: 0,0:32:29.98,0:32:31.69,Default,,0,0,0,,Рикки мықты болыңыз
Dialogue: 0,0:32:31.82,0:32:33.78,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:32:33.95,0:32:36.37,Default,,0,0,0,,Ах! Не... не?
Dialogue: 0,0:32:36.53,0:32:37.20,Default,,0,0,0,,Уау
Dialogue: 0,0:32:40.37,0:32:41.87,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:32:42.12,0:32:45.50,Default,,0,0,0,,Хахахаха... Бұл жердің енді маған пайдасы жоқ!
Dialogue: 0,0:32:45.63,0:32:47.25,Default,,0,0,0,,Қосқыш О, құдай!
Dialogue: 0,0:32:47.38,0:32:49.80,Default,,0,0,0,,Бұл орманды өртеп жібереді! Уф
Dialogue: 0,0:32:50.09,0:32:51.92,Default,,0,0,0,,Балалар енді қаша алмайсыңдар.
Dialogue: 0,0:32:52.05,0:32:55.01,Default,,0,0,0,,Осы жасырынумен бірге жоғалыңыз.
Dialogue: 0,0:32:55.13,0:32:58.01,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:32:58.10,0:32:59.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:32:59.72,0:33:02.93,Default,,0,0,0,,Уф... уау уау... уау!
Dialogue: 0,0:33:03.18,0:33:04.10,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:33:04.23,0:33:06.77,Default,,0,0,0,,Попо Рикиді күтіңіз
Dialogue: 0,0:33:08.11,0:33:08.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:09.48,0:33:10.82,Default,,0,0,0,,Рики?
Dialogue: 0,0:33:11.36,0:33:13.03,Default,,0,0,0,,Уф... Попо
Dialogue: 0,0:33:13.15,0:33:14.78,Default,,0,0,0,,Менің астымнан өтіңіз, иә?
Dialogue: 0,0:33:14.90,0:33:17.16,Default,,0,0,0,,Асығыңыз! Түсіндім
Dialogue: 0,0:33:25.21,0:33:26.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:27.08,0:33:28.58,Default,,0,0,0,,Рики! (Рикки) Жарайды.
Dialogue: 0,0:33:29.00,0:33:30.04,Default,,0,0,0,,Асығыңыз! Попо
Dialogue: 0,0:33:31.96,0:33:34.67,Default,,0,0,0,,Амансың ба? Рики (Рикки) Мен жақсымын
Dialogue: 0,0:33:34.97,0:33:37.05,Default,,0,0,0,,Одан да көп, Мушикинг Уау!
Dialogue: 0,0:33:38.18,0:33:39.76,Default,,0,0,0,,Рики! (Рикки) Келме!
Dialogue: 0,0:33:40.26,0:33:41.72,Default,,0,0,0,,Кеттік, Попо!
Dialogue: 0,0:33:41.85,0:33:43.22,Default,,0,0,0,,Достарыңызға айтыңыз!
Dialogue: 0,0:33:43.81,0:33:46.77,Default,,0,0,0,,Өрт... Осылай жалғаса берсе, орман...
Dialogue: 0,0:33:46.89,0:33:48.19,Default,,0,0,0,,Орман қауіпті
Dialogue: 0,0:33:48.35,0:33:49.81,Default,,0,0,0,,Рики
Dialogue: 0,0:33:50.40,0:33:52.65,Default,,0,0,0,,Мен міндетті түрде көмектесуге қайтамын.
Dialogue: 0,0:33:55.28,0:33:56.99,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:33:57.28,0:33:59.37,Default,,0,0,0,,По… Попо
Dialogue: 0,0:33:59.91,0:34:02.33,Default,,0,0,0,,Бұл... анамның дәрісі.
Dialogue: 0,0:34:04.25,0:34:05.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:07.42,0:34:08.29,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:34:08.42,0:34:12.05,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,0:34:12.17,0:34:14.46,Default,,0,0,0,,Маған сол теледидарды бер.
Dialogue: 0,0:34:14.92,0:34:16.84,Default,,0,0,0,,Жақын жерде қалдыңыз, бар күшіңізді салыңыз!
Dialogue: 0,0:34:16.97,0:34:17.97,Default,,0,0,0,,Уф!
Dialogue: 0,0:34:18.68,0:34:21.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:21.93,0:34:23.85,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:34:24.18,0:34:25.85,Default,,0,0,0,,Ыстық ыстық ыстық… ыстық ыстық ыстық ыстық…
Dialogue: 0,0:34:25.98,0:34:29.31,Default,,0,0,0,,Ачачача... сонда! Ачачача...
Dialogue: 0,0:34:29.65,0:34:31.56,Default,,0,0,0,,Мушикингті күтіңіз
Dialogue: 0,0:34:32.57,0:34:34.82,Default,,0,0,0,,Судзибуто! Ормандағылардың бәрі білсін!
Dialogue: 0,0:34:34.94,0:34:36.99,Default,,0,0,0,,Маған қалдырыңыз! Ах ча ча ча...
Dialogue: 0,0:34:37.11,0:34:37.99,Default,,0,0,0,,Попо
Dialogue: 0,0:34:38.11,0:34:39.74,Default,,0,0,0,,Рики әлі де сонда.
Dialogue: 0,0:34:39.86,0:34:40.70,Default,,0,0,0,,Не?
Dialogue: 0,0:34:41.24,0:34:42.33,Default,,0,0,0,,Жирафа да
Dialogue: 0,0:34:42.95,0:34:45.37,Default,,0,0,0,,Барлығын Аддер басқарды.
Dialogue: 0,0:34:45.50,0:34:47.29,Default,,0,0,0,,Бұл жаман қоңыз емес!
Dialogue: 0,0:34:47.46,0:34:50.79,Default,,0,0,0,,Рики бізге көмектесті!
Dialogue: 0,0:34:51.75,0:34:54.46,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:34:55.80,0:34:56.63,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:34:58.76,0:35:02.80,Default,,0,0,0,,Бұл орманда бірде-бір қоңыз өлмейді.
Dialogue: 0,0:35:03.26,0:35:04.93,Default,,0,0,0,,Мына жерде... Мұнда және ана жерде...
Dialogue: 0,0:35:05.06,0:35:05.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:06.02,0:35:07.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:35:08.23,0:35:10.65,Default,,0,0,0,,Ыстық ыстық ыстық… ыстық ыстық ыстық…
Dialogue: 0,0:35:10.85,0:35:13.11,Default,,0,0,0,,Сәлем бәріңе!
Dialogue: 0,0:35:13.23,0:35:15.02,Default,,0,0,0,,Судзибуто! Не болды?
Dialogue: 0,0:35:15.15,0:35:16.53,Default,,0,0,0,,Мұнда және мұнда ...
Dialogue: 0,0:35:16.65,0:35:18.36,Default,,0,0,0,,А... Тондырғыштың жасырынуы өртеніп жатыр.
Dialogue: 0,0:35:18.49,0:35:20.24,Default,,0,0,0,,Бұлай жалғаса берсе, Попо мен басқаларына қауіп төнеді!
Dialogue: 0,0:35:20.36,0:35:21.32,Default,,0,0,0,,Не?
Dialogue: 0,0:35:21.45,0:35:23.53,Default,,0,0,0,,Әлі уақыт бар. Маған күшіңді бер!
Dialogue: 0,0:35:23.62,0:35:25.49,Default,,0,0,0,,Уау! Өртеніп жатыр!
Dialogue: 0,0:35:25.83,0:35:29.08,Default,,0,0,0,,Жағымды қоңыр иіс... Мм...
Dialogue: 0,0:35:29.21,0:35:29.96,Default,,0,0,0,,О!
Dialogue: 0,0:35:30.04,0:35:34.42,Default,,0,0,0,,Уау! Міне, міне, міне... Маған көмектесіңізші!
Dialogue: 0,0:35:34.92,0:35:36.88,Default,,0,0,0,,Кеттік! Жақсы!
Dialogue: 0,0:35:37.05,0:35:38.84,Default,,0,0,0,,Пайдасы жоқ (Қоңыздар) А?
Dialogue: 0,0:35:39.09,0:35:40.30,Default,,0,0,0,,Ах... (Қоңыз) А?
Dialogue: 0,0:35:47.72,0:35:51.48,Default,,0,0,0,,Ада... Ада... Адаадада... Ада!
Dialogue: 0,0:35:51.85,0:35:53.23,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:35:53.40,0:35:55.44,Default,,0,0,0,,Олар енді бұл дүниеде жоқ.
Dialogue: 0,0:35:59.19,0:36:00.86,Default,,0,0,0,,Мушикинг! Рики!
Dialogue: 0,0:36:06.12,0:36:08.79,Default,,0,0,0,,Ах! Мушикинг!
Dialogue: 0,0:36:11.46,0:36:14.08,Default,,0,0,0,,Барлығының аман болғанына қуаныштымын.
Dialogue: 0,0:36:14.21,0:36:15.54,Default,,0,0,0,,Жеңілдеп қалуға әлі ерте.
Dialogue: 0,0:36:15.67,0:36:16.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:18.59,0:36:20.67,Default,,0,0,0,,Қашатын жер жоқ, не істеуім керек?
Dialogue: 0,0:36:20.80,0:36:22.26,Default,,0,0,0,,Дүрбелең болма, Попо, не?
Dialogue: 0,0:36:22.80,0:36:24.64,Default,,0,0,0,,Орман біз жақта
Dialogue: 0,0:36:24.76,0:36:27.18,Default,,0,0,0,,Орманның дауысын тыңда
Dialogue: 0,0:36:27.56,0:36:28.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:30.27,0:36:33.14,Default,,0,0,0,,（）
Dialogue: 0,0:36:33.64,0:36:36.11,Default,,0,0,0,,Бұл дыбыс... желдің дыбысы.
Dialogue: 0,0:36:36.52,0:36:38.40,Default,,0,0,0,,Жел соғып тұр!
Dialogue: 0,0:36:45.28,0:36:46.49,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:36:48.03,0:36:52.04,Default,,0,0,0,,Бұл өзгертілген Кавказға ешкім тең келе алмайды.
Dialogue: 0,0:36:52.33,0:36:53.21,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:36:53.33,0:36:55.37,Default,,0,0,0,,Ешқандай болмаңыз! Бір ғана қарсылас бар!
Dialogue: 0,0:36:55.46,0:36:56.67,Default,,0,0,0,,Мушикингтің жауы!
Dialogue: 0,0:36:56.79,0:36:57.75,Default,,0,0,0,,Жеңіліс!
Dialogue: 0,0:36:57.84,0:36:59.50,Default,,0,0,0,,Жасай бер! Кавказ!
Dialogue: 0,0:37:00.05,0:37:01.13,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:37:01.51,0:37:04.26,Default,,0,0,0,,Уг!?
Dialogue: 0,0:37:04.38,0:37:05.05,Default,,0,0,0,,Уау
Dialogue: 0,0:37:05.72,0:37:07.18,Default,,0,0,0,,Судзибуто!
Dialogue: 0,0:37:07.85,0:37:09.22,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:37:10.35,0:37:11.18,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:37:12.31,0:37:13.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:13.56,0:37:14.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:14.81,0:37:16.48,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:37:16.60,0:37:17.44,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:37:17.56,0:37:18.98,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:37:23.44,0:37:24.40,Default,,0,0,0,,Ха-ха…
Dialogue: 0,0:37:24.65,0:37:27.41,Default,,0,0,0,,Солай жыла, кішкентай шабақтар!
Dialogue: 0,0:37:29.12,0:37:31.95,Default,,0,0,0,,Попо Мушикинг Өйткені, бұл менмін...
Dialogue: 0,0:37:32.08,0:37:33.87,Default,,0,0,0,,Уф... бұл мүмкін емес!
Dialogue: 0,0:37:34.00,0:37:35.83,Default,,0,0,0,,Барлығына! Берілме!
Dialogue: 0,0:37:35.96,0:37:36.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:37.21,0:37:39.25,Default,,0,0,0,,Жамандарға жеңілме!
Dialogue: 0,0:37:39.38,0:37:40.63,Default,,0,0,0,,Попо!
Dialogue: 0,0:37:42.63,0:37:43.80,Default,,0,0,0,,Не?
Dialogue: 0,0:37:44.51,0:37:46.55,Default,,0,0,0,,Балалар сендер әлі тірісіңдер ме?
Dialogue: 0,0:37:47.51,0:37:49.97,Default,,0,0,0,,Кеттік! Өзгертілген Кавказ!
Dialogue: 0,0:37:51.43,0:37:53.18,Default,,0,0,0,,Уау! Мушикинг!
Dialogue: 0,0:38:02.53,0:38:03.73,Default,,0,0,0,,Ха! (Кавказ) Уау!
Dialogue: 0,0:38:05.19,0:38:06.03,Default,,0,0,0,,Уф
Dialogue: 0,0:38:09.07,0:38:10.24,Default,,0,0,0,,Мені итеріп жатыр!
Dialogue: 0,0:38:10.37,0:38:12.45,Default,,0,0,0,,Мушикинг әлі тамаша күйде емес.
Dialogue: 0,0:38:15.37,0:38:16.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:18.58,0:38:20.21,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:38:20.54,0:38:21.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:23.34,0:38:24.76,Default,,0,0,0,,Эмма!
Dialogue: 0,0:38:24.84,0:38:26.97,Default,,0,0,0,,Міне, өзгертілген Кавказ!
Dialogue: 0,0:38:27.13,0:38:30.72,Default,,0,0,0,,Осы жігіттерге өзіңіздің шынайы күшіңізді көрсетіңіз.
Dialogue: 0,0:38:31.05,0:38:33.31,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:38:33.72,0:38:34.77,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:38:35.35,0:38:36.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:37.23,0:38:38.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:42.44,0:38:43.52,Default,,0,0,0,,Гррр…
Dialogue: 0,0:38:43.86,0:38:45.74,Default,,0,0,0,,Он жыл. Мен он жыл күттім.
Dialogue: 0,0:38:46.03,0:38:47.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:50.07,0:38:53.45,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:38:53.66,0:38:57.66,Default,,0,0,0,,(Мушикингтің айқайы)
Dialogue: 0,0:39:03.00,0:39:03.96,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:39:04.09,0:39:04.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:04.96,0:39:06.80,Default,,0,0,0,,Ах! Мушикинг!
Dialogue: 0,0:39:07.30,0:39:09.76,Default,,0,0,0,,Өйткені, менің денем әлі қалпына келген жоқ.
Dialogue: 0,0:39:16.81,0:39:19.10,Default,,0,0,0,,Жарайды, соңғы соққыны бер, Кавказ!
Dialogue: 0,0:39:19.60,0:39:20.94,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:39:21.06,0:39:23.06,Default,,0,0,0,,Тоқта! О, менің!
Dialogue: 0,0:39:23.48,0:39:24.52,Default,,0,0,0,,Судзибуто!
Dialogue: 0,0:39:24.82,0:39:27.99,Default,,0,0,0,,Мушикингті босатыңыз! Бұл құбыжық! Куу!
Dialogue: 0,0:39:28.24,0:39:30.45,Default,,0,0,0,,Жібер! Мені жіберіңізші!
Dialogue: 0,0:39:30.53,0:39:31.20,Default,,0,0,0,,Судзибуто!
Dialogue: 0,0:39:31.32,0:39:33.07,Default,,0,0,0,,Біз де қосыламыз!
Dialogue: 0,0:39:33.16,0:39:33.99,Default,,0,0,0,,Судзибутоға көмектесейік!
Dialogue: 0,0:39:34.12,0:39:34.78,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:39:35.70,0:39:37.24,Default,,0,0,0,,Сәлем! Менің жолыма кедергі болма!
Dialogue: 0,0:39:37.58,0:39:38.79,Default,,0,0,0,,Мушикингті босатыңыз!
Dialogue: 0,0:39:39.00,0:39:41.00,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:39:43.33,0:39:47.00,Default,,0,0,0,,Уау! Ах! Ах...
Dialogue: 0,0:39:47.88,0:39:50.63,Default,,0,0,0,,(Кавказ дауысы)
Dialogue: 0,0:39:50.88,0:39:53.09,Default,,0,0,0,,Кавказ Олардан құтыл!
Dialogue: 0,0:39:53.18,0:39:55.60,Default,,0,0,0,,Иә! Та...та... маған көмектес!
Dialogue: 0,0:39:55.72,0:39:57.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:39:59.06,0:40:01.44,Default,,0,0,0,,Кавказ Мен сенің қарсыласыңмын!
Dialogue: 0,0:40:01.73,0:40:02.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:40:08.48,0:40:10.19,Default,,0,0,0,,Мушикинг! жалғастыра бер!
Dialogue: 0,0:40:11.07,0:40:12.74,Default,,0,0,0,,Ешқандай болмаңыз! Кавказ!
Dialogue: 0,0:40:12.86,0:40:15.16,Default,,0,0,0,,Мушикингтің күші қалмады!
Dialogue: 0,0:40:15.41,0:40:17.62,Default,,0,0,0,,Мушикингке сәттілік! Тұрақты!
Dialogue: 0,0:40:18.33,0:40:19.62,Default,,0,0,0,,Мушикинг!
Dialogue: 0,0:40:19.75,0:40:21.58,Default,,0,0,0,,Мушикингке сәттілік!
Dialogue: 0,0:40:22.04,0:40:23.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:23.92,0:40:25.25,Default,,0,0,0,,О!
Dialogue: 0,0:40:25.92,0:40:29.51,Default,,0,0,0,,Король Торнадо лақтыру!
Dialogue: 0,0:40:29.71,0:40:31.34,Default,,0,0,0,,Уау
Dialogue: 0,0:40:31.51,0:40:32.63,Default,,0,0,0,,Уф
Dialogue: 0,0:40:32.88,0:40:35.64,Default,,0,0,0,,Иә! Мушикинг!
Dialogue: 0,0:40:35.76,0:40:36.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:37.05,0:40:39.31,Default,,0,0,0,,Мушикинг Жарайсың! Жеңдер!
Dialogue: 0,0:40:39.39,0:40:40.47,Default,,0,0,0,,Қауіпті Мушикинг!
Dialogue: 0,0:40:40.60,0:40:41.27,Default,,0,0,0,,Уау Попо!
Dialogue: 0,0:40:41.52,0:40:43.73,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:40:43.85,0:40:45.65,Default,,0,0,0,,Попо попо!
Dialogue: 0,0:40:45.77,0:40:47.19,Default,,0,0,0,,Ах! Мушикинг!
Dialogue: 0,0:40:47.36,0:40:50.82,Default,,0,0,0,,Хахаха... Мен үшін күрес, Мушикинг!
Dialogue: 0,0:40:50.94,0:40:53.57,Default,,0,0,0,,Ух... мен... мен...
Dialogue: 0,0:40:53.95,0:40:55.53,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:40:55.61,0:40:56.57,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:40:56.70,0:40:57.83,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:40:57.91,0:40:58.99,Default,,0,0,0,,Мушикинг! (Қосымша) Не? Уау
Dialogue: 0,0:41:00.62,0:41:03.87,Default,,0,0,0,,Эй, мен жасадым! Мен оны істедім!
Dialogue: 0,0:41:04.17,0:41:06.33,Default,,0,0,0,,Қарғыс атсын... Попо!
Dialogue: 0,0:41:06.79,0:41:09.09,Default,,0,0,0,,Ух... у... Попо!
Dialogue: 0,0:41:09.38,0:41:11.05,Default,,0,0,0,,Мықты болыңыз! Попо!
Dialogue: 0,0:41:11.46,0:41:12.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:14.55,0:41:17.01,Default,,0,0,0,,Кешіріңіз, Мушикинг, бірақ...
Dialogue: 0,0:41:17.68,0:41:20.22,Default,,0,0,0,,Өйткені сен маған әрқашан көмектестің—
Dialogue: 0,0:41:20.56,0:41:24.06,Default,,0,0,0,,Мен де саған көмектескім келді
Dialogue: 0,0:41:24.60,0:41:25.44,Default,,0,0,0,,Попо!
Dialogue: 0,0:41:28.69,0:41:30.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:30.90,0:41:33.86,Default,,0,0,0,,(Мушикингтің шайқас айқайы)
Dialogue: 0,0:41:34.57,0:41:36.82,Default,,0,0,0,,Қазір! Мушикингті жеңіңіз!
Dialogue: 0,0:41:37.70,0:41:38.78,Default,,0,0,0,,Оқытуымды сынап көру уақыты келді.
Dialogue: 0,0:41:39.58,0:41:41.08,Default,,0,0,0,,Таа! (Кавказ) Уау
Dialogue: 0,0:41:42.50,0:41:43.75,Default,,0,0,0,,Рики
Dialogue: 0,0:41:43.91,0:41:45.83,Default,,0,0,0,,Оян, Кавказ!
Dialogue: 0,0:41:46.04,0:41:47.54,Default,,0,0,0,,Біз сізге көмектескіміз келеді!
Dialogue: 0,0:41:47.67,0:41:48.79,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:41:50.42,0:41:51.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:51.34,0:41:52.55,Default,,0,0,0,,Рики
Dialogue: 0,0:41:54.22,0:41:55.22,Default,,0,0,0,,Мушикинг
Dialogue: 0,0:41:55.34,0:41:57.51,Default,,0,0,0,,Кавказды менімен бірге лақтыр
Dialogue: 0,0:41:57.64,0:41:59.14,Default,,0,0,0,,Бірақ... (Рикки) Жаса!
Dialogue: 0,0:41:59.26,0:42:02.52,Default,,0,0,0,,Бұл өзгертілген Кавказды жеңудің жалғыз жолы!
Dialogue: 0,0:42:03.39,0:42:05.18,Default,,0,0,0,,Жаса! Мушикинг!
Dialogue: 0,0:42:06.44,0:42:07.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:42:10.77,0:42:12.15,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:42:13.11,0:42:14.61,Default,,0,0,0,,Мушикинг
Dialogue: 0,0:42:15.07,0:42:16.20,Default,,0,0,0,,Попо
Dialogue: 0,0:42:17.74,0:42:19.03,Default,,0,0,0,,Рики
Dialogue: 0,0:42:21.62,0:42:23.58,Default,,0,0,0,,Және орман достары
Dialogue: 0,0:42:26.71,0:42:29.17,Default,,0,0,0,,Әркімнің ойын босқа өткізбе
Dialogue: 0,0:42:30.00,0:42:31.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:36.26,0:42:39.13,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:42:39.39,0:42:41.60,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:42:41.72,0:42:46.23,Default,,0,0,0,,Неліктен? Неліктен сізде әлі де сонша күш бар?
Dialogue: 0,0:42:47.43,0:42:49.56,Default,,0,0,0,,Қосқыш Сіз түсінбейсіз.
Dialogue: 0,0:42:49.98,0:42:53.15,Default,,0,0,0,,Бұл әркімнің орманын күту ниеті.
Dialogue: 0,0:42:53.27,0:42:56.44,Default,,0,0,0,,Сол сезім маған күш береді.
Dialogue: 0,0:42:57.32,0:43:02.41,Default,,0,0,0,,Super King Торнадо лақтыру!
Dialogue: 0,0:43:03.16,0:43:04.41,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:43:12.29,0:43:16.30,Default,,0,0,0,,(Кавказ айқайы)
Dialogue: 0,0:43:18.59,0:43:19.26,Default,,0,0,0,,Уф
Dialogue: 0,0:43:22.80,0:43:25.43,Default,,0,0,0,,Шешілді! Мушикинг жеңеді!
Dialogue: 0,0:43:25.72,0:43:29.10,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:43:48.41,0:43:50.91,Default,,0,0,0,,Уф... у... мен...
Dialogue: 0,0:43:51.04,0:43:54.46,Default,,0,0,0,,Маған келсек, Мушикинг...
Dialogue: 0,0:43:54.59,0:43:55.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:43:56.00,0:43:57.67,Default,,0,0,0,,Бітті, Аддер!
Dialogue: 0,0:43:57.76,0:43:58.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:58.42,0:44:00.63,Default,,0,0,0,,Мына орманнан кет!
Dialogue: 0,0:44:00.76,0:44:02.59,Default,,0,0,0,,Мен бұл орманды ешкімге бермеймін!
Dialogue: 0,0:44:02.72,0:44:03.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:03.72,0:44:07.14,Default,,0,0,0,,Иә, үндеме! Мушикингті есте сақтаңыз!
Dialogue: 0,0:44:07.26,0:44:09.93,Default,,0,0,0,,Мен әлі бас тартқан жоқпын.
Dialogue: 0,0:44:10.06,0:44:12.85,Default,,0,0,0,,Мен міндетті түрде қайтамын!
Dialogue: 0,0:44:26.28,0:44:27.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:28.16,0:44:29.24,Default,,0,0,0,,Попо!
Dialogue: 0,0:44:29.41,0:44:31.25,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:44:31.71,0:44:33.21,Default,,0,0,0,,Амансың ба? Попо
Dialogue: 0,0:44:33.67,0:44:36.17,Default,,0,0,0,,Ух... аа... бәрі?
Dialogue: 0,0:44:36.29,0:44:38.38,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:44:38.50,0:44:39.67,Default,,0,0,0,,Әрине
Dialogue: 0,0:44:40.17,0:44:41.92,Default,,0,0,0,,Бұл Попоның анасының дәрісі.
Dialogue: 0,0:44:42.05,0:44:43.76,Default,,0,0,0,,Ах... Рики
Dialogue: 0,0:44:44.89,0:44:47.22,Default,,0,0,0,,Сен жеңдің, Мушикинг.
Dialogue: 0,0:44:47.89,0:44:50.10,Default,,0,0,0,,Барлығының күшімен жеңіске жеттік.
Dialogue: 0,0:44:50.27,0:44:52.56,Default,,0,0,0,,А... иә!
Dialogue: 0,0:44:54.23,0:44:56.06,Default,,0,0,0,,Әй, Кавказ!
Dialogue: 0,0:44:56.69,0:44:57.61,Default,,0,0,0,,Жарайды
Dialogue: 0,0:44:57.90,0:44:59.69,Default,,0,0,0,,Мен жай ғана ес-түссіз жатырмын.
Dialogue: 0,0:44:59.82,0:45:02.49,Default,,0,0,0,,Сіз қазір Аддер техникасын меңгерген шығарсыз.
Dialogue: 0,0:45:02.65,0:45:05.53,Default,,0,0,0,,Қараңдар! Бұл кемпірқосақ! Ах...
Dialogue: 0,0:45:08.58,0:45:09.87,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:45:09.99,0:45:12.70,Default,,0,0,0,,Мен бұрын-соңды мұндай әдемі кемпірқосақты көрген емеспін.
Dialogue: 0,0:45:12.83,0:45:14.33,Default,,0,0,0,,Буси!
Dialogue: 0,0:45:14.62,0:45:15.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:15.67,0:45:16.83,Default,,0,0,0,,(Суджибутоның айқайы)
Dialogue: 0,0:45:16.96,0:45:18.96,Default,,0,0,0,,Неге жылайсың? суджибуто
Dialogue: 0,0:45:19.09,0:45:19.92,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:45:20.46,0:45:23.88,Default,,0,0,0,,Бірақ әйтеуір көзіме жас келеді.
Dialogue: 0,0:45:24.22,0:45:25.84,Default,,0,0,0,,Ей, қарама.
Dialogue: 0,0:45:25.97,0:45:27.59,Default,,0,0,0,,Ұят емес... Ауырды.
Dialogue: 0,0:45:27.72,0:45:29.56,Default,,0,0,0,,(Суджибутоның айқайы)
Dialogue: 0,0:45:29.68,0:45:33.02,Default,,0,0,0,,Мен енді сұмырай емеспін, бірақ жылауық балаға айналдым.
Dialogue: 0,0:45:33.14,0:45:35.02,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:45:35.14,0:45:38.77,Default,,0,0,0,,Күлме! Ал...
Dialogue: 0,0:45:42.23,0:45:45.15,Default,,0,0,0,,Сізге көп қиындық тудырғаным үшін кешіріңіз.
Dialogue: 0,0:45:45.28,0:45:46.20,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:45:46.49,0:45:49.41,Default,,0,0,0,,Сізді жаңа ғана Аддер басқарды.
Dialogue: 0,0:45:49.58,0:45:50.66,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:45:50.83,0:45:53.37,Default,,0,0,0,,Келесі жолы оны көргенде, мен бірден...
Dialogue: 0,0:45:53.50,0:45:54.33,Default,,0,0,0,,Хахаха
Dialogue: 0,0:45:54.46,0:45:57.83,Default,,0,0,0,,Кетчон Кечон, Корокоропи…\NМен оны
Dialogue: 0,0:45:57.96,0:45:59.13,Default,,0,0,0,,жасаймын!
Dialogue: 0,0:45:59.21,0:46:01.50,Default,,0,0,0,,Ахахха... Дұрыс.
Dialogue: 0,0:46:01.71,0:46:03.46,Default,,0,0,0,,Рахмет саған Мушикинг
Dialogue: 0,0:46:03.59,0:46:04.67,Default,,0,0,0,,О
Dialogue: 0,0:46:04.80,0:46:07.09,Default,,0,0,0,,Бізге қазір бару керек.
Dialogue: 0,0:46:07.68,0:46:09.26,Default,,0,0,0,,Мен мұнда мәңгі қала аламын ба?
Dialogue: 0,0:46:09.39,0:46:10.55,Default,,0,0,0,,Хмм... Дұрыс!
Dialogue: 0,0:46:10.76,0:46:13.02,Default,,0,0,0,,Неге осында тұрмайсың?
Dialogue: 0,0:46:13.14,0:46:15.10,Default,,0,0,0,,Маған орман үйретті
Dialogue: 0,0:46:15.60,0:46:17.31,Default,,0,0,0,,Бұл сенің орманың.
Dialogue: 0,0:46:19.15,0:46:22.69,Default,,0,0,0,,Біздің өз орманымыз бар
Dialogue: 0,0:46:23.15,0:46:26.95,Default,,0,0,0,,Біз өз орманымызды іздеуге шығамыз
Dialogue: 0,0:46:28.78,0:46:30.07,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:46:31.33,0:46:32.20,Default,,0,0,0,,О
Dialogue: 0,0:46:32.33,0:46:34.37,Default,,0,0,0,,Мен сендерді ұмытпаймын
Dialogue: 0,0:46:34.62,0:46:36.29,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:46:37.16,0:46:38.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:41.96,0:46:44.51,Default,,0,0,0,,Орманыңды табатыныңа сенімдімін.
Dialogue: 0,0:46:44.92,0:46:48.30,Default,,0,0,0,,Оған дейін мен ұшуды жалғастырамын
Dialogue: 0,0:46:51.68,0:46:53.97,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:46:54.10,0:46:55.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:55.39,0:46:56.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:58.06,0:47:00.60,Default,,0,0,0,,Қалғандары да қауіпсіз болды.
Dialogue: 0,0:47:00.98,0:47:03.73,Default,,0,0,0,,Жаңбыр жауған отты да сөндірген сияқты.
Dialogue: 0,0:47:05.40,0:47:07.90,Default,,0,0,0,,Мен оны табатыныңызға сенімдімін.
Dialogue: 0,0:47:08.11,0:47:10.86,Default,,0,0,0,,Олар оны табады
Dialogue: 0,0:47:11.03,0:47:13.03,Default,,0,0,0,,Айтпақшы, ей, Мушикинг.
Dialogue: 0,0:47:13.16,0:47:13.83,Default,,0,0,0,,Не?
Dialogue: 0,0:47:14.08,0:47:17.20,Default,,0,0,0,,Мен... бұл...
Dialogue: 0,0:47:17.66,0:47:19.79,Default,,0,0,0,,Мені өзіңе шәкірт ете аласың ба? иә?
Dialogue: 0,0:47:20.00,0:47:22.58,Default,,0,0,0,,Мен одан да күшті болғым келеді.
Dialogue: 0,0:47:22.71,0:47:25.25,Default,,0,0,0,,Ендеше мені өзіңе шәкірт етші!
Dialogue: 0,0:47:25.42,0:47:26.76,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:47:28.34,0:47:31.22,Default,,0,0,0,,Жоқ, бұл енді сізге қажет емес.
Dialogue: 0,0:47:31.34,0:47:32.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:32.84,0:47:36.22,Default,,0,0,0,,Енді өз бетінше күресуге болады.
Dialogue: 0,0:47:36.35,0:47:38.93,Default,,0,0,0,,Сол батылдығыңызда бір адам да күшті бола алады
Dialogue: 0,0:47:39.06,0:47:42.15,Default,,0,0,0,,Жоқ, сен жалғыз мықты болуың керек.
Dialogue: 0,0:47:42.27,0:47:44.61,Default,,0,0,0,,Бұл... батылдық...
Dialogue: 0,0:47:45.77,0:47:47.07,Default,,0,0,0,,Өтінемін, алға жүріңіз.
Dialogue: 0,0:47:47.23,0:47:48.99,Default,,0,0,0,,Өте керемет болды
Dialogue: 0,0:47:49.11,0:47:51.49,Default,,0,0,0,,Мен жаңа ғана Аддерден таяқты алдым.
Dialogue: 0,0:47:51.61,0:47:55.33,Default,,0,0,0,,Олай айтпа, тоқташы.
Dialogue: 0,0:47:55.45,0:47:57.04,Default,,0,0,0,,Иә? тағы жылады
Dialogue: 0,0:47:57.16,0:47:58.70,Default,,0,0,0,,Не? Не... Мен жыламаймын.
Dialogue: 0,0:47:58.95,0:48:00.12,Default,,0,0,0,,Қарашы, сен жылап жатқан жоқсың ғой?
Dialogue: 0,0:48:00.25,0:48:01.54,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:48:01.67,0:48:03.13,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:48:03.25,0:48:05.46,Default,,0,0,0,,Ахахаха... хехехе...
Dialogue: 0,0:48:05.59,0:48:07.38,Default,,0,0,0,,Мама, мен үйдемін!
Dialogue: 0,0:48:07.50,0:48:08.96,Default,,0,0,0,,Қош келдіңіз Попо
Dialogue: 0,0:48:09.09,0:48:10.63,Default,,0,0,0,,Білесің бе, көп нәрсе болды.
Dialogue: 0,0:48:10.76,0:48:12.05,Default,,0,0,0,,Орман – бұл
Dialogue: 0,0:48:12.18,0:48:14.89,Default,,0,0,0,,Ол бізді әрқашан қорғады.
Dialogue: 0,0:48:16.22,0:48:17.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:48:23.44,0:48:25.36,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:48:25.48,0:48:28.86,Default,,0,0,0,,Өтінемін, мені өзіңе шәкірт ет!
Dialogue: 0,0:48:28.98,0:48:33.45,Default,,0,0,0,,Мушикинг... жоқ, Мушикинг-сама!
Dialogue: 0,0:48:35.91,0:48:41.91,Default,,0,0,0,,♪〜
Dialogue: 0,0:50:59.97,0:51:05.97,Default,,0,0,0,,〜♪
