Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.01,0:00:14.85,Default,,0,0,0,,Гу?
Dialogue: 0,0:00:15.10,0:00:16.22,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:00:16.35,0:00:18.10,Default,,0,0,0,,Бастық, дайын.
Dialogue: 0,0:00:18.48,0:00:19.44,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:00:19.56,0:00:21.69,Default,,0,0,0,,Уау~ Өте сәнді!
Dialogue: 0,0:00:22.02,0:00:24.36,Default,,0,0,0,,Сізге жақсы Пип Гу Гу...
Dialogue: 0,0:00:24.48,0:00:26.11,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:00:26.23,0:00:28.44,Default,,0,0,0,,Құшақтау…
Dialogue: 0,0:00:31.53,0:00:33.45,Default,,0,0,0,,Құбыр Мен сіздің жауап беру құрылғыңыз болғаныма қуаныштымын.
Dialogue: 0,0:00:35.41,0:00:36.45,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:00:40.21,0:00:42.83,Default,,0,0,0,,Құшақтау…
Dialogue: 0,0:00:42.96,0:00:44.04,Default,,0,0,0,,Гу?
Dialogue: 0,0:00:44.67,0:00:46.34,Default,,0,0,0,,Құшақтау Құшақтау Құшақтау…
Dialogue: 0,0:00:46.46,0:00:47.67,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:00:47.80,0:00:49.38,Default,,0,0,0,,Жасай бер! (Танкер) Өлтір!
Dialogue: 0,0:00:49.63,0:00:51.76,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:00:55.93,0:00:57.35,Default,,0,0,0,,Кабу-сама
Dialogue: 0,0:00:57.85,0:01:00.52,Default,,0,0,0,,Нацумэмен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:01:01.89,0:01:04.31,Default,,0,0,0,,Мен де... Сенің қолыңнан келмейді.
Dialogue: 0,0:01:05.40,0:01:08.15,Default,,0,0,0,,Кешіріңіз... Мен егжей-тегжейлі айта алмаймын.
Dialogue: 0,0:01:09.49,0:01:13.53,Default,,0,0,0,,Сіз маған осындай маңызды нәрселер туралы әлі сөйлеспейсіз.
Dialogue: 0,0:01:14.37,0:01:17.28,Default,,0,0,0,,Бірақ бұл жерде бір жұмбақ бар...
Dialogue: 0,0:01:17.45,0:01:18.29,Default,,0,0,0,,Не!
Dialogue: 0,0:01:18.41,0:01:20.91,Default,,0,0,0,,Маған ұнайды!
Dialogue: 0,0:01:21.21,0:01:22.96,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,0:01:23.08,0:01:24.88,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:25.29,0:01:28.05,Default,,0,0,0,,Мен бұл тозақты міндетті түрде аяқтаймын.
Dialogue: 0,0:01:28.21,0:01:29.51,Default,,0,0,0,,Ендеше аман қалыңыз және күтіңіз.
Dialogue: 0,0:01:30.17,0:01:32.34,Default,,0,0,0,,Менің білуімше, сен солайсың
Dialogue: 0,0:01:32.97,0:01:34.76,Default,,0,0,0,,Ең күшті жақсы әйел
Dialogue: 0,0:01:35.05,0:01:36.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:36.68,0:01:39.22,Default,,0,0,0,,Күшті бол
Dialogue: 0,0:01:39.43,0:01:42.60,Default,,0,0,0,,Кабу мырза ең жақсы!
Dialogue: 0,0:01:43.14,0:01:44.35,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:01:44.48,0:01:46.52,Default,,0,0,0,,Су астында беткі қабаттан әрбір 10 метрге тереңдеген сайын—
Dialogue: 0,0:01:48.73,0:01:50.19,Default,,0,0,0,,Жарайды, кетті.
Dialogue: 0,0:01:54.03,0:01:55.66,Default,,0,0,0,,Мен барамын...
Dialogue: 0,0:01:58.95,0:02:03.96,Default,,0,0,0,,♪~
Dialogue: 0,0:03:23.83,0:03:28.83,Default,,0,0,0,,~♪
Dialogue: 0,0:03:33.30,0:03:35.34,Default,,0,0,0,,Бұрын түсіндірілгендей,
Dialogue: 0,0:03:35.92,0:03:37.68,Default,,0,0,0,,Гадоль зауытының айналасында
Dialogue: 0,0:03:37.80,0:03:41.35,Default,,0,0,0,,Чипке жауап беретін көрінбейтін қалқан орналастырылған
Dialogue: 0,0:03:42.10,0:03:45.35,Default,,0,0,0,,Егер сіз біреуге жалаңаш түрде жақындасаңыз, дереу жүйеден шығыңыз.
Dialogue: 0,0:03:45.72,0:03:48.31,Default,,0,0,0,,Егер ол танкер болса, ол өңделеді.
Dialogue: 0,0:03:48.94,0:03:52.44,Default,,0,0,0,,Бірақ егер Кабураги мырзада чип және сол қате болмаса...
Dialogue: 0,0:03:52.57,0:03:54.57,Default,,0,0,0,,Анықталмауы керек
Dialogue: 0,0:03:55.07,0:03:57.99,Default,,0,0,0,,Бұл шынымен жұмыс істей ме?
Dialogue: 0,0:03:58.32,0:04:01.12,Default,,0,0,0,,Бибіби үлкен жігіт шығар.
Dialogue: 0,0:04:01.24,0:04:02.83,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:04:02.95,0:04:05.12,Default,,0,0,0,,Біріншіден, Гадолл зауытына енгеннен кейін.
Dialogue: 0,0:04:05.24,0:04:08.87,Default,,0,0,0,,Басқару аймағында GGS іске қосыңыз.
Dialogue: 0,0:04:09.00,0:04:12.84,Default,,0,0,0,,Бұл сөзбе-сөз Гадолды өлтіреді.
Dialogue: 0,0:04:13.13,0:04:15.71,Default,,0,0,0,,Ол бір қосқыш арқылы жойыла ма?
Dialogue: 0,0:04:15.84,0:04:17.34,Default,,0,0,0,,Бұл ақылға қонымсыз.
Dialogue: 0,0:04:17.80,0:04:20.59,Default,,0,0,0,,Біз де солаймыз.
Dialogue: 0,0:04:20.80,0:04:24.43,Default,,0,0,0,,Өйткені, бізді жүйе тірі қалдырады.
Dialogue: 0,0:04:24.93,0:04:25.85,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:04:26.22,0:04:28.27,Default,,0,0,0,,Соңында қуат реакторын жойыңыз
Dialogue: 0,0:04:28.39,0:04:31.94,Default,,0,0,0,,Енді әзірше жаңа Гадол тумайды.
Dialogue: 0,0:04:32.06,0:04:34.61,Default,,0,0,0,,Не? Бұл таңқаларлық оңай жеңіс болды.
Dialogue: 0,0:04:34.73,0:04:36.28,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? (Донателло Түркия) Иә?
Dialogue: 0,0:04:36.61,0:04:39.28,Default,,0,0,0,,Зауытқа кіру мүмкін болса да
Dialogue: 0,0:04:39.61,0:04:43.03,Default,,0,0,0,,Күзетшіден жалтарып, межелі жерге жету мүмкін емес.
Dialogue: 0,0:04:43.16,0:04:44.91,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:04:45.24,0:04:47.16,Default,,0,0,0,,Иә? Сонымен не істеуіміз керек?
Dialogue: 0,0:04:47.54,0:04:50.12,Default,,0,0,0,,Бұл жігіттің шалқанмен қарым-қатынасы осымен бітті ме?
Dialogue: 0,0:04:50.25,0:04:51.00,Default,,0,0,0,,Эй
Dialogue: 0,0:04:51.12,0:04:51.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:52.37,0:04:56.80,Default,,0,0,0,,Бұл Гадолл зауыты, сондықтан географиялық артықшылықты пайдаланайық.
Dialogue: 0,0:04:57.84,0:04:59.97,Default,,0,0,0,,Шаралар осы жерде жасалады.
Dialogue: 0,0:05:00.09,0:05:01.47,Default,,0,0,0,,Кабураги мырза керек
Dialogue: 0,0:05:01.59,0:05:04.85,Default,,0,0,0,,Гадолл шайқасы үшін жабдықты жабдықтаңыз.
Dialogue: 0,0:05:04.97,0:05:05.80,Default,,0,0,0,,О
Dialogue: 0,0:05:06.22,0:05:08.56,Default,,0,0,0,,Әйтеуір, Джил Чан ынталы сияқты.
Dialogue: 0,0:05:08.77,0:05:09.77,Default,,0,0,0,,Хмм! Хехе!
Dialogue: 0,0:05:09.89,0:05:12.94,Default,,0,0,0,,Хе хе хе... хе...
Dialogue: 0,0:05:13.40,0:05:16.82,Default,,0,0,0,,Сәлем! Эй, жүр, кел, кел, Джил Чан, жүр.
Dialogue: 0,0:05:16.94,0:05:18.19,Default,,0,0,0,,Я...
Dialogue: 0,0:05:18.65,0:05:22.70,Default,,0,0,0,,Керісінше, адам шындықтың бір бөлігін көреді.
Dialogue: 0,0:05:23.11,0:05:25.49,Default,,0,0,0,,Сіздің есі дұрыс па?
Dialogue: 0,0:05:25.62,0:05:26.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:28.87,0:05:29.70,Default,,0,0,0,,Бастық?
Dialogue: 0,0:05:30.25,0:05:31.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:31.79,0:05:33.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.29,0:05:35.58,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:05:40.46,0:05:41.72,Default,,0,0,0,,Бұл жерден серуендеу.
Dialogue: 0,0:05:42.34,0:05:46.05,Default,,0,0,0,,Уау! ғажайып үлкен көл
Dialogue: 0,0:05:52.64,0:05:54.23,Default,,0,0,0,,Бір минут күте тұрыңыз, иә?
Dialogue: 0,0:05:55.06,0:05:55.98,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:05:56.11,0:05:57.48,Default,,0,0,0,,Мен түсіндім, иә?
Dialogue: 0,0:05:58.36,0:06:00.48,Default,,0,0,0,,Гадолдың көзі жақын жерде, солай ма?
Dialogue: 0,0:06:01.28,0:06:02.90,Default,,0,0,0,,Көңіл-күйімізді көтерейік
Dialogue: 0,0:06:03.03,0:06:05.61,Default,,0,0,0,,Әй, эй, олай емес!
Dialogue: 0,0:06:05.82,0:06:07.99,Default,,0,0,0,,Не? Басқа нәрсе болды ма?
Dialogue: 0,0:06:08.16,0:06:09.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.70,0:06:10.74,Default,,0,0,0,,Ештеңе емес пе?
Dialogue: 0,0:06:11.08,0:06:13.50,Default,,0,0,0,,Біраз уақыттан бері болды ма?
Dialogue: 0,0:06:13.62,0:06:15.25,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:06:16.88,0:06:18.25,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:21.34,0:06:23.13,Default,,0,0,0,,Сіз оны қауіпсіз аяқтаған сияқтысыз.
Dialogue: 0,0:06:23.26,0:06:24.01,Default,,0,0,0,,О
Dialogue: 0,0:06:24.55,0:06:26.80,Default,,0,0,0,,Осы сәттен бастап бәрі жоспарланғандай болады.
Dialogue: 0,0:06:26.93,0:06:27.68,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:27.80,0:06:29.01,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:06:29.30,0:06:31.93,Default,,0,0,0,,Цк, жарайды.
Dialogue: 0,0:06:32.06,0:06:33.85,Default,,0,0,0,,Стратегияның уақыты келді...
Dialogue: 0,0:06:33.98,0:06:35.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.23,0:06:38.90,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:06:39.02,0:06:40.36,Default,,0,0,0,,Гахахаха...
Dialogue: 0,0:06:40.48,0:06:41.90,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:06:42.23,0:06:43.53,Default,,0,0,0,,Егер сіз мұны істесеңіз...
Dialogue: 0,0:06:43.69,0:06:44.82,Default,,0,0,0,,Сонша шуламаңыз!
Dialogue: 0,0:06:45.65,0:06:47.20,Default,,0,0,0,,Бұл соңғысы, солай ма?
Dialogue: 0,0:06:47.32,0:06:47.99,Default,,0,0,0,,Көңіліңіз жеткенше ләззат алыңыз!
Dialogue: 0,0:06:47.99,0:06:50.41,Default,,0,0,0,,Көңіліңіз жеткенше ләззат алыңыз!
Dialogue: 0,0:06:47.99,0:06:50.41,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:52.45,0:06:53.20,Default,,0,0,0,,Tsk
Dialogue: 0,0:06:53.33,0:06:56.50,Default,,0,0,0,,Сіздің маңдай тізбегіңіз боққа толы емес пе?
Dialogue: 0,0:06:59.67,0:07:02.00,Default,,0,0,0,,Барлығы, операция басталады.
Dialogue: 0,0:07:02.17,0:07:06.59,Default,,0,0,0,,Жарайсыңдар, бейбақтар, дайынсыңдар ма?
Dialogue: 0,0:07:06.72,0:07:08.39,Default,,0,0,0,,Бұл топтама! (Киборг) Ооо!
Dialogue: 0,0:07:08.51,0:07:09.60,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:07:09.80,0:07:11.85,Default,,0,0,0,,Ол ақыры келді ме? (Кайборг) Жасайық!
Dialogue: 0,0:07:11.97,0:07:12.93,Default,,0,0,0,,Нихи
Dialogue: 0,0:07:13.06,0:07:16.94,Default,,0,0,0,,Уақыт келді, соқтық!
Dialogue: 0,0:07:19.81,0:07:21.11,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:07:21.52,0:07:23.15,Default,,0,0,0,,Бұл! (Киборг) Эй!
Dialogue: 0,0:07:23.28,0:07:24.19,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:07:26.36,0:07:28.53,Default,,0,0,0,,Өртеп жібер! Өрт!
Dialogue: 0,0:07:28.70,0:07:30.62,Default,,0,0,0,,Барған сайын күйдіріңіз
Dialogue: 0,0:07:30.74,0:07:34.04,Default,,0,0,0,,Сасық түтінді иіскеу
Dialogue: 0,0:07:34.29,0:07:36.25,Default,,0,0,0,,Өртеп жібер! Өрт!
Dialogue: 0,0:07:36.37,0:07:37.16,Default,,0,0,0,,Барған сайын күйдіріңіз
Dialogue: 0,0:07:37.16,0:07:38.17,Default,,0,0,0,,Барған сайын күйдіріңіз
Dialogue: 0,0:07:37.16,0:07:38.17,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:07:38.17,0:07:38.29,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:07:38.29,0:07:38.75,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:07:38.29,0:07:38.75,Default,,0,0,0,,Сасық түтінді иіскеу
Dialogue: 0,0:07:38.75,0:07:38.87,Default,,0,0,0,,Сасық түтінді иіскеу.
Dialogue: 0,0:07:38.87,0:07:40.29,Default,,0,0,0,,Сасық түтінді иіскеу.
Dialogue: 0,0:07:38.87,0:07:40.29,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:07:40.29,0:07:41.29,Default,,0,0,0,,Сасық түтінді иіскеу
Dialogue: 0,0:07:41.29,0:07:41.96,Default,,0,0,0,,Сасық түтінді иіскеу
Dialogue: 0,0:07:41.29,0:07:41.96,Default,,0,0,0,,Достарымызды өз қолымызбен құтқарамыз, солай ма?
Dialogue: 0,0:07:41.96,0:07:42.13,Default,,0,0,0,,Достарымызды өз қолымызбен құтқарамыз, солай ма?
Dialogue: 0,0:07:42.13,0:07:44.05,Default,,0,0,0,,Достарымызды өз қолымызбен құтқарамыз, солай ма?
Dialogue: 0,0:07:42.13,0:07:44.05,Default,,0,0,0,,Өртен! Өрт!
Dialogue: 0,0:07:44.17,0:07:44.34,Default,,0,0,0,,Барған сайын өртеніңіз...
Dialogue: 0,0:07:44.34,0:07:45.30,Default,,0,0,0,,Барған сайын өртеніңіз...
Dialogue: 0,0:07:44.34,0:07:45.30,Default,,0,0,0,,А...
Dialogue: 0,0:07:46.01,0:07:47.47,Default,,0,0,0,,Батыр…
Dialogue: 0,0:07:48.34,0:07:49.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.39,0:07:51.39,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:07:53.81,0:07:55.02,Default,,0,0,0,,Иә? Бұл не түтін?
Dialogue: 0,0:07:55.14,0:07:56.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:56.48,0:07:57.64,Default,,0,0,0,,Бое~ (бақылау) Жерде не болып жатыр...
Dialogue: 0,0:08:00.35,0:08:01.73,Default,,0,0,0,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:08:01.86,0:08:03.11,Default,,0,0,0,,Желдету жүйесін жылдам орнату...
Dialogue: 0,0:08:03.23,0:08:04.40,Default,,0,0,0,,Бое~
Dialogue: 0,0:08:05.82,0:08:07.65,Default,,0,0,0,,Менің ойымша, бәрі жақсы болып жатыр...
Dialogue: 0,0:08:08.07,0:08:09.32,Default,,0,0,0,,О...
Dialogue: 0,0:08:09.45,0:08:10.28,Default,,0,0,0,,Жақсы жүріп жатыр.
Dialogue: 0,0:08:10.41,0:08:11.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.57,0:08:13.62,Default,,0,0,0,,Мұнда желдету жүйесі арқылы
Dialogue: 0,0:08:13.74,0:08:16.45,Default,,0,0,0,,Гадолл шитінің құрамындағы улы заттар
Dialogue: 0,0:08:16.58,0:08:19.08,Default,,0,0,0,,Ол суға ағып жатыр.
Dialogue: 0,0:08:19.92,0:08:23.84,Default,,0,0,0,,Гадолл – суда туып өсетін акодерма түрі.
Dialogue: 0,0:08:24.25,0:08:28.84,Default,,0,0,0,,Олардың судың ластануынан аман қалу мүмкіндігі жоқ.
Dialogue: 0,0:08:29.84,0:08:30.84,Default,,0,0,0,,Гобо…
Dialogue: 0,0:08:33.80,0:08:35.47,Default,,0,0,0,,Енді жоғарыдағы зауыт
Dialogue: 0,0:08:35.60,0:08:38.48,Default,,0,0,0,,Бұл қызық болады, солай емес пе?
Dialogue: 0,0:08:38.89,0:08:39.73,Default,,0,0,0,,Сасық!
Dialogue: 0,0:08:40.06,0:08:41.98,Default,,0,0,0,,Мынау, мынау, мынау!
Dialogue: 0,0:08:43.02,0:08:45.65,Default,,0,0,0,,Қат! Не болып жатыр?
Dialogue: 0,0:08:45.90,0:08:47.99,Default,,0,0,0,,Судың сапасы өте ластанған
Dialogue: 0,0:08:48.40,0:08:50.24,Default,,0,0,0,,Гадолл кернеуінің мәні макс.
Dialogue: 0,0:08:50.36,0:08:51.86,Default,,0,0,0,,Аймақтың кеңеюі сәйкес келмейді
Dialogue: 0,0:08:52.11,0:08:54.07,Default,,0,0,0,,Аймақ функциясын уақытша тоқтатыңыз!
Dialogue: 0,0:08:54.20,0:08:54.99,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:55.58,0:08:58.50,Default,,0,0,0,,Дегенмен, ластану жылдамдығы жылдам және жауап беру үшін біраз уақыт қажет...
Dialogue: 0,0:08:58.79,0:09:01.00,Default,,0,0,0,,Онымен тез арада айналысайық!
Dialogue: 0,0:09:03.08,0:09:04.46,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:09:09.55,0:09:11.09,Default,,0,0,0,,Бұл кіреберіс.
Dialogue: 0,0:09:11.76,0:09:12.89,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:13.14,0:09:15.72,Default,,0,0,0,,А... иә
Dialogue: 0,0:09:19.39,0:09:22.02,Default,,0,0,0,,Бұл бастық қайда?
Dialogue: 0,0:09:22.14,0:09:24.61,Default,,0,0,0,,Біз Гадоллдың көзіне қарай бара жатырмыз, солай ма?
Dialogue: 0,0:09:25.40,0:09:26.52,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:09:26.65,0:09:28.32,Default,,0,0,0,,Гадолды қалай жоюға болады
Dialogue: 0,0:09:28.44,0:09:31.11,Default,,0,0,0,,Сен екеуміз межелі жерге жетуіміз керек.
Dialogue: 0,0:09:31.95,0:09:33.91,Default,,0,0,0,,Жаман нәрселер туралы ойлама
Dialogue: 0,0:09:34.32,0:09:37.37,Default,,0,0,0,,Тек өмір сүру және мақсаттарыңызға жету туралы ойланыңыз.
Dialogue: 0,0:09:37.87,0:09:39.75,Default,,0,0,0,,Хмм… Иә.
Dialogue: 0,0:09:40.70,0:09:41.75,Default,,0,0,0,,Аймақ!
Dialogue: 0,0:09:41.87,0:09:43.58,Default,,0,0,0,,(лифт қоңырауы)
Dialogue: 0,0:09:44.21,0:09:45.25,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:47.71,0:09:49.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.88,0:09:50.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.96,0:09:52.63,Default,,0,0,0,,Эй, бірдеңе істе.
Dialogue: 0,0:09:52.88,0:09:54.22,Default,,0,0,0,,Аймақты тез тоқтатыңыз!
Dialogue: 0,0:09:54.34,0:09:55.64,Default,,0,0,0,,Қазір істеп жатырмын!
Dialogue: 0,0:09:55.93,0:09:57.51,Default,,0,0,0,,Ой (қызметкерлер) Қат!
Dialogue: 0,0:09:57.64,0:09:58.89,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:09:59.01,0:10:00.18,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:00.31,0:10:01.39,Default,,0,0,0,,Неліктен аймақтар?
Dialogue: 0,0:10:01.85,0:10:02.81,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:10:02.94,0:10:03.10,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:10:03.10,0:10:04.06,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:10:03.10,0:10:04.06,Default,,0,0,0,,Әй, мына жақтан айналып өт.
Dialogue: 0,0:10:04.06,0:10:04.77,Default,,0,0,0,,Әй, мына жақтан айналып өт.
Dialogue: 0,0:10:05.31,0:10:06.15,Default,,0,0,0,,…Күте тұр, біз шын мәнінде оларды атуымыз керек пе?!
Dialogue: 0,0:10:06.27,0:10:07.52,Default,,0,0,0,,Резервуар қайда?
Dialogue: 0,0:10:08.94,0:10:10.28,Default,,0,0,0,,Іс жақсы жүріп жатыр.
Dialogue: 0,0:10:10.78,0:10:12.82,Default,,0,0,0,,Қауіпсіздік те жұмыс істемейді.
Dialogue: 0,0:10:12.95,0:10:14.53,Default,,0,0,0,,Бірден солай... Иә?
Dialogue: 0,0:10:16.62,0:10:17.91,Default,,0,0,0,,Иә! Не?
Dialogue: 0,0:10:18.03,0:10:18.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.66,0:10:22.50,Default,,0,0,0,,Біз сізді күттік, Кабураги мырза.
Dialogue: 0,0:10:22.62,0:10:23.66,Default,,0,0,0,,Гя
Dialogue: 0,0:10:29.84,0:10:31.34,Default,,0,0,0,,Мен Эбисуға сенемін.
Dialogue: 0,0:10:31.46,0:10:35.34,Default,,0,0,0,,Одан гөрі негізгі блокқа көбірек алаңдау керек емес пе?
Dialogue: 0,0:10:35.47,0:10:38.60,Default,,0,0,0,,Мен сізге тезірек оралуды ұсынамын.
Dialogue: 0,0:10:38.72,0:10:39.93,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:10:40.93,0:10:43.31,Default,,0,0,0,,Бұл мысалдағы қате.
Dialogue: 0,0:10:44.10,0:10:47.19,Default,,0,0,0,,Оны, әрине, жүйе танымайды.
Dialogue: 0,0:10:47.31,0:10:48.23,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:48.44,0:10:50.32,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:10:50.44,0:10:51.78,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:10:51.90,0:10:55.07,Default,,0,0,0,,Әлемге қателер қажет емес...
Dialogue: 0,0:10:56.78,0:10:57.99,Default,,0,0,0,,Бое~
Dialogue: 0,0:10:58.20,0:11:00.99,Default,,0,0,0,,Мынау.
Dialogue: 0,0:11:02.62,0:11:03.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:03.62,0:11:06.46,Default,,0,0,0,,Мен саған тезек жегіздім.
Dialogue: 0,0:11:03.62,0:11:06.46,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:11:07.29,0:11:10.71,Default,,0,0,0,,Сіз әдетте бокпен жабылмайсыз.
Dialogue: 0,0:11:11.13,0:11:15.38,Default,,0,0,0,,Енді Кабураги мырзаның стратегиясы сәтті болса...
Dialogue: 0,0:11:16.05,0:11:17.76,Default,,0,0,0,,Барлығы керемет...
Dialogue: 0,0:11:17.88,0:11:18.72,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:18.84,0:11:20.39,Default,,0,0,0,,Эй, балалар (Түркия Саркози)?
Dialogue: 0,0:11:20.80,0:11:23.27,Default,,0,0,0,,Биіктікке қарама.
Dialogue: 0,0:11:23.39,0:11:25.43,Default,,0,0,0,,Бірге күресейік...
Dialogue: 0,0:11:27.85,0:11:28.81,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:34.40,0:11:38.82,Default,,0,0,0,,Эй, эй, эй...
Dialogue: 0,0:11:45.41,0:11:46.33,Default,,0,0,0,,Күшейткіштер келді
Dialogue: 0,0:11:46.46,0:11:48.33,Default,,0,0,0,,Бұл біздің жеңісіміз.
Dialogue: 0,0:11:48.46,0:11:49.96,Default,,0,0,0,,Сіз бәрібір жақын арада құсуыңыз мүмкін.
Dialogue: 0,0:11:50.08,0:11:51.34,Default,,0,0,0,,Келіңіз және қараңыз.
Dialogue: 0,0:11:51.67,0:11:52.88,Default,,0,0,0,,Ах! Мұрыныңа қара!
Dialogue: 0,0:11:53.09,0:11:55.26,Default,,0,0,0,,Олар бұрынғылардан өзгеше!
Dialogue: 0,0:11:55.38,0:11:57.51,Default,,0,0,0,,Бұл тек мұрын ғана емес
Dialogue: 0,0:11:58.97,0:12:00.22,Default,,0,0,0,,А? Не?
Dialogue: 0,0:12:00.34,0:12:01.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:03.68,0:12:05.18,Default,,0,0,0,,Гах! (Киборг) Не?
Dialogue: 0,0:12:05.31,0:12:06.10,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:12:06.22,0:12:07.85,Default,,0,0,0,,Мұрын! (Киборг) Бар!
Dialogue: 0,0:12:07.98,0:12:08.85,Default,,0,0,0,,Қап!
Dialogue: 0,0:12:09.48,0:12:11.36,Default,,0,0,0,,Жетілдірілген күшейтулер?
Dialogue: 0,0:12:12.36,0:12:15.03,Default,,0,0,0,,үшін тым ерте келді
Dialogue: 0,0:12:15.15,0:12:16.11,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:12:16.69,0:12:18.61,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:12:18.74,0:12:21.57,Default,,0,0,0,,Менің достарым бәрі құтқарылады дейді.
Dialogue: 0,0:12:21.70,0:12:24.83,Default,,0,0,0,,Ол үшін Куб мырза мен Донателло мырза...
Dialogue: 0,0:12:24.95,0:12:27.29,Default,,0,0,0,,Не айтып тұрсың, маймыл?
Dialogue: 0,0:12:27.41,0:12:29.83,Default,,0,0,0,,Сіз бұл туралы хабарлағансыз, солай ма?
Dialogue: 0,0:12:29.96,0:12:31.88,Default,,0,0,0,,… …
Dialogue: 0,0:12:32.58,0:12:35.13,Default,,0,0,0,,Әй... мен мұны айтқым келді!
Dialogue: 0,0:12:35.50,0:12:39.72,Default,,0,0,0,,Жарайсың ба? Біз жүйе үшін тәртіпті сақтадық.
Dialogue: 0,0:12:39.84,0:12:40.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:40.97,0:12:42.51,Default,,0,0,0,,Цураны көтеріңіз
Dialogue: 0,0:12:42.64,0:12:44.47,Default,,0,0,0,,Саған ешнәрсе жоқ.
Dialogue: 0,0:12:44.60,0:12:45.97,Default,,0,0,0,,Бірақ... Бірақ!
Dialogue: 0,0:12:46.10,0:12:50.14,Default,,0,0,0,,Керісінше, біз дұрыс істеп жатырмыз.
Dialogue: 0,0:12:50.31,0:12:51.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:51.48,0:12:55.15,Default,,0,0,0,,Менің не айтып тұрғанымды білесіз бе?
Dialogue: 0,0:12:57.90,0:12:59.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:00.20,0:13:01.57,Default,,0,0,0,,Дұрыс әрекет ет...
Dialogue: 0,0:13:01.70,0:13:03.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:03.57,0:13:07.91,Default,,0,0,0,,Енді осы жерді бірге ауыстырайық.
Dialogue: 0,0:13:08.33,0:13:10.66,Default,,0,0,0,,Сіз 2-ші нөмірсіз.
Dialogue: 0,0:13:11.04,0:13:13.58,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:13:14.08,0:13:15.29,Default,,0,0,0,,Хе... хе...
Dialogue: 0,0:13:16.34,0:13:17.09,Default,,0,0,0,,Эй, кіру құрылғысы қайда?
Dialogue: 0,0:13:17.09,0:13:18.13,Default,,0,0,0,,Эй, бұл кіру құрылғысы қайда?
Dialogue: 0,0:13:17.09,0:13:18.13,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:13:18.13,0:13:18.84,Default,,0,0,0,,Эй, бұл кіру құрылғысы қайда?
Dialogue: 0,0:13:19.13,0:13:21.26,Default,,0,0,0,,Эй, эй, мен саған бірден көрсетемін.
Dialogue: 0,0:13:21.38,0:13:23.05,Default,,0,0,0,,Сал, мені өзіңмен бірге ала кет.
Dialogue: 0,0:13:23.18,0:13:24.18,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:24.72,0:13:28.77,Default,,0,0,0,,Tsk! Сол екі ақымаққа жаным ашиды.
Dialogue: 0,0:13:29.85,0:13:34.44,Default,,0,0,0,,Осы жерге қадам бассаңыз, бірінші томның соңы... иә?
Dialogue: 0,0:13:35.40,0:13:37.11,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:13:38.02,0:13:40.82,Default,,0,0,0,,Жарайды, қатты жүрейік!
Dialogue: 0,0:13:40.99,0:13:41.99,Default,,0,0,0,,Апай
Dialogue: 0,0:13:44.66,0:13:46.66,Default,,0,0,0,,ше? Не?
Dialogue: 0,0:13:50.50,0:13:51.58,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:51.87,0:13:54.46,Default,,0,0,0,,Не істеп жатырсың! Ақылды ақымақ әйел!
Dialogue: 0,0:13:54.58,0:13:56.08,Default,,0,0,0,,Мені тез қайтарыңыз!
Dialogue: 0,0:13:56.42,0:13:59.84,Default,,0,0,0,,Мені өзіңе жау қылмақшысың ба?
Dialogue: 0,0:14:00.51,0:14:02.22,Default,,0,0,0,,Эй?
Dialogue: 0,0:14:02.67,0:14:03.59,Default,,0,0,0,,Е...
Dialogue: 0,0:14:03.88,0:14:07.39,Default,,0,0,0,,Үлкен ән болса да, пайдасы жоқ.
Dialogue: 0,0:14:07.51,0:14:11.10,Default,,0,0,0,,Егер операция сіз үшін сәтсіз аяқталса...
Dialogue: 0,0:14:14.81,0:14:18.61,Default,,0,0,0,,Мен сізге қосымша тізбектерді ұйымдастырамын.
Dialogue: 0,0:14:18.73,0:14:20.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:21.07,0:14:23.61,Default,,0,0,0,,Енді жұмысқа барайық.
Dialogue: 0,0:14:23.86,0:14:25.61,Default,,0,0,0,,Стакола тез
Dialogue: 0,0:14:26.82,0:14:28.12,Default,,0,0,0,,Гааах!
Dialogue: 0,0:14:29.45,0:14:32.95,Default,,0,0,0,,Бастық, ол адам аймақта, бірақ неге...
Dialogue: 0,0:14:33.91,0:14:35.50,Default,,0,0,0,,Оны адам деп санамаңыз.
Dialogue: 0,0:14:35.62,0:14:36.96,Default,,0,0,0,,Еш ойланбаңыз, ә...
Dialogue: 0,0:14:37.46,0:14:38.29,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:38.42,0:14:39.25,Default,,0,0,0,,Бұл келе жатыр! Ах!
Dialogue: 0,0:14:40.09,0:14:40.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:42.42,0:14:43.76,Default,,0,0,0,,Цк... Бастық!
Dialogue: 0,0:14:46.38,0:14:47.68,Default,,0,0,0,,Ақымақ еліктеуші
Dialogue: 0,0:14:47.97,0:14:48.89,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:50.76,0:14:51.64,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:14:51.81,0:14:52.56,Default,,0,0,0,,Бастық!
Dialogue: 0,0:14:53.06,0:14:54.06,Default,,0,0,0,,(Марио) Ж… Жуық келме. Бұл тұзақ.
Dialogue: 0,0:14:57.23,0:14:58.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.77,0:15:02.69,Default,,0,0,0,,Нацүме, қазір қаш!
Dialogue: 0,0:15:03.19,0:15:04.99,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:15:05.53,0:15:06.91,Default,,0,0,0,,Мен саған рұқсат бермеймін
Dialogue: 0,0:15:07.03,0:15:07.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:09.37,0:15:12.91,Default,,0,0,0,,Алдымен бір қатені өшіріңіз
Dialogue: 0,0:15:14.45,0:15:15.83,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:15:17.17,0:15:18.71,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Джил.
Dialogue: 0,0:15:19.46,0:15:20.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:21.92,0:15:23.96,Default,,0,0,0,,Бұл күркетауық пен маймылдың кінәсі.
Dialogue: 0,0:15:24.34,0:15:25.92,Default,,0,0,0,,Бұл сәнді.
Dialogue: 0,0:15:26.05,0:15:30.60,Default,,0,0,0,,Ойын полициясын бұзу - ең қиын нәрсе.
Dialogue: 0,0:15:31.14,0:15:33.60,Default,,0,0,0,,Біздің көзқарасымыз мүмкін емес...
Dialogue: 0,0:15:33.93,0:15:36.35,Default,,0,0,0,,Сіздің жағыңызда бақсылар бар ма?
Dialogue: 0,0:15:36.77,0:15:40.48,Default,,0,0,0,,Жарайды, сен мен жағында болсаң мен сенімдімін.
Dialogue: 0,0:15:40.81,0:15:42.23,Default,,0,0,0,,(Зеппели) Мен… э-э, жоқ. (Спидвагон) Ааах…
Dialogue: 0,0:15:42.36,0:15:44.73,Default,,0,0,0,,Иә, мен мұны кешіре алмаймын.
Dialogue: 0,0:15:44.86,0:15:46.65,Default,,0,0,0,,Қателердің алдында
Dialogue: 0,0:15:46.86,0:15:48.49,Default,,0,0,0,,Мен мұны сізге қалдырдым.
Dialogue: 0,0:15:49.24,0:15:51.28,Default,,0,0,0,,(Компьютер жұмысының дыбысы)
Dialogue: 0,0:15:51.41,0:15:52.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:53.16,0:15:56.62,Default,,0,0,0,,Күшті қауіпсіздік бағдарламасы орнатылған
Dialogue: 0,0:16:03.75,0:16:05.13,Default,,0,0,0,,О? Ха!
Dialogue: 0,0:16:05.26,0:16:06.34,Default,,0,0,0,,Барлығы нұсқаулыққа сәйкес дәл осылай өтті.
Dialogue: 0,0:16:06.46,0:16:09.89,Default,,0,0,0,,Мен де, Кабураги мырзаның да денесі мәңгілік...
Dialogue: 0,0:16:13.35,0:16:14.89,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:16:15.68,0:16:17.64,Default,,0,0,0,,Тек шегіне дейін күрес!
Dialogue: 0,0:16:17.77,0:16:20.27,Default,,0,0,0,,Уууу!
Dialogue: 0,0:16:22.48,0:16:23.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:24.69,0:16:27.69,Default,,0,0,0,,А? Сен не істеп жатырсың? Асықшы!
Dialogue: 0,0:16:27.82,0:16:28.78,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:16:28.90,0:16:31.16,Default,,0,0,0,,А-а, бұл...
Dialogue: 0,0:16:31.91,0:16:34.41,Default,,0,0,0,,Ақыр соңында, басқа ештеңе жоқ ...
Dialogue: 0,0:16:34.74,0:16:39.08,Default,,0,0,0,,А? Сіз қате болса да жүйені жақтайсыз ба?
Dialogue: 0,0:16:39.75,0:16:41.29,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:41.42,0:16:42.54,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:16:42.88,0:16:44.42,Default,,0,0,0,,Маған да араластырыңыз.
Dialogue: 0,0:16:44.54,0:16:45.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.21,0:16:48.05,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:16:48.47,0:16:49.55,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:16:49.67,0:16:51.30,Default,,0,0,0,,Барлығы ...
Dialogue: 0,0:16:51.64,0:16:54.01,Default,,0,0,0,,Әй, сіз оны ақырында реттедіңіз бе?
Dialogue: 0,0:16:54.14,0:16:55.72,Default,,0,0,0,,Хееееее!
Dialogue: 0,0:16:55.85,0:16:56.89,Default,,0,0,0,,Гаар!
Dialogue: 0,0:16:57.22,0:16:58.06,Default,,0,0,0,,Пудья!
Dialogue: 0,0:16:59.98,0:17:03.56,Default,,0,0,0,,Мен жоқта қалағаныңды істедің, солай емес пе?
Dialogue: 0,0:17:04.40,0:17:06.02,Default,,0,0,0,,Бұған дейін де.
Dialogue: 0,0:17:06.15,0:17:08.69,Default,,0,0,0,,Хугинге ғашық болған мен едім.
Dialogue: 0,0:17:08.90,0:17:10.86,Default,,0,0,0,,Ол айлакер бейбақ.
Dialogue: 0,0:17:10.99,0:17:12.16,Default,,0,0,0,,Шу!
Dialogue: 0,0:17:12.28,0:17:14.70,Default,,0,0,0,,Біз жүйе бойынша өмір сүреміз
Dialogue: 0,0:17:14.87,0:17:16.91,Default,,0,0,0,,Иә? Қалағаныңды істе
Dialogue: 0,0:17:17.04,0:17:19.20,Default,,0,0,0,,Бұл көңілді болғанша, мен үшін бұл жақсы
Dialogue: 0,0:17:19.54,0:17:22.46,Default,,0,0,0,,А, тым болмаса ләззат ал.
Dialogue: 0,0:17:23.46,0:17:25.92,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:17:26.13,0:17:27.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.55,0:17:28.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:28.67,0:17:30.30,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:32.72,0:17:35.01,Default,,0,0,0,,Гаххахаха!
Dialogue: 0,0:17:35.14,0:17:36.01,Default,,0,0,0,,Хой хой хой
Dialogue: 0,0:17:38.35,0:17:40.18,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:17:40.73,0:17:42.48,Default,,0,0,0,,Бұл Абдур еді ғой, иә?
Dialogue: 0,0:17:45.36,0:17:46.69,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:17:46.82,0:17:49.44,Default,,0,0,0,,Эй, әлгі жігіт...
Dialogue: 0,0:17:50.03,0:17:50.90,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:17:51.03,0:17:52.20,Default,,0,0,0,,Біз де жасаймыз!
Dialogue: 0,0:17:52.32,0:17:53.57,Default,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:17:53.70,0:17:54.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.45,0:17:56.20,Default,,0,0,0,,Маймыл…
Dialogue: 0,0:17:56.49,0:18:00.08,Default,,0,0,0,,Ах... Түркия мырза Хехехе...
Dialogue: 0,0:18:00.29,0:18:01.45,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:18:02.50,0:18:04.46,Default,,0,0,0,,Бірақ мен оңай қозғала аламын.
Dialogue: 0,0:18:04.87,0:18:07.63,Default,,0,0,0,,Бұл жерден бірге кетейік.
Dialogue: 0,0:18:08.29,0:18:10.21,Default,,0,0,0,,Эй, ақымақ.
Dialogue: 0,0:18:10.84,0:18:13.05,Default,,0,0,0,,Маған ешқандай кедергілер керек емес.
Dialogue: 0,0:18:13.76,0:18:14.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:15.01,0:18:18.85,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:19.26,0:18:21.02,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:18:21.18,0:18:24.73,Default,,0,0,0,,Осыны бірге өзгертейік.
Dialogue: 0,0:18:25.23,0:18:27.23,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:18:27.77,0:18:30.78,Default,,0,0,0,,Менің қолымнан келетіні – амнистиямен Шабаға оралу.
Dialogue: 0,0:18:30.90,0:18:33.99,Default,,0,0,0,,Бұл жер бәрібір жабылуы керек еді.
Dialogue: 0,0:18:34.28,0:18:36.49,Default,,0,0,0,,Сіз де, осы жерден аяқтайық.
Dialogue: 0,0:18:36.74,0:18:39.70,Default,,0,0,0,,Бұл бәрібір түкке тұрғысыз. Бұл өмір болды, солай ма?
Dialogue: 0,0:18:43.16,0:18:45.46,Default,,0,0,0,,Қоқыс емес пе...
Dialogue: 0,0:18:45.75,0:18:47.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:48.75,0:18:50.21,Default,,0,0,0,,Мистер Куб...
Dialogue: 0,0:18:50.55,0:18:52.01,Default,,0,0,0,,Тіпті осы жағдайда
Dialogue: 0,0:18:52.26,0:18:56.51,Default,,0,0,0,,Маған не істеуге рұқсат бар? Мен не істегім келеді?
Dialogue: 0,0:18:57.14,0:18:59.26,Default,,0,0,0,,Бұл сергітеді...
Dialogue: 0,0:19:00.81,0:19:02.89,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:19:04.89,0:19:05.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:07.15,0:19:09.77,Default,,0,0,0,,Мен өзімді шектен шығарып жатырмын.
Dialogue: 0,0:19:11.02,0:19:12.23,Default,,0,0,0,,Шектер…
Dialogue: 0,0:19:13.07,0:19:14.86,Default,,0,0,0,,Мистер Куб...
Dialogue: 0,0:19:16.24,0:19:17.53,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:19:19.20,0:19:21.41,Default,,0,0,0,,Ха ха ха ха... Иә?
Dialogue: 0,0:19:21.99,0:19:23.41,Default,,0,0,0,,Не!
Dialogue: 0,0:19:24.33,0:19:27.08,Default,,0,0,0,,Ей, менімен ойнайық.
Dialogue: 0,0:19:28.21,0:19:30.59,Default,,0,0,0,,Донателло!
Dialogue: 0,0:19:31.04,0:19:32.84,Default,,0,0,0,,Сау болыңыз! Иә!
Dialogue: 0,0:19:35.26,0:19:37.34,Default,,0,0,0,,Не? Уау!
Dialogue: 0,0:19:37.80,0:19:39.59,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:19:39.97,0:19:43.22,Default,,0,0,0,,Мен бұрынғы қалпымда қалғаныма қуаныштымын.
Dialogue: 0,0:19:43.35,0:19:45.64,Default,,0,0,0,,Бұл өзімді жайсыз сезінді.
Dialogue: 0,0:19:45.77,0:19:47.60,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:19:50.06,0:19:52.36,Default,,0,0,0,,Егер саған тым қатты ұнаса
Dialogue: 0,0:19:52.48,0:19:53.73,Default,,0,0,0,,Толық дәмін татып көріңіз!
Dialogue: 0,0:19:53.98,0:19:56.28,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:56.40,0:19:57.99,Default,,0,0,0,,(араластырғышқа түскен дыбыс)
Dialogue: 0,0:20:00.37,0:20:02.03,Default,,0,0,0,,Мистер Куб...
Dialogue: 0,0:20:02.16,0:20:04.49,Default,,0,0,0,,Менде ештеңе жоқ.
Dialogue: 0,0:20:05.54,0:20:07.00,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:20:07.75,0:20:09.58,Default,,0,0,0,,Шектеу…
Dialogue: 0,0:20:10.25,0:20:12.79,Default,,0,0,0,,Арнайы...
Dialogue: 0,0:20:12.92,0:20:14.63,Default,,0,0,0,,Гуах
Dialogue: 0,0:20:15.09,0:20:16.88,Default,,0,0,0,,Оксон ерітіндісі
Dialogue: 0,0:20:20.39,0:20:21.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:21.47,0:20:23.14,Default,,0,0,0,,Нгагагага!
Dialogue: 0,0:20:23.26,0:20:25.31,Default,,0,0,0,,Гуаа, біреу!
Dialogue: 0,0:20:25.43,0:20:26.39,Default,,0,0,0,,Эй, маймыл!
Dialogue: 0,0:20:27.39,0:20:30.15,Default,,0,0,0,,Бұл... жақсы, солай емес пе?
Dialogue: 0,0:20:30.27,0:20:33.27,Default,,0,0,0,,Ей, маймыл! Маған көмектесші!
Dialogue: 0,0:20:33.40,0:20:35.65,Default,,0,0,0,,Аа... Нһ!
Dialogue: 0,0:20:36.11,0:20:39.40,Default,,0,0,0,,Gugggggggg...
Dialogue: 0,0:20:42.16,0:20:44.74,Default,,0,0,0,,Gugggggggg...
Dialogue: 0,0:20:44.91,0:20:46.08,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:20:49.87,0:20:52.25,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:21:06.43,0:21:06.76,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:21:06.76,0:21:09.85,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:21:06.76,0:21:09.85,Default,,0,0,0,,Мен аймақ реттелді деп ойлағанымда, бұл жолы не болды?
Dialogue: 0,0:21:10.60,0:21:13.86,Default,,0,0,0,,Жер астында жұмбақ жарылыс болып, қуат реакторы өшеді.
Dialogue: 0,0:21:14.40,0:21:16.32,Default,,0,0,0,,Жоқ, ол жойылды.
Dialogue: 0,0:21:16.44,0:21:17.86,Default,,0,0,0,,Не?
Dialogue: 0,0:21:23.20,0:21:24.62,Default,,0,0,0,,(Әйнектің гидравликалық сынған дыбысы)
Dialogue: 0,0:21:25.28,0:21:26.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:26.58,0:21:28.58,Default,,0,0,0,,Күшті реактор бұзылды ма?
Dialogue: 0,0:21:28.83,0:21:30.87,Default,,0,0,0,,Сіздің әлі де достарыңыз болды ма?
Dialogue: 0,0:21:31.41,0:21:32.75,Default,,0,0,0,,Саана
Dialogue: 0,0:21:32.87,0:21:35.42,Default,,0,0,0,,Бұл денені енді ешқашан пайдаланбау үшін жойыңыз...
Dialogue: 0,0:21:35.54,0:21:36.63,Default,,0,0,0,,Бастық! Ха!
Dialogue: 0,0:21:36.75,0:21:38.00,Default,,0,0,0,,Су! иә?
Dialogue: 0,0:21:38.84,0:21:40.17,Default,,0,0,0,,Ауада ату!
Dialogue: 0,0:21:40.59,0:21:41.42,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:44.43,0:21:46.39,Default,,0,0,0,,Бастық! Жарайды?
Dialogue: 0,0:21:46.51,0:21:48.77,Default,,0,0,0,,Сол кезде бәрі тым кеш қалған шығар деп ойладым…
Dialogue: 0,0:21:49.14,0:21:51.02,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:21:51.94,0:21:54.90,Default,,0,0,0,,Енді GGS ғана қалды...
Dialogue: 0,0:21:55.81,0:21:56.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:58.07,0:22:00.61,Default,,0,0,0,,Сен істейсің, маймыл...
Dialogue: 0,0:22:03.74,0:22:05.37,Default,,0,0,0,,♪~
Dialogue: 0,0:22:05.37,0:22:07.16,Default,,0,0,0,,♪~
Dialogue: 0,0:22:05.37,0:22:07.16,Default,,0,0,0,,Бұл баратын жер
Dialogue: 0,0:22:07.16,0:22:07.95,Default,,0,0,0,,♪~
Dialogue: 0,0:22:07.95,0:22:08.74,Default,,0,0,0,,♪~
Dialogue: 0,0:22:07.95,0:22:08.74,Default,,0,0,0,,А...
Dialogue: 0,0:22:08.74,0:22:08.99,Default,,0,0,0,,А...
Dialogue: 0,0:22:10.37,0:22:11.37,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:22:11.50,0:22:13.16,Default,,0,0,0,,Уф... Бастық!
Dialogue: 0,0:22:13.41,0:22:16.08,Default,,0,0,0,,Амансың ба? Қозғалмаса жақсы...
Dialogue: 0,0:22:16.21,0:22:17.17,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:22:22.47,0:22:23.42,Default,,0,0,0,,Мұны сұраңыз
Dialogue: 0,0:22:23.55,0:22:24.93,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:22:25.64,0:22:29.31,Default,,0,0,0,,Сигнал берген кезде бір уақытта тұтқаны төмендетіңіз.
Dialogue: 0,0:22:29.43,0:22:30.81,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:22:35.31,0:22:36.48,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:22:36.60,0:22:39.19,Default,,0,0,0,,3 2 1
Dialogue: 0,0:22:59.50,0:23:00.80,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:23:00.92,0:23:02.51,Default,,0,0,0,,Бұл қате, солай ма? Бұл...
Dialogue: 0,0:23:02.67,0:23:05.51,Default,,0,0,0,,Ах... Нацумэ, сен істедің.
Dialogue: 0,0:23:05.88,0:23:06.72,Default,,0,0,0,,Бұйрық!
Dialogue: 0,0:23:06.84,0:23:09.64,Default,,0,0,0,,Гадолл бірінен соң бірі жоғалып кетеді.
Dialogue: 0,0:23:09.93,0:23:11.76,Default,,0,0,0,,Осы қарқынмен біз жойыламыз!
Dialogue: 0,0:23:11.89,0:23:12.64,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:23:14.10,0:23:16.02,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:23:19.31,0:23:20.69,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:23:20.82,0:23:23.15,Default,,0,0,0,,Нацумэ, осы жерден қашып шығайық.
Dialogue: 0,0:23:24.03,0:23:26.36,Default,,0,0,0,,Бастық, бұл жер біртүрлі екен ғой.
Dialogue: 0,0:23:26.36,0:23:27.61,Default,,0,0,0,,Бастық, бұл жер біртүрлі~♪
Dialogue: 0,0:23:27.61,0:23:27.86,Default,,0,0,0,,~♪
Dialogue: 0,0:23:27.86,0:23:29.91,Default,,0,0,0,,~♪ Бұл Гадоллдың ұясы емес пе?
Dialogue: 0,0:23:29.91,0:23:30.62,Default,,0,0,0,,~♪
Dialogue: 0,0:23:30.62,0:23:31.37,Default,,0,0,0,,~♪
Dialogue: 0,0:23:30.62,0:23:31.37,Default,,0,0,0,,Тіпті бұрынғы адам...
Dialogue: 0,0:23:31.37,0:23:32.33,Default,,0,0,0,,Тіпті бұрынғы адам...
Dialogue: 0,0:23:32.45,0:23:34.70,Default,,0,0,0,,Бұл не деген сұмдық?!
Dialogue: 0,0:23:36.33,0:23:37.75,Default,,0,0,0,,Нацюме…
Dialogue: 0,0:23:38.50,0:23:40.42,Default,,0,0,0,,Бұл дүниенің бәрі...
Dialogue: 0,0:23:41.13,0:23:42.50,Default,,0,0,0,,Гадол да
Dialogue: 0,0:23:42.80,0:23:44.55,Default,,0,0,0,,Тіпті бұл дене
Dialogue: 0,0:23:46.26,0:23:48.18,Default,,0,0,0,,Бұл жалған
Dialogue: 0,0:23:49.68,0:23:55.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory