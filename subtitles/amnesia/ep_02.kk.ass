Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:05.00,staff,NTP,0,0,0,,
Dialogue: 0,0:00:05.00,0:00:08.00,staff,NTP,0,0,0,,Жоғары сапалы қытай-жапон субтитрлері бар қытай-жапон екі тілді субтитрлер
Dialogue: 0,0:00:08.00,0:00:11.00,staff,NTP,0,0,0,,Қытай-жапон екі тілді субтитрлер мен заңды субтитрлер арқылы жасалған
Dialogue: 0,0:00:11.00,0:00:14.00,staff,NTP,0,0,0,,Көрермендер жазған әңгімеңіз үшін рахмет.
Dialogue: 0,0:00:00.69,0:00:05.36,opj,NTP,0,0,0,,Мен қашып кетуден айырылдым.
Dialogue: 0,0:00:06.09,0:00:11.39,opj,NTP,0,0,0,,Соңғы компонент
Dialogue: 0,0:00:11.57,0:00:17.68,opj,NTP,0,0,0,,Алыстағы жұлдыздарды іздеп, қадағалаңыз
Dialogue: 0,0:00:17.82,0:00:24.15,opj,NTP,0,0,0,,Кемпірқосақ түсті аспанның соңы
Dialogue: 0,0:00:36.45,0:00:41.73,opj,NTP,0,0,0,,Жарықтардан төгілген, Аз күнде ұсталған
Dialogue: 0,0:00:41.85,0:00:44.29,opj,NTP,0,0,0,,Түсімде көрген жол
Dialogue: 0,0:00:44.39,0:00:46.55,opj,NTP,0,0,0,,Жаяу жүру
Dialogue: 0,0:00:46.57,0:00:51.96,opj,NTP,0,0,0,,Үдемелі тартылыс күші қайталанатын күш
Dialogue: 0,0:00:52.01,0:00:55.45,opj,NTP,0,0,0,,Менің жүрегім
Dialogue: 0,0:00:55.51,0:00:59.83,opj,NTP,0,0,0,,Ол адамдарға тиіп, демімен олардың өмірлік күшін сорып, алыптай көлемге дейін өседі.
Dialogue: 0,0:00:59.86,0:01:02.43,opj,NTP,0,0,0,,Мені осылай шығарыңыз.
Dialogue: 0,0:01:02.49,0:01:05.78,opj,NTP,0,0,0,,Шаң және бөлшектер көпірі
Dialogue: 0,0:01:05.86,0:01:08.52,opj,NTP,0,0,0,,Қосылу
Dialogue: 0,0:01:08.60,0:01:11.06,opj,NTP,0,0,0,,Шеңбер құру
Dialogue: 0,0:01:11.12,0:01:12.75,opj,NTP,0,0,0,,Егер сіз оны қарастырсаңыз
Dialogue: 0,0:01:12.80,0:01:16.22,opj,NTP,0,0,0,,Осы мақсат үшін пішінді өзгертіңіз
Dialogue: 0,0:01:16.28,0:01:20.18,opj,NTP,0,0,0,,Айналадан бастаңыз
Dialogue: 0,0:01:20.22,0:01:25.19,opj,NTP,0,0,0,,Менімен көбірек кездесу үшін
Dialogue: 0,0:00:00.69,0:00:05.36,opn,NTP,0,0,0,,Жадты ойнату
Dialogue: 0,0:00:06.09,0:00:11.39,opn,NTP,0,0,0,,Соңғы бөлім
Dialogue: 0,0:00:11.57,0:00:17.68,opn,NTP,0,0,0,,Алыстағы жұлдызды аспанды зерттеу
Dialogue: 0,0:00:17.82,0:00:24.15,opn,NTP,0,0,0,,Боялған нұрлы аспан
Dialogue: 0,0:00:36.45,0:00:41.73,opn,NTP,0,0,0,,Қамалған бос жерден тасып төгілген күн сәулесі
Dialogue: 0,0:00:41.85,0:00:44.29,opn,NTP,0,0,0,,Күндізгі жарық аллеясы
Dialogue: 0,0:00:44.39,0:00:46.55,opn,NTP,0,0,0,,Жүгіру мәресі
Dialogue: 0,0:00:46.57,0:00:51.96,opn,NTP,0,0,0,,Үдемелі тартылыс Итеруші күш
Dialogue: 0,0:00:52.01,0:00:55.45,opn,NTP,0,0,0,,Менің бүкіл жүрегім
Dialogue: 0,0:00:55.51,0:00:59.83,opn,NTP,0,0,0,,Қажетсіз бөлу
Dialogue: 0,0:00:59.86,0:01:02.43,opn,NTP,0,0,0,,Бұл туралы
Dialogue: 0,0:01:02.49,0:01:05.78,opn,NTP,0,0,0,,Бөлшектер арасындағы қабырға
Dialogue: 0,0:01:05.86,0:01:08.52,opn,NTP,0,0,0,,Өзара әрекеттесу
Dialogue: 0,0:01:08.60,0:01:11.06,opn,NTP,0,0,0,,Шығармашылық өсиеттер
Dialogue: 0,0:01:11.12,0:01:12.75,opn,NTP,0,0,0,,Барлау
Dialogue: 0,0:01:12.80,0:01:16.22,opn,NTP,0,0,0,,Бұл өзгерістің өзгерген көрінісі
Dialogue: 0,0:01:16.28,0:01:20.18,opn,NTP,0,0,0,,Іске қосу циклі
Dialogue: 0,0:01:20.22,0:01:25.19,opn,NTP,0,0,0,,Әрі қарай күту және өзара пайда
Dialogue: 0,0:01:41.48,0:01:43.86,*Default,NTP,0,0,0,,Сіз келісімді бұздыңыз.
Dialogue: 0,0:02:23.56,0:02:26.02,*Default,NTP,0,0,0,,Сіз оянасыз.
Dialogue: 0,0:02:31.20,0:02:33.02,*Default,NTP,0,0,0,,Қатыспағаным үшін кешіріңіз.
Dialogue: 0,0:02:35.60,0:02:36.90,*Default,NTP,0,0,0,,Жоғалған қырқу
Dialogue: 0,0:02:38.34,0:02:42.86,*Default,NTP,0,0,0,,Талантты адамның жақсы бейнесі жадыңыздың бір қадамы.
Dialogue: 0,0:02:45.95,0:02:47.32,*Default,NTP,0,0,0,,Жазылмаған
Dialogue: 0,0:02:49.16,0:02:52.28,*Default,NTP,0,0,0,,…
Dialogue: 0,0:02:53.66,0:02:57.56,*Default,NTP,0,0,0,,Әйелдің басын қырқу қылмыс.
Dialogue: 0,0:02:59.48,0:03:00.08,*Default,NTP,0,0,0,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:03:01.50,0:03:03.90,*Default,NTP,0,0,0,,Ұмытылмас естеліктер де қазір жақсы болды.
Dialogue: 0,0:03:04.28,0:03:07.42,*Default,NTP,0,0,0,,Жақсы сурет алынды және ол алдамшы түрде ұқсас болды.
Dialogue: 0,0:03:08.00,0:03:14.34,*Default,NTP,0,0,0,,Өзімді қорлағаныма өкінемін.
Dialogue: 0,0:03:15.76,0:03:17.90,*Default,NTP,0,0,0,,Мен қатты әсерленгеніме сенімдімін.
Dialogue: 0,0:03:19.68,0:03:21.48,*Default,NTP,0,0,0,,Сұрақтарыңыз болса, брондау алдында бізге хабарласыңыз.
Dialogue: 0,0:03:22.02,0:03:22.70,*Default,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:03:23.22,0:03:25.15,*Default,NTP,0,0,0,,Бата нені білдіреді?
Dialogue: 0,0:03:25.46,0:03:29.96,*Default,NTP,0,0,0,,Есте сақтау қабілетін жоғалтқан кезде, есте сақтау қабілетін жоғалтты деп шешілді.
Dialogue: 0,0:03:30.20,0:03:31.50,*Default,NTP,0,0,0,,Жоғалған себеп туралы естеліктер
Dialogue: 0,0:03:31.60,0:03:34.84,*Default,NTP,0,0,0,,Соңғы нәтиже
Dialogue: 0,0:03:35.96,0:03:37.14,*Default,NTP,0,0,0,,Мен тікелей өкілді көріп тұрмын.
Dialogue: 0,0:03:37.16,0:03:39.64,*Default,NTP,0,0,0,,Есептің ақиқаттығы
Dialogue: 0,0:03:40.20,0:03:42.86,*Default,NTP,0,0,0,,Есте сақтау қабілетінің жоғалуы
Dialogue: 0,0:03:43.20,0:03:45.33,*Default,NTP,0,0,0,,Сіздің сұрауыңыз туралы ықтимал хабарландыру.
Dialogue: 0,0:03:46.54,0:03:48.48,*Default,NTP,0,0,0,,Фантастикалық әңгіме
Dialogue: 0,0:03:48.48,0:03:51.58,*Default,NTP,0,0,0,,Бұл есте сақтау қабілетінің жоғалу жағдайларын салыстыру.
Dialogue: 0,0:03:52.24,0:03:54.84,*Default,NTP,0,0,0,,Елестете алмайтын адам
Dialogue: 0,0:03:55.12,0:03:57.02,*Default,NTP,0,0,0,,Оме Чикуманың шинва томасы
Dialogue: 0,0:03:57.26,0:03:59.18,*Default,NTP,0,0,0,,Елорданың белгісіз жолы
Dialogue: 0,0:04:00.80,0:04:04.06,*Default,NTP,0,0,0,,Дегенмен, қазір кімнің белгісіз жолы бар?
Dialogue: 0,0:04:04.40,0:04:06.68,*Default,NTP,0,0,0,,Шираничи Мичидің жұмысқа орналасуы туралы ақпарат
Dialogue: 0,0:04:07.50,0:04:08.24,*Default,NTP,0,0,0,,Рио Чидо
Dialogue: 0,0:04:08.94,0:04:11.84,*Default,NTP,0,0,0,,Наданның уәдесі сол.
Dialogue: 0,0:04:13.32,0:04:16.10,*Default,NTP,0,0,0,,Алайда мен шарттарды орындамай жүрген себебім осы.
Dialogue: 0,0:04:17.26,0:04:21.54,*Default,NTP,0,0,0,,Хабаршының келуімен келтірілген жарақат
Dialogue: 0,0:04:30.30,0:04:32.78,*Default,NTP,0,0,0,,Өлгеннен кейін
Dialogue: 0,0:04:33.32,0:04:35.95,*Default,NTP,0,0,0,,...
Dialogue: 0,0:04:36.52,0:04:38.58,*Default,NTP,0,0,0,,толығымен жоғалды
Dialogue: 0,0:04:39.09,0:04:41.29,*Default,NTP,0,0,0,,...
Dialogue: 0,0:04:41.37,0:04:43.17,*Default,NTP,0,0,0,,арғы тегі
Dialogue: 0,0:04:43.25,0:04:45.92,*Default,NTP,0,0,0,,Майн
Dialogue: 0,0:04:46.30,0:04:48.18,*Default,NTP,0,0,0,,Бұл жеке әсер.
Dialogue: 0,0:04:49.53,0:04:53.79,*Default,NTP,0,0,0,,Алдын ала әсер ету
Dialogue: 0,0:04:54.66,0:04:55.76,*Default,NTP,0,0,0,,Бұл... мен осындамын.
Dialogue: 0,0:04:56.23,0:04:57.99,*Default,NTP,0,0,0,,Артықшылықтары мен кемшіліктері
Dialogue: 0,0:04:58.18,0:04:59.72,*Default,NTP,0,0,0,,Дағдарыс кенеттен болды
Dialogue: 0,0:04:59.78,0:05:02.00,*Default,NTP,0,0,0,,Қажетті тіл дұрыс емес.
Dialogue: 0,0:05:02.25,0:05:04.15,*Default,NTP,0,0,0,,...
Dialogue: 0,0:05:05.19,0:05:07.23,*Default,NTP,0,0,0,,Нақты неше рет бар?
Dialogue: 0,0:05:07.66,0:05:09.41,*Default,NTP,0,0,0,,Бұрын балалар да болған.
Dialogue: 0,0:05:09.41,0:05:11.89,*Default,NTP,0,0,0,,—
Dialogue: 0,0:05:12.48,0:05:13.45,*Default,NTP,0,0,0,,...
Dialogue: 0,0:05:14.13,0:05:16.39,*Default,NTP,0,0,0,,Қазір саяхаттау уақыты.
Dialogue: 0,0:05:16.85,0:05:20.86,*Default,NTP,0,0,0,,Саяхаттау... Жол кетті
Dialogue: 0,0:05:21.43,0:05:23.92,*Default,NTP,0,0,0,,...
Dialogue: 0,0:05:24.14,0:05:25.48,*Default,NTP,0,0,0,,Әңгімелер кітабы
Dialogue: 0,0:05:25.81,0:05:27.45,*Default,NTP,0,0,0,,Некелік сапар
Dialogue: 0,0:05:27.66,0:05:30.37,*Default,NTP,0,0,0,,Үй иесінің алдында
Dialogue: 0,0:05:33.42,0:05:36.48,*Default,NTP,0,0,0,,shin
Dialogue: 0,0:05:36.48,0:05:38.86,*Default,NTP,0,0,0,,Кету мүмкін емес
Dialogue: 0,0:05:39.30,0:05:41.14,*Default,NTP,0,0,0,,Кешкі демалыс
Dialogue: 0,0:05:41.38,0:05:43.71,*Default,NTP,0,0,0,,Бұл зерттеудің тиімділігі де жоғары.
Dialogue: 0,0:05:44.20,0:05:47.13,*Default,NTP,0,0,0,,Сіз жұмысқа оқуды аяқтадыңыз.
Dialogue: 0,0:05:47.70,0:05:50.01,*Default,NTP,0,0,0,,Барлық қатысушылар қатысуын аяқтады.
Dialogue: 0,0:05:50.27,0:05:53.19,*Default,NTP,0,0,0,,Шынайы үміттер
Dialogue: 0,0:05:53.36,0:05:55.68,*Default,NTP,0,0,0,,Сөйлемес бұрын мен оны толық көре алмадым, бірақ мен оны асыға күттім.
Dialogue: 0,0:05:56.11,0:05:57.32,*Default,NTP,0,0,0,,Өткен оқиғалар…
Dialogue: 0,0:06:02.34,0:06:05.33,*Default,NTP,0,0,0,,Үш күн, екі түн жол жүру
Dialogue: 0,0:06:05.82,0:06:08.19,*Default,NTP,0,0,0,,Ағымдағы жағдай
Dialogue: 0,0:06:09.31,0:06:11.53,*Default,NTP,0,0,0,,Кенеттен бірінші бала дүниеге келді.
Dialogue: 0,0:06:12.13,0:06:15.38,*Default,NTP,0,0,0,,Саяхат кезінде
Dialogue: 0,0:06:16.37,0:06:19.10,*Default,NTP,0,0,0,,Бұл да есте сақтау мүмкіндігі
Dialogue: 0,0:06:19.40,0:06:21.19,*Default,NTP,0,0,0,,Үздіксіз бағытты ойлау
Dialogue: 0,0:06:22.98,0:06:23.45,*Default,NTP,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:06:23.70,0:06:24.54,*Default,NTP,0,0,0,,...
Dialogue: 0,0:06:25.39,0:06:28.11,*Default,NTP,0,0,0,,Талантты адам болсаң, ертегі тыңдайсың.
Dialogue: 0,0:06:28.97,0:06:30.32,*Default,NTP,0,0,0,,Шого №3 қорап
Dialogue: 0,0:06:32.14,0:06:33.37,*Default,NTP,0,0,0,,Туған күнге арналған жұмыртқа торты?
Dialogue: 0,0:06:33.69,0:06:35.33,*Default,NTP,0,0,0,,Көптен бері көрмегелі
Dialogue: 0,0:06:56.00,0:06:56.57,*Default,NTP,0,0,0,,Өлтірілді
Dialogue: 0,0:06:59.34,0:06:59.76,*Default,NTP,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:07:02.67,0:07:03.15,*Default,NTP,0,0,0,,Өлген адам
Dialogue: 0,0:07:04.84,0:07:06.91,*Default,NTP,0,0,0,,shin
Dialogue: 0,0:07:07.53,0:07:08.93,*Default,NTP,0,0,0,,Бұл сіздің жадыңыз
Dialogue: 0,0:07:11.84,0:07:13.23,*Default,NTP,0,0,0,,Өлген адам…
Dialogue: 0,0:07:14.59,0:07:15.23,*Default,NTP,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:07:17.07,0:07:18.79,*Default,NTP,0,0,0,,Егер...капитал жоғалса
Dialogue: 0,0:07:20.60,0:07:21.83,*Default,NTP,0,0,0,,Капиталдың жоғалуы
Dialogue: 0,0:07:28.17,0:07:28.96,*Default,NTP,0,0,0,,Бұл ашық аспан.
Dialogue: 0,0:07:30.57,0:07:31.85,*Default,NTP,0,0,0,,...
Dialogue: 0,0:07:32.32,0:07:34.55,*Default,NTP,0,0,0,,Жаңбырды көргім келмейді.
Dialogue: 0,0:07:35.31,0:07:37.58,*Default,NTP,0,0,0,,...
Dialogue: 0,0:07:38.91,0:07:41.71,*Default,NTP,0,0,0,,...
