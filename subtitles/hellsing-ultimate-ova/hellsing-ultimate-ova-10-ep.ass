Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.68,0:00:16.43,Default,,0,0,0,,Ах
Dialogue: 0,0:00:16.55,0:00:18.64,Default,,0,0,0,,Сіз мұны керемет түрде жасайсыз.
Dialogue: 0,0:00:18.89,0:00:22.60,Default,,0,0,0,,Раббым менің құлым
Dialogue: 0,0:00:23.39,0:00:25.98,Default,,0,0,0,,Мұнда да, ана жақта да бәрі банкрот.
Dialogue: 0,0:00:26.27,0:00:29.48,Default,,0,0,0,,Келіңізші, өтінемін.
Dialogue: 0,0:00:35.11,0:00:38.32,Default,,0,0,0,,Шарықтау шегі осында.
Dialogue: 0,0:00:38.66,0:00:41.24,Default,,0,0,0,,Хеллсингтің кезегі
Dialogue: 0,0:01:00.64,0:01:01.56,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:01:01.81,0:01:04.81,Default,,0,0,0,,Уаааааааааааааааааааа
Dialogue: 0,0:01:05.14,0:01:07.27,Default,,0,0,0,,(SS айқайлау)
Dialogue: 0,0:01:07.40,0:01:08.69,Default,,0,0,0,,Хамф!
Dialogue: 0,0:01:08.90,0:01:10.82,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:12.78,0:01:14.69,Default,,0,0,0,,Бұл ұзақ болды.
Dialogue: 0,0:01:15.70,0:01:20.16,Default,,0,0,0,,Сен менің өлімімсің бе, әлде біздің өліміміз бе?
Dialogue: 0,0:01:29.25,0:01:31.29,Default,,0,0,0,,Барлығы күліп өледі
Dialogue: 0,0:01:32.42,0:01:36.72,Default,,0,0,0,,Иә, олар мұнда өлу үшін келген.
Dialogue: 0,0:01:37.30,0:01:41.22,Default,,0,0,0,,If you want to die that much, if you want to die that much...
Dialogue: 0,0:01:41.35,0:01:42.89,Default,,0,0,0,,Басыңды сал!
Dialogue: 0,0:01:43.01,0:01:45.06,Default,,0,0,0,,50 жыл бұрынғы басыңды маған бер!
Dialogue: 0,0:01:45.06,0:01:45.60,Default,,0,0,0,,50 жыл бұрынғы басыңды маған бер!
Dialogue: 0,0:01:45.06,0:01:45.60,Default,,0,0,0,,(Сөйлеуші айқайлайды)
Dialogue: 0,0:01:45.60,0:01:46.39,Default,,0,0,0,,(Сөйлеуші айқайлау)
Dialogue: 0,0:01:46.39,0:01:46.68,Default,,0,0,0,,(Сөйлеуші айқайлау)
Dialogue: 0,0:01:46.39,0:01:46.68,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:01:46.68,0:01:48.98,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:01:49.10,0:01:51.40,Default,,0,0,0,,Фраулейн әдісі
Dialogue: 0,0:01:51.69,0:01:55.65,Default,,0,0,0,,Мен өлгеніме өкінемін.
Dialogue: 0,0:01:56.03,0:02:00.41,Default,,0,0,0,,Бұл бізге өте қиын
Dialogue: 0,0:02:00.74,0:02:06.16,Default,,0,0,0,,Дүниедегі барлық адамдар бізге мұқтаж емес.
Dialogue: 0,0:02:06.29,0:02:12.21,Default,,0,0,0,,Everyone in the world is trying to forget us.
Dialogue: 0,0:02:12.75,0:02:17.76,Default,,0,0,0,,Бұл бізге бәрібір керек
Dialogue: 0,0:02:17.88,0:02:22.10,Default,,0,0,0,,Менің өлгім келмейді. Тек өлгім келмейді.
Dialogue: 0,0:02:22.60,0:02:26.77,Default,,0,0,0,,Бізге өлу үшін тағы бір нәрсе керек.
Dialogue: 0,0:02:26.89,0:02:29.48,Default,,0,0,0,,«Көбірек, көбірек»!
Dialogue: 0,0:02:29.77,0:02:32.48,Default,,0,0,0,,Міне осылай жеттік
Dialogue: 0,0:02:32.61,0:02:34.48,Default,,0,0,0,,Бұл келді
Dialogue: 0,0:02:34.61,0:02:35.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:36.28,0:02:39.70,Default,,0,0,0,,Тағы бірдеңе болуы керек.
Dialogue: 0,0:02:40.28,0:02:42.70,Default,,0,0,0,,Біз әлі де күресетін жер бар
Dialogue: 0,0:02:42.99,0:02:45.83,Default,,0,0,0,,There's still an enemy somewhere to fight.
Dialogue: 0,0:02:46.33,0:02:50.92,Default,,0,0,0,,The world is wide and full of threats and wonders.
Dialogue: 0,0:02:51.04,0:02:55.00,Default,,0,0,0,,Күрес пен от толып жатыр
Dialogue: 0,0:02:55.34,0:03:00.51,Default,,0,0,0,,I'm sure there are enough battlefields in this world to feed us.
Dialogue: 0,0:03:00.63,0:03:03.64,Default,,0,0,0,,Ол міндетті түрде бар болуы керек.
Dialogue: 0,0:03:04.43,0:03:07.56,Default,,0,0,0,,Өлуіміз үшін бірдеңе керек...
Dialogue: 0,0:03:07.68,0:03:11.02,Default,,0,0,0,,Бізге тағы бір нәрсе керек.
Dialogue: 0,0:03:11.14,0:03:12.94,Default,,0,0,0,,Әйтпесе, біз—
Dialogue: 0,0:03:13.06,0:03:16.73,Default,,0,0,0,,Мәңгі жүре беру керек
Dialogue: 0,0:03:16.86,0:03:19.07,Default,,0,0,0,,Өлу үшін
Dialogue: 0,0:03:19.19,0:03:21.70,Default,,0,0,0,,That's why I love you so much
Dialogue: 0,0:03:21.82,0:03:24.24,Default,,0,0,0,,Сіз оған лайықсыз.
Dialogue: 0,0:03:24.99,0:03:27.79,Default,,0,0,0,,Балалар сендер кереметсіңдер!
Dialogue: 0,0:03:27.91,0:03:31.87,Default,,0,0,0,,Royal Church Knights Hellsing
Dialogue: 0,0:03:32.00,0:03:36.13,Default,,0,0,0,,You are the ones we are worth dying for...
Dialogue: 0,0:03:36.25,0:03:41.26,Default,,0,0,0,,You are worth killing for us.
Dialogue: 0,0:03:41.67,0:03:44.26,Default,,0,0,0,,Mr. Интегра, please go ahead.
Dialogue: 0,0:03:44.39,0:03:45.22,Default,,0,0,0,,Серас!
Dialogue: 0,0:03:45.72,0:03:48.43,Default,,0,0,0,,Quickly go to that major!
Dialogue: 0,0:03:48.56,0:03:52.02,Default,,0,0,0,,To that man... to that man, no more...
Dialogue: 0,0:03:52.14,0:03:54.69,Default,,0,0,0,,I can't let you say another word!
Dialogue: 0,0:03:59.28,0:04:00.74,Default,,0,0,0,,Өлме
Dialogue: 0,0:04:01.32,0:04:03.32,Default,,0,0,0,,Please forgive me, Серас.
Dialogue: 0,0:04:04.07,0:04:06.07,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:04:09.54,0:04:11.96,Default,,0,0,0,,<Штаб> <Телеграф аппаратурасы>
Dialogue: 0,0:04:14.58,0:04:17.46,Default,,0,0,0,,Heh, he's an obedient dog.
Dialogue: 0,0:04:27.39,0:04:28.22,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:05:22.36,0:05:23.40,Default,,0,0,0,,Ах
Dialogue: 0,0:05:28.74,0:05:29.87,Default,,0,0,0,,Уф
Dialogue: 0,0:05:31.28,0:05:32.45,Default,,0,0,0,,Уф
Dialogue: 0,0:05:36.21,0:05:37.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:44.51,0:05:45.51,Default,,0,0,0,,Ha
Dialogue: 0,0:05:47.38,0:05:50.26,Default,,0,0,0,,(Werewolf's growl)
Dialogue: 0,0:05:51.22,0:05:55.48,Default,,0,0,0,,Huh, you made a very bad bet.
Dialogue: 0,0:05:55.60,0:05:57.44,Default,,0,0,0,,Уолтер мырза
Dialogue: 0,0:05:57.85,0:06:01.73,Default,,0,0,0,,Сіздің карталарыңыз көп ұзамай жанып, құлап кетеді.
Dialogue: 0,0:06:02.27,0:06:05.53,Default,,0,0,0,,Your father is my father.
Dialogue: 0,0:06:05.65,0:06:08.99,Default,,0,0,0,,сенікі менікі.
Dialogue: 0,0:06:09.11,0:06:10.28,Default,,0,0,0,,Ал сіз...
Dialogue: 0,0:06:10.99,0:06:13.41,Default,,0,0,0,,Because I will kill you.
Dialogue: 0,0:06:13.87,0:06:16.20,Default,,0,0,0,,Я, бұл қорқынышты аяқталды.
Dialogue: 0,0:06:16.33,0:06:19.54,Default,,0,0,0,,Сіздің өміріңізге қауіп төніп тұрған ойынға қосылатын ойым жоқ.
Dialogue: 0,0:06:19.67,0:06:21.83,Default,,0,0,0,,Менде жоқ
Dialogue: 0,0:06:21.96,0:06:25.92,Default,,0,0,0,,Сіз жай ғана сатқынсыз!
Dialogue: 0,0:06:26.38,0:06:28.59,Default,,0,0,0,,I was born this way.
Dialogue: 0,0:06:28.72,0:06:32.43,Default,,0,0,0,,Мен бір сатқынды да кешірген емеспін.
Dialogue: 0,0:06:33.05,0:06:38.81,Default,,0,0,0,,Қалай ойлайсың, мен мұндай адаммен жақсы мінез-құлықпен жеке-жеке ұрысамын ба?
Dialogue: 0,0:06:39.27,0:06:41.73,Default,,0,0,0,,Абыр-сабырсыз өлесің
Dialogue: 0,0:06:41.85,0:06:44.57,Default,,0,0,0,,Ал менің қарным ашты.
Dialogue: 0,0:06:45.53,0:06:49.61,Default,,0,0,0,,(Алукардтың күлкісі)
Dialogue: 0,0:07:18.98,0:07:21.94,Default,,0,0,0,,Хехехе хахаха
Dialogue: 0,0:07:22.06,0:07:26.15,Default,,0,0,0,,Even I don't know if I can eat this much.
Dialogue: 0,0:07:30.24,0:07:34.45,Default,,0,0,0,,Барлығы өзіңіз қалағандай болды, майор.
Dialogue: 0,0:07:34.70,0:07:39.12,Default,,0,0,0,,Иә, бәрі менің жолым.
Dialogue: 0,0:07:39.25,0:07:42.46,Default,,0,0,0,,Ол қайтадан қабырғаларды тұрғыза бастады.
Dialogue: 0,0:07:43.21,0:07:45.67,Default,,0,0,0,,Сен осы жолы сол тікұшаққа мінгің келмейтін шығар, иә?
Dialogue: 0,0:07:46.04,0:07:50.13,Default,,0,0,0,,Мен оны адам деп санамаймын.
Dialogue: 0,0:07:50.26,0:07:53.97,Default,,0,0,0,,Жоқ, мен оларды вампир деп те ойламаймын.
Dialogue: 0,0:07:54.34,0:07:58.97,Default,,0,0,0,,Ол қамал, ол қозғалыстағы аумақ.
Dialogue: 0,0:07:59.10,0:08:03.90,Default,,0,0,0,,Ажал өзенінің халқын залым еркі басқарады.
Dialogue: 0,0:08:04.02,0:08:06.02,Default,,0,0,0,,Оны жеңу үшін не істеуім керек?
Dialogue: 0,0:08:06.15,0:08:08.48,Default,,0,0,0,,Бала үшін не істеуім керек?
Dialogue: 0,0:08:08.61,0:08:13.15,Default,,0,0,0,,Мен ұйықтасам да, оянсам да осыны ғана ойлаймын.
Dialogue: 0,0:08:13.28,0:08:18.58,Default,,0,0,0,,Өйткені бұл мен соғысуымның жалғыз жолы.
Dialogue: 0,0:08:18.70,0:08:21.58,Default,,0,0,0,,Соғыс... бұл соғыс.
Dialogue: 0,0:08:21.70,0:08:24.00,Default,,0,0,0,,Ол мен менің арамызда
Dialogue: 0,0:08:24.21,0:08:27.13,Default,,0,0,0,,Бар жан-тәніңізбен күресу керек
Dialogue: 0,0:08:27.25,0:08:31.51,Default,,0,0,0,,Менде не бар? оның несі бар?
Dialogue: 0,0:08:31.88,0:08:34.01,Default,,0,0,0,,Денеңізді өзгертіңіз -
Dialogue: 0,0:08:34.13,0:08:36.34,Default,,0,0,0,,Сізге таныс жұмыс істеуге мүмкіндік беріңіз -
Dialogue: 0,0:08:36.47,0:08:39.35,Default,,0,0,0,,Күшіңізді қолданып, жүрегіңізді басқарыңыз.
Dialogue: 0,0:08:39.47,0:08:42.89,Default,,0,0,0,,Денеңізді қалпына келтіріп, басқалардың қанын жұтыңыз.
Dialogue: 0,0:08:43.02,0:08:45.60,Default,,0,0,0,,Оны өміріңнің азығына айналдыр
Dialogue: 0,0:08:45.73,0:08:48.11,Default,,0,0,0,,Бұл ол
Dialogue: 0,0:08:48.94,0:08:51.82,Default,,0,0,0,,Менде ештеңе жоқ
Dialogue: 0,0:08:52.32,0:08:55.78,Default,,0,0,0,,Өйткені мен адаммын
Dialogue: 0,0:08:56.61,0:08:59.28,Default,,0,0,0,,Вампир болу керемет емес пе?
Dialogue: 0,0:08:59.49,0:09:01.29,Default,,0,0,0,,Мәңгілік өмір сүр.
Dialogue: 0,0:09:01.41,0:09:04.08,Default,,0,0,0,,Шексіз мәңгілік, егер күресе алсаң...
Dialogue: 0,0:09:04.21,0:09:07.04,Default,,0,0,0,,Бұл қуаныш болуы керек.
Dialogue: 0,0:09:07.67,0:09:10.04,Default,,0,0,0,,Бірақ мен мұны істей алмаймын.
Dialogue: 0,0:09:10.17,0:09:12.42,Default,,0,0,0,,Ешқашан!
Dialogue: 0,0:09:14.26,0:09:15.55,Default,,0,0,0,,Уф
Dialogue: 0,0:09:16.13,0:09:17.59,Default,,0,0,0,,Гуах
Dialogue: 0,0:09:19.14,0:09:20.10,Default,,0,0,0,,Уф
Dialogue: 0,0:09:20.22,0:09:21.39,Default,,0,0,0,,<Жаһаннамға бару>
Dialogue: 0,0:09:21.76,0:09:23.14,Default,,0,0,0,,<Бақыт>
Dialogue: 0,0:09:23.27,0:09:25.10,Default,,0,0,0,,〈Усеягаре〉
Dialogue: 0,0:09:25.23,0:09:27.40,Default,,0,0,0,,<Сіз тек өлтіресіз>
Dialogue: 0,0:09:37.28,0:09:39.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:39.70,0:09:41.16,Default,,0,0,0,,<Отан үшін! 〉
Dialogue: 0,0:09:41.28,0:09:42.62,Default,,0,0,0,,<Сталин үшін! 〉
Dialogue: 0,0:09:42.87,0:09:43.95,Default,,0,0,0,,<Жеңіс! 〉
Dialogue: 0,0:09:44.08,0:09:46.87,Default,,0,0,0,,〈Сәлеметсіз бе! 〉
Dialogue: 0,0:09:49.00,0:09:51.38,Default,,0,0,0,,Өлмейтіндік керемет
Dialogue: 0,0:09:51.50,0:09:53.71,Default,,0,0,0,,Қабілеті көз ілмейді
Dialogue: 0,0:09:53.84,0:09:58.93,Default,,0,0,0,,Қанды валюта ретінде пайдалану арқылы жан өмірін ассимиляциялау
Dialogue: 0,0:10:01.89,0:10:02.85,Default,,0,0,0,,«Неге мен — теңіз офицері — әскердің орнына?»
Dialogue: 0,0:10:04.35,0:10:08.35,Default,,0,0,0,,Менің жүрегім, жаным, өмірім тек маған ғана тиесілі.
Dialogue: 0,0:10:09.06,0:10:13.15,Default,,0,0,0,,Өмірді басқалармен бөлісу Өмір біріктіру
Dialogue: 0,0:10:13.27,0:10:14.98,Default,,0,0,0,,Ақыл-ойды біріктіру
Dialogue: 0,0:10:15.11,0:10:17.86,Default,,0,0,0,,Вампирлердің мәні
Dialogue: 0,0:10:18.78,0:10:20.87,Default,,0,0,0,,How wonderful
Dialogue: 0,0:10:21.28,0:10:24.20,Default,,0,0,0,,Бұл керемет болуы керек.
Dialogue: 0,0:10:24.33,0:10:27.83,Default,,0,0,0,,Бұл қуаныш болуы керек екеніне сенімдімін.
Dialogue: 0,0:10:28.87,0:10:31.00,Default,,0,0,0,,Бірақ бұл әзіл емес.
Dialogue: 0,0:10:31.13,0:10:32.75,Default,,0,0,0,,I'm sorry, Makpei.
Dialogue: 0,0:10:33.42,0:10:36.01,Default,,0,0,0,,Мендікі менікі
Dialogue: 0,0:10:36.26,0:10:39.51,Default,,0,0,0,,Бір шаш, бір тамшы қан
Dialogue: 0,0:10:40.09,0:10:42.26,Default,,0,0,0,,I am me
Dialogue: 0,0:10:42.39,0:10:44.97,Default,,0,0,0,,I am me
Dialogue: 0,0:10:45.10,0:10:47.14,Default,,0,0,0,,I am me!
Dialogue: 0,0:10:48.27,0:10:49.98,Default,,0,0,0,,I'm jealous.
Dialogue: 0,0:10:50.10,0:10:52.19,Default,,0,0,0,,таң қалдыратын әдемі
Dialogue: 0,0:10:52.31,0:10:55.86,Default,,0,0,0,,Сондықтан мен сені сүйемін, сондықтан мен сені жек көремін
Dialogue: 0,0:10:56.48,0:11:00.86,Default,,0,0,0,,Сол себепті сен менің жауымсың.
Dialogue: 0,0:11:00.99,0:11:02.66,Default,,0,0,0,,Жауға лайық
Dialogue: 0,0:11:03.24,0:11:06.91,Default,,0,0,0,,Ақыры жауымды таптым.
Dialogue: 0,0:11:07.04,0:11:09.21,Default,,0,0,0,,Менің соғысым
Dialogue: 0,0:11:10.25,0:11:12.25,Default,,0,0,0,,And we-
Dialogue: 0,0:11:12.38,0:11:15.38,Default,,0,0,0,,Осы мақсатқа тыңғылықты дайындықты бастадық.
Dialogue: 0,0:11:16.05,0:11:18.51,Default,,0,0,0,,Over 50 years
Dialogue: 0,0:11:27.22,0:11:28.43,Default,,0,0,0,,Мияу
Dialogue: 0,0:11:29.35,0:11:32.60,Default,,0,0,0,,Мұның бәрі дайындық туралы
Dialogue: 0,0:11:32.73,0:11:34.73,Default,,0,0,0,,For this moment
Dialogue: 0,0:11:35.06,0:11:38.86,Default,,0,0,0,,Соңғы батальон және тоғызыншы крест жорығы...
Dialogue: 0,0:11:38.98,0:11:41.40,Default,,0,0,0,,Андерсен де, қасқыр да...
Dialogue: 0,0:11:41.53,0:11:44.16,Default,,0,0,0,,Уолтер және бәрі...
Dialogue: 0,0:11:44.28,0:11:48.74,Default,,0,0,0,,Біздің 50 жыл осы сәтке арналды.
Dialogue: 0,0:11:49.12,0:11:51.71,Default,,0,0,0,,Алукард нөлді шығарады
Dialogue: 0,0:11:51.83,0:11:54.42,Default,,0,0,0,,Release all life-
Dialogue: 0,0:11:54.54,0:11:59.38,Default,,0,0,0,,Ол өз сарайында жалғыз қалғанда...
Dialogue: 0,0:11:59.51,0:12:01.92,Default,,0,0,0,,Андерсен оны жеңе ме?
Dialogue: 0,0:12:02.05,0:12:04.51,Default,,0,0,0,,Уолтер оны жеңе ме?
Dialogue: 0,0:12:05.26,0:12:07.76,Default,,0,0,0,,I think no.
Dialogue: 0,0:12:08.51,0:12:12.23,Default,,0,0,0,,Ол өз бетімен қорқынышты вампир.
Dialogue: 0,0:12:12.35,0:12:16.77,Default,,0,0,0,,100 жыл бұрын Лондонға жалғыз өзі басып кірген адам.
Dialogue: 0,0:12:16.90,0:12:22.28,Default,,0,0,0,,500 жыл бұрын Осман империясына қарсы жалғыз соғысқан адам.
Dialogue: 0,0:12:22.99,0:12:25.91,Default,,0,0,0,,Ал егер ол қайтадан қан сора бастаса...
Dialogue: 0,0:12:26.03,0:12:28.99,Default,,0,0,0,,Ал қазір бәрі бұзылды.
Dialogue: 0,0:12:29.12,0:12:31.12,Default,,0,0,0,,What a cheat!
Dialogue: 0,0:12:31.25,0:12:34.29,Default,,0,0,0,,Өмір мен өлімнің бәрі алдау
Dialogue: 0,0:12:34.87,0:12:38.09,Default,,0,0,0,,Біз қазір оның ортасындамыз
Dialogue: 0,0:12:38.25,0:12:41.67,Default,,0,0,0,,Осындай жынды патшаны өлтіру үшін не істеуім керек?
Dialogue: 0,0:12:42.38,0:12:45.43,Default,,0,0,0,,Ұрыс даласында, он және жиырма қабат жарып...
Dialogue: 0,0:12:45.93,0:12:49.93,Default,,0,0,0,,Жаудың шексіз лагерін жойып, белгі көтергіңіз келе ме?
Dialogue: 0,0:12:50.60,0:12:51.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:52.22,0:12:55.23,Default,,0,0,0,,Ол қайтадан қан сорады
Dialogue: 0,0:12:55.35,0:12:58.15,Default,,0,0,0,,Ол үлкен тамақ жейтіндердің патшасы.
Dialogue: 0,0:12:58.27,0:13:03.19,Default,,0,0,0,,Оның ең үлкен қаруы да оның әлсіздігі.
Dialogue: 0,0:13:03.32,0:13:08.37,Default,,0,0,0,,Ежелгі және қазіргі тирандар өздерінің менмендігінен улы шарапты жағады.
Dialogue: 0,0:13:09.37,0:13:11.95,Default,,0,0,0,,(Серастың ауыр тыныс алуы)
Dialogue: 0,0:13:21.05,0:13:24.47,Default,,0,0,0,,(Қасқырдың ырылдауы)
Dialogue: 0,0:13:26.72,0:13:27.76,Default,,0,0,0,,Ах
Dialogue: 0,0:13:29.64,0:13:31.31,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:33.60,0:13:34.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.35,0:13:37.77,Default,,0,0,0,,Гаха
Dialogue: 0,0:13:43.65,0:13:44.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:56.66,0:13:57.96,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:59.17,0:14:00.88,Default,,0,0,0,,Кешпеймін…
Dialogue: 0,0:14:16.06,0:14:17.60,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:18.35,0:14:19.73,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:14:21.02,0:14:23.48,Default,,0,0,0,,Қайда... сонша алыста
Dialogue: 0,0:14:25.19,0:14:26.36,Default,,0,0,0,,Бұл олай емес сияқты.
Dialogue: 0,0:14:26.78,0:14:27.61,Default,,0,0,0,,Ах
Dialogue: 0,0:14:28.24,0:14:29.49,Default,,0,0,0,,Тұр!
Dialogue: 0,0:14:29.74,0:14:34.62,Default,,0,0,0,,Мен білетін әйел одан да жаман.
Dialogue: 0,0:14:41.67,0:14:42.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:42.84,0:14:45.25,Default,,0,0,0,,Мен әуесқой қыз болғаныма таңқаларлық емес.
Dialogue: 0,0:14:45.75,0:14:48.26,Default,,0,0,0,,Сен сондай ақымақсың, ақымақ.
Dialogue: 0,0:14:49.13,0:14:49.97,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.09,0:14:53.01,Default,,0,0,0,,Енді мен ояндым...
Dialogue: 0,0:14:53.68,0:14:55.35,Default,,0,0,0,,Жүр, қызым.
Dialogue: 0,0:14:55.85,0:14:57.43,Default,,0,0,0,,'Егер мен Польнареффтің мұрнына саусағымды тығып қойсам ➡
Dialogue: 0,0:14:57.56,0:15:00.10,Default,,0,0,0,,Оны бірге жеңейік!
Dialogue: 0,0:15:04.65,0:15:05.77,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:15:07.78,0:15:09.11,Default,,0,0,0,,Нүкте емес!
Dialogue: 0,0:15:09.65,0:15:12.36,Default,,0,0,0,,Мұны маскамен жасаңыз!
Dialogue: 0,0:15:19.08,0:15:19.91,Default,,0,0,0,,Тұттым сені!
Dialogue: 0,0:15:20.04,0:15:21.54,Default,,0,0,0,,Оны қабылдамаңыз!
Dialogue: 0,0:15:31.68,0:15:32.51,Default,,0,0,0,,Ha
Dialogue: 0,0:15:32.93,0:15:37.06,Default,,0,0,0,,Мынау адам төзгісіз құбыжық.
Dialogue: 0,0:15:37.18,0:15:40.52,Default,,0,0,0,,Бұл нағыз қасқыр екені сөзсіз, солай емес пе?
Dialogue: 0,0:15:41.10,0:15:43.69,Default,,0,0,0,,Werewolf! Ах...
Dialogue: 0,0:15:46.44,0:15:47.27,Default,,0,0,0,,Алтын тістер…
Dialogue: 0,0:15:48.07,0:15:52.24,Default,,0,0,0,,Тіс пломбалары Осының бәрі...
Dialogue: 0,0:15:52.36,0:15:54.16,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:15:54.57,0:15:59.29,Default,,0,0,0,,Олар Еуропаны төңкеріп, 50 жыл бұрын ұрлады.
Dialogue: 0,0:15:59.91,0:16:04.67,Default,,0,0,0,,Осы жерде шашылып жатыр, алтын құймалар, ақшалар, сағаттар, бәрі, бәрі.
Dialogue: 0,0:16:05.21,0:16:06.63,Default,,0,0,0,,Бұл тіс пломбасы...
Dialogue: 0,0:16:06.75,0:16:09.80,Default,,0,0,0,,Бір лагерьдегі бір кедейдің аузынан...
Dialogue: 0,0:16:09.92,0:16:11.67,Default,,0,0,0,,Ол шығарылған болуы керек.
Dialogue: 0,0:16:12.26,0:16:14.76,Default,,0,0,0,,Қысқасы, олар осындай.
Dialogue: 0,0:16:14.89,0:16:17.18,Default,,0,0,0,,Тіпті әскерилер де емес.
Dialogue: 0,0:16:17.30,0:16:19.68,Default,,0,0,0,,Жақсы ой: Оның өлтірушілер тобынан қандай айырмашылығы бар?
Dialogue: 0,0:16:20.35,0:16:24.44,Default,,0,0,0,,Мен ол кісілерді де құптамаймын.
Dialogue: 0,0:16:24.56,0:16:28.02,Default,,0,0,0,,Жеңілмейтін әскер? Болат рыцарь?
Dialogue: 0,0:16:28.15,0:16:31.19,Default,,0,0,0,,Ха! Мені көп күлдірмеңіз
Dialogue: 0,0:16:32.49,0:16:33.32,Default,,0,0,0,,Уф
Dialogue: 0,0:16:34.95,0:16:37.03,Default,,0,0,0,,Жоқ, күміс тістер...
Dialogue: 0,0:16:39.24,0:16:40.79,Default,,0,0,0,,This... this is
Dialogue: 0,0:16:40.91,0:16:42.96,Default,,0,0,0,,He's a kind dog.
Dialogue: 0,0:16:43.08,0:16:44.37,Default,,0,0,0,,Бұл мұны істеу керек дегенді білдіре ме?
Dialogue: 0,0:16:45.58,0:16:47.67,Default,,0,0,0,,Жарайды, мен мұнда әдейі келдім.
Dialogue: 0,0:16:50.05,0:16:53.59,Default,,0,0,0,,Дұрыс, өліп бара жатқан соғыс иті.
Dialogue: 0,0:16:53.72,0:16:55.43,Default,,0,0,0,,Нұсқаулық Мен оны сізге беремін.
Dialogue: 0,0:16:55.84,0:16:57.18,Default,,0,0,0,,Егер бұл соғыс иті болса...
Dialogue: 0,0:16:57.30,0:16:59.72,Default,,0,0,0,,Бернадот-сан да басқа адамдар туралы айта алмайды...
Dialogue: 0,0:16:59.85,0:17:02.06,Default,,0,0,0,,Хахаха... Бұл басқаша емес.
Dialogue: 0,0:17:02.18,0:17:05.56,Default,,0,0,0,,Сондай-ақ, менің ішімде темекі шекпеңіз.
Dialogue: 0,0:17:05.69,0:17:08.69,Default,,0,0,0,,Хаха хаха, келе жатыр!
Dialogue: 0,0:17:10.57,0:17:11.90,Default,,0,0,0,,Қашпа! Алыңыз!
Dialogue: 0,0:17:12.03,0:17:12.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:22.37,0:17:25.66,Default,,0,0,0,,Жүр! Бар! Жаса!
Dialogue: 0,0:17:26.42,0:17:29.04,Default,,0,0,0,,Шабуыл жасағанда ол әлі тірі.
Dialogue: 0,0:17:29.42,0:17:31.71,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:17:36.34,0:17:37.63,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:17:38.09,0:17:40.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:52.65,0:17:53.78,Default,,0,0,0,,Ол оқылды!
Dialogue: 0,0:17:54.07,0:17:55.28,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:17:55.49,0:17:56.65,Default,,0,0,0,,Иә, кеттік!
Dialogue: 0,0:17:56.78,0:17:58.70,Default,,0,0,0,,О, жүр!
Dialogue: 0,0:18:01.83,0:18:03.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:16.01,0:18:17.59,Default,,0,0,0,,Мен бұл жолы түсіндім!
Dialogue: 0,0:18:23.89,0:18:26.10,Default,,0,0,0,,Қасқырдың күйеуі
Dialogue: 0,0:18:26.31,0:18:30.65,Default,,0,0,0,,Бұл 50 жыл бұрын бір жерден біреудің сыйлығы еді.
Dialogue: 0,0:18:30.90,0:18:32.27,Default,,0,0,0,,Токикина
Dialogue: 0,0:18:40.66,0:18:43.37,Default,,0,0,0,,Себебі мен басқа біреудің әйеліне қолымды қоямын.
Dialogue: 0,0:18:44.28,0:18:46.12,Default,,0,0,0,,Жағасы да ұшып кетті.
Dialogue: 0,0:18:47.20,0:18:49.58,Default,,0,0,0,,Қош бол, Уордог!
Dialogue: 0,0:19:11.56,0:19:14.02,Default,,0,0,0,,(Қасқырдың айқайы)
Dialogue: 0,0:19:14.31,0:19:18.78,Default,,0,0,0,,Just like a child who had a pleasant dream
Dialogue: 0,0:19:19.11,0:19:23.62,Default,,0,0,0,,Иә, бүгін, бүгін кешке...
Dialogue: 0,0:19:23.74,0:19:27.04,Default,,0,0,0,,Тілектерінің орындалуының түнгі арманы.
Dialogue: 0,0:19:29.54,0:19:30.96,Default,,0,0,0,,Бернадот мырза
Dialogue: 0,0:19:31.46,0:19:33.83,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:19:34.46,0:19:36.38,Default,,0,0,0,,Барып, оны аяқтаңыз.
Dialogue: 0,0:19:37.00,0:19:39.84,Default,,0,0,0,,Оянбайтын арман жоқ
Dialogue: 0,0:19:40.42,0:19:41.51,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:08.87,0:20:09.70,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:20:13.87,0:20:15.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:16.29,0:20:20.42,Default,,0,0,0,,Ақырында сізді жеке көргеніме қуаныштымын.
Dialogue: 0,0:20:20.55,0:20:21.55,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:20:28.93,0:20:31.81,Default,,0,0,0,,Өкінішке орай, бұл мылтық мұны істей алмайды.
Dialogue: 0,0:20:32.23,0:20:36.56,Default,,0,0,0,,Әй, бұл дирижердің әрекеті.
Dialogue: 0,0:20:41.57,0:20:42.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:43.28,0:20:47.74,Default,,0,0,0,,I thought I might be late for this performance.
Dialogue: 0,0:20:47.99,0:20:49.99,Default,,0,0,0,,Мен оны уақытында жасағаныма қуаныштымын.
Dialogue: 0,0:20:50.37,0:20:53.75,Default,,0,0,0,,Бұл тамаша шоу.
Dialogue: 0,0:20:54.08,0:20:59.59,Default,,0,0,0,,In any case, I have to watch it with a beautiful lady from the best seats.
Dialogue: 0,0:21:02.63,0:21:03.42,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:21:06.64,0:21:09.72,Default,,0,0,0,,Бақытты бол, жігітім.
Dialogue: 0,0:21:14.14,0:21:18.06,Default,,0,0,0,,Бұл «ғасырға бір түн» пьесасы.
Dialogue: 0,0:21:19.73,0:21:26.28,Default,,0,0,0,,Бұл оқиға 1898 жылдан бері жалғасып келеді.
Dialogue: 0,0:21:28.28,0:21:32.12,Default,,0,0,0,,Носферату Алукард
Dialogue: 0,0:21:32.24,0:21:35.58,Default,,0,0,0,,Өйткені ол жоғалады
Dialogue: 0,0:21:36.33,0:21:37.46,Default,,0,0,0,,Не!?
Dialogue: 0,0:21:53.93,0:21:54.77,Default,,0,0,0,,Хи хи
Dialogue: 0,0:22:05.82,0:22:07.32,Default,,0,0,0,,Оның қолына қара!
Dialogue: 0,0:22:13.24,0:22:16.50,Default,,0,0,0,,Хехехе хахаха...
Dialogue: 0,0:22:16.62,0:22:19.67,Default,,0,0,0,,(Алукардтың күлкісі)
Dialogue: 0,0:22:20.21,0:22:22.54,Default,,0,0,0,,Барлығын жеуге болады да жақсы.
Dialogue: 0,0:22:22.67,0:22:27.17,Default,,0,0,0,,Хехехе хахаха...
Dialogue: 0,0:22:27.63,0:22:32.64,Default,,0,0,0,,Жасайық, Уолтер.
Dialogue: 0,0:22:32.76,0:22:34.01,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:22:34.14,0:22:37.43,Default,,0,0,0,,Менің ойыным әлі аяқталған жоқ.
Dialogue: 0,0:22:37.85,0:22:39.48,Default,,0,0,0,,Бұл қосулы емес!
Dialogue: 0,0:22:39.60,0:22:42.19,Default,,0,0,0,,Майор, тоқтатыңыз.
Dialogue: 0,0:22:42.86,0:22:45.11,Default,,0,0,0,,Тоқтаңыз, майор!
Dialogue: 0,0:22:45.82,0:22:47.15,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:47.28,0:22:50.66,Default,,0,0,0,,Ол қазірдің өзінде осында. Қазірдің өзінде кеш.
Dialogue: 0,0:22:51.11,0:22:53.91,Default,,0,0,0,,Бәріне кеш
Dialogue: 0,0:22:55.62,0:22:58.41,Default,,0,0,0,,тым кеш, Барса!
Dialogue: 0,0:22:59.62,0:23:01.00,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:23:05.30,0:23:09.22,Default,,0,0,0,,Бәрі баяу.
Dialogue: 0,0:23:09.80,0:23:13.22,Default,,0,0,0,,Сіз енді оны жеңе алмайсыз.
Dialogue: 0,0:23:13.80,0:23:17.72,Default,,0,0,0,,Мүмкіндік мәңгілікке жоғалды
Dialogue: 0,0:23:18.43,0:23:20.48,Default,,0,0,0,,Мен саған мүмкіндік бердім.
Dialogue: 0,0:23:20.60,0:23:22.31,Default,,0,0,0,,Өмірде бір рет болатын...
Dialogue: 0,0:23:22.44,0:23:27.69,Default,,0,0,0,,Алукартты физикалық түрде жеңудің екі мүмкіндігі ғана
Dialogue: 0,0:23:28.36,0:23:34.07,Default,,0,0,0,,1898 жылдан бері екі ғана мүмкіндік
Dialogue: 0,0:23:34.83,0:23:38.58,Default,,0,0,0,,1000 вампир Ваффен-SS
Dialogue: 0,0:23:39.45,0:23:44.13,Default,,0,0,0,,3000 адамнан тұратын 9-шы аэромобильдік крест жорығы
Dialogue: 0,0:23:44.50,0:23:47.17,Default,,0,0,0,,Және Искариот
Dialogue: 0,0:23:47.55,0:23:50.22,Default,,0,0,0,,және қасқыр
Dialogue: 0,0:23:50.42,0:23:53.26,Default,,0,0,0,,және Андерсен
Dialogue: 0,0:23:53.97,0:23:57.89,Default,,0,0,0,,Ал сіздің осы уақытқа дейінгі өміріңіз
Dialogue: 0,0:23:58.01,0:24:02.27,Default,,0,0,0,,Осы заттардың барлығын құрбан ету арқылы жасалған сәт.
Dialogue: 0,0:24:02.39,0:24:06.44,Default,,0,0,0,,Алукартты өлтіруі мүмкін жалғыз сәт
Dialogue: 0,0:24:06.57,0:24:10.69,Default,,0,0,0,,Сонда да сенің жібің маған жетпеді.
Dialogue: 0,0:24:10.82,0:24:12.24,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:24:12.36,0:24:16.58,Default,,0,0,0,,Алукардтың қазір қанша өмірі бар?
Dialogue: 0,0:24:16.70,0:24:20.50,Default,,0,0,0,,1 миллион? 2 миллион?
Dialogue: 0,0:24:21.08,0:24:23.75,Default,,0,0,0,,Сіз енді жеңе алмайсыз.
Dialogue: 0,0:24:23.87,0:24:28.50,Default,,0,0,0,,Сіздің өміріңіз енді бұзылды.
Dialogue: 0,0:24:29.71,0:24:32.17,Default,,0,0,0,,Абыржыма, балақай.
Dialogue: 0,0:24:32.30,0:24:33.76,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:24:33.88,0:24:36.72,Default,,0,0,0,,Тек он мыңдаған рет
Dialogue: 0,0:24:39.89,0:24:43.56,Default,,0,0,0,,Мен Андерсенмен жеңе алмадым...
Dialogue: 0,0:24:43.69,0:24:47.73,Default,,0,0,0,,Сен сияқты бозарған, боқ бала...
Dialogue: 0,0:24:47.86,0:24:50.98,Default,,0,0,0,,50 немесе 500 жыл уайым...
Dialogue: 0,0:24:51.44,0:24:54.03,Default,,0,0,0,,Жеңіске жету мүмкін емес.
Dialogue: 0,0:24:59.62,0:25:03.12,Default,,0,0,0,,Бұл сіздің жоғалтыңыз, Алукард.
Dialogue: 0,0:25:03.25,0:25:04.12,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:25:08.34,0:25:09.96,Default,,0,0,0,,Модель! Модель! Менің не болып жатқанын түсіндірші!
Dialogue: 0,0:25:13.88,0:25:18.09,Default,,0,0,0,,Сіз жеңілдіңіз! алукард
Dialogue: 0,0:25:19.80,0:25:23.23,Default,,0,0,0,,Жоғалту? Кім?
Dialogue: 0,0:25:23.56,0:25:25.10,Default,,0,0,0,,Мен?
Dialogue: 0,0:25:26.31,0:25:30.15,Default,,0,0,0,,Жоғалту? Мен жоғалтсам ше?
Dialogue: 0,0:25:30.36,0:25:33.44,Default,,0,0,0,,Мен сендерден жеңіліп қалсам ше?
Dialogue: 0,0:25:33.57,0:25:35.82,Default,,0,0,0,,Профессор Хеллсинг
Dialogue: 0,0:25:36.82,0:25:40.16,Default,,0,0,0,,Мен ешқашан жеңілмеймін
Dialogue: 0,0:25:40.37,0:25:43.45,Default,,0,0,0,,Менің жеңілетінім жоқ.
Dialogue: 0,0:25:45.79,0:25:47.17,Default,,0,0,0,,Не?
Dialogue: 0,0:25:48.58,0:25:51.00,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:25:51.75,0:25:55.38,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:25:55.76,0:25:58.22,Default,,0,0,0,,Бұл көрініс неге ұқсайды?
Dialogue: 0,0:26:05.10,0:26:08.02,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:26:12.77,0:26:14.28,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:26:19.36,0:26:21.24,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:26:32.21,0:26:36.80,Default,,0,0,0,,Ол кезде де күн сәулесі осылай болды.
Dialogue: 0,0:26:41.39,0:26:43.97,Default,,0,0,0,,Мен өлген жер-
Dialogue: 0,0:26:44.39,0:26:47.10,Default,,0,0,0,,Бұл әрқашан.
Dialogue: 0,0:26:49.02,0:26:51.56,Default,,0,0,0,,Мен қайта-қайта ойлаймын
Dialogue: 0,0:26:52.52,0:26:58.36,Default,,0,0,0,,Күн сәулесі дегеніміз не? Бұл соншалықты әдемі болады деп ешқашан ойламадым.
Dialogue: 0,0:27:13.00,0:27:16.59,Default,,0,0,0,,Жоғалу, жоғалу
Dialogue: 0,0:27:16.71,0:27:18.97,Default,,0,0,0,,Қысқа шамдар
Dialogue: 0,0:27:19.09,0:27:23.30,Default,,0,0,0,,Өмір - бұл жүрген көлеңке
Dialogue: 0,0:27:34.86,0:27:35.73,Default,,0,0,0,,Не!
Dialogue: 0,0:27:36.90,0:27:38.44,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:27:39.07,0:27:40.40,Default,,0,0,0,,(Шинсо) «Мен берілемін», ә… (Изуку) Һм?
Dialogue: 0,0:27:40.78,0:27:43.07,Default,,0,0,0,,Барлығы
Dialogue: 0,0:27:43.57,0:27:44.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:27:45.41,0:27:49.62,Default,,0,0,0,,Ол старшина Шредингердің өмірін сорды.
Dialogue: 0,0:27:49.75,0:27:53.04,Default,,0,0,0,,Бұл өмірдің Шредингер табиғаты...
Dialogue: 0,0:27:53.17,0:27:56.17,Default,,0,0,0,,Ассимиляциядан басқа ештеңе жоқ
Dialogue: 0,0:27:56.88,0:28:03.34,Default,,0,0,0,,Ол «Шредингердің мысығы» еркі бар өзін-өзі бақылаушы.
Dialogue: 0,0:28:03.55,0:28:06.14,Default,,0,0,0,,Болмыстың өзі көп мағыналы.
Dialogue: 0,0:28:06.26,0:28:11.10,Default,,0,0,0,,Ықтималдық әлемінде секірген Чешир мысығы
Dialogue: 0,0:28:11.35,0:28:13.98,Default,,0,0,0,,Өзін білгенше
Dialogue: 0,0:28:14.10,0:28:17.98,Default,,0,0,0,,Ол барлық жерде және еш жерде
Dialogue: 0,0:28:18.82,0:28:20.69,Default,,0,0,0,,Бірақ қазір ол...
Dialogue: 0,0:28:20.82,0:28:25.99,Default,,0,0,0,,Миллиондаған сана мен өмірге балқыған
Dialogue: 0,0:28:26.12,0:28:31.75,Default,,0,0,0,,Ол енді өзін танымайды.
Dialogue: 0,0:28:36.58,0:28:38.84,Default,,0,0,0,,Олай болса, не болады?
Dialogue: 0,0:28:39.63,0:28:42.26,Default,,0,0,0,,Ол енді еш жерде жоқ
Dialogue: 0,0:28:42.38,0:28:45.84,Default,,0,0,0,,Тірі де, өлі де емес
Dialogue: 0,0:28:46.39,0:28:48.85,Default,,0,0,0,,Алукард енді...
Dialogue: 0,0:28:50.47,0:28:53.31,Default,,0,0,0,,Бұл жай ғана ойдан шығарылған сандар шоғыры.
Dialogue: 0,0:28:53.60,0:28:54.44,Default,,0,0,0,,Алукард!
Dialogue: 0,0:28:57.31,0:28:58.36,Default,,0,0,0,,Көзіңді жұма!
Dialogue: 0,0:29:01.28,0:29:02.24,Default,,0,0,0,,Көзіңді аш!
Dialogue: 0,0:29:08.70,0:29:09.62,Default,,0,0,0,,Алукард!
Dialogue: 0,0:29:14.91,0:29:18.04,Default,,0,0,0,,Бұл бұйрық... Алукард
Dialogue: 0,0:29:28.72,0:29:30.01,Default,,0,0,0,,Жоғалып кетпеңіз!
Dialogue: 0,0:29:35.27,0:29:39.23,Default,,0,0,0,,Жоқ... Сау болыңыз.
Dialogue: 0,0:29:40.06,0:29:41.65,Default,,0,0,0,,Интегра
Dialogue: 0,0:30:21.90,0:30:23.61,Default,,0,0,0,,Алукард!
Dialogue: 0,0:30:31.78,0:30:35.54,Default,,0,0,0,,Мен саған барымды бердім
Dialogue: 0,0:30:36.79,0:30:40.63,Default,,0,0,0,,Ол туралы бәрі жоғалып кетті.
Dialogue: 0,0:30:45.92,0:30:48.93,Default,,0,0,0,,Мен осы күн үшін өмір сүрдім
Dialogue: 0,0:30:49.05,0:30:52.93,Default,,0,0,0,,Мен осы сәт үшін ғана өмір сүрдім
Dialogue: 0,0:30:54.39,0:31:00.56,Default,,0,0,0,,Мен жеңілген соғысымда бірінші рет жеңіске жеттім.
Dialogue: 0,0:31:02.06,0:31:04.82,Default,,0,0,0,,Сен... Сен!
Dialogue: 0,0:31:05.19,0:31:09.70,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:31:09.99,0:31:13.74,Default,,0,0,0,,Бұл жеңіс пе?
Dialogue: 0,0:31:21.88,0:31:22.75,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:31:22.88,0:31:23.67,Default,,0,0,0,,Уф
Dialogue: 0,0:31:28.26,0:31:30.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:31:31.97,0:31:36.26,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:31:37.02,0:31:39.73,Default,,0,0,0,,Бұл сендерсіңдер.
Dialogue: 0,0:31:40.14,0:31:43.61,Default,,0,0,0,,Мені не өлтіреді?
Dialogue: 0,0:32:06.29,0:32:11.55,Default,,0,0,0,,Қарғыс атсын... Ха... Хахаха...
Dialogue: 0,0:32:13.01,0:32:16.22,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:32:16.35,0:32:18.60,Default,,0,0,0,,Өлі өлі!
Dialogue: 0,0:32:18.72,0:32:21.98,Default,,0,0,0,,Жоғалып кетті Жоғалды...
Dialogue: 0,0:32:24.69,0:32:29.69,Default,,0,0,0,,(Уолтердің күлкісі)
Dialogue: 0,0:32:32.40,0:32:34.20,Default,,0,0,0,,Уг!?
Dialogue: 0,0:32:36.41,0:32:39.62,Default,,0,0,0,,Менің қалағаным осы ма?
Dialogue: 0,0:32:40.08,0:32:41.83,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:32:43.25,0:32:44.33,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:32:47.46,0:32:50.34,Default,,0,0,0,,Гррр...
Dialogue: 0,0:32:57.05,0:32:59.47,Default,,0,0,0,,Гррррр
Dialogue: 0,0:33:01.31,0:33:05.14,Default,,0,0,0,,Өл, өл, өл, өл!
Dialogue: 0,0:33:05.27,0:33:08.02,Default,,0,0,0,,Бұл сіз жасаған барлық нәрсе.
Dialogue: 0,0:33:08.15,0:33:09.36,Default,,0,0,0,,Өлтіремін!
Dialogue: 0,0:33:11.15,0:33:12.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:13.07,0:33:18.24,Default,,0,0,0,,Хаха, иә, бұл соңы.
Dialogue: 0,0:33:18.62,0:33:21.66,Default,,0,0,0,,Бұл сатқынға лайықты соң.
Dialogue: 0,0:33:21.79,0:33:25.21,Default,,0,0,0,,Абыр-сабыр болмай өлемін
Dialogue: 0,0:33:31.05,0:33:35.09,Default,,0,0,0,,Вампир дегеніміз не? Шинигами дегеніміз не?
Dialogue: 0,0:33:35.22,0:33:37.51,Default,,0,0,0,,Мен сені әбігерсіз өлтіремін!
Dialogue: 0,0:33:46.73,0:33:47.85,Default,,0,0,0,,Уф
Dialogue: 0,0:33:48.81,0:33:52.19,Default,,0,0,0,,А... Көбірек түсіріңіз.
Dialogue: 0,0:33:52.61,0:33:53.82,Default,,0,0,0,,Ату!
Dialogue: 0,0:33:53.94,0:33:56.65,Default,,0,0,0,,О... О! Мен оны лақтырамын!
Dialogue: 0,0:34:01.78,0:34:03.24,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:34:03.37,0:34:04.79,Default,,0,0,0,,Он… бе… с…
Dialogue: 0,0:34:05.20,0:34:08.08,Default,,0,0,0,,Өл, өл!
Dialogue: 0,0:34:09.71,0:34:13.76,Default,,0,0,0,,О! Мен атамын, мен атамын, мен атамын!
Dialogue: 0,0:34:20.09,0:34:23.01,Default,,0,0,0,,Сіз мені атып тастай аласыз
Dialogue: 0,0:34:24.35,0:34:25.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:34:27.19,0:34:30.48,Default,,0,0,0,,Сіз өлтіретін адам емессіз.
Dialogue: 0,0:34:32.69,0:34:33.57,Default,,0,0,0,,Уау
Dialogue: 0,0:34:37.24,0:34:39.49,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз
Dialogue: 0,0:34:39.82,0:34:42.24,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:34:42.87,0:34:45.66,Default,,0,0,0,,Мен сені өлтіремін, сені өлтіремін
Dialogue: 0,0:34:45.79,0:34:47.71,Default,,0,0,0,,Өлтір! өлтір!
Dialogue: 0,0:34:47.83,0:34:50.75,Default,,0,0,0,,Өлтір! өлтір!
Dialogue: 0,0:35:03.43,0:35:05.97,Default,,0,0,0,,Менің кетуім керек…
Dialogue: 0,0:35:07.35,0:35:11.48,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:35:11.73,0:35:12.77,Default,,0,0,0,,Уф
Dialogue: 0,0:35:20.82,0:35:25.33,Default,,0,0,0,,Сәлем, танысқаныма қуаныштымын, Фраулейн
Dialogue: 0,0:35:26.99,0:35:30.54,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:35:30.75,0:35:34.09,Default,,0,0,0,,Иә, бұл сендерсіңдер, балалар.
Dialogue: 0,0:35:35.29,0:35:38.84,Default,,0,0,0,,Мені жеңетін Алукард емес.
Dialogue: 0,0:35:38.97,0:35:42.93,Default,,0,0,0,,Мен жеңетін адам - ​​Алукард.
Dialogue: 0,0:35:48.81,0:35:52.06,Default,,0,0,0,,Менің жауым - Алукард.
Dialogue: 0,0:35:52.19,0:35:55.82,Default,,0,0,0,,Сенің бас жауың енді мен.
Dialogue: 0,0:35:59.53,0:36:01.40,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:36:02.16,0:36:04.45,Default,,0,0,0,,Жау осында!
Dialogue: 0,0:36:04.87,0:36:06.95,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:36:08.37,0:36:10.87,Default,,0,0,0,,Сіз сондасыз
Dialogue: 0,0:36:11.46,0:36:14.29,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:36:16.42,0:36:18.71,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:36:22.55,0:36:23.84,Default,,0,0,0,,Серас
Dialogue: 0,0:36:25.14,0:36:26.26,Default,,0,0,0,,Түсіру
Dialogue: 0,0:36:26.80,0:36:28.22,Default,,0,0,0,,Ату! Ат!
Dialogue: 0,0:36:30.31,0:36:32.94,Default,,0,0,0,,Іздеу және жою!
Dialogue: 0,0:36:34.15,0:36:35.94,Default,,0,0,0,,Іздеу және жою!
Dialogue: 0,0:36:36.31,0:36:39.28,Default,,0,0,0,,Кең ашық алаңда шын мәнінде өзін көрсетеді, иә?
Dialogue: 0,0:36:47.03,0:36:50.12,Default,,0,0,0,,Доктор, сіз оны тым күшті етіп жібердіңіз.
Dialogue: 0,0:36:58.71,0:36:59.75,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:37:09.18,0:37:10.93,Default,,0,0,0,,Ахат ахт!
Dialogue: 0,0:37:11.06,0:37:13.77,Default,,0,0,0,,Бұл тамаша! Мен оны жақсы көремін!
Dialogue: 0,0:37:26.61,0:37:29.33,Default,,0,0,0,,Жақсы Уау
Dialogue: 0,0:37:30.49,0:37:31.54,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:37:53.81,0:37:55.69,Default,,0,0,0,,Бітті, майор.
Dialogue: 0,0:37:58.48,0:38:02.73,Default,,0,0,0,,Бұл... солай сияқты.
Dialogue: 0,0:38:03.82,0:38:07.49,Default,,0,0,0,,Ей... әлі көп жол бар
Dialogue: 0,0:38:08.53,0:38:12.66,Default,,0,0,0,,Бұл... Бұл сіз бе, майор?
Dialogue: 0,0:38:14.79,0:38:16.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:38:17.46,0:38:19.58,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:38:20.84,0:38:21.67,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:38:24.96,0:38:30.68,Default,,0,0,0,,Дөрекі сөз айтпа...
Dialogue: 0,0:38:31.85,0:38:33.68,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:38:34.35,0:38:37.98,Default,,0,0,0,,Мен сөзсіз адаммын.
Dialogue: 0,0:38:40.27,0:38:41.81,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:38:43.19,0:38:45.15,Default,,0,0,0,,Сіз құбыжықсыз
Dialogue: 0,0:38:45.94,0:38:47.78,Default,,0,0,0,,Қауіп-қатерлерге байланысты әуе саяхатынан бас тартып—
Dialogue: 0,0:38:48.20,0:38:50.91,Default,,0,0,0,,Сен, пайдасыз лас—тіпті бір саусағың да—
Dialogue: 0,0:38:51.62,0:38:57.08,Default,,0,0,0,,Бізді адам ететін бір ғана нәрсе бар.
Dialogue: 0,0:38:57.20,0:38:59.58,Default,,0,0,0,,Бұл менің еркім
Dialogue: 0,0:39:00.67,0:39:04.75,Default,,0,0,0,,Қан жанның валютасы ретінде
Dialogue: 0,0:39:04.88,0:39:10.09,Default,,0,0,0,,Мен өзімді басқаларды біріктірмей өмір сүре алмайтындай сезінемін.
Dialogue: 0,0:39:10.22,0:39:14.60,Default,,0,0,0,,Алукард сияқты аянышты құбыжық
Dialogue: 0,0:39:14.72,0:39:18.48,Default,,0,0,0,,Оны соншалықты нәзік нәрсемен араластырмаңыз.
Dialogue: 0,0:39:19.44,0:39:23.52,Default,,0,0,0,,Менің қалауым болғанша
Dialogue: 0,0:39:23.65,0:39:29.74,Default,,0,0,0,,Шыны бөтелкедегі культура ерітіндісінде қалқып тұрған ми кемігі болса да
Dialogue: 0,0:39:29.86,0:39:33.20,Default,,0,0,0,,Менде бар болса да
Dialogue: 0,0:39:33.99,0:39:37.75,Default,,0,0,0,,Мен үлкен компьютердің жад тізбегіне сенімдімін
Dialogue: 0,0:39:37.87,0:39:41.46,Default,,0,0,0,,Бәрі менікі болса да
Dialogue: 0,0:39:42.58,0:39:45.00,Default,,0,0,0,,Сен, пайдасыз лас—тіпті бір саусағың да—
Dialogue: 0,0:39:45.63,0:39:48.51,Default,,0,0,0,,адам жанының
Dialogue: 0,0:39:49.34,0:39:53.01,Default,,0,0,0,,Жүрек қалауының жаратылысы.
Dialogue: 0,0:39:54.64,0:40:00.64,Default,,0,0,0,,Кішкентай қыздың кейпінде күлсе де...
Dialogue: 0,0:40:00.77,0:40:06.94,Default,,0,0,0,,Мен ардагер жауынгер кейпінде сезімге толы тізе бүгемін...
Dialogue: 0,0:40:07.07,0:40:09.53,Default,,0,0,0,,Ол құбыжық
Dialogue: 0,0:40:10.40,0:40:12.53,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:40:12.66,0:40:16.95,Default,,0,0,0,,Мен оны шын жүрегіммен жек көремін
Dialogue: 0,0:40:17.28,0:40:21.25,Default,,0,0,0,,Алукард вампирін танымайды
Dialogue: 0,0:40:22.58,0:40:26.38,Default,,0,0,0,,Ол адам тәрізді құбыжық...
Dialogue: 0,0:40:26.50,0:40:30.26,Default,,0,0,0,,Мен құбыжық сияқтымын
Dialogue: 0,0:40:31.05,0:40:33.84,Default,,0,0,0,,Мен менмін
Dialogue: 0,0:40:39.97,0:40:42.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:43.10,0:40:46.48,Default,,0,0,0,,Мен сенен басқашамын
Dialogue: 0,0:40:46.61,0:40:51.57,Default,,0,0,0,,Бұл дүниеде соғыстың бәрі бар.
Dialogue: 0,0:40:51.69,0:40:55.07,Default,,0,0,0,,Адамдар бұл дүниеге келгеннен бері
Dialogue: 0,0:40:55.66,0:41:01.58,Default,,0,0,0,,Сен де менен басқашамын деп ойлайсың.
Dialogue: 0,0:41:02.04,0:41:06.88,Default,,0,0,0,,Соғыс жариялаудың мерзімі әлдеқашан болды.
Dialogue: 0,0:41:07.17,0:41:12.13,Default,,0,0,0,,Соғысқа барайық
Dialogue: 0,0:42:26.87,0:42:29.83,Default,,0,0,0,,Хаха
Dialogue: 0,0:42:30.04,0:42:32.71,Default,,0,0,0,,Бұл менің бірінші рет жеңіске жетуім еді.
Dialogue: 0,0:42:57.03,0:42:58.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:59.49,0:43:02.32,Default,,0,0,0,,Бұл жақсы...
Dialogue: 0,0:43:06.04,0:43:08.54,Default,,0,0,0,,Жақсы соғыс…
Dialogue: 0,0:43:08.66,0:43:11.83,Default,,0,0,0,,Бұл жақсы соғыс болды
Dialogue: 0,0:43:18.92,0:43:23.01,Default,,0,0,0,,Өлу Сіз өлуіңіз керек
Dialogue: 0,0:43:28.14,0:43:32.44,Default,,0,0,0,,Бұл жақсы соғыс болды ма? майор
Dialogue: 0,0:43:41.66,0:43:44.20,Default,,0,0,0,,Бұл тіпті соғыс емес
Dialogue: 0,0:43:44.91,0:43:50.04,Default,,0,0,0,,60 жыл өлдіңіз, енді соңғы деміңізді шығарып жатырсыз.
Dialogue: 0,0:43:50.96,0:43:53.38,Default,,0,0,0,,Өлуің керек
Dialogue: 0,0:43:53.75,0:43:56.13,Default,,0,0,0,,Бұл абсолютті ескерту.
Dialogue: 0,0:43:57.34,0:44:00.17,Default,,0,0,0,,Қанша адаммын десең де...
Dialogue: 0,0:44:00.30,0:44:03.80,Default,,0,0,0,,Сіз енді тіпті адам емессіз.
Dialogue: 0,0:44:04.51,0:44:08.56,Default,,0,0,0,,Сіз нағыз құбыжықсыз.
Dialogue: 0,0:44:12.31,0:44:15.94,Default,,0,0,0,,Құбыжықтарды әрқашан адамдар жеңеді.
Dialogue: 0,0:44:16.82,0:44:19.07,Default,,0,0,0,,Құбыжықтар адамдардан жеңіледі
Dialogue: 0,0:44:20.03,0:44:23.95,Default,,0,0,0,,Тек адам ғана жеңуді мақсат етеді.
Dialogue: 0,0:44:24.16,0:44:26.87,Default,,0,0,0,,Ұрыс қуанышы үшін емес
Dialogue: 0,0:44:26.99,0:44:29.70,Default,,0,0,0,,Өйткені оны орындау сенің міндетің.
Dialogue: 0,0:44:33.25,0:44:36.17,Default,,0,0,0,,Сіз адам емессіз
Dialogue: 0,0:44:37.46,0:44:40.63,Default,,0,0,0,,Сондықтан ол қайтып келеді!
Dialogue: 0,0:44:51.10,0:44:52.68,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:44:54.40,0:44:57.23,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:44:57.82,0:45:00.23,Default,,0,0,0,,Ғылымға негізделген технология жетістіктері
Dialogue: 0,0:45:00.36,0:45:01.78,Default,,0,0,0,,Зерттеулер алға қарай серпіліс жасайды
Dialogue: 0,0:45:01.90,0:45:05.24,Default,,0,0,0,,Жоқ! Жоқ! Зерттеу алға қарай секірді!
Dialogue: 0,0:45:05.74,0:45:08.53,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:45:08.99,0:45:10.95,Default,,0,0,0,,Не... Не...
Dialogue: 0,0:45:16.04,0:45:19.17,Default,,0,0,0,,Әлі жоқ. Ол әлі келген жоқ.
Dialogue: 0,0:45:19.29,0:45:21.67,Default,,0,0,0,,Не болды? Не жетіспейді?
Dialogue: 0,0:45:22.01,0:45:24.17,Default,,0,0,0,,Иә, бір күні, бір күні...
Dialogue: 0,0:45:24.38,0:45:26.22,Default,,0,0,0,,Бүкіл әлемге!
Dialogue: 0,0:45:26.89,0:45:29.72,Default,,0,0,0,,Әр адамға тамақ беріңіз!
Dialogue: 0,0:45:30.18,0:45:34.23,Default,,0,0,0,,Ғылымдай ғажап Ғылым сияқты ғажайып
Dialogue: 0,0:45:34.73,0:45:36.69,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:45:36.81,0:45:38.23,Default,,0,0,0,,Ұлы Пайғамбар
Dialogue: 0,0:45:38.69,0:45:42.73,Default,,0,0,0,,Жоқ, жоқ, доктор, өлгенде абай болу керек.
Dialogue: 0,0:45:43.07,0:45:45.32,Default,,0,0,0,,У...Уолтер
Dialogue: 0,0:45:45.70,0:45:46.95,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:45:47.07,0:45:52.37,Default,,0,0,0,,Нацистік қалдықтардың қалдықтары күлкі емес.
Dialogue: 0,0:45:52.62,0:45:55.29,Default,,0,0,0,,Мынау... нашар жасалған көзілдірік!
Dialogue: 0,0:45:55.91,0:45:59.59,Default,,0,0,0,,Сіз де үлкен сәтсіздікке ұшырайсыз, доктор.
Dialogue: 0,0:45:59.71,0:46:03.55,Default,,0,0,0,,Сіз және сіз жасаған барлық нәрсе
Dialogue: 0,0:46:03.67,0:46:05.30,Default,,0,0,0,,Бұл қызметші де
Dialogue: 0,0:46:05.59,0:46:09.68,Default,,0,0,0,,Фарс бітті, орындаушылар да жоғалып кетуі керек.
Dialogue: 0,0:46:09.89,0:46:13.02,Default,,0,0,0,,Дұрыс па? Ұлы Пайғамбар
Dialogue: 0,0:46:13.14,0:46:15.89,Default,,0,0,0,,Фарс? Бұл фарс па?
Dialogue: 0,0:46:16.02,0:46:17.77,Default,,0,0,0,,Қай ауыз сөйлейді?
Dialogue: 0,0:46:17.90,0:46:19.81,Default,,0,0,0,,Ақаулы өнімнің қай аузында!
Dialogue: 0,0:46:20.11,0:46:23.15,Default,,0,0,0,,Бұл бір түндік, бір актілі фарс.
Dialogue: 0,0:46:23.73,0:46:26.74,Default,,0,0,0,,Бұл соғыс және бұл дүние
Dialogue: 0,0:46:27.65,0:46:33.62,Default,,0,0,0,,Мен... Мен тек ондағы ең жақсы рөлді ойнағым келді.
Dialogue: 0,0:46:38.12,0:46:39.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:39.71,0:46:41.96,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:46:42.42,0:46:44.17,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,0:46:44.80,0:46:47.63,Default,,0,0,0,,Я, бұл қорқынышты аяқталды.
Dialogue: 0,0:46:47.84,0:46:51.68,Default,,0,0,0,,Алукард дұрыс, бұл әдепсіз.
Dialogue: 0,0:46:52.10,0:46:54.72,Default,,0,0,0,,Егер сізде осындай ақаулы өнім болса...
Dialogue: 0,0:46:54.85,0:46:56.31,Default,,0,0,0,,Сіз сәтсізсіз...
Dialogue: 0,0:46:56.81,0:46:58.94,Default,,0,0,0,,Сен бізге күлесің бе?
Dialogue: 0,0:46:59.44,0:47:00.65,Default,,0,0,0,,Сізге және т.б.
Dialogue: 0,0:47:00.77,0:47:03.94,Default,,0,0,0,,Менің зерттеуімді фарс деп атағанына шыдай алмаймын!
Dialogue: 0,0:47:04.07,0:47:07.40,Default,,0,0,0,,Майор-доно батальонында күлкіге шыдай алмаймын!
Dialogue: 0,0:47:07.53,0:47:10.95,Default,,0,0,0,,Сізге! Сіз сияқты бірдеңе!
Dialogue: 0,0:47:11.82,0:47:14.99,Default,,0,0,0,,Теория секіреді
Dialogue: 0,0:47:15.12,0:47:18.33,Default,,0,0,0,,Ғылым тәжірибеден нәр алып, сергек болмай алға ұмтылады.
Dialogue: 0,0:47:18.46,0:47:20.54,Default,,0,0,0,,Мен мұны бір күні қуып жетемін!
Dialogue: 0,0:47:20.67,0:47:22.46,Default,,0,0,0,,Бір күні мен Алукардтан да асып түсемін!
Dialogue: 0,0:47:23.34,0:47:25.17,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:47:25.30,0:47:27.63,Default,,0,0,0,,Сен де, мен де өлеміз.
Dialogue: 0,0:47:27.76,0:47:29.47,Default,,0,0,0,,Барлық ақаулы өнімдер өледі.
Dialogue: 0,0:47:29.80,0:47:31.43,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:47:34.85,0:47:35.93,Default,,0,0,0,,Уф
Dialogue: 0,0:47:36.77,0:47:37.60,Default,,0,0,0,,Гуах
Dialogue: 0,0:47:42.77,0:47:44.65,Default,,0,0,0,,Мина Харкер
Dialogue: 0,0:47:45.27,0:47:48.49,Default,,0,0,0,,Дұрыс, бұл сіздің оқу материалыңыз.
Dialogue: 0,0:47:50.28,0:47:51.70,Default,,0,0,0,,Алукард
Dialogue: 0,0:47:51.82,0:47:55.70,Default,,0,0,0,,Дракула қан сорған жалғыз тіршілік иесі
Dialogue: 0,0:47:55.83,0:47:57.95,Default,,0,0,0,,Барлығы қайдан басталды
Dialogue: 0,0:47:58.70,0:48:00.83,Default,,0,0,0,,Дракула Хеллсингтен жеңілді...
Dialogue: 0,0:48:00.96,0:48:03.08,Default,,0,0,0,,Адам болып қайтады дейді.
Dialogue: 0,0:48:03.38,0:48:06.46,Default,,0,0,0,,Бірақ Алукард өлген жоқ.
Dialogue: 0,0:48:06.80,0:48:10.30,Default,,0,0,0,,Оның ішінде Алукард бар.
Dialogue: 0,0:48:12.30,0:48:17.06,Default,,0,0,0,,Оған не болғанына қарамастан, ол оның ішінде тереңде бар.
Dialogue: 0,0:48:18.02,0:48:21.85,Default,,0,0,0,,Мен қасиетті күріш пирогтары, қасиетті су немесе крест туралы ештеңе істей алмаймын.
Dialogue: 0,0:48:21.98,0:48:23.90,Default,,0,0,0,,Вампир қаны
Dialogue: 0,0:48:24.31,0:48:27.44,Default,,0,0,0,,Ендеше, сендер сол жерден бастадыңдар.
Dialogue: 0,0:48:28.78,0:48:30.82,Default,,0,0,0,,Алукардқа еліктеу
Dialogue: 0,0:48:31.86,0:48:34.82,Default,,0,0,0,,Сондықтан сіз оны әшкереледіңіз...
Dialogue: 0,0:48:35.28,0:48:39.70,Default,,0,0,0,,Мен оны тастап кеттім.
Dialogue: 0,0:48:46.79,0:48:48.25,Default,,0,0,0,,Ақыр соңында-
Dialogue: 0,0:48:48.38,0:48:51.72,Default,,0,0,0,,Балалар сендердің істегендерің көшірме өнімі болды.
Dialogue: 0,0:48:52.01,0:48:55.30,Default,,0,0,0,,Бұл қандай да бір күлдіргі комедия болмаса ше?
Dialogue: 0,0:48:55.84,0:48:57.76,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:48:59.39,0:49:01.56,Default,,0,0,0,,Бейшара Мина
Dialogue: 0,0:49:01.81,0:49:05.15,Default,,0,0,0,,Бәрі жоғалады, кет.
Dialogue: 0,0:49:05.27,0:49:07.31,Default,,0,0,0,,Балалар, сендер де, мен де
Dialogue: 0,0:49:09.82,0:49:11.28,Default,,0,0,0,,Керемет
Dialogue: 0,0:49:11.78,0:49:13.45,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:49:14.28,0:49:16.99,Default,,0,0,0,,Фу… пинболда
Dialogue: 0,0:49:19.24,0:49:20.74,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:49:26.96,0:49:30.25,Default,,0,0,0,,О, қарғыс атсын
Dialogue: 0,0:49:30.96,0:49:34.72,Default,,0,0,0,,Мен оны жеңгім келді.
Dialogue: 0,0:49:40.18,0:49:44.43,Default,,0,0,0,,Қош болыңыз, жас ханым.
Dialogue: 0,0:49:54.11,0:49:55.65,Default,,0,0,0,,Уолтер!
Dialogue: 0,0:49:56.99,0:49:58.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:02.24,0:50:05.87,Default,,0,0,0,,Енді Уолтер қайтыс болды
Dialogue: 0,0:50:09.08,0:50:10.17,Default,,0,0,0,,Иә
Dialogue: 0,0:50:16.80,0:50:18.22,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:50:18.97,0:50:20.60,Default,,0,0,0,,Үйге қайтайық Серас
Dialogue: 0,0:50:22.14,0:50:23.47,Default,,0,0,0,,Менің үйіме
Dialogue: 0,0:50:25.52,0:50:26.48,Default,,0,0,0,,Ұш!
Dialogue: 0,0:52:09.66,0:52:13.92,Default,,0,0,0,,«Британдық және американдық биотеррорлық оқиға, сонымен қатар дирижабль оқиғасы ретінде белгілі»
Dialogue: 0,0:52:14.04,0:52:16.00,Default,,0,0,0,,«17-ші есеп»
Dialogue: 0,0:52:16.34,0:52:21.47,Default,,0,0,0,,«64 300 құрбан, соның ішінде АҚШ кабинетінің барлық мүшелері»
Dialogue: 0,0:52:21.76,0:52:26.93,Default,,0,0,0,,«Ұлыбритания 3 718 917 адам»
Dialogue: 0,0:52:28.64,0:52:31.85,Default,,0,0,0,,Бүгін қылышпен күресетін күн емес пе?
Dialogue: 0,0:52:31.98,0:52:34.02,Default,,0,0,0,,Мен баруым керек пе?
Dialogue: 0,0:52:34.31,0:52:37.73,Default,,0,0,0,,Иә, мен сәл босаңсып, сосын басын бұрамын.
Dialogue: 0,0:52:38.57,0:52:39.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:52:40.11,0:52:43.57,Default,,0,0,0,,Тіпті 30 жыл бұрынғы оқиға қайталанса да
Dialogue: 0,0:52:43.70,0:52:47.74,Default,,0,0,0,,Менің міндетім – мәселені қарусыз шешу.
Dialogue: 0,0:52:47.95,0:52:49.12,Default,,0,0,0,,Хмм…
Dialogue: 0,0:52:49.66,0:52:54.04,Default,,0,0,0,,Аралдар, сен солай көрінесің.
Dialogue: 0,0:52:54.17,0:52:57.38,Default,,0,0,0,,Сіз шынымен де үлкен атаңызға қатты ұқсайсыз.
Dialogue: 0,0:53:02.13,0:53:03.30,Default,,0,0,0,,Уф
Dialogue: 0,0:53:05.18,0:53:06.14,Default,,0,0,0,,Ах
Dialogue: 0,0:53:09.18,0:53:11.06,Default,,0,0,0,,Міне! Сәйкестік бар!
Dialogue: 0,0:53:11.85,0:53:13.73,Default,,0,0,0,,Интегра жеңеді!
Dialogue: 0,0:53:20.23,0:53:21.99,Default,,0,0,0,,Керемет жұмыс Тамаша жұмыс
Dialogue: 0,0:53:22.11,0:53:24.91,Default,,0,0,0,,Қолдарыңыз мүлде әлсіреген жоқ.
Dialogue: 0,0:53:25.20,0:53:29.41,Default,,0,0,0,,Мен сізден 13-бөлімнің қабылдау бөлмесінде күтуіңізді өтінуім керек еді.
Dialogue: 0,0:53:29.91,0:53:34.54,Default,,0,0,0,,Жоқ, жоқ, жай күту сенің табиғатың емес.
Dialogue: 0,0:53:34.66,0:53:38.17,Default,,0,0,0,,Ал мен қанша тырыссам да бір шыны шай іше алмаймын.
Dialogue: 0,0:53:38.75,0:53:41.25,Default,,0,0,0,,Мен аздап жалықтым.
Dialogue: 0,0:53:41.38,0:53:44.13,Default,,0,0,0,,Адамдар рұқсатсыз жүрсе, бұл мәселе.
Dialogue: 0,0:53:44.26,0:53:46.05,Default,,0,0,0,,Қайтып келіңізші. Иә, иә
Dialogue: 0,0:53:46.51,0:53:49.76,Default,,0,0,0,,Иә, иә, қайтайық.
Dialogue: 0,0:53:58.44,0:53:59.61,Default,,0,0,0,,Иә
Dialogue: 0,0:54:02.90,0:54:07.07,Default,,0,0,0,,Бас инженер Макубе Резиденцияның ішіндегі күзет әлі де дуршлаг.
Dialogue: 0,0:54:07.20,0:54:08.41,Default,,0,0,0,,Енді сіз жеңе аласыз
Dialogue: 0,0:54:08.91,0:54:12.20,Default,,0,0,0,,Бала, сенің көзің соқыр.
Dialogue: 0,0:54:12.33,0:54:13.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:14.75,0:54:15.71,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:54:15.96,0:54:17.17,Default,,0,0,0,,А? О?
Dialogue: 0,0:54:17.71,0:54:20.25,Default,,0,0,0,,Ауырды, не істеп жатырсың?
Dialogue: 0,0:54:20.84,0:54:22.00,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:54:22.34,0:54:24.88,Default,,0,0,0,,Бұл Серас Викторияның көлеңкесі.
Dialogue: 0,0:54:25.47,0:54:28.89,Default,,0,0,0,,Үйдің бүкіл аумағы бізді орап алды.
Dialogue: 0,0:54:29.97,0:54:33.35,Default,,0,0,0,,Бірақ менің және бас инженердің орнына...
Dialogue: 0,0:54:33.47,0:54:35.39,Default,,0,0,0,,Дөңгелек үстелдің жартысын алуға болады
Dialogue: 0,0:54:35.89,0:54:38.60,Default,,0,0,0,,Әлі емес, әлі жоқ!
Dialogue: 0,0:54:39.35,0:54:41.90,Default,,0,0,0,,Біз тым көп жоғалттық
Dialogue: 0,0:54:42.02,0:54:46.90,Default,,0,0,0,,Тоғызыншы крест жорығынан кейін Ватикан тым көп биліктен айырылды.
Dialogue: 0,0:54:47.03,0:54:49.16,Default,,0,0,0,,Эй, мен күтемін.
Dialogue: 0,0:54:49.91,0:54:52.08,Default,,0,0,0,,Біз 500 жыл күттік
Dialogue: 0,0:54:52.20,0:54:56.33,Default,,0,0,0,,100 жыл 200 жылға ештеңе қалдырмады
Dialogue: 0,0:54:56.45,0:54:59.75,Default,,0,0,0,,Мен келесі 10-да жақсы жұмыс істеймін
Dialogue: 0,0:55:03.46,0:55:06.84,Default,,0,0,0,,Бүгінгі күннің бәрі осы. Біз оны тоқтатамыз.
Dialogue: 0,0:55:07.42,0:55:09.88,Default,,0,0,0,,Тынымсыз еңбегіңіз үшін рахмет, лорд Пенвуд.
Dialogue: 0,0:55:10.01,0:55:11.51,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:55:11.64,0:55:15.02,Default,,0,0,0,,Жақсы қылыш шеберлігі. Жақсартылған.
Dialogue: 0,0:55:15.22,0:55:18.94,Default,,0,0,0,,Жоқ, әлі жоқ... Рахмет.
Dialogue: 0,0:55:19.48,0:55:21.90,Default,,0,0,0,,А... у... ақсақал
Dialogue: 0,0:55:22.02,0:55:26.03,Default,,0,0,0,,Жоқ.Менің атам да қылыш жасауды үйренді ме?
Dialogue: 0,0:55:26.74,0:55:28.03,Default,,0,0,0,,Я...
Dialogue: 0,0:55:28.82,0:55:31.53,Default,,0,0,0,,Сенің атаң-
Dialogue: 0,0:55:32.87,0:55:35.79,Default,,0,0,0,,Жақындап келе жатқан фашистік жауынгерлерді жұлып тастап, лақтыр. Оларды жыртып, лақтырып тастаңыз.
Dialogue: 0,0:55:35.91,0:55:37.95,Default,,0,0,0,,Ұлыбританияның теңдесі жоқ...
Dialogue: 0,0:55:38.08,0:55:40.46,Default,,0,0,0,,Жақындап келе жатқан жауды бір шетінен екіге кесіңіз.
Dialogue: 0,0:55:40.58,0:55:42.92,Default,,0,0,0,,Соңында оның бүкіл денесіне бомба байланған.
Dialogue: 0,0:55:43.04,0:55:46.63,Default,,0,0,0,,Қарсыластың әуе кемесі ұшып кеткен сияқты.
Dialogue: 0,0:55:47.05,0:55:48.84,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:55:48.97,0:55:50.68,Default,,0,0,0,,Ол Англияның қамқоршы құдайы.
Dialogue: 0,0:55:50.80,0:55:53.89,Default,,0,0,0,,Бұл сол көз де сол кезде ерекше қылышқа ілінген.
Dialogue: 0,0:55:54.01,0:55:55.18,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:55:55.31,0:55:56.97,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:55:57.18,0:55:59.23,Default,,0,0,0,,Бұл шынымен де рас
Dialogue: 0,0:55:59.81,0:56:00.94,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:56:01.81,0:56:04.90,Default,,0,0,0,,Бұл рас болғандықтан, жаңа тікұшақ үшін төлеңіз.
Dialogue: 0,0:56:05.02,0:56:06.44,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:56:06.78,0:56:08.74,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:56:09.19,0:56:11.70,Default,,0,0,0,,ол тіпті байқамайды
Dialogue: 0,0:56:12.57,0:56:14.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:14.82,0:56:17.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:17.91,0:56:19.54,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:56:19.66,0:56:20.71,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:56:21.12,0:56:24.38,Default,,0,0,0,,Ол адамға және оның отбасына қиын.
Dialogue: 0,0:56:24.50,0:56:27.38,Default,,0,0,0,,Көбінесе бұл мафияның тактикасы емес пе?
Dialogue: 0,0:56:27.50,0:56:30.67,Default,,0,0,0,,Жарайды, сенің қиналғаның маған керек.
Dialogue: 0,0:56:30.80,0:56:33.97,Default,,0,0,0,,Бұдан былай мен саған көп қиындық беруім керек.
Dialogue: 0,0:56:35.51,0:56:38.31,Default,,0,0,0,,Мен өлсем, Тозақ та бітеді.
Dialogue: 0,0:56:38.43,0:56:41.39,Default,,0,0,0,,Сонда сол адамдар басқаратын болады.
Dialogue: 0,0:56:41.64,0:56:45.27,Default,,0,0,0,,Содан бастап бұл рөлді үкімет басқаратын ұлттық ұйым қабылдайды.
Dialogue: 0,0:56:45.40,0:56:47.02,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:56:47.15,0:56:50.28,Default,,0,0,0,,Бұл енді мекемені отбасы басқаратын дәуір емес.
Dialogue: 0,0:56:51.69,0:56:52.78,Default,,0,0,0,,Я...
Dialogue: 0,0:56:53.32,0:56:55.53,Default,,0,0,0,,Ал мен аздап шаршадым.
Dialogue: 0,0:56:55.66,0:56:58.16,Default,,0,0,0,,Не? Бұл олай емес сияқты.
Dialogue: 0,0:56:58.74,0:57:02.00,Default,,0,0,0,,Бүгін таңертең айнаға қарағанымда, тағы да жұқа әжімдердің пайда болғанын байқадым!\NМен
Dialogue: 0,0:57:02.12,0:57:02.96,Default,,0,0,0,,Е...
Dialogue: 0,0:57:03.58,0:57:06.04,Default,,0,0,0,,әжімдерге қарағанымда, мен бір нәрсені байқадым ...
Dialogue: 0,0:57:06.58,0:57:09.05,Default,,0,0,0,,Бұл маған Уолтерді еске түсіреді.
Dialogue: 0,0:57:09.46,0:57:11.51,Default,,0,0,0,,Бұл ұрыс, жас ханым.
Dialogue: 0,0:57:11.63,0:57:13.01,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:57:14.30,0:57:16.59,Default,,0,0,0,,Көңілсіз қалмаңыз. Депрессияға түспеңіз.
Dialogue: 0,0:57:16.72,0:57:19.18,Default,,0,0,0,,Әлі де жақсы емес пе? Сіз оны жеңе алмайсыз ба?
Dialogue: 0,0:57:19.31,0:57:21.27,Default,,0,0,0,,Өтінемін, «Мен өлгенде...» деп айтпаңыз.
Dialogue: 0,0:57:21.39,0:57:23.44,Default,,0,0,0,,Қаныңды сору үшін не істеуім керек?
Dialogue: 0,0:57:25.19,0:57:26.81,Default,,0,0,0,,Шеберге қара, қара, елікте.
Dialogue: 0,0:57:26.94,0:57:27.77,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:57:28.27,0:57:30.23,Default,,0,0,0,,Ешқандай тебу жоқ, солай ма?
Dialogue: 0,0:57:30.36,0:57:32.07,Default,,0,0,0,,Қалжыңдамай-ақ қой, ақымақ!
Dialogue: 0,0:57:32.19,0:57:34.20,Default,,0,0,0,,Қанша ондаған жылдар өтсе де өзгерген жоқсың.
Dialogue: 0,0:57:34.32,0:57:36.91,Default,,0,0,0,,Негізі Алукард, сен не істеп жатырсың ақымақ?
Dialogue: 0,0:57:37.03,0:57:38.74,Default,,0,0,0,,Ол мүлде қайтып келмейді!
Dialogue: 0,0:57:38.87,0:57:41.33,Default,,0,0,0,,Сіз қайтып келемін дедіңіз!
Dialogue: 0,0:57:43.08,0:57:44.08,Default,,0,0,0,,Иә
Dialogue: 0,0:57:44.58,0:57:46.46,Default,,0,0,0,,Мен қайтамын
Dialogue: 0,0:57:46.88,0:57:51.38,Default,,0,0,0,,Түсіндім, өйткені қанымды сорып жатыр.
Dialogue: 0,0:57:52.01,0:57:56.59,Default,,0,0,0,,Келеді дегеніме 30 жыл болды. 30 жыл болды.
Dialogue: 0,0:58:24.62,0:58:27.25,Default,,0,0,0,,Сіз вампир болғандықтан, бұл жақсы нәрсе болуы мүмкін.
Dialogue: 0,0:58:27.37,0:58:28.92,Default,,0,0,0,,Жіңішке сызықтар көбеймейді.
Dialogue: 0,0:58:29.04,0:58:29.88,Default,,0,0,0,,Хмм
Dialogue: 0,0:58:30.17,0:58:31.67,Default,,0,0,0,,Сен жаман баласың! Мен осындамын…
Dialogue: 0,0:58:32.25,0:58:34.55,Default,,0,0,0,,Мына ауыз! Бұл ауыз не дейді?
Dialogue: 0,0:58:34.67,0:58:36.47,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:58:36.59,0:58:39.34,Default,,0,0,0,,Кешіріңіз, кешіріңіз!
Dialogue: 0,1:00:07.27,1:00:08.52,Default,,0,0,0,,Не болып жатыр! шебері
Dialogue: 0,1:00:10.18,1:00:11.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:12.98,1:00:18.03,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:00:23.99,1:00:26.12,Default,,0,0,0,,Дөрекі қарсы алу
Dialogue: 0,1:00:26.24,1:00:29.66,Default,,0,0,0,,Бұл әлі де шулы
Dialogue: 0,1:00:30.20,1:00:31.16,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,1:00:32.83,1:00:35.96,Default,,0,0,0,,Бұл кеш оралды, Алукард.
Dialogue: 0,1:00:36.46,1:00:38.17,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:00:38.59,1:00:42.13,Default,,0,0,0,,Әй, олар өлтіре берді.
Dialogue: 0,1:00:42.43,1:00:47.06,Default,,0,0,0,,Менің ішімдегі өмірім
Dialogue: 0,1:00:48.97,1:00:53.56,Default,,0,0,0,,3,424,867
Dialogue: 0,1:00:54.31,1:01:00.57,Default,,0,0,0,,Біреуінен басқасының бәрін өлтірдім.
Dialogue: 0,1:01:02.74,1:01:05.87,Default,,0,0,0,,I'm already here
Dialogue: 0,1:01:06.16,1:01:11.33,Default,,0,0,0,,Мен енді еш жерде емеспін, мен кез келген жерде бола аламын.
Dialogue: 0,1:01:11.45,1:01:14.75,Default,,0,0,0,,Сондықтан мен мұндамын
Dialogue: 0,1:01:17.13,1:01:20.38,Default,,0,0,0,,late too late
Dialogue: 0,1:01:21.13,1:01:23.22,Default,,0,0,0,,Кеш болды, Алукард.
Dialogue: 0,1:01:24.09,1:01:27.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:01:28.93,1:01:32.85,Default,,0,0,0,,Қан сорайын деп пе едің? мен
Dialogue: 0,1:01:33.39,1:01:36.35,Default,,0,0,0,,Иә
Dialogue: 0,1:01:36.65,1:01:39.57,Default,,0,0,0,,Мен 30 жыл бойы ештеңе жеген жоқпын.
Dialogue: 0,1:01:39.98,1:01:41.78,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,1:01:52.25,1:01:55.25,Default,,0,0,0,,Мен әже болдым.
Dialogue: 0,1:01:56.08,1:01:57.42,Default,,0,0,0,,Мен...
Dialogue: 0,1:02:00.09,1:02:01.75,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,1:02:02.59,1:02:03.72,Default,,0,0,0,,Иә
Dialogue: 0,1:02:13.73,1:02:15.18,Default,,0,0,0,,Хехе
Dialogue: 0,1:02:25.65,1:02:29.03,Default,,0,0,0,,Welcome back Earl
Dialogue: 0,1:02:30.62,1:02:34.20,Default,,0,0,0,,I'm home, Earl.
Dialogue: 0,1:02:56.27,1:02:58.14,Default,,0,0,0,,（）
Dialogue: 0,1:03:24.30,1:03:29.30,Default,,0,0,0,,♪~
Dialogue: 0,1:07:17.45,1:07:22.45,Default,,0,0,0,,~♪
Dialogue: 0,1:07:23.95,1:07:29.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
