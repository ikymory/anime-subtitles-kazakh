Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:10.75,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:18.66,0:00:22.25,Default,,0,0,0,,(санауыштың азаю дыбысы)
Dialogue: 0,0:00:26.50,0:00:30.41,Default,,0,0,0,,(Цюрих) Иә, сен сияқты біреу оқпаннан оянды.
Dialogue: 0,0:00:31.20,0:00:32.66,Default,,0,0,0,,Кім? tell me!
Dialogue: 0,0:00:32.75,0:00:33.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:34.20,0:00:36.75,Default,,0,0,0,,(Цюрих) ID нөмірі 34001
Dialogue: 0,0:00:36.83,0:00:38.41,Default,,0,0,0,,Dr. Weston Fields
Dialogue: 0,0:00:39.54,0:00:42.41,Default,,0,0,0,,Доктор Уэстон Филдс…
Dialogue: 0,0:00:42.50,0:00:43.37,Default,,0,0,0,,Ahaha
Dialogue: 0,0:00:43.45,0:00:44.83,Default,,0,0,0,,Бұл адам қайда... иә?
Dialogue: 0,0:00:46.00,0:00:47.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:47.45,0:00:48.41,Default,,0,0,0,,(alarm sound)
Dialogue: 0,0:00:48.50,0:00:49.45,Default,,0,0,0,,Uuuuuuuck...!
Dialogue: 0,0:00:49.54,0:00:53.16,Default,,0,0,0,,(Цюрих) Егер сіз дәл осы жерге барсаңыз, сіз Эденслиден шығасыз.
Dialogue: 0,0:00:53.87,0:00:55.33,Default,,0,0,0,,Құпия сөзді табыңыз
Dialogue: 0,0:00:55.41,0:00:56.87,Default,,0,0,0,,Артық уақыт жоқ
Dialogue: 0,0:00:56.95,0:00:58.16,Default,,0,0,0,,Hurry
Dialogue: 0,0:00:58.25,0:00:59.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:00.04,0:01:02.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:08.50,0:01:10.16,Default,,0,0,0,,(Shutdown sound)
Dialogue: 0,0:01:22.00,0:01:23.20,Default,,0,0,0,,Geneva
Dialogue: 0,0:01:23.79,0:01:25.16,Default,,0,0,0,,(Geneva) What? нөл
Dialogue: 0,0:01:26.20,0:01:28.62,Default,,0,0,0,,Open this door.
Dialogue: 0,0:01:28.70,0:01:29.66,Default,,0,0,0,,(Женева) Мүмкін емес
Dialogue: 0,0:01:30.16,0:01:33.95,Default,,0,0,0,,Бұл Eden One AI Цюрих басқаратын аймақ.
Dialogue: 0,0:01:34.04,0:01:36.91,Default,,0,0,0,,Менің рұқсатым жоқ
Dialogue: 0,0:01:37.62,0:01:39.66,Default,,0,0,0,,Цюрих, есікті аш.
Dialogue: 0,0:01:41.91,0:01:43.04,Default,,0,0,0,,Zurich?
Dialogue: 0,0:01:43.83,0:01:46.00,Default,,0,0,0,,(Женева) Өшіру
Dialogue: 0,0:01:46.08,0:01:46.66,Default,,0,0,0,,Не?
Dialogue: 0,0:01:48.95,0:01:51.70,Default,,0,0,0,,Бұл үзінді қайда апарады?
Dialogue: 0,0:01:51.79,0:01:55.16,Default,,0,0,0,,(Женева) Eden One - өткеннің қалдығы. Мен түсінбедім.
Dialogue: 0,0:01:56.62,0:01:59.29,Default,,0,0,0,,Цюрих адамдарға қашып кетуге мүмкіндік берді ме?
Dialogue: 0,0:02:00.37,0:02:04.58,Default,,0,0,0,,Geneva Recon бөлімшесі Эденслидің сыртында орналасқан
Dialogue: 0,0:02:04.66,0:02:06.29,Default,,0,0,0,,Find the human
Dialogue: 0,0:02:06.37,0:02:07.79,Default,,0,0,0,,(Женева) Түсінікті
Dialogue: 0,0:02:09.25,0:02:10.50,Default,,0,0,0,,(есептегіштің төмендеу дыбысы)
Dialogue: 0,0:02:10.58,0:02:13.70,Default,,0,0,0,,AI нені жоспарлайды?
Dialogue: 0,0:02:17.00,0:02:19.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:20.79,0:02:22.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:23.58,0:02:25.58,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:02:25.66,0:02:27.08,Default,,0,0,0,,(Роботтың аяқ дыбысы) Уф... Ах!
Dialogue: 0,0:02:27.16,0:02:28.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.50,0:02:32.41,Default,,0,0,0,,(робот қадамдары)
Dialogue: 0,0:02:33.08,0:02:33.95,Default,,0,0,0,,(тынысыңызды ұстаңыз)
Dialogue: 0,0:02:35.45,0:02:36.41,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:02:36.50,0:02:40.08,Default,,0,0,0,,(робот қадамдары)
Dialogue: 0,0:02:42.00,0:02:43.66,Default,,0,0,0,,Dad Mom!
Dialogue: 0,0:02:43.75,0:02:44.91,Default,,0,0,0,,(E92･A37) Сара!
Dialogue: 0,0:02:45.00,0:02:46.16,Default,,0,0,0,,Ah... Ah!
Dialogue: 0,0:02:46.70,0:02:47.58,Default,,0,0,0,,Ах...!
Dialogue: 0,0:02:47.66,0:02:49.12,Default,,0,0,0,,(E92) Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:02:49.20,0:02:52.12,Default,,0,0,0,,(A37) Тез қашайық, бұл жерден алыс.
Dialogue: 0,0:02:52.20,0:02:55.41,Default,,0,0,0,,(E92) Мен осында қалсам, олар мені бірден тауып алады.
Dialogue: 0,0:02:55.50,0:02:56.83,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:59.04,0:02:59.95,Default,,0,0,0,,(E92) Сара?
Dialogue: 0,0:03:02.29,0:03:05.54,Default,,0,0,0,,(E92) Сара бұл құпия сөзді айту керек.
Dialogue: 0,0:03:05.62,0:03:09.16,Default,,0,0,0,,Суық ұйқыда ұйықтап жатқан адамдар өмір сүре ала ма?
Dialogue: 0,0:03:09.25,0:03:12.66,Default,,0,0,0,,Иә... мен бе әлде доктор Филдс пе?
Dialogue: 0,0:03:12.75,0:03:15.87,Default,,0,0,0,,(A37) Бұл доктор Филдс қайда?
Dialogue: 0,0:03:15.95,0:03:17.25,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:03:17.33,0:03:18.58,Default,,0,0,0,,Бірақ мүмкін
Dialogue: 0,0:03:18.66,0:03:21.16,Default,,0,0,0,,Dr. Fields сізге құпия сөз туралы анықтама береді
Dialogue: 0,0:03:21.25,0:03:22.75,Default,,0,0,0,,Мүмкін сіз бірдеңе білетін шығарсыз
Dialogue: 0,0:03:23.62,0:03:26.33,Default,,0,0,0,,Әкем мен шешем алдымен үйге қайтты.
Dialogue: 0,0:03:26.41,0:03:27.16,Default,,0,0,0,,(A37) Сара ше?
Dialogue: 0,0:03:28.00,0:03:29.20,Default,,0,0,0,,Бұдан былай I
Dialogue: 0,0:03:29.29,0:03:32.20,Default,,0,0,0,,Мен тағы да Эденслиге басып кіруді ойлап жүрмін.
Dialogue: 0,0:03:32.29,0:03:33.91,Default,,0,0,0,,(E92) Жоқ, мүлдем жоқ!
Dialogue: 0,0:03:34.00,0:03:37.33,Default,,0,0,0,,Мен тағы да осында мені шақырған AI-мен кездестім.
Dialogue: 0,0:03:37.41,0:03:39.16,Default,,0,0,0,,Толығырақ білгім келеді!
Dialogue: 0,0:03:39.25,0:03:41.16,Default,,0,0,0,,(E92) Қауіпті! Сосын мен барамын
Dialogue: 0,0:03:41.25,0:03:42.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:43.00,0:03:43.91,Default,,0,0,0,,(E92) Сара қашып кетті
Dialogue: 0,0:03:44.00,0:03:46.41,Default,,0,0,0,,Эй... Эй!
Dialogue: 0,0:03:46.50,0:03:47.70,Default,,0,0,0,,Уф...!
Dialogue: 0,0:03:47.79,0:03:50.66,Default,,0,0,0,,Сенің әкең әлі қауіпті емес пе?
Dialogue: 0,0:03:50.75,0:03:53.00,Default,,0,0,0,,Адамды өсірген робот
Dialogue: 0,0:03:53.12,0:03:55.33,Default,,0,0,0,,Егер табылса, сіз қайта бағдарламаланасыз!
Dialogue: 0,0:03:55.41,0:03:58.16,Default,,0,0,0,,(E92) Мүлде рұқсат етілмейді Сара қауіпті
Dialogue: 0,0:03:58.25,0:03:59.62,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:03:59.70,0:04:01.54,Default,,0,0,0,,(E92) Егер ол жұмыс істемесе, ол жұмыс істемейді
Dialogue: 0,0:04:01.62,0:04:03.91,Default,,0,0,0,,Хмм...! Тас бас!
Dialogue: 0,0:04:04.75,0:04:05.83,Default,,0,0,0,,(E92) Тас басы?
Dialogue: 0,0:04:05.91,0:04:06.62,Default,,0,0,0,,(A37) Сәлем
Dialogue: 0,0:04:06.70,0:04:09.33,Default,,0,0,0,,Менің әкем сияқты ой-өрісі күшті адам туралы.
Dialogue: 0,0:04:09.41,0:04:11.58,Default,,0,0,0,,Оны тас бас дейді.
Dialogue: 0,0:04:11.66,0:04:13.70,Default,,0,0,0,,Бұл ескі адам кітабында жазылған.
Dialogue: 0,0:04:13.79,0:04:17.79,Default,,0,0,0,,(E92) Мен келісемін, робот басы тастан да қатты.
Dialogue: 0,0:04:17.87,0:04:20.91,Default,,0,0,0,,(A37) Эй, биоэнергияға айналмайтын дәндер ше?
Dialogue: 0,0:04:21.00,0:04:23.16,Default,,0,0,0,,Қажетті болмыс дегеніміз не?
Dialogue: 0,0:04:23.83,0:04:24.91,Default,,0,0,0,,(Сара Е92) Иә?
Dialogue: 0,0:04:25.00,0:04:26.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.25,0:04:32.95,Default,,0,0,0,,(A37) Мен бұл ұшақтың бар екенін білдім, бірақ еш жерде ақпарат жоқ еді.
Dialogue: 0,0:04:33.04,0:04:36.79,Default,,0,0,0,,Әуе кемесінің Эденслиде жасалмағанының ықтималдығы жоғары.
Dialogue: 0,0:04:36.87,0:04:38.91,Default,,0,0,0,,Сонда оны кім жасады?
Dialogue: 0,0:04:40.04,0:04:42.91,Default,,0,0,0,,Астықты қайда жинамақсың?
Dialogue: 0,0:04:43.91,0:04:47.08,Default,,0,0,0,,Астықты қажет ететін тіршілік...
Dialogue: 0,0:04:47.16,0:04:49.16,Default,,0,0,0,,Мүмкін адам шығар?
Dialogue: 0,0:04:51.37,0:04:52.33,Default,,0,0,0,,Уау...!
Dialogue: 0,0:04:52.95,0:04:54.20,Default,,0,0,0,,Ахах...!
Dialogue: 0,0:04:55.79,0:04:56.75,Default,,0,0,0,,Аха!
Dialogue: 0,0:05:02.00,0:05:05.66,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:05:12.37,0:05:13.29,Default,,0,0,0,,Ой...!
Dialogue: 0,0:05:13.37,0:05:14.66,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:14.75,0:05:15.95,Default,,0,0,0,,Hmph
Dialogue: 0,0:05:17.83,0:05:20.91,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:05:21.58,0:05:25.04,Default,,0,0,0,,Өйткені, сіз адаммен бірінші рет кездесе аласыз.
Dialogue: 0,0:05:25.12,0:05:26.70,Default,,0,0,0,,Эй, мен біртүрлі емеспін бе?
Dialogue: 0,0:05:26.79,0:05:28.00,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:05:28.54,0:05:31.66,Default,,0,0,0,,(E92) Адамдардың әлі де бар екендігі шешілмеді.
Dialogue: 0,0:05:31.75,0:05:34.83,Default,,0,0,0,,Доктор Филдстің болу ықтималдығы нөлге тең емес.
Dialogue: 0,0:05:34.91,0:05:35.87,Default,,0,0,0,,Уфуфу!
Dialogue: 0,0:05:35.95,0:05:38.00,Default,,0,0,0,,Сізбен кездессем не істеуім керек?
Dialogue: 0,0:05:38.12,0:05:39.95,Default,,0,0,0,,(A37) Сіз құпия сөз іздеп жатырсыз, солай емес пе?
Dialogue: 0,0:05:40.04,0:05:40.91,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:41.00,0:05:45.08,Default,,0,0,0,,Бірақ сенің бұл дүниеде әрқашан жалғыз болғаныңа сенімдімін.
Dialogue: 0,0:05:45.16,0:05:48.08,Default,,0,0,0,,Доктор Филдс, егер сіз менімен кездесе алсаңыз, болды.
Dialogue: 0,0:05:48.16,0:05:51.16,Default,,0,0,0,,Мен өзімді шынымен бақытты сезінемін!
Dialogue: 0,0:05:51.25,0:05:53.45,Default,,0,0,0,,(күлді)
Dialogue: 0,0:06:05.16,0:06:08.12,Default,,0,0,0,,(Женева) Нөл Барлау бөлімінен алынған ақпарат.
Dialogue: 0,0:06:08.20,0:06:09.66,Default,,0,0,0,,Адамды тапты
Dialogue: 0,0:06:10.45,0:06:11.45,Default,,0,0,0,,Орналасқан жері қандай?
Dialogue: 0,0:06:13.16,0:06:14.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:14.25,0:06:15.66,Default,,0,0,0,,(Женева) Орналасқан жерді анықтау мүмкін емес
Dialogue: 0,0:06:16.29,0:06:17.16,Default,,0,0,0,,Не?
Dialogue: 0,0:06:17.87,0:06:20.75,Default,,0,0,0,,(Женева) Сәйкес келетін орын ақпараты жоқ
Dialogue: 0,0:06:20.83,0:06:22.16,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:22.25,0:06:24.54,Default,,0,0,0,,(Женева) Бұл дүниеде жоқ жер
Dialogue: 0,0:06:24.62,0:06:29.16,Default,,0,0,0,,Немесе ақпаратыңызды біреу өшірген орын.
Dialogue: 0,0:06:29.25,0:06:31.66,Default,,0,0,0,,Eden One-ның AI оны өшірді ме?
Dialogue: 0,0:06:31.75,0:06:36.66,Default,,0,0,0,,(Женева) Біз АИ-лер ақпаратты өзіміз өшіре алмаймыз.
Dialogue: 0,0:06:36.75,0:06:41.54,Default,,0,0,0,,Ақпарат адамдардың бұйрығымен жойылған болуы мүмкін.
Dialogue: 0,0:06:42.75,0:06:44.41,Default,,0,0,0,,Адам...?
Dialogue: 0,0:06:44.50,0:06:49.91,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:06:51.70,0:06:52.91,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:07:10.87,0:07:14.16,Default,,0,0,0,,(A37) Мүмкін емес. Мұндай басқарылмайтын зауыт.
Dialogue: 0,0:07:14.79,0:07:18.45,Default,,0,0,0,,(E92) Хмм... Зиянды органикалық заттарды растау және жою
Dialogue: 0,0:07:23.12,0:07:23.91,Default,,0,0,0,,Үй
Dialogue: 0,0:07:24.87,0:07:25.79,Default,,0,0,0,,(A37) Үй?
Dialogue: 0,0:07:26.54,0:07:30.37,Default,,0,0,0,,Адамдар «отбасы» деп аталатын бірлік құрайтын және бірге тұратын жер.
Dialogue: 0,0:07:30.45,0:07:33.45,Default,,0,0,0,,(E92) Аа, мен оны фильмнен көрдім.
Dialogue: 0,0:07:33.54,0:07:34.45,Default,,0,0,0,,Аха!
Dialogue: 0,0:07:34.54,0:07:36.41,Default,,0,0,0,,Онда біреу тұратын шығар (A37) Сара
Dialogue: 0,0:07:39.08,0:07:39.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:41.87,0:07:42.79,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:42.87,0:07:45.91,Default,,0,0,0,,«Эдем-нөл»
Dialogue: 0,0:07:46.00,0:07:47.16,Default,,0,0,0,,Эдем... Нөл...?
Dialogue: 0,0:07:58.58,0:07:59.16,Default,,0,0,0,,Не?
Dialogue: 0,0:08:02.70,0:08:04.50,Default,,0,0,0,,(E92) Бұл қай жер?
Dialogue: 0,0:08:04.58,0:08:06.16,Default,,0,0,0,,(A37) Үйілген қоқыс.
Dialogue: 0,0:08:06.87,0:08:07.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:09.25,0:08:10.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.25,0:08:13.66,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:08:19.00,0:08:20.33,Default,,0,0,0,,Уау
Dialogue: 0,0:08:21.16,0:08:21.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:25.50,0:08:27.29,Default,,0,0,0,,Доктор Филдс!
Dialogue: 0,0:08:27.91,0:08:29.37,Default,,0,0,0,,(E92) Солай ма?
Dialogue: 0,0:08:29.45,0:08:32.91,Default,,0,0,0,,Eden One-ның AI маған көрсеткен бет.
Dialogue: 0,0:08:34.37,0:08:39.16,Default,,0,0,0,,Суық ұйқыдан оянсам, Дүние ғажайып жер екен.
Dialogue: 0,0:08:39.79,0:08:43.95,Default,,0,0,0,,Табиғаты мол... Алма көп болды.
Dialogue: 0,0:08:44.45,0:08:46.54,Default,,0,0,0,,Eden жобасы сәтті болды
Dialogue: 0,0:08:47.95,0:08:51.04,Default,,0,0,0,,Ойлап қарасам, көп уақыттан кейін қайтып келгенімде...
Dialogue: 0,0:08:51.12,0:08:52.41,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:08:52.50,0:08:56.16,Default,,0,0,0,,Эмили Лиздің көптеген сүйікті заттарын жинады.
Dialogue: 0,0:08:57.33,0:08:58.87,Default,,0,0,0,,Жүздеген жылдар.
Dialogue: 0,0:08:58.95,0:08:59.95,Default,,0,0,0,,(мұңды күлкі)
Dialogue: 0,0:09:00.75,0:09:01.83,Default,,0,0,0,,(сусын)
Dialogue: 0,0:09:03.16,0:09:05.62,Default,,0,0,0,,Эшли... Лиз...
Dialogue: 0,0:09:05.70,0:09:08.16,Default,,0,0,0,,Мен саған осы дүниені көрсеткім келді.
Dialogue: 0,0:09:09.00,0:09:09.91,Default,,0,0,0,,(E92) Хмм...?
Dialogue: 0,0:09:10.00,0:09:13.66,Default,,0,0,0,,(E92) Бұл ақпарат 400 жаста.
Dialogue: 0,0:09:13.75,0:09:16.16,Default,,0,0,0,,Не? Міне бітті…!
Dialogue: 0,0:09:16.25,0:09:17.41,Default,,0,0,0,,(жылау)
Dialogue: 0,0:09:17.95,0:09:19.12,Default,,0,0,0,,Ах...!
Dialogue: 0,0:09:19.20,0:09:20.20,Default,,0,0,0,,(металл дыбыс)
Dialogue: 0,0:09:24.00,0:09:25.04,Default,,0,0,0,,(электрондық дыбыс)
Dialogue: 0,0:09:25.12,0:09:28.08,Default,,0,0,0,,(E92) Батарея бітті ме? Оны жақсы зарядтаңыз.
Dialogue: 0,0:09:29.58,0:09:30.16,Default,,0,0,0,,(A37) Сара?
Dialogue: 0,0:09:31.58,0:09:36.08,Default,,0,0,0,,400 жыл бұрын оянсаңыз, сіз әлдеқашан өлгенсіз.
Dialogue: 0,0:09:36.75,0:09:38.66,Default,,0,0,0,,Мен адамды кездестіремін деп ойладым...
Dialogue: 0,0:09:39.33,0:09:41.16,Default,,0,0,0,,Құпия сөзді тапсаңыз, кездесуге болады.
Dialogue: 0,0:09:42.79,0:09:43.75,Default,,0,0,0,,Ана...
Dialogue: 0,0:09:44.25,0:09:47.45,Default,,0,0,0,,(A37) Берілме, біз сенімен біргеміз.
Dialogue: 0,0:09:47.54,0:09:49.54,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:09:49.62,0:09:51.00,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:09:51.08,0:09:51.66,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.25,0:09:53.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:53.75,0:09:54.83,Default,,0,0,0,,Ах...!
Dialogue: 0,0:09:55.62,0:09:57.91,Default,,0,0,0,,‪（Ａ37･Ｅ92）～
Dialogue: 0,0:09:58.00,0:09:59.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:59.79,0:10:02.70,Default,,0,0,0,,Сіз не істеп жатырсыз? Жіберу!
Dialogue: 0,0:10:07.79,0:10:09.16,Default,,0,0,0,,Бұл! Жіберу!
Dialogue: 0,0:10:09.25,0:10:10.54,Default,,0,0,0,,Не?
Dialogue: 0,0:10:13.00,0:10:15.91,Default,,0,0,0,,(есептегіштің төмендеу дыбысы)
Dialogue: 0,0:10:25.16,0:10:26.91,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:10:29.20,0:10:30.25,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:10:30.75,0:10:31.91,Default,,0,0,0,,(шығарылған дауыс)
Dialogue: 0,0:10:32.58,0:10:34.45,Default,,0,0,0,,PJ! әке ана
Dialogue: 0,0:10:34.54,0:10:36.66,Default,,0,0,0,,Амансың ба? Сынған жоқ па?
Dialogue: 0,0:10:36.75,0:10:39.66,Default,,0,0,0,,(E92) Бізде бәрі жақсы. Сара ше?
Dialogue: 0,0:10:39.75,0:10:40.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:43.45,0:10:44.58,Default,,0,0,0,,(E92) Нөл…
Dialogue: 0,0:10:44.66,0:10:45.66,Default,,0,0,0,,Нөл...?
Dialogue: 0,0:10:46.29,0:10:48.25,Default,,0,0,0,,(E92) Бұл Эденслидің бастығы.
Dialogue: 0,0:10:49.50,0:10:52.12,Default,,0,0,0,,Адамдар шынымен өмір сүрді ме?
Dialogue: 0,0:10:52.62,0:10:54.83,Default,,0,0,0,,(A37) Адамдар зиянды емес!
Dialogue: 0,0:10:54.91,0:10:56.66,Default,,0,0,0,,(E92) Сара өте жақсы адам.
Dialogue: 0,0:10:57.79,0:11:01.66,Default,,0,0,0,,Адамдар – әлемді бұзатын зұлым тіршілік иелері.
Dialogue: 0,0:11:01.75,0:11:02.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:02.91,0:11:06.37,Default,,0,0,0,,Сара бізге үлкен қамқорлық жасайды!
Dialogue: 0,0:11:06.45,0:11:10.87,Default,,0,0,0,,Сара мен үшін де өте маңызды! Мен қорғағым келетін тіршілік
Dialogue: 0,0:11:10.95,0:11:14.04,Default,,0,0,0,,(E92) Тіпті Сара кейбір нәрселерді бұзады.
Dialogue: 0,0:11:14.12,0:11:17.16,Default,,0,0,0,,Адамдар әртүрлі заттарды жасай алады.
Dialogue: 0,0:11:17.25,0:11:19.45,Default,,0,0,0,,(A37) Ал адамдар күледі.
Dialogue: 0,0:11:19.54,0:11:22.16,Default,,0,0,0,,Өсімдік өсірсең де күлмейді, солай ма?
Dialogue: 0,0:11:22.25,0:11:25.79,Default,,0,0,0,,Сараның күлкісін мәңгі естігім келеді.
Dialogue: 0,0:11:25.87,0:11:26.91,Default,,0,0,0,,(E92) Мен келісемін
Dialogue: 0,0:11:27.00,0:11:29.41,Default,,0,0,0,,Өтінемін, Сараны алып кетпеңіз.
Dialogue: 0,0:11:29.50,0:11:32.41,Default,,0,0,0,,(A37) Өтінемін! Оны алып кетпе!
Dialogue: 0,0:11:32.50,0:11:33.66,Default,,0,0,0,,(E92) Өтінемін
Dialogue: 0,0:11:34.20,0:11:36.41,Default,,0,0,0,,Әкесі… Анасы…
Dialogue: 0,0:11:36.95,0:11:40.25,Default,,0,0,0,,Нағыз адамдардың қандай болатынын білмейсің.
Dialogue: 0,0:11:41.00,0:11:43.41,Default,,0,0,0,,Адам болған кезде сұмдық дүние еді.
Dialogue: 0,0:11:47.54,0:11:51.08,Default,,0,0,0,,Біз роботтар ғана бар әлемге қараңыз.
Dialogue: 0,0:11:51.83,0:11:54.41,Default,,0,0,0,,Табиғатқа толы мінсіз дүние.
Dialogue: 0,0:11:57.00,0:11:58.58,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:11:58.66,0:12:01.45,Default,,0,0,0,,(Панк 1) Дұрыс! Сара бізді түзетеді
Dialogue: 0,0:12:01.54,0:12:03.16,Default,,0,0,0,,(Пункоцу 2) Сара жаман адам емес.
Dialogue: 0,0:12:03.25,0:12:04.45,Default,,0,0,0,,‪（Ａ37）
Dialogue: 0,0:12:04.54,0:12:06.16,Default,,0,0,0,,(E92) Мен Сарамен бірге болғым келеді.
Dialogue: 0,0:12:06.25,0:12:08.66,Default,,0,0,0,,‪
Dialogue: 0,0:12:08.75,0:12:10.16,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:12:10.25,0:12:13.08,Default,,0,0,0,,‪
Dialogue: 0,0:12:13.16,0:12:16.33,Default,,0,0,0,,Барлығын қайта бағдарламалау қажет.
Dialogue: 0,0:12:16.41,0:12:18.16,Default,,0,0,0,,Дұрыс пайымдау...
Dialogue: 0,0:12:18.25,0:12:21.04,Default,,0,0,0,,‪
Dialogue: 0,0:12:21.12,0:12:21.91,Default,,0,0,0,,(тынығу)
Dialogue: 0,0:12:22.00,0:12:23.58,Default,,0,0,0,,Жою
Dialogue: 0,0:12:24.50,0:12:25.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:27.75,0:12:30.79,Default,,0,0,0,,Көтерілісші ұшақтарды дереу қайта бағдарламалау керек
Dialogue: 0,0:12:30.87,0:12:32.41,Default,,0,0,0,,‪
Dialogue: 0,0:12:33.04,0:12:35.16,Default,,0,0,0,,(Қашып бара жатқан дауыс)
Dialogue: 0,0:12:35.25,0:12:37.33,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:38.45,0:12:39.91,Default,,0,0,0,,(A37) Тоқтатыңыз (E92) Тоқтатыңыз
Dialogue: 0,0:12:40.50,0:12:42.16,Default,,0,0,0,,‪
Dialogue: 0,0:12:43.54,0:12:45.41,Default,,0,0,0,,‪（Ａ37･Ｅ92）～
Dialogue: 0,0:12:46.20,0:12:47.41,Default,,0,0,0,,Ах...!
Dialogue: 0,0:12:47.50,0:12:48.83,Default,,0,0,0,,(айқай)
Dialogue: 0,0:12:48.91,0:12:52.37,Default,,0,0,0,,‪（Ｅ92）  …
Dialogue: 0,0:12:52.45,0:12:53.45,Default,,0,0,0,,Сара…
Dialogue: 0,0:12:53.54,0:12:55.91,Default,,0,0,0,,Әкесі… Анасы…
Dialogue: 0,0:12:56.00,0:12:56.91,Default,,0,0,0,,(A37) А...
Dialogue: 0,0:12:57.00,0:12:59.04,Default,,0,0,0,,‪（Ａ37･Ｅ92）… …
Dialogue: 0,0:13:00.45,0:13:01.37,Default,,0,0,0,,(A37) Сара!
Dialogue: 0,0:13:02.04,0:13:02.95,Default,,0,0,0,,Сара!
Dialogue: 0,0:13:03.50,0:13:05.91,Default,,0,0,0,,Қаш... се...
Dialogue: 0,0:13:06.00,0:13:09.91,Default,,0,0,0,,(E92) Қауіпті... Болмаңыз... Келісіңіз... Істеңіз...
Dialogue: 0,0:13:10.87,0:13:13.91,Default,,0,0,0,,Күл… Бұл қызық…
Dialogue: 0,0:13:14.54,0:13:16.75,Default,,0,0,0,,(A37) Мен білмеймін... білмеймін...
Dialogue: 0,0:13:16.83,0:13:20.66,Default,,0,0,0,,Эде…Үш…Мен қаламаймын…Мен…
Dialogue: 0,0:13:22.00,0:13:24.16,Default,,0,0,0,,Тоқта! Жіберу!
Dialogue: 0,0:13:24.25,0:13:25.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:25.91,0:13:27.58,Default,,0,0,0,,(шығарылған дауыс)
Dialogue: 0,0:13:28.12,0:13:30.66,Default,,0,0,0,,Сара...күлімсіреп...
Dialogue: 0,0:13:30.75,0:13:31.91,Default,,0,0,0,,Не? (E92) Сара...
Dialogue: 0,0:13:32.87,0:13:35.50,Default,,0,0,0,,Би... көңіл көтеру...
Dialogue: 0,0:13:35.58,0:13:36.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.25,0:13:39.66,Default,,0,0,0,,(E92) Сара... 5 жыл 3 ай...
Dialogue: 0,0:13:39.75,0:13:42.37,Default,,0,0,0,,Биіктігі 107,8…
Dialogue: 0,0:13:42.95,0:13:46.75,Default,,0,0,0,,5 жыл 9 ай… 108,4…
Dialogue: 0,0:13:46.83,0:13:50.50,Default,,0,0,0,,6 жыл 2 ай… 109,5…
Dialogue: 0,0:13:50.58,0:13:53.91,Default,,0,0,0,,Сара... жақсы қыз... зиянды емес...
Dialogue: 0,0:13:54.00,0:13:54.66,Default,,0,0,0,,(шығарылған дауыс)
Dialogue: 0,0:13:54.75,0:13:56.41,Default,,0,0,0,,(E92) Есеп беру... Міндеттеме...
Dialogue: 0,0:13:57.04,0:13:58.91,Default,,0,0,0,,Бұл... топырақ...
Dialogue: 0,0:13:59.00,0:14:00.91,Default,,0,0,0,,Бұл... жапырақ...
Dialogue: 0,0:14:01.00,0:14:03.91,Default,,0,0,0,,(A37) Бұл... әке! ана!
Dialogue: 0,0:14:04.83,0:14:08.66,Default,,0,0,0,,Сара... Сара... жымиды...
Dialogue: 0,0:14:09.12,0:14:10.25,Default,,0,0,0,,Ой... аа!
Dialogue: 0,0:14:10.33,0:14:12.00,Default,,0,0,0,,А... аа!
Dialogue: 0,0:14:12.08,0:14:16.41,Default,,0,0,0,,(E92) Хён Хён Хён Хуин...
Dialogue: 0,0:14:16.50,0:14:17.66,Default,,0,0,0,,(жылау)
Dialogue: 0,0:14:17.75,0:14:19.41,Default,,0,0,0,,Хён хён хён хуун...
Dialogue: 0,0:14:19.50,0:14:23.41,Default,,0,0,0,,Уау... те... ва... ра...
Dialogue: 0,0:14:25.00,0:14:26.70,Default,,0,0,0,,Ух... (A37) Мен... ра...
Dialogue: 0,0:14:29.58,0:14:31.66,Default,,0,0,0,,Ммм… мм…
Dialogue: 0,0:14:32.33,0:14:33.29,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:34.50,0:14:36.33,Default,,0,0,0,,(E92) Па… Па…
Dialogue: 0,0:14:37.04,0:14:38.66,Default,,0,0,0,,(A37) Маа... Маа...
Dialogue: 0,0:14:39.83,0:14:41.79,Default,,0,0,0,,(E92) Sa... La...
Dialogue: 0,0:14:42.41,0:14:44.29,Default,,0,0,0,,(A37) Sa... La...
Dialogue: 0,0:14:47.37,0:14:49.45,Default,,0,0,0,,(Өшіру дыбысы)
Dialogue: 0,0:14:52.70,0:14:54.75,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:14:55.91,0:14:58.66,Default,,0,0,0,,Ана… Әке…
Dialogue: 0,0:15:00.16,0:15:02.00,Default,,0,0,0,,Анашым!
Dialogue: 0,0:15:02.08,0:15:04.66,Default,,0,0,0,,Әке!
Dialogue: 0,0:15:04.75,0:15:05.62,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:15:09.04,0:15:10.91,Default,,0,0,0,,(Іске қосу дыбысы)
Dialogue: 0,0:15:12.29,0:15:13.20,Default,,0,0,0,,(E92) Пико...
Dialogue: 0,0:15:13.70,0:15:14.83,Default,,0,0,0,,(A37) Пико...
Dialogue: 0,0:15:15.33,0:15:16.25,Default,,0,0,0,,(E92) Пико...
Dialogue: 0,0:15:16.75,0:15:17.66,Default,,0,0,0,,(A37) Пико...
Dialogue: 0,0:15:18.33,0:15:19.29,Default,,0,0,0,,(E92) Пико...
Dialogue: 0,0:15:19.75,0:15:20.66,Default,,0,0,0,,(A37) Пико...
Dialogue: 0,0:15:21.70,0:15:22.58,Default,,0,0,0,,Ой...!
Dialogue: 0,0:15:23.54,0:15:24.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:28.75,0:15:33.41,Default,,0,0,0,,Сіз не істеп жатырсыз? Ұшақты алып, адамдарды жойыңыз.
Dialogue: 0,0:15:37.95,0:15:38.95,Default,,0,0,0,,Ұстамаңыз...
Dialogue: 0,0:15:40.50,0:15:41.79,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:15:45.00,0:15:46.91,Default,,0,0,0,,Мен саған тиіспе дедім ғой!
Dialogue: 0,0:15:48.12,0:15:50.16,Default,,0,0,0,,Қарғыс атсын! Даа!
Dialogue: 0,0:15:51.75,0:15:52.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:54.20,0:15:54.91,Default,,0,0,0,,Уау
Dialogue: 0,0:15:57.75,0:15:59.16,Default,,0,0,0,,Дааа!
Dialogue: 0,0:15:59.79,0:16:01.79,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:16:02.75,0:16:03.83,Default,,0,0,0,,Дааааа!
Dialogue: 0,0:16:09.00,0:16:10.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:11.58,0:16:13.16,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:16:14.04,0:16:15.00,Default,,0,0,0,,(тынығу)
Dialogue: 0,0:16:24.33,0:16:25.33,Default,,0,0,0,,(тынығу)
Dialogue: 0,0:16:25.75,0:16:26.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.75,0:16:36.41,Default,,0,0,0,,Қараңызшы, бұл зорлық-зомбылық адамға тән.
Dialogue: 0,0:16:37.20,0:16:39.25,Default,,0,0,0,,Адамдар зұлым
Dialogue: 0,0:16:40.04,0:16:40.91,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:42.04,0:16:43.16,Default,,0,0,0,,(роботтың абдырап қалған дауысы) Жоқ?
Dialogue: 0,0:16:43.62,0:16:44.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:44.87,0:16:47.16,Default,,0,0,0,,Ах...! Жіберу...!
Dialogue: 0,0:16:47.25,0:16:50.04,Default,,0,0,0,,Тоқта! Жіберу!
Dialogue: 0,0:16:50.12,0:16:51.16,Default,,0,0,0,,Уф
Dialogue: 0,0:16:51.25,0:16:53.41,Default,,0,0,0,,Өтінемін! маған көмектесші!
Dialogue: 0,0:16:54.16,0:16:55.16,Default,,0,0,0,,‪ＰＪ！
Dialogue: 0,0:16:55.25,0:16:57.16,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:16:59.25,0:17:01.91,Default,,0,0,0,,(Қашып бара жатқан дауыс)
Dialogue: 0,0:17:02.00,0:17:04.91,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:17:05.00,0:17:06.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.20,0:17:08.20,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:17:13.00,0:17:14.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:15.33,0:17:16.41,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:17.20,0:17:19.91,Default,,0,0,0,,Адамдарға көмектесетін роботтар жоқ.
Dialogue: 0,0:17:23.66,0:17:27.20,Default,,0,0,0,,Адамдар роботтардың пайымдауын бұзады
Dialogue: 0,0:17:27.29,0:17:29.16,Default,,0,0,0,,Қауіпті және зиянды органикалық заттар
Dialogue: 0,0:17:30.66,0:17:32.16,Default,,0,0,0,,Сондықтан алып тастаңыз
Dialogue: 0,0:17:42.58,0:17:43.16,Default,,0,0,0,,Ах...!
Dialogue: 0,0:17:43.87,0:17:44.91,Default,,0,0,0,,Ахх...!
Dialogue: 0,0:17:46.25,0:17:47.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:47.75,0:17:49.33,Default,,0,0,0,,Уау! Уф...!
Dialogue: 0,0:17:49.41,0:17:50.41,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:50.50,0:17:52.66,Default,,0,0,0,,Ух... а... а!
Dialogue: 0,0:17:52.75,0:17:54.29,Default,,0,0,0,,Неліктен-
Dialogue: 0,0:17:54.37,0:17:56.66,Default,,0,0,0,,Сен адамдарды сондай жек көресің!
Dialogue: 0,0:17:58.41,0:18:03.16,Default,,0,0,0,,Өйткені адамдар кемел дүние жасау жолында.
Dialogue: 0,0:18:05.04,0:18:05.91,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:06.00,0:18:07.58,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:07.66,0:18:08.66,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:09.08,0:18:10.91,Default,,0,0,0,,Уф, жоқ!
Dialogue: 0,0:18:11.00,0:18:11.91,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:18:12.00,0:18:14.20,Default,,0,0,0,,Гах...! Алақай!
Dialogue: 0,0:18:14.87,0:18:16.66,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:18:16.75,0:18:18.25,Default,,0,0,0,,Ой...
Dialogue: 0,0:18:18.79,0:18:19.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:20.70,0:18:22.16,Default,,0,0,0,,(S566) Тез қаш, Сара!
Dialogue: 0,0:18:22.25,0:18:24.08,Default,,0,0,0,,Әй... Джон ағай?
Dialogue: 0,0:18:24.16,0:18:25.16,Default,,0,0,0,,(S566) Барыңыз!
Dialogue: 0,0:18:26.08,0:18:28.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:34.50,0:18:40.25,Default,,0,0,0,,(жылау)
Dialogue: 0,0:18:43.37,0:18:46.00,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:49.62,0:18:50.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:52.58,0:18:54.45,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:55.00,0:18:56.04,Default,,0,0,0,,Ах...!
Dialogue: 0,0:18:58.04,0:18:59.12,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:18:59.20,0:19:04.41,Default,,0,0,0,,(жылау)
Dialogue: 0,0:19:09.04,0:19:11.79,Default,,0,0,0,,(жылау)
Dialogue: 0,0:19:12.87,0:19:16.41,Default,,0,0,0,,(Сесептегіштің төмендеу дыбысы)
Dialogue: 0,0:19:55.66,0:19:58.75,Default,,0,0,0,,(робот тілі)
Dialogue: 0,0:19:59.29,0:20:01.41,Default,,0,0,0,,Сіз қашып жатқан жоқсыз, солай ма?
Dialogue: 0,0:20:04.04,0:20:05.75,Default,,0,0,0,,Адамдар зұлым болса...
Dialogue: 0,0:20:06.33,0:20:09.75,Default,,0,0,0,,Көп зұлымдықтар суық ұйқыда ұйықтап жатыр...
Dialogue: 0,0:20:10.66,0:20:13.33,Default,,0,0,0,,Мүмкін оны оятпаған дұрыс шығар...
Dialogue: 0,0:20:14.20,0:20:15.08,Default,,0,0,0,,Уф...!
Dialogue: 0,0:20:19.33,0:20:20.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:26.50,0:20:27.41,Default,,0,0,0,,Ах...!
Dialogue: 0,0:20:34.29,0:20:36.41,Default,,0,0,0,,Дәрігер… Филдтер…
Dialogue: 0,0:20:37.91,0:20:39.12,Default,,0,0,0,,Цюрих…
Dialogue: 0,0:20:40.37,0:20:42.91,Default,,0,0,0,,(Цюрих) Не болды?
Dialogue: 0,0:20:44.00,0:20:46.29,Default,,0,0,0,,Сіз портқа дайынсыз ба?
Dialogue: 0,0:20:46.91,0:20:50.16,Default,,0,0,0,,(Цюрих) Сіз әрқашан Eden One-ға келе аласыз.
Dialogue: 0,0:20:51.83,0:20:53.70,Default,,0,0,0,,(Доктор Филдс) Ол ертең орындалады.
Dialogue: 0,0:20:54.58,0:20:55.83,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:20:56.70,0:20:57.54,Default,,0,0,0,,Ах...!
Dialogue: 0,0:20:57.62,0:20:59.66,Default,,0,0,0,,(Цюрих) Түсіндім, доктор Филдс.
Dialogue: 0,0:21:00.41,0:21:02.75,Default,,0,0,0,,Бұл атау бүгін аяқталады.
Dialogue: 0,0:21:03.50,0:21:07.25,Default,,0,0,0,,Менің нейрондық желіні роботқа ауыстырған кезде...
Dialogue: 0,0:21:07.33,0:21:10.70,Default,,0,0,0,,Доктор Филдс туралы барлық естеліктерді өшіріңіз.
Dialogue: 0,0:21:11.66,0:21:12.25,Default,,0,0,0,,(Цюрих) Сіз барлық естеліктерді өшіре алмайсыз.
Dialogue: 0,0:21:12.25,0:21:14.25,Default,,0,0,0,,(Цюрих) Сіз барлық естеліктерді өшіре алмайсыз.
Dialogue: 0,0:21:12.25,0:21:14.25,Default,,0,0,0,,«Цюрих»
Dialogue: 0,0:21:14.25,0:21:15.08,Default,,0,0,0,,«Цюрих»
Dialogue: 0,0:21:15.16,0:21:20.16,Default,,0,0,0,,Жад тізбегін блоктауға және оны шифрлауға және пломбалауға болады.
Dialogue: 0,0:21:20.25,0:21:21.95,Default,,0,0,0,,(Доктор Филдс) Бәрі жақсы.
Dialogue: 0,0:21:22.58,0:21:26.66,Default,,0,0,0,,Менің бар тіршілігімді із-түзсіз өшіре алсаң, жақсы.
Dialogue: 0,0:21:27.58,0:21:29.83,Default,,0,0,0,,(Цюрих) Сізге бір сұрақ қойсам болады ма?
Dialogue: 0,0:21:30.83,0:21:32.16,Default,,0,0,0,,(Доктор Филдс) Не?
Dialogue: 0,0:21:32.25,0:21:33.41,Default,,0,0,0,,«Цюрих»
Dialogue: 0,0:21:33.41,0:21:35.41,Default,,0,0,0,,«Цюрих»
Dialogue: 0,0:21:33.41,0:21:35.41,Default,,0,0,0,,(Цюрих) Неге жоғалып кеткіңіз келеді?
Dialogue: 0,0:21:51.29,0:21:54.16,Default,,0,0,0,,Кемелді әлем құру -
Dialogue: 0,0:21:54.70,0:21:56.66,Default,,0,0,0,,Өйткені адам кедергі.
Dialogue: 0,0:21:57.58,0:21:58.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:59.33,0:22:02.70,Default,,0,0,0,,(Цюрих) Ендеше ертеңнен бастап сені қалай атайын?
Dialogue: 0,0:22:06.87,0:22:07.91,Default,,0,0,0,,Нөл…
Dialogue: 0,0:22:08.25,0:22:11.04,Default,,0,0,0,,(есептегіштің төмендеу дыбысы)
Dialogue: 0,0:22:11.12,0:22:12.83,Default,,0,0,0,,(қарсы тоқтату дыбысы)
Dialogue: 0,0:22:17.08,0:22:20.08,Default,,0,0,0,,‪♪～
Dialogue: 0,0:24:27.83,0:24:30.83,Default,,0,0,0,,‪～♪
