Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.96,0:00:02.79,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:07.84,0:00:09.55,Default,,0,0,0,,Өкінішке орай, мен көмектесе алмаймын. Кешіріңіз.
Dialogue: 0,0:00:11.01,0:00:13.22,Default,,0,0,0,,Ал тым қараңғы
Dialogue: 0,0:00:13.30,0:00:17.26,Default,,0,0,0,,Не істеп жатырсың! Ғимараттың ішінде күзетші жоқ.
Dialogue: 0,0:00:17.35,0:00:18.18,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:00:18.26,0:00:19.47,Default,,0,0,0,,Бірақ
Dialogue: 0,0:00:19.56,0:00:22.18,Default,,0,0,0,,Мен сізге Иэл мырзаны іздеуді бәрінен жоғары қоюды айттым.
Dialogue: 0,0:00:22.27,0:00:23.48,Default,,0,0,0,,Сіз кураторсыз, солай ма?
Dialogue: 0,0:00:23.56,0:00:24.40,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:24.48,0:00:27.06,Default,,0,0,0,,Мұндағы қауіпсіздік басқа, ақымақ!
Dialogue: 0,0:00:27.15,0:00:28.15,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:00:28.23,0:00:29.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:00:29.61,0:00:31.11,Default,,0,0,0,,Мен қазір қайтамын
Dialogue: 0,0:00:31.19,0:00:33.86,Default,,0,0,0,,Біз келгенше қауіпсіздікті қамтамасыз етіңіз.
Dialogue: 0,0:00:33.95,0:00:35.03,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:33.95,0:00:35.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:35.11,0:00:36.12,Default,,0,0,0,,(Байланыстың дыбысы өшіп жатыр)
Dialogue: 0,0:00:36.20,0:00:38.49,Default,,0,0,0,,«Танысқаныма қуаныштымын»...
Dialogue: 0,0:00:38.58,0:00:39.70,Default,,0,0,0,,Гааах!
Dialogue: 0,0:00:39.79,0:00:40.33,Default,,0,0,0,,(Қызыл телпек күлкі)
Dialogue: 0,0:00:40.33,0:00:41.45,Default,,0,0,0,,(Қызыл телпектің күлкісі)
Dialogue: 0,0:00:40.33,0:00:41.45,Default,,0,0,0,,Не!
Dialogue: 0,0:00:41.45,0:00:44.17,Default,,0,0,0,,(Қызыл телпектің күлкісі)
Dialogue: 0,0:00:45.37,0:00:47.46,Default,,0,0,0,,Дүниедегі ең керемет
Dialogue: 0,0:00:47.54,0:00:49.67,Default,,0,0,0,,Менің сыртқы түрім
Dialogue: 0,0:00:49.75,0:00:52.13,Default,,0,0,0,,Сен де бүгін кешке өте әдемі көрінесің~
Dialogue: 0,0:00:52.21,0:00:54.84,Default,,0,0,0,,Немесе… Қызыл телпек!
Dialogue: 0,0:00:54.93,0:00:58.05,Default,,0,0,0,,Әй, директор, сен жалғызсың ба?
Dialogue: 0,0:00:58.14,0:01:02.56,Default,,0,0,0,,Маған сенің арам күзетші болсаң бәрібір, бірақ маған сәлемдесу үшін көбірек адамдар керек.
Dialogue: 0,0:01:02.64,0:01:04.27,Default,,0,0,0,,Хе... Ақымақ болма!
Dialogue: 0,0:01:04.35,0:01:06.23,Default,,0,0,0,,Бүгін не ұрлауды жоспарлап отырсыз?
Dialogue: 0,0:01:06.31,0:01:08.86,Default,,0,0,0,,Кенеттен ұрлық жасау керемет емес.
Dialogue: 0,0:01:08.94,0:01:10.82,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:01:12.69,0:01:15.86,Default,,0,0,0,,Бүгін мен хабарламаны жеткізуге келдім.
Dialogue: 0,0:01:19.33,0:01:20.16,Default,,0,0,0,,менің, Иида мен Тодорокидің есімдері жарияланбады—
Dialogue: 0,0:01:20.24,0:01:21.74,Default,,0,0,0,,«Толық ай түні»
Dialogue: 0,0:01:21.83,0:01:24.96,Default,,0,0,0,,«Зергерлік шебер Иэль мырзаның жаңа көк жүрегі»
Dialogue: 0,0:01:25.04,0:01:26.62,Default,,0,0,0,,«Мен оны әдемі жеймін».
Dialogue: 0,0:01:26.71,0:01:28.83,Default,,0,0,0,,Нанана на...!
Dialogue: 0,0:01:28.92,0:01:33.76,Default,,0,0,0,,Дүниедегі ең керемет нәрселер маған тиесілі.
Dialogue: 0,0:01:33.84,0:01:35.84,Default,,0,0,0,,Бұл орынды.
Dialogue: 0,0:01:35.93,0:01:37.76,Default,,0,0,0,,Сонымен, келесі толық айда
Dialogue: 0,0:01:37.84,0:01:39.72,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:01:43.60,0:01:48.10,Default,,0,0,0,,♪～
Dialogue: 0,0:03:07.27,0:03:12.27,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.69,0:03:20.86,Default,,0,0,0,,...Сондықтан
Dialogue: 0,0:03:20.95,0:03:24.07,Default,,0,0,0,,Бұл «Қызыл телпек» фантом ұрысына ұқсас хабарлама.
Dialogue: 0,0:03:24.16,0:03:25.45,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:03:25.53,0:03:28.04,Default,,0,0,0,,Әрине қабылдаймын.
Dialogue: 0,0:03:28.12,0:03:29.46,Default,,0,0,0,,Жоқ (Директор) Иә?
Dialogue: 0,0:03:30.58,0:03:33.17,Default,,0,0,0,,Сіз Питос қонақүйіндегі оқиғаны ұмыттыңыз ба?
Dialogue: 0,0:03:33.25,0:03:36.09,Default,,0,0,0,,«Питос қонақүйіндегі ұрлық оқиғасы»
Dialogue: 0,0:03:36.17,0:03:37.88,Default,,0,0,0,,Әрине есімде.
Dialogue: 0,0:03:37.96,0:03:42.47,Default,,0,0,0,,Сол кезде елес ұры Қызыл телпек Арне ханымға айналды...
Dialogue: 0,0:03:42.55,0:03:45.26,Default,,0,0,0,,Мен қорғауым керек болған жүрек ұрланады.
Dialogue: 0,0:03:45.35,0:03:47.26,Default,,0,0,0,,Қасқырлар сізге шабуыл жасайды.
Dialogue: 0,0:03:47.35,0:03:49.02,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:03:49.10,0:03:51.02,Default,,0,0,0,,Мен болмасам, бәрің
Dialogue: 0,0:03:51.10,0:03:52.60,Default,,0,0,0,,Мен тозаққа баратын болдым
Dialogue: 0,0:03:52.69,0:03:55.73,Default,,0,0,0,,Мен айттым ғой, барлығы есептелгендей болды.
Dialogue: 0,0:03:55.81,0:03:56.98,Default,,0,0,0,,Алайда...
Dialogue: 0,0:03:57.07,0:04:01.45,Default,,0,0,0,,«Қызыл телпек» ойынына келгенде істің дұрыс болмайтыны рас.
Dialogue: 0,0:04:01.53,0:04:03.91,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:04:03.99,0:04:06.95,Default,,0,0,0,,Көк жүректі қызыл телпек ұрыдан кім қорғай алады?
Dialogue: 0,0:04:07.03,0:04:09.54,Default,,0,0,0,,Жалғыз сен деген қауесет естідім.
Dialogue: 0,0:04:09.62,0:04:11.79,Default,,0,0,0,,Мен осылай сұрадым.
Dialogue: 0,0:04:11.87,0:04:13.42,Default,,0,0,0,,Арне-сама күткендей!
Dialogue: 0,0:04:13.50,0:04:15.92,Default,,0,0,0,,Көмекші ретінде менің мұрыным керемет!
Dialogue: 0,0:04:16.00,0:04:21.38,Default,,0,0,0,,А... өсек болса да, қайтып келген күзетшіден естідім.
Dialogue: 0,0:04:22.34,0:04:25.01,Default,,0,0,0,,Ешкі клиентті қайтадан әкелді.
Dialogue: 0,0:04:25.09,0:04:28.26,Default,,0,0,0,,Детектив мырза, детектив мырза, детектив мырза, детектив мырза!
Dialogue: 0,0:04:28.35,0:04:31.89,Default,,0,0,0,,Ол кетті, менің сүйіктім...
Dialogue: 0,0:04:31.98,0:04:34.35,Default,,0,0,0,,Өтінемін, мені іздеңіз!
Dialogue: 0,0:04:34.44,0:04:39.07,Default,,0,0,0,,Мен онсыз өмір сүре алмаймын...
Dialogue: 0,0:04:39.15,0:04:39.65,Default,,0,0,0,,(Жылаған әйел)
Dialogue: 0,0:04:39.65,0:04:41.32,Default,,0,0,0,,(Жылаған әйел)
Dialogue: 0,0:04:39.65,0:04:41.32,Default,,0,0,0,,Ол жоғалып кеткен жоқ.
Dialogue: 0,0:04:41.32,0:04:41.40,Default,,0,0,0,,(Жылаған әйел)
Dialogue: 0,0:04:41.40,0:04:42.95,Default,,0,0,0,,(Жылаған әйел)
Dialogue: 0,0:04:41.40,0:04:42.95,Default,,0,0,0,,Сіз қашып кетпедіңіз бе?
Dialogue: 0,0:04:43.03,0:04:45.41,Default,,0,0,0,,Өйткені, махаббат өткінші.
Dialogue: 0,0:04:45.49,0:04:47.03,Default,,0,0,0,,Бұл дұрыс емес... (Әйел) Бұл дұрыс емес!
Dialogue: 0,0:04:47.62,0:04:49.08,Default,,0,0,0,,Ол екеуміз ғашық болдық!
Dialogue: 0,0:04:49.08,0:04:50.20,Default,,0,0,0,,Ол екеуміз ғашық болдық!
Dialogue: 0,0:04:49.08,0:04:50.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:50.29,0:04:52.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:50.29,0:04:52.96,Default,,0,0,0,,Біз тіпті үйленеміз деп уәде бердік!
Dialogue: 0,0:04:52.96,0:04:53.04,Default,,0,0,0,,Біз тіпті үйленеміз деп уәде бердік!
Dialogue: 0,0:04:53.04,0:04:53.66,Default,,0,0,0,,Біз тіпті үйленеміз деп уәде бердік!
Dialogue: 0,0:04:53.04,0:04:53.66,Default,,0,0,0,,Жоқ... Жоқ... Мынау не жігіт?
Dialogue: 0,0:04:53.66,0:04:54.67,Default,,0,0,0,,Жоқ... не... мынау не жігіт~!
Dialogue: 0,0:04:54.67,0:04:55.79,Default,,0,0,0,,Жоқ... Жоқ... Мынау не жігіт?
Dialogue: 0,0:04:54.67,0:04:55.79,Default,,0,0,0,,Я...
Dialogue: 0,0:04:56.42,0:04:58.13,Default,,0,0,0,,Мұражайға барайық па?
Dialogue: 0,0:04:58.21,0:05:00.09,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:00.17,0:05:02.63,Default,,0,0,0,,Құрметті Арне, бұл адам ше?
Dialogue: 0,0:05:02.72,0:05:05.63,Default,,0,0,0,,Мен мұны сізге қалдырамын, Линн Райнвейс
Dialogue: 0,0:05:05.72,0:05:09.10,Default,,0,0,0,,Істі өзіңіз шешетін уақыт келді.
Dialogue: 0,0:05:09.18,0:05:13.56,Default,,0,0,0,,Егер Цвей Рин-чанды ыңғайлы болу үшін пайдаланса.
Dialogue: 0,0:05:14.06,0:05:15.23,Default,,0,0,0,,Құрметті Арне...
Dialogue: 0,0:05:15.81,0:05:18.31,Default,,0,0,0,,Маған қатты сеніңіз...
Dialogue: 0,0:05:18.40,0:05:21.07,Default,,0,0,0,,Мен бар күшімді саламын!
Dialogue: 0,0:05:22.57,0:05:26.07,Default,,0,0,0,,Жоқ, алмаймын.
Dialogue: 0,0:05:26.74,0:05:29.03,Default,,0,0,0,,Жүр, біз де барайық.
Dialogue: 0,0:05:29.12,0:05:30.37,Default,,0,0,0,,Неге?
Dialogue: 0,0:05:30.45,0:05:33.33,Default,,0,0,0,,Рин-Чан өз бетімен барын салуға тырысады.
Dialogue: 0,0:05:33.41,0:05:35.46,Default,,0,0,0,,Мен сенің жолыңа бөгет болғым келмейді.
Dialogue: 0,0:05:35.54,0:05:36.71,Default,,0,0,0,,Я...
Dialogue: 0,0:05:37.79,0:05:40.38,Default,,0,0,0,,(Әйелдің жылауы)
Dialogue: 0,0:05:40.46,0:05:42.17,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:43.67,0:05:45.63,Default,,0,0,0,,Осындай кездері Рин Чан
Dialogue: 0,0:05:45.72,0:05:48.14,Default,,0,0,0,,Түймедақ шайы көмектесе алады.
Dialogue: 0,0:05:49.51,0:05:52.39,Default,,0,0,0,,Қайғы мен шатасуды басады.
Dialogue: 0,0:05:52.47,0:05:54.60,Default,,0,0,0,,Ах... Рахмет саған Джише
Dialogue: 0,0:05:54.68,0:05:57.90,Default,,0,0,0,,Ал кейбір дәмді тәттілер тамаша болар еді.
Dialogue: 0,0:06:00.65,0:06:03.28,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:06:03.36,0:06:05.24,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:06:05.32,0:06:08.11,Default,,0,0,0,,Мен үшін маңызды біреу жоқ.
Dialogue: 0,0:06:08.20,0:06:09.95,Default,,0,0,0,,Әлгі адам ештеңе айтқан жоқ.
Dialogue: 0,0:06:10.03,0:06:13.04,Default,,0,0,0,,Мен жай ғана кететін адам емеспін.
Dialogue: 0,0:06:13.12,0:06:14.95,Default,,0,0,0,,Өтінемін, уайымдамаңыз...
Dialogue: 0,0:06:15.04,0:06:17.54,Default,,0,0,0,,Оны Арне детектив агенттігіне қалдырыңыз!
Dialogue: 0,0:06:17.62,0:06:20.38,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:06:21.00,0:06:24.46,Default,,0,0,0,,Клиентті қайта әкелген ешкі
Dialogue: 0,0:06:24.55,0:06:25.59,Default,,0,0,0,,Рахмет, ешкі~
Dialogue: 0,0:06:25.67,0:06:29.18,Default,,0,0,0,,Оны іздеңіз! Мен сағындым!
Dialogue: 0,0:06:29.26,0:06:30.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.55,0:06:32.89,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,0:06:38.06,0:06:40.06,Default,,0,0,0,,Сен әдемісің (Начзеллер) Дәмді көрінеді
Dialogue: 0,0:06:40.15,0:06:41.31,Default,,0,0,0,,Жалға беру?
Dialogue: 0,0:06:41.40,0:06:43.61,Default,,0,0,0,,Білімді адам күткендей.
Dialogue: 0,0:06:43.69,0:06:46.19,Default,,0,0,0,,Өзінің сүйікті суретшісіне жалғандық
Dialogue: 0,0:06:46.28,0:06:51.45,Default,,0,0,0,,Талантты беремін деп жаныңды алам деген пері.
Dialogue: 0,0:06:51.53,0:06:56.37,Default,,0,0,0,,Бұл мұражайды алғаш жасаған директор жиі айтатын.
Dialogue: 0,0:06:56.45,0:07:01.04,Default,,0,0,0,,«Барлық суретшілер шығармалар жасау үшін өз өмірін құрбан етеді».
Dialogue: 0,0:07:01.13,0:07:06.34,Default,,0,0,0,,«Өмірдің жарқырауы оны көргендердің жүрегін елжіретеді».
Dialogue: 0,0:07:06.42,0:07:10.59,Default,,0,0,0,,Демек, сол елтаңба өнердің белгісі.
Dialogue: 0,0:07:10.68,0:07:15.81,Default,,0,0,0,,Біздің мұражайда көптеген тамаша өнер туындылары қойылған.
Dialogue: 0,0:07:15.89,0:07:17.27,Default,,0,0,0,,Саса өтінемін
Dialogue: 0,0:07:17.35,0:07:18.27,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:18.35,0:07:20.89,Default,,0,0,0,,Біз де көрікті жерлерге барамыз.
Dialogue: 0,0:07:20.98,0:07:23.86,Default,,0,0,0,,Өнер қаласына келдім.
Dialogue: 0,0:07:24.52,0:07:25.57,Default,,0,0,0,,Я
Dialogue: 0,0:07:25.65,0:07:26.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:28.28,0:07:32.36,Default,,0,0,0,,Бұл қаладағы ең жақсы туристік орын...
Dialogue: 0,0:07:32.45,0:07:34.83,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:34.91,0:07:36.95,Default,,0,0,0,,Бұл бөлмедегі төрт тас мүсін
Dialogue: 0,0:07:37.04,0:07:41.21,Default,,0,0,0,,Бұл соңғы кезде көзге түскен мүсіншінің туындысы.
Dialogue: 0,0:07:41.29,0:07:43.42,Default,,0,0,0,,Мүсінші осылай деді.
Dialogue: 0,0:07:43.50,0:07:47.34,Default,,0,0,0,,«Өнер мінсіз формалардан тумайды».
Dialogue: 0,0:07:47.42,0:07:51.59,Default,,0,0,0,,«Жетілмегендіктен, бұл көрерменнің қиялына байланысты»
Dialogue: 0,0:07:51.68,0:07:55.64,Default,,0,0,0,,«Кемел сұлулықты жасауға болады».
Dialogue: 0,0:08:06.15,0:08:11.45,Default,,0,0,0,,Ол да болашағы зор талантты суретшілердің бірі.
Dialogue: 0,0:08:12.61,0:08:17.49,Default,,0,0,0,,Жақында Иэл мырза керемет талантты дамытты.
Dialogue: 0,0:08:17.58,0:08:22.21,Default,,0,0,0,,Мына ғажайып жарқырауды қарашы
Dialogue: 0,0:08:22.83,0:08:26.21,Default,,0,0,0,,Адамдар мұны әдемі деп атай ма?
Dialogue: 0,0:08:26.29,0:08:28.25,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:08:28.34,0:08:30.59,Default,,0,0,0,,Ол заттарды ұнататын жігіт, соның ішінде Қызыл телпек.
Dialogue: 0,0:08:30.67,0:08:34.26,Default,,0,0,0,,А... бұл туралы, шын мәнінде...
Dialogue: 0,0:08:34.34,0:08:35.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.18,0:08:37.89,Default,,0,0,0,,Жаңа жұмыс болмаса ше?
Dialogue: 0,0:08:37.97,0:08:42.27,Default,,0,0,0,,Иэл мырзаның жоғалғанына бір апта болды.
Dialogue: 0,0:08:42.35,0:08:45.56,Default,,0,0,0,,Көк жүректі де әкелу керек еді...
Dialogue: 0,0:08:45.65,0:08:46.90,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:08:46.98,0:08:50.94,Default,,0,0,0,,Елес ұры Қызыл телпек ұрлайтын ештеңе жоқ...
Dialogue: 0,0:08:51.03,0:08:51.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:52.65,0:08:55.32,Default,,0,0,0,,Іс шешілді. Үйге барайық.
Dialogue: 0,0:08:55.41,0:08:58.08,Default,,0,0,0,,А, бұл мәселе!
Dialogue: 0,0:08:58.16,0:09:00.29,Default,,0,0,0,,Маған қорғауға ештеңе айтылмағандықтан
Dialogue: 0,0:09:00.37,0:09:02.00,Default,,0,0,0,,Бұл жерде болудың қажеті жоқ.
Dialogue: 0,0:09:02.08,0:09:04.58,Default,,0,0,0,,Егер Иэль-сан осылай табылмаса,
Dialogue: 0,0:09:04.67,0:09:07.00,Default,,0,0,0,,Бұл мұражай үшін үлкен шығын.
Dialogue: 0,0:09:07.08,0:09:09.13,Default,,0,0,0,,Сонымен қатар, толған ай ертең.
Dialogue: 0,0:09:09.21,0:09:11.21,Default,,0,0,0,,Егер бұл туралы елес ұры Қызыл телпек білсе
Dialogue: 0,0:09:11.30,0:09:12.92,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:09:13.01,0:09:14.13,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:09:14.22,0:09:18.55,Default,,0,0,0,,Мұражайды қорғаңыз, тым болмаса ертең кешке!
Dialogue: 0,0:09:18.64,0:09:20.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:24.89,0:09:27.19,Default,,0,0,0,,Өнер қаласынан күткендей.
Dialogue: 0,0:09:32.61,0:09:34.95,Default,,0,0,0,,Сізге портрет қалай ұнады?
Dialogue: 0,0:09:35.03,0:09:38.49,Default,,0,0,0,,Өнер қаласында өткен кезіңізден естелік ретінде сурет қалдырғыңыз келе ме?
Dialogue: 0,0:09:38.57,0:09:41.20,Default,,0,0,0,,Жарайды, мен саған сурет салып берейін.
Dialogue: 0,0:09:41.29,0:09:42.16,Default,,0,0,0,,Тоқта
Dialogue: 0,0:09:42.24,0:09:46.25,Default,,0,0,0,,Вампирлердің жүздеген жылдар бойы осылай қалуы ұят болар еді.
Dialogue: 0,0:09:46.33,0:09:47.50,Default,,0,0,0,,Қазір не істеп жатырсыз?
Dialogue: 0,0:09:47.58,0:09:49.63,Default,,0,0,0,,Сол жердегі сұлу ханым
Dialogue: 0,0:09:49.71,0:09:51.96,Default,,0,0,0,,Ха... Мен сенен бір жақсылық сұраймын.
Dialogue: 0,0:09:52.05,0:09:52.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:52.96,0:09:53.46,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:09:53.46,0:09:54.59,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:09:53.46,0:09:54.59,Default,,0,0,0,,А...
Dialogue: 0,0:09:54.59,0:09:55.34,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:09:57.55,0:10:01.05,Default,,0,0,0,,Мен бұдан асқан мейірімді жүз жасай алмас едім.
Dialogue: 0,0:10:01.14,0:10:02.31,Default,,0,0,0,,Шулы
Dialogue: 0,0:10:02.39,0:10:04.02,Default,,0,0,0,,Сәлем Эми! Наха-чан!
Dialogue: 0,0:10:04.10,0:10:04.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.39,0:10:08.81,Default,,0,0,0,,Рин-чан
Dialogue: 0,0:10:10.06,0:10:11.77,Default,,0,0,0,,Үш клиент?
Dialogue: 0,0:10:11.86,0:10:15.53,Default,,0,0,0,,Әй, осы күндері жоғалып кеткендер көп пе?
Dialogue: 0,0:10:15.61,0:10:17.24,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:10:17.82,0:10:22.74,Default,,0,0,0,,Жоғалған үш адамның барлығы да мұражайға қатысты.
Dialogue: 0,0:10:22.83,0:10:27.37,Default,,0,0,0,,Бірінші адам - ​​өнер туындысын тасымалдайтын тасымалдаушы компанияның қызметкері.
Dialogue: 0,0:10:27.46,0:10:30.63,Default,,0,0,0,,Екінші адам - ​​өткен айда жұмыстан шыққан куратор.
Dialogue: 0,0:10:30.71,0:10:35.01,Default,,0,0,0,,Үшінші тұлға – мұражай экскурсиясымен бірге жүретін аудармашы.
Dialogue: 0,0:10:35.09,0:10:36.76,Default,,0,0,0,,Бұл, әрине, біртүрлі.
Dialogue: 0,0:10:36.84,0:10:40.80,Default,,0,0,0,,Ал Қызыл телпек ұры да мұражайға хабарлама жіберді...
Dialogue: 0,0:10:41.35,0:10:45.77,Default,,0,0,0,,Барлық жұмбақтар мұражайда!
Dialogue: 0,0:10:49.14,0:10:50.52,Default,,0,0,0,,Рин Чан айтқандай
Dialogue: 0,0:10:50.60,0:10:54.07,Default,,0,0,0,,Сол мұражайдың бір сыры бар сияқты.
Dialogue: 0,0:10:54.15,0:10:55.19,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:10:55.28,0:10:59.32,Default,,0,0,0,,Құрметті Арне, мен сені ертең мұражайға ертіп барамын.
Dialogue: 0,0:10:59.40,0:11:01.66,Default,,0,0,0,,Жоқ, Линн Райнвейс
Dialogue: 0,0:11:01.74,0:11:03.99,Default,,0,0,0,,Ертең сол Айел есімді жігіт туралы айтасың.
Dialogue: 0,0:11:04.08,0:11:05.12,Default,,0,0,0,,Зерттеу
Dialogue: 0,0:11:05.20,0:11:07.50,Default,,0,0,0,,Бірақ ертең толық ай.
Dialogue: 0,0:11:07.58,0:11:10.42,Default,,0,0,0,,Керемет фантом ұры Қызыл телпек пен Лорд Арне арасындағы тартыс.
Dialogue: 0,0:11:10.50,0:11:12.71,Default,,0,0,0,,Көре алмай мұңайып отырмын!
Dialogue: 0,0:11:12.79,0:11:16.59,Default,,0,0,0,,Мен Арне-самаға бар күшіммен қолдау көрсетуді жоспарладым.
Dialogue: 0,0:11:16.67,0:11:18.34,Default,,0,0,0,,Қолдау…
Dialogue: 0,0:11:19.51,0:11:22.55,Default,,0,0,0,,Мұражайға ешқашан келмеу. Бұл тапсырыс.
Dialogue: 0,0:11:22.64,0:11:24.30,Default,,0,0,0,,Арне-саманың сараңдығы!
Dialogue: 0,0:11:24.39,0:11:25.22,Default,,0,0,0,,Кім сараң?
Dialogue: 0,0:11:25.31,0:11:26.52,Default,,0,0,0,,Жын! шайтан!
Dialogue: 0,0:11:26.60,0:11:29.98,Default,,0,0,0,,Осыған ұқсас, өйткені бұл вампир.
Dialogue: 0,0:11:30.06,0:11:31.69,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:31.77,0:11:32.73,Default,,0,0,0,,Пуи!
Dialogue: 0,0:11:32.81,0:11:34.27,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:45.99,0:11:48.29,Default,,0,0,0,,Иэл мырза, сіздің отбасыңыз ше?
Dialogue: 0,0:11:48.37,0:11:52.17,Default,,0,0,0,,Мен бұл жерді жалға алғанымда өмір бойы жалғызсырап өтемін дедім.
Dialogue: 0,0:11:53.08,0:11:54.63,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:11:57.84,0:11:59.13,Default,,0,0,0,,Бұл жақсырақ...
Dialogue: 0,0:11:59.21,0:12:01.68,Default,,0,0,0,,Ол кезде жағдай жақсы болатын.
Dialogue: 0,0:12:01.76,0:12:04.47,Default,,0,0,0,,Соңғы кездері ол қатты арықтады.
Dialogue: 0,0:12:04.55,0:12:05.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.68,0:12:08.97,Default,,0,0,0,,Мен көп жұмыс істеп жатырмын деп уайымдадым.
Dialogue: 0,0:12:09.68,0:12:12.81,Default,,0,0,0,,«Қазір жасап жатқаным - менің ең жақсы жұмысым».
Dialogue: 0,0:12:12.89,0:12:14.98,Default,,0,0,0,,Ол бақытты көрінді.
Dialogue: 0,0:12:15.06,0:12:17.94,Default,,0,0,0,,Шедевр...?
Dialogue: 0,0:12:18.02,0:12:21.03,Default,,0,0,0,,«Белгілі бір адамға жасап жатырмын» деп те айттыңыз.
Dialogue: 0,0:12:21.11,0:12:22.45,Default,,0,0,0,,Біреу үшін бе?
Dialogue: 0,0:12:22.53,0:12:24.95,Default,,0,0,0,,Менің ойымша, біз ғашық бола алар едік
Dialogue: 0,0:12:25.03,0:12:26.66,Default,,0,0,0,,Жапонияға оралғаннан кейін ол агенттік ашты—
Dialogue: 0,0:12:27.58,0:12:30.41,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,0:12:30.50,0:12:32.21,Default,,0,0,0,,Арықтадыңыз ба?
Dialogue: 0,0:12:32.29,0:12:35.25,Default,,0,0,0,,Қожайын қобалжыса керек.
Dialogue: 0,0:12:35.33,0:12:38.88,Default,,0,0,0,,Адамдар мүлдем әлсіз жаратылыс.
Dialogue: 0,0:12:38.96,0:12:41.01,Default,,0,0,0,,Әлсіз...
Dialogue: 0,0:12:41.09,0:12:42.84,Default,,0,0,0,,Әлсіз… Әлсіз…
Dialogue: 0,0:12:42.92,0:12:44.22,Default,,0,0,0,,Аурухана!
Dialogue: 0,0:12:44.30,0:12:46.76,Default,,0,0,0,,Иэл мырза ауырып қалса ше?
Dialogue: 0,0:12:46.85,0:12:48.64,Default,,0,0,0,,Сіз ауруханаға барған боларсыз.
Dialogue: 0,0:12:48.72,0:12:50.72,Default,,0,0,0,,Бұл жақсы шегерім, Рин Чан.
Dialogue: 0,0:12:50.81,0:12:51.89,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:12:51.98,0:12:55.48,Default,,0,0,0,,Мұражайдың үш қызметкері туралы да сұраймыз!
Dialogue: 0,0:13:15.37,0:13:17.88,Default,,0,0,0,,Сайып келгенде, бұл бос уақыт болды.
Dialogue: 0,0:13:17.96,0:13:20.00,Default,,0,0,0,,Жоқ, бұл ысырап емес.
Dialogue: 0,0:13:20.09,0:13:20.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.00,0:13:24.13,Default,,0,0,0,,Себебі мен төрт адамның қайда жоғалғанын білдім.
Dialogue: 0,0:13:24.22,0:13:25.59,Default,,0,0,0,,О, қараңдаршы
Dialogue: 0,0:13:25.68,0:13:26.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:29.05,0:13:31.68,Default,,0,0,0,,Бұл Рин Чанға жақсы көрінеді
Dialogue: 0,0:13:31.77,0:13:34.31,Default,,0,0,0,,Өте сүйкімді~ Маған ұнайды!
Dialogue: 0,0:13:34.39,0:13:36.85,Default,,0,0,0,,Эй, бұл шынымен іші бояу.
Dialogue: 0,0:13:36.94,0:13:39.36,Default,,0,0,0,,Әдемі түстер...
Dialogue: 0,0:13:40.19,0:13:41.86,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:13:41.94,0:13:45.82,Default,,0,0,0,,Ханым, бұл бойтұмар әсері бар дейді.
Dialogue: 0,0:13:46.40,0:13:48.32,Default,,0,0,0,,Тұмар эффектісі…
Dialogue: 0,0:13:48.41,0:13:49.74,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:49.82,0:13:50.66,Default,,0,0,0,,На-ха-чан!
Dialogue: 0,0:13:50.74,0:13:52.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:53.33,0:13:56.41,Default,,0,0,0,,Ол шынымен бар ма? Тұмар әсері
Dialogue: 0,0:13:56.50,0:13:58.63,Default,,0,0,0,,В... Идиот! Мен сәл таң қалдым!
Dialogue: 0,0:13:58.71,0:13:59.54,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:13:59.63,0:14:01.50,Default,,0,0,0,,Кез келген адам таң қалады!
Dialogue: 0,0:14:01.59,0:14:02.80,Default,,0,0,0,,Кенет мұрнымның ұшына осындай нәрсе...
Dialogue: 0,0:14:02.88,0:14:04.21,Default,,0,0,0,,Өтінемін! (Начзеллер) Эй!
Dialogue: 0,0:14:04.30,0:14:06.01,Default,,0,0,0,,Майдоари (Начзеллер) Сәлем!
Dialogue: 0,0:14:08.64,0:14:10.89,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:10.97,0:14:11.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:12.01,0:14:13.35,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:13.43,0:14:15.14,Default,,0,0,0,,Тәтті иіс
Dialogue: 0,0:14:15.23,0:14:16.89,Default,,0,0,0,,Өте аз
Dialogue: 0,0:14:18.10,0:14:20.36,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:21.65,0:14:22.77,Default,,0,0,0,,Зише
Dialogue: 0,0:14:22.86,0:14:24.32,Default,,0,0,0,,Не? кішкентай қызыл телпек
Dialogue: 0,0:14:24.40,0:14:29.28,Default,,0,0,0,,Джише мұнда көрген жалғыз адам зергер болды, солай ма?
Dialogue: 0,0:14:29.36,0:14:30.37,Default,,0,0,0,,О
Dialogue: 0,0:14:30.45,0:14:32.20,Default,,0,0,0,,Көк жүректі ұрлайтыныңды естіген соң.
Dialogue: 0,0:14:32.28,0:14:34.29,Default,,0,0,0,,Мен сізді тексеруге жиі келетінмін.
Dialogue: 0,0:14:34.37,0:14:36.54,Default,,0,0,0,,Иэл әрқашан жалғыз болды.
Dialogue: 0,0:14:36.62,0:14:40.96,Default,,0,0,0,,Әйтеуір айнадан одан басқа ешкімді көрмедім.
Dialogue: 0,0:14:41.04,0:14:44.46,Default,,0,0,0,,Егер ол вампирмен бірге өмір сүрсе, бұл мағынасы бар еді.
Dialogue: 0,0:14:44.55,0:14:46.59,Default,,0,0,0,,Вампирлермен бірге келетін қанның иісі
Dialogue: 0,0:14:46.67,0:14:48.30,Default,,0,0,0,,Мен ештеңе істемеймін.
Dialogue: 0,0:14:48.38,0:14:52.80,Default,,0,0,0,,Ауада тәтті бірдеңе қалқып тұр...
Dialogue: 0,0:14:52.89,0:14:55.06,Default,,0,0,0,,Оның үстіне бүгін кешке не істейсің?
Dialogue: 0,0:14:55.14,0:14:57.64,Default,,0,0,0,,Мұражайға барсам, онда ештеңе жоқ.
Dialogue: 0,0:14:57.73,0:15:00.02,Default,,0,0,0,,Мен тек қағаз ғана лақтырамын.
Dialogue: 0,0:15:00.10,0:15:01.61,Default,,0,0,0,,Бірақ вампир-сама
Dialogue: 0,0:15:01.69,0:15:04.61,Default,,0,0,0,,Сіз мені мұражайда күтіп тұрсыз, солай ма?
Dialogue: 0,0:15:04.69,0:15:06.61,Default,,0,0,0,,Себебі сен менің көз алдымда айттың.
Dialogue: 0,0:15:06.69,0:15:09.74,Default,,0,0,0,,Менің ойымша, мен мұны сізге жеткізетінін білгендіктен айттым.
Dialogue: 0,0:15:09.82,0:15:12.57,Default,,0,0,0,,Бармасаң мен сені аяймын.
Dialogue: 0,0:15:12.66,0:15:14.58,Default,,0,0,0,,Бұл тұзақ болуы мүмкін
Dialogue: 0,0:15:14.66,0:15:15.70,Default,,0,0,0,,Тұзақ?
Dialogue: 0,0:15:16.54,0:15:17.83,Default,,0,0,0,,Уау
Dialogue: 0,0:15:18.46,0:15:20.29,Default,,0,0,0,,Сіздің портретіңіз ше, жас ханым?
Dialogue: 0,0:15:20.37,0:15:22.75,Default,,0,0,0,,Кешіріңіз, портреттер жақсы.
Dialogue: 0,0:15:22.83,0:15:25.55,Default,,0,0,0,,Портрет туралы не айтасыз? А, мен қазір асығып тұрмын.
Dialogue: 0,0:15:25.63,0:15:27.34,Default,,0,0,0,,Келесі кездескенше...
Dialogue: 0,0:15:27.42,0:15:28.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:30.80,0:15:32.09,Default,,0,0,0,,Иэл мырза!
Dialogue: 0,0:15:32.18,0:15:33.22,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:33.30,0:15:34.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:34.47,0:15:37.43,Default,,0,0,0,,Ондай жағдайда оны Иэл мырзаға беріңіз.
Dialogue: 0,0:15:37.52,0:15:38.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.02,0:15:43.44,Default,,0,0,0,,Шамамен үш апта бұрын маған портрет салуды тапсырды...
Dialogue: 0,0:15:43.52,0:15:45.65,Default,,0,0,0,,Солға қарай жылжытыңыз.
Dialogue: 0,0:15:45.73,0:15:48.99,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:15:49.07,0:15:50.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:50.36,0:15:53.41,Default,,0,0,0,,Төлеміңіз үшін көп рахмет.
Dialogue: 0,0:15:53.49,0:15:56.12,Default,,0,0,0,,Бірнеше аптадан кейін келіп, алып кетіңіз.
Dialogue: 0,0:15:56.20,0:15:57.37,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:15:58.12,0:15:59.62,Default,,0,0,0,,Сіз әдемі көрінесіз, солай емес пе?
Dialogue: 0,0:15:59.70,0:16:03.00,Default,,0,0,0,,Бұл өте жақсы өрнек...
Dialogue: 0,0:16:03.08,0:16:06.96,Default,,0,0,0,,Мен қиыншылыққа тап болдым, өйткені олар оны алуға ешқашан келмеді.
Dialogue: 0,0:16:07.05,0:16:08.80,Default,,0,0,0,,А...
Dialogue: 0,0:16:10.34,0:16:13.18,Default,,0,0,0,,Мен арнайы сұраған және салған сурет.
Dialogue: 0,0:16:13.26,0:16:16.97,Default,,0,0,0,,Сіз оны алуға келмегеніңіз біртүрлі.
Dialogue: 0,0:16:17.06,0:16:20.77,Default,,0,0,0,,Бұл жай жоғалу емес сияқты.
Dialogue: 0,0:16:20.85,0:16:25.81,Default,,0,0,0,,Қалай болғанда да мен жоғалған адамдарды табуға бар күшімді саламын.
Dialogue: 0,0:16:25.90,0:16:27.23,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:16:33.99,0:16:36.49,Default,,0,0,0,,Шық, Қызыл телпек!
Dialogue: 0,0:16:38.24,0:16:40.79,Default,,0,0,0,,Ол шынымен келе ме?
Dialogue: 0,0:16:40.87,0:16:42.33,Default,,0,0,0,,Мен міндетті түрде келемін!
Dialogue: 0,0:16:42.41,0:16:46.33,Default,,0,0,0,,Осындай күлкілі жағдайлар Қызыл телпектің сүйікті ісі!
Dialogue: 0,0:16:46.42,0:16:50.30,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:16:50.38,0:16:52.17,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:17:00.64,0:17:01.98,Default,,0,0,0,,Уау
Dialogue: 0,0:17:03.10,0:17:04.44,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:04.52,0:17:05.98,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:17:06.06,0:17:06.90,Default,,0,0,0,,Ах
Dialogue: 0,0:17:06.98,0:17:09.90,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:17:09.98,0:17:12.11,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:17:12.19,0:17:13.95,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:17:14.03,0:17:17.41,Default,,0,0,0,,Қызыл телпек ұры керемет көрінеді!
Dialogue: 0,0:17:17.49,0:17:18.32,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:20.87,0:17:21.70,Default,,0,0,0,,(Арненің күрсінуі)
Dialogue: 0,0:17:26.96,0:17:27.79,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:17:29.88,0:17:31.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:31.63,0:17:33.51,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:17:33.59,0:17:35.76,Default,,0,0,0,,Сіз оны көрдіңіз бе? Вампир-сама
Dialogue: 0,0:17:35.84,0:17:38.22,Default,,0,0,0,,Менің тамаша секірісім
Dialogue: 0,0:17:38.30,0:17:40.68,Default,,0,0,0,,Қызыл телпек, директорға не болды?
Dialogue: 0,0:17:40.76,0:17:42.81,Default,,0,0,0,,Егер сіз директор болсаңыз...
Dialogue: 0,0:17:42.89,0:17:44.02,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:45.77,0:17:46.69,Default,,0,0,0,,Директор!
Dialogue: 0,0:17:47.81,0:17:49.94,Default,,0,0,0,,Оның орнына мынаны қараңыз.
Dialogue: 0,0:17:50.02,0:17:51.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.40,0:17:53.65,Default,,0,0,0,,Бұл... болуы мүмкін...
Dialogue: 0,0:17:54.57,0:17:56.03,Default,,0,0,0,,Көк жүрек?
Dialogue: 0,0:17:56.11,0:17:58.87,Default,,0,0,0,,Олай болса, сіз не істер едіңіз?
Dialogue: 0,0:18:02.54,0:18:03.54,Default,,0,0,0,,Я...
Dialogue: 0,0:18:06.96,0:18:10.71,Default,,0,0,0,,Менімен бірге керемет би билей алатын адам
Dialogue: 0,0:18:10.79,0:18:12.34,Default,,0,0,0,,Сіз туралы.
Dialogue: 0,0:18:12.42,0:18:14.71,Default,,0,0,0,,Би туралы не айтасыз? Бұл бос сөз
Dialogue: 0,0:18:14.80,0:18:16.30,Default,,0,0,0,,Оны маған қазір беріңіз.
Dialogue: 0,0:18:16.38,0:18:18.01,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:18:18.09,0:18:18.97,Default,,0,0,0,,Оны маған бер
Dialogue: 0,0:18:19.05,0:18:20.09,Default,,0,0,0,,Егер сіз оны ала аласыз
Dialogue: 0,0:18:20.18,0:18:23.18,Default,,0,0,0,,Оны тек сіздің көмегіңізбен алу жеткілікті.
Dialogue: 0,0:18:33.36,0:18:34.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:37.11,0:18:39.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:40.07,0:18:41.03,Default,,0,0,0,,Чи…
Dialogue: 0,0:18:41.12,0:18:42.66,Default,,0,0,0,,О... Әй? Мм, бұл солай ма?
Dialogue: 0,0:18:43.24,0:18:44.91,Default,,0,0,0,,А... осылай!
Dialogue: 0,0:18:46.54,0:18:47.87,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:18:51.50,0:18:52.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.59,0:18:56.51,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:57.88,0:18:59.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.77,0:19:14.61,Default,,0,0,0,,Уау
Dialogue: 0,0:19:15.98,0:19:17.32,Default,,0,0,0,,Құрметті Арне!
Dialogue: 0,0:19:17.40,0:19:19.28,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:19:19.36,0:19:21.99,Default,,0,0,0,,Мен саған келме дедім ғой, Рин Рейнва...
Dialogue: 0,0:19:22.07,0:19:23.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:25.58,0:19:28.66,Default,,0,0,0,,Арне-сама жеңіс тілейміз!
Dialogue: 0,0:19:28.75,0:19:29.79,Default,,0,0,0,,Evily!
Dialogue: 0,0:19:29.87,0:19:31.21,Default,,0,0,0,,Қанды!
Dialogue: 0,0:19:31.29,0:19:32.54,Default,,0,0,0,,Фантастикалық…
Dialogue: 0,0:19:32.63,0:19:34.75,Default,,0,0,0,,Нұсқаушы!
Dialogue: 0,0:19:34.84,0:19:37.01,Default,,0,0,0,,Evily! Қанды!
Dialogue: 0,0:19:37.09,0:19:38.63,Default,,0,0,0,,Фантастикалық…
Dialogue: 0,0:19:38.72,0:19:41.38,Default,,0,0,0,,Нұсқаушы!
Dialogue: 0,0:19:41.47,0:19:43.14,Default,,0,0,0,,Evily! Қанды!
Dialogue: 0,0:19:43.22,0:19:46.06,Default,,0,0,0,,Фантастикалық Ноintator!
Dialogue: 0,0:19:46.14,0:19:47.47,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:19:47.47,0:19:48.73,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:19:47.47,0:19:48.73,Default,,0,0,0,,Я...
Dialogue: 0,0:19:48.73,0:19:49.35,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:19:49.35,0:19:50.64,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:19:49.35,0:19:50.64,Default,,0,0,0,,Мотивацияның жоғалуы
Dialogue: 0,0:19:50.73,0:19:54.06,Default,,0,0,0,,Тамаша би үшін бәрі бар сияқты.
Dialogue: 0,0:19:55.19,0:19:56.19,Default,,0,0,0,,Хамф!
Dialogue: 0,0:19:57.03,0:19:58.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:59.94,0:20:02.41,Default,,0,0,0,,Охохохохо...!
Dialogue: 0,0:20:02.49,0:20:04.32,Default,,0,0,0,,Бұл жалған
Dialogue: 0,0:20:04.41,0:20:08.79,Default,,0,0,0,,Мен бүгін сіздерге тағы бір тамаша болжам айту үшін келдім.
Dialogue: 0,0:20:12.33,0:20:15.46,Default,,0,0,0,,Өкінішке орай, біз жоспарларымызды өзгертуіміз керек.
Dialogue: 0,0:20:16.04,0:20:17.46,Default,,0,0,0,,Вампирден де артық
Dialogue: 0,0:20:17.55,0:20:21.59,Default,,0,0,0,,Алдымен мен жоғалған Иел-саманы табамын.
Dialogue: 0,0:20:21.67,0:20:23.89,Default,,0,0,0,,Мен көк жүректі аламын.
Dialogue: 0,0:20:23.97,0:20:27.31,Default,,0,0,0,,Сонымен, вампир-сама, сен кереметсің...
Dialogue: 0,0:20:27.39,0:20:28.22,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:20:33.81,0:20:35.98,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:20:38.07,0:20:40.99,Default,,0,0,0,,Мен жоғалған адамдарды таптым.
Dialogue: 0,0:20:41.07,0:20:42.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:42.36,0:20:43.36,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:20:43.45,0:20:46.95,Default,,0,0,0,,Жоғалған адамдардың мәйітін таптым деп айтуым керек.
Dialogue: 0,0:20:47.58,0:20:48.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:48.79,0:20:51.29,Default,,0,0,0,,Мәйіт дегеніміз не?
Dialogue: 0,0:20:51.37,0:20:52.41,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:20:54.00,0:20:55.67,Default,,0,0,0,,Хмм?
Dialogue: 0,0:20:59.13,0:21:00.13,Default,,0,0,0,,Иә! Ооо...
Dialogue: 0,0:21:00.21,0:21:03.38,Default,,0,0,0,,Бұл жай ғана тас мүсін болса, бұлай қозғалмас еді.
Dialogue: 0,0:21:11.39,0:21:12.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:16.85,0:21:18.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:25.49,0:21:30.49,Default,,0,0,0,,♪～
Dialogue: 0,0:22:48.45,0:22:53.95,Default,,0,0,0,,～♪
