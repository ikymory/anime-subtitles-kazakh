Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.88,0:00:14.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.22,0:00:16.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:17.60,0:00:22.10,Default,,0,0,0,,♪～
Dialogue: 0,0:01:41.26,0:01:46.27,Default,,0,0,0,,～♪
Dialogue: 0,0:01:52.90,0:01:55.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:55.15,0:01:57.36,Default,,0,0,0,,Жоқ~ (Эми) О~
Dialogue: 0,0:01:57.95,0:02:00.03,Default,,0,0,0,,Хова~ (Эми) Хмм~
Dialogue: 0,0:02:00.12,0:02:01.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.91,0:02:03.29,Default,,0,0,0,,Уау~ Ха...
Dialogue: 0,0:02:03.37,0:02:06.96,Default,,0,0,0,,Тыныш оқи алмайсың ба? Линн Рейнвейс
Dialogue: 0,0:02:07.67,0:02:08.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:10.08,0:02:11.96,Default,,0,0,0,,Майдо~ Ешкі~
Dialogue: 0,0:02:12.59,0:02:15.67,Default,,0,0,0,,Бүгін де клиент әкелген ешкі.
Dialogue: 0,0:02:18.88,0:02:21.51,Default,,0,0,0,,Сонымен... уһ, Шейла-сан.
Dialogue: 0,0:02:21.60,0:02:25.64,Default,,0,0,0,,Өтінішіңіздің егжей-тегжейлері туралы айтып бере аласыз ба?
Dialogue: 0,0:02:26.14,0:02:27.02,Default,,0,0,0,,Иә
Dialogue: 0,0:02:27.60,0:02:30.27,Default,,0,0,0,,Бұл ұят оқиға.
Dialogue: 0,0:02:30.35,0:02:33.02,Default,,0,0,0,,Мен күйеуімнің опасыздығына қатысты тергеуді сұраймын...
Dialogue: 0,0:02:33.65,0:02:36.03,Default,,0,0,0,,Бұл алаяқтық тергеу ме?
Dialogue: 0,0:02:37.53,0:02:38.74,Default,,0,0,0,,2 ай бұрын…
Dialogue: 0,0:02:39.32,0:02:43.87,Default,,0,0,0,,Күйеуім баспалдақтан құлап, жарақат алды.
Dialogue: 0,0:02:43.95,0:02:48.62,Default,,0,0,0,,Сол жарақаттың кесірінен күйеуім сөйлей алмай қалды.
Dialogue: 0,0:02:49.37,0:02:50.88,Default,,0,0,0,,Менің бұрынғы шеберім болды
Dialogue: 0,0:02:50.96,0:02:53.88,Default,,0,0,0,,Ол өте мейірімді адам еді.
Dialogue: 0,0:02:53.96,0:02:56.71,Default,,0,0,0,,Жол апатынан кейін күйеуім ауруханадан шықты.
Dialogue: 0,0:02:56.80,0:03:00.22,Default,,0,0,0,,Адам өзгергендей, шетте қалды.
Dialogue: 0,0:03:00.72,0:03:02.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:02.47,0:03:05.06,Default,,0,0,0,,Сондықтан сіз оны алдады деп күдіктенесіз.
Dialogue: 0,0:03:05.14,0:03:06.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.27,0:03:07.14,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:03:07.22,0:03:08.35,Default,,0,0,0,,Құрметті Арне!
Dialogue: 0,0:03:08.43,0:03:10.27,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:03:10.35,0:03:12.81,Default,,0,0,0,,Менің ойымша, бұл таяз.
Dialogue: 0,0:03:13.69,0:03:16.53,Default,,0,0,0,,Бірақ шебер қазірдің өзінде мөлдір.
Dialogue: 0,0:03:16.61,0:03:18.53,Default,,0,0,0,,Егер сіз тіпті сөйлей алмасаңыз ...
Dialogue: 0,0:03:18.61,0:03:20.91,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:03:20.99,0:03:21.86,Default,,0,0,0,,Мөлдір?
Dialogue: 0,0:03:21.95,0:03:24.70,Default,,0,0,0,,А... Мен мұны айтуды ұмытып кетіппін.
Dialogue: 0,0:03:24.78,0:03:29.79,Default,,0,0,0,,Мен қарапайым адаммын, ал күйеуім көзге көрінбейтін адам.
Dialogue: 0,0:03:29.87,0:03:33.29,Default,,0,0,0,,Мөлдір...адам!
Dialogue: 0,0:03:33.38,0:03:35.00,Default,,0,0,0,,Хо…
Dialogue: 0,0:03:36.63,0:03:37.46,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:38.09,0:03:39.42,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:03:39.51,0:03:41.63,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:03:41.72,0:03:43.93,Default,,0,0,0,,Яғни, сен біреуді тергеп жүріп сол автобусқа түсіп қалдың ғой, иә?
Dialogue: 0,0:03:44.55,0:03:45.68,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:45.76,0:03:47.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.35,0:03:53.19,Default,,0,0,0,,Арне мырза? Асығыңыз~
Dialogue: 0,0:03:53.27,0:03:55.56,Default,,0,0,0,,Шашым қатты қатайып қалады, сондықтан шомылғым келмейді.
Dialogue: 0,0:04:00.19,0:04:02.99,Default,,0,0,0,,Мен сізге тұтынушы әкелдім.
Dialogue: 0,0:04:03.07,0:04:04.11,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:07.87,0:04:10.00,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:04:10.08,0:04:13.21,Default,,0,0,0,,Бұл шынымен де мөлдір, солай емес пе?
Dialogue: 0,0:04:13.29,0:04:15.25,Default,,0,0,0,,Бұл оптикалық иллюзия сияқты.
Dialogue: 0,0:04:16.00,0:04:18.50,Default,,0,0,0,,Мен күйеуімнің екінші әйелімін.
Dialogue: 0,0:04:19.09,0:04:22.63,Default,,0,0,0,,Күйеуімнің көзге көрінбейтін бұрынғы жесір әйелі бар еді.
Dialogue: 0,0:04:22.72,0:04:25.64,Default,,0,0,0,,Онымен менің үш ұлым бар.
Dialogue: 0,0:04:26.26,0:04:30.10,Default,,0,0,0,,Мен сенімен онша жақсы қарым-қатынаста емеспін.
Dialogue: 0,0:04:30.18,0:04:32.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:32.27,0:04:34.10,Default,,0,0,0,,Әке мен бала арасындағы қарым-қатынас қалай?
Dialogue: 0,0:04:34.19,0:04:36.61,Default,,0,0,0,,Күйеуім апатқа ұшырағанша.
Dialogue: 0,0:04:36.69,0:04:39.07,Default,,0,0,0,,Бұл ешқашан жақсы қарым-қатынас болған емес.
Dialogue: 0,0:04:39.78,0:04:43.53,Default,,0,0,0,,Бірақ апаттан кейін мен өз жұмысымды ұлыма сеніп тапсыра бастадым.
Dialogue: 0,0:04:43.61,0:04:48.62,Default,,0,0,0,,Маған шынымен шығу керек болғанда, мен ұлдарымның бірін ертіп жүруін өтінемін.
Dialogue: 0,0:04:48.70,0:04:50.91,Default,,0,0,0,,Мен оған қатты сене бастадым...
Dialogue: 0,0:04:51.00,0:04:52.33,Default,,0,0,0,,Хо…
Dialogue: 0,0:04:53.21,0:04:58.38,Default,,0,0,0,,Негізі мен апат болған күні далада болғанмын.
Dialogue: 0,0:04:58.96,0:05:00.67,Default,,0,0,0,,Мен қайтып келсем, күйеуім...
Dialogue: 0,0:05:00.75,0:05:03.59,Default,,0,0,0,,Ұлдарым ауруханаға жеткізілгеннен кейін.
Dialogue: 0,0:05:03.67,0:05:06.47,Default,,0,0,0,,Ауруханаға жатқызу кезінде келушілерге рұқсат етілмейді
Dialogue: 0,0:05:06.55,0:05:11.10,Default,,0,0,0,,Мен оны ауруханадан шыққаннан кейін кездестіргенде, ол басқа адам сияқты болды.
Dialogue: 0,0:05:12.89,0:05:14.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:14.10,0:05:15.81,Default,,0,0,0,,Мен бұл өтінішті қабылдаймын.
Dialogue: 0,0:05:15.89,0:05:18.02,Default,,0,0,0,,Ах... А, шынымен бе?
Dialogue: 0,0:05:18.11,0:05:18.94,Default,,0,0,0,,О
Dialogue: 0,0:05:19.02,0:05:23.94,Default,,0,0,0,,Алайда, бұл алдауды тергеу емес, жазатайым оқиғаны тергеу.
Dialogue: 0,0:05:24.86,0:05:26.41,Default,,0,0,0,,Бұл шебер.
Dialogue: 0,0:05:28.49,0:05:30.58,Default,,0,0,0,,Бұл менің үлкен ұлым және екінші ұлым.
Dialogue: 0,0:05:30.66,0:05:32.79,Default,,0,0,0,,Бұл Әл...
Dialogue: 0,0:05:32.87,0:05:34.79,Default,,0,0,0,,Арне Нойнтатор
Dialogue: 0,0:05:34.87,0:05:36.17,Default,,0,0,0,,Жеке детектив.
Dialogue: 0,0:05:36.25,0:05:37.88,Default,,0,0,0,,Бұл менің көмекшім Рин.
Dialogue: 0,0:05:37.96,0:05:39.50,Default,,0,0,0,,Бұл Эми.
Dialogue: 0,0:05:39.59,0:05:40.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:40.75,0:05:41.88,Default,,0,0,0,,Детектив?
Dialogue: 0,0:05:42.80,0:05:44.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.67,0:05:47.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:48.39,0:05:50.01,Default,,0,0,0,,(қатты қысу дыбысы)
Dialogue: 0,0:05:50.10,0:05:51.72,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:05:52.31,0:05:53.64,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:05:53.72,0:05:55.48,Default,,0,0,0,,Күштің дұрыс емес мөлшері
Dialogue: 0,0:05:55.56,0:05:57.10,Default,,0,0,0,,(Екінші ұлдың жөтелі)
Dialogue: 0,0:05:57.19,0:06:00.77,Default,,0,0,0,,Сонымен, детектив, сіздің қандай бизнесіңіз бар?
Dialogue: 0,0:06:00.86,0:06:01.69,Default,,0,0,0,,О
Dialogue: 0,0:06:01.77,0:06:05.40,Default,,0,0,0,,Күйеуіңіздің оқыс оқиғасы туралы шағын зерттеуге рұқсат етіңіз.
Dialogue: 0,0:06:10.87,0:06:12.62,Default,,0,0,0,,Я...
Dialogue: 0,0:06:12.70,0:06:14.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:14.12,0:06:15.54,Default,,0,0,0,,Бірақ жазатайым оқиға – жазатайым оқиға.
Dialogue: 0,0:06:15.62,0:06:18.29,Default,,0,0,0,,Іздеуге тұрарлық ештеңе жоқ...
Dialogue: 0,0:06:18.37,0:06:19.29,Default,,0,0,0,,О
Dialogue: 0,0:06:19.37,0:06:21.42,Default,,0,0,0,,Бірақ бұл да жұмыс.
Dialogue: 0,0:06:21.50,0:06:24.63,Default,,0,0,0,,Өзіңізді кінәлі сезінетін жағдайлар болмаса, мен сіздердің ынтымақтастықтарыңызды қалаймын.
Dialogue: 0,0:06:25.42,0:06:26.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:26.92,0:06:29.22,Default,,0,0,0,,Айтпақшы, осы үйдің баласы
Dialogue: 0,0:06:29.30,0:06:31.35,Default,,0,0,0,,Мен үш ағайынды бар деп естідім?
Dialogue: 0,0:06:31.43,0:06:34.47,Default,,0,0,0,,А... үшінші ұлым шықты.
Dialogue: 0,0:06:34.56,0:06:36.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:36.31,0:06:38.94,Default,,0,0,0,,Енді мен бұл сарайды тезірек зерттегім келеді.
Dialogue: 0,0:06:39.85,0:06:40.69,Default,,0,0,0,,Маған жол көрсет
Dialogue: 0,0:06:40.77,0:06:42.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:42.31,0:06:43.90,Default,,0,0,0,,Сәлем, сен
Dialogue: 0,0:06:43.98,0:06:45.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:45.23,0:06:46.90,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:06:46.99,0:06:49.49,Default,,0,0,0,,Менің сендерді сынайтын ойым жоқ.
Dialogue: 0,0:06:50.07,0:06:52.20,Default,,0,0,0,,Мені тек шындық қызықтырады.
Dialogue: 0,0:06:52.28,0:06:53.33,Default,,0,0,0,,Не?
Dialogue: 0,0:06:53.41,0:06:53.91,Default,,0,0,0,,(таяқтың құлаған дыбысы)
Dialogue: 0,0:06:53.91,0:06:54.70,Default,,0,0,0,,(таяқтың құлаған дыбысы)
Dialogue: 0,0:06:53.91,0:06:54.70,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:06:54.70,0:06:56.20,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:06:56.29,0:06:57.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:58.16,0:06:59.62,Default,,0,0,0,,Амансың ба? әке
Dialogue: 0,0:07:00.33,0:07:03.84,Default,,0,0,0,,Сіз шаршаған болуыңыз керек. Мені бөлмеңе апар.
Dialogue: 0,0:07:06.13,0:07:08.34,Default,,0,0,0,,Маған жол көрсетуге рұқсат етіңіз.
Dialogue: 0,0:07:09.22,0:07:11.47,Default,,0,0,0,,Бұл апат орын алған баспалдақ.
Dialogue: 0,0:07:11.55,0:07:15.93,Default,,0,0,0,,Қатты дыбыс пен дауысты естіп, үшеуміз соған қарай жүгірдік.
Dialogue: 0,0:07:16.01,0:07:19.69,Default,,0,0,0,,Әкем сол жақта қансырап жатқан.
Dialogue: 0,0:07:19.77,0:07:21.98,Default,,0,0,0,,Сіз бұл баспалдақтарды жиі пайдаланасыз ба?
Dialogue: 0,0:07:22.06,0:07:24.02,Default,,0,0,0,,Негізінен әкем мен Шейла
Dialogue: 0,0:07:24.11,0:07:26.40,Default,,0,0,0,,Бұл ағамның бөлмесінен алыс.
Dialogue: 0,0:07:26.48,0:07:27.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:27.90,0:07:30.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Сізге көңіліңіз толады ма?
Dialogue: 0,0:07:30.36,0:07:31.66,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:07:31.74,0:07:33.91,Default,,0,0,0,,Осыдан кейін мен әр адамның әңгімесін бір-бірден тыңдағым келеді.
Dialogue: 0,0:07:33.99,0:07:35.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:35.99,0:07:37.41,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:38.70,0:07:42.04,Default,,0,0,0,,Сонда мен саған не айтуым керек?
Dialogue: 0,0:07:42.12,0:07:44.33,Default,,0,0,0,,Алдымен апаттың болған уақытына тоқталайық.
Dialogue: 0,0:07:44.42,0:07:46.09,Default,,0,0,0,,Бұл үйде кім болды?
Dialogue: 0,0:07:46.17,0:07:48.59,Default,,0,0,0,,Сіз жай ғана бауырлар екеніңізге сенімдісіз бе?
Dialogue: 0,0:07:48.67,0:07:49.72,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.80,0:07:52.80,Default,,0,0,0,,Екінші ұлым екеуміз басқа бөлмеде шахмат ойнадық.
Dialogue: 0,0:07:52.89,0:07:55.76,Default,,0,0,0,,Үшінші ұлы ас үйде ішіп отырды.
Dialogue: 0,0:07:55.85,0:07:57.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:57.18,0:08:00.35,Default,,0,0,0,,Айтпақшы, әкеңізге өкпеңіз бар ма?
Dialogue: 0,0:08:00.43,0:08:01.48,Default,,0,0,0,,Ах... (үлкен ұлы) Ха...
Dialogue: 0,0:08:01.56,0:08:03.44,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:08:03.52,0:08:05.31,Default,,0,0,0,,Тек ақпаратты жүйелеу
Dialogue: 0,0:08:06.65,0:08:07.77,Default,,0,0,0,,№.
Dialogue: 0,0:08:09.11,0:08:13.03,Default,,0,0,0,,Кімде-кім әкесіне кек болса, бұл оның екінші ұлы шығар.
Dialogue: 0,0:08:13.61,0:08:16.74,Default,,0,0,0,,Мұны айту қиын, бірақ ол...
Dialogue: 0,0:08:17.53,0:08:20.37,Default,,0,0,0,,Оның Шейлаға деген сезімі бар сияқты.
Dialogue: 0,0:08:20.45,0:08:21.58,Default,,0,0,0,,Не!
Dialogue: 0,0:08:22.79,0:08:25.29,Default,,0,0,0,,...Ал ол не үшін?
Dialogue: 0,0:08:26.00,0:08:29.50,Default,,0,0,0,,Өкінішке орай, уақытым жоқ. Маған қысқаша айтып беріңізші.
Dialogue: 0,0:08:29.59,0:08:31.22,Default,,0,0,0,,Енді ашық тыңдайық.
Dialogue: 0,0:08:31.30,0:08:34.47,Default,,0,0,0,,Сіз енеңізге құмарсыз ба?
Dialogue: 0,0:08:34.55,0:08:36.68,Default,,0,0,0,,Иә? А... Арне мырза
Dialogue: 0,0:08:36.76,0:08:38.85,Default,,0,0,0,,Оны қалай айтасыз!
Dialogue: 0,0:08:38.93,0:08:41.02,Default,,0,0,0,,Не? Сіз анық сұрадыңыз.
Dialogue: 0,0:08:41.10,0:08:44.06,Default,,0,0,0,,Ал... бұл рас.
Dialogue: 0,0:08:44.14,0:08:46.15,Default,,0,0,0,,Жоқ... жоқ, олай емес.
Dialogue: 0,0:08:46.23,0:08:49.19,Default,,0,0,0,,Бұл үшін басқа сөз бар ...
Dialogue: 0,0:08:49.27,0:08:50.53,Default,,0,0,0,,(Екінші ұлдың жөтелі)
Dialogue: 0,0:08:50.61,0:08:53.90,Default,,0,0,0,,Бұл мүлдем ақымақтық. Бұл жиіркенішті.
Dialogue: 0,0:08:53.99,0:08:55.11,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:08:55.20,0:08:56.53,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:56.62,0:09:00.33,Default,,0,0,0,,Екеуміз ғана сыртқа бірнеше рет шыққанымыз рас.
Dialogue: 0,0:09:00.41,0:09:03.50,Default,,0,0,0,,Себебі мен ол әйелдің шынайы болмысын анықтағым келді.
Dialogue: 0,0:09:03.58,0:09:04.41,Default,,0,0,0,,Уг!?
Dialogue: 0,0:09:04.50,0:09:05.79,Default,,0,0,0,,Сол әйел
Dialogue: 0,0:09:05.87,0:09:09.00,Default,,0,0,0,,Ол әкесінің мүлкі үшін келген болуы керек.
Dialogue: 0,0:09:09.09,0:09:10.88,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,0:09:10.96,0:09:15.34,Default,,0,0,0,,Әйтсе де, сен менің алдымда берілмеді.
Dialogue: 0,0:09:17.18,0:09:21.35,Default,,0,0,0,,Әкем екінші рет тұрмысқа шығуға шешім қабылдаған бойда мен ол әйелді көп зерттедім.
Dialogue: 0,0:09:22.02,0:09:24.31,Default,,0,0,0,,Ол әйел құлдыраған ақсүйектерде дүниеге келген.
Dialogue: 0,0:09:24.39,0:09:28.36,Default,,0,0,0,,Мен бұрын басқа елде бірнеше ай ғана тұрмыс құрдым.
Dialogue: 0,0:09:29.02,0:09:31.65,Default,,0,0,0,,Екінші адам 80-ге таяп қалған жалғызбасты ауқатты адам.
Dialogue: 0,0:09:31.73,0:09:34.49,Default,,0,0,0,,Үйленгеннен кейін көп ұзамай апаттан қайтыс болған көрінеді.
Dialogue: 0,0:09:34.57,0:09:35.95,Default,,0,0,0,,Кездейсоқ өлім?
Dialogue: 0,0:09:36.03,0:09:39.62,Default,,0,0,0,,А, мен баспалдақтан құлап, басымды соқтым деп ойлаймын.
Dialogue: 0,0:09:39.70,0:09:42.45,Default,,0,0,0,,Осы апат сияқты.
Dialogue: 0,0:09:42.54,0:09:44.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:44.29,0:09:47.58,Default,,0,0,0,,Мүлдем... менің әкем де менің әкем.
Dialogue: 0,0:09:47.67,0:09:51.04,Default,,0,0,0,,Анам қайтыс болғаннан кейін мен сол күдікті әйелді кездестірдім...
Dialogue: 0,0:09:51.13,0:09:51.96,Default,,0,0,0,,Ах
Dialogue: 0,0:09:53.76,0:09:54.92,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:55.01,0:09:58.14,Default,,0,0,0,,Сіз оған көп қарадыңыз, солай емес пе?
Dialogue: 0,0:09:58.22,0:09:59.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:59.22,0:10:00.97,Default,,0,0,0,,Және... Әйтеуір
Dialogue: 0,0:10:01.05,0:10:05.02,Default,,0,0,0,,Егер сіз полицияға еліктегіңіз келсе, мұны сәл жақсырақ етіп жасаңыз.
Dialogue: 0,0:10:05.10,0:10:07.69,Default,,0,0,0,,Жалпы айтқанда, мен әкем туралы бірдеңе сезінемін.
Dialogue: 0,0:10:07.77,0:10:09.02,Default,,0,0,0,,Менің інім де солай.
Dialogue: 0,0:10:09.10,0:10:12.07,Default,,0,0,0,,Ол құмар ойындар арқылы қомақты қарыз жинаған.
Dialogue: 0,0:10:12.15,0:10:13.78,Default,,0,0,0,,Әкемнен менің міндетімді алуды сұрағанда
Dialogue: 0,0:10:13.86,0:10:17.07,Default,,0,0,0,,Ол ашу-ызаны қоздыратыны сонша, ол менен бас тарта жаздады.
Dialogue: 0,0:10:21.07,0:10:22.08,Default,,0,0,0,,(дарт дыбысы)
Dialogue: 0,0:10:28.71,0:10:30.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.67,0:10:33.42,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:10:33.50,0:10:35.42,Default,,0,0,0,,Бұл менің үшінші ұлым.
Dialogue: 0,0:10:35.51,0:10:36.80,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:36.88,0:10:38.93,Default,,0,0,0,,Арне Нойнтатор.
Dialogue: 0,0:10:43.26,0:10:44.10,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.39,0:10:47.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.06,0:10:51.02,Default,,0,0,0,,Сонымен... онда мұнда
Dialogue: 0,0:10:51.10,0:10:52.81,Default,,0,0,0,,Әй, бұл сақина!
Dialogue: 0,0:10:52.90,0:10:53.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.82,0:10:55.48,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:10:55.57,0:10:59.49,Default,,0,0,0,,Амелия Уилсонның соңғы жинағы!
Dialogue: 0,0:10:59.57,0:11:00.91,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:11:00.99,0:11:03.87,Default,,0,0,0,,Керемет! Саған сондай жарасады
Dialogue: 0,0:11:03.95,0:11:06.75,Default,,0,0,0,,Цк... сіз жақсы жағдайдасыз.
Dialogue: 0,0:11:10.21,0:11:11.29,Default,,0,0,0,,Жақында.
Dialogue: 0,0:11:11.38,0:11:14.67,Default,,0,0,0,,Анамның естелік бұйымдары жоғалып барады.
Dialogue: 0,0:11:14.75,0:11:17.30,Default,,0,0,0,,Екінші жағынан, сіздікі біраз өсуде.
Dialogue: 0,0:11:17.38,0:11:18.38,Default,,0,0,0,,Не?
Dialogue: 0,0:11:19.67,0:11:21.09,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:21.76,0:11:22.80,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.81,0:11:28.23,Default,,0,0,0,,...Ендеше бүгін менің кезегім.
Dialogue: 0,0:11:28.31,0:11:30.39,Default,,0,0,0,,Жақсы, мен бәріне жауап беремін.
Dialogue: 0,0:11:30.48,0:11:34.02,Default,,0,0,0,,Әкеңнің қарызды мойнына алғаны рас па?
Dialogue: 0,0:11:34.11,0:11:35.61,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:11:35.69,0:11:39.53,Default,,0,0,0,,Мені өлгенше лекция оқып, бұл үйден қуып жібере жаздады.
Dialogue: 0,0:11:39.61,0:11:41.41,Default,,0,0,0,,Сіз кек сақтайсыз ба?
Dialogue: 0,0:11:41.49,0:11:43.66,Default,,0,0,0,,Көтеріліс фазасы деген осы емес пе?
Dialogue: 0,0:11:43.74,0:11:46.16,Default,,0,0,0,,Аа... сосын келесі
Dialogue: 0,0:11:46.24,0:11:48.16,Default,,0,0,0,,Жоғарыда айтқанымдай,
Dialogue: 0,0:11:48.25,0:11:50.62,Default,,0,0,0,,Әй, анамның естелігі дейсің бе?
Dialogue: 0,0:11:50.71,0:11:52.37,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:11:52.46,0:11:56.38,Default,,0,0,0,,Қарыз алғанымнан бері әкемнен қалталы ақша алған жоқпын.
Dialogue: 0,0:11:56.46,0:11:59.63,Default,,0,0,0,,Мен бұл үйдегі құндылықтардың қайда екенін жақсы білемін.
Dialogue: 0,0:11:59.71,0:12:01.84,Default,,0,0,0,,Бауырларыңа айтпа.
Dialogue: 0,0:12:02.43,0:12:04.09,Default,,0,0,0,,Мен де күткендей.
Dialogue: 0,0:12:04.18,0:12:07.35,Default,,0,0,0,,Мен анамның естелігін сатуды ойламаппын.
Dialogue: 0,0:12:07.43,0:12:09.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:09.39,0:12:13.23,Default,,0,0,0,,Жақында ағаңыздың немесе әйеліңіздің заттары өзгерді ме?
Dialogue: 0,0:12:13.31,0:12:16.52,Default,,0,0,0,,Біртүрлі нәрсе...
Dialogue: 0,0:12:16.61,0:12:20.94,Default,,0,0,0,,Айтпақшы, мен өткен күні Шейланың бөлмесінен біртүрлі қалта сағатын тауып алдым.
Dialogue: 0,0:12:21.61,0:12:24.74,Default,,0,0,0,,Алдыңғы жағына түрлі әшекейлер қойылған.
Dialogue: 0,0:12:24.82,0:12:26.70,Default,,0,0,0,,Қымбат болып көрінді.
Dialogue: 0,0:12:27.37,0:12:31.91,Default,,0,0,0,,Әкем сағат тақпайды, сондықтан оны әлдебір жігітке беріп жатқан болуы керек.
Dialogue: 0,0:12:32.00,0:12:35.67,Default,,0,0,0,,Маған бұл әйел қатты ұнамайды.
Dialogue: 0,0:12:35.75,0:12:37.75,Default,,0,0,0,,О, айтайын.
Dialogue: 0,0:12:37.84,0:12:41.17,Default,,0,0,0,,Әкемен ең көп қиналатын ағасы шығар, солай ма?
Dialogue: 0,0:12:41.26,0:12:43.05,Default,,0,0,0,,Бизнестегі сәтсіздік
Dialogue: 0,0:12:43.13,0:12:45.72,Default,,0,0,0,,«Мен саған отағасының мұрагерлігіне рұқсат бере алмаймын», - деді маған.
Dialogue: 0,0:12:45.80,0:12:47.68,Default,,0,0,0,,Өйткені менің тамырымда оның көп болғаны бар.
Dialogue: 0,0:12:47.76,0:12:49.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:02.53,0:13:03.86,Default,,0,0,0,,Иә
Dialogue: 0,0:13:07.32,0:13:08.53,Default,,0,0,0,,Ха! иә?
Dialogue: 0,0:13:08.62,0:13:09.74,Default,,0,0,0,,Әй, не болды...
Dialogue: 0,0:13:09.83,0:13:11.16,Default,,0,0,0,,Хмф, сағ...
Dialogue: 0,0:13:14.25,0:13:15.62,Default,,0,0,0,,Сол адам...!
Dialogue: 0,0:13:15.71,0:13:16.88,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:13:16.96,0:13:19.54,Default,,0,0,0,,Мынау... бұл оқиғаның сахнасы ма?
Dialogue: 0,0:13:19.63,0:13:20.75,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:13:21.34,0:13:22.92,Default,,0,0,0,,Бұл сыйлық па?
Dialogue: 0,0:13:23.01,0:13:25.22,Default,,0,0,0,,Бұл әділ шабуыл сияқты.
Dialogue: 0,0:13:25.93,0:13:28.72,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:13:28.80,0:13:31.26,Default,,0,0,0,,Мұны тексеру керек емес пе?
Dialogue: 0,0:13:31.35,0:13:33.23,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:13:34.89,0:13:36.94,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:13:37.02,0:13:38.86,Default,,0,0,0,,О, не?
Dialogue: 0,0:13:38.94,0:13:40.94,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:41.02,0:13:42.07,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:42.15,0:13:44.74,Default,,0,0,0,,Сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:13:44.82,0:13:46.57,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:13:46.66,0:13:48.91,Default,,0,0,0,,А, мен кешігіп қалдым.
Dialogue: 0,0:13:48.99,0:13:52.74,Default,,0,0,0,,Мен жеке детективтің көмекшісімін.
Dialogue: 0,0:13:52.83,0:13:55.21,Default,,0,0,0,,Менің атым Линн Рейнвейс.
Dialogue: 0,0:13:55.29,0:13:56.92,Default,,0,0,0,,Та... Детектив?
Dialogue: 0,0:13:57.00,0:13:58.58,Default,,0,0,0,,Ақиқатты сұрайын.
Dialogue: 0,0:13:58.67,0:14:01.21,Default,,0,0,0,,Шейла-сан және...
Dialogue: 0,0:14:01.29,0:14:03.30,Default,,0,0,0,,Сіздің ерекше қарым-қатынасыңыз бар ма?
Dialogue: 0,0:14:04.46,0:14:07.01,Default,,0,0,0,,Мен және Шейла ханым?
Dialogue: 0,0:14:07.09,0:14:10.80,Default,,0,0,0,,Жоқ, жоқ, бұл дұрыс емес.
Dialogue: 0,0:14:10.89,0:14:14.47,Default,,0,0,0,,А-а... Сонымен... Ал, бұрынғы алмасу ше?
Dialogue: 0,0:14:14.56,0:14:16.89,Default,,0,0,0,,А... Осыны меңзеп тұрсың ба?
Dialogue: 0,0:14:17.48,0:14:20.40,Default,,0,0,0,,Мен сіз тапсырыс берген заттарды жеткізіп тұрдым.
Dialogue: 0,0:14:20.48,0:14:22.36,Default,,0,0,0,,Тапсырыс берілген заттар?
Dialogue: 0,0:14:22.44,0:14:23.36,Default,,0,0,0,,Иә
Dialogue: 0,0:14:23.44,0:14:28.15,Default,,0,0,0,,Мен сіздің күйеуіңізге көмектесетін дәрі-дәрмектің бар-жоғы туралы кеңес сұрадым.
Dialogue: 0,0:14:28.24,0:14:29.32,Default,,0,0,0,,Не!
Dialogue: 0,0:14:29.91,0:14:33.54,Default,,0,0,0,,Ой, түсіндім... Солай ма?
Dialogue: 0,0:14:33.62,0:14:37.54,Default,,0,0,0,,Сіз шынымен керемет әйелсіз, солай емес пе?
Dialogue: 0,0:14:37.62,0:14:39.62,Default,,0,0,0,,Әйеліңізден жиі тапсырыс қабылдайсыз ба?
Dialogue: 0,0:14:39.71,0:14:40.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.63,0:14:42.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:42.29,0:14:45.76,Default,,0,0,0,,А... Иә, айына бір-екі рет.
Dialogue: 0,0:14:45.84,0:14:48.17,Default,,0,0,0,,Күйеуіңізбен іскерлік кездесудің соңында
Dialogue: 0,0:14:48.26,0:14:50.05,Default,,0,0,0,,Тағы қандай тапсырыстар аласыз?
Dialogue: 0,0:14:50.14,0:14:51.93,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:14:52.01,0:14:56.52,Default,,0,0,0,,Мен күнделікті тұрмысқа қажетті заттармен айналысамын, сондықтан шай жапырақтары мен парфюмерияларды жиі қолданамын.
Dialogue: 0,0:14:56.60,0:15:00.19,Default,,0,0,0,,Басқаларға ыдыс-аяқ, шамдар, гербицидтер жатады...
Dialogue: 0,0:15:00.27,0:15:04.73,Default,,0,0,0,,Мен топсаға май салуға да тапсырыс алдым.
Dialogue: 0,0:15:04.82,0:15:08.15,Default,,0,0,0,,Жиһазға да күтім жасайсың ба?
Dialogue: 0,0:15:08.24,0:15:11.57,Default,,0,0,0,,Сіз шынымен керемет әйелсіз.
Dialogue: 0,0:15:11.66,0:15:12.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.66,0:15:17.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:17.12,0:15:20.17,Default,,0,0,0,,Менің ойымша, іскерлік келіссөздер жақын арада аяқталады.
Dialogue: 0,0:15:20.25,0:15:21.46,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:15:21.54,0:15:23.92,Default,,0,0,0,,Мен екінші ұлым сыртқа шықты ма деп келдім.
Dialogue: 0,0:15:24.00,0:15:24.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.92,0:15:28.84,Default,,0,0,0,,Иә, екінші ұлым қала сыртында, бірақ...
Dialogue: 0,0:15:28.92,0:15:30.22,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:31.38,0:15:32.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:36.56,0:15:39.23,Default,,0,0,0,,Сонымен... тергеу туралы...
Dialogue: 0,0:15:39.31,0:15:40.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:41.02,0:15:44.27,Default,,0,0,0,,Кешіріңіз, ол бұзылған сияқты.
Dialogue: 0,0:15:41.02,0:15:44.27,Default,,0,0,0,,(есіктің итерілген дыбысы)
Dialogue: 0,0:15:44.36,0:15:45.90,Default,,0,0,0,,Неліктен жөндеуге болмайды?
Dialogue: 0,0:15:45.98,0:15:48.61,Default,,0,0,0,,Мен ебедейсіз болғандықтан...
Dialogue: 0,0:15:49.15,0:15:51.61,Default,,0,0,0,,Мен оны келесі жолы жөндеймін.
Dialogue: 0,0:15:53.49,0:15:54.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.12,0:16:01.41,Default,,0,0,0,,Бұл қандай фотосурет?
Dialogue: 0,0:16:01.50,0:16:02.58,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:02.67,0:16:06.25,Default,,0,0,0,,Бұл мен бұрын жұмыс істеген ауруханада науқаспен түскен суретім.
Dialogue: 0,0:16:09.05,0:16:10.34,Default,,0,0,0,,Ертең кеңсеге келіңіз.
Dialogue: 0,0:16:10.42,0:16:11.76,Default,,0,0,0,,Нәтижелер туралы есеп беру
Dialogue: 0,0:16:11.84,0:16:12.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.76,0:16:14.01,Default,,0,0,0,,А...
Dialogue: 0,0:16:14.09,0:16:16.39,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:16:16.47,0:16:19.10,Default,,0,0,0,,Айтыңызшы, Арне-сама!
Dialogue: 0,0:16:19.18,0:16:23.10,Default,,0,0,0,,Тергеу нәтижелері нені анықтады?
Dialogue: 0,0:16:23.19,0:16:26.31,Default,,0,0,0,,Неліктен сіз бұл туралы кейде өзіңіз ойламайсыз?
Dialogue: 0,0:16:26.40,0:16:27.61,Default,,0,0,0,,Керемет детектив?
Dialogue: 0,0:16:27.69,0:16:29.86,Default,,0,0,0,,Грр... Гунну (Эми) Гунну
Dialogue: 0,0:16:29.94,0:16:31.32,Default,,0,0,0,,Ах
Dialogue: 0,0:16:31.40,0:16:35.82,Default,,0,0,0,,Ұлдарының бәрінің күйеуіне өшпенділігі бар...
Dialogue: 0,0:16:35.91,0:16:39.49,Default,,0,0,0,,Бұл жай ғана оқыс оқиға емес еді ғой?
Dialogue: 0,0:16:40.91,0:16:44.21,Default,,0,0,0,,Сондай-ақ, әйтеуір Шейла-сан...
Dialogue: 0,0:16:44.29,0:16:47.13,Default,,0,0,0,,Мүмкін мен өзімнен озып кеткен шығармын.
Dialogue: 0,0:16:47.92,0:16:50.09,Default,,0,0,0,,Не? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:16:50.17,0:16:51.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:54.18,0:16:56.22,Default,,0,0,0,,Дәлірек айтқанда, Арне мырза.
Dialogue: 0,0:16:56.30,0:16:59.51,Default,,0,0,0,,Күйеуіңмен неге тікелей сөйлеспейсің?
Dialogue: 0,0:16:59.60,0:17:01.52,Default,,0,0,0,,Сөйлей алмасаң да, жазбаша сөйлесе аласың...
Dialogue: 0,0:17:01.60,0:17:03.23,Default,,0,0,0,,Өйткені оның мағынасы жоқ.
Dialogue: 0,0:17:03.31,0:17:05.98,Default,,0,0,0,,Не? Бұл мағынасы жоқ па?
Dialogue: 0,0:17:31.00,0:17:32.17,Default,,0,0,0,,Осы үш күн
Dialogue: 0,0:17:32.26,0:17:36.13,Default,,0,0,0,,Маған сол ағаның қимылын бақылауға рұқсат етілді.
Dialogue: 0,0:17:36.22,0:17:39.18,Default,,0,0,0,,Бақылау...?
Dialogue: 0,0:17:39.26,0:17:42.56,Default,,0,0,0,,Мен өз қанымды басқара аламын
Dialogue: 0,0:17:44.18,0:17:46.81,Default,,0,0,0,,Менің қанымды сол үш адамға сал.
Dialogue: 0,0:17:46.90,0:17:49.94,Default,,0,0,0,,Күн сайын түнде қай бөлмеде ұйықтайтынымды зерттедім.
Dialogue: 0,0:17:50.02,0:17:51.40,Default,,0,0,0,,А...
Dialogue: 0,0:17:51.48,0:17:52.69,Default,,0,0,0,,Нәтижесінде…
Dialogue: 0,0:17:54.57,0:17:55.70,Default,,0,0,0,,Сол үш адам
Dialogue: 0,0:17:56.61,0:17:59.41,Default,,0,0,0,,Шебердің бөлмесінде кезектесіп ұйықтайтын көрінеді.
Dialogue: 0,0:17:59.49,0:18:01.28,Default,,0,0,0,,Ха... иә...
Dialogue: 0,0:18:01.37,0:18:03.45,Default,,0,0,0,,Барлық бауырлар
Dialogue: 0,0:18:03.54,0:18:07.50,Default,,0,0,0,,Демек, ол өзінің қожайыны бар сияқты әрекет етті.
Dialogue: 0,0:18:07.58,0:18:10.42,Default,,0,0,0,,Сонымен... Сонда шебер...
Dialogue: 0,0:18:10.50,0:18:12.21,Default,,0,0,0,,Апат болған күн
Dialogue: 0,0:18:12.30,0:18:14.21,Default,,0,0,0,,Оны сол үш адам өлтірген болуы керек.
Dialogue: 0,0:18:14.30,0:18:15.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:15.51,0:18:16.59,Default,,0,0,0,,А...
Dialogue: 0,0:18:16.67,0:18:20.85,Default,,0,0,0,,Ауланың бір бұрышында қан иісі аңқып тұрған жер екен.
Dialogue: 0,0:18:21.76,0:18:23.56,Default,,0,0,0,,Мәйіт сонда шығар.
Dialogue: 0,0:18:23.64,0:18:25.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:25.27,0:18:29.56,Default,,0,0,0,,Бұл бір-екі ай өлген адамның мәйітіне ұқсайды.
Dialogue: 0,0:18:29.65,0:18:32.19,Default,,0,0,0,,Шейла...
Dialogue: 0,0:18:32.27,0:18:34.11,Default,,0,0,0,,Бұл тергеу үшін.
Dialogue: 0,0:18:34.19,0:18:35.24,Default,,0,0,0,,Үйге бара аласыз.
Dialogue: 0,0:18:35.32,0:18:37.07,Default,,0,0,0,,Эй... Арне-сама!
Dialogue: 0,0:18:37.15,0:18:40.99,Default,,0,0,0,,Кісі өлтірушінің үйіне бару тым көп!
Dialogue: 0,0:18:41.07,0:18:43.45,Default,,0,0,0,,Детективтің жұмысы сұранысты орындау.
Dialogue: 0,0:18:43.54,0:18:46.16,Default,,0,0,0,,Ал... бұл рас.
Dialogue: 0,0:18:46.25,0:18:49.58,Default,,0,0,0,,Клиентті өлі қалдыру...
Dialogue: 0,0:18:52.00,0:18:55.09,Default,,0,0,0,,Жарайды, мен саған бір түн қалуға рұқсат етемін.
Dialogue: 0,0:18:55.17,0:18:57.80,Default,,0,0,0,,Қосымша сұрақтар бойынша Хиттсуджиден кеңес алыңыз.
Dialogue: 0,0:18:57.88,0:18:59.80,Default,,0,0,0,,Құрметті Арне...
Dialogue: 0,0:19:00.64,0:19:02.10,Default,,0,0,0,,Алайда...
Dialogue: 0,0:19:02.18,0:19:05.81,Default,,0,0,0,,Бәрін тастап, босатсам ғой
Dialogue: 0,0:19:07.68,0:19:09.94,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:19:10.02,0:19:12.44,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:12.52,0:19:14.65,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:17.90,0:19:20.53,Default,,0,0,0,,(Шейланың қатты тыныс алуы)
Dialogue: 0,0:19:26.91,0:19:30.29,Default,,0,0,0,,Расымен барған дұрыс па?
Dialogue: 0,0:19:30.87,0:19:32.50,Default,,0,0,0,,«Жақында жүргізілген тергеуде»
Dialogue: 0,0:19:32.58,0:19:35.25,Default,,0,0,0,,«Қажетсіз түсініспеушілік тудырғаным үшін кешірім сұраймын».
Dialogue: 0,0:19:35.34,0:19:37.34,Default,,0,0,0,,«Кешірім сұраймын»
Dialogue: 0,0:19:37.42,0:19:42.09,Default,,0,0,0,,«Кез келген түсініспеушілікті жою үшін мұражайға қайта келіңіз».
Dialogue: 0,0:19:42.18,0:19:45.51,Default,,0,0,0,,«Сізді бүкіл отбасы күтуде».
Dialogue: 0,0:19:45.60,0:19:49.85,Default,,0,0,0,,Уайымдама, мен және Цвэй осындамыз.
Dialogue: 0,0:19:49.93,0:19:51.77,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:19:52.35,0:19:55.19,Default,,0,0,0,,Мен де Шейла үшін алаңдаймын.
Dialogue: 0,0:19:59.65,0:20:02.24,Default,,0,0,0,,Не болды? Екеуміз де
Dialogue: 0,0:20:02.32,0:20:03.99,Default,,0,0,0,,Сәлем, Рин Чан
Dialogue: 0,0:20:04.07,0:20:06.66,Default,,0,0,0,,Ойланып қарасаң, құр қол едік.
Dialogue: 0,0:20:06.74,0:20:07.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.66,0:20:08.49,Default,,0,0,0,,Жүр, тәттілер сатып алайық.
Dialogue: 0,0:20:08.49,0:20:10.16,Default,,0,0,0,,Жүр, кәмпиттер сатып алайық.
Dialogue: 0,0:20:08.49,0:20:10.16,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:20:10.25,0:20:11.41,Default,,0,0,0,,Иә
Dialogue: 0,0:20:11.50,0:20:13.50,Default,,0,0,0,,Дедеде... күт... күте тұр?
Dialogue: 0,0:20:18.59,0:20:21.34,Default,,0,0,0,,Қош келдіңіз, біз сізді күттік.
Dialogue: 0,0:20:21.42,0:20:23.01,Default,,0,0,0,,Бүгін жалғызсың ба?
Dialogue: 0,0:20:23.09,0:20:25.09,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:20:25.76,0:20:27.72,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:20:27.81,0:20:30.02,Default,,0,0,0,,Яғни, сен біреуді тергеп жүріп сол автобусқа түсіп қалдың ғой, иә?
Dialogue: 0,0:20:30.10,0:20:32.10,Default,,0,0,0,,Шейладан естіген
Dialogue: 0,0:20:32.19,0:20:37.19,Default,,0,0,0,,Менің ойымша, біз өзімізге қатысты қажетсіз түсініспеушілік тудырдық.
Dialogue: 0,0:20:37.27,0:20:39.03,Default,,0,0,0,,Бұл ханымға не болды?
Dialogue: 0,0:20:39.11,0:20:40.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:41.07,0:20:43.15,Default,,0,0,0,,Мен дұрыс емес уақытта шықтым.
Dialogue: 0,0:20:43.95,0:20:45.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:45.87,0:20:47.08,Default,,0,0,0,,Осыны қарасаңыз
Dialogue: 0,0:20:47.16,0:20:50.50,Default,,0,0,0,,Сіз біздің кінәсіз екенімізді білесіз.
Dialogue: 0,0:20:50.58,0:20:52.87,Default,,0,0,0,,Әке, мен ашамын.
Dialogue: 0,0:21:00.67,0:21:04.05,Default,,0,0,0,,Менің әкемнің қайтыс болғанын дұрыс түсінбедің деп ойлаймын.
Dialogue: 0,0:21:04.13,0:21:05.80,Default,,0,0,0,,Мынадай қарашы
Dialogue: 0,0:21:06.93,0:21:08.26,Default,,0,0,0,,Менің әкем осында.
Dialogue: 0,0:21:08.35,0:21:09.31,Default,,0,0,0,,Неге әкеңмен бірге шомылмайсың?
Dialogue: 0,0:21:24.99,0:21:29.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:48.36,0:22:53.87,Default,,0,0,0,,～♪
