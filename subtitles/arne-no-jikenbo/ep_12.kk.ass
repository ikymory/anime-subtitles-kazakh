Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.50,0:00:06.21,Default,,0,0,0,,Оны ұрып, сындырыңыз...
Dialogue: 0,0:00:06.29,0:00:07.67,Default,,0,0,0,,Кеттік
Dialogue: 0,0:00:07.75,0:00:09.67,Default,,0,0,0,,Evily!
Dialogue: 0,0:00:09.76,0:00:12.05,Default,,0,0,0,,Қанды!
Dialogue: 0,0:00:12.80,0:00:15.30,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:16.51,0:00:22.02,Default,,0,0,0,,Белгілеуші!
Dialogue: 0,0:00:36.70,0:00:37.83,Default,,0,0,0,,Сол балалар
Dialogue: 0,0:00:37.91,0:00:41.62,Default,,0,0,0,,Сіз Рин-Чанның күзетшісі ретінде әрекет етесіз бе?
Dialogue: 0,0:00:44.87,0:00:48.71,Default,,0,0,0,,Рин-чанды қорғаңыз! Ооо!
Dialogue: 0,0:00:48.79,0:00:50.80,Default,,0,0,0,,үшінңызға рахмет!
Dialogue: 0,0:00:48.79,0:00:50.80,Default,,0,0,0,,Келіңдер, келіңдер!
Dialogue: 0,0:00:51.80,0:00:53.05,Default,,0,0,0,,Қызыл телпек!
Dialogue: 0,0:00:53.13,0:00:55.55,Default,,0,0,0,,Мықты бол, Қызыл телпек!
Dialogue: 0,0:00:55.63,0:00:58.89,Default,,0,0,0,,Хмм... Рин-сама?
Dialogue: 0,0:00:58.97,0:01:00.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:00.47,0:01:02.52,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:01:02.60,0:01:06.27,Default,,0,0,0,,Мен біреумен ұрысып қалдым, Реа.
Dialogue: 0,0:01:06.35,0:01:07.98,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:01:08.06,0:01:09.48,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:01:09.57,0:01:11.19,Default,,0,0,0,,Дұрыс, сол сурет!
Dialogue: 0,0:01:11.28,0:01:12.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:12.94,0:01:14.24,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:14.32,0:01:15.86,Default,,0,0,0,,Бұл қандай сурет болды?
Dialogue: 0,0:01:15.95,0:01:17.91,Default,,0,0,0,,Маған не болды
Dialogue: 0,0:01:17.99,0:01:21.16,Default,,0,0,0,,Мен абайсызда ұсталып, анық көрмедім.
Dialogue: 0,0:01:21.16,0:01:21.62,Default,,0,0,0,,Мен абайсызда ұсталып, анық көрмедім.
Dialogue: 0,0:01:21.16,0:01:21.62,Default,,0,0,0,,А... бұл қауіпті, Рин-чан!
Dialogue: 0,0:01:21.62,0:01:22.83,Default,,0,0,0,,А... бұл қауіпті, Рин-чан!
Dialogue: 0,0:01:22.91,0:01:23.75,Default,,0,0,0,,Хамф!
Dialogue: 0,0:01:27.25,0:01:29.50,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:01:29.59,0:01:33.13,Default,,0,0,0,,Жоқ, бұл жай ғана жақсылықтың кішкентай, тамаша қайтарымы.
Dialogue: 0,0:01:35.13,0:01:36.13,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:01:37.34,0:01:39.09,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,0:01:40.93,0:01:42.85,Default,,0,0,0,,~ орнатыңыз
Dialogue: 0,0:01:42.93,0:01:44.43,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:01:55.90,0:01:58.86,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:02:00.70,0:02:04.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:12.50,0:02:13.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:15.55,0:02:16.55,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:19.22,0:02:20.30,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:20.39,0:02:21.76,Default,,0,0,0,,Мұндағы суреттің алдында
Dialogue: 0,0:02:21.85,0:02:25.06,Default,,0,0,0,,Сол жерде бір адам тұрды.
Dialogue: 0,0:02:26.56,0:02:30.10,Default,,0,0,0,,Сурет қанды қалағандай болды.
Dialogue: 0,0:02:31.56,0:02:35.03,Default,,0,0,0,,Керемет емес, балғын және алдамшы қан иісі бар.
Dialogue: 0,0:02:35.11,0:02:37.40,Default,,0,0,0,,Бөлме толы болды
Dialogue: 0,0:02:37.49,0:02:39.15,Default,,0,0,0,,Суреттегі қан...
Dialogue: 0,0:02:39.95,0:02:41.82,Default,,0,0,0,,Рин мырза, келесі...
Dialogue: 0,0:02:41.91,0:02:44.16,Default,,0,0,0,,Әрине, Арне-самаға барыңыз.
Dialogue: 0,0:02:44.24,0:02:48.00,Default,,0,0,0,,Вампирді құтқарудың керемет миссиясы!
Dialogue: 0,0:02:48.08,0:02:49.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:49.79,0:02:51.46,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:02:51.54,0:02:52.67,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:02:53.54,0:02:54.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:55.05,0:02:56.51,Default,,0,0,0,,Құрметті Арне!
Dialogue: 0,0:03:00.59,0:03:03.30,Default,,0,0,0,,Міне, осы уақытқа дейін жеттіңіз.
Dialogue: 0,0:03:03.39,0:03:04.60,Default,,0,0,0,,Мен сізді мақтауға рұқсат етіңіз.
Dialogue: 0,0:03:04.68,0:03:06.31,Default,,0,0,0,,(Джунпей) Бірақ ол мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:03:06.39,0:03:08.56,Default,,0,0,0,,Мен Арне-саманың көмекшісімін.
Dialogue: 0,0:03:08.64,0:03:12.27,Default,,0,0,0,,Олай болса... өлейін.
Dialogue: 0,0:03:12.90,0:03:14.23,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:03:14.32,0:03:18.07,Default,,0,0,0,,Бірде мені аңдып, тосын шабуыл жасады.
Dialogue: 0,0:03:18.15,0:03:20.15,Default,,0,0,0,,Бұл жолы, бұл елес ұры, Қызыл телпек
Dialogue: 0,0:03:20.24,0:03:21.53,Default,,0,0,0,,Даңқты жеңіске жетейік!
Dialogue: 0,0:03:21.61,0:03:24.12,Default,,0,0,0,,Рин-чан, мұны маған қалдыр.
Dialogue: 0,0:03:28.62,0:03:29.62,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:03:37.92,0:03:39.01,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:03:42.47,0:03:44.93,Default,,0,0,0,,Мен қазір барамын, Арне-сама.
Dialogue: 0,0:03:46.81,0:03:47.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:54.44,0:03:55.27,Default,,0,0,0,,Иә
Dialogue: 0,0:03:57.61,0:03:58.90,Default,,0,0,0,,Кя!
Dialogue: 0,0:03:59.90,0:04:00.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.03,0:04:02.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:13.50,0:04:16.92,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:04:17.00,0:04:18.59,Default,,0,0,0,,Рин-чан...
Dialogue: 0,0:04:18.67,0:04:19.92,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:04:25.09,0:04:26.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:27.01,0:04:27.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:29.18,0:04:30.35,Default,,0,0,0,,Зомби мырза!
Dialogue: 0,0:04:31.02,0:04:33.35,Default,,0,0,0,,Рин-чан...
Dialogue: 0,0:04:33.44,0:04:35.90,Default,,0,0,0,,Қорғалған...
Dialogue: 0,0:04:38.94,0:04:41.11,Default,,0,0,0,,Зомби мырза...
Dialogue: 0,0:04:43.24,0:04:45.20,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:49.83,0:04:51.95,Default,,0,0,0,,Арне-саманы қайтарыңыз.
Dialogue: 0,0:04:53.96,0:04:54.92,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:55.75,0:04:58.84,Default,,0,0,0,,Енді сені қорғайтын достар жоқ.
Dialogue: 0,0:04:58.92,0:05:02.55,Default,,0,0,0,,Дегенмен, егер сіз Nointator-ты қайтарып алсаңыз ше?
Dialogue: 0,0:05:10.76,0:05:12.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.22,0:05:13.35,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:05:13.93,0:05:17.44,Default,,0,0,0,,Сен менің қуыршағымсың.
Dialogue: 0,0:05:22.90,0:05:25.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:30.99,0:05:33.00,Default,,0,0,0,,Менің денем өз ісін жасайды...
Dialogue: 0,0:05:33.08,0:05:33.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:47.13,0:05:50.93,Default,,0,0,0,,Неліктен сен оған көмектесу үшін барын салар едің?
Dialogue: 0,0:05:51.01,0:05:52.39,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:05:52.47,0:05:56.14,Default,,0,0,0,,Лорд Арне - ең күшті вампир, Nointator.
Dialogue: 0,0:05:56.23,0:05:59.65,Default,,0,0,0,,Өйткені ол сенім мен құрметке лайық ұлы детектив.
Dialogue: 0,0:06:00.65,0:06:03.36,Default,,0,0,0,,Сенім және құрмет…
Dialogue: 0,0:06:03.98,0:06:05.74,Default,,0,0,0,,Және де Арне-сама
Dialogue: 0,0:06:05.82,0:06:08.74,Default,,0,0,0,,Сіз маған көмекші ретінде сенесіз.
Dialogue: 0,0:06:08.82,0:06:11.87,Default,,0,0,0,,Сондықтан мен сол сенімді ақтауым керек.
Dialogue: 0,0:06:11.95,0:06:13.33,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:13.41,0:06:17.71,Default,,0,0,0,,Вампирлер - әлемдегі барлық нәрсені басқаратын ең жоғарғы тіршілік иелері.
Dialogue: 0,0:06:17.79,0:06:22.17,Default,,0,0,0,,Біз үшін адам мал, тамақтан басқа ештеңе емес.
Dialogue: 0,0:06:22.25,0:06:26.38,Default,,0,0,0,,Мен мұндай адамға сене алмаймын.
Dialogue: 0,0:06:26.47,0:06:28.59,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:06:28.68,0:06:31.55,Default,,0,0,0,,Арне-сама, маған ештеңе айтпашы.
Dialogue: 0,0:06:31.64,0:06:33.60,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:06:34.26,0:06:37.18,Default,,0,0,0,,Бұл вампир немесе адам болғандықтан.
Dialogue: 0,0:06:37.27,0:06:40.35,Default,,0,0,0,,Мұндай тар ойлаудан алыс
Dialogue: 0,0:06:40.44,0:06:43.19,Default,,0,0,0,,Мастер Арне маған өзім сияқты қарайды.
Dialogue: 0,0:06:44.02,0:06:47.03,Default,,0,0,0,,Ол мені Линн Рейнвейс ретінде көреді.
Dialogue: 0,0:06:47.61,0:06:49.07,Default,,0,0,0,,Бұл Влад.
Dialogue: 0,0:06:49.15,0:06:52.37,Default,,0,0,0,,Арне-сама екеуіңнің арасында үлкен айырмашылық бар.
Dialogue: 0,0:06:52.95,0:06:56.08,Default,,0,0,0,,Аа... қате түсінетініңізге сенімдімін.
Dialogue: 0,0:06:56.83,0:06:59.71,Default,,0,0,0,,Нонтатор сізді өзінің көмекшісі етті.
Dialogue: 0,0:06:59.79,0:07:02.75,Default,,0,0,0,,Бұл сіздің пайдалану құндылығыңыз бар деп ойлаймын.
Dialogue: 0,0:07:08.80,0:07:10.68,Default,,0,0,0,,Егер солай болса, онда мен...
Dialogue: 0,0:07:10.76,0:07:13.85,Default,,0,0,0,,Менде бар пайдалылық мәні
Dialogue: 0,0:07:13.93,0:07:16.01,Default,,0,0,0,,Мен шынымен мақтанамын!
Dialogue: 0,0:07:21.65,0:07:23.86,Default,,0,0,0,,Онда мен саған көрсетемін.
Dialogue: 0,0:07:23.94,0:07:27.86,Default,,0,0,0,,Сізге тағайындаушының өлімі
Dialogue: 0,0:07:30.28,0:07:31.53,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:07:31.61,0:07:34.66,Default,,0,0,0,,Би болса, мен оны әдемі орындаймын.
Dialogue: 0,0:07:34.74,0:07:36.79,Default,,0,0,0,,Мен сенің серігің боламын!
Dialogue: 0,0:07:39.96,0:07:41.58,Default,,0,0,0,,Жүр, Рин-сама, тезірек!
Dialogue: 0,0:07:41.67,0:07:43.13,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:07:45.38,0:07:50.38,Default,,0,0,0,,(Риннің қатты тыныс алуы)
Dialogue: 0,0:07:55.10,0:07:56.97,Default,,0,0,0,,Құрметті Арне...
Dialogue: 0,0:07:57.06,0:07:58.68,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:07:59.64,0:08:01.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:01.39,0:08:02.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.57,0:08:08.57,Default,,0,0,0,,Құрметті Арне!
Dialogue: 0,0:08:08.65,0:08:10.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:10.61,0:08:12.82,Default,,0,0,0,,Жоқ... не? Біз қайдамыз?
Dialogue: 0,0:08:12.91,0:08:14.16,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:08:14.24,0:08:17.62,Default,,0,0,0,,Кешіріңіз! Мен аздап тайып кеттім
Dialogue: 0,0:08:21.37,0:08:22.21,Default,,0,0,0,,Маған қарыз бер
Dialogue: 0,0:08:22.29,0:08:24.33,Default,,0,0,0,,Не? Мынау
Dialogue: 0,0:08:26.13,0:08:27.50,Default,,0,0,0,,(Лақтыру дыбысы)
Dialogue: 0,0:08:28.50,0:08:29.55,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:08:29.63,0:08:30.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.55,0:08:31.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:30.55,0:08:31.67,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:08:41.10,0:08:44.44,Default,,0,0,0,,Гя гя гя гя...!
Dialogue: 0,0:08:45.60,0:08:49.69,Default,,0,0,0,,Қайтып келді!
Dialogue: 0,0:08:51.65,0:08:54.36,Default,,0,0,0,,...
Dialogue: 0,0:08:54.45,0:08:57.07,Default,,0,0,0,,Тағы кездескенше, Влад.
Dialogue: 0,0:08:59.24,0:09:02.20,Default,,0,0,0,,Сіз... Начзеллерсіз бе?
Dialogue: 0,0:09:02.29,0:09:04.29,Default,,0,0,0,,Жаңа ғана есіңізде ме?
Dialogue: 0,0:09:04.37,0:09:07.75,Default,,0,0,0,,Мен қатты ашуландым!
Dialogue: 0,0:09:17.47,0:09:19.35,Default,,0,0,0,,(Начзелердің күлкісі)
Dialogue: 0,0:09:26.48,0:09:28.44,Default,,0,0,0,,...
Dialogue: 0,0:09:28.52,0:09:30.82,Default,,0,0,0,,Өйткені, бұл дене ең жақсы.
Dialogue: 0,0:09:30.90,0:09:32.73,Default,,0,0,0,,Бұл жақсы уақытты өзгерту.
Dialogue: 0,0:09:32.82,0:09:33.99,Default,,0,0,0,,Толтырылған жануар!
Dialogue: 0,0:09:34.07,0:09:35.70,Default,,0,0,0,,Тұлып кім?
Dialogue: 0,0:09:35.78,0:09:36.95,Default,,0,0,0,,Тұлып емес
Dialogue: 0,0:09:37.95,0:09:38.95,Default,,0,0,0,,Иә
Dialogue: 0,0:09:39.78,0:09:41.79,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:09:45.87,0:09:48.33,Default,,0,0,0,,Сен мені өлгенше жейсің!
Dialogue: 0,0:09:48.42,0:09:49.25,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.76,0:10:01.39,Default,,0,0,0,,Қызыл ай...
Dialogue: 0,0:10:02.39,0:10:05.06,Default,,0,0,0,,Бұл түнде ай сияқты.
Dialogue: 0,0:10:05.93,0:10:09.35,Default,,0,0,0,,Лорд Арне мені осы кішкентай әлемнен алып кетті.
Dialogue: 0,0:10:09.44,0:10:13.44,Default,,0,0,0,,Сол түнде мені сыртқа шығарған ай
Dialogue: 0,0:10:17.53,0:10:20.03,Default,,0,0,0,,А... Арне-сама?
Dialogue: 0,0:10:40.51,0:10:42.93,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:10:43.68,0:10:44.51,Default,,0,0,0,,Себеп
Dialogue: 0,0:10:45.22,0:10:46.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:49.60,0:10:52.23,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:53.52,0:10:54.44,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:10:54.52,0:10:55.73,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:10:55.82,0:10:56.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:01.45,0:11:04.66,Default,,0,0,0,,Қанша күшті болса да, тым күшті.
Dialogue: 0,0:11:04.74,0:11:07.04,Default,,0,0,0,,Бұл жігіттің... жүрегі жоқ.
Dialogue: 0,0:11:07.12,0:11:07.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:09.62,0:11:11.42,Default,,0,0,0,,Мен одан шаршадым.
Dialogue: 0,0:11:17.92,0:11:19.17,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:25.81,0:11:27.14,Default,,0,0,0,,Чи…
Dialogue: 0,0:11:27.22,0:11:29.73,Default,,0,0,0,,Ә? Бөлме…
Dialogue: 0,0:11:31.81,0:11:35.23,Default,,0,0,0,,Қан жеткіліксіз...
Dialogue: 0,0:11:42.16,0:11:43.91,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,0:11:43.99,0:11:44.99,Default,,0,0,0,,Реа!
Dialogue: 0,0:11:45.08,0:11:47.24,Default,,0,0,0,,Наха-чан! Эми!
Dialogue: 0,0:11:49.66,0:11:51.25,Default,,0,0,0,,Жамандық!
Dialogue: 0,0:11:51.79,0:11:53.38,Default,,0,0,0,,Қанды!
Dialogue: 0,0:11:53.46,0:11:56.71,Default,,0,0,0,,Фантастикалық Нонтатор!
Dialogue: 0,0:11:56.80,0:11:59.01,Default,,0,0,0,,Ең нашар! жеңілмейтін!
Dialogue: 0,0:11:59.09,0:12:02.76,Default,,0,0,0,,Мен бәріңді жақсы көремін! Вампир!
Dialogue: 0,0:12:02.84,0:12:04.51,Default,,0,0,0,,Иә! Зорлық-зомбылық жасамаңыз
Dialogue: 0,0:12:04.59,0:12:05.60,Default,,0,0,0,,Ваа
Dialogue: 0,0:12:05.68,0:12:07.85,Default,,0,0,0,,Бұл, әрине, ұятыңызды жасырудың жолы!
Dialogue: 0,0:12:08.43,0:12:10.31,Default,,0,0,0,,Рин-чан Арне!
Dialogue: 0,0:12:14.35,0:12:16.90,Default,,0,0,0,,Түс, Рин Рейнвейс.
Dialogue: 0,0:12:16.98,0:12:18.23,Default,,0,0,0,,Иә
Dialogue: 0,0:12:18.94,0:12:22.95,Default,,0,0,0,,Тағы да тұтқында болғың келе ме? Нейтатор
Dialogue: 0,0:12:23.03,0:12:24.87,Default,,0,0,0,,«Тұтқынға алынды»?
Dialogue: 0,0:12:24.95,0:12:27.66,Default,,0,0,0,,Жақсы ұйықтай алу керемет болды.
Dialogue: 0,0:12:40.05,0:12:41.59,Default,,0,0,0,,Құрметті Арне...
Dialogue: 0,0:12:42.30,0:12:43.72,Default,,0,0,0,,Іздеу
Dialogue: 0,0:12:50.93,0:12:51.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:15.96,0:13:17.46,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:13:17.54,0:13:19.67,Default,,0,0,0,,(Риннің қатты тыныс алуы)
Dialogue: 0,0:13:36.85,0:13:38.77,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:13:39.90,0:13:40.73,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:50.45,0:13:52.41,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:14:07.38,0:14:08.22,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:14:17.64,0:14:20.65,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:22.07,0:14:23.57,Default,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,0:14:24.15,0:14:26.49,Default,,0,0,0,,Бірақ оның шегі бар сияқты.
Dialogue: 0,0:14:26.57,0:14:28.53,Default,,0,0,0,,А... мүмкін емес
Dialogue: 0,0:14:29.36,0:14:31.74,Default,,0,0,0,,Сіздің көмекшіңіз жақсы нәрсе тапқан сияқты.
Dialogue: 0,0:14:40.00,0:14:44.38,Default,,0,0,0,,(Риннің қатты тыныс алуы)
Dialogue: 0,0:14:45.21,0:14:46.34,Default,,0,0,0,,Бірақ осы бағытты лақтырсам, қашықтығы шамамен 20 метр болады.
Dialogue: 0,0:14:47.38,0:14:48.68,Default,,0,0,0,,Иә
Dialogue: 0,0:14:48.76,0:14:51.64,Default,,0,0,0,,Владтың өзінің портреті.
Dialogue: 0,0:14:51.72,0:14:54.18,Default,,0,0,0,,Мен оның осында екенін білдім.
Dialogue: 0,0:14:54.26,0:14:57.60,Default,,0,0,0,,Бұл құлыптың барлық қабат жоспарлары есімде.
Dialogue: 0,0:14:57.68,0:15:00.60,Default,,0,0,0,,Бұрын бұл аймақты сырттан көргенімде.
Dialogue: 0,0:15:00.69,0:15:03.61,Default,,0,0,0,,Мен еден жоспарымен шамалы сәйкессіздікті сезіндім.
Dialogue: 0,0:15:03.69,0:15:06.28,Default,,0,0,0,,Бұл жасырын бөлме болуы керек.
Dialogue: 0,0:15:06.36,0:15:09.49,Default,,0,0,0,,Сондықтан еден жоспарында сызбаған.
Dialogue: 0,0:15:09.57,0:15:12.82,Default,,0,0,0,,Бірақ мен вампир отакумын.
Dialogue: 0,0:15:12.91,0:15:16.75,Default,,0,0,0,,Рин Рейнвейстің көзін алдауға болмайды!
Dialogue: 0,0:15:23.29,0:15:24.46,Default,,0,0,0,,Ууу!!
Dialogue: 0,0:15:24.54,0:15:25.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:27.21,0:15:28.05,Default,,0,0,0,,Иә
Dialogue: 0,0:15:30.38,0:15:31.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:35.89,0:15:37.02,Default,,0,0,0,,Лин мырза!
Dialogue: 0,0:15:42.02,0:15:43.73,Default,,0,0,0,,Тоқтаңыз, Лин мырза.
Dialogue: 0,0:15:51.74,0:15:53.37,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:54.16,0:15:55.33,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:15:56.03,0:15:57.04,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:57.12,0:15:58.79,Default,,0,0,0,,Тоқтаймыз
Dialogue: 0,0:15:58.87,0:16:00.75,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:00.83,0:16:02.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:02.58,0:16:03.71,Default,,0,0,0,,Ауа райы тамаша, иә~
Dialogue: 0,0:16:05.96,0:16:08.25,Default,,0,0,0,,Тоқтата аласыз ба?
Dialogue: 0,0:16:08.34,0:16:09.92,Default,,0,0,0,,Рин ханым
Dialogue: 0,0:16:16.81,0:16:17.81,Default,,0,0,0,,Лин
Dialogue: 0,0:16:25.40,0:16:26.40,Default,,0,0,0,,Лин
Dialogue: 0,0:16:26.48,0:16:28.48,Default,,0,0,0,,Менің сүйкімді Рин
Dialogue: 0,0:16:29.53,0:16:31.65,Default,,0,0,0,,Жүр, мұнда кел.
Dialogue: 0,0:16:33.95,0:16:35.49,Default,,0,0,0,,Әке...
Dialogue: 0,0:16:52.05,0:16:53.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:03.10,0:17:05.85,Default,,0,0,0,,Сіз менің әкем емессіз
Dialogue: 0,0:17:07.19,0:17:08.44,Default,,0,0,0,,Лин?
Dialogue: 0,0:17:09.61,0:17:11.65,Default,,0,0,0,,Бұл зұлымдықтан сақтандыратын бойтұмар.
Dialogue: 0,0:17:11.74,0:17:14.15,Default,,0,0,0,,Тиімділігін Наха-чан тексеріп қойған!
Dialogue: 0,0:17:14.78,0:17:17.28,Default,,0,0,0,,Бұл сізге де жұмыс істейтін сияқты.
Dialogue: 0,0:17:17.87,0:17:20.24,Default,,0,0,0,,Жоқ... не істейсің?
Dialogue: 0,0:17:20.33,0:17:23.71,Default,,0,0,0,,Сіз осылай жасайсыз...!
Dialogue: 0,0:17:30.71,0:17:33.34,Default,,0,0,0,,Арх... Арх!
Dialogue: 0,0:17:34.09,0:17:36.30,Default,,0,0,0,,Гаа... Ха ха...
Dialogue: 0,0:17:36.97,0:17:40.05,Default,,0,0,0,,Бұл жай бойтұмар емес.
Dialogue: 0,0:17:40.14,0:17:42.89,Default,,0,0,0,,Күміс бояуы ерітілген қасиетті су.
Dialogue: 0,0:17:43.56,0:17:45.85,Default,,0,0,0,,Күміс пен қасиетті су ше?
Dialogue: 0,0:17:45.94,0:17:49.86,Default,,0,0,0,,Күміс де, қасиетті су да вампирлердің әлсіз тұсы!
Dialogue: 0,0:17:49.94,0:17:51.19,Default,,0,0,0,,Парасаттылық!
Dialogue: 0,0:17:51.27,0:17:53.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:55.20,0:17:56.74,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:17:57.32,0:17:58.62,Default,,0,0,0,,Влад III…
Dialogue: 0,0:17:58.70,0:18:02.12,Default,,0,0,0,,Влад Тепес бағаналы лорд
Dialogue: 0,0:18:02.20,0:18:04.00,Default,,0,0,0,,Және…
Dialogue: 0,0:18:02.20,0:18:04.00,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:18:04.00,0:18:04.08,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:18:04.08,0:18:06.96,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:18:04.08,0:18:06.96,Default,,0,0,0,,Тоғыз вампир патшаның бірі
Dialogue: 0,0:18:07.92,0:18:10.21,Default,,0,0,0,,Дракуланың жүрегін санаңыз!
Dialogue: 0,0:18:10.29,0:18:12.42,Default,,0,0,0,,Біз ойлағандай.
Dialogue: 0,0:18:12.50,0:18:14.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:14.34,0:18:15.76,Default,,0,0,0,,Эбили (Влад) Ха!
Dialogue: 0,0:18:16.47,0:18:17.97,Default,,0,0,0,,Қанды
Dialogue: 0,0:18:18.05,0:18:20.18,Default,,0,0,0,,Фантастикалық
Dialogue: 0,0:18:21.18,0:18:23.39,Default,,0,0,0,,Белгілеуші
Dialogue: 0,0:18:24.72,0:18:27.98,Default,,0,0,0,,Қашаннан бері осындай шу шығара бастадыңыз?
Dialogue: 0,0:18:28.06,0:18:30.19,Default,,0,0,0,,Осы қамалға келмес бұрын!
Dialogue: 0,0:18:30.77,0:18:32.69,Default,,0,0,0,,Ешкі елес ~
Dialogue: 0,0:18:35.03,0:18:39.24,Default,,0,0,0,,Граф Дракула вампирдің басты әлсіздігі.
Dialogue: 0,0:18:39.32,0:18:41.74,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:18:41.83,0:18:45.04,Default,,0,0,0,,(Владтың ауыр тыныс алуы)
Dialogue: 0,0:18:45.75,0:18:48.79,Default,,0,0,0,,Енді Юкайға...
Dialogue: 0,0:18:48.87,0:18:52.25,Default,,0,0,0,,Би билеңіздер!
Dialogue: 0,0:18:56.30,0:18:58.17,Default,,0,0,0,,Гуаа...
Dialogue: 0,0:18:58.26,0:19:01.68,Default,,0,0,0,,Рұқсатсыз маған қарама.
Dialogue: 0,0:19:06.39,0:19:08.85,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:19:14.86,0:19:18.99,Default,,0,0,0,,Мен сізге Рин Рейнвейсті жеңіл қабылдамаңыз деп ескерттім.
Dialogue: 0,0:19:19.07,0:19:21.91,Default,,0,0,0,,Сен істедің, Арне-сама!
Dialogue: 0,0:19:25.29,0:19:27.37,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:19:27.45,0:19:29.12,Default,,0,0,0,,Әлі де қорқынышты
Dialogue: 0,0:19:29.21,0:19:30.67,Default,,0,0,0,,Неге?
Dialogue: 0,0:19:30.75,0:19:33.33,Default,,0,0,0,,Бұл менің шедеврім.
Dialogue: 0,0:19:33.42,0:19:35.30,Default,,0,0,0,,Шедевр қайда?
Dialogue: 0,0:19:35.38,0:19:37.92,Default,,0,0,0,,Өнер туындысын да сезе алмаймын
Dialogue: 0,0:19:38.01,0:19:39.17,Default,,0,0,0,,Қорлау
Dialogue: 0,0:19:39.26,0:19:42.26,Default,,0,0,0,,Nointator, сіз мұны әдейі істедіңіз.
Dialogue: 0,0:19:42.34,0:19:45.76,Default,,0,0,0,,Сіз суретке жүректі қоспағаныңызға бәс тігемін.
Dialogue: 0,0:19:45.85,0:19:46.72,Default,,0,0,0,,Цвей
Dialogue: 0,0:19:46.81,0:19:48.64,Default,,0,0,0,,Жарайды, Эми.
Dialogue: 0,0:19:48.73,0:19:52.90,Default,,0,0,0,,Лорд Дракуланың жүрегі вампирдің ішінде дұрыс.
Dialogue: 0,0:19:52.98,0:19:54.77,Default,,0,0,0,,Сәлем Влад
Dialogue: 0,0:19:54.86,0:19:57.23,Default,,0,0,0,,Сіз аянышты көрінесіз.
Dialogue: 0,0:19:57.32,0:19:59.03,Default,,0,0,0,,Сіз де солай шығарсыз.
Dialogue: 0,0:19:59.11,0:20:00.49,Default,,0,0,0,,Бірге?
Dialogue: 0,0:20:00.57,0:20:03.16,Default,,0,0,0,,Мен қозғала аламын.
Dialogue: 0,0:20:03.24,0:20:04.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:04.24,0:20:07.29,Default,,0,0,0,,Мен тұлыпқа мінетін уақыт келе ме деп ойлаймын
Dialogue: 0,0:20:07.37,0:20:08.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:08.29,0:20:11.37,Default,,0,0,0,,Қане, тырнақтарымызды қайрайық!
Dialogue: 0,0:20:11.46,0:20:12.50,Default,,0,0,0,,Гаргари...
Dialogue: 0,0:20:11.46,0:20:12.50,Default,,0,0,0,,(тырнақтардың қайрау дыбысы)
Dialogue: 0,0:20:12.50,0:20:12.58,Default,,0,0,0,,(тырнақтардың қайрау дыбысы)
Dialogue: 0,0:20:12.58,0:20:14.63,Default,,0,0,0,,(тырнақтардың қайрау дыбысы)
Dialogue: 0,0:20:12.58,0:20:14.63,Default,,0,0,0,,Ей, тоқта, сен.
Dialogue: 0,0:20:14.63,0:20:14.71,Default,,0,0,0,,(тырнақтардың қайрау дыбысы)
Dialogue: 0,0:20:14.71,0:20:16.13,Default,,0,0,0,,(тырнақтардың қайрау дыбысы)
Dialogue: 0,0:20:14.71,0:20:16.13,Default,,0,0,0,,Ұштама, тоқтат, ей
Dialogue: 0,0:20:16.21,0:20:17.75,Default,,0,0,0,,Сондықтан қайрамаңыз
Dialogue: 0,0:20:16.21,0:20:17.75,Default,,0,0,0,,(Начзеллердің күлкісі)
Dialogue: 0,0:20:17.84,0:20:19.09,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:20:19.96,0:20:20.97,Default,,0,0,0,,Эй
Dialogue: 0,0:20:23.05,0:20:24.30,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:20:24.39,0:20:26.10,Default,,0,0,0,,Енді бұл Владтың суреті.
Dialogue: 0,0:20:26.18,0:20:28.81,Default,,0,0,0,,Енді адасатын адамдар болмайды.
Dialogue: 0,0:20:28.89,0:20:30.18,Default,,0,0,0,,(Изуку) Урарака ханым. (Урарака) Иә!
Dialogue: 0,0:20:30.27,0:20:31.81,Default,,0,0,0,,Сәлем Арне
Dialogue: 0,0:20:31.89,0:20:32.94,Default,,0,0,0,,Ах
Dialogue: 0,0:20:33.02,0:20:36.65,Default,,0,0,0,,Жаңа сұрау: Мен әкелген ешкі~
Dialogue: 0,0:20:36.73,0:20:39.61,Default,,0,0,0,,Бірден келесі жұмыс!
Dialogue: 0,0:20:39.69,0:20:41.40,Default,,0,0,0,,Сіз күткендей, Арне-сама!
Dialogue: 0,0:20:41.49,0:20:44.86,Default,,0,0,0,,Иә, түн болды ма?
Dialogue: 0,0:20:46.12,0:20:48.91,Default,,0,0,0,,Тұлып ұйықтап жатқан сияқты.
Dialogue: 0,0:20:48.99,0:20:51.29,Default,,0,0,0,,Ендеше мені олай деуді доғар!
Dialogue: 0,0:20:51.37,0:20:52.58,Default,,0,0,0,,Цвей
Dialogue: 0,0:20:52.66,0:20:55.75,Default,,0,0,0,,Ертең жақсы болуы керек емес пе? Өтініш мазмұнын тыңдаңыз.
Dialogue: 0,0:20:55.83,0:20:57.63,Default,,0,0,0,,Иә, Арне.
Dialogue: 0,0:20:57.71,0:21:00.42,Default,,0,0,0,,Бұл детективтік агенттік өте қара түсті.
Dialogue: 0,0:21:00.51,0:21:02.72,Default,,0,0,0,,Ругенберг туралы қауесеттер бар.
Dialogue: 0,0:21:02.80,0:21:04.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:04.34,0:21:08.76,Default,,0,0,0,,Бұл әлемде тек Арне Детектив Агенттігі шеше алатын жағдайлар мен құпиялар бар.
Dialogue: 0,0:21:08.85,0:21:10.68,Default,,0,0,0,,Әлі де көп.
Dialogue: 0,0:21:10.77,0:21:13.69,Default,,0,0,0,,Дұрыс, Арне-сама!
Dialogue: 0,0:21:16.90,0:21:18.44,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:21:18.52,0:21:21.07,Default,,0,0,0,,Кеттік, Линн Райнвейс
Dialogue: 0,0:21:22.94,0:21:24.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:24.95,0:21:29.95,Default,,0,0,0,,♪～
Dialogue: 0,0:22:47.90,0:22:53.41,Default,,0,0,0,,～♪
