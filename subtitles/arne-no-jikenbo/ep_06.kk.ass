Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.67,0:00:10.26,Default,,0,0,0,,Үй...
Dialogue: 0,0:00:12.38,0:00:13.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:13.63,0:00:15.85,Default,,0,0,0,,үшін сонда ма?
Dialogue: 0,0:00:15.93,0:00:16.76,Default,,0,0,0,,Бернд
Dialogue: 0,0:00:17.60,0:00:19.10,Default,,0,0,0,,Осы уақытқа дейін қайда...
Dialogue: 0,0:00:19.60,0:00:21.73,Default,,0,0,0,,Бұл сарайдың ішінде.
Dialogue: 0,0:00:21.81,0:00:23.39,Default,,0,0,0,,Егер багажыңыз жанып кетсе
Dialogue: 0,0:00:23.48,0:00:25.73,Default,,0,0,0,,Зейнеткерлік жәрдемақымның орнына аламын ба деп ойладым.
Dialogue: 0,0:00:26.31,0:00:27.73,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:00:27.82,0:00:29.19,Default,,0,0,0,,Мен мұны бәріңізбен бөлісемін.
Dialogue: 0,0:00:32.65,0:00:35.41,Default,,0,0,0,,Сонда мен мынамын
Dialogue: 0,0:00:35.49,0:00:38.66,Default,,0,0,0,,Элиза-чан, мен сізге тағы хабарласамын!
Dialogue: 0,0:00:39.87,0:00:41.62,Default,,0,0,0,,Рин ханым
Dialogue: 0,0:00:41.70,0:00:44.08,Default,,0,0,0,,Енді не істеуді жоспарлайсыз?
Dialogue: 0,0:00:44.17,0:00:45.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.62,0:00:49.21,Default,,0,0,0,,Кеше түнде мен көп көріксіз жақтарын көрсеттім.
Dialogue: 0,0:00:49.30,0:00:52.72,Default,,0,0,0,,Жас ханымға көңіл айтамын...
Dialogue: 0,0:00:52.80,0:00:57.60,Default,,0,0,0,,Сонда да біз сізді отбасымыздың асыл мүшесі деп санаймыз.
Dialogue: 0,0:00:57.68,0:00:59.43,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:59.51,0:01:02.10,Default,,0,0,0,,Мен жас келіншекке қарындасымдай қараймын...
Dialogue: 0,0:01:05.44,0:01:08.40,Default,,0,0,0,,Ендеше бізге қосылыңыз...
Dialogue: 0,0:01:10.32,0:01:11.15,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:12.40,0:01:16.32,Default,,0,0,0,,Осы уақытқа дейін барлығынан үлкен қолдау таптым.
Dialogue: 0,0:01:16.41,0:01:19.37,Default,,0,0,0,,Бұл тәуелсіз болу үшін жақсы мүмкіндік.
Dialogue: 0,0:01:19.45,0:01:20.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:21.37,0:01:22.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:22.58,0:01:23.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:24.12,0:01:26.42,Default,,0,0,0,,Мен сені көруге міндетті түрде келемін.
Dialogue: 0,0:01:24.12,0:01:26.42,Default,,0,0,0,,(Элиза мен Диананың айқайы)
Dialogue: 0,0:01:26.42,0:01:26.92,Default,,0,0,0,,(Элиза мен Диананың айқайы)
Dialogue: 0,0:01:27.00,0:01:30.17,Default,,0,0,0,,Жүрегіңізді ұстай білу -
Dialogue: 0,0:01:30.25,0:01:31.46,Default,,0,0,0,,Мен бар күшімді салғым келеді.
Dialogue: 0,0:01:32.71,0:01:34.97,Default,,0,0,0,,Бір күні кездескенше...
Dialogue: 0,0:01:37.34,0:01:41.22,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:01:44.35,0:01:45.31,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:01:46.85,0:01:50.56,Default,,0,0,0,,Мен бастапқыда адам емеспін бе?
Dialogue: 0,0:01:50.65,0:01:54.82,Default,,0,0,0,,Мен жас ханымның қаны бірінші сорылады деп ойламаппын.
Dialogue: 0,0:01:55.44,0:01:59.28,Default,,0,0,0,,Жас ханым адам емес еді ғой, солай ма?
Dialogue: 0,0:01:59.91,0:02:01.53,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:02:02.33,0:02:03.99,Default,,0,0,0,,Басынан...
Dialogue: 0,0:02:04.08,0:02:05.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:08.00,0:02:11.46,Default,,0,0,0,,Иә! А... Арне-сама?
Dialogue: 0,0:02:11.54,0:02:13.96,Default,,0,0,0,,Менің қаным аралас емес.
Dialogue: 0,0:02:14.05,0:02:15.97,Default,,0,0,0,,Иә, иә... иә?
Dialogue: 0,0:02:16.72,0:02:18.05,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:18.13,0:02:19.59,Default,,0,0,0,,Айнаға қара
Dialogue: 0,0:02:21.14,0:02:23.22,Default,,0,0,0,,Не, мен айнадан өз көрінісімді көремін...
Dialogue: 0,0:02:23.31,0:02:25.60,Default,,0,0,0,,Неліктен осы уақытқа дейін оны байқамадың?
Dialogue: 0,0:02:26.81,0:02:28.48,Default,,0,0,0,,Менде әзірге
Dialogue: 0,0:02:28.56,0:02:31.73,Default,,0,0,0,,Қаныңды ішіп күш жинадым.
Dialogue: 0,0:02:32.23,0:02:35.32,Default,,0,0,0,,Басқа нәсілдердің немесе жануарлардың қанымен мүмкін емес.
Dialogue: 0,0:02:35.40,0:02:39.03,Default,,0,0,0,,Демек, сіз адамсыз, бірінші және қазір.
Dialogue: 0,0:02:39.11,0:02:40.78,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:02:40.87,0:02:42.28,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:02:42.37,0:02:44.29,Default,,0,0,0,,Бірақ бұл шынымен де маңызды ма?
Dialogue: 0,0:02:44.37,0:02:45.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:45.29,0:02:47.71,Default,,0,0,0,,Адам немесе басқасы
Dialogue: 0,0:02:48.37,0:02:51.58,Default,,0,0,0,,Сіз Рин Рейнвейссіз бе?
Dialogue: 0,0:02:51.67,0:02:53.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:54.00,0:02:57.09,Default,,0,0,0,,Арне-сама Арне-сама болғандықтан
Dialogue: 0,0:02:57.17,0:02:58.47,Default,,0,0,0,,...Дұрыс!
Dialogue: 0,0:02:58.55,0:02:59.55,Default,,0,0,0,,Иә
Dialogue: 0,0:03:00.22,0:03:01.05,Default,,0,0,0,,Қазір...
Dialogue: 0,0:03:02.05,0:03:04.76,Default,,0,0,0,,Осымен сіздің өтінішіңіз аяқталады, адам.
Dialogue: 0,0:03:05.68,0:03:07.98,Default,,0,0,0,,Иә, вампир.
Dialogue: 0,0:03:08.06,0:03:09.73,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:13.52,0:03:14.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:17.65,0:03:18.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:20.82,0:03:23.87,Default,,0,0,0,,«Сүйікті отбасыммен»
Dialogue: 0,0:03:29.79,0:03:31.62,Default,,0,0,0,,Әке...
Dialogue: 0,0:03:32.75,0:03:36.13,Default,,0,0,0,,Әкеңнің істегені дұрыс емес.
Dialogue: 0,0:03:32.75,0:03:36.13,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:03:37.38,0:03:42.64,Default,,0,0,0,,Бірақ сіз біздің отбасымызды жақсы көрдіңіз, солай емес пе?
Dialogue: 0,0:03:43.51,0:03:47.14,Default,,0,0,0,,Бар болғаны... Ұмытпаймын.
Dialogue: 0,0:03:48.77,0:03:52.56,Default,,0,0,0,,Сол күні бәрі өзгерді, бірақ
Dialogue: 0,0:03:52.65,0:03:55.31,Default,,0,0,0,,Бәрі біткен жоқ
Dialogue: 0,0:03:56.48,0:03:59.23,Default,,0,0,0,,Осы жерде біраз уақытқа қалдырыңыз!
Dialogue: 0,0:04:03.41,0:04:04.95,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:05.45,0:04:07.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:08.20,0:04:10.75,Default,,0,0,0,,Мен Арне-саманың көмекшісі боламын.
Dialogue: 0,0:04:11.33,0:04:15.67,Default,,0,0,0,,Мен көптеген адамдармен және көптеген оқиғалармен кездестім.
Dialogue: 0,0:04:18.05,0:04:19.92,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:22.84,0:04:25.43,Default,,0,0,0,,Кеттік, Линн Райнвейс
Dialogue: 0,0:04:26.14,0:04:27.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:27.43,0:04:29.60,Default,,0,0,0,,Және бұдан былай да
Dialogue: 0,0:04:29.68,0:04:33.94,Default,,0,0,0,,Бізді тосын сыйларға толы күндер күтіп тұр
Dialogue: 0,0:04:34.65,0:04:39.11,Default,,0,0,0,,♪～
Dialogue: 0,0:05:58.27,0:06:03.28,Default,,0,0,0,,～♪
Dialogue: 0,0:06:12.53,0:06:14.20,Default,,0,0,0,,Ха... Мен жалықтым.
Dialogue: 0,0:06:14.29,0:06:15.70,Default,,0,0,0,,Қалыңыз...!
Dialogue: 0,0:06:15.70,0:06:16.87,Default,,0,0,0,,Қалыңыз...!
Dialogue: 0,0:06:15.70,0:06:16.87,Default,,0,0,0,,Сіз немен ойнайсыз?
Dialogue: 0,0:06:16.87,0:06:16.96,Default,,0,0,0,,Сіз немен ойнайсыз?
Dialogue: 0,0:06:16.96,0:06:18.33,Default,,0,0,0,,Сен немен ойнайсың?
Dialogue: 0,0:06:16.96,0:06:18.33,Default,,0,0,0,,Гррр...
Dialogue: 0,0:06:18.92,0:06:20.21,Default,,0,0,0,,Ойнамаңыз!
Dialogue: 0,0:06:20.29,0:06:22.71,Default,,0,0,0,,Мынаны алып кет!
Dialogue: 0,0:06:22.80,0:06:24.17,Default,,0,0,0,,Гах гах...
Dialogue: 0,0:06:22.80,0:06:24.17,Default,,0,0,0,,Қандай дөңгелек, үлпілдек тұлып!
Dialogue: 0,0:06:24.17,0:06:24.25,Default,,0,0,0,,Қандай дөңгелек, үлпілдек тұлып!
Dialogue: 0,0:06:24.25,0:06:26.05,Default,,0,0,0,,Қандай дөңгелек, үлпілдек тұлып!
Dialogue: 0,0:06:24.25,0:06:26.05,Default,,0,0,0,,Ойнамаңыз! Бірге жабыспаңдар!
Dialogue: 0,0:06:26.05,0:06:26.13,Default,,0,0,0,,Ойнамаңыз! Бірге жабыспаңдар!
Dialogue: 0,0:06:26.13,0:06:27.34,Default,,0,0,0,,Ойнамаңыз! Бірге жабыспаңдар!
Dialogue: 0,0:06:26.13,0:06:27.34,Default,,0,0,0,,Бұл Наха-чан, сонымен қатар Наха Зеллер деген атпен белгілі.
Dialogue: 0,0:06:27.34,0:06:27.42,Default,,0,0,0,,Бұл Наха-чан, сонымен қатар Наха Зеллер деген атпен белгілі.
Dialogue: 0,0:06:27.42,0:06:28.72,Default,,0,0,0,,Бұл Наха-чан, Наха Зеллер деген атпен де белгілі.
Dialogue: 0,0:06:27.42,0:06:28.72,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:06:29.43,0:06:32.22,Default,,0,0,0,,Жүрек Арне-саманың денесіне оралды.
Dialogue: 0,0:06:32.30,0:06:35.47,Default,,0,0,0,,Тұлыпқа тек кісілік ауысқан сияқты.
Dialogue: 0,0:06:35.56,0:06:37.81,Default,,0,0,0,,Менің кіші бауырым бар.
Dialogue: 0,0:06:37.89,0:06:38.73,Default,,0,0,0,,Ах
Dialogue: 0,0:06:40.23,0:06:41.86,Default,,0,0,0,,Ой, ішінде не бар?
Dialogue: 0,0:06:41.94,0:06:42.98,Default,,0,0,0,,Мен оны түзетемін.
Dialogue: 0,0:06:43.07,0:06:44.69,Default,,0,0,0,,Бұл жігіт басынан бастап!
Dialogue: 0,0:06:44.78,0:06:46.36,Default,,0,0,0,,Ұстамаңыз (Начзелер) Арг!
Dialogue: 0,0:06:46.44,0:06:47.86,Default,,0,0,0,,Менің және сенің арамызда ешқандай қатынас жоқ.
Dialogue: 0,0:06:47.95,0:06:49.28,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:06:49.36,0:06:50.53,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:06:49.36,0:06:50.53,Default,,0,0,0,,Сәлем! Жоқ, жіберіңіз...
Dialogue: 0,0:06:50.53,0:06:50.61,Default,,0,0,0,,Сәлем! Жоқ, жіберіңіз...
Dialogue: 0,0:06:50.61,0:06:51.37,Default,,0,0,0,,Сәлем! Жоқ, жіберіңіз...
Dialogue: 0,0:06:50.61,0:06:51.37,Default,,0,0,0,,Біз Эми екеуміз бұрыннан таныс сияқтымыз.
Dialogue: 0,0:06:51.37,0:06:51.45,Default,,0,0,0,,Біз Эми екеуміз бұрыннан таныс сияқтымыз.
Dialogue: 0,0:06:51.45,0:06:52.95,Default,,0,0,0,,Біз Эми екеуміз бұрыннан таныс сияқтымыз.
Dialogue: 0,0:06:51.45,0:06:52.95,Default,,0,0,0,,Пышақтамаңыз! Гах мынау...
Dialogue: 0,0:06:53.03,0:06:54.33,Default,,0,0,0,,Біз өте жақсы доспыз.
Dialogue: 0,0:06:53.03,0:06:54.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:54.41,0:06:56.08,Default,,0,0,0,,Сәлем ешкі~
Dialogue: 0,0:06:56.16,0:06:57.00,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.08,0:07:00.96,Default,,0,0,0,,Рахмет, Яги, жоғалған мысықты тапқаныңыз үшін~
Dialogue: 0,0:07:01.04,0:07:02.63,Default,,0,0,0,,Хицудзи
Dialogue: 0,0:07:02.71,0:07:04.59,Default,,0,0,0,,Пошташы Хицудзи
Dialogue: 0,0:07:04.67,0:07:07.42,Default,,0,0,0,,Арне детектив агенттігіне сұрау жіберіңіз.
Dialogue: 0,0:07:07.51,0:07:09.34,Default,,0,0,0,,Барлық сауда-саттықтың ұясы
Dialogue: 0,0:07:09.42,0:07:13.64,Default,,0,0,0,,Негізі ешкі басқа өтінішпен келді.
Dialogue: 0,0:07:13.72,0:07:14.56,Default,,0,0,0,,Сұраныс?
Dialogue: 0,0:07:14.64,0:07:18.73,Default,,0,0,0,,Әй, эй! О құдайым-ай!
Dialogue: 0,0:07:18.81,0:07:22.94,Default,,0,0,0,,Әй, эй! О құдайым-ай!
Dialogue: 0,0:07:23.02,0:07:26.40,Default,,0,0,0,,(Мачо балықшылардың айқайы)
Dialogue: 0,0:07:28.19,0:07:31.07,Default,,0,0,0,,Бұл не жексұрын нәрсе...
Dialogue: 0,0:07:32.36,0:07:34.24,Default,,0,0,0,,Әй, эй!
Dialogue: 0,0:07:36.79,0:07:40.41,Default,,0,0,0,,Сіз вампир детективсіз бе?
Dialogue: 0,0:07:43.13,0:07:44.54,Default,,0,0,0,,Менің сүйіктім...
Dialogue: 0,0:07:44.63,0:07:48.01,Default,,0,0,0,,Мен Ханнаның мені неге өлтірмек болғанын білгім келеді.
Dialogue: 0,0:07:51.26,0:07:53.97,Default,,0,0,0,,Сіздің талғамыңызға сай келеді деп үміттенемін...
Dialogue: 0,0:07:54.05,0:07:55.64,Default,,0,0,0,,Неліктен балдырлар қалдықтары?
Dialogue: 0,0:07:55.72,0:07:56.85,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:07:56.93,0:07:59.98,Default,,0,0,0,,Сіз су перісіне шай ұсынсаңыз да, ол шай іше алмауы мүмкін.
Dialogue: 0,0:08:00.06,0:08:02.94,Default,,0,0,0,,Сонымен Юрате айттыңыз ба?
Dialogue: 0,0:08:03.02,0:08:05.31,Default,,0,0,0,,Сіздің сүйіктіңіз сізді өлтірмек болды деп не айтасыз?
Dialogue: 0,0:08:06.11,0:08:10.40,Default,,0,0,0,,Түнде ұйықтап жатқанымда, Ханна кенет маған шабуыл жасады.
Dialogue: 0,0:08:10.49,0:08:14.87,Default,,0,0,0,,Мен оны абайсызда қағып өлтірдім...
Dialogue: 0,0:08:14.95,0:08:17.08,Default,,0,0,0,,Сен оны өлтірдің бе?
Dialogue: 0,0:08:18.12,0:08:19.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:19.37,0:08:22.29,Default,,0,0,0,,Эй, Ханна деген кім?
Dialogue: 0,0:08:22.37,0:08:24.75,Default,,0,0,0,,Бұл адам қыз.
Dialogue: 0,0:08:24.83,0:08:29.34,Default,,0,0,0,,Сүйкімді, мейірімді және кішкентай жылауық
Dialogue: 0,0:08:29.42,0:08:32.72,Default,,0,0,0,,Сондықтан мен саған көмектестім
Dialogue: 0,0:08:44.06,0:08:46.44,Default,,0,0,0,,(Теңізге құлау дыбысы)
Dialogue: 0,0:08:48.23,0:08:49.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:51.65,0:08:53.53,Default,,0,0,0,,Екі рет секіру ме? Әзілдеп тұрсың ғой.
Dialogue: 0,0:09:01.62,0:09:02.70,Default,,0,0,0,,Ах
Dialogue: 0,0:09:06.21,0:09:07.67,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:09:08.50,0:09:09.88,Default,,0,0,0,,А...?
Dialogue: 0,0:09:15.55,0:09:17.30,Default,,0,0,0,,Мен мұны бір қарағанда түсіндім
Dialogue: 0,0:09:18.30,0:09:23.64,Default,,0,0,0,,Тағдыр бізге осы күні, осы теңізде жолығады.
Dialogue: 0,0:09:24.39,0:09:27.19,Default,,0,0,0,,Содан бері біз әрқашан бірге болдық
Dialogue: 0,0:09:27.27,0:09:28.73,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:09:31.78,0:09:33.28,Default,,0,0,0,,Я...
Dialogue: 0,0:09:33.36,0:09:34.65,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:09:37.41,0:09:38.62,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:41.20,0:09:43.91,Default,,0,0,0,,Екеуміз де жалғыз қалдық.
Dialogue: 0,0:09:44.00,0:09:44.87,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:09:45.71,0:09:48.21,Default,,0,0,0,,Мен үйірден бөлініп шықтым.
Dialogue: 0,0:09:48.29,0:09:53.46,Default,,0,0,0,,Ханна шынымен түсінбейді, бірақ ол қазір үйге бара алмайтынын айтады.
Dialogue: 0,0:10:03.22,0:10:04.52,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:10:09.56,0:10:10.44,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:15.44,0:10:17.86,Default,,0,0,0,,Әр күн өте қызықты өтті.
Dialogue: 0,0:10:17.95,0:10:21.74,Default,,0,0,0,,Біз аз ғана уақыт бірге болдық, бірақ
Dialogue: 0,0:10:24.91,0:10:26.12,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:26.20,0:10:28.96,Default,,0,0,0,,Бұл жазғы махаббат сияқты!
Dialogue: 0,0:10:29.04,0:10:31.46,Default,,0,0,0,,Бірақ неге Ханна...
Dialogue: 0,0:10:31.54,0:10:33.80,Default,,0,0,0,,Болжаудың қажеті жоқ
Dialogue: 0,0:10:33.88,0:10:36.84,Default,,0,0,0,,Әйел су перісінің қаны мен етін алғысы келсе керек.
Dialogue: 0,0:10:36.92,0:10:38.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.93,0:10:40.34,Default,,0,0,0,,Ет пен қан?
Dialogue: 0,0:10:40.43,0:10:42.72,Default,,0,0,0,,Әрине бұл қан мен ет.
Dialogue: 0,0:10:43.31,0:10:47.06,Default,,0,0,0,,Адамдар су перілерінің қаны мен етін жесе, олар өлмейтін болады.
Dialogue: 0,0:10:47.14,0:10:49.48,Default,,0,0,0,,Сондықтан көптеген адамдар су перілерін нысанаға алады.
Dialogue: 0,0:10:49.56,0:10:52.19,Default,,0,0,0,,Бұл дұрыс емес... Ханна!
Dialogue: 0,0:10:52.27,0:10:55.15,Default,,0,0,0,,Өйткені сен маған мәңгілік махаббатыңды уәде еткенсің...
Dialogue: 0,0:10:55.23,0:10:56.28,Default,,0,0,0,,Мәңгілік?
Dialogue: 0,0:10:56.36,0:10:58.70,Default,,0,0,0,,Адамдар бір сәтте өле ме?
Dialogue: 0,0:10:58.78,0:11:00.16,Default,,0,0,0,,Бір ғана мысал!
Dialogue: 0,0:11:00.24,0:11:03.91,Default,,0,0,0,,Өлгенше бірге боламыз деген махаббат анты!
Dialogue: 0,0:11:03.99,0:11:08.54,Default,,0,0,0,,Әй, сен мені сүйгендіктен өлтіргің келді ме?
Dialogue: 0,0:11:09.37,0:11:10.71,Default,,0,0,0,,Менің атым – Кёома Хоуоин
Dialogue: 0,0:11:11.33,0:11:14.75,Default,,0,0,0,,Оның мәңгі сенікі болуын қаладың.
Dialogue: 0,0:11:14.84,0:11:16.76,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:11:16.84,0:11:18.72,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:11:18.80,0:11:21.30,Default,,0,0,0,,Әйел су перісін тұлыпқа айналдырды
Dialogue: 0,0:11:21.39,0:11:24.10,Default,,0,0,0,,Мен оның мәңгі менікі болуын қаладым.
Dialogue: 0,0:11:24.18,0:11:26.52,Default,,0,0,0,,Сіздің пікіріңіз тым күрделі!
Dialogue: 0,0:11:26.60,0:11:28.60,Default,,0,0,0,,Ал егер сіз оны әу бастан өлтірмекші болсаңыз.
Dialogue: 0,0:11:28.68,0:11:30.73,Default,,0,0,0,,Мүмкіндіктер көп болуы керек.
Dialogue: 0,0:11:31.56,0:11:34.19,Default,,0,0,0,,Шынымен де аз уақыт болса да
Dialogue: 0,0:11:34.27,0:11:36.94,Default,,0,0,0,,Бірге өмір сүрудің қиындығына барудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:11:37.03,0:11:38.03,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:11:38.74,0:11:39.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:40.61,0:11:43.28,Default,,0,0,0,,Жалығуды жеңудің жақсы тәсілі сияқты
Dialogue: 0,0:11:44.66,0:11:49.00,Default,,0,0,0,,Сол түні мен әдеттегідей саятшылықта ұйықтап жатқан едім...
Dialogue: 0,0:11:53.21,0:11:57.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:57.09,0:11:58.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:59.55,0:12:01.84,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:01.93,0:12:03.39,Default,,0,0,0,,Ханна?
Dialogue: 0,0:12:04.68,0:12:06.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.10,0:12:06.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:07.01,0:12:10.18,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:10.27,0:12:11.14,Default,,0,0,0,,Юра…
Dialogue: 0,0:12:11.23,0:12:13.65,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:12:13.73,0:12:15.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:15.44,0:12:16.61,Default,,0,0,0,,Түсіндім, Юра.
Dialogue: 0,0:12:16.69,0:12:19.11,Default,,0,0,0,,Маған ұнамайды! Тоқта!
Dialogue: 0,0:12:20.74,0:12:23.11,Default,,0,0,0,,Ханна! Эй!
Dialogue: 0,0:12:24.74,0:12:25.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:25.74,0:12:27.24,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:12:27.33,0:12:28.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:28.99,0:12:33.04,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:33.12,0:12:34.12,Default,,0,0,0,,Ханна?
Dialogue: 0,0:12:38.75,0:12:41.55,Default,,0,0,0,,Ханна Ханна!
Dialogue: 0,0:12:42.42,0:12:46.51,Default,,0,0,0,,Сіз шприцпен қан алып, пышақпен ет кеспек болдыңыз ба?
Dialogue: 0,0:12:47.55,0:12:51.77,Default,,0,0,0,,Әйел қылмыс жасағанға дейін күдікті нәрсе болды ма?
Dialogue: 0,0:12:53.23,0:12:55.40,Default,,0,0,0,,Хмм... Енді ойлап отырсам
Dialogue: 0,0:12:55.48,0:12:58.82,Default,,0,0,0,,Соңғы кездері қандай да бір зерттеу жүргіздіңіз бе?
Dialogue: 0,0:13:00.36,0:13:01.57,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:13:03.70,0:13:04.53,Default,,0,0,0,,Кез келген нәрсе...
Dialogue: 0,0:13:07.24,0:13:08.49,Default,,0,0,0,,Диаграмма?
Dialogue: 0,0:13:11.62,0:13:13.00,Default,,0,0,0,,Сәлем Юра
Dialogue: 0,0:13:13.08,0:13:16.17,Default,,0,0,0,,Сізден басқа су перілері жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:13:16.25,0:13:17.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:17.63,0:13:18.67,Default,,0,0,0,,Кімді білесің?
Dialogue: 0,0:13:18.75,0:13:22.67,Default,,0,0,0,,Сіз басқа су перілерінің қайда екенін білмейсіз бе?
Dialogue: 0,0:13:23.72,0:13:25.63,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:13:26.30,0:13:27.97,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:29.14,0:13:32.72,Default,,0,0,0,,Осыдан кейін Ханна үнсіз қалды.
Dialogue: 0,0:13:35.52,0:13:38.40,Default,,0,0,0,,Менің ойымша, олар су перісін іздеді.
Dialogue: 0,0:13:38.48,0:13:39.65,Default,,0,0,0,,Тіпті су перісі гаремінде
Dialogue: 0,0:13:39.73,0:13:41.82,Default,,0,0,0,,Менің ойымша, сіз оны жасауды жоспарлағансыз ба?
Dialogue: 0,0:13:41.90,0:13:43.15,Default,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:13:43.24,0:13:45.24,Default,,0,0,0,,Су перісін билеп ал, солай ма?
Dialogue: 0,0:13:45.82,0:13:47.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:47.20,0:13:50.37,Default,,0,0,0,,Сонымен, Ханна мені шынымен қалайды ма?
Dialogue: 0,0:13:50.45,0:13:51.37,Default,,0,0,0,,Жоғары…
Dialogue: 0,0:13:51.45,0:13:52.41,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:13:52.41,0:13:53.87,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:13:52.41,0:13:53.87,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:13:53.87,0:13:56.87,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:14:02.67,0:14:04.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:04.21,0:14:07.30,Default,,0,0,0,,Ух... кешіріңіз.
Dialogue: 0,0:14:07.88,0:14:10.72,Default,,0,0,0,,Бірақ мен оны қайтадан аквариумға салғаныма қуаныштымын.
Dialogue: 0,0:14:10.80,0:14:11.64,Default,,0,0,0,,О...
Dialogue: 0,0:14:11.72,0:14:14.10,Default,,0,0,0,,Маэда мырза.
Dialogue: 0,0:14:14.18,0:14:16.81,Default,,0,0,0,,А... кейін бірге тазалайық.
Dialogue: 0,0:14:16.89,0:14:19.27,Default,,0,0,0,,Рахмет, сіз өте мейірімдісіз.
Dialogue: 0,0:14:22.98,0:14:24.19,Default,,0,0,0,,(Юраттың күрсінуі)
Dialogue: 0,0:14:24.28,0:14:27.03,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:14:27.11,0:14:30.45,Default,,0,0,0,,"Мен себебін білгім келеді" деп айтыңыз.
Dialogue: 0,0:14:30.95,0:14:32.45,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:14:32.53,0:14:35.87,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:14:35.95,0:14:38.87,Default,,0,0,0,,Үйірден ұзақ уақыт бөлек
Dialogue: 0,0:14:38.96,0:14:41.79,Default,,0,0,0,,Мен ұзақ уақыт жалғыздықта болдым
Dialogue: 0,0:14:41.88,0:14:45.51,Default,,0,0,0,,Ханна маған ант берді.
Dialogue: 0,0:14:49.80,0:14:52.26,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:14:52.35,0:14:53.47,Default,,0,0,0,,Не болды? Юра
Dialogue: 0,0:14:53.56,0:14:56.18,Default,,0,0,0,,Мен өзімді бақытты сезінемін.
Dialogue: 0,0:14:57.06,0:14:58.94,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:14:59.02,0:15:02.36,Default,,0,0,0,,Жүрегім толып кеткеніне сене алар емеспін.
Dialogue: 0,0:15:03.77,0:15:06.32,Default,,0,0,0,,Күлкілі болмаса да, күлемін
Dialogue: 0,0:15:06.40,0:15:09.61,Default,,0,0,0,,Себебі мен Ханнамен біргемін.
Dialogue: 0,0:15:15.24,0:15:16.75,Default,,0,0,0,,Ханна?
Dialogue: 0,0:15:17.33,0:15:19.33,Default,,0,0,0,,Юраға үйленейік
Dialogue: 0,0:15:19.41,0:15:20.42,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:15:29.80,0:15:34.05,Default,,0,0,0,,Мен, Ханна, Юрате деген мәңгілік махаббатымды ант етемін.
Dialogue: 0,0:15:34.76,0:15:35.85,Default,,0,0,0,,Мәңгілік?
Dialogue: 0,0:15:35.93,0:15:37.77,Default,,0,0,0,,Иә, мәңгілік
Dialogue: 0,0:15:37.85,0:15:39.02,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:15:39.73,0:15:41.19,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:15:43.23,0:15:45.52,Default,,0,0,0,,Ұзақ уақыт бойы?
Dialogue: 0,0:15:45.61,0:15:47.36,Default,,0,0,0,,Фуфуфуфу Уау...
Dialogue: 0,0:15:51.99,0:15:54.78,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:16:03.92,0:16:06.50,Default,,0,0,0,,«Себепті білгім келеді» өтірік
Dialogue: 0,0:16:07.55,0:16:09.21,Default,,0,0,0,,Юрате мырза...
Dialogue: 0,0:16:09.30,0:16:10.76,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:16:10.84,0:16:14.01,Default,,0,0,0,,«Ханна мені өлтірмек болған жоқ».
Dialogue: 0,0:16:14.09,0:16:16.93,Default,,0,0,0,,Мүмкін мен біреудің осылай айтқанын қалаған шығармын.
Dialogue: 0,0:16:17.60,0:16:20.35,Default,,0,0,0,,Неліктен бұлай болды? Мен білгім келеді
Dialogue: 0,0:16:20.43,0:16:21.94,Default,,0,0,0,,Бірақ бұл қорқынышты
Dialogue: 0,0:16:22.02,0:16:24.19,Default,,0,0,0,,Надан болған жақсы...
Dialogue: 0,0:16:24.27,0:16:25.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:26.65,0:16:28.65,Default,,0,0,0,,Бұл сіз үшін маңызды біреу туралы болса да
Dialogue: 0,0:16:28.73,0:16:31.36,Default,,0,0,0,,Білмесем бақыттырақпын
Dialogue: 0,0:16:31.44,0:16:33.11,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:16:35.62,0:16:39.20,Default,,0,0,0,,Қорықсаң да, біліп алға ұмтыласың
Dialogue: 0,0:16:39.29,0:16:41.54,Default,,0,0,0,,Бар болуы керек
Dialogue: 0,0:16:43.29,0:16:45.38,Default,,0,0,0,,Мен сенгім келеді!
Dialogue: 0,0:16:45.46,0:16:48.21,Default,,0,0,0,,Ханнаның анты рас болды
Dialogue: 0,0:16:49.21,0:16:50.00,Default,,0,0,0,,Мәңгілік махаббатқа шын ант етсек те.
Dialogue: 0,0:16:50.00,0:16:53.22,Default,,0,0,0,,Мәңгілік махаббатқа шын ант етсең де.
Dialogue: 0,0:16:53.30,0:16:58.60,Default,,0,0,0,,Өлмейтін су перісімен салыстырғанда, адамның өмірі өткінші.
Dialogue: 0,0:16:59.18,0:17:04.64,Default,,0,0,0,,Артында жақын адамын тастап өлу өкінішті екеніне сенімдімін, бірақ...
Dialogue: 0,0:17:04.73,0:17:06.90,Default,,0,0,0,,Су перілері өлмейтін емес.
Dialogue: 0,0:17:06.98,0:17:07.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.90,0:17:11.74,Default,,0,0,0,,Олар адамдарға қарағанда әлдеқайда ұзақ өмір сүреді, бірақ
Dialogue: 0,0:17:11.82,0:17:13.03,Default,,0,0,0,,Өмірдің ұзақтығы бар.
Dialogue: 0,0:17:13.11,0:17:15.78,Default,,0,0,0,,Иә! Мен анық...
Dialogue: 0,0:17:16.49,0:17:17.37,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:17.45,0:17:20.83,Default,,0,0,0,,Оны Линн Рейнвейс деп атаңыз
Dialogue: 0,0:17:20.91,0:17:22.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:28.54,0:17:31.63,Default,,0,0,0,,Күтілгендей, менің жауабым өзгеріссіз қалды.
Dialogue: 0,0:17:31.71,0:17:33.97,Default,,0,0,0,,Әйел неліктен су перісіне шабуыл жасады?
Dialogue: 0,0:17:34.05,0:17:36.84,Default,,0,0,0,,Мен өлмейтін бола аламын.
Dialogue: 0,0:17:36.93,0:17:38.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.93,0:17:43.39,Default,,0,0,0,,Біріншіден, егер сіз оларды өлтіретін болсаңыз, олармен өмір сүрудің қажеті жоқ ...
Dialogue: 0,0:17:43.48,0:17:44.98,Default,,0,0,0,,Қажеттілік бар
Dialogue: 0,0:17:45.06,0:17:48.10,Default,,0,0,0,,Өйткені бұл әйелдің түпкі мақсаты.
Dialogue: 0,0:17:48.19,0:17:49.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.11,0:17:50.36,Default,,0,0,0,,Мақсаты?
Dialogue: 0,0:17:50.44,0:17:54.90,Default,,0,0,0,,Әйелдің су перісімен уақыт өткізуі үшін
Dialogue: 0,0:17:54.99,0:17:57.07,Default,,0,0,0,,Су перісін жеуге тырысты
Dialogue: 0,0:17:57.16,0:17:58.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.41,0:18:00.70,Default,,0,0,0,,Бұл арбаны аттың алдына қою.
Dialogue: 0,0:18:00.78,0:18:02.37,Default,,0,0,0,,Иә
Dialogue: 0,0:18:02.45,0:18:06.37,Default,,0,0,0,,Бірақ егер әйел су перісін өлмейтін деп ойласа ше?
Dialogue: 0,0:18:06.46,0:18:07.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:07.92,0:18:10.63,Default,,0,0,0,,200 жыл өмір сүрген және осылай болған.
Dialogue: 0,0:18:10.71,0:18:13.80,Default,,0,0,0,,Адамды өлмейтін деп ойлау таңқаларлық емес.
Dialogue: 0,0:18:13.88,0:18:14.92,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:18:15.01,0:18:16.63,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:16.72,0:18:20.72,Default,,0,0,0,,Әйелдің қылмыс жасаған кезде дайындап қойған шприці.
Dialogue: 0,0:18:20.80,0:18:23.64,Default,,0,0,0,,Бұл қан алу үшін емес шығар.
Dialogue: 0,0:18:23.72,0:18:25.64,Default,,0,0,0,,Сіз ойлайтын бірінші нәрсе
Dialogue: 0,0:18:25.73,0:18:27.85,Default,,0,0,0,,Линн Рейнвейс сияқты нәрсе.
Dialogue: 0,0:18:28.44,0:18:30.36,Default,,0,0,0,,Оны қолданудың көптеген жолдары бар.
Dialogue: 0,0:18:30.44,0:18:33.32,Default,,0,0,0,,Қан алу Улану Анестезия
Dialogue: 0,0:18:33.98,0:18:37.03,Default,,0,0,0,,Су перісіне мүмкіндігінше ауырсынуды аз сезіну керектігі айтылады.
Dialogue: 0,0:18:37.11,0:18:38.40,Default,,0,0,0,,Бұл ойластырылған шығар.
Dialogue: 0,0:18:38.49,0:18:40.66,Default,,0,0,0,,Мен оны бәрібір жейтін едім!
Dialogue: 0,0:18:40.74,0:18:42.33,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:18:42.41,0:18:44.41,Default,,0,0,0,,Бұған дейін мен сізден бір нәрсе сұрағым келеді.
Dialogue: 0,0:18:44.49,0:18:47.08,Default,,0,0,0,,Әйелмен қанша уақыт болдыңыз?
Dialogue: 0,0:18:47.16,0:18:50.58,Default,,0,0,0,,Білмеймін, мен оны ешқашан санаған емеспін.
Dialogue: 0,0:18:50.67,0:18:53.80,Default,,0,0,0,,Бірақ 100 жылдың жартысы? Тағы біраз?
Dialogue: 0,0:18:53.88,0:18:55.21,Default,,0,0,0,,100？
Dialogue: 0,0:18:55.30,0:18:57.88,Default,,0,0,0,,Сіз бұл жерде сәл ғана болдым деп айттыңыз...
Dialogue: 0,0:18:57.97,0:19:00.09,Default,,0,0,0,,Жарайды, бұл біраз, солай емес пе?
Dialogue: 0,0:19:00.18,0:19:01.89,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:19:02.89,0:19:05.06,Default,,0,0,0,,Нәсілдер арасындағы сезімталдықтың айырмашылығы
Dialogue: 0,0:19:05.14,0:19:06.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.60,0:19:11.02,Default,,0,0,0,,Су перісі көзінде бейнеленген әйелдің олар кездескен кезден еш айырмашылығы жоқ.
Dialogue: 0,0:19:11.65,0:19:14.52,Default,,0,0,0,,Бірақ уақыт өте шықты.
Dialogue: 0,0:19:37.92,0:19:40.47,Default,,0,0,0,,Өмірінің соңына таяп қалған әйел
Dialogue: 0,0:19:40.55,0:19:44.64,Default,,0,0,0,,Су перісін тастап, жалғыз өлуден қорыққан болуы керек.
Dialogue: 0,0:19:45.35,0:19:47.89,Default,,0,0,0,,Ол өлгенде, су перісі қайтадан жалғыз қалады.
Dialogue: 0,0:19:48.77,0:19:51.60,Default,,0,0,0,,Сондықтан су перісінің қаны мен етімен сен өлмейтін боласың.
Dialogue: 0,0:19:51.69,0:19:53.40,Default,,0,0,0,,Мен бірге уақыт өткізуді ойладым.
Dialogue: 0,0:19:54.36,0:19:57.32,Default,,0,0,0,,Мәңгілік махаббатты жүзеге асыру
Dialogue: 0,0:19:57.94,0:19:59.19,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:59.28,0:20:02.41,Default,,0,0,0,,«Жақын адамын тастап өлу қайғылы»
Dialogue: 0,0:20:02.49,0:20:04.28,Default,,0,0,0,,Бұл сіздің сөздеріңіз.
Dialogue: 0,0:20:10.87,0:20:12.25,Default,,0,0,0,,Ханна…
Dialogue: 0,0:20:13.58,0:20:14.92,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:20:21.01,0:20:22.68,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:22.76,0:20:24.18,Default,,0,0,0,,(Теңізге сүңгу дыбысы)
Dialogue: 0,0:20:25.60,0:20:27.85,Default,,0,0,0,,Махаббаттың әр түрі әртүрлі.
Dialogue: 0,0:20:27.93,0:20:29.43,Default,,0,0,0,,Бұл соншалықты керемет емес пе?
Dialogue: 0,0:20:30.93,0:20:35.31,Default,,0,0,0,,Сіздің ойлау тәсіліңіз кейде қиын.
Dialogue: 0,0:20:35.81,0:20:37.27,Default,,0,0,0,,Ал екеуі қазірдің өзінде...
Dialogue: 0,0:20:37.36,0:20:38.19,Default,,0,0,0,,Уху…
Dialogue: 0,0:20:38.27,0:20:39.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:39.53,0:20:42.45,Default,,0,0,0,,Тіпті Рин-Чан депрессия кезінде сүйкімді.
Dialogue: 0,0:20:42.53,0:20:43.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:43.99,0:20:47.33,Default,,0,0,0,,Жаңа ғана айттыңыз ба?
Dialogue: 0,0:20:53.33,0:20:55.79,Default,,0,0,0,,Бір жұтым су перісі қаны...
Dialogue: 0,0:20:58.54,0:20:59.67,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:21:11.56,0:21:14.60,Default,,0,0,0,,Ха... Мен...
Dialogue: 0,0:21:15.27,0:21:16.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.52,0:21:17.94,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:21:18.56,0:21:19.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:25.49,0:21:30.49,Default,,0,0,0,,♪～
Dialogue: 0,0:22:48.45,0:22:53.95,Default,,0,0,0,,～♪
