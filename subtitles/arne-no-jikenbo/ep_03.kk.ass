Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:03.25,Default,,0,0,0,,Қара магия?
Dialogue: 0,0:00:03.33,0:00:05.75,Default,,0,0,0,,Сіздің әкеңіз...?
Dialogue: 0,0:00:05.84,0:00:06.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:06.84,0:00:10.63,Default,,0,0,0,,Әкең не істемек болды?
Dialogue: 0,0:00:10.72,0:00:14.01,Default,,0,0,0,,Бұл өтініштің мазмұнына қатысты сияқты.
Dialogue: 0,0:00:14.09,0:00:16.60,Default,,0,0,0,,Ал, оның қозғалуын күтейік.
Dialogue: 0,0:00:17.93,0:00:19.81,Default,,0,0,0,,Оған дейін қамалға оралыңыз.
Dialogue: 0,0:00:19.89,0:00:21.64,Default,,0,0,0,,Мен сағатты сізге қалдырамын.
Dialogue: 0,0:00:21.73,0:00:24.23,Default,,0,0,0,,Сіз мені қиын нәрсе жасауға мәжбүрлеп жатырсыз.
Dialogue: 0,0:00:24.31,0:00:25.94,Default,,0,0,0,,Не? Зише?
Dialogue: 0,0:00:26.02,0:00:28.23,Default,,0,0,0,,Хехе, таң қалдыңыз ба?
Dialogue: 0,0:00:28.32,0:00:30.94,Default,,0,0,0,,Айнадағы кез келген жерге баруға болады
Dialogue: 0,0:00:31.03,0:00:32.70,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:32.78,0:00:34.03,Default,,0,0,0,,Арне дегеніміз не?
Dialogue: 0,0:00:34.11,0:00:37.91,Default,,0,0,0,,Біз бір-бірімізді қамал немесе осы айна арқылы ғана тани аламыз.
Dialogue: 0,0:00:38.66,0:00:42.37,Default,,0,0,0,,Вампир Арне-сама айнадан көрінбегендіктен бе?
Dialogue: 0,0:00:42.46,0:00:43.87,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:00:43.96,0:00:45.83,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:00:45.92,0:00:49.09,Default,,0,0,0,,Оны сақта, бұл әкеңнің бөлмесінің кілті.
Dialogue: 0,0:00:49.17,0:00:52.92,Default,,0,0,0,,Уау! Вампир қанынан жасалған кілт?
Dialogue: 0,0:00:53.01,0:00:53.92,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:00:54.01,0:00:56.01,Default,,0,0,0,,Ха... бәрібір қайтар.
Dialogue: 0,0:00:56.09,0:00:58.55,Default,,0,0,0,,Маған ұнамайды! Мен оны бағалаймын!
Dialogue: 0,0:00:59.14,0:01:01.02,Default,,0,0,0,,Ммм... жақсы, жарайды.
Dialogue: 0,0:01:01.60,0:01:04.73,Default,,0,0,0,,Қозғалыс болса, айна зиче арқылы хабарласыңыз.
Dialogue: 0,0:01:04.81,0:01:05.98,Default,,0,0,0,,А... иә
Dialogue: 0,0:01:07.31,0:01:08.23,Default,,0,0,0,,Иә
Dialogue: 0,0:01:09.02,0:01:11.90,Default,,0,0,0,,Не болады деп үміттенейік
Dialogue: 0,0:01:12.57,0:01:17.07,Default,,0,0,0,,♪～
Dialogue: 0,0:02:36.24,0:02:41.24,Default,,0,0,0,,～♪
Dialogue: 0,0:02:48.41,0:02:50.42,Default,,0,0,0,,Мен тым қаталмын ба?
Dialogue: 0,0:02:52.96,0:02:58.42,Default,,0,0,0,,Білім саласының мұншалықты былғары қызметкері болса, ұят болар.
Dialogue: 0,0:02:59.09,0:03:00.84,Default,,0,0,0,,Екінші форма: Суиша!
Dialogue: 0,0:03:00.93,0:03:03.64,Default,,0,0,0,,Сіз мені «ата» деп атай аласыз ба?
Dialogue: 0,0:03:03.72,0:03:07.18,Default,,0,0,0,,Жақында мені «Ата» деп атайтыныңызға сенімдімін.
Dialogue: 0,0:03:07.27,0:03:08.27,Default,,0,0,0,,Қария?
Dialogue: 0,0:03:09.14,0:03:11.65,Default,,0,0,0,,Мұрагер болып тер төгіп жүрген жас келіншекке.
Dialogue: 0,0:03:11.73,0:03:13.98,Default,,0,0,0,,Маған Гордон мырза керек.
Dialogue: 0,0:03:14.06,0:03:15.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:16.57,0:03:21.28,Default,,0,0,0,,Рин ханымға қолдау көрсетуді жалғастырасыз ба?
Dialogue: 0,0:03:32.25,0:03:33.54,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:03:33.63,0:03:34.71,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:03:35.42,0:03:37.25,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:03:37.34,0:03:38.30,Default,,0,0,0,,(телефонды көтерген дыбыс)
Dialogue: 0,0:03:38.38,0:03:39.92,Default,,0,0,0,,Иә, мен Ринмін.
Dialogue: 0,0:03:40.01,0:03:41.47,Default,,0,0,0,,Менің бөлмеме кел
Dialogue: 0,0:03:41.55,0:03:42.72,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:03:42.80,0:03:45.89,Default,,0,0,0,,А... Әке.
Dialogue: 0,0:03:47.51,0:03:50.35,Default,,0,0,0,,Әкең асырап алған күйеу бала.
Dialogue: 0,0:03:51.27,0:03:56.15,Default,,0,0,0,,Сенің анаң жалғыз қыз болды, кішкентайынан әлсіз болыпты.
Dialogue: 0,0:03:56.23,0:03:58.78,Default,,0,0,0,,Бұл ыңғайлы неке ме?
Dialogue: 0,0:03:59.49,0:04:03.03,Default,,0,0,0,,Бірақ біз шынымен жақсы дос болдық.
Dialogue: 0,0:04:03.11,0:04:04.32,Default,,0,0,0,,Менде екі сезім де бар
Dialogue: 0,0:04:05.07,0:04:06.53,Default,,0,0,0,,Сондықтан да...
Dialogue: 0,0:04:07.83,0:04:10.41,Default,,0,0,0,,Мен көбірек өмір сүргім келді
Dialogue: 0,0:04:10.50,0:04:13.62,Default,,0,0,0,,Сіз және Рин Чан
Dialogue: 0,0:04:13.71,0:04:15.25,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:04:15.33,0:04:16.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:16.59,0:04:18.46,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:21.88,0:04:23.47,Default,,0,0,0,,Соңғы сөзге дейін
Dialogue: 0,0:04:23.55,0:04:25.97,Default,,0,0,0,,Сіз байланған шығарсыз
Dialogue: 0,0:04:26.55,0:04:28.10,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:04:29.31,0:04:33.69,Default,,0,0,0,,Екі жыл өтсе де әкем әлі де алға қарай алмайды.
Dialogue: 0,0:04:33.77,0:04:34.98,Default,,0,0,0,,Осындай қатал жағдайларға қарамастан, барлығыңыз да жақсы өнер көрсеттіңіздер.
Dialogue: 0,0:04:35.48,0:04:40.65,Default,,0,0,0,,Мұрагер болу үшін аянбай еңбек ету арқылы алға жылжып жатырмын деп ойлаймын.
Dialogue: 0,0:04:41.65,0:04:44.99,Default,,0,0,0,,Сіз шынымен асыға күтесіз бе?
Dialogue: 0,0:04:45.07,0:04:46.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:47.87,0:04:49.20,Default,,0,0,0,,Қазір...
Dialogue: 0,0:04:50.04,0:04:52.12,Default,,0,0,0,,Кейін барып көрейік пе?
Dialogue: 0,0:04:52.20,0:04:54.75,Default,,0,0,0,,Джиче мастер Арнеге хабарласа ала ма?
Dialogue: 0,0:04:54.83,0:04:56.33,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:04:58.50,0:05:00.63,Default,,0,0,0,,Әке, бұл Рин.
Dialogue: 0,0:05:02.05,0:05:03.13,Default,,0,0,0,,Әке?
Dialogue: 0,0:05:04.68,0:05:06.30,Default,,0,0,0,,Кілт...
Dialogue: 0,0:05:08.64,0:05:09.47,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:05:09.56,0:05:10.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:10.14,0:05:11.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:10.14,0:05:11.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:14.52,0:05:16.10,Default,,0,0,0,,Әке?
Dialogue: 0,0:05:20.32,0:05:21.28,Default,,0,0,0,,Мұнда келіңіз...
Dialogue: 0,0:05:21.36,0:05:22.44,Default,,0,0,0,,Қуан, Рин
Dialogue: 0,0:05:25.90,0:05:27.61,Default,,0,0,0,,Әке?
Dialogue: 0,0:05:27.70,0:05:29.66,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:05:29.74,0:05:31.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.79,0:05:35.87,Default,,0,0,0,,Бұдан былай үшеуміз әрқашан бірге боламыз.
Dialogue: 0,0:05:35.96,0:05:38.92,Default,,0,0,0,,Мәңгі, мәңгі...
Dialogue: 0,0:05:39.00,0:05:39.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:43.96,0:05:46.55,Default,,0,0,0,,Менің күйеуім келді.
Dialogue: 0,0:05:46.63,0:05:48.05,Default,,0,0,0,,(есік тұтқасының айналу дыбысы)
Dialogue: 0,0:05:48.14,0:05:48.68,Default,,0,0,0,,Иә? Ол жабық.
Dialogue: 0,0:05:48.68,0:05:50.55,Default,,0,0,0,,Иә? Ол жабық.
Dialogue: 0,0:05:48.68,0:05:50.55,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:05:52.43,0:05:53.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.68,0:05:56.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:59.44,0:06:00.52,Default,,0,0,0,,А...
Dialogue: 0,0:06:00.61,0:06:02.78,Default,,0,0,0,,Леди ханым?
Dialogue: 0,0:06:02.86,0:06:05.03,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:06:05.11,0:06:06.28,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:06:07.74,0:06:11.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:16.29,0:06:17.58,Default,,0,0,0,,...in
Dialogue: 0,0:06:17.66,0:06:20.13,Default,,0,0,0,,Линн Райнвейс әкесінің мәйітімен.
Dialogue: 0,0:06:20.21,0:06:21.75,Default,,0,0,0,,Сіз ес-түссіз жатқаныңызды айттыңыз ба?
Dialogue: 0,0:06:21.84,0:06:22.88,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:06:22.96,0:06:27.38,Default,,0,0,0,,Үй іші қараңғы болды, бірақ мен айнадан ештеңе көре алмадым.
Dialogue: 0,0:06:28.05,0:06:30.34,Default,,0,0,0,,Бұл оның әкесі ме?
Dialogue: 0,0:06:30.97,0:06:36.10,Default,,0,0,0,,Бұл сарайдағылар қожайындарын киіміне қарап танитын сияқты.
Dialogue: 0,0:06:37.81,0:06:39.02,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:39.10,0:06:41.40,Default,,0,0,0,,Рин Рейнвейстің қандас туысы емес
Dialogue: 0,0:06:41.48,0:06:44.82,Default,,0,0,0,,Иә! Бұл сіздің жалған екеніңізді білдіре ме? Не үшін?
Dialogue: 0,0:06:45.40,0:06:46.82,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:49.20,0:06:52.45,Default,,0,0,0,,А, мен барып тексерейін бе?
Dialogue: 0,0:06:55.12,0:06:57.96,Default,,0,0,0,,Жертөледе көптеген жасырын бөлмелер бар.
Dialogue: 0,0:06:58.04,0:06:59.67,Default,,0,0,0,,Бірақ бұл қымбат
Dialogue: 0,0:06:59.75,0:07:03.17,Default,,0,0,0,,Рин-чанның әкесінің аяғы ауыр еді, солай ма?
Dialogue: 0,0:07:03.25,0:07:05.55,Default,,0,0,0,,Ол мұнда да серіктестердің көмегін алған болуы керек.
Dialogue: 0,0:07:05.63,0:07:06.76,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:07:08.84,0:07:09.84,Default,,0,0,0,,Матака?
Dialogue: 0,0:07:09.93,0:07:11.72,Default,,0,0,0,,Не? Жоқ...
Dialogue: 0,0:07:11.80,0:07:12.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.14,0:07:19.35,Default,,0,0,0,,Арне?
Dialogue: 0,0:07:19.43,0:07:20.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.85,0:07:24.27,Default,,0,0,0,,Әкесі не істемекші болды деп ойлаймын.
Dialogue: 0,0:07:25.48,0:07:26.65,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:07:26.73,0:07:29.11,Default,,0,0,0,,Бұл өлгендердің қайта тірілуі.
Dialogue: 0,0:07:29.70,0:07:32.07,Default,,0,0,0,,Әйелдің бас сүйегі
Dialogue: 0,0:07:32.16,0:07:35.33,Default,,0,0,0,,Әкесі оны тірілтпек болған көрінеді.
Dialogue: 0,0:07:35.41,0:07:37.54,Default,,0,0,0,,Әйел... хехе
Dialogue: 0,0:07:37.62,0:07:40.62,Default,,0,0,0,,Енді бұл жай қуыршақ.
Dialogue: 0,0:07:40.71,0:07:43.21,Default,,0,0,0,,Ешбір ғұрып маңызды өзегісіз мүмкін емес.
Dialogue: 0,0:07:43.29,0:07:46.00,Default,,0,0,0,,Ядро... А, жүрек пе?
Dialogue: 0,0:07:46.09,0:07:48.34,Default,,0,0,0,,Міне, тергеу аяқталды.
Dialogue: 0,0:07:48.42,0:07:50.26,Default,,0,0,0,,Ал, бітті ме?
Dialogue: 0,0:07:51.88,0:07:54.47,Default,,0,0,0,,Сонда да сасық.
Dialogue: 0,0:07:54.55,0:07:56.64,Default,,0,0,0,,Қан тым араласқан.
Dialogue: 0,0:07:58.27,0:08:02.14,Default,,0,0,0,,Өтірік, әкем қайтыс болды.
Dialogue: 0,0:08:03.69,0:08:05.11,Default,,0,0,0,,Сіздің күйеуіңіз...
Dialogue: 0,0:08:05.19,0:08:06.65,Default,,0,0,0,,Оны естігім келмейді
Dialogue: 0,0:08:06.73,0:08:07.77,Default,,0,0,0,,Кетіңіз.
Dialogue: 0,0:08:07.86,0:08:09.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:09.23,0:08:10.90,Default,,0,0,0,,Мен саған кет дедім ғой!
Dialogue: 0,0:08:14.41,0:08:15.28,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:08:15.37,0:08:16.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:19.12,0:08:21.50,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарласыңыз.
Dialogue: 0,0:08:21.58,0:08:22.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:22.29,0:08:23.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:22.29,0:08:23.62,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:23.62,0:08:25.00,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:29.09,0:08:30.55,Default,,0,0,0,,Әке...
Dialogue: 0,0:08:30.63,0:08:32.22,Default,,0,0,0,,Сіз жалғыз қалдыңыз ба?
Dialogue: 0,0:08:30.63,0:08:32.22,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:08:32.30,0:08:34.18,Default,,0,0,0,,Құрметті Арне
Dialogue: 0,0:08:34.26,0:08:36.55,Default,,0,0,0,,Әкеңді танымайсың ба?
Dialogue: 0,0:08:36.64,0:08:40.35,Default,,0,0,0,,үшін оны бөлмеде өлтіріп кеткендей әсерде болды...
Dialogue: 0,0:08:40.43,0:08:42.77,Default,,0,0,0,,А, онда бұл басқа біреу.
Dialogue: 0,0:08:42.85,0:08:45.85,Default,,0,0,0,,А... Мен әлі тірімін...
Dialogue: 0,0:08:45.94,0:08:50.32,Default,,0,0,0,,Әкемнің мәйіті сонда болса, жертөледегі жасырын бөлмеде болған.
Dialogue: 0,0:08:50.40,0:08:51.57,Default,,0,0,0,,А...
Dialogue: 0,0:08:51.65,0:08:54.82,Default,,0,0,0,,Оны әріптестері өлтірген болуы мүмкін.
Dialogue: 0,0:08:55.41,0:08:57.41,Default,,0,0,0,,Ал тергеу нәтижелеріне келсек...
Dialogue: 0,0:08:57.49,0:08:59.16,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:08:59.24,0:09:01.20,Default,,0,0,0,,Мен оны естігім келмейді
Dialogue: 0,0:09:01.95,0:09:03.87,Default,,0,0,0,,Мен естігім келеді...
Dialogue: 0,0:09:03.96,0:09:06.58,Default,,0,0,0,,Түсінемін, бұл мені есеп беру қиындығынан құтқарды.
Dialogue: 0,0:09:07.29,0:09:09.29,Default,,0,0,0,,Менің сенімен келісімім аяқталды.
Dialogue: 0,0:09:09.88,0:09:11.30,Default,,0,0,0,,Адам А...
Dialogue: 0,0:09:13.26,0:09:14.26,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:15.72,0:09:17.22,Default,,0,0,0,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:09:21.14,0:09:22.35,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:09:22.43,0:09:24.02,Default,,0,0,0,,Менің саған пайдасы жоқ.
Dialogue: 0,0:09:24.10,0:09:25.10,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:09:25.19,0:09:27.65,Default,,0,0,0,,Өтінемін, мені әкеңе апар.
Dialogue: 0,0:09:27.73,0:09:29.15,Default,,0,0,0,,Сіз оны өлді деп айттыңыз.
Dialogue: 0,0:09:29.23,0:09:31.53,Default,,0,0,0,,Өз көзіммен көрмейінше сенбеймін!
Dialogue: 0,0:09:33.19,0:09:36.91,Default,,0,0,0,,Мен... Осы уақыт бойы өзімді алдадым.
Dialogue: 0,0:09:36.99,0:09:39.78,Default,,0,0,0,,Танылған мұрагер болу арқылы
Dialogue: 0,0:09:39.87,0:09:42.16,Default,,0,0,0,,Сіз алға жылжып жатырсыз.
Dialogue: 0,0:09:42.24,0:09:46.04,Default,,0,0,0,,Бірақ соңында көргім келмеген нәрседен бас тарттым...
Dialogue: 0,0:09:46.12,0:09:47.62,Default,,0,0,0,,Сіздің әкеңіз сияқты.
Dialogue: 0,0:09:49.67,0:09:52.34,Default,,0,0,0,,Бұл жолы қарамай алға қарай жылжимын.
Dialogue: 0,0:09:53.01,0:09:57.30,Default,,0,0,0,,Рейнвейс отбасының мұрагері емес, менің сүйікті анамның қызы...
Dialogue: 0,0:09:57.93,0:10:00.26,Default,,0,0,0,,Линн Рейнвейс ретінде
Dialogue: 0,0:10:01.39,0:10:02.22,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.31,0:10:06.18,Default,,0,0,0,,Мен адам баласының соңына дейін сөйлегенін бірінші рет естіп тұрмын.
Dialogue: 0,0:10:06.27,0:10:07.10,Default,,0,0,0,,А...
Dialogue: 0,0:10:07.19,0:10:08.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:11.61,0:10:12.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:12.52,0:10:14.28,Default,,0,0,0,,Ал... ұшып жатыр!
Dialogue: 0,0:10:14.36,0:10:16.49,Default,,0,0,0,,Құрметті Арне, сен неге ересек болдың?
Dialogue: 0,0:10:16.57,0:10:18.66,Default,,0,0,0,,Бұл сәл ауыр, бұл дөрекі!
Dialogue: 0,0:10:18.74,0:10:20.62,Default,,0,0,0,,Ашуланба, мен тастаймын.
Dialogue: 0,0:10:20.70,0:10:21.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:21.62,0:10:23.66,Default,,0,0,0,,Менің ойымша, ол әкесіне барады.
Dialogue: 0,0:10:23.74,0:10:26.04,Default,,0,0,0,,Бірақ сарай әлдеқашан...\NЕгер ол
Dialogue: 0,0:10:26.12,0:10:27.12,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:27.21,0:10:29.21,Default,,0,0,0,,болса, онда оны қызмет деп атаймыз.
Dialogue: 0,0:10:29.29,0:10:30.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.88,0:10:41.89,Default,,0,0,0,,Бұл... Түн патшасы көрген дүние.
Dialogue: 0,0:10:42.97,0:10:45.06,Default,,0,0,0,,Неліктен мұндай қызмет қажет?
Dialogue: 0,0:10:45.14,0:10:48.48,Default,,0,0,0,,Бұл сізге аздап ұнағанын білдіреді.
Dialogue: 0,0:10:48.56,0:10:50.02,Default,,0,0,0,,Линн Рейнвейс
Dialogue: 0,0:10:51.40,0:10:54.82,Default,,0,0,0,,Сіздің атыңыз қайта шақырылады.
Dialogue: 0,0:10:56.61,0:10:59.32,Default,,0,0,0,,Ол әлі де клиент сияқты.
Dialogue: 0,0:11:02.12,0:11:03.12,Default,,0,0,0,,(Риннің жылағаны)
Dialogue: 0,0:11:03.12,0:11:04.99,Default,,0,0,0,,(Риннің жылағаны)
Dialogue: 0,0:11:03.12,0:11:04.99,Default,,0,0,0,,Жоғарыда аталғандар тергеу нәтижелері.
Dialogue: 0,0:11:05.87,0:11:08.75,Default,,0,0,0,,Анамды өмірге қайтаруға тырысу...
Dialogue: 0,0:11:08.83,0:11:13.25,Default,,0,0,0,,Әй, анаң екеуің сарайдан кеткелі тұр едіңдер.
Dialogue: 0,0:11:14.75,0:11:18.09,Default,,0,0,0,,Әкеңнің істегені кешірілмейді.
Dialogue: 0,0:11:18.17,0:11:20.88,Default,,0,0,0,,Бірақ бұл да өлтіруге жақсы себеп...
Dialogue: 0,0:11:20.97,0:11:23.60,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:11:25.14,0:11:26.68,Default,,0,0,0,,Киіміңді ауыстыр!
Dialogue: 0,0:11:26.77,0:11:27.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.85,0:11:30.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:30.89,0:11:31.73,Default,,0,0,0,,Иә
Dialogue: 0,0:11:32.31,0:11:34.40,Default,,0,0,0,,Бұл сіздің жарыс формасы ма?
Dialogue: 0,0:11:34.48,0:11:35.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:36.53,0:11:39.69,Default,,0,0,0,,Құрметті Арне, жаңа өтініш жасаңыз.
Dialogue: 0,0:11:39.78,0:11:42.03,Default,,0,0,0,,Әкеңді өлтірген адам...
Dialogue: 0,0:11:42.11,0:11:44.66,Default,,0,0,0,,Бірге серіктес іздеңіз!
Dialogue: 0,0:11:45.49,0:11:46.79,Default,,0,0,0,,Қарастыру дегеніміз не?
Dialogue: 0,0:11:46.87,0:11:48.70,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:11:48.79,0:11:50.00,Default,,0,0,0,,Ах
Dialogue: 0,0:11:50.08,0:11:52.04,Default,,0,0,0,,Бұл біраз тентек...
Dialogue: 0,0:11:52.12,0:11:55.67,Default,,0,0,0,,Сен ақымақсың ба? Линн Райнвейс Сіз ақымақсыз ба?
Dialogue: 0,0:11:56.67,0:11:59.26,Default,,0,0,0,,Ааа, мен аламын.
Dialogue: 0,0:11:59.34,0:12:00.22,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:00.30,0:12:02.84,Default,,0,0,0,,Мені бұл іс қызықтырады.
Dialogue: 0,0:12:02.93,0:12:04.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:02.93,0:12:04.22,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:12:04.22,0:12:04.76,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:12:06.89,0:12:08.97,Default,,0,0,0,,Койой – толық ай
Dialogue: 0,0:12:09.60,0:12:11.18,Default,,0,0,0,,Күнәкар
Dialogue: 0,0:12:11.27,0:12:15.19,Default,,0,0,0,,Қызыл ай астында тәтті биле
Dialogue: 0,0:12:19.28,0:12:20.69,Default,,0,0,0,,Қылмыстық…
Dialogue: 0,0:12:20.78,0:12:24.41,Default,,0,0,0,,Серіктестікке апаратын дәлелдер қалды ма?
Dialogue: 0,0:12:25.66,0:12:27.66,Default,,0,0,0,,Әкемнің киімінде болды.
Dialogue: 0,0:12:27.74,0:12:29.91,Default,,0,0,0,,Сіз оның құлыпталғанын айттыңыз.
Dialogue: 0,0:12:30.00,0:12:30.87,Default,,0,0,0,,Иә
Dialogue: 0,0:12:30.95,0:12:33.21,Default,,0,0,0,,Кейінірек Бернд мырза келгенде,
Dialogue: 0,0:12:33.29,0:12:35.29,Default,,0,0,0,,Ол кіру үшін қайталанатын кілтті пайдаланған сияқты.
Dialogue: 0,0:12:35.38,0:12:40.05,Default,,0,0,0,,Әкем маған сағат 12:30-да бөлмесіне келуімді айтты.
Dialogue: 0,0:12:40.13,0:12:42.84,Default,,0,0,0,,Бірінші ашушы болу керек пе?
Dialogue: 0,0:12:42.92,0:12:47.05,Default,,0,0,0,,Қызметшілерді басы жоқ мәйіттің өзі екеніне сендіріңіз...
Dialogue: 0,0:12:47.14,0:12:50.77,Default,,0,0,0,,Ол бізбен бірге үйден шықпақ болды.
Dialogue: 0,0:12:50.85,0:12:55.31,Default,,0,0,0,,Жағдайды ескере отырып, ол осы уақыт ішінде өлтірілді деп болжауға болады.
Dialogue: 0,0:12:55.40,0:12:56.86,Default,,0,0,0,,Кез келген басқа қайталанатын кілттер бар ма?
Dialogue: 0,0:12:56.94,0:12:59.19,Default,,0,0,0,,Гордон мырза мен Диана мырза
Dialogue: 0,0:12:59.27,0:13:01.99,Default,,0,0,0,,Ха... сізде тым көп.
Dialogue: 0,0:13:02.99,0:13:06.20,Default,,0,0,0,,Жарайды, мұны кішкене қадамдармен жасаудың қажеті жоқ.
Dialogue: 0,0:13:08.83,0:13:10.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:10.70,0:13:13.21,Default,,0,0,0,,Сіз керемет заттарды жинайсыз ба?
Dialogue: 0,0:13:13.29,0:13:15.29,Default,,0,0,0,,Бұл осылай жұмыс істейді... Ах.
Dialogue: 0,0:13:15.37,0:13:17.04,Default,,0,0,0,,Тіпті анаңның суреті
Dialogue: 0,0:13:17.13,0:13:18.34,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:18.42,0:13:19.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.88,0:13:22.01,Default,,0,0,0,,Бұл…
Dialogue: 0,0:13:22.67,0:13:27.72,Default,,0,0,0,,Бұл үшеуміздің анамыздың дені сау кезінде түскен отбасылық суреті.
Dialogue: 0,0:13:27.80,0:13:29.51,Default,,0,0,0,,үшінмыз пикникке барайық...
Dialogue: 0,0:13:29.60,0:13:31.43,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:13:31.52,0:13:32.93,Default,,0,0,0,,Бұл да анықтама ма?
Dialogue: 0,0:13:33.73,0:13:35.14,Default,,0,0,0,,Қос құрылым…
Dialogue: 0,0:13:35.23,0:13:36.44,Default,,0,0,0,,Ол ашық па?
Dialogue: 0,0:13:36.52,0:13:37.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:37.44,0:13:38.81,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:38.90,0:13:40.65,Default,,0,0,0,,Бұл құнды естелік!
Dialogue: 0,0:13:40.73,0:13:43.03,Default,,0,0,0,,Естеліктер? Бұл жай ғана нәрсе
Dialogue: 0,0:13:43.11,0:13:43.94,Default,,0,0,0,,А...
Dialogue: 0,0:13:44.03,0:13:47.45,Default,,0,0,0,,Әкеңнің мәйіті басқа нәрсе.
Dialogue: 0,0:13:48.45,0:13:50.16,Default,,0,0,0,,«Заттар» бұл…
Dialogue: 0,0:13:50.24,0:13:51.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.41,0:13:53.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:55.08,0:13:58.42,Default,,0,0,0,,(желдеткіш арқылы өтетін дыбыс)
Dialogue: 0,0:13:59.13,0:14:00.25,Default,,0,0,0,,Пухат
Dialogue: 0,0:14:02.09,0:14:03.96,Default,,0,0,0,,Бұл шаң жұмақ еді!
Dialogue: 0,0:14:04.05,0:14:05.51,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:14:05.59,0:14:06.42,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:06.51,0:14:09.26,Default,,0,0,0,,Ол көрші қоймаға қосылды ма?
Dialogue: 0,0:14:09.34,0:14:11.93,Default,,0,0,0,,Escape қайталанатын кілтсіз де мүмкін.
Dialogue: 0,0:14:12.01,0:14:15.48,Default,,0,0,0,,Бірақ оның кеңдігі мен үшін әрең болды, солай ма?
Dialogue: 0,0:14:15.56,0:14:17.94,Default,,0,0,0,,Менен кіші...
Dialogue: 0,0:14:18.02,0:14:19.94,Default,,0,0,0,,Элиза (Элис) Сәлем...
Dialogue: 0,0:14:20.02,0:14:23.02,Default,,0,0,0,,Амансың ба? Сіз тынышсыз сияқтысыз
Dialogue: 0,0:14:23.11,0:14:25.99,Default,,0,0,0,,Жоқ... Жоқ, бұл...
Dialogue: 0,0:14:26.07,0:14:29.41,Default,,0,0,0,,Бұл уақытта сіз де боссыз...
Dialogue: 0,0:14:29.49,0:14:30.24,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:30.24,0:14:31.20,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:30.24,0:14:31.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:32.74,0:14:34.54,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:14:34.62,0:14:37.12,Default,,0,0,0,,А... менің аяғымды алып кетті.
Dialogue: 0,0:14:37.21,0:14:38.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.12,0:14:40.50,Default,,0,0,0,,Мен сенімдімін, бұл...
Dialogue: 0,0:14:40.58,0:14:41.79,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:14:41.88,0:14:42.96,Default,,0,0,0,,Біреу келе жатыр
Dialogue: 0,0:14:43.04,0:14:44.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:44.13,0:14:46.92,Default,,0,0,0,,Өсек таратудан басқа амалым жоқ.
Dialogue: 0,0:14:47.01,0:14:49.05,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:14:49.13,0:14:52.30,Default,,0,0,0,,Бастапқыда бұл ауруды тарату қабілеті болды.
Dialogue: 0,0:14:52.39,0:14:56.18,Default,,0,0,0,,Түстен кейін ханымдарға ұнайтын қабілет...
Dialogue: 0,0:14:56.89,0:14:57.93,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:14:58.02,0:14:59.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.27,0:15:00.85,Default,,0,0,0,,Басқа нәрсе жасаңыз
Dialogue: 0,0:15:00.94,0:15:01.90,Default,,0,0,0,,Иә! Мені бұлай жалғыз қалдырмаңыз...
Dialogue: 0,0:15:01.90,0:15:03.36,Default,,0,0,0,,Иә! Мені бұлай жалғыз қалдырмаңыз...
Dialogue: 0,0:15:01.90,0:15:03.36,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:03.44,0:15:04.94,Default,,0,0,0,,Ханым?
Dialogue: 0,0:15:05.03,0:15:07.03,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:15:07.11,0:15:09.65,Default,,0,0,0,,Иә? Бұл не тағам?
Dialogue: 0,0:15:09.74,0:15:11.41,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:15:11.49,0:15:15.04,Default,,0,0,0,,Оқиғаны тексеруге келдіңіз бе?
Dialogue: 0,0:15:15.12,0:15:16.12,Default,,0,0,0,,Соңында біз оны U.A.-ға қабылдап алдық
Dialogue: 0,0:15:16.20,0:15:18.16,Default,,0,0,0,,Иә, өсек-аяң болды.
Dialogue: 0,0:15:19.00,0:15:21.63,Default,,0,0,0,,Ең әдемі детектив ретінде
Dialogue: 0,0:15:21.71,0:15:24.75,Default,,0,0,0,,Сіз көптеген қиын істерді шештіңіз, солай емес пе?
Dialogue: 0,0:15:24.84,0:15:26.76,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:26.84,0:15:28.13,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:15:28.21,0:15:31.13,Default,,0,0,0,,Бұл Шерлок Холмстың реинкарнациясы!
Dialogue: 0,0:15:31.22,0:15:32.47,Default,,0,0,0,,Бұл Пуаро емес пе?
Dialogue: 0,0:15:32.55,0:15:34.47,Default,,0,0,0,,Вау~ Қол қойыңыз!
Dialogue: 0,0:15:34.55,0:15:36.64,Default,,0,0,0,,Мен соңғы кездері жұмбақпен айналысып жүрмін.
Dialogue: 0,0:15:36.72,0:15:38.68,Default,,0,0,0,,Бұл өсек-аяңнан гөрі миды жуу сияқты ма?
Dialogue: 0,0:15:38.77,0:15:40.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:42.10,0:15:44.98,Default,,0,0,0,,Ханым, сізге айтарым бар.
Dialogue: 0,0:15:45.07,0:15:47.44,Default,,0,0,0,,(сағат шырылдаған дыбыс)
Dialogue: 0,0:15:47.53,0:15:49.78,Default,,0,0,0,,Ух... тағы бір уағыз.
Dialogue: 0,0:15:49.86,0:15:50.70,Default,,0,0,0,,Ах
Dialogue: 0,0:15:54.16,0:15:55.99,Default,,0,0,0,,Жер астында әлі бірдеңе бар ма?
Dialogue: 0,0:15:56.08,0:15:58.04,Default,,0,0,0,,Мен саған өзімнің қалағанымды істей алатынымды айттым.
Dialogue: 0,0:15:58.12,0:15:58.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.04,0:16:04.88,Default,,0,0,0,,Мең болғың келе ме?
Dialogue: 0,0:16:05.71,0:16:07.46,Default,,0,0,0,,Жер асты жер асты
Dialogue: 0,0:16:09.67,0:16:13.55,Default,,0,0,0,,Осы сарайға келгеннен бері менің жүрегім бірдеңе деп жауап береді.
Dialogue: 0,0:16:13.64,0:16:16.26,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:16:16.35,0:16:21.23,Default,,0,0,0,,Аа, мен бұл атауды мұндай жерде көремін деп ойламадым.
Dialogue: 0,0:16:21.31,0:16:23.69,Default,,0,0,0,,Начзелер
Dialogue: 0,0:16:23.77,0:16:26.56,Default,,0,0,0,,Ол тоғыз патшаның бірі болған.
Dialogue: 0,0:16:26.65,0:16:28.27,Default,,0,0,0,,Ол қазірдің өзінде қайта жанданды ма?
Dialogue: 0,0:16:28.36,0:16:30.57,Default,,0,0,0,,Белгі болса, мен бірден білемін
Dialogue: 0,0:16:30.65,0:16:33.99,Default,,0,0,0,,Сонда маңызды жүрек қайда кетті?
Dialogue: 0,0:16:34.07,0:16:36.83,Default,,0,0,0,,Мүмкін сіз әріптестеріңізден сұрасаңыз, білуге ​​болады.
Dialogue: 0,0:16:39.29,0:16:42.66,Default,,0,0,0,,Әй, бұл менің қаным ғой.
Dialogue: 0,0:16:42.75,0:16:43.62,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:16:46.13,0:16:48.92,Default,,0,0,0,,Мен бұл жағдайды полицияға хабарлаған жоқпын.
Dialogue: 0,0:16:49.00,0:16:50.09,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:50.17,0:16:51.84,Default,,0,0,0,,Жанжалдан
Dialogue: 0,0:16:51.92,0:16:54.80,Default,,0,0,0,,Рейнвейс фамилиясын қорғау.
Dialogue: 0,0:16:54.88,0:16:56.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:56.80,0:16:58.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:58.76,0:17:00.93,Default,,0,0,0,,Мен әлі ерте деп ойладым.
Dialogue: 0,0:17:01.02,0:17:06.40,Default,,0,0,0,,Отағасы болатын Рин ханым білуі керек нәрселер бар.
Dialogue: 0,0:17:06.48,0:17:09.27,Default,,0,0,0,,Әйелімнің өмірден өткеніне екі жыл болды
Dialogue: 0,0:17:09.36,0:17:12.61,Default,,0,0,0,,Сарайдың өзгеруіне жеткілікті уақыт болды.
Dialogue: 0,0:17:13.57,0:17:15.32,Default,,0,0,0,,Диана мен Элиза
Dialogue: 0,0:17:15.41,0:17:21.08,Default,,0,0,0,,Екеуі зәулім сарайда қонақтарды қарсы алуға мәжбүр болды.
Dialogue: 0,0:17:21.16,0:17:23.12,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:17:24.37,0:17:26.79,Default,,0,0,0,,Ал Кай Дианаға
Dialogue: 0,0:17:26.88,0:17:30.50,Default,,0,0,0,,Берндтің Элизаға деген сезімі болды.
Dialogue: 0,0:17:30.59,0:17:33.47,Default,,0,0,0,,Ол Дианамен қарым-қатынасының танылғанын қалайды.
Dialogue: 0,0:17:33.55,0:17:36.63,Default,,0,0,0,,Кай бірде күйеуінің қасына келді.
Dialogue: 0,0:17:36.72,0:17:40.97,Default,,0,0,0,,Мен не істеп жатқанымды білуге ​​де тырысқан жоқпын.
Dialogue: 0,0:17:41.06,0:17:44.14,Default,,0,0,0,,Бернд Элизаға құрмет көрсету үшін
Dialogue: 0,0:17:44.23,0:17:47.23,Default,,0,0,0,,Қоймадан тауарларды ұрлау туралы бөлім бар.
Dialogue: 0,0:17:47.81,0:17:51.61,Default,,0,0,0,,Хайнц ешқашан тамақ жасамайтын күйеу.
Dialogue: 0,0:17:51.69,0:17:53.86,Default,,0,0,0,,Сіздің ойыңызда бір нәрсе бар сияқты.
Dialogue: 0,0:17:54.44,0:17:55.57,Default,,0,0,0,,Рин ханым
Dialogue: 0,0:17:55.65,0:17:59.16,Default,,0,0,0,,Бұдан былай мен бұл үйді және қызметшілерді қорғаймын.
Dialogue: 0,0:17:59.24,0:18:01.24,Default,,0,0,0,,Сіз бақылаудасыз
Dialogue: 0,0:18:01.33,0:18:02.91,Default,,0,0,0,,Осылай киінген
Dialogue: 0,0:18:02.99,0:18:06.96,Default,,0,0,0,,Бұл детективке еліктейтін уақыт емес.
Dialogue: 0,0:18:07.67,0:18:09.25,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:09.25,0:18:09.92,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:09.25,0:18:09.92,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:09.92,0:18:10.00,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:10.00,0:18:11.63,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:18:10.00,0:18:11.63,Default,,0,0,0,,Ах... (Гордон) Иә?
Dialogue: 0,0:18:12.75,0:18:13.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:13.67,0:18:15.51,Default,,0,0,0,,Гейнц мырза!
Dialogue: 0,0:18:16.17,0:18:18.13,Default,,0,0,0,,Сәлем Рин Чан...
Dialogue: 0,0:18:18.22,0:18:19.47,Default,,0,0,0,,Мен басқа біреуге қоңырау шала аламын.
Dialogue: 0,0:18:19.55,0:18:21.43,Default,,0,0,0,,K… Жарақат – бұл…
Dialogue: 0,0:18:21.51,0:18:24.02,Default,,0,0,0,,Ой, жарайды, бұл үлкен мәселе емес...
Dialogue: 0,0:18:24.10,0:18:25.43,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:18:27.56,0:18:28.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:28.48,0:18:29.85,Default,,0,0,0,,Гордон мырза!
Dialogue: 0,0:18:30.73,0:18:32.57,Default,,0,0,0,,Гордон мырза, Гордон мырза!
Dialogue: 0,0:18:32.65,0:18:34.28,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:18:35.90,0:18:36.74,Default,,0,0,0,,Диана!
Dialogue: 0,0:18:37.86,0:18:40.20,Default,,0,0,0,,Амансың ба? Жер бетінде не ...
Dialogue: 0,0:18:40.28,0:18:41.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:41.32,0:18:43.45,Default,,0,0,0,,Ұрылар басып кірген сияқты.
Dialogue: 0,0:18:43.54,0:18:45.41,Default,,0,0,0,,А... басып кіру?
Dialogue: 0,0:18:45.50,0:18:47.62,Default,,0,0,0,,Сіз майданнан қашып кеттіңіз бе?
Dialogue: 0,0:18:47.71,0:18:50.21,Default,,0,0,0,,Жоқ, жоқ, бұзушы.
Dialogue: 0,0:18:50.29,0:18:52.38,Default,,0,0,0,,Бірақ оның артқы есіктен кіргеніне сенімдімін.
Dialogue: 0,0:18:52.46,0:18:55.71,Default,,0,0,0,,Артқы есік? Күзет иттер болса да?
Dialogue: 0,0:18:55.80,0:18:59.47,Default,,0,0,0,,Тек қожайын мен жас келіншек үрмейді...
Dialogue: 0,0:18:59.55,0:19:02.93,Default,,0,0,0,,А, менің ойымша, Кай да оған байланған.
Dialogue: 0,0:19:03.01,0:19:04.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:04.81,0:19:06.93,Default,,0,0,0,,Кайдан күдіктенесің бе?
Dialogue: 0,0:19:07.02,0:19:08.56,Default,,0,0,0,,Жоқ~
Dialogue: 0,0:19:08.64,0:19:11.73,Default,,0,0,0,,Бірақ менің қауіпсіздігім тамаша болды.
Dialogue: 0,0:19:11.81,0:19:13.02,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:13.11,0:19:14.69,Default,,0,0,0,,Элизаның сызаттарын қараңыз
Dialogue: 0,0:19:14.77,0:19:17.19,Default,,0,0,0,,Сіздің қауіпсіздігіңіз төңкерілді ме?
Dialogue: 0,0:19:17.28,0:19:20.03,Default,,0,0,0,,Уф... Себебі қан бар...
Dialogue: 0,0:19:20.11,0:19:20.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:21.03,0:19:22.91,Default,,0,0,0,,Жауапкершіліктен неге жалтармайсың?
Dialogue: 0,0:19:22.99,0:19:23.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:23.91,0:19:25.83,Default,,0,0,0,,Тоқта, жас ханымның алдында.
Dialogue: 0,0:19:25.91,0:19:28.04,Default,,0,0,0,,Жоқ, қалай ойласаң да, бұл Кай.
Dialogue: 0,0:19:28.12,0:19:31.33,Default,,0,0,0,,Ах~ Диана да сыбайлас па?
Dialogue: 0,0:19:31.42,0:19:34.13,Default,,0,0,0,,Күйеуін шынымен жек көрсе керек.
Dialogue: 0,0:19:34.21,0:19:36.92,Default,,0,0,0,,үшін осындай! Тіпті Элиза...
Dialogue: 0,0:19:37.01,0:19:37.84,Default,,0,0,0,,А...
Dialogue: 0,0:19:37.92,0:19:40.05,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:19:40.76,0:19:44.14,Default,,0,0,0,,Элизаның біреуді өлтіруі мүмкін емес!
Dialogue: 0,0:19:44.80,0:19:45.89,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:19:46.68,0:19:48.52,Default,,0,0,0,,Мен енді ғана түсіндім
Dialogue: 0,0:19:54.31,0:19:57.07,Default,,0,0,0,,Әй, шай бұзылды.
Dialogue: 0,0:19:57.15,0:19:59.61,Default,,0,0,0,,Маған бұл маңызды емес.
Dialogue: 0,0:19:59.69,0:20:01.78,Default,,0,0,0,,Мен үшін бұл дәлел жақсырақ.
Dialogue: 0,0:20:01.86,0:20:03.78,Default,,0,0,0,,«Болды» бірақ
Dialogue: 0,0:20:03.87,0:20:07.16,Default,,0,0,0,,Әкесінің өлімі Ешкім...
Dialogue: 0,0:20:07.24,0:20:09.37,Default,,0,0,0,,Жақсы, төгілді.
Dialogue: 0,0:20:09.45,0:20:11.83,Default,,0,0,0,,Дәмі бәрібір дәмді болады.
Dialogue: 0,0:20:11.92,0:20:13.12,Default,,0,0,0,,Не айтып тұрсыз?
Dialogue: 0,0:20:13.21,0:20:17.63,Default,,0,0,0,,Білмейсіз бе? Соны жалап, дәмін тат деп жатырмын.
Dialogue: 0,0:20:17.71,0:20:20.88,Default,,0,0,0,,Ешкім қайғылы емес
Dialogue: 0,0:20:20.97,0:20:23.76,Default,,0,0,0,,Иә? Сен жындысың ба?
Dialogue: 0,0:20:23.84,0:20:26.35,Default,,0,0,0,,Одан гөрі сен кінәлі Кай деп отырсың!
Dialogue: 0,0:20:26.43,0:20:28.72,Default,,0,0,0,,Кай-санның кінәлі болуы мүмкін емес!
Dialogue: 0,0:20:28.81,0:20:32.31,Default,,0,0,0,,Иә, солай деп ойлаймын. Қалай қарасаң да күмәнді.
Dialogue: 0,0:20:32.39,0:20:33.90,Default,,0,0,0,,(Дауыстар таласып жатыр)
Dialogue: 0,0:20:33.98,0:20:38.11,Default,,0,0,0,,Менің осы уақытқа дейін көргенім...
Dialogue: 0,0:20:40.69,0:20:42.11,Default,,0,0,0,,Бейқам болмаңыз!
Dialogue: 0,0:20:46.57,0:20:48.62,Default,,0,0,0,,Салқындатыңыз.
Dialogue: 0,0:20:48.70,0:20:50.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:52.00,0:20:53.29,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:53.37,0:20:56.00,Default,,0,0,0,,Түн түскенде мен полиция шақырамын.
Dialogue: 0,0:20:56.08,0:20:58.21,Default,,0,0,0,,Бірақ... мен шешіп қойдым.
Dialogue: 0,0:21:03.05,0:21:05.26,Default,,0,0,0,,Әкең өлтірілгенде
Dialogue: 0,0:21:05.34,0:21:07.89,Default,,0,0,0,,Маған не істеп жатқаныңызды айта аласыз ба?
Dialogue: 0,0:21:12.93,0:21:15.85,Default,,0,0,0,,Арне? Бұл Арне
Dialogue: 0,0:21:15.94,0:21:18.69,Default,,0,0,0,,Ха... Содан бері естігенім жоқ.
Dialogue: 0,0:21:20.07,0:21:20.90,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:20.98,0:21:24.07,Default,,0,0,0,,Бірақ бұл қызықты болатын сияқты.
Dialogue: 0,0:21:25.66,0:21:27.20,Default,,0,0,0,,♪～
Dialogue: 0,0:21:27.28,0:21:30.66,Default,,0,0,0,,♪～
Dialogue: 0,0:22:48.61,0:22:54.12,Default,,0,0,0,,～♪
