Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.06,0:00:24.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:24.11,0:00:31.18,Default,,0,0,0,,♪♪ «Кемпірқосақ басталған сиқырлы сөздер есімде».
Dialogue: 0,0:00:31.18,0:00:38.59,Default,,0,0,0,,♪♪ «Ол кезде дүниедегі барлық нәрсе бірден боялған».
Dialogue: 0,0:00:38.59,0:00:45.73,Default,,0,0,0,,♪♪ «Шын дауыс әрқашан дұрыс жолды жарықтандырады».
Dialogue: 0,0:00:45.73,0:00:53.47,Default,,0,0,0,,♪♪ «Мен бұған күмәнданамын, сондықтан мен оған қатты сенемін».
Dialogue: 0,0:00:53.47,0:01:00.71,Default,,0,0,0,,♪♪ «Жүректің соғуы, ингаляция және дем шығару жалғасуда».
Dialogue: 0,0:01:00.71,0:01:07.89,Default,,0,0,0,,♪♪ «Менің жүрегім әрқашан соншалықты құмар болатынының нақты себебі»
Dialogue: 0,0:01:07.89,0:01:14.76,Default,,0,0,0,,♪♪ «Бұлттардың арғы жағындағы галактика сияқты, бір жерде жоғалтқан билет сияқты».
Dialogue: 0,0:01:14.76,0:01:22.80,Default,,0,0,0,,♪♪ «Себебі сенде ол бар, туылғанға дейінгі тарих сияқты».
Dialogue: 0,0:01:22.80,0:01:30.01,Default,,0,0,0,,♪♪ «Менің түсінгенім осы.»
Dialogue: 0,0:01:30.01,0:01:36.51,Default,,0,0,0,,♪♪ «Мен жалғыз түсінемін»
Dialogue: 0,0:01:39.55,0:01:50.20,Default,,0,0,0,,(цикадалардың дыбысы)
Dialogue: 0,0:01:50.20,0:01:54.00,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:01:59.87,0:02:02.87,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:02.87,0:02:07.07,Default,,0,0,0,,Таңқаларлық. Мен перде сатып алмаймын...
Dialogue: 0,0:02:14.22,0:02:16.92,Default,,0,0,0,,Қуырылған тауық еті. Соңғысы...
Dialogue: 0,0:02:21.99,0:02:27.33,Default,,0,0,0,,<Бүгінгі матч Шишиоға қарсы 6 топтық турнир. →
Dialogue: 0,0:02:27.33,0:02:29.73,Default,,0,0,0,,Қарсылас – Харунобу Никайдо＞
Dialogue: 0,0:02:31.77,0:02:34.37,Default,,0,0,0,,Жазғы демалыс жақындап қалды...
Dialogue: 0,0:02:40.58,0:02:44.78,Default,,0,0,0,,<Бүгін кәсіби маман болғаннан кейінгі бірінші кездесуім>
Dialogue: 0,0:02:44.78,0:02:48.88,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:02:51.59,0:03:01.23,Default,,0,0,0,,♪♪～ (саябақтағы BGM)
Dialogue: 0,0:03:01.23,0:03:04.77,Default,,0,0,0,,<Жазғы демалыста, әмбебап дүкеннің шатырында және т.б.→
Dialogue: 0,0:03:04.77,0:03:08.17,Default,,0,0,0,,Жыл сайын балалар шоги турнирі өткізілді. →
Dialogue: 0,0:03:08.17,0:03:11.91,Default,,0,0,0,,мадақтау тобына кірер алдында еліміздің түкпір-түкпірінен келген мықты балалар →
Dialogue: 0,0:03:11.91,0:03:15.78,Default,,0,0,0,,Біз осы шағын турнирлерде жиі кездесеміз. →
Dialogue: 0,0:03:15.78,0:03:19.95,Default,,0,0,0,,Мен де, Харунобу да мұндай іс-шараларға тұрақты қатысамыз→
Dialogue: 0,0:03:19.95,0:03:23.32,Default,,0,0,0,,Біз бірнеше рет кездескенбіз. →
Dialogue: 0,0:03:23.32,0:03:27.63,Default,,0,0,0,,Бұл неше сынып еді? Өте ыстық оқиға →
Dialogue: 0,0:03:27.63,0:03:32.83,Default,,0,0,0,,Харунобу екеуміз жартылай финалда кездестік... →
Dialogue: 0,0:03:32.83,0:03:36.03,Default,,0,0,0,,Сол күні өте ыстық болды＞
Dialogue: 0,0:03:38.70,0:03:43.34,Default,,0,0,0,,＜Ол ыстықты ұнатпайды, сондықтан қызыл жын сияқты ашық қызылға айналады→
Dialogue: 0,0:03:43.34,0:03:48.15,Default,,0,0,0,,Бұл өте ауыр көрінеді →
Dialogue: 0,0:03:48.15,0:03:51.15,Default,,0,0,0,,Қарап тұрған менің де ішім ауырып кетті.＞
Dialogue: 0,0:03:55.62,0:04:00.92,Default,,0,0,0,,<Түстен кейін жел тоқтап, ауа температурасы одан әрі көтерілді>
Dialogue: 0,0:04:03.36,0:04:06.16,Default,,0,0,0,,<Ол анемиямен ауыратын шығар. →
Dialogue: 0,0:04:06.16,0:04:10.26,Default,,0,0,0,,Оның беті барған сайын бозарып кетті>
Dialogue: 0,0:04:17.78,0:04:23.21,Default,,0,0,0,,<Мүмкін тәкаппар ой шығар... →
Dialogue: 0,0:04:23.21,0:04:25.55,Default,,0,0,0,,Бірақ мен оны ең қысқа мерзімде орындадым →
Dialogue: 0,0:04:25.55,0:04:29.22,Default,,0,0,0,,Мен блокқа жетудің жолын іздедім. →
Dialogue: 0,0:04:29.22,0:04:33.02,Default,,0,0,0,,Баланы мүмкіндігінше тезірек алдыңызға салқын, кондиционері бар жерге қойыңыз→
Dialogue: 0,0:04:33.02,0:04:36.86,Default,,0,0,0,,Демалу керек деп ойладым. →
Dialogue: 0,0:04:36.86,0:04:38.86,Default,,0,0,0,,Бірақ...>
Dialogue: 0,0:04:45.97,0:04:49.01,Default,,0,0,0,,<Ойынның соңында ол қатты жеңіліп жатқанда →
Dialogue: 0,0:04:49.01,0:04:55.41,Default,,0,0,0,,Олар қолындағы барлық кесектерді өз территориясына лақтырып, шарасыз қарсылық көрсете бастады. →
Dialogue: 0,0:04:55.41,0:04:58.22,Default,,0,0,0,,Тер басқан, бозарған жүзден→
Dialogue: 0,0:04:58.22,0:05:01.82,Default,,0,0,0,,Дауыссыз айқай шықты...＞
Dialogue: 0,0:05:03.99,0:05:06.02,Default,,0,0,0,,«Мен жоғалтқым келмейді.→
Dialogue: 0,0:05:06.02,0:05:08.29,Default,,0,0,0,,Мен жоғалтқым келмейді. →
Dialogue: 0,0:05:08.29,0:05:10.23,Default,,0,0,0,,Мен жеңілгім келмейді. →
Dialogue: 0,0:05:10.23,0:05:12.66,Default,,0,0,0,,Мен жеңілгім келмейді. →
Dialogue: 0,0:05:12.66,0:05:14.86,Default,,0,0,0,,Мен жоғалтқым келмейді.''
Dialogue: 0,0:05:17.30,0:05:21.31,Default,,0,0,0,,<Сол кезде мен өз басымнан ұялдым>
Dialogue: 0,0:05:21.31,0:05:23.68,Default,,0,0,0,,«Мен жеңілгім келмейді».
Dialogue: 0,0:05:23.68,0:05:26.91,Default,,0,0,0,,<Алдымдағы адам сондай терлеп кетті→
Dialogue: 0,0:05:26.91,0:05:29.65,Default,,0,0,0,,Мен осында отырмын басы айналып →
Dialogue: 0,0:05:29.65,0:05:32.55,Default,,0,0,0,,«Себебі мен жеңгім келеді». →
Dialogue: 0,0:05:32.55,0:05:36.85,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз →
Dialogue: 0,0:05:36.85,0:05:40.29,Default,,0,0,0,,Дәл мен сияқты... →
Dialogue: 0,0:05:40.29,0:05:42.99,Default,,0,0,0,,Бұл ұзақ шайқас болды＞
Dialogue: 0,0:05:45.43,0:05:48.83,Default,,0,0,0,,<Мен жеңген болатынмын... →
Dialogue: 0,0:05:48.83,0:05:53.10,Default,,0,0,0,,Десе де, ол жасаған әрбір қимылы, ол күресіп жатқандай көрінбейтін жолмен жүреді →
Dialogue: 0,0:05:53.10,0:05:56.71,Default,,0,0,0,,Іздеуді және көрсетуді жалғастырыңыз…. →
Dialogue: 0,0:05:56.71,0:06:02.38,Default,,0,0,0,,Алайда, ақыры меңзейтін қолдар қалмайтын уақыт келді. →
Dialogue: 0,0:06:02.38,0:06:05.35,Default,,0,0,0,,Қанша көзімді қыссам да, еш жерден таба алмаймын→
Dialogue: 0,0:06:05.35,0:06:08.35,Default,,0,0,0,,Менің доп өмір сүруге жол жоқ...>
Dialogue: 0,0:06:13.02,0:06:15.02,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:06:21.73,0:06:25.57,Default,,0,0,0,,<Ол осылай күңкілдегенде, ол мультфильмдегідей үлкен көз жасына ерік берді.→
Dialogue: 0,0:06:25.57,0:06:28.54,Default,,0,0,0,,Ол төгіле бастады. →
Dialogue: 0,0:06:28.54,0:06:34.28,Default,,0,0,0,,Мен оны әмбебап дүкеннің төбесінде цикадалар мен BGM дыбысымен тыңдадым →
Dialogue: 0,0:06:34.28,0:06:37.78,Default,,0,0,0,,Ол үнсіз қарап қалды. →
Dialogue: 0,0:06:37.78,0:06:42.78,Default,,0,0,0,,Мүмкін... Мен бұл жүзбен ондаған жылдар бойы бетпе-бет келуім мүмкін.＞
Dialogue: 0,0:06:46.59,0:06:57.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:57.14,0:07:00.71,Default,,0,0,0,,<Кәсіби маман болу →
Dialogue: 0,0:07:00.71,0:07:04.71,Default,,0,0,0,,Тоқтамайтын пойызға секіргендей.
Dialogue: 0,0:07:09.08,0:07:12.02,Default,,0,0,0,,<Мен қайта түсе алмаймын. →
Dialogue: 0,0:07:12.02,0:07:15.32,Default,,0,0,0,,Мен жеңіліп, құлағанша...>
Dialogue: 0,0:07:18.42,0:07:21.13,Default,,0,0,0,,<Осы кішкентай ғаламда→
Dialogue: 0,0:07:21.13,0:07:25.73,Default,,0,0,0,,Бұл жеңістер мен жеңілістердің ақылға сыймайтын саны. →
Dialogue: 0,0:07:25.73,0:07:29.83,Default,,0,0,0,,«Жеңілгім келмейді» деп ентігіп қалдым...>
Dialogue: 0,0:07:44.08,0:07:47.12,Default,,0,0,0,,О Кирияма. Қараңыз.
Dialogue: 0,0:07:47.12,0:07:50.52,Default,,0,0,0,,Сіздің қарсыласыңыз үлкен ынтамен күтуде.
Dialogue: 0,0:07:50.52,0:07:52.52,Default,,0,0,0,,?
Dialogue: 0,0:08:01.20,0:08:06.07,Default,,0,0,0,,Не? Мен бұл басқа манга дерлік екеніне қатты қуандым.
Dialogue: 0,0:08:06.07,0:08:10.64,Default,,0,0,0,,Не? Сөйтсем... «Келесі шығарылым, мен кептеліп қаламын...» Бірдеңе солай ма?
Dialogue: 0,0:08:10.64,0:08:13.21,Default,,0,0,0,,Мен қызғанамын, Кирияма☆
Dialogue: 0,0:08:13.21,0:08:16.95,Default,,0,0,0,,Мына рухты қараңыз. Мұның бәрі сен үшін, солай емес пе?
Dialogue: 0,0:08:16.95,0:08:19.55,Default,,0,0,0,,Біз өмір бойы бәсекелеспіз дедіңіз ғой, солай ма? Ол☆
Dialogue: 0,0:08:25.09,0:08:27.96,Default,,0,0,0,,<Тынышталыңыз. →
Dialogue: 0,0:08:27.96,0:08:33.16,Default,,0,0,0,,Алдымен баяу тыныс алыңыз. Таяз тыныс алу көруді тарылтады
Dialogue: 0,0:08:39.24,0:08:41.17,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:08:41.17,0:08:43.17,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Кирияма. Күтуден шаршадым.
Dialogue: 0,0:08:43.17,0:08:45.74,Default,,0,0,0,,Мен уақытында келдім.
Dialogue: 0,0:08:45.74,0:08:48.98,Default,,0,0,0,,Ерте келген Никайдо-сан еді ғой? Сондай-ақ….
Dialogue: 0,0:08:48.98,0:08:52.85,Default,,0,0,0,,Мен түсіндім☆ Ммм. Алып бара жатырмын.
Dialogue: 0,0:08:52.85,0:08:55.45,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:08:55.45,0:08:57.39,Default,,0,0,0,,бастайық.
Dialogue: 0,0:08:57.39,0:09:15.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:15.21,0:09:17.91,Default,,0,0,0,,<2 Гокатсура... келді>
Dialogue: 0,0:09:21.61,0:09:23.61,Default,,0,0,0,,<24 күміс>
Dialogue: 0,0:09:26.45,0:09:28.65,Default,,0,0,0,,<35 қадам>
Dialogue: 0,0:09:32.29,0:09:34.29,Default,,0,0,0,,<Бірдей күміс>
Dialogue: 0,0:09:37.96,0:09:40.06,Default,,0,0,0,,<15 қадам>
Dialogue: 0,0:09:42.37,0:09:45.60,Default,,0,0,0,,<Ол күшейіп барады... →
Dialogue: 0,0:09:45.60,0:09:49.97,Default,,0,0,0,,Баяу, бірақ тайсалмай шабуыл жасайды. →
Dialogue: 0,0:09:49.97,0:09:53.27,Default,,0,0,0,,Жоқ. Егер сіз оны жай ғана қабылдасаңыз, сіз оны алмайсыз! ! ＞
Dialogue: 0,0:09:57.08,0:09:59.28,Default,,0,0,0,,<Ағынды өзгертіңіз! ! ＞
Dialogue: 0,0:10:04.92,0:10:12.22,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:10:21.11,0:10:23.11,Default,,0,0,0,,<Тер.... →
Dialogue: 0,0:10:23.11,0:10:27.91,Default,,0,0,0,,Сол кездегідей... Бозарған көрінеді... →
Dialogue: 0,0:10:27.91,0:10:30.68,Default,,0,0,0,,Никайдо біртүрлі әрекет етеді! ! ＞
Dialogue: 0,0:10:30.68,0:10:33.72,Default,,0,0,0,,Кешіріңіз. Кондиционер қосулы ма?
Dialogue: 0,0:10:33.72,0:10:39.12,Default,,0,0,0,,Кешіріңіз. Кондиционер жақсы жұмыс істемейтін сияқты...
Dialogue: 0,0:10:39.12,0:10:41.62,Default,,0,0,0,,Жарайды, Кирияма.
Dialogue: 0,0:10:45.90,0:10:49.60,Default,,0,0,0,,Сол әмбебап дүкеннің төбесімен салыстырғанда, бұл жұмақ.
Dialogue: 0,0:10:54.94,0:10:56.94,Default,,0,0,0,,Әрі қарай жалғастырайық.
Dialogue: 0,0:11:05.68,0:11:09.55,Default,,0,0,0,,<5 Шичика…. →
Dialogue: 0,0:11:09.55,0:11:12.36,Default,,0,0,0,,Менімен бірге жүрдің бе? →
Dialogue: 0,0:11:12.36,0:11:15.99,Default,,0,0,0,,Сонда бұл. →
Dialogue: 0,0:11:15.99,0:11:18.29,Default,,0,0,0,,76 қадам＞
Dialogue: 0,0:11:24.14,0:11:27.07,Default,,0,0,0,,<Не!?→
Dialogue: 0,0:11:27.07,0:11:30.37,Default,,0,0,0,,6 сегіз күміс!?→
Dialogue: 0,0:11:30.37,0:11:34.25,Default,,0,0,0,,Инкассаторды жалғыз қалдырып, күмісті ұрып!?→
Dialogue: 0,0:11:34.25,0:11:37.18,Default,,0,0,0,,Не!?→
Dialogue: 0,0:11:37.18,0:11:39.78,Default,,0,0,0,,Бұл не!?＞
Dialogue: 0,0:11:39.78,0:11:53.58,Default,,0,0,0,,(цикада айқайы)
Dialogue: 0,0:12:01.81,0:12:07.61,Default,,0,0,0,,<Иә. Мен жоғалтқым келмейді. →
Dialogue: 0,0:12:07.61,0:12:09.95,Default,,0,0,0,,Сіз жоғалтқыңыз келмейді, солай ма?
Dialogue: 0,0:12:09.95,0:12:19.92,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:19.92,0:12:25.73,Default,,0,0,0,,<Тынышталыңыз, терең тыныс алыңыз және көзіңізді бақырайтыңыз. →
Dialogue: 0,0:12:25.73,0:12:32.50,Default,,0,0,0,,Егер мен сабырлы бола алсам, бұл жағдайда жақсырақ болуым керек еді. →
Dialogue: 0,0:12:32.50,0:12:36.10,Default,,0,0,0,,Сабырлы болыңыз және нұсқауды жалғастырыңыз! ! ＞
Dialogue: 0,0:12:42.88,0:12:48.88,Default,,0,0,0,,<Ойын түнге дейін жалғасты, мен Харунобудың табандылығынан арыла бердім.>
Dialogue: 0,0:12:53.66,0:12:55.66,Default,,0,0,0,,<және>
Dialogue: 0,0:13:01.73,0:13:04.23,Default,,0,0,0,,Жоқ. Мен жеңілдім.
Dialogue: 0,0:13:06.97,0:13:10.88,Default,,0,0,0,,<Аа, дұрыс. Бұл бет...→
Dialogue: 0,0:13:10.88,0:13:15.31,Default,,0,0,0,,Әлі де сол. Мен бала кезімде. →
Dialogue: 0,0:13:15.31,0:13:18.22,Default,,0,0,0,,Ештеңе өзгерген жоқ. →
Dialogue: 0,0:13:18.22,0:13:23.75,Default,,0,0,0,,Никайдо да, мен де сенімдімін. →
Dialogue: 0,0:13:23.75,0:13:29.25,Default,,0,0,0,,Мәңгі осылай... мәңгі қалатынына сенімдімін.
Dialogue: 0,0:13:32.76,0:13:35.46,Default,,0,0,0,,Харунобу-сама. Ханаока! ! ?
Dialogue: 0,0:13:38.27,0:13:41.47,Default,,0,0,0,,Жасыл демалыс!? Дүние жүзін аралау не болды!?
Dialogue: 0,0:13:41.47,0:13:44.34,Default,,0,0,0,,Ол 80 күн оралуы керек емес пе еді?
Dialogue: 0,0:13:44.34,0:13:49.18,Default,,0,0,0,,Менің орныма ұлы әйел келді. Маған 10 күн жеткілікті.
Dialogue: 0,0:13:49.18,0:13:52.08,Default,,0,0,0,,Маған круиз өте ұнады.
Dialogue: 0,0:13:52.08,0:13:56.82,Default,,0,0,0,,Шынымды айтсам, мен Харунобу-самадан алыс болу үшін көбірек уайымдап, уайымдап жүрмін.
Dialogue: 0,0:13:56.82,0:14:00.82,Default,,0,0,0,,Аритмия тудыруы мүмкін деген қауіп болды.
Dialogue: 0,0:14:03.89,0:14:06.63,Default,,0,0,0,,Сіз ауруханаға барған жоқсыз, солай ма? →
Dialogue: 0,0:14:06.63,0:14:09.43,Default,,0,0,0,,Профессор Морикаваға барайық. →
Dialogue: 0,0:14:09.43,0:14:11.63,Default,,0,0,0,,Мен сізге хабарластым.
Dialogue: 0,0:14:14.27,0:14:19.94,Default,,0,0,0,,Харунобу мырза, шаршадыңыз ба? Сондай-ақ, бүйрек қызметі төмендеуі мүмкін.
Dialogue: 0,0:14:19.94,0:14:23.45,Default,,0,0,0,,Кешіріңіз. өте өкінішті.
Dialogue: 0,0:14:23.45,0:14:27.95,Default,,0,0,0,,Мен жоқта сенің де бөртпе жедің емес пе?
Dialogue: 0,0:14:27.95,0:14:30.22,Default,,0,0,0,,Кешіріңіз, Ханаока...
Dialogue: 0,0:14:30.22,0:14:32.69,Default,,0,0,0,,Бұл жақсы. Мен түссіндім.
Dialogue: 0,0:14:32.69,0:14:36.09,Default,,0,0,0,,Тек аурухана тамағын жеу стрессті тудыруы мүмкін.
Dialogue: 0,0:14:36.09,0:14:39.10,Default,,0,0,0,,Бұл менің бала кезімнен... →
Dialogue: 0,0:14:39.10,0:14:43.83,Default,,0,0,0,,Ханаока әрқашан оның қаншалықты ауыр екенін көрді. →
Dialogue: 0,0:14:43.83,0:14:46.87,Default,,0,0,0,,Жарайды. Ханаока қосылды. →
Dialogue: 0,0:14:46.87,0:14:50.94,Default,,0,0,0,,Асықпа, мүмкіндігінше қалыпқа оралайық. →
Dialogue: 0,0:14:50.94,0:14:55.78,Default,,0,0,0,,Кирияма мырза... Ойын қалай өтті?
Dialogue: 0,0:14:55.78,0:14:59.98,Default,,0,0,0,,Мен жеңілдім... Мен күшті болдым...
Dialogue: 0,0:14:59.98,0:15:03.42,Default,,0,0,0,,Оның соншалықты күшті болғанына сене алар емеспін...
Dialogue: 0,0:15:03.42,0:15:05.69,Default,,0,0,0,,Бірақ→
Dialogue: 0,0:15:05.69,0:15:08.59,Default,,0,0,0,,Келесі жолы міндетті түрде жеңілмеймін.
Dialogue: 0,0:15:08.59,0:15:11.20,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:15:11.20,0:15:14.90,Default,,0,0,0,,Әрине. Харунобу мырза.
Dialogue: 0,0:15:28.61,0:15:34.81,Default,,0,0,0,,<Никаидомен ойыннан кейін мен уәде бойынша барлығының үйіне қарай бет алдым>
Dialogue: 0,0:15:37.32,0:15:43.09,Default,,0,0,0,,Ойын аяқталғаннан кейін оралыңыз. Бұл Окурибон. Мен той жасаймын.
Dialogue: 0,0:15:43.09,0:15:52.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:52.54,0:15:54.94,Default,,0,0,0,,Қайырлы кеш. Бұл Кирияма.
Dialogue: 0,0:15:57.04,0:15:59.71,Default,,0,0,0,,Кеш болды. жақсы жұмыс.
Dialogue: 0,0:15:59.71,0:16:02.61,Default,,0,0,0,,Сіз қарныңыз ашты. Кіріңіз.
Dialogue: 0,0:16:02.61,0:16:04.58,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:16:04.58,0:16:09.08,Default,,0,0,0,,Қарашы, Момо. Рей Чан осында. Бұл... бұл пудинг.
Dialogue: 0,0:16:12.89,0:16:14.83,Default,,0,0,0,,Sa! ! Мінеки.
Dialogue: 0,0:16:14.83,0:16:17.66,Default,,0,0,0,,Кирияма-кундікі баяу болғандықтан, бөлек қойдым☆
Dialogue: 0,0:16:17.66,0:16:19.60,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:16:19.60,0:16:23.50,Default,,0,0,0,,Кирияма-кун жеңіл тамақтанатын болғандықтан, мен оған аз-аздан қызмет етіп, бір жаққа қойдым☆
Dialogue: 0,0:16:23.50,0:16:27.37,Default,,0,0,0,,＜Дәмді көрінеді... бірақ мен оны аяқтай аламын ба деп ойлаймын...＞
Dialogue: 0,0:16:27.37,0:16:30.64,Default,,0,0,0,,Бұл әже мен анаға арналған.
Dialogue: 0,0:16:30.64,0:16:33.88,Default,,0,0,0,,Мен оны шабдалы ойын жинағында ұсынуға тырыстым.
Dialogue: 0,0:16:33.88,0:16:36.78,Default,,0,0,0,,Солай ма? Нани? Бір тістесе, бір тістесе.... О... өте кішкентай...
Dialogue: 0,0:16:36.78,0:16:41.59,Default,,0,0,0,,Gar: Күтілгендей, екі сыра қазірдің өзінде тым көп.
Dialogue: 0,0:16:41.59,0:16:46.42,Default,,0,0,0,,Уккорашотто…. Апыр-ай!
Dialogue: 0,0:16:46.42,0:16:50.69,Default,,0,0,0,,Ата, ұйықтамаңыз. Мен жақында отты жағуым керек...
Dialogue: 0,0:16:50.69,0:16:53.16,Default,,0,0,0,,Хмм….
Dialogue: 0,0:16:53.16,0:16:57.00,Default,,0,0,0,,Аа, 9-дан асып кетті... Дұрыс.
Dialogue: 0,0:16:57.00,0:17:01.84,Default,,0,0,0,,Кешігіп қалсақ, ханымдарға үйге бару қиын болады...
Dialogue: 0,0:17:01.84,0:17:04.54,Default,,0,0,0,,Өткен күні кешке от жағып едім...
Dialogue: 0,0:17:04.54,0:17:07.98,Default,,0,0,0,,Иә. Басқа күні Обон болды.
Dialogue: 0,0:17:07.98,0:17:12.45,Default,,0,0,0,,Біреумен амандасу кезінде «Тез кел» және «Бәрі күтіп тұр»→
Dialogue: 0,0:17:12.45,0:17:15.85,Default,,0,0,0,,Күн батқанда жарықтандырыңыз.
Dialogue: 0,0:17:15.85,0:17:20.59,Default,,0,0,0,,Біреуді жіберген кезде «Мен олардың мүмкіндігінше ұзақ болғанын қалаймын»→
Dialogue: 0,0:17:20.59,0:17:24.40,Default,,0,0,0,,Кешкі астан кейін от жағыңыз.
Dialogue: 0,0:17:24.40,0:17:29.57,Default,,0,0,0,,Жарайды, қияр ат, келгеніңде тез келші деймін.
Dialogue: 0,0:17:29.57,0:17:34.41,Default,,0,0,0,,Үйге бара жатып, үйге баяу және қауіпсіз бара алу үшін көптеген сувенирлер әкеліңіз→
Dialogue: 0,0:17:34.41,0:17:37.91,Default,,0,0,0,,Баклажаннан жасалған сиырға мінсін...
Dialogue: 0,0:17:39.78,0:17:43.25,Default,,0,0,0,,Ал, енді сендерді шығарып салайық.
Dialogue: 0,0:17:43.25,0:18:03.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:03.27,0:18:07.64,Default,,0,0,0,,＜Бәрі кәдімгідей күліп тұр→
Dialogue: 0,0:18:07.64,0:18:12.98,Default,,0,0,0,,Әйтеуір, ол әлдеқандай немқұрайлы, көңілсіз көрінді... →
Dialogue: 0,0:18:12.98,0:18:18.62,Default,,0,0,0,,Жылқы мен сиырды осылай дайындап, ас беру →
Dialogue: 0,0:18:18.62,0:18:23.85,Default,,0,0,0,,Бізді қазір жоқтардың келу және кету уақыты алаңдатады...>
Dialogue: 0,0:18:23.85,0:18:32.06,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:32.06,0:18:36.67,Default,,0,0,0,,＜Мен үшін бұл мені қынжылтады, себебі көбірек есте сақтау керек →
Dialogue: 0,0:18:36.67,0:18:40.14,Default,,0,0,0,,Мұңды ырым сияқты көрінді...>
Dialogue: 0,0:18:40.14,0:18:55.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:55.35,0:18:58.69,Default,,0,0,0,,Ал... қазір менің үйіме кірейік.
Dialogue: 0,0:18:58.69,0:19:01.49,Default,,0,0,0,,Момо да шомылып, ұйықтау керек пе?
Dialogue: 0,0:19:07.33,0:19:11.84,Default,,0,0,0,,Мен дүкенге біраз уақыт барамын...
Dialogue: 0,0:19:11.84,0:19:15.81,Default,,0,0,0,,Балапандар? Қазір бастайсыз ба? Не сатып алу керек?
Dialogue: 0,0:19:15.81,0:19:20.98,Default,,0,0,0,,Ал, манга. Жаңа кітап шыққанын ұмытып кетіппін.
Dialogue: 0,0:19:20.98,0:19:24.85,Default,,0,0,0,,Бозе, менің артымнан жүр. сурет….
Dialogue: 0,0:19:24.85,0:19:27.85,Default,,0,0,0,,Жарайды, асығыңыз! Иә.
Dialogue: 0,0:19:30.95,0:19:47.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:47.27,0:19:49.71,Default,,0,0,0,,<Сен жылдамсың...>
Dialogue: 0,0:19:49.71,0:20:00.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:00.35,0:20:03.92,Default,,0,0,0,,<Қайда бара жатырсың? Бұл ыңғайлы дүкен...>
Dialogue: 0,0:20:03.92,0:20:20.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:20.20,0:20:22.20,Default,,0,0,0,,Хина….
Dialogue: 0,0:20:26.01,0:20:28.31,Default,,0,0,0,,Онда...
Dialogue: 0,0:20:43.33,0:20:47.93,Default,,0,0,0,,Ана... Ана...
Dialogue: 0,0:20:47.93,0:20:51.84,Default,,0,0,0,,Ана….
Dialogue: 0,0:20:51.84,0:20:55.34,Default,,0,0,0,,Ана….
Dialogue: 0,0:20:55.34,0:20:58.58,Default,,0,0,0,,Ух... ааан....
Dialogue: 0,0:20:58.58,0:21:04.38,Default,,0,0,0,,<Тыңдалмады. Бұл жүректі елжірететін дауыс еді...>
Dialogue: 0,0:21:09.22,0:21:15.59,Default,,0,0,0,,<Оның бәрінің көзінше ұстағанына сенімдімін...>
Dialogue: 0,0:21:15.59,0:21:22.79,Default,,0,0,0,,(Хинатаның айқайы)
Dialogue: 0,0:21:31.07,0:21:33.37,Default,,0,0,0,,Кирияма-кун….
Dialogue: 0,0:21:35.75,0:21:41.08,Default,,0,0,0,,Кешіріңіз... Мен бірден қайтамын.
Dialogue: 0,0:21:41.08,0:21:44.42,Default,,0,0,0,,<Оның жылаған даусын тыңдап отырғанымда→
Dialogue: 0,0:21:44.42,0:21:49.93,Default,,0,0,0,,Құлыптаған сұрақтарым жүрегіме сия сіңіп кете бастады.
Dialogue: 0,0:21:49.93,0:21:53.80,Default,,0,0,0,,Жарайды, жарайды... Ха...
Dialogue: 0,0:21:53.80,0:22:01.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:01.31,0:22:03.77,Default,,0,0,0,,Осында тағы біраз тұрайық...
Dialogue: 0,0:22:03.77,0:22:05.84,Default,,0,0,0,,Фуфу… Фуэ….
Dialogue: 0,0:22:05.84,0:22:09.08,Default,,0,0,0,,Уф, у...
Dialogue: 0,0:22:09.08,0:22:12.38,Default,,0,0,0,,＜Мен →
Dialogue: 0,0:22:12.38,0:22:17.62,Default,,0,0,0,,Менің нағыз отбасым әлдеқашан жоғалып кетті. →
Dialogue: 0,0:22:17.62,0:22:20.52,Default,,0,0,0,,Жылаудан пайда жоқ, сондықтан бас тартыңыз →
Dialogue: 0,0:22:20.52,0:22:23.43,Default,,0,0,0,,Мен мұңайып тұрмын, ол туралы ойламауға тырыс→
Dialogue: 0,0:22:23.43,0:22:30.10,Default,,0,0,0,,Басыңды шығар, шығар, шығар...→
Dialogue: 0,0:22:30.10,0:22:34.84,Default,,0,0,0,,Бірақ...→
Dialogue: 0,0:22:34.84,0:22:38.51,Default,,0,0,0,,Бұл шынымен жақсы нәрсе болды ма...＞
Dialogue: 0,0:22:38.51,0:22:48.09,Default,,0,0,0,,(Хинатаның айқайы)
Dialogue: 0,0:22:48.09,0:22:54.49,Default,,0,0,0,,<Жылаған қыз бен жыламайтын мен...→
Dialogue: 0,0:22:54.49,0:22:58.76,Default,,0,0,0,,Әдеміге қарап тұрған екі адам →
Dialogue: 0,0:22:58.76,0:23:03.86,Default,,0,0,0,,Шілденің әдемі түнгі аспаны...>
Dialogue: 0,0:23:09.04,0:23:14.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:14.01,0:23:18.32,Default,,0,0,0,,♪♪ «Ол дауыс жұлдыздай жарқырайды».
Dialogue: 0,0:23:18.32,0:23:23.65,Default,,0,0,0,,♪♪ «Бірінен соң бірі құлағыма секіріп, жарқырайды».
Dialogue: 0,0:23:23.65,0:23:27.86,Default,,0,0,0,,♪♪ «Балық сияқты жинай баста».
Dialogue: 0,0:23:27.86,0:23:32.70,Default,,0,0,0,,♪♪ «Суық кеудемде күн сәулесі пайда болды».
Dialogue: 0,0:23:32.70,0:23:36.90,Default,,0,0,0,,♪♪ «Себебі мен қалыпты түртуді білмеймін».
Dialogue: 0,0:23:36.90,0:23:42.24,Default,,0,0,0,,♪♪ «Мен абдырап қалғанда, маған тиген қол»
Dialogue: 0,0:23:42.24,0:23:46.48,Default,,0,0,0,,♪♪ «Түнде қанша өтсең де»
Dialogue: 0,0:23:46.48,0:23:52.22,Default,,0,0,0,,♪♪ «Ешқашан суымайтын қызба жүрегімді дүрсілдеп тұр».
Dialogue: 0,0:23:52.22,0:23:55.99,Default,,0,0,0,,♪♪ «Сенің болғаның жеткілікті».
Dialogue: 0,0:23:55.99,0:24:01.73,Default,,0,0,0,,♪♪ «Бүкіл өмір жарқырайды»
Dialogue: 0,0:24:01.73,0:24:05.43,Default,,0,0,0,,♪♪ «Мұздаған жүрекке»
Dialogue: 0,0:24:05.43,0:24:12.00,Default,,0,0,0,,♪♪ «Жүректің соғуы жаңғырық етіп, отты жағады».
Dialogue: 0,0:24:12.00,0:24:16.71,Default,,0,0,0,,♪♪ «Көп кеткен соң»
Dialogue: 0,0:24:16.71,0:24:21.55,Default,,0,0,0,,♪♪ «Мен күшті болдым, бір нәрсе қалды».
Dialogue: 0,0:24:21.55,0:24:26.35,Default,,0,0,0,,♪♪ «Мен сені тастамаймын, мен әрқашан сенің жаныңда боламын»
Dialogue: 0,0:24:26.35,0:24:33.75,Default,,0,0,0,,♪♪ «Маған ең жақын»
Dialogue: 0,0:24:59.82,0:25:02.72,Default,,0,0,0,,«Наурыз арыстандай келеді» Келесі бөлімді күтіңіз.
Dialogue: 0,0:25:02.72,0:25:06.02,Default,,0,0,0,,Бәріміз менімен шоги үйренейік!
