Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.84,0:00:19.75,OP,,0,0,0,,Сиқырлы заклинание есімде
Dialogue: 0,0:00:19.75,0:00:23.11,OP,,0,0,0,,Артынан кемпірқосақ аспанға созылғанда
Dialogue: 0,0:00:23.11,0:00:27.03,OP,,0,0,0,,Әп-сәтте әлемнің әр түкпірінде
Dialogue: 0,0:00:27.03,0:00:30.56,OP,,0,0,0,,Жарқын реңкке ие болды
Dialogue: 0,0:00:30.56,0:00:34.18,OP,,0,0,0,,Жүрегімнің үні
Dialogue: 0,0:00:34.18,0:00:37.69,OP,,0,0,0,,Әрқашан менің жүруім керек жолды жарықтандырады
Dialogue: 0,0:00:37.69,0:00:41.59,OP,,0,0,0,,Себебі мен бәріне күмәнданамын
Dialogue: 0,0:00:41.59,0:00:45.36,OP,,0,0,0,,Мен мұның рас екенін білемін
Dialogue: 0,0:00:45.36,0:00:49.07,OP,,0,0,0,,Менің жүрегім неге соғады?
Dialogue: 0,0:00:49.07,0:00:52.70,OP,,0,0,0,,Неліктен менің өкпем әлі де тыныс алады?
Dialogue: 0,0:00:52.70,0:00:56.33,OP,,0,0,0,,Неліктен кеудем құмарлықтан өртенеді?
Dialogue: 0,0:00:56.33,0:00:59.56,OP,,0,0,0,,Мұның бәрінің себебі бар
Dialogue: 0,0:00:59.92,0:01:03.05,OP,,0,0,0,,Және бұлттардың артына тығылған жұлдызды аспан сияқты
Dialogue: 0,0:01:03.33,0:01:05.71,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.71,0:01:05.83,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.83,0:01:05.96,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:05.96,0:01:06.08,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:06.08,0:01:06.22,OP,,0,0,0,,Мен бір жерде жоғалтқан баратын жерге билет сияқты
Dialogue: 0,0:01:06.95,0:01:10.36,OP,,0,0,0,,Мен дүниеге келгенге дейінгі дүние тарихы сияқты
Dialogue: 0,0:01:10.78,0:01:14.36,OP,,0,0,0,,Сіз жауапты менің қолымнан келмейді
Dialogue: 0,0:01:14.47,0:01:20.99,OP,,0,0,0,,Басқа ештеңе болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:21.87,0:01:28.57,OP,,0,0,0,,Басқа ешкім болмаса, мен мұны өте жақсы білемін
Dialogue: 0,0:01:32.45,0:01:35.50,titles,,0,0,0,,Алыстағы найзағай (2-бөлім)
Dialogue: 0,0:01:52.17,0:01:53.88,Default-ja,,0,0,0,,Ауыр сезіледі, солай ма?
Dialogue: 5,0:01:52.20,0:01:53.56,Default,,0,0,0,,Бұл төмендеткіш емес пе?
Dialogue: 5,0:02:02.63,0:02:06.40,Default,,0,0,0,,Кәрі, кәрі итті тұншықтырып өлтіруге бара жатқандайсың.
Dialogue: 0,0:02:02.64,0:02:06.31,Default-ja,,0,0,0,,Кәрі итті тұншықтырып өлтірмек сияқты.
Dialogue: 5,0:02:11.55,0:02:13.87,Default,,0,0,0,,Бұл сізді алаңдатады.
Dialogue: 0,0:02:11.60,0:02:14.07,Default-ja,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 5,0:02:14.57,0:02:20.14,Default,,0,0,0,,Мен осындай жағдайда сіріңке лақтыратын түрің бар шығар деп ойладым.
Dialogue: 0,0:02:14.57,0:02:16.44,Default-ja,,0,0,0,,Сен қашан осындайсың?
Dialogue: 0,0:02:16.53,0:02:18.82,Default-ja,,0,0,0,,Ол сені әдейі жоғалтады ма деп қорқамын...
Dialogue: 0,0:02:18.90,0:02:20.07,Default-ja,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 5,0:02:21.13,0:02:24.88,Default,,0,0,0,,Сіз сондай жақсы жігіт екеніңізді көріп тұрмын.
Dialogue: 0,0:02:21.20,0:02:25.12,Default-ja,,0,0,0,,Өйткені сен өте мейірімдісің.
Dialogue: 5,0:02:37.83,0:02:39.29,Default,,0,0,0,,Мацунага Шоуичи.
Dialogue: 0,0:02:37.84,0:02:41.76,Default-ja,,0,0,0,,Шоичи Мацунага 7-ші Дан 65 жаста
Dialogue: 5,0:02:39.29,0:02:40.42,Default,,0,0,0,,7-дан.
Dialogue: 5,0:02:40.42,0:02:41.79,Default,,0,0,0,,Алпыс бес жаста.
Dialogue: 5,0:02:41.79,0:02:43.42,Default,,0,0,0,,Фукусима префектурасынан.
Dialogue: 0,0:02:41.84,0:02:43.26,Default-ja,,0,0,0,,Фукусима префектурасында туған
Dialogue: 5,0:02:43.42,0:02:45.48,Default,,0,0,0,,Ол 25 жасында кәсіпқой болды.
Dialogue: 0,0:02:43.47,0:02:45.43,Default-ja,,0,0,0,,25 жаста кәсіби шоги ойыншысы болыңыз
Dialogue: 5,0:02:46.10,0:02:47.57,Default,,0,0,0,,Оның қырық жылдық тәжірибесі бар.
Dialogue: 0,0:02:46.14,0:02:47.52,Default-ja,,0,0,0,,Шоги ойыншысы ретінде 40 жылдық тәжірибесі
Dialogue: 0,0:02:48.31,0:02:51.23,Default-ja,,0,0,0,,1 тоқсандағы ең жоғары В1 бағасы
Dialogue: 5,0:02:48.35,0:02:51.11,Default,,0,0,0,,Ең жақсы жағдайда ол бір маусымда В1 сыныбында болды.
Dialogue: 5,0:02:57.98,0:03:00.87,Default,,0,0,0,,Мен оны шоги залында талай рет байқадым.
Dialogue: 0,0:02:57.98,0:03:00.86,Default-ja,,0,0,0,,Мен сізді залда бірнеше рет көрдім.
Dialogue: 0,0:03:03.57,0:03:06.66,Default-ja,,0,0,0,,Кішкентай, артына қарап жылдам жүрді.
Dialogue: 5,0:03:03.59,0:03:06.84,Default,,0,0,0,,Бойы аласа кісінің арқасын көрдім, ылғи жылдам жүретін.
Dialogue: 0,0:03:08.01,0:03:09.63,signs,,0,0,0,,Сендагая станциясы
Dialogue: 1,0:03:08.01,0:03:09.63,signs,,0,0,0,,Сендагая станциясы
Dialogue: 5,0:03:14.07,0:03:17.17,Default,,0,0,0,,Осы бір көріністі қырық жыл бойы көрген...
Dialogue: 0,0:03:14.08,0:03:17.09,Default-ja,,0,0,0,,Бұл пейзаж 40 жыл бойы...
Dialogue: 5,0:03:19.18,0:03:20.72,Default,,0,0,0,,«Қырық жыл».
Dialogue: 0,0:03:19.21,0:03:20.26,Default-ja,,0,0,0,,40 жыл…
Dialogue: 5,0:03:20.72,0:03:25.23,Default,,0,0,0,,Мен оны дауыстап айттым, бірақ мен оны елестете алмадым.
Dialogue: 0,0:03:20.80,0:03:24.72,Default-ja,,0,0,0,,Мен оны дауыстап айтуға тырыстым, бірақ мен оны елестете алмадым.
Dialogue: 5,0:03:25.23,0:03:28.28,Default,,0,0,0,,Бұл менің тірі болғанымнан екі есе көп.
Dialogue: 0,0:03:25.39,0:03:27.97,Default-ja,,0,0,0,,Менің өмірімнен екі есе көп жыл
Dialogue: 5,0:03:28.28,0:03:32.94,Default,,0,0,0,,Бұл 81 шаршы тақтада ол қайта-қайта өмір сүрді және қайтыс болды.
Dialogue: 0,0:03:28.35,0:03:32.89,Default-ja,,0,0,0,,Осы 81 шаршы тақтада бірнеше рет өмір сүрген және қайтыс болған адам.
Dialogue: 0,0:03:38.23,0:03:39.78,Default-ja,,0,0,0,,Мацунага мырза
Dialogue: 5,0:03:38.26,0:03:40.04,Default,,0,0,0,,Мацунага...
Dialogue: 0,0:03:40.44,0:03:44.57,Default-ja,,0,0,0,,Мацунага-сан, егер сіз C2 деңгейіне төмендетсеңіз, зейнетке шығасыз.
Dialogue: 5,0:03:40.49,0:03:45.04,Default,,0,0,0,,Мацунага C2 деңгейіне төмендетілген болса, ол зейнетке шығады деп естідім.
Dialogue: 0,0:03:45.53,0:03:46.57,Default-ja,,0,0,0,,40 жыл
Dialogue: 5,0:03:45.54,0:03:46.78,Default,,0,0,0,,Қырық жыл...
Dialogue: 5,0:03:47.47,0:03:49.78,Default,,0,0,0,,Ақылға қонымды уақыт аралығы.
Dialogue: 0,0:03:47.49,0:03:49.70,Default-ja,,0,0,0,,Ақылға сыймайтын жылдар
Dialogue: 5,0:03:51.00,0:03:53.30,Default,,0,0,0,,Мен оның қазір өзін қалай сезінетініне таңғаламын.
Dialogue: 0,0:03:51.04,0:03:52.91,Default-ja,,0,0,0,,Қазір өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:54.33,0:03:56.71,Default-ja,,0,0,0,,Мен оны елестете де алмаймын...
Dialogue: 5,0:03:54.35,0:03:56.55,Default,,0,0,0,,Мен елестете алмаймын.
Dialogue: 5,0:03:58.00,0:04:00.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:58.04,0:03:59.84,Default-ja,,0,0,0,,Жоқ.
Dialogue: 0,0:04:00.51,0:04:01.59,Default-ja,,0,0,0,,Хаа
Dialogue: 5,0:04:02.81,0:04:06.44,Default,,0,0,0,,Шынымды айтсам, құдай, үйге барғым келеді.
Dialogue: 0,0:04:03.09,0:04:06.59,Default-ja,,0,0,0,,Құдай-ау, шынымды айтсам, мен жай ғана үйге барғым келетін сияқтымын.
Dialogue: 0,0:04:06.68,0:04:09.51,Default-ja,,0,0,0,,Ах, бірақ өтінемін, маған жеңуге рұқсат етіңіз.
Dialogue: 5,0:04:06.73,0:04:09.44,Default,,0,0,0,,Бірақ маған қандай да бір жолмен жеңуге рұқсат етіңіз!
Dialogue: 5,0:04:09.81,0:04:11.70,Default,,0,0,0,,Қол соғу, шапалақтау. Және т.б.
Dialogue: 0,0:04:09.81,0:04:11.52,Default-ja,,0,0,0,,Нан панттоны
Dialogue: 5,0:04:11.70,0:04:12.61,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:04:12.56,0:04:14.19,Default-ja,,0,0,0,,Сіз осылай сезінесіз бе?
Dialogue: 5,0:04:12.61,0:04:14.07,Default,,0,0,0,,Өзі де солай ма?!
