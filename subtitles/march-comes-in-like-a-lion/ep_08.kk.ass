Dialogue: 0,0:18:17.35,0:18:19.31,Default-ja,,0,0,0,,Ой, рұқсатсыз ашпа.
Dialogue: 0,0:18:17.37,0:18:17.42,signs,,0,0,0,,Fwoop
Dialogue: 1,0:18:17.37,0:18:17.42,signs,,0,0,0,,Fwoop
Dialogue: 5,0:18:17.42,0:18:19.17,Default,,0,0,0,,Бір нәрсені ашуға бармаңыз!
Dialogue: 5,0:18:19.17,0:18:21.07,Default,,0,0,0,,Әй, не деген жырау.
Dialogue: 0,0:18:19.40,0:18:20.77,Default-ja,,0,0,0,,Ах-ра сыпайы
Dialogue: 5,0:18:21.07,0:18:23.17,Default,,0,0,0,,Бұл әдемі мамық матрац!
Dialogue: 0,0:18:21.11,0:18:23.48,Default-ja,,0,0,0,,Әй, бұл әдемі көрпе емес пе?
Dialogue: 5,0:18:23.54,0:18:26.55,Default,,0,0,0,,Бұл қоныс тойына сыйлық болды.
Dialogue: 0,0:18:23.57,0:18:26.45,Default-ja,,0,0,0,,Мен оны қоныс тойына сыйлық ретінде алдым.
Dialogue: 5,0:18:29.05,0:18:32.09,Default,,0,0,0,,Сіз оны жаңа ғана алған болуыңыз керек.
Dialogue: 0,0:18:29.28,0:18:31.62,Default-ja,,0,0,0,,Сіз оны шынымен де алдыңыз ба?
Dialogue: 5,0:18:32.09,0:18:34.24,Default,,0,0,0,,Әлі саған ұқсайтын иіс жоқ.
Dialogue: 0,0:18:32.16,0:18:34.16,Default-ja,,0,0,0,,Мен сенің иісіңді әлі сезе алмаймын.
Dialogue: 0,0:18:42.34,0:18:44.92,Default-ja,,0,0,0,,Ей, қандай тамаша көрініс.
Dialogue: 5,0:18:42.36,0:18:45.29,Default,,0,0,0,,Уау, бұл біраз көрініс.
Dialogue: 5,0:18:45.29,0:18:47.22,Default,,0,0,0,,Бұл шынымен алтыншы қабат па?
Dialogue: 0,0:18:45.34,0:18:46.92,Default-ja,,0,0,0,,Бұл шынымен 6-қабат па?
Dialogue: 5,0:18:47.22,0:18:48.64,Default,,0,0,0,,Бұл жоғарырақ көрінеді.
Dialogue: 0,0:18:47.26,0:18:48.55,Default-ja,,0,0,0,,Қымбат көрінеді
Dialogue: 0,0:18:48.63,0:18:50.09,Default-ja,,0,0,0,,Өзен деңгейі төмен болғандықтан ба?
Dialogue: 5,0:18:48.64,0:18:49.95,Default,,0,0,0,,Өзен өте төмен болғандықтан ба?
Dialogue: 5,0:18:52.34,0:18:55.58,Default,,0,0,0,,Міне, сіз өмір сүрген жер.
Dialogue: 0,0:18:52.35,0:18:53.26,Default-ja,,0,0,0,,Сонымен...
Dialogue: 0,0:18:53.56,0:18:55.43,Default-ja,,0,0,0,,Мен осындай жерде тұрдым
Dialogue: 0,0:18:57.43,0:19:00.19,Default-ja,,0,0,0,,Жалғыз ізде, жалғыз шеш
Dialogue: 5,0:18:57.45,0:19:00.08,Default,,0,0,0,,Өзің іздедің, өзің шештің...
Dialogue: 5,0:19:00.63,0:19:03.09,Default,,0,0,0,,Сіз шынымен өзімшілсіз, солай емес пе?
Dialogue: 0,0:19:00.65,0:19:02.65,Default-ja,,0,0,0,,Сіз шынымен де жалғызсыз, солай емес пе?
Dialogue: 5,0:19:03.09,0:19:04.84,Default,,0,0,0,,Әкем кейін көңілсіз қалды.
Dialogue: 0,0:19:03.23,0:19:04.90,Default-ja,,0,0,0,,Әке, көңілім түсіп кетті.
Dialogue: 5,0:19:05.28,0:19:06.65,Default,,0,0,0,,Оны қалай жалға алдыңыз?
Dialogue: 0,0:19:05.28,0:19:07.74,Default-ja,,0,0,0,,Оны қалай алдыңыз? Кепілгер кім?
Dialogue: 5,0:19:06.65,0:19:08.13,Default,,0,0,0,,Сіздің кепілгеріңіз кім?
Dialogue: 5,0:19:08.13,0:19:09.84,Default,,0,0,0,,Төраға Цзингуджи.
Dialogue: 0,0:19:08.24,0:19:09.78,Default-ja,,0,0,0,,Президент Цзингуджи...
Dialogue: 5,0:19:09.84,0:19:12.00,Default,,0,0,0,,Суреттер.
Dialogue: 0,0:19:10.03,0:19:11.78,Default-ja,,0,0,0,,Ой, күткендей.
Dialogue: 5,0:19:12.00,0:19:14.10,Default,,0,0,0,,Оның сізге жұмсақ жері бар.
Dialogue: 0,0:19:12.03,0:19:14.08,Default-ja,,0,0,0,,Ол адам саған мейірімді.
Dialogue: 5,0:19:22.23,0:19:23.35,Default,,0,0,0,,Киоуко, соңғы пойыз—
Dialogue: 0,0:19:22.25,0:19:24.92,Default-ja,,0,0,0,,Коко-сан, соңғы пойыз... (Коко) Үйге барғанда...
Dialogue: 5,0:19:23.35,0:19:24.86,Default,,0,0,0,,Неге үйге қайтпайсың...
Dialogue: 5,0:19:25.34,0:19:26.61,Default,,0,0,0,,сол үйге?
Dialogue: 0,0:19:25.34,0:19:26.51,Default-ja,,0,0,0,,Сол үйде
Dialogue: 5,0:19:27.05,0:19:29.54,Default,,0,0,0,,Әке сен болсаң бақытты болар еді.
Dialogue: 0,0:19:27.05,0:19:29.55,Default-ja,,0,0,0,,Әкем осылай бақыттырақ болар еді.
Dialogue: 5,0:19:32.69,0:19:33.86,Default,,0,0,0,,Та-да!
Dialogue: 0,0:19:32.85,0:19:33.72,Default-ja,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 5,0:19:33.86,0:19:37.24,Default,,0,0,0,,Маған футболка беріңіз. Мен ұйықтап жатырмын.
Dialogue: 0,0:19:34.10,0:19:36.89,Default-ja,,0,0,0,,Маған көйлек қарызға бер, мен ұйықтап жатырмын.
Dialogue: 0,0:19:42.48,0:19:44.52,Default-ja,,0,0,0,,Сіз ұрысып қалдыңыз ба? әкеммен
Dialogue: 5,0:19:42.52,0:19:44.75,Default,,0,0,0,,Әкем екеуің ұрысып қалдыңдар ма?
Dialogue: 5,0:19:44.75,0:19:46.00,Default,,0,0,0,,Ах, бұл – өзін өзгелерден бөліп тұратын сызық екен
Dialogue: 0,0:19:44.98,0:19:46.23,Default-ja,,0,0,0,,Менде жоқ.
Dialogue: 5,0:19:46.41,0:19:48.18,Default,,0,0,0,,Мен оны көрген емеспін.
Dialogue: 0,0:19:46.44,0:19:48.11,Default-ja,,0,0,0,,Дұрысы, біз кездескен жоқпыз.
Dialogue: 5,0:19:48.18,0:19:50.01,Default,,0,0,0,,Мен соңғы уақытта үйге келмеймін.
Dialogue: 0,0:19:48.24,0:19:50.32,Default-ja,,0,0,0,,Мен соңғы уақытта үйге келмеймін.
Dialogue: 5,0:19:53.93,0:19:55.62,Default,,0,0,0,,Әлі де сол жігітпен біргесің бе?
Dialogue: 0,0:19:53.95,0:19:55.83,Default-ja,,0,0,0,,Сіз әлі де сол адаммен біргесіз бе?
Dialogue: 5,0:20:03.81,0:20:05.11,Default,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:20:03.83,0:20:04.96,Default-ja,,0,0,0,,Жақсы
Dialogue: 5,0:20:10.19,0:20:12.23,Default,,0,0,0,,Ең болмаса тыртық қалдырған жоқ.
Dialogue: 0,0:20:10.22,0:20:12.09,Default-ja,,0,0,0,,Ешқандай тыртық қалмады
Dialogue: 0,0:20:19.60,0:20:21.60,Default-ja,,0,0,0,,Өйткені Готоның есі дұрыс емес.
Dialogue: 5,0:20:19.61,0:20:21.69,Default,,0,0,0,,Готу есі дұрыс жігіт емес.
Dialogue: 0,0:20:26.69,0:20:28.23,Default-ja,,0,0,0,,Бұл адам жақсы емес.
Dialogue: 5,0:20:26.74,0:20:28.67,Default,,0,0,0,,Ол саған жаман.
Dialogue: 5,0:20:29.05,0:20:31.05,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:20:29.07,0:20:30.99,Default-ja,,0,0,0,,Бұл сенің шаруаң емес.
Dialogue: 0,0:20:31.61,0:20:33.45,Default-ja,,0,0,0,,Сіз қолыңызды көтердіңіз бе?
Dialogue: 5,0:20:31.62,0:20:33.67,Default,,0,0,0,,Ол сізге зорлық-зомбылық көрсетпейді ме?
Dialogue: 5,0:20:33.67,0:20:35.91,Default,,0,0,0,,Зорлық-зомбылық көрсету керек пе? Менімен бірге?
Dialogue: 0,0:20:33.70,0:20:34.62,Default-ja,,0,0,0,,Қол?
Dialogue: 0,0:20:34.70,0:20:35.70,Default-ja,,0,0,0,,Маған?
Dialogue: 5,0:20:35.91,0:20:37.05,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:20:35.95,0:20:37.03,Default-ja,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:37.53,0:20:39.58,Default-ja,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 5,0:20:37.56,0:20:39.81,Default,,0,0,0,,Бірақ егер ол істесе,
Dialogue: 5,0:20:39.81,0:20:42.62,Default,,0,0,0,,мен оны жай ғана қабылдаймын деп ойлайсыз ба?
Dialogue: 0,0:20:40.04,0:20:42.50,Default-ja,,0,0,0,,Мені тыныш жүргенім үшін ұрып жатыр деп ойлайсың ба?
Dialogue: 5,0:20:43.73,0:20:45.19,Default,,0,0,0,,Мен оны пышақтайтын едім...
Dialogue: 0,0:20:43.75,0:20:44.96,Default-ja,,0,0,0,,Ол шағып кетеді.
Dialogue: 5,0:20:45.19,0:20:46.74,Default,,0,0,0,,ұйқысында.
Dialogue: 0,0:20:45.42,0:20:46.75,Default-ja,,0,0,0,,Мен ұйықтайтын жер
Dialogue: 0,0:20:47.34,0:20:49.80,Default-ja,,0,0,0,,Мен енді оянатыным сонша.
Dialogue: 5,0:20:47.37,0:20:49.94,Default,,0,0,0,,Ол енді ешқашан оянбайды.
Dialogue: 5,0:20:53.99,0:20:55.07,Default,,0,0,0,,Сіз соншалықты барар ма едіңіз?
Dialogue: 0,0:20:54.01,0:20:55.22,Default-ja,,0,0,0,,Шынында да солай ма…
Dialogue: 5,0:20:57.06,0:20:58.07,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 5,0:20:59.05,0:21:00.13,Default,,0,0,0,,Мен оны жақсы көремін.
Dialogue: 0,0:20:59.06,0:21:00.18,Default-ja,,0,0,0,,Маған ұнайды
Dialogue: 0,0:21:01.27,0:21:02.85,Default-ja,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 5,0:21:01.29,0:21:02.72,Default,,0,0,0,,Мен оны шын сүйемін.
Dialogue: 0,0:21:18.20,0:21:20.08,Default-ja,,0,0,0,,Ұйықтай алмадыңыз ба?
Dialogue: 5,0:21:18.34,0:21:20.35,Default,,0,0,0,,Сіз ұйықтай алмадыңыз ба?
Dialogue: 0,0:21:21.79,0:21:23.16,Default-ja,,0,0,0,,Жаман емес
Dialogue: 5,0:21:21.83,0:21:25.48,Default,,0,0,0,,Бірақ бүгін сенің сыныбыңды шешетін матч бар, солай емес пе?
Dialogue: 0,0:21:23.25,0:21:25.87,Default-ja,,0,0,0,,Бүгін матч, солай ма?
Dialogue: 5,0:21:26.98,0:21:28.23,Default,,0,0,0,,Сіздің қарсыласыңыз кім?
Dialogue: 0,0:21:27.08,0:21:29.00,Default-ja,,0,0,0,,Екінші тарап кім?
Dialogue: 5,0:21:29.98,0:21:31.69,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:30.13,0:21:31.84,Default-ja,,0,0,0,,Иә, иә, Мацунага мырза.
Dialogue: 5,0:21:33.24,0:21:34.28,Default,,0,0,0,,Оның жасы нешеде?
Dialogue: 0,0:21:33.38,0:21:34.63,Default-ja,,0,0,0,,Жасың нешеде?
Dialogue: 5,0:21:35.95,0:21:38.49,Default,,0,0,0,,Алпыс төрт? Алпыс бес? Соған ұқсас нәрсе.
Dialogue: 0,0:21:36.09,0:21:38.43,Default-ja,,0,0,0,,64? 65?
Dialogue: 5,0:21:38.49,0:21:40.45,Default,,0,0,0,,Қандай күрескер.
Dialogue: 0,0:21:38.51,0:21:40.60,Default-ja,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, солай ма?
Dialogue: 5,0:21:40.85,0:21:46.96,Default,,0,0,0,,Ол тіпті C1-ге түскеннен кейін де бос сыныпқа көшпейді және оны қатты ұстай береді, менің ойымша, сіз айта аласыз.
Dialogue: 0,0:21:40.89,0:21:44.27,Default-ja,,0,0,0,,С1-ге түсіп қалсаңыз да, бос сыныпқа көшпей, табандылық таныта беріңіз.
Dialogue: 0,0:21:44.35,0:21:46.73,Default-ja,,0,0,0,,Сіз шарасыз көзқарасты айтасыз ба?
Dialogue: 5,0:21:46.96,0:21:49.71,Default,,0,0,0,,Мен оның әкеммен ойнағанын бір рет көрдім.
Dialogue: 0,0:21:47.10,0:21:49.44,Default-ja,,0,0,0,,«Әке» дегеніңізді бұрын да көргенмін.
Dialogue: 0,0:21:49.69,0:21:51.86,Default-ja,,0,0,0,,Жабысқақ шоги
Dialogue: 5,0:21:49.71,0:21:51.88,Default,,0,0,0,,Қымбатты өмірді ұстағандай болды.
Dialogue: 5,0:21:51.88,0:21:53.71,Default,,0,0,0,,Бұл көңілсіз болды.
Dialogue: 0,0:21:51.94,0:21:53.53,Default-ja,,0,0,0,,Бұл тітіркендіргіш болды
Dialogue: 5,0:21:54.36,0:21:59.97,Default,,0,0,0,,Осының бәрін тастап кетпесе, ол шогиді шынымен жақсы көруі керек, білесіз бе?
Dialogue: 0,0:21:54.40,0:21:56.82,Default-ja,,0,0,0,,Олай болса да, мен кете алмаймын
Dialogue: 0,0:21:56.91,0:21:59.53,Default-ja,,0,0,0,,Сіз шогиді шынымен жақсы көретініңізге сенімдімін.
Dialogue: 5,0:22:00.33,0:22:02.11,Default,,0,0,0,,Сізге ұқсамайды.
Dialogue: 0,0:22:00.33,0:22:02.62,Default-ja,,0,0,0,,Сізге ұқсамайды
Dialogue: 5,0:22:04.99,0:22:06.48,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:22:05.00,0:22:06.17,Default-ja,,0,0,0,,Иә иә
Dialogue: 5,0:22:06.48,0:22:10.73,Default,,0,0,0,,Мацунага C1 деңгейінен төмендетсе, ол зейнетке шығады деп естідім.
Dialogue: 0,0:22:06.54,0:22:10.75,Default-ja,,0,0,0,,Мацунага мырза, ол C1 деңгейінен төмендетілгеннен кейін зейнетке шығатын сияқты.
Dialogue: 5,0:22:11.36,0:22:13.01,Default,,0,0,0,,Бұл төмендеткіш емес пе?
Dialogue: 0,0:22:11.59,0:22:12.96,Default-ja,,0,0,0,,Ауыр сезіледі, солай ма?
Dialogue: 5,0:22:13.01,0:22:17.24,Default,,0,0,0,,Кәрі, кәрі итті тұншықтырып өлтіруге бара жатқандайсың.
Dialogue: 0,0:22:13.05,0:22:16.80,Default-ja,,0,0,0,,Ұзақ өмір сүрген кәрі итті буындырып өлтіргендей.
Dialogue: 5,0:22:17.24,0:22:18.49,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:22:17.51,0:22:19.14,Default-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:19.22,0:22:22.01,Default-ja,,0,0,0,,Мұндай рөлді ешкім ойнағысы келмейді.
Dialogue: 5,0:22:19.23,0:22:22.24,Default,,0,0,0,,Ешкім тапсырманы орындағысы келмейді.
Dialogue: 5,0:22:22.85,0:22:25.28,Default,,0,0,0,,Бұл сізді алаңдатады.
Dialogue: 0,0:22:22.85,0:22:25.18,Default-ja,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 5,0:22:25.28,0:22:30.00,Default,,0,0,0,,Мен осындай жағдайда сіріңке лақтыратын түрің бар шығар деп ойладым.
Dialogue: 0,0:22:25.35,0:22:26.56,Default-ja,,0,0,0,,Сен қашан осындайсың?
Dialogue: 0,0:22:26.64,0:22:28.77,Default-ja,,0,0,0,,Ол сені әдейі жоғалтады ма деп қорқамын...
Dialogue: 0,0:22:28.85,0:22:30.15,Default-ja,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 5,0:22:30.58,0:22:33.47,Default,,0,0,0,,Сіз сондай жақсы жігіт екеніңізді көріп тұрмын.
Dialogue: 0,0:22:30.61,0:22:33.28,Default-ja,,0,0,0,,Қарашы, сен мейірімдісің.
Dialogue: 5,0:22:42.50,0:22:47.34,Default,,0,0,0,,Ол кетіп бара жатқанда, оның шашына күн сәулесі түсіп, оны бір сәт нұрландырды.
Dialogue: 0,0:22:42.53,0:22:44.50,Default-ja,,0,0,0,,Оның шашы кетіп бара жатыр...
Dialogue: 0,0:22:44.83,0:22:47.29,Default-ja,,0,0,0,,Күн нұрын шашып, бір сәт күңгірттенді.
Dialogue: 5,0:22:49.17,0:22:55.67,Default,,0,0,0,,Сол жарық ақыры қатты жаңбырға әкелді.
Dialogue: 0,0:22:49.17,0:22:50.25,Default-ja,,0,0,0,,Және…
Dialogue: 0,0:22:51.04,0:22:53.05,Default-ja,,0,0,0,,Жарық жақында жанады
Dialogue: 0,0:22:53.21,0:22:55.76,Default-ja,,0,0,0,,Қатты жаңбыр жауады.
Dialogue: 0,0:22:58.03,0:23:01.03,titles,,0,0,0,,Алыстағы найзағай (1-бөлім)
Dialogue: 1,0:23:06.19,0:23:10.33,ED,,0,0,0,,Жарқыраған метеориттік жауын сияқты
Dialogue: 0,0:23:10.59,0:23:15.38,ED,,0,0,0,,Сөздерің құлағыма кіріп оттайды
Dialogue: 0,0:23:15.88,0:23:20.01,ED,,0,0,0,,Олар балық үйірмесі сияқты жиналады
Dialogue: 0,0:23:20.01,0:23:24.22,ED,,0,0,0,,Бір кезде салқындаған кеудемде жылы бұрыш жасаңыз
Dialogue: 0,0:23:24.89,0:23:29.69,ED,,0,0,0,,Қол созудың дұрыс жолын білмей орнымда тұрғанымда
Dialogue: 0,0:23:29.69,0:23:31.56,ED,,0,0,0,,Қол созудың дұрыс жолын білмей орнымда тұрғанымда
Dialogue: 0,0:23:31.56,0:23:34.07,ED,,0,0,0,,Сенің қолың менің қолыма тигізді
Dialogue: 0,0:23:34.61,0:23:38.57,ED,,0,0,0,,Қанша түн өтсе де
Dialogue: 0,0:23:38.57,0:23:39.28,ED,,0,0,0,,Сол жылу әлі күнге дейін іштей соғып тұрады
Dialogue: 0,0:23:39.28,0:23:40.49,ED,,0,0,0,,Сол жылу әлі күнге дейін іштей соғып тұрады
Dialogue: 0,0:23:40.49,0:23:41.70,ED,,0,0,0,,Сол жылу әлі күнге дейін іштей соғып тұрады
Dialogue: 0,0:23:41.70,0:23:44.12,ED,,0,0,0,,Сол жылу әлі күнге дейін іштей соғып тұрады
Dialogue: 0,0:23:44.33,0:23:53.84,ED,,0,0,0,,Сіздің қатысуыңыз менің өмірімнің әрбір бөлігіне нұрын шашады
Dialogue: 0,0:23:53.84,0:23:58.51,ED,,0,0,0,,Сенің жүрегіңнің соғуы менің мұздаған жүрегіммен резонанс тудырып, оны өртеп жібереді
Dialogue: 0,0:23:58.51,0:24:00.88,ED,,0,0,0,,Сенің жүрегіңнің соғуы менің мұздаған жүрегіммен резонанс тудырып, оны өртеп жібереді
Dialogue: 0,0:24:00.88,0:24:03.39,ED,,0,0,0,,Сенің жүрегіңнің соғуы менің мұздаған жүрегіммен резонанс тудырып, оны өртеп жібереді
Dialogue: 0,0:24:03.39,0:24:04.16,ED,,0,0,0,,Сенің жүрегіңнің соғуы менің мұздаған жүрегіммен резонанс тудырып, оны өртеп жібереді
Dialogue: 0,0:24:04.16,0:24:08.90,ED,,0,0,0,,Көп ұзамай өрт сөнеді
Dialogue: 0,0:24:08.90,0:24:12.98,ED,,0,0,0,,Жалындаған бір шоқ қалды
Dialogue: 0,0:24:12.98,0:24:13.70,ED,,0,0,0,,Жалындаған бір шоқ қалды
Dialogue: 0,0:24:13.70,0:24:17.95,ED,,0,0,0,,Ол менде қалады және ешқашан кетпейді
Dialogue: 0,0:24:18.43,0:24:22.61,ED,,0,0,0,,Менің жүрегіме жақын жерде менің ішімде өмір сүру
