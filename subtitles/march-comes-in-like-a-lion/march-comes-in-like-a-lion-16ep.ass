Dialogue: 1,0:08:47.55,0:08:47.60,signs,,0,0,0,,Тербеліс
Dialogue: 5,0:08:47.60,0:08:48.36,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:08:47.65,0:08:49.32,Default-ja,,0,0,0,,Иә? (Никаидо) Бауырым?
Dialogue: 5,0:08:48.36,0:08:49.35,Default,,0,0,0,,Үлкен аға?!
Dialogue: 5,0:08:49.76,0:08:56.10,Default,,0,0,0,,Бәсекелестікке жолдаманы ұтып алу мені осындай күйге қалдырды.
Dialogue: 0,0:08:49.78,0:08:53.58,Default-ja,,0,0,0,,Қатысушы билетін ал.
Dialogue: 0,0:08:53.66,0:08:55.95,Default-ja,,0,0,0,,Қазір солай.
Dialogue: 0,0:08:56.04,0:08:59.42,Default-ja,,0,0,0,,Мен болашақты аяймын...
Dialogue: 5,0:08:56.43,0:08:58.23,Default,,0,0,0,,Ары қарай не болар екен деп уайымдаймын.
Dialogue: 5,0:08:58.23,0:09:03.45,Default,,0,0,0,,Шындығында, бұдан кейін де алаңдайтын «келесі» бар ма?
Dialogue: 0,0:08:59.79,0:09:03.46,Default-ja,,0,0,0,,Алда мені аяйтындай нәрсе бар ма деп ойлаймын...
Dialogue: 5,0:09:04.50,0:09:09.47,Default,,0,0,0,,Өйткені, Соуя Готудан да құбыжық.
Dialogue: 0,0:09:04.50,0:09:09.34,Default-ja,,0,0,0,,Өйткені Соуя Готодан да құбыжық.
Dialogue: 0,0:09:12.14,0:09:13.39,Default-ja,,0,0,0,,Хмм...
Dialogue: 5,0:09:13.41,0:09:16.67,Default,,0,0,0,,Шимада, 8-дан, сен тым адалсың!
Dialogue: 0,0:09:13.60,0:09:16.52,Default-ja,,0,0,0,,Шимада 8-ші дан Шынымды айтсам, бұл тым көп
Dialogue: 0,0:09:18.64,0:09:20.06,Default-ja,,0,0,0,,Шимада 8-ші Дан
Dialogue: 5,0:09:18.66,0:09:20.42,Default,,0,0,0,,Шимада, 8-дан.
Dialogue: 0,0:09:21.98,0:09:24.44,Default-ja,,0,0,0,,Ах, Ямагата журналы...
Dialogue: 5,0:09:22.90,0:09:24.42,Default,,0,0,0,,Сіз Yamagata журналынансыз, солай ма?
Dialogue: 5,0:09:26.29,0:09:28.43,Default,,0,0,0,,Сіз ұзақ жолдан өттіңіз.
Dialogue: 0,0:09:26.32,0:09:28.32,Default-ja,,0,0,0,,Бұл алыс
Dialogue: 5,0:09:28.43,0:09:32.68,Default,,0,0,0,,Мен Изумидамын. Мен уәде еткендей мақала жасауға келдім.
Dialogue: 0,0:09:28.61,0:09:29.65,Default-ja,,0,0,0,,Бұл Изумида.
Dialogue: 0,0:09:29.74,0:09:32.57,Default-ja,,0,0,0,,Мен сұхбатқа уәде еткендей келдім.
Dialogue: 5,0:09:33.93,0:09:39.49,Default,,0,0,0,,Сол жерде тұрыңыз. Үйдегі фанклубыңыздағы қарт адамдар үміт артады.
Dialogue: 0,0:09:34.03,0:09:34.91,Default-ja,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:09:34.99,0:09:36.58,Default-ja,,0,0,0,,Сіз жергілікті қолдау тобынансыз.
Dialogue: 0,0:09:36.66,0:09:39.33,Default-ja,,0,0,0,,Қария мен кемпірдің үміті ақталады.
Dialogue: 5,0:09:39.49,0:09:40.70,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:09:39.54,0:09:42.42,Default-ja,,0,0,0,,Дұрыс, менің балаларымның шоги клубы...
Dialogue: 5,0:09:40.70,0:09:45.61,Default,,0,0,0,,Сіз нұсқаушысыз, сонымен қатар біздің балалар шоги клубының кейіпкерісіз, Шимада.
Dialogue: 0,0:09:42.50,0:09:45.71,Default-ja,,0,0,0,,Шимада мырза әрі лектор, әрі батыр.
Dialogue: 0,0:09:45.92,0:09:47.63,Default-ja,,0,0,0,,Мен көремін.
Dialogue: 5,0:09:45.99,0:09:47.90,Default,,0,0,0,,Б... бір сызық
Dialogue: 5,0:09:49.37,0:09:51.37,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:09:49.51,0:09:51.34,Default-ja,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:53.22,0:09:54.43,Default-ja,,0,0,0,,Бақылау камерасы ма?
Dialogue: 5,0:09:53.23,0:09:54.67,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:09:57.97,0:10:01.31,Default-ja,,0,0,0,,Бұл іріктеу кезеңі де қиын шайқас болды, бірақ...
Dialogue: 5,0:09:58.01,0:10:05.88,Default,,0,0,0,,Бұл іріктеу тағы бір қиын шайқас болды, бірақ мен қарсылас болғаныма өте қуаныштымын.
Dialogue: 0,0:10:01.73,0:10:05.48,Default-ja,,0,0,0,,Мен сайыскер болғаныма қуаныштымын.
Dialogue: 5,0:10:05.88,0:10:09.56,Default,,0,0,0,,Арыстан патша турнирінде жеті матч бар,
Dialogue: 0,0:10:05.98,0:10:09.32,Default-ja,,0,0,0,,Арыстан Кингке қарсы кездесу жетінші матч болады...
Dialogue: 5,0:10:09.56,0:10:13.39,Default,,0,0,0,,«Үміт» сөзімен оны жұмсақ итермелеп,
Dialogue: 0,0:10:09.61,0:10:13.36,Default-ja,,0,0,0,,«Күту» сөзі мені кері итеріп жібергендей—
Dialogue: 5,0:10:10.23,0:10:12.68,Default,,0,0,0,,сондықтан бұл ұзақ күрес болады.
Dialogue: 5,0:10:12.68,0:10:17.42,Default,,0,0,0,,Мен жоғары формада болу үшін жұмыс істеуім керек, бірақ мен алда болатын сынақты асыға күтемін.
Dialogue: 0,0:10:13.70,0:10:16.41,Default-ja,,0,0,0,,Шимада мырза ақырын сөйлей бастады.
Dialogue: 5,0:10:13.90,0:10:16.52,Default,,0,0,0,,Шимада ақырын сөйлей бастады.
Dialogue: 5,0:10:18.75,0:10:22.14,Default,,0,0,0,,Ол сөздерді күштеп шығару керек сияқты бір-бір сөзді айтты.
Dialogue: 0,0:10:18.79,0:10:21.96,Default-ja,,0,0,0,,Бір сөзді сығып алғандай
Dialogue: 5,0:10:23.44,0:10:29.86,Default,,0,0,0,,Мен өзімді жардан лақтырып жібергендей, осылай жеңіске бардым ба?
Dialogue: 0,0:10:23.46,0:10:26.88,Default-ja,,0,0,0,,Мен өзімді осылай лақтырып жіберетіндей...
Dialogue: 0,0:10:27.17,0:10:29.67,Default-ja,,0,0,0,,Сіз жеңуге тырысып көрдіңіз бе?
Dialogue: 0,0:10:32.80,0:10:33.80,Default-ja,,0,0,0,,Иә.
Dialogue: 5,0:10:32.83,0:10:34.16,Default,,0,0,0,,Мен оны қазір көріп тұрмын.
Dialogue: 0,0:10:34.51,0:10:37.56,Default-ja,,0,0,0,,Шимада мырза жатқан жер алыс.
Dialogue: 5,0:10:34.55,0:10:37.78,Default,,0,0,0,,Шимада осы жерден алыс жерде.
Dialogue: 5,0:10:38.16,0:10:42.42,Default,,0,0,0,,Ол мен ешқашан аман-есен жете алмайтын әлемде.
Dialogue: 0,0:10:38.43,0:10:42.31,Default-ja,,0,0,0,,Ешқашан зиянсыз жете алмайтын әлем
Dialogue: 0,0:10:45.44,0:10:47.69,Default-ja,,0,0,0,,Жеңіске жетуіме ешқандай себеп жоқ...
Dialogue: 5,0:10:45.46,0:10:51.30,Default,,0,0,0,,Мен бұл жерде: «Менде жеңуге ешқандай себеп жоқ» және «Мен жеңілген кезде неге соншалықты ауырмын?»
Dialogue: 0,0:10:48.02,0:10:51.49,Default-ja,,0,0,0,,«Бірақ мен жеңілгенімде неге сонша ренжітемін?» деген сияқты сөздерді айту кезінде.
Dialogue: 5,0:10:53.05,0:10:55.43,Default,,0,0,0,,Көзімді қашырған дүние.
Dialogue: 0,0:10:53.24,0:10:55.20,Default-ja,,0,0,0,,Мен бұрылған дүние
Dialogue: 5,0:10:59.19,0:11:01.31,Default,,0,0,0,,Ал оның соңында...
Dialogue: 0,0:10:59.37,0:11:01.20,Default-ja,,0,0,0,,Соңында ол...
Dialogue: 0,0:11:02.04,0:11:02.87,Default-ja,,0,0,0,,Кирияма
Dialogue: 5,0:11:02.08,0:11:02.86,Default,,0,0,0,,Кирияма!
Dialogue: 5,0:11:05.32,0:11:07.11,Default,,0,0,0,,Сәлем, Кирияма.
Dialogue: 0,0:11:05.38,0:11:07.04,Default-ja,,0,0,0,,Йо Кирияма
Dialogue: 5,0:11:08.36,0:11:12.36,Default,,0,0,0,,...ол нық қадаммен жалғыз алға ұмтылатын адам.
Dialogue: 0,0:11:08.42,0:11:12.26,Default-ja,,0,0,0,,Ол екі аяқты басатын.
Dialogue: 5,0:11:14.04,0:11:15.87,Default,,0,0,0,,Дәл сол кезде, кенеттен,
Dialogue: 0,0:11:14.09,0:11:15.55,Default-ja,,0,0,0,,Сосын кенеттен—
Dialogue: 0,0:11:18.14,0:11:20.35,Default-ja,,0,0,0,,Кеуденің іші тым-тырыс.
Dialogue: 5,0:11:18.17,0:11:23.61,Default,,0,0,0,,кеудемнің іші мыжылып, тамағымның артқы жағынан ыстық шығып кеткендей болды.
Dialogue: 0,0:11:20.77,0:11:23.52,Default-ja,,0,0,0,,Тамағымның артындағы ыстық көтеріліп барады.
Dialogue: 0,0:11:28.98,0:11:30.94,Default-ja,,0,0,0,,Дұрыс, кешіріңіз.
Dialogue: 5,0:11:29.03,0:11:33.89,Default,,0,0,0,,Кешіріңіз, балақай, бірақ сіз маған салқын сусын бере аласыз ба?
Dialogue: 0,0:11:31.32,0:11:33.82,Default-ja,,0,0,0,,Маған суық нәрсе сатып ала аласыз ба?
Dialogue: 5,0:11:33.89,0:11:35.14,Default,,0,0,0,,Әрине!
Dialogue: 0,0:11:33.90,0:11:34.90,Default-ja,,0,0,0,,Иә
Dialogue: 0,0:11:37.03,0:11:38.24,Default-ja,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 5,0:11:37.05,0:11:38.35,Default,,0,0,0,,Шай жақсы ма?
Dialogue: 0,0:11:38.32,0:11:39.99,Default-ja,,0,0,0,,Оларды колоданың басынан бастап ретімен оқып шығамын
Dialogue: 5,0:11:38.35,0:11:40.02,Default,,0,0,0,,Иә. рахмет.
Dialogue: 0,0:11:40.62,0:11:43.58,Default-ja,,0,0,0,,Менде әлі айырбасқа беретін ештеңем жоқ...
Dialogue: 5,0:11:40.65,0:11:45.27,Default,,0,0,0,,Менің оған айырбастай алатын ештеңем жоқ шығар,
Dialogue: 0,0:11:43.66,0:11:45.75,Default-ja,,0,0,0,,Мүмкін мүлде болмауы мүмкін
Dialogue: 0,0:11:47.63,0:11:50.13,Default-ja,,0,0,0,,Мен... мен сенмін...
Dialogue: 5,0:11:47.69,0:11:50.15,Default,,0,0,0,,бірақ бар...
Dialogue: 0,0:11:50.88,0:11:52.92,Default-ja,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді.
Dialogue: 5,0:11:50.92,0:11:52.70,Default,,0,0,0,,Мен одан бір нәрсе сұрағым келеді.
Dialogue: 0,0:12:07.15,0:12:08.94,Default-ja,,0,0,0,,Қазір...
Dialogue: 5,0:12:07.15,0:12:09.05,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:12:11.02,0:12:13.40,Default-ja,,0,0,0,,Шимада мырза
Dialogue: 5,0:12:11.04,0:12:13.64,Default,,0,0,0,,Ум, Шимада...
Dialogue: 0,0:12:14.94,0:12:16.57,Default-ja,,0,0,0,,Оқу тобына—
Dialogue: 5,0:12:14.99,0:12:16.30,Default,,0,0,0,,Семинар туралы...
Dialogue: 0,0:12:17.11,0:12:18.49,Default-ja,,0,0,0,,Маған кіруге рұқсат етіңізші. (Шимада) Кіре алмайсыз ба?
Dialogue: 5,0:12:17.18,0:12:18.58,Default,,0,200,0,,Қосылғыңыз келе ме?
Dialogue: 5,0:12:17.18,0:12:18.58,Default,,200,0,0,,Маған қосылуға рұқсат етіңіз.
Dialogue: 5,0:12:23.27,0:12:23.89,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:12:35.76,0:12:38.59,Default-ja,,0,0,0,,Не? А... неге?
Dialogue: 5,0:12:36.57,0:12:38.70,Default,,0,0,0,,Әй, қалай болды...
Dialogue: 0,0:12:40.18,0:12:41.85,Default-ja,,0,0,0,,Сізді күттіргенім үшін кешіріңіз, аға.
Dialogue: 5,0:12:40.22,0:12:41.79,Default,,0,0,0,,Ұзақ кеткені үшін кешіріңіз, Үлкен аға!
Dialogue: 0,0:12:42.39,0:12:44.10,Default-ja,,0,0,0,,Иә? не?
Dialogue: 5,0:12:42.42,0:12:44.12,Default,,0,0,0,,Иә? Не болып жатыр?
Dialogue: 5,0:12:47.30,0:12:49.21,Default,,0,0,0,,Толқудың бәрі неде?
Dialogue: 0,0:12:47.52,0:12:49.10,Default-ja,,0,0,0,,Неліктен бұл соншалықты қызықты?
Dialogue: 5,0:12:49.21,0:12:51.00,Default,,0,0,0,,Маған да кіруге рұқсат етіңіз!
Dialogue: 0,0:12:49.40,0:12:50.90,Default-ja,,0,0,0,,Менімен де араластырыңызшы!
Dialogue: 5,0:12:51.30,0:12:52.74,Default,,0,0,0,,Сәлем! Үлкен аға!
Dialogue: 0,0:12:51.31,0:12:55.53,Default-ja,,0,0,0,,Сәлем аға? Кирияма! Жер бетінде не болды?
Dialogue: 5,0:12:53.38,0:12:55.83,Default,,0,0,0,,Кирияма, не болды?!
Dialogue: 5,0:12:55.83,0:12:58.04,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:12:56.57,0:12:57.70,Default-ja,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:12:57.01,0:13:00.02,titles,,0,0,0,,Түн бойы жүгіру
Dialogue: 0,0:13:00.02,0:13:04.02,titles,,0,0,0,,Төбеге көтерілу
Dialogue: 5,0:13:09.20,0:13:10.61,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:13:09.21,0:13:10.63,Default-ja,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 5,0:13:10.95,0:13:12.24,Default,,0,0,0,,Күй қандай?
Dialogue: 0,0:13:10.96,0:13:12.17,Default-ja,,0,0,0,,-да ол қандай анбай?
Dialogue: 5,0:13:13.19,0:13:13.95,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 5,0:13:13.19,0:13:15.99,Default,,0,0,0,,Жоқ, ата! Мысықтарды ішке кіргізбеңіз!
Dialogue: 0,0:13:13.25,0:13:14.09,Default-ja,,0,0,0,,Мен! Қазір емес!
Dialogue: 0,0:13:14.21,0:13:16.01,Default-ja,,0,0,0,,Ата, енді мияулауға жол бермеңіз!
Dialogue: 5,0:13:15.99,0:13:17.24,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:13:16.13,0:13:17.22,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 5,0:13:17.24,0:13:18.53,Default,,0,0,0,,Әй, бұл қағаз!
Dialogue: 0,0:13:17.30,0:13:18.42,Default-ja,,0,0,0,,Уау, қағаз!
Dialogue: 0,0:13:18.51,0:13:20.55,Default-ja,,0,0,0,,Қағазда жүгіргім келеді, мияу
Dialogue: 5,0:13:18.53,0:13:20.66,Default,,0,0,0,,Мен қағазды жүгіріп өткім келеді!
Dialogue: 5,0:13:20.66,0:13:22.29,Default,,0,0,0,,Мұнда. Бұлар құрғақ.
Dialogue: 0,0:13:20.72,0:13:22.18,Default-ja,,0,0,0,,Иә, бұл құрғақ.
Dialogue: 5,0:13:22.29,0:13:24.32,Default,,0,0,0,,Жақсы! Біз оны уақытында жасаймыз!
Dialogue: 0,0:13:22.30,0:13:24.14,Default-ja,,0,0,0,,Жақсы, мен оны уақытында жасаймын.
Dialogue: 0,0:13:24.22,0:13:27.02,Default-ja,,0,0,0,,Енді біз қосымша тапсырыстарды орындай аламыз.
Dialogue: 5,0:13:24.32,0:13:26.79,Default,,0,0,0,,Енді мен сол қосымша тапсырыстарды орындай аламын.
Dialogue: 5,0:13:27.92,0:13:30.42,Default,,0,0,0,,Бұл шынымен де әдемі.
Dialogue: 0,0:13:27.93,0:13:30.35,Default-ja,,0,0,0,,Оның үстіне бұл да өте әдемі.
Dialogue: 5,0:13:30.42,0:13:32.12,Default,,0,0,0,,Керемет жұмыс, Хина!
Dialogue: 0,0:13:30.44,0:13:31.73,Default-ja,,0,0,0,,Бұл үлкен Хина
Dialogue: 0,0:13:31.81,0:13:32.65,Default-ja,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:13:33.72,0:13:35.63,signs,,0,0,0,,Картоп мөрі бар қағаз
Dialogue: 1,0:13:33.72,0:13:35.63,signs,,0,0,0,,Картоп мөрі бар қағаз
Dialogue: 0,0:13:33.72,0:13:35.63,signs,,0,0,0,,Хинаның ерекшелігі
Dialogue: 1,0:13:33.72,0:13:35.63,signs,,0,0,0,,Хинаның ерекшелігі
Dialogue: 0,0:13:34.09,0:13:35.63,signs,,0,0,0,,Бүгін оның бір бөлігін трафарет жасауға бірінші әрекеті!
Dialogue: 1,0:13:34.09,0:13:35.63,signs,,0,0,0,,Бүгін оның бір бөлігін трафарет жасауға бірінші әрекеті!
Dialogue: 5,0:13:36.07,0:13:39.26,Default,,0,0,0,,Қосымша тапсырыстар керемет! Мен оны естігеніме қуаныштымын.
Dialogue: 0,0:13:36.07,0:13:39.45,Default-ja,,0,0,0,,Қосымша тапсырыстар керемет. Мен бақыттымын.
Dialogue: 5,0:13:39.70,0:13:42.02,Default,,0,0,0,,Бір жақсысы, біз көп қораптарға тапсырыс бердік.
Dialogue: 0,0:13:39.70,0:13:42.07,Default-ja,,0,0,0,,Мен көбірек қораптарға тапсырыс бергеніме қуаныштымын.
Dialogue: 5,0:13:42.02,0:13:44.42,Default,,0,0,0,,Хинаның ақша туралы пікірі дұрыс болды.
Dialogue: 0,0:13:42.24,0:13:44.08,Default-ja,,0,0,0,,Хинаның пікірі дұрыс
Dialogue: 5,0:13:44.42,0:13:47.30,Default,,0,0,0,,Иә, қарапайым қораптарды сатып алу ең арзан.
Dialogue: 0,0:13:44.49,0:13:47.08,Default-ja,,0,0,0,,Box Plain арзанырақ.
Dialogue: 5,0:13:47.30,0:13:51.86,Default,,0,0,0,,Мен трафаретпен жұмыс істеуге дағдыланғандықтан, келесі жолы одан да сүйкімді басып шығаруға тырысамын.
Dialogue: 0,0:13:47.37,0:13:49.46,Default-ja,,0,0,0,,Мен трафареттерді қолдануға үйреніп қалдым, сондықтан...
Dialogue: 0,0:13:49.54,0:13:51.75,Default-ja,,0,0,0,,Келесі жолы сүйкімділерін басып шығарамын деп ойлаймын.
Dialogue: 5,0:13:52.17,0:13:56.37,Default,,0,0,0,,Бірақ шын мәнінде, Қыздар күні фестивалінің тәттілері сүйкімді.
Dialogue: 0,0:13:52.21,0:13:53.29,Default-ja,,0,0,0,,Бірақ шынымен-
Dialogue: 0,0:13:53.38,0:13:56.13,Default-ja,,0,0,0,,Қуыршақ фестиваліне арналған жапон тәттілері сүйкімді, солай емес пе?
Dialogue: 5,0:13:56.37,0:13:59.26,Default,,0,0,0,,Мен әртүрлі деңгейлі қораптардың неге ең жақсы сатылатынын түсінемін.
Dialogue: 0,0:13:56.38,0:13:59.13,Default-ja,,0,0,0,,Ассортименттің салмағы жиі шығатынын түсінемін.
Dialogue: 5,0:13:59.26,0:14:01.74,Default,,0,0,0,,Мен бұлардың біреуін алсам қуанышты болар едім.
Dialogue: 0,0:13:59.34,0:14:01.59,Default-ja,,0,0,0,,Бұны алсам, қуанар едім.
Dialogue: 5,0:14:02.41,0:14:06.96,Default,,0,0,0,,Жарайды, біздің үйде биылғы Қыздар мерекесіне не істейміз?
Dialogue: 0,0:14:02.51,0:14:03.76,Default-ja,,0,0,0,,Saateto—
Dialogue: 0,0:14:04.05,0:14:06.93,Default-ja,,0,0,0,,Биылғы жылы біздің үйде қуыршақтар мерекесіне не істеуіміз керек?
Dialogue: 5,0:14:06.96,0:14:08.71,Default,,0,0,0,,Қуырылған тофу дорбалары!
Dialogue: 0,0:14:07.18,0:14:08.68,Default-ja,,0,0,0,,Ойнари-сан
Dialogue: 5,0:14:08.71,0:14:12.93,Default,,0,0,0,,Әй, бірақ әртүрлі суши - бұл Қыздар күні фестивалінің стандарты, солай ма?
Dialogue: 0,0:14:10.06,0:14:12.85,Default-ja,,0,0,0,,Қуыршақ фестивалі туралы айтатын болсақ, бұл чираши суши, солай ма?
Dialogue: 5,0:14:12.93,0:14:14.59,Default,,0,0,0,,Немесе жұмыртқа қалталарындағы суши.
Dialogue: 0,0:14:12.94,0:14:14.36,Default-ja,,0,0,0,,Чакин сушиі т.б.
Dialogue: 5,0:14:14.59,0:14:16.09,Default,,0,0,0,,Қуырылған тофу дорбалары...
Dialogue: 0,0:14:14.73,0:14:16.07,Default-ja,,0,0,0,,Ойнари-сан
Dialogue: 5,0:14:16.09,0:14:18.72,Default,,0,0,0,,Мен де оларды алғым келеді.
Dialogue: 0,0:14:16.32,0:14:18.86,Default-ja,,0,0,0,,Хина да мырзаны жегісі келеді.
Dialogue: 5,0:14:19.11,0:14:21.47,Default,,0,0,0,,Ал, көрейік...
Dialogue: 0,0:14:19.15,0:14:21.28,Default-ja,,0,0,0,,Хмм... иә.
Dialogue: 5,0:14:21.47,0:14:23.10,Default,,0,0,0,,Менің ойымша, бұл жақсы болар еді.
Dialogue: 0,0:14:21.70,0:14:23.20,Default-ja,,0,0,0,,Жарайсың ба?
Dialogue: 5,0:14:23.10,0:14:24.72,Default,,0,0,0,,Мен де баруға болады.
Dialogue: 0,0:14:23.32,0:14:24.70,Default-ja,,0,0,0,,Менің де жегім келеді
Dialogue: 0,0:14:26.24,0:14:28.54,Default-ja,,0,0,0,,Табаға көп нәрсе жасап, дастарханға ұсыныңыз.
Dialogue: 5,0:14:26.26,0:14:30.92,Default,,0,0,0,,Неліктен біз үлкен табақ, содан кейін онымен бірге келетін мөлдір балшық сорпасын жасамасқа?
Dialogue: 0,0:14:28.62,0:14:31.00,Default-ja,,0,0,0,,Мен балдыркөк сорпасын жасайын ба?
Dialogue: 5,0:14:31.78,0:14:32.90,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:14:31.79,0:14:32.79,Default-ja,,0,0,0,,Шынымен...
Dialogue: 0,0:14:33.21,0:14:36.21,Default-ja,,0,0,0,,Онари-сан неге сонша дәмді?
Dialogue: 5,0:14:33.24,0:14:36.15,Default,,0,0,0,,Мен қуырылған тофу дорбалары неге соншалықты жақсы деп ойлаймын.
Dialogue: 5,0:14:37.20,0:14:45.06,Default,,0,0,0,,Тәтті, қуырылған бұршақ сүзбесі, ішінде көп мөлшерде кесілген, қытырлақ лотос тамыры, туралған жұмыртқа және күнжіт дәндері...
Dialogue: 0,0:14:37.21,0:14:38.92,Default-ja,,0,0,0,,Тәтті пісірілген қуырылған күріш —
Dialogue: 0,0:14:39.01,0:14:41.51,Default-ja,,0,0,0,,Ішінде туралған қытырлақ лотос тамыры —
Dialogue: 0,0:14:41.67,0:14:44.89,Default-ja,,0,0,0,,Көп мөлшерде тартылған жұмыртқа мен күнжітті қосыңыз...
Dialogue: 0,0:14:46.01,0:14:48.89,Default-ja,,0,0,0,,Егер сіз абайсызда болсаңыз, сіз тоқтаусыз тамақ ішуіңіз мүмкін.
Dialogue: 5,0:14:46.02,0:14:48.92,Default,,0,0,0,,Егер мен абай болмасам, мен оларды жей берер едім!
Dialogue: 0,0:14:48.92,0:14:49.29,signs,,0,0,0,,Хафф
Dialogue: 1,0:14:48.92,0:14:49.29,signs,,0,0,0,,Хафф
Dialogue: 0,0:14:48.92,0:14:49.29,signs,,0,0,0,,Хафф
Dialogue: 1,0:14:48.92,0:14:49.29,signs,,0,0,0,,Хафф
Dialogue: 5,0:14:48.92,0:14:53.33,Default,,0,0,0,,Тезірек қуырылған тофу дорбаларын жейік!
Dialogue: 0,0:14:49.14,0:14:52.44,Default-ja,,0,0,0,,Ойнари мырза, мен тез, тез тамақтанғым келеді...
Dialogue: 0,0:14:49.17,0:14:49.54,signs,,0,0,0,,Хафф
Dialogue: 1,0:14:49.17,0:14:49.54,signs,,0,0,0,,Хафф
