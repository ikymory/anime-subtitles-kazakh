Dialogue: 1,0:14:53.96,0:14:54.00,signs,,0,0,0,,Хафф
Dialogue: 0,0:14:54.00,0:14:54.05,signs,,0,0,0,,Хафф
Dialogue: 1,0:14:54.00,0:14:54.05,signs,,0,0,0,,Хафф
Dialogue: 0,0:14:54.56,0:14:56.44,Default-ja,,0,0,0,,Оны күнжіт етіңіз! Оинари мырза
Dialogue: 5,0:14:54.59,0:14:56.84,Default,,0,0,0,,Оларды күнжіт тұқымымен толтырыңыз!
Dialogue: 5,0:14:59.61,0:15:02.43,Default,,0,0,0,,Мен оны Реймен де бөліскім келеді.
Dialogue: 0,0:14:59.61,0:15:02.28,Default-ja,,0,0,0,,Мен де Рей-чанды тамақтандырғым келеді.
Dialogue: 5,0:15:02.78,0:15:04.83,Default,,0,0,0,,Оның жағдайы қалай екен деп ойлаймын.
Dialogue: 0,0:15:02.78,0:15:04.32,Default-ja,,0,0,0,,Қызық, не болып жатыр?
Dialogue: 5,0:15:04.83,0:15:07.09,Default,,0,0,0,,Бұл біраз уақыт алуы мүмкін.
Dialogue: 0,0:15:05.03,0:15:06.99,Default-ja,,0,0,0,,Бұл біраз уақыт алуы мүмкін.
Dialogue: 0,0:15:07.07,0:15:08.83,Default-ja,,0,0,0,,Қанша жас болсаң да, ер адамсың.
Dialogue: 5,0:15:07.09,0:15:08.94,Default,,0,0,0,,Ол бала болуы мүмкін, бірақ ол да ер адам.
Dialogue: 0,0:15:08.91,0:15:10.70,Default-ja,,0,0,0,,О, мақтанышым
Dialogue: 5,0:15:08.94,0:15:10.79,Default,,0,0,0,,Сондықтан оның мақтанышы бар.
Dialogue: 5,0:15:10.79,0:15:11.85,Default,,0,0,0,,Оны күтіңіз.
Dialogue: 0,0:15:10.83,0:15:12.16,Default-ja,,0,0,0,,Мені күт
Dialogue: 5,0:15:12.23,0:15:14.81,Default,,0,0,0,,Мен ондай нәрселерді түсінбеймін!
Dialogue: 0,0:15:12.25,0:15:14.71,Default-ja,,0,0,0,,Сондықтан мен мұны түсінбеймін.
Dialogue: 0,0:15:15.29,0:15:17.79,Default-ja,,0,0,0,,Тәкаппарлықтан аш болу дұрыс па?
Dialogue: 5,0:15:15.30,0:15:17.69,Default,,0,0,0,,Тәкаппарлық үшін аш жүруге бола ма?!
Dialogue: 5,0:15:17.69,0:15:20.53,Default,,0,0,0,,Аш болсаң, қуат болмайды!
Dialogue: 0,0:15:17.96,0:15:20.42,Default-ja,,0,0,0,,Аш болсаң, қуат та қалмайды!
Dialogue: 0,0:15:20.84,0:15:23.67,Default-ja,,0,0,0,,Мәңгі келмесең, енді білмейсің.
Dialogue: 5,0:15:20.85,0:15:24.04,Default,,0,0,0,,Егер ол енді қонаққа келмесе, жақсы.
Dialogue: 5,0:15:24.04,0:15:28.70,Default,,0,0,0,,Мен оның пәтеріне кенеттен келіп, оның аузына қуырылған тофу дорбаларын саламын.
Dialogue: 0,0:15:24.18,0:15:25.76,Default-ja,,0,0,0,,Осы жерден итеру—
Dialogue: 0,0:15:25.97,0:15:28.55,Default-ja,,0,0,0,,Мен сені аузыма тығып алайын.
Dialogue: 5,0:15:30.18,0:15:32.71,Default,,0,0,0,,Ум, Сендағы және 6-шы...
Dialogue: 0,0:15:30.18,0:15:32.68,Default-ja,,0,0,0,,А-а, сендегі 6...
Dialogue: 5,0:15:33.81,0:15:36.71,Default,,0,0,0,,Мен осы төбеден түсемін деп ойлаймын.
Dialogue: 0,0:15:33.85,0:15:36.65,Default-ja,,0,0,0,,Мына төбеден төмен... мүмкін бе?
Dialogue: 0,0:15:38.94,0:15:42.03,Default-ja,,0,0,0,,Үй ескі қаланың баурайының жартысында.
Dialogue: 5,0:15:38.97,0:15:42.12,Default,,0,0,0,,Үй қаланың ескі бөлігінде болды,
Dialogue: 5,0:15:43.28,0:15:45.37,Default,,0,0,0,,Тамаша көрінісі бар төбенің жартысы.
Dialogue: 0,0:15:43.32,0:15:45.24,Default-ja,,0,0,0,,Көрінісі жақсы жерде болды.
Dialogue: 0,0:15:49.08,0:15:50.95,Default-ja,,0,0,0,,Эй, сені осында көргеніме қуаныштымын.
Dialogue: 5,0:15:49.11,0:15:51.00,Default,,0,0,0,,Эй, сен оны орындадың.
Dialogue: 5,0:15:51.00,0:15:52.48,Default,,0,0,0,,Қоңырау соғатын шығарсың деп ойладым.
Dialogue: 0,0:15:51.04,0:15:52.75,Default-ja,,0,0,0,,Маған телефон соғады деп ойладым.
Dialogue: 5,0:15:52.83,0:15:54.97,Default,,0,0,0,,Бұл аймақта ештеңе табу қиын.
Dialogue: 0,0:15:52.87,0:15:54.83,Default-ja,,0,0,0,,Себебі оны түсіну қиын.
Dialogue: 5,0:15:56.16,0:15:57.98,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,0:15:56.17,0:15:57.75,Default-ja,,0,0,0,,Осы киімде ыстық емес пе?
Dialogue: 5,0:16:02.25,0:16:05.87,Default,,0,0,0,,Бұл менің Шимаданың шеберханасына қатысқан бірінші күнім.
Dialogue: 0,0:16:02.25,0:16:06.26,Default-ja,,0,0,0,,Бүгіннен бастап мен Шимада мырзаның зерттеу тобына қатысамын.
Dialogue: 5,0:16:07.66,0:16:10.37,Default,,0,0,0,,Кездесу орны – оның үйі.
Dialogue: 0,0:16:07.68,0:16:10.01,Default-ja,,0,0,0,,Кездесу орны - Шимада мырзаның үйі.
Dialogue: 5,0:16:10.37,0:16:12.42,Default,,0,0,0,,Ей, кешігіп қалдың, Кирияма!
Dialogue: 0,0:16:10.47,0:16:12.43,Default-ja,,0,0,0,,Ой, кешігіп қалдың, Кирияма.
Dialogue: 5,0:16:14.42,0:16:16.79,Default,,0,0,0,,Мен осындай кездесулер болатынын білдім,
Dialogue: 0,0:16:14.52,0:16:17.23,Default-ja,,0,0,0,,Мен осындай жиналыс болатынын білдім, бірақ...
Dialogue: 5,0:16:17.54,0:16:21.30,Default,,0,0,0,,бірақ бұл менің бірінші рет қатысуым, сондықтан мен біраз қобалжыдым.
Dialogue: 0,0:16:17.56,0:16:19.52,Default-ja,,0,0,0,,Бұл менің бірінші рет қатысуым.
Dialogue: 0,0:16:19.61,0:16:21.07,Default-ja,,0,0,0,,Мен біраз қобалжыдым.
Dialogue: 0,0:16:23.11,0:16:25.03,Default-ja,,0,0,0,,А, мені таныстырмаңыз.
Dialogue: 5,0:16:23.13,0:16:25.05,Default,,0,0,0,,О, мен сені таныстырамын.
Dialogue: 5,0:16:25.05,0:16:27.05,Default,,0,0,0,,Бұл Шигета Морио.
Dialogue: 0,0:16:25.28,0:16:26.70,Default-ja,,0,0,0,,Морио Шигета
Dialogue: 5,0:16:27.05,0:16:30.16,Default,,0,0,0,,Біз замандаспыз және бірлестікке кіргеннен бері доспыз.
Dialogue: 0,0:16:27.11,0:16:30.07,Default-ja,,0,0,0,,Ол менімен бір кезеңнен шыққан, біз мадақтау кездесуінен бері біргеміз.
Dialogue: 5,0:16:30.16,0:16:35.06,Default,,0,0,0,,Ол аздап үнсіз және жалт қараюға бейім, бірақ ол ерекше ашуланбайды.
Dialogue: 0,0:16:30.20,0:16:32.28,Default-ja,,0,0,0,,Ол сәл үнсіз, түрі нашар, бірақ...
Dialogue: 0,0:16:32.37,0:16:34.62,Default-ja,,0,0,0,,Мен ерекше ашуланбаймын.
Dialogue: 5,0:16:35.47,0:16:40.28,Default,,0,0,0,,Ал ол саған үйренгеннен кейін тілі өткір болады, бірақ бұл сізді мазаламасын.
Dialogue: 0,0:16:35.50,0:16:38.50,Default-ja,,0,0,0,,Үйреніп алсаң, уды түкіре бастайсың...
Dialogue: 0,0:16:38.58,0:16:40.04,Default-ja,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 5,0:16:40.28,0:16:47.07,Default,,0,0,0,,Шогиден тыс, ол бір сағатта үш нәрсені айтады, бірақ бұл оның мұнда болғысы келмейтінін білдірмейді.
Dialogue: 0,0:16:40.33,0:16:41.84,Default-ja,,0,0,0,,Шогиден басқа...
Dialogue: 0,0:16:42.00,0:16:44.51,Default-ja,,0,0,0,,Бір сағатта шамамен 3 пікір...
Dialogue: 0,0:16:44.59,0:16:47.05,Default-ja,,0,0,0,,Бұл менің мұнда болғым келмейтіндігім емес.
Dialogue: 5,0:16:47.07,0:16:49.58,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:16:47.26,0:16:49.43,Default-ja,,0,0,0,,Алдын ала рахмет
