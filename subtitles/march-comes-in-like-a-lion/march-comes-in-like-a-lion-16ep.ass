Dialogue: 1,0:20:30.17,0:20:30.84,signs,,0,0,0,,Жарқырау
Dialogue: 0,0:20:31.15,0:20:33.11,Default-ja,,0,0,0,,Бір сәт.
Dialogue: 5,0:20:31.19,0:20:33.25,Default,,0,0,0,,Мен бірдеңе айта аламын ба?
Dialogue: 0,0:20:35.65,0:20:37.49,Default-ja,,0,0,0,,Амансың ба, аға?
Dialogue: 5,0:20:35.68,0:20:37.82,Default,,0,0,0,,Үлкен ағаның жағдайы жақсы деп үміттенемін.
Dialogue: 5,0:20:37.82,0:20:39.32,Default,,0,0,0,,Мен не болды деп ойлаймын.
Dialogue: 0,0:20:37.91,0:20:41.24,Default-ja,,0,0,0,,Не болды, кенет ішім ауырды?
Dialogue: 5,0:20:39.32,0:20:41.38,Default,,0,0,0,,Ол кенет іші ауырғанын айтты.
Dialogue: 5,0:20:41.38,0:20:44.57,Default,,0,0,0,,Оның ауа-райының астында болуы әдеттен тыс.
Dialogue: 0,0:20:41.41,0:20:44.45,Default-ja,,0,0,0,,Менің ағамның ауыруы ерекше.
Dialogue: 5,0:20:44.57,0:20:48.86,Default,,0,0,0,,Ол өзін жақсы күтеді, сондықтан ол әдетте ауырмайды немесе басқа ештеңеге ұшырамайды.
Dialogue: 0,0:20:44.62,0:20:46.25,Default-ja,,0,0,0,,Өзін-өзі дұрыс басқару -
Dialogue: 0,0:20:46.33,0:20:49.29,Default-ja,,0,0,0,,Мен жиі ауыратын адам емеспін.
Dialogue: 5,0:20:49.53,0:20:51.61,Default,,0,0,0,,Мен оның бәрі жақсы деп үміттенемін.
Dialogue: 0,0:20:49.58,0:20:51.34,Default-ja,,0,0,0,,Шынында не болды?
Dialogue: 0,0:20:51.96,0:20:53.71,Default-ja,,0,0,0,,Жақын арада титулдық матч болады...
Dialogue: 5,0:20:51.99,0:20:57.19,Default,,0,0,0,,Оның титулдық матчы алда, сондықтан ол қысымды сезінуі мүмкін.
Dialogue: 0,0:20:53.80,0:20:56.92,Default-ja,,0,0,0,,Мүмкін қандай да бір қысым бар шығар.
Dialogue: 5,0:20:57.19,0:20:59.37,Default,,0,0,0,,Тезірек сауығып кетеді деп үміттенемін.
Dialogue: 0,0:20:57.26,0:20:59.26,Default-ja,,0,0,0,,Тезірек сауығып кетесің деп үміттенемін.
Dialogue: 5,0:20:59.97,0:21:03.87,Default,,0,0,0,,Бірақ мен S-4g-ден S-3f-ге дейін шегінбеймін!
Dialogue: 0,0:20:59.97,0:21:03.89,Default-ja,,0,0,0,,Бірақ 47 күмістен 36 күміске дейін мен одан ешқашан бас тартпаймын.
Dialogue: 5,0:21:03.87,0:21:06.25,Default,,0,0,0,,Аға, сен қыңырсың. Сіз әлі де солайсыз ба?
Dialogue: 0,0:21:04.06,0:21:06.23,Default-ja,,0,0,0,,Сіз табандысыз, мен оны әлі айтуым керек пе?
Dialogue: 5,0:21:09.94,0:21:16.03,Default,,0,0,0,,Мен жай ғана S-3g орнына айтамын, S-4g қарсыласыңыздың қандай жоспары болса да тоқтатады!
Dialogue: 0,0:21:09.94,0:21:13.40,Default-ja,,0,0,0,,Сондықтан 3 жеті күмістен 4 жеті күміс болғаны жақсы.
Dialogue: 0,0:21:13.48,0:21:15.86,Default-ja,,0,0,0,,Сіз өзіңіздің қарсыласыңыздың пікіріне тосқауыл қоясыз!
Dialogue: 5,0:21:16.03,0:21:19.24,Default,,0,0,0,,Мен сіздің қарсыласыңыздың бірге ойнайтынына кепілдік жоқ деп айтамын!
Dialogue: 0,0:21:16.15,0:21:19.07,Default-ja,,0,0,0,,Сондықтан бұл міндетті түрде тыныштықпен келмейді.
Dialogue: 0,0:21:19.15,0:21:21.66,Default-ja,,0,0,0,,Сонда да 47 күміс қате емес.
Dialogue: 5,0:21:19.24,0:21:21.70,Default,,0,0,0,,Сонда да, S-4g қате емес!
Dialogue: 5,0:21:21.70,0:21:24.02,Default,,0,0,0,,Шогиге келетін болсақ, бұл дұрыс!
Dialogue: 0,0:21:21.74,0:21:24.24,Default-ja,,0,0,0,,Бұл шоги үшін дұрыс пішін.
Dialogue: 5,0:21:29.52,0:21:30.32,Default,,0,0,0,,Құрсын.
Dialogue: 0,0:21:29.75,0:21:31.79,Default-ja,,0,0,0,,Тақсыр, менде тақта болса ғой...
Dialogue: 5,0:21:30.66,0:21:34.69,Default,,0,0,0,,Бұл жерде жай ғана тақта болса, мен сіздің таяз ойыңызды оңай түзетер едім.
Dialogue: 0,0:21:31.88,0:21:34.67,Default-ja,,0,0,0,,Мен сіздің таяз ойыңызды түзете аламын.
Dialogue: 5,0:21:34.69,0:21:38.53,Default,,0,0,0,,Міне, Кирияма! Сенің жеріңе барып, оны шығарып алайық.
Dialogue: 0,0:21:34.80,0:21:35.96,Default-ja,,0,0,0,,Иә, Кирияма.
Dialogue: 0,0:21:36.05,0:21:38.42,Default-ja,,0,0,0,,Енді сіздердің орындарыңызда егжей-тегжейлі талқылайық.
Dialogue: 0,0:21:38.51,0:21:39.88,Default-ja,,0,0,0,,Күте тұрыңыз... Айтайын дегенім...
Dialogue: 5,0:21:38.53,0:21:39.78,Default,,0,0,0,,Не? Бір секунд күтіңіз!
Dialogue: 5,0:21:39.78,0:21:43.80,Default,,0,0,0,,Ойланып қарасам, біз менің көпқабатты үйімнің алдында тұрмыз!
Dialogue: 0,0:21:39.97,0:21:41.72,Default-ja,,0,0,0,,Иә? Бұл туралы айтатын болсақ ...
Dialogue: 0,0:21:41.80,0:21:43.68,Default-ja,,0,0,0,,Ол қазірдің өзінде менің алдымда тұр.
Dialogue: 0,0:21:43.76,0:21:45.43,Default-ja,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 5,0:21:43.80,0:21:45.29,Default,,0,0,0,,Неге менің артымнан мұнда келдің?!
Dialogue: 5,0:21:45.29,0:21:47.14,Default,,0,0,0,,Мен бұған ешқашан келіспедім!
Dialogue: 0,0:21:45.51,0:21:47.73,Default-ja,,0,0,0,,Ешқандай келісім алынған жоқ! (судың дыбысы)
Dialogue: 5,0:21:55.22,0:21:57.84,Default,,0,0,0,,S-4g бастап N-3g...
Dialogue: 5,0:21:58.21,0:22:02.14,Default,,0,0,0,,Мен әлі де S-4g-ден S-3f-ге барар едім.
Dialogue: 0,0:21:58.24,0:22:02.32,Default-ja,,0,0,0,,Сонда да 47 күмістен 36 күміске дейін.
Dialogue: 5,0:22:11.55,0:22:13.88,Default,,0,0,0,,Күте тұрыңыз, ол құс әлі көтерілген жоқ!
Dialogue: 0,0:22:11.58,0:22:13.83,Default-ja,,0,0,0,,...Дәлірек айтсақ, бұрынғы құс қалқып кетпеді ғой, солай ма?
Dialogue: 5,0:22:13.88,0:22:16.11,Default,,0,0,0,,Ол жай ғана құлап, қайта көтерілмеді, солай ма?!
Dialogue: 0,0:22:13.92,0:22:16.05,Default-ja,,0,0,0,,Жаңа ғана сүңгіп кеткен құс шықпады.
Dialogue: 5,0:22:16.11,0:22:18.55,Default,,0,0,0,,Не?! Құстар қанша уақыт астында тұра алады?!
Dialogue: 0,0:22:16.13,0:22:18.59,Default-ja,,0,0,0,,Иә! Құстар қаншалықты тереңдей алады?
Dialogue: 5,0:22:18.55,0:22:20.36,Default,,0,0,0,,Н-Олар демдерін қанша уақыт ұстай алады?!
Dialogue: 0,0:22:18.67,0:22:20.34,Default-ja,,0,0,0,,Тыныс алу туралы не айтасыз? Эй, жақсысың ба?
Dialogue: 5,0:22:20.36,0:22:21.21,Default,,0,0,0,,Неге?!
Dialogue: 0,0:22:20.42,0:22:22.26,Default-ja,,0,0,0,,Неліктен? (Никаидо) Қорқынышты...
Dialogue: 5,0:22:21.21,0:22:22.39,Default,,0,0,0,,Өте қорқынышты!
Dialogue: 0,0:22:22.34,0:22:23.84,Default-ja,,0,0,0,,Мен ешқашан балық жейді деп ойламадым...
Dialogue: 5,0:22:22.39,0:22:23.87,Default,,0,0,0,,Оны балық жеді демей ме?!
Dialogue: 0,0:22:24.30,0:22:25.47,Default-ja,,0,0,0,,♬~
Dialogue: 5,0:22:24.82,0:22:25.37,Default,,0,0,0,,Қайырлы таң!
Dialogue: 5,0:22:25.37,0:22:27.37,Default,,0,0,0,,Оларда бар. Және дәл тіркеуден!
Dialogue: 0,0:22:25.55,0:22:27.39,Default-ja,,0,0,0,,Бұл болды! Ал кассаның алдында
Dialogue: 5,0:22:27.37,0:22:30.04,Default,,0,0,0,,Өзендегі қаладағы кітап дүкені көңіл көншітпейді!
Dialogue: 0,0:22:27.47,0:22:29.85,Default-ja,,0,0,0,,Күрсіну... Өзен жағасындағы қаладағы кітап дүкенінен күткендей.
Dialogue: 0,0:22:30.02,0:22:31.31,Default-ja,,0,0,0,,Қажеттіліктер болуы керек.
Dialogue: 5,0:22:30.04,0:22:31.38,Default,,0,0,0,,Оған сұраныс болу керек.
Dialogue: 5,0:22:31.38,0:22:32.25,Default,,0,0,0,,Қарға!
Dialogue: 0,0:22:31.77,0:22:34.40,Default-ja,,0,0,0,,Қарғыс атсын, сен сондай жиіркеніштісің!
Dialogue: 5,0:22:32.60,0:22:34.39,Default,,0,0,0,,Неше түрлі түрі бар ма?!
Dialogue: 5,0:22:34.39,0:22:36.01,Default,,0,0,0,,Қайсысын көрдік?!
Dialogue: 0,0:22:34.52,0:22:35.94,Default-ja,,0,0,0,,Бұл кім? Бұрынғы жігіт
Dialogue: 5,0:22:36.01,0:22:36.81,Default,,0,0,0,,Мынау?
Dialogue: 0,0:22:36.02,0:22:36.86,Default-ja,,0,0,0,,Бұл емес пе?
Dialogue: 5,0:22:36.81,0:22:39.22,Default,,0,0,0,,Идиот! Біз көрген құс қара екен!
Dialogue: 0,0:22:36.94,0:22:39.11,Default-ja,,0,0,0,,Идиот, қара еді! Бұрынғы құс
Dialogue: 0,0:22:39.19,0:22:40.36,Default-ja,,0,0,0,,Және мұқият оқыңыз!
Dialogue: 5,0:22:39.22,0:22:43.14,Default,,0,0,0,,Ал егер сіз оны оқысаңыз, қанаттары 92-ден 105 сантиметрге дейін дейді!
Dialogue: 0,0:22:40.44,0:22:43.16,Default-ja,,0,0,0,,Қанаттардың кеңдігі: 92 см-ден 105 см-ге дейін
Dialogue: 5,0:22:43.14,0:22:45.64,Default,,0,0,0,,Қатты айқайлағаны үшін бұл үлкен емес еді!
Dialogue: 0,0:22:43.24,0:22:45.62,Default-ja,,0,0,0,,Бұл соншалықты үлкен емес еді, солай ма?
Dialogue: 5,0:22:47.14,0:22:49.61,Default,,0,0,0,,Жарайды! Өзен жағасына қайтайық!
Dialogue: 0,0:22:47.20,0:22:49.58,Default-ja,,0,0,0,,Жарайды, тағы да өзен жағасына қайтайық!
Dialogue: 5,0:22:49.61,0:22:50.65,Default,,0,0,0,,Біз көргенімізді растаймыз!
Dialogue: 0,0:22:49.66,0:22:50.58,Default-ja,,0,0,0,,Көрнекі растау!
Dialogue: 5,0:22:50.65,0:22:52.65,Default,,0,0,0,,Иә! Роджер, Кирияма!
Dialogue: 0,0:22:50.66,0:22:52.46,Default-ja,,0,0,0,,О, түсіндім, Кирияма.
Dialogue: 5,0:22:52.65,0:22:56.46,Default,,0,0,0,,Қарға! Мен мұның түбіне жетемін! Мен оның жеке басын ашамын деп ант етемін!
Dialogue: 0,0:22:52.79,0:22:53.92,Default-ja,,0,0,0,,Қарғыс атсын, мен оны ашамын!
Dialogue: 0,0:22:54.00,0:22:56.38,Default-ja,,0,0,0,,Мен оның шын тұлғасын міндетті түрде анықтаймын!
Dialogue: 5,0:22:56.46,0:22:57.86,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:22:56.46,0:22:57.63,Default-ja,,0,0,0,,Жарайды!
Dialogue: 0,0:22:58.53,0:23:01.03,titles,,0,0,0,,Төбеге көтерілу
Dialogue: 0,0:23:10.53,0:23:18.05,ED,,0,0,0,,Саусақтарың, кеуделерің, көздерің
Dialogue: 1,0:23:10.53,0:23:18.05,ED,,0,0,0,,Саусақтарың, кеуделерің, көздерің
Dialogue: 0,0:23:19.67,0:23:27.27,ED,,0,0,0,,Таң қалдырғаны сонша, менің басым айналатын түндер болады
Dialogue: 1,0:23:19.67,0:23:27.27,ED,,0,0,0,,Таң қалдырғаны сонша, менің басым айналатын түндер болады
Dialogue: 0,0:23:28.29,0:23:30.90,ED,,0,0,0,,Олар кенеттен менің үстімнен құлап кетті, бұл өте жылы
Dialogue: 1,0:23:28.29,0:23:30.90,ED,,0,0,0,,Олар кенеттен менің үстімнен құлап кетті, бұл өте жылы
Dialogue: 0,0:23:30.90,0:23:33.90,ED,,0,0,0,,Олар кенеттен менің үстімнен құлап кетті, бұл өте жылы
Dialogue: 1,0:23:30.90,0:23:33.90,ED,,0,0,0,,Олар кенеттен менің үстімнен құлап кетті, бұл өте жылы
Dialogue: 0,0:23:33.90,0:23:37.69,ED,,0,0,0,,Мен жеті түсті жұлдызды жұтқандай болдым
Dialogue: 1,0:23:33.90,0:23:37.69,ED,,0,0,0,,Мен жеті түсті жұлдызды жұтқандай болдым
Dialogue: 0,0:23:37.69,0:23:43.37,ED,,0,0,0,,Сіз мені қатты ұстадыңыз, жанып тұрған ұшқын сияқты мені алаңдатты
Dialogue: 1,0:23:37.69,0:23:43.37,ED,,0,0,0,,Сіз мені қатты ұстадыңыз, жанып тұрған ұшқын сияқты мені алаңдатты
Dialogue: 0,0:23:43.37,0:23:44.58,ED,,0,0,0,,Бірақ маған бәріне қарамастан жүруді үйретті
Dialogue: 1,0:23:43.37,0:23:44.58,ED,,0,0,0,,Бірақ маған бәріне қарамастан жүруді үйретті
Dialogue: 0,0:23:44.58,0:23:51.04,ED,,0,0,0,,Бірақ маған бәріне қарамастан жүруді үйретті
Dialogue: 1,0:23:44.58,0:23:51.04,ED,,0,0,0,,Бірақ маған бәріне қарамастан жүруді үйретті
Dialogue: 0,0:24:00.26,0:24:06.20,ED,,0,0,0,,Құдай, мені тыңдашы
Dialogue: 1,0:24:00.26,0:24:06.20,ED,,0,0,0,,Құдай, мені тыңдашы
Dialogue: 0,0:24:06.20,0:24:09.29,ED,,0,0,0,,Біраз уақытқа
Dialogue: 1,0:24:06.20,0:24:09.29,ED,,0,0,0,,Біраз уақытқа
Dialogue: 0,0:24:09.29,0:24:13.08,ED,,0,0,0,,Бізді сол шоқжұлдыз сияқты байланыстырыңыз
Dialogue: 1,0:24:09.29,0:24:13.08,ED,,0,0,0,,Бізді сол шоқжұлдыз сияқты байланыстырыңыз
Dialogue: 0,0:24:13.08,0:24:18.26,ED,,0,0,0,,Ешқашан бір-бірімізден алшақ болмас үшін
Dialogue: 1,0:24:13.08,0:24:18.26,ED,,0,0,0,,Ешқашан бір-бірімізден алшақ болмас үшін
Dialogue: 0,0:24:19.76,0:24:21.95,ED,,0,0,0,,Біз әрқашан біргеміз
Dialogue: 1,0:24:19.76,0:24:21.95,ED,,0,0,0,,Біз әрқашан біргеміз
Dialogue: 0,0:24:31.00,0:24:33.00,titles,,0,0,0,,Келесі эпизодты алдын ала қарау
Dialogue: 5,0:24:33.00,0:24:35.25,Default,,0,0,0,,Кёуконың жағдайы қалай?
Dialogue: 0,0:24:33.00,0:24:51.02,signs,,0,0,0,,17-серия
Dialogue: 1,0:24:33.00,0:24:51.02,signs,,0,0,0,,17-серия
Dialogue: 0,0:24:33.14,0:24:34.98,Default-ja,,0,0,0,,Коко... қалай?
Dialogue: 5,0:24:35.25,0:24:36.64,Default,,0,0,0,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:24:35.31,0:24:36.60,Default-ja,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 5,0:24:36.64,0:24:38.85,Default,,0,0,0,,Ол бақшада болды.
Dialogue: 0,0:24:36.69,0:24:38.77,Default-ja,,0,0,0,,Бұл жігіт бақшада болды.
Dialogue: 5,0:24:38.85,0:24:40.34,Default,,0,0,0,,Ішке кіріңіз.
Dialogue: 0,0:24:38.94,0:24:40.19,Default-ja,,0,0,0,,Тез кіріңіз.
Dialogue: 5,0:24:40.34,0:24:43.65,Default,,0,0,0,,Никайду сіздің келуіңізді тағатсыздана күтті.
Dialogue: 0,0:24:40.40,0:24:43.40,Default-ja,,0,0,0,,Никайдо сізді біраздан бері күтіп отыр.
Dialogue: 5,0:24:43.65,0:24:47.18,Default,,0,0,0,,Мен бірге матч болатын күнді күтемін.
Dialogue: 0,0:24:43.73,0:24:46.99,Default-ja,,0,0,0,,Мен тікелей қарсыласуды асыға күтемін.
Dialogue: 5,0:24:47.18,0:24:48.79,Default,,0,0,0,,Дұрыс, бәсекелес пе?
Dialogue: 0,0:24:47.28,0:24:48.41,Default-ja,,0,0,0,,Сәлем, қарсылас
Dialogue: 5,0:24:48.79,0:24:51.02,Default,,0,0,0,,Сіз мені әкеме ұрдыңыз, солай емес пе?
Dialogue: 0,0:24:48.86,0:24:51.03,Default-ja,,0,0,0,,Әкеңе қажет емес нәрсе айттың.
Dialogue: 0,0:24:51.02,0:25:01.03,signs,,0,0,0,,Сурет: Кудоу Норико
Dialogue: 1,0:24:51.02,0:25:01.03,signs,,0,0,0,,Сурет: Кудоу Норико
Dialogue: 2,0:24:51.02,0:25:01.03,signs,,0,0,0,,Сурет: Кудоу Норико
Dialogue: 0,0:24:51.70,0:24:54.37,Default-ja,,0,0,0,,Наурыз арыстандай келеді Келесі кездескенше.
Dialogue: 5,0:24:51.76,0:24:54.45,Default,,0,0,0,,«Наурыз арыстандай кіріп келеді» фильмінің келесі бөлімін де көріңіз!
Dialogue: 5,0:24:54.45,0:24:56.99,Default,,0,0,0,,Бала қолынан келгеннің бәрін жасайды!
Dialogue: 0,0:24:54.45,0:24:56.91,Default-ja,,0,0,0,,Уау, монах қатты жұмыс істеп жатыр.
Dialogue: 5,0:24:56.99,0:24:59.01,Default,,0,0,0,,Ыстық қарғыс атқыр!
Dialogue: 0,0:24:57.00,0:24:58.96,Default-ja,,0,0,0,,Кончикишо
