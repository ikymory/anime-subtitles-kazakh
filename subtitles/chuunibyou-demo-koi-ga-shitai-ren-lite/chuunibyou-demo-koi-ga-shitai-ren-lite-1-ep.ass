Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:11.60,0:00:16.11,opj,NTP,0000,0000,0000,,Бұл дүниедегі кішкентай жерде
Dialogue: 1,0:00:16.84,0:00:20.96,opj,NTP,0000,0000,0000,,Сол күні мен сені таптым
Dialogue: 1,0:00:21.98,0:00:26.78,opj,NTP,0000,0000,0000,,Желмен күлдіңіз
Dialogue: 1,0:00:27.18,0:00:31.07,opj,NTP,0000,0000,0000,,Менің жүрегім боялған
Dialogue: 1,0:00:32.35,0:00:37.10,opj,NTP,0000,0000,0000,,Қаншалықты жақын болсаңыз да
Dialogue: 1,0:00:37.50,0:00:42.17,opj,NTP,0000,0000,0000,,Мен өз сезімімді жеткізе алмаймын.
Dialogue: 1,0:00:42.67,0:00:50.07,opj,NTP,0000,0000,0000,,Қанша алыс жүрсек те, мен өз ойымды өзгертпеймін
Dialogue: 1,0:00:50.28,0:00:52.59,opj,NTP,0000,0000,0000,,Тағдыр және мәңгілік
Dialogue: 1,0:00:52.73,0:00:54.89,opj,NTP,0000,0000,0000,,Сынса да, Жаныңда боламын
Dialogue: 1,0:00:54.89,0:01:00.37,opj,NTP,0000,0000,0000,,Мен сені ертеңнен гөрі қазір жақсы көремін
Dialogue: 1,0:01:00.76,0:01:05.66,opj,NTP,0000,0000,0000,,Ақыр аяғы болды, неге келмейсің?
Dialogue: 1,0:01:05.88,0:01:10.36,opj,NTP,0000,0000,0000,,Әдемі немесе әдемі болу міндетті емес.
Dialogue: 1,0:01:10.43,0:01:15.86,opj,NTP,0000,0000,0000,,Мен сені есінен танғанша жақсы көрейін
Dialogue: 1,0:01:16.21,0:01:18.49,opj,NTP,0000,0000,0000,,Сол күнгі сөздерді ұмытпаймын
Dialogue: 1,0:01:18.65,0:01:26.70,opj,NTP,0000,0000,0000,,Ұмытылмас адамға жетсе екен деймін.
Dialogue: 0,0:01:31.33,0:01:32.20,Default,,0000,0000,0000,,Сәттілік~
Dialogue: 0,0:01:34.54,0:01:35.03,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:01:35.99,0:01:36.38,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:01:36.52,0:01:37.73,Default,,0000,0000,0000,,Которию-сан өтінемін
Dialogue: 0,0:01:42.29,0:01:43.95,Default,,0000,0000,0000,,Жарайды, Которию-сан.
Dialogue: 0,0:01:44.70,0:01:47.23,Default,,0000,0000,0000,,Көзілдірікті кию қауіпті.
Dialogue: 0,0:01:47.63,0:01:48.87,Default,,0000,0000,0000,,Сізге демалу керек.
Dialogue: 0,0:01:49.40,0:01:49.92,Default,,0000,0000,0000,,Мен жақсымын
Dialogue: 0,0:01:50.37,0:01:53.29,Default,,0000,0000,0000,,Бұл зұлым патша Шинганның күшін ғана басады.
Dialogue: 0,0:01:53.80,0:01:56.91,Default,,0000,0000,0000,,Қуатыңызды сәл ғана босатып алсаңыз, еш қиындық жоқ.
Dialogue: 0,0:01:57.44,0:01:58.64,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:01:59.75,0:02:00.98,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:03.76,0:02:05.38,Default,,0000,0000,0000,,Юта...кеңес...
Dialogue: 0,0:02:06.49,0:02:08.07,Default,,0000,0000,0000,,Мен не айтып тұрғанымды білемін.
Dialogue: 0,0:02:08.61,0:02:10.31,Default,,0000,0000,0000,,Менің ойымша, сіз волейболда жақсырақ болғыңыз келеді.
Dialogue: 0,0:02:11.81,0:02:13.56,Default,,0000,0000,0000,,Мүмкін мен сіздің ойларыңызды оқыған шығармын!
Dialogue: 0,0:02:14.05,0:02:15.83,Default,,0000,0000,0000,,Сізді түсіну өте оңай!
Dialogue: 0,0:02:16.51,0:02:19.31,Default,,0000,0000,0000,,Қалай болғанда да, алдымен таңғышты алып тастау керек.
Dialogue: 0,0:02:19.82,0:02:20.39,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,0:02:21.02,0:02:24.43,Default,,0000,0000,0000,,Юта, менің құшағымда жасырылған күшті босат...
Dialogue: 0,0:02:24.88,0:02:26.25,Default,,0000,0000,0000,,Қараңғы жақтау шебері ретінде
Dialogue: 0,0:02:26.33,0:02:28.68,Default,,0000,0000,0000,,Бірге әлемді жойылу жолына шақырайық!
Dialogue: 0,0:02:28.85,0:02:30.16,Default,,0000,0000,0000,,Жарайды, шеш!
Dialogue: 0,0:02:30.52,0:02:34.01,Default,,0000,0000,0000,,Дене шынықтыру сабағына кім осындай киім киеді?
Dialogue: 0,0:02:34.31,0:02:35.66,Default,,0000,0000,0000,,О, күте тұрыңыз! Юта!
Dialogue: 0,0:02:36.07,0:02:38.14,Default,,0000,0000,0000,,Оның астында қарғыс белгісі бар...!
Dialogue: 0,0:02:39.70,0:02:42.29,Default,,0000,0000,0000,,Сиқырдың... қансырап тұр.
Dialogue: 0,0:02:42.78,0:02:47.65,Default,,0000,0000,0000,,Ах~ Не жазсам да дақ түсірмейді деп жаздым.
Dialogue: 0,0:02:48.03,0:02:49.36,Default,,0000,0000,0000,,Адамның терісі басқаша шығар...
Dialogue: 0,0:02:49.91,0:02:50.87,Default,,0000,0000,0000,,Содан кейін көзге арналған патч
Dialogue: 0,0:02:51.39,0:02:53.67,Default,,0000,0000,0000,,Екі көзді де қолданбасаңыз, қашықтықты анықтау қиын болады.
Dialogue: 0,0:02:54.33,0:02:55.25,Default,,0000,0000,0000,,Бұл жақсы емес!
Dialogue: 0,0:02:55.34,0:02:56.32,Default,,0000,0000,0000,,Қауіпті~
Dialogue: 0,0:03:02.88,0:03:04.19,Default,,0000,0000,0000,,Юта ауырады...
Dialogue: 0,0:03:04.76,0:03:05.55,Default,,0000,0000,0000,,Сондықтан мен айттым
Dialogue: 0,0:03:05.61,0:03:06.48,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:03:07.15,0:03:08.13,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:03:09.74,0:03:12.59,Default,,0000,0000,0000,,Керек болса, көзді таңғышпен жаттығу жасаңыз.
Dialogue: 0,0:03:13.26,0:03:14.04,Default,,0000,0000,0000,,Бұл қиын!
Dialogue: 0,0:03:14.55,0:03:15.16,Default,,0000,0000,0000,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:03:15.91,0:03:16.76,Default,,0000,0000,0000,,Ал, кеттік.
Dialogue: 0,0:03:17.35,0:03:17.71,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:03:18.22,0:03:20.09,Default,,0000,0000,0000,,Белді байлаңыз! Допты мұқият қадағалаңыз!
Dialogue: 0,0:03:22.43,0:03:22.96,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:03:23.53,0:03:24.17,Default,,0000,0000,0000,,Капипа
Dialogue: 0,0:03:25.34,0:03:25.56,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:03:26.93,0:03:28.63,Default,,0000,0000,0000,,Evilvine - Төртінші нұсқа
Dialogue: 0,0:03:29.22,0:03:29.61,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:03:30.35,0:03:33.04,Default,,0000,0000,0000,,Shibarak‧Stick‧Prostime‧Марк Екі
Dialogue: 0,0:03:33.44,0:03:38.51,Default,,0000,0000,0000,,Уа-у-у-у-у-у
Dialogue: 0,0:03:38.61,0:03:39.40,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:40.04,0:03:40.72,Default,,0000,0000,0000,,Өте айналу
Dialogue: 0,0:03:41.10,0:03:42.78,Default,,0000,0000,0000,,Енді сіз жауды толығымен жеңе аласыз!
Dialogue: 0,0:03:43.28,0:03:44.70,Default,,0000,0000,0000,,Аяқ киім мен қолшатырға рұқсат етілмейді!
Dialogue: 0,0:03:51.27,0:03:53.13,Default,,0000,0000,0000,,Енді мен мұны қалай да жасай аламын.
Dialogue: 0,0:03:53.80,0:03:54.44,Default,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:03:55.07,0:03:56.49,Default,,0000,0000,0000,,Жақсы, егер бұл бәрібір клубтық әрекет болса.
Dialogue: 0,0:03:56.93,0:04:00.55,Default,,0000,0000,0000,,Егер сіз мұны дене шынықтыру сабағында орындай алсаңыз, сіз ешқандай қиындық тудырмайсыз.
Dialogue: 0,0:04:01.26,0:04:01.61,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:04.37,0:04:08.91,Default,,0000,0000,0000,,Барлығы ~ Бүгіннен бастап біз сабақта волейболдың орнына баскетбол ойнайтын боламыз.
Dialogue: 0,0:04:09.15,0:04:10.07,Default,,0000,0000,0000,,Допты шығару
Dialogue: 0,0:04:12.00,0:04:12.60,Default,,0000,0000,0000,,Юта!
Dialogue: 0,0:04:14.50,0:04:15.31,Default,,0000,0000,0000,,Мен енді білмеймін
Dialogue: 0,0:04:16.81,0:04:22.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory