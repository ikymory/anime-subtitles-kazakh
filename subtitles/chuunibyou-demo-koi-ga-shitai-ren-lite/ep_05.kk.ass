Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:00:11.31,0:00:15.82,opj,NTP,0000,0000,0000,,Бұл дүниедегі кішкентай жерде
Dialogue: 1,0:00:16.55,0:00:20.67,opj,NTP,0000,0000,0000,,Сол күні мен сені таптым
Dialogue: 1,0:00:21.69,0:00:26.49,opj,NTP,0000,0000,0000,,Желмен күлдіңіз
Dialogue: 1,0:00:26.89,0:00:30.78,opj,NTP,0000,0000,0000,,Менің жүрегім боялған
Dialogue: 1,0:00:32.06,0:00:36.81,opj,NTP,0000,0000,0000,,Қаншалықты жақын болсаңыз да
Dialogue: 1,0:00:37.21,0:00:41.88,opj,NTP,0000,0000,0000,,Мен өз сезімімді жеткізе алмаймын.
Dialogue: 1,0:00:42.38,0:00:49.78,opj,NTP,0000,0000,0000,,Қанша алыс жүрсек те, мен өз ойымды өзгертпеймін
Dialogue: 1,0:00:49.99,0:00:52.30,opj,NTP,0000,0000,0000,,Тағдыр және мәңгілік
Dialogue: 1,0:00:52.44,0:00:54.60,opj,NTP,0000,0000,0000,,Сынса да, Жаныңда боламын
Dialogue: 1,0:00:54.60,0:01:00.08,opj,NTP,0000,0000,0000,,Мен сені ертеңнен гөрі қазір жақсы көремін
Dialogue: 1,0:01:00.47,0:01:05.37,opj,NTP,0000,0000,0000,,Ақыр аяғы болды, неге келмейсің?
Dialogue: 1,0:01:05.59,0:01:10.07,opj,NTP,0000,0000,0000,,Әдемі немесе әдемі болу міндетті емес.
Dialogue: 1,0:01:10.14,0:01:15.57,opj,NTP,0000,0000,0000,,Мен сені есінен танғанша жақсы көрейін
Dialogue: 1,0:01:15.92,0:01:18.20,opj,NTP,0000,0000,0000,,Сол күнгі сөздерді ұмытпаймын
Dialogue: 1,0:01:18.36,0:01:26.41,opj,NTP,0000,0000,0000,,Ұмытылмас адамға жетсе екен деймін.
Dialogue: 0,0:01:31.42,0:01:32.58,Default,,0000,0000,0000,,Әзірге екеумізді де емес
Dialogue: 0,0:01:33.32,0:01:35.88,Default,,0000,0000,0000,,Менің атым ТУЮРИ Кумин.
Dialogue: 0,0:01:36.40,0:01:39.47,Default,,0000,0000,0000,,7 мамыр деп жазылып, ЦЮЮРИ болып оқылады.
Dialogue: 0,0:01:39.93,0:01:42.51,Default,,0000,0000,0000,,Бірақ менің туған күнім, өкінішке орай, қазан айында.
Dialogue: 0,0:01:43.50,0:01:46.00,Default,,0000,0000,0000,,Менің хоббиім - ұйықтау.
Dialogue: 0,0:01:46.55,0:01:48.85,Default,,0000,0000,0000,,Әсіресе ұйықтау керемет
Dialogue: 0,0:01:49.42,0:01:51.59,Default,,0000,0000,0000,,Бұған ештеңе жетпейді
Dialogue: 0,0:01:52.30,0:01:55.20,Default,,0000,0000,0000,,Сонымен мен ұйықтау клубын құрдым.
Dialogue: 0,0:01:55.98,0:01:59.51,Default,,0000,0000,0000,,Оған көп нәрсе қосылған, бірақ бұл негізінен ұйықтау бөлімі.
Dialogue: 0,0:01:59.99,0:02:01.58,Default,,0000,0000,0000,,Кейбір мүшелер бірінші курс студенттері.
Dialogue: 0,0:02:02.70,0:02:03.51,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:02:04.83,0:02:08.66,Default,,0000,0000,0000,,Мен мұнда күнделікті үйірме жұмыстарын жүргізу үшін келемін.
Dialogue: 0,0:02:09.24,0:02:10.67,Default,,0000,0000,0000,,Әрине, бұл ұйықтау.
Dialogue: 0,0:02:12.09,0:02:13.26,Default,,0000,0000,0000,,Бұл жастық
Dialogue: 0,0:02:13.93,0:02:17.74,Default,,0000,0000,0000,,Жыл мезгіліне, ауа райына және сол күнгі көңіл-күйіңізге байланысты пайдаланыңыз.
Dialogue: 0,0:02:18.35,0:02:20.20,Default,,0000,0000,0000,,Ұйқыға қажетті элемент
Dialogue: 0,0:02:21.24,0:02:23.09,Default,,0000,0000,0000,,Әрі қарай, қайда ұйықтау керектігін шешіңіз
Dialogue: 0,0:02:23.85,0:02:25.56,Default,,0000,0000,0000,,Терезелерді ашу және жабу да маңызды
Dialogue: 0,0:02:25.97,0:02:28.88,Default,,0000,0000,0000,,Жағымды самал ұйықтауға өте ыңғайлы.
Dialogue: 0,0:02:29.18,0:02:31.38,Default,,0000,0000,0000,,Қатты болса, суық тиіп қаларсың.
Dialogue: 0,0:02:32.18,0:02:35.01,Default,,0000,0000,0000,,Күн үшін де солай. Түстен кейінгі күннің әсеріне тым көп алсаңыз.
Dialogue: 0,0:02:35.15,0:02:39.11,Default,,0000,0000,0000,,Сіз тозақ жағуды армандайтын шығарсыз, сондықтан абай болыңыз.
Dialogue: 0,0:02:40.11,0:02:41.72,Default,,0000,0000,0000,,Қайырлы түн
Dialogue: 0,0:02:42.95,0:02:45.84,Default,,0000,0000,0000,,Вис, тек қарт адамдар.
Dialogue: 0,0:02:47.61,0:02:49.05,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:02:49.71,0:02:51.78,Default,,0000,0000,0000,,Бұл адам ТОҒАШИ ЮТА.
Dialogue: 0,0:02:52.71,0:02:57.76,Default,,0000,0000,0000,,Ол маған ұйықтау клубын құруға көп көмектескен бірінші курс студенті болды.
Dialogue: 0,0:02:58.18,0:03:00.34,Default,,0000,0000,0000,,Мен қандай да бір себептермен клуб жұмысына теріс қараймын.
Dialogue: 0,0:03:01.21,0:03:03.89,Default,,0000,0000,0000,,Тоғашы-күн, бүгін ұйықтап алайық.
Dialogue: 0,0:03:04.14,0:03:05.07,Default,,0000,0000,0000,,Мен саған жастық беремін.
Dialogue: 0,0:03:05.33,0:03:06.84,Default,,0000,0000,0000,,Жоқ, мен.
Dialogue: 0,0:03:07.02,0:03:10.93,Default,,0000,0000,0000,,Дада дадан даттан даттан. . .
Dialogue: 0,0:03:11.36,0:03:13.47,Default,,0000,0000,0000,,Ол ДЕКОМОРИ САНАЕ
Dialogue: 0,0:03:14.26,0:03:16.32,Default,,0000,0000,0000,,Мен орта мектептің үшінші курс студентімін.
Dialogue: 0,0:03:16.65,0:03:18.01,Default,,0000,0000,0000,,Бөлімге кіру және шығу
Dialogue: 0,0:03:19.05,0:03:20.01,Default,,0000,0000,0000,,Бұл дөңес
Dialogue: 0,0:03:20.63,0:03:23.08,Default,,0000,0000,0000,,Бұл қанға боялған сүт.
Dialogue: 0,0:03:23.20,0:03:24.49,Default,,0000,0000,0000,,Ичигодайичиго
Dialogue: 0,0:03:25.05,0:03:26.88,Default,,0000,0000,0000,,Мен сүтті қатты жек көремін.
Dialogue: 0,0:03:27.34,0:03:30.51,Default,,0000,0000,0000,,Бірақ мен оны күнде ішемін, өйткені бойымды өсіргім келеді.
Dialogue: 0,0:03:31.31,0:03:32.49,Default,,0000,0000,0000,,Мен мұны жей аламын
Dialogue: 0,0:03:33.09,0:03:34.05,Default,,0000,0000,0000,,Бірақ бұған дейін осы жолы талқылауымыз керек бірнеше мәселе бар.
Dialogue: 0,0:03:40.57,0:03:42.35,Default,,0000,0000,0000,,Жоқ, қанның дәмі
Dialogue: 0,0:03:42.36,0:03:43.52,Default,,0000,0000,0000,,Менің ойымша, сондықтан
Dialogue: 0,0:03:44.07,0:03:46.37,Default,,0000,0000,0000,,Тогаши-кун кез келген нәрсені қағып алады.
Dialogue: 0,0:03:46.97,0:03:50.05,Default,,0000,0000,0000,,Мен жай ғана аулақ жүруге тырысамын. Бұл қиын.
Dialogue: 0,0:03:50.63,0:03:52.13,Default,,0000,0000,0000,,Осы жолы «өлім шеңберінен» аман қалған сияқтымын.
Dialogue: 0,0:03:52.63,0:03:56.83,Default,,0000,0000,0000,,Дәл, спортшыларды жағдайлар неге сонша мазалайды?
Dialogue: 0,0:03:57.47,0:03:59.81,Default,,0000,0000,0000,,Ол Нибутани Морика-чан
Dialogue: 0,0:04:00.65,0:04:02.71,Default,,0000,0000,0000,,Бірінші курстың өкілі
Dialogue: 0,0:04:03.01,0:04:06.34,Default,,0000,0000,0000,,Ол өте ақылды және танымал.
Dialogue: 0,0:04:07.50,0:04:09.27,Default,,0000,0000,0000,,Міне, жалған Мори мырза.
Dialogue: 0,0:04:09.86,0:04:11.16,Default,,0000,0000,0000,,Мори-сама, олай айтпа.
Dialogue: 0,0:04:11.65,0:04:13.27,Default,,0000,0000,0000,,Бірақ бұл жерде ол өзінің табиғи күйінде.
Dialogue: 0,0:04:13.27,0:04:14.38,Default,,0000,0000,0000,,Мені өлтіргің келе ме?
Dialogue: 0,0:04:14.44,0:04:16.94,Default,,0000,0000,0000,,Не керек, мен Деко-чанмен жақсы доспын.
Dialogue: 0,0:04:17.91,0:04:19.88,Default,,0000,0000,0000,,Қайырлы таң ұстаз
Dialogue: 0,0:04:20.46,0:04:23.37,Default,,0000,0000,0000,,Ал ол ТАКАНАШИ РИККА.
Dialogue: 0,0:04:23.98,0:04:25.94,Default,,0000,0000,0000,,Оның тылсым күштері бар сияқты.
Dialogue: 0,0:04:26.23,0:04:28.12,Default,,0000,0000,0000,,Мен қараңғыда заттарды көретін сияқтымын.
Dialogue: 0,0:04:28.59,0:04:30.39,Default,,0000,0000,0000,,Сізбен бірге болу қызық
Dialogue: 0,0:04:33.45,0:04:34.51,Default,,0000,0000,0000,,Сізге не керек?
Dialogue: 0,0:04:35.24,0:04:39.08,Default,,0000,0000,0000,,Шекараны қараңғы нәрсе басып алғанының белгілері бар.
Dialogue: 0,0:04:40.20,0:04:40.77,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:04:41.18,0:04:43.06,Default,,0000,0000,0000,,Иә, міндетті түрде дақ бар.
Dialogue: 0,0:04:43.24,0:04:44.65,Default,,0000,0000,0000,,Кешеден бері қосылған шығар.
Dialogue: 0,0:04:45.16,0:04:46.93,Default,,0000,0000,0000,,Үлкендеріңізбен де атқа мінбеңіздер.
Dialogue: 0,0:04:48.08,0:04:49.96,Default,,0000,0000,0000,,Тоғашы-күн атқа мінбейді.
Dialogue: 0,0:04:50.53,0:04:53.23,Default,,0000,0000,0000,,Бірақ мен оның мұны шынымен жасағысы келетінін сеземін.
Dialogue: 0,0:04:54.41,0:04:57.86,Default,,0000,0000,0000,,Қызметшінің міндеті – қожайынды қорғау.
Dialogue: 0,0:04:58.32,0:05:00.85,Default,,0000,0000,0000,,Нюрунир Харма
Dialogue: 0,0:05:01.34,0:05:03.37,Default,,0000,0000,0000,,Кішкене үндемеңіз.
Dialogue: 0,0:05:03.44,0:05:04.99,Default,,0000,0000,0000,,Жібер, жібер.
Dialogue: 0,0:05:05.29,0:05:08.63,Default,,0000,0000,0000,,Юута Қараңғылық күшін босатыңыз Шайқасқа дайындалыңыз
Dialogue: 0,0:05:08.92,0:05:09.57,Default,,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:05:09.66,0:05:13.75,Default,,0000,0000,0000,,Дәл солай, мұнда күнде қызық әрі көңілді.
Dialogue: 0,0:05:14.13,0:05:15.61,Default,,0000,0000,0000,,Кафедра құрылған күннен бастап
Dialogue: 0,0:05:15.86,0:05:19.45,Default,,0000,0000,0000,,Олар ешқашан ұйықтамайды.
Dialogue: 0,0:05:20.11,0:05:21.39,Default,,0000,0000,0000,,Жарайсың ба?
Dialogue: 0,0:05:22.89,0:05:28.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory