Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:42.66,0:00:43.91,Default,,0,0,0,,Юта
Dialogue: 0,0:00:45.46,0:00:46.83,Default,,0,0,0,,Сәлеметсіз бе, Студенттер кеңесінің төрағасы
Dialogue: 0,0:00:46.92,0:00:48.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:48.38,0:00:50.96,Default,,0,0,0,,Фуфуфуфуфуфу…
Dialogue: 0,0:00:53.13,0:00:54.51,Default,,0,0,0,,Жарайды
Dialogue: 0,0:00:55.18,0:00:56.84,Default,,0,0,0,,Мен тағы да айтамын
Dialogue: 0,0:00:56.93,0:00:59.85,Default,,0,0,0,,Маған Рикканың жауабын айтыңыз.
Dialogue: 0,0:01:00.51,0:01:03.73,Default,,0,0,0,,Я, сенің жауабыңды тыңдауға рұқсат етіңізші!
Dialogue: 0,0:01:04.52,0:01:06.14,Default,,0,0,0,,Мен байыппен тыңдаймын.
Dialogue: 0,0:01:07.65,0:01:09.44,Default,,0,0,0,,Мен олай айта алмаймын.
Dialogue: 0,0:01:10.19,0:01:11.90,Default,,0,0,0,,- (Юта) Жарайды, маған жауап бер - (Рикка) А!
Dialogue: 0,0:01:11.98,0:01:14.03,Default,,0,0,0,,Мен сізге бұрын айтқанмын!
Dialogue: 0,0:01:14.11,0:01:16.82,Default,,0,0,0,,Формула өзгеріссіз қалды, тек сандар өзгертілді.
Dialogue: 0,0:01:16.91,0:01:20.45,Default,,0,0,0,,13 жақсы емес Мен қараңғылық толқындарын сеземін
Dialogue: 0,0:01:21.37,0:01:23.66,Default,,0,0,0,,Қараңғы кардинал мен Сенат
Dialogue: 0,0:01:23.75,0:01:25.79,Default,,0,0,0,,№ 30 жоба
Dialogue: 0,0:01:26.37,0:01:29.08,Default,,0,0,0,,- (Рикка) Бұл сан... - (Юта) Сонда 14 жақсы.
Dialogue: 0,0:01:29.17,0:01:31.34,Default,,0,0,0,,Бұл сан да жақсы емес.
Dialogue: 0,0:01:31.42,0:01:34.63,Default,,0,0,0,,Ежелден келе жатқан варварлардың шақыру рәсімі бойынша...
Dialogue: 0,0:01:34.71,0:01:36.09,Default,,0,0,0,,Сонымен 15 ше?
Dialogue: 0,0:01:36.17,0:01:37.09,Default,,0,0,0,,Айдың айналасында...
Dialogue: 0,0:01:37.18,0:01:38.09,Default,,0,0,0,,16
Dialogue: 0,0:01:38.18,0:01:39.47,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:01:40.05,0:01:42.06,Default,,0,0,0,,Скилла жауап бергісі келеді
Dialogue: 0,0:01:42.14,0:01:43.56,Default,,0,0,0,,(Скилланың айқайы)
Dialogue: 0,0:01:43.64,0:01:45.48,Default,,0,0,0,,Мұнда не әкелесің?
Dialogue: 0,0:01:45.56,0:01:50.19,Default,,0,0,0,,Неліктен көктемгі демалыс болса да мұны істеуіміз керек?
Dialogue: 0,0:01:50.27,0:01:52.36,Default,,0,0,0,,- (Юта) Сенің қолыңнан келмейді, солай ма? - (Рикка) Ах!
Dialogue: 0,0:01:54.03,0:01:57.82,Default,,0,0,0,,Мен неге бұл жігітке ғашық болдым?
Dialogue: 0,0:02:01.20,0:02:03.03,Default,,0,0,0,,Бұл ерекше бонус.
Dialogue: 0,0:02:03.12,0:02:03.49,Default,,0,0,0,,Рикка да қорытынды емтиханда көп қызыл баға алды.
Dialogue: 0,0:02:03.49,0:02:06.00,Default,,0,0,0,,Рикка да қорытынды емтиханда көп қызыл баға алды.
Dialogue: 0,0:02:03.49,0:02:06.00,Default,,0,0,0,,- (Рикка) Хмм - (Юта) Ия...
Dialogue: 0,0:02:06.00,0:02:06.62,Default,,0,0,0,,Рикка да қорытынды емтиханда көп қызыл баға алды.
Dialogue: 0,0:02:06.70,0:02:10.50,Default,,0,0,0,,Қосымша сабақтардан кейін мен әйтеуір бір дәрежеге көтерілетін сияқты болдым.
Dialogue: 0,0:02:10.58,0:02:12.42,Default,,0,0,0,,Айтпақшы, Которию-сан
Dialogue: 0,0:02:13.25,0:02:16.97,Default,,0,0,0,,Сіз үшінші курс студенті болған кезде көзге арналған патчыңызды алып тастайсыз ба?
Dialogue: 0,0:02:17.92,0:02:19.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:19.22,0:02:22.43,Default,,0,0,0,,Кешіріңіз, мен мұны істей алмаймын.
Dialogue: 0,0:02:22.51,0:02:25.77,Default,,0,0,0,,Желпілдеген белдемше де мектеп ережелеріне қайшы.
Dialogue: 0,0:02:25.85,0:02:28.69,Default,,0,0,0,,Бұл да менің саясатым.
Dialogue: 0,0:02:28.77,0:02:30.69,Default,,0,0,0,,Ал, ойланып көрейік.
Dialogue: 0,0:02:30.77,0:02:34.48,Default,,0,0,0,,«Мысығымды әкеліп жатырмын» деп айта алмаймын.
Dialogue: 0,0:02:35.28,0:02:38.07,Default,,0,0,0,,18 жаста, орта мектептің соңғы жылы
Dialogue: 0,0:02:38.15,0:02:41.16,Default,,0,0,0,,- (Юта) Кешіріңіз - (Рикка) Кешіріңіз
Dialogue: 0,0:02:41.99,0:02:44.62,Default,,0,0,0,,Бірақ Рикка
Dialogue: 0,0:02:44.70,0:02:47.45,Default,,0,0,0,,- (Рикка) Ху - (Юта) Не қарап тұрсың?
Dialogue: 0,0:02:48.20,0:02:50.62,Default,,0,0,0,,Америка Құрама Штаттары солай ете ме?
Dialogue: 0,0:02:53.33,0:02:55.30,Default,,0,0,0,,Мен әлі орта мектепте оқитынмын.
Dialogue: 0,0:02:55.38,0:02:56.71,Default,,0,0,0,,(Скилланың айқайы)
Dialogue: 0,0:02:58.38,0:03:00.38,Default,,0,0,0,,♪~
Dialogue: 0,0:04:35.90,0:04:37.90,Default,,0,0,0,,~♪
Dialogue: 0,0:04:42.90,0:04:45.28,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:04:45.36,0:04:48.74,Default,,0,0,0,,Ахахха хехехехе
Dialogue: 0,0:04:49.37,0:04:50.58,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:04:51.37,0:04:53.29,Default,,0,0,0,,Мен армандаған студенттік кеңестің президенті
Dialogue: 0,0:04:54.16,0:04:58.46,Default,,0,0,0,,Орта мектептің үшінші курсында мен бұл дәрежеге жеттім!
Dialogue: 0,0:04:59.42,0:05:01.71,Default,,0,0,0,,Сайлауға күштеп түсу дұрыс болды.
Dialogue: 0,0:05:02.71,0:05:04.80,Default,,0,0,0,,, ақырында, ақырында
Dialogue: 0,0:05:04.88,0:05:09.10,Default,,0,0,0,,Орта мектептің қара күндерін сүртіп тастайтын тамаша орта мектеп өмірі!
Dialogue: 0,0:05:09.93,0:05:13.22,Default,,0,0,0,,Сен неге басқа біреудің орнында рұқсатсыз отырсың?
Dialogue: 0,0:05:13.31,0:05:15.23,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:05:15.31,0:05:19.56,Default,,0,0,0,,Студенттік кеңес төрағасының көктемгі каникул кезінде де жұмысы бар.
Dialogue: 0,0:05:19.65,0:05:21.86,Default,,0,0,0,,Дес шай әкеледі
Dialogue: 0,0:05:21.94,0:05:23.44,Default,,0,0,0,,- (Декомори) Төрағаның орынбасары - (Нибутани) Чит
Dialogue: 0,0:05:23.53,0:05:27.41,Default,,0,0,0,,Мені естімедің бе? Шірік вице-жалған Морисама
Dialogue: 0,0:05:27.99,0:05:29.49,Default,,0,0,0,,Неліктен мен мұны істеймін?
Dialogue: 0,0:05:29.57,0:05:32.45,Default,,0,0,0,,Вице-жалған Морисама - бұл қызық өлім!
Dialogue: 0,0:05:42.63,0:05:43.63,Default,,0,0,0,,Өлім тез өтеді
Dialogue: 0,0:05:43.71,0:05:46.63,Default,,0,0,0,,Әйтпесе интернетте жарияланады!
Dialogue: 0,0:05:46.72,0:05:49.14,Default,,0,0,0,,...
Dialogue: 0,0:05:51.18,0:05:52.93,Default,,0,0,0,,Ол студенттік кеңестің президенті!
Dialogue: 0,0:05:53.51,0:05:56.35,Default,,0,0,0,,А, Тоғаши-кун және басқалары, не болды?
Dialogue: 0,0:05:56.43,0:05:59.06,Default,,0,0,0,,Дұрыс, бұл сызық. Не болып жатыр?
Dialogue: 0,0:05:59.15,0:06:02.77,Default,,0,0,0,,Студенттік кеңес жұмысы.
Dialogue: 0,0:06:02.86,0:06:04.78,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:06:04.86,0:06:08.65,Default,,0,0,0,,Бұл Рикканың қосымша сабағы, әйтеуір ол көтеріліп жатыр.
Dialogue: 0,0:06:09.41,0:06:12.74,Default,,0,0,0,,2538 тәжірибе ұпайын көтеру!
Dialogue: 0,0:06:14.33,0:06:17.25,Default,,0,0,0,,Көктемгі сынақтар мен төсбелгілер шығарылды!
Dialogue: 0,0:06:17.33,0:06:18.83,Default,,0,0,0,,Әрең.
Dialogue: 0,0:06:21.83,0:06:23.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:23.21,0:06:25.09,Default,,0,0,0,,Кумин!
Dialogue: 0,0:06:25.92,0:06:28.42,Default,,0,0,0,,Қарғыс атсын... Кім осылай істейді...
Dialogue: 0,0:06:28.51,0:06:31.43,Default,,0,0,0,,Ах, Рикка-чан, қайырлы таң~
Dialogue: 0,0:06:32.30,0:06:34.43,Default,,0,0,0,,Неге сол пышақпен ұйықтап жатырсың?
Dialogue: 0,0:06:35.10,0:06:38.39,Default,,0,0,0,,Осы арқылы сіз өлілер сияқты ұйықтай аласыз.
Dialogue: 0,0:06:38.48,0:06:40.65,Default,,0,0,0,,Ой, сен тірісің бе?
Dialogue: 0,0:06:41.44,0:06:43.77,Default,,0,0,0,,Университетке дайындалу дұрыс па?
Dialogue: 0,0:06:43.86,0:06:45.23,Default,,0,0,0,,Әрине
Dialogue: 0,0:06:45.32,0:06:48.24,Default,,0,0,0,,Сондықтан мен осындай үйірме жұмыстарында көп жұмыс істеймін.
Dialogue: 0,0:06:48.32,0:06:50.03,Default,,0,0,0,,Бұл бөлім де.
Dialogue: 0,0:06:50.11,0:06:52.74,Default,,0,0,0,,Мен қанша уақытқа созылатынын білмеймін.
Dialogue: 0,0:06:52.82,0:06:57.37,Default,,0,0,0,,Егер солай болса, бәрі жақсы. Мен Декомориге аман қалуға уәде бердім.
Dialogue: 0,0:06:57.45,0:06:59.91,Default,,0,0,0,,- (Рикка) Студенттік кеңес төрағасының өкілеттігі іске қосылды! -(Юта) Аа...
Dialogue: 0,0:07:00.00,0:07:02.50,Default,,0,0,0,,Ондай адамды студенттік кеңестің төрағасы етіп тағайындаған дұрыс па?
Dialogue: 0,0:07:03.08,0:07:05.13,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:07:05.21,0:07:06.84,Default,,0,0,0,,Баяу өлім!
Dialogue: 0,0:07:07.76,0:07:10.01,Default,,0,0,0,,Қанша уақыт күтуім керек?
Dialogue: 0,0:07:10.09,0:07:11.34,Default,,0,0,0,,Егер жақсы болмасаң, өзіңді көтеріп ал~
Dialogue: 0,0:07:11.34,0:07:13.39,Default,,0,0,0,,Егер сен жақсы болмасаң, өзіңді көтеріп ал~
Dialogue: 0,0:07:11.34,0:07:13.39,Default,,0,0,0,,Итай өлімі Итай өлімі!
Dialogue: 0,0:07:14.85,0:07:16.51,Default,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:07:17.14,0:07:20.64,Default,,0,0,0,,Бұл мектепте осындай студенттер кеңесінің болғаны дұрыс па?
Dialogue: 0,0:07:25.82,0:07:27.69,Default,,0,0,0,,(Ұялы телефонның қоңырау әуені)
Dialogue: 0,0:07:27.78,0:07:28.69,Default,,0,0,0,,Не?
Dialogue: 0,0:07:28.78,0:07:31.20,Default,,0,0,0,,Не? бұл қорқынышты қоңырау үні
Dialogue: 0,0:07:31.82,0:07:33.95,Default,,0,0,0,,Ватикан діни қызметкері…
Dialogue: 0,0:07:34.03,0:07:35.53,Default,,0,0,0,,Тука-сан?
Dialogue: 0,0:07:36.58,0:07:38.08,Default,,0,0,0,,Ах
Dialogue: 0,0:07:38.16,0:07:39.16,Default,,0,0,0,,Ах
Dialogue: 0,0:07:40.04,0:07:43.04,Default,,0,0,0,,- (Декомори) Не болып жатыр? -Бұл керемет~
Dialogue: 0,0:07:43.12,0:07:45.38,Default,,0,0,0,,Өтінемін, қазір шықшы, Тоғаши-күн.
Dialogue: 0,0:07:45.46,0:07:47.80,Default,,0,0,0,,- (Юта) Мен бе! -(Рикка) Саған қалдырамын.
Dialogue: 0,0:07:51.76,0:07:52.59,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:07:52.68,0:07:54.05,Default,,0,0,0,,Юта Тогаши?
Dialogue: 0,0:07:54.14,0:07:55.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:56.43,0:07:57.60,Default,,0,0,0,,Италия?
Dialogue: 0,0:07:57.68,0:08:00.10,Default,,0,0,0,,Әй, көктемгі демалыс.
Dialogue: 0,0:08:00.18,0:08:02.60,Default,,0,0,0,,Бұл дәл уақыт, сондықтан мен сізді сонда апарамын.
Dialogue: 0,0:08:02.69,0:08:05.65,Default,,0,0,0,,Сол балықшыны айналдыру үшін қабілетіңізді пайдаланыңыз.
Dialogue: 0,0:08:05.73,0:08:07.48,Default,,0,0,0,,О, мен мұны істеймін!
Dialogue: 0,0:08:07.57,0:08:10.36,Default,,0,0,0,,Рикка-чан, сен жоғалып кетесің бе?
Dialogue: 0,0:08:10.44,0:08:15.24,Default,,0,0,0,,Ол анасын да шақыратынын айтты, сонда біз сол жерде көрікті жерлерді аралай аламыз.
Dialogue: 0,0:08:15.32,0:08:19.16,Default,,0,0,0,,Менің ойымша, ол жаңа семестрге дейін қайтады.
Dialogue: 0,0:08:19.24,0:08:20.75,Default,,0,0,0,,Мен сені сағынамын
Dialogue: 0,0:08:21.62,0:08:23.50,Default,,0,0,0,,Тоғашы-күнмен неге бармайсың?
Dialogue: 0,0:08:23.58,0:08:25.37,Default,,0,0,0,,Мен Италияға барамын.
Dialogue: 0,0:08:25.46,0:08:27.13,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:27.21,0:08:30.88,Default,,0,0,0,,Қосымша сабақтар аяқталды, мен ақыры боспын.
Dialogue: 0,0:08:30.96,0:08:33.63,Default,,0,0,0,,Сол ойынды және сол ойынды аяқтаңыз...
Dialogue: 0,0:08:33.72,0:08:34.97,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:08:35.05,0:08:36.22,Default,,0,0,0,,Не?
Dialogue: 0,0:08:36.30,0:08:38.55,Default,,0,0,0,,Балалар, сендер бірге тұрасыңдар, солай ма?
Dialogue: 0,0:08:38.64,0:08:40.22,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:08:40.31,0:08:43.43,Default,,0,0,0,,Олар бірге тұратын жоғары сынып оқушылары, солай емес пе?
Dialogue: 0,0:08:43.52,0:08:45.73,Default,,0,0,0,,Екеуің ғашық емессіңдер ме?
Dialogue: 0,0:08:45.81,0:08:48.36,Default,,0,0,0,,Бұл сіз ешқашан жібергіңіз келмейтін нәрсе емес пе?
Dialogue: 0,0:08:48.44,0:08:51.82,Default,,0,0,0,,Бірге тұру... сүйкімді-көгершін...
Dialogue: 0,0:08:51.90,0:08:55.91,Default,,0,0,0,,Не? Ажырасқанға дейін бізде ерлі-зайыптылар сияқты атмосфера болды.
Dialogue: 0,0:08:55.99,0:08:58.28,Default,,0,0,0,,Аға келісім-шартқа қол қойдыңыз ба?
Dialogue: 0,0:08:58.37,0:09:00.16,Default,,0,0,0,,Бұл да болды.
Dialogue: 0,0:09:00.24,0:09:02.79,Default,,0,0,0,,«Бұл болды» дегеніме жарты жыл болды.
Dialogue: 0,0:09:03.50,0:09:06.42,Default,,0,0,0,,Сіз бұлай айтпайсыз, солай ма?
Dialogue: 0,0:09:07.04,0:09:07.96,Default,,0,0,0,,Бұл анық!
Dialogue: 0,0:09:09.75,0:09:11.30,Default,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:09:11.38,0:09:12.88,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:12.96,0:09:14.26,Default,,0,0,0,,Олар бір шаңырақ астында тұрады, солай ма?
Dialogue: 0,0:09:14.26,0:09:15.09,Default,,0,0,0,,Олар бір шаңырақ астында тұрады, солай ма?
Dialogue: 0,0:09:14.26,0:09:15.09,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:09:15.17,0:09:16.09,Default,,0,0,0,,Бірақ көрдіңіз бе?
Dialogue: 0,0:09:16.18,0:09:18.76,Default,,0,0,0,,Кимераның балаларына қарау қиын.
Dialogue: 0,0:09:18.84,0:09:20.64,Default,,0,0,0,,(Химераның баласының жылағаны)
Dialogue: 0,0:09:20.72,0:09:22.01,Default,,0,0,0,,(Кимератачидің айқайы)
Dialogue: 0,0:09:22.10,0:09:24.64,Default,,0,0,0,,Көптеген мүмкіндіктер бар!
Dialogue: 0,0:09:25.23,0:09:28.65,Default,,0,0,0,,«Ұстаңыз, алыңыз» және олардың қолдары бір-біріне тиеді.
Dialogue: 0,0:09:28.73,0:09:32.82,Default,,0,0,0,,Бөлмеге кіргенде, мен киім ауыстырып жатыр едім, мен "Кя~" деп қалдым.
Dialogue: 0,0:09:32.90,0:09:36.61,Default,,0,0,0,,«Юта, мен қорқынышты түс көрдім, сенімен ұйықтасам болады ма?»
Dialogue: 0,0:09:36.70,0:09:37.66,Default,,0,0,0,,Ондай нәрсе жоқ па?
Dialogue: 0,0:09:37.74,0:09:39.24,Default,,0,0,0,,№ №
Dialogue: 0,0:09:39.32,0:09:41.53,Default,,0,0,0,,Мен саған бөлмеме кірме дедім.
Dialogue: 0,0:09:41.62,0:09:42.54,Default,,0,0,0,,Ау, ауырып тұр.
Dialogue: 0,0:09:42.62,0:09:43.24,Default,,0,0,0,,Неге қатты күлесің?
Dialogue: 0,0:09:43.24,0:09:44.87,Default,,0,0,0,,Неге қатты күлесің?
Dialogue: 0,0:09:43.24,0:09:44.87,Default,,0,0,0,,О, күте тұрыңыз...
Dialogue: 0,0:09:44.95,0:09:47.54,Default,,0,0,0,,- Жасай бер, Морисама! -(Нибутани) Морисама Айтпа!
Dialogue: 0,0:09:47.62,0:09:51.42,Default,,0,0,0,,Бірақ біз әлі де қол ұстасып, кейде ұстаймыз.
Dialogue: 0,0:09:51.50,0:09:54.71,Default,,0,0,0,,Біз қол ұстасып жатырмыз, сонда не болып жатыр?
Dialogue: 0,0:09:55.21,0:10:00.30,Default,,0,0,0,,Күрсін... Мен бәрібір бұл туралы бірдеңе істеуім керек.
Dialogue: 0,0:10:00.39,0:10:02.39,Default,,0,0,0,,Мен келесі жылы бітіремін.
Dialogue: 0,0:10:03.18,0:10:04.97,Default,,0,0,0,,Оған дейін емтихан тапсыру керек.
Dialogue: 0,0:10:06.52,0:10:07.89,Default,,0,0,0,,Сіз университетке барасыз ба?
Dialogue: 0,0:10:07.98,0:10:11.52,Default,,0,0,0,,Рикка мен сияқты бір нәрсені мақсат етіп отыр.
Dialogue: 0,0:10:11.61,0:10:13.40,Default,,0,0,0,,А, бір жерге барайық!
Dialogue: 0,0:10:13.48,0:10:16.78,Default,,0,0,0,,Менің Nenwave сізге жеткен болуы керек.
Dialogue: 0,0:10:16.86,0:10:18.15,Default,,0,0,0,,Сәтті өлім!
Dialogue: 0,0:10:18.24,0:10:19.61,Default,,0,0,0,,(Куджо Йотаро) Польнареф, мына жігіт… Бұл адам кім өзі?
Dialogue: 0,0:10:21.66,0:10:23.33,Default,,0,0,0,,Мен кейінірек дүкен аралаймын.
Dialogue: 0,0:10:23.91,0:10:25.33,Default,,0,0,0,,Бүгін кезекшіліктесіз бе?
Dialogue: 0,0:10:25.41,0:10:27.75,Default,,0,0,0,,Кузуханы ауыстыру туралы өтініш
Dialogue: 0,0:10:27.83,0:10:29.00,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:10:31.29,0:10:33.13,Default,,0,0,0,,Иә? Сіз қайтадан қозғаласыз ба?
Dialogue: 0,0:10:36.42,0:10:37.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.72,0:10:40.80,Default,,0,0,0,,- (Юта) Бұл... - (Рикка) Менің таныстарым!?
Dialogue: 0,0:10:40.89,0:10:42.43,Default,,0,0,0,,Батыр~
Dialogue: 0,0:10:43.14,0:10:44.35,Default,,0,0,0,,Шичиномия
Dialogue: 0,0:10:44.43,0:10:47.14,Default,,0,0,0,,Зұлым патша Шинган Сіз бұл жерден кетіп барасыз ба?
Dialogue: 0,0:10:47.22,0:10:49.35,Default,,0,0,0,,Бауырым, не болып жатыр?
Dialogue: 0,0:10:49.44,0:10:50.35,Default,,0,0,0,,Га
Dialogue: 0,0:10:50.44,0:10:51.85,Default,,0,0,0,,(Рикка мен Ютаның ауыр тыныс алуы)
Dialogue: 0,0:10:52.86,0:10:53.69,Default,,0,0,0,,Га
Dialogue: 0,0:10:53.77,0:10:55.02,Default,,0,0,0,,(Химераның айқайы)
Dialogue: 0,0:10:55.11,0:10:56.61,Default,,0,0,0,,Гухаа
Dialogue: 0,0:10:56.69,0:10:58.57,Default,,0,0,0,,Менің жүгім...
Dialogue: 0,0:10:58.65,0:11:02.32,Default,,0,0,0,,Сіз басқа әлем сызығында адасып қалдыңыз ба?
Dialogue: 0,0:11:02.41,0:11:04.20,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:11:05.03,0:11:08.50,Default,,0,0,0,,Тоқа-сан, бірдеңе айтпадың ба?
Dialogue: 0,0:11:08.58,0:11:10.21,Default,,0,0,0,,Италияға бару нені білдіреді?
Dialogue: 0,0:11:10.29,0:11:12.21,Default,,0,0,0,,Біз ертең жолға шығамыз.
Dialogue: 0,0:11:12.29,0:11:15.00,Default,,0,0,0,,- (Тока) Жүкіңді ұмытпа - (Юта) Не?! Тока-сан
Dialogue: 0,0:11:15.88,0:11:17.55,Default,,0,0,0,,Басқалары кейінірек жіберіледі.
Dialogue: 0,0:11:17.63,0:11:20.13,Default,,0,0,0,,Бір минут күтіңіз. Не айтқың келеді?
Dialogue: 0,0:11:20.22,0:11:22.30,Default,,0,0,0,,Мен сені Италияға апарамын дедім.
Dialogue: 0,0:11:22.39,0:11:24.35,Default,,0,0,0,,Жоқ, бірақ багаж
Dialogue: 0,0:11:24.43,0:11:29.35,Default,,0,0,0,,Қазір менің жұмысым дұрыс жолға қойылғандықтан, маған сол жақтағы дүкенді басқару тапсырылды.
Dialogue: 0,0:11:29.43,0:11:31.77,Default,,0,0,0,,Сондықтан мен анамды шақыруды шештім.
Dialogue: 0,0:11:31.85,0:11:32.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.52,0:11:34.36,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:11:35.23,0:11:37.86,Default,,0,0,0,,Бұл жай ғана Рикка болуы мүмкін емес.
Dialogue: 0,0:11:39.36,0:11:40.99,Default,,0,0,0,,- (Рикка) Не!? - (Юта) Италияға көшіп жатырсың ба!?
Dialogue: 0,0:11:41.07,0:11:45.99,Default,,0,0,0,,Мен жағдайдың үшінші кезеңге, яғни қараңғы қабатқа жеткенін білмедім!
Dialogue: 0,0:11:46.08,0:11:48.49,Default,,0,0,0,,Джау Шинган Жарай ма?
Dialogue: 0,0:11:49.25,0:11:51.87,Default,,0,0,0,,Маған қалдырыңыз! Мен итальян тілін жақсы білемін
Dialogue: 0,0:11:51.96,0:11:55.29,Default,,0,0,0,,Чао ~ Карпаччо Пескаторе
Dialogue: 0,0:11:55.38,0:11:56.84,Default,,0,0,0,,Багна Каудер!
Dialogue: 0,0:11:56.92,0:11:59.17,Default,,0,0,0,,Уа, сен сондай ынталысың.
Dialogue: 0,0:11:59.26,0:12:01.63,Default,,0,0,0,,Багна Каудер!
Dialogue: 0,0:12:01.72,0:12:04.89,Default,,0,0,0,,Жоқ, Тоқа мырза, менің айтайын дегенім осы.
Dialogue: 0,0:12:04.97,0:12:07.64,Default,,0,0,0,,Университет? Ал университет ше?
Dialogue: 0,0:12:07.72,0:12:09.47,Default,,0,0,0,,Университет?
Dialogue: 0,0:12:10.35,0:12:12.02,Default,,0,0,0,,Сіз жоғары оқу орнына түсуді жоспарлап отырсыз ба?
Dialogue: 0,0:12:12.10,0:12:14.69,Default,,0,0,0,,Джау Шинган шарты абсолютті.
Dialogue: 0,0:12:14.77,0:12:17.77,Default,,0,0,0,,Гельзониантпен жұмыс істеу үшін қажет
Dialogue: 0,0:12:17.86,0:12:21.99,Default,,0,0,0,,- (Тоқа) Бара аласың ба? -(Юта) Мен бар күшімді салып жатырмын.
Dialogue: 0,0:12:22.07,0:12:23.53,Default,,0,0,0,,Қорытынды емтиханның нәтижелері қандай?
Dialogue: 0,0:12:24.24,0:12:26.74,Default,,0,0,0,,Жоқ... қазір... жоқ
Dialogue: 0,0:12:28.28,0:12:31.00,Default,,0,0,0,,Жарайды, мен ертең мектепке барамын, тексеремін.
Dialogue: 0,0:12:31.08,0:12:32.87,Default,,0,0,0,,Тиісті түрде бағалаңыз
Dialogue: 0,0:12:32.96,0:12:33.87,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:12:41.71,0:12:45.97,Default,,0,0,0,,Жауынгерлік қуаты 5,87 миллион!? Бұл құбыжық па?
Dialogue: 0,0:12:46.05,0:12:47.30,Default,,0,0,0,,- (Юта) Осыны айтып тұрсың ба? -(Рикка) Ах!
Dialogue: 0,0:12:50.01,0:12:52.10,Default,,0,0,0,,Бұл сізді сендіреді деп ойлайсың ба?
Dialogue: 0,0:12:52.18,0:12:54.44,Default,,0,0,0,,Жарайды, әлі ағып кеткен жоқ.
Dialogue: 0,0:12:55.35,0:12:57.44,Default,,0,0,0,,Қараңғы тосқауылға жапсаңыз!
Dialogue: 0,0:12:57.52,0:12:59.06,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:12:59.15,0:13:00.48,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:13:00.57,0:13:02.57,Default,,0,0,0,,Жазбалар мектепте қалады.
Dialogue: 0,0:13:02.65,0:13:06.32,Default,,0,0,0,,Олай болса, қазірден бастап еніп, жазбаны өшіріңіз.
Dialogue: 0,0:13:06.41,0:13:08.62,Default,,0,0,0,,- (Юта) Бұл шекара бұзу! -(Рикка) Ах!
Dialogue: 0,0:13:09.58,0:13:12.75,Default,,0,0,0,,Менің күшім болса оңай болар еді, бірақ...
Dialogue: 0,0:13:13.58,0:13:15.08,Default,,0,0,0,,Ар-ождан әшкерелейді
Dialogue: 0,0:13:16.25,0:13:19.08,Default,,0,0,0,,Өйткені, шындап оқудан басқа амалың жоқ.
Dialogue: 0,0:13:21.17,0:13:25.59,Default,,0,0,0,,Мен Тоқа-санға келесі аралық бақылаудан орташа балл алуға болатынын көрсетемін.
Dialogue: 0,0:13:25.67,0:13:28.09,Default,,0,0,0,,Бізді мектепке жалғастыруын сұрайық.
Dialogue: 0,0:13:28.18,0:13:29.64,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:30.43,0:13:33.60,Default,,0,0,0,,Өкінішке орай, қабілеттілік мәнін арттыру
Dialogue: 0,0:13:33.68,0:13:35.35,Default,,0,0,0,,Қысқа мерзімде қиын
Dialogue: 0,0:13:35.43,0:13:37.19,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:13:37.27,0:13:39.56,Default,,0,0,0,,Аралық бақылауға Декомориді шақырыңыз
Dialogue: 0,0:13:39.65,0:13:42.86,Default,,0,0,0,,- (Рикка) Мен болшы... - (Юта) Төменгі сынып оқушысынан сенің орнын басушы болуды сұрама.
Dialogue: 0,0:13:42.94,0:13:46.86,Default,,0,0,0,,- (Рикка) Қараңғы жауап парағын дайындаңыз - (Юта) Сізді бір оқта білуге ​​болады.
Dialogue: 0,0:13:46.95,0:13:48.74,Default,,0,0,0,,Сонда мен не істеуім керек!?
Dialogue: 0,0:13:49.87,0:13:52.66,Default,,0,0,0,,Менің оқудан басқа амалым жоқ. Мың шақырымдық жол бір қадамнан басталады.
Dialogue: 0,0:13:54.25,0:13:55.66,Default,,0,0,0,,Егер сіз мұны күн сайын жасасаңыз, сіз бірдеңе жасай аласыз...
Dialogue: 0,0:13:55.75,0:13:57.25,Default,,0,0,0,,- (Рикка) Ах~ - (Юта) А, сен не істеп жатырсың?
Dialogue: 0,0:13:57.33,0:14:00.71,Default,,0,0,0,,Бұл ұпай!? Юта Тогаши шындыққа бет бұрыңыз
Dialogue: 0,0:14:00.79,0:14:03.92,Default,,0,0,0,,Қалай ойласаңыз да, ортада орташа болу мүмкін емес!
Dialogue: 0,0:14:04.00,0:14:06.30,Default,,0,0,0,,- (Юта) Уф... - (Рикка) Нені армандайсың?
Dialogue: 0,0:14:06.38,0:14:07.38,Default,,0,0,0,,Сәл шынайырақ...
Dialogue: 0,0:14:07.47,0:14:08.38,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:14:08.47,0:14:10.59,Default,,0,0,0,,Не, сен сонша сенімді айттың ба?
Dialogue: 0,0:14:10.68,0:14:14.56,Default,,0,0,0,,Бұл ұпай өте қиын.
Dialogue: 0,0:14:15.89,0:14:17.10,Default,,0,0,0,,София келіседі
Dialogue: 0,0:14:17.18,0:14:19.10,Default,,0,0,0,,Күріш крекерін жемеңіз!
Dialogue: 0,0:14:19.19,0:14:23.90,Default,,0,0,0,,Әйтеуір, екеуінің сүйкімді жақтарын көрсетуден басқа амалы жоқ, солай ма?
Dialogue: 0,0:14:23.98,0:14:28.11,Default,,0,0,0,,Дұрыс~ Екеумізді ешқашан ажырата алмаймыз.
Dialogue: 0,0:14:28.20,0:14:30.74,Default,,0,0,0,,Неліктен тіпті үлкендер де бар?
Dialogue: 0,0:14:30.82,0:14:32.78,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:14:32.87,0:14:36.50,Default,,0,0,0,,Қарсылас – айбатты жау! Осындай оңай жолмен...
Dialogue: 0,0:14:36.58,0:14:38.00,Default,,0,0,0,,Қашып кету туралы не деуге болады?
Dialogue: 0,0:14:38.08,0:14:39.33,Default,,0,0,0,,Қашу?
Dialogue: 0,0:14:39.42,0:14:42.84,Default,,0,0,0,,Тогаши-кун мен Рикка-чан: «Мен ажырасқым келмейді», - деді.
Dialogue: 0,0:14:42.92,0:14:44.50,Default,,0,0,0,,Үйден қашып бара жатқан екі адам
Dialogue: 0,0:14:44.59,0:14:47.46,Default,,0,0,0,,Мысырдан шыққан өлім! Жоғалған жұмақ өлім!
Dialogue: 0,0:14:47.55,0:14:48.38,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:14:48.47,0:14:50.59,Default,,0,0,0,,Әрине, бұл жақсы болуы мүмкін.
Dialogue: 0,0:14:50.68,0:14:54.60,Default,,0,0,0,,Ең болмағанда оны келіссөз үстеліне отырғызуға болады!
Dialogue: 0,0:14:54.68,0:14:57.56,Default,,0,0,0,,Батыр мен зұлым патша Шинганның қашуы?
Dialogue: 0,0:14:57.64,0:14:58.93,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:14:59.02,0:15:02.65,Default,,0,0,0,,Егер ол мұны білсе, Тоқа-санның маған не істерін білмеймін.
Dialogue: 0,0:15:02.73,0:15:07.28,Default,,0,0,0,,Бұл Которию-санды қорғау үшін, солай ма? Қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:15:07.36,0:15:08.90,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:15:08.99,0:15:11.95,Default,,0,0,0,,Осы жылдамдықпен олар мені алып кетеді.
Dialogue: 0,0:15:12.03,0:15:14.58,Default,,0,0,0,,Жоқ, бірақ қашып жатыр...
Dialogue: 0,0:15:14.66,0:15:16.12,Default,,0,0,0,,Барар жерім болмаса да
Dialogue: 0,0:15:16.20,0:15:19.25,Default,,0,0,0,,Ерік-жігеріңізді көрсетіңіз, ол соншалықты алыс болмауы керек.
Dialogue: 0,0:15:19.33,0:15:20.50,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:15:20.58,0:15:23.79,Default,,0,0,0,,Бірақ қаладан кеткен дұрыс.
Dialogue: 0,0:15:23.88,0:15:27.21,Default,,0,0,0,,Бұл діни қызметкер өте жақсы қолданушы сияқты.
Dialogue: 0,0:15:27.30,0:15:28.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:28.88,0:15:31.59,Default,,0,0,0,,Ал екеуі қаладан шықты
Dialogue: 0,0:15:32.34,0:15:36.18,Default,,0,0,0,,Тоқа-санға қашып кеткенімізді айттым.
Dialogue: 0,0:15:36.26,0:15:39.10,Default,,0,0,0,,«Егер сіз маған Жапонияда болуға рұқсат етпесеңіз».
Dialogue: 0,0:15:39.18,0:15:41.44,Default,,0,0,0,,«Мен мұнда қайтып оралмаймын»
Dialogue: 0,0:15:43.35,0:15:45.44,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:15:45.52,0:15:49.74,Default,,0,0,0,,Басқа амал жоқ, сондықтан тырысу керек.
Dialogue: 0,0:15:50.24,0:15:51.99,Default,,0,0,0,,Которию-сан ше?
Dialogue: 0,0:15:54.91,0:15:58.20,Default,,0,0,0,,Менің барғым келеді... қашып кетейін.
Dialogue: 0,0:15:59.87,0:16:00.70,Default,,0,0,0,,Иә
Dialogue: 0,0:16:00.79,0:16:03.83,Default,,0,0,0,,Жарайды, операцияны бастайық!
Dialogue: 0,0:16:03.92,0:16:05.08,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:16:15.43,0:16:17.85,Default,,0,0,0,,- (Рикка) Ауыр... - (Юта) Не әкелдің?
Dialogue: 0,0:16:21.31,0:16:23.69,Default,,0,0,0,,Не? Бұл жігіт кедергі жасайды
Dialogue: 0,0:16:23.77,0:16:25.19,Default,,0,0,0,,Ютаны күтіңіз
Dialogue: 0,0:16:25.27,0:16:29.69,Default,,0,0,0,,- (Рикка) Мен үшін уайымдама, бар. - (Юта) Қайсысы?
Dialogue: 0,0:16:30.73,0:16:33.86,Default,,0,0,0,,Енді қай жолмен жүрдің?
Dialogue: 0,0:16:34.61,0:16:38.58,Default,,0,0,0,,Рикка, сен орта мектепте оқып жүргенде мектепке саяхатқа қайда бардың?
Dialogue: 0,0:16:41.95,0:16:43.12,Default,,0,0,0,,Мен ол жерде болған жоқпын.
Dialogue: 0,0:16:44.79,0:16:46.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:46.58,0:16:50.21,Default,,0,0,0,,Ойлап қарасам, мен де орта мектепте мектепте саяхатта болдым.
Dialogue: 0,0:16:50.30,0:16:53.72,Default,,0,0,0,,Иә~ Топқа бөле алдыңыз ба?
Dialogue: 0,0:17:01.97,0:17:05.39,Default,,0,0,0,,Джау Шинген-рю 14 типті құпия әдіс
Dialogue: 0,0:17:05.48,0:17:08.23,Default,,0,0,0,,-(Рикка) Қандай да бір күш беретін техника~ -(Юта) Оны тастамаңыз.
Dialogue: 0,0:17:17.74,0:17:19.87,Default,,0,0,0,,Бірден шабуыл жасаса ше?
Dialogue: 0,0:17:19.95,0:17:21.37,Default,,0,0,0,,Мен өзімді жеңе алмайтындай сезінемін
Dialogue: 0,0:17:21.99,0:17:22.87,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:17:22.95,0:17:26.29,Default,,0,0,0,,Бұл адамдар сізге шабуыл жасамайды.
Dialogue: 0,0:17:26.37,0:17:28.54,Default,,0,0,0,,Иә, мен де...
Dialogue: 0,0:17:28.63,0:17:30.54,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:30.63,0:17:33.92,Default,,0,0,0,,- (Юта) Архххххххххххххххххххххххххххххххххххххххххххххххххх хххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххххх алмаймын мен-(Рикка) Юта жеңілді!
Dialogue: 0,0:17:40.26,0:17:41.10,Default,,0,0,0,,Иә
Dialogue: 0,0:17:44.35,0:17:45.85,Default,,0,0,0,,Қашу?
Dialogue: 0,0:17:45.93,0:17:48.48,Default,,0,0,0,,Иә, солай сияқты...
Dialogue: 0,0:17:48.56,0:17:51.98,Default,,0,0,0,,Шеберді алып кету мүмкін емес.
Dialogue: 0,0:17:52.07,0:17:53.40,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:17:53.48,0:17:56.61,Default,,0,0,0,,Түсіндім, сен білмейсің
Dialogue: 0,0:17:56.70,0:17:58.61,Default,,0,0,0,,Міне солай болды.
Dialogue: 0,0:17:58.70,0:18:00.20,Default,,0,0,0,,Әрине десу
Dialogue: 0,0:18:00.28,0:18:03.79,Default,,0,0,0,,Мен оянсам, екеуі мүлде жоғалып кеткен.
Dialogue: 0,0:18:03.87,0:18:06.04,Default,,0,0,0,,Тек жазбалар ғана қалады
Dialogue: 0,0:18:14.71,0:18:15.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.84,0:18:18.51,Default,,0,0,0,,қашып кету туралы не айтуға болады?
Dialogue: 0,0:18:18.59,0:18:19.51,Default,,0,0,0,,Қашу?
Dialogue: 0,0:18:19.59,0:18:20.14,Default,,0,0,0,,Тогаши-кун мен Рикка-чан: «Мен ажырасқым келмейді», - деді.
Dialogue: 0,0:18:20.14,0:18:23.39,Default,,0,0,0,,Тогаши-кун мен Рикка-чан: «Мен ажырасқым келмейді», - деді.
Dialogue: 0,0:18:20.14,0:18:23.39,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:18:23.39,0:18:24.31,Default,,0,0,0,,Тогаши-кун мен Рикка-чан: «Мен ажырасқым келмейді», - деді.
Dialogue: 0,0:18:24.39,0:18:25.93,Default,,0,0,0,,Үйден қашып бара жатқан екі адам
Dialogue: 0,0:18:26.02,0:18:26.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:26.98,0:18:29.31,Default,,0,0,0,,Әрине, бұл жақсы болуы мүмкін.
Dialogue: 0,0:18:29.39,0:18:30.77,Default,,0,0,0,,Неге соншалықты алысқа бару керек…
Dialogue: 0,0:18:30.85,0:18:35.36,Default,,0,0,0,,Ең болмағанда оны келіссөз үстеліне отырғызуға болады!
Dialogue: 0,0:18:36.32,0:18:39.32,Default,,0,0,0,,Менің ірімшікті жегің келетін сияқты!
Dialogue: 0,0:18:39.40,0:18:40.36,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:40.45,0:18:44.16,Default,,0,0,0,,- (Тоқа) Не айтып тұрсың? -(Нибутани) Жоқ, сондықтан...
Dialogue: 0,0:18:44.24,0:18:47.83,Default,,0,0,0,,Оған ұйытқы болған осы жігіт! «Көтерілістің қарқынын арттыр!»
Dialogue: 0,0:18:47.91,0:18:50.12,Default,,0,0,0,,Сіз біреуді сатқыңыз келе ме?
Dialogue: 0,0:18:50.21,0:18:51.63,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:18:51.71,0:18:54.13,Default,,0,0,0,,Белгілі бір жерден алынған
Dialogue: 0,0:18:54.75,0:18:57.01,Default,,0,0,0,,Рикка мен Юта Тогашиді осында әкелсем ше?
Dialogue: 0,0:18:57.09,0:18:58.09,Default,,0,0,0,,Оны жойайық.
Dialogue: 0,0:18:58.17,0:18:59.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.09,0:19:03.85,Default,,0,0,0,,Егер сіз бас тартсаңыз, бұл жаңа семестр басталған кезде интернетке жүктеледі.
Dialogue: 0,0:19:03.93,0:19:07.31,Default,,0,0,0,,- (Нибутани) Солай... - (Декомори) Хихихи
Dialogue: 0,0:19:07.39,0:19:11.52,Default,,0,0,0,,Ең дұрысы, мені жалған деп мазақ еткенім дұрыс!
Dialogue: 0,0:19:11.60,0:19:13.52,Default,,0,0,0,,- (Нибутани) Бұл не?! - (Декомори) Бұл не деген өлім!?
Dialogue: 0,0:19:14.23,0:19:16.65,Default,,0,0,0,,Сіздің сүйісу сахнаңыз қашан?
Dialogue: 0,0:19:16.73,0:19:19.90,Default,,0,0,0,,Жаңа семестрдің басында студенттік кеңестің төрағасы және вице-президенті
Dialogue: 0,0:19:19.99,0:19:22.41,Default,,0,0,0,,Бұл жанжалға айналмас деп үміттенемін.
Dialogue: 0,0:19:22.49,0:19:25.87,Default,,0,0,0,,Хехе, төраға орынбасар ғой!?
Dialogue: 0,0:19:25.95,0:19:28.95,Default,,0,0,0,,Өтірік~ Бұл толығымен юри!
Dialogue: 0,0:19:29.71,0:19:32.00,Default,,0,0,0,,Nuo~t no good desu no desu
Dialogue: 0,0:19:32.08,0:19:35.21,Default,,0,0,0,,Егер сіз шебер болсаңыз, бұл алдамшы туралы білмес едіңіз!
Dialogue: 0,0:19:35.29,0:19:36.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:36.30,0:19:37.92,Default,,0,0,0,,Мен үшін дұға ет!
Dialogue: 0,0:19:39.01,0:19:40.42,Default,,0,0,0,,Сонда түсінесің бе?
Dialogue: 0,0:19:44.89,0:19:47.93,Default,,0,0,0,,А, бұл Даймонжияма шығар.
Dialogue: 0,0:19:48.02,0:19:49.35,Default,,0,0,0,,Daimonji?
Dialogue: 0,0:19:49.43,0:19:51.06,Default,,0,0,0,,Сіз оны теледидардан немесе басқалардан көресіз.
Dialogue: 0,0:19:51.14,0:19:52.35,Default,,0,0,0,,«дай» әрпін отқа жағыңыз
Dialogue: 0,0:19:52.44,0:19:54.27,Default,,0,0,0,,О, солай!
Dialogue: 0,0:19:54.90,0:19:55.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:55.81,0:19:58.57,Default,,0,0,0,,- (Рикка) Ахх - (Юта) Эй, Рикка, сен не істемексің!?
Dialogue: 0,0:20:11.91,0:20:14.75,Default,,0,0,0,,Мен сенің не елестетіп тұрғаныңды білемін.
Dialogue: 0,0:20:14.83,0:20:16.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.00,0:20:20.26,Default,,0,0,0,,Нибутани.
Dialogue: 0,0:20:21.34,0:20:22.59,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:20:22.67,0:20:26.93,Default,,0,0,0,,Ах~ Тогаши-кун, төтенше жағдай болды.
Dialogue: 0,0:20:27.01,0:20:27.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:28.06,0:20:31.43,Default,,0,0,0,,Иә... Мен біраз уақыт телефонмен сөйлесе алмаймын.
Dialogue: 0,0:20:31.52,0:20:32.85,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:20:34.52,0:20:36.77,Default,,0,0,0,,Эй, түсіндім.
Dialogue: 0,0:20:36.86,0:20:38.77,Default,,0,0,0,,Мақсатты алға
Dialogue: 0,0:20:38.86,0:20:42.24,Default,,0,0,0,,Монококты құрылымы бар алып бақылау мұнарасы!
Dialogue: 0,0:20:43.86,0:20:46.20,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:20:46.28,0:20:48.28,Default,,0,0,0,,Мен сенің не айтқың келгенін білемін.
Dialogue: 0,0:20:48.37,0:20:49.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.38,0:20:57.79,Default,,0,0,0,,Декомори
Dialogue: 0,0:20:59.63,0:21:01.25,Default,,0,0,0,,Мен жақсы көлік жүргіземін.
Dialogue: 0,0:21:07.76,0:21:10.31,Default,,0,0,0,,- (Рикка) Декомори... - (Юта) Не болды?
Dialogue: 0,0:21:10.39,0:21:12.98,Default,,0,0,0,,Аударманы тыңдамаңыз!
Dialogue: 0,0:21:13.06,0:21:16.14,Default,,0,0,0,,Мастер Гельзониант
Dialogue: 0,0:21:16.23,0:21:18.44,Default,,0,0,0,,Тезірек орал, Өлім!
Dialogue: 0,0:21:19.11,0:21:21.15,Default,,0,0,0,,Сіз аудардыңыз ба? дөңес қамқоршы
Dialogue: 0,0:21:21.23,0:21:23.15,Default,,0,0,0,,Айтуға келмейтін өлім
Dialogue: 0,0:21:23.24,0:21:27.66,Default,,0,0,0,,Менің өмірім қымбат болса да, мен сені үйге әкелемін!
Dialogue: 0,0:21:28.20,0:21:30.49,Default,,0,0,0,,Өкінішке орай, қазір биліктен.
Dialogue: 0,0:21:30.58,0:21:34.12,Default,,0,0,0,,Мен сенің құлап қалуыңа жол бере алмаймын.
Dialogue: 0,0:21:34.79,0:21:35.87,Default,,0,0,0,,Explode Real
Dialogue: 0,0:21:35.96,0:21:38.25,Default,,0,0,0,,Мен мұндай жерде болады деп ешқашан ойламадым.
Dialogue: 0,0:21:38.33,0:21:39.84,Default,,0,0,0,,Тоқта, бұл жиіркенішті
Dialogue: 0,0:21:39.92,0:21:41.71,Default,,0,0,0,,Pop Synapse
Dialogue: 0,0:21:42.42,0:21:46.47,Default,,0,0,0,,Бұл әлемді қуу!
Dialogue: 0,0:21:57.19,0:21:59.15,Default,,0,0,0,,Шин… По
Dialogue: 0,0:21:59.23,0:22:00.19,Default,,0,0,0,,Өзіңізді қорғаңыз!
Dialogue: 0,0:22:00.27,0:22:05.19,Default,,0,0,0,,Менің өмірім қымбат болса да, мен сені үйге әкелемін!
Dialogue: 0,0:22:11.16,0:22:12.70,Default,,0,0,0,,～
Dialogue: 0,0:22:17.37,0:22:20.29,Default,,0,0,0,,Königinde Anacht!
Dialogue: 0,0:22:37.89,0:22:39.10,Default,,0,0,0,,О, сәлем, тұтынушы.
Dialogue: 0,0:22:40.31,0:22:42.23,Default,,0,0,0,,О!
Dialogue: 0,0:23:15.72,0:23:17.64,Default,,0,0,0,,- (Рикка) Юта - (Юта) Хейлигевейс!
Dialogue: 0,0:23:18.85,0:23:19.68,Default,,0,0,0,,Не... Уф
Dialogue: 0,0:23:19.77,0:23:22.81,Default,,0,0,0,,Ugg Ugggg
Dialogue: 0,0:23:22.90,0:23:24.52,Default,,0,0,0,,Иә
Dialogue: 0,0:23:24.61,0:23:26.32,Default,,0,0,0,,Мен оны алғаныма қуаныштымын~
Dialogue: 0,0:23:26.82,0:23:29.15,Default,,0,0,0,,- (Рикка) Ах! -(Юта) кеттік.
Dialogue: 0,0:23:29.24,0:23:30.82,Default,,0,0,0,,Юта жанама сүйіспеншілік
Dialogue: 0,0:23:30.90,0:23:33.12,Default,,0,0,0,,Қазір емес!
Dialogue: 0,0:23:33.20,0:23:34.70,Default,,0,0,0,,- (Юта) Ах - (Рикка) Ах!
Dialogue: 0,0:23:34.78,0:23:38.08,Default,,0,0,0,,- (Нибутани) Адасып кеткендер - (Юта) Нибутани
Dialogue: 0,0:23:38.16,0:23:41.33,Default,,0,0,0,,Сіздің жолыңыз жабық
Dialogue: 0,0:23:41.71,0:23:42.79,Default,,0,0,0,,Енді осы Морисамаға
Dialogue: 0,0:23:42.79,0:23:44.00,Default,,0,0,0,,Енді осы Морисамаға
Dialogue: 0,0:23:42.79,0:23:44.00,Default,,0,0,0,,Өлімді жеу! Герзониантус!
Dialogue: 0,0:23:44.00,0:23:44.42,Default,,0,0,0,,Өлімді жеу! Герзониантус!
Dialogue: 0,0:23:44.42,0:23:45.21,Default,,0,0,0,,Өлімді жеу! Герзониантус!
Dialogue: 0,0:23:44.42,0:23:45.21,Default,,0,0,0,,Өзіңізді ұсыныңыз
Dialogue: 0,0:23:45.21,0:23:45.29,Default,,0,0,0,,Өзіңізді ұсыныңыз
Dialogue: 0,0:23:45.29,0:23:46.17,Default,,0,0,0,,Өзіңізді ұсыныңыз
Dialogue: 0,0:23:45.29,0:23:46.17,Default,,0,0,0,,Уау
Dialogue: 0,0:23:46.25,0:23:47.84,Default,,0,0,0,,Ах, ряря, уау, уау...
Dialogue: 0,0:23:47.92,0:23:48.76,Default,,0,0,0,,Кяах!
Dialogue: 0,0:23:50.38,0:23:51.84,Default,,0,0,0,,- (Юта) Кездескенше - (Рикка) Қоштасу.
Dialogue: 0,0:23:51.93,0:23:54.72,Default,,0,0,0,,Сәлем, балалар, күтіңдер!
Dialogue: 0,0:23:58.14,0:23:58.97,Default,,0,0,0,,А, қазірдің өзінде
Dialogue: 0,0:24:14.91,0:24:17.87,Default,,0,0,0,,Сен араласпасаң, мен Өлімді ұстап алар едім.
Dialogue: 0,0:24:17.95,0:24:18.87,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:24:18.95,0:24:23.37,Default,,0,0,0,,Мен бұл зұлым лордтың шынайы көзді қызметшісін ұстай аламын деп ойламадым.
Dialogue: 0,0:24:23.46,0:24:26.75,Default,,0,0,0,,Тоқа-сан жағына шықты деп ойлауға болады.
Dialogue: 0,0:24:34.59,0:24:35.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:55.24,0:24:57.12,Default,,0,0,0,,Өлім кетті
Dialogue: 0,0:25:11.42,0:25:13.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:14.42,0:25:17.26,Default,,0,0,0,,Иә, мен қазір пойыздамын...
Dialogue: 0,0:25:17.34,0:25:20.18,Default,,0,0,0,,Бұл электрондық пошта, мен білемін.
Dialogue: 0,0:25:20.68,0:25:22.27,Default,,0,0,0,,Бұл Шичиномия.
Dialogue: 0,0:25:22.35,0:25:24.89,Default,,0,0,0,,Декомори мен Нибутани күткендей...
Dialogue: 0,0:25:24.98,0:25:27.31,Default,,0,0,0,,Біраз уақыт болады десе де
Dialogue: 0,0:25:27.40,0:25:28.27,Default,,0,0,0,,Ах
Dialogue: 0,0:25:29.19,0:25:30.02,Default,,0,0,0,,Не?
Dialogue: 0,0:25:30.98,0:25:35.03,Default,,0,0,0,,- (Рикка) Мен Декоморимен жанама сүйдім - (Юта) Сіз бұл туралы ерекше айтасыз ба!?
Dialogue: 0,0:25:54.01,0:25:59.89,Default,,0,0,0,,Соңында Тока-сан, Нибутани және Декомори үшін
Dialogue: 0,0:25:59.97,0:26:04.10,Default,,0,0,0,,Шичимия әлі біз жақта болса да.
Dialogue: 0,0:26:04.18,0:26:06.64,Default,,0,0,0,,3 қарсы 3...
Dialogue: 0,0:26:06.73,0:26:08.90,Default,,0,0,0,,- (Тока) Бас тарт - (Юта) Не!?
Dialogue: 0,0:26:09.94,0:26:11.11,Default,,0,0,0,,Тоқа-сан
Dialogue: 0,0:26:11.77,0:26:15.57,Default,,0,0,0,,Біз сенің қайда екеніңді білеміз.
Dialogue: 0,0:26:16.78,0:26:20.28,Default,,0,0,0,,Қанша қашсаң да, қаласаң ұсталады.
Dialogue: 0,0:26:20.99,0:26:22.78,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:26:22.87,0:26:25.29,Default,,0,0,0,,Бұл әзіл сияқты қызықсыз, солай емес пе?
Dialogue: 0,0:26:25.37,0:26:26.29,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:26:27.04,0:26:30.50,Default,,0,0,0,,Мен сені жалғыз қалдырамын ба деп уайымдайтыным рас.
Dialogue: 0,0:26:31.08,0:26:33.55,Default,,0,0,0,,Мен бір жылдан астам қиындықсыз өмір сүріп келемін.
Dialogue: 0,0:26:33.63,0:26:35.88,Default,,0,0,0,,Тіпті мен және айналамдағы адамдар...
Dialogue: 0,0:26:36.51,0:26:38.51,Default,,0,0,0,,-(Тока) Сол себепті -(Юта) А?
Dialogue: 0,0:26:40.09,0:26:43.14,Default,,0,0,0,,Мен Рикка сенімен бірге тұра бастайды деп естідім.
Dialogue: 0,0:26:43.22,0:26:45.60,Default,,0,0,0,,Шынымды айтсам, біраз күттім.
Dialogue: 0,0:26:45.68,0:26:48.48,Default,,0,0,0,,Қызық, Рикка өзгере ме?
Dialogue: 0,0:26:48.56,0:26:49.98,Default,,0,0,0,,Ол өзгере ме?
Dialogue: 0,0:26:50.06,0:26:53.94,Default,,0,0,0,,Бұл көз патч пен Джау Шинган оған қатысы бар.
Dialogue: 0,0:26:54.02,0:26:55.23,Default,,0,0,0,,О
Dialogue: 0,0:26:55.32,0:26:59.82,Default,,0,0,0,,Мінезі осындай адам өзін басқалардан артық жақсы көреді.
Dialogue: 0,0:26:59.90,0:27:02.20,Default,,0,0,0,,Сондықтан өзіңнен басқа адамдарды жақсы көрсең
Dialogue: 0,0:27:02.28,0:27:06.24,Default,,0,0,0,,Мен мұндай әрекеттерді қарапайым деп ойладым.
Dialogue: 0,0:27:06.33,0:27:08.33,Default,,0,0,0,,Мен саған құймақ әкелдім.
Dialogue: 0,0:27:10.21,0:27:11.92,Default,,0,0,0,,Мен оны осында төмендетемін.
Dialogue: 0,0:27:13.04,0:27:15.00,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:27:15.09,0:27:17.80,Default,,0,0,0,,Бір жыл өтсе де, солай көрінеді.
Dialogue: 0,0:27:18.34,0:27:19.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:27:21.38,0:27:24.47,Default,,0,0,0,,Көрінбейтін шекараны таптың ба?
Dialogue: 0,0:27:25.31,0:27:29.14,Default,,0,0,0,,Енді қараңғылықтың күші туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:27:29.23,0:27:31.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:27:31.10,0:27:33.77,Default,,0,0,0,,Дегенмен, Рокканың Чуунибиоу
Dialogue: 0,0:27:33.86,0:27:36.69,Default,,0,0,0,,Жоқ, Джау Шинган
Dialogue: 0,0:27:36.78,0:27:38.78,Default,,0,0,0,,Рикка үшін бұл менімен байланыс.
Dialogue: 0,0:27:39.57,0:27:42.11,Default,,0,0,0,,Менің ойымша, бұл байланыс сияқты.
Dialogue: 0,0:27:43.41,0:27:47.16,Default,,0,0,0,,Сондықтан мен өзімді ештеңені өзгертуге мәжбүрлемеймін.
Dialogue: 0,0:27:47.24,0:27:50.37,Default,,0,0,0,,Рикканың қасында қалып, оны бақылап отырайық.
Dialogue: 0,0:27:51.04,0:27:55.25,Default,,0,0,0,,Ғашықтардың, достардың т.б кейпіне түсіп қалма.
Dialogue: 0,0:27:55.34,0:27:58.13,Default,,0,0,0,,Екеумізге ғана қарым-қатынас жасайық.
Dialogue: 0,0:28:00.13,0:28:03.09,Default,,0,0,0,,А... бұл не? сен
Dialogue: 0,0:28:03.76,0:28:06.22,Default,,0,0,0,,Бұл сізге жақсы болуы мүмкін.
Dialogue: 0,0:28:06.30,0:28:08.10,Default,,0,0,0,,Бірақ Рикка не болады?
Dialogue: 0,0:28:08.89,0:28:12.23,Default,,0,0,0,,Анам да саған қалдырған, бірақ үндемеді.
Dialogue: 0,0:28:12.31,0:28:14.35,Default,,0,0,0,,Сізді терең уайымдау керек.
Dialogue: 0,0:28:19.07,0:28:21.61,Default,,0,0,0,,Мен осы маусымда 18-ге толамын.
Dialogue: 0,0:28:22.28,0:28:25.57,Default,,0,0,0,,Университетке түсе алмасаңыз не істер едіңіз?
Dialogue: 0,0:28:27.16,0:28:28.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:28:28.83,0:28:30.95,Default,,0,0,0,,Жақында ол орта мектепті бітіреді...
Dialogue: 0,0:28:31.04,0:28:33.62,Default,,0,0,0,,Бұл рас па? бұл жақсы жаңалық
Dialogue: 0,0:28:35.92,0:28:38.42,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:28:38.50,0:28:41.72,Default,,0,0,0,,Не, тілеу?
Dialogue: 0,0:28:41.80,0:28:44.55,Default,,0,0,0,,Қуанғаным сонша, артыма қарамай тұра алмадым.
Dialogue: 0,0:28:44.63,0:28:45.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:46.68,0:28:51.02,Default,,0,0,0,,Мен бастауыш мектепте оқып жүргенімде бір рет көбелек қуыршағын қолыма алдым.
Dialogue: 0,0:28:53.23,0:28:56.65,Default,,0,0,0,,Бірақ мен оны абайсызда бүлдіріп алдым.
Dialogue: 0,0:28:59.07,0:29:01.57,Default,,0,0,0,,Мен өліп қаламын ба деп уайымдадым.
Dialogue: 0,0:29:01.65,0:29:03.53,Default,,0,0,0,,Ол дұрыс шықты
Dialogue: 0,0:29:04.32,0:29:06.57,Default,,0,0,0,,Қанаттар сәл бұрмаланған.
Dialogue: 0,0:29:09.37,0:29:13.04,Default,,0,0,0,,Ол өмір сүре алды ма?
Dialogue: 0,0:29:13.75,0:29:17.04,Default,,0,0,0,,Аа, не айтқыңыз келеді? мен
Dialogue: 0,0:29:17.13,0:29:18.17,Default,,0,0,0,,Сонымен қатар, лифчиктің ішкі толтырғышы бар, сондықтан шын мәнінде…
Dialogue: 0,0:29:18.25,0:29:21.92,Default,,0,0,0,,Рикка енді хризалистен шығуға тырысуда!
Dialogue: 0,0:29:22.01,0:29:24.38,Default,,0,0,0,,Мен оны қорғағым келеді.
Dialogue: 0,0:29:26.18,0:29:29.30,Default,,0,0,0,,Ол заттарды өзінше ойлайды...
Dialogue: 0,0:29:29.39,0:29:30.64,Default,,0,0,0,,Юта
Dialogue: 0,0:29:31.43,0:29:34.48,Default,,0,0,0,,Жаңадан жасалған апельсин сүт қышқылы бактерияларының қоспасы
Dialogue: 0,0:29:34.56,0:29:37.02,Default,,0,0,0,,Қара кемпірқосақ деп атаңыз
Dialogue: 0,0:29:39.52,0:29:41.73,Default,,0,0,0,,Бұл жігіт ештеңені ойлап жатқан жоқ.
Dialogue: 0,0:29:42.44,0:29:43.78,Default,,0,0,0,,Діни әйел!
Dialogue: 0,0:29:47.91,0:29:50.03,Default,,0,0,0,,Бұл жерде мүмкін емес пе?
Dialogue: 0,0:29:54.50,0:29:56.71,Default,,0,0,0,,- (Юта) Кеттік, Рикка - (Рикка) Иә.
Dialogue: 0,0:29:59.08,0:30:00.50,Default,,0,0,0,,Мен бұл жолы байыптымын
Dialogue: 0,0:30:01.21,0:30:04.67,Default,,0,0,0,,Келесі жолы мен сені ұстап алғанымда, мен сені ешбір сұрақсыз алып кетемін.
Dialogue: 0,0:30:04.76,0:30:06.30,Default,,0,0,0,,Кеш қалдың...
Dialogue: 0,0:30:18.94,0:30:22.98,Default,,0,0,0,,Ақырында ешкім қайтып оралмады.
Dialogue: 0,0:30:23.07,0:30:24.32,Default,,0,0,0,,Осы жылдамдықпен
Dialogue: 0,0:30:24.40,0:30:26.95,Default,,0,0,0,,Ол ертең немесе келесі күні қайтып келмеуі мүмкін.
Dialogue: 0,0:30:27.03,0:30:30.91,Default,,0,0,0,,Міне, көктемгі демалыс.
Dialogue: 0,0:30:30.99,0:30:33.20,Default,,0,0,0,,Мүмкін мен де сенің соңынан еруім керек~
Dialogue: 0,0:30:33.28,0:30:35.08,Default,,0,0,0,,Тағы біраз күту керек.
Dialogue: 0,0:30:35.16,0:30:36.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:36.16,0:30:38.92,Default,,0,0,0,,Бұл саяхат екі адамға арналған.
Dialogue: 0,0:30:39.00,0:30:42.13,Default,,0,0,0,,Бұл соңғы маңызды шешімді қабылдайтын орын болуы мүмкін.
Dialogue: 0,0:30:42.21,0:30:44.13,Default,,0,0,0,,Міне, солай емес пе?
Dialogue: 0,0:30:44.21,0:30:45.34,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:30:45.96,0:30:48.59,Default,,0,0,0,,Өйткені оны мен де бастан өткердім.
Dialogue: 0,0:30:48.68,0:30:51.09,Default,,0,0,0,,Ол өзгере ме, өзгермейді ме?
Dialogue: 0,0:30:51.84,0:30:54.85,Default,,0,0,0,,Бұл үшін не қажет?
Dialogue: 0,0:30:58.73,0:31:01.15,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:31:03.06,0:31:04.15,Default,,0,0,0,,Юта
Dialogue: 0,0:31:05.02,0:31:06.44,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:31:08.49,0:31:11.07,Default,,0,0,0,,Таңертеңнен бері қозғалыста.
Dialogue: 0,0:31:11.16,0:31:12.66,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:31:13.16,0:31:16.33,Default,,0,0,0,,Жоқ, мен Тука мен басқалары мұны елестетпейді деп үміттенген едім.
Dialogue: 0,0:31:16.41,0:31:17.83,Default,,0,0,0,,Мен келдім.
Dialogue: 0,0:31:19.50,0:31:23.50,Default,,0,0,0,,Түнге сәйкес құбыжықтар да шақырылатын уақыт
Dialogue: 0,0:31:23.59,0:31:26.25,Default,,0,0,0,,Біріншіден, негіз салу керек
Dialogue: 0,0:31:26.34,0:31:29.51,Default,,0,0,0,,Жарайды, мен міндетті түрде ұйықтайтын жер табуым керек.
Dialogue: 0,0:31:29.59,0:31:32.68,Default,,0,0,0,,- (Рикка) Сонымен Юта - (Юта) А?
Dialogue: 0,0:31:33.34,0:31:36.60,Default,,0,0,0,,Сізге арналған сарай қонақ үйі бар.
Dialogue: 0,0:31:36.68,0:31:38.18,Default,,0,0,0,,Мен мұны айтасыз деп ойладым.
Dialogue: 0,0:31:38.27,0:31:40.48,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:31:40.56,0:31:42.35,Default,,0,0,0,,Әй, күте тұрыңыз!
Dialogue: 0,0:31:46.07,0:31:48.61,Default,,0,0,0,,О, керемет!
Dialogue: 0,0:31:48.69,0:31:50.99,Default,,0,0,0,,Рикка: Бұл құлып емес.
Dialogue: 0,0:31:51.57,0:31:53.62,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:31:54.24,0:31:59.00,Default,,0,0,0,,Бірақ мен әрқашан сарай қонақүйінде болғым келетін.
Dialogue: 0,0:31:59.08,0:32:02.04,Default,,0,0,0,,Сіз мұны бұрын да айттыңыз.
Dialogue: 0,0:32:03.37,0:32:05.25,Default,,0,0,0,,Тұрғын үй 6000 иен
Dialogue: 0,0:32:07.09,0:32:09.26,Default,,0,0,0,,Бұл қымбат па?
Dialogue: 0,0:32:09.34,0:32:12.76,Default,,0,0,0,,Жоқ, кәдімгі қонақүйден арзанырақ шығар.
Dialogue: 0,0:32:12.84,0:32:14.01,Default,,0,0,0,,О!
Dialogue: 0,0:32:16.55,0:32:19.18,Default,,0,0,0,,- (Рикка) Жарайды! Кірейік - (Юта) Ой, эй!
Dialogue: 0,0:32:20.43,0:32:23.48,Default,,0,0,0,,- (Рикка) О! -(Юта) Күте тұрыңыз, Рикка.
Dialogue: 0,0:32:25.23,0:32:29.19,Default,,0,0,0,,Бірақ бұл соншалықты күдікті емес сияқты.
Dialogue: 0,0:32:29.28,0:32:30.69,Default,,0,0,0,,Егер сіз жай ғана түнеп жатсаңыз...
Dialogue: 0,0:32:30.78,0:32:32.45,Default,,0,0,0,,Қарашы, Юта
Dialogue: 0,0:32:33.24,0:32:34.99,Default,,0,0,0,,Енді сіз өз бөлмеңізді таңдай аласыз
Dialogue: 0,0:32:35.07,0:32:37.03,Default,,0,0,0,,~ Бұл не болып жатыр?
Dialogue: 0,0:32:37.12,0:32:38.53,Default,,0,0,0,,- (Юта) Не!? - (Рикка) О!
Dialogue: 0,0:32:39.41,0:32:41.58,Default,,0,0,0,,Олар сізге косплей костюмдерін де беретін сияқты.
Dialogue: 0,0:32:41.66,0:32:42.66,Default,,0,0,0,,That's right.
Dialogue: 0,0:32:43.50,0:32:46.08,Default,,0,0,0,,Рикканың... Косплейі!
Dialogue: 0,0:32:47.75,0:32:49.50,Default,,0,0,0,,Хо~хо~хо~
Dialogue: 0,0:32:49.59,0:32:51.38,Default,,0,0,0,,Ауырсынудан ұшып кет~
Dialogue: 0,0:32:51.46,0:32:53.42,Default,,0,0,0,,Жалғыз болсам өлемін
Dialogue: 0,0:32:53.51,0:32:55.18,Default,,0,0,0,,Май қажет
Dialogue: 0,0:32:55.26,0:32:57.47,Default,,0,0,0,,Жаман карнавал
Dialogue: 0,0:32:58.64,0:33:00.64,Default,,0,0,0,,Кешіріңіз, Құдай Сама
Dialogue: 0,0:33:00.72,0:33:04.56,Default,,0,0,0,,Мен оның қасында азғын нәрсе туралы ойлап отыр едім.
Dialogue: 0,0:33:04.64,0:33:10.32,Default,,0,0,0,,Егер сіз мұны өз басыңызда жасасаңыз, бұл туралы не ойлайтыныңыз маңызды емес.
Dialogue: 0,0:33:10.40,0:33:13.95,Default,,0,0,0,,Рахмет, Құдай!
Dialogue: 0,0:33:14.03,0:33:16.07,Default,,0,0,0,,- (Қызметші) Эй, балалар - (Юта) А, иә.
Dialogue: 0,0:33:17.20,0:33:19.45,Default,,0,0,0,,Балалар сендер кәмелетке толмағансыңдар, солай ма?
Dialogue: 0,0:33:20.41,0:33:22.62,Default,,0,0,0,,Рикка Которию 20 жаста
Dialogue: 0,0:33:23.16,0:33:26.00,Default,,0,0,0,,Юта Тогаши... 22 жаста
Dialogue: 0,0:33:31.96,0:33:36.30,Default,,0,0,0,,- (Рикка) 22 жас тым көп - (Юта) Маған солай айтып тұрсың ба?
Dialogue: 0,0:33:36.38,0:33:40.22,Default,,0,0,0,,Бірақ мұндай күшті тосқауыл қойылғанына сену қиын.
Dialogue: 0,0:33:40.89,0:33:42.60,Default,,0,0,0,,Бұл қауіпті қонақ үй емес пе?
Dialogue: 0,0:33:42.68,0:33:44.89,Default,,0,0,0,,Сонымен, сіз айтып отырсыз.
Dialogue: 0,0:33:44.98,0:33:48.44,Default,,0,0,0,,- (Рикка) Полиция шақыру керек... - (Юта) Бұл қауіпті ме!?
Dialogue: 0,0:33:48.52,0:33:51.65,Default,,0,0,0,,- (Рикка) Тағы да қарастырайық - (Юта) О, сәл күте тұрыңыз.
Dialogue: 0,0:33:52.23,0:33:54.11,Default,,0,0,0,,- (Юта) Ия... - (Рикка) Ой!?
Dialogue: 0,0:34:01.33,0:34:03.45,Default,,0,0,0,,Сөзсіз дөңес қамқоршы
Dialogue: 0,0:34:03.54,0:34:06.41,Default,,0,0,0,,Сіз мұны қайдан білдіңіз?
Dialogue: 0,0:34:06.50,0:34:08.71,Default,,0,0,0,,Тіпті таратқыш қосулы болуы керек...
Dialogue: 0,0:34:10.50,0:34:12.67,Default,,0,0,0,,Эй Рикка, телефоныңды маған берші.
Dialogue: 0,0:34:12.75,0:34:16.51,Default,,0,0,0,,Жоқ! Бұл Джау Шинганға қатысты маңызды құпия ақпаратты қамтиды...
Dialogue: 0,0:34:16.59,0:34:17.72,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:34:28.94,0:34:31.90,Default,,0,0,0,,Ол шынымен де ақымақ емес пе?
Dialogue: 0,0:34:36.19,0:34:38.61,Default,,0,0,0,,- (Рикка) Мынаны мінгелі жатырсың ба? -(Юта) Иә.
Dialogue: 0,0:34:39.11,0:34:41.49,Default,,0,0,0,,Бұл жерде қалу қауіпті.
Dialogue: 0,0:34:41.57,0:34:43.99,Default,,0,0,0,,Бұл жерде қалу қауіпті.
Dialogue: 0,0:34:44.08,0:34:45.79,Default,,0,0,0,,Ақша аударымы жақсы.
Dialogue: 0,0:34:45.87,0:34:49.17,Default,,0,0,0,,- (Рикка) Керемет болды - (Юта) А... рахмет.
Dialogue: 0,0:34:49.25,0:34:53.34,Default,,0,0,0,,Дәл... неге сонша бару керек?
Dialogue: 0,0:34:54.00,0:34:56.05,Default,,0,0,0,,Біз ертең таңертең келеміз.
Dialogue: 0,0:34:56.13,0:34:58.17,Default,,0,0,0,,- (Юта) Ішетін бірдеңе сатып алайық - (Рикка) Иә.
Dialogue: 0,0:34:59.59,0:35:04.14,Default,,0,0,0,,Қараңғыда үлкен жылдамдықпен жүріп, таң ата басқа кеңістікке кіру
Dialogue: 0,0:35:04.22,0:35:07.39,Default,,0,0,0,,Оның жарық жылдамдығымен жүру қабілеті!
Dialogue: 0,0:35:07.48,0:35:10.98,Default,,0,0,0,,Мен өзімді... жаман... уф...
Dialogue: 0,0:35:11.06,0:35:13.31,Default,,0,0,0,,Жұмыс істемейтін болып көрінсе, бұған түкіріңіз.
Dialogue: 0,0:35:13.40,0:35:16.65,Default,,0,0,0,,Бұл зұлым патшаның шынайы көздерін бұру сияқты ақымақ нәрсе
Dialogue: 0,0:35:16.73,0:35:18.24,Default,,0,0,0,,Өмірдегі үлкен ұят
Dialogue: 0,0:35:18.86,0:35:21.78,Default,,0,0,0,,Ескі қорқынышты түс қайта тіріледі
Dialogue: 0,0:35:21.86,0:35:23.53,Default,,0,0,0,,Сол мұғалім
Dialogue: 0,0:35:23.62,0:35:24.99,Default,,0,0,0,,Адамдар қиналып жатса да, сіз олармен сөйлесесіз.
Dialogue: 0,0:35:24.99,0:35:27.25,Default,,0,0,0,,Адамдар қиналып жатса да, сіз олармен сөйлесесіз.
Dialogue: 0,0:35:24.99,0:35:27.25,Default,,0,0,0,,Қарашы, Котори-сан, алысқа қарайық.
Dialogue: 0,0:35:27.25,0:35:29.25,Default,,0,0,0,,Қарашы, Котори-сан, алысқа қарайық.
Dialogue: 0,0:35:31.46,0:35:33.25,Default,,0,0,0,,Сіз ұйықтадыңыз ба?
Dialogue: 0,0:35:34.00,0:35:38.46,Default,,0,0,0,,Тоқа-сан мені ұстамаса да, ақыры ақшам таусылады.
Dialogue: 0,0:35:38.55,0:35:40.30,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:35:57.98,0:35:58.86,Default,,0,0,0,,Бұл алдау ма?
Dialogue: 0,0:35:59.78,0:36:02.36,Default,,0,0,0,,Сіз Рикканың келісімінсіз сүйіп жатырсыз.
Dialogue: 0,0:36:03.11,0:36:05.24,Default,,0,0,0,,Сіз нені айтасыз? Құдай жаз
Dialogue: 0,0:36:05.99,0:36:09.25,Default,,0,0,0,,Сонымен...бірақ біз кездесіп жатырмыз.
Dialogue: 0,0:36:09.33,0:36:13.50,Default,,0,0,0,,Олай болса, ашық сүйіспейміз бе?
Dialogue: 0,0:36:13.58,0:36:16.67,Default,,0,0,0,,Солай ма? Солай ма?
Dialogue: 0,0:36:16.75,0:36:18.00,Default,,0,0,0,,Бахамут…
Dialogue: 0,0:36:19.71,0:36:20.80,Default,,0,0,0,,Не?
Dialogue: 0,0:36:31.18,0:36:33.10,Default,,0,0,0,,Чууниби?
Dialogue: 0,0:36:33.19,0:36:36.11,Default,,0,0,0,,Мен осы маусымда 18-ге толамын.
Dialogue: 0,0:36:36.19,0:36:38.40,Default,,0,0,0,,Егер ол бұрынғы қалпында қалса, не істеуіміз керек?
Dialogue: 0,0:36:40.32,0:36:42.95,Default,,0,0,0,,Соңында, жарылыс! Менің басқа эго
Dialogue: 0,0:36:43.03,0:36:45.57,Default,,0,0,0,,Мен сенің балаңмын.
Dialogue: 0,0:36:45.66,0:36:47.07,Default,,0,0,0,,Оны қалай атау керек?
Dialogue: 0,0:36:47.16,0:36:50.37,Default,,0,0,0,,Мықты бала болып өсе бер деген тілекпен
Dialogue: 0,0:36:50.45,0:36:51.62,Default,,0,0,0,,Бахамут!
Dialogue: 0,0:36:51.70,0:36:54.50,Default,,0,0,0,,Жоқ, мен бұл керемет деп ойладым.
Dialogue: 0,0:36:54.58,0:36:56.13,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:36:56.21,0:36:58.92,Default,,0,0,0,,Неліктен балаңызға айдаһар атын қояр едіңіз?
Dialogue: 0,0:36:59.00,0:37:02.55,Default,,0,0,0,,«Тацуя», «Рюума» және т.б. Әдетте өлім көп болады.
Dialogue: 0,0:37:02.63,0:37:05.34,Default,,0,0,0,,Жоқ, бұл сәл қалыптырақ...
Dialogue: 0,0:37:06.01,0:37:07.80,Default,,0,0,0,,Ендеше, «Юта» мен «Риккадан» бастайық.
Dialogue: 0,0:37:07.89,0:37:09.51,Default,,0,0,0,,- (Рикка) Әр әріпті бір-бірден алыңдар - (Юта) Иә, иә.
Dialogue: 0,0:37:10.01,0:37:13.02,Default,,0,0,0,,Йггдрасил Рагнарок!
Dialogue: 0,0:37:13.10,0:37:14.85,Default,,0,0,0,,Керемет!
Dialogue: 0,0:37:17.02,0:37:19.82,Default,,0,0,0,,Бұл жаман емес пе?
Dialogue: 0,0:37:23.53,0:37:26.32,Default,,0,0,0,,Анам да іштей уайымдаса керек.
Dialogue: 0,0:37:43.13,0:37:45.51,Default,,0,0,0,,Чими-Рё жиналатын жындар қаласы!
Dialogue: 0,0:37:45.59,0:37:48.51,Default,,0,0,0,,Хехехе, ақыры қондық.
Dialogue: 0,0:37:48.59,0:37:51.18,Default,,0,0,0,,Мына зұлым патшаның шынайы көздерінен діріл!
Dialogue: 0,0:37:48.59,0:37:51.18,Default,,0,0,0,,Ммм
Dialogue: 0,0:37:51.26,0:37:55.73,Default,,0,0,0,,Мм... күрсініп. Күткендей денем аздап ауырады.
Dialogue: 0,0:37:55.81,0:37:58.52,Default,,0,0,0,,- (Юта) Ах - (Рикка) Токи Юта Бүгінге қандай жоспарларыңыз бар?
Dialogue: 0,0:37:58.60,0:38:02.73,Default,,0,0,0,,Ұялы телефоныңызды өшірсеңіз, олардың қайда екені анықталмайды.
Dialogue: 0,0:38:02.82,0:38:05.44,Default,,0,0,0,,Қонатын жерді табыңыз
Dialogue: 0,0:38:05.53,0:38:09.24,Default,,0,0,0,,- (Юта) Тағы не... - (Рикка) Сиқырлы тасты іздеу?
Dialogue: 0,0:38:09.32,0:38:10.74,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:38:11.41,0:38:13.74,Default,,0,0,0,,Мен осында келдім.
Dialogue: 0,0:38:13.83,0:38:18.83,Default,,0,0,0,,♪「Өтінемін, мені қабылда♡」
Dialogue: 0,0:39:44.67,0:39:48.76,Default,,0,0,0,,Әй, мен бұл қылышты қалаймын.
Dialogue: 0,0:39:49.51,0:39:52.26,Default,,0,0,0,,Белгілі бір рөлдік ойынның ортасында
Dialogue: 0,0:39:52.34,0:39:56.31,Default,,0,0,0,,Мен оған байланып қалдым, себебі бұл мен алғаш күшейе бастағанда маған қамқор болған қару.
Dialogue: 0,0:39:56.39,0:39:59.60,Default,,0,0,0,,О, түсіндім! Мен оны сатып алуым керек еді
Dialogue: 0,0:39:59.68,0:40:00.89,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:40:00.98,0:40:02.27,Default,,0,0,0,,Важра!
Dialogue: 0,0:40:02.35,0:40:03.73,Default,,0,0,0,,Зергерлік бұйымдардың бір түрі
Dialogue: 0,0:40:04.73,0:40:07.11,Default,,0,0,0,,Намаз дөңгелегі~
Dialogue: 0,0:40:07.65,0:40:09.24,Default,,0,0,0,,- (Рикка) А... - (Юта) Бұл сенсің!
Dialogue: 0,0:40:09.32,0:40:10.90,Default,,0,0,0,,Ол қазір қашып жүр.
Dialogue: 0,0:40:10.99,0:40:13.16,Default,,0,0,0,,Ақшаң болса, оны ақылмен пайдалан!
Dialogue: 0,0:40:13.24,0:40:14.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:14.91,0:40:17.45,Default,,0,0,0,,Мен қашанға дейін осылай өмір сүремін?
Dialogue: 0,0:40:17.54,0:40:19.16,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:40:23.37,0:40:27.38,Default,,0,0,0,,Сізде сиқырлы күш бар болса, тамақ ішудің немесе ұйықтаудың қажеті жоқ.
Dialogue: 0,0:40:27.46,0:40:28.30,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:40:28.38,0:40:31.55,Default,,0,0,0,,Ффуфуфуфуфуфу~
Dialogue: 0,0:40:31.63,0:40:33.80,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:40:33.88,0:40:37.30,Default,,0,0,0,,Тока-санның жәрдемақысының көп бөлігін пайдаландың, солай ма?
Dialogue: 0,0:40:39.06,0:40:41.31,Default,,0,0,0,,- (Рикка) Анаңнан - (Юта) А?
Dialogue: 0,0:40:41.39,0:40:43.69,Default,,0,0,0,,Кейде жіберіледі
Dialogue: 0,0:40:58.24,0:40:59.99,Default,,0,0,0,,- (Юта) Рикка - (Рикка) А?
Dialogue: 0,0:41:00.08,0:41:02.41,Default,,0,0,0,,Сенің анаң қазір қайда?
Dialogue: 0,0:41:02.50,0:41:04.08,Default,,0,0,0,,Мен бұл солтүстік материк деп естідім.
Dialogue: 0,0:41:04.17,0:41:06.08,Default,,0,0,0,,Хоккайдо?
Dialogue: 0,0:41:08.96,0:41:10.63,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:41:10.71,0:41:11.76,Default,,0,0,0,,Не?
Dialogue: 0,0:41:11.84,0:41:14.01,Default,,0,0,0,,Жоқ, сен маған барғың келе ме?
Dialogue: 0,0:41:14.09,0:41:15.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:15.09,0:41:19.60,Default,,0,0,0,,Мүмкін сенің анаң Тоқа-санға бірдеңе жасайтын шығар.
Dialogue: 0,0:41:20.26,0:41:23.31,Default,,0,0,0,,Сонымен қатар, мен бір нәрсе туралы айтқым келеді.
Dialogue: 0,0:41:23.39,0:41:24.89,Default,,0,0,0,,- (Рикка) Юта? -(Юта) Иә.
Dialogue: 0,0:41:25.56,0:41:26.73,Default,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:41:29.32,0:41:30.15,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:41:30.23,0:41:32.74,Default,,0,0,0,,А-а, күте тұр, менің тұрған жерім белгілі болады.
Dialogue: 0,0:41:32.82,0:41:37.49,Default,,0,0,0,,Бірақ мұны көрмейінше, мен сіздің байланыс ақпаратыңызды немесе қайда екеніңізді білмеймін.
Dialogue: 0,0:41:38.49,0:41:39.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:41:46.50,0:41:49.59,Default,,0,0,0,,- (Юта) Бұл жерде бәрі жақсы шығар - (Рикка) Түсіндім.
Dialogue: 0,0:41:50.21,0:41:52.84,Default,,0,0,0,,Саусақтарымда жатқан сиқыр
Dialogue: 0,0:41:52.92,0:41:55.30,Default,,0,0,0,,Осы протокол кодын осында шақырыңыз...
Dialogue: 0,0:41:55.38,0:41:56.76,Default,,0,0,0,,- (Юта) Қайырлы таң - (Рикка) О!
Dialogue: 0,0:41:56.84,0:41:58.14,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:42:00.39,0:42:02.06,Default,,0,0,0,,Хоккайдо?
Dialogue: 0,0:42:19.70,0:42:21.83,Default,,0,0,0,,Енді тамақтанайық!
Dialogue: 0,0:42:21.91,0:42:25.70,Default,,0,0,0,,Бұл жігіт ақшаның күшін айтып жатыр.
Dialogue: 0,0:42:25.79,0:42:29.17,Default,,0,0,0,,Жалған жаз, мен аққан ажалмын~
Dialogue: 0,0:42:29.25,0:42:31.21,Default,,0,0,0,,Ол тамшылап тұрған жоқ!
Dialogue: 0,0:42:35.38,0:42:40.18,Default,,0,0,0,,Бұл еттің бай хош иісі мен серпімділігі тәбетіңізді ашады!
Dialogue: 0,0:42:40.26,0:42:42.97,Default,,0,0,0,,Мынаны жей алмайтын бейшара Өлім!
Dialogue: 0,0:42:43.06,0:42:47.98,Default,,0,0,0,,Жүр, тамақ іш, маған осы жеткілікті.
Dialogue: 0,0:42:48.06,0:42:49.73,Default,,0,0,0,,- (Нибутани) Иә? -(Декомори) Тістеп жеу өлім бе?
Dialogue: 0,0:42:49.81,0:42:51.31,Default,,0,0,0,,- (Нибутани) Ах - (Декомори) Хмм.
Dialogue: 0,0:42:51.40,0:42:53.61,Default,,0,0,0,,Тістеп алған дұрыс.
Dialogue: 0,0:42:53.69,0:42:58.61,Default,,0,0,0,,«Бұл жалған Жаз - Лорд Декоморидің қызметшісі», - деп ант етемін.
Dialogue: 0,0:42:58.70,0:43:00.49,Default,,0,0,0,,Кім айтады!
Dialogue: 0,0:43:00.57,0:43:02.03,Default,,0,0,0,,Тәтті өлім
Dialogue: 0,0:43:02.12,0:43:05.20,Default,,0,0,0,,Жалған жаз - Жалған жаз сияқты, тіпті емдік шөптерді жейді.
Dialogue: 0,0:43:06.50,0:43:08.58,Default,,0,0,0,,Салқын
Dialogue: 0,0:43:09.87,0:43:12.29,Default,,0,0,0,,А, сен не істеп жатырсың?!
Dialogue: 0,0:43:12.88,0:43:16.51,Default,,0,0,0,,Енді дәмді ірімшік стейкіңізден ләззат алыңыз!
Dialogue: 0,0:43:16.59,0:43:19.05,Default,,0,0,0,,Ажал тамаққа не береді!
Dialogue: 0,0:43:19.13,0:43:20.88,Default,,0,0,0,,Жемесең, мен саған жеймін.
Dialogue: 0,0:43:20.88,0:43:22.22,Default,,0,0,0,,Жемесең мен жеймін.
Dialogue: 0,0:43:20.88,0:43:22.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:22.89,0:43:23.72,Default,,0,0,0,,Га
Dialogue: 0,0:43:25.60,0:43:27.22,Default,,0,0,0,,Ұшып кет…
Dialogue: 0,0:43:28.93,0:43:31.60,Default,,0,0,0,,Жарайсың ба? Мен қайтадан тексеремін.
Dialogue: 0,0:43:31.69,0:43:33.69,Default,,0,0,0,,- (Юта) Мен ше? -(Рикка) Гельзониант
Dialogue: 0,0:43:33.77,0:43:36.94,Default,,0,0,0,,Жоқ! Мен саған ағам екеніңді қанша рет айтуым керек?
Dialogue: 0,0:43:38.11,0:43:41.16,Default,,0,0,0,,Бұл бетті жасама! Сіз оны осылай орнаттыңыз.
Dialogue: 0,0:43:41.24,0:43:42.36,Default,,0,0,0,,Параметр?
Dialogue: 0,0:43:42.45,0:43:44.53,Default,,0,0,0,,Иә, бұл камуфляж.
Dialogue: 0,0:43:44.62,0:43:48.00,Default,,0,0,0,,Әзірше біз ағайынды болып көрініп, бізді алдаңыз.
Dialogue: 0,0:43:48.08,0:43:51.25,Default,,0,0,0,,Хмм... бұл не? Жау!
Dialogue: 0,0:43:51.33,0:43:54.04,Default,,0,0,0,,- (Рикка) Жау? -(Юта) Біз жау емеспіз ғой.
Dialogue: 0,0:43:54.54,0:43:55.71,Default,,0,0,0,,Бұл қазір жақсы
Dialogue: 0,0:43:55.79,0:43:59.80,Default,,0,0,0,,Юта Какко Шынайы аты Герзониантус Какко Клоус
Dialogue: 0,0:43:59.88,0:44:00.76,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:44:00.84,0:44:05.22,Default,,0,0,0,,Рикка Которию Какко Джаох Шинган Какко Ең күшті Какко Жабу
Dialogue: 0,0:44:05.30,0:44:08.35,Default,,0,0,0,,Сонымен қатар, жақын жақша оның ағасы екенін білдіреді...
Dialogue: 0,0:44:08.43,0:44:10.52,Default,,0,0,0,,Мен мұны айтқанымда мені жек көрмейсің бе?
Dialogue: 0,0:44:10.60,0:44:11.85,Default,,0,0,0,,Мен егжей-тегжейлерді түсіндім!
Dialogue: 0,0:44:11.94,0:44:13.85,Default,,0,0,0,,Басқаша айтқанда, Юта менікі...
Dialogue: 0,0:44:13.94,0:44:15.06,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:44:17.27,0:44:19.23,Default,,0,0,0,,Үлкен аға болсаң...
Dialogue: 0,0:44:19.32,0:44:21.70,Default,,0,0,0,,Рикка қоңырау шалып жатыр, міне қара~
Dialogue: 0,0:44:22.32,0:44:26.83,Default,,0,0,0,,Рикка~ Менің жүктерімді алып, бара аласыз ба? Күрсін...
Dialogue: 0,0:44:26.91,0:44:28.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:44:28.20,0:44:31.46,Default,,0,0,0,,Мен ағамды тастап кете алмаймын.
Dialogue: 0,0:44:31.54,0:44:34.63,Default,,0,0,0,,Кейіпкер неге өзгерді...
Dialogue: 0,0:44:34.71,0:44:37.50,Default,,0,0,0,,Қандай қызық әпке.
Dialogue: 0,0:44:37.59,0:44:40.84,Default,,0,0,0,,Егер сіз осындай бірдеңе айтсаңыз, мен өзімді жақсы сезінер едім, әпке.
Dialogue: 0,0:44:48.60,0:44:50.97,Default,,0,0,0,,Бұл да жауды соқыр ету.
Dialogue: 0,0:44:51.06,0:44:53.85,Default,,0,0,0,,Қажеттіліктен ұятсыз еліктеушілік жасау
Dialogue: 0,0:44:53.94,0:44:55.19,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:44:57.36,0:44:59.36,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:44:59.44,0:45:02.82,Default,,0,0,0,,Басқа амал жоқ, ол толығымен брондалған дейді.
Dialogue: 0,0:45:04.03,0:45:06.12,Default,,0,0,0,,Бұл жер Декомориге тиесілі!
Dialogue: 0,0:45:06.20,0:45:08.95,Default,,0,0,0,,Шіріген жалған Морисама сонда ұйықтайды!
Dialogue: 0,0:45:09.03,0:45:12.83,Default,,0,0,0,,Неліктен бұлай? Сіз суық тиіп қаласыз!
Dialogue: 0,0:45:12.91,0:45:14.58,Default,,0,0,0,,Өлім мен білетін нәрсе емес
Dialogue: 0,0:45:16.58,0:45:18.50,Default,,0,0,0,,Маған да бер!
Dialogue: 0,0:45:18.59,0:45:19.84,Default,,0,0,0,,Мен оны жек көремін! Мен оны жек көремін!
Dialogue: 0,0:45:19.92,0:45:23.13,Default,,0,0,0,,Неге мен оны саған беруім керек?
Dialogue: 0,0:45:28.85,0:45:32.56,Default,,0,0,0,,Жарайсың ба? Кірсең төсегіңнен құлатамын!
Dialogue: 0,0:45:32.64,0:45:36.60,Default,,0,0,0,,Бұл жолдың өлімі! Өлім тез ұйықтайды
Dialogue: 0,0:45:36.69,0:45:39.06,Default,,0,0,0,,- (Нибутани) Маған берші - (Декомори) Ух~
Dialogue: 0,0:45:39.15,0:45:41.61,Default,,0,0,0,,- (Декомори) Суық өлім! -(Нибутани) Мен де суықпын!
Dialogue: 0,0:45:41.69,0:45:45.11,Default,,0,0,0,,- (Декомори) Декомори Сіз суыққа сезімталсыз! -(Нибутани) Мен де!
Dialogue: 0,0:45:45.20,0:45:48.74,Default,,0,0,0,,- (Декомори) Менің өлуден басқа амалым жоқ - (Нибутани) Үндет.
Dialogue: 0,0:46:00.46,0:46:04.13,Default,,0,0,0,,Менде апалық қасиеті жоқ екеніне тағы да көзім жетті.
Dialogue: 0,0:46:04.21,0:46:07.68,Default,,0,0,0,,Менің екі қарындасым бар.
Dialogue: 0,0:46:07.76,0:46:10.43,Default,,0,0,0,,Сондықтан менде оғаш қиялдар жоқ.
Dialogue: 0,0:46:14.39,0:46:18.19,Default,,0,0,0,,Қызық, Рикка не ойлайды? Саған берсем
Dialogue: 0,0:46:19.94,0:46:22.48,Default,,0,0,0,,Юта~
Dialogue: 0,0:46:24.82,0:46:26.07,Default,,0,0,0,,Не?
Dialogue: 0,0:46:31.74,0:46:33.49,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:46:33.58,0:46:36.66,Default,,0,0,0,,Бұл халат кішкентай...
Dialogue: 0,0:46:36.75,0:46:37.96,Default,,0,0,0,,Кіші
Dialogue: 0,0:46:38.04,0:46:39.71,Default,,0,0,0,,Әй, эй... келме!
Dialogue: 0,0:46:39.79,0:46:41.17,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:46:41.25,0:46:42.75,Default,,0,0,0,,Келме!
Dialogue: 0,0:46:45.38,0:46:48.68,Default,,0,0,0,,Балаларға арнап бір дайындауға барын салды ма деп ойлаймын.
Dialogue: 0,0:46:50.01,0:46:51.72,Default,,0,0,0,,Әзірше киімімді киіп ал.
Dialogue: 0,0:46:55.68,0:46:57.85,Default,,0,0,0,,Рикка да ұялып қалды.
Dialogue: 0,0:46:58.69,0:47:00.15,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:47:01.77,0:47:04.15,Default,,0,0,0,,Чууниб сен жақсы көресің бе?
Dialogue: 0,0:47:05.36,0:47:09.36,Default,,0,0,0,,Сол кезде де маған Рикка телефон соғып тұрған.
Dialogue: 0,0:47:10.11,0:47:11.53,Default,,0,0,0,,Мен кіші мектеп оқушысы кезімде де
Dialogue: 0,0:47:11.62,0:47:14.33,Default,,0,0,0,,Мені қызықтыратын қыздар жоқ сияқты.
Dialogue: 0,0:47:14.91,0:47:19.67,Default,,0,0,0,,Аға келісім-шарт ол үшін нені білдіреді?
Dialogue: 0,0:47:41.90,0:47:43.02,Default,,0,0,0,,Ах
Dialogue: 0,0:47:49.07,0:47:51.91,Default,,0,0,0,,Бұл не? Егер бұл драма болса, олар осындай уақытта сүйіседі ме?
Dialogue: 0,0:47:51.99,0:47:53.28,Default,,0,0,0,,Жоқ. Сіз мұны шынайы өмірде жасайсыз ба?
Dialogue: 0,0:47:53.37,0:47:55.74,Default,,0,0,0,,Шетелдік адам мұны істей ме? Жоқ, жоқ, жоқ, мен жапонмын.
Dialogue: 0,0:47:55.83,0:47:57.24,Default,,0,0,0,,Жапондықтар ұялшақ
Dialogue: 0,0:47:57.33,0:47:59.96,Default,,0,0,0,,Иә, мен ғана ма? Жапондықтар да солай істей ме?
Dialogue: 0,0:48:00.04,0:48:02.79,Default,,0,0,0,,Бұл басқа адамның сезіміне және уақытына байланысты.
Dialogue: 0,0:48:02.88,0:48:06.00,Default,,0,0,0,,О, құдай, мен не істеуім керек?
Dialogue: 0,0:48:06.09,0:48:07.96,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:48:08.05,0:48:09.67,Default,,0,0,0,,Не? Бұл нені білдіреді?
Dialogue: 0,0:48:31.36,0:48:35.74,Default,,0,0,0,,Ха, әке, шеше, әпке
Dialogue: 0,0:48:35.82,0:48:38.91,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:48:41.83,0:48:45.63,Default,,0,0,0,,- (Декомори) Жылы өлім... - (Нибутани) Қықылдап...
Dialogue: 0,0:48:45.71,0:48:46.54,Default,,0,0,0,,(Мобильді камера ысырмасының дыбысы)
Dialogue: 0,0:48:46.63,0:48:47.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:50.88,0:48:52.13,Default,,0,0,0,,Сіз қанша уақыт ұйықтадыңыз?
Dialogue: 0,0:48:52.22,0:48:53.59,Default,,0,0,0,,Kyaah~
Dialogue: 0,0:48:53.68,0:48:56.26,Default,,0,0,0,,Осы фотосуретті дәл қазір жүктеп салуым керек пе?
Dialogue: 0,0:48:56.35,0:48:58.51,Default,,0,0,0,,- (Нибутани) Тоқта! -(Декомори) Жақсы емес!
Dialogue: 0,0:48:58.60,0:49:01.93,Default,,0,0,0,,Қазір дайындалыңыз. Асықсаңыз, уақытында үлгеруіңіз керек.
Dialogue: 0,0:49:03.81,0:49:05.40,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:49:06.31,0:49:08.73,Default,,0,0,0,,- (Нибутани) Жүр, кеттік - (Декомори) Не істейсің?
Dialogue: 0,0:49:12.82,0:49:14.74,Default,,0,0,0,,Уау...
Dialogue: 0,0:49:14.82,0:49:17.91,Default,,0,0,0,,Юта: Мүмкін сен осы жігіттердің біреуіне мінерсің?
Dialogue: 0,0:49:17.99,0:49:19.79,Default,,0,0,0,,Аа, бұл сіздің бірінші ретіңіз бе?
Dialogue: 0,0:49:20.41,0:49:23.16,Default,,0,0,0,,Бұл менің жаңа қанаттарым
Dialogue: 0,0:49:23.25,0:49:26.88,Default,,0,0,0,,Қанаттарым үшін әркімнің еңбегі.
Dialogue: 0,0:49:26.96,0:49:29.25,Default,,0,0,0,,- (Юта) Дөрекі болма - (Рикка) А!
Dialogue: 0,0:49:30.42,0:49:32.88,Default,,0,0,0,,Сіз жаңа әдістерді жасай аласыз
Dialogue: 0,0:49:32.96,0:49:35.26,Default,,0,0,0,,Schwarz Sonic Heaven's Shoot
Dialogue: 0,0:49:35.34,0:49:37.14,Default,,0,0,0,,Жер бетінен 8000 метр биіктіктен
Dialogue: 0,0:49:37.22,0:49:40.60,Default,,0,0,0,,Зұлым патшаның шынайы көздерінің сиқырлы күшін бір нүктеге шоғырландырып, оны іске қосыңыз!
Dialogue: 0,0:49:42.68,0:49:45.60,Default,,0,0,0,,Ұшақ жақсы болуы мүмкін...
Dialogue: 0,0:49:45.69,0:49:48.23,Default,,0,0,0,,- (Рикка) Жақсы шығар! -(Юта) Иә, иә.
Dialogue: 0,0:49:48.31,0:49:50.44,Default,,0,0,0,,- (Юта) Ой, бұл жаман - (Рикка) Не болды?
Dialogue: 0,0:49:52.82,0:49:54.24,Default,,0,0,0,,Нибутани және т.б
Dialogue: 0,0:49:54.32,0:49:57.28,Default,,0,0,0,,Жарайсың ба? Егер сіз оны тапсаңыз, мен сізге дереу хабарласамын.
Dialogue: 0,0:49:57.36,0:49:59.24,Default,,0,0,0,,Бірден бұйрық берме.
Dialogue: 0,0:49:59.32,0:50:03.45,Default,,0,0,0,,Сіз мені қуып жүрсіз бе? Мұнда ұшақ келетін еді.
Dialogue: 0,0:50:03.54,0:50:06.62,Default,,0,0,0,,Көрінбеу үшін жоғалып, қозғалыңыз
Dialogue: 0,0:50:11.13,0:50:13.51,Default,,0,0,0,,Шамасы, біз қайда баруға тырысамыз?
Dialogue: 0,0:50:13.59,0:50:14.97,Default,,0,0,0,,Сіз түсінген сияқтысыз.
Dialogue: 0,0:50:15.05,0:50:16.47,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:50:17.93,0:50:19.47,Default,,0,0,0,,- (Юта) Иә - (Рикка) Иә?
Dialogue: 0,0:50:20.05,0:50:24.06,Default,,0,0,0,,Ұшақтан түскен бойда буксир болды.
Dialogue: 0,0:50:24.64,0:50:28.60,Default,,0,0,0,,Әйтеуір, міндетті түрде келемін дедіңіз, бірақ бұл рас па деп ойлаймын...
Dialogue: 0,0:50:28.69,0:50:31.48,Default,,0,0,0,,Қоңырауыңызды қабылдағымыз келеді.
Dialogue: 0,0:50:31.57,0:50:35.57,Default,,0,0,0,,Жалған сиқыршылар қауымдастығынан Морисама-сама
Dialogue: 0,0:50:35.65,0:50:39.57,Default,,0,0,0,,Жалған сиқыршылар қауымдастығынан Морисама-сама
Dialogue: 0,0:50:39.66,0:50:42.28,Default,,0,0,0,,Санае Декомори сізді күтуде.
Dialogue: 0,0:50:39.66,0:50:42.28,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:50:42.37,0:50:45.54,Default,,0,0,0,,Тез арада 2-ақпараттық үстелге келіңіз.
Dialogue: 0,0:50:46.46,0:50:48.25,Default,,0,0,0,,- (Юта) Жарайды, кеттік - (Рикка) Иә.
Dialogue: 0,0:50:56.84,0:50:58.59,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:50:59.30,0:51:00.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:00.93,0:51:03.60,Default,,0,0,0,,- (Юта) Рикка? - (Рикка) Уф... атпа.
Dialogue: 0,0:51:03.68,0:51:05.06,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:51:05.14,0:51:08.73,Default,,0,0,0,,Сіз металл бұйымдарды киіп жүрсіз бе?
Dialogue: 0,0:51:10.60,0:51:12.94,Default,,0,0,0,,- (Рикка) Бұл... Қару - (Қауіпсіздікті тексеретін қызметкерлер) Иә!?
Dialogue: 0,0:51:14.73,0:51:18.86,Default,,0,0,0,,Schwarzzechs Prototype Mk (Марк) II (Екі)
Dialogue: 0,0:51:18.95,0:51:20.24,Default,,0,0,0,,Әй!
Dialogue: 0,0:51:20.78,0:51:22.78,Default,,0,0,0,,Кешіріңіз, кешіріңіз, кешіріңіз!
Dialogue: 0,0:51:22.87,0:51:24.28,Default,,0,0,0,,- (Юта) Шынымен кешіріңіз - (Қауіпсіздікті тексеретін қызметкер) Қолшатыр әкелуге болмайды.
Dialogue: 0,0:51:24.37,0:51:26.45,Default,,0,0,0,,Бір адамға бір.
Dialogue: 0,0:51:26.54,0:51:28.46,Default,,0,0,0,,Менде біреуі болады.
Dialogue: 0,0:51:28.54,0:51:32.42,Default,,0,0,0,,Ах~ах Декомори - қожайынның қызметшісі
Dialogue: 0,0:51:32.50,0:51:37.76,Default,,0,0,0,,Бастапқыда мен бұлай істегім келмеді...Өлім!
Dialogue: 0,0:51:37.84,0:51:42.55,Default,,0,0,0,,Құпия қоғамның тұрақтылығы үшін және қожайынмен болашақ өмірі үшін.
Dialogue: 0,0:51:43.64,0:51:46.60,Default,,0,0,0,,Міне, жалған Жазға қатысты жанжал...
Dialogue: 0,0:51:46.68,0:51:47.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:47.60,0:51:48.77,Default,,0,0,0,,Бір минут, сен
Dialogue: 0,0:51:48.85,0:51:51.73,Default,,0,0,0,,Неге мені бұл ұят атаумен атайсың?
Dialogue: 0,0:51:52.56,0:51:56.27,Default,,0,0,0,,Неге мұндасың? Постыңызды қалдырмаңыз!
Dialogue: 0,0:51:56.36,0:51:58.40,Default,,0,0,0,,Бұл мені шақырғаныңыз үшін!
Dialogue: 0,0:51:58.49,0:52:00.24,Default,,0,0,0,,Декомори туралы не деуге болады?
Dialogue: 0,0:52:00.32,0:52:04.41,Default,,0,0,0,,Неліктен Декомори сізді шақыруы керек?
Dialogue: 0,0:52:06.49,0:52:08.41,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:52:11.08,0:52:11.92,Default,,0,0,0,,Иә
Dialogue: 0,0:52:12.00,0:52:13.79,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:52:13.88,0:52:17.88,Default,,0,0,0,,Маған қоңырау шалсаңыз, сол жерден кірдіңіз деген сөз.
Dialogue: 0,0:52:20.55,0:52:22.93,Default,,0,0,0,,Сіз қауіпсіздікті тексеруді аяқтадыңыз ба?
Dialogue: 0,0:52:23.01,0:52:24.18,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:52:35.94,0:52:38.57,Default,,0,0,0,,- (Декомори) Әй, қожайын өлім! -(Нибутани) А? Қай жерде?
Dialogue: 0,0:52:39.90,0:52:41.95,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:52:42.03,0:52:44.53,Default,,0,0,0,,А, кеттік!
Dialogue: 0,0:52:45.95,0:52:47.95,Default,,0,0,0,,- (Рикка) Декомори! -(Юта) А?
Dialogue: 0,0:52:48.03,0:52:49.20,Default,,0,0,0,,Сенің көздерің жақсы.
Dialogue: 0,0:52:54.79,0:52:58.92,Default,,0,0,0,,- (Нибутани) Тогаши-кун! -(Декомори) Ұстаз!
Dialogue: 0,0:53:01.01,0:53:03.43,Default,,0,0,0,,Қарғыс атқыр... Мына жігіт шындап ұшады ма?
Dialogue: 0,0:53:03.51,0:53:05.14,Default,,0,0,0,,Рикка Тістеріңді қайраңдар!
Dialogue: 0,0:53:05.22,0:53:06.55,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:53:06.64,0:53:07.51,Default,,0,0,0,,Оххх
Dialogue: 0,0:53:14.27,0:53:15.85,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:53:17.36,0:53:22.07,Default,,0,0,0,,Ұстаз, дөңес қорғағышты артта қалдырмаңыз...
Dialogue: 0,0:53:31.58,0:53:35.92,Default,,0,0,0,,Бұл нағыз Курукуру Жер. Өйткені, жер бетінде шекара жоқ.
Dialogue: 0,0:53:36.00,0:53:36.83,Default,,0,0,0,,That's right.
Dialogue: 0,0:53:36.92,0:53:42.34,Default,,0,0,0,,Хехехе, күтіңіз, Кеңес Одағы мен Америка Құрама Штаттары.
Dialogue: 0,0:53:42.42,0:53:45.80,Default,,0,0,0,,Сіз немен күресіп жатырсыз?
Dialogue: 0,0:53:45.88,0:53:48.35,Default,,0,0,0,,Сіз не ішкіңіз келеді?
Dialogue: 0,0:53:48.43,0:53:51.26,Default,,0,0,0,,О~ Сусындар беріледі ме?
Dialogue: 0,0:53:51.85,0:53:53.81,Default,,0,0,0,,Ыстық қара кофе
Dialogue: 0,0:53:54.98,0:53:56.06,Default,,0,0,0,,Ыстық қара кофе
Dialogue: 0,0:53:56.14,0:53:56.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:04.86,0:54:07.24,Default,,0,0,0,,Мен келесі нұсқауларды күтемін деп ойлаймын.
Dialogue: 0,0:54:07.32,0:54:09.24,Default,,0,0,0,,Көмек беруге болмайтын өлім
Dialogue: 0,0:54:16.58,0:54:18.88,Default,,0,0,0,,Зұлым патша Шинган түседі!
Dialogue: 0,0:54:19.29,0:54:20.13,Default,,0,0,0,,Суық!
Dialogue: 0,0:54:20.21,0:54:23.51,Default,,0,0,0,,Көктем болса да, мұнда әлі суық.
Dialogue: 0,0:54:23.59,0:54:28.01,Default,,0,0,0,,Мифтік аңдар мекендеген солтүстік континенттен күткендей.
Dialogue: 0,0:54:28.72,0:54:31.05,Default,,0,0,0,,- (Юта) Жарайды, кеттік - (Рикка) Түсінді.
Dialogue: 0,0:54:31.81,0:54:34.52,Default,,0,0,0,,Шәкін Шәкін!
Dialogue: 0,0:54:34.60,0:54:37.10,Default,,0,0,0,,Қорғаныс күші 120-ға артты!
Dialogue: 0,0:54:37.19,0:54:38.73,Default,,0,0,0,,Жоқ, мен байсалдымын.
Dialogue: 0,0:54:38.81,0:54:41.61,Default,,0,0,0,,Бұл өте қиын болып барады.
Dialogue: 0,0:54:41.69,0:54:44.23,Default,,0,0,0,,Менде енді алуға онша көп ақша жоқ.
Dialogue: 0,0:54:44.73,0:54:47.36,Default,,0,0,0,,Сонда мен қай жолмен жүруім керек?
Dialogue: 0,0:54:52.53,0:54:53.79,Default,,0,0,0,,Мүмкін сонда
Dialogue: 0,0:54:53.87,0:54:56.83,Default,,0,0,0,,Кешіріңіз, мен мұнда ешқашан болған емеспін.
Dialogue: 0,0:54:56.91,0:54:58.50,Default,,0,0,0,,- (Рикка) Эй Юта - (Юта) А?
Dialogue: 0,0:54:58.58,0:55:02.25,Default,,0,0,0,,Анаңмен не туралы сөйлескің келеді?
Dialogue: 0,0:55:02.34,0:55:03.67,Default,,0,0,0,,Не? қозғалыс
Dialogue: 0,0:55:03.75,0:55:05.84,Default,,0,0,0,,Уа, бірдеңе дұрыс емес пе?
Dialogue: 0,0:55:05.92,0:55:07.55,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:55:07.63,0:55:09.88,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:55:09.97,0:55:12.97,Default,,0,0,0,,Жоқ, бұл үлкен мәселе емес.
Dialogue: 0,0:55:14.56,0:55:15.39,Default,,0,0,0,,Юта
Dialogue: 0,0:55:17.43,0:55:18.77,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:55:19.27,0:55:22.15,Default,,0,0,0,,Мәңгі үндемей қалсаң, Риккаға да ұнамайды.
Dialogue: 0,0:55:24.98,0:55:26.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:29.24,0:55:31.87,Default,,0,0,0,,- (Юта) Қарапайым сөзбен айтқанда, болашақ туралы - (Рикка) Болашақ!?
Dialogue: 0,0:55:31.95,0:55:36.24,Default,,0,0,0,,Бұл соңғы шайқас пен ескі билеушілердің қайта тірілуін білдіреді...
Dialogue: 0,0:55:36.33,0:55:37.41,Default,,0,0,0,,Жоқ
Dialogue: 0,0:55:37.50,0:55:41.88,Default,,0,0,0,,Бұл Рагнароктағы ақырғы кітаптың үшінші томына енгізілген...
Dialogue: 0,0:55:41.96,0:55:43.46,Default,,0,0,0,,Бұл да басқаша.
Dialogue: 0,0:55:43.54,0:55:45.88,Default,,0,0,0,,Басқа фьючерстер…
Dialogue: 0,0:55:45.96,0:55:47.59,Default,,0,0,0,,- (Рикка) Болмайды! -(Юта) Жоқ!
Dialogue: 0,0:55:47.67,0:55:49.80,Default,,0,0,0,,Сен қайдан білесің!? Сіз менің ойларымды оқыдыңыз ба?
Dialogue: 0,0:55:49.88,0:55:51.22,Default,,0,0,0,,Оқымай-ақ түсінуге болады!
Dialogue: 0,0:55:52.14,0:55:54.22,Default,,0,0,0,,Бұл жақын болашақ туралы.
Dialogue: 0,0:55:54.30,0:55:55.89,Default,,0,0,0,,Жақын болашақ қандай?
Dialogue: 0,0:55:57.47,0:55:59.23,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:56:00.35,0:56:01.35,Default,,0,0,0,,
Dialogue: 0,0:56:02.02,0:56:04.23,Default,,0,0,0,,Қараңызшы, мен мұны бұрын айтқанмын.
Dialogue: 0,0:56:04.98,0:56:06.48,Default,,0,0,0,,«Мен Рикканың жағындамын»
Dialogue: 0,0:56:07.98,0:56:10.03,Default,,0,0,0,,«Мен тек Риккаға қарап тұрмын»
Dialogue: 0,0:56:12.07,0:56:14.49,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:56:15.08,0:56:17.20,Default,,0,0,0,,Рикканың анасына осындай әңгіме
Dialogue: 0,0:56:17.29,0:56:19.75,Default,,0,0,0,,Ешқашан дұрыс сөйлеспедік деп ойладым.
Dialogue: 0,0:56:19.83,0:56:22.96,Default,,0,0,0,,- (Рикка) Осыны айтып тұрсың ба? -(Юта) Жоқ, сондықтан...
Dialogue: 0,0:56:23.50,0:56:24.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:36.30,0:56:38.81,Default,,0,0,0,,Мен жай ғана жоғары сынып оқушысымын.
Dialogue: 0,0:56:45.52,0:56:48.61,Default,,0,0,0,,Мен оны дұрыс сатып аламын, өйткені мен оны дұрыс уақытта сатып аламын.
Dialogue: 0,0:56:56.66,0:56:58.83,Default,,0,0,0,,Әзірше бұл дәлел.
Dialogue: 0,0:56:59.87,0:57:01.33,Default,,0,0,0,,Айғақ?
Dialogue: 0,0:57:02.08,0:57:03.96,Default,,0,0,0,,Мен әрқашан Рикканың жанында боламын.
Dialogue: 0,0:57:13.30,0:57:14.38,Default,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:57:14.47,0:57:15.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:57:17.47,0:57:19.68,Default,,0,0,0,,J… Оны өзіңіз бекітіңіз!
Dialogue: 0,0:57:19.76,0:57:20.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:57:20.97,0:57:23.56,Default,,0,0,0,,Жау Шинган осылай дейді.
Dialogue: 0,0:57:25.56,0:57:26.40,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:57:44.16,0:57:46.12,Default,,0,0,0,,Кішкентай емес пе еді?
Dialogue: 0,0:57:49.17,0:57:50.96,Default,,0,0,0,,Ыңғайлы
Dialogue: 0,0:57:51.05,0:57:53.97,Default,,0,0,0,,Түсінемін, бұл жақсы.
Dialogue: 0,0:57:55.88,0:57:58.85,Default,,0,0,0,,- (Рикка) Ей... кеттік - (Юта) Ой, эй, қолғаптар!
Dialogue: 0,0:57:58.93,0:58:01.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:01.51,0:58:03.27,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:58:04.31,0:58:05.64,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:58:06.52,0:58:07.77,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:58:07.85,0:58:09.69,Default,,0,0,0,,Жарайды
Dialogue: 0,0:58:20.91,0:58:24.95,Default,,0,0,0,,Жарайсың ба? Жеңілген адам екінші тарапқа да төлейді.
Dialogue: 0,0:58:25.04,0:58:27.29,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:58:27.37,0:58:30.46,Default,,0,0,0,,Декомори - көп жейтін өлім.
Dialogue: 0,0:58:39.84,0:58:42.22,Default,,0,0,0,,Сырт келбетіне қарамастан, тәбет қандай!
Dialogue: 0,0:58:42.31,0:58:43.60,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:58:47.77,0:58:48.85,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:58:48.94,0:58:50.98,Default,,0,0,0,,Ол қиналып жатқанда...
Dialogue: 0,0:58:51.06,0:58:52.57,Default,,0,0,0,,Хмм!?
Dialogue: 0,0:58:52.65,0:58:54.07,Default,,0,0,0,,Біраз уақыт кетті!
Dialogue: 0,0:58:54.15,0:58:57.49,Default,,0,0,0,,Сенің таяз даналығыңның не екенін білмеймін...
Dialogue: 0,0:58:57.57,0:59:00.87,Default,,0,0,0,,(Азап дауысы)
Dialogue: 0,0:59:01.95,0:59:03.45,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:59:10.96,0:59:13.75,Default,,0,0,0,,Аа, мен бұл жерді бұрын көргенмін.
Dialogue: 0,0:59:28.35,0:59:31.52,Default,,0,0,0,,Жұмысқа байланысты болса да, қиын, мама.
Dialogue: 0,0:59:32.19,0:59:33.90,Default,,0,0,0,,Мен әртүрлі жерлерге бардым.
Dialogue: 0,0:59:33.98,0:59:36.40,Default,,0,0,0,,Иә, өйткені бізде жұмыс күші жеткіліксіз.
Dialogue: 0,0:59:36.48,0:59:38.74,Default,,0,0,0,,That's what you were talking about.
Dialogue: 0,0:59:38.82,0:59:39.65,Default,,0,0,0,,Иә
Dialogue: 0,0:59:39.74,0:59:44.62,Default,,0,0,0,,Код айына бір рет протокол коды арқылы жіберіледі.
Dialogue: 0,0:59:44.70,0:59:47.29,Default,,0,0,0,,Photos and recent events
Dialogue: 0,0:59:48.04,0:59:50.50,Default,,0,0,0,,Рикканың жауабы қандай?
Dialogue: 0,0:59:50.58,0:59:52.63,Default,,0,0,0,,Tell me about Yuta
Dialogue: 0,0:59:52.71,0:59:56.55,Default,,0,0,0,,Қараңғы жалын шебері Джау Шинганнан кейінгі ең күшті.
Dialogue: 0,0:59:56.63,0:59:59.09,Default,,0,0,0,,Disappear in the flames of darkness!
Dialogue: 0,0:59:59.17,1:00:01.22,Default,,0,0,0,,Бұл сіз жіберіп жатқан нәрсе ме?
Dialogue: 0,1:00:01.30,1:00:02.72,Default,,0,0,0,,Иә
Dialogue: 0,1:00:02.80,1:00:04.97,Default,,0,0,0,,- (Рикка) Мені әрқашан қуантады - (Юта) А?
Dialogue: 0,1:00:05.05,1:00:08.85,Default,,0,0,0,,Әрқашан бір нәрсені айтады: «Рикка Юта туралы айтып жатыр...»
Dialogue: 0,1:00:11.73,1:00:12.90,Default,,0,0,0,,Рикка Юта-кунды ойлап отыр.
Dialogue: 0,1:00:12.98,1:00:14.77,Default,,0,0,0,,You really like it.
Dialogue: 0,1:00:14.86,1:00:17.07,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,1:00:17.15,1:00:18.61,Default,,0,0,0,,О, не? Кенеттен
Dialogue: 0,1:00:18.69,1:00:21.24,Default,,0,0,0,,Don't read my thoughts now!
Dialogue: 0,1:00:21.32,1:00:23.20,Default,,0,0,0,,No, don't read it separately.
Dialogue: 0,1:00:24.91,1:00:26.20,Default,,0,0,0,,Ah, hey, then I Ран...
Dialogue: 0,1:00:26.28,1:00:27.16,Default,,0,0,0,,Кя
Dialogue: 0,1:00:27.24,1:00:29.75,Default,,0,0,0,,- (Yuta) Ah~ Look - (Rikka) Ah~
Dialogue: 0,1:00:29.83,1:00:30.75,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:31.41,1:00:32.46,Default,,0,0,0,,
Dialogue: 0,1:00:37.59,1:00:39.05,Default,,0,0,0,,Looks like you're away.
Dialogue: 0,1:00:40.88,1:00:43.22,Default,,0,0,0,,Well, it's a weekday afternoon.
Dialogue: 0,1:00:44.80,1:00:47.60,Default,,0,0,0,,Can I call your mom?
Dialogue: 0,1:00:57.36,1:00:58.86,Default,,0,0,0,,Rikka, do you want to talk?
Dialogue: 0,1:01:00.78,1:01:01.61,Default,,0,0,0,,Иә
Dialogue: 0,1:01:07.12,1:01:09.37,Default,,0,0,0,,Yes, Moshi Moshi, I'm Kotoriyu.
Dialogue: 0,1:01:09.45,1:01:10.50,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:01:10.58,1:01:11.62,Default,,0,0,0,,Рикка?
Dialogue: 0,1:01:11.70,1:01:14.79,Default,,0,0,0,,Yeah, I'm coming to the house now.
Dialogue: 0,1:01:15.58,1:01:16.63,Default,,0,0,0,,Рас
Dialogue: 0,1:01:17.79,1:01:21.63,Default,,0,0,0,,Бүгін келді. Ұшақтағы бар.
Dialogue: 0,1:01:22.51,1:01:26.30,Default,,0,0,0,,- (Рикка) Мен қазір жұмыс бойынша басқа жердемін - (Юта) Солай ма?
Dialogue: 0,1:01:26.39,1:01:27.30,Default,,0,0,0,,Иә
Dialogue: 0,1:01:28.97,1:01:29.85,Default,,0,0,0,,Иә
Dialogue: 0,1:01:31.06,1:01:31.89,Default,,0,0,0,,Иә
Dialogue: 0,1:01:35.98,1:01:39.65,Default,,0,0,0,,Мен жақында ораламын, сондықтан бір күн күтіңіз.
Dialogue: 0,1:01:40.40,1:01:41.36,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:01:44.74,1:01:45.82,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:01:45.91,1:01:48.41,Default,,0,0,0,,Кешіріңіз, менде қазір біраз жұмыс бар...
Dialogue: 0,1:01:48.49,1:01:50.12,Default,,0,0,0,,Мен ертең қайта аламын.
Dialogue: 0,1:01:50.20,1:01:52.87,Default,,0,0,0,,No, we're the ones who came suddenly.
Dialogue: 0,1:01:53.71,1:01:55.33,Default,,0,0,0,,Қазір қайсысы?
Dialogue: 0,1:01:55.42,1:01:57.38,Default,,0,0,0,,Мазасыздық болмаса, мен барамын.
Dialogue: 0,1:01:57.46,1:01:59.59,Default,,0,0,0,,Менің айтқым келетін нәрсе бар.
Dialogue: 0,1:02:00.04,1:02:00.88,Default,,0,0,0,,Иә
Dialogue: 0,1:02:03.46,1:02:04.38,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:02:04.47,1:02:07.05,Default,,0,0,0,,Жарайды, Рикка, дереу қозғалайық.
Dialogue: 0,1:02:07.14,1:02:08.01,Default,,0,0,0,,Иә
Dialogue: 0,1:02:16.44,1:02:19.11,Default,,0,0,0,,- (Yuta) Hey Rikka - (Rikka) Ah yeah.
Dialogue: 0,1:02:23.03,1:02:25.19,Default,,0,0,0,,Өлім келді! солтүстік жер
Dialogue: 0,1:02:25.74,1:02:27.03,Default,,0,0,0,,Суық
Dialogue: 0,1:02:28.16,1:02:31.28,Default,,0,0,0,,- (Декомори) Өлім еш жерде жоқ - (Нибутани) Ол қайда?
Dialogue: 0,1:02:31.91,1:02:34.25,Default,,0,0,0,,Мен сол мисо рамен дүкенінде болуым мүмкін!
Dialogue: 0,1:02:34.33,1:02:35.66,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,1:02:36.54,1:02:39.25,Default,,0,0,0,,This Genghis Khan restaurant is more suspicious!
Dialogue: 0,1:02:39.92,1:02:42.04,Default,,0,0,0,,Сорпа карриі де тастай алмайтын тәтті тағам.
Dialogue: 0,1:02:42.13,1:02:44.67,Default,,0,0,0,,Оны іздеуді қайдан бастау керек?
Dialogue: 0,1:02:44.76,1:02:45.88,Default,,0,0,0,,Өлім өте өкінішті
Dialogue: 0,1:02:45.97,1:02:48.93,Default,,0,0,0,,I have no choice but to visit one house at a time.
Dialogue: 0,1:02:49.72,1:02:53.06,Default,,0,0,0,,Мен сіздің пікіріңізге құлықсыз қосыламын. Ең алдымен...
Dialogue: 0,1:02:53.14,1:02:54.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:58.52,1:03:00.65,Default,,0,0,0,,«Мен оны жаңа ғана интернетке жүктеп салдым»
Dialogue: 0,1:02:58.52,1:03:00.65,Default,,0,0,0,,күрсіну...
Dialogue: 0,1:03:00.73,1:03:03.15,Default,,0,0,0,,«Келесі, мозаика шығады».
Dialogue: 0,1:03:03.23,1:03:05.28,Default,,0,0,0,,Мен... мен барамын.
Dialogue: 0,1:03:15.20,1:03:18.16,Default,,0,0,0,,- (Юта) Пойыз ауруы жақсы ма? -(Рикка) Иә.
Dialogue: 0,1:03:18.25,1:03:20.63,Default,,0,0,0,,Жүкке абай болыңыз.
Dialogue: 0,1:03:20.71,1:03:21.83,Default,,0,0,0,,Иә
Dialogue: 0,1:03:23.67,1:03:25.63,Default,,0,0,0,,Мына пердені жабайын ба?
Dialogue: 0,1:03:27.47,1:03:29.34,Default,,0,0,0,,- (Рикка) Юта - (Юта) Иә?
Dialogue: 0,1:03:29.43,1:03:32.60,Default,,0,0,0,,Бұл сақинада біртүрлі нәрсе бар.
Dialogue: 0,1:03:34.10,1:03:34.97,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,1:03:35.06,1:03:39.98,Default,,0,0,0,,When I wear it, it feels like my Пауэр is being absorbed.
Dialogue: 0,1:03:41.90,1:03:45.90,Default,,0,0,0,,Rather, it's a Пауэр-up item, Jaou Shingan!
Dialogue: 0,1:03:45.98,1:03:48.49,Default,,0,0,0,,Сонымен... Джау Шинган?
Dialogue: 0,1:03:49.07,1:03:49.90,Default,,0,0,0,,Иә
Dialogue: 0,1:03:54.53,1:03:56.49,Default,,0,0,0,,Ұнамады ма?
Dialogue: 0,1:03:56.58,1:04:00.29,Default,,0,0,0,,Уау, бұл өте керемет, бұл ең күшті!
Dialogue: 0,1:04:00.37,1:04:02.50,Default,,0,0,0,,Зұлым патша Шинганға жарамды!
Dialogue: 0,1:04:06.46,1:04:08.26,Default,,0,0,0,,Оны күштеп қосудың қажеті жоқ.
Dialogue: 0,1:04:08.88,1:04:11.72,Default,,0,0,0,,Бұл мүмкін емес Мен өте бақыттымын
Dialogue: 0,1:04:12.39,1:04:15.35,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,1:04:17.39,1:04:19.93,Default,,0,0,0,,It's early tomorrow, so I guess I'll go to bed for now.
Dialogue: 0,1:04:20.02,1:04:21.10,Default,,0,0,0,,Иә
Dialogue: 0,1:04:24.40,1:04:25.77,Default,,0,0,0,,Дәретхана
Dialogue: 0,1:04:25.86,1:04:27.07,Default,,0,0,0,,О
Dialogue: 0,1:04:39.37,1:04:42.37,Default,,0,0,0,,Аа, мені елемеңіз. Сіз байқадыңыз, солай ма?
Dialogue: 0,1:04:42.46,1:04:45.38,Default,,0,0,0,,- (Юта) Сен де қуғыншысың ба? -(Исшики) Не айтып тұрсың?
Dialogue: 0,1:04:45.46,1:04:47.96,Default,,0,0,0,,Күйеу, сен жассың.
Dialogue: 0,1:04:48.05,1:04:51.67,Default,,0,0,0,,- (Юта) Неге келдің? -(Исшики) Жоқ~ Кездейсоқ Сәйкестік
Dialogue: 0,1:04:51.76,1:04:56.35,Default,,0,0,0,,Қарашы, Күмін-сенпай биылғы көктемде бітірді.
Dialogue: 0,1:04:56.85,1:05:00.60,Default,,0,0,0,,I went on a solo trip to heal my broken heart.
Dialogue: 0,1:05:00.68,1:05:02.39,Default,,0,0,0,,Мен естіген дауысты естимін.
Dialogue: 0,1:05:03.02,1:05:05.44,Default,,0,0,0,,Адамдардың айтқанын тыңдаңыз!
Dialogue: 0,1:05:05.52,1:05:07.61,Default,,0,0,0,,Қайырлы түн (Исшики) Таку
Dialogue: 0,1:05:37.97,1:05:39.39,Default,,0,0,0,,Ғашық?
Dialogue: 0,1:05:39.47,1:05:40.77,Default,,0,0,0,,Иә
Dialogue: 0,1:05:41.35,1:05:43.02,Default,,0,0,0,,ni~hahahaha!
Dialogue: 0,1:05:43.10,1:05:46.52,Default,,0,0,0,,Күткендей, дәл София қарап тұрғандай болды!
Dialogue: 0,1:05:50.48,1:05:53.32,Default,,0,0,0,,Ғашықтар шартын жасау дегеніміз не?
Dialogue: 0,1:05:53.40,1:05:56.78,Default,,0,0,0,,Сол сезімді қабылдағанда күш-қуатыңыз жоғалады.
Dialogue: 0,1:05:57.57,1:05:59.91,Default,,0,0,0,,Мен енді бұрынғыдай өмір сүре алмаймын.
Dialogue: 0,1:06:01.45,1:06:04.46,Default,,0,0,0,,Сондықтан мен «өзгеріссіз» таңдадым
Dialogue: 0,1:06:05.92,1:06:08.71,Default,,0,0,0,,Ол өзгере ме, өзгермейді ме?
Dialogue: 0,1:06:09.42,1:06:11.92,Default,,0,0,0,,Оны Джау Шинган шешеді.
Dialogue: 0,1:06:18.09,1:06:22.06,Default,,0,0,0,,Ол өзгере ме, өзгермей ме...
Dialogue: 0,1:06:23.81,1:06:25.43,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:06:29.44,1:06:31.61,Default,,0,0,0,,Сіз анаңызға барасыз ба?
Dialogue: 0,1:06:32.11,1:06:33.07,Default,,0,0,0,,Иә
Dialogue: 0,1:06:33.15,1:06:34.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:06:35.95,1:06:38.82,Default,,0,0,0,,Юта сөйлесетін бірдеңе бар дейді.
Dialogue: 0,1:07:23.49,1:07:25.62,Default,,0,0,0,,- (Рикка) Ауырды... - (Юта) А...
Dialogue: 0,1:07:28.79,1:07:30.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:45.01,1:07:45.93,Default,,0,0,0,,Келдің бе?
Dialogue: 0,1:07:47.18,1:07:48.02,Default,,0,0,0,,Не болды?
Dialogue: 0,1:07:48.10,1:07:51.15,Default,,0,0,0,,Жоқ, оянсам, аяғым ауырды.
Dialogue: 0,1:07:51.23,1:07:53.73,Default,,0,0,0,,Сіз нашар ұйықтадыңыз ба? Күрсін!
Dialogue: 0,1:07:54.69,1:07:56.44,Default,,0,0,0,,- (Юта) Рикка ше? -(Исшики) Дәретхана емес пе?
Dialogue: 0,1:07:57.57,1:07:59.20,Default,,0,0,0,,Сөмке...
Dialogue: 0,1:08:03.49,1:08:04.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:21.30,1:08:24.93,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:08:26.68,1:08:28.22,Default,,0,0,0,,Қуат өшірілген, солай ма?
Dialogue: 0,1:08:30.81,1:08:32.48,Default,,0,0,0,,Сучан!
Dialogue: 0,1:08:32.56,1:08:38.11,Default,,0,0,0,,Зұлым патшаның қызметшісі Шинган Сана Декомори Осора тауына ұсынылады!
Dialogue: 0,1:08:38.78,1:08:40.65,Default,,0,0,0,,Бұл өте алыс болса да.
Dialogue: 0,1:08:41.57,1:08:45.57,Default,,0,0,0,,Тока-санның мәліметі бойынша олар осында.
Dialogue: 0,1:08:47.41,1:08:50.75,Default,,0,0,0,,Мм, кешіріңіз, мен сізге сұрақ қойғым келеді.
Dialogue: 0,1:08:51.71,1:08:53.75,Default,,0,0,0,,Мен осы жерге барғым келеді.
Dialogue: 0,1:08:53.83,1:08:57.21,Default,,0,0,0,,Сосын шағын әріпті оқи алмадым.
Dialogue: 0,1:08:57.29,1:09:00.21,Default,,0,0,0,,- (Нибутани) Гураваж? -(Декомори) Жаңа сиқырлы тіл Өлім!
Dialogue: 0,1:09:00.30,1:09:01.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:09:02.26,1:09:04.89,Default,,0,0,0,,Мен сол автобусқа мінгім келеді.
Dialogue: 0,1:09:06.22,1:09:07.30,Default,,0,0,0,,Ах
Dialogue: 0,1:09:07.39,1:09:10.39,Default,,0,0,0,,Мен жаңа ғана кетіп қалдым, сондықтан біраз уақыт ораламын.
Dialogue: 0,1:09:10.47,1:09:11.85,Default,,0,0,0,,Аха…
Dialogue: 0,1:09:11.93,1:09:14.19,Default,,0,0,0,,Шақырылған сиқыршы Өлім!
Dialogue: 0,1:09:14.27,1:09:16.31,Default,,0,0,0,,Өлім Декоморимен жарысады!
Dialogue: 0,1:09:16.94,1:09:19.44,Default,,0,0,0,,Менің мұндай жерде болуым мүмкін емес.
Dialogue: 0,1:09:19.53,1:09:22.40,Default,,0,0,0,,Уау~ Қар әлі бар~
Dialogue: 0,1:09:22.49,1:09:24.95,Default,,0,0,0,,Ақыры келді~ Біз де
Dialogue: 0,1:09:25.03,1:09:26.41,Default,,0,0,0,,Хаха~
Dialogue: 0,1:09:26.49,1:09:30.87,Default,,0,0,0,,Енді сиқырлы жын патша қыз келді, бәрі шешіледі!
Dialogue: 0,1:09:30.95,1:09:34.17,Default,,0,0,0,,Шынымен бе? Сенімен бәрі жақсы ма?
Dialogue: 0,1:09:34.92,1:09:36.25,Default,,0,0,0,,Қорықпа.
Dialogue: 0,1:09:36.33,1:09:39.59,Default,,0,0,0,,Мен сіздің орналасқан жеріңізді растадым, сонда кездесеміз.
Dialogue: 0,1:09:40.25,1:09:44.13,Default,,0,0,0,,Зұлым патша Шинган мен Қараңғы жалын иесінің шешімі...
Dialogue: 0,1:09:45.43,1:09:46.93,Default,,0,0,0,,Мен оны көруім керек
Dialogue: 0,1:09:49.85,1:09:51.52,Default,,0,0,0,,Хаха...
Dialogue: 0,1:10:03.44,1:10:06.78,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:10:27.68,1:10:28.89,Default,,0,0,0,,Бұл
Dialogue: 0,1:10:31.22,1:10:33.14,Default,,0,0,0,,​​Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:10:33.72,1:10:35.39,Default,,0,0,0,,Рикканың анасы
Dialogue: 0,1:10:37.14,1:10:39.06,Default,,0,0,0,,- (Юта) Кешіріңіз! - (Рикканың анасы) А?
Dialogue: 0,1:10:39.15,1:10:41.90,Default,,0,0,0,,Пойызда оянсам, Рикка жоқ екен.
Dialogue: 0,1:10:41.98,1:10:44.86,Default,,0,0,0,,Мен оны іздедім, бірақ ештеңе таба алмадым ...
Dialogue: 0,1:10:45.36,1:10:46.90,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:10:47.82,1:10:50.78,Default,,0,0,0,,Мен оны қорғауға қабілетті емеспін бе?
Dialogue: 0,1:10:50.87,1:10:53.70,Default,,0,0,0,,Мына бетті көтеріңізші.
Dialogue: 0,1:10:54.33,1:10:57.25,Default,,0,0,0,,Рикка бүгін таңертең менің орныма келді.
Dialogue: 0,1:10:57.33,1:10:58.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:58.50,1:11:01.00,Default,,0,0,0,,Ол қыз саған хабарласпады.
Dialogue: 0,1:11:01.59,1:11:04.51,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,1:11:10.39,1:11:11.89,Default,,0,0,0,,Рахмет
Dialogue: 0,1:11:13.89,1:11:16.60,Default,,0,0,0,,Барлық ауруханаларда қызметкерлер жетіспейтін сияқты.
Dialogue: 0,1:11:17.23,1:11:19.44,Default,,0,0,0,,Көмектесетін болсам
Dialogue: 0,1:11:19.52,1:11:22.11,Default,,0,0,0,,Мен Риккаға ренжідім...
Dialogue: 0,1:11:22.90,1:11:24.02,Default,,0,0,0,,Сонымен, Рикка ше?
Dialogue: 0,1:11:24.78,1:11:27.19,Default,,0,0,0,,Сіз бір нәрсеге алаңдаған сияқтысыз.
Dialogue: 0,1:11:27.28,1:11:32.91,Default,,0,0,0,,Шынымды айтсам, сол жастағы балалардың не айтатынын түсінбеймін.
Dialogue: 0,1:11:33.58,1:11:36.79,Default,,0,0,0,,Ютамен бірге жүргенде жүрегім дүрсілдейді.
Dialogue: 0,1:11:37.37,1:11:42.29,Default,,0,0,0,,Жүрегім соққан сайын күш-қуатым жоғалып бара жатқандай сезінемін.
Dialogue: 0,1:11:43.34,1:11:47.59,Default,,0,0,0,,Ютаның арқасында зұлым патша Шинган дүниеге келді...
Dialogue: 0,1:11:49.17,1:11:53.30,Default,,0,0,0,,- (Юта) Рикка? - (Рикканың анасы) Иә, түсіндің бе?
Dialogue: 0,1:11:53.39,1:11:54.22,Default,,0,0,0,,Гилберттің итіне айналды
Dialogue: 0,1:11:54.31,1:11:58.48,Default,,0,0,0,,Анау бала, көріп тұрсың, ол көп нәрсені ойлап отыр.
Dialogue: 0,1:11:58.56,1:12:02.90,Default,,0,0,0,,Жүрегінде Тука сол бала үшін қатты уайымдайды.
Dialogue: 0,1:12:02.98,1:12:05.19,Default,,0,0,0,,Менің ойымша, сіз білесіз
Dialogue: 0,1:12:05.27,1:12:06.98,Default,,0,0,0,,Әй, сенің ата-анаң ақымақ екен.
Dialogue: 0,1:12:07.07,1:12:09.95,Default,,0,0,0,,Жоқ, мен солай ойлаймын.
Dialogue: 0,1:12:10.95,1:12:13.78,Default,,0,0,0,,Ол өзінше ойлайды.
Dialogue: 0,1:12:14.37,1:12:16.20,Default,,0,0,0,,Сондай-ақ Джау Шинген туралы
Dialogue: 0,1:12:16.29,1:12:17.79,Default,,0,0,0,,Махаббат туралы да
Dialogue: 0,1:12:17.87,1:12:19.58,Default,,0,0,0,,Мен туралы да
Dialogue: 0,1:12:19.66,1:12:21.29,Default,,0,0,0,,Отбасы да маңызды
Dialogue: 0,1:12:47.44,1:12:49.94,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,1:12:50.03,1:12:52.11,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,1:12:52.20,1:12:53.70,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:12:54.32,1:12:56.41,Default,,0,0,0,,Бұл Қараңғы жалын шебері.
Dialogue: 0,1:12:56.49,1:13:00.33,Default,,0,0,0,,Келісімшартқа қол қойылған сәттен бастап не қарастырылды
Dialogue: 0,1:13:01.04,1:13:05.54,Default,,0,0,0,,Бұл зұлым патша Шинганның таңдауы, ол бір күні келетіні сөзсіз.
Dialogue: 0,1:13:11.30,1:13:13.34,Default,,0,0,0,,Кумин~
Dialogue: 0,1:13:13.43,1:13:14.97,Default,,0,0,0,,Рикка-чан
Dialogue: 0,1:13:15.05,1:13:16.64,Default,,0,0,0,,Жоқ, Джау Шинган!
Dialogue: 0,1:13:18.89,1:13:23.02,Default,,0,0,0,,Бұл ассоциация заңымен анықталған таңдау.
Dialogue: 0,1:13:23.52,1:13:25.94,Default,,0,0,0,,Сіз зұлым патша Шинган ретінде өмір сүресіз бе?
Dialogue: 0,1:13:26.02,1:13:30.11,Default,,0,0,0,,Әлде күшіңді тастап, батырға «сүйемін» дейсің бе?
Dialogue: 0,1:13:30.19,1:13:31.53,Default,,0,0,0,,Бұл...
Dialogue: 0,1:13:31.61,1:13:34.49,Default,,0,0,0,,Қайсысын өзіңіз шешіңіз!
Dialogue: 0,1:13:34.57,1:13:35.74,Default,,0,0,0,,Не...
Dialogue: 0,1:13:37.53,1:13:38.66,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:13:40.41,1:13:43.00,Default,,0,0,0,,Менің ойымша, сіз Джау Шинганды лақтырып тастауыңыз керек.
Dialogue: 0,1:13:44.58,1:13:47.75,Default,,0,0,0,,-Шичимия-чан... -(Шичимия) Ешкім қиындыққа тап болмайды.
Dialogue: 0,1:13:47.84,1:13:53.51,Default,,0,0,0,,Аа... а, жоқ... онда менің жеке тұлғам
Dialogue: 0,1:13:53.59,1:13:57.68,Default,,0,0,0,,Мен өзім болуды тоқтатқанда, Ютамен байланысым...
Dialogue: 0,1:14:00.93,1:14:05.94,Default,,0,0,0,,Юта қазір мені ұнатса керек.
Dialogue: 0,1:14:07.35,1:14:13.07,Default,,0,0,0,,Дегенмен, маған Юта қаншалықты ұнаса, соғұрлым көбірек
Dialogue: 0,1:14:13.82,1:14:18.41,Default,,0,0,0,,Мен енді қазіргідей адам болмаймын.
Dialogue: 0,1:14:20.74,1:14:25.33,Default,,0,0,0,,Мен өзім болуды қойғанда, Юта
Dialogue: 0,1:14:25.83,1:14:30.25,Default,,0,0,0,,Сен мені сүйе бересің бе?
Dialogue: 0,1:14:31.55,1:14:32.96,Default,,0,0,0,,мен
Dialogue: 0,1:14:34.26,1:14:36.88,Default,,0,0,0,,Олар оны қабылдай ма?
Dialogue: 0,1:14:47.19,1:14:48.90,Default,,0,0,0,,Қайсысы?
Dialogue: 0,1:14:49.81,1:14:50.81,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,1:14:51.77,1:14:53.82,Default,,0,0,0,,Юута да, Джау Шинган да
Dialogue: 0,1:14:53.90,1:14:55.82,Default,,0,0,0,,Ең маңызды мәселелер
Dialogue: 0,1:14:56.45,1:14:59.07,Default,,0,0,0,,Бұл дүниедегі барлық нәрсенің тамыры!
Dialogue: 0,1:14:59.16,1:15:02.70,Default,,0,0,0,,Егер мен мұны таңдау керек болса, мен...
Dialogue: 0,1:15:03.41,1:15:04.45,Default,,0,0,0,,Осындай қатал жағдайларға қарамастан, барлығыңыз да жақсы өнер көрсеттіңіздер.
Dialogue: 0,1:15:04.54,1:15:06.16,Default,,0,0,0,,Жарып жіберіңіз, бұл шынайы!
Dialogue: 0,1:15:06.25,1:15:08.17,Default,,0,0,0,,Өрт синапсы!
Dialogue: 0,1:15:08.75,1:15:10.42,Default,,0,0,0,,Алып тастау…
Dialogue: 0,1:15:10.50,1:15:12.63,Default,,0,0,0,,- (Шичимия/Рикка) Дис... -Яй!
Dialogue: 0,1:15:15.96,1:15:20.59,Default,,0,0,0,,Бұл матчта екінші буын Джау Шинген жетекшілік етеді!
Dialogue: 0,1:15:20.68,1:15:22.22,Default,,0,0,0,,Кумин
Dialogue: 0,1:15:25.81,1:15:28.98,Default,,0,0,0,,Мұны Рикка-чан мен Шичимия-чан шеше алмайды.
Dialogue: 0,1:15:29.60,1:15:32.23,Default,,0,0,0,,Бұл Тогаши-кун мен Рикка-чан.
Dialogue: 0,1:15:32.31,1:15:34.23,Default,,0,0,0,,Бұл...
Dialogue: 0,1:15:34.82,1:15:37.40,Default,,0,0,0,,Шичимия-чан оны өзі таңдады.
Dialogue: 0,1:15:37.49,1:15:40.99,Default,,0,0,0,,Менің ойымша, бұл дұрыс жол болды.
Dialogue: 0,1:15:41.07,1:15:44.24,Default,,0,0,0,,Бірақ бұл бәрі де емес деп ойлаймын.
Dialogue: 0,1:15:44.33,1:15:47.25,Default,,0,0,0,,Тоғаши-кун міндетті түрде күтіп тұр.
Dialogue: 0,1:15:47.33,1:15:50.75,Default,,0,0,0,,Мен екеуміздің арамызды таңдағым келеді.
Dialogue: 0,1:15:51.33,1:15:55.75,Default,,0,0,0,,Өйткені Тогаши-кун Гельзониант болды.
Dialogue: 0,1:15:56.80,1:15:57.92,Default,,0,0,0,,Юта
Dialogue: 0,1:16:00.18,1:16:04.26,Default,,0,0,0,,Юта... не істеуіміз керек?
Dialogue: 0,1:16:04.35,1:16:06.56,Default,,0,0,0,,Мен Ютаға қайтуым керек.
Dialogue: 0,1:16:06.64,1:16:08.48,Default,,0,0,0,,Мен сізге жаңа ғана хабарластым.
Dialogue: 0,1:16:08.56,1:16:10.44,Default,,0,0,0,,«Мен осындамын»
Dialogue: 0,1:16:11.31,1:16:13.90,Default,,0,0,0,,Нибутани Декомори
Dialogue: 0,1:16:14.69,1:16:17.90,Default,,0,0,0,,Герзониант тікелей өлімге бет алды.
Dialogue: 0,1:16:18.65,1:16:20.40,Default,,0,0,0,,Мастер астында
Dialogue: 0,1:16:21.86,1:16:23.41,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,1:16:24.87,1:16:29.16,Default,,0,0,0,,Мен мұны қашу туралы сөйлескен кезде дайындадым.
Dialogue: 0,1:16:29.25,1:16:30.96,Default,,0,0,0,,Қолдану
Dialogue: 0,1:16:31.04,1:16:34.59,Default,,0,0,0,,Бұл жалғыз сөйлесуге жақсы орын.
Dialogue: 0,1:16:35.25,1:16:37.13,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,1:17:04.95,1:17:06.24,Default,,0,0,0,,Өлім кетті
Dialogue: 0,1:17:06.33,1:17:08.91,Default,,0,0,0,,Әй, сен маған қамқор боласың.
Dialogue: 0,1:17:08.99,1:17:12.46,Default,,0,0,0,,- (Декомори) Сонда не істейсің? -(Нибутани) Не істемексің?
Dialogue: 0,1:17:12.54,1:17:16.13,Default,,0,0,0,,Мастер және Қараңғы жалын Мастер өлімі
Dialogue: 0,1:17:16.21,1:17:19.50,Default,,0,0,0,,Енді бәрі тагине құмырасының өлімі туралы!
Dialogue: 0,1:17:19.59,1:17:23.47,Default,,0,0,0,,Мен оны басынан бастап ұстаймын деп ойламаған едім~
Dialogue: 0,1:17:23.55,1:17:25.97,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,1:17:26.05,1:17:28.26,Default,,0,0,0,,Зұлым патша шынайы көз...
Dialogue: 0,1:17:28.76,1:17:30.64,Default,,0,0,0,,Қатысты аспан ережелері
Dialogue: 0,1:17:31.77,1:17:34.90,Default,,0,0,0,,Бұл да байланысты заң деп ойлаймын.
Dialogue: 0,1:17:35.52,1:17:38.48,Default,,0,0,0,,Сол кезде Шичимия-чанның таңдауы болмаса.
Dialogue: 0,1:17:38.57,1:17:43.49,Default,,0,0,0,,Қазіргі Шичимия-чан, Рикка-чан немесе Тогаши-кун болған жоқ.
Dialogue: 0,1:17:43.57,1:17:45.36,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,1:17:47.07,1:17:47.91,Default,,0,0,0,,Иә
Dialogue: 0,1:17:48.95,1:17:50.87,Default,,0,0,0,,Барлығы бір-бірімен байланысты, солай емес пе?
Dialogue: 0,1:17:51.87,1:17:53.62,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:17:53.71,1:17:57.92,Default,,0,0,0,,Мен орта мектепте қалыпты мектеп өмірін өткізуді жоспарладым.
Dialogue: 0,1:17:58.00,1:18:00.50,Default,,0,0,0,,Қалай шықсаң да, жалғансың.
Dialogue: 0,1:18:00.59,1:18:02.96,Default,,0,0,0,,Өкінішке толы орта мектеп өмірі!
Dialogue: 0,1:18:03.05,1:18:05.88,Default,,0,0,0,,Әй, сен өкінемін деп кім айтты?
Dialogue: 0,1:18:05.97,1:18:07.39,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,1:18:08.30,1:18:11.01,Default,,0,0,0,,Иә!? Жаман ештеңе айтпа!
Dialogue: 0,1:18:11.10,1:18:11.93,Default,,0,0,0,,Хехе
Dialogue: 0,1:18:12.02,1:18:14.68,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:18:19.82,1:18:22.73,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:18:28.20,1:18:29.49,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:47.84,1:18:49.26,Default,,0,0,0,,Оны құтқарудың жолы бар ма?
Dialogue: 0,1:19:25.46,1:19:27.55,Default,,0,0,0,,Денеңді тесіп өтті.
Dialogue: 0,1:19:28.47,1:19:29.76,Default,,0,0,0,,Сенімді болыңыз!
Dialogue: 0,1:19:30.68,1:19:32.30,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,1:19:32.39,1:19:35.77,Default,,0,0,0,,Зұлым патша Шинган - ең күшті!
Dialogue: 0,1:20:12.09,1:20:13.47,Default,,0,0,0,,Жұлдыздар әдемі
Dialogue: 0,1:20:15.43,1:20:19.64,Default,,0,0,0,,Екеуіңде жауап болса, Тоқаға айт.
Dialogue: 0,1:20:21.44,1:20:25.27,Default,,0,0,0,,Мен қыздың олардың жауаптарын тыңдағысы келетініне сенімдімін.
Dialogue: 0,1:20:25.36,1:20:28.61,Default,,0,0,0,,«Мен сені алып кетемін» дедіңіз деп ойлаймын.
Dialogue: 0,1:20:32.78,1:20:34.62,Default,,0,0,0,,- (Рикка) Юта - (Юта) Иә?
Dialogue: 0,1:20:34.70,1:20:39.12,Default,,0,0,0,,Зұлым патшаның Шинганның күші жойылса
Dialogue: 0,1:20:40.12,1:20:42.62,Default,,0,0,0,,Егер мен оны тастасам
Dialogue: 0,1:20:44.13,1:20:46.29,Default,,0,0,0,,Мен Ютамен бірге бола аламын ба?
Dialogue: 0,1:20:52.43,1:20:53.34,Default,,0,0,0,,Тоқа мырза
Dialogue: 0,1:20:53.43,1:20:55.93,Default,,0,0,0,,«Бұл жақсы» деп айтуыңыз мүмкін.
Dialogue: 0,1:20:56.47,1:20:57.85,Default,,0,0,0,,Юта ше?
Dialogue: 0,1:21:03.85,1:21:05.81,Default,,0,0,0,,Жұлдыздар да мәңгілік емес
Dialogue: 0,1:21:06.36,1:21:08.57,Default,,0,0,0,,Әсіресе бұл адам болса.
Dialogue: 0,1:21:08.65,1:21:10.61,Default,,0,0,0,,Зұлым патшаның шын көзі жақсы.
Dialogue: 0,1:21:14.28,1:21:15.12,Default,,0,0,0,,Рикка
Dialogue: 0,1:21:23.46,1:21:24.62,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:21:25.63,1:21:29.67,Default,,0,0,0,,Сіз Джау Шинганның күшін жинақтай бересіз бе?
Dialogue: 0,1:21:29.75,1:21:33.63,Default,,0,0,0,,Немесе одан айырылып, басқа нәрсеге айналатын күн келеді.
Dialogue: 0,1:21:35.30,1:21:38.05,Default,,0,0,0,,Шынайы ма? Ол өзгере ме?
Dialogue: 0,1:21:38.14,1:21:39.01,Default,,0,0,0,,О
Dialogue: 0,1:21:39.68,1:21:41.18,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:21:41.27,1:21:42.39,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,1:21:43.52,1:21:46.61,Default,,0,0,0,,Қандай жағдай болмасын мен әрқашан жаныңда боламын.
Dialogue: 0,1:21:46.69,1:21:48.11,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,1:21:48.98,1:21:50.69,Default,,0,0,0,,Сама құдайыма ант етемін
Dialogue: 0,1:22:00.24,1:22:01.12,Default,,0,0,0,,Хмм...
Dialogue: 0,1:22:02.20,1:22:03.37,Default,,0,0,0,,Уф…
Dialogue: 0,1:22:06.37,1:22:09.67,Default,,0,0,0,,Мен Құдайға сенбеймін, бірақ
Dialogue: 0,1:22:10.17,1:22:13.26,Default,,0,0,0,,Мен соңғы формаға ауыссам да
Dialogue: 0,1:22:13.92,1:22:16.26,Default,,0,0,0,,Мен Ютаны жақсы көремін!
Dialogue: 0,1:22:16.34,1:22:18.43,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,1:22:18.51,1:22:21.68,Default,,0,0,0,,Бұл Қараңғы жалын иесі мен зұлым патша Шинган арасындағы ант.
Dialogue: 0,1:22:21.77,1:22:23.06,Default,,0,0,0,,Әрине.
Dialogue: 0,1:22:25.60,1:22:28.15,Default,,0,0,0,,Уф! Сіз кенеттен не істейсіз?
Dialogue: 0,1:22:29.61,1:22:30.98,Default,,0,0,0,,Сізге бұл ұнамады ма?
Dialogue: 0,1:22:33.57,1:22:35.36,Default,,0,0,0,,Бұта емес
Dialogue: 0,1:22:35.95,1:22:39.07,Default,,0,0,0,,Бұл кенеттен болғаны сонша, мен оны түсіне алмадым.
Dialogue: 0,1:22:39.16,1:22:42.04,Default,,0,0,0,,Біз тағы да дұрыс келісім-шарт жасауымыз керек!
Dialogue: 0,1:22:42.12,1:22:43.33,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,1:22:45.37,1:22:46.41,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,1:22:54.55,1:22:57.76,Default,,0,0,0,,Күтілгендей, бұл шынымен ұят.
Dialogue: 0,1:22:57.84,1:23:00.18,Default,,0,0,0,,Ба... мен де ақымақ!
Dialogue: 0,1:23:00.26,1:23:03.56,Default,,0,0,0,,Мидағы серотонин мен дофаминнің көп мөлшері
Dialogue: 0,1:23:03.64,1:23:05.60,Default,,0,0,0,,Эндорфиндер шығарылады
Dialogue: 0,1:23:05.68,1:23:08.06,Default,,0,0,0,,Әй... Әй, бұл миға дәрі.
Dialogue: 0,1:23:08.77,1:23:11.40,Default,,0,0,0,,- (Юта) Жаман емес - (Рикка) Иә.
Dialogue: 0,1:23:17.70,1:23:18.86,Default,,0,0,0,,- (Юта) Қалай~! -(Рикка) Уау.
Dialogue: 0,1:23:18.95,1:23:20.99,Default,,0,0,0,,Қараңғылық... ауырады
Dialogue: 0,1:23:21.07,1:23:24.29,Default,,0,0,0,,Қараңғылық жалынының құшағында ғайып бол!
Dialogue: 0,1:23:24.37,1:23:26.33,Default,,0,0,0,,Avalon Smasher!
Dialogue: 0,1:23:26.41,1:23:27.66,Default,,0,0,0,,Қара айдаһардың қиюы!
Dialogue: 0,1:23:27.75,1:23:30.29,Default,,0,0,0,,Тазалық қызығу!
Dialogue: 0,1:23:30.38,1:23:31.79,Default,,0,0,0,,Жарып жіберіңіз, бұл шын!
Dialogue: 0,1:23:31.88,1:23:33.55,Default,,0,0,0,,Өрт синапсы!
Dialogue: 0,1:23:33.63,1:23:37.67,Default,,0,0,0,,Бұл әлемді қуу!
Dialogue: 0,1:23:44.39,1:23:45.52,Default,,0,0,0,,Рикка!
Dialogue: 0,1:23:46.02,1:23:47.31,Default,,0,0,0,,Юта!
Dialogue: 0,1:24:22.01,1:24:23.34,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:24:25.43,1:24:28.85,Default,,0,0,0,,Хмм, мен сізге толықтай қарыздармын.
Dialogue: 0,1:24:36.40,1:24:38.40,Default,,0,0,0,,♪ «Жарқыраған арман»
Dialogue: 0,1:25:08.43,1:25:12.48,Default,,0,0,0,,Бұл сиқырлы қоғамның сиқырды шығарғаны туралы жаңалық па?
Dialogue: 0,1:25:12.56,1:25:15.65,Default,,0,0,0,,Әй, МиСкуси!
Dialogue: 0,1:25:15.73,1:25:18.86,Default,,0,0,0,,Үйленетін болсаң, маған айтқаның жақсы болар еді.
Dialogue: 0,1:25:19.40,1:25:21.69,Default,,0,0,0,,Діни әйел құпия
Dialogue: 0,1:25:22.45,1:25:24.57,Default,,0,0,0,,Мен «Рикканы өзіммен бірге алып кетемін» дедім.
Dialogue: 0,1:25:24.66,1:25:27.58,Default,,0,0,0,,Мүмкін мен сенің тойға келгеніңді қалаған шығармын.
Dialogue: 0,1:25:27.66,1:25:29.54,Default,,0,0,0,,Тым тітіркендіргіш
Dialogue: 0,1:25:29.62,1:25:30.54,Default,,0,0,0,,Ах
Dialogue: 0,1:25:35.63,1:25:37.59,Default,,0,0,0,,Құдай Сама
Dialogue: 0,1:25:37.67,1:25:39.09,Default,,0,0,0,,-Тогаши-кун - (Юта) Ах!
Dialogue: 0,1:25:39.17,1:25:41.84,Default,,0,0,0,,Бұл қуырылған күріш~ Хехе
Dialogue: 0,1:25:42.84,1:25:46.34,Default,,0,0,0,,Мен ешқашан Италияға келемін деп ойламадым...
Dialogue: 0,1:25:47.18,1:25:48.10,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:25:48.76,1:25:49.60,Default,,0,0,0,,Ах
Dialogue: 0,1:25:55.40,1:25:57.90,Default,,0,0,0,,Тоқа-сан сондай әдемі
Dialogue: 0,1:25:57.98,1:25:59.19,Default,,0,0,0,,Рахмет
Dialogue: 0,1:25:59.90,1:26:02.28,Default,,0,0,0,,Бұл өте әдемі~
Dialogue: 0,1:26:02.36,1:26:04.40,Default,,0,0,0,,Сіз қайда болдыңыз? ана
Dialogue: 0,1:26:04.49,1:26:06.41,Default,,0,0,0,,Әйелдерде көп нәрсе болады.
Dialogue: 0,1:26:06.49,1:26:08.32,Default,,0,0,0,,Атам жылап отыр
Dialogue: 0,1:26:10.41,1:26:12.83,Default,,0,0,0,,Даквантотемпо!
Dialogue: 0,1:26:12.91,1:26:16.25,Default,,0,0,0,,- (Юта) Ой~ Біраз уақыт болды - (Рикка) Біраз уақыт болды.
Dialogue: 0,1:26:16.33,1:26:17.83,Default,,0,0,0,,Қалайсың?
Dialogue: 0,1:26:22.21,1:26:24.63,Default,,0,0,0,,Кумин Сенпай~
Dialogue: 0,1:26:25.30,1:26:27.55,Default,,0,0,0,,Мысықтарға күтім жасау Танысқаныма қуаныштымын!
Dialogue: 0,1:26:28.26,1:26:29.14,Default,,0,0,0,,Ах
Dialogue: 0,1:26:30.35,1:26:35.10,Default,,0,0,0,,Бұл сиқырлы жын қыз сізге ең жақсы сиқырмен батасын береді!
Dialogue: 0,1:26:39.77,1:26:40.61,Default,,0,0,0,,Рикка
Dialogue: 0,1:26:41.15,1:26:41.98,Default,,0,0,0,,Ах
Dialogue: 0,1:26:43.07,1:26:44.24,Default,,0,0,0,,Бұл сіздің жаңа үйіңіздің кілті.
Dialogue: 0,1:26:44.99,1:26:46.45,Default,,0,0,0,,Бірге тұру
Dialogue: 0,1:26:46.53,1:26:48.45,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,1:26:50.53,1:26:53.20,Default,,0,0,0,,Сіз оны қанша жерге лақтырасыз?
Dialogue: 0,1:26:57.54,1:26:58.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:59.46,1:27:01.00,Default,,0,0,0,,-Уау~ -(Ютаның анасы) Ах.
Dialogue: 0,1:27:01.96,1:27:03.17,Default,,0,0,0,,Ах
Dialogue: 0,1:27:14.43,1:27:16.43,Default,,0,0,0,,~♪
Dialogue: 0,1:27:20.65,1:27:22.65,Default,,0,0,0,,♪~
Dialogue: 0,1:32:48.47,1:32:50.48,Default,,0,0,0,,~♪
Dialogue: 0,1:33:10.83,1:33:15.25,Default,,0,0,0,,Мен бұл жігітке неге ғашық болдым деп ойлаймын кейде.
Dialogue: 0,1:33:17.59,1:33:20.01,Default,,0,0,0,,Бірақ мен қазір түсіндім
Dialogue: 0,1:33:24.72,1:33:26.97,Default,,0,0,0,,Менің көзімді көріп тұрсың ба?
Dialogue: 0,1:33:27.05,1:33:30.27,Default,,0,0,0,,Сондықтан мен оған ғашық болдым!
Dialogue: 0,1:33:31.77,1:33:37.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory