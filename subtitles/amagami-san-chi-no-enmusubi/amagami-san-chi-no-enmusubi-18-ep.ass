Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:03.54,Default,,0,0,0,,(термометр дыбысы)
Dialogue: 0,0:00:04.13,0:00:06.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:07.13,0:00:09.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:11.09,0:00:14.43,Default,,0,0,0,,Мен суық тиіп қалдым
Dialogue: 0,0:00:15.26,0:00:19.93,Default,,0,0,0,,(цикада дауысы)
Dialogue: 0,0:00:20.02,0:00:25.02,Default,,0,0,0,,♪～
Dialogue: 0,0:01:44.93,0:01:49.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:55.07,0:01:57.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:57.36,0:01:58.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:00.41,0:02:02.03,Default,,0,0,0,,Юна?
Dialogue: 0,0:02:03.41,0:02:05.50,Default,,0,0,0,,Мен ботқа дайындадым.
Dialogue: 0,0:02:05.58,0:02:07.08,Default,,0,0,0,,Жеуге жарамды ма?
Dialogue: 0,0:02:07.16,0:02:09.25,Default,,0,0,0,,О, рахмет
Dialogue: 0,0:02:09.75,0:02:12.67,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:02:13.34,0:02:16.38,Default,,0,0,0,,Кешіріңіз, мен тамақ әзірлеуде қиындықтарға тап болдым.
Dialogue: 0,0:02:17.05,0:02:20.51,Default,,0,0,0,,Ұнамаса, қалдыруға болады.
Dialogue: 0,0:02:21.68,0:02:23.68,Default,,0,0,0,,Гочисусан (Юна) А...
Dialogue: 0,0:02:23.76,0:02:26.31,Default,,0,0,0,,Бұл сіздің талғамыңызға сай емес пе?
Dialogue: 0,0:02:26.39,0:02:28.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.19,0:02:32.06,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:02:33.44,0:02:35.69,Default,,0,0,0,,Иә? Батарея бітті
Dialogue: 0,0:02:35.78,0:02:37.74,Default,,0,0,0,,Ауыстыру бар ма?
Dialogue: 0,0:02:40.78,0:02:42.87,Default,,0,0,0,,Оған мүлдем көмектесу мүмкін емес...
Dialogue: 0,0:02:42.95,0:02:44.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.33,0:02:46.58,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:02:50.04,0:02:52.46,Default,,0,0,0,,Жоқ... жоқ, жетеді.
Dialogue: 0,0:02:53.17,0:02:55.96,Default,,0,0,0,,Сіздің қызуыңыз біршама төмендеген болуы мүмкін.
Dialogue: 0,0:02:56.67,0:02:59.05,Default,,0,0,0,,Эй... Юна жақын
Dialogue: 0,0:02:59.13,0:03:01.05,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:03:08.81,0:03:09.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:11.27,0:03:13.94,Default,,0,0,0,,Бұл не, арман?
Dialogue: 0,0:03:14.02,0:03:15.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:15.73,0:03:19.07,Default,,0,0,0,,Оның мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,0:03:21.45,0:03:23.78,Default,,0,0,0,,Мүмкін сізде әлі де қызба бар шығар.
Dialogue: 0,0:03:23.87,0:03:24.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.74,0:03:26.58,Default,,0,0,0,,Әй...
Dialogue: 0,0:03:28.41,0:03:29.83,Default,,0,0,0,,Бұл…
Dialogue: 0,0:03:36.55,0:03:39.42,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:03:40.47,0:03:42.55,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,0:03:42.64,0:03:46.18,Default,,0,0,0,,Ол осы ғибадатхананың маңызды мұрагері.
Dialogue: 0,0:03:46.26,0:03:51.14,Default,,0,0,0,,Маған көп ойланбастан тек сені қолдау керек.
Dialogue: 0,0:03:51.23,0:03:53.69,Default,,0,0,0,,Мен осылай ант бердім.
Dialogue: 0,0:03:57.48,0:04:01.32,Default,,0,0,0,,Хмм... менің де қызуым көтерілген шығар.
Dialogue: 0,0:04:03.95,0:04:05.82,Default,,0,0,0,,Хмм!
Dialogue: 0,0:04:05.91,0:04:07.74,Default,,0,0,0,,Қайырлы таң, Урю-кун
Dialogue: 0,0:04:07.83,0:04:09.87,Default,,0,0,0,,Қазір өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:04:09.95,0:04:12.50,Default,,0,0,0,,О, толығымен.
Dialogue: 0,0:04:12.58,0:04:13.75,Default,,0,0,0,,Өте жақсы екен. Хахаха.
Dialogue: 0,0:04:16.13,0:04:18.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:18.09,0:04:21.55,Default,,0,0,0,,Юна-нидің шашы өте ерекше.
Dialogue: 0,0:04:21.63,0:04:22.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:23.18,0:04:25.39,Default,,0,0,0,,Хмм... Мен қателесіппін.
Dialogue: 0,0:04:25.47,0:04:27.97,Default,,0,0,0,,Мен қалай қателесе аламын?
Dialogue: 0,0:04:29.60,0:04:31.60,Default,,0,0,0,,Ол жігітте бірдеңе дұрыс емес...
Dialogue: 0,0:04:31.68,0:04:33.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:33.39,0:04:35.77,Default,,0,0,0,,Бұлыңғыр болғанын түсіну қиын, бірақ
Dialogue: 0,0:04:35.85,0:04:38.11,Default,,0,0,0,,Урю-кун, жақсысың ба?
Dialogue: 0,0:04:38.19,0:04:39.53,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:04:40.61,0:04:42.36,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,0:04:42.44,0:04:44.82,Default,,0,0,0,,Чут (Урю) Уф! Уф...
Dialogue: 0,0:04:44.91,0:04:47.03,Default,,0,0,0,,Жоқ... Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:04:47.12,0:04:49.12,Default,,0,0,0,,Эххе, кешіріңіз, кешіріңіз
Dialogue: 0,0:04:49.20,0:04:51.16,Default,,0,0,0,,Мен қашықтықты қате түсіндім.
Dialogue: 0,0:04:52.91,0:04:56.04,Default,,0,0,0,,Юна туралы айтып тұрсың ба?
Dialogue: 0,0:04:56.13,0:04:57.25,Default,,0,0,0,,Иә
Dialogue: 0,0:04:57.33,0:05:01.01,Default,,0,0,0,,Бүгінгі Ю Чанның мінез-құлқында біртүрлі нәрсе бар, солай ма?
Dialogue: 0,0:05:01.09,0:05:03.51,Default,,0,0,0,,Ол байқамаған сияқты.
Dialogue: 0,0:05:03.59,0:05:04.84,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:04.93,0:05:09.76,Default,,0,0,0,,Бұл Ю Чанның бірдеңені жасырып, ұстап тұрғанының белгісі болуы мүмкін.
Dialogue: 0,0:05:09.85,0:05:11.06,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:11.14,0:05:13.06,Default,,0,0,0,,Мен білемін (Йосиге) Ах...
Dialogue: 0,0:05:13.77,0:05:16.19,Default,,0,0,0,,Юнаны маған қалдыр.
Dialogue: 0,0:05:16.27,0:05:17.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:17.60,0:05:20.32,Default,,0,0,0,,Балалар, сендер қиындыққа тап болсаңдар, мен боламын
Dialogue: 0,0:05:20.40,0:05:23.15,Default,,0,0,0,,Мазасыз деп айтсаң да, мен бірдеңе істеймін.
Dialogue: 0,0:05:23.24,0:05:25.03,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:25.57,0:05:28.66,Default,,0,0,0,,Мен мұны білдім.
Dialogue: 0,0:05:32.45,0:05:33.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:35.50,0:05:38.17,Default,,0,0,0,,Жарайды... бұл бұрынғыдан күшейді!
Dialogue: 0,0:05:39.08,0:05:40.96,Default,,0,0,0,,Ол жақсы ма?
Dialogue: 0,0:05:41.05,0:05:44.17,Default,,0,0,0,,Ю-чан, кездейсоқ...
Dialogue: 0,0:05:45.26,0:05:46.97,Default,,0,0,0,,Мүмкін бұл махаббат дерті шығар!
Dialogue: 0,0:05:47.05,0:05:49.09,Default,,0,0,0,,Махаббат соқыр дейді.
Dialogue: 0,0:05:49.18,0:05:51.93,Default,,0,0,0,,Бұл сіздің физикалық көзге көрінбейтініңізді білдірмейді.
Dialogue: 0,0:05:52.56,0:05:53.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:53.77,0:05:57.56,Default,,0,0,0,,Жақында бірдеңе өзгерді ме?
Dialogue: 0,0:05:57.64,0:05:58.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:58.73,0:06:01.69,Default,,0,0,0,,Мен сіздің мұрагер боламын деп шештім.
Dialogue: 0,0:06:01.77,0:06:03.28,Default,,0,0,0,,Мен де суық тиіп қалдым...
Dialogue: 0,0:06:03.36,0:06:04.94,Default,,0,0,0,,(құлаған заттардың дыбысы)
Dialogue: 0,0:06:05.03,0:06:06.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:06.32,0:06:07.91,Default,,0,0,0,,（）
Dialogue: 0,0:06:08.91,0:06:11.24,Default,,0,0,0,,Амансың ба? (Ёшиге) Ю-чан!
Dialogue: 0,0:06:11.33,0:06:13.66,Default,,0,0,0,,Әй, сен не істеп жатырсың?
Dialogue: 0,0:06:13.74,0:06:15.70,Default,,0,0,0,,Бұл... жарайды.
Dialogue: 0,0:06:16.46,0:06:19.08,Default,,0,0,0,,Мен мұны өзім түзетемін.
Dialogue: 0,0:06:19.17,0:06:21.54,Default,,0,0,0,,Балалар сендерге бәрібір
Dialogue: 0,0:06:22.54,0:06:24.84,Default,,0,0,0,,Ю-чан, сәл күте тұршы (Юна) Ах!
Dialogue: 0,0:06:27.59,0:06:29.84,Default,,0,0,0,,Менде әлі де қызба бар.
Dialogue: 0,0:06:29.93,0:06:33.56,Default,,0,0,0,,А-а, Урю-санға суық тидің бе?
Dialogue: 0,0:06:33.64,0:06:36.35,Default,,0,0,0,,Не? Бұл оғаштыққа себеп болды ма?
Dialogue: 0,0:06:36.43,0:06:37.98,Default,,0,0,0,,Қазір біраз демалыңыз.
Dialogue: 0,0:06:38.06,0:06:40.44,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:06:40.52,0:06:42.15,Default,,0,0,0,,Юна-ни...
Dialogue: 0,0:06:42.23,0:06:44.07,Default,,0,0,0,,Бұл сізге байланысты
Dialogue: 0,0:06:44.15,0:06:45.90,Default,,0,0,0,,Демалуға шамасы жоқ
Dialogue: 0,0:06:45.98,0:06:48.65,Default,,0,0,0,,Сіз мені жалғыз қалдыра аласыз.
Dialogue: 0,0:06:48.74,0:06:49.53,Default,,0,0,0,,Хмф! (Юна) Айда!
Dialogue: 0,0:06:49.53,0:06:50.91,Default,,0,0,0,,Хмф! (Юна) Айда!
Dialogue: 0,0:06:49.53,0:06:50.91,Default,,0,0,0,,Не!
Dialogue: 0,0:06:50.99,0:06:53.91,Default,,0,0,0,,Ю-Чан, әпке, сіз келдіңіз!
Dialogue: 0,0:06:54.83,0:06:55.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:55.79,0:06:58.83,Default,,0,0,0,,Мен Ю Чанды жақсы көремін, сен сондай еңбекқорсың.
Dialogue: 0,0:06:58.91,0:07:03.04,Default,,0,0,0,,Мен Ю-Чанның қиналып жатқандай көрінуге мәжбүрлегенін көргім келмейді.
Dialogue: 0,0:07:03.13,0:07:04.17,Default,,0,0,0,,Йожу...
Dialogue: 0,0:07:04.25,0:07:08.51,Default,,0,0,0,,Қасиетті орындарға бәріміз бірдей қараймыз.
Dialogue: 0,0:07:08.59,0:07:12.18,Default,,0,0,0,,Қазір Урю-кун да менімен бірге.
Dialogue: 0,0:07:12.93,0:07:17.68,Default,,0,0,0,,Сіз бізге көбірек сене аласыз, жарай ма?
Dialogue: 0,0:07:19.31,0:07:20.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:22.10,0:07:25.52,Default,,0,0,0,,Уф, кешіріңіз!
Dialogue: 0,0:07:25.61,0:07:26.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.53,0:07:28.69,Default,,0,0,0,,Сіз депрессия режиміне өттіңіз.
Dialogue: 0,0:07:29.36,0:07:32.16,Default,,0,0,0,,Йошигенің айтқаны орынды.
Dialogue: 0,0:07:32.24,0:07:35.95,Default,,0,0,0,,Маған осылай қамқор болғаныңызға өте қуаныштымын...
Dialogue: 0,0:07:36.74,0:07:42.37,Default,,0,0,0,,Бірақ ол мұның әділетсіз екенін біліп, осы қасиетті мұраға қалдыруды ұсынды.
Dialogue: 0,0:07:42.46,0:07:46.59,Default,,0,0,0,,Олай болса, біз сол адамның өмірін қолдауға міндеттіміз.
Dialogue: 0,0:07:47.75,0:07:49.38,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:49.46,0:07:54.39,Default,,0,0,0,,Мен сенің де көп тырысуыңды қалаймын...
Dialogue: 0,0:07:55.10,0:07:56.85,Default,,0,0,0,,Ю-чан...
Dialogue: 0,0:07:56.93,0:07:59.35,Default,,0,0,0,,Юна-ни...
Dialogue: 0,0:08:00.14,0:08:04.35,Default,,0,0,0,,Жоқ, жоқ, мен одан да көп тырыспаймын.
Dialogue: 0,0:08:04.44,0:08:06.36,Default,,0,0,0,,Урю-кун…
Dialogue: 0,0:08:06.44,0:08:10.94,Default,,0,0,0,,Жарайды... дұрыс, бұл қиындық тудырады.
Dialogue: 0,0:08:11.03,0:08:12.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:12.28,0:08:13.32,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:08:13.41,0:08:14.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:14.32,0:08:16.78,Default,,0,0,0,,Егер сіз көбірек тырыссаңыз
Dialogue: 0,0:08:16.87,0:08:19.54,Default,,0,0,0,,Маған көбірек тырысу керек.
Dialogue: 0,0:08:20.62,0:08:22.58,Default,,0,0,0,,Сіз үш апаның бірісіз.
Dialogue: 0,0:08:22.66,0:08:25.58,Default,,0,0,0,,Сіз осы ғибадатхана үшін бәрін жасауға бастама жасадыңыз.
Dialogue: 0,0:08:26.38,0:08:28.63,Default,,0,0,0,,Құдайға сенбейтін мен үшін
Dialogue: 0,0:08:28.71,0:08:31.51,Default,,0,0,0,,Маған тура жүгірген сенсің.
Dialogue: 0,0:08:31.59,0:08:34.84,Default,,0,0,0,,Мен сенің арқаңа солай қараймын
Dialogue: 0,0:08:34.93,0:08:37.39,Default,,0,0,0,,Мен мұны қасиетті орынға арнағым келгендіктен жасадым.
Dialogue: 0,0:08:40.22,0:08:44.65,Default,,0,0,0,,Әрине, біз де солай сезінеміз, Юна-ни.
Dialogue: 0,0:08:44.73,0:08:45.77,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:51.94,0:08:52.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:56.37,0:08:57.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:59.45,0:09:00.99,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:09:01.08,0:09:04.46,Default,,0,0,0,,Мен демаламын, сондықтан мені арқаңызға көтеріп, бөлмеме апарыңыз.
Dialogue: 0,0:09:04.54,0:09:07.04,Default,,0,0,0,,Бұл жігіт күтпеген жерден бұзылып кетті...
Dialogue: 0,0:09:07.13,0:09:10.05,Default,,0,0,0,,Екеуіңізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:09:10.13,0:09:12.55,Default,,0,0,0,,Мен енді өзімді қатты итермеймін.
Dialogue: 0,0:09:12.63,0:09:16.55,Default,,0,0,0,,Бірақ... формаға оралғаннан кейін мен өзімді жақсы сезінемін.
Dialogue: 0,0:09:16.64,0:09:19.72,Default,,0,0,0,,Мен сендерді көп жұмыс істеуге мәжбүр етемін.
Dialogue: 0,0:09:19.81,0:09:21.81,Default,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,0:09:21.89,0:09:23.56,Default,,0,0,0,,Эххе
Dialogue: 0,0:09:23.64,0:09:26.06,Default,,0,0,0,,Жұмсақ болыңыз.
Dialogue: 0,0:09:28.15,0:09:30.32,Default,,0,0,0,,Толығымен жанданды!
Dialogue: 0,0:09:30.40,0:09:33.82,Default,,0,0,0,,Юна-ни, қазір өзіңді жақсы сезінесің бе?
Dialogue: 0,0:09:33.90,0:09:35.61,Default,,0,0,0,,Аа, сізге рахмет.
Dialogue: 0,0:09:35.70,0:09:37.78,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:09:37.86,0:09:39.83,Default,,0,0,0,,Бұл жолы бәрі жақсы
Dialogue: 0,0:09:40.58,0:09:42.74,Default,,0,0,0,,Жаңа семестр ертең басталады.
Dialogue: 0,0:09:42.83,0:09:46.96,Default,,0,0,0,,Мен енді ауырып қалмау үшін Аллаға жалбарынамын.
Dialogue: 0,0:09:47.04,0:09:48.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:51.55,0:09:54.38,Default,,0,0,0,,Басқа адам шынымен не ойлайды?
Dialogue: 0,0:09:54.46,0:09:57.59,Default,,0,0,0,,Бір-бірімізге шынайы сезімімізді жеткізе алсақ
Dialogue: 0,0:09:57.68,0:10:00.18,Default,,0,0,0,,Мен бір-бірімізді түсінеміз деп ойладым.
Dialogue: 0,0:10:00.93,0:10:04.64,Default,,0,0,0,,Бірақ адамдардың жүрегі соншалықты таяз емес.
Dialogue: 0,0:10:05.23,0:10:07.60,Default,,0,0,0,,Өйткені, мен...
Dialogue: 0,0:10:09.52,0:10:14.23,Default,,0,0,0,,Мен ол туралы ештеңе білмедім.
Dialogue: 0,0:10:16.99,0:10:19.16,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:19.24,0:10:21.78,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:21.87,0:10:23.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:26.75,0:10:28.42,Default,,0,0,0,,Тоқта... Урю-сан!
Dialogue: 0,0:10:28.50,0:10:31.00,Default,,0,0,0,,Не байсалдылықпен кіріп жатырсың?
Dialogue: 0,0:10:31.08,0:10:32.79,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:10:32.88,0:10:36.05,Default,,0,0,0,,Кешіріңіз, келесі жолы мұқият боламын.
Dialogue: 0,0:10:37.01,0:10:39.22,Default,,0,0,0,,Егер сіз талап етсеңіз.
Dialogue: 0,0:10:39.30,0:10:43.18,Default,,0,0,0,,Кішкене көрсетсем жарайды... иә?
Dialogue: 0,0:10:43.26,0:10:45.43,Default,,0,0,0,,Сіз қандай ақымақ туралы айтып отырсыз?
Dialogue: 0,0:10:45.52,0:10:48.60,Default,,0,0,0,,Қыздар ер адамдарға жалаңаш терісін оңай көрсетпеуі керек.
Dialogue: 0,0:10:48.69,0:10:51.06,Default,,0,0,0,,Бұл не дейді?
Dialogue: 0,0:10:52.23,0:10:53.77,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:53.86,0:10:57.07,Default,,0,0,0,,Бірдеңе қызық емес.
Dialogue: 0,0:10:57.90,0:11:02.45,Default,,0,0,0,,Е, мектебіміздің «Надеко фестивалі» мәдени фестивалінде не болып жатыр?
Dialogue: 0,0:11:02.53,0:11:04.83,Default,,0,0,0,,Өз пікіріме және теріс пікірге байланысты
Dialogue: 0,0:11:04.91,0:11:09.08,Default,,0,0,0,,«Торикабая моногатари» спектаклін қоюды жөн көрдім!
Dialogue: 0,0:11:09.16,0:11:12.46,Default,,0,0,0,,Ол ауыстырылса ше... әңгіме?
Dialogue: 0,0:11:13.42,0:11:15.17,Default,,0,0,0,,«Торикабая моногатари» бұл
Dialogue: 0,0:11:15.25,0:11:19.88,Default,,0,0,0,,Ұялшақ және әйелдік жас ханзада және белсенді және ер мінезді ханшайым
Dialogue: 0,0:11:19.97,0:11:23.85,Default,,0,0,0,,Бұл олардың әрқайсысы өз жынысы туралы өтірік айтып өмірін өткізетіні туралы әңгіме.
Dialogue: 0,0:11:23.93,0:11:25.97,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:11:26.06,0:11:27.81,Default,,0,0,0,,Эй, жақсы емес пе?
Dialogue: 0,0:11:27.89,0:11:30.06,Default,,0,0,0,,Бірақ басты кейіпкер кім?
Dialogue: 0,0:11:30.14,0:11:32.98,Default,,0,0,0,,Хехехе, сыныптағы жалғыз бала
Dialogue: 0,0:11:33.06,0:11:35.11,Default,,0,0,0,,Камишу Урю-кун!
Dialogue: 0,0:11:35.19,0:11:38.82,Default,,0,0,0,,Мен сізді «Жас шебер» рөліне тағайындағым келеді!
Dialogue: 0,0:11:38.90,0:11:39.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.82,0:11:43.37,Default,,0,0,0,,Камизу-кунның сымбатты жігіт екені рас, айқыш киінгенде де жақсы көрінеді.
Dialogue: 0,0:11:43.45,0:11:46.49,Default,,0,0,0,,Иә, мен солай ойлаймын. Қанекей мынаны істейік.
Dialogue: 0,0:11:49.08,0:11:52.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:54.04,0:11:57.00,Default,,0,0,0,,Жарайды, егер бәрі осылай айтса...
Dialogue: 0,0:11:57.09,0:11:58.51,Default,,0,0,0,,Кеттей
Dialogue: 0,0:11:58.59,0:12:00.63,Default,,0,0,0,,О! Не деген өзімшілдік...
Dialogue: 0,0:12:00.72,0:12:03.05,Default,,0,0,0,,Юна-чан, не болды?
Dialogue: 0,0:12:04.22,0:12:06.68,Default,,0,0,0,,Мен... қарсымын.
Dialogue: 0,0:12:06.76,0:12:08.97,Default,,0,0,0,,Мен оның киінгенін көргім келмейді.
Dialogue: 0,0:12:09.06,0:12:11.39,Default,,0,0,0,,Басқа рөлде ойнайтын қызды да аяймын.
Dialogue: 0,0:12:11.48,0:12:15.61,Default,,0,0,0,,Ал, мен Камизу-кунның рөлін ойнағым келеді.
Dialogue: 0,0:12:15.69,0:12:16.69,Default,,0,0,0,,Мен де
Dialogue: 0,0:12:16.77,0:12:18.28,Default,,0,0,0,,Бұл... бұл жақсы емес!
Dialogue: 0,0:12:19.82,0:12:21.40,Default,,0,0,0,,Ал егер!
Dialogue: 0,0:12:22.03,0:12:25.24,Default,,0,0,0,,Мен оның серіктесін ойнаймын!
Dialogue: 0,0:12:28.33,0:12:29.87,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:29.95,0:12:32.12,Default,,0,0,0,,Негізі мен ханшайымның рөлін де сомдадым.
Dialogue: 0,0:12:32.21,0:12:34.62,Default,,0,0,0,,Мен Юначчиге кеңес беруді ойладым.
Dialogue: 0,0:12:34.71,0:12:36.75,Default,,0,0,0,,А... неге?
Dialogue: 0,0:12:36.84,0:12:40.13,Default,,0,0,0,,Өйткені Юначчи мен Камихатчи
Dialogue: 0,0:12:40.21,0:12:41.97,Default,,0,0,0,,Сіз біреумен кездесіп жүрсіз бе?
Dialogue: 0,0:12:42.05,0:12:42.88,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:12:42.97,0:12:44.63,Default,,0,0,0,,Нанана... Не айтып тұрсың!
Dialogue: 0,0:12:44.72,0:12:46.51,Default,,0,0,0,,Менің онымен ондай қарым-қатынасым мүлдем жоқ...
Dialogue: 0,0:12:46.60,0:12:48.31,Default,,0,0,0,,Түсіндім, түсіндім
Dialogue: 0,0:12:48.39,0:12:50.52,Default,,0,0,0,,Сіз оны құпия қарым-қатынаста ұстағыңыз келеді, солай ма?
Dialogue: 0,0:12:50.60,0:12:55.15,Default,,0,0,0,,Бірақ менің көзім алданбайды.
Dialogue: 0,0:12:56.23,0:12:59.48,Default,,0,0,0,,Мектепте де бір-бірімізге жалт қарай береміз.
Dialogue: 0,0:12:59.57,0:13:02.65,Default,,0,0,0,,Кейде екеуміз бір жерге жасырынып кетеміз...
Dialogue: 0,0:13:02.74,0:13:06.41,Default,,0,0,0,,Қалай қарасаң да, олар бір-бірімен кездесіп жүрген жұп.
Dialogue: 0,0:13:06.49,0:13:09.91,Default,,0,0,0,,Жаман... Керексіз түсініспеушілік тудырып жатыр.
Dialogue: 0,0:13:09.99,0:13:12.91,Default,,0,0,0,,Ендеше мұны мына кемпірге қалдырыңыз.
Dialogue: 0,0:13:13.75,0:13:15.29,Default,,0,0,0,,Бұл пьесада
Dialogue: 0,0:13:15.37,0:13:16.96,Default,,0,0,0,,Мәртебелі және екі адамға толы
Dialogue: 0,0:13:17.04,0:13:18.88,Default,,0,0,0,,Анықтап көрейік!
Dialogue: 0,0:13:22.05,0:13:24.97,Default,,0,0,0,,Демек, бұл түсінбеушілік...
Dialogue: 0,0:13:28.22,0:13:30.43,Default,,0,0,0,,Ааа~ Бұл пьеса ма?
Dialogue: 0,0:13:30.51,0:13:34.18,Default,,0,0,0,,Оның үстіне Юна-ни ер адамша, ал Урю-сан әйелдікіндей киінген.
Dialogue: 0,0:13:34.27,0:13:35.94,Default,,0,0,0,,Бұл көруге болатын нәрсе.
Dialogue: 0,0:13:36.02,0:13:38.06,Default,,0,0,0,,Мен оны міндетті түрде сол күні көремін.
Dialogue: 0,0:13:38.15,0:13:42.53,Default,,0,0,0,,Хахаха... Жарайды, көп нәрсе күтпе.
Dialogue: 0,0:13:43.40,0:13:45.90,Default,,0,0,0,,...
Dialogue: 0,0:13:45.99,0:13:46.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.91,0:13:51.20,Default,,0,0,0,,Ах! Дұрыс, мен бірден рөлге дайындалып жатырмын.
Dialogue: 0,0:13:51.28,0:13:53.75,Default,,0,0,0,,Сонымен... Менің ойымша, мәселе осында.
Dialogue: 0,0:13:53.83,0:13:55.46,Default,,0,0,0,,Бірақ бұл таң қалдырады.
Dialogue: 0,0:13:55.54,0:13:58.67,Default,,0,0,0,,Урю-кун неге мұндай рөлге ие болады?
Dialogue: 0,0:13:58.75,0:13:59.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:59.83,0:14:04.17,Default,,0,0,0,,Сыныптағылардың барлығының ұсыныстарын елемеу де жаман.
Dialogue: 0,0:14:04.26,0:14:05.59,Default,,0,0,0,,Және...
Dialogue: 0,0:14:05.67,0:14:08.64,Default,,0,0,0,,...
Dialogue: 0,0:14:08.72,0:14:09.84,Default,,0,0,0,,Не!
Dialogue: 0,0:14:09.93,0:14:13.72,Default,,0,0,0,,Хмм, бұл жақсы емес, сізге сәйкес келеді.
Dialogue: 0,0:14:13.81,0:14:17.60,Default,,0,0,0,,өтіңіз, түсінемін, сіз мені көрсетіп жатырсыз.
Dialogue: 0,0:14:17.69,0:14:20.15,Default,,0,0,0,,Мұның бәрі театр туралы!
Dialogue: 0,0:14:20.23,0:14:22.36,Default,,0,0,0,,Біртүрлі түсініспеушіліктерді доғарыңыз.
Dialogue: 0,0:14:22.44,0:14:24.36,Default,,0,0,0,,(душ суының дыбысы)
Dialogue: 0,0:14:32.49,0:14:35.87,Default,,0,0,0,,Куу… Куууу…
Dialogue: 0,0:14:37.96,0:14:42.38,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:14:42.46,0:14:45.38,Default,,0,0,0,,Не болды? Неге қоңырау шалу керек?
Dialogue: 0,0:14:45.46,0:14:48.22,Default,,0,0,0,,Бұл сөзсіз мектеп фестивалі туралы, солай емес пе?
Dialogue: 0,0:14:48.30,0:14:50.64,Default,,0,0,0,,Мен мұндай уақытта спектакль болады деп ойламаппын...
Dialogue: 0,0:14:50.72,0:14:54.01,Default,,0,0,0,,Жоқ деп айтпағаныңыз үшін сіз кінәлі болуыңыз керек.
Dialogue: 0,0:14:54.10,0:14:55.89,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:14:55.97,0:14:58.18,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:58.27,0:15:01.65,Default,,0,0,0,,...
Dialogue: 0,0:15:02.40,0:15:04.27,Default,,0,0,0,,Бір-бірімен жақсы ойнау
Dialogue: 0,0:15:04.36,0:15:07.40,Default,,0,0,0,,Мен қалыпты жағдайға оралудың жолын табуға тырысамын.
Dialogue: 0,0:15:08.07,0:15:11.03,Default,,0,0,0,,...
Dialogue: 0,0:15:13.24,0:15:14.53,Default,,0,0,0,,Біз...
Dialogue: 0,0:15:16.66,0:15:19.12,Default,,0,0,0,,Ауыстырылатын нәрсе жоқ.
Dialogue: 0,0:15:20.42,0:15:21.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:21.88,0:15:24.25,Default,,0,0,0,,Өткенге өту және цикл
Dialogue: 0,0:15:24.34,0:15:26.30,Default,,0,0,0,,Осы жолы орын ауыстырамыз ба?
Dialogue: 0,0:15:26.92,0:15:29.55,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:34.01,0:15:37.68,Default,,0,0,0,,үшін екі түн бұрын басталды.
Dialogue: 0,0:15:42.56,0:15:45.82,Default,,0,0,0,,Иә? Неге мен ғибадатхананың алдында тұрмын...
Dialogue: 0,0:15:46.61,0:15:49.15,Default,,0,0,0,,Мен өз бөлмемде оқуым керек еді...
Dialogue: 0,0:15:50.40,0:15:54.32,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты...
Dialogue: 0,0:15:55.58,0:15:59.58,Default,,0,0,0,,Хмм... хмм~?
Dialogue: 0,0:16:02.67,0:16:04.08,Default,,0,0,0,,Аа... Ах!
Dialogue: 0,0:16:05.71,0:16:08.51,Default,,0,0,0,,Жоқ... мен неге Юнаның кейпіндемін?
Dialogue: 0,0:16:09.34,0:16:11.63,Default,,0,0,0,,Бұл менің денемді білдіреді!
Dialogue: 0,0:16:14.97,0:16:16.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:16.22,0:16:18.60,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:18.68,0:16:21.64,Default,,0,0,0,,Бір-бірінің санасының орын ауыстырғанын білдіреді.
Dialogue: 0,0:16:21.73,0:16:24.15,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:16:24.81,0:16:27.61,Default,,0,0,0,,Дереу шара қолданбасақ...
Dialogue: 0,0:16:28.73,0:16:31.40,Default,,0,0,0,,Жоқ, сен қалай сабырлысың!
Dialogue: 0,0:16:31.49,0:16:34.28,Default,,0,0,0,,Қалай қарасаң да қауіпті. Бұл туралы не істеуіміз керек?
Dialogue: 0,0:16:34.36,0:16:36.16,Default,,0,0,0,,Менің сырт келбетіме айқайлама
Dialogue: 0,0:16:37.28,0:16:39.83,Default,,0,0,0,,Мен де таң қалдым.
Dialogue: 0,0:16:39.91,0:16:42.66,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан ойламадым...
Dialogue: 0,0:16:42.75,0:16:44.79,Default,,0,0,0,,Бұл мазаны алады.
Dialogue: 0,0:16:44.87,0:16:47.17,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:16:47.88,0:16:49.34,Default,,0,0,0,,Әзірше сіз
Dialogue: 0,0:16:49.42,0:16:52.63,Default,,0,0,0,,Сіз дөрекі тіл мен көзқарасыңызды өзгертуіңіз керек.
Dialogue: 0,0:16:52.72,0:16:54.93,Default,,0,0,0,,Сіз де көп өзгерген жоқсыз.
Dialogue: 0,0:16:55.01,0:16:56.51,Default,,0,0,0,,Сонымен қатар, лифчиктің ішкі толтырғышы бар, сондықтан шын мәнінде…
Dialogue: 0,0:16:56.59,0:16:59.64,Default,,0,0,0,,Енді мен сияқты әрекет етуіңіз керек.
Dialogue: 0,0:16:59.72,0:17:03.64,Default,,0,0,0,,Қарғыс атсын... тағы бір қиын паранормальдық құбылыс!
Dialogue: 0,0:17:03.73,0:17:06.98,Default,,0,0,0,,Қасиетті жерге келгеннен бері солай!
Dialogue: 0,0:17:07.48,0:17:08.65,Default,,0,0,0,,Осы жаққа қара.
Dialogue: 0,0:17:09.36,0:17:11.90,Default,,0,0,0,,Бір-бірінің өміріне араласпау үшін
Dialogue: 0,0:17:11.99,0:17:14.61,Default,,0,0,0,,Ақпарат алмасудан бастайық
Dialogue: 0,0:17:14.70,0:17:16.24,Default,,0,0,0,,Ақпарат алмасу?
Dialogue: 0,0:17:16.32,0:17:19.41,Default,,0,0,0,,Мысалы, өзара достық, т.б.
Dialogue: 0,0:17:19.49,0:17:20.91,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:17:20.99,0:17:22.91,Default,,0,0,0,,Мен... қарама-қарсы жыныстағы...
Dialogue: 0,0:17:23.75,0:17:26.92,Default,,0,0,0,,Физиологиялық құбылыстарға қатысты... т.б.
Dialogue: 0,0:17:29.25,0:17:30.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:30.63,0:17:33.92,Default,,0,0,0,,Ерлердің отыруы таңқаларлық жайт па?
Dialogue: 0,0:17:34.55,0:17:36.38,Default,,0,0,0,,бағаланады.
Dialogue: 0,0:17:41.06,0:17:42.89,Default,,0,0,0,,Винерге ұқсайды
Dialogue: 0,0:17:42.97,0:17:45.14,Default,,0,0,0,,Қарғыс атсын... ол шықпайды.
Dialogue: 0,0:17:45.77,0:17:49.65,Default,,0,0,0,,Мен мұны күні бойы киюім керек пе?
Dialogue: 0,0:17:49.73,0:17:52.65,Default,,0,0,0,,Қандай азап!
Dialogue: 0,0:17:53.44,0:17:54.65,Default,,0,0,0,,Иә! Орынсыз...
Dialogue: 0,0:17:54.74,0:17:57.16,Default,,0,0,0,,Пудё!
Dialogue: 0,0:18:00.83,0:18:03.16,Default,,0,0,0,,Не болды? Юна әпкесі
Dialogue: 0,0:18:03.24,0:18:06.41,Default,,0,0,0,,Урю-кун, сен әлі тамақ жедің бе?
Dialogue: 0,0:18:11.50,0:18:13.92,Default,,0,0,0,,Не болды? екеуің де
Dialogue: 0,0:18:14.01,0:18:16.38,Default,,0,0,0,,Бозарып кеткен сияқтысың, бірақ жақсысың ба?
Dialogue: 0,0:18:16.47,0:18:17.93,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:18:18.01,0:18:20.22,Default,,0,0,0,,Менің ішім аздап нашарлайды...
Dialogue: 0,0:18:20.89,0:18:24.93,Default,,0,0,0,,Қашан жағдай қалпына келеді?
Dialogue: 0,0:18:25.02,0:18:27.10,Default,,0,0,0,,(сыпырғыш дыбысы)
Dialogue: 0,0:18:27.19,0:18:28.19,Default,,0,0,0,,Эй
Dialogue: 0,0:18:28.27,0:18:31.82,Default,,0,0,0,,Мүмкін біз олармен сөйлесуіміз керек пе?
Dialogue: 0,0:18:31.90,0:18:33.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:33.15,0:18:37.03,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, біздің күйзеліс тек күшейе түседі.
Dialogue: 0,0:18:37.11,0:18:39.07,Default,,0,0,0,,Олар сізге сенеді.
Dialogue: 0,0:18:39.16,0:18:40.74,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:18:40.82,0:18:42.95,Default,,0,0,0,,Мен қашан қалыпты жағдайға оралатынымды білмеймін.
Dialogue: 0,0:18:43.03,0:18:44.54,Default,,0,0,0,,Әй, екеуі!
Dialogue: 0,0:18:44.62,0:18:45.45,Default,,0,0,0,,Ах
Dialogue: 0,0:18:45.54,0:18:48.58,Default,,0,0,0,,Флирт жасамаңыз, мұқият тазалаңыз.
Dialogue: 0,0:18:48.67,0:18:49.96,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:18:50.92,0:18:53.25,Default,,0,0,0,,Жарайды, кешкі аста шығар.
Dialogue: 0,0:18:53.34,0:18:54.55,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:00.93,0:19:03.35,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:03.43,0:19:07.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:10.44,0:19:11.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.86,0:19:15.19,Default,,0,0,0,,Неге екені белгісіз соңғы кездері Юна-ни екеуміз жақындай бастадық.
Dialogue: 0,0:19:15.28,0:19:17.49,Default,,0,0,0,,Ал... Мен олай емес деп ойлаймын.
Dialogue: 0,0:19:18.40,0:19:21.82,Default,,0,0,0,,Юна-ни туралы не ойлайсың?
Dialogue: 0,0:19:23.20,0:19:27.83,Default,,0,0,0,,Ю-чан, сен соңғы кездері Урюкунмен көп уақыт өткізіп жүрсің.
Dialogue: 0,0:19:27.91,0:19:29.12,Default,,0,0,0,,Йожу...
Dialogue: 0,0:19:29.21,0:19:32.17,Default,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,0:19:32.71,0:19:34.88,Default,,0,0,0,,Сіздің ойыңызша...
Dialogue: 0,0:19:35.67,0:19:38.63,Default,,0,0,0,,Бір нәрсені дұрыс түсінбесеңіз, қателесесіз.
Dialogue: 0,0:19:38.72,0:19:41.18,Default,,0,0,0,,Ол жай ғана... отбасы.
Dialogue: 0,0:19:41.26,0:19:42.59,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:42.68,0:19:45.39,Default,,0,0,0,,Сонда бізде мүлде мүмкіндік жоқ.
Dialogue: 0,0:19:45.47,0:19:47.85,Default,,0,0,0,,Мүмкіндік дегеніміз не?
Dialogue: 0,0:19:47.93,0:19:49.89,Default,,0,0,0,,Бұл қазірдің өзінде шешілген жоқ па?
Dialogue: 0,0:19:49.98,0:19:51.81,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:19:51.90,0:19:54.40,Default,,0,0,0,,Мен оған тек ғибадатхананың ілімін үйреттім.
Dialogue: 0,0:19:54.48,0:19:56.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:56.19,0:20:00.03,Default,,0,0,0,,Бірақ Ю Чан, сен менің сезімімді білесің.
Dialogue: 0,0:20:00.11,0:20:02.41,Default,,0,0,0,,Маған осындай нәрсені қалдырғаныңызды қалаймын.
Dialogue: 0,0:20:03.16,0:20:04.78,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:20:04.87,0:20:06.78,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:20:07.83,0:20:12.29,Default,,0,0,0,,Мен Урю-санның ғашығы боламын.
Dialogue: 0,0:20:13.46,0:20:17.80,Default,,0,0,0,,Мен Урю-кунды жақсы көремін
Dialogue: 0,0:20:17.88,0:20:19.67,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:19.76,0:20:21.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.63,0:20:23.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:23.64,0:20:27.76,Default,,0,0,0,,Қалай қарасаң, бізден хабардар сияқтысың.
Dialogue: 0,0:20:27.85,0:20:30.06,Default,,0,0,0,,Бұл мойындауға тұрарлық еді.
Dialogue: 0,0:20:30.14,0:20:31.31,Default,,0,0,0,,(Миямура) Хмм… сол тү не жайлы еді…
Dialogue: 0,0:20:31.39,0:20:35.48,Default,,0,0,0,,Мұны екеуіңізден де құпия сақтаңыздар.
Dialogue: 0,0:20:35.56,0:20:38.57,Default,,0,0,0,,Бұл тек Урю-сан екеуміздің арамыздағы құпия.
Dialogue: 0,0:20:43.03,0:20:45.95,Default,,0,0,0,,Не болды? Мен қатты таң қалдым
Dialogue: 0,0:20:46.03,0:20:48.58,Default,,0,0,0,,Жоқ... бұл... дұрыс.
Dialogue: 0,0:20:48.66,0:20:53.04,Default,,0,0,0,,Мен қателессем де, бұл туралы Урю-кунға айтпа.
Dialogue: 0,0:20:53.12,0:20:58.92,Default,,0,0,0,,Ю-чан, мен бір нәрсені жасыра алмаймын, сондықтан мен біраз уайымдап тұрмын.
Dialogue: 0,0:21:05.43,0:21:08.05,Default,,0,0,0,,Ахх... (Юна) Ух...
Dialogue: 0,0:21:09.35,0:21:12.73,Default,,0,0,0,,Мен енді сөйлей алмаймын!
Dialogue: 0,0:21:16.27,0:21:18.44,Default,,0,0,0,,Мен осындай нәрсені естісем ше?
Dialogue: 0,0:21:18.52,0:21:22.36,Default,,0,0,0,,Мен енді Юнаны өзіммен ауыстыруды талқылай алмаймын.
Dialogue: 0,0:21:22.44,0:21:27.20,Default,,0,0,0,,Әйтеуір, өз күшімізбен қайтудың жолын табуымыз керек.
Dialogue: 0,0:21:27.28,0:21:30.16,Default,,0,0,0,,Басқа ешкім біле алмайды.
Dialogue: 0,0:21:31.49,0:21:35.96,Default,,0,0,0,,Жарайды, бірақ менің отбасы мүшелерім Яшиге мен Асахиме байқамайды.
Dialogue: 0,0:21:36.04,0:21:38.96,Default,,0,0,0,,Қалғандары жақсы.
Dialogue: 0,0:21:48.72,0:21:51.56,Default,,0,0,0,,Біртүрлі екен.
Dialogue: 0,0:21:51.64,0:21:53.68,Default,,0,0,0,,Соңғы Юначчи
Dialogue: 0,0:21:54.98,0:22:00.23,Default,,0,0,0,,♪～
Dialogue: 0,0:23:20.94,0:23:24.90,Default,,0,0,0,,～♪
