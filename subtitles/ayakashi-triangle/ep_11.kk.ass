Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.54,0:00:07.92,Default,,0,0,0,,Широган...
Dialogue: 0,0:00:08.96,0:00:11.88,Default,,0,0,0,,Suzu ұстаңыз
Dialogue: 0,0:00:13.43,0:00:16.76,Default,,0,0,0,,Пломба сынған
Dialogue: 0,0:00:18.39,0:00:21.27,Default,,0,0,0,,Біздің қарым-қатынасымызды байланыстыратын барлық нәрсе...
Dialogue: 0,0:00:22.39,0:00:23.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:28.86,0:00:30.57,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:00:30.65,0:00:35.28,Default,,0,0,0,,Ол жұмбақ, адам көзіне көрінбейді.
Dialogue: 0,0:00:35.36,0:00:38.87,Default,,0,0,0,,Адамдардан кек алатын зұлым жындарды жою үшін
Dialogue: 0,0:00:38.95,0:00:42.70,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:00:43.96,0:00:45.08,Default,,0,0,0,,Оның аты
Dialogue: 0,0:00:50.71,0:00:52.55,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:00:53.05,0:00:55.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:20.93,0:02:22.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:24.22,0:02:26.27,Default,,0,0,0,,Ақша ұрлау - қулық.
Dialogue: 0,0:02:26.35,0:02:29.56,Default,,0,0,0,,Казамаки Мацуридің өлімімен оның мақтанышы енді
Dialogue: 0,0:02:30.19,0:02:33.23,Default,,0,0,0,,Оны ең дәмді етіп пісірді.
Dialogue: 0,0:02:34.23,0:02:36.69,Default,,0,0,0,,Қайтарыңыз, Широган.
Dialogue: 0,0:02:37.32,0:02:39.15,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:02:39.24,0:02:41.95,Default,,0,0,0,,Оның «Көлеңке жегіш» қабілеті
Dialogue: 0,0:02:43.03,0:02:47.58,Default,,0,0,0,,Айналадағы кеңістікте жалмап тұрған ауыз пайда болады
Dialogue: 0,0:02:47.66,0:02:51.33,Default,,0,0,0,,Сенің талғамың маған ұнамайды.
Dialogue: 0,0:02:51.42,0:02:54.04,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:02:55.67,0:03:00.93,Default,,0,0,0,,Физикалық денесі жоқ жынның денесін тікелей қырып тастайды.
Dialogue: 0,0:03:01.01,0:03:05.97,Default,,0,0,0,,«Ауыз», онда ол пайда болғанша иіс немесе қатысу анықталмайды
Dialogue: 0,0:03:06.56,0:03:07.47,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:03:08.68,0:03:10.81,Default,,0,0,0,,Қашықтықты сақтаңыз және оны реттеңіз!
Dialogue: 0,0:03:11.44,0:03:12.77,Default,,0,0,0,,Күміс ине!
Dialogue: 0,0:03:13.31,0:03:16.90,Default,,0,0,0,,Жарайды, мен де сенің сезіміңді түсінбеймін.
Dialogue: 0,0:03:17.48,0:03:19.69,Default,,0,0,0,,Сіз мені өз олжаңыз деп атағыңыз келеді, солай ма?
Dialogue: 0,0:03:20.20,0:03:21.11,Default,,0,0,0,,Құт
Dialogue: 0,0:03:21.20,0:03:24.82,Default,,0,0,0,,Жолыңнан адасып, әулие қызды сұрадың.
Dialogue: 0,0:03:26.28,0:03:28.24,Default,,0,0,0,,Көлеңке жейтіндерге қалай қарсы тұру керек
Dialogue: 0,0:03:28.33,0:03:31.92,Default,,0,0,0,,Сіз қару-жарақтың көп мөлшерін алу керек деп ойладыңыз ба?
Dialogue: 0,0:03:33.37,0:03:35.29,Default,,0,0,0,,Міне, мен...
Dialogue: 0,0:03:35.79,0:03:39.55,Default,,0,0,0,,Босқа сөзге араласпа!
Dialogue: 0,0:03:40.26,0:03:43.22,Default,,0,0,0,,Сиқырлық Күлгін тозақ оты!
Dialogue: 0,0:03:43.30,0:03:44.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:44.89,0:03:45.76,Default,,0,0,0,,Ах
Dialogue: 0,0:03:47.68,0:03:48.47,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:03:48.60,0:03:49.31,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:49.39,0:03:50.52,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:50.60,0:03:51.48,Default,,0,0,0,,Пәтуа жоқ
Dialogue: 0,0:03:52.23,0:03:55.19,Default,,0,0,0,,Бақсылық та рухты жеуден болады.
Dialogue: 0,0:03:55.27,0:03:57.23,Default,,0,0,0,,Мен үшін тамақ
Dialogue: 0,0:03:57.77,0:04:02.90,Default,,0,0,0,,Талай сиқырды меңгерген саған, Мен сенің табиғи жауыңмын.
Dialogue: 0,0:04:03.70,0:04:07.74,Default,,0,0,0,,Күтілгендей, сиқырлық сізге тек күш береді.
Dialogue: 0,0:04:07.83,0:04:10.70,Default,,0,0,0,,Тек тікелей шабуылдар тиімді.
Dialogue: 0,0:04:11.20,0:04:16.13,Default,,0,0,0,,Дегенмен, бортында Сузумен жақын шайқасқа шығу тым көп...
Dialogue: 0,0:04:16.21,0:04:18.63,Default,,0,0,0,,Жетеді, Широган.
Dialogue: 0,0:04:18.71,0:04:19.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:20.17,0:04:21.38,Default,,0,0,0,,Тез тамақтаныңыз
Dialogue: 0,0:04:21.88,0:04:24.22,Default,,0,0,0,,Егер бұл Широганды өлуден сақтайтын болса.
Dialogue: 0,0:04:24.72,0:04:27.14,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:04:27.22,0:04:28.64,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:04:28.72,0:04:29.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.93,0:04:32.35,Default,,0,0,0,,Мацури өлген бойда, немесе
Dialogue: 0,0:04:32.43,0:04:33.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:33.64,0:04:38.73,Default,,0,0,0,,Сіз қорғамақ болған өміріңізден оңай бас тартасыз ба?
Dialogue: 0,0:04:38.82,0:04:40.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:40.44,0:04:45.61,Default,,0,0,0,,Әй, сен өз сезіміңді алып кетті ме, жын патша?
Dialogue: 0,0:04:47.28,0:04:47.82,Default,,0,0,0,,Уф
Dialogue: 0,0:04:47.91,0:04:49.20,Default,,0,0,0,,Кя
Dialogue: 0,0:04:49.28,0:04:50.08,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:04:50.91,0:04:51.74,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:51.83,0:04:53.29,Default,,0,0,0,,Алаңдады!
Dialogue: 0,0:04:53.87,0:04:55.92,Default,,0,0,0,,Оны осы қашықтықта атуға бола ма?
Dialogue: 0,0:04:57.04,0:04:58.33,Default,,0,0,0,,Кя!
Dialogue: 0,0:05:00.92,0:05:02.13,Default,,0,0,0,,Широган!
Dialogue: 0,0:05:03.59,0:05:06.26,Default,,0,0,0,,Мен адамдарды жек көремін
Dialogue: 0,0:05:06.93,0:05:09.60,Default,,0,0,0,,Қорқыныш пен қуғынға ұшырау
Dialogue: 0,0:05:10.10,0:05:13.10,Default,,0,0,0,,Рұқсатсыз ғибадат ету
Dialogue: 0,0:05:14.35,0:05:17.48,Default,,0,0,0,,Тек ұмытып, лақтырып таста.
Dialogue: 0,0:05:18.60,0:05:19.86,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:20.48,0:05:21.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.03,0:05:27.70,Default,,0,0,0,,Менің бұл тіршілік иесімен тағы бірдеңе байланысым бола ма?
Dialogue: 0,0:05:28.28,0:05:30.16,Default,,0,0,0,,Қанша ойласам да
Dialogue: 0,0:05:32.87,0:05:34.87,Default,,0,0,0,,Жақындаған кезде
Dialogue: 0,0:05:35.37,0:05:39.17,Default,,0,0,0,,Бұл мүлде жаман емес сияқты
Dialogue: 0,0:05:42.25,0:05:43.71,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:45.63,0:05:47.47,Default,,0,0,0,,Мен оны жек көремін.
Dialogue: 0,0:05:48.18,0:05:52.72,Default,,0,0,0,,Хехехехе, қандай аянышты, Широган.
Dialogue: 0,0:05:52.81,0:05:55.68,Default,,0,0,0,,Өйткені, сен баяғыдан қалған құбыжықсың ғой.
Dialogue: 0,0:05:56.27,0:05:57.94,Default,,0,0,0,,Ең болмаса рақым ет
Dialogue: 0,0:05:58.02,0:06:01.23,Default,,0,0,0,,Енді дөрекі түрімізді көрсетпейік.
Dialogue: 0,0:06:01.31,0:06:03.27,Default,,0,0,0,,Оны жеп алайық
Dialogue: 0,0:06:03.36,0:06:04.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:09.32,0:06:11.20,Default,,0,0,0,,Бұл... Иә?
Dialogue: 0,0:06:12.20,0:06:15.66,Default,,0,0,0,,Широганеден алыс, Хикуи-кун
Dialogue: 0,0:06:17.08,0:06:20.92,Default,,0,0,0,,Оригамиді алдын ала бүктеп алған дұрыс.
Dialogue: 0,0:06:21.42,0:06:25.59,Default,,0,0,0,,Егер сіз оған жүрегіңізді салсаңыз, ол бір сәтте пайдалы болуы мүмкін.
Dialogue: 0,0:06:26.71,0:06:31.18,Default,,0,0,0,,Қасиетті қыз... Сіз осындай сиқыр жасай аласыз ба?
Dialogue: 0,0:06:32.64,0:06:34.56,Default,,0,0,0,,Менің қолым ұйып қалды
Dialogue: 0,0:06:39.35,0:06:42.02,Default,,0,0,0,,Бұйрық жай ғана тәртіпті бұзу ма?
Dialogue: 0,0:06:42.52,0:06:44.73,Default,,0,0,0,,Мен оны шабуыл үшін қолдана алғым келеді.
Dialogue: 0,0:06:44.82,0:06:46.19,Default,,0,0,0,,Широган!
Dialogue: 0,0:06:46.28,0:06:47.74,Default,,0,0,0,,Уф…
Dialogue: 0,0:06:47.82,0:06:49.15,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:06:49.24,0:06:51.61,Default,,0,0,0,,Идиот! Тез қаш!
Dialogue: 0,0:06:51.70,0:06:53.87,Default,,0,0,0,,Егер құбыжық жарақат алса, мен оны емдей аламын!
Dialogue: 0,0:06:53.95,0:06:56.54,Default,,0,0,0,,Сен әлі сәбисің
Dialogue: 0,0:06:56.62,0:07:00.42,Default,,0,0,0,,Жын патшасын оңай қалпына келтіруге бола ма?
Dialogue: 0,0:07:00.50,0:07:03.46,Default,,0,0,0,,Сондықтан мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:07:04.29,0:07:04.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:05.55,0:07:09.17,Default,,0,0,0,,Тыныш және үмітсіз болыңыз, Ханасу-сан.
Dialogue: 0,0:07:09.26,0:07:12.76,Default,,0,0,0,,Біткен жұмысыңның дәмі жаман болады.
Dialogue: 0,0:07:12.84,0:07:14.30,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:07:14.39,0:07:15.43,Default,,0,0,0,,Сузу!
Dialogue: 0,0:07:16.93,0:07:17.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.64,0:07:21.39,Default,,0,0,0,,Фуфуфуфу... Мен аламын.
Dialogue: 0,0:07:22.44,0:07:23.27,Default,,0,0,0,,Мацури!
Dialogue: 0,0:07:23.35,0:07:24.61,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:24.69,0:07:25.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:25.82,0:07:27.78,Default,,0,0,0,,Ух... жел!
Dialogue: 0,0:07:30.45,0:07:31.32,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:07:31.90,0:07:34.82,Default,,0,0,0,,Сіз нені айтасыз? Неге сен!
Dialogue: 0,0:07:36.58,0:07:40.33,Default,,0,0,0,,Өмірімнің көп бөлігін жегенім рас.
Dialogue: 0,0:07:40.83,0:07:43.46,Default,,0,0,0,,Сіздің денеңіз өлі болуы керек.
Dialogue: 0,0:07:49.05,0:07:52.97,Default,,0,0,0,,Сен неге тірісің Казамаки Мацури
Dialogue: 0,0:07:53.97,0:07:55.93,Default,,0,0,0,,Мацу…ри…
Dialogue: 0,0:07:56.55,0:07:57.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.43,0:08:03.27,Default,,0,0,0,,Шешейік, адам құбыжық!
Dialogue: 0,0:08:10.99,0:08:12.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.11,0:08:14.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:14.32,0:08:17.03,Default,,0,0,0,,Кенеттен жабысып қалма, Сузу.
Dialogue: 0,0:08:17.12,0:08:19.91,Default,,0,0,0,,Себебі мен сені өлді деп ойладым!
Dialogue: 0,0:08:19.99,0:08:21.29,Default,,0,0,0,,Шынымен, неге?
Dialogue: 0,0:08:21.37,0:08:23.37,Default,,0,0,0,,Ол ұл балаға оралды!
Dialogue: 0,0:08:23.46,0:08:28.13,Default,,0,0,0,,Ах... Мен де түсінбеймін, бірақ мен техниканы шешіп алған шығармын.
Dialogue: 0,0:08:28.71,0:08:31.59,Default,,0,0,0,,Жоқ, құпия техника шешілген жоқ.
Dialogue: 0,0:08:31.67,0:08:34.59,Default,,0,0,0,,... Мен әйел болу арқылы құтқарылдым.
Dialogue: 0,0:08:34.68,0:08:35.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.72,0:08:36.97,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:37.55,0:08:40.77,Default,,0,0,0,,Құпия техника Бұл жыныстық ояту және трансформация механизмі туралы әңгіме.
Dialogue: 0,0:08:40.85,0:08:41.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:43.23,0:08:45.44,Default,,0,0,0,,Ішінде белгіленген жыныс белгісі
Dialogue: 0,0:08:45.52,0:08:48.23,Default,,0,0,0,,Әйелге айналатын айдаһарды жасайды
Dialogue: 0,0:08:48.31,0:08:51.65,Default,,0,0,0,,Мацуридің бүкіл денесін толтыруды жалғастыру
Dialogue: 0,0:08:51.73,0:08:54.57,Default,,0,0,0,,Өйткені оны күн жеген
Dialogue: 0,0:08:54.65,0:09:00.66,Default,,0,0,0,,Өзгеріс уақытша жойылып, Маридің өз рухы қайта жаңғырды.
Dialogue: 0,0:09:01.29,0:09:03.58,Default,,0,0,0,,Әйел болғанның арқасында
Dialogue: 0,0:09:03.66,0:09:06.21,Default,,0,0,0,,Сонымен, сіз бір рет жалғастыра алдыңыз ба?
Dialogue: 0,0:09:06.29,0:09:10.92,Default,,0,0,0,,Ұлы жын патшаның құпия әдістерін ойынмен салыстырмаңыз.
Dialogue: 0,0:09:11.00,0:09:12.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:12.80,0:09:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.59,0:09:17.72,Default,,0,0,0,,Дәмі сондықтан Широганға ұқсайды ма?
Dialogue: 0,0:09:17.80,0:09:19.18,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:09:19.76,0:09:22.31,Default,,0,0,0,,Уф... әф!
Dialogue: 0,0:09:22.39,0:09:23.81,Default,,0,0,0,,Широган!
Dialogue: 0,0:09:25.35,0:09:26.27,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:09:26.35,0:09:29.65,Default,,0,0,0,,Хмм, бірақ дәмі ұнамайды.
Dialogue: 0,0:09:29.73,0:09:32.15,Default,,0,0,0,,Бұл құдіретті аң болуы керек.
Dialogue: 0,0:09:33.11,0:09:35.57,Default,,0,0,0,,О? Әлі сонда болды ма?
Dialogue: 0,0:09:36.07,0:09:37.61,Default,,0,0,0,,Мугюууу
Dialogue: 0,0:09:38.36,0:09:40.20,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:09:42.66,0:09:43.83,Default,,0,0,0,,Жел Құнай!
Dialogue: 0,0:09:45.62,0:09:46.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:46.71,0:09:47.42,Default,,0,0,0,,Цк
Dialogue: 0,0:09:48.08,0:09:49.04,Default,,0,0,0,,Зақымданбады ма?
Dialogue: 0,0:09:49.13,0:09:51.50,Default,,0,0,0,,Жою мүмкін емес.
Dialogue: 0,0:09:51.59,0:09:54.59,Default,,0,0,0,,Менің денем Широганның рухын сіңірді.
Dialogue: 0,0:09:54.67,0:09:56.88,Default,,0,0,0,,Бұл тығыз сиқырлы күштің массасы.
Dialogue: 0,0:09:57.47,0:09:59.51,Default,,0,0,0,,Ол дұрыс.
Dialogue: 0,0:10:00.01,0:10:03.14,Default,,0,0,0,,Тез Сузуды алып қашып кет.
Dialogue: 0,0:10:03.89,0:10:06.98,Default,,0,0,0,,Бұл өз күшіңізбен жеңе алатын қарсылас емес.
Dialogue: 0,0:10:07.64,0:10:09.94,Default,,0,0,0,,Бар!тез!
Dialogue: 0,0:10:12.02,0:10:15.23,Default,,0,0,0,,Құлап қалсаң да, қайта тұра алмайсың.
Dialogue: 0,0:10:15.82,0:10:18.78,Default,,0,0,0,,Ол мені жеткілікті түрде құлатты.
Dialogue: 0,0:10:18.86,0:10:20.62,Default,,0,0,0,,Оны қуып шығару ғана қалды.
Dialogue: 0,0:10:20.70,0:10:21.49,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:22.87,0:10:25.49,Default,,0,0,0,,Маған сеніңіз, Сузу
Dialogue: 0,0:10:27.54,0:10:28.41,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:28.50,0:10:31.38,Default,,0,0,0,,Иә? А... не?
Dialogue: 0,0:10:31.46,0:10:33.79,Default,,0,0,0,,Эй, балалар, есі дұрыс па?
Dialogue: 0,0:10:34.42,0:10:38.22,Default,,0,0,0,,Хехехехе, бұл керемет сенім қарым-қатынасы.
Dialogue: 0,0:10:38.84,0:10:42.76,Default,,0,0,0,,Үміттен одан әрі үмітсіздікке
Dialogue: 0,0:10:43.26,0:10:45.93,Default,,0,0,0,,Енді Казамаки Мариді өлтіру арқылы
Dialogue: 0,0:10:46.02,0:10:49.27,Default,,0,0,0,,Оның тамағы дәмдірек болуы керек.
Dialogue: 0,0:10:50.73,0:10:52.56,Default,,0,0,0,,Мен ес жиған кезде
Dialogue: 0,0:10:53.44,0:10:56.53,Default,,0,0,0,,Мен Сузу мұны үлкен мақтанышпен қолданғанын көрдім.
Dialogue: 0,0:10:56.61,0:11:00.49,Default,,0,0,0,,Сузудың торы сенің олжаң болуы керек.
Dialogue: 0,0:11:00.57,0:11:04.08,Default,,0,0,0,,Бірақ сіз оны жеуге тырыспай, жойып жібердіңіз.
Dialogue: 0,0:11:04.16,0:11:05.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.37,0:11:07.16,Default,,0,0,0,,Ұятты жейтін ауыз...
Dialogue: 0,0:11:07.75,0:11:11.42,Default,,0,0,0,,Төңкерсең тек кірпі жеуге болады деген сөз бе?
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:13.58,0:11:18.01,Default,,0,0,0,,Мен сені желмен ұрсам, ішіңді сындырып алуым мүмкін.
Dialogue: 0,0:11:18.09,0:11:21.30,Default,,0,0,0,,Хмф, бұл ақымақ болжам!
Dialogue: 0,0:11:22.22,0:11:23.01,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:23.09,0:11:27.39,Default,,0,0,0,,Мен Көлеңке жегішті кез келген жерде бейнелей аламын.
Dialogue: 0,0:11:28.10,0:11:29.77,Default,,0,0,0,,Қорғау немесе қашу мүмкін емес
Dialogue: 0,0:11:30.39,0:11:31.89,Default,,0,0,0,,Жеңілмейтін қабілет!
Dialogue: 0,0:11:32.94,0:11:35.98,Default,,0,0,0,,Жоқ, жеңілмейтін нәрсе жоқ.
Dialogue: 0,0:11:36.57,0:11:39.94,Default,,0,0,0,,Егер солай болса, мұндай тактиканың қажеті жоқ.
Dialogue: 0,0:11:41.03,0:11:42.78,Default,,0,0,0,,Жақын шайқаста алаңдау
Dialogue: 0,0:11:44.24,0:11:46.45,Default,,0,0,0,,Соқыр жерден ауызбен шабуыл
Dialogue: 0,0:11:50.83,0:11:53.17,Default,,0,0,0,,Бұл тактика...
Dialogue: 0,0:11:53.25,0:11:56.59,Default,,0,0,0,,Қашанға дейін осылай қашуды жоспарлайсыз?
Dialogue: 0,0:11:58.09,0:11:59.09,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:59.17,0:12:00.05,Default,,0,0,0,,Хи хи
Dialogue: 0,0:12:00.88,0:12:01.63,Default,,0,0,0,,Мацури!
Dialogue: 0,0:12:01.72,0:12:02.38,Default,,0,0,0,,Уф
Dialogue: 0,0:12:02.47,0:12:03.43,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:07.76,0:12:10.43,Default,,0,0,0,,Хехехе, мен істеймін.
Dialogue: 0,0:12:10.52,0:12:12.98,Default,,0,0,0,,Енді мен сенімдімін (Хикуи) иә?
Dialogue: 0,0:12:13.06,0:12:17.61,Default,,0,0,0,,Көлеңке жегіш - бұл сіздің ең үлкен қаруыңыз және сонымен бірге
Dialogue: 0,0:12:17.69,0:12:18.94,Default,,0,0,0,,Сондай-ақ әлсіздік
Dialogue: 0,0:12:20.15,0:12:21.69,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:12:22.28,0:12:26.91,Default,,0,0,0,,Расында да, бұл жігіттің техникасы рухани қуат болып табылатын «жанды» пайдаланады.
Dialogue: 0,0:12:26.99,0:12:30.12,Default,,0,0,0,,Қорқынышты жейтін маған бөгде дене
Dialogue: 0,0:12:31.16,0:12:32.46,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:33.04,0:12:34.17,Default,,0,0,0,,Операция ертеңгі күні таңертең өтеді.
Dialogue: 0,0:12:34.25,0:12:36.50,Default,,0,0,0,,Сол жолы атаның айтқаны
Dialogue: 0,0:12:38.04,0:12:41.13,Default,,0,0,0,,Уау, уау, уау!
Dialogue: 0,0:12:41.21,0:12:42.88,Default,,0,0,0,,Бұл мүмкін емес, ата!
Dialogue: 0,0:12:42.97,0:12:46.09,Default,,0,0,0,,Осындай дауылда шамды сөндірмей ұста.
Dialogue: 0,0:12:46.18,0:12:47.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:47.34,0:12:50.31,Default,,0,0,0,,Иә? Жел тек атаның айналасында...
Dialogue: 0,0:12:50.39,0:12:51.93,Default,,0,0,0,,О Мари
Dialogue: 0,0:12:52.43,0:12:57.31,Default,,0,0,0,,Жауды жеңу үшін күшті эмоциялармен өсірілген жан қуаты
Dialogue: 0,0:12:57.40,0:12:59.57,Default,,0,0,0,,Желді қаруға айналдыр
Dialogue: 0,0:13:00.32,0:13:04.95,Default,,0,0,0,,Бірақ... Казамаки стилінің мәні бұл ғана емес.
Dialogue: 0,0:13:05.45,0:13:07.91,Default,,0,0,0,,мейірімді және жұмсақ
Dialogue: 0,0:13:07.99,0:13:12.41,Default,,0,0,0,,Самал жүрекпен желмен үндес.
Dialogue: 0,0:13:13.79,0:13:16.79,Default,,0,0,0,,Ол кезде мен шынымен түсінбейтінмін.
Dialogue: 0,0:13:16.87,0:13:20.29,Default,,0,0,0,,Сузуды қорғау үшін жынды жеңіңіз
Dialogue: 0,0:13:20.88,0:13:22.76,Default,,0,0,0,,Өйткені мен бұл туралы ғана ойладым.
Dialogue: 0,0:13:22.84,0:13:24.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:28.14,0:13:30.60,Default,,0,0,0,,Широганмен шынымен дос бола алсам
Dialogue: 0,0:13:31.18,0:13:32.93,Default,,0,0,0,,Барлығы шешілді, солай ма?
Dialogue: 0,0:13:34.06,0:13:36.98,Default,,0,0,0,,Мен мұндай нәрсе ешқашан мүмкін емес деп ойладым.
Dialogue: 0,0:13:37.69,0:13:40.23,Default,,0,0,0,,Маған Сузу мен Широган көрсетті
Dialogue: 0,0:13:41.44,0:13:43.57,Default,,0,0,0,,Шабуылдар бәрі бірдей емес
Dialogue: 0,0:13:44.07,0:13:47.53,Default,,0,0,0,,Үйлесіп, желмен бір бол
Dialogue: 0,0:13:49.57,0:13:50.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:51.12,0:13:54.95,Default,,0,0,0,,Казамаки стиліндегі тазарту Нинпо Муфуджин
Dialogue: 0,0:13:59.63,0:14:02.75,Default,,0,0,0,,Орынның атмосферасы барлық қозғалысты тоқтатты!
Dialogue: 0,0:14:02.84,0:14:05.30,Default,,0,0,0,,Хэхе... хехехе!
Dialogue: 0,0:14:05.38,0:14:07.97,Default,,0,0,0,,Қазір күресуге деген ерік-жігеріңізді жоғалттыңыз ба?
Dialogue: 0,0:14:08.05,0:14:10.76,Default,,0,0,0,,Әлде сені жел де тастап кетті ме?
Dialogue: 0,0:14:10.85,0:14:13.51,Default,,0,0,0,,Хахахахаха сонда...
Dialogue: 0,0:14:17.48,0:14:18.39,Default,,0,0,0,,Мацури!
Dialogue: 0,0:14:18.48,0:14:22.40,Default,,0,0,0,,Сіз бір ғана Көлеңке жегіш бар деп айтқан жоқсыз!
Dialogue: 0,0:14:22.48,0:14:25.15,Default,,0,0,0,,Өтірікке толысың.
Dialogue: 0,0:14:28.90,0:14:30.11,Default,,0,0,0,,Барлық иллюзия
Dialogue: 0,0:14:30.91,0:14:34.03,Default,,0,0,0,,Ауаны сілкіндірген бір ғана нәрсе бар!
Dialogue: 0,0:14:34.83,0:14:39.12,Default,,0,0,0,,Тазарту Нинпо Сенсанка!
Dialogue: 0,0:14:39.21,0:14:40.12,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,0:14:42.08,0:14:45.46,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:14:45.55,0:14:46.42,Default,,0,0,0,,О! Ах
Dialogue: 0,0:14:46.51,0:14:48.47,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:14:48.55,0:14:52.89,Default,,0,0,0,,Желсіз күй айналадағы желдің қозғалысын сезінеді —
Dialogue: 0,0:14:52.97,0:14:55.39,Default,,0,0,0,,Тосқауыл техникасы... болды ма?
Dialogue: 0,0:14:56.85,0:14:58.48,Default,,0,0,0,,40
Dialogue: 0,0:14:59.14,0:15:02.02,Default,,0,0,0,,Ішіңнен тесік ашамын
Dialogue: 0,0:15:02.10,0:15:02.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:03.02,0:15:05.65,Default,,0,0,0,,Мм... иә... пішін...
Dialogue: 0,0:15:06.40,0:15:10.07,Default,,0,0,0,,Бар болу мүмкін емес...
Dialogue: 0,0:15:10.15,0:15:13.37,Default,,0,0,0,,Зақым тым үлкен...
Dialogue: 0,0:15:13.45,0:15:14.99,Default,,0,0,0,,Адамның жындары...
Dialogue: 0,0:15:15.08,0:15:19.79,Default,,0,0,0,,Адамнан да, жыннан да асып түсетін нәсіл болуы керек.
Dialogue: 0,0:15:21.21,0:15:23.83,Default,,0,0,0,,Еш нәрсеге қарамастан тамақтаныңыз.
Dialogue: 0,0:15:24.34,0:15:29.30,Default,,0,0,0,,Ең жақсы тағам... сіз...
Dialogue: 0,0:15:30.93,0:15:35.39,Default,,0,0,0,,Неге... неге ол бетті жасайсың?
Dialogue: 0,0:15:36.10,0:15:37.93,Default,,0,0,0,,Неге жылау керек?
Dialogue: 0,0:15:39.35,0:15:41.02,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:15:42.44,0:15:47.32,Default,,0,0,0,,Тәбетім түсіп барады, Ханасу-сан.
Dialogue: 0,0:15:51.24,0:15:55.91,Default,,0,0,0,,Бұл қыз күткендей, жын жағынан бірдеңе ойлап отыр.
Dialogue: 0,0:15:57.16,0:15:59.04,Default,,0,0,0,,Сузу жақсысың ба?
Dialogue: 0,0:15:59.12,0:16:00.04,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:16:04.08,0:16:06.13,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:16:08.05,0:16:08.71,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.80,0:16:11.63,Default,,0,0,0,,Ол аянышты адам еді.
Dialogue: 0,0:16:12.80,0:16:14.68,Default,,0,0,0,,Жеген құбыжықтар да
Dialogue: 0,0:16:15.22,0:16:16.26,Default,,0,0,0,,Қалайы…
Dialogue: 0,0:16:16.76,0:16:19.43,Default,,0,0,0,,Кешіріңіз, қазір бәрі жақсы.
Dialogue: 0,0:16:20.22,0:16:24.77,Default,,0,0,0,,Бұл қуаныштың көз жасы, өйткені Мари тірі болды.
Dialogue: 0,0:16:24.85,0:16:25.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.44,0:16:30.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:31.69,0:16:33.65,Default,,0,0,0,,Барлық ұсақ шабақтар тазаланды.
Dialogue: 0,0:16:33.74,0:16:35.57,Default,,0,0,0,,Мен саған қосыламын, Казамаки!
Dialogue: 0,0:16:36.62,0:16:37.28,Default,,0,0,0,,О? (Поносуке) По?
Dialogue: 0,0:16:37.87,0:16:39.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:39.12,0:16:43.25,Default,,0,0,0,,Жоқ... Мари-доно ер адамға оралды.
Dialogue: 0,0:16:43.33,0:16:45.79,Default,,0,0,0,,Оның үстіне бұл көңіл-күй...
Dialogue: 0,0:16:46.29,0:16:48.00,Default,,0,0,0,,Үйге қайтайық, Поносуке.
Dialogue: 0,0:16:48.09,0:16:48.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:49.25,0:16:50.13,Default,,0,0,0,,Мырза?
Dialogue: 0,0:16:51.30,0:16:53.13,Default,,0,0,0,,Мен өз жұмысымды орындадым
Dialogue: 0,0:16:53.72,0:16:56.47,Default,,0,0,0,,Сузу Хананоның қауіпсіз болғаны жақсы емес пе?
Dialogue: 0,0:16:57.30,0:16:58.35,Default,,0,0,0,,Раббым!
Dialogue: 0,0:16:59.10,0:17:00.18,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:01.02,0:17:03.60,Default,,0,0,0,,Мына жақтан не ағып жатыр?
Dialogue: 0,0:17:03.68,0:17:05.69,Default,,0,0,0,,Ием!
Dialogue: 0,0:17:06.48,0:17:07.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:08.06,0:17:09.86,Default,,0,0,0,,Сізден күткендей, Сенпай.
Dialogue: 0,0:17:09.94,0:17:14.11,Default,,0,0,0,,Жұмысыңды дұрыстап, үндеместен шығып кет.
Dialogue: 0,0:17:14.99,0:17:17.91,Default,,0,0,0,,Пис~! Pussuppuss~!
Dialogue: 0,0:17:17.99,0:17:21.91,Default,,0,0,0,,Міне! Егер ол жабысқақ болса, кәмелетке толмағандар.
Dialogue: 0,0:17:23.04,0:17:28.21,Default,,0,0,0,,Жыныстық ояту трюкінің әсері уақытша ғана болғанын айтқым келеді.
Dialogue: 0,0:17:28.29,0:17:31.17,Default,,0,0,0,,Бұл бақытты аяқталудан алыс.
Dialogue: 0,0:17:31.25,0:17:33.76,Default,,0,0,0,,Мари қайтадан қыз болады ма?
Dialogue: 0,0:17:33.84,0:17:35.38,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:35.47,0:17:37.34,Default,,0,0,0,,Бұл құпия техниканы қалай ашуға болады
Dialogue: 0,0:17:37.43,0:17:41.47,Default,,0,0,0,,Құю қажет кездегідей сиқырлы күш.
Dialogue: 0,0:17:41.56,0:17:44.73,Default,,0,0,0,,Енді мен бұл күштен айырылдым
Dialogue: 0,0:17:44.81,0:17:47.94,Default,,0,0,0,,Мәңгілік жұмысын жалғастыру керек
Dialogue: 0,0:17:48.02,0:17:51.07,Default,,0,0,0,,Қош бол, мені суыт
Dialogue: 0,0:17:52.07,0:17:56.57,Default,,0,0,0,,Сиқырдың әсері күн батқанда қайта оралуы мүмкін.
Dialogue: 0,0:17:57.07,0:17:58.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:01.99,0:18:02.95,Default,,0,0,0,,Қалайы
Dialogue: 0,0:18:03.62,0:18:05.29,Default,,0,0,0,,Менімен біраз уақыт араласа аласыз ба?
Dialogue: 0,0:18:05.37,0:18:06.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.04,0:18:11.42,Default,,0,0,0,,Мен тек ер адамдардың қолынан келетін іспен айналысқым келеді.
Dialogue: 0,0:18:11.50,0:18:12.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.75,0:18:14.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.96,0:18:17.84,Default,,0,0,0,,Ех! Мен... кенеттен бе?
Dialogue: 0,0:18:17.93,0:18:20.59,Default,,0,0,0,,Ал осындай орманда?
Dialogue: 0,0:18:20.68,0:18:22.81,Default,,0,0,0,,Жарайды... әлі жарық.
Dialogue: 0,0:18:22.89,0:18:25.52,Default,,0,0,0,,Бұл... психикалық дайындық...
Dialogue: 0,0:18:26.85,0:18:27.77,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:18:27.85,0:18:30.69,Default,,0,0,0,,Ахх! Мен қазірдің өзінде киімдерімді шеше бастадым!
Dialogue: 0,0:18:31.27,0:18:33.69,Default,,0,0,0,,Сәлем~ Морецу жақсырақ.
Dialogue: 0,0:18:35.61,0:18:38.36,Default,,0,0,0,,Шешімділік Сіз шешуіңіз керек!
Dialogue: 0,0:18:38.45,0:18:40.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:40.20,0:18:44.83,Default,,0,0,0,,Зейінді жинақтаудың ең жақсы тәсілі - тек белдік кию.
Dialogue: 0,0:18:44.91,0:18:46.45,Default,,0,0,0,,Сарқырама!
Dialogue: 0,0:18:47.08,0:18:48.83,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:48.91,0:18:51.50,Default,,0,0,0,,Сен де киіміңді неге шештің? Сузу
Dialogue: 0,0:18:51.58,0:18:53.13,Default,,0,0,0,,Ыстық болғандықтан...
Dialogue: 0,0:18:54.13,0:18:56.59,Default,,0,0,0,,Неліктен сарқырамаға дәл осы уақытта бару керек?
Dialogue: 0,0:18:56.67,0:18:59.47,Default,,0,0,0,,Белдік киім сексуалды
Dialogue: 0,0:18:59.55,0:19:03.01,Default,,0,0,0,,Осы сияқты бірдеңеден кейін де бұл жігіт әлі абдырап тұрады.
Dialogue: 0,0:19:03.10,0:19:07.18,Default,,0,0,0,,Тез ауыса алмау сапа емес пе?
Dialogue: 0,0:19:08.60,0:19:09.89,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:19:10.98,0:19:12.44,Default,,0,0,0,,Сузунара...
Dialogue: 0,0:19:14.19,0:19:17.99,Default,,0,0,0,,Бір жақсысы, мен жаттығуға пайдаланған сарқырама жақын жерде болды.
Dialogue: 0,0:19:18.49,0:19:20.82,Default,,0,0,0,,Менің басымды сәл салқындату керек.
Dialogue: 0,0:19:21.99,0:19:25.33,Default,,0,0,0,,Мен өзімді мұндай сезінемін деп ешқашан ойламадым.
Dialogue: 0,0:19:26.58,0:19:30.58,Default,,0,0,0,,Бойыңыз менен қысқа болдыңыз ба? Сузу жігіті
Dialogue: 0,0:19:32.29,0:19:35.34,Default,,0,0,0,,Не? Сузуни бірдеңе...
Dialogue: 0,0:19:36.63,0:19:39.34,Default,,0,0,0,,Поцелу... Мен қалаймын...
Dialogue: 0,0:19:41.51,0:19:43.80,Default,,0,0,0,,Бұрын мен болсам, бұл мүмкін емес еді.
Dialogue: 0,0:19:44.93,0:19:48.47,Default,,0,0,0,,Ол мен үшін ондай адам емес еді.
Dialogue: 0,0:19:49.60,0:19:51.44,Default,,0,0,0,,Арнайы…
Dialogue: 0,0:19:52.44,0:19:57.65,Default,,0,0,0,,Бірақ бір жынысты адам ретінде мен бұрынғыдан басқаша қашықтықты сезіндім.
Dialogue: 0,0:19:58.44,0:20:00.99,Default,,0,0,0,,Енді мен оны өзіме таныс нәрсе ретінде көремін.
Dialogue: 0,0:20:02.24,0:20:04.99,Default,,0,0,0,,Сузу қыз кезінде
Dialogue: 0,0:20:06.24,0:20:07.62,Default,,0,0,0,,Мацури~!
Dialogue: 0,0:20:08.20,0:20:08.91,Default,,0,0,0,,Ах
Dialogue: 0,0:20:08.99,0:20:11.91,Default,,0,0,0,,Эй... мұнда неге келдің?
Dialogue: 0,0:20:12.00,0:20:15.04,Default,,0,0,0,,Өйткені қанша қоңырау шалсам да байқамайсың.
Dialogue: 0,0:20:15.71,0:20:18.50,Default,,0,0,0,,Ах... менің іш киімім...
Dialogue: 0,0:20:19.34,0:20:23.30,Default,,0,0,0,,Білесіз бе, мен де дұрыс айтқым келді.
Dialogue: 0,0:20:23.80,0:20:25.89,Default,,0,0,0,,Қазіргі фестиваль ауылында
Dialogue: 0,0:20:25.97,0:20:27.97,Default,,0,0,0,,О? иә?
Dialogue: 0,0:20:28.68,0:20:29.89,Default,,0,0,0,,Қый!
Dialogue: 0,0:20:30.72,0:20:32.85,Default,,0,0,0,,Бүгін мені қорғағаныңыз үшін рахмет.
Dialogue: 0,0:20:33.56,0:20:35.73,Default,,0,0,0,,Бірақ, ақыр соңында
Dialogue: 0,0:20:35.81,0:20:39.15,Default,,0,0,0,,Мен әрқашан қорғалғанды қаламаймын.
Dialogue: 0,0:20:39.23,0:20:40.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.86,0:20:43.07,Default,,0,0,0,,Мен жындар туралы көбірек білгім келеді
Dialogue: 0,0:20:43.65,0:20:47.12,Default,,0,0,0,,Мен ғибадатхана қызы ретінде өз күшімді барынша арттырғым келеді.
Dialogue: 0,0:20:48.41,0:20:51.83,Default,,0,0,0,,Бір күні мен Мариді қайтадан балаға айналдырамын.
Dialogue: 0,0:20:52.33,0:20:55.75,Default,,0,0,0,,Енді Мариге көмектесу кезегім
Dialogue: 0,0:20:55.83,0:20:56.71,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:58.00,0:21:01.63,Default,,0,0,0,,Сузу ғибадатхана қыз ретінде билікке ие болған кезде
Dialogue: 0,0:21:02.13,0:21:06.64,Default,,0,0,0,,Мен жете алмайтын алыс жаққа барамын... Солай ойладым.
Dialogue: 0,0:21:07.14,0:21:10.51,Default,,0,0,0,,Бірақ мен қазір бұрынғыға қарағанда аз уайымдаймын.
Dialogue: 0,0:21:11.01,0:21:13.93,Default,,0,0,0,,Себебі мен Сузу жалғыз қыз деп ойладым.
Dialogue: 0,0:21:14.48,0:21:16.77,Default,,0,0,0,,Өтінемін, Сузу.
Dialogue: 0,0:21:16.85,0:21:21.15,Default,,0,0,0,,Бірақ бүгінгідей уақытта мен сені қорғаймын.
Dialogue: 0,0:21:21.78,0:21:24.86,Default,,0,0,0,,Маған Сузу ұнайды.
Dialogue: 0,0:21:25.36,0:21:27.82,Default,,0,0,0,,Рахмет, Мари
Dialogue: 0,0:21:31.99,0:21:35.37,Default,,0,0,0,,Бұл фигурамен тағы да қоштасатын кез келді.
Dialogue: 0,0:21:35.46,0:21:38.50,Default,,0,0,0,,Жарайды! Мен міндетті түрде қайтамын...
Dialogue: 0,0:21:38.58,0:21:39.29,Default,,0,0,0,,Ой... уау...
Dialogue: 0,0:21:41.84,0:21:43.21,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:43.30,0:21:44.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:48.01,0:21:48.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:48.97,0:21:49.89,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:49.97,0:21:52.85,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:21:52.93,0:21:54.18,Default,,0,0,0,,Қара... көзіме су...
Dialogue: 0,0:21:54.27,0:21:56.98,Default,,0,0,0,,Екеуі де... көрдім!
Dialogue: 0,0:21:57.48,0:21:58.90,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:22:00.36,0:22:04.86,Default,,0,0,0,,Мен күткендей үшеуінен көзімді алмаймын.
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.87,0:23:35.87,Default,,0,0,0,,～♪
