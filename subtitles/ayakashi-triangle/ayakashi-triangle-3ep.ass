Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.75,0:00:06.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:14.59,0:00:17.30,Default,,0,0,0,,Мацури менің ойымды түсінді.
Dialogue: 0,0:00:18.01,0:00:19.51,Default,,0,0,0,,Сосын мен де...
Dialogue: 0,0:00:20.64,0:00:24.64,Default,,0,0,0,,Хмм, мен не істей аламын?
Dialogue: 0,0:00:25.23,0:00:27.19,Default,,0,0,0,,Маған тарту бол
Dialogue: 0,0:00:27.27,0:00:31.32,Default,,0,0,0,,Тәкаппар бол, бақсы.
Dialogue: 0,0:00:31.40,0:00:32.86,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:00:34.20,0:00:37.45,Default,,0,0,0,,Широган мені жегісі келеді, солай ма?
Dialogue: 0,0:00:38.03,0:00:38.78,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:00:38.87,0:00:40.87,Default,,0,0,0,,Менен жақсы нәрсе болса
Dialogue: 0,0:00:41.37,0:00:43.37,Default,,0,0,0,,Бұл шешім емес пе?
Dialogue: 0,0:00:43.87,0:00:47.54,Default,,0,0,0,,(Сузу «Момотаро» деп ызылдайды)
Dialogue: 0,0:00:47.63,0:00:48.63,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:49.21,0:00:52.38,Default,,0,0,0,,Қалайы? Сіз бұл уақытта не істеп жатырсыз?
Dialogue: 0,0:00:52.46,0:00:54.26,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,0:00:54.34,0:00:56.13,Default,,0,0,0,,Менің ойыма жақсы идея келді
Dialogue: 0,0:00:56.76,0:00:58.01,Default,,0,0,0,,Оданго?
Dialogue: 0,0:01:01.64,0:01:04.81,Default,,0,0,0,,Хмм, бұл дәмді!
Dialogue: 0,0:01:05.31,0:01:09.19,Default,,0,0,0,,Жарайды, бұл Широганға да ұнайтынына сенімдімін...
Dialogue: 0,0:01:12.78,0:01:14.11,Default,,0,0,0,,«Юкай»
Dialogue: 0,0:01:14.61,0:01:18.78,Default,,0,0,0,,Ол жұмбақ, адам көзіне көрінбейді.
Dialogue: 0,0:01:19.28,0:01:22.45,Default,,0,0,0,,Адамдардан кек алатын зұлым жындарды жою үшін
Dialogue: 0,0:01:22.95,0:01:26.66,Default,,0,0,0,,Ежелден соғысып келе жатқан ниндзялар бар.
Dialogue: 0,0:01:27.92,0:01:29.04,Default,,0,0,0,,Оның аты
Dialogue: 0,0:01:34.76,0:01:36.51,Default,,0,0,0,,Жын шығару
Dialogue: 0,0:01:37.01,0:01:39.01,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.89,0:03:06.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:07.52,0:03:09.77,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:03:10.44,0:03:13.23,Default,,0,0,0,,(Мацуридің ұйықтауы)
Dialogue: 0,0:03:27.99,0:03:28.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:29.25,0:03:32.12,Default,,0,0,0,,Уф... Қарашы... (Мари) Ұйықтап жатсам да, сергекмін.
Dialogue: 0,0:03:32.21,0:03:33.42,Default,,0,0,0,,Жіберіңдер~
Dialogue: 0,0:03:34.00,0:03:36.13,Default,,0,0,0,,Егер бұл үй жануарлары мысық болса, үй жануарлары сияқты әрекет етіңіз.
Dialogue: 0,0:03:36.21,0:03:37.88,Default,,0,0,0,,Үй жануарлары мысық кім!
Dialogue: 0,0:03:37.96,0:03:41.17,Default,,0,0,0,,Сіз өзіңіздің бастапқы пішініңізге оралсаңыз, сіз т.б.
Dialogue: 0,0:03:41.26,0:03:42.18,Default,,0,0,0,,(Смартфонның хабарландыру дыбысы)
Dialogue: 0,0:03:42.26,0:03:43.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.56,0:03:50.73,Default,,0,0,0,,«Осындай сүйкімді құбыжықпен»
Dialogue: 0,0:03:50.81,0:03:54.19,Default,,0,0,0,,«Мен осында тұратыныма қуаныштымын» деп жауап беріңіз.
Dialogue: 0,0:03:54.27,0:03:55.40,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:03:55.48,0:03:57.69,Default,,0,0,0,,Рұқсатсыз мысық қуыршағына қарамаңыз
Dialogue: 0,0:03:57.77,0:03:58.48,Default,,0,0,0,,Хмф!
Dialogue: 0,0:03:59.48,0:04:01.86,Default,,0,0,0,,үшін~ Бүгін менің бүкіл елім...
Dialogue: 0,0:04:01.95,0:04:03.28,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:03.36,0:04:07.58,Default,,0,0,0,,Мен сенімен бірге өмір сүремін деп ешқашан ойламадым.
Dialogue: 0,0:04:07.66,0:04:11.37,Default,,0,0,0,,Қартайып қалдың, Сейген Казамаки.
Dialogue: 0,0:04:11.45,0:04:13.50,Default,,0,0,0,,Пуритан зейнетке шықты ма?
Dialogue: 0,0:04:14.00,0:04:16.79,Default,,0,0,0,,Өйткені Мари оны мұра етті.
Dialogue: 0,0:04:16.88,0:04:21.26,Default,,0,0,0,,Күн сайын мен айдол бейнелерін көріп, ойын ойнаймын.
Dialogue: 0,0:04:21.34,0:04:24.51,Default,,0,0,0,,Сіздің мұрагеріңізде бірдеңе дұрыс емес.
Dialogue: 0,0:04:25.09,0:04:27.93,Default,,0,0,0,,Мен бұл жын патшаны үй жануарларымдағы мысық қылуға қалай батылым барамын?
Dialogue: 0,0:04:28.01,0:04:28.72,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:29.31,0:04:31.35,Default,,0,0,0,,Сіз оны сүйгендіктен жасай алмайсыз!
Dialogue: 0,0:04:31.43,0:04:32.10,Default,,0,0,0,,Һм?
Dialogue: 0,0:04:32.18,0:04:34.44,Default,,0,0,0,,Сузу мені қанша тоқтатқанымен
Dialogue: 0,0:04:34.52,0:04:36.77,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:04:37.77,0:04:40.90,Default,,0,0,0,,Өміріңді құтқарудың орнына, мені бақылауда ұста.
Dialogue: 0,0:04:41.78,0:04:44.36,Default,,0,0,0,,Мен таңғы асты алжапқыш киіп дайындай аламын.
Dialogue: 0,0:04:44.45,0:04:46.45,Default,,0,0,0,,Әйелдік күштің артуы
Dialogue: 0,0:04:46.95,0:04:51.33,Default,,0,0,0,,Жыныстық ояту мен үшін күнәһар әдіс.
Dialogue: 0,0:04:51.41,0:04:54.79,Default,,0,0,0,,Мен және менің атам ғана, сондықтан мен үнемі үй шаруасымен айналысамын!
Dialogue: 0,0:04:54.87,0:04:56.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:56.29,0:04:56.87,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:05:00.80,0:05:01.84,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:01.92,0:05:03.17,Default,,0,0,0,,Жүр.
Dialogue: 0,0:05:03.67,0:05:06.09,Default,,0,0,0,,Мен де саған тамақ дайындап қойдым.
Dialogue: 0,0:05:06.18,0:05:06.93,Default,,0,0,0,,Ағам саған айтпады ма?
Dialogue: 0,0:05:07.68,0:05:10.10,Default,,0,0,0,,Жын болса, жемесем де жақсы болар еді.
Dialogue: 0,0:05:10.60,0:05:12.52,Default,,0,0,0,,Біз бұдан былай бірге тұратын боламыз.
Dialogue: 0,0:05:13.02,0:05:14.18,Default,,0,0,0,,Сіз...
Dialogue: 0,0:05:15.02,0:05:18.23,Default,,0,0,0,,Мен оны жай ғана құлықсыз бала деп ойладым.
Dialogue: 0,0:05:19.06,0:05:21.57,Default,,0,0,0,,Бір қызығы, мен жек көрмейтін нәрселер бар...
Dialogue: 0,0:05:23.78,0:05:26.32,Default,,0,0,0,,Брр! (Мари-сато) Енді, Меши-меши
Dialogue: 0,0:05:26.40,0:05:28.70,Default,,0,0,0,,Сіз жын патшасының қалдықтарын тамақтандыруға тырысасыз ба?
Dialogue: 0,0:05:28.78,0:05:30.53,Default,,0,0,0,,Тек тамақ алу – бақыт!
Dialogue: 0,0:05:30.62,0:05:31.83,Default,,0,0,0,,Ренжісе не істейсің?
Dialogue: 0,0:05:31.91,0:05:32.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:34.16,0:05:35.37,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:05:35.46,0:05:36.21,Default,,0,0,0,,Қалай!
Dialogue: 0,0:05:36.29,0:05:38.67,Default,,0,0,0,,Мен осылай деп ойладым
Dialogue: 0,0:05:38.75,0:05:42.17,Default,,0,0,0,,Мен Широганға дәмді тарту әкелдім.
Dialogue: 0,0:05:42.25,0:05:43.25,Default,,0,0,0,,Хун
Dialogue: 0,0:05:43.34,0:05:46.97,Default,,0,0,0,,Құрбандық шалу жақсы, бақсы.
Dialogue: 0,0:05:47.05,0:05:48.26,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:05:48.34,0:05:50.01,Default,,0,0,0,,Фуфуфуфу~
Dialogue: 0,0:05:51.93,0:05:53.89,Default,,0,0,0,,Сузудың қолдан жасаған тары тұшпарасы
Dialogue: 0,0:05:53.97,0:05:56.64,Default,,0,0,0,,Сузу Данго қысқаша!
Dialogue: 0,0:05:57.23,0:05:59.19,Default,,0,0,0,,Кибиданго?
Dialogue: 0,0:05:59.27,0:06:01.36,Default,,0,0,0,,Мен оны қалай жасауға болатынын интернеттен іздедім.
Dialogue: 0,0:06:01.86,0:06:05.44,Default,,0,0,0,,Өте дәмді болды, маған да ұнады.
Dialogue: 0,0:06:05.53,0:06:08.78,Default,,0,0,0,,Менің шынымен жегім келетіні - сенсің.
Dialogue: 0,0:06:08.86,0:06:11.70,Default,,0,0,0,,Осының арқасында мен ескі әңгімедегі ақымақ жануар сияқтымын.
Dialogue: 0,0:06:11.78,0:06:13.79,Default,,0,0,0,,Дәл сіз өзіңізді қолға алуға болады деп ойлаған кезде...
Dialogue: 0,0:06:13.87,0:06:14.74,Default,,0,0,0,,Пакуку
Dialogue: 0,0:06:14.83,0:06:15.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:17.83,0:06:21.08,Default,,0,0,0,,Ханасаде Сузудің шайнайтын құрылымы қою шабдалыға ұқсас
Dialogue: 0,0:06:21.17,0:06:22.79,Default,,0,0,0,,Нәзік тәттілік!
Dialogue: 0,0:06:23.63,0:06:26.71,Default,,0,0,0,,Қолдан жасалғандықтан, діни қызметкердің өмірлік энергиясы
Dialogue: 0,0:06:26.80,0:06:29.51,Default,,0,0,0,,Ол құпия ингредиент сияқты сіңеді...
Dialogue: 0,0:06:29.59,0:06:34.26,Default,,0,0,0,,А, бұл менмін!
Dialogue: 0,0:06:34.35,0:06:35.68,Default,,0,0,0,,Гацу Гацу Гацу Гацу...
Dialogue: 0,0:06:35.77,0:06:36.72,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:06:36.81,0:06:38.14,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:06:38.77,0:06:41.90,Default,,0,0,0,,Мен оны күнде жасаймын, сондықтан оны жеуден бас тартамын деп ойлаймын.
Dialogue: 0,0:06:41.98,0:06:44.11,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:06:44.19,0:06:45.32,Default,,0,0,0,,Сен таңқаларлықтай кішкентай екенсің ғой?
Dialogue: 0,0:06:46.73,0:06:48.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:50.49,0:06:53.45,Default,,0,0,0,,«Егер мен Широганмен шынымен дос бола алсам».
Dialogue: 0,0:06:53.53,0:06:55.08,Default,,0,0,0,,«Бәрі шешілді, солай ма?»
Dialogue: 0,0:06:55.16,0:06:58.58,Default,,0,0,0,,Ал... достар? Мына мысық Дарума?
Dialogue: 0,0:06:59.21,0:06:59.91,Default,,0,0,0,,Уау
Dialogue: 0,0:07:00.92,0:07:04.17,Default,,0,0,0,,Эй, сен Сузу байсалдысың ба?
Dialogue: 0,0:07:05.21,0:07:06.42,Default,,0,0,0,,Маған көбірек беріңіз!
Dialogue: 0,0:07:06.50,0:07:08.71,Default,,0,0,0,,Мен не істеуім керек? Мен көбірек қалаймын.
Dialogue: 0,0:07:08.80,0:07:11.38,Default,,0,0,0,,Ол шешімді бала.
Dialogue: 0,0:07:11.97,0:07:16.10,Default,,0,0,0,,Мені жеуге тырысқан құбыжықтан қорықпаймын.
Dialogue: 0,0:07:16.68,0:07:20.60,Default,,0,0,0,,Күткендей ол Маридің көп жылдар бойы табынатын пұт.
Dialogue: 0,0:07:20.69,0:07:21.89,Default,,0,0,0,,Боу!
Dialogue: 0,0:07:21.98,0:07:24.77,Default,,0,0,0,,А... Идол? Бұл қандай мысал?
Dialogue: 0,0:07:24.86,0:07:26.23,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:07:26.32,0:07:27.98,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:28.07,0:07:28.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:28.99,0:07:32.57,Default,,0,0,0,,Кішкентай кезіңде жын-шайтан қорқатын.
Dialogue: 0,0:07:32.66,0:07:33.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:35.32,0:07:36.49,Default,,0,0,0,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:07:36.58,0:07:37.70,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,0:07:37.79,0:07:38.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.54,0:07:40.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:42.96,0:07:44.33,Default,,0,0,0,,Жол
Dialogue: 0,0:07:44.42,0:07:45.59,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:45.67,0:07:48.09,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:07:48.71,0:07:50.34,Default,,0,0,0,,Ата! (Сейген) А?
Dialogue: 0,0:07:50.42,0:07:52.97,Default,,0,0,0,,Елес Елес...
Dialogue: 0,0:07:53.05,0:07:54.68,Default,,0,0,0,,Жол
Dialogue: 0,0:07:57.31,0:08:00.31,Default,,0,0,0,,Уф... Уау...
Dialogue: 0,0:08:00.39,0:08:03.48,Default,,0,0,0,,Тағы да келді, қорқамын
Dialogue: 0,0:08:03.56,0:08:06.02,Default,,0,0,0,,Неліктен мен елестерді көре аламын?
Dialogue: 0,0:08:06.11,0:08:10.74,Default,,0,0,0,,Сенің де жын шығару қабілетің бар.
Dialogue: 0,0:08:11.32,0:08:14.78,Default,,0,0,0,,Маған ұнамайды. Мен мұны көргім келмейді.
Dialogue: 0,0:08:15.95,0:08:17.83,Default,,0,0,0,,Мацури-я (Мари-сато) иә?
Dialogue: 0,0:08:17.91,0:08:19.54,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:08:19.62,0:08:21.54,Default,,0,0,0,,Олар бұзақылықты жақсы көреді.
Dialogue: 0,0:08:21.62,0:08:23.66,Default,,0,0,0,,Ол көңілді және мені таң қалдырады.
Dialogue: 0,0:08:24.54,0:08:26.71,Default,,0,0,0,,Сіз мұны айтқан болсаңыз да...
Dialogue: 0,0:08:27.21,0:08:29.09,Default,,0,0,0,,(Маридің ауыр тыныс алуы)
Dialogue: 0,0:08:29.17,0:08:31.46,Default,,0,0,0,,Кекекеке Кекекеке (Мари) Уау!
Dialogue: 0,0:08:31.55,0:08:33.05,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:08:33.67,0:08:34.88,Default,,0,0,0,,Қарғыс атсын... Келме.
Dialogue: 0,0:08:34.97,0:08:37.05,Default,,0,0,0,,Кеке Кекеке мен жеймін~
Dialogue: 0,0:08:37.14,0:08:38.35,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:38.93,0:08:40.10,Default,,0,0,0,,Жоқ, Чотчий
Dialogue: 0,0:08:40.18,0:08:41.14,Default,,0,0,0,,Иә? (Чокчи) Ке?
Dialogue: 0,0:08:41.72,0:08:43.81,Default,,0,0,0,,Мені қорлағаныңыз үшін ренжімейсіз бе?
Dialogue: 0,0:08:43.89,0:08:44.73,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:08:44.81,0:08:46.48,Default,,0,0,0,,Кеке~
Dialogue: 0,0:08:46.56,0:08:47.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.19,0:08:51.69,Default,,0,0,0,,Кешіріңіз, мен бұзық болып жүрмін, бірақ мен жаман қыз емеспін.
Dialogue: 0,0:08:52.19,0:08:53.32,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:08:54.32,0:08:56.24,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,0:08:56.32,0:08:59.49,Default,,0,0,0,,Дұрысы, сіз оны көре аласыз ба? бұл балалар
Dialogue: 0,0:08:59.58,0:09:01.33,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:01.41,0:09:03.54,Default,,0,0,0,,Жарайды, мен қорықпаймын.
Dialogue: 0,0:09:03.62,0:09:04.71,Default,,0,0,0,,Кю…
Dialogue: 0,0:09:04.79,0:09:05.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.87,0:09:08.25,Default,,0,0,0,,Қараңызшы, олардың бәрі жақсы балалар, солай ма?
Dialogue: 0,0:09:08.33,0:09:10.13,Default,,0,0,0,,Сіз де дос бола аласыз.
Dialogue: 0,0:09:11.92,0:09:15.05,Default,,0,0,0,,Мынадай құбыжықты көруге қалай дәтің бар...
Dialogue: 0,0:09:16.72,0:09:18.01,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:18.68,0:09:22.22,Default,,0,0,0,,Бұл жігіт өте керемет
Dialogue: 0,0:09:23.60,0:09:26.69,Default,,0,0,0,,Сузу-чан сіздің арманыңыз.
Dialogue: 0,0:09:26.77,0:09:29.11,Default,,0,0,0,,Сондықтан Сузу-чанды қорғау үшін
Dialogue: 0,0:09:29.19,0:09:32.78,Default,,0,0,0,,«Еркек болып қайта алмасам да» деп ойлаймын
Dialogue: 0,0:09:34.90,0:09:39.66,Default,,0,0,0,,Бірақ, айдолдар мен құмар жанкүйерлер арасында әрқашан қарым-қатынас болады.
Dialogue: 0,0:09:40.24,0:09:43.37,Default,,0,0,0,,Менің ойымша, ол бала мұны қаламайды.
Dialogue: 0,0:09:43.45,0:09:47.33,Default,,0,0,0,,Сонымен... Сонда бұл «кумир мен фанат» деген не?
Dialogue: 0,0:09:47.42,0:09:50.50,Default,,0,0,0,,Сіз сахнаның астынан қарап отырсаңыз
Dialogue: 0,0:09:50.59,0:09:54.05,Default,,0,0,0,,Бұл қашықтық ешқашан қысқармайтынын білдіреді.
Dialogue: 0,0:09:54.13,0:09:55.55,Default,,0,0,0,,...
Dialogue: 0,0:09:55.63,0:09:57.01,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:09:57.09,0:09:57.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:59.18,0:09:59.89,Default,,0,0,0,,Қисық адам!
Dialogue: 0,0:10:01.14,0:10:02.18,Default,,0,0,0,,Хмм? Ах
Dialogue: 0,0:10:04.81,0:10:05.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:06.56,0:10:08.73,Default,,0,0,0,,Мацури! не болды?
Dialogue: 0,0:10:09.31,0:10:10.44,Default,,0,0,0,,Құс қауырсындары?
Dialogue: 0,0:10:10.52,0:10:13.07,Default,,0,0,0,,Жоқ, ол емес, бұл жын қауырсыны.
Dialogue: 0,0:10:13.15,0:10:15.78,Default,,0,0,0,,Боқ, сен Сузуды нысанаға алған құбыжықсың ба?
Dialogue: 0,0:10:15.86,0:10:18.70,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:10:19.61,0:10:20.66,Default,,0,0,0,,«Шикиони»
Dialogue: 0,0:10:20.74,0:10:24.12,Default,,0,0,0,,Басқаша айтқанда, сол салада жұмыс істейтін жын.
Dialogue: 0,0:10:24.20,0:10:25.62,Default,,0,0,0,,жолы да мүмкін.
Dialogue: 0,0:10:26.25,0:10:27.25,Default,,0,0,0,,Құрдастар?
Dialogue: 0,0:10:27.33,0:10:28.58,Default,,0,0,0,,Сіз жын шығарушыны айтасыз ба?
Dialogue: 0,0:10:29.62,0:10:33.04,Default,,0,0,0,,Бұл қиындыққа айналмайды деп үміттенемін.
Dialogue: 0,0:10:36.09,0:10:38.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:43.35,0:10:45.47,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:10:45.56,0:10:47.18,Default,,0,0,0,,Ием!
Dialogue: 0,0:10:47.27,0:10:49.85,Default,,0,0,0,,Кешіріңіз, Мырза.
Dialogue: 0,0:10:49.94,0:10:51.94,Default,,0,0,0,,Мен байқадым.
Dialogue: 0,0:10:52.02,0:10:53.15,Default,,0,0,0,,Сіз тәжірибесізсіз
Dialogue: 0,0:10:53.23,0:10:54.65,Default,,0,0,0,,Гааа!
Dialogue: 0,0:10:54.73,0:10:56.57,Default,,0,0,0,,Қарсылас - Казамаки отбасы
Dialogue: 0,0:10:56.65,0:10:58.40,Default,,0,0,0,,Мен саған сақтықты түсірме дедім.
Dialogue: 0,0:10:59.86,0:11:00.45,Default,,0,0,0,,Әдетте үнсіз жүретін адам
Dialogue: 0,0:11:04.91,0:11:06.87,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:11:08.54,0:11:12.17,Default,,0,0,0,,Бірақ бұл көңіл көншітетін есеп.
Dialogue: 0,0:11:12.67,0:11:15.88,Default,,0,0,0,,Казамаки Мацури Мен ол үшінмін
Dialogue: 0,0:11:15.96,0:11:18.84,Default,,0,0,0,,Мен сізге нұсқау беруім керек сияқты.
Dialogue: 0,0:11:24.18,0:11:26.18,Default,,0,0,0,,Қандай үйірмемен айналысуым керек?
Dialogue: 0,0:11:26.26,0:11:27.18,Default,,0,0,0,,Лу ше?
Dialogue: 0,0:11:27.26,0:11:27.97,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:28.06,0:11:30.81,Default,,0,0,0,,Егер бұл оккультизм клубы болса, бұл туралы ойлануға болады.
Dialogue: 0,0:11:30.89,0:11:33.77,Default,,0,0,0,,Эй, Сузу мен Мари шешті ме?
Dialogue: 0,0:11:33.85,0:11:37.02,Default,,0,0,0,,Хмм, мен үйге келу клубындамын деп ойлаймын.
Dialogue: 0,0:11:37.11,0:11:39.28,Default,,0,0,0,,Менде де негізінен сыныптан тыс жұмыстар бар...
Dialogue: 0,0:11:39.86,0:11:41.36,Default,,0,0,0,,Бұл не? байт?
Dialogue: 0,0:11:41.45,0:11:42.99,Default,,0,0,0,,А, мен болжаймын.
Dialogue: 0,0:11:44.41,0:11:45.91,Default,,0,0,0,,Бұл әрине қызметші кафе, солай ма?
Dialogue: 0,0:11:45.99,0:11:47.99,Default,,0,0,0,,Бұл қалада ештеңе жоқ, солай ма?
Dialogue: 0,0:11:48.58,0:11:50.12,Default,,0,0,0,,Сонымен, бұл жеткізу заты ма?
Dialogue: 0,0:11:50.20,0:11:52.00,Default,,0,0,0,,Жүгіру жылдамырақ
Dialogue: 0,0:11:52.08,0:11:56.38,Default,,0,0,0,,Сіз байсалды көрінесіз, сондықтан сізге президенттің хатшысы жақсы жарасады.
Dialogue: 0,0:11:56.46,0:11:58.25,Default,,0,0,0,,Ол жоғары сынып оқушысы!
Dialogue: 0,0:11:58.34,0:12:00.84,Default,,0,0,0,,Менің айтайын дегенім, оның денесі әдемі.
Dialogue: 0,0:12:00.92,0:12:03.01,Default,,0,0,0,,Гравюра пұт болған жақсы емес пе?
Dialogue: 0,0:12:03.09,0:12:05.47,Default,,0,0,0,,Мен қызымның бикиниіне қарсы тұра алмаймын
Dialogue: 0,0:12:05.55,0:12:07.22,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:12:08.10,0:12:10.06,Default,,0,0,0,,Бұл Казамаки Мацури
Dialogue: 0,0:12:10.56,0:12:14.65,Default,,0,0,0,,Бірақ сыртқы түрі басқа болса да, мен оны түсінемін, өйткені...
Dialogue: 0,0:12:18.86,0:12:21.61,Default,,0,0,0,,Кеш болды. Уақыт өтіп кетті.
Dialogue: 0,0:12:21.69,0:12:24.74,Default,,0,0,0,,Нашар Жаман Мен аздап адасып қалдым.
Dialogue: 0,0:12:25.45,0:12:27.12,Default,,0,0,0,,Мен оны атамнан естідім.
Dialogue: 0,0:12:27.20,0:12:31.29,Default,,0,0,0,,Сіз құдайдың жылдам жын шығаратын Ниномагари отбасының мұрагерісіз, солай ма?
Dialogue: 0,0:12:31.79,0:12:35.04,Default,,0,0,0,,Бүгін менің Казамаки Мацуриге алғашқы миссиям. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:35.62,0:12:36.79,Default,,0,0,0,,Танысқаныма қуаныштымын ба?
Dialogue: 0,0:12:36.88,0:12:40.17,Default,,0,0,0,,Күлуді тоқтатыңыз! Жын шығару миссиясы таныс емес.
Dialogue: 0,0:12:40.25,0:12:43.55,Default,,0,0,0,,Жаңа ғана менің шеберлер тобы мені жаңадан келгенмен бірге жүруді сұрады.
Dialogue: 0,0:12:44.38,0:12:48.39,Default,,0,0,0,,Біздің мақсатымыз тек адамдарға зиян келтіретін жындарды жою.
Dialogue: 0,0:12:49.01,0:12:52.14,Default,,0,0,0,,Егер ол сені ұстап қалса, мен оны бірден лақтырып жіберемін.
Dialogue: 0,0:12:52.64,0:12:53.56,Default,,0,0,0,,Сіз...
Dialogue: 0,0:12:54.06,0:12:55.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:55.52,0:12:57.44,Default,,0,0,0,,«Шоши» нені білдіреді?
Dialogue: 0,0:12:57.52,0:12:58.61,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:13:03.65,0:13:07.32,Default,,0,0,0,,Беделді жын шығарушы Казамакидің мұрагері
Dialogue: 0,0:13:07.91,0:13:09.58,Default,,0,0,0,,Бір жас кіші
Dialogue: 0,0:13:09.66,0:13:11.95,Default,,0,0,0,,Көңілім толқып кетті, бала екен деп ойладым.
Dialogue: 0,0:13:12.54,0:13:13.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:14.16,0:13:16.04,Default,,0,0,0,,(Иттің үруі)
Dialogue: 0,0:13:17.25,0:13:18.58,Default,,0,0,0,,Гаруру~
Dialogue: 0,0:13:19.08,0:13:21.05,Default,,0,0,0,,Бұл туралы не деуге болады? жаңа күріш
Dialogue: 0,0:13:21.13,0:13:23.17,Default,,0,0,0,,Егер қиын болса, мен саған қол ұшын созамын...
Dialogue: 0,0:13:23.26,0:13:23.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:23.92,0:13:26.55,Default,,0,0,0,,Уф, уф, таа
Dialogue: 0,0:13:27.05,0:13:28.22,Default,,0,0,0,,Гауу~
Dialogue: 0,0:13:28.97,0:13:30.22,Default,,0,0,0,,Күшті!
Dialogue: 0,0:13:31.01,0:13:31.85,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:13:32.77,0:13:33.43,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:13:34.06,0:13:35.48,Default,,0,0,0,,Мен сенімді болдым
Dialogue: 0,0:13:35.56,0:13:39.15,Default,,0,0,0,,Бұл жігіт таза нинмен жарысатын дос бола алады...
Dialogue: 0,0:13:39.23,0:13:40.15,Default,,0,0,0,,Сәлем! Тааа!
Dialogue: 0,0:13:40.23,0:13:42.27,Default,,0,0,0,,Егер біз бәсекелес бола алсақ
Dialogue: 0,0:13:43.28,0:13:44.07,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:13:46.82,0:13:49.07,Default,,0,0,0,,Өйткені менде осындай жақсы нәрсе бар~
Dialogue: 0,0:13:49.16,0:13:50.41,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:13:50.49,0:13:52.70,Default,,0,0,0,,Керемет өрнек, тамаша көрінеді
Dialogue: 0,0:13:52.79,0:13:54.79,Default,,0,0,0,,Сузу, маған көмектес!
Dialogue: 0,0:13:54.87,0:13:56.54,Default,,0,0,0,,Яйо, тоқта!
Dialogue: 0,0:13:56.62,0:13:59.17,Default,,0,0,0,,Қандай керемет қарсылас!
Dialogue: 0,0:13:59.96,0:14:03.67,Default,,0,0,0,,Сенің мектепке келе жатқаныңды білгенде асыға күттім.
Dialogue: 0,0:14:04.76,0:14:07.80,Default,,0,0,0,,Бұдан былай біз бірге жаттығуда көп жұмыс істей аламыз.
Dialogue: 0,0:14:08.38,0:14:09.89,Default,,0,0,0,,Ием!
Dialogue: 0,0:14:09.97,0:14:11.76,Default,,0,0,0,,Поносуке, сіздің мақсатыңыз қандай?
Dialogue: 0,0:14:12.35,0:14:15.77,Default,,0,0,0,,Мен ауладағы орындықта жайбарақат шашымды жинап жатырмын.
Dialogue: 0,0:14:16.81,0:14:20.60,Default,,0,0,0,,Жақсысың ба? Мен жын патшаны өлтірсем де
Dialogue: 0,0:14:20.69,0:14:25.07,Default,,0,0,0,,Круппо! Суга-сама деген бір ғана шебер бар.
Dialogue: 0,0:14:25.15,0:14:25.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:27.74,0:14:28.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:29.57,0:14:32.95,Default,,0,0,0,,Атышулы жын патша Широган
Dialogue: 0,0:14:33.70,0:14:34.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:35.45,0:14:38.58,Default,,0,0,0,,Ақша Бар болғаны! Кешір мені, Нино Сонг!
Dialogue: 0,0:14:38.66,0:14:39.54,Default,,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:14:39.62,0:14:44.46,Default,,0,0,0,,Тақсыр, сенің түрің сонша, адамдар сені қылмыскер деп ойлайды.
Dialogue: 0,0:14:45.71,0:14:47.97,Default,,0,0,0,,Фу~ Мен қиындыққа тап болдым.
Dialogue: 0,0:14:48.47,0:14:50.84,Default,,0,0,0,,Мариде шиыршық бар болғандықтан
Dialogue: 0,0:14:50.93,0:14:53.80,Default,,0,0,0,,Біз де оны мұқият қадағалап отыруымыз керек.
Dialogue: 0,0:14:53.89,0:14:57.85,Default,,0,0,0,,Күткендей, мен оны әзірге үй жануарлары ретінде ұстауым керек және оның ашылуын күтуім керек...
Dialogue: 0,0:14:59.23,0:14:59.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:01.31,0:15:02.65,Default,,0,0,0,,Біртүрлі
Dialogue: 0,0:15:02.73,0:15:06.78,Default,,0,0,0,,Бұл жігіт мені көріп тұрғандай...
Dialogue: 0,0:15:06.86,0:15:09.11,Default,,0,0,0,,Мен шынымен абдырап қалдым
Dialogue: 0,0:15:09.19,0:15:11.74,Default,,0,0,0,,Әйелдер үнемі осылай бола ма?
Dialogue: 0,0:15:11.82,0:15:13.70,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,0:15:13.78,0:15:16.24,Default,,0,0,0,,Мен ол жігітке жақсы болмауым мүмкін.
Dialogue: 0,0:15:16.33,0:15:19.66,Default,,0,0,0,,Йайо - тері жамылғысы күшті қыз.
Dialogue: 0,0:15:19.75,0:15:21.96,Default,,0,0,0,,Менің айтайын дегенім, Широган қайда?
Dialogue: 0,0:15:22.04,0:15:24.59,Default,,0,0,0,,Мен саған түскі асқа тары тұшпара бермек болдым.
Dialogue: 0,0:15:25.34,0:15:26.55,Default,,0,0,0,,Қазір!
Dialogue: 0,0:15:27.13,0:15:27.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:28.84,0:15:30.72,Default,,0,0,0,,Бұл адам сізді көре ала ма?
Dialogue: 0,0:15:31.30,0:15:33.51,Default,,0,0,0,,Ол бір мектепте оқыды ма?
Dialogue: 0,0:15:33.59,0:15:34.51,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:15:34.60,0:15:35.64,Default,,0,0,0,,Ug~
Dialogue: 0,0:15:35.72,0:15:38.27,Default,,0,0,0,,Эксорцист Ниномаку Соуга
Dialogue: 0,0:15:38.35,0:15:41.94,Default,,0,0,0,,Мен сізге Фугайнай Казамаки атынан билік етемін.
Dialogue: 0,0:15:42.02,0:15:44.19,Default,,0,0,0,,Нино музыкасының орындаушысы?
Dialogue: 0,0:15:45.02,0:15:48.32,Default,,0,0,0,,Бұл салада олар Казамаки отбасы сияқты білікті.
Dialogue: 0,0:15:48.40,0:15:50.44,Default,,0,0,0,,Бұл жын шығару отбасы емес пе?
Dialogue: 0,0:15:50.53,0:15:51.65,Default,,0,0,0,,Хо
Dialogue: 0,0:15:51.74,0:15:54.70,Default,,0,0,0,,Әлсірегенімен, ол өте жылдам.
Dialogue: 0,0:15:55.78,0:15:56.62,Default,,0,0,0,,Әй
Dialogue: 0,0:15:57.12,0:15:58.37,Default,,0,0,0,,Нинокёку Сенпай!
Dialogue: 0,0:15:58.45,0:15:59.33,Default,,0,0,0,,Казамаки?
Dialogue: 0,0:15:59.41,0:16:01.58,Default,,0,0,0,,Сенен көңілім қалды.
Dialogue: 0,0:16:02.08,0:16:02.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.87,0:16:06.63,Default,,0,0,0,,Есіңде ме? Жарты жыл бұрын сізбен болған алғашқы миссиям
Dialogue: 0,0:16:07.21,0:16:10.63,Default,,0,0,0,,Бізге күтпеген жерден қорқынышты жындар тобы шабуыл жасады.
Dialogue: 0,0:16:10.71,0:16:12.13,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:12.22,0:16:15.09,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:16:15.18,0:16:15.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:15.93,0:16:17.89,Default,,0,0,0,,Гаруруру…
Dialogue: 0,0:16:18.39,0:16:20.81,Default,,0,0,0,,Казамаки Ол тірі ме?
Dialogue: 0,0:16:20.89,0:16:22.02,Default,,0,0,0,,О
Dialogue: 0,0:16:22.10,0:16:26.27,Default,,0,0,0,,Оны бірінші миссияға айналдыру біраз ақымақтық. Бұл ауыр.
Dialogue: 0,0:16:26.36,0:16:28.52,Default,,0,0,0,,Бұл итермелеу жағдайы ма?
Dialogue: 0,0:16:30.19,0:16:31.78,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:16:31.86,0:16:32.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.53,0:16:36.16,Default,,0,0,0,,Сізге жүк тым ауыр. Әзірге артқа шегініңіз.
Dialogue: 0,0:16:36.24,0:16:39.28,Default,,0,0,0,,Қарғыс атқыр... Не айттыңыз?
Dialogue: 0,0:16:40.62,0:16:42.12,Default,,0,0,0,,Сіз оны тарта алмайсыз!
Dialogue: 0,0:16:42.20,0:16:44.50,Default,,0,0,0,,Гуаа...
Dialogue: 0,0:16:49.04,0:16:51.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:56.22,0:16:57.05,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:16:57.14,0:16:58.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:01.02,0:17:04.69,Default,,0,0,0,,Менің танығаным сенің күшің емес еді.
Dialogue: 0,0:17:04.77,0:17:06.06,Default,,0,0,0,,Қандай қиын жағдайға тап болсаң да
Dialogue: 0,0:17:06.69,0:17:10.86,Default,,0,0,0,,Адамдарға қауіп төндіретін жындарды ешқашан кешірмейтінімізге сенеміз.
Dialogue: 0,0:17:11.36,0:17:14.86,Default,,0,0,0,,Мені соқыр етіп, әйелге айналдыруға көмектесу мүмкін емес.
Dialogue: 0,0:17:14.95,0:17:18.49,Default,,0,0,0,,Жеке жағдайға байланысты мен ер адам болып оралғым келеді.
Dialogue: 0,0:17:18.57,0:17:21.37,Default,,0,0,0,,Қауіпті құбыжықты өмір сүруге рұқсат ету туралы шешім жоқ.
Dialogue: 0,0:17:22.70,0:17:23.50,Default,,0,0,0,,Киіңіз!
Dialogue: 0,0:17:26.71,0:17:28.92,Default,,0,0,0,,Мен одан құтыламын.
Dialogue: 0,0:17:29.50,0:17:30.63,Default,,0,0,0,,Нинокёку Сенпай
Dialogue: 0,0:17:31.30,0:17:34.51,Default,,0,0,0,,Мен ер адам Казамаки Мацуриге бағыт-бағдар беремін.
Dialogue: 0,0:17:34.59,0:17:35.34,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:17:35.42,0:17:36.72,Default,,0,0,0,,А, күте тұр... күте тұр...
Dialogue: 0,0:17:36.80,0:17:39.89,Default,,0,0,0,,Сен менің құдайлық жылдамдығыма жете алмайсың!
Dialogue: 0,0:17:41.76,0:17:43.18,Default,,0,0,0,,Бұрынғыдай жылдам
Dialogue: 0,0:17:43.27,0:17:44.89,Default,,0,0,0,,Бұлай жалғаса берсе, Широган...
Dialogue: 0,0:17:46.10,0:17:47.73,Default,,0,0,0,,Гяа!
Dialogue: 0,0:17:53.61,0:17:54.78,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:17:55.28,0:17:57.82,Default,,0,0,0,,Ондай жағдайда қалайының қауіптілігі бір есе азаяды.
Dialogue: 0,0:18:01.45,0:18:06.16,Default,,0,0,0,,Широганды қуып шығарса, Мари өмірінің соңына дейін қыз болып қалады.
Dialogue: 0,0:18:07.33,0:18:10.71,Default,,0,0,0,,Өтінемін, Мари, мені аман-есен қайтар.
Dialogue: 0,0:18:12.17,0:18:13.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:14.17,0:18:16.80,Default,,0,0,0,,Бұл мен сөйлесе алатын адам емес.
Dialogue: 0,0:18:17.38,0:18:19.51,Default,,0,0,0,,Қарғыс атсын... егер бұл менің шын тұлғам болса.
Dialogue: 0,0:18:19.59,0:18:22.60,Default,,0,0,0,,Әлгі жігіт, мен оны оңай қуып жібердім.
Dialogue: 0,0:18:23.47,0:18:27.48,Default,,0,0,0,,Хаа ха... Осы уақытқа дейін келген болсаң, жақсы болады.
Dialogue: 0,0:18:27.98,0:18:32.23,Default,,0,0,0,,Я~ Мен оны бүгінге қалдырамын.
Dialogue: 0,0:18:32.98,0:18:33.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.36,0:18:37.40,Default,,0,0,0,,Маған демалыс беріңізші!
Dialogue: 0,0:18:37.49,0:18:39.20,Default,,0,0,0,,Дайын болыңыз! Қазір!
Dialogue: 0,0:18:39.82,0:18:42.62,Default,,0,0,0,,Ағымдағы шабуылдан қалай құтылуға болады?
Dialogue: 0,0:18:42.70,0:18:44.79,Default,,0,0,0,,Бұл жай ғана кездейсоқ болды!
Dialogue: 0,0:18:45.37,0:18:47.00,Default,,0,0,0,,Келесі жолы қашып кетейін
Dialogue: 0,0:18:47.54,0:18:50.00,Default,,0,0,0,,Сенің де тағдырың осында бітеді.
Dialogue: 0,0:18:51.33,0:18:52.79,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:18:52.88,0:18:53.96,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар
Dialogue: 0,0:18:55.55,0:18:56.76,Default,,0,0,0,,Жел!
Dialogue: 0,0:18:57.42,0:19:00.47,Default,,0,0,0,,Аспанда қалықтап, ең қысқа қашықтықта қуып жету?
Dialogue: 0,0:19:01.22,0:19:03.22,Default,,0,0,0,,Кешіріңіз, Ni no Kyoku Senpai
Dialogue: 0,0:19:03.30,0:19:05.31,Default,,0,0,0,,Өйткені, бұл жігіт өлсе, мәселе болар еді.
Dialogue: 0,0:19:05.39,0:19:09.69,Default,,0,0,0,,Пурист ретіндегі миссияңызды емес, жеке жағдайыңызды таңдайсыз ба?
Dialogue: 0,0:19:11.31,0:19:12.23,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:19:14.36,0:19:16.11,Default,,0,0,0,,Мен сізді таныдым, өйткені
Dialogue: 0,0:19:16.69,0:19:21.49,Default,,0,0,0,,Себебі мен сенің ішіңнен ешқашан тоқтамайтын ыстық желді сезіндім.
Dialogue: 0,0:19:22.49,0:19:24.12,Default,,0,0,0,,Нинокёку Сенпай
Dialogue: 0,0:19:28.16,0:19:30.62,Default,,0,0,0,,Менің бала кездегі өзімшіл досым болды.
Dialogue: 0,0:19:30.71,0:19:32.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:34.63,0:19:39.51,Default,,0,0,0,,Әлгі жігіт... Сузу Хананаде - бақсы.
Dialogue: 0,0:19:40.80,0:19:41.93,Default,,0,0,0,,Діни әйел?
Dialogue: 0,0:19:42.01,0:19:44.30,Default,,0,0,0,,Сондықтан бұл жігіт Сузуды нысанаға алады.
Dialogue: 0,0:19:44.39,0:19:45.01,Default,,0,0,0,,Пуи!
Dialogue: 0,0:19:45.10,0:19:49.10,Default,,0,0,0,,Сузу рухын бойына сіңіріп, бұрынғы қалпына оралу үшін.
Dialogue: 0,0:19:49.18,0:19:49.85,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:50.81,0:19:52.19,Default,,0,0,0,,Бірақ ол...
Dialogue: 0,0:19:53.69,0:19:57.36,Default,,0,0,0,,Ол Широганмен дос болуға тырысады.
Dialogue: 0,0:19:58.15,0:20:00.24,Default,,0,0,0,,Мен қайтадан адам болу үшін
Dialogue: 0,0:20:01.57,0:20:03.78,Default,,0,0,0,,Бұл жігітпен бір-бірімізді түсінуге мүмкіндік жоқ.
Dialogue: 0,0:20:04.36,0:20:06.53,Default,,0,0,0,,Мен одан арылу керек деп ойлаймын.
Dialogue: 0,0:20:06.62,0:20:07.28,Default,,0,0,0,,Хмф!
Dialogue: 0,0:20:08.04,0:20:10.54,Default,,0,0,0,,Мен оның сезімін жоққа шығарғым келмейді.
Dialogue: 0,0:20:13.42,0:20:17.63,Default,,0,0,0,,Өйткені Сузудың бар болуы менің желімнің орталығы.
Dialogue: 0,0:20:18.13,0:20:19.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:19.30,0:20:21.80,Default,,0,0,0,,Сиқырды қорғау үшін
Dialogue: 0,0:20:21.88,0:20:24.30,Default,,0,0,0,,Сіз қауіпті Широганды тірі қалдырғыңыз келе ме?
Dialogue: 0,0:20:24.38,0:20:25.89,Default,,0,0,0,,Сіз тәжірибесізсіз! Бұл жағдайда...
Dialogue: 0,0:20:25.97,0:20:27.18,Default,,0,0,0,,Сіз күшпен!
Dialogue: 0,0:20:27.26,0:20:28.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:28.81,0:20:29.43,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:20:33.94,0:20:37.36,Default,,0,0,0,,Та та та та... Мен сені жеңсем де...
Dialogue: 0,0:20:38.61,0:20:40.86,Default,,0,0,0,,Гуаа
Dialogue: 0,0:20:40.94,0:20:42.07,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,0:20:42.65,0:20:45.78,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсіндім. Бұл іс тоқтатылды!
Dialogue: 0,0:20:46.28,0:20:48.08,Default,,0,0,0,,Не? Эй, кенеттен не болды?
Dialogue: 0,0:20:48.66,0:20:51.16,Default,,0,0,0,,Себебі сен трусигіңді көрсеттің!
Dialogue: 0,0:20:51.25,0:20:52.62,Default,,0,0,0,,Ұятсыз!
Dialogue: 0,0:20:52.70,0:20:53.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.71,0:20:57.83,Default,,0,0,0,,Сіз оны өлтірдіңіз бе? Мырза
Dialogue: 0,0:20:58.88,0:21:01.26,Default,,0,0,0,,Мен жетілмегенмін...
Dialogue: 0,0:21:01.34,0:21:02.26,Default,,0,0,0,,По?
Dialogue: 0,0:21:06.76,0:21:08.64,Default,,0,0,0,,Мацури~!
Dialogue: 0,0:21:08.72,0:21:09.39,Default,,0,0,0,,О
Dialogue: 0,0:21:09.47,0:21:12.93,Default,,0,0,0,,Уа... не... не істеп жатырсың?
Dialogue: 0,0:21:13.02,0:21:14.73,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:21:14.81,0:21:16.19,Default,,0,0,0,,Мені жібер
Dialogue: 0,0:21:16.27,0:21:17.31,Default,,0,0,0,,Ах
Dialogue: 0,0:21:17.40,0:21:19.69,Default,,0,0,0,,Сіз аштыңыз ба? иә
Dialogue: 0,0:21:19.77,0:21:20.98,Default,,0,0,0,,О!
Dialogue: 0,0:21:21.07,0:21:22.19,Default,,0,0,0,,Бакубаку жұтылу
Dialogue: 0,0:21:22.28,0:21:23.49,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:21:23.57,0:21:25.57,Default,,0,0,0,,Себебі менің басымнан бір сұмдық болды.
Dialogue: 0,0:21:25.65,0:21:28.74,Default,,0,0,0,,Мұны адамдар шарасыз жегіш деп атайды.
Dialogue: 0,0:21:29.24,0:21:34.00,Default,,0,0,0,,Ах, мен бақсының өмірлік қуатына толдым.
Dialogue: 0,0:21:34.08,0:21:36.67,Default,,0,0,0,,Эй, маған көбірек істеу керек.
Dialogue: 0,0:21:36.75,0:21:39.46,Default,,0,0,0,,Ей, сен мен үшін алаңдамайсың ба?
Dialogue: 0,0:21:40.04,0:21:41.63,Default,,0,0,0,,Рахмет, Мари
Dialogue: 0,0:21:42.50,0:21:47.13,Default,,0,0,0,,Мен бұл қызбен жақсы араласатыныма сенімдімін.
Dialogue: 0,0:21:49.64,0:21:50.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:54.77,0:21:56.31,Default,,0,0,0,,Йокосу десу!
Dialogue: 0,0:21:56.39,0:21:58.90,Default,,0,0,0,,Мяу~н Уау Ахахха
Dialogue: 0,0:21:58.98,0:22:01.90,Default,,0,0,0,,Сайып келгенде, бұл жағдай сол күйінде қалады.
Dialogue: 0,0:22:02.61,0:22:04.82,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:33.12,0:23:35.12,Default,,0,0,0,,～♪
