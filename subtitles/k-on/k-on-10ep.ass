Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:23.48,0:01:26.48,Default,,0,0,0,,〈Сәлеметсіз бе, бұл Ю Хирасава〉
Dialogue: 0,0:01:26.48,0:01:30.82,Default,,0,0,0,,〈Бүгін менің Азуса-чанмен бірінші саяхатым〉
Dialogue: 0,0:01:30.82,0:01:32.82,Default,,0,0,0,,⚟(Азуза) Сәлем
Dialogue: 0,0:01:32.82,0:01:34.82,Default,,0,0,0,,Ах, Азуса-чан
Dialogue: 0,0:01:36.49,0:01:38.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:39.83,0:01:42.13,Default,,0,0,0,,Киім сүйкімді~
Dialogue: 0,0:01:43.50,0:01:46.84,Default,,0,0,0,,Келесі жолы жеңіл музыка үйірмесі бар оқу-жаттығу жиынына барасыз.
Dialogue: 0,0:01:46.84,0:01:49.50,Default,,0,0,0,,Иә, 3 түн және 4 күн.
Dialogue: 0,0:01:49.50,0:01:53.84,Default,,0,0,0,,Өткен жылы апам бұл өте қызық болды деді.
Dialogue: 0,0:01:53.84,0:01:55.84,Default,,0,0,0,,Бұл көңілді болды ма?
Dialogue: 0,0:01:57.51,0:02:00.52,Default,,0,0,0,,Бұл сізде көп тәжірибе болды дегенді білдіре ме?
Dialogue: 0,0:02:00.52,0:02:02.85,Default,,0,0,0,,Аа... Уф иә➡
Dialogue: 0,0:02:02.85,0:02:04.85,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:02:04.85,0:02:09.52,Default,,0,0,0,,《(Юи) Ах, қайғы~ Сүйкімді, солай ма?》
Dialogue: 0,0:02:09.52,0:02:14.80,Default,,0,0,0,,Түсінемін~ Сендердің бәрің де өте жақсы ойнайсыңдар.
Dialogue: 0,0:02:14.80,0:02:17.47,Default,,0,0,0,,Оқу-жаттығу жиынына келетін болсақ...
Dialogue: 0,0:02:20.47,0:02:56.47,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:05.47,0:04:08.14,Default,,0,0,0,,Әпке, жеңіл музыка үйірмесі қандай?
Dialogue: 0,0:04:08.14,0:04:10.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:10.15,0:04:12.41,Default,,0,0,0,,Эй, мен солай деп ойлаймын. Не?
Dialogue: 0,0:04:12.41,0:04:14.75,Default,,0,0,0,,Мен мүлде жаттығу жасамаймын.
Dialogue: 0,0:04:14.75,0:04:17.42,Default,,0,0,0,,Ол маған біртүрлі лақап ат қояды➡
Dialogue: 0,0:04:17.42,0:04:20.09,Default,,0,0,0,,Ол тері тігумен айналысады.
Dialogue: 0,0:04:20.09,0:04:23.09,Default,,0,0,0,,Үлкен әпке болу жылы және жақсы сезім, солай емес пе?
Dialogue: 0,0:04:23.09,0:04:26.43,Default,,0,0,0,,Жоқ, менің айтып отырғаным бұл емес.
Dialogue: 0,0:04:26.43,0:04:29.10,Default,,0,0,0,,Юй-сенпай бүгін не істеп жатыр?
Dialogue: 0,0:04:29.10,0:04:31.10,Default,,0,0,0,,Мен үйдемін➡
Dialogue: 0,0:04:31.10,0:04:33.10,Default,,0,0,0,,Үлкен әпке, мен ыстықты ұнатпаймын➡
Dialogue: 0,0:04:33.10,0:04:35.10,Default,,0,0,0,,Мен де кондиционерді жек көремін.
Dialogue: 0,0:04:35.10,0:04:37.44,Default,,0,0,0,,Мен сенің жалқау көрінетініңді көріп тұрмын
Dialogue: 0,0:04:37.44,0:04:40.44,Default,,0,0,0,,Соңғы кездері мен күні бойы шаршадым.
Dialogue: 0,0:04:40.44,0:04:42.44,Default,,0,0,0,,Сен өте тәртіпсізсің.
Dialogue: 0,0:04:42.44,0:04:46.45,Default,,0,0,0,,Бірақ домалап жүрген қыз сондай сүйкімді~
Dialogue: 0,0:04:46.45,0:04:49.45,Default,,0,0,0,,《Қайғы ~》
Dialogue: 0,0:04:49.45,0:04:53.46,Default,,0,0,0,,〈Бұл мұңды сезімнің меннен айырмашылығы неде?〉
Dialogue: 0,0:04:53.46,0:04:58.46,Default,,0,0,0,,Менің Мио-сенпайдай әпкем болса ғой.
Dialogue: 0,0:04:58.46,0:05:02.46,Default,,0,0,0,,⚟(Ю) Мио-сан мейірімді және салқын➡
Dialogue: 0,0:05:02.46,0:05:05.47,Default,,0,0,0,,Рицу ше? ⚟(Азуса) Ммм.
Dialogue: 0,0:05:06.47,0:05:09.14,Default,,0,0,0,,Өйткені ол адам немқұрайлы, нобай.
Dialogue: 0,0:05:09.14,0:05:11.81,Default,,0,0,0,,Өту... Кана (Ритсу) Хо-о
Dialogue: 0,0:05:11.81,0:05:14.81,Default,,0,0,0,,Оны дөрекі деп кім айтты? Ахх!
Dialogue: 0,0:05:15.74,0:05:18.08,Default,,0,0,0,,Сәлем Рицу-сан, Yahoo!
Dialogue: 0,0:05:18.08,0:05:20.42,Default,,0,0,0,,Мен мұны сырттан көргендіктен келдім.
Dialogue: 0,0:05:20.42,0:05:22.42,Default,,0,0,0,,Бүгін жалғызсың ба?
Dialogue: 0,0:05:22.42,0:05:25.42,Default,,0,0,0,,Иә, Мио жазғы сабақтарда.
Dialogue: 0,0:05:25.42,0:05:28.42,Default,,0,0,0,,Рицу-сенпай, баруың керек пе?
Dialogue: 0,0:05:28.42,0:05:30.43,Default,,0,0,0,,Не? Мен?
Dialogue: 0,0:05:30.43,0:05:32.43,Default,,0,0,0,,Жазғы курс Неліктен?
Dialogue: 0,0:05:32.43,0:05:34.76,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:34.76,0:05:39.43,Default,,0,0,0,,Әй, айтпақшы, біраздан бері ойланып жүрмін➡
Dialogue: 0,0:05:39.43,0:05:42.77,Default,,0,0,0,,Муги-сенпай өз шайын әкелді➡
Dialogue: 0,0:05:42.77,0:05:46.78,Default,,0,0,0,,Сіз вилласы бар керемет жас ханымсыз ба?
Dialogue: 0,0:05:46.78,0:05:49.78,Default,,0,0,0,,Дұрыс~ Менің үйде күтуші бар.
Dialogue: 0,0:05:49.78,0:05:52.78,Default,,0,0,0,,Мен ұзақ демалысқа шетелге шығамын.
Dialogue: 0,0:05:52.78,0:05:56.45,Default,,0,0,0,,Шынымен! Бұл қызықты болар еді, солай емес пе?
Dialogue: 0,0:05:56.45,0:05:58.79,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:05:58.79,0:06:02.46,Default,,0,0,0,,Олай болса қазір маған қоңырау шалып, сыртқа шығып көңіл көтерейік.
Dialogue: 0,0:06:02.46,0:06:05.13,Default,,0,0,0,,Амансың ба? Кенеттен солай
Dialogue: 0,0:06:05.13,0:06:08.80,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:06:08.80,0:06:11.80,Default,,0,0,0,,Иә? Мен телефоныма жауап бере алмаймын
Dialogue: 0,0:06:11.80,0:06:14.50,Default,,0,0,0,,Оны тұрмыстық техникаға қолданып көруім керек пе?
Dialogue: 0,0:06:18.74,0:06:21.08,Default,,0,0,0,,☎(Сайто) Иә, Моши Моши
Dialogue: 0,0:06:21.08,0:06:23.08,Default,,0,0,0,,Қосылған
Dialogue: 0,0:06:23.08,0:06:25.41,Default,,0,0,0,,Сіз Цумугидің әкесісіз бе?
Dialogue: 0,0:06:25.41,0:06:28.75,Default,,0,0,0,,☎Жоқ, мен Котобуки отбасының қамқоршысымын.
Dialogue: 0,0:06:28.75,0:06:30.75,Default,,0,0,0,,〈(Ритсу/Азуса) Расында да қонағы болды〉
Dialogue: 0,0:06:30.75,0:06:34.42,Default,,0,0,0,,Ум, Цумуги-сан келе ме?
Dialogue: 0,0:06:34.42,0:06:36.42,Default,,0,0,0,,Сенпай, сабыр ет.
Dialogue: 0,0:06:36.42,0:06:38.43,Default,,0,0,0,,☎Миссис. Цумуги қазір үйде.
Dialogue: 0,0:06:38.43,0:06:41.10,Default,,0,0,0,,☎Мен Финляндияда демалып жатырмын.
Dialogue: 0,0:06:41.10,0:06:43.77,Default,,0,0,0,,Мен көремін. Рақмет сізге.
Dialogue: 0,0:06:43.77,0:06:45.77,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:06:46.77,0:06:49.44,Default,,0,0,0,,Қараңызшы, мен айтқандай.
Dialogue: 0,0:06:49.44,0:06:51.44,Default,,0,0,0,,Ал оны өзгерте алмасам…
Dialogue: 0,0:06:51.44,0:06:54.44,Default,,0,0,0,,Ах~ Мен біраз шаршадым.
Dialogue: 0,0:06:54.44,0:06:57.45,Default,,0,0,0,,Келейін бе? Қарбыз бар
Dialogue: 0,0:06:57.45,0:06:59.45,Default,,0,0,0,,Бар!
Dialogue: 0,0:06:59.45,0:07:02.45,Default,,0,0,0,,Мен үйдемін~ Әпке
Dialogue: 0,0:07:02.45,0:07:06.45,Default,,0,0,0,,Қарбыз... Рицу-сан мен Азуса-чан келді.
Dialogue: 0,0:07:06.45,0:07:09.46,Default,,0,0,0,,～～～～
Dialogue: 0,0:07:12.73,0:07:14.73,Default,,0,0,0,,〈Жеңілденбеу〉
Dialogue: 0,0:07:14.73,0:07:17.03,Default,,0,0,0,,〈Мен естігенімдей〉
Dialogue: 0,0:07:18.73,0:07:22.74,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:23.74,0:07:27.08,Default,,0,0,0,,Жазғы демалыс болса да қиын.
Dialogue: 0,0:07:27.08,0:07:30.08,Default,,0,0,0,,Тренинг немесе ондай ештеңе жоқ➡
Dialogue: 0,0:07:30.08,0:07:32.08,Default,,0,0,0,,Балалар сендер де жаттығасыңдар ма?
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,Иә Сізге бірдеңе керек пе?
Dialogue: 0,0:07:34.08,0:07:36.42,Default,,0,0,0,,Мен жеңіл музыка үйірмесімен оқу-жаттығу жиынын өткізіп жатырмын.
Dialogue: 0,0:07:36.42,0:07:39.09,Default,,0,0,0,,«Мұғалім де келер ме екен» деп ойладым.
Dialogue: 0,0:07:39.09,0:07:41.09,Default,,0,0,0,,Оқу-жаттығу лагері
Dialogue: 0,0:07:41.09,0:07:43.43,Default,,0,0,0,,…мазасыз бет
Dialogue: 0,0:07:43.43,0:07:46.76,Default,,0,0,0,,Жарайды, жалғыз барамыз.
Dialogue: 0,0:07:46.76,0:07:50.10,Default,,0,0,0,,Егер мен сенімен сөйлеспесем, мен ашуланатын едім, ал егер сөйлессең, бұл ~
Dialogue: 0,0:07:50.10,0:07:53.10,Default,,0,0,0,,Біз суға түсіп, барбекю жасай аламыз.
Dialogue: 0,0:07:53.10,0:07:55.80,Default,,0,0,0,,Уау~ Мен оқу-жаттығу жиынын асыға күтемін.
Dialogue: 0,0:07:58.77,0:08:00.78,Default,,0,0,0,,Оши
Dialogue: 0,0:08:00.78,0:08:03.45,Default,,0,0,0,,Барлығымыздың жиналып қалғанымызға біраз уақыт болды.
Dialogue: 0,0:08:03.45,0:08:05.75,Default,,0,0,0,,Оқу-жаттығу жиынына дүкен аралауға барамыз ба?
Dialogue: 0,0:08:07.45,0:08:10.45,Default,,0,0,0,,Айтпақшы, сіз не сатып алмақсыз?
Dialogue: 0,0:08:10.45,0:08:12.39,Default,,0,0,0,,Жаңа жабдық?
Dialogue: 0,0:08:12.39,0:08:14.39,Default,,0,0,0,,Ал, бұл купальник.
Dialogue: 0,0:08:14.39,0:08:16.39,Default,,0,0,0,,Манманды ойнауға дайын болу
Dialogue: 0,0:08:16.39,0:08:19.06,Default,,0,0,0,,Мен бәрібір осылай болады деп ойладым.
Dialogue: 0,0:08:19.06,0:08:21.06,Default,,0,0,0,,Мен үнемі ойнайтын сияқты емеспін.
Dialogue: 0,0:08:21.06,0:08:23.40,Default,,0,0,0,,Мен оған сене алмаймын! Неге! ?
Dialogue: 0,0:08:23.40,0:08:25.73,Default,,0,0,0,,Маған да үзіліс керек.
Dialogue: 0,0:08:25.73,0:08:27.74,Default,,0,0,0,,Не?
Dialogue: 0,0:08:27.74,0:08:31.44,Default,,0,0,0,,Түсіндім... бұл дұрыс.
Dialogue: 0,0:08:36.41,0:08:38.41,Default,,0,0,0,,Ооо
Dialogue: 0,0:08:38.41,0:08:40.75,Default,,0,0,0,,Бұл одан да керемет~
Dialogue: 0,0:08:40.75,0:08:44.42,Default,,0,0,0,,Бұл сіз былтыр айтқан вилла, сіз жалға ала алмайсыз, солай ма?
Dialogue: 0,0:08:44.42,0:08:46.76,Default,,0,0,0,,Кешіріңіз, бұл вилла
Dialogue: 0,0:08:46.76,0:08:48.76,Default,,0,0,0,,Биыл да жаман болды.
Dialogue: 0,0:08:48.76,0:08:51.43,Default,,0,0,0,,Менің ойымша, бұл сәл тар, бірақ шыдамды болыңыз.
Dialogue: 0,0:08:51.43,0:08:53.93,Default,,0,0,0,,(Юи, Мио, Рицу) Алда әлі бар ма! ? 〉
Dialogue: 0,0:08:54.93,0:08:58.10,Default,,0,0,0,,Жарайды, кеттік! О!
Dialogue: 0,0:08:58.10,0:09:00.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:00.10,0:09:02.44,Default,,0,0,0,,Ойын алдында жаттығу жасаңыз!
Dialogue: 0,0:09:02.44,0:09:05.11,Default,,0,0,0,,Мен ойнағым келді.
Dialogue: 0,0:09:05.11,0:09:07.11,Default,,0,0,0,,Олай болса оны көпшілік дауысқа айналдырайық.
Dialogue: 0,0:09:07.11,0:09:09.78,Default,,0,0,0,,Мен алдымен жаттығу жасаймын (Ритсу/Юи) және ойнаймын!
Dialogue: 0,0:09:09.78,0:09:11.78,Default,,0,0,0,,Жаттығу жақсы.
Dialogue: 0,0:09:12.71,0:09:14.72,Default,,0,0,0,,Мен ойнағым келеді
Dialogue: 0,0:09:16.72,0:09:19.42,Default,,0,0,0,,Асығыңыз~ Күтіңіз~
Dialogue: 0,0:09:26.39,0:09:30.00,Default,,0,0,0,,《Мен ұшамын》 《Иә иә…》
Dialogue: 0,0:09:31.40,0:09:33.40,Default,,0,0,0,,〈Мүмкін емес〉
Dialogue: 0,0:09:37.74,0:09:40.41,Default,,0,0,0,,Мен саған оның қажеті жоқ дедім!
Dialogue: 0,0:09:40.41,0:09:44.41,Default,,0,0,0,,Жағажайдағы барлығын дереу тазалаңыз, қайықтың қажеті жоқ!
Dialogue: 0,0:09:44.41,0:09:46.41,Default,,0,0,0,,Муги Сенпай
Dialogue: 0,0:09:47.42,0:09:50.02,Default,,0,0,0,,Болды... Ахаха...
Dialogue: 0,0:09:51.42,0:09:55.42,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:09:55.42,0:09:57.76,Default,,0,0,0,,Йойшо Йойшо
Dialogue: 0,0:10:00.76,0:10:02.76,Default,,0,0,0,,Азунян
Dialogue: 0,0:10:03.77,0:10:05.77,Default,,0,0,0,,Азунян да бірге ойнайық.
Dialogue: 0,0:10:05.77,0:10:07.77,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:10:07.77,0:10:10.77,Default,,0,0,0,,Сонымен, сіз спортқа жақсы емессіз бе?
Dialogue: 0,0:10:10.77,0:10:13.78,Default,,0,0,0,,Бұл дұрыс емес! Мен жасаймын
Dialogue: 0,0:10:20.78,0:10:24.45,Default,,0,0,0,,Азуса-чан да барлығымен жақсы дос болып кетті.
Dialogue: 0,0:10:24.45,0:10:26.45,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:10:28.12,0:10:30.79,Default,,0,0,0,,Доктор Рикчан, мынаны қараңызшы.
Dialogue: 0,0:10:30.79,0:10:32.79,Default,,0,0,0,,⚟(Азуса) Мио-сенпай Иә?
Dialogue: 0,0:10:32.79,0:10:37.13,Default,,0,0,0,,Қожалар туралы ертегіні білесіңдер ме?
Dialogue: 0,0:10:37.13,0:10:40.80,Default,,0,0,0,,Ерте, ертеде бір бала бар екен, қораға аяғын кесіп алған...
Dialogue: 0,0:10:40.80,0:10:43.81,Default,,0,0,0,,Әй, бұл Мио...
Dialogue: 0,0:10:43.81,0:10:45.81,Default,,0,0,0,,Пирог?
Dialogue: 0,0:10:48.48,0:10:50.48,Default,,0,0,0,,Әлі көп жол бар
Dialogue: 0,0:10:50.48,0:10:52.48,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:53.48,0:10:55.48,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:10:55.48,0:10:57.49,Default,,0,0,0,,Ооо!
Dialogue: 0,0:10:57.49,0:10:59.49,Default,,0,0,0,,Оны маған беріңіз, жоқ.
Dialogue: 0,0:11:00.49,0:11:02.49,Default,,0,0,0,,Мио…
Dialogue: 0,0:11:03.49,0:11:05.49,Default,,0,0,0,,Маған не болды...
Dialogue: 0,0:11:18.77,0:11:20.78,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:11:21.78,0:11:23.78,Default,,0,0,0,,Елсіз арал…
Dialogue: 0,0:11:28.12,0:11:30.12,Default,,0,0,0,,Риччан
Dialogue: 0,0:11:31.79,0:11:33.79,Default,,0,0,0,,Ю…?
Dialogue: 0,0:11:38.46,0:11:40.80,Default,,0,0,0,,Ю Юй!
Dialogue: 0,0:11:40.80,0:11:43.13,Default,,0,0,0,,Риччан
Dialogue: 0,0:11:43.13,0:11:45.80,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:11:45.80,0:11:48.14,Default,,0,0,0,,Жаңа континент!
Dialogue: 0,0:11:48.14,0:11:50.14,Default,,0,0,0,,Зипангу! алтын арал
Dialogue: 0,0:11:50.14,0:11:52.14,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:52.14,0:11:55.48,Default,,0,0,0,,Хаха~ Мен ойнадым мен ойнадым
Dialogue: 0,0:11:55.48,0:11:59.15,Default,,0,0,0,,Қазір тамақтанып, ұйықтайық. Жаттығу қалай өтті?
Dialogue: 0,0:11:59.15,0:12:02.15,Default,,0,0,0,,Өйткені, ➡ ойнаудан гөрі алдымен жаттығу жасаған дұрыс
Dialogue: 0,0:12:02.15,0:12:04.15,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:12:04.15,0:12:06.49,Default,,0,0,0,,Ең көп ойнаған Азуса болды.
Dialogue: 0,0:12:06.49,0:12:08.49,Default,,0,0,0,,Бұл тас қараңғы
Dialogue: 0,0:12:08.49,0:12:11.79,Default,,0,0,0,,Мен де тұрақты түрде жаттығу жасаймын, түні бойы ше?
Dialogue: 0,0:12:12.76,0:12:14.76,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:12:23.14,0:12:26.14,Default,,0,0,0,,Шаршадым ~ Қарным ашты
Dialogue: 0,0:12:26.14,0:12:28.14,Default,,0,0,0,,⚟(Мио) Сабырлы болыңыз.
Dialogue: 0,0:12:28.14,0:12:30.14,Default,,0,0,0,,Уау~➡
Dialogue: 0,0:12:30.14,0:12:32.15,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:12:34.82,0:12:38.82,Default,,0,0,0,,Бұл таңқаларлық. Мен мұндай күшейткішті ешқашан пайдаланған емеспін.
Dialogue: 0,0:12:38.82,0:12:42.49,Default,,0,0,0,,Мио Тез жаттығу жасайық. Тұзақ жаңа.
Dialogue: 0,0:12:46.83,0:12:49.16,Default,,0,0,0,,Азунян, бұл не?
Dialogue: 0,0:12:49.16,0:12:51.50,Default,,0,0,0,,Иә, бұл солай ма? ➡
Dialogue: 0,0:12:51.50,0:12:53.50,Default,,0,0,0,,Бұл жай ғана тюнер
Dialogue: 0,0:12:53.50,0:12:55.84,Default,,0,0,0,,Әй, бұл тюнер деп аталады.
Dialogue: 0,0:12:55.84,0:12:58.84,Default,,0,0,0,,⚟(Азуса) Енді мен оны баптаймын➡
Dialogue: 0,0:12:58.84,0:13:01.84,Default,,0,0,0,,Юй-сенпай тюнер Білмейсің бе?
Dialogue: 0,0:13:01.84,0:13:03.85,Default,,0,0,0,,Иә, мен оны бірінші рет көрдім.
Dialogue: 0,0:13:03.85,0:13:06.51,Default,,0,0,0,,Сонымен, оны қалай баптайсыз?
Dialogue: 0,0:13:06.51,0:13:10.12,Default,,0,0,0,,Е, жай... Қараңызшы.
Dialogue: 0,0:13:11.19,0:13:13.12,Default,,0,0,0,,Абсолютті қадам!
Dialogue: 0,0:13:13.12,0:13:16.12,Default,,0,0,0,,〈Өзінің керемет немесе жоқ екенін білмейді.''
Dialogue: 0,0:13:17.13,0:13:19.13,Default,,0,0,0,,Олай болса, кеттік~
Dialogue: 0,0:13:19.13,0:13:21.13,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,0:13:24.47,0:13:26.47,Default,,0,0,0,,(Орындау аяқталады)
Dialogue: 0,0:13:27.80,0:13:30.47,Default,,0,0,0,,Дәл қазір өзіңізді жақсы сезіндіңіз, солай емес пе?
Dialogue: 0,0:13:30.47,0:13:32.47,Default,,0,0,0,,Ол өте жақсы сәйкес келеді.
Dialogue: 0,0:13:32.47,0:13:35.81,Default,,0,0,0,,〈Бәрі қашан жаттығуды бастады деп ойлаймын〉
Dialogue: 0,0:13:35.81,0:13:38.81,Default,,0,0,0,,Рицу да ырғақты дұрыс сақтай білді.
Dialogue: 0,0:13:38.81,0:13:40.82,Default,,0,0,0,,Арнайы дайындықтан өттіңіз бе?
Dialogue: 0,0:13:42.48,0:13:46.49,Default,,0,0,0,,Менің қарным ашты, күш-қуатым жоқ.
Dialogue: 0,0:13:46.49,0:13:50.49,Default,,0,0,0,,Қарның аш болғандықтан, қажет емес энергияны тастадың.
Dialogue: 0,0:13:50.49,0:13:53.16,Default,,0,0,0,,Уф, қазір тамақтанып алайық.
Dialogue: 0,0:13:53.16,0:13:55.50,Default,,0,0,0,,Маған тамақ ішуге рұқсат етіңіз!
Dialogue: 0,0:13:55.50,0:13:57.50,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:58.50,0:14:01.50,Default,,0,0,0,,Мен қайтып келдім~ Қош келдіңіз~
Dialogue: 0,0:14:01.50,0:14:03.50,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:03.50,0:14:06.17,Default,,0,0,0,,Риччан, бұл ет, бұл көкөніс.
Dialogue: 0,0:14:06.17,0:14:08.18,Default,,0,0,0,,Мен көптен күттім~
Dialogue: 0,0:14:09.18,0:14:12.18,Default,,0,0,0,,Мен қырыққабатты шикі етіп жеймін~
Dialogue: 0,0:14:12.18,0:14:14.78,Default,,0,0,0,,Біраз уақыт ұстаңыз
Dialogue: 0,0:14:16.78,0:14:19.79,Default,,0,0,0,,〈Сіз ойнаған кезде жақсы нәрсе болады〉
Dialogue: 0,0:14:19.79,0:14:21.79,Default,,0,0,0,,Қырыққабатты жібер...
Dialogue: 0,0:14:21.79,0:14:25.46,Default,,0,0,0,,Барлығымыз бөлініп, орындасақ, бірден жасай аламыз.
Dialogue: 0,0:14:25.46,0:14:28.46,Default,,0,0,0,,Онда мен пештегі отқа қараймын.
Dialogue: 0,0:14:28.46,0:14:32.13,Default,,0,0,0,,Қараңдаршы, юниорлар бастама көтеріп, тынбай еңбек етуде.
Dialogue: 0,0:14:32.13,0:14:34.14,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:14:37.81,0:14:41.14,Default,,0,0,0,,Менің көзім ауырып кетті~ Юи жақсысың ба?
Dialogue: 0,0:14:41.14,0:14:43.14,Default,,0,0,0,,Риччан
Dialogue: 0,0:14:43.14,0:14:45.15,Default,,0,0,0,,Тек...
Dialogue: 0,0:14:45.15,0:14:47.55,Default,,0,0,0,,Өлсек бірге боламыз, а
Dialogue: 0,0:14:50.49,0:14:52.49,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:52.49,0:14:54.79,Default,,0,0,0,,Сіз күріш шарларын жасағыңыз келе ме? Иә.
Dialogue: 0,0:15:03.16,0:15:05.87,Default,,0,0,0,,〈Айырмашылық көп...〉
Dialogue: 0,0:15:07.17,0:15:10.87,Default,,0,0,0,,Мио-чанның қолдары үлкен бе деп ойлаймын. Бұл өте шулы!
Dialogue: 0,0:15:28.46,0:15:31.13,Default,,0,0,0,,Ах~ Бұл дәмді болды.
Dialogue: 0,0:15:31.13,0:15:34.46,Default,,0,0,0,,Бұл дәмді болды. Бұл таңқаларлық болды.
Dialogue: 0,0:15:34.46,0:15:37.06,Default,,0,0,0,,Олай болса отшашу атайық.
Dialogue: 0,0:15:43.47,0:15:45.47,Default,,0,0,0,,Ах... Ах.
Dialogue: 0,0:15:50.48,0:15:53.48,Default,,0,0,0,,А, бітті.
Dialogue: 0,0:15:53.48,0:15:55.48,Default,,0,0,0,,Ол ақырында жоғалып кеткенде
Dialogue: 0,0:15:55.48,0:15:58.49,Default,,0,0,0,,Кішкене сынап көріңіз, көп көріңіз, көресіз
Dialogue: 0,0:15:58.49,0:16:00.49,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе...
Dialogue: 0,0:16:00.49,0:16:02.49,Default,,0,0,0,,Иә
Dialogue: 0,0:16:03.49,0:16:05.49,Default,,0,0,0,,Жарайды, тағы бір бөтелке.
Dialogue: 0,0:16:05.49,0:16:08.50,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барын істе
Dialogue: 0,0:16:10.83,0:16:14.54,Default,,0,0,0,,А, мен тағы құладым.
Dialogue: 0,0:16:15.44,0:16:17.77,Default,,0,0,0,,Ах, Рикчан, ол жоғалады.
Dialogue: 0,0:16:17.77,0:16:21.44,Default,,0,0,0,,Жарайды, бұл жағдайда біріктіру арқылы оны үлкейтіңіз.
Dialogue: 0,0:16:21.44,0:16:24.45,Default,,0,0,0,,Біріктіріңіз! ұшқын адам
Dialogue: 0,0:16:24.45,0:16:27.05,Default,,0,0,0,,Ах Зуруи (Мио) Идиот...
Dialogue: 0,0:16:28.12,0:16:30.45,Default,,0,0,0,,Ауыр емес пе? Жарайды
Dialogue: 0,0:16:30.45,0:16:33.12,Default,,0,0,0,,Ерлігімізді сынап көрейік О!
Dialogue: 0,0:16:33.12,0:16:35.79,Default,,0,0,0,,Бірінен соң бірі жақсы
Dialogue: 0,0:16:35.79,0:16:39.13,Default,,0,0,0,,Өйткені, жазғы оқу-жаттығу жиындарына келгенде, бұл ерлік сынағы!
Dialogue: 0,0:16:39.13,0:16:41.13,Default,,0,0,0,,Мен мұны істемеймін
Dialogue: 0,0:16:41.13,0:16:44.53,Default,,0,0,0,,Мен түсінемін~ Мио қорқады.
Dialogue: 0,0:16:45.47,0:16:48.77,Default,,0,0,0,,Сіздің қолыңыздан келеді, жасайық.
Dialogue: 0,0:16:49.80,0:16:52.81,Default,,0,0,0,,〈Көп тамақ жей алмаған реніш〉
Dialogue: 0,0:17:03.15,0:17:05.49,Default,,0,0,0,,Әй, мен де мектеп оқушысы болдым.
Dialogue: 0,0:17:05.49,0:17:07.82,Default,,0,0,0,,Ерлікті сынау жоқ.
Dialogue: 0,0:17:07.82,0:17:11.13,Default,,0,0,0,,Бұл қол ауырады.
Dialogue: 0,0:17:13.76,0:17:15.76,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:17:15.76,0:17:17.77,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:17:17.77,0:17:20.47,Default,,0,0,0,,Бұл Рири Рицудың жұмысы.
Dialogue: 0,0:17:21.44,0:17:24.44,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:17:26.44,0:17:29.74,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:17:30.78,0:17:32.78,Default,,0,0,0,,Мио-чан
Dialogue: 0,0:17:32.78,0:17:34.78,Default,,0,0,0,,Кяа!
Dialogue: 0,0:17:34.78,0:17:38.49,Default,,0,0,0,,Сенпай Сенпай Сақ болғаныңызға көз жеткізіңіз
Dialogue: 0,0:17:40.45,0:17:42.46,Default,,0,0,0,,⚟ (Азуса) Ұстаз! ?
Dialogue: 0,0:17:42.46,0:17:44.46,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:17:44.46,0:17:46.46,Default,,0,0,0,,Я... Ақыры сені кездестірдім.
Dialogue: 0,0:17:46.46,0:17:48.46,Default,,0,0,0,,Не, Сава-чан-сенсэй?
Dialogue: 0,0:17:48.46,0:17:50.46,Default,,0,0,0,,Не болды? Немесе дұрысырақ
Dialogue: 0,0:17:50.46,0:17:52.47,Default,,0,0,0,,Сен неге сондасың?
Dialogue: 0,0:17:52.47,0:17:54.80,Default,,0,0,0,,Бізге кейінірек қосылыңыз
Dialogue: 0,0:17:54.80,0:17:57.81,Default,,0,0,0,,Мен барлығын таң қалдырғым келді.
Dialogue: 0,0:17:57.81,0:17:59.81,Default,,0,0,0,,Жолдан адасып қалды
Dialogue: 0,0:17:59.81,0:18:02.14,Default,,0,0,0,,Мақсат – таң қалдыру
Dialogue: 0,0:18:02.14,0:18:04.48,Default,,0,0,0,,Мен оған қол жеткізе алған сияқтымын.
Dialogue: 0,0:18:04.48,0:18:07.82,Default,,0,0,0,,Мио-чан Жарайды, Мио-чан!
Dialogue: 0,0:18:07.82,0:18:11.52,Default,,0,0,0,,〈Мио-сенпай қатты қорықты〉
Dialogue: 0,0:18:17.76,0:18:19.76,Default,,0,0,0,,Ешкім келмейді
Dialogue: 0,0:18:24.10,0:18:26.77,Default,,0,0,0,,Менде жағымсыз оқиға болды. Солай.
Dialogue: 0,0:18:26.77,0:18:28.77,Default,,0,0,0,,Мио Мио
Dialogue: 0,0:18:34.11,0:18:36.44,Default,,0,0,0,,Азуса Ыстық болу жаман ба?
Dialogue: 0,0:18:36.44,0:18:38.78,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:38.78,0:18:43.45,Default,,0,0,0,,Азунян, мұндай нәрселерге жігерлі түрде кірген дұрыс.
Dialogue: 0,0:18:43.45,0:18:45.79,Default,,0,0,0,,Әй, ауырып тұр!
Dialogue: 0,0:18:45.79,0:18:48.46,Default,,0,0,0,,А, күннің күйген жері ауырды ма?
Dialogue: 0,0:18:48.46,0:18:51.13,Default,,0,0,0,,⚟(Цумуги) Юй-чан, аздап арықтап қалдың ба?
Dialogue: 0,0:18:51.13,0:18:53.79,Default,,0,0,0,,Жоқ, мен мұны бұрын айтқан сияқтымын.
Dialogue: 0,0:18:53.79,0:18:56.46,Default,,0,0,0,,Қанша жесем де, семіре алмаймын.
Dialogue: 0,0:18:56.46,0:18:58.80,Default,,0,0,0,,⚟ (Цумуги, Мио, Савако) Мен қызғаншақпын!
Dialogue: 0,0:18:58.80,0:19:01.47,Default,,0,0,0,,Е, тіпті Сава-чан мырза! ?
Dialogue: 0,0:19:01.47,0:19:03.47,Default,,0,0,0,,Шикаши➡
Dialogue: 0,0:19:03.47,0:19:08.14,Default,,0,0,0,,Көзілдірікті шешсең, екеуіңді ажырата алмаймын.
Dialogue: 0,0:19:08.14,0:19:10.14,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:19:11.15,0:19:15.15,Default,,0,0,0,,Кеуделеріңіздің көлеміне қарап баға бергеніңіз дұрыс!
Dialogue: 0,0:19:30.50,0:19:32.50,Default,,0,0,0,,Қырыққабат дәмді
Dialogue: 0,0:19:34.84,0:19:37.14,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:19:42.51,0:19:44.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:46.18,0:19:48.18,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:19:52.52,0:19:55.86,Default,,0,0,0,,Менің тәжірибеме қосылғаныңыз үшін кешіріңіз.
Dialogue: 0,0:19:55.86,0:19:57.86,Default,,0,0,0,,Бұл туралы мүлдем алаңдамаңыз
Dialogue: 0,0:19:57.86,0:19:59.86,Default,,0,0,0,,Мен де, Юй-сенпай
Dialogue: 0,0:19:59.86,0:20:02.86,Default,,0,0,0,,Мен сендермен көбірек жаттығу жасағым келді.
Dialogue: 0,0:20:02.86,0:20:04.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:04.87,0:20:06.87,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:07.87,0:20:10.57,Default,,0,0,0,,(Азуза гитарада ойнай бастайды)
Dialogue: 0,0:20:19.48,0:20:21.48,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:20:21.48,0:20:23.48,Default,,0,0,0,,Азунян дәмді
Dialogue: 0,0:20:23.48,0:20:26.09,Default,,0,0,0,,Е, бұл дұрыс емес.
Dialogue: 0,0:20:27.15,0:20:29.56,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:20:30.49,0:20:32.49,Default,,0,0,0,,(Юи гитарада ойнайды)
Dialogue: 0,0:20:33.49,0:20:35.50,Default,,0,0,0,,Ооооооооооооооо
Dialogue: 0,0:20:36.50,0:20:38.83,Default,,0,0,0,,Бұл қиын бөлігі, солай емес пе?
Dialogue: 0,0:20:38.83,0:20:42.17,Default,,0,0,0,,Алдымен баяу қарқынмен ойнап көріңіз.
Dialogue: 0,0:20:42.17,0:20:44.17,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:20:44.17,0:20:46.17,Default,,0,0,0,,(Юй баяу ойнайды)
Dialogue: 0,0:20:59.52,0:21:01.52,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:21:01.52,0:21:04.19,Default,,0,0,0,,Азунянмен танысқаныма қуаныштымын!
Dialogue: 0,0:21:04.19,0:21:07.90,Default,,0,0,0,,Не? Азунян
Dialogue: 0,0:21:09.86,0:21:12.57,Default,,0,0,0,,Рахмет сізге Азунян
Dialogue: 0,0:21:29.15,0:21:31.82,Default,,0,0,0,,〈Бүгін мен Азуса-чанмен қыдырамын〉
Dialogue: 0,0:21:31.82,0:21:34.12,Default,,0,0,0,,⚟(Азуса) Сәлем!
Dialogue: 0,0:21:36.49,0:21:38.83,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:21:38.83,0:21:40.83,Default,,0,0,0,,Қазірдің өзінде кеш~
Dialogue: 0,0:21:40.83,0:21:42.83,Default,,0,0,0,,...Кім?
Dialogue: 0,0:21:43.83,0:21:48.17,Default,,0,0,0,,Хмм, мен көп жаттыға алмадым. Тіпті
Dialogue: 0,0:21:48.17,0:21:50.17,Default,,0,0,0,,емес
Dialogue: 0,0:21:50.17,0:21:53.17,Default,,0,0,0,,Менің ойымша, бұл арнайы жаттығу сабағы болады деп ойладым.
Dialogue: 0,0:21:53.17,0:21:56.84,Default,,0,0,0,,Мен көбінесе теңізде жүзу және өзімді сынау сияқты нәрселермен айналысатынмын.
Dialogue: 0,0:21:56.84,0:22:00.51,Default,,0,0,0,,Хмм, мен көбірек жаттығым келді.
Dialogue: 0,0:22:00.51,0:22:05.19,Default,,0,0,0,,Көріп тұрмын, бірақ апам мүлде күйген жоқ.
Dialogue: 0,0:22:05.19,0:22:07.86,Default,,0,0,0,,Неге сонша күйіп кеттің?
Dialogue: 0,0:22:07.86,0:22:09.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:09.86,0:22:13.16,Default,,0,0,0,,Себебі мен ең қатты толқыдым
Dialogue: 0,0:22:16.46,0:22:18.47,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:22:20.80,0:22:23.50,Default,,0,0,0,,Барғаныма қуаныштымын.
Dialogue: 0,0:22:25.14,0:22:28.14,Default,,0,0,0,,Мен ағаларым туралы көп нәрсені білдім.
Dialogue: 0,0:22:28.14,0:22:30.81,Default,,0,0,0,,Иә, қалай?
Dialogue: 0,0:22:30.81,0:22:35.15,Default,,0,0,0,,⚟(Азуса) Хмм, Мио-сенпай таң қалдырды.
Dialogue: 0,0:22:35.15,0:22:38.15,Default,,0,0,0,,⚟(Қайғы) Дұрыс~ Рицу-сан ше?
Dialogue: 0,0:22:38.15,0:22:40.82,Default,,0,0,0,,⚟(Азуса) Дөрекі болды➡
Dialogue: 0,0:22:40.82,0:22:43.49,Default,,0,0,0,,Мен Мио-сенпаймен жақсы уақыт өткіздім.
Dialogue: 0,0:22:43.49,0:22:46.83,Default,,0,0,0,,⚟(U) Цумуги ше? ⚟(Азуса) Муги-сенпай➡
Dialogue: 0,0:22:46.83,0:22:49.83,Default,,0,0,0,,Барлығына қамқор, мейірімді, бірақ➡
Dialogue: 0,0:22:49.83,0:22:53.50,Default,,0,0,0,,Ол таңқаларлық балаша және сүйкімді адам еді.
Dialogue: 0,0:22:53.50,0:22:57.10,Default,,0,0,0,,⚟(Қайғы) Хмм, апаң ше?
Dialogue: 0,0:22:58.17,0:23:00.57,Default,,0,0,0,,Юи Сенпай...
Dialogue: 0,0:23:01.84,0:23:03.84,Default,,0,0,0,,Мен дұрыс жаттығатынмын.
Dialogue: 0,0:23:15.12,0:23:17.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:23:19.46,0:23:21.46,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:23:21.46,0:23:24.80,Default,,0,0,0,,⚟(Азуса) Сіз мені бұрынғыдай құшақтай аласыз.
Dialogue: 0,0:23:24.80,0:23:27.47,Default,,0,0,0,,⚟(Қайғы) Жылы екен, әпке.
Dialogue: 0,0:23:27.47,0:23:31.07,Default,,0,0,0,,⚟(Азуса)-ға... Дұрыс.
Dialogue: 0,0:23:32.47,0:24:02.50,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:04.00,0:24:09.00,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
