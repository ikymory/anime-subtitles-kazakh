Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.37,0:00:05.04,Default,,0,0,0,,Сіз оны маған әлі берген жоқсыз ба?
Dialogue: 0,0:00:05.13,0:00:08.38,Default,,0,0,0,,Өйткені 14-і жексенбі болатын.
Dialogue: 0,0:00:08.46,0:00:10.63,Default,,0,0,0,,Бол... бұл үлкен мәселе емес.
Dialogue: 0,0:00:10.71,0:00:13.09,Default,,0,0,0,,Секинеден шоколад алғаным үшін.
Dialogue: 0,0:00:13.17,0:00:16.47,Default,,0,0,0,,Мүмкін жақын жердегі дүкеннен сатып алған печенье...
Dialogue: 0,0:00:16.55,0:00:19.72,Default,,0,0,0,,Мүмкін? Ақсақ профилактикалық желіні қоймаңыз
Dialogue: 0,0:00:19.81,0:00:21.81,Default,,0,0,0,,Ол өте мұқият оралған.
Dialogue: 0,0:00:21.89,0:00:23.14,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:23.23,0:00:27.44,Default,,0,0,0,,Менің жүрегімде Ямада есімді сүйікті адамым бар.
Dialogue: 0,0:00:27.52,0:00:30.53,Default,,0,0,0,,Бұл жай ғана Секине оралу.
Dialogue: 0,0:00:30.61,0:00:33.78,Default,,0,0,0,,Сізге қайтаратын нәрсе шоколад шоколады болды.
Dialogue: 0,0:00:33.86,0:00:37.57,Default,,0,0,0,,Жоқ, менің жүрегімнің таңбасы бар еді.
Dialogue: 0,0:00:37.66,0:00:40.66,Default,,0,0,0,,Бұл сөзсіз ерекше дегенді білдіреді.
Dialogue: 0,0:00:41.58,0:00:43.08,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:00:43.16,0:00:44.37,Default,,0,0,0,,Бұдан былай, И
Dialogue: 0,0:00:44.46,0:00:47.96,Default,,0,0,0,,Печеньені Секиненің аяқ киім сөресіне абайсызда лақтырыңыз.
Dialogue: 0,0:00:48.04,0:00:51.17,Default,,0,0,0,,Ичикава кездейсоқ өтіп бара жатып, Секинге айтты.
Dialogue: 0,0:00:51.76,0:00:53.97,Default,,0,0,0,,Оны сол жерге салған Адачи.
Dialogue: 0,0:00:54.63,0:00:56.13,Default,,0,0,0,,Адачи…
Dialogue: 0,0:00:57.18,0:00:58.85,Default,,0,0,0,,- (Адачи)! -(Ичикава) олай емес
Dialogue: 0,0:00:58.93,0:01:00.68,Default,,0,0,0,,Бәрібір солай
Dialogue: 0,0:01:00.76,0:01:01.35,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:05.19,0:01:06.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:06.23,0:01:08.65,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:01:08.73,0:01:10.27,Default,,0,0,0,,Ал, Секине...
Dialogue: 0,0:01:10.36,0:01:12.19,Default,,0,0,0,,...Сен ештеңе білмейсің, Анна.
Dialogue: 0,0:01:12.28,0:01:13.94,Default,,0,0,0,,- (Ичикава) О, жоқ! -(Ямада) А? Солай ма?
Dialogue: 0,0:01:14.03,0:01:14.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:15.53,0:01:16.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:17.32,0:01:19.66,Default,,0,0,0,,- (Ямада) Иә? Бұл... - (Ичикава) Жақсы!
Dialogue: 0,0:01:19.74,0:01:23.04,Default,,0,0,0,,Жоқ! Секиненің емес, Ямаданың аяқ киім сөресі...
Dialogue: 0,0:01:23.12,0:01:25.87,Default,,0,0,0,,Әй, хат та бар.
Dialogue: 0,0:01:26.37,0:01:28.67,Default,,0,0,0,,А, жоқ, бұл...
Dialogue: 0,0:01:28.75,0:01:31.04,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:01:31.13,0:01:34.05,Default,,0,0,0,,Олай болса, Мо, мен бірінші үйге барайын.
Dialogue: 0,0:01:34.13,0:01:34.80,Default,,0,0,0,,Қарсы неге? Бүгін таңертең сен жақсылап көмектесіп жүрдің ғой, иә?
Dialogue: 0,0:01:36.84,0:01:38.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:39.64,0:01:42.51,Default,,0,0,0,,Жоқ, менің айтайын дегенім...
Dialogue: 0,0:01:42.60,0:01:45.89,Default,,0,0,0,,- (Адачи) Жібер, жібер! - (Адачидің анасы) Иә, иә, түсіндім...
Dialogue: 0,0:01:45.98,0:01:48.48,Default,,0,0,0,,Тек дұрыстап рахмет айтыңыз.
Dialogue: 0,0:01:48.56,0:01:51.19,Default,,0,0,0,,Мен сізге печенье жасау үшін қиналдым.
Dialogue: 0,0:01:51.27,0:01:52.32,Default,,0,0,0,,Адачи Мама
Dialogue: 0,0:01:52.40,0:01:53.53,Default,,0,0,0,,Хола
Dialogue: 0,0:01:55.40,0:01:57.70,Default,,0,0,0,,- (Адачи) Ах! -(Секине) Не?
Dialogue: 0,0:01:57.78,0:02:01.66,Default,,0,0,0,,Бұл шоколад өте жақсы болды.
Dialogue: 0,0:02:01.74,0:02:05.04,Default,,0,0,0,,Қолдан жасалған... Қуанып қалдым.
Dialogue: 0,0:02:05.12,0:02:07.21,Default,,0,0,0,,Сонымен... ғажап, ол сондай жақсы жігіт.
Dialogue: 0,0:02:07.29,0:02:10.71,Default,,0,0,0,,Жоқ, сондықтан бәріне бердім.
Dialogue: 0,0:02:10.79,0:02:12.17,Default,,0,0,0,,Онда!
Dialogue: 0,0:02:12.25,0:02:13.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:16.09,0:02:16.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:17.55,0:02:19.93,Default,,0,0,0,,-(Адачи) Олай болса -(Секине) Иә...
Dialogue: 0,0:02:20.01,0:02:22.43,Default,,0,0,0,,Жарайды, жарайды, егер сіз тырыссаңыз.
Dialogue: 0,0:02:23.68,0:02:25.68,Default,,0,0,0,,Жақсы иіс шығады, мама.
Dialogue: 0,0:02:25.77,0:02:28.39,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:02:28.89,0:02:29.73,Default,,0,0,0,,Иә
Dialogue: 0,0:02:29.81,0:02:34.11,Default,,0,0,0,,Кешіріңіз, мен бұл cookie файлдары менікі емес деп айтқан жоқпын.
Dialogue: 0,0:02:34.19,0:02:36.78,Default,,0,0,0,,Хехе, оқы!
Dialogue: 0,0:02:36.86,0:02:38.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:41.53,0:02:43.53,Default,,0,0,0,,«ҚҰРМЕТТІ ғашықтар»
Dialogue: 0,0:02:43.62,0:02:45.16,Default,,0,0,0,,«Шоколадты дәмді карта»
Dialogue: 0,0:02:45.24,0:02:46.70,Default,,0,0,0,,«Үлкен рахмет»
Dialogue: 0,0:02:46.79,0:02:48.25,Default,,0,0,0,,«Мен сені одан әрі жақсы көремін»
Dialogue: 0,0:02:48.33,0:02:49.33,Default,,0,0,0,,«Тұт тұт тут тұт»
Dialogue: 0,0:02:49.41,0:02:52.96,Default,,0,0,0,,Иә? Хмм!
Dialogue: 0,0:02:53.04,0:02:55.04,Default,,0,0,0,,♪～
Dialogue: 0,0:04:20.92,0:04:22.92,Default,,0,0,0,,～♪
Dialogue: 0,0:04:25.09,0:04:28.35,Default,,0,0,0,,Бүгін мен осы сыныппен қоштасамын.
Dialogue: 0,0:04:28.43,0:04:30.64,Default,,0,0,0,,Бұл мүшелер ешқашан бірге болмайды.
Dialogue: 0,0:04:30.72,0:04:32.89,Default,,0,0,0,,Әй, сынып өзгерді ме?
Dialogue: 0,0:04:32.98,0:04:35.56,Default,,0,0,0,,Жақын топ бөлінген деп аталады.
Dialogue: 0,0:04:35.65,0:04:36.90,Default,,0,0,0,,Мен мұны көп естимін.
Dialogue: 0,0:04:36.98,0:04:39.65,Default,,0,0,0,,Сонда мен ойладым
Dialogue: 0,0:04:40.57,0:04:41.78,Default,,0,0,0,,Идиот! Боке!
Dialogue: 0,0:04:41.86,0:04:44.78,Default,,0,0,0,,Мен сендерді бастапқыда жек көретінмін!
Dialogue: 0,0:04:44.86,0:04:46.28,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:04:46.36,0:04:47.28,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:04:47.37,0:04:51.29,Default,,0,0,0,,Шындығында, біз тіпті жақын болған жоқпыз.
Dialogue: 0,0:04:51.37,0:04:54.12,Default,,0,0,0,,Сыныбыңыздан бөлінгенім үшін кешіріңіз.
Dialogue: 0,0:04:55.12,0:04:56.42,Default,,0,0,0,,Томоне Ямада
Dialogue: 0,0:04:57.75,0:04:59.46,Default,,0,0,0,,Иә... Ямада?
Dialogue: 0,0:04:59.54,0:05:01.55,Default,,0,0,0,,Тоқта, мен саған бұрын айттым ғой, солай ма?
Dialogue: 0,0:05:01.63,0:05:05.93,Default,,0,0,0,,Қалай болғанда да, бұл балалармен бір сыныпта болма.
Dialogue: 0,0:05:06.01,0:05:08.55,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:05:08.64,0:05:09.68,Default,,0,0,0,,Е...
Dialogue: 0,0:05:09.76,0:05:11.56,Default,,0,0,0,,Ах... өтірік
Dialogue: 0,0:05:11.64,0:05:13.18,Default,,0,0,0,,Баяшико!
Dialogue: 0,0:05:13.27,0:05:16.69,Default,,0,0,0,,Біз кішкентай әлемде өмір сүреміз
Dialogue: 0,0:05:17.27,0:05:20.19,Default,,0,0,0,,Ичикава LINE Сіз маған сабақ бересіз бе?
Dialogue: 0,0:05:20.27,0:05:20.98,Default,,0,0,0,,Жоспар
Dialogue: 0,0:05:21.07,0:05:22.94,Default,,0,0,0,,Маған да айтыңыз.
Dialogue: 0,0:05:26.36,0:05:28.78,Default,,0,0,0,,Сыныптың тар әлемі
Dialogue: 0,0:05:42.92,0:05:44.34,Default,,0,0,0,,О
Dialogue: 0,0:05:48.05,0:05:50.43,Default,,0,0,0,,(доптың секіру дыбысы)
Dialogue: 0,0:05:52.18,0:05:54.77,Default,,0,0,0,,- (Ямада) О - (Ичикава) Баскетболға тыйым салынған, солай ма?
Dialogue: 0,0:05:54.85,0:05:56.98,Default,,0,0,0,,Хехе, бұл құпия.
Dialogue: 0,0:05:57.64,0:05:58.44,Default,,0,0,0,,Уау
Dialogue: 0,0:05:58.52,0:06:00.56,Default,,0,0,0,,Мен қалғым келетін сияқты.
Dialogue: 0,0:06:01.15,0:06:03.27,Default,,0,0,0,,Мүмкін Ичикава да шығар?
Dialogue: 0,0:06:03.36,0:06:05.65,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,0:06:05.74,0:06:08.49,Default,,0,0,0,,Жарайды 1-ге 1 орындайық
Dialogue: 0,0:06:08.57,0:06:09.36,Default,,0,0,0,,Е...
Dialogue: 0,0:06:09.45,0:06:12.03,Default,,0,0,0,,Жеңілген адам жеңгеннің айтқанын орындайды.
Dialogue: 0,0:06:12.12,0:06:13.53,Default,,0,0,0,,Менен кез келген нәрсені сұраңыз!
Dialogue: 0,0:06:13.62,0:06:15.79,Default,,0,0,0,,А... Бұл қулық.
Dialogue: 0,0:06:15.87,0:06:16.70,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:06:20.04,0:06:21.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:23.46,0:06:23.96,Default,,0,0,0,,О
Dialogue: 0,0:06:30.01,0:06:31.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.76,0:06:33.97,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:06:36.35,0:06:37.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.35,0:06:41.23,Default,,0,0,0,,Сіз атуға жақсы емессіз.
Dialogue: 0,0:06:41.31,0:06:43.27,Default,,0,0,0,,Мен қорғаныста жақсымын.
Dialogue: 0,0:06:46.69,0:06:51.86,Default,,0,0,0,,Хун хун хун хун...
Dialogue: 0,0:06:51.95,0:06:53.41,Default,,0,0,0,,Сіз кіргеннен кейін...
Dialogue: 0,0:06:53.49,0:06:54.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:54.49,0:06:55.16,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:00.71,0:07:01.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:01.58,0:07:03.33,Default,,0,0,0,,Пя! Кешіріңіз...
Dialogue: 0,0:07:05.92,0:07:07.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:09.59,0:07:11.09,Default,,0,0,0,,Сіз кіргеннен кейін...
Dialogue: 0,0:07:15.10,0:07:16.72,Default,,0,0,0,,Сіз кіргеннен кейін...
Dialogue: 0,0:07:17.60,0:07:20.98,Default,,0,0,0,,Мойындау...
Dialogue: 0,0:07:29.11,0:07:30.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:32.99,0:07:34.12,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:07:39.95,0:07:40.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:40.96,0:07:42.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:42.29,0:07:43.79,Default,,0,0,0,,Я, бұл менің мақсатым.
Dialogue: 0,0:07:43.88,0:07:46.17,Default,,0,0,0,,Жоқ, мен қойдым.
Dialogue: 0,0:07:46.25,0:07:48.13,Default,,0,0,0,,Сондықтан мен жеңдім
Dialogue: 0,0:07:48.21,0:07:50.80,Default,,0,0,0,,Олай болса, бұл мүмкін емес.
Dialogue: 0,0:07:51.30,0:07:53.47,Default,,0,0,0,,Сізге баскетбол ұнайды.
Dialogue: 0,0:07:53.55,0:07:57.22,Default,,0,0,0,,Хехе... Ичикава менімен бірге болғаны үшін.
Dialogue: 0,0:07:57.72,0:07:58.60,Default,,0,0,0,,Е...
Dialogue: 0,0:08:01.35,0:08:04.15,Default,,0,0,0,,Біз не істейміз? Жеңімпаздың өтініші
Dialogue: 0,0:08:07.23,0:08:08.15,Default,,0,0,0,,Кио…
Dialogue: 0,0:08:08.23,0:08:09.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.36,0:08:11.15,Default,,0,0,0,,Кио…
Dialogue: 0,0:08:14.32,0:08:15.41,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:08:19.49,0:08:23.21,Default,,0,0,0,,Мен сені «Кё» деп атауға бола ма?
Dialogue: 0,0:08:23.29,0:08:25.42,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:08:26.00,0:08:27.54,Default,,0,0,0,,Менің айтайын дегенім...
Dialogue: 0,0:08:27.63,0:08:30.63,Default,,0,0,0,,Сәлем! Үйге ерте қайт!
Dialogue: 0,0:08:42.64,0:08:44.77,Default,,0,0,0,,Джиджи…
Dialogue: 0,0:08:48.19,0:08:49.48,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:08:50.44,0:08:52.03,Default,,0,0,0,,Бүгін өзіңізді қалай сезінесіз?
Dialogue: 0,0:08:53.03,0:08:54.40,Default,,0,0,0,,Некью
Dialogue: 0,0:08:55.11,0:08:56.32,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:08:56.99,0:08:58.20,Default,,0,0,0,,Бүгін!
Dialogue: 0,0:09:00.08,0:09:01.83,Default,,0,0,0,,Мені Анна деп атама
Dialogue: 0,0:09:02.41,0:09:03.91,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:04.00,0:09:05.87,Default,,0,0,0,,Мен Люцифер Нигорикавамын
Dialogue: 0,0:09:05.96,0:09:08.50,Default,,0,0,0,,Сіздің инстинкт либидоңыз
Dialogue: 0,0:09:08.58,0:09:09.92,Default,,0,0,0,,Сонда бұл кім?
Dialogue: 0,0:09:10.00,0:09:13.05,Default,,0,0,0,,Егер сіз мүйізденсеңіз, сіз үлкен бола аласыз!
Dialogue: 0,0:09:13.92,0:09:16.05,Default,,0,0,0,,- (Кана) Эй Кио-чан - (Ичикава) Бұл не?
Dialogue: 0,0:09:16.97,0:09:18.59,Default,,0,0,0,,Есікті тықылдатпай ашпа
Dialogue: 0,0:09:18.68,0:09:22.18,Default,,0,0,0,,Ертең менің туған күнім, ал анам сукияки дайындағалы жатыр.
Dialogue: 0,0:09:22.27,0:09:24.43,Default,,0,0,0,,Хамф, бұл кеш.
Dialogue: 0,0:09:24.52,0:09:27.52,Default,,0,0,0,,Той-томалақтарда мұны істей бермейсің.
Dialogue: 0,0:09:27.60,0:09:28.98,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:09:29.06,0:09:32.69,Default,,0,0,0,,Өйткені биылғы туған күн өткен жылдардан ерекше.
Dialogue: 0,0:09:33.82,0:09:35.44,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:09:35.53,0:09:37.74,Default,,0,0,0,,Сіз кез келген жерге барасыз ба?
Dialogue: 0,0:09:37.82,0:09:41.41,Default,,0,0,0,,Шынымен де... Ямада көктемгі демалыста жұмыстан бос емес.
Dialogue: 0,0:09:41.49,0:09:42.66,Default,,0,0,0,,Мен де тығылған мектепке барамын.
Dialogue: 0,0:09:42.74,0:09:44.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:44.16,0:09:48.75,Default,,0,0,0,,Мен тіпті Анна-чан туралы мүлде айтқан жоқпын.
Dialogue: 0,0:09:48.83,0:09:51.88,Default,,0,0,0,,- (Ичикава) Шулысың, шық! -(Кана) Ааа!
Dialogue: 0,0:09:55.13,0:09:58.55,Default,,0,0,0,,Содан менің туған күнім оқиғасыз келді.
Dialogue: 0,0:09:59.09,0:10:01.10,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:10:01.18,0:10:02.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:12.32,0:10:16.19,Default,,0,0,0,,Ерекше күн... аздап
Dialogue: 0,0:10:17.82,0:10:18.95,Default,,0,0,0,,(Билет қақпасының түрту дыбысы)
Dialogue: 0,0:10:27.96,0:10:28.96,Default,,0,0,0,,Дукши!
Dialogue: 0,0:10:29.54,0:10:31.38,Default,,0,0,0,,Сіз әрқашан үйге жалғыз барасыз ба?
Dialogue: 0,0:10:31.46,0:10:34.88,Default,,0,0,0,,Иә, егер кеш болса, мені алып кетуіңізді сұраймын.
Dialogue: 0,0:10:34.96,0:10:36.67,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:10:36.76,0:10:39.97,Default,,0,0,0,,Бұл Ичикаваға да қатысты. Жалғыз өзі үйіне қайтып бара жатты.
Dialogue: 0,0:10:40.05,0:10:41.47,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:10:41.55,0:10:43.89,Default,,0,0,0,,Иә? Ичикава?
Dialogue: 0,0:10:44.64,0:10:48.06,Default,,0,0,0,,Мен сізді «Кё» деп атауға бола ма?
Dialogue: 0,0:10:48.14,0:10:50.64,Default,,0,0,0,,Мен... қате естідім бе?
Dialogue: 0,0:10:51.19,0:10:55.19,Default,,0,0,0,,Әлде үйге бірінші барғандықтан мен сені жек көремін деп ойлайсың ба?
Dialogue: 0,0:10:55.69,0:10:56.69,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:10:57.36,0:10:59.36,Default,,0,0,0,,Жарайды, мені Кио деп атаңыз.
Dialogue: 0,0:10:59.45,0:11:02.66,Default,,0,0,0,,Жоқ, бұл өрескел.
Dialogue: 0,0:11:03.20,0:11:06.70,Default,,0,0,0,,Не... не? көзқарасты сезіну
Dialogue: 0,0:11:10.50,0:11:13.00,Default,,0,0,0,,Мүмкін ол тіркелген шығар?
Dialogue: 0,0:11:15.84,0:11:18.67,Default,,0,0,0,,Келесің бе? Амал жоқ...
Dialogue: 0,0:11:19.67,0:11:22.18,Default,,0,0,0,,Не істеу керек? Қалай...
Dialogue: 0,0:11:25.30,0:11:29.31,Default,,0,0,0,,Мен өлсем де, Ямаданы ғана қорғаймын!
Dialogue: 0,0:11:31.48,0:11:33.60,Default,,0,0,0,,Күткендей, Кио Чан
Dialogue: 0,0:11:33.69,0:11:34.40,Default,,0,0,0,,Е...
Dialogue: 0,0:11:34.48,0:11:37.23,Default,,0,0,0,,Әке... Әй, сен қорқыныштысың!
Dialogue: 0,0:11:37.32,0:11:40.19,Default,,0,0,0,,Кешіріңіз, мен сізбен сөйлесе аламын ба?
Dialogue: 0,0:11:40.28,0:11:41.95,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:11:42.45,0:11:44.99,Default,,0,0,0,,Ах... Қайырлы кеш.
Dialogue: 0,0:11:45.07,0:11:46.87,Default,,0,0,0,,Сіз мені таң қалдырдыңыз.
Dialogue: 0,0:11:46.95,0:11:49.75,Default,,0,0,0,,Мен брондаған тортты алуға бардым.
Dialogue: 0,0:11:49.83,0:11:52.75,Default,,0,0,0,,Торт... Тойлайтын нәрсе ме?
Dialogue: 0,0:11:52.83,0:11:56.00,Default,,0,0,0,,Не? Бұл оның туған күні, солай ма?
Dialogue: 0,0:11:57.67,0:11:59.51,Default,,0,0,0,,А-а-а! бүгін?
Dialogue: 0,0:11:59.59,0:12:01.84,Default,,0,0,0,,Маған неге айтпайсың?
Dialogue: 0,0:12:01.92,0:12:04.39,Default,,0,0,0,,Мацусака сиыр еті, сукиякиге ұқсас
Dialogue: 0,0:12:04.47,0:12:05.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:06.43,0:12:09.39,Default,,0,0,0,,Келгіңіз келе ме?
Dialogue: 0,0:12:10.98,0:12:11.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:14.10,0:12:15.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:15.27,0:12:16.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:17.98,0:12:21.94,Default,,0,0,0,,Уақытты жақсы өткізейік!
Dialogue: 0,0:12:25.03,0:12:27.62,Default,,0,0,0,,Иә, тамақ жеген дұрыс.
Dialogue: 0,0:12:27.70,0:12:30.20,Default,,0,0,0,,Бұл маңызды емес, бірақ достар ше?
Dialogue: 0,0:12:30.29,0:12:32.91,Default,,0,0,0,,Не? Ах, мм...
Dialogue: 0,0:12:33.00,0:12:36.04,Default,,0,0,0,,- (Кана) Анна-чан - (Ямаданың анасы) Әй, қыз?
Dialogue: 0,0:12:36.13,0:12:39.25,Default,,0,0,0,,А... Уф, Кана-чан
Dialogue: 0,0:12:39.34,0:12:41.55,Default,,0,0,0,,- (Ямаданың анасы) Иә - (Ямада) Онда мен оны кесемін.
Dialogue: 0,0:12:42.88,0:12:44.76,Default,,0,0,0,,Эй, сен неге киіміңді ауыстырып жатырсың?
Dialogue: 0,0:12:44.84,0:12:46.43,Default,,0,0,0,,Бұл мерекелік стиль.
Dialogue: 0,0:12:46.51,0:12:48.55,Default,,0,0,0,,-(Ямада) Өте сүйкімді~ -(Кана) Хи хи
Dialogue: 0,0:12:50.39,0:12:52.52,Default,,0,0,0,,Күліңіз, келіңіз.
Dialogue: 0,0:12:52.60,0:12:54.23,Default,,0,0,0,,Азаптауды тоқтату
Dialogue: 0,0:12:55.10,0:12:57.94,Default,,0,0,0,,Бүгін... Бүгін сенің туған күнің.
Dialogue: 0,0:12:58.81,0:13:00.48,Default,,0,0,0,,- (Ичикава) Бүгін? -(Ямада) Хмм...
Dialogue: 0,0:13:01.07,0:13:03.49,Default,,0,0,0,,Аа, кешіріңіз, байқамадым.
Dialogue: 0,0:13:03.57,0:13:05.57,Default,,0,0,0,,Қараңызшы, сіз қалағаныңызды аласыз.
Dialogue: 0,0:13:05.65,0:13:09.12,Default,,0,0,0,,Жоқ... Кішкене болса да жақсымын.
Dialogue: 0,0:13:09.20,0:13:11.87,Default,,0,0,0,,Ал... Мен аз ғана тамақ ішемін.
Dialogue: 0,0:13:11.95,0:13:13.41,Default,,0,0,0,,Аса өтірік
Dialogue: 0,0:13:13.50,0:13:15.75,Default,,0,0,0,,Ямада мырза, сіз өте арықсыз.
Dialogue: 0,0:13:15.83,0:13:17.33,Default,,0,0,0,,Мен қатты уайымдап тұрмын
Dialogue: 0,0:13:17.42,0:13:20.00,Default,,0,0,0,,Эй, сен модель сияқтысың.
Dialogue: 0,0:13:21.30,0:13:24.17,Default,,0,0,0,,Мүмкін, саған кішкене сабақ беруім керек шығар.
Dialogue: 0,0:13:24.26,0:13:25.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.47,0:13:28.30,Default,,0,0,0,,Бұл шынымен үлгі ме? Оқу ұнайды ма?
Dialogue: 0,0:13:28.39,0:13:31.14,Default,,0,0,0,,Жоқ, бұл қалыпты үлгі.
Dialogue: 0,0:13:31.22,0:13:32.64,Default,,0,0,0,,Өйткені ол кеңседе
Dialogue: 0,0:13:32.72,0:13:34.27,Default,,0,0,0,,Кәсіби сән үлгілері
Dialogue: 0,0:13:34.35,0:13:35.94,Default,,0,0,0,,Кәсіби? Эхехе
Dialogue: 0,0:13:39.15,0:13:42.48,Default,,0,0,0,,Мен неге осылай киіндім?
Dialogue: 0,0:13:42.57,0:13:43.61,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:13:43.69,0:13:45.99,Default,,0,0,0,,Әпке, бізде әлі сыра бар.
Dialogue: 0,0:13:46.07,0:13:47.95,Default,,0,0,0,,А, мен мұны істеймін.
Dialogue: 0,0:13:48.45,0:13:51.16,Default,,0,0,0,,- (Кана) Мо... Модельдің сусыны - (Ичикава) Айтпа.
Dialogue: 0,0:13:51.24,0:13:53.62,Default,,0,0,0,,А, о... Әке де.
Dialogue: 0,0:13:53.70,0:13:55.41,Default,,0,0,0,,А, шай.
Dialogue: 0,0:13:56.08,0:13:57.79,Default,,0,0,0,,Ойланып қарашы, апа.
Dialogue: 0,0:13:57.87,0:14:00.08,Default,,0,0,0,,Сіз маған туған күніме сыйлық сатып алдыңыз, солай ма?
Dialogue: 0,0:14:00.17,0:14:02.50,Default,,0,0,0,,Е, а... кейін жарайды.
Dialogue: 0,0:14:02.59,0:14:04.05,Default,,0,0,0,,Бар болса, маған тез бер.
Dialogue: 0,0:14:04.13,0:14:06.76,Default,,0,0,0,,А... сонда
Dialogue: 0,0:14:06.84,0:14:10.76,Default,,0,0,0,,Иә, бұл сізге ұнады деп айтқан ойындағы қоян фигурасы.
Dialogue: 0,0:14:10.85,0:14:12.89,Default,,0,0,0,,Ой... ақымақ болма!
Dialogue: 0,0:14:12.97,0:14:13.60,Default,,0,0,0,,О!
Dialogue: 0,0:14:13.68,0:14:15.14,Default,,0,0,0,,Неліктен әдемі қыз фигуралары?
Dialogue: 0,0:14:15.22,0:14:16.81,Default,,0,0,0,,Менің ойымша, бәрі қояндар туралы.
Dialogue: 0,0:14:16.89,0:14:20.27,Default,,0,0,0,,Жоқ! Бұл фигура жай ғана қоян нұсқасы болады.
Dialogue: 0,0:14:20.86,0:14:22.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.11,0:14:25.57,Default,,0,0,0,,♪ Даан Дака Даан
Dialogue: 0,0:14:25.65,0:14:28.53,Default,,0,0,0,,♪ Даан Дака Даан
Dialogue: 0,0:14:28.61,0:14:30.61,Default,,0,0,0,,Бұл той ғой, солай ма?
Dialogue: 0,0:14:30.70,0:14:33.12,Default,,0,0,0,,А, а, мен түсіндім, у...
Dialogue: 0,0:14:33.20,0:14:36.37,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:36.45,0:14:39.87,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:39.96,0:14:42.50,Default,,0,0,0,,♪ Туған күніңмен жаным
Dialogue: 0,0:14:42.59,0:14:45.13,Default,,0,0,0,,- (Ямада) ♪ Киоторо - (3 адам) ♪ Кио-чан
Dialogue: 0,0:14:45.21,0:14:49.30,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:49.88,0:14:52.76,Default,,0,0,0,,Иә, 14 жастағы ұмтылыстарыңызды айтып, содан кейін оларды жойыңыз.
Dialogue: 0,0:14:52.85,0:14:55.56,Default,,0,0,0,,Хмм, өзіңді күт?
Dialogue: 0,0:14:55.64,0:14:56.81,Default,,0,0,0,,Қария?
Dialogue: 0,0:14:56.89,0:14:57.93,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:14:58.93,0:14:59.52,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:15:00.19,0:15:02.31,Default,,0,0,0,,Мен оларды соншалықты ұнатпаймын...
Dialogue: 0,0:15:03.31,0:15:04.40,Default,,0,0,0,,Бүгін
Dialogue: 0,0:15:04.90,0:15:06.07,Default,,0,0,0,,(шу)
Dialogue: 0,0:15:06.90,0:15:08.07,Default,,0,0,0,,- (Ичикаваның анасы) Кио-чан? -(Кана) А?
Dialogue: 0,0:15:08.86,0:15:10.78,Default,,0,0,0,,Кісі өлтіру ісі?
Dialogue: 0,0:15:10.86,0:15:14.53,Default,,0,0,0,,Бұл уақыт жақсы емес...
Dialogue: 0,0:15:15.20,0:15:17.04,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:15:17.12,0:15:18.12,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:15:18.20,0:15:20.79,Default,,0,0,0,,Шынымен бе? Тіпті модель тұрғысынан?
Dialogue: 0,0:15:20.87,0:15:22.83,Default,,0,0,0,,Бұл сүйкімді Бұл сүйкімді!
Dialogue: 0,0:15:22.92,0:15:26.13,Default,,0,0,0,,Күте тұрыңыз, енді бәрі сүйкімді дейтін типсіз.
Dialogue: 0,0:15:26.21,0:15:28.38,Default,,0,0,0,,Біз қазірдің өзінде доспыз ба?
Dialogue: 0,0:15:28.46,0:15:32.18,Default,,0,0,0,,Сағат 9:30-ға таяп қалды. Уақыт дұрыс па?
Dialogue: 0,0:15:32.26,0:15:33.34,Default,,0,0,0,,Олай болса уақыт келді...
Dialogue: 0,0:15:33.43,0:15:35.97,Default,,0,0,0,,Қане, түнге кел.
Dialogue: 0,0:15:36.06,0:15:36.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.64,0:15:40.35,Default,,0,0,0,,Өткен күні мен Момо-чан мен Хикотомен бірге болдым.
Dialogue: 0,0:15:40.43,0:15:41.56,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:15:41.64,0:15:44.23,Default,,0,0,0,,Егер Ямада мырза жақсы болса.
Dialogue: 0,0:15:44.31,0:15:45.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:45.90,0:15:46.82,Default,,0,0,0,,Ах
Dialogue: 0,0:15:46.90,0:15:48.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:52.40,0:15:55.12,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:15:55.74,0:15:58.49,Default,,0,0,0,,Жаман... Жаман.
Dialogue: 0,0:15:58.99,0:16:00.54,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:16:00.62,0:16:02.87,Default,,0,0,0,,Ата-анаң жақсы деп жатыр ма?
Dialogue: 0,0:16:05.13,0:16:08.38,Default,,0,0,0,,Мен Ичикаваның анасымын.
Dialogue: 0,0:16:08.46,0:16:10.88,Default,,0,0,0,,Сәлеметсіз бе, мен кенеттен кешірім сұраймын.
Dialogue: 0,0:16:10.97,0:16:12.34,Default,,0,0,0,,Ичикава...
Dialogue: 0,0:16:12.42,0:16:15.93,Default,,0,0,0,,Менің қызым екеуің соқтығысып қалған сияқтысыңдар.
Dialogue: 0,0:16:16.01,0:16:18.35,Default,,0,0,0,,Ямада қалды
Dialogue: 0,0:16:18.43,0:16:22.39,Default,,0,0,0,,Тоқта, мен түнеп жатсам да, ата-анам мен әпкем де сонда.
Dialogue: 0,0:16:22.48,0:16:24.60,Default,,0,0,0,,Ойланатын жаман нәрсе
Dialogue: 0,0:16:24.69,0:16:27.77,Default,,0,0,0,,Мен алдымен Ямада мырзадан ваннаға түсуін сұраймын.
Dialogue: 0,0:16:27.86,0:16:29.78,Default,,0,0,0,,Офуро?
Dialogue: 0,0:16:29.86,0:16:33.11,Default,,0,0,0,,Жоқ, тыныштал, біз бірге кірмейміз.
Dialogue: 0,0:16:33.20,0:16:35.70,Default,,0,0,0,,Әпкемнің досы қалғаннан айырмашылығы жоқ.
Dialogue: 0,0:16:35.78,0:16:38.33,Default,,0,0,0,,Әйтеуір әпкемнің қасында кеш тұрып, ұйықтап қалдым...
Dialogue: 0,0:16:38.41,0:16:39.49,Default,,0,0,0,,Не!
Dialogue: 0,0:16:39.58,0:16:40.33,Default,,0,0,0,,Ах
Dialogue: 0,0:16:40.41,0:16:44.33,Default,,0,0,0,,Бұл Аннаның түнгі көйлегі мен фуфайкасы...
Dialogue: 0,0:16:44.42,0:16:46.00,Default,,0,0,0,,Жоғарыда...
Dialogue: 0,0:16:46.08,0:16:50.09,Default,,0,0,0,,Күтілгендей, пайдаланылмаған шалбар болған жоқ, сондықтан бұл тек бір рет қолданылған шалбар.
Dialogue: 0,0:16:50.17,0:16:50.84,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:16:50.92,0:16:53.88,Default,,0,0,0,,Тарақанға қол тигізгендей әрекет етпеңіз.
Dialogue: 0,0:16:53.97,0:16:57.05,Default,,0,0,0,,Қалғанын сұрадым...
Dialogue: 0,0:16:57.14,0:16:58.68,Default,,0,0,0,,ше? Эй!
Dialogue: 0,0:16:59.89,0:17:02.52,Default,,0,0,0,,Не, мүмкін емес...
Dialogue: 0,0:17:07.35,0:17:08.36,Default,,0,0,0,,(кранды ашу дыбысы)
Dialogue: 0,0:17:09.40,0:17:10.94,Default,,0,0,0,,-(Ичикава) Әй, анау... -(Ямада) Әй!
Dialogue: 0,0:17:11.02,0:17:13.03,Default,,0,0,0,,(ыстық суға малынған дыбыс)
Dialogue: 0,0:17:13.11,0:17:15.45,Default,,0,0,0,,- (Ичикава) Киімді ауыстыр... - (Ямада) Ухх.
Dialogue: 0,0:17:15.53,0:17:20.70,Default,,0,0,0,,Нан... жоқ, іш киім, ол сенің әпкеңдікі, ұнамаса, лақтырып таста.
Dialogue: 0,0:17:21.29,0:17:24.33,Default,,0,0,0,,Кір жуғыш машинаны қаласаңыз, пайдалануға болады.
Dialogue: 0,0:17:25.25,0:17:26.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:28.88,0:17:30.04,Default,,0,0,0,,Сожа
Dialogue: 0,0:17:30.79,0:17:32.50,Default,,0,0,0,,-(Ямада) Ой, эй -(Ичикава) Иә?
Dialogue: 0,0:17:32.59,0:17:34.42,Default,,0,0,0,,Сізде резеңке бар ма?
Dialogue: 0,0:17:34.51,0:17:35.51,Default,,0,0,0,,Е...
Dialogue: 0,0:17:35.59,0:17:39.51,Default,,0,0,0,,Кешіріңіз, мен ұмытып қалдым, сіз оны раковинаға салмадыңыз ба?
Dialogue: 0,0:17:39.60,0:17:41.18,Default,,0,0,0,,Жуынатын бөлме…
Dialogue: 0,0:17:41.68,0:17:43.52,Default,,0,0,0,,А, шаш.
Dialogue: 0,0:17:46.52,0:17:48.02,Default,,0,0,0,,Оны осында қалдырыңыз
Dialogue: 0,0:18:01.99,0:18:04.66,Default,,0,0,0,,Һм? Ой!
Dialogue: 0,0:18:06.75,0:18:08.67,Default,,0,0,0,,Кішкентай болғаным үшін кешіріңіз.
Dialogue: 0,0:18:08.75,0:18:10.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:10.42,0:18:13.92,Default,,0,0,0,,Менің суға түспеуге мүмкіндігім жоқ.
Dialogue: 0,0:18:14.00,0:18:17.30,Default,,0,0,0,,Ямаданың қалған ыстық суына мүлде тиіспеңіз.
Dialogue: 0,0:18:19.38,0:18:23.39,Default,,0,0,0,,Әпкемнің трусисына қарап, суытып алдым.
Dialogue: 0,0:18:25.14,0:18:28.56,Default,,0,0,0,,Су... Мен жаңа ғана су ішуге келдім.
Dialogue: 0,0:18:29.90,0:18:32.82,Default,,0,0,0,,(Ямаданың асқазанының шұрылдаған дыбысы)
Dialogue: 0,0:18:36.03,0:18:38.99,Default,,0,0,0,,Иә? Әй, таңқаларлық
Dialogue: 0,0:18:39.07,0:18:41.74,Default,,0,0,0,,Сіз тек екі кесек ет жедіңіз.
Dialogue: 0,0:18:41.82,0:18:44.58,Default,,0,0,0,,Уау, жақсы көрінесің.
Dialogue: 0,0:18:44.66,0:18:45.91,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:18:46.91,0:18:47.58,Default,,0,0,0,,Сценарий?
Dialogue: 0,0:18:47.66,0:18:50.12,Default,,0,0,0,,Иә, келесі күні суретке түсіремін.
Dialogue: 0,0:18:50.21,0:18:52.84,Default,,0,0,0,,Менің ойымша, сіз бос емессіз бе?
Dialogue: 0,0:18:52.92,0:18:56.46,Default,,0,0,0,,Жоқ, мен ұйықтай алмағандықтан оны қайта оқып шықтым.
Dialogue: 0,0:18:58.38,0:18:59.26,Default,,0,0,0,,Пухат
Dialogue: 0,0:19:01.26,0:19:02.30,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:19:04.05,0:19:04.81,Default,,0,0,0,,Фильм?
Dialogue: 0,0:19:04.89,0:19:09.23,Default,,0,0,0,,Иә, ол ата-анасына қиналып, бас көтеретін бала.
Dialogue: 0,0:19:09.31,0:19:10.69,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:19:10.77,0:19:14.19,Default,,0,0,0,,Егер мен жалғыз өзім оғаш әрекет етсем, ол бұзылар еді.
Dialogue: 0,0:19:14.27,0:19:16.73,Default,,0,0,0,,Мен... Мен қобалжыдым.
Dialogue: 0,0:19:16.82,0:19:19.15,Default,,0,0,0,,Не деген орташа сөз
Dialogue: 0,0:19:19.24,0:19:22.16,Default,,0,0,0,,Мен ешқашан бүлікші фазада болған емеспін.
Dialogue: 0,0:19:22.24,0:19:24.07,Default,,0,0,0,,Мен қызғаншақпын
Dialogue: 0,0:19:24.16,0:19:27.83,Default,,0,0,0,,Иә? Ичикава деген қала бар ма?
Dialogue: 0,0:19:28.33,0:19:30.08,Default,,0,0,0,,Көріп отырғаныңыздай.
Dialogue: 0,0:19:30.16,0:19:33.50,Default,,0,0,0,,Неліктен? Жақсы әке мен ана
Dialogue: 0,0:19:33.58,0:19:35.50,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:19:36.88,0:19:40.13,Default,,0,0,0,,Бірақ мен ата-анама ренжімеймін.
Dialogue: 0,0:19:40.22,0:19:42.68,Default,,0,0,0,,Мен өзімді шын айта алмаймын
Dialogue: 0,0:19:43.68,0:19:46.93,Default,,0,0,0,,Жақсы қыз болмаймын деп уайымдау
Dialogue: 0,0:19:49.52,0:19:50.93,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:19:53.52,0:19:56.11,Default,,0,0,0,,Бұл өте пайдалы емес...
Dialogue: 0,0:20:10.70,0:20:14.88,Default,,0,0,0,,Неліктен? Жүрегім дүрсілдеп тұр, бірақ жеңілдеп қалдым.
Dialogue: 0,0:20:17.75,0:20:20.51,Default,,0,0,0,,Бұл біртүрлі, Ямада.
Dialogue: 0,0:20:27.43,0:20:31.10,Default,,0,0,0,,Рахмет, мен жақын арада ойнағым келеді.
Dialogue: 0,0:20:37.19,0:20:40.82,Default,,0,0,0,,Осылайша әпкем танымал болу үшін топ ашты...
Dialogue: 0,0:20:42.36,0:20:46.28,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:14.81,0:21:15.89,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:21:23.78,0:21:25.78,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.70,0:22:52.70,Default,,0,0,0,,～♪
Dialogue: 0,0:22:52.78,0:22:53.62,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:22:54.41,0:22:56.87,Default,,0,0,0,,Әпкемнің пайдаланылмаған шалбары
Dialogue: 0,0:22:57.45,0:22:59.41,Default,,0,0,0,,Айналдыратын кір жуғыш машина
Dialogue: 0,0:22:59.92,0:23:01.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:01.88,0:23:04.00,Default,,0,0,0,,Ямада киген...
Dialogue: 0,0:23:05.50,0:23:11.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
