Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:06.00,Default,,0,0,0,,[Музыка]
Dialogue: 0,0:00:06.00,0:00:11.00,Default,,0,0,0,,Кеуде қуысының төңкерілген жарақаты
Dialogue: 0,0:00:11.00,0:00:16.00,Default,,0,0,0,,Толып жатқан қол мен тамағы
Dialogue: 0,0:00:16.00,0:00:22.00,Default,,0,0,0,,Бірін-бірі қайталайтын сәттер
Dialogue: 0,0:00:22.00,0:00:27.00,Default,,0,0,0,,Байланысқан сезімдерді балқыту
Dialogue: 0,0:00:27.00,0:00:32.00,Default,,0,0,0,,Ешқашан суымайтын жылумен ылғалданған
Dialogue: 0,0:00:32.00,0:00:38.00,Default,,0,0,0,,Соңғы дауысты да естімеймін
Dialogue: 0,0:00:38.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететіндей болдым
Dialogue: 0,0:00:44.00,0:00:49.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:53.00,Default,,0,0,0,,Ақырын алақанмен сана
Dialogue: 0,0:00:53.00,0:00:57.00,Default,,0,0,0,,Маған қол тигізуге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:08.00,Default,,0,0,0,,Ешқашан өшпейтін ғажайыптың есімі
Dialogue: 0,0:01:08.00,0:01:12.00,Default,,0,0,0,,Алақан қаттырақ
Dialogue: 0,0:01:12.00,0:01:17.00,Default,,0,0,0,,Маған түртіңіз
Dialogue: 0,0:01:18.00,0:01:22.00,Default,,0,0,0,,Егер мен ешқашан бітпесем
Dialogue: 0,0:01:22.00,0:01:28.00,Default,,0,0,0,,Босату
Dialogue: 0,0:01:40.00,0:01:45.00,Default,,0,0,0,,[Ән]
Dialogue: 0,0:01:45.00,0:01:49.00,Default,,0,0,0,,B жинағы C жинағы A жинағы күту
Dialogue: 0,0:01:49.00,0:01:51.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:01:51.00,0:01:54.00,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:02:00.00,0:02:05.00,Default,,0,0,0,,Жаңа қызметкер, осы уақытқа дейін бізге сүйкімді қыздар келді.
Dialogue: 0,0:02:05.00,0:02:08.00,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Аллен Уокер.
Dialogue: 0,0:02:08.00,0:02:11.00,Default,,0,0,0,,Дәмді, сыпайы және жабысқақ
Dialogue: 0,0:02:11.00,0:02:12.00,Default,,0,0,0,,Не жегің келеді?
Dialogue: 0,0:02:12.00,0:02:16.00,Default,,0,0,0,,Мен кез келген нәрсені жасай аламын.
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Секір!!
Dialogue: 0,0:02:20.00,0:02:22.00,Default,,0,0,0,,Гратин, картоп және құрғақ карри
Dialogue: 0,0:02:22.00,0:02:26.00,Default,,0,0,0,,Мапо тофу, сиыр еті, ет пирогы, карпакча және наси горенг
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,тунец салаты және кондитер қосылған тауық еті
Dialogue: 0,0:02:28.00,0:02:31.00,Default,,0,0,0,,Том Юм және күріш қосылған баузер
Dialogue: 0,0:02:31.00,0:02:35.00,Default,,0,0,0,,Сондай-ақ, былғарыдан жасалған манго пудингі мен митараши данго.
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,№ 20
Dialogue: 0,0:02:37.00,0:02:39.00,Default,,0,0,0,,Сіз соншалықты көп жейсіз бе?
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Барлығын бірден қараңыз
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Әй, тоқтаңдаршы
Dialogue: 0,0:02:46.00,0:02:48.00,Default,,0,0,0,,Сол адам
Dialogue: 0,0:02:48.00,0:02:52.00,Default,,0,0,0,,Мен сені осы шексіздікпен жыртамын
Dialogue: 0,0:02:52.00,0:02:54.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:02:56.00,0:03:01.00,Default,,0,0,0,,Мен тамақтанып жатқанда артымнан өлген адамдар туралы айтады.
Dialogue: 0,0:03:01.00,0:03:03.00,Default,,0,0,0,,Тамақтың дәмі нашар.
Dialogue: 0,0:03:03.00,0:03:08.00,Default,,0,0,0,,Тоқтай тұрыңыз, сыныптастарыңызға айтатын сөзіңіз осы ма?
Dialogue: 0,0:03:08.00,0:03:10.00,Default,,0,0,0,,Біз табушылар
Dialogue: 0,0:03:10.00,0:03:15.00,Default,,0,0,0,,Жігіттер, жын шығарушыларға қолдау көрсету үшін өз өмірлеріңізді қатерге тігіп жатырсыздар.
Dialogue: 0,0:03:15.00,0:03:19.00,Default,,0,0,0,,бұл
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Тамақтың дәмі нашар болады.
Dialogue: 0,0:03:26.00,0:03:29.00,Default,,0,0,0,,Біз сізді қолдаймыз.
Dialogue: 0,0:03:31.00,0:03:35.00,Default,,0,0,0,,Мен тек қолдау көрсете аламын.
Dialogue: 0,0:03:35.00,0:03:38.00,Default,,0,0,0,,Сіз жын шығарушы бола алмадыңыз.
Dialogue: 0,0:03:38.00,0:03:41.00,Default,,0,0,0,,Ол бейкүнә таңдалмаған шеттетілген адам.
Dialogue: 0,0:03:41.00,0:03:45.00,Default,,0,0,0,,Табушыларға көптеген баламалар бар.
Dialogue: 0,0:03:45.00,0:03:48.00,Default,,0,0,0,,Өлгің келмесе, кет.
Dialogue: 0,0:03:54.00,0:03:56.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Маңызды болмаса, кешіріңіз.
Dialogue: 0,0:03:58.00,0:04:01.00,Default,,0,0,0,,Менің ойымша, бұлай айтуға болмайды.
Dialogue: 0,0:04:01.00,0:04:04.00,Default,,0,0,0,,Бұршақ өскіндерін жіберіңіз
Dialogue: 0,0:04:04.00,0:04:07.00,Default,,0,0,0,,Бұршақ өскіндері?Аллен
Dialogue: 0,0:04:08.00,0:04:11.00,Default,,0,0,0,,Бір ай бойы берілмесең, есімде қалады.
Dialogue: 0,0:04:11.00,0:04:14.00,Default,,0,0,0,,Мұнда көп адам өліп жатыр.
Dialogue: 0,0:04:14.00,0:04:16.00,Default,,0,0,0,,Мына жігіттер сияқты
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Бұлай айту мүмкін емес, солай ма?
Dialogue: 0,0:04:24.00,0:04:27.00,Default,,0,0,0,,Қарғыс алсаң маған тиіспе.
Dialogue: 0,0:04:29.00,0:04:31.00,Default,,0,0,0,,Сен ерте өлесің
Dialogue: 0,0:04:31.00,0:04:33.00,Default,,0,0,0,,Сен мен жек көретін түріңсің
Dialogue: 0,0:04:33.00,0:04:35.00,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,Ревер командасы
Dialogue: 0,0:04:41.00,0:04:43.00,Default,,0,0,0,,Итита
Dialogue: 0,0:04:43.00,0:04:45.00,Default,,0,0,0,,Алленді қолдау
Dialogue: 0,0:04:46.00,0:04:48.00,Default,,0,0,0,,Команда бөлмесіне келіңіз.
Dialogue: 0,0:04:48.00,0:04:50.00,Default,,0,0,0,,Бұл миссия.
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Басқарушы
Dialogue: 0,0:04:54.00,0:04:56.00,Default,,0,0,0,,Басқарушы
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Мемлекеттік қызметшілердің бас басқарушысы
Dialogue: 0,0:04:59.00,0:05:03.00,Default,,0,0,0,,Ленали үйленеді.
Dialogue: 0,0:05:03.00,0:05:06.00,Default,,0,0,0,,Ленарий
Dialogue: 0,0:05:06.00,0:05:09.00,Default,,0,0,0,,Ағаңа айтпай күйеуге шығасың.
Dialogue: 0,0:05:09.00,0:05:11.00,Default,,0,0,0,,Мен сені кешірмеймін.
Dialogue: 0,0:05:12.00,0:05:13.00,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:05:13.00,0:05:16.00,Default,,0,0,0,,Бұл адам тек осы жерде болады
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:05:20.00,0:05:21.00,Default,,0,0,0,,Себебі менің уақытым жоқ
Dialogue: 0,0:05:21.00,0:05:24.00,Default,,0,0,0,,Сұлбаны тыңдағаннан кейін, екеуін дереу тастаңыз.
Dialogue: 0,0:05:24.00,0:05:26.00,Default,,0,0,0,,2 адам
Dialogue: 0,0:05:26.00,0:05:28.00,Default,,0,0,0,,Осындай қарғыс атқан адаммен
Dialogue: 0,0:05:28.00,0:05:31.00,Default,,0,0,0,,Дұрыс, екеуміз біргеміз.
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:05:37.00,0:05:40.00,Default,,0,0,0,,Ол қазірдің өзінде нашарлады ма? Балалар сендер
Dialogue: 0,0:05:40.00,0:05:43.00,Default,,0,0,0,,Өйткені біз сол кезде кездестік
Dialogue: 0,0:05:44.00,0:05:46.00,Default,,0,0,0,,Мен өзімшілдігімді тыңдамаймын
Dialogue: 0,0:05:46.00,0:05:50.00,Default,,0,0,0,,Оңтүстік Италияда табылған кінәсіздік
Dialogue: 0,0:05:50.00,0:05:53.00,Default,,0,0,0,,Бірақ шайтан да байқап, соны көздеп отырған сияқты.
Dialogue: 0,0:05:53.00,0:05:55.00,Default,,0,0,0,,Орынға дереу барыңыз
Dialogue: 0,0:05:55.00,0:05:58.00,Default,,0,0,0,,Жауды жойып, жазықсызды қорғау
Dialogue: 0,0:05:58.00,0:06:01.00,Default,,0,0,0,,Толық ақпарат алу үшін жол бойындағы материалды оқып шығыңыз.
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:06:05.00,0:06:08.00,Default,,0,0,0,,Мен мұны киюім керек пе?
Dialogue: 0,0:06:08.00,0:06:11.00,Default,,0,0,0,,Жын шығарушының дәлелі сияқты.
Dialogue: 0,0:06:11.00,0:06:14.00,Default,,0,0,0,,Ол ұрыс үшін жасалған, сондықтан ол өте берік.
Dialogue: 0,0:06:17.00,0:06:19.00,Default,,0,0,0,,Кампи командасы
Dialogue: 0,0:06:19.00,0:06:21.00,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:06:24.00,0:06:27.00,Default,,0,0,0,,Маған сенің өткеніңді көрсетті.
Dialogue: 0,0:06:28.00,0:06:32.00,Default,,0,0,0,,Team Campy-де бейне жазу функциясы бар.
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:39.00,0:06:41.00,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:06:46.00,0:06:47.00,Default,,0,0,0,,Менің бұған уақытым жоқ.
Dialogue: 0,0:06:47.00,0:06:49.00,Default,,0,0,0,,Пойыз келе жатыр.
Dialogue: 0,0:06:53.00,0:06:55.00,Default,,0,0,0,,Сіз мұны мініп жүрсіз бе?
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Бортқа секіру
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,О, бұл
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Қара қауым
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Брондау болуы керек.
Dialogue: 0,0:07:11.00,0:07:12.00,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Біз сізге қазір хабарлаймыз.
Dialogue: 0,0:07:14.00,0:07:17.00,Default,,0,0,0,,Брондау?
Dialogue: 0,0:07:17.00,0:07:19.00,Default,,0,0,0,,Керемет жеке бөлме
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Баратын жер, Оңтүстік Италия
Dialogue: 0,0:07:25.00,0:07:27.00,Default,,0,0,0,,Ежелгі Матер қаласы
Dialogue: 0,0:07:28.00,0:07:29.00,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:07:29.00,0:07:32.00,Default,,0,0,0,,Баяғыда қираған қала ғой, солай ма?
Dialogue: 0,0:07:32.00,0:07:35.00,Default,,0,0,0,,Мақсатты заттың елесі
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Елес?
Dialogue: 0,0:07:37.00,0:07:40.00,Default,,0,0,0,,Неліктен елестер кінәсіздікпен байланысты?
Dialogue: 0,0:07:43.00,0:07:44.00,Default,,0,0,0,,А, енді
Dialogue: 0,0:07:44.00,0:07:45.00,Default,,0,0,0,,Сен мені мазақ қылдың.
Dialogue: 0,0:07:45.00,0:07:46.00,Default,,0,0,0,,Орындаңыз.
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Сіз жасадыңыз ба?
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Кінәсіздік бар жерде
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Біртүрлі құбылыстар орын алады.
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:07:54.00,0:07:57.00,Default,,0,0,0,,Топан су кезіндегі кінәсіздік
Dialogue: 0,0:07:57.00,0:07:59.00,Default,,0,0,0,,Қазіргі заманға дейін
Dialogue: 0,0:07:59.00,0:08:02.00,Default,,0,0,0,,Ол жиі әртүрлі күйге ауысады.
Dialogue: 0,0:08:07.00,0:08:10.00,Default,,0,0,0,,Сол кристалдың тылсым күші сізді жетелей ме?
Dialogue: 0,0:08:10.00,0:08:12.00,Default,,0,0,0,,Адамдар ашқан
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Әртүрлі пішіндерді алу
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Бар болуы мүмкін
Dialogue: 0,0:08:16.00,0:08:19.00,Default,,0,0,0,,Мен неге екенін білмеймін
Dialogue: 0,0:08:19.00,0:08:22.00,Default,,0,0,0,,Ол әрқашан біртүрлі құбылыстарды тудырады.
Dialogue: 0,0:08:23.00,0:08:26.00,Default,,0,0,0,,Олай болса, осы елес оқиға туралы да.
Dialogue: 0,0:08:26.00,0:08:28.00,Default,,0,0,0,,Бұл кінәсіздік себеп болуы мүмкін дегенді білдіре ме?
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,Иә
Dialogue: 0,0:08:30.00,0:08:33.00,Default,,0,0,0,,Біртүрлілік бар жерде пәктік бар.
Dialogue: 0,0:08:33.00,0:08:36.00,Default,,0,0,0,,Сол себепті бірлестік сол жерлерге барады.
Dialogue: 0,0:08:36.00,0:08:37.00,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:08:37.00,0:08:39.00,Default,,0,0,0,,Сондықтан да бірлестік осындай жерде.
Dialogue: 0,0:08:39.00,0:08:41.00,Default,,0,0,0,,Іздеуші жіберіңіз
Dialogue: 0,0:08:41.00,0:08:44.00,Default,,0,0,0,,Толық зерттеңіз
Dialogue: 0,0:08:47.00,0:08:49.00,Default,,0,0,0,,Материяның бормы?
Dialogue: 0,0:08:49.00,0:08:51.00,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:51.00,0:08:54.00,Default,,0,0,0,,Мен Аллен Уокермін.
Dialogue: 0,0:08:54.00,0:08:57.00,Default,,0,0,0,,Бұл жолғы жолбасшымыз Тома, табушы.
Dialogue: 0,0:08:57.00,0:08:59.00,Default,,0,0,0,,Лорд Уокер
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Сіз мұны көптен бері істеп жүрсіз, солай емес пе?
Dialogue: 0,0:09:02.00,0:09:04.00,Default,,0,0,0,,Әдет
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:09:07.00,0:09:11.00,Default,,0,0,0,,Уокер мырза, сіз «Матер елесі» хикаясын білесіз бе?
Dialogue: 0,0:09:11.00,0:09:13.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:13.00,0:09:15.00,Default,,0,0,0,,Міне
Dialogue: 0,0:09:15.00,0:09:17.00,Default,,0,0,0,,Баяғыда қираған Матер қаласында.
Dialogue: 0,0:09:17.00,0:09:19.00,Default,,0,0,0,,Онда елестер өмір сүреді
Dialogue: 0,0:09:19.00,0:09:23.00,Default,,0,0,0,,Елес - Матер қаласының бұрынғы тұрғыны.
Dialogue: 0,0:09:25.00,0:09:27.00,Default,,0,0,0,,Жалғыздықты емдеу
Dialogue: 0,0:09:27.00,0:09:31.00,Default,,0,0,0,,Қалаға жақындаған адамдарды сүйреткенде
Dialogue: 0,0:09:31.00,0:09:35.00,Default,,0,0,0,,Бұл барлық жерде болатын оқиға.
Dialogue: 0,0:09:35.00,0:09:37.00,Default,,0,0,0,,Біз табушылар
Dialogue: 0,0:09:37.00,0:09:39.00,Default,,0,0,0,,Егер осындай бір қауесет болса да
Dialogue: 0,0:09:39.00,0:09:41.00,Default,,0,0,0,,Міне, келдің.
Dialogue: 0,0:09:41.00,0:09:43.00,Default,,0,0,0,,Ал қауесеттердің шындығы
Dialogue: 0,0:09:43.00,0:09:46.00,Default,,0,0,0,,Кінәсіздік бар ма, жоқ па, анық болғанша
Dialogue: 0,0:09:46.00,0:09:51.00,Default,,0,0,0,,Міне, менің жұмысым айлап зерттеуге арналған.
Dialogue: 0,0:09:53.00,0:09:57.00,Default,,0,0,0,,Көпшілігі жай қауесет немесе ойдан шығарылған
Dialogue: 0,0:09:57.00,0:09:59.00,Default,,0,0,0,,Кейде шындық
Dialogue: 0,0:09:59.00,0:10:03.00,Default,,0,0,0,,Тіпті кейде шын болса да
Dialogue: 0,0:10:03.00,0:10:09.00,Default,,0,0,0,,Кінәсіздікке қатысы жоқ
Dialogue: 0,0:10:09.00,0:10:15.00,Default,,0,0,0,,Бірақ бұл шамалы мүмкіндікте
Dialogue: 0,0:10:17.00,0:10:21.00,Default,,0,0,0,,Кінәсіздігі анықталса
Dialogue: 0,0:10:23.00,0:10:25.00,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:10:25.00,0:10:29.00,Default,,0,0,0,,Біздің кезегіміз.
Dialogue: 0,0:10:29.00,0:10:33.00,Default,,0,0,0,,Баратын жеріне аз қалды
Dialogue: 0,0:10:39.00,0:10:41.00,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:41.00,0:10:43.00,Default,,0,0,0,,Көбірек тарту және түсіру
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Барған сайын
Dialogue: 0,0:10:45.00,0:10:47.00,Default,,0,0,0,,Тек жақсы қыз бол.
Dialogue: 0,0:10:47.00,0:10:49.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:49.00,0:10:51.00,Default,,0,0,0,,Мен шекке жеттім.
Dialogue: 0,0:10:51.00,0:10:53.00,Default,,0,0,0,,Енді жын шығарушы келгенше
Dialogue: 0,0:10:53.00,0:10:55.00,Default,,0,0,0,,Бұл сізге біраз уақыт алуы керек.
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:10:57.00,0:10:59.00,Default,,0,0,0,,Шынымен екі ғана жын бар ма?
Dialogue: 0,0:10:59.00,0:11:01.00,Default,,0,0,0,,Бұл оқиға.
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:23.00,0:11:25.00,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:11:25.00,0:11:27.00,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:11:27.00,0:11:29.00,Default,,0,0,0,,Шектер
Dialogue: 0,0:11:31.00,0:11:33.00,Default,,0,0,0,,Сыртқы әскерлер жойылды.
Dialogue: 0,0:11:33.00,0:11:35.00,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:35.00,0:11:39.00,Default,,0,0,0,,Егер сіз шайтанды өз шегінде ұстай алсаңыз
Dialogue: 0,0:11:39.00,0:11:41.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Біз сыртқы әскерлерден азбыз.
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Шайтанды тежейтін күш жоқ.
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Бірақ оның табылуы аз ғана уақыт.
Dialogue: 0,0:11:47.00,0:11:49.00,Default,,0,0,0,,Гузор
Dialogue: 0,0:11:49.00,0:11:51.00,Default,,0,0,0,,Лара, қаш.
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:53.00,0:11:55.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,Мен Гузолмен біргемін.
Dialogue: 0,0:11:57.00,0:11:59.00,Default,,0,0,0,,Соңғы шара
Dialogue: 0,0:11:59.00,0:12:01.00,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:12:01.00,0:12:03.00,Default,,0,0,0,,Не болса да
Dialogue: 0,0:12:03.00,0:12:07.00,Default,,0,0,0,,Матердің елесін қорғау керек
Dialogue: 0,0:12:07.00,0:12:09.00,Default,,0,0,0,,Жын шығарушы келгенше ұстаңыз
Dialogue: 0,0:12:17.00,0:12:19.00,Default,,0,0,0,,Тома
Dialogue: 0,0:12:19.00,0:12:21.00,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,өту мүмкін емес
Dialogue: 0,0:12:23.00,0:12:25.00,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:25.00,0:12:27.00,Default,,0,0,0,,Бұл суық ауа
Dialogue: 0,0:12:31.00,0:12:33.00,Default,,0,0,0,,Сіз шайтанды көре аласыз ба?
Dialogue: 0,0:12:37.00,0:12:39.00,Default,,0,0,0,,Менің сол көзім шайтанды байқайды.
Dialogue: 0,0:12:39.00,0:12:41.00,Default,,0,0,0,,Дәлірек айтсақ, бұл жынға салынған жан.
Dialogue: 0,0:12:41.00,0:12:43.00,Default,,0,0,0,,Қарғыс атқан механик
Dialogue: 0,0:12:43.00,0:12:45.00,Default,,0,0,0,,Бастамас бұрын барайық
Dialogue: 0,0:12:47.00,0:12:49.00,Default,,0,0,0,,Бұршақ өскіндері
Dialogue: 0,0:12:49.00,0:12:51.00,Default,,0,0,0,,Менде сен сияқты аңғал ойлар жоқ.
Dialogue: 0,0:12:51.00,0:12:53.00,Default,,0,0,0,,Сізді өлтіруге жақын болсаңыз да
Dialogue: 0,0:12:53.00,0:12:55.00,Default,,0,0,0,,Тапсырманы орындауға кедергі келтіретіні анықталса
Dialogue: 0,0:12:55.00,0:12:57.00,Default,,0,0,0,,Мен сені жалғыз қалдырамын
Dialogue: 0,0:12:57.00,0:12:59.00,Default,,0,0,0,,Біртүрлі жолдастық сезімге ие болу
Dialogue: 0,0:12:59.00,0:13:01.00,Default,,0,0,0,,Эмоцияға әрекет етпеңіз
Dialogue: 0,0:13:01.00,0:13:03.00,Default,,0,0,0,,Шайқаста шексіз құрбандықтар бар.
Dialogue: 0,0:13:03.00,0:13:05.00,Default,,0,0,0,,Жағымсыз тіл
Dialogue: 0,0:13:05.00,0:13:07.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:07.00,0:13:09.00,Default,,0,0,0,,Уау
Dialogue: 0,0:13:09.00,0:13:11.00,Default,,0,0,0,,Уау
Dialogue: 0,0:13:11.00,0:13:13.00,Default,,0,0,0,,Уау
Dialogue: 0,0:13:13.00,0:13:15.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:15.00,0:13:17.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:17.00,0:13:19.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:19.00,0:13:21.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:21.00,0:13:23.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:23.00,0:13:25.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:25.00,0:13:27.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:27.00,0:13:29.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:29.00,0:13:31.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:31.00,0:13:33.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:33.00,0:13:35.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:35.00,0:13:37.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:37.00,0:13:39.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:39.00,0:13:41.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:41.00,0:13:43.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,Әлі жұмыс істемейсіз бе?
Dialogue: 0,0:13:45.00,0:13:47.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:47.00,0:13:49.00,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:13:49.00,0:13:51.00,Default,,0,0,0,,Іздеуші әскерлер
Dialogue: 0,0:13:51.00,0:13:53.00,Default,,0,0,0,,Сізде кедергі генераторы болуы керек.
Dialogue: 0,0:13:53.00,0:13:55.00,Default,,0,0,0,,Менің ойымша, аман қалуға болады.
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0,0,0,,Құрылғы
Dialogue: 0,0:13:57.00,0:13:59.00,Default,,0,0,0,,Ол сол жерде.
Dialogue: 0,0:14:05.00,0:14:07.00,Default,,0,0,0,,Бұл Матер елесі ме?
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:14:09.00,0:14:11.00,Default,,0,0,0,,Секір!!
Dialogue: 0,0:14:11.00,0:14:13.00,Default,,0,0,0,,Адамдарды табыңыз
Dialogue: 0,0:14:13.00,0:14:15.00,Default,,0,0,0,,Барьерлік генератор
Dialogue: 0,0:14:15.00,0:14:17.00,Default,,0,0,0,,Матер елесін қорғау
Dialogue: 0,0:14:17.00,0:14:19.00,Default,,0,0,0,,Мен қолдандым
Dialogue: 0,0:14:19.00,0:14:21.00,Default,,0,0,0,,Сіз жын шығарушылар келгенше
Dialogue: 0,0:14:21.00,0:14:23.00,Default,,0,0,0,,Енді басқа ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:14:25.00,0:14:27.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:14:27.00,0:14:29.00,Default,,0,0,0,,Бұл сіздің ең жақсы ставкаңыз.
Dialogue: 0,0:14:29.00,0:14:31.00,Default,,0,0,0,,Сол жарық
Dialogue: 0,0:14:31.00,0:14:33.00,Default,,0,0,0,,Жылдамдықтан гөрі сабыр сақтауды басты ұстаным ет.
Dialogue: 0,0:14:33.00,0:14:35.00,Default,,0,0,0,,Лорд Уокер
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:14:37.00,0:14:39.00,Default,,0,0,0,,Бізге асығу керек
Dialogue: 0,0:14:39.00,0:14:41.00,Default,,0,0,0,,Тосқауыл ұстамайды
Dialogue: 0,0:14:41.00,0:14:43.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:15:11.00,0:15:13.00,Default,,0,0,0,,Іздеуші әскерлер
Dialogue: 0,0:15:13.00,0:15:15.00,Default,,0,0,0,,Кедергі генераторы бар
Dialogue: 0,0:15:15.00,0:15:17.00,Default,,0,0,0,,Бұл Матер елесі ме?
Dialogue: 0,0:15:17.00,0:15:19.00,Default,,0,0,0,,Жын шығарушы келгенше
Dialogue: 0,0:15:19.00,0:15:21.00,Default,,0,0,0,,Енді басқа ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:15:21.00,0:15:23.00,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:15:23.00,0:15:25.00,Default,,0,0,0,,Жын шығарушы
Dialogue: 0,0:15:25.00,0:15:27.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:27.00,0:15:29.00,Default,,0,0,0,,Жын шығарушы
Dialogue: 0,0:15:29.00,0:15:31.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:31.00,0:15:33.00,Default,,0,0,0,,Жын шығарушы
Dialogue: 0,0:15:33.00,0:15:35.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Жын шығарушы
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:39.00,0:15:41.00,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:15:41.00,0:15:43.00,Default,,0,0,0,,Ойланбай ішке кірді
Dialogue: 0,0:15:49.00,0:15:51.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:51.00,0:15:53.00,Default,,0,0,0,,Шексіз жарғанат
Dialogue: 0,0:15:59.00,0:16:01.00,Default,,0,0,0,,Кінәсіздік
Dialogue: 0,0:16:01.00,0:16:03.00,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Шексіз
Dialogue: 0,0:16:11.00,0:16:13.00,Default,,0,0,0,,Ең нашар болашақ
Dialogue: 0,0:16:15.00,0:16:17.00,Default,,0,0,0,,Теңіз
Dialogue: 0,0:16:17.00,0:16:19.00,Default,,0,0,0,,Әлем
Dialogue: 0,0:16:19.00,0:16:21.00,Default,,0,0,0,,Бірлік
Dialogue: 0,0:16:33.00,0:16:35.00,Default,,0,0,0,,Эй
Dialogue: 0,0:16:35.00,0:16:37.00,Default,,0,0,0,,Барьерлік құрылғының босату коды қандай?
Dialogue: 0,0:16:39.00,0:16:41.00,Default,,0,0,0,,Сіз менің артымнан жүрдіңіз бе?
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:16:43.00,0:16:45.00,Default,,0,0,0,,Тез жауап беріңіз
Dialogue: 0,0:16:45.00,0:16:47.00,Default,,0,0,0,,Өлімдерің бекер болғанын қаламасаң.
Dialogue: 0,0:16:49.00,0:16:51.00,Default,,0,0,0,,Үміт күт
Dialogue: 0,0:16:51.00,0:16:53.00,Default,,0,0,0,,Үміт сақта
Dialogue: 0,0:16:53.00,0:16:55.00,Default,,0,0,0,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:16:55.00,0:16:57.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:57.00,0:16:59.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:17:03.00,0:17:05.00,Default,,0,0,0,,Сен маған көмектесуге келдің.
Dialogue: 0,0:17:05.00,0:17:07.00,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:17:07.00,0:17:09.00,Default,,0,0,0,,Матер елесі
Dialogue: 0,0:17:29.00,0:17:31.00,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:17:31.00,0:17:33.00,Default,,0,0,0,,Тим Кэмпи
Dialogue: 0,0:17:35.00,0:17:37.00,Default,,0,0,0,,Камбал
Dialogue: 0,0:17:37.00,0:17:39.00,Default,,0,0,0,,Су/От
Dialogue: 0,0:17:39.00,0:17:53.00,Default,,0,0,0,,Фукутори
Dialogue: 0,0:17:53.00,0:17:55.00,Default,,0,0,0,,Шығыс Мадара
Dialogue: 0,0:17:57.00,0:17:59.00,Default,,0,0,0,,...
Dialogue: 0,0:17:59.00,0:18:01.00,Default,,0,0,0,,Тым күшті
Dialogue: 0,0:18:01.00,0:18:03.00,Default,,0,0,0,,Құрыш
Dialogue: 0,0:18:03.00,0:18:05.00,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:18:06.00,0:18:09.00,Default,,0,0,0,,Не? Ішкі жан дүниесі бұзылып барады.
Dialogue: 0,0:18:13.00,0:18:15.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:16.00,0:18:17.00,Default,,0,0,0,,Ібіліс!
Dialogue: 0,0:18:18.00,0:18:19.00,Default,,0,0,0,,Ол сөйледі!
Dialogue: 0,0:18:20.00,0:18:25.00,Default,,0,0,0,,Мен шайтанмын! Қараңғы материядан туған құдай!
Dialogue: 0,0:18:25.00,0:18:28.00,Default,,0,0,0,,Құшақтап алғаныңызға рахмет!
Dialogue: 0,0:18:28.00,0:18:30.00,Default,,0,0,0,,Деңгейді көтеру!
Dialogue: 0,0:18:31.00,0:18:35.00,Default,,0,0,0,,Жоқ... шайтан дамыды...
Dialogue: 0,0:18:35.00,0:18:37.00,Default,,0,0,0,,Гомит!
Dialogue: 0,0:18:37.00,0:18:38.00,Default,,0,0,0,,Тістеген!
Dialogue: 0,0:18:40.00,0:18:42.00,Default,,0,0,0,,Мен саған көмектеспеймін
Dialogue: 0,0:18:42.00,0:18:45.00,Default,,0,0,0,,Сезімге байланысты әрекет ету үшін сіз кінәлісіз
Dialogue: 0,0:18:45.00,0:18:47.00,Default,,0,0,0,,Өзіңіз бір нәрсені жасаңыз
Dialogue: 0,0:18:48.00,0:18:49.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:49.00,0:18:52.00,Default,,0,0,0,,Жазықсыз деп танылсаң, өлесің.
Dialogue: 0,0:18:52.00,0:18:55.00,Default,,0,0,0,,Өлесің, өлесің!
Dialogue: 0,0:18:55.00,0:18:56.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:56.00,0:19:00.00,Default,,0,0,0,,Өзіңіздің кінәсіздігіңіз өзіңізбен бірге екеніне сенімді бола аласыз.
Dialogue: 0,0:19:00.00,0:19:04.00,Default,,0,0,0,,Мен жынды құртамын, сосын оны қуамын.
Dialogue: 0,0:19:04.00,0:19:05.00,Default,,0,0,0,,Жою?
Dialogue: 0,0:19:06.00,0:19:08.00,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:19:10.00,0:19:12.00,Default,,0,0,0,,Томас, оған қара.
Dialogue: 0,0:19:12.00,0:19:14.00,Default,,0,0,0,,Жаяу жүргіншілер?
Dialogue: 0,0:19:14.00,0:19:15.00,Default,,0,0,0,,Сол шайтан
Dialogue: 0,0:19:16.00,0:19:17.00,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:20.00,0:19:22.00,Default,,0,0,0,,Ол жеңе алмайды
Dialogue: 0,0:19:22.00,0:19:24.00,Default,,0,0,0,,Ешқашан олай емес
Dialogue: 0,0:19:26.00,0:19:29.00,Default,,0,0,0,,Хехе, елес пайда болды ма?
Dialogue: 0,0:19:29.00,0:19:34.00,Default,,0,0,0,,Жарайды, мен сені кейін ұстаймын.
Dialogue: 0,0:19:34.00,0:19:38.00,Default,,0,0,0,,Алдымен мен сені өлтіремін.
Dialogue: 0,0:19:42.00,0:19:43.00,Default,,0,0,0,,Сені жеңетін менмін
Dialogue: 0,0:19:56.00,0:19:57.00,Default,,0,0,0,,Уау
Dialogue: 0,0:19:58.00,0:19:59.00,Default,,0,0,0,,Уау
Dialogue: 0,0:19:59.00,0:20:00.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:00.00,0:20:01.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:01.00,0:20:02.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:02.00,0:20:03.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:03.00,0:20:04.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:04.00,0:20:05.00,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:20:05.00,0:20:06.00,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:20:06.00,0:20:07.00,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:20:07.00,0:20:08.00,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:20:08.00,0:20:09.00,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:20:11.00,0:20:12.00,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:20:15.00,0:20:16.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:18.00,0:20:19.00,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:20:20.00,0:20:21.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:31.00,0:20:33.00,Default,,0,0,0,,Қан, бұл шайтан емес
Dialogue: 0,0:20:34.00,0:20:35.00,Default,,0,0,0,,Жалған?
Dialogue: 0,0:20:36.00,0:20:37.00,Default,,0,0,0,,осында
Dialogue: 0,0:20:38.00,0:20:40.00,Default,,0,0,0,,Какка!
Dialogue: 0,0:20:53.00,0:20:55.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Екі адам…
Dialogue: 0,0:21:08.00,0:21:11.00,Default,,0,0,0,,Махаббат үшін күрес
Dialogue: 0,0:21:25.00,0:21:30.00,Default,,0,0,0,,Еріннің қатуы
Dialogue: 0,0:21:31.00,0:21:36.00,Default,,0,0,0,,Екі адам, иық тірестіру
Dialogue: 0,0:21:36.00,0:21:49.00,Default,,0,0,0,,Сені көрген ең жақсы күн менің жадымда жасырылды.
Dialogue: 0,0:21:49.00,0:22:02.00,Default,,0,0,0,,Сол керемет көрініске көлде серуендеу
Dialogue: 0,0:22:02.00,0:22:13.00,Default,,0,0,0,,Қар сүйісі Менімен бұлай қоштаспа
Dialogue: 0,0:22:14.00,0:22:22.00,Default,,0,0,0,,Сезімге шыдай алмаған күн
Dialogue: 0,0:22:23.00,0:22:28.00,Default,,0,0,0,,Өшірме Өшірме
Dialogue: 0,0:22:33.00,0:22:38.00,Default,,0,0,0,,Ібіліс Финдердің өмірін тамақ ретінде пайдаланады және қорқынышты эволюцияға ұшырайды.
Dialogue: 0,0:22:38.00,0:22:41.00,Default,,0,0,0,,Суретке түсіру қабілетін алған осы шайтан арқылы
Dialogue: 0,0:22:41.00,0:22:44.00,Default,,0,0,0,,Бізді бұрышқа айдады
Dialogue: 0,0:22:44.00,0:22:46.00,Default,,0,0,0,,Келесі жолы ДГреймон
Dialogue: 0,0:22:46.00,0:22:48.00,Default,,0,0,0,,Әкесі Кира мен Куяның Арианы
Dialogue: 0,0:22:48.00,0:22:51.00,Default,,0,0,0,,Бейшара шайтанның жанын құтқару
Dialogue: 0,0:22:52.50,0:22:58.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory