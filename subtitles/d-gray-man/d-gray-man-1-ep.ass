Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.00,0:00:38.00,Default,,0,0,0,,Мен сенің соңғы дауысыңды да естімеймін
Dialogue: 0,0:00:39.00,0:00:44.00,Default,,0,0,0,,Бұл жолы мен сені қатты құшақтап алсам, үзіліп кететін сияқтымын
Dialogue: 0,0:00:44.00,0:00:48.00,Default,,0,0,0,,Сен қалтырап тұрдың
Dialogue: 0,0:00:49.00,0:00:57.00,Default,,0,0,0,,Ақырын ұстап тұрғанда алақаныңызға тиюге рұқсат етіңіз
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,Сіз оны іздегеніңізге сенімдімін.
Dialogue: 0,0:01:01.00,0:01:07.00,Default,,0,0,0,,Ешқашан өшпейтінің қандай керемет
Dialogue: 0,0:01:08.00,0:01:16.00,Default,,0,0,0,,Маған алақаныңызбен қаттырақ тигізіңіз
Dialogue: 0,0:01:17.00,0:01:22.00,Default,,0,0,0,,Егер мен ешқашан бітпесем
Dialogue: 0,0:01:22.00,0:01:28.00,Default,,0,0,0,,Шығарылым Келесі
Dialogue: 0,0:01:34.00,0:01:36.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:01:36.00,0:01:40.00,Default,,0,0,0,,Құдай көргендер
Dialogue: 0,0:01:41.00,0:01:45.00,Default,,0,0,0,,Олар қараңғылықтан шығады
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Тәкаппар
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Жерлеуге арналған
Dialogue: 0,0:02:10.00,0:02:14.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:02:14.00,0:02:18.00,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Тим Кэмпи
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Тим Кэмпи
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Көп секірмеңіз
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Сізді мысық жеп қояды
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Қаласаң жегің келе ме?
Dialogue: 0,0:02:49.00,0:02:51.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:52.00,0:02:53.00,Default,,0,0,0,,Саяхаттау?
Dialogue: 0,0:02:53.00,0:02:57.00,Default,,0,0,0,,Жоқ, мен жай ғана сәлем берейін деп жатырмын.
Dialogue: 0,0:02:57.00,0:03:00.00,Default,,0,0,0,,Эксорцист негізгі бөлігі
Dialogue: 0,0:03:00.00,0:03:04.00,Default,,0,0,0,,Эксорцист негізгі бөлім
Dialogue: 0,0:03:06.00,0:03:07.00,Default,,0,0,0,,Эй, сен білесің бе?
Dialogue: 0,0:03:07.00,0:03:10.00,Default,,0,0,0,,Мұнда көптеген адамдар жоғалып кетті.
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Өйткені ол қазір қолданылмайды
Dialogue: 0,0:03:12.00,0:03:15.00,Default,,0,0,0,,Ақшасы жоқ саяхатшылар осында жиі қалады.
Dialogue: 0,0:03:15.00,0:03:18.00,Default,,0,0,0,,Таң атқанда саяхатшы кетіп қалды.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Тек киім қалды
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:03:22.00,0:03:25.00,Default,,0,0,0,,Өйткені соңғы екі жылда да
Dialogue: 0,0:03:25.00,0:03:28.00,Default,,0,0,0,,Толығырақ Сіз шынымен кіресіз бе?
Dialogue: 0,0:03:28.00,0:03:31.00,Default,,0,0,0,,Маған қала тұрғындарының арыз-шағымдары толып жатыр.
Dialogue: 0,0:03:31.00,0:03:34.00,Default,,0,0,0,,Неліктен адамдар бұл жерде жоғалып жатыр?
Dialogue: 0,0:03:34.00,0:03:37.00,Default,,0,0,0,,Сондықтан қарғысқа ұшырадым дейсің
Dialogue: 0,0:03:37.00,0:03:41.00,Default,,0,0,0,,Жарлар Бұл полицейдің шені ме?
Dialogue: 0,0:03:42.00,0:03:45.00,Default,,0,0,0,,Біреу таратқан жиіркенішті өсек.
Dialogue: 0,0:03:45.00,0:03:48.00,Default,,0,0,0,,Бұл жер қарғыс емес.
Dialogue: 0,0:03:49.00,0:03:50.00,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Осымен бітті.
Dialogue: 0,0:03:57.00,0:04:01.00,Default,,0,0,0,,Саяхатшылар шынымен де осындай жерде тұра ма?
Dialogue: 0,0:04:04.00,0:04:06.00,Default,,0,0,0,,Ашидзи
Dialogue: 0,0:04:09.00,0:04:10.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:16.00,0:04:17.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:19.00,0:04:20.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:20.00,0:04:21.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:21.00,0:04:22.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:22.00,0:04:23.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:23.00,0:04:24.00,Default,,0,0,0,,мысық
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,Жақсысың ба, Моа?
Dialogue: 0,0:04:35.00,0:04:36.00,Default,,0,0,0,,Қосымша
Dialogue: 0,0:04:43.00,0:04:44.00,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:04:44.00,0:04:46.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.00,0:04:51.00,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:04:55.00,0:04:56.00,Default,,0,0,0,,, адам?
Dialogue: 0,0:04:57.00,0:04:58.00,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:05:00.00,0:05:01.00,Default,,0,0,0,,Бұл жігіт жақсы
Dialogue: 0,0:05:02.00,0:05:03.00,Default,,0,0,0,,Ал полиция қызметкері?
Dialogue: 0,0:05:03.00,0:05:04.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:06.00,0:05:08.00,Default,,0,0,0,,Соған берілгенім сонша, байқамай қалдым.
Dialogue: 0,0:05:08.00,0:05:11.00,Default,,0,0,0,,Мен сені ұстайын деп едім.
Dialogue: 0,0:05:11.00,0:05:12.00,Default,,0,0,0,,мысық
Dialogue: 0,0:05:14.00,0:05:17.00,Default,,0,0,0,,Ал, мен жай саяхатшымын.
Dialogue: 0,0:05:19.00,0:05:23.00,Default,,0,0,0,,А-а, осында сондай алаңдатарлық өсек болды ма?
Dialogue: 0,0:05:24.00,0:05:26.00,Default,,0,0,0,,Мен бүгін түнде осы қалаға келдім.
Dialogue: 0,0:05:27.00,0:05:28.00,Default,,0,0,0,,Мен өтіп бара жатқанда
Dialogue: 0,0:05:29.00,0:05:31.00,Default,,0,0,0,,Қаңғыбас мысық мен үшін маңызды нәрсені жеп қойды.
Dialogue: 0,0:05:31.00,0:05:33.00,Default,,0,0,0,,Мен көптен бері қарап жүрмін.
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,О, бұл рас!
Dialogue: 0,0:05:36.00,0:05:40.00,Default,,0,0,0,,Бұл менің қожайынымның маған аманат еткені, сондықтан мен оны жоғалтып алмаймын!
Dialogue: 0,0:05:40.00,0:05:41.00,Default,,0,0,0,,Мастер?
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Адам қайда?
Dialogue: 0,0:05:43.00,0:05:45.50,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:44.00,0:05:47.00,Default,,0,0,0,,Жоқ, ол Үндістанда жоғалып кетті.
Dialogue: 0,0:05:49.00,0:05:51.00,Default,,0,0,0,,Бұл сен кінәлі!
Dialogue: 0,0:05:52.00,0:05:55.00,Default,,0,0,0,,О, мен әлі бала емеспін.
Dialogue: 0,0:05:55.00,0:05:59.00,Default,,0,0,0,,Қалай болғанда да, мен әріптесімді әкелгенше күте тұрыңыз.
Dialogue: 0,0:06:03.00,0:06:05.00,Default,,0,0,0,,Не, не, не?
Dialogue: 0,0:06:06.00,0:06:07.00,Default,,0,0,0,,Сен осында қал!
Dialogue: 0,0:06:12.00,0:06:13.00,Default,,0,0,0,,Е, бұл кім!
Dialogue: 0,0:06:26.00,0:06:28.00,Default,,0,0,0,,Джарлиц!
Dialogue: 0,0:06:41.00,0:06:46.00,Default,,0,0,0,,Әйтеуір, бұл қауесеттер рас...
Dialogue: 0,0:06:49.00,0:06:51.00,Default,,0,0,0,,А, мен қатты ренжідім!
Dialogue: 0,0:06:57.00,0:07:00.00,Default,,0,0,0,,Абайлаңыз, бұл газ улы
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Оны шайтан өлтірді
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,Әй, шайтан?
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Сәлем, офицер!
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,О, Моа, байқадың ба?
Dialogue: 0,0:07:21.00,0:07:22.00,Default,,0,0,0,,О, міне...
Dialogue: 0,0:07:22.00,0:07:23.00,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,0:07:24.00,0:07:27.00,Default,,0,0,0,,Инспектор, Мор мырза байқады.
Dialogue: 0,0:07:27.00,0:07:28.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:31.00,0:07:33.00,Default,,0,0,0,,Дұрыс, сәл күте тұрыңыз.
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Иә, Чарльз...
Dialogue: 0,0:07:36.00,0:07:37.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:37.00,0:07:40.00,Default,,0,0,0,,Біз қазір күдіктіден жауап алып жатырмыз.
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0,0,0,,Сіздің атыңыз Аллен Гор ба?
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Мен мұны істеген жоқпын!
Dialogue: 0,0:07:52.00,0:07:53.00,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:07:53.00,0:07:57.00,Default,,0,0,0,,Мен мұнда ес-түссіз жатқан полиция қызметкерін әкелдім.
Dialogue: 0,0:07:57.00,0:08:00.00,Default,,0,0,0,,Сіз сонда болуыңыз керек еді!
Dialogue: 0,0:08:00.00,0:08:01.00,Default,,0,0,0,,Аяқтар!
Dialogue: 0,0:08:01.00,0:08:04.00,Default,,0,0,0,,Оның үстіне бұл қимыл жиіркенішті емес пе?
Dialogue: 0,0:08:04.00,0:08:07.00,Default,,0,0,0,,Жоқ, бұл бастапқыда...
Dialogue: 0,0:08:10.00,0:08:12.00,Default,,0,0,0,,Не, бұл не?
Dialogue: 0,0:08:12.00,0:08:15.00,Default,,0,0,0,,Қолыңда не бар?
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Сіз шынымен ашулы болуыңыз керек.
Dialogue: 0,0:08:20.00,0:08:23.00,Default,,0,0,0,,Сен оны ата-анаңнан алдың, сондықтан қамқор бол.
Dialogue: 0,0:08:23.00,0:08:24.00,Default,,0,0,0,,О, мм...
Dialogue: 0,0:08:26.00,0:08:30.00,Default,,0,0,0,,Бұл бала оқиға болғанша онымен бірге өлгісі келмеді.
Dialogue: 0,0:08:30.00,0:08:31.00,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:08:31.00,0:08:38.00,Default,,0,0,0,,Инспектор, оқиға орнында өте үлкен жануар қаруының қалдықтары бар.
Dialogue: 0,0:08:38.00,0:08:44.00,Default,,0,0,0,,Алайда баланың жалғыз заттары мысық пен кішкентай сандық болды.
Dialogue: 0,0:08:44.00,0:08:49.00,Default,,0,0,0,,Әзірге оқиға орнынан жануарларға арналған мұндай қару табылмады.
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Неліктен есінен танып қалдың?
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Қазірдің өзінде, Гессежун мырза!
Dialogue: 0,0:08:55.00,0:08:57.00,Default,,0,0,0,,Мен де кешірім сұраймын.
Dialogue: 0,0:08:57.00,0:09:00.00,Default,,0,0,0,,Оқиға орнында болған кезде қылмыскерді көру мүмкін емес.
Dialogue: 0,0:09:00.00,0:09:03.00,Default,,0,0,0,,Мм, мен қылмыскерді білемін.
Dialogue: 0,0:09:04.00,0:09:08.00,Default,,0,0,0,,Мен оны көрмедім, бірақ оның қандай екенін білемін.
Dialogue: 0,0:09:08.00,0:09:11.00,Default,,0,0,0,,Тергеумен ынтымақтасуыңызды сұраймыз.
Dialogue: 0,0:09:11.00,0:09:13.00,Default,,0,0,0,,Қылмыскердің аты шайтан
Dialogue: 0,0:09:14.00,0:09:17.00,Default,,0,0,0,,Қызметіме байланысты мен жиі кездесіп тұрамын
Dialogue: 0,0:09:17.00,0:09:19.00,Default,,0,0,0,,Адамдарды өлтіру
Dialogue: 0,0:09:19.00,0:09:23.00,Default,,0,0,0,,Тез тоқтатпасаң, қуып жете алмайсың.
Dialogue: 0,0:09:23.00,0:09:25.00,Default,,0,0,0,,Бұл шайтанға қарсы қару
Dialogue: 0,0:09:25.00,0:09:28.00,Default,,0,0,0,,Сіз жын шығарушының не екенін білесіз бе?
Dialogue: 0,0:09:28.00,0:09:33.00,Default,,0,0,0,,Мен шайтан елшілеріне маманданған батыл адаммын.
Dialogue: 0,0:09:43.00,0:09:45.00,Default,,0,0,0,,Эксорцист?
Dialogue: 0,0:09:45.00,0:09:47.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:47.00,0:09:49.00,Default,,0,0,0,,Жетер, сен
Dialogue: 0,0:09:49.00,0:09:51.00,Default,,0,0,0,,Әзірге тамақтанғаннан кейін
Dialogue: 0,0:09:51.00,0:09:53.00,Default,,0,0,0,,Мен оқиға орнына қайтамын
Dialogue: 0,0:09:53.00,0:09:55.00,Default,,0,0,0,,Оджунса!
Dialogue: 0,0:09:55.00,0:09:58.00,Default,,0,0,0,,Үйде мына жігітті бақылап отырсың!
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Олар полицейдің өлгенін айтты.
Dialogue: 0,0:10:04.00,0:10:07.00,Default,,0,0,0,,Хиди риза болғанға ұқсайды.
Dialogue: 0,0:10:07.00,0:10:10.00,Default,,0,0,0,,Мына кемпір кім?
Dialogue: 0,0:10:10.00,0:10:13.00,Default,,0,0,0,,Сіз кінәлі адамның аты болдыңыз ба?
Dialogue: 0,0:10:13.00,0:10:16.00,Default,,0,0,0,,Хиди риза болған сияқты.
Dialogue: 0,0:10:16.00,0:10:19.00,Default,,0,0,0,,Әлгі кемпір шын айтты.
Dialogue: 0,0:10:19.00,0:10:21.00,Default,,0,0,0,,Мен бір нәрсеге әуестеніп кеттім.
Dialogue: 0,0:10:21.00,0:10:24.00,Default,,0,0,0,,Мұнда не болды?
Dialogue: 0,0:10:24.00,0:10:29.00,Default,,0,0,0,,Осыдан екі жыл бұрын осында жаңа ғана шаңырақ көтерген ерлі-зайыптылар апатқа ұшырады.
Dialogue: 0,0:10:29.00,0:10:35.00,Default,,0,0,0,,Менің сүйкімді кішкентай шайтаным, даму үшін көбірек өлтір.
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,Аға?
Dialogue: 0,0:10:37.00,0:10:39.00,Default,,0,0,0,,Мен үйдемін, аға.
Dialogue: 0,0:10:39.00,0:10:41.00,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:43.00,0:10:46.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Көбірек
Dialogue: 0,0:10:46.00,0:10:49.00,Default,,0,0,0,,Бүгін мен қайтып келдім.
Dialogue: 0,0:10:49.00,0:10:52.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Көбірек
Dialogue: 0,0:10:52.00,0:10:55.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Көбірек
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Көбірек
Dialogue: 0,0:10:57.00,0:11:01.00,Default,,0,0,0,,Бүгін үйге баруға әлі ерте.
Dialogue: 0,0:11:01.00,0:11:05.00,Default,,0,0,0,,Бауырым, соңғы кездері мүлде тамақ ішпейсің.
Dialogue: 0,0:11:05.00,0:11:08.00,Default,,0,0,0,,Жоқ, мен дұрыс тамақтануым керек.
Dialogue: 0,0:11:09.00,0:11:12.00,Default,,0,0,0,,Мен тойдым
Dialogue: 0,0:11:12.00,0:11:15.00,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:11:15.00,0:11:19.00,Default,,0,0,0,,Бірақ ол тез азаяды
Dialogue: 0,0:11:21.00,0:11:24.00,Default,,0,0,0,,Сәттілік, Марк-ниисан
Dialogue: 0,0:11:24.00,0:11:28.00,Default,,0,0,0,,Көктегі әпкем де солай үміттенеді.
Dialogue: 0,0:11:28.00,0:11:31.00,Default,,0,0,0,,Мен әшкереленуден қорқамын.
Dialogue: 0,0:11:35.00,0:11:38.00,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Мен сені оқиға орнына бара жатырмын деп ойладым.
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:11:42.00,0:11:44.00,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:11:44.00,0:11:48.00,Default,,0,0,0,,Менің алдымда тұрса да, инспектор, жақсысың ба?
Dialogue: 0,0:11:48.00,0:11:52.00,Default,,0,0,0,,Аллен мырза, сіз шынымен кінәлі шайтан деп ойлайсыз ба?
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:11:54.00,0:12:02.00,Default,,0,0,0,,Ібіліс – ертедегі адамдардың ауру мен апаттан қорқып жасаған ойдан шығарылған кейіпкері.
Dialogue: 0,0:12:02.00,0:12:05.00,Default,,0,0,0,,Мен қарғыс атқан жындарды білмеймін
Dialogue: 0,0:12:05.00,0:12:07.00,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:12:07.00,0:12:11.00,Default,,0,0,0,,Жарайды, бұл мен айтып отырған шайтан емес.
Dialogue: 0,0:12:11.00,0:12:13.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:12:13.00,0:12:16.00,Default,,0,0,0,,Ібіліс – қарудың аты
Dialogue: 0,0:12:16.00,0:12:22.00,Default,,0,0,0,,Адамзатты нысанаға алу үшін жасалған зұлым қару – шайтан.
Dialogue: 0,0:12:22.00,0:12:27.00,Default,,0,0,0,,Әдетте адам кейпіне енетіндіктен, адамзатқа қару жасайтын шайтан.
Dialogue: 0,0:12:27.00,0:12:31.00,Default,,0,0,0,,Ібіліс – адамзат қаруының аты
Dialogue: 0,0:12:31.00,0:12:34.00,Default,,0,0,0,,Марк-нии-сан, не болды?
Dialogue: 0,0:13:01.00,0:13:04.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:31.00,0:13:34.00,Default,,0,0,0,,Амансыз ба, Мор мырза?
Dialogue: 0,0:13:34.00,0:13:37.00,Default,,0,0,0,,Міне, қайда?
Dialogue: 0,0:13:37.00,0:13:40.00,Default,,0,0,0,,Мукай жоқ Кьюкай
Dialogue: 0,0:13:40.00,0:13:44.00,Default,,0,0,0,,Өтірік, оқты ұстадың ба?
Dialogue: 0,0:13:44.00,0:13:48.00,Default,,0,0,0,,Тиме, бұл шайтанның оғы
Dialogue: 0,0:13:48.00,0:13:52.00,Default,,0,0,0,,Бұл оқтың құрамында улы вирус бар
Dialogue: 0,0:13:52.00,0:13:58.00,Default,,0,0,0,,Ібіліс өз денесін аң қаруына айналдырып, бұл оқты ұстай алады.
Dialogue: 0,0:13:58.00,0:14:02.00,Default,,0,0,0,,Вирус ағзаға тез енеді
Dialogue: 0,0:14:05.00,0:14:08.00,Default,,0,0,0,,Сізге көмектесе алмағаным үшін кешіріңіз.
Dialogue: 0,0:14:11.00,0:14:14.00,Default,,0,0,0,,Маркқа не болды?
Dialogue: 0,0:14:14.00,0:14:19.00,Default,,0,0,0,,Мор мырза, жындар адам мәйітін киіп қоғамға енеді.
Dialogue: 0,0:14:19.00,0:14:22.00,Default,,0,0,0,,Бұл Марк емес.
Dialogue: 0,0:14:22.00,0:14:25.00,Default,,0,0,0,,Сіздің ағаңыз өлтірілді ме?
Dialogue: 0,0:14:25.00,0:14:27.00,Default,,0,0,0,,келді
Dialogue: 0,0:14:31.00,0:14:34.00,Default,,0,0,0,,Эй, балалар мұнда не істеп жүрсіңдер?
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Инспектор!
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:42.00,0:14:44.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:44.00,0:14:46.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:46.00,0:14:48.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:48.00,0:14:50.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:50.00,0:14:52.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Мылтық жақсы емес!
Dialogue: 0,0:14:55.00,0:14:57.00,Default,,0,0,0,,Қаш!
Dialogue: 0,0:14:59.00,0:15:01.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:15:11.00,0:15:15.00,Default,,0,0,0,,Инспектор, барлығы.
Dialogue: 0,0:15:18.00,0:15:22.00,Default,,0,0,0,,Бұл құбыжықты не үшін өлтіресің? Неліктен?
Dialogue: 0,0:15:22.00,0:15:24.00,Default,,0,0,0,,Айтқаннан пайда жоқ
Dialogue: 0,0:15:24.00,0:15:27.00,Default,,0,0,0,,Мор мырза, мен мұны қалағаным үшін істеп жатқан жоқпын.
Dialogue: 0,0:15:27.00,0:15:31.00,Default,,0,0,0,,Ол қару ретінде дамуға бағдарламаланған.
Dialogue: 0,0:15:31.00,0:15:33.00,Default,,0,0,0,,Бұл жай ғана өлтіретін машина!
Dialogue: 0,0:15:33.00,0:15:35.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:35.00,0:15:39.00,Default,,0,0,0,,Ібіліс ішінде жаны бар тірі қару.
Dialogue: 0,0:15:39.00,0:15:43.00,Default,,0,0,0,,Оның жаны өз өндірушісінің бақылауында және күнәдан азап шегеді.
Dialogue: 0,0:15:43.00,0:15:47.00,Default,,0,0,0,,Өзінің сыртқы түрінен үмітін үзу және шындықты жасау
Dialogue: 0,0:15:47.00,0:15:54.00,Default,,0,0,0,,Жанның ашуы жынның дамуына мүмкіндік беретін қуат көзіне айналады.
Dialogue: 0,0:15:56.00,0:16:00.00,Default,,0,0,0,,Ол шайтанда да біреудің жаны бар.
Dialogue: 0,0:16:00.00,0:16:05.00,Default,,0,0,0,,Ол Маркпен өте жақын қарым-қатынаста болса керек.
Dialogue: 0,0:16:06.00,0:16:12.00,Default,,0,0,0,,Жындар машиналардан, жандардан және трагедиядан жасалған.
Dialogue: 0,0:16:12.00,0:16:16.00,Default,,0,0,0,,Әр адамның жүрегінде қараңғылық бар.
Dialogue: 0,0:16:16.00,0:16:23.00,Default,,0,0,0,,Қайғы-қасірет салдарынан қараңғылығы тереңдей түскендерге жаратушы пайда болып, шайтанды қуады.
Dialogue: 0,0:16:23.00,0:16:25.00,Default,,0,0,0,,Трагедия?
Dialogue: 0,0:16:25.00,0:16:27.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.00,0:16:35.00,Default,,0,0,0,,Сіз әлі де Моамен соғысып жатырсыз ба?
Dialogue: 0,0:16:35.00,0:16:40.00,Default,,0,0,0,,Өйткені мен полиция қызметкері болуға қарсымын.
Dialogue: 0,0:16:40.00,0:16:45.00,Default,,0,0,0,,Мен әкем мен шешемді өлтірген адамды ұстағым келеді.
Dialogue: 0,0:16:45.00,0:16:51.00,Default,,0,0,0,,Клэр, Моа кек алу үшін полиция болған жоқ.
Dialogue: 0,0:16:51.00,0:16:55.00,Default,,0,0,0,,Шамасы, ол бізді мәңгі бақытты өмір сүруіміз үшін қорғағысы келеді.
Dialogue: 0,0:16:57.00,0:17:02.00,Default,,0,0,0,,Мордың сезіміне және Құдайдың шешіміне сенейік
Dialogue: 0,0:17:02.00,0:17:06.00,Default,,0,0,0,,Алла иман келтіргендерге опасыздық жасамайды
Dialogue: 0,0:17:08.00,0:17:11.00,Default,,0,0,0,,Иә, мен сенемін.
Dialogue: 0,0:17:21.00,0:17:23.00,Default,,0,0,0,,Апа
Dialogue: 0,0:17:24.00,0:17:27.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:17:32.00,0:17:35.00,Default,,0,0,0,,Иә, қайырлы кеш.
Dialogue: 0,0:17:35.00,0:17:38.00,Default,,0,0,0,,Бұл мен жасаған сиқырлы дене.
Dialogue: 0,0:17:38.00,0:17:41.00,Default,,0,0,0,,Жандарды қолға түсіріп, тірілт
Dialogue: 0,0:17:41.00,0:17:45.00,Default,,0,0,0,,Мен Клэрді ет сақалынан қайтарамын.
Dialogue: 0,0:17:45.00,0:17:49.00,Default,,0,0,0,,Ол үшін маған сіздің ынтымақтастығыңыз қажет.
Dialogue: 0,0:17:49.00,0:17:53.00,Default,,0,0,0,,Клэрмен қарым-қатынасыңыздың шақыруы
Dialogue: 0,0:17:53.00,0:17:57.00,Default,,0,0,0,,Клэрдің жанын еске түсіруге болады
Dialogue: 0,0:18:04.00,0:18:07.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:18:12.00,0:18:13.00,Default,,0,0,0,,Белгі
Dialogue: 0,0:18:13.00,0:18:14.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Неге мені шайтан қылдың?
Dialogue: 0,0:18:18.00,0:18:20.00,Default,,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,0:18:20.00,0:18:22.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:18:22.00,0:18:25.00,Default,,0,0,0,,Сен енді менікісің.
Dialogue: 0,0:18:25.00,0:18:27.00,Default,,0,0,0,,Пәрмен
Dialogue: 0,0:18:27.00,0:18:30.00,Default,,0,0,0,,Мына кісіні өлтіріп, өлтір.
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:18:47.00,0:18:52.00,Default,,0,0,0,,Туған күніңмен, Воила!
Dialogue: 0,0:18:56.00,0:18:59.00,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:18:59.00,0:19:02.00,Default,,0,0,0,,Бұл Клэр әпкесі.
Dialogue: 0,0:19:12.00,0:19:14.00,Default,,0,0,0,,Менде тұратын Қасиетті Кроче
Dialogue: 0,0:19:14.00,0:19:18.00,Default,,0,0,0,,Енді қараңғылықты жою күші
Dialogue: 0,0:19:24.00,0:19:28.00,Default,,0,0,0,,Бейшара шайтанның жанын құтқару
Dialogue: 0,0:19:29.00,0:19:31.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:35.00,0:19:37.00,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:19:37.00,0:19:40.00,Default,,0,0,0,,Мен сізге қазір жеңілдетемін.
Dialogue: 0,0:19:40.00,0:19:44.00,Default,,0,0,0,,Тыныш жатуыңызды өтінемін.
Dialogue: 0,0:19:59.00,0:20:01.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0,0,0,,Біз көкте біртұтаспыз, солай емес пе?
Dialogue: 0,0:20:15.00,0:20:18.00,Default,,0,0,0,,Клэр апа мен Марк аға
Dialogue: 0,0:20:18.00,0:20:21.00,Default,,0,0,0,,Иә, мен сенімдімін
Dialogue: 0,0:20:24.00,0:20:26.00,Default,,0,0,0,,Мыңжылдық ақ тас
Dialogue: 0,0:20:26.00,0:20:28.00,Default,,0,0,0,,Өндіруші осылай атайды
Dialogue: 0,0:20:28.00,0:20:33.00,Default,,0,0,0,,Ол қазір адамзаттың аяқталу сценарийін орындауда.
Dialogue: 0,0:20:34.00,0:20:38.00,Default,,0,0,0,,Оған нүкте қою - жын шығарушының міндеті.
Dialogue: 0,0:20:45.00,0:20:48.00,Default,,0,0,0,,Кеттік, Тимкемпи.
Dialogue: 0,0:20:56.00,0:21:00.00,Default,,0,0,0,,Таң
Dialogue: 0,0:21:01.00,0:21:05.00,Default,,0,0,0,,(Куними) Эй, Сакута, ұйықтап қалған соң шашың бүлініп қалыпты.
Dialogue: 0,0:21:07.00,0:21:10.00,Default,,0,0,0,,Түнгі жорғалау
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Түнгі жорғалау
Dialogue: 0,0:21:25.00,0:21:29.00,Default,,0,0,0,,Тоңған ернімді тістеп
Dialogue: 0,0:21:31.00,0:21:35.00,Default,,0,0,0,,Екі адам, бұрыштан бұрышқа
Dialogue: 0,0:21:36.00,0:21:41.00,Default,,0,0,0,,Мен сені көрген ең жақсы күн
Dialogue: 0,0:21:42.00,0:21:47.00,Default,,0,0,0,,Жадтың тереңінде жасырылған
Dialogue: 0,0:21:49.00,0:21:55.00,Default,,0,0,0,,Көлде
Dialogue: 0,0:21:55.00,0:21:59.00,Default,,0,0,0,,Сіз жаяу жүрсіз бе?
Dialogue: 0,0:21:59.00,0:22:01.00,Default,,0,0,0,,Керемет көріністер
Dialogue: 0,0:22:01.00,0:22:04.00,Default,,0,0,0,,Қар сүйісі
Dialogue: 0,0:22:04.00,0:22:07.00,Default,,0,0,0,,Сізбен де солай
Dialogue: 0,0:22:07.00,0:22:12.00,Default,,0,0,0,,Мені Лумпай деп атама
Dialogue: 0,0:22:13.00,0:22:18.00,Default,,0,0,0,,Махаббат, ауырсыну, сезімдер т.б.
Dialogue: 0,0:22:18.00,0:22:22.00,Default,,0,0,0,,Жоюға болмайтын тыртықтар
Dialogue: 0,0:22:22.00,0:22:25.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:25.00,0:22:28.00,Default,,0,0,0,,Өшірмеңіз
Dialogue: 0,0:22:32.00,0:22:34.00,Default,,0,0,0,,Қалаған орын
