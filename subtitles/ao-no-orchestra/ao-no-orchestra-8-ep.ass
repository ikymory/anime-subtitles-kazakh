Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.04,0:00:21.24,Default,,0,0,0,,(Рицуко Акине)
Dialogue: 0,0:00:31.09,0:00:33.12,Default,,0,0,0,,Уф…!
Dialogue: 0,0:00:33.12,0:00:37.43,Default,,0,0,0,,Хехе, неткен қызық жүз! Джой жақсы өсіп келеді
Dialogue: 0,0:00:37.43,0:00:39.46,Default,,0,0,0,,(ﾉｯｸ)
Dialogue: 0,0:00:39.46,0:00:42.93,Default,,0,0,0,,Халл? Мен кіремін.
Dialogue: 0,0:00:42.93,0:00:45.97,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Ал безгегі туралы не деуге болады?
Dialogue: 0,0:00:45.97,0:00:50.10,Default,,0,0,0,,Жарайды... Әлі де аздап қызуым бар...
Dialogue: 0,0:00:50.10,0:00:52.94,Default,,0,0,0,,Иә. Сіздің тәбетіңіз қалай?
Dialogue: 0,0:00:52.94,0:00:54.98,Default,,0,0,0,,Бірдеңе жегіңіз келе ме?
Dialogue: 0,0:00:54.98,0:00:57.45,Default,,0,0,0,,Менде болса, анам сатып алар еді.
Dialogue: 0,0:00:57.45,0:01:02.25,Default,,0,0,0,,Қажет емес! Ұйықтағанша, бәрі жақсы болады...
Dialogue: 0,0:01:04.05,0:01:07.92,Default,,0,0,0,,Мен түсіндім. Мама бүгін үйде➡
Dialogue: 0,0:01:07.92,0:01:10.72,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған қоңырау шалыңыз.
Dialogue: 0,0:01:14.56,0:01:16.56,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:01:16.56,0:01:19.07,Default,,0,0,0,,(термометр дыбысы)
Dialogue: 0,0:01:19.07,0:01:22.10,Default,,0,0,0,,<Анашым...➡
Dialogue: 0,0:01:22.10,0:01:25.10,Default,,0,0,0,,Білсем де...>
Dialogue: 0,0:01:26.94,0:01:57.27,Default,,0,0,0,,♬～
Dialogue: 0,0:01:57.27,0:02:06.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:06.95,0:02:15.65,Default,,0,0,0,,♬～
Dialogue: 0,0:02:19.06,0:02:26.86,Default,,0,0,0,,♬～
Dialogue: 0,0:02:30.57,0:02:34.08,Default,,0,0,0,,♬～
Dialogue: 0,0:02:34.08,0:02:36.91,Default,,0,0,0,,♬～
Dialogue: 0,0:02:36.91,0:02:47.92,Default,,0,0,0,,♬～
Dialogue: 0,0:02:47.92,0:02:55.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:57.60,0:03:04.04,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:03:04.04,0:03:08.88,Default,,0,0,0,,<Анашым... Орта мектепте бірдеңе болып жатқанына сенімдімін➡
Dialogue: 0,0:03:08.88,0:03:13.21,Default,,0,0,0,,Сен маған айта алмайсың...｡➡
Dialogue: 0,0:03:13.21,0:03:16.88,Default,,0,0,0,,Сол күннен бастап...➡
Dialogue: 0,0:03:16.88,0:03:22.39,Default,,0,0,0,,Сыныпқа барсам, маған орын болмай ма деп қорқамын➡
Dialogue: 0,0:03:22.39,0:03:29.90,Default,,0,0,0,,Ол жерде болмауы керек балалар бар ма екен...➡
Dialogue: 0,0:03:29.90,0:03:36.90,Default,,0,0,0,,Айналдыра келе, жағымсыз нәрселерді ойлай берем>
Dialogue: 0,0:03:43.44,0:03:46.71,Default,,0,0,0,,Менің ішім ауыра бастады...
Dialogue: 0,0:03:46.71,0:03:48.71,Default,,0,0,0,,[Сымсыз] (Хабар рингтоны)
Dialogue: 0,0:03:56.46,0:03:59.26,Default,,0,0,0,,Риччан...
Dialogue: 0,0:04:07.54,0:04:10.24,Default,,0,0,0,,Менің өтірікшім...
Dialogue: 0,0:04:11.87,0:04:14.54,Default,,0,0,0,,<«Жарайды»➡
Dialogue: 0,0:04:14.54,0:04:20.04,Default,,0,0,0,,Бұл мен үшін ертеден келе жатқан қара сөз>
Dialogue: 0,0:04:21.68,0:04:23.98,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:32.06,0:04:36.56,Default,,0,0,0,,...
Dialogue: 0,0:04:36.56,0:04:41.90,Default,,0,0,0,,Негізі қорқамын, шыдай алмаймын...｡➡
Dialogue: 0,0:04:41.90,0:04:47.24,Default,,0,0,0,,Бірақ... Мен мұны ешқашан айта алмаймын.➡
Dialogue: 0,0:04:47.24,0:04:50.14,Default,,0,0,0,,Өйткені мен…➡
Dialogue: 0,0:04:50.14,0:04:54.72,Default,,0,0,0,,Мен Риччанның мейірімді екенін білемін>
Dialogue: 0,0:04:54.72,0:04:59.92,Default,,0,0,0,,♬～
Dialogue: 0,0:04:59.92,0:05:07.19,Default,,0,0,0,,<Себебі мен білемін, сондықтан мен...➡
Dialogue: 0,0:05:07.19,0:05:11.37,Default,,0,0,0,,Сол кездегідей➡
Dialogue: 0,0:05:11.37,0:05:18.54,Default,,0,0,0,,Мені Риччан бұзды...➡
Dialogue: 0,0:05:18.54,0:05:21.34,Default,,0,0,0,,Ең қорқыныштысы>
Dialogue: 0,0:05:27.25,0:05:30.15,Default,,0,0,0,,Келмейді~ Жауап
Dialogue: 0,0:05:30.15,0:05:33.05,Default,,0,0,0,,Иә? Риччан жалғыз ба?
Dialogue: 0,0:05:33.05,0:05:36.56,Default,,0,0,0,,Қаласаңыз, түскі асты бірге ішейік!
Dialogue: 0,0:05:36.56,0:05:39.56,Default,,0,0,0,,Статикалық электр тогы ызылдап тұр.
Dialogue: 0,0:05:39.56,0:05:42.70,Default,,0,0,0,,Иә! Бұл шынымен ауырады!
Dialogue: 0,0:05:42.70,0:05:47.40,Default,,0,0,0,,Есікті ұстағанда таң қалмайсың ба? Мен түссіндім! Кейде ұшқындар ұшады
Dialogue: 0,0:05:47.40,0:05:50.70,Default,,0,0,0,,Бұл өте қауіпті, солай емес пе?
Dialogue: 0,0:05:50.70,0:05:53.61,Default,,0,0,0,,Осы мәселені түсініп көріңізші... Ал, мен➡
Dialogue: 0,0:05:53.61,0:05:57.81,Default,,0,0,0,,Мен скрипкада машықтанғым келеді, кеттік! Жарайды!
Dialogue: 0,0:06:00.25,0:06:02.25,Default,,0,0,0,,[Сымсыз] (Хабар рингтоны)
Dialogue: 0,0:06:07.35,0:06:09.39,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:06:09.39,0:06:13.66,Default,,0,0,0,,♬～
Dialogue: 0,0:06:13.66,0:06:17.87,Default,,0,0,0,,Иә? (Хаджиме Аоно) Иә? Козакура-сан, сен де бүгін боссың ба?
Dialogue: 0,0:06:17.87,0:06:21.37,Default,,0,0,0,,Бүгіннен бастап мен жаңа нәрсемен айналысамын...
Dialogue: 0,0:06:21.37,0:06:23.67,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:23.67,0:06:27.87,Default,,0,0,0,,Жақында концертке тыңдаулар болуы керек.
Dialogue: 0,0:06:33.68,0:06:36.38,Default,,0,0,0,,Не? Мен оны асыға күтемін
Dialogue: 0,0:06:36.38,0:06:39.38,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:06:41.22,0:06:43.16,Default,,0,0,0,,Акине...
Dialogue: 0,0:06:43.16,0:06:45.69,Default,,0,0,0,,Содан бері мен көп қателестім!
Dialogue: 0,0:06:45.69,0:06:48.60,Default,,0,0,0,,Өзімді жақсы сезіну үшін ойнауды қанша рет тоқтатуым керек!?
Dialogue: 0,0:06:48.60,0:06:50.90,Default,,0,0,0,,Кешіріңіз...｡ (Яйои Ногучи) Өте орынды.
Dialogue: 0,0:06:50.90,0:06:53.57,Default,,0,0,0,,Міне, сонда! Ұрыспа! Бұрынғы жылтыр➡
Dialogue: 0,0:06:53.57,0:06:57.40,Default,,0,0,0,,Ұялы телефон Бұл туралы уайымдамаңыз! А, қазірдің өзінде! Тағы да сол екеуі!?
Dialogue: 0,0:06:57.40,0:07:00.31,Default,,0,0,0,,Спектакль кезінде де мен өзімді біршама беймаза сезінемін.➡
Dialogue: 0,0:07:00.31,0:07:03.11,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,0:07:08.18,0:07:12.52,Default,,0,0,0,,Кешіріңіз, Чика-сенпай, мен бір сәт ваннаға барамын.
Dialogue: 0,0:07:12.52,0:07:14.52,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:16.19,0:07:19.66,Default,,0,0,0,,(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:07:19.66,0:07:23.96,Default,,0,0,0,,Олай болса, қайтадан жаттығуды бастайық! Хмф!
Dialogue: 0,0:07:26.03,0:07:30.53,Default,,0,0,0,,(бетке шашыраған судың дыбысы)
Dialogue: 0,0:07:32.21,0:07:35.04,Default,,0,0,0,,<Мен не істеп жатырмын...｡➡
Dialogue: 0,0:07:35.04,0:07:39.34,Default,,0,0,0,,Әркімге қиындық туғызу жиіркенішті...>
Dialogue: 0,0:07:40.91,0:07:44.39,Default,,0,0,0,,Менеджер, бұл не?
Dialogue: 0,0:07:44.39,0:07:47.69,Default,,0,0,0,,Кезекті концертке дейін кері санақ
Dialogue: 0,0:07:47.69,0:07:51.56,Default,,0,0,0,,Бұл жаңа бірінші курс студенттері үшін бірінші үлкен кезең.
Dialogue: 0,0:07:51.56,0:07:56.40,Default,,0,0,0,,Бірақ бірінші курс студенттерінің барлығы қатыса алмайтынына сенімдімін, солай ма?
Dialogue: 0,0:07:56.40,0:08:00.27,Default,,0,0,0,,Дұрыс. Сондықтан мен орындаушы мүше ретінде таңдалғым келеді➡
Dialogue: 0,0:08:00.27,0:08:03.97,Default,,0,0,0,,Мен бірінші курс студенттерінің барын салғанын қалаймын.
Dialogue: 0,0:08:05.84,0:08:08.74,Default,,0,0,0,,[Естелік] Мен орта мектепке барып, оркестрге қабылданған кезде➡
Dialogue: 0,0:08:08.74,0:08:12.71,Default,,0,0,0,,Ендеше скрипкада ойнайық!
Dialogue: 0,0:08:12.71,0:08:16.35,Default,,0,0,0,,Не істеп жатырсың, Хару...!
Dialogue: 0,0:08:16.35,0:08:21.19,Default,,0,0,0,,♬～
Dialogue: 0,0:08:21.19,0:08:25.39,Default,,0,0,0,,Мен әлі уәдемді орындаған жоқпын!
Dialogue: 0,0:08:29.06,0:08:31.26,Default,,0,0,0,,«Гяаа!»
Dialogue: 0,0:08:36.37,0:08:38.37,Default,,0,0,0,,бұл...
Dialogue: 0,0:08:40.24,0:08:44.74,Default,,0,0,0,,Мен күткендей кино көруден шаршадым...
Dialogue: 0,0:08:47.55,0:08:49.55,Default,,0,0,0,,Сабақтар…
Dialogue: 0,0:09:03.63,0:09:08.93,Default,,0,0,0,,Маған көрсете алатын адам бар ма екен...?
Dialogue: 0,0:09:12.01,0:09:13.94,Default,,0,0,0,,А, қазірдің өзінде! ➡
Dialogue: 0,0:09:13.94,0:09:16.88,Default,,0,0,0,,Неліктен тағы да осындай жағымсыз ойларды ойлап отырсың? ➡
Dialogue: 0,0:09:16.88,0:09:19.68,Default,,0,0,0,,Мен өте қиынмын!
Dialogue: 0,0:09:24.18,0:09:27.09,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:09:27.09,0:09:32.53,Default,,0,0,0,,[Еске алу] Бұл бүгінгі мектептегі үлестірмелі материал мен сыныптағы жазбалар.
Dialogue: 0,0:09:32.53,0:09:36.33,Default,,0,0,0,,Мен әрқашан кешірім сұраймын, Рицуко-чан.
Dialogue: 0,0:09:48.91,0:09:51.75,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:09:51.75,0:09:56.58,Default,,0,0,0,,♬～
Dialogue: 0,0:09:56.58,0:09:58.89,Default,,0,0,0,,№
Dialogue: 0,0:09:58.89,0:10:05.56,Default,,0,0,0,,♬～
Dialogue: 0,0:10:05.56,0:10:08.56,Default,,0,0,0,,Хехе... Мен балмұздақ сатып алдым.
Dialogue: 0,0:10:08.56,0:10:10.76,Default,,0,0,0,,Халл?
Dialogue: 0,0:10:16.27,0:10:19.47,Default,,0,0,0,,Ри… Риччан…!?
Dialogue: 0,0:10:28.42,0:10:32.59,Default,,0,0,0,,Мен шынымен таң қалдым. Бірақ сен неге мұндасың?
Dialogue: 0,0:10:32.59,0:10:35.49,Default,,0,0,0,,Мен Харудың үйіне баруды ойладым...
Dialogue: 0,0:10:35.49,0:10:39.26,Default,,0,0,0,,...Мен сізге жаңа ғана хабарлама жібердім.
Dialogue: 0,0:10:39.26,0:10:41.93,Default,,0,0,0,,Не, өтірік!?➡
Dialogue: 0,0:10:41.93,0:10:44.73,Default,,0,0,0,,Тек бет-әлпеті ғана емес, білесің бе
Dialogue: 0,0:10:44.73,0:10:49.57,Default,,0,0,0,,Хаха, сен тек қорқынышты фильмдер көріп жүрсің ғой, солай ма?
Dialogue: 0,0:10:49.57,0:10:54.11,Default,,0,0,0,,Хару әрқашан қорқынышты жақсы көреді.
Dialogue: 0,0:10:54.11,0:10:57.31,Default,,0,0,0,,Мен Харудың түрін көргім келді
Dialogue: 0,0:10:59.45,0:11:03.42,Default,,0,0,0,,(Рицуко мен Харудың күлкісі)
Dialogue: 0,0:11:03.42,0:11:08.16,Default,,0,0,0,,Міне~ Тачибана мені қатты ашуландырды.
Dialogue: 0,0:11:08.16,0:11:11.09,Default,,0,0,0,,Тачибана-сан, бұл қиын.
Dialogue: 0,0:11:11.09,0:11:15.56,Default,,0,0,0,,Жолды тасымалдау дұрыс жүрмейтін кейбір бөліктер бар...
Dialogue: 0,0:11:15.56,0:11:21.24,Default,,0,0,0,,Келесі жолға жылдам өту үшін тым шыдамсыз болсаңыз, ол жұмыс істемейді.
Dialogue: 0,0:11:21.24,0:11:24.71,Default,,0,0,0,,Жіптерді ауыстырған кезде шынтақтардың биіктігін өзгертіңіз.
Dialogue: 0,0:11:24.71,0:11:28.08,Default,,0,0,0,,Түсіндім! Жарайсың Хару!
Dialogue: 0,0:11:33.41,0:11:36.45,Default,,0,0,0,,Ойлап қарасам, мен бүгін көзілдірік таққанмын.
Dialogue: 0,0:11:36.45,0:11:39.92,Default,,0,0,0,,А, иә. Үйде мен әрқашан...
Dialogue: 0,0:11:39.92,0:11:42.59,Default,,0,0,0,,Сәлем! А... көп қарама!
Dialogue: 0,0:11:42.59,0:11:45.26,Default,,0,0,0,,Маған бұл көзілдірік ұнамайды...
Dialogue: 0,0:11:45.26,0:11:48.10,Default,,0,0,0,,Өйткені ол әйтеуір сағыныш сезімін тудырады.
Dialogue: 0,0:11:48.10,0:11:51.00,Default,,0,0,0,,Мен орта мектепті бітіргенше көзілдірік кидім.
Dialogue: 0,0:11:51.00,0:11:53.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:55.27,0:11:57.20,Default,,0,0,0,,Джоа қалай?
Dialogue: 0,0:11:57.20,0:12:01.04,Default,,0,0,0,,Иә. Соңғы кездері көп тамақ жегендіктен сәл салмақ қосып алған шығармын.
Dialogue: 0,0:12:01.04,0:12:05.88,Default,,0,0,0,,Ахахха! Сенің есіңде ме? Мен Харумен қалай дос болдым
Dialogue: 0,0:12:05.88,0:12:07.88,Default,,0,0,0,,Әрине!
Dialogue: 0,0:12:09.55,0:12:12.22,Default,,0,0,0,,Сіздің мысық бар ма?
Dialogue: 0,0:12:12.22,0:12:15.69,Default,,0,0,0,,Не? Ха! Ал... қайдан білесің...
Dialogue: 0,0:12:15.69,0:12:19.56,Default,,0,0,0,,Неге... ғажайып шаш...
Dialogue: 0,0:12:19.56,0:12:23.40,Default,,0,0,0,,Менің де мысық бар.
Dialogue: 0,0:12:23.40,0:12:27.27,Default,,0,0,0,,Мен Ричканның да үй жануары бар деп естідім. Ол әлдеқашан өліп қалған еді...
Dialogue: 0,0:12:27.27,0:12:35.01,Default,,0,0,0,,Бірақ... Мен бақытты болдым. Мен орта мектептің бірінші курсында оқып жүргенімде, Рикчан маған қоңырау шалды.➡
Dialogue: 0,0:12:35.01,0:12:39.41,Default,,0,0,0,,Себебі менің достарым болған жоқ.
Dialogue: 0,0:12:39.41,0:12:45.11,Default,,0,0,0,,Е! Сіз скрипка ойнайсыз ба!? Керемет!
Dialogue: 0,0:12:46.72,0:12:52.53,Default,,0,0,0,,Мен бұған өте жақсы емеспін. 3-сыныптағы Аоно-кун одан да жақсы.
Dialogue: 0,0:12:52.53,0:12:54.53,Default,,0,0,0,,Кім?
Dialogue: 0,0:12:56.26,0:13:01.46,Default,,0,0,0,,Орта мектептің оркестр үйірмесі? Бұл не? Ондай нәрсе бар!
Dialogue: 0,0:13:04.54,0:13:08.38,Default,,0,0,0,,Сәлем, Хал! Келесі жолы ойнаңыз!
Dialogue: 0,0:13:08.38,0:13:16.08,Default,,0,0,0,,♬～
Dialogue: 0,0:13:22.22,0:13:28.40,Default,,0,0,0,,Жақсы. Сіздің денсаулығыңыз жақсы сияқты. Аоно мен басқалары да уайымдады.
Dialogue: 0,0:13:28.40,0:13:31.43,Default,,0,0,0,,Иә... бәрібір.
Dialogue: 0,0:13:35.07,0:13:37.07,Default,,0,0,0,,Корпус…
Dialogue: 0,0:13:39.57,0:13:42.08,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:13:42.08,0:13:47.58,Default,,0,0,0,,«Жарайды» деген не? Сабақтан үйде бол және маған хабарласпа ➡
Dialogue: 0,0:13:47.58,0:13:49.92,Default,,0,0,0,,Бұл мүлдем дұрыс емес!
Dialogue: 0,0:13:49.92,0:13:55.26,Default,,0,0,0,,Харудың жағдайы жақсы болса да... Мен жақсы емеспін!
Dialogue: 0,0:13:55.26,0:13:59.59,Default,,0,0,0,,Хару тым көп сөзді жұтып жатыр!
Dialogue: 0,0:13:59.59,0:14:02.09,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:14:03.86,0:14:06.77,Default,,0,0,0,,...Мм, жоқ!
Dialogue: 0,0:14:06.77,0:14:09.97,Default,,0,0,0,,Мен мұны дұрыс емес деп санаймын!
Dialogue: 0,0:14:11.61,0:14:16.04,Default,,0,0,0,,Шынайы сезімімді айтқым келсе...➡
Dialogue: 0,0:14:16.04,0:14:20.34,Default,,0,0,0,,Біріншіден, мен мұны өзім айтуым керек...
Dialogue: 0,0:14:22.22,0:14:24.89,Default,,0,0,0,,Халл! иә?
Dialogue: 0,0:14:24.89,0:14:29.69,Default,,0,0,0,,♬～
Dialogue: 0,0:14:29.69,0:14:34.53,Default,,0,0,0,,Мен әрқашан Харудан кешірім сұрағым келді.
Dialogue: 0,0:14:34.53,0:14:36.46,Default,,0,0,0,,А...?
Dialogue: 0,0:14:36.46,0:14:40.07,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде...➡
Dialogue: 0,0:14:40.07,0:14:43.57,Default,,0,0,0,,Сіз Харуды бұрылыста ұстадыңыз...
Dialogue: 0,0:14:45.24,0:14:52.24,Default,,0,0,0,,Кіші орта мектептің 2 курсы. Мен сынып ауыстырып, сол жігітпен бір сыныпқа түскеннен кейін болды.
Dialogue: 0,0:14:53.91,0:14:56.72,Default,,0,0,0,,Хару~! Үйге бар! Ах...
Dialogue: 0,0:14:56.72,0:15:00.42,Default,,0,0,0,,Иә? Журнал?
Dialogue: 0,0:15:02.52,0:15:05.03,Default,,0,0,0,,Ах... Рикчан, оны қайтар!
Dialogue: 0,0:15:05.03,0:15:08.53,Default,,0,0,0,,Сіз кеше де күндізгі ауысымда жұмыс істедіңіз. Бұлай істеуге ештеңе жоқ!
Dialogue: 0,0:15:08.53,0:15:11.43,Default,,0,0,0,,Жақсы! Бұл көп уақытты алмайды...
Dialogue: 0,0:15:11.43,0:15:14.87,Default,,0,0,0,,Бұл өте мүмкін емес~｡ Эй~
Dialogue: 0,0:15:14.87,0:15:19.04,Default,,0,0,0,,Бүгінгі парыз сенсің, солай ма?
Dialogue: 0,0:15:19.04,0:15:21.54,Default,,0,0,0,,Өзіңіз жасаңыз
Dialogue: 0,0:15:21.54,0:15:27.41,Default,,0,0,0,,Иә, бірақ... Козакура-сан мұны өзі жасағысы келетінін айтты.
Dialogue: 0,0:15:27.41,0:15:31.89,Default,,0,0,0,,Сәлем, Козакура мырза? Ах...
Dialogue: 0,0:15:31.89,0:15:36.22,Default,,0,0,0,,Ол қыжылдап жатқан жоқ! Сіз құпия адам болсаңыз да~
Dialogue: 0,0:15:36.22,0:15:38.92,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:15:40.56,0:15:44.56,Default,,0,0,0,,Ол кезде мен түсінбедім.
Dialogue: 0,0:15:44.56,0:15:49.24,Default,,0,0,0,,Мен тек шарасыз қарсылық көрсету керек деп ойладым...
Dialogue: 0,0:15:49.24,0:15:54.54,Default,,0,0,0,,Бірақ бұл Харуды бұрышқа апарды...
Dialogue: 0,0:15:56.11,0:15:58.41,Default,,0,0,0,,Мен оларды ешқашан кешірмеймін!
Dialogue: 0,0:15:58.41,0:16:01.65,Default,,0,0,0,,Риччанды өтінемін! Артық ештеңе істеме!
Dialogue: 0,0:16:01.65,0:16:04.85,Default,,0,0,0,,Неліктен!? Істің осылай жалғасуына жол беру дұрыс па!?
Dialogue: 0,0:16:04.85,0:16:06.79,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:16:06.79,0:16:08.72,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:08.72,0:16:12.19,Default,,0,0,0,,Өйткені ол осылай қала берсе...➡
Dialogue: 0,0:16:12.19,0:16:14.86,Default,,0,0,0,,Риччанға дейін...
Dialogue: 0,0:16:14.86,0:16:16.80,Default,,0,0,0,,Хару...?
Dialogue: 0,0:16:16.80,0:16:20.37,Default,,0,0,0,,Менде бәрі жақсы...
Dialogue: 0,0:16:20.37,0:16:23.37,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:25.87,0:16:29.21,Default,,0,0,0,,Мен мұны Хару мектептерді ауыстырғаннан кейін байқадым.
Dialogue: 0,0:16:29.21,0:16:33.68,Default,,0,0,0,,Мен... Керексіз бірдеңе істеп жатырмын ба деп ойлаймын...
Dialogue: 0,0:16:33.68,0:16:36.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:36.05,0:16:41.39,Default,,0,0,0,,♬～
Dialogue: 0,0:16:41.39,0:16:45.06,Default,,0,0,0,,Мұндай нәрсе…➡
Dialogue: 0,0:16:45.06,0:16:48.09,Default,,0,0,0,,Мүлде жоқ…
Dialogue: 0,0:16:48.09,0:16:51.93,Default,,0,0,0,,Мен ашуланатын кездер болады➡
Dialogue: 0,0:16:51.93,0:16:55.24,Default,,0,0,0,,Мен мұны өзім білемін...
Dialogue: 0,0:16:55.24,0:16:59.71,Default,,0,0,0,,Риччан қателескен жоқ! басқа!
Dialogue: 0,0:16:59.71,0:17:06.01,Default,,0,0,0,,Хару білмейтін шығар, бірақ мен...➡
Dialogue: 0,0:17:06.01,0:17:09.65,Default,,0,0,0,,Мен оны қайтардым. иә?
Dialogue: 0,0:17:09.65,0:17:14.52,Default,,0,0,0,,Хару ауыстырғаннан кейін...➡
Dialogue: 0,0:17:14.52,0:17:19.39,Default,,0,0,0,,Мен... Мен Синозакидің мені ренжітуіне себеп болдым.
Dialogue: 0,0:17:19.39,0:17:22.66,Default,,0,0,0,,Бұл менің шыдамымның шегі болды...
Dialogue: 0,0:17:22.66,0:17:25.86,Default,,0,0,0,,Бірақ бұл мүмкін емес еді...
Dialogue: 0,0:17:28.37,0:17:31.27,Default,,0,0,0,,Сабыр...? ➡
Dialogue: 0,0:17:31.27,0:17:35.24,Default,,0,0,0,,Сабыр... Рикчан...➡
Dialogue: 0,0:17:35.24,0:17:40.04,Default,,0,0,0,,Ол адамдар сізге бірдеңе жасады ма?
Dialogue: 0,0:17:43.22,0:17:46.05,Default,,0,0,0,,Кешіріңіз...! Хару!
Dialogue: 0,0:17:46.05,0:17:48.56,Default,,0,0,0,,Кешіріңіз, кешіріңіз! ➡
Dialogue: 0,0:17:48.56,0:17:51.46,Default,,0,0,0,,Мен үшін, Риччан...!
Dialogue: 0,0:17:51.46,0:17:53.89,Default,,0,0,0,,Қашып кеткенім үшін кешіріңіз!
Dialogue: 0,0:17:53.89,0:17:57.56,Default,,0,0,0,,Жоқ! Мен сенің кешірім сұрағаныңды қаламаймын!
Dialogue: 0,0:17:57.56,0:18:00.23,Default,,0,0,0,,Қашуға болмайды!
Dialogue: 0,0:18:00.23,0:18:03.64,Default,,0,0,0,,Мектепті сағынып қалсам да➡
Dialogue: 0,0:18:03.64,0:18:07.84,Default,,0,0,0,,Риччан, сен менің үйіме күнде келесің...
Dialogue: 0,0:18:09.44,0:18:12.74,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:18:14.38,0:18:17.65,Default,,0,0,0,,<Жүрегімнің бір жерінде оны түсіндім.➡
Dialogue: 0,0:18:17.65,0:18:20.85,Default,,0,0,0,,Мектепті осылай тастап кетсем➡
Dialogue: 0,0:18:20.85,0:18:25.19,Default,,0,0,0,,Рикчан бұл жолы жараланады...>
Dialogue: 0,0:18:25.19,0:18:33.07,Default,,0,0,0,,Бірақ... Мен қорқып, байқамағандай кейіп таныттым...｡➡
Dialogue: 0,0:18:33.07,0:18:37.90,Default,,0,0,0,,Мен өзімді жек көремін...
Dialogue: 0,0:18:37.90,0:18:42.61,Default,,0,0,0,,Мен оны жек көремін! Бұл мен...
Dialogue: 0,0:18:42.61,0:18:47.21,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:18:47.21,0:18:53.02,Default,,0,0,0,,Мен Харуды жақсы көремін. Біз доспыз.
Dialogue: 0,0:18:53.02,0:18:56.89,Default,,0,0,0,,Мен Риччанмен дос болуға лайық емеспін...
Dialogue: 0,0:18:56.89,0:19:00.23,Default,,0,0,0,,Мен достарымның ешқайсысының біліктілігі бар екенін естіген емеспін!
Dialogue: 0,0:19:00.23,0:19:04.50,Default,,0,0,0,,Риччанның менен басқа достары көп!
Dialogue: 0,0:19:04.50,0:19:09.00,Default,,0,0,0,,Ах...｡ Иә. Бірақ...➡
Dialogue: 0,0:19:09.00,0:19:13.64,Default,,0,0,0,,Мен үшін бір ғана Хару бар.
Dialogue: 0,0:19:13.64,0:19:19.51,Default,,0,0,0,,♬～
Dialogue: 0,0:19:19.51,0:19:24.28,Default,,0,0,0,,Рахмет. Харудың бұл жерде болмағанын қалаймын➡
Dialogue: 0,0:19:24.28,0:19:27.22,Default,,0,0,0,,Мен бұлай скрипкада да ойнамаймын➡
Dialogue: 0,0:19:27.22,0:19:30.09,Default,,0,0,0,,Мен оркестрде де болған жоқпын.
Dialogue: 0,0:19:30.09,0:19:35.36,Default,,0,0,0,,Сондай-ақ, өзіме ұнамайтын нәрселер көп.
Dialogue: 0,0:19:35.36,0:19:37.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.30,0:19:40.20,Default,,0,0,0,,Басқа адамдардың сезімін ескермей әрекет ету➡
Dialogue: 0,0:19:40.20,0:19:44.67,Default,,0,0,0,,Сіз ойлаған нәрсені бірден айту керек сияқты сезінесіз➡
Dialogue: 0,0:19:44.67,0:19:49.87,Default,,0,0,0,,Менің ойымша, мұндай нәрсе айналамдағы адамдарға зиян тигізді ме...
Dialogue: 0,0:19:51.54,0:19:56.22,Default,,0,0,0,,Мен орта мектепте оқып жүргенімде, менің сыныптағы бір бала маған бұл туралы айтты.
Dialogue: 0,0:19:56.22,0:20:01.05,Default,,0,0,0,,«Акине-сан, сен атмосфераны оқи алмайсың, солай ма?»
Dialogue: 0,0:20:01.05,0:20:05.39,Default,,0,0,0,,[Еске алу] Мен міндетті түрде жеңгім келеді! Иә иә!
Dialogue: 0,0:20:05.39,0:20:09.56,Default,,0,0,0,,Әй, сабақтан кейін неге қалып, жаттығу жасамайсың?
Dialogue: 0,0:20:09.56,0:20:13.40,Default,,0,0,0,,Егер сіз көп жасасаңыз, сіз жақсарасыз!
Dialogue: 0,0:20:13.40,0:20:17.07,Default,,0,0,0,,Сол қызбен жүргенім мені шаршатады.
Dialogue: 0,0:20:17.07,0:20:20.87,Default,,0,0,0,,Не айта аламын... температура айырмашылығы бар, солай ма?
Dialogue: 0,0:20:22.58,0:20:27.58,Default,,0,0,0,,Мен дұрыс айттым. Мен солай ойладым...
Dialogue: 0,0:20:30.72,0:20:34.92,Default,,0,0,0,,Мен әкелемін. (Үй мұғалімі) Әрқашан жаман.
Dialogue: 0,0:20:34.92,0:20:39.09,Default,,0,0,0,,Сен ақымақ болып, өзіңе мас болып жүрсің ғой, солай ма?
Dialogue: 0,0:20:39.09,0:20:42.00,Default,,0,0,0,,Хаха, сен шарасыз екенсің ғой, солай ма?
Dialogue: 0,0:20:42.00,0:20:45.30,Default,,0,0,0,,Козакура-сан, сен кетсең, мен өлтіремін.
Dialogue: 0,0:20:46.97,0:20:49.47,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,0:20:51.44,0:20:54.94,Default,,0,0,0,,Мен әрқашан кешірім сұраймын, Рицуко-чан.
Dialogue: 0,0:20:54.94,0:21:00.24,Default,,0,0,0,,Ондай бала өзінен кіші адамдар бар екенін сезінгісі келеді.
Dialogue: 0,0:21:06.55,0:21:08.75,Default,,0,0,0,,Риччан
Dialogue: 0,0:21:10.39,0:21:13.89,Default,,0,0,0,,Әрқашан рахмет
Dialogue: 0,0:21:17.16,0:21:22.40,Default,,0,0,0,,Хару... сен білесің бе?
Dialogue: 0,0:21:22.40,0:21:30.08,Default,,0,0,0,,Осы бір сөз мені қаншалықты құтқарды...
Dialogue: 0,0:21:30.08,0:21:37.58,Default,,0,0,0,,Мен... Харудың дос болғанына қуандым.
Dialogue: 0,0:21:39.42,0:21:46.59,Default,,0,0,0,,Хару маған орын жасап берді.
Dialogue: 0,0:21:46.59,0:21:49.43,Default,,0,0,0,,Риччан...
Dialogue: 0,0:21:49.43,0:21:53.10,Default,,0,0,0,,<Бұл сезім мәңгілік➡
Dialogue: 0,0:21:53.10,0:21:56.74,Default,,0,0,0,,Мен бұл тек менікі деп ойладым...｡➡
Dialogue: 0,0:21:56.74,0:22:00.44,Default,,0,0,0,,Бірақ бұл басқаша...>
Dialogue: 0,0:22:00.44,0:22:03.88,Default,,0,0,0,,Кешіріңіз. Неге мен...
Dialogue: 0,0:22:03.88,0:22:07.55,Default,,0,0,0,,♬～
Dialogue: 0,0:22:07.55,0:22:12.25,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:22:14.32,0:22:20.26,Default,,0,0,0,,Сәлем Хару. Өтінемін, бір ғана аламын ба?
Dialogue: 0,0:22:20.26,0:22:22.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:35.07,0:22:56.10,Default,,0,0,0,,♬～
Dialogue: 0,0:22:56.10,0:22:58.60,Default,,0,0,0,,[Еске алу] Эй, Хару!
Dialogue: 0,0:23:00.27,0:23:03.87,Default,,0,0,0,,Келесі жолы осыны ойнаңыз!
Dialogue: 0,0:23:03.87,0:23:08.74,Default,,0,0,0,,Жарайды, бірақ... Рикчан, бұл саған ұнай ма?
Dialogue: 0,0:23:08.74,0:23:15.55,Default,,0,0,0,,Иә! Өйткені бұл...➡
Dialogue: 0,0:23:15.55,0:23:20.69,Default,,0,0,0,,Бұл Харудың маған арнаған алғашқы әні болды!
Dialogue: 0,0:23:20.69,0:23:24.56,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.56,0:23:28.23,Default,,0,0,0,,<Біреуге скрипкада ойнау➡
Dialogue: 0,0:23:28.23,0:23:32.07,Default,,0,0,0,,Мен бұл менің бірінші рет екенін түсіндім.➡
Dialogue: 0,0:23:32.07,0:23:38.84,Default,,0,0,0,,Сол кезде мен өзімді алғаш рет сүйе алатындай сезіндім...>
