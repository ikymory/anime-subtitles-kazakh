Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.73,0:00:05.63,Default,,0,0,0,,<Мен жаңбырды жек көремін...>
Dialogue: 0,0:00:05.63,0:00:10.91,Default,,0,0,0,,♬～
Dialogue: 0,0:00:10.91,0:00:14.24,Default,,0,0,0,,<Скрипка үні бұлыңғыр➡
Dialogue: 0,0:00:14.24,0:00:19.08,Default,,0,0,0,,Көлігіңізге су шашуыңызға болады...➡
Dialogue: 0,0:00:19.08,0:00:22.95,Default,,0,0,0,,Мені қарады деп айыптады➡
Dialogue: 0,0:00:22.95,0:00:27.59,Default,,0,0,0,,Жаңбырлы күнде жаман ештеңе болмайды＞
Dialogue: 0,0:00:27.59,0:00:30.49,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:00:30.49,0:00:33.93,Default,,0,0,0,,Бірінші стакато ауыр.
Dialogue: 0,0:00:33.93,0:00:38.10,Default,,0,0,0,,Екпінді күшейтіп, келесі ноталарды секіртіңіз.
Dialogue: 0,0:00:38.10,0:00:41.60,Default,,0,0,0,,Сондай-ақ былғарыдан сақ болыңыз. (мүшелер) Иә!
Dialogue: 0,0:00:41.60,0:00:44.11,Default,,0,0,0,,Басынан қайтадан.
Dialogue: 0,0:00:48.94,0:00:53.78,Default,,0,0,0,,♬～
Dialogue: 0,0:00:53.78,0:00:56.69,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:00:56.69,0:00:59.59,Default,,0,0,0,,Дәл осы жерде балағат сөздер маңызды.
Dialogue: 0,0:00:59.59,0:01:04.36,Default,,0,0,0,,Қуат таусылмай және жеңілдігін сақтай отырып, пианиссимо ойнаңыз.
Dialogue: 0,0:01:04.36,0:01:06.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:06.30,0:01:08.30,Default,,0,0,0,,Басынан тағы бір рет.
Dialogue: 0,0:01:10.07,0:01:12.90,Default,,0,0,0,,♬～
Dialogue: 0,0:01:12.90,0:01:17.74,Default,,0,0,0,,<Музыкалық партитуралармен шектелмейтін ымырасыз орындау. ➡
Dialogue: 0,0:01:17.74,0:01:20.64,Default,,0,0,0,,Әйтеуір…➡
Dialogue: 0,0:01:20.64,0:01:23.91,Default,,0,0,0,,Әлгі жігітке ұқсайды... ➡
Dialogue: 0,0:01:23.91,0:01:26.25,Default,,0,0,0,,Жоқ! Құлды! ➡
Dialogue: 0,0:01:26.25,0:01:30.59,Default,,0,0,0,,Шүкір... бұл менің әкем туралы ештеңе еске алатын уақыт емес... ➡
Dialogue: 0,0:01:30.59,0:01:33.62,Default,,0,0,0,,Қазір қандай өлшем? ? ➡
Dialogue: 0,0:01:33.62,0:01:38.33,Default,,0,0,0,,Тынышталыңыз. Келесі өлшемнен сәйкестендірсеңіз... ➡
Dialogue: 0,0:01:38.33,0:01:41.53,Default,,0,0,0,,Ах...> Тоқта.
Dialogue: 0,0:01:53.28,0:01:55.48,Default,,0,0,0,,<Мен жасадым...>
Dialogue: 0,0:01:57.11,0:01:59.15,Default,,0,0,0,,Харада. (Ао Харада) Иә!
Dialogue: 0,0:01:59.15,0:02:03.22,Default,,0,0,0,,Бірінші жыл аласапыран болды. Сіз маған жақсы үйретесіз бе?
Dialogue: 0,0:02:03.22,0:02:05.89,Default,,0,0,0,,Иә! кешіріңіз!
Dialogue: 0,0:02:05.89,0:02:09.22,Default,,0,0,0,,Ол ойнай алғанша жаттығасын.
Dialogue: 0,0:02:09.22,0:02:12.13,Default,,0,0,0,,Кешіріңіз... (Аюкава) Бүгінге осымен бітті.
Dialogue: 0,0:02:12.13,0:02:14.93,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:02:24.57,0:02:28.58,Default,,0,0,0,,<Мен не істеп жатырмын?>
Dialogue: 0,0:02:32.75,0:03:02.74,Default,,0,0,0,,♬～
Dialogue: 0,0:03:02.74,0:03:12.72,Default,,0,0,0,,♬～
Dialogue: 0,0:03:12.72,0:03:21.43,Default,,0,0,0,,♬～
Dialogue: 0,0:03:24.73,0:03:32.54,Default,,0,0,0,,♬～
Dialogue: 0,0:03:36.34,0:03:39.92,Default,,0,0,0,,♬～
Dialogue: 0,0:03:39.92,0:03:42.75,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.75,0:03:53.76,Default,,0,0,0,,♬～
Dialogue: 0,0:03:53.76,0:04:01.57,Default,,0,0,0,,♬～
Dialogue: 0,0:04:06.88,0:04:09.78,Default,,0,0,0,,Кешіріңіз ертерек.
Dialogue: 0,0:04:09.78,0:04:15.28,Default,,0,0,0,,Мен кінәлі болсам да, ағам ашуланды...
Dialogue: 0,0:04:17.35,0:04:21.06,Default,,0,0,0,,Сондай күндер болады. Тым көп уайымдамаңыз.
Dialogue: 0,0:04:21.06,0:04:23.09,Default,,0,0,0,,Иә….
Dialogue: 0,0:04:23.09,0:04:26.86,Default,,0,0,0,,Осыдан кейін қалып, жаттығуға бола ма?
Dialogue: 0,0:04:26.86,0:04:29.36,Default,,0,0,0,,Жарайды, бірақ...➡
Dialogue: 0,0:04:29.36,0:04:34.74,Default,,0,0,0,,Дыбыста айтқым келген сезімдер өкініш емес. ➡
Dialogue: 0,0:04:34.74,0:04:39.04,Default,,0,0,0,,Ертең бұл түріңмен ойнама!
Dialogue: 0,0:04:44.91,0:04:47.25,Default,,0,0,0,,<Неге қызық... ➡
Dialogue: 0,0:04:47.25,0:04:52.59,Default,,0,0,0,,Харада-сенпай әдеттегіден де жарқырап көрінеді. ➡
Dialogue: 0,0:04:52.59,0:04:55.89,Default,,0,0,0,,Бұл Харада сиқыры ма? ＞
Dialogue: 0,0:05:05.70,0:05:10.71,Default,,0,0,0,,<Бүгін не істесем де, жақсы болмады...>
Dialogue: 0,0:05:15.41,0:05:17.91,Default,,0,0,0,,<Мен жаңбырды жек көремін>
Dialogue: 0,0:05:20.05,0:05:24.22,Default,,0,0,0,,<Осылайша мен бір нәрсені кінәлағым келеді➡
Dialogue: 0,0:05:24.22,0:05:26.92,Default,,0,0,0,,Мен оны ең жек көремін...＞
Dialogue: 0,0:05:31.96,0:05:35.56,Default,,0,0,0,,А... Жаңбыр жауып тұр ма?
Dialogue: 0,0:05:35.56,0:05:38.90,Default,,0,0,0,,Форма құрғақ болса да.
Dialogue: 0,0:05:38.90,0:05:45.37,Default,,0,0,0,,♬～
Dialogue: 0,0:05:45.37,0:05:48.28,Default,,0,0,0,,<Козакура-сан да қалды...>
Dialogue: 0,0:05:48.28,0:05:50.98,Default,,0,0,0,,Кя~! сурет...?
Dialogue: 0,0:05:54.58,0:05:56.89,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:07.86,0:06:20.21,Default,,0,0,0,,♬～
Dialogue: 0,0:06:20.21,0:06:23.04,Default,,0,0,0,,＜Ыңғайсыз...＞
Dialogue: 0,0:06:23.04,0:06:29.82,Default,,0,0,0,,♬～
Dialogue: 0,0:06:29.82,0:06:35.06,Default,,0,0,0,,Яй... Мен станцияға жүгіретін шығармын!
Dialogue: 0,0:06:35.06,0:06:38.36,Default,,0,0,0,,Не? Осы жаңбырдан суланып қалсаң...
Dialogue: 0,0:06:38.36,0:06:40.43,Default,,0,0,0,,Кешіріңіз! иә?
Dialogue: 0,0:06:40.43,0:06:43.90,Default,,0,0,0,,Түсінудің қажеті жоқ! Қалай болғанда да, кешіріңіз!
Dialogue: 0,0:06:43.90,0:06:49.77,Default,,0,0,0,,Жарайды...жаңбыр мүлде тоқтайтын сияқты емес.
Dialogue: 0,0:06:49.77,0:06:53.58,Default,,0,0,0,,Мен жаңбырды жек көремін.
Dialogue: 0,0:06:53.58,0:06:59.58,Default,,0,0,0,,♬～
Dialogue: 0,0:07:01.85,0:07:07.66,Default,,0,0,0,,Бүгінгі күн үшін кешіріңіз. Жаттығу кезінде мен қателіктер жібердім...
Dialogue: 0,0:07:07.66,0:07:10.33,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:07:10.33,0:07:13.53,Default,,0,0,0,,Мен тіпті шатастырдым ...
Dialogue: 0,0:07:17.20,0:07:19.40,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:07:25.54,0:07:33.21,Default,,0,0,0,,Аа... Аоно-кун жаңбырды жек көретінін айтты➡
Dialogue: 0,0:07:33.21,0:07:39.09,Default,,0,0,0,,Мен жаңбырды жек көрмеймін.
Dialogue: 0,0:07:39.09,0:07:43.36,Default,,0,0,0,,Тах... менің киімім су болып қалды➡
Dialogue: 0,0:07:43.36,0:07:49.90,Default,,0,0,0,,Пойыз әдеттегіден көп, сондықтан біраз қиын... ➡
Dialogue: 0,0:07:49.90,0:07:54.74,Default,,0,0,0,,Бірақ... жаңбырлы күн➡
Dialogue: 0,0:07:54.74,0:07:58.94,Default,,0,0,0,,Айтайын дегенім, сіз жасай алатын нәрселер бар ...
Dialogue: 0,0:08:00.54,0:08:03.45,Default,,0,0,0,,Иә~ Мысалы?
Dialogue: 0,0:08:03.45,0:08:06.01,Default,,0,0,0,,Не!
Dialogue: 0,0:08:06.01,0:08:10.19,Default,,0,0,0,,Ерм...➡
Dialogue: 0,0:08:10.19,0:08:13.02,Default,,0,0,0,,Ку... Кәдімгі шаш! иә?
Dialogue: 0,0:08:13.02,0:08:17.53,Default,,0,0,0,,Бұйра шашыңызды жаңбырға кінәлауға болады!
Dialogue: 0,0:08:19.33,0:08:25.13,Default,,0,0,0,,Мен өте бұйра шашпен туылғанмын...➡
Dialogue: 0,0:08:25.13,0:08:31.87,Default,,0,0,0,,Осындай күндерде жаңбырға кінәлі бола аламын ба деп ойлаймын...
Dialogue: 0,0:08:31.87,0:08:34.78,Default,,0,0,0,,Хахахахахаха...!
Dialogue: 0,0:08:34.78,0:08:39.05,Default,,0,0,0,,Кешіріңіз... Кешіріңіз! Мен біртүрлі нәрсе айтып тұрмын...
Dialogue: 0,0:08:39.05,0:08:41.08,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:41.08,0:08:44.29,Default,,0,0,0,,Бірақ рахмет.
Dialogue: 0,0:08:47.76,0:08:53.06,Default,,0,0,0,,Бірақ бұл жақсы болды. Мен Козакура-сан мені жек көреді деп ойладым...
Dialogue: 0,0:08:53.06,0:08:56.93,Default,,0,0,0,,Иә! Оның қалыпты сөйлегеніне көңілім толды.
Dialogue: 0,0:08:56.93,0:08:59.83,Default,,0,0,0,,Мен сені жек көрмеймін!
Dialogue: 0,0:08:59.83,0:09:02.74,Default,,0,0,0,,Жоқ... себебі➡
Dialogue: 0,0:09:02.74,0:09:06.74,Default,,0,0,0,,Әйтеуір аулақ болып жатыр ма деп ойлаймын.
Dialogue: 0,0:09:12.85,0:09:16.52,Default,,0,0,0,,Ах... бұл...!
Dialogue: 0,0:09:16.52,0:09:19.42,Default,,0,0,0,,Не?
Dialogue: 0,0:09:19.42,0:09:22.86,Default,,0,0,0,,Көптен бері➡
Dialogue: 0,0:09:22.86,0:09:26.69,Default,,0,0,0,,Мен бірдеңе айтайын деп едім...
Dialogue: 0,0:09:26.69,0:09:29.20,Default,,0,0,0,,Фалько…
Dialogue: 0,0:09:29.20,0:09:32.20,Default,,0,0,0,,Аоно-кун….
Dialogue: 0,0:09:35.54,0:09:39.71,Default,,0,0,0,,Сол кезде берген уәдеңіз есіңізде ме...?
Dialogue: 0,0:09:39.71,0:09:41.91,Default,,0,0,0,,А...?
Dialogue: 0,0:09:53.22,0:09:55.22,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:55.22,0:09:58.36,Default,,0,0,0,,Енді жылама, Хару.
Dialogue: 0,0:09:58.36,0:10:03.06,Default,,0,0,0,,Халдың өнері тамаша болды.
Dialogue: 0,0:10:05.23,0:10:09.90,Default,,0,0,0,,Келесі жолы тағы да бар күшімізді салайық. Эй.
Dialogue: 0,0:10:09.90,0:10:12.11,Default,,0,0,0,,Иә….
Dialogue: 0,0:10:14.58,0:10:17.48,Default,,0,0,0,,Сіз шырын ішесіз бе? Иә.
Dialogue: 0,0:10:17.48,0:10:21.25,Default,,0,0,0,,Мен оны саған сатып аламын. Иә.
Dialogue: 0,0:10:21.25,0:10:24.59,Default,,0,0,0,,Қозғалмаңыз, осында күтіңіз.
Dialogue: 0,0:10:24.59,0:10:26.59,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:34.26,0:10:40.60,Default,,0,0,0,,Эй, сен. Bruch Сізге ұнады ма?
Dialogue: 0,0:10:40.60,0:10:44.41,Default,,0,0,0,,А... аа... аа~!
Dialogue: 0,0:10:44.41,0:10:46.77,Default,,0,0,0,,Ах... бұл...!
Dialogue: 0,0:10:46.77,0:10:50.41,Default,,0,0,0,,Сіз алдыңғы жарыста Бруч ойнадыңыз, солай ма?
Dialogue: 0,0:10:50.41,0:10:55.62,Default,,0,0,0,,Бұл әкем екеуміз жиі айтатын ән болғандықтан, жаттап алдым.
Dialogue: 0,0:10:57.95,0:11:02.56,Default,,0,0,0,,Бұл Аоно-кун. Биыл тағы алып кетті.
Dialogue: 0,0:11:02.56,0:11:08.43,Default,,0,0,0,,Мен ұлым Аоно-кунның өнерін естігеннен бері мотивациямды жоғалттым және бұл өте қиын болды.
Dialogue: 0,0:11:08.43,0:11:15.24,Default,,0,0,0,,Бірақ бұл таңқаларлық. Төменгі сыныпта оқитын баланың ол әнді ойнағанын көрген емеспін.
Dialogue: 0,0:11:15.24,0:11:17.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.91,0:11:24.68,Default,,0,0,0,,Әй... анам қиын ән айтып көрейін деді...
Dialogue: 0,0:11:24.68,0:11:30.39,Default,,0,0,0,,Бірақ бәрібір қиын... ➡
Dialogue: 0,0:11:30.39,0:11:35.22,Default,,0,0,0,,Сахнада қобалжыймын...➡
Dialogue: 0,0:11:35.22,0:11:39.13,Default,,0,0,0,,Ол толығымен ақ түсті...
Dialogue: 0,0:11:39.13,0:11:46.60,Default,,0,0,0,,Тәжірибе арқылы жасай алдым, неге мен оны үнемі жасаймын?
Dialogue: 0,0:11:46.60,0:11:48.90,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:11:50.94,0:11:52.97,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:11:52.97,0:11:56.81,Default,,0,0,0,,Сіз оның қиын ән екенін біліп, ойнадыңыз, солай ма?
Dialogue: 0,0:11:56.81,0:11:59.51,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:01.55,0:12:05.72,Default,,0,0,0,,Маған да бұл ән ұнайды, сондықтан мен бақыттымын!
Dialogue: 0,0:12:05.72,0:12:08.22,Default,,0,0,0,,<Мен күлдім... ➡
Dialogue: 0,0:12:08.22,0:12:11.06,Default,,0,0,0,,Алдыңғы кезеңнен➡
Dialogue: 0,0:12:11.06,0:12:13.90,Default,,0,0,0,,Ол мүлдем басқа адам сияқты...>
Dialogue: 0,0:12:13.90,0:12:35.75,Default,,0,0,0,,♬～
Dialogue: 0,0:12:35.75,0:12:38.59,Default,,0,0,0,,<Бұл керемет... ➡
Dialogue: 0,0:12:38.59,0:12:45.59,Default,,0,0,0,,Мен бір күні Аоно-кун сияқты ойнағым келеді.
Dialogue: 0,0:12:48.26,0:12:51.77,Default,,0,0,0,,Бір күні бірге ойнаймыз деп үміттенемін. Эх...! ?
Dialogue: 0,0:12:51.77,0:12:53.80,Default,,0,0,0,,Байқауда жеңіп алсаңыз➡
Dialogue: 0,0:12:53.80,0:12:56.27,Default,,0,0,0,,Жүлдегердің тұсаукесері болады.
Dialogue: 0,0:12:56.27,0:12:58.27,Default,,0,0,0,,Сол жерде бірге ойнасақ➡
Dialogue: 0,0:12:58.27,0:13:00.21,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:13:00.21,0:13:04.01,Default,,0,0,0,,Сонымен... Бірақ мен жүлдені жеңіп алдым...
Dialogue: 0,0:13:04.01,0:13:07.22,Default,,0,0,0,,Хаджиме~ Мен жақында үйге барамын~.
Dialogue: 0,0:13:07.22,0:13:11.05,Default,,0,0,0,,Иә. Сосын мен барамын.
Dialogue: 0,0:13:11.05,0:13:12.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:12.99,0:13:15.19,Default,,0,0,0,,Уәде!
Dialogue: 0,0:13:16.86,0:13:21.36,Default,,0,0,0,,Не? Хаджиме: ол қызбен не сөйлестің?
Dialogue: 0,0:13:21.36,0:13:24.07,Default,,0,0,0,,Е, жоқ!
Dialogue: 0,0:13:24.07,0:13:33.07,Default,,0,0,0,,♬～
Dialogue: 0,0:13:33.07,0:13:35.74,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:13:35.74,0:13:40.58,Default,,0,0,0,,Бұл екінші сыныпта жарыста кездескеніміз туралы!
Dialogue: 0,0:13:40.58,0:13:43.79,Default,,0,0,0,,<Ия... Ақыры айттым! ＞
Dialogue: 0,0:13:45.39,0:13:47.76,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:13:47.76,0:13:50.56,Default,,0,0,0,,Кешіріңіз, сіз не туралы айтып тұрсыз?
Dialogue: 0,0:13:54.26,0:13:58.13,Default,,0,0,0,,Мм... мм... сәл күте тұрыңыз!
Dialogue: 0,0:13:58.13,0:14:02.34,Default,,0,0,0,,Өйткені қазір есімде! Әй... есіңде жоқ!
Dialogue: 0,0:14:02.34,0:14:05.87,Default,,0,0,0,,Бұл үлкен мәселе емес, оған алаңдамаңыз!
Dialogue: 0,0:14:05.87,0:14:08.78,Default,,0,0,0,,<Дұрыс... ➡
Dialogue: 0,0:14:08.78,0:14:12.48,Default,,0,0,0,,Бұл біз бастауыш мектепте оқып жүргенде берген уәдеміз>
Dialogue: 0,0:14:17.89,0:14:24.06,Default,,0,0,0,,<Бастауыш сынып оқушысының уәдесі ешқашан орындалмаған сияқты...>
Dialogue: 0,0:14:24.06,0:14:28.56,Default,,0,0,0,,♬～
Dialogue: 0,0:14:28.56,0:14:32.07,Default,,0,0,0,,<Бірақ…➡
Dialogue: 0,0:14:32.07,0:14:35.90,Default,,0,0,0,,Сенгім келгені сонша➡
Dialogue: 0,0:14:35.90,0:14:41.24,Default,,0,0,0,,Сіз сол күні болдыңыз...➡
Dialogue: 0,0:14:41.24,0:14:44.55,Default,,0,0,0,,Өте жарқын болды>
Dialogue: 0,0:14:48.38,0:14:51.25,Default,,0,0,0,,Жақсы ауа-райы….
Dialogue: 0,0:14:51.25,0:14:54.56,Default,,0,0,0,,Өткен күнгі жаңбыр өтірік сияқты.
Dialogue: 0,0:15:00.70,0:15:03.20,Default,,0,0,0,,Күн шуақты... иә?
Dialogue: 0,0:15:05.20,0:15:09.70,Default,,0,0,0,,Эй, эй! Келесі жолы~ Қорытынды емтиханнан кейін➡
Dialogue: 0,0:15:09.70,0:15:14.04,Default,,0,0,0,,Біз сабақта караокеге бару туралы айтып жатырмыз, балалар, қалай ойлайсыңдар?
Dialogue: 0,0:15:14.04,0:15:15.98,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:15:15.98,0:15:19.21,Default,,0,0,0,,Олай болса топқа қатысқыңыз келе ме, жоқ па айтыңыз!
Dialogue: 0,0:15:19.21,0:15:21.72,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:15:21.72,0:15:26.92,Default,,0,0,0,,<Не...не істеуім керек...? Топта жоқ...>
Dialogue: 0,0:15:36.06,0:15:41.87,Default,,0,0,0,,＜Тез... Меніңше, үйірме жұмыстарының уақыты келді...＞
Dialogue: 0,0:15:47.24,0:15:53.05,Default,,0,0,0,,<Мектепке түскенде бірдеңе өзгереді деп ойладым...>
Dialogue: 0,0:15:54.98,0:16:00.79,Default,,0,0,0,,<Бірақ шын мәнінде...➡
Dialogue: 0,0:16:00.79,0:16:03.79,Default,,0,0,0,,Ештеңе өзгермейді...>
Dialogue: 0,0:16:05.73,0:16:08.56,Default,,0,0,0,,<Ақымақ сияқты... ➡
Dialogue: 0,0:16:08.56,0:16:13.87,Default,,0,0,0,,Ештеңе жасамай өзгере алмайсың...>
Dialogue: 0,0:16:13.87,0:16:16.34,Default,,0,0,0,,Хару!
Dialogue: 0,0:16:16.34,0:16:18.71,Default,,0,0,0,,Жүр тамақ ішейік!
Dialogue: 0,0:16:18.71,0:16:21.01,Default,,0,0,0,,Риччан...!
Dialogue: 0,0:16:26.21,0:16:28.15,Default,,0,0,0,,Иә? ➡
Dialogue: 0,0:16:28.15,0:16:31.09,Default,,0,0,0,,Риччан, түскі асқа осы ғана бар ма?
Dialogue: 0,0:16:31.09,0:16:35.89,Default,,0,0,0,,Иә. Мен шыдай алмадым, сондықтан үзілісте ерте сөйледім.
Dialogue: 0,0:16:35.89,0:16:39.73,Default,,0,0,0,,Орта мектепте мұндай еркіндіктің болғаны жақсы.
Dialogue: 0,0:16:39.73,0:16:44.23,Default,,0,0,0,,Аа, енді ойлап қарасам, Рикчан балмұздақ дүкеніне барғысы келетінін айтты➡
Dialogue: 0,0:16:44.23,0:16:47.07,Default,,0,0,0,,Бүгін жарты баға күні. Шынайы! ?
Dialogue: 0,0:16:47.07,0:16:52.57,Default,,0,0,0,,Үйірме жұмыстарына барғыңыз келе ме? Барыңыз! Алақай!
Dialogue: 0,0:16:52.57,0:16:57.58,Default,,0,0,0,,<Мен Риччанмен бір орта мектепте оқығаныма қуаныштымын...>
Dialogue: 0,0:17:06.12,0:17:11.43,Default,,0,0,0,,<Жақында менде бірқатар сәтсіздіктер болды, сондықтан мен оны бүгін толтыруым керек! ＞
Dialogue: 0,0:17:15.20,0:17:18.10,Default,,0,0,0,,Бүгін біз «Карменнен» бастаймыз.
Dialogue: 0,0:17:18.10,0:17:22.70,Default,,0,0,0,,Сонымен... сіз көршісіз!
Dialogue: 0,0:17:22.70,0:17:25.74,Default,,0,0,0,,Жиренішті көрінбеу.
Dialogue: 0,0:17:25.74,0:17:29.58,Default,,0,0,0,,Өйткені сіз музыка парағын аударуды оңай ұмытып кетесіз...
Dialogue: 0,0:17:29.58,0:17:33.05,Default,,0,0,0,,Егер сіз Аоно-кун болсаңыз, оны музыка парағына қарамай-ақ алуға болады, солай ма?
Dialogue: 0,0:17:33.05,0:17:35.35,Default,,0,0,0,,Айтпақшы, менің қолымнан келеді.
Dialogue: 0,0:17:35.35,0:17:38.55,Default,,0,0,0,,Шулы. Бір сөз: бұл артық.
Dialogue: 0,0:17:38.55,0:17:41.36,Default,,0,0,0,,<Бұл екеуі жақсы дос>
Dialogue: 0,0:17:41.36,0:17:45.06,Default,,0,0,0,,Мүлдем... Мен бұл жігіттен гөрі Козакура-санмен бірге болғанды ​​жақсы көремін➡
Dialogue: 0,0:17:45.06,0:17:49.36,Default,,0,0,0,,Оны ойнау өте оңай. Ха! ? Ал... бұл дұрыс емес!
Dialogue: 0,0:17:49.36,0:17:52.73,Default,,0,0,0,,Мен әлі де ойнай алмайтын дүниелер көп...!
Dialogue: 0,0:17:52.73,0:17:55.77,Default,,0,0,0,,Себебі мен барлығының аяғын тартып жатырмын...
Dialogue: 0,0:17:55.77,0:17:59.07,Default,,0,0,0,,Аоно-кунның қасында болғандай ештеңе жоқ...!
Dialogue: 0,0:18:01.44,0:18:04.68,Default,,0,0,0,,<Жаңа ғана өзіңізді нашар сезіндіңіз бе? ➡
Dialogue: 0,0:18:04.68,0:18:08.02,Default,,0,0,0,,Мені мақтауға қиналсаң да...>
Dialogue: 0,0:18:08.02,0:18:10.82,Default,,0,0,0,,Ендеше, басынан бастайық.
Dialogue: 0,0:18:12.69,0:18:15.72,Default,,0,0,0,,<Енді мен спектакльге назар аударуым керек>
Dialogue: 0,0:18:15.72,0:18:19.56,Default,,0,0,0,,Ал, бірінші бөлімді жаттықтыруды бастайық.
Dialogue: 0,0:18:19.56,0:18:21.86,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:18:21.86,0:18:25.73,Default,,0,0,0,,♬～
Dialogue: 0,0:18:25.73,0:18:29.74,Default,,0,0,0,,<Біздің үлкендердің өнерлері де керемет болды...➡
Dialogue: 0,0:18:29.74,0:18:34.04,Default,,0,0,0,,Мен оны үнемі мұқият қадағалайтындықтан айта аламын. ➡
Dialogue: 0,0:18:34.04,0:18:38.05,Default,,0,0,0,,Бұл екі адам әртүрлі деңгейде＞
Dialogue: 0,0:18:39.71,0:18:42.22,Default,,0,0,0,,<Уау...>
Dialogue: 0,0:18:42.22,0:18:49.72,Default,,0,0,0,,♬～
Dialogue: 0,0:18:57.77,0:19:01.57,Default,,0,0,0,,Ойланып қарашы, Козакура-сан... иә?
Dialogue: 0,0:19:01.57,0:19:04.47,Default,,0,0,0,,Forte Сіз мұны жақсы емессіз, солай ма?
Dialogue: 0,0:19:04.47,0:19:08.38,Default,,0,0,0,,Не? Мен шынымен әдемі дыбыс шығара аламын➡
Dialogue: 0,0:19:08.38,0:19:13.38,Default,,0,0,0,,Дыбыс өте кішкентай болғандықтан, мен оны ысырап сияқты сезінемін ...
Dialogue: 0,0:19:16.52,0:19:19.02,Default,,0,0,0,,Әлде әдейі ме? иә?
Dialogue: 0,0:19:19.02,0:19:24.33,Default,,0,0,0,,Ал... бұл дұрыс емес! Хмм, дұрыс.
Dialogue: 0,0:19:26.89,0:19:31.70,Default,,0,0,0,,Ол үнемі өзін ұстап тұрғандай көрінетін.
Dialogue: 0,0:19:41.28,0:19:44.05,Default,,0,0,0,,Салық ұстау...?
Dialogue: 0,0:19:44.05,0:19:46.35,Default,,0,0,0,,Хару~!
Dialogue: 0,0:19:46.35,0:19:51.22,Default,,0,0,0,,Тез жүр! Мұзды мұз! А... иә.
Dialogue: 0,0:19:51.22,0:19:54.22,Default,,0,0,0,,Ах, Риччан.
Dialogue: 0,0:19:54.22,0:19:56.72,Default,,0,0,0,,Осыдан кейін бәріміз кешкі асқа шығамыз➡
Dialogue: 0,0:19:56.72,0:19:59.56,Default,,0,0,0,,Риччан да бармай ма? Ах...
Dialogue: 0,0:19:59.56,0:20:03.90,Default,,0,0,0,,Кешіріңіз, бүгіннен кейін Харумен балмұздақ жеймін деп ойладым.
Dialogue: 0,0:20:03.90,0:20:08.24,Default,,0,0,0,,Ри... Риччан, жүр! Әй, бірақ...
Dialogue: 0,0:20:08.24,0:20:11.14,Default,,0,0,0,,Балмұздақ дүкеніне кез келген уақытта бара аласыз.
Dialogue: 0,0:20:11.14,0:20:14.74,Default,,0,0,0,,Олай болса, Хару, біз де кешкі ас ішейік! Эх...
Dialogue: 0,0:20:14.74,0:20:17.78,Default,,0,0,0,,Жарайсың ба? әрине!
Dialogue: 0,0:20:17.78,0:20:20.92,Default,,0,0,0,,Мен... менде бәрі жақсы!
Dialogue: 0,0:20:20.92,0:20:25.39,Default,,0,0,0,,Кешіріңіз, Риччан! Есіңізде болсын, менде бүгін бір нәрсе істеу керек ...
Dialogue: 0,0:20:25.39,0:20:28.59,Default,,0,0,0,,Ертең кездескенше! Ах...
Dialogue: 0,0:20:28.59,0:20:30.79,Default,,0,0,0,,Корпус….
Dialogue: 0,0:20:32.39,0:20:36.20,Default,,0,0,0,,Ах. Козакура мырза ертең кездескенше...
Dialogue: 0,0:20:57.12,0:21:02.92,Default,,0,0,0,,<Рикчан, мен көп достар таптым...>
Dialogue: 0,0:21:20.44,0:21:24.91,Default,,0,0,0,,<Дұрыс, солай емес пе? ➡
Dialogue: 0,0:21:24.91,0:21:27.92,Default,,0,0,0,,Менен өзгеше＞
Dialogue: 0,0:21:29.78,0:21:34.79,Default,,0,0,0,,<Рикчанның өз әлемі бар.>
Dialogue: 0,0:21:36.62,0:21:40.26,Default,,0,0,0,,<Маған ұнамайды... ➡
Dialogue: 0,0:21:40.26,0:21:43.76,Default,,0,0,0,,«Мен өзгергім келеді» деп ойлау кезінде➡
Dialogue: 0,0:21:43.76,0:21:48.57,Default,,0,0,0,,Менің адамдардың өзгергенін қаламайтын бөлігім бар...>
Dialogue: 0,0:21:51.51,0:21:55.28,Default,,0,0,0,,<Менің мінезім нашар... ➡
Dialogue: 0,0:21:55.28,0:21:59.78,Default,,0,0,0,,Риччанға бұл сезімдерімді білдіргім келмеді...>
Dialogue: 0,0:21:59.78,0:22:03.22,Default,,0,0,0,,Эй, енді қайда барасың? О, кез келген жерде жақсы.
Dialogue: 0,0:22:03.22,0:22:06.89,Default,,0,0,0,,Хм, мен не істеуім керек? Мен аздап аш болуым мүмкін.
Dialogue: 0,0:22:06.89,0:22:09.56,Default,,0,0,0,,Мен қайтадан салмақ қосамын. Тоқта!
Dialogue: 0,0:22:09.56,0:22:11.49,Default,,0,0,0,,Мен тәтті нәрсе жегім келеді.
Dialogue: 0,0:22:11.49,0:22:14.23,Default,,0,0,0,,Фуд-корт жақсы ма? Ах, жарайды.
Dialogue: 0,0:22:14.23,0:22:25.57,Default,,0,0,0,,♬～
Dialogue: 0,0:22:25.57,0:22:27.58,Default,,0,0,0,,Хару!
Dialogue: 0,0:22:33.25,0:22:35.25,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:22:36.92,0:22:38.92,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:22:42.42,0:22:45.13,Default,,0,0,0,,Риччан….
Dialogue: 0,0:22:47.96,0:22:49.96,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:22:49.96,0:22:53.77,Default,,0,0,0,,<Мен өзімді шынымен жек көре бастаймын...>
Dialogue: 0,0:22:55.64,0:23:00.57,Default,,0,0,0,,<Соңында мен...➡
Dialogue: 0,0:23:00.57,0:23:06.38,Default,,0,0,0,,Содан бері... ештеңе өзгерген жоқ>
Dialogue: 0,0:23:10.55,0:23:13.35,Default,,0,0,0,,♬～
Dialogue: 0,0:23:13.35,0:23:18.73,Default,,0,0,0,,♬ «Бұл басталып жатыр, бәріміз осындамыз».
Dialogue: 0,0:23:18.73,0:23:23.23,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:23:23.23,0:23:33.94,Default,,0,0,0,,♬～
Dialogue: 0,0:23:33.94,0:23:39.38,Default,,0,0,0,,♬ «Мен кеңсе тауарлары мен сағаттарды кезектестіріп қараймын».
Dialogue: 0,0:23:39.38,0:23:44.75,Default,,0,0,0,,♬ «Ескерту жолдары бірден персонал белгісіне ауысады»
Dialogue: 0,0:23:44.75,0:23:49.62,Default,,0,0,0,,♬ «Күн аспанды бір сәтке бұлтқа қалдырады».
Dialogue: 0,0:23:49.62,0:23:55.26,Default,,0,0,0,,♬ «Мұңды скрипка граффити»
Dialogue: 0,0:23:55.26,0:24:04.54,Default,,0,0,0,,♬ «Мектептен кейінгі барлық байланыссыз дыбыстар тыныштандырады».
Dialogue: 0,0:24:04.54,0:24:07.44,Default,,0,0,0,,♬～
Dialogue: 0,0:24:07.44,0:24:12.88,Default,,0,0,0,,♬ «Бұл басталып жатыр, бәріміз осындамыз».
Dialogue: 0,0:24:12.88,0:24:17.72,Default,,0,0,0,,♬ «Мен бұл енді ешқашан болмайтын әлем сияқты сезінемін».
Dialogue: 0,0:24:17.72,0:24:23.36,Default,,0,0,0,,♬ "Мен көбірек ойнағым келеді. Мен көбірек ойнағым келеді."
Dialogue: 0,0:24:23.36,0:24:27.90,Default,,0,0,0,,♬ «Бір реттік шексіз музыка»
Dialogue: 0,0:24:27.90,0:24:30.23,Default,,0,0,0,,♬ «Маған бұл дыбыс ұнайды»
Dialogue: 0,0:24:30.23,0:24:39.04,Default,,0,0,0,,♬～
Dialogue: 0,0:24:40.74,0:24:57.26,Default,,0,0,0,,♬～
