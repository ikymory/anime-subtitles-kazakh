Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:41.11,0:01:42.62,Default,,0,0,0,,Жоқ, қаш.
Dialogue: 0,0:02:21.42,0:02:22.97,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:02:32.05,0:02:33.46,Default,,0,0,0,,Ал Вайолет ше?
Dialogue: 0,0:02:44.64,0:02:46.30,Default,,0,0,0,,Сен бірдеңе жасап жатқаныңды білгенмін!
Dialogue: 0,0:02:55.70,0:02:57.03,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:03:27.06,0:03:27.82,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:03:28.80,0:03:30.56,Default,,0,0,0,,Барлығы күмәнмен қарады.
Dialogue: 0,0:03:43.93,0:03:44.80,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:03:46.24,0:03:47.84,Default,,0,0,0,,Ешкім қашып кетпеді ме?
Dialogue: 0,0:03:50.16,0:03:50.66,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:50.69,0:03:53.06,Default,,0,0,0,,Қан тоқтады, бұл үлкен мәселе емес.
Dialogue: 0,0:03:53.71,0:03:55.58,Default,,0,0,0,,Өтінемін, бұл жерден қозғалмаңыз.
Dialogue: 0,0:03:55.81,0:03:56.49,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:04:01.37,0:04:02.19,Default,,0,0,0,,Мацуи мырза
Dialogue: 0,0:04:02.83,0:04:03.60,Default,,0,0,0,,Тасу
Dialogue: 0,0:04:15.71,0:04:16.83,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:04:17.74,0:04:20.22,Default,,0,0,0,,Бұл бала есімде.
Dialogue: 0,0:04:20.35,0:04:21.34,Default,,0,0,0,,Менің есімде
Dialogue: 0,0:04:21.41,0:04:24.04,Default,,0,0,0,,Бұл дұрыс емес болды ма?
Dialogue: 0,0:04:24.19,0:04:26.22,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:26.74,0:04:29.97,Default,,0,0,0,,Сугиура мырза бұл Мисаки мырза екенін айтты.
Dialogue: 0,0:04:30.40,0:04:31.21,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:04:32.59,0:04:34.43,Default,,0,0,0,,Мен сізді «өлі» деп ойлаймын
Dialogue: 0,0:04:35.50,0:04:37.87,Default,,0,0,0,,Биылғы жыл мамыр айында басталды, солай емес пе?
Dialogue: 0,0:04:38.40,0:04:41.90,Default,,0,0,0,,Сонда мамыр айында көбейген адамдар «өлгендер» болуы керек, солай емес пе?
Dialogue: 0,0:04:45.13,0:04:45.73,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:45.94,0:04:47.90,Default,,0,0,0,,Биыл сәуір айында басталды.
Dialogue: 0,0:04:48.70,0:04:50.69,Default,,0,0,0,,Мұндай тапсырмаға кім сенеді?
Dialogue: 0,0:05:09.89,0:05:11.53,Default,,0,0,0,,Казами-кун, неге?
Dialogue: 0,0:05:12.03,0:05:14.69,Default,,0,0,0,,Мені Тешигахара өлтіретін болды және білдім.
Dialogue: 0,0:05:15.00,0:05:16.92,Default,,0,0,0,,«Өлілерді» өлімге қайтармасақ
Dialogue: 0,0:05:17.67,0:05:18.88,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:05:19.06,0:05:19.77,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:05:19.80,0:05:20.79,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:05:20.92,0:05:22.33,Default,,0,0,0,,Тіпті басқа мектепке ауысу керек.
Dialogue: 0,0:05:22.35,0:05:23.79,Default,,0,0,0,,Юкари өлген жоқ
Dialogue: 0,0:05:24.09,0:05:25.73,Default,,0,0,0,,Сакураги мырза
Dialogue: 0,0:05:25.78,0:05:28.75,Default,,0,0,0,,«Онда жоқ нәрселерге» жақындау керек
Dialogue: 0,0:05:32.78,0:05:34.36,Default,,0,0,0,,«Өлілерді» өлімге қайтарыңыз
Dialogue: 0,0:05:42.17,0:05:43.22,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:05:43.51,0:05:45.68,Default,,0,0,0,,Коичи-кун «өлі» емес.
Dialogue: 0,0:05:46.41,0:05:50.12,Default,,0,0,0,,Казами-кун, мен сені де өлтірдім.
Dialogue: 0,0:05:50.48,0:05:52.30,Default,,0,0,0,,Тірі болудың мәні жоқ.
Dialogue: 0,0:05:53.26,0:05:54.66,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:05:55.64,0:05:57.65,Default,,0,0,0,,Байланысты орынға өтіңіз
Dialogue: 0,0:06:02.20,0:06:06.91,Default,,0,0,0,,Бұл ескі достардың бірін-бірі өлтіруі сияқты ақымақтық емес.
Dialogue: 0,0:06:08.53,0:06:09.78,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:06:10.25,0:06:13.54,Default,,0,0,0,,Өлімнен қорқып, шетке қарай қашқандар үшін.
Dialogue: 0,0:06:13.84,0:06:15.47,Default,,0,0,0,,Менің ештеңе айтуға құқығым жоқ.
Dialogue: 0,0:06:16.02,0:06:17.67,Default,,0,0,0,,Мен, әрине, қашып кеттім.
Dialogue: 0,0:06:18.52,0:06:22.42,Default,,0,0,0,,Бірақ менің қолымнан келетін жалғыз нәрсе - менің алдымда себепсіз өліп жатқан студенттерді құтқару.
Dialogue: 0,0:06:22.51,0:06:24.69,Default,,0,0,0,,Байқаушы ретінде сіз ештеңе істей алмайсыз.
Dialogue: 0,0:06:24.74,0:06:25.81,Default,,0,0,0,,Ештеңе істеу мүмкін емес
Dialogue: 0,0:06:25.85,0:06:29.14,Default,,0,0,0,,Жағдайды өзгерте алатын жалғыз адамдар - өлі аймақта қалғандар.
Dialogue: 0,0:06:38.08,0:06:39.51,Default,,0,0,0,,Сакакибара-кун да сыртқа шығады.
Dialogue: 0,0:06:43.52,0:06:44.37,Default,,0,0,0,,Казами
Dialogue: 0,0:06:46.11,0:06:47.65,Default,,0,0,0,,Сәлем Казами
Dialogue: 0,0:06:47.87,0:06:48.56,Default,,0,0,0,,Эй
Dialogue: 0,0:06:53.38,0:06:54.09,Default,,0,0,0,,Эй
Dialogue: 0,0:06:55.16,0:06:56.99,Default,,0,0,0,,Ақымақ болма, эй
Dialogue: 0,0:06:59.60,0:07:00.92,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:07:01.22,0:07:04.61,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын.
Dialogue: 0,0:07:21.12,0:07:22.71,Default,,0,0,0,,Мисаки әлі де ішінде.
Dialogue: 0,0:07:26.59,0:07:27.38,Default,,0,0,0,,Мисаки
Dialogue: 0,0:07:27.86,0:07:29.30,Default,,0,0,0,,Бар болса, жауап беріңіз.
Dialogue: 0,0:07:57.99,0:07:58.88,Default,,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:08:03.87,0:08:05.61,Default,,0,0,0,,Өтінемін, тоқтатыңыз.
Dialogue: 0,0:08:08.42,0:08:10.66,Default,,0,0,0,,Бұл баланы өлтірмесең, бәрі өледі.
Dialogue: 0,0:08:10.79,0:08:12.45,Default,,0,0,0,,Тіпті Коуичи-кун өлуі мүмкін.
Dialogue: 0,0:08:12.46,0:08:13.36,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:13.48,0:08:14.71,Default,,0,0,0,,Мисаки «өлі» емес
Dialogue: 0,0:08:16.80,0:08:19.97,Default,,0,0,0,,Осы баланы өлтірсек, апат тоқтамаса
Dialogue: 0,0:08:20.00,0:08:21.42,Default,,0,0,0,,Мен мұны мойындаймын
Dialogue: 0,0:09:10.13,0:09:13.23,Default,,0,0,0,,Бұл тоқтайды
Dialogue: 0,0:09:22.35,0:09:23.46,Default,,0,0,0,,Шамамен жиырма минуттай уақыт алады деп ойлаймын.
Dialogue: 0,0:09:39.60,0:09:40.53,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:40.72,0:09:41.65,Default,,0,0,0,,Соншалықты
Dialogue: 0,0:09:42.81,0:09:44.47,Default,,0,0,0,,Мен сені қорғауға тырыссам да
Dialogue: 0,0:09:44.52,0:09:45.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:48.54,0:09:50.36,Default,,0,0,0,,Егер сіз сонша өлгіңіз келсе
Dialogue: 0,0:09:50.76,0:09:52.37,Default,,0,0,0,,Мен сені сенімен бірге өлтіремін.
Dialogue: 0,0:10:04.08,0:10:07.50,Default,,0,0,0,,Ағаңның ақымақтығы
Dialogue: 0,0:10:08.40,0:10:08.97,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:09.29,0:10:11.21,Default,,0,0,0,,Кешіріңіз, жақсысыз ба?
Dialogue: 0,0:10:15.61,0:10:16.39,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:30.16,0:10:33.43,Default,,0,0,0,,Сіз Йомикитадан емессіз, солай ма?
Dialogue: 0,0:10:33.62,0:10:35.88,Default,,0,0,0,,Иә, мен Токиодан келдім.
Dialogue: 0,0:10:36.57,0:10:37.27,Default,,0,0,0,,Иә
Dialogue: 0,0:10:41.88,0:10:43.43,Default,,0,0,0,,Бір жері ауырады
Dialogue: 0,0:10:44.34,0:10:45.21,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:46.53,0:10:49.34,Default,,0,0,0,,Өйткені мен үшін маңызды біреу қайтыс болды.
Dialogue: 0,0:10:51.12,0:10:52.12,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:10:54.21,0:10:57.84,Default,,0,0,0,,Сонда сен де мен сияқтысың.
Dialogue: 0,0:11:31.32,0:11:32.79,Default,,0,0,0,,Бір жарым жыл бұрын
Dialogue: 0,0:11:34.26,0:11:36.35,Default,,0,0,0,,Саған бос құты лақтырдым
Dialogue: 0,0:11:38.03,0:11:39.19,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:11:39.25,0:11:39.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.87,0:11:44.99,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:11:45.89,0:11:46.99,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:11:48.57,0:11:49.91,Default,,0,0,0,,Өтірік болса жақсы
Dialogue: 0,0:11:50.68,0:11:53.44,Default,,0,0,0,,Есіңізде болса, соны айтыңыз.
Dialogue: 0,0:11:57.07,0:11:58.48,Default,,0,0,0,,Акадава мырза
Dialogue: 0,0:12:20.70,0:12:21.51,Default,,0,0,0,,Мисаки
Dialogue: 0,0:12:22.31,0:12:23.34,Default,,0,0,0,,Мисаки
Dialogue: 0,0:12:25.57,0:12:26.98,Default,,0,0,0,,Жарайды, мен тірімін.
Dialogue: 0,0:12:28.90,0:12:30.87,Default,,0,0,0,,Мені қосыңыз
Dialogue: 0,0:12:46.57,0:12:47.61,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:12:47.64,0:12:49.28,Default,,0,0,0,,Мисаки сенің жақсысың деп үміттенемін.
Dialogue: 0,0:12:49.55,0:12:50.13,Default,,0,0,0,,Иә
Dialogue: 0,0:12:50.16,0:12:51.00,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:12:52.45,0:12:53.37,Default,,0,0,0,,Аула
Dialogue: 0,0:12:53.50,0:12:54.38,Default,,0,0,0,,Жарақат алмаған
Dialogue: 0,0:12:54.48,0:12:55.77,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:12:56.37,0:12:58.71,Default,,0,0,0,,Бірақ мен қозғала алмаймын.
Dialogue: 0,0:12:59.57,0:13:00.95,Default,,0,0,0,,Мен барамын, мен бірден кетемін
Dialogue: 0,0:13:00.96,0:13:01.47,Default,,0,0,0,,Онда
Dialogue: 0,0:13:01.13,0:13:02.27,Default,,0,0,0,,Келмегені жақсы.
Dialogue: 0,0:13:03.18,0:13:03.98,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:04.70,0:13:07.83,Default,,0,0,0,,Келмегенің жақсы, Сақақибара-күн.
Dialogue: 0,0:13:08.01,0:13:09.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:10.09,0:13:10.98,Default,,0,0,0,,I
Dialogue: 0,0:13:12.51,0:13:13.92,Default,,0,0,0,,Мен оны тоқтатуым керек
Dialogue: 0,0:13:15.90,0:13:17.50,Default,,0,0,0,,Мисаки
Dialogue: 0,0:13:18.22,0:13:19.68,Default,,0,0,0,,Кімді айта аламын?
Dialogue: 0,0:13:20.40,0:13:21.88,Default,,0,0,0,,Сіз өкінуіңіз мүмкін
Dialogue: 0,0:13:22.68,0:13:23.58,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:33.29,0:13:34.51,Default,,0,0,0,,Мисаки
Dialogue: 0,0:13:37.55,0:13:38.39,Default,,0,0,0,,Мисаки
Dialogue: 0,0:13:41.18,0:13:42.18,Default,,0,0,0,,Келме
Dialogue: 0,0:13:47.03,0:13:47.83,Default,,0,0,0,,және Қабырғаларды жоюды жоспарлап жүргендерді қудалау қиындайды.
Dialogue: 0,0:13:47.85,0:13:49.06,Default,,0,0,0,,Маған көмектеспе
Dialogue: 0,0:13:50.44,0:13:54.18,Default,,0,0,0,,Өйткені мен «өлім» түсін көре аламын
Dialogue: 0,0:13:56.14,0:13:58.92,Default,,0,0,0,,Мен мұны жаңа білдім
Dialogue: 0,0:14:00.76,0:14:05.13,Default,,0,0,0,,Мен мұны бұрын білдім, бірақ айта алмадым.
Dialogue: 0,0:14:05.74,0:14:08.89,Default,,0,0,0,,Бірақ.
Dialogue: 0,0:14:09.15,0:14:10.92,Default,,0,0,0,,Мен мұны қазір тоқтатуым керек
Dialogue: 0,0:14:11.42,0:14:12.25,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:14:17.29,0:14:18.46,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:14:18.68,0:14:20.79,Default,,0,0,0,,Амал жоқ, амал жоқ
Dialogue: 0,0:14:21.90,0:14:22.73,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:14:23.91,0:14:25.88,Default,,0,0,0,,Бұл адам «басқасы»
Dialogue: 0,0:14:27.49,0:14:28.34,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:14:30.61,0:14:32.47,Default,,0,0,0,,Бұл шынымен
Dialogue: 0,0:14:34.32,0:14:35.46,Default,,0,0,0,,Миками мырза
Dialogue: 0,0:14:36.40,0:14:38.91,Default,,0,0,0,,Рейко – «басқа адам»
Dialogue: 0,0:14:39.31,0:14:40.33,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:14:41.42,0:14:44.55,Default,,0,0,0,,Сонымен, Йомикитада дайындалатын төртінші нәрсе
Dialogue: 0,0:14:49.39,0:14:51.78,Default,,0,0,0,,Қоғамдық және жеке арасындағы нақты айырмашылықты жасаңыз.
Dialogue: 0,0:14:52.29,0:14:55.41,Default,,0,0,0,,Қателессең де, мектепте мені Рейко-сан деп атама.
Dialogue: 0,0:14:55.62,0:15:00.09,Default,,0,0,0,,Мектепте мен тек Миками мырзаның сынып жетекшісінің көмекшісімін.
Dialogue: 0,0:15:00.30,0:15:01.00,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:15:01.75,0:15:06.02,Default,,0,0,0,,Бұл мектепте басқа сыныптарда қанша мұғалім бар?
Dialogue: 0,0:15:06.46,0:15:07.48,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:15:08.13,0:15:09.04,Default,,0,0,0,,Онда емес пе?
Dialogue: 0,0:15:09.95,0:15:13.71,Default,,0,0,0,,Мектептегі тек 3 және 3 сыныптарда ғана қосалқы мұғалім бар.
Dialogue: 0,0:15:15.01,0:15:18.60,Default,,0,0,0,,Биыл сыныпта парта жеткілікті болды.
Dialogue: 0,0:15:19.48,0:15:22.39,Default,,0,0,0,,Дегенмен, апат сәуір айында басталды.
Dialogue: 0,0:15:23.29,0:15:24.60,Default,,0,0,0,,Неліктен олай ойлайсыз?
Dialogue: 0,0:15:26.31,0:15:28.47,Default,,0,0,0,,Бір үстел жетіспеді.
Dialogue: 0,0:15:30.20,0:15:31.57,Default,,0,0,0,,Бұл қызметкерлер бөлмесі.
Dialogue: 0,0:15:32.96,0:15:33.79,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:15:34.30,0:15:35.27,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:15:37.53,0:15:40.02,Default,,0,0,0,,Сакакибара-кун, артқа шегін.
Dialogue: 0,0:16:00.94,0:16:02.80,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:16:06.64,0:16:08.81,Default,,0,0,0,,«Өлілерді» өлімге қайтарыңыз
Dialogue: 0,0:16:10.34,0:16:11.54,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:16:12.01,0:16:14.24,Default,,0,0,0,,Кешіріңіз Рейко-сан
Dialogue: 0,0:16:17.17,0:16:18.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:18.38,0:16:19.40,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:21.19,0:16:22.03,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:16:22.39,0:16:23.48,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:16:23.98,0:16:25.40,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:16:25.96,0:16:27.08,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:16:27.93,0:16:29.19,Default,,0,0,0,,Егер мен қателессем
Dialogue: 0,0:16:29.71,0:16:31.23,Default,,0,0,0,,Мен Рейкомын
Dialogue: 0,0:16:31.85,0:16:32.91,Default,,0,0,0,,Мисаки не айтты
Dialogue: 0,0:16:33.26,0:16:34.70,Default,,0,0,0,,Көздер туралы бұл рас па?
Dialogue: 0,0:16:34.91,0:16:36.15,Default,,0,0,0,,Мен сене аламын ба?
Dialogue: 0,0:16:36.93,0:16:38.08,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:16:38.69,0:16:40.30,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:16:41.80,0:16:42.83,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:17:22.30,0:17:24.49,Default,,0,0,0,,Миками Сенсейдің өлтірілгенін көру
Dialogue: 0,0:17:25.00,0:17:26.68,Default,,0,0,0,,Мен оны бір жарым жыл бұрын көрдім.
Dialogue: 0,0:17:27.85,0:17:30.10,Default,,0,0,0,,Көңіл көтер, көңіл көтер.
Dialogue: 0,0:17:30.60,0:17:33.72,Default,,0,0,0,,Неге, неге, Ре-чан
Dialogue: 0,0:17:34.09,0:17:36.73,Default,,0,0,0,,Шамамен бір жарым жыл бұрын
Dialogue: 0,0:17:37.19,0:17:38.60,Default,,0,0,0,,Үй жануарлары дүкенінде.
Dialogue: 0,0:17:39.74,0:17:42.51,Default,,0,0,0,,Йомияма тауын бір жарым жыл ішінде алғаш рет көру қандай?
Dialogue: 0,0:17:42.85,0:17:44.38,Default,,0,0,0,,Бір жарым жыл бұрын
Dialogue: 0,0:17:44.50,0:17:46.56,Default,,0,0,0,,Саған бос құты лақтырдым
Dialogue: 0,0:17:46.90,0:17:48.06,Default,,0,0,0,,Соңғы үш күнде, әдеттегідей, әр түнде түн ортасынан кейін бір бет.
Dialogue: 0,0:17:48.40,0:17:51.82,Default,,0,0,0,,Адамдар өлгенде жаназасы бар.
Dialogue: 0,0:17:52.26,0:17:54.34,Default,,0,0,0,,Мен енді жерлеуге шыдай алмаймын.
Dialogue: 0,0:17:54.87,0:17:56.48,Default,,0,0,0,,Сабырлы боласыз деп үміттенемін.
Dialogue: 0,0:17:57.19,0:17:58.90,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:17:58.92,0:18:01.86,Default,,0,0,0,,Рицуко және Рейко
Dialogue: 0,0:18:06.24,0:18:07.33,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:18:47.78,0:18:48.66,Default,,0,0,0,,Рейко
Dialogue: 0,0:18:50.73,0:18:54.08,Default,,0,0,0,,Қош бол Рейко-сан
Dialogue: 0,0:19:02.94,0:19:06.51,Default,,0,0,0,,Қош бол анашым
Dialogue: 0,0:19:23.08,0:19:23.98,Default,,0,0,0,,Ол келе жатыр еді.
Dialogue: 0,0:19:27.40,0:19:29.15,Default,,0,0,0,,Қазір кеудем жақсы.
Dialogue: 0,0:19:29.63,0:19:30.44,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:19:30.84,0:19:33.20,Default,,0,0,0,,Бірақ дене тәрбиесі мүмкін емес деп ойлаймын.
Dialogue: 0,0:19:34.29,0:19:36.59,Default,,0,0,0,,Барлығының есінде жоқ.
Dialogue: 0,0:19:37.03,0:19:38.54,Default,,0,0,0,,Миками мырза туралы
Dialogue: 0,0:19:39.18,0:19:41.42,Default,,0,0,0,,Жалғыз біз бе?
Dialogue: 0,0:19:46.79,0:19:48.52,Default,,0,0,0,,Мен аздап уайымдаған сияқтымын.
Dialogue: 0,0:19:49.00,0:19:52.72,Default,,0,0,0,,​​Сакакибара-кун тоғызыншы құрбан бола ма?
Dialogue: 0,0:19:53.72,0:19:56.14,Default,,0,0,0,,Сегіз адам қайтыс болды.
Dialogue: 0,0:19:57.30,0:20:01.12,Default,,0,0,0,,Техникалық тұрғыдан алғанда тамыз айында он құрбан болды.
Dialogue: 0,0:20:01.58,0:20:03.65,Default,,0,0,0,,Қалған екеуі кім?
Dialogue: 0,0:20:03.73,0:20:05.16,Default,,0,0,0,,Бұл менеджер мен оның әйелі.
Dialogue: 0,0:20:06.54,0:20:09.14,Default,,0,0,0,,Такабаяси-кунның анасы жағынан ата-әжесі.
Dialogue: 0,0:20:10.07,0:20:11.68,Default,,0,0,0,,Такабаяси-кун қайтыс болғаннан кейін
Dialogue: 0,0:20:12.52,0:20:15.44,Default,,0,0,0,,Оның психикалық жағдайы жақсы болмағанға ұқсайды.
Dialogue: 0,0:20:16.61,0:20:20.44,Default,,0,0,0,,Миками мырза бір жарым жыл бұрын күзде қайтыс болды.
Dialogue: 0,0:20:21.80,0:20:25.34,Default,,0,0,0,,Йомияма өзенінің бойында өтіп бара жатқан адам мені пышақтап кетті.
Dialogue: 0,0:20:26.65,0:20:28.44,Default,,0,0,0,,Мен есімде жоқ
Dialogue: 0,0:20:29.82,0:20:32.36,Default,,0,0,0,,Биылғы «өлген» Миками мырза болды.
Dialogue: 0,0:20:33.98,0:20:38.71,Default,,0,0,0,,Сонымен, өткен жылы апаттан қайтыс болған жеті адам болуы керек пе еді?
Dialogue: 0,0:20:39.00,0:20:41.73,Default,,0,0,0,,Иә, жеті жаза белгісі болды.
Dialogue: 0,0:20:44.17,0:20:47.58,Default,,0,0,0,,Өткен жылғы файл Аты Акадава болды, солай ма?
Dialogue: 0,0:20:48.19,0:20:49.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:49.06,0:20:51.67,Default,,0,0,0,,Иә, Акадава-кунның немере ағасы.
Dialogue: 0,0:20:52.10,0:20:53.93,Default,,0,0,0,,Шамасы, олар іні-қарындас болып өскен.
Dialogue: 0,0:20:55.94,0:20:57.55,Default,,0,0,0,,Саған мінгізейін бе?
Dialogue: 0,0:20:58.32,0:21:01.14,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:21:01.30,0:21:04.76,Default,,0,0,0,,Түсіндім, үйге бара жатқанда абай бол.
Dialogue: 0,0:21:05.79,0:21:10.24,Default,,0,0,0,,Жоқ, апат қазірдің өзінде аяқталды.
Dialogue: 0,0:21:17.43,0:21:21.14,Default,,0,0,0,,Рейко-сан: Миками мырза – «басқасы»
Dialogue: 0,0:21:22.73,0:21:23.81,Default,,0,0,0,,Мұны қашаннан бері істедің?
Dialogue: 0,0:21:25.14,0:21:26.27,Default,,0,0,0,,Бір күні
Dialogue: 0,0:21:28.37,0:21:29.31,Default,,0,0,0,,Көк, көк…
Dialogue: 0,0:21:30.73,0:21:32.28,Default,,0,0,0,,Неге маған айтпадың?
Dialogue: 0,0:21:33.07,0:21:34.93,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:21:36.39,0:21:38.53,Default,,0,0,0,,Оның үстіне Сақақибара-күнге айта алмаймын.
Dialogue: 0,0:21:39.16,0:21:42.33,Default,,0,0,0,,Ол ерекше адам болса керек, Миками мырза.
Dialogue: 0,0:21:43.44,0:21:44.56,Default,,0,0,0,,Рейко деген кім?
Dialogue: 0,0:21:49.92,0:21:52.55,Default,,0,0,0,,Сол ойын-сауық саябағына барамыз ба?
Dialogue: 0,0:21:55.33,0:21:56.53,Default,,0,0,0,,Бұл айналмалы доңғалақ
Dialogue: 0,0:21:58.33,0:21:59.62,Default,,0,0,0,,Мен бұған мінбеймін.
Dialogue: 0,0:21:59.89,0:22:00.71,Default,,0,0,0,,Иә
Dialogue: 0,0:22:03.69,0:22:06.52,Default,,0,0,0,,Мен сені кеше ауруханадан шақырдым.
Dialogue: 0,0:22:07.69,0:22:09.28,Default,,0,0,0,,Мен ұялы телефоныма қоңырау шалып көрдім.
Dialogue: 0,0:22:09.58,0:22:10.92,Default,,0,0,0,,Мен мұны мүлдем түсіне алмаймын.
Dialogue: 0,0:22:11.90,0:22:12.73,Default,,0,0,0,,Осымен.
Dialogue: 0,0:22:14.01,0:22:15.69,Default,,0,0,0,,Осыдан кейін мен оны өзенге тастадым.
Dialogue: 0,0:22:15.72,0:22:17.43,Default,,0,0,0,,Неге?
Dialogue: 0,0:22:17.99,0:22:19.33,Default,,0,0,0,,Өйткені бұл жиіркенішті машина.
Dialogue: 0,0:22:20.18,0:22:22.45,Default,,0,0,0,,Үнемі қосылып тұрудың қажеті жоқ.
Dialogue: 0,0:22:23.09,0:22:27.60,Default,,0,0,0,,Бірақ олар жақында жаңасын алады деп ойлаймын.
Dialogue: 0,0:22:28.61,0:22:32.07,Default,,0,0,0,,Жаңасын алсаңыз, оны тіпті киюге болады.
Dialogue: 0,0:22:34.36,0:22:36.41,Default,,0,0,0,,Кездейсоқ
Dialogue: 0,0:22:38.11,0:22:42.01,Default,,0,0,0,,Иә, мен мұны Мочизукиден алдым.
Dialogue: 0,0:22:43.32,0:22:45.34,Default,,0,0,0,,Суретте Рейко бар, солай ма?
Dialogue: 0,0:22:45.84,0:22:46.61,Default,,0,0,0,,Иә
Dialogue: 0,0:22:47.70,0:22:49.77,Default,,0,0,0,,Мені ешкім көрмегендей болды.
Dialogue: 0,0:22:50.89,0:22:54.27,Default,,0,0,0,,Тіпті Мочизуки Рейконы байқамады.
Dialogue: 0,0:22:54.82,0:22:55.60,Default,,0,0,0,,Иә
Dialogue: 0,0:22:56.45,0:22:57.22,Default,,0,0,0,,Түсі
Dialogue: 0,0:22:57.98,0:23:00.14,Default,,0,0,0,,Рейконың түсі қалай көрінеді?
Dialogue: 0,0:23:03.72,0:23:06.20,Default,,0,0,0,,Мен «өлімнің» түсін көре аламын
Dialogue: 0,0:23:08.89,0:23:12.41,Default,,0,0,0,,Енді біз де бірте-бірте ұмытып кетеміз бе деп ойлаймын.
Dialogue: 0,0:23:13.20,0:23:14.51,Default,,0,0,0,,Сол оқу-жаттығу жиыны туралы
Dialogue: 0,0:23:15.09,0:23:16.36,Default,,0,0,0,,Сәуір айынан бастап
Dialogue: 0,0:23:17.29,0:23:20.25,Default,,0,0,0,,Рейко Микамиге қатысты әртүрлі нәрселер
Dialogue: 0,0:23:23.07,0:23:24.15,Default,,0,0,0,,Олардың барлығы
Dialogue: 0,0:23:27.74,0:23:29.50,Default,,0,0,0,,Мен соншалықты ұмытқым келмейді
Dialogue: 0,0:23:30.70,0:23:32.19,Default,,0,0,0,,Мен оны мәңгі есте сақтағым келеді
Dialogue: 0,0:24:00.32,0:24:01.50,Default,,0,0,0,,Бітті, солай ма?
Dialogue: 0,0:24:15.29,0:24:30.16,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:24:33.03,0:24:47.92,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:24:47.94,0:24:56.92,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:24:56.92,0:25:06.17,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:25:06.66,0:25:15.66,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:25:15.66,0:25:34.62,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:25:41.36,0:25:43.56,Default,,0,0,0,,Бұл «апатты» тоқтатудың жолы
Dialogue: 0,0:25:44.56,0:25:47.63,Default,,0,0,0,,Мұны қалай түсінетініңіз сізге байланысты.
Dialogue: 0,0:25:48.38,0:25:51.34,Default,,0,0,0,,Тек әрекет етуден бұрын мұқият ойлануыңызды қалаймын.
Dialogue: 0,0:25:51.95,0:25:53.26,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:25:53.65,0:25:55.44,Default,,0,0,0,,Айналаңыздағы достарыңызбен кеңесіңіз
Dialogue: 0,0:25:57.13,0:25:58.58,Default,,0,0,0,,Өкінбеңіз
Dialogue: 0,0:26:00.08,0:26:05.08,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
