Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.04,0:00:08.65,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:00:24.89,0:00:28.05,Default,,0,0,0,,Түнде қабақты ашу
Dialogue: 0,0:00:28.11,0:00:32.12,Default,,0,0,0,,Мен жаман көлеңкеден қорқамын
Dialogue: 0,0:00:35.14,0:00:39.88,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:00:41.43,0:00:47.94,Default,,0,0,0,,Құлаған қуыршақ сияқты
Dialogue: 0,0:00:48.43,0:00:53.14,Default,,0,0,0,,Денем қызарып, қатып қалады.
Dialogue: 0,0:00:54.63,0:01:01.38,Default,,0,0,0,,Жүрек қараңғыда өседі
Dialogue: 0,0:01:01.70,0:01:04.97,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:01:04.97,0:01:08.04,Default,,0,0,0,,Ұстаған қолдарымыздың салқындығы
Dialogue: 0,0:01:08.07,0:01:11.20,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:01:11.26,0:01:15.27,Default,,0,0,0,,Қастарыңа қара.
Dialogue: 0,0:01:16.05,0:01:22.74,Default,,0,0,0,,Жұмбақ аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:01:22.82,0:01:26.35,Default,,0,0,0,,Қанаттары мен аяқтары жұлынған
Dialogue: 0,0:01:26.41,0:01:29.80,Default,,0,0,0,,Бос жерде шіріп кетудің орнына
Dialogue: 0,0:01:29.83,0:01:33.08,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:01:33.10,0:01:38.18,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:01:39.65,0:01:45.28,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:01:50.39,0:01:54.30,Default,,0,0,0,,Санае Мизуно дедіңіз бе?
Dialogue: 0,0:01:54.48,0:01:57.84,Default,,0,0,0,,Коичи екеуің кітаптар туралы сөйлестіңдер.
Dialogue: 0,0:01:58.27,0:01:59.74,Default,,0,0,0,,Сіз әлі жассыз.
Dialogue: 0,0:02:00.03,0:02:01.65,Default,,0,0,0,,Мен де інім үшін алаңдаймын.
Dialogue: 0,0:02:02.63,0:02:04.52,Default,,0,0,0,,Сенің інің бар ма?
Dialogue: 0,0:02:04.82,0:02:08.09,Default,,0,0,0,,Оның аты Такеши-кун және менімен бір сыныпта оқиды.
Dialogue: 0,0:02:08.30,0:02:10.72,Default,,0,0,0,,О, бұл маған ұнамайды.
Dialogue: 0,0:02:11.35,0:02:14.28,Default,,0,0,0,,Бір күні менің сыныбымдағы бір бала апаттан қайтыс болды.
Dialogue: 0,0:02:14.68,0:02:18.05,Default,,0,0,0,,Біреу өлсе, жаназа болады.
Dialogue: 0,0:02:18.97,0:02:23.12,Default,,0,0,0,,Жаназаға шыдайсың деп үміттенемін.
Dialogue: 0,0:02:24.31,0:02:27.87,Default,,0,0,0,,Сен жерлеуге шыдайсың деп үміттенемін.
Dialogue: 0,0:02:29.53,0:02:33.36,Default,,0,0,0,,Мизуно-кунның әпкесімен болған оқиға мені қатты таң қалдырды.
Dialogue: 0,0:02:34.36,0:02:35.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:35.92,0:02:39.00,Default,,0,0,0,,Барлығымыз бар күшімізді салсақ, оны міндетті түрде жеңеміз.
Dialogue: 0,0:03:03.35,0:03:04.13,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:05.78,0:03:10.39,Default,,0,0,0,,Мизуноның үлкен әпкесі кешегі апаттан қайтыс болды.
Dialogue: 0,0:03:12.49,0:03:13.15,Default,,0,0,0,,Иә
Dialogue: 0,0:03:29.08,0:03:31.25,Default,,0,0,0,,Мұғалім, не болды?
Dialogue: 0,0:03:32.67,0:03:34.91,Default,,0,0,0,,Мен сондай ауырып жатырмын ба?
Dialogue: 0,0:03:35.53,0:03:37.18,Default,,0,0,0,,Мен өзімді жақсы сезінбедім.
Dialogue: 0,0:03:37.67,0:03:38.38,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:38.95,0:03:40.63,Default,,0,0,0,,Нене Сакакибара-кун
Dialogue: 0,0:03:41.40,0:03:42.05,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:03:42.34,0:03:47.77,Default,,0,0,0,,Менің ойымша, доктор Миками өміріне қауіп төндіретін ауыр ауру түрі бар деп ойламаймын.
Dialogue: 0,0:03:47.90,0:03:51.32,Default,,0,0,0,,Жарайды деп ойлаймын.
Dialogue: 0,0:03:51.49,0:03:53.53,Default,,0,0,0,,Дұрыс, иә.
Dialogue: 0,0:03:54.03,0:03:55.43,Default,,0,0,0,,Сіз соншалықты алаңдайсыз ба?
Dialogue: 0,0:03:55.79,0:03:59.90,Default,,0,0,0,,Бір күні Сакураги мырзамен де осындай жағдай болды.
Dialogue: 0,0:04:00.50,0:04:02.79,Default,,0,0,0,,Бұл жолы Мизуно-кунның үлкен әпкесі болады.
Dialogue: 0,0:04:03.09,0:04:03.73,Default,,0,0,0,,Сонымен
Dialogue: 0,0:04:04.21,0:04:04.99,Default,,0,0,0,,Бұл байланысты ма?
Dialogue: 0,0:04:05.48,0:04:07.24,Default,,0,0,0,,Соңғы апаттар мен қосылымдар
Dialogue: 0,0:04:08.59,0:04:09.57,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:04:15.89,0:04:16.90,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:04:17.31,0:04:18.22,Default,,0,0,0,,Зерттеу
Dialogue: 0,0:04:34.94,0:04:38.10,Default,,0,0,0,,Түсінемін, Мисаки есімінің болуы мүмкін емес.
Dialogue: 0,0:04:47.89,0:04:48.90,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:04:50.37,0:04:51.59,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:04:52.27,0:04:52.97,Default,,0,0,0,,Иә
Dialogue: 0,0:04:53.95,0:04:56.90,Default,,0,0,0,,Бірақ дәл 72 жыл деген не?
Dialogue: 0,0:04:58.03,0:05:00.00,Default,,0,0,0,,Сенің анаң қай сыныпта оқиды деп ойлаймын.
Dialogue: 0,0:05:01.07,0:05:03.25,Default,,0,0,0,,Менің анам да 3-сыныпта оқыған сияқты.
Dialogue: 0,0:05:03.64,0:05:06.57,Default,,0,0,0,,Иә, сіздің анаңыз кім?
Dialogue: 0,0:05:08.48,0:05:09.41,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:05:10.52,0:05:11.86,Default,,0,0,0,,Рицуко-кун?
Dialogue: 0,0:05:12.34,0:05:14.25,Default,,0,0,0,,Не, сен білесің бе?
Dialogue: 0,0:05:16.69,0:05:19.78,Default,,0,0,0,,Ал, Рицуко-кун ше?
Dialogue: 0,0:05:20.85,0:05:25.07,Default,,0,0,0,,Бірақ ол өлгенін айтты.
Dialogue: 0,0:05:25.37,0:05:26.02,Default,,0,0,0,,Қашан
Dialogue: 0,0:05:28.08,0:05:30.81,Default,,0,0,0,,15 жыл бұрын мені дүниеге әкелгеннен кейін бірден
Dialogue: 0,0:05:31.05,0:05:32.11,Default,,0,0,0,,Он бес жыл бұрын
Dialogue: 0,0:05:34.65,0:05:35.89,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:36.94,0:05:38.39,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:43.92,0:05:44.86,Default,,0,0,0,,Коичи-кун
Dialogue: 0,0:05:49.25,0:05:51.92,Default,,0,0,0,,Мұғалім мені қызметкерлер бөлмесіне келуімді өтінді.
Dialogue: 0,0:05:52.96,0:05:54.67,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:05:59.22,0:06:02.47,Default,,0,0,0,,Мен алдымен кешірім сұраймын. Кешіріңіз.
Dialogue: 0,0:06:03.15,0:06:05.86,Default,,0,0,0,,Бұл барлығына арналған, мені кешіріңіз.
Dialogue: 0,0:06:11.29,0:06:16.53,Default,,0,0,0,,Мен Санае Мизуноның кеше ауруханада болған апаттан қайтыс болғанын білемін.
Dialogue: 0,0:06:16.79,0:06:17.42,Default,,0,0,0,,Иә
Dialogue: 0,0:06:18.55,0:06:21.48,Default,,0,0,0,,Тіпті бірдеңе күдікті болып көрінсе де
Dialogue: 0,0:06:21.67,0:06:23.85,Default,,0,0,0,,Жоқ, жоқ, жазатайым оқиға – апат.
Dialogue: 0,0:06:24.19,0:06:26.17,Default,,0,0,0,,Бұл өте өкінішті апат.
Dialogue: 0,0:06:26.76,0:06:32.19,Default,,0,0,0,,Сонымен, Мизуно мырзаның ұялы телефоны қарастырылып жатқан лифттен табылды.
Dialogue: 0,0:06:34.49,0:06:38.89,Default,,0,0,0,,Сіз онымен кеше түстен кейін сағат 1 шамасында ұялы телефонмен сөйлестіңіз бе?
Dialogue: 0,0:06:39.48,0:06:40.38,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:06:40.84,0:06:42.67,Default,,0,0,0,,Ол төбеде болды, солай ма?
Dialogue: 0,0:06:44.09,0:06:46.69,Default,,0,0,0,,Сол жерден лифтпен жүріңіз
Dialogue: 0,0:06:47.60,0:06:49.66,Default,,0,0,0,,Апатқа не себеп болды?
Dialogue: 0,0:06:49.87,0:06:50.83,Default,,0,0,0,,Тергеуде
Dialogue: 0,0:06:51.42,0:06:56.78,Default,,0,0,0,,Сымдарды ұстап тұрған металл фитингтердің босап, құлағанына күмән жоқ.
Dialogue: 0,0:06:57.63,0:07:00.18,Default,,0,0,0,,Бұл палата бірінші кезекте бірнеше ондаған жыл бұрын салынған.
Dialogue: 0,0:07:00.51,0:07:03.65,Default,,0,0,0,,Осы уақыт ішінде ол көптеген ойсыз кеңейтулер мен жөндеулерден өтті.
Dialogue: 0,0:07:03.89,0:07:05.06,Default,,0,0,0,,Бір-бірімізден сақ болайық
Dialogue: 0,0:07:05.36,0:07:07.90,Default,,0,0,0,,Әсіресе әдетте болмайтын апаттар үшін.
Dialogue: 0,0:07:11.95,0:07:12.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.13,0:07:36.28,Default,,0,0,0,,Сакакибара-кун
Dialogue: 0,0:07:37.83,0:07:40.56,Default,,0,0,0,,Сіз полициямен сөйлесуді аяқтадыңыз ба?
Dialogue: 0,0:07:40.84,0:07:41.64,Default,,0,0,0,,Иә
Dialogue: 0,0:07:41.90,0:07:45.96,Default,,0,0,0,,Мен көремін. Содан кейін бүгін үйге бара аласыз.
Dialogue: 0,0:07:46.77,0:07:48.75,Default,,0,0,0,,Барлығы
Dialogue: 0,0:07:49.28,0:07:53.13,Default,,0,0,0,,HR (үй бөлмесі) жаңа әйел сынып президенті туралы шешім қабылдады.
Dialogue: 0,0:07:53.60,0:07:54.85,Default,,0,0,0,,Бұл Акадава мырза.
Dialogue: 0,0:07:55.20,0:07:57.37,Default,,0,0,0,,Сонда бәрі қайда?
Dialogue: 0,0:07:57.81,0:08:02.75,Default,,0,0,0,,Сынып ережелерін міндетті түрде орындаңыз.
Dialogue: 0,0:08:03.37,0:08:04.52,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:08:25.88,0:08:27.07,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:08:29.25,0:08:31.24,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:08:36.98,0:08:39.83,Default,,0,0,0,,Алтыншы кезең, барлығы қайда кетті?
Dialogue: 0,0:08:40.55,0:08:42.79,Default,,0,0,0,,Конференц-залға барып, біраз нәрсені жасаңыз.
Dialogue: 0,0:08:43.08,0:08:43.94,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:08:44.84,0:08:46.27,Default,,0,0,0,,Сакакибара-кунса
Dialogue: 0,0:08:46.45,0:08:50.33,Default,,0,0,0,,Осы мектепке ауысқаннан бері мен өзімді біртүрлі сезіндім.
Dialogue: 0,0:08:51.45,0:08:53.13,Default,,0,0,0,,Білсең маған айта аласың.
Dialogue: 0,0:08:53.92,0:08:56.02,Default,,0,0,0,,Кешіріңіз, мен оны айта алмаймын.
Dialogue: 0,0:08:56.30,0:09:01.13,Default,,0,0,0,,Дегенмен, менің ойымша, бұдан былай Сакакибара-күнге өте жағымсыз нәрсе болады.
Dialogue: 0,0:09:01.68,0:09:02.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:03.41,0:09:04.76,Default,,0,0,0,,Бұрынғы жиналыста.
Dialogue: 0,0:09:05.55,0:09:10.34,Default,,0,0,0,,Акадава мырза сізсіз сөйлесуіміз керек деді.
Dialogue: 0,0:09:11.72,0:09:14.35,Default,,0,0,0,,Бірақ мен жаман нәрселерге тап болсам да,
Dialogue: 0,0:09:14.95,0:09:16.25,Default,,0,0,0,,Сабырлы болуыңды қалаймын.
Dialogue: 0,0:09:17.09,0:09:18.58,Default,,0,0,0,,​​Мен бұл барлығына арналған деп ойладым.
Dialogue: 0,0:09:19.27,0:09:20.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:20.81,0:09:21.95,Default,,0,0,0,,Барлығы
Dialogue: 0,0:09:22.96,0:09:25.81,Default,,0,0,0,,Бұл барлығына арналған, мені кешіріңіз.
Dialogue: 0,0:09:26.59,0:09:29.49,Default,,0,0,0,,Бұл сынып ережесі.
Dialogue: 0,0:09:30.00,0:09:30.69,Default,,0,0,0,,Иә
Dialogue: 0,0:09:32.88,0:09:34.03,Default,,0,0,0,,Мен бұл не деп ойлаймын
Dialogue: 0,0:09:40.23,0:09:43.06,Default,,0,0,0,,Мен сенен бір жақсылық сұрай аламын ба?
Dialogue: 0,0:09:43.60,0:09:44.34,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:09:44.85,0:09:47.67,Default,,0,0,0,,Мен сынып тізімінің көшірмесін алғым келеді.
Dialogue: 0,0:09:49.32,0:09:50.44,Default,,0,0,0,,Мен оны алған жоқпын.
Dialogue: 0,0:09:52.32,0:09:54.06,Default,,0,0,0,,Бұл әділ емес.
Dialogue: 0,0:09:54.73,0:09:59.13,Default,,0,0,0,,Мен Акадава мырзаның әдісімен шынымен келіспеймін.
Dialogue: 0,0:09:59.88,0:10:02.08,Default,,0,0,0,,Сіз өзіңіз шешкен нәрсені өзіңізге мәжбүрлей алмайсыз.
Dialogue: 0,0:10:02.46,0:10:03.32,Default,,0,0,0,,Бұл әділ емес
Dialogue: 0,0:10:04.02,0:10:06.94,Default,,0,0,0,,Сакакибара-кун, мен білгім келетін нәрселер өте көп.
Dialogue: 0,0:10:07.73,0:10:08.69,Default,,0,0,0,,Олай болса
Dialogue: 0,0:10:09.22,0:10:11.40,Default,,0,0,0,,Ендеше тыңдап, бір-бірден қараңыз.
Dialogue: 0,0:10:11.99,0:10:13.81,Default,,0,0,0,,Мен сізге білгенімді айтайын.
Dialogue: 0,0:10:13.84,0:10:16.32,Default,,0,0,0,,Эй, Такабаяси-кун, мен байсалдымын.
Dialogue: 0,0:10:17.12,0:10:20.18,Default,,0,0,0,,Сонымен, Мисаки Нараның баласы бар ма?
Dialogue: 0,0:10:21.37,0:10:22.47,Default,,0,0,0,,Мэй Мисаки
Dialogue: 0,0:10:28.88,0:10:30.94,Default,,0,0,0,,Такабаяси-кун Такабаяси-кун
Dialogue: 0,0:10:57.86,0:11:00.36,Default,,0,0,0,,Қайырлы таң, қазір ерте.
Dialogue: 0,0:11:22.11,0:11:24.48,Default,,0,0,0,,Олай болса, бұл туралы не деуге болады?
Dialogue: 0,0:11:25.43,0:11:27.35,Default,,0,0,0,,Жоқ, бұл жеткілікті.
Dialogue: 0,0:11:28.19,0:11:30.25,Default,,0,0,0,,Бүгін таңертең бірдеңе болды ма?
Dialogue: 0,0:11:35.32,0:11:41.72,Default,,0,0,0,,Бір сыныпта бірге оқыған Такабаяси-кунның жаны жайлы болсын деп дұға етейік.
Dialogue: 0,0:11:42.49,0:11:44.53,Default,,0,0,0,,Қайғылы оқиғалар жалғасуда
Dialogue: 0,0:11:45.20,0:11:47.08,Default,,0,0,0,,Берілме, берілме
Dialogue: 0,0:11:47.36,0:11:49.78,Default,,0,0,0,,Барлығымыз бірге жұмыс жасайық.
Dialogue: 0,0:11:50.37,0:11:53.98,Default,,0,0,0,,Барлығыңыз, сынып ережелерін сақтаңыздар.
Dialogue: 0,0:11:54.82,0:11:57.31,Default,,0,0,0,,Миками мырза қиын жағдайда болса да,
Dialogue: 0,0:11:57.94,0:12:00.52,Default,,0,0,0,,Ол қолынан келгеннің бәрін айтты.
Dialogue: 0,0:12:00.92,0:12:03.38,Default,,0,0,0,,Сонымен, сен сенімдісің бе?
Dialogue: 0,0:12:12.62,0:12:13.31,Default,,0,0,0,,Аноза
Dialogue: 0,0:12:18.39,0:12:19.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:21.17,0:12:22.01,Default,,0,0,0,,Вакуи-кун
Dialogue: 0,0:12:25.94,0:12:27.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:41.49,0:12:47.72,Default,,0,0,0,,Қазіргі уақытта қоңырау қол жетімді емес, себебі ол сигнал жоқ немесе қуат қосылмаған жерде.
Dialogue: 0,0:12:50.92,0:12:51.59,Default,,0,0,0,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:12:54.12,0:12:54.93,Default,,0,0,0,,Осымен
Dialogue: 0,0:12:55.05,0:12:56.09,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:13:00.81,0:13:02.88,Default,,0,0,0,,«Өсек-аяңдар өздігінен өмір сүреді».
Dialogue: 0,0:13:03.08,0:13:05.78,Default,,0,0,0,,Бұл бастапқыда адамға тән емес нәрсе.
Dialogue: 0,0:13:05.99,0:13:09.04,Default,,0,0,0,,Адам сияқты әрекет етудің көрінісі.
Dialogue: 0,0:13:09.48,0:13:12.24,Default,,0,0,0,,Бұл қолдану «персонификация» деп аталады.
Dialogue: 0,0:13:13.34,0:13:15.19,Default,,0,0,0,,Бұл жерде абай болу керек
Dialogue: 0,0:13:15.67,0:13:21.42,Default,,0,0,0,,«Антропоморфизм» - адам емес жандардың адам сияқты ұқсастығы.
Dialogue: 0,0:13:23.04,0:13:28.14,Default,,0,0,0,,Паскаль: «Адам — ойлайтын құрақ», — деген.
Dialogue: 0,0:13:28.62,0:13:33.10,Default,,0,0,0,,Бұл «персонификация» емес, «метафора»
Dialogue: 0,0:13:33.92,0:13:35.12,Default,,0,0,0,,Сол бір қадам біз үшін үлкен ілгерілеу болар еді.
Dialogue: 0,0:14:16.71,0:14:17.37,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:14:18.71,0:14:22.42,Default,,0,0,0,,Не болды? Сіз маған кенет қоңырау шалдыңыз.
Dialogue: 0,0:14:40.20,0:14:43.01,Default,,0,0,0,,Мен тізімді алдым, сондықтан
Dialogue: 0,0:14:43.83,0:14:48.28,Default,,0,0,0,,Кезек-кезек сөйлесейік. Мен Такабаяси-кунның өлгенін білемін.
Dialogue: 0,0:14:49.48,0:14:53.31,Default,,0,0,0,,Ол жүрек талмасынан зардап шеккен сияқты.
Dialogue: 0,0:14:53.99,0:14:58.12,Default,,0,0,0,,Иә, Джунның екінші баласы аурудан қайтыс болды.
Dialogue: 0,0:14:58.65,0:15:02.56,Default,,0,0,0,,Сондықтан мен бүгін мектепке барғанда, сыныпта біртүрлі нәрсе болды.
Dialogue: 0,0:15:03.28,0:15:07.24,Default,,0,0,0,,Барлығымыз бір-бірімізге көрсетейік және мен жоқ сияқты әрекет етейік
Dialogue: 0,0:15:08.12,0:15:09.99,Default,,0,0,0,,Сіз осылай істеуді шештіңіз бе?
Dialogue: 0,0:15:10.90,0:15:14.20,Default,,0,0,0,,​​Бұл мен де сен сияқты болдым деген сөз.
Dialogue: 0,0:15:17.90,0:15:20.74,Default,,0,0,0,,Сіз жоқ нәрсеге айналуға қалай қарайсыз?
Dialogue: 0,0:15:21.63,0:15:23.07,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:15:23.68,0:15:25.70,Default,,0,0,0,,Бірақ бұл сәл тазарақ болуы мүмкін.
Dialogue: 0,0:15:26.05,0:15:26.96,Default,,0,0,0,,Ұқыпты
Dialogue: 0,0:15:27.72,0:15:30.00,Default,,0,0,0,,Мен Мисаки Мэйдің сонда екенін білдім.
Dialogue: 0,0:15:34.69,0:15:38.10,Default,,0,0,0,,Бұл сіздің үйіңіз, солай ма?
Dialogue: 0,0:15:38.44,0:15:41.45,Default,,0,0,0,,Иә, мен сіз оны бұрыннан байқадыңыз деп ойладым.
Dialogue: 0,0:15:42.13,0:15:45.60,Default,,0,0,0,,Бұл жерде анық және мен тұтынушы емеспін.
Dialogue: 0,0:15:46.12,0:15:48.48,Default,,0,0,0,,Телефонға жауап берген анам еді.
Dialogue: 0,0:15:50.00,0:15:55.40,Default,,0,0,0,,Мен таң қалдым, өйткені маған мектептен достарым сирек қоңырау соғады.
Dialogue: 0,0:15:57.24,0:15:59.91,Default,,0,0,0,,Сенің анаңның аты Кирика.
Dialogue: 0,0:16:00.39,0:16:04.68,Default,,0,0,0,,Иә, менің ойымша, бұл бүркеншік ат деп аталады. Бұл «Кирика».
Dialogue: 0,0:16:05.75,0:16:09.41,Default,,0,0,0,,Үнемі екінші қабаттағы шеберханасына құлыпталатын біртүрлі адам.
Dialogue: 0,0:16:10.87,0:16:13.04,Default,,0,0,0,,Кобо М - Мисакидің "М"
Dialogue: 0,0:16:13.70,0:16:15.16,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:16:19.73,0:16:20.87,Default,,0,0,0,,Жоғарыға барайық
Dialogue: 0,0:16:34.12,0:16:35.07,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:16:44.23,0:16:44.88,Default,,0,0,0,,Иә
Dialogue: 0,0:16:53.19,0:16:57.78,Default,,0,0,0,,Сұрақты өзіңізге қойыңыз. Бұлай сөйлесу оңайырақ болуы мүмкін.
Dialogue: 0,0:16:59.08,0:17:01.44,Default,,0,0,0,,Сұрақ шабуылы
Dialogue: 0,0:17:02.17,0:17:07.49,Default,,0,0,0,,Маған ұнамайды, бірақ бүгін мен сізге ерекше құрмет көрсетемін.
Dialogue: 0,0:17:09.17,0:17:12.69,Default,,0,0,0,,Біріншіден, Мисаки Мэй, сіз осындасыз, солай ма?
Dialogue: 0,0:17:13.42,0:17:15.83,Default,,0,0,0,,Мен бұл елес шығар деп ойладым.
Dialogue: 0,0:17:16.51,0:17:17.31,Default,,0,0,0,,Біраз.
Dialogue: 0,0:17:18.04,0:17:19.92,Default,,0,0,0,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:17:20.76,0:17:22.54,Default,,0,0,0,,Бірақ күдіктерің жойылады.
Dialogue: 0,0:17:23.11,0:17:26.91,Default,,0,0,0,,Мен шынымен де тірі адам ретінде осындамын.
Dialogue: 0,0:17:28.05,0:17:31.92,Default,,0,0,0,,Мен тек 3-3 сыныптар үшін «ол жерде емеспін».
Dialogue: 0,0:17:33.17,0:17:34.14,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:17:34.72,0:17:37.06,Default,,0,0,0,,1 мамырда басталды.
Dialogue: 0,0:17:37.54,0:17:38.71,Default,,0,0,0,,Бұл жақында.
Dialogue: 0,0:17:40.42,0:17:43.64,Default,,0,0,0,,Сіз бірінші күннен бастап көптеген жағынан біртүрлі сезінген болуыңыз керек.
Dialogue: 0,0:17:44.70,0:17:46.35,Default,,0,0,0,,Маған ешкім айтпайды.
Dialogue: 0,0:17:48.45,0:17:52.19,Default,,0,0,0,,Оларға жағдайды дұрыс жеткізбеу қорқынышты қателік болды.
Dialogue: 0,0:17:52.63,0:17:53.52,Default,,0,0,0,,Мисс
Dialogue: 0,0:17:54.68,0:17:57.24,Default,,0,0,0,,Бастапқыда Сакакибара-кун бізге қосылатын еді.
Dialogue: 0,0:17:57.58,0:18:00.65,Default,,0,0,0,,Мен жоқ нәрсеге айналмайынша, ол жұмыс істемейді.
Dialogue: 0,0:18:01.96,0:18:06.55,Default,,0,0,0,,Енді сен де мен сияқты болдың, бұл мәселе.
Dialogue: 0,0:18:07.20,0:18:09.55,Default,,0,0,0,,Бұл қорлау емес, солай емес пе?
Dialogue: 0,0:18:10.28,0:18:12.26,Default,,0,0,0,,Менің ойымша, ешкім олай ойламайды.
Dialogue: 0,0:18:17.91,0:18:20.68,Default,,0,0,0,,Мен өзімді «болмайтын адамға» айналдырғанымды да түсіндім.
Dialogue: 0,0:18:21.26,0:18:22.81,Default,,0,0,0,,Бірақ неліктен мұны істейсің?
Dialogue: 0,0:18:24.32,0:18:26.01,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:18:27.02,0:18:30.17,Default,,0,0,0,,Мисакидің 26 жыл бұрынғы әңгімесі есімде.
Dialogue: 0,0:18:30.39,0:18:30.99,Default,,0,0,0,,Иә
Dialogue: 0,0:18:31.63,0:18:37.65,Default,,0,0,0,,Бұл оқиға 3-ші және 3-ші сыныптар үшін себеп болды және олар «өлімге» жақындады.
Dialogue: 0,0:18:38.46,0:18:39.23,Default,,0,0,0,,«Өлім»
Dialogue: 0,0:18:39.31,0:18:41.26,Default,,0,0,0,,«Бұл» бірінші болды
Dialogue: 0,0:18:41.55,0:18:46.12,Default,,0,0,0,,Мисакидің сыныптастары мектеп бітіргеннен кейінгі жылы 3-сыныпта оқитын.
Dialogue: 0,0:18:46.79,0:18:50.54,Default,,0,0,0,,Бірде «бұл» орын алса, бірде ол басталады.
Dialogue: 0,0:18:50.96,0:18:52.72,Default,,0,0,0,,Ай сайын адамдар өледі
Dialogue: 0,0:18:53.83,0:18:56.87,Default,,0,0,0,,Оқушылардың өздері немесе олардың отбасылары.
Dialogue: 0,0:18:57.47,0:18:58.62,Default,,0,0,0,,«Бұл» дегеніміз не?
Dialogue: 0,0:19:00.35,0:19:05.99,Default,,0,0,0,,«Бұл» сыныптағы адамдар саны бір адамға көбейетінін білдіреді.
Dialogue: 0,0:19:06.75,0:19:08.51,Default,,0,0,0,,Кімді көбейтіңіз
Dialogue: 0,0:19:10.37,0:19:11.34,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:19:12.41,0:19:15.56,Default,,0,0,0,,Мен артық баланың кім екенін білмеймін.
Dialogue: 0,0:19:16.20,0:19:17.25,Default,,0,0,0,,«Басқа адам»
Dialogue: 0,0:19:17.82,0:19:18.69,Default,,0,0,0,,«Тағы бір адам»
Dialogue: 0,0:19:19.73,0:19:23.08,Default,,0,0,0,,Жиырма бес жыл бұрын, жаңа семестр басталғаннан кейін
Dialogue: 0,0:19:23.47,0:19:26.71,Default,,0,0,0,,Сыныпта бір парта мен бір орындық жетіспейтінін білдім.
Dialogue: 0,0:19:27.75,0:19:30.89,Default,,0,0,0,,Сыныптағы адам санына қарай дайындалуы керек еді.
Dialogue: 0,0:19:32.10,0:19:34.98,Default,,0,0,0,,Мен оны мектеп жазбаларынан қарадым.
Dialogue: 0,0:19:35.42,0:19:37.47,Default,,0,0,0,,Қанша тырыссам да, пайдасы жоқ.
Dialogue: 0,0:19:38.05,0:19:41.33,Default,,0,0,0,,Аттар тізімдері мен жазбалар мағынасын ашу үшін бұрмаланған.
Dialogue: 0,0:19:41.86,0:19:44.38,Default,,0,0,0,,Бірақ бір үстел мен бір орындық жоқ.
Dialogue: 0,0:19:45.21,0:19:47.11,Default,,0,0,0,,Біреу оны қайта жазды.
Dialogue: 0,0:19:47.63,0:19:48.94,Default,,0,0,0,,“Фальсификация” – метафора
Dialogue: 0,0:19:49.45,0:19:53.13,Default,,0,0,0,,Өйткені тіпті барлығының естеліктері өзгерді.
Dialogue: 0,0:19:55.19,0:19:56.83,Default,,0,0,0,,Сіз бұл мүмкін емес деп ойлайсыз.
Dialogue: 0,0:19:58.01,0:20:01.30,Default,,0,0,0,,Бірақ бұл нақты нәрсе сияқты.
Dialogue: 0,0:20:02.39,0:20:06.66,Default,,0,0,0,,Біреу маған мұның «құбылыс» екенін түсіндірді.
Dialogue: 0,0:20:07.80,0:20:08.61,Default,,0,0,0,,«Феномен»
Dialogue: 0,0:20:09.19,0:20:13.43,Default,,0,0,0,,Бастапқыда барлығы бұл жай ғана қателік деп ойлап, мән бермеді.
Dialogue: 0,0:20:14.00,0:20:19.45,Default,,0,0,0,,Дегенмен, сәуір айынан бастап менің сыныбымдағы адамдар ай сайын өле бастады.
Dialogue: 0,0:20:20.16,0:20:22.75,Default,,0,0,0,,Бір жыл бойы ай сайын
Dialogue: 0,0:20:23.20,0:20:27.88,Default,,0,0,0,,Менің ойымша, бұл жылы алты студент және он студенттің отбасы болды.
Dialogue: 0,0:20:28.73,0:20:30.13,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:20:30.50,0:20:34.79,Default,,0,0,0,,Содан бері бұл «құбылыс» 3-3 сыныпта жалғасын тапты.
Dialogue: 0,0:20:36.41,0:20:40.13,Default,,0,0,0,,Жиырма алты жыл бұрын 3-3 сынып оқушысы Мисаки қайтыс болды.
Dialogue: 0,0:20:40.82,0:20:44.92,Default,,0,0,0,,Келесі жылдан бастап кім екенін білмейтін «басқа адамдар» көбейе бастады.
Dialogue: 0,0:20:45.48,0:20:49.18,Default,,0,0,0,,Содан кейін ай сайын менің сыныбымдағы студенттер мен отбасы мүшелері өле бастады.
Dialogue: 0,0:20:50.54,0:20:53.54,Default,,0,0,0,,Неліктен адам саны көбейген кезде адамдар өледі?
Dialogue: 0,0:20:54.79,0:20:57.73,Default,,0,0,0,,Неге екенін білмеймін, бұл жай ғана болады.
Dialogue: 0,0:20:58.26,0:21:01.39,Default,,0,0,0,,Ал сіз «басқа адам» дегенді қалай түсінесіз?
Dialogue: 0,0:21:03.05,0:21:04.10,Default,,0,0,0,,«Өлі»
Dialogue: 0,0:21:05.37,0:21:09.17,Default,,0,0,0,,Бұл жиырма алты жыл бұрын қайтыс болған Мисаки.
Dialogue: 0,0:21:12.68,0:21:15.14,Default,,0,0,0,,«Өлгендер» елес сияқты.
Dialogue: 0,0:21:16.02,0:21:19.28,Default,,0,0,0,,Кәдімгі елес бейнесі емес шығар.
Dialogue: 0,0:21:19.72,0:21:21.15,Default,,0,0,0,,Нақты жағдай бар сияқты.
Dialogue: 0,0:21:21.78,0:21:24.84,Default,,0,0,0,,Ол да бізден мүлде ажыратылмайды.
Dialogue: 0,0:21:25.40,0:21:26.73,Default,,0,0,0,,Айырмау
Dialogue: 0,0:21:27.22,0:21:31.09,Default,,0,0,0,,Өйткені, «өлілердің» жүрегі мен естелігі бар.
Dialogue: 0,0:21:31.55,0:21:34.53,Default,,0,0,0,,Олар өздерінің «өлі» екенін түсінбейді.
Dialogue: 0,0:21:35.58,0:21:37.24,Default,,0,0,0,,«Өлген адам» қандай адам?
Dialogue: 0,0:21:37.79,0:21:39.86,Default,,0,0,0,,Бұрынғы «құбылыстардан» қайтыс болған адамдар
Dialogue: 0,0:21:45.10,0:21:46.56,Default,,0,0,0,,Мен бұл туралы осылай ойладым.
Dialogue: 0,0:21:47.27,0:21:52.46,Default,,0,0,0,,26 жыл бұрын болған оқиғаға байланысты 3-сынып өлілерді шақыратын орынға айналды.
Dialogue: 0,0:21:52.98,0:21:56.10,Default,,0,0,0,,Содан кейін өлілер сыныпқа араласа бастады.
Dialogue: 0,0:21:56.34,0:21:59.17,Default,,0,0,0,,3-сынып «өлімге» жақындады, солай емес пе?
Dialogue: 0,0:22:01.40,0:22:06.62,Default,,0,0,0,,Сонымен, 3-сыныптағылардың барлығы `` апаттан '' құтылуға тырысады.
Dialogue: 0,0:22:06.72,0:22:09.56,Default,,0,0,0,,Шамасы, олар әртүрлі қарсы шараларды ойластырған.
Dialogue: 0,0:22:10.32,0:22:11.57,Default,,0,0,0,,Жын шығару және т.б.
Dialogue: 0,0:22:12.30,0:22:13.32,Default,,0,0,0,,Бұл болуы мүмкін
Dialogue: 0,0:22:14.38,0:22:19.16,Default,,0,0,0,,Мен сыныпты өзгертуге тырыстым және ''3-сынып'' атауын ''Class'' деп өзгертуге тырыстым.
Dialogue: 0,0:22:19.81,0:22:21.87,Default,,0,0,0,,Бірақ бәрібір аяқталмады
Dialogue: 0,0:22:22.46,0:22:25.35,Default,,0,0,0,,Мәселе үшінші сынып оқушыларының үшінші сыныбында жатыр.
Dialogue: 0,0:22:25.93,0:22:27.23,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:22:27.80,0:22:33.54,Default,,0,0,0,,Содан шамамен он жыл бұрын тиімді шешім табылды.
Dialogue: 0,0:22:34.50,0:22:39.47,Default,,0,0,0,,Солай етсек, ай сайын өлім болмайды.
Dialogue: 0,0:22:40.48,0:22:42.21,Default,,0,0,0,,Мен бұған сене алмадым
Dialogue: 0,0:22:43.20,0:22:47.52,Default,,0,0,0,,«Басқа адамның» орнына бір адам «болмайтын нәрсеге» айналады
Dialogue: 0,0:22:48.13,0:22:51.53,Default,,0,0,0,,Осылайша сіз сыныпты бастапқы өлшеміне қайтарасыз.
Dialogue: 0,0:22:52.31,0:22:55.38,Default,,0,0,0,,Яғни, сол жылғы «апаттың» алдын алуға болады деген сөз.
Dialogue: 0,0:22:55.88,0:22:57.90,Default,,0,0,0,,Мұндай заклинание
Dialogue: 0,0:23:04.63,0:23:19.50,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.37,0:23:37.26,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.28,0:23:46.26,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.26,0:23:55.51,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:56.00,0:24:05.00,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:24:05.00,0:24:23.96,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:24:25.46,0:24:30.46,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
