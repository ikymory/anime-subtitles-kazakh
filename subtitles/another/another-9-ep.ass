Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.29,0:00:08.11,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:00:08.41,0:00:11.25,Default,,0,0,0,,Накао-кунды қайық басып қалды.
Dialogue: 0,0:00:11.83,0:00:14.57,Default,,0,0,0,,Ямиямадан тыс жерде өлмейтінің өтірік
Dialogue: 0,0:00:14.75,0:00:15.94,Default,,0,0,0,,Маған қызық па?
Dialogue: 0,0:00:16.60,0:00:19.00,Default,,0,0,0,,Енді құтылу мүмкін емес
Dialogue: 0,0:00:19.05,0:00:20.46,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:00:21.19,0:00:21.86,Default,,0,0,0,,Осымен
Dialogue: 0,0:00:22.56,0:00:24.13,Default,,0,0,0,,Оқу-жаттығу жиыны туралы не істеу керек
Dialogue: 0,0:00:24.24,0:00:25.98,Default,,0,0,0,,Менің баратын жолым жоқ
Dialogue: 0,0:00:26.30,0:00:28.91,Default,,0,0,0,,Жазғы демалыс кезіндегі оқу-жаттығу жиыны «белгілі бір жылдар»
Dialogue: 0,0:00:29.05,0:00:30.31,Default,,0,0,0,,Мен оны түсінбеймін
Dialogue: 0,0:00:30.77,0:00:34.11,Default,,0,0,0,,Үйде болу ең қауіпсіз
Dialogue: 0,0:00:34.15,0:00:35.62,Default,,0,0,0,,Маған қызық па?
Dialogue: 0,0:00:36.09,0:00:37.22,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:00:37.89,0:00:40.67,Default,,0,0,0,,Неліктен мен мұны бастан өткеруім керек?
Dialogue: 0,0:00:40.74,0:00:42.00,Default,,0,0,0,,Шынында да ақылға қонымсыз
Dialogue: 0,0:00:43.19,0:00:47.77,Default,,0,0,0,,Негізінде, егер ол ауысқан студент Мисаки-санмен сөйлеспеген болса.
Dialogue: 0,0:00:48.50,0:00:49.50,Default,,0,0,0,,I
Dialogue: 0,0:00:50.75,0:00:52.38,Default,,0,0,0,,Мен оны қорғасам да
Dialogue: 0,0:00:53.92,0:00:56.39,Default,,0,0,0,,Мен оны тастап кетсем де.
Dialogue: 0,0:00:57.56,0:00:58.70,Default,,0,0,0,,Сыныпта
Dialogue: 0,0:01:11.86,0:01:15.02,Default,,0,0,0,,Түнде қабақты ашу
Dialogue: 0,0:01:15.08,0:01:19.09,Default,,0,0,0,,Мен жаман көлеңкеден қорқамын
Dialogue: 0,0:01:22.11,0:01:26.85,Default,,0,0,0,,Қараңғы табыттан
Dialogue: 0,0:01:28.40,0:01:34.91,Default,,0,0,0,,Құлаған қуыршақ сияқты
Dialogue: 0,0:01:35.40,0:01:40.11,Default,,0,0,0,,Денем қызарып, қатып қалады.
Dialogue: 0,0:01:41.60,0:01:48.35,Default,,0,0,0,,Жүрек қараңғыда өседі
Dialogue: 0,0:01:48.67,0:01:51.94,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,0:01:51.94,0:01:55.01,Default,,0,0,0,,Ұстаған қолдарымыздың салқындығы
Dialogue: 0,0:01:55.04,0:01:58.17,Default,,0,0,0,,Жаңа қанның тырнақтары
Dialogue: 0,0:01:58.23,0:02:02.24,Default,,0,0,0,,Қастарыңа қара.
Dialogue: 0,0:02:03.02,0:02:09.71,Default,,0,0,0,,Жұмбақ аяқталу үшін бір-бірімізді құртайық
Dialogue: 0,0:02:09.79,0:02:13.32,Default,,0,0,0,,Қанаттары мен аяқтары жұлынған
Dialogue: 0,0:02:13.38,0:02:16.77,Default,,0,0,0,,Бос жерде шіріп кетудің орнына
Dialogue: 0,0:02:16.80,0:02:20.05,Default,,0,0,0,,Басқа мен бар
Dialogue: 0,0:02:20.07,0:02:25.15,Default,,0,0,0,,Мен біреуді қатты жақсы көремін, ол ауырады
Dialogue: 0,0:02:26.62,0:02:32.13,Default,,0,0,0,,Енді қайсысы иллюзия?
Dialogue: 0,0:02:44.27,0:02:47.73,Default,,0,0,0,,Олай болса, сендер де сақ болыңдар.
Dialogue: 0,0:02:47.87,0:02:48.51,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.62,0:03:14.41,Default,,0,0,0,,Накао-кунның сол күні қалай болғанына таңғаламын.
Dialogue: 0,0:03:15.32,0:03:16.89,Default,,0,0,0,,Менде қатты көлік ауруы бар.
Dialogue: 0,0:03:17.63,0:03:19.20,Default,,0,0,0,,Сен көп рет құстың.
Dialogue: 0,0:03:19.60,0:03:20.67,Default,,0,0,0,,Басқалар
Dialogue: 0,0:03:21.01,0:03:22.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:22.72,0:03:25.27,Default,,0,0,0,,Мен түзу жүзе алмадым.
Dialogue: 0,0:03:26.37,0:03:28.47,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:03:28.82,0:03:30.97,Default,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:03:31.18,0:03:32.30,Default,,0,0,0,,Бұл шынымен де жай кездейсоқтық па деп ойлайсың ба?
Dialogue: 0,0:03:34.79,0:03:35.76,Default,,0,0,0,,Айяне
Dialogue: 0,0:03:36.09,0:03:37.12,Default,,0,0,0,,Охба-кун
Dialogue: 0,0:03:37.72,0:03:41.15,Default,,0,0,0,,Мен Ямияма полиция бөлімшесінің детективімен біраз сөйлестім.
Dialogue: 0,0:03:41.57,0:03:42.99,Default,,0,0,0,,Өлімнің себебі неде деп ойлаймын.
Dialogue: 0,0:03:44.08,0:03:48.02,Default,,0,0,0,,Шындығында, ол қайықпен соқтығысқанға дейін өлген деп ойлаймын.
Dialogue: 0,0:03:49.44,0:03:52.34,Default,,0,0,0,,Қайықпен соқтығысқан бастың күйі.
Dialogue: 0,0:03:52.57,0:03:54.64,Default,,0,0,0,,Уақыт дұрыс емес сияқты.
Dialogue: 0,0:03:54.97,0:03:59.32,Default,,0,0,0,,Шамасы, мидың контузиясынан туындаған ми грыжа айтарлықтай ілгерілеген.
Dialogue: 0,0:03:59.58,0:04:01.78,Default,,0,0,0,,Теңізге келгенге дейін ме?
Dialogue: 0,0:04:03.35,0:04:05.31,Default,,0,0,0,,Накаоның отбасына сәйкес,
Dialogue: 0,0:04:05.43,0:04:09.64,Default,,0,0,0,,Ол сол күні таңертең баспалдақтан шыққан қатты дыбысты естіді.
Dialogue: 0,0:04:10.33,0:04:11.94,Default,,0,0,0,,Мен жағдайды тексеруге барсам да,
Dialogue: 0,0:04:11.97,0:04:15.82,Default,,0,0,0,,Ол асығыс кетіп бара жатқан Накаоның арқасын ғана көрді.
Dialogue: 0,0:04:16.27,0:04:18.66,Default,,0,0,0,,Мен сол кезде басымды соқтым.
Dialogue: 0,0:04:18.67,0:04:19.60,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:04:20.79,0:04:21.73,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:04:22.13,0:04:26.18,Default,,0,0,0,,Демек, сіз «өлімге» тартылған Ями тауының ішінде болдыңыз ба?
Dialogue: 0,0:04:26.34,0:04:28.47,Default,,0,0,0,,Айтсаң да еш қиындық жоқ.
Dialogue: 0,0:04:29.11,0:04:31.84,Default,,0,0,0,,Мен ауруханаға бармадым, себебі басымды соқтым.
Dialogue: 0,0:04:31.87,0:04:34.10,Default,,0,0,0,,Мен Ями тауынан шыққан бойда
Dialogue: 0,0:04:34.18,0:04:35.83,Default,,0,0,0,,«Өлім» расталды
Dialogue: 0,0:04:43.71,0:04:45.50,Default,,0,0,0,,Аноса Мисаки
Dialogue: 0,0:04:46.64,0:04:47.35,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:04:50.47,0:04:52.47,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:04:53.78,0:04:55.39,Default,,0,0,0,,​​Дұрыс түсінген кезде айтамын.
Dialogue: 0,0:04:56.76,0:04:57.48,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.79,0:05:02.94,Default,,0,0,0,,Мен 26 жыл бұрынғы топтық фотоны таптым.
Dialogue: 0,0:05:03.63,0:05:04.25,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:05:28.27,0:05:29.64,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:05:34.95,0:05:36.94,Default,,0,0,0,,Бұл сіздің кінәңіз.
Dialogue: 0,0:05:41.27,0:05:42.99,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:05:47.18,0:05:48.54,Default,,0,0,0,,Сіздің кінәңіз
Dialogue: 0,0:05:49.66,0:05:51.68,Default,,0,0,0,,Басталған сәт
Dialogue: 0,0:06:09.23,0:06:10.21,Default,,0,0,0,,Сынып бөлмесі
Dialogue: 0,0:06:16.74,0:06:18.45,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:06:19.04,0:06:21.61,Default,,0,0,0,,Мацунага мырза осылай деді.
Dialogue: 0,0:06:21.66,0:06:22.85,Default,,0,0,0,,Сынып дегеніміз не?
Dialogue: 0,0:06:23.47,0:06:26.62,Default,,0,0,0,,Бұл ескі мектеп ғимаратындағы ескі 3-сынып.
Dialogue: 0,0:06:26.68,0:06:29.37,Default,,0,0,0,,Сонымен, сіз сыныпта не жасырып отырсыз?
Dialogue: 0,0:06:31.99,0:06:32.81,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:33.17,0:06:36.31,Default,,0,0,0,,Орналасқан жерді білудің өзі жақсы нәрсе.
Dialogue: 0,0:06:36.45,0:06:37.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:37.51,0:06:38.14,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:38.67,0:06:40.61,Default,,0,0,0,,Басқа ешкімге айтқым келмейді.
Dialogue: 0,0:06:41.67,0:06:42.57,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:06:43.13,0:06:47.73,Default,,0,0,0,,Накао-кун, ол теңізге келмегенде өлмес еді деп ойлаймын.
Dialogue: 0,0:06:48.67,0:06:49.40,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:49.90,0:06:53.02,Default,,0,0,0,,Сондықтан мен адам санын көбейткім келмейді.
Dialogue: 0,0:06:53.28,0:06:56.13,Default,,0,0,0,,Мен бұдан былай өлімге себеп болғым келмейді.
Dialogue: 0,0:06:56.85,0:06:58.75,Default,,0,0,0,,Акадава-сан және қарсы шараларға жауапты басқалар
Dialogue: 0,0:06:59.35,0:07:01.16,Default,,0,0,0,,Әзірше айтудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:07:01.67,0:07:02.98,Default,,0,0,0,,Бірдеңе табылды
Dialogue: 0,0:07:03.29,0:07:06.97,Default,,0,0,0,,Содан кейін мен олардың ынтымақтастығы керек екенін түсіндім.
Dialogue: 0,0:07:07.56,0:07:09.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:09.61,0:07:12.51,Default,,0,0,0,,Мен Акадаваның өлгенін көргім келмейді.
Dialogue: 0,0:07:12.55,0:07:16.25,Default,,0,0,0,,Сонымен ескі мектеп ғимаратына қашан барасыз?
Dialogue: 0,0:07:16.45,0:07:17.81,Default,,0,0,0,,Бұдан былай емес.
Dialogue: 0,0:07:18.12,0:07:20.55,Default,,0,0,0,,Мен кешке отбасыммен шығуым керек.
Dialogue: 0,0:07:21.10,0:07:22.03,Default,,0,0,0,,Ертең
Dialogue: 0,0:07:22.46,0:07:24.87,Default,,0,0,0,,Ал, ертең таңертең ше?
Dialogue: 0,0:07:25.47,0:07:27.46,Default,,0,0,0,,Маған таңертең демалыс беріңізші.
Dialogue: 0,0:07:27.66,0:07:29.16,Default,,0,0,0,,Олай болса түсте
Dialogue: 0,0:07:29.28,0:07:32.71,Default,,0,0,0,,Күндізгі уақытта клуб іс-шараларына көптеген адамдар қатысады.
Dialogue: 0,0:07:32.97,0:07:36.77,Default,,0,0,0,,Ескі мектеп ғимаратының екінші қабатына кіруге тыйым салынады.
Dialogue: 0,0:07:36.92,0:07:38.90,Default,,0,0,0,,Түнде кездескенше
Dialogue: 0,0:07:39.04,0:07:41.53,Default,,0,0,0,,Мен сені түнде іздеймін.
Dialogue: 0,0:07:42.19,0:07:45.29,Default,,0,0,0,,Содан кейін ол сағат 15.00-ге орнатылады.
Dialogue: 0,0:07:45.40,0:07:46.03,Default,,0,0,0,,Олардың бірі… Кира ғой, иә?
Dialogue: 0,0:07:46.08,0:07:46.80,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:46.87,0:07:50.08,Default,,0,0,0,,Мочизуки: Өнер үйірмесі - ескі мектеп ғимараты.
Dialogue: 0,0:07:50.19,0:07:51.30,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:07:51.57,0:07:53.45,Default,,0,0,0,,Клуб мүшелері жазғы демалыста келе ме?
Dialogue: 0,0:07:53.87,0:07:55.17,Default,,0,0,0,,Ешкім келмейді.
Dialogue: 0,0:07:55.34,0:07:58.15,Default,,0,0,0,,Олай болса, біз клуб бөлмесінде кездесеміз.
Dialogue: 0,0:07:58.20,0:07:59.21,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:59.52,0:08:00.74,Default,,0,0,0,,Менде кілт бар.
Dialogue: 0,0:08:01.19,0:08:03.74,Default,,0,0,0,,Ескі мектеп ғимаратына барсам, күдіктенбес едім.
Dialogue: 0,0:08:05.21,0:08:08.73,Default,,0,0,0,,Тешигахара, сен мұнда мұндай салқын көзқараспен келмейсің.
Dialogue: 0,0:08:08.78,0:08:10.17,Default,,0,0,0,,Неге?
Dialogue: 0,0:08:10.51,0:08:11.61,Default,,0,0,0,,Ол көзге түседі
Dialogue: 0,0:08:14.03,0:08:15.86,Default,,0,0,0,,Сәнді адамдардың көздері бар ма?
Dialogue: 0,0:08:32.32,0:08:34.25,Default,,0,0,0,,Коичи-чан және Тесси
Dialogue: 0,0:08:34.33,0:08:37.10,Default,,0,0,0,,Неліктен үйге келу клубының эйсі мектепке келеді?
Dialogue: 0,0:08:37.35,0:08:39.19,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:08:39.45,0:08:41.31,Default,,0,0,0,,Мочизукимен кездесейік.
Dialogue: 0,0:08:41.40,0:08:43.90,Default,,0,0,0,,​​Дәлірек айтқанда, екеуі де клуб мүшелері.
Dialogue: 0,0:08:46.67,0:08:48.45,Default,,0,0,0,,Чихики-сенсей туралы аздап.
Dialogue: 0,0:08:49.38,0:08:50.61,Default,,0,0,0,,Екінші кітапханада
Dialogue: 0,0:08:51.32,0:08:52.73,Default,,0,0,0,,Ол емес.
Dialogue: 0,0:08:53.22,0:08:55.97,Default,,0,0,0,,Чибики-сенсэй – драма үйірмесінің кеңесшісі.
Dialogue: 0,0:08:56.04,0:08:56.87,Default,,0,0,0,,Шынайы
Dialogue: 0,0:08:57.10,0:08:58.45,Default,,0,0,0,,Сол қара жігіт
Dialogue: 0,0:08:58.88,0:08:59.73,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:09:00.39,0:09:03.76,Default,,0,0,0,,Ол актерлік шеберлікті үйретеді, солай емес пе?
Dialogue: 0,0:09:03.87,0:09:07.93,Default,,0,0,0,,Мен әрекет етіп жатқанда қаншалықты керемет көрінетінім біртүрлі.
Dialogue: 0,0:09:08.06,0:09:08.66,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:09:09.19,0:09:10.96,Default,,0,0,0,,Екеуің не үшін келдіңдер?
Dialogue: 0,0:09:16.21,0:09:19.22,Default,,0,0,0,,Мен апатты тоқтату үшін анықтамалар іздедім.
Dialogue: 0,0:09:19.72,0:09:21.76,Default,,0,0,0,,Мен шана дегеннің не екенін білмеймін.
Dialogue: 0,0:09:21.83,0:09:24.64,Default,,0,0,0,,Егер мен оны тапсам, міндетті түрде бәріне айтамын.
Dialogue: 0,0:09:24.71,0:09:26.04,Default,,0,0,0,,Е, шындап.
Dialogue: 0,0:09:26.38,0:09:27.84,Default,,0,0,0,,Ондай нәрсе бар
Dialogue: 0,0:09:28.49,0:09:30.34,Default,,0,0,0,,Мүмкін болса, өз қолымызбен
Dialogue: 0,0:09:30.86,0:09:33.00,Default,,0,0,0,,Мен 3-сыныптың апатын тоқтатқым келеді.
Dialogue: 0,0:09:34.72,0:09:36.33,Default,,0,0,0,,Аяно мен Огура да келе ме?
Dialogue: 0,0:09:36.37,0:09:37.19,Default,,0,0,0,,Біраз
Dialogue: 0,0:09:38.87,0:09:39.51,Default,,0,0,0,,Жол
Dialogue: 0,0:09:39.87,0:09:41.33,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:43.21,0:09:45.57,Default,,0,0,0,,Коуичи-чан қош бол
Dialogue: 0,0:09:49.93,0:09:50.92,Default,,0,0,0,,Джейн
Dialogue: 0,0:09:51.52,0:09:52.69,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:10:03.57,0:10:04.48,Default,,0,0,0,,Мисаки
Dialogue: 0,0:10:04.68,0:10:05.70,Default,,0,0,0,,Мочизуки
Dialogue: 0,0:10:06.53,0:10:07.44,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:08.15,0:10:10.40,Default,,0,0,0,,Мен де жақында келдім.
Dialogue: 0,0:10:10.57,0:10:11.82,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:10:12.44,0:10:14.39,Default,,0,0,0,,Менің шаруам жоқ еді.
Dialogue: 0,0:10:15.11,0:10:16.44,Default,,0,0,0,,Тіпті үйде болсаңыз да
Dialogue: 0,0:10:16.99,0:10:19.13,Default,,0,0,0,,Мен сурет салуды ойладым.
Dialogue: 0,0:10:19.55,0:10:20.28,Default,,0,0,0,,Иә
Dialogue: 0,0:10:20.73,0:10:22.01,Default,,0,0,0,,Балалар
Dialogue: 0,0:10:22.39,0:10:25.21,Default,,0,0,0,,Мочизуки-кун да?
Dialogue: 0,0:10:27.03,0:10:28.37,Default,,0,0,0,,Үшеуің не істеп жатырсыңдар?
Dialogue: 0,0:10:28.44,0:10:29.44,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:10:29.65,0:10:31.26,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:10:31.63,0:10:32.44,Default,,0,0,0,,Барлау
Dialogue: 0,0:10:34.04,0:10:35.10,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:10:40.73,0:10:43.76,Default,,0,0,0,,Үшеуміз қайда барамыз?
Dialogue: 0,0:10:43.91,0:10:44.69,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:10:44.88,0:10:48.73,Default,,0,0,0,,Ум, Тешигахара-кун осында кездесейік деді.
Dialogue: 0,0:10:49.24,0:10:50.57,Default,,0,0,0,,Жоқ, мен олай емеспін.
Dialogue: 0,0:10:51.60,0:10:52.46,Default,,0,0,0,,Осымен.
Dialogue: 0,0:10:52.82,0:10:55.21,Default,,0,0,0,,Сакаки бірдеңе іздейтінін айтады.
Dialogue: 0,0:10:55.95,0:10:58.79,Default,,0,0,0,,Бұл маңызды нәрсе
Dialogue: 0,0:11:03.95,0:11:04.83,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:05.35,0:11:07.15,Default,,0,0,0,,Өйткені біз не болатынын білмейміз
Dialogue: 0,0:11:07.27,0:11:09.36,Default,,0,0,0,,Мүмкін болса, клуб бөлмесінде қалғаныңызды қалаймын.
Dialogue: 0,0:11:09.87,0:11:11.22,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:11:11.75,0:11:12.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:13.05,0:11:16.06,Default,,0,0,0,,Өйткені, Мисаки, сен өзгердің.
Dialogue: 0,0:11:16.14,0:11:17.36,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:11:17.54,0:11:19.63,Default,,0,0,0,,Мүмкін бұл қорқынышты емес шығар
Dialogue: 0,0:11:46.51,0:11:48.30,Default,,0,0,0,,Үшінші сынып қайда болды?
Dialogue: 0,0:11:48.87,0:11:50.21,Default,,0,0,0,,Ортасында емес
Dialogue: 0,0:11:50.29,0:11:51.91,Default,,0,0,0,,Бес оқу бөлмесі бар.
Dialogue: 0,0:12:22.44,0:12:23.61,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:23.98,0:12:26.45,Default,,0,0,0,,Бұл ескі мектеп ғимараты «Жеті керемет» деген атпен белгілі емес пе?
Dialogue: 0,0:12:26.49,0:12:27.51,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:27.68,0:12:30.81,Default,,0,0,0,,Жалпы айтқанда, мені «Жеті керемет» сияқты нәрселер қызықтырмайды.
Dialogue: 0,0:12:32.00,0:12:35.44,Default,,0,0,0,,Демек, мен рухтарға немесе қарғыстарға сенбеймін.
Dialogue: 0,0:12:35.49,0:12:37.36,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:12:37.53,0:12:39.59,Default,,0,0,0,,Бұл жай ғана түсінбеушілік пен кездейсоқтық болса да
Dialogue: 0,0:12:40.13,0:12:43.49,Default,,0,0,0,,Бір нәрсені қоспағанда, біздің «апатымыз»
Dialogue: 0,0:12:44.17,0:12:45.77,Default,,0,0,0,,Ескі мектеп ғимаратының «жеті кереметі» болып табылады
Dialogue: 0,0:12:45.92,0:12:48.75,Default,,0,0,0,,Бұл екінші кітапхананың құпиясы.
Dialogue: 0,0:12:48.81,0:12:49.59,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:12:50.01,0:12:54.13,Default,,0,0,0,,Кейде сол бөлмеде адамдардың еңіреп жатқанын естисіз.
Dialogue: 0,0:12:54.40,0:12:55.47,Default,,0,0,0,,Мен ол туралы естідім.
Dialogue: 0,0:12:55.62,0:12:56.27,Default,,0,0,0,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:12:57.09,0:12:58.79,Default,,0,0,0,,Сол кітапхананың жертөлесінде
Dialogue: 0,0:12:58.85,0:13:02.55,Default,,0,0,0,,Көпшілікке жариялауға болмайтын жасырын құжаттары бар кітапхана бар.
Dialogue: 0,0:13:02.64,0:13:03.77,Default,,0,0,0,,Оны қорғау үшін
Dialogue: 0,0:13:03.83,0:13:07.62,Default,,0,0,0,,Баяғыда сол жерде қамалған бір кітапханашы болыпты.
Dialogue: 0,0:13:07.89,0:13:09.80,Default,,0,0,0,,Ол жігіт әлі жер астында тірі.
Dialogue: 0,0:13:09.97,0:13:11.50,Default,,0,0,0,,Мен бұл дауысты естимін
Dialogue: 0,0:13:11.57,0:13:15.55,Default,,0,0,0,,Шынайы адам Чихики есімді мұғалім болса да, бұл мүмкін емес еді.
Dialogue: 0,0:13:16.01,0:13:17.70,Default,,0,0,0,,Бұл кездейсоқ естіледі.
Dialogue: 0,0:13:17.78,0:13:19.20,Default,,0,0,0,,Адамның ыңырануы
Dialogue: 0,0:13:20.13,0:13:20.79,Default,,0,0,0,,Маджи
Dialogue: 0,0:13:21.07,0:13:22.00,Default,,0,0,0,,Рас
Dialogue: 0,0:13:24.16,0:13:24.86,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:13:26.62,0:13:29.23,Default,,0,0,0,,Біраз ауа алайық.
Dialogue: 0,0:13:36.57,0:13:38.52,Default,,0,0,0,,Бұл мүлдем дұрыс емес.
Dialogue: 0,0:13:43.23,0:13:44.93,Default,,0,0,0,,Қараңызшы, бәрі жақсы.
Dialogue: 0,0:13:45.51,0:13:47.09,Default,,0,0,0,,Оларды түгелдей қырғындап тастауымыз керек!
Dialogue: 0,0:13:47.42,0:13:48.71,Default,,0,0,0,,Біреудің бақылауында болу
Dialogue: 0,0:13:48.78,0:13:51.44,Default,,0,0,0,,Мен де жаңа «Жеті керемет» болғым келмейді.
Dialogue: 0,0:13:51.56,0:13:53.42,Default,,0,0,0,,Терезені ашпайық.
Dialogue: 0,0:13:53.86,0:13:54.43,Default,,0,0,0,,Иә
Dialogue: 0,0:14:09.45,0:14:10.70,Default,,0,0,0,,Тешигахара
Dialogue: 0,0:14:13.79,0:14:15.57,Default,,0,0,0,,Қойшы.
Dialogue: 0,0:14:16.70,0:14:18.05,Default,,0,0,0,,Айтайын дегенім, мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:14:25.47,0:14:26.53,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:14:26.90,0:14:27.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.28,0:14:30.32,Default,,0,0,0,,Мен сізге қоңырау шаламын
Dialogue: 0,0:14:31.42,0:14:33.26,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:14:42.93,0:14:44.08,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:14:44.49,0:14:48.70,Default,,0,0,0,,Менің ойымша, бұл партаның ішіндегі сияқты оңай түсінікті жерде емес.
Dialogue: 0,0:14:49.07,0:14:51.45,Default,,0,0,0,,Бірақ бұл сіз оны ешқашан таба алмайтын жер.
Dialogue: 0,0:14:51.61,0:14:53.04,Default,,0,0,0,,Оны артта қалдырудың мағынасы жоқ.
Dialogue: 0,0:14:53.39,0:14:54.26,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:54.70,0:14:57.16,Default,,0,0,0,,Менің ойымша, бұл еденде немесе қабырғада емес.
Dialogue: 0,0:14:58.46,0:14:59.45,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:15:03.18,0:15:05.68,Default,,0,0,0,,Менің ойымша, жай ғана тазалау керек-жарақтары.
Dialogue: 0,0:15:07.58,0:15:08.40,Default,,0,0,0,,Не?
Dialogue: 0,0:15:10.86,0:15:11.97,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:15:15.93,0:15:17.02,Default,,0,0,0,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 0,0:15:17.29,0:15:18.74,Default,,0,0,0,,Онда бірдеңе жазылған.
Dialogue: 0,0:15:19.21,0:15:20.27,Default,,0,0,0,,Ум
Dialogue: 0,0:15:20.45,0:15:28.12,Default,,0,0,0,,Болашақта осы сыныпта орынсыз апаттарға ұшырайтын жасөспірімдерге.
Dialogue: 0,0:15:28.24,0:15:28.96,Default,,0,0,0,,Бинго
Dialogue: 0,0:15:29.19,0:15:30.12,Default,,0,0,0,,Міне осы
Dialogue: 0,0:15:30.38,0:15:32.72,Default,,0,0,0,,Мұны да Мацунага мырза жазғанына сенімдімін.
Dialogue: 0,0:15:52.02,0:15:54.36,Default,,0,0,0,,Міне, осында шығар.
Dialogue: 0,0:15:54.61,0:15:55.42,Default,,0,0,0,,Та-да!
Dialogue: 0,0:15:55.78,0:15:57.62,Default,,0,0,0,,Олар білмейінше, ешқандай проблема жоқ.
Dialogue: 0,0:16:13.70,0:16:14.65,Default,,0,0,0,,болды
Dialogue: 0,0:16:22.23,0:16:24.26,Default,,0,0,0,,Жарайды, қоңырау шалайық.
Dialogue: 0,0:16:41.24,0:16:42.13,Default,,0,0,0,,Ум
Dialogue: 0,0:16:42.72,0:16:46.80,Default,,0,0,0,,Менің атым Кацуми Мацунага
Dialogue: 0,0:16:47.33,0:16:51.72,Default,,0,0,0,,1983 жылғы 3-сынып оқушысы.
Dialogue: 0,0:16:52.36,0:16:56.76,Default,,0,0,0,,Жазуды аяқтағаннан кейін, мен бұл таспаны сыныптың бір жеріне жасырамын.
Dialogue: 0,0:16:57.60,0:17:00.10,Default,,0,0,0,,Қазір бұл таспаны тыңдап отырған «сіз».
Dialogue: 0,0:17:00.21,0:17:03.36,Default,,0,0,0,,Мүмкін бұл «сіздер» шығар
Dialogue: 0,0:17:03.92,0:17:06.81,Default,,0,0,0,,Сіздер болашақтың 3, 3 сынып оқушыларысыздар.
Dialogue: 0,0:17:07.16,0:17:10.09,Default,,0,0,0,,Бұл қаншалықты ықтимал?
Dialogue: 0,0:17:11.18,0:17:13.98,Default,,0,0,0,,Ал сендер, балалар, биыл мен
Dialogue: 0,0:17:14.45,0:17:17.12,Default,,0,0,0,,Біздің басымыздан өткен нәрсеге ұқсас
Dialogue: 0,0:17:17.20,0:17:19.68,Default,,0,0,0,,Ақылға сыймайтын апаттан қорқуыңыз мүмкін.
Dialogue: 0,0:17:20.75,0:17:21.87,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:17:22.28,0:17:25.07,Default,,0,0,0,,Мен осындай таспа қалдыруды жөн көрдім.
Dialogue: 0,0:17:25.11,0:17:26.69,Default,,0,0,0,,​​Оның екі мағынасы бар.
Dialogue: 0,0:17:27.27,0:17:31.39,Default,,0,0,0,,Біреуі – өз күнәларымды мойындауым
Dialogue: 0,0:17:32.08,0:17:34.31,Default,,0,0,0,,Мен не істегенімді біреуге айтқым келді.
Dialogue: 0,0:17:34.61,0:17:35.71,Default,,0,0,0,,Мен сенің тыңдағаныңды қалаймын
Dialogue: 0,0:17:36.60,0:17:41.49,Default,,0,0,0,,Тағы бір мағынасы кішілер, сіздерге бір ақыл айтқым келеді.
Dialogue: 0,0:17:42.86,0:17:45.00,Default,,0,0,0,,Сыныпқа араласатын «басқа адаммен».
Dialogue: 0,0:17:45.30,0:17:47.47,Default,,0,0,0,,Сол адамның кесірінен орын алған «апат».
Dialogue: 0,0:17:47.94,0:17:50.25,Default,,0,0,0,,Мұны тоқтату үшін не істеуіміз керек?
Dialogue: 0,0:17:50.76,0:17:52.52,Default,,0,0,0,,Яғни
Dialogue: 0,0:17:53.30,0:17:56.57,Default,,0,0,0,,Жоқ, менің ойымша, ретімен сөйлескен дұрыс.
Dialogue: 0,0:18:06.68,0:18:08.51,Default,,0,0,0,,Оқу-жаттығу жиыны болды.
Dialogue: 0,0:18:08.98,0:18:10.01,Default,,0,0,0,,8 тамыздан бастап
Dialogue: 0,0:18:10.03,0:18:12.30,Default,,0,0,0,,2 түн 3 күндік сыныптық оқу-жаттығу жиыны
Dialogue: 0,0:18:13.00,0:18:15.24,Default,,0,0,0,,Менің сыныптағы мұғалімім Кога мырза мұны ұсынды.
Dialogue: 0,0:18:15.48,0:18:18.29,Default,,0,0,0,,Жаттығу жиынын өткізіп, қасиетті орынға барайық.
Dialogue: 0,0:18:19.09,0:18:23.07,Default,,0,0,0,,Ямиямада ''Ямияма храмы'' деп аталатын ескі ғибадатхана бар.
Dialogue: 0,0:18:23.28,0:18:25.11,Default,,0,0,0,,Бәріміз сонда дұға еткенде,
Dialogue: 0,0:18:25.42,0:18:27.94,Default,,0,0,0,,Қарғыс жойылатынына сенімдімін.
Dialogue: 0,0:18:28.81,0:18:31.60,Default,,0,0,0,,Мені қосқанда жиырма студент қатысты.
Dialogue: 0,0:18:32.03,0:18:34.62,Default,,0,0,0,,Барлығы күмәнданды, бірақ
Dialogue: 0,0:18:35.91,0:18:37.32,Default,,0,0,0,,Оқу-жаттығу жиынының екінші күні
Dialogue: 0,0:18:37.86,0:18:40.42,Default,,0,0,0,,Сол күні ұстазымызбен бірге тауға шықтық.
Dialogue: 0,0:18:40.73,0:18:42.36,Default,,0,0,0,,Мен бір қасиетті жерге бардым.
Dialogue: 0,0:18:43.14,0:18:45.07,Default,,0,0,0,,Бұл өте қаңырап бос жатқан ғибадатхана болды.
Dialogue: 0,0:18:45.85,0:18:48.86,Default,,0,0,0,,Мені дүние әлдеқашан тастап кеткен сияқты.
Dialogue: 0,0:18:49.35,0:18:51.76,Default,,0,0,0,,Қасиетті орын осы қаланың атымен аталғанымен.
Dialogue: 0,0:18:52.07,0:18:54.40,Default,,0,0,0,,Ол мүлде басқарылмайтын сияқты болды.
Dialogue: 0,0:18:55.01,0:18:59.23,Default,,0,0,0,,Ендеше, сіз намаз оқып жатқанда, әркім қасиетті жерлерді тазарту керек.
Dialogue: 0,0:19:00.03,0:19:03.66,Default,,0,0,0,,Сол кезде мен: «Мүмкін бұл қарғысты бұзады» деп ойладым.
Dialogue: 0,0:19:03.68,0:19:05.86,Default,,0,0,0,,Мен сезіндім
Dialogue: 0,0:19:06.50,0:19:09.04,Default,,0,0,0,,Сапардан кейін ұстаз сенімге толы болды.
Dialogue: 0,0:19:09.74,0:19:11.85,Default,,0,0,0,,«Қазір бәрі жақсы».
Dialogue: 0,0:19:12.83,0:19:15.60,Default,,0,0,0,,Бірақ ол жұмыс істемеді.
Dialogue: 0,0:19:16.11,0:19:17.90,Default,,0,0,0,,Бұл соншалықты тәтті емес еді.
Dialogue: 0,0:19:18.77,0:19:20.85,Default,,0,0,0,,Мен ғибадатханадан қайтып келе жатқан едім.
Dialogue: 0,0:19:21.50,0:19:22.90,Default,,0,0,0,,Ауа-райы әрқашан жақсы болды.
Dialogue: 0,0:19:22.95,0:19:24.95,Default,,0,0,0,,Бұлттар кенеттен күдіктене бастады.
Dialogue: 0,0:19:25.17,0:19:26.44,Default,,0,0,0,,Жаңбыр жауа бастады
Dialogue: 0,0:19:26.86,0:19:28.81,Default,,0,0,0,,Және бұл қорқынышты найзағай болды.
Dialogue: 0,0:19:29.72,0:19:31.32,Default,,0,0,0,,Таудан асығыс түсу
Dialogue: 0,0:19:31.70,0:19:35.44,Default,,0,0,0,,Бірінші шабуылға ұшыраған адам Хамагучи есімді бала болды.
Dialogue: 0,0:19:36.43,0:19:37.73,Default,,0,0,0,,Ол ақымақ.
Dialogue: 0,0:19:37.98,0:19:40.14,Default,,0,0,0,,Абайлаңыз және қолшатыр әкеліңіз.
Dialogue: 0,0:19:40.48,0:19:41.94,Default,,0,0,0,,Мен жалғыз нұсқадым.
Dialogue: 0,0:19:42.64,0:19:44.59,Default,,0,0,0,,Тау жолында найзағай ойнаса да
Dialogue: 0,0:19:45.18,0:19:48.47,Default,,0,0,0,,Әлгі Хамагучи менің алдымда келе жатты.
Dialogue: 0,0:19:49.44,0:19:51.99,Default,,0,0,0,,Бір сәтке көзім ақ түсті.
Dialogue: 0,0:19:52.25,0:19:54.47,Default,,0,0,0,,Дәл осы кезде керемет дыбыс шықты.
Dialogue: 0,0:19:55.53,0:19:58.11,Default,,0,0,0,,Гамагучиге найзағай түсті.
Dialogue: 0,0:19:59.10,0:20:02.39,Default,,0,0,0,,Күйген еттің жағымсыз иісі әлі есімде.
Dialogue: 0,0:20:03.73,0:20:05.75,Default,,0,0,0,,Дегенмен, бұл жер қазірдің өзінде дүрбелең
Dialogue: 0,0:20:06.33,0:20:08.27,Default,,0,0,0,,Гамагучиді жайына қалдырыңыз.
Dialogue: 0,0:20:08.62,0:20:10.54,Default,,0,0,0,,Оқушылардың көпшілігі жүгіре бастады.
Dialogue: 0,0:20:10.70,0:20:12.83,Default,,0,0,0,,Қалай болғанда да таудан тез түсуім керек.
Dialogue: 0,0:20:13.55,0:20:16.63,Default,,0,0,0,,Мен жаңбырда соқыр жүгіре бастағаннан кейін болды.
Dialogue: 0,0:20:18.63,0:20:20.70,Default,,0,0,0,,Екінші құрбан болды.
Dialogue: 0,0:20:21.71,0:20:23.70,Default,,0,0,0,,Хошикава қыз болған.
Dialogue: 0,0:20:24.62,0:20:29.30,Default,,0,0,0,,Дүрбелеңде жүгіріп келе жатып, аяғымнан айырылып, жардан құладым.
Dialogue: 0,0:20:29.64,0:20:31.12,Default,,0,0,0,,Тік биік жартаста
Dialogue: 0,0:20:31.63,0:20:34.14,Default,,0,0,0,,Таудан төмен түсіп, көмекке шақырудан басқа амалым қалмады.
Dialogue: 0,0:20:35.38,0:20:39.04,Default,,0,0,0,,Ақырында екеуі де аман қалмады.
Dialogue: 0,0:20:40.78,0:20:44.17,Default,,0,0,0,,Қасиетті зиярат етудің еш әсері болмады.
Dialogue: 0,0:20:44.85,0:20:45.43,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:20:46.21,0:20:48.51,Default,,0,0,0,,Маңыздысы осыдан кейін.
Dialogue: 0,0:20:49.59,0:20:51.87,Default,,0,0,0,,Таудан түскеннен кейін бірден
Dialogue: 0,0:20:52.17,0:20:53.46,Default,,0,0,0,,Міне, солай болды
Dialogue: 0,0:20:54.32,0:20:57.40,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:20:58.48,0:20:59.18,Default,,0,0,0,,I
Dialogue: 0,0:21:10.49,0:21:11.50,Default,,0,0,0,,Ябе
Dialogue: 0,0:21:31.43,0:21:33.06,Default,,0,0,0,,Қауіп
Dialogue: 0,0:21:34.96,0:21:37.10,Default,,0,0,0,,Күткендей салқын тер шықты.
Dialogue: 0,0:21:37.47,0:21:38.59,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:21:40.20,0:21:41.19,Default,,0,0,0,,Таспа
Dialogue: 0,0:21:47.02,0:21:48.01,Default,,0,0,0,,Біраз
Dialogue: 0,0:21:49.10,0:21:50.08,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:21:52.31,0:21:53.39,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:21:53.71,0:21:55.98,Default,,0,0,0,,Мен маңызды бөлігін естіген жоқпын.
Dialogue: 0,0:21:56.44,0:21:57.63,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:21:57.93,0:22:00.39,Default,,0,0,0,,Оны жөндегеннен кейін еститініңізге сенімдімін.
Dialogue: 0,0:22:01.12,0:22:02.46,Default,,0,0,0,,Мұны түзетуге бола ма?
Dialogue: 0,0:22:02.92,0:22:04.86,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:22:04.99,0:22:06.67,Default,,0,0,0,,Жарайды, оны сізге қалдырамын.
Dialogue: 0,0:22:07.14,0:22:08.87,Default,,0,0,0,,Жалғастырыңыз, тыңдауға рұқсат етіңіз.
Dialogue: 0,0:22:09.22,0:22:11.16,Default,,0,0,0,,Оны маған қалдыру дұрыс емес
Dialogue: 0,0:22:11.41,0:22:15.07,Default,,0,0,0,,Иә, мен оны бәрібір көремін.
Dialogue: 0,0:22:55.45,0:22:56.33,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:23:04.73,0:23:19.60,Default,,0,0,0,,Фильм сияқты өшеді
Dialogue: 0,0:23:22.47,0:23:37.36,Default,,0,0,0,,Тіпті белгілі бір сыйлық ақырында бұлыңғыр болады
Dialogue: 0,0:23:37.38,0:23:46.36,Default,,0,0,0,,Ештеңеге бірге күлдік
Dialogue: 0,0:23:46.36,0:23:55.61,Default,,0,0,0,,Уақыт пен жарық
Dialogue: 0,0:23:56.10,0:24:05.10,Default,,0,0,0,,Байланысты естеліктеріміздің түбінде
Dialogue: 0,0:24:05.10,0:24:24.06,Default,,0,0,0,,Мен әлі де біреудің таба алатынына сенемін.
Dialogue: 0,0:24:25.56,0:24:30.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
