Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:41.53,0:01:46.70,Default,,0,0,0,,《Юдзуки: Мен, Нанасе Юдзуки, ерекше қызбын➨
Dialogue: 0,0:01:46.70,0:01:50.04,Default,,0,0,0,,Мен мұны ерте байқадым.
Dialogue: 0,0:01:50.04,0:01:55.54,Default,,0,0,0,,Осы кезде мен жай ғана ерекше адам ретінде өмір сүру қиын болатынын түсіндім➨
Dialogue: 0,0:01:55.54,0:01:58.88,Default,,0,0,0,,Менің ойымша, бұл өте жылдам болды.
Dialogue: 0,0:01:58.88,0:02:04.65,Default,,0,0,0,,Сондықтан мен жақсырақ болу үшін өзімнің әртүрлі нұсқаларын жасадым.
Dialogue: 0,0:02:04.65,0:02:09.49,Default,,0,0,0,,Әрине, мен басқаларға қарағанда тұрақты күш салдым.
Dialogue: 0,0:02:09.49,0:02:14.66,Default,,0,0,0,,Мен әрқашан өзімнің жақсырақ нұсқа болғым келеді.
Dialogue: 0,0:02:14.66,0:02:19.33,Default,,0,0,0,,Сол күні мен зорлық-зомбылықтан да қатты қорқатыным➨ болды
Dialogue: 0,0:02:19.33,0:02:22.50,Default,,0,0,0,,Солай болса да, өзек сияқты нәрсе ➨
Dialogue: 0,0:02:22.50,0:02:26.34,Default,,0,0,0,,Менің ішімде ештеңе болған жоқ.
Dialogue: 0,0:02:26.34,0:02:32.18,Default,,0,0,0,,"Юдзуки Нанасенің мақтанышы оның жай ғана айуандық зорлық-зомбылыққа берілуіне жол бермейді" ➨
Dialogue: 0,0:02:32.18,0:02:35.68,Default,,0,0,0,,«Мен сүйген адамым үшін мұндай адамға берілмеймін»➨
Dialogue: 0,0:02:35.68,0:02:39.35,Default,,0,0,0,,Бұлай емес еді. Ол бос.
Dialogue: 0,0:02:39.35,0:02:43.36,Default,,0,0,0,,Мені кім көрсе де, менде бәрі бар сияқты➨
Dialogue: 0,0:02:43.36,0:02:47.53,Default,,0,0,0,,Менің ойымша, сізде ештеңе жоқ.
Dialogue: 0,0:02:47.53,0:02:53.37,Default,,0,0,0,,Бірінші рет өзімді өзімнен де жарқынмын деп ойладым➨
Dialogue: 0,0:02:53.37,0:02:58.71,Default,,0,0,0,,Көк теңізге күн нұрын шашады.
Dialogue: 0,0:02:58.71,0:03:01.64,Default,,0,0,0,,Жалпы күш өте төмен➨
Dialogue: 0,0:03:01.64,0:03:06.31,Default,,0,0,0,,Құлап қалсаң да күлімдеп, қайта жүгіре бастаған көздер➨
Dialogue: 0,0:03:06.31,0:03:08.82,Default,,0,0,0,,Алға қарау》
Dialogue: 0,0:03:08.82,0:03:10.82,Default,,0,0,0,,⸨Ян: Міне...!
Dialogue: 0,0:03:10.82,0:03:14.49,Default,,0,0,0,,Не болды! (шузер)
Dialogue: 0,0:03:14.49,0:03:16.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:18.99,0:03:22.16,Default,,0,0,0,,Хехехе….
Dialogue: 0,0:03:22.16,0:03:25.83,Default,,0,0,0,,Ах. Сен орта мектепке қайда барасың?
Dialogue: 0,0:03:25.83,0:03:28.14,Default,,0,0,0,,Аа... Фудишико! ⸩
Dialogue: 0,0:03:31.17,0:03:33.84,Default,,0,0,0,,《Юдзуки: Мені қызықтырған келесі нәрсе➨ болды
Dialogue: 0,0:03:33.84,0:03:36.34,Default,,0,0,0,,Қап-қара жаңа ай түні.
Dialogue: 0,0:03:36.34,0:03:40.18,Default,,0,0,0,,Мен ол баланы өмірімде бірінші рет таптым➨
Dialogue: 0,0:03:40.18,0:03:43.02,Default,,0,0,0,,Ол өз түрінен болды.
Dialogue: 0,0:03:43.02,0:03:46.52,Default,,0,0,0,,Сіз ештеңе істей алмайсыз, өйткені сіз ештеңе істей аласыз.
Dialogue: 0,0:03:46.52,0:03:49.02,Default,,0,0,0,,Кімге айтсаң да, саған күледі➨
Dialogue: 0,0:03:49.02,0:03:53.53,Default,,0,0,0,,Ол кішкентай, таяз қараңғылықты да құшақтайды.
Dialogue: 0,0:03:53.53,0:03:56.03,Default,,0,0,0,,Мүмкін бір адам➨
Dialogue: 0,0:03:56.03,0:04:00.14,Default,,0,0,0,,Бірін-бірі дұрыс түсінетін адам болуы мүмкін.
Dialogue: 0,0:04:00.14,0:04:04.81,Default,,0,0,0,,Міне, екі айдан аз уақыт өтті. Менің көргенім➨ болды
Dialogue: 0,0:04:04.81,0:04:07.81,Default,,0,0,0,,Барлығын аспаннан бақылап отыру➨
Dialogue: 0,0:04:07.81,0:04:10.48,Default,,0,0,0,,Бұл үлкен толық ай болды.
Dialogue: 0,0:04:10.48,0:04:14.15,Default,,0,0,0,,Бұл мүлдем басқаша болды. Бұл бірдей емес еді.
Dialogue: 0,0:04:14.15,0:04:17.15,Default,,0,0,0,,Өмір сүру қандай ебедейсіз.
Dialogue: 0,0:04:17.15,0:04:19.65,Default,,0,0,0,,Мен жақсырақ істей алар едім➨
Dialogue: 0,0:04:19.65,0:04:23.33,Default,,0,0,0,,Бала салқын болуға тырысып жатып, көп нәрсеге соқтығысты➨
Dialogue: 0,0:04:23.33,0:04:27.00,Default,,0,0,0,,Тозған, бірақ әлі де алға➨
Dialogue: 0,0:04:27.00,0:04:31.33,Default,,0,0,0,,Қабырғаларды бір-бірлеп бұзу арқылы жалғастырыңыз.
Dialogue: 0,0:04:31.33,0:04:35.17,Default,,0,0,0,,- Біз ұқсаспыз, - деді Саку.
Dialogue: 0,0:04:35.17,0:04:40.01,Default,,0,0,0,,Менің ойымша, біз мүлдем басқамыз.
Dialogue: 0,0:04:40.01,0:04:43.68,Default,,0,0,0,,Қыздың жарасын жазамын десеңіз➨
Dialogue: 0,0:04:43.68,0:04:47.02,Default,,0,0,0,,Мені ақырын құшақтап, "Мен сені қорғаймын" деп айт➨
Dialogue: 0,0:04:47.02,0:04:49.68,Default,,0,0,0,,Тәтті сыбырлау дұрыс емес пе?
Dialogue: 0,0:04:49.68,0:04:54.36,Default,,0,0,0,,Осындай атмосферамен мен оған Шудан сәл артық шыдайтын едім.
Dialogue: 0,0:04:54.36,0:04:57.36,Default,,0,0,0,,Мен оны итеріп жібергеннен кейін солай болды деп ойлаймын➨
Dialogue: 0,0:04:57.36,0:04:59.36,Default,,0,0,0,,Біреуді тұруға мәжбүрлеу➨
Dialogue: 0,0:04:59.36,0:05:02.06,Default,,0,0,0,,Мен мұндай ханзада туралы естімеппін! 》
Dialogue: 0,0:05:06.30,0:05:09.97,Default,,0,0,0,,《Бірақ, бірақ.
Dialogue: 0,0:05:09.97,0:05:12.14,Default,,0,0,0,,Мен де сондаймын➨
Dialogue: 0,0:05:12.14,0:05:16.31,Default,,0,0,0,,Мен әдемі өмір сүргім келді.
Dialogue: 0,0:05:16.31,0:05:20.32,Default,,0,0,0,,Дайын бол, Читосе Саку》
Dialogue: 0,0:05:25.15,0:05:29.99,Default,,0,0,0,,《Мен саған айтамын, жаулап алуды күтіп тұрғаны сонша, тыныш➨
Dialogue: 0,0:05:29.99,0:05:32.59,Default,,0,0,0,,Өйткені мен тәтті әйел емеспін》
Dialogue: 0,0:05:36.00,0:05:38.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:38.50,0:05:41.50,Default,,0,0,0,,Йо Юдзуки.
Dialogue: 0,0:05:41.50,0:05:44.67,Default,,0,0,0,,Иә! Уф….
Dialogue: 0,0:05:44.67,0:05:49.08,Default,,0,0,0,,Әңгімелесеміз бе, Янагишита-сенпай?
Dialogue: 0,0:05:52.68,0:05:55.88,Default,,0,0,0,,Сонда менімен не істегіңіз келеді?
Dialogue: 0,0:06:04.96,0:06:08.30,Default,,0,0,0,,Бұл мен кіші мектепте оқып жүргенде істей алмайтын нәрсе болды.
Dialogue: 0,0:06:08.30,0:06:11.30,Default,,0,0,0,,Бұл сіздің араласқыңыз келетінін білдіре ме?
Dialogue: 0,0:06:11.30,0:06:14.30,Default,,0,0,0,,Әлде... тентек пе?
Dialogue: 0,0:06:14.30,0:06:16.97,Default,,0,0,0,,Әзірше маған рұқсат етіңіз.
Dialogue: 0,0:06:16.97,0:06:19.47,Default,,0,0,0,,Орта мектепте жігіттерді өзгертуге болмайды.
Dialogue: 0,0:06:19.47,0:06:21.98,Default,,0,0,0,,Кух….
Dialogue: 0,0:06:21.98,0:06:25.31,Default,,0,0,0,,Кім маған не сіңіргенін білмеймін➨
Dialogue: 0,0:06:25.31,0:06:27.65,Default,,0,0,0,,Мен пәкпін, ақымақ!
Dialogue: 0,0:06:27.65,0:06:30.49,Default,,0,0,0,,Мен оны сендей адамға ешқашан бермес едім!
Dialogue: 0,0:06:30.49,0:06:33.32,Default,,0,0,0,,Иә? Бұл жақсы.
Dialogue: 0,0:06:33.32,0:06:35.49,Default,,0,0,0,,Мен оны нөлден дайындаймын.
Dialogue: 0,0:06:35.49,0:06:40.16,Default,,0,0,0,,Мені күштеп сүйсе немесе зорласа да, мен мұны ешқашан жасамас едім➨
Dialogue: 0,0:06:40.16,0:06:42.16,Default,,0,0,0,,Бұл сенікі емес!
Dialogue: 0,0:06:44.33,0:06:46.67,Default,,0,0,0,,Олай болса жасап көрейік.
Dialogue: 0,0:06:46.67,0:06:48.84,Default,,0,0,0,,(Шапалақ дыбысы)
Dialogue: 0,0:06:48.84,0:06:51.84,Default,,0,0,0,,Жүр, сол кездегідей жыла.
Dialogue: 0,0:06:51.84,0:06:56.18,Default,,0,0,0,,Бұл жүректе саған орын жоқ!
Dialogue: 0,0:06:56.18,0:06:58.18,Default,,0,0,0,,Мен әскермен бәрін реттедім.
Dialogue: 0,0:07:01.28,0:07:04.62,Default,,0,0,0,,《Қорқынышты, қорқынышты...
Dialogue: 0,0:07:04.62,0:07:06.62,Default,,0,0,0,,Қорықпа! 》
Dialogue: 0,0:07:06.62,0:07:11.63,Default,,0,0,0,,Жүрегімді сендей адам ауыртпайды.
Dialogue: 0,0:07:11.63,0:07:15.30,Default,,0,0,0,,Полицияға барған аянышты адамның аянышты өмірі➨
Dialogue: 0,0:07:15.30,0:07:17.30,Default,,0,0,0,,Мен оны барлығына көрсетемін!
Dialogue: 0,0:07:17.30,0:07:19.30,Default,,0,0,0,,Байқап көріңіз.
Dialogue: 0,0:07:19.30,0:07:22.80,Default,,0,0,0,,《Жарайды, Саку. Қазір ➨
Dialogue: 0,0:07:22.80,0:07:25.81,Default,,0,0,0,,Ішімде жанып тұрған өзек бар.
Dialogue: 0,0:07:25.81,0:07:29.14,Default,,0,0,0,,Мен бұл есімді сіздің арқаңызда алған сияқтымын.
Dialogue: 0,0:07:29.14,0:07:34.82,Default,,0,0,0,,Ешқашан бұлыңғыр, өшпесін, жоғалып кетпеуі үшін.
Dialogue: 0,0:07:34.82,0:07:38.32,Default,,0,0,0,,Саку Саку Саку!
Dialogue: 0,0:07:38.32,0:07:41.16,Default,,0,0,0,,Саку Саку...! 》
Dialogue: 0,0:07:41.16,0:07:43.66,Default,,0,0,0,,Саку!
Dialogue: 0,0:07:43.66,0:07:46.86,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба? Ханшайым.
Dialogue: 0,0:07:50.33,0:07:52.33,Default,,0,0,0,,Hmph.
Dialogue: 0,0:07:52.33,0:07:55.14,Default,,0,0,0,,Айтпасаң да түсінікті — өзің көресің
Dialogue: 0,0:07:59.51,0:08:03.78,Default,,0,0,0,,Тоқта! Өтінемін, тоқтатыңыз! (Ягишита) Мен тоқтамаймын.
Dialogue: 0,0:08:03.78,0:08:06.78,Default,,0,0,0,,Мен не туралы армандағанымды білмеймін!
Dialogue: 0,0:08:06.78,0:08:10.45,Default,,0,0,0,,Біз бала кезімізден бері төбелесіп келеміз!
Dialogue: 0,0:08:10.45,0:08:15.46,Default,,0,0,0,,Құрметті студент бұл туралы ештеңе істей алмайды!
Dialogue: 0,0:08:15.46,0:08:17.46,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:08:17.46,0:08:21.30,Default,,0,0,0,,Егер Юдзуки тыныш менікі болса, мұны істеуді тоқтатуға болады.
Dialogue: 0,0:08:21.30,0:08:23.63,Default,,0,0,0,,Ке... Мен полиция шақырамын!
Dialogue: 0,0:08:23.63,0:08:25.97,Default,,0,0,0,,Қалай ойлайсыз?
Dialogue: 0,0:08:25.97,0:08:31.64,Default,,0,0,0,,Қараңызшы, бұл сіздің ағаңызға тиесілі болады деп айтыңыз. Бұл жігіт өледі.
Dialogue: 0,0:08:31.64,0:08:33.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:35.81,0:08:39.65,Default,,0,0,0,,Көкек… Пай….
Dialogue: 0,0:08:39.65,0:08:41.65,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:08:41.65,0:08:45.32,Default,,0,0,0,,Янагишита... Сенпайдың... заттары...
Dialogue: 0,0:08:45.32,0:08:47.49,Default,,0,0,0,,Бұл дұрыс емес. Ха!
Dialogue: 0,0:08:47.49,0:08:52.16,Default,,0,0,0,,Бұл... жай ғана азап...
Dialogue: 0,0:08:52.16,0:08:55.56,Default,,0,0,0,,⸨Аурудың жүрегіңізді басқаруына жол бермеңіз⸩
Dialogue: 0,0:08:57.50,0:09:03.27,Default,,0,0,0,,《Дұрыс, енді маған тезірек көмек шақыру керек.
Dialogue: 0,0:09:03.27,0:09:05.27,Default,,0,0,0,,Көз жасыңа ерік берме!
Dialogue: 0,0:09:05.27,0:09:07.44,Default,,0,0,0,,Аяғыңызды жылжытыңыз!
Dialogue: 0,0:09:07.44,0:09:09.61,Default,,0,0,0,,Алға қара! 》
Dialogue: 0,0:09:09.61,0:09:11.78,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:09:11.78,0:09:14.12,Default,,0,0,0,,Кух….
Dialogue: 0,0:09:14.12,0:09:18.12,Default,,0,0,0,,Мен Читосе Сакудың қызымын!
Dialogue: 0,0:09:18.12,0:09:20.96,Default,,0,0,0,,Жалғыз әйел, дұрыс сөйлей алмайтын қорқақ➨
Dialogue: 0,0:09:20.96,0:09:23.63,Default,,0,0,0,,Сен маған бір саусағыңмен тигізуге рұқсат бересің бе?
Dialogue: 0,0:09:23.63,0:09:25.79,Default,,0,0,0,,Сендер, үндемеңдер!➡
Dialogue: 0,0:09:25.79,0:09:28.30,Default,,0,0,0,,Иә, кес!
Dialogue: 0,0:09:28.30,0:09:30.80,Default,,0,0,0,,О? Бұл не?
Dialogue: 0,0:09:30.80,0:09:33.47,Default,,0,0,0,,Жарайды. Мұнда тез кел.
Dialogue: 0,0:09:33.47,0:09:35.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.80,0:09:40.14,Default,,0,0,0,,Сонымен... Жарайды, Казуки.
Dialogue: 0,0:09:40.14,0:09:42.14,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:09:42.14,0:09:44.81,Default,,0,0,0,,Кез келген адам жағдайды қалай қараса да түсінуі үшін➨
Dialogue: 0,0:09:44.81,0:09:46.98,Default,,0,0,0,,Мен дәл түсірдім.
Dialogue: 0,0:09:46.98,0:09:49.32,Default,,0,0,0,,Таку.
Dialogue: 0,0:09:49.32,0:09:52.82,Default,,0,0,0,,Мен бастауыш мектептен үйге келе жатқанда жатырмын➨
Dialogue: 0,0:09:52.82,0:09:55.16,Default,,0,0,0,,Бос банкалар керемет!
Dialogue: 0,0:09:55.16,0:09:57.16,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:57.16,0:10:01.16,Default,,0,0,0,,Эй, Мизушино, тезірек полиция шақыр. Қазір бәрі жақсы.
Dialogue: 0,0:10:01.16,0:10:04.83,Default,,0,0,0,,Осы жерге полиция шақырсақ, оның тынымсыз еңбегі тайғақ болады.
Dialogue: 0,0:10:04.83,0:10:08.67,Default,,0,0,0,,Қатты доп бүйірден соғылғаннан жақсы.
Dialogue: 0,0:10:08.67,0:10:11.01,Default,,0,0,0,,Жақсы айтты Юдзуки Нанасе.
Dialogue: 0,0:10:11.01,0:10:16.11,Default,,0,0,0,,Қалғанын сенімді жігітіңіз Саку Читосеге қалдырыңыз.
Dialogue: 0,0:10:18.18,0:10:23.02,Default,,0,0,0,,Tsk! Өл, сен!
Dialogue: 0,0:10:23.02,0:10:26.19,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:10:26.19,0:10:29.36,Default,,0,0,0,,Теми!
Dialogue: 0,0:10:29.36,0:10:34.86,Default,,0,0,0,,Мен бейсбол ойнаған кезден бері мен өзімнің динамикалық көзқарасым мен жарылғыш күшіме сенімдімін.
Dialogue: 0,0:10:34.86,0:10:37.37,Default,,0,0,0,,Мен саған қайта ораламын, Пейсен.
Dialogue: 0,0:10:37.37,0:10:41.04,Default,,0,0,0,,Бала кезінен өлемін деп спортқа берілген адамға➨
Dialogue: 0,0:10:41.04,0:10:43.87,Default,,0,0,0,,Сіз жай ғана көңілді болдыңыз➨
Dialogue: 0,0:10:43.87,0:10:47.08,Default,,0,0,0,,Сіз шынымен де күшпен жеңемін деп ойладыңыз ба? ?
Dialogue: 0,0:10:50.21,0:10:54.38,Default,,0,0,0,,Уф...гохо гохо гу...
Dialogue: 0,0:10:54.38,0:10:56.38,Default,,0,0,0,,Мен сізге айтамын.
Dialogue: 0,0:10:56.38,0:10:59.22,Default,,0,0,0,,Зорлық-зомбылық көрсете алуыңыз сіздің күшті екеніңізді білдірмейді.
Dialogue: 0,0:10:59.22,0:11:02.16,Default,,0,0,0,,Әркім жасамауға тырысатын зорлық-зомбылыққа➨
Dialogue: 0,0:11:02.16,0:11:05.66,Default,,0,0,0,,Сен соншалықты әлсізсің, мен саған арқа сүйеуім керек.
Dialogue: 0,0:11:05.66,0:11:11.17,Default,,0,0,0,,Сондықтан мен сол алаңда тұруға лайықты себеп дайындадым.
Dialogue: 0,0:11:11.17,0:11:13.67,Default,,0,0,0,,Барлығы дәл жазылған.
Dialogue: 0,0:11:13.67,0:11:17.34,Default,,0,0,0,,Ендеше алаңсыз күресейік.
Dialogue: 0,0:11:17.34,0:11:19.84,Default,,0,0,0,,Мұндай айуандық сөздерді қолданбауыңызды өтінемін.
Dialogue: 0,0:11:19.84,0:11:23.85,Default,,0,0,0,,Бұдан былай, бұл өзін-өзі қорғаудың талғампаздығы!
Dialogue: 0,0:11:23.85,0:11:25.85,Default,,0,0,0,,Жарайды онда
Dialogue: 0,0:11:28.52,0:11:30.52,Default,,0,0,0,,Есте сақта.
Dialogue: 0,0:11:30.52,0:11:32.52,Default,,0,0,0,,Гаа...!
Dialogue: 0,0:11:32.52,0:11:35.52,Default,,0,0,0,,Маған жауап бер, Сенпай. Қарсы тұру мүмкін емес➨
Dialogue: 0,0:11:35.52,0:11:39.53,Default,,0,0,0,,Сіз өзіңізден күшті біреудің соққысынан қорқасыз ба?
Dialogue: 0,0:11:39.53,0:11:43.03,Default,,0,0,0,,Менің ойымша, сіз дайынсыз.
Dialogue: 0,0:11:43.03,0:11:46.33,Default,,0,0,0,,Мен өзіммен бірге бір топ адамды алып келдім, ал Юдзуки екеуің бәрің де бейберекетсіңдер...
Dialogue: 0,0:11:49.87,0:11:54.04,Default,,0,0,0,,Ардақты студент бастық болып... маған қарап тұрды.
Dialogue: 0,0:11:54.04,0:11:56.21,Default,,0,0,0,,Мен де бұрын...
Dialogue: 0,0:11:56.21,0:11:59.88,Default,,0,0,0,,Кешіріңіз, бірақ мені Теменің өткені қызықтырмайды.
Dialogue: 0,0:11:59.88,0:12:03.48,Default,,0,0,0,,Мен бір ғана нәрсені айта аламын! Өмірден қашу➨
Dialogue: 0,0:12:03.48,0:12:06.49,Default,,0,0,0,,Басқаларды да тартуға тырысатындарыңыздан➨
Dialogue: 0,0:12:06.49,0:12:10.33,Default,,0,0,0,,Тісін қайрап, түзу өмір сүруге тырысатын адамдар жақсы➨
Dialogue: 0,0:12:10.33,0:12:14.33,Default,,0,0,0,,Бұл 100 есе керемет! Ха!
Dialogue: 0,0:12:14.33,0:12:17.00,Default,,0,0,0,,Өкінемін...
Dialogue: 0,0:12:17.00,0:12:20.17,Default,,0,0,0,,Тыңдаңыз, егер сіз болашақта Юдзукиге жақындағыңыз келсе➨
Dialogue: 0,0:12:20.17,0:12:23.34,Default,,0,0,0,,Барлық мүмкін құралдармен➨
Dialogue: 0,0:12:23.34,0:12:25.67,Default,,0,0,0,,Мен сені құртамын.
Dialogue: 0,0:12:25.67,0:12:31.01,Default,,0,0,0,,Бірнеше адам мені ұрып-соғуға тырысса да, мен сені тек бұрышқа апарамын.
Dialogue: 0,0:12:31.01,0:12:35.35,Default,,0,0,0,,Хана Юдзуки, теңдесі жоқ қорқынышты естеліктер➨
Dialogue: 0,0:12:35.35,0:12:39.52,Default,,0,0,0,,Мен көптен бері жалғыз күресіп келемін!
Dialogue: 0,0:12:39.52,0:12:48.03,Default,,0,0,0,,《Оның жүрегін өлтіріп, батырдың рөлін сомдағанын көру мұң екен, жоқ, жауыз...
Dialogue: 0,0:12:48.03,0:12:52.53,Default,,0,0,0,,Мұңайдым... Көңілдім.
Dialogue: 0,0:12:52.53,0:12:55.70,Default,,0,0,0,,Бұл бет сізге сәйкес келмейді.
Dialogue: 0,0:12:55.70,0:12:59.21,Default,,0,0,0,,Мен сенің әдеттегідей салқын және күлімдегеніңді қалаймын.
Dialogue: 0,0:12:59.21,0:13:02.64,Default,,0,0,0,,Менің шарасыз әзіліме күлгеніңді қалаймын》
Dialogue: 0,0:13:02.64,0:13:08.32,Default,,0,0,0,,Иә. Мен бұл туралы көп айттым, бірақ мен айтқым келетін бір нәрсе бар.
Dialogue: 0,0:13:08.32,0:13:10.65,Default,,0,0,0,,Уау.
Dialogue: 0,0:13:10.65,0:13:15.82,Default,,0,0,0,,Теми! Келесі жолы сен менің әйеліме тиіссең, мен сені өлтіремін!
Dialogue: 0,0:13:15.82,0:13:18.63,Default,,0,0,0,,Гах...!
Dialogue: 0,0:13:23.83,0:13:29.04,Default,,0,0,0,,Жарайды. Канаваги: ​​Юдзукиден аулақ жүр.
Dialogue: 0,0:13:31.01,0:13:33.17,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:33.17,0:13:45.19,Default,,0,0,0,,♬～
Dialogue: 0,0:13:45.19,0:13:49.19,Default,,0,0,0,,《Сіз көрсеткен мейірімді және мұңды күлкіңіз➨
Dialogue: 0,0:13:49.19,0:13:53.59,Default,,0,0,0,,Ұмытпау керек деп ойладым.
Dialogue: 0,0:13:57.87,0:14:02.14,Default,,0,0,0,,Идиот! Ақымақ, ақымақ, ақымақ, ақымақ... ақымақ!
Dialogue: 0,0:14:02.14,0:14:07.14,Default,,0,0,0,,Өзіңді қорғаудың дәлелі керек болса, мені соққыға жыққан сәт жеткілікті.
Dialogue: 0,0:14:07.14,0:14:11.81,Default,,0,0,0,,Неліктен Сакуды меннен артық тепкілеу керек?
Dialogue: 0,0:14:11.81,0:14:15.52,Default,,0,0,0,,Өйткені оның арқасынан соққан менмін.
Dialogue: 0,0:14:17.99,0:14:20.49,Default,,0,0,0,,Сен ақымақсың, Саку...
Dialogue: 0,0:14:20.49,0:14:25.49,Default,,0,0,0,,Неге... маған көмектесуге келдің?
Dialogue: 0,0:14:25.49,0:14:30.50,Default,,0,0,0,,Себебі қоштасу сөздеріңді әлі естіген жоқпын.
Dialogue: 0,0:14:30.50,0:14:34.60,Default,,0,0,0,,Шынымен... ақымақ.
Dialogue: 0,0:14:41.84,0:14:46.68,Default,,0,0,0,,《Юзуки: Дәл қазір менің жүрегім мамырдың ашық аспаны сияқты➨
Dialogue: 0,0:14:46.68,0:14:49.35,Default,,0,0,0,,Таза.
Dialogue: 0,0:14:49.35,0:14:54.02,Default,,0,0,0,,Жоқ, мен біраз абдырап қалған шығармын.
Dialogue: 0,0:14:54.02,0:14:57.53,Default,,0,0,0,,⸨Мен бұл жолы өз рөлімді орындадым.
Dialogue: 0,0:14:57.53,0:14:59.86,Default,,0,0,0,,Қазір жалғыз болған дұрыс емес пе?
Dialogue: 0,0:14:59.86,0:15:02.63,Default,,0,0,0,,Иә! ⸩
Dialogue: 0,0:15:02.63,0:15:05.80,Default,,0,0,0,,《Ойланып, саған жіберемін➨
Dialogue: 0,0:15:05.80,0:15:08.47,Default,,0,0,0,,Менің ойымша, бұл оның емделіп жатқан сахнасы болуы мүмкін➨
Dialogue: 0,0:15:08.47,0:15:11.14,Default,,0,0,0,,Неге, Мизушино, сен иығыңды айқастырасың?
Dialogue: 0,0:15:11.14,0:15:13.14,Default,,0,0,0,,Мен қызғанамын➨
Dialogue: 0,0:15:13.14,0:15:15.14,Default,,0,0,0,,Қанша уақыт болса да біртүрлі➨
Dialogue: 0,0:15:15.14,0:15:18.81,Default,,0,0,0,,Қыз режимінен шыға алмайтын сияқтысың.
Dialogue: 0,0:15:18.81,0:15:23.65,Default,,0,0,0,,Қалай айтайын, кешегі Юдзуки Нанасе➨
Dialogue: 0,0:15:23.65,0:15:26.65,Default,,0,0,0,,Ол бір жерге кеткен сияқты》
Dialogue: 0,0:15:26.65,0:15:29.86,Default,,0,0,0,,Юдзуки мен оны саған жіберемін. Ах...
Dialogue: 0,0:15:31.99,0:15:34.16,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:34.16,0:15:37.33,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:37.33,0:15:41.00,Default,,0,0,0,,Бұл кім? Қараңызшы, өткен көктемде➨
Dialogue: 0,0:15:41.00,0:15:45.51,Default,,0,0,0,,Мен жүктерімді мектеп қақпасынан алып кеттім.
Dialogue: 0,0:15:45.51,0:15:49.01,Default,,0,0,0,,Кешіріңіз, есіме енді...
Dialogue: 0,0:15:49.01,0:15:52.61,Default,,0,0,0,,Бұл Томоя Нарузе! Сіз мұны Читозадан бері естіп жатырсыз, солай ма?
Dialogue: 0,0:15:55.18,0:16:00.12,Default,,0,0,0,,Мен бәрін түсінемін. Бұрын Янагишитада, қазір Хитоседе➨
Dialogue: 0,0:16:00.12,0:16:03.62,Default,,0,0,0,,Сіз бұлай суретке түсуге қарсы тұра алмайсыз, солай ма?
Dialogue: 0,0:16:03.62,0:16:05.96,Default,,0,0,0,,Бірақ мен қазір өзімді қауіпсіз сезінемін.
Dialogue: 0,0:16:05.96,0:16:10.47,Default,,0,0,0,,Енді сенде менен көмек сұрауға сылтау бар.
Dialogue: 0,0:16:10.47,0:16:15.97,Default,,0,0,0,,《Сәку аңдыушының кім екенін әу бастан білгеніне сенімдімін.
Dialogue: 0,0:16:15.97,0:16:19.97,Default,,0,0,0,,Сіз маған мүлде хабарлаған жоқсыз ба деп ойлаймын➨
Dialogue: 0,0:16:19.97,0:16:23.14,Default,,0,0,0,,Жолыңыз болса, дұрыс бағытта келе жатырсыз➨
Dialogue: 0,0:16:23.14,0:16:25.65,Default,,0,0,0,,Менің ойымша, ол маған жол көрсетуге тырысты.
Dialogue: 0,0:16:25.65,0:16:27.98,Default,,0,0,0,,Бұл ыңғайсыз өмір салты.
Dialogue: 0,0:16:27.98,0:16:30.15,Default,,0,0,0,,Кел, Юдзуки!
Dialogue: 0,0:16:30.15,0:16:33.15,Default,,0,0,0,,Күрсіну…. Сіз білесіз➨
Dialogue: 0,0:16:33.15,0:16:35.82,Default,,0,0,0,,Ол фото мен болсам➨
Dialogue: 0,0:16:35.82,0:16:38.66,Default,,0,0,0,,Саку мені сұраса, мен оны кешірер едім.
Dialogue: 0,0:16:38.66,0:16:41.16,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:16:41.16,0:16:43.83,Default,,0,0,0,,Юдзуки ондай қыз емес.
Dialogue: 0,0:16:43.83,0:16:46.00,Default,,0,0,0,,Эй, сен білесің бе? иә?
Dialogue: 0,0:16:46.00,0:16:52.01,Default,,0,0,0,,Қыздар күндерінде менің де көңіл-күйім нашар болады, өйткені менің ашық қызыл қаным барлық жерде ағып жатыр➨
Dialogue: 0,0:16:52.01,0:16:57.68,Default,,0,0,0,,Қызыққан балаға қуанған күндері мен жасырын мастурбация жасаймын.
Dialogue: 0,0:16:57.68,0:17:01.78,Default,,0,0,0,,(Хагакуре) Мені де тіке қарап тұрды — біраз ұят болды.
Dialogue: 0,0:17:01.78,0:17:04.79,Default,,0,0,0,,Юдзуки Нанасе➨ жақынырақ болғыңыз келсе
Dialogue: 0,0:17:04.79,0:17:07.29,Default,,0,0,0,,Алдымен маған дұрыстап қара.
Dialogue: 0,0:17:07.29,0:17:10.96,Default,,0,0,0,,Уф... бұл шу!
Dialogue: 0,0:17:10.96,0:17:13.46,Default,,0,0,0,,Әлсіз қолдарыңызды қолданбаңыз➨
Dialogue: 0,0:17:13.46,0:17:16.80,Default,,0,0,0,,Қабырғаны бетпе-бет жарып көріңіз!
Dialogue: 0,0:17:16.80,0:17:20.64,Default,,0,0,0,,Уф... бұл өте қатты!
Dialogue: 0,0:17:20.64,0:17:22.80,Default,,0,0,0,,Хун. Ха!
Dialogue: 0,0:17:22.80,0:17:24.81,Default,,0,0,0,,《40% 40%》
Dialogue: 0,0:17:27.81,0:17:30.31,Default,,0,0,0,,Менің есімде, Нарусе Томоя-кун.
Dialogue: 0,0:17:30.31,0:17:33.48,Default,,0,0,0,,Менің сол адамға деген сағынышыма не себеп болды➨
Dialogue: 0,0:17:33.48,0:17:37.32,Default,,0,0,0,,Мәңгілік жүрегіме ойып жазамын.
Dialogue: 0,0:17:37.32,0:17:40.52,Default,,0,0,0,,Осылай аяқталды ма? Ха!
Dialogue: 0,0:17:42.66,0:17:45.33,Default,,0,0,0,,Жауаптарды тексеру керек пе?
Dialogue: 0,0:17:45.33,0:17:48.83,Default,,0,0,0,,Хитоза! ? Мен қашаннан бері күмәндандым?
Dialogue: 0,0:17:48.83,0:17:50.83,Default,,0,0,0,,Басынан бастап.
Dialogue: 0,0:17:50.83,0:17:54.34,Default,,0,0,0,,《Саку: Фестивальде бұл туралы Яндан басқа тек Томоя білуі керек➨
Dialogue: 0,0:17:54.34,0:17:59.01,Default,,0,0,0,,Ян жоғары жігіттерінің пайда болуымен менің күмәнім дерлік расталды.
Dialogue: 0,0:17:59.01,0:18:03.28,Default,,0,0,0,,Менің түсінбегенім, оларға Ян орта мектебінің жігіттері қорқытып жатыр екен➨
Dialogue: 0,0:18:03.28,0:18:06.45,Default,,0,0,0,,Бұны қоздырған Томоя болса керек.
Dialogue: 0,0:18:06.45,0:18:09.12,Default,,0,0,0,,Мен достарымның көмегімен жоспар құрдым.
Dialogue: 0,0:18:09.12,0:18:12.45,Default,,0,0,0,,Алдын ала Юдзуки Янагишита➨ түсірген сексуалдық суретке түсті
Dialogue: 0,0:18:12.45,0:18:16.12,Default,,0,0,0,,Үйімде болған күннің эпизодында мен оған мені қорқытқанын айттым➨
Dialogue: 0,0:18:16.12,0:18:19.63,Default,,0,0,0,,Адамдарды мен де осындай суретке түсірдім деп адастыру.
Dialogue: 0,0:18:19.63,0:18:22.80,Default,,0,0,0,,Томоя мұны білгенде қалай әрекет ететінін қараңыз➨
Dialogue: 0,0:18:22.80,0:18:25.30,Default,,0,0,0,,Мен жауапты автоматты түрде білемін》
Dialogue: 0,0:18:28.64,0:18:31.47,Default,,0,0,0,,Айтпақшы, ол бейне әйел киінген Кента.
Dialogue: 0,0:18:31.47,0:18:34.81,Default,,0,0,0,,Хмм... Ах...! (Саку) Мен де фото жәшіктерге, үстелдерге саламын➨
Dialogue: 0,0:18:34.81,0:18:37.31,Default,,0,0,0,,Ян Гаоны арандатқан сен болдың ғой?
Dialogue: 0,0:18:37.31,0:18:39.65,Default,,0,0,0,,Кух…. (Саку) Сосын➨
Dialogue: 0,0:18:39.65,0:18:43.85,Default,,0,0,0,,Бұл жігіт Юдзукидің көлігінің магнитофонында қалды.
Dialogue: 0,0:18:45.99,0:18:50.32,Default,,0,0,0,,Осы уақыт бойы мені алдадың ба? Күрсіну….
Dialogue: 0,0:18:50.32,0:18:52.83,Default,,0,0,0,,Мен сізге оңай төте жолдарды қолданбаңыз дедім.
Dialogue: 0,0:18:52.83,0:18:55.16,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:18:55.16,0:18:58.17,Default,,0,0,0,,Мұны мен де айтуым керек еді.
Dialogue: 0,0:18:58.17,0:19:02.77,Default,,0,0,0,,Бар болғаны батылдықты жинап, онымен қалыпты сөйлесу болды.
Dialogue: 0,0:19:02.77,0:19:05.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.11,0:19:15.95,Default,,0,0,0,,♬～
Dialogue: 0,0:19:15.95,0:19:18.62,Default,,0,0,0,,Сәлем, Томоя.
Dialogue: 0,0:19:18.62,0:19:23.12,Default,,0,0,0,,Қараңғы бөлмеде жылап, әйелдік өлеңдер жазу➨
Dialogue: 0,0:19:23.12,0:19:27.13,Default,,0,0,0,,Жалықсаңыз, гитара сатып алып, ән жазыңыз.
Dialogue: 0,0:19:27.13,0:19:30.13,Default,,0,0,0,,Мүмкін болса, әдемі махаббат әнінен гөрі➨
Dialogue: 0,0:19:30.13,0:19:34.14,Default,,0,0,0,,Мен ақсақ және ыстық панк-рокты тыңдағым келеді.
Dialogue: 0,0:19:34.14,0:19:38.54,Default,,0,0,0,,Осы жолы басқа адаммен дұрыс бетпе-бет келе алуым үшін.
Dialogue: 0,0:19:52.65,0:19:56.32,Default,,0,0,0,,《Саку: Мен сенің жалған ғашығың болғаныма екі апта болды.
Dialogue: 0,0:19:56.32,0:20:01.50,Default,,0,0,0,,Оның мен білмей тұрып үйреніп қалған бет-бейнесі анық, анық көрінді.
Dialogue: 0,0:20:01.50,0:20:04.33,Default,,0,0,0,,Біраз уақыттан кейін жоғалады➨
Dialogue: 0,0:20:04.33,0:20:07.33,Default,,0,0,0,,Мен өзімді қол жетімді жерде сезіне алмаймын➨
Dialogue: 0,0:20:07.33,0:20:09.54,Default,,0,0,0,,Мен оны байлап алғым келіп тұрғандай...》
Dialogue: 0,0:20:16.51,0:20:23.18,Default,,0,0,0,,《Бұл эмоцияға ең соңында атау беру керек шығар.》
Dialogue: 0,0:20:23.18,0:20:25.69,Default,,0,0,0,,Онда мен осында қаламын.
Dialogue: 0,0:20:27.86,0:20:31.86,Default,,0,0,0,,Әлі алда біраз...
Dialogue: 0,0:20:31.86,0:20:36.16,Default,,0,0,0,,Не, ұйықтар алдында бесік жырын айтайын ба?
Dialogue: 0,0:20:41.87,0:20:44.07,Default,,0,0,0,,Мм. 📱
Dialogue: 0,0:20:59.72,0:21:04.16,Default,,0,0,0,,《Жазғы жаңбырдай кенет болды➨
Dialogue: 0,0:21:04.16,0:21:07.83,Default,,0,0,0,,Бұл өткінші поцелу болды》
Dialogue: 0,0:21:07.83,0:21:12.83,Default,,0,0,0,,Егер сіз маған сыйлық беруді жоспарласаңыз, сіздің бағалауларыңыз шамамен 3 сантиметрге қате емес пе?
Dialogue: 0,0:21:15.50,0:21:19.01,Default,,0,0,0,,Саку туған күніңмен.
Dialogue: 0,0:21:19.01,0:21:22.01,Default,,0,0,0,,А... А...
Dialogue: 0,0:21:22.01,0:21:25.11,Default,,0,0,0,,Бұл аздап... жасырын.
Dialogue: 0,0:21:30.18,0:21:33.59,Default,,0,0,0,,Қайырлы түн, Хитоза.
Dialogue: 0,0:21:37.86,0:21:41.66,Default,,0,0,0,,Қайырлы түн, Нанасе.
Dialogue: 0,0:21:46.03,0:21:48.37,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:48.37,0:21:52.37,Default,,0,0,0,,《17 жас. Бұл менің өмірімде 18-ші рет➨
Dialogue: 0,0:21:52.37,0:21:55.54,Default,,0,0,0,,Бүгінгі күнге ерекше кіреберіс➨
Dialogue: 0,0:21:55.54,0:21:59.88,Default,,0,0,0,,Мен тұрдым.
Dialogue: 0,0:21:59.88,0:22:04.32,Default,,0,0,0,,Қадам басқан да, бара алмаған да.
Dialogue: 0,0:22:04.32,0:22:07.49,Default,,0,0,0,,Жарықты тыңдау кезінде➨
Dialogue: 0,0:22:07.49,0:22:12.49,Default,,0,0,0,,Бейбіт айға қарап біраз тұрдым.
Dialogue: 0,0:22:15.83,0:22:19.50,Default,,0,0,0,,《Юзуки: Бұл шынайы махаббат хикаясы.
Dialogue: 0,0:22:19.50,0:22:23.67,Default,,0,0,0,,Адам қандай сәтте біреуге ғашық болады?
Dialogue: 0,0:22:23.67,0:22:26.34,Default,,0,0,0,,Көп жағдайда бастапқыда ➨
Dialogue: 0,0:22:26.34,0:22:30.68,Default,,0,0,0,,Менің ойымша, бұл кішкентай ғана аңсау.
Dialogue: 0,0:22:30.68,0:22:35.35,Default,,0,0,0,,Бірақ алға жылжу үшін бізге себеп керек➨
Dialogue: 0,0:22:35.35,0:22:40.19,Default,,0,0,0,,Сол сезімді махаббат деп атаймыз.
Dialogue: 0,0:22:40.19,0:22:43.52,Default,,0,0,0,,Біреуді жақсы көремін деп айқайлау➨
Dialogue: 0,0:22:43.52,0:22:46.69,Default,,0,0,0,,Маған махаббат деген индульгенция керек.
Dialogue: 0,0:22:46.69,0:22:50.70,Default,,0,0,0,,Бейбіт түнгі аспанда жарқыраған ай➨
Dialogue: 0,0:22:50.70,0:22:53.53,Default,,0,0,0,,Қарап тұрсаңыз болды➨
Dialogue: 0,0:22:53.53,0:22:56.70,Default,,0,0,0,,Қанша уақыт өтсе де, ол ешқашан келмейді.
Dialogue: 0,0:22:56.70,0:23:01.98,Default,,0,0,0,,Мен саған өзімшіл сағынышымды таңу үшін келген жоқпын.
Dialogue: 0,0:23:01.98,0:23:05.98,Default,,0,0,0,,Тәтті-қышқыл сезімге бой алдыру үшін емес.
Dialogue: 0,0:23:05.98,0:23:11.32,Default,,0,0,0,,Әсіресе, нәтижесінде сіз үшін маңызды біреуге зиян тигізгіңіз келсе➨
Dialogue: 0,0:23:11.32,0:23:13.99,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:23:13.99,0:23:16.16,Default,,0,0,0,,Дүниеде сөзбен жеткізуіміз керек➨
Dialogue: 0,0:23:16.16,0:23:19.33,Default,,0,0,0,,Жүгіре алмай жүргендер бар.
Dialogue: 0,0:23:19.33,0:23:23.83,Default,,0,0,0,,Сол айды ешкімнен бұрын атып түсіру➨
Dialogue: 0,0:23:23.83,0:23:27.84,Default,,0,0,0,,Өзіңізге тапанша ұстаудың себебін құрыңыз.
Dialogue: 0,0:23:27.84,0:23:31.67,Default,,0,0,0,,Сондықтан мен шынымен де тоқтай алмайтындай сезінемін➨
Dialogue: 0,0:23:31.67,0:23:35.01,Default,,0,0,0,,Мені бірден махаббат деп атаңыз.
Dialogue: 0,0:23:35.01,0:23:39.51,Default,,0,0,0,,Міне осыдан басталды➨
Dialogue: 0,0:23:39.51,0:23:43.62,Default,,0,0,0,,Бұл нағыз махаббат хикаясы》
Dialogue: 0,0:23:45.12,0:23:51.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory