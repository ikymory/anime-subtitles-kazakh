Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.24,0:00:07.24,Default,,0,0,0,,♪~
Dialogue: 0,0:01:15.02,0:01:20.03,Default,,0,0,0,,~♪
Dialogue: 0,0:01:25.32,0:01:27.41,Default,,0,0,0,,Томойо-чан, аяғың жақсы ма?
Dialogue: 0,0:01:27.53,0:01:29.49,Default,,0,0,0,,Бұл жай ғана лотерея болды.
Dialogue: 0,0:01:29.62,0:01:30.70,Default,,0,0,0,,Ауырмайды ма?
Dialogue: 0,0:01:30.83,0:01:32.08,Default,,0,0,0,,Иә, қазір
Dialogue: 0,0:01:32.20,0:01:34.91,Default,,0,0,0,,Бірақ мұғалімім марафонға қатысудың өзі екенін айтты
Dialogue: 0,0:01:35.04,0:01:37.42,Default,,0,0,0,,Маған тоқтау бұйырды.
Dialogue: 0,0:01:37.54,0:01:38.79,Default,,0,0,0,,…бізді ажырата алмайды!
Dialogue: 0,0:01:38.92,0:01:39.75,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.63,0:01:44.38,Default,,0,0,0,,Бірақ қазір Сакура-чанның жүгіріп келе жатқанын көруге болады...
Dialogue: 0,0:01:44.51,0:01:48.01,Default,,0,0,0,,Бейнеге қалағаныңызша түсіре аласыз.
Dialogue: 0,0:01:48.35,0:01:50.01,Default,,0,0,0,,Соңғы айналым!
Dialogue: 0,0:01:50.43,0:01:52.18,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:02:01.65,0:02:04.19,Default,,0,0,0,,Сакура-чан, сен өте жылдамсың.
Dialogue: 0,0:02:04.61,0:02:08.66,Default,,0,0,0,,Ертеңгі марафон турнирінің ертеңіне Сакура-чан биыл тағы да жеңіске жетті.
Dialogue: 0,0:02:08.78,0:02:10.08,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:02:10.20,0:02:11.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:13.04,0:02:17.21,Default,,0,0,0,,Биылғы марафон мен және Сяоран арасындағы бір-екі мәре.
Dialogue: 0,0:02:17.83,0:02:22.46,Default,,0,0,0,,Гонконгтағы мектепте Сяоран екеуміз әрқашан жоғарыда болатынбыз.
Dialogue: 0,0:02:28.22,0:02:30.18,Default,,0,0,0,,(Сакураның ауыр тыныс алуы)
Dialogue: 0,0:02:30.30,0:02:36.23,Default,,0,0,0,,(Сакура мен Сяоранның ауыр тыныс алуы)
Dialogue: 0,0:02:37.06,0:02:37.89,Default,,0,0,0,,(секундомерді басқан дыбыс)
Dialogue: 0,0:02:39.40,0:02:41.90,Default,,0,0,0,,Менің сыныбымнан 1 және 2 орын алатын сияқтымыз.
Dialogue: 0,0:02:42.15,0:02:44.82,Default,,0,0,0,,Ха ха ха, сен жылдамсың, Ли.
Dialogue: 0,0:02:44.94,0:02:46.95,Default,,0,0,0,,Сяоран! (Сяоран) Уау!
Dialogue: 0,0:02:47.07,0:02:47.90,Default,,0,0,0,,Ичиго Сузу…
Dialogue: 0,0:02:48.28,0:02:51.91,Default,,0,0,0,,Марафон мен және Сяоран арасындағы жеке жекпе-жек болатын сияқты.
Dialogue: 0,0:02:52.24,0:02:54.16,Default,,0,0,0,,Ичиго Сузу-чан марафондарда жақсы.
Dialogue: 0,0:02:54.45,0:02:55.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:56.20,0:02:59.87,Default,,0,0,0,,Кімнен сұрап тұрсың, сен жақсысың ба?
Dialogue: 0,0:03:00.00,0:03:01.92,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:03:02.04,0:03:05.67,Default,,0,0,0,,Сен менің артымнан жылап жүгіресің.
Dialogue: 0,0:03:05.88,0:03:07.30,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:03:07.59,0:03:08.80,Default,,0,0,0,,Көңілсіз жылау
Dialogue: 0,0:03:08.93,0:03:11.80,Default,,0,0,0,,Бірақ Ичиго Сузу ұзақ қашықтыққа жүгірді ме?
Dialogue: 0,0:03:12.64,0:03:13.47,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:03:14.81,0:03:20.31,Default,,0,0,0,,Эй Эй Хмф Ух Хэ Хэ Хе...
Dialogue: 0,0:03:20.81,0:03:22.44,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:03:22.94,0:03:25.86,Default,,0,0,0,,Алдыңғы топ сияқты, жолды 5 айналым
Dialogue: 0,0:03:25.98,0:03:28.53,Default,,0,0,0,,Жүгіру кезінде өзіңіздің қарқыныңызды ойлаңыз.
Dialogue: 0,0:03:28.65,0:03:30.20,Default,,0,0,0,,Yes
Dialogue: 0,0:03:30.32,0:03:32.32,Default,,0,0,0,,Енді орналасқан жері туралы.
Dialogue: 0,0:03:32.99,0:03:34.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:36.08,0:03:37.41,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:03:37.66,0:03:39.50,Default,,0,0,0,,Тез!
Dialogue: 0,0:03:40.00,0:03:41.33,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:03:41.88,0:03:45.13,Default,,0,0,0,,Менің жүгіргенімді көріп таң қалдың.
Dialogue: 0,0:03:49.63,0:03:50.47,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,0:04:12.41,0:04:14.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:28.42,0:04:29.34,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:04:29.46,0:04:30.55,Default,,0,0,0,,Ичиго Сузу-чан!
Dialogue: 0,0:04:30.92,0:04:35.05,Default,,0,0,0,,А... енді жоқ~
Dialogue: 0,0:04:35.64,0:04:37.81,Default,,0,0,0,,Ахххххх
Dialogue: 0,0:04:37.93,0:04:39.81,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:04:40.23,0:04:42.39,Default,,0,0,0,,«Мен, Демегава, ақыры құдайдай Кираны ұстауға тырысқан зұлым ұйымның жасырын базасын тауып алдым,
Dialogue: 0,0:04:44.31,0:04:46.19,Default,,0,0,0,,Фу
Dialogue: 0,0:04:47.23,0:04:49.03,Default,,0,0,0,,Ичиго Сузу-чан, қазір жақсысың ба?
Dialogue: 0,0:04:49.15,0:04:51.32,Default,,0,0,0,,Бүгін өзімді жақсы сезінбедім.
Dialogue: 0,0:04:52.86,0:04:53.91,Default,,0,0,0,,Мен осы уақытқа дейін
Dialogue: 0,0:04:54.03,0:04:57.28,Default,,0,0,0,,Мен жақша ойынында Сяораннан басқа ешкімге ұтылған емеспін!
Dialogue: 0,0:04:57.41,0:05:00.29,Default,,0,0,0,,Какекко 100 метрге дейін ғана жүгірді, солай ма?
Dialogue: 0,0:05:00.41,0:05:01.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.37,0:05:04.83,Default,,0,0,0,,Тіпті 100 метрге жүгіру мен марафон да басқаша.
Dialogue: 0,0:05:04.96,0:05:07.13,Default,,0,0,0,,Неліктен? Бұл бірдей жақша емес
Dialogue: 0,0:05:07.84,0:05:09.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.26,0:05:14.88,Default,,0,0,0,,Мен қалай Сакура-чан мен Ямазаки-кун сияқты бола аламын?
Dialogue: 0,0:05:15.01,0:05:17.05,Default,,0,0,0,,Мен тезірек бола аламын ба деп ойлаймын?
Dialogue: 0,0:05:17.18,0:05:18.93,Default,,0,0,0,,Өйткені, бұл жаттығу.
Dialogue: 0,0:05:19.06,0:05:20.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:20.68,0:05:24.19,Default,,0,0,0,,Марафон жаттығулары биіктікте тиімді.
Dialogue: 0,0:05:24.31,0:05:26.44,Default,,0,0,0,,Биік тау биік тау ма?
Dialogue: 0,0:05:26.56,0:05:28.36,Default,,0,0,0,,Иә, марафоншылар
Dialogue: 0,0:05:28.48,0:05:31.03,Default,,0,0,0,,Фудзи тауы сияқты биік тауда жаттығу.
Dialogue: 0,0:05:31.36,0:05:32.19,Default,,0,0,0,,Иә!?
Dialogue: 0,0:05:32.32,0:05:34.40,Default,,0,0,0,,Дүние жүзіндегі ең биік тау?
Dialogue: 0,0:05:34.53,0:05:37.99,Default,,0,0,0,,Жаттығудағы марафоншы тауға бірінші болып шықты.
Dialogue: 0,0:05:38.12,0:05:38.95,Default,,0,0,0,,Айқай~
Dialogue: 0,0:05:38.12,0:05:38.95,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:05:38.95,0:05:39.08,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:05:39.08,0:05:40.33,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:05:39.08,0:05:40.33,Default,,0,0,0,,Томоеда қаласында мұндай биік таулар жоқ.
Dialogue: 0,0:05:40.33,0:05:42.20,Default,,0,0,0,,Томоеда қаласында мұндай биік таулар жоқ.
Dialogue: 0,0:05:42.20,0:05:43.04,Default,,0,0,0,,Томоеда қаласында мұндай биік таулар жоқ.
Dialogue: 0,0:05:42.20,0:05:43.04,Default,,0,0,0,,Иә
Dialogue: 0,0:05:43.58,0:05:47.29,Default,,0,0,0,,Ең жақсы марафоншылар да үздік альпинистер.
Dialogue: 0,0:05:47.42,0:05:49.67,Default,,0,0,0,,Ямадзаки-кунның өтірігі қайтадан басталды
Dialogue: 0,0:05:50.13,0:05:51.42,Default,,0,0,0,,Не? Бұл өтірік пе? (Ичиго Сузу) Иә?
Dialogue: 0,0:05:51.88,0:05:53.46,Default,,0,0,0,,Бірақ жаттығу маңызды.
Dialogue: 0,0:05:53.59,0:05:54.92,Default,,0,0,0,,Иә, мен бар күшімді саламын.
Dialogue: 0,0:05:58.14,0:05:59.93,Default,,0,0,0,,Тренинг...
Dialogue: 0,0:06:00.81,0:06:02.43,Default,,0,0,0,,Тамақ бергеніңізге рахмет~
Dialogue: 0,0:06:04.98,0:06:06.94,Default,,0,0,0,,А, енді ойлап қарасам, Сакура-сан
Dialogue: 0,0:06:07.06,0:06:09.69,Default,,0,0,0,,Бұл жұма марафон болды, солай ма?
Dialogue: 0,0:06:09.81,0:06:10.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:10.86,0:06:12.48,Default,,0,0,0,,Сіз өткен жылы жеңдіңіз, солай ма?
Dialogue: 0,0:06:12.61,0:06:13.44,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:13.57,0:06:15.36,Default,,0,0,0,,Сіздің оқу жылыңыз нешеде басталады?
Dialogue: 0,0:06:15.49,0:06:17.45,Default,,0,0,0,,Түскі үзілістен кейін.
Dialogue: 0,0:06:18.11,0:06:20.41,Default,,0,0,0,,Түсіндім, мен де қарайтын шығармын.
Dialogue: 0,0:06:20.53,0:06:21.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.49,0:06:23.95,Default,,0,0,0,,Сол күні сабақ тек таңертең ғана болады.
Dialogue: 0,0:06:24.41,0:06:26.08,Default,,0,0,0,,Оны Юкито да көре ме?
Dialogue: 0,0:06:26.21,0:06:28.88,Default,,0,0,0,,Біз бір сыныпта оқимыз, сондықтан оның да сабағы жоқ.
Dialogue: 0,0:06:29.00,0:06:30.34,Default,,0,0,0,,Қайда жүгіріп бара жатырсың?
Dialogue: 0,0:06:30.46,0:06:32.96,Default,,0,0,0,,Ал, алдымен жерді айналып өт...
Dialogue: 0,0:06:33.67,0:06:35.42,Default,,0,0,0,,Пингвиндер саябағына кіру
Dialogue: 0,0:06:35.55,0:06:40.43,Default,,0,0,0,,Саябақтан шығыңыз, бұрылыс нүктесі шие гүлдерінің қатарында болады.
Dialogue: 0,0:06:40.55,0:06:42.97,Default,,0,0,0,,Содан кейін кітапхананың жанынан өтіп бара жатып...
Dialogue: 0,0:06:43.47,0:06:45.85,Default,,0,0,0,,Саябақтан қайтадан шығып, мектепке қайта оралыңыз.
Dialogue: 0,0:06:45.98,0:06:47.10,Default,,0,0,0,,Олар өте аз.
Dialogue: 0,0:06:47.23,0:06:49.23,Default,,0,0,0,,Бұл екі жаққа 2,5 км.
Dialogue: 0,0:06:49.35,0:06:51.23,Default,,0,0,0,,Бірақ мен жүгіргенді жақсы көремін
Dialogue: 0,0:06:51.65,0:06:55.23,Default,,0,0,0,,Аа, Сакура күнде жаттығады.
Dialogue: 0,0:06:55.53,0:06:56.44,Default,,0,0,0,,Айқай?
Dialogue: 0,0:06:56.57,0:06:59.66,Default,,0,0,0,,Күнде таңертең мектепке мүмкіндігінше жылдам жүгіріңіз.
Dialogue: 0,0:06:59.78,0:07:01.24,Default,,0,0,0,,«Мен таңертең артық ұйықтадым».
Dialogue: 0,0:07:02.78,0:07:06.62,Default,,0,0,0,,Юки де менің велосипедімді қуып жеткеніне таң қалды.
Dialogue: 0,0:07:07.04,0:07:09.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:12.34,0:07:13.92,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:07:15.30,0:07:16.26,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:07:16.38,0:07:18.05,Default,,0,0,0,,Марафонға дайындық
Dialogue: 0,0:07:18.17,0:07:19.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:19.38,0:07:22.89,Default,,0,0,0,,Неліктен? Сяоран, менімен бірге мақсатқа жеткің келмей ме?
Dialogue: 0,0:07:23.93,0:07:27.85,Default,,0,0,0,,Құрметті Ичиго Сузу, тамақ ішкеннен кейін бірден қатты жаттығулар жасамағаныңыз дұрыс...
Dialogue: 0,0:07:27.98,0:07:28.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.94,0:07:30.40,Default,,0,0,0,,Менің ішім ауырады.
Dialogue: 0,0:07:31.56,0:07:33.40,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:34.02,0:07:36.65,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:38.03,0:07:39.40,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:07:39.82,0:07:42.16,Default,,0,0,0,,Сяоранның ақымақ!
Dialogue: 0,0:07:43.74,0:07:44.91,Default,,0,0,0,,
Dialogue: 0,0:07:51.00,0:07:54.00,Default,,0,0,0,,Уф, менің ішім ауырып кетті~
Dialogue: 0,0:07:54.13,0:07:56.17,Default,,0,0,0,,Уф
Dialogue: 0,0:07:54.13,0:07:56.17,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:56.30,0:07:57.13,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:00.01,0:08:02.39,Default,,0,0,0,,Денеңіз суып кетеді.
Dialogue: 0,0:08:03.34,0:08:04.47,Default,,0,0,0,,Тыныс алу әдісі?
Dialogue: 0,0:08:04.60,0:08:07.81,Default,,0,0,0,,Иә, ырғақты
Dialogue: 0,0:08:07.93,0:08:11.14,Default,,0,0,0,,Сондай-ақ, менің ойымша, сәл баяу жүгірген дұрыс.
Dialogue: 0,0:08:11.27,0:08:12.19,Default,,0,0,0,,Баяу?
Dialogue: 0,0:08:14.23,0:08:17.15,Default,,0,0,0,,Мақсатқа жеткенше біраз күш қалдырыңыз
Dialogue: 0,0:08:17.28,0:08:21.07,Default,,0,0,0,,Мақсатыңызды көргенде, сізде қалған барлық күшті бірден пайдаланыңыз.
Dialogue: 0,0:08:21.20,0:08:22.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:24.16,0:08:26.24,Default,,0,0,0,,Рахмет, мен жасап көремін.
Dialogue: 0,0:08:26.37,0:08:28.20,Default,,0,0,0,,Маған алғыс айтқыңыз келсе, Сяоран-самаға барыңыз.
Dialogue: 0,0:08:29.75,0:08:30.83,Default,,0,0,0,,Сяоран-сама
Dialogue: 0,0:08:30.96,0:08:35.42,Default,,0,0,0,,Мен Ичиго Сузу-саманың маған ұзақ қашықтыққа жүгіруді үйреткенін қалаймын.
Dialogue: 0,0:08:37.21,0:08:38.21,Default,,0,0,0,,Сяоран...
Dialogue: 0,0:08:38.63,0:08:43.63,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо...
Dialogue: 0,0:08:46.10,0:08:48.10,Default,,0,0,0,,Менің ойымша, бұл жұмыс істейді.
Dialogue: 0,0:08:50.27,0:08:53.56,Default,,0,0,0,,Үздік 4 курс студенттері келді.
Dialogue: 0,0:08:53.69,0:08:58.61,Default,,0,0,0,,Үздік екі топ Ли Сяоран мен Ли Чилинг.
Dialogue: 0,0:08:59.57,0:09:00.82,Default,,0,0,0,,Сяоран...
Dialogue: 0,0:09:00.94,0:09:02.36,Default,,0,0,0,,Ичиго Сузу…
Dialogue: 0,0:09:13.71,0:09:17.04,Default,,0,0,0,,Сяоран-кун мен Ичиго-сан бір-екіден достық мәреге жетті!
Dialogue: 0,0:09:17.17,0:09:20.34,Default,,0,0,0,,Ухуху ахахха...
Dialogue: 0,0:09:41.11,0:09:48.07,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:09:53.87,0:09:57.25,Default,,0,0,0,,(Сакура және басқалар сөйлейді)
Dialogue: 0,0:09:57.38,0:09:59.34,Default,,0,0,0,,Киномото мырза, солай ма?
Dialogue: 0,0:09:59.84,0:10:02.80,Default,,0,0,0,,Бүгінгі мен бұрынғы адамнан басқаша.
Dialogue: 0,0:10:02.92,0:10:04.09,Default,,0,0,0,,Мен қайта туылдым!
Dialogue: 0,0:10:04.84,0:10:07.34,Default,,0,0,0,,Менің жылдамдығыма ілесе аласың ба?
Dialogue: 0,0:10:07.47,0:10:10.18,Default,,0,0,0,,Хохохохо…
Dialogue: 0,0:10:10.30,0:10:12.60,Default,,0,0,0,,Сіз өте сенімдісіз.
Dialogue: 0,0:10:12.72,0:10:15.23,Default,,0,0,0,,Мүмкін бұл стратегия шығар?
Dialogue: 0,0:10:15.35,0:10:16.23,Default,,0,0,0,,Сакура-чан!
Dialogue: 0,0:10:16.85,0:10:18.48,Default,,0,0,0,,Ах... Юкито-сан!
Dialogue: 0,0:10:20.23,0:10:21.52,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:10:21.65,0:10:23.11,Default,,0,0,0,,Мен сені қолымнан келгенше қолдаймын
Dialogue: 0,0:10:23.82,0:10:25.40,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:10:25.53,0:10:29.74,Default,,0,0,0,,Төртінші курс студенттері, бастапқы нүктеге көшулеріңізді сұраймыз.
Dialogue: 0,0:10:29.87,0:10:32.54,Default,,0,0,0,,Сонда біз жарты жолға жеттік.
Dialogue: 0,0:10:32.66,0:10:33.49,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:10:33.62,0:10:34.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:34.79,0:10:36.08,Default,,0,0,0,,Жолда кептеліп қалмаңыз!
Dialogue: 0,0:10:36.21,0:10:38.54,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:10:40.96,0:10:43.13,Default,,0,0,0,,Ах (Сяолань) А, ә?
Dialogue: 0,0:10:44.05,0:10:44.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.26,0:10:46.17,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:10:46.30,0:10:47.43,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:10:47.55,0:10:49.64,Default,,0,0,0,,Барайық (Юкито) Иә, онда!
Dialogue: 0,0:10:50.14,0:10:52.35,Default,,0,0,0,,Не болды? Сяоран (Сяоран) Уф
Dialogue: 0,0:10:53.47,0:10:55.77,Default,,0,0,0,,Алдымен көп нәрсені өткізіп алмаңыз
Dialogue: 0,0:10:55.89,0:10:57.64,Default,,0,0,0,,Жартылай нүктеде биіктікті жоғарылатыңыз
Dialogue: 0,0:10:58.02,0:11:00.19,Default,,0,0,0,,Иә! Бір-екі аяқта!
Dialogue: 0,0:11:00.31,0:11:01.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:08.65,0:11:10.57,Default,,0,0,0,,Жақында басталады.
Dialogue: 0,0:11:10.70,0:11:12.37,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:11:12.49,0:11:15.12,Default,,0,0,0,,Сәлем~ Бұл Томоеда қаласының үстіндегі аспан
Dialogue: 0,0:11:15.24,0:11:20.17,Default,,0,0,0,,Ашық аспан, аздап төмен температура және жеңіл жел оны марафон үшін тамаша күн етеді.
Dialogue: 0,0:11:21.96,0:11:23.17,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:11:23.46,0:11:24.42,Default,,0,0,0,,Орналасқан жері туралы!
Dialogue: 0,0:11:29.09,0:11:29.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:38.76,0:11:39.43,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:12:02.87,0:12:05.66,Default,,0,0,0,,Үстіңгі – ұл мен қыз!
Dialogue: 0,0:12:05.83,0:12:08.66,Default,,0,0,0,,Сакура, сен не істеп жатырсың! Жарайды, қалдырмаңыз!
Dialogue: 0,0:12:29.48,0:12:34.31,Default,,0,0,0,,Мен бүгін мүлдем шаршағанымды сезбеймін. Жаттығуым өз жемісін беруде.
Dialogue: 0,0:12:34.44,0:12:35.69,Default,,0,0,0,,Және-
Dialogue: 0,0:12:36.11,0:12:38.53,Default,,0,0,0,,Мен Сяоранмен біргемін.
Dialogue: 0,0:12:48.41,0:12:49.25,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:12:49.37,0:12:50.75,Default,,0,0,0,,Уақыт келді емес пе?
Dialogue: 0,0:12:58.09,0:13:00.09,Default,,0,0,0,,Бұл ең жақсы бұрыш.
Dialogue: 0,0:13:00.22,0:13:03.43,Default,,0,0,0,,Аспандағы Керо-чан Қазіргі басшы кім?
Dialogue: 0,0:13:03.64,0:13:05.89,Default,,0,0,0,,Сол бала, содан кейін кішкентай қыз.
Dialogue: 0,0:13:06.01,0:13:07.43,Default,,0,0,0,,Сакура үшінші орында.
Dialogue: 0,0:13:07.76,0:13:09.43,Default,,0,0,0,,Сакура, бар күшіңді салма!
Dialogue: 0,0:13:36.25,0:13:38.92,Default,,0,0,0,,Я, мен оны мүлдем көрмеймін.
Dialogue: 0,0:13:39.05,0:13:41.72,Default,,0,0,0,,Жоқ, саябақта күтіңіз.
Dialogue: 0,0:13:48.05,0:13:48.89,Default,,0,0,0,,Ах
Dialogue: 0,0:13:56.19,0:13:58.48,Default,,0,0,0,,Сакура-чан, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:14:01.28,0:14:02.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:09.16,0:14:11.16,Default,,0,0,0,,Сен тозақтай ұшпадың ба?
Dialogue: 0,0:14:11.29,0:14:12.66,Default,,0,0,0,,Иә, бұл жылдам қарқын болды.
Dialogue: 0,0:14:13.62,0:14:15.96,Default,,0,0,0,,Екінші таймда шаршайсың.
Dialogue: 0,0:14:18.13,0:14:21.13,Default,,0,0,0,,Сәттілік, Наоко-чан!
Dialogue: 0,0:14:32.60,0:14:34.85,Default,,0,0,0,,Жарайды, қуып шығамыз ба? (Юкито) Иә.
Dialogue: 0,0:14:40.94,0:14:41.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:47.86,0:14:53.33,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:56.04,0:14:56.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:02.96,0:15:04.46,Default,,0,0,0,,Сіз бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:15:04.59,0:15:05.42,Default,,0,0,0,,О
Dialogue: 0,0:15:05.55,0:15:06.68,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:06.80,0:15:09.39,Default,,0,0,0,,Айналмағалы көп болды.
Dialogue: 0,0:15:09.51,0:15:11.93,Default,,0,0,0,,Арғы жақтан ешкім келмейді.
Dialogue: 0,0:15:12.06,0:15:13.93,Default,,0,0,0,,Барлығының баяу екеніне сенімдімін.
Dialogue: 0,0:15:14.06,0:15:16.89,Default,,0,0,0,,Мен бір-бірімізден соншалықты алыс емеспін деп ойлаймын.
Dialogue: 0,0:15:17.64,0:15:20.52,Default,,0,0,0,,Сяоран екеуміз тым жылдам қозғаламыз.
Dialogue: 0,0:15:20.65,0:15:22.90,Default,,0,0,0,,Кейбір бонустар да бар, бірақ...
Dialogue: 0,0:15:26.78,0:15:30.20,Default,,0,0,0,,Бұл жолы менің шыңға шығатын уақытым таяп қалды.
Dialogue: 0,0:15:30.32,0:15:31.16,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:15:36.45,0:15:37.29,Default,,0,0,0,,Я...
Dialogue: 0,0:15:38.08,0:15:39.12,Default,,0,0,0,,О?
Dialogue: 0,0:15:40.92,0:15:42.04,Default,,0,0,0,,Сакура-чан және т.б
Dialogue: 0,0:15:42.17,0:15:45.01,Default,,0,0,0,,Ол менің алдымнан екі рет өтті.
Dialogue: 0,0:15:45.13,0:15:48.43,Default,,0,0,0,,Солай етсең, неге бұрылып қайтпасқа?
Dialogue: 0,0:15:48.55,0:15:52.05,Default,,0,0,0,,Иә, бірақ мен екі рет бір бағытта жүгірдім.
Dialogue: 0,0:15:52.18,0:15:53.14,Default,,0,0,0,,Сіз не істеп жатырсыз!?
Dialogue: 0,0:15:57.14,0:16:01.10,Default,,0,0,0,,Әй, бұл ағашты даңғыл осыншама ұзын болды ма?
Dialogue: 0,0:16:01.23,0:16:03.77,Default,,0,0,0,,(Наоконың ауыр тыныс алуы)
Dialogue: 0,0:16:03.90,0:16:06.32,Default,,0,0,0,,(велосипедтің жүгіру дыбысы)
Dialogue: 0,0:16:06.44,0:16:07.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.29,0:16:18.00,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:16:18.66,0:16:19.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:19.87,0:16:21.83,Default,,0,0,0,,Құлпынай қоңырауы! (Ичиго Сузу) Міне осында.
Dialogue: 0,0:16:21.96,0:16:22.88,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:23.00,0:16:24.00,Default,,0,0,0,,Сакурачан
Dialogue: 0,0:16:24.46,0:16:25.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:26.30,0:16:27.13,Default,,0,0,0,,Томойо-чан?
Dialogue: 0,0:16:27.88,0:16:29.93,Default,,0,0,0,,Иә? Неге осы жерден?
Dialogue: 0,0:16:30.05,0:16:32.14,Default,,0,0,0,,Бұлай жүгіру мүмкін емес.
Dialogue: 0,0:16:32.34,0:16:33.55,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:16:35.18,0:16:36.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:36.43,0:16:41.31,Default,,0,0,0,,Мұғалім аяғында велосипедпен келеді, оны неге апармайсың?
Dialogue: 0,0:16:41.44,0:16:42.52,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:42.65,0:16:45.48,Default,,0,0,0,,Мен Сяоранмен бір-екіге жетемін!
Dialogue: 0,0:16:45.61,0:16:46.57,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:16:46.98,0:16:49.36,Default,,0,0,0,,Иә, мен сенімен бірге күтемін.
Dialogue: 0,0:16:49.49,0:16:53.11,Default,,0,0,0,,Өкінішке орай, мұғалім кетіп қалған сияқты.
Dialogue: 0,0:16:53.24,0:16:55.83,Default,,0,0,0,,Не? Өйткені мұғалімнің велосипеді
Dialogue: 0,0:16:55.95,0:16:58.91,Default,,0,0,0,,Сіз мектепке соңғы адаммен қайтасыз, солай ма?
Dialogue: 0,0:16:59.04,0:17:01.75,Default,,0,0,0,,Иә, дәл қазір, соңғы Наоко-чан
Dialogue: 0,0:17:01.87,0:17:03.58,Default,,0,0,0,,Мен сенің ағаш жолдан кеткеніңді естідім.
Dialogue: 0,0:17:04.46,0:17:06.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:07.75,0:17:08.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:11.22,0:17:13.09,Default,,0,0,0,,Менің ойымша, бұл постер...
Dialogue: 0,0:17:13.59,0:17:14.80,Default,,0,0,0,,Қара, қара!
Dialogue: 0,0:17:14.93,0:17:19.10,Default,,0,0,0,,Мен Сакура-чан мен оның достарының бір бағытта екі рет жүгіріп келе жатқанын көрдім.
Dialogue: 0,0:17:21.27,0:17:22.44,Default,,0,0,0,,Клоу картасының жұмысы?
Dialogue: 0,0:17:22.94,0:17:25.44,Default,,0,0,0,,Мен... Клоу картасының барын сеземін.
Dialogue: 0,0:17:26.98,0:17:29.44,Default,,0,0,0,,Мен картаның барын сеземін.
Dialogue: 0,0:17:30.99,0:17:32.65,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:33.41,0:17:35.95,Default,,0,0,0,,Ол жақын жерде болуы керек.
Dialogue: 0,0:17:47.38,0:17:48.21,Default,,0,0,0,,Иә
Dialogue: 0,0:17:49.25,0:17:50.21,Default,,0,0,0,,«Цикл»?
Dialogue: 0,0:17:50.51,0:17:52.63,Default,,0,0,0,,Циклдің жұмысы
Dialogue: 0,0:17:52.76,0:17:53.93,Default,,0,0,0,,Сакура мен басқалары жүгіріп келеді.
Dialogue: 0,0:17:54.05,0:17:57.01,Default,,0,0,0,,Ағашты даңғылдарды біріктіріп, сақина түзіңіз.
Dialogue: 0,0:17:57.14,0:17:58.72,Default,,0,0,0,,Бұл карта ғой.
Dialogue: 0,0:17:58.85,0:18:00.47,Default,,0,0,0,,Бірақ мен ештеңе көрмеймін
Dialogue: 0,0:18:00.60,0:18:03.73,Default,,0,0,0,,Егер сіз циклды бұзбасаңыз, ол көрінбейді.
Dialogue: 0,0:18:03.85,0:18:05.98,Default,,0,0,0,,Иә! Сіз оны таба алмайсыз!
Dialogue: 0,0:18:06.73,0:18:08.73,Default,,0,0,0,,Көрмесең де, табудың жолы бар.
Dialogue: 0,0:18:12.03,0:18:14.11,Default,,0,0,0,,Ех! Сізде әлі де осындай кездері бар ма?
Dialogue: 0,0:18:14.24,0:18:15.07,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:15.20,0:18:16.03,Default,,0,0,0,,Сяоран күткендей!
Dialogue: 0,0:18:17.12,0:18:18.49,Default,,0,0,0,,Нефрит императорының жарлығы
Dialogue: 0,0:18:18.62,0:18:19.99,Default,,0,0,0,,Тәңірлік сия тасы төрт бағыт
Dialogue: 0,0:18:20.12,0:18:21.83,Default,,0,0,0,,Жұма, бейсенбі, сейсенбі, сенбі
Dialogue: 0,0:18:21.95,0:18:24.29,Default,,0,0,0,,Найзағай Жел Рейден Жаңа Жарлығы
Dialogue: 0,0:18:24.41,0:18:26.96,Default,,0,0,0,,Карумаро Торо Найзағай
Dialogue: 0,0:18:27.21,0:18:29.59,Default,,0,0,0,,Кенеттен Рицурё!
Dialogue: 0,0:18:31.63,0:18:32.67,Default,,0,0,0,,Керемет
Dialogue: 0,0:18:32.80,0:18:33.97,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:34.13,0:18:36.34,Default,,0,0,0,,Сізге не әсер қалдырды?
Dialogue: 0,0:18:36.97,0:18:38.05,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:18:38.35,0:18:41.81,Default,,0,0,0,,Оны іздеңіз! Жолдың бір жерінде түйіспе болуы керек.
Dialogue: 0,0:18:41.93,0:18:43.89,Default,,0,0,0,,Егер сіз оны кесіп алсаңыз, цикл пайда болады.
Dialogue: 0,0:18:44.02,0:18:44.85,Default,,0,0,0,,Буын?
Dialogue: 0,0:18:44.98,0:18:47.56,Default,,0,0,0,,Бір жерде табиғи емес нәрсе болуы керек.
Dialogue: 0,0:18:47.94,0:18:49.65,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:18:49.77,0:18:51.57,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,0:18:56.74,0:18:57.57,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:18:58.11,0:18:59.03,Default,,0,0,0,,Иә!? Ах...
Dialogue: 0,0:18:59.16,0:18:59.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:00.45,0:19:02.04,Default,,0,0,0,,Му!
Dialogue: 0,0:19:02.16,0:19:02.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.79,0:19:06.75,Default,,0,0,0,,Неліктен мұндай буын бар...
Dialogue: 0,0:19:08.96,0:19:10.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:25.77,0:19:27.31,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:19:28.23,0:19:29.06,Default,,0,0,0,,Бірақ осы бағытты лақтырсам, қашықтығы шамамен 20 метр болады.
Dialogue: 0,0:19:29.19,0:19:30.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:30.15,0:19:32.90,Default,,0,0,0,,Оны бір нәрсемен кесіңіз! Цикл пайда болған кезде
Dialogue: 0,0:19:33.02,0:19:35.44,Default,,0,0,0,,Біз қайта қосылмас бұрын мен оны бірден мөрлеймін!
Dialogue: 0,0:19:35.99,0:19:38.07,Default,,0,0,0,,Кетіп ал десең де
Dialogue: 0,0:19:39.78,0:19:40.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:47.50,0:19:49.87,Default,,0,0,0,,Қараңғылық күшін жасыратын кілт
Dialogue: 0,0:19:50.00,0:19:52.75,Default,,0,0,0,,Менің алдымда шынайы болмысыңды көрсет
Dialogue: 0,0:19:54.71,0:19:58.22,Default,,0,0,0,,Сакура келісім-шарт бойынша бұйрық береді
Dialogue: 0,0:19:58.76,0:20:00.18,Default,,0,0,0,,Пломбаны босатыңыз!
Dialogue: 0,0:20:13.52,0:20:14.94,Default,,0,0,0,,Қылыш!
Dialogue: 0,0:20:21.61,0:20:22.95,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:20:31.17,0:20:32.92,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызға оралыңыз
Dialogue: 0,0:20:33.38,0:20:36.13,Default,,0,0,0,,Клоу картасы!
Dialogue: 0,0:20:43.01,0:20:43.85,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:20:43.97,0:20:46.76,Default,,0,0,0,,Иә (Ичиго Сузу) Сяоран жылдамырақ болды!
Dialogue: 0,0:20:51.81,0:20:52.65,Default,,0,0,0,,Ах
Dialogue: 0,0:20:55.02,0:20:58.78,Default,,0,0,0,,Иә! Сяоран жылдамырақ болды!
Dialogue: 0,0:20:59.44,0:21:00.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:01.36,0:21:05.87,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:06.58,0:21:08.24,Default,,0,0,0,,Сакура-чан және басқалары, сен кешігіп қалдың.
Dialogue: 0,0:21:08.37,0:21:11.96,Default,,0,0,0,,Олар шынымен қате жолда болды ма?
Dialogue: 0,0:21:12.96,0:21:13.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:14.21,0:21:17.13,Default,,0,0,0,,Бұлай десең де, ол аяқпен жүгіре алмайсың.
Dialogue: 0,0:21:17.38,0:21:18.63,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:21:18.76,0:21:20.17,Default,,0,0,0,,Сәлем, U.A. High!
Dialogue: 0,0:21:20.30,0:21:24.09,Default,,0,0,0,,Мен сенімен боламын, сондықтан мені кейінірек келіп алып кетуге болады...
Dialogue: 0,0:21:24.22,0:21:26.55,Default,,0,0,0,,Мен де сенімен бірге күтемін.
Dialogue: 0,0:21:27.10,0:21:28.89,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:21:29.02,0:21:32.19,Default,,0,0,0,,Сяоранмен бір-екі мәре.
Dialogue: 0,0:21:32.31,0:21:33.14,Default,,0,0,0,,Ичиго Сузу…
Dialogue: 0,0:21:33.77,0:21:34.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:35.81,0:21:36.65,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:38.07,0:21:39.15,Default,,0,0,0,,Сяоран...
Dialogue: 0,0:21:39.69,0:21:42.70,Default,,0,0,0,,4-сынып Соңғы жүйрік келді.
Dialogue: 0,0:21:42.82,0:21:45.87,Default,,0,0,0,,Барлығымыз оларды жылы қол соғып қарсы алайық.
Dialogue: 0,0:21:45.99,0:21:49.41,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:59.50,0:22:00.34,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:22:01.34,0:22:02.55,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:22:05.30,0:22:06.34,Default,,0,0,0,,Фуфу
Dialogue: 0,0:22:07.97,0:22:11.06,Default,,0,0,0,,(Сяаоның ауыр тыныс алуы)
Dialogue: 0,0:22:11.18,0:22:13.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:22:13.48,0:22:14.35,Default,,0,0,0,,Сяоран
Dialogue: 0,0:22:14.48,0:22:15.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:15.44,0:22:16.73,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:22:25.86,0:22:28.49,Default,,0,0,0,,Мен бұл жолы жарақат алдым, бірақ қабілетімді көрсетсем,
Dialogue: 0,0:22:28.62,0:22:30.87,Default,,0,0,0,,Мен жеңдім! Айқай?
Dialogue: 0,0:22:30.99,0:22:34.79,Default,,0,0,0,,Клоу картасын шынымен Сяоран басып алған.
Dialogue: 0,0:22:34.91,0:22:37.58,Default,,0,0,0,,Келесі жолы жарыс болса, міндетті түрде
Dialogue: 0,0:22:37.71,0:22:41.25,Default,,0,0,0,,Мен сені жаншып, Сяоран екеумізге бір-екі ұпай беремін!
Dialogue: 0,0:22:41.55,0:22:43.01,Default,,0,0,0,,Шайқас басталғалы жатыр!
Dialogue: 0,0:22:43.34,0:22:44.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:45.01,0:22:47.76,Default,,0,0,0,,Сенің мазасыз жүзің де сүйкімді, Сакура-чан.
Dialogue: 0,0:22:48.09,0:22:50.10,Default,,0,0,0,,Мен ешқашан жеңілмеймін!
Dialogue: 0,0:22:50.22,0:22:51.06,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:51.35,0:22:56.35,Default,,0,0,0,,♪~
Dialogue: 0,0:23:53.91,0:23:58.92,Default,,0,0,0,,~♪
Dialogue: 0,0:24:08.26,0:24:10.22,Default,,0,0,0,,Коньянячива~!
Dialogue: 0,0:24:11.64,0:24:13.89,Default,,0,0,0,,Бұл жолы қыздың салтанатты киімі мен
Dialogue: 0,0:24:14.01,0:24:17.10,Default,,0,0,0,,Кішкентай қыз алдын ала салтанатты киімін алып кететін сияқты.
Dialogue: 0,0:24:17.23,0:24:20.02,Default,,0,0,0,,Ұзын жеңнің төменгі жағында қоңырау бар.
Dialogue: 0,0:24:20.14,0:24:21.60,Default,,0,0,0,,Сіз балаға сәйкессіз бе?
Dialogue: 0,0:24:21.73,0:24:24.07,Default,,0,0,0,,Кеудедегі кесте ұлдікімен бірдей.
Dialogue: 0,0:24:24.19,0:24:25.78,Default,,0,0,0,,Шалбардың сыртқы түрі қозғалуды жеңілдетеді.
Dialogue: 0,0:24:25.90,0:24:26.98,Default,,0,0,0,,Жақын шайқас та жақсы.
Dialogue: 0,0:24:27.11,0:24:30.07,Default,,0,0,0,,Жарайды, бәрі адамның қабілетіне байланысты, Чан Чан.
Dialogue: 0,0:24:30.95,0:24:34.58,Default,,0,0,0,,Бала сияқты мен оны дұрыстап таныстырдым.
Dialogue: 0,0:24:34.70,0:24:38.04,Default,,0,0,0,,Ендеше, сіз тамаша үй иесі екенсіз! Хона!
Dialogue: 0,0:24:38.66,0:24:42.75,Default,,0,0,0,,Әкем күн сайын академиялық конференцияға дайындалып, түнімен ұйықтауға мәжбүр болды.
Dialogue: 0,0:24:42.88,0:24:45.84,Default,,0,0,0,,Иә! Университетке барып соларға берейік.
Dialogue: 0,0:24:45.96,0:24:48.59,Default,,0,0,0,,Айқай! Неге бәрі ұйықтап жатыр!?
Dialogue: 0,0:24:49.51,0:24:51.22,Default,,0,0,0,,«Карткаптор Сакура»
Dialogue: 0,0:24:53.72,0:24:57.97,Default,,0,0,0,,Келесі жолы да Сакурамен бірге шығарыңыз!
Dialogue: 0,0:24:59.47,0:25:05.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory