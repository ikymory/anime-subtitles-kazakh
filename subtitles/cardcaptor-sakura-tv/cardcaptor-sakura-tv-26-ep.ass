Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.36,0:00:07.37,Default,,0,0,0,,♪~
Dialogue: 0,0:01:15.10,0:01:20.11,Default,,0,0,0,,~♪
Dialogue: 0,0:01:21.82,0:01:23.82,Default,,0,0,0,,Хо... Хой!
Dialogue: 0,0:01:24.03,0:01:26.32,Default,,0,0,0,,Бүгін түскі асқа кезекшілікте болғанымды мүлдем ұмытып кеттім!
Dialogue: 0,0:01:30.08,0:01:30.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:31.20,0:01:32.50,Default,,0,0,0,,О!
Dialogue: 0,0:01:34.50,0:01:36.33,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:01:37.42,0:01:38.25,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:01:38.71,0:01:41.00,Default,,0,0,0,,Ааа аа уау
Dialogue: 0,0:01:41.13,0:01:44.72,Default,,0,0,0,,Ууууууууууууууууууууууууу...
Dialogue: 0,0:01:45.22,0:01:46.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:51.76,0:01:52.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:56.64,0:01:57.48,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:57.85,0:02:00.48,Default,,0,0,0,,Уау... иә!
Dialogue: 0,0:02:00.90,0:02:02.40,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:02:02.53,0:02:03.49,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:02:06.28,0:02:07.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:10.41,0:02:12.04,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:02:12.62,0:02:13.75,Default,,0,0,0,,Айқай?
Dialogue: 0,0:02:37.27,0:02:38.81,Default,,0,0,0,,Жарайды, мен Сакурамен тағы кездесермін...
Dialogue: 0,0:02:38.94,0:02:41.02,Default,,0,0,0,,Мұны айтудың оңай жолы.
Dialogue: 0,0:02:41.15,0:02:42.07,Default,,0,0,0,,Иә
Dialogue: 0,0:02:42.44,0:02:44.57,Default,,0,0,0,,Ха... Қандай іс істедің?
Dialogue: 0,0:02:45.57,0:02:46.95,Default,,0,0,0,,Міне.
Dialogue: 0,0:02:47.07,0:02:49.57,Default,,0,0,0,,Ол сондай әдемі адам еді! Оххх
Dialogue: 0,0:02:49.86,0:02:51.95,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:02:51.95,0:02:52.49,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:02:51.95,0:02:52.49,Default,,0,0,0,,
Dialogue: 0,0:02:52.49,0:02:52.62,Default,,0,0,0,,
Dialogue: 0,0:02:52.62,0:02:53.20,Default,,0,0,0,,
Dialogue: 0,0:02:52.62,0:02:53.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:53.20,0:02:53.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:54.16,0:02:55.58,Default,,0,0,0,,Уа!
Dialogue: 0,0:02:56.96,0:02:58.54,Default,,0,0,0,,Әкем бұл тамақ үшін деді.
Dialogue: 0,0:02:58.87,0:03:00.08,Default,,0,0,0,,Рахмет (Момоя) Иә?
Dialogue: 0,0:03:09.38,0:03:10.84,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:14.76,0:03:15.60,Default,,0,0,0,,Я...
Dialogue: 0,0:03:16.14,0:03:19.10,Default,,0,0,0,,Ха~ Олар мені байқамаған шығар~
Dialogue: 0,0:03:19.85,0:03:21.60,Default,,0,0,0,,Үлкен аға, кішкентай кезімізден.
Dialogue: 0,0:03:21.73,0:03:24.40,Default,,0,0,0,,Себебі мен көрінбейтін нәрселерді көруге және естуге бейіммін.
Dialogue: 0,0:03:24.52,0:03:26.86,Default,,0,0,0,,Ах~ Бұл желе өте дәмді.
Dialogue: 0,0:03:26.99,0:03:29.86,Default,,0,0,0,,Ах! Маған қалдырыңыз!
Dialogue: 0,0:03:33.78,0:03:35.62,Default,,0,0,0,,Ура!
Dialogue: 0,0:03:36.16,0:03:37.62,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:03:37.95,0:03:39.12,Default,,0,0,0,,Иә ме, жоқ па?
Dialogue: 0,0:03:39.25,0:03:40.62,Default,,0,0,0,,Мен ұйықтап қалдым~
Dialogue: 0,0:03:41.71,0:03:42.67,Default,,0,0,0,,Бүгін де.
Dialogue: 0,0:03:42.79,0:03:43.63,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:44.09,0:03:45.63,Default,,0,0,0,,Қайырлы таң Сакура-сан
Dialogue: 0,0:03:46.30,0:03:47.84,Default,,0,0,0,,Қайырлы таң әке
Dialogue: 0,0:03:47.96,0:03:50.88,Default,,0,0,0,,Асықпасаң, кешігіп қаласың.
Dialogue: 0,0:03:51.01,0:03:52.26,Default,,0,0,0,,Мен келемін.
Dialogue: 0,0:03:52.39,0:03:53.80,Default,,0,0,0,,Аа, келіңізші.
Dialogue: 0,0:03:57.31,0:03:58.64,Default,,0,0,0,,Гохихоухама~
Dialogue: 0,0:03:59.02,0:04:01.10,Default,,0,0,0,,Мен барамын. (Такаши Фудзи) Жүр.
Dialogue: 0,0:04:02.77,0:04:06.69,Default,,0,0,0,,Ха ха ха ха... міне, болды!
Dialogue: 0,0:04:10.78,0:04:12.03,Default,,0,0,0,,Қайырлы таң Сакура-чан
Dialogue: 0,0:04:12.32,0:04:14.03,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:14.32,0:04:16.16,Default,,0,0,0,,Алысқа қарасаң, құлайсың.
Dialogue: 0,0:04:16.28,0:04:17.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:17.79,0:04:21.04,Default,,0,0,0,,Жағдайың жақсы болса да, құлаған жолыңда тесік болады.
Dialogue: 0,0:04:21.21,0:04:22.54,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:04:23.08,0:04:24.04,Default,,0,0,0,,Иә
Dialogue: 0,0:04:25.21,0:04:27.50,Default,,0,0,0,,Ах... хаха...
Dialogue: 0,0:04:27.63,0:04:30.51,Default,,0,0,0,,
Dialogue: 0,0:04:30.63,0:04:34.55,Default,,0,0,0,,(Сакураның ауыр тыныс алуы)
Dialogue: 0,0:04:37.06,0:04:38.06,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:04:38.43,0:04:40.14,Default,,0,0,0,,Бұл қауіпсіз, Сакура-чан.
Dialogue: 0,0:04:40.27,0:04:41.56,Default,,0,0,0,,Мұғалім, әлі жоқ.
Dialogue: 0,0:04:41.98,0:04:43.31,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:04:43.44,0:04:45.52,Default,,0,0,0,,Бұл өте жақын.
Dialogue: 0,0:04:47.07,0:04:48.69,Default,,0,0,0,,Айқай~
Dialogue: 0,0:04:50.03,0:04:52.49,Default,,0,0,0,,Бүгін барлығына жаңалығым бар.
Dialogue: 0,0:04:52.61,0:04:56.82,Default,,0,0,0,,Математика мұғалімі Цуцуми ұзақ демалысқа шығады.
Dialogue: 0,0:04:56.95,0:04:58.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:58.95,0:05:03.33,Default,,0,0,0,,Бүгіннен бастап алмастыратын мұғалім барлығына математикадан сабақ береді.
Dialogue: 0,0:05:03.46,0:05:04.29,Default,,0,0,0,,Мизуки мырза
Dialogue: 0,0:05:07.46,0:05:08.29,Default,,0,0,0,,Ах
Dialogue: 0,0:05:12.30,0:05:15.72,Default,,0,0,0,,Менің атым Кахо Мизуки. Рақмет сізге.
Dialogue: 0,0:05:20.68,0:05:22.85,Default,,0,0,0,,Бұл кешегі адам...
Dialogue: 0,0:05:23.98,0:05:25.85,Default,,0,0,0,,Ол әдемі.
Dialogue: 0,0:05:25.98,0:05:26.94,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.06,0:05:27.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:41.41,0:05:43.91,Default,,0,0,0,,Мизуки мырзаға не болды?
Dialogue: 0,0:05:44.46,0:05:46.17,Default,,0,0,0,,Сіз мұны сезбедіңіз бе?
Dialogue: 0,0:05:46.75,0:05:47.79,Default,,0,0,0,,Қый!
Dialogue: 0,0:05:47.92,0:05:49.17,Default,,0,0,0,,Әй, Сяоран!
Dialogue: 0,0:05:49.63,0:05:51.75,Default,,0,0,0,,Мен осындай жерде болдым~! (Сяоран) Ичиго Сузу...
Dialogue: 0,0:05:51.88,0:05:55.09,Default,,0,0,0,,Түскі асты бірге ішуге уәде бердің.
Dialogue: 0,0:05:55.22,0:05:57.43,Default,,0,0,0,,Біраз күте тұрыңыз, қазір маңызды нәрсе туралы сөйлесейік ...
Dialogue: 0,0:05:57.76,0:05:59.76,Default,,0,0,0,,Сөйлеудің қай түрі ауыр?
Dialogue: 0,0:05:59.89,0:06:02.10,Default,,0,0,0,,Мен Мизуки мырзаны айтып отырмын.
Dialogue: 0,0:06:02.22,0:06:05.10,Default,,0,0,0,,Не? Мен бар кезде!
Dialogue: 0,0:06:05.23,0:06:07.65,Default,,0,0,0,,Бұл сіз ойлағандай емес.
Dialogue: 0,0:06:07.77,0:06:09.19,Default,,0,0,0,,Сонда ше? Ах...
Dialogue: 0,0:06:10.19,0:06:12.57,Default,,0,0,0,,Сіз шынымен байқамадыңыз ба?
Dialogue: 0,0:06:12.69,0:06:14.19,Default,,0,0,0,,Сол мұғалімнің қатысуы
Dialogue: 0,0:06:14.36,0:06:15.70,Default,,0,0,0,,Белгі?
Dialogue: 0,0:06:17.11,0:06:20.32,Default,,0,0,0,,Оның күші көп. Сіз абай болуыңыз керек.
Dialogue: 0,0:06:20.45,0:06:22.20,Default,,0,0,0,,Бұл проблема болар еді (барлығы) Ах!
Dialogue: 0,0:06:22.79,0:06:24.20,Default,,0,0,0,,Мизуки мырза!
Dialogue: 0,0:06:24.75,0:06:26.79,Default,,0,0,0,,Сіз осыншама жақындасаңыз да...
Dialogue: 0,0:06:26.91,0:06:29.21,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:06:29.75,0:06:32.30,Default,,0,0,0,,Ли, бұл Сяоран еді, солай емес пе?
Dialogue: 0,0:06:32.42,0:06:36.13,Default,,0,0,0,,Мен сіздің жаңа математика мұғалімімін.
Dialogue: 0,0:06:36.26,0:06:39.22,Default,,0,0,0,,Ұқыпты болсаң, жақсы оқи алмасаң, қиналып қаласың.
Dialogue: 0,0:06:40.14,0:06:42.05,Default,,0,0,0,,Сәлем, Томойо Дайдужи.
Dialogue: 0,0:06:42.18,0:06:43.72,Default,,0,0,0,,Және Ли Құлпынай мырза
Dialogue: 0,0:06:44.93,0:06:47.73,Default,,0,0,0,,Демек, сіз Сакура Киномотосыз.
Dialogue: 0,0:06:48.10,0:06:49.31,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:06:49.44,0:06:51.23,Default,,0,0,0,,Кешегі күн үшін көп рахмет.
Dialogue: 0,0:06:52.98,0:06:54.90,Default,,0,0,0,,Сізбен қайта кездескеніме қуаныштымын.
Dialogue: 0,0:07:06.25,0:07:08.41,Default,,0,0,0,,Мизуки-сенсэй әдемі, солай емес пе?
Dialogue: 0,0:07:08.54,0:07:09.79,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:10.37,0:07:14.75,Default,,0,0,0,,Сендей сұлу, мейірімді болсам ғой.
Dialogue: 0,0:07:14.88,0:07:16.42,Default,,0,0,0,,Содан кейін Цукимина храмында
Dialogue: 0,0:07:16.55,0:07:18.80,Default,,0,0,0,,Тұмар алу жақсы идея болуы мүмкін.
Dialogue: 0,0:07:19.22,0:07:20.18,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:20.30,0:07:24.81,Default,,0,0,0,,Бұл амулет тілектерді орындау үшін беделге ие.
Dialogue: 0,0:07:24.93,0:07:26.31,Default,,0,0,0,,Әсіресе махаббат...
Dialogue: 0,0:07:26.43,0:07:27.81,Default,,0,0,0,,Махаббат!?
Dialogue: 0,0:07:28.23,0:07:30.35,Default,,0,0,0,,Ах... Ичиго Сузу-чан?
Dialogue: 0,0:07:30.48,0:07:31.48,Default,,0,0,0,,
Dialogue: 0,0:07:31.60,0:07:35.23,Default,,0,0,0,,Арбаға сүйенбесем де, Сяоран екеуміздің махаббатымыз
Dialogue: 0,0:07:35.36,0:07:37.82,Default,,0,0,0,,Маңызды емес, өйткені ол мінсіз орындалды.
Dialogue: 0,0:07:38.15,0:07:40.36,Default,,0,0,0,,Охохохохо охохохохо...
Dialogue: 0,0:07:40.49,0:07:42.32,Default,,0,0,0,,А...?
Dialogue: 0,0:07:46.16,0:07:49.50,Default,,0,0,0,,Мұндағы тұмардың махаббатқа жарайтынын білмедім.
Dialogue: 0,0:07:49.62,0:07:52.83,Default,,0,0,0,,Наоко-чан, сен мұндай нәрсе туралы көп білесің.
Dialogue: 0,0:07:53.63,0:07:55.09,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:07:56.13,0:07:58.84,Default,,0,0,0,,Ах... Юкито-сан...
Dialogue: 0,0:07:59.34,0:08:00.80,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:00.93,0:08:02.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:05.76,0:08:06.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:08.60,0:08:10.14,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:08:11.19,0:08:14.15,Default,,0,0,0,,Бұл... біртүрлі...
Dialogue: 0,0:08:14.48,0:08:15.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.69,0:08:19.15,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,0:08:20.03,0:08:21.90,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар
Dialogue: 0,0:08:22.20,0:08:25.20,Default,,0,0,0,,Қорғауға болатын жер сол жақта сияқты.
Dialogue: 0,0:08:25.32,0:08:26.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:27.54,0:08:29.66,Default,,0,0,0,,Күте тұрыңыз, Ичиго Сузу, міне...
Dialogue: 0,0:08:30.00,0:08:34.00,Default,,0,0,0,,Маған бұл амулет байланысымызды нығайту үшін керек.
Dialogue: 0,0:08:34.13,0:08:36.04,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:08:36.59,0:08:37.92,Default,,0,0,0,,Айқай
Dialogue: 0,0:08:38.42,0:08:40.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:40.38,0:08:42.17,Default,,0,0,0,,Киномото-сан, бұл...
Dialogue: 0,0:08:42.30,0:08:43.43,Default,,0,0,0,,Ли мырза!
Dialogue: 0,0:08:43.84,0:08:46.93,Default,,0,0,0,,Осы ғибадатханаға кіргенде бірдеңені сезіндіңіз бе?
Dialogue: 0,0:08:47.47,0:08:48.89,Default,,0,0,0,,Сен де сездің бе?
Dialogue: 0,0:08:49.02,0:08:50.02,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,0:08:50.14,0:08:51.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:52.10,0:08:54.02,Default,,0,0,0,,Айқай? (Ичиго Сузу) Не?
Dialogue: 0,0:08:54.15,0:08:57.06,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:57.90,0:08:59.11,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:09:01.61,0:09:03.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.63,0:09:16.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:16.88,0:09:18.88,Default,,0,0,0,,Енді бұл жер қасиетті орын болды, солай ма?
Dialogue: 0,0:09:19.00,0:09:20.67,Default,,0,0,0,,Иә, сөзсіз...
Dialogue: 0,0:09:20.92,0:09:22.67,Default,,0,0,0,,Шығу жолы қандай?
Dialogue: 0,0:09:23.38,0:09:24.22,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:24.34,0:09:25.76,Default,,0,0,0,,Алдымен белгілерді оқы
Dialogue: 0,0:09:25.89,0:09:26.93,Default,,0,0,0,,Иә (Ичиго Сузу)?
Dialogue: 0,0:09:37.19,0:09:38.44,Default,,0,0,0,,Клоу картасының белгісі!
Dialogue: 0,0:09:38.90,0:09:41.57,Default,,0,0,0,,Сонымен, бұл Clow Card жұмысы ма?
Dialogue: 0,0:09:41.69,0:09:44.36,Default,,0,0,0,,Шатастырылған «Лабиринт» картасы шығар
Dialogue: 0,0:09:44.49,0:09:47.24,Default,,0,0,0,,көремін. Сондықтан лабиринт жасауға болады.
Dialogue: 0,0:09:47.37,0:09:49.45,Default,,0,0,0,,Ал, қалғанын Сяоранға қалдыр.
Dialogue: 0,0:09:50.03,0:09:53.50,Default,,0,0,0,,Жүр, мына лабиринтті тез өшіріп, тұмар сатып алайық.
Dialogue: 0,0:09:53.62,0:09:55.25,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:09:55.37,0:09:59.00,Default,,0,0,0,,Лабиринт оған кірген адам шығатын жолды таппайынша жоғалмайды.
Dialogue: 0,0:09:59.13,0:09:59.96,Default,,0,0,0,,Иә!?
Dialogue: 0,0:10:00.42,0:10:03.42,Default,,0,0,0,,Мен шығуды таппайынша ол жоғалмайды...
Dialogue: 0,0:10:28.87,0:10:30.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:30.17,0:10:31.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.54,0:10:33.50,Default,,0,0,0,,Сен осы жерден өткен жоқсың ба?
Dialogue: 0,0:10:33.63,0:10:37.13,Default,,0,0,0,,Ойлап қарасам, осыдан бері табиғат көрінісі мүлде өзгерген жоқ.
Dialogue: 0,0:10:37.26,0:10:38.88,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:10:39.26,0:10:41.72,Default,,0,0,0,,Бір қолыңды қабырғаға осылай қойсаң
Dialogue: 0,0:10:41.84,0:10:44.18,Default,,0,0,0,,Мен бір күні шыға алатыныма сенімдімін...
Dialogue: 0,0:10:45.97,0:10:49.81,Default,,0,0,0,,Ах! Ли, сізде компас болды, солай ма? (Сяоран) Ах.
Dialogue: 0,0:10:50.52,0:10:53.98,Default,,0,0,0,,Бұл бағыттарды тексеруге мүмкіндік береді, солай ма?
Dialogue: 0,0:10:55.44,0:10:56.28,Default,,0,0,0,,Ая?
Dialogue: 0,0:10:56.40,0:11:00.07,Default,,0,0,0,,Бұл компас Клоу карталарын іздеуге арналған.
Dialogue: 0,0:11:00.20,0:11:01.32,Default,,0,0,0,,Я~
Dialogue: 0,0:11:01.61,0:11:04.16,Default,,0,0,0,,Бірақ мен жақсырақ жолды ойлауым керек.
Dialogue: 0,0:11:04.28,0:11:06.83,Default,,0,0,0,,Қанша уақыт өтсе де, мен бұл жерден шыға алмаймын.
Dialogue: 0,0:11:07.04,0:11:08.33,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:11:08.45,0:11:10.83,Default,,0,0,0,,Иә! Мен жақсы нәрсе ойладым!
Dialogue: 0,0:11:18.09,0:11:20.26,Default,,0,0,0,,Қараңғылық күшін жасыратын кілт
Dialogue: 0,0:11:20.38,0:11:23.09,Default,,0,0,0,,Менің алдымда шынайы болмысыңды көрсет
Dialogue: 0,0:11:23.43,0:11:26.10,Default,,0,0,0,,Сакура келісім-шарт бойынша бұйрық береді
Dialogue: 0,0:11:26.43,0:11:27.60,Default,,0,0,0,,Пломбаны босатыңыз!
Dialogue: 0,0:11:41.90,0:11:42.86,Default,,0,0,0,,Шо!
Dialogue: 0,0:11:43.91,0:11:45.87,Default,,0,0,0,,Енді мен шығуды іздеймін.
Dialogue: 0,0:11:46.33,0:11:47.91,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:53.42,0:11:54.46,Default,,0,0,0,,Айқай?
Dialogue: 0,0:11:54.88,0:11:55.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:58.34,0:11:59.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:59.63,0:12:01.55,Default,,0,0,0,,Айқай~
Dialogue: 0,0:12:03.09,0:12:05.68,Default,,0,0,0,,Бұл аспаннан іздеудің пайдасы жоқ дегенді білдіре ме?
Dialogue: 0,0:12:05.80,0:12:08.85,Default,,0,0,0,,Мистер лабиринт картасы қатал, солай емес пе?
Dialogue: 0,0:12:09.10,0:12:12.89,Default,,0,0,0,,Сабыр етсең, сүйкімді сатып ала алмайсың!
Dialogue: 0,0:12:13.02,0:12:14.19,Default,,0,0,0,,Мұндай қабырға әлдеқашан бар!
Dialogue: 0,0:12:14.31,0:12:16.02,Default,,0,0,0,,Бұлай істесең де, ол бұзылмайды.
Dialogue: 0,0:12:16.15,0:12:17.61,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:12:17.94,0:12:21.11,Default,,0,0,0,,Түсіндім! Дұрыс, Ичиго Сузу-чан (Ичиго Сузу) Бұл не?
Dialogue: 0,0:12:21.74,0:12:24.61,Default,,0,0,0,,Жоғарыдан шығатын жолды таба алмасаңыз...
Dialogue: 0,0:12:31.62,0:12:34.54,Default,,0,0,0,,Біздің жолымызды кескендерді кесіңіз!
Dialogue: 0,0:12:34.67,0:12:36.58,Default,,0,0,0,,Қылыш!
Dialogue: 0,0:12:46.09,0:12:48.05,Default,,0,0,0,,Оны бұзып көріңіз!
Dialogue: 0,0:12:49.30,0:12:50.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:53.23,0:12:54.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:55.14,0:12:55.98,Default,,0,0,0,,Кесілген!
Dialogue: 0,0:12:57.94,0:12:58.77,Default,,0,0,0,,Айқай?
Dialogue: 0,0:12:59.15,0:13:00.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:00.15,0:13:02.03,Default,,0,0,0,,Қылышпен айналысқан дұрыс емес пе...
Dialogue: 0,0:13:02.94,0:13:06.41,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:13:06.82,0:13:08.53,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:13:09.45,0:13:10.53,Default,,0,0,0,,Кя!
Dialogue: 0,0:13:10.83,0:13:12.54,Default,,0,0,0,,Құлпынай қоңырауы! Уау
Dialogue: 0,0:13:13.08,0:13:14.12,Default,,0,0,0,,Сакура-чан!
Dialogue: 0,0:13:14.25,0:13:15.16,Default,,0,0,0,,Томойо-чан!
Dialogue: 0,0:13:15.33,0:13:16.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:16.75,0:13:18.13,Default,,0,0,0,,Амансың ба!? (Томойо) Ли
Dialogue: 0,0:13:18.25,0:13:19.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:19.67,0:13:21.17,Default,,0,0,0,,Томойо-чан!
Dialogue: 0,0:13:21.42,0:13:23.26,Default,,0,0,0,,Сакура-чан!
Dialogue: 0,0:13:29.14,0:13:31.22,Default,,0,0,0,,Фука шақырады!
Dialogue: 0,0:13:38.35,0:13:39.31,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:39.44,0:13:41.15,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:41.40,0:13:44.23,Default,,0,0,0,,Рахмет, иә?
Dialogue: 0,0:13:54.12,0:13:57.83,Default,,0,0,0,,Шығудың жолын табу қиындап барады.
Dialogue: 0,0:13:57.96,0:13:59.50,Default,,0,0,0,,Ая~
Dialogue: 0,0:13:59.67,0:14:00.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:00.92,0:14:02.13,Default,,0,0,0,,Ичиго Сузу ше?
Dialogue: 0,0:14:02.25,0:14:04.50,Default,,0,0,0,,Сяоран!
Dialogue: 0,0:14:04.71,0:14:07.22,Default,,0,0,0,,Құлпынай қоңырауы! Бұл қайда?
Dialogue: 0,0:14:07.51,0:14:09.51,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:14:09.68,0:14:11.51,Default,,0,0,0,,Тез кел~
Dialogue: 0,0:14:11.64,0:14:12.47,Default,,0,0,0,,Ичиго Сузу-чан
Dialogue: 0,0:14:12.60,0:14:14.51,Default,,0,0,0,,Күте тұрыңыз, мен сізге қазір көмектесемін!
Dialogue: 0,0:14:18.06,0:14:20.10,Default,,0,0,0,,Фука шақырады!
Dialogue: 0,0:14:24.82,0:14:25.94,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:14:26.07,0:14:28.65,Default,,0,0,0,,Кеңістік бұралып, оған жел жете алмайды.
Dialogue: 0,0:14:28.78,0:14:30.66,Default,,0,0,0,,Сяоран!
Dialogue: 0,0:14:30.99,0:14:34.12,Default,,0,0,0,,Мен сізге міндетті түрде барамын, сондықтан ол жаққа көшпеңіз!
Dialogue: 0,0:14:34.24,0:14:35.66,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:14:35.79,0:14:37.66,Default,,0,0,0,,Жаяу жүруден басқа амалың қалмайды.
Dialogue: 0,0:14:38.41,0:14:41.67,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:14:43.54,0:14:45.92,Default,,0,0,0,,Мектеп әдеттегі уақытта бітеді.
Dialogue: 0,0:14:46.05,0:14:47.55,Default,,0,0,0,,Мен сол жерде іздеп көрейін.
Dialogue: 0,0:14:47.97,0:14:51.22,Default,,0,0,0,,Әке, үйде болыңыз. Ол сізге хабарласуы мүмкін.
Dialogue: 0,0:14:51.34,0:14:52.18,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:15:11.70,0:15:15.20,Default,,0,0,0,,Сяоран, асығыңыз~!
Dialogue: 0,0:15:15.49,0:15:17.12,Default,,0,0,0,,Дерлік
Dialogue: 0,0:15:21.75,0:15:23.38,Default,,0,0,0,,Осы жерге кіргеннен кейін
Dialogue: 0,0:15:23.50,0:15:26.71,Default,,0,0,0,,Мен Ичиго Сузу-чанды енді көре алмаймын.
Dialogue: 0,0:15:26.84,0:15:27.96,Default,,0,0,0,,Қайтару?
Dialogue: 0,0:15:28.09,0:15:28.92,Default,,0,0,0,,Бірақ қараңыз!
Dialogue: 0,0:15:29.30,0:15:33.14,Default,,0,0,0,,Егер сіз алысқа барсаңыз, Ичиго Сузуны қайтадан көре аласыз.
Dialogue: 0,0:15:33.26,0:15:35.72,Default,,0,0,0,,Дұрыс... Ичиго Сузу!
Dialogue: 0,0:15:35.85,0:15:37.35,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:15:37.47,0:15:40.68,Default,,0,0,0,,Біз бұл туннельге кіргелі жатырмыз.
Dialogue: 0,0:15:40.81,0:15:44.69,Default,,0,0,0,,Сен маған айқайлап, қайда екеніңді айт, жарай ма?
Dialogue: 0,0:15:44.98,0:15:46.94,Default,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:15:47.07,0:15:49.19,Default,,0,0,0,,Баяу сана
Dialogue: 0,0:15:49.48,0:15:51.19,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:15:51.40,0:15:52.49,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:52.61,0:15:54.41,Default,,0,0,0,,Ичи
Dialogue: 0,0:15:54.53,0:15:56.33,Default,,0,0,0,,Nii
Dialogue: 0,0:15:56.45,0:15:57.70,Default,,0,0,0,,Сан
Dialogue: 0,0:15:58.79,0:16:00.91,Default,,0,0,0,,Шии
Dialogue: 0,0:16:01.04,0:16:03.17,Default,,0,0,0,,Гуу
Dialogue: 0,0:16:03.29,0:16:05.46,Default,,0,0,0,,Roku
Dialogue: 0,0:16:05.58,0:16:07.67,Default,,0,0,0,,Шичи
Dialogue: 0,0:16:07.79,0:16:09.92,Default,,0,0,0,,Хачи
Dialogue: 0,0:16:10.05,0:16:11.26,Default,,0,0,0,,Кю…
Dialogue: 0,0:16:11.38,0:16:12.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:12.84,0:16:14.34,Default,,0,0,0,,Құлпынай қоңырауы!
Dialogue: 0,0:16:14.97,0:16:15.80,Default,,0,0,0,,Уф
Dialogue: 0,0:16:23.98,0:16:24.98,Default,,0,0,0,,Құлпынай қоңырауы!
Dialogue: 0,0:16:25.40,0:16:26.94,Default,,0,0,0,,Құлпынай қоңырауы!
Dialogue: 0,0:16:27.06,0:16:28.48,Default,,0,0,0,,Ичиго Сузу-чан!
Dialogue: 0,0:16:28.86,0:16:30.73,Default,,0,0,0,,Қайда?
Dialogue: 0,0:16:35.74,0:16:38.99,Default,,0,0,0,,Ол маған қозғалмау керектігін айтты...
Dialogue: 0,0:16:39.79,0:16:44.62,Default,,0,0,0,,Әке, аға... Уайымдайсыз ба...
Dialogue: 0,0:16:45.29,0:16:46.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:46.88,0:16:49.50,Default,,0,0,0,,Бәрібір іздеп көрейік! Ичиго Сузу-чан күтіп тұр!
Dialogue: 0,0:16:49.63,0:16:50.88,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:50.88,0:16:51.17,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:50.88,0:16:51.17,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:51.17,0:16:51.67,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:51.67,0:16:52.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:51.67,0:16:52.51,Default,,0,0,0,,Ах
Dialogue: 0,0:16:54.26,0:16:56.47,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:56.59,0:16:57.72,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:16:57.84,0:17:00.26,Default,,0,0,0,,Лабиринт пайда болған кезде мен...
Dialogue: 0,0:17:01.85,0:17:02.77,Default,,0,0,0,,Құт
Dialogue: 0,0:17:03.43,0:17:04.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.73,0:17:05.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:06.19,0:17:07.15,Default,,0,0,0,,Уф, бұл кім!
Dialogue: 0,0:17:10.27,0:17:11.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:11.23,0:17:13.15,Default,,0,0,0,,Құлпынай қоңырауы! (Ичиго Сузу) Сяоран!
Dialogue: 0,0:17:13.28,0:17:14.49,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:17:14.61,0:17:16.61,Default,,0,0,0,,Бірақ біз мұнда қалай келдік?
Dialogue: 0,0:17:16.74,0:17:18.16,Default,,0,0,0,,Мен көмек алдым.
Dialogue: 0,0:17:18.28,0:17:19.12,Default,,0,0,0,,Кімге?
Dialogue: 0,0:17:19.24,0:17:22.12,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:23.62,0:17:24.66,Default,,0,0,0,,Мизуки мырза!
Dialogue: 0,0:17:25.12,0:17:26.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:26.87,0:17:30.04,Default,,0,0,0,,Менің ғибадатханамнан біртүрлі адам келе жатыр деп ойладым.
Dialogue: 0,0:17:30.17,0:17:32.42,Default,,0,0,0,,Кенеттен осындай лабиринт пайда болды.
Dialogue: 0,0:17:32.55,0:17:33.67,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:17:33.96,0:17:35.01,Default,,0,0,0,,Менікі?
Dialogue: 0,0:17:35.13,0:17:38.39,Default,,0,0,0,,Мен осы ғибадатхананың діни қызметкерінің қызымын.
Dialogue: 0,0:17:38.51,0:17:39.43,Default,,0,0,0,,Айқай
Dialogue: 0,0:17:39.80,0:17:41.18,Default,,0,0,0,,Бірақ бәрі жақсы болды.
Dialogue: 0,0:17:41.30,0:17:45.68,Default,,0,0,0,,Адасып қалған адам болса, қиналып қалармын деп жан-жағыма қарадым.
Dialogue: 0,0:17:45.81,0:17:48.56,Default,,0,0,0,,Сол кезде Ли мырза жылап отырды.
Dialogue: 0,0:17:48.69,0:17:50.40,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:50.52,0:17:52.19,Default,,0,0,0,,Бұл дыбысты естімедің бе?
Dialogue: 0,0:17:52.57,0:17:55.03,Default,,0,0,0,,Айналаңыздағы заттар тәртіпсіз бола бастағанда...
Dialogue: 0,0:17:55.15,0:17:57.61,Default,,0,0,0,,Мен абай болғым келді, бірақ...
Dialogue: 0,0:17:57.74,0:17:59.28,Default,,0,0,0,,Кеш болған сияқты.
Dialogue: 0,0:17:59.41,0:18:01.20,Default,,0,0,0,,Қызықты пішін.
Dialogue: 0,0:18:01.83,0:18:04.41,Default,,0,0,0,,Бұл менің ғибадатханада көптен бері болды.
Dialogue: 0,0:18:04.54,0:18:06.20,Default,,0,0,0,,Бұл әлі де қоңырау
Dialogue: 0,0:18:06.75,0:18:07.41,Default,,0,0,0,,Айқай~
Dialogue: 0,0:18:07.41,0:18:08.21,Default,,0,0,0,,Айқай~
Dialogue: 0,0:18:07.41,0:18:08.21,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:08.21,0:18:08.33,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:08.33,0:18:09.21,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:08.33,0:18:09.21,Default,,0,0,0,,Онда батарея бар—
Dialogue: 0,0:18:09.21,0:18:10.21,Default,,0,0,0,,Онда батарея бар—
Dialogue: 0,0:18:10.42,0:18:11.50,Default,,0,0,0,,Уау
Dialogue: 0,0:18:11.96,0:18:14.13,Default,,0,0,0,,Бейшараның аш болуы керек.
Dialogue: 0,0:18:14.25,0:18:16.47,Default,,0,0,0,,Олай болса, бұл жерден кетеміз бе? (Барлығы) Иә?
Dialogue: 0,0:18:16.59,0:18:20.01,Default,,0,0,0,,Мен көптен бері іздеп жүрмін, бірақ еш жерде шығу жоқ...
Dialogue: 0,0:18:20.14,0:18:22.30,Default,,0,0,0,,Лабиринттен қалай шығу керектігін білесің бе?
Dialogue: 0,0:18:22.43,0:18:25.72,Default,,0,0,0,,Мен әртүрлі нәрселерді қолданып көрдім, бірақ нәтиже болмады.
Dialogue: 0,0:18:26.31,0:18:27.64,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:18:31.52,0:18:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.77,0:18:35.78,Default,,0,0,0,,Бірақ қабырғаны бұзсаңыз да, ол көп ұзамай қайтып келеді...
Dialogue: 0,0:18:35.90,0:18:36.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:40.24,0:18:41.49,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:41.82,0:18:43.62,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:18:43.74,0:18:46.24,Default,,0,0,0,,Мен шығып кетсем, бәрі жақсы.
Dialogue: 0,0:18:46.50,0:18:48.41,Default,,0,0,0,,Қабырға бұрынғы күйіне оралмайды...
Dialogue: 0,0:18:48.54,0:18:53.00,Default,,0,0,0,,Бұл лабиринтті қирату үшін оның үлкен күші болуы керек.
Dialogue: 0,0:18:54.50,0:18:55.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:06.56,0:19:07.97,Default,,0,0,0,,Шығу
Dialogue: 0,0:19:08.48,0:19:12.02,Default,,0,0,0,,(Сакураның дауысы)
Dialogue: 0,0:19:12.48,0:19:14.23,Default,,0,0,0,,Хехехе, ақыры шықтым.
Dialogue: 0,0:19:14.36,0:19:16.02,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:19:16.19,0:19:17.78,Default,,0,0,0,,Я...
Dialogue: 0,0:19:18.19,0:19:19.03,Default,,0,0,0,,Ах (Ичиго Сузу) Иә?
Dialogue: 0,0:19:22.03,0:19:24.12,Default,,0,0,0,,Тағы бір лабиринт қалыптаса бастады.
Dialogue: 0,0:19:24.24,0:19:25.58,Default,,0,0,0,,Карточкаға тез оралыңыз!
Dialogue: 0,0:19:25.70,0:19:27.29,Default,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:19:27.74,0:19:29.87,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:19:30.00,0:19:31.79,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:19:33.50,0:19:35.29,Default,,0,0,0,,Сонда мен артқа қарап тұрмын.
Dialogue: 0,0:19:35.67,0:19:38.80,Default,,0,0,0,,Хмм, менің ойымша, бәрі жақсы...
Dialogue: 0,0:19:39.26,0:19:41.80,Default,,0,0,0,,Асығыңыз! Тағы лабиринт болады!
Dialogue: 0,0:19:42.18,0:19:44.30,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:19:51.39,0:19:53.48,Default,,0,0,0,,Қараңғылық күшін жасыратын кілт
Dialogue: 0,0:19:53.60,0:19:55.90,Default,,0,0,0,,Менің алдымда шынайы болмысыңды көрсет
Dialogue: 0,0:19:56.02,0:19:58.57,Default,,0,0,0,,Сакура келісім-шарт бойынша бұйрық береді
Dialogue: 0,0:19:58.94,0:20:00.07,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:20:11.62,0:20:13.46,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызға оралыңыз
Dialogue: 0,0:20:14.00,0:20:16.63,Default,,0,0,0,,Клоу картасы!
Dialogue: 0,0:20:26.76,0:20:27.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:34.10,0:20:36.19,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:20:36.31,0:20:39.65,Default,,0,0,0,,Оны алғаныңыз жақсы. Иә.
Dialogue: 0,0:20:41.57,0:20:42.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.15,0:20:44.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:46.95,0:20:47.91,Default,,0,0,0,,Сакура!
Dialogue: 0,0:20:48.41,0:20:49.78,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:20:49.91,0:20:51.16,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:51.54,0:20:53.75,Default,,0,0,0,,Әй, мен аздап адасып қалдым.
Dialogue: 0,0:20:53.87,0:20:57.00,Default,,0,0,0,,Сонымен, Мизуки-сенсэй маған көмектесті ме?
Dialogue: 0,0:20:57.13,0:21:00.17,Default,,0,0,0,,Сіз мені шығуға апардыңыз...
Dialogue: 0,0:21:00.63,0:21:01.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:04.80,0:21:07.68,Default,,0,0,0,,Көп нәрсе болды, ұрыспашы өтінемін.
Dialogue: 0,0:21:10.72,0:21:11.68,Default,,0,0,0,,Ютахо...
Dialogue: 0,0:21:13.81,0:21:15.69,Default,,0,0,0,,Үлкен болып кеттің, Тоя.
Dialogue: 0,0:21:16.02,0:21:17.27,Default,,0,0,0,,Айқай?
Dialogue: 0,0:21:18.90,0:21:20.69,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:21:21.61,0:21:22.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:23.03,0:21:24.69,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:21:29.87,0:21:30.95,Default,,0,0,0,,Тұмар…
Dialogue: 0,0:21:31.08,0:21:33.12,Default,,0,0,0,,Бітті...
Dialogue: 0,0:21:36.04,0:21:37.04,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:21:37.96,0:21:39.33,Default,,0,0,0,,Ах, рахмет!
Dialogue: 0,0:21:39.46,0:21:41.50,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:21:41.63,0:21:43.05,Default,,0,0,0,,Сіз де соны қаладыңыз, солай ма?
Dialogue: 0,0:21:43.63,0:21:46.55,Default,,0,0,0,,Сіз қайдан білдіңіз? Біз ештеңе емеспіз...
Dialogue: 0,0:21:47.97,0:21:49.55,Default,,0,0,0,,Әйтеуір.
Dialogue: 0,0:21:52.35,0:21:53.47,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:21:53.60,0:21:55.23,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:22:02.90,0:22:03.78,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:22:03.90,0:22:06.57,Default,,0,0,0,,Өйткені, ол мұғалім қарапайым адам емес.
Dialogue: 0,0:22:07.78,0:22:10.62,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:22:15.70,0:22:17.29,Default,,0,0,0,,Кездескенше, Киномото мырза
Dialogue: 0,0:22:17.62,0:22:18.79,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:22:19.75,0:22:21.75,Default,,0,0,0,,Тоя кездескенше
Dialogue: 0,0:22:30.39,0:22:32.93,Default,,0,0,0,,Үлкен аға, Мизуки-сенсэй, сен білесің бе?
Dialogue: 0,0:22:39.52,0:22:41.19,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:44.82,0:22:49.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:22:51.45,0:22:56.45,Default,,0,0,0,,♪~
Dialogue: 0,0:23:54.14,0:23:59.14,Default,,0,0,0,,~♪
Dialogue: 0,0:24:08.32,0:24:10.36,Default,,0,0,0,,Коньянячива~
Dialogue: 0,0:24:11.44,0:24:13.86,Default,,0,0,0,,Бұл жолы мен Сакураның достарымен таныстырамын.
Dialogue: 0,0:24:14.24,0:24:16.28,Default,,0,0,0,,Сіз оны дұрыс есте сақтайсыз ба?
Dialogue: 0,0:24:17.08,0:24:22.00,Default,,0,0,0,,Оң жақтан: Чихару Михара, Рика Сасаки, Наоко Янагисава.
Dialogue: 0,0:24:22.12,0:24:24.00,Default,,0,0,0,,Чихару жарқын және жігерлі
Dialogue: 0,0:24:24.12,0:24:26.33,Default,,0,0,0,,Рика жетілген және тұрақты...
Dialogue: 0,0:24:26.46,0:24:30.21,Default,,0,0,0,,Наоко - қорқынышты оқиғаларды жақсы көретін қыз.
Dialogue: 0,0:24:30.96,0:24:31.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:24:32.01,0:24:34.55,Default,,0,0,0,,Сакура Сенің достарың көп сияқты.
Dialogue: 0,0:24:34.68,0:24:38.18,Default,,0,0,0,,Бәріміз достар тапайық, Хона!
Dialogue: 0,0:24:39.01,0:24:40.85,Default,,0,0,0,,Айқай? Бұл қайда?
Dialogue: 0,0:24:40.97,0:24:44.10,Default,,0,0,0,,Егер есімде дұрыс болса, мен Керо-чан екеуміз Клоу карталарын іздеп келдік...
Dialogue: 0,0:24:44.27,0:24:48.06,Default,,0,0,0,,Айқай! Менің ағам мен Мизуки-сенсэй бірге!
Dialogue: 0,0:24:48.19,0:24:49.07,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:24:50.19,0:24:51.90,Default,,0,0,0,,«Карткаптор Сакура»
Dialogue: 0,0:24:54.11,0:24:57.32,Default,,0,0,0,,Келесі жолы да Сакурамен бірге шығарыңыз!
Dialogue: 0,0:24:58.82,0:25:04.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory