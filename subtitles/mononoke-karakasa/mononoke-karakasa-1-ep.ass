Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:43.08,0:00:43.91,Default,,0,0,0,,О...
Dialogue: 0,0:00:49.91,0:00:51.62,Default,,0,0,0,,Ақыры келді
Dialogue: 0,0:00:52.37,0:00:53.37,Default,,0,0,0,,Оку
Dialogue: 0,0:00:56.16,0:00:59.75,Default,,0,0,0,,Мен үлкен мочиге арналған мерекелік заттарды осында сақтаймын.
Dialogue: 0,0:00:59.83,0:01:01.62,Default,,0,0,0,,Тәртіп бойынша тізілген
Dialogue: 0,0:01:02.62,0:01:04.62,Default,,0,0,0,,Окуда ер адамдарға рұқсат етілмейді
Dialogue: 0,0:01:04.70,0:01:07.29,Default,,0,0,0,,Оногоға билетсіз кіре алмайсыз.
Dialogue: 0,0:01:11.29,0:01:13.70,Default,,0,0,0,,Бұл О-оку ма?
Dialogue: 0,0:01:13.79,0:01:17.04,Default,,0,0,0,,Куу~! Жақсылап барады!
Dialogue: 0,0:01:17.12,0:01:18.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:18.12,0:01:19.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:22.16,0:01:22.83,Default,,0,0,0,,Ах
Dialogue: 0,0:01:23.79,0:01:24.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:29.70,0:01:32.87,Default,,0,0,0,,Жақсы! Құлаған жоқ
Dialogue: 0,0:01:33.79,0:01:34.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:34.70,0:01:35.75,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:01:35.83,0:01:39.50,Default,,0,0,0,,Білмеймін, бірақ дәмді екеніне сенімдімін.
Dialogue: 0,0:01:40.00,0:01:41.66,Default,,0,0,0,,Бұл хоба мисодан жасалған күріш шары.
Dialogue: 0,0:01:42.25,0:01:43.45,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:01:44.00,0:01:45.20,Default,,0,0,0,,Оны бөлісеміз бе?
Dialogue: 0,0:01:45.29,0:01:46.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:46.50,0:01:49.08,Default,,0,0,0,,«Окуда бізге қамқорлық жасайтындарға»
Dialogue: 0,0:01:49.16,0:01:51.62,Default,,0,0,0,,Әжемнің бергені көп.
Dialogue: 0,0:01:54.83,0:01:58.45,Default,,0,0,0,,Менің атым Каме, мен Окуға жұмысқа бардым.
Dialogue: 0,0:01:59.04,0:02:01.37,Default,,0,0,0,,Мен де бүгіннен бастап Окуда жұмыс істеймін.
Dialogue: 0,0:02:01.87,0:02:03.20,Default,,0,0,0,,Менің атым Аса.
Dialogue: 0,0:02:03.29,0:02:06.29,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:02:06.37,0:02:07.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:07.54,0:02:11.70,Default,,0,0,0,,Күйген мисо мен магнолия жапырақтарының иісі
Dialogue: 0,0:02:11.79,0:02:13.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:13.87,0:02:14.66,Default,,0,0,0,,А, бұл
Dialogue: 0,0:02:15.29,0:02:17.45,Default,,0,0,0,,Қарсы болмасаң, сенімен бөлісемін.
Dialogue: 0,0:02:17.95,0:02:19.91,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:02:20.00,0:02:20.83,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:21.41,0:02:24.29,Default,,0,0,0,,Анау екеуі Аса мен Окаме ма?
Dialogue: 0,0:02:24.95,0:02:25.79,Default,,0,0,0,,О~
Dialogue: 0,0:02:25.87,0:02:29.20,Default,,0,0,0,,Екеуі де бұрынғы беделіндей жақсы.
Dialogue: 0,0:02:29.79,0:02:31.00,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:02:31.50,0:02:33.16,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:33.75,0:02:35.83,Default,,0,0,0,,Алыстағы ауыр жұмыс болса керек.
Dialogue: 0,0:02:36.33,0:02:38.66,Default,,0,0,0,,Бұл Хирокибаннан келген Сакашита.
Dialogue: 0,0:02:38.75,0:02:42.87,Default,,0,0,0,,Оокудың қақпашысы ретінде ол осы жеті кіреберісті күзетеді.
Dialogue: 0,0:02:42.95,0:02:45.00,Default,,0,0,0,,Саса Жүгіңді сақтайық.
Dialogue: 0,0:02:45.50,0:02:46.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:47.50,0:02:50.20,Default,,0,0,0,,Бірақ сізде бұл ғана болғандықтан, оны өзіңіз алып жүре аласыз.
Dialogue: 0,0:02:50.79,0:02:52.00,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:02:52.08,0:02:54.54,Default,,0,0,0,,Тасбақа жүкке толы.
Dialogue: 0,0:02:55.04,0:02:59.08,Default,,0,0,0,,Сакашита мырза мен сіздің әжеңіз, біздің арнайы күріш шарларын жеп қойыңыз.
Dialogue: 0,0:02:59.83,0:03:00.66,Default,,0,0,0,,О~
Dialogue: 0,0:03:00.75,0:03:03.29,Default,,0,0,0,,Қандай жұпар иіс!
Dialogue: 0,0:03:05.12,0:03:08.70,Default,,0,0,0,,Мен сіздің ерекше махаббат сусыныңызды дайындаймын ба?
Dialogue: 0,0:03:08.79,0:03:11.04,Default,,0,0,0,,Уау! Сіз қандайсыз?
Dialogue: 0,0:03:11.54,0:03:14.45,Default,,0,0,0,,Мен жай ғана түкке тұрғысыз есірткі сатушымын.
Dialogue: 0,0:03:15.37,0:03:19.91,Default,,0,0,0,,Егерестен кез келген балаға жарайтын махаббат сусыны.
Dialogue: 0,0:03:20.00,0:03:20.79,Default,,0,0,0,,Әртүрлі заттар...
Dialogue: 0,0:03:20.87,0:03:22.08,Default,,0,0,0,,Бұл бізге керек емес!
Dialogue: 0,0:03:22.66,0:03:24.45,Default,,0,0,0,,Ол күдікті адам.
Dialogue: 0,0:03:24.54,0:03:26.33,Default,,0,0,0,,Мұның бәрі не туралы? Бұл көрініс
Dialogue: 0,0:03:27.16,0:03:28.37,Default,,0,0,0,,Аса мен тасбақа
Dialogue: 0,0:03:28.87,0:03:31.54,Default,,0,0,0,,Мұндай адамдармен араласпа.
Dialogue: 0,0:03:31.62,0:03:33.66,Default,,0,0,0,,Бұл жақсы нәрсе болмайды.
Dialogue: 0,0:03:35.45,0:03:39.41,Default,,0,0,0,,Ал, келесі жолы кездескенімізде, әңгімемізді жалғастырамыз.
Dialogue: 0,0:03:41.00,0:03:42.04,Default,,0,0,0,,Қызықты адам.
Dialogue: 0,0:03:42.12,0:03:43.08,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:03:43.58,0:03:45.00,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:03:45.70,0:03:48.58,Default,,0,0,0,,Хираки Бұл қазірдің өзінде О-оку.
Dialogue: 0,0:03:48.66,0:03:49.70,Default,,0,0,0,,Ұстаңыз
Dialogue: 0,0:03:49.79,0:03:53.75,Default,,0,0,0,,Сәл күт, Сабуромару, мен өзімді әдемі әйел сезінемін.
Dialogue: 0,0:03:53.83,0:03:55.66,Default,,0,0,0,,Бұл екеуі әдемі емес пе?
Dialogue: 0,0:03:56.33,0:03:57.70,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:03:57.79,0:04:01.45,Default,,0,0,0,,Егер сіз ары қарай аралассаңыз, мен рұқсат қағазыңызды лақтырып жіберемін.
Dialogue: 0,0:04:01.54,0:04:04.91,Default,,0,0,0,,Ешқандай ауыр сөз айтпа, көңіл көтерейік.
Dialogue: 0,0:04:08.50,0:04:10.16,Default,,0,0,0,,Сенімді болу үшін шотыңызды көрсетіңіз.
Dialogue: 0,0:04:10.25,0:04:11.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.50,0:04:14.91,Default,,0,0,0,,Ум... аа уххх
Dialogue: 0,0:04:22.04,0:04:23.66,Default,,0,0,0,,Сол қақпаның арғы жағында
Dialogue: 0,0:04:23.75,0:04:27.62,Default,,0,0,0,,Аға қызметшілер Авашима-доно мен Мугия-доно күтіп тұр.
Dialogue: 0,0:04:28.12,0:04:30.87,Default,,0,0,0,,Бірінші қадам ең маңызды, оны жақсы орында.
Dialogue: 0,0:04:31.45,0:04:33.50,Default,,0,0,0,,Сәлем беруге бірден келемін.
Dialogue: 0,0:04:33.58,0:04:35.91,Default,,0,0,0,,Сакашита мырза, күріш шарын да жеңіз.
Dialogue: 0,0:04:36.00,0:04:37.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:38.45,0:04:39.33,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,0:04:39.91,0:04:42.37,Default,,0,0,0,,Сізге махаббат сусыны қажет болды ма?
Dialogue: 0,0:04:42.45,0:04:46.75,Default,,0,0,0,,Бұл ішкі камера сіз сияқты адамға орын емес!
Dialogue: 0,0:04:46.83,0:04:51.00,Default,,0,0,0,,Бұл тек Көктегі Ұлы үшін жиналған Онгоға арналған орын.
Dialogue: 0,0:04:51.62,0:04:54.79,Default,,0,0,0,,Осы жеті портқа дейін енгізуге болады.
Dialogue: 0,0:04:54.87,0:04:56.75,Default,,0,0,0,,Егер сіз осы жерден рұқсатсыз өтпек болсаңыз
Dialogue: 0,0:04:56.83,0:04:58.75,Default,,0,0,0,,Сенің басыңды бірден шауып тастайды.
Dialogue: 0,0:04:58.83,0:05:00.95,Default,,0,0,0,,Келесі жолы есірткі сатушы да келеді.
Dialogue: 0,0:05:01.04,0:05:02.50,Default,,0,0,0,,Ахаха хахаха…
Dialogue: 0,0:05:02.58,0:05:03.25,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.75,0:05:05.45,Default,,0,0,0,,Маған махаббат сусыны керек емес.
Dialogue: 0,0:05:10.50,0:05:11.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:13.04,0:05:14.25,Default,,0,0,0,,Ихихи
Dialogue: 0,0:05:15.25,0:05:16.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:23.79,0:05:25.37,Default,,0,0,0,,♪~
Dialogue: 0,0:05:52.91,0:05:54.91,Default,,0,0,0,,~♪
Dialogue: 0,0:06:01.37,0:06:02.58,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:06:02.66,0:06:03.91,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:06:04.50,0:06:07.12,Default,,0,0,0,,Бұл өкіл Авашима мырза.
Dialogue: 0,0:06:07.20,0:06:10.54,Default,,0,0,0,,Менің атым Мицуги Мугитани.
Dialogue: 0,0:06:11.25,0:06:12.62,Default,,0,0,0,,Менің атым Аса.
Dialogue: 0,0:06:12.70,0:06:13.66,Default,,0,0,0,,Менің атым Каме.
Dialogue: 0,0:06:13.75,0:06:15.12,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:06:17.66,0:06:19.54,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:06:19.62,0:06:24.70,Default,,0,0,0,,Бізді бақылап тұрған Құдайдың суы.
Dialogue: 0,0:06:26.08,0:06:30.70,Default,,0,0,0,,Окуда тұратын барлық әйелдер бұл суды күнде таңертең ішеді.
Dialogue: 0,0:06:30.79,0:06:34.12,Default,,0,0,0,,Содан кейін Мимизу-саманың батасымен
Dialogue: 0,0:06:34.20,0:06:37.16,Default,,0,0,0,,Мен кез келген уақытта сенің орнын басуға дайынмын.
Dialogue: 0,0:06:37.25,0:06:38.08,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:06:41.87,0:06:42.58,Default,,0,0,0,,Гах...
Dialogue: 0,0:06:42.66,0:06:43.91,Default,,0,0,0,,
Dialogue: 0,0:06:44.00,0:06:47.45,Default,,0,0,0,,Содан кейін үйден әкелінген заттардың арасында:
Dialogue: 0,0:06:47.54,0:06:51.50,Default,,0,0,0,,Қадірлейтінімізді мына құдыққа ұсынайық.
Dialogue: 0,0:06:51.58,0:06:54.37,Default,,0,0,0,,Осы уақытқа дейін болған адамыңызды тастаңыз.
Dialogue: 0,0:06:54.95,0:06:56.33,Default,,0,0,0,,Мен туралы осы уақытқа дейін...
Dialogue: 0,0:06:56.41,0:06:57.33,Default,,0,0,0,,Оны лақтыру керек пе?
Dialogue: 0,0:06:58.00,0:07:01.50,Default,,0,0,0,,Біз Көктегі Ұлы боламыз.
Dialogue: 0,0:07:01.58,0:07:04.16,Default,,0,0,0,,- (Үй қызметкері) Тән мен жанды беру керек - (Үй қызметкері) Бұл жай ғана.
Dialogue: 0,0:07:04.25,0:07:05.66,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:07:05.75,0:07:07.87,Default,,0,0,0,,Эххе, жақсы жұмыс.
Dialogue: 0,0:07:09.20,0:07:13.08,Default,,0,0,0,,Мынау әжем берген күріш шары.
Dialogue: 0,0:07:13.16,0:07:18.29,Default,,0,0,0,,Мен барлығына ләззат алуды ойладым...
Dialogue: 0,0:07:18.37,0:07:19.66,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:23.37,0:07:24.25,Default,,0,0,0,,- Иә? -На...
Dialogue: 0,0:07:24.33,0:07:28.45,Default,,0,0,0,,Ал, енді мен көбірек дайындалдым.
Dialogue: 0,0:07:29.20,0:07:31.83,Default,,0,0,0,,Қайырлы күн Утаяма мырза
Dialogue: 0,0:07:31.91,0:07:34.33,Default,,0,0,0,,Қайырлы күн Утаяма мырза
Dialogue: 0,0:07:34.41,0:07:36.70,Default,,0,0,0,,Қайырлы күн Утаяма мырза
Dialogue: 0,0:07:39.87,0:07:43.62,Default,,0,0,0,,Осы сияқты көптеген маңызды нәрселерді алып жүру
Dialogue: 0,0:07:43.70,0:07:46.08,Default,,0,0,0,,Мен өз жұмысымды орындай алмаймын.
Dialogue: 0,0:07:46.16,0:07:47.12,Default,,0,0,0,,Мен қорқамын!
Dialogue: 0,0:07:47.20,0:07:49.04,Default,,0,0,0,,Маңызды нәрсені лақтыру
Dialogue: 0,0:07:49.12,0:07:51.62,Default,,0,0,0,,Бұл сіздің жұмысыңызға қажет пе?
Dialogue: 0,0:07:53.83,0:07:58.25,Default,,0,0,0,,Сіз өте жақсы сөздер айтасыз.
Dialogue: 0,0:07:58.83,0:08:01.95,Default,,0,0,0,,Жас кезімнен қолмен оқуға ынталымын.
Dialogue: 0,0:08:02.04,0:08:03.91,Default,,0,0,0,,Әкеден, соның нәтижесінде
Dialogue: 0,0:08:04.00,0:08:06.62,Default,,0,0,0,,Өйткені маған О-окуға бару мүмкіндігі берілді.
Dialogue: 0,0:08:06.70,0:08:10.33,Default,,0,0,0,,Маған оқуды жалғастыру керектігін айтты.
Dialogue: 0,0:08:11.83,0:08:13.75,Default,,0,0,0,,Бірақ маған
Dialogue: 0,0:08:13.83,0:08:16.41,Default,,0,0,0,,Лақтыратын тым қымбат ештеңе жоқ.
Dialogue: 0,0:08:17.70,0:08:18.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:18.70,0:08:21.50,Default,,0,0,0,,Лақтыратын ештеңеңіз жоқ па?
Dialogue: 0,0:08:22.91,0:08:23.75,Default,,0,0,0,,Әжеңнен!
Dialogue: 0,0:08:24.50,0:08:25.95,Default,,0,0,0,,-Әжемнен алдым... -Тасбақа!
Dialogue: 0,0:08:26.04,0:08:28.12,Default,,0,0,0,,Бұл тарақ. Оны бойтұмар ретінде қолданыңыз.
Dialogue: 0,0:08:28.20,0:08:31.16,Default,,0,0,0,,Жақсы! Мұны істеудің қажеті жоқ
Dialogue: 0,0:08:32.16,0:08:32.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:33.54,0:08:36.45,Default,,0,0,0,,Мен Окуда жақсы жұмыс істеуім керек.
Dialogue: 0,0:08:51.83,0:08:55.37,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:08:55.45,0:08:58.66,Default,,0,0,0,,(Артқы жағындағы баланың қозғалуының ішкі дыбысы)
Dialogue: 0,0:08:58.75,0:08:59.83,Default,,0,0,0,,Пішін...
Dialogue: 0,0:09:01.20,0:09:02.37,Default,,0,0,0,,орындалды
Dialogue: 0,0:09:14.95,0:09:16.54,Default,,0,0,0,,Сіз дымқыл боласыз.
Dialogue: 0,0:09:18.58,0:09:20.95,Default,,0,0,0,,Ух... Утаяма мырза!
Dialogue: 0,0:09:21.04,0:09:23.50,Default,,0,0,0,,Бұл жағымсыз нәрсе.
Dialogue: 0,0:09:23.58,0:09:25.41,Default,,0,0,0,,Сәлем! Сен не істеп жатырсың?
Dialogue: 0,0:09:25.50,0:09:26.75,Default,,0,0,0,,Сіздің басыңыз жоғары.
Dialogue: 0,0:09:26.83,0:09:29.62,Default,,0,0,0,,Мұнда басыңыз Утаяма мырза, Бас директор Ооку
Dialogue: 0,0:09:29.70,0:09:32.91,Default,,0,0,0,,Ал сізді сот шамының түймесі қарсы алады!
Dialogue: 0,0:09:33.00,0:09:34.37,Default,,0,0,0,,Авашима мырза
Dialogue: 0,0:09:34.45,0:09:38.25,Default,,0,0,0,,Мінезі жақсы жаңадан келген сияқты.
Dialogue: 0,0:09:38.75,0:09:40.66,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:09:40.75,0:09:43.66,Default,,0,0,0,,Жұмысқа дайын емес сияқтысыз.
Dialogue: 0,0:09:43.75,0:09:45.12,Default,,0,0,0,,Гууууууу...
Dialogue: 0,0:09:45.20,0:09:48.66,Default,,0,0,0,,Мен өз өмірімді жұмысыма арнауға дайынмын.
Dialogue: 0,0:09:50.45,0:09:54.83,Default,,0,0,0,,Ооку сізді қанағаттандыратын орын емес.
Dialogue: 0,0:09:54.91,0:09:56.33,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:56.41,0:09:58.83,Default,,0,0,0,,Утаяма мырзамен сөйлесу!
Dialogue: 0,0:09:58.91,0:10:00.50,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:10:00.58,0:10:05.95,Default,,0,0,0,,Өз пікіріңізді ұстанудың орнына Окуға үлес қосыңыз.
Dialogue: 0,0:10:06.04,0:10:09.04,Default,,0,0,0,,Сондықтан сіз бен біз осындамыз.
Dialogue: 0,0:10:09.62,0:10:14.62,Default,,0,0,0,,Сіз өз рөліңізді орындай отырып, сіз жоғарыдан көре аласыз.
Dialogue: 0,0:10:16.20,0:10:17.79,Default,,0,0,0,,Қымбат болғандықтан...
Dialogue: 0,0:10:18.54,0:10:20.33,Default,,0,0,0,,Уақыты келгенде
Dialogue: 0,0:10:20.41,0:10:24.16,Default,,0,0,0,,Кеудемдегі сезімнің елеусіз екенін
Dialogue: 0,0:10:24.25,0:10:25.33,Default,,0,0,0,,Байқау керек
Dialogue: 0,0:10:25.41,0:10:29.08,Default,,0,0,0,,Мен мұны тағы бір рет есте ұстаймын.
Dialogue: 0,0:10:29.66,0:10:31.95,Default,,0,0,0,,Утаяма мырза, кеттік.
Dialogue: 0,0:10:32.45,0:10:35.29,Default,,0,0,0,,Сізді күту жаман.
Dialogue: 0,0:10:35.87,0:10:39.37,Default,,0,0,0,,Мугия-сан, тым ынталы болма.
Dialogue: 0,0:10:39.45,0:10:40.87,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:10:40.95,0:10:42.50,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:10:46.00,0:10:47.08,Default,,0,0,0,,Лорд Сакашита
Dialogue: 0,0:10:47.16,0:10:48.20,Default,,0,0,0,,(Барлығы) Ах… (Алтыншы Төменгі Ай) Ол қозғалды!
Dialogue: 0,0:10:48.29,0:10:50.91,Default,,0,0,0,,Бұл қарбалас қандай мереке туралы?
Dialogue: 0,0:10:51.00,0:10:52.75,Default,,0,0,0,,Мочихики туралы білмей келдің бе?
Dialogue: 0,0:10:53.95,0:10:56.75,Default,,0,0,0,,Пайдалы әңгіменің иісі шықты.
Dialogue: 0,0:10:56.83,0:10:57.75,Default,,0,0,0,,Гааах!
Dialogue: 0,0:10:58.25,0:11:00.50,Default,,0,0,0,,Оның заңды әйелі Сачико
Dialogue: 0,0:11:00.58,0:11:04.04,Default,,0,0,0,,Ол Аспан Ұлын дүниеге әкелді.
Dialogue: 0,0:11:04.12,0:11:07.70,Default,,0,0,0,,Бұл ризашылық фестивалі, сонымен қатар оның мерекесі ретінде қызмет етеді.
Dialogue: 0,0:11:07.79,0:11:12.95,Default,,0,0,0,,Мочихики туралы айтатын болсақ, бұл босанғанға дейін жасалатын нәрсе емес пе?
Dialogue: 0,0:11:13.04,0:11:15.00,Default,,0,0,0,,Сіз! Яғни...
Dialogue: 0,0:11:15.95,0:11:17.79,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:11:20.62,0:11:23.00,Default,,0,0,0,,Жақында Утаяма мырза келеді.
Dialogue: 0,0:11:23.08,0:11:25.04,Default,,0,0,0,,Бұл! Өтінемін тоқта
Dialogue: 0,0:11:25.12,0:11:27.00,Default,,0,0,0,,Бұл Утаяма мырзаныкі... Ах!
Dialogue: 0,0:11:27.08,0:11:28.95,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:30.50,0:11:31.66,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:31.75,0:11:34.16,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:11:34.25,0:11:38.08,Default,,0,0,0,,Менің атым Сабуромару Токита, ал бұл Хеймото Сага.
Dialogue: 0,0:11:38.16,0:11:39.83,Default,,0,0,0,,Біз де жаңа ғана келдік.
Dialogue: 0,0:11:40.50,0:11:44.04,Default,,0,0,0,,Екі ай бұрын мен үлкен мочи хики неге кейінге қалдырылғанын білгім келеді.
Dialogue: 0,0:11:44.12,0:11:45.62,Default,,0,0,0,,Сіз бәрін маған қалдыра аласыз деп үміттенемін.
Dialogue: 0,0:11:45.70,0:11:49.12,Default,,0,0,0,,Бізді сізге жалғыз қалдыра алмайтындықтан шақырды.
Dialogue: 0,0:11:49.20,0:11:51.58,Default,,0,0,0,,Баяндамада айтылғандай
Dialogue: 0,0:11:51.66,0:11:54.58,Default,,0,0,0,,«Дайындықтың жоқтығынан» бір өзі айтпаса керек.
Dialogue: 0,0:11:54.66,0:11:58.25,Default,,0,0,0,,Бұл мәселені Роджуку Отомо-самаға хабарлаңыз.
Dialogue: 0,0:11:58.33,0:12:02.50,Default,,0,0,0,,Маған онымен тек Окуда ғана айналысу керектігін айтты.
Dialogue: 0,0:12:02.58,0:12:04.08,Default,,0,0,0,,Бұл Отомо-сама!
Dialogue: 0,0:12:04.66,0:12:08.87,Default,,0,0,0,,Менің атым Түймешік, мен Отомо үйінің Оку қаласында тұрамын.
Dialogue: 0,0:12:09.83,0:12:13.41,Default,,0,0,0,,Сачиконың босану кезінде көп қиналғаны айтылады.
Dialogue: 0,0:12:13.50,0:12:15.25,Default,,0,0,0,,Ол таусылды.
Dialogue: 0,0:12:15.33,0:12:17.95,Default,,0,0,0,,Екі ай бұрын мочи-хики рәсімі өтті.
Dialogue: 0,0:12:18.04,0:12:20.79,Default,,0,0,0,,Кейбіреулер мұны істей алмағандықтан болуы мүмкін дейді.
Dialogue: 0,0:12:20.87,0:12:24.41,Default,,0,0,0,,Басқаша айтқанда, Утаяма мырза, бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:12:24.50,0:12:26.29,Default,,0,0,0,,Мен бұл туралы жақсы білемін
Dialogue: 0,0:12:26.37,0:12:31.66,Default,,0,0,0,,Сондықтан бұл әдеттен тыс болса да, біз рәсімді бала туғаннан кейін өткізуді шештік.
Dialogue: 0,0:12:31.75,0:12:34.33,Default,,0,0,0,,Біздің міндетіміз - Оокуды қадағалау.
Dialogue: 0,0:12:34.41,0:12:38.79,Default,,0,0,0,,Ішкі сарай көктің баласыдікі, қадіріңді біл.
Dialogue: 0,0:12:38.87,0:12:40.75,Default,,0,0,0,,Бұл үшін кешіріңіз
Dialogue: 0,0:12:40.83,0:12:43.45,Default,,0,0,0,,Ұлы Мочи-хики ешқандай ақаусыз өтеді деп үміттенеміз.
Dialogue: 0,0:12:43.54,0:12:46.87,Default,,0,0,0,,Бақылау үшін Кестеден пайдаланылады
Dialogue: 0,0:12:46.95,0:12:49.70,Default,,0,0,0,,Мұны Отомо-самадан да естігеніңізге сенімдімін.
Dialogue: 0,0:12:50.50,0:12:51.66,Default,,0,0,0,,Әрине.
Dialogue: 0,0:12:51.75,0:12:53.33,Default,,0,0,0,,Бірақ сонымен бірге жосықсыз қулық.
Dialogue: 0,0:12:53.41,0:12:56.20,Default,,0,0,0,,Сондай-ақ қызметшіні таңдамай шақыруға болады.
Dialogue: 0,0:12:56.29,0:12:58.54,Default,,0,0,0,,аулақ болыңыз
Dialogue: 0,0:13:00.20,0:13:01.16,Default,,0,0,0,,Гах...
Dialogue: 0,0:13:01.25,0:13:06.12,Default,,0,0,0,,Бұл әдетте ер адамдарға тыйым салынған қаланың ең ішкі бөлігі!
Dialogue: 0,0:13:06.62,0:13:08.91,Default,,0,0,0,,Міндет қандай болса да
Dialogue: 0,0:13:09.00,0:13:12.83,Default,,0,0,0,,Ережені бұзған адам жазаланады.
Dialogue: 0,0:13:14.87,0:13:18.79,Default,,0,0,0,,Енді ертеңнен бастап өз міндеттеріңді орындауға дайындал.
Dialogue: 0,0:13:19.29,0:13:20.54,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:13:26.62,0:13:27.75,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:13:33.83,0:13:35.33,Default,,0,0,0,,Шынымен де, осы бейнеойынды жақында өшіргенің жөн —
Dialogue: 0,0:13:35.41,0:13:37.75,Default,,0,0,0,,Сума шөлдеді
Dialogue: 0,0:13:37.83,0:13:38.66,Default,,0,0,0,,Шөлдеген жоқ
Dialogue: 0,0:13:38.75,0:13:40.87,Default,,0,0,0,,Киё де шөлдеді.
Dialogue: 0,0:13:40.95,0:13:42.20,Default,,0,0,0,,Шөлдеген жоқ
Dialogue: 0,0:13:43.75,0:13:46.16,Default,,0,0,0,,Сарымсақ шөлдеген жоқ.
Dialogue: 0,0:13:46.25,0:13:47.45,Default,,0,0,0,,Отогибозу
Dialogue: 0,0:13:47.54,0:13:48.50,Default,,0,0,0,,Хяи
Dialogue: 0,0:13:48.58,0:13:50.16,Default,,0,0,0,,Мен шөлдедім
Dialogue: 0,0:13:51.12,0:13:52.66,Default,,0,0,0,,Қайта кездескенше, Фуки-сама.
Dialogue: 0,0:13:52.75,0:13:56.66,Default,,0,0,0,,Оған да көп күш салайық, Тенши мырза.
Dialogue: 0,0:14:01.33,0:14:06.16,Default,,0,0,0,,Оокуда шамамен 2000 қызметші жұмыс істейді.
Dialogue: 0,0:14:06.75,0:14:10.25,Default,,0,0,0,,Күн шыққанға дейін барлығына таңғы ас дайында
Dialogue: 0,0:14:10.83,0:14:13.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:13.70,0:14:14.87,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:15.83,0:14:18.66,Default,,0,0,0,,Сондай-ақ... Кешіріңіз.
Dialogue: 0,0:14:19.62,0:14:23.75,Default,,0,0,0,,Алдымен төртінші жақтағы 50 адамға дайындаламын.
Dialogue: 0,0:14:23.83,0:14:26.20,Default,,0,0,0,,Үйренген соң 100 адамға дейін көбейтемін, ниетім сол.
Dialogue: 0,0:14:26.29,0:14:28.08,Default,,0,0,0,,100 адам?
Dialogue: 0,0:14:28.70,0:14:32.20,Default,,0,0,0,,Оған дейін таңғы асымызды бітірейік.
Dialogue: 0,0:14:32.87,0:14:34.29,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:34.87,0:14:36.62,Default,,0,0,0,,Аса-чан қолжазбаға шебер.
Dialogue: 0,0:14:37.20,0:14:40.33,Default,,0,0,0,,Күн шыққанға дейін неше сағат?
Dialogue: 0,0:14:40.95,0:14:44.16,Default,,0,0,0,,Мен де күн сайын көршілеріме дайындайтынмын.
Dialogue: 0,0:14:44.25,0:14:45.62,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,0:14:46.95,0:14:50.37,Default,,0,0,0,,Мен ешқашан таңғы ас немесе басқа ештеңе дайындаған емеспін.
Dialogue: 0,0:14:55.58,0:14:59.16,Default,,0,0,0,,Сабуромару-доно - бас министр Фуки-саманың інісі.
Dialogue: 0,0:14:59.25,0:15:01.62,Default,,0,0,0,,Оны Токита әулетінің үшінші ұлы дейді.
Dialogue: 0,0:15:02.20,0:15:03.66,Default,,0,0,0,,Ештеңе өзгермейді
Dialogue: 0,0:15:03.75,0:15:06.95,Default,,0,0,0,,Мочихикиге дайындықты тыныш жалғастырыңыз.
Dialogue: 0,0:15:07.04,0:15:10.20,Default,,0,0,0,,Токита отбасы қазір күшті.
Dialogue: 0,0:15:10.29,0:15:14.66,Default,,0,0,0,,Мен сізге қажетсіз материалдарды бермеуімді қалаймын, өйткені сіз тым көп жұмыс жасайсыз.
Dialogue: 0,0:15:14.75,0:15:17.04,Default,,0,0,0,,Отомо отбасының мүшесі ретінде
Dialogue: 0,0:15:17.12,0:15:21.16,Default,,0,0,0,,Құрметті Утаяма-сама, Отомо отбасының қорғауында.
Dialogue: 0,0:15:21.25,0:15:25.16,Default,,0,0,0,,Оларға жұмысты орындағандай сезіну
Dialogue: 0,0:15:28.12,0:15:31.16,Default,,0,0,0,,Екеуінің жағдайы үшінші бөлме.
Dialogue: 0,0:15:31.25,0:15:33.75,Default,,0,0,0,,Сіз екінші қабаттағы бөлмеде ұйықтайсыз.
Dialogue: 0,0:15:34.25,0:15:35.75,Default,,0,0,0,,Бұл лорд Авашимаға елші ретінде тағайындалған қызметшісі.
Dialogue: 0,0:15:35.75,0:15:37.70,Default,,0,0,0,,Бұл лорд Авашиманың оған елші ретінде тағайындалған қызметшісі.
Dialogue: 0,0:15:35.75,0:15:37.70,Default,,0,0,0,,2000 адам ~
Dialogue: 0,0:15:37.70,0:15:37.91,Default,,0,0,0,,2000 адам ~
Dialogue: 0,0:15:38.00,0:15:38.41,Default,,0,0,0,,Олардың арасында Көк Ұлының жанында қызмет етіңіз.
Dialogue: 0,0:15:38.41,0:15:40.04,Default,,0,0,0,,Олардың арасында Көк Ұлының жанында қызмет етіңіз.
Dialogue: 0,0:15:38.41,0:15:40.04,Default,,0,0,0,,Жұмыста ұқыпты бол
Dialogue: 0,0:15:40.04,0:15:40.12,Default,,0,0,0,,Олардың арасында Көк Ұлының жанында қызмет етіңіз.
Dialogue: 0,0:15:40.12,0:15:40.50,Default,,0,0,0,,Олардың арасында Көк Ұлының жанында қызмет ет.
Dialogue: 0,0:15:40.12,0:15:40.50,Default,,0,0,0,,Иә, мен көп жұмыс істеймін.
Dialogue: 0,0:15:40.50,0:15:40.58,Default,,0,0,0,,Иә, мен көп жұмыс істеймін.
Dialogue: 0,0:15:40.58,0:15:42.00,Default,,0,0,0,,Иә, мен көп жұмыс істеймін.
Dialogue: 0,0:15:40.58,0:15:42.00,Default,,0,0,0,,Очуто ұясында небәрі 8 адам бар.
Dialogue: 0,0:15:42.00,0:15:43.25,Default,,0,0,0,,Очуто ұясында тек 8 адам бар.
Dialogue: 0,0:15:43.33,0:15:44.75,Default,,0,0,0,,Тазалау, футонды қою және түсіру сияқты нәрселерді жасауға дайын болыңыз.
Dialogue: 0,0:15:44.75,0:15:46.70,Default,,0,0,0,,Тазалау, футонды қою және түсіру сияқты нәрселерді жасауға дайын болыңыз.
Dialogue: 0,0:15:44.75,0:15:46.70,Default,,0,0,0,,Мың мильдік жол бар болғаны бір қадам
Dialogue: 0,0:15:46.79,0:15:47.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.37,0:15:49.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:50.50,0:15:51.25,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.00,0:15:58.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:58.20,0:16:01.70,Default,,0,0,0,,Құрметті сот мүшелері, маған жол беріңіздер.
Dialogue: 0,0:16:03.04,0:16:06.50,Default,,0,0,0,,Сарымсақ толықтыратын гүлдейміз.
Dialogue: 0,0:16:06.58,0:16:08.25,Default,,0,0,0,,Бұл Очуто-сама!
Dialogue: 0,0:16:08.33,0:16:09.54,Default,,0,0,0,,Аспан Ұлы
Dialogue: 0,0:16:09.62,0:16:12.87,Default,,0,0,0,,Сізді тек Офуки-сама қызықтыратын сияқты.
Dialogue: 0,0:16:12.95,0:16:14.62,Default,,0,0,0,,Мені естімедің бе?
Dialogue: 0,0:16:14.70,0:16:16.37,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:16:16.45,0:16:20.33,Default,,0,0,0,,Мен де сенің қалауыңмен гүл тергеніңді қалаймын.
Dialogue: 0,0:16:20.41,0:16:22.00,Default,,0,0,0,,Аспан Ұлы
Dialogue: 0,0:16:22.08,0:16:25.75,Default,,0,0,0,,Мен әлі бүршік болып жатқанда ол мені шақырды.
Dialogue: 0,0:16:25.83,0:16:28.79,Default,,0,0,0,,Мен сенемін, бәрің...
Dialogue: 0,0:16:28.87,0:16:30.45,Default,,0,0,0,,О... Офуки-сама!
Dialogue: 0,0:16:31.16,0:16:31.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.87,0:16:33.12,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:16:33.62,0:16:36.12,Default,,0,0,0,,Не... қандай әдемі
Dialogue: 0,0:16:37.91,0:16:39.79,Default,,0,0,0,,Сіз жаңадан келгенсіз бе?
Dialogue: 0,0:16:39.87,0:16:42.20,Default,,0,0,0,,Иә! Менің атым Каме.
Dialogue: 0,0:16:42.70,0:16:44.62,Default,,0,0,0,,Хэхехе Қайырлы күн
Dialogue: 0,0:16:44.70,0:16:45.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.04,0:16:47.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:47.79,0:16:48.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:48.70,0:16:50.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:00.29,0:17:03.16,Default,,0,0,0,,Мұнайды қашанға дейін сатасың?
Dialogue: 0,0:17:03.25,0:17:04.62,Default,,0,0,0,,Мен оны қазір жабамын!
Dialogue: 0,0:17:06.70,0:17:10.12,Default,,0,0,0,,Дәріден басқа заттарды да сатамыз.
Dialogue: 0,0:17:10.62,0:17:12.00,Default,,0,0,0,,Өкінішке орай, мұнай...
Dialogue: 0,0:17:12.08,0:17:14.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:15.50,0:17:17.04,Default,,0,0,0,,Сіз ішпейсіз бе?
Dialogue: 0,0:17:17.12,0:17:18.08,Default,,0,0,0,,О
Dialogue: 0,0:17:18.16,0:17:20.54,Default,,0,0,0,,Мен бұл міндет біткенше ішпеуді шештім.
Dialogue: 0,0:17:20.62,0:17:23.16,Default,,0,0,0,,Сіз қызықсыз адамсыз, сэр.
Dialogue: 0,0:17:23.25,0:17:26.75,Default,,0,0,0,,Бұл миссия мен күткеннен де қиын болуы мүмкін.
Dialogue: 0,0:17:26.83,0:17:27.41,Default,,0,0,0,,Әдемі нагоға қарасаңыз болғаны.
Dialogue: 0,0:17:27.41,0:17:29.83,Default,,0,0,0,,Әдемі нагоға қарасаңыз болғаны.
Dialogue: 0,0:17:27.41,0:17:29.83,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:32.66,0:17:33.95,Default,,0,0,0,,Бұл пайдалы болар еді
Dialogue: 0,0:17:34.04,0:17:36.16,Default,,0,0,0,,Оку - жәннат мұрагерінің ұлын туатын жер ғана емес.
Dialogue: 0,0:17:36.16,0:17:38.33,Default,,0,0,0,,Ооку – жәннат мұрагерінің ұлын туатын жер ғана емес.
Dialogue: 0,0:17:36.16,0:17:38.33,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:38.33,0:17:38.41,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:38.41,0:17:39.04,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:38.41,0:17:39.04,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:17:39.04,0:17:40.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:17:40.08,0:17:42.33,Default,,0,0,0,,Сегунат үкіметі мен Ооку бір тиынның екі жағы.
Dialogue: 0,0:17:42.33,0:17:43.25,Default,,0,0,0,,Сегунат үкіметі мен Оку - бір тиынның екі жағы.
Dialogue: 0,0:17:42.33,0:17:43.25,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:43.25,0:17:43.33,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:43.33,0:17:46.33,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:43.33,0:17:46.33,Default,,0,0,0,,Немаваши мұндағы кестедегі қуат қатынасын сақтайды.
Dialogue: 0,0:17:46.33,0:17:46.91,Default,,0,0,0,,Немаваши мұндағы кестедегі қуат қатынасын сақтайды.
Dialogue: 0,0:17:47.00,0:17:50.00,Default,,0,0,0,,Үкімет алдында табысқа жетпеген сияқты.
Dialogue: 0,0:17:50.08,0:17:52.45,Default,,0,0,0,,Қызық, Ооку не үшін керек?
Dialogue: 0,0:17:52.54,0:17:55.87,Default,,0,0,0,,Ой, апаң туралы жаман сөз айтқан жоқпын.
Dialogue: 0,0:17:56.45,0:17:58.79,Default,,0,0,0,,Біздің міндетіміз мочихикиді бақылау.
Dialogue: 0,0:17:58.87,0:17:59.37,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:59.37,0:18:01.95,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:17:59.37,0:18:01.95,Default,,0,0,0,,Алдындағы адамдардың нысанасы - Утаяма-доно.
Dialogue: 0,0:18:01.95,0:18:02.04,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:02.04,0:18:02.58,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:02.04,0:18:02.58,Default,,0,0,0,,Әлгі кемпір...
Dialogue: 0,0:18:02.58,0:18:03.50,Default,,0,0,0,,Әлгі кемпір...
Dialogue: 0,0:18:04.79,0:18:05.75,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:18:07.54,0:18:08.83,Default,,0,0,0,,Алдыңғы ниет артта
Dialogue: 0,0:18:08.91,0:18:11.50,Default,,0,0,0,,I understand what it means to be difficult to reach.
Dialogue: 0,0:18:08.91,0:18:11.50,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:11.50,0:18:12.33,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:12.41,0:18:16.70,Default,,0,0,0,,That's probably why they want to reduce Utayama-dono's influence.
Dialogue: 0,0:18:20.33,0:18:22.79,Default,,0,0,0,,You seem to think you're the one running the world.
Dialogue: 0,0:18:22.87,0:18:24.87,Default,,0,0,0,,Маған сенің жүзің ұнамайды.
Dialogue: 0,0:18:25.75,0:18:26.95,Default,,0,0,0,,The third son of the Tokita family is also in trouble.
Dialogue: 0,0:18:26.95,0:18:28.12,Default,,0,0,0,,The third son of the Tokita family is also in trouble.
Dialogue: 0,0:18:26.95,0:18:28.12,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:28.12,0:18:28.66,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:28.66,0:18:31.58,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:18:28.66,0:18:31.58,Default,,0,0,0,,Thanks to Fuki-dono, I was able to get this job.
Dialogue: 0,0:18:31.66,0:18:34.87,Default,,0,0,0,,Жақсы нәтиже беруі керек
Dialogue: 0,0:18:35.41,0:18:38.79,Default,,0,0,0,,Two months ago The reason why the Mochihiki was postponed
Dialogue: 0,0:18:39.95,0:18:41.16,Default,,0,0,0,,Бір нәрсе болуы керек
Dialogue: 0,0:18:41.75,0:18:46.16,Default,,0,0,0,,Utayama-dono may have held Пауэр for too long in Ooku.
Dialogue: 0,0:18:47.66,0:18:48.37,Default,,0,0,0,,Эй
Dialogue: 0,0:18:48.87,0:18:50.75,Default,,0,0,0,,Бұл судың иісі болмады ма?
Dialogue: 0,0:18:51.33,0:18:52.41,Default,,0,0,0,,Иә
Dialogue: 0,0:18:52.95,0:18:55.08,Default,,0,0,0,,Балықтың иісі шықты, солай емес пе?
Dialogue: 0,0:18:56.37,0:18:57.75,Default,,0,0,0,,Авашима-сама және т.б
Dialogue: 0,0:18:58.41,0:19:01.87,Default,,0,0,0,,Қалайша сабырмен ішесің?
Dialogue: 0,0:19:01.95,0:19:03.08,Default,,0,0,0,,Өрт көзі!
Dialogue: 0,0:19:03.16,0:19:05.50,Default,,0,0,0,,Өрт көзі!
Dialogue: 0,0:19:05.58,0:19:08.16,Default,,0,0,0,,Бұл Көк Ұлына арналғандықтан ба?
Dialogue: 0,0:19:09.58,0:19:10.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.08,0:19:15.33,Default,,0,0,0,,I want to become a patron like Ofuki-sama soon.
Dialogue: 0,0:19:17.50,0:19:19.33,Default,,0,0,0,,Ол әдемі адам еді.
Dialogue: 0,0:19:23.70,0:19:26.91,Default,,0,0,0,,Мен бүгін Офуки-самадан өткенде
Dialogue: 0,0:19:27.00,0:19:29.62,Default,,0,0,0,,Mugiya-sama's eyes were shining too.
Dialogue: 0,0:19:29.70,0:19:30.75,Default,,0,0,0,,Біз енді ешқашан кездеспейміз.
Dialogue: 0,0:19:30.83,0:19:33.00,Default,,0,0,0,,Кя~! Бұл Офуки-сама
Dialogue: 0,0:19:33.58,0:19:34.79,Default,,0,0,0,,Таза
Dialogue: 0,0:19:34.87,0:19:37.54,Default,,0,0,0,,Барлық меценаттар әдемі.
Dialogue: 0,0:19:38.04,0:19:39.54,Default,,0,0,0,,Бұл Аса Чанға қатысты емес пе?
Dialogue: 0,0:19:40.29,0:19:41.41,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:42.87,0:19:44.75,Default,,0,0,0,,Керемет гочутодан
Dialogue: 0,0:19:45.33,0:19:47.58,Default,,0,0,0,,Сіз жұмысқа тұрғыңыз келе ме?
Dialogue: 0,0:19:48.08,0:19:52.58,Default,,0,0,0,,Менің ендігі мақсатым шебер ретінде қызмет ету деп ойлаймын.
Dialogue: 0,0:19:55.29,0:19:58.54,Default,,0,0,0,,Recently, Tenshi-sama's message to Fuki-sama
Dialogue: 0,0:19:58.62,0:20:01.04,Default,,0,0,0,,When it comes to heat...
Dialogue: 0,0:20:01.62,0:20:05.12,Default,,0,0,0,,Because Sachiko-sama's child was also a princess.
Dialogue: 0,0:20:05.70,0:20:09.37,Default,,0,0,0,,Офуки-сама мұны өте жақсы меңгерген болуы керек.
Dialogue: 0,0:20:10.00,0:20:14.29,Default,,0,0,0,,If things continue like this, the son of heaven's successor will be...
Dialogue: 0,0:20:17.37,0:20:22.04,Default,,0,0,0,,Аса-чан бәріне шебер сияқты.
Dialogue: 0,0:20:22.70,0:20:25.91,Default,,0,0,0,,Мен оны Оокуда жасай алатыныма сенімді емеспін.
Dialogue: 0,0:20:26.70,0:20:30.25,Default,,0,0,0,,Жарайды, бәріміз бірге жасайық.
Dialogue: 0,0:20:31.04,0:20:33.37,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:20:33.95,0:20:35.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:40.75,0:20:43.25,Default,,0,0,0,,Сачико-самадан бері көп уақыт өтті
Dialogue: 0,0:20:44.29,0:20:47.50,Default,,0,0,0,,Офуки-саманың импульсі арта береді.
Dialogue: 0,0:20:48.20,0:20:50.08,Default,,0,0,0,,Отомо мырза түймесі...
Dialogue: 0,0:20:50.79,0:20:53.50,Default,,0,0,0,,Сізді Яга қызықтырмайтын сияқты.
Dialogue: 0,0:20:55.83,0:20:57.54,Default,,0,0,0,,Аса-чан!
Dialogue: 0,0:20:57.62,0:20:58.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.00,0:21:00.95,Default,,0,0,0,,Жоқ... Уф...
Dialogue: 0,0:21:01.45,0:21:03.75,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:21:04.45,0:21:04.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:05.54,0:21:06.75,Default,,0,0,0,,-Ах - (Тенши) Ммм
Dialogue: 0,0:21:09.20,0:21:12.41,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:21:16.29,0:21:17.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:19.45,0:21:23.50,Default,,0,0,0,,Аса Чанмен танысқаныма өте қуаныштымын.
Dialogue: 0,0:21:24.66,0:21:26.12,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:21:33.87,0:21:36.83,Default,,0,0,0,,Ертең ерте, сондықтан мен ұйықтауым керек.
Dialogue: 0,0:21:36.91,0:21:39.00,Default,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 0,0:21:39.08,0:21:40.25,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:21:45.45,0:21:47.66,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:54.41,0:21:55.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:56.83,0:21:59.58,Default,,0,0,0,,Уф... Ууууу...
Dialogue: 0,0:22:00.08,0:22:02.20,Default,,0,0,0,,Ах... Ахахха
Dialogue: 0,0:22:02.29,0:22:03.75,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:22:05.00,0:22:06.79,Default,,0,0,0,,Куууу…
Dialogue: 0,0:22:17.08,0:22:21.00,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:22:22.29,0:22:27.95,Default,,0,0,0,,Бәле, күнә, арамдық
Dialogue: 0,0:22:28.91,0:22:33.00,Default,,0,0,0,,Жын шығару төлеміне
Dialogue: 0,0:22:34.45,0:22:38.20,Default,,0,0,0,,Тазалау қызметіне
Dialogue: 0,0:22:40.37,0:22:44.16,Default,,0,0,0,,Көктегі
Dialogue: 0,0:22:44.79,0:22:48.16,Default,,0,0,0,,Лорд Мизу ұшқындарды ұнатпайды.
Dialogue: 0,0:22:49.45,0:22:50.62,Default,,0,0,0,,Ой
Dialogue: 0,0:22:52.20,0:22:57.20,Default,,0,0,0,,Бақытқа
Dialogue: 0,0:22:58.16,0:22:59.75,Default,,0,0,0,,(Ай мен Ай күлкі)
Dialogue: 0,0:22:59.83,0:23:00.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:00.79,0:23:02.29,Default,,0,0,0,,Иә~
Dialogue: 0,0:23:14.16,0:23:14.83,Default,,0,0,0,,О...
Dialogue: 0,0:23:23.37,0:23:24.75,Default,,0,0,0,,Утаяма мырза
Dialogue: 0,0:23:25.91,0:23:27.62,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:23:28.54,0:23:30.37,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:23:32.12,0:23:37.87,Default,,0,0,0,,Жақында кейінге қалдырылған Омочи Хикиге енді 3 күн қалды.
Dialogue: 0,0:23:37.95,0:23:38.70,Default,,0,0,0,,Эххе
Dialogue: 0,0:23:38.79,0:23:41.83,Default,,0,0,0,,Бұл күні көптеген тұтынушылар болады.
Dialogue: 0,0:23:41.91,0:23:44.54,Default,,0,0,0,,Санаулы күндер қалды
Dialogue: 0,0:23:44.62,0:23:48.91,Default,,0,0,0,,Мен әркім өзін-өзі дайындап, дайындалғанын қалаймын.
Dialogue: 0,0:23:50.62,0:23:52.58,Default,,0,0,0,,Оного да рұқсатсыз...
Dialogue: 0,0:23:52.66,0:23:55.91,Default,,0,0,0,,Мен Омочи Хикиге арналған мерекелік заттарды осында сақтаймын!
Dialogue: 0,0:23:56.00,0:23:57.62,Default,,0,0,0,,Оокуда ер адамдарға рұқсат етілмейді
Dialogue: 0,0:23:57.70,0:23:59.04,Default,,0,0,0,,Тәртіп бойынша сапқа тұрыңыз!
Dialogue: 0,0:23:59.12,0:24:02.00,Default,,0,0,0,,Әлі алыс па?
Dialogue: 0,0:24:03.04,0:24:06.25,Default,,0,0,0,,Омочи Хики кезінде персонал туралы ақпаратты жариялаңыз
Dialogue: 0,0:24:07.16,0:24:11.29,Default,,0,0,0,,Мен бұл жолы үлкен мочи-хикиді ұйымдастыруды Авашимаға қалдырамын.
Dialogue: 0,0:24:11.37,0:24:16.12,Default,,0,0,0,,Авасима дәрежесіне елші сәлем береді.
Dialogue: 0,0:24:16.20,0:24:21.33,Default,,0,0,0,,Безендіруден бастап, тамақ пен сусындарды реттеуге дейін барлығын шебер орындау керек.
Dialogue: 0,0:24:21.83,0:24:25.25,Default,,0,0,0,,Барлығы Авашиманың қол астында.
Dialogue: 0,0:24:25.33,0:24:29.75,Default,,0,0,0,,Осы Омочи Хикиде 100-ден астам қатысушы болады.
Dialogue: 0,0:24:29.83,0:24:33.08,Default,,0,0,0,,Орындарды жөнелту туралы ақпаратқа дейін реттеу
Dialogue: 0,0:24:33.16,0:24:35.08,Default,,0,0,0,,Ешқандай қалдыру болмауы керек
Dialogue: 0,0:24:35.16,0:24:39.12,Default,,0,0,0,,Мугия дәрежесі келесілерден елші болып тағайындалды.
Dialogue: 0,0:24:39.20,0:24:41.50,Default,,0,0,0,,Осы тапсырманы орындауыңызды сұраймын.
Dialogue: 0,0:24:42.50,0:24:45.20,Default,,0,0,0,,Сондай-ақ Мугияның қамқоршысы ретінде
Dialogue: 0,0:24:45.29,0:24:49.75,Default,,0,0,0,,Сегунаттағы негізгі тұлғалар мен әртүрлі феодалдар арасындағы билік қатынастарымен таныс.
Dialogue: 0,0:24:49.83,0:24:52.62,Default,,0,0,0,,Сот стендінің Otomo стендіне ие болыңыз.
Dialogue: 0,0:24:54.04,0:24:57.20,Default,,0,0,0,,Мугия әдепті Отомодан үйренді.
Dialogue: 0,0:24:57.29,0:24:58.66,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:24:58.75,0:25:01.83,Default,,0,0,0,,Ал мен кеше ғана бастадым.
Dialogue: 0,0:25:01.91,0:25:04.25,Default,,0,0,0,,Менің де Асадан сұрайтыным бар.
Dialogue: 0,0:25:04.75,0:25:05.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:05.50,0:25:07.87,Default,,0,0,0,,Сегунаттың күзетшісі —
Dialogue: 0,0:25:07.95,0:25:12.95,Default,,0,0,0,,Ол Токита Сабуромару мен Сагахира Мотодоноға арналған нұсқаулық.
Dialogue: 0,0:25:15.25,0:25:16.45,Default,,0,0,0,,Бұл әдеттен тыс болса да...
Dialogue: 0,0:25:17.04,0:25:17.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:17.87,0:25:20.41,Default,,0,0,0,,Келесі дәрежені Асаға беріңіз
Dialogue: 0,0:25:20.91,0:25:23.25,Default,,0,0,0,,- (Утаяма) Екеуіңізге бірдеңе айтайын ба? -(Хирамото) Иә?
Dialogue: 0,0:25:24.25,0:25:26.12,Default,,0,0,0,,Аса-чан, сен істедің.
Dialogue: 0,0:25:26.79,0:25:29.04,Default,,0,0,0,,Менің атым Сабуромару Токита.
Dialogue: 0,0:25:29.66,0:25:32.37,Default,,0,0,0,,Аса-доно, ыңғайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:25:34.04,0:25:35.87,Default,,0,0,0,,-Ол қандай жеңіл сезім? - Токита, мүмкін?
Dialogue: 0,0:25:35.95,0:25:36.83,Default,,0,0,0,,Офуки-саманың?
Dialogue: 0,0:25:36.91,0:25:40.50,Default,,0,0,0,,Толық жеке нұсқауларды кейінірек беріңіз.
Dialogue: 0,0:25:40.58,0:25:42.00,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:25:42.08,0:25:46.16,Default,,0,0,0,,Екеуіңіз үлкен мочи хикиге дайындыққа сенімдісіз бе?
Dialogue: 0,0:25:46.25,0:25:50.70,Default,,0,0,0,,Сіз ер адамдарға тыйым салынған үйдің ең ішкі бөлігіне келу үшін жолыңыздан шықтыңыз.
Dialogue: 0,0:25:52.16,0:25:52.87,Default,,0,0,0,,А… арыстан!
Dialogue: 0,0:25:52.95,0:25:53.87,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:25:53.95,0:25:55.62,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:25:56.41,0:25:59.54,Default,,0,0,0,,Аса, қадағалайтын ештеңе жоқ.
Dialogue: 0,0:25:59.62,0:26:01.50,Default,,0,0,0,,Түсіну үшін
Dialogue: 0,0:26:01.58,0:26:04.66,Default,,0,0,0,,Серіктесіңізге жақсы қарым-қатынас жасаңыз.
Dialogue: 0,0:26:05.33,0:26:07.16,Default,,0,0,0,,Бұл Оку!
Dialogue: 0,0:26:07.83,0:26:11.12,Default,,0,0,0,,Окуға барлығы үлес қосады
Dialogue: 0,0:26:13.29,0:26:14.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:15.79,0:26:17.50,Default,,0,0,0,,Постыңызға дереу кіріңіз
Dialogue: 0,0:26:18.00,0:26:19.75,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:26:25.83,0:26:27.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:27.37,0:26:28.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:26:31.75,0:26:36.33,Default,,0,0,0,,Аса мен тасбақаның жағдайы жақсы сияқты.
Dialogue: 0,0:26:36.95,0:26:43.16,Default,,0,0,0,,Сакашита-доно екеуің туралы не айтасыңдар?
Dialogue: 0,0:26:44.45,0:26:46.83,Default,,0,0,0,,(Артқы жағындағы баланың қозғалу дыбысы)
Dialogue: 0,0:26:47.54,0:26:50.25,Default,,0,0,0,,Аса жақсы, бірақ мен тасбақа үшін алаңдаймын.
Dialogue: 0,0:26:51.00,0:26:54.45,Default,,0,0,0,,Тым мейірімді балалар жиі тіл табыса бермейді.
Dialogue: 0,0:26:55.16,0:26:59.83,Default,,0,0,0,,Жақсы оқитын бала – оларды біраз уақытқа дейін көрмей жүретін бала.
Dialogue: 0,0:26:59.91,0:27:03.79,Default,,0,0,0,,Кейде сіз басқа адамға айналасыз.
Dialogue: 0,0:27:07.12,0:27:09.87,Default,,0,0,0,,Ах-са-чан!
Dialogue: 0,0:27:10.54,0:27:12.33,Default,,0,0,0,,Мен Оку тілін жақсы оқып жүрмін.
Dialogue: 0,0:27:12.33,0:27:13.83,Default,,0,0,0,,Мен Оку тілін жақсы оқып жүрмін.
Dialogue: 0,0:27:12.33,0:27:13.83,Default,,0,0,0,,Тасбақа-чан...
Dialogue: 0,0:27:14.75,0:27:16.50,Default,,0,0,0,,Нұсқаулық Мен сізге көмектесемін
Dialogue: 0,0:27:17.70,0:27:20.83,Default,,0,0,0,,Жұмысымды кейін қараймын.
Dialogue: 0,0:27:24.87,0:27:25.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:25.50,0:27:26.37,Default,,0,0,0,,Эй?
Dialogue: 0,0:27:28.75,0:27:31.16,Default,,0,0,0,,Уәде... солай ма?
Dialogue: 0,0:27:32.50,0:27:34.37,Default,,0,0,0,,Күні кеше ғана
Dialogue: 0,0:27:34.45,0:27:37.62,Default,,0,0,0,,Басқа адамдай болып кеткен бала болды.
Dialogue: 0,0:27:38.58,0:27:41.12,Default,,0,0,0,,Ол адам қазір ме?
Dialogue: 0,0:27:42.66,0:27:46.37,Default,,0,0,0,,Ол енді біраз демалыс алып, ауылға оралған сияқты.
Dialogue: 0,0:27:46.45,0:27:48.12,Default,,0,0,0,,«Меніңше»…
Dialogue: 0,0:27:48.20,0:27:51.58,Default,,0,0,0,,Қызметші қыздың аты кім?
Dialogue: 0,0:27:52.08,0:27:56.33,Default,,0,0,0,,Неге мен саған айтуым керек!
Dialogue: 0,0:27:58.08,0:28:00.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:01.04,0:28:03.91,Default,,0,0,0,,Бұдан былай бұл Ятога бөлмесі болады.
Dialogue: 0,0:28:04.91,0:28:07.95,Default,,0,0,0,,Кеше де осы жерден Офуки-сама өтті.
Dialogue: 0,0:28:08.04,0:28:10.20,Default,,0,0,0,,Мен сені Ягаға бара жатырмын деп ойладым...
Dialogue: 0,0:28:11.08,0:28:13.70,Default,,0,0,0,,Уф, жақсы болып барады
Dialogue: 0,0:28:13.79,0:28:15.70,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:28:16.33,0:28:17.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:28:17.79,0:28:20.62,Default,,0,0,0,,Бәрі қызық екен.
Dialogue: 0,0:28:22.04,0:28:25.25,Default,,0,0,0,,Аса-доно, Окуға келгеніңе қанша уақыт болды?
Dialogue: 0,0:28:30.12,0:28:31.50,Default,,0,0,0,,Тасбақа-чан керемет
Dialogue: 0,0:28:31.58,0:28:33.16,Default,,0,0,0,,Мен таң қалдым, өйткені ол өте егжей-тегжейлі болды.
Dialogue: 0,0:28:33.25,0:28:34.75,Default,,0,0,0,,Ах... Эхехе...
Dialogue: 0,0:28:36.04,0:28:36.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:36.95,0:28:43.04,Default,,0,0,0,,Мочи қалқымалы Оокуды айналып өтіп, ақыры осында әкелінді.
Dialogue: 0,0:28:43.12,0:28:44.58,Default,,0,0,0,,Оң қол тақырыпты жазды.
Dialogue: 0,0:28:44.66,0:28:46.04,Default,,0,0,0,,-Соңы-(Хирамото) Сабуромару
Dialogue: 0,0:28:46.12,0:28:47.95,Default,,0,0,0,,Сізге қайсысы ұнайды?
Dialogue: 0,0:28:48.91,0:28:50.37,Default,,0,0,0,,Мен жұмыстамын, сен табандысың.
Dialogue: 0,0:28:50.45,0:28:52.20,Default,,0,0,0,,Бұлай ұялмаңыз
Dialogue: 0,0:28:52.29,0:28:53.83,Default,,0,0,0,,Тыныш
Dialogue: 0,0:29:00.33,0:29:03.37,Default,,0,0,0,,Тазарту тұзы кешіктірілді.
Dialogue: 0,0:29:03.45,0:29:05.79,Default,,0,0,0,,Ауа райына байланысты кешіктірілді.
Dialogue: 0,0:29:05.87,0:29:09.50,Default,,0,0,0,,Жақын жердегі көтерме сатушыда ауыстыруды қамтамасыз етемін деп ойлаймын.
Dialogue: 0,0:29:09.58,0:29:11.45,Default,,0,0,0,,Аса солай істесін.
Dialogue: 0,0:29:12.00,0:29:13.54,Default,,0,0,0,,Асаға барғың келе ме?
Dialogue: 0,0:29:13.62,0:29:14.83,Default,,0,0,0,,Тасбақа-чан
Dialogue: 0,0:29:14.91,0:29:18.87,Default,,0,0,0,,Авашима, сенің Окуға келгеніңе қанша уақыт болды?
Dialogue: 0,0:29:18.95,0:29:20.45,Default,,0,0,0,,6 жыл.
Dialogue: 0,0:29:21.04,0:29:23.00,Default,,0,0,0,,Еркі мен қабілеті барларға
Dialogue: 0,0:29:23.08,0:29:27.08,Default,,0,0,0,,Мен сенің арқаңда сәл ауырырақ жүкті көтеруге тырыстым.
Dialogue: 0,0:29:27.66,0:29:28.91,Default,,0,0,0,,Сізге де
Dialogue: 0,0:29:29.45,0:29:32.54,Default,,0,0,0,,Дегенмен, бірінші күні сіз келесі лауазымға тағайындалуыңыз мүмкін.
Dialogue: 0,0:29:32.62,0:29:33.75,Default,,0,0,0,,Тіпті Китагавада...
Dialogue: 0,0:29:33.83,0:29:36.37,Default,,0,0,0,,Авашима мырза, қараңызшы.
Dialogue: 0,0:29:36.45,0:29:39.62,Default,,0,0,0,,Жаңадан келген адамның осындай түсінігі бар екеніне сену қиын, солай ма?
Dialogue: 0,0:29:40.20,0:29:42.16,Default,,0,0,0,,Оса-сан жазған.
Dialogue: 0,0:29:42.83,0:29:44.79,Default,,0,0,0,,Әркім өзі сүйкімді
Dialogue: 0,0:29:44.87,0:29:46.95,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:29:47.04,0:29:51.04,Default,,0,0,0,,Мені мойындап, жақсы көргім келеді.
Dialogue: 0,0:29:51.12,0:29:53.04,Default,,0,0,0,,Керек болғың келеді
Dialogue: 0,0:29:55.87,0:29:59.95,Default,,0,0,0,,Бұл өзін-өзі қанағаттандыра алмайтын сезімдер.
Dialogue: 0,0:30:00.79,0:30:05.45,Default,,0,0,0,,Осы талапқа сай келетін көршілерді бір уақытта салыстыруға болады.
Dialogue: 0,0:30:05.54,0:30:10.41,Default,,0,0,0,,Олар сондай-ақ шектеулі орындарға таласатын көршілер.
Dialogue: 0,0:30:10.50,0:30:13.25,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,0:30:13.95,0:30:14.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:17.50,0:30:18.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:18.62,0:30:21.58,Default,,0,0,0,,Мен сізбен бір сәт сөйлескім келеді.
Dialogue: 0,0:30:23.08,0:30:25.75,Default,,0,0,0,,
Dialogue: 0,0:30:25.83,0:30:31.37,Default,,0,0,0,,Бұл сіздің өміріңіздегі ең ұзақ күн болғандай сезінесіз бе?
Dialogue: 0,0:30:31.95,0:30:32.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:32.58,0:30:35.25,Default,,0,0,0,,Жеке бөлме осылай көрінеді!
Dialogue: 0,0:30:35.83,0:30:38.50,Default,,0,0,0,,Мен де мүмкіндігінше тезірек жеке бөлме алғым келеді.
Dialogue: 0,0:30:40.58,0:30:42.50,Default,,0,0,0,,Аса-чан керемет
Dialogue: 0,0:30:43.25,0:30:45.95,Default,,0,0,0,,Кім бір күнде орын ала алады?
Dialogue: 0,0:30:47.00,0:30:49.08,Default,,0,0,0,,Ол осы уақытқа дейін болған жоқ, солай ма?
Dialogue: 0,0:30:50.50,0:30:54.16,Default,,0,0,0,,Мен бар күшімді саламын, себебі маған бұл рөлді Утаяма мырза тапсырды.
Dialogue: 0,0:30:55.54,0:30:57.08,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:30:57.16,0:30:59.33,Default,,0,0,0,,Не, сен кетіп қалдың ба?
Dialogue: 0,0:30:59.41,0:31:01.33,Default,,0,0,0,,Мен жай ғана жеке бөлмені көргім келді.
Dialogue: 0,0:31:02.16,0:31:05.04,Default,,0,0,0,,Мен төмен адам болғандықтан, футон дайындауым керек.
Dialogue: 0,0:31:06.70,0:31:07.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:31:08.66,0:31:10.00,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:31:10.08,0:31:12.29,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:31:12.37,0:31:14.29,Default,,0,0,0,,Хаа…
Dialogue: 0,0:31:16.25,0:31:17.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:38.33,0:31:39.33,Default,,0,0,0,,(шу)
Dialogue: 0,0:31:52.37,0:31:53.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:04.83,0:32:05.70,Default,,0,0,0,,Қолшатыр?
Dialogue: 0,0:32:09.29,0:32:13.37,Default,,0,0,0,,Кешіріңіз, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:32:16.20,0:32:17.79,Default,,0,0,0,,Бөлмелерді ауыстырған кезде
Dialogue: 0,0:32:18.75,0:32:20.45,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:32:20.54,0:32:21.16,Default,,0,0,0,,Ах
Dialogue: 0,0:32:23.54,0:32:26.37,Default,,0,0,0,,Сіз бұл бөлмені бұрын пайдаланған адамсыз ба?
Dialogue: 0,0:32:27.20,0:32:29.87,Default,,0,0,0,,Иә, менің атым Китагава.
Dialogue: 0,0:32:30.95,0:32:33.12,Default,,0,0,0,,Китагава мырза, менің атым Аса.
Dialogue: 0,0:32:33.20,0:32:35.62,Default,,0,0,0,,Әй, ой, онша ақылды болма.
Dialogue: 0,0:32:35.70,0:32:38.95,Default,,0,0,0,,Кимоноға қарағанда, Китагава-сама
Dialogue: 0,0:32:39.04,0:32:41.20,Default,,0,0,0,,Оның оң қолы мәртебесі бар.
Dialogue: 0,0:32:43.37,0:32:48.29,Default,,0,0,0,,Мұндай иерархия елдің ең ішкі бөліктерінде ғана бар.
Dialogue: 0,0:32:49.58,0:32:54.33,Default,,0,0,0,,Жас кезімде әкеммен бірге Оокуға бардым.
Dialogue: 0,0:32:54.41,0:32:58.70,Default,,0,0,0,,Мені сол кездегі үлкен мочи-хики рәсімі қатты толқытты.
Dialogue: 0,0:32:58.79,0:33:03.25,Default,,0,0,0,,Мен әрқашан Оокуда жұмыс істеуді армандадым.
Dialogue: 0,0:33:04.58,0:33:10.91,Default,,0,0,0,,Би билеп жатқан сұлу ханшайымдардың артында қылқаламын күшті сермеп тұрған го-фуд фигурасы.
Dialogue: 0,0:33:11.00,0:33:13.58,Default,,0,0,0,,Мен күшті тартуды сезінгенім есімде.
Dialogue: 0,0:33:14.91,0:33:17.58,Default,,0,0,0,,Мен өткен күні үлкен мочи шеруінде болдым.
Dialogue: 0,0:33:18.08,0:33:20.33,Default,,0,0,0,,Мен бұл рөлді ойнауым керек еді, бірақ...
Dialogue: 0,0:33:20.83,0:33:23.66,Default,,0,0,0,,Қандай да бір себептермен ол жойылды ма?
Dialogue: 0,0:33:24.25,0:33:25.08,Default,,0,0,0,,Иә
Dialogue: 0,0:33:27.83,0:33:28.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:28.62,0:33:30.91,Default,,0,0,0,,Kyaah~!
Dialogue: 0,0:33:33.66,0:33:35.41,Default,,0,0,0,,Өте жақсы қылқалам.
Dialogue: 0,0:33:36.12,0:33:39.08,Default,,0,0,0,,Оң қолдың рөліне неге өтініш бермеске?
Dialogue: 0,0:33:39.58,0:33:41.08,Default,,0,0,0,,Бұл шектен шыққан.
Dialogue: 0,0:33:41.16,0:33:43.33,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:33:43.41,0:33:45.20,Default,,0,0,0,,Мен сізбен тағы сөйлескім келеді.
Dialogue: 0,0:33:45.29,0:33:47.91,Default,,0,0,0,,Екі адам кездескенде иерархия болмайды.
Dialogue: 0,0:33:48.54,0:33:50.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:50.08,0:33:52.45,Default,,0,0,0,,Қуыршақты ұстай аласыз ба?
Dialogue: 0,0:33:52.54,0:33:53.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:53.29,0:33:55.75,Default,,0,0,0,,Мен сені тағы көремін, ол бала да.
Dialogue: 0,0:33:55.83,0:33:58.54,Default,,0,0,0,,Қайырлы кеш, жақсы демалыңыз.
Dialogue: 0,0:33:58.62,0:33:59.20,Default,,0,0,0,,Иә
Dialogue: 0,0:34:00.91,0:34:02.04,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:34:02.12,0:34:04.37,Default,,0,0,0,,Китагава-сан... Ал?
Dialogue: 0,0:34:23.20,0:34:23.79,Default,,0,0,0,,Иә
Dialogue: 0,0:34:24.37,0:34:25.20,Default,,0,0,0,,(шу)
Dialogue: 0,0:34:26.33,0:34:29.37,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:34:29.45,0:34:30.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:34:30.62,0:34:32.41,Default,,0,0,0,,Эй, оян!
Dialogue: 0,0:34:32.50,0:34:33.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:34:33.58,0:34:35.58,Default,,0,0,0,,Күнә арамдығы
Dialogue: 0,0:34:35.66,0:34:38.45,Default,,0,0,0,,Мен оларға мен үшін барлық нәрсені жасауға мәжбүр еттім.
Dialogue: 0,0:34:38.54,0:34:40.08,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:34:43.62,0:34:47.45,Default,,0,0,0,,Тазалау қызметіне
Dialogue: 0,0:34:48.62,0:34:49.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:49.75,0:34:51.87,Default,,0,0,0,,Көктегі
Dialogue: 0,0:34:51.95,0:34:52.83,Default,,0,0,0,,(Ай мен Ай күлкі)
Dialogue: 0,0:34:52.91,0:34:53.79,Default,,0,0,0,,- (Ай) Жүрейік - (Ай) Иә.
Dialogue: 0,0:34:57.70,0:34:58.79,Default,,0,0,0,,Әке!
Dialogue: 0,0:34:58.87,0:35:00.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:00.16,0:35:01.83,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:35:02.41,0:35:04.41,Default,,0,0,0,,Ах... Мм...
Dialogue: 0,0:35:07.87,0:35:08.75,Default,,0,0,0,,Хмм.
Dialogue: 0,0:35:09.25,0:35:12.33,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:35:12.41,0:35:15.83,Default,,0,0,0,,Мен саған кеше бітір дедім ғой, солай ма?
Dialogue: 0,0:35:15.91,0:35:18.04,Default,,0,0,0,,Ұмытып қалдыңыз ба?
Dialogue: 0,0:35:18.83,0:35:20.91,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:35:21.70,0:35:24.25,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз, мен асығамын.
Dialogue: 0,0:35:24.33,0:35:27.00,Default,,0,0,0,,Қазірден бастап! Кептірмейді
Dialogue: 0,0:35:27.08,0:35:30.33,Default,,0,0,0,,Сондықтан мен оны кеше бітіруім керек болды.
Dialogue: 0,0:35:30.41,0:35:33.54,Default,,0,0,0,,Мұны бүгін ғана істеу керек емес.
Dialogue: 0,0:35:34.04,0:35:35.41,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:35:35.50,0:35:38.12,Default,,0,0,0,,Бүгін сізде бір нәрсе істеу керек, солай ма?
Dialogue: 0,0:35:38.20,0:35:39.20,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:35:40.00,0:35:42.37,Default,,0,0,0,,Тоқтау ұят емес пе?
Dialogue: 0,0:35:42.45,0:35:44.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:35:45.75,0:35:47.29,Default,,0,0,0,,Әй... ау... Аса-сан!
Dialogue: 0,0:35:47.37,0:35:50.45,Default,,0,0,0,,Сіздің жұмысыңыз аяқталмаған сияқты.
Dialogue: 0,0:35:51.16,0:35:52.83,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:35:52.91,0:35:54.00,Default,,0,0,0,,(Жылдам жақындаған аяқ дыбысы)
Dialogue: 0,0:35:54.08,0:35:55.12,Default,,0,0,0,,(Тік отыру дыбысы)
Dialogue: 0,0:35:56.37,0:35:57.95,Default,,0,0,0,,Растау мүмкін емес
Dialogue: 0,0:35:58.75,0:35:59.37,Default,,0,0,0,,Иә
Dialogue: 0,0:35:59.45,0:36:00.41,Default,,0,0,0,,(Авасима Секибараи)
Dialogue: 0,0:36:00.50,0:36:01.91,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:36:02.00,0:36:05.12,Default,,0,0,0,,Кеше қандай тазартқыш тұз сұрадың?
Dialogue: 0,0:36:05.20,0:36:07.70,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:36:07.79,0:36:08.83,Default,,0,0,0,,Иә
Dialogue: 0,0:36:09.41,0:36:12.87,Default,,0,0,0,,Нұсқауларды алғаннан кейін бірден тапсырманы орындаңыз.
Dialogue: 0,0:36:12.95,0:36:15.04,Default,,0,0,0,,Бүгін таңертең ерте жеткізу арқылы алынды.
Dialogue: 0,0:36:15.12,0:36:16.79,Default,,0,0,0,,- (Авасима) Дұрыс... - (Мугитани) Ол еңбекқор.
Dialogue: 0,0:36:16.87,0:36:18.37,Default,,0,0,0,,Аса-сан!
Dialogue: 0,0:36:18.45,0:36:20.37,Default,,0,0,0,,Онымен салыстырғанда сіз ше?
Dialogue: 0,0:36:20.45,0:36:21.79,Default,,0,0,0,,Авашима мырза~
Dialogue: 0,0:36:21.87,0:36:25.66,Default,,0,0,0,,Окаме бүгін таңертең таңғы ас әзірлеуге де тұрмады.
Dialogue: 0,0:36:25.75,0:36:27.12,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:36:27.20,0:36:28.58,Default,,0,0,0,,Олай емес
Dialogue: 0,0:36:28.66,0:36:31.70,Default,,0,0,0,,Тасбақаны шақырмағаныма мен кінәлімін.
Dialogue: 0,0:36:32.37,0:36:35.41,Default,,0,0,0,,Бұл рөлді екі адаммен бірге орындаймын деген болатын.
Dialogue: 0,0:36:35.50,0:36:40.37,Default,,0,0,0,,Мен тәкаппар болдым, жалғыз өзім істей аламын деп ойладым. Бұл менің кінәм.
Dialogue: 0,0:36:40.45,0:36:42.08,Default,,0,0,0,,Сонда бұл ~ дегенді білдіреді
Dialogue: 0,0:36:42.16,0:36:43.66,Default,,0,0,0,,Сіз не істей аласыз
Dialogue: 0,0:36:43.75,0:36:46.75,Default,,0,0,0,,Мұның бәрі ерлерге жағымпаздану!
Dialogue: 0,0:36:46.83,0:36:48.20,Default,,0,0,0,,-Осылай дейсіз ғой... -(Авашима) Мугия мырза!
Dialogue: 0,0:36:48.29,0:36:50.91,Default,,0,0,0,,Кеше бір кісінің арбауына түсіп, рөлімді тастап кеттім.
Dialogue: 0,0:36:51.00,0:36:52.54,Default,,0,0,0,,Мен бүгін таңертең ұйықтадым!
Dialogue: 0,0:36:52.62,0:36:56.50,Default,,0,0,0,,Бөксесі ауыр ма, жеңіл ме, білмеймін.
Dialogue: 0,0:36:56.58,0:36:57.45,Default,,0,0,0,,Егер сіз оны көрген болсаңыз...
Dialogue: 0,0:36:57.54,0:37:00.41,Default,,0,0,0,,О, ой, ой, мен ілтипатты емеспін бе?
Dialogue: 0,0:37:00.50,0:37:02.25,Default,,0,0,0,,-Ол емес... -(Мугитани) Сонда бұл не?
Dialogue: 0,0:37:02.33,0:37:03.70,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:37:05.20,0:37:10.12,Default,,0,0,0,,Каме мырза, заттарыңызды жинап, Мугия-санның бөлмесіне көшіңіз.
Dialogue: 0,0:37:10.62,0:37:13.45,Default,,0,0,0,,Жұмысыңыздың не екенін басынан бастап біліп алыңыз.
Dialogue: 0,0:37:13.45,0:37:14.54,Default,,0,0,0,,Жұмысыңыздың не екенін басынан бастап біліп алыңыз.
Dialogue: 0,0:37:13.45,0:37:14.54,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:37:14.54,0:37:14.95,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:37:15.54,0:37:19.08,Default,,0,0,0,,Мугия-сан үй қызметшісі ретінде ұятсыз жүр.
Dialogue: 0,0:37:19.16,0:37:20.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:37:20.29,0:37:22.66,Default,,0,0,0,,-Бұл менің кінәм, сондықтан мен -(Мугитани) Иә.
Dialogue: 0,0:37:22.75,0:37:23.95,Default,,0,0,0,,О.
Dialogue: 0,0:37:24.04,0:37:26.04,Default,,0,0,0,,Келесі болған Аса-сама
Dialogue: 0,0:37:26.12,0:37:29.41,Default,,0,0,0,,Маған тасбақалар туралы үйреткіңіз келе ме?
Dialogue: 0,0:37:29.50,0:37:32.58,Default,,0,0,0,,Иә, парызым болса, кішіпейілділікпен қабылдаймын.
Dialogue: 0,0:37:32.58,0:37:33.45,Default,,0,0,0,,Иә, парызым болса, кішіпейілділікпен қабылдаймын.
Dialogue: 0,0:37:32.58,0:37:33.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:37:33.54,0:37:34.41,Default,,0,0,0,,Мен!
Dialogue: 0,0:37:34.95,0:37:35.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:37:35.70,0:37:38.00,Default,,0,0,0,,Мен... Бұдан былай сақ боламын.
Dialogue: 0,0:37:38.08,0:37:39.41,Default,,0,0,0,,- Қолымнан келгеннің бәрін жасаймын - (Мугитани) Жоқ.
Dialogue: 0,0:37:39.50,0:37:40.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:40.41,0:37:41.54,Default,,0,0,0,,Жауапкершілікпен
Dialogue: 0,0:37:41.62,0:37:44.41,Default,,0,0,0,,Кешіріңіз! кешіріңіз!
Dialogue: 0,0:37:41.62,0:37:44.41,Default,,0,0,0,,Мен сізге қамқорлық жасауға рұқсат етіңіз.
Dialogue: 0,0:37:44.91,0:37:45.66,Default,,0,0,0,,Тасбақа…
Dialogue: 0,0:37:48.25,0:37:49.50,Default,,0,0,0,,- (Хирамото) Әдемі қолдар - (Үй қызметкері) А...
Dialogue: 0,0:37:51.62,0:37:52.45,Default,,0,0,0,,Хехе
Dialogue: 0,0:37:54.66,0:37:56.33,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:38:01.16,0:38:04.75,Default,,0,0,0,,Екі ай бұрын бір қызметші ауырып қалды.
Dialogue: 0,0:38:04.83,0:38:07.20,Default,,0,0,0,,Осыдан кейін ол Оокудан кеткен сияқты.
Dialogue: 0,0:38:07.70,0:38:10.29,Default,,0,0,0,,Омочи Хикидің кейінге қалдырылуының себебі
Dialogue: 0,0:38:10.37,0:38:13.00,Default,,0,0,0,,Ешкім анық хабарланбаған сияқты.
Dialogue: 0,0:38:13.50,0:38:16.00,Default,,0,0,0,,Кестеге де назар аударайық.
Dialogue: 0,0:38:18.04,0:38:21.54,Default,,0,0,0,,Бұл тамаша қулық
Dialogue: 0,0:38:21.62,0:38:23.50,Default,,0,0,0,,Бұл тепе-теңдік
Dialogue: 0,0:38:23.58,0:38:24.66,Default,,0,0,0,,Баланс?
Dialogue: 0,0:38:24.75,0:38:28.83,Default,,0,0,0,,Сонымен нені қалай өлшейміз?
Dialogue: 0,0:38:30.29,0:38:31.41,Default,,0,0,0,,Адамдарға…
Dialogue: 0,0:38:32.25,0:38:33.25,Default,,0,0,0,,Адамдарға?
Dialogue: 0,0:38:33.83,0:38:37.79,Default,,0,0,0,,Көрінбейтіннен қашықтығы
Dialogue: 0,0:38:37.87,0:38:38.62,Default,,0,0,0,,Уф
Dialogue: 0,0:38:41.25,0:38:42.50,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:38:42.58,0:38:45.75,Default,,0,0,0,,Сіздің байыпты жұмыс істеуге ниетіңіз жоқ емес пе?
Dialogue: 0,0:38:45.83,0:38:47.66,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:38:47.75,0:38:51.08,Default,,0,0,0,,Мен барынша тырысамын.
Dialogue: 0,0:38:52.12,0:38:55.08,Default,,0,0,0,,Бірақ мен таңертең тұра алмаймын
Dialogue: 0,0:38:55.16,0:38:58.33,Default,,0,0,0,,Айтылғанды есте сақтау керек деп ойлаймын.
Dialogue: 0,0:38:58.41,0:39:00.29,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:39:01.08,0:39:03.79,Default,,0,0,0,,Мен мұны басқа адамдар сияқты істей алмаймын.
Dialogue: 0,0:39:03.87,0:39:06.33,Default,,0,0,0,,Әрқашан, әрқашан артта қалды ...
Dialogue: 0,0:39:09.00,0:39:12.41,Default,,0,0,0,,Окуға не үшін келдің?
Dialogue: 0,0:39:12.50,0:39:14.87,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:39:14.95,0:39:16.58,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:39:19.79,0:39:22.33,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:39:25.58,0:39:26.95,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:39:27.04,0:39:28.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:30.25,0:39:30.87,Default,,0,0,0,,Қый!
Dialogue: 0,0:39:30.95,0:39:32.95,Default,,0,0,0,,Бар, солай ма?
Dialogue: 0,0:39:33.45,0:39:35.83,Default,,0,0,0,,Егер бір қарап алсаңыз~
Dialogue: 0,0:39:35.91,0:39:37.83,Default,,0,0,0,,Жұмыс кезінде бұрыштарды кесіңіз!
Dialogue: 0,0:39:37.91,0:39:41.91,Default,,0,0,0,,Императордың көмегін ғана көздеген әйел!
Dialogue: 0,0:39:43.58,0:39:44.25,Default,,0,0,0,,Иә
Dialogue: 0,0:39:44.33,0:39:44.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:39:45.04,0:39:46.45,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:39:47.25,0:39:48.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:39:57.95,0:39:59.25,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:39:59.33,0:40:00.66,Default,,0,0,0,,Міне!
Dialogue: 0,0:40:02.04,0:40:03.41,Default,,0,0,0,,Жоқ! Жоқ, жоқ!
Dialogue: 0,0:40:04.00,0:40:06.45,Default,,0,0,0,,Егер сіз шындап жұмыс істеуге дайын болсаңыз
Dialogue: 0,0:40:06.54,0:40:08.04,Default,,0,0,0,,- (Мугитани) Саған керегі жоқ, солай ма? - Жоқ...
Dialogue: 0,0:40:08.12,0:40:08.75,Default,,0,0,0,,Мынадай нәрсе!
Dialogue: 0,0:40:08.83,0:40:10.95,Default,,0,0,0,,Жоқ~!
Dialogue: 0,0:40:16.45,0:40:18.75,Default,,0,0,0,,Осы тармақтан тыс
Dialogue: 0,0:40:18.83,0:40:21.83,Default,,0,0,0,,Мен саған айттым ғой бұл басын кесу!
Dialogue: 0,0:40:24.66,0:40:25.29,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:40:27.00,0:40:27.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:34.08,0:40:35.37,Default,,0,0,0,,Мононокай...
Dialogue: 0,0:40:36.41,0:40:37.12,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:40:37.20,0:40:38.25,Default,,0,0,0,,Ей!
Dialogue: 0,0:40:39.20,0:40:40.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:40.20,0:40:42.87,Default,,0,0,0,,Бұл төтенше жағдай!
Dialogue: 0,0:40:51.08,0:40:52.00,Default,,0,0,0,,Артқы жағында?
Dialogue: 0,0:40:52.08,0:40:53.70,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:40:53.79,0:40:54.58,Default,,0,0,0,,Рұқсатсыз...
Dialogue: 0,0:40:55.66,0:40:56.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:40:57.54,0:40:58.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:40:58.95,0:41:00.41,Default,,0,0,0,,Калейдоскоп...
Dialogue: 0,0:41:01.00,0:41:02.12,Default,,0,0,0,,Сакашита мырза!
Dialogue: 0,0:41:02.20,0:41:03.66,Default,,0,0,0,,Ән авторы қайда...
Dialogue: 0,0:41:05.12,0:41:06.50,Default,,0,0,0,,Лорд Авашима!
Dialogue: 0,0:41:08.00,0:41:08.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:41:09.79,0:41:10.33,Default,,0,0,0,,Жоғарыда ма?
Dialogue: 0,0:41:10.41,0:41:12.12,Default,,0,0,0,,- (Авашима) Әй, барма! -(Сакашита) Эй... аа!
Dialogue: 0,0:41:17.75,0:41:18.79,Default,,0,0,0,,Авашима мырза!
Dialogue: 0,0:41:18.87,0:41:22.95,Default,,0,0,0,,Ой... Мен Мугия-дононың қорқынышты айғайын естідім.
Dialogue: 0,0:41:23.04,0:41:23.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:24.87,0:41:25.54,Default,,0,0,0,,Сен кеттің бе?
Dialogue: 0,0:41:26.25,0:41:27.87,Default,,0,0,0,,Гадфли... Уаааааааааааааааа
Dialogue: 0,0:41:27.95,0:41:28.95,Default,,0,0,0,,Рыцарь Рейнхарт.
Dialogue: 0,0:41:31.45,0:41:32.50,Default,,0,0,0,,Тасбақа!
Dialogue: 0,0:41:33.79,0:41:35.20,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:41:35.79,0:41:36.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:37.75,0:41:40.25,Default,,0,0,0,,Мұнда жалғыз тасбақа болды ма?
Dialogue: 0,0:41:40.33,0:41:42.54,Default,,0,0,0,,Мен Муғия-сама да бар деп естідім.
Dialogue: 0,0:41:42.62,0:41:44.58,Default,,0,0,0,,Сабырлы болсаң көмектеседі.
Dialogue: 0,0:41:45.45,0:41:46.54,Default,,0,0,0,,Тасбақа ше?
Dialogue: 0,0:41:47.12,0:41:48.04,Default,,0,0,0,,Мен оянғалы жатырмын...
Dialogue: 0,0:41:51.08,0:41:51.91,Default,,0,0,0,,Шамасы...
Dialogue: 0,0:41:52.00,0:41:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:52.83,0:41:55.04,Default,,0,0,0,,Мен уақытында үлгермеген сияқтымын.
Dialogue: 0,0:41:55.54,0:41:59.95,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:42:00.04,0:42:00.91,Default,,0,0,0,,Кара Кара Кара?
Dialogue: 0,0:42:01.00,0:42:02.04,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:42:06.50,0:42:07.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:08.95,0:42:10.29,Default,,0,0,0,,Шыу!
Dialogue: 0,0:42:10.37,0:42:11.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:42:13.04,0:42:14.20,Default,,0,0,0,,Мугия...
Dialogue: 0,0:42:14.79,0:42:19.20,Default,,0,0,0,,Бұл адамның қолынан келетін шеберлік емес.
Dialogue: 0,0:42:19.91,0:42:21.66,Default,,0,0,0,,- (Утаяма) Сен кімсің! -(Сакашита) Адамның қолынан келмейді...
Dialogue: 0,0:42:22.29,0:42:23.00,Default,,0,0,0,,Тек...
Dialogue: 0,0:42:24.04,0:42:25.16,Default,,0,0,0,,Дәрі сатушы
Dialogue: 0,0:42:26.20,0:42:30.75,Default,,0,0,0,,Оокунайға рұқсатсыз кіріп, әбігерге салу қылмысы!
Dialogue: 0,0:42:31.25,0:42:35.79,Default,,0,0,0,,Бұл жолғы қарсыласым сол қылышпен шаубайтын адам.
Dialogue: 0,0:42:37.04,0:42:39.75,Default,,0,0,0,,Бұл Мононокенің жұмысы.
Dialogue: 0,0:42:39.83,0:42:40.45,Default,,0,0,0,,Заттар…
Dialogue: 0,0:42:40.54,0:42:41.33,Default,,0,0,0,,Кай жоқ па?
Dialogue: 0,0:42:42.20,0:42:43.83,Default,,0,0,0,,Бұл оғаш құбылыстың себебі...
Dialogue: 0,0:42:43.91,0:42:44.70,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:42:44.79,0:42:47.25,Default,,0,0,0,,Окуда ондай ештеңе жоқ!
Dialogue: 0,0:42:47.33,0:42:48.95,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:42:49.04,0:42:50.37,Default,,0,0,0,,Мононок
Dialogue: 0,0:42:50.45,0:42:51.20,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:42:51.29,0:42:52.83,Default,,0,0,0,,Мен сені кесіп көрейін
Dialogue: 0,0:42:53.79,0:42:55.41,Default,,0,0,0,,- (Сакашита) Нуах! Уф... - (Асанума) Уф! Уау...
Dialogue: 0,0:42:59.62,0:43:04.50,Default,,0,0,0,,Ылғалды еден дөңгелек пішінді сызып, кебеді.
Dialogue: 0,0:43:05.00,0:43:06.91,Default,,0,0,0,,Құбыжық болды...
Dialogue: 0,0:43:07.00,0:43:09.08,Default,,0,0,0,,Нуа~! Уф...
Dialogue: 0,0:43:09.58,0:43:12.08,Default,,0,0,0,,Жынның аты...
Dialogue: 0,0:43:12.16,0:43:12.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:12.91,0:43:14.33,Default,,0,0,0,,Қолшатыр
Dialogue: 0,0:43:15.08,0:43:17.87,Default,,0,0,0,,(Қылыш тістерінің шырылдаған дыбысы)
Dialogue: 0,0:43:18.70,0:43:19.95,Default,,0,0,0,,Мугия мырза
Dialogue: 0,0:43:21.25,0:43:22.75,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:43:23.33,0:43:25.41,Default,,0,0,0,,Алынған пішін
Dialogue: 0,0:43:26.87,0:43:28.20,Default,,0,0,0,,Пішін?
Dialogue: 0,0:43:28.29,0:43:32.08,Default,,0,0,0,,Құбыжықты өлтірмесеңіз, оны басқара алмайсыз.
Dialogue: 0,0:43:32.16,0:43:33.87,Default,,0,0,0,,Калейдоскоп...
Dialogue: 0,0:43:33.95,0:43:38.70,Default,,0,0,0,,Алайда адам шеберлігі мононокты қысқарта алмайды.
Dialogue: 0,0:43:40.33,0:43:41.91,Default,,0,0,0,,Сондықтан бұл қылыш
Dialogue: 0,0:43:42.62,0:43:45.91,Default,,0,0,0,,Инь-Ян Багуаның бір серпілісі бар «Кон» қылыш бар.
Dialogue: 0,0:43:46.79,0:43:51.58,Default,,0,0,0,,Біздің 64 гексаграммамыз өзімізбен бірге жұмысымызды алып жүреді.
Dialogue: 0,0:43:52.37,0:43:53.87,Default,,0,0,0,,Басқа аты...
Dialogue: 0,0:43:55.58,0:43:57.25,Default,,0,0,0,,Жын шығаратын қылыш!
Dialogue: 0,0:44:01.79,0:44:04.83,Default,,0,0,0,,Неге мені сол қылышпен бірден кеспедің?
Dialogue: 0,0:44:04.91,0:44:07.91,Default,,0,0,0,,Бұл қылышты тартудың шарттары бар.
Dialogue: 0,0:44:08.00,0:44:08.66,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:44:08.75,0:44:09.62,Default,,0,0,0,,Пішін
Dialogue: 0,0:44:09.70,0:44:10.66,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:44:10.75,0:44:11.79,Default,,0,0,0,,Принцип
Dialogue: 0,0:44:12.83,0:44:18.83,Default,,0,0,0,,Осы үш элемент тураланбаса, қылыш тартылмайды.
Dialogue: 0,0:44:19.83,0:44:21.91,Default,,0,0,0,,Шындық – заттардың пайда болуы
Dialogue: 0,0:44:22.91,0:44:29.33,Default,,0,0,0,,Себеп осында, іштей лаулаған құмарлықтың шынайы табиғаты
Dialogue: 0,0:44:30.20,0:44:33.16,Default,,0,0,0,,Қылыштың үш жолын көрсетсең
Dialogue: 0,0:44:33.25,0:44:36.37,Default,,0,0,0,,Мононокты өлтіре аламын дейсіз бе?
Dialogue: 0,0:44:36.45,0:44:37.70,Default,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 0,0:44:38.20,0:44:41.04,Default,,0,0,0,,Қылыштың үш жолын көрсету үшін...
Dialogue: 0,0:44:42.70,0:44:43.83,Default,,0,0,0,,- (Утаяма) Сакашита - (Сакашита) Ха
Dialogue: 0,0:44:43.91,0:44:45.79,Default,,0,0,0,,Мына адамға рұқсат беріңіз.
Dialogue: 0,0:44:45.87,0:44:46.58,Default,,0,0,0,,Утаяма мырза?
Dialogue: 0,0:44:48.95,0:44:52.20,Default,,0,0,0,,Қолшатырды әдемі етіп қиып алайық.
Dialogue: 0,0:44:54.04,0:44:56.95,Default,,0,0,0,,Бүгінгі кеш туралы көп айтудың қажеті жоқ.
Dialogue: 0,0:44:57.04,0:45:02.62,Default,,0,0,0,,Сонымен қатар, Мугия мочи-хики аяқталғанша өлмейді.
Dialogue: 0,0:45:02.70,0:45:03.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:05.62,0:45:07.91,Default,,0,0,0,,Түсіндің бе? Авашима
Dialogue: 0,0:45:08.41,0:45:11.45,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:45:12.87,0:45:17.33,Default,,0,0,0,,Сіздің ақиқатыңыз бен парасатыңыз
Dialogue: 0,0:45:20.33,0:45:24.08,Default,,0,0,0,,Маған хабарлаңыз.
Dialogue: 0,0:45:33.87,0:45:36.29,Default,,0,0,0,,Фуфуфуфуфу... Уф!
Dialogue: 0,0:46:12.87,0:46:16.20,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:46:18.12,0:46:22.79,Default,,0,0,0,,Бәле, күнә, арамдық
Dialogue: 0,0:46:24.83,0:46:25.37,Default,,0,0,0,,Жын шығару...
Dialogue: 0,0:46:30.25,0:46:31.95,Default,,0,0,0,,Су жақсы ма?
Dialogue: 0,0:46:32.45,0:46:34.29,Default,,0,0,0,,Аспан... жоқ
Dialogue: 0,0:46:36.37,0:46:37.41,Default,,0,0,0,,Бұл Мимизу-сама ма?
Dialogue: 0,0:46:40.25,0:46:43.29,Default,,0,0,0,,Бақытқа
Dialogue: 0,0:46:45.45,0:46:47.54,Default,,0,0,0,,Тасбақаға уақыт беру
Dialogue: 0,0:46:47.62,0:46:49.75,Default,,0,0,0,,Күте аласыз ба?
Dialogue: 0,0:46:50.95,0:46:52.04,Default,,0,0,0,,(Баланың есік ашылған дыбысы)
Dialogue: 0,0:46:54.95,0:46:59.83,Default,,0,0,0,,Әлсіздер мен үлес қоса алмайтындарға орын жоқ.
Dialogue: 0,0:47:01.04,0:47:04.79,Default,,0,0,0,,Әдетте бұл алғашқы үш күнде анық болады.
Dialogue: 0,0:47:08.70,0:47:09.33,Default,,0,0,0,,Уф
Dialogue: 0,0:47:13.87,0:47:14.62,Default,,0,0,0,,Иә
Dialogue: 0,0:47:15.25,0:47:18.33,Default,,0,0,0,,Мен тасбақаның емделуін саған қалдырамын.
Dialogue: 0,0:47:19.12,0:47:20.25,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:47:20.79,0:47:22.66,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:47:31.58,0:47:32.87,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:47:32.95,0:47:35.33,Default,,0,0,0,,Бұл Нацугучиде болған сатушы.
Dialogue: 0,0:47:35.83,0:47:37.95,Default,,0,0,0,,Мен барлығының тыңдағанын қалаймын.
Dialogue: 0,0:47:38.54,0:47:42.25,Default,,0,0,0,,Мугия асығыс үйге қайту керек.
Dialogue: 0,0:47:44.04,0:47:44.91,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:47:47.45,0:47:48.20,Default,,0,0,0,,Не?
Dialogue: 0,0:47:48.29,0:47:49.58,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:47:49.66,0:47:54.12,Default,,0,0,0,,Мен бүгін таңертең ерте шықтым, сондықтан сәлем деуге болмайды.
Dialogue: 0,0:47:56.37,0:47:57.08,Default,,0,0,0,,Эй
Dialogue: 0,0:47:57.16,0:48:02.54,Default,,0,0,0,,Ауыр жүкті көтере алатындар келесі сатыға көтерілу үшін күш алады.
Dialogue: 0,0:48:03.16,0:48:06.12,Default,,0,0,0,,Асаға елші мәртебесі берілді.
Dialogue: 0,0:48:06.20,0:48:09.87,Default,,0,0,0,,Мен сенің Мугия рөлін алғаныңды қалаймын.
Dialogue: 0,0:48:09.95,0:48:11.79,Default,,0,0,0,,Сіз хабаршысыз ба?
Dialogue: 0,0:48:11.87,0:48:14.12,Default,,0,0,0,,Осындай жағдай болды ма?
Dialogue: 0,0:48:14.12,0:48:15.08,Default,,0,0,0,,Осындай жағдай болды ма?
Dialogue: 0,0:48:14.12,0:48:15.08,Default,,0,0,0,,Аса-доно...
Dialogue: 0,0:48:15.16,0:48:16.20,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,0:48:17.29,0:48:18.33,Default,,0,0,0,,Маған қалдырыңыз...
Dialogue: 0,0:48:20.08,0:48:21.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:48:24.16,0:48:27.83,Default,,0,0,0,,Қарастырылып отырған қызметші қыз ешқашан ата-анасының үйіне оралмаған.
Dialogue: 0,0:48:27.91,0:48:29.45,Default,,0,0,0,,Не?
Dialogue: 0,0:48:29.54,0:48:31.45,Default,,0,0,0,,Қызметші қыздың аты...
Dialogue: 0,0:48:36.33,0:48:38.70,Default,,0,0,0,,Неліктен сатушы ішкі сарайдың ішінде?
Dialogue: 0,0:48:38.79,0:48:40.33,Default,,0,0,0,,Бұл бас кесу емес пе?
Dialogue: 0,0:48:40.41,0:48:43.37,Default,,0,0,0,,Мен Утаяма мырзадан сұрағым келеді.
Dialogue: 0,0:48:43.87,0:48:46.37,Default,,0,0,0,,Лорд Утайама үлкен саяси күшке ие.
Dialogue: 0,0:48:47.00,0:48:49.08,Default,,0,0,0,,Мен сені қорғағым келеді
Dialogue: 0,0:48:52.87,0:48:54.16,Default,,0,0,0,,Иә? қылыш?
Dialogue: 0,0:48:54.25,0:48:56.04,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:48:56.12,0:48:58.83,Default,,0,0,0,,Мен сізден бір қызметші туралы сұрайын деп едім...
Dialogue: 0,0:48:58.91,0:49:00.91,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:49:07.66,0:49:09.41,Default,,0,0,0,,Су дәмді ме?
Dialogue: 0,0:49:12.12,0:49:13.79,Default,,0,0,0,,Китагава мырза
Dialogue: 0,0:49:14.37,0:49:15.25,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:49:15.33,0:49:18.54,Default,,0,0,0,,Кейде бір нәрсені тастауға тура келеді
Dialogue: 0,0:49:19.12,0:49:22.16,Default,,0,0,0,,Аса-сан нені лақтырады?
Dialogue: 0,0:49:23.25,0:49:26.45,Default,,0,0,0,,Менде бар нәрсе мен лақтырғым келетін нәрсе болды.
Dialogue: 0,0:49:26.95,0:49:30.41,Default,,0,0,0,,Бірақ кейбір нәрселерді тастауға болмайды.
Dialogue: 0,0:49:31.66,0:49:33.20,Default,,0,0,0,,Пішін неде...
Dialogue: 0,0:49:33.79,0:49:34.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:35.37,0:49:36.50,Default,,0,0,0,,шектелмейді
Dialogue: 0,0:49:37.58,0:49:40.66,Default,,0,0,0,,Лақтырсаң, құрғап қалады.
Dialogue: 0,0:49:40.75,0:49:41.66,Default,,0,0,0,,Маған
Dialogue: 0,0:49:41.75,0:49:43.66,Default,,0,0,0,,Кеуіп қалмас үшін кейбір нәрселер бар.
Dialogue: 0,0:49:44.54,0:49:48.08,Default,,0,0,0,,Сонымен... біз оны тастауымыз керек.
Dialogue: 0,0:49:53.29,0:49:54.41,Default,,0,0,0,,Оаса-доно
Dialogue: 0,0:49:56.33,0:49:57.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:00.95,0:50:03.37,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:50:04.08,0:50:05.37,Default,,0,0,0,,Бірақ мен бір D-хабарламаны жойған сайын,
Dialogue: 0,0:50:07.29,0:50:11.12,Default,,0,0,0,,Мен Мугия-санмен кездескім келмейді.
Dialogue: 0,0:50:12.12,0:50:13.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:50:13.66,0:50:16.58,Default,,0,0,0,,Бүгін менің орнымда жұмыс істей аласыз.
Dialogue: 0,0:50:17.16,0:50:18.50,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:50:21.00,0:50:21.70,Default,,0,0,0,,Иә
Dialogue: 0,0:50:22.20,0:50:25.08,Default,,0,0,0,,Салтанаттағы қонақтарға қызмет көрсету рөлі
Dialogue: 0,0:50:25.16,0:50:26.66,Default,,0,0,0,,Сіз оны қабылдай аласыз ба?
Dialogue: 0,0:50:26.75,0:50:30.04,Default,,0,0,0,,Мен Утаяма мырзаның бағыныштысы емеспін.
Dialogue: 0,0:50:30.75,0:50:32.45,Default,,0,0,0,,Отомодан келген адам ретінде
Dialogue: 0,0:50:32.54,0:50:35.95,Default,,0,0,0,,Бұл тек ішкі және сыртқы жақтардың арасындағы динамиканы реттеу.
Dialogue: 0,0:50:37.50,0:50:39.33,Default,,0,0,0,,(Калейдоскоп дыбысы)
Dialogue: 0,0:50:39.41,0:50:41.00,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:50:41.08,0:50:43.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:46.87,0:50:47.83,Default,,0,0,0,,(Қылқаламды қою дыбысы)
Dialogue: 0,0:50:49.00,0:50:50.70,Default,,0,0,0,,Таааа...
Dialogue: 0,0:50:53.83,0:50:55.83,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:51:02.91,0:51:04.95,Default,,0,0,0,,(Кішкентай қадамдар)
Dialogue: 0,0:51:20.04,0:51:21.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:24.16,0:51:25.04,Default,,0,0,0,,Қазір ғана Какёин менің кім екенімді анықтай бастағанда мен дүрлігіп кеттім
Dialogue: 0,0:51:27.62,0:51:28.25,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:51:28.87,0:51:30.29,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:51:31.04,0:51:32.79,Default,,0,0,0,,Біз, қызметшілер,
Dialogue: 0,0:51:33.58,0:51:36.00,Default,,0,0,0,,Түнгі бөлмеге жақындамаңыз
Dialogue: 0,0:51:37.29,0:51:40.16,Default,,0,0,0,,Бұл Оку ережесі.
Dialogue: 0,0:51:41.45,0:51:42.58,Default,,0,0,0,,О
Dialogue: 0,0:51:43.16,0:51:44.04,Default,,0,0,0,,Сіз сиқыршысыз ба?
Dialogue: 0,0:51:48.04,0:51:49.12,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:51:51.50,0:51:54.12,Default,,0,0,0,,Қолшатыр... жақын жерде.
Dialogue: 0,0:51:54.20,0:51:55.12,Default,,0,0,0,,Қолшатыр?
Dialogue: 0,0:51:56.29,0:51:57.41,Default,,0,0,0,,Түсірілді
Dialogue: 0,0:51:58.00,0:51:58.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:01.12,0:52:03.00,Default,,0,0,0,,Ақаулық туғызу
Dialogue: 0,0:52:03.50,0:52:08.50,Default,,0,0,0,,Бұл сіздің бастық ретінде менің лауазымыма қауіп төндіру әрекеті ме?
Dialogue: 0,0:52:21.62,0:52:23.20,Default,,0,0,0,,Мұқият қолжазба
Dialogue: 0,0:52:24.45,0:52:25.79,Default,,0,0,0,,Түсінбеушілік!
Dialogue: 0,0:52:27.08,0:52:31.29,Default,,0,0,0,,Мен Аса-чанды Оокуда кездестірдім және оны жаман деп ойладым.
Dialogue: 0,0:52:32.20,0:52:36.20,Default,,0,0,0,,Себебі мен дәл солай істеуім мүмкін емес екенін білемін.
Dialogue: 0,0:52:36.70,0:52:39.58,Default,,0,0,0,,Бұлай жалғаса берсе, мен бос уақытымды тастауым керек.
Dialogue: 0,0:52:40.20,0:52:44.37,Default,,0,0,0,,Сондықтан император мені бірінші рет көрді...
Dialogue: 0,0:52:44.87,0:52:50.70,Default,,0,0,0,,Тарағын лақтыруға мәжбүрлеген бізді қудалаудың бір түрі болса керек.
Dialogue: 0,0:52:51.75,0:52:52.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:52.37,0:52:55.95,Default,,0,0,0,,Менің ойымша, шынымен де мононоке жоқ!
Dialogue: 0,0:52:56.87,0:52:58.54,Default,,0,0,0,,Мононокай?
Dialogue: 0,0:52:58.62,0:53:03.37,Default,,0,0,0,,Мугияны жасырған Аса екеуің болған шығар!
Dialogue: 0,0:53:03.45,0:53:06.50,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:53:08.25,0:53:11.62,Default,,0,0,0,,Мұның бәрі сіздің даналығыңыз ба?
Dialogue: 0,0:53:11.70,0:53:12.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:53:13.00,0:53:17.08,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз және жағымсыз жұмыстардан аулақ болыңыз
Dialogue: 0,0:53:17.08,0:53:17.66,Default,,0,0,0,,Тек өзіңіз қалаған нәрсені жасаңыз және жағымсыз жұмыстардан аулақ болыңыз
Dialogue: 0,0:53:17.08,0:53:17.66,Default,,0,0,0,,(тасбақа айқайлайды)
Dialogue: 0,0:53:17.66,0:53:18.16,Default,,0,0,0,,(тасбақа айқайлайды)
Dialogue: 0,0:53:18.16,0:53:20.25,Default,,0,0,0,,(тасбақа айқайлайды)
Dialogue: 0,0:53:18.16,0:53:20.25,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:53:20.33,0:53:22.87,Default,,0,0,0,,- (Авасима) Бұл қорқақ! -Жоқ! Ах!
Dialogue: 0,0:53:22.95,0:53:24.08,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:53:24.16,0:53:25.54,Default,,0,0,0,,Мен бәрібір саған еремін
Dialogue: 0,0:53:25.62,0:53:26.62,Default,,0,0,0,,Ахх!
Dialogue: 0,0:53:26.70,0:53:30.08,Default,,0,0,0,,Ақылды көздер, сондай кішкентай қыз!
Dialogue: 0,0:53:30.16,0:53:31.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:31.70,0:53:33.87,Default,,0,0,0,,Утаяма мырза~!
Dialogue: 0,0:53:38.66,0:53:39.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:39.41,0:53:40.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:53:42.08,0:53:42.70,Default,,0,0,0,,Ах
Dialogue: 0,0:53:44.25,0:53:45.12,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:53:45.20,0:53:48.00,Default,,0,0,0,,Мен де оны тастағым келмеді!
Dialogue: 0,0:53:48.08,0:53:50.00,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:53:51.79,0:53:52.87,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:53:53.87,0:53:54.87,Default,,0,0,0,,Ашылмайды!
Dialogue: 0,0:53:54.95,0:53:56.54,Default,,0,0,0,,(Авасиманың айқайы)
Dialogue: 0,0:53:56.62,0:53:58.29,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:53:58.37,0:54:00.58,Default,,0,0,0,,Мен Узуи мырзаның әйелі Хинацуруды іздеуім керек еді.
Dialogue: 0,0:54:01.91,0:54:03.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:54:04.79,0:54:05.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:07.54,0:54:08.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:10.95,0:54:11.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:12.37,0:54:14.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:54:15.58,0:54:17.20,Default,,0,0,0,,Қамқор болыңыз...
Dialogue: 0,0:54:18.00,0:54:22.41,Default,,0,0,0,,Маған көрейін.
Dialogue: 0,0:54:23.70,0:54:26.75,Default,,0,0,0,,(тасбақа айқайлайды)
Dialogue: 0,0:54:26.83,0:54:30.45,Default,,0,0,0,,Есірткі сатушы мен іздестірушілер шу шығарады.
Dialogue: 0,0:54:30.54,0:54:31.37,Default,,0,0,0,,Не?
Dialogue: 0,0:54:31.45,0:54:32.87,Default,,0,0,0,,Мононокпен!
Dialogue: 0,0:54:40.25,0:54:40.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:54:40.95,0:54:41.87,Default,,0,0,0,,Кірмеңіз!
Dialogue: 0,0:54:41.95,0:54:42.66,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:54:43.29,0:54:43.83,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:54:43.91,0:54:45.41,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:54:47.33,0:54:48.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:52.45,0:54:53.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:54:54.29,0:54:55.20,Default,,0,0,0,,Көмек бере алмаймын
Dialogue: 0,0:54:57.20,0:54:58.75,Default,,0,0,0,,(Фукудың айқайлары және т.б.)
Dialogue: 0,0:55:02.08,0:55:04.70,Default,,0,0,0,,Адамдарды жаңбырға айналдыра ма?
Dialogue: 0,0:55:12.66,0:55:15.29,Default,,0,0,0,,Тасбақа кір еден жағында.
Dialogue: 0,0:55:16.08,0:55:16.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:23.41,0:55:24.45,Default,,0,0,0,,Тасбақа!
Dialogue: 0,0:55:25.41,0:55:26.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:33.66,0:55:37.70,Default,,0,0,0,,Екі ай бұрын О-окудан қызметші қыз жоғалып кетті.
Dialogue: 0,0:55:38.20,0:55:42.12,Default,,0,0,0,,Қызметші біраз демалыс алып, ата-анасының үйіне қайтуы керек еді.
Dialogue: 0,0:55:44.62,0:55:47.41,Default,,0,0,0,,Бірақ ол түтіндей жоғалып кетті
Dialogue: 0,0:55:47.50,0:55:49.54,Default,,0,0,0,,Әлі де жоқ
Dialogue: 0,0:55:50.50,0:55:52.41,Default,,0,0,0,,Мугия-доно да бүгін таңертең.
Dialogue: 0,0:55:52.50,0:55:55.41,Default,,0,0,0,,Сен шынымен де ата-анаңның үйіне қайттың ба?
Dialogue: 0,0:55:55.50,0:55:59.50,Default,,0,0,0,,Ал үлкен мочи хики де екі ай бұрын кейінге қалдырылды.
Dialogue: 0,0:56:00.08,0:56:02.66,Default,,0,0,0,,Бұл шынымен де кездейсоқтық па, жоқ па?
Dialogue: 0,0:56:03.66,0:56:04.58,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:56:07.54,0:56:08.50,Default,,0,0,0,,Жабу
Dialogue: 0,0:56:09.20,0:56:10.20,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:56:10.79,0:56:11.91,Default,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:56:12.00,0:56:14.62,Default,,0,0,0,,Бұл мәселеге араласудың қажеті жоқ
Dialogue: 0,0:56:14.70,0:56:17.75,Default,,0,0,0,,Мен бұл туралы Отомого ақсақалға хабарлағанмын деп ойладым.
Dialogue: 0,0:56:17.83,0:56:18.50,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:56:19.75,0:56:22.45,Default,,0,0,0,,Жоғалған қызметшінің аты-жөні!
Dialogue: 0,0:56:22.54,0:56:23.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:23.50,0:56:26.12,Default,,0,0,0,,-Китагава-саманың... -(Сабуромару) Бұрынғы Ооку Гошу
Dialogue: 0,0:56:28.83,0:56:30.00,Default,,0,0,0,,Бұл Китагава-доно!
Dialogue: 0,0:56:30.75,0:56:31.91,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:56:36.75,0:56:38.91,Default,,0,0,0,,Шындық
Dialogue: 0,0:56:39.00,0:56:41.04,Default,,0,0,0,,Китагава-сама рас па?
Dialogue: 0,0:56:42.12,0:56:43.29,Default,,0,0,0,,Мононокай...
Dialogue: 0,0:56:45.20,0:56:46.25,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:56:54.12,0:56:56.70,Default,,0,0,0,,(құрғақ...)
Dialogue: 0,0:56:56.79,0:56:57.50,Default,,0,0,0,,Не?
Dialogue: 0,0:57:02.95,0:57:03.70,Default,,0,0,0,,Міне
Dialogue: 0,0:57:04.66,0:57:07.37,Default,,0,0,0,,Мононоқай Қарағаса!
Dialogue: 0,0:57:11.08,0:57:11.95,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:57:28.62,0:57:32.66,Default,,0,0,0,,Қарағаса әлі де кемел келбетіне енген жоқ.
Dialogue: 0,0:57:33.20,0:57:37.29,Default,,0,0,0,,Бұл дүниеде қалыптасқаннан кейін ол басқарылмайтын болады.
Dialogue: 0,0:57:37.37,0:57:38.33,Default,,0,0,0,,Авашима
Dialogue: 0,0:57:38.83,0:57:41.00,Default,,0,0,0,,Окуда не болып жатыр?
Dialogue: 0,0:57:43.00,0:57:46.75,Default,,0,0,0,,Біз ешбір кідіріссіз мочи тартуды жалғастырғымыз келеді!
Dialogue: 0,0:57:53.87,0:57:56.45,Default,,0,0,0,,Қорқынышты қорқынышты қорқынышты~!
Dialogue: 0,0:57:56.54,0:57:59.79,Default,,0,0,0,,Аса-чан, таңға дейін қолымды жібермеші.
Dialogue: 0,0:57:59.87,0:58:00.41,Default,,0,0,0,,Иә
Dialogue: 0,0:58:00.50,0:58:04.08,Default,,0,0,0,,Өйткені бұл уәде! Мен босатсам, енді сенімен сөйлеспеймін
Dialogue: 0,0:58:04.91,0:58:06.70,Default,,0,0,0,,Ешқашан жібермеңіз
Dialogue: 0,0:58:06.79,0:58:07.91,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:58:08.87,0:58:12.33,Default,,0,0,0,,Мен Китагава мырзаны кездестірдім.
Dialogue: 0,0:58:14.16,0:58:17.20,Default,,0,0,0,,Китагава мырза: «Мен сізді кездестірдім», - деді.
Dialogue: 0,0:58:17.70,0:58:19.25,Default,,0,0,0,,Оның кебуіне жол бермеңіз
Dialogue: 0,0:58:19.75,0:58:20.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:21.54,0:58:22.50,Default,,0,0,0,,Байқалған
Dialogue: 0,0:58:23.29,0:58:25.12,Default,,0,0,0,,Китагава мырзаға рахмет
Dialogue: 0,0:58:25.20,0:58:28.83,Default,,0,0,0,,Нені тастауға болмайды Не маңызды?
Dialogue: 0,0:58:31.79,0:58:32.83,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:58:33.62,0:58:34.45,Default,,0,0,0,,Иә
Dialogue: 0,0:58:35.12,0:58:36.41,Default,,0,0,0,,-Бұл не болды? - А?
Dialogue: 0,0:58:36.50,0:58:38.62,Default,,0,0,0,,Аса Чанның асыл заттары
Dialogue: 0,0:58:41.58,0:58:42.54,Default,,0,0,0,,Егер сен осы екеуін қорғасаң, мен шабуылға көңіл бөле аламын
Dialogue: 0,0:58:42.62,0:58:46.08,Default,,0,0,0,,Иә! Мен оны естігім келеді, оны естігім келеді
Dialogue: 0,0:58:46.16,0:58:49.41,Default,,0,0,0,,Естігім келеді, естігім келеді, естігім келеді, естігім келеді, естігім келеді
Dialogue: 0,0:58:49.50,0:58:51.50,Default,,0,0,0,,Каме-чанға айтар сөзім бар.
Dialogue: 0,0:58:51.58,0:58:52.95,Default,,0,0,0,,Иә, не?
Dialogue: 0,0:58:54.00,0:58:56.45,Default,,0,0,0,,Маңызды оқиға
Dialogue: 0,0:59:05.91,0:59:08.83,Default,,0,0,0,,Бізге кедергі жасама
Dialogue: 0,0:59:09.75,0:59:11.79,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:59:13.33,0:59:17.33,Default,,0,0,0,,Лорд Авашима үлкен мочи-хикиден кейін қайтыс болды.
Dialogue: 0,0:59:17.41,0:59:18.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:59:18.75,0:59:21.58,Default,,0,0,0,,Үлкен мочи тортын жүргізу - бұл жай жұмыс.
Dialogue: 0,0:59:21.66,0:59:27.00,Default,,0,0,0,,Бірақ көптеген адамдар бұл жұмысқа жүректерін, жан-тәндерін төкті.
Dialogue: 0,0:59:27.08,0:59:29.66,Default,,0,0,0,,Сіздің жұмысыңыз соншалықты маңызды ма?
Dialogue: 0,0:59:29.75,0:59:31.41,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:59:31.50,0:59:35.83,Default,,0,0,0,,Утаяма-саманың құлауына қажетті ингредиенттерді табу емес пе?
Dialogue: 0,0:59:37.29,0:59:38.58,Default,,0,0,0,,Аса-доно...
Dialogue: 0,0:59:39.08,0:59:40.58,Default,,0,0,0,,Мен сізге кейін хабаршы жіберемін.
Dialogue: 0,0:59:41.08,0:59:43.58,Default,,0,0,0,,Сіздің жұмысыңыз ертең басталады.
Dialogue: 0,0:59:44.62,0:59:46.29,Default,,0,0,0,,Үлкен күріш тортын тарту аяқталғанша
Dialogue: 0,0:59:46.37,0:59:50.25,Default,,0,0,0,,Оокуды шайқауға рұқсат бермеймін.
Dialogue: 0,0:59:53.00,0:59:57.25,Default,,0,0,0,,Бақытқа
Dialogue: 0,0:59:58.29,1:00:01.00,Default,,0,0,0,,(Ай мен Ай күлкі)
Dialogue: 0,1:00:07.50,1:00:10.37,Default,,0,0,0,,Китагава мырзамен сөйлестіңіз бе?
Dialogue: 0,1:00:11.00,1:00:12.50,Default,,0,0,0,,Егер сіз есірткі сатушы болсаңыз
Dialogue: 0,1:00:12.58,1:00:15.37,Default,,0,0,0,,Қызық, сен Аса-чанды қорғай аласың ба?
Dialogue: 0,1:00:16.25,1:00:20.25,Default,,0,0,0,,Мен Мононоке принципіне жақындай аламын ба деп ойлаймын.
Dialogue: 0,1:00:20.87,1:00:25.16,Default,,0,0,0,,Китагава мырзаға не болғанын білмеймін.
Dialogue: 0,1:00:26.25,1:00:27.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:00:29.08,1:00:29.62,Default,,0,0,0,,Бірақ?
Dialogue: 0,1:00:30.87,1:00:32.79,Default,,0,0,0,,Китагава мырзаның сезімі
Dialogue: 0,1:00:33.87,1:00:37.37,Default,,0,0,0,,Мен енді біраз түсінген сияқтымын.
Dialogue: 0,1:00:38.12,1:00:40.41,Default,,0,0,0,,Сезімдер...?
Dialogue: 0,1:00:41.16,1:00:44.62,Default,,0,0,0,,Кешіріңіз, пайдалы ештеңе айта алмаймын.
Dialogue: 0,1:00:45.12,1:00:46.87,Default,,0,0,0,,Жоқ, аздап
Dialogue: 0,1:00:46.95,1:00:50.62,Default,,0,0,0,,Дегенмен, ең жұмбақ нәрсе - Утаяма-доно.
Dialogue: 0,1:00:50.70,1:00:52.75,Default,,0,0,0,,Неге оғаш нәрселерге мән бермейсің?
Dialogue: 0,1:00:52.83,1:00:55.37,Default,,0,0,0,,- (Дәрі сатушы) Үлкен күріш торттарын тартуды жалғастыра бересіз бе? - Әрине.
Dialogue: 0,1:00:58.37,1:01:00.20,Default,,0,0,0,,Бұл Оку
Dialogue: 0,1:01:00.70,1:01:05.54,Default,,0,0,0,,Рөл үшін сезіміңді құрбан етуге тура келетін кездер болады.
Dialogue: 0,1:01:06.20,1:01:08.16,Default,,0,0,0,,Орындауға болатын-болмайтындығына байланысты.
Dialogue: 0,1:01:08.25,1:01:11.45,Default,,0,0,0,,Адамға маңызды рөлді сеніп тапсыруға болады ма, жоқ па.
Dialogue: 0,1:01:11.54,1:01:13.70,Default,,0,0,0,,Мен байқадым
Dialogue: 0,1:01:14.20,1:01:15.58,Default,,0,0,0,,Китагава мырза да?
Dialogue: 0,1:01:15.66,1:01:16.91,Default,,0,0,0,,Иә.
Dialogue: 0,1:01:18.08,1:01:20.66,Default,,0,0,0,,Сонымен, Mononoke келесі шабуылда не болады?
Dialogue: 0,1:01:24.70,1:01:28.12,Default,,0,0,0,,Екі ай бұрынғыдай мочи тартуды тоқтатсақ
Dialogue: 0,1:01:28.20,1:01:30.45,Default,,0,0,0,,Біртүрлі нәрселер басылады ма?
Dialogue: 0,1:01:30.95,1:01:32.83,Default,,0,0,0,,Бұл Коичи деген жігіт қой! Ә?
Dialogue: 0,1:01:37.87,1:01:39.20,Default,,0,0,0,,Утаяма мырза
Dialogue: 0,1:01:40.83,1:01:42.62,Default,,0,0,0,,(кимононың татамиге үйкелу дыбысы)
Dialogue: 0,1:01:43.16,1:01:45.91,Default,,0,0,0,,Бұл біздің жұмысымыз.
Dialogue: 0,1:01:48.79,1:01:50.16,Default,,0,0,0,,That's right.
Dialogue: 0,1:01:54.08,1:01:55.66,Default,,0,0,0,,Мононокай қорқынышты~
Dialogue: 0,1:01:55.75,1:01:57.12,Default,,0,0,0,,Омочи Хики ше?
Dialogue: 0,1:01:57.20,1:01:59.66,Default,,0,0,0,,Өлім болғанын ескерсек, бұл мүмкін емес.
Dialogue: 0,1:01:59.75,1:02:04.04,Default,,0,0,0,,Омочи Хики жоспарланғандай өтеді.
Dialogue: 0,1:02:04.54,1:02:06.87,Default,,0,0,0,,Сокушинбутсуға ұқсайды.
Dialogue: 0,1:02:06.95,1:02:08.66,Default,,0,0,0,,Марқұм Авашима-саманың орнында.
Dialogue: 0,1:02:08.66,1:02:09.54,Default,,0,0,0,,Марқұм Авашима мырзаның орнына
Dialogue: 0,1:02:08.66,1:02:09.54,Default,,0,0,0,,Мумияланған құбыжыққа айналды
Dialogue: 0,1:02:09.54,1:02:10.20,Default,,0,0,0,,Мумияланған құбыжыққа айналды
Dialogue: 0,1:02:10.20,1:02:11.04,Default,,0,0,0,,Мумияланған құбыжыққа айналды
Dialogue: 0,1:02:10.20,1:02:11.04,Default,,0,0,0,,Мен менмен болсам да, мен үлкен күріш тортын тартуға жауапты боламын.
Dialogue: 0,1:02:11.04,1:02:11.62,Default,,0,0,0,,Мен менмен болсам да, мен үлкен күріш тортын тартуға жауапты боламын.
Dialogue: 0,1:02:11.62,1:02:14.50,Default,,0,0,0,,Мен менмен болсам да, мен үлкен күріш тортын тартуға жауапты боламын.
Dialogue: 0,1:02:11.62,1:02:14.50,Default,,0,0,0,,Авашима-доно, бұл қиын болуы керек.
Dialogue: 0,1:02:14.50,1:02:14.91,Default,,0,0,0,,Мен менмен болсам да, мен үлкен күріш тортын тартуға жауапты боламын.
Dialogue: 0,1:02:15.70,1:02:18.45,Default,,0,0,0,,Бүгінгі үлкен мочи хики қойылымы
Dialogue: 0,1:02:18.95,1:02:23.12,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:02:27.58,1:02:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:36.00,1:02:37.45,Default,,0,0,0,,～…
Dialogue: 0,1:02:37.54,1:02:40.37,Default,,0,0,0,,Ммммммм!
Dialogue: 0,1:02:40.87,1:02:41.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:45.33,1:02:46.70,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:49.37,1:02:50.29,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:02:50.37,1:02:52.29,Default,,0,0,0,,Аспан Ұлы мен оның заңды әйелі және олардың баласы үшін
Dialogue: 0,1:02:52.29,1:02:54.37,Default,,0,0,0,,Аспан Ұлы мен оның заңды әйелі және олардың баласы үшін
Dialogue: 0,1:02:52.29,1:02:54.37,Default,,0,0,0,,Бұл мен жиі байсалды түрде айтатын нәрсе.
Dialogue: 0,1:02:54.45,1:02:56.58,Default,,0,0,0,,Ұлы Мочи Хики міндетті түрде алға жылжу керек.
Dialogue: 0,1:02:56.58,1:02:57.70,Default,,0,0,0,,Ұлы Мочи Хики еш кедергісіз жүруі керек.
Dialogue: 0,1:02:56.58,1:02:57.70,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:02:59.04,1:03:03.25,Default,,0,0,0,,Енді, бәрі, үлкен мочи тарту рәсімінің уақыты келді.
Dialogue: 0,1:03:04.12,1:03:07.16,Default,,0,0,0,,Орныңызды алыңыз.
Dialogue: 0,1:03:09.16,1:03:10.70,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:03:14.87,1:03:16.58,Default,,0,0,0,,(Шулы әңгіме)
Dialogue: 0,1:03:16.66,1:03:18.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:18.12,1:03:22.66,Default,,0,0,0,,Болды, болды, болды!
Dialogue: 0,1:03:23.25,1:03:26.95,Default,,0,0,0,,Болды, болды, болды!
Dialogue: 0,1:03:27.75,1:03:31.41,Default,,0,0,0,,Ол басталғаннан кейін оңай.
Dialogue: 0,1:03:32.00,1:03:35.95,Default,,0,0,0,,Уақыт ешқашан тоқтамайды.
Dialogue: 0,1:03:36.66,1:03:39.95,Default,,0,0,0,,Қатыса алмағаныңыз үшін кешірім сұраймын.
Dialogue: 0,1:03:40.95,1:03:44.83,Default,,0,0,0,,Ештеңе етпейді, сахнаның ар жағында болу деген осындай.
Dialogue: 0,1:03:45.91,1:03:48.54,Default,,0,0,0,,Мен осында болсам, Мононокай болар едім...
Dialogue: 0,1:03:48.62,1:03:51.33,Default,,0,0,0,,Біз алғаш танысқанда не айтылды
Dialogue: 0,1:03:52.04,1:03:55.83,Default,,0,0,0,,Егер сіз алға жылжысаңыз, жоғарыдан басқа көріністі көре аласыз.
Dialogue: 0,1:03:56.91,1:03:59.29,Default,,0,0,0,,Дәл осы Утаяма мырза айтқандай болды.
Dialogue: 0,1:04:00.20,1:04:02.20,Default,,0,0,0,,Мен бұрын сезінген ауырсыну
Dialogue: 0,1:04:03.29,1:04:06.00,Default,,0,0,0,,Мен өзімді елеусіз сезіне бастадым.
Dialogue: 0,1:04:09.04,1:04:13.25,Default,,0,0,0,,Бұл басқалардан жоғары тұрғандардың көзқарасы.
Dialogue: 0,1:04:13.33,1:04:13.95,Default,,0,0,0,,Әй!
Dialogue: 0,1:04:15.45,1:04:18.41,Default,,0,0,0,,Мен өзімді кез келген нәрсеге алаңдамайтынымды көрдім.
Dialogue: 0,1:04:18.50,1:04:20.04,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,1:04:20.12,1:04:25.08,Default,,0,0,0,,Бірақ сонымен бірге мені бір нәрсе артқа тастады.
Dialogue: 0,1:04:26.25,1:04:27.16,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:29.33,1:04:30.62,Default,,0,0,0,,Бұл тасбақа
Dialogue: 0,1:04:31.33,1:04:32.91,Default,,0,0,0,,Тасбақалар ше?
Dialogue: 0,1:04:33.00,1:04:34.66,Default,,0,0,0,,Сіз емдеу туралы шешім қабылдадыңыз ба?
Dialogue: 0,1:04:35.33,1:04:36.41,Default,,0,0,0,,Мен Окамеге Окудан кетуді жазбаша айттым.
Dialogue: 0,1:04:36.41,1:04:39.41,Default,,0,0,0,,Мен Окамеге Окудан кетуді жазбаша айттым.
Dialogue: 0,1:04:36.41,1:04:39.41,Default,,0,0,0,,Мен сенің гочужоң болғым келді.
Dialogue: 0,1:04:40.25,1:04:44.12,Default,,0,0,0,,Әдемі кимоно киіп, императорға ұқсаңыз...
Dialogue: 0,1:04:45.25,1:04:48.12,Default,,0,0,0,,Сіз эмоцияның ықпалына түспей дұрыс шешім қабылдадыңыз.
Dialogue: 0,1:04:48.20,1:04:49.87,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:04:49.95,1:04:54.62,Default,,0,0,0,,Мен де тасбақалармен тамақ жеймін.
Dialogue: 0,1:04:55.54,1:05:00.29,Default,,0,0,0,,Мен кешке дейін көбірек сөйлескім келді.
Dialogue: 0,1:05:03.33,1:05:05.29,Default,,0,0,0,,Китагава мырзаға рахмет
Dialogue: 0,1:05:06.12,1:05:07.20,Default,,0,0,0,,Китагава?
Dialogue: 0,1:05:09.87,1:05:10.50,Default,,0,0,0,,Әй!
Dialogue: 0,1:05:10.58,1:05:12.95,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:05:16.04,1:05:17.87,Default,,0,0,0,,...Мен олай ойламаймын.
Dialogue: 0,1:05:20.45,1:05:22.45,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,1:05:32.45,1:05:33.79,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,1:05:40.54,1:05:41.87,Default,,0,0,0,,Утаяма мырза!
Dialogue: 0,1:05:42.66,1:05:43.29,Default,,0,0,0,,Мононокай?
Dialogue: 0,1:05:45.37,1:05:46.50,Default,,0,0,0,,♬~
Dialogue: 0,1:06:08.41,1:06:10.79,Default,,0,0,0,,Мен оны лақтырып жібердім
Dialogue: 0,1:06:13.41,1:06:14.20,Default,,0,0,0,,Дәрі сатушы!
Dialogue: 0,1:06:27.66,1:06:30.54,Default,,0,0,0,,Мен оны тез өлтіруім керек... Жаман!
Dialogue: 0,1:06:39.20,1:06:39.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:47.20,1:06:50.83,Default,,0,0,0,,Ақиқатты ұғын...Қылышыңды суырмасаң, жеңілерсің!
Dialogue: 0,1:06:51.37,1:06:52.54,Default,,0,0,0,,Утаяма мырза!
Dialogue: 0,1:06:54.58,1:06:55.70,Default,,0,0,0,,Сен нені тастадың?
Dialogue: 0,1:06:56.29,1:06:57.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:58.29,1:07:01.79,Default,,0,0,0,,Ол осы жақтан шығуға тырысады.
Dialogue: 0,1:07:03.75,1:07:04.37,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:04.95,1:07:08.58,Default,,0,0,0,,Неліктен сені Қарағаса көздеп отыр?
Dialogue: 0,1:07:09.12,1:07:10.79,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:07:10.87,1:07:11.95,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,1:07:12.04,1:07:12.83,Default,,0,0,0,,Ха…
Dialogue: 0,1:07:12.91,1:07:13.70,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:07:25.20,1:07:26.00,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,1:07:27.04,1:07:27.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:29.12,1:07:30.20,Default,,0,0,0,,Сиыр!
Dialogue: 0,1:07:30.29,1:07:31.66,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:31.75,1:07:33.25,Default,,0,0,0,,(Хирамотоның ауыр тыныс алуы)
Dialogue: 0,1:07:33.75,1:07:35.70,Default,,0,0,0,,Сабуромару?
Dialogue: 0,1:07:46.87,1:07:48.33,Default,,0,0,0,,Құрғақ
Dialogue: 0,1:07:51.33,1:07:51.95,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:52.04,1:07:53.16,Default,,0,0,0,,Ха…
Dialogue: 0,1:07:56.83,1:07:57.87,Default,,0,0,0,,Китагава мырза?
Dialogue: 0,1:08:05.25,1:08:06.54,Default,,0,0,0,,Китагава мырза!
Dialogue: 0,1:08:07.62,1:08:08.83,Default,,0,0,0,,Китагава?
Dialogue: 0,1:08:12.29,1:08:13.00,Default,,0,0,0,,Мен...
Dialogue: 0,1:08:13.79,1:08:14.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:15.45,1:08:16.62,Default,,0,0,0,,құрғақ
Dialogue: 0,1:08:23.33,1:08:25.83,Default,,0,0,0,,Бұл Китагава-доно.
Dialogue: 0,1:08:27.54,1:08:28.41,Default,,0,0,0,,Қолшатыр...
Dialogue: 0,1:08:34.79,1:08:38.08,Default,,0,0,0,,Бұл дүниеде көрініс
Dialogue: 0,1:08:38.16,1:08:38.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:38.87,1:08:39.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:50.41,1:08:51.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:00.50,1:09:01.12,Default,,0,0,0,,Әй!
Dialogue: 0,1:09:06.91,1:09:07.54,Default,,0,0,0,,Ах
Dialogue: 0,1:09:09.50,1:09:10.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:14.37,1:09:15.00,Default,,0,0,0,,Уф!
Dialogue: 0,1:09:15.08,1:09:15.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:18.95,1:09:19.83,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,1:09:19.91,1:09:21.29,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,1:09:22.70,1:09:23.83,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:09:25.41,1:09:26.33,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,1:09:35.20,1:09:40.12,Default,,0,0,0,,Бірінші рет маңызды нәрсені тастауға мәжбүр болдым
Dialogue: 0,1:09:41.00,1:09:42.62,Default,,0,0,0,,Мен оны ойланбастан лақтырып жібердім
Dialogue: 0,1:09:44.45,1:09:48.79,Default,,0,0,0,,Мен оны лақтырып өзгертуге шешім қабылдадым.
Dialogue: 0,1:09:52.75,1:09:57.41,Default,,0,0,0,,Мен Утаяма-саманың естелігіне ие болу бақытына ие болдым және мен қатардан оңай алға шықтым.
Dialogue: 0,1:10:02.16,1:10:05.95,Default,,0,0,0,,Осы кезде менімен бірге ішкі сарайға бір бала кірді.
Dialogue: 0,1:10:07.95,1:10:08.54,Default,,0,0,0,,(калейдоскопты басқан дыбыс)
Dialogue: 0,1:10:09.66,1:10:12.95,Default,,0,0,0,,Жадысы жақсы, жадысы нашар қызға
Dialogue: 0,1:10:14.95,1:10:17.08,Default,,0,0,0,,Мен жиі тітіркенетін болдым.
Dialogue: 0,1:10:20.41,1:10:23.29,Default,,0,0,0,,Мені үлкен мочи тарту процесінде басты рөлді ойнауды сұраған күні.
Dialogue: 0,1:10:24.33,1:10:28.29,Default,,0,0,0,,Мен оған Окудан кетуін айттым.
Dialogue: 0,1:10:29.66,1:10:34.16,Default,,0,0,0,,Сіз аз уайымдап, жұмысыңызға шоғырлана аласыз.
Dialogue: 0,1:10:35.45,1:10:36.91,Default,,0,0,0,,Мен осылай ойладым
Dialogue: 0,1:10:39.41,1:10:42.29,Default,,0,0,0,,Бірақ олай болмады.
Dialogue: 0,1:10:48.41,1:10:51.91,Default,,0,0,0,,Мен өзім туралы не өзгерді деп ойлай бастадым.
Dialogue: 0,1:10:54.37,1:10:55.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:10:55.87,1:10:58.91,Default,,0,0,0,,Мен құрғағанымды түсіндім.
Dialogue: 0,1:10:59.00,1:11:00.58,Default,,0,0,0,,Ахх...
Dialogue: 0,1:11:02.16,1:11:06.00,Default,,0,0,0,,Оны түсінген кезде жұмыс істеуге деген құлшыныс жоғалады.
Dialogue: 0,1:11:06.66,1:11:08.16,Default,,0,0,0,,Рөліңізді жоғалтты
Dialogue: 0,1:11:10.41,1:11:12.91,Default,,0,0,0,,Мен бөлмемнен шыға алмадым.
Dialogue: 0,1:11:18.00,1:11:22.83,Default,,0,0,0,,Шөлдедім деп бірдеңені лақтырып жіберген шығармын.
Dialogue: 0,1:11:27.58,1:11:28.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:34.45,1:11:36.08,Default,,0,0,0,,Маңызды нәрсе
Dialogue: 0,1:11:37.12,1:11:39.75,Default,,0,0,0,,Мен... сонда.
Dialogue: 0,1:11:47.41,1:11:48.12,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:48.83,1:11:50.45,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:11:50.54,1:11:51.66,Default,,0,0,0,,Жоқ~!
Dialogue: 0,1:11:56.00,1:11:57.12,Default,,0,0,0,,Тасбақа-чан...
Dialogue: 0,1:11:58.75,1:11:59.54,Default,,0,0,0,,Уау
Dialogue: 0,1:12:03.25,1:12:04.37,Default,,0,0,0,,Кяа~!
Dialogue: 0,1:12:04.45,1:12:05.16,Default,,0,0,0,,Әй!
Dialogue: 0,1:12:12.75,1:12:14.00,Default,,0,0,0,,Аса-чан!
Dialogue: 0,1:12:14.08,1:12:15.29,Default,,0,0,0,,Уа!
Dialogue: 0,1:12:16.33,1:12:20.04,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:12:22.33,1:12:24.45,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:12:24.54,1:12:30.29,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,1:12:34.54,1:12:36.12,Default,,0,0,0,,(Қылыш айқайы)
Dialogue: 0,1:12:39.12,1:12:40.58,Default,,0,0,0,,Китагава?
Dialogue: 0,1:12:41.62,1:12:44.37,Default,,0,0,0,,Китагава мырза маған сабақ берді
Dialogue: 0,1:12:46.66,1:12:48.75,Default,,0,0,0,,Шөлдеген жақсы емес
Dialogue: 0,1:12:54.79,1:12:57.33,Default,,0,0,0,,Сіз кек сақтайсыз ба?
Dialogue: 0,1:12:58.29,1:13:02.04,Default,,0,0,0,,Китагава мырза да сізді алаңдатып отырған шығар.
Dialogue: 0,1:13:02.12,1:13:04.00,Default,,0,0,0,,Мен өзімді кек сақтамаймын деп ойлаймын.
Dialogue: 0,1:13:07.83,1:13:08.54,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:11.50,1:13:15.29,Default,,0,0,0,,Бұл менің жұмысым.
Dialogue: 0,1:13:16.25,1:13:17.62,Default,,0,0,0,,Бұл...
Dialogue: 0,1:13:18.66,1:13:19.83,Default,,0,0,0,,Менің...
Dialogue: 0,1:13:21.41,1:13:23.37,Default,,0,0,0,,Жұмыс
Dialogue: 0,1:13:24.37,1:13:26.58,Default,,0,0,0,,Ха ха ха ха!
Dialogue: 0,1:13:30.54,1:13:31.54,Default,,0,0,0,,Уф...
Dialogue: 0,1:13:33.08,1:13:34.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:13:38.70,1:13:40.33,Default,,0,0,0,,Себеп...
Dialogue: 0,1:13:40.83,1:13:42.45,Default,,0,0,0,,көрсетілген
Dialogue: 0,1:13:44.62,1:13:45.75,Default,,0,0,0,,Пішін
Dialogue: 0,1:13:46.25,1:13:47.37,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,1:13:47.87,1:13:49.08,Default,,0,0,0,,Принцип
Dialogue: 0,1:13:49.83,1:13:52.08,Default,,0,0,0,,Үшеуі де бар
Dialogue: 0,1:13:52.16,1:13:54.83,Default,,0,0,0,,Сондықтан қылыш
Dialogue: 0,1:13:54.91,1:13:57.20,Default,,0,0,0,,Босатыңыз... шығарыңыз!
Dialogue: 0,1:13:57.29,1:13:58.50,Default,,0,0,0,,Шығару
Dialogue: 0,1:15:16.87,1:15:18.58,Default,,0,0,0,,Қолшатыр
Dialogue: 0,1:15:20.33,1:15:21.75,Default,,0,0,0,,Сізді кесіңіз
Dialogue: 0,1:15:22.45,1:15:25.16,Default,,0,0,0,,Тазарту, тыныштандыру
Dialogue: 0,1:15:28.00,1:15:29.29,Default,,0,0,0,,Мононоке
Dialogue: 0,1:15:30.25,1:15:31.25,Default,,0,0,0,,Қайтару
Dialogue: 0,1:15:32.00,1:15:33.37,Default,,0,0,0,,Жарқыл!
Dialogue: 0,1:15:50.41,1:15:51.37,Default,,0,0,0,,Мені кешір
Dialogue: 0,1:16:56.04,1:16:57.62,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:16:58.25,1:17:01.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:17:01.08,1:17:01.95,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,1:17:12.00,1:17:13.00,Default,,0,0,0,,Бұл мононоке ме?
Dialogue: 0,1:17:13.08,1:17:13.91,Default,,0,0,0,,Эй
Dialogue: 0,1:17:15.04,1:17:16.62,Default,,0,0,0,,Бірге барайық
Dialogue: 0,1:17:19.00,1:17:21.66,Default,,0,0,0,,Аса Чанның ең маңыздысы не?
Dialogue: 0,1:17:21.75,1:17:22.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:23.08,1:17:24.16,Default,,0,0,0,,Ihi
Dialogue: 0,1:17:26.79,1:17:27.79,Default,,0,0,0,,Олар соншама кінәсіз адамды өлтірді
Dialogue: 0,1:17:27.87,1:17:28.91,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:17:32.00,1:17:33.16,Default,,0,0,0,,О, менің...
Dialogue: 0,1:17:37.62,1:17:41.66,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,1:18:06.04,1:18:09.29,Default,,0,0,0,,Мен өз міндеттерімді орындауға бар күшімді саламын.
Dialogue: 0,1:18:11.00,1:18:11.91,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:18:12.00,1:18:13.79,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:18:20.00,1:18:21.79,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:18:21.87,1:18:23.70,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:18:24.29,1:18:25.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:25.45,1:18:28.45,Default,,0,0,0,,(Алыстан естіледі)
Dialogue: 0,1:18:40.62,1:18:42.50,Default,,0,0,0,,(жылайды)
Dialogue: 0,1:18:50.79,1:18:52.12,Default,,0,0,0,,Көңілді өтіңіз...
Dialogue: 0,1:18:54.54,1:18:56.45,Default,,0,0,0,,Мен қарым-қатынасты аламын.
Dialogue: 0,1:18:58.79,1:18:59.75,Default,,0,0,0,,Хехе
Dialogue: 0,1:19:00.25,1:19:02.62,Default,,0,0,0,,Ахаха хахахаха!
Dialogue: 0,1:19:04.87,1:19:05.58,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:06.37,1:19:07.04,Default,,0,0,0,,Хмм...
Dialogue: 0,1:19:08.95,1:19:11.12,Default,,0,0,0,,Дәрі сатушы!
Dialogue: 0,1:19:13.04,1:19:14.16,Default,,0,0,0,,О...
Dialogue: 0,1:19:21.12,1:19:21.95,Default,,0,0,0,,Уау
Dialogue: 0,1:19:33.95,1:19:35.95,Default,,0,0,0,,Ах... хмм
Dialogue: 0,1:19:39.54,1:19:44.25,Default,,0,0,0,,Мен пішінді әлі көре алмаймын.
Dialogue: 0,1:19:53.50,1:19:54.45,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:58.20,1:19:59.87,Default,,0,0,0,,Мен күлдім
Dialogue: 0,1:20:07.41,1:20:10.00,Default,,0,0,0,,Ах... а
Dialogue: 0,1:20:13.25,1:20:16.16,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:20:27.79,1:20:29.79,Default,,0,0,0,,♪~
Dialogue: 0,1:29:08.41,1:29:10.41,Default,,0,0,0,,~♪
