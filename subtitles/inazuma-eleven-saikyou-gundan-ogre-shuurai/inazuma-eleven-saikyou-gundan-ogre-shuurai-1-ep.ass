Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.05,0:00:37.05,Default,,0,0,0,,<Тенма: Қазіргі уақытта кинотеатрларда көрсетіліп жатқан фильм →
Dialogue: 0,0:00:40.89,0:00:43.89,Default,,0,0,0,,＜Барлығыңыз оны әлі көрдіңіз бе?
Dialogue: 0,0:00:45.87,0:00:49.57,Default,,0,0,0,,Уау! !
Dialogue: 0,0:00:49.57,0:00:53.07,Default,,0,0,0,,＜ Оның шығарылғанын еске алу үшін, бүгін түнде...＞
Dialogue: 0,0:01:34.16,0:01:36.66,Default,,0,0,0,,< Оны асыға күтіңіздер! ＞
Dialogue: 0,0:01:47.01,0:01:49.08,Default,,0,0,0,,<Директорлар Эндо және басқалардың ерлігі→
Dialogue: 0,0:01:49.08,0:01:51.08,Default,,0,0,0,,Соңына дейін тамашалайық! ＞
Dialogue: 0,0:04:21.68,0:04:44.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:44.54,0:04:46.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:46.54,0:04:48.73,Default,,0,0,0,,Соңында...
Dialogue: 0,0:04:48.73,0:04:50.83,Default,,0,0,0,,Міне келдік! !
Dialogue: 0,0:04:54.48,0:04:57.87,Default,,0,0,0,,Оның аты - Эндо но Ками.
Dialogue: 0,0:04:57.87,0:05:01.15,Default,,0,0,0,,Мен футбол үйірмесіне қосылғым келеді.
Dialogue: 0,0:05:01.15,0:05:03.16,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:05:03.16,0:05:06.38,Default,,0,0,0,,Мен футбол клубын Фуми-сенсей басқарады деп естідім.
Dialogue: 0,0:05:06.38,0:05:08.88,Default,,0,0,0,,Мен футбол үйірмесіне қосылғым келеді.
Dialogue: 0,0:05:12.70,0:05:17.39,Default,,0,0,0,,Кешіріңіз, бірақ бұл мектепте футбол үйірмесі жоқ.
Dialogue: 0,0:05:17.39,0:05:19.39,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:05:22.03,0:05:25.65,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:05:25.65,0:06:52.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:52.05,0:06:55.35,Default,,0,0,0,,Бәріміз футбол ойнайық!
Dialogue: 0,0:07:29.69,0:07:42.65,Default,,0,0,0,,Уау! !
Dialogue: 0,0:07:42.65,0:08:16.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:16.85,0:08:20.00,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:08:20.00,0:08:23.69,Default,,0,0,0,,Бадап Срид.
Dialogue: 0,0:08:23.69,0:08:29.15,Default,,0,0,0,,Менің жасақтарымды басқаратын сенсің.
Dialogue: 0,0:08:29.15,0:08:34.00,Default,,0,0,0,,Қараңызшы, бұл сіз жеңуіңіз керек жау.
Dialogue: 0,0:08:34.00,0:08:38.69,Default,,0,0,0,,Бәріміз футбол ойнайық!
Dialogue: 0,0:08:38.69,0:08:42.06,Default,,0,0,0,,Бұл сөз шайтанның сиқыры.
Dialogue: 0,0:08:42.06,0:08:45.35,Default,,0,0,0,,Жолдастар, қазір әлемде→
Dialogue: 0,0:08:45.35,0:08:49.75,Default,,0,0,0,,Футбол деген қорқынышты идеология таралуда.
Dialogue: 0,0:08:49.75,0:08:53.32,Default,,0,0,0,,Іс бұрынғы қалпында жалғаса берсе, болашақты арқалаған балалар артта қалады →
Dialogue: 0,0:08:53.32,0:08:57.69,Default,,0,0,0,,Футбол жанымды алып, әлсіретеді.
Dialogue: 0,0:08:57.69,0:09:02.60,Default,,0,0,0,,Барлығы осы баладан басталды, Эндо но ками.
Dialogue: 0,0:09:02.60,0:09:09.02,Default,,0,0,0,,Тарихтағы бетбұрыс кезеңі 80 жыл бұрын Football Frontier чемпионаты болды.
Dialogue: 0,0:09:09.02,0:09:12.69,Default,,0,0,0,,Бұл тарихты өз қолымызбен өзгертеміз.
Dialogue: 0,0:09:12.69,0:09:15.03,Default,,0,0,0,,Адмирал Хибики.
Dialogue: 0,0:09:15.03,0:09:17.09,Default,,0,0,0,,О, Баусен.
Dialogue: 0,0:09:17.09,0:09:20.48,Default,,0,0,0,,Барлық дайындықтар аяқталды. Жақсы.
Dialogue: 0,0:09:20.48,0:09:22.87,Default,,0,0,0,,Олай болса, мырзалар, бастайық.
Dialogue: 0,0:09:22.87,0:09:26.42,Default,,0,0,0,,Thunder Break операциясы іске қосылды!
Dialogue: 0,0:09:26.42,0:09:29.01,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:09:29.01,0:09:32.69,Default,,0,0,0,,Кеттік! <Сіздің жолыңызда тұрған ең басты жау>
Dialogue: 0,0:09:32.69,0:09:35.10,Default,,0,0,0,,Мен сізге инкарнацияның шынайы күшін көрсетемін!
Dialogue: 0,0:09:35.10,0:09:37.90,Default,,0,0,0,,<Каминаримон рухымен ең үлкен дағдарысқа қарсы тұрыңыз! ＞
Dialogue: 0,0:09:37.90,0:09:40.20,Default,,0,0,0,,Біз футболды қайтарып жатырмыз!
Dialogue: 0,0:11:54.90,0:11:57.70,Default,,0,0,0,,Енді жаттығу жасайық...
Dialogue: 0,0:12:02.16,0:12:05.68,Default,,0,0,0,,Не болды Не болды? Мен көптен бері жаттығу жасамадым.
Dialogue: 0,0:12:05.68,0:12:08.18,Default,,0,0,0,,Сіз жерді жалға алдыңыз ба?
Dialogue: 0,0:12:08.18,0:12:10.17,Default,,0,0,0,,Хмм…. Бұдан былай →
Dialogue: 0,0:12:10.17,0:12:13.35,Default,,0,0,0,,Регби үйірмесімен келіссөздер... Мен солай ойладым (Ханда).
Dialogue: 0,0:12:13.35,0:12:15.99,Default,,0,0,0,,Бәрібір мазақ ет, Янс.
Dialogue: 0,0:12:15.99,0:12:19.91,Default,,0,0,0,,Теннис корты жеті адамға жетеді.
Dialogue: 0,0:12:19.91,0:12:23.51,Default,,0,0,0,,Жер Бос күнде жасасаңыз жақсы емес пе?
Dialogue: 0,0:12:23.51,0:12:26.15,Default,,0,0,0,,Дұрыс. (Шаолин храмы) Ол ешқашан бос болған емес.
Dialogue: 0,0:12:26.15,0:12:30.35,Default,,0,0,0,,Уф~ Біз футбол клубымыз!
Dialogue: 0,0:12:30.35,0:12:33.31,Default,,0,0,0,,Футбол шекарасы!
Dialogue: 0,0:12:33.31,0:12:35.53,Default,,0,0,0,,Биыл осыған барайық.
Dialogue: 0,0:12:35.53,0:12:38.41,Default,,0,0,0,,На Сомеока Ханда. Мен мұны істей алмаймын.
Dialogue: 0,0:12:38.41,0:12:41.80,Default,,0,0,0,,Кабейама Куримацу Шишидо.
Dialogue: 0,0:12:41.80,0:12:46.04,Default,,0,0,0,,Ойынға бар болғаны 7 мүшемен қатыса алмайсыз. Ах!
Dialogue: 0,0:12:46.04,0:12:49.99,Default,,0,0,0,,Сәлем! Менің ойымша, сендер клубқа футбол ойнағыларың келгендіктен қосылдыңдар!
Dialogue: 0,0:12:49.99,0:12:54.86,Default,,0,0,0,,Егер футбол клубы футбол ойнамаса, біз не істейміз?
Dialogue: 0,0:12:54.86,0:12:57.36,Default,,0,0,0,,Ах! Барма.
Dialogue: 0,0:12:57.36,0:13:00.67,Default,,0,0,0,,Жоқ. Рикутоға өтіңіз! Жарайды ату!
Dialogue: 0,0:13:00.67,0:13:02.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:02.72,0:13:07.02,Default,,0,0,0,,Жарайды, ауыстырайық. Келесі Ryota және Terasaka, соғуды жалғастырыңыз!
Dialogue: 0,0:13:09.83,0:13:14.03,Default,,0,0,0,,Жарайсыңдар! (Рюсуке) Менің ажал құшқан оқымды қара!
Dialogue: 0,0:13:14.03,0:13:15.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:15.98,0:13:19.19,Default,,0,0,0,,Ой! (Ясуи) Мына жігітті кім тепті?
Dialogue: 0,0:13:19.19,0:13:22.06,Default,,0,0,0,,Амансың ба? Кешіріңіз.
Dialogue: 0,0:13:22.06,0:13:24.86,Default,,0,0,0,,Маған допты қайтарыңыз...
Dialogue: 0,0:13:26.86,0:13:28.88,Default,,0,0,0,,Эндо-кун!
Dialogue: 0,0:13:28.88,0:13:31.68,Default,,0,0,0,,Бұл доп па?
Dialogue: 0,0:13:36.89,0:13:39.64,Default,,0,0,0,,Бұл Каминаримонда емес пе?
Dialogue: 0,0:13:39.64,0:13:43.39,Default,,0,0,0,,Ясуи мырза: Бұл мүлде мүшелері жоқ әлсіз футбол клубы.
Dialogue: 0,0:13:43.39,0:13:47.89,Default,,0,0,0,,Бұл бос сөз. Балаға доп теу, хи хи!
Dialogue: 0,0:13:49.85,0:13:53.19,Default,,0,0,0,,Ясуи мырза, сізге мысал көрсетсек қалай болады?
Dialogue: 0,0:13:53.19,0:13:57.29,Default,,0,0,0,,Жақсы, жасайық.
Dialogue: 0,0:13:59.73,0:14:01.73,Default,,0,0,0,,Егер Ваму сол затты бірінші қолға алса—
Dialogue: 0,0:14:12.39,0:14:14.41,Default,,0,0,0,,Ясуи-сан!
Dialogue: 0,0:14:14.41,0:14:16.51,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:14:16.51,0:14:18.51,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:14:21.31,0:14:25.90,Default,,0,0,0,,Күте тұрыңыз, сіздің соққыңыз керемет. Сіз футбол ойнайсыз ба?
Dialogue: 0,0:14:25.90,0:14:29.50,Default,,0,0,0,,Сонымен бұл қай мектеп? Қаласаңыз, менімен бірге жаттығуды қалайсыз ба?
Dialogue: 0,0:14:32.21,0:14:34.71,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:14:37.58,0:14:40.38,Default,,0,0,0,,Олар әлі келмеген сияқты.
Dialogue: 0,0:14:43.00,0:14:46.57,Default,,0,0,0,,[Спикер] Түскі асқа кезекші болсаңыз, қызмет көрсету бөлмесіне асығыңыз.
Dialogue: 0,0:14:46.57,0:14:48.61,Default,,0,0,0,,[Спикер] Қайталау. Түскі асқа кезекші...
Dialogue: 0,0:14:48.61,0:14:50.49,Default,,0,0,0,,Гоенджи храмы.
Dialogue: 0,0:14:50.49,0:14:53.68,Default,,0,0,0,,Өйткені мен кеше өзімді дұрыс таныстыра алмадым.
Dialogue: 0,0:14:53.68,0:14:58.07,Default,,0,0,0,,Мен, Мамору Эндо, футбол клубының капитанымын.
Dialogue: 0,0:14:58.07,0:15:01.50,Default,,0,0,0,,Позиция - сақтаушы. Сіз де кіргіңіз келе ме?
Dialogue: 0,0:15:01.50,0:15:05.43,Default,,0,0,0,,Киёси Кидогава - атақты футболшы.
Dialogue: 0,0:15:05.43,0:15:07.93,Default,,0,0,0,,Бұл соққы керемет болуы керек.
Dialogue: 0,0:15:10.01,0:15:12.02,Default,,0,0,0,,Не?
Dialogue: 0,0:15:12.02,0:15:15.03,Default,,0,0,0,,Мен футболдан бас тарттым.
Dialogue: 0,0:15:15.03,0:15:17.39,Default,,0,0,0,,Неліктен бас тарттыңыз?
Dialogue: 0,0:15:17.39,0:15:19.39,Default,,0,0,0,,Мазалама.
Dialogue: 0,0:15:22.31,0:15:25.18,Default,,0,0,0,,Эндо Фуми-сенсэй сізді шақырып жатыр.
Dialogue: 0,0:15:25.18,0:15:28.35,Default,,0,0,0,,Директордың кабинетіне келіңіз. Директордың кабинеті?
Dialogue: 0,0:15:28.35,0:15:30.37,Default,,0,0,0,,Бізде маңызды нәрсе туралы айту керек сияқты.
Dialogue: 0,0:15:30.37,0:15:35.02,Default,,0,0,0,,Менде бұл туралы жағымсыз сезім бар, жойылған клуб туралы әңгіме сияқты.
Dialogue: 0,0:15:35.02,0:15:37.36,Default,,0,0,0,,Жойылды! ?
Dialogue: 0,0:15:37.36,0:15:39.73,Default,,0,0,0,,Мен де солай естігенмін.
Dialogue: 0,0:15:39.73,0:15:43.23,Default,,0,0,0,,Бұл әзіл емес. Сіз тастап кеткен клубты ештеңе жасауға мәжбүрлей алмайсыз!
Dialogue: 0,0:15:46.83,0:15:50.85,Default,,0,0,0,,А, бұл не әңгіме?
Dialogue: 0,0:15:50.85,0:15:52.99,Default,,0,0,0,,Кенет, бір аптадан кейін →
Dialogue: 0,0:15:52.99,0:15:56.04,Default,,0,0,0,,Біздің жаттығу матчын өткізбегенімізге көп уақыт болды.
Dialogue: 0,0:15:56.04,0:15:59.20,Default,,0,0,0,,Қарсылас – Тейкоку Гакуэн.
Dialogue: 0,0:15:59.20,0:16:01.65,Default,,0,0,0,,Империя! ?
Dialogue: 0,0:16:01.65,0:16:07.52,Default,,0,0,0,,Императорлық академия ең күшті деп айтылады ма?
Dialogue: 0,0:16:07.52,0:16:09.91,Default,,0,0,0,,Соңғы 40 жыл→
Dialogue: 0,0:16:09.91,0:16:13.86,Default,,0,0,0,,Бұл Football Frontier чемпионатында жеңіске жетуді жалғастыратын жеңілмейтін мектеп.
Dialogue: 0,0:16:13.86,0:16:16.85,Default,,0,0,0,,Неліктен Жапонияның ең жақсы командасы осында?
Dialogue: 0,0:16:16.85,0:16:19.82,Default,,0,0,0,,Мен мықты футбол клубына қарсы матчқа қуаныштымын→
Dialogue: 0,0:16:19.82,0:16:23.02,Default,,0,0,0,,Қазіргі уақытта тек жеті мүше бар.
Dialogue: 0,0:16:23.02,0:16:25.02,Default,,0,0,0,,Бұл жеткіліксіз болса →
Dialogue: 0,0:16:25.02,0:16:27.52,Default,,0,0,0,,Оларды матчқа дейін жинап алсақ ше? сурет?
Dialogue: 0,0:16:29.51,0:16:34.08,Default,,0,0,0,,Егер сіз жинай алмасаңыз немесе матчты жеңе алмасаңыз →
Dialogue: 0,0:16:34.08,0:16:38.02,Default,,0,0,0,,Футбол клубы жойылды. Бұл шешім.
Dialogue: 0,0:16:38.02,0:16:40.02,Default,,0,0,0,,Өз бетіңізше шешім қабылдамаңыз!
Dialogue: 0,0:16:40.02,0:16:43.64,Default,,0,0,0,,Бұл да президент пен директор қабылдаған шешім.
Dialogue: 0,0:16:43.64,0:16:47.84,Default,,0,0,0,,Бізде мұндай лашықта әлсіз клубқа бюджет жоқ.
Dialogue: 0,0:16:47.84,0:16:50.00,Default,,0,0,0,,Не! ? Эндо мырза.
Dialogue: 0,0:16:50.00,0:16:53.60,Default,,0,0,0,,Нацуми ханымның сөзі төрағаның сөзімен бірдей.
Dialogue: 0,0:16:58.54,0:17:01.02,Default,,0,0,0,,Ал сен.
Dialogue: 0,0:17:01.02,0:17:04.34,Default,,0,0,0,,Сіз бұл матчты ойнаймын дедіңіз бе, Янс?
Dialogue: 0,0:17:04.34,0:17:09.28,Default,,0,0,0,,Мен мұны істеймін! Мен оның тасталған клубқа айналуына жол бермеймін! Мен дәл 11 адамды жинаймын!
Dialogue: 0,0:17:09.28,0:17:13.84,Default,,0,0,0,,Қарсылас – Империя. Бұл мүмкін емес. Бұл мүлдем мүмкін емес!
Dialogue: 0,0:17:13.84,0:17:17.19,Default,,0,0,0,,Тек ұрып-соғудың өзі ұят.
Dialogue: 0,0:17:17.19,0:17:20.31,Default,,0,0,0,,А, демек, клуб жабылды.
Dialogue: 0,0:17:20.31,0:17:22.35,Default,,0,0,0,,Осы клуб бөлмесімен қош бол.
Dialogue: 0,0:17:22.35,0:17:27.75,Default,,0,0,0,,Егер сізде футболға деген сүйіспеншілік болса, мүмкін емес нәрсе мүмкін болады!
Dialogue: 0,0:17:27.75,0:17:31.02,Default,,0,0,0,,Ештеңе басталмаса да, берілме!
Dialogue: 0,0:17:31.02,0:17:33.12,Default,,0,0,0,,Сіз бас тарта алмайсыз!
Dialogue: 0,0:17:36.31,0:17:38.31,Default,,0,0,0,,Футбол клубына келіңіз!
Dialogue: 0,0:17:38.31,0:17:40.35,Default,,0,0,0,,Балалар, сендер өте беймаза екенсіңдер.
Dialogue: 0,0:17:40.35,0:17:43.23,Default,,0,0,0,,Хмм, футбол.
Dialogue: 0,0:17:43.23,0:17:47.54,Default,,0,0,0,,Каземару, сіз үздік ойыншылармен бәсекелескіңіз келетінін айттыңыз, солай ма?
Dialogue: 0,0:17:47.54,0:17:49.99,Default,,0,0,0,,Егер сізге ұнаса, маған хабарлаңыз.
Dialogue: 0,0:17:49.99,0:17:52.66,Default,,0,0,0,,Сабақтан кейін біз темір мұнара алаңында жаттығу жасаймыз.
Dialogue: 0,0:17:52.66,0:17:55.51,Default,,0,0,0,,Ол жаққа келсеңіз жақсы. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:17:55.51,0:17:58.05,Default,,0,0,0,,Бірінші класс жеңіл атлетика дегенді білдіреді.
Dialogue: 0,0:17:58.05,0:18:02.35,Default,,0,0,0,,Футбол клубы? Мен кіре алмаймын.
Dialogue: 0,0:18:02.35,0:18:05.02,Default,,0,0,0,,Ең болмағанда тағы бір адам жинай алмаған кезде →
Dialogue: 0,0:18:05.02,0:18:08.66,Default,,0,0,0,,Неге келіп тағы сұрамайсың? Е, тағы бір адам?
Dialogue: 0,0:18:08.66,0:18:13.90,Default,,0,0,0,,Дұрыс, бұл көз алмасы әлсіз футбол клубын құтқарды→
Dialogue: 0,0:18:13.90,0:18:17.00,Default,,0,0,0,,Керемет емес пе? Хехехе!
Dialogue: 0,0:18:19.89,0:18:21.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:25.44,0:18:27.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:29.31,0:18:31.35,Default,,0,0,0,,Табылды!
Dialogue: 0,0:18:31.35,0:18:33.80,Default,,0,0,0,,Сіз футбол клубына қосылғыңыз келе ме?
Dialogue: 0,0:18:33.80,0:18:37.35,Default,,0,0,0,,《Иә, дұрыс, мен→
Dialogue: 0,0:18:37.35,0:18:39.47,Default,,0,0,0,,Мен осы дәуірдің адамы ретінде осында болдым》
Dialogue: 0,0:18:39.47,0:18:42.96,Default,,0,0,0,,Кел, бірге футбол ойнайық.
Dialogue: 0,0:18:42.96,0:18:46.06,Default,,0,0,0,,Сіз керемет жігіттерге қарсы ойнай аласыз!
Dialogue: 0,0:18:48.15,0:18:50.87,Default,,0,0,0,,Мәселе жоқ, мен оны асыға күтемін.
Dialogue: 0,0:18:50.87,0:18:54.35,Default,,0,0,0,,Не? Эй, сен оны асыға күтіп жүрсің бе?
Dialogue: 0,0:18:54.35,0:18:56.49,Default,,0,0,0,,Не?
Dialogue: 0,0:18:56.49,0:18:59.18,Default,,0,0,0,,Қайтару. тістері.
Dialogue: 0,0:18:59.18,0:19:01.53,Default,,0,0,0,,Қайтару.
Dialogue: 0,0:19:01.53,0:19:03.60,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:19:03.60,0:19:07.18,Default,,0,0,0,,Эндо-камимен бірге жүрген бала.
Dialogue: 0,0:19:07.18,0:19:10.24,Default,,0,0,0,,Соңғы рет тексергенімде ол жерде болмады.
Dialogue: 0,0:19:10.24,0:19:12.24,Default,,0,0,0,,Мен бұл жүзді бірінші рет көріп тұрмын.
Dialogue: 0,0:19:14.14,0:19:16.14,Default,,0,0,0,,Зерттеу.
Dialogue: 0,0:19:16.14,0:19:19.85,Default,,0,0,0,,Бірақ бұл біртүрлі. Эндо но Ками деген кім?
Dialogue: 0,0:19:19.85,0:19:25.52,Default,,0,0,0,,Мұндай нәрсе айналаңыздағы адамдарға қалай әсер етуі мүмкін?
Dialogue: 0,0:19:25.52,0:19:29.02,Default,,0,0,0,,Бұл шынымен сиқыр.
Dialogue: 0,0:21:31.01,0:21:33.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:39.50,0:21:41.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:47.16,0:21:49.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:04.99,0:22:08.31,Default,,0,0,0,,Уау! Мен оны істедім.
Dialogue: 0,0:22:08.31,0:22:10.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:10.85,0:22:14.20,Default,,0,0,0,,Арнайы дайындық ақылсыз.
Dialogue: 0,0:22:14.20,0:22:16.27,Default,,0,0,0,,Каземару?
Dialogue: 0,0:22:16.27,0:22:18.32,Default,,0,0,0,,Менің ойымша, сіз біртүрлі арнайы жаттығу жасап жатырсыз.
Dialogue: 0,0:22:18.32,0:22:20.32,Default,,0,0,0,,А, солай.
Dialogue: 0,0:22:22.90,0:22:25.68,Default,,0,0,0,,Уф... Мен оқи алмаймын.
Dialogue: 0,0:22:25.68,0:22:28.17,Default,,0,0,0,,Сіз мұны оқи аласыз ба?
Dialogue: 0,0:22:28.17,0:22:31.59,Default,,0,0,0,,Иә, мен оқи аламын. Ол сізге атуды қалай тоқтату керектігін айтады.
Dialogue: 0,0:22:31.59,0:22:33.81,Default,,0,0,0,,Иә. Мен → деп жаздым
Dialogue: 0,0:22:33.81,0:22:36.23,Default,,0,0,0,,Ол қарт адам, солай ма? Ата?
Dialogue: 0,0:22:36.23,0:22:39.03,Default,,0,0,0,,Ах. Императорлық Академия →
Dialogue: 0,0:22:39.03,0:22:41.16,Default,,0,0,0,,Жылдамдық та, күш те менің қиялымнан тыс.
Dialogue: 0,0:22:41.16,0:22:43.35,Default,,0,0,0,,Соицу мен басқалардың атуын қалай тоқтатуға болады →
Dialogue: 0,0:22:43.35,0:22:46.84,Default,,0,0,0,,Атамның әдіс-тәсілдерін меңгеруден басқа амалым жоқ деп ойладым.
Dialogue: 0,0:22:46.84,0:22:51.06,Default,,0,0,0,,Империяны жеңгіңіз келеді.
Dialogue: 0,0:22:51.06,0:22:53.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:55.14,0:22:58.75,Default,,0,0,0,,Иә! Иә? Не?
Dialogue: 0,0:22:58.75,0:23:01.25,Default,,0,0,0,,Мен бұл рухқа кірдім!
Dialogue: 0,0:23:03.15,0:23:06.02,Default,,0,0,0,,Рахмет, Каземару.
Dialogue: 0,0:23:06.02,0:23:08.04,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:23:08.04,0:23:10.14,Default,,0,0,0,,Балалар, сендер не істейсіңдер? иә?
Dialogue: 0,0:23:10.14,0:23:13.85,Default,,0,0,0,,Капитан. Сәлем.
Dialogue: 0,0:23:13.85,0:23:15.83,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:23:15.83,0:23:19.14,Default,,0,0,0,,Капитан! Жақсысың ба, Джанс?
Dialogue: 0,0:23:19.14,0:23:22.64,Default,,0,0,0,,Империяға қарсы ойнамас бұрын, сізге қиын болады.
Dialogue: 0,0:23:22.64,0:23:25.32,Default,,0,0,0,,Хаха, жарайды.
Dialogue: 0,0:23:25.32,0:23:27.74,Default,,0,0,0,,Бұл жігіттер, мен келмей тұрып-ақ→
Dialogue: 0,0:23:27.74,0:23:30.33,Default,,0,0,0,,Ол сені бақылап тұрған сияқты.
Dialogue: 0,0:23:30.33,0:23:32.70,Default,,0,0,0,,Басқа спорт клубтарының жігіттеріне Эндо→
Dialogue: 0,0:23:32.70,0:23:35.37,Default,,0,0,0,,Сенің мені шақырғаныңды көргенде... Сәл ғана.
Dialogue: 0,0:23:35.37,0:23:37.97,Default,,0,0,0,,Арнайы дайындық мынаған ұқсас →
Dialogue: 0,0:23:37.97,0:23:40.89,Default,,0,0,0,,Менің кеудем қатты қызып барады.
Dialogue: 0,0:23:40.89,0:23:44.81,Default,,0,0,0,,Капитан! Арнайы тренинг: Маған мұны сізбен бірге жасауға рұқсат етіңіз.
Dialogue: 0,0:23:44.81,0:23:47.21,Default,,0,0,0,,Мен де! Менің де солай жасағым келеді, Жастар!
Dialogue: 0,0:23:47.21,0:23:49.22,Default,,0,0,0,,Біз мұны бірге жасай аламыз ба?
Dialogue: 0,0:23:49.22,0:23:52.00,Default,,0,0,0,,Аа, әрине!
Dialogue: 0,0:23:52.00,0:23:54.32,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:23:54.32,0:23:57.52,Default,,0,0,0,,Уау! Мен сондай қуаныштымын!
Dialogue: 0,0:23:57.52,0:24:00.23,Default,,0,0,0,,Жасайық! Қанекей мынаны істейік!
Dialogue: 0,0:24:00.23,0:24:34.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:36.31,0:24:39.37,Default,,0,0,0,,[Монитор] Доктор Киллард Императорлық Академиясы келді.
Dialogue: 0,0:24:39.37,0:24:43.94,Default,,0,0,0,,[Монитор] Осы уақытқа дейін тарихқа ешқандай кедергі болған жоқ.
Dialogue: 0,0:24:43.94,0:24:46.81,Default,,0,0,0,,[Монитор] Біз бақылауды жалғастырамыз.
Dialogue: 0,0:24:46.81,0:24:48.86,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:24:48.86,0:24:51.24,Default,,0,0,0,,Адмирал Хибики тобы қандай шаралар қолданады →
Dialogue: 0,0:24:51.24,0:24:53.18,Default,,0,0,0,,Себебі мен түсінбеймін.
Dialogue: 0,0:24:53.18,0:24:56.08,Default,,0,0,0,,[Монитор] Түсінікті.
Dialogue: 0,0:24:56.08,0:24:59.08,Default,,0,0,0,,Canon Абайлаңыз.
Dialogue: 0,0:25:03.36,0:25:05.86,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:25:05.86,0:25:07.83,Default,,0,0,0,,Императорлық футбол.
Dialogue: 0,0:25:07.83,0:25:09.91,Default,,0,0,0,,Бастау?
Dialogue: 0,0:25:09.91,0:25:11.91,Default,,0,0,0,,Барыңыз.
Dialogue: 0,0:25:15.02,0:25:17.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:25:21.57,0:25:23.69,Default,,0,0,0,,[Майк] (Какума) Әй, Империяның 1 ұпайы бар!
Dialogue: 0,0:25:23.69,0:25:26.48,Default,,0,0,0,,[Майк] Қандай жылдамдық, қандай қуат.
Dialogue: 0,0:25:26.48,0:25:30.57,Default,,0,0,0,,[Майк] Бұл бүкіл елге әйгілі империяның футболы ма?
Dialogue: 0,0:25:30.57,0:25:33.57,Default,,0,0,0,,[Майк] Бұл Императорлық футболдың шынайы бейнесі ме?
Dialogue: 0,0:25:37.31,0:25:39.66,Default,,0,0,0,,[Майк] Осы жерде ысқыр!
Dialogue: 0,0:25:39.66,0:25:44.36,Default,,0,0,0,,[Майк] Каминаримон орта мектебі Бірінші тайм 10-0 есебімен аяқталды.
Dialogue: 0,0:25:44.36,0:25:46.32,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:25:46.32,0:25:49.34,Default,,0,0,0,,Сөйлесуге де күшің жетпеген сияқты.
Dialogue: 0,0:25:49.34,0:25:52.92,Default,,0,0,0,,Екінші жартыны да жасайсыз ба? Мұны істеудің қажеті жоқ.
Dialogue: 0,0:25:52.92,0:25:57.53,Default,,0,0,0,,Өйткені, бұл матчтың қаншалықты ойланбағанының да шегі бар еді.
Dialogue: 0,0:25:57.53,0:25:59.70,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен мұны әлі жасаймын!
Dialogue: 0,0:25:59.70,0:26:01.98,Default,,0,0,0,,Жеңіс құдайы қайда күледі →
Dialogue: 0,0:26:01.98,0:26:04.85,Default,,0,0,0,,Соңына дейін әрекет етпейінше, сіз ешқашан білмейсіз.
Dialogue: 0,0:26:04.85,0:26:07.49,Default,,0,0,0,,Дұрыс па? Бәріңе сәлем!
Dialogue: 0,0:26:07.49,0:26:10.21,Default,,0,0,0,,Бұл мүлдем күлкілі.
Dialogue: 0,0:26:10.21,0:26:14.36,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ ойынға қалай сонша байыпты қарауға болады?
Dialogue: 0,0:26:14.36,0:26:17.80,Default,,0,0,0,,Оның жеңіске жету мүмкіндігі жоқ деп есептейді.
Dialogue: 0,0:26:17.80,0:26:19.85,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:26:19.85,0:26:21.83,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:26:21.83,0:26:26.52,Default,,0,0,0,,Жоғарыда аталған жұмбақ бала, әрине, сол дәуірдің тіршілік формасы емес.
Dialogue: 0,0:26:26.52,0:26:30.01,Default,,0,0,0,,Ол үшін уақыт басқаша өтіп бара жатқан сияқты.
Dialogue: 0,0:26:30.01,0:26:32.03,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:26:32.03,0:26:35.48,Default,,0,0,0,,Жұмбақ баланы зерттеуді жалғастырыңыз.
Dialogue: 0,0:26:35.48,0:26:39.19,Default,,0,0,0,,Біз тарихтың басталғалы тұрған бетбұрыс кезеңінде тұрмыз→
Dialogue: 0,0:26:39.19,0:26:42.05,Default,,0,0,0,,Шайқау. Не айтқың келеді?
Dialogue: 0,0:26:42.05,0:26:46.31,Default,,0,0,0,,Шууя Гоэндзи есімді бала дағдарыста→
Dialogue: 0,0:26:46.31,0:26:50.06,Default,,0,0,0,,Бұл Endo no kami-ге көп қатысы бар.
Dialogue: 0,0:26:50.06,0:26:55.56,Default,,0,0,0,,Егер ол осы жаттығу матчына қатыса алмаса...
Dialogue: 0,0:26:57.70,0:27:00.16,Default,,0,0,0,,[Майк] Енді екінші жартысы басталады.
Dialogue: 0,0:27:00.16,0:27:02.19,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:27:02.19,0:27:04.98,Default,,0,0,0,,Өлім аймағы басталады.
Dialogue: 0,0:27:04.98,0:27:07.06,Default,,0,0,0,,Ал сол жігіт→
Dialogue: 0,0:27:07.06,0:27:09.06,Default,,0,0,0,,Мені сүйреп шығарыңыз!
Dialogue: 0,0:27:26.25,0:27:29.05,Default,,0,0,0,,Сіз оны әшкерелегенше жүре беріңіз.
Dialogue: 0,0:27:39.35,0:27:42.31,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:27:42.31,0:27:45.03,Default,,0,0,0,,Шық.
Dialogue: 0,0:27:45.03,0:27:48.54,Default,,0,0,0,,Шық! Әйтпесе →
Dialogue: 0,0:27:48.54,0:27:51.56,Default,,0,0,0,,Анау соңғысы, анау...
Dialogue: 0,0:27:51.56,0:27:53.56,Default,,0,0,0,,Оны ұрып тастаңыз!
Dialogue: 0,0:27:59.18,0:28:01.20,Default,,0,0,0,,О, мына жігіттер...
Dialogue: 0,0:28:01.20,0:28:03.27,Default,,0,0,0,,Гол соғу мақсат емес.
Dialogue: 0,0:28:03.27,0:28:05.57,Default,,0,0,0,,Мақсаты Эндоны жою.
Dialogue: 0,0:28:07.51,0:28:11.03,Default,,0,0,0,,Ақымақ болма. Бұл сияқты. Осылай...
Dialogue: 0,0:28:11.03,0:28:13.01,Default,,0,0,0,,Бұл футбол емес!
Dialogue: 0,0:28:13.01,0:28:15.06,Default,,0,0,0,,Каземару! Каземару-кун!
Dialogue: 0,0:28:15.06,0:28:17.06,Default,,0,0,0,,Каземару!
Dialogue: 0,0:28:20.65,0:28:23.04,Default,,0,0,0,,Каземару! Каземару!
Dialogue: 0,0:28:23.04,0:28:26.03,Default,,0,0,0,,Endo….
Dialogue: 0,0:28:26.03,0:28:29.35,Default,,0,0,0,,Мен сіздің сезімдеріңізді қабылдаймын.
Dialogue: 0,0:28:29.35,0:28:33.15,Default,,0,0,0,,Мен бұл мақсатты міндетті түрде қорғаймын!
Dialogue: 0,0:28:35.17,0:28:38.97,Default,,0,0,0,,Хмм, мен оны бір рет те қорғай алмадым.
Dialogue: 0,0:28:41.09,0:28:43.09,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:28:46.00,0:28:49.50,Default,,0,0,0,,Мен сізге бұл кадр туралы шешім қабылдауға рұқсат бермеймін!
Dialogue: 0,0:29:00.73,0:29:02.73,Default,,0,0,0,,[Майк] 19-тармақ!
Dialogue: 0,0:29:04.66,0:29:07.52,Default,,0,0,0,,[Майк] Және Каминаримонның басталуы →
Dialogue: 0,0:29:07.52,0:29:10.50,Default,,0,0,0,,Көзіңнен басқа тұра алмайсың!
Dialogue: 0,0:29:10.50,0:29:13.50,Default,,0,0,0,,Жоқ, мен енді мұны істей алмаймын!
Dialogue: 0,0:29:16.51,0:29:19.55,Default,,0,0,0,,[Майк] Ол Каминаримонның 10 → нөмерін шешіп алды
Dialogue: 0,0:29:19.55,0:29:21.61,Default,,0,0,0,,Жүлде матчтан айырылады.
Dialogue: 0,0:29:21.61,0:29:25.82,Default,,0,0,0,,[Майк] Каминаримон Eleven 10 адамға дейін қысқарды.
Dialogue: 0,0:29:25.82,0:29:28.20,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:29:28.20,0:29:30.57,Default,,0,0,0,,Бұл мүмкін емес. (Хэми) Балалар сендер үшін →
Dialogue: 0,0:29:30.57,0:29:34.07,Default,,0,0,0,,Бізден бір ұпайды да алмаңыз.
Dialogue: 0,0:29:36.15,0:29:40.58,Default,,0,0,0,,Ол жігіттерден бір ұпай да ала алмайсың.
Dialogue: 0,0:29:40.58,0:29:43.99,Default,,0,0,0,,Демек, бұл жаман команда болды.
Dialogue: 0,0:29:43.99,0:29:45.99,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:29:48.69,0:29:53.36,Default,,0,0,0,,Әлі біткен жоқ...
Dialogue: 0,0:29:53.36,0:29:56.46,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:30:00.02,0:30:03.37,Default,,0,0,0,,《Юка футболды жақсы көреді.
Dialogue: 0,0:30:03.37,0:30:07.03,Default,,0,0,0,,Маған қолдау көрсету үшін жолда осындай жағдай болды...
Dialogue: 0,0:30:07.03,0:30:10.88,Default,,0,0,0,,Юка әлі ұйықтап жатыр.
Dialogue: 0,0:30:10.88,0:30:14.47,Default,,0,0,0,,Сондықтан мен де футболдан бас тартамын.
Dialogue: 0,0:30:14.47,0:30:17.69,Default,,0,0,0,,Мен осылай шештім...
Dialogue: 0,0:30:17.69,0:30:21.09,Default,,0,0,0,,Оның ешқашан берілмейтін жауынгерлік рухы →
Dialogue: 0,0:30:21.09,0:30:23.86,Default,,0,0,0,,Мені шайқаңыз》
Dialogue: 0,0:30:23.86,0:30:26.80,Default,,0,0,0,,Дәл осы жолы, інім →
Dialogue: 0,0:30:26.80,0:30:28.80,Default,,0,0,0,,Сіз мені кешіресіз бе?
Dialogue: 0,0:30:31.20,0:30:33.22,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,0:30:33.22,0:30:36.22,Default,,0,0,0,,[Майк] Бұл империя үшін 20-шы нүкте!
Dialogue: 0,0:30:38.22,0:30:40.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:30:45.50,0:30:48.90,Default,,0,0,0,,Юка! Неліктен?
Dialogue: 0,0:30:48.90,0:30:51.52,Default,,0,0,0,,Жоқ! Сіз бірінші қадамды жасадыңыз ба?
Dialogue: 0,0:30:51.52,0:30:55.01,Default,,0,0,0,,Бауырым, барма.
Dialogue: 0,0:30:55.01,0:30:58.61,Default,,0,0,0,,Бауырым, ұмыттың ба?
Dialogue: 0,0:30:58.61,0:31:02.80,Default,,0,0,0,,Менімен болған оқиға футболдың кесірінен болды.
Dialogue: 0,0:31:02.80,0:31:05.77,Default,,0,0,0,,Сонда да мен футболды жек көремін→
Dialogue: 0,0:31:05.77,0:31:09.02,Default,,0,0,0,,Сенің ағаң мұны істей ме?
Dialogue: 0,0:31:09.02,0:31:10.99,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:31:10.99,0:31:14.19,Default,,0,0,0,,Мен Юкамын! Сен не туралы айтып тұрсың?
Dialogue: 0,0:31:14.19,0:31:17.06,Default,,0,0,0,,Юка менің футбол ойнайтынымды бәрінен де жақсы біледі→
Dialogue: 0,0:31:17.06,0:31:19.06,Default,,0,0,0,,Ол менімен мақтанатын.
Dialogue: 0,0:31:21.00,0:31:24.10,Default,,0,0,0,,Юка футболды жек көрмейді!
Dialogue: 0,0:31:33.66,0:31:42.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:31:42.72,0:31:45.66,Default,,0,0,0,,[Майк] О? Мүмкін ол...
Dialogue: 0,0:31:45.66,0:31:49.34,Default,,0,0,0,,[Майк] Былтырғы Football Frontier-де, ол бірінші курс студенті болса да →
Dialogue: 0,0:31:49.34,0:31:55.03,Default,,0,0,0,,Шуя Гоенджи өзінің күшті соққысымен әп-сәтте қаһарманға айналды!
Dialogue: 0,0:31:55.03,0:31:58.15,Default,,0,0,0,,[Майк] Гоенджи Каминаримон формасын киген→
Dialogue: 0,0:31:58.15,0:32:01.67,Default,,0,0,0,,Біздің алдымызда пайда болды!
Dialogue: 0,0:32:01.67,0:32:05.19,Default,,0,0,0,,Күте тұрыңыз! Сіз біздің футбол клубымыздасыз...
Dialogue: 0,0:32:05.19,0:32:07.99,Default,,0,0,0,,Жақсы, біз.
Dialogue: 0,0:32:10.75,0:32:14.65,Default,,0,0,0,,Олай болса... Императорлық академия бекіткеннен бері →
Dialogue: 0,0:32:14.65,0:32:17.71,Default,,0,0,0,,Ойыншыларды ауыстыруға рұқсат етіледі. Гоенджи храмы!
Dialogue: 0,0:32:17.71,0:32:19.69,Default,,0,0,0,,Келдің ғой... Уф!
Dialogue: 0,0:32:19.69,0:32:21.64,Default,,0,0,0,,Амансың ба? Аа….
Dialogue: 0,0:32:21.64,0:32:25.01,Default,,0,0,0,,Сіз тым кеш қалдыңыз.
Dialogue: 0,0:32:25.01,0:32:30.80,Default,,0,0,0,,[Майк] Каминаримон Меганды жаңа 10 нөмірімен ауыстырды, Гоенджи Temple!
Dialogue: 0,0:32:30.80,0:32:33.64,Default,,0,0,0,,Біздің мақсатымыз осы жерден басталады.
Dialogue: 0,0:32:33.64,0:32:36.06,Default,,0,0,0,,Түсіндім, сен соны аңдып жүрсің...
Dialogue: 0,0:32:40.40,0:32:42.70,Default,,0,0,0,,Өлім аймағына барыңыз.
Dialogue: 0,0:32:50.67,0:32:55.13,Default,,0,0,0,,[Майк] А, мен жүгірдім! Бірақ қандай да бір себептермен Гоенджи артқа қарай жүгіреді!
Dialogue: 0,0:32:55.13,0:32:58.70,Default,,0,0,0,,[Майк] Ол Эндоның соңынан ермейді және Тейкоку мақсатына жалғыз көтеріледі!
Dialogue: 0,0:32:58.70,0:33:02.75,Default,,0,0,0,,Не! ? [Майк] Көз ақшамен бірдей, жаудың алдынан қашады! ?
Dialogue: 0,0:33:02.75,0:33:07.72,Default,,0,0,0,,Ол маған сенгендіктен жүгіріп жүр. Мен оны тоқтатамын.
Dialogue: 0,0:33:07.72,0:33:12.02,Default,,0,0,0,,Мұны тоқтатқан менен міндетті түрде жолдама алатыныңызға сеніңіз!
Dialogue: 0,0:33:18.33,0:33:20.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:26.41,0:33:31.15,Default,,0,0,0,,[Майк] Тоқтады! Ақыры Империяның атуын тоқтаттық!
Dialogue: 0,0:33:31.15,0:33:33.73,Default,,0,0,0,,Бар, Гуэнджи!
Dialogue: 0,0:33:33.73,0:33:36.73,Default,,0,0,0,,[Майк] Ал доп Гоенджиге кетті!
Dialogue: 0,0:33:46.18,0:33:48.98,Default,,0,0,0,,Бұл аты аңызға айналған өрт торнадосы! Бұл шынайы!
Dialogue: 0,0:33:55.00,0:33:57.44,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,0:33:57.44,0:33:59.86,Default,,0,0,0,,Ақырында Каминаримон Он бір→
Dialogue: 0,0:33:59.86,0:34:03.46,Default,,0,0,0,,Мен Тейкоку Гакуэннен бір ұпай алдым!
Dialogue: 0,0:34:07.20,0:34:09.32,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:34:09.32,0:34:13.79,Default,,0,0,0,,Мен жаңа ғана Тейкоку Гакуэннен матчтан бас тарту туралы ұсыныс алдым→
Dialogue: 0,0:34:13.79,0:34:16.59,Default,,0,0,0,,Ойын осында аяқталады.
Dialogue: 0,0:34:19.65,0:34:24.07,Default,,0,0,0,,Сәтсіздік дегеніміз не? Гуэндзи Шуя да →
Dialogue: 0,0:34:24.07,0:34:27.35,Default,,0,0,0,,Сіз Эндо-камидің сиқырының әсерінен болдыңыз ба?
Dialogue: 0,0:34:27.35,0:34:30.47,Default,,0,0,0,,Мысалдағы бала ешқандай қозғалыс көрсетпейді.
Dialogue: 0,0:34:30.47,0:34:33.38,Default,,0,0,0,,Хмм. Келесі қадамды жасаңыз.
Dialogue: 0,0:34:33.38,0:34:35.48,Default,,0,0,0,,Енді Король азуының сұрыпты.
Dialogue: 0,0:34:35.48,0:34:38.53,Default,,0,0,0,,Жоқ, олар – козир.
Dialogue: 0,0:34:38.53,0:34:43.37,Default,,0,0,0,,Осы дәуірдің факторларын барынша пайдалануымыз керек емес пе?
Dialogue: 0,0:34:43.37,0:34:48.82,Default,,0,0,0,,Га. Осыдан кейін Каминаримон орта мектебі Football Frontier-ге қатысады→
Dialogue: 0,0:34:48.82,0:34:50.86,Default,,0,0,0,,Қандай шайқау?
Dialogue: 0,0:34:50.86,0:34:54.43,Default,,0,0,0,,Қай жерде апат болатынын білмейміз.
Dialogue: 0,0:34:54.43,0:35:01.03,Default,,0,0,0,,Мысалы, Шуя Гоенджидің қарындасы сияқты.
Dialogue: 0,0:35:03.11,0:35:07.48,Default,,0,0,0,,Жарайсыңдар бәріңе! Жаттығу матчтары және футбол шекаралық округтік іріктеу →
Dialogue: 0,0:35:07.48,0:35:09.56,Default,,0,0,0,,Жеңіске жетейік!
Dialogue: 0,0:35:09.56,0:38:28.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:38:31.66,0:38:34.26,Default,,0,0,0,,≪Қайда? ≪Сіз қуатты адамсыз ба? ?
Dialogue: 0,0:38:36.87,0:38:38.84,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:38:38.84,0:38:40.94,Default,,0,0,0,,<Сава да ең күшті футболға ғашық болды>
Dialogue: 0,0:41:03.55,0:41:05.60,Default,,0,0,0,,Бұл не үшін? Кидо.
Dialogue: 0,0:41:05.60,0:41:08.05,Default,,0,0,0,,Ақырында, бұл финал.
Dialogue: 0,0:41:08.05,0:41:12.05,Default,,0,0,0,,Маған қазір күшті Каминаримон кіші орта мектебімен батыл күресуге рұқсат етіңіз.
Dialogue: 0,0:41:14.19,0:41:16.64,Default,,0,0,0,,Империя жеңіп шықты.
Dialogue: 0,0:41:16.64,0:41:19.06,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:41:19.06,0:41:25.22,Default,,0,0,0,,Жақсы командир - шайқас басталмай тұрып жеңіске жету туралы шешім қабылдаған адам.
Dialogue: 0,0:41:25.22,0:41:30.66,Default,,0,0,0,,[Майк] (Какума) Футболдан шекаралық округтік турнирдің финалы!
Dialogue: 0,0:41:30.66,0:41:36.73,Default,,0,0,0,,[Майк] Каминаримон кіші орта және Тейкоку академиясы басталады.
Dialogue: 0,0:41:44.34,0:41:46.36,Default,,0,0,0,,Ах! Не айтқың келеді! ?
Dialogue: 0,0:41:46.36,0:41:50.38,Default,,0,0,0,,Кенет Каминаримонның ортасында төбеден болат арқалықтар жауды!
Dialogue: 0,0:41:50.38,0:41:52.40,Default,,0,0,0,,[Майк] Үлкен апат болды!
Dialogue: 0,0:41:52.40,0:41:56.40,Default,,0,0,0,,Барлығына! Осыншама жерге барамын деп ойламадым...
Dialogue: 0,0:42:02.54,0:42:06.64,Default,,0,0,0,,[Майк] Бұл қорқынышты! Жерде болат арқалықтар тесілген тесіктерге толы.
Dialogue: 0,0:42:06.64,0:42:09.35,Default,,0,0,0,,[Майк] Бұл сондай-ақ Каминаримон Junior High Он бірінші дегенді білдіреді...
Dialogue: 0,0:42:09.35,0:42:11.33,Default,,0,0,0,,[Майк] Иә?
Dialogue: 0,0:42:11.33,0:42:13.65,Default,,0,0,0,,[Майк] Каминаримон Junior High Eleven қауіпсіз!
Dialogue: 0,0:42:13.65,0:42:16.30,Default,,0,0,0,,[Майк] Тіпті ешкім зардап шекпеген сияқты!
Dialogue: 0,0:42:16.30,0:42:18.49,Default,,0,0,0,,[Майк] Бұл керемет!
Dialogue: 0,0:42:18.49,0:42:23.03,Default,,0,0,0,,Кидоу, матч басталса да қозғалмаңдар→ деді
Dialogue: 0,0:42:23.03,0:42:26.01,Default,,0,0,0,,Бұл оқиға болды ма?
Dialogue: 0,0:42:26.01,0:42:28.57,Default,,0,0,0,,Тағы бір сәтсіздік! ?
Dialogue: 0,0:42:28.57,0:42:32.04,Default,,0,0,0,,Рейджи Кагеяма осындай нәрсе ме?
Dialogue: 0,0:42:32.04,0:42:34.49,Default,,0,0,0,,Тіпті Кагеяманың күшімен→
Dialogue: 0,0:42:34.49,0:42:38.58,Default,,0,0,0,,Endo no kami жою мүмкін емес...
Dialogue: 0,0:42:38.58,0:42:43.18,Default,,0,0,0,,Міне, менсінбей қарауға болмайтын жалғыз нәрсе.
Dialogue: 0,0:42:49.19,0:42:52.27,Default,,0,0,0,,[Майк] Футболдан шекаралық округтік турнирдің финалы.
Dialogue: 0,0:42:52.27,0:42:58.01,Default,,0,0,0,,[Майк] Жеңімпаз Империя немесе Каминаримон бола ма? ?
Dialogue: 0,0:43:00.08,0:43:02.58,Default,,0,0,0,,[Майк] Енді, бірінші шабуыл жасайтын жер - Каминаримон!
Dialogue: 0,0:43:04.54,0:43:06.64,Default,,0,0,0,,Someoka! Жақсы!
Dialogue: 0,0:43:15.90,0:43:18.40,Default,,0,0,0,,Пауэр Shield!
Dialogue: 0,0:43:24.81,0:43:26.82,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:43:26.82,0:43:29.82,Default,,0,0,0,,Император пингвині….
Dialogue: 0,0:43:31.85,0:43:34.35,Default,,0,0,0,,№ 2!
Dialogue: 0,0:43:36.85,0:43:40.91,Default,,0,0,0,,[Майк] Бұл не? ? Бұрын-соңды көрмеген керемет кадр →
Dialogue: 0,0:43:40.91,0:43:43.36,Default,,0,0,0,,Каминаримон мақсатына жақындау!
Dialogue: 0,0:43:43.36,0:43:45.36,Default,,0,0,0,,Бұл матч, Кидоу!
Dialogue: 0,0:44:05.06,0:44:07.52,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,0:44:07.52,0:44:09.50,Default,,0,0,0,,[Майк] Imperial Academy Preemptive!
Dialogue: 0,0:44:09.50,0:44:12.85,Default,,0,0,0,,[Майк] Темірдей киінген Құдай қолын жеңген → болды
Dialogue: 0,0:44:12.85,0:44:15.31,Default,,0,0,0,,Империяның жаңа ерекше кадры!
Dialogue: 0,0:44:15.31,0:44:17.31,Default,,0,0,0,,[Майк] Доп бұл...
Dialogue: 0,0:44:17.31,0:44:19.39,Default,,0,0,0,,[Майк] Кидоға! және….
Dialogue: 0,0:44:19.39,0:44:21.89,Default,,0,0,0,,[Майк] Сакума. Кидо дегенге қайта келу.
Dialogue: 0,0:44:25.40,0:44:29.40,Default,,0,0,0,,[Майк] Жаңа арнайы қозғалыс Эндуға шабуыл жасайды!
Dialogue: 0,0:44:32.36,0:44:36.01,Default,,0,0,0,,[Майк] Эндо Допқа тоқтаусыз соққылар сериясы.
Dialogue: 0,0:44:36.01,0:44:39.01,Default,,0,0,0,,[Майк] Каминаримон да арнайы қозғалыспен қарсы тұрады.
Dialogue: 0,0:44:45.54,0:44:47.54,Default,,0,0,0,,Қуат қалқандарына қолданылмайды!
Dialogue: 0,0:44:49.51,0:44:54.53,Default,,0,0,0,,Пауэр Shield – соққы толқындарынан жасалған қабырға. Әлсіз жері - оның жұқалығы.
Dialogue: 0,0:44:54.53,0:44:57.47,Default,,0,0,0,,Алыстан ұшатын заттарды кері қайтаруға болатын болса да →
Dialogue: 0,0:44:57.47,0:45:00.20,Default,,0,0,0,,Жақын жерден итерсеңіз... не! ?
Dialogue: 0,0:45:00.20,0:45:02.65,Default,,0,0,0,,Жарылыңыз!
Dialogue: 0,0:45:02.65,0:45:05.02,Default,,0,0,0,,Айдаһар торнадосы!
Dialogue: 0,0:45:05.02,0:45:08.06,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,0:45:08.06,0:45:11.06,Default,,0,0,0,,[Майк] Каминаримон Бұл галстук! Жақсы!
Dialogue: 0,0:45:15.40,0:45:17.40,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:45:19.35,0:45:21.35,Default,,0,0,0,,Император пингвині….
Dialogue: 0,0:45:23.56,0:45:25.56,Default,,0,0,0,,№ 2!
Dialogue: 0,0:45:27.66,0:45:29.73,Default,,0,0,0,,《Мүлдем тоқтат! 》
Dialogue: 0,0:45:29.73,0:45:32.73,Default,,0,0,0,,Құдайдың қолы!
Dialogue: 0,0:45:35.99,0:45:38.69,Default,,0,0,0,,[Майк] Құдайдың қолы қайтадан басылады!
Dialogue: 0,0:45:38.69,0:45:41.68,Default,,0,0,0,,[Майк] Өйткені, ол №2 император пингвиніне сәйкес келмейді! ?
Dialogue: 0,0:45:41.68,0:45:43.70,Default,,0,0,0,,Endo!
Dialogue: 0,0:45:43.70,0:45:45.71,Default,,0,0,0,,[Майк] Эндуды итеріп жіберді.
Dialogue: 0,0:45:45.71,0:45:50.21,Default,,0,0,0,,[Майк] Егер біз оны тоқтата алмасақ, біз мақсатқа жетеміз.
Dialogue: 0,0:45:52.19,0:45:56.14,Default,,0,0,0,,Бұл доп мүлдем, абсолютті...
Dialogue: 0,0:45:56.14,0:45:58.99,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:45:58.99,0:46:01.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:01.40,0:46:04.70,Default,,0,0,0,,[Майк] Екі қолы бар құдайдың қолы қандай!
Dialogue: 0,0:46:06.67,0:46:08.69,Default,,0,0,0,,[Майк] Тоқтады!
Dialogue: 0,0:46:08.69,0:46:11.09,Default,,0,0,0,,Endo! (Казэмару және т.б.) Капитан!
Dialogue: 0,0:46:11.09,0:46:13.84,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:46:13.84,0:46:18.01,Default,,0,0,0,,《Казэмару: Энду қорғаған бұл доп...》
Dialogue: 0,0:46:18.01,0:46:20.01,Default,,0,0,0,,《Мүлдем! 》
Dialogue: 0,0:46:23.92,0:46:26.17,Default,,0,0,0,,[Майк] Бұл найзағай ма? ?
Dialogue: 0,0:46:26.17,0:46:29.17,Default,,0,0,0,,Толық қуат қалқаны!
Dialogue: 0,0:46:37.33,0:46:39.37,Default,,0,0,0,,Не! ?
Dialogue: 0,0:46:39.37,0:46:42.67,Default,,0,0,0,,[Майк] Бір қызығы, Эндо Кабейаманың артынан келді!
Dialogue: 0,0:46:42.67,0:46:44.67,Default,,0,0,0,,Уау! Хаха!
Dialogue: 0,0:46:49.61,0:46:51.61,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:47:05.01,0:47:08.31,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,0:47:08.31,0:47:10.30,Default,,0,0,0,,Иә! !
Dialogue: 0,0:47:10.30,0:47:13.00,Default,,0,0,0,,[Майк] Бұл шешілді!
Dialogue: 0,0:47:13.00,0:47:20.53,Default,,0,0,0,,[Майк] Допқа барлығы қатысты, тіпті қақпашы Эндо да, барлығы ұпай алу үшін футбол ойнады!
Dialogue: 0,0:47:20.53,0:47:22.54,Default,,0,0,0,,[Майк] Ойын осында аяқталады!
Dialogue: 0,0:47:22.54,0:47:24.60,Default,,0,0,0,,[Майк] Каминаримон Кіші Жоғары Жеңіс!
Dialogue: 0,0:47:24.60,0:47:29.48,Default,,0,0,0,,[Майк] 40 жыл бойы жеңілмеген Император академиясы ақыры жеңілді!
Dialogue: 0,0:47:29.48,0:47:32.00,Default,,0,0,0,,Келесі - ұлттық турнир.
Dialogue: 0,0:47:32.00,0:47:35.02,Default,,0,0,0,,А, мен сендер үшін барымды саламын!
Dialogue: 0,0:47:35.02,0:47:38.33,Default,,0,0,0,,Иә? Сіз білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:47:38.33,0:47:40.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:40.31,0:47:43.36,Default,,0,0,0,,Тейкоку Гакуэн де ұлттық турнирге қатысады.
Dialogue: 0,0:47:43.36,0:47:47.99,Default,,0,0,0,,Өткен жылғы жеңімпаз командаға автоматты түрде орын беріледі.
Dialogue: 0,0:47:47.99,0:47:50.02,Default,,0,0,0,,Ех! ?
Dialogue: 0,0:47:50.02,0:47:54.41,Default,,0,0,0,,Империя мен менің миссиям жеңіліссіз қалу болды.
Dialogue: 0,0:47:54.41,0:47:57.70,Default,,0,0,0,,Бірақ бізде жаңа мақсат бар.
Dialogue: 0,0:47:57.70,0:47:59.65,Default,,0,0,0,,Мақсат?
Dialogue: 0,0:47:59.65,0:48:03.72,Default,,0,0,0,,Кіші орта Каминаримонға қарсы реванш ұлттық турнирде орындалады.
Dialogue: 0,0:48:03.72,0:48:07.72,Default,,0,0,0,,Түсіндім! Олар Тейкоку академиясымен тағы да күресе алады ма?
Dialogue: 0,0:48:23.82,0:48:27.73,Default,,0,0,0,,<``Inazuma Eleven Go'' туралы ойласаңыз, бәрі мақал туралы!
Dialogue: 0,0:48:27.73,0:48:32.33,Default,,0,0,0,,Бүгін мен сізге «CoroCoro Comic» туралы хабарлаймын→
Dialogue: 0,0:48:52.00,0:48:56.00,Default,,0,0,0,,<Әркімнің санасы менен артық>
Dialogue: 0,0:49:16.07,0:49:18.07,Default,,0,0,0,,< Міне! ＞
Dialogue: 0,0:49:23.35,0:49:25.40,Default,,0,0,0,,<Құттықтаймыз.
Dialogue: 0,0:49:25.40,0:49:29.00,Default,,0,0,0,,Барлық өтініштеріңіз үшін рахмет! ＞
Dialogue: 0,0:52:00.02,0:52:04.64,Default,,0,0,0,,[Майк] Құрметті елдегі орта мектептің футбол жанкүйерлері, бұл күн де келді!
Dialogue: 0,0:52:04.64,0:52:08.65,Default,,0,0,0,,[Майк] Футбол шекарасы басталады! !
Dialogue: 0,0:52:08.65,0:52:11.37,Default,,0,0,0,,Игасима стиліндегі кикбол тактикасы!
Dialogue: 0,0:52:11.37,0:52:13.33,Default,,0,0,0,,Эйгецу жоқ Джин!
Dialogue: 0,0:52:13.33,0:52:15.33,Default,,0,0,0,,Бұл не! ?
Dialogue: 0,0:52:23.43,0:52:25.33,Default,,0,0,0,,Уау! !
Dialogue: 0,0:52:25.33,0:52:27.33,Default,,0,0,0,,Өрт торнадосы!
Dialogue: 0,0:52:30.07,0:52:32.57,Default,,0,0,0,,Уф... уау! !
Dialogue: 0,0:52:36.72,0:52:38.72,Default,,0,0,0,,Уау….
Dialogue: 0,0:52:42.36,0:52:45.48,Default,,0,0,0,,Хаа... Хаа... Хаа... Те... Тейкоку Гакуен...
Dialogue: 0,0:52:45.48,0:52:48.52,Default,,0,0,0,,Бірінші шайқас серпіліс? Жақсы! !
Dialogue: 0,0:52:48.52,0:52:50.92,Default,,0,0,0,,10-0...
Dialogue: 0,0:52:50.92,0:52:53.92,Default,,0,0,0,,Сэуко кезінде... Мен толығымен жеңілдім.
Dialogue: 0,0:52:56.01,0:52:59.63,Default,,0,0,0,,Императорлық академия мүлде жоқ еді.
Dialogue: 0,0:52:59.63,0:53:02.37,Default,,0,0,0,,Ағаңыздың аяғын жақсылап күтіңіз→
Dialogue: 0,0:53:02.37,0:53:04.87,Default,,0,0,0,,Мен ұстап қалдым→
Dialogue: 0,0:53:04.87,0:53:08.67,Default,,0,0,0,,Сіз алаңға кіргенде, басқа ойыншылар әлдеқашан жеңілген →
Dialogue: 0,0:53:08.67,0:53:11.67,Default,,0,0,0,,Матчты жалғастыру мүмкін болмады.
Dialogue: 0,0:53:15.70,0:53:17.63,Default,,0,0,0,,Уау! !
Dialogue: 0,0:53:17.63,0:53:19.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:19.67,0:53:21.74,Default,,0,0,0,,Кидоу Сіз қатты ренжідіңіз бе?
Dialogue: 0,0:53:21.74,0:53:25.01,Default,,0,0,0,,Өте көңілсіз! Мен Seiko Junior High School-ды жеңгім келеді! !
Dialogue: 0,0:53:25.01,0:53:27.98,Default,,0,0,0,,Олай болса орындаңыз! Бұл мүмкін емес! !
Dialogue: 0,0:53:27.98,0:53:31.73,Default,,0,0,0,,Империя футбол шекарасынан жойылды.
Dialogue: 0,0:53:31.73,0:53:35.03,Default,,0,0,0,,Сіз жеңілгеніңізді мойындауға дайынсыз ба? Кидо!
Dialogue: 0,0:53:50.40,0:53:52.98,Default,,0,0,0,,Бір ғана жол бар.
Dialogue: 0,0:53:52.98,0:53:58.09,Default,,0,0,0,,Сіз Эндоны тек алдыңғы жағынан көрдіңіз, солай ма?
Dialogue: 0,0:53:58.09,0:54:01.69,Default,,0,0,0,,Сіз оған арқаңызды қалдыруға дайынсыз ба?
Dialogue: 0,0:54:03.99,0:54:06.01,Default,,0,0,0,,[Майк] Сенбаяма жетекшілік етеді!
Dialogue: 0,0:54:06.01,0:54:08.01,Default,,0,0,0,,[Майк] Бұл үлкен ұпай!
Dialogue: 0,0:54:12.32,0:54:14.36,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:54:14.36,0:54:16.36,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:54:16.36,0:54:18.36,Default,,0,0,0,,Осылай жеңіліп қалармын ба...
Dialogue: 0,0:54:20.36,0:54:25.97,Default,,0,0,0,,Сәлем... барлығына. Не болды? Неліктен ол сызылған?
Dialogue: 0,0:54:25.97,0:54:29.02,Default,,0,0,0,,Сіз бас тарттым деп айтпайсыз, солай ма?
Dialogue: 0,0:54:29.02,0:54:34.07,Default,,0,0,0,,Ойын әлі аяқталған жоқ. Домон Куримацу Каземару!
Dialogue: 0,0:54:34.07,0:54:38.33,Default,,0,0,0,,Бұл қажет. Ерекше қозғалыс...
Dialogue: 0,0:54:38.33,0:54:41.72,Default,,0,0,0,,Ерекше қозғалыс бар!
Dialogue: 0,0:54:41.72,0:54:44.34,Default,,0,0,0,,Біздің ерекше қозғалысымыз→
Dialogue: 0,0:54:44.34,0:54:47.57,Default,,0,0,0,,Жалын флюгтері де, Иназума да №1.
Dialogue: 0,0:54:47.57,0:54:53.07,Default,,0,0,0,,Біздің нағыз ерекше шеберлігіміз - бұл біздің соңына дейін ешқашан берілмейтін ерік-жігеріміз!
Dialogue: 0,0:54:55.01,0:54:58.35,Default,,0,0,0,,Берілмеу сезімі.
Dialogue: 0,0:54:58.35,0:55:00.85,Default,,0,0,0,,Мен берілмеймін.
Dialogue: 0,0:55:00.85,0:55:05.66,Default,,0,0,0,,Егер сіз бас тартсаңыз, бұл аяқталады! ! Бұл біздің футбол емес!
Dialogue: 0,0:55:05.66,0:55:09.01,Default,,0,0,0,,Біздің… футбол….
Dialogue: 0,0:55:09.01,0:55:11.06,Default,,0,0,0,,Endo! капитан!
Dialogue: 0,0:55:11.06,0:55:13.06,Default,,0,0,0,,Капитан! Эндо!
Dialogue: 0,0:55:13.06,0:55:15.36,Default,,0,0,0,,Капитан! Эндо…. Эндо!
Dialogue: 0,0:55:17.33,0:55:21.39,Default,,0,0,0,,《Бұл... Эндумен бірге соғысу дегенді білдіре ме?
Dialogue: 0,0:55:21.39,0:55:24.39,Default,,0,0,0,,Каминаримонның шын күші қандай...》
Dialogue: 0,0:55:26.33,0:55:30.83,Default,,0,0,0,,[Майк] Энду да көтерілді! Каминаримон: Барлығының соңғы шабуылы! !
Dialogue: 0,0:55:34.69,0:55:37.67,Default,,0,0,0,,Біздің... футбол!
Dialogue: 0,0:55:37.67,0:55:39.67,Default,,0,0,0,,Kidō!
Dialogue: 0,0:55:52.40,0:55:54.40,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:55:56.39,0:55:58.36,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:56:01.03,0:56:03.63,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:56:05.68,0:56:07.69,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:56:07.69,0:56:10.69,Default,,0,0,0,,Ичиноза мырза….
Dialogue: 0,0:56:10.69,0:56:12.67,Default,,0,0,0,,[Майк] Америкадан кенеттен соғысқа қосылды→
Dialogue: 0,0:56:12.67,0:56:14.69,Default,,0,0,0,,Өріс сиқыршысы→
Dialogue: 0,0:56:14.69,0:56:17.01,Default,,0,0,0,,Каминаримон орта мектебін қуаттандыру үшін Казуя Ичинозаны қосыңыз!
Dialogue: 0,0:56:17.01,0:56:19.41,Default,,0,0,0,,[Майк] Ой! Бұл жаңа ерекше қадам ба?
Dialogue: 0,0:56:19.41,0:56:21.71,Default,,0,0,0,,Уау! !
Dialogue: 0,0:56:24.02,0:56:26.05,Default,,0,0,0,,Цутому!
Dialogue: 0,0:56:26.05,0:56:28.05,Default,,0,0,0,,Сондай-ақ!
Dialogue: 0,0:56:54.37,0:56:56.30,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,0:56:56.30,0:56:59.07,Default,,0,0,0,,[Майк] Каминаримон орта мектебі 40 жылда алғаш рет →
Dialogue: 0,0:56:59.07,0:57:02.37,Default,,0,0,0,,Біз финалға өттік!
Dialogue: 0,0:57:04.64,0:57:07.70,Default,,0,0,0,,Ол қорқынышты жігіт.
Dialogue: 0,0:57:07.70,0:57:10.68,Default,,0,0,0,,Каминаримонды да Эндо-ками → сиқыры басып алды
Dialogue: 0,0:57:10.68,0:57:13.32,Default,,0,0,0,,Біз оны міндетті түрде жоюымыз керек.
Dialogue: 0,0:57:13.32,0:57:15.35,Default,,0,0,0,,Баусен.
Dialogue: 0,0:57:15.35,0:57:20.34,Default,,0,0,0,,Thunderbreak операциясының 2-кезеңі Ogre операциясына көшіңіз.
Dialogue: 0,0:57:20.34,0:57:22.39,Default,,0,0,0,,Га.
Dialogue: 0,0:57:22.39,0:57:25.46,Default,,0,0,0,,Адмирал Хибики Адмирал бұған дейін алаңдаған →
Dialogue: 0,0:57:25.46,0:57:28.32,Default,,0,0,0,,Жұмбақ балаға келсек...
Dialogue: 0,0:57:28.32,0:57:33.25,Default,,0,0,0,,Оны лақтырыңыз. Мен осы уақытқа дейін ештеңе жасаған жоқпын.
Dialogue: 0,0:57:33.25,0:57:36.14,Default,,0,0,0,,Король азуының мырзалары.
Dialogue: 0,0:57:36.14,0:57:38.21,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:57:38.21,0:57:40.19,Default,,0,0,0,,Кез келген уақытта.
Dialogue: 0,0:57:40.19,0:57:42.15,Default,,0,0,0,,Сорти! !
Dialogue: 0,0:57:42.15,0:57:45.20,Default,,0,0,0,,Сіз, Ога академиясы, тарихты қайта қарайсыз.
Dialogue: 0,0:57:45.20,0:57:47.18,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:57:47.18,0:57:49.68,Default,,0,0,0,,Га патша жіберіледі.
Dialogue: 0,0:57:53.02,0:57:58.66,Default,,0,0,0,,Мырзалар, біз қорқынышты футболымызбен тарихты өзгертеміз.
Dialogue: 0,0:57:58.66,0:58:04.35,Default,,0,0,0,,Болашақ үшін тарихқа жаңа шындықты ойып ал!
Dialogue: 0,0:58:04.35,0:58:07.79,Default,,0,0,0,,[Майк] О, құдай!
Dialogue: 0,0:58:07.79,0:58:13.36,Default,,0,0,0,,Seukoshi Junior High School және Ога Гакуэн арасындағы Football Frontier ұлттық турнирінің жартылай финалдық матчы →
Dialogue: 0,0:58:13.36,0:58:17.06,Default,,0,0,0,,Нәтиже керемет болды!
Dialogue: 0,0:58:17.06,0:58:20.66,Default,,0,0,0,,Құдай... маған тең келмейді...
Dialogue: 0,0:58:24.09,0:58:28.53,Default,,0,0,0,,Біз жындармыз. Бұл тіпті құдайларды жеуге болатын жын.
Dialogue: 0,0:58:28.53,0:58:33.65,Default,,0,0,0,,Огре операциясының 1-кезеңі аяқталды.
Dialogue: 0,0:58:35.68,0:58:41.36,Default,,0,0,0,,Га патша... Ол мен ойлағаннан да күшті жау. Мен мұны істей алмаймын.
Dialogue: 0,0:58:41.36,0:58:43.97,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:58:43.97,0:58:48.41,Default,,0,0,0,,Тіпті футболда да Оганың жауынгерлік қабілеті керемет.
Dialogue: 0,0:58:48.41,0:58:51.03,Default,,0,0,0,,Бұл футбол емес.
Dialogue: 0,0:58:51.03,0:58:56.63,Default,,0,0,0,,Олар дайындалған сарбаздардан құралған арнайы жасақтар.
Dialogue: 0,0:59:00.19,0:59:02.18,Default,,0,0,0,,Әй, бұл бұзушылық емес пе?
Dialogue: 0,0:59:02.18,0:59:04.28,Default,,0,0,0,,Бұл бұзушылық болар еді...
Dialogue: 0,0:59:04.28,0:59:06.28,Default,,0,0,0,,Жоқ, бұл рас, Мацуки мырза.
Dialogue: 0,1:01:14.02,1:01:16.03,Default,,0,0,0,,[Майк] Міне, осында.
Dialogue: 0,1:01:16.03,1:01:19.31,Default,,0,0,0,,[Майк] Football Frontier финалдық матчы Ога Гакуэн мен Каминаримон кіші орта мектебі!
Dialogue: 0,1:01:19.31,1:01:22.35,Default,,0,0,0,,[Майк] Жапонияның бірінші нөмірі үшін шайқас басталады.
Dialogue: 0,1:01:22.35,1:01:24.75,Default,,0,0,0,,[Майк] Жартылай финалда →
Dialogue: 0,1:01:24.75,1:01:27.69,Default,,0,0,0,,Ога Гакуэн үлкен ұпай санымен Сейко орта мектебін жеңді →
Dialogue: 0,1:01:27.69,1:01:30.69,Default,,0,0,0,,Каминаримон орта мектебі алдын ала байқаудан бері назар аударып келеді.
Dialogue: 0,1:01:30.69,1:01:33.66,Default,,0,0,0,,[Майк] Мен олардың қандай матч ойнайтынын асыға күтемін!
Dialogue: 0,1:01:33.66,1:01:38.77,Default,,0,0,0,,Кәне, бәріміз, бұл финал! Мақсат - жеңіс!
Dialogue: 0,1:01:38.77,1:01:41.87,Default,,0,0,0,,Көңіл-күйімізді көтерейік! ! Оу!
Dialogue: 0,1:01:46.01,1:01:48.06,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,1:01:48.06,1:01:50.06,Default,,0,0,0,,Не?
Dialogue: 0,1:01:52.31,1:01:54.40,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:01:54.40,1:01:56.40,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:02:07.64,1:02:10.68,Default,,0,0,0,,Не... бұл не? бұл….
Dialogue: 0,1:02:10.68,1:02:14.10,Default,,0,0,0,,[Майк] Бұған не болды?
Dialogue: 0,1:02:14.10,1:02:19.40,Default,,0,0,0,,[Майк] Фронтиер стадионы бірден жұмбақ стадионға айналды!
Dialogue: 0,1:02:21.39,1:02:23.99,Default,,0,0,0,,[Майк] Ой! Бұл...
Dialogue: 0,1:02:29.17,1:02:31.69,Default,,0,0,0,,Доктор Киллард, мен Ван Гамын.
Dialogue: 0,1:02:31.69,1:02:33.67,Default,,0,0,0,,[Радио] (Кирад) Біз де мұны сезіп отырмыз.
Dialogue: 0,1:02:33.67,1:02:35.74,Default,,0,0,0,,Мен қазір кетемін! [Радио] Сәл күте тұрыңыз.
Dialogue: 0,1:02:35.74,1:02:39.74,Default,,0,0,0,,[Радио] Ол әлі дайын емес. Міне бітті!
Dialogue: 0,1:02:44.82,1:02:48.02,Default,,0,0,0,,Мен Каминаримон орта мектебінің капитанымын... Бұл Эндо но Ками.
Dialogue: 0,1:02:48.02,1:02:50.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:50.19,1:02:52.52,Default,,0,0,0,,Бадап Срид.
Dialogue: 0,1:02:52.52,1:02:55.98,Default,,0,0,0,,Жақсы ойын болсын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:02:55.98,1:03:00.68,Default,,0,0,0,,Бұл қоқыс. Майдан даласында жаумен танысуға талпыну.
Dialogue: 0,1:03:00.68,1:03:02.85,Default,,0,0,0,,Ұрыс алаңы?
Dialogue: 0,1:03:02.85,1:03:05.74,Default,,0,0,0,,Ұрысқа дайындал!
Dialogue: 0,1:03:05.74,1:03:07.74,Default,,0,0,0,,Тартыңыз!
Dialogue: 0,1:03:14.39,1:03:17.31,Default,,0,0,0,,Эндо... Біз де өз орындарымызды аламыз.
Dialogue: 0,1:03:17.31,1:03:19.97,Default,,0,0,0,,Ах.
Dialogue: 0,1:03:19.97,1:03:25.02,Default,,0,0,0,,Міне, осында. Endo no kami бұл шайқаста →
Dialogue: 0,1:03:25.02,1:03:28.31,Default,,0,0,0,,Сіз өзіңізді футболдан бас тартасыз.
Dialogue: 0,1:03:28.31,1:03:32.40,Default,,0,0,0,,Футболдың қандай ақымақ екенін еске салайын!
Dialogue: 0,1:03:32.40,1:03:35.00,Default,,0,0,0,,Қауіпті ойларды сүртіңіз!
Dialogue: 0,1:03:37.32,1:03:41.44,Default,,0,0,0,,[Радио] Лорд Фанг, шайқас басталды.
Dialogue: 0,1:03:41.44,1:03:45.03,Default,,0,0,0,,Түсінікті. 2 кезең басталады.
Dialogue: 0,1:03:45.03,1:03:47.03,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:03:47.03,1:03:49.15,Default,,0,0,0,,О!
Dialogue: 0,1:03:49.15,1:03:51.15,Default,,0,0,0,,[Майк] Каминаримон қатты көтеріліп жатыр!
Dialogue: 0,1:03:58.66,1:04:00.69,Default,,0,0,0,,Кидо!
Dialogue: 0,1:04:00.69,1:04:02.68,Default,,0,0,0,,Не?
Dialogue: 0,1:04:02.68,1:04:04.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:04:04.69,1:04:07.71,Default,,0,0,0,,[Майк] Эй, не болып жатыр? Ohga академиясы. Ол мүлде қозғалмайды!
Dialogue: 0,1:04:07.71,1:04:11.99,Default,,0,0,0,,[Майк] Каминаримон Оганың қақпасының алдында тұр!
Dialogue: 0,1:04:11.99,1:04:14.05,Default,,0,0,0,,Олай болса, мені босатыңыз!
Dialogue: 0,1:04:14.05,1:04:16.05,Default,,0,0,0,,Шешіңіз! Someoka!
Dialogue: 0,1:04:18.01,1:04:20.01,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:04:26.08,1:04:30.32,Default,,0,0,0,,[Майк] Ой, Someoka атпады! Sundayyu тез кеседі!
Dialogue: 0,1:04:30.32,1:04:32.39,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,1:04:32.39,1:04:34.39,Default,,0,0,0,,[Майк] Каземару Огадан допты ұрлап алды!
Dialogue: 0,1:04:38.36,1:04:41.43,Default,,0,0,0,,《Біртүрлі екен... Сеикомен бірге болған кезімнен мүлде басқаша.》
Dialogue: 0,1:04:41.43,1:04:43.32,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,1:04:43.32,1:04:46.70,Default,,0,0,0,,Менен допты ұрлап кетіпті, неге келіп қайтармадың?
Dialogue: 0,1:04:46.70,1:04:49.64,Default,,0,0,0,,Уайымдамаңыз, бәріңіз! Шабуылға барыңыз!
Dialogue: 0,1:04:49.64,1:04:55.31,Default,,0,0,0,,О! Goenji Temple Go! Жарайды!
Dialogue: 0,1:04:55.31,1:04:57.71,Default,,0,0,0,,Мен бара аламын! Уф!
Dialogue: 0,1:04:57.71,1:05:02.00,Default,,0,0,0,,[Майк] А, Драче кесіп тастады!
Dialogue: 0,1:05:02.00,1:05:06.02,Default,,0,0,0,,Қайтадан кесу керек пе? Бұл керемет мүмкіндік болар еді!
Dialogue: 0,1:05:06.02,1:05:09.99,Default,,0,0,0,,Бірақ біртүрлі нәрсе емес пе?
Dialogue: 0,1:05:09.99,1:05:13.99,Default,,0,0,0,,Неліктен олар ештеңе істемейді?
Dialogue: 0,1:05:17.35,1:05:19.35,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,1:05:19.35,1:05:24.32,Default,,0,0,0,,А, бұл мені тітіркендіретін нәрсе. Ванның көзқарасы.
Dialogue: 0,1:05:24.32,1:05:27.39,Default,,0,0,0,,Бірақ ату мүмкіндігі көп болды!
Dialogue: 0,1:05:27.39,1:05:30.43,Default,,0,0,0,,Иә! Неге соқпадың?
Dialogue: 0,1:05:30.43,1:05:33.68,Default,,0,0,0,,Мен жете алмадым...
Dialogue: 0,1:05:33.68,1:05:36.07,Default,,0,0,0,,Олай емес еді, солай ма?
Dialogue: 0,1:05:36.07,1:05:39.37,Default,,0,0,0,,Сомека-кунның қаптамасы тым жұмсақ болған жоқ па?
Dialogue: 0,1:05:42.03,1:05:46.03,Default,,0,0,0,,Түсінбедім... Мен сергек емеспін.
Dialogue: 0,1:05:46.03,1:05:51.07,Default,,0,0,0,,Шабуыл жасауға болмайды... Түсіндің бе?
Dialogue: 0,1:05:51.07,1:05:55.37,Default,,0,0,0,,Тағы бір нәрсе: мен оған тым терең ене алмаймын.
Dialogue: 0,1:05:59.03,1:06:02.38,Default,,0,0,0,,Егер бұлай болса, мен не болса да алға шығамын!
Dialogue: 0,1:06:02.38,1:06:05.03,Default,,0,0,0,,Бұл бұзушылық болар еді.
Dialogue: 0,1:06:05.03,1:06:08.34,Default,,0,0,0,,Мен ағынды өзгерткім келеді.
Dialogue: 0,1:06:08.34,1:06:13.77,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,1:06:13.77,1:06:18.38,Default,,0,0,0,,Мен футболдың мұндай түрін жек көремін. Кабейама….
Dialogue: 0,1:06:18.38,1:06:20.38,Default,,0,0,0,,Барлығың, берік болыңдар!
Dialogue: 0,1:06:20.38,1:06:22.32,Default,,0,0,0,,Мен әркімнің сезімін түсінемін.
Dialogue: 0,1:06:22.32,1:06:25.69,Default,,0,0,0,,Бірінші тайм, әрине, футбол ойнағысы келмеді.
Dialogue: 0,1:06:25.69,1:06:28.99,Default,,0,0,0,,Мен де жақсы айта алмаймын →
Dialogue: 0,1:06:28.99,1:06:32.64,Default,,0,0,0,,Сіз шынымен де сол сезіммен екінші тайммен күреспексіз бе?
Dialogue: 0,1:06:32.64,1:06:37.08,Default,,0,0,0,,Шындығында, бұл дұрыс.→
Dialogue: 0,1:06:37.08,1:06:39.38,Default,,0,0,0,,Мен не істеуім керек!
Dialogue: 0,1:06:43.04,1:06:44.97,Default,,0,0,0,,Ол дірілдей бастады.
Dialogue: 0,1:06:44.97,1:06:49.68,Default,,0,0,0,,Бұл олардың футболға деген алаңдаушылығын оятудың тамаша тактикасы.
Dialogue: 0,1:06:49.68,1:06:54.06,Default,,0,0,0,,Керемет Баусен. Келесі кезеңге өтіңіз.
Dialogue: 0,1:06:54.06,1:06:56.68,Default,,0,0,0,,Әлі емес пе? Доктор Киллард!
Dialogue: 0,1:06:56.68,1:07:01.35,Default,,0,0,0,,Тағы екі адам кетті. Тағы біраз күтіңіз.
Dialogue: 0,1:07:01.35,1:07:03.66,Default,,0,0,0,,[Майк] Екінші таймның басталуы!
Dialogue: 0,1:07:03.66,1:07:08.13,Default,,0,0,0,,[Майк] Екі команда да ұпайсыз қалды! Даму бірінші жартыжылдықтағыдай жалғасады ма? ?
Dialogue: 0,1:07:13.33,1:07:15.63,Default,,0,0,0,,[Майк] Ой, Каминаримон бұл жолы қозғалмайды.
Dialogue: 0,1:07:21.99,1:07:23.99,Default,,0,0,0,,[Майк] Каминаримон осында көшіп келді!
Dialogue: 0,1:07:23.99,1:07:26.73,Default,,0,0,0,,Жүр! Ихиноза!
Dialogue: 0,1:07:26.73,1:07:28.73,Default,,0,0,0,,Эндо Домон!
Dialogue: 0,1:07:48.32,1:07:50.72,Default,,0,0,0,,[Майк] Ақыры Каминаримонды атып тастады!
Dialogue: 0,1:07:50.72,1:07:55.02,Default,,0,0,0,,[Майк] Бұл Ога Гакуенді қақпа аймағына дейін қызықтырған өте ұзақ соққы болды!
Dialogue: 0,1:08:05.99,1:08:08.04,Default,,0,0,0,,Не! ?
Dialogue: 0,1:08:08.04,1:08:13.31,Default,,0,0,0,,[Майк] Ога академиясының сақтаушысы Загомер! Мен оны тамаша тоқтаттым!
Dialogue: 0,1:08:13.31,1:08:16.08,Default,,0,0,0,,Сен мені ұруға батылы бардың. аа.
Dialogue: 0,1:08:16.08,1:08:18.08,Default,,0,0,0,,Жақсы! Келесі! (Домон/Ичиноза) О!
Dialogue: 0,1:08:19.97,1:08:22.37,Default,,0,0,0,,3-кезеңнің басталуы.
Dialogue: 0,1:08:22.37,1:08:31.73,Default,,0,0,0,,♪♪～
Dialogue: 0,1:08:31.73,1:08:33.73,Default,,0,0,0,,Қорғаныс!
Dialogue: 0,1:09:01.69,1:09:04.03,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:04.03,1:09:06.98,Default,,0,0,0,,[Майк] Oga Academy Preemptive!
Dialogue: 0,1:09:06.98,1:09:11.02,Default,,0,0,0,,[Майк] Каминаримон тіпті күші мен жылдамдығынан қозғала алмайды!
Dialogue: 0,1:09:11.02,1:09:13.65,Default,,0,0,0,,Дәнекерлеуші! Макс! Куриматсу!
Dialogue: 0,1:09:13.65,1:09:16.71,Default,,0,0,0,,Қат! Сіз ақыры байсалды болдыңыз ба?
Dialogue: 0,1:09:16.71,1:09:21.36,Default,,0,0,0,,Мүмкін бұл олардың шынайы табиғаты шығар.
Dialogue: 0,1:09:21.36,1:09:23.98,Default,,0,0,0,,Нашар Бұл ақыры басталды.
Dialogue: 0,1:09:23.98,1:09:27.32,Default,,0,0,0,,Амансың ба? Кешіріңіз, Янс.
Dialogue: 0,1:09:27.32,1:09:30.40,Default,,0,0,0,,Кагено Шишидо Шаолинджи өзгерді!
Dialogue: 0,1:09:30.40,1:09:32.69,Default,,0,0,0,,Иә! (Кегено) Кеттік!
Dialogue: 0,1:09:32.69,1:09:34.64,Default,,0,0,0,,О!
Dialogue: 0,1:09:34.64,1:09:39.06,Default,,0,0,0,,[Майк] О, құдай! Каминаримон: Ойыншылар жарақатына байланысты ауыстырылды!
Dialogue: 0,1:09:46.72,1:09:48.72,Default,,0,0,0,,Ах! Гоенджи храмы!
Dialogue: 0,1:09:52.06,1:09:54.36,Default,,0,0,0,,Қарғыс атсын! Жетесіз!
Dialogue: 0,1:10:00.33,1:10:02.63,Default,,0,0,0,,Тоқта! Оу!
Dialogue: 0,1:10:18.70,1:10:20.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:20.67,1:10:22.97,Default,,0,0,0,,Мен мұны осы жолы тоқтатамын!
Dialogue: 0,1:10:42.06,1:10:44.86,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,1:10:51.00,1:10:55.41,Default,,0,0,0,,[Майк] Мақсат! 2-ден 0-ге дейін! Каминаримон Насудзюцу!
Dialogue: 0,1:10:55.41,1:10:59.84,Default,,0,0,0,,[Майк] Каминаримон Охганың керемет соққысы көптеген жарақат алды!
Dialogue: 0,1:10:59.84,1:11:02.71,Default,,0,0,0,,Барлығы.
Dialogue: 0,1:11:02.71,1:11:05.25,Default,,0,0,0,,Мына жүзге қара!
Dialogue: 0,1:11:05.25,1:11:07.50,Default,,0,0,0,,Достарыңыздың бірінен соң бірі құлап жатқанын қараңыз→
Dialogue: 0,1:11:07.50,1:11:11.00,Default,,0,0,0,,Эндо-камидің жүрегі одан бетер дірілдейді.
Dialogue: 0,1:11:11.00,1:11:15.98,Default,,0,0,0,,Сол ойлардың қалай жаншылғанын мұқият қараңыз.
Dialogue: 0,1:11:15.98,1:11:18.33,Default,,0,0,0,,[Майк] Ауыр жағдай туындады!
Dialogue: 0,1:11:18.33,1:11:22.52,Default,,0,0,0,,[Майк] Каминаримон 11 6 ойыншы ойнауды жалғастыра алмайды!
Dialogue: 0,1:11:22.52,1:11:24.53,Default,,0,0,0,,[Майк] 8 адам алаңда әрең тұр→
Dialogue: 0,1:11:24.53,1:11:27.63,Default,,0,0,0,,Мен Ванның ойынына әбден сіңіп кеттім!
Dialogue: 0,1:11:29.69,1:11:31.64,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:11:31.64,1:11:34.06,Default,,0,0,0,,...
Dialogue: 0,1:11:34.06,1:11:38.31,Default,,0,0,0,,Футболды лақтыру.
Dialogue: 0,1:11:38.31,1:11:42.37,Default,,0,0,0,,Сіздің ақымақ футболыңызға қараңыз →
Dialogue: 0,1:11:42.37,1:11:48.41,Default,,0,0,0,,Сіздің сөздеріңіз бен құмарлығыңыз әріптестеріңізге зиян тигізуде!
Dialogue: 0,1:11:48.41,1:11:50.71,Default,,0,0,0,,Менің футболым! ?
Dialogue: 0,1:11:54.68,1:11:57.57,Default,,0,0,0,,Бұлай жалғаса берсе, жаншылып қаламыз.
Dialogue: 0,1:11:57.57,1:12:00.49,Default,,0,0,0,,Уау... Доктор Киллард Каминаримон орта мектебі!
Dialogue: 0,1:12:00.49,1:12:02.69,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз, Канон!
Dialogue: 0,1:12:02.69,1:12:07.09,Default,,0,0,0,,Сіз сұрағанның бәрі дайындалды.
Dialogue: 0,1:12:07.09,1:12:09.39,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:12:16.39,1:12:20.69,Default,,0,0,0,,Мен барлығының сыйлығын қорғау үшін келдім!
Dialogue: 0,1:13:03.67,1:13:05.72,Default,,0,0,0,,Ал, ол фильм нұсқасында пайда болады→
Dialogue: 0,1:13:05.72,1:13:08.49,Default,,0,0,0,,Таңқаларлық кейіпкерлер де рейтингке енген!
Dialogue: 0,1:13:08.49,1:13:12.29,Default,,0,0,0,,Барлық жеңімпаздарды құттықтаймыз!
Dialogue: 0,1:13:21.08,1:13:25.38,Default,,0,0,0,,4-ші орын алған Кенджомен тығыз шайқастан кейін біз 3-ші орынға ие болдық!
Dialogue: 0,1:13:30.26,1:13:35.06,Default,,0,0,0,,Бұл да Досан Асан, алғаш рет осы фильм нұсқасында пайда болды.
Dialogue: 0,1:13:45.34,1:13:48.94,Default,,0,0,0,,1-орын құтты болсын!
Dialogue: 0,1:16:16.99,1:16:19.00,Default,,0,0,0,,Тоқта, Оуга!
Dialogue: 0,1:16:19.00,1:16:21.01,Default,,0,0,0,,Біздің ойнағымыз келетін нәрсе - футбол!
Dialogue: 0,1:16:21.01,1:16:23.02,Default,,0,0,0,,Мақсат алғың келсе, мақсатқа ұмтыл!
Dialogue: 0,1:16:23.02,1:16:25.74,Default,,0,0,0,,Бұл жерден кет.
Dialogue: 0,1:16:25.74,1:16:28.84,Default,,0,0,0,,Әйтпесе, футболды тастаңыз!
Dialogue: 0,1:16:36.53,1:16:39.03,Default,,0,0,0,,Өлім найзасы!
Dialogue: 0,1:16:46.72,1:16:48.72,Default,,0,0,0,,Эндо-кун!
Dialogue: 0,1:17:05.41,1:17:07.51,Default,,0,0,0,,Арх, мен оны уақытында орындадым!
Dialogue: 0,1:17:14.57,1:17:17.65,Default,,0,0,0,,Ол пайда болды ма? Біз не істеуіміз керек?
Dialogue: 0,1:17:17.65,1:17:20.97,Default,,0,0,0,,Әрине, миссия жалғасады.
Dialogue: 0,1:17:20.97,1:17:23.31,Default,,0,0,0,,Сіз ше?
Dialogue: 0,1:17:23.31,1:17:26.03,Default,,0,0,0,,Танысқаныма қуаныштымын, үлкен ата.
Dialogue: 0,1:17:26.03,1:17:28.53,Default,,0,0,0,,Иә? Не! ?
Dialogue: 0,1:17:28.53,1:17:30.48,Default,,0,0,0,,Аа, бұл бірінші рет емес деп ойлаймын.
Dialogue: 0,1:17:30.48,1:17:33.69,Default,,0,0,0,,Бұл кім? Үлкен ата.
Dialogue: 0,1:17:33.69,1:17:37.64,Default,,0,0,0,,Бұл Football Frontier тарихында бұрын-соңды болмаған жағдай!
Dialogue: 0,1:17:37.64,1:17:43.25,Default,,0,0,0,,[Майк] Екінші таймға 10 минут қалды Фун Бұл шұғыл финалдық матч!
Dialogue: 0,1:17:43.25,1:17:48.18,Default,,0,0,0,,Мен Эндо Канонмын, мен бәріңмен күресуге келдім!
Dialogue: 0,1:17:48.18,1:17:51.54,Default,,0,0,0,,Арғы ата Эндо но Камидің шөбересі ретінде.
Dialogue: 0,1:17:51.54,1:17:53.61,Default,,0,0,0,,Шөбере! ?
Dialogue: 0,1:17:53.61,1:17:56.01,Default,,0,0,0,,Сіз кенеттен осындай бірдеңе айтса да.
Dialogue: 0,1:17:56.01,1:17:59.01,Default,,0,0,0,,Сіз болашақтан екеніңізге сене аласыз ба?
Dialogue: 0,1:18:01.03,1:18:02.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:02.97,1:18:06.57,Default,,0,0,0,,А, мынау атаның дәптері ғой!
Dialogue: 0,1:18:06.57,1:18:10.36,Default,,0,0,0,,Уау, бұл шын! Тіпті жазған жазбаларым да бар!
Dialogue: 0,1:18:10.36,1:18:13.21,Default,,0,0,0,,Іш қуысының астына қысым жасау - бұл негіздердің ең негізгісі!
Dialogue: 0,1:18:13.21,1:18:16.03,Default,,0,0,0,,Не, менің қолжазбамды оқи аласың! ?
Dialogue: 0,1:18:16.03,1:18:20.42,Default,,0,0,0,,Сенуге тұрарлық сияқты.
Dialogue: 0,1:18:20.42,1:18:23.19,Default,,0,0,0,,Мен де сенемін. Гоенджи храмы!
Dialogue: 0,1:18:23.19,1:18:25.69,Default,,0,0,0,,Біз оны мініп көреміз бе? Каземару!
Dialogue: 0,1:18:25.69,1:18:29.16,Default,,0,0,0,,Мен үлкен атамды көптен бері қараймын.
Dialogue: 0,1:18:29.16,1:18:32.71,Default,,0,0,0,,Маңызды уақытта кешігіп қалғаным үшін кешіріңіз.
Dialogue: 0,1:18:32.71,1:18:34.73,Default,,0,0,0,,Бұл қашан маңызды?
Dialogue: 0,1:18:34.73,1:18:39.19,Default,,0,0,0,,Бұл сәйкестік. Бұл ұят болды, Ога командасы!
Dialogue: 0,1:18:39.19,1:18:43.34,Default,,0,0,0,,Тарихты өзгертуге тырысқаныңызды кешірмеймін!
Dialogue: 0,1:18:43.34,1:18:45.98,Default,,0,0,0,,Бір адам не істей алады?
Dialogue: 0,1:18:45.98,1:18:48.01,Default,,0,0,0,,Сіз жалғыз емессіз!
Dialogue: 0,1:18:48.01,1:18:53.50,Default,,0,0,0,,Кешіктіруімнің себебі, мен ең мықты одақтастарды жинадым!
Dialogue: 0,1:18:53.50,1:18:56.00,Default,,0,0,0,,Барлығың шығыңдар!
Dialogue: 0,1:19:12.35,1:19:15.67,Default,,0,0,0,,Жел бол!
Dialogue: 0,1:19:15.67,1:19:18.97,Default,,0,0,0,,Бұл ақ махаббаттағы Ширу Фубуки!
Dialogue: 0,1:19:21.56,1:19:27.36,Default,,0,0,0,,Күткеніңізге рахмет! Жапония өкілі Иназума Жапония Торамару Уцуномия!
Dialogue: 0,1:19:29.39,1:19:33.99,Default,,0,0,0,,Хидака Сеия сияқты!
Dialogue: 0,1:19:36.56,1:19:42.16,Default,,0,0,0,,Бұрынғы бөтен планеталар академиясы Генезис Хирото Кияма!
Dialogue: 0,1:19:45.12,1:19:49.42,Default,,0,0,0,,Италия өкілі Орфей! Фидио Ардена!
Dialogue: 0,1:19:56.48,1:19:58.53,Default,,0,0,0,,Не! ?
Dialogue: 0,1:19:58.53,1:20:00.53,Default,,0,0,0,,Құрметпен, капитан!
Dialogue: 0,1:20:00.53,1:20:03.97,Default,,0,0,0,,Негізі капитан туралы бәріміз білеміз.
Dialogue: 0,1:20:03.97,1:20:09.59,Default,,0,0,0,,Басқаша айтқанда, бұл үлкен атаның кездесетін болашақ достары.
Dialogue: 0,1:20:09.59,1:20:13.81,Default,,0,0,0,,Барлығы маған көмектесуге келді, өйткені олар футболды жақсы көреді!
Dialogue: 0,1:20:13.81,1:20:19.03,Default,,0,0,0,,Мен сендерге рахмет айтамын. Сондықтан мен көмектескім келеді.
Dialogue: 0,1:20:19.03,1:20:22.19,Default,,0,0,0,,Капитан Гоендзи-сан, көп рахмет!
Dialogue: 0,1:20:22.19,1:20:25.64,Default,,0,0,0,,Хибики-сан мен капитан, мен көмектесуге келдім!
Dialogue: 0,1:20:25.64,1:20:29.90,Default,,0,0,0,,Мен Эндо-кунмен бірге осы финалға шыққаныма қуаныштымын!
Dialogue: 0,1:20:29.90,1:20:32.50,Default,,0,0,0,,Мамору Мен де құрметті сезінемін.
Dialogue: 0,1:20:35.99,1:20:38.39,Default,,0,0,0,,Эндо Неге жылайсың?
Dialogue: 0,1:20:38.39,1:20:42.98,Default,,0,0,0,,Ал, мен түсінбеймін, бірақ мен футболды жақсы көремін→
Dialogue: 0,1:20:42.98,1:20:45.69,Default,,0,0,0,,Көптеген достар келді!
Dialogue: 0,1:20:45.69,1:20:48.86,Default,,0,0,0,,Маған қатты әсер етті!
Dialogue: 0,1:20:48.86,1:20:51.98,Default,,0,0,0,,Болашақта арғы ата бұл дәуірде →
Dialogue: 0,1:20:51.98,1:20:54.19,Default,,0,0,0,,Себебі сен маған футболдың кереметін көрсеттің→
Dialogue: 0,1:20:54.19,1:20:57.31,Default,,0,0,0,,Көптеген жақсылықтар болды! иә!
Dialogue: 0,1:20:57.31,1:20:59.84,Default,,0,0,0,,Солай ма? Сондықтан барлығы →
Dialogue: 0,1:20:59.84,1:21:01.88,Default,,0,0,0,,Сыйлығымызды қорғайық!
Dialogue: 0,1:21:01.88,1:21:04.48,Default,,0,0,0,,Мен бұл сөздерге сенемін.
Dialogue: 0,1:21:04.48,1:21:10.02,Default,,0,0,0,,Біз сізге барлық сезімдерімізді сеніп тапсырамыз!
Dialogue: 0,1:21:10.02,1:21:13.97,Default,,0,0,0,,Иә! Барлығымыздың күшімен күресейік!
Dialogue: 0,1:21:13.97,1:21:18.86,Default,,0,0,0,,Жақсы! Барлығының күшімен біз Оуганы жеңеміз!
Dialogue: 0,1:21:18.86,1:21:20.85,Default,,0,0,0,,О!
Dialogue: 0,1:21:20.85,1:21:22.98,Default,,0,0,0,,[Радио] Олардың барлығын жойыңыз.
Dialogue: 0,1:21:22.98,1:21:25.02,Default,,0,0,0,,Түсінікті.
Dialogue: 0,1:21:25.02,1:21:29.16,Default,,0,0,0,,Лорд Эндо! Бізге кімнің кіргені маңызды емес.
Dialogue: 0,1:21:29.16,1:21:31.54,Default,,0,0,0,,Ұрысты жалғастырыңыз.
Dialogue: 0,1:21:31.54,1:21:36.08,Default,,0,0,0,,Бұл шайқас емес! Бұл футбол!
Dialogue: 0,1:21:36.08,1:21:38.00,Default,,0,0,0,,Қадағалау!
Dialogue: 0,1:21:38.00,1:21:42.02,Default,,0,0,0,,Жарайды, ойыншы ауыстырыңыз.
Dialogue: 0,1:21:42.02,1:21:45.50,Default,,0,0,0,,[Майк] Турбулентті Football Frontier финалы!
Dialogue: 0,1:21:45.50,1:21:49.36,Default,,0,0,0,,[Майк] Екінші таймға 10 минут қалды, ойынның қайта басталуы!
Dialogue: 0,1:21:49.36,1:21:51.86,Default,,0,0,0,,[Майк] Каминаримон 6 мүшені ауыстырды!
Dialogue: 0,1:21:51.86,1:21:55.63,Default,,0,0,0,,Бұл жаңа жүйе ойынға қалай әсер етеді? ?
Dialogue: 0,1:21:55.63,1:21:59.60,Default,,0,0,0,,Сіз [Майк] қарсы Oga Academy қарсы екі ұпай қорғай аласыз ба? ?
Dialogue: 0,1:21:59.60,1:22:02.67,Default,,0,0,0,,Кәне, үлкен ата, футбол ойнайық!
Dialogue: 0,1:22:02.67,1:22:05.02,Default,,0,0,0,,О!
Dialogue: 0,1:22:05.02,1:22:08.69,Default,,0,0,0,,Бадап Мен футболды тастамаймын!
Dialogue: 0,1:22:08.69,1:22:11.73,Default,,0,0,0,,Менің футболды жақсы көретін достарым көп!
Dialogue: 0,1:22:16.72,1:22:18.72,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:22:20.76,1:22:22.99,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:22:22.99,1:22:25.59,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,1:22:27.68,1:22:29.73,Default,,0,0,0,,Ол мұны істейді!
Dialogue: 0,1:22:29.73,1:22:34.03,Default,,0,0,0,,Әлі жоқ! Осыны көріп, маған айтқаныңды қалаймын!
Dialogue: 0,1:22:43.41,1:22:46.01,Default,,0,0,0,,♬~
Dialogue: 0,1:22:48.00,1:22:50.07,Default,,0,0,0,,Гоендзи-сан!
Dialogue: 0,1:22:50.07,1:22:52.07,Default,,0,0,0,,♬~
Dialogue: 0,1:23:01.96,1:23:04.03,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,1:23:04.03,1:23:06.54,Default,,0,0,0,,[Майк] О, құдай! Бұл Tiger Drive →
Dialogue: 0,1:23:06.54,1:23:11.04,Default,,0,0,0,,Гоенджидің жаңа ерекше қозғалысы, «Тізбекті ат»!
Dialogue: 0,1:23:11.04,1:23:14.54,Default,,0,0,0,,Инелі балға!
Dialogue: 0,1:23:19.53,1:23:22.40,Default,,0,0,0,,Иә! [Майк] Бұл шешілді!
Dialogue: 0,1:23:22.40,1:23:26.02,Default,,0,0,0,,[Майк] Каминаримон ақыры Охганың мақсатын ашты!
Dialogue: 0,1:23:26.02,1:23:28.81,Default,,0,0,0,,Сізде жақсы доп болды.
Dialogue: 0,1:23:28.81,1:23:33.58,Default,,0,0,0,,Гоендзи-сан ең жақсы соққы болды!
Dialogue: 0,1:23:33.58,1:23:36.88,Default,,0,0,0,,Жарайды, қарсы тұрайық!
Dialogue: 0,1:23:40.14,1:23:43.71,Default,,0,0,0,,Мен сенің жылдамдығыңнан бас тарттым!
Dialogue: 0,1:23:43.71,1:23:47.86,Default,,0,0,0,,Гоенджи-кун, маған тағы бір оқ беріңізші!
Dialogue: 0,1:23:47.86,1:23:51.00,Default,,0,0,0,,Қасқыр аңыз!
Dialogue: 0,1:23:51.00,1:23:53.30,Default,,0,0,0,,♬~
Dialogue: 0,1:24:01.39,1:24:03.69,Default,,0,0,0,,♬~
Dialogue: 0,1:24:07.56,1:24:11.06,Default,,0,0,0,,Максималды өрт!
Dialogue: 0,1:24:25.83,1:24:27.90,Default,,0,0,0,,Сіз мұны тоқтаттыңыз! ?
Dialogue: 0,1:24:27.90,1:24:32.90,Default,,0,0,0,,[Майк] Ванга Жаңа сақшы техникасы! Максималды өрт жойылды!
Dialogue: 0,1:24:34.99,1:24:36.99,Default,,0,0,0,,Не! ?
Dialogue: 0,1:24:40.68,1:24:45.12,Default,,0,0,0,,Хирото! Жақсы! Canon!
Dialogue: 0,1:24:45.12,1:24:47.12,Default,,0,0,0,,О!
Dialogue: 0,1:24:49.07,1:24:51.07,Default,,0,0,0,,♬~
Dialogue: 0,1:24:59.72,1:25:03.32,Default,,0,0,0,,Электр тұзағы!
Dialogue: 0,1:25:06.54,1:25:10.64,Default,,0,0,0,,[Майк] Каминаримон байланды! Мен жеттім!
Dialogue: 0,1:25:10.64,1:25:12.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:25:12.86,1:25:14.81,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:14.81,1:25:17.87,Default,,0,0,0,,Керемет Канон! Күткендей!
Dialogue: 0,1:25:17.87,1:25:20.69,Default,,0,0,0,,Арғы ата, орындадық!
Dialogue: 0,1:25:20.69,1:25:24.07,Default,,0,0,0,,[Радио] Бадап Алдымен оны жойыңыз!
Dialogue: 0,1:25:24.07,1:25:28.73,Default,,0,0,0,,[Радио] Бұл шайқастың мәнін түсіндіңіз бе?
Dialogue: 0,1:25:28.73,1:25:30.73,Default,,0,0,0,,Түсінікті.
Dialogue: 0,1:25:35.00,1:25:37.52,Default,,0,0,0,,<Сіздің жолыңызда тұрған ең басты жау>
Dialogue: 0,1:25:37.52,1:25:39.97,Default,,0,0,0,,Мен сізге инкарнацияның шынайы күшін көрсетемін!
Dialogue: 0,1:25:39.97,1:25:42.74,Default,,0,0,0,,<Каминаримон рухымен ең үлкен дағдарысқа қарсы тұрыңыз! ＞
Dialogue: 0,1:25:42.74,1:25:45.04,Default,,0,0,0,,Біз футболды қайтарып жатырмыз!
Dialogue: 0,1:27:51.97,1:28:03.13,Default,,0,0,0,,♪♪～
Dialogue: 0,1:28:03.13,1:28:08.13,Default,,0,0,0,,[Майк] Король Фангтың қарсы шабуылы! Бірінші таймдағы оқиғалардың күрт өзгеруі!
Dialogue: 0,1:28:10.79,1:28:13.09,Default,,0,0,0,,Canon!
Dialogue: 0,1:28:15.01,1:28:18.51,Default,,0,0,0,,[Майк] Каземару дағдарыстан үмітсіз ойынымен аман қалды!
Dialogue: 0,1:28:18.51,1:28:21.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:21.30,1:28:25.02,Default,,0,0,0,,Мен көмекшілеріме әдемі киінуге рұқсат бермеймін!
Dialogue: 0,1:28:25.02,1:28:27.02,Default,,0,0,0,,Каземару-сан! Барайық!
Dialogue: 0,1:28:27.02,1:28:29.02,Default,,0,0,0,,О!
Dialogue: 0,1:28:32.39,1:28:34.39,Default,,0,0,0,,Фидио! о!
Dialogue: 0,1:28:41.90,1:28:45.40,Default,,0,0,0,,Canon Бұл түсіру тізбегі! иә!
Dialogue: 0,1:28:48.03,1:28:50.18,Default,,0,0,0,,Әй!
Dialogue: 0,1:28:50.18,1:28:52.18,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,1:28:54.47,1:28:59.47,Default,,0,0,0,,Құдайдың зеңбіректері!
Dialogue: 0,1:28:59.47,1:29:03.89,Default,,0,0,0,,[Майк] Один семсерінен қуат алатын толыққанды Құдай зеңбірек!
Dialogue: 0,1:29:03.89,1:29:05.99,Default,,0,0,0,,Жақсы! Барайық!
Dialogue: 0,1:29:08.83,1:29:11.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:29:15.99,1:29:18.49,Default,,0,0,0,,Жоғары кернеу!
Dialogue: 0,1:29:23.56,1:29:25.48,Default,,0,0,0,,[Майк] Бұл техника дегеніміз не? ?
Dialogue: 0,1:29:25.48,1:29:29.07,Default,,0,0,0,,[Майк] Загомердің артында екі қорғаушы тығылып тұрды!
Dialogue: 0,1:29:29.07,1:29:33.07,Default,,0,0,0,,Гебогебогебо! Сізге бұл техниканы қолдануға рұқсат бергеніме сене алмаймын.
Dialogue: 0,1:29:35.04,1:29:37.08,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:29:37.08,1:29:39.68,Default,,0,0,0,,Бұл жерде тоқтату қиын.
Dialogue: 0,1:29:39.68,1:29:41.66,Default,,0,0,0,,Барлығыңыз, ойларыңызды өзгертіңіздер!
Dialogue: 0,1:29:41.66,1:29:44.75,Default,,0,0,0,,Берілме!
Dialogue: 0,1:29:44.75,1:29:47.65,Default,,0,0,0,,Canon Everyone!
Dialogue: 0,1:29:47.65,1:29:49.66,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:29:49.66,1:29:56.51,Default,,0,0,0,,♪♪～
Dialogue: 0,1:29:56.51,1:29:58.51,Default,,0,0,0,,Куруссу! Қат!
Dialogue: 0,1:29:58.51,1:30:00.53,Default,,0,0,0,,Уау! Кабейяма!
Dialogue: 0,1:30:00.53,1:30:02.52,Default,,0,0,0,,Уф….
Dialogue: 0,1:30:02.52,1:30:04.67,Default,,0,0,0,,[Майк] Оганың қаһарлы толқын шабуылына→
Dialogue: 0,1:30:04.67,1:30:09.67,Default,,0,0,0,,Каминаримон Допқа жақындай да алмайсың. Осылай аяқтала ма? ?
Dialogue: 0,1:30:11.64,1:30:15.06,Default,,0,0,0,,Азу тістері жойылған адам.
Dialogue: 0,1:30:15.06,1:30:17.06,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:30:22.05,1:30:25.05,Default,,0,0,0,,Өлім найзасы!
Dialogue: 0,1:30:31.06,1:30:33.06,Default,,0,0,0,,Үлкен ата!
Dialogue: 0,1:30:36.00,1:30:38.50,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,1:30:40.69,1:30:45.19,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,1:30:45.19,1:30:49.19,Default,,0,0,0,,♬~
Dialogue: 0,1:30:51.73,1:30:54.73,Default,,0,0,0,,Иә! Вакуумдық жын!
Dialogue: 0,1:31:02.98,1:31:05.01,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,1:31:05.01,1:31:10.99,Default,,0,0,0,,[Майк] О, вакуумды жын өлім найзасын тоқтатты!
Dialogue: 0,1:31:10.99,1:31:13.37,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,1:31:13.37,1:31:15.77,Default,,0,0,0,,Үлкен атаның футболы.
Dialogue: 0,1:31:15.77,1:31:19.27,Default,,0,0,0,,Иә. Болашаққа қосылыңыз.
Dialogue: 0,1:31:22.70,1:31:26.69,Default,,0,0,0,,Біздің. Футбол ойна!
Dialogue: 0,1:31:26.69,1:31:29.07,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:31:29.07,1:31:31.07,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:31:59.52,1:32:02.07,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,1:32:02.07,1:32:05.07,Default,,0,0,0,,Жоғары кернеу!
Dialogue: 0,1:32:12.01,1:32:15.40,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,1:32:15.40,1:32:18.34,Default,,0,0,0,,[Майк] Каминаримон ақыры жеңіске жетті!
Dialogue: 0,1:32:18.34,1:32:23.64,Default,,0,0,0,,Лорд Эндо!
Dialogue: 0,1:32:26.01,1:32:32.81,Default,,0,0,0,,Біз жеңіліске жол бере алмаймыз!
Dialogue: 0,1:32:50.64,1:32:54.84,Default,,0,0,0,,Мамору Эндо Футболды тастаңыз! Қарғыс атқыр...
Dialogue: 0,1:32:54.84,1:32:58.68,Default,,0,0,0,,Оны тастаңыз!
Dialogue: 0,1:32:58.68,1:33:02.65,Default,,0,0,0,,Endo!
Dialogue: 0,1:33:02.65,1:33:04.70,Default,,0,0,0,,Капитан!
Dialogue: 0,1:33:04.70,1:33:06.70,Default,,0,0,0,,Endo!
Dialogue: 0,1:33:06.70,1:33:09.67,Default,,0,0,0,,Арғы ата!
Dialogue: 0,1:33:09.67,1:33:14.53,Default,,0,0,0,,Бадап. Мен футболды тастамаймын!
Dialogue: 0,1:33:14.53,1:33:17.38,Default,,0,0,0,,Менің футболды жақсы көретін достарым болғанша.
Dialogue: 0,1:33:17.38,1:33:21.03,Default,,0,0,0,,Мен ешқашан берілмеймін!
Dialogue: 0,1:33:21.03,1:33:24.07,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,1:33:24.07,1:33:28.07,Default,,0,0,0,,Оны болашаққа жеткізіңіз!
Dialogue: 0,1:33:42.02,1:33:47.06,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,1:33:47.06,1:33:49.56,Default,,0,0,0,,Мен жеңіліске жол бере алмаймын!
Dialogue: 0,1:34:04.03,1:34:08.18,Default,,0,0,0,,Өйткені, менің арғы атам керемет!
Dialogue: 0,1:34:10.22,1:34:15.22,Default,,0,0,0,,[Майк] Матч аяқталды! Каминаримон 3-2 есебімен жеңді!
Dialogue: 0,1:34:17.87,1:34:19.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:34:23.01,1:34:27.02,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:34:27.02,1:34:31.00,Default,,0,0,0,,Миссия сәтсіз болды ма?
Dialogue: 0,1:34:31.00,1:34:33.00,Default,,0,0,0,,Бадап.
Dialogue: 0,1:34:37.31,1:34:40.33,Default,,0,0,0,,Ой, бұл финалдық матч болды.
Dialogue: 0,1:34:40.33,1:34:44.52,Default,,0,0,0,,Мен сендермен ойын ойнағаныма қуаныштымын.
Dialogue: 0,1:34:44.52,1:34:47.39,Default,,0,0,0,,Ендеше тағы да футбол ойнайық.
Dialogue: 0,1:34:47.39,1:34:50.69,Default,,0,0,0,,Сол сиқырды бізге де жасайсың ба?
Dialogue: 0,1:34:50.69,1:34:55.11,Default,,0,0,0,,Шайқас біткен соң бәріміз доспыз.
Dialogue: 0,1:34:55.11,1:35:00.48,Default,,0,0,0,,Бұл идея болашақ адамдарды әлсіретіп жіберді.
Dialogue: 0,1:35:00.48,1:35:03.02,Default,,0,0,0,,Мен қалай күресу керектігін ұмытып қалдым.
Dialogue: 0,1:35:03.02,1:35:05.99,Default,,0,0,0,,Сондықтан біз болашақты өзгертуге тырыстық.
Dialogue: 0,1:35:05.99,1:35:08.67,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,1:35:08.67,1:35:11.69,Default,,0,0,0,,Шын мәнінде мықты болу үшін →
Dialogue: 0,1:35:11.69,1:35:13.65,Default,,0,0,0,,Бұл жерде емес пе?
Dialogue: 0,1:35:13.65,1:35:17.35,Default,,0,0,0,,Ең бастысы - ұрыспау.
Dialogue: 0,1:35:17.35,1:35:20.70,Default,,0,0,0,,Бұл сіздің күресуге батылыңыз бар екенін білдіреді.
Dialogue: 0,1:35:20.70,1:35:24.36,Default,,0,0,0,,Батылдық болса, болашақты өзгертуге болады.
Dialogue: 0,1:35:24.36,1:35:27.69,Default,,0,0,0,,Сіз тіпті достарыңызбен бірге күшті бола аласыз.
Dialogue: 0,1:35:27.69,1:35:29.68,Default,,0,0,0,,Иә.
Dialogue: 0,1:35:29.68,1:35:31.68,Default,,0,0,0,,《Батылдық…》
Dialogue: 0,1:35:37.04,1:35:40.39,Default,,0,0,0,,《Досым?》
Dialogue: 0,1:35:40.39,1:35:46.34,Default,,0,0,0,,Біз сенің батылдығыңнан айырылған шығармыз.
Dialogue: 0,1:35:46.34,1:35:52.52,Default,,0,0,0,,Эндоу-ками, болашақ бұл... Біз көшуіміз керек болашақ...
Dialogue: 0,1:35:52.52,1:35:54.52,Default,,0,0,0,,Сіз оны табасыз.
Dialogue: 0,1:35:54.52,1:35:58.16,Default,,0,0,0,,Сіздің батылдығыңыз үшін.
Dialogue: 0,1:35:58.16,1:36:00.66,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,1:36:11.42,1:36:13.42,Default,,0,0,0,,Бадап!
Dialogue: 0,1:36:39.96,1:36:42.52,Default,,0,0,0,,Арғы ата!
Dialogue: 0,1:36:42.52,1:36:44.54,Default,,0,0,0,,Рахмет, Канон.
Dialogue: 0,1:36:44.54,1:36:51.16,Default,,0,0,0,,Фубуки Хирото Торамару Фидио.
Dialogue: 0,1:36:51.16,1:36:56.03,Default,,0,0,0,,Мамору Біз бәріміз сіздермен қайтадан футбол ойнайтын күнді асыға күтеміз.
Dialogue: 0,1:36:56.03,1:36:58.37,Default,,0,0,0,,Иә! аа!
Dialogue: 0,1:36:58.37,1:37:01.02,Default,,0,0,0,,Олай болса, үлкен ата.
Dialogue: 0,1:37:01.02,1:37:04.51,Default,,0,0,0,,Мен сендермен ойнағаныма қуаныштымын.
Dialogue: 0,1:37:04.51,1:37:07.66,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,1:37:07.66,1:37:09.99,Default,,0,0,0,,Қош бол, арғы ата.
Dialogue: 0,1:37:09.99,1:37:11.99,Default,,0,0,0,,Олай болса, канон.
Dialogue: 0,1:37:32.97,1:37:36.47,Default,,0,0,0,,Endo!
Dialogue: 0,1:37:36.47,1:37:39.47,Default,,0,0,0,,[Майк] Football Frontier ұлттық турнирі.
Dialogue: 0,1:37:39.47,1:37:42.19,Default,,0,0,0,,[Майк] Каминаримон орта мектебі кескілескен шайқаста жеңіске жетті.
Dialogue: 0,1:37:42.19,1:37:45.65,Default,,0,0,0,,[Майк] Жапонияда жаңа нөмір бірінші дүниеге келді!
Dialogue: 0,1:37:45.65,1:37:51.15,Default,,0,0,0,,Біз Жапониядағы ең жақсымыз! (Барлығы) О!
Dialogue: 0,1:38:04.03,1:38:09.37,Default,,0,0,0,,＜ Бұдан былай, ``Иназума он бір фильм: ең күшті армия дұшпандарының шабуылы'' →
Dialogue: 0,1:38:09.37,1:38:11.97,Default,,0,0,0,,Тек соңына дейін көргендер үшін...＞
Dialogue: 0,1:38:19.73,1:38:21.73,Default,,0,0,0,,<Мен сізге ерекше нәрсе көрсетемін! ＞
Dialogue: 0,1:38:30.02,1:39:18.02,Default,,0,0,0,,♪♪～
Dialogue: 0,1:39:24.06,1:39:27.06,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,1:39:30.03,1:39:32.60,Default,,0,0,0,,Сіз мүлдем кешіктіңіз!
Dialogue: 0,1:39:32.60,1:39:35.60,Default,,0,0,0,,Таңғы жаттығу басталды!
Dialogue: 0,1:39:43.50,1:39:45.50,Default,,0,0,0,,Бұл...
Dialogue: 0,1:39:45.50,1:39:49.17,Default,,0,0,0,,Сіз не айтасыз, төраға Канаяма?
Dialogue: 0,1:39:49.17,1:39:51.21,Default,,0,0,0,,Жаңа айтқанымдай.
Dialogue: 0,1:39:51.21,1:39:54.36,Default,,0,0,0,,Қайырлы таң. (Шинсуке) Тенма.
Dialogue: 0,1:39:54.36,1:39:57.21,Default,,0,0,0,,Кеш болды. (Тенма) Кешіріңіз, Микуни-сенпай.
Dialogue: 0,1:39:57.21,1:40:01.68,Default,,0,0,0,,Не болды? Директор Кидоға және сізге →
Dialogue: 0,1:40:01.68,1:40:07.11,Default,,0,0,0,,Бүгін, осы сәттен бастап мен сізден оқу-жаттығу жиыны ретінде де қызмет ететін экспедицияға баруыңызды сұраймын.
Dialogue: 0,1:40:07.11,1:40:09.69,Default,,0,0,0,,Экспедиция?
Dialogue: 0,1:40:09.69,1:40:13.49,Default,,0,0,0,,Күтіңіз. Біз қазір қасиетті жолдың бел ортасындамыз.
Dialogue: 0,1:40:13.49,1:40:15.50,Default,,0,0,0,,Неліктен экспедиция осында?
Dialogue: 0,1:40:15.50,1:40:19.43,Default,,0,0,0,,Бұл Бесінші сектордың нұсқауы.
Dialogue: 0,1:40:19.43,1:40:22.32,Default,,0,0,0,,Өйткені сендер маған қарсы төбелеспексіңдер.
Dialogue: 0,1:40:22.32,1:40:25.72,Default,,0,0,0,,Бұл қудалау ма? (Вундеркинд) Осындай кездерде.
Dialogue: 0,1:40:25.72,1:40:28.53,Default,,0,0,0,,Бұл бір жағынан жағымсыз, Амаги мырза.
Dialogue: 0,1:40:28.53,1:40:31.65,Default,,0,0,0,,Сіз не ойлап отырсыз? (Кагеяма) Бұл ақылсыз.
Dialogue: 0,1:40:31.65,1:40:33.98,Default,,0,0,0,,Бұл революцияның соңы болуы мүмкін.
Dialogue: 0,1:40:33.98,1:40:37.19,Default,,0,0,0,,Вундеркинд Сізде жағымсыз сезім жоқ па?
Dialogue: 0,1:40:37.19,1:40:39.19,Default,,0,0,0,,Аа, әрине.
Dialogue: 0,1:40:39.19,1:40:41.31,Default,,0,0,0,,Менің қайда барғанымды қалайсыз?
Dialogue: 0,1:40:41.31,1:40:43.31,Default,,0,0,0,,Барсаң түсінесің.
Dialogue: 0,1:40:43.31,1:40:45.34,Default,,0,0,0,,Бұл мағынасы жоқ.
Dialogue: 0,1:40:45.34,1:40:47.35,Default,,0,0,0,,Оқу-жаттығу лагері….
Dialogue: 0,1:40:47.35,1:40:51.20,Default,,0,0,0,,Не болды? Кенджо-кун. Сіздің ойыңыз бар ма?
Dialogue: 0,1:40:51.20,1:40:53.69,Default,,0,0,0,,Жоқ (Нишики) Маған ұнамайды.
Dialogue: 0,1:40:53.69,1:40:55.82,Default,,0,0,0,,Ағайын... Мынадай бірдеңе →
Dialogue: 0,1:40:55.82,1:40:58.51,Default,,0,0,0,,Барудың қажеті жоқ, директор Киду.
Dialogue: 0,1:40:58.51,1:41:01.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:41:01.01,1:41:03.01,Default,,0,0,0,,Білгіңіз келмейді ме?
Dialogue: 0,1:41:03.01,1:41:06.18,Default,,0,0,0,,Бұрынғы директор Эндо-кунның жағдайы қалай?
Dialogue: 0,1:41:06.18,1:41:08.63,Default,,0,0,0,,Не! ? Директор Эндо?
Dialogue: 0,1:41:08.63,1:41:10.69,Default,,0,0,0,,Сол оқу-жаттығу жиынына барсаңыз→
Dialogue: 0,1:41:10.69,1:41:12.99,Default,,0,0,0,,Бұл директор Эндо бар дегенді білдіре ме?
Dialogue: 0,1:41:12.99,1:41:17.03,Default,,0,0,0,,Ол бізге көмектесіп жатыр.
Dialogue: 0,1:41:17.03,1:41:20.33,Default,,0,0,0,,Сен сондай ақымақсың! Эндо….
Dialogue: 0,1:41:20.33,1:41:25.67,Default,,0,0,0,,((Кидо) Мен Каминаримонның директоры қызметінен кетемін.
Dialogue: 0,1:41:25.67,1:41:28.40,Default,,0,0,0,,Мен оның орнына директор қызметін атқарғаныңызды қалаймын.
Dialogue: 0,1:41:28.40,1:41:30.70,Default,,0,0,0,,Не туралы айтып тұрсың, Энду?
Dialogue: 0,1:41:35.98,1:41:40.03,Default,,0,0,0,,Дәл қазір Каминаримонды сеніп тапсыратын жалғыз адам саған.
Dialogue: 0,1:41:40.03,1:41:42.48,Default,,0,0,0,,Кидудан сұраңыз.
Dialogue: 0,1:41:42.48,1:41:44.52,Default,,0,0,0,,Сіз…))
Dialogue: 0,1:41:44.52,1:41:48.97,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес. Мүлдем жоқ!
Dialogue: 0,1:41:48.97,1:41:52.36,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің өтінішіңізді қабылдамауым керек...
Dialogue: 0,1:41:52.36,1:41:55.01,Default,,0,0,0,,Барғыңыз келе ме? Директор Кидо.
Dialogue: 0,1:41:55.01,1:41:58.65,Default,,0,0,0,,Директор Эндо жігіттердің бір нәрсені байқады→
Dialogue: 0,1:41:58.65,1:42:00.70,Default,,0,0,0,,Сіз шара қолданбадыңыз ба?
Dialogue: 0,1:42:00.70,1:42:04.02,Default,,0,0,0,,Егер солай болса, мен үндемей отыра алмаймын.
Dialogue: 0,1:42:04.02,1:42:05.99,Default,,0,0,0,,Капитан!
Dialogue: 0,1:42:05.99,1:42:08.56,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,1:42:08.56,1:42:11.06,Default,,0,0,0,,Тенма! иә!
Dialogue: 0,1:42:14.32,1:42:17.37,Default,,0,0,0,,Бәріңіз жақсы ма?
Dialogue: 0,1:42:17.37,1:42:21.01,Default,,0,0,0,,Шынымды айтсам, бұл қақпан.
Dialogue: 0,1:42:21.01,1:42:24.44,Default,,0,0,0,,((Сендер қалуларың керек. Иә?
Dialogue: 0,1:42:24.44,1:42:29.03,Default,,0,0,0,,Каминаримон енді бесінші секторға қарсы күштердің орталық қатысуы болып табылады.
Dialogue: 0,1:42:29.03,1:42:31.65,Default,,0,0,0,,Бұл жерден бәріміз кете алмаймыз.
Dialogue: 0,1:42:31.65,1:42:33.68,Default,,0,0,0,,Вундеркинд балалар….
Dialogue: 0,1:42:33.68,1:42:37.51,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,1:42:37.51,1:42:40.01,Default,,0,0,0,,Ах))
Dialogue: 0,1:42:40.01,1:42:44.68,Default,,0,0,0,,Менің қазір сенуден басқа амалым жоқ. Мен келісемін.
Dialogue: 0,1:42:44.68,1:42:48.32,Default,,0,0,0,,Сіз оны лас деп ойламайсыз ба?
Dialogue: 0,1:42:48.32,1:42:50.35,Default,,0,0,0,,Директор Эндоның атын атасаңыз→
Dialogue: 0,1:42:50.35,1:42:52.34,Default,,0,0,0,,Барлығы бармайтын жол жоқ.
Dialogue: 0,1:42:52.34,1:42:56.34,Default,,0,0,0,,Бірақ шынымен де бақылаушы бар ма? (Су құстары) Бұл қызық.
Dialogue: 0,1:42:56.34,1:43:00.68,Default,,0,0,0,,Жаудың қалтасына түсуге батылдық білдіреді.
Dialogue: 0,1:43:00.68,1:43:04.05,Default,,0,0,0,,Синсуке?
Dialogue: 0,1:43:04.05,1:43:07.74,Default,,0,0,0,,Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,1:43:07.74,1:43:12.74,Default,,0,0,0,,Иә? Мен ұйықтап жатырмын.
Dialogue: 0,1:43:40.75,1:43:46.89,Default,,0,0,0,,Міне... Байқадың ба, Тенма?
Dialogue: 0,1:43:46.89,1:43:51.31,Default,,0,0,0,,Капитан, ол қайда? Мұнда. Мен білмеймін.
Dialogue: 0,1:43:51.31,1:43:54.37,Default,,0,0,0,,Тенма, сен жақсы ма? Синсуке!
Dialogue: 0,1:43:54.37,1:43:56.73,Default,,0,0,0,,Сіз білмей жатып ұйықтап қалған сияқтысыз.
Dialogue: 0,1:43:56.73,1:43:58.65,Default,,0,0,0,,Сондай-ақ, жақсы ұйықтаңыз.
Dialogue: 0,1:43:58.65,1:44:02.04,Default,,0,0,0,,Бұл оқу-жаттығу жиыны ма? Онда ештеңе жоқ.
Dialogue: 0,1:44:02.04,1:44:04.31,Default,,0,0,0,,Барлығы осында ма?
Dialogue: 0,1:44:04.31,1:44:06.31,Default,,0,0,0,,Аои және басқалары ше?
Dialogue: 0,1:44:06.31,1:44:10.01,Default,,0,0,0,,Ах, директор Киду, Мизутори-сан және Аканэ-сан→
Dialogue: 0,1:44:10.01,1:44:12.98,Default,,0,0,0,,Аои-чан: Отонаши-сенсэй мұнда да жоқ.
Dialogue: 0,1:44:12.98,1:44:16.99,Default,,0,0,0,,Олардың қолында директор Кидоу және басқалары шығар.
Dialogue: 0,1:44:16.99,1:44:19.64,Default,,0,0,0,,Не болды? Қылыш сарайы.
Dialogue: 0,1:44:19.64,1:44:22.06,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,1:44:22.06,1:44:25.33,Default,,0,0,0,,Бұл жер әдетте Құдай Едем деп аталады.
Dialogue: 0,1:44:25.33,1:44:29.75,Default,,0,0,0,,Тозақ Құдайдың жәннаты деп аталады.
Dialogue: 0,1:44:29.75,1:44:32.35,Default,,0,0,0,,<Кенжоу біледі→
Dialogue: 0,1:44:45.32,1:44:50.50,Default,,0,0,0,,Олар – ең керемет жарқыраушы, Шексіз жарқыраған.
Dialogue: 0,1:44:50.50,1:44:52.52,Default,,0,0,0,,Ол….
Dialogue: 0,1:44:52.52,1:44:56.39,Default,,0,0,0,,Кенджу Бұл жерден қашқан жігіт →\NМен
Dialogue: 0,1:44:56.39,1:44:58.51,Default,,0,0,0,,-тегі жігіттің қайтып келгеніне сене алар емеспін.
Dialogue: 0,1:44:58.51,1:45:01.32,Default,,0,0,0,,Мен жай ғана бұйрықтарды орындадым.
Dialogue: 0,1:45:01.32,1:45:04.35,Default,,0,0,0,,Кенджу Сіз білесіз бе?
Dialogue: 0,1:45:04.35,1:45:09.35,Default,,0,0,0,,Жарайды. Сіз бен біз қазір басқа деңгейдеміз.
Dialogue: 0,1:45:17.72,1:45:20.32,Default,,0,0,0,,Дауыл!
Dialogue: 0,1:45:23.65,1:45:25.89,Default,,0,0,0,,Мен сені кешіре алмаймын.
Dialogue: 0,1:45:25.89,1:45:29.39,Default,,0,0,0,,Қабілеттің осындай деңгейімен ол футболшы сияқты әрекет етеді.
Dialogue: 0,1:45:44.51,1:45:48.90,Default,,0,0,0,,《Сіз өзіңізді қорғай аласыз ба? Сіздің асыл заттарыңыз》
Dialogue: 0,1:45:48.90,1:45:52.68,Default,,0,0,0,,《Шу, не болса да, істейміз→
Dialogue: 0,1:45:52.68,1:45:55.57,Default,,0,0,0,,Достарыңызбен футболды жеңіп, қайтарыңыз! 》
Dialogue: 0,1:45:55.57,1:45:59.07,Default,,0,0,0,,Бұл шайқас бәрін анық көрсетеді!
Dialogue: 0,1:46:02.86,1:46:04.81,Default,,0,0,0,,Қат! тез!
Dialogue: 0,1:46:04.81,1:46:09.05,Default,,0,0,0,,[Майк] (Иго) Хакурю допты алады! Және тез өту!
Dialogue: 0,1:46:09.05,1:46:11.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:46:15.66,1:46:20.36,Default,,0,0,0,,[Майк] Керемет! Нөл Каминаримонмен пастарымен ойнап жүр!
Dialogue: 0,1:46:20.36,1:46:22.38,Default,,0,0,0,,Қандай жылдам!
Dialogue: 0,1:46:22.38,1:46:25.02,Default,,0,0,0,,Бұл ең соңғысы ма? О, құдай...
Dialogue: 0,1:46:25.02,1:46:27.02,Default,,0,0,0,,Сіз осындай қарсыласты жеңе аласыз ба?
Dialogue: 0,1:46:30.72,1:46:33.72,Default,,0,0,0,,Уау!
Dialogue: 0,1:46:38.76,1:46:40.76,Default,,0,0,0,,[Майк] Мақсат!
Dialogue: 0,1:46:51.66,1:46:55.00,Default,,0,0,0,,Тенма Каминаримон Пауэр→
Dialogue: 0,1:46:55.00,1:46:58.62,Default,,0,0,0,,Маған көрсетейін! иә!
Dialogue: 0,1:46:58.62,1:47:02.42,Default,,0,0,0,,Кәне, бәріміз футбол ойнайық! Оу!
Dialogue: 0,1:47:25.06,1:47:27.66,Default,,0,0,0,,Оны аспанға жеткіз!
Dialogue: 0,1:47:32.67,1:47:34.67,Default,,0,0,0,,<Барлығына осыны ғана көрсете аласыз>
Dialogue: 0,1:47:36.17,1:47:42.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
