Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.60,0:00:23.73,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:24.23,0:00:26.06,Default,,0,0,0,,Ол шықты. Маған Чака әкел!
Dialogue: 0,0:00:35.20,0:00:37.12,Default,,0,0,0,,Бұл... мені өлтір!
Dialogue: 0,0:00:37.20,0:00:38.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:47.96,0:00:48.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:51.42,0:00:52.42,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:55.97,0:00:56.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:56.93,0:00:58.76,Default,,0,0,0,,Өлме!
Dialogue: 0,0:00:59.76,0:01:00.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:01.81,0:01:02.47,Default,,0,0,0,,Гах...
Dialogue: 0,0:01:05.52,0:01:06.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:06.94,0:01:07.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:10.61,0:01:11.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:15.49,0:01:16.66,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:22.95,0:01:24.25,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:30.42,0:01:33.55,Default,,0,0,0,,Шүкір, қайда... қайда кетті!
Dialogue: 0,0:01:34.13,0:01:36.34,Default,,0,0,0,,Сыртқа шық, бейбақ.
Dialogue: 0,0:01:36.43,0:01:39.51,Default,,0,0,0,,Ең күшті өлтіруші болды
Dialogue: 0,0:01:40.14,0:01:41.64,Default,,0,0,0,,Аты...
Dialogue: 0,0:01:45.35,0:01:47.56,Default,,0,0,0,,Таро Сакамото
Dialogue: 0,0:01:48.06,0:01:49.06,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:51.57,0:01:55.99,Default,,0,0,0,,Одан барлық жауыздар қорқады
Dialogue: 0,0:01:56.07,0:01:59.95,Default,,0,0,0,,Бұл әр өлтірушінің арманы еді.
Dialogue: 0,0:02:00.99,0:02:02.87,Default,,0,0,0,,Бірақ бір күні...
Dialogue: 0,0:02:04.12,0:02:04.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:05.41,0:02:07.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:07.16,0:02:09.83,Default,,0,0,0,,Гарн!
Dialogue: 0,0:02:10.54,0:02:12.59,Default,,0,0,0,,Ол ғашық болды
Dialogue: 0,0:02:13.75,0:02:15.13,Default,,0,0,0,,Зейнеткерлікке шығу
Dialogue: 0,0:02:16.13,0:02:17.30,Default,,0,0,0,,Неке
Dialogue: 0,0:02:18.05,0:02:19.18,Default,,0,0,0,,Босану
Dialogue: 0,0:02:19.68,0:02:21.01,Default,,0,0,0,,Және…
Dialogue: 0,0:02:23.39,0:02:26.35,Default,,0,0,0,,Сакамото салмақ қосты
Dialogue: 0,0:02:28.60,0:02:30.60,Default,,0,0,0,,♪~
Dialogue: 0,0:03:56.02,0:03:58.03,Default,,0,0,0,,~♪
Dialogue: 0,0:03:59.23,0:04:03.36,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:04:05.95,0:04:06.99,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:04:08.33,0:04:11.29,Default,,0,0,0,,Мен сізді іздедім, Сакамото мырза.
Dialogue: 0,0:04:14.71,0:04:16.46,Default,,0,0,0,,Менеджер, маған қара.
Dialogue: 0,0:04:17.13,0:04:20.88,Default,,0,0,0,,Егер сіз бұл нысанаға жетсеңіз, сізге бір бөтелке шырын тегін беріледі.
Dialogue: 0,0:04:20.96,0:04:23.13,Default,,0,0,0,,О, кеттік!
Dialogue: 0,0:04:23.80,0:04:26.22,Default,,0,0,0,,Ол қыз соңғы кездері мұнда жиі келетін болды.
Dialogue: 0,0:04:26.30,0:04:26.93,Default,,0,0,0,,Иә
Dialogue: 0,0:04:27.01,0:04:28.89,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:29.77,0:04:30.27,Default,,0,0,0,,Ei
Dialogue: 0,0:04:31.77,0:04:33.60,Default,,0,0,0,,А... Мен оны алып тастадым.
Dialogue: 0,0:04:34.10,0:04:34.85,Default,,0,0,0,,Моккай!
Dialogue: 0,0:04:34.94,0:04:38.15,Default,,0,0,0,,Менеджер, маған қараңызшы.
Dialogue: 0,0:04:38.65,0:04:39.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:43.74,0:04:44.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:45.41,0:04:47.24,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:47.74,0:04:50.12,Default,,0,0,0,,Ей, қарғыс атқыр бала!
Dialogue: 0,0:04:50.20,0:04:51.41,Default,,0,0,0,,- (Еркек) Менің ақ шалбарым! -(Бала) Уау...
Dialogue: 0,0:04:51.50,0:04:54.16,Default,,0,0,0,,- (Аой) Бұл қиын! Не істеуім керек? - (Еркек) Саған не істеуім керек?
Dialogue: 0,0:04:54.25,0:04:56.29,Default,,0,0,0,,Ауа райы тамаша, иә~
Dialogue: 0,0:04:59.00,0:04:59.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.75,0:05:00.84,Default,,0,0,0,,Ga!
Dialogue: 0,0:05:02.01,0:05:03.34,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:03.84,0:05:04.42,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:05:09.18,0:05:10.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:15.39,0:05:18.02,Default,,0,0,0,,Цк... Бұл сұмдық семіз.
Dialogue: 0,0:05:18.65,0:05:22.28,Default,,0,0,0,,Менеджер... Рахмет
Dialogue: 0,0:05:22.36,0:05:24.36,Default,,0,0,0,,Жарайды, жарайды, жылама.
Dialogue: 0,0:05:24.44,0:05:25.90,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:05:26.41,0:05:28.07,Default,,0,0,0,,-Сен күткендей.-(Аои және т.б.) Иә?
Dialogue: 0,0:05:28.95,0:05:32.12,Default,,0,0,0,,Шарлы қаламмен төменгі жақтың ұйқы артериясын тесіңіз.
Dialogue: 0,0:05:33.00,0:05:34.45,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:05:36.21,0:05:38.75,Default,,0,0,0,,Көп уақыт болды, Сакамото мырза.
Dialogue: 0,0:05:39.75,0:05:41.30,Default,,0,0,0,,Бұл Шин, эспер.
Dialogue: 0,0:05:45.26,0:05:46.26,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:05:48.76,0:05:51.35,Default,,0,0,0,,Неліктен сіз біреуді жай ғана елестетіп өлтіресіз?
Dialogue: 0,0:05:51.43,0:05:55.02,Default,,0,0,0,,Әй... бұл мен бағыныштымын, Шин!
Dialogue: 0,0:05:57.60,0:05:59.52,Default,,0,0,0,,Бұл рас болды.
Dialogue: 0,0:06:00.02,0:06:03.94,Default,,0,0,0,,Өлтіруші, тоқта. Оның жеке дүкенін басқарады деген қауесет бар.
Dialogue: 0,0:06:06.03,0:06:07.70,Default,,0,0,0,,Қайтып келіңіз, Сакамото мырза.
Dialogue: 0,0:06:08.20,0:06:09.20,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:06:09.28,0:06:11.70,Default,,0,0,0,,Менің денем осылай болды...
Dialogue: 0,0:06:12.41,0:06:14.12,Default,,0,0,0,,Өлтіруші болуға қайта оралма
Dialogue: 0,0:06:18.17,0:06:22.25,Default,,0,0,0,,Бір кездері сізден барлық жауыздар қорқатын.
Dialogue: 0,0:06:22.34,0:06:24.51,Default,,0,0,0,,«Аңызға айналған өлтіруші» деп аталды
Dialogue: 0,0:06:25.38,0:06:28.01,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:06:30.76,0:06:31.85,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:06:35.35,0:06:36.18,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:06:36.77,0:06:39.27,Default,,0,0,0,,Мен рационды ғана жейтінмін.
Dialogue: 0,0:06:39.77,0:06:42.61,Default,,0,0,0,,Шынымды айтсам, сіз қазір ештеңе көре алмайсыз...
Dialogue: 0,0:06:42.69,0:06:43.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.49,0:06:55.33,Default,,0,0,0,,... жылдам
Dialogue: 0,0:06:55.83,0:07:00.00,Default,,0,0,0,,«Семіз болсаң да, мен сені кез келген уақытта өлтіре аламын» деген хабар ма?
Dialogue: 0,0:07:00.08,0:07:01.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:01.50,0:07:03.92,Default,,0,0,0,,О, Сакамото мырза
Dialogue: 0,0:07:04.00,0:07:07.80,Default,,0,0,0,,Мен жақсы тамақ жегеніме ренжідім, бірақ сенен бір жақсылығым бар.
Dialogue: 0,0:07:07.88,0:07:10.13,Default,,0,0,0,,Сакамото мырзадан сұрай алмай қиналдың ба?
Dialogue: 0,0:07:10.22,0:07:14.26,Default,,0,0,0,,Ха! Менен қарапайым адам кейпіне еніп, сені өлтіруімді сұрадың ба?
Dialogue: 0,0:07:16.14,0:07:19.73,Default,,0,0,0,,Ол ағашты биікте кесуге болмайды.
Dialogue: 0,0:07:20.23,0:07:22.06,Default,,0,0,0,,Сакамото мырза, өтінемін.
Dialogue: 0,0:07:23.44,0:07:26.86,Default,,0,0,0,,О, бұл жақсы! Күткендей!
Dialogue: 0,0:07:27.48,0:07:30.65,Default,,0,0,0,,Сакамото мырза, менің қызым көкөніс жемейді...
Dialogue: 0,0:07:33.91,0:07:35.66,Default,,0,0,0,,- (Ана) Ммм - (Қыз) Ойчий
Dialogue: 0,0:07:35.74,0:07:38.91,Default,,0,0,0,,Бір ғана доп бар
Dialogue: 0,0:07:42.62,0:07:43.71,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:07:43.79,0:07:44.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:45.46,0:07:46.63,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:47.13,0:07:49.21,Default,,0,0,0,,Сіз де қалада шебер болып жұмыс істейсіз бе?
Dialogue: 0,0:07:51.76,0:07:53.55,Default,,0,0,0,,Хе, мен көрдім.
Dialogue: 0,0:07:53.64,0:07:57.39,Default,,0,0,0,,Сіз өзіңіздің шынайы болмысыңызды жасырып, қаламен жақсы араласып кеткен сияқтысыз.
Dialogue: 0,0:07:57.47,0:07:59.89,Default,,0,0,0,,Жай... Сакамото мырза
Dialogue: 0,0:08:00.64,0:08:02.39,Default,,0,0,0,,Менің көзқарасым бойынша, сіз қазірсіз
Dialogue: 0,0:08:03.52,0:08:05.61,Default,,0,0,0,,Бұл өте күлкілі.
Dialogue: 0,0:08:06.36,0:08:07.48,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:08:08.86,0:08:09.78,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:08:09.86,0:08:11.70,Default,,0,0,0,,Қатты бала!
Dialogue: 0,0:08:16.53,0:08:19.33,Default,,0,0,0,,Сакамото мырза, сізді соңғы рет көргеніме 5 жыл болды.
Dialogue: 0,0:08:19.83,0:08:21.79,Default,,0,0,0,,Бұл өте бұйра...
Dialogue: 0,0:08:23.21,0:08:24.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:24.75,0:08:28.17,Default,,0,0,0,,Бұл өте керемет, Сакамото мырза!
Dialogue: 0,0:08:28.25,0:08:31.26,Default,,0,0,0,,Өйткені семіз болсаң да, аураң бөлек.
Dialogue: 0,0:08:31.76,0:08:33.34,Default,,0,0,0,,Моккай бірге
Dialogue: 0,0:08:33.43,0:08:36.14,Default,,0,0,0,,Жақсы жұмыс! Қарғыс атсын!
Dialogue: 0,0:08:36.22,0:08:38.60,Default,,0,0,0,,- (Анашым) Қарама! -Аххаха!
Dialogue: 0,0:08:38.68,0:08:41.35,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:08:42.60,0:08:43.31,Default,,0,0,0,,Иә
Dialogue: 0,0:08:43.81,0:08:45.60,Default,,0,0,0,,Сіз оны көндіре алдыңыз ба?
Dialogue: 0,0:08:45.69,0:08:46.65,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:08:46.73,0:08:49.48,Default,,0,0,0,,Сонда сен оны өлтірдің бе?
Dialogue: 0,0:08:51.94,0:08:52.82,Default,,0,0,0,,Босс
Dialogue: 0,0:08:53.49,0:08:56.37,Default,,0,0,0,,Мен оны шынымен өлтіруім керек пе?
Dialogue: 0,0:08:56.45,0:09:00.16,Default,,0,0,0,,Сакамото-сан, сен дәл қазір семізсің. Сіз оны жалғыз қалдырсаңыз да, проблема жоқ ...
Dialogue: 0,0:09:00.24,0:09:00.95,Default,,0,0,0,,Шин
Dialogue: 0,0:09:02.37,0:09:06.92,Default,,0,0,0,,Ұйымнан рұқсатсыз кеткен адамды өлтіру әдетке айналған.
Dialogue: 0,0:09:07.42,0:09:09.59,Default,,0,0,0,,Сакамото ережені бұзды
Dialogue: 0,0:09:10.09,0:09:12.05,Default,,0,0,0,,Сондықтан мен сені тірі қалдыра алмаймын
Dialogue: 0,0:09:12.71,0:09:14.47,Default,,0,0,0,,Сонымен қатар, Шин
Dialogue: 0,0:09:15.09,0:09:18.64,Default,,0,0,0,,Мені өлтірмесең де, алмастыратындар көп!
Dialogue: 0,0:09:18.72,0:09:21.06,Default,,0,0,0,,Көп айта берсең, мен сені бірден өлтіремін...
Dialogue: 0,0:09:21.14,0:09:21.77,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:09:22.27,0:09:24.10,Default,,0,0,0,,Ах... өте тітіркендіргіш
Dialogue: 0,0:09:25.06,0:09:26.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:26.85,0:09:29.44,Default,,0,0,0,,Өйткені, мен оны өлтіруім керек, солай ма?
Dialogue: 0,0:09:33.19,0:09:34.86,Default,,0,0,0,,(Касса операциясының дыбысы)
Dialogue: 0,0:09:57.01,0:09:59.09,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:07.35,0:10:10.40,Default,,0,0,0,,Мен істемесем де, басқа біреу жасайды.
Dialogue: 0,0:10:13.94,0:10:15.40,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:10:20.78,0:10:23.62,Default,,0,0,0,,Өз қолыммен!
Dialogue: 0,0:10:25.16,0:10:28.62,Default,,0,0,0,,Әй, бұл қандай тезек?
Dialogue: 0,0:10:28.71,0:10:31.38,Default,,0,0,0,,Е, тамаша
Dialogue: 0,0:10:32.88,0:10:36.55,Default,,0,0,0,,Иә? Кеше... бұл Шин-кун болатын.
Dialogue: 0,0:10:36.63,0:10:38.80,Default,,0,0,0,,Тағы да келдің бе?
Dialogue: 0,0:10:39.89,0:10:43.76,Default,,0,0,0,,Қараңдар, қараңдаршы, бұл бөтен тезек, солай ма?
Dialogue: 0,0:10:44.39,0:10:46.14,Default,,0,0,0,,Өте жаман балалар
Dialogue: 0,0:10:48.56,0:10:50.65,Default,,0,0,0,,Соғыс уақыты келді
Dialogue: 0,0:11:06.25,0:11:07.58,Default,,0,0,0,,Ай! (Мектеп оқушысы) Ой, қоңырау соғылды.
Dialogue: 0,0:11:12.08,0:11:13.92,Default,,0,0,0,,Сәлеметсіз бе, Сакамото мырза
Dialogue: 0,0:11:14.92,0:11:18.84,Default,,0,0,0,,Негізі мен бүгін бұл қаладан кетемін деп ойлаймын.
Dialogue: 0,0:11:19.34,0:11:21.55,Default,,0,0,0,,Бұған дейін сәлем айтқым келеді...
Dialogue: 0,0:11:27.18,0:11:27.93,Default,,0,0,0,,Бұл туралы ойлану!
Dialogue: 0,0:11:28.02,0:11:28.52,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:38.69,0:11:40.90,Default,,0,0,0,,Жоқ! Кәмпитпен орбита...
Dialogue: 0,0:11:40.99,0:11:41.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:50.08,0:11:52.17,Default,,0,0,0,,Жоқ, мен сіздің ойларыңызды оқи алмаймын.
Dialogue: 0,0:11:54.96,0:11:55.92,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:57.30,0:11:58.34,Default,,0,0,0,,әжесі келіп, оны алып кетуге асығып тұрғандай.
Dialogue: 0,0:12:10.60,0:12:11.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:11.19,0:12:12.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:15.19,0:12:16.02,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:17.48,0:12:20.03,Default,,0,0,0,,Ей, қазірден бастап дайындал...
Dialogue: 0,0:12:23.86,0:12:24.87,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:28.99,0:12:30.29,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:12:36.84,0:12:40.17,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:12:49.06,0:12:51.89,Default,,0,0,0,,Жақында тамақ келеді. Өтінемін маған көмектесіңіз.
Dialogue: 0,0:12:51.98,0:12:52.89,Default,,0,0,0,,Иә
Dialogue: 0,0:12:53.39,0:12:54.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:55.02,0:12:57.11,Default,,0,0,0,,А, мен ояндым!
Dialogue: 0,0:12:57.19,0:12:59.98,Default,,0,0,0,,О, жақсы, жақсы.
Dialogue: 0,0:13:03.15,0:13:04.28,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:13:04.95,0:13:06.82,Default,,0,0,0,,Дүкеннің екінші қабаты.
Dialogue: 0,0:13:09.28,0:13:11.70,Default,,0,0,0,,Қаласаңыз, тамақ ішіңіз.
Dialogue: 0,0:13:11.79,0:13:13.00,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:13:13.08,0:13:16.96,Default,,0,0,0,,Күріш үлкен бе? Арнайы бөлік? Мега бөлігі?
Dialogue: 0,0:13:18.34,0:13:19.50,Default,,0,0,0,,Кәдімгі...
Dialogue: 0,0:13:20.71,0:13:22.38,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:13:22.46,0:13:24.93,Default,,0,0,0,,Не... неге бұл болып жатыр...
Dialogue: 0,0:13:25.43,0:13:26.72,Default,,0,0,0,,Менің миссиям бар...
Dialogue: 0,0:13:27.22,0:13:27.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:28.51,0:13:29.93,Default,,0,0,0,,Мен улы болады деп ойламадым...
Dialogue: 0,0:13:30.43,0:13:33.98,Default,,0,0,0,,Я, улы жаттығу сені өлтіреді...
Dialogue: 0,0:13:40.61,0:13:41.78,Default,,0,0,0,,Дәмді...
Dialogue: 0,0:13:42.90,0:13:44.36,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:13:44.44,0:13:48.03,Default,,0,0,0,,Хехе, менде бұрынғы сен сияқты реакция бар.
Dialogue: 0,0:13:48.12,0:13:49.87,Default,,0,0,0,,Әкеммен
Dialogue: 0,0:13:50.99,0:13:52.04,Default,,0,0,0,,Не?
Dialogue: 0,0:13:52.54,0:13:53.95,Default,,0,0,0,,Не? бұл сезім
Dialogue: 0,0:13:54.45,0:13:57.88,Default,,0,0,0,,Бұрынғы жұмысымның ешқайсысында мұндайды бастан өткерген емеспін...
Dialogue: 0,0:13:57.96,0:13:59.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:59.17,0:14:00.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:01.71,0:14:03.01,Default,,0,0,0,,Сакамото мырза
Dialogue: 0,0:14:03.51,0:14:07.09,Default,,0,0,0,,Осы қалыпты күнделікті өмірді қорғау
Dialogue: 0,0:14:08.43,0:14:09.76,Default,,0,0,0,,Өлтіруші...
Dialogue: 0,0:14:19.40,0:14:21.65,Default,,0,0,0,,Сакамото мырза, мен...
Dialogue: 0,0:14:26.40,0:14:27.74,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:14:30.03,0:14:30.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.96,0:14:43.09,Default,,0,0,0,,Мен Сакамото мырзаны жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:14:53.22,0:14:56.02,Default,,0,0,0,,Әңгіме қандай? Шин
Dialogue: 0,0:14:59.14,0:15:00.31,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:15:00.81,0:15:03.94,Default,,0,0,0,,Сакамотоны өлтіруге болмай ма?
Dialogue: 0,0:15:05.32,0:15:06.03,Default,,0,0,0,,Босс
Dialogue: 0,0:15:06.53,0:15:09.45,Default,,0,0,0,,Не? Сенің сылтауларыңды тыңдағым келмейді.
Dialogue: 0,0:15:09.53,0:15:12.32,Default,,0,0,0,,Сакамото мырзаны назардан тыс қалдыра аласыз ба?
Dialogue: 0,0:15:13.62,0:15:16.16,Default,,0,0,0,,Догеза болады деп күтпедім.
Dialogue: 0,0:15:17.33,0:15:20.75,Default,,0,0,0,,Неліктен? Неліктен Сакамотоны қорғау керек?
Dialogue: 0,0:15:20.83,0:15:24.67,Default,,0,0,0,,Ол адамның енді қайтып келетін орны бар.
Dialogue: 0,0:15:24.75,0:15:28.13,Default,,0,0,0,,Сакамото бұл дүниенің ережелерін бұзды.
Dialogue: 0,0:15:28.22,0:15:30.01,Default,,0,0,0,,Мен өз жауапкершілігімнен бас тарттым.
Dialogue: 0,0:15:30.51,0:15:31.93,Default,,0,0,0,,Сондықтан өлтіріңіз
Dialogue: 0,0:15:32.80,0:15:36.14,Default,,0,0,0,,Менің жауапкершілігім болса, оның орнына мен өлемін.
Dialogue: 0,0:15:36.72,0:15:38.81,Default,,0,0,0,,Сакамото мырзаны сағынуыңызды өтінемін
Dialogue: 0,0:15:39.77,0:15:41.44,Default,,0,0,0,,Неліктен мұндай ұзаққа бару керек?
Dialogue: 0,0:15:42.86,0:15:45.52,Default,,0,0,0,,Мен тамсанған адамға мылтық сілтедім.
Dialogue: 0,0:15:46.32,0:15:47.82,Default,,0,0,0,,Бұл менің адамдарды жазалау тәсілім.
Dialogue: 0,0:15:50.11,0:15:51.24,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:51.74,0:15:54.83,Default,,0,0,0,,Теми өлсе, Сакамотоны тірі қалдырамын.
Dialogue: 0,0:15:55.95,0:15:57.87,Default,,0,0,0,,Бұл қоқыс.
Dialogue: 0,0:15:57.95,0:16:00.04,Default,,0,0,0,,Амал жоқ, ақымақ.
Dialogue: 0,0:16:00.12,0:16:01.75,Default,,0,0,0,,Тез өл
Dialogue: 0,0:16:03.00,0:16:04.00,Default,,0,0,0,,Мен оны толығымен естимін.
Dialogue: 0,0:16:04.08,0:16:05.13,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:05.63,0:16:07.75,Default,,0,0,0,,Міне, мен солай ойладым.
Dialogue: 0,0:16:07.84,0:16:09.72,Default,,0,0,0,,Бұл жігіттің жүрегі...
Dialogue: 0,0:16:10.30,0:16:11.26,Default,,0,0,0,,(Изуку) Кайри-чанның квиркі күшейіп келеді
Dialogue: 0,0:16:11.34,0:16:12.51,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ
Dialogue: 0,0:16:12.59,0:16:13.26,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:13.89,0:16:18.52,Default,,0,0,0,,(құлаққаптан ағып жатқан мылтық дыбысы)
Dialogue: 0,0:16:50.88,0:16:51.38,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:53.34,0:16:54.89,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:16:57.14,0:16:59.26,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:00.39,0:17:02.18,Default,,0,0,0,,Мен сені ара ұясына айналдырамын
Dialogue: 0,0:17:02.27,0:17:02.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:06.40,0:17:07.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:10.61,0:17:13.53,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:14.53,0:17:15.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.82,0:17:19.28,Default,,0,0,0,,Хаха, оны жоғарыдан көруге болады.
Dialogue: 0,0:17:19.87,0:17:20.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:22.66,0:17:23.62,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:17:24.25,0:17:26.29,Default,,0,0,0,,Не істеп жатырсың! тек бір адам
Dialogue: 0,0:17:26.38,0:17:29.29,Default,,0,0,0,,Менің қимылдарым оқылып жатқан сияқты...
Dialogue: 0,0:17:29.88,0:17:31.21,Default,,0,0,0,,Ол эспер.
Dialogue: 0,0:17:31.71,0:17:33.80,Default,,0,0,0,,Тым жақын болсаң, ойың оқылады.
Dialogue: 0,0:17:33.88,0:17:35.84,Default,,0,0,0,,Алысқа барыңыз!
Dialogue: 0,0:17:38.97,0:17:40.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:41.39,0:17:42.72,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:43.85,0:17:45.44,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:46.73,0:17:48.86,Default,,0,0,0,,Цк... Бұл соңғысы ма?
Dialogue: 0,0:17:50.57,0:17:52.78,Default,,0,0,0,,Бізде күштеп өтуден басқа амал жоқ
Dialogue: 0,0:17:55.15,0:17:56.57,Default,,0,0,0,,- (Өлтіруші) Уф... - (Өлтіруші) Уф!
Dialogue: 0,0:17:57.70,0:17:58.57,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:02.83,0:18:03.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:07.75,0:18:08.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:08.71,0:18:09.75,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:18:11.09,0:18:13.26,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:18:22.14,0:18:23.60,Default,,0,0,0,,Сакамото мырза...
Dialogue: 0,0:18:23.68,0:18:25.31,Default,,0,0,0,,Сакамото…
Dialogue: 0,0:18:25.81,0:18:26.60,Default,,0,0,0,,(Изуку) Кайри-чанның квиркі күшейіп келеді
Dialogue: 0,0:18:26.69,0:18:27.52,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:18:27.60,0:18:28.69,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:18:34.82,0:18:36.07,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:36.15,0:18:37.78,Default,,0,0,0,,Бейбақ! Уф...
Dialogue: 0,0:18:37.86,0:18:38.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:40.16,0:18:40.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:41.83,0:18:42.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:43.83,0:18:45.25,Default,,0,0,0,,Бітір!
Dialogue: 0,0:18:45.33,0:18:47.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:47.21,0:18:48.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:48.25,0:18:48.96,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:18:52.63,0:18:53.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:56.01,0:18:56.84,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:00.97,0:19:02.60,Default,,0,0,0,,- (Өлтіруші) Арх! - (Өлтіруші) Өл!
Dialogue: 0,0:19:04.39,0:19:06.14,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:19:13.73,0:19:14.98,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:15.69,0:19:17.99,Default,,0,0,0,,Енді ше...
Dialogue: 0,0:19:18.07,0:19:19.57,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:19:20.16,0:19:21.53,Default,,0,0,0,,(Бакуго) Соңына дейін оны сақ ұстап тұрам, шаршағанда аяғында тастаймын!
Dialogue: 0,0:19:23.20,0:19:26.87,Default,,0,0,0,,H... Бірінен соң бірі жүрмеңіз. Барлығын бірден атамыз!
Dialogue: 0,0:19:31.00,0:19:31.92,Default,,0,0,0,,Түсіру
Dialogue: 0,0:19:32.00,0:19:32.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:36.21,0:19:37.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.09,0:19:40.80,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:42.43,0:19:44.85,Default,,0,0,0,,Боқ... бірақ...
Dialogue: 0,0:19:46.47,0:19:48.77,Default,,0,0,0,,Керемет, бұл...
Dialogue: 0,0:19:50.52,0:19:54.98,Default,,0,0,0,,Аты аңызға айналған өлтіруші Таро Сакамото
Dialogue: 0,0:19:56.98,0:20:00.20,Default,,0,0,0,,А... Сакамото мырза, мұнда неге?
Dialogue: 0,0:20:03.91,0:20:04.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:06.29,0:20:08.45,Default,,0,0,0,,Және... тыңдау құрылғысы!
Dialogue: 0,0:20:09.25,0:20:11.29,Default,,0,0,0,,Бұл кеше болды ма?
Dialogue: 0,0:20:11.79,0:20:13.71,Default,,0,0,0,,Сақтыққа жол бермеңіз немесе тәуекелге бармаңыз.
Dialogue: 0,0:20:14.88,0:20:18.05,Default,,0,0,0,,Сакамото мырза, мен шештім.
Dialogue: 0,0:20:18.55,0:20:20.47,Default,,0,0,0,,Не болса да
Dialogue: 0,0:20:20.97,0:20:23.76,Default,,0,0,0,,Мен бүгін осы қаладан кетемін деп ойлаймын...
Dialogue: 0,0:20:24.26,0:20:25.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:26.14,0:20:27.10,Default,,0,0,0,,Алжапқыш?
Dialogue: 0,0:20:28.10,0:20:29.89,Default,,0,0,0,,Сағаттық жалақы 800 иен
Dialogue: 0,0:20:30.39,0:20:32.44,Default,,0,0,0,,Үстеме жұмыс уақыты төлемі бұл...
Dialogue: 0,0:20:34.44,0:20:35.15,Default,,0,0,0,,Иә
Dialogue: 0,0:20:35.23,0:20:36.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:39.94,0:20:40.65,Default,,0,0,0,,Ай! (Мектеп оқушысы) Ой, қоңырау соғылды.
Dialogue: 0,0:20:41.24,0:20:43.95,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:20:46.33,0:20:47.37,Default,,0,0,0,,Сакамото мырза
Dialogue: 0,0:20:48.08,0:20:50.79,Default,,0,0,0,,Менің жанымда рамен жеуді доғаруды сұрай аламын ба?
Dialogue: 0,0:20:51.29,0:20:54.46,Default,,0,0,0,,А... мына көйлек жаңа.
Dialogue: 0,0:20:54.96,0:20:57.04,Default,,0,0,0,,Бізде енді рамен көп емес...
Dialogue: 0,0:20:57.13,0:20:59.55,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:20:59.63,0:21:03.26,Default,,0,0,0,,О, Шинкун, сен маған жақсы көрінесің.
Dialogue: 0,0:21:03.34,0:21:04.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:04.76,0:21:07.01,Default,,0,0,0,,Бұл тақтада! Хехе
Dialogue: 0,0:21:07.51,0:21:08.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.02,0:21:12.81,Default,,0,0,0,,Әже осында
Dialogue: 0,0:21:12.89,0:21:15.73,Default,,0,0,0,,О, мен түсіндім.
Dialogue: 0,0:21:15.81,0:21:19.11,Default,,0,0,0,,Мен мұны іздеп едім, рахмет
Dialogue: 0,0:21:19.19,0:21:21.11,Default,,0,0,0,,Эспер күткендей!
Dialogue: 0,0:21:21.19,0:21:23.49,Default,,0,0,0,,Ей, ойнайық
Dialogue: 0,0:21:23.57,0:21:24.82,Default,,0,0,0,,Жұмыс аяқталғаннан кейін
Dialogue: 0,0:21:25.49,0:21:28.37,Default,,0,0,0,,Иә, бұл қызық па?
Dialogue: 0,0:21:28.87,0:21:31.87,Default,,0,0,0,,А, мен әлі де түсінбеймін...
Dialogue: 0,0:21:32.37,0:21:34.96,Default,,0,0,0,,Алдыңғы жұмысымнан жақсырақ.
Dialogue: 0,0:21:35.04,0:21:37.13,Default,,0,0,0,,Сіз бұрын қандай жұмыс атқардыңыз?
Dialogue: 0,0:21:37.21,0:21:38.63,Default,,0,0,0,,Сөйлессең, мен сені өлтіремін.
Dialogue: 0,0:21:38.71,0:21:39.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:40.00,0:21:42.67,Default,,0,0,0,,Ал... Менің ойымша, бұл тазалаушы сияқты. Қоғамның
Dialogue: 0,0:21:43.17,0:21:44.09,Default,,0,0,0,,...
Dialogue: 0,0:21:50.18,0:21:53.02,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:21:53.81,0:21:55.31,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:21:56.60,0:21:58.61,Default,,0,0,0,,♪~
Dialogue: 0,0:23:24.02,0:23:26.03,Default,,0,0,0,,~♪
