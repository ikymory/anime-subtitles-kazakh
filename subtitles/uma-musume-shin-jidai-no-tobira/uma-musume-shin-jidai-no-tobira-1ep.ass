Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.44,0:00:25.94,Default,,0,0,0,,Ума Мусуме
Dialogue: 0,0:00:26.73,0:00:30.86,Default,,0,0,0,,Олар жүгіру үшін туылған
Dialogue: 0,0:00:31.49,0:00:34.99,Default,,0,0,0,,Кейде оғаш, кейде даңқты тарихы бар.
Dialogue: 0,0:00:35.07,0:00:37.99,Default,,0,0,0,,Өзге дүниенің атымен туған
Dialogue: 0,0:00:38.08,0:00:41.58,Default,,0,0,0,,Сол жанды мұра етіп алып, жүгір
Dialogue: 0,0:00:42.20,0:00:45.71,Default,,0,0,0,,Бұл олардың тағдыры
Dialogue: 0,0:00:46.83,0:00:51.51,Default,,0,0,0,,Бұл дүниеде өмір сүретін жылқы қыздарының болашақ жарыс нәтижесі қандай болады?
Dialogue: 0,0:00:51.59,0:00:54.51,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:55.43,0:00:58.39,Default,,0,0,0,,Олар жүгіруді жалғастырады
Dialogue: 0,0:00:59.18,0:01:03.93,Default,,0,0,0,,Көз алдыңда тұрған мақсатқа ғана ұмтылу
Dialogue: 0,0:01:06.56,0:01:10.48,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:01:10.57,0:01:12.65,Default,,0,0,0,,Ерте көктемгі аспан астында
Dialogue: 0,0:01:12.74,0:01:16.36,Default,,0,0,0,,Классикалық жарыстың болашағын болжайтын маңызды жарыс қазір
Dialogue: 0,0:01:16.45,0:01:17.74,Default,,0,0,0,,Басталуға жақын
Dialogue: 0,0:01:18.78,0:01:22.16,Default,,0,0,0,,Атты қыздардың көңілдері көтеріліп, қақпаға қарай бет алды!
Dialogue: 0,0:01:22.24,0:01:24.66,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:01:24.75,0:01:26.29,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:01:26.37,0:01:28.08,Default,,0,0,0,,Уау, кешігіп қалдым!
Dialogue: 0,0:01:28.17,0:01:31.42,Default,,0,0,0,,Жоқ! Қалта! Тез, мұнда кел!
Dialogue: 0,0:01:31.50,0:01:32.96,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:33.05,0:01:35.05,Default,,0,0,0,,Жарыс басталғалы тұр.
Dialogue: 0,0:01:35.13,0:01:36.72,Default,,0,0,0,,Нашар жаман!
Dialogue: 0,0:01:36.80,0:01:38.89,Default,,0,0,0,,Ол бірдеңе жеп жатыр!
Dialogue: 0,0:01:39.51,0:01:41.43,Default,,0,0,0,,Енді жақтау аяқталды.
Dialogue: 0,0:01:41.51,0:01:46.69,Default,,0,0,0,,Жаңа дәуірдің таңы ретінде қарау үшін жарыс
Dialogue: 0,0:01:46.77,0:01:48.81,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:01:51.52,0:01:52.69,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:01:58.11,0:02:00.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:01.03,0:02:03.12,Default,,0,0,0,,Уау~ Сәлеметсіз бе
Dialogue: 0,0:02:03.20,0:02:06.33,Default,,0,0,0,,Өйткені, бұл фристайл жарыс жолына ұқсамайды.
Dialogue: 0,0:02:06.41,0:02:08.71,Default,,0,0,0,,Сіз Pocket бағдарламасын тікелей эфирде бірінші рет көріп тұрсыз ба?
Dialogue: 0,0:02:08.79,0:02:09.79,Default,,0,0,0,,Твинкл сериясы
Dialogue: 0,0:02:09.88,0:02:11.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:11.38,0:02:15.71,Default,,0,0,0,,Мына ханымдар мұнда қаншалықты жылдам?
Dialogue: 0,0:02:16.63,0:02:17.72,Default,,0,0,0,,Қарап көрейік.
Dialogue: 0,0:02:30.81,0:02:31.52,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:02:31.61,0:02:33.82,Default,,0,0,0,,Фуджикизеки! Фуджикисеки бірден қашып кетеді
Dialogue: 0,0:02:33.90,0:02:36.82,Default,,0,0,0,,Кирано менің жолыммен алдыңғы қатарда сапқа тұрыңыз.
Dialogue: 0,0:02:46.83,0:02:49.21,Default,,0,0,0,,Күшті!
Dialogue: 0,0:02:49.29,0:02:51.42,Default,,0,0,0,,Фуджикисеки бірден алға шықты!
Dialogue: 0,0:02:51.50,0:02:54.30,Default,,0,0,0,,Дегенмен, Кираномай Уэй ішкі қарқынды аздап басқарады.
Dialogue: 0,0:02:54.38,0:02:55.96,Default,,0,0,0,,Жартылай пісірілген қорғасын!
Dialogue: 0,0:02:56.05,0:02:57.34,Default,,0,0,0,,Мына жігіт жылдам...
Dialogue: 0,0:02:57.42,0:02:59.97,Default,,0,0,0,,Жүр! Барлығын бірден соққылаңыз!
Dialogue: 0,0:03:00.05,0:03:01.59,Default,,0,0,0,,Кел, Фуджикизеки
Dialogue: 0,0:03:01.68,0:03:04.10,Default,,0,0,0,,Кирано менің жолыммен алдыңғы қатарда сапқа тұрыңыз.
Dialogue: 0,0:03:06.22,0:03:06.93,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:07.02,0:03:09.02,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:03:09.10,0:03:10.77,Default,,0,0,0,,Осы кезде ізбасарлар кенет көтерілді.
Dialogue: 0,0:03:10.85,0:03:12.31,Default,,0,0,0,,Фуджикисекимен сап түзеуге дайын!
Dialogue: 0,0:03:12.40,0:03:14.48,Default,,0,0,0,,Тура бағытта жүріңіз.
Dialogue: 0,0:03:14.57,0:03:17.23,Default,,0,0,0,,Накаяманың түзулері қысқа!
Dialogue: 0,0:03:17.32,0:03:20.28,Default,,0,0,0,,Бар, жүр, жүр! (2-ер адам) Маған берші! Оны енгізіңіз!
Dialogue: 0,0:03:20.36,0:03:22.74,Default,,0,0,0,,Әлі жоқ! әлі! Әзірше емес!
Dialogue: 0,0:03:22.82,0:03:25.91,Default,,0,0,0,,Фуджикисеки жерленеді ме?
Dialogue: 0,0:03:28.33,0:03:29.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:51.52,0:03:53.27,Default,,0,0,0,,Фуджикизеки Бірінші! Фуджикисеки бірінші!
Dialogue: 0,0:03:53.35,0:03:54.81,Default,,0,0,0,,Хоппау Пабло да сырттан келді!
Dialogue: 0,0:03:54.90,0:03:57.98,Default,,0,0,0,,Екінші орынға көтеріле аласыз ба?
Dialogue: 0,0:04:00.24,0:04:02.07,Default,,0,0,0,,Бірақ Фуджикисеки күшті және күшті!
Dialogue: 0,0:04:02.15,0:04:05.41,Default,,0,0,0,,Бірден қайта бөлініп, көшбасшылығымызды кеңейтейік!
Dialogue: 0,0:04:05.49,0:04:06.91,Default,,0,0,0,,Берілме!
Dialogue: 0,0:04:06.99,0:04:09.29,Default,,0,0,0,,Бұл күш! Фуджикисекидің күші!
Dialogue: 0,0:04:09.37,0:04:10.70,Default,,0,0,0,,2 бөлік қазір үзілген
Dialogue: 0,0:04:10.79,0:04:13.12,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:04:16.42,0:04:18.63,Default,,0,0,0,,Фуджикисеки күткендей күшті болды!
Dialogue: 0,0:04:18.71,0:04:21.05,Default,,0,0,0,,Дебюттік матчтан бері жеңіліссіз 4 рет жеңіс
Dialogue: 0,0:04:21.13,0:04:25.43,Default,,0,0,0,,Классикалық үштік тәжді ұтып алу арманына деген үміт өте жоғары!
Dialogue: 0,0:04:34.65,0:04:38.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:41.40,0:04:43.20,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:04:46.91,0:04:48.74,Default,,0,0,0,,Бұл ақылсыз болды! Шынайы!
Dialogue: 0,0:04:48.83,0:04:51.83,Default,,0,0,0,,Twinkle сериясы басқа деңгейде екені сөзсіз!
Dialogue: 0,0:04:52.41,0:04:55.37,Default,,0,0,0,,Қалта, тезірек үйге қайтайық.
Dialogue: 0,0:04:56.25,0:04:58.79,Default,,0,0,0,,Мен де жүгіруім керек.
Dialogue: 0,0:04:58.88,0:05:00.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:00.92,0:05:05.30,Default,,0,0,0,,Сіз де осылай жүгіріп көріңіз.
Dialogue: 0,0:05:09.89,0:05:12.77,Default,,0,0,0,,Бұрынғы жігітке қараңыз.
Dialogue: 0,0:05:13.48,0:05:15.60,Default,,0,0,0,,Басқаларға қарағанда жылдам
Dialogue: 0,0:05:23.90,0:05:24.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:24.99,0:05:26.61,Default,,0,0,0,,А... Поке мырза!?
Dialogue: 0,0:05:26.70,0:05:27.66,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:27.74,0:05:29.37,Default,,0,0,0,,Мен шештім!
Dialogue: 0,0:05:30.58,0:05:33.75,Default,,0,0,0,,Мен қазір Twinkle сериясын бастағалы жатырмын.
Dialogue: 0,0:05:33.83,0:05:36.17,Default,,0,0,0,,Мықты жігіттерді бір-бірден жеңу
Dialogue: 0,0:05:37.12,0:05:39.17,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:05:39.25,0:05:42.92,Default,,0,0,0,,Мен мұны істеймін! Ең мықты бол!
Dialogue: 0,0:05:55.52,0:05:58.15,Default,,0,0,0,,♪ Жүгіру, жүгіру
Dialogue: 0,0:05:58.23,0:06:01.36,Default,,0,0,0,,♪ Таңданудан тыс
Dialogue: 0,0:06:01.44,0:06:08.20,Default,,0,0,0,,♪ (Дайын!! Тұрақты!! Дерби!!)
Dialogue: 0,0:06:11.91,0:06:14.58,Default,,0,0,0,,♪ Мен оны әлі көрген жоқпын
Dialogue: 0,0:06:14.66,0:06:17.33,Default,,0,0,0,,♪ Жылдамдықтың екінші жағына
Dialogue: 0,0:06:17.41,0:06:19.42,Default,,0,0,0,,♪ (Қызу тамаша!)
Dialogue: 0,0:06:19.50,0:06:22.71,Default,,0,0,0,,♪ Жерге тиген тақа
Dialogue: 0,0:06:22.80,0:06:25.30,Default,,0,0,0,,♪ Мақсат алдындағы ғажайып
Dialogue: 0,0:06:25.38,0:06:28.84,Default,,0,0,0,,♪ Орнату орны - соңғы бұрыш
Dialogue: 0,0:06:28.93,0:06:33.51,Default,,0,0,0,,♪ Мен мүмкіндігінше алысқа бармайынша, демімді басып алғым келеді.
Dialogue: 0,0:06:33.60,0:06:36.02,Default,,0,0,0,,♪ Он мыңдаған көрермендер қол соғуда
Dialogue: 0,0:06:36.10,0:06:38.52,Default,,0,0,0,,♪ Дауыстап жаңғырықтырған қатты дауыстар
Dialogue: 0,0:06:38.60,0:06:40.23,Default,,0,0,0,,♪ Фанфар естіледі
Dialogue: 0,0:06:40.31,0:06:43.02,Default,,0,0,0,,♪ Менің жүрегім қатты соғады
Dialogue: 0,0:06:43.11,0:06:47.53,Default,,0,0,0,,♪ Екінші қол қозғала бастайды, армандар қақпасы ашылады
Dialogue: 0,0:06:47.61,0:06:48.49,Default,,0,0,0,,♪ «Кеттік!»
Dialogue: 0,0:06:48.57,0:06:50.99,Default,,0,0,0,,♪ Жүгіру (хай!) Жүгіру (хай!)
Dialogue: 0,0:06:51.07,0:06:53.87,Default,,0,0,0,,♪ Таңдануыңызды жеңіңіз
Dialogue: 0,0:06:53.95,0:06:56.33,Default,,0,0,0,,♪ Келесі кімдікі! ?
Dialogue: 0,0:06:56.41,0:06:58.83,Default,,0,0,0,,♪ Супер жұлдыз болуды мақсат етіңіз
Dialogue: 0,0:06:58.91,0:07:01.25,Default,,0,0,0,,♪ Мен өмір сүремін (Хай!) Мағынасы не (Хай!)
Dialogue: 0,0:07:01.33,0:07:05.05,Default,,0,0,0,,♪ Мен сені сындырып алғаннан кейін еремін
Dialogue: 0,0:07:05.13,0:07:07.55,Default,,0,0,0,,♪ (Мен жеңгім келеді!) Иә, бұл инстинкт.
Dialogue: 0,0:07:07.63,0:07:10.30,Default,,0,0,0,,♪ (Жүгіргім келеді!) Тоқталмайтын құштарлық
Dialogue: 0,0:07:10.38,0:07:13.68,Default,,0,0,0,,♪ (Айқайлағым келеді!) Жеңістің шуылдауы!
Dialogue: 0,0:07:13.76,0:07:16.47,Default,,0,0,0,,♪ Айқай!
Dialogue: 0,0:07:32.95,0:07:34.45,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:07:38.20,0:07:41.17,Default,,0,0,0,,Жоқ! Ал ше? Ал ше? Менің жарыс формасы!
Dialogue: 0,0:07:41.25,0:07:43.25,Default,,0,0,0,,Салқын қалта
Dialogue: 0,0:07:43.33,0:07:45.17,Default,,0,0,0,,Осы уақытқа дейін дебюттік матчымда басты жүлделер мен қатарынан жеңіске жеттім.
Dialogue: 0,0:07:45.25,0:07:47.17,Default,,0,0,0,,Жақсырақ.
Dialogue: 0,0:07:47.25,0:07:50.05,Default,,0,0,0,,Хехе, маған толығырақ айтып берші, Фудзи-сан.
Dialogue: 0,0:07:50.13,0:07:52.93,Default,,0,0,0,,Фудзи Тым қобалжымаңыз.
Dialogue: 0,0:07:53.01,0:07:55.64,Default,,0,0,0,,Бұл кіші сыныптар үшін ең биік жарыс болады.
Dialogue: 0,0:07:55.72,0:07:59.56,Default,,0,0,0,,Бәйгеге қатысатын атбегі қыздардың деңгейі де бұрынғыдан өзгеше.
Dialogue: 0,0:07:59.64,0:08:02.81,Default,,0,0,0,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:08:03.40,0:08:07.57,Default,,0,0,0,,Ең мықты атты қыз болу үшін нағыз іс қазірден басталады.
Dialogue: 0,0:08:07.65,0:08:10.82,Default,,0,0,0,,Біріншіден, бар күш-жігеріңізді жұмсау туралы ғана ойлаңыз.
Dialogue: 0,0:08:10.90,0:08:12.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:13.61,0:08:15.32,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:08:17.87,0:08:21.16,Default,,0,0,0,,Мұны Фудзи-саннан естігені өте жұбаныш.
Dialogue: 0,0:08:22.41,0:08:24.88,Default,,0,0,0,,Жақсы! Бүгін барлық жігіттер шығады
Dialogue: 0,0:08:24.96,0:08:26.38,Default,,0,0,0,,Мен сені өз жылдамдығыммен ұшырып жіберемін.
Dialogue: 0,0:08:26.46,0:08:28.71,Default,,0,0,0,,Сіз мұны бірден қайталайсыз!
Dialogue: 0,0:08:28.80,0:08:30.84,Default,,0,0,0,,Сенімділік пен мақтаншақтық екі бөлек деп қанша айтсам да...
Dialogue: 0,0:08:30.92,0:08:33.34,Default,,0,0,0,,Наби мырзаның уағыздарын естуден шаршадым.
Dialogue: 0,0:08:33.43,0:08:35.22,Default,,0,0,0,,Ах... Юрико... Мұнда мен үшін орын жоқ па?
Dialogue: 0,0:08:35.30,0:08:36.09,Default,,0,0,0,,Міне! Қалта!
Dialogue: 0,0:08:36.18,0:08:38.10,Default,,0,0,0,,Мен бірінші орын аламын.
Dialogue: 0,0:08:38.18,0:08:40.43,Default,,0,0,0,,Оны асыға күтіңіздер!
Dialogue: 0,0:08:40.52,0:08:41.48,Default,,0,0,0,,Я...
Dialogue: 0,0:08:41.56,0:08:44.85,Default,,0,0,0,,Ұлттық спорттық ойын-сауық
Dialogue: 0,0:08:44.94,0:08:46.61,Default,,0,0,0,,Twinkle сериясы
Dialogue: 0,0:08:46.69,0:08:51.11,Default,,0,0,0,,Мен түсініктеме беремін, Изумимото және Ямамото-сан түсініктеме береді.
Dialogue: 0,0:08:51.19,0:08:52.74,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:08:52.82,0:08:55.74,Default,,0,0,0,,Ханшин ипподромында ауа райы жақсы.
Dialogue: 0,0:08:55.82,0:08:57.91,Default,,0,0,0,,Көптеген көрермендер тамашалады
Dialogue: 0,0:08:57.99,0:09:01.95,Default,,0,0,0,,Бүгінгі басты жарыстың негізгі өтетін жеріне қабылдау басталды.
Dialogue: 0,0:09:04.50,0:09:05.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:30.32,0:09:33.53,Default,,0,0,0,,Ешқандай өсек естіген жоқпын.
Dialogue: 0,0:09:33.61,0:09:35.82,Default,,0,0,0,,Біз бірінші рет жарыста бірге боламыз.
Dialogue: 0,0:09:35.90,0:09:37.11,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:09:38.74,0:09:42.24,Default,,0,0,0,,Эй, тезірек.
Dialogue: 0,0:09:42.95,0:09:44.50,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:09:44.58,0:09:46.16,Default,,0,0,0,,Мен тамақ ішейін
Dialogue: 0,0:09:46.25,0:09:48.29,Default,,0,0,0,,Күшті адамның белгісі жоқ.
Dialogue: 0,0:09:48.38,0:09:50.00,Default,,0,0,0,,Жасырсаң да айта аламын
Dialogue: 0,0:09:50.59,0:09:52.75,Default,,0,0,0,,Өйткені мен әртүрлі адамдармен жүгірдім.
Dialogue: 0,0:09:54.17,0:09:55.26,Default,,0,0,0,,О
Dialogue: 0,0:09:55.34,0:09:59.30,Default,,0,0,0,,Сіз фристайлдан өттіңіз.
Dialogue: 0,0:09:59.39,0:10:00.80,Default,,0,0,0,,Джунгли қалтасы Hmph!
Dialogue: 0,0:10:00.89,0:10:01.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:01.68,0:10:03.68,Default,,0,0,0,,Көремін, қасиеттерін сезінемін.
Dialogue: 0,0:10:03.77,0:10:07.52,Default,,0,0,0,,Қаңқаның тартылуы мен буындардың икемділігі де тамаша.
Dialogue: 0,0:10:07.60,0:10:09.77,Default,,0,0,0,,Осы уақытқа дейін жеңілмегеніміз мағынасы бар.
Dialogue: 0,0:10:09.86,0:10:11.27,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:10:11.36,0:10:13.53,Default,,0,0,0,,Не істеп жатырсың! Бұл не? Эй!
Dialogue: 0,0:10:13.61,0:10:15.61,Default,,0,0,0,,Агнестахён.
Dialogue: 0,0:10:15.69,0:10:17.53,Default,,0,0,0,,Джунгли багетасы
Dialogue: 0,0:10:18.78,0:10:19.95,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:10:20.03,0:10:21.99,Default,,0,0,0,,Ал мен Джунгли қалтасымын!
Dialogue: 0,0:10:22.08,0:10:23.95,Default,,0,0,0,,Әзіл
Dialogue: 0,0:10:24.58,0:10:29.12,Default,,0,0,0,,Екеуміз бүгін қолымыздан келгеннің бәрін жасайық, Джунгли Қалта-кун.
Dialogue: 0,0:10:37.22,0:10:40.01,Default,,0,0,0,,Болды, Покке-сан!
Dialogue: 0,0:10:40.09,0:10:42.10,Default,,0,0,0,,Бұл Поккенің жарыс формасы ма?
Dialogue: 0,0:10:42.18,0:10:43.76,Default,,0,0,0,,Жалықпаңыз!
Dialogue: 0,0:10:43.85,0:10:47.18,Default,,0,0,0,,Мен GI жарысына қатысатыныма сене алар емеспін.
Dialogue: 0,0:10:47.73,0:10:50.73,Default,,0,0,0,,Ах, Фудзидің әпкесі, жаттықтырушы-сан.
Dialogue: 0,0:10:50.81,0:10:52.27,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:10:52.36,0:10:53.27,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:10:53.36,0:10:56.82,Default,,0,0,0,,Ах! Бұл... Танабе жаттықтырушы ма?
Dialogue: 0,0:10:56.90,0:10:58.90,Default,,0,0,0,,Сонда сіз шынымен қайтып келдіңіз бе?
Dialogue: 0,0:10:58.99,0:11:00.45,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:11:00.53,0:11:03.45,Default,,0,0,0,,Тіпті сізді қызықтырған жылқы қыз да көрінді ме?
Dialogue: 0,0:11:03.53,0:11:06.95,Default,,0,0,0,,Немесе бұл өкініш шығар...
Dialogue: 0,0:11:07.04,0:11:09.66,Default,,0,0,0,,Қандай болса да, бұл рахат.
Dialogue: 0,0:11:14.04,0:11:16.67,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:11:16.76,0:11:18.92,Default,,0,0,0,,Жақтауды толтыру біркелкі орындалады
Dialogue: 0,0:11:19.01,0:11:20.68,Default,,0,0,0,,Үміттенетін ставкалар
Dialogue: 0,0:11:20.76,0:11:25.06,Default,,0,0,0,,Келесі жылғы Classic Triple Crown жарысының болашағын анықтайтын жарыс
Dialogue: 0,0:11:25.14,0:11:30.31,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:11:32.23,0:11:34.11,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:11:35.23,0:11:37.82,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:11:37.90,0:11:39.57,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:11:39.65,0:11:41.57,Default,,0,0,0,,Әрбір Uma Musume қақпасы аяқталды
Dialogue: 0,0:11:41.66,0:11:44.07,Default,,0,0,0,,Бәріміз бірге жасайық...
Dialogue: 0,0:11:44.16,0:11:45.70,Default,,0,0,0,,Үміттенетін ставкалар
Dialogue: 0,0:11:45.78,0:11:47.41,Default,,0,0,0,,Бітті!
Dialogue: 0,0:11:48.04,0:11:49.75,Default,,0,0,0,,Бұл бастама
Dialogue: 0,0:11:51.08,0:11:54.75,Default,,0,0,0,,Барлық Uma Musume бірге басталады және бірінші бұрышқа барады.
Dialogue: 0,0:11:54.84,0:11:57.50,Default,,0,0,0,,Бір-бірімізден позицияларымызды сұраймыз...
Dialogue: 0,0:11:57.59,0:12:00.42,Default,,0,0,0,,Лабриа стероидтары бастама көтерген сияқты
Dialogue: 0,0:12:05.80,0:12:09.22,Default,,0,0,0,,Жүр! Қалта-сан!
Dialogue: 0,0:12:09.31,0:12:12.23,Default,,0,0,0,,Енді Perry Steam жоғары қарай жылжиды.
Dialogue: 0,0:12:12.31,0:12:14.52,Default,,0,0,0,,Артқы жағында джунгли қалтасы бекітілген.
Dialogue: 0,0:12:14.60,0:12:16.98,Default,,0,0,0,,Ең танымалды белгілегіңіз келе ме?
Dialogue: 0,0:12:17.07,0:12:18.11,Default,,0,0,0,,Жақсы орналасу
Dialogue: 0,0:12:18.19,0:12:19.90,Default,,0,0,0,,Күшіңізді осында сақтаңыз
Dialogue: 0,0:12:19.99,0:12:21.95,Default,,0,0,0,,Соңында секіреді
Dialogue: 0,0:12:22.03,0:12:25.03,Default,,0,0,0,,Мен саған соңғы аяғымды көрсетемін!
Dialogue: 0,0:12:26.07,0:12:29.12,Default,,0,0,0,,Бұл жақсы қарқын. Поке де жайбарақат жүгіріп келеді.
Dialogue: 0,0:12:29.20,0:12:31.25,Default,,0,0,0,,Бұл Набе-санның басшылығының нәтижесі.
Dialogue: 0,0:12:31.33,0:12:33.58,Default,,0,0,0,,Бұл GI жарысы
Dialogue: 0,0:12:34.62,0:12:37.13,Default,,0,0,0,,Әр адамның деңгейі жоғары екені рас.
Dialogue: 0,0:12:37.21,0:12:39.00,Default,,0,0,0,,Менің айналамдағы қысым да керемет.
Dialogue: 0,0:12:40.26,0:12:42.22,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:42.30,0:12:44.13,Default,,0,0,0,,Мен ең күштімін!
Dialogue: 0,0:12:44.22,0:12:46.76,Default,,0,0,0,,Labria Steroids бір жарым ұзындықты сақтайды
Dialogue: 0,0:12:46.85,0:12:48.14,Default,,0,0,0,,800 кесінді
Dialogue: 0,0:12:48.22,0:12:51.52,Default,,0,0,0,,Үшінші бұрышқа кіру Енді Labria Steroids First
Dialogue: 0,0:12:51.60,0:12:54.14,Default,,0,0,0,,Дегенмен, қарқын одан әрі жоғарылайды.
Dialogue: 0,0:12:54.23,0:12:56.40,Default,,0,0,0,,Кел, Перри Стим, алға.
Dialogue: 0,0:12:57.31,0:12:59.40,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:13:00.44,0:13:02.61,Default,,0,0,0,,Осыны айтайын...
Dialogue: 0,0:13:04.49,0:13:06.28,Default,,0,0,0,,Жақсы! кемелдік!
Dialogue: 0,0:13:06.36,0:13:07.03,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:13:19.38,0:13:20.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:20.13,0:13:20.92,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:13:21.00,0:13:24.93,Default,,0,0,0,,Агнестахён сырттан! Агнес Тахён көш бастап тұр.
Dialogue: 0,0:13:25.01,0:13:27.93,Default,,0,0,0,,Агнестахён жартылай қорғаудан алдыңғы шепке тез көтерілді!
Dialogue: 0,0:13:28.01,0:13:29.18,Default,,0,0,0,,Мияу!
Dialogue: 0,0:13:29.26,0:13:31.93,Default,,0,0,0,,Берілме, Покке! Сіз оңай жеңіске жетесіз!
Dialogue: 0,0:13:32.02,0:13:33.27,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:13:33.35,0:13:36.14,Default,,0,0,0,,Артымнан ергендер, бірақ...
Dialogue: 0,0:13:39.19,0:13:40.48,Default,,0,0,0,,Күшті Күшті!
Dialogue: 0,0:13:40.57,0:13:42.36,Default,,0,0,0,,Агнестахён Бірінші!
Dialogue: 0,0:13:42.44,0:13:44.86,Default,,0,0,0,,Джунгли қалтасы Перри Стимді қуып келеді және қашады, бірақ
Dialogue: 0,0:13:44.95,0:13:46.28,Default,,0,0,0,,Агнестахён Бірінші!
Dialogue: 0,0:13:46.36,0:13:48.37,Default,,0,0,0,,Джунгли қалтасы 2 орын!
Dialogue: 0,0:13:48.45,0:13:49.45,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:13:49.53,0:13:51.24,Default,,0,0,0,,Агнестахён жеңіл жеңіс
Dialogue: 0,0:13:51.33,0:13:53.66,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:13:53.75,0:13:57.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:57.58,0:13:59.13,Default,,0,0,0,,Уақыт...
Dialogue: 0,0:13:59.21,0:14:02.17,Default,,0,0,0,,Қандай 2 минут 0 секунд 8!
Dialogue: 0,0:14:02.25,0:14:05.59,Default,,0,0,0,,Кіші сынып үшін сену қиын, ыңғайлы қарқынмен рекордтық жүгіру!
Dialogue: 0,0:14:05.67,0:14:08.80,Default,,0,0,0,,Агнестахён Бұл оңай жеңіс болды!
Dialogue: 0,0:14:12.72,0:14:15.77,Default,,0,0,0,,Мен жеңілсем де, Джунгли қалтасында 2-орынға келдім.
Dialogue: 0,0:14:15.85,0:14:17.52,Default,,0,0,0,,3-орын Перри командасы да
Dialogue: 0,0:14:17.60,0:14:20.56,Default,,0,0,0,,Екеуі де әдеттегі рекордтардан асып түседі!
Dialogue: 0,0:14:20.65,0:14:22.61,Default,,0,0,0,,Бұл келесі жылдың классикалық майданы
Dialogue: 0,0:14:22.69,0:14:26.07,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:14:28.49,0:14:30.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:30.45,0:14:32.24,Default,,0,0,0,,Фай о!
Dialogue: 0,0:14:32.33,0:14:33.87,Default,,0,0,0,,Сәбіз! Сәбіз!
Dialogue: 0,0:14:33.95,0:14:38.37,Default,,0,0,0,,Сәбіз! Сәбіз! Сәбіз! Сәбіз...
Dialogue: 0,0:14:38.46,0:14:42.38,Default,,0,0,0,,Сіздің жүгіруіңіздің өзі мүлде жаман болған жоқ.
Dialogue: 0,0:14:42.46,0:14:45.09,Default,,0,0,0,,Бар күшіңізді пайдаланыңыз
Dialogue: 0,0:14:45.17,0:14:47.97,Default,,0,0,0,,Оның үстіне одан Тахён асып түсті.
Dialogue: 0,0:14:48.05,0:14:50.76,Default,,0,0,0,,Сондай бір жаман адам болған.
Dialogue: 0,0:14:50.84,0:14:53.35,Default,,0,0,0,,Сонымен қатар, сол жеңiс жеңiс
Dialogue: 0,0:14:53.43,0:14:56.73,Default,,0,0,0,,Мүмкін ол әлі байсалды емес шығар.
Dialogue: 0,0:14:56.81,0:14:59.77,Default,,0,0,0,,Уф... ол сенің орташа жылқы қызың емес.
Dialogue: 0,0:14:59.85,0:15:01.48,Default,,0,0,0,,Келесі жылы классикалық майдан болады
Dialogue: 0,0:15:01.56,0:15:03.48,Default,,0,0,0,,Тахён шоуды ұрламақшы.
Dialogue: 0,0:15:03.57,0:15:05.69,Default,,0,0,0,,Не? Тек оны мақтаңыз!
Dialogue: 0,0:15:05.78,0:15:07.40,Default,,0,0,0,,Набе-сан, сен менің жаттықтырушымсың!?
Dialogue: 0,0:15:07.49,0:15:09.78,Default,,0,0,0,,Қытырлақ емес.
Dialogue: 0,0:15:12.28,0:15:14.70,Default,,0,0,0,,Бұл жеңілісті келесі жолы қалай тиімді пайдалануға болады деген сұрақ туындайды.
Dialogue: 0,0:15:14.78,0:15:17.20,Default,,0,0,0,,Бұл болашақтың кілті деп ойлаймын.
Dialogue: 0,0:15:19.96,0:15:22.33,Default,,0,0,0,,Фудзи мырза жеңілген жоқ, солай ма?
Dialogue: 0,0:15:23.34,0:15:27.13,Default,,0,0,0,,Мен кейінірек жалғастырамын деп ойладым...
Dialogue: 0,0:15:31.01,0:15:33.22,Default,,0,0,0,,Арима мемориалы басталды
Dialogue: 0,0:15:33.30,0:15:35.22,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:15:35.31,0:15:37.02,Default,,0,0,0,,Арима мемориалы…
Dialogue: 0,0:15:37.10,0:15:39.35,Default,,0,0,0,,Күшті адамдар жиналатын жер!?
Dialogue: 0,0:15:39.43,0:15:41.27,Default,,0,0,0,,Хмм, жанкүйерлердің қолдауымен.
Dialogue: 0,0:15:41.35,0:15:44.19,Default,,0,0,0,,Таңдалған атқа мінер қыздардың бәрі бас қосатын жарыс.
Dialogue: 0,0:15:44.27,0:15:46.78,Default,,0,0,0,,…Негізгі назар TM Opera O.
Dialogue: 0,0:15:46.86,0:15:49.44,Default,,0,0,0,,Бұл сіздің көруіңізге зиян тигізеді.
Dialogue: 0,0:15:49.53,0:15:51.24,Default,,0,0,0,,Мені қалдыр, мен сені тыңдамаймын.
Dialogue: 0,0:15:51.32,0:15:54.49,Default,,0,0,0,,Егер сіз осы жерден ұтсаңыз, сіз бір жыл бойы жеңіліссіз қаласыз және қатарынан 8 басты жүлде ұтып аласыз!
Dialogue: 0,0:15:54.57,0:15:56.49,Default,,0,0,0,,Керемет рекорд орнатылады.
Dialogue: 0,0:15:56.58,0:15:58.45,Default,,0,0,0,,Басқа жылқы қыздары да, не болса да
Dialogue: 0,0:15:58.54,0:15:59.95,Default,,0,0,0,,Мен кек алғым келеді.
Dialogue: 0,0:16:00.04,0:16:02.25,Default,,0,0,0,,Қатты оқиғалар күтілуде.
Dialogue: 0,0:16:08.96,0:16:11.22,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:11.30,0:16:14.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:14.80,0:16:17.56,Default,,0,0,0,,Эй кафе, мен сені күттім.
Dialogue: 0,0:16:17.64,0:16:20.39,Default,,0,0,0,,Мен өзімді жақсы сезінбесем де, жүгіремін.
Dialogue: 0,0:16:20.48,0:16:23.23,Default,,0,0,0,,Сіз шаршап, шаршап жүрсіз бе?
Dialogue: 0,0:16:23.31,0:16:25.27,Default,,0,0,0,,Шындық мынада, сіз
Dialogue: 0,0:16:25.36,0:16:27.65,Default,,0,0,0,,Жаңа ғана дайындалған нәрлендіретін тоник сусыны
Dialogue: 0,0:16:27.73,0:16:29.48,Default,,0,0,0,,Бар, бірақ эй!
Dialogue: 0,0:16:29.57,0:16:30.82,Default,,0,0,0,,Қытай медицинасына негізделген
Dialogue: 0,0:16:30.90,0:16:32.61,Default,,0,0,0,,Аюрведиялық теорияны енгізу
Dialogue: 0,0:16:32.70,0:16:34.24,Default,,0,0,0,,Бұршақ, По...
Dialogue: 0,0:16:34.32,0:16:35.78,Default,,0,0,0,,Енді ол менікі
Dialogue: 0,0:16:35.87,0:16:37.62,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:16:37.70,0:16:40.08,Default,,0,0,0,,Арима мемориалы Сіз бізге қосылғыңыз келе ме?
Dialogue: 0,0:16:40.16,0:16:43.12,Default,,0,0,0,,Мен сіздің тамыр соғуыңызды және адреналин секрециясын бақылап отырмын.
Dialogue: 0,0:16:43.21,0:16:44.37,Default,,0,0,0,,Маған оны қарауға рұқсат етсеңіз...
Dialogue: 0,0:16:44.46,0:16:46.96,Default,,0,0,0,,Маған ұнамайды, суық.
Dialogue: 0,0:16:47.04,0:16:49.92,Default,,0,0,0,,Кішкене ынтымақтассаңыз жақсы емес пе?
Dialogue: 0,0:16:50.00,0:16:52.51,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:16:52.59,0:16:56.30,Default,,0,0,0,,Бүгін өзімді сәл жақсы сезіндім.
Dialogue: 0,0:16:56.85,0:16:58.43,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:16:58.51,0:17:01.77,Default,,0,0,0,,Ей, қиялдағы досың осында.
Dialogue: 0,0:17:04.06,0:17:05.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.48,0:17:09.98,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:17:10.07,0:17:13.53,Default,,0,0,0,,Сіз және басқалар соншалықты қатты жүгірдіңіздер...
Dialogue: 0,0:17:13.61,0:17:16.49,Default,,0,0,0,,Маған қызық, балалар, сендерді не жетектейді.
Dialogue: 0,0:17:17.57,0:17:19.62,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:17:19.70,0:17:23.04,Default,,0,0,0,,Мен сол қызды қуып жеткім келеді.
Dialogue: 0,0:17:23.96,0:17:27.63,Default,,0,0,0,,Бұл біздің жылқы қыздарына инстинкт шығар.
Dialogue: 0,0:17:27.71,0:17:30.13,Default,,0,0,0,,Мен жүгірмей тұра алмаймын
Dialogue: 0,0:17:30.21,0:17:32.46,Default,,0,0,0,,Одан тыс нәрсеге құштарлық
Dialogue: 0,0:17:32.55,0:17:35.88,Default,,0,0,0,,Ойлану және ұмтылу
Dialogue: 0,0:17:35.97,0:17:40.01,Default,,0,0,0,,Ума Мусуменің мүмкіндіктері және одан тыс
Dialogue: 0,0:17:40.10,0:17:42.64,Default,,0,0,0,,3-ші бұрыш Still TM Opera О
Dialogue: 0,0:17:42.72,0:17:44.48,Default,,0,0,0,,3-тен 4-ке дейін
Dialogue: 0,0:17:44.56,0:17:46.69,Default,,0,0,0,,Рюгасаки оны сыртынан жабады.
Dialogue: 0,0:17:46.77,0:17:48.02,Default,,0,0,0,,800-ден аз қалды
Dialogue: 0,0:17:48.10,0:17:49.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:49.23,0:17:52.23,Default,,0,0,0,,Егер бұлай болса, сіз алға шыға алмайсыз.
Dialogue: 0,0:17:52.32,0:17:54.61,Default,,0,0,0,,TM Opera O абсолютті чемпион
Dialogue: 0,0:17:54.69,0:17:57.41,Default,,0,0,0,,Мұқият белгілеу тағдыры.
Dialogue: 0,0:17:57.49,0:17:59.74,Default,,0,0,0,,Бәрімізде жеңіске деген ұмтылыс бірдей.
Dialogue: 0,0:17:59.82,0:18:01.16,Default,,0,0,0,,Әсіресе Арима мемориалы...
Dialogue: 0,0:18:01.24,0:18:02.79,Default,,0,0,0,,Өткен жылы қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:18:02.87,0:18:05.46,Default,,0,0,0,,Бұл барлық адамдарға арналған жарыс.
Dialogue: 0,0:18:06.66,0:18:08.71,Default,,0,0,0,,Мен ешқашан жеңіле алмаймын
Dialogue: 0,0:18:08.79,0:18:10.50,Default,,0,0,0,,Кел, төртінші бұрыш жақында!
Dialogue: 0,0:18:10.59,0:18:12.59,Default,,0,0,0,,Нарита жоғарғы жолы сыртынан
Dialogue: 0,0:18:12.67,0:18:13.80,Default,,0,0,0,,Және Муцкадо
Dialogue: 0,0:18:13.88,0:18:16.05,Default,,0,0,0,,Т.М. Опера жасайсыз ба?
Dialogue: 0,0:18:16.13,0:18:19.43,Default,,0,0,0,,Бар болғаны 310 метр қалды!
Dialogue: 0,0:18:23.06,0:18:24.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:25.02,0:18:27.52,Default,,0,0,0,,Сырттан Муцкадо және Нарита Топ жолы
Dialogue: 0,0:18:27.60,0:18:30.44,Default,,0,0,0,,LexenAmerica да жеке шабуыл жасауда.
Dialogue: 0,0:18:30.52,0:18:32.48,Default,,0,0,0,,200-ден аз 200 метрден аз қалды!
Dialogue: 0,0:18:32.57,0:18:34.69,Default,,0,0,0,,Тейем келмейді!? Тейем келмейді!?
Dialogue: 0,0:18:34.78,0:18:37.15,Default,,0,0,0,,Тим келмейді ме? Тейем келмей ме?
Dialogue: 0,0:18:37.24,0:18:39.36,Default,,0,0,0,,Тейім келмей ме?!
Dialogue: 0,0:18:39.45,0:18:40.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:59.68,0:19:01.85,Default,,0,0,0,,Топ келді! TM осында! TM осында! TM осында!
Dialogue: 0,0:19:01.93,0:19:03.93,Default,,0,0,0,,Топ келді! TM осында! TM осында! TM осында!
Dialogue: 0,0:19:04.01,0:19:05.39,Default,,0,0,0,,Топ келді! TM осында!
Dialogue: 0,0:19:05.47,0:19:07.43,Default,,0,0,0,,Сіз қашып кетесіз бе!? Мейшодоту және Тейму!
Dialogue: 0,0:19:07.52,0:19:09.89,Default,,0,0,0,,...
Dialogue: 0,0:19:09.98,0:19:14.23,Default,,0,0,0,,Тимге ұқсайды!
Dialogue: 0,0:19:15.44,0:19:18.57,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:18.65,0:19:20.82,Default,,0,0,0,,Бұл өте қиын жарыс болды.
Dialogue: 0,0:19:20.91,0:19:23.70,Default,,0,0,0,,Сәл өткізіп алған Т.М. Опера О!
Dialogue: 0,0:19:23.78,0:19:26.20,Default,,0,0,0,,Әміршінің еркі! Өзіңізге қуат беріңіз!
Dialogue: 0,0:19:26.29,0:19:29.83,Default,,0,0,0,,Мен оны барлық жылқы қыздарға көрсеттім!
Dialogue: 0,0:19:30.58,0:19:32.08,Default,,0,0,0,,Иә
Dialogue: 0,0:19:34.54,0:19:39.76,Default,,0,0,0,,Бір жыл бойы жеңіліссіз! G1 жоғары сыныптың толық үстемдігі!
Dialogue: 0,0:19:39.84,0:19:43.64,Default,,0,0,0,,Әмірші туралы аңыз Ума Мусуменің тарихында мәңгілік сақталады.
Dialogue: 0,0:19:43.72,0:19:45.35,Default,,0,0,0,,Мен оны аяқтадым.
Dialogue: 0,0:19:45.43,0:19:47.35,Default,,0,0,0,,Барлық қоршауды бұзып өту
Dialogue: 0,0:19:47.43,0:19:50.06,Default,,0,0,0,,Осындай жақын қашықтықтан қалай тырысып, жеңіске жетуге болады?
Dialogue: 0,0:19:50.14,0:19:52.40,Default,,0,0,0,,Мүмкін емес, шынымен таңқаларлық
Dialogue: 0,0:19:52.48,0:19:55.32,Default,,0,0,0,,О, бұл таңқаларлық.
Dialogue: 0,0:19:56.57,0:19:59.44,Default,,0,0,0,,Жаман жігіттерге толы емес пе?
Dialogue: 0,0:19:59.53,0:20:02.28,Default,,0,0,0,,Тахён да, Опера да!
Dialogue: 0,0:20:02.82,0:20:06.03,Default,,0,0,0,,Көңілсіз отыруға уақыт жоқ.
Dialogue: 0,0:20:07.33,0:20:09.50,Default,,0,0,0,,Жасайық, Набе-сан!
Dialogue: 0,0:20:09.58,0:20:11.33,Default,,0,0,0,,Сіз мұны істей алмайсыз!
Dialogue: 0,0:20:11.41,0:20:13.37,Default,,0,0,0,,Мықты адамдар қаншама.
Dialogue: 0,0:20:13.46,0:20:16.25,Default,,0,0,0,,Мен ұтылғым келмейді!
Dialogue: 0,0:20:17.13,0:20:20.97,Default,,0,0,0,,♪~
Dialogue: 0,0:20:37.69,0:20:40.86,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:20:47.08,0:20:48.87,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:20:56.58,0:20:59.13,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:20:59.21,0:21:00.38,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:21:14.23,0:21:16.15,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:21:22.74,0:21:25.91,Default,,0,0,0,,~♪
Dialogue: 0,0:21:25.99,0:21:27.78,Default,,0,0,0,,(Сабақтың соңындағы қоңырау)
Dialogue: 0,0:21:27.87,0:21:29.78,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:29.87,0:21:31.87,Default,,0,0,0,,Қазір жаттығу уақыты!
Dialogue: 0,0:21:31.95,0:21:33.41,Default,,0,0,0,,Сіз жейдеңізді ұмытып қалдыңыз!
Dialogue: 0,0:21:35.92,0:21:36.92,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:38.58,0:21:41.42,Default,,0,0,0,,Поке-чан вокзал алдындағы кафеде
Dialogue: 0,0:21:41.50,0:21:44.92,Default,,0,0,0,,Олар сәбіз очахой дәмді екенін айтты.
Dialogue: 0,0:21:45.01,0:21:48.05,Default,,0,0,0,,Жаттығудан кейін барғыңыз келе ме?
Dialogue: 0,0:21:48.14,0:21:50.35,Default,,0,0,0,,Мен тым көп жедім деп ойлаймын. Эххе...
Dialogue: 0,0:21:50.43,0:21:52.39,Default,,0,0,0,,Wary Dantz - бүгін рұқсат
Dialogue: 0,0:21:52.47,0:21:55.18,Default,,0,0,0,,Мен енді Тахёнмен мақтанатын боламын.
Dialogue: 0,0:21:55.27,0:21:56.06,Default,,0,0,0,,Қалай... қалай?
Dialogue: 0,0:21:56.14,0:21:59.61,Default,,0,0,0,,Бұл соғыс жариялау. Ол жігіт күшті.
Dialogue: 0,0:21:59.69,0:22:01.94,Default,,0,0,0,,Ол өте күшті болғандықтан, оны жең!
Dialogue: 0,0:22:02.03,0:22:04.82,Default,,0,0,0,,Жоқ, бұл тым қуатқа байланысты ма? Яба~
Dialogue: 0,0:22:04.90,0:22:06.07,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:22:06.15,0:22:07.53,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:22:07.61,0:22:09.53,Default,,0,0,0,,Иә!? Эй... сәл күте тұрыңыз!
Dialogue: 0,0:22:09.62,0:22:11.83,Default,,0,0,0,,Итара (Иордания) Ми бұлшықеті Отсу~
Dialogue: 0,0:22:13.54,0:22:16.58,Default,,0,0,0,,Ал, не болып жатыр?
Dialogue: 0,0:22:16.66,0:22:18.92,Default,,0,0,0,,Әзірге бұл тек болжам.
Dialogue: 0,0:22:19.00,0:22:20.08,Default,,0,0,0,,Прогресс тұрақты деп айтуға болады.
Dialogue: 0,0:22:20.08,0:22:21.92,Default,,0,0,0,,Прогресс тұрақты деп айтуға болады.
Dialogue: 0,0:22:20.08,0:22:21.92,Default,,0,0,0,,(Покке мен Данц сөйлеседі)
Dialogue: 0,0:22:21.92,0:22:22.00,Default,,0,0,0,,(Покке мен Данц сөйлеседі)
Dialogue: 0,0:22:22.00,0:22:26.05,Default,,0,0,0,,(Покке мен Данц сөйлеседі)
Dialogue: 0,0:22:22.00,0:22:26.05,Default,,0,0,0,,Дегенмен, тек А жоспарымен әрекет ету әлі де қауіпті.
Dialogue: 0,0:22:26.13,0:22:27.59,Default,,0,0,0,,Тексеру үшін қажетті сынақтардың саны әлі белгісіз...
Dialogue: 0,0:22:27.59,0:22:30.72,Default,,0,0,0,,Тексеру үшін қажетті сынақтардың саны әлі белгісіз...
Dialogue: 0,0:22:27.59,0:22:30.72,Default,,0,0,0,,Тахён бар ма?
Dialogue: 0,0:22:30.80,0:22:34.97,Default,,0,0,0,,Ешбір баламасыз әрекет ету дұрыс па?
Dialogue: 0,0:22:35.06,0:22:36.35,Default,,0,0,0,,Күтілгендей, келесі жүгіріс В жоспарына көшу немесе өтпеу сынағы болады...
Dialogue: 0,0:22:36.35,0:22:38.98,Default,,0,0,0,,Күтілгендей, келесі жүгіріс В жоспарына көшу немесе өтпеу сынағы болады...
Dialogue: 0,0:22:36.35,0:22:38.98,Default,,0,0,0,,Поке-чан, ашуланба
Dialogue: 0,0:22:38.98,0:22:40.23,Default,,0,0,0,,Күтілгендей, келесі жүгіріс В жоспарына көшу немесе өтпеу сынағы болады...
Dialogue: 0,0:22:40.31,0:22:42.98,Default,,0,0,0,,Жеңілмеген ат қыз Тачён-сама
Dialogue: 0,0:22:43.07,0:22:45.44,Default,,0,0,0,,Егер сіз оны әдетте жаттығу кезінде көрмесеңіз
Dialogue: 0,0:22:45.53,0:22:47.86,Default,,0,0,0,,Сіз осындай жерде қамалып отырсыз ба?
Dialogue: 0,0:22:47.95,0:22:50.49,Default,,0,0,0,,Эй... Мазалағаным үшін кешіріңіз. Сіз кафенің тұтынушысысыз.
Dialogue: 0,0:22:50.57,0:22:52.74,Default,,0,0,0,,Мен сіздің тұтынушыңыз сияқтымын.
Dialogue: 0,0:22:53.33,0:22:56.37,Default,,0,0,0,,Ха... Мен қазір бос емеспін.
Dialogue: 0,0:22:56.45,0:22:57.79,Default,,0,0,0,,Сәлем Тахён
Dialogue: 0,0:22:57.87,0:23:01.13,Default,,0,0,0,,Мені бір рет жеңіп алып, ренжімеңіз.
Dialogue: 0,0:23:01.71,0:23:03.75,Default,,0,0,0,,Әй, бұл кім екен деп ойлаймын.
Dialogue: 0,0:23:03.84,0:23:07.09,Default,,0,0,0,,Сен өткен жылдың соңында менен жеңілген Джунгли қалтасысың ба?
Dialogue: 0,0:23:07.17,0:23:08.05,Default,,0,0,0,,Ах!?
Dialogue: 0,0:23:08.13,0:23:10.76,Default,,0,0,0,,Әй, кенет ұрыс сатып алмасаң, мен де сатып аламын!
Dialogue: 0,0:23:10.84,0:23:13.47,Default,,0,0,0,,Алдыңғы жарыста көбіне түсінбейтін нәрселерді айтып отырдым.
Dialogue: 0,0:23:13.55,0:23:15.22,Default,,0,0,0,,Ол кенет жабысқақ болып қалды.
Dialogue: 0,0:23:15.31,0:23:17.48,Default,,0,0,0,,Сен мені дәл сол кезде ұмыттың!
Dialogue: 0,0:23:17.56,0:23:18.98,Default,,0,0,0,,Біз бір сыныпта оқимыз!
Dialogue: 0,0:23:19.06,0:23:20.23,Default,,0,0,0,,Ум!
Dialogue: 0,0:23:20.31,0:23:21.81,Default,,0,0,0,,Қарсы болмасаңыз
Dialogue: 0,0:23:21.90,0:23:24.19,Default,,0,0,0,,Ах... Рахмет, Кафе-сан.
Dialogue: 0,0:23:24.27,0:23:25.73,Default,,0,0,0,,Маған қара! Пайдасы бар болса
Dialogue: 0,0:23:25.82,0:23:27.24,Default,,0,0,0,,Қысқаша айтыңыз.
Dialogue: 0,0:23:27.32,0:23:29.36,Default,,0,0,0,,Мен қазір бос емеспін.
Dialogue: 0,0:23:38.66,0:23:41.25,Default,,0,0,0,,Мен сені міндетті түрде жеңемін
Dialogue: 0,0:23:42.42,0:23:45.59,Default,,0,0,0,,Ең мықты болудың алғашқы қадамы ретінде
Dialogue: 0,0:23:46.59,0:23:50.09,Default,,0,0,0,,Сен мықтысың, ал мен одан да күштімін.
Dialogue: 0,0:23:50.97,0:23:55.05,Default,,0,0,0,,Мен ешқашан сол кездегідей жеңілмеймін.
Dialogue: 0,0:23:57.14,0:23:59.02,Default,,0,0,0,,Бұл ойын, Тахён!
Dialogue: 0,0:23:59.68,0:24:02.60,Default,,0,0,0,,Кім күшті, мен бе, сен бе?
Dialogue: 0,0:24:02.69,0:24:05.61,Default,,0,0,0,,Классикалық ақ-қара түске көшейік!
Dialogue: 0,0:24:16.83,0:24:19.41,Default,,0,0,0,,Хэхе... Хахаха...
Dialogue: 0,0:24:19.50,0:24:22.17,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:24:22.25,0:24:24.54,Default,,0,0,0,,Егер сіз кенеттен бір нәрсе туралы ойлап қалсаңыз
Dialogue: 0,0:24:24.63,0:24:27.38,Default,,0,0,0,,Маған қарсы жеңесің бе? Сіз?
Dialogue: 0,0:24:27.46,0:24:30.80,Default,,0,0,0,,Хахахаха! Көремін, көремін.
Dialogue: 0,0:24:30.88,0:24:32.84,Default,,0,0,0,,Не болды? Бұл маңызды ...
Dialogue: 0,0:24:32.93,0:24:34.84,Default,,0,0,0,,Сіздің шақыруыңыз
Dialogue: 0,0:24:34.93,0:24:36.39,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:24:36.47,0:24:38.18,Default,,0,0,0,,Мен саған бұның физика шекарасынан тыс екенін айттым ғой?
Dialogue: 0,0:24:39.60,0:24:41.85,Default,,0,0,0,,Тексеру мүмкіндіктері мен теңіз шошқаларының саны
Dialogue: 0,0:24:41.93,0:24:44.19,Default,,0,0,0,,Көбірек болса жақсы
Dialogue: 0,0:24:45.56,0:24:47.52,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:24:47.61,0:24:51.28,Default,,0,0,0,,Қуып жету үшін бар күшіңізді салыңыз.
Dialogue: 0,0:24:51.82,0:24:53.32,Default,,0,0,0,,Сол сөз
Dialogue: 0,0:24:53.91,0:24:57.07,Default,,0,0,0,,Мен оны толығымен сізге қайтарамын.
Dialogue: 0,0:24:58.41,0:25:00.08,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:25:00.16,0:25:01.91,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:25:04.00,0:25:05.71,Default,,0,0,0,,Хаха...
Dialogue: 0,0:25:06.33,0:25:08.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:25:09.17,0:25:10.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:25:10.17,0:25:11.84,Default,,0,0,0,,Қатар жүгіру!
Dialogue: 0,0:25:11.92,0:25:14.38,Default,,0,0,0,,Эксперимент!
Dialogue: 0,0:25:14.47,0:25:17.22,Default,,0,0,0,,Жүр, қалауыңша жүгір.
Dialogue: 0,0:25:17.30,0:25:19.06,Default,,0,0,0,,Неге сен де жүгірмейсің?
Dialogue: 0,0:25:19.14,0:25:21.97,Default,,0,0,0,,Мен оны бақылай алатын болсам, бұл жақсы.
Dialogue: 0,0:25:22.06,0:25:24.14,Default,,0,0,0,,Аяғыңызды босқа өткізгеннен гөрі
Dialogue: 0,0:25:24.23,0:25:26.31,Default,,0,0,0,,Сіздің деректеріңізге басымдық беріледі.
Dialogue: 0,0:25:26.40,0:25:27.98,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:25:28.61,0:25:29.61,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:25:29.69,0:25:31.78,Default,,0,0,0,,Мұны өз Dantz кафесінде жасайық
Dialogue: 0,0:25:31.86,0:25:34.03,Default,,0,0,0,,Неге тіпті біз... Ахаха...
Dialogue: 0,0:25:34.11,0:25:35.74,Default,,0,0,0,,О! Дұрыс
Dialogue: 0,0:25:35.82,0:25:39.49,Default,,0,0,0,,Жоғары жүктеме! Келіңіздер!
Dialogue: 0,0:25:39.58,0:25:42.29,Default,,0,0,0,,Менімен біраз уақыт бірге болыңыз.
Dialogue: 0,0:25:42.37,0:25:43.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:46.71,0:25:48.50,Default,,0,0,0,,Уау! (Үлкен жүктеме) Иә!
Dialogue: 0,0:25:48.58,0:25:50.25,Default,,0,0,0,,Қарқынды жоғарылатыңыз
Dialogue: 0,0:25:50.34,0:25:52.38,Default,,0,0,0,,Өзіңіздің күшті жақтарыңызды жетілдіріңіз
Dialogue: 0,0:25:52.46,0:25:55.76,Default,,0,0,0,,Жоғары жүктеме! Арима мемориалындағы көріністерді пайдаланыңыз
Dialogue: 0,0:25:55.84,0:25:57.26,Default,,0,0,0,,Жақсы күйдегі жолақты табыңыз
Dialogue: 0,0:25:57.34,0:25:59.85,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:25:59.93,0:26:02.39,Default,,0,0,0,,Мен жажажа аттым үшін кешірім сұраймын.
Dialogue: 0,0:26:02.47,0:26:04.73,Default,,0,0,0,,Тасымалдаушы жоғарғы жағында орналасқан үстіңгі жүктен
Dialogue: 0,0:26:04.81,0:26:06.48,Default,,0,0,0,,Бәсекелестік жоқ
Dialogue: 0,0:26:06.56,0:26:09.31,Default,,0,0,0,,Жоқ, мен Танабе-санның шәкіртімін.
Dialogue: 0,0:26:09.40,0:26:10.52,Default,,0,0,0,,Маған үйренуге рұқсат етіңіз
Dialogue: 0,0:26:10.61,0:26:12.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:12.15,0:26:16.28,Default,,0,0,0,,Ах... Дебюттен кейін бір жыл өткен соң, мен бұл акселерацияға жеттім.
Dialogue: 0,0:26:16.36,0:26:19.32,Default,,0,0,0,,Twinkle сериясының аға мүшесі ретінде мен де
Dialogue: 0,0:26:19.41,0:26:21.16,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын!
Dialogue: 0,0:26:21.24,0:26:22.49,Default,,0,0,0,,О!
Dialogue: 0,0:26:22.58,0:26:25.29,Default,,0,0,0,,Керемет, келісемін! Мен оны білдім!
Dialogue: 0,0:26:25.37,0:26:28.12,Default,,0,0,0,,Мықты жігіттермен жүгірме!
Dialogue: 0,0:26:28.21,0:26:30.75,Default,,0,0,0,,Поке-чан, сол жоғарғы жүктеу-чанмен
Dialogue: 0,0:26:30.84,0:26:31.79,Default,,0,0,0,,Бір-бірін кесіп өту
Dialogue: 0,0:26:31.88,0:26:33.05,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:26:33.13,0:26:35.63,Default,,0,0,0,,Жоғары жолды жалғастырайық!
Dialogue: 0,0:26:35.72,0:26:36.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:36.51,0:26:38.43,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:26:38.51,0:26:42.64,Default,,0,0,0,,Жүгірудегі басқалармен бәсекелесу нәтижесіндегі өзгерістер
Dialogue: 0,0:26:42.72,0:26:43.93,Default,,0,0,0,,Қызықты
Dialogue: 0,0:26:45.10,0:26:48.06,Default,,0,0,0,,Иә, біз әлі де осындамыз.
Dialogue: 0,0:26:49.77,0:26:51.19,Default,,0,0,0,,Менің ең мықтысым!
Dialogue: 0,0:26:51.27,0:26:53.90,Default,,0,0,0,,Джунгли қалтасы 1!
Dialogue: 0,0:26:53.98,0:26:58.57,Default,,0,0,0,,Мен Kyodo News кубогын керемет түзу сызықпен жеңіп алдым!
Dialogue: 0,0:26:58.65,0:27:00.70,Default,,0,0,0,,Керемет!
Dialogue: 0,0:27:00.78,0:27:02.62,Default,,0,0,0,,Мен мұны тек тахиондар деп ойладым.
Dialogue: 0,0:27:02.70,0:27:06.50,Default,,0,0,0,,Биылғы классикалық майдан өте жоғары деңгейде болады.
Dialogue: 0,0:27:06.58,0:27:09.21,Default,,0,0,0,,Көрдіңіз бе? Күте тұрыңыз, Тахён.
Dialogue: 0,0:27:09.29,0:27:11.38,Default,,0,0,0,,Мен Сатсуки сыйлығымен мәселені шешемін!
Dialogue: 0,0:27:12.34,0:27:14.21,Default,,0,0,0,,(Айзава) Бірінші жекпе-жек бойынша ой елегінен өткізуге арналған негізгі тармақтарды айтыңыз
Dialogue: 0,0:27:14.96,0:27:16.63,Default,,0,0,0,,Бұл – иллюзия сиқыры.
Dialogue: 0,0:27:16.71,0:27:20.89,Default,,0,0,0,,Kyodo News Cup турниріндегі бұл жүгіріс шынымен де керемет болды!
Dialogue: 0,0:27:20.97,0:27:24.31,Default,,0,0,0,,Тәжірибе ұзаққа созылатын сияқты.
Dialogue: 0,0:27:25.47,0:27:28.56,Default,,0,0,0,,Жақында Yayoi жүлдесі келеді.
Dialogue: 0,0:27:28.64,0:27:30.85,Default,,0,0,0,,Бұл мен сенімен бірінші рет жарысқа қатысуым.
Dialogue: 0,0:27:30.94,0:27:31.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:31.73,0:27:34.44,Default,,0,0,0,,Сіздің «досыңызды» қуып жүгіру
Dialogue: 0,0:27:34.52,0:27:37.94,Default,,0,0,0,,Маған қандай деректерді бере аласыз?
Dialogue: 0,0:27:38.74,0:27:41.24,Default,,0,0,0,,Мен де соны асыға күтемін.
Dialogue: 0,0:27:41.32,0:27:44.08,Default,,0,0,0,,(кафедегі жөтел)
Dialogue: 0,0:27:44.16,0:27:46.87,Default,,0,0,0,,(Найзағайдың күркіреуі)
Dialogue: 0,0:27:46.95,0:27:50.87,Default,,0,0,0,,Мен сені міндетті түрде қуып жетемін
Dialogue: 0,0:27:52.38,0:27:55.75,Default,,0,0,0,,Ешкімнің алдыңыздан шығуына жол бермеңіз
Dialogue: 0,0:27:57.13,0:27:59.42,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:28:00.22,0:28:03.64,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:28:03.72,0:28:07.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:28:10.39,0:28:12.27,Default,,0,0,0,,Биылғы Yayoi сыйлығы басталды
Dialogue: 0,0:28:12.35,0:28:14.31,Default,,0,0,0,,Алдында жауған жаңбырдан ауа райының қолайсыздығына қарамастан
Dialogue: 0,0:28:14.40,0:28:16.32,Default,,0,0,0,,Қарқыны біршама жылдам
Dialogue: 0,0:28:16.40,0:28:18.28,Default,,0,0,0,,Бәйгені жұлып алған — Когма Кларис
Dialogue: 0,0:28:18.36,0:28:19.57,Default,,0,0,0,,Умарена Гарано екінші
Dialogue: 0,0:28:19.65,0:28:22.36,Default,,0,0,0,,Агнестахён осыдан кейін мұқият жүреді.
Dialogue: 0,0:28:22.45,0:28:24.20,Default,,0,0,0,,Жүр, мен бір қарап көрейін.
Dialogue: 0,0:28:24.28,0:28:25.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:28:25.78,0:28:28.66,Default,,0,0,0,,Жарыс тігінен таралады.
Dialogue: 0,0:28:28.74,0:28:31.04,Default,,0,0,0,,Жол бастап келе жатқан екі атты қыздың артында қалдым.
Dialogue: 0,0:28:31.12,0:28:32.79,Default,,0,0,0,,Ең танымал Агнестахён
Dialogue: 0,0:28:32.87,0:28:35.71,Default,,0,0,0,,Оны қашан орнату керек?
Dialogue: 0,0:28:35.79,0:28:39.30,Default,,0,0,0,,Ума Мусуменің жүгіруі, оның мүмкіндіктері
Dialogue: 0,0:28:40.30,0:28:45.76,Default,,0,0,0,,Біз Ума Мусуме, әлі түсіндірілмеген құпиялар мен ғажайыптарға толы жаратылыстармыз.
Dialogue: 0,0:28:45.85,0:28:48.47,Default,,0,0,0,,Аяқ күші 70км/сағ дейін жетеді
Dialogue: 0,0:28:48.56,0:28:51.18,Default,,0,0,0,,Жүгіруді қолдайтын жүрек-өкпе қызметі
Dialogue: 0,0:28:51.27,0:28:53.44,Default,,0,0,0,,Күшті бұлшықеттер
Dialogue: 0,0:28:54.35,0:28:58.40,Default,,0,0,0,,Расында да жүгіру үшін туған
Dialogue: 0,0:28:59.32,0:29:00.73,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:29:00.82,0:29:04.24,Default,,0,0,0,,Ума Мусуменің аяғында жатқан мүмкіндіктердің соңы немен аяқталады?
Dialogue: 0,0:29:04.78,0:29:08.16,Default,,0,0,0,,Бұл дененің шекті жылдамдығы қандай?
Dialogue: 0,0:29:08.24,0:29:09.99,Default,,0,0,0,,Бұдан басқа не бар!?
Dialogue: 0,0:29:10.08,0:29:12.25,Default,,0,0,0,,Агнестахён, оны осында орнатамыз ба?
Dialogue: 0,0:29:12.33,0:29:15.25,Default,,0,0,0,,Жарыс оның демонстрациялық эксперименті ретінде
Dialogue: 0,0:29:15.33,0:29:17.75,Default,,0,0,0,,Шектерден тыс
Dialogue: 0,0:29:17.84,0:29:21.51,Default,,0,0,0,,Өз аяғымды барынша жылтырату
Dialogue: 0,0:29:21.59,0:29:22.84,Default,,0,0,0,,Қол жеткізіңіз!
Dialogue: 0,0:29:22.92,0:29:25.09,Default,,0,0,0,,Агнестахён алға шықты!
Dialogue: 0,0:29:25.18,0:29:26.89,Default,,0,0,0,,Түзу сызықты енгізіп, жылдамдықты арттырыңыз
Dialogue: 0,0:29:26.97,0:29:30.14,Default,,0,0,0,,Біз келесілерді үлкен маржамен артта қалдырамыз!
Dialogue: 0,0:29:30.97,0:29:32.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:41.15,0:29:42.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:29:43.65,0:29:45.57,Default,,0,0,0,,Иә
Dialogue: 0,0:29:45.65,0:29:48.12,Default,,0,0,0,,Эй, эй, бұл басым емес пе, Тахён?
Dialogue: 0,0:29:48.20,0:29:49.58,Default,,0,0,0,,Бұл ең күшті.
Dialogue: 0,0:29:49.66,0:29:51.95,Default,,0,0,0,,Керемет... Тахён
Dialogue: 0,0:29:52.87,0:29:53.91,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:29:54.00,0:29:56.50,Default,,0,0,0,,Мен қаншалықты алыс жүре аламын!?
Dialogue: 0,0:29:56.58,0:29:58.38,Default,,0,0,0,,Алда не күтіп тұр!?
Dialogue: 0,0:29:58.46,0:30:01.21,Default,,0,0,0,,Мүмкіндіктің соңы
Dialogue: 0,0:30:01.30,0:30:03.13,Default,,0,0,0,,Одан арғы көрініс...!
Dialogue: 0,0:30:20.48,0:30:22.82,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:30:25.61,0:30:26.82,Default,,0,0,0,,Агнестахён!
Dialogue: 0,0:30:26.90,0:30:29.37,Default,,0,0,0,,Агнестахён Бұл жолы да оңай жеңіс!
Dialogue: 0,0:30:29.45,0:30:32.95,Default,,0,0,0,,Ол өзінің ізбасарларына толығымен тосқауыл қою арқылы өзінің керемет күшін көрсетті!
Dialogue: 0,0:30:33.04,0:30:35.91,Default,,0,0,0,,Тахён күткендей, биыл ол Тахён болуға шешім қабылдады.
Dialogue: 0,0:30:36.00,0:30:38.21,Default,,0,0,0,,Классикалық үштік тәжді міндетті түрде ұтып алыңыз!
Dialogue: 0,0:30:38.29,0:30:40.96,Default,,0,0,0,,Triple Crown Uma Musume де ауқымда!
Dialogue: 0,0:30:41.04,0:30:45.84,Default,,0,0,0,,Келесі айдағы Сатсуки сыйлығына үлкен үміт артылады!
Dialogue: 0,0:30:45.92,0:30:47.13,Default,,0,0,0,,Ол осылай болуы керек
Dialogue: 0,0:30:47.22,0:30:49.72,Default,,0,0,0,,Сіз оны жеңе алмайсыз!
Dialogue: 0,0:30:50.39,0:30:51.55,Default,,0,0,0,,Тахён!
Dialogue: 0,0:30:51.64,0:30:54.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:31:05.28,0:31:08.20,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:31:08.28,0:31:10.99,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:31:14.91,0:31:18.54,Default,,0,0,0,,Хаха...
Dialogue: 0,0:31:21.17,0:31:22.96,Default,,0,0,0,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,0:31:24.38,0:31:26.42,Default,,0,0,0,,Олар қыздар ма?
Dialogue: 0,0:31:29.01,0:31:30.93,Default,,0,0,0,,Бұл да жақсы
Dialogue: 0,0:31:42.44,0:31:44.23,Default,,0,0,0,,Хаха...
Dialogue: 0,0:31:44.32,0:31:47.28,Default,,0,0,0,,Күте тұрыңыз, Покке-сан.
Dialogue: 0,0:31:47.36,0:31:49.70,Default,,0,0,0,,Мен әлдеқайда алдамын!
Dialogue: 0,0:31:49.78,0:31:51.32,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:31:51.41,0:31:52.99,Default,,0,0,0,,Менің ойымша, ол қайтадан жылдамырақ болды.
Dialogue: 0,0:31:53.07,0:31:55.91,Default,,0,0,0,,Ах, бұл Тахён болар еді...
Dialogue: 0,0:31:55.99,0:31:57.83,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:31:57.91,0:32:01.08,Default,,0,0,0,,Бұл керемет жүгіру, Тахён
Dialogue: 0,0:32:01.17,0:32:04.34,Default,,0,0,0,,Оны күйдіретін де осы!
Dialogue: 0,0:32:04.42,0:32:07.38,Default,,0,0,0,,Уау...!
Dialogue: 0,0:32:07.46,0:32:08.84,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалта
Dialogue: 0,0:32:08.92,0:32:11.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:32:11.72,0:32:13.30,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:32:13.39,0:32:16.01,Default,,0,0,0,,Жүгіру әлі өрескел, бірақ
Dialogue: 0,0:32:16.10,0:32:18.93,Default,,0,0,0,,Сол соңғы аяқтар табиғи.
Dialogue: 0,0:32:19.02,0:32:23.06,Default,,0,0,0,,Тахён сияқты күшті синхронизация болғаны бақытты болуы мүмкін.
Dialogue: 0,0:32:23.81,0:32:25.61,Default,,0,0,0,,Өйткені менің бәсекеге қабілетті рухым күшті
Dialogue: 0,0:32:25.69,0:32:29.32,Default,,0,0,0,,Қарсыластың болуы маған жауынгерлік рух береді
Dialogue: 0,0:32:29.40,0:32:34.45,Default,,0,0,0,,Сатсуки жүлдесі Егер біз бәсекелестік пен күшейе берсек...
Dialogue: 0,0:32:36.66,0:32:39.45,Default,,0,0,0,,Сіз оны әкелген кезде
Dialogue: 0,0:32:39.54,0:32:42.46,Default,,0,0,0,,Мен қазір не ойладым?
Dialogue: 0,0:32:42.54,0:32:45.21,Default,,0,0,0,,Көп жылдар сахнадан алыстаған қыранға
Dialogue: 0,0:32:45.29,0:32:48.34,Default,,0,0,0,,Тағы да жаңа қызметкерлерді оқытудың құпиясы...
Dialogue: 0,0:32:48.42,0:32:51.67,Default,,0,0,0,,Кешіріңіз, бірақ мен үшін
Dialogue: 0,0:32:52.88,0:32:56.22,Default,,0,0,0,,Мен Набе-саннан жақсы жаттықтырушы таба алмадым.
Dialogue: 0,0:32:56.30,0:32:59.35,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:32:59.43,0:33:01.98,Default,,0,0,0,,Мен сенімен бітемін...
Dialogue: 0,0:33:06.56,0:33:08.90,Default,,0,0,0,,Поке-чан керемет~
Dialogue: 0,0:33:08.98,0:33:11.15,Default,,0,0,0,,Бұл логикалық емес, бұл жай ғана тәжірибенің көлемі.
Dialogue: 0,0:33:11.24,0:33:12.86,Default,,0,0,0,,Иә, ыдыс сынған.
Dialogue: 0,0:33:12.95,0:33:16.91,Default,,0,0,0,,Бұл таңқаларлық. Сіз рекорд жеңіп алдыңыз.
Dialogue: 0,0:33:16.99,0:33:19.99,Default,,0,0,0,,Kyodo News Cup да өте күшті...
Dialogue: 0,0:33:20.62,0:33:22.50,Default,,0,0,0,,Бұл өте керемет...
Dialogue: 0,0:33:23.96,0:33:26.92,Default,,0,0,0,,Эй, мен бүгін тағы жүгірдім.
Dialogue: 0,0:33:27.00,0:33:29.25,Default,,0,0,0,,Қазір өзіңізді әлдеқайда жақсы сезінесіз.
Dialogue: 0,0:33:29.34,0:33:31.67,Default,,0,0,0,,Мен Тахёнға жеңіле алмаймын!
Dialogue: 0,0:33:31.76,0:33:35.01,Default,,0,0,0,,Мен міндетті түрде Сацуки жүлдесін жеңіп алып, ең мықты боламын.
Dialogue: 0,0:33:35.09,0:33:37.34,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:33:39.60,0:33:42.14,Default,,0,0,0,,Бұл менің эгоым ғана.
Dialogue: 0,0:33:44.27,0:33:46.15,Default,,0,0,0,,Набе-сан қалтаңда
Dialogue: 0,0:33:46.23,0:33:48.52,Default,,0,0,0,,Мені жапондық дербиге апарғаныңызды қалаймын.
Dialogue: 0,0:33:49.69,0:33:51.94,Default,,0,0,0,,Себебі мен мұны істей алмадым
Dialogue: 0,0:33:52.86,0:33:56.03,Default,,0,0,0,,Дарбидің арманы бар.
Dialogue: 0,0:33:56.11,0:33:58.37,Default,,0,0,0,,Тіпті Ума Мусуме үшін
Dialogue: 0,0:33:59.74,0:34:01.66,Default,,0,0,0,,Жаттықтырушылар үшін де
Dialogue: 0,0:34:02.79,0:34:05.62,Default,,0,0,0,,Дербиде жеңіске жету шын мәнінде
Dialogue: 0,0:34:05.71,0:34:08.25,Default,,0,0,0,,Өйткені бұл ең жоғары құрмет
Dialogue: 0,0:34:08.75,0:34:10.67,Default,,0,0,0,,Яйои сыйлығынан кейін
Dialogue: 0,0:34:10.75,0:34:15.55,Default,,0,0,0,,Соңында жарысты жалғастыра алмадым
Dialogue: 0,0:34:15.63,0:34:20.47,Default,,0,0,0,,Көп үміт күтсе де, мен Набе-санды таңдадым.
Dialogue: 0,0:34:20.55,0:34:23.93,Default,,0,0,0,,Мен сені дерби жаттықтырушысы ете алмадым.
Dialogue: 0,0:34:24.02,0:34:27.48,Default,,0,0,0,,Бірақ егер бұл сіз болсаңыз, мен сенімдімін
Dialogue: 0,0:34:31.11,0:34:32.19,Default,,0,0,0,,Қалта
Dialogue: 0,0:34:33.40,0:34:37.53,Default,,0,0,0,,Біздің тілектерімізді орындайсың ба?
Dialogue: 0,0:34:39.87,0:34:42.08,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:34:42.16,0:34:44.20,Default,,0,0,0,,Мен міндетті түрде ең мықты боламын
Dialogue: 0,0:34:44.29,0:34:48.33,Default,,0,0,0,,Біз Фудзи-сан мен Набе-санның армандарын орындаймыз!
Dialogue: 0,0:34:49.17,0:34:51.59,Default,,0,0,0,,Сондықтан бұл ойын, Тахён!
Dialogue: 0,0:34:51.67,0:34:53.96,Default,,0,0,0,,Мен сізге бұл жолы жеңіске жетуге рұқсат етемін.
Dialogue: 0,0:34:54.05,0:34:57.51,Default,,0,0,0,,Тек бүгін ғана емес! Дерби және Кикука Шо
Dialogue: 0,0:34:57.59,0:34:59.84,Default,,0,0,0,,Сонда да мен жеңемін!
Dialogue: 0,0:34:59.93,0:35:02.35,Default,,0,0,0,,Өйткені, мен ең күштімін!
Dialogue: 0,0:35:03.51,0:35:04.85,Default,,0,0,0,,«Тахён»
Dialogue: 0,0:35:04.93,0:35:07.35,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:35:04.93,0:35:07.35,Default,,0,0,0,,Әрқашан жарық жылдамдығынан жылдамырақ жүреді дейді.
Dialogue: 0,0:35:07.35,0:35:08.23,Default,,0,0,0,,Әрқашан жарық жылдамдығынан жылдамырақ жүреді дейді.
Dialogue: 0,0:35:08.31,0:35:10.48,Default,,0,0,0,,Виртуалды бөлшектер
Dialogue: 0,0:35:11.06,0:35:14.90,Default,,0,0,0,,Гипотетикалық болса да көрсету керек.
Dialogue: 0,0:35:16.28,0:35:19.86,Default,,0,0,0,,Ақылсыздықтан пайда болған кейінгі сәуле
Dialogue: 0,0:35:22.62,0:35:25.16,Default,,0,0,0,,Биылғы маусым тағы да келді.
Dialogue: 0,0:35:25.24,0:35:28.12,Default,,0,0,0,,Жас жылқы қыздарға өмірде бір рет болатын сынақ
Dialogue: 0,0:35:28.21,0:35:32.00,Default,,0,0,0,,Классикалық үштік тәж осы Сатсуки шосынан басталады.
Dialogue: 0,0:35:32.71,0:35:36.63,Default,,0,0,0,,Ямамото мырзаның түсініктемесі Бұл жолы назар аударатын акциялар туралы айтатын болсақ...
Dialogue: 0,0:35:36.71,0:35:39.22,Default,,0,0,0,,Иә, Агнестахёнсыз осы маусым.
Dialogue: 0,0:35:39.30,0:35:40.68,Default,,0,0,0,,Сіз айта алмайсыз
Dialogue: 0,0:35:40.76,0:35:42.22,Default,,0,0,0,,Дебюттен бері қатарынан 3 жеңіс
Dialogue: 0,0:35:42.30,0:35:45.10,Default,,0,0,0,,Олардың барлығы сізге күшті күш беретін жүгірулер.
Dialogue: 0,0:35:45.18,0:35:46.60,Default,,0,0,0,,Сөзсіз ең танымал
Dialogue: 0,0:35:46.68,0:35:50.10,Default,,0,0,0,,Көктем мезгілі өкінішті
Dialogue: 0,0:35:50.19,0:35:53.36,Default,,0,0,0,,Менің физикалық жағдайым баяу қалпына келеді.
Dialogue: 0,0:35:53.44,0:35:56.65,Default,,0,0,0,,Мен күзге қарай жақсы формада боламын.
Dialogue: 0,0:35:56.73,0:35:59.44,Default,,0,0,0,,Сіз табиғи түрде ұзақ қашықтыққа жарамды сияқтысыз.
Dialogue: 0,0:35:59.53,0:36:04.07,Default,,0,0,0,,Кикука-шоға қайтып келген дұрыс болар.
Dialogue: 0,0:36:04.16,0:36:05.99,Default,,0,0,0,,Биылғы классикалық үштік тәж
Dialogue: 0,0:36:06.08,0:36:07.95,Default,,0,0,0,,Тахён шешіп қойған сияқты.
Dialogue: 0,0:36:08.04,0:36:09.45,Default,,0,0,0,,Тіпті алдыңғы жарыстар
Dialogue: 0,0:36:09.54,0:36:11.83,Default,,0,0,0,,Мен әлі де өзімді мүлде байсалды сезінбеймін.
Dialogue: 0,0:36:11.92,0:36:14.08,Default,,0,0,0,,Мен оның қаншалықты алыс болатынын асыға күтемін.
Dialogue: 0,0:36:14.17,0:36:16.71,Default,,0,0,0,,Тахёнмен бір ұрпақтың басқа балалары
Dialogue: 0,0:36:16.80,0:36:18.84,Default,,0,0,0,,Менің жолым болмады деп ойлаймын.
Dialogue: 0,0:36:18.92,0:36:22.84,Default,,0,0,0,,Тачён Тачён... Жігіттер осымен айналысып жүрсіңдер ме?
Dialogue: 0,0:36:22.93,0:36:24.39,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:36:24.47,0:36:27.01,Default,,0,0,0,,Поке-сан міндетті түрде кек алады!
Dialogue: 0,0:36:27.10,0:36:29.68,Default,,0,0,0,,А, аа! Басталып жатыр!
Dialogue: 0,0:36:29.77,0:36:33.85,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:36:42.45,0:36:44.62,Default,,0,0,0,,Жүйрік болмасаң, төбелесе алмайсың
Dialogue: 0,0:36:44.70,0:36:47.12,Default,,0,0,0,,Мықты болмасаң, оны жеңе алмайсың.
Dialogue: 0,0:36:47.20,0:36:49.79,Default,,0,0,0,,Ал мен бұл қатты қуануға жауап беруім керек.
Dialogue: 0,0:36:49.87,0:36:51.87,Default,,0,0,0,,Сіз жеңіске лайықсыз!
Dialogue: 0,0:36:51.96,0:36:54.37,Default,,0,0,0,,Батыр болу шартына сай келетін Ума Мусуме
Dialogue: 0,0:36:54.46,0:36:56.38,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:36:56.46,0:36:59.38,Default,,0,0,0,,Шаа! Қараңдаршы балалар
Dialogue: 0,0:36:59.46,0:37:02.63,Default,,0,0,0,,Мен бәрінен күштімін!
Dialogue: 0,0:37:02.72,0:37:03.88,Default,,0,0,0,,Қалта…
Dialogue: 0,0:37:03.97,0:37:06.39,Default,,0,0,0,,Тым көп күш
Dialogue: 0,0:37:07.05,0:37:09.18,Default,,0,0,0,,Аңыздың басы
Dialogue: 0,0:37:09.26,0:37:11.93,Default,,0,0,0,,Бір секундты жіберіп алмаңыз!
Dialogue: 0,0:37:12.02,0:37:13.14,Default,,0,0,0,,Сатсуки сыйлығы
Dialogue: 0,0:37:13.23,0:37:15.15,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:37:15.23,0:37:16.90,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,0:37:16.98,0:37:18.65,Default,,0,0,0,,Қақпа ашылды
Dialogue: 0,0:37:18.73,0:37:19.98,Default,,0,0,0,,Ах! (Тікелей эфир) Ой
Dialogue: 0,0:37:20.07,0:37:21.28,Default,,0,0,0,,Ең ішкі жақтаудағы Джунгли қалтасы
Dialogue: 0,0:37:21.36,0:37:23.20,Default,,0,0,0,,Жұмысты бастауда қиындықтар болды ма?
Dialogue: 0,0:37:23.28,0:37:25.61,Default,,0,0,0,,Артқа Бұл кеш басталды.
Dialogue: 0,0:37:25.70,0:37:27.03,Default,,0,0,0,,Курсты айналадағы адамдар бұғаттауға бейім
Dialogue: 0,0:37:27.12,0:37:29.99,Default,,0,0,0,,Бұл ішкі бастауға қосымша кеш бастауға байланысты.
Dialogue: 0,0:37:30.08,0:37:32.96,Default,,0,0,0,,Бұл орналасуға үлкен әсер еткен сияқты.
Dialogue: 0,0:37:33.04,0:37:34.83,Default,,0,0,0,,Менің сәл шыдамым таусылды.
Dialogue: 0,0:37:34.92,0:37:36.83,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз кері әсер етті ме?
Dialogue: 0,0:37:36.92,0:37:38.79,Default,,0,0,0,,Үлкен сахнада тым алысқа барма.
Dialogue: 0,0:37:38.88,0:37:41.42,Default,,0,0,0,,Алда келе жатқан Доссад қарқынын алға тартып, 2 ұпайға алға шықты
Dialogue: 0,0:37:41.51,0:37:43.38,Default,,0,0,0,,Одан кейін Utage Record Light Grace
Dialogue: 0,0:37:43.47,0:37:45.22,Default,,0,0,0,,Каракас Гаймен 3-орын үшін шайқас
Dialogue: 0,0:37:45.30,0:37:48.60,Default,,0,0,0,,Оның артында, сәл алыста, алға қарап, Агнестахён.
Dialogue: 0,0:37:48.68,0:37:50.39,Default,,0,0,0,,Басына дейін шамамен 6 дана
Dialogue: 0,0:37:50.47,0:37:52.85,Default,,0,0,0,,Және Данц жақтауының сыртқы жағындағы джунгли қалтасы
Dialogue: 0,0:37:52.93,0:37:53.64,Default,,0,0,0,,Бұл позиция бастапқыда артта қалғаннан кейін
Dialogue: 0,0:37:53.64,0:37:54.69,Default,,0,0,0,,Бастапқыда артта қалғаннан кейін бұл позиция
Dialogue: 0,0:37:53.64,0:37:54.69,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:37:54.77,0:37:56.81,Default,,0,0,0,,Бар болғаны 2000 метрге жүгіру
Dialogue: 0,0:37:56.90,0:37:59.27,Default,,0,0,0,,Бұл кідіріс ауырады...
Dialogue: 0,0:37:59.36,0:38:02.07,Default,,0,0,0,,Уайымдама, аяғың міндетті түрде...!
Dialogue: 0,0:38:02.65,0:38:04.07,Default,,0,0,0,,Жүгіруден кейін 1000 метрден өту
Dialogue: 0,0:38:04.15,0:38:07.24,Default,,0,0,0,,59 секунд 8 60 секундтан аз
Dialogue: 0,0:38:07.32,0:38:09.07,Default,,0,0,0,,Бұл өте жылдам қарқын.
Dialogue: 0,0:38:09.16,0:38:12.08,Default,,0,0,0,,Мен бастапқыда төзімділікті тұтынуға да алаңдаймын.
Dialogue: 0,0:38:12.79,0:38:15.33,Default,,0,0,0,,Алдыңғы жігіттер қатал көрінеді.
Dialogue: 0,0:38:15.41,0:38:17.08,Default,,0,0,0,,Сен ондай доп емессің.
Dialogue: 0,0:38:18.54,0:38:19.58,Default,,0,0,0,,Сен білмейсің ғой, иә? Бұл ел өте кең, білесің бе.
Dialogue: 0,0:38:24.17,0:38:25.59,Default,,0,0,0,,Міне! (Еркек) Тахён!
Dialogue: 0,0:38:25.67,0:38:26.68,Default,,0,0,0,,Қап
Dialogue: 0,0:38:26.76,0:38:28.84,Default,,0,0,0,,Агнестахён баяу қозғала бастады.
Dialogue: 0,0:38:28.93,0:38:30.05,Default,,0,0,0,,Ал сырттан Джунгли қалтасы!
Dialogue: 0,0:38:30.14,0:38:31.18,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:38:33.22,0:38:36.10,Default,,0,0,0,,Джунгли қалтасы Саңылауды біртіндеп жабу
Dialogue: 0,0:38:36.18,0:38:38.60,Default,,0,0,0,,Мен бұл кеш бастаудан осыншама алысқа жетемін деп ойламадым.
Dialogue: 0,0:38:38.69,0:38:40.77,Default,,0,0,0,,Бұл сіздің шынайы әлеуетіңізді сезінуге мүмкіндік беретін жүгіру.
Dialogue: 0,0:38:40.86,0:38:41.86,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:38:45.69,0:38:49.45,Default,,0,0,0,,600 белгісінің 3-ші бұрыш қисығынан өту
Dialogue: 0,0:38:51.20,0:38:53.54,Default,,0,0,0,,Міне! Осы жерден, қалтадан
Dialogue: 0,0:38:53.62,0:38:55.45,Default,,0,0,0,,Тахёнға арқаңызды көрсетіңіз!
Dialogue: 0,0:38:55.54,0:38:56.75,Default,,0,0,0,,3 4 бұрыш қисығынан
Dialogue: 0,0:38:56.83,0:38:59.21,Default,,0,0,0,,Төмендегілер де жоғары көтеріліп, топ құрайды.
Dialogue: 0,0:38:59.29,0:39:01.67,Default,,0,0,0,,Ал қазірдің өзінде сырттан, бірінші Utage рекорды?
Dialogue: 0,0:39:01.75,0:39:04.09,Default,,0,0,0,,Бірақ Агнестахён оның соңынан ішке кіреді.
Dialogue: 0,0:39:04.17,0:39:06.09,Default,,0,0,0,,Сонымен қатар, Jungle Pocket жылдам қуып жетуде!
Dialogue: 0,0:39:06.17,0:39:07.34,Default,,0,0,0,,Тахён!
Dialogue: 0,0:39:07.42,0:39:09.01,Default,,0,0,0,,Қазір, Джунгли мен Агнесте.
Dialogue: 0,0:39:09.09,0:39:10.64,Default,,0,0,0,,Бұл жеке жекпе-жек болады ма?
Dialogue: 0,0:39:10.72,0:39:14.18,Default,,0,0,0,,Ақырында біз тура бағытқа бара жатырмыз!
Dialogue: 0,0:39:18.31,0:39:20.10,Default,,0,0,0,,Оны тура ойынға әкелді
Dialogue: 0,0:39:20.19,0:39:24.11,Default,,0,0,0,,Покке соңғы аяғына байланысты 300 метр ғана...
Dialogue: 0,0:39:24.19,0:39:26.36,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:39:26.44,0:39:28.07,Default,,0,0,0,,Агнестахён сыртқа бұрылды
Dialogue: 0,0:39:28.15,0:39:29.36,Default,,0,0,0,,Агнестахён Бірінші!
Dialogue: 0,0:39:29.45,0:39:31.91,Default,,0,0,0,,Джунгли қалтасы да осында! Джунгли қалтасы да осында!
Dialogue: 0,0:39:31.99,0:39:33.62,Default,,0,0,0,,Біз сонымен қатар Данц кадрын қайтарамыз!
Dialogue: 0,0:39:33.70,0:39:35.24,Default,,0,0,0,,200 метрге жуық
Dialogue: 0,0:39:35.33,0:39:39.75,Default,,0,0,0,,Сацукидің тәжін қай атты қыз тартып алады?
Dialogue: 0,0:39:40.33,0:39:41.25,Default,,0,0,0,,Поке!
Dialogue: 0,0:39:41.33,0:39:42.88,Default,,0,0,0,,Қалта!
Dialogue: 0,0:39:46.05,0:39:48.63,Default,,0,0,0,,Уау...!
Dialogue: 0,0:39:48.72,0:39:52.59,Default,,0,0,0,,Уау...!
Dialogue: 0,0:39:53.35,0:39:57.06,Default,,0,0,0,,Менің жүгіргенімді бақылаңыз
Dialogue: 0,0:39:58.27,0:40:01.94,Default,,0,0,0,,Артқы жарқырауды жағыңыз
Dialogue: 0,0:40:07.53,0:40:08.69,Default,,0,0,0,,​​О?
Dialogue: 0,0:40:08.78,0:40:11.07,Default,,0,0,0,,Өртенген мәйіттен
Dialogue: 0,0:40:18.50,0:40:21.16,Default,,0,0,0,,Жаңа мүмкіндіктер
Dialogue: 0,0:40:22.00,0:40:23.54,Default,,0,0,0,,Ояну
Dialogue: 0,0:40:25.13,0:40:27.92,Default,,0,0,0,,Соңғы еңісте Агнес алда!
Dialogue: 0,0:40:28.00,0:40:29.80,Default,,0,0,0,,Бірінші Агнес!
Dialogue: 0,0:40:29.88,0:40:34.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:40:45.73,0:40:47.27,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:40:47.36,0:40:49.03,Default,,0,0,0,,Джунгли қалтасын шағып алды!
Dialogue: 0,0:40:49.11,0:40:50.44,Default,,0,0,0,,Dantz Frame де келеді!
Dialogue: 0,0:40:50.53,0:40:52.99,Default,,0,0,0,,Бірақ Агнестахён мүлде қашып кетті!
Dialogue: 0,0:40:53.07,0:40:54.11,Default,,0,0,0,,Бұл шешім қабылданды ма!?
Dialogue: 0,0:40:54.20,0:40:56.32,Default,,0,0,0,,Жеңіл талант одан сайын өседі
Dialogue: 0,0:40:56.41,0:40:58.41,Default,,0,0,0,,Агнестахён!
Dialogue: 0,0:40:59.04,0:41:01.00,Default,,0,0,0,,Керемет!
Dialogue: 0,0:41:01.08,0:41:02.71,Default,,0,0,0,,Бұл Тахён ғой!
Dialogue: 0,0:41:02.79,0:41:04.83,Default,,0,0,0,,Ең күштісі - Тахён!
Dialogue: 0,0:41:04.92,0:41:07.84,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:41:09.25,0:41:11.26,Default,,0,0,0,,Оны ұрыңыз
Dialogue: 0,0:41:11.34,0:41:13.88,Default,,0,0,0,,Ең күшті бол
Dialogue: 0,0:41:13.97,0:41:15.84,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:41:17.64,0:41:19.26,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:41:20.93,0:41:23.73,Default,,0,0,0,,Бұл Агнес Бұл Агнес Бұл Агнес Бұл Агнес
Dialogue: 0,0:41:20.93,0:41:23.73,Default,,0,0,0,,Чикишо!
Dialogue: 0,0:41:23.81,0:41:25.77,Default,,0,0,0,,Бұл Агнес Бұл Агнес Бұл Агнес Бұл Агнес!
Dialogue: 0,0:41:25.85,0:41:28.73,Default,,0,0,0,,Бұл Агнес!
Dialogue: 0,0:41:29.48,0:41:30.48,Default,,0,0,0,,Тахён!
Dialogue: 0,0:41:30.57,0:41:32.90,Default,,0,0,0,,Агнес Агнес Жарайды~!
Dialogue: 0,0:41:32.99,0:41:35.86,Default,,0,0,0,,беделіне қарамастан 1 орын!
Dialogue: 0,0:41:35.95,0:41:41.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:41:43.21,0:41:46.50,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:41:47.29,0:41:51.09,Default,,0,0,0,,Накаяма 2000 метр Алдымен жолды қостық
Dialogue: 0,0:41:51.17,0:41:53.26,Default,,0,0,0,,Жеңіс уақыты 2 минут 0,3 секунд!
Dialogue: 0,0:41:53.34,0:41:55.93,Default,,0,0,0,,Агнестахён Бірінші жеңіс!
Dialogue: 0,0:41:58.85,0:42:02.89,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:42:08.98,0:42:13.69,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:42:16.24,0:42:17.95,Default,,0,0,0,,Қызықты
Dialogue: 0,0:42:18.03,0:42:19.62,Default,,0,0,0,,Қызықты
Dialogue: 0,0:42:19.70,0:42:22.16,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:42:24.54,0:42:25.79,Default,,0,0,0,,Тахён!
Dialogue: 0,0:42:28.96,0:42:31.13,Default,,0,0,0,,Атуға үлгермей тұрып байқап қалды.
Dialogue: 0,0:42:31.21,0:42:33.05,Default,,0,0,0,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:42:33.13,0:42:36.38,Default,,0,0,0,,Сен шектен шыққан бейбақсың.
Dialogue: 0,0:42:36.47,0:42:40.43,Default,,0,0,0,,Бірақ бұл Дерби.
Dialogue: 0,0:42:40.51,0:42:44.02,Default,,0,0,0,,Жапония дербиі сізді жеңеді
Dialogue: 0,0:42:44.10,0:42:46.23,Default,,0,0,0,,Әр жылқышы қыздың арманы
Dialogue: 0,0:42:46.31,0:42:49.23,Default,,0,0,0,,Сол үлкен сахнада, бұл жолы
Dialogue: 0,0:42:49.31,0:42:51.23,Default,,0,0,0,,Сізге қарсы жеңіңіз
Dialogue: 0,0:42:51.31,0:42:53.61,Default,,0,0,0,,Мен оны міндетті түрде дәлелдеймін
Dialogue: 0,0:42:53.69,0:42:56.61,Default,,0,0,0,,Мен ең күштімін
Dialogue: 0,0:43:05.08,0:43:06.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:11.08,0:43:12.63,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:43:13.50,0:43:15.67,Default,,0,0,0,,Істерді орындаңыз
Dialogue: 0,0:43:16.42,0:43:17.63,Default,,0,0,0,,Тахён?
Dialogue: 0,0:43:18.63,0:43:21.14,Default,,0,0,0,,Жою
Dialogue: 0,0:43:23.51,0:43:26.89,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:43:29.39,0:43:31.31,Default,,0,0,0,,Себебін айтыңызшы.
Dialogue: 0,0:43:31.40,0:43:33.57,Default,,0,0,0,,Бір жерде ауыр жарақат бар ма?
Dialogue: 0,0:43:34.15,0:43:35.82,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:43:37.36,0:43:39.57,Default,,0,0,0,,Әртүрлі себептер бар.
Dialogue: 0,0:43:39.65,0:43:42.32,Default,,0,0,0,,Шындық әрқашан күрделі
Dialogue: 0,0:43:42.41,0:43:45.83,Default,,0,0,0,,Бұл іс жүзінде зейнеткерлікке шығу туралы декларация ма?
Dialogue: 0,0:43:45.91,0:43:48.96,Default,,0,0,0,,Менен мұны сұраудың қажеті жоқ.
Dialogue: 0,0:43:49.04,0:43:50.54,Default,,0,0,0,,Қандай нақты болашақ?
Dialogue: 0,0:43:50.62,0:43:54.13,Default,,0,0,0,,Өйткені ешкім білмейді
Dialogue: 0,0:43:55.50,0:43:57.71,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:43:57.80,0:44:01.55,Default,,0,0,0,,Жаңа айтқанымдай, бүгінгі күні мен
Dialogue: 0,0:44:01.63,0:44:03.76,Default,,0,0,0,,Агнестахён бұл
Dialogue: 0,0:44:03.85,0:44:08.35,Default,,0,0,0,,Жарысқа қатысу белгісіз мерзімге тоқтатылады.
Dialogue: 0,0:44:13.65,0:44:14.94,Default,,0,0,0,,Ха...
Dialogue: 0,0:44:15.02,0:44:16.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:18.44,0:44:20.11,Default,,0,0,0,,Бұл хабарландыру үшін.
Dialogue: 0,0:44:20.20,0:44:21.49,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:44:21.57,0:44:24.57,Default,,0,0,0,,Тачён мырза, маған тағы біраз айтып беріңізші...
Dialogue: 0,0:44:26.03,0:44:31.21,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:44:32.71,0:44:33.71,Default,,0,0,0,,Әй!
Dialogue: 0,0:44:33.79,0:44:35.21,Default,,0,0,0,,Тахён!
Dialogue: 0,0:44:45.68,0:44:47.22,Default,,0,0,0,,Менен бірдеңе керек пе?
Dialogue: 0,0:44:48.26,0:44:51.23,Default,,0,0,0,,Мен шай қайнатып алайын ба деп ойладым.
Dialogue: 0,0:44:51.31,0:44:52.39,Default,,0,0,0,,Сіз бізге қосылғыңыз келе ме?
Dialogue: 0,0:44:52.48,0:44:54.65,Default,,0,0,0,,Кейбір шамалы жанама әсерлер бар.
Dialogue: 0,0:44:54.73,0:44:56.31,Default,,0,0,0,,Орексин секрециясына ықпал етеді
Dialogue: 0,0:44:56.40,0:44:59.65,Default,,0,0,0,,Ояу күйді күшпен сақтай алатын тамаша элемент.
Dialogue: 0,0:44:59.73,0:45:03.53,Default,,0,0,0,,Та... Тачён-чан, одан да көп...
Dialogue: 0,0:45:04.32,0:45:06.28,Default,,0,0,0,,Жарақат алғаны сонша, жүре алмай қалды.
Dialogue: 0,0:45:06.37,0:45:07.99,Default,,0,0,0,,Менің ойымша, бұл себеп емес.
Dialogue: 0,0:45:08.58,0:45:12.12,Default,,0,0,0,,Содан кейін жарысқа тезірек оралуға болады.
Dialogue: 0,0:45:12.21,0:45:13.87,Default,,0,0,0,,Мұны мен де баспасөз мәслихатында айттым.
Dialogue: 0,0:45:13.96,0:45:16.67,Default,,0,0,0,,Менің жарысқа қайта оралу ойым жоқ.
Dialogue: 0,0:45:16.75,0:45:20.76,Default,,0,0,0,,Мен енді жүгіргенімнен еш пайда жоқ деп шештім.
Dialogue: 0,0:45:20.84,0:45:22.76,Default,,0,0,0,,Өйткені уақыт шектеулі.
Dialogue: 0,0:45:22.84,0:45:25.51,Default,,0,0,0,,Пайдасыз нәрселерге босқа кететін уақыт жоқ.
Dialogue: 0,0:45:26.93,0:45:29.18,Default,,0,0,0,,Бұл пайдасыз ба?
Dialogue: 0,0:45:29.93,0:45:32.77,Default,,0,0,0,,Жағымсыз әзілдерді доғар.
Dialogue: 0,0:45:32.85,0:45:34.60,Default,,0,0,0,,Әлі алыс, солай емес пе?
Dialogue: 0,0:45:34.69,0:45:37.77,Default,,0,0,0,,Жақында Дерби, Кикука Шо және одан тыс жерде...
Dialogue: 0,0:45:37.86,0:45:41.86,Default,,0,0,0,,Мен көбірек пайдалы эксперименттерге назар аударғым келеді.
Dialogue: 0,0:45:42.57,0:45:45.66,Default,,0,0,0,,Мен әлі сенімен біргемін...
Dialogue: 0,0:45:47.12,0:45:51.08,Default,,0,0,0,,Иә... Енді осы ғана керек пе?
Dialogue: 0,0:45:51.16,0:45:52.83,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:45:52.91,0:45:57.92,Default,,0,0,0,,Балалар, әлі де жаттығумен айналыспайсыңдар ма?
Dialogue: 0,0:45:59.13,0:46:00.46,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:46:00.55,0:46:03.13,Default,,0,0,0,,Мен өте байсалдымын.
Dialogue: 0,0:46:03.21,0:46:05.26,Default,,0,0,0,,Біріншіден, жарыстың нәтижесі қандай?
Dialogue: 0,0:46:05.34,0:46:07.55,Default,,0,0,0,,Маған маңызды емес
Dialogue: 0,0:46:07.64,0:46:10.60,Default,,0,0,0,,Мен саған айтпадым ба!? Сіз менің шақыруымды қабылдайсыз!
Dialogue: 0,0:46:10.68,0:46:11.43,Default,,0,0,0,,Поке-чан!
Dialogue: 0,0:46:11.51,0:46:14.27,Default,,0,0,0,,Сіз жеңу үшін жарыспайсыз ба?
Dialogue: 0,0:46:14.35,0:46:15.94,Default,,0,0,0,,Сен мұнда не үшін келдің? Эй!
Dialogue: 0,0:46:16.69,0:46:19.31,Default,,0,0,0,,Мен сенің жеңістен қашуыңа ешқашан жол бермеймін!
Dialogue: 0,0:46:19.40,0:46:22.32,Default,,0,0,0,,Кім күшті, мен бе, сен бе?
Dialogue: 0,0:46:22.40,0:46:25.57,Default,,0,0,0,,Түсіндіруіңіз керек емес пе еді?
Dialogue: 0,0:46:26.86,0:46:30.49,Default,,0,0,0,,Бұл мәселені Сатцуки сыйлығымен шешу керек еді.
Dialogue: 0,0:46:31.24,0:46:35.41,Default,,0,0,0,,Сол күні менің жүгіргенімді көрдіңіз
Dialogue: 0,0:46:35.50,0:46:36.41,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:46:41.63,0:46:43.34,Default,,0,0,0,,Бұл Агнес! Бұл Агнес!
Dialogue: 0,0:46:43.42,0:46:45.05,Default,,0,0,0,,Мен жете алмаймын!
Dialogue: 0,0:46:46.67,0:46:48.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:57.64,0:46:58.52,Default,,0,0,0,,Қарғыс атсын... Поке-чан!
Dialogue: 0,0:46:58.60,0:47:00.86,Default,,0,0,0,,Сіздің болашақ жүгіруіңізге арналған
Dialogue: 0,0:47:00.94,0:47:03.57,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:47:03.65,0:47:05.94,Default,,0,0,0,,Қалай болса да сол аяқтарды жылтыратыңыз
Dialogue: 0,0:47:06.03,0:47:08.99,Default,,0,0,0,,Маған көбірек мүмкіндіктер көрсетіңізші.
Dialogue: 0,0:47:09.07,0:47:13.37,Default,,0,0,0,,Қажет болса, мен өз білімім мен дағдыларымды беруге қуаныштымын.
Dialogue: 0,0:47:13.45,0:47:16.87,Default,,0,0,0,,Мен сізге кеңесші бола аламын!
Dialogue: 0,0:47:16.96,0:47:18.67,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:47:19.46,0:47:22.96,Default,,0,0,0,,Ол соншалықты жылдам жүгірсе де
Dialogue: 0,0:47:23.04,0:47:26.51,Default,,0,0,0,,Сізде керемет талант бар!
Dialogue: 0,0:47:28.55,0:47:31.01,Default,,0,0,0,,Сіз кеткен болсаңыз да
Dialogue: 0,0:47:31.09,0:47:33.97,Default,,0,0,0,,Өйткені біз жүгіруді жалғастырамыз
Dialogue: 0,0:47:40.23,0:47:44.32,Default,,0,0,0,,Yayoi жүлдесінде сіз дерлік қалдыңыз.
Dialogue: 0,0:47:44.40,0:47:47.24,Default,,0,0,0,,Мен оның «сол қызды» қуып келе жатқанын көрдім.
Dialogue: 0,0:47:47.32,0:47:48.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:47:49.07,0:47:51.36,Default,,0,0,0,,Мен ештеңе көре алмадым
Dialogue: 0,0:47:53.41,0:47:55.74,Default,,0,0,0,,Мен қуып жетемін
Dialogue: 0,0:47:55.83,0:47:57.20,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:48:06.05,0:48:07.76,Default,,0,0,0,,О
Dialogue: 0,0:48:08.97,0:48:12.59,Default,,0,0,0,,Жарайсыңдар, балалар.
Dialogue: 0,0:48:14.89,0:48:18.47,Default,,0,0,0,,…
Dialogue: 0,0:48:27.57,0:48:28.86,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:48:28.94,0:48:30.61,Default,,0,0,0,,Мен сені аңсадым.
Dialogue: 0,0:48:30.70,0:48:32.11,Default,,0,0,0,,Тачён мырза!
Dialogue: 0,0:48:32.20,0:48:35.62,Default,,0,0,0,,Мен бұған сене алар емеспін. Неге...
Dialogue: 0,0:48:35.70,0:48:36.49,Default,,0,0,0,,Уа!
Dialogue: 0,0:48:37.66,0:48:39.37,Default,,0,0,0,,Бұл Дерби!
Dialogue: 0,0:48:39.45,0:48:40.91,Default,,0,0,0,,Бір апта қалды
Dialogue: 0,0:48:41.00,0:48:44.58,Default,,0,0,0,,Ума Мусумеге қатысы бар барлық адамдар үшін ең жоғары құрмет
Dialogue: 0,0:48:44.67,0:48:46.09,Default,,0,0,0,,Жапония дербиі!
Dialogue: 0,0:48:46.17,0:48:47.96,Default,,0,0,0,,Биыл не болса да
Dialogue: 0,0:48:48.05,0:48:50.30,Default,,0,0,0,,Агнестахён белгісіз үзіліс жариялайды.
Dialogue: 0,0:48:50.38,0:48:52.22,Default,,0,0,0,,Бұл өте өкінішті болды.
Dialogue: 0,0:48:52.30,0:48:53.55,Default,,0,0,0,,Эй
Dialogue: 0,0:48:53.64,0:48:57.26,Default,,0,0,0,,Қатысушыларға әсері де өте үлкен болды.
Dialogue: 0,0:48:57.35,0:48:58.89,Default,,0,0,0,,Егер Дерби де жүгірген болса
Dialogue: 0,0:48:58.97,0:49:01.10,Default,,0,0,0,,Бұл ең танымал болды, солай емес пе?
Dialogue: 0,0:49:01.18,0:49:04.48,Default,,0,0,0,,Жоқ, мен әлі де оның жүгіріп келе жатқанын көргім келді.
Dialogue: 0,0:49:04.56,0:49:07.19,Default,,0,0,0,,Орта жолда кеткен қызға
Dialogue: 0,0:49:07.27,0:49:10.40,Default,,0,0,0,,Жүгіретін атқа мінетін қыздар аман болсын!
Dialogue: 0,0:49:10.49,0:49:12.90,Default,,0,0,0,,Қызу жарыс болады деп сенемін.
Dialogue: 0,0:49:17.83,0:49:19.33,Default,,0,0,0,,Тренинг дегеніміз
Dialogue: 0,0:49:19.41,0:49:22.75,Default,,0,0,0,,Бұл жай ғана уақытты босқа өткізу емес
Dialogue: 0,0:49:22.83,0:49:24.42,Default,,0,0,0,,Сіз классиксіз
Dialogue: 0,0:49:24.50,0:49:27.63,Default,,0,0,0,,Физикалық функциялар әлі де дамып келеді, сондықтан өзіңізді тым қатты итермелесеңіз...
Dialogue: 0,0:49:27.71,0:49:28.63,Default,,0,0,0,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:49:28.71,0:49:30.00,Default,,0,0,0,,Поке! Қандай тітіркендіргіш!
Dialogue: 0,0:49:35.76,0:49:36.80,Default,,0,0,0,,Поке мырза...
Dialogue: 0,0:49:36.89,0:49:38.35,Default,,0,0,0,,Бұл өрескел
Dialogue: 0,0:49:38.43,0:49:41.06,Default,,0,0,0,,Ол Тахён кетіп қалды.
Dialogue: 0,0:49:41.14,0:49:43.85,Default,,0,0,0,,Бірінші рет жеңілген қарсыласым жеңіп, қашып кетуіме мүмкіндік берді.
Dialogue: 0,0:49:43.94,0:49:46.52,Default,,0,0,0,,Білмеймін, не істеуім керек?
Dialogue: 0,0:49:46.60,0:49:48.94,Default,,0,0,0,,Әлемде тахиондар туралы да айтылады.
Dialogue: 0,0:49:49.02,0:49:51.23,Default,,0,0,0,,Покке-санға да, басқа жылқы қыздарына да бәрібір.
Dialogue: 0,0:49:51.32,0:49:52.74,Default,,0,0,0,,Маңызды емес сияқты...
Dialogue: 0,0:49:52.82,0:49:54.86,Default,,0,0,0,,А, мен аздап қысылып жатырмын!
Dialogue: 0,0:49:54.95,0:49:57.49,Default,,0,0,0,,Бұл Поккенің сызығы, солай ма?
Dialogue: 0,0:49:59.41,0:50:02.91,Default,,0,0,0,,Хаха...
Dialogue: 0,0:50:12.71,0:50:14.92,Default,,0,0,0,,Бүгін тұр
Dialogue: 0,0:50:15.01,0:50:17.84,Default,,0,0,0,,Бұл шек шығар.
Dialogue: 0,0:50:18.59,0:50:21.93,Default,,0,0,0,,Тахённың саған не айтқанын білмеймін.
Dialogue: 0,0:50:22.01,0:50:23.60,Default,,0,0,0,,Сол көп атты қыздар
Dialogue: 0,0:50:23.68,0:50:26.56,Default,,0,0,0,,Ол небәрі 4 жарыстан кейін жарыстан шығып қалды.
Dialogue: 0,0:50:26.64,0:50:29.44,Default,,0,0,0,,Ештеңе болуы мүмкін емес еді.
Dialogue: 0,0:50:29.52,0:50:31.48,Default,,0,0,0,,...Не болып жатыр?
Dialogue: 0,0:50:31.57,0:50:34.11,Default,,0,0,0,,Жылқы қыздарында ақаулар жиі кездеседі.
Dialogue: 0,0:50:34.19,0:50:35.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:35.49,0:50:37.53,Default,,0,0,0,,Қаншалықты сақ болсаң да
Dialogue: 0,0:50:37.61,0:50:41.58,Default,,0,0,0,,«Бұған ештеңе жоқ, бәрі тамаша болып жатыр» деп ойласаңыз да.
Dialogue: 0,0:50:41.66,0:50:44.25,Default,,0,0,0,,Бір күні кенеттен келеді.
Dialogue: 0,0:50:46.21,0:50:48.46,Default,,0,0,0,,Ешкім зардап шеккісі келмейді.
Dialogue: 0,0:50:48.54,0:50:50.17,Default,,0,0,0,,Мен қаламаймын
Dialogue: 0,0:50:50.25,0:50:53.67,Default,,0,0,0,,Сонда да әркім өз тағдырымен бетпе-бет келеді
Dialogue: 0,0:50:53.76,0:50:58.18,Default,,0,0,0,,Бізде өз жолымызбен жүгіруді жалғастырудан басқа амал жоқ.
Dialogue: 0,0:51:01.93,0:51:05.64,Default,,0,0,0,,Мен Фуджикисекиге жүгіре алмадым.
Dialogue: 0,0:51:05.73,0:51:07.60,Default,,0,0,0,,жарыстан шықты
Dialogue: 0,0:51:08.31,0:51:11.36,Default,,0,0,0,,Бастапқыда оның ренжіткені.
Dialogue: 0,0:51:11.44,0:51:13.57,Default,,0,0,0,,Мен шыдауым керек еді
Dialogue: 0,0:51:15.86,0:51:17.36,Default,,0,0,0,,Сіз басқасыз.
Dialogue: 0,0:51:17.45,0:51:19.70,Default,,0,0,0,,Тіпті тахиондарсыз
Dialogue: 0,0:51:19.78,0:51:23.37,Default,,0,0,0,,Бірге жарысып, бірін-бірі жетілдіретін бәсекелестерден айырылсақ та
Dialogue: 0,0:51:23.45,0:51:26.87,Default,,0,0,0,,Әлі де шымтезекке баруға тырысуда
Dialogue: 0,0:51:26.95,0:51:29.37,Default,,0,0,0,,Мен сізге ризамын
Dialogue: 0,0:51:29.46,0:51:31.54,Default,,0,0,0,,Рахмет Покке
Dialogue: 0,0:51:31.63,0:51:35.63,Default,,0,0,0,,Бұл қарияға маған тағы да армандауға мүмкіндік бергені үшін рахмет.
Dialogue: 0,0:51:37.05,0:51:38.67,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:51:38.76,0:51:42.60,Default,,0,0,0,,Ешқашан мені бұлай сезінбе.
Dialogue: 0,0:51:47.85,0:51:49.98,Default,,0,0,0,,Кешіріңіз, Набе-сан.
Dialogue: 0,0:51:50.06,0:51:52.15,Default,,0,0,0,,Сіз мұны міндетті түрде жасай аласыз.
Dialogue: 0,0:51:52.23,0:51:54.15,Default,,0,0,0,,Ең мықты атты қыз болу
Dialogue: 0,0:51:54.23,0:51:56.86,Default,,0,0,0,,Дерби атты қыз
Dialogue: 0,0:51:57.82,0:51:59.15,Default,,0,0,0,,О
Dialogue: 0,0:52:03.49,0:52:05.91,Default,,0,0,0,,Сен Тахёнмен жүгірген кезде
Dialogue: 0,0:52:05.99,0:52:08.20,Default,,0,0,0,,Ол жігіттің жүгіруіне қалай қарадың?
Dialogue: 0,0:52:08.29,0:52:09.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:12.92,0:52:15.55,Default,,0,0,0,,Ума Мусуменің жүгіруі өтірік
Dialogue: 0,0:52:16.46,0:52:19.30,Default,,0,0,0,,Менің ойым басқа болса да
Dialogue: 0,0:52:21.76,0:52:25.56,Default,,0,0,0,,Мұның бәрі сіздің жүгіруіңізде міндетті түрде көрініс табады.
Dialogue: 0,0:52:27.27,0:52:30.81,Default,,0,0,0,,Және сол сезімдерді дұрыс қабылдай білу
Dialogue: 0,0:52:30.89,0:52:33.90,Default,,0,0,0,,Дәл сол атты қыз шығар
Dialogue: 0,0:52:33.98,0:52:37.07,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:52:40.49,0:52:42.20,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,0:53:02.68,0:53:05.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:53:05.55,0:53:09.22,Default,,0,0,0,,Фаворит саналған Агнестахён белгісіз мерзімге тоқтатылды
Dialogue: 0,0:53:09.31,0:53:12.23,Default,,0,0,0,,Қалған жылқы қыздары не ойлайды?
Dialogue: 0,0:53:12.31,0:53:14.48,Default,,0,0,0,,Биылғы Дербиде жеңіске жету
Dialogue: 0,0:53:14.56,0:53:18.77,Default,,0,0,0,,18 атты қыздар Токиодағы жарыс жолында жиналады
Dialogue: 0,0:53:19.32,0:53:20.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:21.82,0:53:23.28,Default,,0,0,0,,Данц
Dialogue: 0,0:53:25.32,0:53:27.33,Default,,0,0,0,,Мен оны көргім келді.
Dialogue: 0,0:53:27.41,0:53:29.45,Default,,0,0,0,,Тахён дербиде жүгіріп келеді
Dialogue: 0,0:53:29.54,0:53:32.50,Default,,0,0,0,,Шынымен, сен неге тоқтадың?
Dialogue: 0,0:53:32.58,0:53:36.58,Default,,0,0,0,,Ең мықты атты қыз маусым ортасында жоғалады.
Dialogue: 0,0:53:36.67,0:53:38.46,Default,,0,0,0,,Басты кейіпкерсіз дерби?
Dialogue: 0,0:53:38.54,0:53:41.63,Default,,0,0,0,,Әркім ойына келгенін айтады
Dialogue: 0,0:53:41.71,0:53:43.76,Default,,0,0,0,,Бұл одан да көп қалта.
Dialogue: 0,0:53:43.84,0:53:45.47,Default,,0,0,0,,Ол жақсы ма?
Dialogue: 0,0:53:45.55,0:53:46.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:49.31,0:53:52.48,Default,,0,0,0,,Ал, Танабе Дарби ше?
Dialogue: 0,0:53:53.85,0:53:57.10,Default,,0,0,0,,Дерби ерекше
Dialogue: 0,0:53:57.19,0:54:01.23,Default,,0,0,0,,Ума Мусуме үшін өмірде бір рет болатын арман
Dialogue: 0,0:54:01.32,0:54:04.61,Default,,0,0,0,,Біз жаттықтырушылар үшін де бұл арман емес.
Dialogue: 0,0:54:05.57,0:54:07.82,Default,,0,0,0,,Өмірде бір рет иә
Dialogue: 0,0:54:07.91,0:54:10.12,Default,,0,0,0,,Егер мен дербиді жеңе алсам
Dialogue: 0,0:54:10.20,0:54:12.70,Default,,0,0,0,,Бұл қалай...
Dialogue: 0,0:54:14.75,0:54:16.17,Default,,0,0,0,,Қазір де сізге
Dialogue: 0,0:54:16.25,0:54:19.75,Default,,0,0,0,,Мен дербиде жеңіске жетсем деп едім.
Dialogue: 0,0:54:21.71,0:54:24.63,Default,,0,0,0,,Қалта сізге жүгіреді
Dialogue: 0,0:54:27.55,0:54:29.43,Default,,0,0,0,,Мен де сенемін.
Dialogue: 0,0:54:29.51,0:54:34.56,Default,,0,0,0,,Қалта мен сияқты Наби-санды қуантады.
Dialogue: 0,0:54:36.23,0:54:38.40,Default,,0,0,0,,Өзім жүгірмесем де
Dialogue: 0,0:54:38.48,0:54:41.23,Default,,0,0,0,,Сіз жарысты көруге келдіңіз, солай ма?
Dialogue: 0,0:54:41.32,0:54:43.94,Default,,0,0,0,,Менің жүгіргенімді бақылаған қыздар
Dialogue: 0,0:54:44.03,0:54:47.45,Default,,0,0,0,,Оның қалай өзгеретінін көруіміз керек.
Dialogue: 0,0:54:47.53,0:54:51.28,Default,,0,0,0,,Әрине, мен сенің қайтуыңды асыға күтемін.
Dialogue: 0,0:54:51.37,0:54:53.33,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз
Dialogue: 0,0:54:53.41,0:54:55.45,Default,,0,0,0,,Ума Мусуменің жеңіске деген инстинкті
Dialogue: 0,0:54:55.54,0:54:58.50,Default,,0,0,0,,Біз сізді қалай өзгертеміз?
Dialogue: 0,0:54:58.58,0:55:01.50,Default,,0,0,0,,Маған көрсетіңізші.
Dialogue: 0,0:55:03.80,0:55:05.05,Default,,0,0,0,,Біртүрлі адам
Dialogue: 0,0:55:06.09,0:55:08.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:55:08.76,0:55:13.22,Default,,0,0,0,,Балалар, ақырында мені алмастырасыңдар.
Dialogue: 0,0:55:13.31,0:55:16.10,Default,,0,0,0,,Мүмкіндіктерден тыс
Dialogue: 0,0:55:16.64,0:55:17.98,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:55:18.06,0:55:21.15,Default,,0,0,0,,Мен күте алмаймын!
Dialogue: 0,0:55:28.11,0:55:30.61,Default,,0,0,0,,Жеңіс немесе жеңілу маңызды емес
Dialogue: 0,0:55:30.70,0:55:32.91,Default,,0,0,0,,Тачён-чан осылай деді.
Dialogue: 0,0:55:33.58,0:55:35.45,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:55:35.54,0:55:38.87,Default,,0,0,0,,Бәйгеге шықсам, жеңгім келеді.
Dialogue: 0,0:55:38.96,0:55:40.29,Default,,0,0,0,,Сахнаның ортасында
Dialogue: 0,0:55:41.88,0:55:42.88,Default,,0,0,0,,О
Dialogue: 0,0:55:43.84,0:55:46.42,Default,,0,0,0,,Мен бүгін міндетті түрде жеңілмеймін.
Dialogue: 0,0:55:46.51,0:55:51.26,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:55:51.34,0:55:53.39,Default,,0,0,0,,Өкінішке орай, бұлтты аспанда
Dialogue: 0,0:55:53.47,0:55:55.85,Default,,0,0,0,,18 атты қыз бардың үстінде келе жатыр
Dialogue: 0,0:55:55.93,0:55:58.43,Default,,0,0,0,,Бірінен соң бірі қақпаға қарай бет аламыз.
Dialogue: 0,0:55:58.52,0:56:01.69,Default,,0,0,0,,Жарық жылдамдығынан асып, енді шымшықтан шыққан қарсылассыз
Dialogue: 0,0:56:01.77,0:56:05.07,Default,,0,0,0,,Буынның мықтысы кім болады?
Dialogue: 0,0:56:12.78,0:56:15.33,Default,,0,0,0,,Кадр аяқталды
Dialogue: 0,0:56:15.41,0:56:18.41,Default,,0,0,0,,Әр атты қыздың арманын арқау
Dialogue: 0,0:56:18.91,0:56:21.54,Default,,0,0,0,,Токио Юшун Жапония Дербиі
Dialogue: 0,0:56:21.62,0:56:23.79,Default,,0,0,0,,Маған көрейін.
Dialogue: 0,0:56:23.88,0:56:28.09,Default,,0,0,0,,Балалар, сендер қаншалықты жақын болдыңдар?
Dialogue: 0,0:56:28.17,0:56:29.13,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,0:56:29.22,0:56:30.84,Default,,0,0,0,,Басталды
Dialogue: 0,0:56:36.51,0:56:38.43,Default,,0,0,0,,Ал енді, біріншілік үшін жарыста не болады?
Dialogue: 0,0:56:38.52,0:56:40.43,Default,,0,0,0,,Ішінен…
Dialogue: 0,0:56:40.52,0:56:42.31,Default,,0,0,0,,Кобушинороот Лимери ішінен
Dialogue: 0,0:56:42.39,0:56:44.94,Default,,0,0,0,,Минами құмыра да сырттан баруға тырысады.
Dialogue: 0,0:56:46.07,0:56:49.32,Default,,0,0,0,,Ой! Минами құмыра Хананы соқты!
Dialogue: 0,0:56:49.40,0:56:50.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:50.24,0:56:51.95,Default,,0,0,0,,Сіз батыл жарыста жүгірдіңіз.
Dialogue: 0,0:56:52.03,0:56:54.53,Default,,0,0,0,,Сіз мұрагеріңізбен қауіпсіздікті қамтамасыз ете аласыз ба?
Dialogue: 0,0:56:54.62,0:56:56.33,Default,,0,0,0,,Қалта Уайымдамаңыз
Dialogue: 0,0:56:59.04,0:57:00.33,Default,,0,0,0,,Кім жетекшілік етті
Dialogue: 0,0:57:00.41,0:57:02.33,Default,,0,0,0,,Бұл Минами Питчер үшін үлкен қашу болды.
Dialogue: 0,0:57:02.41,0:57:04.71,Default,,0,0,0,,Минами құмыра қазірдің өзінде аралықты кеңейтіп жатыр
Dialogue: 0,0:57:04.79,0:57:08.38,Default,,0,0,0,,Енді оның артында Кобушино бағыты қазір екінші орында тұр.
Dialogue: 0,0:57:08.46,0:57:11.05,Default,,0,0,0,,Оның артында Лимери Уджида Варанойро болады.
Dialogue: 0,0:57:11.13,0:57:12.55,Default,,0,0,0,,Перри Стим және Джунгли қалтасы
Dialogue: 0,0:57:12.63,0:57:14.18,Default,,0,0,0,,Қазіргі уақытта тек жартылай қорғауда
Dialogue: 0,0:57:14.26,0:57:15.68,Default,,0,0,0,,Perry Steam Джунгли қалтасынан.
Dialogue: 0,0:57:15.76,0:57:18.06,Default,,0,0,0,,Мен сенің артыңа қарап келе жатырмын.
Dialogue: 0,0:57:18.14,0:57:20.18,Default,,0,0,0,,Данц жақтауы оның алдында.
Dialogue: 0,0:57:20.27,0:57:23.98,Default,,0,0,0,,Енді сол жақта 18 адам алдыңғы қатарға кіреді.
Dialogue: 0,0:57:25.44,0:57:26.98,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:57:27.06,0:57:29.61,Default,,0,0,0,,Тачён-чан немесе Поке-чан сияқты
Dialogue: 0,0:57:29.69,0:57:32.24,Default,,0,0,0,,Ұлы талант деген жоқ.
Dialogue: 0,0:57:33.07,0:57:36.07,Default,,0,0,0,,Стиль де, пішін де әдемі емес.
Dialogue: 0,0:57:36.16,0:57:39.41,Default,,0,0,0,,Соңғы шешуші факторсыз сіз жеңе алмайсыз.
Dialogue: 0,0:57:40.54,0:57:43.16,Default,,0,0,0,,Бірақ мен жеңгім келеді
Dialogue: 0,0:57:44.21,0:57:45.62,Default,,0,0,0,,Мен жеңгім келеді!
Dialogue: 0,0:57:45.71,0:57:48.25,Default,,0,0,0,,10 баррельге жуық қорғасынмен
Dialogue: 0,0:57:48.34,0:57:50.34,Default,,0,0,0,,Минами Питчер Ол осылай қашып құтыла ала ма?
Dialogue: 0,0:57:50.42,0:57:51.76,Default,,0,0,0,,Сіз айырмашылықты көре аласыз!
Dialogue: 0,0:57:54.47,0:57:55.47,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:57:55.55,0:57:58.01,Default,,0,0,0,,Перри буы қазірдің өзінде қозғалыста.
Dialogue: 0,0:57:58.10,0:58:01.10,Default,,0,0,0,,Перри Стим 4-ші бұрышты итеріп келеді
Dialogue: 0,0:58:01.18,0:58:03.68,Default,,0,0,0,,Dantz Frame Jungle Pocket әлі артқы жағында
Dialogue: 0,0:58:03.77,0:58:05.39,Default,,0,0,0,,600 қалды
Dialogue: 0,0:58:05.48,0:58:06.48,Default,,0,0,0,,Қалта
Dialogue: 0,0:58:10.11,0:58:11.44,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:58:15.82,0:58:19.20,Default,,0,0,0,,Соңында біз төртінші бұрышты айналып, түзу бағытқа бет аламыз.
Dialogue: 0,0:58:19.28,0:58:21.16,Default,,0,0,0,,Көшбасшылықты сақтап қалған Минами құмыра
Dialogue: 0,0:58:21.24,0:58:23.20,Default,,0,0,0,,Сіз осы жерде топқа түсесіз бе?
Dialogue: 0,0:58:23.29,0:58:24.66,Default,,0,0,0,,Енді Лимери қашып кетті.
Dialogue: 0,0:58:24.75,0:58:26.00,Default,,0,0,0,,Лимери сырғып кетті, бірақ
Dialogue: 0,0:58:26.08,0:58:28.88,Default,,0,0,0,,Перри Steam бардың ортасынан өтіп жатыр!
Dialogue: 0,0:58:28.96,0:58:30.25,Default,,0,0,0,,Күшті күшті!
Dialogue: 0,0:58:30.34,0:58:32.30,Default,,0,0,0,,Енді биылғы Жапония дербиі
Dialogue: 0,0:58:32.38,0:58:34.55,Default,,0,0,0,,Perry Steam оны қабылдай ма?
Dialogue: 0,0:58:34.63,0:58:35.80,Default,,0,0,0,,Поке... Поке мырза
Dialogue: 0,0:58:37.38,0:58:40.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:42.64,0:58:43.68,Default,,0,0,0,,Қалта
Dialogue: 0,0:58:43.77,0:58:46.98,Default,,0,0,0,,…
Dialogue: 0,0:58:47.06,0:58:48.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:50.61,0:58:52.23,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:58:52.32,0:58:55.78,Default,,0,0,0,,Мен олардың бұлай істегенін білмеймін.
Dialogue: 0,0:58:56.45,0:58:57.78,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:58:58.36,0:59:00.41,Default,,0,0,0,,Сатсуки сыйлығы
Dialogue: 0,0:59:00.49,0:59:03.08,Default,,0,0,0,,Ол кезде сіздің жүгіруіңіз қандай болды?
Dialogue: 0,0:59:03.70,0:59:06.00,Default,,0,0,0,,«Аяғым сынса маған бәрібір».
Dialogue: 0,0:59:06.08,0:59:08.25,Default,,0,0,0,,«Мен ары қарай не болатынын білмеймін».
Dialogue: 0,0:59:08.33,0:59:11.29,Default,,0,0,0,,«Өзіңнен асып кет, шектен шық»
Dialogue: 0,0:59:11.38,0:59:14.05,Default,,0,0,0,,Ол осындай табандылық танытты.
Dialogue: 0,0:59:14.71,0:59:18.80,Default,,0,0,0,,Одан асып түссең, одан да асып түсуге тырыс.
Dialogue: 0,0:59:19.59,0:59:21.30,Default,,0,0,0,,Тек
Dialogue: 0,0:59:22.93,0:59:24.68,Default,,0,0,0,,Мен одан да асып түсемін
Dialogue: 0,0:59:24.77,0:59:26.18,Default,,0,0,0,,Мен де
Dialogue: 0,0:59:26.27,0:59:27.89,Default,,0,0,0,,Артық
Dialogue: 0,0:59:27.98,0:59:28.94,Default,,0,0,0,,Мен де
Dialogue: 0,0:59:29.02,0:59:30.44,Default,,0,0,0,,Мен одан да асып түсемін
Dialogue: 0,0:59:30.52,0:59:31.44,Default,,0,0,0,,Мен де
Dialogue: 0,0:59:31.52,0:59:32.94,Default,,0,0,0,,Мен одан да асып түсемін!
Dialogue: 0,0:59:33.02,0:59:34.19,Default,,0,0,0,,Мен де!
Dialogue: 0,0:59:34.28,0:59:37.40,Default,,0,0,0,,Жақсы, солай.
Dialogue: 0,0:59:37.49,0:59:39.03,Default,,0,0,0,,Мен бәрінен де асып түсемін
Dialogue: 0,0:59:39.99,0:59:41.28,Default,,0,0,0,,Мен сенен асып түсемін
Dialogue: 0,0:59:42.12,0:59:43.91,Default,,0,0,0,,Мен сені шегінен шығарамын
Dialogue: 0,0:59:44.87,0:59:47.29,Default,,0,0,0,,Мен өз шегімнен шығамын!
Dialogue: 0,0:59:47.37,0:59:49.33,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:59:49.42,0:59:51.42,Default,,0,0,0,,Ең күштісі
Dialogue: 0,0:59:51.50,0:59:54.13,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:59:54.21,0:59:56.80,Default,,0,0,0,,Джунгли қалтасы! Джунгли қалтасы осында!
Dialogue: 0,0:59:56.88,0:59:58.51,Default,,0,0,0,,Джунгли қалтасы осында!
Dialogue: 0,0:59:58.59,1:00:00.30,Default,,0,0,0,,Артқы жақтан Данц жақтауы
Dialogue: 0,0:59:58.59,1:00:00.30,Default,,0,0,0,,Мен де!
Dialogue: 0,1:00:00.38,1:00:03.26,Default,,0,0,0,,Джунгли қалтасы мен Данц жақтауын итеріңіз!
Dialogue: 0,1:00:03.35,1:00:05.31,Default,,0,0,0,,Перри буы… Перри буы өспейді
Dialogue: 0,1:00:05.39,1:00:07.02,Default,,0,0,0,,Перри буы өспейді!
Dialogue: 0,1:00:07.10,1:00:09.27,Default,,0,0,0,,Мен жеңемін, жеңемін (Поккенің ішкі дауысы) Мен жеңемін, мен жеңемін
Dialogue: 0,1:00:09.35,1:00:11.77,Default,,0,0,0,,Менің де жеңгім келеді! Мен жеңгім келеді!
Dialogue: 0,1:00:11.85,1:00:14.15,Default,,0,0,0,,Дұрыс, Данц, кел!
Dialogue: 0,1:00:14.23,1:00:15.48,Default,,0,0,0,,Кім жеңеді Кім жеңеді
Dialogue: 0,1:00:15.57,1:00:17.90,Default,,0,0,0,,Ортасы - күштісі
Dialogue: 0,1:00:17.99,1:00:20.78,Default,,0,0,0,,Бұл менмін! Бұл мен!
Dialogue: 0,1:00:21.36,1:00:23.16,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:00:23.24,1:00:24.53,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:00:24.62,1:00:25.91,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:00:25.99,1:00:27.91,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:00:28.00,1:00:30.79,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:00:30.87,1:00:32.54,Default,,0,0,0,,Жүр! Қалта! Бар! Қалта-сан!
Dialogue: 0,1:00:32.62,1:00:36.21,Default,,0,0,0,,Мен! Мен!
Dialogue: 0,1:00:36.30,1:00:39.38,Default,,0,0,0,,Ааа!
Dialogue: 0,1:00:39.47,1:00:41.18,Default,,0,0,0,,Басталуы - джунгли
Dialogue: 0,1:00:41.26,1:00:44.22,Default,,0,0,0,,Джунгли Джунгли? Джунгли қалтасы!
Dialogue: 0,1:00:44.30,1:00:46.31,Default,,0,0,0,,Данц жақтауы! Данц жақтағы 2 орын
Dialogue: 0,1:00:46.39,1:00:48.22,Default,,0,0,0,,Артынан Умаренагарано ұшып келеді!
Dialogue: 0,1:00:48.31,1:00:51.23,Default,,0,0,0,,Мен жеңемін!
Dialogue: 0,1:00:51.31,1:00:53.27,Default,,0,0,0,,Бірақ алдымен Джунгли қалтасы!
Dialogue: 0,1:00:53.35,1:00:55.61,Default,,0,0,0,,1-ден 2-ге дейінгі жолдар ашылды
Dialogue: 0,1:00:55.69,1:00:58.86,Default,,0,0,0,,Алдымен Джунгли қалтасы!
Dialogue: 0,1:00:58.94,1:01:02.61,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:01:03.32,1:01:08.62,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:01:08.70,1:01:09.75,Default,,0,0,0,,Набе мырза
Dialogue: 0,1:01:10.25,1:01:11.25,Default,,0,0,0,,О
Dialogue: 0,1:01:11.33,1:01:12.71,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:01:12.79,1:01:15.67,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:01:17.25,1:01:18.88,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,1:01:21.09,1:01:25.09,Default,,0,0,0,,Джунгли қалтасы 1!
Dialogue: 0,1:01:25.18,1:01:26.80,Default,,0,0,0,,2 орынға Данц жақтауы
Dialogue: 0,1:01:26.89,1:01:30.22,Default,,0,0,0,,Мақсаттың алдына қайта түскен Данц жақтауын қайтадан итеріңіз.
Dialogue: 0,1:01:30.31,1:01:32.77,Default,,0,0,0,,Жаңа дәуірдің есігін кім ашты
Dialogue: 0,1:01:32.85,1:01:35.40,Default,,0,0,0,,Джунгли қалтасы!
Dialogue: 0,1:01:37.31,1:01:38.48,Default,,0,0,0,,Қалта! Қалта-сан!
Dialogue: 0,1:01:38.57,1:01:42.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:01:44.57,1:01:49.87,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:01:49.95,1:01:53.12,Default,,0,0,0,,Хаха...
Dialogue: 0,1:01:54.37,1:01:56.38,Default,,0,0,0,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,1:01:57.38,1:02:00.50,Default,,0,0,0,,Құттықтаймыз Покке-чан...
Dialogue: 0,1:02:00.59,1:02:01.88,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:03.09,1:02:04.55,Default,,0,0,0,,Ха…
Dialogue: 0,1:02:14.89,1:02:15.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:15.98,1:02:17.77,Default,,0,0,0,,Керемет!
Dialogue: 0,1:02:17.86,1:02:20.19,Default,,0,0,0,,бақталастық жауынгерлік рух
Dialogue: 0,1:02:20.27,1:02:22.53,Default,,0,0,0,,Бұл мен күткеннен де жақсы жүгіру емес пе?
Dialogue: 0,1:02:22.61,1:02:27.41,Default,,0,0,0,,Осылай жалғаса берсе, бір күні сен менің орнымды басасың...
Dialogue: 0,1:02:33.75,1:02:37.42,Default,,0,0,0,,Менің орнымда...
Dialogue: 0,1:02:42.09,1:02:46.72,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:02:49.55,1:02:50.47,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:50.55,1:02:51.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:51.56,1:02:53.47,Default,,0,0,0,,Ах
Dialogue: 0,1:02:58.65,1:03:03.07,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:03:06.03,1:03:07.74,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:08.53,1:03:11.74,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,1:03:11.83,1:03:13.74,Default,,0,0,0,,Ой, бұл Джунгли қалтасы
Dialogue: 0,1:03:13.83,1:03:15.58,Default,,0,0,0,,Жеңіс шуы!
Dialogue: 0,1:03:15.66,1:03:19.17,Default,,0,0,0,,Оның G1-дегі алғашқы жеңісі, бұл Жапония дербиі болғандықтан.
Dialogue: 0,1:03:19.25,1:03:20.83,Default,,0,0,0,,Біраз жайттар бар болуы керек.
Dialogue: 0,1:03:20.92,1:03:22.67,Default,,0,0,0,,(Фудзи мен Танабенің күлкісі)
Dialogue: 0,1:03:23.67,1:03:27.42,Default,,0,0,0,,Поке... Поке мұны мен үшін жасады.
Dialogue: 0,1:03:27.51,1:03:29.59,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,1:03:31.26,1:03:32.89,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:03:35.47,1:03:38.81,Default,,0,0,0,,Керемет, шынымен де
Dialogue: 0,1:03:42.36,1:03:44.32,Default,,0,0,0,,Құттықтаймыз Поке
Dialogue: 0,1:03:44.40,1:03:46.69,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:03:46.78,1:03:48.07,Default,,0,0,0,,Әлі де айқайлайды
Dialogue: 0,1:03:48.15,1:03:50.03,Default,,0,0,0,,Мен сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,1:03:50.11,1:03:52.12,Default,,0,0,0,,Керемет, Покке!
Dialogue: 0,1:03:52.20,1:03:57.62,Default,,0,0,0,,(Поккенің айқайлаған дауысы)
Dialogue: 0,1:04:01.12,1:04:04.13,Default,,0,0,0,,♪~
Dialogue: 0,1:04:52.55,1:04:54.72,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:04:57.81,1:05:01.48,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:05:11.70,1:05:12.90,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:05:33.13,1:05:36.14,Default,,0,0,0,,~♪
Dialogue: 0,1:05:44.23,1:05:47.36,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:05:47.44,1:05:51.03,Default,,0,0,0,,(Ат үстіндегі қыздардың ойнақы дауыстары)
Dialogue: 0,1:05:56.74,1:05:58.41,Default,,0,0,0,,Мен бүгін көп жүзетін боламын!
Dialogue: 0,1:05:58.49,1:06:00.37,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,1:06:00.45,1:06:02.83,Default,,0,0,0,,Райс та барын салады!
Dialogue: 0,1:06:03.83,1:06:05.54,Default,,0,0,0,,Мен оны тезірек жегім келеді.
Dialogue: 0,1:06:05.62,1:06:07.63,Default,,0,0,0,,Иә, тоқта!
Dialogue: 0,1:06:08.96,1:06:12.13,Default,,0,0,0,,Жүзу алдында дұрыс дене қыздыру жаттығуын жасаңыз.
Dialogue: 0,1:06:12.21,1:06:13.63,Default,,0,0,0,,Уа!
Dialogue: 0,1:06:13.72,1:06:16.68,Default,,0,0,0,,Сіздің денсаулығыңыз бұрынғыға қарағанда жақсы көрінеді.
Dialogue: 0,1:06:16.76,1:06:17.89,Default,,0,0,0,,Иә
Dialogue: 0,1:06:17.97,1:06:19.10,Default,,0,0,0,,Осы күзден
Dialogue: 0,1:06:19.18,1:06:22.02,Default,,0,0,0,,Мен шындап бастауды жоспарлап отырмын.
Dialogue: 0,1:06:22.10,1:06:25.52,Default,,0,0,0,,Қызық, мен сені Кикука Шода кездестіремін бе?
Dialogue: 0,1:06:25.60,1:06:26.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:26.40,1:06:29.61,Default,,0,0,0,,Мен міндетті түрде жетемін.
Dialogue: 0,1:06:29.69,1:06:34.15,Default,,0,0,0,,Екеуіңе, сол кездегі Тахёнға.
Dialogue: 0,1:06:34.24,1:06:35.45,Default,,0,0,0,,Достарыңызға
Dialogue: 0,1:06:35.53,1:06:38.32,Default,,0,0,0,,Кафе-чан да көп уақыттан кейін бізге қосылды.
Dialogue: 0,1:06:38.41,1:06:41.16,Default,,0,0,0,,Бұл қызықты жазғы лагерь болатын сияқты
Dialogue: 0,1:06:41.24,1:06:42.66,Default,,0,0,0,,Барымызды бірге жасайық
Dialogue: 0,1:06:42.74,1:06:43.41,Default,,0,0,0,,О
Dialogue: 0,1:06:43.50,1:06:46.50,Default,,0,0,0,,Сол үш адам да жаттығуға кіріседі.
Dialogue: 0,1:06:46.58,1:06:49.17,Default,,0,0,0,,Иә
Dialogue: 0,1:06:51.75,1:06:52.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:58.39,1:07:01.56,Default,,0,0,0,,…
Dialogue: 0,1:07:03.56,1:07:05.23,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,1:07:14.32,1:07:15.78,Default,,0,0,0,,Я...
Dialogue: 0,1:07:16.49,1:07:17.49,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,1:07:26.96,1:07:27.96,Default,,0,0,0,,Әй!
Dialogue: 0,1:07:31.38,1:07:32.63,Default,,0,0,0,,Әй!
Dialogue: 0,1:07:32.71,1:07:34.46,Default,,0,0,0,,Хмм
Dialogue: 0,1:07:35.96,1:07:37.72,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:37.80,1:07:38.97,Default,,0,0,0,,Ммм
Dialogue: 0,1:07:40.84,1:07:44.89,Default,,0,0,0,,(Поккенің созылған дауысы)
Dialogue: 0,1:07:54.15,1:07:56.19,Default,,0,0,0,,Ах~
Dialogue: 0,1:07:57.11,1:07:58.15,Default,,0,0,0,,Уау!?
Dialogue: 0,1:07:58.24,1:08:01.53,Default,,0,0,0,,Ах! Көзге! Ауырды~
Dialogue: 0,1:08:01.62,1:08:04.79,Default,,0,0,0,,(Сөйлеген жылқы қыздарының дауысы)
Dialogue: 0,1:08:04.87,1:08:07.83,Default,,0,0,0,,Кешіріңіз, маған тамақ беріңізші.
Dialogue: 0,1:08:07.91,1:08:11.00,Default,,0,0,0,,Иә!? Тағы біреуі бар, солай ма?
Dialogue: 0,1:08:11.08,1:08:12.25,Default,,0,0,0,,Ешқандай
Dialogue: 0,1:08:12.33,1:08:13.42,Default,,0,0,0,,Өзін-өзі жөндеуді айтарлықтай тиімсіз етеді.
Dialogue: 0,1:08:13.50,1:08:14.84,Default,,0,0,0,,Ештеңе қалмады
Dialogue: 0,1:08:14.92,1:08:16.92,Default,,0,0,0,,Өзін-өзі жөндеуді айтарлықтай тиімсіз етеді.
Dialogue: 0,1:08:17.01,1:08:18.97,Default,,0,0,0,,Күнде жиі кептіріледі.
Dialogue: 0,1:08:19.05,1:08:22.14,Default,,0,0,0,,Қонақүйдің мұндай түрі үшін бұл өте жұмсақ.
Dialogue: 0,1:08:22.22,1:08:23.26,Default,,0,0,0,,Бірақ мата жұмсартқыш...
Dialogue: 0,1:08:23.35,1:08:24.22,Default,,0,0,0,,Ерте жатайық
Dialogue: 0,1:08:28.81,1:08:31.98,Default,,0,0,0,,(Жел қоңырауының дыбысы)
Dialogue: 0,1:09:34.37,1:09:38.34,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:09:39.63,1:09:43.80,Default,,0,0,0,,Дербидің Поке-чаны өте күшті болды.
Dialogue: 0,1:09:43.88,1:09:48.89,Default,,0,0,0,,Болашақта бұдан да күшті болатыныңызға сенімдімін.
Dialogue: 0,1:09:48.97,1:09:52.73,Default,,0,0,0,,Мен мәңгілікке жете алмаймын
Dialogue: 0,1:09:52.81,1:09:54.27,Default,,0,0,0,,Қуып жету
Dialogue: 0,1:09:54.35,1:09:58.48,Default,,0,0,0,,Әрқашан басқалардан кеш болыңыз
Dialogue: 0,1:09:58.57,1:10:02.19,Default,,0,0,0,,Басқаларға қарағанда күшті және жылдам
Dialogue: 0,1:10:03.19,1:10:05.45,Default,,0,0,0,,Әйтпесе
Dialogue: 0,1:10:05.53,1:10:09.03,Default,,0,0,0,,Қанша уақыт өтсе де, мен шынымен де жете алмаймын
Dialogue: 0,1:10:09.78,1:10:10.99,Default,,0,0,0,,Ха…
Dialogue: 0,1:10:12.70,1:10:14.21,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:10:14.79,1:10:18.17,Default,,0,0,0,,Мен қуып жетуім керек.
Dialogue: 0,1:10:18.25,1:10:22.01,Default,,0,0,0,,(Мерекелік музыка және отшашулардың дыбысы)
Dialogue: 0,1:10:23.26,1:10:26.68,Default,,0,0,0,,Мақта кәмпит, кәмпит жеу керек.
Dialogue: 0,1:10:26.76,1:10:27.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:42.28,1:10:44.19,Default,,0,0,0,,Өкінішке орай, Набе мырза
Dialogue: 0,1:10:44.28,1:10:46.45,Default,,0,0,0,,Жаттықтырушылар бірлесіп жұмыс істейді
Dialogue: 0,1:10:47.03,1:10:49.62,Default,,0,0,0,,Содан бері мен Қалтаның бетін жауып жүрмін.
Dialogue: 0,1:10:49.70,1:10:52.33,Default,,0,0,0,,Одан кейін оқу-жаттығу жиынында көп жаттығулар болады.
Dialogue: 0,1:10:53.08,1:10:55.29,Default,,0,0,0,,Бүгін жеңіл жүрейік.
Dialogue: 0,1:10:55.37,1:10:56.41,Default,,0,0,0,,Уссу
Dialogue: 0,1:10:58.67,1:11:01.34,Default,,0,0,0,,Бұл керемет болды, Дарби.
Dialogue: 0,1:11:01.42,1:11:04.30,Default,,0,0,0,,Набе-сан қатты жылады.
Dialogue: 0,1:11:04.38,1:11:05.67,Default,,0,0,0,,Мен де-
Dialogue: 0,1:11:06.55,1:11:09.26,Default,,0,0,0,,Мен жүгіре бастағым келді.
Dialogue: 0,1:11:11.05,1:11:13.64,Default,,0,0,0,,Менің ойымша, қайта жарысу жаман идея емес.
Dialogue: 0,1:11:13.72,1:11:14.47,Default,,0,0,0,,Әй!
Dialogue: 0,1:11:14.56,1:11:15.89,Default,,0,0,0,,Не?
Dialogue: 0,1:11:17.60,1:11:20.98,Default,,0,0,0,,Менің уақытым аяқталды.
Dialogue: 0,1:11:23.53,1:11:25.36,Default,,0,0,0,,Бұл күлкілі емес.
Dialogue: 0,1:11:26.61,1:11:27.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:28.03,1:11:30.78,Default,,0,0,0,,Бірақ мен солай ойлағаным рас.
Dialogue: 0,1:11:30.87,1:11:35.12,Default,,0,0,0,,Бұл біздің инстинктіміз екеніне сенімдімін.
Dialogue: 0,1:11:35.20,1:11:39.87,Default,,0,0,0,,Тамаша жүгіргенді көрсем, қуып кетпеймін.
Dialogue: 0,1:11:39.96,1:11:43.46,Default,,0,0,0,,Мен аяғыммен жеңгім келеді
Dialogue: 0,1:11:47.47,1:11:49.51,Default,,0,0,0,,Қалтаңыз қалай болды?
Dialogue: 0,1:11:49.59,1:11:50.64,Default,,0,0,0,,Мен?
Dialogue: 0,1:11:50.72,1:11:54.01,Default,,0,0,0,,Атты қыз болып не көрдіңіз?
Dialogue: 0,1:11:54.10,1:11:57.10,Default,,0,0,0,,Тахённың жүгірісі үшін Сатсуки сыйлығы
Dialogue: 0,1:11:57.18,1:12:00.23,Default,,0,0,0,,Тахён ол кезде керемет еді.
Dialogue: 0,1:12:00.31,1:12:04.48,Default,,0,0,0,,Сол жердегі жылқышы қыздардың бәріне көрсетіп жүргендей болды.
Dialogue: 0,1:12:04.57,1:12:06.15,Default,,0,0,0,,«Сен мені жеңе аласың ба?»
Dialogue: 0,1:12:06.23,1:12:08.95,Default,,0,0,0,,«Сіз менің артымнан келе аласыз ба?»
Dialogue: 0,1:12:09.03,1:12:11.61,Default,,0,0,0,,Бұл сынақ сияқты.
Dialogue: 0,1:12:13.07,1:12:16.49,Default,,0,0,0,,Шынымды айтсам, мен қатты қорықтым.
Dialogue: 0,1:12:16.58,1:12:20.12,Default,,0,0,0,,Сол кездегі көрініс менің басымда мәңгілік сақталады.
Dialogue: 0,1:12:20.21,1:12:23.13,Default,,0,0,0,,Әлгі бала ұзақ жүгірді.
Dialogue: 0,1:12:23.75,1:12:30.01,Default,,0,0,0,,Ума Мусуме тарихында қалатын жарқын сәт.
Dialogue: 0,1:12:30.09,1:12:33.43,Default,,0,0,0,,Ол ешқашан кетпейтін шығар.
Dialogue: 0,1:12:33.97,1:12:35.51,Default,,0,0,0,,Өйткені
Dialogue: 0,1:12:38.35,1:12:41.19,Default,,0,0,0,,Онымен жарысып, жеңіске жету
Dialogue: 0,1:12:41.27,1:12:43.98,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,1:12:45.48,1:12:47.11,Default,,0,0,0,,Сен мықтысың
Dialogue: 0,1:12:47.19,1:12:49.40,Default,,0,0,0,,Мен Тахёнға тең келер емеспін.
Dialogue: 0,1:12:49.49,1:12:52.16,Default,,0,0,0,,Мен кепілдік беремін
Dialogue: 0,1:12:52.24,1:12:56.45,Default,,0,0,0,,Дербидегі жүгіруіңіз керемет болды.
Dialogue: 0,1:12:56.53,1:12:58.08,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,1:12:58.16,1:13:00.91,Default,,0,0,0,,Жариялағандай, мен ең мықты атты қызбын.
Dialogue: 0,1:13:01.00,1:13:03.83,Default,,0,0,0,,Маған қалтаны көрсетпедің бе?
Dialogue: 0,1:13:04.79,1:13:07.30,Default,,0,0,0,,Мен дербиде жеңіске жеттім.
Dialogue: 0,1:13:08.21,1:13:09.63,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,1:13:12.84,1:13:15.93,Default,,0,0,0,,Сіз мұны сезінесіз бе?
Dialogue: 0,1:13:17.51,1:13:19.93,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:13:20.02,1:13:22.44,Default,,0,0,0,,Жарайды, сен.
Dialogue: 0,1:13:24.40,1:13:27.23,Default,,0,0,0,,(Дерби кезіндегі шаттық)
Dialogue: 0,1:13:27.32,1:13:29.32,Default,,0,0,0,,Иә! қалта
Dialogue: 0,1:13:32.28,1:13:33.66,Default,,0,0,0,,Хаха
Dialogue: 0,1:13:36.78,1:13:40.87,Default,,0,0,0,,Мен сізге әлі дұрыс алғыс айта алмадым.
Dialogue: 0,1:13:43.04,1:13:45.67,Default,,0,0,0,,Дерби атты қыз болғаныңызға рахмет.
Dialogue: 0,1:13:45.75,1:13:48.67,Default,,0,0,0,,Набе-санның арманын орындағаны үшін.
Dialogue: 0,1:13:49.75,1:13:51.34,Default,,0,0,0,,Рахмет
Dialogue: 0,1:13:52.05,1:13:53.34,Default,,0,0,0,,Ха…
Dialogue: 0,1:13:54.43,1:13:57.30,Default,,0,0,0,,Мені ояту үшін қалай жүгіру керектігін көрсеткені үшін
Dialogue: 0,1:13:58.89,1:14:00.31,Default,,0,0,0,,Рахмет
Dialogue: 0,1:14:04.02,1:14:05.69,Default,,0,0,0,,Эххе
Dialogue: 0,1:14:17.91,1:14:20.58,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры! Әрине...
Dialogue: 0,1:14:20.66,1:14:23.33,Default,,0,0,0,,Бірақ алдымен Джунгли қалтасы! 1 данадан...
Dialogue: 0,1:14:23.41,1:14:25.54,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:14:25.62,1:14:27.08,Default,,0,0,0,,Джунгли қалтасы! Dantz кадры!
Dialogue: 0,1:14:27.17,1:14:30.09,Default,,0,0,0,,Бірақ басы Джунгли Джунгли Джунгли?
Dialogue: 0,1:14:30.17,1:14:32.17,Default,,0,0,0,,Джунгли қалтасы 1!
Dialogue: 0,1:14:32.26,1:14:33.72,Default,,0,0,0,,2 орынға Данц жақтауы
Dialogue: 0,1:14:33.80,1:14:37.34,Default,,0,0,0,,Мақсаттың алдына қайта түскен Данц жақтауын қайтадан итеріңіз.
Dialogue: 0,1:14:37.43,1:14:39.76,Default,,0,0,0,,Жаңа дәуірдің есігін ашқан адам
Dialogue: 0,1:14:39.85,1:14:41.85,Default,,0,0,0,,Джунгли қалтасы!
Dialogue: 0,1:14:46.44,1:14:49.23,Default,,0,0,0,,…
Dialogue: 0,1:14:53.86,1:14:55.82,Default,,0,0,0,,Мен жете алмаймын
Dialogue: 0,1:14:55.90,1:14:57.45,Default,,0,0,0,,Сіздің күшіңіз
Dialogue: 0,1:15:02.04,1:15:03.37,Default,,0,0,0,,Ха…
Dialogue: 0,1:15:05.29,1:15:08.33,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:15:11.92,1:15:13.84,Default,,0,0,0,,Не болса да
Dialogue: 0,1:15:14.96,1:15:17.13,Default,,0,0,0,,Қанша тырыссаң да
Dialogue: 0,1:15:18.18,1:15:20.72,Default,,0,0,0,,Ол сіздің алдыңызда
Dialogue: 0,1:15:23.47,1:15:26.98,Default,,0,0,0,,Бұл шектен шыққан, сен жынды сияқты жүгіресің.
Dialogue: 0,1:15:27.06,1:15:29.06,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:15:29.15,1:15:30.23,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:30.31,1:15:32.27,Default,,0,0,0,,Хаха...
Dialogue: 0,1:15:37.28,1:15:38.49,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,1:15:38.57,1:15:39.74,Default,,0,0,0,,(Сырт еткен дыбыс)
Dialogue: 0,1:15:41.07,1:15:42.74,Default,,0,0,0,,Омемо
Dialogue: 0,1:15:55.88,1:15:56.88,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,1:16:01.43,1:16:04.56,Default,,0,0,0,,Иә! Ха ха...
Dialogue: 0,1:16:06.93,1:16:08.64,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,1:16:11.19,1:16:13.86,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:16:18.86,1:16:20.11,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,1:16:28.25,1:16:29.62,Default,,0,0,0,,Тахён бар
Dialogue: 0,1:16:33.58,1:16:35.46,Default,,0,0,0,,Сіз мүлде жеңе алмайсыз
Dialogue: 0,1:16:50.69,1:16:55.48,Default,,0,0,0,,Сіз болдыңыз... Мен... болдым.
Dialogue: 0,1:16:58.44,1:17:00.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:01.45,1:17:03.36,Default,,0,0,0,,Ең күшті емес
Dialogue: 0,1:17:12.96,1:17:15.75,Default,,0,0,0,,Классикалық Triple Crown Кикука Шо өзінің соңғы кезеңіне жетті.
Dialogue: 0,1:17:15.84,1:17:18.17,Default,,0,0,0,,Жарыс соңғы түзу сызыққа енді.
Dialogue: 0,1:17:18.25,1:17:19.59,Default,,0,0,0,,Жүр, 100 метр қалды.
Dialogue: 0,1:17:19.67,1:17:21.55,Default,,0,0,0,,Біріншісі әлі де Сағат монархы.
Dialogue: 0,1:17:21.63,1:17:22.63,Default,,0,0,0,,Қашыңыз Қашыңыз!
Dialogue: 0,1:17:22.72,1:17:24.18,Default,,0,0,0,,Ал сырттан Аура мәрмәр
Dialogue: 0,1:17:24.26,1:17:26.35,Default,,0,0,0,,Одан әрі Дерби Ума Мусуме Джунгли қалтасы
Dialogue: 0,1:17:26.43,1:17:27.89,Default,,0,0,0,,Джунгли қалтасы сырттан!
Dialogue: 0,1:17:27.97,1:17:30.85,Default,,0,0,0,,Және Манхэттен кафесі! Манхэттен кафесі
Dialogue: 0,1:17:30.93,1:17:32.52,Default,,0,0,0,,Манхэттен кафесі ортасынан бөлінген
Dialogue: 0,1:17:32.60,1:17:34.94,Default,,0,0,0,,Біз олқылықты тұрақты түрде жаптық
Dialogue: 0,1:17:35.02,1:17:36.11,Default,,0,0,0,,Джунглидегі қалта қуу
Dialogue: 0,1:17:36.19,1:17:38.57,Default,,0,0,0,,Бірақ Манхэттен Біздің монарх Манхэттен!
Dialogue: 0,1:17:38.65,1:17:40.44,Default,,0,0,0,,Манхэттен кафесі Сапқа тұрыңыз және қашыңыз
Dialogue: 0,1:17:40.53,1:17:42.61,Default,,0,0,0,,Мақсат!
Dialogue: 0,1:17:43.28,1:17:44.70,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,1:17:44.78,1:17:46.20,Default,,0,0,0,,Манхэттен кафесі!
Dialogue: 0,1:17:46.28,1:17:49.45,Default,,0,0,0,,Ерекше болғаны - Манхэттен кафесі!
Dialogue: 0,1:17:49.54,1:17:52.08,Default,,0,0,0,,Сен достарыңды қуып жеттің бе?
Dialogue: 0,1:17:52.16,1:17:53.79,Default,,0,0,0,,…Джунгли қалтасы және Данц жақтауы
Dialogue: 0,1:17:53.87,1:17:56.33,Default,,0,0,0,,Біз олардың бәрін жеңдік!
Dialogue: 0,1:18:00.09,1:18:02.22,Default,,0,0,0,,Джунглиде қалта қуу Бірақ...
Dialogue: 0,1:18:02.30,1:18:03.84,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,1:18:05.05,1:18:08.10,Default,,0,0,0,,Жалаң аяқпен әлемімді таптап
Dialogue: 0,1:18:08.18,1:18:13.77,Default,,0,0,0,,Рұқсатсыз жоғалып кеттің, Арғы жаққа жете алмадым
Dialogue: 0,1:18:14.85,1:18:16.85,Default,,0,0,0,,Мен қуып жетемін
Dialogue: 0,1:18:17.44,1:18:19.32,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,1:18:20.44,1:18:23.03,Default,,0,0,0,,Мен осы күзде Opera O-ны қайтадан қолдағым келеді.
Dialogue: 0,1:18:23.11,1:18:26.24,Default,,0,0,0,,Мен Киотодағы бас жүлдеде бірінші орын алдым.
Dialogue: 0,1:18:26.32,1:18:30.37,Default,,0,0,0,,Мен 8 G1 жеңісін күтемін, бұл тарихтағы ең көп жеңіс.
Dialogue: 0,1:18:30.45,1:18:31.99,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,1:18:32.08,1:18:33.75,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:18:33.83,1:18:36.25,Default,,0,0,0,,Аа, күт, Покке, үйге бірге барайық.
Dialogue: 0,1:18:36.33,1:18:37.54,Default,,0,0,0,,Ойын орталығы Кеттік!
Dialogue: 0,1:18:37.63,1:18:39.04,Default,,0,0,0,,Ято ондай Қасиетті Құралды неге сақтап жүр?
Dialogue: 0,1:18:39.13,1:18:41.84,Default,,0,0,0,,Олай болса парфет! Отбасылық мейрамхана!
Dialogue: 0,1:18:41.92,1:18:43.09,Default,,0,0,0,,Жарайды
Dialogue: 0,1:18:43.17,1:18:44.51,Default,,0,0,0,,Мен балмұздақ немесе қаймақ таңдауда қиналып жатырмын.
Dialogue: 0,1:18:44.59,1:18:46.05,Default,,0,0,0,,Шоколад та жақсы~
Dialogue: 0,1:18:46.13,1:18:47.26,Default,,0,0,0,,Менің қарным ашты~
Dialogue: 0,1:18:51.85,1:18:55.85,Default,,0,0,0,,(Мейдің және басқалардың сөйлейтін дауыстары)
Dialogue: 0,1:18:55.94,1:18:57.31,Default,,0,0,0,,Кішкене ябо үшін вари
Dialogue: 0,1:18:57.40,1:18:58.02,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,1:18:59.23,1:19:00.57,Default,,0,0,0,,Фу
Dialogue: 0,1:19:10.58,1:19:11.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:10.58,1:19:11.70,Default,,0,0,0,,Отбасылық мейрамханаға не болды?
Dialogue: 0,1:19:11.70,1:19:12.58,Default,,0,0,0,,Отбасылық мейрамханаға не болды?
Dialogue: 0,1:19:12.66,1:19:13.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:15.25,1:19:16.50,Default,,0,0,0,,Фудзи мырза
Dialogue: 0,1:19:16.58,1:19:17.83,Default,,0,0,0,,Хехе
Dialogue: 0,1:19:24.55,1:19:26.51,Default,,0,0,0,,Ыстық... иә...
Dialogue: 0,1:19:26.59,1:19:28.93,Default,,0,0,0,,Және бұл
Dialogue: 0,1:19:29.01,1:19:30.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:31.01,1:19:33.14,Default,,0,0,0,,Бұл тыртық.
Dialogue: 0,1:19:36.48,1:19:38.69,Default,,0,0,0,,Таң қалды
Dialogue: 0,1:19:42.15,1:19:45.28,Default,,0,0,0,,Егер Тахён Дербиге қатысқан болса
Dialogue: 0,1:19:45.36,1:19:46.94,Default,,0,0,0,,Не болар еді?
Dialogue: 0,1:19:47.03,1:19:48.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:48.57,1:19:51.87,Default,,0,0,0,,Жарысқа «қоспаңыз».
Dialogue: 0,1:19:51.95,1:19:56.41,Default,,0,0,0,,Білсем де, ойланып қаламын.
Dialogue: 0,1:19:56.50,1:19:59.00,Default,,0,0,0,,Маған не болды?
Dialogue: 0,1:20:01.29,1:20:04.00,Default,,0,0,0,,Егер ол сол кезде бұзылмаған болса
Dialogue: 0,1:20:04.09,1:20:06.42,Default,,0,0,0,,Егер бұл әлі менің уақытым болса
Dialogue: 0,1:20:07.05,1:20:11.14,Default,,0,0,0,,Мен көрінсем де жеңер ме едім, білмеймін.
Dialogue: 0,1:20:12.43,1:20:16.22,Default,,0,0,0,,Тек 4 шайқас
Dialogue: 0,1:20:16.31,1:20:20.81,Default,,0,0,0,,Сол төрт шайқастың елесі әлі жойылған жоқ.
Dialogue: 0,1:20:24.44,1:20:27.11,Default,,0,0,0,,Мен Қалта жақсы болады деп ойладым.
Dialogue: 0,1:20:27.86,1:20:31.11,Default,,0,0,0,,Сіз де аян көріп тұрсыз ба?
Dialogue: 0,1:20:35.87,1:20:38.20,Default,,0,0,0,,Дербиде жеңіске жету
Dialogue: 0,1:20:38.29,1:20:40.79,Default,,0,0,0,,Кім не айтса да
Dialogue: 0,1:20:40.87,1:20:43.58,Default,,0,0,0,,Ол әлі менің алдымда
Dialogue: 0,1:20:44.42,1:20:46.59,Default,,0,0,0,,Мен жете алмаймын...
Dialogue: 0,1:20:48.59,1:20:52.80,Default,,0,0,0,,Мен әрқашан ең күшті болған емеспін.
Dialogue: 0,1:20:53.84,1:20:56.14,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,1:20:57.64,1:21:00.31,Default,,0,0,0,,Бірақ сіз әлі жүгіріп жатырсыз
Dialogue: 0,1:21:01.06,1:21:02.06,Default,,0,0,0,,Е...
Dialogue: 0,1:21:02.14,1:21:04.11,Default,,0,0,0,,Әлі жоқ, Поке.
Dialogue: 0,1:21:04.19,1:21:06.15,Default,,0,0,0,,Сіз әлі де жүгіре аласыз
Dialogue: 0,1:21:06.98,1:21:08.57,Default,,0,0,0,,Мен мұны ертеңге дейін сақтаймын.
Dialogue: 0,1:21:11.15,1:21:14.91,Default,,0,0,0,,Таңертең өзен жағасындағы жолға келіңіз.
Dialogue: 0,1:21:26.67,1:21:29.55,Default,,0,0,0,,Қайырлы таң Поке
Dialogue: 0,1:21:29.63,1:21:30.92,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:31.01,1:21:32.09,Default,,0,0,0,,Фудзи мырза!?
Dialogue: 0,1:21:32.68,1:21:35.47,Default,,0,0,0,,Таңертең ерте болғаным үшін кешіріңіз.
Dialogue: 0,1:21:35.55,1:21:39.85,Default,,0,0,0,,Мен сені қиналып қалдыра алмаймын.
Dialogue: 0,1:21:41.98,1:21:44.81,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,1:21:45.98,1:21:49.82,Default,,0,0,0,,А... мынау... неге?
Dialogue: 0,1:21:49.90,1:21:52.78,Default,,0,0,0,,Жазғы мерекеде айтқан сөздеріңіз өтірік емес.
Dialogue: 0,1:21:52.86,1:21:57.78,Default,,0,0,0,,Сенің жүгіріп бара жатқаныңды көргенде, жүгіре бастағым келді.
Dialogue: 0,1:21:57.87,1:21:59.24,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,1:22:00.91,1:22:03.21,Default,,0,0,0,,Менің уақытым өтіп кетсе де
Dialogue: 0,1:22:03.29,1:22:06.50,Default,,0,0,0,,Өзіңнен озудың жалғыз жолы – жүгіру
Dialogue: 0,1:22:07.04,1:22:08.29,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:22:08.84,1:22:10.76,Default,,0,0,0,,Жүгірейік
Dialogue: 0,1:22:16.47,1:22:18.14,Default,,0,0,0,,Я...
Dialogue: 0,1:22:20.77,1:22:22.60,Default,,0,0,0,,Я...
Dialogue: 0,1:22:45.87,1:22:47.29,Default,,0,0,0,,Әй!
Dialogue: 0,1:22:50.88,1:22:54.51,Default,,0,0,0,,…
Dialogue: 0,1:23:00.47,1:23:03.81,Default,,0,0,0,,Керемет. Бұл сіз белсенді ойыншы болған кездегідей жүгіру емес пе?
Dialogue: 0,1:23:03.89,1:23:04.73,Default,,0,0,0,,Әй!
Dialogue: 0,1:23:04.81,1:23:09.19,Default,,0,0,0,,…
Dialogue: 0,1:23:13.86,1:23:16.82,Default,,0,0,0,,…
Dialogue: 0,1:23:26.79,1:23:28.04,Default,,0,0,0,,Қалта
Dialogue: 0,1:23:29.33,1:23:30.50,Default,,0,0,0,,Қарау
Dialogue: 0,1:23:31.59,1:23:32.50,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,1:23:32.59,1:23:34.67,Default,,0,0,0,,Аяқтары ауыр
Dialogue: 0,1:23:37.43,1:23:38.68,Default,,0,0,0,,алыс
Dialogue: 0,1:23:39.51,1:23:41.85,Default,,0,0,0,,Сол кездегі өзіме
Dialogue: 0,1:23:43.93,1:23:45.85,Default,,0,0,0,,Себебі
Dialogue: 0,1:23:48.94,1:23:49.94,Default,,0,0,0,,Әй!
Dialogue: 0,1:23:50.02,1:23:52.44,Default,,0,0,0,,Сіз де мен сияқтысыз
Dialogue: 0,1:23:52.94,1:23:56.74,Default,,0,0,0,,Тахённан жеңіліп қалдым деген елеспен жеңілу
Dialogue: 0,1:23:57.53,1:23:59.91,Default,,0,0,0,,Ауырды, солай емес пе?
Dialogue: 0,1:24:00.53,1:24:02.95,Default,,0,0,0,,«Егер не істеу керек»
Dialogue: 0,1:24:03.03,1:24:04.95,Default,,0,0,0,,Тоқтауға жақын
Dialogue: 0,1:24:07.96,1:24:10.50,Default,,0,0,0,,Бірақ сіз әлі жүгіріп жатырсыз
Dialogue: 0,1:24:11.46,1:24:14.55,Default,,0,0,0,,Егер сіз жүгіргіңіз келмесе, бұл жақсы.
Dialogue: 0,1:24:14.63,1:24:15.80,Default,,0,0,0,,Бірақ
Dialogue: 0,1:24:15.88,1:24:18.30,Default,,0,0,0,,Мен әлі тоқтағым келмейді
Dialogue: 0,1:24:18.38,1:24:20.80,Default,,0,0,0,,Егер сіздің ойыңыз болса...
Dialogue: 0,1:24:22.47,1:24:24.01,Default,,0,0,0,,Мен де
Dialogue: 0,1:24:24.81,1:24:26.31,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,1:24:30.98,1:24:35.65,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:24:38.82,1:24:41.74,Default,,0,0,0,,Хехе, Фудзи мырза әлі осында.
Dialogue: 0,1:24:41.82,1:24:43.87,Default,,0,0,0,,Сіз бас тартқан жоқсыз.
Dialogue: 0,1:24:44.41,1:24:48.08,Default,,0,0,0,,Бланканы қайтарып алатын шығармын, білмеймін.
Dialogue: 0,1:24:48.16,1:24:52.88,Default,,0,0,0,,Мен саған елесімді көрсетемін
Dialogue: 0,1:24:52.96,1:24:54.46,Default,,0,0,0,,Ха!
Dialogue: 0,1:24:55.17,1:24:56.84,Default,,0,0,0,,Бұл шөптің иісі.
Dialogue: 0,1:25:02.30,1:25:04.26,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,1:25:05.10,1:25:09.23,Default,,0,0,0,,Мен әлі де жүгіруден, жеңілуден қорқамын.
Dialogue: 0,1:25:09.89,1:25:12.56,Default,,0,0,0,,Неліктен жүгіруді шештіңіз?
Dialogue: 0,1:25:12.65,1:25:15.27,Default,,0,0,0,,Неге жүгіріп жүрсің?
Dialogue: 0,1:25:15.36,1:25:17.48,Default,,0,0,0,,Міне.
Dialogue: 0,1:25:19.69,1:25:22.45,Default,,0,0,0,,Фудзи мырзаның жарысын көрген күн
Dialogue: 0,1:25:22.53,1:25:25.07,Default,,0,0,0,,Сол кездегі мен сезінген сезімдер
Dialogue: 0,1:25:25.16,1:25:27.24,Default,,0,0,0,,Ол әлі де бар...
Dialogue: 0,1:25:28.62,1:25:30.62,Default,,0,0,0,,Мен жүгіріп жатырмын
Dialogue: 0,1:25:30.70,1:25:32.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:32.46,1:25:35.63,Default,,0,0,0,,Фудзи-сан саған да жеңіліп қалмасын.
Dialogue: 0,1:25:38.34,1:25:42.05,Default,,0,0,0,,Ояну үшін жарысқа қатысқаныңыз үшін рахмет.
Dialogue: 0,1:25:42.63,1:25:44.64,Default,,0,0,0,,Менімен қайта жүгіріңіз
Dialogue: 0,1:25:46.26,1:25:49.31,Default,,0,0,0,,Хехе, мен тағы біраз жүгіремін.
Dialogue: 0,1:25:49.39,1:25:52.73,Default,,0,0,0,,Келесі жарыс, мен қараймын!
Dialogue: 0,1:25:55.44,1:25:57.19,Default,,0,0,0,,Маған қайта оқу керек
Dialogue: 0,1:25:58.61,1:25:59.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:00.03,1:26:01.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:02.40,1:26:04.74,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:26:04.82,1:26:07.49,Default,,0,0,0,,Және рахмет
Dialogue: 0,1:26:08.91,1:26:10.79,Default,,0,0,0,,Бұл жолы көбірек
Dialogue: 0,1:26:10.87,1:26:13.50,Default,,0,0,0,,Мен сені бақытты етемін
Dialogue: 0,1:26:13.58,1:26:15.58,Default,,0,0,0,,оң қолымның кіші саусағының бесінші метакарпальды сүйегінде тек шағын сынық пайда болды,
Dialogue: 0,1:26:19.67,1:26:20.59,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,1:26:22.26,1:26:25.22,Default,,0,0,0,,Жерді қатты соғыңыз
Dialogue: 0,1:26:25.30,1:26:27.22,Default,,0,0,0,,Иә!
Dialogue: 0,1:26:27.30,1:26:28.60,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,1:26:29.56,1:26:32.60,Default,,0,0,0,,Аяқтағаннан кейін денеңізді босаңсуды ұмытпаңыз.
Dialogue: 0,1:26:33.93,1:26:35.60,Default,,0,0,0,,Біраз уақыттан кейін тағы біреуін аламын.
Dialogue: 0,1:26:35.69,1:26:37.23,Default,,0,0,0,,Эх!
Dialogue: 0,1:26:37.31,1:26:39.98,Default,,0,0,0,,Қане, барлығы жиналыңдар.
Dialogue: 0,1:26:41.69,1:26:48.07,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:26:48.16,1:26:49.74,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,1:26:49.83,1:26:51.74,Default,,0,0,0,,Тазалаңыз!
Dialogue: 0,1:26:55.92,1:26:57.67,Default,,0,0,0,,Мынау
Dialogue: 0,1:26:57.75,1:27:00.67,Default,,0,0,0,,Осылай сөйлескенімізге біраз болды.
Dialogue: 0,1:27:00.75,1:27:02.92,Default,,0,0,0,,Не болды? Бүгін
Dialogue: 0,1:27:03.01,1:27:05.80,Default,,0,0,0,,А, не...
Dialogue: 0,1:27:06.76,1:27:10.43,Default,,0,0,0,,Маған параллель жүгіресің бе?
Dialogue: 0,1:27:13.64,1:27:16.31,Default,,0,0,0,,Жапония кубогына қатысу
Dialogue: 0,1:27:16.39,1:27:19.02,Default,,0,0,0,,Осы уақытқа дейін көргеніміздей, бұл тек Жапония емес.
Dialogue: 0,1:27:19.10,1:27:22.73,Default,,0,0,0,,Токиода әлемнің түкпір-түкпірінен күшті адамдар жиналатын жарыс
Dialogue: 0,1:27:23.40,1:27:25.32,Default,,0,0,0,,Бірақ бұл бәрі емес.
Dialogue: 0,1:27:25.95,1:27:29.70,Default,,0,0,0,,Ғасырдың ақыры билеушісі Т.М. Опера
Dialogue: 0,1:27:30.20,1:27:32.83,Default,,0,0,0,,Өткен жылы жыл бойы жеңілмеген
Dialogue: 0,1:27:32.91,1:27:36.83,Default,,0,0,0,,Менің ойымша, бұл шетелдегі адамдарға қарсы болса маңызды емес.
Dialogue: 0,1:27:36.91,1:27:40.33,Default,,0,0,0,,Сөзсіз, бұл Twinkle сериясындағы ең күшті.
Dialogue: 0,1:27:41.71,1:27:43.59,Default,,0,0,0,,Оған қарсы күресу үшін
Dialogue: 0,1:27:43.67,1:27:46.84,Default,,0,0,0,,Мен мықты жігіттермен көбірек жүгіргім келеді.
Dialogue: 0,1:27:47.47,1:27:50.93,Default,,0,0,0,,Иә, сен мықтысың.
Dialogue: 0,1:27:51.55,1:27:53.97,Default,,0,0,0,,Мен әлі де қорқамын
Dialogue: 0,1:27:54.93,1:27:57.89,Default,,0,0,0,,Сіз Сатсукиге тап болған кезде жүгіргенсіз
Dialogue: 0,1:27:59.10,1:28:01.61,Default,,0,0,0,,Мен ешқашан жете алмайтын шығармын.
Dialogue: 0,1:28:01.69,1:28:03.23,Default,,0,0,0,,Мен өмірімнің соңына дейін жеңе алмауым мүмкін.
Dialogue: 0,1:28:04.94,1:28:08.61,Default,,0,0,0,,Егер сен әлі осында болсаң, мен кім болар едім?
Dialogue: 0,1:28:08.70,1:28:11.95,Default,,0,0,0,,Мүмкін жүгірудің пайдасы жоқ шығар.
Dialogue: 0,1:28:14.99,1:28:16.12,Default,,0,0,0,,Бірақ
Dialogue: 0,1:28:19.29,1:28:21.00,Default,,0,0,0,,Жүгіру
Dialogue: 0,1:28:22.00,1:28:24.13,Default,,0,0,0,,Жүгіру және аяқтау
Dialogue: 0,1:28:24.84,1:28:27.26,Default,,0,0,0,,Оның мағынасы бар ма, жоқ па
Dialogue: 0,1:28:27.34,1:28:30.51,Default,,0,0,0,,Тоқтағым келмейді. Мен тоқтағым келмейді.
Dialogue: 0,1:28:31.84,1:28:34.10,Default,,0,0,0,,Егер мен қазір жүгіруді тоқтатсам
Dialogue: 0,1:28:34.18,1:28:38.64,Default,,0,0,0,,Мен өмір бойы болғым келетін ең күшті бола алмаймын.
Dialogue: 0,1:28:39.31,1:28:44.77,Default,,0,0,0,,Егер сізде болған мүмкіндіктен асып түсетін мүмкіндік болса, ол тумайды.
Dialogue: 0,1:28:45.48,1:28:47.28,Default,,0,0,0,,Өмір сол күйінде
Dialogue: 0,1:28:47.36,1:28:51.03,Default,,0,0,0,,Мен өзімнен де жеңілемін.
Dialogue: 0,1:28:52.53,1:28:56.66,Default,,0,0,0,,Сонымен қатар, олар керемет күшті.
Dialogue: 0,1:28:56.74,1:29:00.08,Default,,0,0,0,,Мені артымнан жұдырықпен шығару үшін аяқтарыңызды пайдаланыңыз.
Dialogue: 0,1:29:00.16,1:29:03.00,Default,,0,0,0,,Көзіңізді ашыңыз.
Dialogue: 0,1:29:03.75,1:29:07.25,Default,,0,0,0,,Мен бұл сезімді ұмыта алмаймын
Dialogue: 0,1:29:11.97,1:29:14.80,Default,,0,0,0,,Мен енді жүгірмеймін
Dialogue: 0,1:29:14.89,1:29:16.64,Default,,0,0,0,,Мен бұрын айтқанымдай
Dialogue: 0,1:29:16.72,1:29:20.39,Default,,0,0,0,,Мен болмасам да, кафе мен Данц-кун бар ғой, солай ма?
Dialogue: 0,1:29:20.48,1:29:21.98,Default,,0,0,0,,Хмм...
Dialogue: 0,1:29:23.73,1:29:25.77,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:29:25.86,1:29:29.53,Default,,0,0,0,,Ой, мен мұнда келуге тырыстым.
Dialogue: 0,1:29:29.61,1:29:31.82,Default,,0,0,0,,Саған бірдеңе болды.
Dialogue: 0,1:29:31.90,1:29:34.16,Default,,0,0,0,,Мен жүгіре алмаймын.
Dialogue: 0,1:29:35.49,1:29:38.66,Default,,0,0,0,,Жарайды, ұнаса келіңіз.
Dialogue: 0,1:29:39.70,1:29:43.42,Default,,0,0,0,,Мен де сенен құтылуға тырысуым керек.
Dialogue: 0,1:29:44.42,1:29:46.09,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,1:29:46.17,1:29:51.17,Default,,0,0,0,,...
Dialogue: 0,1:29:57.01,1:30:02.10,Default,,0,0,0,,...
Dialogue: 0,1:30:05.06,1:30:07.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:30:10.36,1:30:12.82,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:30:30.80,1:30:32.38,Default,,0,0,0,,Жылдамдықты төмендетпеңіз
Dialogue: 0,1:30:32.46,1:30:34.97,Default,,0,0,0,,Атты қыз мотоциклдей жеңілмейді
Dialogue: 0,1:30:35.05,1:30:37.14,Default,,0,0,0,,Иә
Dialogue: 0,1:30:41.18,1:30:43.18,Default,,0,0,0,,Қазір бәрі жақсы сияқты.
Dialogue: 0,1:30:43.27,1:30:46.65,Default,,0,0,0,,Иә, келесі жолы жеңіске жетуге рұқсат етемін.
Dialogue: 0,1:30:46.73,1:30:48.11,Default,,0,0,0,,Мен де жеңілмеймін
Dialogue: 0,1:30:48.86,1:30:51.90,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,1:30:51.98,1:30:55.20,Default,,0,0,0,,Мен жүгіруді жек көрмеймін, бірақ бәрібір қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 0,1:30:55.28,1:30:58.24,Default,,0,0,0,,Мен де «сол қызмын»
Dialogue: 0,1:30:58.32,1:31:00.58,Default,,0,0,0,,Мен ешкімнің мені қуып жеткенін қаламаймын.
Dialogue: 0,1:31:02.08,1:31:03.08,Default,,0,0,0,,О
Dialogue: 0,1:31:09.79,1:31:12.59,Default,,0,0,0,,Токио Шиба 2400 метр
Dialogue: 0,1:31:12.67,1:31:14.72,Default,,0,0,0,,Кеш күздің ашық аспаны астында
Dialogue: 0,1:31:14.80,1:31:17.38,Default,,0,0,0,,15 Ума Мусуме әлемнің түкпір-түкпірінен жиналады
Dialogue: 0,1:31:17.47,1:31:19.80,Default,,0,0,0,,GI Жапония кубогы
Dialogue: 0,1:31:19.89,1:31:21.97,Default,,0,0,0,,Түсініктемені Изумимото жазған
Dialogue: 0,1:31:22.06,1:31:23.64,Default,,0,0,0,,Арнайы қонақ ретінде түсініктеме
Dialogue: 0,1:31:23.72,1:31:25.81,Default,,0,0,0,,Окубо мырза бізге қонаққа келеді.
Dialogue: 0,1:31:25.89,1:31:27.48,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,1:31:27.56,1:31:30.02,Default,,0,0,0,,Narita Top Road және Meishodo To сияқты
Dialogue: 0,1:31:30.11,1:31:32.73,Default,,0,0,0,,Бұл шайқас GI атты қыздарға толы
Dialogue: 0,1:31:32.82,1:31:36.11,Default,,0,0,0,,Ең бастысы, оны жеңетін нәрсеге назар аударылады.
Dialogue: 0,1:31:36.20,1:31:37.86,Default,,0,0,0,,Ол пайда бола ма, жоқ па?
Dialogue: 0,1:31:37.95,1:31:40.41,Default,,0,0,0,,«Ғасырдың ақыры» Тем операсы О!
Dialogue: 0,1:31:40.49,1:31:41.78,Default,,0,0,0,,Рыцарлар
Dialogue: 0,1:31:41.87,1:31:46.08,Default,,0,0,0,,Ал жас Вертер алтынды талқандауға тырысады.
Dialogue: 0,1:31:46.16,1:31:47.83,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,1:31:49.17,1:31:50.96,Default,,0,0,0,,Менің алдымда жеңілген
Dialogue: 0,1:31:51.04,1:31:53.75,Default,,0,0,0,,Билік жолында парақ болу
Dialogue: 0,1:31:53.84,1:31:55.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:31:55.59,1:31:58.22,Default,,0,0,0,,Жоғары сынып GⅠ толық үстемдігінен кейін
Dialogue: 0,1:31:58.30,1:32:01.64,Default,,0,0,0,,Жапония кубогын қатарынан жеңіп алу бұрын-соңды болмаған ерлік бола ма?
Dialogue: 0,1:32:01.72,1:32:02.76,Default,,0,0,0,,Оның үстіне жалғыз
Dialogue: 0,1:32:02.85,1:32:06.64,Default,,0,0,0,,Бұл G1 тарихындағы ең көп сегіз жеңісті қажет ететін жарыс.
Dialogue: 0,1:32:06.73,1:32:07.77,Default,,0,0,0,,Мен үміттенемін
Dialogue: 0,1:32:09.10,1:32:13.82,Default,,0,0,0,,Токио 2400 м Жапондық дербимен бірдей
Dialogue: 0,1:32:13.90,1:32:16.86,Default,,0,0,0,,Бұл мықтыны анықтауға лайық жарыс.
Dialogue: 0,1:32:16.94,1:32:18.03,Default,,0,0,0,,О
Dialogue: 0,1:32:18.11,1:32:21.74,Default,,0,0,0,,Фудзи мырза, бұдан былай аудитория орындарынан қарап отырыңыз.
Dialogue: 0,1:32:22.41,1:32:25.62,Default,,0,0,0,,Таспа Оны қазір өзіңіз байлауға болады
Dialogue: 0,1:32:25.70,1:32:28.50,Default,,0,0,0,,Келесі жолы мен Фудзи мырзамен ипподромда сөйлесемін
Dialogue: 0,1:32:28.58,1:32:31.00,Default,,0,0,0,,Фудзи-санмен күресу уақыты
Dialogue: 0,1:32:39.59,1:32:41.30,Default,,0,0,0,,Келесі кіретін адам
Dialogue: 0,1:32:41.39,1:32:44.22,Default,,0,0,0,,Классикалық жарысты жаңа ғана аяқтаған жас сайыскер.
Dialogue: 0,1:32:44.30,1:32:45.68,Default,,0,0,0,,Джунгли қалтасы!
Dialogue: 0,1:32:45.76,1:32:48.39,Default,,0,0,0,,Биылғы Дерби атты қыз.
Dialogue: 0,1:32:48.48,1:32:51.48,Default,,0,0,0,,Мен Кикука Шодан кейін жүгіре бастадым.
Dialogue: 0,1:32:51.56,1:32:53.02,Default,,0,0,0,,Мәселе жоқ сияқты
Dialogue: 0,1:32:53.11,1:32:55.02,Default,,0,0,0,,Сіз жүгірсеңіз, өзіңіз білесіз
Dialogue: 0,1:32:56.23,1:32:58.11,Default,,0,0,0,,Менің жүрегім
Dialogue: 0,1:32:58.19,1:32:59.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:59.61,1:33:01.32,Default,,0,0,0,,Инстинкт
Dialogue: 0,1:33:02.45,1:33:03.66,Default,,0,0,0,,Мен
Dialogue: 0,1:33:04.32,1:33:06.95,Default,,0,0,0,,Сен мені ең мықты деп ойласаң
Dialogue: 0,1:33:10.33,1:33:11.79,Default,,0,0,0,,Бұл...
Dialogue: 0,1:33:14.21,1:33:15.63,Default,,0,0,0,,Әй!
Dialogue: 0,1:33:16.13,1:33:18.55,Default,,0,0,0,,Енді қақпа толығымен.
Dialogue: 0,1:33:18.63,1:33:21.68,Default,,0,0,0,,Абсолютті чемпион өзінің құдіретті күшін көрсете ме?
Dialogue: 0,1:33:21.76,1:33:25.55,Default,,0,0,0,,Ұлы басшыны құлататын біреу пайда бола ма?
Dialogue: 0,1:33:26.51,1:33:30.98,Default,,0,0,0,,Бір-бірінің ерік-жігері мен мақтанышына таласып, шешуші шайқастың уақыты келді.
Dialogue: 0,1:33:36.52,1:33:39.69,Default,,0,0,0,,Қазір Жапония кубогы
Dialogue: 0,1:33:41.61,1:33:42.82,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,1:33:42.90,1:33:45.07,Default,,0,0,0,,Бастау жасалды
Dialogue: 0,1:33:46.07,1:33:47.95,Default,,0,0,0,,Барлығы дерлік, таза бастама
Dialogue: 0,1:33:48.04,1:33:50.20,Default,,0,0,0,,Енді не және кім барады?
Dialogue: 0,1:33:50.29,1:33:52.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:33:53.04,1:33:54.33,Default,,0,0,0,,Камнароку Соносаки Йочиге
Dialogue: 0,1:33:54.42,1:33:56.71,Default,,0,0,0,,Екі америкалық батыл шабуыл жасайды
Dialogue: 0,1:33:54.42,1:33:56.71,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,1:33:56.79,1:33:58.67,Default,,0,0,0,,Муцкадоны Гонконгтың Духасаха күтіп тұр
Dialogue: 0,1:33:58.75,1:34:01.38,Default,,0,0,0,,Сонымен қатар, TM Opera O және Lexen America
Dialogue: 0,1:34:01.47,1:34:04.47,Default,,0,0,0,,Shine Forever жартылай қорғауға сырттан қосылады.
Dialogue: 0,1:34:04.55,1:34:05.51,Default,,0,0,0,,Джоран курста
Dialogue: 0,1:34:05.59,1:34:07.80,Default,,0,0,0,,Сонымен қатар, Мейшодото жартылай қорғаудың дәл айналасында.
Dialogue: 0,1:34:07.89,1:34:09.72,Default,,0,0,0,,Артындағы Джунгли қалтасы
Dialogue: 0,1:34:09.81,1:34:13.02,Default,,0,0,0,,Бұл алдау көбірек бола ма?
Dialogue: 0,1:34:13.10,1:34:17.15,Default,,0,0,0,,Жарайды, енді басталды, бірақ қарқыны баяу.
Dialogue: 0,1:34:21.07,1:34:22.36,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:22.44,1:34:26.57,Default,,0,0,0,,Айналаңда сондай дәрежедегі адамдар болса да, ұтылмайсың.
Dialogue: 0,1:34:26.66,1:34:27.32,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:27.41,1:34:28.99,Default,,0,0,0,,Мен! (Жоғары жүктеме) Мен!
Dialogue: 0,1:34:29.08,1:34:31.62,Default,,0,0,0,,Мен!
Dialogue: 0,1:34:31.70,1:34:33.29,Default,,0,0,0,,Мен!
Dialogue: 0,1:34:33.37,1:34:34.41,Default,,0,0,0,,Жеңіс!
Dialogue: 0,1:34:34.50,1:34:38.04,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:40.88,1:34:41.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:41.67,1:34:43.67,Default,,0,0,0,,Велардрина сырттан бірден!?
Dialogue: 0,1:34:43.76,1:34:44.51,Default,,0,0,0,,Велардрина тез майданға көтерілді.
Dialogue: 0,1:34:44.51,1:34:46.30,Default,,0,0,0,,Велардрина тез майданға көтерілді.
Dialogue: 0,1:34:44.51,1:34:46.30,Default,,0,0,0,,Уау...
Dialogue: 0,1:34:46.39,1:34:48.80,Default,,0,0,0,,Оның артында Муцкадо мен Духасаха тұр.
Dialogue: 0,1:34:46.39,1:34:48.80,Default,,0,0,0,,Сәттілік, Поке-сан
Dialogue: 0,1:34:48.89,1:34:51.72,Default,,0,0,0,,Ал оның артында міне, осында!
Dialogue: 0,1:34:51.81,1:34:54.52,Default,,0,0,0,,Т.М. Opera O оны осында киеді!
Dialogue: 0,1:34:59.65,1:35:01.57,Default,,0,0,0,,Сіз керемет болдыңыз.
Dialogue: 0,1:35:02.23,1:35:04.36,Default,,0,0,0,,Мен жүгіргім келеді
Dialogue: 0,1:35:05.78,1:35:07.70,Default,,0,0,0,,Т.М. Опера әлі де орта топта.
Dialogue: 0,1:35:07.78,1:35:10.20,Default,,0,0,0,,Ішінен мәңгі жарқыра. Джоран
Dialogue: 0,1:35:10.28,1:35:11.62,Default,,0,0,0,,Қосымша Джунгли қалтасы
Dialogue: 0,1:35:11.70,1:35:13.45,Default,,0,0,0,,Курстан
Dialogue: 0,1:35:13.54,1:35:15.29,Default,,0,0,0,,Петр оны артына қосты.
Dialogue: 0,1:35:15.37,1:35:16.96,Default,,0,0,0,,және №10 Нарита жоғарғы жолы
Dialogue: 0,1:35:17.04,1:35:17.96,Default,,0,0,0,,Сонымен қатар, оны №9 Широ Стив киіп жүр.
Dialogue: 0,1:35:17.96,1:35:19.84,Default,,0,0,0,,Сонымен қатар, оны №9 Широ Стив киіп жүр.
Dialogue: 0,1:35:17.96,1:35:19.84,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,1:35:20.79,1:35:22.17,Default,,0,0,0,,Хехе
Dialogue: 0,1:35:22.84,1:35:23.84,Default,,0,0,0,,Әй!
Dialogue: 0,1:35:23.92,1:35:26.05,Default,,0,0,0,,Енді біз соңғы түзу сызыққа кірдік!
Dialogue: 0,1:35:26.13,1:35:28.09,Default,,0,0,0,,Әрбір атты қыз ішке кіреді, бірақ
Dialogue: 0,1:35:28.18,1:35:31.30,Default,,0,0,0,,Мұнда Т.М. Opera O сырттан келеді!
Dialogue: 0,1:35:32.14,1:35:33.97,Default,,0,0,0,,Мейходото да іштен өседі.
Dialogue: 0,1:35:34.06,1:35:35.56,Default,,0,0,0,,...
Dialogue: 0,1:35:35.64,1:35:38.85,Default,,0,0,0,,Танымал атты қыздар бір мезетте соңғы төбеге шығады.
Dialogue: 0,1:35:38.94,1:35:41.06,Default,,0,0,0,,Бірақ алдымен Tem Opera O!
Dialogue: 0,1:35:41.15,1:35:42.36,Default,,0,0,0,,Сырттан Джунгли қалтасы
Dialogue: 0,1:35:41.15,1:35:42.36,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,1:35:42.44,1:35:43.98,Default,,0,0,0,,Нарита Топлорд та осында.
Dialogue: 0,1:35:42.44,1:35:43.98,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,1:35:44.07,1:35:46.95,Default,,0,0,0,,Біріншісі Teem болып қалады! Өйткені, оны жеңуші шешеді!
Dialogue: 0,1:35:47.03,1:35:50.41,Default,,0,0,0,,Сондықтан да, менің қарсыластарым!
Dialogue: 0,1:35:50.49,1:35:52.74,Default,,0,0,0,,Тұрақты бол! Көтеріңіз!
Dialogue: 0,1:35:52.83,1:35:55.75,Default,,0,0,0,,Аяғыңызды жолдың соңына дейін ұстаңыз!
Dialogue: 0,1:35:55.83,1:35:58.33,Default,,0,0,0,,Өзіңнің үстемдігің үшін!
Dialogue: 0,1:35:58.42,1:36:01.67,Default,,0,0,0,,Менің алға қарай секіруім үшін!
Dialogue: 0,1:36:01.75,1:36:04.67,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:09.72,1:36:11.43,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,1:36:14.97,1:36:17.68,Default,,0,0,0,,Бұл адамдар шектен шыққан.
Dialogue: 0,1:36:19.35,1:36:23.23,Default,,0,0,0,,О, бұл қорқынышты.
Dialogue: 0,1:36:24.40,1:36:26.90,Default,,0,0,0,,Мен жеңіліп қалуым мүмкін
Dialogue: 0,1:36:26.99,1:36:29.70,Default,,0,0,0,,Оны жеңу мүмкін болмауы мүмкін
Dialogue: 0,1:36:30.78,1:36:35.49,Default,,0,0,0,,Мен қорқып, қорқып тұра алмаймын.
Dialogue: 0,1:36:37.29,1:36:39.00,Default,,0,0,0,,Мен шыдай алмаймын...
Dialogue: 0,1:36:39.79,1:36:41.63,Default,,0,0,0,,Бірақ!
Dialogue: 0,1:36:53.97,1:36:55.89,Default,,0,0,0,,Алдымен барайық.
Dialogue: 0,1:36:55.97,1:36:57.81,Default,,0,0,0,,Әр жылқы қыз ішке кірді, бірақ
Dialogue: 0,1:36:57.89,1:37:00.52,Default,,0,0,0,,Осы кезде Т.М.О. сыртқа шығарады.
Dialogue: 0,1:37:00.60,1:37:01.98,Default,,0,0,0,,Мәңгі жарқырап сапқа тұрды
Dialogue: 0,1:37:02.06,1:37:03.15,Default,,0,0,0,,Топ дерлік Топ дерлік!
