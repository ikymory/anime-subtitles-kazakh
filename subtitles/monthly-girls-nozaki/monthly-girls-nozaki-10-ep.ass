Dialogue: 0,0:01:21.13,0:01:22.77,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
Dialogue: 0,0:01:22.77,0:01:24.57,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
Dialogue: 0,0:01:24.57,0:01:26.37,OP-JP,,0000,0000,0000,,Менің басымда гүл бағы бар ма, қыздардың мангасы ма,басқасы ма бәрібір.
Dialogue: 0,0:01:26.37,0:01:31.58,OP-JP,,0000,0000,0000,,Менің басымда гүл бағы бар ма, қыздардың мангасы ма,басқасы ма бәрібір.
Dialogue: 0,0:01:31.64,0:01:35.88,OP-JP,,0000,0000,0000,,Иә,мен сені дәл қазір көргім келеді.
Dialogue: 0,0:01:35.98,0:01:39.65,OP-JP,,0000,0000,0000,,Мен сізбен кездесіп,білгім келеді
Dialogue: 0,0:01:39.72,0:01:46.69,OP-JP,,0000,0000,0000,,Дүние принциптері Махаббаттың анықтамасы Бақыт категориялары
Dialogue: 0,0:01:46.76,0:01:50.56,OP-JP,,0000,0000,0000,,Мен сені әлі де білгім келеді
Dialogue: 0,0:01:50.73,0:01:54.40,OP-JP,,0000,0000,0000,,Бұл гала сияқты емес.
Dialogue: 0,0:01:54.40,0:01:59.54,OP-JP,,0000,0000,0000,,Қалай киінсең де,бәрібір бастамасы
Dialogue: 0,0:01:59.54,0:02:02.61,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
Dialogue: 0,0:02:06.55,0:02:10.65,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
Dialogue: 0,0:21:24.26,0:21:30.16,ED-JP,,0000,0000,0000,,Қарама-қарсы қарама-қарсы Қарама-қарсы Fortune
Dialogue: 0,0:21:32.51,0:21:38.74,ED-JP,,0000,0000,0000,,нағыз нағыз нағыз нағыз шын жүрек
Dialogue: 0,0:21:40.74,0:21:48.53,ED-JP,,0000,0000,0000,,Әрқашан қараңғыда жүресің, Не ойлайсың қызық.
Dialogue: 0,0:21:48.66,0:21:54.75,ED-JP,,0000,0000,0000,,Мен де бүгін сіздің профиліңізді қарап отырдым.
Dialogue: 0,0:21:55.02,0:22:01.32,ED-JP,,0000,0000,0000,,Жалғыз уайымдау – жай ғана қайғы
Dialogue: 0,0:22:01.43,0:22:09.17,ED-JP,,0000,0000,0000,,Қарама-қарсы сөздің қарама-қарсысы.
Dialogue: 0,0:22:09.30,0:22:15.85,ED-JP,,0000,0000,0000,,Сезімімді жеткізу қиын.
Dialogue: 0,0:22:15.96,0:22:23.83,ED-JP,,0000,0000,0000,,Сенің шын, шын, шынайы, жасыруға болмайтын шынайы сезімдерің
Dialogue: 0,0:22:23.89,0:22:27.81,ED-JP,,0000,0000,0000,,Мен оны естігім келеді
Dialogue: 0,0:22:27.84,0:22:32.60,ED-JP,,0000,0000,0000,,Бүгін тағы дірілдеп тұр
