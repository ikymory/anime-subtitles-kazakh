Dialogue: 0,0:02:16.41,0:02:17.94,staff,,0000,0000,0000,,Бұл субтитр субтитрлер мен субтитрлердің тіркесімі болып табылады.
Dialogue: 0,0:01:02.41,0:01:03.52,OP-JP,,0000,0000,0000,,Кеше анау қыз сондай мейірімді еді.
Dialogue: 0,0:01:03.52,0:01:06.89,OP-JP,,0000,0000,0000,,Кеше анау қыз сондай мейірімді еді.
Dialogue: 0,0:01:06.60,0:01:09.54,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
Dialogue: 0,0:01:09.92,0:01:11.22,OP-JP,,0000,0000,0000,,Бұл менің ниетім емес.
Dialogue: 0,0:01:11.22,0:01:14.39,OP-JP,,0000,0000,0000,,Бұл менің ниетім емес.
Dialogue: 0,0:01:13.87,0:01:16.69,OP-JP,,0000,0000,0000,,Мен сен болуым керек сияқты
