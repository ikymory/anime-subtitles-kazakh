Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:13.49,0:01:14.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:33.38,0:01:34.42,Default,,0,0,0,,Эй Кино
Dialogue: 0,0:01:34.55,0:01:36.63,Default,,0,0,0,,Бұл елде емес сияқты...
Dialogue: 0,0:01:36.76,0:01:38.05,Default,,0,0,0,,Сіз шынымен елге кірдіңіз бе?
Dialogue: 0,0:01:38.47,0:01:39.55,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:01:39.68,0:01:42.06,Default,,0,0,0,,Сіз жаңа ғана қамал қабырғасынан өткен жоқсыз ба?
Dialogue: 0,0:01:42.68,0:01:46.94,Default,,0,0,0,,Бұл ел өте дамыған және зәулім ғимараттары көп...
Dialogue: 0,0:01:47.06,0:01:50.15,Default,,0,0,0,,Бұл әдемі, таза ел деп естідім.
Dialogue: 0,0:01:50.27,0:01:52.23,Default,,0,0,0,,Бұл мүлдем ақымақтық
Dialogue: 0,0:01:52.36,0:01:53.73,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:03.20,0:02:04.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:36.23,0:02:37.90,Default,,0,0,0,,Уау! а!
Dialogue: 0,0:02:38.74,0:02:39.99,Default,,0,0,0,,Кешіріңіз Гермес
Dialogue: 0,0:02:40.11,0:02:41.36,Default,,0,0,0,,О, құдайым
Dialogue: 0,0:02:41.49,0:02:44.08,Default,,0,0,0,,Кино атанған адам орнынан тұрады деп ойлау.
Dialogue: 0,0:02:44.99,0:02:47.79,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:02:49.25,0:02:50.54,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:02:50.67,0:02:53.67,Default,,0,0,0,,Kino Шамасы, негізгі бүйірлік ілінісу жұлдызшасының қалақшасы...
Dialogue: 0,0:02:53.79,0:02:55.71,Default,,0,0,0,,Мен көріп тұрмын, ол сынған сияқты.
Dialogue: 0,0:02:56.92,0:03:00.38,Default,,0,0,0,,Мен ерініп кетіп, қатты жылдамдықпен айналдыра бердім.
Dialogue: 0,0:03:00.51,0:03:02.14,Default,,0,0,0,,Оны бір жерде жөндеу керек
Dialogue: 0,0:03:02.26,0:03:04.97,Default,,0,0,0,,Бұл елден кетейік. Мұнда ештеңе жоқ.
Dialogue: 0,0:03:05.10,0:03:08.68,Default,,0,0,0,,Жолдан сәл әрі қарай жүрейік.
Dialogue: 0,0:03:09.27,0:03:10.94,Default,,0,0,0,,Көпір болуы мүмкін
Dialogue: 0,0:03:11.06,0:03:12.56,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:03:23.74,0:03:25.28,Default,,0,0,0,,Уау
Dialogue: 0,0:03:29.41,0:03:30.50,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:03:30.62,0:03:33.75,Default,,0,0,0,,Көрдім, бұл жалған емес еді.
Dialogue: 0,0:03:50.23,0:03:51.60,Default,,0,0,0,,Сіз саяхатшысыз ба?
Dialogue: 0,0:03:52.48,0:03:53.60,Default,,0,0,0,,Иә
Dialogue: 0,0:03:53.90,0:03:57.19,Default,,0,0,0,,Мен Киномын, ал бұл Гермес
Dialogue: 0,0:03:57.32,0:03:58.86,Default,,0,0,0,,Мен 3 күн қалғым келеді.
Dialogue: 0,0:03:59.36,0:04:00.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:00.74,0:04:03.86,Default,,0,0,0,,Өтінемін, 3 күн емес, ұзақ уақыт тұрыңыз.
Dialogue: 0,0:04:04.45,0:04:05.82,Default,,0,0,0,,Сәлеметсіз бе, және...
Dialogue: 0,0:04:05.95,0:04:08.16,Default,,0,0,0,,Мен осы Герместі жөндегім келеді.
Dialogue: 0,0:04:08.28,0:04:10.75,Default,,0,0,0,,Ілініс механизмі тозған.
Dialogue: 0,0:04:10.87,0:04:13.41,Default,,0,0,0,,Әрине мен саған көмектесемін.
Dialogue: 0,0:04:13.54,0:04:15.54,Default,,0,0,0,,Қалаға кіру үшін -
Dialogue: 0,0:04:15.67,0:04:18.42,Default,,0,0,0,,Екеуің де таза болуың керек.
Dialogue: 0,0:04:19.21,0:04:20.51,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:04:30.31,0:04:31.22,Default,,0,0,0,,Уау
Dialogue: 0,0:04:31.56,0:04:32.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:36.56,0:04:37.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:43.95,0:04:46.32,Default,,0,0,0,,А...
Dialogue: 0,0:04:47.49,0:04:48.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:53.91,0:04:55.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:13.39,0:05:15.06,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:05:21.44,0:05:22.40,Default,,0,0,0,,Кино!
Dialogue: 0,0:05:22.53,0:05:25.82,Default,,0,0,0,,Уау, Гермес те жылтыр.
Dialogue: 0,0:05:25.95,0:05:27.61,Default,,0,0,0,,Мен ілініс механизмін жөндедім.
Dialogue: 0,0:05:27.74,0:05:29.07,Default,,0,0,0,,Резервуар да толы.
Dialogue: 0,0:05:29.70,0:05:32.12,Default,,0,0,0,,Бірақ сору жүйесін қараңыз.
Dialogue: 0,0:05:32.24,0:05:34.45,Default,,0,0,0,,Осыған ұқсас нәрсе қоса берілген
Dialogue: 0,0:05:34.79,0:05:37.71,Default,,0,0,0,,Пайдаланылған газдарды тазарту құрылғысы және дыбыс өшіргіш
Dialogue: 0,0:05:38.75,0:05:42.71,Default,,0,0,0,,Бірақ қазір қаланың кез келген жеріне бара аласыз.
Dialogue: 0,0:05:43.34,0:05:46.88,Default,,0,0,0,,Шынында да зәулім ғимараттар қаласы болған
Dialogue: 0,0:05:47.43,0:05:51.26,Default,,0,0,0,,Мұнда біздің еліміздің тұрғындарының көпшілігі тұрады.
Dialogue: 0,0:05:52.01,0:05:55.35,Default,,0,0,0,,А... бұл карта.
Dialogue: 0,0:05:59.65,0:06:01.15,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:08.82,0:06:14.24,Default,,0,0,0,,Халықтың көпшілігі десең, сол шөл далада біреу тұрады.
Dialogue: 0,0:06:15.08,0:06:16.58,Default,,0,0,0,,Сіз қылмыс жасаған адамсыз ба?
Dialogue: 0,0:06:16.79,0:06:20.67,Default,,0,0,0,,Жоқ, бұл біздің арамыздағы элита.
Dialogue: 0,0:06:20.79,0:06:22.84,Default,,0,0,0,,Шөлді кім өңдеп жатыр?
Dialogue: 0,0:06:22.96,0:06:25.67,Default,,0,0,0,,Осындай әдемі жерде тұруға бола ма?
Dialogue: 0,0:06:27.09,0:06:28.05,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:06:29.26,0:06:34.06,Default,,0,0,0,,Бұл сыртқы дүниедегі қоздырғыштардан оқшауланған таза кеңістік.
Dialogue: 0,0:06:34.18,0:06:36.18,Default,,0,0,0,,Бірақ дәл сол себепті—
Dialogue: 0,0:06:36.31,0:06:40.06,Default,,0,0,0,,Нағыз топырақ пен күн нұрындағы өмірді аңсаймын.
Dialogue: 0,0:06:40.81,0:06:46.11,Default,,0,0,0,,Пионер тобы дене және мәдени қабілеттері тамаша отбасылардан тұрады.
Dialogue: 0,0:06:46.78,0:06:48.57,Default,,0,0,0,,Мен қатты қызғанамын.
Dialogue: 0,0:06:50.07,0:06:53.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:53.32,0:06:55.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:57.12,0:06:59.33,Default,,0,0,0,,Не болды? біртүрлі дауыс шығару
Dialogue: 0,0:06:59.71,0:07:04.00,Default,,0,0,0,,Қызық, сыртта жүрсем де дауысым жаңғырық.
Dialogue: 0,0:07:04.13,0:07:06.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:06.42,0:07:11.43,Default,,0,0,0,,(жаңғырған дыбыс)
Dialogue: 0,0:07:19.60,0:07:22.52,Default,,0,0,0,,Бір адам, бір моторрад...
Dialogue: 0,0:07:22.65,0:07:24.94,Default,,0,0,0,,Кино және Гермес мырзаның тұру шығындары:
Dialogue: 0,0:07:25.06,0:07:28.86,Default,,0,0,0,,Біз барлығын осы қонақүйде сақтаймыз, сондықтан бізден кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:07:29.32,0:07:30.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.36,0:07:33.78,Default,,0,0,0,,Керемет! Барлығы тегін бе? Алақай!
Dialogue: 0,0:07:35.95,0:07:36.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:40.91,0:07:41.96,Default,,0,0,0,,Бұл тамаша көрініс.
Dialogue: 0,0:07:42.08,0:07:44.96,Default,,0,0,0,,Иә, бірақ біртүрлі нәрсе.
Dialogue: 0,0:07:45.46,0:07:46.96,Default,,0,0,0,,Не? (есіктің ашылған дыбысы)
Dialogue: 0,0:07:47.09,0:07:49.34,Default,,0,0,0,,Мен түсінбеймін... (Есік жабылған дыбыс)
Dialogue: 0,0:07:49.46,0:07:52.51,Default,,0,0,0,,Сондай-ақ, бұл қалашықта ерекше иіс бар.
Dialogue: 0,0:07:52.63,0:07:54.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:54.14,0:07:55.30,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:07:56.30,0:07:59.93,Default,,0,0,0,,Дезинфекциялаушы заттың иісі бар...
Dialogue: 0,0:08:00.06,0:08:02.35,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:08:02.48,0:08:03.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:03.52,0:08:08.52,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:08:12.74,0:08:14.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:15.82,0:08:18.16,Default,,0,0,0,,Сәлем саяхатшы
Dialogue: 0,0:08:18.28,0:08:21.45,Default,,0,0,0,,Мен бұл жердің иесімін, ал әйелім көрші.
Dialogue: 0,0:08:21.91,0:08:23.79,Default,,0,0,0,,А... сәлем
Dialogue: 0,0:08:25.37,0:08:29.84,Default,,0,0,0,,Негізі мен сізден бірнәрсе сұрайын деп едім...
Dialogue: 0,0:08:29.96,0:08:32.05,Default,,0,0,0,,Менің тұру ақысын төлеңіз.
Dialogue: 0,0:08:32.17,0:08:34.09,Default,,0,0,0,,дейсіз бе? сурет?
Dialogue: 0,0:08:34.80,0:08:38.89,Default,,0,0,0,,Көптен бері ауырып жүрген қызымыз бар.
Dialogue: 0,0:08:39.01,0:08:42.18,Default,,0,0,0,,Ертең түсте уақыт болса...
Dialogue: 0,0:08:42.31,0:08:46.77,Default,,0,0,0,,Қызыңызға сапарыңыздың тарихын айтып бере аласыз ба?
Dialogue: 0,0:08:46.90,0:08:47.94,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:48.94,0:08:52.24,Default,,0,0,0,,Құрметті саяхатшы, өтінемін
Dialogue: 0,0:08:54.24,0:08:56.86,Default,,0,0,0,,Жарайды, ертең түскі ас.
Dialogue: 0,0:08:56.99,0:08:58.41,Default,,0,0,0,,Қонақ үй ақысы тегін.
Dialogue: 0,0:08:58.53,0:08:59.53,Default,,0,0,0,,Хаха…
Dialogue: 0,0:09:25.77,0:09:27.60,Default,,0,0,0,,Бұл қаланың соңы.
Dialogue: 0,0:09:28.69,0:09:31.44,Default,,0,0,0,,Қызық, бұл қалашықта да ергежейлілер бар ма?
Dialogue: 0,0:09:32.28,0:09:34.19,Default,,0,0,0,,Бұл бөлу.
Dialogue: 0,0:09:34.32,0:09:35.44,Default,,0,0,0,,Бөлу?
Dialogue: 0,0:09:37.78,0:09:41.16,Default,,0,0,0,,Мұнда тұратындар өздерін тар сезінбес үшін.
Dialogue: 0,0:09:41.28,0:09:42.87,Default,,0,0,0,,Сахналанған.
Dialogue: 0,0:09:42.99,0:09:44.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:55.30,0:09:57.09,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:10:08.52,0:10:10.23,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:10:13.23,0:10:16.44,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Көптен күткендер үшін
Dialogue: 0,0:10:26.66,0:10:30.58,Default,,0,0,0,,Сәлеметсіз бе, мен Киномын, бұл менің серіктесім Гермес.
Dialogue: 0,0:10:30.71,0:10:31.92,Default,,0,0,0,,Барлығыңызға сәлем!
Dialogue: 0,0:10:32.13,0:10:34.25,Default,,0,0,0,,Менің атым – Инерция.
Dialogue: 0,0:10:34.38,0:10:37.17,Default,,0,0,0,,Танысқаныма қуаныштымын, Кино мырза, Гермес мырза
Dialogue: 0,0:10:37.30,0:10:39.84,Default,,0,0,0,,Мен әкем мен шешемнен естідім.
Dialogue: 0,0:10:40.09,0:10:42.35,Default,,0,0,0,,Мен осы бөлмеге дейін бардым...
Dialogue: 0,0:10:45.10,0:10:46.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:52.65,0:10:53.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.86,0:10:57.74,Default,,0,0,0,,Мен моторрад мінетін саяхатшымын деп естідім.
Dialogue: 0,0:10:57.86,0:11:00.82,Default,,0,0,0,,Мен сені жабайырақ деп ойладым.
Dialogue: 0,0:11:01.57,0:11:03.37,Default,,0,0,0,,Адамдар көрінгендей емес.
Dialogue: 0,0:11:03.74,0:11:04.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:05.58,0:11:07.24,Default,,0,0,0,,«Адамдар көрінгендей емес»
Dialogue: 0,0:11:07.37,0:11:08.20,Default,,0,0,0,,Иә, бұл!
Dialogue: 0,0:11:08.33,0:11:10.79,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:11:10.92,0:11:13.88,Default,,0,0,0,,Ендеше саяхатымыз туралы сөйлесейік.
Dialogue: 0,0:11:14.34,0:11:16.75,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:11:52.79,0:11:55.29,Default,,0,0,0,,Менің ауруым туралы білесіз бе?
Dialogue: 0,0:11:55.75,0:11:59.76,Default,,0,0,0,,Иә, мен бұл бөлмеге келмес бұрын иесінен естідім.
Dialogue: 0,0:12:00.55,0:12:03.93,Default,,0,0,0,,Бұл елде ерте заманнан бері белгілі бір ықтималдық бар...
Dialogue: 0,0:12:04.05,0:12:06.47,Default,,0,0,0,,Жас болсын, кәрі болсын, ауырып қалуың мүмкін.
Dialogue: 0,0:12:06.60,0:12:10.89,Default,,0,0,0,,Ешқандай профилактикалық әдістер немесе арнайы дәрілер табылған жоқ.
Dialogue: 0,0:12:13.69,0:12:18.02,Default,,0,0,0,,Алайда олар жақында прогресті баяулататын дәріні тапты.
Dialogue: 0,0:12:18.73,0:12:23.49,Default,,0,0,0,,Жақын арада ем болатынына сенімдімін.
Dialogue: 0,0:12:24.03,0:12:27.03,Default,,0,0,0,,Иә, мен де соған сенемін.
Dialogue: 0,0:12:28.28,0:12:30.49,Default,,0,0,0,,Сауығыңнан кейін қайтадан мектепке барасың ба?
Dialogue: 0,0:12:30.62,0:12:32.96,Default,,0,0,0,,Иә, мен елге бара аламын.
Dialogue: 0,0:12:33.08,0:12:34.54,Default,,0,0,0,,Маған көп жұмыс істеу керек
Dialogue: 0,0:12:34.67,0:12:37.04,Default,,0,0,0,,Эй, сен сонда барғың келе ме?
Dialogue: 0,0:12:38.29,0:12:39.30,Default,,0,0,0,,Иә
Dialogue: 0,0:12:39.80,0:12:42.72,Default,,0,0,0,,Сіздің ата-анаңыз бұл туралы білмейді, солай ма?
Dialogue: 0,0:12:45.84,0:12:46.84,Default,,0,0,0,,Иә
Dialogue: 0,0:12:47.22,0:12:48.26,Default,,0,0,0,,Егіншілікпен айналысқыңыз келе ме?
Dialogue: 0,0:12:48.39,0:12:49.81,Default,,0,0,0,,Бұл да бар.
Dialogue: 0,0:12:49.93,0:12:53.60,Default,,0,0,0,,Одан да менің кездескім келетін адам бар.
Dialogue: 0,0:12:53.73,0:12:56.23,Default,,0,0,0,,Кездесіп, рахмет айтқым келген адам...
Dialogue: 0,0:12:56.35,0:12:57.86,Default,,0,0,0,,Сіз қандай адамсыз? Сіз қандай адамсыз?
Dialogue: 0,0:13:00.44,0:13:01.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:01.69,0:13:05.03,Default,,0,0,0,,Әкең мен анаңнан құпия сақта.
Dialogue: 0,0:13:05.15,0:13:08.32,Default,,0,0,0,,Иә, бұл жай ғана әңгіме.
Dialogue: 0,0:13:08.45,0:13:09.33,Default,,0,0,0,,Рюкай!
Dialogue: 0,0:13:20.50,0:13:23.59,Default,,0,0,0,,Осы бөлменің дәл үстінде бақылау бөлмесі бар.
Dialogue: 0,0:13:25.38,0:13:27.01,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,0:13:41.40,0:13:44.90,Default,,0,0,0,,Басыңды айналдыратын біртүрлі көрініс
Dialogue: 0,0:13:45.03,0:13:49.24,Default,,0,0,0,,Мен де басында солай болдым, қазір үйреніп қалдым.
Dialogue: 0,0:13:53.04,0:13:55.20,Default,,0,0,0,,Ол Рог есімді бала.
Dialogue: 0,0:13:55.33,0:14:00.00,Default,,0,0,0,,Қазір отбасымен пионер ауылында тұрып, егіншілікпен айналысады.
Dialogue: 0,0:14:01.04,0:14:03.00,Default,,0,0,0,,Сіз қашан кездестіңіз?
Dialogue: 0,0:14:03.59,0:14:05.21,Default,,0,0,0,,1 жыл бұрын
Dialogue: 0,0:14:05.34,0:14:10.26,Default,,0,0,0,,Ол осы ауруханаға Пионерлердің денсаулығын тексеру үшін келді.
Dialogue: 0,0:14:11.30,0:14:14.56,Default,,0,0,0,,Осында елге қарап тұрғанымда...
Dialogue: 0,0:14:15.72,0:14:18.27,Default,,0,0,0,,Кенет ол секіріп кетті...
Dialogue: 0,0:14:19.94,0:14:23.15,Default,,0,0,0,,Ол елге нұсқап, сонда жүгірді...
Dialogue: 0,0:14:23.73,0:14:27.15,Default,,0,0,0,,«Міне, мен сонда барамын!»
Dialogue: 0,0:14:29.36,0:14:31.66,Default,,0,0,0,,Мен дауыстап айқайладым.
Dialogue: 0,0:14:31.78,0:14:34.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:34.33,0:14:36.91,Default,,0,0,0,,Негізі мұнда келмеуі керек.
Dialogue: 0,0:14:37.04,0:14:38.75,Default,,0,0,0,,Мен таңдана қарап отырып,
Dialogue: 0,0:14:38.87,0:14:41.92,Default,,0,0,0,,Жауапты адамдар мені шымшып қала жаздады.
Dialogue: 0,0:14:42.04,0:14:43.59,Default,,0,0,0,,Мен мұны күтпеген жерден айттым.
Dialogue: 0,0:14:44.34,0:14:47.42,Default,,0,0,0,,Ол адам менің досым.
Dialogue: 0,0:14:48.22,0:14:50.26,Default,,0,0,0,,Ха ха ха... Мен істеймін!
Dialogue: 0,0:14:53.93,0:14:55.81,Default,,0,0,0,,Алаяқ және оның отбасы...
Dialogue: 0,0:14:55.93,0:15:00.14,Default,,0,0,0,,Біраз уақыттан кейін пионер отряды ретінде жолға шықтым.
Dialogue: 0,0:15:01.60,0:15:04.19,Default,,0,0,0,,Сонымен, сіз хат жазуды бастадыңыз.
Dialogue: 0,0:15:04.32,0:15:06.90,Default,,0,0,0,,Иә, бір-бірімізге қиындық тудырмас үшін.
Dialogue: 0,0:15:07.03,0:15:08.99,Default,,0,0,0,,Айына бір әріпті шешіңіз...
Dialogue: 0,0:15:09.45,0:15:13.49,Default,,0,0,0,,Үш ай бұрын хатта ауылдың тұңғышы дүниеге келген.
Dialogue: 0,0:15:14.28,0:15:18.50,Default,,0,0,0,,Екі ай бұрын, сіз тамақ ішіп жатқанда, қоңыздар ұшып кеткен.
Dialogue: 0,0:15:19.12,0:15:20.50,Default,,0,0,0,,Соңғы хатта...
Dialogue: 0,0:15:21.04,0:15:24.63,Default,,0,0,0,,Жылыжайдағы қызанақтар пісіп, бақытты көрінеді...
Dialogue: 0,0:15:25.09,0:15:27.88,Default,,0,0,0,,Армандарын жүзеге асыру үшін аянбай еңбек етеді.
Dialogue: 0,0:15:32.05,0:15:34.22,Default,,0,0,0,,Мен дәрі қабылдағанда...
Dialogue: 0,0:15:34.35,0:15:37.51,Default,,0,0,0,,Мен біраз уақыт ауырып тұрмын.
Dialogue: 0,0:15:37.89,0:15:40.85,Default,,0,0,0,,Сол кезде мен хатты оқыдым.
Dialogue: 0,0:15:41.23,0:15:43.10,Default,,0,0,0,,Өйткені бұл маған батылдық береді
Dialogue: 0,0:15:44.73,0:15:47.78,Default,,0,0,0,,Оны тез емдейтін дәрі бар деп үміттенемін.
Dialogue: 0,0:15:48.44,0:15:50.95,Default,,0,0,0,,Кино мырза Гермес мырза
Dialogue: 0,0:15:51.86,0:15:53.41,Default,,0,0,0,,Мен сенен бір жақсылық сұрайын деп едім.
Dialogue: 0,0:15:54.20,0:15:56.12,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:15:58.45,0:16:02.25,Default,,0,0,0,,Ережеге сәйкес, сіз тек Rogue-пен хат алмасуға болады.
Dialogue: 0,0:16:03.00,0:16:06.21,Default,,0,0,0,,Бірақ Роугтың хаты маған...
Dialogue: 0,0:16:06.34,0:16:08.63,Default,,0,0,0,,Құсқа арналған брошь
Dialogue: 0,0:16:09.42,0:16:11.63,Default,,0,0,0,,Мен саған сыйлық бергім келеді.
Dialogue: 0,0:16:12.97,0:16:14.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:15.59,0:16:17.68,Default,,0,0,0,,Бұл жерде аспанда құстар жоқ.
Dialogue: 0,0:16:17.81,0:16:20.14,Default,,0,0,0,,Иә, Кино және Гермес.
Dialogue: 0,0:16:20.27,0:16:23.19,Default,,0,0,0,,Сіз ұшқан құсты көрдіңіз бе?
Dialogue: 0,0:16:24.14,0:16:27.77,Default,,0,0,0,,Құстарды көргенде саяхатқа құмарлық пайда болады дейді.
Dialogue: 0,0:16:29.61,0:16:32.40,Default,,0,0,0,,Бұл жақсы. Сол сөз.
Dialogue: 0,0:16:33.11,0:16:35.20,Default,,0,0,0,,Оны өзіңіз барып көре аласыз.
Dialogue: 0,0:16:35.32,0:16:39.45,Default,,0,0,0,,Бірақ бұл карта. Қай жерде екенін айтсаңыз, мен сізге әкелемін.
Dialogue: 0,0:16:39.58,0:16:40.41,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:41.00,0:16:43.91,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:16:59.01,0:17:01.06,Default,,0,0,0,,Саяхатшы, абай болыңыз.
Dialogue: 0,0:17:01.18,0:17:02.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:03.02,0:17:06.31,Default,,0,0,0,,(Моторадо жүгіру дыбысы)
Dialogue: 0,0:17:06.44,0:17:08.73,Default,,0,0,0,,Мен сол картаны қайтардым, жақсы ма?
Dialogue: 0,0:17:09.36,0:17:11.28,Default,,0,0,0,,Жарайды, өйткені мен оны жақсы жаттап алдым.
Dialogue: 0,0:17:11.40,0:17:14.99,Default,,0,0,0,,Тағы 60 жүгіруден кейін сол жақта екі дөңес болуы керек.
Dialogue: 0,0:17:15.32,0:17:19.41,Default,,0,0,0,,Оның арғы жағында 42-мәдениет ауылы орналасқан.
Dialogue: 0,0:18:17.05,0:18:18.72,Default,,0,0,0,,Онда емес пе?
Dialogue: 0,0:18:28.10,0:18:29.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.20,0:18:39.86,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:18:43.24,0:18:46.20,Default,,0,0,0,,О, кездейсоқ...
Dialogue: 0,0:18:47.83,0:18:50.33,Default,,0,0,0,,Сіз кеше келген саяхатшысыз ба?
Dialogue: 0,0:18:52.33,0:18:55.00,Default,,0,0,0,,Дұрыс, мен Киномын, ал бұл Гермес.
Dialogue: 0,0:18:55.71,0:18:59.68,Default,,0,0,0,,Мен 3-ші арнайы гвардияның лейтенанты Коулмын.
Dialogue: 0,0:18:59.93,0:19:03.01,Default,,0,0,0,,Шекара болса, арғы жағында.Адасқансың ба?
Dialogue: 0,0:19:03.76,0:19:06.89,Default,,0,0,0,,Бұл ауылда ешкім тұрмайды ма?
Dialogue: 0,0:19:07.81,0:19:10.81,Default,,0,0,0,,Бұл қазірдің өзінде... қараусыз қалған пионер ауылы.
Dialogue: 0,0:19:11.40,0:19:12.48,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:19:12.60,0:19:16.73,Default,,0,0,0,,Кино бір жылдан бері осында тұратын адамнан сыйлықпен келді.
Dialogue: 0,0:19:18.07,0:19:19.57,Default,,0,0,0,,Сіздің мекен-жайыңыз қандай?
Dialogue: 0,0:19:19.70,0:19:20.90,Default,,0,0,0,,Мен Рог есімді баламын.
Dialogue: 0,0:19:26.12,0:19:28.95,Default,,0,0,0,,(Бест Джинст) Жақында болған Хосу оқиғасынан шабыт алған зұлымдар—
Dialogue: 0,0:19:29.08,0:19:32.29,Default,,0,0,0,,Бұл Коул. Бұл жерде күдікті адамдар жоқ.
Dialogue: 0,0:19:32.42,0:19:33.79,Default,,0,0,0,,Менің ойымша, сіз шекарадан шығып кеткенсіз.
Dialogue: 0,0:19:47.97,0:19:51.77,Default,,0,0,0,,Бұл Гермес, сізде қызықты пішін бар.
Dialogue: 0,0:20:18.46,0:20:20.96,Default,,0,0,0,,Өйткені, мені біреу бақылап тұрғандай болды.
Dialogue: 0,0:20:21.67,0:20:23.59,Default,,0,0,0,,Бұл иллюзия емес еді
Dialogue: 0,0:20:29.64,0:20:31.68,Default,,0,0,0,,Пошта бөлімшесіне қош келдіңіз
Dialogue: 0,0:20:32.85,0:20:36.27,Default,,0,0,0,,Ал, мен Кеноны ойнағанда, не болса да, тұрдым.
Dialogue: 0,0:20:36.40,0:20:38.69,Default,,0,0,0,,Сіз бұған мүлдем сене алмайсыз, солай емес пе?
Dialogue: 0,0:20:42.36,0:20:43.20,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:20:47.78,0:20:50.87,Default,,0,0,0,,Инерциядан Rogue-ке сыйлық.
Dialogue: 0,0:20:50.99,0:20:52.20,Default,,0,0,0,,Сіз оны жеткізесіз бе?
Dialogue: 0,0:21:02.38,0:21:05.68,Default,,0,0,0,,Рог алты ай бұрын қайтыс болды.
Dialogue: 0,0:21:05.80,0:21:09.30,Default,,0,0,0,,Нақтырақ айтсақ, оның өмірі қасақана жасалған.
Dialogue: 0,0:21:10.81,0:21:14.31,Default,,0,0,0,,Сондықтан біз мұны жеткізе алмаймыз.
Dialogue: 0,0:21:16.73,0:21:20.32,Default,,0,0,0,,Сіз Инерцияға жауап жаздыңыз.
Dialogue: 0,0:21:20.69,0:21:23.32,Default,,0,0,0,,Я... тезірек
Dialogue: 0,0:21:23.44,0:21:26.66,Default,,0,0,0,,Маған хат жібермеуіңізді өтініп хат жазуым керек еді.
Dialogue: 0,0:21:29.78,0:21:32.33,Default,,0,0,0,,Рог неге өлтірілді?
Dialogue: 0,0:21:33.70,0:21:37.33,Default,,0,0,0,,Сіз бұл елдегі ауру туралы білесіз.
Dialogue: 0,0:21:38.63,0:21:39.63,Default,,0,0,0,,Иә
Dialogue: 0,0:21:40.34,0:21:42.67,Default,,0,0,0,,Бұл ел бар күшін салады...
Dialogue: 0,0:21:42.80,0:21:45.59,Default,,0,0,0,,Мен ауруды жеңуге тырысамын...
Dialogue: 0,0:21:45.72,0:21:47.84,Default,,0,0,0,,Жануарлар тәжірибесінде шектеулер болды
Dialogue: 0,0:21:48.22,0:21:53.35,Default,,0,0,0,,Дәл осы кезде адам ағзасын қолданып арнайы препараттар жасау эксперименттері басталды.
Dialogue: 0,0:21:54.52,0:21:56.35,Default,,0,0,0,,Бұл пионер тобы
Dialogue: 0,0:21:57.14,0:22:01.36,Default,,0,0,0,,Пионерлер басқа туыстары жоқ сау адамдардан таңдалады.
Dialogue: 0,0:22:02.44,0:22:08.32,Default,,0,0,0,,Алты ай бұрын Рогтың отбасы эксперимент субъектісі болады деп шешілді.
Dialogue: 0,0:22:20.04,0:22:24.21,Default,,0,0,0,,Rogue шын мәнінде Инерцияның аяғында.
Dialogue: 0,0:22:25.30,0:22:30.26,Default,,0,0,0,,Қаланың жерасты патологиялық зертханасында шағын үлгі түрінде.
Dialogue: 0,0:22:34.97,0:22:38.14,Default,,0,0,0,,Бірақ Rogue ешқашан ит болған емес.
Dialogue: 0,0:22:38.27,0:22:41.19,Default,,0,0,0,,Аурудың дамуын бәсеңдететін препарат аяқталды!
Dialogue: 0,0:22:41.31,0:22:45.86,Default,,0,0,0,,Инерция жақын арада дәріден пайда таба алады.
Dialogue: 0,0:22:45.98,0:22:48.70,Default,,0,0,0,,Бұл ел үшін болды.
Dialogue: 0,0:22:48.82,0:22:51.57,Default,,0,0,0,,Сонымен, біз болашақта жалғастыра аламыз
Dialogue: 0,0:22:51.91,0:22:54.37,Default,,0,0,0,,Көп адамға көмектесу
Dialogue: 0,0:22:55.87,0:22:59.12,Default,,0,0,0,,Ең бастысы, сол балаға көмектесу үшін...
Dialogue: 0,0:23:01.21,0:23:04.84,Default,,0,0,0,,Бұл сізге арналған. Мен жеткізіп бердім.
Dialogue: 0,0:23:07.92,0:23:10.80,Default,,0,0,0,,Мен жауап жазуым керек.
Dialogue: 0,0:23:12.01,0:23:15.31,Default,,0,0,0,,Жарайды, кешірім сұрайтын кез келді.
Dialogue: 0,0:23:15.64,0:23:18.77,Default,,0,0,0,,Рахмет, Кино-сан, және...
Dialogue: 0,0:23:19.27,0:23:20.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:28.65,0:23:29.49,Default,,0,0,0,,Га
Dialogue: 0,0:23:38.33,0:23:40.21,Default,,0,0,0,,Сіз өте тынышсыз.
Dialogue: 0,0:23:42.62,0:23:43.46,Default,,0,0,0,,айтарлықтай
Dialogue: 0,0:24:28.09,0:24:31.67,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:24:48.73,0:24:49.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:56.16,0:24:57.41,Default,,0,0,0,,Я...
Dialogue: 0,0:25:24.85,0:25:28.15,Default,,0,0,0,,«Сыйлық үшін көп рахмет».
Dialogue: 0,0:25:28.98,0:25:31.90,Default,,0,0,0,,«Мен сенің ауылға өзіңді жақсы сезінгенде келгеніңді қалаймын».
Dialogue: 0,0:25:35.20,0:25:37.86,Default,,0,0,0,,«Ұзақ әңгіме айтайық»
Dialogue: 0,0:25:39.45,0:25:44.79,Default,,0,0,0,,(Инерцияның жылауы)
Dialogue: 0,0:25:49.92,0:25:53.13,Default,,0,0,0,,Эй, Кино, келесіде қай елге барғың келеді?
Dialogue: 0,0:25:54.05,0:25:55.01,Default,,0,0,0,,Дұрыс... Ах!
Dialogue: 0,0:25:55.01,0:25:55.80,Default,,0,0,0,,Дұрыс... Ах!
Dialogue: 0,0:25:55.01,0:25:55.80,Default,,0,0,0,,(Кондордың айқайы)
Dialogue: 0,0:25:55.80,0:25:59.72,Default,,0,0,0,,(Кондордың айқайы)
Dialogue: 0,0:26:03.10,0:26:07.48,Default,,0,0,0,,Маған барлық тұрғындардың бірге бақытты өмір сүргені ұнайды.
Dialogue: 0,0:26:07.60,0:26:11.06,Default,,0,0,0,,Шындықты көрмеген саяхатшы ешқашан бақытты болмайды Kino
Dialogue: 0,0:26:12.94,0:26:16.90,Default,,0,0,0,,Жарайды, қолыңнан басқа ештеңе келмесе де, мен дәмді тағамы бар жер алғым келеді.
Dialogue: 0,0:26:17.03,0:26:18.74,Default,,0,0,0,,Егер бәрі осы болса, онда әйтеуір
Dialogue: 0,0:26:26.91,0:26:31.92,Default,,0,0,0,,♪～
