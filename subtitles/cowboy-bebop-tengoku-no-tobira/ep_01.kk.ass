Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.95,0:00:39.33,Default,,0,0,0,,Ол жалғыз қалды.
Dialogue: 0,0:00:40.70,0:00:44.37,Default,,0,0,0,,Өзімнен басқа ешкіммен ойын ойнай алмаймын
Dialogue: 0,0:00:45.46,0:00:47.88,Default,,0,0,0,,Арманда өмір сүргендей...
Dialogue: 0,0:00:49.00,0:00:50.80,Default,,0,0,0,,Ол сондай адам еді.
Dialogue: 0,0:00:54.88,0:00:58.01,Default,,0,0,0,,Спайк, оян!
Dialogue: 0,0:00:58.14,0:00:59.55,Default,,0,0,0,,Олар бақытты өмір сүруге құқылы
Dialogue: 0,0:01:07.19,0:01:09.06,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:01:10.36,0:01:11.69,Default,,0,0,0,,Әлем бұл...
Dialogue: 0,0:01:11.82,0:01:15.32,Default,,0,0,0,,Қайнап жатқан қазанға түскендей.
Dialogue: 0,0:01:15.45,0:01:17.95,Default,,0,0,0,,Бұқтырылған еттің ішіндегісі балқып балқыған...
Dialogue: 0,0:01:18.07,0:01:21.79,Default,,0,0,0,,Қайсысы керемет, қайсысы жарамсыз?
Dialogue: 0,0:01:21.91,0:01:24.29,Default,,0,0,0,,Бұл бәрі бірге бұқтырылған.
Dialogue: 0,0:01:24.41,0:01:28.33,Default,,0,0,0,,Дегенмен, біз ешқашан ұмытпауымыз керек нәрселер бар.
Dialogue: 0,0:01:28.46,0:01:30.17,Default,,0,0,0,,Сіз оның не екенін білесіз бе?
Dialogue: 0,0:01:31.59,0:01:32.67,Default,,0,0,0,,Ет?
Dialogue: 0,0:01:33.42,0:01:35.13,Default,,0,0,0,,Барлығы осылай ойлайды.
Dialogue: 0,0:01:35.26,0:01:36.26,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:36.38,0:01:40.68,Default,,0,0,0,,Бұқтырылғанның негізінсіз бұқтырылған емес
Dialogue: 0,0:01:40.80,0:01:44.31,Default,,0,0,0,,Бірдей ингредиенттер тіпті карриге айналуы мүмкін.
Dialogue: 0,0:01:44.43,0:01:46.77,Default,,0,0,0,,Бұқтырылған ингредиенттер сол жақтағы сөреде.
Dialogue: 0,0:01:46.89,0:01:48.85,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:01:50.94,0:01:53.61,Default,,0,0,0,,Не деген уағызшы мен қарақшы.
Dialogue: 0,0:01:53.73,0:01:55.11,Default,,0,0,0,,Спайк Кеттік.
Dialogue: 0,0:01:55.69,0:01:57.95,Default,,0,0,0,,Біз үшеуміз. Артынан барамын.
Dialogue: 0,0:01:58.07,0:01:59.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:00.95,0:02:03.28,Default,,0,0,0,,Полицияны күтудің қажеті жоқ.
Dialogue: 0,0:02:03.41,0:02:06.16,Default,,0,0,0,,Мұндағы қауіпсіздік барлығын біледі.
Dialogue: 0,0:02:06.29,0:02:07.62,Default,,0,0,0,,Жеңіске жетіп, сол адамдардың өмірімен сол жараларды жазайық
Dialogue: 0,0:02:07.75,0:02:10.25,Default,,0,0,0,,Ренжи, тез істе.
Dialogue: 0,0:02:10.63,0:02:13.09,Default,,0,0,0,,Осы белгісі бар қауіпсіздік компаниялары
Dialogue: 0,0:02:13.42,0:02:15.55,Default,,0,0,0,,Мен мұнда қызметкер болдым.
Dialogue: 0,0:02:15.67,0:02:16.84,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:02:16.97,0:02:19.68,Default,,0,0,0,,Жұмыстан босатылып, жұмысын қарақшылыққа ауыстырды.
Dialogue: 0,0:02:19.80,0:02:21.18,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,0:02:21.30,0:02:22.64,Default,,0,0,0,,Ах ха
Dialogue: 0,0:02:22.76,0:02:23.56,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:02:23.68,0:02:24.51,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:02:24.64,0:02:25.47,Default,,0,0,0,,Қызықты ма?
Dialogue: 0,0:02:25.60,0:02:26.39,Default,,0,0,0,,Ах хахаха хаха
Dialogue: 0,0:02:26.52,0:02:27.77,Default,,0,0,0,,Қызық болар еді
Dialogue: 0,0:02:27.89,0:02:30.48,Default,,0,0,0,,Нихехахахахаха (сатушы) Ах хахахахахахаха
Dialogue: 0,0:02:30.60,0:02:32.23,Default,,0,0,0,,Бұл күлкі емес. (Сатушы) О, эй.
Dialogue: 0,0:02:36.57,0:02:40.41,Default,,0,0,0,,Ей, біз бүгін жабықпыз. Басқа жерге барыңыз.
Dialogue: 0,0:02:41.78,0:02:43.03,Default,,0,0,0,,Эй
Dialogue: 0,0:02:43.16,0:02:43.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:44.62,0:02:45.79,Default,,0,0,0,,Уау
Dialogue: 0,0:02:46.29,0:02:50.25,Default,,0,0,0,,Түсінсеңіз, осы ақша картасына ақшаны жылдам қосыңыз.
Dialogue: 0,0:02:50.42,0:02:51.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:52.96,0:02:55.25,Default,,0,0,0,,Эй, бұл кім?
Dialogue: 0,0:02:56.25,0:02:58.55,Default,,0,0,0,,Эй, сен мені естімейсің бе?
Dialogue: 0,0:02:59.13,0:03:01.22,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:03:04.26,0:03:07.31,Default,,0,0,0,,Эй, оны шешіп, тыңда.
Dialogue: 0,0:03:07.43,0:03:08.64,Default,,0,0,0,,О
Dialogue: 0,0:03:08.77,0:03:09.56,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:10.48,0:03:13.27,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:03:13.40,0:03:14.48,Default,,0,0,0,,Уау
Dialogue: 0,0:03:14.61,0:03:17.11,Default,,0,0,0,,А-а-а-а-а-а-а-а
Dialogue: 0,0:03:17.94,0:03:19.44,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:03:22.07,0:03:22.66,Default,,0,0,0,,Ах аа
Dialogue: 0,0:03:22.78,0:03:23.99,Default,,0,0,0,,...
Dialogue: 0,0:03:25.03,0:03:27.37,Default,,0,0,0,,ой-оу
Dialogue: 0,0:03:27.49,0:03:29.62,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:03:32.46,0:03:33.08,Default,,0,0,0,,Төбелер
Dialogue: 0,0:03:33.58,0:03:34.83,Default,,0,0,0,,О
Dialogue: 0,0:03:37.30,0:03:39.59,Default,,0,0,0,,Осы жігіттерге пончиктерді қалдырыңыз.
Dialogue: 0,0:03:39.71,0:03:41.97,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:03:42.51,0:03:44.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:44.89,0:03:45.76,Default,,0,0,0,,Ах
Dialogue: 0,0:03:45.89,0:03:47.26,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:48.14,0:03:48.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:49.06,0:03:50.56,Default,,0,0,0,,Ух-хэ-хэ-хэ
Dialogue: 0,0:03:50.81,0:03:51.77,Default,,0,0,0,,Қозғалма (әйел) Ах аа
Dialogue: 0,0:03:52.23,0:03:53.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:53.65,0:03:54.77,Default,,0,0,0,,Эй Джет
Dialogue: 0,0:03:55.15,0:03:56.11,Default,,0,0,0,,Не?
Dialogue: 0,0:03:56.23,0:03:58.23,Default,,0,0,0,,Сіз үш адам айттыңыз.
Dialogue: 0,0:03:58.36,0:04:00.32,Default,,0,0,0,,Мылтықты еденге лақтыру.
Dialogue: 0,0:04:00.44,0:04:03.07,Default,,0,0,0,,Жауды алдау үшін одақтастарыңыздан бастаңыз.
Dialogue: 0,0:04:03.20,0:04:04.82,Default,,0,0,0,,Алдаудың мәні неде?
Dialogue: 0,0:04:04.95,0:04:05.78,Default,,0,0,0,,Әй, тыңда.
Dialogue: 0,0:04:05.91,0:04:08.28,Default,,0,0,0,,Боқыңыздың көбі тым ұзақ.
Dialogue: 0,0:04:08.41,0:04:11.79,Default,,0,0,0,,Шулы. Бұл жігіттің өлгені дұрыс па?
Dialogue: 0,0:04:12.75,0:04:14.54,Default,,0,0,0,,Фуфуфуфу
Dialogue: 0,0:04:18.80,0:04:19.84,Default,,0,0,0,,Иә? (Әйел) Уф
Dialogue: 0,0:04:19.96,0:04:21.38,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:04:21.51,0:04:23.13,Default,,0,0,0,,Мына жігітті көрмейсің бе? (Әйел) Уф уф
Dialogue: 0,0:04:23.63,0:04:25.39,Default,,0,0,0,,Өкінішті, әже.
Dialogue: 0,0:04:25.64,0:04:28.60,Default,,0,0,0,,Біз полиция немесе күзетші емеспіз.
Dialogue: 0,0:04:28.72,0:04:32.31,Default,,0,0,0,,Азаматтардың өмірін қорғау міндеті жоқ.
Dialogue: 0,0:04:32.43,0:04:33.35,Default,,0,0,0,,Не?
Dialogue: 0,0:04:34.06,0:04:35.90,Default,,0,0,0,,Тек сәтсіздігіңізден бас тартыңыз.
Dialogue: 0,0:04:36.31,0:04:37.94,Default,,0,0,0,,Цк, ковбой?
Dialogue: 0,0:04:38.06,0:04:40.19,Default,,0,0,0,,Әй, эй, сен не айтып тұрсың?
Dialogue: 0,0:04:40.32,0:04:41.78,Default,,0,0,0,,Адам емес
Dialogue: 0,0:04:43.11,0:04:45.91,Default,,0,0,0,,Кя
Dialogue: 0,0:04:46.03,0:04:48.28,Default,,0,0,0,,Ах
Dialogue: 0,0:04:53.33,0:04:57.75,Default,,0,0,0,,Сен не ковбойсың?
Dialogue: 0,0:04:59.00,0:05:00.38,Default,,0,0,0,,Иә
Dialogue: 0,0:05:01.88,0:05:04.17,Default,,0,0,0,,Жай ғана сыйлы аңшы
Dialogue: 0,0:05:05.13,0:05:11.14,Default,,0,0,0,,♪～
Dialogue: 0,0:05:26.99,0:05:31.91,Default,,0,0,0,,♪Гумленді, миы өліп, шешім қабылдай алмайды
Dialogue: 0,0:05:32.16,0:05:37.21,Default,,0,0,0,,♪Намаз оқи алмайсың, жасыра алмайсың
Dialogue: 0,0:05:37.33,0:05:41.38,Default,,0,0,0,,♪Сіз салқын бола аласыз немесе жылай аласыз
Dialogue: 0,0:05:41.50,0:05:45.59,Default,,0,0,0,,♪Дұрыс істеме Мүлдем емес немесе дұрыс істе
Dialogue: 0,0:05:47.63,0:05:52.35,Default,,0,0,0,,♪Ешкім саған қарыз емес, ешкім кінәлі емес
Dialogue: 0,0:05:52.64,0:05:57.64,Default,,0,0,0,,♪Жаман гендер немесе ДНҚ үшін сақтаңыз
Dialogue: 0,0:05:57.98,0:06:02.11,Default,,0,0,0,,♪Ұжданыңыздан неге және қалай деп сұраңыз
Dialogue: 0,0:06:02.23,0:06:05.44,Default,,0,0,0,,♪Содан кейін жасаңыз, Қашан орындаңыз Бірақ, қазір жасаңыз
Dialogue: 0,0:06:07.36,0:06:12.20,Default,,0,0,0,,♪Тәтті торттар не болды?
Dialogue: 0,0:06:12.41,0:06:17.62,Default,,0,0,0,,♪Бәрі де кім жамбас?
Dialogue: 0,0:06:17.75,0:06:23.42,Default,,0,0,0,,♪Жер қыздары оңай
Dialogue: 0,0:06:23.96,0:06:26.34,Default,,0,0,0,,♪Сіз не істейсіз?
Dialogue: 0,0:06:26.46,0:06:28.63,Default,,0,0,0,,（Әй, одан жақсы сұрағаныңыз жөн）
Dialogue: 0,0:06:29.18,0:06:31.80,Default,,0,0,0,,♪A11 сен істеу керек, бақытты ақымақ,
Dialogue: 0,0:06:31.93,0:06:36.06,Default,,0,0,0,,♪ анаңнан сұра
Dialogue: 0,0:07:15.89,0:07:17.97,Default,,0,0,0,,Тез соқ, Джет.
Dialogue: 0,0:07:18.14,0:07:19.81,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:07:19.93,0:07:21.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:22.35,0:07:23.56,Default,,0,0,0,,Уф
Dialogue: 0,0:07:28.78,0:07:29.94,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:30.07,0:07:32.49,Default,,0,0,0,,Сіз өз суреттеріңізге біраз ой саласыз ба?
Dialogue: 0,0:07:32.61,0:07:34.20,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:07:34.49,0:07:37.33,Default,,0,0,0,,Тыңда, бұл не шоги?
Dialogue: 0,0:07:37.45,0:07:38.87,Default,,0,0,0,,100 қадамға дейін алға оқу -
Dialogue: 0,0:07:39.00,0:07:39.70,Default,,0,0,0,,Ең бірінші істеу керек қадам сізге түсінікті болады.
Dialogue: 0,0:07:39.70,0:07:41.62,Default,,0,0,0,,Ең бірінші істеу керек қадам сізге түсінікті болады.
Dialogue: 0,0:07:41.75,0:07:45.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:46.17,0:07:48.84,Default,,0,0,0,,Қарсыластың соққысы келген жерді соғу
Dialogue: 0,0:07:48.96,0:07:51.59,Default,,0,0,0,,Бұл шоги ойынының құпиясы.
Dialogue: 0,0:07:51.72,0:07:55.09,Default,,0,0,0,,Ойланбай жай ғана терген дұрыс.
Dialogue: 0,0:07:55.97,0:07:57.89,Default,,0,0,0,,Мен осында соққым келеді
Dialogue: 0,0:07:58.18,0:08:01.39,Default,,0,0,0,,Күту де шоги ережесі.
Dialogue: 0,0:08:01.68,0:08:04.60,Default,,0,0,0,,Ол өте лайықты адам.
Dialogue: 0,0:08:04.73,0:08:06.15,Default,,0,0,0,,Тыңда, Спайк.
Dialogue: 0,0:08:06.27,0:08:07.73,Default,,0,0,0,,Бұл шоги ...
Dialogue: 0,0:08:07.86,0:08:09.90,Default,,0,0,0,,Бұл сіздің тұлғаңызды көрсетеді
Dialogue: 0,0:08:10.11,0:08:12.40,Default,,0,0,0,,Әрқашан солай, көңіл күйі...
Dialogue: 0,0:08:12.53,0:08:13.82,Default,,0,0,0,,Сіз еріксіз әрекет етесіз, солай ма?
Dialogue: 0,0:08:13.95,0:08:15.16,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:08:15.57,0:08:18.49,Default,,0,0,0,,Ей, егер сол кезде барымташылар атылып кетсе...
Dialogue: 0,0:08:18.62,0:08:19.70,Default,,0,0,0,,Сіз не істеуді жоспарладыңыз?
Dialogue: 0,0:08:19.95,0:08:21.45,Default,,0,0,0,,Сол кезде, сол кезде
Dialogue: 0,0:08:21.58,0:08:23.25,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:08:23.54,0:08:28.13,Default,,0,0,0,,Бар болғаны 1,25 миллион сыйақы үшін тәуекел тым үлкен.
Dialogue: 0,0:08:28.25,0:08:32.47,Default,,0,0,0,,Сыйлыққа аңшы болу көрінгеннен әлдеқайда жалықтырады.
Dialogue: 0,0:08:32.59,0:08:37.09,Default,,0,0,0,,Мен сенімен біріккенге дейін менің өмірім тұрақты болды.
Dialogue: 0,0:08:37.26,0:08:38.35,Default,,0,0,0,,Ммммммм мм?
Dialogue: 0,0:08:41.47,0:08:42.73,Default,,0,0,0,,О
Dialogue: 0,0:08:43.10,0:08:44.48,Default,,0,0,0,,О, иә
Dialogue: 0,0:08:44.60,0:08:46.48,Default,,0,0,0,,Міне, мен де солай істеуді ойладым.
Dialogue: 0,0:08:46.60,0:08:48.06,Default,,0,0,0,,Спайк не болды?
Dialogue: 0,0:08:48.19,0:08:50.86,Default,,0,0,0,,(Спайктың тынысы)
Dialogue: 0,0:08:51.36,0:08:54.36,Default,,0,0,0,,Ашу ашу Миов Миау
Dialogue: 0,0:09:26.31,0:09:29.40,Default,,0,0,0,,♪～
Dialogue: 0,0:09:29.52,0:09:32.90,Default,,0,0,0,,♪Сіз екеуміз сөзге бәс тігеміз
Dialogue: 0,0:09:33.53,0:09:36.11,Default,,0,0,0,,♪Сен екеуміз дүниелерді кезіп жүрміз
Dialogue: 0,0:09:36.11,0:09:36.95,Default,,0,0,0,,♪Сен екеуміз дүниелерді кезіп жүрміз
Dialogue: 0,0:09:36.11,0:09:36.95,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:09:37.07,0:09:39.37,Default,,0,0,0,,Фэй Фэй, бұл үстел теннисі.
Dialogue: 0,0:09:39.74,0:09:43.45,Default,,0,0,0,,12-маршруттағы №8 автожол.
Dialogue: 0,0:09:43.58,0:09:45.20,Default,,0,0,0,,Мен қалаға бардым.
Dialogue: 0,0:09:45.83,0:09:48.54,Default,,0,0,0,,Жарайды, маған көлік пен сыйлықты жібер, Ред.
Dialogue: 0,0:09:48.67,0:09:49.67,Default,,0,0,0,,Ай Ай
Dialogue: 0,0:09:52.75,0:09:54.63,Default,,0,0,0,,Сіз кәмелетке толмағансыз ба?
Dialogue: 0,0:09:54.76,0:09:56.92,Default,,0,0,0,,Сіз балалардың сүйкімділігін жақсы білмейсіз, солай ма?
Dialogue: 0,0:09:58.72,0:10:00.18,Default,,0,0,0,,♪Маған сене аласыз ба?
Dialogue: 0,0:10:00.30,0:10:04.06,Default,,0,0,0,,♪Әлі де қолында тапаншамен әдемі отыр
Dialogue: 0,0:10:04.18,0:10:07.23,Default,,0,0,0,,♪Сені жақсы көру үшін өмір сүрсең, сен менің адамым боласың ба?
Dialogue: 0,0:10:07.35,0:10:11.06,Default,,0,0,0,,♪Өтінсем, Жалынсам
Dialogue: 0,0:10:11.19,0:10:16.61,Default,,0,0,0,,♪Өтінемін, өтінемін, мені қанағаттандыра аласыз ба?
Dialogue: 0,0:10:16.74,0:10:20.36,Default,,0,0,0,,♪Бұл ғарыштық батылдықта кез келген нәрсе болады
Dialogue: 0,0:10:20.49,0:10:23.45,Default,,0,0,0,,♪Кез келген нәрсе болады, сондықтан сақ болыңыз
Dialogue: 0,0:10:23.91,0:10:28.33,Default,,0,0,0,,♪Өтірігіңе жүрегімнің соғуын сездің бе
Dialogue: 0,0:10:28.46,0:10:32.59,Default,,0,0,0,,♪Тыңдашы менің тəтті махаббатымды
Dialogue: 0,0:10:57.90,0:10:58.90,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:10:59.03,0:11:00.11,Default,,0,0,0,,Га
Dialogue: 0,0:11:20.72,0:11:22.09,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:22.22,0:11:22.84,Default,,0,0,0,,Га
Dialogue: 0,0:12:15.27,0:12:17.65,Default,,0,0,0,,Қазір CBC News уақыты.
Dialogue: 0,0:12:17.77,0:12:19.94,Default,,0,0,0,,Бүгінгі басты жаңалықтардан бастаңыз
Dialogue: 0,0:12:20.07,0:12:21.32,Default,,0,0,0,,Бүгін сағат 10.00-ден кейін.
Dialogue: 0,0:12:21.44,0:12:23.24,Default,,0,0,0,,Альба қаласының астанасы 7-ші экспресс жолы -
Dialogue: 0,0:12:23.36,0:12:24.82,Default,,0,0,0,,Бұл Red Hills маңында болды.
Dialogue: 0,0:12:24.95,0:12:26.45,Default,,0,0,0,,Автоцистернаның жарылыс оқиғасы...
Dialogue: 0,0:12:26.57,0:12:29.95,Default,,0,0,0,,72 адам қаза тауып, 425 адам ауыр жарақат алды.
Dialogue: 0,0:12:30.08,0:12:31.50,Default,,0,0,0,,Бұл апат болды.
Dialogue: 0,0:12:31.62,0:12:34.75,Default,,0,0,0,,Енді оқиға орнынан тілші Райли репортаж жасайды.
Dialogue: 0,0:12:35.29,0:12:37.29,Default,,0,0,0,,Иә, бұл сайт.
Dialogue: 0,0:12:37.42,0:12:39.80,Default,,0,0,0,,Қазіргі уақытта апатқа ұшыраған көлікті алып тастау жұмыстары жүргізілуде.
Dialogue: 0,0:12:39.92,0:12:42.26,Default,,0,0,0,,Учаскеде тазалау жұмыстары жүргізілуде
Dialogue: 0,0:12:42.63,0:12:46.34,Default,,0,0,0,,Апат болғаннан кейін бірден апаттан 3 км қашықтықта болған адамдар...
Dialogue: 0,0:12:46.47,0:12:49.56,Default,,0,0,0,,Есін жоғалту, бірінен соң бірі құлау сияқты жағдайлар...
Dialogue: 0,0:12:49.68,0:12:52.81,Default,,0,0,0,,Бір кезде ауданда үрей биледі.
Dialogue: 0,0:12:52.93,0:12:55.39,Default,,0,0,0,,Бірақ қазір апаттан үш сағат өтті...
Dialogue: 0,0:12:55.52,0:12:57.65,Default,,0,0,0,,Ақыры тыныштала бастады.
Dialogue: 0,0:12:57.98,0:13:00.23,Default,,0,0,0,,Автоцистернаға не тиелген...
Dialogue: 0,0:13:00.36,0:13:02.61,Default,,0,0,0,,Бұл улы заттардың болуы мүмкін дегенді білдіре ме?
Dialogue: 0,0:13:03.11,0:13:07.24,Default,,0,0,0,,Иә, полицияның мәліметі бойынша, қандай да бір химиялық заттың әсерінен болған жарылыс.
Dialogue: 0,0:13:07.36,0:13:10.12,Default,,0,0,0,,Немесе тіпті биологиялық қаруды қолдануды қарастырсақ...
Dialogue: 0,0:13:10.24,0:13:12.24,Default,,0,0,0,,Сайттың жанына кіруге тыйым салынады.
Dialogue: 0,0:13:12.91,0:13:15.75,Default,,0,0,0,,Жарылыстың себебін анықтай алдыңыз ба?
Dialogue: 0,0:13:15.87,0:13:18.75,Default,,0,0,0,,Қазіргі уақытта мәліметтер әлі белгісіз.
Dialogue: 0,0:13:19.04,0:13:22.13,Default,,0,0,0,,Бұл жай ғана апатқа себепкер болған автоцистерна.
Dialogue: 0,0:13:22.25,0:13:24.13,Default,,0,0,0,,Ұрлық туралы хаттама толтырылды.
Dialogue: 0,0:13:24.26,0:13:27.55,Default,,0,0,0,,Біреуден биотерроризм жасау мүмкіндігі жоғары...
Dialogue: 0,0:13:27.68,0:13:29.68,Default,,0,0,0,,Полиция қарап тұрған сияқты.
Dialogue: 0,0:13:29.80,0:13:31.51,Default,,0,0,0,,Бұл сайтта болды.
Dialogue: 0,0:13:32.01,0:13:34.64,Default,,0,0,0,,Бұл жаңалық барлық жерде.
Dialogue: 0,0:13:35.39,0:13:36.77,Default,,0,0,0,,Дежа вю мүмкін
Dialogue: 0,0:13:36.89,0:13:37.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.98,0:13:40.15,Default,,0,0,0,,Мен де кеше түнде сенімдімін...
Dialogue: 0,0:13:40.27,0:13:42.61,Default,,0,0,0,,Менің ойымша, бұл шыныаяқ рамен болды.
Dialogue: 0,0:13:43.28,0:13:45.15,Default,,0,0,0,,Жартылай ұйықтап жатқан нәрсені айтпа
Dialogue: 0,0:13:45.28,0:13:49.07,Default,,0,0,0,,Кеше және бұрнағы күні мен 3 рет кесе рамен жеген шығармын.
Dialogue: 0,0:13:49.20,0:13:49.91,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:13:50.03,0:13:53.24,Default,,0,0,0,,Иә, мен бұл түс деп ойладым.
Dialogue: 0,0:13:53.37,0:13:55.83,Default,,0,0,0,,Басқа нәрселерге қарсы болмасаңыз, әртүрлі нұсқалар бар.
Dialogue: 0,0:13:55.96,0:13:58.08,Default,,0,0,0,,Тостаған удон және кесе соба
Dialogue: 0,0:13:58.21,0:14:00.67,Default,,0,0,0,,Жіпті тартқанда 5 секундта ыстық болады.
Dialogue: 0,0:14:00.79,0:14:02.50,Default,,0,0,0,,Сондай-ақ шыныаяқ суши...
Dialogue: 0,0:14:02.63,0:14:05.26,Default,,0,0,0,,Жарамдылық мерзімі бір жылға жуық уақыт өтті.
Dialogue: 0,0:14:05.38,0:14:06.34,Default,,0,0,0,,Егер бұл жақсы болса.
Dialogue: 0,0:14:06.47,0:14:08.38,Default,,0,0,0,,Мен оны аламын, бір.
Dialogue: 0,0:14:12.76,0:14:16.64,Default,,0,0,0,,(раменнің шырылдаған дыбысы)
Dialogue: 0,0:14:18.85,0:14:21.65,Default,,0,0,0,,Адам тек көмірсулармен қоректенеді...
Dialogue: 0,0:14:21.77,0:14:23.23,Default,,0,0,0,,Менің ойымша, бұл жақсы емес.
Dialogue: 0,0:14:23.69,0:14:25.94,Default,,0,0,0,,Сізге ақуыз керек, солай ма?
Dialogue: 0,0:14:26.07,0:14:27.90,Default,,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:14:28.03,0:14:29.66,Default,,0,0,0,,Ет дәмді дейді.
Dialogue: 0,0:14:30.57,0:14:32.70,Default,,0,0,0,,Бұл жолы кішкентай шабақ болудың орнына...
Dialogue: 0,0:14:32.83,0:14:34.87,Default,,0,0,0,,Сіз үлкенірек балық ұстайсыз деп үміттенемін.
Dialogue: 0,0:14:35.58,0:14:37.00,Default,,0,0,0,,(раменнің шырылдаған дыбысы)
Dialogue: 0,0:14:39.50,0:14:41.71,Default,,0,0,0,,Эй Фей, ол туралы не деуге болады?
Dialogue: 0,0:14:41.83,0:14:44.84,Default,,0,0,0,,Мен олай ойламаймын.Мені тыңдайсың ба?
Dialogue: 0,0:14:45.21,0:14:47.72,Default,,0,0,0,,Мен кездейсоқ хакер болғандықтан, мен мұны ат жарысында болған кезде жасаймын.
Dialogue: 0,0:14:47.84,0:14:50.80,Default,,0,0,0,,Оңай ұстап алады деп айтпадың ба?
Dialogue: 0,0:14:50.93,0:14:53.55,Default,,0,0,0,,Біртүрлі жарылысқа тап болдым.
Dialogue: 0,0:14:53.68,0:14:55.89,Default,,0,0,0,,Бір кітап
Dialogue: 0,0:14:56.10,0:14:59.14,Default,,0,0,0,,Жылқылар жеңіледі, бұл жаман емес.
Dialogue: 0,0:14:59.27,0:15:01.81,Default,,0,0,0,,Мынау
Dialogue: 0,0:15:01.94,0:15:03.73,Default,,0,0,0,,Эй, сен осында болдың ба?
Dialogue: 0,0:15:03.86,0:15:07.28,Default,,0,0,0,,Әй, бұл өте оқиға болды.
Dialogue: 0,0:15:07.40,0:15:10.15,Default,,0,0,0,,Иә? Хм, вирус?
Dialogue: 0,0:15:10.28,0:15:11.41,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:11.78,0:15:14.83,Default,,0,0,0,,Химиялық қару, иә?
Dialogue: 0,0:15:14.95,0:15:16.74,Default,,0,0,0,,Хмм?
Dialogue: 0,0:15:17.54,0:15:19.83,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:15:19.96,0:15:21.46,Default,,0,0,0,,Балалар
Dialogue: 0,0:15:21.58,0:15:22.67,Default,,0,0,0,,Тек Айнға
Dialogue: 0,0:15:22.79,0:15:25.46,Default,,0,0,0,,Ен Гачо Бай Кин Маан
Dialogue: 0,0:15:25.59,0:15:27.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:28.21,0:15:29.80,Default,,0,0,0,,Ой, тоқта, тоқта
Dialogue: 0,0:15:30.13,0:15:32.38,Default,,0,0,0,,Марс үкіметі кінәлі...
Dialogue: 0,0:15:32.51,0:15:35.39,Default,,0,0,0,,300 миллион оолонг көлеміндегі жүлдені жариялау.
Dialogue: 0,0:15:35.55,0:15:36.76,Default,,0,0,0,,300 миллион?
Dialogue: 0,0:15:36.89,0:15:38.14,Default,,0,0,0,,Не?
Dialogue: 0,0:16:05.88,0:16:06.84,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:16:06.96,0:16:08.50,Default,,0,0,0,,Солай ма? (1-талдау тобы) Ах.
Dialogue: 0,0:16:13.34,0:16:16.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:16.39,0:16:17.39,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:16:17.51,0:16:20.98,Default,,0,0,0,,Мен мұндай белгілерді бұрын-соңды көрген емеспін.
Dialogue: 0,0:16:21.10,0:16:24.69,Default,,0,0,0,,Ми қысымының жоғарылау симптомдары науқастардың көпшілігінде байқалады, бірақ...
Dialogue: 0,0:16:24.81,0:16:29.07,Default,,0,0,0,,Сыртқы жарақат жоқ Себеп толық белгісіз.
Dialogue: 0,0:16:29.40,0:16:31.65,Default,,0,0,0,,Мен енді түсінбеймін.
Dialogue: 0,0:16:31.78,0:16:33.07,Default,,0,0,0,,әкелу кезінде —
Dialogue: 0,0:16:33.20,0:16:36.99,Default,,0,0,0,,Барлық науқастарда лимфоциттер саны жоғарылаған...
Dialogue: 0,0:16:37.12,0:16:40.04,Default,,0,0,0,,Қазір барлығы қалыпты жағдайға оралды.
Dialogue: 0,0:16:40.16,0:16:42.16,Default,,0,0,0,,Симптомдар күшейе түсуде
Dialogue: 0,0:16:42.58,0:16:45.37,Default,,0,0,0,,Оның шешек пен Эболадан айырмашылығы бар ма?
Dialogue: 0,0:16:45.62,0:16:48.46,Default,,0,0,0,,Нерв агенті немесе бар вирус емес
Dialogue: 0,0:16:48.59,0:16:50.84,Default,,0,0,0,,Бірінші кезекте үкім шығару мүмкін емес.
Dialogue: 0,0:16:50.96,0:16:52.59,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:16:52.72,0:16:54.84,Default,,0,0,0,,Ешбір із табылмады
Dialogue: 0,0:16:54.97,0:16:58.22,Default,,0,0,0,,Тіпті мәйіттен ештеңе шықпайды.
Dialogue: 0,0:16:59.81,0:17:03.98,Default,,0,0,0,,Бұл вирустың жаңа түрі болуы мүмкін бе?
Dialogue: 0,0:17:04.10,0:17:06.19,Default,,0,0,0,,Белгісіз биологиялық қару
Dialogue: 0,0:17:06.31,0:17:10.69,Default,,0,0,0,,Немесе керемет күш
Dialogue: 0,0:17:10.82,0:17:12.07,Default,,0,0,0,,Эй (1-талдау тобы) О
Dialogue: 0,0:17:12.19,0:17:17.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:18.11,0:17:20.78,Default,,0,0,0,,Ааа
Dialogue: 0,0:17:22.08,0:17:26.37,Default,,0,0,0,,Ой, кешіріңіз, бұл жай ғана шөп безгегі.
Dialogue: 0,0:17:26.50,0:17:27.50,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:27.62,0:17:29.13,Default,,0,0,0,,Ах... (Шэдкинстің дірілдеген дыбысы)
Dialogue: 0,0:17:29.25,0:17:30.67,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:30.79,0:17:31.96,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:32.09,0:17:33.30,Default,,0,0,0,,Шөп ауруы бұрыннан бар.
Dialogue: 0,0:17:33.42,0:17:36.13,Default,,0,0,0,,Мен бұл жойылған ауру деп ойладым.
Dialogue: 0,0:17:36.26,0:17:38.64,Default,,0,0,0,,Мен бұл вирус немесе басқа нәрсе екеніне сенімдімін.
Dialogue: 0,0:17:38.76,0:17:42.47,Default,,0,0,0,,Бәлкім, біреу таратып жатқан шығар.
Dialogue: 0,0:17:42.60,0:17:45.06,Default,,0,0,0,,А, мұнда темекі шегуге болмайды.
Dialogue: 0,0:17:48.69,0:17:50.56,Default,,0,0,0,,Ол сізге еліктейді.
Dialogue: 0,0:17:53.57,0:17:55.32,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:17:55.44,0:17:58.11,Default,,0,0,0,,Жақсы болмаса, бәрібір сені өзіммен бірге алып кетемін.
Dialogue: 0,0:17:58.24,0:17:59.70,Default,,0,0,0,,Бұл шықты, иә?
Dialogue: 0,0:17:59.82,0:18:01.53,Default,,0,0,0,,Биотерроризм?
Dialogue: 0,0:18:01.66,0:18:04.29,Default,,0,0,0,,Спайк Сізге де қараңыз.
Dialogue: 0,0:18:04.41,0:18:05.54,Default,,0,0,0,,Мен оны айдай алмаймын.
Dialogue: 0,0:18:05.66,0:18:08.33,Default,,0,0,0,,Мен сізге айтамын, ақпарат ақысы арзан емес.
Dialogue: 0,0:18:08.46,0:18:10.92,Default,,0,0,0,,Түсіндім, тез көрсет.
Dialogue: 0,0:18:11.04,0:18:12.63,Default,,0,0,0,,Бұл құнды ақпарат.
Dialogue: 0,0:18:12.75,0:18:14.21,Default,,0,0,0,,Ред, жасаңыз.
Dialogue: 0,0:18:14.34,0:18:15.42,Default,,0,0,0,,Ай
Dialogue: 0,0:18:16.13,0:18:17.97,Default,,0,0,0,,Бұл хакер Ли Самсон.
Dialogue: 0,0:18:18.09,0:18:20.09,Default,,0,0,0,,5 миллион иен көлеміндегі жүлдеге қауіп төніп тұр.
Dialogue: 0,0:18:20.22,0:18:21.72,Default,,0,0,0,,-де бұл жігіт...
Dialogue: 0,0:18:21.85,0:18:24.77,Default,,0,0,0,,Мен жалған аты бар картаны таптым.
Dialogue: 0,0:18:24.89,0:18:25.81,Default,,0,0,0,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:18:25.93,0:18:28.31,Default,,0,0,0,,Сіз несиелік карта компаниясына кірдіңіз бе?
Dialogue: 0,0:18:28.44,0:18:30.85,Default,,0,0,0,,Сонымен, бұл көлік картаны пайдаланды...
Dialogue: 0,0:18:30.98,0:18:32.86,Default,,0,0,0,,Ол кенет жарылып кетті...
Dialogue: 0,0:18:32.98,0:18:35.53,Default,,0,0,0,,Қосымша сапарға шыққан Ли емес еді.
Dialogue: 0,0:18:35.65,0:18:36.99,Default,,0,0,0,,Мүмкін дос шығар
Dialogue: 0,0:18:37.11,0:18:39.36,Default,,0,0,0,,Әй, мына жігіт, мына жігіт.
Dialogue: 0,0:18:39.49,0:18:42.49,Default,,0,0,0,,Хмм? Мен шынымен түсінбеймін
Dialogue: 0,0:18:42.62,0:18:44.66,Default,,0,0,0,,Бұл тамаша ақпарат.
Dialogue: 0,0:18:44.79,0:18:47.70,Default,,0,0,0,,Сіз осындай бұлыңғыр суретке түсіп қалуыңыз мүмкін дейсіз бе?
Dialogue: 0,0:18:47.91,0:18:51.83,Default,,0,0,0,,Неге, менің есімде анық.
Dialogue: 0,0:18:51.96,0:18:53.84,Default,,0,0,0,,Иә, бұл?
Dialogue: 0,0:18:53.96,0:18:57.92,Default,,0,0,0,,Бұл қаламмен мониторға жазуға болады.
Dialogue: 0,0:18:58.22,0:19:01.55,Default,,0,0,0,,Сіз бұл жігіт кінәлі ме, жоқ па, білмеуіңіз мүмкін.
Dialogue: 0,0:19:01.93,0:19:04.47,Default,,0,0,0,,Егер сіз бетпердесіз болсаңыз...
Dialogue: 0,0:19:04.60,0:19:06.35,Default,,0,0,0,,Оған бірінші шабуыл жасалса керек.
Dialogue: 0,0:19:06.47,0:19:08.35,Default,,0,0,0,,Бұл адам өлген жоқ.
Dialogue: 0,0:19:08.48,0:19:09.94,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:19:10.06,0:19:12.56,Default,,0,0,0,,Бұл менің түйсігім.
Dialogue: 0,0:19:12.77,0:19:14.77,Default,,0,0,0,,Түсінбеңіз
Dialogue: 0,0:19:15.02,0:19:16.28,Default,,0,0,0,,Хмм, орындалды.
Dialogue: 0,0:19:16.61,0:19:19.03,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:19:19.36,0:19:21.86,Default,,0,0,0,,Бұл авангард тұлға ма?
Dialogue: 0,0:19:21.99,0:19:23.07,Default,,0,0,0,,Хання
Dialogue: 0,0:19:23.20,0:19:25.53,Default,,0,0,0,,Хаха бұл жақсы
Dialogue: 0,0:19:25.66,0:19:29.25,Default,,0,0,0,,Мына суретке түсіп қалсаң, мен сыйлығын төлеймін.
Dialogue: 0,0:19:29.37,0:19:31.67,Default,,0,0,0,,Иә, жеткілікті.
Dialogue: 0,0:19:32.00,0:19:35.50,Default,,0,0,0,,Бұл жақсы. Мен оны өзім ұстаймын.
Dialogue: 0,0:19:35.84,0:19:39.05,Default,,0,0,0,,О, құдай-ау, бұл бос уақыт болды.
Dialogue: 0,0:19:39.38,0:19:41.68,Default,,0,0,0,,Вирустарды іздеуді бастайық.
Dialogue: 0,0:19:42.09,0:19:44.26,Default,,0,0,0,,Мұны істеуге не себеп болды?
Dialogue: 0,0:19:44.39,0:19:47.89,Default,,0,0,0,,Бір қызығы, әйел интуициясын мазақ ете алмайсың.
Dialogue: 0,0:19:48.02,0:19:48.89,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:19:49.43,0:19:52.85,Default,,0,0,0,,Кейде кеседе жоқ нәрсені жегім келеді.
Dialogue: 0,0:19:53.23,0:19:53.85,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:19:53.98,0:19:59.99,Default,,0,0,0,,♪～
Dialogue: 0,0:20:08.45,0:20:10.91,Default,,0,0,0,,♪Әкемнің өмір бойы қақпа қазғанын білесіз
Dialogue: 0,0:20:11.04,0:20:13.42,Default,,0,0,0,,♪Ал ол ешқашан ештеңе білмеді
Dialogue: 0,0:20:13.54,0:20:15.79,Default,,0,0,0,,♪Иә және оның әкесі қарт адам сияқты қазды
Dialogue: 0,0:20:15.92,0:20:18.38,Default,,0,0,0,,♪Соғысқа дейін кім қазған
Dialogue: 0,0:20:18.50,0:20:21.30,Default,,0,0,0,,♪Мен туылғанша ол біле алмады
Dialogue: 0,0:20:21.42,0:20:25.47,Default,,0,0,0,,♪Байғұс анашым Алла жаны жәннатта
Dialogue: 0,0:20:25.97,0:20:28.47,Default,,0,0,0,,♪Олар сияқты мен де қазып шығамын'
Dialogue: 0,0:20:33.14,0:20:35.90,Default,,0,0,0,,♪Жанығып, жалғызсырап қалған шығармын
Dialogue: 0,0:20:38.23,0:20:41.78,Default,,0,0,0,,♪Мүмкін, мен мылқау және мүйізсіз болған шығармын
Dialogue: 0,0:20:42.99,0:20:48.70,Default,,0,0,0,,♪Леди Лак маған күлген шығар?
Dialogue: 0,0:21:03.17,0:21:05.05,Default,,0,0,0,,Ол бұрыннан ұшқан.
Dialogue: 0,0:21:05.18,0:21:07.55,Default,,0,0,0,,Әй, ұшты, ұшты
Dialogue: 0,0:21:07.68,0:21:12.93,Default,,0,0,0,,Мен Сатурнға дейін қайтадан, соншалықты жылдам ұшсам деп тілеймін.
Dialogue: 0,0:21:13.06,0:21:14.43,Default,,0,0,0,,Фуки начуу №
Dialogue: 0,0:21:14.56,0:21:15.85,Default,,0,0,0,,Сіз атқа міндіңіз...
Dialogue: 0,0:21:15.98,0:21:18.81,Default,,0,0,0,,Егіске пестицидтерді шашатын винт шығар.
Dialogue: 0,0:21:18.94,0:21:20.40,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:21:20.52,0:21:21.44,Default,,0,0,0,,Саған бір нәрсе сұрасам бола ма?
Dialogue: 0,0:21:21.57,0:21:22.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.99,0:21:24.95,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:21:25.07,0:21:28.28,Default,,0,0,0,,Бұл мүмкін емес, өйткені есту қабілетіміз нашар.
Dialogue: 0,0:21:28.95,0:21:30.58,Default,,0,0,0,,Сіз Мамейяны білесіз бе?
Dialogue: 0,0:21:30.70,0:21:33.62,Default,,0,0,0,,Бұршақ барлық жерде сатылады.
Dialogue: 0,0:21:33.75,0:21:36.62,Default,,0,0,0,,Барлық жерде сатылмайтын бұршақ сататын дүкендер бар.
Dialogue: 0,0:21:36.75,0:21:38.96,Default,,0,0,0,,Полицияға рұқсат жоқ
Dialogue: 0,0:21:39.08,0:21:40.67,Default,,0,0,0,,Мен полиция қызметкеріне ұқсаймын ба?
Dialogue: 0,0:21:40.79,0:21:43.21,Default,,0,0,0,,Дочикачуто Якузакано
Dialogue: 0,0:21:43.34,0:21:45.30,Default,,0,0,0,,Екеуі де ұқсас.
Dialogue: 0,0:21:45.42,0:21:47.38,Default,,0,0,0,,Мен сыйлы аңшымын.
Dialogue: 0,0:21:48.43,0:21:50.26,Default,,0,0,0,,Не, ковбой?
Dialogue: 0,0:21:50.39,0:21:52.56,Default,,0,0,0,,Біз де сондай болдық.
Dialogue: 0,0:21:52.68,0:21:54.14,Default,,0,0,0,,Сонда мен оқиғаны түсінемін.
Dialogue: 0,0:21:54.27,0:21:56.44,Default,,0,0,0,,Артық емес.
Dialogue: 0,0:22:07.95,0:22:13.95,Default,,0,0,0,,(Рашид гуілдеді)
Dialogue: 0,0:22:14.54,0:22:17.08,Default,,0,0,0,,Сіз бұршақ дүкенін іздеп жүрсіз бе?
Dialogue: 0,0:22:22.25,0:22:24.42,Default,,0,0,0,,Иә
Dialogue: 0,0:22:24.63,0:22:26.92,Default,,0,0,0,,Көзге көрінбейтін бұршақ бар ма?
Dialogue: 0,0:22:27.05,0:22:28.01,Default,,0,0,0,,Әрине.
Dialogue: 0,0:22:28.13,0:22:30.97,Default,,0,0,0,,Марокко көшесінде бәрі бар.
Dialogue: 0,0:22:32.39,0:22:34.60,Default,,0,0,0,,Міне, осында келдің ғой, солай ма?
Dialogue: 0,0:22:46.78,0:22:48.36,Default,,0,0,0,,Хай Рашид
Dialogue: 0,0:22:48.49,0:22:49.24,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:51.49,0:22:53.37,Default,,0,0,0,,Әй, Рашид, біраз болды.
Dialogue: 0,0:22:53.49,0:22:55.45,Default,,0,0,0,,Қалайсың, Магомед?
Dialogue: 0,0:22:55.58,0:22:56.95,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:22:57.08,0:22:58.00,Default,,0,0,0,,Аздап
Dialogue: 0,0:22:58.41,0:22:59.37,Default,,0,0,0,,Рашид
Dialogue: 0,0:22:59.50,0:23:00.92,Default,,0,0,0,,Жоғары
Dialogue: 0,0:23:01.96,0:23:02.92,Default,,0,0,0,,Рашид
Dialogue: 0,0:23:03.04,0:23:03.88,Default,,0,0,0,,О
Dialogue: 0,0:23:04.00,0:23:05.71,Default,,0,0,0,,Тіс протездері ше?
Dialogue: 0,0:23:06.17,0:23:07.38,Default,,0,0,0,,Рашид емес пе?
Dialogue: 0,0:23:07.71,0:23:09.01,Default,,0,0,0,,О, Зофи?
Dialogue: 0,0:23:10.30,0:23:11.80,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:23:11.93,0:23:13.22,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:23:14.60,0:23:16.72,Default,,0,0,0,,Сізде пісте бар ма? Бадам?
Dialogue: 0,0:23:18.10,0:23:19.60,Default,,0,0,0,,Бұл Калабар бұршақтары
Dialogue: 0,0:23:19.73,0:23:22.15,Default,,0,0,0,,Бин алдаған әйелдің опасыздығын соттау үшін
Dialogue: 0,0:23:22.27,0:23:24.02,Default,,0,0,0,,Әділдер барлығын бірден жейді.
Dialogue: 0,0:23:24.15,0:23:27.44,Default,,0,0,0,,Солай етсең, тұншығып, түкіруің мүмкін.
Dialogue: 0,0:23:27.57,0:23:31.70,Default,,0,0,0,,Зұлымдар қорқып жейді; баяу тамақтанса, олар уланып, зардап шегеді.
Dialogue: 0,0:23:31.82,0:23:33.16,Default,,0,0,0,,Сондықтан мен түсіндім
Dialogue: 0,0:23:33.78,0:23:35.37,Default,,0,0,0,,Менің әйелім жоқ
Dialogue: 0,0:23:35.49,0:23:37.58,Default,,0,0,0,,Бұл бақыт
Dialogue: 0,0:23:37.70,0:23:39.00,Default,,0,0,0,,Менің білгім келетін нәрсе
Dialogue: 0,0:23:39.12,0:23:40.37,Default,,0,0,0,,Кең бұршақ жақсы емес
Dialogue: 0,0:23:40.50,0:23:43.63,Default,,0,0,0,,Пифагор бұршақ сезімталдығының арқасында қайтыс болды
Dialogue: 0,0:23:43.75,0:23:46.00,Default,,0,0,0,,Бұршақты бағаламаңыз
Dialogue: 0,0:23:47.21,0:23:48.84,Default,,0,0,0,,Амммм...
Dialogue: 0,0:23:49.59,0:23:50.84,Default,,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:23:50.97,0:23:53.22,Default,,0,0,0,,Автоцистерна апатында қолданылады.
Dialogue: 0,0:23:53.34,0:23:54.59,Default,,0,0,0,,Ол ит бейнесіндегі едендегі суретке қарай жүгіріп барады; мен қателеспеппін
Dialogue: 0,0:23:59.10,0:24:00.81,Default,,0,0,0,,Сіз шайтанға сенесіз бе?
Dialogue: 0,0:24:00.93,0:24:01.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:01.89,0:24:04.48,Default,,0,0,0,,Барлығының қатысуымен -
Dialogue: 0,0:24:04.60,0:24:08.94,Default,,0,0,0,,Адамдар неге көп нәрсені қиялдайтынын білесіз бе?
Dialogue: 0,0:24:10.19,0:24:12.70,Default,,0,0,0,,Адамдар неге аспанды сағынады?
Dialogue: 0,0:24:12.82,0:24:14.95,Default,,0,0,0,,Ғарышта ұшқыңыз келе ме?
Dialogue: 0,0:24:15.20,0:24:19.49,Default,,0,0,0,,Себебі біз аспанда ұшатынбыз.
Dialogue: 0,0:24:19.95,0:24:22.08,Default,,0,0,0,,Бұл жерде топоз да сатады ма?
Dialogue: 0,0:24:22.91,0:24:26.08,Default,,0,0,0,,Елестетуге болатын нәрсе болуы мүмкін.
Dialogue: 0,0:24:26.21,0:24:28.75,Default,,0,0,0,,Көре алмасаң да
Dialogue: 0,0:24:29.63,0:24:31.51,Default,,0,0,0,,Вирустар бар, солай ма?
Dialogue: 0,0:24:32.76,0:24:34.51,Default,,0,0,0,,Бұл вирус емес
Dialogue: 0,0:24:35.14,0:24:36.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:37.76,0:24:43.77,Default,,0,0,0,,(Рашид гуілдеді)
Dialogue: 0,0:24:45.15,0:24:49.15,Default,,0,0,0,,(Рашид гуілдеді)
Dialogue: 0,0:24:55.82,0:24:57.78,Default,,0,0,0,,Кяхаха
Dialogue: 0,0:24:59.12,0:25:03.12,Default,,0,0,0,,(Рашид гуілдеді)
Dialogue: 0,0:25:13.63,0:25:16.59,Default,,0,0,0,,Әй, Рашид, мен жақсы қазан алдым.
Dialogue: 0,0:25:16.72,0:25:19.26,Default,,0,0,0,,Бұл сіз үшін тамаша ыдыс.
Dialogue: 0,0:25:20.51,0:25:22.93,Default,,0,0,0,,Жоқ, бұл адам үшін тамаша қазан.
Dialogue: 0,0:25:23.06,0:25:23.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:23.85,0:25:26.77,Default,,0,0,0,,Аа, бұл сізге арналған тамаша қазан.
Dialogue: 0,0:25:26.90,0:25:28.69,Default,,0,0,0,,Ол қалай сәйкес келеді?
Dialogue: 0,0:25:29.19,0:25:31.61,Default,,0,0,0,,Дұрысын алған дұрыс.
Dialogue: 0,0:25:31.73,0:25:32.61,Default,,0,0,0,,Эй
Dialogue: 0,0:25:32.73,0:25:34.95,Default,,0,0,0,,Мен мұнда сауда жасауға келген жоқпын.
Dialogue: 0,0:25:35.07,0:25:37.32,Default,,0,0,0,,Сіз жақсы сатып алдыңыз.
Dialogue: 0,0:25:37.45,0:25:39.24,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:25:39.57,0:25:40.66,Default,,0,0,0,,Инчаара
Dialogue: 0,0:25:40.78,0:25:44.04,Default,,0,0,0,,Эй, күте тұрыңыз, эй
Dialogue: 0,0:25:46.08,0:25:46.71,Default,,0,0,0,,Уф
Dialogue: 0,0:25:46.83,0:25:52.84,Default,,0,0,0,,♪～
Dialogue: 0,0:26:24.54,0:26:27.33,Default,,0,0,0,,Жарайды, 20 ғасыр ойындары.
Dialogue: 0,0:26:27.46,0:26:31.84,Default,,0,0,0,,Жоқ, мен заманауи ойындардан әбден шаршадым.
Dialogue: 0,0:26:31.96,0:26:35.01,Default,,0,0,0,,Мен соңғы кездері осындай ескі мектепке түсіп жүрмін.
Dialogue: 0,0:26:35.51,0:26:36.34,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:26:36.46,0:26:39.47,Default,,0,0,0,,Бұрын мұндай нәрсе жеткілікті еді.
Dialogue: 0,0:26:39.72,0:26:42.18,Default,,0,0,0,,Бұл хакерлерге де қатысты.
Dialogue: 0,0:26:42.30,0:26:44.60,Default,,0,0,0,,Капитан Кранчтың күндері жақсы болды.
Dialogue: 0,0:26:44.72,0:26:48.94,Default,,0,0,0,,Бұл тарихта қалғаны соншалық.
Dialogue: 0,0:26:49.06,0:26:51.44,Default,,0,0,0,,Қазіргі уақытта барлық жерде қорғаныс қатаң...
Dialogue: 0,0:26:51.56,0:26:53.65,Default,,0,0,0,,Егер сіз ерекше ештеңе жасамасаңыз, сіз ерекшеленбейсіз.
Dialogue: 0,0:26:54.44,0:26:56.74,Default,,0,0,0,,Сондықтан мен сізге ризамын.
Dialogue: 0,0:26:56.86,0:26:57.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:58.03,0:27:00.16,Default,,0,0,0,,Мен оны бір рет көргім келді, солай ма?
Dialogue: 0,0:27:00.82,0:27:02.87,Default,,0,0,0,,Террорист дегеніміз не?
Dialogue: 0,0:27:18.47,0:27:22.05,Default,,0,0,0,,А-а, өлді.
Dialogue: 0,0:27:24.68,0:27:27.14,Default,,0,0,0,,Сіз жүргізуші куәлігіңізбен қайда барасыз?
Dialogue: 0,0:27:27.89,0:27:30.31,Default,,0,0,0,,Бұдан былай қойма ауданынан басқа ештеңе жоқ.
Dialogue: 0,0:27:30.44,0:27:32.44,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:27:36.86,0:27:39.07,Default,,0,0,0,,А, ол қайтыс болды.
Dialogue: 0,0:27:44.82,0:27:50.83,Default,,0,0,0,,♪～
Dialogue: 0,0:28:04.14,0:28:06.60,Default,,0,0,0,,Егер сіздің қарсыласыңыз көзге көрінетін жау болса...
Dialogue: 0,0:28:06.72,0:28:09.14,Default,,0,0,0,,Шериф болу да оңай жұмыс.
Dialogue: 0,0:28:09.27,0:28:13.44,Default,,0,0,0,,-де? Автоцистернаның ішінде не болды?
Dialogue: 0,0:28:13.77,0:28:16.48,Default,,0,0,0,,Ештеңе шықпайды Бұл
Dialogue: 0,0:28:16.61,0:28:17.94,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:28:18.07,0:28:19.73,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:28:19.86,0:28:23.82,Default,,0,0,0,,Өйткені, ол көрінбейді, мен оны бұрын көрмегенмін.
Dialogue: 0,0:28:36.29,0:28:37.34,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:28:37.46,0:28:39.42,Default,,0,0,0,,3 күн бұрын астероид маңында-
Dialogue: 0,0:28:39.55,0:28:41.80,Default,,0,0,0,,Ғарыштық жүк көлігі табылды
Dialogue: 0,0:28:42.17,0:28:43.47,Default,,0,0,0,,Жүргізуші бірден қайтыс болды
Dialogue: 0,0:28:43.59,0:28:45.76,Default,,0,0,0,,Егер жүк бос болса
Dialogue: 0,0:28:45.89,0:28:47.60,Default,,0,0,0,,Бұл тонау ісі ме?
Dialogue: 0,0:28:47.72,0:28:49.18,Default,,0,0,0,,Жүк көлігінің иесі -
Dialogue: 0,0:28:49.31,0:28:52.60,Default,,0,0,0,,Бұл Cheerios Medical деп аталатын фармацевтикалық компания.
Dialogue: 0,0:28:52.73,0:28:56.56,Default,,0,0,0,,Олар із-түзсіз жоғалған адамды іздеу туралы өтініш те берген жоқ.
Dialogue: 0,0:28:56.69,0:28:58.94,Default,,0,0,0,,Менің ойымша, олар қандай да бір қауіпті заттарды алып жүрді ме...
Dialogue: 0,0:28:59.07,0:29:01.11,Default,,0,0,0,,Бұл жай ғана өсек болды.
Dialogue: 0,0:29:01.23,0:29:03.86,Default,,0,0,0,,Автоцистернада солай емес пе?
Dialogue: 0,0:29:03.99,0:29:05.20,Default,,0,0,0,,Ниуа
Dialogue: 0,0:29:05.32,0:29:08.83,Default,,0,0,0,,Фармацевтикалық компанияларға келгенде, бұл біртүрлі қорғалған.
Dialogue: 0,0:29:09.28,0:29:11.91,Default,,0,0,0,,Неліктен күшті тергеу жүргізілмейді?
Dialogue: 0,0:29:12.04,0:29:14.62,Default,,0,0,0,,Сіз кез келген нәрсеге, тіпті басқа нәрсеге де кіре аласыз.
Dialogue: 0,0:29:14.75,0:29:17.67,Default,,0,0,0,,Сіз осында болғаннан бері жағдай өзгерді.
Dialogue: 0,0:29:17.92,0:29:22.67,Default,,0,0,0,,ISSP енді атауларға толы ұйым.
Dialogue: 0,0:29:23.09,0:29:26.38,Default,,0,0,0,,Бастықтар тек өздерінің ілгерілеуіне мүдделі.
Dialogue: 0,0:29:26.51,0:29:29.97,Default,,0,0,0,,Астыңғы балалар якудзаға бастарын бұрып қалталы ақша табады.
Dialogue: 0,0:29:30.10,0:29:32.47,Default,,0,0,0,,Мені де қағып кетсе, қауіпті болар еді.
Dialogue: 0,0:29:32.60,0:29:33.77,Default,,0,0,0,,Ол шірік
Dialogue: 0,0:29:36.06,0:29:38.15,Default,,0,0,0,,Ештеңе өзгерген жоқ.
Dialogue: 0,0:29:38.65,0:29:40.02,Default,,0,0,0,,Сондықтан мен жұмыстан шықтым
Dialogue: 0,0:30:14.72,0:30:16.56,Default,,0,0,0,,Сіз тазарту туралы білесіз бе?
Dialogue: 0,0:30:17.06,0:30:18.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:18.65,0:30:21.77,Default,,0,0,0,,Жұмақ пен тозақ арасындағы орын
Dialogue: 0,0:30:22.48,0:30:24.86,Default,,0,0,0,,Сіз ол жерде жұмаққа кіре алмайсыз.
Dialogue: 0,0:30:24.98,0:30:28.82,Default,,0,0,0,,Артында қалғандардың қиналған жері
Dialogue: 0,0:30:28.95,0:30:32.03,Default,,0,0,0,,Иә, бұл дүние туралы.
Dialogue: 0,0:30:35.16,0:30:37.04,Default,,0,0,0,,Мұның бәрі ме?
Dialogue: 0,0:30:37.87,0:30:41.21,Default,,0,0,0,,Бұл бір затта 30 000 дана бар.
Dialogue: 0,0:30:41.54,0:30:45.00,Default,,0,0,0,,Капсуланы ашсаңыз, ол өздігінен көбейеді.
Dialogue: 0,0:30:45.13,0:30:47.84,Default,,0,0,0,,Әй, абай бол.
Dialogue: 0,0:30:48.17,0:30:50.34,Default,,0,0,0,,-да алтын
Dialogue: 0,0:30:56.06,0:30:58.81,Default,,0,0,0,,Уәделер әртүрлі ме?
Dialogue: 0,0:30:58.94,0:31:02.06,Default,,0,0,0,,Қалған жартысы партия кеткеннен кейін келеді.
Dialogue: 0,0:31:02.31,0:31:04.02,Default,,0,0,0,,Қалғандарымен өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:31:04.15,0:31:08.78,Default,,0,0,0,,Әй, ой, қош бол бұл кішкентай өмірмен.
Dialogue: 0,0:31:10.24,0:31:12.24,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:31:13.24,0:31:15.99,Default,,0,0,0,,Неліктен бұл Хэллоуин?
Dialogue: 0,0:31:16.95,0:31:22.42,Default,,0,0,0,,Бұрын Хеллоуин тазаруханадағы жандардың көкке баруы үшін өткізілетін.
Dialogue: 0,0:31:22.54,0:31:25.46,Default,,0,0,0,,Намаз оқитын күн болса керек.
Dialogue: 0,0:31:26.50,0:31:28.59,Default,,0,0,0,,Дұға ету
Dialogue: 0,0:31:44.86,0:31:46.52,Default,,0,0,0,,Амиго
Dialogue: 0,0:31:46.65,0:31:49.49,Default,,0,0,0,,Күн жүйесіндегі 3 миллион сыйлы аңшылар
Dialogue: 0,0:31:49.61,0:31:51.28,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:31:51.40,0:31:53.74,Default,,0,0,0,,Өздеріңіз білетіндей, үлкен кадрдың уақыты келді.
Dialogue: 0,0:31:53.87,0:31:54.62,Default,,0,0,0,,Докюн
Dialogue: 0,0:31:54.91,0:31:56.91,Default,,0,0,0,,Бүгін де жаңа сыйлық туралы ақпарат.
Dialogue: 0,0:31:57.04,0:31:58.45,Default,,0,0,0,,Мен сені Ганганмен таныстырамын.
Dialogue: 0,0:31:58.87,0:32:00.16,Default,,0,0,0,,Бүгін арнайы бағдарлама.
Dialogue: 0,0:32:00.29,0:32:02.71,Default,,0,0,0,,Бұл әдеттегіден 20 минутқа ұзағырақ болады.
Dialogue: 0,0:32:02.83,0:32:06.09,Default,,0,0,0,,Міне, қазір жақсы, сыйлы аңшылардың назарының орталығы.
Dialogue: 0,0:32:06.21,0:32:08.42,Default,,0,0,0,,Өйткені, 300 миллион оолонг жек көруші...
Dialogue: 0,0:32:08.55,0:32:09.88,Default,,0,0,0,,Өйткені бұл ерекше қасиет.
Dialogue: 0,0:32:10.01,0:32:13.64,Default,,0,0,0,,Дұрыс. Өйткені, бұл тарихтағы ең жоғары сыйлық.
Dialogue: 0,0:32:13.76,0:32:15.43,Default,,0,0,0,,Өкінішке орай, мен қайда және кім екенін білмеймін ...
Dialogue: 0,0:32:15.55,0:32:17.18,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:32:17.31,0:32:19.06,Default,,0,0,0,,Сізде ешқандай түсінік жоқ па?
Dialogue: 0,0:32:19.18,0:32:20.14,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:32:20.27,0:32:22.23,Default,,0,0,0,,Не туралы шашылғанын білмеймін...
Dialogue: 0,0:32:22.35,0:32:24.40,Default,,0,0,0,,Тірі куәгерлер жоқ.
Dialogue: 0,0:32:24.69,0:32:27.02,Default,,0,0,0,,Сонымен нені таныстыруымыз керек?
Dialogue: 0,0:32:27.15,0:32:29.11,Default,,0,0,0,,Иә, бұл жолы...
Dialogue: 0,0:32:29.23,0:32:33.86,Default,,0,0,0,,Бағдарламаға ақпарат бергеніңіз үшін біз сізге жақсы өнімді сыйлаймыз.
Dialogue: 0,0:32:33.99,0:32:36.91,Default,,0,0,0,,Жалғасыңыз және дәл қазір осы нөмірге қол жеткізіңіз.
Dialogue: 0,0:32:37.03,0:32:38.87,Default,,0,0,0,,Бірінші келген, бірінші қызмет етеді.
Dialogue: 0,0:32:44.83,0:32:46.38,Default,,0,0,0,,Ммм
Dialogue: 0,0:32:46.50,0:32:48.50,Default,,0,0,0,,Міне, әзірше.
Dialogue: 0,0:32:48.63,0:32:49.55,Default,,0,0,0,,Коммерциялық
Dialogue: 0,0:32:50.63,0:32:52.97,Default,,0,0,0,,Мен оны шынымен пайдалана алмаймын.
Dialogue: 0,0:32:53.09,0:32:54.47,Default,,0,0,0,,Фэй Фэй
Dialogue: 0,0:32:54.59,0:32:55.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:55.34,0:32:57.43,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:32:58.26,0:33:00.31,Default,,0,0,0,,Алдыңғы экран емес
Dialogue: 0,0:33:07.73,0:33:08.82,Default,,0,0,0,,Татуировкасы?
Dialogue: 0,0:33:08.94,0:33:12.11,Default,,0,0,0,,Мен осыған ұқсас белгіні іздеп көрдім.
Dialogue: 0,0:33:12.94,0:33:14.78,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:33:14.90,0:33:19.16,Default,,0,0,0,,Хмм, бұл емес пе?
Dialogue: 0,0:33:19.28,0:33:20.49,Default,,0,0,0,,О, бұл ма?
Dialogue: 0,0:33:20.62,0:33:22.25,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:33:22.37,0:33:25.21,Default,,0,0,0,,Иә, бұл сөзсіз.
Dialogue: 0,0:33:27.08,0:33:30.96,Default,,0,0,0,,«Марс армиясының арнайы операциялық бөлімшесінің 7-ші командасы»
Dialogue: 0,0:33:31.09,0:33:34.22,Default,,0,0,0,,Бұл арнайы күштердің белгісі ме? Бұл әскери адам.
Dialogue: 0,0:33:34.34,0:33:36.97,Default,,0,0,0,,3 жыл бұрын таратылған
Dialogue: 0,0:33:37.09,0:33:39.26,Default,,0,0,0,,-де? Бұл құрылғы туралы деректер бар ма?
Dialogue: 0,0:33:39.39,0:33:41.47,Default,,0,0,0,,Ай
Dialogue: 0,0:33:43.35,0:33:47.65,Default,,0,0,0,,Хмм, бұл не? Өліп қалды.
Dialogue: 0,0:33:47.77,0:33:48.65,Default,,0,0,0,,Няаа
Dialogue: 0,0:33:48.77,0:33:49.77,Default,,0,0,0,,Хмм, келесі жолы жасайық.
Dialogue: 0,0:33:49.90,0:33:51.32,Default,,0,0,0,,Мияу-кун
Dialogue: 0,0:33:51.44,0:33:52.90,Default,,0,0,0,,Не болды? Айн
Dialogue: 0,0:33:53.03,0:33:54.07,Default,,0,0,0,,Бір
Dialogue: 0,0:33:54.19,0:33:55.49,Default,,0,0,0,,Иә
Dialogue: 0,0:33:55.61,0:33:57.32,Default,,0,0,0,,Не? Келесі жолы асығыңыз.
Dialogue: 0,0:33:57.45,0:33:59.57,Default,,0,0,0,,Айн бұл адам.
Dialogue: 0,0:34:00.24,0:34:02.79,Default,,0,0,0,,Айн қайдан біледі?
Dialogue: 0,0:34:03.54,0:34:06.50,Default,,0,0,0,,Ол екі жыл бұрын Титан соғысында қайтыс болды.
Dialogue: 0,0:34:06.91,0:34:09.88,Default,,0,0,0,,Әй, болды, тоқтат, қой.
Dialogue: 0,0:34:10.00,0:34:10.96,Default,,0,0,0,,...
Dialogue: 0,0:34:11.09,0:34:13.96,Default,,0,0,0,,Мұндай қара жұмыс маған жарамайды.
Dialogue: 0,0:34:14.09,0:34:15.13,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:34:15.26,0:34:16.47,Default,,0,0,0,,Не?
Dialogue: 0,0:34:16.59,0:34:17.80,Default,,0,0,0,,Көңіл көтеру және ақша табу―
Dialogue: 0,0:34:17.92,0:34:20.93,Default,,0,0,0,,Мен үшін тамаша өмір жолы бар сияқты сезінемін.
Dialogue: 0,0:34:21.05,0:34:21.89,Default,,0,0,0,,Фэй
Dialogue: 0,0:34:22.01,0:34:23.85,Default,,0,0,0,,Неге мұндай адамдармен араласасың?
Dialogue: 0,0:34:23.97,0:34:27.10,Default,,0,0,0,,Сіз әдемі 20 жасыңызды өткізуіңіз керек, солай ма?
Dialogue: 0,0:34:27.23,0:34:28.19,Default,,0,0,0,,Фэй Фэй
Dialogue: 0,0:34:28.31,0:34:30.40,Default,,0,0,0,,Мен қай жерде қателестім?
Dialogue: 0,0:34:30.52,0:34:32.94,Default,,0,0,0,,Ли мырза картаны қайтадан пайдаланды ма?
Dialogue: 0,0:34:33.07,0:34:33.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:34.03,0:34:35.15,Default,,0,0,0,,Бұл сонда болды ма?
Dialogue: 0,0:34:37.90,0:34:40.16,Default,,0,0,0,,Иә, а, бұл не?
Dialogue: 0,0:34:40.28,0:34:41.16,Default,,0,0,0,,Жақсы
Dialogue: 0,0:34:41.45,0:34:47.16,Default,,0,0,0,,Гура Гура Гура Гура Гура Ня?
Dialogue: 0,0:34:47.87,0:34:49.25,Default,,0,0,0,,Такоцубо кәдесыйы?
Dialogue: 0,0:34:49.37,0:34:51.63,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:34:51.75,0:34:55.25,Default,,0,0,0,,Әй, Айн бұл кісіні осы адам деді.
Dialogue: 0,0:34:55.38,0:34:57.34,Default,,0,0,0,,Бірақ Фэй басқаша.
Dialogue: 0,0:34:57.47,0:34:58.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:34:58.22,0:35:01.30,Default,,0,0,0,,Демек, ол қазірдің өзінде өлім төсегінде жатыр.
Dialogue: 0,0:35:01.43,0:35:03.97,Default,,0,0,0,,«Винсент Бораж»
Dialogue: 0,0:35:04.60,0:35:06.85,Default,,0,0,0,,Масақ Егін деген не?
Dialogue: 0,0:35:08.73,0:35:09.89,Default,,0,0,0,,О...
Dialogue: 0,0:35:10.02,0:35:11.06,Default,,0,0,0,,Бұл?
Dialogue: 0,0:35:11.19,0:35:13.31,Default,,0,0,0,,Бұл мен үшін тамаша қазан сияқты.
Dialogue: 0,0:35:13.44,0:35:14.44,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,0:35:14.57,0:35:16.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:16.69,0:35:18.99,Default,,0,0,0,,Батыс әлі де жақсы
Dialogue: 0,0:35:19.24,0:35:19.86,Default,,0,0,0,,Иә
Dialogue: 0,0:35:19.99,0:35:23.41,Default,,0,0,0,,Эдді де қараңыз хахаха
Dialogue: 0,0:35:23.53,0:35:27.62,Default,,0,0,0,,Ммммммммммм...
Dialogue: 0,0:35:27.75,0:35:29.41,Default,,0,0,0,,Ол епті жігіт.
Dialogue: 0,0:35:29.54,0:35:31.79,Default,,0,0,0,,Оны акробатикалық топқа сатуым керек пе?
Dialogue: 0,0:35:32.04,0:35:34.04,Default,,0,0,0,,Мен Бобты ұруға тырыстым...
Dialogue: 0,0:35:34.17,0:35:37.59,Default,,0,0,0,,Көлеңкелі фармацевтикалық компания бар екенін айту.
Dialogue: 0,0:35:37.71,0:35:39.34,Default,,0,0,0,,Фармацевтикалық компаниялар?
Dialogue: 0,0:35:39.59,0:35:41.01,Default,,0,0,0,,Ішінде бірдеңе бар.
Dialogue: 0,0:35:41.13,0:35:42.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:44.18,0:35:45.93,Default,,0,0,0,,Не?
Dialogue: 0,0:35:58.07,0:36:00.11,Default,,0,0,0,,Эй, мен істеймін.
Dialogue: 0,0:36:00.24,0:36:01.32,Default,,0,0,0,,Міне келдік (Ли) Ха!
Dialogue: 0,0:36:03.74,0:36:04.91,Default,,0,0,0,,Бір адам?
Dialogue: 0,0:36:05.24,0:36:07.49,Default,,0,0,0,,Қаласаңыз, онымен ойнай аласыз.
Dialogue: 0,0:36:07.62,0:36:08.49,Default,,0,0,0,,Иә.
Dialogue: 0,0:36:08.62,0:36:11.58,Default,,0,0,0,,Бірақ мен мұндай виртуалды нәрседен гөрі шынайы нәрсені жақсы көремін.
Dialogue: 0,0:36:11.91,0:36:13.37,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:36:17.04,0:36:19.88,Default,,0,0,0,,Ақыры сені кездестірдім, хакер бала.
Dialogue: 0,0:36:20.13,0:36:22.80,Default,,0,0,0,,Менде 500 ұпай ғана қалды.
Dialogue: 0,0:36:22.93,0:36:25.89,Default,,0,0,0,,Сонда мен Спорки Докейді кездестіруім мүмкін еді
Dialogue: 0,0:36:26.01,0:36:28.10,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:36:28.56,0:36:31.56,Default,,0,0,0,,Қарғыс атсын, мен сені сирек көремін.
Dialogue: 0,0:36:31.68,0:36:32.69,Default,,0,0,0,,Иә
Dialogue: 0,0:36:32.81,0:36:33.94,Default,,0,0,0,,Хун
Dialogue: 0,0:36:34.85,0:36:38.36,Default,,0,0,0,,Мен үшін не істей аласың, аңшы апа?
Dialogue: 0,0:36:38.69,0:36:41.03,Default,,0,0,0,,Сіз өз ұстанымыңызды түсінесіз бе?
Dialogue: 0,0:36:41.15,0:36:43.36,Default,,0,0,0,,Ойын аяқталды, балақай.
Dialogue: 0,0:36:44.45,0:36:47.95,Default,,0,0,0,,Спорки Докейдің кектігі қорқынышты емес пе?
Dialogue: 0,0:36:49.87,0:36:50.58,Default,,0,0,0,,Эй?
Dialogue: 0,0:36:55.54,0:36:56.79,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:36:58.46,0:36:59.80,Default,,0,0,0,,О, сәл күте тұрыңыз
Dialogue: 0,0:37:00.25,0:37:01.96,Default,,0,0,0,,(Лидің қатты тыныс алуы)
Dialogue: 0,0:37:02.30,0:37:03.47,Default,,0,0,0,,Ішек
Dialogue: 0,0:37:06.97,0:37:08.60,Default,,0,0,0,,Ооо
Dialogue: 0,0:37:08.72,0:37:10.18,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:37:10.77,0:37:13.39,Default,,0,0,0,,Уф иә иә
Dialogue: 0,0:37:13.52,0:37:15.85,Default,,0,0,0,,(Лидің қатты тыныс алуы)
Dialogue: 0,0:37:15.98,0:37:17.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:37:18.56,0:37:19.40,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:37:19.52,0:37:20.73,Default,,0,0,0,,Ах аа
Dialogue: 0,0:37:20.86,0:37:21.98,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:37:22.11,0:37:23.28,Default,,0,0,0,,Иә
Dialogue: 0,0:37:28.99,0:37:30.37,Default,,0,0,0,,күрсіну
Dialogue: 0,0:37:31.08,0:37:32.29,Default,,0,0,0,,Иә
Dialogue: 0,0:37:33.75,0:37:36.67,Default,,0,0,0,,Біртүрлі кейіпкерлер
Dialogue: 0,0:37:37.08,0:37:39.46,Default,,0,0,0,,Сонымен ішінде не бар?
Dialogue: 0,0:37:39.59,0:37:42.80,Default,,0,0,0,,Бұл Ринрин лимфоциті.
Dialogue: 0,0:37:42.92,0:37:44.22,Default,,0,0,0,,Лимфоциттер?
Dialogue: 0,0:37:44.34,0:37:46.30,Default,,0,0,0,,Қанда бар ма?
Dialogue: 0,0:37:46.43,0:37:49.64,Default,,0,0,0,,Бірақ бұл біртүрлі жаратылыстар.
Dialogue: 0,0:37:49.76,0:37:50.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:37:51.43,0:37:53.98,Default,,0,0,0,,Менде ештеңе жоқ.
Dialogue: 0,0:37:54.27,0:37:57.31,Default,,0,0,0,,Бұл нағыз лимфоциттер
Dialogue: 0,0:37:57.44,0:38:00.82,Default,,0,0,0,,Бірақ бұл сәл басқаша.
Dialogue: 0,0:38:00.94,0:38:03.44,Default,,0,0,0,,Хмм? Айырмашылығы неде?
Dialogue: 0,0:38:03.57,0:38:05.65,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:38:08.24,0:38:10.32,Default,,0,0,0,,Хмм? Мен түсінбедім.
Dialogue: 0,0:38:10.45,0:38:12.74,Default,,0,0,0,,Олай болса микротолқынды пеште қыздырайық.
Dialogue: 0,0:38:12.87,0:38:13.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:14.12,0:38:18.37,Default,,0,0,0,,Қандай ғажап пішін.
Dialogue: 0,0:38:24.01,0:38:24.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:30.97,0:38:32.81,Default,,0,0,0,,Хмм? Ах
Dialogue: 0,0:38:33.18,0:38:34.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:38:34.97,0:38:36.64,Default,,0,0,0,,Не?
Dialogue: 0,0:39:15.01,0:39:18.10,Default,,0,0,0,,Сәлем Тасбақа тазалау компаниясы?
Dialogue: 0,0:39:37.58,0:39:39.04,Default,,0,0,0,,Есепті тыңдау
Dialogue: 0,0:39:39.33,0:39:42.12,Default,,0,0,0,,ISSP-те бұл оқиғалар сериясы...
Dialogue: 0,0:39:42.25,0:39:45.04,Default,,0,0,0,,Террорлық акт ретінде тергеу жүріп жатқан көрінеді.
Dialogue: 0,0:39:45.17,0:39:47.80,Default,,0,0,0,,Күдікті анықталмады
Dialogue: 0,0:39:47.92,0:39:49.26,Default,,0,0,0,,Сондай-ақ мысалға қатысты-
Dialogue: 0,0:39:49.38,0:39:53.18,Default,,0,0,0,,Олар қазір оны вирустың бір түрі ретінде талдап жатқан сияқты.
Dialogue: 0,0:39:53.30,0:39:55.55,Default,,0,0,0,,Менің ойымша, біз оны әзірше анықтай алмаймыз.
Dialogue: 0,0:39:55.68,0:39:57.26,Default,,0,0,0,,Бірақ жеңілдік кезеңі болмайды.
Dialogue: 0,0:39:57.39,0:39:59.35,Default,,0,0,0,,Менделоға не болды? Лейтенант
Dialogue: 0,0:39:59.64,0:40:01.73,Default,,0,0,0,,Иә, Марокко көшесінде бірнеше рет-
Dialogue: 0,0:40:01.85,0:40:03.73,Default,,0,0,0,,Көру туралы ақпарат болды, сондықтан...
Dialogue: 0,0:40:03.85,0:40:06.44,Default,,0,0,0,,Мен жасырын тыңшымен байланысқа шықтым...
Dialogue: 0,0:40:06.57,0:40:08.65,Default,,0,0,0,,Мендело жоғалып кетті
Dialogue: 0,0:40:08.78,0:40:10.36,Default,,0,0,0,,Осы мәселе бойынша-
Dialogue: 0,0:40:10.49,0:40:13.61,Default,,0,0,0,,Ол толығымен біздің саламызда болуы керек.
Dialogue: 0,0:40:13.74,0:40:17.28,Default,,0,0,0,,Бұл тіпті Марс халқының өмір сүруіне әсер ететін мәселе.
Dialogue: 0,0:40:17.70,0:40:19.75,Default,,0,0,0,,Бірақ Винсент шынымен...
Dialogue: 0,0:40:19.87,0:40:22.21,Default,,0,0,0,,Сіз оны қолдандыңыз ба?
Dialogue: 0,0:40:23.33,0:40:27.88,Default,,0,0,0,,Бұл көрінбейтін шайтанның өзі.
Dialogue: 0,0:40:28.00,0:40:30.88,Default,,0,0,0,,Болмауы керек
Dialogue: 0,0:40:31.01,0:40:32.55,Default,,0,0,0,,Және-
Dialogue: 0,0:40:32.72,0:40:34.97,Default,,0,0,0,,Тірі болмауы керек
Dialogue: 0,0:40:35.09,0:40:37.26,Default,,0,0,0,,Винсент те, Мендело да
Dialogue: 0,0:40:38.64,0:40:39.93,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:40:40.06,0:40:41.18,Default,,0,0,0,,Иә
Dialogue: 0,0:40:44.52,0:40:45.44,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:40:46.23,0:40:48.36,Default,,0,0,0,,Эй, сен менің көлігімді білмейсің бе?
Dialogue: 0,0:40:48.48,0:40:51.11,Default,,0,0,0,,Иә? Жаңа ғана кетіп қалған жоқсың ба?
Dialogue: 0,0:40:51.24,0:40:52.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:36.28,0:41:37.99,Default,,0,0,0,,Қолдарыңызды көтеріңіз
Dialogue: 0,0:41:41.91,0:41:43.62,Default,,0,0,0,,Бұл мен бұрын бір жерден көрген жүз.
Dialogue: 0,0:41:45.50,0:41:47.83,Default,,0,0,0,,Бұл көрініс те әдемі.
Dialogue: 0,0:41:48.54,0:41:50.09,Default,,0,0,0,,Сен маған жараспадың
Dialogue: 0,0:41:50.21,0:41:51.46,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:41:51.88,0:41:53.59,Default,,0,0,0,,Айналыңыз
Dialogue: 0,0:42:01.76,0:42:02.43,Default,,0,0,0,,Құт
Dialogue: 0,0:42:07.23,0:42:08.19,Default,,0,0,0,,Уф
Dialogue: 0,0:42:08.31,0:42:08.94,Default,,0,0,0,,Уф
Dialogue: 0,0:42:13.65,0:42:14.94,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:42:15.19,0:42:16.45,Default,,0,0,0,,Бәс тігеміз бе?
Dialogue: 0,0:42:16.57,0:42:19.03,Default,,0,0,0,,Ашық болған кезде шыншыл бол
Dialogue: 0,0:42:20.03,0:42:21.95,Default,,0,0,0,,иә уһ уһ
Dialogue: 0,0:42:22.08,0:42:23.66,Default,,0,0,0,,Уф
Dialogue: 0,0:42:24.37,0:42:25.45,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:42:25.83,0:42:27.87,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:42:31.21,0:42:35.26,Default,,0,0,0,,Егер сіз фармацевтикалық компания болсаңыз, сіз өте күшті кеңсе ханымдарын жалдаған боларсыз.
Dialogue: 0,0:42:35.63,0:42:38.47,Default,,0,0,0,,Көп білу өміріңді қысқартады.
Dialogue: 0,0:42:38.93,0:42:41.22,Default,,0,0,0,,Маған күшті әйелдер ұнайды.
Dialogue: 0,0:42:41.35,0:42:42.51,Default,,0,0,0,,...
Dialogue: 0,0:42:42.64,0:42:44.18,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:42:44.39,0:42:45.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:45.81,0:42:46.43,Default,,0,0,0,,Иә
Dialogue: 0,0:42:49.27,0:42:49.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:42:52.15,0:42:53.02,Default,,0,0,0,,Иә! Хаха
Dialogue: 0,0:42:58.65,0:42:59.82,Default,,0,0,0,,Уф
Dialogue: 0,0:43:04.12,0:43:06.04,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:43:06.83,0:43:09.79,Default,,0,0,0,,(Күзетшілер ыңырсып)
Dialogue: 0,0:43:13.29,0:43:13.96,Default,,0,0,0,,Тоқта
Dialogue: 0,0:43:14.09,0:43:14.88,Default,,0,0,0,,Уф
Dialogue: 0,0:43:21.34,0:43:22.60,Default,,0,0,0,,О
Dialogue: 0,0:43:30.64,0:43:31.65,Default,,0,0,0,,Хун
Dialogue: 0,0:43:31.77,0:43:37.78,Default,,0,0,0,,♪～
Dialogue: 0,0:43:54.54,0:43:55.42,Default,,0,0,0,,Га
Dialogue: 0,0:44:14.23,0:44:16.02,Default,,0,0,0,,Доқан
Dialogue: 0,0:44:17.52,0:44:18.82,Default,,0,0,0,,Әй
Dialogue: 0,0:44:19.74,0:44:22.07,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:44:22.20,0:44:24.49,Default,,0,0,0,,Әй, не болды? (2-ер адам) Ой-оу.
Dialogue: 0,0:44:28.16,0:44:28.99,Default,,0,0,0,,Хмм?
Dialogue: 0,0:44:29.16,0:44:31.50,Default,,0,0,0,,Ой, бұл не? Ахахаха
Dialogue: 0,0:44:31.79,0:44:34.00,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:44:35.08,0:44:36.67,Default,,0,0,0,,«Хэллоуин құтты болсын»
Dialogue: 0,0:44:36.79,0:44:39.51,Default,,0,0,0,,«Алдау немесе емдеу»
Dialogue: 0,0:44:39.63,0:44:42.68,Default,,0,0,0,,«Егер маған жақсы нәрсе бермесең, мен саған еркелеймін».
Dialogue: 0,0:44:42.80,0:44:45.97,Default,,0,0,0,,«Мен кішкентаймын, ешкім байқамайды...»
Dialogue: 0,0:44:46.10,0:44:48.51,Default,,0,0,0,,«Көрінбейтін керемет нәрселер»
Dialogue: 0,0:44:48.81,0:44:51.43,Default,,0,0,0,,«Менің сүйектерім одан жасалған».
Dialogue: 0,0:44:51.81,0:44:54.06,Default,,0,0,0,,Сіз нені айтасыз? Бұл жігіт
Dialogue: 0,0:44:54.19,0:44:55.69,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:44:55.81,0:44:58.02,Default,,0,0,0,,Мәлімдемеге айналдырса мәнді болар еді.
Dialogue: 0,0:44:58.15,0:45:01.61,Default,,0,0,0,,Әй, бұл жерде дәмсіз қалпақ жатқан жоқ па?
Dialogue: 0,0:45:01.74,0:45:03.24,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,0:45:03.36,0:45:06.12,Default,,0,0,0,,Сыйлық басшысы мәлімдеме жасады.
Dialogue: 0,0:45:06.24,0:45:07.70,Default,,0,0,0,,Бұл еркелік емес пе?
Dialogue: 0,0:45:07.83,0:45:09.70,Default,,0,0,0,,Мен кешегі қазанда не болғанын көруім керек.
Dialogue: 0,0:45:09.83,0:45:11.83,Default,,0,0,0,,Сіз солай ойлаған боларсыз.
Dialogue: 0,0:45:11.95,0:45:13.12,Default,,0,0,0,,Кәстрөл?
Dialogue: 0,0:45:15.21,0:45:17.96,Default,,0,0,0,,Бұл бір қарағанда лимфоцитке ұқсайды.
Dialogue: 0,0:45:18.09,0:45:21.92,Default,,0,0,0,,Бұл шын мәнінде шағын машиналар шоғыры.
Dialogue: 0,0:45:22.17,0:45:24.84,Default,,0,0,0,,Бұл наномашина сияқты.
Dialogue: 0,0:45:25.18,0:45:26.39,Default,,0,0,0,,Наномашиналар?
Dialogue: 0,0:45:26.51,0:45:27.55,Default,,0,0,0,,Иә
Dialogue: 0,0:45:27.68,0:45:28.55,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:45:28.68,0:45:29.85,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:45:30.26,0:45:31.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:45:31.68,0:45:35.56,Default,,0,0,0,,Бұл қарапайым көзге көрінбейтін өте кішкентай робот.
Dialogue: 0,0:45:35.69,0:45:38.77,Default,,0,0,0,,Оның үстіне бұл зат ақуыздан жасалған.
Dialogue: 0,0:45:39.73,0:45:42.57,Default,,0,0,0,,Сіздің сүйікті ақуызыңыз.
Dialogue: 0,0:45:42.69,0:45:44.70,Default,,0,0,0,,Бұл мен жеуге болмайтын нәрсе.
Dialogue: 0,0:45:44.82,0:45:47.53,Default,,0,0,0,,Ол бастапқыда медициналық мақсатта қолданылған.
Dialogue: 0,0:45:47.66,0:45:50.49,Default,,0,0,0,,Неліктен бұл қазанда?
Dialogue: 0,0:45:51.37,0:45:55.21,Default,,0,0,0,,Қалай болғанда да лимфоциттер сүйек кемігінде түзіледі.
Dialogue: 0,0:45:55.33,0:45:56.75,Default,,0,0,0,,Сүйек кемігі
Dialogue: 0,0:45:56.87,0:45:57.96,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:45:58.08,0:46:01.75,Default,,0,0,0,,Бұл мәлімдемені жазған адам білетін шығар.
Dialogue: 0,0:46:01.88,0:46:03.21,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:46:03.67,0:46:05.01,Default,,0,0,0,,Осымен
Dialogue: 0,0:46:05.13,0:46:06.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:46:06.38,0:46:08.80,Default,,0,0,0,,Ақыр соңында, сіз ештеңе білмейтін шығарсыз.
Dialogue: 0,0:46:08.93,0:46:11.35,Default,,0,0,0,,Аа, бұл уақыт босқа кетті.
Dialogue: 0,0:46:12.18,0:46:14.48,Default,,0,0,0,,Фармацевтикалық компаниялар туралы не деуге болады?
Dialogue: 0,0:46:14.60,0:46:16.23,Default,,0,0,0,,Бұл үлкен компания.
Dialogue: 0,0:46:16.35,0:46:19.06,Default,,0,0,0,,Олар шынымен керемет дәрі жасап жатқан сияқты.
Dialogue: 0,0:46:19.44,0:46:22.73,Default,,0,0,0,,Өйткені, барлық күзетшілер G21-мен қаруланған.
Dialogue: 0,0:46:23.07,0:46:26.65,Default,,0,0,0,,Бұл әскери пулемет.
Dialogue: 0,0:46:26.78,0:46:29.20,Default,,0,0,0,,Жалпы, оны көп таратпау керек.
Dialogue: 0,0:46:29.70,0:46:33.33,Default,,0,0,0,,Тіпті Винсент сияқты татуировкасы бар әйел де болды.
Dialogue: 0,0:46:33.62,0:46:35.91,Default,,0,0,0,,Не керек, әйел
Dialogue: 0,0:46:36.04,0:46:37.00,Default,,0,0,0,,Не?
Dialogue: 0,0:46:37.12,0:46:38.62,Default,,0,0,0,,Ол өте әдемі еді.
Dialogue: 0,0:46:38.75,0:46:40.04,Default,,0,0,0,,...
Dialogue: 0,0:46:41.34,0:46:42.79,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:46:42.92,0:46:45.63,Default,,0,0,0,,Әскерге келгенде әңгіме басқаша.
Dialogue: 0,0:46:45.76,0:46:50.09,Default,,0,0,0,,Бірақ жұмбақ шешілудің орнына тереңдей түсті.
Dialogue: 0,0:46:50.22,0:46:50.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:51.51,0:46:54.31,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:46:54.52,0:46:56.93,Default,,0,0,0,,Мұндай жағдайларда сіз жасай алатын жалғыз нәрсе - ұйықтау.
Dialogue: 0,0:46:57.06,0:46:57.68,Default,,0,0,0,,Сіз
Dialogue: 0,0:46:57.81,0:47:00.52,Default,,0,0,0,,Тек ұйықтап, сауапты күт.
Dialogue: 0,0:47:01.02,0:47:02.73,Default,,0,0,0,,Иә, ұмытып кетіппін.
Dialogue: 0,0:47:03.19,0:47:05.69,Default,,0,0,0,,Мен қалпақ іздеп келдім. Сіз білмейсіз бе?
Dialogue: 0,0:47:05.82,0:47:07.40,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:47:07.61,0:47:09.45,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:47:09.57,0:47:10.86,Default,,0,0,0,,Кун-кун
Dialogue: 0,0:47:10.99,0:47:15.24,Default,,0,0,0,,Кук кук оғаш иіс
Dialogue: 0,0:47:15.37,0:47:16.70,Default,,0,0,0,,Айн Түсінесің бе?
Dialogue: 0,0:47:16.83,0:47:17.66,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:47:17.79,0:47:23.79,Default,,0,0,0,,♪～
Dialogue: 0,0:47:42.40,0:47:45.19,Default,,0,0,0,,Фуа мияу
Dialogue: 0,0:47:45.61,0:47:46.40,Default,,0,0,0,,Бұл жерде ме?
Dialogue: 0,0:47:46.53,0:47:47.69,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:47:51.49,0:47:52.61,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:47:52.74,0:47:56.37,Default,,0,0,0,,Маған бірдеңе берші, мен саған еркелеймін.
Dialogue: 0,0:47:56.49,0:47:57.41,Default,,0,0,0,,Біраз ұят қой, иә?
Dialogue: 0,0:47:57.54,0:47:59.20,Default,,0,0,0,,Хэллоуин - ертең.
Dialogue: 0,0:47:59.33,0:48:01.67,Default,,0,0,0,,Уау уау
Dialogue: 0,0:48:07.55,0:48:08.59,Default,,0,0,0,,Қауіп-қатерлерге байланысты әуе саяхатынан бас тартып—
Dialogue: 0,0:48:08.71,0:48:09.97,Default,,0,0,0,,Ку Кун
Dialogue: 0,0:48:10.09,0:48:11.68,Default,,0,0,0,,(кіреберістегі дыбыс сигналы)
Dialogue: 0,0:48:11.80,0:48:14.93,Default,,0,0,0,,Мен саған еркелетемін.
Dialogue: 0,0:48:15.47,0:48:17.97,Default,,0,0,0,,Аанра, жарай ма? Уфуфуфу
Dialogue: 0,0:48:18.31,0:48:19.81,Default,,0,0,0,,Оны маған бер
Dialogue: 0,0:48:19.93,0:48:22.64,Default,,0,0,0,,Саған еркелеймін бе, бала?
Dialogue: 0,0:48:22.77,0:48:24.15,Default,,0,0,0,,Сіз ұл емессіз ғой?
Dialogue: 0,0:48:24.27,0:48:25.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:26.06,0:48:27.27,Default,,0,0,0,,Бұл қыз
Dialogue: 0,0:48:27.40,0:48:28.19,Default,,0,0,0,,Жақсы
Dialogue: 0,0:48:28.32,0:48:30.99,Default,,0,0,0,,Маған әйел керек емес, қазір үйге қайт.
Dialogue: 0,0:48:31.11,0:48:32.86,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:48:34.82,0:48:35.99,Default,,0,0,0,,Кун...
Dialogue: 0,0:48:36.12,0:48:37.74,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:48:38.70,0:48:39.91,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:48:41.12,0:48:43.46,Default,,0,0,0,,Хен хин хин
Dialogue: 0,0:48:44.96,0:48:46.17,Default,,0,0,0,,Хахаха
Dialogue: 0,0:48:57.39,0:48:58.93,Default,,0,0,0,,Mekke One
Dialogue: 0,0:48:59.06,0:49:02.43,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:49:02.56,0:49:04.56,Default,,0,0,0,,Хмм, иә, иә.
Dialogue: 0,0:49:05.60,0:49:06.52,Default,,0,0,0,,Иә Сәлеметсіз бе?
Dialogue: 0,0:49:06.65,0:49:08.40,Default,,0,0,0,,Ашу ашу
Dialogue: 0,0:49:08.52,0:49:09.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:09.65,0:49:11.15,Default,,0,0,0,,Ed? Не?
Dialogue: 0,0:49:11.28,0:49:13.45,Default,,0,0,0,,Ли мырза оны ашты.
Dialogue: 0,0:49:13.57,0:49:15.53,Default,,0,0,0,,Өтірік айтпайсың ба?
Dialogue: 0,0:49:15.66,0:49:17.91,Default,,0,0,0,,Мен сені бала емес деп ойладым.
Dialogue: 0,0:49:18.03,0:49:18.74,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:49:18.87,0:49:21.62,Default,,0,0,0,,Ағымдағы орналасқан жеріңізді жіберіңіз
Dialogue: 0,0:49:22.29,0:49:23.83,Default,,0,0,0,,Сіз сонда күзетіп тұрғаныңызға сенімдісіз бе?
Dialogue: 0,0:49:23.96,0:49:26.33,Default,,0,0,0,,Мен бірден келемін, сондықтан қозғалма.
Dialogue: 0,0:49:26.46,0:49:29.46,Default,,0,0,0,,Иә, түсіндім. Сау бол.
Dialogue: 0,0:49:29.59,0:49:30.63,Default,,0,0,0,,Алдау немесе емдеу!
Dialogue: 0,0:49:30.75,0:49:31.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:33.51,0:49:36.34,Default,,0,0,0,,Ия хахаха
Dialogue: 0,0:49:37.22,0:49:39.05,Default,,0,0,0,,Бірінші деңгей тазартылды.
Dialogue: 0,0:49:39.18,0:49:40.85,Default,,0,0,0,,Бұл кішкентай ғана нәрсе.
Dialogue: 0,0:49:41.72,0:49:43.98,Default,,0,0,0,,Сіз де солай істеп жүрсіз.
Dialogue: 0,0:49:44.10,0:49:44.94,Default,,0,0,0,,Адам өмірінің мәні тек осы ма?
Dialogue: 0,0:49:45.19,0:49:46.90,Default,,0,0,0,,Бұл қандай ойын түрі?
Dialogue: 0,0:49:49.23,0:49:51.90,Default,,0,0,0,,Ол бала ғой.
Dialogue: 0,0:49:52.28,0:49:55.40,Default,,0,0,0,,Хмм, әлгі ақымақтар.
Dialogue: 0,0:49:55.53,0:49:58.66,Default,,0,0,0,,Қай ғимарат және қандай бөлме?
Dialogue: 0,0:50:00.20,0:50:01.74,Default,,0,0,0,,Солитария допты...
Dialogue: 0,0:50:01.87,0:50:03.87,Default,,0,0,0,,Бір-бірлеп өшіріңіз
Dialogue: 0,0:50:04.00,0:50:05.21,Default,,0,0,0,,Және-
Dialogue: 0,0:50:05.33,0:50:08.46,Default,,0,0,0,,Соңында бір нәрсені қалдырсаңыз, сіз жеңесіз.
Dialogue: 0,0:50:08.58,0:50:10.63,Default,,0,0,0,,О, бітті.
Dialogue: 0,0:50:10.75,0:50:12.30,Default,,0,0,0,,Сіз жеңдіңіз бе?
Dialogue: 0,0:50:15.97,0:50:18.43,Default,,0,0,0,,Нағыз ойын басталғалы тұр.
Dialogue: 0,0:50:18.55,0:50:20.93,Default,,0,0,0,,Эй, сен не айтып тұрсың?
Dialogue: 0,0:50:23.01,0:50:24.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:24.14,0:50:26.73,Default,,0,0,0,,Мүмкін бұл доп шығар
Dialogue: 0,0:50:26.98,0:50:28.06,Default,,0,0,0,,Бұл жай ғана ойын
Dialogue: 0,0:50:28.31,0:50:29.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:50:33.19,0:50:36.61,Default,,0,0,0,,Уф, болмайды ғой, әзілдеп тұрсың ба?
Dialogue: 0,0:50:36.74,0:50:39.41,Default,,0,0,0,,Уф гохо гохо уф
Dialogue: 0,0:50:39.53,0:50:41.53,Default,,0,0,0,,Бір ғана нәрсе қалды
Dialogue: 0,0:50:42.20,0:50:44.87,Default,,0,0,0,,иә иә иә иә иә һә иә
Dialogue: 0,0:50:45.00,0:50:49.62,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:50:49.75,0:50:53.50,Default,,0,0,0,,Оу-у-у-у-у-у-у
Dialogue: 0,0:50:53.63,0:50:56.92,Default,,0,0,0,,(Лидің жөтелі)
Dialogue: 0,0:50:57.13,0:50:58.80,Default,,0,0,0,,(Лидің қатты тыныс алуы)
Dialogue: 0,0:51:00.14,0:51:00.80,Default,,0,0,0,,Уф
Dialogue: 0,0:51:25.95,0:51:27.08,Default,,0,0,0,,Иә
Dialogue: 0,0:51:27.50,0:51:30.42,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:51:30.54,0:51:31.75,Default,,0,0,0,,Уф
Dialogue: 0,0:51:32.25,0:51:33.67,Default,,0,0,0,,Бұл уф!
Dialogue: 0,0:51:33.79,0:51:37.17,Default,,0,0,0,,Мен Спорки Докейді кездестіре алмаймын.
Dialogue: 0,0:51:39.93,0:51:43.51,Default,,0,0,0,,Әй, қиналып қалдым, өлуім керек.
Dialogue: 0,0:51:44.47,0:51:46.64,Default,,0,0,0,,Оны қалпына келтіріңіз.
Dialogue: 0,0:51:47.10,0:51:48.18,Default,,0,0,0,,Ах
Dialogue: 0,0:51:49.06,0:51:52.19,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:51:52.40,0:51:53.98,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:52:13.88,0:52:18.38,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:52:19.17,0:52:20.01,Default,,0,0,0,,(шу)
Dialogue: 0,0:52:20.13,0:52:20.80,Default,,0,0,0,,Га
Dialogue: 0,0:52:21.01,0:52:21.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:24.26,0:52:25.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:31.69,0:52:33.06,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:52:36.77,0:52:38.23,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:52:38.36,0:52:40.99,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:52:41.11,0:52:44.28,Default,,0,0,0,,Ммм гехо ха ха ха
Dialogue: 0,0:52:44.70,0:52:47.62,Default,,0,0,0,,Ммм
Dialogue: 0,0:52:52.50,0:52:55.13,Default,,0,0,0,,Нгу ах
Dialogue: 0,0:52:56.17,0:52:57.50,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:52:57.63,0:52:58.80,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:52:59.46,0:53:00.63,Default,,0,0,0,,Ах
Dialogue: 0,0:53:01.05,0:53:03.59,Default,,0,0,0,,Гууууууууууууууууууууууу
Dialogue: 0,0:53:04.30,0:53:05.43,Default,,0,0,0,,Уф
Dialogue: 0,0:53:07.85,0:53:09.51,Default,,0,0,0,,Alpha One-дан шұғыл байланыс
Dialogue: 0,0:53:10.06,0:53:12.39,Default,,0,0,0,,Humpty Dumpty табылды
Dialogue: 0,0:53:12.52,0:53:13.27,Default,,0,0,0,,Ағымдағы орны -
Dialogue: 0,0:53:13.64,0:53:15.44,Default,,0,0,0,,Екі төрт ұпай бір бес
Dialogue: 0,0:53:15.56,0:53:16.73,Default,,0,0,0,,Жаяу саяхат
Dialogue: 0,0:53:17.02,0:53:18.23,Default,,0,0,0,,Мен бірден жолға шығамын.
Dialogue: 0,0:53:18.36,0:53:20.78,Default,,0,0,0,,Мен кеткенше маған тиіспе
Dialogue: 0,0:53:20.90,0:53:22.32,Default,,0,0,0,,Мен аяғымды шығарайын ба?
Dialogue: 0,0:53:26.78,0:53:28.74,Default,,0,0,0,,Бір жетіден бір сегізге дейін
Dialogue: 0,0:53:36.17,0:53:38.42,Default,,0,0,0,,Орталық вокзалға бет алу
Dialogue: 0,0:53:39.00,0:53:45.01,Default,,0,0,0,,♪～
Dialogue: 0,0:53:57.40,0:53:59.31,Default,,0,0,0,,Осылай мен саған еріп барамын.
Dialogue: 0,0:53:59.44,0:54:00.73,Default,,0,0,0,,Бір адам болса жеткілікті (Ер 4) Әй
Dialogue: 0,0:54:00.86,0:54:01.48,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:54:01.61,0:54:03.19,Default,,0,0,0,,Мен көлік сұраймын.
Dialogue: 0,0:54:07.53,0:54:08.62,Default,,0,0,0,,Әй
Dialogue: 0,0:54:10.83,0:54:12.41,Default,,0,0,0,,Эй (әйел) О
Dialogue: 0,0:54:20.09,0:54:21.71,Default,,0,0,0,,О ааа
Dialogue: 0,0:54:22.09,0:54:23.21,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:54:30.18,0:54:31.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:39.19,0:54:40.94,Default,,0,0,0,,Ммммммм ау
Dialogue: 0,0:54:42.36,0:54:43.07,Default,,0,0,0,,Эй
Dialogue: 0,0:54:54.04,0:54:55.20,Default,,0,0,0,,Уф
Dialogue: 0,0:54:57.96,0:54:59.17,Default,,0,0,0,,Уф
Dialogue: 0,0:55:12.43,0:55:13.56,Default,,0,0,0,,Уау
Dialogue: 0,0:55:13.89,0:55:15.10,Default,,0,0,0,,Уау
Dialogue: 0,0:55:15.22,0:55:16.18,Default,,0,0,0,,Кяах
Dialogue: 0,0:55:20.65,0:55:21.81,Default,,0,0,0,,Уф
Dialogue: 0,0:55:26.48,0:55:27.86,Default,,0,0,0,,Винсент
Dialogue: 0,0:55:29.20,0:55:32.16,Default,,0,0,0,,Жүзіңді білмесем де, иісіңнен білемін.
Dialogue: 0,0:55:32.49,0:55:35.99,Default,,0,0,0,,Мен сенен шыққан қан иісін жек көремін.
Dialogue: 0,0:55:36.62,0:55:38.50,Default,,0,0,0,,Боунти аңшысы?
Dialogue: 0,0:55:38.83,0:55:40.54,Default,,0,0,0,,Өзіңізді жаман сезінбеңіз
Dialogue: 0,0:55:40.67,0:55:44.00,Default,,0,0,0,,300,000,000,000,000,000,000,000,000,000,000,000,000,000,00,
Dialogue: 0,0:55:47.21,0:55:48.63,Default,,0,0,0,,Ия, оқ атылды
Dialogue: 0,0:55:48.76,0:55:50.30,Default,,0,0,0,,Уау
Dialogue: 0,0:55:59.23,0:56:00.48,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:56:01.56,0:56:02.19,Default,,0,0,0,,Уау
Dialogue: 0,0:56:08.53,0:56:10.15,Default,,0,0,0,,А... а?
Dialogue: 0,0:56:10.95,0:56:11.86,Default,,0,0,0,,Әй
Dialogue: 0,0:56:11.99,0:56:14.70,Default,,0,0,0,,Уау
Dialogue: 0,0:56:19.54,0:56:20.16,Default,,0,0,0,,Құт
Dialogue: 0,0:56:20.41,0:56:21.50,Default,,0,0,0,,Га
Dialogue: 0,0:56:31.72,0:56:33.18,Default,,0,0,0,,Түсіру туралы не айтасыз?
Dialogue: 0,0:56:33.30,0:56:34.47,Default,,0,0,0,,Не?
Dialogue: 0,0:56:34.59,0:56:35.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:35.97,0:56:38.39,Default,,0,0,0,,Күшті бастамасы ғана ма?
Dialogue: 0,0:56:40.27,0:56:41.31,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:56:41.68,0:56:43.02,Default,,0,0,0,,Мені өлтірме
Dialogue: 0,0:56:43.14,0:56:45.06,Default,,0,0,0,,Жүлде ақшасы номиналды болады.
Dialogue: 0,0:56:45.90,0:56:48.23,Default,,0,0,0,,Мен өлімнен қорықпаймын
Dialogue: 0,0:56:48.36,0:56:51.07,Default,,0,0,0,,Тек тыныш арманда
Dialogue: 0,0:56:51.57,0:56:54.32,Default,,0,0,0,,Мәңгілік болатын арман
Dialogue: 0,0:56:55.45,0:56:58.28,Default,,0,0,0,,Әй, ақымақ.
Dialogue: 0,0:57:29.52,0:57:30.28,Default,,0,0,0,,Га
Dialogue: 0,0:57:31.73,0:57:32.57,Default,,0,0,0,,Әй
Dialogue: 0,0:57:34.49,0:57:35.41,Default,,0,0,0,,Уф
Dialogue: 0,0:57:36.16,0:57:37.07,Default,,0,0,0,,Уф
Dialogue: 0,0:57:37.70,0:57:38.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:57:38.87,0:57:39.99,Default,,0,0,0,,Әй
Dialogue: 0,0:57:43.37,0:57:43.96,Default,,0,0,0,,Уф
Dialogue: 0,0:57:44.08,0:57:44.71,Default,,0,0,0,,Әй!
Dialogue: 0,0:57:44.87,0:57:45.96,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,0:57:46.08,0:57:48.00,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:57:55.72,0:57:56.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:56.89,0:58:01.26,Default,,0,0,0,,А, а, а, а...
Dialogue: 0,0:58:01.39,0:58:03.98,Default,,0,0,0,,Ах, аа, аа...
Dialogue: 0,0:58:04.89,0:58:06.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:06.90,0:58:08.40,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:58:09.56,0:58:10.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:10.82,0:58:11.98,Default,,0,0,0,,Гухаа
Dialogue: 0,0:58:12.23,0:58:17.11,Default,,0,0,0,,Гуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу.
Dialogue: 0,0:58:20.03,0:58:24.16,Default,,0,0,0,,Уф, хааааааааааааааааааааааааааа...
Dialogue: 0,0:58:30.92,0:58:33.51,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:58:36.34,0:58:38.97,Default,,0,0,0,,(Спайктың ыңырсыуы)
Dialogue: 0,0:58:48.60,0:58:53.15,Default,,0,0,0,,Гууууууууууууууууууууууууууууууу...
Dialogue: 0,0:58:54.28,0:58:55.36,Default,,0,0,0,,Есімді тыңдайық
Dialogue: 0,0:58:55.49,0:58:58.82,Default,,0,0,0,,Ух... Спайк Шпигель
Dialogue: 0,0:59:00.45,0:59:02.16,Default,,0,0,0,,Осы дүниенің соңында кездесейік
Dialogue: 0,0:59:02.28,0:59:03.24,Default,,0,0,0,,Винсент!
Dialogue: 0,0:59:03.37,0:59:03.99,Default,,0,0,0,,Ах
Dialogue: 0,0:59:04.12,0:59:10.12,Default,,0,0,0,,♪～
Dialogue: 0,0:59:26.02,0:59:26.68,Default,,0,0,0,,Га
Dialogue: 0,0:59:31.77,0:59:32.44,Default,,0,0,0,,Уф
Dialogue: 0,0:59:41.82,0:59:43.41,Default,,0,0,0,,Винсент
Dialogue: 0,0:59:44.53,0:59:45.87,Default,,0,0,0,,мен
Dialogue: 0,1:00:08.02,1:00:11.56,Default,,0,0,0,,Уф уф
Dialogue: 0,1:00:12.02,1:00:15.32,Default,,0,0,0,,(Жолаушылар жөтелді)
Dialogue: 0,1:00:19.28,1:00:20.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:26.20,1:00:26.87,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,1:00:39.30,1:00:40.92,Default,,0,0,0,,Винсент
Dialogue: 0,1:01:08.08,1:01:10.37,Default,,0,0,0,,Түсіндің бе, Спайк?
Dialogue: 0,1:01:11.79,1:01:14.33,Default,,0,0,0,,Бұл жақын қоңырау болды.
Dialogue: 0,1:01:16.13,1:01:18.04,Default,,0,0,0,,Ол қайтыс болды
Dialogue: 0,1:01:18.17,1:01:21.55,Default,,0,0,0,,Жоқ, ол басынан бастап өлді.
Dialogue: 0,1:01:23.38,1:01:25.47,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,1:01:48.74,1:01:52.50,Default,,0,0,0,,Өзеннің ағысына берілген адам...
Dialogue: 0,1:01:52.62,1:01:55.37,Default,,0,0,0,,Оның көзі білді
Dialogue: 0,1:02:01.21,1:02:02.67,Default,,0,0,0,,Рахмет
Dialogue: 0,1:02:05.34,1:02:07.26,Default,,0,0,0,,Не көрдің?
Dialogue: 0,1:02:07.39,1:02:10.64,Default,,0,0,0,,Көздерің жұмылып жатыр
Dialogue: 0,1:02:12.31,1:02:14.93,Default,,0,0,0,,Мен түс көрдім
Dialogue: 0,1:02:16.48,1:02:20.06,Default,,0,0,0,,Жоқ, қайсысы арман?
Dialogue: 0,1:02:20.86,1:02:22.28,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,1:02:23.11,1:02:26.28,Default,,0,0,0,,Бұл мені алғаш рет діріл етті...
Dialogue: 0,1:02:26.49,1:02:28.45,Default,,0,0,0,,Мен қорқыныштың дәмін таттым.
Dialogue: 0,1:02:30.28,1:02:33.70,Default,,0,0,0,,Егер бірдеңе аздап болса...
Dialogue: 0,1:02:35.04,1:02:36.66,Default,,0,0,0,,Мен өлдім
Dialogue: 0,1:02:38.58,1:02:43.76,Default,,0,0,0,,Менің ойымша, бұл сіздің өлуіңіз жақсы күн емес еді.
Dialogue: 0,1:02:48.55,1:02:50.68,Default,,0,0,0,,Жүзетін құс
Dialogue: 0,1:02:51.39,1:02:55.27,Default,,0,0,0,,Мына көк көздер бәрін көреді
Dialogue: 0,1:02:55.39,1:03:00.02,Default,,0,0,0,,Өткен, болашақ және бүгін
Dialogue: 0,1:03:00.81,1:03:05.03,Default,,0,0,0,,Барлығы ағып жатыр, бәрі байланысты
Dialogue: 0,1:03:05.32,1:03:08.32,Default,,0,0,0,,Бұл көздер шындыққа қарамайды
Dialogue: 0,1:03:08.45,1:03:11.87,Default,,0,0,0,,Мен шындықты сезінемін
Dialogue: 0,1:03:12.99,1:03:15.79,Default,,0,0,0,,Шындықтың көзін ашып, көр
Dialogue: 0,1:03:15.91,1:03:19.33,Default,,0,0,0,,Ештеңеден қорықпа
Dialogue: 0,1:03:21.58,1:03:25.21,Default,,0,0,0,,О, мен білемін.
Dialogue: 0,1:03:25.34,1:03:31.34,Default,,0,0,0,,♪～
Dialogue: 0,1:03:44.48,1:03:46.40,Default,,0,0,0,,Сіз тірі сияқтысыз
Dialogue: 0,1:03:50.57,1:03:51.74,Default,,0,0,0,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,1:03:52.62,1:03:53.99,Default,,0,0,0,,Винсент
Dialogue: 0,1:03:55.45,1:03:57.25,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,1:03:57.45,1:04:00.29,Default,,0,0,0,,Сіз басынан бері болмаған сияқтысыз.
Dialogue: 0,1:04:02.83,1:04:04.13,Default,,0,0,0,,Біз сияқты
Dialogue: 0,1:04:04.25,1:04:07.42,Default,,0,0,0,,Ол қауіпті нәрсеге аяғын басып қалған сияқты.
Dialogue: 0,1:04:07.88,1:04:08.84,Default,,0,0,0,,О
Dialogue: 0,1:04:08.97,1:04:11.38,Default,,0,0,0,,Баяғыда әкем айтатын.
Dialogue: 0,1:04:11.51,1:04:13.76,Default,,0,0,0,,Кеме теңізге шыққанда...
Dialogue: 0,1:04:13.89,1:04:15.30,Default,,0,0,0,,Біз жүзуді жалғастыруымыз керек пе?
Dialogue: 0,1:04:15.43,1:04:17.93,Default,,0,0,0,,Не батып бара жатыр, не батып бара жатыр.
Dialogue: 0,1:04:18.72,1:04:21.60,Default,,0,0,0,,Біз жай ғана сыйлық іздеушілерміз
Dialogue: 0,1:04:21.73,1:04:22.98,Default,,0,0,0,,Бұл жігіт қазірдің өзінде-
Dialogue: 0,1:04:23.10,1:04:25.73,Default,,0,0,0,,Бұл біздің қолымыздан келетін нәрсе емес.
Dialogue: 0,1:04:26.32,1:04:28.48,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,1:04:28.61,1:04:30.99,Default,,0,0,0,,Бұл мәселеге араласуды доғарыңыз.
Dialogue: 0,1:04:31.11,1:04:32.70,Default,,0,0,0,,Жақсы шыбық
Dialogue: 0,1:04:33.70,1:04:34.37,Default,,0,0,0,,Эй
Dialogue: 0,1:04:39.95,1:04:42.54,Default,,0,0,0,,Ол жақсы ұйықтайды.
Dialogue: 0,1:04:46.04,1:04:48.75,Default,,0,0,0,,Неліктен жалғыз әрекет еттіңіз?
Dialogue: 0,1:04:50.76,1:04:52.97,Default,,0,0,0,,Жауап бергіңіз келмей ме?
Dialogue: 0,1:04:53.30,1:04:55.43,Default,,0,0,0,,Бірақ бұл өзімшіл әрекет...
Dialogue: 0,1:04:55.55,1:05:00.39,Default,,0,0,0,,Бұл оқиғаның алдын алуға болмайтын себептердің бірі осы деп ойлайсыз ба?
Dialogue: 0,1:05:01.48,1:05:03.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:05:03.56,1:05:06.73,Default,,0,0,0,,Мен сізді біраз уақытқа ұстамды болуыңызды сұраймын.
Dialogue: 0,1:05:07.02,1:05:09.11,Default,,0,0,0,,Хабарландыру кейінірек болуы керек.
Dialogue: 0,1:05:09.23,1:05:10.94,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,1:05:14.82,1:05:18.83,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:05:19.54,1:05:20.87,Default,,0,0,0,,Қадағалауды назардан тыс қалдырмаңыз
Dialogue: 0,1:05:21.00,1:05:22.16,Default,,0,0,0,,Га
Dialogue: 0,1:05:22.71,1:05:24.75,Default,,0,0,0,,Жәбірленушінің белгілері бойынша және т.б.
Dialogue: 0,1:05:24.87,1:05:27.21,Default,,0,0,0,,Тіпті кешегі монорельстік апатта...
Dialogue: 0,1:05:27.34,1:05:28.79,Default,,0,0,0,,Өткен күні автоцистерна апатқа ұшырады...
Dialogue: 0,1:05:28.92,1:05:31.38,Default,,0,0,0,,Осыған ұқсас заттар қолданылған болуы мүмкін
Dialogue: 0,1:05:31.96,1:05:35.72,Default,,0,0,0,,-да? Бұл зат әлі белгісіз бе?
Dialogue: 0,1:05:35.84,1:05:37.60,Default,,0,0,0,,Қазіргі уақытта талдануда
Dialogue: 0,1:05:37.72,1:05:39.14,Default,,0,0,0,,Мысал мәлімдеме:
Dialogue: 0,1:05:39.26,1:05:41.22,Default,,0,0,0,,Уақыты белгіленген вирустың құрылымы...
Dialogue: 0,1:05:41.35,1:05:44.10,Default,,0,0,0,,Бұрынғы белгілі бір вирусқа өте ұқсас...
Dialogue: 0,1:05:44.23,1:05:46.48,Default,,0,0,0,,Ли есімді хакер екенін анықтады
Dialogue: 0,1:05:46.60,1:05:50.15,Default,,0,0,0,,Қазіргі уақытта оның деректері мен кіру бағыттарын тазалауда.
Dialogue: 0,1:05:50.27,1:05:53.24,Default,,0,0,0,,Адамның ұйымдастырушысы болуы мүмкін бе?
Dialogue: 0,1:05:53.36,1:05:54.49,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,1:05:54.61,1:05:55.53,Default,,0,0,0,,Кез келген жағдайда-
Dialogue: 0,1:05:55.66,1:05:58.78,Default,,0,0,0,,Террористік топпен байланысы бар кез келген адам
Dialogue: 0,1:05:58.91,1:06:00.66,Default,,0,0,0,,Терроризмнің мақсаты
Dialogue: 0,1:06:00.79,1:06:04.62,Default,,0,0,0,,Сіз қылмыскерсіз бе, әлде жай ғана ақша іздеп жүрсіз бе?
Dialogue: 0,1:06:05.46,1:06:07.12,Default,,0,0,0,,Талдануда
Dialogue: 0,1:06:07.75,1:06:11.71,Default,,0,0,0,,Осылардың барлығы талдау кезінде талданады ма?
Dialogue: 0,1:06:11.96,1:06:13.51,Default,,0,0,0,,Қанша уақыт күтуім керек?
Dialogue: 0,1:06:13.63,1:06:17.34,Default,,0,0,0,,Медициналық тексерудің қорытындысы жарты күннен кейін белгілі болады.
Dialogue: 0,1:06:33.36,1:06:35.70,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,1:06:35.82,1:06:37.07,Default,,0,0,0,,Не?
Dialogue: 0,1:06:37.20,1:06:39.74,Default,,0,0,0,,Менің аяғым ауыр.
Dialogue: 0,1:06:40.32,1:06:40.99,Default,,0,0,0,,Эй
Dialogue: 0,1:06:41.12,1:06:42.74,Default,,0,0,0,,Таптым!
Dialogue: 0,1:06:42.87,1:06:44.16,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,1:06:45.16,1:06:51.09,Default,,0,0,0,,♪Марл - меадама Марл әдемі
Dialogue: 0,1:06:51.21,1:06:57.47,Default,,0,0,0,,♪Қара жүзім тәтті аджи
Dialogue: 0,1:06:57.68,1:06:58.80,Default,,0,0,0,,болды
Dialogue: 0,1:06:58.93,1:07:00.97,Default,,0,0,0,,Чуриос медициналық
Dialogue: 0,1:07:01.10,1:07:02.18,Default,,0,0,0,,15 қазанда -
Dialogue: 0,1:07:02.30,1:07:04.77,Default,,0,0,0,,Автокөлікпен тасымалданған жүкті зерттеңіз.
Dialogue: 0,1:07:04.89,1:07:06.68,Default,,0,0,0,,Иә
Dialogue: 0,1:07:06.81,1:07:08.48,Default,,0,0,0,,Спайк Мен не айтарымды білмеймін
Dialogue: 0,1:07:08.60,1:07:11.61,Default,,0,0,0,,Мен білемін, жай ғана қарап шығыңыз.
Dialogue: 0,1:07:11.90,1:07:14.07,Default,,0,0,0,,Мен уайымдап, ұйықтай алмаймын
Dialogue: 0,1:07:14.44,1:07:16.15,Default,,0,0,0,,Сіз тым көп ұйықтайсыз
Dialogue: 0,1:07:16.28,1:07:19.49,Default,,0,0,0,,♪мммммммм
Dialogue: 0,1:07:19.66,1:07:25.33,Default,,0,0,0,,♪мммммммммммм
Dialogue: 0,1:07:25.45,1:07:28.66,Default,,0,0,0,,Жүк жүк көлігінің багажы
Dialogue: 0,1:07:28.79,1:07:32.00,Default,,0,0,0,,Наками - макадамия жаңғағы
Dialogue: 0,1:07:32.13,1:07:33.84,Default,,0,0,0,,Макадамия жаңғағы?
Dialogue: 0,1:07:33.96,1:07:35.84,Default,,0,0,0,,Жеуге болмайтын бұршақтар
Dialogue: 0,1:07:35.96,1:07:38.22,Default,,0,0,0,,Іздеу
Dialogue: 0,1:07:38.59,1:07:40.55,Default,,0,0,0,,Макадамия жаңғақтарын басқару бөлімі
Dialogue: 0,1:07:40.68,1:07:43.64,Default,,0,0,0,,Макадамия жаңғағын зерттеу және дамыту бөлімі
Dialogue: 0,1:07:43.76,1:07:46.85,Default,,0,0,0,,Бұршақтарға көп күш салған сияқты.
Dialogue: 0,1:07:46.97,1:07:49.85,Default,,0,0,0,,Эд Макадамия жаңғақтарды зерттеу және дамыту бөлімі.
Dialogue: 0,1:07:49.98,1:07:50.90,Default,,0,0,0,,Ай
Dialogue: 0,1:07:53.23,1:07:55.32,Default,,0,0,0,,Бұл бөлімде не істегенімді білесіз бе?
Dialogue: 0,1:07:55.44,1:07:56.53,Default,,0,0,0,,Ня
Dialogue: 0,1:07:59.36,1:08:00.53,Default,,0,0,0,,Теңіз кірпілері
Dialogue: 0,1:08:00.65,1:08:03.20,Default,,0,0,0,,Эддің бұзу бағдарламасы бұзылған
Dialogue: 0,1:08:03.32,1:08:05.49,Default,,0,0,0,,Не? Осы уақытқа дейін келдіңіз бе?
Dialogue: 0,1:08:05.62,1:08:06.45,Default,,0,0,0,,Ред
Dialogue: 0,1:08:06.58,1:08:09.04,Default,,0,0,0,,Бұл жігіттің профилін басқа маршрут арқылы тексеріңіз.
Dialogue: 0,1:08:09.16,1:08:10.87,Default,,0,0,0,,Уау
Dialogue: 0,1:08:13.38,1:08:15.42,Default,,0,0,0,,«Доктор Мендело Аль Хедиа»
Dialogue: 0,1:08:15.54,1:08:19.22,Default,,0,0,0,,«Бұрынғы SIT профессоры және наномашиналарды зерттеу бойынша жетекші сарапшы»
Dialogue: 0,1:08:19.34,1:08:20.63,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:08:20.76,1:08:22.84,Default,,0,0,0,,Бұл фармацевтикалық компания емес.
Dialogue: 0,1:08:22.97,1:08:25.47,Default,,0,0,0,,Олар сахнаның артында наномашиналық қару жасауда.
Dialogue: 0,1:08:25.60,1:08:27.10,Default,,0,0,0,,Ал өлген Винсент...
Dialogue: 0,1:08:27.22,1:08:29.64,Default,,0,0,0,,Сонда сіз оны шығардыңыз ба?
Dialogue: 0,1:08:29.85,1:08:31.94,Default,,0,0,0,,Наномашиналарды әскери мақсатта пайдалану...
Dialogue: 0,1:08:32.06,1:08:35.27,Default,,0,0,0,,Бұған Амстердам келісімі бойынша тыйым салынуы керек.
Dialogue: 0,1:08:35.40,1:08:37.82,Default,,0,0,0,,Егер бұл жігіт бірдеңе жоспарлап жатса...
Dialogue: 0,1:08:37.94,1:08:40.53,Default,,0,0,0,,Әскерилер міндетті түрде оны жасыруға тырысады.
Dialogue: 0,1:08:41.24,1:08:44.07,Default,,0,0,0,,Бірақ ол тірі.
Dialogue: 0,1:08:47.37,1:08:48.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:59.88,1:09:01.13,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:09:09.31,1:09:10.47,Default,,0,0,0,,Стив
Dialogue: 0,1:09:10.60,1:09:13.43,Default,,0,0,0,,Эй Электра, саған не керек?
Dialogue: 0,1:09:18.31,1:09:19.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:09:19.40,1:09:21.03,Default,,0,0,0,,Біреудің қаны?
Dialogue: 0,1:09:21.69,1:09:23.82,Default,,0,0,0,,Мен сіздің жеке тергеуіңізді сұраймын.
Dialogue: 0,1:09:24.16,1:09:26.91,Default,,0,0,0,,Олай болса, мені осы жолы кездесуге шақыруға қарсы ма?
Dialogue: 0,1:09:27.41,1:09:28.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:28.45,1:09:29.62,Default,,0,0,0,,Хмм...
Dialogue: 0,1:09:30.91,1:09:31.79,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,1:09:31.91,1:09:32.58,Default,,0,0,0,,Жарайды
Dialogue: 0,1:09:32.71,1:09:35.46,Default,,0,0,0,,Сонымен, Хэллоуинге арналған кешкі асқа тапсырыс беру туралы не айтасыз?
Dialogue: 0,1:09:37.75,1:09:43.76,Default,,0,0,0,,♪～
Dialogue: 0,1:10:06.66,1:10:08.45,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:10:10.24,1:10:12.58,Default,,0,0,0,,Мен неге тірімін?
Dialogue: 0,1:10:13.83,1:10:15.92,Default,,0,0,0,,Маған не істедің?
Dialogue: 0,1:10:17.83,1:10:19.54,Default,,0,0,0,,Қанымды бөлістім
Dialogue: 0,1:10:19.67,1:10:20.50,Default,,0,0,0,,Га
Dialogue: 0,1:10:21.84,1:10:23.88,Default,,0,0,0,,Бұл дүние сыртқа бұрылса да, сен...
Dialogue: 0,1:10:24.01,1:10:25.59,Default,,0,0,0,,Тірі қалады
Dialogue: 0,1:10:26.13,1:10:27.84,Default,,0,0,0,,Мен сияқты
Dialogue: 0,1:10:28.64,1:10:32.01,Default,,0,0,0,,Ол уақыт жақын арада келеді
Dialogue: 0,1:10:39.65,1:10:42.02,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені таптыңыз ба?
Dialogue: 0,1:10:46.90,1:10:47.91,Default,,0,0,0,,Иә
Dialogue: 0,1:10:48.03,1:10:50.82,Default,,0,0,0,,Жоқ, олардың бәрі маған қажет емес заттар.
Dialogue: 0,1:10:50.95,1:10:53.20,Default,,0,0,0,,Дүниедегі жағдай дәл солай.
Dialogue: 0,1:10:53.33,1:10:54.37,Default,,0,0,0,,Әпкем…
Dialogue: 0,1:10:54.50,1:10:57.87,Default,,0,0,0,,Кейбір адамдар өзіне қажет емес нәрселерді жасауға батылы барады.
Dialogue: 0,1:10:58.54,1:10:59.96,Default,,0,0,0,,Оны біреу жасады
Dialogue: 0,1:11:00.29,1:11:01.21,Default,,0,0,0,,Жындар
Dialogue: 0,1:11:03.34,1:11:05.46,Default,,0,0,0,,Иә
Dialogue: 0,1:11:05.84,1:11:08.26,Default,,0,0,0,,Ол затты маған не үшін бердіңіз?
Dialogue: 0,1:11:08.38,1:11:10.76,Default,,0,0,0,,Бұл тамаша қазан болды.
Dialogue: 0,1:11:11.01,1:11:13.39,Default,,0,0,0,,Бұл ішіндегі сыйлық.
Dialogue: 0,1:11:13.68,1:11:16.43,Default,,0,0,0,,Лимфоциттерге ұқсас наномашиналар
Dialogue: 0,1:11:16.56,1:11:17.73,Default,,0,0,0,,Доктор Мендело
Dialogue: 0,1:11:18.48,1:11:20.98,Default,,0,0,0,,Иә
Dialogue: 0,1:11:21.15,1:11:22.65,Default,,0,0,0,,Фуфу
Dialogue: 0,1:11:23.69,1:11:28.57,Default,,0,0,0,,Осыдан үш жыл бұрын бір адам осы қалаға қашып кеткен.
Dialogue: 0,1:11:29.11,1:11:30.74,Default,,0,0,0,,Ол осылай деді
Dialogue: 0,1:11:30.86,1:11:34.03,Default,,0,0,0,,Менің ойымша, сіз қорқынышты нәрсе жасадыңыз.
Dialogue: 0,1:11:34.83,1:11:38.71,Default,,0,0,0,,Контактілі инфекция немесе ауа-тамшылы инфекциясы...
Dialogue: 0,1:11:38.83,1:11:41.63,Default,,0,0,0,,Ол қалағаныңызды жасауға бағдарламаланған.
Dialogue: 0,1:11:41.88,1:11:44.67,Default,,0,0,0,,Содан кейін ол қанға еніп, өздігінен көбейеді...
Dialogue: 0,1:11:44.80,1:11:48.22,Default,,0,0,0,,Лимфоциттерді еліктеп, еркін қозғалады
Dialogue: 0,1:11:48.59,1:11:52.05,Default,,0,0,0,,Сосын миға еніп, оны бұзады.
Dialogue: 0,1:11:52.80,1:11:54.56,Default,,0,0,0,,Өзіңізді бөлшектеңіз -
Dialogue: 0,1:11:54.68,1:11:56.68,Default,,0,0,0,,Белок түрінде шығарылады
Dialogue: 0,1:11:56.81,1:11:59.52,Default,,0,0,0,,Ешбір із қалдырмаңыз
Dialogue: 0,1:11:59.73,1:12:02.52,Default,,0,0,0,,Ол осылай бағдарламаланған сияқты.
Dialogue: 0,1:12:03.15,1:12:06.15,Default,,0,0,0,,Мен бір ғана нәрсені білгім келеді.
Dialogue: 0,1:12:07.90,1:12:10.36,Default,,0,0,0,,Неліктен Винсент әлі тірі?
Dialogue: 0,1:12:15.62,1:12:18.00,Default,,0,0,0,,Не істегің келеді?
Dialogue: 0,1:12:19.33,1:12:22.71,Default,,0,0,0,,Ақша іздеп жүрсіз бе? Қандай да бір өшпенділік бар
Dialogue: 0,1:12:22.83,1:12:25.88,Default,,0,0,0,,Әлде көңілді жүрсің бе?
Dialogue: 0,1:12:26.34,1:12:30.80,Default,,0,0,0,,Мен есікті іздеп жүрмін.
Dialogue: 0,1:12:31.55,1:12:32.63,Default,,0,0,0,,Есік…
Dialogue: 0,1:12:33.14,1:12:37.43,Default,,0,0,0,,Мен армандасам да, оның арман екенін түсінсем де...
Dialogue: 0,1:12:37.56,1:12:39.60,Default,,0,0,0,,Әлі де оянған жоқ
Dialogue: 0,1:12:39.98,1:12:42.10,Default,,0,0,0,,Сізде мұндай жағдай болды ма?
Dialogue: 0,1:12:43.81,1:12:45.27,Default,,0,0,0,,Иә, Терренс Т. Дерби.
Dialogue: 0,1:12:46.32,1:12:49.74,Default,,0,0,0,,Мен Титанда болғаннан бері солай болды.
Dialogue: 0,1:12:51.70,1:12:54.41,Default,,0,0,0,,Винсент тәжірибелік корпус болды.
Dialogue: 0,1:12:54.66,1:12:57.03,Default,,0,0,0,,Адам Винсенттің қанында -
Dialogue: 0,1:12:57.16,1:13:00.04,Default,,0,0,0,,Мен қарсы наномашинаны отырғыздым.
Dialogue: 0,1:13:00.75,1:13:02.62,Default,,0,0,0,,Қарсы наномашиналар?
Dialogue: 0,1:13:03.33,1:13:06.63,Default,,0,0,0,,Наномашиналар сияқты жұқтырады және таралады.
Dialogue: 0,1:13:07.17,1:13:09.30,Default,,0,0,0,,Наномашиналарды тоқтату
Dialogue: 0,1:13:09.80,1:13:12.42,Default,,0,0,0,,Сонымен, бұл вакцина тәжірибесі болды.
Dialogue: 0,1:13:13.22,1:13:15.43,Default,,0,0,0,,Қарқынды тоқтата алатын адам...
Dialogue: 0,1:13:15.55,1:13:17.72,Default,,0,0,0,,Ол бақылаудан шығып кетті.
Dialogue: 0,1:13:18.89,1:13:21.31,Default,,0,0,0,,Мен Винсенттің мақсаты не екенін білмеймін.
Dialogue: 0,1:13:21.81,1:13:23.85,Default,,0,0,0,,Мақсаты болмауы мүмкін
Dialogue: 0,1:13:23.98,1:13:25.44,Default,,0,0,0,,Дүниенің ақырында-
Dialogue: 0,1:13:25.56,1:13:28.73,Default,,0,0,0,,Үкім келетін күнді күтіп жүрген шығарсың.
Dialogue: 0,1:13:30.98,1:13:31.99,Default,,0,0,0,,Доктор Мендело –
Dialogue: 0,1:13:32.11,1:13:34.20,Default,,0,0,0,,Сізде бәрі бар емес пе?
Dialogue: 0,1:13:34.32,1:13:36.95,Default,,0,0,0,,Наномашиналар және вакциналар
Dialogue: 0,1:13:37.91,1:13:40.87,Default,,0,0,0,,Ер адам барлық зерттеу деректерін өшірді...
Dialogue: 0,1:13:40.99,1:13:43.08,Default,,0,0,0,,Әскерден хабарсыз кеткен
Dialogue: 0,1:13:43.21,1:13:46.54,Default,,0,0,0,,Антидоты жоқ уды қолдануға болмайды.
Dialogue: 0,1:13:46.67,1:13:48.00,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,1:13:49.59,1:13:51.71,Default,,0,0,0,,Ер адам енді мұнда жоқ
Dialogue: 0,1:13:51.84,1:13:53.05,Default,,0,0,0,,жоқ
Dialogue: 0,1:13:54.34,1:13:57.80,Default,,0,0,0,,Винсентті ешкім тоқтата алмайды
Dialogue: 0,1:13:59.81,1:14:03.06,Default,,0,0,0,,Титанда мен екі нәрсені жоғалттым.
Dialogue: 0,1:14:03.18,1:14:05.23,Default,,0,0,0,,Бірі – өткен
Dialogue: 0,1:14:07.65,1:14:11.57,Default,,0,0,0,,Ол кезде жау да, одақтас та болған жоқ...
Dialogue: 0,1:14:11.69,1:14:15.28,Default,,0,0,0,,Наномашиналық қарулармен тәжірибе жасау үшін ғана.
Dialogue: 0,1:14:15.40,1:14:17.36,Default,,0,0,0,,Барлығы өлтірілді
Dialogue: 0,1:14:17.99,1:14:20.08,Default,,0,0,0,,Мені эксперименттік топ ретінде жіберді.
Dialogue: 0,1:14:21.24,1:14:23.95,Default,,0,0,0,,Бір ғана адам аман қалды
Dialogue: 0,1:14:24.83,1:14:28.71,Default,,0,0,0,,Бірақ мен есте сақтау қабілетімді жоғалтып алдым.
Dialogue: 0,1:14:29.42,1:14:32.92,Default,,0,0,0,,Мен енді кім екенімді де білмей қалдым.
Dialogue: 0,1:14:34.67,1:14:37.09,Default,,0,0,0,,Басқасы қандай?
Dialogue: 0,1:14:37.22,1:14:38.72,Default,,0,0,0,,Сен көбелекті көрдің
Dialogue: 0,1:14:38.84,1:14:39.76,Default,,0,0,0,,Ах
Dialogue: 0,1:14:41.05,1:14:43.52,Default,,0,0,0,,Сансыз көбелектер көрдім
Dialogue: 0,1:14:44.52,1:14:47.69,Default,,0,0,0,,Бұл дүниеден тыс болып көрінетін көбелек
Dialogue: 0,1:14:55.90,1:14:58.45,Default,,0,0,0,,Наномашиналар миға жеткенде -
Dialogue: 0,1:14:58.57,1:15:00.24,Default,,0,0,0,,Жарықты көретінін айтады.
Dialogue: 0,1:15:01.16,1:15:03.12,Default,,0,0,0,,Бұл...
Dialogue: 0,1:15:03.58,1:15:07.16,Default,,0,0,0,,Дүниедегі ең әдемі көбелек
Dialogue: 0,1:15:16.92,1:15:19.18,Default,,0,0,0,,Сіз тым ұзақ сөйледіңіз.
Dialogue: 0,1:15:20.84,1:15:22.10,Default,,0,0,0,,Рашид
Dialogue: 0,1:15:23.39,1:15:25.56,Default,,0,0,0,,Дәрігерге беріңіз.
Dialogue: 0,1:15:27.06,1:15:28.98,Default,,0,0,0,,Уау
Dialogue: 0,1:15:30.23,1:15:32.61,Default,,0,0,0,,Қайта кездессек, жақсы.
Dialogue: 0,1:15:33.77,1:15:35.61,Default,,0,0,0,,Мұны істейік
Dialogue: 0,1:15:35.90,1:15:37.61,Default,,0,0,0,,Уау
Dialogue: 0,1:15:41.53,1:15:44.87,Default,,0,0,0,,Инчаара
Dialogue: 0,1:15:48.46,1:15:49.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:15:49.46,1:15:50.12,Default,,0,0,0,,Га
Dialogue: 0,1:15:51.21,1:15:51.83,Default,,0,0,0,,Уф
Dialogue: 0,1:16:04.76,1:16:06.97,Default,,0,0,0,,Түсіндіре аласыз ба, полковник?
Dialogue: 0,1:16:07.35,1:16:11.35,Default,,0,0,0,,Осыны маған түсіндіріп беруіңізді қалаймын, лейтенант.
Dialogue: 0,1:16:11.48,1:16:15.19,Default,,0,0,0,,Қаныңыздағы қарсы наномашиналар туралы.
Dialogue: 0,1:16:15.32,1:16:16.61,Default,,0,0,0,,Га
Dialogue: 0,1:16:16.82,1:16:19.82,Default,,0,0,0,,Маяктың астында шынымен қараңғы.
Dialogue: 0,1:16:20.49,1:16:22.86,Default,,0,0,0,,Винсент үшін ғана қолданылуы керек нәрсе...
Dialogue: 0,1:16:22.99,1:16:25.95,Default,,0,0,0,,Неліктен мен сені жұқтырдым?
Dialogue: 0,1:16:26.08,1:16:27.83,Default,,0,0,0,,Сіз онымен байланыста болдыңыз ба?
Dialogue: 0,1:16:29.79,1:16:32.50,Default,,0,0,0,,Ақпараттың сыртқа шығуын болдырмау үшін сізді ұстайды.
Dialogue: 0,1:16:32.62,1:16:33.58,Default,,0,0,0,,Полковник
Dialogue: 0,1:16:33.71,1:16:35.71,Default,,0,0,0,,Менің ішімде вакцина болса
Dialogue: 0,1:16:35.84,1:16:39.21,Default,,0,0,0,,Оны өсіруге және оны бейбіт тұрғындарға пайдалануға мүмкіндік болуы керек.
Dialogue: 0,1:16:39.34,1:16:41.17,Default,,0,0,0,,Түсінбеген сияқтысың.
Dialogue: 0,1:16:41.30,1:16:42.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:42.38,1:16:44.89,Default,,0,0,0,,Біздің мақсатымыз наномашиналармен байланысты.
Dialogue: 0,1:16:45.01,1:16:48.93,Default,,0,0,0,,Мен сізге бұл барлық ақпаратты өшіруді білдіретінін айттым.
Dialogue: 0,1:16:49.22,1:16:53.52,Default,,0,0,0,,Болмауы керек нәрсе болмауы керек.
Dialogue: 0,1:17:05.78,1:17:06.41,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,1:17:07.16,1:17:08.24,Default,,0,0,0,,Ах
Dialogue: 0,1:17:13.67,1:17:18.46,Default,,0,0,0,,Менің ойымша, бізде қандай қарым-қатынас бар.
Dialogue: 0,1:17:19.50,1:17:22.38,Default,,0,0,0,,Күшті жолдастық сезім емес
Dialogue: 0,1:17:22.51,1:17:25.26,Default,,0,0,0,,Мұндай байланыс жоқ.
Dialogue: 0,1:17:25.39,1:17:27.35,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз...
Dialogue: 0,1:17:27.47,1:17:29.89,Default,,0,0,0,,Қалағаныңызша оралыңыз.
Dialogue: 0,1:17:30.02,1:17:32.43,Default,,0,0,0,,Мені үнемі итеріп жібереді
Dialogue: 0,1:17:33.27,1:17:34.98,Default,,0,0,0,,Жетеді.
Dialogue: 0,1:17:35.10,1:17:37.73,Default,,0,0,0,,Жалғыз қалған кезді сағындым
Dialogue: 0,1:17:43.78,1:17:47.37,Default,,0,0,0,,Тағы бір жүріс, мен жеңдім.
Dialogue: 0,1:17:53.50,1:17:55.79,Default,,0,0,0,,О, Айн
Dialogue: 0,1:17:55.92,1:17:58.21,Default,,0,0,0,,Кун...
Dialogue: 0,1:18:00.63,1:18:03.17,Default,,0,0,0,,Иә
Dialogue: 0,1:18:03.30,1:18:05.18,Default,,0,0,0,,Кун Кун Кун Кун Кун Кун
Dialogue: 0,1:18:05.30,1:18:09.72,Default,,0,0,0,,Қайтып келмесе маған бәрібір
Dialogue: 0,1:18:10.76,1:18:12.85,Default,,0,0,0,,Бәс дәл мен күткендей шықты.
Dialogue: 0,1:18:13.60,1:18:15.35,Default,,0,0,0,,Сол кезде айтайын деп едім.
Dialogue: 0,1:18:15.48,1:18:18.36,Default,,0,0,0,,Егер монета құйрық болып шықса, кездесуге барайық.
Dialogue: 0,1:18:18.56,1:18:22.11,Default,,0,0,0,,Бұл кездесуге бару үшін өте қаңырап бос жер.
Dialogue: 0,1:18:23.78,1:18:25.07,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,1:18:25.20,1:18:26.45,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,1:18:27.49,1:18:29.37,Default,,0,0,0,,Сіз осы жерден кеткенде-
Dialogue: 0,1:18:29.57,1:18:32.33,Default,,0,0,0,,Сіздің жадыңыз жойылды ма немесе өлтірілді ме?
Dialogue: 0,1:18:33.12,1:18:36.29,Default,,0,0,0,,Қалай болғанда да, сіздің осы уақытқа дейінгі өміріңіз жойылады.
Dialogue: 0,1:18:37.46,1:18:39.96,Default,,0,0,0,,Тірі болсаң да өлісің
Dialogue: 0,1:18:40.09,1:18:42.00,Default,,0,0,0,,Винсент ұнайды ма?
Dialogue: 0,1:18:43.84,1:18:45.34,Default,,0,0,0,,Егер сіз монорельсті апатқа ұшырасаңыз да...
Dialogue: 0,1:18:45.47,1:18:47.26,Default,,0,0,0,,Тірі болу дегеніміз...
Dialogue: 0,1:18:47.38,1:18:49.14,Default,,0,0,0,,Бұл сіздің де ішіңізде, солай ма?
Dialogue: 0,1:18:49.26,1:18:53.27,Default,,0,0,0,,Наномашиналар деп аталатын вакцина сияқты нәрсе.
Dialogue: 0,1:18:53.52,1:18:55.18,Default,,0,0,0,,Сен бәрін білесің.
Dialogue: 0,1:18:55.31,1:18:57.48,Default,,0,0,0,,Сіз маған айтқандай.
Dialogue: 0,1:18:57.60,1:18:58.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:58.81,1:19:01.44,Default,,0,0,0,,Көп білу өмірді қысқартады.
Dialogue: 0,1:19:03.65,1:19:06.07,Default,,0,0,0,,Менің ойымша, ол жай ғана сыйлық іздеуші емес.
Dialogue: 0,1:19:06.19,1:19:08.20,Default,,0,0,0,,Спайк Шпигель
Dialogue: 0,1:19:08.32,1:19:09.87,Default,,0,0,0,,Егер сіз жай ғана солдат болсаңыз...
Dialogue: 0,1:19:09.99,1:19:11.58,Default,,0,0,0,,Бұл ысырап емес пе?
Dialogue: 0,1:19:12.16,1:19:13.62,Default,,0,0,0,,Электр
Dialogue: 0,1:19:13.74,1:19:15.62,Default,,0,0,0,,Электра Овилова
Dialogue: 0,1:19:16.54,1:19:18.21,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,1:19:18.33,1:19:19.67,Default,,0,0,0,,Күшті есім сияқты естіледі.
Dialogue: 0,1:19:19.88,1:19:21.13,Default,,0,0,0,,Га
Dialogue: 0,1:19:23.00,1:19:24.38,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:19:27.67,1:19:29.72,Default,,0,0,0,,Мен көптен бері білмедім
Dialogue: 0,1:19:29.84,1:19:32.76,Default,,0,0,0,,Менің ішімде мұндай нәрсе бар екеніне сене алар емеспін.
Dialogue: 0,1:19:38.81,1:19:40.52,Default,,0,0,0,,Винсент -
Dialogue: 0,1:19:41.44,1:19:45.15,Default,,0,0,0,,Ол туылғаннан бері жалғыз болды.
Dialogue: 0,1:19:46.36,1:19:50.28,Default,,0,0,0,,Кішкентай кезімнен маған тек жекпе-жек пен дұшпандық берілген.
Dialogue: 0,1:19:50.91,1:19:53.45,Default,,0,0,0,,Мені ешкім жақсы көрген емес.
Dialogue: 0,1:19:54.99,1:19:58.50,Default,,0,0,0,,Сондықтан мен оны құтқарғым келді.
Dialogue: 0,1:19:59.46,1:20:01.46,Default,,0,0,0,,Мен сені құтқарамын деп ойладым.
Dialogue: 0,1:20:01.88,1:20:03.92,Default,,0,0,0,,Бірақ мен қателесіппін.
Dialogue: 0,1:20:04.84,1:20:08.30,Default,,0,0,0,,Ол кезде Винсент монорельсте болатын...
Dialogue: 0,1:20:08.59,1:20:10.38,Default,,0,0,0,,Бұрын көрмеген адамға қарап тұрғандай.
Dialogue: 0,1:20:10.51,1:20:11.97,Default,,0,0,0,,мені көрді
Dialogue: 0,1:20:13.35,1:20:16.31,Default,,0,0,0,,Мен одан жоғалып кеттім.
Dialogue: 0,1:20:18.73,1:20:20.77,Default,,0,0,0,,Сіз оған ғашық болдыңыз ба?
Dialogue: 0,1:20:22.15,1:20:24.27,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,1:20:25.32,1:20:26.82,Default,,0,0,0,,Өз ішімде-
Dialogue: 0,1:20:26.94,1:20:29.65,Default,,0,0,0,,Мен білмеген сезімдер толып кетті...
Dialogue: 0,1:20:29.95,1:20:31.99,Default,,0,0,0,,Мен бұл не екенін білмеймін ...
Dialogue: 0,1:20:32.11,1:20:34.28,Default,,0,0,0,,Менің жүрегім ауырады...
Dialogue: 0,1:20:34.41,1:20:37.12,Default,,0,0,0,,Сізде мұндай жағдай болды ма?
Dialogue: 0,1:20:38.58,1:20:39.79,Default,,0,0,0,,Ариса
Dialogue: 0,1:20:40.25,1:20:41.62,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,1:20:42.29,1:20:46.13,Default,,0,0,0,,Мен құтқарылғым келгеніме сенімдімін.
Dialogue: 0,1:20:47.05,1:20:51.76,Default,,0,0,0,,Бұл баяғыда, менің жас кезім еді.
Dialogue: 0,1:20:53.18,1:20:55.93,Default,,0,0,0,,Мен ештеңеден қорықпадым
Dialogue: 0,1:20:56.18,1:21:00.10,Default,,0,0,0,,Мен тіпті өлуден де қорықпадым.
Dialogue: 0,1:21:00.56,1:21:03.02,Default,,0,0,0,,Мен кез келген уақытта өлемін деп ойладым.
Dialogue: 0,1:21:04.56,1:21:07.11,Default,,0,0,0,,Бірақ әйелмен кездескеннен кейін...
Dialogue: 0,1:21:07.23,1:21:10.86,Default,,0,0,0,,Мен аман қалғым келеді деп ойлай бастадым.
Dialogue: 0,1:21:11.36,1:21:15.16,Default,,0,0,0,,Мен алғаш рет өлуден қорқамын деп ойлай бастадым.
Dialogue: 0,1:21:15.28,1:21:18.45,Default,,0,0,0,,Я, мен оған дейін мұндай сезімді білмедім.
Dialogue: 0,1:21:21.00,1:21:23.46,Default,,0,0,0,,Бұл адам қазір кім?
Dialogue: 0,1:21:23.62,1:21:25.79,Default,,0,0,0,,Бір жерде жоғалып кетті
Dialogue: 0,1:21:26.67,1:21:29.71,Default,,0,0,0,,Я, бұл біртүрлі.
Dialogue: 0,1:21:29.92,1:21:33.47,Default,,0,0,0,,Сіз мұны маған бірінші айтқан адамсыз.
Dialogue: 0,1:21:35.59,1:21:38.31,Default,,0,0,0,,Неліктен Винсент?
Dialogue: 0,1:21:38.51,1:21:41.56,Default,,0,0,0,,Оның иісі мен сияқты.
Dialogue: 0,1:21:42.89,1:21:45.77,Default,,0,0,0,,Сондықтан мен онымен кездескім келеді.
Dialogue: 0,1:22:00.16,1:22:01.41,Default,,0,0,0,,...
Dialogue: 0,1:22:02.45,1:22:05.29,Default,,0,0,0,,Хи хи хи ха хаааа
Dialogue: 0,1:22:06.17,1:22:10.92,Default,,0,0,0,,Әлгі жігіт, менің ойымша, масақ тәрізді бірдеңе деді.
Dialogue: 0,1:22:13.42,1:22:16.84,Default,,0,0,0,,Түсіндім, сенің досың?
Dialogue: 0,1:22:17.30,1:22:18.93,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,1:22:19.47,1:22:21.51,Default,,0,0,0,,Неден бастаймыз?
Dialogue: 0,1:22:22.02,1:22:25.31,Default,,0,0,0,,Мен мұны аяқтауға келдім.
Dialogue: 0,1:22:26.52,1:22:29.44,Default,,0,0,0,,Соңғы кеш басталғалы тұр
Dialogue: 0,1:22:30.44,1:22:33.86,Default,,0,0,0,,Келесі трюк арнайы наномашина.
Dialogue: 0,1:22:34.61,1:22:37.86,Default,,0,0,0,,Өшпестен таралу.
Dialogue: 0,1:22:38.03,1:22:39.82,Default,,0,0,0,,Жақында әлем
Dialogue: 0,1:22:40.45,1:22:43.37,Default,,0,0,0,,Сіз әлемді өзіңізбен бірге алып кетуді жоспарлап отырсыз ба?
Dialogue: 0,1:22:43.87,1:22:47.37,Default,,0,0,0,,Сен жындысың
Dialogue: 0,1:22:47.50,1:22:49.29,Default,,0,0,0,,Бұл Коичи деген жігіт қой! Ә?
Dialogue: 0,1:22:50.54,1:22:54.34,Default,,0,0,0,,Кім қалыпты және қалыптан тыс шекараны сала алады?
Dialogue: 0,1:22:54.92,1:22:57.34,Default,,0,0,0,,Кездейсоқ мүмкіндікке байланысты орын ауыстырмасақ...
Dialogue: 0,1:22:57.47,1:22:59.09,Default,,0,0,0,,Кім айта алады?
Dialogue: 0,1:22:59.76,1:23:01.68,Default,,0,0,0,,Жақында білетін боласыз
Dialogue: 0,1:23:02.76,1:23:06.23,Default,,0,0,0,,Бұл дүние жынды болса керек.
Dialogue: 0,1:23:08.19,1:23:09.81,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,1:23:10.61,1:23:11.23,Default,,0,0,0,,Га
Dialogue: 0,1:23:12.07,1:23:15.07,Default,,0,0,0,,Сен екеуміз ғана қалдық
Dialogue: 0,1:23:15.19,1:23:17.03,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,1:23:17.15,1:23:19.57,Default,,0,0,0,,Дүниенің қандай екенін білмеймін...
Dialogue: 0,1:23:19.70,1:23:22.49,Default,,0,0,0,,Мен сенімен жалғыз өмір сүргім келеді.
Dialogue: 0,1:23:28.42,1:23:29.04,Default,,0,0,0,,Га
Dialogue: 0,1:23:36.30,1:23:38.93,Default,,0,0,0,,Маған жалғыз өмір сүру керек
Dialogue: 0,1:23:39.38,1:23:40.55,Default,,0,0,0,,Га
Dialogue: 0,1:23:41.39,1:23:45.39,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:23:51.02,1:23:52.69,Default,,0,0,0,,Винсент
Dialogue: 0,1:23:52.81,1:23:54.90,Default,,0,0,0,,Мен саған мұнда келме дедім.
Dialogue: 0,1:23:55.03,1:23:58.11,Default,,0,0,0,,А-а, Джектің дайындығы аяқталды.
Dialogue: 0,1:23:58.57,1:24:00.24,Default,,0,0,0,,Мен бұл жерден тезірек кеткім келеді.
Dialogue: 0,1:24:00.36,1:24:02.66,Default,,0,0,0,,Полиция да айнала бастады.
Dialogue: 0,1:24:02.78,1:24:04.37,Default,,0,0,0,,Сондықтан қалған ақшаны маған бер.
Dialogue: 0,1:24:04.49,1:24:05.79,Default,,0,0,0,,Сіз дұғаларыңызды оқыдыңыз ба?
Dialogue: 0,1:24:05.91,1:24:06.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:06.87,1:24:08.12,Default,,0,0,0,,(Мұраттың ыңырануы)
Dialogue: 0,1:24:08.54,1:24:10.37,Default,,0,0,0,,Уау уау
Dialogue: 0,1:24:19.26,1:24:20.22,Default,,0,0,0,,Хмм
Dialogue: 0,1:24:25.14,1:24:29.52,Default,,0,0,0,,Аспан мен жерді қосатын көпір, Мен бармын
Dialogue: 0,1:24:30.06,1:24:35.23,Default,,0,0,0,,Бұл дүниеде жалғыз, осы тазарту туралы куә бол.
Dialogue: 0,1:24:40.99,1:24:44.99,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:24:47.79,1:24:49.62,Default,,0,0,0,,Маған не болады?
Dialogue: 0,1:24:50.04,1:24:53.54,Default,,0,0,0,,Сен де солдат болсаң, дайынсың, солай ма?
Dialogue: 0,1:24:58.25,1:25:00.05,Default,,0,0,0,,Эй, маған темекі берші.
Dialogue: 0,1:25:00.17,1:25:01.67,Default,,0,0,0,,Бір бөтелке жақсы болар еді.
Dialogue: 0,1:25:01.80,1:25:02.88,Default,,0,0,0,,Сіз не істейсіз? Маған бәрі бір.
Dialogue: 0,1:25:03.64,1:25:04.39,Default,,0,0,0,,Уау
Dialogue: 0,1:25:04.51,1:25:05.85,Default,,0,0,0,,Ішек
Dialogue: 0,1:25:06.47,1:25:07.56,Default,,0,0,0,,Уф
Dialogue: 0,1:25:08.06,1:25:11.48,Default,,0,0,0,,Тоқта, күт, атпа, атпа
Dialogue: 0,1:25:11.60,1:25:12.81,Default,,0,0,0,,Мылтықты тастаңыз
Dialogue: 0,1:25:12.94,1:25:14.77,Default,,0,0,0,,Харрис, мынаны аш.
Dialogue: 0,1:25:14.90,1:25:15.98,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:16.11,1:25:16.86,Default,,0,0,0,,Алайық
Dialogue: 0,1:25:16.98,1:25:19.15,Default,,0,0,0,,Ууууу гуаааааааааааааааа
Dialogue: 0,1:25:19.65,1:25:20.86,Default,,0,0,0,,Уф
Dialogue: 0,1:25:23.86,1:25:25.62,Default,,0,0,0,,Сонда ол қайда?
Dialogue: 0,1:25:25.74,1:25:27.49,Default,,0,0,0,,Су өсімдігі
Dialogue: 0,1:25:27.62,1:25:29.83,Default,,0,0,0,,Лидің бұзу жолын түсіндіру -
Dialogue: 0,1:25:29.95,1:25:32.46,Default,,0,0,0,,Біз біреудің кіріп кеткенін таптық.
Dialogue: 0,1:25:32.58,1:25:33.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:25:33.96,1:25:37.13,Default,,0,0,0,,Олар оны сумен араластырып, бүкіл қалаға таратуды жоспарлап отыр.
Dialogue: 0,1:25:37.25,1:25:39.00,Default,,0,0,0,,Терроризмге қарсы жасақты асығыңыз
Dialogue: 0,1:25:39.13,1:25:40.34,Default,,0,0,0,,Иә
Dialogue: 0,1:25:41.34,1:25:42.30,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:25:42.42,1:25:45.59,Default,,0,0,0,,Аа, директордың рұқсаты ше?
Dialogue: 0,1:25:45.80,1:25:49.39,Default,,0,0,0,,Дұрыс орындамасаң, кейін қиыншылыққа тап боласың.
Dialogue: 0,1:25:50.06,1:25:51.98,Default,,0,0,0,,Айтпақшы, вокзал ішінде темекі шегуге тыйым салынады.
Dialogue: 0,1:25:52.10,1:25:53.77,Default,,0,0,0,,Иә
Dialogue: 0,1:25:53.94,1:25:56.02,Default,,0,0,0,,Мен сіздің түріңізге қарап тұрсам да...
Dialogue: 0,1:25:56.15,1:25:58.36,Default,,0,0,0,,Бұл ештеңені шешпейді
Dialogue: 0,1:26:07.20,1:26:08.70,Default,,0,0,0,,Кішкене айналма жолмен жүрейік.
Dialogue: 0,1:26:08.83,1:26:09.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:09.91,1:26:11.45,Default,,0,0,0,,Қаныңыз қайда?
Dialogue: 0,1:26:11.58,1:26:12.66,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,1:26:14.08,1:26:15.37,Default,,0,0,0,,Ууууууууууууууууу
Dialogue: 0,1:26:16.29,1:26:17.54,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,1:26:20.59,1:26:21.84,Default,,0,0,0,,Мен оны аштым.
Dialogue: 0,1:26:22.71,1:26:23.46,Default,,0,0,0,,Қорғаныс киімдері
Dialogue: 0,1:26:23.59,1:26:25.18,Default,,0,0,0,,Менің бұған уақытым жоқ, иә?
Dialogue: 0,1:26:25.30,1:26:26.72,Default,,0,0,0,,Мен жақында боламын
Dialogue: 0,1:26:29.85,1:26:30.68,Default,,0,0,0,,Иә? Ах
Dialogue: 0,1:26:31.06,1:26:32.77,Default,,0,0,0,,Электра вакцинасы қайда?
Dialogue: 0,1:26:32.89,1:26:35.27,Default,,0,0,0,,Дәл қазір, үшінші.
Dialogue: 0,1:26:35.39,1:26:38.35,Default,,0,0,0,,No Екінші жағдайда инкубация
Dialogue: 0,1:26:38.48,1:26:39.27,Default,,0,0,0,,Бұл?
Dialogue: 0,1:26:39.40,1:26:42.32,Default,,0,0,0,,Иә, бұл ішіндегі сары пакет.
Dialogue: 0,1:26:43.36,1:26:45.49,Default,,0,0,0,,О, бұл рас.
Dialogue: 0,1:26:45.61,1:26:48.20,Default,,0,0,0,,Дегенмен, өсіру әлі аяқталған жоқ.
Dialogue: 0,1:26:48.87,1:26:50.20,Default,,0,0,0,,20 сағаттан кейін...
Dialogue: 0,1:26:50.33,1:26:52.87,Default,,0,0,0,,Бір қаптама шамамен 100 000 дана болуы керек.
Dialogue: 0,1:26:56.12,1:26:57.54,Default,,0,0,0,,Электра Кешіріңіз.
Dialogue: 0,1:26:58.96,1:27:01.92,Default,,0,0,0,,Сіз 3-деңгейдегі қоқыс блогынан өтуіңіз керек.
Dialogue: 0,1:27:03.00,1:27:04.21,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,1:27:05.97,1:27:08.76,Default,,0,0,0,,Ха, күнді маған қалдырғың келе ме?
Dialogue: 0,1:27:08.89,1:27:14.89,Default,,0,0,0,,♪～
Dialogue: 0,1:27:59.31,1:28:00.65,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,1:28:00.77,1:28:04.19,Default,,0,0,0,,Бұл ISSP. Маған осы жерді пайдалануға рұқсат етіңіз.
Dialogue: 0,1:28:04.40,1:28:06.15,Default,,0,0,0,,Мен мұндайды естіген жоқпын.
Dialogue: 0,1:28:06.57,1:28:08.78,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,1:28:09.40,1:28:11.36,Default,,0,0,0,,ой-оу
Dialogue: 0,1:28:12.66,1:28:16.20,Default,,0,0,0,,Мен мұны ешкімге көрсеткім келмейді.
Dialogue: 0,1:28:18.00,1:28:18.91,Default,,0,0,0,,Уф
Dialogue: 0,1:28:20.58,1:28:22.42,Default,,0,0,0,,Буддалыққа қол жеткізіңіз.
Dialogue: 0,1:28:22.54,1:28:23.38,Default,,0,0,0,,Хмм
Dialogue: 0,1:28:26.59,1:28:28.05,Default,,0,0,0,,Сіз қоңырау күтіп тұрсыз ба?
Dialogue: 0,1:28:28.17,1:28:30.30,Default,,0,0,0,,Хмм? Жоқ, шынымен емес
Dialogue: 0,1:28:30.43,1:28:31.18,Default,,0,0,0,,Хмм.
Dialogue: 0,1:28:31.30,1:28:34.43,Default,,0,0,0,,Спайк пен Фэйдің сізбен байланысуын күтіп жүрсіз бе?
Dialogue: 0,1:28:34.55,1:28:36.97,Default,,0,0,0,,Хмм? Мен оны көрмеймін.
Dialogue: 0,1:28:37.10,1:28:38.68,Default,,0,0,0,,Мен оны мүлде байқамадым.
Dialogue: 0,1:28:38.68,1:28:39.52,Default,,0,0,0,,Мен оны мүлде байқамадым.
Dialogue: 0,1:28:38.68,1:28:39.52,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:28:39.52,1:28:39.64,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:28:39.64,1:28:40.73,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:28:39.64,1:28:40.73,Default,,0,0,0,,Ах
Dialogue: 0,1:28:40.73,1:28:41.14,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:28:41.14,1:28:41.52,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:28:41.14,1:28:41.52,Default,,0,0,0,,Моши Моши
Dialogue: 0,1:28:41.52,1:28:42.27,Default,,0,0,0,,Моши Моши
Dialogue: 0,1:28:42.90,1:28:44.52,Default,,0,0,0,,Винсент пайда болды.
Dialogue: 0,1:28:44.73,1:28:47.65,Default,,0,0,0,,Фэй, сен қайда болдың?
Dialogue: 0,1:28:47.78,1:28:49.99,Default,,0,0,0,,Олар керемет нәрсе жасауды жоспарлап отырған сияқты.
Dialogue: 0,1:28:50.11,1:28:51.82,Default,,0,0,0,,Кеш басталып жатыр
Dialogue: 0,1:28:51.95,1:28:53.70,Default,,0,0,0,,Неліктен олай етер едіңдер?
Dialogue: 0,1:28:53.82,1:28:57.04,Default,,0,0,0,,Спайк! Ақымақ
Dialogue: 0,1:28:57.16,1:28:58.49,Default,,0,0,0,,Қайда болдың...
Dialogue: 0,1:28:58.62,1:28:59.75,Default,,0,0,0,,Әй?
Dialogue: 0,1:28:59.87,1:29:02.83,Default,,0,0,0,,ISSP су зауытына бара жатқан сияқты.
Dialogue: 0,1:29:02.96,1:29:04.04,Default,,0,0,0,,Су өсімдігі?
Dialogue: 0,1:29:04.17,1:29:10.17,Default,,0,0,0,,♪～
Dialogue: 0,1:29:33.65,1:29:36.45,Default,,0,0,0,,4-топ 2-ші қақпа Іздеу аяқталды Ешқандай ауытқулар жоқ
Dialogue: 0,1:29:36.57,1:29:39.91,Default,,0,0,0,,2-команда 3-танк Ондай ештеңе таба алмайды
Dialogue: 0,1:29:40.04,1:29:41.04,Default,,0,0,0,,Бұл үшінші топ.
Dialogue: 0,1:29:41.16,1:29:44.12,Default,,0,0,0,,4-ші зауыттың кіреберісінен күдікті зат табылды
Dialogue: 0,1:29:44.92,1:29:46.92,Default,,0,0,0,,Өңдеу тобын жіберу Пішін дегеніміз не?
Dialogue: 0,1:29:47.04,1:29:49.13,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,1:29:49.92,1:29:52.88,Default,,0,0,0,,Асқабақ шары
Dialogue: 0,1:29:57.05,1:29:58.14,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,1:29:58.55,1:30:01.52,Default,,0,0,0,,Сіз сиқыршы болып киінген су зауытына барасыз ба?
Dialogue: 0,1:30:02.10,1:30:03.31,Default,,0,0,0,,Бүгін Альба қаласында-
Dialogue: 0,1:30:03.43,1:30:05.65,Default,,0,0,0,,Хэллоуинге арналған костюмдер шеруі болуы керек.
Dialogue: 0,1:30:05.77,1:30:08.40,Default,,0,0,0,,Жапырақтарды жасыратын орман ма?
Dialogue: 0,1:30:08.52,1:30:10.48,Default,,0,0,0,,Оның қалада мотивациясы бар ма?
Dialogue: 0,1:30:10.61,1:30:11.82,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,1:30:11.94,1:30:13.65,Default,,0,0,0,,Менің досым келді.
Dialogue: 0,1:30:13.78,1:30:15.53,Default,,0,0,0,,Джектің дайындығы туралы не деуге болады?
Dialogue: 0,1:30:15.66,1:30:16.53,Default,,0,0,0,,Джек?
Dialogue: 0,1:30:17.70,1:30:19.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:30:21.41,1:30:23.25,Default,,0,0,0,,Джек-о-фонар
Dialogue: 0,1:30:23.37,1:30:25.58,Default,,0,0,0,,Джек шамы
Dialogue: 0,1:30:25.83,1:30:26.79,Default,,0,0,0,,Га
Dialogue: 0,1:30:27.50,1:30:29.34,Default,,0,0,0,,Талдауды бастау
Dialogue: 0,1:30:33.51,1:30:35.88,Default,,0,0,0,,Фува хаа...
Dialogue: 0,1:30:36.01,1:30:36.72,Default,,0,0,0,,Уф
Dialogue: 0,1:30:36.84,1:30:38.22,Default,,0,0,0,,Идиот
Dialogue: 0,1:30:38.89,1:30:39.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:39.68,1:30:42.14,Default,,0,0,0,,Ой
Dialogue: 0,1:30:45.06,1:30:46.60,Default,,0,0,0,,Менің заттарыма тиіспеңіз
Dialogue: 0,1:31:03.24,1:31:04.62,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:31:07.71,1:31:09.29,Default,,0,0,0,,А тобы, жауап беріңіз.
Dialogue: 0,1:31:09.42,1:31:12.71,Default,,0,0,0,,Боқ, төмендегі жасақпен байланысып, оларға жағдайды хабарлаңыз.
Dialogue: 0,1:31:12.84,1:31:13.92,Default,,0,0,0,,Га
Dialogue: 0,1:31:14.67,1:31:15.84,Default,,0,0,0,,Менеджер, не болды?
Dialogue: 0,1:31:17.34,1:31:19.39,Default,,0,0,0,,Бұл әскер.
Dialogue: 0,1:31:20.85,1:31:21.55,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:31:21.68,1:31:22.60,Default,,0,0,0,,Менеджер
Dialogue: 0,1:31:24.43,1:31:26.14,Default,,0,0,0,,Командир кім?
Dialogue: 0,1:31:26.27,1:31:29.06,Default,,0,0,0,,Мен әскерилерге өтініш жасалғанын естіген жоқпын.
Dialogue: 0,1:31:29.19,1:31:30.86,Default,,0,0,0,,Бұл өте құпия тапсырма.
Dialogue: 0,1:31:32.36,1:31:34.15,Default,,0,0,0,,Бұл жерді әскерилер алады.
Dialogue: 0,1:31:34.28,1:31:36.15,Default,,0,0,0,,Не? Бұл қандай миссия?
Dialogue: 0,1:31:36.28,1:31:37.53,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,1:31:37.65,1:31:38.78,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:31:38.91,1:31:40.03,Default,,0,0,0,,Талдау нәтижелері шықты
Dialogue: 0,1:31:40.16,1:31:40.87,Default,,0,0,0,,Уф
Dialogue: 0,1:31:40.99,1:31:42.24,Default,,0,0,0,,Уф
Dialogue: 0,1:31:44.29,1:31:45.95,Default,,0,0,0,,Нәтижелер, нәтижелер жылдам
Dialogue: 0,1:31:46.08,1:31:47.87,Default,,0,0,0,,Мен саған артта қал дедім.
Dialogue: 0,1:31:48.00,1:31:49.17,Default,,0,0,0,,Уф, шу!
Dialogue: 0,1:31:49.29,1:31:50.54,Default,,0,0,0,,Ингредиенттер:
Dialogue: 0,1:31:50.88,1:31:53.84,Default,,0,0,0,,Азот оттегі және т.б. Көмірқышқыл газының іздік мөлшері -
Dialogue: 0,1:31:53.96,1:31:56.01,Default,,0,0,0,,Аргон, неон, криптон
Dialogue: 0,1:31:56.13,1:31:58.80,Default,,0,0,0,,Демек, бұл жай ғана ауа.
Dialogue: 0,1:31:59.55,1:32:02.47,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:32:04.97,1:32:07.27,Default,,0,0,0,,Бірақ бүкіл қала шамдарға толы.
Dialogue: 0,1:32:07.39,1:32:08.77,Default,,0,0,0,,Қайдан және қалай іздеу керек?
Dialogue: 0,1:32:08.89,1:32:10.23,Default,,0,0,0,,деді
Dialogue: 0,1:32:10.35,1:32:12.69,Default,,0,0,0,,«Мен аспан мен жерді байланыстыратын көпірдемін»
Dialogue: 0,1:32:12.81,1:32:13.81,Default,,0,0,0,,Не?
Dialogue: 0,1:32:13.94,1:32:16.03,Default,,0,0,0,,Реактивті ұшақты дайында.
Dialogue: 0,1:32:16.15,1:32:17.53,Default,,0,0,0,,Дұрыс, 20-30 станок
Dialogue: 0,1:32:17.69,1:32:20.49,Default,,0,0,0,,Не? сен не істемексің
Dialogue: 0,1:32:20.61,1:32:22.28,Default,,0,0,0,,Мен алдымен Қылышпен барамын.
Dialogue: 0,1:32:22.41,1:32:24.28,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,1:32:29.54,1:32:30.50,Default,,0,0,0,,Фэй, сен...
Dialogue: 0,1:32:30.62,1:32:32.29,Default,,0,0,0,,Ауа райын бақылау орталығына барыңыз.
Dialogue: 0,1:32:32.42,1:32:34.29,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,1:32:34.63,1:32:37.17,Default,,0,0,0,,Бұл дүние жойылса да ол тірі ме?
Dialogue: 0,1:32:37.30,1:32:38.51,Default,,0,0,0,,Сіз жеңе алмайсыз
Dialogue: 0,1:32:38.80,1:32:40.55,Default,,0,0,0,,Мен ол жігітке қарыздармын
Dialogue: 0,1:32:40.68,1:32:41.88,Default,,0,0,0,,Мучадаттеба
Dialogue: 0,1:32:42.59,1:32:45.60,Default,,0,0,0,,Осы дүниені құртқысы келсе...
Dialogue: 0,1:32:45.72,1:32:46.89,Default,,0,0,0,,Мен мұны көптен бері істеп келемін.
Dialogue: 0,1:32:47.01,1:32:47.85,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:47.97,1:32:50.02,Default,,0,0,0,,Бұл оның шақыруы.
Dialogue: 0,1:32:50.14,1:32:52.73,Default,,0,0,0,,Қонақтар келгенше кеш басталуы мүмкін емес.
Dialogue: 0,1:32:53.40,1:32:54.40,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:32:54.52,1:32:57.15,Default,,0,0,0,,Қозғалмасаң, жер тар болмас.
Dialogue: 0,1:32:57.48,1:32:58.53,Default,,0,0,0,,Уф
Dialogue: 0,1:32:58.86,1:32:59.69,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,1:32:59.82,1:33:00.90,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:33:01.40,1:33:02.91,Default,,0,0,0,,Муму
Dialogue: 0,1:33:03.24,1:33:05.70,Default,,0,0,0,,Идиоттарды өлгенше емдеу мүмкін емес.
Dialogue: 0,1:33:09.37,1:33:11.00,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,1:33:11.12,1:33:11.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:11.91,1:33:14.50,Default,,0,0,0,,Бұл өте қарбалас әскер.
Dialogue: 0,1:33:36.40,1:33:39.07,Default,,0,0,0,,Балалар, қазір сендермен ойнайтын уақыт емес.
Dialogue: 0,1:34:01.30,1:34:02.51,Default,,0,0,0,,Ммм
Dialogue: 0,1:34:14.56,1:34:15.56,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,1:34:21.11,1:34:22.82,Default,,0,0,0,,Хмм?
Dialogue: 0,1:34:27.16,1:34:30.28,Default,,0,0,0,,Бұл төтенше жағдай. Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,1:34:30.41,1:34:33.04,Default,,0,0,0,,Сонда да,
Dialogue: 0,1:34:33.25,1:34:36.21,Default,,0,0,0,,Өйткені, барлық жойғыш ұшақтарды полиция бөлімі жалға алған.
Dialogue: 0,1:34:36.33,1:34:37.88,Default,,0,0,0,,Ештеңе қалмады.
Dialogue: 0,1:34:38.00,1:34:39.67,Default,,0,0,0,,бірақ мұнда қатты шу, иә?
Dialogue: 0,1:34:39.79,1:34:42.30,Default,,0,0,0,,Ұшқанша бәрі жақсы
Dialogue: 0,1:34:42.42,1:34:43.55,Default,,0,0,0,,Хмм.
Dialogue: 0,1:34:44.51,1:34:46.51,Default,,0,0,0,,Бәрі жақсы, солай ма?
Dialogue: 0,1:34:53.47,1:34:55.39,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:34:59.69,1:35:01.48,Default,,0,0,0,,Партияға әлі ерте.
Dialogue: 0,1:35:01.61,1:35:07.61,Default,,0,0,0,,♪～
Dialogue: 0,1:35:43.27,1:35:44.19,Default,,0,0,0,,Ммммммм
Dialogue: 0,1:36:40.75,1:36:44.84,Default,,0,0,0,,Ескі ұшақтар да жақсы.
Dialogue: 0,1:36:45.00,1:36:47.63,Default,,0,0,0,,Бұл шынымен ұшады ма?
Dialogue: 0,1:36:49.80,1:36:51.34,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:36:51.47,1:36:53.64,Default,,0,0,0,,Менің ойымша, бұл заттарды аспаннан шашырату керек.
Dialogue: 0,1:36:53.76,1:36:56.60,Default,,0,0,0,,Қарттарға суық су жарамайды.
Dialogue: 0,1:36:56.72,1:36:59.18,Default,,0,0,0,,Қаншалықты? Сатурнға дейін?
Dialogue: 0,1:36:59.31,1:37:00.64,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,1:37:00.77,1:37:03.35,Default,,0,0,0,,Пестицидтерді шашу үшін ғарышқа шығудың мәні неде?
Dialogue: 0,1:37:03.48,1:37:06.73,Default,,0,0,0,,Бұл Альба қаласына дейінгі қала.
Dialogue: 0,1:37:06.90,1:37:09.57,Default,,0,0,0,,Түсіндім, бұл әзіл.
Dialogue: 0,1:37:28.13,1:37:30.92,Default,,0,0,0,,Әй, бұл шынымен ұшып кетті.
Dialogue: 0,1:37:31.05,1:37:32.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:37:32.13,1:37:34.93,Default,,0,0,0,,Өйткені бұл көрмеге арналған антиквариат.
Dialogue: 0,1:37:35.05,1:37:36.68,Default,,0,0,0,,Мен ондаған жылдар бойы ұша алмадым.
Dialogue: 0,1:37:36.80,1:37:37.68,Default,,0,0,0,,О
Dialogue: 0,1:37:42.27,1:37:45.15,Default,,0,0,0,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,1:37:45.73,1:37:46.81,Default,,0,0,0,,О
Dialogue: 0,1:37:47.31,1:37:53.32,Default,,0,0,0,,♪～
Dialogue: 0,1:38:21.31,1:38:22.39,Default,,0,0,0,,Ішек
Dialogue: 0,1:38:32.74,1:38:33.74,Default,,0,0,0,,Уф
Dialogue: 0,1:39:00.76,1:39:02.60,Default,,0,0,0,,Иә, бұл понкоцу
Dialogue: 0,1:39:12.32,1:39:13.69,Default,,0,0,0,,Әй, ә?
Dialogue: 0,1:39:26.91,1:39:29.29,Default,,0,0,0,,Хмм, ха, га.
Dialogue: 0,1:39:29.42,1:39:30.58,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:30.83,1:39:32.54,Default,,0,0,0,,Сәлем такси
Dialogue: 0,1:39:34.46,1:39:36.51,Default,,0,0,0,,Ең ұлы адам кім?
Dialogue: 0,1:39:36.63,1:39:37.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:37.76,1:39:39.76,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:39:40.22,1:39:44.22,Default,,0,0,0,,Көріп тұрғаныңыздай, сіз түкке тұрғысыз террористсіз.
Dialogue: 0,1:39:45.64,1:39:48.19,Default,,0,0,0,,Әй, иә?
Dialogue: 0,1:39:48.31,1:39:49.85,Default,,0,0,0,,Сіз осындай жерде не істеуді жоспарлап отырсыз?
Dialogue: 0,1:39:49.98,1:39:51.77,Default,,0,0,0,,Сұраныс
Dialogue: 0,1:39:51.90,1:39:53.69,Default,,0,0,0,,Мен жаңбыр жауғанын қалаймын
Dialogue: 0,1:39:53.82,1:39:54.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:55.19,1:39:55.82,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:39:56.74,1:39:58.11,Default,,0,0,0,,Иә.
Dialogue: 0,1:39:59.28,1:40:00.82,Default,,0,0,0,,Бұл мереке болғандықтан емес пе?
Dialogue: 0,1:40:01.28,1:40:07.29,Default,,0,0,0,,♪～
Dialogue: 0,1:40:22.93,1:40:26.93,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:41:26.28,1:41:29.16,Default,,0,0,0,,Ха, бұл жақсы емес.
Dialogue: 0,1:41:29.62,1:41:33.00,Default,,0,0,0,,Бүгін шеру өтіп жатыр, сондықтан барлық жерде көлік қозғалысы бар.
Dialogue: 0,1:41:33.54,1:41:34.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:34.58,1:41:35.42,Default,,0,0,0,,Ммм
Dialogue: 0,1:41:37.13,1:41:39.76,Default,,0,0,0,,Аспан мен жерді байланыстыратын көпір
Dialogue: 0,1:41:43.18,1:41:44.34,Default,,0,0,0,,Хмм, иә
Dialogue: 0,1:41:44.47,1:41:46.93,Default,,0,0,0,,Әй, такси ақысы.
Dialogue: 0,1:42:29.18,1:42:30.31,Default,,0,0,0,,Хмм
Dialogue: 0,1:42:50.87,1:42:52.33,Default,,0,0,0,,Уф
Dialogue: 0,1:42:52.87,1:42:54.08,Default,,0,0,0,,Уф
Dialogue: 0,1:42:54.33,1:42:55.54,Default,,0,0,0,,Әй
Dialogue: 0,1:42:58.38,1:43:00.59,Default,,0,0,0,,Кеш басталды ма?
Dialogue: 0,1:43:02.75,1:43:04.51,Default,,0,0,0,,Дәл қазір
Dialogue: 0,1:43:11.47,1:43:15.64,Default,,0,0,0,,Аға, бұл маған Бисмарк кемесінің суға батқанын еске түсіреді.
Dialogue: 0,1:43:15.77,1:43:19.27,Default,,0,0,0,,Өтірікші, екінші дүниежүзілік соғыс шығар
Dialogue: 0,1:43:19.40,1:43:22.15,Default,,0,0,0,,Қалаға жақындап қалды, адам жинала бастады.
Dialogue: 0,1:43:36.08,1:43:37.12,Default,,0,0,0,,Фуууууук
Dialogue: 0,1:43:37.25,1:43:38.21,Default,,0,0,0,,Уф уф
Dialogue: 0,1:43:38.33,1:43:39.33,Default,,0,0,0,,Әй
Dialogue: 0,1:43:41.96,1:43:42.79,Default,,0,0,0,,Ой! Уф!
Dialogue: 0,1:43:47.80,1:43:49.01,Default,,0,0,0,,Ой!
Dialogue: 0,1:43:50.30,1:43:51.55,Default,,0,0,0,,Га (Винсент) Ух...
Dialogue: 0,1:43:53.85,1:43:55.10,Default,,0,0,0,,Уау ха!
Dialogue: 0,1:43:55.72,1:43:56.56,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,1:43:56.68,1:43:57.85,Default,,0,0,0,,Уф
Dialogue: 0,1:43:58.85,1:43:59.90,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,1:44:11.37,1:44:14.24,Default,,0,0,0,,Мен сені келе жатырмын деп ойладым, сыйлы аңшы.
Dialogue: 0,1:44:15.04,1:44:18.79,Default,,0,0,0,,Ол кезде сіз өмірлік маңызды бөлікті соңғы минутта өткізіп жібердіңіз.
Dialogue: 0,1:44:19.92,1:44:23.42,Default,,0,0,0,,Бұл көздер де ойық емес сияқты.
Dialogue: 0,1:44:23.67,1:44:24.88,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:44:25.09,1:44:26.51,Default,,0,0,0,,Уф
Dialogue: 0,1:44:27.05,1:44:28.13,Default,,0,0,0,,Хун
Dialogue: 0,1:44:28.26,1:44:29.51,Default,,0,0,0,,Уф ахаха
Dialogue: 0,1:44:31.80,1:44:32.93,Default,,0,0,0,,Нуууу
Dialogue: 0,1:44:33.85,1:44:37.85,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,1:44:44.56,1:44:45.65,Default,,0,0,0,,Уау
Dialogue: 0,1:44:49.32,1:44:55.03,Default,,0,0,0,,♪Қызым, қонжық қонжығыңның маған ашуланғың келмесін
Dialogue: 0,1:44:57.91,1:44:59.29,Default,,0,0,0,,Иә
Dialogue: 0,1:45:01.29,1:45:02.54,Default,,0,0,0,,Уф
Dialogue: 0,1:45:06.29,1:45:07.84,Default,,0,0,0,,Гуаааааааааааааааааааааа
Dialogue: 0,1:45:10.72,1:45:11.38,Default,,0,0,0,,Әй
Dialogue: 0,1:45:12.09,1:45:13.18,Default,,0,0,0,,Иа (Винсент) Ах!
Dialogue: 0,1:45:14.14,1:45:15.97,Default,,0,0,0,,Фуфуфуфу (Винсент) Аххх
Dialogue: 0,1:45:16.30,1:45:16.93,Default,,0,0,0,,О
Dialogue: 0,1:45:17.10,1:45:20.14,Default,,0,0,0,,Уау, ааа
Dialogue: 0,1:45:21.44,1:45:22.14,Default,,0,0,0,,Уау уау
Dialogue: 0,1:45:24.98,1:45:29.11,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:45:31.32,1:45:34.24,Default,,0,0,0,,Сіз әлемді құтқару үшін келдіңіз бе?
Dialogue: 0,1:45:34.61,1:45:37.16,Default,,0,0,0,,Бірақ қазірдің өзінде кеш
Dialogue: 0,1:45:37.49,1:45:41.66,Default,,0,0,0,,Кешіріңіз, мен жай ғана сыйлы аңшымын.
Dialogue: 0,1:45:41.79,1:45:44.00,Default,,0,0,0,,Бұл дүниеде не болса да, білмеймін.
Dialogue: 0,1:45:44.75,1:45:48.50,Default,,0,0,0,,Мен сіздің қарызыңызды төлеуге келдім.
Dialogue: 0,1:45:49.21,1:45:52.72,Default,,0,0,0,,Сіз бұл қауіп деп ойлайсыз ба? Сіз шынымен жасайсыз ба?
Dialogue: 0,1:45:53.05,1:45:54.18,Default,,0,0,0,,Жасаңыз
Dialogue: 0,1:46:34.13,1:46:35.18,Default,,0,0,0,,Сен, жыртқыш—!
Dialogue: 0,1:46:35.30,1:46:36.09,Default,,0,0,0,,Уф
Dialogue: 0,1:46:36.22,1:46:37.30,Default,,0,0,0,,Уф
Dialogue: 0,1:46:37.84,1:46:38.35,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,1:46:38.47,1:46:39.81,Default,,0,0,0,,Гуаа, жасайық
Dialogue: 0,1:46:40.72,1:46:44.35,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,1:46:44.48,1:46:46.69,Default,,0,0,0,,Ай! (Кугисаки) Бұл не өзі?
Dialogue: 0,1:46:51.82,1:46:52.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:54.15,1:46:58.57,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,1:46:58.70,1:47:00.66,Default,,0,0,0,,Ооооо
Dialogue: 0,1:47:14.38,1:47:16.47,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:47:16.63,1:47:22.64,Default,,0,0,0,,♪～
Dialogue: 0,1:47:43.29,1:47:46.41,Default,,0,0,0,,Өтінемін, менің өмірім аяқталмай тұрып айтыңызшы.
Dialogue: 0,1:47:47.50,1:47:50.58,Default,,0,0,0,,Мен баяғыда Титанда өлдім...
Dialogue: 0,1:47:51.29,1:47:54.17,Default,,0,0,0,,Көбелектер маған бұл дүниені көрсетіп жатыр.
Dialogue: 0,1:47:54.30,1:47:56.46,Default,,0,0,0,,Бұл арман емес пе?
Dialogue: 0,1:47:57.63,1:48:01.80,Default,,0,0,0,,Әлде көбелектер бар әлем шын ба?
Dialogue: 0,1:48:02.26,1:48:05.43,Default,,0,0,0,,Түсімде көрген дүнием бе?
Dialogue: 0,1:48:07.39,1:48:09.60,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:48:10.56,1:48:11.73,Default,,0,0,0,,Винсент
Dialogue: 0,1:48:14.94,1:48:17.74,Default,,0,0,0,,Бұл жолы қашып кетуге жол бермеймін.
Dialogue: 0,1:48:20.49,1:48:22.12,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:48:22.24,1:48:25.33,Default,,0,0,0,,Жоқ, Электра.
Dialogue: 0,1:48:26.91,1:48:29.83,Default,,0,0,0,,Бірге барайық
Dialogue: 0,1:48:34.75,1:48:37.76,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:48:42.26,1:48:42.89,Default,,0,0,0,,Га
Dialogue: 0,1:48:43.72,1:48:45.22,Default,,0,0,0,,Винсент
Dialogue: 0,1:48:49.56,1:48:52.85,Default,,0,0,0,,Неге атпадың?
Dialogue: 0,1:48:54.81,1:48:56.90,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,1:48:57.40,1:48:59.53,Default,,0,0,0,,Ол мен сүйген әйел
Dialogue: 0,1:49:02.70,1:49:05.62,Default,,0,0,0,,Мен бұл жерден кеткім келді.
Dialogue: 0,1:49:06.03,1:49:10.08,Default,,0,0,0,,Мен бұл дүниеден кететін есік іздедім.
Dialogue: 0,1:49:11.21,1:49:13.00,Default,,0,0,0,,Енді түсіндім.
Dialogue: 0,1:49:13.46,1:49:16.59,Default,,0,0,0,,Еш жерде есік жоқ еді.
Dialogue: 0,1:49:17.63,1:49:19.76,Default,,0,0,0,,Мұны мен бұрыннан білуім керек еді.
Dialogue: 0,1:49:20.26,1:49:24.39,Default,,0,0,0,,Көзіңді ашуға қорқтың
Dialogue: 0,1:49:24.51,1:49:25.76,Default,,0,0,0,,О
Dialogue: 0,1:49:26.39,1:49:27.76,Default,,0,0,0,,Электр
Dialogue: 0,1:49:28.43,1:49:30.60,Default,,0,0,0,,Менің өмірімде...
Dialogue: 0,1:49:30.73,1:49:32.52,Default,,0,0,0,,Мен сенімен болған кезде ғана...
Dialogue: 0,1:49:32.64,1:49:35.36,Default,,0,0,0,,Шындық сияқты сезінеді
Dialogue: 0,1:49:39.57,1:49:44.32,Default,,0,0,0,,Соңында кездескеніме қуаныштымын.
Dialogue: 0,1:49:44.45,1:49:50.45,Default,,0,0,0,,♪～
Dialogue: 0,1:50:04.76,1:50:06.59,Default,,0,0,0,,Жаңбыр не істеді?
Dialogue: 0,1:50:07.39,1:50:11.27,Default,,0,0,0,,Инфекция наномашиналарға қарағанда тез таралады.
Dialogue: 0,1:50:11.39,1:50:13.89,Default,,0,0,0,,Берекелі жаңбыр болса керек.
Dialogue: 0,1:50:14.77,1:50:17.69,Default,,0,0,0,,Жаңбырдан кейін кемпірқосақ пайда бола ма?
Dialogue: 0,1:50:18.65,1:50:19.48,Default,,0,0,0,,Эй
Dialogue: 0,1:50:19.61,1:50:20.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:20.61,1:50:21.86,Default,,0,0,0,,Жылқыларды көргіңіз келе ме?
Dialogue: 0,1:50:22.49,1:50:23.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:50:24.11,1:50:27.57,Default,,0,0,0,,Хаха, қатал әйел.
Dialogue: 0,1:50:27.70,1:50:30.08,Default,,0,0,0,,♪Мен үшін бақыт деген жай ғана сөз
Dialogue: 0,1:50:30.20,1:50:32.12,Default,,0,0,0,,♪Бұл бір-екі нәрсені білдіруі мүмкін
Dialogue: 0,1:50:32.25,1:50:35.25,Default,,0,0,0,,♪Егер мен айырмашылықты білгенімде
Dialogue: 0,1:50:36.71,1:50:38.96,Default,,0,0,0,,♪Бостық, жалғыздық пародия
Dialogue: 0,1:50:39.09,1:50:41.05,Default,,0,0,0,,♪Ал менің өмірім, тағы бір түтін мылтық
Dialogue: 0,1:50:41.17,1:50:44.76,Default,,0,0,0,,♪Елсіздігімнің белгісі
Dialogue: 0,1:50:45.80,1:50:47.84,Default,,0,0,0,,♪Әрқашан іште сақтаңыз
Dialogue: 0,1:50:47.97,1:50:50.06,Default,,0,0,0,,♪Ешкімде мүмкіндік болмаған жерде
Dialogue: 0,1:50:50.18,1:50:53.18,Default,,0,0,0,,♪Кіруге кіру үшін
Dialogue: 0,1:50:54.85,1:50:56.77,Default,,0,0,0,,♪Кейбіреулер тырысып көргенін айтайын
Dialogue: 0,1:50:56.90,1:50:58.98,Default,,0,0,0,,♪Бірақ мен есікті қатты тарс жауар едім
Dialogue: 0,1:50:59.11,1:51:02.61,Default,,0,0,0,,♪Олар ешқашан кіре алмайды
Dialogue: 0,1:51:06.53,1:51:09.12,Default,,0,0,0,,♪Құлып пен кілттің астында өзімді салқын ұстадым
Dialogue: 0,1:51:09.24,1:51:10.49,Default,,0,0,0,,♪Ал мен ешқашан көз жасымды төкпеймін
Dialogue: 0,1:51:10.62,1:51:14.25,Default,,0,0,0,,♪Жағдайымның тағы бір белгісі
Dialogue: 0,1:51:15.16,1:51:18.33,Default,,0,0,0,,♪Махаббаттан немесе ащы бекершіліктен қорқу
Dialogue: 0,1:51:18.46,1:51:19.42,Default,,0,0,0,,♪Бұл мені қашуға мәжбүр етті
Dialogue: 0,1:51:19.54,1:51:22.71,Default,,0,0,0,,♪Менің жағдайымдағы негізгі оқиғалар
Dialogue: 0,1:51:24.46,1:51:27.18,Default,,0,0,0,,♪Мен есігімде шынжыр ұстадым
Dialogue: 0,1:51:27.30,1:51:31.81,Default,,0,0,0,,♪Қабылдың ұятын соқыр мойынсұнуға айналдыр
Dialogue: 0,1:51:33.52,1:51:35.52,Default,,0,0,0,,♪Аты жоқ жанып тұрған елес
Dialogue: 0,1:51:35.64,1:51:37.64,Default,,0,0,0,,♪Бәрібір қоңырау шалып тұрды
Dialogue: 0,1:51:37.77,1:51:41.06,Default,,0,0,0,,♪Бірақ мен тыңдамадым
Dialogue: 0,1:51:44.90,1:51:47.74,Default,,0,0,0,,♪Ұзақ тоқтаған сайын, Соғұрлым ары қарай жорғалайтын едім
Dialogue: 0,1:51:47.86,1:51:50.37,Default,,0,0,0,,♪Ары қарай жорғалайтын едім Соғұрлым қатты құлайтынмын
Dialogue: 0,1:51:50.49,1:51:52.53,Default,,0,0,0,,♪Мен жорғалап жүрдім'
Dialogue: 0,1:51:52.66,1:51:55.25,Default,,0,0,0,,♪отқа
Dialogue: 0,1:51:56.41,1:51:59.21,Default,,0,0,0,,♪Қанша көрсем соғұрлым құлайтын едім
Dialogue: 0,1:51:59.33,1:52:01.75,Default,,0,0,0,,♪Жығылған сайын төменірек жорғалайтынмын
Dialogue: 0,1:52:01.88,1:52:03.96,Default,,0,0,0,,♪Мен құлай бердім'
Dialogue: 0,1:52:04.17,1:52:06.80,Default,,0,0,0,,♪отқа
Dialogue: 0,1:52:15.52,1:52:18.31,Default,,0,0,0,,♪отқа
Dialogue: 0,1:52:26.69,1:52:29.32,Default,,0,0,0,,♪отқа
Dialogue: 0,1:52:33.62,1:52:35.99,Default,,0,0,0,,♪Кенет ойыма келді
Dialogue: 0,1:52:36.12,1:52:37.70,Default,,0,0,0,,♪Жүгіріп, жасырыну себебі
Dialogue: 0,1:52:37.83,1:52:40.92,Default,,0,0,0,,♪Тіршілігімді қорытындылады
Dialogue: 0,1:52:41.92,1:52:44.25,Default,,0,0,0,,♪Бәрі екінші жағында қалды
Dialogue: 0,1:52:44.38,1:52:46.38,Default,,0,0,0,,♪Бұдан жаман ешқашан болуы мүмкін емес
Dialogue: 0,1:52:46.50,1:52:49.55,Default,,0,0,0,,♪Бірақ мен қашықтыққа бара аламын ба
Dialogue: 0,1:52:50.72,1:52:52.89,Default,,0,0,0,,♪Есікпен бетпе-бет келдім және бар ұяттым
Dialogue: 0,1:52:53.01,1:52:55.14,Default,,0,0,0,,♪Тізбектің әрбір бөлігін жұлып алу
Dialogue: 0,1:52:55.26,1:52:58.22,Default,,0,0,0,,♪Олардың барлығы бұзылғанша
Dialogue: 0,1:52:59.43,1:53:01.48,Default,,0,0,0,,♪Бірақ мен қалай тырыссам да
Dialogue: 0,1:53:01.60,1:53:03.52,Default,,0,0,0,,♪Арғы жағы қатты жабылды
Dialogue: 0,1:53:03.65,1:53:06.90,Default,,0,0,0,,♪Есік ашылмады
Dialogue: 0,1:53:10.32,1:53:12.95,Default,,0,0,0,,♪Есік ашылмай, қағыла бастады
Dialogue: 0,1:53:13.32,1:53:15.83,Default,,0,0,0,,♪Құлыпты ашу үшін біреуге айқайлады
Dialogue: 0,1:53:15.95,1:53:20.41,Default,,0,0,0,,♪Мен есіктен өтуім керек
Dialogue: 0,1:53:21.54,1:53:24.38,Default,,0,0,0,,♪Тақылдатқан сайын қызып кеттім
Dialogue: 0,1:53:24.50,1:53:26.96,Default,,0,0,0,,♪Мен қызған сайын соғұрлым қатты соғатын едім
Dialogue: 0,1:53:27.09,1:53:31.76,Default,,0,0,0,,♪Мен есікті бұзып өтуім керек
